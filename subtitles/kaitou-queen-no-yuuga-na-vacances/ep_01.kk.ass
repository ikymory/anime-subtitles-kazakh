Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:33.53,0:00:37.91,Default,,0,0,0,,Ертеде бір кішкентай арал болыпты.
Dialogue: 0,0:00:37.99,0:00:41.70,Default,,0,0,0,,Онда олар балық аулап өмір сүрді.
Dialogue: 0,0:00:41.79,0:00:45.04,Default,,0,0,0,,Бір күні айдаһар пайда болды және
Dialogue: 0,0:00:45.12,0:00:47.79,Default,,0,0,0,,Енді көп балық аулауға болады
Dialogue: 0,0:00:47.88,0:00:50.46,Default,,0,0,0,,Барлығы еріншек ойнай бастады.
Dialogue: 0,0:00:51.67,0:00:56.59,Default,,0,0,0,,Біраз уақыттан кейін айдаһар алғыс ретінде асыл тас сұрады.
Dialogue: 0,0:00:57.14,0:01:00.81,Default,,0,0,0,,Қазына тастар - аралдың қазынасы.Егер сіз оларды беруден бас тартсаңыз,
Dialogue: 0,0:01:00.89,0:01:01.93,Default,,0,0,0,,(найзағайдың дыбысы)
Dialogue: 0,0:01:01.93,0:01:03.23,Default,,0,0,0,,(найзағайдың дыбысы)
Dialogue: 0,0:01:01.93,0:01:03.23,Default,,0,0,0,,Мен кетсем қиыншылыққа тап болатын сендерсіңдер.
Dialogue: 0,0:01:03.23,0:01:06.02,Default,,0,0,0,,Мен кетсем қиыншылыққа тап болатын сендерсіңдер.
Dialogue: 0,0:01:06.10,0:01:08.81,Default,,0,0,0,,Айдаһар қазынаны ұрлап кетті
Dialogue: 0,0:01:08.90,0:01:13.49,Default,,0,0,0,,Иә, бәрі балық аулауды ұмытты.
Dialogue: 0,0:01:13.57,0:01:16.53,Default,,0,0,0,,Бірақ мен саған асыл тасты бере алмаймын.
Dialogue: 0,0:01:17.11,0:01:20.28,Default,,0,0,0,,Мен қазына тасты қайтару үшін орнымнан тұрдым.
Dialogue: 0,0:01:21.08,0:01:22.24,Default,,0,0,0,,Оны қайтарыңыз
Dialogue: 0,0:01:25.29,0:01:27.54,Default,,0,0,0,,Бұл мүмкін емес сұрақ.
Dialogue: 0,0:01:27.63,0:01:30.63,Default,,0,0,0,,Бұл фото менің қазынам.
Dialogue: 0,0:01:30.71,0:01:32.59,Default,,0,0,0,,Бұл менің фотом.
Dialogue: 0,0:01:32.67,0:01:35.09,Default,,0,0,0,,Қанша сұрасаң да,
Dialogue: 0,0:01:35.17,0:01:37.13,Default,,0,0,0,,Мен сенен сұрай алмаймын.
Dialogue: 0,0:01:37.22,0:01:38.64,Default,,0,0,0,,Қару-жарақ?
Dialogue: 0,0:01:38.72,0:01:40.18,Default,,0,0,0,,Фуфун
Dialogue: 0,0:01:40.26,0:01:41.43,Default,,0,0,0,,Ха!
Dialogue: 0,0:01:48.35,0:01:49.52,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:53.11,0:01:54.86,Default,,0,0,0,,Сіз күштірек болдыңыз.
Dialogue: 0,0:01:55.69,0:01:58.36,Default,,0,0,0,,Сіз әлсіреп қалдыңыз, солай емес пе?
Dialogue: 0,0:01:58.45,0:02:01.95,Default,,0,0,0,,Егер сіз бұрын болған болсаңыз, бір фотосуретті қорғау үшін
Dialogue: 0,0:02:02.03,0:02:04.66,Default,,0,0,0,,Ешқашан мүмкіндік болған емес.
Dialogue: 0,0:02:05.54,0:02:09.21,Default,,0,0,0,,Қолымнан келмейді, бұл сүйікті досымның суреті.
Dialogue: 0,0:02:09.29,0:02:11.75,Default,,0,0,0,,Түсіну үшін неше рет айтуым керек?
Dialogue: 0,0:02:11.84,0:02:14.55,Default,,0,0,0,,Мен сіздің іскер серіктесіңізмін.
Dialogue: 0,0:02:14.63,0:02:18.09,Default,,0,0,0,,Мен бұрынғыдан да адал, жақсы қыз едім.
Dialogue: 0,0:02:18.18,0:02:20.39,Default,,0,0,0,,) Кешіріңіз, бос емес.
Dialogue: 0,0:02:20.47,0:02:22.05,Default,,0,0,0,,(Қашықтан басқару пультінің түймесін басқан дыбыс)
Dialogue: 0,0:02:22.14,0:02:25.35,Default,,0,0,0,,) Осындай нәрсе SNS сайтында жарияланған
Dialogue: 0,0:02:26.18,0:02:29.94,Default,,0,0,0,,Сатчмоның әлемдегі ең сәнді круиздік кемесі
Dialogue: 0,0:02:30.02,0:02:31.61,Default,,0,0,0,,Корольдік Сатчмо
Dialogue: 0,0:02:31.69,0:02:34.98,Default,,0,0,0,,Жақында біз Кариб теңізіндегі круизде жүземіз.
Dialogue: 0,0:02:35.07,0:02:38.99,Default,,0,0,0,,Фантом ұры ханшайымынан Сатчмоға хабарлама келді.
Dialogue: 0,0:02:39.07,0:02:41.45,Default,,0,0,0,,Мақсат - Император Сапфирі
Dialogue: 0,0:02:41.53,0:02:45.41,Default,,0,0,0,,Зергерді қорғау үшін Интерпол ұйымдастырылды.
Dialogue: 0,0:02:45.49,0:02:49.50,Default,,0,0,0,,Егер сіз бірдеңені ұрлай алсаңыз, оны ұрлаңыз! Фантом ұры ханшайымы!
Dialogue: 0,0:02:50.58,0:02:52.46,Default,,0,0,0,,♪ Тауас немесе саман болмаған кезде
Dialogue: 0,0:02:52.54,0:02:56.42,Default,,0,0,0,,♪ Сатчмо әрқашан сенің жаныңда
Dialogue: 0,0:02:57.13,0:03:00.43,Default,,0,0,0,,Сатчмо, бұл ностальгиялық емес пе?
Dialogue: 0,0:03:00.51,0:03:02.26,Default,,0,0,0,,Сіз бір-біріңізді танисыз ба?
Dialogue: 0,0:03:02.34,0:03:03.43,Default,,0,0,0,,Біз доспыз
Dialogue: 0,0:03:03.51,0:03:06.10,Default,,0,0,0,,Сонда сіздің де достарыңыз болды ма?
Dialogue: 0,0:03:06.18,0:03:09.10,Default,,0,0,0,,Сен де менің досымсың, солай ма? Р.Д.
Dialogue: 0,0:03:09.64,0:03:13.40,Default,,0,0,0,,Мен сенің досың емеспін. Мен жай ғана жасанды интеллектпін.
Dialogue: 0,0:03:13.98,0:03:17.23,Default,,0,0,0,,Оның орнына сіз хабарламаны қашан бердіңіз?
Dialogue: 0,0:03:17.32,0:03:20.49,Default,,0,0,0,,Жұмыс құпталады, бірақ күтпеген шабуылдар проблема болып табылады.
Dialogue: 0,0:03:20.57,0:03:22.07,Default,,0,0,0,,Жоқ, мен оны шығарған жоқпын.
Dialogue: 0,0:03:22.16,0:03:23.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:23.41,0:03:26.58,Default,,0,0,0,,Соңғы алты айда үш рет жұмыс істедім.
Dialogue: 0,0:03:26.66,0:03:29.29,Default,,0,0,0,,Біріншіден, мен достарыма ескертпеймін.
Dialogue: 0,0:03:29.37,0:03:30.79,Default,,0,0,0,,Сонымен, бұл...
Dialogue: 0,0:03:30.87,0:03:34.17,Default,,0,0,0,,Бұл мені азғыратын тұзақ болса керек.
Dialogue: 0,0:03:34.75,0:03:38.76,Default,,0,0,0,,Кариб теңізіндегі круиз демалыс үшін тамаша болар еді.
Dialogue: 0,0:03:38.84,0:03:41.01,Default,,0,0,0,,Баратыныңызға сенімдісіз бе?
Dialogue: 0,0:03:41.09,0:03:43.39,Default,,0,0,0,,Мені кім деп ойлайсың?
Dialogue: 0,0:03:43.47,0:03:45.51,Default,,0,0,0,,Мен фантом ұры ханшайымымын
Dialogue: 0,0:03:45.60,0:03:48.02,Default,,0,0,0,,Менде эстетикалық сезім бар
Dialogue: 0,0:03:48.10,0:03:52.65,Default,,0,0,0,,Біз адамдардың үмітін ақтай алмаймыз, солай емес пе?
Dialogue: 0,0:04:04.87,0:04:08.58,Default,,0,0,0,,Жынысы, жасы және ұлты белгісіз
Dialogue: 0,0:04:08.66,0:04:10.54,Default,,0,0,0,,Маска шебері
Dialogue: 0,0:04:10.62,0:04:16.50,Default,,0,0,0,,Фантомды ұры ханшайымы пышақсыз кез келген нәрсені кесуге қабілетті.
Dialogue: 0,0:04:16.59,0:04:18.38,Default,,0,0,0,,Джокер серіктесімен
Dialogue: 0,0:04:18.46,0:04:23.43,Default,,0,0,0,,RD жасанды интеллектімен жабдықталған алып дирижабль Трубадурды басқарыңыз.
Dialogue: 0,0:04:23.51,0:04:25.22,Default,,0,0,0,,Хабарлама жіберу
Dialogue: 0,0:04:25.30,0:04:27.22,Default,,0,0,0,,Жағдай қаншалықты мүмкін емес болса да
Dialogue: 0,0:04:27.30,0:04:30.77,Default,,0,0,0,,Қорықпайтын трюктармен тамаша ұрлау
Dialogue: 0,0:04:31.35,0:04:32.31,Default,,0,0,0,,Мұндай адам
Dialogue: 0,0:04:32.39,0:04:35.31,Default,,0,0,0,,Ол қазірдің өзінде жойылып кеткен жоқ па?
Dialogue: 0,0:04:35.40,0:04:37.65,Default,,0,0,0,,Жоқ, елес ұры тірі.
Dialogue: 0,0:04:38.57,0:04:40.82,Default,,0,0,0,,Қараңғы түнде романтиканы сезін
Dialogue: 0,0:04:40.90,0:04:44.11,Default,,0,0,0,,Қызыл түсте өмір сүретін бала барша
Dialogue: 0,0:04:44.20,0:04:46.57,Default,,0,0,0,,Елес ұры жоғалып кеткенде не болады?
Dialogue: 0,0:04:46.66,0:04:48.24,Default,,0,0,0,,(Чунтарo) Чип… (Танжиро) Ә?
Dialogue: 0,0:04:59.59,0:05:04.93,Default,,0,0,0,,(Персте ойналатын көңілді музыка)
Dialogue: 0,0:05:06.97,0:05:08.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:19.19,0:05:21.48,Default,,0,0,0,,Отырғызу процедуралары жақында жабылады
Dialogue: 0,0:05:22.44,0:05:25.61,Default,,0,0,0,,Барлығыңыз тезірек бортқа мініңіздер.
Dialogue: 0,0:05:29.99,0:05:30.83,Default,,0,0,0,,Хехе
Dialogue: 0,0:05:30.91,0:05:36.92,Default,,0,0,0,,(Кеме ішінде талғампаз музыка ойнайды)
Dialogue: 0,0:05:41.42,0:05:43.84,Default,,0,0,0,,Мен Меймимін, Детектив Лордтың шәкіртімін.
Dialogue: 0,0:05:43.92,0:05:47.47,Default,,0,0,0,,Сонда сіздің бастығыңыз қайда?
Dialogue: 0,0:05:50.47,0:05:54.93,Default,,0,0,0,,О, қандай әдемі ханым.
Dialogue: 0,0:05:56.02,0:05:59.73,Default,,0,0,0,,Әдемі ханымның сымбаттылығы сол.
Dialogue: 0,0:05:59.81,0:06:04.07,Default,,0,0,0,,Хмм, Ямато Надешико да лақтыру қиын.
Dialogue: 0,0:06:04.15,0:06:06.45,Default,,0,0,0,,Патшайым бетперде жасаудың шебері.
Dialogue: 0,0:06:06.53,0:06:09.57,Default,,0,0,0,,Бортта әлдеқашан бар адамды іздеп жүрсіз бе?
Dialogue: 0,0:06:09.66,0:06:12.08,Default,,0,0,0,,Джотто мырза күткендей
Dialogue: 0,0:06:12.66,0:06:15.29,Default,,0,0,0,,Барлық сұлу әйелдерді көру үшін бұл көздің тойы.
Dialogue: 0,0:06:15.37,0:06:16.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:16.71,0:06:18.33,Default,,0,0,0,,Әрқашан осылай
Dialogue: 0,0:06:18.42,0:06:20.96,Default,,0,0,0,,Өйткені сіз әрқашан маңызды емес нәрселерді айтасыз.
Dialogue: 0,0:06:21.04,0:06:22.75,Default,,0,0,0,,Оны тонк деп атайды.
Dialogue: 0,0:06:22.84,0:06:24.88,Default,,0,0,0,,Сізге де қиын болады.
Dialogue: 0,0:06:24.96,0:06:27.63,Default,,0,0,0,,Өзімді әдемі әйел етіп көрсетсем, қарсы емеспін.
Dialogue: 0,0:06:27.72,0:06:30.05,Default,,0,0,0,,Мен патшайымның қашып кетуіне жол бермеуіңізді өтінемін.
Dialogue: 0,0:06:30.14,0:06:31.64,Default,,0,0,0,,Джотто мырза
Dialogue: 0,0:06:32.22,0:06:33.10,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:06:33.18,0:06:36.56,Default,,0,0,0,,Ол сенің атын жамылған болуы мүмкін.
Dialogue: 0,0:06:36.64,0:06:39.69,Default,,0,0,0,,Иә! Сіздің де мүмкіндіктеріңіз!
Dialogue: 0,0:06:40.73,0:06:42.52,Default,,0,0,0,,(Жолаушылар шуы)
Dialogue: 0,0:06:42.61,0:06:44.07,Default,,0,0,0,,Бұл электр қуатының үзілуі ме? Жоқ.
Dialogue: 0,0:06:44.07,0:06:45.36,Default,,0,0,0,,Бұл электр қуатының үзілуі ме? Жоқ.
Dialogue: 0,0:06:44.07,0:06:45.36,Default,,0,0,0,,(дабыл дыбысы)
Dialogue: 0,0:06:45.36,0:06:45.44,Default,,0,0,0,,(дабыл дыбысы)
Dialogue: 0,0:06:45.44,0:06:47.61,Default,,0,0,0,,(дабыл дыбысы)
Dialogue: 0,0:06:45.44,0:06:47.61,Default,,0,0,0,,Өрт! маған көмектесші!
Dialogue: 0,0:06:47.69,0:06:49.36,Default,,0,0,0,,Тынышталыңыз.
Dialogue: 0,0:06:49.45,0:06:50.82,Default,,0,0,0,,Біреу шамды қоссын!
Dialogue: 0,0:06:50.91,0:06:54.79,Default,,0,0,0,,Мен Әулие Орлов сапфирін аламын!
Dialogue: 0,0:06:54.87,0:06:56.16,Default,,0,0,0,,Ханшайым!
Dialogue: 0,0:06:56.25,0:06:59.62,Default,,0,0,0,,Ханшайым!? Қайда? Не?!
Dialogue: 0,0:06:59.71,0:07:01.83,Default,,0,0,0,,Маған қашып кетуге жол берме! Ұстаңыз!
Dialogue: 0,0:07:01.92,0:07:03.67,Default,,0,0,0,,Бұл менің жұмысым
Dialogue: 0,0:07:03.75,0:07:04.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:06.96,0:07:07.80,Default,,0,0,0,,Әй!
Dialogue: 0,0:07:08.67,0:07:09.51,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:10.30,0:07:11.14,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:11.22,0:07:12.18,Default,,0,0,0,,Қауіпті!
Dialogue: 0,0:07:16.35,0:07:17.64,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:07:17.72,0:07:20.23,Default,,0,0,0,,Бір күні тозаққа түсіп кетермін.
Dialogue: 0,0:07:20.31,0:07:22.19,Default,,0,0,0,,Қазір бұл қандай дыбыс? Жүгіріп кету!
Dialogue: 0,0:07:22.27,0:07:24.65,Default,,0,0,0,,Түтіннен мен көрмеймін.
Dialogue: 0,0:07:25.52,0:07:27.99,Default,,0,0,0,,Іздеу! Ханшайымды ізде!
Dialogue: 0,0:07:28.78,0:07:29.70,Default,,0,0,0,,О!
Dialogue: 0,0:07:29.78,0:07:31.45,Default,,0,0,0,,Ой!
Dialogue: 0,0:07:32.03,0:07:33.99,Default,,0,0,0,,О, мен шыдай алмаймын.
Dialogue: 0,0:07:35.12,0:07:37.62,Default,,0,0,0,,Ио хаа...
Dialogue: 0,0:07:38.62,0:07:39.75,Default,,0,0,0,,О...
Dialogue: 0,0:07:41.17,0:07:43.54,Default,,0,0,0,,Сіз жарақат алдыңыз ба?
Dialogue: 0,0:07:43.63,0:07:47.92,Default,,0,0,0,,А... Иә, рахмет ханым.
Dialogue: 0,0:07:48.71,0:07:50.80,Default,,0,0,0,,Ханым емес
Dialogue: 0,0:07:50.88,0:07:53.05,Default,,0,0,0,,«Вевев» жесірі
Dialogue: 0,0:07:53.84,0:07:58.06,Default,,0,0,0,,Керемет Мен гүл бойдақпын
Dialogue: 0,0:07:58.14,0:07:59.56,Default,,0,0,0,,Кира өзімен-өзі айналысып жүр ғой?
Dialogue: 0,0:07:59.64,0:08:00.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:02.10,0:08:05.56,Default,,0,0,0,,Бұл Джотто Мэйс жел диірмені.
Dialogue: 0,0:08:05.65,0:08:08.36,Default,,0,0,0,,Ангелик фон Перигорд
Dialogue: 0,0:08:08.44,0:08:09.57,Default,,0,0,0,,Хмм.
Dialogue: 0,0:08:09.65,0:08:12.03,Default,,0,0,0,,Ах... Ах...
Dialogue: 0,0:08:12.11,0:08:15.57,Default,,0,0,0,,Сізге алғыс ретінде түстен кейінгі шәймен тамақтандыруға рұқсат етіңіз.
Dialogue: 0,0:08:15.66,0:08:16.87,Default,,0,0,0,,Ангелик
Dialogue: 0,0:08:16.95,0:08:21.41,Default,,0,0,0,,Тағдыр солай бұйырса
Dialogue: 0,0:08:21.50,0:08:22.58,Default,,0,0,0,,Ах
Dialogue: 0,0:08:22.66,0:08:26.84,Default,,0,0,0,,Тағдыр менің досым Көріскенше
Dialogue: 0,0:08:26.92,0:08:28.92,Default,,0,0,0,,Барлығыңыз тынышталыңыздар.
Dialogue: 0,0:08:29.00,0:08:31.38,Default,,0,0,0,,Тынышталыңыз! Тыныштал!
Dialogue: 0,0:08:31.47,0:08:33.26,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:35.01,0:08:38.18,Default,,0,0,0,,Менімен тағдырың ше?
Dialogue: 0,0:08:38.81,0:08:41.06,Default,,0,0,0,,графиня Перигорд
Dialogue: 0,0:08:41.14,0:08:44.77,Default,,0,0,0,,Жоқ, фантом ұры ханшайымы
Dialogue: 0,0:08:45.35,0:08:47.61,Default,,0,0,0,,Жақсы түсіндік, Сатчмо.
Dialogue: 0,0:08:47.69,0:08:50.65,Default,,0,0,0,,Мен Супермен келді ме деп сұрадым.
Dialogue: 0,0:08:50.73,0:08:51.61,Default,,0,0,0,,Әй
Dialogue: 0,0:08:54.70,0:08:57.45,Default,,0,0,0,,Сәлем жұмыс, еңбектеріңізге рахмет.
Dialogue: 0,0:08:57.53,0:08:58.45,Default,,0,0,0,,Иә!?
Dialogue: 0,0:08:58.53,0:09:00.24,Default,,0,0,0,,Супермен?
Dialogue: 0,0:09:00.33,0:09:03.12,Default,,0,0,0,,Жоқ, Супермен өзгермейді.
Dialogue: 0,0:09:06.67,0:09:07.79,Default,,0,0,0,,Әй
Dialogue: 0,0:09:07.88,0:09:14.55,Default,,0,0,0,,Иә? Фантом ұры ханшайымы серігі болу үшін қартайған болуы керек.
Dialogue: 0,0:09:15.09,0:09:16.97,Default,,0,0,0,,Серіктес емес
Dialogue: 0,0:09:17.05,0:09:19.47,Default,,0,0,0,,Джокер-кун менің досым
Dialogue: 0,0:09:19.55,0:09:23.02,Default,,0,0,0,,Енді бұл менің жездем Джил.
Dialogue: 0,0:09:23.10,0:09:26.23,Default,,0,0,0,,Сен келгенше мен жақсымын.
Dialogue: 0,0:09:26.31,0:09:27.90,Default,,0,0,0,,Хаа, міне
Dialogue: 0,0:09:28.44,0:09:32.61,Default,,0,0,0,,Сізге көп рахмет. Сіздердің арқаларыңызда мен демалысқа шықтым.
Dialogue: 0,0:09:32.69,0:09:35.65,Default,,0,0,0,,Есіңде ме? 10 жыл бұрын
Dialogue: 0,0:09:35.74,0:09:39.62,Default,,0,0,0,,Алғаш рет жел сияқты менің алдымда көріндің.
Dialogue: 0,0:09:39.70,0:09:42.12,Default,,0,0,0,,Періштедей сұлу
Dialogue: 0,0:09:42.20,0:09:47.42,Default,,0,0,0,,Және ол мен жинаған әшекейлердің бәрін ұрлап кетті!
Dialogue: 0,0:09:48.00,0:09:51.92,Default,,0,0,0,,Соның арқасында мен ойымды өзгертіп, бүгінгі күнім бар компанияны құрдым.
Dialogue: 0,0:09:52.00,0:09:53.92,Default,,0,0,0,,Оны үлкен етіп жасады
Dialogue: 0,0:09:54.01,0:09:56.09,Default,,0,0,0,,Бұл қылмыстық ұйымнан жақсы.
Dialogue: 0,0:09:56.17,0:09:57.80,Default,,0,0,0,,Бұл әрқашан жақсы, солай емес пе?
Dialogue: 0,0:09:57.88,0:09:59.93,Default,,0,0,0,,Маған алғыс айтуларыңызды қалаймын.
Dialogue: 0,0:10:00.01,0:10:02.22,Default,,0,0,0,,Мен риза боламын деп ойлайсың ба!
Dialogue: 0,0:10:02.97,0:10:07.85,Default,,0,0,0,,Мен... Жоқ, біздің қалағанымыз – сенің өмірің.
Dialogue: 0,0:10:07.94,0:10:08.98,Default,,0,0,0,,Біз?
Dialogue: 0,0:10:09.06,0:10:13.15,Default,,0,0,0,,Саған кекшіл мен ғана емеспін.
Dialogue: 0,0:10:13.23,0:10:14.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:14.53,0:10:16.32,Default,,0,0,0,,(Лифттің келу дыбысы)
Dialogue: 0,0:10:16.99,0:10:20.70,Default,,0,0,0,,Осы үнмен сіз өлтірушіні босатқан сияқтысыз.
Dialogue: 0,0:10:20.78,0:10:23.62,Default,,0,0,0,,Егер сіз оны қолмен айналдыра алсаңыз, бұл мәселе.
Dialogue: 0,0:10:24.37,0:10:27.08,Default,,0,0,0,,(лифттің қозғалу дыбысы)
Dialogue: 0,0:10:32.13,0:10:33.63,Default,,0,0,0,,(Келу дыбысы)
Dialogue: 0,0:10:34.30,0:10:35.96,Default,,0,0,0,,туындаған сияқты,
Dialogue: 0,0:10:36.05,0:10:38.68,Default,,0,0,0,,Хмм, мен түсінбейтін нәрселер өте көп.
Dialogue: 0,0:10:40.47,0:10:41.55,Default,,0,0,0,,(Электрондық дыбыстың құлпын ашу)
Dialogue: 0,0:10:43.56,0:10:45.18,Default,,0,0,0,,Мына қара киім ше?
Dialogue: 0,0:10:45.89,0:10:50.65,Default,,0,0,0,,Ассасин қазынамды емес, менің өмірімді көздейді.
Dialogue: 0,0:10:50.73,0:10:51.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:56.61,0:10:57.78,Default,,0,0,0,,(Желдің дыбысы)
Dialogue: 0,0:10:57.86,0:11:02.07,Default,,0,0,0,,Уау, бұл тамаша! Джокер-кун, сен де кел!
Dialogue: 0,0:11:02.66,0:11:04.45,Default,,0,0,0,,Менің бір ісім бар.
Dialogue: 0,0:11:05.04,0:11:08.79,Default,,0,0,0,,Тыңдау құрылғысын тексердіңіз бе? Сіз өз жұмысыңызға өте ынталысыз.
Dialogue: 0,0:11:09.50,0:11:10.79,Default,,0,0,0,,Хмм.
Dialogue: 0,0:11:11.92,0:11:12.79,Default,,0,0,0,,RD
Dialogue: 0,0:11:13.38,0:11:14.75,Default,,0,0,0,,Бұл не? патшайым
Dialogue: 0,0:11:14.84,0:11:17.84,Default,,0,0,0,,Сіз бұл күдікті фигураны бұрын көрдіңіз бе?
Dialogue: 0,0:11:17.92,0:11:19.30,Default,,0,0,0,,Сурет
Dialogue: 0,0:11:19.38,0:11:23.55,Default,,0,0,0,,Ах, сіз Джокерден алынған суретті айтасыз.
Dialogue: 0,0:11:23.64,0:11:26.10,Default,,0,0,0,,Қара киім мен плащ?
Dialogue: 0,0:11:26.18,0:11:29.77,Default,,0,0,0,,Сонда сізден басқа осы хоббиі бар адам болды ма?
Dialogue: 0,0:11:29.85,0:11:31.48,Default,,0,0,0,,(Королеваның шайқасы)
Dialogue: 0,0:11:31.56,0:11:34.86,Default,,0,0,0,,Сол суретті талдап, оның шынайы тұлғасын анықтауларыңызды қалаймын.
Dialogue: 0,0:11:34.94,0:11:36.69,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:11:36.78,0:11:41.32,Default,,0,0,0,,Бұл мен үшін оңай жұмыс, әлемдегі ең жақсы жасанды интеллект.
Dialogue: 0,0:11:41.41,0:11:42.61,Default,,0,0,0,,Мен оны сұрадым.
Dialogue: 0,0:11:42.70,0:11:44.70,Default,,0,0,0,,Иә, айтпақшы, патшайым
Dialogue: 0,0:11:44.78,0:11:47.66,Default,,0,0,0,,Мені трубадурда жалғыз қалдырыңыз.
Dialogue: 0,0:11:47.74,0:11:51.75,Default,,0,0,0,,Сізде бірде-бір кәдесый болмауы мүмкін емес, солай ма?
Dialogue: 0,0:11:51.83,0:11:54.25,Default,,0,0,0,,Әрине, білемін.
Dialogue: 0,0:11:54.33,0:11:56.80,Default,,0,0,0,,Мен RD үшін тамаша кәдесый сатып аламын.
Dialogue: 0,0:11:56.88,0:11:58.42,Default,,0,0,0,,Оны асыға күтіңіз
Dialogue: 0,0:11:58.51,0:12:00.09,Default,,0,0,0,,Егер сіз өзіңізді өлтіруші деп санамасаңыз
Dialogue: 0,0:12:00.17,0:12:02.59,Default,,0,0,0,,Оны жай ғана қалдырсақ жақсы емес пе?
Dialogue: 0,0:12:02.68,0:12:08.10,Default,,0,0,0,,Дәл сол қазынаға ұмтылған қарсыласыңыз сізге қызық па?
Dialogue: 0,0:12:08.77,0:12:09.60,Default,,0,0,0,,Хехе
Dialogue: 0,0:12:10.52,0:12:15.61,Default,,0,0,0,,(ысқырық естіледі)
Dialogue: 0,0:12:16.44,0:12:18.07,Default,,0,0,0,,Корольдік Сатчмо
Dialogue: 0,0:12:18.15,0:12:20.57,Default,,0,0,0,,Мен қазір Майамиге бара жатырмын.
Dialogue: 0,0:12:20.65,0:12:25.91,Default,,0,0,0,,Анда-санда теңіз алыбының еркелігі естіледі, ол қатты шайқалады.
Dialogue: 0,0:12:25.99,0:12:29.20,Default,,0,0,0,,Содан кейін сүйікті экипажыңыздың құшағында
Dialogue: 0,0:12:29.29,0:12:31.62,Default,,0,0,0,,Мұны бата ретінде ұстаңыз.
Dialogue: 0,0:12:31.71,0:12:35.13,Default,,0,0,0,,Satchmo 14 палубаға дейін бар.
Dialogue: 0,0:12:35.21,0:12:38.63,Default,,0,0,0,,Қонақ бөлмелері 4 палубаның үстінде.
Dialogue: 0,0:12:39.17,0:12:40.88,Default,,0,0,0,,СПА-дан казиноға дейін
Dialogue: 0,0:12:40.96,0:12:44.30,Default,,0,0,0,,Satchmo мұқият таңдаған түрлі ойын-сауық
Dialogue: 0,0:12:44.38,0:12:46.60,Default,,0,0,0,,Ләззат алыңыз.
Dialogue: 0,0:12:47.97,0:12:49.26,Default,,0,0,0,,(Тормоз дыбысы)
Dialogue: 0,0:12:51.77,0:12:53.94,Default,,0,0,0,,Цк... Уақытында үлгермедің бе?
Dialogue: 0,0:12:54.02,0:12:55.40,Default,,0,0,0,,Белсенді болыңыз
Dialogue: 0,0:12:55.98,0:12:57.36,Default,,0,0,0,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,0:13:01.03,0:13:03.86,Default,,0,0,0,,Барлық қауіпсіздік камерасының жазбалары жалған.
Dialogue: 0,0:13:03.95,0:13:06.41,Default,,0,0,0,,Кінәлі – инженер-электрон.
Dialogue: 0,0:13:06.49,0:13:09.58,Default,,0,0,0,,Маман болған сияқты.
Dialogue: 0,0:13:09.66,0:13:12.87,Default,,0,0,0,,Хмм... Бір айтарым
Dialogue: 0,0:13:12.95,0:13:14.16,Default,,0,0,0,,Иә
Dialogue: 0,0:13:15.46,0:13:16.83,Default,,0,0,0,,Жалған үшін
Dialogue: 0,0:13:16.92,0:13:20.42,Default,,0,0,0,,Әдемі әйелдер бейнесін пайдалану керек
Dialogue: 0,0:13:20.50,0:13:23.05,Default,,0,0,0,,Сіз солай ойлайсыз ба? Мейми-кун
Dialogue: 0,0:13:23.63,0:13:25.13,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:13:25.22,0:13:29.10,Default,,0,0,0,,(Сахналық музыка)
Dialogue: 0,0:13:29.68,0:13:33.81,Default,,0,0,0,,Круиздік кемелер ең жақсы. Сіз көптеген нәрселерді тегін көре аласыз.
Dialogue: 0,0:13:33.89,0:13:37.77,Default,,0,0,0,,Сізді өлтірушілер нысанаға алғанын білмейсіз бе?
Dialogue: 0,0:13:37.85,0:13:41.86,Default,,0,0,0,,Олар сізге көпшілік алдында шабуыл жасамайды.
Dialogue: 0,0:13:41.94,0:13:43.74,Default,,0,0,0,,Бұл дұрыс, бірақ
Dialogue: 0,0:13:43.82,0:13:45.36,Default,,0,0,0,,Кез келген жағдайда сіз
Dialogue: 0,0:13:45.45,0:13:48.74,Default,,0,0,0,,Сіз шынымен де мені өлтірушіден жеңілемін деп ойлайсыз ба?
Dialogue: 0,0:13:48.82,0:13:51.08,Default,,0,0,0,,Менен жеңілдің.
Dialogue: 0,0:13:51.16,0:13:52.04,Default,,0,0,0,,Е...
Dialogue: 0,0:13:52.12,0:13:55.29,Default,,0,0,0,,Келесіде Роши мен Року арасындағы манзай шайқасы. Өтінемін!
Dialogue: 0,0:13:55.37,0:13:56.75,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:13:56.83,0:13:58.25,Default,,0,0,0,,Рози
Dialogue: 0,0:13:58.33,0:13:59.25,Default,,0,0,0,,Рокудесу
Dialogue: 0,0:13:59.33,0:14:01.80,Default,,0,0,0,,Satchmo тамаша.
Dialogue: 0,0:14:01.88,0:14:04.67,Default,,0,0,0,,Өйткені саяхат тек кемелермен шектеледі.
Dialogue: 0,0:14:04.76,0:14:05.72,Default,,0,0,0,,Идиот!
Dialogue: 0,0:14:05.80,0:14:07.93,Default,,0,0,0,,Міне! Сен не істеп жатырсың?
Dialogue: 0,0:14:08.01,0:14:11.43,Default,,0,0,0,,«Рафт» Люкс круиздік кеме немесе сәнді круиздік кеме
Dialogue: 0,0:14:11.51,0:14:13.14,Default,,0,0,0,,Сәнді круиздік кеме!
Dialogue: 0,0:14:13.22,0:14:15.64,Default,,0,0,0,,Уф... бұл люкс круиздік кеме қайда?
Dialogue: 0,0:14:15.73,0:14:17.35,Default,,0,0,0,,(Жолаушылар күлкісі)
Dialogue: 0,0:14:17.44,0:14:20.48,Default,,0,0,0,,Надан болғаныма шын өкінемін.
Dialogue: 0,0:14:20.56,0:14:22.52,Default,,0,0,0,,«Утара» сәнді круиздік кемесі
Dialogue: 0,0:14:22.61,0:14:23.65,Default,,0,0,0,,Міне.
Dialogue: 0,0:14:23.73,0:14:25.07,Default,,0,0,0,,Мен мұны міндетті түрде жасаймын деп ойладым.
Dialogue: 0,0:14:25.65,0:14:27.86,Default,,0,0,0,,Бұл қайғылы фильм болды.
Dialogue: 0,0:14:27.95,0:14:31.53,Default,,0,0,0,,Кеме суға батқанда ғашықтар ажырайды
Dialogue: 0,0:14:31.62,0:14:33.03,Default,,0,0,0,,Яғни, егер мен шынымен алға барсам, сен мені жұдырықтап тастайсың ба?
Dialogue: 0,0:14:33.58,0:14:35.25,Default,,0,0,0,,Бомба қойылды.
Dialogue: 0,0:14:35.33,0:14:37.75,Default,,0,0,0,,Уау! Мен айсбергке соқтым
Dialogue: 0,0:14:37.83,0:14:39.96,Default,,0,0,0,,Кеменің бұлай батып кетуі мүмкін емес. Бұл бомба!
Dialogue: 0,0:14:40.04,0:14:43.34,Default,,0,0,0,,Міне! Ақымақ кім? Айсбергті жасамаңыз!
Dialogue: 0,0:14:43.42,0:14:45.05,Default,,0,0,0,,Біз қашып кете аламыз. Бұл оңай болады.
Dialogue: 0,0:14:45.13,0:14:46.76,Default,,0,0,0,,Бомба!
Dialogue: 0,0:14:46.84,0:14:48.38,Default,,0,0,0,,Айсберг! Бомба!
Dialogue: 0,0:14:48.47,0:14:50.18,Default,,0,0,0,,Айсберг Менің айтайын дегенім осы!
Dialogue: 0,0:14:50.26,0:14:52.22,Default,,0,0,0,,Бомба Бомба Бомба... Айсберг Айсберг Айсберг!
Dialogue: 0,0:14:52.30,0:14:55.06,Default,,0,0,0,,Бұл бомба!
Dialogue: 0,0:14:55.14,0:14:57.18,Default,,0,0,0,,Аха
Dialogue: 0,0:14:57.77,0:14:59.89,Default,,0,0,0,,Бұл сахнаның төбесі төмен!
Dialogue: 0,0:14:59.98,0:15:03.11,Default,,0,0,0,,Бұл Роши мен Року арасындағы манзай шайқасы болды!
Dialogue: 0,0:15:03.19,0:15:04.36,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:15:04.44,0:15:07.11,Default,,0,0,0,,Бұл өте қарқынды болды.
Dialogue: 0,0:15:07.19,0:15:09.82,Default,,0,0,0,,Ол жай ғана «Шайқас Манзай» деп аталды.
Dialogue: 0,0:15:09.90,0:15:12.49,Default,,0,0,0,,Сіздің ләззатыңызды үзгенім үшін кешіріңіз.
Dialogue: 0,0:15:12.57,0:15:14.28,Default,,0,0,0,,Талдау нәтижелері шықты
Dialogue: 0,0:15:14.37,0:15:17.00,Default,,0,0,0,,Келесіде доктор Сиқыршы
Dialogue: 0,0:15:17.58,0:15:20.46,Default,,0,0,0,,Мен доктор Сиқырмын
Dialogue: 0,0:15:20.54,0:15:23.71,Default,,0,0,0,,Осы ғасырдың ең үздік иллюзионисі
Dialogue: 0,0:15:23.79,0:15:26.67,Default,,0,0,0,,(Сахналық музыка)
Dialogue: 0,0:15:27.21,0:15:29.47,Default,,0,0,0,,Шоуды қараңыз, содан кейін тыңдаңыз.
Dialogue: 0,0:15:30.47,0:15:32.39,Default,,0,0,0,,Сиқыр) Бұл қалпақ бар
Dialogue: 0,0:15:32.47,0:15:34.72,Default,,0,0,0,,Құрамында ештеңе жоқ
Dialogue: 0,0:15:35.31,0:15:38.48,Default,,0,0,0,,Мұнда бір нәрсені көрейік.
Dialogue: 0,0:15:38.56,0:15:39.56,Default,,0,0,0,,Хмм
Dialogue: 0,0:15:39.64,0:15:41.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:41.85,0:15:42.73,Default,,0,0,0,,Сиқыр) Иә!
Dialogue: 0,0:15:42.81,0:15:44.11,Default,,0,0,0,,Полуппо!
Dialogue: 0,0:15:44.19,0:15:45.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:45.52,0:15:48.40,Default,,0,0,0,,Барлығы осы ма? Иллюзиялар туралы не деуге болады?
Dialogue: 0,0:15:48.49,0:15:50.86,Default,,0,0,0,,(шапалақтау)
Dialogue: 0,0:15:50.95,0:15:51.86,Default,,0,0,0,,Сиқыр) Иә?
Dialogue: 0,0:15:52.45,0:15:54.70,Default,,0,0,0,,Ол осындай жерлерде пайда болады.
Dialogue: 0,0:15:54.78,0:15:56.03,Default,,0,0,0,,(Тсубаки) Дегенмен, Косэйдің аяғына зақым келгеніне қуаныштымын—
Dialogue: 0,0:15:56.12,0:15:57.45,Default,,0,0,0,,Мм... (Джокер) Иә?
Dialogue: 0,0:16:00.50,0:16:02.50,Default,,0,0,0,,Адам табиғаты
Dialogue: 0,0:16:03.12,0:16:04.88,Default,,0,0,0,,Қандай сүйкімді жас ханым.
Dialogue: 0,0:16:04.96,0:16:07.59,Default,,0,0,0,,Ол Ирма Креме де Орлов
Dialogue: 0,0:16:08.59,0:16:11.34,Default,,0,0,0,,Қазіргі уақытта Массачусетс технологиялық институтында оқиды
Dialogue: 0,0:16:11.42,0:16:14.30,Default,,0,0,0,,Гуко патшалығы тағының бірінші мұрагері
Dialogue: 0,0:16:14.39,0:16:15.93,Default,,0,0,0,,Ирма ханшайымы
Dialogue: 0,0:16:16.01,0:16:17.64,Default,,0,0,0,,(Каори) Эмм… есіктер сағат 3-те ашылады, ал жарыс 3:30-да басталады.
Dialogue: 0,0:16:19.06,0:16:20.39,Default,,0,0,0,,Орлов…
Dialogue: 0,0:16:20.98,0:16:24.40,Default,,0,0,0,,Мен Әулие Орлов сапфирін аламын!
Dialogue: 0,0:16:24.48,0:16:27.61,Default,,0,0,0,,Мүмкін, қара костюмнің шынайы тұлғасы
Dialogue: 0,0:16:27.69,0:16:29.65,Default,,0,0,0,,Бұл мисс Ирма ма?
Dialogue: 0,0:16:29.73,0:16:30.61,Default,,0,0,0,,Иә
Dialogue: 0,0:16:30.69,0:16:31.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:31.95,0:16:33.53,Default,,0,0,0,,Қауіпсіздік камерасының бейнелері
Dialogue: 0,0:16:33.61,0:16:35.57,Default,,0,0,0,,Ол жалғанмен ауыстырылды, бірақ
Dialogue: 0,0:16:35.66,0:16:39.04,Default,,0,0,0,,Мен кемеге отырғанда қайта тексердім.
Dialogue: 0,0:16:39.12,0:16:42.37,Default,,0,0,0,,Джокер жіберген кадрлармен сәйкестендірілді.
Dialogue: 0,0:16:42.46,0:16:44.83,Default,,0,0,0,,Массачусетс технологиялық институты
Dialogue: 0,0:16:44.92,0:16:48.59,Default,,0,0,0,,Қауіпсіздік бейнежазбаларын және электр қуатын өшірулерді өзгертуге шебер екеніңізге сенімдімін.
Dialogue: 0,0:16:48.67,0:16:52.67,Default,,0,0,0,,Бірақ егер сіз ханшайым болсаңыз, сізге еріп жүретін адам болуы керек емес пе?
Dialogue: 0,0:16:52.76,0:16:55.09,Default,,0,0,0,,Менің ойымша, ол инкогнито режимінде келеді.
Dialogue: 0,0:16:55.18,0:16:58.85,Default,,0,0,0,,Егер біреу кедергі болса, сіз фантом ұрысын ойнай алмайсыз.
Dialogue: 0,0:17:00.52,0:17:03.02,Default,,0,0,0,,Бұл ханшайым.
Dialogue: 0,0:17:03.10,0:17:06.10,Default,,0,0,0,,Бұл қызықты круиз болатын сияқты.
Dialogue: 0,0:17:13.99,0:17:16.66,Default,,0,0,0,,(теңіз құстарының айқайы)
Dialogue: 0,0:17:21.41,0:17:22.58,Default,,0,0,0,,Әй!
Dialogue: 0,0:17:25.25,0:17:28.38,Default,,0,0,0,,Иә! Хмм
Dialogue: 0,0:17:29.42,0:17:30.55,Default,,0,0,0,,Әй!
Dialogue: 0,0:17:33.17,0:17:34.13,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:34.22,0:17:38.60,Default,,0,0,0,,(ханшайымның қорылдауы)
Dialogue: 0,0:17:38.68,0:17:41.06,Default,,0,0,0,,(душ дыбысы)
Dialogue: 0,0:17:47.19,0:17:49.23,Default,,0,0,0,,Бұл Трубадурда болған сияқты.
Dialogue: 0,0:17:49.31,0:17:51.40,Default,,0,0,0,,Ол мүлде өзгермейді.
Dialogue: 0,0:17:52.07,0:17:55.74,Default,,0,0,0,,Қайырлы таң, бәріңе, жақсы ұйықтадыңдар ма?
Dialogue: 0,0:17:55.82,0:17:58.57,Default,,0,0,0,,Бізде Сатчмодан хабар бар.
Dialogue: 0,0:17:59.07,0:18:01.20,Default,,0,0,0,,Imperial Sapphire көрмесі
Dialogue: 0,0:18:01.28,0:18:04.75,Default,,0,0,0,,Төменгі серуендеу палубасындағы көрме бөлмесіне ауыстырылды.
Dialogue: 0,0:18:04.83,0:18:06.00,Default,,0,0,0,,Сақ болыңыз
Dialogue: 0,0:18:06.83,0:18:08.75,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:11.29,0:18:13.00,Default,,0,0,0,,Тағы да осындай жерде
Dialogue: 0,0:18:13.09,0:18:17.59,Default,,0,0,0,,Қоқысыңды қышқыл дәммен бөл деп тұрсам да.
Dialogue: 0,0:18:17.68,0:18:19.89,Default,,0,0,0,,RD Бұл менмін
Dialogue: 0,0:18:19.97,0:18:21.93,Default,,0,0,0,,Қайырлы таң Джокер
Dialogue: 0,0:18:22.01,0:18:24.56,Default,,0,0,0,,Бір сәтте пайда болатын патшайымды сұраңыз
Dialogue: 0,0:18:24.64,0:18:27.14,Default,,0,0,0,,Түсіндім, абай бол.
Dialogue: 0,0:18:27.23,0:18:28.39,Default,,0,0,0,,(Тынысы тарылған дыбыс)
Dialogue: 0,0:18:33.53,0:18:35.32,Default,,0,0,0,,Өлтіруші шығар
Dialogue: 0,0:18:39.99,0:18:42.20,Default,,0,0,0,,Ол экипажбен араласқан болуы керек.
Dialogue: 0,0:18:42.78,0:18:44.54,Default,,0,0,0,,Жердің артықшылығы экипажда.
Dialogue: 0,0:18:45.12,0:18:50.00,Default,,0,0,0,,Мен қазір ненің қайда және не бар екенін білгім келеді.
Dialogue: 0,0:18:53.00,0:18:55.80,Default,,0,0,0,,Әдемі... Керемет!
Dialogue: 0,0:18:55.88,0:18:57.88,Default,,0,0,0,,Бұл қанша тұрады?
Dialogue: 0,0:19:06.60,0:19:08.64,Default,,0,0,0,,Қауіпсіздік әлсіз.
Dialogue: 0,0:19:17.94,0:19:20.28,Default,,0,0,0,,Инфрақызыл тесік?
Dialogue: 0,0:19:24.53,0:19:26.04,Default,,0,0,0,,(Ватару) Не болып жатыр? Бұл әңгіме… (Ер оқушы) Ол ұялы телефонымен дауласып жатыр.
Dialogue: 0,0:19:27.37,0:19:29.87,Default,,0,0,0,,Бұл... Ирма ханшайымы ма?
Dialogue: 0,0:19:32.17,0:19:34.00,Default,,0,0,0,,Иә! сурет?
Dialogue: 0,0:19:37.01,0:19:38.26,Default,,0,0,0,,Ах
Dialogue: 0,0:19:40.43,0:19:42.47,Default,,0,0,0,,≪(Дэннидің үрген дауысы) (Джонатан) Дұрыс~, жақсы бала!
Dialogue: 0,0:19:43.64,0:19:46.72,Default,,0,0,0,,Менен қолдарыңды ұстаңдар! Дөрекі адам!
Dialogue: 0,0:19:46.81,0:19:48.64,Default,,0,0,0,,Қайсысы дөрекі?
Dialogue: 0,0:19:48.73,0:19:51.73,Default,,0,0,0,,Тапа-тал түсте ұрлық жасауға не жетсін?
Dialogue: 0,0:19:51.81,0:19:54.23,Default,,0,0,0,,Бұл әлдеқайда өрескел болар еді.
Dialogue: 0,0:19:54.31,0:19:55.32,Default,,0,0,0,,Ирма ханшайымы
Dialogue: 0,0:19:55.40,0:19:56.23,Default,,0,0,0,,Иә!?
Dialogue: 0,0:19:59.28,0:20:02.91,Default,,0,0,0,,Мен саған айтамын, мұндай нәрсені ұрлауға болмайды.
Dialogue: 0,0:20:02.99,0:20:04.62,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:20:04.70,0:20:06.95,Default,,0,0,0,,Шыны қорапты балғамен сындыру
Dialogue: 0,0:20:07.04,0:20:08.62,Default,,0,0,0,,Сапфирді ұрлау
Dialogue: 0,0:20:08.70,0:20:09.75,Default,,0,0,0,,Қаш
Dialogue: 0,0:20:09.83,0:20:12.67,Default,,0,0,0,,Менің ойымша, бұл қарапайым және сенімді әдіс.
Dialogue: 0,0:20:12.75,0:20:14.00,Default,,0,0,0,,Бұл жағдай
Dialogue: 0,0:20:14.08,0:20:16.54,Default,,0,0,0,,Арнайы қатты шыныдан жасалған.
Dialogue: 0,0:20:16.63,0:20:19.51,Default,,0,0,0,,Балғамен ұрсаң да сынбайды.
Dialogue: 0,0:20:19.59,0:20:21.09,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:21.17,0:20:24.51,Default,,0,0,0,,Түсінсең, фантом ұры ойынын доғар.
Dialogue: 0,0:20:24.59,0:20:27.76,Default,,0,0,0,,Маған балғаны қайтарыңыз!
Dialogue: 0,0:20:27.85,0:20:28.97,Default,,0,0,0,,Жоқ
Dialogue: 0,0:20:29.06,0:20:33.31,Default,,0,0,0,,Сен ақымақ ақшаңмен араласпаймын деп уәде бермейінше мен саған ақшамды қайтармаймын.
Dialogue: 0,0:20:33.39,0:20:36.40,Default,,0,0,0,,Фантомды ұры ханшайымы ұрлап кетсе, мен қиыншылыққа ұшыраймын.
Dialogue: 0,0:20:36.48,0:20:39.61,Default,,0,0,0,,Иә? не айтқың келеді?
Dialogue: 0,0:20:39.69,0:20:41.07,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:51.79,0:20:54.71,Default,,0,0,0,,Қандай керемет ханшайым!
Dialogue: 0,0:20:54.79,0:20:56.54,Default,,0,0,0,,(Балалардың қозу дыбыстары)
Dialogue: 0,0:20:56.63,0:20:57.92,Default,,0,0,0,,Қаш!
Dialogue: 0,0:20:58.00,0:20:58.88,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:20:58.96,0:21:00.13,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:21:00.21,0:21:02.67,Default,,0,0,0,,А, жақсысың ба?
Dialogue: 0,0:21:02.76,0:21:04.88,Default,,0,0,0,,Ауырды...
Dialogue: 0,0:21:14.23,0:21:15.35,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:21:15.94,0:21:18.02,Default,,0,0,0,,Жақсысың ба? (2-бала) Иә.
Dialogue: 0,0:21:18.11,0:21:19.57,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:21:20.27,0:21:21.61,Default,,0,0,0,,♬~
Dialogue: 0,0:21:24.99,0:21:26.78,Default,,0,0,0,,Ағай
Dialogue: 0,0:21:26.86,0:21:29.12,Default,,0,0,0,,Рахмет сау болыңыз
Dialogue: 0,0:21:29.20,0:21:31.04,Default,,0,0,0,,Ах
Dialogue: 0,0:21:31.12,0:21:32.29,Default,,0,0,0,,Әй!
Dialogue: 0,0:21:36.46,0:21:39.29,Default,,0,0,0,,Кешіріңіз. (Дәрігер) Сау болыңыз.
Dialogue: 0,0:21:42.34,0:21:46.34,Default,,0,0,0,,А... Мен жақсы ұйықтадым.
Dialogue: 0,0:21:48.39,0:21:52.31,Default,,0,0,0,,Ай!
Dialogue: 0,0:21:53.52,0:21:54.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:54.43,0:21:57.44,Default,,0,0,0,,Мен көп ұйықтадым. Күтуден шаршадым.
Dialogue: 0,0:21:57.52,0:22:00.90,Default,,0,0,0,,Әй, кешегі манзайдың жігіті
Dialogue: 0,0:22:00.98,0:22:02.86,Default,,0,0,0,,Сәлем~ Ха!
Dialogue: 0,0:22:02.94,0:22:04.82,Default,,0,0,0,,Рози
Dialogue: 0,0:22:04.90,0:22:06.65,Default,,0,0,0,,Рокудесу
Dialogue: 0,0:22:07.53,0:22:08.61,Default,,0,0,0,,Әй!
Dialogue: 0,0:22:08.70,0:22:11.20,Default,,0,0,0,,Сіз Сатчмоның өлтірушісі болдыңыз ба?
Dialogue: 0,0:22:11.28,0:22:13.75,Default,,0,0,0,,Әңгіме Мен сәтсіздікке ұшырадым.
Dialogue: 0,0:22:13.83,0:22:15.66,Default,,0,0,0,,Мен бұл күнді күттім!
Dialogue: 0,0:22:15.75,0:22:18.88,Default,,0,0,0,,Маған жұмсақ болыңыз.
Dialogue: 0,0:22:18.96,0:22:20.21,Default,,0,0,0,,Әй!
Dialogue: 0,0:22:26.17,0:22:27.09,Default,,0,0,0,,Ха!
Dialogue: 0,0:22:35.93,0:22:37.06,Default,,0,0,0,,Ха!
Dialogue: 0,0:22:37.81,0:22:38.64,Default,,0,0,0,,(ысқырық: pyu~)
Dialogue: 0,0:22:38.73,0:22:39.85,Default,,0,0,0,,Жарайды, бұл сынақ деп аталғанымен,
Dialogue: 0,0:22:39.94,0:22:40.94,Default,,0,0,0,,Ха!
Dialogue: 0,0:22:45.65,0:22:49.16,Default,,0,0,0,,Егер сіз 10 жыл бұрынғыдай деп ойласаңыз, қателесесіз.
Dialogue: 0,0:22:49.24,0:22:50.57,Default,,0,0,0,,10 жыл бұрын?
Dialogue: 0,0:22:50.66,0:22:53.08,Default,,0,0,0,,Қолды кеудеге қойып, ойлан.
Dialogue: 0,0:22:53.16,0:22:54.87,Default,,0,0,0,,Хона Икуди
Dialogue: 0,0:22:54.95,0:22:56.95,Default,,0,0,0,,Маған өмір сыйла
Dialogue: 0,0:22:57.50,0:22:59.54,Default,,0,0,0,,Дайын
Dialogue: 0,0:22:59.62,0:23:00.88,Default,,0,0,0,,Рахмет
Dialogue: 0,0:23:00.96,0:23:02.09,Default,,0,0,0,,Ха!
Dialogue: 0,0:23:13.05,0:23:14.14,Default,,0,0,0,,Бірақ мен өз күнәларыммен осылай бетпе-бет келгенім…
Dialogue: 0,0:23:17.81,0:23:19.69,Default,,0,0,0,,Толық руль
Dialogue: 0,0:23:22.31,0:23:23.98,Default,,0,0,0,,(кесу дыбысы)
Dialogue: 0,0:23:24.07,0:23:25.57,Default,,0,0,0,,Не? кенеттен
Dialogue: 0,0:23:25.65,0:23:26.94,Default,,0,0,0,,Уау!
Dialogue: 0,0:23:28.07,0:23:29.86,Default,,0,0,0,,(Теңізге құлау дыбысы)
Dialogue: 0,0:23:29.95,0:23:30.91,Default,,0,0,0,,Хехе
Dialogue: 0,0:23:30.99,0:23:32.57,Default,,0,0,0,,Көмектесіңіз!
Dialogue: 0,0:23:32.66,0:23:34.53,Default,,0,0,0,,Қайықтар мен қайықтар!
Dialogue: 0,0:23:36.45,0:23:39.96,Default,,0,0,0,,Құтқару қайықтары кабинаны кішірейтеді
Dialogue: 0,0:23:40.04,0:23:42.88,Default,,0,0,0,,Егер сіз нашар көрінуден зардап шегетін болсаңыз
Dialogue: 0,0:23:42.96,0:23:46.09,Default,,0,0,0,,Қазір телефон арқылы көмек шақыратын уақыт.
Dialogue: 0,0:23:46.84,0:23:48.51,Default,,0,0,0,,♪ Тауас немесе саман болмаған кезде
Dialogue: 0,0:23:48.59,0:23:51.93,Default,,0,0,0,,♪ Сатчмо әрқашан сенің жаныңда
Dialogue: 0,0:23:59.43,0:24:00.94,Default,,0,0,0,,Сіз оларды қайдан білесіз?
Dialogue: 0,0:24:01.02,0:24:03.19,Default,,0,0,0,,Сенің жүзіңді бірінші рет көріп тұрмын
Dialogue: 0,0:24:04.61,0:24:06.94,Default,,0,0,0,,Сонымен көрме залы қандай болды?
Dialogue: 0,0:24:07.53,0:24:10.15,Default,,0,0,0,,URRS жабдықталған
Dialogue: 0,0:24:10.24,0:24:14.24,Default,,0,0,0,,Егер ол инфрақызыл сәулеге түссе, дабыл өшеді.
Dialogue: 0,0:24:17.03,0:24:20.41,Default,,0,0,0,,Мен қазір RD-ден оны талдауды сұраймын.
Dialogue: 0,0:24:20.50,0:24:22.62,Default,,0,0,0,,Бұны ашу керек.
Dialogue: 0,0:24:22.71,0:24:25.17,Default,,0,0,0,,Мен Ирма ханшайыммен таныстым.
Dialogue: 0,0:24:25.25,0:24:27.25,Default,,0,0,0,,Тағы да фантом ұры ойнайсыз ба?
Dialogue: 0,0:24:27.34,0:24:30.67,Default,,0,0,0,,Иә, мен қиналған ханшайыммын.
Dialogue: 0,0:24:33.93,0:24:35.01,Default,,0,0,0,,Ангелик
Dialogue: 0,0:24:35.09,0:24:36.18,Default,,0,0,0,,Уф
Dialogue: 0,0:24:36.26,0:24:39.72,Default,,0,0,0,,Тағдыр әлі де менің қолымда
Dialogue: 0,0:24:39.81,0:24:41.27,Default,,0,0,0,,Мен сізге қосыла аламын ба?
Dialogue: 0,0:24:41.35,0:24:42.39,Default,,0,0,0,,Иә
Dialogue: 0,0:24:43.69,0:24:45.44,Default,,0,0,0,,Хмм...
Dialogue: 0,0:24:45.52,0:24:46.73,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:24:46.81,0:24:49.36,Default,,0,0,0,,Бұл менің жездем Джил.
Dialogue: 0,0:24:49.44,0:24:52.61,Default,,0,0,0,,Болашақ іні? (Джокер) Иә?
Dialogue: 0,0:24:52.70,0:24:54.07,Default,,0,0,0,,Джотто мырза
Dialogue: 0,0:24:54.16,0:24:56.41,Default,,0,0,0,,Не болды? Мейми-кун
Dialogue: 0,0:24:56.49,0:24:58.99,Default,,0,0,0,,Satchmo басты бетіне
Dialogue: 0,0:24:59.08,0:25:01.16,Default,,0,0,0,,Маған осындай хат келген сияқты
Dialogue: 0,0:25:01.25,0:25:05.04,Default,,0,0,0,,«Әулие Орлов сапфирін көздегендерге қасірет».
Dialogue: 0,0:25:05.12,0:25:07.04,Default,,0,0,0,,«Гуконың айдаһары»
Dialogue: 0,0:25:07.13,0:25:08.79,Default,,0,0,0,,Еркелік болуы керек
Dialogue: 0,0:25:08.88,0:25:10.00,Default,,0,0,0,,Мұнда қараңыз
Dialogue: 0,0:25:10.84,0:25:11.96,Default,,0,0,0,,Бұл…
Dialogue: 0,0:25:12.05,0:25:16.09,Default,,0,0,0,,Бұл кеме оқиғаларын және басқа нәрселерді жазатын газет.
Dialogue: 0,0:25:16.18,0:25:20.89,Default,,0,0,0,,Бұл сурет кемеге мінгеннен кейін түсірілген болуы әбден мүмкін.
Dialogue: 0,0:25:20.97,0:25:23.85,Default,,0,0,0,,Мәселені шұғыл шешу керек пе?
Dialogue: 0,0:25:23.94,0:25:27.06,Default,,0,0,0,,Өкінішке орай, мен Анджеликамен кешкі ас ішіп жатырмын.
Dialogue: 0,0:25:27.15,0:25:30.40,Default,,0,0,0,,«Бір бас, екі ақша, үш жұмыс»
Dialogue: 0,0:25:30.48,0:25:31.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:31.40,0:25:33.78,Default,,0,0,0,,Шығыстың жұмбағы
Dialogue: 0,0:25:33.86,0:25:37.37,Default,,0,0,0,,Әйел махаббатына ие болудың кілті - итермелеу.
Dialogue: 0,0:25:37.45,0:25:40.99,Default,,0,0,0,,Екіншіден, қаржылық күш, үшіншіден, жұмыс өнімділігі.
Dialogue: 0,0:25:41.08,0:25:42.91,Default,,0,0,0,,Мен бірден қайтамын
Dialogue: 0,0:25:43.00,0:25:47.54,Default,,0,0,0,,Бөлек болсақ та, жүрегіміз бір
Dialogue: 0,0:25:47.63,0:25:48.96,Default,,0,0,0,,Осы уақытта
Dialogue: 0,0:25:49.54,0:25:53.67,Default,,0,0,0,,Мұны мен сияқты ұстаңыз.
Dialogue: 0,0:25:53.76,0:25:55.68,Default,,0,0,0,,Анамнан естелік
Dialogue: 0,0:25:55.76,0:25:56.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:56.72,0:25:59.76,Default,,0,0,0,,Ақиқаттан көзіңді бұрма
Dialogue: 0,0:25:59.85,0:26:01.35,Default,,0,0,0,,Ангелик
Dialogue: 0,0:26:01.43,0:26:02.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:26:02.93,0:26:05.64,Default,,0,0,0,,Алдымен Мейми-куннан сұхбат алайық.
Dialogue: 0,0:26:05.73,0:26:06.56,Default,,0,0,0,,Иә
Dialogue: 0,0:26:07.40,0:26:09.02,Default,,0,0,0,,Ол – мазасыз адам.
Dialogue: 0,0:26:09.11,0:26:12.40,Default,,0,0,0,,Дұрыс, «бір түрткі, екі ақша, үш ұл»
Dialogue: 0,0:26:12.48,0:26:13.61,Default,,0,0,0,,Еркек
Dialogue: 0,0:26:13.69,0:26:16.45,Default,,0,0,0,,Сіз ең жақсы үшінші адамсыз ба?
Dialogue: 0,0:26:17.49,0:26:20.66,Default,,0,0,0,,Менің тапсырысым мүлдем басқаша.
Dialogue: 0,0:26:21.70,0:26:23.74,Default,,0,0,0,,Әй!
Dialogue: 0,0:26:25.29,0:26:26.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:26:30.25,0:26:31.67,Default,,0,0,0,,Джокер-кун
Dialogue: 0,0:26:31.75,0:26:34.63,Default,,0,0,0,,Неге бөлмеңе қайтып бармайсың?
Dialogue: 0,0:26:34.71,0:26:35.76,Default,,0,0,0,,Хмм...
Dialogue: 0,0:26:37.97,0:26:40.97,Default,,0,0,0,,Енді ештеңе ұрламайсың, солай ма?
Dialogue: 0,0:26:43.06,0:26:45.56,Default,,0,0,0,,Бұл Кариб теңізінің қарақшылары көрмесі емес пе?
Dialogue: 0,0:26:47.60,0:26:48.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:26:50.31,0:26:54.19,Default,,0,0,0,,Қарақшылар әлеміне қош келдіңіздер
Dialogue: 0,0:26:54.28,0:26:56.53,Default,,0,0,0,,Мен сені күттім, патшайым.
Dialogue: 0,0:26:56.61,0:26:57.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:26:57.74,0:27:00.87,Default,,0,0,0,,Өлім әлеміне қош келдіңіз
Dialogue: 0,0:27:01.74,0:27:03.08,Default,,0,0,0,,Ха!
Dialogue: 0,0:27:04.83,0:27:06.00,Default,,0,0,0,,Джокер-кун!
Dialogue: 0,0:27:06.58,0:27:09.71,Default,,0,0,0,,Ол енді сіздің серіктесіңіз емес
Dialogue: 0,0:27:09.79,0:27:12.84,Default,,0,0,0,,Сіз мені тыңдауға тырыстыңыз.
Dialogue: 0,0:27:12.92,0:27:16.09,Default,,0,0,0,,Менің серіктесім емес, Джокер менің досым.
Dialogue: 0,0:27:17.17,0:27:19.34,Default,,0,0,0,,Genjutsu қолданушысы?
Dialogue: 0,0:27:19.43,0:27:20.80,Default,,0,0,0,,Гвааах!
Dialogue: 0,0:27:22.85,0:27:25.18,Default,,0,0,0,,Оян, Джокер-кун.
Dialogue: 0,0:27:25.26,0:27:26.64,Default,,0,0,0,,Арх!
Dialogue: 0,0:27:27.52,0:27:28.68,Default,,0,0,0,,Джокер-кун!
Dialogue: 0,0:27:28.77,0:27:30.02,Default,,0,0,0,,Ах!
Dialogue: 0,0:27:30.77,0:27:31.94,Default,,0,0,0,,Уф...
Dialogue: 0,0:27:35.19,0:27:36.48,Default,,0,0,0,,Уф...
Dialogue: 0,0:27:39.90,0:27:41.66,Default,,0,0,0,,Соңғы 10 жыл
Dialogue: 0,0:27:41.74,0:27:45.03,Default,,0,0,0,,Менің бар ойым – сені жеңу.
Dialogue: 0,0:27:45.12,0:27:47.20,Default,,0,0,0,,Бұл өте қарапайым.
Dialogue: 0,0:27:51.08,0:27:54.42,Default,,0,0,0,,Дасвиданья патшайымы
Dialogue: 0,0:27:56.17,0:27:59.72,Default,,0,0,0,,Соңғы соққыны бермейінше, сақтықты төмендетпеңіз
Dialogue: 0,0:27:59.80,0:28:00.76,Default,,0,0,0,,Уф...
Dialogue: 0,0:28:00.84,0:28:03.97,Default,,0,0,0,,Дасвиданья Зую
Dialogue: 0,0:28:09.60,0:28:11.14,Default,,0,0,0,,♬~
Dialogue: 0,0:28:11.98,0:28:14.11,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:28:14.19,0:28:16.07,Default,,0,0,0,,А...
Dialogue: 0,0:28:16.65,0:28:18.65,Default,,0,0,0,,Қош келдіңіз Джокер-кун
Dialogue: 0,0:28:18.73,0:28:20.11,Default,,0,0,0,,Қайтадан қош келдіңіз бе?
Dialogue: 0,0:28:20.19,0:28:23.86,Default,,0,0,0,,«Шындықтан көзіңді аударма»?
Dialogue: 0,0:28:23.95,0:28:26.58,Default,,0,0,0,,Бұл менің өмірімді сақтап қалды.
Dialogue: 0,0:28:26.66,0:28:28.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:28:38.55,0:28:41.30,Default,,0,0,0,,RD Қазір жақсы ма?
Dialogue: 0,0:28:41.38,0:28:43.68,Default,,0,0,0,,Иә Бұл не?
Dialogue: 0,0:28:44.55,0:28:47.85,Default,,0,0,0,,Роши мен Року әзілкеш, ал Зуюй кеме дәрігері болды.
Dialogue: 0,0:28:47.93,0:28:51.10,Default,,0,0,0,,Өздері сияқты жұртшылыққа бет бұрған қаскүнемдер
Dialogue: 0,0:28:51.18,0:28:53.44,Default,,0,0,0,,Satchmo бортында басқа біреу бар ма?
Dialogue: 0,0:28:53.52,0:28:54.94,Default,,0,0,0,,Тергеуіңізді қалаймын.
Dialogue: 0,0:28:55.02,0:28:56.52,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:28:57.57,0:29:00.53,Default,,0,0,0,,RD URRS талдауы дегеніміз не?
Dialogue: 0,0:29:01.11,0:29:02.86,Default,,0,0,0,,Мен оны қазір жіберемін
Dialogue: 0,0:29:07.66,0:29:12.04,Default,,0,0,0,,(ұшқышсыз ұшу дыбысы)
Dialogue: 0,0:29:12.12,0:29:14.71,Default,,0,0,0,,Талданатын инфрақызыл сәулелену үлгісі
Dialogue: 0,0:29:14.79,0:29:17.38,Default,,0,0,0,,Онда тасымалданды
Dialogue: 0,0:29:20.63,0:29:21.46,Default,,0,0,0,,Әй
Dialogue: 0,0:29:29.76,0:29:32.14,Default,,0,0,0,,Бағдарламаны бастау
Dialogue: 0,0:29:33.06,0:29:35.98,Default,,0,0,0,,(жоғары ырғақты музыка)
Dialogue: 0,0:29:36.06,0:29:37.35,Default,,0,0,0,,Хахаха
Dialogue: 0,0:29:40.40,0:29:42.23,Default,,0,0,0,,Иә! Ха!
Dialogue: 0,0:29:44.32,0:29:46.20,Default,,0,0,0,,Уф!
Dialogue: 0,0:29:46.28,0:29:49.41,Default,,0,0,0,,Ха ха ха ха!
Dialogue: 0,0:29:50.53,0:29:51.37,Default,,0,0,0,,(Дабыл дыбысы)
Dialogue: 0,0:29:51.45,0:29:54.46,Default,,0,0,0,,Әй, кетті! Қайтадан басынан
Dialogue: 0,0:29:55.04,0:29:57.54,Default,,0,0,0,,Бұл қызық болып барады!
Dialogue: 0,0:29:57.63,0:30:00.96,Default,,0,0,0,,Сыртынан қарасаң, біртүрлі адам екен.
Dialogue: 0,0:30:01.05,0:30:02.13,Default,,0,0,0,,Сатчмо
Dialogue: 0,0:30:02.21,0:30:05.59,Default,,0,0,0,,Бірінші байланыс портына, Майамиге келді.
Dialogue: 0,0:30:05.67,0:30:10.85,Default,,0,0,0,,Көрікті жерлерге баратындар үшін сағат 18:00-де кемеге оралуларыңызды сұраймыз.
Dialogue: 0,0:30:10.93,0:30:13.81,Default,,0,0,0,,Күніңіз сәтті өтсін!
Dialogue: 0,0:30:29.95,0:30:31.49,Default,,0,0,0,,Джотто мырза
Dialogue: 0,0:30:31.58,0:30:32.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:32.79,0:30:35.91,Default,,0,0,0,,Статистика бойынша патшайым түнде пайда болады
Dialogue: 0,0:30:36.00,0:30:39.96,Default,,0,0,0,,А, фантом ұры түнде ұрлауға бел байлады.
Dialogue: 0,0:30:40.04,0:30:43.50,Default,,0,0,0,,Ендеше біз қазір не үшін келдік?
Dialogue: 0,0:30:43.59,0:30:47.97,Default,,0,0,0,,Өйткені патшайым менің қолымда.
Dialogue: 0,0:30:48.05,0:30:49.34,Default,,0,0,0,,Хмм
Dialogue: 0,0:30:49.43,0:30:54.18,Default,,0,0,0,,Кеше түнде қауіп төнген сағаттық бомба әлі табылған жоқ.
Dialogue: 0,0:30:54.27,0:30:57.18,Default,,0,0,0,,Мен оларды іздеймін.
Dialogue: 0,0:30:57.27,0:30:59.81,Default,,0,0,0,,Осымен айналысып жатқанда, үзіліс жасаңыз.
Dialogue: 0,0:30:59.90,0:31:02.15,Default,,0,0,0,,Жоқ, тіпті қазір де, егер рұқсат етсеңіз…
Dialogue: 0,0:31:06.36,0:31:09.70,Default,,0,0,0,,Beyond Honky Tonk мағынасыз
Dialogue: 0,0:31:18.08,0:31:20.50,Default,,0,0,0,,Енді күзетшіні ұйықтатыңыз
Dialogue: 0,0:31:21.08,0:31:23.29,Default,,0,0,0,,Сіз бұл мүмкіндіктен ұрлауды жоспарлап отырсыз ба?
Dialogue: 0,0:31:23.38,0:31:25.13,Default,,0,0,0,,Не? Ах!
Dialogue: 0,0:31:25.21,0:31:26.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:31:26.71,0:31:30.43,Default,,0,0,0,,(Оқушылар) Э-э… Мүмкін емес! Мүмкін емес!
Dialogue: 0,0:31:31.51,0:31:33.22,Default,,0,0,0,,Бұл тек менің қиялым ба?
Dialogue: 0,0:31:33.30,0:31:34.60,Default,,0,0,0,,Жібер!
Dialogue: 0,0:31:34.68,0:31:35.56,Default,,0,0,0,,Мен сені жібермеймін
Dialogue: 0,0:31:36.60,0:31:38.02,Default,,0,0,0,,Дөрекі!
Dialogue: 0,0:31:38.10,0:31:39.52,Default,,0,0,0,,Хмм...
Dialogue: 0,0:31:44.15,0:31:45.52,Default,,0,0,0,,(Келу дыбысы)
Dialogue: 0,0:31:46.32,0:31:50.15,Default,,0,0,0,,А, сен мені бөлмеме апардың.
Dialogue: 0,0:31:50.24,0:31:52.95,Default,,0,0,0,,Бұл сіздің бөлмеңіздің едені ме?
Dialogue: 0,0:31:53.03,0:31:54.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:31:55.33,0:31:58.41,Default,,0,0,0,,Тоқта... қайда бара жатырсың?
Dialogue: 0,0:32:01.25,0:32:02.46,Default,,0,0,0,,(Электрондық дыбыстың құлпын ашу)
Dialogue: 0,0:32:03.79,0:32:04.71,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:32:04.79,0:32:05.96,Default,,0,0,0,,Ол басқа суреттерде де бар емес пе?
Dialogue: 0,0:32:06.05,0:32:08.80,Default,,0,0,0,,Мен Гуко патшалығының ханшайымы екенімді білгенде.
Dialogue: 0,0:32:08.88,0:32:10.34,Default,,0,0,0,,Адам ұрлауды жоспарлау
Dialogue: 0,0:32:10.88,0:32:13.89,Default,,0,0,0,,Сіз төлемді талап етуді жоспарлап отырсыз ба?
Dialogue: 0,0:32:14.47,0:32:16.47,Default,,0,0,0,,Соған ұқсайды ма?
Dialogue: 0,0:32:16.56,0:32:18.68,Default,,0,0,0,,Не? Сіз...
Dialogue: 0,0:32:18.77,0:32:20.73,Default,,0,0,0,,Уф, аа...
Dialogue: 0,0:32:20.81,0:32:22.65,Default,,0,0,0,,Қош келдіңіз Джокер-кун
Dialogue: 0,0:32:22.73,0:32:25.27,Default,,0,0,0,,Не? Ханшайым Ирма?
Dialogue: 0,0:32:25.86,0:32:28.65,Default,,0,0,0,,Мен сенің жұмысыңның енді үзілгенін қаламаймын.
Dialogue: 0,0:32:28.73,0:32:31.15,Default,,0,0,0,,Мен өзімнің шынайы болмысымды ашамын деп ойладым.
Dialogue: 0,0:32:31.24,0:32:33.20,Default,,0,0,0,,Не? Сіз ханшайымсыз ба!?
Dialogue: 0,0:32:33.28,0:32:34.91,Default,,0,0,0,,Әлгі фантом ұры ханшайымы?
Dialogue: 0,0:32:34.99,0:32:37.70,Default,,0,0,0,,Иә, сол фантом ұры ханшайымы.
Dialogue: 0,0:32:37.79,0:32:40.70,Default,,0,0,0,,Және менің досым Джокер
Dialogue: 0,0:32:40.79,0:32:42.92,Default,,0,0,0,,Іскерлік серіктес
Dialogue: 0,0:32:43.00,0:32:45.42,Default,,0,0,0,,Өтірік... Өтірік өтірік Өтірік өтірік!
Dialogue: 0,0:32:45.50,0:32:46.88,Default,,0,0,0,,Өтірікші!
Dialogue: 0,0:32:46.96,0:32:49.88,Default,,0,0,0,,Бұл шынымен де шынайы ма?
Dialogue: 0,0:32:49.96,0:32:50.92,Default,,0,0,0,,Бұл шынайы
Dialogue: 0,0:32:51.01,0:32:52.05,Default,,0,0,0,,(Ватару) Жылама—барыңды салдын ғой, иә?—
Dialogue: 0,0:32:52.13,0:32:54.59,Default,,0,0,0,,Мен әрқашан елес ұрыға тәнті болдым.
Dialogue: 0,0:32:55.18,0:32:57.85,Default,,0,0,0,,Қара плащ киіп, биік жерден секіру
Dialogue: 0,0:32:57.93,0:33:00.06,Default,,0,0,0,,Мақсатты олжаңызды жіберіп алмаңыз
Dialogue: 0,0:33:00.14,0:33:01.89,Default,,0,0,0,,Ха~
Dialogue: 0,0:33:01.98,0:33:03.77,Default,,0,0,0,,Бұл басқа адам сияқты
Dialogue: 0,0:33:03.85,0:33:07.48,Default,,0,0,0,,Сізге Кайто қатты ұнайды, солай емес пе?
Dialogue: 0,0:33:07.56,0:33:11.82,Default,,0,0,0,,Мен кішкентай кезімде елес ұрылар туралы әңгімелерді оқитынмын.
Dialogue: 0,0:33:11.90,0:33:13.24,Default,,0,0,0,,(Ватару) Не болып жатыр? Бұл әңгіме… (Ер оқушы) Ол ұялы телефонымен дауласып жатыр.
Dialogue: 0,0:33:13.32,0:33:17.83,Default,,0,0,0,,Бірақ мен ханшайыммын, мен елес ұры бола алмаймын.
Dialogue: 0,0:33:17.91,0:33:20.74,Default,,0,0,0,,Университетті бітіргеннен кейін еліңізге оралыңыз
Dialogue: 0,0:33:20.83,0:33:24.37,Default,,0,0,0,,Сіз ресми түрде тақ мұрагері боласыз деп шешілді.
Dialogue: 0,0:33:24.46,0:33:27.79,Default,,0,0,0,,Бұл сапар оның алдындағы қысқа демалыс.
Dialogue: 0,0:33:27.88,0:33:30.38,Default,,0,0,0,,Ұрлық үшін бе?
Dialogue: 0,0:33:30.46,0:33:31.30,Default,,0,0,0,,Хмм
Dialogue: 0,0:33:31.38,0:33:35.76,Default,,0,0,0,,Қарсы болмасаңыз, Гуко патшалығы туралы айтып бере аласыз ба?
Dialogue: 0,0:33:35.84,0:33:37.30,Default,,0,0,0,,Императорлық…
Dialogue: 0,0:33:37.39,0:33:41.39,Default,,0,0,0,,Бұл Satchmo Co. компаниясының өздігінен ойлап тапқан атауы.
Dialogue: 0,0:33:41.47,0:33:42.52,Default,,0,0,0,,Бұл адамдар әуесқой ма?
Dialogue: 0,0:33:42.60,0:33:45.35,Default,,0,0,0,,Әулие Орлов сапфирі
Dialogue: 0,0:33:45.94,0:33:48.73,Default,,0,0,0,,Иә Әулие Орлов сапфирі
Dialogue: 0,0:33:48.81,0:33:51.57,Default,,0,0,0,,Бастапқыда Гуко корольдік отбасына тиесілі
Dialogue: 0,0:33:51.65,0:33:52.57,Default,,0,0,0,,Мұнда рух бар.
Dialogue: 0,0:33:53.28,0:33:56.03,Default,,0,0,0,,Бір күні мен кенеттен балық ұстай алмай қалдым.
Dialogue: 0,0:33:56.11,0:34:00.28,Default,,0,0,0,,Satchmo корпорациясы бізге соңғы балық аулайтын қайықпен көмектесті.
Dialogue: 0,0:34:00.37,0:34:05.00,Default,,0,0,0,,Қазір балық аулау бұрынғыдан да оңайырақ.
Dialogue: 0,0:34:05.58,0:34:08.46,Default,,0,0,0,,Өмір әлдеқайда жеңіл болды.
Dialogue: 0,0:34:08.54,0:34:10.63,Default,,0,0,0,,Сол кезде Сатчмо
Dialogue: 0,0:34:10.71,0:34:13.09,Default,,0,0,0,,Ол осы уақытқа дейін алған өтемақыны сұрады.
Dialogue: 0,0:34:13.67,0:34:16.55,Default,,0,0,0,,«Егер сіз төлей алмасаңыз, біз балық аулайтын қайықты құтқарамыз».
Dialogue: 0,0:34:16.63,0:34:18.18,Default,,0,0,0,,Сонымен
Dialogue: 0,0:34:19.14,0:34:23.77,Default,,0,0,0,,Кепілге Әулие Орлов Сапфир алынды.
Dialogue: 0,0:34:23.85,0:34:28.15,Default,,0,0,0,,Көмекке ақы төлеу ақылға қонымды.
Dialogue: 0,0:34:28.98,0:34:34.74,Default,,0,0,0,,Жеңіл өмірдің дәмін татқаннан кейін бұрынғы өміріме қайта барғым келмеді.\NМенің ойымша,
Dialogue: 0,0:34:34.82,0:34:37.28,Default,,0,0,0,,да бар.
Dialogue: 0,0:34:37.36,0:34:40.37,Default,,0,0,0,,Мен кешіре алмайтын нәрсе - Сатчмоның әдісі!
Dialogue: 0,0:34:40.45,0:34:43.70,Default,,0,0,0,,Барлығы осы оқиғаны алдын ала жоспарланған болатын.
Dialogue: 0,0:34:43.79,0:34:46.12,Default,,0,0,0,,Айналадағы теңіздер де әдейі шамадан тыс балық аулады...
Dialogue: 0,0:34:46.21,0:34:49.46,Default,,0,0,0,,Сол себепті балық аулай алмасаңыз ше?
Dialogue: 0,0:34:49.54,0:34:51.25,Default,,0,0,0,,Халықаралық қоғамдық пікірге үндеу
Dialogue: 0,0:34:51.34,0:34:54.46,Default,,0,0,0,,Мүмкін мен асыл бұйымдарымды қайтарып алармын.
Dialogue: 0,0:34:55.17,0:34:57.22,Default,,0,0,0,,Дәлелдер жоқ
Dialogue: 0,0:34:57.30,0:35:00.09,Default,,0,0,0,,Сіз бәрібір бас тарта алмайсыз
Dialogue: 0,0:35:00.18,0:35:01.72,Default,,0,0,0,,Егер мен осы жерден бас тартсам
Dialogue: 0,0:35:01.80,0:35:04.93,Default,,0,0,0,,Гуко патшалығын Satchmo корпорациясы иеленді.
Dialogue: 0,0:35:05.02,0:35:06.27,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:35:06.35,0:35:09.56,Default,,0,0,0,,Ол аралды курортқа айналдыруды жоспарлайды.
Dialogue: 0,0:35:09.65,0:35:11.06,Default,,0,0,0,,Мен туып өскен арал
Dialogue: 0,0:35:11.15,0:35:13.15,Default,,0,0,0,,Көлеңкенің жоғалып бара жатқанын көру
Dialogue: 0,0:35:13.23,0:35:14.82,Default,,0,0,0,,Бұған төзгісіз
Dialogue: 0,0:35:15.44,0:35:17.82,Default,,0,0,0,,Біз ақымақ болдық
Dialogue: 0,0:35:17.90,0:35:20.66,Default,,0,0,0,,Әулие Орлов сапфирін қалпына келтіріңіз
Dialogue: 0,0:35:20.74,0:35:24.12,Default,,0,0,0,,Гуко патшалығын бұрынғыдай қалпына келтіруге болады.
Dialogue: 0,0:35:24.20,0:35:25.91,Default,,0,0,0,,Бұл менің миссиям.
Dialogue: 0,0:35:25.99,0:35:27.12,Default,,0,0,0,,Сонымен!
Dialogue: 0,0:35:27.20,0:35:30.75,Default,,0,0,0,,Мен оны патшайым ұрлағанша ұрлаймын.
Dialogue: 0,0:35:31.33,0:35:32.58,Default,,0,0,0,,Өте жақсы
Dialogue: 0,0:35:33.17,0:35:36.42,Default,,0,0,0,,Ол фантом ұры ханшайымының лайықты қарсыласы.
Dialogue: 0,0:35:36.51,0:35:38.01,Default,,0,0,0,,Күрсін!
Dialogue: 0,0:35:39.17,0:35:40.88,Default,,0,0,0,,Дегенмен, не?
Dialogue: 0,0:35:40.97,0:35:44.60,Default,,0,0,0,,Фантомды ұрыда фантом ұры эстетикасы бар
Dialogue: 0,0:35:44.68,0:35:48.39,Default,,0,0,0,,Шыны қорапты балғамен сындыру - жоқ.
Dialogue: 0,0:35:48.48,0:35:49.69,Default,,0,0,0,,Иә...
Dialogue: 0,0:35:49.77,0:35:53.52,Default,,0,0,0,,Қарсы болмасаң, мен саған елес ұрының эстетикасын үйретемін.
Dialogue: 0,0:35:53.61,0:35:56.11,Default,,0,0,0,,Ах~ Иә, өтінемін!
Dialogue: 0,0:35:56.69,0:35:58.11,Default,,0,0,0,,Хмм...
Dialogue: 0,0:36:07.37,0:36:09.75,Default,,0,0,0,,Елес ұры эстетикасын жаттықтыру
Dialogue: 0,0:36:10.41,0:36:15.00,Default,,0,0,0,,Дене шынықтырылған, сезім мүшелері шыңдалған
Dialogue: 0,0:36:15.09,0:36:20.30,Default,,0,0,0,,Ең бастысы, сәйкес сән маңызды!
Dialogue: 0,0:36:20.38,0:36:21.97,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:36:23.22,0:36:24.47,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:36:27.47,0:36:28.60,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:36:37.61,0:36:40.07,Default,,0,0,0,,Қарапайым адам ретінде, бәрібір.
Dialogue: 0,0:36:40.15,0:36:43.16,Default,,0,0,0,,Елес ұры ретінде менің әлі алда көп жолым бар.
Dialogue: 0,0:36:43.24,0:36:45.99,Default,,0,0,0,,Бұл менің бірінші рет, сондықтан мен оған көмектесе алмаймын.
Dialogue: 0,0:36:46.07,0:36:47.53,Default,,0,0,0,,Бұл ақталу ма?
Dialogue: 0,0:36:47.62,0:36:49.41,Default,,0,0,0,,Оқыту әдістерінің нашарлығынан.
Dialogue: 0,0:36:49.49,0:36:52.75,Default,,0,0,0,,Сылтау айтқаннан кейін, басқа адам кінәлі ме?
Dialogue: 0,0:36:52.83,0:36:55.58,Default,,0,0,0,,Ақыр аяғында, сен қара адамсың.
Dialogue: 0,0:36:55.67,0:36:58.46,Default,,0,0,0,,Ашулану жақсы белгі, солай емес пе?
Dialogue: 0,0:36:58.55,0:37:00.38,Default,,0,0,0,,Дөрекі! Дөрекі адам Дөрекі адам Дөрекі адам!
Dialogue: 0,0:37:00.46,0:37:03.30,Default,,0,0,0,,Ол керемет келесі патшайым.
Dialogue: 0,0:37:04.18,0:37:06.39,Default,,0,0,0,,Эй, сен қашып барасың ба?
Dialogue: 0,0:37:06.47,0:37:07.80,Default,,0,0,0,,Макияжды өңдеу
Dialogue: 0,0:37:07.89,0:37:09.60,Default,,0,0,0,,Хмм...
Dialogue: 0,0:37:09.68,0:37:14.02,Default,,0,0,0,,Балабақша мұғалімі болу қиын жұмыс болуы керек.
Dialogue: 0,0:37:15.94,0:37:17.86,Default,,0,0,0,,Ах... иә?
Dialogue: 0,0:37:22.95,0:37:24.40,Default,,0,0,0,,Хмм...
Dialogue: 0,0:37:26.74,0:37:28.78,Default,,0,0,0,,Ирма ханшайым не істейді?
Dialogue: 0,0:37:28.87,0:37:32.33,Default,,0,0,0,,(көтеріңкі самба музыкасы)
Dialogue: 0,0:37:32.41,0:37:35.29,Default,,0,0,0,,Туған күніңмен Ирма!
Dialogue: 0,0:37:35.37,0:37:36.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:36.42,0:37:38.38,Default,,0,0,0,,Бұл сіздің туған күніңіз болды ма?
Dialogue: 0,0:37:38.46,0:37:43.05,Default,,0,0,0,,Сіз қателесесіз. Менің туған күнім 21 наурыз.
Dialogue: 0,0:37:43.13,0:37:44.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:44.09,0:37:46.47,Default,,0,0,0,,Бұл дыбыс...
Dialogue: 0,0:37:46.55,0:37:50.43,Default,,0,0,0,,(нұқыңыз ... түймесін басыңыз)
Dialogue: 0,0:37:51.01,0:37:53.43,Default,,0,0,0,,Бір жерде сағаттық бомба орнатылған.
Dialogue: 0,0:37:53.52,0:37:54.64,Default,,0,0,0,,Иә!?
Dialogue: 0,0:37:54.73,0:37:56.98,Default,,0,0,0,,(нұқыңыз ... түймесін басыңыз)
Dialogue: 0,0:37:57.06,0:37:58.11,Default,,0,0,0,,Сол жерде.
Dialogue: 0,0:37:59.36,0:38:00.57,Default,,0,0,0,,Флешмоб!
Dialogue: 0,0:38:02.19,0:38:03.03,Default,,0,0,0,,Хамф!
Dialogue: 0,0:38:06.66,0:38:07.49,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:38:08.66,0:38:11.79,Default,,0,0,0,,Кешегі бомба қаупі осы болды.
Dialogue: 0,0:38:11.87,0:38:14.62,Default,,0,0,0,,Мен кінәлінің аты-жөні екеніне сенімдімін
Dialogue: 0,0:38:14.71,0:38:16.62,Default,,0,0,0,,Гуконың айдаһары
Dialogue: 0,0:38:16.71,0:38:18.21,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:38:19.33,0:38:20.42,Default,,0,0,0,,Иә
Dialogue: 0,0:38:21.00,0:38:25.51,Default,,0,0,0,,Гуконың айдаһары менімен алғаш рет өткен көктемде хабарласты.
Dialogue: 0,0:38:25.59,0:38:27.38,Default,,0,0,0,,Университет жатақханасына оралу
Dialogue: 0,0:38:27.47,0:38:30.47,Default,,0,0,0,,«Гуко патшалығына қайтып оралма» жазбасы.
Dialogue: 0,0:38:31.18,0:38:35.31,Default,,0,0,0,,Бөлмеме қайтып келгенде, негізгі газ клапанының ашылғанын көрдім.
Dialogue: 0,0:38:35.39,0:38:36.73,Default,,0,0,0,,Әзірге
Dialogue: 0,0:38:36.81,0:38:39.56,Default,,0,0,0,,Сіз Гуконың айдаһарын көрдіңіз бе?
Dialogue: 0,0:38:39.65,0:38:40.77,Default,,0,0,0,,Жоқ
Dialogue: 0,0:38:40.86,0:38:44.07,Default,,0,0,0,,Сізді станция платформасында немесе баспалдақта арқаңызбен итеріп жіберген кезіңіз болды ма?
Dialogue: 0,0:38:44.82,0:38:45.65,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:38:45.74,0:38:47.61,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:38:47.70,0:38:49.41,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:38:49.99,0:38:54.95,Default,,0,0,0,,Егер Гуконың айдаһарының нысанасы сапфир болса, ол неліктен кемені жарып жібереді?
Dialogue: 0,0:38:55.04,0:38:58.37,Default,,0,0,0,,Ол теңіз түбіне батып, қол жетпейтін болады.
Dialogue: 0,0:38:59.17,0:39:02.04,Default,,0,0,0,,Гуконың айдаһары жер бетінде не істегісі келеді?
Dialogue: 0,0:39:02.13,0:39:03.71,Default,,0,0,0,,Мен ғана емес
Dialogue: 0,0:39:03.80,0:39:06.97,Default,,0,0,0,,Сізге немесе сіздің жолаушыларыңызға қауіп төнсе
Dialogue: 0,0:39:07.05,0:39:11.34,Default,,0,0,0,,Мен сіз үшін алаңдаймын, Ирма ханшайым.
Dialogue: 0,0:39:11.43,0:39:13.68,Default,,0,0,0,,Джокер менің сүйемелдеуім болсын.
Dialogue: 0,0:39:13.76,0:39:15.43,Default,,0,0,0,,Бұл мүмкін емес!
Dialogue: 0,0:39:15.52,0:39:17.64,Default,,0,0,0,,Ұялудың қажеті жоқ
Dialogue: 0,0:39:17.73,0:39:20.94,Default,,0,0,0,,Қарсы болмасаңыз, біздің бөлмеде жатқыңыз келе ме?
Dialogue: 0,0:39:21.02,0:39:24.32,Default,,0,0,0,,Мен бұдан былай қиындық тудырғым келмейді.
Dialogue: 0,0:39:24.40,0:39:27.28,Default,,0,0,0,,Ханшайым Сен енді сенімдісің бе?
Dialogue: 0,0:39:27.36,0:39:28.57,Default,,0,0,0,,Қазір сіздің дауысыңыз қандай?
Dialogue: 0,0:39:28.65,0:39:32.49,Default,,0,0,0,,Ол Трубадурдың RD-ге қосылған.
Dialogue: 0,0:39:32.57,0:39:34.62,Default,,0,0,0,,Танысқаныма қуаныштымын, Ирма ханшайым
Dialogue: 0,0:39:34.70,0:39:37.62,Default,,0,0,0,,Әлемдегі ең жақсы жасанды интеллект
Dialogue: 0,0:39:37.70,0:39:41.21,Default,,0,0,0,,Танысқаныма қуаныштымын, РД мырза
Dialogue: 0,0:39:41.29,0:39:42.75,Default,,0,0,0,,“san” қосу…
Dialogue: 0,0:39:43.29,0:39:44.67,Default,,0,0,0,,Хехе
Dialogue: 0,0:39:44.75,0:39:45.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:39:45.96,0:39:48.38,Default,,0,0,0,,Енді РД... (Джокер) Иә.
Dialogue: 0,0:39:48.47,0:39:51.09,Default,,0,0,0,,Гохон сөзін жалғастырды Жарай ма?
Dialogue: 0,0:39:51.18,0:39:52.97,Default,,0,0,0,,Ах... а
Dialogue: 0,0:39:53.05,0:39:54.93,Default,,0,0,0,,Барлығы 7 өлтіруші бар.
Dialogue: 0,0:39:55.01,0:39:58.02,Default,,0,0,0,,Хатсуро есімі есіңізде ме?
Dialogue: 0,0:39:58.10,0:39:59.94,Default,,0,0,0,,Әй, Хатсуро!
Dialogue: 0,0:40:00.02,0:40:03.11,Default,,0,0,0,,Ойлап қарасам, мен сол балалармен ойнағандай болдым.
Dialogue: 0,0:40:03.69,0:40:05.98,Default,,0,0,0,,Роши Року Зуюдан басқа
Dialogue: 0,0:40:06.07,0:40:07.57,Default,,0,0,0,,Қандай жауларың болды?
Dialogue: 0,0:40:07.65,0:40:11.32,Default,,0,0,0,,Хмм, мен оны әп-сәтте жеңдім, сондықтан есімде жоқ.
Dialogue: 0,0:40:11.40,0:40:13.41,Default,,0,0,0,,Еске алғым келмейтін жауларым болды.
Dialogue: 0,0:40:13.99,0:40:16.58,Default,,0,0,0,,Бодибилдер Чама есіңізде ме?
Dialogue: 0,0:40:16.66,0:40:18.87,Default,,0,0,0,,Арнайы дағды – «Өлім құшағында»
Dialogue: 0,0:40:18.95,0:40:20.58,Default,,0,0,0,,Өлім құшағында?
Dialogue: 0,0:40:20.66,0:40:23.71,Default,,0,0,0,,Бұлшық ет жаттығулары арқылы жаттықтырылған қолдармен нысананы құшақтау
Dialogue: 0,0:40:23.79,0:40:26.17,Default,,0,0,0,,Еріндері уланған сүйіспеншілік
Dialogue: 0,0:40:23.79,0:40:26.17,Default,,0,0,0,,～
Dialogue: 0,0:40:26.25,0:40:27.67,Default,,0,0,0,,Еске салма!
Dialogue: 0,0:40:28.26,0:40:31.13,Default,,0,0,0,,Сонымен А (Эйс) Зукия есімді құмар ойыншы кім?
Dialogue: 0,0:40:31.84,0:40:34.09,Default,,0,0,0,,Бұл сен емессің бе?
Dialogue: 0,0:40:34.68,0:40:36.93,Default,,0,0,0,,Есімде болса, қару... алдау.
Dialogue: 0,0:40:37.01,0:40:39.06,Default,,0,0,0,,Пинг теннисі Дұрыс
Dialogue: 0,0:40:40.18,0:40:42.31,Default,,0,0,0,,Жүр, дереу оны көруге барайық.
Dialogue: 0,0:40:42.39,0:40:44.40,Default,,0,0,0,,Мен де солай ете аламын ба?
Dialogue: 0,0:40:44.48,0:40:47.23,Default,,0,0,0,,Мен бір рет казиноға барғым келді.
Dialogue: 0,0:40:47.32,0:40:49.94,Default,,0,0,0,,«Саяхат – серік, түнде ішу»
Dialogue: 0,0:40:50.03,0:40:51.03,Default,,0,0,0,,Алкоголь?
Dialogue: 0,0:40:51.11,0:40:55.07,Default,,0,0,0,,Бірге саяхаттағанда, түнде ішімдік ішіп, мас болайық!
Dialogue: 0,0:40:55.16,0:40:56.53,Default,,0,0,0,,білдіреді
Dialogue: 0,0:40:56.62,0:40:58.49,Default,,0,0,0,,Шығыстың жұмбағы.
Dialogue: 0,0:40:59.16,0:41:01.62,Default,,0,0,0,,«түнде ішпеу»
Dialogue: 0,0:41:01.71,0:41:03.33,Default,,0,0,0,,«Әлем мейірімді»
Dialogue: 0,0:41:03.42,0:41:08.17,Default,,0,0,0,,Енді, сусын ішіп, казиноға барайық!
Dialogue: 0,0:41:12.63,0:41:15.55,Default,,0,0,0,,Қарғыс атсын! мен жеңілдім!
Dialogue: 0,0:41:16.51,0:41:19.64,Default,,0,0,0,,Сіз жеңдіңіз! Тағы бір рет
Dialogue: 0,0:41:19.72,0:41:22.35,Default,,0,0,0,,Көп тиын шықты.
Dialogue: 0,0:41:22.98,0:41:27.06,Default,,0,0,0,,Ирма ханшайым бүгінгі түндегі ең ыстық адам сияқты.
Dialogue: 0,0:41:27.77,0:41:29.52,Default,,0,0,0,,Мен сені күттім, патшайым.
Dialogue: 0,0:41:29.61,0:41:31.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:41:31.11,0:41:33.65,Default,,0,0,0,,Бұл қазір Анджелик пе?
Dialogue: 0,0:41:34.86,0:41:37.53,Default,,0,0,0,,Хехехе
Dialogue: 0,0:41:44.50,0:41:48.25,Default,,0,0,0,,Лади Лак, карточкаларды тарата аласыз ба?
Dialogue: 0,0:41:48.34,0:41:51.13,Default,,0,0,0,,Мен!? Күрсін
Dialogue: 0,0:41:52.30,0:41:53.38,Default,,0,0,0,,Иә
Dialogue: 0,0:41:55.01,0:41:56.38,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:41:56.47,0:41:58.60,Default,,0,0,0,,Хехехе
Dialogue: 0,0:41:59.64,0:42:02.18,Default,,0,0,0,,Оны қандай жолмен тарату керек?
Dialogue: 0,0:42:02.27,0:42:05.85,Default,,0,0,0,,Мен сізге беремін, өтінемін.
Dialogue: 0,0:42:05.94,0:42:06.77,Default,,0,0,0,,Иә
Dialogue: 0,0:42:08.94,0:42:13.61,Default,,0,0,0,,Мен 10 жыл күттім. Тек покер қызық емес.
Dialogue: 0,0:42:13.69,0:42:14.69,Default,,0,0,0,,Бір ғана орын бар
Dialogue: 0,0:42:14.78,0:42:16.95,Default,,0,0,0,,Соқыр ойын ойнайық
Dialogue: 0,0:42:17.03,0:42:20.03,Default,,0,0,0,,Бұл карталарға қарамай ойнау туралы.
Dialogue: 0,0:42:20.12,0:42:22.24,Default,,0,0,0,,Және ставкалар.
Dialogue: 0,0:42:22.33,0:42:26.00,Default,,0,0,0,,Чиптердің орнына картаны аударған сайын не тігу керектігін шешу
Dialogue: 0,0:42:26.08,0:42:27.25,Default,,0,0,0,,Зұлым орыннан қозғалмайды!
Dialogue: 0,0:42:27.33,0:42:30.84,Default,,0,0,0,,Мен таратып бердім, сол жерден бастайық.
Dialogue: 0,0:42:30.92,0:42:33.59,Default,,0,0,0,,Жарайды, менен.
Dialogue: 0,0:42:33.67,0:42:36.09,Default,,0,0,0,,Бірінші фото коктейль.
Dialogue: 0,0:42:43.39,0:42:45.31,Default,,0,0,0,,(Жолаушылар айқайлайды)
Dialogue: 0,0:42:46.56,0:42:49.15,Default,,0,0,0,,Екінші көтерілу - 100 миллион доллар!
Dialogue: 0,0:42:49.23,0:42:52.61,Default,,0,0,0,,100 миллион доллар!? Шын айтасың ба? Бұл ақылсыз!
Dialogue: 0,0:42:55.15,0:42:56.57,Default,,0,0,0,,Бір жұп!
Dialogue: 0,0:43:00.49,0:43:02.70,Default,,0,0,0,,Бұл A (ace). Мен сене алар емеспін!
Dialogue: 0,0:43:05.29,0:43:06.54,Default,,0,0,0,,Кираны қуалау – кешірілмейтін әрекет; оны тіпті қылмыс деп те айтуға болады
Dialogue: 0,0:43:06.62,0:43:08.87,Default,,0,0,0,,Көтеріңіз! 1 миллиард доллар
Dialogue: 0,0:43:09.87,0:43:11.79,Default,,0,0,0,,Үш түрлі!
Dialogue: 0,0:43:13.00,0:43:14.21,Default,,0,0,0,,Үш түрлі!
Dialogue: 0,0:43:14.30,0:43:15.55,Default,,0,0,0,,Бұл шешілді.
Dialogue: 0,0:43:16.13,0:43:19.68,Default,,0,0,0,,Егер сіз қазір түссеңіз, сізге 1 миллиард доллар төлеудің қажеті жоқ.
Dialogue: 0,0:43:19.76,0:43:21.68,Default,,0,0,0,,Маған айтып тұрсың ба?
Dialogue: 0,0:43:21.76,0:43:26.14,Default,,0,0,0,,Дахахаха! Бұл тамаша. Бұл құмар ойыны.
Dialogue: 0,0:43:27.14,0:43:30.35,Default,,0,0,0,,Төртінші парақ – өмір бойы жылдық табыс.
Dialogue: 0,0:43:30.44,0:43:32.56,Default,,0,0,0,,Сіз оны қабылдайсыз ба!? Бұл қисынсыз.
Dialogue: 0,0:43:35.48,0:43:36.99,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:43:38.70,0:43:40.57,Default,,0,0,0,,Хихихихихи…
Dialogue: 0,0:43:40.66,0:43:42.57,Default,,0,0,0,,Ах ха ха ха...
Dialogue: 0,0:43:42.66,0:43:46.54,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:43:47.58,0:43:48.58,Default,,0,0,0,,Ха
Dialogue: 0,0:43:48.66,0:43:49.50,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:43:54.21,0:43:56.13,Default,,0,0,0,,Бұл менің жеңісім!
Dialogue: 0,0:43:56.21,0:43:59.34,Default,,0,0,0,,Соңғы карта әлі қалды
Dialogue: 0,0:43:59.42,0:44:04.35,Default,,0,0,0,,Бес картаны мақсат етесіз бе? Егер ол айналатын болса, бұл жалғыз жол
Dialogue: 0,0:44:04.43,0:44:07.68,Default,,0,0,0,,Кешіріңіз! Джокер қосылмаған
Dialogue: 0,0:44:07.77,0:44:08.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:44:08.85,0:44:11.39,Default,,0,0,0,,Ойын әлі аяқталған жоқ
Dialogue: 0,0:44:11.48,0:44:12.60,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:44:13.27,0:44:15.19,Default,,0,0,0,,Бесінші
Dialogue: 0,0:44:15.27,0:44:17.15,Default,,0,0,0,,Менің өмірім
Dialogue: 0,0:44:17.23,0:44:18.49,Default,,0,0,0,,Сіз не ойлап отырсыз!
Dialogue: 0,0:44:18.57,0:44:20.95,Default,,0,0,0,,Жеңіске жету мүмкіндігі жоқ! Бірдеңе дұрыс емес
Dialogue: 0,0:44:21.03,0:44:23.95,Default,,0,0,0,,Сіз шынымен Джокерді қостыңыз ба?
Dialogue: 0,0:44:25.12,0:44:26.41,Default,,0,0,0,,А...
Dialogue: 0,0:44:26.49,0:44:28.24,Default,,0,0,0,,Хмм...
Dialogue: 0,0:44:28.33,0:44:30.16,Default,,0,0,0,,Күресу үшін бар болғаны осы.
Dialogue: 0,0:44:30.25,0:44:33.63,Default,,0,0,0,,Тозақта өкінесің!
Dialogue: 0,0:44:35.88,0:44:37.09,Default,,0,0,0,,Жоқ... а...
Dialogue: 0,0:44:37.67,0:44:39.38,Default,,0,0,0,,Жүректердің екі асы?
Dialogue: 0,0:44:44.30,0:44:46.85,Default,,0,0,0,,Сіз нені айтасыз!? Сен алаяқсың!
Dialogue: 0,0:44:46.93,0:44:48.56,Default,,0,0,0,,Эй, досым! Эй, досым!
Dialogue: 0,0:44:49.27,0:44:51.27,Default,,0,0,0,,Неліктен екі жүрек Эйс бар?
Dialogue: 0,0:44:51.35,0:44:53.98,Default,,0,0,0,,Түсіндіре аласыз ба?
Dialogue: 0,0:44:54.06,0:44:58.11,Default,,0,0,0,,Сіз соңғы картаға қол тигіздіңіз.
Dialogue: 0,0:44:58.19,0:45:00.28,Default,,0,0,0,,Иә, иә, түсіндіріңіз!
Dialogue: 0,0:45:00.36,0:45:02.40,Default,,0,0,0,,Тезірек жүр, алдадың!
Dialogue: 0,0:45:02.49,0:45:05.87,Default,,0,0,0,,Мен емес, мен жай ғана...
Dialogue: 0,0:45:05.95,0:45:08.28,Default,,0,0,0,,Сәлем! Мен алдаған болуым керек
Dialogue: 0,0:45:08.37,0:45:09.91,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:45:09.99,0:45:12.04,Default,,0,0,0,,Уф...
Dialogue: 0,0:45:18.25,0:45:19.46,Default,,0,0,0,,Зукия қалай болды
Dialogue: 0,0:45:19.55,0:45:21.26,Default,,0,0,0,,Сіз алдадыңыз ба?
Dialogue: 0,0:45:21.34,0:45:23.01,Default,,0,0,0,,Бұл оңай.
Dialogue: 0,0:45:23.09,0:45:26.59,Default,,0,0,0,,Алдын ала Q (ханшайым) және A (ace) карталарынан тұратын карталар кезектесіп орналасады.
Dialogue: 0,0:45:26.68,0:45:27.85,Default,,0,0,0,,Мен оны дайындадым.
Dialogue: 0,0:45:30.93,0:45:33.64,Default,,0,0,0,,Мен оны мүлде байқамадым.
Dialogue: 0,0:45:33.73,0:45:35.40,Default,,0,0,0,,Бұл мақсат
Dialogue: 0,0:45:35.48,0:45:38.06,Default,,0,0,0,,Егер сіз кәсіби дилер болсаңыз, сізде карта болған кезде
Dialogue: 0,0:45:38.15,0:45:40.69,Default,,0,0,0,,Сіз парақтардың көп екенін байқайсыз.
Dialogue: 0,0:45:40.78,0:45:41.94,Default,,0,0,0,,Ах
Dialogue: 0,0:45:42.53,0:45:46.41,Default,,0,0,0,,Бірақ неге Зукияның екі Эйс жүректері болды?
Dialogue: 0,0:45:46.49,0:45:48.87,Default,,0,0,0,,Хехехе
Dialogue: 0,0:45:48.95,0:45:50.62,Default,,0,0,0,,Сен де алдайсың ба!?
Dialogue: 0,0:45:50.70,0:45:52.20,Default,,0,0,0,,Юкине, сонда ісіңді бітірген соң дүкенге қара.
Dialogue: 0,0:45:52.29,0:45:54.46,Default,,0,0,0,,Картаны тексеру уақыты келді.
Dialogue: 0,0:45:55.04,0:45:58.13,Default,,0,0,0,,Палубадан Ace of Hearts-ті шығарыңыз.
Dialogue: 0,0:45:59.00,0:46:03.13,Default,,0,0,0,,Қарсыласым алдамай тұрып, мен Жүректердің Эйсін қайтардым.
Dialogue: 0,0:46:03.72,0:46:06.55,Default,,0,0,0,,Егер алдаушы сенен асып кетсе
Dialogue: 0,0:46:06.63,0:46:07.89,Default,,0,0,0,,Егер Зукия дайындалып жатса
Dialogue: 0,0:46:08.55,0:46:10.39,Default,,0,0,0,,Сіз не істеуді жоспарладыңыз?
Dialogue: 0,0:46:10.47,0:46:12.02,Default,,0,0,0,,Иә
Dialogue: 0,0:46:12.10,0:46:15.02,Default,,0,0,0,,Уақыт – уақыт.
Dialogue: 0,0:46:15.10,0:46:19.90,Default,,0,0,0,,100% жеңетініңізді білгенде, бәсекелесу қызық емес
Dialogue: 0,0:46:19.98,0:46:22.15,Default,,0,0,0,,Бұл тамаша казино.
Dialogue: 0,0:46:22.23,0:46:27.24,Default,,0,0,0,,Сіз жеңу немесе жеңілу қуанышынан толық ләззат алуыңыз керек.
Dialogue: 0,0:46:27.32,0:46:29.07,Default,,0,0,0,,Сіз кімсіз...
Dialogue: 0,0:46:29.16,0:46:32.91,Default,,0,0,0,,Мен нағыз елес ұрымын, елес ұры ханшайымымын.
Dialogue: 0,0:46:32.99,0:46:35.75,Default,,0,0,0,,Түсінгеніңізге қуаныштымын.
Dialogue: 0,0:46:38.08,0:46:40.04,Default,,0,0,0,,Елес ұры эстетикасына
Dialogue: 0,0:46:42.13,0:46:44.26,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:46:52.76,0:46:55.27,Default,,0,0,0,,(ханшайымның қорылдауы)
Dialogue: 0,0:46:57.02,0:46:57.85,Default,,0,0,0,,Әй!
Dialogue: 0,0:47:05.78,0:47:08.15,Default,,0,0,0,,Жарайды хехехе
Dialogue: 0,0:47:08.86,0:47:09.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:47:09.78,0:47:11.74,Default,,0,0,0,,Сен не істеп жатырсың?
Dialogue: 0,0:47:11.82,0:47:14.41,Default,,0,0,0,,Иә!? Джокер мырза, неге?
Dialogue: 0,0:47:15.45,0:47:17.91,Default,,0,0,0,,Есіктің құлпын бомбамен үрлеңіз
Dialogue: 0,0:47:18.50,0:47:23.38,Default,,0,0,0,,Жоғарыдағы зергерлік бұйымдар галереясының тесіктерін кесу үшін осы шынжырлы араны пайдаланыңыз.
Dialogue: 0,0:47:23.46,0:47:26.97,Default,,0,0,0,,Менің ойымша, бұл елес ұры эстетикасына сәйкес келмейді.
Dialogue: 0,0:47:27.05,0:47:28.59,Default,,0,0,0,,Әркім әрқалай сезінеді
Dialogue: 0,0:47:28.68,0:47:31.68,Default,,0,0,0,,Сіз жарылғыш заттарды қалай әкелдіңіз?
Dialogue: 0,0:47:31.76,0:47:33.30,Default,,0,0,0,,Қауіпсіздік тексерісі болды, солай ма?
Dialogue: 0,0:47:33.93,0:47:36.27,Default,,0,0,0,,Мен оны макияж креміме араластырдым.
Dialogue: 0,0:47:36.35,0:47:38.52,Default,,0,0,0,,Әйтеуір бұл жерден кетейік.
Dialogue: 0,0:47:38.60,0:47:40.90,Default,,0,0,0,,Жібер! Дөрекі адам!
Dialogue: 0,0:47:43.11,0:47:45.78,Default,,0,0,0,,Э-э, 24 маусым: саған 1000 йен беремін.
Dialogue: 0,0:47:45.86,0:47:48.53,Default,,0,0,0,,Бұл, әрине, тамаша емес.
Dialogue: 0,0:47:48.61,0:47:51.11,Default,,0,0,0,,Енді абайсызда ештеңе жасамаңыз
Dialogue: 0,0:47:51.20,0:47:53.99,Default,,0,0,0,,Ханшайым Ирма тәулігіне 24 сағат бақыланады.
Dialogue: 0,0:47:54.08,0:47:55.58,Default,,0,0,0,,24 сағат!?
Dialogue: 0,0:47:55.66,0:47:59.50,Default,,0,0,0,,Патшайым, мына жабайы итке бірдеңе беріңізші!
Dialogue: 0,0:47:59.58,0:48:00.46,Default,,0,0,0,,Ит...
Dialogue: 0,0:48:00.54,0:48:02.42,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:48:02.50,0:48:05.13,Default,,0,0,0,,Сенің мені бақылап, артымнан еріп келе жатқаныңа сене алар емеспін.
Dialogue: 0,0:48:05.21,0:48:07.13,Default,,0,0,0,,Аңшы ит сияқты емес пе?
Dialogue: 0,0:48:07.71,0:48:11.47,Default,,0,0,0,,Біреудің қозғалғанын сезсем, мен ұйықтай алмаймын.
Dialogue: 0,0:48:12.22,0:48:14.30,Default,,0,0,0,,Бұл менің кішкентай кезімнен қалыптасқан әдетім.
Dialogue: 0,0:48:15.14,0:48:17.89,Default,,0,0,0,,Сіз өте нашар тәрбие алған болуыңыз керек.
Dialogue: 0,0:48:22.40,0:48:26.36,Default,,0,0,0,,Ах, у... мен...
Dialogue: 0,0:48:28.57,0:48:30.74,Default,,0,0,0,,Сіз білмейсіз
Dialogue: 0,0:48:36.03,0:48:40.16,Default,,0,0,0,,Жақсы, біз бір-біріміз туралы сөйлескенде, біз бір-бірімізді айтамыз.
Dialogue: 0,0:48:40.87,0:48:44.54,Default,,0,0,0,,Әркімнің өткені бар, оған қол тигізгісі келмейді.
Dialogue: 0,0:48:47.21,0:48:50.09,Default,,0,0,0,,Осындай жағдайда не істеу керектігін білесіз бе?
Dialogue: 0,0:48:53.38,0:48:56.39,Default,,0,0,0,,Кешірім сұрау, кешірім сұрау.
Dialogue: 0,0:48:56.97,0:49:00.27,Default,,0,0,0,,Бұл да елес ұрының эстетикасы ма?
Dialogue: 0,0:49:00.35,0:49:01.85,Default,,0,0,0,,Хаха, бұл шектен шыққан.
Dialogue: 0,0:49:01.93,0:49:04.69,Default,,0,0,0,,Бұл адамның жалпы санасы
Dialogue: 0,0:49:23.16,0:49:24.37,Default,,0,0,0,,Өтінемін, осы жерде қалыңыз.
Dialogue: 0,0:49:25.21,0:49:26.54,Default,,0,0,0,,Өтінемін, осы жерде қалыңыз.
Dialogue: 0,0:49:27.09,0:49:28.71,Default,,0,0,0,,Мавару үшін!
Dialogue: 0,0:49:29.30,0:49:30.71,Default,,0,0,0,,Хмм...
Dialogue: 0,0:49:34.80,0:49:35.64,Default,,0,0,0,,Ах
Dialogue: 0,0:49:36.22,0:49:37.43,Default,,0,0,0,,Қайырлы кеш
Dialogue: 0,0:49:37.51,0:49:40.97,Default,,0,0,0,,А... а, сол кез
Dialogue: 0,0:49:41.06,0:49:43.98,Default,,0,0,0,,Бұл бөлім үшін рахмет.
Dialogue: 0,0:49:44.06,0:49:46.44,Default,,0,0,0,,Тоқу жоқ па?
Dialogue: 0,0:49:46.52,0:49:50.07,Default,,0,0,0,,Иә, мен белгілі бір себептермен ұйықтай алмаймын.
Dialogue: 0,0:49:50.15,0:49:51.19,Default,,0,0,0,,баллоннан ауа ағады.
Dialogue: 0,0:49:51.28,0:49:53.44,Default,,0,0,0,,Ұлымның туған күніне сыйлық ретінде.
Dialogue: 0,0:49:53.53,0:49:56.53,Default,,0,0,0,,Мен ойланып отырмын, сен қалай ойлайсың?
Dialogue: 0,0:49:56.61,0:49:57.62,Default,,0,0,0,,Басқаша айтқанда… бұл…➡
Dialogue: 0,0:49:57.70,0:50:00.28,Default,,0,0,0,,Дұрыс, кешіріңіз.
Dialogue: 0,0:50:00.37,0:50:04.50,Default,,0,0,0,,Менің ұлыма ұқсас атмосфера болғандықтан, мен жай ғана...
Dialogue: 0,0:50:05.04,0:50:09.21,Default,,0,0,0,,Жоқ, менің ата-анам жоқ, сондықтан мен түсінбеймін.
Dialogue: 0,0:50:09.29,0:50:12.30,Default,,0,0,0,,Аа... Шынымен кешіріңіз.
Dialogue: 0,0:50:12.38,0:50:15.97,Default,,0,0,0,,Кешіріңіз, мен сізге көмектесе алмаймын.
Dialogue: 0,0:50:16.05,0:50:17.01,Default,,0,0,0,,Жарайды, тікелей іске кірісейік. Шинигамиңді Мисакиге де көрсет.
Dialogue: 0,0:50:17.09,0:50:18.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:50:25.56,0:50:29.15,Default,,0,0,0,,(борттық хабар тарату музыкасы)
Dialogue: 0,0:50:29.23,0:50:31.07,Default,,0,0,0,,Жылдам кел, көмектес маған
Dialogue: 0,0:50:31.15,0:50:32.90,Default,,0,0,0,,Осы жерден Satchmo арқылы
Dialogue: 0,0:50:32.98,0:50:36.24,Default,,0,0,0,,Біз Пуэрто-Рико астанасы Сан-Хуанға қонамыз.
Dialogue: 0,0:50:36.32,0:50:38.87,Default,,0,0,0,,Бос уақытыңызда көрікті жерлерді тамашалаңыз
Dialogue: 0,0:50:38.95,0:50:40.95,Default,,0,0,0,,Semtech, солай ма?
Dialogue: 0,0:50:41.03,0:50:45.54,Default,,0,0,0,,Гуконың айдаһары болса да, тағы бір бомба жын пайда болды ма?
Dialogue: 0,0:50:45.62,0:50:47.92,Default,,0,0,0,,Семтех – жарылғыш заттың атауы
Dialogue: 0,0:50:48.00,0:50:49.38,Default,,0,0,0,,А...
Dialogue: 0,0:50:49.46,0:50:51.00,Default,,0,0,0,,Хмм
Dialogue: 0,0:50:54.67,0:50:57.55,Default,,0,0,0,,Әдемі, ғажап
Dialogue: 0,0:50:57.63,0:51:01.39,Default,,0,0,0,,Менімен кездессең, кешірім сұра, кешірші деп айт.
Dialogue: 0,0:51:02.22,0:51:04.18,Default,,0,0,0,,А... (Жүгірген аяқ дыбысы)
Dialogue: 0,0:51:04.27,0:51:06.35,Default,,0,0,0,,Мен таптым!
Dialogue: 0,0:51:06.43,0:51:07.77,Default,,0,0,0,,Ирма ханшайымы
Dialogue: 0,0:51:07.85,0:51:12.11,Default,,0,0,0,,Satchmo үшін шақыру порттарын болжауға тұрарлық болды.
Dialogue: 0,0:51:12.19,0:51:13.61,Default,,0,0,0,,Енді үйге қайтайық.
Dialogue: 0,0:51:13.69,0:51:16.28,Default,,0,0,0,,Жоқ! Жібер, жібер!
Dialogue: 0,0:51:16.36,0:51:17.40,Default,,0,0,0,,Ах!
Dialogue: 0,0:51:18.15,0:51:20.70,Default,,0,0,0,,Көмектесіңізші! Бұл Гуконың айдаһары!
Dialogue: 0,0:51:21.57,0:51:22.41,Default,,0,0,0,,Ах... Уф!
Dialogue: 0,0:51:23.12,0:51:24.49,Default,,0,0,0,,(Ринраку) Бұл тек бір теория ғана, бірақ адам еті мен қанын жеудің орнына, Незуко…
Dialogue: 0,0:51:25.75,0:51:26.70,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:51:31.92,0:51:33.00,Default,,0,0,0,,Ха!
Dialogue: 0,0:51:35.80,0:51:37.05,Default,,0,0,0,,Неге?! Неге?!
Dialogue: 0,0:51:38.76,0:51:39.59,Default,,0,0,0,,(Нанами) Болмайды. Мен саған бүгін таңертең неге екенін айттым ғой, иә?
Dialogue: 0,0:51:43.60,0:51:45.26,Default,,0,0,0,,Бар!
Dialogue: 0,0:51:45.35,0:51:47.14,Default,,0,0,0,,Иә! бұрын!
Dialogue: 0,0:51:47.23,0:51:49.14,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:51:51.23,0:51:52.06,Default,,0,0,0,,Ирма ханшайым!
Dialogue: 0,0:51:54.15,0:51:56.53,Default,,0,0,0,,Уф… Ууу…
Dialogue: 0,0:51:59.32,0:52:00.20,Default,,0,0,0,,Хмм...
Dialogue: 0,0:52:00.28,0:52:01.86,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:52:01.95,0:52:03.37,Default,,0,0,0,,Ха! қауіпті!
Dialogue: 0,0:52:03.45,0:52:04.28,Default,,0,0,0,,Хмм!
Dialogue: 0,0:52:05.91,0:52:07.16,Default,,0,0,0,,Уф...
Dialogue: 0,0:52:08.33,0:52:09.54,Default,,0,0,0,,Ей! (2-қызметші) Не...
Dialogue: 0,0:52:11.46,0:52:13.25,Default,,0,0,0,,Енді барайық
Dialogue: 0,0:52:13.33,0:52:14.21,Default,,0,0,0,,Иә
Dialogue: 0,0:52:17.51,0:52:18.92,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:52:39.19,0:52:40.95,Default,,0,0,0,,Қайта уақытында үлгермедің бе?
Dialogue: 0,0:52:41.03,0:52:43.53,Default,,0,0,0,,Ирма ханшайым!
Dialogue: 0,0:52:45.03,0:52:47.24,Default,,0,0,0,,Өтірік айтқаным үшін кешіріңіз.
Dialogue: 0,0:52:47.33,0:52:48.37,Default,,0,0,0,,Жоқ
Dialogue: 0,0:52:48.45,0:52:51.12,Default,,0,0,0,,Мен оның Гуконың айдаһары емес екенін білдім.
Dialogue: 0,0:52:51.21,0:52:53.96,Default,,0,0,0,,Не? Сіз хабардар болдыңыз ба?
Dialogue: 0,0:52:54.04,0:52:58.21,Default,,0,0,0,,Бомба болған кезде кемеде Гуконың айдаһары болған болуы керек.
Dialogue: 0,0:52:58.30,0:53:02.22,Default,,0,0,0,,Бірақ мен оларды кемеде ешқашан көрген емеспін.
Dialogue: 0,0:53:02.30,0:53:03.97,Default,,0,0,0,,Қоңырау портына
Dialogue: 0,0:53:04.05,0:53:06.60,Default,,0,0,0,,Артымнан келеді деп ойламадым.
Dialogue: 0,0:53:08.72,0:53:09.93,Default,,0,0,0,,Қандай жағымсыз!
Dialogue: 0,0:53:10.02,0:53:11.93,Default,,0,0,0,,А... бұл! (Джокер) Иә?
Dialogue: 0,0:53:13.14,0:53:16.61,Default,,0,0,0,,А... А... А...
Dialogue: 0,0:53:16.69,0:53:18.69,Default,,0,0,0,,Егер бұл шын болса, ол өлді.
Dialogue: 0,0:53:19.86,0:53:22.65,Default,,0,0,0,,Инфрақызыл сәулелер сізді өлтірмейді
Dialogue: 0,0:53:22.74,0:53:25.45,Default,,0,0,0,,Егер дабыл өшіп, Детектив Лорд сізді ұстап алса.
Dialogue: 0,0:53:25.53,0:53:28.33,Default,,0,0,0,,Бұл Кайтоның өлімін білдіреді
Dialogue: 0,0:53:28.41,0:53:32.41,Default,,0,0,0,,Күрсін... Мен барып қарап алайын.
Dialogue: 0,0:53:32.50,0:53:36.38,Default,,0,0,0,,(Көрме бөлмесінен естілетін талғампаз музыка)
Dialogue: 0,0:53:36.46,0:53:41.09,Default,,0,0,0,,Күрсін... Мен Анджеликамен танысқым келеді.
Dialogue: 0,0:53:41.17,0:53:44.05,Default,,0,0,0,,бірақ тіпті ең кішкентай үміт сызығын беретін іздерді зерттеп көруім керек шығар.
Dialogue: 0,0:53:49.18,0:53:50.77,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:53:51.68,0:53:56.40,Default,,0,0,0,,(Палубада ағып жатқан джаз)
Dialogue: 0,0:53:58.77,0:54:02.11,Default,,0,0,0,,Мен шынымен... кешегі күн үшін кешірім сұраймын.
Dialogue: 0,0:54:02.74,0:54:05.49,Default,,0,0,0,,Тіпті сен кейде басқаларға бас иесің.
Dialogue: 0,0:54:05.57,0:54:06.95,Default,,0,0,0,,Кеше түнгі үкім дұрыс орындалды.
Dialogue: 0,0:54:07.03,0:54:10.28,Default,,0,0,0,,Мені кім деп ойлайсың?
Dialogue: 0,0:54:10.37,0:54:12.16,Default,,0,0,0,,Батыл ханшайым
Dialogue: 0,0:54:12.24,0:54:13.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:54:13.37,0:54:16.46,Default,,0,0,0,,Елеусіз болу – менің доптарымның кемшілігі.
Dialogue: 0,0:54:16.54,0:54:19.46,Default,,0,0,0,,Міне, сондықтан мен сені пысықсың деймін.
Dialogue: 0,0:54:21.84,0:54:24.42,Default,,0,0,0,,Сіз осылай жақсы болуыңыз керек
Dialogue: 0,0:54:27.26,0:54:28.84,Default,,0,0,0,,Шие газы
Dialogue: 0,0:54:28.93,0:54:30.22,Default,,0,0,0,,Сәлем
Dialogue: 0,0:54:30.30,0:54:33.02,Default,,0,0,0,,Хе-е, не деген қуу!
Dialogue: 0,0:54:33.10,0:54:35.94,Default,,0,0,0,,Көңілді болды, өйткені ол нағыз елес ұры сияқты болды.
Dialogue: 0,0:54:39.94,0:54:42.86,Default,,0,0,0,,Мен елес ұры болғым келмейді.
Dialogue: 0,0:54:42.94,0:54:43.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:54:44.36,0:54:46.82,Default,,0,0,0,,Мен туған күнімді білмеймін
Dialogue: 0,0:54:46.90,0:54:51.66,Default,,0,0,0,,Білмейтіндігім емес, маған үйрететін ешкімнің болмағаны.
Dialogue: 0,0:54:52.58,0:54:56.41,Default,,0,0,0,,Патшайым бізге Джокер есімін берді.
Dialogue: 0,0:54:56.50,0:55:00.29,Default,,0,0,0,,Патшайым маған атымды, тамағымды, киімімді берді,
Dialogue: 0,0:55:00.38,0:55:03.88,Default,,0,0,0,,Ол маған фантом ұрының серіктесі болу жұмысын берді.
Dialogue: 0,0:55:04.92,0:55:09.34,Default,,0,0,0,,Егер біреу маған «төбелес» деп айтпаса
Dialogue: 0,0:55:09.43,0:55:13.31,Default,,0,0,0,,Мен мүлде басқа өмір сүрер едім.
Dialogue: 0,0:55:19.90,0:55:24.28,Default,,0,0,0,,Менің өмірім мен дүниеге келген сәттен бастап шешілді.
Dialogue: 0,0:55:25.03,0:55:28.95,Default,,0,0,0,,Мен ханшайым болғым келіп туылған жоқпын.
Dialogue: 0,0:55:29.03,0:55:31.53,Default,,0,0,0,,Бірақ мен туылғаннан бері
Dialogue: 0,0:55:31.62,0:55:34.62,Default,,0,0,0,,Ол Гуко патшалығының тақ мұрагері болды.
Dialogue: 0,0:55:35.66,0:55:37.25,Default,,0,0,0,,Сонымен, мен
Dialogue: 0,0:55:37.33,0:55:40.67,Default,,0,0,0,,Мен «басқа мен бар» деп ойлауды шештім.
Dialogue: 0,0:55:40.75,0:55:43.04,Default,,0,0,0,,Басқа мен бе?
Dialogue: 0,0:55:43.13,0:55:44.09,Default,,0,0,0,,Иә
Dialogue: 0,0:55:44.17,0:55:48.30,Default,,0,0,0,,Сіз елес ұры ретінде әлем бойынша ұшып жүрсіз бе?
Dialogue: 0,0:55:49.18,0:55:52.64,Default,,0,0,0,,Еркін өмір сүру, басқа мен
Dialogue: 0,0:55:57.27,0:56:00.77,Default,,0,0,0,,Мен өз өмірімді таңдай алмадым.
Dialogue: 0,0:56:00.85,0:56:05.23,Default,,0,0,0,,Менің қазір бұлай болуымның себебі, мен оны өз қолыммен ұстадым.
Dialogue: 0,0:56:05.32,0:56:06.98,Default,,0,0,0,,Сіз де жасай аласыз
Dialogue: 0,0:56:07.07,0:56:10.78,Default,,0,0,0,,Бір күні мен Кайтоның серіктесі боламын.
Dialogue: 0,0:56:10.86,0:56:12.49,Default,,0,0,0,,Хехе
Dialogue: 0,0:56:12.57,0:56:15.99,Default,,0,0,0,,Күлімсіреп қазіргідей жолдарды айтқым келеді.
Dialogue: 0,0:56:17.16,0:56:18.04,Default,,0,0,0,,Ах!
Dialogue: 0,0:56:18.95,0:56:20.96,Default,,0,0,0,,Сіз не істеп жатырсыз? дөрекі адам
Dialogue: 0,0:56:21.04,0:56:22.71,Default,,0,0,0,,Тұрмаңыз
Dialogue: 0,0:56:31.13,0:56:33.47,Default,,0,0,0,,Сіз мылтық даусын естіген жоқсыз, солай ма?
Dialogue: 0,0:56:33.55,0:56:34.47,Default,,0,0,0,,Иә
Dialogue: 0,0:56:34.55,0:56:39.18,Default,,0,0,0,,Куәгерлер жоқ сияқты, оқ еш жерде жоқ.
Dialogue: 0,0:56:39.27,0:56:42.65,Default,,0,0,0,,Оққа ұшқаныңыз тек сіздің қиялыңыз емес пе?
Dialogue: 0,0:56:42.73,0:56:43.60,Default,,0,0,0,,Ммм
Dialogue: 0,0:56:43.69,0:56:45.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:56:45.27,0:56:46.73,Default,,0,0,0,,Хмм...
Dialogue: 0,0:56:46.82,0:56:49.19,Default,,0,0,0,,Ол шынымен де атылды!
Dialogue: 0,0:56:49.28,0:56:51.15,Default,,0,0,0,,Бұл дәлел
Dialogue: 0,0:56:51.24,0:56:52.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:56:54.45,0:56:56.91,Default,,0,0,0,,Мұны кім жасай алады?
Dialogue: 0,0:56:56.99,0:56:58.91,Default,,0,0,0,,Ой, қарашы, бұл не?
Dialogue: 0,0:56:58.99,0:57:00.83,Default,,0,0,0,,Ах! Мен есімде жоқ
Dialogue: 0,0:57:01.46,0:57:04.33,Default,,0,0,0,,Ұрысқан адамның ұмытып кеткеніне сене алар емеспін
Dialogue: 0,0:57:04.42,0:57:06.96,Default,,0,0,0,,Жауларыңызды құрметтеңіз
Dialogue: 0,0:57:08.05,0:57:11.09,Default,,0,0,0,,Бұл адам бұрынғы бармен.
Dialogue: 0,0:57:11.59,0:57:13.09,Default,,0,0,0,,Күмән жоқ
Dialogue: 0,0:57:13.68,0:57:15.47,Default,,0,0,0,,Оның аты Краса
Dialogue: 0,0:57:15.55,0:57:19.56,Default,,0,0,0,,Ол әлемдік деңгейдегі байқауда жеңіске жеткен бірінші дәрежелі бармен.
Dialogue: 0,0:57:19.64,0:57:20.85,Default,,0,0,0,,Ассасин
Dialogue: 0,0:57:20.93,0:57:21.89,Default,,0,0,0,,Басқа атау
Dialogue: 0,0:57:21.98,0:57:24.60,Default,,0,0,0,,Тығыздағыш Кураса
Dialogue: 0,0:57:24.69,0:57:26.69,Default,,0,0,0,,Қару - Ньой моншақтары.
Dialogue: 0,0:57:26.77,0:57:28.40,Default,,0,0,0,,Нёши?
Dialogue: 0,0:57:28.48,0:57:31.61,Default,,0,0,0,,Саусақпен қиыршық тастарды немесе темір түйірлерін қағып түсіретін қара аспап.
Dialogue: 0,0:57:31.69,0:57:33.57,Default,,0,0,0,,Бұл жасырын қарудың бір түрі.
Dialogue: 0,0:57:33.65,0:57:35.53,Default,,0,0,0,,Балғаны тапанша сияқты көтер
Dialogue: 0,0:57:35.61,0:57:37.45,Default,,0,0,0,,Триггерді тартудың қажеті жоқ
Dialogue: 0,0:57:37.53,0:57:40.54,Default,,0,0,0,,Сіз жауды байқамай-ақ жеңе аласыз.
Dialogue: 0,0:57:40.62,0:57:45.00,Default,,0,0,0,,Сонымен, егер Джокер мырза болмаса, мен...
Dialogue: 0,0:57:45.08,0:57:46.75,Default,,0,0,0,,Хмм
Dialogue: 0,0:57:46.83,0:57:50.09,Default,,0,0,0,,Ханшайым Екіншісі есіңізде ме?
Dialogue: 0,0:57:50.17,0:57:54.84,Default,,0,0,0,,Бұл Хизай ма? Ұмытқым келсе де ұмыта алмаймын
Dialogue: 0,0:57:55.59,0:57:59.22,Default,,0,0,0,,Хизай ол кезде Чуроудың басшысы болды.
Dialogue: 0,0:57:59.31,0:58:03.35,Default,,0,0,0,,10 жыл бұрын Хи-цай небәрі 18 жаста болса керек.
Dialogue: 0,0:58:03.93,0:58:06.27,Default,,0,0,0,,(металлдың өткір соғу дыбысы)
Dialogue: 0,0:58:09.65,0:58:11.94,Default,,0,0,0,,Міне, күш.
Dialogue: 0,0:58:12.03,0:58:15.40,Default,,0,0,0,,Шынымды айтсам, бұл мен шынымен күрескім келмейтін адам.
Dialogue: 0,0:58:15.49,0:58:18.49,Default,,0,0,0,,Екі адам болса, біз оны жеңе аламыз. Барайық.
Dialogue: 0,0:58:18.57,0:58:20.58,Default,,0,0,0,,Сол жарамен?
Dialogue: 0,0:58:21.99,0:58:23.83,Default,,0,0,0,,Бұл үлкен мәселе емес.
Dialogue: 0,0:58:23.91,0:58:24.75,Default,,0,0,0,,Уф!
Dialogue: 0,0:58:24.83,0:58:27.42,Default,,0,0,0,,Бұл үлкен мәселе сияқты.
Dialogue: 0,0:58:28.04,0:58:30.00,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:58:30.09,0:58:33.55,Default,,0,0,0,,Маған Краса телефон соғып тұрған сияқты.
Dialogue: 0,0:58:33.63,0:58:34.97,Default,,0,0,0,,Не болды? Пластырь жапсыруым керек болар.
Dialogue: 0,0:58:35.05,0:58:36.05,Default,,0,0,0,,Мен де барамын
Dialogue: 0,0:58:36.18,0:58:40.18,Default,,0,0,0,,Сіз Ирма ханшайымын қорғауыңыз керек.
Dialogue: 0,0:58:41.39,0:58:45.02,Default,,0,0,0,,Сондай-ақ Хизай менің жауым.
Dialogue: 0,0:58:45.10,0:58:47.35,Default,,0,0,0,,Маған тиіспе
Dialogue: 0,0:58:56.24,0:58:57.61,Default,,0,0,0,,(Жақындап келе жатқан аяқ дыбысы)
Dialogue: 0,0:58:58.78,0:59:00.07,Default,,0,0,0,,Қайырлы кеш
Dialogue: 0,0:59:00.16,0:59:03.70,Default,,0,0,0,,Кешіріңіз, біз жабылып қалдық.
Dialogue: 0,0:59:04.54,0:59:08.17,Default,,0,0,0,,Маған бір стақан Château Latour ішуге бола ма?
Dialogue: 0,0:59:08.75,0:59:09.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:59:11.00,0:59:12.42,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:59:12.50,0:59:16.42,Default,,0,0,0,,Оқ табылмаған снайпер оқиғасы болған сияқты.
Dialogue: 0,0:59:17.51,0:59:21.47,Default,,0,0,0,,Сіз білесіз бе? Тығыздағыш Кураса
Dialogue: 0,0:59:22.93,0:59:24.43,Default,,0,0,0,,Әй!
Dialogue: 0,0:59:25.02,0:59:25.85,Default,,0,0,0,,Әй!
Dialogue: 0,0:59:33.02,0:59:34.40,Default,,0,0,0,,А...
Dialogue: 0,0:59:34.48,0:59:36.99,Default,,0,0,0,,Қанша тырыссаң да пайдасы жоқ.
Dialogue: 0,0:59:37.07,0:59:38.45,Default,,0,0,0,,Әй!
Dialogue: 0,0:59:42.03,0:59:43.41,Default,,0,0,0,,Ха!
Dialogue: 0,0:59:43.49,0:59:46.70,Default,,0,0,0,,Сенің жылдамдығың мені жеңе алмайды.
Dialogue: 0,0:59:46.79,0:59:48.00,Default,,0,0,0,,А...
Dialogue: 0,0:59:48.08,0:59:51.96,Default,,0,0,0,,Мен сенің Nyoi моншақтарыңның орнында тұрғанын көріп тұрмын.
Dialogue: 0,0:59:55.00,0:59:58.05,Default,,0,0,0,,Бұл менің шығыным, патшайым.
Dialogue: 0,0:59:59.30,1:00:02.01,Default,,0,0,0,,Бізбен шайқасқа қатысқаныңыз үшін рахмет
Dialogue: 0,1:00:02.09,1:00:04.01,Default,,0,0,0,,Маған сусын алуға рұқсат етіңіз.
Dialogue: 0,1:00:06.31,1:00:08.64,Default,,0,0,0,,Тығыздағыш Краса
Dialogue: 0,1:00:10.69,1:00:13.86,Default,,0,0,0,,Қарсы болмасаңыз, мен мұздың оқтарын көре аламын ба?
Dialogue: 0,1:00:21.74,1:00:23.37,Default,,0,0,0,,Ммм
Dialogue: 0,1:00:35.71,1:00:37.84,Default,,0,0,0,,Бұл толқын ба?
Dialogue: 0,1:00:41.09,1:00:43.22,Default,,0,0,0,,Корольдік Сатчмоның саяхаты
Dialogue: 0,1:00:43.30,1:00:46.31,Default,,0,0,0,,Бар болғаны екі күн қалды.
Dialogue: 0,1:00:46.39,1:00:48.43,Default,,0,0,0,,Бүгін маскарад күні
Dialogue: 0,1:00:48.52,1:00:52.27,Default,,0,0,0,,Өзіңіздің сүйікті костюміңізді киіп, көңілді болыңыз!
Dialogue: 0,1:00:52.35,1:00:55.73,Default,,0,0,0,,Ақырында Чама да, Хизай да табылмады.
Dialogue: 0,1:00:55.81,1:00:59.61,Default,,0,0,0,,Содан бері де Гуконың айдаһарынан ештеңе естіген жоқпыз.
Dialogue: 0,1:00:59.69,1:01:01.57,Default,,0,0,0,,Ах!
Dialogue: 0,1:01:03.32,1:01:06.12,Default,,0,0,0,,Бұл кит! Е, қайда?
Dialogue: 0,1:01:08.79,1:01:11.41,Default,,0,0,0,,Түсіндім, теңіз алыбы?
Dialogue: 0,1:01:11.50,1:01:12.58,Default,,0,0,0,,Ирма ханшайымы ше?
Dialogue: 0,1:01:13.37,1:01:15.83,Default,,0,0,0,,Аа, көп рахмет.
Dialogue: 0,1:01:16.46,1:01:19.55,Default,,0,0,0,,Қош келдіңіз, Ирма ханшайым.
Dialogue: 0,1:01:19.63,1:01:21.67,Default,,0,0,0,,Сатчмо мырза
Dialogue: 0,1:01:21.76,1:01:25.18,Default,,0,0,0,,Кеш сәлемдескенім үшін кешіріңіз.
Dialogue: 0,1:01:25.26,1:01:26.35,Default,,0,0,0,,Круиздік кеме саяхаты
Dialogue: 0,1:01:26.43,1:01:29.64,Default,,0,0,0,,Сізге ұнағанына қуаныштымын.
Dialogue: 0,1:01:30.52,1:01:32.10,Default,,0,0,0,,Сізге не керек?
Dialogue: 0,1:01:32.18,1:01:36.61,Default,,0,0,0,,Императорлық Сапфирді барлығы өте жақсы қабылдады.
Dialogue: 0,1:01:36.69,1:01:40.11,Default,,0,0,0,,Маған бергеніңіз үшін көп рахмет.
Dialogue: 0,1:01:40.19,1:01:41.99,Default,,0,0,0,,Әулие Орлов сапфирі
Dialogue: 0,1:01:42.07,1:01:44.32,Default,,0,0,0,,Бұл әлі сенікі емес.
Dialogue: 0,1:01:44.41,1:01:47.41,Default,,0,0,0,,Мен оны міндетті түрде қайтарамын.
Dialogue: 0,1:01:47.49,1:01:51.33,Default,,0,0,0,,Мені біртүрлі сезінбеуіңізді өтінемін.
Dialogue: 0,1:01:52.16,1:01:55.12,Default,,0,0,0,,Біздің қарым-қатынасымыз не болады?
Dialogue: 0,1:01:55.21,1:01:59.21,Default,,0,0,0,,Келесі патшайым ретінде сіз түсінесіз, солай ма?
Dialogue: 0,1:02:00.84,1:02:03.09,Default,,0,0,0,,Фуфуфуфуфу…
Dialogue: 0,1:02:12.18,1:02:14.56,Default,,0,0,0,,(Жолаушылар қолдайды)
Dialogue: 0,1:02:14.64,1:02:18.90,Default,,0,0,0,,Керемет! үлкен! Бұл өте әсерлі
Dialogue: 0,1:02:18.98,1:02:21.19,Default,,0,0,0,,Мен Ирма ханшайымын іздеймін.
Dialogue: 0,1:02:21.28,1:02:23.78,Default,,0,0,0,,Мен осында күтемін.
Dialogue: 0,1:02:24.95,1:02:26.70,Default,,0,0,0,,Мейми-кун
Dialogue: 0,1:02:26.78,1:02:32.20,Default,,0,0,0,,Мен осы сапардан кейін зейнетке шығуды жоспарлап отырмын.
Dialogue: 0,1:02:32.29,1:02:33.16,Default,,0,0,0,,Иә?
Dialogue: 0,1:02:33.25,1:02:37.17,Default,,0,0,0,,Бір сөзбен айтқанда, бұл махаббат.
Dialogue: 0,1:02:37.25,1:02:38.75,Default,,0,0,0,,Иә?
Dialogue: 0,1:02:38.83,1:02:40.79,Default,,0,0,0,,Енді сіздің сүйікті адамыңыз бар
Dialogue: 0,1:02:40.88,1:02:45.67,Default,,0,0,0,,Мен қауіпті детектив болуды жалғастыра алмаймын.
Dialogue: 0,1:02:46.43,1:02:49.01,Default,,0,0,0,,Енді жұмыс істеу оңайырақ
Dialogue: 0,1:02:49.09,1:02:51.85,Default,,0,0,0,,Хонки-тонктың өз шегі бар.
Dialogue: 0,1:02:53.64,1:02:54.81,Default,,0,0,0,,Ирма ханшайымы
Dialogue: 0,1:02:55.60,1:02:56.52,Default,,0,0,0,,Иә?
Dialogue: 0,1:02:56.60,1:02:59.86,Default,,0,0,0,,Кешіріңіз, бұл дұрыс емес адам болды.
Dialogue: 0,1:03:11.33,1:03:12.83,Default,,0,0,0,,Ирма ханшайым!
Dialogue: 0,1:03:14.91,1:03:17.16,Default,,0,0,0,,Мен уайымдадым, өйткені біз ажырасып кеттік.
Dialogue: 0,1:03:17.75,1:03:20.25,Default,,0,0,0,,Бұл... аяқталады.
Dialogue: 0,1:03:20.33,1:03:21.46,Default,,0,0,0,,Иә?
Dialogue: 0,1:03:22.75,1:03:26.05,Default,,0,0,0,,Ирма ханшайым Сіз мені түсінесіз бе?
Dialogue: 0,1:03:28.34,1:03:30.22,Default,,0,0,0,,еркін
Dialogue: 0,1:03:30.30,1:03:31.72,Default,,0,0,0,,Айналады
Dialogue: 0,1:03:32.43,1:03:34.01,Default,,0,0,0,,Уақытты бомба?
Dialogue: 0,1:03:34.10,1:03:36.35,Default,,0,0,0,,Иә, Ирма ханшайымның денесінде
Dialogue: 0,1:03:36.43,1:03:39.56,Default,,0,0,0,,Ол пластикалық бомбамен жабдықталған.
Dialogue: 0,1:03:39.65,1:03:43.32,Default,,0,0,0,,Мен жолаушылардың эвакуациялануын қалаймын.
Dialogue: 0,1:03:43.40,1:03:45.03,Default,,0,0,0,,Джокердің хабарламасы
Dialogue: 0,1:03:45.11,1:03:47.36,Default,,0,0,0,,Жеңілдік мерзімі қанша?
Dialogue: 0,1:03:47.44,1:03:49.20,Default,,0,0,0,,Жарылғыш заттардың мөлшеріне байланысты
Dialogue: 0,1:03:49.28,1:03:52.28,Default,,0,0,0,,Жарылыс корпусты тесіп кеткен болуы мүмкін.
Dialogue: 0,1:03:52.37,1:03:54.37,Default,,0,0,0,,Мен ол кемені суға батырмақшы деп ойладым.
Dialogue: 0,1:03:54.99,1:03:56.50,Default,,0,0,0,,Satchmo өлшемі
Dialogue: 0,1:03:56.58,1:04:00.21,Default,,0,0,0,,Толық суға бату үшін шамамен бір сағат қажет болады деп есептелді.
Dialogue: 0,1:04:00.29,1:04:03.59,Default,,0,0,0,,1 сағат? РД рахмет
Dialogue: 0,1:04:03.67,1:04:05.34,Default,,0,0,0,,Жолаушыларды эвакуациялау…
Dialogue: 0,1:04:07.92,1:04:10.34,Default,,0,0,0,,Сиқырлы дауыс) Мен киттерді көргім келді...
Dialogue: 0,1:04:10.43,1:04:13.30,Default,,0,0,0,,Мен жақсы нәрсе ойладым.
Dialogue: 0,1:04:13.89,1:04:16.27,Default,,0,0,0,,Сіз Гуконың айдаһары болдыңыз, солай ма?
Dialogue: 0,1:04:16.93,1:04:18.73,Default,,0,0,0,,Мен айдаһармын
Dialogue: 0,1:04:18.81,1:04:21.98,Default,,0,0,0,,Мен өз өмірімді шешемін
Dialogue: 0,1:04:22.06,1:04:23.77,Default,,0,0,0,,Ирма өлсін
Dialogue: 0,1:04:23.86,1:04:27.23,Default,,0,0,0,,Сіз мұны істегіңіз келді ме?
Dialogue: 0,1:04:27.82,1:04:28.74,Default,,0,0,0,,Жібер!
Dialogue: 0,1:04:29.57,1:04:32.24,Default,,0,0,0,,Сен Сент-Орлов Сапфирін қайтарып алмақсың, солай ма?
Dialogue: 0,1:04:32.86,1:04:36.58,Default,,0,0,0,,Сіз елес ұрыға айналып, дүниені шарлайсыз, солай ма?
Dialogue: 0,1:04:36.66,1:04:38.08,Default,,0,0,0,,Есте сақтаңыз
Dialogue: 0,1:04:38.16,1:04:39.96,Default,,0,0,0,,Жоқ, есімде!
Dialogue: 0,1:04:40.62,1:04:42.17,Default,,0,0,0,,Ирма!
Dialogue: 0,1:04:42.25,1:04:45.21,Default,,0,0,0,,Хехехе Ирма ма?
Dialogue: 0,1:04:45.29,1:04:48.01,Default,,0,0,0,,Мені кім деп ойлайсың?
Dialogue: 0,1:04:48.09,1:04:49.05,Default,,0,0,0,,Сізді менсінбейтін адам!
Dialogue: 0,1:04:49.13,1:04:50.67,Default,,0,0,0,,(шапалақ дыбысы)
Dialogue: 0,1:04:54.47,1:04:57.18,Default,,0,0,0,,Менен қолдарыңды ұстаңдар! Дөрекі адам!
Dialogue: 0,1:05:00.02,1:05:00.93,Default,,0,0,0,,Дөрекі!
Dialogue: 0,1:05:03.73,1:05:07.82,Default,,0,0,0,,Дөрекі! Дөрекі адам Дөрекі адам Дөрекі адам!
Dialogue: 0,1:05:11.40,1:05:14.28,Default,,0,0,0,,Мм... мен...
Dialogue: 0,1:05:15.82,1:05:17.49,Default,,0,0,0,,Сіз қайтып келдіңіз.
Dialogue: 0,1:05:18.08,1:05:20.00,Default,,0,0,0,,Бұл да мен бе?
Dialogue: 0,1:05:20.08,1:05:21.41,Default,,0,0,0,,Иә
Dialogue: 0,1:05:21.50,1:05:24.71,Default,,0,0,0,,Мен Гуконың айдаһары болдым, солай ма?
Dialogue: 0,1:05:26.25,1:05:30.51,Default,,0,0,0,,Мен бұл туралы біраз уақыттан бері ойлап жүрмін.
Dialogue: 0,1:05:30.59,1:05:33.51,Default,,0,0,0,,Кейде есте сақтау қабілетім жоғалады.
Dialogue: 0,1:05:33.59,1:05:36.60,Default,,0,0,0,,Білмей тұрып, мүлде танымайтын жерде болдым.
Dialogue: 0,1:05:37.14,1:05:40.56,Default,,0,0,0,,Менің Гуконың айдаһары екенімді қашан түсіндің?
Dialogue: 0,1:05:40.64,1:05:42.02,Default,,0,0,0,,Дәл қазір
Dialogue: 0,1:05:42.10,1:05:45.90,Default,,0,0,0,,Бірақ патшайым басынан бастап күдіктенсе керек.
Dialogue: 0,1:05:46.48,1:05:49.73,Default,,0,0,0,,Сондықтан мен саған мені қорғауды бұйырдым.
Dialogue: 0,1:05:50.28,1:05:53.99,Default,,0,0,0,,Сонымен бірге мен Гуконың айдаһарын бақылайтын боламын.
Dialogue: 0,1:05:54.07,1:05:55.91,Default,,0,0,0,,Сіз оны жек көресіз.
Dialogue: 0,1:05:55.99,1:05:58.78,Default,,0,0,0,,Өз өміріне мақсат қою
Dialogue: 0,1:05:58.87,1:06:02.95,Default,,0,0,0,,Бомба қойып, көп адамды алып кетуге тырысу
Dialogue: 0,1:06:03.54,1:06:07.25,Default,,0,0,0,,Бірақ білесің бе, Гуконың айдаһары да сенсің.
Dialogue: 0,1:06:07.33,1:06:09.63,Default,,0,0,0,,Өз өміріңізді өзіңіз шешіңіз
Dialogue: 0,1:06:09.71,1:06:12.01,Default,,0,0,0,,Тәкаппар айдаһар осылай ойлайды.
Dialogue: 0,1:06:12.09,1:06:15.80,Default,,0,0,0,,Бұл сөзсіз сізбен бірдей.
Dialogue: 0,1:06:15.88,1:06:19.76,Default,,0,0,0,,Гуконың айдаһары да менмін
Dialogue: 0,1:06:19.85,1:06:21.85,Default,,0,0,0,,Сонда ше?
Dialogue: 0,1:06:22.52,1:06:27.23,Default,,0,0,0,,Гуконың айдаһары қалағандай сағаттық бомбаны жаруды жалғастырғыңыз келе ме?
Dialogue: 0,1:06:27.31,1:06:28.81,Default,,0,0,0,,Әлде…
Dialogue: 0,1:06:28.90,1:06:30.69,Default,,0,0,0,,Бомбаны залалсыздандыру
Dialogue: 0,1:06:30.77,1:06:34.40,Default,,0,0,0,,Бұл ханшайым болуды таңдау.
Dialogue: 0,1:06:34.49,1:06:38.41,Default,,0,0,0,,Мен Гуко патшалығының тағының бірінші мұрагерімін.
Dialogue: 0,1:06:38.49,1:06:40.74,Default,,0,0,0,,Ирма Креме де Орлов
Dialogue: 0,1:06:40.83,1:06:43.87,Default,,0,0,0,,Жолаушыларды құтқару – біздің басты міндетіміз
Dialogue: 0,1:06:44.45,1:06:47.00,Default,,0,0,0,,Қалауыңызша
Dialogue: 0,1:06:47.08,1:06:49.58,Default,,0,0,0,,Мәртебелі
Dialogue: 0,1:06:50.84,1:06:53.09,Default,,0,0,0,,Бәріңе сәлем
Dialogue: 0,1:06:53.17,1:06:55.59,Default,,0,0,0,,(монитордан құмар музыка ойнайды)
Dialogue: 0,1:06:55.67,1:06:58.05,Default,,0,0,0,,Менің атым ханшайым
Dialogue: 0,1:06:58.14,1:07:00.30,Default,,0,0,0,,Елес ұры болып күн көретін адам.
Dialogue: 0,1:07:00.39,1:07:01.85,Default,,0,0,0,,Бұл патшайым!?
Dialogue: 0,1:07:01.93,1:07:03.31,Default,,0,0,0,,Бұл шын ба?
Dialogue: 0,1:07:03.39,1:07:07.77,Default,,0,0,0,,Енді жоғарғы қабаттағы сыртқы палубаға жиналыңыз.
Dialogue: 0,1:07:07.85,1:07:11.69,Default,,0,0,0,,Біздің тамаша тосын сыйымызды көріңіз!
Dialogue: 0,1:07:13.11,1:07:15.69,Default,,0,0,0,,Патшайым пайда болған кезде, оны ұстаңыз!
Dialogue: 0,1:07:15.78,1:07:19.91,Default,,0,0,0,,Барлығыңыз, доктор Сиқырға назар аударыңыз!
Dialogue: 0,1:07:20.74,1:07:26.25,Default,,0,0,0,,Мен доктор Мэжикпін, ғасырдың ең жақсы иллюзионисімін.
Dialogue: 0,1:07:27.12,1:07:31.33,Default,,0,0,0,,Бәріміз нағыз айдаһарды көрейік
Dialogue: 0,1:07:31.42,1:07:33.30,Default,,0,0,0,,Оның орнына патшайымды шығарыңыз!
Dialogue: 0,1:07:33.38,1:07:34.80,Default,,0,0,0,,Ханшайым қайда?
Dialogue: 0,1:07:34.88,1:07:36.47,Default,,0,0,0,,Хмм
Dialogue: 0,1:07:36.55,1:07:38.38,Default,,0,0,0,,Хмм! Иә!
Dialogue: 0,1:07:38.47,1:07:39.72,Default,,0,0,0,,Полуппо!
Dialogue: 0,1:07:42.76,1:07:44.18,Default,,0,0,0,,Полуппо!
Dialogue: 0,1:07:46.22,1:07:48.60,Default,,0,0,0,,Не!? Сол бұлт
Dialogue: 0,1:07:50.73,1:07:53.06,Default,,0,0,0,,Сіз байсалдысыз ба!? Керемет! Бұл айдаһар!
Dialogue: 0,1:07:53.15,1:07:57.15,Default,,0,0,0,,Жасанды түрде жасалған бұлт қалай айдаһарға айналуы мүмкін?
Dialogue: 0,1:07:57.74,1:08:00.41,Default,,0,0,0,,Сіз не істеуді жоспарлап отырсыз!?
Dialogue: 0,1:08:01.45,1:08:04.03,Default,,0,0,0,,Хмф, ебедейсіз жал.
Dialogue: 0,1:08:04.12,1:08:06.33,Default,,0,0,0,,Патшайым осы жерде болуы керек.
Dialogue: 0,1:08:06.41,1:08:07.91,Default,,0,0,0,,Оны табыңыз!
Dialogue: 0,1:08:08.00,1:08:10.87,Default,,0,0,0,,Жылжыды! Бұл шынайы! Бұл нағыз айдаһар!
Dialogue: 0,1:08:10.96,1:08:13.21,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,1:08:13.29,1:08:17.67,Default,,0,0,0,,Сатчмо Мен сізге дос ретінде кеңес беремін.
Dialogue: 0,1:08:17.76,1:08:19.13,Default,,0,0,0,,Тс!
Dialogue: 0,1:08:19.88,1:08:25.26,Default,,0,0,0,,Айдаһарлар дем алған күшті жалын өзін өртеп жіберуі мүмкін.
Dialogue: 0,1:08:25.35,1:08:27.18,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,1:08:27.27,1:08:29.48,Default,,0,0,0,,(Айдаһардың айқайы мен жолаушылардың айқайы)
Dialogue: 0,1:08:29.56,1:08:30.56,Default,,0,0,0,,Уф
Dialogue: 0,1:08:31.90,1:08:32.73,Default,,0,0,0,,Хамф!
Dialogue: 0,1:08:32.81,1:08:34.44,Default,,0,0,0,,(бірнеше оқ ату)
Dialogue: 0,1:08:34.52,1:08:36.40,Default,,0,0,0,,Ой! Ах...
Dialogue: 0,1:08:39.82,1:08:40.70,Default,,0,0,0,,О
Dialogue: 0,1:08:40.78,1:08:43.41,Default,,0,0,0,,Мұны тек патшайым жасай алады.
Dialogue: 0,1:08:43.49,1:08:46.37,Default,,0,0,0,,Доктор Сиқыр патшайым болуы мүмкін.
Dialogue: 0,1:08:46.45,1:08:47.41,Default,,0,0,0,,Иә!?
Dialogue: 0,1:08:47.49,1:08:51.00,Default,,0,0,0,,Патшайым бетперде жасаудың шебері.
Dialogue: 0,1:08:51.08,1:08:55.84,Default,,0,0,0,,Сұрағандай мен антирадар бұлтын айдаһарға айналдырдым.
Dialogue: 0,1:08:55.92,1:08:58.38,Default,,0,0,0,,Трубадурдан соққы толқынын шығарыңыз
Dialogue: 0,1:08:58.46,1:09:01.47,Default,,0,0,0,,Мен атмосфераны дірілдеп, оны қозғалтуға тырыстым.
Dialogue: 0,1:09:01.55,1:09:03.13,Default,,0,0,0,,Керемет табыс!
Dialogue: 0,1:09:03.22,1:09:06.56,Default,,0,0,0,,Бірдеңе болса, аузымнан жалын сияқты бірдеңе шыққанын қаладым.
Dialogue: 0,1:09:06.64,1:09:09.31,Default,,0,0,0,,Әйтеуір, ойланып қалдым.
Dialogue: 0,1:09:09.39,1:09:12.89,Default,,0,0,0,,Жолаушыларға бағыт-бағдар беру үшін алдамшы ретінде әрекет ету?
Dialogue: 0,1:09:12.98,1:09:15.86,Default,,0,0,0,,Барлығы эвакуацияланды ма?
Dialogue: 0,1:09:20.15,1:09:21.40,Default,,0,0,0,,Иә?
Dialogue: 0,1:09:21.49,1:09:22.53,Default,,0,0,0,,Ха!
Dialogue: 0,1:09:23.82,1:09:26.24,Default,,0,0,0,,Иә? Бұл қайда?
Dialogue: 0,1:09:31.75,1:09:32.91,Default,,0,0,0,,Иә?
Dialogue: 0,1:09:35.42,1:09:37.84,Default,,0,0,0,,А, бұл сым.
Dialogue: 0,1:09:38.92,1:09:43.47,Default,,0,0,0,,Ақырында біз кездестік, Анджелика ханым.
Dialogue: 0,1:09:43.55,1:09:46.55,Default,,0,0,0,,Фантомдық ұры ханшайымы жоқ
Dialogue: 0,1:09:46.64,1:09:48.47,Default,,0,0,0,,Уф...
Dialogue: 0,1:09:51.52,1:09:55.15,Default,,0,0,0,,Детонаторды қорғау құралын шешкеннен кейін жарғышты алыңыз.
Dialogue: 0,1:10:00.03,1:10:04.57,Default,,0,0,0,,Үш детонатор Босату кодын қате енгізсеңіз
Dialogue: 0,1:10:04.65,1:10:08.53,Default,,0,0,0,,Джокер мырза, жеткілікті, қазір қашыңыз.
Dialogue: 0,1:10:09.16,1:10:13.16,Default,,0,0,0,,Мен сені тастап қашатын адаммын деп ойлайсың ба?
Dialogue: 0,1:10:13.25,1:10:17.42,Default,,0,0,0,,Бастапқыда тағдырымнан қашқандықтан болды.
Dialogue: 0,1:10:17.50,1:10:21.00,Default,,0,0,0,,Мен бұл үшін жауаптымын.
Dialogue: 0,1:10:21.09,1:10:24.63,Default,,0,0,0,,Ирма ханшайымын қорғау менің міндетім.
Dialogue: 0,1:10:24.72,1:10:26.26,Default,,0,0,0,,Мен сені жалғыз қалдырмаймын.
Dialogue: 0,1:10:26.34,1:10:27.59,Default,,0,0,0,,Маған ұнамайды.
Dialogue: 0,1:10:27.68,1:10:31.56,Default,,0,0,0,,Мен жасаған бомба сенің өміріңді алады!
Dialogue: 0,1:10:32.85,1:10:34.85,Default,,0,0,0,,Джокер мырза
Dialogue: 0,1:10:34.94,1:10:38.77,Default,,0,0,0,,Сіздің бейсаналық санаңыз Гуконың айдаһарымен байланысты.
Dialogue: 0,1:10:38.86,1:10:40.65,Default,,0,0,0,,Маған сеніңіз
Dialogue: 0,1:10:41.82,1:10:47.07,Default,,0,0,0,,Егер сіз шынымен өз тағдырыңызды ойып, өмір сүргіңіз келсе
Dialogue: 0,1:10:47.16,1:10:50.33,Default,,0,0,0,,Құлыптан босату кодын енгізуге болады
Dialogue: 0,1:10:53.75,1:10:57.21,Default,,0,0,0,,Мен Ирма Гуконың айдаһары емеспін
Dialogue: 0,1:10:57.29,1:10:59.71,Default,,0,0,0,,Мен айдаһар емес, Ирмамын.
Dialogue: 0,1:10:59.79,1:11:03.17,Default,,0,0,0,,Ұлым менің өмірдегі жалғыз мақсатым болды.
Dialogue: 0,1:11:03.25,1:11:04.46,Default,,0,0,0,,Ұлым?
Dialogue: 0,1:11:04.55,1:11:08.39,Default,,0,0,0,,Хиконы шіркеудің алдына тастап кеткенін естідім.
Dialogue: 0,1:11:10.22,1:11:12.72,Default,,0,0,0,,Мен әпке кезімде жинадым.
Dialogue: 0,1:11:12.81,1:11:15.73,Default,,0,0,0,,Мен сені өлтіруші етіп өсірдім.
Dialogue: 0,1:11:15.81,1:11:18.27,Default,,0,0,0,,Өйткені қала осындай еді.
Dialogue: 0,1:11:18.77,1:11:20.69,Default,,0,0,0,,Мүмкін Хико...
Dialogue: 0,1:11:20.77,1:11:24.36,Default,,0,0,0,,Мен сегіз жыл бұрын жол апатынан қайтыс болдым.
Dialogue: 0,1:11:24.44,1:11:25.32,Default,,0,0,0,,Ах
Dialogue: 0,1:11:25.40,1:11:28.49,Default,,0,0,0,,Бірақ ол бала әлдеқашан өліп қалған.
Dialogue: 0,1:11:28.57,1:11:31.49,Default,,0,0,0,,Сіз оны жойдыңыз!
Dialogue: 0,1:11:34.58,1:11:35.41,Default,,0,0,0,,Ха!
Dialogue: 0,1:11:35.50,1:11:36.62,Default,,0,0,0,,Әй!
Dialogue: 0,1:11:36.71,1:11:38.16,Default,,0,0,0,,Бұл жолы
Dialogue: 0,1:11:38.25,1:11:41.96,Default,,0,0,0,,Менің қолымнан жойылатын кезегің!
Dialogue: 0,1:11:42.04,1:11:43.17,Default,,0,0,0,,Ах!
Dialogue: 0,1:11:44.71,1:11:48.22,Default,,0,0,0,,Мен бұзамын Мен оны құртамын!
Dialogue: 0,1:11:48.30,1:11:50.72,Default,,0,0,0,,Мен оны құртамын!
Dialogue: 0,1:11:50.80,1:11:51.68,Default,,0,0,0,,♬~
Dialogue: 0,1:11:51.76,1:11:53.64,Default,,0,0,0,,Иә!
Dialogue: 0,1:11:53.72,1:11:55.85,Default,,0,0,0,,Ахх...
Dialogue: 0,1:12:01.31,1:12:03.19,Default,,0,0,0,,Хаха!
Dialogue: 0,1:12:03.98,1:12:05.65,Default,,0,0,0,,Ха!
Dialogue: 0,1:12:05.73,1:12:06.61,Default,,0,0,0,,Әй!
Dialogue: 0,1:12:06.69,1:12:08.32,Default,,0,0,0,,Уф!
Dialogue: 0,1:12:10.74,1:12:13.12,Default,,0,0,0,,Ах! Ах...
Dialogue: 0,1:12:13.20,1:12:14.33,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,1:12:14.41,1:12:15.29,Default,,0,0,0,,Ах!
Dialogue: 0,1:12:19.29,1:12:21.29,Default,,0,0,0,,Дөңгелек…
Dialogue: 0,1:12:21.37,1:12:23.59,Default,,0,0,0,,(Жақындап келе жатқан аяқ дыбысы)
Dialogue: 0,1:12:28.76,1:12:31.09,Default,,0,0,0,,Хиконың орнына...
Dialogue: 0,1:12:31.18,1:12:33.47,Default,,0,0,0,,Мені жіберіңіз...беріңіз
Dialogue: 0,1:12:33.55,1:12:36.93,Default,,0,0,0,,Менде де осындай фото бар
Dialogue: 0,1:12:37.02,1:12:40.39,Default,,0,0,0,,Егер оны біреу лақтырып тастаса немесе сындырса ше?
Dialogue: 0,1:12:40.48,1:12:42.81,Default,,0,0,0,,Өлсем де өле алмаймын.
Dialogue: 0,1:12:47.65,1:12:51.65,Default,,0,0,0,,Ха! Хи-цай... Хи-цай!
Dialogue: 0,1:12:53.87,1:12:56.16,Default,,0,0,0,,Э? Қайда?
Dialogue: 0,1:12:56.24,1:13:00.58,Default,,0,0,0,,Мен... сені өлтіремін!
Dialogue: 0,1:13:00.66,1:13:03.83,Default,,0,0,0,,Бұл сіздің өмірдегі болашақ мақсатыңыз.
Dialogue: 0,1:13:03.92,1:13:09.13,Default,,0,0,0,,Мені тірі қалдырғаның үшін сені өкіндіремін!
Dialogue: 0,1:13:11.84,1:13:13.09,Default,,0,0,0,,(Енгізілетін дыбыс)
Dialogue: 0,1:13:21.06,1:13:22.94,Default,,0,0,0,,Сіз жеңдіңіз.
Dialogue: 0,1:13:23.02,1:13:26.06,Default,,0,0,0,,Бұл барлығын құтқарады, солай ма?
Dialogue: 0,1:13:26.15,1:13:27.02,Default,,0,0,0,,Иә
Dialogue: 0,1:13:27.11,1:13:30.03,Default,,0,0,0,,Я... бұл қорқынышты болды
Dialogue: 0,1:13:33.32,1:13:36.07,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,1:13:36.16,1:13:39.45,Default,,0,0,0,,(жылаған дауыс)
Dialogue: 0,1:13:40.87,1:13:44.25,Default,,0,0,0,,Жақсы көр! Еңсеріңіз!
Dialogue: 0,1:13:44.33,1:13:47.92,Default,,0,0,0,,Жақсы көр! Еңсеріңіз!
Dialogue: 0,1:13:48.84,1:13:50.59,Default,,0,0,0,,Сиқыр) 40 жыл азап
Dialogue: 0,1:13:50.67,1:13:53.93,Default,,0,0,0,,Мен мұндай қатты дауысты бірінші рет естіп тұрмын...
Dialogue: 0,1:13:54.59,1:13:58.47,Default,,0,0,0,,Тағы бір нәрсе, бәріміз танысайық!
Dialogue: 0,1:13:58.56,1:14:01.81,Default,,0,0,0,,Тағы бір нәрсе? (Мейми) Сіз әлі бірдеңе істеуді жоспарлап жүрсіз бе?
Dialogue: 0,1:14:01.89,1:14:04.23,Default,,0,0,0,,Хмм!
Dialogue: 0,1:14:04.31,1:14:05.31,Default,,0,0,0,,Ол ісініп, қан ағып тұр
Dialogue: 0,1:14:05.40,1:14:06.56,Default,,0,0,0,,Полуппо!
Dialogue: 0,1:14:06.65,1:14:08.11,Default,,0,0,0,,Ол ісініп, қан ағып тұр
Dialogue: 0,1:14:08.19,1:14:09.07,Default,,0,0,0,,Полуппо!
Dialogue: 0,1:14:09.15,1:14:11.53,Default,,0,0,0,,Сиқыр) Мен «Иә!» дедім. әдеттегіден көп.
Dialogue: 0,1:14:11.61,1:14:14.07,Default,,0,0,0,,Айдаһарлар жоқ па? Не айтқың келеді?
Dialogue: 0,1:14:14.15,1:14:16.07,Default,,0,0,0,,Ханшайым емес
Dialogue: 0,1:14:16.16,1:14:17.49,Default,,0,0,0,,(Панда) Ол екі мектептің аралығындағы бір жерде босап шыққан болар, деп ойлаймын—
Dialogue: 0,1:14:25.00,1:14:26.67,Default,,0,0,0,,Әрқашан елес ұры
Dialogue: 0,1:14:26.75,1:14:30.50,Default,,0,0,0,,Тағдырымды өзімнен ұрлағанын қаладым.
Dialogue: 0,1:14:30.59,1:14:36.22,Default,,0,0,0,,Бірақ сен маған өз тағдырыма жауапты екенімді үйреттің.
Dialogue: 0,1:14:39.10,1:14:43.18,Default,,0,0,0,,Маған берілген тапсырманы орындауға ниеттімін.
Dialogue: 0,1:14:43.27,1:14:45.94,Default,,0,0,0,,Мен өзім үшін сол өмірді таңдадым.
Dialogue: 0,1:14:46.02,1:14:48.86,Default,,0,0,0,,Мен мақтанышпен айта алатындай өмір сүремін.
Dialogue: 0,1:14:49.44,1:14:53.19,Default,,0,0,0,,Бір күні мен балаларыма айтамын
Dialogue: 0,1:14:53.28,1:14:56.40,Default,,0,0,0,,Елес ұры Ирманың ұлы шытырман оқиғасы
Dialogue: 0,1:14:57.24,1:15:01.03,Default,,0,0,0,,Елес ұры Ирманың серіктесі бар ма?
Dialogue: 0,1:15:01.12,1:15:06.66,Default,,0,0,0,,Иә, ол өрнексіз, дөрекі және жекпе-жек өнерінің данышпан.
Dialogue: 0,1:15:06.75,1:15:12.38,Default,,0,0,0,,Менің сенімді серіктесім бар, бірақ... өте дөрекі.
Dialogue: 0,1:15:13.00,1:15:16.17,Default,,0,0,0,,(жылайды)
Dialogue: 0,1:15:16.26,1:15:17.72,Default,,0,0,0,,Мен өзімді жеңіл сезіндім.
Dialogue: 0,1:15:18.30,1:15:21.43,Default,,0,0,0,,Олай болса, Ирма абайсызда бірдеңе жасайды деп уайымдаудың қажеті жоқ.
Dialogue: 0,1:15:23.22,1:15:24.77,Default,,0,0,0,,Шынымен...
Dialogue: 0,1:15:24.85,1:15:28.10,Default,,0,0,0,,Сіз шынымен дөрекі адамсыз.
Dialogue: 0,1:15:30.06,1:15:31.61,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,1:15:31.69,1:15:34.32,Default,,0,0,0,,Бұл демалыс ретінде сәйкес келмейді.
Dialogue: 0,1:15:34.40,1:15:37.49,Default,,0,0,0,,Күрсін... Мен бүгін кешке ерте ұйықтауым керек деп ойлаймын.
Dialogue: 0,1:15:38.03,1:15:40.53,Default,,0,0,0,,Әлі де атқарылатын жұмыстар бар
Dialogue: 0,1:15:40.62,1:15:42.49,Default,,0,0,0,,Сіз мұны ертең жасай аласыз ба?
Dialogue: 0,1:15:42.58,1:15:46.12,Default,,0,0,0,,Ертең таңертең біз соңғы байланыс портына, Нью-Йорк портына барамыз.
Dialogue: 0,1:15:46.20,1:15:47.96,Default,,0,0,0,,Кеме келді
Dialogue: 0,1:15:48.75,1:15:51.50,Default,,0,0,0,,Көрме бөлмесінен Әулие Орлов сапфирін қалай ұрлау керек
Dialogue: 0,1:15:51.58,1:15:53.42,Default,,0,0,0,,Бүгін түнде ғана.
Dialogue: 0,1:15:53.50,1:15:54.84,Default,,0,0,0,,Хун
Dialogue: 0,1:15:56.01,1:15:58.55,Default,,0,0,0,,Менің де бір ойым бар.
Dialogue: 0,1:15:58.63,1:16:01.89,Default,,0,0,0,,Мен диванның астындағы шарапты тастаймын.
Dialogue: 0,1:16:03.22,1:16:07.27,Default,,0,0,0,,Мүмкін Chateau La Mission Haut Brion?
Dialogue: 0,1:16:07.35,1:16:09.60,Default,,0,0,0,,75 жаста
Dialogue: 0,1:16:09.69,1:16:11.10,Default,,0,0,0,,Ах!
Dialogue: 0,1:16:12.31,1:16:13.52,Default,,0,0,0,,Хмм...
Dialogue: 0,1:16:16.69,1:16:18.07,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,1:16:18.15,1:16:20.28,Default,,0,0,0,,Көңіл-күйіңіз өте нашар сияқты.
Dialogue: 0,1:16:20.36,1:16:21.41,Default,,0,0,0,,Хмм.
Dialogue: 0,1:16:24.78,1:16:29.16,Default,,0,0,0,,Мен қазір демалысымда жұмысқа барамын, хаха.
Dialogue: 0,1:16:31.17,1:16:32.58,Default,,0,0,0,,Иә?
Dialogue: 0,1:16:43.89,1:16:46.76,Default,,0,0,0,,Қош келдіңіз, бұл өте ерте болды.
Dialogue: 0,1:16:46.85,1:16:48.06,Default,,0,0,0,,Хмм...
Dialogue: 0,1:16:49.06,1:16:50.35,Default,,0,0,0,,Иә?
Dialogue: 0,1:17:01.24,1:17:03.91,Default,,0,0,0,,Мен демалыстамын!
Dialogue: 0,1:17:03.99,1:17:07.12,Default,,0,0,0,,Мен енді жұмыс істемеймін!
Dialogue: 0,1:17:14.29,1:17:16.42,Default,,0,0,0,,Сатчмоға отырыңыз
Dialogue: 0,1:17:16.50,1:17:18.92,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,1:17:19.01,1:17:20.47,Default,,0,0,0,,Кемеден түскенде
Dialogue: 0,1:17:20.55,1:17:24.93,Default,,0,0,0,,Барлық заттарыңызды өзіңізбен бірге үйге апарыңыз.
Dialogue: 0,1:17:26.43,1:17:29.39,Default,,0,0,0,,Ха, демалыс аяқталуға жақын.
Dialogue: 0,1:17:29.47,1:17:31.64,Default,,0,0,0,,О, мен бір нәрсені ұмытып қалдым.
Dialogue: 0,1:17:31.73,1:17:33.90,Default,,0,0,0,,Нені ұмыттыңыз?
Dialogue: 0,1:17:33.98,1:17:35.65,Default,,0,0,0,,Оны маған әкеле аласыз ба?
Dialogue: 0,1:17:35.73,1:17:38.73,Default,,0,0,0,,Не? Иә
Dialogue: 0,1:17:40.53,1:17:41.90,Default,,0,0,0,,(Электрондық дыбыстың құлпын ашу)
Dialogue: 0,1:17:44.53,1:17:45.37,Default,,0,0,0,,Иә?
Dialogue: 0,1:17:51.37,1:17:53.00,Default,,0,0,0,,Ах...
Dialogue: 0,1:17:53.08,1:17:55.17,Default,,0,0,0,,Бұл сіздің еліңізге тиесілі
Dialogue: 0,1:17:55.25,1:17:56.33,Default,,0,0,0,,Иә?
Dialogue: 0,1:17:56.42,1:17:58.63,Default,,0,0,0,,Оны қалауыңызша пайдаланыңыз
Dialogue: 0,1:17:59.96,1:18:02.22,Default,,0,0,0,,Рахмет
Dialogue: 0,1:18:02.30,1:18:05.59,Default,,0,0,0,,Фантом ұры ханшайымы Джокер мырза
Dialogue: 0,1:18:05.68,1:18:06.84,Default,,0,0,0,,Хехе
Dialogue: 0,1:18:07.51,1:18:11.27,Default,,0,0,0,,Мен бұл жақсылықты ешқашан ұмытпаймын.
Dialogue: 0,1:18:18.15,1:18:22.65,Default,,0,0,0,,Уайымдамаңыз, нақты нәрсе басқа жерде жасырылған.
Dialogue: 0,1:18:22.74,1:18:23.61,Default,,0,0,0,,Иә?
Dialogue: 0,1:18:23.69,1:18:27.32,Default,,0,0,0,,Жауды алдау үшін одақтастарыңыздан бастаңыз.
Dialogue: 0,1:18:28.07,1:18:30.54,Default,,0,0,0,,Жалғанның таратқышы бар
Dialogue: 0,1:18:30.62,1:18:35.04,Default,,0,0,0,,А, егер сіз осыны орындасаңыз, сіз фантом ұры ханшайымына жетесіз!
Dialogue: 0,1:18:35.12,1:18:37.13,Default,,0,0,0,,Бұл үлкен! детектив мырза
Dialogue: 0,1:18:37.21,1:18:41.34,Default,,0,0,0,,Мен сізді алғаш рет құрметтедім, Джотто мырза.
Dialogue: 0,1:18:42.00,1:18:45.30,Default,,0,0,0,,Енді патшайымды алып келейік.
Dialogue: 0,1:18:46.26,1:18:48.89,Default,,0,0,0,,Патшайым жақын жерде
Dialogue: 0,1:18:49.85,1:18:52.56,Default,,0,0,0,,Иә, ол осында.
Dialogue: 0,1:18:54.39,1:18:55.81,Default,,0,0,0,,Осы шөлдеген таулардың тереңінде—
Dialogue: 0,1:18:58.10,1:18:59.02,Default,,0,0,0,,Иә?
Dialogue: 0,1:18:59.11,1:19:02.82,Default,,0,0,0,,Мұнда ешкім жоқ, солай ма?
Dialogue: 0,1:19:02.90,1:19:04.86,Default,,0,0,0,,Жоқ, міне.
Dialogue: 0,1:19:06.20,1:19:07.24,Default,,0,0,0,,Иә?
Dialogue: 0,1:19:07.32,1:19:09.57,Default,,0,0,0,,Иә? О~
Dialogue: 0,1:19:10.53,1:19:13.66,Default,,0,0,0,,Ангеликке берілген крест
Dialogue: 0,1:19:13.74,1:19:16.96,Default,,0,0,0,,Ақиқаттан көзіңді бұрма
Dialogue: 0,1:19:18.46,1:19:22.04,Default,,0,0,0,,Джотто мырза Мен олай ойламаймын.
Dialogue: 0,1:19:22.13,1:19:24.17,Default,,0,0,0,,Сапфирді жасырған жеріңіз осы ма?
Dialogue: 0,1:19:24.96,1:19:28.55,Default,,0,0,0,,Әулие Орлов сапфирі қол жетімді
Dialogue: 0,1:19:28.63,1:19:30.39,Default,,0,0,0,,А, аа...
Dialogue: 0,1:19:30.47,1:19:31.43,Default,,0,0,0,,Эй!
Dialogue: 0,1:19:31.51,1:19:35.52,Default,,0,0,0,,Жақұтты ұрлап, патшайымды да алып кеткен деп ойлау.
Dialogue: 0,1:19:35.60,1:19:39.56,Default,,0,0,0,,Сіз! Маған қалай жіберуге болады!?
Dialogue: 0,1:19:39.65,1:19:43.48,Default,,0,0,0,,Анджелик патшайым ба? Ах...
Dialogue: 0,1:19:43.57,1:19:45.44,Default,,0,0,0,,Тағы да бар!
Dialogue: 0,1:19:46.28,1:19:47.45,Default,,0,0,0,,Не? Ит пе?
Dialogue: 0,1:19:49.11,1:19:51.16,Default,,0,0,0,,Түтін! Бұл газ!
Dialogue: 0,1:19:51.24,1:19:52.49,Default,,0,0,0,,А, сыртқа шық!
Dialogue: 0,1:19:52.58,1:19:54.95,Default,,0,0,0,,Патшайым, шық!
Dialogue: 0,1:19:55.04,1:19:56.62,Default,,0,0,0,,Уф...
Dialogue: 0,1:19:56.70,1:19:57.58,Default,,0,0,0,,Иә?
Dialogue: 0,1:19:57.66,1:19:59.79,Default,,0,0,0,,Жерде не!
Dialogue: 0,1:19:59.87,1:20:01.29,Default,,0,0,0,,Тыныш! Апыр-ай!
Dialogue: 0,1:20:03.34,1:20:04.30,Default,,0,0,0,,♬~
Dialogue: 0,1:20:04.38,1:20:06.34,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,1:20:06.42,1:20:07.47,Default,,0,0,0,,Уф
Dialogue: 0,1:20:07.55,1:20:09.84,Default,,0,0,0,,Эх!
Dialogue: 0,1:20:14.47,1:20:18.06,Default,,0,0,0,,Уау! Тоқта!
Dialogue: 0,1:20:18.14,1:20:21.31,Default,,0,0,0,,Рем ше?
Dialogue: 0,1:20:21.40,1:20:24.15,Default,,0,0,0,,Королева да Икезунаға еліктейді.
Dialogue: 0,1:20:24.23,1:20:26.28,Default,,0,0,0,,Қандай еркелік?
Dialogue: 0,1:20:31.32,1:20:32.82,Default,,0,0,0,,(Қоңырау үні)
Dialogue: 0,1:20:32.91,1:20:36.95,Default,,0,0,0,,Сәлеметсіз бе, Ниши-чан? Учия Се Цимадан шыққан Мари Ито
Dialogue: 0,1:20:37.04,1:20:38.96,Default,,0,0,0,,Сатчмоның кемесі қазір қызу тақырып
Dialogue: 0,1:20:39.04,1:20:42.00,Default,,0,0,0,,Мен кемеде хабарландыру жасаған кезде сұхбат алу үшін жасырын түрде бардым.
Dialogue: 0,1:20:42.08,1:20:44.96,Default,,0,0,0,,Менің бір қызық оқиғам бар. Оны естігіңіз келе ме?
Dialogue: 0,1:20:45.04,1:20:48.84,Default,,0,0,0,,Оны естігіңіз келсе, суши жасайық...
Dialogue: 0,1:20:48.92,1:20:53.93,Default,,0,0,0,,♪～
Dialogue: 0,1:21:05.27,1:21:09.03,Default,,0,0,0,,♪ Барлық жерде ерекшеліктер
Dialogue: 0,1:21:09.11,1:21:11.24,Default,,0,0,0,,♪ Сахна артындағы құпия қулық па?
Dialogue: 0,1:21:11.32,1:21:13.61,Default,,0,0,0,,♪ Көрсетілім уақытына шақыру
Dialogue: 0,1:21:13.70,1:21:15.74,Default,,0,0,0,,♪ Эстетиканың толқуы
Dialogue: 0,1:21:15.83,1:21:21.83,Default,,0,0,0,,♪ Аперитивпен бірге ұсыныңыз.
Dialogue: 0,1:21:21.91,1:21:26.04,Default,,0,0,0,,♪ Алдау мен алдау, Абайсыздықтың жауы
Dialogue: 0,1:21:26.13,1:21:30.09,Default,,0,0,0,,♪ Ace of Hearts-тен сақ болыңыз
Dialogue: 0,1:21:30.17,1:21:34.30,Default,,0,0,0,,♪ Жақұт теңізіндегі тербелетін саяхат (Саяхат)
Dialogue: 0,1:21:34.39,1:21:38.68,Default,,0,0,0,,♪ Мүмкін емес ештеңе жоқ!
Dialogue: 0,1:21:39.39,1:21:40.39,Default,,0,0,0,,♪ Ойын қосулы!
Dialogue: 0,1:21:40.47,1:21:44.27,Default,,0,0,0,,♪ Енді тағдырыңды мін
Dialogue: 0,1:21:44.35,1:21:49.32,Default,,0,0,0,,♪ Дүниені алдап, еліктір
Dialogue: 0,1:21:49.40,1:21:53.15,Default,,0,0,0,,♪ Тіпті бір нәрсеге мүмкіндік жоқ
Dialogue: 0,1:21:53.24,1:21:57.28,Default,,0,0,0,,♪ Осы сценарийде билейміз бе?
Dialogue: 0,1:21:57.37,1:22:01.00,Default,,0,0,0,,♪ Жүрегім сүйкімді махаббаттай толқып тұр
Dialogue: 0,1:22:01.08,1:22:04.87,Default,,0,0,0,,♪ Музыканы әлі тоқтатпаңыз
Dialogue: 0,1:22:04.96,1:22:06.83,Default,,0,0,0,,♪ Ешқандай елес жоқ
Dialogue: 0,1:22:06.92,1:22:11.01,Default,,0,0,0,,♪ Қол шапалақтау мен қошемет сияқты шу болды.
Dialogue: 0,1:22:11.09,1:22:13.67,Default,,0,0,0,,♪ Сіз бірге жақсы көрінесіз, солай емес пе?
Dialogue: 0,1:22:13.76,1:22:16.97,Default,,0,0,0,,♪ Жалықтырмай круиз
Dialogue: 0,1:22:26.65,1:22:30.44,Default,,0,0,0,,♪ Ымырт қайнағалы тұр
Dialogue: 0,1:22:30.52,1:22:32.32,Default,,0,0,0,,♪ Жоғарылықтың жасырын сыры
Dialogue: 0,1:22:32.40,1:22:34.99,Default,,0,0,0,,♪ Джокер Будданың үстіңгі бетін ашу.
Dialogue: 0,1:22:35.07,1:22:37.16,Default,,0,0,0,,♪ Тынысы тыныш
Dialogue: 0,1:22:37.24,1:22:43.33,Default,,0,0,0,,♪ Сол қолды безендіріп, қосыңыз
Dialogue: 0,1:22:43.41,1:22:45.21,Default,,0,0,0,,♪ Бәрі өтірік сияқты
Dialogue: 0,1:22:45.29,1:22:47.46,Default,,0,0,0,,♪ Шындықты жасырған Сапир
Dialogue: 0,1:22:47.54,1:22:49.54,Default,,0,0,0,,♪ Жүректер ханшайымы
Dialogue: 0,1:22:49.63,1:22:51.59,Default,,0,0,0,,♪ Ату мүмкін емес
Dialogue: 0,1:22:51.67,1:22:55.72,Default,,0,0,0,,♪ Маған шешілмейтін лабиринт беріңіз
Dialogue: 0,1:22:55.80,1:22:58.89,Default,,0,0,0,,♪ Кім жеңгенін білсеңіз қызықсыз.
Dialogue: 0,1:22:58.97,1:23:00.76,Default,,0,0,0,,♪ Көбірек беріңіз!
Dialogue: 0,1:23:08.31,1:23:12.36,Default,,0,0,0,,♪ Алдау мен алдау, Абайсыздықтың жауы
Dialogue: 0,1:23:12.44,1:23:16.53,Default,,0,0,0,,♪ Ace of Hearts-тен сақ болыңыз
Dialogue: 0,1:23:16.61,1:23:20.78,Default,,0,0,0,,♪ Жақұт теңізіндегі тербелетін саяхат (Саяхат)
Dialogue: 0,1:23:20.87,1:23:25.66,Default,,0,0,0,,♪ Мүмкін емес ештеңе жоқ!
Dialogue: 0,1:23:25.75,1:23:30.67,Default,,0,0,0,,♪ Ал саяхат - арманның соңы
Dialogue: 0,1:23:30.75,1:23:35.67,Default,,0,0,0,,♪ Барлық естеліктеріңізді зергерлік қорапқа салыңыз
Dialogue: 0,1:23:35.76,1:23:37.80,Default,,0,0,0,,♪ Тіпті «бір күні»
Dialogue: 0,1:23:37.88,1:23:42.51,Default,,0,0,0,,♪ Мен оны міндетті түрде осының ішіне сыйдырғым келеді
Dialogue: 0,1:23:44.60,1:23:45.60,Default,,0,0,0,,♪ Ойын қосулы!
Dialogue: 0,1:23:45.68,1:23:49.48,Default,,0,0,0,,♪ Енді тағдырыңды мін
Dialogue: 0,1:23:49.56,1:23:54.44,Default,,0,0,0,,♪ Дүниені алдап, еліктір
Dialogue: 0,1:23:54.53,1:23:58.36,Default,,0,0,0,,♪ Тіпті бір нәрсеге мүмкіндік жоқ
Dialogue: 0,1:23:58.45,1:24:02.53,Default,,0,0,0,,♪ Осы сценарийде билейміз бе?
Dialogue: 0,1:24:02.62,1:24:06.20,Default,,0,0,0,,♪ Жүрегім сүйкімді махаббаттай толқып тұр
Dialogue: 0,1:24:06.29,1:24:10.04,Default,,0,0,0,,♪ Музыканы әлі тоқтатпаңыз
Dialogue: 0,1:24:10.12,1:24:12.08,Default,,0,0,0,,♪ Ешқандай елес жоқ
Dialogue: 0,1:24:12.17,1:24:16.26,Default,,0,0,0,,♪ Қол шапалақтау мен қошемет сияқты шу болды.
Dialogue: 0,1:24:16.34,1:24:18.13,Default,,0,0,0,,♪ Бұл сізге жарасады, солай ма?
Dialogue: 0,1:24:19.05,1:24:23.60,Default,,0,0,0,,♪ Жалықтырмайтын сапарға асығайық
Dialogue: 0,1:24:44.07,1:24:49.08,Default,,0,0,0,,～♪
Dialogue: 0,1:24:53.13,1:24:56.00,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,1:24:56.59,1:24:58.46,Default,,0,0,0,,Хмм...
Dialogue: 0,1:25:02.09,1:25:02.93,Default,,0,0,0,,Иә
Dialogue: 0,1:25:06.97,1:25:08.81,Default,,0,0,0,,Не дедің?
Dialogue: 0,1:25:08.89,1:25:09.85,Default,,0,0,0,,Иә?
Dialogue: 0,1:25:12.90,1:25:14.52,Default,,0,0,0,,Хехе
Dialogue: 0,1:25:14.61,1:25:17.53,Default,,0,0,0,,Инкогнито режиміндегі сапарыңыз қалай өтті?
Dialogue: 0,1:25:17.61,1:25:22.24,Default,,0,0,0,,Бұл өте жақсы және талғампаз демалыс болды.
Dialogue: 0,1:25:29.83,1:25:30.96,Default,,0,0,0,,Еркелік пе?
Dialogue: 0,1:25:31.04,1:25:32.33,Default,,0,0,0,,Ах
Dialogue: 0,1:25:32.41,1:25:34.96,Default,,0,0,0,,Диктордың дос қызынан сізге көмектесуін сұраңыз.
Dialogue: 0,1:25:35.04,1:25:35.92,Default,,0,0,0,,Иә?
Dialogue: 0,1:25:36.00,1:25:41.17,Default,,0,0,0,,Ол журналист. Бұл жақсы кәдесый болар еді.
Dialogue: 0,1:25:55.27,1:25:57.73,Default,,0,0,0,,Қазір байқамай қалатындай әдемі.
Dialogue: 0,1:25:57.82,1:25:59.94,Default,,0,0,0,,Тазалау керек болды
Dialogue: 0,1:26:00.03,1:26:02.70,Default,,0,0,0,,Шамалы болған кезде мен өзімді тыныш сезінемін.
Dialogue: 0,1:26:02.78,1:26:03.70,Default,,0,0,0,,Е...
Dialogue: 0,1:26:04.41,1:26:07.03,Default,,0,0,0,,Мен ұмытып кете жаздадым.
Dialogue: 0,1:26:07.12,1:26:08.53,Default,,0,0,0,,Сізге кәдесый.
Dialogue: 0,1:26:08.62,1:26:10.24,Default,,0,0,0,,Маған?
Dialogue: 0,1:26:10.83,1:26:13.08,Default,,0,0,0,,Иә, бұл! кәдесый!
Dialogue: 0,1:26:13.16,1:26:14.50,Default,,0,0,0,,А...
Dialogue: 0,1:26:15.71,1:26:18.04,Default,,0,0,0,,Өзіңізді жақсы сезінетін нәрсе.
Dialogue: 0,1:26:18.13,1:26:20.55,Default,,0,0,0,,Мен оны сатып алудың қиындығына барсам да.
Dialogue: 0,1:26:20.63,1:26:22.13,Default,,0,0,0,,Ханшайым
Dialogue: 0,1:26:22.21,1:26:25.72,Default,,0,0,0,,Нағыз жақұтты қазынаға қалай жасыруға болады?
Dialogue: 0,1:26:25.80,1:26:26.97,Default,,0,0,0,,Түсіндіңіз бе?
Dialogue: 0,1:26:27.05,1:26:28.30,Default,,0,0,0,,Бұл оңай.
Dialogue: 0,1:26:29.14,1:26:33.77,Default,,0,0,0,,Маңызды нәрсені қорғау кезінде біз әдетте оны қараусыз қалдырмауға тырысамыз.
Dialogue: 0,1:26:33.85,1:26:36.90,Default,,0,0,0,,Бірақ Джотто қазынаға бетін қайтарды.
Dialogue: 0,1:26:36.98,1:26:39.57,Default,,0,0,0,,Мен «Кариб теңізінің қарақшылары» көрмесін қарап отырдым.
Dialogue: 0,1:26:40.15,1:26:42.61,Default,,0,0,0,,Қазынаны күзетіп жүргендей кейіп таныту
Dialogue: 0,1:26:42.69,1:26:45.32,Default,,0,0,0,,Сонымен, сен қазына сандығын бақылап тұрдың.
Dialogue: 0,1:26:45.40,1:26:46.28,Default,,0,0,0,,Ах
Dialogue: 0,1:26:47.45,1:26:49.87,Default,,0,0,0,,Сонда да шаршадым.
Dialogue: 0,1:26:49.95,1:26:53.45,Default,,0,0,0,,Ерекше демалыс болса да, көп жұмыс істеуге тура келді.
Dialogue: 0,1:26:53.54,1:26:56.96,Default,,0,0,0,,Бірінші мұнарада Ирма ханшайымының бойтұмары ретінде.
Dialogue: 0,1:26:57.04,1:26:57.92,Default,,0,0,0,,Ах!
Dialogue: 0,1:26:58.00,1:26:59.13,Default,,0,0,0,,Ах!
Dialogue: 0,1:26:59.21,1:27:00.96,Default,,0,0,0,,Шай шайтан!
Dialogue: 0,1:27:08.80,1:27:11.43,Default,,0,0,0,,Рагудан басқа да тағамдарды мүмкіндігінше тезірек жақсы пісіре білгім келеді.
Dialogue: 0,1:27:12.47,1:27:15.23,Default,,0,0,0,,Сіз қате кемедесіз.
Dialogue: 0,1:27:15.31,1:27:16.44,Default,,0,0,0,,Иә
Dialogue: 0,1:27:16.52,1:27:17.94,Default,,0,0,0,,Хекшун!
Dialogue: 0,1:27:18.65,1:27:20.40,Default,,0,0,0,,Му~
Dialogue: 0,1:27:20.48,1:27:22.82,Default,,0,0,0,,Мен мүлдем ұмытып кеттім.
Dialogue: 0,1:27:22.90,1:27:25.61,Default,,0,0,0,,Бәрі жақсы, мұның соңы жақсы.
Dialogue: 0,1:27:26.20,1:27:27.20,Default,,0,0,0,,Ах
Dialogue: 0,1:27:27.82,1:27:28.95,Default,,0,0,0,,Иә?
Dialogue: 0,1:27:29.45,1:27:30.66,Default,,0,0,0,,Иә?
Dialogue: 0,1:27:31.49,1:27:34.58,Default,,0,0,0,,RD Менде шарап жоқ.
Dialogue: 0,1:27:34.66,1:27:37.37,Default,,0,0,0,,Шарап жертөлесінде сақталады.
Dialogue: 0,1:27:37.46,1:27:40.25,Default,,0,0,0,,Бұл қорқынышты емес пе? Біз доспыз!
Dialogue: 0,1:27:40.33,1:27:43.75,Default,,0,0,0,,Бұл дос емес, бұл жай ғана жасанды интеллект.
Dialogue: 0,1:27:43.84,1:27:46.42,Default,,0,0,0,,Іскерлік серіктес
Dialogue: 0,1:27:47.92,1:27:53.92,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory