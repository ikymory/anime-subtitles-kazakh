Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.05,0:00:07.88,Default,,0,0,0,,Ash Pro қалтасының соңғы бөлігі осында
Dialogue: 0,0:00:11.72,0:00:12.43,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:00:16.01,0:00:16.85,Default,,0,0,0,,Миу
Dialogue: 0,0:00:18.10,0:00:19.73,Default,,0,0,0,,Керемет жауап!
Dialogue: 0,0:00:19.98,0:00:22.19,Default,,0,0,0,,Мен мұны оқыдым.
Dialogue: 0,0:00:22.44,0:00:25.23,Default,,0,0,0,,Бұл екі үлгіні қайдан таптыңыз?
Dialogue: 0,0:00:26.32,0:00:27.98,Default,,0,0,0,,Кішкене құпия жер бар.
Dialogue: 0,0:00:28.65,0:00:32.57,Default,,0,0,0,,Мен бұл екеуін күнде бақылап отырғым келеді.
Dialogue: 0,0:00:33.95,0:00:35.08,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:02:15.44,0:02:17.65,Default,,0,0,0,,Үй бөлмесі тым ұзаққа созылды.
Dialogue: 0,0:02:24.57,0:02:26.74,Default,,0,0,0,,Бүгін ол қару саудагерін тұтқындауға барды
Dialogue: 0,0:02:27.61,0:02:29.53,Default,,0,0,0,,Қайырлы таң, Ичиго-чан
Dialogue: 0,0:02:29.53,0:02:30.24,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:02:32.12,0:02:33.87,Default,,0,0,0,,Kaho-san Mafuyu-san
Dialogue: 0,0:02:34.16,0:02:36.12,Default,,0,0,0,,Менде бүгін біртүрлі шаш үлгісі бар.
Dialogue: 0,0:02:38.21,0:02:41.25,Default,,0,0,0,,Бүгін ат құйрығы күні болуы керек.
Dialogue: 0,0:02:41.75,0:02:43.05,Default,,0,0,0,,Бұл тұтынушыларға қызмет көрсету.
Dialogue: 0,0:02:43.09,0:02:46.13,Default,,0,0,0,,Неліктен тіпті біз?
Dialogue: 0,0:02:46.55,0:02:48.43,Default,,0,0,0,,Біркелкілік маңызды
Dialogue: 0,0:02:48.93,0:02:50.47,Default,,0,0,0,,Бұл сізге сәйкес келеді.
Dialogue: 0,0:02:50.55,0:02:52.47,Default,,0,0,0,,Шулы, тиіспеңіз
Dialogue: 0,0:02:52.97,0:02:55.06,Default,,0,0,0,,Ат құйрығынан гөрі
Dialogue: 0,0:02:55.81,0:02:56.64,Default,,0,0,0,,Топ түйін
Dialogue: 0,0:02:57.52,0:02:58.65,Default,,0,0,0,,Маған желке жағы ұнайды
Dialogue: 0,0:02:58.94,0:02:59.60,Default,,0,0,0,,Мен берілмеймін. Бір адамның да өлуіне жол бермеймін
Dialogue: 0,0:03:01.69,0:03:03.86,Default,,0,0,0,,Жақсы, өйткені екеуінің де шаштары ұзын.
Dialogue: 0,0:03:04.19,0:03:06.36,Default,,0,0,0,,Маған сәл қиын.
Dialogue: 0,0:03:06.86,0:03:09.11,Default,,0,0,0,,Неге оны көбірек созбайсың, Мафую-сан?
Dialogue: 0,0:03:09.70,0:03:11.70,Default,,0,0,0,,Заттарды әртүрлі тәсілдермен ретке келтіру қызық.
Dialogue: 0,0:03:13.54,0:03:14.95,Default,,0,0,0,,Өрім және т.б.
Dialogue: 0,0:03:15.41,0:03:16.58,Default,,0,0,0,,Тоқаш және т.б.
Dialogue: 0,0:03:16.91,0:03:18.54,Default,,0,0,0,,Әрине, twinte.
Dialogue: 0,0:03:18.54,0:03:19.67,Default,,0,0,0,,Келесі Келесі
Dialogue: 0,0:03:19.87,0:03:21.04,Default,,0,0,0,,Екі жағы жоғары
Dialogue: 0,0:03:21.08,0:03:22.88,Default,,0,0,0,,Екі жағы жоғары
Dialogue: 0,0:03:23.63,0:03:25.84,Default,,0,0,0,,Бірақ Ичиго-чан патша
Dialogue: 0,0:03:26.30,0:03:28.26,Default,,0,0,0,,Оның ұзын, тік қара шашы бар.
Dialogue: 0,0:03:28.55,0:03:29.22,Default,,0,0,0,,Екінші жағынан
Dialogue: 0,0:03:29.22,0:03:32.97,Default,,0,0,0,,Үлгі сияқты бірегей болуының кемшілігі де бар.
Dialogue: 0,0:03:33.35,0:03:35.35,Default,,0,0,0,,Мм...
Dialogue: 0,0:03:35.35,0:03:36.47,Default,,0,0,0,,Жарайды
Dialogue: 0,0:03:36.60,0:03:38.52,Default,,0,0,0,,Ичиго-чанның аурасы керемет
Dialogue: 0,0:03:38.52,0:03:40.10,Default,,0,0,0,,Жоқ, мен...
Dialogue: 0,0:03:42.61,0:03:44.11,Default,,0,0,0,,Мықты тұлға
Dialogue: 0,0:03:45.82,0:03:47.49,Default,,0,0,0,,Ақыл-есіңді сақта.
Dialogue: 0,0:03:47.78,0:03:50.24,Default,,0,0,0,,Менің шашым өте жұқа.
Dialogue: 0,0:03:50.45,0:03:55.29,Default,,0,0,0,,Сол себепті байланбаған жағдайда статикалық электр тогының әсерінен жарылып кетеді.
Dialogue: 0,0:03:55.29,0:03:57.37,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:03:58.08,0:03:59.58,Default,,0,0,0,,Керісінше, қанша адам қарғысқа ұшырап өлетінін болжау мүмкін емес.
Dialogue: 0,0:03:59.75,0:04:01.17,Default,,0,0,0,,Мен статикалық электрмен жұмыс істей аламын.
Dialogue: 0,0:04:01.17,0:04:02.17,Default,,0,0,0,,Медуза
Dialogue: 0,0:04:02.79,0:04:04.00,Default,,0,0,0,,Макура медузасы
Dialogue: 0,0:04:04.63,0:04:05.96,Default,,0,0,0,,Статикалық электр
Dialogue: 0,0:04:06.25,0:04:07.13,Default,,0,0,0,,Тамашуни
Dialogue: 0,0:04:07.30,0:04:10.43,Default,,0,0,0,,Әйтеуір, өткеннің жарақат қақпасы ашылғалы тұр.
Dialogue: 0,0:04:10.43,0:04:13.14,Default,,0,0,0,,Ичиго-чан қайтып оралды
Dialogue: 0,0:04:13.89,0:04:15.43,Default,,0,0,0,,Кешіріңіз, Ичиго-чан
Dialogue: 0,0:04:15.72,0:04:17.06,Default,,0,0,0,,Ат құйрығын жасайық.
Dialogue: 0,0:04:17.81,0:04:21.48,Default,,0,0,0,,Жағымды атмосфера үшін кешіріңіз.
Dialogue: 0,0:04:22.02,0:04:23.44,Default,,0,0,0,,Yes done
Dialogue: 0,0:04:24.06,0:04:25.52,Default,,0,0,0,,Рахмет
Dialogue: 0,0:04:25.86,0:04:27.32,Default,,0,0,0,,Донмай Ичиго-чан
Dialogue: 0,0:04:28.65,0:04:30.82,Default,,0,0,0,,Егер сіз статикалық электр тогы туралы алаңдасаңыз...
Dialogue: 0,0:04:31.07,0:04:32.61,Default,,0,0,0,,Мен тұтынушыларға қызмет көрсетемін.
Dialogue: 0,0:04:32.70,0:04:34.16,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:04:34.82,0:04:36.16,Default,,0,0,0,,Күлімсіреу Күлімсіреу
Dialogue: 0,0:04:36.91,0:04:38.04,Default,,0,0,0,,Ауысу керек
Dialogue: 0,0:04:38.62,0:04:41.00,Default,,0,0,0,,Ичиго-сан, шашың дақ.
Dialogue: 0,0:04:41.71,0:04:42.96,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:04:46.96,0:04:49.01,Default,,0,0,0,,Ичиго-сан күткендей.
Dialogue: 0,0:04:49.42,0:04:51.01,Default,,0,0,0,,Жақсы қамшылау.
Dialogue: 0,0:04:51.26,0:04:53.68,Default,,0,0,0,,М-бұл қамшы емес, шаш.
Dialogue: 0,0:04:53.75,0:04:54.64,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:04:55.89,0:04:58.10,Default,,0,0,0,,Егер сіз статикалық электр тогы туралы алаңдасаңыз
Dialogue: 0,0:04:58.39,0:05:01.73,Default,,0,0,0,,Мен қолданатын шетелде жасалған емді қолданып көрейін деп жатырмын.
Dialogue: 0,0:05:01.89,0:05:03.02,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:05:03.31,0:05:05.31,Default,,0,0,0,,Менің сатып алатын бір нәрсем қалды.
Dialogue: 0,0:05:05.31,0:05:06.56,Default,,0,0,0,,Мен саған сыйлық беремін.
Dialogue: 0,0:05:06.86,0:05:08.23,Default,,0,0,0,,Рахмет
Dialogue: 0,0:05:08.57,0:05:10.57,Default,,0,0,0,,Жоқ, жоқ, кездескенше.
Dialogue: 0,0:05:10.78,0:05:11.24,Default,,0,0,0,,Иә
Dialogue: 0,0:05:13.70,0:05:16.78,Default,,0,0,0,,Ұмытпау үшін үзіліс кезінде беремін.
Dialogue: 0,0:05:17.95,0:05:18.58,Default,,0,0,0,,Мұны жасамаңыз
Dialogue: 0,0:05:20.50,0:05:21.25,Default,,0,0,0,,Бұл не
Dialogue: 0,0:05:24.08,0:05:25.46,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:05:28.17,0:05:30.96,Default,,0,0,0,,Ичиго-чан, бүгін оның құйрығы бар.
Dialogue: 0,0:05:31.76,0:05:34.05,Default,,0,0,0,,Бүгін ат құйрығы күні.
Dialogue: 0,0:05:34.84,0:05:35.72,Default,,0,0,0,,Ә... ә... білесің бе...
Dialogue: 0,0:05:35.72,0:05:37.05,Default,,0,0,0,,Ұнады, ұнайды
Dialogue: 0,0:05:37.26,0:05:38.72,Default,,0,0,0,,Бұл таңқаларлық
Dialogue: 0,0:05:39.06,0:05:42.85,Default,,0,0,0,,Тұтынушы бір ғана шаш үлгісіне қалай риза болуы мүмкін?
Dialogue: 0,0:05:43.39,0:05:45.94,Default,,0,0,0,,Бұл қонақжайлылық индустриясы сияқты.
Dialogue: 0,0:05:45.94,0:05:46.31,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:05:47.31,0:05:51.03,Default,,0,0,0,,Қара шашқа келсек, түзу ұзын шаш та жақсы.
Dialogue: 0,0:05:51.03,0:05:52.40,Default,,0,0,0,,А, түсіндім.
Dialogue: 0,0:05:54.15,0:05:56.57,Default,,0,0,0,,Бүгінгі шаш үлгісі әдеттегіден өзгеше.
Dialogue: 0,0:05:56.70,0:05:58.37,Default,,0,0,0,,Бұл жақсы және балғын.
Dialogue: 0,0:05:58.70,0:06:00.87,Default,,0,0,0,,Әй, бірақ шаш үлгісі ше?
Dialogue: 0,0:06:00.91,0:06:04.46,Default,,0,0,0,,Мен Ичиго-чанның тік және ұзын шаш жасағанын қалаймын.
Dialogue: 0,0:06:04.66,0:06:05.37,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:06:06.42,0:06:09.34,Default,,0,0,0,,Бәрінің іздегені осы ғой.
Dialogue: 0,0:06:09.96,0:06:12.46,Default,,0,0,0,,Тұтынушының сұрауларына жауап бере алмау
Dialogue: 0,0:06:12.76,0:06:13.51,Default,,0,0,0,,Мен...
Dialogue: 0,0:06:14.17,0:06:14.97,Default,,0,0,0,,Мен...
Dialogue: 0,0:06:17.14,0:06:18.22,Default,,0,0,0,,Бұл сұмдық.
Dialogue: 0,0:06:20.10,0:06:22.56,Default,,0,0,0,,Кешіріңіз, мен қызып кеттім.
Dialogue: 0,0:06:37.11,0:06:38.16,Default,,0,0,0,,Ичиго-сан
Dialogue: 0,0:06:38.95,0:06:41.12,Default,,0,0,0,,Бұл мен бұрын айтқан ем.
Dialogue: 0,0:06:46.00,0:06:47.29,Default,,0,0,0,,Рахмет
Dialogue: 0,0:06:47.71,0:06:48.92,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:06:52.42,0:06:53.63,Default,,0,0,0,,Шетелдік өнімдер
Dialogue: 0,0:06:54.34,0:06:56.01,Default,,0,0,0,,Ағылшын тілі өте жақсы
Dialogue: 0,0:06:56.67,0:06:57.93,Default,,0,0,0,,Жақсы
Dialogue: 0,0:07:00.60,0:07:02.26,Default,,0,0,0,,Мен сенің оны қаншалықты жақсы басқара алатыныңды білгім келеді.
Dialogue: 0,0:07:05.27,0:07:07.14,Default,,0,0,0,,Жаңбыр қатты жауа бастаған сияқты
Dialogue: 0,0:07:08.48,0:07:10.48,Default,,0,0,0,,Жаңбыр аздап жауады.
Dialogue: 0,0:07:11.86,0:07:14.19,Default,,0,0,0,,Мен мектепте қолшатырымды ұмытып кетіппін.
Dialogue: 0,0:07:15.49,0:07:17.11,Default,,0,0,0,,Мен сені вокзалға түсіремін.
Dialogue: 0,0:07:18.20,0:07:19.07,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:07:19.32,0:07:20.32,Default,,0,0,0,,Бірлесіп күресу
Dialogue: 0,0:07:25.20,0:07:28.12,Default,,0,0,0,,Тіпті дүкен менеджері де аздап айта алады.
Dialogue: 0,0:07:29.39,0:07:30.29,Default,,0,0,0,,Иә.
Dialogue: 0,0:07:30.67,0:07:32.63,Default,,0,0,0,,Бүгін жаңа кітаптың шыққан күні.
Dialogue: 0,0:07:32.84,0:07:34.75,Default,,0,0,0,,Маған сатып алу бойынша жеңілдіктер жинау керек.
Dialogue: 0,0:07:42.14,0:07:43.43,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:07:45.64,0:07:48.52,Default,,0,0,0,,Ойынға берілгенім сонша, мен оны мүлде байқамай қалдым.
Dialogue: 0,0:07:50.06,0:07:51.06,Default,,0,0,0,,Бұл ойын...
Dialogue: 0,0:07:51.77,0:07:54.19,Default,,0,0,0,,Не, сіз iPass пайдаланасыз ба?
Dialogue: 0,0:07:54.61,0:07:57.07,Default,,0,0,0,,Менің жағдайым тез арада қалпына келеді.
Dialogue: 0,0:07:57.61,0:08:00.24,Default,,0,0,0,,Маған Мисаның деңгейін көтеру керек.
Dialogue: 0,0:08:04.41,0:08:05.28,Default,,0,0,0,,iPass
Dialogue: 0,0:08:12.29,0:08:14.38,Default,,0,0,0,,Барлығы үйіне қайтты ма?
Dialogue: 0,0:08:16.42,0:08:18.38,Default,,0,0,0,,Майканы вокзалға апара алғаныма сене алар емеспін.
Dialogue: 0,0:08:18.51,0:08:20.51,Default,,0,0,0,,Мен бүгін сенімен біргемін.
Dialogue: 0,0:08:20.68,0:08:22.93,Default,,0,0,0,,I My Me My My Mica
Dialogue: 0,0:08:29.93,0:08:30.85,Default,,0,0,0,,О, бұл көңілсіз.
Dialogue: 0,0:08:31.02,0:08:33.52,Default,,0,0,0,,Мен тағы бір қадаммен Эффлекорнға барар едім.
Dialogue: 0,0:08:34.86,0:08:37.65,Default,,0,0,0,,Сонымен, бөлме неге қараңғы?
Dialogue: 0,0:08:43.95,0:08:45.74,Default,,0,0,0,,Акидзуки-кун?
Dialogue: 0,0:08:46.08,0:08:49.20,Default,,0,0,0,,Жоғалтып алдым, байланып қалдым.
Dialogue: 0,0:08:49.95,0:08:52.21,Default,,0,0,0,,Акидзуки-кун да iPass пайдаланады.
Dialogue: 0,0:08:52.58,0:08:53.54,Default,,0,0,0,,Қашаннан бері
Dialogue: 0,0:08:53.58,0:08:54.17,Default,,0,0,0,,Деңгей
Dialogue: 0,0:08:54.29,0:08:55.38,Default,,0,0,0,,Қанша деңгей?
Dialogue: 0,0:08:56.42,0:08:58.55,Default,,0,0,0,,Деңгей 136.
Dialogue: 0,0:08:58.67,0:09:00.51,Default,,0,0,0,,Сіз көп нәрсені істеп жатырсыз.
Dialogue: 0,0:09:00.92,0:09:01.84,Default,,0,0,0,,Цукаса
Dialogue: 0,0:09:02.13,0:09:04.05,Default,,0,0,0,,Неге еденде отырдың?
Dialogue: 0,0:09:06.64,0:09:08.43,Default,,0,0,0,,Міне, стиль.
Dialogue: 0,0:09:08.43,0:09:09.72,Default,,0,0,0,,Мен одан шаршадым
Dialogue: 0,0:09:10.73,0:09:11.48,Default,,0,0,0,,Әкем білсе, бұл сөзсіз L-ге жетеді.
Dialogue: 0,0:09:11.68,0:09:13.98,Default,,0,0,0,,Өткен күні танымалдылық дауысына кімді қойдыңыз?
Dialogue: 0,0:09:16.69,0:09:17.73,Default,,0,0,0,,Миса-чан Ариса-чан
Dialogue: 0,0:09:20.07,0:09:22.32,Default,,0,0,0,,Жоқ, жоқ, бұл Миса Чан.
Dialogue: 0,0:09:23.32,0:09:26.45,Default,,0,0,0,,Миса-чан да сүйкімді, бірақ Ариса-чан қорқынышты.
Dialogue: 0,0:09:26.74,0:09:29.29,Default,,0,0,0,,Ариса-чан жаңадан қосылған.
Dialogue: 0,0:09:29.54,0:09:31.91,Default,,0,0,0,,Жаңадан келгендердің көңілдері сәл қалды.
Dialogue: 0,0:09:31.91,0:09:33.41,Default,,0,0,0,,Ардагерлердің үндеуі
Dialogue: 0,0:09:33.54,0:09:35.79,Default,,0,0,0,,Arisa's picture is stable.
Dialogue: 0,0:09:41.96,0:09:44.09,Default,,0,0,0,,Why is the room so dark?
Dialogue: 0,0:09:45.09,0:09:47.18,Default,,0,0,0,,Акидзуки-кун, мен мұны енді ғана түсіндім
Dialogue: 0,0:09:48.05,0:09:50.68,Default,,0,0,0,,While we were absorbed in the game
Dialogue: 0,0:09:50.77,0:09:52.18,Default,,0,0,0,,Оны біреу жойған сияқты
Dialogue: 0,0:09:52.35,0:09:55.02,Default,,0,0,0,,Please check carefully.
Dialogue: 0,0:09:57.56,0:09:59.90,Default,,0,0,0,,Бұл құлыптаулы.
Dialogue: 0,0:10:01.07,0:10:03.74,Default,,0,0,0,,The manager who locked the door
Dialogue: 0,0:10:03.90,0:10:05.91,Default,,0,0,0,,Lie Are you locked up?
Dialogue: 0,0:10:06.11,0:10:08.37,Default,,0,0,0,,No, he's probably still at the store.
Dialogue: 0,0:10:08.87,0:10:11.12,Default,,0,0,0,,Сәлем менеджер
Dialogue: 0,0:10:15.16,0:10:16.71,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:10:16.87,0:10:18.25,Default,,0,0,0,,Иә, терезе
Dialogue: 0,0:10:21.88,0:10:23.30,Default,,0,0,0,,Бұл болды
Dialogue: 0,0:10:23.51,0:10:25.88,Default,,0,0,0,,I'll call the store manager.
Dialogue: 0,0:10:25.97,0:10:27.80,Default,,0,0,0,,Please call someone else.
Dialogue: 0,0:10:35.94,0:10:39.19,Default,,0,0,0,,Shit, the store manager doesn't appear at all.
Dialogue: 0,0:10:39.65,0:10:42.02,Default,,0,0,0,,Hey, did anyone show up over there?
Dialogue: 0,0:10:42.65,0:10:44.61,Default,,0,0,0,,Haven't played it yet
Dialogue: 0,0:10:44.61,0:10:45.44,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:10:46.28,0:10:47.86,Default,,0,0,0,,Қуатты тұтыну шегі
Dialogue: 0,0:10:47.91,0:10:51.08,Default,,0,0,0,,I thought I couldn't play games if I used it on my phone because the battery was low.
Dialogue: 0,0:10:51.74,0:10:55.16,Default,,0,0,0,,I can't move my hands. Не істеуім керек?
Dialogue: 0,0:10:56.08,0:10:57.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:11:01.96,0:11:03.55,Default,,0,0,0,,What, a power outage?
Dialogue: 0,0:11:24.40,0:11:25.40,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:11:26.32,0:11:29.45,Default,,0,0,0,,I hear there are quite a few restaurants.
Dialogue: 0,0:11:32.33,0:11:35.58,Default,,0,0,0,,Why are you talking like that at this timing?
Dialogue: 0,0:11:36.45,0:11:37.41,Default,,0,0,0,,Нашар
Dialogue: 0,0:11:37.50,0:11:38.62,Default,,0,0,0,,Жаза ретінде
Dialogue: 0,0:11:38.83,0:11:40.04,Default,,0,0,0,,Lend me your arm for a moment
Dialogue: 0,0:11:54.43,0:11:55.51,Default,,0,0,0,,Ойланып көрейікші
Dialogue: 0,0:11:56.31,0:11:59.06,Default,,0,0,0,,Ойын осылай өрбіді.
Dialogue: 0,0:12:00.14,0:12:03.15,Default,,0,0,0,,It was a Yuri manga I read recently.
Dialogue: 0,0:12:03.56,0:12:04.61,Default,,0,0,0,,Although we are both women
Dialogue: 0,0:12:13.95,0:12:16.04,Default,,0,0,0,,I'm going to a new book meeting today.
Dialogue: 0,0:12:16.04,0:12:17.37,Default,,0,0,0,,Кітап дүкені жабылады
Dialogue: 0,0:12:17.37,0:12:20.12,Default,,0,0,0,,There's also a game broadcast that I want to watch today.
Dialogue: 0,0:12:20.41,0:12:22.25,Default,,0,0,0,,Оны ашыңыз.
Dialogue: 0,0:12:22.25,0:12:24.21,Default,,0,0,0,,Ашық
Dialogue: 0,0:12:40.10,0:12:41.60,Default,,0,0,0,,Онда біреу бар ма?
Dialogue: 0,0:12:45.80,0:12:46.85,Default,,0,0,0,,Менеджер
Dialogue: 0,0:12:47.02,0:12:48.57,Default,,0,0,0,,If you can't get a new book
Dialogue: 0,0:12:48.65,0:12:51.15,Default,,0,0,0,,I'll dig up your figure to compensate for your sadness.
Dialogue: 0,0:12:51.32,0:12:52.66,Default,,0,0,0,,The store manager is an idiot!
Dialogue: 0,0:12:52.74,0:12:54.32,Default,,0,0,0,,For every minute the broadcast is delayed.
Dialogue: 0,0:12:54.32,0:12:56.87,Default,,0,0,0,,Because the store manager's figure will be hit eight times.
Dialogue: 0,0:13:01.71,0:13:03.58,Default,,0,0,0,,Мен...Мен шынымен түсінбеймін.
Dialogue: 0,0:13:03.83,0:13:06.00,Default,,0,0,0,,Should I hide the figure?
Dialogue: 0,0:13:13.68,0:13:15.80,Default,,0,0,0,,That Sakuranomiya is
Dialogue: 0,0:13:16.35,0:13:18.39,Default,,0,0,0,,I'm off today because I have a cold.
Dialogue: 0,0:13:20.27,0:13:21.81,Default,,0,0,0,,Бұл менің кінәм
Dialogue: 0,0:13:22.77,0:13:23.77,Default,,0,0,0,,Не болды?
Dialogue: 0,0:13:24.35,0:13:29.02,Default,,0,0,0,,Сіз кеше Ичиго-чанды жаңбырда вокзалға апардыңыз, солай емес пе, менеджер?
Dialogue: 0,0:13:30.07,0:13:32.57,Default,,0,0,0,,Ичика-чан, біз вокзалдан үйге келдік
Dialogue: 0,0:13:32.61,0:13:34.70,Default,,0,0,0,,Looks like I went home soaked in the rain.
Dialogue: 0,0:13:34.95,0:13:37.16,Default,,0,0,0,,So you caught a cold?
Dialogue: 0,0:13:37.32,0:13:39.87,Default,,0,0,0,,If I had given you an umbrella
Dialogue: 0,0:13:39.91,0:13:42.25,Default,,0,0,0,,If I had given it to you...
Dialogue: 0,0:13:44.37,0:13:47.29,Default,,0,0,0,,Ендеше біз ертең мектептен үйге қайтамыз.
Dialogue: 0,0:13:47.29,0:13:48.54,Default,,0,0,0,,I'm going to visit you.
Dialogue: 0,0:13:48.71,0:13:50.00,Default,,0,0,0,,Кахо Ши
Dialogue: 0,0:13:51.55,0:13:53.17,Default,,0,0,0,,Мен де барамын
Dialogue: 0,0:13:53.88,0:13:55.22,Default,,0,0,0,,А, қазірдің өзінде
Dialogue: 0,0:14:00.60,0:14:04.69,Default,,0,0,0,,Ичиго-чанчи Жапон стиліндегі архитектура деп естідім.
Dialogue: 0,0:14:04.81,0:14:06.94,Default,,0,0,0,,You have an amazing aura.
Dialogue: 0,0:14:07.44,0:14:09.06,Default,,0,0,0,,Can't see the house at the gate
Dialogue: 0,0:14:09.57,0:14:11.73,Default,,0,0,0,,Кахо, қоңырауды тез соғыңыз.
Dialogue: 0,0:14:12.19,0:14:16.07,Default,,0,0,0,,Айтпақшы, Мафую-сан, домофон жоқ.
Dialogue: 0,0:14:16.28,0:14:18.28,Default,,0,0,0,,Can you hear me knocking?
Dialogue: 0,0:14:18.82,0:14:21.08,Default,,0,0,0,,There's no such thing as not having one, right?
Dialogue: 0,0:14:21.20,0:14:22.20,Default,,0,0,0,,Осы жерде
Dialogue: 0,0:14:22.79,0:14:24.16,Default,,0,0,0,,Probably around here
Dialogue: 0,0:14:24.41,0:14:25.75,Default,,0,0,0,,Сізден бір нәрсе сұрасам…
Dialogue: 0,0:14:29.13,0:14:30.59,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:14:34.09,0:14:35.59,Default,,0,0,0,,Мазалағаным үшін кешіріңіз.
Dialogue: 0,0:14:35.84,0:14:38.64,Default,,0,0,0,,Don't do anything weird, manager.
Dialogue: 0,0:14:38.80,0:14:40.51,Default,,0,0,0,,Бұл таңқаларлық емес.
Dialogue: 0,0:14:40.60,0:14:42.64,Default,,0,0,0,,I was just looking for the intercom.
Dialogue: 0,0:14:44.89,0:14:46.85,Default,,0,0,0,,Онда біреу бар ма?
Dialogue: 0,0:14:49.19,0:14:49.86,Default,,0,0,0,,О, бұл
Dialogue: 0,0:14:50.11,0:14:53.11,Default,,0,0,0,,We are Ichigo-san's friends at her part-time job.
Dialogue: 0,0:14:53.44,0:14:54.74,Default,,0,0,0,,Visiting you today
Dialogue: 0,0:15:01.33,0:15:02.24,Default,,0,0,0,,Құлпынай хош иісі
Dialogue: 0,0:15:02.95,0:15:04.79,Default,,0,0,0,,Ichigoka has a friend
Dialogue: 0,0:15:05.20,0:15:06.50,Default,,0,0,0,,Бұл
Dialogue: 0,0:15:09.25,0:15:10.96,Default,,0,0,0,,Today is for my sister
Dialogue: 0,0:15:11.13,0:15:12.80,Default,,0,0,0,,Thank you for going out of your way.
Dialogue: 0,0:15:13.34,0:15:16.88,Default,,0,0,0,,Менің атым Айка, Ичигоканың үлкен әпкесі.
Dialogue: 0,0:15:17.59,0:15:20.01,Default,,0,0,0,,Үздіксіз қолдау көрсеткеніңіз үшін рахмет.
Dialogue: 0,0:15:21.30,0:15:22.89,Default,,0,0,0,,Осы жерді басыңыз.
Dialogue: 0,0:15:25.06,0:15:26.06,Default,,0,0,0,,О, менеджер?
Dialogue: 0,0:15:26.48,0:15:29.77,Default,,0,0,0,,Ичиго-санның әпкесі күткендей.
Dialogue: 0,0:15:30.77,0:15:33.15,Default,,0,0,0,,Black hair kimono perfect
Dialogue: 0,0:15:33.27,0:15:34.94,Default,,0,0,0,,Бұл аспан
Dialogue: 0,0:15:35.32,0:15:36.40,Default,,0,0,0,,Менеджер
Dialogue: 0,0:15:36.57,0:15:38.36,Default,,0,0,0,,It's someone's house today.
Dialogue: 0,0:15:38.49,0:15:39.61,Default,,0,0,0,,Тынышталыңыз.
Dialogue: 0,0:15:42.41,0:15:43.28,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:15:44.03,0:15:46.50,Default,,0,0,0,,Сәлем? Сіз тұтынушысыз ба?
Dialogue: 0,0:15:47.25,0:15:49.62,Default,,0,0,0,,Koichi-san, please listen.
Dialogue: 0,0:15:50.08,0:15:53.09,Default,,0,0,0,,This is Ichigoka's friends.
Dialogue: 0,0:15:59.80,0:16:00.51,Default,,0,0,0,,Құлпынай хош иісі
Dialogue: 0,0:16:00.93,0:16:02.60,Default,,0,0,0,,Ichigoka has a friend
Dialogue: 0,0:16:03.64,0:16:04.68,Default,,0,0,0,,Сондай-ақ
Dialogue: 0,0:16:08.48,0:16:11.40,Default,,0,0,0,,I am Ichigoka's older brother Koichi.
Dialogue: 0,0:16:12.02,0:16:13.31,Default,,0,0,0,,Today is for my sister
Dialogue: 0,0:16:13.73,0:16:15.11,Default,,0,0,0,,Рахмет
Dialogue: 0,0:16:15.61,0:16:18.24,Default,,0,0,0,,No, don't worry about that.
Dialogue: 0,0:16:18.94,0:16:20.11,Default,,0,0,0,,Follow your sister
Dialogue: 0,0:16:20.11,0:16:22.07,Default,,0,0,0,,The older brother also has black hair.
Dialogue: 0,0:16:23.78,0:16:26.33,Default,,0,0,0,,Manager: Don't get too excited.
Dialogue: 0,0:16:26.62,0:16:27.66,Default,,0,0,0,,Тынышталыңыз.
Dialogue: 0,0:16:28.87,0:16:30.12,Default,,0,0,0,,Реакция жоқ
Dialogue: 0,0:16:30.46,0:16:32.42,Default,,0,0,0,,Ей, адал адам.
Dialogue: 0,0:16:33.46,0:16:35.59,Default,,0,0,0,,Please take care of my sister.
Dialogue: 0,0:16:42.43,0:16:44.68,Default,,0,0,0,,Ichigoka Are you awake?
Dialogue: 0,0:16:45.26,0:16:47.14,Default,,0,0,0,,A friend came over.
Dialogue: 0,0:16:52.90,0:16:53.65,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:16:54.31,0:16:57.11,Default,,0,0,0,,Рика-сан
Dialogue: 0,0:16:58.23,0:16:59.61,Default,,0,0,0,,Тек L өз ықпалындағы біреумен алмастырылған
Dialogue: 0,0:17:01.03,0:17:04.49,Default,,0,0,0,,Yes, I feel much better now.
Dialogue: 0,0:17:04.74,0:17:08.08,Default,,0,0,0,,Don't go to the manager anymore.
Dialogue: 0,0:17:09.70,0:17:10.70,Default,,0,0,0,,Сіз жақсы көрінесіз.
Dialogue: 0,0:17:11.33,0:17:13.29,Default,,0,0,0,,Kaho-san Mafuyu-san
Dialogue: 0,0:17:14.96,0:17:17.34,Default,,0,0,0,,Sorry to bother everyone.
Dialogue: 0,0:17:17.84,0:17:20.67,Default,,0,0,0,,No, no, I'm the one who barged in.
Dialogue: 0,0:17:20.92,0:17:22.51,Default,,0,0,0,,By the way, Mr. Manager
Dialogue: 0,0:17:22.97,0:17:25.80,Default,,0,0,0,,Өткен күні емделгеніңіз үшін рахмет.
Dialogue: 0,0:17:26.60,0:17:29.68,Default,,0,0,0,,Қолдану әдісі, шикізат, өндіру орны
Dialogue: 0,0:17:30.39,0:17:33.19,Default,,0,0,0,,Мен бәрін сөздіктен қарап шықтым, енді
Dialogue: 0,0:17:33.98,0:17:35.73,Default,,0,0,0,,It is placed on the altar.
Dialogue: 0,0:17:37.65,0:17:40.15,Default,,0,0,0,,Um, please use it.
Dialogue: 0,0:17:41.03,0:17:43.90,Default,,0,0,0,,But I'm glad Rinka-san seems okay.
Dialogue: 0,0:17:43.95,0:17:47.20,Default,,0,0,0,,Дұрыс, дүкен меңгерушісі қиындыққа тап болды.
Dialogue: 0,0:17:47.37,0:17:49.03,Default,,0,0,0,,It's become extremely annoying.
Dialogue: 0,0:17:49.62,0:17:51.54,Default,,0,0,0,,Не болды?
Dialogue: 0,0:17:53.00,0:17:53.83,Default,,0,0,0,,А, мен бақыттымын.
Dialogue: 0,0:17:54.21,0:17:57.71,Default,,0,0,0,,Көзі нашар Ичигоканың достасатынына сене алар емеспін.
Dialogue: 0,0:17:58.38,0:17:59.71,Default,,0,0,0,,Секихан бүгін түнде.
Dialogue: 0,0:18:00.38,0:18:02.21,Default,,0,0,0,,Ең маңыздысы - бұл
Dialogue: 0,0:18:06.18,0:18:06.76,Default,,0,0,0,,оны міндетті түрде өлтіргісі келер еді.
Dialogue: 0,0:18:07.34,0:18:08.18,Default,,0,0,0,,Жігітім?
Dialogue: 0,0:18:08.85,0:18:10.81,Default,,0,0,0,,Олай болса, мені тыңда, Ичиго-чан.
Dialogue: 0,0:18:10.81,0:18:11.72,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:18:13.18,0:18:15.73,Default,,0,0,0,,Шай ішкіңіз келе ме?
Dialogue: 0,0:18:16.02,0:18:16.98,Default,,0,0,0,,Үлкен апа
Dialogue: 0,0:18:17.65,0:18:19.27,Default,,0,0,0,,Саса, шай ішіп алшы.
Dialogue: 0,0:18:20.23,0:18:21.78,Default,,0,0,0,,Мазалағаным үшін кешіріңіз
Dialogue: 0,0:18:22.28,0:18:23.65,Default,,0,0,0,,Өйткені сіз шетелдіксіз
Dialogue: 0,0:18:23.86,0:18:26.91,Default,,0,0,0,,Біз керемет жапон шайларын дайындадық.
Dialogue: 0,0:18:27.57,0:18:28.87,Default,,0,0,0,,Рахмет
Dialogue: 0,0:18:29.87,0:18:33.87,Default,,0,0,0,,Сенча, Гиокуро, Матча, Генмайча
Dialogue: 0,0:18:37.17,0:18:39.08,Default,,0,0,0,,Нені дайындау үшін қиындық көрдіңіз
Dialogue: 0,0:18:39.79,0:18:41.80,Default,,0,0,0,,Осының бәрін ішпесең дөрекі болар еді.
Dialogue: 0,0:18:45.51,0:18:46.26,Default,,0,0,0,,Акчичи
Dialogue: 0,0:18:47.43,0:18:49.51,Default,,0,0,0,,Тамақ бергеніңіз үшін рахмет.
Dialogue: 0,0:18:52.18,0:18:53.72,Default,,0,0,0,,Өте дәмді болды.
Dialogue: 0,0:18:54.14,0:18:56.60,Default,,0,0,0,,Құлпынай иісінен күткендей...
Dialogue: 0,0:18:56.98,0:18:59.02,Default,,0,0,0,,Жоқ, сіз шетелдіксіз.
Dialogue: 0,0:18:59.48,0:19:01.77,Default,,0,0,0,,Сіздің соншалықты бақытты екеніңізге сене алар емеспін.
Dialogue: 0,0:19:02.61,0:19:04.07,Default,,0,0,0,,Тағы да бар!
Dialogue: 0,0:19:04.53,0:19:06.36,Default,,0,0,0,,Жабық шай, тәтті шай, ямрёку шай
Dialogue: 0,0:19:06.36,0:19:09.49,Default,,0,0,0,,Кукича, Ходжича, Панча, Меча, Терең буланған Сенча
Dialogue: 0,0:19:09.74,0:19:10.57,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:19:11.78,0:19:13.08,Default,,0,0,0,,Садистік
Dialogue: 0,0:19:14.87,0:19:17.41,Default,,0,0,0,,Жүр, бұл жапон тәттілері.
Dialogue: 0,0:19:17.87,0:19:18.71,Default,,0,0,0,,Аға
Dialogue: 0,0:19:19.37,0:19:23.09,Default,,0,0,0,,Біз шетелдік жеңіл тағамдарға ұқсас күріш крекерін дайындадық.
Dialogue: 0,0:19:23.75,0:19:25.55,Default,,0,0,0,,Келіңдер, келіңдер.
Dialogue: 0,0:19:26.72,0:19:28.43,Default,,0,0,0,,Ой, мына қызыл бұршақ пастасы дәмді екен.
Dialogue: 0,0:19:28.43,0:19:30.01,Default,,0,0,0,,Сакурамоти дәмді
Dialogue: 0,0:19:30.34,0:19:31.97,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:19:36.89,0:19:37.64,Default,,0,0,0,,қиын
Dialogue: 0,0:19:38.10,0:19:40.02,Default,,0,0,0,,қатты қатты
Dialogue: 0,0:19:40.31,0:19:42.48,Default,,0,0,0,,Сенің қуанғаныңа сене алар емеспін, жылап жібердім
Dialogue: 0,0:19:43.19,0:19:46.11,Default,,0,0,0,,Тағы да бар, сондықтан сұраудан тартынбаңыз.
Dialogue: 0,0:19:47.40,0:19:48.24,Default,,0,0,0,,Садистік
Dialogue: 0,0:19:50.36,0:19:51.28,Default,,0,0,0,,Айтпақшы
Dialogue: 0,0:19:52.57,0:19:55.31,Default,,0,0,0,,Ичигоканы қай айда, қай күні кездестірдіңіз?
Dialogue: 0,0:19:55.37,0:19:55.75,Default,,0,0,0,,Жақсы
Dialogue: 0,0:19:56.45,0:19:56.80,Default,,0,0,0,,сәуір…
Dialogue: 0,0:19:56.82,0:19:57.46,Default,,0,0,0,,Сіздің уақытыңыз қанша?
Dialogue: 0,0:19:57.75,0:20:00.12,Default,,0,0,0,,Сол аға мен апа
Dialogue: 0,0:20:00.46,0:20:02.00,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:20:02.25,0:20:03.50,Default,,0,0,0,,Өзіңізді қалай сезіндіңіз?
Dialogue: 0,0:20:03.71,0:20:05.13,Default,,0,0,0,,Ол кезде не кию керек
Dialogue: 0,0:20:05.30,0:20:07.42,Default,,0,0,0,,Келіңіздер, жауап беріңіздерші.
Dialogue: 0,0:20:09.17,0:20:10.34,Default,,0,0,0,,Бірінші сөз
Dialogue: 0,0:20:12.97,0:20:15.18,Default,,0,0,0,,Және... жауап алу...
Dialogue: 0,0:20:16.60,0:20:18.52,Default,,0,0,0,,Бұл таңқаларлық.
Dialogue: 0,0:20:27.11,0:20:29.11,Default,,0,0,0,,Менен көп сұрадың.
Dialogue: 0,0:20:29.24,0:20:32.24,Default,,0,0,0,,Рено мырзаның мәліметі де тамаша.
Dialogue: 0,0:20:32.66,0:20:36.08,Default,,0,0,0,,Біз осы ақпаратқа сүйене отырып, қонақжайлық танытуымыз керек.
Dialogue: 0,0:20:36.37,0:20:38.41,Default,,0,0,0,,Иә, сізге ұнайды деп үміттенемін.
Dialogue: 0,0:20:38.58,0:20:43.04,Default,,0,0,0,,Сіз Ичигокамен отбасы мүшесі ретінде ұзақ мерзімді қарым-қатынаста боласыз деп үміттенеміз.
Dialogue: 0,0:20:43.67,0:20:46.13,Default,,0,0,0,,Үлкен аға, үлкен әпке
Dialogue: 0,0:20:47.38,0:20:49.42,Default,,0,0,0,,Сіз келе жатқан қиындықты көтердіңіз.
Dialogue: 0,0:20:49.84,0:20:51.93,Default,,0,0,0,,Қиындық тудырмаңыз
Dialogue: 0,0:20:52.34,0:20:55.47,Default,,0,0,0,,Жоқ, бұл дұрыс емес. Бұл тітіркендіргіш.
Dialogue: 0,0:20:55.72,0:20:58.64,Default,,0,0,0,,Біз құлпынай хош иісті заттарға қонақжайлылық ұсынамыз.
Dialogue: 0,0:20:58.97,0:21:01.81,Default,,0,0,0,,Егер сіз тағы да қиындық тудырсаңыз
Dialogue: 0,0:21:02.23,0:21:04.10,Default,,0,0,0,,Желді екеуіңе аударыңдар
Dialogue: 0,0:21:04.23,0:21:08.82,Default,,0,0,0,,Мен сендерге тек ыстық шай мен қатты күріш крекерін беремін.
Dialogue: 0,0:21:11.11,0:21:13.49,Default,,0,0,0,,Сіз бәрін асыра сілтеп жатқаныңызды түсінбейсіз бе?
Dialogue: 0,0:21:13.53,0:21:15.82,Default,,0,0,0,,Екеуің тәубе етпейінше, күріш пен шәй жей береміз.
Dialogue: 0,0:21:15.91,0:21:17.37,Default,,0,0,0,,Түсіндің бе? Мен сені ести алмаймын.
Dialogue: 0,0:21:17.83,0:21:20.83,Default,,0,0,0,,Түпнұсқа көйлек сөзсіз басқаша.
Dialogue: 0,0:21:23.04,0:21:25.88,Default,,0,0,0,,Кешір мені, Құлпынай
Dialogue: 0,0:22:56.63,0:23:00.39,Default,,0,0,0,,Менеджер, өткен күні бізге келгеніңіз үшін рахмет.
Dialogue: 0,0:23:00.89,0:23:02.68,Default,,0,0,0,,Мен де өзімді жақсы сезінемін
Dialogue: 0,0:23:03.06,0:23:05.48,Default,,0,0,0,,Емдеу де өте жақсы болды.
Dialogue: 0,0:23:06.94,0:23:08.35,Default,,0,0,0,,О, бұл жақсы болды.
Dialogue: 0,0:23:08.65,0:23:14.44,Default,,0,0,0,,Қазір ойлап қарасам, бұрын дүкен меңгерушісімен тізе қосып отырғанда, маған жақсы иіс келді.
Dialogue: 0,0:23:14.82,0:23:16.57,Default,,0,0,0,,Бұл хош иіс болды.
Dialogue: 0,0:23:17.65,0:23:20.12,Default,,0,0,0,,Мен бұл иісті жақсы көремін
Dialogue: 0,0:23:20.53,0:23:23.91,Default,,0,0,0,,Менде де дүкен менеджерінің иісі бар.
Dialogue: 0,0:23:27.54,0:23:30.21,Default,,0,0,0,,...
Dialogue: 0,0:23:31.92,0:23:33.96,Default,,0,0,0,,Менеджер!
Dialogue: 0,0:23:36.80,0:23:37.38,Default,,0,0,0,,Келесі жолы
Dialogue: 0,0:23:37.97,0:23:39.76,Default,,0,0,0,,Су жағасына қатысты т.б
Dialogue: 0,0:23:41.26,0:23:47.26,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory