Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.12,0:00:01.92,Default,,0,0,0,,Мафую мырза
Dialogue: 0,0:00:02.71,0:00:04.13,Default,,0,0,0,,Өтінемін, менімен бірге жүріңіз!
Dialogue: 0,0:00:07.26,0:00:08.55,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:00:08.92,0:00:11.18,Default,,0,0,0,,Бұл сөйлесу қолданбасындағы менің тіркелгім
Dialogue: 0,0:00:11.55,0:00:12.55,Default,,0,0,0,,Қарсы болмасаңыз...
Dialogue: 0,0:00:12.93,0:00:15.35,Default,,0,0,0,,Не? Сөйлесу қолданбасы?
Dialogue: 0,0:00:15.97,0:00:20.60,Default,,0,0,0,,Мафую, анаң саған әлі ұялы телефон берген жоқ...
Dialogue: 0,0:00:21.23,0:00:22.90,Default,,0,0,0,,Мен білмеймін!
Dialogue: 0,0:00:25.65,0:00:27.03,Default,,0,0,0,,Қош бол!
Dialogue: 0,0:00:28.11,0:00:30.11,Default,,0,0,0,,Тағы кел!
Dialogue: 0,0:02:13.85,0:02:15.06,Default,,0,0,0,,Мафую мырза
Dialogue: 0,0:02:16.64,0:02:18.52,Default,,0,0,0,,Барынша қатты сермедің.
Dialogue: 0,0:02:19.19,0:02:22.53,Default,,0,0,0,,Әрине, мұндай нәрсе жаман.
Dialogue: 0,0:02:24.07,0:02:25.40,Default,,0,0,0,,О, сіз тұтынушысыз ба?
Dialogue: 0,0:02:25.74,0:02:27.41,Default,,0,0,0,,Бұл бұрынғы мәселе.
Dialogue: 0,0:02:28.11,0:02:31.03,Default,,0,0,0,,Егер мойындауға шын ниетіңіз болса, сөйлесу қолданбасын пайдаланбаңыз.
Dialogue: 0,0:02:31.33,0:02:34.79,Default,,0,0,0,,Маған ұялы телефоныңыз бен мекен-жайыңызды әкеліңіз деді.
Dialogue: 0,0:02:35.62,0:02:36.50,Default,,0,0,0,,Бар ма?
Dialogue: 0,0:02:36.79,0:02:39.67,Default,,0,0,0,,Бірақ ол өте ұзын болатын.
Dialogue: 0,0:02:39.88,0:02:41.75,Default,,0,0,0,,Мен оны сағындым.
Dialogue: 0,0:02:42.80,0:02:45.67,Default,,0,0,0,,Мафую-санды сол адамның қасында көру қызық болар еді.
Dialogue: 0,0:02:45.88,0:02:47.97,Default,,0,0,0,,Өтінемін, мені адамдармен мазақ етпе.
Dialogue: 0,0:02:48.26,0:02:49.64,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:02:50.05,0:02:53.14,Default,,0,0,0,,Бойлары айырмашылығы бар жұп - мое. Мо
Dialogue: 0,0:02:53.93,0:02:55.06,Default,,0,0,0,,Қол ұстасақ немесе бірдеңе
Dialogue: 0,0:02:58.69,0:03:00.61,Default,,0,0,0,,Адамдар туралы оғаш нәрселерді елестетпеңіз
Dialogue: 0,0:03:04.03,0:03:05.82,Default,,0,0,0,,Хошикава Кокурэ болды ма?
Dialogue: 0,0:03:06.11,0:03:08.53,Default,,0,0,0,,Дұрыс, Мафуйю-сан танымал.
Dialogue: 0,0:03:11.95,0:03:15.87,Default,,0,0,0,,Сіз шошқалар үшін кішкентай лолисің бе?
Dialogue: 0,0:03:17.50,0:03:20.00,Default,,0,0,0,,Бірақ Хошикаваның қасында
Dialogue: 0,0:03:20.00,0:03:23.04,Default,,0,0,0,,Қарапайым адамдар ата-ана мен бала немесе аға болады.
Dialogue: 0,0:03:24.88,0:03:28.26,Default,,0,0,0,,Менің ойымша, бұл туралы уайымдаудың қажеті жоқ.
Dialogue: 0,0:03:28.34,0:03:32.47,Default,,0,0,0,,Бірақ биіктікте үлкен айырмашылық болса, ыңғайсыз болмай ма?
Dialogue: 0,0:03:32.55,0:03:35.89,Default,,0,0,0,,Әй, кейде мұны істеу қиын.
Dialogue: 0,0:03:36.27,0:03:37.39,Default,,0,0,0,,Мысалы,...
Dialogue: 0,0:03:38.56,0:03:40.48,Default,,0,0,0,,Артық ештеңе айтпа
Dialogue: 0,0:03:42.98,0:03:44.44,Default,,0,0,0,,Бұл ештеңе емес.
Dialogue: 0,0:03:48.19,0:03:48.40,Default,,0,0,0,,Se...
Dialogue: 0,0:03:52.78,0:03:55.49,Default,,0,0,0,,Көпшілік мені дүкеннен ғана таниды.
Dialogue: 0,0:03:55.66,0:03:57.79,Default,,0,0,0,,Мойындау дұрыс емес.
Dialogue: 0,0:03:58.58,0:04:00.79,Default,,0,0,0,,Лоликон, бәрібір лоликон
Dialogue: 0,0:04:02.08,0:04:04.71,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:04:05.04,0:04:07.30,Default,,0,0,0,,Ал, мені дүкенде көргеннен кейін.
Dialogue: 0,0:04:07.63,0:04:10.30,Default,,0,0,0,,Мені көргеннен кейін менімен кездескіңіз келе ме?
Dialogue: 0,0:04:12.80,0:04:14.47,Default,,0,0,0,,Маған жазылуыңызды өтінемін
Dialogue: 0,0:04:15.56,0:04:18.10,Default,,0,0,0,,Жоқ, міндетті түрде олқылық бар.
Dialogue: 0,0:04:18.14,0:04:20.44,Default,,0,0,0,,Мафую-сан тым бағынышты.
Dialogue: 0,0:04:20.60,0:04:23.48,Default,,0,0,0,,Жоқ, мен тек шындықты айтып тұрмын.
Dialogue: 0,0:04:23.86,0:04:27.53,Default,,0,0,0,,Мафуйю-сан, махаббат болғанша, сақтық қажет емес.
Dialogue: 0,0:04:27.90,0:04:30.03,Default,,0,0,0,,Сондықтан маған бәрібір
Dialogue: 0,0:04:30.53,0:04:33.49,Default,,0,0,0,,Кәне, бүгін де жұмысты қызық өткізейік.
Dialogue: 0,0:04:34.24,0:04:38.75,Default,,0,0,0,,Дұрыс, биіктік айырмашылығын ескерген дұрыс болар.
Dialogue: 0,0:04:39.45,0:04:45.25,Default,,0,0,0,,Неліктен ең биік дүкен менеджерімен модельдеуді көрмеске?
Dialogue: 0,0:04:45.63,0:04:46.38,Default,,0,0,0,,Мен?
Dialogue: 0,0:04:47.25,0:04:47.88,Default,,0,0,0,,Таныстырулар!
Dialogue: 0,0:04:48.25,0:04:49.34,Default,,0,0,0,,Бұл не
Dialogue: 0,0:04:50.51,0:04:52.72,Default,,0,0,0,,Міне, осылай болды.
Dialogue: 0,0:04:52.80,0:04:54.18,Default,,0,0,0,,Солай болды ма?
Dialogue: 0,0:04:54.51,0:04:56.97,Default,,0,0,0,,Ал, оны маған қалдырыңыз.
Dialogue: 0,0:04:58.01,0:05:00.56,Default,,0,0,0,,Ұзын бой – мырзаның мәртебесі
Dialogue: 0,0:05:00.68,0:05:03.35,Default,,0,0,0,,Мен Мафую-санға да түсіндіремін.
Dialogue: 0,0:05:08.40,0:05:11.65,Default,,0,0,0,,Тіпті тізе бүгіп, ханымның көзіне түспеңіз.
Dialogue: 0,0:05:11.90,0:05:13.24,Default,,0,0,0,,Қандай мырза
Dialogue: 0,0:05:13.57,0:05:14.57,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:05:15.11,0:05:18.20,Default,,0,0,0,,Дүкен меңгерушісі қызды тастағыңыз келсе, Кабедон сол.
Dialogue: 0,0:05:18.49,0:05:22.73,Default,,0,0,0,,Кәне, мен не істей алатынымды көрсетейін.
Dialogue: 0,0:05:30.96,0:05:31.63,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:05:32.05,0:05:35.76,Default,,0,0,0,,Мен мұндай қайғылы Кабедонды бірінші рет көруім.
Dialogue: 0,0:05:44.06,0:05:47.48,Default,,0,0,0,,Әпкеңнің жігіті жоқ па?
Dialogue: 0,0:05:49.11,0:05:49.86,Default,,0,0,0,,Не? Неліктен?
Dialogue: 0,0:05:50.32,0:05:54.15,Default,,0,0,0,,Жоқ, мен үнемі толық емес жұмыс күнімен жұмыс істеймін және үйге көмектесемін.
Dialogue: 0,0:05:56.07,0:05:57.49,Default,,0,0,0,,Қажет емес
Dialogue: 0,0:05:57.78,0:06:00.66,Default,,0,0,0,,Жігіт алсаң, бос уақытың кетеді.
Dialogue: 0,0:06:01.49,0:06:02.58,Default,,0,0,0,,Бос уақыт?
Dialogue: 0,0:06:03.29,0:06:05.29,Default,,0,0,0,,Келіңіздер, бұл кездесу.
Dialogue: 0,0:06:06.58,0:06:09.38,Default,,0,0,0,,Нақты уақытта балалар анимелерін көре алмайсыз.
Dialogue: 0,0:06:10.25,0:06:11.59,Default,,0,0,0,,Иә
Dialogue: 0,0:06:20.05,0:06:22.22,Default,,0,0,0,,Менің толық емес жұмыс уақытыма дейін уақытым бар.
Dialogue: 0,0:06:29.36,0:06:31.27,Default,,0,0,0,,Бұл қызықты.
Dialogue: 0,0:06:55.17,0:06:58.13,Default,,0,0,0,,Сондай-ақ аркадада галерея жинауға болады.
Dialogue: 0,0:06:59.80,0:07:03.26,Default,,0,0,0,,Мен мұны стрессті жеңілдету үшін жасадым, бірақ ол қызып кетті.
Dialogue: 0,0:07:04.52,0:07:05.27,Default,,0,0,0,,Не керек, Крюгер мырза?
Dialogue: 0,0:07:06.48,0:07:08.52,Default,,0,0,0,,Сіз стрессті сезінесіз бе?
Dialogue: 0,0:07:08.98,0:07:10.86,Default,,0,0,0,,Эй, Мафую-сан қорқынышты.
Dialogue: 0,0:07:10.86,0:07:11.81,Default,,0,0,0,,Жай әзіл.
Dialogue: 0,0:07:12.73,0:07:14.69,Default,,0,0,0,,Бірақ олай емес сияқты.
Dialogue: 0,0:07:15.19,0:07:16.15,Default,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,0:07:19.86,0:07:20.91,Default,,0,0,0,,Шынында…
Dialogue: 0,0:07:22.83,0:07:25.62,Default,,0,0,0,,Мен сынақтан қызыл баға алдым, сондықтан қосымша емтихан тапсыруым керек.
Dialogue: 0,0:07:29.79,0:07:32.17,Default,,0,0,0,,Сіз кенеттен не істеп жатырсыз, Мафую-сан?
Dialogue: 0,0:07:32.63,0:07:36.09,Default,,0,0,0,,Онда ойын ойнайтын уақыт емес, солай ма?
Dialogue: 0,0:07:36.42,0:07:40.05,Default,,0,0,0,,Бұл рас, бірақ Мафую-сан қорқынышты.
Dialogue: 0,0:07:40.05,0:07:41.64,Default,,0,0,0,,Оның несі жаман?
Dialogue: 0,0:07:44.18,0:07:46.72,Default,,0,0,0,,Ойын ойнауыңызға себеп бар ма?
Dialogue: 0,0:07:47.35,0:07:48.23,Default,,0,0,0,,Сен дұрыс айтасың — сені өліміңе мен себеп болдым.
Dialogue: 0,0:07:49.02,0:07:52.11,Default,,0,0,0,,Мен анама қосымша емтихан туралы айтқанымда
Dialogue: 0,0:07:52.90,0:07:54.32,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:07:54.57,0:07:55.65,Default,,0,0,0,,Сіз
Dialogue: 0,0:07:56.98,0:08:00.28,Default,,0,0,0,,Жақсы Егер мен келесі қосымша емтиханда орташадан жоғары алмасам
Dialogue: 0,0:08:00.45,0:08:02.82,Default,,0,0,0,,Мен сізге қазірден бастап кез келген ойын ойнауға тыйым саламын.
Dialogue: 0,0:08:06.24,0:08:08.66,Default,,0,0,0,,Сондықтан
Dialogue: 0,0:08:09.41,0:08:13.17,Default,,0,0,0,,Мен мүмкіндігінше көбірек ойын ойнауға тырысамын.
Dialogue: 0,0:08:15.38,0:08:17.76,Default,,0,0,0,,Мен саған тағы бір котлет беремін.
Dialogue: 0,0:08:22.39,0:08:24.97,Default,,0,0,0,,Бұл қосымша емтиханға дейін оқу ғана емес.
Dialogue: 0,0:08:25.26,0:08:26.39,Default,,0,0,0,,Пәндер қандай?
Dialogue: 0,0:08:26.85,0:08:28.43,Default,,0,0,0,,Математика
Dialogue: 0,0:08:29.06,0:08:31.77,Default,,0,0,0,,Мен оқуым керек екенін білемін, бірақ
Dialogue: 0,0:08:32.15,0:08:35.23,Default,,0,0,0,,Мен қалай оқу керектігін білмеймін
Dialogue: 0,0:08:36.86,0:08:38.36,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:08:38.65,0:08:40.32,Default,,0,0,0,,Өте үлкен қуыршақ.
Dialogue: 0,0:08:41.99,0:08:42.91,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:08:43.74,0:08:45.45,Default,,0,0,0,,Сен маған шынымен айтасың ба?
Dialogue: 0,0:08:46.33,0:08:46.87,Default,,0,0,0,,Иә
Dialogue: 0,0:08:47.33,0:08:50.79,Default,,0,0,0,,Бірақ мен бір сұрақты қате алған сайын
Dialogue: 0,0:08:51.04,0:08:51.54,Default,,0,0,0,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:08:53.29,0:08:54.13,Default,,0,0,0,,Жай әзіл.
Dialogue: 0,0:09:00.01,0:09:01.59,Default,,0,0,0,,Иә? Сіз осында оқисыз ба?
Dialogue: 0,0:09:01.92,0:09:04.30,Default,,0,0,0,,Бір-біріміздің үйімізге бара алмаймыз.
Dialogue: 0,0:09:04.47,0:09:05.64,Default,,0,0,0,,Қолдан келмейді ғой, иә?
Dialogue: 0,0:09:08.18,0:09:11.10,Default,,0,0,0,,Мафую-сан, мұндай кафеге жиі келесің бе?
Dialogue: 0,0:09:11.35,0:09:11.98,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:09:12.39,0:09:15.19,Default,,0,0,0,,Атмосфера жақсы, кофе дәмді.
Dialogue: 0,0:09:16.11,0:09:18.27,Default,,0,0,0,,Ал мен қара кофе ішіп отырмын
Dialogue: 0,0:09:18.36,0:09:19.78,Default,,0,0,0,,Ересек
Dialogue: 0,0:09:20.99,0:09:22.82,Default,,0,0,0,,Маған қарапайым нәрселер ұнайды.
Dialogue: 0,0:09:23.65,0:09:27.24,Default,,0,0,0,,Бірақ мен тапсырыс берген сайын адамдар мені бала деп ойлайды.
Dialogue: 0,0:09:27.24,0:09:28.62,Default,,0,0,0,,Бұл тітіркендіргіш, солай емес пе?
Dialogue: 0,0:09:28.78,0:09:30.95,Default,,0,0,0,,Менің ойымша, тәтті нәрсе жақсырақ.
Dialogue: 0,0:09:31.29,0:09:32.50,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,0:09:34.62,0:09:36.46,Default,,0,0,0,,Бұл қиын
Dialogue: 0,0:09:36.58,0:09:39.46,Default,,0,0,0,,Сіз мұны бірінші курс студентінің академиялық қабілетімен шеше білуіңіз керек.
Dialogue: 0,0:09:45.72,0:09:47.76,Default,,0,0,0,,Осындай сәнді дәмханада
Dialogue: 0,0:09:47.76,0:09:49.72,Default,,0,0,0,,Ноутбугімді ашқым келеді
Dialogue: 0,0:09:50.01,0:09:52.35,Default,,0,0,0,,Сізде ноутбук бар ма?
Dialogue: 0,0:09:52.56,0:09:55.77,Default,,0,0,0,,Иә, менде жұмыс үстелі түрі бар.
Dialogue: 0,0:09:56.19,0:09:58.36,Default,,0,0,0,,Бұл алып жүруге арналған планшет.
Dialogue: 0,0:09:58.73,0:10:00.07,Default,,0,0,0,,Бұл жеңіл және ыңғайлы
Dialogue: 0,0:10:02.07,0:10:03.57,Default,,0,0,0,,Бұл жеткіліксіз
Dialogue: 0,0:10:07.53,0:10:08.24,Default,,0,0,0,,Не болды, не болды?
Dialogue: 0,0:10:08.45,0:10:09.99,Default,,0,0,0,,Неліктен бұл бетті жасайсың?
Dialogue: 0,0:10:10.66,0:10:13.16,Default,,0,0,0,,Сен, қымбатты планшетің
Dialogue: 0,0:10:13.25,0:10:15.25,Default,,0,0,0,,Ол толығымен ойын машинасына айналды.
Dialogue: 0,0:10:15.87,0:10:17.83,Default,,0,0,0,,Хе-хе-хе…
Dialogue: 0,0:10:18.00,0:10:20.50,Default,,0,0,0,,Мен де зерттеу үшін қолданамын.
Dialogue: 0,0:10:20.50,0:10:23.46,Default,,0,0,0,,Бұл ойын стратегиясының сайты немесе басқа нәрсе болуы мүмкін.
Dialogue: 0,0:10:27.64,0:10:28.39,Default,,0,0,0,,Суреттелген жұлдыз
Dialogue: 0,0:10:29.30,0:10:31.47,Default,,0,0,0,,Бірақ бұл ойын қолданбасы
Dialogue: 0,0:10:31.47,0:10:32.72,Default,,0,0,0,,Мен оның жартысын ойнай алмаймын.
Dialogue: 0,0:10:32.77,0:10:34.14,Default,,0,0,0,,Мен кіру ойыны күйіндемін.
Dialogue: 0,0:10:34.27,0:10:36.52,Default,,0,0,0,,Оның жартысы ғана орындалды.
Dialogue: 0,0:10:39.65,0:10:44.90,Default,,0,0,0,,Сізге Спартандық білімнің жеткілікті мөлшері қажет сияқты.
Dialogue: 0,0:10:54.75,0:10:56.00,Default,,0,0,0,,Не болды?
Dialogue: 0,0:10:56.96,0:10:59.04,Default,,0,0,0,,Шиеленіс төмен сияқты.
Dialogue: 0,0:11:00.79,0:11:04.84,Default,,0,0,0,,Мен соңғы уақытта Мафую-санмен бірге оқып жүрмін.
Dialogue: 0,0:11:05.01,0:11:07.51,Default,,0,0,0,,Спартада қиын болды.
Dialogue: 0,0:11:11.05,0:11:11.89,Default,,0,0,0,,Кахо-сан
Dialogue: 0,0:11:12.39,0:11:14.56,Default,,0,0,0,,Шаршады деп айтпа.
Dialogue: 0,0:11:15.47,0:11:17.98,Default,,0,0,0,,Мафую-сан, мен сенің ауысымды ауыстырғаныңды қалаймын.
Dialogue: 0,0:11:17.98,0:11:19.19,Default,,0,0,0,,Мен кеңес алуға келдім.
Dialogue: 0,0:11:19.90,0:11:22.86,Default,,0,0,0,,Мен бұл Кахоға бірнеше сабақ беру үшін екеніне сенімдімін.
Dialogue: 0,0:11:23.40,0:11:24.86,Default,,0,0,0,,Сіз соншалықты алысқа қалай барасыз?
Dialogue: 0,0:11:25.23,0:11:28.49,Default,,0,0,0,,Мафую-сан дәл Кахо-санның әпкесі сияқты.
Dialogue: 0,0:11:38.46,0:11:41.33,Default,,0,0,0,,О, сен қарасың.
Dialogue: 0,0:11:41.83,0:11:44.42,Default,,0,0,0,,Иә, Мафую оны үнемі ішеді.
Dialogue: 0,0:11:44.42,0:11:45.84,Default,,0,0,0,,Дәмі қандай екен деп ойладым.
Dialogue: 0,0:11:46.01,0:11:47.92,Default,,0,0,0,,Сонда мен саған тістеп берер едім.
Dialogue: 0,0:11:48.01,0:11:49.34,Default,,0,0,0,,Бұл жақсы, бұл жақсы
Dialogue: 0,0:11:49.51,0:11:51.47,Default,,0,0,0,,Соның бәрін іше алмаймын ба білмеймін.
Dialogue: 0,0:11:51.64,0:11:52.89,Default,,0,0,0,,Жарайды
Dialogue: 0,0:11:57.81,0:11:59.56,Default,,0,0,0,,Қант пен сүт әкел
Dialogue: 0,0:12:05.32,0:12:07.40,Default,,0,0,0,,Бұл оңай бола бастады.
Dialogue: 0,0:12:07.44,0:12:09.95,Default,,0,0,0,,Иә, Мафуйю-сан Спартадан.
Dialogue: 0,0:12:09.95,0:12:11.45,Default,,0,0,0,,Себебі сен сабақ беруде жақсысың
Dialogue: 0,0:12:11.70,0:12:13.87,Default,,0,0,0,,Иә? Бұл мені бақытты етеді.
Dialogue: 0,0:12:14.24,0:12:18.04,Default,,0,0,0,,Мен бастауыш сынып мұғалімі немесе бала күтімі қызметкері болуды мақсат етіп отырмын.
Dialogue: 0,0:12:18.37,0:12:19.83,Default,,0,0,0,,Ал, мен оны бірінші рет естіп тұрмын.
Dialogue: 0,0:12:20.00,0:12:21.50,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:12:21.87,0:12:24.13,Default,,0,0,0,,Мафую-сан сіздің ұстазыңыз ба?
Dialogue: 0,0:12:25.88,0:12:27.67,Default,,0,0,0,,Ендеше бірге ойнайық
Dialogue: 0,0:12:28.63,0:12:30.13,Default,,0,0,0,,Жақсы, сүйкімді.
Dialogue: 0,0:12:31.88,0:12:34.26,Default,,0,0,0,,Мен қазір дөрекі нәрсе ойлап отырмын.
Dialogue: 0,0:12:38.35,0:12:39.77,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:12:40.52,0:12:41.64,Default,,0,0,0,,Қайырлы таң.
Dialogue: 0,0:12:43.06,0:12:45.56,Default,,0,0,0,,Кахо-сан, сен бүгін шаршадың ба?
Dialogue: 0,0:12:46.77,0:12:49.99,Default,,0,0,0,,Аа, мен қосымша емтиханға дайындалып жатқанда біраз ұйықтап қалдым.
Dialogue: 0,0:12:51.07,0:12:54.24,Default,,0,0,0,,Мм, менің көзіме қара дақтар пайда болды.
Dialogue: 0,0:12:54.99,0:12:55.91,Default,,0,0,0,,О, бұл өтірік.
Dialogue: 0,0:12:59.41,0:13:01.75,Default,,0,0,0,,Уау, бұл рас.
Dialogue: 0,0:13:02.16,0:13:04.00,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:13:05.92,0:13:09.46,Default,,0,0,0,,Менің айтқанымдай күнде сабақ оқып жатқаның өте жақсы.
Dialogue: 0,0:13:10.05,0:13:14.01,Default,,0,0,0,,Аюды тұтынушының алдында қалдыра алмаймыз.
Dialogue: 0,0:13:15.55,0:13:18.01,Default,,0,0,0,,Кел, мен оны макияжбен жасырамын.
Dialogue: 0,0:13:24.90,0:13:25.77,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:13:28.61,0:13:31.03,Default,,0,0,0,,Ой, аю кетті.
Dialogue: 0,0:13:31.49,0:13:33.07,Default,,0,0,0,,Ол мүлдем жойылды.
Dialogue: 0,0:13:33.53,0:13:35.91,Default,,0,0,0,,Мафую-сан, ересек адам күткендей.
Dialogue: 0,0:13:36.32,0:13:40.84,Default,,0,0,0,,Тоналды крем мен тушь жағып, қасымды қию ғана.
Dialogue: 0,0:13:41.20,0:13:43.62,Default,,0,0,0,,Ол мектеп оқушысы, жетеді.
Dialogue: 0,0:13:44.25,0:13:45.88,Default,,0,0,0,,А, дұрыс! Мафую-сан
Dialogue: 0,0:13:46.00,0:13:48.79,Default,,0,0,0,,Макияж маған әдемірек көрінсе екен.
Dialogue: 0,0:13:49.46,0:13:51.05,Default,,0,0,0,,Мен-мен де өзімді жақсы сезінемін.
Dialogue: 0,0:13:51.59,0:13:53.67,Default,,0,0,0,,Не, жақсы сезінеді ме?
Dialogue: 0,0:13:56.47,0:13:58.14,Default,,0,0,0,,Мен оны кез келген жағдайда қолданып көрдім
Dialogue: 0,0:13:58.35,0:14:00.51,Default,,0,0,0,,Өйткені балалар, сендер жақсы формадасыңдар.
Dialogue: 0,0:14:00.51,0:14:02.18,Default,,0,0,0,,Макияж жақсы көрінбейді.
Dialogue: 0,0:14:02.64,0:14:03.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:03.77,0:14:05.73,Default,,0,0,0,,Менің кірпігім ұзарып барады
Dialogue: 0,0:14:06.69,0:14:11.53,Default,,0,0,0,,Бұл сәл қарапайым, дәлірек айтқанда, қарапайым, бірақ мүлдем басқа.
Dialogue: 0,0:14:13.44,0:14:16.20,Default,,0,0,0,,Онда мен құқығым жоқ.
Dialogue: 0,0:14:18.32,0:14:19.83,Default,,0,0,0,,Сіз ішке кіре алмайсыз ба?
Dialogue: 0,0:14:21.16,0:14:22.54,Default,,0,0,0,,А, қарапайым материалдар.
Dialogue: 0,0:14:23.79,0:14:26.04,Default,,0,0,0,,Енді кірмегеніңіз дұрыс.
Dialogue: 0,0:14:26.96,0:14:29.00,Default,,0,0,0,,Өйткені ол ойыншық ретінде пайдаланылуы мүмкін.
Dialogue: 0,0:14:29.17,0:14:30.21,Default,,0,0,0,,Ойыншықтар?
Dialogue: 0,0:14:30.84,0:14:33.30,Default,,0,0,0,,Не, ойын ойнап жатырсың ба?
Dialogue: 0,0:14:38.51,0:14:40.39,Default,,0,0,0,,Онда «Лайт» орнына «Рыцарь» деп атай алам ба?
Dialogue: 0,0:14:42.93,0:14:44.31,Default,,0,0,0,,Қолдарым шырылдап тұр.
Dialogue: 0,0:14:44.35,0:14:46.06,Default,,0,0,0,,Не, не істеуді жоспарлап отырсыз?
Dialogue: 0,0:14:47.19,0:14:49.02,Default,,0,0,0,,Сізді не қызықтырады?
Dialogue: 0,0:14:51.36,0:14:53.32,Default,,0,0,0,,Наму
Dialogue: 0,0:14:57.11,0:14:58.86,Default,,0,0,0,,Мен мұны істедім.
Dialogue: 0,0:15:00.03,0:15:04.08,Default,,0,0,0,,Уау, бұл керемет, сіз жай ғана макияжбен көп нәрсені өзгерте аласыз.
Dialogue: 0,0:15:04.91,0:15:07.00,Default,,0,0,0,,Менің айтайын дегенім, бұл бір түрлі.
Dialogue: 0,0:15:08.71,0:15:10.21,Default,,0,0,0,,Макияж дегеніміз не?
Dialogue: 0,0:15:12.34,0:15:13.59,Default,,0,0,0,,Мен, бұл мен бе?
Dialogue: 0,0:15:13.92,0:15:15.59,Default,,0,0,0,,Арнайы макияж енді жоқ
Dialogue: 0,0:15:16.63,0:15:18.18,Default,,0,0,0,,Жарайды, өзім айтсам да.
Dialogue: 0,0:15:18.34,0:15:21.47,Default,,0,0,0,,Мен сондай сұлу қызбын.
Dialogue: 0,0:15:21.68,0:15:25.31,Default,,0,0,0,,Жоқ, дәл қазір залда бірге даяшы бола аламыз.
Dialogue: 0,0:15:25.31,0:15:28.73,Default,,0,0,0,,Бұл жағдайда қандай белгілер бар?
Dialogue: 0,0:15:28.89,0:15:30.35,Default,,0,0,0,,Хм, бұл не екені қызық.
Dialogue: 0,0:15:30.65,0:15:32.02,Default,,0,0,0,,Феминизация?
Dialogue: 0,0:15:32.15,0:15:35.48,Default,,0,0,0,,Сіздің денеңіз өзгерген жоқ, сондықтан ол сізді әйелге айналдырмайды.
Dialogue: 0,0:15:35.99,0:15:36.78,Default,,0,0,0,,Немесе айтайын ба
Dialogue: 0,0:15:37.99,0:15:39.86,Default,,0,0,0,,Жалпы сурет жиіркенішті.
Dialogue: 0,0:15:40.70,0:15:42.28,Default,,0,0,0,,Нашар теңгерім
Dialogue: 0,0:15:42.95,0:15:44.74,Default,,0,0,0,,Бүгін қызық.
Dialogue: 0,0:15:47.54,0:15:49.46,Default,,0,0,0,,Ой, мынау сәйкес келмейтін қыз кім?
Dialogue: 0,0:15:49.46,0:15:51.67,Default,,0,0,0,,Бұл қалай аталады?
Dialogue: 0,0:15:51.79,0:15:53.50,Default,,0,0,0,,Бұл Акидзуки-сан дауысы ма?
Dialogue: 0,0:15:56.55,0:15:58.76,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:15:58.92,0:16:00.89,Default,,0,0,0,,Үздіксіз түсіру арқылы суретке түсірмеңіз.
Dialogue: 0,0:16:04.26,0:16:05.51,Default,,0,0,0,,Такку
Dialogue: 0,0:16:05.68,0:16:07.73,Default,,0,0,0,,Менеджер, амансың ба?
Dialogue: 0,0:16:07.98,0:16:09.81,Default,,0,0,0,,Иә, әйтеуір
Dialogue: 0,0:16:10.85,0:16:14.27,Default,,0,0,0,,Эй, Ринка-сан, сенің бүгін көңіл-күйің бөлек.
Dialogue: 0,0:16:14.52,0:16:16.78,Default,,0,0,0,,Маю-санға макияж жасадым.
Dialogue: 0,0:16:18.15,0:16:20.57,Default,,0,0,0,,Бұл сіздің ұнамдылығыңызды арттыру мүмкіндігі
Dialogue: 0,0:16:20.82,0:16:22.45,Default,,0,0,0,,Жүрек жылытатын комплимент
Dialogue: 0,0:16:23.57,0:16:26.45,Default,,0,0,0,,Түпнұсқа да жақсы, сондықтан одан да әдемі.
Dialogue: 0,0:16:26.83,0:16:28.16,Default,,0,0,0,,Кірпікпен
Dialogue: 0,0:16:28.33,0:16:30.58,Default,,0,0,0,,Олар түйе сияқты.
Dialogue: 0,0:16:32.12,0:16:33.04,Default,,0,0,0,,Түйе?
Dialogue: 0,0:16:33.42,0:16:35.71,Default,,0,0,0,,Мен қате нұсқаны таңдадым
Dialogue: 0,0:16:36.09,0:16:38.38,Default,,0,0,0,,Мен қобалжығанда дұрыс сөйлей алмаймын.
Dialogue: 0,0:16:39.30,0:16:42.05,Default,,0,0,0,,Ринка сізді жек көруі мүмкін.
Dialogue: 0,0:16:43.18,0:16:47.93,Default,,0,0,0,,Ой, мен оны сондай сүйкімді жануармен салыстырдым.
Dialogue: 0,0:17:00.61,0:17:03.66,Default,,0,0,0,,Адамдардың бетімен ойнауға қалай дәтің бар?
Dialogue: 0,0:17:05.74,0:17:08.58,Default,,0,0,0,,Ах, Акидзуки-кун, сен қалай ойлайсың? Макияжыңыз түсіп қалды ма?
Dialogue: 0,0:17:09.08,0:17:10.50,Default,,0,0,0,,Әйтеуір
Dialogue: 0,0:17:12.41,0:17:15.42,Default,,0,0,0,,Иә, мен де макияжымды жасар едім.
Dialogue: 0,0:17:15.71,0:17:16.88,Default,,0,0,0,,Солай көрінеді.
Dialogue: 0,0:17:17.59,0:17:18.67,Default,,0,0,0,,Реакция жұқа!
Dialogue: 0,0:17:20.13,0:17:22.30,Default,,0,0,0,,Жоқ, мен не айта аламын?
Dialogue: 0,0:17:22.68,0:17:26.51,Default,,0,0,0,,Өзіңіз көргеннен кейін әсері жетіспейді емес пе?
Dialogue: 0,0:17:26.51,0:17:28.60,Default,,0,0,0,,Мен әсер іздемеймін
Dialogue: 0,0:17:28.85,0:17:33.69,Default,,0,0,0,,Шынымды айтсам, ол одан да сүйкімді болды деп ойламаймын.
Dialogue: 0,0:17:33.73,0:17:34.77,Default,,0,0,0,,H-бұл қорқынышты!
Dialogue: 0,0:17:36.02,0:17:37.52,Default,,0,0,0,,Жоқ, мен мұны жаман мағынада айтып тұрған жоқпын.
Dialogue: 0,0:17:37.90,0:17:38.69,Default,,0,0,0,,Басқаша айтқанда
Dialogue: 0,0:17:40.53,0:17:42.44,Default,,0,0,0,,Жоқ, бұл ештеңе емес.
Dialogue: 0,0:17:42.61,0:17:45.24,Default,,0,0,0,,Е, неге, неге? Айтыңызшы.
Dialogue: 0,0:17:45.24,0:17:48.16,Default,,0,0,0,,Бұл ештеңе емес, сүйкімді және сүйкімді
Dialogue: 0,0:17:48.16,0:17:49.16,Default,,0,0,0,,Өтірік айтшы.
Dialogue: 0,0:17:50.12,0:17:52.06,Default,,0,0,0,,Бұл жиіркенішті.
Dialogue: 0,0:17:52.16,0:17:53.58,Default,,0,0,0,,Айт, айт
Dialogue: 0,0:17:53.75,0:17:54.42,Default,,0,0,0,,Жоқ, сондықтан
Dialogue: 0,0:17:57.92,0:18:00.00,Default,,0,0,0,,Эй, эй!
Dialogue: 0,0:18:00.42,0:18:02.92,Default,,0,0,0,,А, қазірдің өзінде, бұл оның бұрынғыдай сүйкімді екенін білдіреді.
Dialogue: 0,0:18:04.80,0:18:06.97,Default,,0,0,0,,Мұндай ғибадатхана сызықтарын айтпаңыз
Dialogue: 0,0:18:14.23,0:18:17.60,Default,,0,0,0,,Не деген сұмдық?
Dialogue: 0,0:18:18.65,0:18:20.44,Default,,0,0,0,,Бұл қандай сезім?
Dialogue: 0,0:18:26.91,0:18:29.03,Default,,0,0,0,,Мен бүгін көп бояндым.
Dialogue: 0,0:18:29.28,0:18:32.45,Default,,0,0,0,,Тұтынушылардан көптеген мақтау сөздер алғаныма қуаныштымын.
Dialogue: 0,0:18:32.95,0:18:34.91,Default,,0,0,0,,Егер сізге ұнаса, маған хабарлаңыз
Dialogue: 0,0:18:35.79,0:18:40.34,Default,,0,0,0,,Иә, иә, мен сәл есейгенше макияжды қолдана бастаған жоқпын.
Dialogue: 0,0:18:41.00,0:18:43.13,Default,,0,0,0,,Менің ойымша, қазір әдеттегідей баруға болады.
Dialogue: 0,0:18:43.76,0:18:48.43,Default,,0,0,0,,Иә, өзіңізді боянуға мәжбүрлегенше, қазір теріңізге дұрыс күтім жасаған дұрыс.
Dialogue: 0,0:18:51.60,0:18:52.68,Default,,0,0,0,,Демек, Өлім періштесі тек алма жей ме?
Dialogue: 0,0:18:52.93,0:18:55.73,Default,,0,0,0,,Өтінемін, кенет айқайлама, мен таң қалмаймын.
Dialogue: 0,0:18:56.02,0:18:59.23,Default,,0,0,0,,Өйткені менің киімімде үлкен құрт бар.
Dialogue: 0,0:19:05.49,0:19:08.24,Default,,0,0,0,,Кахо: Бұл құрт емес.
Dialogue: 0,0:19:09.28,0:19:11.83,Default,,0,0,0,,Саған сыйлаған жалған кірпіктер
Dialogue: 0,0:19:13.95,0:19:15.54,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:19:16.21,0:19:18.96,Default,,0,0,0,,Өйткені, макияж әзірше жақсы.
Dialogue: 0,0:19:20.54,0:19:25.80,Default,,0,0,0,,Иә, дәл қазір мені макияждан гөрі қосымша емтиханға дайындалу қызықтырады.
Dialogue: 0,0:19:34.26,0:19:35.68,Default,,0,0,0,,Мафую мырза
Dialogue: 0,0:19:38.56,0:19:40.98,Default,,0,0,0,,Қараңдаршы, Мафую-сан 81 ұпай
Dialogue: 0,0:19:41.90,0:19:43.09,Default,,0,0,0,,өтті.
Dialogue: 0,0:19:46.74,0:19:48.53,Default,,0,0,0,,Сіз мен күткеннен көп ұпай алдыңыз.
Dialogue: 0,0:19:49.24,0:19:50.70,Default,,0,0,0,,Егер сіз тырыссаңыз, мұны істей аласыз.
Dialogue: 0,0:19:51.12,0:19:53.12,Default,,0,0,0,,Рахмет, Мафую-сан
Dialogue: 0,0:19:53.91,0:19:55.91,Default,,0,0,0,,Иә, иә, бұл жақсы.
Dialogue: 0,0:19:57.04,0:19:59.62,Default,,0,0,0,,Егер сіз шу шығарсаңыз, сіз басқа тұтынушыларға кедергі келтіресіз.
Dialogue: 0,0:20:21.90,0:20:26.69,Default,,0,0,0,,Мен толықтыру емтиханына дайындалып болған соң, енді Мафую-санмен сөйлесе алмаймын.
Dialogue: 0,0:20:39.71,0:20:40.58,Default,,0,0,0,,Мафую мырза
Dialogue: 0,0:20:46.92,0:20:47.67,Default,,0,0,0,,А, мм.
Dialogue: 0,0:20:49.26,0:20:52.97,Default,,0,0,0,,Уақытымыз болған кезде кафеде шай ішейік пе?
Dialogue: 0,0:20:55.72,0:20:58.14,Default,,0,0,0,,Иә, жарайды.
Dialogue: 0,0:20:58.81,0:20:59.56,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:20:59.93,0:21:00.39,Default,,0,0,0,,Иә
Dialogue: 0,0:21:01.56,0:21:02.73,Default,,0,0,0,,Хмм, иә!
Dialogue: 0,0:21:05.61,0:21:06.11,Default,,0,0,0,,Бірақ
Dialogue: 0,0:21:07.19,0:21:11.36,Default,,0,0,0,,Келесі жолы қызыл баға алмас бұрын жақсы оқуым керек.
Dialogue: 0,0:21:15.28,0:21:16.95,Default,,0,0,0,,А, тағы оқисың ба?
Dialogue: 0,0:21:17.33,0:21:22.92,Default,,0,0,0,,Ойын режимін күту жақсы
Dialogue: 0,0:22:55.97,0:22:57.38,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:22:58.34,0:22:59.26,Default,,0,0,0,,Қайырлы таң.
Dialogue: 0,0:23:03.64,0:23:06.10,Default,,0,0,0,,Иә? Кахо-сан, сен қара кофе ішесің бе?
Dialogue: 0,0:23:06.52,0:23:08.19,Default,,0,0,0,,Соңғы кезде.
Dialogue: 0,0:23:08.56,0:23:11.02,Default,,0,0,0,,Кахо-санның талғамы жетілген.
Dialogue: 0,0:23:11.27,0:23:13.61,Default,,0,0,0,,Амал жоқ, мүлде болмайды.
Dialogue: 0,0:23:13.78,0:23:16.15,Default,,0,0,0,,Мен әлі күнге дейін өзімді күштеп ішетін сияқтымын.
Dialogue: 0,0:23:17.07,0:23:19.45,Default,,0,0,0,,Бұл шынымен ащы ма?
Dialogue: 0,0:23:19.66,0:23:21.03,Default,,0,0,0,,Күшті
Dialogue: 0,0:23:23.04,0:23:25.16,Default,,0,0,0,,Бірақ басқа да дәмдер бар ма деп ойлаймын.
Dialogue: 0,0:23:25.66,0:23:27.25,Default,,0,0,0,,Басқа дәмдер?
Dialogue: 0,0:23:29.54,0:23:32.50,Default,,0,0,0,,Ересек апаның дәмі
Dialogue: 0,0:23:36.01,0:23:36.59,Default,,0,0,0,,Келесі жолы
Dialogue: 0,0:23:36.88,0:23:39.43,Default,,0,0,0,,Келесі жолы цундере жақсы, Кабедон жаман
Dialogue: 0,0:23:40.93,0:23:46.93,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory