Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.09,0:00:06.84,Default,,0,0,0,,Ал, мен сенен бірдеңе сұрасам болады ма?
Dialogue: 0,0:00:08.80,0:00:10.18,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:00:11.01,0:00:11.76,Default,,0,0,0,,Ах, Ичиго-сан
Dialogue: 0,0:00:12.09,0:00:13.39,Default,,0,0,0,,Мен мұнда сұхбат алу үшін келдім.
Dialogue: 0,0:00:13.43,0:00:15.31,Default,,0,0,0,,Сіз жаңасын салып жатырсыз.
Dialogue: 0,0:00:16.77,0:00:19.73,Default,,0,0,0,,Танысқаныма қуаныштымын, мен Хидери Канзакимін.
Dialogue: 0,0:00:19.94,0:00:21.52,Default,,0,0,0,,Пичи орта мектебінің оқушысы
Dialogue: 0,0:00:21.81,0:00:23.36,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:02:03.01,0:02:05.59,Default,,0,0,0,,Ол қуыршаққа ұқсайды және сүйкімді
Dialogue: 0,0:02:06.18,0:02:09.68,Default,,0,0,0,,Менеджер, бұл адамды бүгін бізге қосасыз ба?
Dialogue: 0,0:02:09.89,0:02:10.43,Default,,0,0,0,,Жоқ
Dialogue: 0,0:02:10.76,0:02:13.18,Default,,0,0,0,,Мен не істеу керектігін әлі шешкен жоқпын.
Dialogue: 0,0:02:15.44,0:02:17.19,Default,,0,0,0,,Өтінемін, жылауды доғаршы.
Dialogue: 0,0:02:18.61,0:02:20.44,Default,,0,0,0,,Әй, сен бұрын не деп шуладың?
Dialogue: 0,0:02:25.36,0:02:27.32,Default,,0,0,0,,Сәлеметсіз бе, сіз полициясыз ба?
Dialogue: 0,0:02:27.32,0:02:29.70,Default,,0,0,0,,Неге бірден полиция шақырмақсың!?
Dialogue: 0,0:02:31.70,0:02:34.62,Default,,0,0,0,,Жарайды, мен жағдайды түсіндім деп ойлаймын, бірақ түсінбеймін.
Dialogue: 0,0:02:35.04,0:02:37.42,Default,,0,0,0,,Ол отаку отбасына жататын сүйкімді қыз.
Dialogue: 0,0:02:39.04,0:02:40.63,Default,,0,0,0,,Мен соңғы кездері бос емеспін.
Dialogue: 0,0:02:40.96,0:02:43.13,Default,,0,0,0,,Бізде адам аз, неге оларды жұмысқа алмасқа?
Dialogue: 0,0:02:45.76,0:02:47.01,Default,,0,0,0,,Мәселе бар ма?
Dialogue: 0,0:02:47.38,0:02:51.35,Default,,0,0,0,,Кейіпкерлер Мафуйю-санға шамалы ұқсайтын сияқты.
Dialogue: 0,0:02:52.68,0:02:55.56,Default,,0,0,0,,Шынында да, бұл лоли кейіпкеріне ұқсас жұлдыз картасы болуы мүмкін.
Dialogue: 0,0:02:55.85,0:02:56.68,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:02:56.98,0:02:59.60,Default,,0,0,0,,Егер бірдеңе болса, Мафую көбірек лолита-варвар.
Dialogue: 0,0:02:59.60,0:03:00.31,Default,,0,0,0,,Зубури
Dialogue: 0,0:03:04.69,0:03:05.44,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:03:06.49,0:03:07.82,Default,,0,0,0,,Саңылау…
Dialogue: 0,0:03:08.28,0:03:10.95,Default,,0,0,0,,Қайырлы таң...
Dialogue: 0,0:03:12.99,0:03:14.54,Default,,0,0,0,,Бала жаңа ма?
Dialogue: 0,0:03:14.70,0:03:16.75,Default,,0,0,0,,Шынымен бе? Сүйкімді емес пе?
Dialogue: 0,0:03:16.91,0:03:18.83,Default,,0,0,0,,Дүкен менеджерін жалдаңыз.
Dialogue: 0,0:03:19.08,0:03:21.75,Default,,0,0,0,,Менің ойымша, мұндай балалар көп емес.
Dialogue: 0,0:03:22.25,0:03:24.84,Default,,0,0,0,,Адам санын көбейтіп, құлап кетсін.
Dialogue: 0,0:03:27.72,0:03:31.34,Default,,0,0,0,,Жарайды, бәрің де осыншама көп айтсаңдар.
Dialogue: 0,0:03:31.64,0:03:32.72,Default,,0,0,0,,Бұл тек қателік шегі ғой, иә?
Dialogue: 0,0:03:32.93,0:03:36.72,Default,,0,0,0,,Шынымен!? Мен де осы дүкеннің формасын кие аламын!
Dialogue: 0,0:03:36.85,0:03:37.64,Default,,0,0,0,,«Мен»?
Dialogue: 0,0:03:39.02,0:03:40.69,Default,,0,0,0,,Сен менің балам емессің бе?
Dialogue: 0,0:03:40.85,0:03:42.61,Default,,0,0,0,,Қатты шабуыл!
Dialogue: 0,0:03:42.65,0:03:45.15,Default,,0,0,0,,Не, оның атрибуттары бар ма?
Dialogue: 0,0:03:46.61,0:03:50.16,Default,,0,0,0,,Әй, менің формасым қайда?
Dialogue: 0,0:03:50.99,0:03:53.66,Default,,0,0,0,,Бүгін қосымша көйлек пен шалбар әкеліңіз.
Dialogue: 0,0:03:55.79,0:03:58.71,Default,,0,0,0,,Бұл шұғыл, сондықтан олар әлі дайын емес!
Dialogue: 0,0:03:58.87,0:04:03.25,Default,,0,0,0,,Мм, егер менікі қарсы болмасаң, саған қосалқы форма бергенімді қалайсың ба?
Dialogue: 0,0:04:03.88,0:04:05.67,Default,,0,0,0,,Рахмет
Dialogue: 0,0:04:05.71,0:04:09.34,Default,,0,0,0,,Форманы дайындау үшін өлшемін айта аласыз ба?
Dialogue: 0,0:04:11.47,0:04:12.34,Default,,0,0,0,,Жоғарыдан
Dialogue: 0,0:04:12.47,0:04:15.72,Default,,0,0,0,,73 56…
Dialogue: 0,0:04:16.39,0:04:19.10,Default,,0,0,0,,S, M, L, өтінемін
Dialogue: 0,0:04:21.69,0:04:23.69,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:04:25.02,0:04:26.11,Default,,0,0,0,,Бұл сізге сәйкес келеді!
Dialogue: 0,0:04:26.23,0:04:27.15,Default,,0,0,0,,Өте сүйкімді!
Dialogue: 0,0:04:27.53,0:04:29.69,Default,,0,0,0,,Сәл үлкен болуы мүмкін
Dialogue: 0,0:04:29.90,0:04:31.95,Default,,0,0,0,,Шындығында, бұл жақсы!
Dialogue: 0,0:04:36.08,0:04:38.45,Default,,0,0,0,,Енді бәрі киімдеріңді ауыстырып, ашуға дайындалыңдар.
Dialogue: 0,0:04:39.12,0:04:40.41,Default,,0,0,0,,Yes
Dialogue: 0,0:04:45.08,0:04:47.21,Default,,0,0,0,,Қош келдіңіз!
Dialogue: 0,0:04:47.21,0:04:48.76,Default,,0,0,0,,О, жаңа бала?
Dialogue: 0,0:04:49.21,0:04:54.22,Default,,0,0,0,,Бүгін Хидеринді көруге келгеніңіз үшін рахмет!
Dialogue: 0,0:04:56.05,0:05:00.89,Default,,0,0,0,,Барлығыңыз, үйге қайтып бара жатқанда Хидеринмен хабарласыңыз!
Dialogue: 0,0:05:03.14,0:05:05.10,Default,,0,0,0,,Оның кумирлік қасиеті бар ма?
Dialogue: 0,0:05:05.10,0:05:06.27,Default,,0,0,0,,Керемет!
Dialogue: 0,0:05:07.61,0:05:08.94,Default,,0,0,0,,Ичиго-сан, Ичиго-сан
Dialogue: 0,0:05:09.11,0:05:11.40,Default,,0,0,0,,Сізден көмек сұрасам болады ма?
Dialogue: 0,0:05:11.74,0:05:12.57,Default,,0,0,0,,Ол мені осы күйімде көрмесін деп, батыл болып көрінуге барынша тырысып жүрмін
Dialogue: 0,0:05:12.74,0:05:15.07,Default,,0,0,0,,Түсінбеген нәрсе болды ма?
Dialogue: 0,0:05:18.53,0:05:21.08,Default,,0,0,0,,Олар егіз пұт!
Dialogue: 0,0:05:22.91,0:05:24.92,Default,,0,0,0,,Егіз пұттар!
Dialogue: 0,0:05:25.04,0:05:27.13,Default,,0,0,0,,Ичиго мырза, садистік әрекет жасаңыз!
Dialogue: 0,0:05:33.01,0:05:35.59,Default,,0,0,0,,Бұл жаңадан келген адам өте танымал болды.
Dialogue: 0,0:05:36.34,0:05:37.64,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:05:38.51,0:05:39.85,Default,,0,0,0,,Реакция әлсіз.
Dialogue: 0,0:05:40.52,0:05:42.18,Default,,0,0,0,,Жақсы жаңа адам келсе де
Dialogue: 0,0:05:42.18,0:05:42.89,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:05:43.39,0:05:45.52,Default,,0,0,0,,Жоқ, өйткені
Dialogue: 0,0:05:48.82,0:05:49.57,Default,,0,0,0,,Не болды?
Dialogue: 0,0:05:49.61,0:05:50.32,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:05:51.40,0:05:53.40,Default,,0,0,0,,Осылайша шықты.
Dialogue: 0,0:05:54.74,0:05:57.28,Default,,0,0,0,,Қара түсті зұлым тіршілік формасы
Dialogue: 0,0:05:57.95,0:06:01.62,Default,,0,0,0,,Бұл тарақан!
Dialogue: 0,0:06:01.95,0:06:03.91,Default,,0,0,0,,Не, сен тарақансың ба?
Dialogue: 0,0:06:04.04,0:06:06.46,Default,,0,0,0,,қатты сөйлегеніңізге таң қалдым.
Dialogue: 0,0:06:07.29,0:06:08.13,Default,,0,0,0,,Не болды?
Dialogue: 0,0:06:08.38,0:06:10.00,Default,,0,0,0,,Жоқ, өйткені
Dialogue: 0,0:06:11.30,0:06:15.01,Default,,0,0,0,,Әй, Хидери-чанның жағында қара шайтан бар!
Dialogue: 0,0:06:18.01,0:06:19.68,Default,,0,0,0,,Қолмен, қолмен
Dialogue: 0,0:06:25.60,0:06:27.56,Default,,0,0,0,,Ешқандай ойланбады.
Dialogue: 0,0:06:27.69,0:06:29.02,Default,,0,0,0,,Керемет
Dialogue: 0,0:06:29.40,0:06:31.73,Default,,0,0,0,,Хидери-чан, ерке көрінесің.
Dialogue: 0,0:06:32.86,0:06:35.86,Default,,0,0,0,,Бұл қорқынышты болды.
Dialogue: 0,0:06:35.86,0:06:37.57,Default,,0,0,0,,Мына қолмен кел.
Dialogue: 0,0:06:38.74,0:06:41.24,Default,,0,0,0,,Ластануды дезинфекциялаңыз!
Dialogue: 0,0:06:43.70,0:06:45.41,Default,,0,0,0,,Еркектікке жатпайды
Dialogue: 0,0:06:45.96,0:06:47.92,Default,,0,0,0,,Ол адам, адам.
Dialogue: 0,0:06:51.09,0:06:53.25,Default,,0,0,0,,Ол сіз ер бала деп атайтын адам емес пе?
Dialogue: 0,0:06:53.25,0:06:55.17,Default,,0,0,0,,Сіз керемет адамды таптыңыз.
Dialogue: 0,0:06:55.55,0:06:57.55,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:06:58.01,0:07:01.26,Default,,0,0,0,,Түйіндемеде жыныс ретінде ер адамды жазыңыз.
Dialogue: 0,0:07:01.30,0:07:03.81,Default,,0,0,0,,Иә, бұл қыз болуы мүмкін емес пе?
Dialogue: 0,0:07:03.97,0:07:04.93,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:07:05.43,0:07:07.89,Default,,0,0,0,,Айтпақшы, өтініш беруге сіздің мотивацияңыз қандай?
Dialogue: 0,0:07:10.10,0:07:14.15,Default,,0,0,0,,Менің арманым сүйкімді кумир болу.
Dialogue: 0,0:07:14.57,0:07:19.66,Default,,0,0,0,,Менің ойымша, бұл сүйкімділікті маған Құдай сол үшін берген.
Dialogue: 0,0:07:19.74,0:07:21.32,Default,,0,0,0,,Өзім айттым, мына жігіт.
Dialogue: 0,0:07:21.66,0:07:23.91,Default,,0,0,0,,Бірақ ата-анам түсінбейді
Dialogue: 0,0:07:24.29,0:07:26.91,Default,,0,0,0,,Алдымен осы жерден желдеткішті жасаңыз.
Dialogue: 0,0:07:27.71,0:07:32.04,Default,,0,0,0,,Мен өзімнің кумир ретінде қаншалықты дарынды екенімді көрсеткім келеді.
Dialogue: 0,0:07:32.54,0:07:33.34,Default,,0,0,0,,Егер
Dialogue: 0,0:07:34.13,0:07:37.51,Default,,0,0,0,,Мен ферманы өз қолыма алуым керек.
Dialogue: 0,0:07:38.13,0:07:40.30,Default,,0,0,0,,Мен жәндіктермен қоршалғанды ​​ұнатпаймын.
Dialogue: 0,0:07:40.43,0:07:43.39,Default,,0,0,0,,Маған шошқалар мен шошқалар ұнайды.
Dialogue: 0,0:07:44.14,0:07:47.73,Default,,0,0,0,,Еркелеткім келеді
Dialogue: 0,0:07:53.90,0:07:55.40,Default,,0,0,0,,Сіз дүкен менеджерісіз бе?
Dialogue: 0,0:07:55.44,0:07:56.57,Default,,0,0,0,,Керемет!
Dialogue: 0,0:07:57.57,0:08:00.11,Default,,0,0,0,,Жарайды, онда келесі жолы дүкенге бара аламыз ба?
Dialogue: 0,0:08:00.24,0:08:00.91,Default,,0,0,0,,Қалай болғанда да
Dialogue: 0,0:08:01.11,0:08:05.54,Default,,0,0,0,,Келсең, екеуіңе дәмді тәттілер сыйлаймын.
Dialogue: 0,0:08:06.58,0:08:07.58,Default,,0,0,0,,Олай болса! Алақай!
Dialogue: 0,0:08:08.25,0:08:12.00,Default,,0,0,0,,Сыныбыңыздан қалағаныңызша достарыңызды ерінбеңіз.
Dialogue: 0,0:08:12.21,0:08:14.34,Default,,0,0,0,,Олай болса, бәріміз оны орнатамыз ба?
Dialogue: 0,0:08:15.59,0:08:17.76,Default,,0,0,0,,Жақында кездескенше, менеджер.
Dialogue: 0,0:08:18.01,0:08:21.72,Default,,0,0,0,,Қош бол, мен сені күтемін.
Dialogue: 0,0:08:24.72,0:08:26.89,Default,,0,0,0,,Акидзуки-сан, сен не істеп жатырсың?
Dialogue: 0,0:08:27.22,0:08:30.06,Default,,0,0,0,,Тапа-тал түсте дүкеннің алдынан қыздарды жинау?
Dialogue: 0,0:08:30.06,0:08:32.02,Default,,0,0,0,,Жоқ, бұл өтініш.
Dialogue: 0,0:08:33.56,0:08:35.19,Default,,0,0,0,,Кананомия көрген болса
Dialogue: 0,0:08:35.19,0:08:36.40,Default,,0,0,0,,Дұрыс түсінбеу керек
Dialogue: 0,0:08:36.52,0:08:38.99,Default,,0,0,0,,Ичиго-сан мені көргенде
Dialogue: 0,0:08:39.07,0:08:40.78,Default,,0,0,0,,Олар бұл туралы ештеңе ойламайды.
Dialogue: 0,0:08:41.03,0:08:44.70,Default,,0,0,0,,Себебі, сіз оны жақсы меңгермегенсіз және ешқандай алға жылжымағансыз.
Dialogue: 0,0:08:45.78,0:08:48.04,Default,,0,0,0,,Ауырды, Акидзуки-сан.
Dialogue: 0,0:08:50.66,0:08:51.54,Default,,0,0,0,,Канзаки мырза?
Dialogue: 0,0:08:51.79,0:08:52.67,Default,,0,0,0,,Онда болды ма?
Dialogue: 0,0:08:53.83,0:08:56.54,Default,,0,0,0,,Дүкен меңгерушісі осындай болған.
Dialogue: 0,0:08:56.54,0:08:58.30,Default,,0,0,0,,Эй, бұл қозғалысты тоқтат.
Dialogue: 0,0:08:58.34,0:09:00.01,Default,,0,0,0,,Миу-сан нөмірі екінші.
Dialogue: 0,0:09:03.47,0:09:04.68,Default,,0,0,0,,Жарайды, бейшара дүкен менеджері.
Dialogue: 0,0:09:04.72,0:09:07.14,Default,,0,0,0,,Мен сізге бірнеше лекция оқимын.
Dialogue: 0,0:09:07.14,0:09:08.22,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:09:08.26,0:09:08.85,Default,,0,0,0,,«Барлығын мен үшін» мұрагері…
Dialogue: 0,0:09:09.02,0:09:11.14,Default,,0,0,0,,Мені сүйкімді деп атаңыз
Dialogue: 0,0:09:13.19,0:09:15.81,Default,,0,0,0,,Сүйкімдімін деп қана кеңес ала алмасаң
Dialogue: 0,0:09:15.81,0:09:16.81,Default,,0,0,0,,Бұл арзан, солай ма?
Dialogue: 0,0:09:17.23,0:09:19.15,Default,,0,0,0,,Сіз оны үнемі айтып отырасыз.
Dialogue: 0,0:09:19.78,0:09:20.32,Default,,0,0,0,,Немесе
Dialogue: 0,0:09:20.86,0:09:22.70,Default,,0,0,0,,Әлде?
Dialogue: 0,0:09:23.78,0:09:25.99,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:09:26.91,0:09:28.66,Default,,0,0,0,,Сіз оны соншалықты жек көресіз бе?
Dialogue: 0,0:09:28.66,0:09:31.00,Default,,0,0,0,,Оған көмектесу мүмкін емес, бәрі жақсы.
Dialogue: 0,0:09:32.16,0:09:34.29,Default,,0,0,0,,Ең алдымен мақтау
Dialogue: 0,0:09:34.46,0:09:35.71,Default,,0,0,0,,Сүйкімді нәрсе
Dialogue: 0,0:09:35.71,0:09:38.46,Default,,0,0,0,,Қыздар мақтасаң қуанады.
Dialogue: 0,0:09:38.88,0:09:42.13,Default,,0,0,0,,Мен SNS желісінде жүктеген селфилерге де мақтаулар аламын.
Dialogue: 0,0:09:42.26,0:09:45.01,Default,,0,0,0,,Маған комплимент айтатын адамдар ұнайды.
Dialogue: 0,0:09:45.18,0:09:45.97,Default,,0,0,0,,Хехе
Dialogue: 0,0:09:46.06,0:09:46.89,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:09:50.93,0:09:52.73,Default,,0,0,0,,Сіз көп жүктеп жатырсыз.
Dialogue: 0,0:09:53.64,0:09:59.19,Default,,0,0,0,,Неліктен менің қас-қабақ, үйрек ауыз, жамбас суреттерім көп?
Dialogue: 0,0:09:59.36,0:10:01.57,Default,,0,0,0,,Кешіріңіз, ол жерге тиіспеңіз.
Dialogue: 0,0:10:04.03,0:10:05.28,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:10:07.49,0:10:09.66,Default,,0,0,0,,Алдымен мақта, алдымен мақта.
Dialogue: 0,0:10:10.12,0:10:11.70,Default,,0,0,0,,Сіз тағы да осындасыз.
Dialogue: 0,0:10:11.95,0:10:14.91,Default,,0,0,0,,Жолдан тыс жерде отырыңыз.
Dialogue: 0,0:10:15.04,0:10:15.62,Default,,0,0,0,,Иә
Dialogue: 0,0:10:15.67,0:10:17.58,Default,,0,0,0,,Ей, мақтау, мақтау.
Dialogue: 0,0:10:20.09,0:10:20.84,Default,,0,0,0,,Ичиго-сан
Dialogue: 0,0:10:21.17,0:10:21.84,Default,,0,0,0,,Иә
Dialogue: 0,0:10:22.34,0:10:25.05,Default,,0,0,0,,Ичиго-сан мейірімді және сүйкімді.
Dialogue: 0,0:10:27.93,0:10:30.68,Default,,0,0,0,,Садистік, қолыңнан келмеді ме?
Dialogue: 0,0:10:31.18,0:10:32.72,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:10:33.35,0:10:37.56,Default,,0,0,0,,Мүмкін мен тұтынушыларға қызмет көрсетуге дайын емеспін бе?
Dialogue: 0,0:10:37.69,0:10:40.86,Default,,0,0,0,,Жоқ, Ичиго-сан, бұл түсінбеушілік.
Dialogue: 0,0:10:45.95,0:10:49.37,Default,,0,0,0,,Дүкен басшысына ауызша айту жақсы емес.
Dialogue: 0,0:10:49.62,0:10:50.28,Default,,0,0,0,,Жоқ-қ-қ-қ-қ…
Dialogue: 0,0:10:50.45,0:10:52.62,Default,,0,0,0,,Енді әрекеттер арқылы ұпай жинайық.
Dialogue: 0,0:10:52.62,0:10:53.49,Default,,0,0,0,,Әрекет?
Dialogue: 0,0:10:54.41,0:10:55.62,Default,,0,0,0,,Иә, мысалы
Dialogue: 0,0:10:55.66,0:10:57.75,Default,,0,0,0,,Мен алдымен қайтамын.
Dialogue: 0,0:11:00.59,0:11:03.63,Default,,0,0,0,,Осылайша сіз басқаларға көмектесесіз
Dialogue: 0,0:11:06.63,0:11:08.93,Default,,0,0,0,,Менің аяғымды ұстап алдың.
Dialogue: 0,0:11:09.05,0:11:12.60,Default,,0,0,0,,Бұл биіктіктің биіктігі
Dialogue: 0,0:11:12.60,0:11:14.35,Default,,0,0,0,,Егер солай болса, онда бұл мүмкін сияқты.
Dialogue: 0,0:11:14.39,0:11:16.85,Default,,0,0,0,,Мен бірден Ичиго-санға көмектесемін.
Dialogue: 0,0:11:17.39,0:11:19.48,Default,,0,0,0,,Тапсырыс беру жақсы.
Dialogue: 0,0:11:19.65,0:11:22.02,Default,,0,0,0,,Өтінемін, түкірік ұшып кетпесін.
Dialogue: 0,0:11:23.23,0:11:24.86,Default,,0,0,0,,Жарайды, тез тапсырыс беріңіз.
Dialogue: 0,0:11:26.28,0:11:27.65,Default,,0,0,0,,Не, дүкен меңгерушісі?
Dialogue: 0,0:11:29.03,0:11:31.57,Default,,0,0,0,,Менің сізге беретін тағамым жоқ.
Dialogue: 0,0:11:34.62,0:11:36.08,Default,,0,0,0,,Сіз не ойлап отырсыз?
Dialogue: 0,0:11:36.37,0:11:39.37,Default,,0,0,0,,Көмек көрсету жұмысқа араласу деген сөз емес.
Dialogue: 0,0:11:39.79,0:11:40.25,Default,,0,0,0,,Иә
Dialogue: 0,0:11:40.88,0:11:45.34,Default,,0,0,0,,Бұл жолы дүкен меңгерушісінің тосын сыйымен өзімді алдадым және С.
Dialogue: 0,0:11:45.46,0:11:46.63,Default,,0,0,0,,Таку
Dialogue: 0,0:11:47.72,0:11:50.55,Default,,0,0,0,,Мына сұмдық не істеп жүр?
Dialogue: 0,0:11:51.39,0:11:53.18,Default,,0,0,0,,Мен тезекпін
Dialogue: 0,0:11:53.18,0:11:55.85,Default,,0,0,0,,Әй, ас үйде тезек шығарма.
Dialogue: 0,0:11:55.89,0:11:58.06,Default,,0,0,0,,Енді бұл шынымен де анық.
Dialogue: 0,0:11:58.23,0:11:59.02,Default,,0,0,0,,Мицугу
Dialogue: 0,0:11:59.60,0:12:00.65,Default,,0,0,0,,Мицугу?
Dialogue: 0,0:12:01.06,0:12:03.65,Default,,0,0,0,,Иә, тек жаттығу үшін.
Dialogue: 0,0:12:04.19,0:12:07.03,Default,,0,0,0,,Маған сәнді тәттілерден тұратын буфет сыйламаңыз.
Dialogue: 0,0:12:07.11,0:12:07.65,Default,,0,0,0,,(Мектеп оқушысы) Ой, Хори ханым саған бұны өзі жасап берді ме? Өте сүйкімді екен~
Dialogue: 0,0:12:08.78,0:12:11.74,Default,,0,0,0,,Бірақ сыйлық - жақсы идея.
Dialogue: 0,0:12:13.62,0:12:16.62,Default,,0,0,0,,Мен бұрынғы адамнан аздап басқашамын.
Dialogue: 0,0:12:25.75,0:12:27.25,Default,,0,0,0,,Үзіліс жасаңыз.
Dialogue: 0,0:12:33.72,0:12:34.43,Default,,0,0,0,,Ичиго-сан
Dialogue: 0,0:12:35.39,0:12:36.81,Default,,0,0,0,,Маған тамақ беріңізші.
Dialogue: 0,0:12:38.06,0:12:41.77,Default,,0,0,0,,Жарайды, бұл мөлшер тағам ассортиментінен асып түседі.
Dialogue: 0,0:12:41.94,0:12:43.98,Default,,0,0,0,,Менде бұл мүмкін емес.
Dialogue: 0,0:12:45.31,0:12:48.36,Default,,0,0,0,,Олай болса, тағы бірдеңе керек пе?
Dialogue: 0,0:12:48.65,0:12:49.94,Default,,0,0,0,,Маған бірдеңе айтыңыз
Dialogue: 0,0:12:52.36,0:12:55.41,Default,,0,0,0,,Маған үзіліс қажет емес.
Dialogue: 0,0:12:55.41,0:12:56.95,Default,,0,0,0,,Ичиго-сан
Dialogue: 0,0:13:01.33,0:13:03.83,Default,,0,0,0,,Не болды? Неге күрсініп тұрсың?
Dialogue: 0,0:13:04.13,0:13:05.50,Default,,0,0,0,,Капитан, 3D маневрге көшейік
Dialogue: 0,0:13:06.34,0:13:08.42,Default,,0,0,0,,Негізі үзіліс кезінде
Dialogue: 0,0:13:09.13,0:13:12.63,Default,,0,0,0,,Дүкен менеджері маған тым қымбат ұсыныс жасады.
Dialogue: 0,0:13:13.97,0:13:16.47,Default,,0,0,0,,Мен естідім
Dialogue: 0,0:13:17.10,0:13:18.97,Default,,0,0,0,,Ата-ана балаларын тастап кеткенде
Dialogue: 0,0:13:19.52,0:13:20.77,Default,,0,0,0,,Соңғы рет болғандықтан
Dialogue: 0,0:13:21.14,0:13:23.31,Default,,0,0,0,,Олар кенет той ұсынады.
Dialogue: 0,0:13:23.85,0:13:26.56,Default,,0,0,0,,Мен жұмыстан шығарыламын ба?
Dialogue: 0,0:13:26.73,0:13:28.36,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:13:28.52,0:13:29.73,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:13:29.98,0:13:32.61,Default,,0,0,0,,Бұл соңғы кешкі ас болды ма?
Dialogue: 0,0:13:33.90,0:13:34.74,Default,,0,0,0,,Олардың жылдамдығы да, күші де бір сәт бұрынғыдан мүлде өзгеше — басқа адам сияқты.
Dialogue: 0,0:13:35.28,0:13:37.03,Default,,0,0,0,,Бұл дұрыс емес, Ичиго-сан.
Dialogue: 0,0:13:37.32,0:13:38.28,Default,,0,0,0,,Дүкен менеджері
Dialogue: 0,0:13:38.78,0:13:40.54,Default,,0,0,0,,Біз қайта құрылымдамаймыз.
Dialogue: 0,0:13:40.79,0:13:43.04,Default,,0,0,0,,Ичиго-сан, осында мәңгі қалуыңды өтінемін.
Dialogue: 0,0:13:43.46,0:13:45.75,Default,,0,0,0,,Менің бүгін жеткізгім келгені
Dialogue: 0,0:13:47.25,0:13:48.50,Default,,0,0,0,,Мен жеткізгім келген нәрсе болды
Dialogue: 0,0:13:49.25,0:13:51.63,Default,,0,0,0,,Ичигока-сан туралы
Dialogue: 0,0:13:54.76,0:13:57.30,Default,,0,0,0,,Бұл маған Скоблды ұнататынын білдіреді.
Dialogue: 0,0:13:59.47,0:14:00.89,Default,,0,0,0,,Мен-Солай ма?
Dialogue: 0,0:14:01.43,0:14:05.19,Default,,0,0,0,,Маған дүкен менеджері Скобл да ұнайды.
Dialogue: 0,0:14:05.31,0:14:07.06,Default,,0,0,0,,Өте
Dialogue: 0,0:14:07.35,0:14:08.48,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:14:08.61,0:14:10.69,Default,,0,0,0,,Иә, Скоблдың айтқаны дұрыс.
Dialogue: 0,0:14:12.07,0:14:13.11,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:29.79,0:14:32.25,Default,,0,0,0,,Мен де қолжазба қағазын сатып алдым.
Dialogue: 0,0:14:32.51,0:14:35.47,Default,,0,0,0,,Енді келесі оқиғаға дейін шығудың қажеті жоқ
Dialogue: 0,0:14:37.05,0:14:38.09,Default,,0,0,0,,Хидери-чан
Dialogue: 0,0:14:43.31,0:14:43.81,Default,,0,0,0,,Yahoo
Dialogue: 0,0:14:46.38,0:14:49.68,Default,,0,0,0,,Хидери Чан
Dialogue: 0,0:14:53.44,0:14:56.07,Default,,0,0,0,,Смартфонға берілгенім сонша, байқамай қалдым.
Dialogue: 0,0:14:56.45,0:14:58.41,Default,,0,0,0,,Жаяу жүру кезінде смартфонды пайдалану қауіпті
Dialogue: 0,0:14:59.57,0:15:00.83,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:15:01.37,0:15:04.45,Default,,0,0,0,,Айтпақшы, Миу әдетте көзілдірік киеді.
Dialogue: 0,0:15:04.83,0:15:06.71,Default,,0,0,0,,Толық емес жұмыс күні мен байланыстағы адаммын.
Dialogue: 0,0:15:06.91,0:15:08.71,Default,,0,0,0,,Мен әдетте көзілдірік киемін.
Dialogue: 0,0:15:09.50,0:15:11.21,Default,,0,0,0,,Не, бұл пұттың ерекшелігі қандай?
Dialogue: 0,0:15:11.29,0:15:13.17,Default,,0,0,0,,Мен оны мойындамаймын.
Dialogue: 0,0:15:13.42,0:15:14.67,Default,,0,0,0,,Бос спецификация?
Dialogue: 0,0:15:15.88,0:15:19.30,Default,,0,0,0,,Сақтықты түсірудің қажеті жоқ.
Dialogue: 0,0:15:19.89,0:15:22.76,Default,,0,0,0,,Сонымен, сіз бүгін инкогнито режимінде сатып алуға барасыз ба?
Dialogue: 0,0:15:24.31,0:15:26.77,Default,,0,0,0,,Мен инкогнито сияқты емеспін.
Dialogue: 0,0:15:27.48,0:15:29.44,Default,,0,0,0,,Хидери-чан да шоппинг жасай ма?
Dialogue: 0,0:15:30.73,0:15:33.82,Default,,0,0,0,,Мен жаңа киім іздеймін, өйткені мен оны қалаймын.
Dialogue: 0,0:15:34.65,0:15:37.15,Default,,0,0,0,,Мен жақсы ештеңе таба алмаймын.
Dialogue: 0,0:15:37.78,0:15:39.03,Default,,0,0,0,,Мен не айта аламын?
Dialogue: 0,0:15:39.24,0:15:43.49,Default,,0,0,0,,Менің сүйкімділігіме сай келетін киімім жоқ.
Dialogue: 0,0:15:43.78,0:15:46.37,Default,,0,0,0,,Онда мен сенімен бірге іздеймін.
Dialogue: 0,0:15:47.25,0:15:50.12,Default,,0,0,0,,Менің киімімді мен киіп жатырмын.
Dialogue: 0,0:15:50.29,0:15:54.04,Default,,0,0,0,,Мен өзімнің киімімді қоса алғанда, өзім сияқты болғым келеді.
Dialogue: 0,0:15:57.59,0:15:59.72,Default,,0,0,0,,Сіз нені қалайсыз?
Dialogue: 0,0:16:02.01,0:16:04.01,Default,,0,0,0,,Сіз не іздеп жүрсіз?
Dialogue: 0,0:16:04.43,0:16:06.60,Default,,0,0,0,,Бірінші шарт сүйкімді
Dialogue: 0,0:16:06.93,0:16:09.52,Default,,0,0,0,,Мен де әсер алғым келеді.
Dialogue: 0,0:16:09.81,0:16:11.94,Default,,0,0,0,,Алшақтықты мақсат ету туралы не деуге болады?
Dialogue: 0,0:16:12.10,0:16:14.52,Default,,0,0,0,,Гап моеға ұмтылу жақсы.
Dialogue: 0,0:16:21.53,0:16:23.16,Default,,0,0,0,,Жоқ, сүйкімді
Dialogue: 0,0:16:23.28,0:16:25.95,Default,,0,0,0,,Маған сүйкімді әзілдер керек емес.
Dialogue: 0,0:16:26.37,0:16:27.58,Default,,0,0,0,,(Иура) Жарайды, жарайды. (Мотоко) Оны қолыңмен тиме.
Dialogue: 0,0:16:27.66,0:16:29.58,Default,,0,0,0,,Хидери-чан оны кигісі келеді.
Dialogue: 0,0:16:30.92,0:16:33.25,Default,,0,0,0,,Менің әлеуетімді ашатын киім
Dialogue: 0,0:16:35.71,0:16:38.30,Default,,0,0,0,,Кослоли ше?
Dialogue: 0,0:16:38.63,0:16:40.17,Default,,0,0,0,,сүйкімді сүйкімді
Dialogue: 0,0:16:40.17,0:16:43.64,Default,,0,0,0,,Әрине, мен оны кигендіктен.
Dialogue: 0,0:16:45.85,0:16:47.64,Default,,0,0,0,,Ойды оқи алатын экстрасенс
Dialogue: 0,0:16:48.06,0:16:49.93,Default,,0,0,0,,Аузыңызды жабыңыз
Dialogue: 0,0:16:52.90,0:16:57.23,Default,,0,0,0,,Бірақ Кослоли қымбат, сондықтан ол менің бюджетіме сәйкес келмейді.
Dialogue: 0,0:16:57.69,0:17:02.86,Default,,0,0,0,,Косплей лоли жұмыс істемесе, сәл жетілген нәрсені қосып көріңіз.
Dialogue: 0,0:17:03.41,0:17:06.45,Default,,0,0,0,,Бұл сексуалдық бағыт па? Бұл жақсы.
Dialogue: 0,0:17:07.20,0:17:11.25,Default,,0,0,0,,Бірақ мен мұнымен толықтай келісемін.
Dialogue: 0,0:17:11.54,0:17:16.21,Default,,0,0,0,,Жанкүйерлер үшін тым ынталандыруы мүмкін
Dialogue: 0,0:17:19.42,0:17:22.22,Default,,0,0,0,,Эй, жұмсақ нан киюді доғаршы.
Dialogue: 0,0:17:27.35,0:17:31.64,Default,,0,0,0,,Алда дүкен бар, келесі жолы сол жерге қарайық.
Dialogue: 0,0:17:32.89,0:17:36.94,Default,,0,0,0,,Не болды? Мен біраздан бері қыбырлап жүрмін.
Dialogue: 0,0:17:37.31,0:17:40.40,Default,,0,0,0,,Мен гүл теруге барғым келеді.
Dialogue: 0,0:17:41.53,0:17:42.53,Default,,0,0,0,,Ах, дәретхана.
Dialogue: 0,0:17:43.57,0:17:48.03,Default,,0,0,0,,Жоқ, мен пұт ретінде дәретханаға баруым мүмкін емес.
Dialogue: 0,0:17:48.28,0:17:49.33,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:17:51.95,0:17:54.58,Default,,0,0,0,,Тоқта, соққы қазір
Dialogue: 0,0:17:58.00,0:17:59.09,Default,,0,0,0,,Гүл жинау
Dialogue: 0,0:18:01.17,0:18:04.38,Default,,0,0,0,,Хидери-чан, әжетхана бар.
Dialogue: 0,0:18:04.47,0:18:05.80,Default,,0,0,0,,Өйткені
Dialogue: 0,0:18:06.01,0:18:09.14,Default,,0,0,0,,Бұл әжетхана емес, мен гүл теріп жатырмын.
Dialogue: 0,0:18:09.47,0:18:13.35,Default,,0,0,0,,Олай болса, гүл іздеуге барамыз ба?
Dialogue: 0,0:18:14.35,0:18:16.81,Default,,0,0,0,,Әзірше, дәл қазір, сіз дәретхананы пайдалана аласыз.
Dialogue: 0,0:18:17.19,0:18:18.02,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:18:18.23,0:18:19.31,Default,,0,0,0,,О, дұрыс. Сенде де Хиёри-чаннан сұрағың келетін нәрсе бар емес пе?
Dialogue: 0,0:18:23.32,0:18:25.40,Default,,0,0,0,,Жанжалды зейнеткерлікке шығуды мақсат етпеңіз
Dialogue: 0,0:18:25.61,0:18:26.49,Default,,0,0,0,,Құдайдың жазасы зұлымдыққа тиеді.
Dialogue: 0,0:18:26.99,0:18:27.95,Default,,0,0,0,,Бұл жолы
Dialogue: 0,0:18:32.37,0:18:33.33,Default,,0,0,0,,Иә? Ол жарасады.
Dialogue: 0,0:18:33.58,0:18:34.75,Default,,0,0,0,,Сонда неге?
Dialogue: 0,0:18:36.87,0:18:38.96,Default,,0,0,0,,Бұл ұқыпты
Dialogue: 0,0:18:44.17,0:18:46.97,Default,,0,0,0,,Мен дәл қазір не болар екен деп ойладым.
Dialogue: 0,0:18:47.34,0:18:51.18,Default,,0,0,0,,Көшеде құлап кетсе, үлкен жанжал болар еді.
Dialogue: 0,0:18:51.18,0:18:52.06,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:18:54.89,0:18:56.14,Default,,0,0,0,,Не болды?
Dialogue: 0,0:18:56.60,0:19:01.23,Default,,0,0,0,,Сатып алған қолжазба қағазым ауыр болғандықтан, өзімді сәл тұрақсыз сезіндім.
Dialogue: 0,0:19:03.40,0:19:05.11,Default,,0,0,0,,Маған бір сәтке қарызға беріңізші.
Dialogue: 0,0:19:07.99,0:19:10.28,Default,,0,0,0,,Қағаз өте ауыр.
Dialogue: 0,0:19:10.45,0:19:13.37,Default,,0,0,0,,Жарайды, мен оны саған аламын.
Dialogue: 0,0:19:13.87,0:19:17.37,Default,,0,0,0,,Қайта қаңғып кетсең маған ыңғайсыздық тудырар еді.
Dialogue: 0,0:19:17.75,0:19:22.54,Default,,0,0,0,,Бұл қырыққабат тасымалданатын картон қораптармен салыстырғанда ештеңе емес.
Dialogue: 0,0:19:23.71,0:19:26.80,Default,,0,0,0,,мен үшін әлсіз параметр.
Dialogue: 0,0:19:28.93,0:19:29.97,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:19:37.23,0:19:40.35,Default,,0,0,0,,Мен әдемі көрінетін киім таба алмаймын.
Dialogue: 0,0:19:40.52,0:19:43.02,Default,,0,0,0,,Түрлі дүкендерді араладым.
Dialogue: 0,0:19:43.48,0:19:46.40,Default,,0,0,0,,Стилдің шыңына бұлай жете алмайсың.
Dialogue: 0,0:19:47.40,0:19:48.57,Default,,0,0,0,,Мен соны мақсат еттім.
Dialogue: 0,0:19:49.53,0:19:53.49,Default,,0,0,0,,Әй, жақсырақ, оны сатып алмай, өзіңіз жасап көріңіз.
Dialogue: 0,0:19:54.66,0:19:57.37,Default,,0,0,0,,Негізі мен оны бірнеше рет жасап көрдім.
Dialogue: 0,0:19:57.37,0:20:01.67,Default,,0,0,0,,Мен бұл туралы тым ерекше болдым, және материалдар мен күткеннен қымбатқа түсті.
Dialogue: 0,0:20:02.00,0:20:05.92,Default,,0,0,0,,Мен оны аяқтаған кезде маусым өзгерді, мен оны кие алмадым.
Dialogue: 0,0:20:06.42,0:20:09.13,Default,,0,0,0,,Оның үстіне тренд аяқталды.
Dialogue: 0,0:20:10.22,0:20:13.47,Default,,0,0,0,,Маусымдық материалды пайдаланып кітап жасағанда солай болады.
Dialogue: 0,0:20:14.76,0:20:17.52,Default,,0,0,0,,Иә, егер сіз ваннаны жек көрмесеңіз.
Dialogue: 0,0:20:17.68,0:20:20.60,Default,,0,0,0,,Мафую-саннан қажет емес киім бар ма деп сұрайын ба?
Dialogue: 0,0:20:22.44,0:20:24.94,Default,,0,0,0,,Мафую қандай киім киген?
Dialogue: 0,0:20:25.40,0:20:28.86,Default,,0,0,0,,Мен өзімнен басқа ешкімді қызықтырмайтындықтан, есімде жоқ.
Dialogue: 0,0:20:29.57,0:20:32.03,Default,,0,0,0,,Өйткені Мафуйю-сан кішкентай.
Dialogue: 0,0:20:34.87,0:20:39.08,Default,,0,0,0,,Мен күткендей туфли кимеймін.
Dialogue: 0,0:20:39.58,0:20:40.75,Default,,0,0,0,,Смок?
Dialogue: 0,0:20:45.42,0:20:46.63,Default,,0,0,0,,Уау өте сүйкімді
Dialogue: 0,0:20:46.63,0:20:47.59,Default,,0,0,0,,жеткілікті.
Dialogue: 0,0:20:48.13,0:20:50.76,Default,,0,0,0,,Косплей сіздің хоббиіңіз ме, Мафую-сан?
Dialogue: 0,0:20:51.63,0:20:52.80,Default,,0,0,0,,Мен алмаймын.
Dialogue: 0,0:20:53.14,0:20:55.10,Default,,0,0,0,,Мен жаңа ғана костюм сатып алдым және көңілім қалды.
Dialogue: 0,0:20:56.14,0:21:01.10,Default,,0,0,0,,Бұл ескі киімнен гөрі косплей костюмі емес пе?
Dialogue: 0,0:21:01.60,0:21:02.98,Default,,0,0,0,,Бұл сүйкімді
Dialogue: 0,0:21:03.06,0:21:04.98,Default,,0,0,0,,Мен бұны киіп далада жүре алмаймын.
Dialogue: 0,0:21:05.06,0:21:07.61,Default,,0,0,0,,Ол TPO Benero деп аталады.
Dialogue: 0,0:21:07.94,0:21:08.78,Default,,0,0,0,,Енді, енді.
Dialogue: 0,0:21:08.94,0:21:09.82,Default,,0,0,0,,Иә
Dialogue: 0,0:21:10.74,0:21:11.70,Default,,0,0,0,,Өзің бар
Dialogue: 0,0:21:12.07,0:21:14.36,Default,,0,0,0,,Бұл да Мафуйю-сан болуы мүмкін бе?
Dialogue: 0,0:21:14.74,0:21:18.04,Default,,0,0,0,,Неге екені белгісіз, лақтырып тастай алмай қалдым.
Dialogue: 0,0:21:18.58,0:21:22.21,Default,,0,0,0,,Ри-чанды жасыру
Dialogue: 0,0:21:23.08,0:21:24.63,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:21:25.42,0:21:26.50,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:21:26.71,0:21:29.17,Default,,0,0,0,,Сіз менімен ойнауды жоспарлаған едіңіз.
Dialogue: 0,0:21:29.46,0:21:30.30,Default,,0,0,0,,Енді, енді.
Dialogue: 0,0:21:30.51,0:21:31.42,Default,,0,0,0,,Бізден басқа барлығы Сакурадзима-сенпайды ұмытып қалған болар.
Dialogue: 0,0:21:34.13,0:21:37.05,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:23:10.98,0:23:13.94,Default,,0,0,0,,Қош келдіңіз, ағайын!
Dialogue: 0,0:23:14.15,0:23:16.11,Default,,0,0,0,,Мен көптен күттім!
Dialogue: 0,0:23:21.37,0:23:25.33,Default,,0,0,0,,Бүгін мен сендерді жаңа доспен таныстырамын.
Dialogue: 0,0:23:25.95,0:23:28.67,Default,,0,0,0,,Бұл Хидери-чан!
Dialogue: 0,0:23:35.71,0:23:36.21,Default,,0,0,0,,Келесі жолы
Dialogue: 0,0:23:36.40,0:23:40.00,Default,,0,0,0,,Иенің тағайындалуы Invasion мырза
Dialogue: 0,0:23:41.50,0:23:47.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory