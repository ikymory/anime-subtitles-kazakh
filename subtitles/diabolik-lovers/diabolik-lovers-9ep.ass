Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:13.03,0:00:20.04,OP-JP,,0000,0000,0000,,Айлы түннің тыныштығын үзу
Dialogue: 0,0:00:20.08,0:00:26.79,OP-JP,,0000,0000,0000,,Мен оның артынан жүгірген сайын сенімім арта түсті
Dialogue: 0,0:00:27.13,0:00:31.38,OP-JP,,0000,0000,0000,,Күтпеген өлімші әйел
Dialogue: 0,0:00:31.38,0:00:36.93,OP-JP,,0000,0000,0000,,Сиқырланған, Қанға қайнаған
Dialogue: 0,0:00:36.97,0:00:44.02,OP-JP,,0000,0000,0000,,Бүктелген алақанда жарқыраған күміс крест
Dialogue: 0,0:00:44.02,0:00:47.48,OP-JP,,0000,0000,0000,,Садизмнің шыңы
Dialogue: 0,0:00:47.48,0:00:49.11,OP-JP,,0000,0000,0000,,Сіз көбірек алғыңыз келеді, солай ма?
Dialogue: 0,0:00:49.23,0:00:54.78,OP-JP,,0000,0000,0000,,Жүр, жыла, айқай
Dialogue: 0,0:00:54.78,0:01:00.41,OP-JP,,0000,0000,0000,,Қатты толып жатқан қып-қызыл серпін
Dialogue: 0,0:01:00.41,0:01:06.04,OP-JP,,0000,0000,0000,,Бүгін түнде мен сені қатты пышақтаймын
Dialogue: 0,0:01:06.12,0:01:11.55,OP-JP,,0000,0000,0000,,Ішінен шарасыз тілек оянады
Dialogue: 0,0:01:12.84,0:01:14.16,OP-JP,,0000,0000,0000,,Қарқынды болыңыз
Dialogue: 0,0:01:14.16,0:01:19.76,OP-JP,,0000,0000,0000,,Төзгісіз азап пен ләззат күнә ма?
Dialogue: 0,0:01:19.76,0:01:22.47,OP-JP,,0000,0000,0000,,Қорқынышты таң ата
Dialogue: 0,0:01:22.47,0:01:25.23,OP-JP,,0000,0000,0000,,Қан соратын тағдырға ант ет
Dialogue: 0,0:01:25.23,0:01:31.57,OP-JP,,0000,0000,0000,,Дұрыс, біз Садистік түн мырзамыз
Dialogue: 0,0:01:32.48,0:01:36.61,Staff,,0000,0000,0000,,Осы субтитр көзімен жасалған, God Subtitles Group (kamigami.org), жеткізу алмасу оқыту, коммерциялық мақсатта пайдалануға тыйым салынған
Dialogue: 0,0:01:36.61,0:01:41.58,Staff,,0000,0000,0000,,Жапония және аудармасы: Мори Луо Бірінші мектеп: Нега Соңғы мектеп: Арис Уақыты: Гисса мектебі: Хисака
Dialogue: 0,0:01:44.02,0:01:45.61,JP,,0000,0000,0000,,Сәлем, Минерва!
Dialogue: 0,0:01:47.47,0:01:50.85,JP,,0000,0000,0000,,Ерте тұру
Dialogue: 0,0:01:53.81,0:01:54.86,JP,,0000,0000,0000,,Корделия
Dialogue: 0,0:02:07.92,0:02:08.98,JP,,0000,0000,0000,,Не болды?
Dialogue: 0,0:02:09.87,0:02:11.33,JP,,0000,0000,0000,,Жүрек тағы...
Dialogue: 0,0:02:42.74,0:02:43.36,JP,,0000,0000,0000,,Тоқта!
Dialogue: 0,0:02:46.10,0:02:47.26,JP,,0000,0000,0000,,Жарайды, осы ғана. Абай бол.
Dialogue: 0,0:02:48.23,0:02:48.67,JP,,0000,0000,0000,,Иә?
Dialogue: 0,0:02:50.52,0:02:55.08,JP,,0000,0000,0000,,Ым, Шу-сан...?
Dialogue: 0,0:03:00.40,0:03:01.84,JP,,0000,0000,0000,,Бұл бір нәрсе үшін бе?
Dialogue: 0,0:03:03.74,0:03:05.36,JP,,0000,0000,0000,,Мазалағаным үшін кешіріңіз
Dialogue: 0,0:03:12.94,0:03:14.74,JP,,0000,0000,0000,,Бұл мен...
Dialogue: 0,0:03:16.09,0:03:17.80,JP,,0000,0000,0000,,Соңғы кездері біртүрлі болып кетті.
Dialogue: 0,0:03:19.26,0:03:23.62,JP,,0000,0000,0000,,Әйелдің дауысын естіп, үлпілдеп сезіну
Dialogue: 0,0:03:26.65,0:03:29.30,JP,,0000,0000,0000,,Мен өзім емес сияқтымын
Dialogue: 0,0:03:31.12,0:03:34.76,JP,,0000,0000,0000,,Эй, онда кел.
Dialogue: 0,0:03:35.05,0:03:35.47,JP,,0000,0000,0000,,Иә?
Dialogue: 0,0:03:45.61,0:03:47.96,JP,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:03:49.42,0:03:50.26,JP,,0000,0000,0000,,Жібер
Dialogue: 0,0:04:11.50,0:04:14.77,JP,,0000,0000,0000,,Сіздің қаныңыз өзгерді
Dialogue: 0,0:04:16.06,0:04:18.34,JP,,0000,0000,0000,,Оянуға жақын.
Dialogue: 0,0:04:19.24,0:04:19.83,JP,,0000,0000,0000,,Иә?
Dialogue: 0,0:04:21.90,0:04:24.11,JP,,0000,0000,0000,,Сіздің қаныңыз қазір
Dialogue: 0,0:04:31.41,0:04:34.82,JP,,0000,0000,0000,,Күн ыстық.
Dialogue: 0,0:04:48.51,0:04:52.86,JP,,0000,0000,0000,,Тек қана мойыннан қан кетпейді.
Dialogue: 0,0:04:55.84,0:04:59.54,JP,,0000,0000,0000,,Бұл білекте де жаңа қан бар.
Dialogue: 0,0:05:01.82,0:05:04.14,JP,,0000,0000,0000,,Тері арқылы да көруге болады
Dialogue: 0,0:05:05.04,0:05:06.50,JP,,0000,0000,0000,,Бұл жақсы иіс.
Dialogue: 0,0:05:09.17,0:05:10.45,JP,,0000,0000,0000,,Қозғалмаңыз
Dialogue: 0,0:05:20.71,0:05:23.05,JP,,0000,0000,0000,,Сіздің қаныңыз ең жақсы.
Dialogue: 0,0:05:24.09,0:05:26.54,JP,,0000,0000,0000,,Мен мұны мойындаймын.
Dialogue: 0,0:05:28.86,0:05:30.55,JP,,0000,0000,0000,,Сіз қорқасыз ба?
Dialogue: 0,0:05:31.39,0:05:36.36,JP,,0000,0000,0000,,Мен сенің қорқынышты көздеріңді көргенді жек көрмеймін.
Dialogue: 0,0:05:47.67,0:05:50.83,JP,,0000,0000,0000,,Сенің қаның басқалардан артық
Dialogue: 0,0:05:51.78,0:05:54.38,JP,,0000,0000,0000,,Әрбір шөлді қандырады
Dialogue: 0,0:05:56.33,0:05:59.09,JP,,0000,0000,0000,,Шу-сан, №.
Dialogue: 0,0:06:00.98,0:06:04.17,JP,,0000,0000,0000,,Бұл ояту ма?
Dialogue: 0,0:06:07.76,0:06:09.80,JP,,0000,0000,0000,,Әйелдер қорқынышты
Dialogue: 0,0:06:10.51,0:06:13.10,JP,,0000,0000,0000,,Мен де қызып бара жатырмын
Dialogue: 0,0:06:13.76,0:06:16.13,JP,,0000,0000,0000,,Сіз кереметсіз.
Dialogue: 0,0:06:16.94,0:06:19.64,JP,,0000,0000,0000,,Ояну дегеніміз не?
Dialogue: 0,0:06:21.15,0:06:22.00,JP,,0000,0000,0000,,Үйрет бізге.
Dialogue: 0,0:06:25.33,0:06:30.01,JP,,0000,0000,0000,,Құрбандыққа шалынған қалыңдық оянуға жақын қалған жоқ.
Dialogue: 0,0:06:31.01,0:06:33.85,JP,,0000,0000,0000,,Құрбандық шалатын қалыңдық
Dialogue: 0,0:06:38.62,0:06:43.15,JP,,0000,0000,0000,,Ол маған келесі күні хабарласты.
Dialogue: 0,0:06:44.32,0:06:48.89,JP,,0000,0000,0000,,Шіркеуден қонақ келеді, сондықтан оны құрметтеңіз.
Dialogue: 0,0:06:49.34,0:06:53.24,JP,,0000,0000,0000,,Аа, бұл кеудесі жоқ әйел әлеуетті келін дегенді білдіре ме?
Dialogue: 0,0:06:53.24,0:06:53.73,JP,,0000,0000,0000,,Иә?
Dialogue: 0,0:06:53.73,0:06:55.33,JP,,0000,0000,0000,,Осыны айтып тұрсың ба?
Dialogue: 0,0:06:56.57,0:06:59.79,JP,,0000,0000,0000,,Қалыңдық – құрбандық, солай ма?
Dialogue: 0,0:07:01.96,0:07:07.26,JP,,0000,0000,0000,,Менің мұнда келуімнің нақты себебі неде?
Dialogue: 0,0:07:08.69,0:07:12.02,JP,,0000,0000,0000,,Сенің әкең мен бұл отбасы жай таныс емес.
Dialogue: 0,0:07:15.45,0:07:17.37,JP,,0000,0000,0000,,Қалғанын одан сұра.
Dialogue: 0,0:07:17.50,0:07:18.05,JP,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:18.93,0:07:20.24,JP,,0000,0000,0000,,Менің ойымша, бар
Dialogue: 0,0:07:22.71,0:07:24.54,JP,,0000,0000,0000,,Әдеттегідей, сізде жақсы интуиция бар.
Dialogue: 0,0:07:31.84,0:07:33.85,JP,,0000,0000,0000,,Бұл кім?
Dialogue: 0,0:07:37.16,0:07:38.20,JP,,0000,0000,0000,,Рихтер
Dialogue: 0,0:07:39.76,0:07:41.48,JP,,0000,0000,0000,,Ол біздің ағамыз.
Dialogue: 0,0:08:07.08,0:08:09.61,JP,,0000,0000,0000,,Менің жиендерімнің дөрекілігі үшін кешірім сұраймын.
Dialogue: 0,0:08:10.23,0:08:13.26,JP,,0000,0000,0000,,Қанша талпынсам да, аузымды тыңдау тәсілімнен арыла алмаймын.
Dialogue: 0,0:08:14.45,0:08:17.94,JP,,0000,0000,0000,,Енді не білгің келеді?
Dialogue: 0,0:08:19.69,0:08:22.73,JP,,0000,0000,0000,,Бұл мен...
Dialogue: 0,0:08:24.49,0:08:26.38,JP,,0000,0000,0000,,Мен мұнда не үшін келдім
Dialogue: 0,0:08:27.17,0:08:29.60,JP,,0000,0000,0000,,Мен неге таңдалдым?
Dialogue: 0,0:08:32.08,0:08:37.02,JP,,0000,0000,0000,,Құрбандық шалуға әкенің қатысы бар ма?
Dialogue: 0,0:08:40.81,0:08:42.02,JP,,0000,0000,0000,,Таңдалған?
Dialogue: 0,0:08:42.79,0:08:44.89,JP,,0000,0000,0000,,Менмен болған жақсы
Dialogue: 0,0:08:45.32,0:08:45.81,JP,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:46.86,0:08:49.05,JP,,0000,0000,0000,,Сіз бұл үйге келген себебіңіз
Dialogue: 0,0:08:49.50,0:08:55.28,JP,,0000,0000,0000,,Өйткені ол келін болуға жасы келіп, жалғыз қол жетімді болатын.
Dialogue: 0,0:08:56.43,0:08:59.74,JP,,0000,0000,0000,,Сіз мұны қажеттілік немесе кездейсоқтық деп қабылдайсыз ба?
Dialogue: 0,0:09:00.21,0:09:03.39,JP,,0000,0000,0000,,Ақымақ адамдар осылай ойлайды
Dialogue: 0,0:09:04.46,0:09:05.83,JP,,0000,0000,0000,,Сонда менің әкем?
Dialogue: 0,0:09:06.22,0:09:09.78,JP,,0000,0000,0000,,Бұл сенің әкең сияқты адамға қатысым жоқ.
Dialogue: 0,0:09:11.06,0:09:15.46,JP,,0000,0000,0000,,Әке, мен шынымен де ештеңе білмедім.
Dialogue: 0,0:09:16.59,0:09:17.35,JP,,0000,0000,0000,,Жақсы
Dialogue: 0,0:09:34.30,0:09:37.91,JP,,0000,0000,0000,,А, біз кездесе аламыз.
Dialogue: 0,0:09:39.33,0:09:41.91,JP,,0000,0000,0000,,Соңында сізге
Dialogue: 0,0:09:44.73,0:09:47.78,JP,,0000,0000,0000,,Осы сәтті қанша күттім!
Dialogue: 0,0:09:49.11,0:09:51.79,JP,,0000,0000,0000,,Маған кел
Dialogue: 0,0:10:09.92,0:10:11.91,JP,,0000,0000,0000,,Не болып жатыр?
Dialogue: 0,0:10:29.31,0:10:30.58,JP,,0000,0000,0000,,Келесі кезекте біз
Dialogue: 0,0:10:32.39,0:10:34.04,JP,,0000,0000,0000,,Сол адамға
Dialogue: 0,0:11:04.36,0:11:07.26,JP,,0000,0000,0000,,Маған бұл енді керек емес.
Dialogue: 0,0:11:37.32,0:11:39.29,JP,,0000,0000,0000,,Екіленудің қажеті жоқ
Dialogue: 0,0:11:40.22,0:11:43.19,JP,,0000,0000,0000,,Бұл сіздің көйлегіңіз.
Dialogue: 0,0:12:14.38,0:12:18.46,JP,,0000,0000,0000,,Біз ақыры кездестік, Рихтер.
Dialogue: 0,0:12:23.89,0:12:26.15,JP,,0000,0000,0000,,Құрметті Корделия
Dialogue: 0,0:13:38.10,0:13:38.84,JP,,0000,0000,0000,,Эй
Dialogue: 0,0:14:32.15,0:14:34.59,JP,,0000,0000,0000,,Ылғал шашты көтеріп, кесіңіз
Dialogue: 0,0:14:34.68,0:14:36.78,JP,,0000,0000,0000,,Жалқаулық пен сараңдықтың сүйісі
Dialogue: 0,0:14:37.54,0:14:40.54,JP,,0000,0000,0000,,Тегіс мойынға гүлдей берсін
Dialogue: 0,0:14:41.06,0:14:42.90,JP,,0000,0000,0000,,Оны сүртсең де жоғалмайды
Dialogue: 0,0:14:43.11,0:14:45.01,JP,,0000,0000,0000,,Өлім күнәсының маркасы
Dialogue: 0,0:14:46.99,0:14:50.34,JP,,0000,0000,0000,,Маған не істегіңіз келетінін айтыңыз.
Dialogue: 0,0:14:51.84,0:14:57.84,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory