Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.95,0:00:19.95,OP-JP,,0000,0000,0000,,Айлы түннің тыныштығын үзу
Dialogue: 0,0:00:19.99,0:00:26.71,OP-JP,,0000,0000,0000,,Мен оның артынан жүгірген сайын сенімім арта түсті
Dialogue: 0,0:00:27.04,0:00:31.30,OP-JP,,0000,0000,0000,,Күтпеген өлімші әйел
Dialogue: 0,0:00:31.30,0:00:36.84,OP-JP,,0000,0000,0000,,Сиқырланған, Қанға қайнаған
Dialogue: 0,0:00:36.89,0:00:43.94,OP-JP,,0000,0000,0000,,Бүктелген алақанда жарқыраған күміс крест
Dialogue: 0,0:00:43.94,0:00:47.40,OP-JP,,0000,0000,0000,,Садизмнің шыңы
Dialogue: 0,0:00:47.40,0:00:49.02,OP-JP,,0000,0000,0000,,Сіз көбірек алғыңыз келеді, солай ма?
Dialogue: 0,0:00:49.15,0:00:54.70,OP-JP,,0000,0000,0000,,Жүр, жыла, айқай
Dialogue: 0,0:00:54.70,0:01:00.33,OP-JP,,0000,0000,0000,,Қатты толып жатқан қып-қызыл серпін
Dialogue: 0,0:01:00.33,0:01:05.96,OP-JP,,0000,0000,0000,,Бүгін түнде мен сені қатты пышақтаймын
Dialogue: 0,0:01:06.04,0:01:11.46,OP-JP,,0000,0000,0000,,Ішінен шарасыз тілек оянады
Dialogue: 0,0:01:12.76,0:01:14.09,OP-JP,,0000,0000,0000,,Қарқынды болыңыз
Dialogue: 0,0:01:14.09,0:01:19.68,OP-JP,,0000,0000,0000,,Төзгісіз азап пен ләззат күнә ма?
Dialogue: 0,0:01:19.68,0:01:22.39,OP-JP,,0000,0000,0000,,Қорқынышты таң ата
Dialogue: 0,0:01:22.39,0:01:25.14,OP-JP,,0000,0000,0000,,Қан соратын тағдырға ант ет
Dialogue: 0,0:01:25.14,0:01:31.48,OP-JP,,0000,0000,0000,,Дұрыс, біз Садистік түн мырзамыз
Dialogue: 0,0:01:32.40,0:01:36.53,Staff,,0000,0000,0000,,Осы субтитр көзімен жасалған, God Subtitles Group (kamigami.org), жеткізу алмасу оқыту, коммерциялық мақсатта пайдалануға тыйым салынған
Dialogue: 0,0:01:36.53,0:01:41.49,Staff,,0000,0000,0000,,Жапония және аудармасы: Мори Луо Бірінші мектеп: Нега Соңғы мектеп: Арис Уақыты: Гисса мектебі: Хисака
Dialogue: 0,0:01:39.90,0:01:43.33,JP,,0000,0000,0000,,Мен мұны істеген кезде өткенге оралғандай болдым.
Dialogue: 0,0:01:44.28,0:01:48.39,JP,,0000,0000,0000,,Уақытты ұмытып түні бойы билеген түн
Dialogue: 0,0:01:49.75,0:01:52.05,JP,,0000,0000,0000,,Кеше болғандай
Dialogue: 0,0:01:54.88,0:01:57.97,JP,,0000,0000,0000,,Корделия... Әпке
Dialogue: 0,0:01:58.70,0:02:00.84,JP,,0000,0000,0000,,Мен сені әдейі осылай атадым.
Dialogue: 0,0:02:01.01,0:02:03.92,JP,,0000,0000,0000,,Сіз әлі біртүрлі адамсыз.
Dialogue: 0,0:02:04.81,0:02:06.44,JP,,0000,0000,0000,,Әдейі емес
Dialogue: 0,0:02:07.56,0:02:12.79,JP,,0000,0000,0000,,Сенің ағамның әйелі екенің сөзсіз
Dialogue: 0,0:02:13.94,0:02:19.94,JP,,0000,0000,0000,,Мен ағаммен сен үшін төбелесіп, жеңілген адаммын.
Dialogue: 0,0:02:21.02,0:02:22.78,JP,,0000,0000,0000,,Сені ұмыту үшін
Dialogue: 0,0:02:23.67,0:02:26.10,JP,,0000,0000,0000,,Бұл дүниеде жүздеген жылдар кезіп
Dialogue: 0,0:02:26.10,0:02:26.83,JP,,0000,0000,0000,,Бұл сенсің ғой, иә?
Dialogue: 0,0:02:27.38,0:02:30.11,JP,,0000,0000,0000,,Ұмытудың қажеті жоқ
Dialogue: 0,0:02:30.86,0:02:34.35,JP,,0000,0000,0000,,Карлхайнцтың мұндай міндеттемесі жоқ.
Dialogue: 0,0:02:35.06,0:02:35.84,JP,,0000,0000,0000,,Жоқ
Dialogue: 0,0:02:37.84,0:02:41.82,JP,,0000,0000,0000,,Сіз мені осыған жауап беруге мәжбүрлегеніңіз үшін жаман адамсыз.
Dialogue: 0,0:02:43.23,0:02:45.72,JP,,0000,0000,0000,,Сен сүйкімдісің, Рихтер.
Dialogue: 0,0:02:46.20,0:02:48.99,JP,,0000,0000,0000,,Жарайды, орындалды.
Dialogue: 0,0:02:49.45,0:02:53.81,JP,,0000,0000,0000,,Өйткені мен дәл сен қалағандай тірілдім.
Dialogue: 0,0:02:54.13,0:02:55.70,JP,,0000,0000,0000,,Эй, сен нені меңзеп тұрсың?
Dialogue: 0,0:02:56.86,0:03:00.03,JP,,0000,0000,0000,,Эй, Аято, біраз уақыт болды.
Dialogue: 0,0:03:01.74,0:03:04.22,JP,,0000,0000,0000,,Сіз... неге?
Dialogue: 0,0:03:04.95,0:03:10.88,JP,,0000,0000,0000,,Мені қайта көргеніме қуаныштымын деп келдің деп ойламаймын...
Dialogue: 0,0:03:12.08,0:03:14.39,JP,,0000,0000,0000,,Мен мұнда не үшін келдім?
Dialogue: 0,0:03:14.85,0:03:18.58,JP,,0000,0000,0000,,Рихтер, маған айтып бере аласыз ба?
Dialogue: 0,0:03:20.32,0:03:22.86,JP,,0000,0000,0000,,Мен кішкене демаламын.
Dialogue: 0,0:03:23.67,0:03:26.70,JP,,0000,0000,0000,,Мен бұл денеге әлі үйренбегенмін.
Dialogue: 0,0:03:27.32,0:03:32.03,JP,,0000,0000,0000,,Мына бала есінен танып жатса да мені қуып жібермекші.
Dialogue: 0,0:03:33.54,0:03:34.90,JP,,0000,0000,0000,,Мен шаршадым
Dialogue: 0,0:03:35.22,0:03:38.96,JP,,0000,0000,0000,,Ол әлі толық менің денем болған жоқ.
Dialogue: 0,0:03:50.89,0:03:53.40,JP,,0000,0000,0000,,Сен оған не істедің?
Dialogue: 0,0:04:12.50,0:04:16.80,JP,,0000,0000,0000,,О, Корделия, не деген...
Dialogue: 0,0:04:17.96,0:04:19.48,JP,,0000,0000,0000,,Мұны кім жасады?
Dialogue: 0,0:04:20.86,0:04:24.02,JP,,0000,0000,0000,,Рихтер, өтінемін.
Dialogue: 0,0:04:25.08,0:04:26.59,JP,,0000,0000,0000,,Сізге не керек?
Dialogue: 0,0:04:27.43,0:04:29.68,JP,,0000,0000,0000,,Менің денем енді жоқ...
Dialogue: 0,0:04:30.76,0:04:34.36,JP,,0000,0000,0000,,Жүрегімді ойып ал
Dialogue: 0,0:04:36.39,0:04:42.15,JP,,0000,0000,0000,,Содан кейін оны басқа біреудің денесіне ауыстырыңыз.
Dialogue: 0,0:04:43.04,0:04:48.83,JP,,0000,0000,0000,,Тек осылай ғана аман қалуыңыз мүмкін.
Dialogue: 0,0:04:50.16,0:04:55.59,JP,,0000,0000,0000,,Уақыты келгенде тағы кездесеміз.
Dialogue: 0,0:04:59.79,0:05:00.95,JP,,0000,0000,0000,,Мен асығуым керек
Dialogue: 0,0:05:01.76,0:05:05.74,JP,,0000,0000,0000,,Сол қыз менің денемді өртеуге келеді.
Dialogue: 0,0:05:07.15,0:05:07.96,JP,,0000,0000,0000,,Не болды, Ниа?
Dialogue: 0,0:05:42.37,0:05:46.56,JP,,0000,0000,0000,,Мен сені тірілтуге уәде беремін.
Dialogue: 0,0:05:51.21,0:05:54.03,JP,,0000,0000,0000,,Оған дейін сәл қоштасамыз.
Dialogue: 0,0:05:59.60,0:06:03.47,JP,,0000,0000,0000,,Сонда бұл жүрек оның ішінде?
Dialogue: 0,0:06:05.06,0:06:07.61,JP,,0000,0000,0000,,Ол үшін ол жай ғана ыдыс.
Dialogue: 0,0:06:08.66,0:06:12.26,JP,,0000,0000,0000,,Ол әлі де бар, әрең.
Dialogue: 0,0:06:13.18,0:06:15.48,JP,,0000,0000,0000,,Бірақ бір рет оянып кетті
Dialogue: 0,0:06:15.99,0:06:19.89,JP,,0000,0000,0000,,Оның жаны бұл дүниеден мәңгілікке жоғалады
Dialogue: 0,0:06:20.65,0:06:22.43,JP,,0000,0000,0000,,Тек Корделия қалды
Dialogue: 0,0:06:23.97,0:06:27.90,JP,,0000,0000,0000,,Иә, оянуға жақын екеніңізді білуіңіз керек.
Dialogue: 0,0:06:35.28,0:06:38.26,JP,,0000,0000,0000,,Сұлу ай бүгін түнде де жарқырап тұр.
Dialogue: 0,0:06:48.89,0:06:50.54,JP,,0000,0000,0000,,Біз не істеуіміз керек, Аято?
Dialogue: 0,0:06:51.43,0:06:53.16,JP,,0000,0000,0000,,Мені тағы да өлтір
Dialogue: 0,0:06:55.16,0:06:58.14,JP,,0000,0000,0000,,Мен жүзуді жақсы білмедім.
Dialogue: 0,0:06:59.06,0:07:01.66,JP,,0000,0000,0000,,Иә, бірақ
Dialogue: 0,0:07:03.33,0:07:06.63,JP,,0000,0000,0000,,Менің арқасында жақсы болдыңыз.
Dialogue: 0,0:07:08.10,0:07:10.99,JP,,0000,0000,0000,,Енді сіздің кезегіңіз
Dialogue: 0,0:07:13.91,0:07:15.32,JP,,0000,0000,0000,,Сіз білесіз
Dialogue: 0,0:07:15.72,0:07:18.78,JP,,0000,0000,0000,,Мен жүзуді жақсы білемін.
Dialogue: 0,0:07:29.33,0:07:30.98,JP,,0000,0000,0000,,Не?
Dialogue: 0,0:07:32.12,0:07:34.88,JP,,0000,0000,0000,,Бұл бала жүзе алмайды.
Dialogue: 0,0:07:39.67,0:07:40.61,JP,,0000,0000,0000,,Жоғал
Dialogue: 0,0:07:42.80,0:07:44.45,JP,,0000,0000,0000,,Аято...сіз
Dialogue: 0,0:07:53.76,0:07:54.52,JP,,0000,0000,0000,,Аято-кун
Dialogue: 0,0:07:59.63,0:08:01.98,JP,,0000,0000,0000,,Мен неге көлдемін?
Dialogue: 0,0:08:03.61,0:08:05.82,JP,,0000,0000,0000,,Ал мына көйлек
Dialogue: 0,0:08:06.72,0:08:08.02,JP,,0000,0000,0000,,Эй, Аято-кун
Dialogue: 0,0:08:10.78,0:08:12.67,JP,,0000,0000,0000,,Эх, Аято-кун
Dialogue: 0,0:08:13.24,0:08:15.29,JP,,0000,0000,0000,,Өте шулысың, аузыңды жап.
Dialogue: 0,0:08:16.94,0:08:21.27,JP,,0000,0000,0000,,Менің денем мүмкін емес шөлдеді
Dialogue: 0,0:08:21.92,0:08:23.38,JP,,0000,0000,0000,,Мен сенің қаныңды алғым келеді
Dialogue: 0,0:08:36.18,0:08:37.31,JP,,0000,0000,0000,,Керемет
Dialogue: 0,0:08:38.21,0:08:42.78,JP,,0000,0000,0000,,Бұрын болған оқиғаны салыстыруға болмайды.
Dialogue: 0,0:08:50.46,0:08:52.14,JP,,0000,0000,0000,,Бұл менің бірінші рет
Dialogue: 0,0:08:52.95,0:08:55.84,JP,,0000,0000,0000,,Егер менде бұл қан болса, мен...
Dialogue: 0,0:08:59.90,0:09:00.66,JP,,0000,0000,0000,,Тоқта
Dialogue: 0,0:09:01.90,0:09:03.42,JP,,0000,0000,0000,,Сіз бас тарта аласыз ба?
Dialogue: 0,0:09:03.74,0:09:05.12,JP,,0000,0000,0000,,Сондай тәтті қан
Dialogue: 0,0:09:06.10,0:09:07.88,JP,,0000,0000,0000,,Сен менікісің
Dialogue: 0,0:09:08.45,0:09:14.67,JP,,0000,0000,0000,,Бұл қан, жүрек, дене, ақыл, бәрі.
Dialogue: 0,0:09:17.11,0:09:20.22,JP,,0000,0000,0000,,Қаныңды өмір бойы маған ғана тапсыр
Dialogue: 0,0:09:25.01,0:09:26.20,JP,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:09:27.44,0:09:30.01,JP,,0000,0000,0000,,Ақыры ойымды түсіндім.
Dialogue: 0,0:09:30.74,0:09:35.50,JP,,0000,0000,0000,,Біртүрлі деп ойладым, бұл күндері Юидің қанының иісі.
Dialogue: 0,0:09:35.94,0:09:40.53,JP,,0000,0000,0000,,Тәтті болғаны сонша, иіскесең де, жынды болып кетесің.
Dialogue: 0,0:09:41.70,0:09:45.62,JP,,0000,0000,0000,,Тедди, ұстану қиын болды, солай емес пе?
Dialogue: 0,0:09:46.65,0:09:51.63,JP,,0000,0000,0000,,Егер мен сол қанды ішсем, мен өзімді қанағат тұтатыныма сенімдімін.
Dialogue: 0,0:09:52.41,0:09:56.17,JP,,0000,0000,0000,,Осыны ойлаудың өзі мені толқытады.
Dialogue: 0,0:10:10.64,0:10:14.54,JP,,0000,0000,0000,,Мұның бәрін өзіңе жасыра алмайсың, Аято-кун.
Dialogue: 0,0:10:15.08,0:10:18.33,JP,,0000,0000,0000,,Біз де оның дәмін татқымыз келеді.
Dialogue: 0,0:10:18.76,0:10:20.41,JP,,0000,0000,0000,,Сіз білесіз бе?
Dialogue: 0,0:10:44.16,0:10:46.27,JP,,0000,0000,0000,,Маған олай иіс шығарма.
Dialogue: 0,0:10:46.27,0:10:46.81,JP,,0000,0000,0000,,Субару-кун
Dialogue: 0,0:11:04.48,0:11:05.29,JP,,0000,0000,0000,,Мен бір қолымда оқпен жүктелген винтовка ұстап тұрмын
Dialogue: 0,0:11:06.80,0:11:10.40,JP,,0000,0000,0000,,Мен саған азу тістерімді көбірек сездіремін
Dialogue: 0,0:11:15.78,0:11:18.19,JP,,0000,0000,0000,,Мен сені осылай құртамын.
Dialogue: 0,0:11:19.22,0:11:20.49,JP,,0000,0000,0000,,Мен шыдай алмаймын
Dialogue: 0,0:11:21.22,0:11:25.55,JP,,0000,0000,0000,,Сіздің қаныңыз көбірек
Dialogue: 0,0:11:26.28,0:11:28.09,JP,,0000,0000,0000,,Соңғы тамшыға дейін
Dialogue: 0,0:11:28.91,0:11:29.99,JP,,0000,0000,0000,,Мендік бол
Dialogue: 0,0:11:41.57,0:11:43.46,JP,,0000,0000,0000,,Біз қорқамыз ба?
Dialogue: 0,0:11:44.19,0:11:44.97,JP,,0000,0000,0000,,Жоқ.
Dialogue: 0,0:11:45.79,0:11:50.11,JP,,0000,0000,0000,,Менде мұндай нәрсе болса, мен не істерімді білмеймін.
Dialogue: 0,0:11:51.57,0:11:52.22,JP,,0000,0000,0000,,Сонымен...
Dialogue: 0,0:11:58.09,0:11:59.42,JP,,0000,0000,0000,,Сізде бар.
Dialogue: 0,0:11:59.69,0:12:00.15,JP,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:08.48,0:12:10.86,JP,,0000,0000,0000,,Сол қаныңыз сізді жынды етеді.
Dialogue: 0,0:12:12.38,0:12:14.81,JP,,0000,0000,0000,,Олар бүгін басқаша болды.
Dialogue: 0,0:12:15.60,0:12:16.41,JP,,0000,0000,0000,,Менің ойымша.
Dialogue: 0,0:12:17.41,0:12:18.79,JP,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:12:19.38,0:12:23.42,JP,,0000,0000,0000,,Оянғалы тұрған қаныңа қызығады.
Dialogue: 0,0:12:23.85,0:12:25.53,JP,,0000,0000,0000,,Мен өз-өзімнен қалдым.
Dialogue: 0,0:12:26.77,0:12:30.02,JP,,0000,0000,0000,,Оны өзіңіздікіне айналдыруға тырысыңыз
Dialogue: 0,0:12:30.88,0:12:33.10,JP,,0000,0000,0000,,Бұл жекпе-жек болады.
Dialogue: 0,0:12:34.10,0:12:35.59,JP,,0000,0000,0000,,Соңында
Dialogue: 0,0:12:36.24,0:12:39.57,JP,,0000,0000,0000,,Барлығы да қатыгез өліммен өледі
Dialogue: 0,0:12:40.27,0:12:40.89,JP,,0000,0000,0000,,Бұл...
Dialogue: 0,0:12:42.35,0:12:43.33,JP,,0000,0000,0000,,Оны мойындаңыз.
Dialogue: 0,0:12:43.95,0:12:48.06,JP,,0000,0000,0000,,Сіз мұның болатынын терең білуіңіз керек.
Dialogue: 0,0:12:51.85,0:12:52.74,JP,,0000,0000,0000,,Моги мырзадан Цукидің қозғалысын бақылап отыруды сұраңызшы.
Dialogue: 0,0:12:54.66,0:12:59.39,JP,,0000,0000,0000,,Ойламасаң да, жауабы өзінен өзі келеді.
Dialogue: 0,0:13:00.96,0:13:02.72,JP,,0000,0000,0000,,Тек оны қабылдаңыз
Dialogue: 0,0:13:03.80,0:13:07.97,JP,,0000,0000,0000,,Қорықпа, бұл сенің тағдырың сияқты
Dialogue: 0,0:13:45.76,0:13:49.22,JP,,0000,0000,0000,,Толық ояну уақыты келді.
Dialogue: 0,0:13:55.74,0:13:57.02,JP,,0000,0000,0000,,Корделия
Dialogue: 0,0:14:32.26,0:14:34.19,JP,,0000,0000,0000,,Тазалық пердесін кесу
Dialogue: 0,0:14:34.81,0:14:36.19,JP,,0000,0000,0000,,Қан ішу
Dialogue: 0,0:14:37.08,0:14:38.89,JP,,0000,0000,0000,,Сіз оны ешкімге бермейсіз
Dialogue: 0,0:14:39.38,0:14:41.28,JP,,0000,0000,0000,,Қанша күрессем де
Dialogue: 0,0:14:41.74,0:14:44.71,JP,,0000,0000,0000,,Мен сені енді құшағымнан қашуға жол бермеймін
Dialogue: 0,0:14:46.82,0:14:50.39,JP,,0000,0000,0000,,Өз ойыңызды босатыңыз және шатастырыңыз.
Dialogue: 0,0:14:51.89,0:14:57.89,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory