Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.90,0:00:19.91,OP-JP,,0000,0000,0000,,Айлы түннің тыныштығын үзу
Dialogue: 0,0:00:19.95,0:00:26.67,OP-JP,,0000,0000,0000,,Мен оның артынан жүгірген сайын сенімім арта түсті
Dialogue: 0,0:00:27.00,0:00:31.26,OP-JP,,0000,0000,0000,,Күтпеген өлімші әйел
Dialogue: 0,0:00:31.26,0:00:36.80,OP-JP,,0000,0000,0000,,Сиқырланған, Қанға қайнаған
Dialogue: 0,0:00:36.84,0:00:43.89,OP-JP,,0000,0000,0000,,Бүктелген алақанда жарқыраған күміс крест
Dialogue: 0,0:00:43.89,0:00:47.36,OP-JP,,0000,0000,0000,,Садизмнің шыңы
Dialogue: 0,0:00:47.36,0:00:48.98,OP-JP,,0000,0000,0000,,Сіз көбірек алғыңыз келеді, солай ма?
Dialogue: 0,0:00:49.11,0:00:54.65,OP-JP,,0000,0000,0000,,Жүр, жыла, айқай
Dialogue: 0,0:00:54.65,0:01:00.28,OP-JP,,0000,0000,0000,,Қатты толып жатқан қып-қызыл серпін
Dialogue: 0,0:01:00.28,0:01:05.92,OP-JP,,0000,0000,0000,,Бүгін түнде мен сені қатты пышақтаймын
Dialogue: 0,0:01:06.00,0:01:11.42,OP-JP,,0000,0000,0000,,Ішінен шарасыз тілек оянады
Dialogue: 0,0:01:12.71,0:01:14.03,OP-JP,,0000,0000,0000,,Қарқынды болыңыз
Dialogue: 0,0:01:14.03,0:01:19.64,OP-JP,,0000,0000,0000,,Төзгісіз азап пен ләззат күнә ма?
Dialogue: 0,0:01:19.64,0:01:22.35,OP-JP,,0000,0000,0000,,Қорқынышты таң ата
Dialogue: 0,0:01:22.35,0:01:25.10,OP-JP,,0000,0000,0000,,Қан соратын тағдырға ант ет
Dialogue: 0,0:01:25.10,0:01:31.44,OP-JP,,0000,0000,0000,,Дұрыс, біз Садистік түн мырзамыз
Dialogue: 0,0:01:32.35,0:01:36.49,Staff,,0000,0000,0000,,Осы субтитр көзімен жасалған, God Subtitles Group (kamigami.org), жеткізу алмасу оқыту, коммерциялық мақсатта пайдалануға тыйым салынған
Dialogue: 0,0:01:36.49,0:01:41.46,Staff,,0000,0000,0000,,Жапония және аудармасы: Мори Луо Бірінші мектеп: Нега Соңғы мектеп: Ариса Уақыты: Жоғары сыныпты жылан жүйесі: Хисука
Dialogue: 0,0:02:03.64,0:02:04.41,JP,,0000,0000,0000,,Фортепиано
Dialogue: 0,0:02:19.72,0:02:21.43,JP,,0000,0000,0000,,Эй, қаншық-чан
Dialogue: 0,0:02:22.11,0:02:25.29,JP,,0000,0000,0000,,Сізбен осында кездескеніме өте қуаныштымын.
Dialogue: 0,0:02:35.89,0:02:36.87,JP,,0000,0000,0000,,Жарық мырза
Dialogue: 0,0:02:38.24,0:02:41.79,JP,,0000,0000,0000,,Мен күлгін көйлек киген адамды білемін.
Dialogue: 0,0:02:44.29,0:02:48.76,JP,,0000,0000,0000,,Шашы ұзын сұлу әйел
Dialogue: 0,0:02:54.46,0:02:56.42,JP,,0000,0000,0000,,Неліктен мұны білгің келеді?
Dialogue: 0,0:02:57.92,0:03:00.63,JP,,0000,0000,0000,,Сен мұндай жерде не істеп жүрсің?
Dialogue: 0,0:03:01.59,0:03:04.17,JP,,0000,0000,0000,,Аято-кун Канато-кун
Dialogue: 0,0:03:07.31,0:03:10.95,JP,,0000,0000,0000,,Әй, бәрінің анасының аты кім?
Dialogue: 0,0:03:12.09,0:03:12.99,JP,,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:03:30.06,0:03:31.13,JP,,0000,0000,0000,,Корделия
Dialogue: 0,0:03:48.89,0:03:51.36,JP,,0000,0000,0000,,Аято...
Dialogue: 0,0:04:02.24,0:04:04.61,JP,,0000,0000,0000,,Аа, бұл лас.
Dialogue: 0,0:04:05.70,0:04:08.47,JP,,0000,0000,0000,,Маған бұл көйлек қатты ұнады.
Dialogue: 0,0:04:09.91,0:04:12.42,JP,,0000,0000,0000,,Мен анамның қанына малындым.
Dialogue: 0,0:04:19.13,0:04:22.11,JP,,0000,0000,0000,,Ананың қаны тәтті
Dialogue: 0,0:04:23.74,0:04:26.54,JP,,0000,0000,0000,,Бұл өте дәмді
Dialogue: 0,0:04:28.47,0:04:29.87,JP,,0000,0000,0000,,Мен көбірек алғым келеді
Dialogue: 0,0:05:01.35,0:05:05.19,JP,,0000,0000,0000,,Жарық...Жарық
Dialogue: 0,0:05:08.08,0:05:11.07,JP,,0000,0000,0000,,Не болды?
Dialogue: 0,0:05:13.12,0:05:16.27,JP,,0000,0000,0000,,Аято...мен...
Dialogue: 0,0:05:17.12,0:05:19.90,JP,,0000,0000,0000,,Осыны ескере отырып...
Dialogue: 0,0:05:21.50,0:05:23.49,JP,,0000,0000,0000,,Иә, иә.
Dialogue: 0,0:05:25.03,0:05:29.41,JP,,0000,0000,0000,,Мен бұл ерте ме, кеш пе болады деп ойладым.
Dialogue: 0,0:05:30.77,0:05:34.75,JP,,0000,0000,0000,,Жарық маған көмектес
Dialogue: 0,0:05:44.63,0:05:46.59,JP,,0000,0000,0000,,Аято келді.
Dialogue: 0,0:05:47.82,0:05:50.41,JP,,0000,0000,0000,,Мені өлтіру үшін
Dialogue: 0,0:05:58.76,0:06:02.63,JP,,0000,0000,0000,,Бұл Аято-кун емес, жай жел.
Dialogue: 0,0:06:05.69,0:06:06.79,JP,,0000,0000,0000,,Қорықпа.
Dialogue: 0,0:06:13.08,0:06:14.90,JP,,0000,0000,0000,,Мен сені қорғаймын
Dialogue: 0,0:06:39.87,0:06:43.59,JP,,0000,0000,0000,,Ол Аятоны қуып жіберді.
Dialogue: 0,0:06:44.54,0:06:46.56,JP,,0000,0000,0000,,Иә, ол кетті.
Dialogue: 0,0:06:48.29,0:06:52.90,JP,,0000,0000,0000,,Өйткені, мен саған ғана арқа сүйеймін, Жарық.
Dialogue: 0,0:06:53.66,0:06:55.85,JP,,0000,0000,0000,,Мен сені басқалардан артық жақсы көремін
Dialogue: 0,0:06:56.29,0:06:57.41,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:07:05.70,0:07:07.74,JP,,0000,0000,0000,,Сіз әрқашан осындайсыз, солай емес пе?
Dialogue: 0,0:07:13.62,0:07:16.01,JP,,0000,0000,0000,,Жарық Мен сені сүйемін
Dialogue: 0,0:07:16.92,0:07:18.06,JP,,0000,0000,0000,,Бұл – Екінші зерттеу флотилиясы!!
Dialogue: 0,0:07:39.09,0:07:43.08,JP,,0000,0000,0000,,Енді ол мәңгі менікі
Dialogue: 0,0:07:52.84,0:07:55.75,JP,,0000,0000,0000,,Анашым, не болды?
Dialogue: 0,0:07:58.64,0:08:01.44,JP,,0000,0000,0000,,Кеудемде тесік бар, Анашым.
Dialogue: 0,0:08:05.47,0:08:07.55,JP,,0000,0000,0000,,Оян, анашым.
Dialogue: 0,0:08:10.98,0:08:12.72,JP,,0000,0000,0000,,Жүрек қайда орналасқан?
Dialogue: 0,0:08:15.52,0:08:17.01,JP,,0000,0000,0000,,Оны бірге табайық
Dialogue: 0,0:08:18.51,0:08:19.27,JP,,0000,0000,0000,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:08:20.77,0:08:23.30,JP,,0000,0000,0000,,Ол өлді, ана.
Dialogue: 0,0:08:26.18,0:08:27.25,JP,,0000,0000,0000,,Салқын.
Dialogue: 0,0:08:28.46,0:08:29.75,JP,,0000,0000,0000,,Ылғалды
Dialogue: 0,0:08:30.99,0:08:33.75,JP,,0000,0000,0000,,Анашым, бұл суық емес пе?
Dialogue: 0,0:08:35.24,0:08:38.27,JP,,0000,0000,0000,,Енді мен сені жылытамын.
Dialogue: 0,0:08:56.87,0:08:59.42,JP,,0000,0000,0000,,Әй, жылы ана.
Dialogue: 0,0:09:02.35,0:09:03.47,JP,,0000,0000,0000,,Айтыңызшы
Dialogue: 0,0:09:03.86,0:09:05.33,JP,,0000,0000,0000,,Жылы
Dialogue: 0,0:09:34.13,0:09:39.52,JP,,0000,0000,0000,,Жоқ, мен енді бұған шыдай алмаймын.
Dialogue: 0,0:09:40.43,0:09:42.89,JP,,0000,0000,0000,,Сол үшін қашуым керек еді.
Dialogue: 0,0:09:45.10,0:09:46.06,JP,,0000,0000,0000,,Субару-кун
Dialogue: 0,0:09:49.22,0:09:50.86,JP,,0000,0000,0000,,Субару-кун, білесің бе?
Dialogue: 0,0:09:51.47,0:09:54.67,JP,,0000,0000,0000,,Аято мен басқалары өз анасына не істеді?
Dialogue: 0,0:09:56.74,0:09:58.11,JP,,0000,0000,0000,,Ал егер
Dialogue: 0,0:10:00.00,0:10:03.30,JP,,0000,0000,0000,,Субару-кун, пышақты неге маған бердіңіз?
Dialogue: 0,0:10:05.26,0:10:06.09,JP,,0000,0000,0000,,Ол мойнын қорғап қалды
Dialogue: 0,0:10:07.19,0:10:08.66,JP,,0000,0000,0000,,Менімен араласпа
Dialogue: 0,0:10:09.09,0:10:11.93,JP,,0000,0000,0000,,Егер жақынырақ келсең, мен сені құртамын.
Dialogue: 0,0:10:12.59,0:10:14.49,JP,,0000,0000,0000,,Бұл сіздің денеңіз ғана емес
Dialogue: 0,0:10:14.49,0:10:16.25,JP,,0000,0000,0000,,Жүрек - бәрі
Dialogue: 0,0:10:41.08,0:10:43.23,JP,,0000,0000,0000,,Қамал мұнарасындағы әйел
Dialogue: 0,0:10:44.33,0:10:46.02,JP,,0000,0000,0000,,Субарудың анасы?
Dialogue: 0,0:10:46.40,0:10:48.96,JP,,0000,0000,0000,,Сен не білесің?
Dialogue: 0,0:10:49.98,0:10:51.70,JP,,0000,0000,0000,,Субару-кун, ауырып тұр.
Dialogue: 0,0:10:53.07,0:10:53.92,JP,,0000,0000,0000,,Жібер
Dialogue: 0,0:10:56.00,0:10:57.19,JP,,0000,0000,0000,,Тартымды дәм, дәм, дәм
Dialogue: 0,0:10:58.92,0:11:03.05,JP,,0000,0000,0000,,Менде құдірет жоқ, шіркін, арам адаммын.
Dialogue: 0,0:11:04.35,0:11:05.82,JP,,0000,0000,0000,,«Дио»—бұл ат па?
Dialogue: 0,0:11:09.62,0:11:10.21,JP,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:22.39,0:11:24.32,JP,,0000,0000,0000,,Субару...kun
Dialogue: 0,0:11:26.28,0:11:27.03,JP,,0000,0000,0000,,Цк
Dialogue: 0,0:11:41.99,0:11:44.22,JP,,0000,0000,0000,,Керемет тәтті
Dialogue: 0,0:11:58.60,0:11:59.31,JP,,0000,0000,0000,,Жоқ
Dialogue: 0,0:12:00.64,0:12:01.59,JP,,0000,0000,0000,,Шулы
Dialogue: 0,0:12:01.92,0:12:03.17,JP,,0000,0000,0000,,Акселераторға да қолым жетпейді – орындық тым үлкен.
Dialogue: 0,0:12:21.51,0:12:24.45,JP,,0000,0000,0000,,Мен одан күміс пышақты неге бергісі келетінін сұрадым.
Dialogue: 0,0:12:24.86,0:12:25.69,JP,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:27.67,0:12:31.31,JP,,0000,0000,0000,,Қаласам, мені пышақтай аласыз.
Dialogue: 0,0:12:31.71,0:12:34.60,JP,,0000,0000,0000,,А, бұл мүмкін!
Dialogue: 0,0:12:34.60,0:12:35.98,JP,,0000,0000,0000,,Егер алмасаңыз
Dialogue: 0,0:12:36.76,0:12:39.53,JP,,0000,0000,0000,,Онымен өзіңді пышақтап, бітесің.
Dialogue: 0,0:12:41.10,0:12:41.84,JP,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:45.61,0:12:47.71,JP,,0000,0000,0000,,Сіздің бас тартуға құқығыңыз жоқ.
Dialogue: 0,0:12:49.07,0:12:52.24,JP,,0000,0000,0000,,Менен сорып бас тарта алмайтын сияқтысың.
Dialogue: 0,0:13:01.83,0:13:02.98,JP,,0000,0000,0000,,Енді Л тергеу мәліметтерінің маған тарағанын түсінгеннен кейін,
Dialogue: 0,0:13:04.01,0:13:08.37,JP,,0000,0000,0000,,Бар болғаны аузыңды жауып, азу тістерімді қабылдасаң болғаны.
Dialogue: 0,0:13:10.02,0:13:11.27,JP,,0000,0000,0000,,Мәңгі
Dialogue: 0,0:13:42.59,0:13:44.02,JP,,0000,0000,0000,,Ах Аято-кун
Dialogue: 0,0:13:44.68,0:13:45.81,JP,,0000,0000,0000,,Барлығы осында
Dialogue: 0,0:13:46.21,0:13:46.89,JP,,0000,0000,0000,,Бірақ
Dialogue: 0,0:13:46.89,0:13:47.74,JP,,0000,0000,0000,,Үндетпе
Dialogue: 0,0:13:50.84,0:13:54.47,JP,,0000,0000,0000,,Сіз маған қарсы шықпайсыз.
Dialogue: 0,0:14:32.18,0:14:35.32,JP,,0000,0000,0000,,Менің білетінім – жойылу, мен білгім келмейді
Dialogue: 0,0:14:36.36,0:14:38.59,JP,,0000,0000,0000,,Бақыланбайтын тітіркену
Dialogue: 0,0:14:39.06,0:14:41.81,JP,,0000,0000,0000,,Температура көтеріліп бара жатқанда жеп қойыңыз
Dialogue: 0,0:14:42.90,0:14:45.45,JP,,0000,0000,0000,,Осы шөлді қандырмайынша
Dialogue: 0,0:14:47.04,0:14:48.27,JP,,0000,0000,0000,,Алыс болыңыз
Dialogue: 0,0:14:48.71,0:14:50.62,JP,,0000,0000,0000,,Мен оны жойғым келеді
Dialogue: 0,0:14:52.12,0:14:58.12,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory