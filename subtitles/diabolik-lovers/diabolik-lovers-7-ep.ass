Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.90,0:00:19.91,OP-JP,,0000,0000,0000,,Айлы түннің тыныштығын үзу
Dialogue: 0,0:00:19.95,0:00:26.67,OP-JP,,0000,0000,0000,,Мен оның артынан жүгірген сайын сенімім арта түсті
Dialogue: 0,0:00:27.00,0:00:31.26,OP-JP,,0000,0000,0000,,Күтпеген өлімші әйел
Dialogue: 0,0:00:31.26,0:00:36.80,OP-JP,,0000,0000,0000,,Сиқырланған, Қанға қайнаған
Dialogue: 0,0:00:36.84,0:00:43.89,OP-JP,,0000,0000,0000,,Бүктелген алақанда жарқыраған күміс крест
Dialogue: 0,0:00:43.89,0:00:47.36,OP-JP,,0000,0000,0000,,Садизмнің шыңы
Dialogue: 0,0:00:47.36,0:00:48.98,OP-JP,,0000,0000,0000,,Сіз көбірек алғыңыз келеді, солай ма?
Dialogue: 0,0:00:49.11,0:00:54.65,OP-JP,,0000,0000,0000,,Жүр, жыла, айқай
Dialogue: 0,0:00:54.65,0:01:00.28,OP-JP,,0000,0000,0000,,Қатты толып жатқан қып-қызыл серпін
Dialogue: 0,0:01:00.28,0:01:05.92,OP-JP,,0000,0000,0000,,Бүгін түнде мен сені қатты пышақтаймын
Dialogue: 0,0:01:06.00,0:01:11.42,OP-JP,,0000,0000,0000,,Ішінен шарасыз тілек оянады
Dialogue: 0,0:01:12.71,0:01:14.11,OP-JP,,0000,0000,0000,,Қарқынды болыңыз
Dialogue: 0,0:01:14.11,0:01:19.64,OP-JP,,0000,0000,0000,,Төзгісіз азап пен ләззат күнә ма?
Dialogue: 0,0:01:19.64,0:01:22.35,OP-JP,,0000,0000,0000,,Қорқынышты таң ата
Dialogue: 0,0:01:22.35,0:01:25.10,OP-JP,,0000,0000,0000,,Қан соратын тағдырға ант ет
Dialogue: 0,0:01:25.10,0:01:31.44,OP-JP,,0000,0000,0000,,Дұрыс, біз Садистік түн мырзамыз
Dialogue: 0,0:01:32.35,0:01:36.49,Staff,,0000,0000,0000,,Осы субтитр көзімен жасалған, God Subtitles Group (kamigami.org), жеткізу алмасу оқыту, коммерциялық мақсатта пайдалануға тыйым салынған
Dialogue: 0,0:01:36.49,0:01:41.46,Staff,,0000,0000,0000,,Жапония және аудармасы: Мори Луо Бірінші мектеп: Нега Соңғы мектеп: Арис Уақыты: Гисса мектебі: Хисака
Dialogue: 0,0:01:52.42,0:01:53.28,JP,,0000,0000,0000,,Арман...
Dialogue: 0,0:02:00.73,0:02:01.83,JP,,0000,0000,0000,,Қатты жаңбыр
Dialogue: 0,0:02:12.06,0:02:13.78,JP,,0000,0000,0000,,Кім?
Dialogue: 0,0:03:39.11,0:03:40.42,JP,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:03:42.11,0:03:43.88,JP,,0000,0000,0000,,Мұнда…қайда
Dialogue: 0,0:03:53.85,0:03:56.73,JP,,0000,0000,0000,,Мен ұстаған жарқанат қашып кетті.
Dialogue: 0,0:03:57.10,0:03:59.14,JP,,0000,0000,0000,,Канато-кун, сен жылама.
Dialogue: 0,0:03:59.57,0:04:01.32,JP,,0000,0000,0000,,Бұл заттар бірден ұсталады.
Dialogue: 0,0:04:01.62,0:04:04.12,JP,,0000,0000,0000,,Дұрыс айтасың, араласпа.
Dialogue: 0,0:04:04.57,0:04:06.88,JP,,0000,0000,0000,,Мына Аято-сама мені ұстап алады.
Dialogue: 0,0:04:07.53,0:04:08.36,JP,,0000,0000,0000,,Аято
Dialogue: 0,0:04:13.52,0:04:15.48,JP,,0000,0000,0000,,Мен осындай жерде болдым
Dialogue: 0,0:04:16.10,0:04:17.50,JP,,0000,0000,0000,,Тез кел
Dialogue: 0,0:04:19.41,0:04:22.66,JP,,0000,0000,0000,,Ол кісі бұрын аулада болған...
Dialogue: 0,0:04:26.12,0:04:27.47,JP,,0000,0000,0000,,Канато-кун, кеттік.
Dialogue: 0,0:04:27.60,0:04:28.22,JP,,0000,0000,0000,,О
Dialogue: 0,0:04:31.55,0:04:34.24,JP,,0000,0000,0000,,Енді үйге барып сабақ оқы.
Dialogue: 0,0:04:34.59,0:04:35.82,JP,,0000,0000,0000,,Жоқ, жоқ, жоқ.
Dialogue: 0,0:04:36.15,0:04:38.97,JP,,0000,0000,0000,,Мен үнемі оқитынмын, солай емес пе?
Dialogue: 0,0:04:40.07,0:04:41.63,JP,,0000,0000,0000,,Мен сенің сылтауларыңды тыңдамаймын.
Dialogue: 0,0:04:42.13,0:04:43.54,JP,,0000,0000,0000,,Бөлмеңізге оралыңыз
Dialogue: 0,0:04:43.78,0:04:48.32,JP,,0000,0000,0000,,Канато мен Жарық ойнап тұр, мен неге жалғыз оқуым керек?
Dialogue: 0,0:04:48.59,0:04:51.14,JP,,0000,0000,0000,,Сен басқа балалардан ерекшесің.
Dialogue: 0,0:04:51.14,0:04:53.72,JP,,0000,0000,0000,,Маған ұнамайды, көбірек ойнағым келеді
Dialogue: 0,0:04:53.77,0:04:55.44,JP,,0000,0000,0000,,Түсіну үшін неше рет айтуым керек?
Dialogue: 0,0:04:56.22,0:04:57.86,JP,,0000,0000,0000,,Сіз мұрагерсіз
Dialogue: 0,0:04:58.05,0:05:00.03,JP,,0000,0000,0000,,Бұл нені білдіретінін білесіз бе?
Dialogue: 0,0:05:01.00,0:05:04.71,JP,,0000,0000,0000,,Қараңдар, не істеу керектігін айтыңдар.
Dialogue: 0,0:05:09.47,0:05:13.23,JP,,0000,0000,0000,,Бірінші болу...
Dialogue: 0,0:05:14.22,0:05:18.09,JP,,0000,0000,0000,,Ешқашан ешкімнен жеңілме
Dialogue: 0,0:05:18.74,0:05:20.59,JP,,0000,0000,0000,,Егер алмасаңыз
Dialogue: 0,0:05:22.05,0:05:28.06,JP,,0000,0000,0000,,Мен сенің анаңның баласы емеспін, сондықтан оны көлдің түбіне батырамын.
Dialogue: 0,0:05:29.11,0:05:32.06,JP,,0000,0000,0000,,Иә, жақсы қыз.
Dialogue: 0,0:05:32.33,0:05:36.15,JP,,0000,0000,0000,,Егер сіз ең жақсы болмасаңыз, сізде құндылық жоқ.
Dialogue: 0,0:05:36.63,0:05:37.87,JP,,0000,0000,0000,,Мұндай балалар.
Dialogue: 0,0:05:38.94,0:05:47.94,JP,,0000,0000,0000,,Маған ешкім көмектеспейтін салқын көлдің түбінде мәңгі жалғыз өмір сүремін.
Dialogue: 0,0:05:49.18,0:05:51.65,JP,,0000,0000,0000,,Егер бұл сізге ұнамаса, бөлмеңізге барыңыз.
Dialogue: 0,0:06:05.52,0:06:06.40,JP,,0000,0000,0000,,Ана
Dialogue: 0,0:06:07.72,0:06:11.81,JP,,0000,0000,0000,,Канато, менің канарем, ән айт
Dialogue: 0,0:06:12.53,0:06:14.82,JP,,0000,0000,0000,,Бұл ән мен үшін
Dialogue: 0,0:06:15.03,0:06:16.82,JP,,0000,0000,0000,,Иә, ана.
Dialogue: 0,0:06:28.68,0:06:30.02,JP,,0000,0000,0000,,Бұл әдемі адам...
Dialogue: 0,0:06:31.05,0:06:33.62,JP,,0000,0000,0000,,Ол Аято мен басқалардың анасы ма деп ойлаймын.
Dialogue: 0,0:06:34.83,0:06:35.53,JP,,0000,0000,0000,,Бірақ
Dialogue: 0,0:06:51.12,0:06:53.62,JP,,0000,0000,0000,,Бұл Рейджи-сан ба?
Dialogue: 0,0:07:03.72,0:07:04.42,JP,,0000,0000,0000,,Шу
Dialogue: 0,0:07:05.04,0:07:06.35,JP,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:07:08.53,0:07:11.54,JP,,0000,0000,0000,,Қараңдаршы, мен оны достарымнан алдым.
Dialogue: 0,0:07:14.04,0:07:15.54,JP,,0000,0000,0000,,Қазір жіберіңіз
Dialogue: 0,0:07:18.85,0:07:19.73,JP,,0000,0000,0000,,қытық
Dialogue: 0,0:07:23.09,0:07:23.66,JP,,0000,0000,0000,,Шу
Dialogue: 0,0:07:24.76,0:07:28.82,JP,,0000,0000,0000,,Сен осы әулеттің үлкен ұлысың және келесі отағасы боласың.
Dialogue: 0,0:07:29.38,0:07:33.06,JP,,0000,0000,0000,,Сіз әрқашан өзіңізді солай ұстауыңыз керек.
Dialogue: 0,0:07:39.47,0:07:40.75,JP,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:07:41.12,0:07:42.09,JP,,0000,0000,0000,,Егер сізге ұнамаса
Dialogue: 0,0:07:42.43,0:07:45.34,JP,,0000,0000,0000,,Мен Эдгарға оны жақсы күтемін деп уәде бердім.
Dialogue: 0,0:08:07.23,0:08:10.25,JP,,0000,0000,0000,,Ана, мен бұл кітаптың бәрін жаттап алдым.
Dialogue: 0,0:08:29.95,0:08:30.55,JP,,0000,0000,0000,,Бар!
Dialogue: 0,0:08:44.66,0:08:45.51,JP,,0000,0000,0000,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:09:30.83,0:09:31.69,JP,,0000,0000,0000,,Сол адам
Dialogue: 0,0:09:33.00,0:09:33.88,JP,,0000,0000,0000,,Корделия
Dialogue: 0,0:09:34.65,0:09:37.82,JP,,0000,0000,0000,,Бұл дүниеде бәрінен де сұлу, сұлу адам.
Dialogue: 0,0:09:38.70,0:09:41.92,JP,,0000,0000,0000,,Барлық тіршілік иелері сізді жақсы көреді
Dialogue: 0,0:09:42.43,0:09:44.20,JP,,0000,0000,0000,,Мен сенің тізерлеп отырғаныңды көріп тұрмын.
Dialogue: 0,0:09:46.00,0:09:47.19,JP,,0000,0000,0000,,Рихтер
Dialogue: 0,0:09:47.85,0:09:52.01,JP,,0000,0000,0000,,Мәңгілік қасымда болып, маған махаббатыңды сыбырлап айт.
Dialogue: 0,0:10:01.27,0:10:02.07,JP,,0000,0000,0000,,Аято-кун
Dialogue: 0,0:10:40.87,0:10:41.38,JP,,0000,0000,0000,,Эй
Dialogue: 0,0:10:42.86,0:10:43.80,JP,,0000,0000,0000,,Ей, оян.
Dialogue: 0,0:10:46.45,0:10:49.27,JP,,0000,0000,0000,,Аято...сен, міне...
Dialogue: 0,0:10:50.02,0:10:50.93,JP,,0000,0000,0000,,Бұл жер асты су жолы.
Dialogue: 0,0:10:52.12,0:10:55.72,JP,,0000,0000,0000,,Мен мұнда не үшін келдім?
Dialogue: 0,0:10:56.06,0:10:57.57,JP,,0000,0000,0000,,Есіңде жоқ па?
Dialogue: 0,0:10:59.85,0:11:01.79,JP,,0000,0000,0000,,Жаңбырлы күндері бұл жерге жақындама
Dialogue: 0,0:11:05.92,0:11:07.43,JP,,0000,0000,0000,,Сол есік...
Dialogue: 0,0:11:09.31,0:11:10.97,JP,,0000,0000,0000,,Сізге білудің қажеті жоқ
Dialogue: 0,0:11:12.65,0:11:14.81,JP,,0000,0000,0000,,Мына қолға не болды?
Dialogue: 0,0:11:15.41,0:11:17.46,JP,,0000,0000,0000,,А, қызық, қай жерде кесілген?
Dialogue: 0,0:11:25.10,0:11:27.53,JP,,0000,0000,0000,,Иісі тәтті.
Dialogue: 0,0:11:28.32,0:11:30.46,JP,,0000,0000,0000,,Бұл азғырудың иісі деп аталады.
Dialogue: 0,0:11:31.63,0:11:33.17,JP,,0000,0000,0000,,Бұл дұрыс болды
Dialogue: 0,0:11:33.31,0:11:35.39,JP,,0000,0000,0000,,Мұнда бірге ойнайық.
Dialogue: 0,0:11:35.99,0:11:37.99,JP,,0000,0000,0000,,Оның иісі керемет.
Dialogue: 0,0:11:39.30,0:11:40.89,JP,,0000,0000,0000,,Сіз оның иісін бір жерден сездіңіз бе?
Dialogue: 0,0:11:49.07,0:11:50.44,JP,,0000,0000,0000,,Неліктен бұл болып жатыр?
Dialogue: 0,0:11:50.76,0:11:52.10,JP,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:11:52.61,0:11:54.75,JP,,0000,0000,0000,,Бұл қызық болғандықтан шешілді.
Dialogue: 0,0:11:55.40,0:11:56.00,JP,,0000,0000,0000,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:12:04.24,0:12:05.32,JP,,0000,0000,0000,,Дәмі де бірдей
Dialogue: 0,0:12:06.97,0:12:07.66,JP,,0000,0000,0000,,Жоқ
Dialogue: 0,0:12:09.63,0:12:11.02,JP,,0000,0000,0000,,Аято-кун
Dialogue: 0,0:12:16.24,0:12:16.78,JP,,0000,0000,0000,,Алып тасташы, өтінемін...?
Dialogue: 0,0:12:16.86,0:12:19.72,JP,,0000,0000,0000,,Менің жүрегім қайтадан...
Dialogue: 0,0:12:22.14,0:12:23.48,JP,,0000,0000,0000,,Бұл
Dialogue: 0,0:12:23.73,0:12:25.99,JP,,0000,0000,0000,,Аято-кун, бітті.
Dialogue: 0,0:12:26.98,0:12:30.15,JP,,0000,0000,0000,,Тезірек алсам жақсы болар деп ойлаймын.
Dialogue: 0,0:12:30.86,0:12:32.11,JP,,0000,0000,0000,,Жоқ, олар шын мәнінде тамақтанбай-ақ қоятындай деңгейге дейін дамыды, бірақ…
Dialogue: 0,0:12:33.31,0:12:35.36,JP,,0000,0000,0000,,Қане, көңіл көтерейік.
Dialogue: 0,0:12:37.30,0:12:37.96,JP,,0000,0000,0000,,Жоқ
Dialogue: 0,0:12:38.73,0:12:39.81,JP,,0000,0000,0000,,Бұл пайдасыз.
Dialogue: 0,0:12:40.32,0:12:42.58,JP,,0000,0000,0000,,Сен енді менен қаша алмайсың
Dialogue: 0,0:12:43.20,0:12:44.31,JP,,0000,0000,0000,,(Барабан соғу дыбысы)
Dialogue: 0,0:12:45.88,0:12:46.74,JP,,0000,0000,0000,,Мен білемін
Dialogue: 0,0:12:47.48,0:12:48.48,JP,,0000,0000,0000,,Көбелектің шашырауы
Dialogue: 0,0:12:48.70,0:12:53.09,JP,,0000,0000,0000,,Неғұрлым күрессең, соғұрлым өрмекшінің торына ілінесің.
Dialogue: 0,0:12:54.60,0:12:56.11,JP,,0000,0000,0000,,Мен сені жақсы көремін
Dialogue: 0,0:12:56.60,0:12:58.25,JP,,0000,0000,0000,,Тыныш болыңыз
Dialogue: 0,0:12:58.82,0:12:59.31,JP,,0000,0000,0000,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:13:01.50,0:13:03.72,JP,,0000,0000,0000,,Мен сені сүйемін, Қаншық
Dialogue: 0,0:13:29.49,0:13:30.66,JP,,0000,0000,0000,,Цк, мен жалықтым.
Dialogue: 0,0:13:31.09,0:13:32.03,JP,,0000,0000,0000,,Жетеді
Dialogue: 0,0:14:32.46,0:14:34.91,JP,,0000,0000,0000,,Қызғаныш - ең жақсы дәмдеуіш
Dialogue: 0,0:14:35.16,0:14:36.87,JP,,0000,0000,0000,,Тонау жаман емес
Dialogue: 0,0:14:37.33,0:14:39.21,JP,,0000,0000,0000,,Мен жек көремін
Dialogue: 0,0:14:39.41,0:14:40.92,JP,,0000,0000,0000,,Ештеңе қымбат емес
