Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.79,0:00:04.92,Default,,0,0,0,,Шигеру-сан, сенің шын есімің Шигеру Йошиока.
Dialogue: 0,0:00:06.04,0:00:09.05,Default,,0,0,0,,Сейджидің қайырымдысы Ю мырза, солай ма?
Dialogue: 0,0:00:10.21,0:00:13.55,Default,,0,0,0,,Неліктен менің фамилиям «Ёшиока» деп ойладың?
Dialogue: 0,0:00:13.97,0:00:16.97,Default,,0,0,0,,Бұл менің ерекше жазбаларымның күші.
Dialogue: 0,0:00:17.10,0:00:17.89,Default,,0,0,0,,Хмм
Dialogue: 0,0:00:18.10,0:00:21.64,Default,,0,0,0,,Мен басқа адамдардың терезелерін оқи аламын
Dialogue: 0,0:00:21.85,0:00:25.19,Default,,0,0,0,,Аты мен күйі және, әрине, арнайы ескертулер
Dialogue: 0,0:00:25.65,0:00:27.15,Default,,0,0,0,,<Не!?>
Dialogue: 0,0:00:27.48,0:00:30.57,Default,,0,0,0,,<Тоқта! Мені оқыма! ＞
Dialogue: 0,0:00:32.03,0:00:33.95,Default,,0,0,0,,Ух... аа... (Лис) Алдыңғы дүние...
Dialogue: 0,0:00:34.74,0:00:37.41,Default,,0,0,0,,Сейканың денесі қандай болды?
Dialogue: 0,0:00:37.66,0:00:38.83,Default,,0,0,0,,Сіз бұл туралы білесіз.
Dialogue: 0,0:00:39.87,0:00:42.96,Default,,0,0,0,,Әй, әйтеуір...
Dialogue: 0,0:00:43.87,0:00:45.42,Default,,0,0,0,,Мен...
Dialogue: 0,0:00:46.63,0:00:49.96,Default,,0,0,0,,Мен Сейка-санды сындырдым.
Dialogue: 0,0:00:50.13,0:00:51.42,Default,,0,0,0,,Міне, таптырмас нәрсе! Керемет!
Dialogue: 0,0:00:52.17,0:00:53.42,Default,,0,0,0,,Мен...
Dialogue: 0,0:00:53.84,0:00:56.93,Default,,0,0,0,,Мен мұның орнын толтыру үшін келдім.
Dialogue: 0,0:00:57.68,0:01:00.64,Default,,0,0,0,,♪～
Dialogue: 0,0:02:21.51,0:02:24.47,Default,,0,0,0,,～♪
Dialogue: 0,0:02:27.81,0:02:30.73,Default,,0,0,0,,Сен Сейка-санға не істеп жүрсің...
Dialogue: 0,0:02:31.44,0:02:36.07,Default,,0,0,0,,Алдыңғы әлемімде мен белгілі бір бағдарламаға қатыстым.
Dialogue: 0,0:02:36.36,0:02:39.86,Default,,0,0,0,,Сол уақытта мен Сейка-санды кездестірдім.
Dialogue: 0,0:02:40.03,0:02:40.95,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:41.91,0:02:44.58,Default,,0,0,0,,Мен адамдардың бақытын қалаймын
Dialogue: 0,0:02:44.95,0:02:47.95,Default,,0,0,0,,Мен Сейка-санға бақыт тіледім.
Dialogue: 0,0:02:48.16,0:02:49.16,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:02:49.79,0:02:54.71,Default,,0,0,0,,<Жол апаты қашып кеткен бағдарлама салдарынан орын алды>
Dialogue: 0,0:02:59.38,0:03:01.84,Default,,0,0,0,,Апатты тоқтатпау
Dialogue: 0,0:03:01.97,0:03:05.68,Default,,0,0,0,,Мен үшін Сейка-санды ренжіттім...
Dialogue: 0,0:03:07.39,0:03:10.48,Default,,0,0,0,,Мен қайта-қайта мойындадым.
Dialogue: 0,0:03:10.89,0:03:12.27,Default,,0,0,0,,Апат
Dialogue: 0,0:03:12.44,0:03:15.07,Default,,0,0,0,,Адамдардың қабылдауындағы болмашы сәйкессіздіктер
Dialogue: 0,0:03:15.32,0:03:18.49,Default,,0,0,0,,Бұл эмоцияларды сәтсіз түсінбеушіліктен туындады.
Dialogue: 0,0:03:19.11,0:03:23.24,Default,,0,0,0,,Сондықтан «Мен басқа адамдар туралы көбірек білгім келеді» ерекше жазба...
Dialogue: 0,0:03:23.49,0:03:26.70,Default,,0,0,0,,Осылайша сіз басқа адамдардың терезелерін оқи аласыз...
Dialogue: 0,0:03:26.87,0:03:27.99,Default,,0,0,0,,Иә
Dialogue: 0,0:03:28.20,0:03:32.08,Default,,0,0,0,,Сіз қатысқан бағдарлама...
Dialogue: 0,0:03:32.21,0:03:35.38,Default,,0,0,0,,Жасанды интеллект AI-ға қатысты
Dialogue: 0,0:03:35.50,0:03:38.71,Default,,0,0,0,,Иә? Мүмкін бұл Сейджи-сандікі шығар...
Dialogue: 0,0:03:41.30,0:03:43.84,Default,,0,0,0,,Иә, Макото-чан...
Dialogue: 0,0:03:44.01,0:03:46.89,Default,,0,0,0,,Сэйджи-сан менің үлкен ағам.
Dialogue: 0,0:03:47.01,0:03:48.89,Default,,0,0,0,,Иә? Бір минут күтіңіз
Dialogue: 0,0:03:49.02,0:03:51.85,Default,,0,0,0,,Сейджи-сан сені танитындай сезінбеді, солай ма?
Dialogue: 0,0:03:51.98,0:03:55.48,Default,,0,0,0,,Өйткені мен бұрынғы әлемімнен мүлде басқа адаммын.
Dialogue: 0,0:03:55.61,0:03:57.61,Default,,0,0,0,,Сіз байқамайсыз...
Dialogue: 0,0:03:57.73,0:04:00.19,Default,,0,0,0,,<Жарайды, мен үшін де солай.>
Dialogue: 0,0:04:00.40,0:04:03.41,Default,,0,0,0,,<Минус 255 түрі күн емес...>
Dialogue: 0,0:04:03.86,0:04:06.91,Default,,0,0,0,,Мен Ю мырза туралы Сейджи мырзадан білдім.
Dialogue: 0,0:04:07.08,0:04:09.83,Default,,0,0,0,,Йошиока мырза туралы тыңдау...
Dialogue: 0,0:04:10.00,0:04:13.67,Default,,0,0,0,,Біреуді күлдіретін сені іздедім.
Dialogue: 0,0:04:13.87,0:04:18.38,Default,,0,0,0,,Менің ойымша, бұл дүниеде біз еріксіз кездестік.
Dialogue: 0,0:04:19.34,0:04:22.92,Default,,0,0,0,,Сіз қалжыңдап тұрсыз... сіз қалжыңдаған жоқсыз, солай ма?
Dialogue: 0,0:04:23.63,0:04:25.97,Default,,0,0,0,,Мен өтірік айтпаймын
Dialogue: 0,0:04:26.09,0:04:30.43,Default,,0,0,0,,Бұл да мойындаудың бағасы... арнайы ескертпелер.
Dialogue: 0,0:04:31.18,0:04:32.39,Default,,0,0,0,,Шигеру-сан…
Dialogue: 0,0:04:32.64,0:04:37.56,Default,,0,0,0,,Абсолютті құдай ретінде сіз Сейка-санды күлдіргіңіз келеді.
Dialogue: 0,0:04:37.73,0:04:40.44,Default,,0,0,0,,Сэйджи-санды қолдауға тырысу
Dialogue: 0,0:04:40.78,0:04:44.45,Default,,0,0,0,,Сізге бағыт-бағдар беруге көмектесуге рұқсат етіңіз.
Dialogue: 0,0:04:45.41,0:04:47.82,Default,,0,0,0,,Жетекші болу артықтау...
Dialogue: 0,0:04:48.33,0:04:49.28,Default,,0,0,0,,Бірақ
Dialogue: 0,0:04:49.41,0:04:52.83,Default,,0,0,0,,Менің ойымша, бұл екі адам марапатқа лайық.
Dialogue: 0,0:04:53.91,0:04:55.75,Default,,0,0,0,,<Алдану өте оңай...>
Dialogue: 0,0:04:55.87,0:04:59.21,Default,,0,0,0,,<Жоқ, мәңгілік ақ пен таза екі адам>
Dialogue: 0,0:04:59.34,0:05:02.34,Default,,0,0,0,,<Зұлымдардың құрбаны болу күйзелісі>
Dialogue: 0,0:05:02.46,0:05:04.88,Default,,0,0,0,,<Тіпті шашыма да қауіп төніп тұр>
Dialogue: 0,0:05:05.30,0:05:08.01,Default,,0,0,0,,Біртұтас майдан туралы ойлауға болады.
Dialogue: 0,0:05:08.14,0:05:09.89,Default,,0,0,0,,Рахмет
Dialogue: 0,0:05:10.56,0:05:13.39,Default,,0,0,0,,Сіздің арқаңызда мен де дайындалдым.
Dialogue: 0,0:05:13.52,0:05:14.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:18.31,0:05:20.65,Default,,0,0,0,,Хмм... Ах.
Dialogue: 0,0:05:20.82,0:05:22.40,Default,,0,0,0,,Неліктен...
Dialogue: 0,0:05:22.61,0:05:25.45,Default,,0,0,0,,Өзін-өзі кемсіту
Dialogue: 0,0:05:25.70,0:05:26.66,Default,,0,0,0,,Және...
Dialogue: 0,0:05:27.07,0:05:29.28,Default,,0,0,0,,Саған да қысқалар жарасады деп ойлаймын!
Dialogue: 0,0:05:29.57,0:05:34.04,Default,,0,0,0,,Себебі мен Сейка-санға сәл де болса жақындағым келді...
Dialogue: 0,0:05:34.91,0:05:38.29,Default,,0,0,0,,Сіздің шешіміңіз өте айқын болды.
Dialogue: 0,0:05:39.08,0:05:41.84,Default,,0,0,0,,Келісім-шартта қызықты ештеңе жоқ.
Dialogue: 0,0:05:42.00,0:05:43.88,Default,,0,0,0,,Мәміле жасалды.
Dialogue: 0,0:05:44.01,0:05:46.80,Default,,0,0,0,,Сейка-сан мен басқаларды бірге күлдірейік.
Dialogue: 0,0:05:46.97,0:05:48.80,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:50.60,0:05:54.02,Default,,0,0,0,,Уау, бұл мен көрген бірінші жаратылыс.
Dialogue: 0,0:05:54.39,0:05:57.06,Default,,0,0,0,,Өйткені бұл тек осы дүниеде бар жануар.
Dialogue: 0,0:05:57.73,0:05:59.48,Default,,0,0,0,,Бұл жүк тасымалдауға арналған.
Dialogue: 0,0:05:59.60,0:06:01.57,Default,,0,0,0,,Кешіктіргенім үшін кешіріңіз! (Сейка) Иә?
Dialogue: 0,0:06:01.82,0:06:02.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:03.02,0:06:05.57,Default,,0,0,0,,сәйкес келе ме деп ойлаймын...
Dialogue: 0,0:06:06.07,0:06:09.07,Default,,0,0,0,,Иә! Бұл өте керемет! Фуфу
Dialogue: 0,0:06:09.32,0:06:10.66,Default,,0,0,0,,А...
Dialogue: 0,0:06:12.74,0:06:14.33,Default,,0,0,0,,Сен оны қашан кестің?
Dialogue: 0,0:06:14.45,0:06:15.62,Default,,0,0,0,,Мм...
Dialogue: 0,0:06:16.58,0:06:20.46,Default,,0,0,0,,＜Жақсы саған, лоли бала...жоқ, Лидс＞
Dialogue: 0,0:06:20.63,0:06:22.00,Default,,0,0,0,,Қандай жағымсыз!
Dialogue: 0,0:06:22.13,0:06:25.30,Default,,0,0,0,,Біздің мақсатымыз – Валерия княздігі.
Dialogue: 0,0:06:27.42,0:06:29.05,Default,,0,0,0,,Суық!
Dialogue: 0,0:06:30.51,0:06:32.35,Default,,0,0,0,,Мен жасадым! Фуфу
Dialogue: 0,0:06:32.47,0:06:34.31,Default,,0,0,0,,Уф…!
Dialogue: 0,0:06:36.52,0:06:37.52,Default,,0,0,0,,Ухммм… ммм…
Dialogue: 0,0:06:37.64,0:06:39.44,Default,,0,0,0,,(жебенің тесу дыбысы)
Dialogue: 0,0:06:41.77,0:06:43.86,Default,,0,0,0,,Лидс мырза!
Dialogue: 0,0:06:44.82,0:06:46.69,Default,,0,0,0,,Енді бұл шешілді.
Dialogue: 0,0:06:46.82,0:06:48.28,Default,,0,0,0,,Солай көрінеді.
Dialogue: 0,0:06:48.40,0:06:50.36,Default,,0,0,0,,Сіз Шигеру-санды көрдіңіз бе?
Dialogue: 0,0:06:52.07,0:06:55.33,Default,,0,0,0,,Менің сиқырлы талантым гүлденді!
Dialogue: 0,0:06:55.58,0:06:57.62,Default,,0,0,0,,<Иә иә>
Dialogue: 0,0:06:58.00,0:07:01.63,Default,,0,0,0,,Күн батып барады, біз бүгін осы жерде лагерь жасаймыз.
Dialogue: 0,0:07:02.25,0:07:03.92,Default,,0,0,0,,<Қазір Ирия қаласынан>
Dialogue: 0,0:07:04.04,0:07:06.88,Default,,0,0,0,,<Тауларды кесіп өткен Валерия княздігіне барар жолда>
Dialogue: 0,0:07:07.67,0:07:12.14,Default,,0,0,0,,<Бұл тас жолдан екі күнге жылдамырақ, бірақ бұл тік жол және қонақ үйлер жоқ.>
Dialogue: 0,0:07:12.47,0:07:16.14,Default,,0,0,0,,<Мен мұнда Сейка-санның қатты қалауымен келдім>
Dialogue: 0,0:07:16.64,0:07:18.89,Default,,0,0,0,,Лагерь лагері~!
Dialogue: 0,0:07:19.31,0:07:20.81,Default,,0,0,0,,Бұл менің бірінші рет.
Dialogue: 0,0:07:20.94,0:07:23.44,Default,,0,0,0,,Хаха Жұмыспен бөлісейік
Dialogue: 0,0:07:23.56,0:07:25.77,Default,,0,0,0,,Қайсысы жақсы: от жағу ма, әлде балық аулау ма?
Dialogue: 0,0:07:25.90,0:07:26.82,Default,,0,0,0,,Балық аулау!
Dialogue: 0,0:07:26.94,0:07:28.15,Default,,0,0,0,,<Орман мектебі?>
Dialogue: 0,0:07:28.53,0:07:32.03,Default,,0,0,0,,Тамаша сиқыршы ретінде мен саған өзеннен балықты қалай ұстау керектігін көрсетемін!
Dialogue: 0,0:07:32.16,0:07:34.53,Default,,0,0,0,,Жадағай! Бұл қауіпті болар еді
Dialogue: 0,0:07:34.66,0:07:35.95,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:36.08,0:07:38.29,Default,,0,0,0,,Хахаха (Ли-зу)фуфу
Dialogue: 0,0:07:41.92,0:07:43.79,Default,,0,0,0,,<Мен оны ұстай алмаймын...>
Dialogue: 0,0:07:44.04,0:07:46.96,Default,,0,0,0,,<Қарғыс атсын, мен балықты көріп тұрмын>
Dialogue: 0,0:07:47.17,0:07:48.51,Default,,0,0,0,,Шигеру-сан
Dialogue: 0,0:07:48.63,0:07:50.30,Default,,0,0,0,,Не? иә
Dialogue: 0,0:07:50.63,0:07:54.26,Default,,0,0,0,,Жылауға бейімділігімнен оңай құтылғым келеді.
Dialogue: 0,0:07:54.43,0:07:57.06,Default,,0,0,0,,Мен де арқанмен секіргенде аздап жыладым.
Dialogue: 0,0:07:58.01,0:07:59.93,Default,,0,0,0,,Жақсы емес пе?
Dialogue: 0,0:08:00.06,0:08:03.40,Default,,0,0,0,,Бірақ... Мен оның ұсқынсыз болып көрінгенін қаламаймын.
Dialogue: 0,0:08:03.94,0:08:07.32,Default,,0,0,0,,Кейде неге жылайтынымды білмеймін
Dialogue: 0,0:08:08.02,0:08:10.69,Default,,0,0,0,,Менің мұңайғаным емес...
Dialogue: 0,0:08:11.49,0:08:13.95,Default,,0,0,0,,Жылау жақсы
Dialogue: 0,0:08:14.07,0:08:14.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:15.12,0:08:18.79,Default,,0,0,0,,Адамдар тек мұңайып жыламайды.
Dialogue: 0,0:08:19.04,0:08:22.33,Default,,0,0,0,,Жүрегім ыстық, дірілдеп жылаймын.
Dialogue: 0,0:08:22.79,0:08:25.83,Default,,0,0,0,,Адамдар бірте-бірте жылай алмай қалады.
Dialogue: 0,0:08:26.58,0:08:28.25,Default,,0,0,0,,<Жылай алмаған кезде...>
Dialogue: 0,0:08:28.42,0:08:31.84,Default,,0,0,0,,<Мен одан күшті бола алмаймын>
Dialogue: 0,0:08:32.22,0:08:34.59,Default,,0,0,0,,Көз жасыңыздың себебін білмесеңіз
Dialogue: 0,0:08:35.22,0:08:40.31,Default,,0,0,0,,Жүрегіңіздің дірілдегеніне не себеп болды деп өзіңізден сұрап көрмейсіз бе?
Dialogue: 0,0:08:40.64,0:08:42.39,Default,,0,0,0,,Ах... (иіскеу дыбысы)
Dialogue: 0,0:08:43.39,0:08:44.56,Default,,0,0,0,,Байқап көріңіз!
Dialogue: 0,0:08:44.69,0:08:45.73,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:08:46.02,0:08:47.81,Default,,0,0,0,,<Тоқта>
Dialogue: 0,0:08:48.15,0:08:49.98,Default,,0,0,0,,Сіз балық ұстадыңыз ба?
Dialogue: 0,0:08:50.23,0:08:52.24,Default,,0,0,0,,Жоқ, мүлде емес.
Dialogue: 0,0:08:52.74,0:08:54.53,Default,,0,0,0,,Иә, Садақтар.
Dialogue: 0,0:08:54.70,0:08:56.61,Default,,0,0,0,,<Әлі монах емес>
Dialogue: 0,0:08:56.78,0:08:59.08,Default,,0,0,0,,Мен отты жағып қойғанмын, сондықтан сені шақыруға келдім.
Dialogue: 0,0:08:59.20,0:09:02.25,Default,,0,0,0,,Бірақ мен бүгін кешке балық аулауым керек...
Dialogue: 0,0:09:02.50,0:09:03.91,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:04.41,0:09:06.21,Default,,0,0,0,,Бір минут күтіңіз
Dialogue: 0,0:09:11.21,0:09:12.76,Default,,0,0,0,,Тамаша!
Dialogue: 0,0:09:12.88,0:09:14.13,Default,,0,0,0,,<Оны жасама...>
Dialogue: 0,0:09:15.09,0:09:16.51,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:09:16.76,0:09:19.64,Default,,0,0,0,,Рахмет Уау...
Dialogue: 0,0:09:20.05,0:09:22.72,Default,,0,0,0,,Мен оны Сэйджи-санға апарамын.
Dialogue: 0,0:09:22.85,0:09:24.35,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:09:24.89,0:09:25.85,Default,,0,0,0,,Сейка-сан
Dialogue: 0,0:09:25.98,0:09:29.23,Default,,0,0,0,,Шигеру-санның қасында болсаң, күлімдеп жүресің.
Dialogue: 0,0:09:29.36,0:09:30.65,Default,,0,0,0,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:09:31.11,0:09:32.90,Default,,0,0,0,,Күткендей, ағам дұрыс айтады.
Dialogue: 0,0:09:33.03,0:09:36.40,Default,,0,0,0,,Шигеру-сан – біреуді күлдірте алатын адам.
Dialogue: 0,0:09:36.65,0:09:39.16,Default,,0,0,0,,Бұл сәл артық мақтау емес пе?
Dialogue: 0,0:09:39.28,0:09:40.33,Default,,0,0,0,,Жоқ
Dialogue: 0,0:09:40.45,0:09:43.91,Default,,0,0,0,,Сіз осында болсаңыз, біз жақсы араласа аламыз.
Dialogue: 0,0:09:44.75,0:09:46.41,Default,,0,0,0,,Мен солай ойлаймын.
Dialogue: 0,0:09:46.92,0:09:49.42,Default,,0,0,0,,Хмм... а
Dialogue: 0,0:09:50.71,0:09:52.63,Default,,0,0,0,,Біз де қайтайық
Dialogue: 0,0:09:54.80,0:09:56.17,Default,,0,0,0,,Шигеру-сан?
Dialogue: 0,0:09:56.51,0:10:00.18,Default,,0,0,0,,Мені біраз уақытқа дейін жүрегіңде сақташы.
Dialogue: 0,0:10:01.01,0:10:05.23,Default,,0,0,0,,Бұл екеуі қазір білсе, жүректері дірілдеп кетері сөзсіз...
Dialogue: 0,0:10:05.35,0:10:06.68,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:07.14,0:10:10.11,Default,,0,0,0,,Маған аз ғана уақыт беріңізші.
Dialogue: 0,0:10:11.06,0:10:13.32,Default,,0,0,0,,Эден мектебіне қабылдау нәтижелері
Dialogue: 0,0:10:15.57,0:10:17.82,Default,,0,0,0,,А, қажырлы еңбегіңіз үшін рахмет (Сейка) Ах!
Dialogue: 0,0:10:18.03,0:10:20.82,Default,,0,0,0,,Бұл күріш ботқасы ма?
Dialogue: 0,0:10:21.45,0:10:22.70,Default,,0,0,0,,Сұлы жармасы
Dialogue: 0,0:10:22.83,0:10:24.33,Default,,0,0,0,,Бұл бидай ботқасы.
Dialogue: 0,0:10:24.66,0:10:27.37,Default,,0,0,0,,<Бұл Еуропа мен Америка ма? Жоқ, бұл басқа әлем.>
Dialogue: 0,0:10:27.50,0:10:29.42,Default,,0,0,0,,Мен жасадым.
Dialogue: 0,0:10:29.54,0:10:32.42,Default,,0,0,0,,Кемпинг сізге жылы нәрсені қалайды...
Dialogue: 0,0:10:32.54,0:10:35.63,Default,,0,0,0,,Әй, қазанды оттан сәл алыстайық.
Dialogue: 0,0:10:35.76,0:10:36.84,Default,,0,0,0,,Иә
Dialogue: 0,0:10:37.26,0:10:40.09,Default,,0,0,0,,<Сэйджи-сан, сен басқарасың.>
Dialogue: 0,0:10:40.43,0:10:43.60,Default,,0,0,0,,<Ол түптеп келгенде көшбасшы болуға мінсіз адам.> (Сэйджи) Дұрыс, Муги де бақытты.
Dialogue: 0,0:10:44.43,0:10:45.43,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:45.56,0:10:46.60,Default,,0,0,0,,Рахмет
Dialogue: 0,0:10:47.06,0:10:48.48,Default,,0,0,0,,Қош келдіңіз!
Dialogue: 0,0:10:52.73,0:10:55.15,Default,,0,0,0,,(Үлдеген дыбыс)
Dialogue: 0,0:10:55.82,0:10:58.07,Default,,0,0,0,,(Үлдеген дыбыс)
Dialogue: 0,0:10:58.19,0:10:58.99,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:11:01.07,0:11:01.99,Default,,0,0,0,,Ум...
Dialogue: 0,0:11:02.12,0:11:05.99,Default,,0,0,0,,Сейджи-сан, бұл сапардың мақсаты қандай деп ойлайсың?
Dialogue: 0,0:11:06.20,0:11:07.50,Default,,0,0,0,,Мақсат?
Dialogue: 0,0:11:07.62,0:11:10.83,Default,,0,0,0,,Мысалы, ойында сіз жын патшасын жеңгіңіз келуі мүмкін.
Dialogue: 0,0:11:10.96,0:11:14.00,Default,,0,0,0,,Жұмыста да сіз жету үшін мақсат қоясыз, солай ма?
Dialogue: 0,0:11:14.42,0:11:18.17,Default,,0,0,0,,Мына дүниеде сондай аян бар ма екен...
Dialogue: 0,0:11:18.46,0:11:19.76,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:20.38,0:11:22.55,Default,,0,0,0,,Мақсат бар ма, жоқ па білмеймін.
Dialogue: 0,0:11:22.72,0:11:24.05,Default,,0,0,0,,Жақын мақсат
Dialogue: 0,0:11:24.26,0:11:27.47,Default,,0,0,0,,Валерия княздігіне барамыз ба?
Dialogue: 0,0:11:28.27,0:11:33.02,Default,,0,0,0,,Қосымша ақпарат пен опцияларды алу үшін қалалық жерлерге барғым келеді
Dialogue: 0,0:11:33.56,0:11:37.28,Default,,0,0,0,,Сонда ғана біз не істеу керектігін білеміз.
Dialogue: 0,0:11:37.57,0:11:41.03,Default,,0,0,0,,<Бұрынғы президенттен күткендей қатты>
Dialogue: 0,0:11:41.36,0:11:43.53,Default,,0,0,0,,Әй!
Dialogue: 0,0:11:43.99,0:11:46.49,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:46.62,0:11:48.54,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:48.66,0:11:50.16,Default,,0,0,0,,<Әйел!?>
Dialogue: 0,0:11:50.50,0:11:52.92,Default,,0,0,0,,Уф... (құлап жатқан дыбыс)
Dialogue: 0,0:11:53.75,0:11:56.17,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:11:57.00,0:11:58.71,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:00.34,0:12:03.55,Default,,0,0,0,,(Әйелдің ауыр тыныс алуы)
Dialogue: 0,0:12:03.68,0:12:04.68,Default,,0,0,0,,Ха!
Dialogue: 0,0:12:06.18,0:12:07.81,Default,,0,0,0,,Қарғыс атсын, ізде!
Dialogue: 0,0:12:07.97,0:12:09.68,Default,,0,0,0,,Мен бұл жарақатпен алысқа бара алмаймын.
Dialogue: 0,0:12:10.02,0:12:13.60,Default,,0,0,0,,Ол әйелді тапсам, тегін бермеймін!
Dialogue: 0,0:12:16.81,0:12:18.36,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:12:20.78,0:12:24.20,Default,,0,0,0,,<Біз не істеп жатырмыз...>
Dialogue: 0,0:12:26.74,0:12:28.16,Default,,0,0,0,,Арнайы ескертулер…
Dialogue: 0,0:12:28.28,0:12:30.83,Default,,0,0,0,,Егер мұндай нәрсе жазғың келмесе...
Dialogue: 0,0:12:31.96,0:12:34.37,Default,,0,0,0,,Бізбен ажырасып жатырсың ба? Неге!?
Dialogue: 0,0:12:34.50,0:12:37.84,Default,,0,0,0,,Әдемі болса жақсы.
Dialogue: 0,0:12:38.67,0:12:42.30,Default,,0,0,0,,Әйтеуір, еркектерге сұлу әйелдер ұнайды.
Dialogue: 0,0:12:42.51,0:12:45.59,Default,,0,0,0,,Сен де сұлу болу керексің.
Dialogue: 0,0:12:45.72,0:12:47.26,Default,,0,0,0,,(Әйелдердің күлкісі)
Dialogue: 0,0:12:47.39,0:12:51.22,Default,,0,0,0,,<Мен кешірмеймін мен кешірмеймін мен кешірмеймін>
Dialogue: 0,0:12:51.35,0:12:52.35,Default,,0,0,0,,<Қандай сұлу...>
Dialogue: 0,0:12:53.14,0:12:54.85,Default,,0,0,0,,<Мен бәрін өлтіремін! ＞
Dialogue: 0,0:12:55.02,0:12:56.85,Default,,0,0,0,,Ха!
Dialogue: 0,0:12:57.23,0:12:58.94,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:12:59.32,0:13:01.32,Default,,0,0,0,,А, сен...
Dialogue: 0,0:13:02.03,0:13:05.11,Default,,0,0,0,,Сіз байқадыңыз ба? Жақсы!
Dialogue: 0,0:13:05.45,0:13:07.12,Default,,0,0,0,,А... уф
Dialogue: 0,0:13:07.70,0:13:10.87,Default,,0,0,0,,Абайсызда болмаңыз! Мен ауыр жарақат алдым.
Dialogue: 0,0:13:11.41,0:13:13.45,Default,,0,0,0,,Қан тоқтады
Dialogue: 0,0:13:13.75,0:13:16.62,Default,,0,0,0,,Ол мен үшін қалпына келтіру сиқырын қолданды.
Dialogue: 0,0:13:16.75,0:13:18.13,Default,,0,0,0,,Мені иллюзиялардан жасалған ережелермен байлама.
Dialogue: 0,0:13:19.59,0:13:21.13,Default,,0,0,0,,Сорадомо
Dialogue: 0,0:13:21.46,0:13:25.38,Default,,0,0,0,,Мен рахмет емес, рахмет айтамын.
Dialogue: 0,0:13:25.63,0:13:26.88,Default,,0,0,0,,Жылдам… бірақ әлі де менің қашықтығымда.
Dialogue: 0,0:13:27.55,0:13:29.55,Default,,0,0,0,,Жалынға түссін
Dialogue: 0,0:13:29.85,0:13:30.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:32.47,0:13:36.64,Default,,0,0,0,,<Оны үнсіз өлтіру пісіп-жетілмеген, бірақ Сейка-сан да қашықтықты тым жақындатып жатыр.>
Dialogue: 0,0:13:37.35,0:13:40.15,Default,,0,0,0,,<Бірінші кездесуде біреудің қалтасына секірме>
Dialogue: 0,0:13:44.15,0:13:47.11,Default,,0,0,0,,<Бұл әйел типтік мысал>
Dialogue: 0,0:13:49.20,0:13:49.99,Default,,0,0,0,,Ах
Dialogue: 0,0:13:51.20,0:13:52.66,Default,,0,0,0,,Шигеру-сан, су!
Dialogue: 0,0:13:52.91,0:13:54.62,Default,,0,0,0,,Иә
Dialogue: 0,0:13:56.46,0:13:58.04,Default,,0,0,0,,Мен бір нәрсені ұмытып қалдым! иә?
Dialogue: 0,0:14:00.17,0:14:02.80,Default,,0,0,0,,Бұл бет болса ше?
Dialogue: 0,0:14:03.55,0:14:06.55,Default,,0,0,0,,Ол туралы ерекше жазбалар... Ол қауіпті жігіт.
Dialogue: 0,0:14:07.72,0:14:10.05,Default,,0,0,0,,«Біз әдемі әйелдерге жол бермейміз»
Dialogue: 0,0:14:10.43,0:14:14.81,Default,,0,0,0,,«Ішегіңді жұлып алып, өлтіремін»...
Dialogue: 0,0:14:15.10,0:14:16.85,Default,,0,0,0,,Иә! Яғни...
Dialogue: 0,0:14:16.98,0:14:18.06,Default,,0,0,0,,Иә
Dialogue: 0,0:14:18.48,0:14:21.69,Default,,0,0,0,,Сейка-сан міндетті түрде нысанаға алынады.
Dialogue: 0,0:14:28.74,0:14:31.57,Default,,0,0,0,,Сенің атың кім...
Dialogue: 0,0:14:32.16,0:14:33.70,Default,,0,0,0,,Reia…
Dialogue: 0,0:14:34.04,0:14:35.91,Default,,0,0,0,,Мен жеуге бола ма?
Dialogue: 0,0:14:36.04,0:14:37.87,Default,,0,0,0,,Ішіңе бірдеңе салған дұрыс...
Dialogue: 0,0:14:38.00,0:14:40.46,Default,,0,0,0,,Мен оны аламын.
Dialogue: 0,0:14:41.04,0:14:42.17,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:14:42.38,0:14:45.92,Default,,0,0,0,,Уф! (Сейка) Ыдысты мен саған қалдырамын.
Dialogue: 0,0:14:46.05,0:14:49.59,Default,,0,0,0,,<Сейка-сан... Жақсы адамдардың да шегі бар>
Dialogue: 0,0:14:49.72,0:14:52.35,Default,,0,0,0,,<Мені қатты қобалжытпауыңызды өтінемін>
Dialogue: 0,0:14:53.55,0:14:55.47,Default,,0,0,0,,<Лидс қаруды алып тастады>
Dialogue: 0,0:14:55.77,0:14:57.35,Default,,0,0,0,,<Қарусыз болса да>
Dialogue: 0,0:14:57.48,0:15:01.15,Default,,0,0,0,,<Егер сіз оғаш қимыл-қозғалыс көрсетсеңіз, мен кетуіңізді сұраймын.>
Dialogue: 0,0:15:02.19,0:15:05.48,Default,,0,0,0,,Рея мұндай ауыр жарақатты қалай алды?
Dialogue: 0,0:15:05.78,0:15:08.15,Default,,0,0,0,,Партияға шабуыл жасалды.
Dialogue: 0,0:15:08.28,0:15:10.99,Default,,0,0,0,,Осылайша бәрі бөлініп кетті...
Dialogue: 0,0:15:11.24,0:15:13.91,Default,,0,0,0,,Шарасыз қашып кеттік.
Dialogue: 0,0:15:14.03,0:15:15.99,Default,,0,0,0,,Мұндай нәрсе...
Dialogue: 0,0:15:16.16,0:15:17.75,Default,,0,0,0,,Бұл қиын болды.
Dialogue: 0,0:15:17.91,0:15:21.50,Default,,0,0,0,,<Ол әңгіменің қаншалықты шындыққа жанасады?>
Dialogue: 0,0:15:21.83,0:15:25.13,Default,,0,0,0,,Біз Валерия Князьдігіне бара жатырмыз.
Dialogue: 0,0:15:25.25,0:15:27.42,Default,,0,0,0,,Мен сені сол дәрежеде қорғаймын.
Dialogue: 0,0:15:27.55,0:15:28.88,Default,,0,0,0,,Дәл ойлағанымдай
Dialogue: 0,0:15:30.38,0:15:32.09,Default,,0,0,0,,Маған сенесіз бе?
Dialogue: 0,0:15:32.39,0:15:34.39,Default,,0,0,0,,Сенуге болады.
Dialogue: 0,0:15:34.85,0:15:38.39,Default,,0,0,0,,Сэйджи-сан ешқашан ешкімді сатпаймын деп ант етті!
Dialogue: 0,0:15:38.60,0:15:40.18,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:15:40.31,0:15:42.15,Default,,0,0,0,,А, уф...
Dialogue: 0,0:15:42.31,0:15:44.73,Default,,0,0,0,,Эй, егер кенет мені таң қалдырсаң...
Dialogue: 0,0:15:44.86,0:15:46.40,Default,,0,0,0,,Аа, кешіріңіз...
Dialogue: 0,0:15:46.52,0:15:48.28,Default,,0,0,0,,<Маған үзіліс беріңізші...>
Dialogue: 0,0:15:48.40,0:15:51.03,Default,,0,0,0,,<Қасықты қару ретінде де қолдануға болады>
Dialogue: 0,0:15:51.32,0:15:55.49,Default,,0,0,0,,<Мен Сейка-санға адамдардан алшақтық сезімін сақтауды үйретуім керек.>
Dialogue: 0,0:15:55.78,0:15:57.45,Default,,0,0,0,,Ауырсыну туралы не деуге болады?
Dialogue: 0,0:15:57.58,0:15:58.79,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:15:59.08,0:16:01.79,Default,,0,0,0,,Бірақ жара сәл ыстық.
Dialogue: 0,0:16:01.91,0:16:04.88,Default,,0,0,0,,Эй, сен мені суға апара аласың ба?
Dialogue: 0,0:16:05.00,0:16:05.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:05.96,0:16:07.84,Default,,0,0,0,,Мен саған иығымды берем.
Dialogue: 0,0:16:07.96,0:16:09.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:10.13,0:16:12.80,Default,,0,0,0,,Тердегім келеді деген сөз.
Dialogue: 0,0:16:13.05,0:16:14.84,Default,,0,0,0,,Ах! (Рейа) Хехе
Dialogue: 0,0:16:14.97,0:16:17.85,Default,,0,0,0,,Сейджи салқын жүзді және азғын.
Dialogue: 0,0:16:17.97,0:16:20.81,Default,,0,0,0,,Е-е, жоқ, менің айтқым келгені бұл емес еді...
Dialogue: 0,0:16:21.68,0:16:23.64,Default,,0,0,0,,Сіз азғынсыз ба? (Сейджи) Арх!
Dialogue: 0,0:16:23.77,0:16:25.31,Default,,0,0,0,,<Тоқтату>
Dialogue: 0,0:16:26.19,0:16:29.11,Default,,0,0,0,,Сіз! Менің үйіме тиіссең, айқайла!
Dialogue: 0,0:16:29.23,0:16:30.82,Default,,0,0,0,,Мен оған тиіспеймін.
Dialogue: 0,0:16:31.07,0:16:33.78,Default,,0,0,0,,Шигеру-сан да азғын ба?
Dialogue: 0,0:16:34.11,0:16:35.53,Default,,0,0,0,,Ішек
Dialogue: 0,0:16:36.91,0:16:39.58,Default,,0,0,0,,<Екі адамды секундта өлтіретін не...>
Dialogue: 0,0:16:39.95,0:16:42.79,Default,,0,0,0,,<Әйелдер шынымен де қорқынышты>
Dialogue: 0,0:16:42.91,0:16:45.58,Default,,0,0,0,,Мен саған иығымды берем.
Dialogue: 0,0:16:46.38,0:16:49.09,Default,,0,0,0,,<Бұл басқаша қорқынышты>
Dialogue: 0,0:16:49.38,0:16:52.01,Default,,0,0,0,,Қорқынышты! Сіз қандайсыз!? (Риз) Уф!
Dialogue: 0,0:16:52.17,0:16:53.59,Default,,0,0,0,,<Менің ойымша>
Dialogue: 0,0:16:54.18,0:16:57.97,Default,,0,0,0,,<Мимикаға келгенде де өтірік айтпайтын арнайы ноталардың арқасында ба...>
Dialogue: 0,0:16:58.10,0:17:00.26,Default,,0,0,0,,<Кісі өлтіру ниетіңізді аздап басыңыз>
Dialogue: 0,0:17:01.27,0:17:05.23,Default,,0,0,0,,Seika…san? Мені су тесігіне апара аласыз ба?
Dialogue: 0,0:17:05.35,0:17:07.27,Default,,0,0,0,,Аа, оны маған қалдырыңыз.
Dialogue: 0,0:17:07.73,0:17:09.02,Default,,0,0,0,,<Бұл жаман...>
Dialogue: 0,0:17:09.44,0:17:12.65,Default,,0,0,0,,Иә, бұл! Құбыжықтарға қарсы шара қолдануды ұмытпаңыз!
Dialogue: 0,0:17:12.78,0:17:14.03,Default,,0,0,0,,<Болды! ＞
Dialogue: 0,0:17:14.65,0:17:17.28,Default,,0,0,0,,Енді кеттік, Рейа-сан.
Dialogue: 0,0:17:17.91,0:17:21.04,Default,,0,0,0,,<Оны осында тоқтатуға мәжбүрлеу табиғаттан тыс болар еді...>
Dialogue: 0,0:17:21.16,0:17:21.95,Default,,0,0,0,,Ах
Dialogue: 0,0:17:24.87,0:17:26.17,Default,,0,0,0,,<Жарайды, мен де...>
Dialogue: 0,0:17:26.33,0:17:28.29,Default,,0,0,0,,Шигеру-сан, №.
Dialogue: 0,0:17:28.75,0:17:30.92,Default,,0,0,0,,Мен сізді уайымдап жатқаныңызды түсіндім.
Dialogue: 0,0:17:31.25,0:17:34.17,Default,,0,0,0,,Бірақ ол әйел қауіпті.
Dialogue: 0,0:17:34.30,0:17:35.42,Default,,0,0,0,,Б-барлаушы? Не туралы айтып тұрсыздар?
Dialogue: 0,0:17:36.05,0:17:38.22,Default,,0,0,0,,Рея - ересек әйел
Dialogue: 0,0:17:38.39,0:17:40.26,Default,,0,0,0,,Байқамай ұстасаңыз, күйіп қаласыз.
Dialogue: 0,0:17:40.39,0:17:43.56,Default,,0,0,0,,<Бұл емес! Жоқ, мен қателеспеймін>
Dialogue: 0,0:17:44.10,0:17:47.19,Default,,0,0,0,,Бірақ Сейка-санды жалғыз қалдыру...
Dialogue: 0,0:17:47.31,0:17:49.31,Default,,0,0,0,,Сейка-санға сенейік
Dialogue: 0,0:17:49.77,0:17:53.57,Default,,0,0,0,,<17 жастағы әдемі әйелге ұқсайды>
Dialogue: 0,0:17:53.90,0:17:56.90,Default,,0,0,0,,Тамақ ішуді жалғастырғанша күтейік.
Dialogue: 0,0:17:57.66,0:18:01.24,Default,,0,0,0,,<Сейджи-сан Рейаның ерекше жазбалары туралы білмейтіндіктен>
Dialogue: 0,0:18:01.53,0:18:02.33,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:18:03.49,0:18:05.83,Default,,0,0,0,,Бұл Шигеру-сан ба?
Dialogue: 0,0:18:06.33,0:18:08.67,Default,,0,0,0,,Бұл... бұлыңғыр емес пе?
Dialogue: 0,0:18:08.79,0:18:10.54,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:18:10.67,0:18:14.01,Default,,0,0,0,,<Мен бар күшіммен жай ғана көлденең секіремін>
Dialogue: 0,0:18:14.17,0:18:16.09,Default,,0,0,0,,<"Ептілік 1 триллион" бонусымен>
Dialogue: 0,0:18:18.80,0:18:21.72,Default,,0,0,0,,Кейінгі кескін? Мен көретін сияқтымын...
Dialogue: 0,0:18:21.93,0:18:24.52,Default,,0,0,0,,Шаршағаныңызға сенімдімін.
Dialogue: 0,0:18:24.81,0:18:26.06,Default,,0,0,0,,Ұйқы!
Dialogue: 0,0:18:27.94,0:18:28.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:30.02,0:18:32.11,Default,,0,0,0,,<Мен мұны басынан-ақ осылай жасауым керек еді> (Сейджидің ұйқысы)
Dialogue: 0,0:18:33.77,0:18:36.19,Default,,0,0,0,,<Гуннай, тәтті армандар>
Dialogue: 0,0:18:40.99,0:18:43.08,Default,,0,0,0,,Аа, мен өзімді сергек сезіндім.
Dialogue: 0,0:18:43.28,0:18:44.37,Default,,0,0,0,,Жақсы
Dialogue: 0,0:18:44.83,0:18:47.91,Default,,0,0,0,,Уау, Сэйджи-сан сондай керемет.
Dialogue: 0,0:18:48.04,0:18:50.37,Default,,0,0,0,,Ол әдемі, бірақ ол да аңғал.
Dialogue: 0,0:18:50.67,0:18:53.67,Default,,0,0,0,,аңқау? Мен шынымен де түсінбеймін
Dialogue: 0,0:18:53.79,0:18:55.71,Default,,0,0,0,,Бұл сәл қатал, солай емес пе?
Dialogue: 0,0:18:55.84,0:18:56.88,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:18:57.38,0:19:01.18,Default,,0,0,0,,Ол қатал, бірақ ілтипатты және тамаша адам.
Dialogue: 0,0:19:01.30,0:19:04.64,Default,,0,0,0,,Шигеру-сан мен Лидс-санның бәрі тамаша.
Dialogue: 0,0:19:08.43,0:19:09.77,Default,,0,0,0,,Иә.
Dialogue: 0,0:19:09.94,0:19:12.15,Default,,0,0,0,,Сенің де бізге қосылуыңды қалаймын.
Dialogue: 0,0:19:12.65,0:19:15.65,Default,,0,0,0,,Бұл тамаша. Мен де Реямен шытырман оқиғаға барғым келеді!
Dialogue: 0,0:19:19.24,0:19:20.65,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:19:20.95,0:19:21.82,Default,,0,0,0,,А...
Dialogue: 0,0:19:22.07,0:19:25.41,Default,,0,0,0,,Мен... Оны арнайы жазбаларға жазуым керек.
Dialogue: 0,0:19:26.41,0:19:27.45,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:27.62,0:19:30.00,Default,,0,0,0,,«Біз әдемі әйелдерге төзбейміз»
Dialogue: 0,0:19:30.16,0:19:34.29,Default,,0,0,0,,«Ішегіңді жұлып алып, өлтіремін».
Dialogue: 0,0:19:34.42,0:19:35.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:35.50,0:19:36.67,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:37.05,0:19:39.88,Default,,0,0,0,,Мен, мен сұлу емеспін...
Dialogue: 0,0:19:40.01,0:19:43.84,Default,,0,0,0,,Мен Рея-санға жамандық жасадым ба?
Dialogue: 0,0:19:43.97,0:19:45.55,Default,,0,0,0,,Ештеңе жасамаңыз
Dialogue: 0,0:19:45.68,0:19:48.47,Default,,0,0,0,,Бірдеңе болса, сен жақсы адамсың.
Dialogue: 0,0:19:48.72,0:19:50.18,Default,,0,0,0,,Оларға қашып кетуге жол бермеңдер
Dialogue: 0,0:19:50.94,0:19:53.69,Default,,0,0,0,,Арнайы жазбаларды жазғаннан кейін оларға қарсы шыға алмайсыз!
Dialogue: 0,0:19:53.90,0:19:57.69,Default,,0,0,0,,Әдемі әйелді көргенде басымды итеріп жібереді.
Dialogue: 0,0:19:57.82,0:19:59.19,Default,,0,0,0,,Мен қыз досыма мүлде хабарласа алмай жатырмын—
Dialogue: 0,0:19:59.99,0:20:01.20,Default,,0,0,0,,Байқасаңыз...
Dialogue: 0,0:20:01.32,0:20:04.41,Default,,0,0,0,,Мен оны қайтара алмаймын...
Dialogue: 0,0:20:04.82,0:20:07.79,Default,,0,0,0,,<Арнайы жазбалар сізді таң қалдырады ма?>
Dialogue: 0,0:20:07.99,0:20:10.96,Default,,0,0,0,,<Өкінішті, бірақ...> (Пышақтың суырылып шыққан дыбысы)
Dialogue: 0,0:20:12.87,0:20:14.29,Default,,0,0,0,,Рея-сан...
Dialogue: 0,0:20:14.42,0:20:17.71,Default,,0,0,0,,Неліктен мұндай ерекше жазбалар жаздыңыз?
Dialogue: 0,0:20:18.67,0:20:20.21,Default,,0,0,0,,Менің...
Dialogue: 0,0:20:20.46,0:20:23.47,Default,,0,0,0,,Менің асыл сұлулығымды сұлу әйелдер таптап жатыр...
Dialogue: 0,0:20:25.05,0:20:25.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:26.51,0:20:27.81,Default,,0,0,0,,Сол жігіттер
Dialogue: 0,0:20:28.01,0:20:31.98,Default,,0,0,0,,Біреудің адамын ұрлап, мені күлкіге айналдырдың.
Dialogue: 0,0:20:32.14,0:20:36.06,Default,,0,0,0,,Ер-азаматтардың бәрі осындай сұлулардың жағында болды.
Dialogue: 0,0:20:37.23,0:20:41.24,Default,,0,0,0,,<Сондықтан біз бұл жеккөрінішті арнайы жазбаларға енгіземіз>
Dialogue: 0,0:20:41.90,0:20:45.32,Default,,0,0,0,,<Сондықтан мені бірден қаладан қуып жіберді...>
Dialogue: 0,0:20:46.20,0:20:51.25,Default,,0,0,0,,<Сіз шытырман оқиғаға байланысты кештен партияға ауыса отырып, сіз бірінен соң бірі әдемі әйелдерді кездестіресіз...>
Dialogue: 0,0:20:51.66,0:20:54.42,Default,,0,0,0,,Бірақ бұл бүгін аяқталады...
Dialogue: 0,0:20:54.58,0:20:57.96,Default,,0,0,0,,Мен Сейджи-саннан маған қамқорлық жасауын өтінемін.
Dialogue: 0,0:20:58.67,0:21:01.13,Default,,0,0,0,,Өтінемін Сейка
Dialogue: 0,0:21:01.76,0:21:03.88,Default,,0,0,0,,Біз үшін өл
Dialogue: 0,0:21:04.13,0:21:05.13,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:07.85,0:21:10.64,Default,,0,0,0,,Ах, у... Хм, ха!
Dialogue: 0,0:21:13.39,0:21:14.60,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:16.10,0:21:17.40,Default,,0,0,0,,Біз қауіпсіз жердеміз, сондықтан…
Dialogue: 0,0:21:19.48,0:21:20.27,Default,,0,0,0,,Хмм
Dialogue: 0,0:21:21.44,0:21:23.11,Default,,0,0,0,,Иә! (Рейя) Ах
Dialogue: 0,0:21:23.86,0:21:25.65,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:26.99,0:21:30.74,Default,,0,0,0,,Шошқа! Жіберу! Менде ол әйел бар...
Dialogue: 0,0:21:31.24,0:21:33.20,Default,,0,0,0,,Әдемі сөздерді айтпа
Dialogue: 0,0:21:33.33,0:21:34.79,Default,,0,0,0,,Тек...
Dialogue: 0,0:21:36.33,0:21:39.04,Default,,0,0,0,,Сіз кептеліп қалдыңыз.
Dialogue: 0,0:21:39.17,0:21:40.21,Default,,0,0,0,,Ухммм… ммм…
Dialogue: 0,0:21:41.88,0:21:43.55,Default,,0,0,0,,Ха! (Лис)!
Dialogue: 0,0:21:44.13,0:21:45.26,Default,,0,0,0,,<Не...>
Dialogue: 0,0:21:49.51,0:21:50.85,Default,,0,0,0,,Уф
Dialogue: 0,0:22:10.20,0:22:13.16,Default,,0,0,0,,♪～
Dialogue: 0,0:23:35.70,0:23:38.66,Default,,0,0,0,,～♪
