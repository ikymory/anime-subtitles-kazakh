Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:06.92,Default,,0,0,0,,Әй!
Dialogue: 0,0:00:09.17,0:00:11.42,Default,,0,0,0,,А, қазірдің өзінде!
Dialogue: 0,0:00:14.80,0:00:17.51,Default,,0,0,0,,Келесі жолы мен сізге қалай болатынын көрсетемін! (Шигеру күрсініп)
Dialogue: 0,0:00:17.64,0:00:20.43,Default,,0,0,0,,<Сейка-сан ойын автоматын ойнап жатыр>
Dialogue: 0,0:00:21.14,0:00:22.43,Default,,0,0,0,,<Ал мұнда...>
Dialogue: 0,0:00:24.27,0:00:26.56,Default,,0,0,0,,<Қандай казино>
Dialogue: 0,0:00:29.69,0:00:32.65,Default,,0,0,0,,♪～
Dialogue: 0,0:01:53.48,0:01:56.45,Default,,0,0,0,,～♪
Dialogue: 0,0:02:08.29,0:02:10.50,Default,,0,0,0,,Міне, біз келдік!
Dialogue: 0,0:02:10.63,0:02:12.46,Default,,0,0,0,,Бұл Валерия княздігі...
Dialogue: 0,0:02:12.88,0:02:16.47,Default,,0,0,0,,Бастапқы әлем бойынша ол жергілікті қаланың көлемімен бірдей болар еді.
Dialogue: 0,0:02:16.84,0:02:19.93,Default,,0,0,0,,Иә, Ирияда жоқ нәрселер бар сияқты.
Dialogue: 0,0:02:21.09,0:02:22.22,Default,,0,0,0,,<Қамал! ＞
Dialogue: 0,0:02:22.68,0:02:24.47,Default,,0,0,0,,Сәлем < жанында! ＞
Dialogue: 0,0:02:24.89,0:02:28.77,Default,,0,0,0,,<Тіпті басқа әлемде де мен еңбекті қорғау кеңсесінің атын көргім келеді...>
Dialogue: 0,0:02:28.98,0:02:29.98,Default,,0,0,0,,(Адамның күрсінуі)
Dialogue: 0,0:02:32.73,0:02:36.44,Default,,0,0,0,,<Адам компанияның құлы болғаннан кейін қашып құтыла алмайды...>
Dialogue: 0,0:02:38.32,0:02:40.74,Default,,0,0,0,,жүкті жануарларды қайтаруды талап етеді.
Dialogue: 0,0:02:40.86,0:02:42.95,Default,,0,0,0,,Мұнда толтырыңыз.
Dialogue: 0,0:02:44.33,0:02:45.99,Default,,0,0,0,,Қош бол...
Dialogue: 0,0:02:47.62,0:02:49.12,Default,,0,0,0,,Тұтынушы
Dialogue: 0,0:02:49.25,0:02:52.13,Default,,0,0,0,,Үйде ондай жануарлар көп емес...
Dialogue: 0,0:02:52.25,0:02:53.75,Default,,0,0,0,,<Бұл жануар емес>
Dialogue: 0,0:02:54.00,0:02:56.46,Default,,0,0,0,,Ол сіздің партияңыздың мүшесі ме?
Dialogue: 0,0:02:56.71,0:02:58.47,Default,,0,0,0,,Иә!
Dialogue: 0,0:02:58.59,0:03:00.26,Default,,0,0,0,,<Сіз таң қалдыңыз ба? ＞
Dialogue: 0,0:03:00.55,0:03:03.05,Default,,0,0,0,,А, мына бала Шигеруге ұқсайды!
Dialogue: 0,0:03:03.18,0:03:03.97,Default,,0,0,0,,<Байыпты түрде! ＞
Dialogue: 0,0:03:04.55,0:03:06.26,Default,,0,0,0,,<Байыпты Бусса>
Dialogue: 0,0:03:06.39,0:03:08.31,Default,,0,0,0,,Өте сүйкімді хехе
Dialogue: 0,0:03:08.43,0:03:09.23,Default,,0,0,0,,<Иә! ＞
Dialogue: 0,0:03:09.60,0:03:11.31,Default,,0,0,0,,Бұл сүйкімді ме?
Dialogue: 0,0:03:11.44,0:03:13.31,Default,,0,0,0,,Бұл адамға байланысты деп ойлаймын.
Dialogue: 0,0:03:13.81,0:03:16.78,Default,,0,0,0,,Мына бала да сүйкімді! Хехе
Dialogue: 0,0:03:16.94,0:03:21.53,Default,,0,0,0,,<Ал, қыздар бәрі сүйкімді дейді...>
Dialogue: 0,0:03:24.83,0:03:26.28,Default,,0,0,0,,Ммм...
Dialogue: 0,0:03:27.54,0:03:28.70,Default,,0,0,0,,Ах
Dialogue: 0,0:03:28.87,0:03:30.12,Default,,0,0,0,,Сейка-сан!
Dialogue: 0,0:03:30.25,0:03:31.96,Default,,0,0,0,,А, күте тұрыңыз!
Dialogue: 0,0:03:33.21,0:03:35.88,Default,,0,0,0,,<Бір қарағанда, бұл керемет басқа әлем сияқты көрінеді>
Dialogue: 0,0:03:36.00,0:03:38.42,Default,,0,0,0,,<Бұл өте ауыр>
Dialogue: 0,0:03:38.92,0:03:41.63,Default,,0,0,0,,<Біріншіден, құбыжықтар алтын түсірмейді>
Dialogue: 0,0:03:42.05,0:03:44.97,Default,,0,0,0,,<Себебі ол аштық пен шаршауды тудырады>
Dialogue: 0,0:03:45.10,0:03:47.31,Default,,0,0,0,,<Ол белгілі бір соманы құрайды>
Dialogue: 0,0:03:47.97,0:03:53.56,Default,,0,0,0,,<Егер бұл аз ғана ақша болса, мен садақ пен жебе буыны арқылы алхимияны қолдана аламын...>
Dialogue: 0,0:03:53.90,0:03:57.61,Default,,0,0,0,,<Егер сіз табысыңызды қандай да бір жолмен қамтамасыз етпесеңіз, сіз кептеліп қаласыз.>
Dialogue: 0,0:03:59.44,0:04:01.61,Default,,0,0,0,,<Менің абсолютті құдай ретіндегі мақсатым>
Dialogue: 0,0:04:01.82,0:04:04.70,Default,,0,0,0,,<Осы екі адамды сахна артына бағыттау>
Dialogue: 0,0:04:04.91,0:04:09.04,Default,,0,0,0,,<Бірақ оңай жеңілдету екеуіңе де бұғау болады.>
Dialogue: 0,0:04:09.16,0:04:10.87,Default,,0,0,0,,<Менің күшім жасырын қалады>
Dialogue: 0,0:04:11.16,0:04:14.46,Default,,0,0,0,,<Біз табысқа жол салуымыз керек>
Dialogue: 0,0:04:15.96,0:04:19.92,Default,,0,0,0,,<Бұл дүниеде екі адам аман қалу үшін...>
Dialogue: 0,0:04:22.26,0:04:23.51,Default,,0,0,0,,Мемлекеттік мекемелер мен дүкендер
Dialogue: 0,0:04:23.97,0:04:26.89,Default,,0,0,0,,Мен де саудагерлерден және басқалардан сұрадым.
Dialogue: 0,0:04:27.01,0:04:31.02,Default,,0,0,0,,Ақшаны алу құралдарының бастапқы дүниеден көп айырмашылығы жоқ сияқты.
Dialogue: 0,0:04:31.56,0:04:32.52,Default,,0,0,0,,Ал 3D маневрлік жабдық ше?
Dialogue: 0,0:04:33.23,0:04:36.40,Default,,0,0,0,,Мен жұмысқа тұрамын. Шынайы ма? Менің арманым жоқ.
Dialogue: 0,0:04:36.61,0:04:40.44,Default,,0,0,0,,Басқа әлемге келіп жұмыс іздеу қызықсыз.
Dialogue: 0,0:04:40.57,0:04:41.53,Default,,0,0,0,,Аха…
Dialogue: 0,0:04:42.28,0:04:45.24,Default,,0,0,0,,Қалай болғанда да, қалыпты өмір сүріп жатқан сияқты адамдар
Dialogue: 0,0:04:45.36,0:04:47.24,Default,,0,0,0,,If you have some kind of job
Dialogue: 0,0:04:47.37,0:04:50.24,Default,,0,0,0,,Айлық жалақы 2000 лир шамасында көрінеді.
Dialogue: 0,0:04:50.37,0:04:53.08,Default,,0,0,0,,<Шамамен 200 000 жапон иені...>
Dialogue: 0,0:04:53.21,0:04:56.04,Default,,0,0,0,,Құбыжықтарды өлтіргеніңіз үшін ақы алмайсыз ба?
Dialogue: 0,0:04:56.17,0:04:58.29,Default,,0,0,0,,Сіз кеше орданы жеңдіңіз, солай ма?
Dialogue: 0,0:04:58.59,0:05:01.17,Default,,0,0,0,,Өйткені біз оны рұқсатсыз жойдық.
Dialogue: 0,0:05:01.30,0:05:03.38,Default,,0,0,0,,Жүлде жоқ сияқты.
Dialogue: 0,0:05:03.55,0:05:05.30,Default,,0,0,0,,Тек өтінішті алғаннан кейін...
Dialogue: 0,0:05:05.51,0:05:08.26,Default,,0,0,0,,Ойлап қарасам, Халлованың да қымбат жұмысы бар екен.
Dialogue: 0,0:05:10.43,0:05:13.14,Default,,0,0,0,,<Сәулет, өндіріс, сату...>
Dialogue: 0,0:05:13.31,0:05:16.31,Default,,0,0,0,,<Жұмыс түрі мен жалақысы қалыпты... иә? ＞
Dialogue: 0,0:05:18.19,0:05:20.02,Default,,0,0,0,,<"Детектив көмекшісі"...>
Dialogue: 0,0:05:20.15,0:05:23.78,Default,,0,0,0,,<Жалақы айына 10 000 лира... 1 миллион иен? ＞
Dialogue: 0,0:05:25.20,0:05:28.66,Default,,0,0,0,,<Бұл 1,5 миллион және 2,5 миллион! ＞
Dialogue: 0,0:05:28.78,0:05:31.58,Default,,0,0,0,,Қоқыс тазалау үшін айына <2,8 миллион иен...>
Dialogue: 0,0:05:31.99,0:05:34.54,Default,,0,0,0,,<Бұл қандай қоқыс...>
Dialogue: 0,0:05:34.87,0:05:37.75,Default,,0,0,0,,Олардың барлығы тәжірибе қажет емес екенін айтты.
Dialogue: 0,0:05:37.87,0:05:40.42,Default,,0,0,0,,Do you think the job is legitimate?
Dialogue: 0,0:05:40.54,0:05:43.67,Default,,0,0,0,,Жоқ, жоқ, жоқ! Ең жақсы жағдайда бұл өте қара
Dialogue: 0,0:05:43.80,0:05:45.26,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:05:45.42,0:05:48.97,Default,,0,0,0,,<Егер бұл Сейка-сан болса, оны оңай ұстайды деп ойлаймын.>
Dialogue: 0,0:05:49.09,0:05:50.80,Default,,0,0,0,,Қандай мейірімді жұмыс орны!
Dialogue: 0,0:05:51.35,0:05:55.48,Default,,0,0,0,,Лайықты жұмыс – қалыпты өмір сүруге мүмкіндік беретін табыс.
Dialogue: 0,0:05:55.60,0:06:00.86,Default,,0,0,0,,Екінші жағынан, күмәнді жұмыс тәжірибесі жоқ адамдар үшін де өте жоғары табыс әкеледі...
Dialogue: 0,0:06:01.06,0:06:02.07,Default,,0,0,0,,Сейджи мырза?
Dialogue: 0,0:06:02.61,0:06:05.03,Default,,0,0,0,,Шигеру мырза, менің талқылайтын нәрсем бар.
Dialogue: 0,0:06:05.15,0:06:06.36,Default,,0,0,0,,Иә
Dialogue: 0,0:06:06.86,0:06:08.36,Default,,0,0,0,,Would you like to go to the casino?
Dialogue: 0,0:06:08.57,0:06:11.83,Default,,0,0,0,,Казино! Сіз тез байып кетуді мақсат етесіз бе?
Dialogue: 0,0:06:11.95,0:06:13.70,Default,,0,0,0,,А, бұл дұрыс емес.
Dialogue: 0,0:06:13.83,0:06:15.33,Default,,0,0,0,,Мен сізден сұхбат алғым келеді.
Dialogue: 0,0:06:15.95,0:06:17.87,Default,,0,0,0,,<Сұхбаттасқанымша>
Dialogue: 0,0:06:18.33,0:06:21.84,Default,,0,0,0,,<Ешкімде біртүрлі жоғары жалақы алатын жұмыс болған жоқ.>
Dialogue: 0,0:06:22.88,0:06:25.71,Default,,0,0,0,,Бірақ казино сияқты ерекше кеңістікте
Dialogue: 0,0:06:25.84,0:06:28.63,Default,,0,0,0,,Менің ойымша, әр түрлі саладағы адамдар бар.
Dialogue: 0,0:06:28.93,0:06:31.14,Default,,0,0,0,,Басқаша айтқанда, оны казинода бөліңіз.
Dialogue: 0,0:06:31.26,0:06:33.93,Default,,0,0,0,,Көпшілікке жатпайтын адамдардан ақпарат жинау?
Dialogue: 0,0:06:34.06,0:06:34.85,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:06:35.47,0:06:37.64,Default,,0,0,0,,Мен бұл о дүниеде доспын...
Dialogue: 0,0:06:37.89,0:06:41.15,Default,,0,0,0,,Мен барлығына ең жақсы жол ашқым келеді.
Dialogue: 0,0:06:41.86,0:06:46.15,Default,,0,0,0,,Бізге бәрінен бұрын көбірек білу керек.
Dialogue: 0,0:06:46.74,0:06:49.40,Default,,0,0,0,,Шигеру-сан, сен маған көмектесе аласың ба?
Dialogue: 0,0:06:50.95,0:06:53.83,Default,,0,0,0,,Иә... Әрине.
Dialogue: 0,0:07:00.42,0:07:01.21,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:05.80,0:07:07.92,Default,,0,0,0,,Хмм… мм…
Dialogue: 0,0:07:08.30,0:07:10.47,Default,,0,0,0,,Менің басым айналып кеткендей болады
Dialogue: 0,0:07:10.59,0:07:12.68,Default,,0,0,0,,Ішіңіз... Уф!
Dialogue: 0,0:07:15.81,0:07:17.39,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:07:17.64,0:07:18.98,Default,,0,0,0,,Нмм цк
Dialogue: 0,0:07:20.02,0:07:21.39,Default,,0,0,0,,(сорғыш сусынның дыбысы)
Dialogue: 0,0:07:21.85,0:07:22.85,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:07:22.98,0:07:27.36,Default,,0,0,0,,<Минус 255 көзқараспен ақпарат жинау қиын>
Dialogue: 0,0:07:27.48,0:07:28.57,Default,,0,0,0,,(сорғыш сусынның дыбысы)
Dialogue: 0,0:07:32.11,0:07:33.32,Default,,0,0,0,,Қызыл 7
Dialogue: 0,0:07:33.45,0:07:34.53,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:07:35.08,0:07:36.03,Default,,0,0,0,,Шигеру-сан!
Dialogue: 0,0:07:36.53,0:07:38.58,Default,,0,0,0,,Көрдіңіз бе? Қараңдар!
Dialogue: 0,0:07:38.70,0:07:40.33,Default,,0,0,0,,Иә, бұл жақсы болды.
Dialogue: 0,0:07:40.46,0:07:41.58,Default,,0,0,0,,<Тоқта>
Dialogue: 0,0:07:41.71,0:07:43.71,Default,,0,0,0,,Жарайды, енді барлық монеталар...
Dialogue: 0,0:07:43.83,0:07:46.84,Default,,0,0,0,,<Сэйджи-сан тапсырманы бірқалыпты орындап жатқан сияқты>
Dialogue: 0,0:07:47.17,0:07:50.09,Default,,0,0,0,,<Өтірік басқа адамдардың терезелерін оқи алатын күшке ие>
Dialogue: 0,0:07:50.42,0:07:51.63,Default,,0,0,0,,<Болашағы бар көрінеді>
Dialogue: 0,0:07:51.76,0:07:53.80,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:54.05,0:07:56.43,Default,,0,0,0,,<Және Сейка-сан...>
Dialogue: 0,0:07:56.93,0:07:58.31,Default,,0,0,0,,Қара 33
Dialogue: 0,0:07:58.93,0:08:00.39,Default,,0,0,0,,♬~
Dialogue: 0,0:08:00.52,0:08:01.56,Default,,0,0,0,,(Шигерудің күрсінуі)
Dialogue: 0,0:08:07.65,0:08:08.61,Default,,0,0,0,,Ммм
Dialogue: 0,0:08:08.98,0:08:10.74,Default,,0,0,0,,<Мен оны жеймін...>
Dialogue: 0,0:08:10.86,0:08:14.61,Default,,0,0,0,,Мен көп ойнадым, бірақ сіз қанша жұмсадыңыз?
Dialogue: 0,0:08:15.07,0:08:16.03,Default,,0,0,0,,Тұр, мен өзі қандай ұлтпын? Хехехе
Dialogue: 0,0:08:16.16,0:08:17.12,Default,,0,0,0,,<Не! ＞
Dialogue: 0,0:08:17.33,0:08:19.12,Default,,0,0,0,,Баланс дегеніміз не?
Dialogue: 0,0:08:19.24,0:08:22.54,Default,,0,0,0,,Бастапқы сома 50 000 лир болды, бірақ қанша қалды?
Dialogue: 0,0:08:22.66,0:08:24.12,Default,,0,0,0,,осы портта бір жерде жасырынып, бізді бақылап отыр.
Dialogue: 0,0:08:25.79,0:08:28.29,Default,,0,0,0,,30 000 лир! Тағы 10 лира!
Dialogue: 0,0:08:28.42,0:08:29.38,Default,,0,0,0,,<Әй, Жаға! ＞
Dialogue: 0,0:08:29.71,0:08:31.13,Default,,0,0,0,,А...
Dialogue: 0,0:08:31.51,0:08:34.09,Default,,0,0,0,,Шигеру-сан, шашың түсіп жатқан жоқ па?
Dialogue: 0,0:08:34.22,0:08:36.18,Default,,0,0,0,,Бастапқыда...
Dialogue: 0,0:08:36.30,0:08:37.55,Default,,0,0,0,,Иә! (Сейка) Хмм...
Dialogue: 0,0:08:37.76,0:08:38.89,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,0:08:39.31,0:08:41.89,Default,,0,0,0,,Жас ханым, маған бір сәт рұқсат етіңіз бе?
Dialogue: 0,0:08:42.23,0:08:43.64,Default,,0,0,0,,Иә
Dialogue: 0,0:08:45.19,0:08:46.81,Default,,0,0,0,,Рахмет
Dialogue: 0,0:08:46.94,0:08:48.48,Default,,0,0,0,,Мен Кажитамын
Dialogue: 0,0:08:48.61,0:08:51.44,Default,,0,0,0,,Мен осы казиноның зал шеберімін.
Dialogue: 0,0:08:51.61,0:08:53.40,Default,,0,0,0,,Кейінірек кездескенше
Dialogue: 0,0:08:53.99,0:08:55.53,Default,,0,0,0,,Холл шебері?
Dialogue: 0,0:08:55.66,0:08:56.91,Default,,0,0,0,,Бұл дүкен менеджері.
Dialogue: 0,0:08:57.24,0:08:58.70,Default,,0,0,0,,Айтпақшы, жас ханым
Dialogue: 0,0:08:58.83,0:09:00.79,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:09:01.16,0:09:02.75,Default,,0,0,0,,Сіз байсыз ба?
Dialogue: 0,0:09:02.87,0:09:05.54,Default,,0,0,0,,Ах! (Сейка) Иә! Мен баймын!
Dialogue: 0,0:09:06.04,0:09:09.59,Default,,0,0,0,,Күтілгендей! Оның мінез-құлқы ойнақы
Dialogue: 0,0:09:09.71,0:09:12.55,Default,,0,0,0,,Менің көзімнен ештеңе болған жоқ!
Dialogue: 0,0:09:12.80,0:09:14.88,Default,,0,0,0,,<“Бай адам” сөз тіркесі>
Dialogue: 0,0:09:15.01,0:09:17.01,Default,,0,0,0,,<Сақ болу керек пе...>
Dialogue: 0,0:09:17.47,0:09:20.01,Default,,0,0,0,,Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:09:20.14,0:09:22.81,Default,,0,0,0,,Бұл жерде бірнеше күрделі нәрселер туралы айту керек.
Dialogue: 0,0:09:22.93,0:09:25.27,Default,,0,0,0,,Дүкеннің артына келіп, менімен сөйлесіңіз.
Dialogue: 0,0:09:25.77,0:09:27.19,Default,,0,0,0,,Ал...
Dialogue: 0,0:09:27.40,0:09:28.77,Default,,0,0,0,,Шигеру-сан...
Dialogue: 0,0:09:30.02,0:09:32.53,Default,,0,0,0,,Бұл Кажита мырза болатын.
Dialogue: 0,0:09:32.69,0:09:34.19,Default,,0,0,0,,Мен сенімен бірге жүре аламын ба?
Dialogue: 0,0:09:35.95,0:09:38.32,Default,,0,0,0,,Сіз оққағарсыз ба?
Dialogue: 0,0:09:38.45,0:09:40.58,Default,,0,0,0,,Әрине
Dialogue: 0,0:09:45.25,0:09:47.21,Default,,0,0,0,,Өтінемін, ыстық шоколад.
Dialogue: 0,0:09:47.37,0:09:49.17,Default,,0,0,0,,Рахмет
Dialogue: 0,0:09:50.71,0:09:54.71,Default,,0,0,0,,<Казино сәнді болды, бірақ бұл жер одан да көп>
Dialogue: 0,0:09:55.22,0:09:57.22,Default,,0,0,0,,<Сіз көп ақша табасыз ба? ＞
Dialogue: 0,0:10:00.64,0:10:01.64,Default,,0,0,0,,Дәмді!
Dialogue: 0,0:10:01.76,0:10:06.10,Default,,0,0,0,,Жас келіншектің ойнақылығы мені қатты таң қалдырды.
Dialogue: 0,0:10:06.27,0:10:09.35,Default,,0,0,0,,Шынымен қызықты, еш ойланбастан кіріңіз!
Dialogue: 0,0:10:09.48,0:10:14.11,Default,,0,0,0,,Байлар, жоқ, миллионерлер осылай ойнайды!
Dialogue: 0,0:10:14.23,0:10:15.19,Default,,0,0,0,,Хехе...
Dialogue: 0,0:10:15.32,0:10:17.74,Default,,0,0,0,,<Себебі мені мүлде мақтаған жоқ>
Dialogue: 0,0:10:17.99,0:10:20.28,Default,,0,0,0,,Бұл жай ғана әңгіме.
Dialogue: 0,0:10:20.41,0:10:23.08,Default,,0,0,0,,Біздің дүкен жақсы билеттері бар тұтынушыларға арналған.
Dialogue: 0,0:10:23.20,0:10:27.33,Default,,0,0,0,,Біз арнайы қызметтерді ұсынамыз.
Dialogue: 0,0:10:27.46,0:10:28.25,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:28.58,0:10:29.58,Default,,0,0,0,,Әдемі...
Dialogue: 0,0:10:29.71,0:10:31.25,Default,,0,0,0,,Қосымша кезең
Dialogue: 0,0:10:32.17,0:10:36.80,Default,,0,0,0,,<Біз қалыпты ойындар жеткіліксіз деп санайтын тұрақты тұтынушылардың сұрауларына жауап бердік>
Dialogue: 0,0:10:36.92,0:10:41.51,Default,,0,0,0,,Тарифтер мен ойындар өте қызықты қызметтер.
Dialogue: 0,0:10:42.14,0:10:45.56,Default,,0,0,0,,Мен сен сияқты адамдардың осы ойынды ойнағанын қалаймын.
Dialogue: 0,0:10:45.72,0:10:49.39,Default,,0,0,0,,Сондықтан әдетте 20 000 лир қосымша төлем алынады...
Dialogue: 0,0:10:49.77,0:10:52.61,Default,,0,0,0,,Қосылу жарнасы немесе жылдық төлем жоқ!
Dialogue: 0,0:10:52.73,0:10:55.23,Default,,0,0,0,,Бұл тек қазір қолжетімді арнайы қызмет!
Dialogue: 0,0:10:55.36,0:10:57.11,Default,,0,0,0,,<О, жақсы келісім~>
Dialogue: 0,0:10:57.24,0:10:59.03,Default,,0,0,0,,Енді қалай ойлайсыңдар?
Dialogue: 0,0:10:59.20,0:11:00.95,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:11:01.07,0:11:04.16,Default,,0,0,0,,Аа, келесі жылдан бастап жыл сайынғы мүшелік жарна болады емес пе?
Dialogue: 0,0:11:04.37,0:11:07.54,Default,,0,0,0,,<Сіз күдікті нәрселерге сұрақ қоя аласыз ба?>
Dialogue: 0,0:11:07.66,0:11:09.12,Default,,0,0,0,,<Тамаша, Сейка-сан>
Dialogue: 0,0:11:09.25,0:11:12.71,Default,,0,0,0,,Жоқ, өмір бойы тегін болады.
Dialogue: 0,0:11:12.83,0:11:16.30,Default,,0,0,0,,Мен сіздің қызыңыздың мүше болғанын қалаймын.
Dialogue: 0,0:11:16.42,0:11:17.55,Default,,0,0,0,,Неге мен?
Dialogue: 0,0:11:18.21,0:11:19.55,Default,,0,0,0,,Бұл романтикалық.
Dialogue: 0,0:11:20.01,0:11:23.05,Default,,0,0,0,,Сол талғампаз және нәзік қолдардан туған ойын
Dialogue: 0,0:11:23.18,0:11:25.56,Default,,0,0,0,,Бұл әрқашан толық қуат!
Dialogue: 0,0:11:25.85,0:11:27.39,Default,,0,0,0,,Керемет!
Dialogue: 0,0:11:27.52,0:11:28.39,Default,,0,0,0,,Хехе
Dialogue: 0,0:11:28.52,0:11:32.27,Default,,0,0,0,,＜Айтқанымдай, қалай қарасаңыз да, алдау үшін келдіңіз.＞
Dialogue: 0,0:11:32.52,0:11:35.57,Default,,0,0,0,,Сондықтан біздің дүкеннің мүшесі болыңыз.
Dialogue: 0,0:11:37.73,0:11:38.82,Default,,0,0,0,,Шигеру-сан...
Dialogue: 0,0:11:38.94,0:11:39.86,Default,,0,0,0,,Хмм
Dialogue: 0,0:11:40.07,0:11:42.07,Default,,0,0,0,,Тек картаны алу жақсы емес пе?
Dialogue: 0,0:11:42.41,0:11:45.16,Default,,0,0,0,,Бірақ сен неге Сэйджи-санмен сөйлеспейсің?
Dialogue: 0,0:11:45.28,0:11:46.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:46.45,0:11:49.08,Default,,0,0,0,,Мен бір досыммен сөйлескім келеді.
Dialogue: 0,0:11:51.41,0:11:55.13,Default,,0,0,0,,Әрине, маған хабарлаңыз!
Dialogue: 0,0:11:55.25,0:11:59.30,Default,,0,0,0,,Жас келіншектің досы болсаң, бай шығарсың!
Dialogue: 0,0:11:59.63,0:12:03.18,Default,,0,0,0,,Иә, мен баймын! Мен сияқты жақсы емес!
Dialogue: 0,0:12:03.30,0:12:05.43,Default,,0,0,0,,<Олай айтпа! ＞
Dialogue: 0,0:12:07.01,0:12:10.48,Default,,0,0,0,,Бұл мәселені басқа тұтынушылардан құпия сақтаңыз.
Dialogue: 0,0:12:10.77,0:12:14.52,Default,,0,0,0,,Біз сізден хабар күтеміз.
Dialogue: 0,0:12:16.23,0:12:18.36,Default,,0,0,0,,Кажита мырза жақсы адам еді.
Dialogue: 0,0:12:18.52,0:12:19.44,Default,,0,0,0,,<Иә? ＞
Dialogue: 0,0:12:20.36,0:12:21.74,Default,,0,0,0,,Әй, Лидс мырза!
Dialogue: 0,0:12:22.07,0:12:23.53,Default,,0,0,0,,Бұл дұрыс болды
Dialogue: 0,0:12:23.66,0:12:25.49,Default,,0,0,0,,Мен Сейджи-санды тауып алайын!
Dialogue: 0,0:12:28.79,0:12:31.00,Default,,0,0,0,,Ах... хмм...
Dialogue: 0,0:12:32.21,0:12:34.08,Default,,0,0,0,,Екеуің аман болғандарыңа қуаныштымын...
Dialogue: 0,0:12:34.21,0:12:35.42,Default,,0,0,0,,Жағдай...
Dialogue: 0,0:12:35.54,0:12:39.05,Default,,0,0,0,,Мен бұрын кездескен Кажита деген адам қауіпті ме?
Dialogue: 0,0:12:39.30,0:12:43.01,Default,,0,0,0,,Иә, жағдайға байланысты абсолютті құдай болып табылатын Шигеру-сан да...
Dialogue: 0,0:12:43.13,0:12:44.13,Default,,0,0,0,,Не?
Dialogue: 0,0:12:44.26,0:12:46.01,Default,,0,0,0,,Каджита туралы арнайы ескертулер…
Dialogue: 0,0:12:46.18,0:12:49.26,Default,,0,0,0,,Қабілетке қатысты бөлімде былай жазылды:
Dialogue: 0,0:12:54.52,0:12:57.06,Default,,0,0,0,,<"Мен енді алданбаймын">
Dialogue: 0,0:12:57.81,0:13:00.36,Default,,0,0,0,,«Байды әбден езеді»
Dialogue: 0,0:13:01.90,0:13:06.28,Default,,0,0,0,,<"Мен оны сорып алып, толығымен шешіп тастағанымда"...>
Dialogue: 0,0:13:11.41,0:13:14.37,Default,,0,0,0,,Мен сені тозаққа құлатамын
Dialogue: 0,0:13:17.33,0:13:18.21,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:18.63,0:13:21.21,Default,,0,0,0,,Кажита мырза, сіз жаман адамсыз ба?
Dialogue: 0,0:13:21.46,0:13:25.84,Default,,0,0,0,,Мен әзірге нақты айта алмаймын, бірақ бұл біршама күдікті деп ойлаймын.
Dialogue: 0,0:13:25.97,0:13:27.05,Default,,0,0,0,,Бұл...
Dialogue: 0,0:13:27.18,0:13:30.22,Default,,0,0,0,,Шигеру мырза туралы не ойладыңыз? Кажита мырзадан қандай әсер алдың?
Dialogue: 0,0:13:30.60,0:13:32.02,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:13:32.14,0:13:34.35,Default,,0,0,0,,Мен сені күннен қорғайтын көзілдірікті шешу керек деп ойладым.
Dialogue: 0,0:13:34.48,0:13:35.73,Default,,0,0,0,,Бұл жақсы
Dialogue: 0,0:13:36.10,0:13:37.56,Default,,0,0,0,,Бұл жай әзіл
Dialogue: 0,0:13:37.69,0:13:40.48,Default,,0,0,0,,Мен оның қорқынышты жігіт екенін жай ғана сезіндім.
Dialogue: 0,0:13:40.90,0:13:44.32,Default,,0,0,0,,<Әйтеуір, ол құмарлықты оятуға шебер еді>
Dialogue: 0,0:13:44.44,0:13:47.66,Default,,0,0,0,,<Сіз басқа адамға өзінің ерекше екенін сездіргіңіз келеді.>
Dialogue: 0,0:13:48.11,0:13:52.16,Default,,0,0,0,,Сейка-сан мінген жоқ, бірақ кейбір адамдар оңай құлап кететініне сенімдімін.
Dialogue: 0,0:13:52.29,0:13:54.37,Default,,0,0,0,,Менің ойымша, ол өте қауіпті адам.
Dialogue: 0,0:13:54.50,0:13:56.41,Default,,0,0,0,,Сіз соншалықты көп нәрсені қайдан білесіз?
Dialogue: 0,0:13:56.54,0:14:00.21,Default,,0,0,0,,<Бұл Лидстің басқа адамдардың терезелерін оқу қабілетінің арқасында...>
Dialogue: 0,0:14:00.46,0:14:02.50,Default,,0,0,0,,Мен детектив болдым.
Dialogue: 0,0:14:02.63,0:14:03.59,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:14:03.71,0:14:04.76,Default,,0,0,0,,Сен менімен бірге құлайсың!
Dialogue: 0,0:14:05.13,0:14:07.51,Default,,0,0,0,,Өтінемін, енді мені мазақ етпе!
Dialogue: 0,0:14:09.18,0:14:11.51,Default,,0,0,0,,Баршалар, менің де баяндамамды тыңдауларыңызды қалаймын.
Dialogue: 0,0:14:13.47,0:14:15.77,Default,,0,0,0,,Бұл бос орындарда ортақ нәрсе бар
Dialogue: 0,0:14:16.35,0:14:19.60,Default,,0,0,0,,Жалақы өте жоғары Мансап Тәжірибе қажет емес
Dialogue: 0,0:14:19.73,0:14:21.52,Default,,0,0,0,,Тағы бір нәрсе...
Dialogue: 0,0:14:21.98,0:14:24.03,Default,,0,0,0,,Барлығы казиноға қосылған
Dialogue: 0,0:14:24.15,0:14:25.28,Default,,0,0,0,,А...
Dialogue: 0,0:14:25.57,0:14:26.99,Default,,0,0,0,,Казинодағы сұхбат
Dialogue: 0,0:14:27.11,0:14:30.70,Default,,0,0,0,,Біз сол жоғары жалақы алатын жұмысқа өтініш білдірген адамдардан естідік.
Dialogue: 0,0:14:31.74,0:14:34.04,Default,,0,0,0,,<Әр байланыс нүктесі әртүрлі болса да>
Dialogue: 0,0:14:34.29,0:14:37.46,Default,,0,0,0,,<Әрбір жұмыс ұсынысы сізді казиноға жібереді>
Dialogue: 0,0:14:37.58,0:14:39.58,Default,,0,0,0,,<Тек сұхбаттан өте алмағандар>
Dialogue: 0,0:14:39.71,0:14:42.96,Default,,0,0,0,,<Ешкім нақты жұмысқа орналаспаған>
Dialogue: 0,0:14:43.25,0:14:45.30,Default,,0,0,0,,Тіпті бір адам жұмысқа қабылданса да
Dialogue: 0,0:14:45.42,0:14:47.38,Default,,0,0,0,,Жақсы көрінеді...
Dialogue: 0,0:14:47.51,0:14:48.30,Default,,0,0,0,,Тек бір адам
Dialogue: 0,0:14:48.55,0:14:52.30,Default,,0,0,0,,<Мен детектив көмекшісі болып жұмыс істейтін адамның досы болып табылатын адамды таптым.>
Dialogue: 0,0:14:52.47,0:14:54.06,Default,,0,0,0,,<Аты - Йошио Кай>
Dialogue: 0,0:14:54.89,0:14:59.23,Default,,0,0,0,,<Ёшио досының айтуынша, детектив көмекшісінің жұмысы өте қарапайым>
Dialogue: 0,0:14:59.35,0:15:02.36,Default,,0,0,0,,<Олар жай ғана казинода көңіл көтеріп жүрген адамдарды тапқан сияқты>
Dialogue: 0,0:15:03.02,0:15:05.32,Default,,0,0,0,,Сонда сіздің айлық жалақыңыз 1 миллион иен?
Dialogue: 0,0:15:05.48,0:15:07.78,Default,,0,0,0,,Бұл оқиғада тағы да көп нәрсе бар
Dialogue: 0,0:15:07.99,0:15:09.61,Default,,0,0,0,,Сол дос...
Dialogue: 0,0:15:09.78,0:15:11.66,Default,,0,0,0,,Қазіргі уақытта ол із-түзсіз жоғалған.
Dialogue: 0,0:15:11.78,0:15:12.57,Default,,0,0,0,,А...
Dialogue: 0,0:15:13.07,0:15:17.08,Default,,0,0,0,,Досымен байланыса алмаған Йошио оның үйіне барып,...
Dialogue: 0,0:15:17.95,0:15:19.46,Default,,0,0,0,,<Үй бос жерде>
Dialogue: 0,0:15:19.58,0:15:21.46,Default,,0,0,0,,<Тіпті отбасы кітабы да жоғалып кеткен...>
Dialogue: 0,0:15:22.33,0:15:24.79,Default,,0,0,0,,Мемлекеттік кеңсе тіпті іздеу сұрауларын да қабылдамайды.
Dialogue: 0,0:15:24.96,0:15:28.34,Default,,0,0,0,,Ол ең алдымен өзін жоқ сияқты қабылдағанын айтты.
Dialogue: 0,0:15:28.55,0:15:29.63,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:15:29.76,0:15:33.80,Default,,0,0,0,,Казиноларға байланысты жұмыс орындарында жұмыс істейтін адамдарды табудың әлі де қиын болуының себебі мынада
Dialogue: 0,0:15:33.93,0:15:36.22,Default,,0,0,0,,Өйткені ол жойылады?
Dialogue: 0,0:15:36.35,0:15:38.56,Default,,0,0,0,,Бұл да мүмкін
Dialogue: 0,0:15:38.68,0:15:42.69,Default,,0,0,0,,<Шынында да, Каджитаның ерекше жазбаларын ескере отырып...>
Dialogue: 0,0:15:42.81,0:15:43.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:45.90,0:15:47.78,Default,,0,0,0,,<Айтар сөзің болса, айт>
Dialogue: 0,0:15:47.90,0:15:49.86,Default,,0,0,0,,<Ештеңеге қарамастан мен сенің соңынан еремін>
Dialogue: 0,0:15:50.19,0:15:51.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:51.57,0:15:53.11,Default,,0,0,0,,Хмм... бұл
Dialogue: 0,0:15:53.74,0:15:56.83,Default,,0,0,0,,Мен мұны казиноның артқы есігінен таптым.
Dialogue: 0,0:16:03.04,0:16:04.63,Default,,0,0,0,,Ха! <Бұл...>
Dialogue: 0,0:16:04.88,0:16:05.75,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:16:05.88,0:16:07.55,Default,,0,0,0,,Сейка-санды көрмеген дұрыс.
Dialogue: 0,0:16:07.67,0:16:08.63,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:16:10.88,0:16:13.38,Default,,0,0,0,,Адам саусақтары
Dialogue: 0,0:16:13.68,0:16:14.80,Default,,0,0,0,,Ха!!
Dialogue: 0,0:16:15.64,0:16:18.35,Default,,0,0,0,,Мен артқы есікті тексердім...
Dialogue: 0,0:16:24.81,0:16:25.86,Default,,0,0,0,,Хмм
Dialogue: 0,0:16:30.32,0:16:31.40,Default,,0,0,0,,Ха!!
Dialogue: 0,0:16:32.24,0:16:34.86,Default,,0,0,0,,Мен не қуарымды, не алуымды білмедім...
Dialogue: 0,0:16:34.99,0:16:37.16,Default,,0,0,0,,Жоқ, бұл ең жақсы таңдау болды.
Dialogue: 0,0:16:37.58,0:16:39.70,Default,,0,0,0,,Қуып жету өте қауіпті
Dialogue: 0,0:16:39.83,0:16:40.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:41.37,0:16:45.04,Default,,0,0,0,,Кем дегенде, бұл казино көлеңкелі нәрсе істеп жатыр.
Dialogue: 0,0:16:45.21,0:16:46.92,Default,,0,0,0,,Бұл сөзсіз дұрыс
Dialogue: 0,0:16:47.67,0:16:51.92,Default,,0,0,0,,Ішінде не болып жатқанын білсем ғой...
Dialogue: 0,0:16:52.05,0:16:55.18,Default,,0,0,0,,Сэйдзи-сан! Мен жасырын тергеу жүргіземін!
Dialogue: 0,0:16:55.38,0:16:56.76,Default,,0,0,0,,Иә! (Сэйджи) Сейка-сан?
Dialogue: 0,0:16:56.89,0:16:57.76,Default,,0,0,0,,Ол ісініп, қан ағып тұр
Dialogue: 0,0:16:57.89,0:17:00.60,Default,,0,0,0,,Мені дүкен менеджері шақырып жатыр!
Dialogue: 0,0:17:00.72,0:17:03.68,Default,,0,0,0,,Ең бастысы, мен партиядағы ең бай адаммын.
Dialogue: 0,0:17:03.81,0:17:05.69,Default,,0,0,0,,<Қазірдің өзінде 20 000 иен>
Dialogue: 0,0:17:05.85,0:17:07.73,Default,,0,0,0,,Сейка-сан, бұл қауіпті!
Dialogue: 0,0:17:07.86,0:17:08.98,Default,,0,0,0,,Не болды, мырза Мокки!
Dialogue: 0,0:17:09.11,0:17:11.86,Default,,0,0,0,,Басты мақсат байлар болса керек.
Dialogue: 0,0:17:11.98,0:17:13.69,Default,,0,0,0,,Мен оның қауіпті екенін білемін.
Dialogue: 0,0:17:14.36,0:17:15.53,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:17:15.82,0:17:17.87,Default,,0,0,0,,Мен ашуландым!
Dialogue: 0,0:17:17.99,0:17:20.03,Default,,0,0,0,,Біреуді алдау және ренжіту
Dialogue: 0,0:17:20.16,0:17:22.58,Default,,0,0,0,,Кажита мырза өте жаман адам!
Dialogue: 0,0:17:22.95,0:17:25.50,Default,,0,0,0,,<Сейка-сан ерекше ыстық...>
Dialogue: 0,0:17:25.62,0:17:28.04,Default,,0,0,0,,<Көшбасшы, тоқтатыңыз>
Dialogue: 0,0:17:28.25,0:17:29.21,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:17:29.34,0:17:30.46,Default,,0,0,0,,<Күте тұрыңыз! ＞
Dialogue: 0,0:17:30.75,0:17:34.26,Default,,0,0,0,,Казино шенеуніктердің көмегімен жаман істер жасап жатқан шығар.
Dialogue: 0,0:17:34.38,0:17:38.39,Default,,0,0,0,,Біз мемлекеттік мекемелерге сене алмайтындықтан, бәрін өзіміз шешуіміз керек...
Dialogue: 0,0:17:38.55,0:17:39.80,Default,,0,0,0,,Сейка-сан, өтінемін!
Dialogue: 0,0:17:39.93,0:17:43.14,Default,,0,0,0,,<Екеуің де әділдік сезімін тудырдың ба?>
Dialogue: 0,0:17:44.93,0:17:48.35,Default,,0,0,0,,Кешіріңіз, мен Сейка-санды тоқтата алмадым.
Dialogue: 0,0:17:48.60,0:17:49.98,Default,,0,0,0,,Сіз ашулысыз ба?
Dialogue: 0,0:17:50.11,0:17:51.65,Default,,0,0,0,,Ашу бар
Dialogue: 0,0:17:51.98,0:17:54.74,Default,,0,0,0,,Бірақ бұл Кажитаға арналған.
Dialogue: 0,0:17:55.03,0:17:58.99,Default,,0,0,0,,Мен сабырлы болғым келеді, бірақ менің эмоцияларым жарылып кетердей сезінемін.
Dialogue: 0,0:17:59.32,0:18:01.58,Default,,0,0,0,,<Хмм, бұл таңқаларлық>
Dialogue: 0,0:18:01.70,0:18:04.12,Default,,0,0,0,,<Ол осылай көрінсе де, ол Сейджидің қарындасы ғой.>
Dialogue: 0,0:18:04.29,0:18:06.75,Default,,0,0,0,,<Менің өтірік айта алмайтыным да бар шығар...>
Dialogue: 0,0:18:07.21,0:18:08.25,Default,,0,0,0,,Лидс
Dialogue: 0,0:18:08.42,0:18:11.54,Default,,0,0,0,,Кажита тіпті мен, абсолютті құдайдың өзі қауіпті екенін айтты.
Dialogue: 0,0:18:11.67,0:18:14.09,Default,,0,0,0,,Ол қандай қабілетті пайдаланады?
Dialogue: 0,0:18:14.30,0:18:16.72,Default,,0,0,0,,Мен бәрін білмеймін, бірақ...
Dialogue: 0,0:18:16.97,0:18:19.72,Default,,0,0,0,,Каджита кез келген өтіріктен көз жеткізе алатын сияқты.
Dialogue: 0,0:18:20.39,0:18:22.93,Default,,0,0,0,,<Өтірікті анықтау - триггер>
Dialogue: 0,0:18:23.10,0:18:26.31,Default,,0,0,0,,<Көбірек қабілеттер іске қосыла ма деп ойлаймын...>
Dialogue: 0,0:18:26.77,0:18:29.65,Default,,0,0,0,,Сіз не болатынын нақты білмейсіз бе?
Dialogue: 0,0:18:29.77,0:18:30.69,Default,,0,0,0,,Иә
Dialogue: 0,0:18:30.86,0:18:34.11,Default,,0,0,0,,Алайда, Кажитаның терезесі тым біртүрлі болды...
Dialogue: 0,0:18:35.19,0:18:38.24,Default,,0,0,0,,<Ол үзілген және бұрмаланған, қию және қою сияқты...>
Dialogue: 0,0:18:38.40,0:18:41.12,Default,,0,0,0,,<Бұл қалыпты күй емес>
Dialogue: 0,0:18:42.28,0:18:44.87,Default,,0,0,0,,Өтірік айтудан сақ болыңыз.
Dialogue: 0,0:18:44.99,0:18:46.41,Default,,0,0,0,,<Өтірік...>
Dialogue: 0,0:18:46.54,0:18:47.54,Default,,0,0,0,,<Бұрынғыдай>
Dialogue: 0,0:18:47.66,0:18:51.67,Default,,0,0,0,,<Мен бұрын детектив болдым деп адамдарды адастырудан аулақ болуым керек.>
Dialogue: 0,0:18:52.96,0:18:55.25,Default,,0,0,0,,Түсіндім, рахмет.
Dialogue: 0,0:18:55.38,0:18:56.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:56.55,0:18:57.88,Default,,0,0,0,,Шигеру-сан...
Dialogue: 0,0:18:58.01,0:19:00.26,Default,,0,0,0,,Ерекше ескертпелер сөйлем шығар
Dialogue: 0,0:19:00.38,0:19:03.47,Default,,0,0,0,,«Байды әбден езеді» деген сөз.
Dialogue: 0,0:19:03.64,0:19:05.89,Default,,0,0,0,,Менің ойымша, Кажитаның шынайы сезімі көрінеді.
Dialogue: 0,0:19:06.35,0:19:08.10,Default,,0,0,0,,<Реяны мен жаздым>
Dialogue: 0,0:19:08.27,0:19:11.48,Default,,0,0,0,,<Мені өшпенділіктің ерекше ноталары тербетіп, қарсылық көрсетті>
Dialogue: 0,0:19:12.06,0:19:13.44,Default,,0,0,0,,Бірақ Кажита...
Dialogue: 0,0:19:14.02,0:19:17.99,Default,,0,0,0,,жеккөрушілік найзасын таңдау үшін казиноны пайдалану.
Dialogue: 0,0:19:18.15,0:19:20.57,Default,,0,0,0,,Ешқашан кешірілмеу керек
Dialogue: 0,0:19:20.86,0:19:23.95,Default,,0,0,0,,Хе, басында ақша үшін болды.
Dialogue: 0,0:19:24.12,0:19:26.83,Default,,0,0,0,,Енді бір зұлымдық әшкере болды.
Dialogue: 0,0:19:27.20,0:19:28.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:28.16,0:19:30.29,Default,,0,0,0,,-де барлығы бір ауыздан дем алады.
Dialogue: 0,0:19:30.41,0:19:32.79,Default,,0,0,0,,Жамандыққа қарсы тұруға тырысу
Dialogue: 0,0:19:33.04,0:19:36.59,Default,,0,0,0,,Бұл біртүрлі, бірақ екінші жағынан, мен өзімді сәл көтеріңкі сезінемін.
Dialogue: 0,0:19:37.71,0:19:38.67,Default,,0,0,0,,Иә
Dialogue: 0,0:19:38.88,0:19:42.59,Default,,0,0,0,,Бір мақсат жолында төрт адам бірігіп жұмыс істейді
Dialogue: 0,0:19:42.80,0:19:46.10,Default,,0,0,0,,Бұл да мойындаудан кейінгі дұғам болды.
Dialogue: 0,0:19:46.35,0:19:48.35,Default,,0,0,0,,Төртеуміз кездесе алдық
Dialogue: 0,0:19:48.47,0:19:50.60,Default,,0,0,0,,Мүмкін бұл Лидстің дұғасынан шығар.
Dialogue: 0,0:19:51.19,0:19:53.85,Default,,0,0,0,,Намаздан кейін тағы бар, иә?
Dialogue: 0,0:19:54.19,0:19:58.11,Default,,0,0,0,,Менің алдымда нағыз зұлымдық көрінсе...
Dialogue: 0,0:19:59.07,0:20:01.03,Default,,0,0,0,,Тозақтың хабаршысы болу
Dialogue: 0,0:20:01.20,0:20:03.07,Default,,0,0,0,,Сізді қараңғылыққа шақырады
Dialogue: 0,0:20:03.41,0:20:04.32,Default,,0,0,0,,Не!
Dialogue: 0,0:20:04.95,0:20:06.24,Default,,0,0,0,,Қандай жағымсыз!
Dialogue: 0,0:20:06.41,0:20:09.08,Default,,0,0,0,,Нағыз зұлымдыққа
Dialogue: 0,0:20:19.96,0:20:22.80,Default,,0,0,0,,Уау, өте әдемі!
Dialogue: 0,0:20:25.89,0:20:26.85,Default,,0,0,0,,Сейка-сан
Dialogue: 0,0:20:26.97,0:20:29.60,Default,,0,0,0,,Сіз атақты адам сияқты әрекет етпесеңіз де...
Dialogue: 0,0:20:29.81,0:20:33.35,Default,,0,0,0,,Жоқ Әр уақытта әдемі болу жалғыз нәрсе
Dialogue: 0,0:20:33.48,0:20:35.23,Default,,0,0,0,,Атақтылардың талғамына қарай жасайсыз ба?
Dialogue: 0,0:20:35.35,0:20:37.06,Default,,0,0,0,,Оохохохохо <Бұл қандай кейіпкер? ＞
Dialogue: 0,0:20:37.86,0:20:41.61,Default,,0,0,0,,<Осы уақытқа дейін сіз жаңа туған лақтар сияқты едіңіз, солай ма? ＞
Dialogue: 0,0:20:42.78,0:20:43.57,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:43.70,0:20:45.78,Default,,0,0,0,,Бүгінгі стратегия Түсінесіз бе?
Dialogue: 0,0:20:45.95,0:20:47.12,Default,,0,0,0,,Әрине
Dialogue: 0,0:20:47.24,0:20:49.95,Default,,0,0,0,,Шигеру тікелей үйреткен «Өтірік айтпай қалай қашуға болады»
Dialogue: 0,0:20:50.08,0:20:52.08,Default,,0,0,0,,Мен оны жақсы түсіндім.
Dialogue: 0,0:20:52.20,0:20:53.83,Default,,0,0,0,,Нағыз жаман адам кім?
Dialogue: 0,0:20:53.96,0:20:57.13,Default,,0,0,0,,Олар сізді алдау үшін кішкентай өтіріктерді пайдаланады.
Dialogue: 0,0:20:57.29,0:20:59.04,Default,,0,0,0,,Өтірік айтудан сақ болыңыз
Dialogue: 0,0:20:59.17,0:21:00.13,Default,,0,0,0,,Түсінікті!
Dialogue: 0,0:21:00.63,0:21:03.84,Default,,0,0,0,,<Айтпақшы, жаман адамдарға жеке ақпаратты бермеу үшін>
Dialogue: 0,0:21:03.97,0:21:05.34,Default,,0,0,0,,<Мен де оған біраз даналық салдым>
Dialogue: 0,0:21:05.47,0:21:07.14,Default,,0,0,0,,А, сәлем, сәлем!
Dialogue: 0,0:21:07.30,0:21:08.72,Default,,0,0,0,,Сіз Шигеру-сансыз ба?
Dialogue: 0,0:21:08.85,0:21:10.31,Default,,0,0,0,,Өзіңіз айтпаңыз!
Dialogue: 0,0:21:10.64,0:21:13.64,Default,,0,0,0,,<Бұл Кажитаның қабілетін белсендіруден аулақ болу керек...>
Dialogue: 0,0:21:13.77,0:21:16.10,Default,,0,0,0,,О! сен
Dialogue: 0,0:21:16.23,0:21:18.40,Default,,0,0,0,,Барлық цуппа жас ханымдар!
Dialogue: 0,0:21:18.81,0:21:21.90,Default,,0,0,0,,Бүгін мен одан да керемет киім кидім!
Dialogue: 0,0:21:22.28,0:21:24.53,Default,,0,0,0,,Бұл көйлек маған ұнады.
Dialogue: 0,0:21:24.65,0:21:26.16,Default,,0,0,0,,Таудан түскеннен кейін, қолым түсіп кететіндей болғанша қылыш шабуды жаттықтырамын
Dialogue: 0,0:21:26.61,0:21:31.58,Default,,0,0,0,,Сонымен кешегі оқиға туралы не ойлайсың?
Dialogue: 0,0:21:31.74,0:21:34.46,Default,,0,0,0,,Егер мен өзіме сәйкес келетін ойынды ойнай алсам
Dialogue: 0,0:21:34.62,0:21:37.12,Default,,0,0,0,,Менің мүше болғаныма қарсы боласың ба?
Dialogue: 0,0:21:37.29,0:21:39.25,Default,,0,0,0,,Ең үлкен құрмет!
Dialogue: 0,0:21:39.38,0:21:41.13,Default,,0,0,0,,Біз сізге жол көрсетеміз
Dialogue: 0,0:21:41.42,0:21:42.63,Default,,0,0,0,,шіркін...
Dialogue: 0,0:21:42.76,0:21:44.67,Default,,0,0,0,,Күзетшілер, осында да келіңіздер.
Dialogue: 0,0:21:44.92,0:21:47.26,Default,,0,0,0,,<B... Не? ＞
Dialogue: 0,0:21:52.93,0:21:53.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:56.89,0:21:59.52,Default,,0,0,0,,Жарайды, мен келдім.
Dialogue: 0,0:21:59.65,0:22:00.44,Default,,0,0,0,,Хмм...
Dialogue: 0,0:22:01.86,0:22:04.69,Default,,0,0,0,,<Енді, сенің зұлым істерің>
Dialogue: 0,0:22:05.03,0:22:07.91,Default,,0,0,0,,<Саған дұрыс ғибадат еткенімді қалайсың ба?>
Dialogue: 0,0:22:10.28,0:22:13.24,Default,,0,0,0,,♪～
Dialogue: 0,0:23:35.66,0:23:38.62,Default,,0,0,0,,～♪
Dialogue: 0,0:23:40.12,0:23:46.12,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory