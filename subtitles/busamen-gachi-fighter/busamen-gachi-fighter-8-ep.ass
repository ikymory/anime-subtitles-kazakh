Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.21,0:00:04.21,Default,,0,0,0,,Тұтынушы, мен қиындыққа тап болдым.
Dialogue: 0,0:00:05.54,0:00:06.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:06.96,0:00:10.17,Default,,0,0,0,,<Бұл жігіт, тіпті есеп беруге келген бағыныштылары>
Dialogue: 0,0:00:10.42,0:00:15.47,Default,,0,0,0,,Қаруға қатаң тыйым салынады.
Dialogue: 0,0:00:15.59,0:00:16.68,Default,,0,0,0,,Ей! Польнареф!
Dialogue: 0,0:00:17.35,0:00:19.39,Default,,0,0,0,,Құбыжық шайқасы
Dialogue: 0,0:00:19.97,0:00:22.18,Default,,0,0,0,,Сіз өзіңіз кіргіңіз келе ме?
Dialogue: 0,0:00:22.56,0:00:26.94,Default,,0,0,0,,Егер қалағаныңыз болса, мен қиыншылықта емеспін.
Dialogue: 0,0:00:28.44,0:00:29.44,Default,,0,0,0,,Сонымен
Dialogue: 0,0:00:29.94,0:00:34.91,Default,,0,0,0,,Көру уақыты. Барамыз ба?
Dialogue: 0,0:00:35.66,0:00:38.62,Default,,0,0,0,,♪～
Dialogue: 0,0:01:59.45,0:02:02.41,Default,,0,0,0,,～♪
Dialogue: 0,0:02:09.04,0:02:12.42,Default,,0,0,0,,Шимизу: Бұл өте өкінішті.
Dialogue: 0,0:02:12.54,0:02:17.67,Default,,0,0,0,,Сіздің адалдығыңыз өтіріктен басқа ештеңе емес еді.
Dialogue: 0,0:02:18.22,0:02:21.35,Default,,0,0,0,,Бірақ мен сені кешіремін
Dialogue: 0,0:02:21.55,0:02:24.47,Default,,0,0,0,,Сізден алған емшілік қабілетім
Dialogue: 0,0:02:24.60,0:02:27.68,Default,,0,0,0,,Менің жараларымды емдеңіз
Dialogue: 0,0:02:28.19,0:02:31.94,Default,,0,0,0,,Ол сенің өміріңді ғана емес, қабілетіңді де тартып ала ма?
Dialogue: 0,0:02:32.31,0:02:34.23,Default,,0,0,0,,<Арнайы ескертулердің мазмұны>
Dialogue: 0,0:02:34.36,0:02:38.45,Default,,0,0,0,,<Оны тамырымен сорып, тозаққа жіберетін құдірет.>
Dialogue: 0,0:02:38.95,0:02:41.32,Default,,0,0,0,,Мен алдымен сол байды аламын.
Dialogue: 0,0:02:42.24,0:02:43.08,Default,,0,0,0,,Кажита!
Dialogue: 0,0:02:44.53,0:02:45.58,Default,,0,0,0,,Осы үш кадрды қайтадан қатар қойып көрсетіңізші.
Dialogue: 0,0:02:45.87,0:02:47.58,Default,,0,0,0,,Куфуфу (саусақтарды сермеу)
Dialogue: 0,0:02:48.16,0:02:49.50,Default,,0,0,0,,Жарықтандыру...
Dialogue: 0,0:02:49.62,0:02:51.33,Default,,0,0,0,,Мен ештеңе көрмеймін...
Dialogue: 0,0:02:52.13,0:02:53.34,Default,,0,0,0,,<Бұл жаман...>
Dialogue: 0,0:02:53.88,0:02:55.05,Default,,0,0,0,,Сақтығыңызды төмендетпеңіз!
Dialogue: 0,0:02:55.17,0:02:56.25,Default,,0,0,0,,Иә
Dialogue: 0,0:02:57.92,0:03:00.09,Default,,0,0,0,,<Жер асты аренасына қош келдіңіз>
Dialogue: 0,0:03:00.63,0:03:03.26,Default,,0,0,0,,<Осы жарықты да жұтатын тұңғиық тереңінде>
Dialogue: 0,0:03:03.39,0:03:06.39,Default,,0,0,0,,<Өлімге дейін қорқынышты шайқастан ләззат алыңыз>
Dialogue: 0,0:03:06.56,0:03:07.52,Default,,0,0,0,,<Кажита...>
Dialogue: 0,0:03:07.97,0:03:10.73,Default,,0,0,0,,<Өтінемін, мына қанішер құбыжықтар>
Dialogue: 0,0:03:10.85,0:03:13.27,Default,,0,0,0,,<Менімен көңілің қалағанша ойнашы>
Dialogue: 0,0:03:16.36,0:03:19.53,Default,,0,0,0,,(Аңның ырылдауы)
Dialogue: 0,0:03:20.99,0:03:23.07,Default,,0,0,0,,<Өмірдің соңына дейін>
Dialogue: 0,0:03:23.20,0:03:25.24,Default,,0,0,0,,(Шайтанның айқайы)
Dialogue: 0,0:03:25.37,0:03:26.54,Default,,0,0,0,,Әй!
Dialogue: 0,0:03:30.04,0:03:31.29,Default,,0,0,0,,Иә! (Сейджи) Ібіліс қыз!
Dialogue: 0,0:03:35.13,0:03:37.67,Default,,0,0,0,,<Мен жалынды кесіп тастадым! Бұлай жасамаңыз＞
Dialogue: 0,0:03:37.96,0:03:39.80,Default,,0,0,0,,Шабуылдардың орнын толтыру...
Dialogue: 0,0:03:39.92,0:03:41.68,Default,,0,0,0,,Ібіліс қыз, бұл керемет!
Dialogue: 0,0:03:41.80,0:03:42.93,Default,,0,0,0,,Сақтығыңызды төмендетпеңіз!
Dialogue: 0,0:03:43.05,0:03:44.72,Default,,0,0,0,,Келесісі келеді!
Dialogue: 0,0:03:49.73,0:03:52.94,Default,,0,0,0,,Оның деңгейі – 80, қасиеті – қараңғылық!
Dialogue: 0,0:03:53.60,0:03:56.36,Default,,0,0,0,,Жарық атрибуты болса, оған қарсы тұра білу керек!
Dialogue: 0,0:03:56.57,0:03:57.94,Default,,0,0,0,,<Жарық атрибуты...>
Dialogue: 0,0:03:58.19,0:03:59.73,Default,,0,0,0,,<Мырза. Сейджи>
Dialogue: 0,0:04:00.61,0:04:02.65,Default,,0,0,0,,Мен Элькарон мырзаны сұраймын!
Dialogue: 0,0:04:08.41,0:04:09.37,Default,,0,0,0,,Әй!
Dialogue: 0,0:04:17.50,0:04:18.46,Default,,0,0,0,,Ахх!
Dialogue: 0,0:04:21.59,0:04:23.97,Default,,0,0,0,,Ха! Эль Калоне мырза!
Dialogue: 0,0:04:24.38,0:04:25.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:25.43,0:04:26.80,Default,,0,0,0,,Міне! (Сэйджи) Ах!
Dialogue: 0,0:04:28.35,0:04:30.72,Default,,0,0,0,,Үлкен жігіттермен төбелескенде, қозғалып жүр.
Dialogue: 0,0:04:30.85,0:04:33.48,Default,,0,0,0,,Себебі мен араласудан қорқамын! (Сейка) Иә!
Dialogue: 0,0:04:39.86,0:04:41.19,Default,,0,0,0,,Иә! Ха!
Dialogue: 0,0:04:49.91,0:04:51.45,Default,,0,0,0,,Жарқыраған Аврора
Dialogue: 0,0:04:51.70,0:04:53.46,Default,,0,0,0,,Демалу!
Dialogue: 0,0:04:53.62,0:04:56.25,Default,,0,0,0,,Керемет бір соққы!
Dialogue: 0,0:04:56.50,0:04:58.38,Default,,0,0,0,,<Деңгей айырмашылығына мән бермеу>
Dialogue: 0,0:04:58.50,0:05:01.46,Default,,0,0,0,,<Күтілгендей, ол зұлым қарсыластарға өте күшті>
Dialogue: 0,0:05:03.26,0:05:04.09,Default,,0,0,0,,Гуах
Dialogue: 0,0:05:04.22,0:05:05.97,Default,,0,0,0,,<Не!?>
Dialogue: 0,0:05:06.09,0:05:09.55,Default,,0,0,0,,Уф... ессіз...
Dialogue: 0,0:05:12.52,0:05:16.02,Default,,0,0,0,,<Сіз сирек кездесетін ойын сыйлығының ең үздік ойыншысысыз...>
Dialogue: 0,0:05:16.27,0:05:18.65,Default,,0,0,0,,Ууууууууу...
Dialogue: 0,0:05:19.77,0:05:20.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:20.90,0:05:22.32,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:05:22.48,0:05:23.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:24.57,0:05:25.49,Default,,0,0,0,,(Ватару) Не болып жатыр? Бұл әңгіме… (Ер оқушы) Ол ұялы телефонымен дауласып жатыр.
Dialogue: 0,0:05:25.65,0:05:27.66,Default,,0,0,0,,Рахмет, Элькарон мырза.
Dialogue: 0,0:05:27.82,0:05:28.95,Default,,0,0,0,,Мен толық қалпына келдім.
Dialogue: 0,0:05:29.07,0:05:32.41,Default,,0,0,0,,Алдин Бай қонақтарды көшірді.
Dialogue: 0,0:05:32.54,0:05:34.50,Default,,0,0,0,,Өмірге қауіп бар ма?
Dialogue: 0,0:05:35.04,0:05:37.54,Default,,0,0,0,,Сіздің деңгейіңіз көтерілді, солай емес пе?
Dialogue: 0,0:05:37.71,0:05:40.46,Default,,0,0,0,,Сол қағаз сияқты қорғанысыңызды арттырыңыз.
Dialogue: 0,0:05:40.59,0:05:42.63,Default,,0,0,0,,Не? Ах...
Dialogue: 0,0:05:43.59,0:05:48.30,Default,,0,0,0,,Ібіліс бала, басқа адамның жағдайын айта аласыз ба?
Dialogue: 0,0:05:48.43,0:05:49.55,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:05:50.35,0:05:51.30,Default,,0,0,0,,Осы балаға не болған екен…
Dialogue: 0,0:05:51.47,0:05:53.97,Default,,0,0,0,,(Сиқырлы аңдардың айқайы)
Dialogue: 0,0:05:54.27,0:05:56.94,Default,,0,0,0,,<Тұтынушы шынымен күшті>
Dialogue: 0,0:05:57.56,0:06:02.19,Default,,0,0,0,,<80-деңгейдегі құбыжық болу сәл скучно болды ма? ＞
Dialogue: 0,0:06:02.73,0:06:06.15,Default,,0,0,0,,<Бізде әлі де сиқырлы аңдар жеткілікті>
Dialogue: 0,0:06:06.44,0:06:09.70,Default,,0,0,0,,<Өлімге әкелетін шайқастардан ләззат алыңыз>
Dialogue: 0,0:06:21.42,0:06:23.71,Default,,0,0,0,,200-деңгей! Сергек болыңыз!
Dialogue: 0,0:06:23.88,0:06:25.59,Default,,0,0,0,,Шигеру-сан! Кажита!
Dialogue: 0,0:06:25.71,0:06:27.09,Default,,0,0,0,,Артқы жағында болуы керек!
Dialogue: 0,0:06:27.47,0:06:28.68,Default,,0,0,0,,Түсінікті!
Dialogue: 0,0:06:28.93,0:06:30.84,Default,,0,0,0,,<және бұрын>
Dialogue: 0,0:06:32.05,0:06:34.14,Default,,0,0,0,,(Сиқырлы аңдардың айқайы)
Dialogue: 0,0:06:34.39,0:06:35.56,Default,,0,0,0,,<Баяу уақыт>
Dialogue: 0,0:06:36.27,0:06:38.98,Default,,0,0,0,,<Жын-шайтандарға арналған шағын сыйлық>
Dialogue: 0,0:06:39.10,0:06:42.56,Default,,0,0,0,,<Мен сенен құбыжықты жоюды өтіндім. Мен бастыққа қамқор боламын>
Dialogue: 0,0:06:42.69,0:06:43.52,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:06:43.65,0:06:44.77,Default,,0,0,0,,Иә! (Қорғасын) О!
Dialogue: 0,0:06:56.75,0:07:00.25,Default,,0,0,0,,<Әрі қарай аң торының ішінде>
Dialogue: 0,0:07:00.58,0:07:04.25,Default,,0,0,0,,<Аа, түсіндім, Кажита мырза>
Dialogue: 0,0:07:04.88,0:07:09.67,Default,,0,0,0,,<Сіз шынымен ешкімге сене алмайсыз>
Dialogue: 0,0:07:10.84,0:07:13.93,Default,,0,0,0,,Хаха хахахаха!
Dialogue: 0,0:07:14.05,0:07:16.26,Default,,0,0,0,,Олар тағы бір қылмыс жасады!
Dialogue: 0,0:07:16.72,0:07:19.31,Default,,0,0,0,,Өлтір, өлтір, көп өлтір!
Dialogue: 0,0:07:19.43,0:07:21.27,Default,,0,0,0,,Осы жолы соңына дейін шайқасамын!
Dialogue: 0,0:07:21.44,0:07:25.61,Default,,0,0,0,,Өлтір, өлтір, өлтір! Артқа жол болмайынша!
Dialogue: 0,0:07:25.77,0:07:27.78,Default,,0,0,0,,Хахахахахаха! (қосқышты басқан дыбыс)
Dialogue: 0,0:07:27.94,0:07:29.24,Default,,0,0,0,,<Ах! ＞
Dialogue: 0,0:07:29.36,0:07:32.24,Default,,0,0,0,,Мен мұндай қиын топты бірінші рет кездестіруім.
Dialogue: 0,0:07:32.36,0:07:34.41,Default,,0,0,0,,Куфуфуфу Жарайды.
Dialogue: 0,0:07:34.53,0:07:38.24,Default,,0,0,0,,Өлтір, өлтір, өлтір, егер бәрін өлтірсең...
Dialogue: 0,0:07:39.00,0:07:42.00,Default,,0,0,0,,Соңында мен сені босатамын.
Dialogue: 0,0:07:42.12,0:07:42.92,Default,,0,0,0,,Эй
Dialogue: 0,0:07:45.50,0:07:47.13,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:07:47.96,0:07:48.80,Default,,0,0,0,,Хмф!
Dialogue: 0,0:07:52.26,0:07:54.80,Default,,0,0,0,,Әй, ау.
Dialogue: 0,0:07:54.93,0:07:57.22,Default,,0,0,0,,Сіз оққағарсыз ба?
Dialogue: 0,0:07:57.35,0:08:00.14,Default,,0,0,0,,Сен сахнаның артында не істеп жүрсің?
Dialogue: 0,0:08:00.27,0:08:03.52,Default,,0,0,0,,Мен жай ғана сенімен сөйлескім келді.
Dialogue: 0,0:08:03.65,0:08:05.06,Default,,0,0,0,,Қалай болғанда да...
Dialogue: 0,0:08:05.44,0:08:07.07,Default,,0,0,0,,Бұл жерде таңқаларлық
Dialogue: 0,0:08:07.19,0:08:10.40,Default,,0,0,0,,Бұл керемет жер, бірақ мұнда құбыжық бар...
Dialogue: 0,0:08:12.90,0:08:14.49,Default,,0,0,0,,Сонымен? Қалаған ауылыңды тамашалай алдың ба?
Dialogue: 0,0:08:14.61,0:08:19.04,Default,,0,0,0,,Дегенмен, бұл коммерциялық құпия, сондықтан бөлмеден дереу шығып кетіңіз.
Dialogue: 0,0:08:21.33,0:08:23.71,Default,,0,0,0,,Бұлай жұмыс істемейді.
Dialogue: 0,0:08:24.00,0:08:28.25,Default,,0,0,0,,Кажита мырза, мен кісі өлтіру казиносының бүкіл тарихын көрдім.
Dialogue: 0,0:08:28.38,0:08:31.09,Default,,0,0,0,,Сонымен не керек?
Dialogue: 0,0:08:31.51,0:08:34.97,Default,,0,0,0,,Байларды соншалықты жек көресің бе?
Dialogue: 0,0:08:36.64,0:08:41.14,Default,,0,0,0,,Адамдар мейірімділікті біле алады, өйткені олар кедей.
Dialogue: 0,0:08:41.27,0:08:43.48,Default,,0,0,0,,Менің ата-анам сондай болған.
Dialogue: 0,0:08:44.14,0:08:46.31,Default,,0,0,0,,Бірақ байлар басқаша.
Dialogue: 0,0:08:46.44,0:08:48.44,Default,,0,0,0,,Байлар өтірік айтады
Dialogue: 0,0:08:48.57,0:08:51.86,Default,,0,0,0,,Жазықсыз адамдарға зиян келтіру арқылы ақша ұрлауға әрекеттену
Dialogue: 0,0:08:51.99,0:08:54.57,Default,,0,0,0,,Байығандардың дастаны осы!
Dialogue: 0,0:08:54.70,0:08:57.12,Default,,0,0,0,,Адамдар ақшасы бар болғандықтан бақытсыз болады!
Dialogue: 0,0:08:57.78,0:08:59.74,Default,,0,0,0,,Өте аянышты!
Dialogue: 0,0:08:59.87,0:09:01.75,Default,,0,0,0,,Қандай өкінішті!
Dialogue: 0,0:09:01.87,0:09:06.75,Default,,0,0,0,,Міне, мен, кіршіксіз жан бар, оны тазартуым керек!
Dialogue: 0,0:09:07.58,0:09:10.71,Default,,0,0,0,,Мен оларды басқарамын...
Dialogue: 0,0:09:10.84,0:09:12.26,Default,,0,0,0,,Осы екеуінің қайсысы екенін сұрап тұрмын. Сен бе?
Dialogue: 0,0:09:12.88,0:09:15.88,Default,,0,0,0,,Сіз жойылу жолындасыз.
Dialogue: 0,0:09:16.05,0:09:18.47,Default,,0,0,0,,Сіз қазір берілуге ​​дайынсыз ба?
Dialogue: 0,0:09:18.76,0:09:22.93,Default,,0,0,0,,Қираған ба? тапсыру? Бұл мүмкін емес.
Dialogue: 0,0:09:23.06,0:09:25.81,Default,,0,0,0,,Менің деңгейім 521
Dialogue: 0,0:09:25.94,0:09:29.90,Default,,0,0,0,,Миллиондық әскер де бір тырнақтай алмайды.
Dialogue: 0,0:09:30.23,0:09:34.36,Default,,0,0,0,,Шындығында, сіз де өзіңізге көмектесе алмайсыз.
Dialogue: 0,0:09:34.49,0:09:37.61,Default,,0,0,0,,А, сен мықты болуың керек.
Dialogue: 0,0:09:37.86,0:09:41.12,Default,,0,0,0,,Сондықтан сіз өз мақсатыңыз үшін біреуді басқара аласыз.
Dialogue: 0,0:09:41.24,0:09:44.54,Default,,0,0,0,,Таза адамдар да тапталады.
Dialogue: 0,0:09:44.75,0:09:45.66,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:09:46.21,0:09:47.50,Default,,0,0,0,,Бұл дегеніміз…
Dialogue: 0,0:09:47.67,0:09:50.79,Default,,0,0,0,,Сіз жек көретін адамдардан қандай айырмашылық бар?
Dialogue: 0,0:09:54.55,0:09:56.42,Default,,0,0,0,,Шошқа...
Dialogue: 0,0:09:56.55,0:09:59.30,Default,,0,0,0,,Сіз басқалардың сөзін айтасыз!
Dialogue: 0,0:09:59.59,0:10:00.76,Default,,0,0,0,,Гаха
Dialogue: 0,0:10:02.26,0:10:03.77,Default,,0,0,0,,Гах...
Dialogue: 0,0:10:06.14,0:10:08.85,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:10:11.11,0:10:12.19,Default,,0,0,0,,Е...
Dialogue: 0,0:10:13.15,0:10:15.28,Default,,0,0,0,,Маған қан беріңіз...
Dialogue: 0,0:10:15.40,0:10:16.90,Default,,0,0,0,,Шошқа емес
Dialogue: 0,0:10:18.40,0:10:19.91,Default,,0,0,0,,Бұл салмақты күрескер
Dialogue: 0,0:10:20.99,0:10:23.91,Default,,0,0,0,,Шынымен... жауынгер
Dialogue: 0,0:10:25.41,0:10:28.21,Default,,0,0,0,,Не болып жатыр өзі…? ➡
Dialogue: 0,0:10:30.54,0:10:32.96,Default,,0,0,0,,Бұл сиқырлы аң соңғысы
Dialogue: 0,0:10:33.21,0:10:36.76,Default,,0,0,0,,Деңгей мен мәртебе ақылсыз, сондықтан көңіліңізді түсірмеңіз!
Dialogue: 0,0:10:36.88,0:10:38.22,Default,,0,0,0,,Түсінікті!
Dialogue: 0,0:10:38.55,0:10:41.43,Default,,0,0,0,,Біз міндетті түрде жеңе аламыз.
Dialogue: 0,0:10:41.55,0:10:44.97,Default,,0,0,0,,Жеңіп, Шигеру-санмен қосылыңыз!
Dialogue: 0,0:10:48.39,0:10:50.27,Default,,0,0,0,,Тағы бір рет тыңдаңыз
Dialogue: 0,0:10:50.52,0:10:52.19,Default,,0,0,0,,Сіз берілуге ​​дайынсыз ба?
Dialogue: 0,0:10:53.86,0:10:54.98,Default,,0,0,0,,Шошқа
Dialogue: 0,0:10:55.28,0:10:57.65,Default,,0,0,0,,Келіссөздер үзілді.
Dialogue: 0,0:10:57.78,0:10:59.99,Default,,0,0,0,,Осыны аяқтайық, Каджита-сан.
Dialogue: 0,0:11:00.20,0:11:01.57,Default,,0,0,0,,Жарайды, операцияны басынан бастауға тура келеді.
Dialogue: 0,0:11:05.99,0:11:07.95,Default,,0,0,0,,Аяқтауға әлі ерте
Dialogue: 0,0:11:08.08,0:11:09.54,Default,,0,0,0,,Осы екеуінің қайсысы екенін сұрап тұрмын. Сен бе?
Dialogue: 0,0:11:09.75,0:11:11.92,Default,,0,0,0,,Шошқаға келгенде ұят.
Dialogue: 0,0:11:12.04,0:11:16.13,Default,,0,0,0,,Мен сені барлық нәрсені басқаратын Құдайдың бейнесіне табынуға мәжбүр етемін.
Dialogue: 0,0:11:16.25,0:11:17.21,Default,,0,0,0,,Құдай?
Dialogue: 0,0:11:20.01,0:11:23.14,Default,,0,0,0,,Күйдің қалай таратылғанын білмеймін.
Dialogue: 0,0:11:23.34,0:11:27.22,Default,,0,0,0,,Сіз тек жауынгерлік қабілетіңіз бойынша менен асып түсесіз.
Dialogue: 0,0:11:27.77,0:11:31.19,Default,,0,0,0,,Бірақ сиқыр туралы не деуге болады?
Dialogue: 0,0:11:32.19,0:11:34.31,Default,,0,0,0,,Хэхехехе...
Dialogue: 0,0:11:34.44,0:11:36.32,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,0:11:36.44,0:11:39.36,Default,,0,0,0,,Хахахаха! (Төрт қасиетті аңның зары)
Dialogue: 0,0:11:39.82,0:11:43.16,Default,,0,0,0,,Бұл жігіттің деңгейі мен параметрлері төрт тоғыз
Dialogue: 0,0:11:43.32,0:11:45.62,Default,,0,0,0,,9999
Dialogue: 0,0:11:45.87,0:11:49.16,Default,,0,0,0,,Қайталанатын монстр синтезінен кейін жасалған
Dialogue: 0,0:11:49.29,0:11:52.62,Default,,0,0,0,,Бұл құдайлық дерлік шедевр!
Dialogue: 0,0:11:53.37,0:11:55.63,Default,,0,0,0,,<Құдай... дұрыс>
Dialogue: 0,0:11:55.88,0:11:59.13,Default,,0,0,0,,<Демек, Каджита мырза бұл жігітке дұға еткен бе?>
Dialogue: 0,0:11:59.46,0:12:02.51,Default,,0,0,0,,Нағыз күрескер болды ма?
Dialogue: 0,0:12:02.63,0:12:06.39,Default,,0,0,0,,Сіз статистикаңызда нөлдер көп екенін айттыңыз.
Dialogue: 0,0:12:06.51,0:12:11.52,Default,,0,0,0,,Неліктен олар өздерінің сиқырлы күшін құрбан етіп, физикаға құйып жіберді?
Dialogue: 0,0:12:11.64,0:12:14.77,Default,,0,0,0,,Басқаша айтқанда, сиқырдан мүлдем қорғансыз.
Dialogue: 0,0:12:14.90,0:12:20.78,Default,,0,0,0,,Егер сіз осындай күйде сиқырдың ең жоғары деңгейіне ұшырасаңыз не болар еді?
Dialogue: 0,0:12:21.28,0:12:24.24,Default,,0,0,0,,«Құдайлардың найзағайы»!
Dialogue: 0,0:12:29.41,0:12:32.54,Default,,0,0,0,,Фухахахахахахаха!
Dialogue: 0,0:12:33.37,0:12:35.79,Default,,0,0,0,,«Солтүстік кресттік боран»
Dialogue: 0,0:12:39.21,0:12:41.38,Default,,0,0,0,,Не...
Dialogue: 0,0:12:46.05,0:12:47.35,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:12:54.73,0:12:58.19,Default,,0,0,0,,Ал, сиқырлы...?
Dialogue: 0,0:12:58.94,0:13:00.11,Default,,0,0,0,,(Ватару) Не болып жатыр? Бұл әңгіме… (Ер оқушы) Ол ұялы телефонымен дауласып жатыр.
Dialogue: 0,0:13:00.32,0:13:03.32,Default,,0,0,0,,Каджита мырза, мен сізге бір нәрсе айтайын.
Dialogue: 0,0:13:03.49,0:13:07.82,Default,,0,0,0,,«Құдайлардың найзағайы» ең жоғары деңгейден бір деңгейге төмен.
Dialogue: 0,0:13:08.32,0:13:10.28,Default,,0,0,0,,Нағыз керемет сиқыр
Dialogue: 0,0:13:10.41,0:13:13.79,Default,,0,0,0,,«Northern Cross Blizzard» мұның орнын толтырады.
Dialogue: 0,0:13:14.08,0:13:16.58,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:13:16.71,0:13:21.09,Default,,0,0,0,,Сіз байыпты күрескерсіз... Сіз сиқырды қолдана білуіңіз керек...
Dialogue: 0,0:13:21.25,0:13:24.09,Default,,0,0,0,,Сіз өтірік арқылы көре аласыз деп естідім.
Dialogue: 0,0:13:24.42,0:13:28.59,Default,,0,0,0,,Өтірікті қолданбай шындықты жасыруға болады.
Dialogue: 0,0:13:28.76,0:13:30.30,Default,,0,0,0,,Бұл сіздің қалай айтқаныңызға байланысты.
Dialogue: 0,0:13:30.43,0:13:31.35,Default,,0,0,0,,Не?
Dialogue: 0,0:13:31.89,0:13:35.77,Default,,0,0,0,,Абсолютті Құдай... Бұл менің нағыз жұмысым.
Dialogue: 0,0:13:37.94,0:13:40.06,Default,,0,0,0,,Хмм... уф
Dialogue: 0,0:13:40.57,0:13:43.86,Default,,0,0,0,,Өтірік айтпа... Өтірік айтпа
Dialogue: 0,0:13:44.19,0:13:47.66,Default,,0,0,0,,Барлық күйлер 1 триллион және 5
Dialogue: 0,0:13:47.82,0:13:50.16,Default,,0,0,0,,Сондықтан нөлдер көп
Dialogue: 0,0:13:50.78,0:13:55.08,Default,,0,0,0,,Абсолюттік Құдай? Бұл шошқа...
Dialogue: 0,0:13:55.25,0:13:57.96,Default,,0,0,0,,<Әрине, нағыз күрескер екенім өтірік емес>
Dialogue: 0,0:13:58.62,0:14:01.96,Default,,0,0,0,,<Бұл менің көшбасшым берген лауазым>
Dialogue: 0,0:14:02.30,0:14:06.59,Default,,0,0,0,,Немесе лауазымның атауы? Сен алдамшы!
Dialogue: 0,0:14:06.72,0:14:09.18,Default,,0,0,0,,Сіз өзіңіздің негізгі жұмысыңыз бен лауазымыңызды қалай ажыратасыз?
Dialogue: 0,0:14:09.30,0:14:11.64,Default,,0,0,0,,Бұл сатушылар әлемінде қалыпты жағдай.
Dialogue: 0,0:14:11.76,0:14:14.35,Default,,0,0,0,,Тыныш, үндеме, үндеме!
Dialogue: 0,0:14:14.52,0:14:17.44,Default,,0,0,0,,Тәңірге құлшылық етеді сен сияқты төмен шошқа!
Dialogue: 0,0:14:17.56,0:14:21.15,Default,,0,0,0,,Алланың атын жамандауға болмайды!
Dialogue: 0,0:14:21.31,0:14:23.15,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:14:23.57,0:14:26.90,Default,,0,0,0,,Өліммен төле
Dialogue: 0,0:14:27.07,0:14:30.70,Default,,0,0,0,,Ооо! <Маған енді ешқандай сөз жетпейді>
Dialogue: 0,0:14:30.91,0:14:33.28,Default,,0,0,0,,<Сосын, тым болмаса бір қылышпен...>
Dialogue: 0,0:14:37.12,0:14:38.37,Default,,0,0,0,,Уф
Dialogue: 0,0:14:38.79,0:14:41.08,Default,,0,0,0,,Гухаааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:14:41.42,0:14:43.59,Default,,0,0,0,,және осы адаммен шайқасуға рұқсат етті—
Dialogue: 0,0:14:43.71,0:14:46.55,Default,,0,0,0,,Орднунг найзасы…
Dialogue: 0,0:14:46.67,0:14:48.38,Default,,0,0,0,,Каджита Кун
Dialogue: 0,0:14:48.51,0:14:49.30,Default,,0,0,0,,Әй!
Dialogue: 0,0:14:49.76,0:14:51.22,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:14:51.34,0:14:53.89,Default,,0,0,0,,Бізді жөнелтуге дейін бармаңыз.
Dialogue: 0,0:14:54.60,0:14:58.89,Default,,0,0,0,,Құбыжықтарды синтездей алатын құнды адам.
Dialogue: 0,0:15:00.69,0:15:03.77,Default,,0,0,0,,Егер мен үлкен көзді құбыжық жасасам (Кажита ыңырсып)
Dialogue: 0,0:15:03.90,0:15:05.82,Default,,0,0,0,,Сонда ол енді қолданылмайды ма?
Dialogue: 0,0:15:06.40,0:15:10.45,Default,,0,0,0,,Сол себепті сіз монстр синтезі дағдысын алып тастадыңыз ба?
Dialogue: 0,0:15:11.07,0:15:12.82,Default,,0,0,0,,<Солай ма...>
Dialogue: 0,0:15:13.37,0:15:15.66,Default,,0,0,0,,<Жын-шайтанның синтезін жіберу>
Dialogue: 0,0:15:15.79,0:15:19.29,Default,,0,0,0,,<Көз алмасының құбыжығын жасағаннан кейін, Кажита мырза...>
Dialogue: 0,0:15:19.54,0:15:22.96,Default,,0,0,0,,Хмм, сенің мықты екеніңді білемін, бірақ
Dialogue: 0,0:15:23.08,0:15:25.55,Default,,0,0,0,,Сіз аздап көңіліңіз көтеріліп қалды.
Dialogue: 0,0:15:25.80,0:15:28.88,Default,,0,0,0,,Мен сен үшін...
Dialogue: 0,0:15:29.17,0:15:32.30,Default,,0,0,0,,Құдай, киелі төрт жануар...
Dialogue: 0,0:15:32.47,0:15:38.10,Default,,0,0,0,,Себебі сіз жаңа құдаймен танысқыңыз келетінін айттыңыз...
Dialogue: 0,0:15:38.22,0:15:40.60,Default,,0,0,0,,Хмм, солай ма?
Dialogue: 0,0:15:40.94,0:15:43.73,Default,,0,0,0,,Аа, сізге байланысты...
Dialogue: 0,0:15:44.11,0:15:46.27,Default,,0,0,0,,Сіз өтірік айтасыз ба?
Dialogue: 0,0:15:46.40,0:15:47.86,Default,,0,0,0,,Басқасы...
Dialogue: 0,0:15:48.11,0:15:50.53,Default,,0,0,0,,Сен, абсолютті Құдай...
Dialogue: 0,0:15:50.74,0:15:51.86,Default,,0,0,0,,<Абсолютті Құдай!?>
Dialogue: 0,0:15:52.16,0:15:53.32,Default,,0,0,0,,<Менен басқа? ＞
Dialogue: 0,0:15:53.45,0:15:57.54,Default,,0,0,0,,Аха! Мен өтірік айтқым келген жоқ!
Dialogue: 0,0:15:57.83,0:15:58.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:59.20,0:16:02.87,Default,,0,0,0,,Сәлем? Кажита мырза?
Dialogue: 0,0:16:03.00,0:16:05.67,Default,,0,0,0,,Не, бұзылды ма? Хмм...
Dialogue: 0,0:16:06.17,0:16:08.13,Default,,0,0,0,,Ей, бұдан жақсырақ.
Dialogue: 0,0:16:08.75,0:16:10.80,Default,,0,0,0,,Әңгімелесейік!
Dialogue: 0,0:16:11.09,0:16:14.76,Default,,0,0,0,,Сіз де абсолютті құдайсыз ба? Олар сәйкес келеді!
Dialogue: 0,0:16:15.43,0:16:17.18,Default,,0,0,0,,Жақын келме!
Dialogue: 0,0:16:17.31,0:16:20.89,Default,,0,0,0,,Е~ Мен бас тарттым~ Ауырды~
Dialogue: 0,0:16:21.02,0:16:21.98,Default,,0,0,0,,<Бұл жігіт...>
Dialogue: 0,0:16:22.10,0:16:24.77,Default,,0,0,0,,Ах! Сіз ұялшақ шығарсыз?
Dialogue: 0,0:16:25.19,0:16:28.40,Default,,0,0,0,,Сізді байқай алмағаным үшін кешіріңіз.
Dialogue: 0,0:16:28.52,0:16:32.03,Default,,0,0,0,,Бірақ мен сөйлесуге өте оңай адаммын.
Dialogue: 0,0:16:32.15,0:16:33.49,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:16:33.61,0:16:36.03,Default,,0,0,0,,<Менен әлдеқайда күшті! ＞
Dialogue: 0,0:16:36.53,0:16:40.33,Default,,0,0,0,,<Мүлдем күтпеген және менің табиғи жауым болған әйел...>
Dialogue: 0,0:16:40.45,0:16:42.04,Default,,0,0,0,,<Егер сен тигізсең, бұл қауіпті>
Dialogue: 0,0:16:42.25,0:16:46.17,Default,,0,0,0,,Каджита мырза неге... дос емес?
Dialogue: 0,0:16:46.29,0:16:50.42,Default,,0,0,0,,Аха! Бұл мені таң қалдырды
Dialogue: 0,0:16:51.38,0:16:53.47,Default,,0,0,0,,Бірдей ұйым...
Dialogue: 0,0:16:53.59,0:16:56.18,Default,,0,0,0,,Ол Ordnung Spear мүшесі.
Dialogue: 0,0:16:56.30,0:16:57.68,Default,,0,0,0,,Ұйымдастыру?
Dialogue: 0,0:16:57.85,0:17:02.10,Default,,0,0,0,,Орднунг - бұл найзаның аты...
Dialogue: 0,0:17:02.23,0:17:03.02,Default,,0,0,0,,Уфу (саусақтарды сермеу)
Dialogue: 0,0:17:05.65,0:17:08.36,Default,,0,0,0,,Ол найза жай ғана белгі
Dialogue: 0,0:17:08.48,0:17:11.69,Default,,0,0,0,,Өйткені адамдар көрінетін пішіндерді қалайды.
Dialogue: 0,0:17:11.82,0:17:14.90,Default,,0,0,0,,Хмм... жарайды, мен айтайын.
Dialogue: 0,0:17:15.03,0:17:16.53,Default,,0,0,0,,Орднунг найзасы...
Dialogue: 0,0:17:16.99,0:17:20.79,Default,,0,0,0,,Бұл қарапайым адамдар бола алмаған реинкарнацияланған адамдардың альянсы.
Dialogue: 0,0:17:20.95,0:17:23.08,Default,,0,0,0,,Сіз қарапайым адам бола алмайсыз ...
Dialogue: 0,0:17:23.20,0:17:25.71,Default,,0,0,0,,Бұл олардың Катаги емес екенін білдіре ме?
Dialogue: 0,0:17:25.83,0:17:27.67,Default,,0,0,0,,Өйткені бұл өте жақсы!
Dialogue: 0,0:17:27.92,0:17:32.13,Default,,0,0,0,,<Басқа әлемде болса да, сіз тым араласып, іздеуші адамға айналасыз>
Dialogue: 0,0:17:32.59,0:17:36.38,Default,,0,0,0,,<Мәртебе мен қабілеттердің теңгерілмегені сонша, барар жер жоқ>
Dialogue: 0,0:17:36.84,0:17:39.43,Default,,0,0,0,,<Егер мұндай адамдар өз қалауынша әрекет етсе>
Dialogue: 0,0:17:39.55,0:17:42.39,Default,,0,0,0,,<Бұл дүние бейберекет болады, солай ма? ＞
Dialogue: 0,0:17:42.97,0:17:46.27,Default,,0,0,0,,<Сондықтан сәйкес келмейтіндерді жинауға батылдық жасаңыз>
Dialogue: 0,0:17:46.39,0:17:49.90,Default,,0,0,0,,<Тәртіп пен тепе-теңдікті сақтау үшін ұйым құрылды.>
Dialogue: 0,0:17:50.02,0:17:52.40,Default,,0,0,0,,<Осы дүниенің астыртын билеушісі сияқты ма? ＞
Dialogue: 0,0:17:52.86,0:17:55.11,Default,,0,0,0,,Аха, ойын сияқты емес пе?
Dialogue: 0,0:17:55.28,0:17:57.78,Default,,0,0,0,,Сіз бұл ұйымды құрдыңыз ба?
Dialogue: 0,0:17:57.91,0:17:59.95,Default,,0,0,0,,Хехе, болмайды!
Dialogue: 0,0:18:00.07,0:18:03.62,Default,,0,0,0,,Ordnung Spear ақсақ ат бола алмайды!
Dialogue: 0,0:18:03.74,0:18:05.96,Default,,0,0,0,,Ахахха! <Салқындату...>
Dialogue: 0,0:18:06.08,0:18:09.92,Default,,0,0,0,,Мен жалығып кеттім, сондықтан мен кішкене көмек беремін.
Dialogue: 0,0:18:10.54,0:18:13.88,Default,,0,0,0,,Жақын жерде кеңесші немесе оққағар бар ма?
Dialogue: 0,0:18:14.05,0:18:18.47,Default,,0,0,0,,Олар Каджита-кун сияқты шектен шығып кеткен балаларды жоюға келеді.
Dialogue: 0,0:18:19.76,0:18:21.68,Default,,0,0,0,,Эй
Dialogue: 0,0:18:22.64,0:18:25.06,Default,,0,0,0,,Сіз де біздің ұйымға қосыла аласыз.
Dialogue: 0,0:18:25.98,0:18:26.98,Default,,0,0,0,,Не?
Dialogue: 0,0:18:27.73,0:18:29.60,Default,,0,0,0,,Сізге де солай емес пе?
Dialogue: 0,0:18:29.77,0:18:34.32,Default,,0,0,0,,Бұл көрініс үшін сіз шынымен оны ең төменгі мәнге түсірдіңіз бе?
Dialogue: 0,0:18:34.44,0:18:37.36,Default,,0,0,0,,Мен мұны істей алмадым.
Dialogue: 0,0:18:37.49,0:18:41.49,Default,,0,0,0,,<Бұл жігіт күй жүйесі арқылы көрді ме?>
Dialogue: 0,0:18:41.62,0:18:45.33,Default,,0,0,0,,Бұл тек сыртқы көріністе емес, солай ма?
Dialogue: 0,0:18:45.70,0:18:48.37,Default,,0,0,0,,Абсолюттік құдай болу үшін қандай бонус жеткілікті?
Dialogue: 0,0:18:48.50,0:18:50.71,Default,,0,0,0,,Сіз нені құрбан еттіңіз?
Dialogue: 0,0:18:50.83,0:18:53.04,Default,,0,0,0,,<Арнайы ескертпелер...>
Dialogue: 0,0:18:53.42,0:18:56.13,Default,,0,0,0,,Дәлірек айтқанда, бұл жалғыз нұсқа.
Dialogue: 0,0:18:56.26,0:18:58.72,Default,,0,0,0,,Үш ұлы тілектің...
Dialogue: 0,0:18:59.13,0:19:00.72,Default,,0,0,0,,Бұл жыныстық құмарлық па?
Dialogue: 0,0:19:00.93,0:19:02.01,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:02.26,0:19:03.01,Default,,0,0,0,,Ол «Fool» картасының белгісін арқалаған Стэнді қолданушы
Dialogue: 0,0:19:03.47,0:19:07.60,Default,,0,0,0,,Мен өзімді кез келген уақытта сеппуку жасай алатындай таза самурай сияқты сезінемін!
Dialogue: 0,0:19:07.85,0:19:11.27,Default,,0,0,0,,Мен сені Усамен Самурай Баласы деп атаймын!
Dialogue: 0,0:19:11.40,0:19:13.02,Default,,0,0,0,,Мен Шигерумын!
Dialogue: 0,0:19:13.27,0:19:15.65,Default,,0,0,0,,Мені жат есімдермен атама!
Dialogue: 0,0:19:15.94,0:19:18.44,Default,,0,0,0,,Кешіріңіз, дұрыс айтасыз.
Dialogue: 0,0:19:18.69,0:19:20.74,Default,,0,0,0,,Жарайды, Шигеру-кун.
Dialogue: 0,0:19:20.86,0:19:23.28,Default,,0,0,0,,<А, сен абайсыз ба? ＞
Dialogue: 0,0:19:23.66,0:19:26.33,Default,,0,0,0,,Мен жалғызбын
Dialogue: 0,0:19:26.62,0:19:28.70,Default,,0,0,0,,Ешкім тең емес
Dialogue: 0,0:19:29.29,0:19:31.75,Default,,0,0,0,,Жақында барлығы кетеді.
Dialogue: 0,0:19:33.13,0:19:36.92,Default,,0,0,0,,Бірақ егер сіз сол абсолютті құдай Шигеру болсаңыз
Dialogue: 0,0:19:37.17,0:19:41.05,Default,,0,0,0,,Сол сияқты, егер сіз бірдеңені құрбан еткен Шигеру болсаңыз,
Dialogue: 0,0:19:41.26,0:19:45.01,Default,,0,0,0,,Менің сезімімді түсінетініңізге сенімдімін, солай ма?
Dialogue: 0,0:19:45.97,0:19:49.06,Default,,0,0,0,,Ендеше дос болайық
Dialogue: 0,0:19:49.73,0:19:51.60,Default,,0,0,0,,<Мен оған сене алмаймын>
Dialogue: 0,0:19:51.73,0:19:54.52,Default,,0,0,0,,<Ол қауіпті көрінетін ұйымдарға тосқауыл бола ма...>
Dialogue: 0,0:19:54.94,0:19:57.32,Default,,0,0,0,,Жақсы, егер бұл жай ғана достар болса.
Dialogue: 0,0:19:57.44,0:20:00.74,Default,,0,0,0,,Шынымен! Алақай!
Dialogue: 0,0:20:00.86,0:20:03.20,Default,,0,0,0,,Әй, біз басында дос болдық.
Dialogue: 0,0:20:03.45,0:20:06.58,Default,,0,0,0,,Бір күні менде болады... бірақ мен ұйымға кірмеймін.
Dialogue: 0,0:20:06.78,0:20:08.83,Default,,0,0,0,,Мен бір нәрсе істегім келеді.
Dialogue: 0,0:20:08.95,0:20:11.41,Default,,0,0,0,,Иә? Сіз не істегіңіз келеді?
Dialogue: 0,0:20:12.83,0:20:16.50,Default,,0,0,0,,Мен оларға осы дүниеде жол көрсетіп жүрмін.
Dialogue: 0,0:20:16.75,0:20:17.71,Default,,0,0,0,,Жетекші…
Dialogue: 0,0:20:18.30,0:20:22.43,Default,,0,0,0,,Бұл менің абсолютті құдай ретіндегі рөлім мен мақсатым.
Dialogue: 0,0:20:25.18,0:20:29.43,Default,,0,0,0,,Өйткені, сен, Шигеру, менің де құдайым емессің...
Dialogue: 0,0:20:29.97,0:20:32.52,Default,,0,0,0,,Ал сіз ше? Бізге қосылғыңыз келе ме?
Dialogue: 0,0:20:32.64,0:20:34.06,Default,,0,0,0,,Бұл өте пайдалы
Dialogue: 0,0:20:34.27,0:20:35.77,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:20:35.90,0:20:38.44,Default,,0,0,0,,Бұл сіздің рөліңіз, Шигеру...
Dialogue: 0,0:20:39.11,0:20:40.40,Default,,0,0,0,,Егер солай болса...
Dialogue: 0,0:20:41.24,0:20:44.07,Default,,0,0,0,,Мен кедергіге айналамын
Dialogue: 0,0:20:44.32,0:20:45.70,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:20:45.82,0:20:48.24,Default,,0,0,0,,Жоқ, дұрыс емес... мен сенің жолыңды кесемін.
Dialogue: 0,0:20:48.58,0:20:50.20,Default,,0,0,0,,＜Қарғыс атсын, неге? ＞
Dialogue: 0,0:20:50.33,0:20:52.66,Default,,0,0,0,,<Мен қай жерде қателік жібердім? ＞
Dialogue: 0,0:20:52.79,0:20:54.37,Default,,0,0,0,,Жолдан кет! Жолдан кет!
Dialogue: 0,0:20:54.75,0:20:57.33,Default,,0,0,0,,Сіз өтірік айттыңыз...
Dialogue: 0,0:20:58.13,0:21:03.01,Default,,0,0,0,,Сіз Құдаймен кездескіңіз келетінін айттыңыз.
Dialogue: 0,0:21:03.47,0:21:06.09,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:21:06.26,0:21:07.97,Default,,0,0,0,,Денем қан-қырынға толды!
Dialogue: 0,0:21:08.51,0:21:10.93,Default,,0,0,0,,Ұйқым келмейтін азапты күндер
Dialogue: 0,0:21:11.14,0:21:13.43,Default,,0,0,0,,Құдайды қанша рет естідім
Dialogue: 0,0:21:13.64,0:21:17.98,Default,,0,0,0,,Себебі мен жол көрсететін біреуді іздеп жүрдім...
Dialogue: 0,0:21:18.44,0:21:21.86,Default,,0,0,0,,Сіз маған өтірік айттыңыз
Dialogue: 0,0:21:21.98,0:21:25.49,Default,,0,0,0,,Бұл өтірік жойылуға әкеледі
Dialogue: 0,0:21:26.03,0:21:28.99,Default,,0,0,0,,Сіздің абсолютті құдайлық қабілеттеріңіз
Dialogue: 0,0:21:29.28,0:21:33.66,Default,,0,0,0,,Мен бәрін аламын!
Dialogue: 0,0:21:36.29,0:21:37.25,Default,,0,0,0,,Осо
Dialogue: 0,0:21:40.75,0:21:41.92,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:21:42.84,0:21:45.30,Default,,0,0,0,,Жоқ! Мен бүгін макияж қолданбаймын
Dialogue: 0,0:21:45.42,0:21:47.05,Default,,0,0,0,,Ұят~
Dialogue: 0,0:21:47.47,0:21:50.85,Default,,0,0,0,,Сайаку~ Мен қазір үйге бара жатырмын~
Dialogue: 0,0:21:52.47,0:21:54.43,Default,,0,0,0,,Қайтадан ойнайық
Dialogue: 0,0:21:54.64,0:21:56.27,Default,,0,0,0,,Қош бол Шигеру-кун
Dialogue: 0,0:21:57.02,0:21:59.06,Default,,0,0,0,,О, сен...
Dialogue: 0,0:21:59.31,0:22:03.03,Default,,0,0,0,,Менің атым Карина
Dialogue: 0,0:22:04.32,0:22:07.91,Default,,0,0,0,,<Абсолютті Құдай... Карина>
Dialogue: 0,0:22:10.28,0:22:13.24,Default,,0,0,0,,♪～
Dialogue: 0,0:23:35.66,0:23:38.62,Default,,0,0,0,,～♪
Dialogue: 0,0:23:40.12,0:23:46.12,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory