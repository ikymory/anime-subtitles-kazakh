Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.83,0:00:04.29,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:00:04.54,0:00:07.34,Default,,0,0,0,,Құбыжық? Жоқ, күте тұрыңыз ...
Dialogue: 0,0:00:07.50,0:00:09.38,Default,,0,0,0,,Бұл құбыжық емес, солай ма?
Dialogue: 0,0:00:09.50,0:00:11.63,Default,,0,0,0,,Шигеру - біздің бойтұмарымыз!
Dialogue: 0,0:00:12.01,0:00:14.34,Default,,0,0,0,,<Мен нюанстар сәл басқаша болғандай сезінемін>
Dialogue: 0,0:00:14.84,0:00:16.30,Default,,0,0,0,,<Рахмет саған Сейка-сан! ＞
Dialogue: 0,0:00:16.43,0:00:18.10,Default,,0,0,0,,Шигеру…
Dialogue: 0,0:00:18.22,0:00:21.31,Default,,0,0,0,,Бұл құбыжықтарды ұстайтын біртүрлі компания.
Dialogue: 0,0:00:21.48,0:00:23.98,Default,,0,0,0,,<Демек, бұл құбыжық емес>
Dialogue: 0,0:00:27.77,0:00:32.28,Default,,0,0,0,,Бұл компания сізді қабілеттеріңізге сәйкес келетін жұмыстармен таныстырады деп естідім.
Dialogue: 0,0:00:32.57,0:00:35.20,Default,,0,0,0,,Маған қолайлы жұмыс бар ма?
Dialogue: 0,0:00:35.45,0:00:37.16,Default,,0,0,0,,Иә! Мен бар екеніне сенімдімін!
Dialogue: 0,0:00:37.57,0:00:39.41,Default,,0,0,0,,Бұл жазба парағы
Dialogue: 0,0:00:39.53,0:00:42.70,Default,,0,0,0,,Деңгей және шеберлік Арнайы ескертулерді енгізіңіз
Dialogue: 0,0:00:43.08,0:00:45.21,Default,,0,0,0,,Арнайы ескертулер…
Dialogue: 0,0:00:45.67,0:00:48.75,Default,,0,0,0,,Бұл... қажет пе?
Dialogue: 0,0:00:49.00,0:00:51.17,Default,,0,0,0,,Алдымен шолу жақсы.
Dialogue: 0,0:00:51.30,0:00:53.84,Default,,0,0,0,,Арнайы жазбалардың кемшіліктерін жою
Dialogue: 0,0:00:54.13,0:00:56.18,Default,,0,0,0,,Бұл біздің философиямыз.
Dialogue: 0,0:00:56.76,0:00:58.05,Default,,0,0,0,,Мен бұрын
Dialogue: 0,0:00:58.18,0:01:02.10,Default,,0,0,0,,Мен өте күшті ерекше жағдайларға байланысты әйелді кездестірдім.
Dialogue: 0,0:01:02.31,0:01:05.85,Default,,0,0,0,,Бірақ ол оны жеңе білді.
Dialogue: 0,0:01:06.40,0:01:07.94,Default,,0,0,0,,<Рейа туралы айтып отырсыз ба>
Dialogue: 0,0:01:08.06,0:01:11.78,Default,,0,0,0,,Сондықтан оны кез келген адам арнайы ескертулерге байланбай пайдалана алады.
Dialogue: 0,0:01:12.15,0:01:15.40,Default,,0,0,0,,Сіз өз өміріңізді жалғастыра білуіңіз керек.
Dialogue: 0,0:01:15.65,0:01:17.66,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:01:17.78,0:01:19.87,Default,,0,0,0,,Мен саған сенемін (Сейка) Хехе
Dialogue: 0,0:01:20.83,0:01:24.87,Default,,0,0,0,,<Сейка-сан... сен шынымен де күшейдің>
Dialogue: 0,0:01:25.62,0:01:28.58,Default,,0,0,0,,♪～
Dialogue: 0,0:02:49.46,0:02:52.42,Default,,0,0,0,,～♪
Dialogue: 0,0:02:55.80,0:02:56.96,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:02:57.09,0:02:59.26,Default,,0,0,0,,Сыйлықтар тізімі
Dialogue: 0,0:02:59.42,0:03:02.59,Default,,0,0,0,,Казино оқиғасына байланысты мен мемлекеттік кеңсемен байланыса алдым.
Dialogue: 0,0:03:02.72,0:03:04.55,Default,,0,0,0,,Мен ақпарат жинауға тырыстым.
Dialogue: 0,0:03:04.76,0:03:07.89,Default,,0,0,0,,Ordnung Spear-ді зерттеу Бұл көмектеседі деп үміттенемін.
Dialogue: 0,0:03:08.14,0:03:09.85,Default,,0,0,0,,Сыйлық
Dialogue: 0,0:03:10.31,0:03:13.31,Default,,0,0,0,,Сақтықпен қараған дұрысырақ адамдар көп...
Dialogue: 0,0:03:20.74,0:03:22.07,Default,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:03:22.24,0:03:23.82,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:03:24.41,0:03:25.83,Default,,0,0,0,,Фуфу
Dialogue: 0,0:03:27.62,0:03:29.45,Default,,0,0,0,,Ха!
Dialogue: 0,0:03:29.66,0:03:30.83,Default,,0,0,0,,Бұл Сейка!
Dialogue: 0,0:03:30.96,0:03:33.79,Default,,0,0,0,,Маған қолдарыңызды көрсете аласыз ба?
Dialogue: 0,0:03:33.96,0:03:36.75,Default,,0,0,0,,Не? Иә өтінемін
Dialogue: 0,0:03:38.55,0:03:40.22,Default,,0,0,0,,Хмм…
Dialogue: 0,0:03:40.42,0:03:42.22,Default,,0,0,0,,Ой, жоқ, ол мені сақтықпен қарап тұр.
Dialogue: 0,0:03:42.68,0:03:44.55,Default,,0,0,0,,Сенің құпияң жоқ па?
Dialogue: 0,0:03:44.68,0:03:47.22,Default,,0,0,0,,А... <Хмм! Бұл жігіт...>
Dialogue: 0,0:03:47.35,0:03:49.14,Default,,0,0,0,,Әзіл, ә...
Dialogue: 0,0:03:49.43,0:03:52.19,Default,,0,0,0,,Бұл көріпкелдің әдісі.
Dialogue: 0,0:03:52.31,0:03:54.02,Default,,0,0,0,,Сізді мазақ еткенім үшін кешіріңіз.
Dialogue: 0,0:03:54.19,0:03:55.19,Default,,0,0,0,,Болжам?
Dialogue: 0,0:03:55.31,0:03:57.48,Default,,0,0,0,,Бұл суық оқу.
Dialogue: 0,0:03:57.94,0:04:01.86,Default,,0,0,0,,Барлығына қатысты сұрақтармен басқа адамның ойын оқыңыз...
Dialogue: 0,0:04:01.99,0:04:05.28,Default,,0,0,0,,Everyone has a secret.
Dialogue: 0,0:04:05.53,0:04:07.95,Default,,0,0,0,,I was a little nervous.
Dialogue: 0,0:04:08.08,0:04:10.37,Default,,0,0,0,,Was Leah a fortune teller?
Dialogue: 0,0:04:10.50,0:04:11.50,Default,,0,0,0,,Иә
Dialogue: 0,0:04:11.62,0:04:14.88,Default,,0,0,0,,Оның танымал болғаны сонша, оны болжау құдайы деп атаған.
Dialogue: 0,0:04:15.00,0:04:16.50,Default,,0,0,0,,Wow, that's amazing!
Dialogue: 0,0:04:16.63,0:04:19.38,Default,,0,0,0,,Һм. Рақмет.
Dialogue: 0,0:04:19.96,0:04:24.01,Default,,0,0,0,,Негізі менің шеберім сауда компаниясында сатушы.
Dialogue: 0,0:04:24.30,0:04:26.43,Default,,0,0,0,,Are you a fortune-telling tools company?
Dialogue: 0,0:04:26.55,0:04:27.39,Default,,0,0,0,,Жоқ
Dialogue: 0,0:04:27.51,0:04:30.47,Default,,0,0,0,,Бұл кәдімгі кеңсе тауарларымен айналысатын компания болды.
Dialogue: 0,0:04:30.60,0:04:31.48,Default,,0,0,0,,<Хмм? ＞
Dialogue: 0,0:04:31.60,0:04:32.89,Default,,0,0,0,,Сол кезде...
Dialogue: 0,0:04:33.14,0:04:35.77,Default,,0,0,0,,＜Қарапайым көрінсе де, сөйлей алмаса да＞
Dialogue: 0,0:04:35.94,0:04:38.19,Default,,0,0,0,,＜Ол түнгі көбелек деп аталатын...＞
Dialogue: 0,0:04:38.32,0:04:39.77,Default,,0,0,0,,<Түнгі көбелек? ＞
Dialogue: 0,0:04:39.90,0:04:43.28,Default,,0,0,0,,<Менің жұмысым-адамдардың көңілін көтеру, ішімдік ішу.>
Dialogue: 0,0:04:43.40,0:04:45.78,Default,,0,0,0,,<Мастер, иә...>
Dialogue: 0,0:04:45.95,0:04:48.70,Default,,0,0,0,,Let's call it "Mr. Y"
Dialogue: 0,0:04:48.95,0:04:50.29,Default,,0,0,0,,<Жоқ...>
Dialogue: 0,0:04:50.41,0:04:52.91,Default,,0,0,0,,Mr. Y was a strange person.
Dialogue: 0,0:04:53.54,0:04:58.08,Default,,0,0,0,,＜Біз, актер мүшелері, басшыларымыз бен қонақтарымызды қуанттық＞
Dialogue: 0,0:04:58.84,0:05:03.42,Default,,0,0,0,,<Содан кейін бір күні Ю мырза өз компаниясынан бірнеше жаңа түлектерді алып келді.>
Dialogue: 0,0:05:03.76,0:05:06.97,Default,,0,0,0,,<Жұмысыма байланысты маған мұндай дүкенге дағдылану керектігін айтты>
Dialogue: 0,0:05:07.59,0:05:11.18,Default,,0,0,0,,<Содан кейін біз жаңа түлектермен және актерлік құраммен орындарын ауыстырдық>
Dialogue: 0,0:05:11.31,0:05:14.18,Default,,0,0,0,,<I even started sales training>
Dialogue: 0,0:05:14.81,0:05:19.73,Default,,0,0,0,,<Сонымен қатар болжау, психологиялық тесттер және байланыс орнатуды жеңілдететін сөйлесуді қалай жүргізу керек.>
Dialogue: 0,0:05:19.86,0:05:21.73,Default,,0,0,0,,<I learned a lot from you>
Dialogue: 0,0:05:22.07,0:05:23.69,Default,,0,0,0,,Олай ма еді?
Dialogue: 0,0:05:24.11,0:05:27.74,Default,,0,0,0,,Сол кезде Ю мырза маған болжау туралы кіріспе кітапты берді.
Dialogue: 0,0:05:28.16,0:05:29.66,Default,,0,0,0,,<Есімде>
Dialogue: 0,0:05:29.78,0:05:33.45,Default,,0,0,0,,<Түрі өзгерді, бірақ ол сол кездегідей...>
Dialogue: 0,0:05:33.91,0:05:35.66,Default,,0,0,0,,At least like Mr. Y
Dialogue: 0,0:05:35.79,0:05:39.50,Default,,0,0,0,,Әңгімелесулер боламын деген үмітпен кітапқа үңілдім.
Dialogue: 0,0:05:40.38,0:05:42.34,Default,,0,0,0,,Then on the last page...
Dialogue: 0,0:05:42.67,0:05:44.01,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:44.84,0:05:47.30,Default,,0,0,0,,<"I'll make you smile">
Dialogue: 0,0:05:47.43,0:05:49.97,Default,,0,0,0,,<"I will never disappoint">
Dialogue: 0,0:05:50.97,0:05:52.97,Default,,0,0,0,,<I couldn't help but laugh>
Dialogue: 0,0:05:53.89,0:05:56.27,Default,,0,0,0,,Жел саяхатшысы...
Dialogue: 0,0:05:57.14,0:05:59.65,Default,,0,0,0,,Then I seriously learned fortune telling.
Dialogue: 0,0:05:59.77,0:06:02.98,Default,,0,0,0,,Оны тіпті болжау құдайы деп те атайды.
Dialogue: 0,0:06:03.28,0:06:07.74,Default,,0,0,0,,Бірақ бұл Ю мырзаның сөзінің жанама туындысы ғана.
Dialogue: 0,0:06:07.90,0:06:08.99,Default,,0,0,0,,Лия-сан?
Dialogue: 0,0:06:09.41,0:06:10.99,Default,,0,0,0,,Өте жақсы
Dialogue: 0,0:06:11.53,0:06:13.62,Default,,0,0,0,,Сейка-сан...
Dialogue: 0,0:06:13.99,0:06:17.37,Default,,0,0,0,,Менің ойымша, сіз екеуміз жақсы дос бола аламыз.
Dialogue: 0,0:06:17.54,0:06:19.88,Default,,0,0,0,,Иә хехехе
Dialogue: 0,0:06:27.59,0:06:31.64,Default,,0,0,0,,Тіркелгісі келетіндер үшін фондық тексеру аяқталуға жақын.
Dialogue: 0,0:06:31.76,0:06:32.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:34.01,0:06:37.06,Default,,0,0,0,,Сонда да біртүрлі болып көрінеді.
Dialogue: 0,0:06:37.18,0:06:38.52,Default,,0,0,0,,Иә? Жоқ, жоқ
Dialogue: 0,0:06:38.64,0:06:42.94,Default,,0,0,0,,Мен мұндай кеңсе қызметкері боламын деп ешқашан ойламадым.
Dialogue: 0,0:06:44.02,0:06:45.15,Default,,0,0,0,,Лидс
Dialogue: 0,0:06:45.48,0:06:47.78,Default,,0,0,0,,Сіз мұны бұрын айттыңыз, солай ма?
Dialogue: 0,0:06:47.94,0:06:49.70,Default,,0,0,0,,Менің бастапқы әлемімде...
Dialogue: 0,0:06:49.82,0:06:52.28,Default,,0,0,0,,Ол Шигеру Йошиоканы іздеп жүргенін айтты.
Dialogue: 0,0:06:52.82,0:06:56.45,Default,,0,0,0,,Сонда менің өткен өмірім туралы білесің бе?
Dialogue: 0,0:06:58.33,0:06:59.62,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:06:59.83,0:07:02.79,Default,,0,0,0,,Бұл жалған айып болды...
Dialogue: 0,0:07:02.96,0:07:04.00,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:04.13,0:07:08.67,Default,,0,0,0,,Мен Шигеру-санды іздеп жүріп, оқиғаны білдім.
Dialogue: 0,0:07:08.84,0:07:10.97,Default,,0,0,0,,Газет мақалалары және интернет ақпараты
Dialogue: 0,0:07:11.09,0:07:14.22,Default,,0,0,0,,Мен тіпті ұқсас істер бойынша сот хаттамаларын да қарап шықтым.
Dialogue: 0,0:07:15.14,0:07:20.02,Default,,0,0,0,,Содан кейін күдіктінің қылмыс жасамағаны туралы көптеген дәлелдер болды.
Dialogue: 0,0:07:20.14,0:07:21.77,Default,,0,0,0,,Болжалды жәбірленуші де
Dialogue: 0,0:07:21.90,0:07:24.81,Default,,0,0,0,,«Нашақор болдым» деп жалған айып тағып...
Dialogue: 0,0:07:25.90,0:07:29.19,Default,,0,0,0,,Мен Шигеру-санға сенемін.
Dialogue: 0,0:07:32.78,0:07:34.24,Default,,0,0,0,,Бұл субтитрлер JOJO's Bizarre Adventure форумы, Yuhari Subtitles және Gods Subtitles Group бірлесіп дайындады
Dialogue: 0,0:07:37.54,0:07:40.46,Default,,0,0,0,,Енді фондық тексеруді жалғастырайық.
Dialogue: 0,0:07:40.58,0:07:43.08,Default,,0,0,0,,Дұрыс, келесі...
Dialogue: 0,0:07:43.88,0:07:45.50,Default,,0,0,0,,Ол...
Dialogue: 0,0:07:46.46,0:07:48.13,Default,,0,0,0,,(үкінің айқайы)
Dialogue: 0,0:07:54.01,0:07:57.60,Default,,0,0,0,,<Мен оның жүрген жерін іздеу шеберлігіммен іздеп көрдім, бірақ>
Dialogue: 0,0:07:57.76,0:08:00.06,Default,,0,0,0,,<Осындай жердің мақсаты не? ＞
Dialogue: 0,0:08:00.31,0:08:02.10,Default,,0,0,0,,Ха! Шигеру-сан!
Dialogue: 0,0:08:03.60,0:08:05.61,Default,,0,0,0,,Әй, кішкентай қыз (қыз)?
Dialogue: 0,0:08:06.23,0:08:08.61,Default,,0,0,0,,Мұндай жерде не болып жатыр?
Dialogue: 0,0:08:08.82,0:08:11.61,Default,,0,0,0,,Е, у...
Dialogue: 0,0:08:11.74,0:08:14.28,Default,,0,0,0,,Сіз кездейсоқ қарызға ақша алдыңыз ба?
Dialogue: 0,0:08:14.41,0:08:17.66,Default,,0,0,0,,Сол жерде тұратын қорқынышты қартқа
Dialogue: 0,0:08:18.79,0:08:21.62,Default,,0,0,0,,Әй... інім ауырып қалды.
Dialogue: 0,0:08:21.79,0:08:23.87,Default,,0,0,0,,Мен дәрі сатып ала алмаймын
Dialogue: 0,0:08:24.25,0:08:26.79,Default,,0,0,0,,Небәрі 100 лир қарызға алсам да.
Dialogue: 0,0:08:27.79,0:08:30.63,Default,,0,0,0,,Ол 10 000 лирге дейін өсті...
Dialogue: 0,0:08:30.84,0:08:35.09,Default,,0,0,0,,<Заңсыз ақша беруші... Лия солардың бірі ме? ＞
Dialogue: 0,0:08:35.22,0:08:36.64,Default,,0,0,0,,Мен...
Dialogue: 0,0:08:37.10,0:08:40.97,Default,,0,0,0,,Ақшаны қайтара алмасаң, сені сол кісіге сатып жіберетін шығарсың.
Dialogue: 0,0:08:41.10,0:08:42.81,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:08:43.02,0:08:45.65,Default,,0,0,0,,А? Ол кім? (Қыз) Ах!
Dialogue: 0,0:08:46.48,0:08:49.15,Default,,0,0,0,,О, Кайдо, біраз уақыт өтті.
Dialogue: 0,0:08:49.32,0:08:50.53,Default,,0,0,0,,Тағы кім болуы мүмкін?
Dialogue: 0,0:08:50.65,0:08:54.65,Default,,0,0,0,,Сен тағы да біздің қонақтармен араласуға келдің бе? а?
Dialogue: 0,0:08:55.24,0:08:57.41,Default,,0,0,0,,<Хмм? Бұл мотив...>
Dialogue: 0,0:08:57.99,0:08:59.45,Default,,0,0,0,,<Ордның найза! ＞
Dialogue: 0,0:09:00.24,0:09:03.96,Default,,0,0,0,,<Ал бұл адам компанияның сыйақылар тізімінде...>
Dialogue: 0,0:09:04.21,0:09:08.75,Default,,0,0,0,,Эй, ханым, бүгін өтеу мерзімі аяқталды, солай ма?
Dialogue: 0,0:09:08.88,0:09:11.34,Default,,0,0,0,,Сіз ақшаға дайынсыз ба?
Dialogue: 0,0:09:11.46,0:09:13.01,Default,,0,0,0,,(Исуми Миямура) Ишикава-кун, сенде абсурдтай көп зат бар, иә?
Dialogue: 0,0:09:13.13,0:09:16.30,Default,,0,0,0,,Өтінемін! Өтінемін, қызығушылықты кешіріңіз!
Dialogue: 0,0:09:17.01,0:09:19.55,Default,,0,0,0,,100 лирді қайтарып беремін!
Dialogue: 0,0:09:22.81,0:09:25.35,Default,,0,0,0,,Үлкендерді мазақ ете алмайсың, солай ма?
Dialogue: 0,0:09:25.48,0:09:26.27,Default,,0,0,0,,Уф
Dialogue: 0,0:09:26.39,0:09:28.52,Default,,0,0,0,,Лидс Бұл адам туралы ақпарат
Dialogue: 0,0:09:28.65,0:09:31.82,Default,,0,0,0,,Гэндзи Кайдо 181-деңгей
Dialogue: 0,0:09:32.69,0:09:34.32,Default,,0,0,0,,Арнайы ескертулер…
Dialogue: 0,0:09:34.49,0:09:36.45,Default,,0,0,0,,«Ақша өмірден маңызды»
Dialogue: 0,0:09:36.57,0:09:38.99,Default,,0,0,0,,«Кім менің ақшамды ұрламақшы?»
Dialogue: 0,0:09:39.12,0:09:41.66,Default,,0,0,0,,«Мен сені міндетті түрде тауып, тозақты көрсетемін».
Dialogue: 0,0:09:41.91,0:09:44.08,Default,,0,0,0,,«Мен Құдайға сенбеймін»
Dialogue: 0,0:09:44.41,0:09:47.00,Default,,0,0,0,,<Мм! Мен Құдайға сенбеймін...>
Dialogue: 0,0:09:47.12,0:09:50.00,Default,,0,0,0,,<Бұл маған, абсолютті құдайға әсер ете ме? ＞
Dialogue: 0,0:09:50.21,0:09:51.71,Default,,0,0,0,,Сәлем Кайдо
Dialogue: 0,0:09:51.84,0:09:53.92,Default,,0,0,0,,Ол баланы маған сатасың ба?
Dialogue: 0,0:09:54.05,0:09:54.88,Default,,0,0,0,,<Не!?>
Dialogue: 0,0:09:55.09,0:09:58.59,Default,,0,0,0,,А? Лия... сіз қазір қанша адамсыз?
Dialogue: 0,0:09:58.72,0:10:02.35,Default,,0,0,0,,Балалар, қазір тығылып жүрсіңдер ме?
Dialogue: 0,0:10:02.64,0:10:05.89,Default,,0,0,0,,Мұнда «өнімдерді» сату қауіпсіз емес пе?
Dialogue: 0,0:10:06.23,0:10:08.90,Default,,0,0,0,,Цк, аяғыңа қара...
Dialogue: 0,0:10:10.31,0:10:11.36,Default,,0,0,0,,Бір мүйізбен осындай күш.
Dialogue: 0,0:10:12.40,0:10:14.11,Default,,0,0,0,,Тұр (қыз) Ух...
Dialogue: 0,0:10:17.11,0:10:20.62,Default,,0,0,0,,Хехе, сен енді менікісің...
Dialogue: 0,0:10:21.74,0:10:24.20,Default,,0,0,0,,А... не?
Dialogue: 0,0:10:24.33,0:10:25.66,Default,,0,0,0,,«Басу»
Dialogue: 0,0:10:25.79,0:10:28.62,Default,,0,0,0,,Бұл өз бетінше өлуге мүмкіндік бермейтін шектеу дағдысы.
Dialogue: 0,0:10:29.25,0:10:32.38,Default,,0,0,0,,Енді өз өміріңізді қалай пайдаланасыз, өзіңізге байланысты...
Dialogue: 0,0:10:33.13,0:10:34.84,Default,,0,0,0,,Алдымен үйге барыңыз.
Dialogue: 0,0:10:39.18,0:10:40.80,Default,,0,0,0,,Лидс бұл бала
Dialogue: 0,0:10:40.93,0:10:42.10,Default,,0,0,0,,Шынайы сезімдері мен нағыз болмысын жасырып
Dialogue: 0,0:10:44.35,0:10:47.77,Default,,0,0,0,,Мерзімі бүгін болатын тағы бір бала болды.
Dialogue: 0,0:10:47.89,0:10:48.89,Default,,0,0,0,,Мен де сол баланы қалаймын.
Dialogue: 0,0:10:49.27,0:10:52.44,Default,,0,0,0,,Ха, сен де сараңсың.
Dialogue: 0,0:10:52.65,0:10:56.36,Default,,0,0,0,,Өкініштісі сол бала өліп қалар еді.
Dialogue: 0,0:10:56.48,0:10:58.36,Default,,0,0,0,,Ах! (Кайдоу) Көп ақшаны қалаймын
Dialogue: 0,0:10:58.49,0:11:00.78,Default,,0,0,0,,Сіз қисынсыз ізденіспен айналысқан сияқтысыз...
Dialogue: 0,0:11:01.03,0:11:04.83,Default,,0,0,0,,Қаншама... Қарызға берген ақшамды ысырап еттім.
Dialogue: 0,0:11:05.03,0:11:06.58,Default,,0,0,0,,Одан да көп...
Dialogue: 0,0:11:06.70,0:11:10.71,Default,,0,0,0,,Неліктен біздің ұйымға қосылмайсыз?
Dialogue: 0,0:11:11.04,0:11:14.17,Default,,0,0,0,,Орднунг найза... Бұл болды ма?
Dialogue: 0,0:11:14.75,0:11:18.92,Default,,0,0,0,,Кешіріңіз, мен танысқанды ұнатпаймын.
Dialogue: 0,0:11:19.47,0:11:22.34,Default,,0,0,0,,Ойыңызды өзгертсеңіз, кез келген уақытта қайтып келуіңізге болады.
Dialogue: 0,0:11:22.51,0:11:25.22,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:11:25.39,0:11:28.31,Default,,0,0,0,,Сұлулығыңа түнгі самал жаман.
Dialogue: 0,0:11:29.64,0:11:32.85,Default,,0,0,0,,<Кайду Орднунг Найзасының мүшесі екені расталды>
Dialogue: 0,0:11:32.98,0:11:35.44,Default,,0,0,0,,＜Бірақ Риа Кикуна...＞
Dialogue: 0,0:11:36.65,0:11:38.44,Default,,0,0,0,,(Лианың жылаған дауысы)
Dialogue: 0,0:11:39.61,0:11:41.86,Default,,0,0,0,,(Қол Перісі) Құтқарып болмайды… Соңғы көргенім – демон өлтірушінің жүзі болар деп кім ойлаған…
Dialogue: 0,0:11:42.41,0:11:43.95,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:11:45.03,0:11:46.45,Default,,0,0,0,,Эренді тоқтату үшін. Көпшілік кісі өлтіру – қате.
Dialogue: 0,0:11:46.62,0:11:50.62,Default,,0,0,0,,(Лианың жылаған дауысы)
Dialogue: 0,0:11:53.46,0:11:56.00,Default,,0,0,0,,Мен ол баланы компанияға қалдырдым.
Dialogue: 0,0:11:56.17,0:12:00.01,Default,,0,0,0,,Қазір мен ағаммен ыстық сусын ішіп отырмын.
Dialogue: 0,0:12:00.30,0:12:03.26,Default,,0,0,0,,Осыдан кейін Като-сан мені үйге апарады.
Dialogue: 0,0:12:03.43,0:12:05.60,Default,,0,0,0,,Түсіндім, рахмет.
Dialogue: 0,0:12:05.80,0:12:06.97,Default,,0,0,0,,Лидс
Dialogue: 0,0:12:07.14,0:12:10.10,Default,,0,0,0,,Сіздің ерекше жазбаларыңыз зұлымдыққа жауап береді.
Dialogue: 0,0:12:10.56,0:12:12.60,Default,,0,0,0,,Бірақ қазір ше?
Dialogue: 0,0:12:18.40,0:12:22.32,Default,,0,0,0,,Кем дегенде, ол шынымен зұлым емес сияқты.
Dialogue: 0,0:12:25.07,0:12:26.20,Default,,0,0,0,,А...
Dialogue: 0,0:12:26.37,0:12:29.70,Default,,0,0,0,,Ол әйел де бұл дүниеде болған.
Dialogue: 0,0:12:30.45,0:12:31.96,Default,,0,0,0,,Ахаха
Dialogue: 0,0:12:34.46,0:12:37.71,Default,,0,0,0,,Не дегіңіз келеді…
Dialogue: 0,0:12:39.88,0:12:41.84,Default,,0,0,0,,<Жұмыстан кейінгі демалыс күні>
Dialogue: 0,0:12:42.22,0:12:45.72,Default,,0,0,0,,<Сейка-сан екеуміз қаладағы карнавалға бардық>
Dialogue: 0,0:12:45.89,0:12:47.10,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:47.39,0:12:50.35,Default,,0,0,0,,Уау! Сирек кездесетін нәрселер көп
Dialogue: 0,0:12:50.89,0:12:52.89,Default,,0,0,0,,Шигеру-сан! Бұл балмұздақ!
Dialogue: 0,0:12:53.31,0:12:54.06,Default,,0,0,0,,Онда «Лайт» орнына «Рыцарь» деп атай алам ба?
Dialogue: 0,0:12:54.27,0:12:56.31,Default,,0,0,0,,Сәлем! (Әйел) Монстр!
Dialogue: 0,0:12:56.52,0:12:57.40,Default,,0,0,0,,Уф... (Еркек) Мен мұны көрдім...
Dialogue: 0,0:12:57.90,0:13:01.65,Default,,0,0,0,,<Адамдар көп, бірақ олар маған мейірімділікпен орын береді.>
Dialogue: 0,0:13:01.78,0:13:03.90,Default,,0,0,0,,<Бұл көрініс те пайдалы.>
Dialogue: 0,0:13:04.07,0:13:05.49,Default,,0,0,0,,Дәмді~
Dialogue: 0,0:13:05.61,0:13:09.66,Default,,0,0,0,,<Мені Рианың ісі алаңдатады, бірақ мен Сейка-санның көңілді жүргеніне қуаныштымын.>
Dialogue: 0,0:13:09.78,0:13:10.87,Default,,0,0,0,,Мұны істейік!
Dialogue: 0,0:13:12.12,0:13:14.50,Default,,0,0,0,,Мына тұлып сыйлыққа ұқсайды!
Dialogue: 0,0:13:14.62,0:13:16.17,Default,,0,0,0,,Мен мұны қалаймын!
Dialogue: 0,0:13:16.37,0:13:18.29,Default,,0,0,0,,<Бұл не! Сакурай мырза? ＞
Dialogue: 0,0:13:19.50,0:13:21.50,Default,,0,0,0,,Сәлем! <Жоқ, жоқ, жоқ, жоқ>
Dialogue: 0,0:13:21.63,0:13:24.13,Default,,0,0,0,,Сейка-сан, бір-бірден лақтырайық.
Dialogue: 0,0:13:24.30,0:13:26.26,Default,,0,0,0,,Иә
Dialogue: 0,0:13:26.59,0:13:29.26,Default,,0,0,0,,Қалам сияқты ұста... (Сейка) А?
Dialogue: 0,0:13:32.10,0:13:33.56,Default,,0,0,0,,Джекпот!
Dialogue: 0,0:13:33.68,0:13:35.06,Default,,0,0,0,,Иә, бұл жүлде!
Dialogue: 0,0:13:35.18,0:13:36.94,Default,,0,0,0,,Уау, бұл керемет
Dialogue: 0,0:13:40.19,0:13:41.19,Default,,0,0,0,,Иә
Dialogue: 0,0:13:41.44,0:13:44.69,Default,,0,0,0,,<Ха! Бұл жігіт тағы бір абсолютті құдай>
Dialogue: 0,0:13:45.40,0:13:46.74,Default,,0,0,0,,<Карина>
Dialogue: 0,0:13:48.87,0:13:50.33,Default,,0,0,0,,Иә, өтінемін
Dialogue: 0,0:13:50.45,0:13:51.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:51.45,0:13:53.37,Default,,0,0,0,,Сіз мұны қалайсыз, солай ма?
Dialogue: 0,0:13:53.83,0:13:57.12,Default,,0,0,0,,Мен саған мынаны беремін, ендеше дос болайық.
Dialogue: 0,0:13:57.37,0:13:58.25,Default,,0,0,0,,Адам аяғы тимейтін орынды әдейі таңдаған...
Dialogue: 0,0:13:59.04,0:14:00.50,Default,,0,0,0,,Иә? Хмм...
Dialogue: 0,0:14:04.13,0:14:06.97,Default,,0,0,0,,Эй, біз дос бола аламыз ба? Хмм...
Dialogue: 0,0:14:07.09,0:14:09.51,Default,,0,0,0,,Сіз доссыз ба?
Dialogue: 0,0:14:10.05,0:14:12.43,Default,,0,0,0,,Сіздің достарыңыз бар ма?
Dialogue: 0,0:14:12.56,0:14:16.48,Default,,0,0,0,,Жақында мен Риа есімді адаммен дос болдым...
Dialogue: 0,0:14:16.73,0:14:19.15,Default,,0,0,0,,А... Лия-сан?
Dialogue: 0,0:14:19.27,0:14:21.23,Default,,0,0,0,,О, бұл! иә?
Dialogue: 0,0:14:21.61,0:14:24.44,Default,,0,0,0,,Мен сенің атыңды білмеймін
Dialogue: 0,0:14:24.57,0:14:28.28,Default,,0,0,0,,Дос болмас бұрын, өзіңіз туралы айтып беріңізші
Dialogue: 0,0:14:28.53,0:14:31.74,Default,,0,0,0,,Аха менің атым Карина
Dialogue: 0,0:14:31.87,0:14:34.41,Default,,0,0,0,,Мен саған бұдан да жақсысын беремін.
Dialogue: 0,0:14:34.70,0:14:36.79,Default,,0,0,0,,Біз дос бола аламыз деп үміттенемін
Dialogue: 0,0:14:37.04,0:14:41.25,Default,,0,0,0,,Сәлем! эй! Оның орнына парадты тамашалайық!
Dialogue: 0,0:14:41.38,0:14:45.30,Default,,0,0,0,,(Адамдар қолдайды)
Dialogue: 0,0:14:45.51,0:14:47.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:48.42,0:14:49.51,Default,,0,0,0,,<Иә иә>
Dialogue: 0,0:14:49.63,0:14:51.64,Default,,0,0,0,,Шерулер өте қызық!
Dialogue: 0,0:14:51.76,0:14:54.51,Default,,0,0,0,,Аха, мен Хадиді жақсы көремін!
Dialogue: 0,0:14:55.06,0:14:58.27,Default,,0,0,0,,<Оның Непутадан айырмашылығын білмеймін...>
Dialogue: 0,0:15:01.77,0:15:04.23,Default,,0,0,0,,Бұл құдай ма?
Dialogue: 0,0:15:04.40,0:15:05.82,Default,,0,0,0,,Богиня...
Dialogue: 0,0:15:06.32,0:15:10.15,Default,,0,0,0,,Эй, Сейка-чан, сен Құдайды кездестірдің бе?
Dialogue: 0,0:15:10.28,0:15:11.07,Default,,0,0,0,,Әй!
Dialogue: 0,0:15:11.20,0:15:13.49,Default,,0,0,0,,Сіз Құдайсыз ба?
Dialogue: 0,0:15:13.62,0:15:14.99,Default,,0,0,0,,Мен!
Dialogue: 0,0:15:15.12,0:15:18.66,Default,,0,0,0,,Арнайы жазбалар бөліміне "Мен Құдаймен кездескім келеді" деп жаздым!
Dialogue: 0,0:15:18.79,0:15:21.04,Default,,0,0,0,,<Тоқта, не айтқың келіп тұр>
Dialogue: 0,0:15:21.67,0:15:24.84,Default,,0,0,0,,Сейка-чан, Құдай қандай адам деп ойлайсың?
Dialogue: 0,0:15:24.96,0:15:27.84,Default,,0,0,0,,Адамдар? Құдай адам ма?
Dialogue: 0,0:15:27.96,0:15:31.55,Default,,0,0,0,,Иә, әсіресе Абсолютті Құдай деп атаған Құдай.
Dialogue: 0,0:15:31.76,0:15:35.60,Default,,0,0,0,,Сіз өзіңіздің үш ұлы тілегіңіздің бірін мөрлеген реинкарнацияланған адамсыз ба?
Dialogue: 0,0:15:35.93,0:15:38.77,Default,,0,0,0,,Жыныстық құмарлықты басатын еркек құдай.
Dialogue: 0,0:15:38.93,0:15:42.60,Default,,0,0,0,,Жыныстық құмарлықты да, ұйқы құмарлығын да мөрлеген құдай.
Dialogue: 0,0:15:42.73,0:15:44.94,Default,,0,0,0,,Шигеру-сан...
Dialogue: 0,0:15:45.06,0:15:46.07,Default,,0,0,0,,Шигеру-сан...
Dialogue: 0,0:15:46.40,0:15:47.94,Default,,0,0,0,,Шигеру-сан! Ах...
Dialogue: 0,0:15:48.07,0:15:49.82,Default,,0,0,0,,Сіз бозарған сияқтысыз ба?
Dialogue: 0,0:15:50.11,0:15:52.20,Default,,0,0,0,,Қаржы бөлімінен әкетілген адам
Dialogue: 0,0:15:52.36,0:15:54.62,Default,,0,0,0,,Бір жерде демалайық па?
Dialogue: 0,0:15:57.16,0:15:59.20,Default,,0,0,0,,Нені айтып тұрсың, Карина?
Dialogue: 0,0:15:59.37,0:16:00.87,Default,,0,0,0,,Шигеру-кун
Dialogue: 0,0:16:01.12,0:16:04.08,Default,,0,0,0,,Мен сенің жолыңа кедергі келтіремін дедім ғой, солай ма?
Dialogue: 0,0:16:04.33,0:16:08.38,Default,,0,0,0,,Бірақ сіз бен біздің арамыздағы мәртебе айырмашылығы тым қатал емес пе?
Dialogue: 0,0:16:08.50,0:16:09.96,Default,,0,0,0,,Сонымен мүгедектік ретінде
Dialogue: 0,0:16:10.26,0:16:12.84,Default,,0,0,0,,Мен өзімнің әлсіз тұстарымды айтайын
Dialogue: 0,0:16:12.97,0:16:14.09,Default,,0,0,0,,Әлсіздік?
Dialogue: 0,0:16:15.09,0:16:16.60,Default,,0,0,0,,(Нишики) Бұл... осы туралы сұрауға мен дұрыс адаммын ба?
Dialogue: 0,0:16:17.05,0:16:19.77,Default,,0,0,0,,Сүйген адамыңнан сүйіспеншілік алған кезде
Dialogue: 0,0:16:19.89,0:16:21.60,Default,,0,0,0,,Ол еріп, жоғалады.
Dialogue: 0,0:16:21.98,0:16:24.15,Default,,0,0,0,,Не!? Шигеру-кун
Dialogue: 0,0:16:24.81,0:16:27.65,Default,,0,0,0,,Мен саған ғашық болайын
Dialogue: 0,0:16:27.77,0:16:31.03,Default,,0,0,0,,<Уф... сурет өрескел. Қабылданбады>
Dialogue: 0,0:16:31.15,0:16:32.15,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:16:32.28,0:16:35.28,Default,,0,0,0,,Өйткені, ол жерде Сейка-чан бар.
Dialogue: 0,0:16:35.78,0:16:38.83,Default,,0,0,0,,Сен Сейка-чан туралы ештеңе білмейсің.
Dialogue: 0,0:16:38.95,0:16:43.29,Default,,0,0,0,,Оны қалай айтасыз? Жаңа үгітілген ақ орамал сияқты ма?
Dialogue: 0,0:16:43.79,0:16:47.50,Default,,0,0,0,,Мен сияқты, сізде ешқашан болмаған шығар.
Dialogue: 0,0:16:47.63,0:16:50.05,Default,,0,0,0,,Менен маңызды нәрсені алып тастау
Dialogue: 0,0:16:50.17,0:16:52.84,Default,,0,0,0,,Менде ұстай алмайтын ашу болды
Dialogue: 0,0:16:52.97,0:16:54.30,Default,,0,0,0,,Не айтпақшысың?
Dialogue: 0,0:16:54.43,0:16:57.80,Default,,0,0,0,,Сейка-чанның оған маңызды адамы бар ма? Болды
Dialogue: 0,0:16:58.35,0:17:00.39,Default,,0,0,0,,Сіз бұрын айтып отырған Риа-сан ба?
Dialogue: 0,0:17:00.60,0:17:02.48,Default,,0,0,0,,Әйел кеткенде
Dialogue: 0,0:17:02.60,0:17:04.64,Default,,0,0,0,,Сейка-чан қанша таза болса да,
Dialogue: 0,0:17:04.77,0:17:06.90,Default,,0,0,0,,Мені жек көресің бе деп ойлаймын!
Dialogue: 0,0:17:07.31,0:17:10.90,Default,,0,0,0,,Таза ақ орамалым қара бояса да
Dialogue: 0,0:17:11.36,0:17:16.66,Default,,0,0,0,,Шигеру-кун Сейка-чанға жетекшілік ететін құдай бола ма?
Dialogue: 0,0:17:17.57,0:17:19.41,Default,,0,0,0,,Қосымша бірдеңе жасап көріңіз.
Dialogue: 0,0:17:20.28,0:17:23.37,Default,,0,0,0,,Құдайдан жоғары болсаң да...
Dialogue: 0,0:17:23.50,0:17:24.41,Default,,0,0,0,,Шигеру-сан
Dialogue: 0,0:17:24.62,0:17:27.54,Default,,0,0,0,,Иә! Сейка-сан, бұл...
Dialogue: 0,0:17:27.67,0:17:29.54,Default,,0,0,0,,Ал Карина ше?
Dialogue: 0,0:17:29.67,0:17:30.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:38.22,0:17:41.68,Default,,0,0,0,,Кеше сен маған қамқор болғаның үшін, мен саған аз да болса алғыс айтуым керек.
Dialogue: 0,0:17:41.81,0:17:44.98,Default,,0,0,0,,Иә! Рахмет айт!
Dialogue: 0,0:17:46.23,0:17:47.23,Default,,0,0,0,,Олай болса
Dialogue: 0,0:17:47.65,0:17:50.48,Default,,0,0,0,,Жазба парағы мен фондық тексеру нәтижелеріне негізделген
Dialogue: 0,0:17:50.65,0:17:53.73,Default,,0,0,0,,Толық уақытты қызметкер ретінде кімді барлау керектігін таңдайық.
Dialogue: 0,0:17:54.65,0:17:55.74,Default,,0,0,0,,Әй!
Dialogue: 0,0:17:56.15,0:17:57.49,Default,,0,0,0,,Лия!
Dialogue: 0,0:17:57.70,0:18:01.78,Default,,0,0,0,,Мен қазір жиналыстамын, сәл күте аласыз ба?
Dialogue: 0,0:18:02.45,0:18:04.75,Default,,0,0,0,,Мұның қажеті жоқ.
Dialogue: 0,0:18:04.91,0:18:07.29,Default,,0,0,0,,Біз сіздің жазбаңызды қабылдамаймыз.
Dialogue: 0,0:18:07.46,0:18:08.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:08.87,0:18:12.38,Default,,0,0,0,,Мен бұл компания үшін дұрыс адам емеспін.
Dialogue: 0,0:18:12.50,0:18:14.76,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:18:15.21,0:18:19.30,Default,,0,0,0,,<Бүгінгі күні құтқара алмаған бала үшін алаңдайсыз ба? ＞
Dialogue: 0,0:18:19.43,0:18:20.85,Default,,0,0,0,,Сейка-сан
Dialogue: 0,0:18:20.97,0:18:23.31,Default,,0,0,0,,Ю мырзаның әңгімесі есіңізде ме?
Dialogue: 0,0:18:23.64,0:18:25.52,Default,,0,0,0,,Иә, әрине.
Dialogue: 0,0:18:25.73,0:18:28.06,Default,,0,0,0,,Шындығында, У мырзаға жалған айып тағылды...
Dialogue: 0,0:18:28.19,0:18:30.10,Default,,0,0,0,,Жалған айып тағылды
Dialogue: 0,0:18:30.23,0:18:32.73,Default,,0,0,0,,Мені әлеуметтік өлтірді (Сейка) Ха!
Dialogue: 0,0:18:33.98,0:18:36.90,Default,,0,0,0,,<Бәрі біткен соң ғана білдім>
Dialogue: 0,0:18:37.70,0:18:41.91,Default,,0,0,0,,<Мырза. Ү мәртебеден, абыройдан айырылып, жоғалып кетті>
Dialogue: 0,0:18:42.70,0:18:45.54,Default,,0,0,0,,<Оқиғаны жан-жақты зерттегеннен кейін>
Dialogue: 0,0:18:45.66,0:18:48.41,Default,,0,0,0,,<Нағыз кінәлі пропорционалды емес қорғалды>
Dialogue: 0,0:18:49.29,0:18:51.96,Default,,0,0,0,,<Мен келісе алмадым>
Dialogue: 0,0:18:52.08,0:18:55.00,Default,,0,0,0,,<Соңында нағыз кінәліні табыңыз>
Dialogue: 0,0:18:55.17,0:18:55.96,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:59.38,0:19:03.93,Default,,0,0,0,,Мен дайындаған пышақпен мен орны толмас нәрсе жасадым...
Dialogue: 0,0:19:04.10,0:19:08.52,Default,,0,0,0,,<Na! Әйтеуір, ол Киоко Ширатори...>
Dialogue: 0,0:19:09.39,0:19:13.23,Default,,0,0,0,,Қылмыс жасағаннан кейін өміріңді тоқтатуға ниеттен
Dialogue: 0,0:19:13.48,0:19:17.28,Default,,0,0,0,,Сол кезде мен смартфонымның көгілдір экранына өсиетімді жаздым...
Dialogue: 0,0:19:18.15,0:19:21.11,Default,,0,0,0,,<"Мен енді лас әрекет жасағым келмейді">
Dialogue: 0,0:19:21.32,0:19:23.03,Default,,0,0,0,,<"Мен тамаша зұлым әйелмін">
Dialogue: 0,0:19:23.82,0:19:26.08,Default,,0,0,0,,«Ақымақ пен ақымақтарды алдау»
Dialogue: 0,0:19:26.29,0:19:28.08,Default,,0,0,0,,«Өзіңді әдепті ұста».
Dialogue: 0,0:19:28.83,0:19:30.79,Default,,0,0,0,,«Құдай бар ма?»
Dialogue: 0,0:19:30.96,0:19:32.96,Default,,0,0,0,,«Егер ол шынымен бар болса».
Dialogue: 0,0:19:33.13,0:19:37.96,Default,,0,0,0,,«Егер сен менің жүрегімді түсініп, кішкене болса да жанашырлық танытсаң».
Dialogue: 0,0:19:38.13,0:19:41.05,Default,,0,0,0,,«Өтінемін... маған көмектесіңізші».
Dialogue: 0,0:19:42.05,0:19:45.68,Default,,0,0,0,,«Кейде ақ боз атты ханзададай киіну керемет».
Dialogue: 0,0:19:45.97,0:19:49.06,Default,,0,0,0,,«Мені басқалардан қорғаңызшы».
Dialogue: 0,0:19:49.93,0:19:52.60,Default,,0,0,0,,Бұл менің ерекше жазбам
Dialogue: 0,0:19:52.77,0:19:55.31,Default,,0,0,0,,(жылайды)
Dialogue: 0,0:19:55.52,0:19:57.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:57.98,0:19:59.49,Default,,0,0,0,,Мен
Dialogue: 0,0:19:59.61,0:20:02.86,Default,,0,0,0,,Мен ешқашан кешірілмейтін күнә жасадым.
Dialogue: 0,0:20:03.53,0:20:07.58,Default,,0,0,0,,Сондықтан бұл дүниеде аз да болса күнәларымды өтегім келеді.
Dialogue: 0,0:20:07.70,0:20:09.79,Default,,0,0,0,,Мен солай ойладым
Dialogue: 0,0:20:10.16,0:20:12.33,Default,,0,0,0,,Ақырында мен сені құтқара алмадым
Dialogue: 0,0:20:13.08,0:20:14.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:20:14.13,0:20:15.71,Default,,0,0,0,,О, күте тұрыңыз!
Dialogue: 0,0:20:16.04,0:20:17.17,Default,,0,0,0,,(қабылдау дыбысы)
Dialogue: 0,0:20:20.30,0:20:24.05,Default,,0,0,0,,Мен сыртқы дүние туралы көп білмей өстім.
Dialogue: 0,0:20:24.39,0:20:28.26,Default,,0,0,0,,Бірақ мен мұнда келгеннен бері әртүрлі құндылықтарды білдім.
Dialogue: 0,0:20:28.39,0:20:29.47,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:20:29.64,0:20:34.27,Default,,0,0,0,,Маған дұрыс емес болып көрінсе де, сол адамға дұрыс болуы мүмкін.
Dialogue: 0,0:20:34.40,0:20:39.02,Default,,0,0,0,,Бұл керісінше емес, мм...
Dialogue: 0,0:20:39.15,0:20:42.07,Default,,0,0,0,,Не дұрыс, не бұрыс...
Dialogue: 0,0:20:42.24,0:20:43.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:43.28,0:20:44.20,Default,,0,0,0,,Иә
Dialogue: 0,0:20:45.70,0:20:46.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:47.12,0:20:49.99,Default,,0,0,0,,Дұрыс немесе бұрыс деген не?
Dialogue: 0,0:20:50.24,0:20:53.50,Default,,0,0,0,,Менде әлі жауап жоқ.
Dialogue: 0,0:20:53.79,0:20:54.62,Default,,0,0,0,,Бірақ
Dialogue: 0,0:20:55.79,0:20:58.96,Default,,0,0,0,,Лия басқалар үшін тұрды.
Dialogue: 0,0:20:59.21,0:21:00.88,Default,,0,0,0,,Ержүрек адам!
Dialogue: 0,0:21:02.63,0:21:04.38,Default,,0,0,0,,Лия мырза
Dialogue: 0,0:21:04.88,0:21:07.22,Default,,0,0,0,,Өтінемін, менімен дос бол!
Dialogue: 0,0:21:07.39,0:21:08.64,Default,,0,0,0,,Фуфу
Dialogue: 0,0:21:09.60,0:21:11.43,Default,,0,0,0,,Сейка-сан...
Dialogue: 0,0:21:13.10,0:21:14.14,Default,,0,0,0,,<Олай болса...>
Dialogue: 0,0:21:14.35,0:21:16.90,Default,,0,0,0,,Риа Кикунаға қатысты.
Dialogue: 0,0:21:17.27,0:21:21.36,Default,,0,0,0,,Қатты үніме қарамастан, мен тым шыдамды емеспін.
Dialogue: 0,0:21:21.53,0:21:24.40,Default,,0,0,0,,Сіз байсалдысыз ба? Сол әсер
Dialogue: 0,0:21:24.53,0:21:27.53,Default,,0,0,0,,Деңгейі жағынан дәл осындай адам қалайды.
Dialogue: 0,0:21:27.66,0:21:30.62,Default,,0,0,0,,Дегенмен, Лидс мырзаның баяндамасы...
Dialogue: 0,0:21:30.74,0:21:31.58,Default,,0,0,0,,Иә
Dialogue: 0,0:21:31.70,0:21:35.08,Default,,0,0,0,,Мен сіздің Орднунг Найзасымен байланысыңызға алаңдаймын.
Dialogue: 0,0:21:35.54,0:21:39.34,Default,,0,0,0,,Оның мақсаты құлдарды құтқару сияқты...
Dialogue: 0,0:21:39.50,0:21:40.59,Default,,0,0,0,,Лидс
Dialogue: 0,0:21:41.00,0:21:43.55,Default,,0,0,0,,Кикуна мырза құл балаға көмектесе алмады.
Dialogue: 0,0:21:43.67,0:21:45.30,Default,,0,0,0,,Сіз жылап жатқаныңызды айттыңыз.
Dialogue: 0,0:21:45.47,0:21:46.59,Default,,0,0,0,,Иә
Dialogue: 0,0:21:48.51,0:21:52.06,Default,,0,0,0,,Бұл оның жоқтау көз жасы.
Dialogue: 0,0:21:52.35,0:21:56.31,Default,,0,0,0,,Өзіңнен басқа біреу үшін төгілген көз жасы
Dialogue: 0,0:21:56.56,0:21:59.19,Default,,0,0,0,,Мен бұған сенемін
Dialogue: 0,0:21:59.44,0:22:00.69,Default,,0,0,0,,Иә
Dialogue: 0,0:22:01.07,0:22:04.78,Default,,0,0,0,,Риа Кикунаны біздің компанияға қарсы алайық!
Dialogue: 0,0:22:04.90,0:22:05.86,Default,,0,0,0,,Фу… (есіктің ашылған дыбысы)
Dialogue: 0,0:22:05.99,0:22:07.45,Default,,0,0,0,,Көмектесіңіз!
Dialogue: 0,0:22:07.74,0:22:09.37,Default,,0,0,0,,Үлкен әпке!
Dialogue: 0,0:22:10.28,0:22:13.24,Default,,0,0,0,,♪～
Dialogue: 0,0:23:35.74,0:23:38.70,Default,,0,0,0,,～♪
