Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:15.59,0:00:18.56,Default,,0,0,0,,♪～
Dialogue: 0,0:01:39.43,0:01:42.43,Default,,0,0,0,,～♪
Dialogue: 0,0:01:49.98,0:01:51.82,Default,,0,0,0,,Рея-сан
Dialogue: 0,0:01:52.94,0:01:55.19,Default,,0,0,0,,Сейка... сен
Dialogue: 0,0:01:55.53,0:01:56.95,Default,,0,0,0,,<Трансформацияға келгенде>
Dialogue: 0,0:01:57.07,0:01:59.70,Default,,0,0,0,,<Сэйджи-сан ғана емес, Сейка-сан да? ＞
Dialogue: 0,0:02:00.16,0:02:03.20,Default,,0,0,0,,Енді қиналмаңыз
Dialogue: 0,0:02:04.12,0:02:07.21,Default,,0,0,0,,U Маған жақындама! Сіз өлтіргіңіз келе ме?
Dialogue: 0,0:02:07.50,0:02:09.71,Default,,0,0,0,,Уф... Уф
Dialogue: 0,0:02:09.83,0:02:11.75,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:12.13,0:02:13.71,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:14.63,0:02:15.88,Default,,0,0,0,,Рея-сан
Dialogue: 0,0:02:16.01,0:02:19.13,Default,,0,0,0,,Мен мұны істегім келмейді.
Dialogue: 0,0:02:19.26,0:02:21.72,Default,,0,0,0,,Адамды қалай өлтіруге болады?
Dialogue: 0,0:02:22.01,0:02:23.89,Default,,0,0,0,,Қарғыс атсын.
Dialogue: 0,0:02:24.01,0:02:26.22,Default,,0,0,0,,Үйде...бірақ
Dialogue: 0,0:02:26.43,0:02:31.31,Default,,0,0,0,,Өзім жазған жазбаларым менің санамды бұзады!
Dialogue: 0,0:02:31.44,0:02:32.48,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:32.81,0:02:34.98,Default,,0,0,0,,«Біз әдемі әйелдерге төзбейміз»
Dialogue: 0,0:02:35.53,0:02:39.40,Default,,0,0,0,,«Ішегіңді жұлып алып, өлемін».
Dialogue: 0,0:02:39.53,0:02:41.28,Default,,0,0,0,,<Кедей әйел>
Dialogue: 0,0:02:41.45,0:02:44.70,Default,,0,0,0,,<Алайда, арнайы жазбаларды қайта жазу мүмкін емес>
Dialogue: 0,0:02:44.95,0:02:46.29,Default,,0,0,0,,Қалтамды ұстап көруге қалай батылың жетті—
Dialogue: 0,0:02:46.45,0:02:48.71,Default,,0,0,0,,Жол болуы керек
Dialogue: 0,0:02:48.83,0:02:51.29,Default,,0,0,0,,Мен оның не екенін білмеймін, бірақ
Dialogue: 0,0:02:52.38,0:02:54.38,Default,,0,0,0,,Мен де бұл туралы ойлаймын.
Dialogue: 0,0:02:54.50,0:02:55.34,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:02:56.17,0:02:58.38,Default,,0,0,0,,Уф, мен саған аулақ жүр дедім ғой!
Dialogue: 0,0:02:58.88,0:03:02.09,Default,,0,0,0,,Өтінемін, енді ренжімеңіз.
Dialogue: 0,0:03:13.15,0:03:17.07,Default,,0,0,0,,А, а... а
Dialogue: 0,0:03:19.07,0:03:22.41,Default,,0,0,0,,Ой... қолым... менікі.
Dialogue: 0,0:03:23.32,0:03:25.87,Default,,0,0,0,,Ааа...
Dialogue: 0,0:03:25.99,0:03:26.91,Default,,0,0,0,,<Бұл ғажайып...>
Dialogue: 0,0:03:27.49,0:03:32.50,Default,,0,0,0,,<Абсолюттік құдайдың құдіреті де ақауды емдей алмайды>
Dialogue: 0,0:03:32.87,0:03:33.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:33.75,0:03:34.92,Default,,0,0,0,,Мен
Dialogue: 0,0:03:35.29,0:03:38.09,Default,,0,0,0,,Арнайы жазбалар бөліміне өтініш жаздым.
Dialogue: 0,0:03:38.30,0:03:39.84,Default,,0,0,0,,«Егер дос болса...»
Dialogue: 0,0:03:39.97,0:03:42.22,Default,,0,0,0,,«Егер сені шын жүректен ренжітсең»
Dialogue: 0,0:03:42.38,0:03:45.60,Default,,0,0,0,,«Мен періште болып, сені емдегім келеді».
Dialogue: 0,0:03:46.26,0:03:49.52,Default,,0,0,0,,«Мен жоғалтқанымды қайтарғым келеді»
Dialogue: 0,0:03:50.77,0:03:52.23,Default,,0,0,0,,Достар…
Dialogue: 0,0:03:52.85,0:03:57.02,Default,,0,0,0,,Реинкарнацияға дейін менің бетімде үлкен тыртық болды.
Dialogue: 0,0:03:57.23,0:03:59.53,Default,,0,0,0,,Ол да бір көзінен айырылды.
Dialogue: 0,0:03:59.99,0:04:02.45,Default,,0,0,0,,<Болу керек нәрсеге ие болмаудың азабы>
Dialogue: 0,0:04:02.57,0:04:03.66,Default,,0,0,0,,<Тек осы ғана>
Dialogue: 0,0:04:04.11,0:04:06.20,Default,,0,0,0,,Мен оны жойғым келеді.
Dialogue: 0,0:04:06.32,0:04:09.66,Default,,0,0,0,,<Сейка-сан, аяқ-қолдардан басқа да көп нәрсе бар...>
Dialogue: 0,0:04:10.29,0:04:11.46,Default,,0,0,0,,Қол...
Dialogue: 0,0:04:11.66,0:04:16.17,Default,,0,0,0,,Денеңізді емдеу арқылы сіз эмоционалды жараларды емдей алмайсыз.
Dialogue: 0,0:04:16.29,0:04:19.46,Default,,0,0,0,,Шешімін табатынымызға сенімдімін.
Dialogue: 0,0:04:19.63,0:04:23.47,Default,,0,0,0,,Сондықтан... берілме, Рейа-сан.
Dialogue: 0,0:04:23.59,0:04:25.05,Default,,0,0,0,,Келме, шіркін!
Dialogue: 0,0:04:25.39,0:04:26.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:27.60,0:04:31.64,Default,,0,0,0,,Хаха... хахаха... шіркін...
Dialogue: 0,0:04:31.77,0:04:33.27,Default,,0,0,0,,Иә, шіркін.
Dialogue: 0,0:04:33.56,0:04:35.10,Default,,0,0,0,,Осы сияқты қарапайым нәрсе
Dialogue: 0,0:04:35.27,0:04:37.19,Default,,0,0,0,,Рейа-сан? (Рейа) Достарыңды алдама!
Dialogue: 0,0:04:37.65,0:04:40.57,Default,,0,0,0,,Жылап тұрған түрің шіркін.
Dialogue: 0,0:04:41.07,0:04:45.11,Default,,0,0,0,,Сен менің мақсатымнан басқашасың.
Dialogue: 0,0:04:45.61,0:04:46.62,Default,,0,0,0,,<О...>
Dialogue: 0,0:04:47.32,0:04:49.12,Default,,0,0,0,,Хмм (Сейка) Ах...
Dialogue: 0,0:04:54.29,0:04:55.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:57.08,0:04:59.84,Default,,0,0,0,,<Өтірік, мен сұрадым>
Dialogue: 0,0:05:02.88,0:05:03.67,Default,,0,0,0,,Ой
Dialogue: 0,0:05:08.22,0:05:09.89,Default,,0,0,0,,<Бұл қорқынышты болуы керек>
Dialogue: 0,0:05:10.68,0:05:14.35,Default,,0,0,0,,<Жақсы жұмыс, Сейка-сан>
Dialogue: 0,0:05:15.94,0:05:20.86,Default,,0,0,0,,(Рейаның ауыр тыныс алуы)
Dialogue: 0,0:05:21.36,0:05:23.40,Default,,0,0,0,,Хахаха
Dialogue: 0,0:05:23.74,0:05:25.90,Default,,0,0,0,,Хаха...
Dialogue: 0,0:05:28.41,0:05:29.41,Default,,0,0,0,,Иә...
Dialogue: 0,0:05:32.54,0:05:36.79,Default,,0,0,0,,(дірілдеп тыныс алу)
Dialogue: 0,0:05:37.00,0:05:38.58,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:05:41.38,0:05:42.30,Default,,0,0,0,,Иә! (қылыш тарс еткен дыбыс)
Dialogue: 0,0:05:47.43,0:05:50.26,Default,,0,0,0,,Не, сен мені өлтіруге келдің бе?
Dialogue: 0,0:05:50.51,0:05:52.31,Default,,0,0,0,,Нашар тыңдаушы
Dialogue: 0,0:05:52.56,0:05:56.77,Default,,0,0,0,,Мен жаңа ғана Лидстен сіздің қайда екеніңізді естідім және сізді тексеруге келдім.
Dialogue: 0,0:05:56.94,0:05:59.02,Default,,0,0,0,,Сенің өз көзің бар ма?
Dialogue: 0,0:05:59.40,0:06:02.90,Default,,0,0,0,,Түсіндім, басқа жолы бар ма?
Dialogue: 0,0:06:03.15,0:06:07.49,Default,,0,0,0,,Қандай идея болса да, мен денені ауыртатын нәрсені қабылдай алмаймын.
Dialogue: 0,0:06:07.61,0:06:09.91,Default,,0,0,0,,Сейка-санның да қайғылы болатыны сөзсіз.
Dialogue: 0,0:06:10.03,0:06:11.28,Default,,0,0,0,,Хмм…
Dialogue: 0,0:06:11.45,0:06:15.41,Default,,0,0,0,,Мен қатты шаршадым, мен сені тезірек сиқылауым керек еді.
Dialogue: 0,0:06:15.54,0:06:16.33,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:16.71,0:06:19.71,Default,,0,0,0,,Әй, сен неге менімен сауда жасамайсың?
Dialogue: 0,0:06:19.83,0:06:20.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:21.00,0:06:24.63,Default,,0,0,0,,Мен саған қалағаныңды бере алмаймын.
Dialogue: 0,0:06:24.84,0:06:26.01,Default,,0,0,0,,Транзакциялар…
Dialogue: 0,0:06:26.13,0:06:29.38,Default,,0,0,0,,Өнім тек көруді жою әдісі болып табылады.
Dialogue: 0,0:06:29.55,0:06:32.55,Default,,0,0,0,,Иә? Бұл ыңғайлы...
Dialogue: 0,0:06:32.72,0:06:33.60,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:35.52,0:06:37.43,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:06:37.60,0:06:41.98,Default,,0,0,0,,«Бес саусақты жер асты әлемінің итбалығы» ең жоғары деңгейдегі қараңғы атрибут шеберлігі
Dialogue: 0,0:06:42.15,0:06:46.03,Default,,0,0,0,,Ол бес сезімнің кез келгенін қараңғыда мөрлей алатын қорқынышты жігіт.
Dialogue: 0,0:06:46.19,0:06:49.36,Default,,0,0,0,,Бұл мен ғана дайындай алатын өнім.
Dialogue: 0,0:06:49.61,0:06:52.87,Default,,0,0,0,,Бұл сіздің көзқарасыңызды бекітеді.
Dialogue: 0,0:06:53.07,0:06:55.99,Default,,0,0,0,,Оның орнына сіз күшті өмір сүруіңіз керек.
Dialogue: 0,0:06:56.37,0:06:58.87,Default,,0,0,0,,Сен қандайсың?
Dialogue: 0,0:06:59.29,0:07:01.00,Default,,0,0,0,,Жай ғана сатушы
Dialogue: 0,0:07:01.12,0:07:03.34,Default,,0,0,0,,Өкінішке орай, менде визиткалар бітті.
Dialogue: 0,0:07:03.46,0:07:06.96,Default,,0,0,0,,Бұл балық! Олар үлкен көшірме машиналарын сататын сияқты.
Dialogue: 0,0:07:07.17,0:07:08.88,Default,,0,0,0,,<Бұл өткір...>
Dialogue: 0,0:07:09.67,0:07:12.39,Default,,0,0,0,,Мұны саған Сейка-сан айтты.
Dialogue: 0,0:07:12.51,0:07:15.64,Default,,0,0,0,,«Мені енді ренжітпе»
Dialogue: 0,0:07:16.01,0:07:19.43,Default,,0,0,0,,Міне, біз сізге дайындадық!
Dialogue: 0,0:07:19.64,0:07:23.19,Default,,0,0,0,,Бұл көзге зақым келтірмей көруді тежейтін дағды.
Dialogue: 0,0:07:23.31,0:07:24.27,Default,,0,0,0,,Бұл пошталық тапсырыс бағдарламасы ма?
Dialogue: 0,0:07:24.40,0:07:26.40,Default,,0,0,0,,<Сенің цуккомиң де өткір екен, солай емес пе?>
Dialogue: 0,0:07:26.61,0:07:29.69,Default,,0,0,0,,Бұл оны іскерлік келіссөзге айналдыратын сатушылардың дастаны.
Dialogue: 0,0:07:30.53,0:07:36.08,Default,,0,0,0,,Енді бұл өнімнің жарамдылық мерзімі жеңіл дағдымен өтелмейінше.
Dialogue: 0,0:07:36.24,0:07:39.20,Default,,0,0,0,,Сіз қалай ойлайсыз? Мен сапасына сенімдімін
Dialogue: 0,0:07:39.33,0:07:40.54,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:41.00,0:07:43.63,Default,,0,0,0,,Менен бір нәрсе сұрай аласыз ба?
Dialogue: 0,0:07:43.75,0:07:47.30,Default,,0,0,0,,Неліктен сіз бұл баланы қорғауға тырысасыз?
Dialogue: 0,0:07:47.42,0:07:49.88,Default,,0,0,0,,Ол әдемі болғандықтан ба?
Dialogue: 0,0:07:50.05,0:07:51.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:52.38,0:07:55.76,Default,,0,0,0,,Негізі, мен де арнайы жазбалармен қателесіппін.
Dialogue: 0,0:07:55.93,0:07:56.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:57.01,0:08:01.69,Default,,0,0,0,,Бастапқыда мен бұл партияға сене алмай, кетуді жоспарладым.
Dialogue: 0,0:08:02.35,0:08:05.11,Default,,0,0,0,,<But Seika-san doesn't care>
Dialogue: 0,0:08:05.23,0:08:07.65,Default,,0,0,0,,<Мен саған жазықсыз мейірімділік ұсындым>
Dialogue: 0,0:08:08.48,0:08:11.40,Default,,0,0,0,,<Мен сол қарызды өтеу үстіндемін>
Dialogue: 0,0:08:11.57,0:08:14.28,Default,,0,0,0,,<Оған бірдеңе болып қалса, бұл проблема болар еді>
Dialogue: 0,0:08:14.41,0:08:17.66,Default,,0,0,0,,<He's very loyal, and he's good-looking.>
Dialogue: 0,0:08:17.83,0:08:18.79,Default,,0,0,0,,<Only the voice burns>
Dialogue: 0,0:08:18.91,0:08:20.70,Default,,0,0,0,,<Бұл шулы>
Dialogue: 0,0:08:20.83,0:08:23.12,Default,,0,0,0,,Мен Сейканы қызғанамын
Dialogue: 0,0:08:23.37,0:08:27.17,Default,,0,0,0,,I wish we had friends like you too.
Dialogue: 0,0:08:27.38,0:08:28.71,Default,,0,0,0,,<You finally laughed>
Dialogue: 0,0:08:29.71,0:08:32.51,Default,,0,0,0,,Do you want to accompany our party?
Dialogue: 0,0:08:32.67,0:08:35.22,Default,,0,0,0,,If it's Seiji-san... (Reia) I'll refrain.
Dialogue: 0,0:08:36.93,0:08:39.47,Default,,0,0,0,,Our hands are already too dirty.
Dialogue: 0,0:08:39.60,0:08:42.52,Default,,0,0,0,,Өз жолыңызды табыңыз
Dialogue: 0,0:08:42.89,0:08:47.44,Default,,0,0,0,,Now, use that skill to seal my eyesight.
Dialogue: 0,0:08:47.65,0:08:48.98,Default,,0,0,0,,Ah (sound of standing up)
Dialogue: 0,0:08:50.15,0:08:52.78,Default,,0,0,0,,Мәміле жасалды.
Dialogue: 0,0:09:04.66,0:09:05.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:07.38,0:09:08.67,Default,,0,0,0,,Сіз ояндыңыз ба?
Dialogue: 0,0:09:10.25,0:09:11.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:12.96,0:09:16.05,Default,,0,0,0,,Мен мұны істедім бе?
Dialogue: 0,0:09:16.18,0:09:19.51,Default,,0,0,0,,Бұл Сейка-санның «өтінішінен» туған күш.
Dialogue: 0,0:09:20.56,0:09:24.52,Default,,0,0,0,,Менде мұндай күш бар деп ешқашан ойламаппын...
Dialogue: 0,0:09:25.69,0:09:27.73,Default,,0,0,0,,Шигеру-сан И
Dialogue: 0,0:09:27.85,0:09:31.02,Default,,0,0,0,,Мен бұл күшімді көптеген адамдарға көмектесу үшін пайдаланғым келеді.
Dialogue: 0,0:09:31.19,0:09:32.36,Default,,0,0,0,,Сейка-сан
Dialogue: 0,0:09:32.48,0:09:33.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:33.69,0:09:36.86,Default,,0,0,0,,Let's keep this Пауэр a secret.
Dialogue: 0,0:09:36.99,0:09:39.07,Default,,0,0,0,,Неге?
Dialogue: 0,0:09:39.20,0:09:42.24,Default,,0,0,0,,Because that Пауэр is valuable.
Dialogue: 0,0:09:42.37,0:09:43.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:43.29,0:09:46.54,Default,,0,0,0,,Құндылығы бар болса да, оны пайдалану керек емес пе?
Dialogue: 0,0:09:46.83,0:09:48.46,Default,,0,0,0,,Let me tell you an example.
Dialogue: 0,0:09:48.58,0:09:51.84,Default,,0,0,0,,What does the thief in the story steal?
Dialogue: 0,0:09:52.05,0:09:53.25,Default,,0,0,0,,Қазына!
Dialogue: 0,0:09:53.38,0:09:56.80,Default,,0,0,0,,Сонда неге қазынаны ұрлау керек?
Dialogue: 0,0:09:57.59,0:09:59.30,Default,,0,0,0,,Ах... Ах!
Dialogue: 0,0:09:59.64,0:10:02.72,Default,,0,0,0,,Иә, өйткені ол құнды.
Dialogue: 0,0:10:02.89,0:10:06.81,Default,,0,0,0,,Бұл әлемде көптеген жаман адамдар мен қауіпті адамдар бар.
Dialogue: 0,0:10:07.35,0:10:09.69,Default,,0,0,0,,Бұл сіздің 17 жаста екеніңізді білдіреді
Dialogue: 0,0:10:09.81,0:10:12.44,Default,,0,0,0,,Мен мұны жасым қонымды болғандықтан айтып отырмын.
Dialogue: 0,0:10:12.57,0:10:13.57,Default,,0,0,0,,♪ Вуф-вуф, вуф-вуф
Dialogue: 0,0:10:14.07,0:10:15.57,Default,,0,0,0,,Иә
Dialogue: 0,0:10:15.82,0:10:17.86,Default,,0,0,0,,Сіз әдемі адамсыз
Dialogue: 0,0:10:17.99,0:10:20.66,Default,,0,0,0,,Е, бұл...
Dialogue: 0,0:10:20.82,0:10:25.12,Default,,0,0,0,,Рейа мені өлтірмек болды, бұл дәлел.
Dialogue: 0,0:10:25.25,0:10:28.87,Default,,0,0,0,,Әдемі ғана емес, зор күшке ие қазына.
Dialogue: 0,0:10:29.04,0:10:31.25,Default,,0,0,0,,Жаман жігіттер оны жіберіп алмайды
Dialogue: 0,0:10:31.38,0:10:36.42,Default,,0,0,0,,Сіз өзіңіздің асыл құндылықтарыңызды зұлым адамдар жойғанын қаламайсыз, солай емес пе?
Dialogue: 0,0:10:36.55,0:10:37.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:38.80,0:10:41.09,Default,,0,0,0,,Бірақ мен не істеуім керек...
Dialogue: 0,0:10:41.26,0:10:44.60,Default,,0,0,0,,Мен бәріне күмәндану керек деп айтпаймын.
Dialogue: 0,0:10:44.93,0:10:47.14,Default,,0,0,0,,Мен сенің қарсыласыңды бағалағаныңды қалаймын.
Dialogue: 0,0:10:47.31,0:10:50.10,Default,,0,0,0,,Адам сенімді ме?
Dialogue: 0,0:10:50.23,0:10:51.81,Default,,0,0,0,,Қой ма?
Dialogue: 0,0:10:51.98,0:10:53.57,Default,,0,0,0,,Бұл қасқыр ма?
Dialogue: 0,0:10:53.77,0:10:54.61,Default,,0,0,0,,Фу…
Dialogue: 0,0:10:55.48,0:10:58.11,Default,,0,0,0,,Ах... Жарайды!
Dialogue: 0,0:10:58.36,0:11:01.32,Default,,0,0,0,,Өткір тістердің бар-жоғын тексеріңіз!
Dialogue: 0,0:11:01.61,0:11:03.74,Default,,0,0,0,,Бірақ егер
Dialogue: 0,0:11:04.78,0:11:07.62,Default,,0,0,0,,Ал егер Сейка-сан?
Dialogue: 0,0:11:07.91,0:11:11.75,Default,,0,0,0,,Қанша сақ болсаң да, Қорқынышты жағдайға тап болсаң
Dialogue: 0,0:11:11.92,0:11:15.13,Default,,0,0,0,,Сол кезде маған дауыстап қоңырау шалыңыз.
Dialogue: 0,0:11:15.50,0:11:18.63,Default,,0,0,0,,Біз сізге кез келген уақытта, кез келген жерде асығамыз.
Dialogue: 0,0:11:18.76,0:11:23.01,Default,,0,0,0,,Сондықтан сәл сәтсіздікке ұшырасаңыз, жақсы.
Dialogue: 0,0:11:23.14,0:11:24.85,Default,,0,0,0,,Шигеру-сан...
Dialogue: 0,0:11:25.22,0:11:28.10,Default,,0,0,0,,Иә, рахмет!
Dialogue: 0,0:11:28.22,0:11:29.52,Default,,0,0,0,,Фу…
Dialogue: 0,0:11:29.81,0:11:30.89,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:11:31.98,0:11:36.19,Default,,0,0,0,,Осындай кезде қол алысу керек!
Dialogue: 0,0:11:36.77,0:11:37.65,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:39.57,0:11:40.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:40.90,0:11:41.95,Default,,0,0,0,,Хехе
Dialogue: 0,0:11:44.28,0:11:45.91,Default,,0,0,0,,<Тым көп ауырсыну>
Dialogue: 0,0:11:46.03,0:11:48.70,Default,,0,0,0,,<Мен оның қолының жылуын да сезе алмаймын>
Dialogue: 0,0:11:48.83,0:11:49.91,Default,,0,0,0,,<Тек...>
Dialogue: 0,0:11:50.96,0:11:55.54,Default,,0,0,0,,<Сәл дірілдеген алақанымды қыспауға тырысуым керек>
Dialogue: 0,0:11:55.71,0:11:57.75,Default,,0,0,0,,<Бұл менің қолымнан келгеннің жақсысы болды>
Dialogue: 0,0:12:00.17,0:12:02.18,Default,,0,0,0,,Сосын, Рейа-сан...
Dialogue: 0,0:12:02.34,0:12:05.76,Default,,0,0,0,,Иә, мен кеше түнде тұрдым.
Dialogue: 0,0:12:05.89,0:12:08.68,Default,,0,0,0,,Мен бұл сөздерді Сейка-санға айттым.
Dialogue: 0,0:12:09.35,0:12:12.52,Default,,0,0,0,,«Менің сезім жараларымды емдегеніңіз үшін рахмет».
Dialogue: 0,0:12:12.69,0:12:16.15,Default,,0,0,0,,«Егер мен сені бір күні кездестірсем, мен саған көмектесе аламын».
Dialogue: 0,0:12:17.02,0:12:18.86,Default,,0,0,0,,Рея-сан...
Dialogue: 0,0:12:19.07,0:12:19.94,Default,,0,0,0,,Әй
Dialogue: 0,0:12:20.74,0:12:23.99,Default,,0,0,0,,Мен сені тым болмаса шығарып салғым келді.
Dialogue: 0,0:12:24.11,0:12:26.32,Default,,0,0,0,,<Кешіріңіз, бұл менің кінәм>
Dialogue: 0,0:12:26.45,0:12:30.95,Default,,0,0,0,,Жарайды, ол жайдары жүзбен шығып кетті.
Dialogue: 0,0:12:31.20,0:12:34.46,Default,,0,0,0,,<Мен «жол» немесе бір нәрсе табамын...>
Dialogue: 0,0:12:34.79,0:12:36.42,Default,,0,0,0,,Сәлем Сейка-сан
Dialogue: 0,0:12:36.54,0:12:38.42,Default,,0,0,0,,Иә? Не айтқың келеді? (Сейка) А...
Dialogue: 0,0:12:40.55,0:12:41.71,Default,,0,0,0,,Фу…
Dialogue: 0,0:12:42.13,0:12:44.72,Default,,0,0,0,,Қыздар арасындағы құпия.
Dialogue: 0,0:12:47.14,0:12:49.85,Default,,0,0,0,,Валерия княздігі қандай жер?
Dialogue: 0,0:12:49.97,0:12:51.72,Default,,0,0,0,,Бұл әдемі қала болуы керек, солай емес пе?
Dialogue: 0,0:12:51.85,0:12:54.19,Default,,0,0,0,,Иә, мен оны асыға күтемін.
Dialogue: 0,0:12:54.56,0:12:56.69,Default,,0,0,0,,Ілгекті тым көп босатпау үшін абай болыңыз
Dialogue: 0,0:12:56.81,0:12:58.27,Default,,0,0,0,,Иә, абай боламын
Dialogue: 0,0:12:58.40,0:13:00.57,Default,,0,0,0,,Бұрынғы гамбургер ең жақсысы болатын.
Dialogue: 0,0:13:00.69,0:13:02.78,Default,,0,0,0,,Мен гамбургерді де жақсы көремін.
Dialogue: 0,0:13:02.90,0:13:04.86,Default,,0,0,0,,Қуатымызды дамытайық (Сейка) Иә!
Dialogue: 0,0:13:04.99,0:13:07.66,Default,,0,0,0,,Мен қазір кез келген гамбургерді жей алатындай сезінемін.
Dialogue: 0,0:13:07.82,0:13:09.70,Default,,0,0,0,,Рея осылай жасады...
Dialogue: 0,0:13:09.83,0:13:10.70,Default,,0,0,0,,О
Dialogue: 0,0:13:10.83,0:13:14.37,Default,,0,0,0,,Ең болмаса ол енді Сейка-санға шабуыл жасамайды.
Dialogue: 0,0:13:14.50,0:13:16.46,Default,,0,0,0,,Сонда да мен таң қалдым.
Dialogue: 0,0:13:16.92,0:13:20.21,Default,,0,0,0,,Мен Сейка-санның соншалықты керемет көрінетініне сене алар емеспін.
Dialogue: 0,0:13:20.38,0:13:23.84,Default,,0,0,0,,Бірақ сіз адамдардың терезелерін оқи білуіңіз керек, солай ма?
Dialogue: 0,0:13:23.97,0:13:25.01,Default,,0,0,0,,Иә
Dialogue: 0,0:13:25.13,0:13:30.18,Default,,0,0,0,,Алайда, Сейка-санның арнайы жазбаларында трансформацияның нақты сипаттамасы жоқ...
Dialogue: 0,0:13:30.30,0:13:31.93,Default,,0,0,0,,«Сейка-сандікі»?
Dialogue: 0,0:13:32.14,0:13:35.18,Default,,0,0,0,,Сонымен Сейджи-санның ерекше жазбалары...
Dialogue: 0,0:13:35.31,0:13:37.27,Default,,0,0,0,,Ах... иә...
Dialogue: 0,0:13:38.19,0:13:42.32,Default,,0,0,0,,Бұл өте мұқият түрлендіру процесі...
Dialogue: 0,0:13:42.53,0:13:44.44,Default,,0,0,0,,<Сен оны қатты жек көрмейсің бе? ＞
Dialogue: 0,0:13:44.57,0:13:48.24,Default,,0,0,0,,<Chunibyou Full Throttle мазмұны қандай...>
Dialogue: 0,0:13:48.57,0:13:51.95,Default,,0,0,0,,Мүмкін болса, арнайы жазбалардың толық мәтінін білгім келеді...
Dialogue: 0,0:13:52.08,0:13:53.24,Default,,0,0,0,,Уф!
Dialogue: 0,0:13:53.41,0:13:55.37,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:13:55.50,0:13:58.54,Default,,0,0,0,,<Мұндай үмітсіздікті көрсетпе>
Dialogue: 0,0:13:58.67,0:14:00.75,Default,,0,0,0,,Мен өзімнің әлсіз тұстарымды білгім келеді.
Dialogue: 0,0:14:01.42,0:14:03.34,Default,,0,0,0,,Әлсіздік?
Dialogue: 0,0:14:03.46,0:14:06.51,Default,,0,0,0,,Иә Арнайы жазбаларда жасырылған әлсіздік
Dialogue: 0,0:14:06.92,0:14:10.14,Default,,0,0,0,,<Арнайы ескертпелер күшті артықшылықтарға ие>
Dialogue: 0,0:14:10.26,0:14:13.01,Default,,0,0,0,,<Екінші жағынан, кемшіліктер де орасан зор>
Dialogue: 0,0:14:14.64,0:14:16.02,Default,,0,0,0,,Шынайы сезімдері мен нағыз болмысын жасырып
Dialogue: 0,0:14:16.56,0:14:18.90,Default,,0,0,0,,Оны қалай болса да қағазға түсіріңіз
Dialogue: 0,0:14:19.06,0:14:23.19,Default,,0,0,0,,Сөйлемді аяқтауым үшін дұға етіңіз.
Dialogue: 0,0:14:23.36,0:14:25.28,Default,,0,0,0,,<Менің көзім өлді>
Dialogue: 0,0:14:25.57,0:14:28.28,Default,,0,0,0,,Бұл бірден болуы шарт емес.
Dialogue: 0,0:14:28.57,0:14:32.16,Default,,0,0,0,,Шамамен Сейджи сапарының мақсатын өзі шешті.
Dialogue: 0,0:14:32.28,0:14:34.29,Default,,0,0,0,,Мақсат дегенді қалай түсінесіңдер?
Dialogue: 0,0:14:34.70,0:14:37.29,Default,,0,0,0,,Сэйджи-сан мұны маған бұрын да айтқан.
Dialogue: 0,0:14:37.75,0:14:41.54,Default,,0,0,0,,Қосымша ақпарат пен опцияларды алу үшін қалалық жерлерге барғым келеді
Dialogue: 0,0:14:41.96,0:14:45.80,Default,,0,0,0,,Сонда сіз не істеу керектігін түсінесіз.
Dialogue: 0,0:14:46.63,0:14:50.30,Default,,0,0,0,,Сондықтан мен бұл туралы өзінше ойладым.
Dialogue: 0,0:14:51.09,0:14:52.43,Default,,0,0,0,,Сейджи мырза...
Dialogue: 0,0:14:52.55,0:14:55.31,Default,,0,0,0,,Ол бір күні патша болуы керек
Dialogue: 0,0:14:55.60,0:14:56.43,Default,,0,0,0,,Ха!
Dialogue: 0,0:14:56.56,0:14:58.56,Default,,0,0,0,,Киоширо осылай деді.
Dialogue: 0,0:14:58.73,0:15:03.02,Default,,0,0,0,,<Менің әріптесім жалдамалыдан патшаға айналды>
Dialogue: 0,0:15:03.15,0:15:04.02,Default,,0,0,0,,<Басқаша айтқанда>
Dialogue: 0,0:15:04.15,0:15:08.65,Default,,0,0,0,,Егер бұл дұрыс жауап болса, тіпті реинкарнацияланған адамдар таққа жетуі мүмкін.
Dialogue: 0,0:15:08.78,0:15:10.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:10.20,0:15:14.53,Default,,0,0,0,,Сейка-сан мен Сейдзи-сан, бұл екеуі таза ақ адамдар.
Dialogue: 0,0:15:15.03,0:15:18.25,Default,,0,0,0,,<Сейка-сан - ештеңе білмейтін бейкүнә ақ адам>
Dialogue: 0,0:15:18.41,0:15:22.71,Default,,0,0,0,,<Сейджи ауыр мұнай теңізіндей үлкендердің қара қоғамын біледі>
Dialogue: 0,0:15:22.83,0:15:25.59,Default,,0,0,0,,<Ақ болып қала беретін жарықтың ақтығы>
Dialogue: 0,0:15:26.34,0:15:29.72,Default,,0,0,0,,<Осындай Сейджи патша болып, елді басқаратын болса>
Dialogue: 0,0:15:29.88,0:15:33.93,Default,,0,0,0,,<Менің ойымша, Сейка-сан сияқты адамдар бейбіт өмір сүре алады.>
Dialogue: 0,0:15:34.68,0:15:37.14,Default,,0,0,0,,Осылай ойлаңыз
Dialogue: 0,0:15:37.31,0:15:40.18,Default,,0,0,0,,Шигеру-сан патша болса жарайды ма?
Dialogue: 0,0:15:40.35,0:15:43.31,Default,,0,0,0,,Мен? Бұл гала емес
Dialogue: 0,0:15:43.48,0:15:47.53,Default,,0,0,0,,Егер депозит мөлшерлемесі 1/10 000 болса, ел өте кедей болады.
Dialogue: 0,0:15:47.69,0:15:48.61,Default,,0,0,0,,Ах
Dialogue: 0,0:15:48.86,0:15:53.24,Default,,0,0,0,,Сэйджи – адамды тәрбиелеп, одан биік тұратын адам.
Dialogue: 0,0:15:53.36,0:15:57.12,Default,,0,0,0,,Сіз басқа адамға сеніп, оны оған қалдыра аласыз.
Dialogue: 0,0:15:57.24,0:16:01.37,Default,,0,0,0,,Мен болсам, бәрін өзім шешер едім...
Dialogue: 0,0:16:01.54,0:16:06.09,Default,,0,0,0,,Сондықтан мен Сейджидің патша болғанын қалаймын.
Dialogue: 0,0:16:06.21,0:16:07.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:08.25,0:16:09.13,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:10.26,0:16:11.88,Default,,0,0,0,,Шигеру-сан
Dialogue: 0,0:16:12.01,0:16:14.93,Default,,0,0,0,,Макото-чан, менің ағам.
Dialogue: 0,0:16:15.09,0:16:17.64,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:16:20.89,0:16:22.10,Default,,0,0,0,,О
Dialogue: 0,0:16:22.44,0:16:24.73,Default,,0,0,0,,Бірге жұмыс жасайық
Dialogue: 0,0:16:27.82,0:16:29.36,Default,,0,0,0,,<Сондықтан>
Dialogue: 0,0:16:29.48,0:16:32.65,Default,,0,0,0,,<Біз жасырын түрде мақсат қойдық>
Dialogue: 0,0:16:33.11,0:16:35.99,Default,,0,0,0,,<Ең алдымен деңгейді қатты көтерейік>
Dialogue: 0,0:16:36.16,0:16:39.12,Default,,0,0,0,,<Менің қолдауыммен оңай болуы керек...>
Dialogue: 0,0:16:39.29,0:16:41.91,Default,,0,0,0,,Жақында сіз қаланы көре аласыз.
Dialogue: 0,0:16:42.04,0:16:43.41,Default,,0,0,0,,Егер сіз осы жерден өтсеңіз
Dialogue: 0,0:16:46.71,0:16:49.05,Default,,0,0,0,,<Иә, бұл топтарға арналған ақпарат>
Dialogue: 0,0:16:49.17,0:16:51.38,Default,,0,0,0,,<Бұл тәжірибе ұпайларын жинаудың жақсы жолы>
Dialogue: 0,0:16:51.51,0:16:53.93,Default,,0,0,0,,Әлсіз жеріңізді бұзыңыз! Жүгір!
Dialogue: 0,0:16:54.18,0:16:56.14,Default,,0,0,0,,Иә! Хмм
Dialogue: 0,0:16:56.93,0:16:57.85,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:16:58.01,0:16:59.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:00.31,0:17:02.93,Default,,0,0,0,,Ой... аяқ киімімнің бауы шешіліп қалды!
Dialogue: 0,0:17:03.31,0:17:04.64,Default,,0,0,0,,Алға!
Dialogue: 0,0:17:04.77,0:17:07.65,Default,,0,0,0,,<Жоқ, сіздің аяқ киіміңіз! Аяқ киімнің бауы жоқ! ＞
Dialogue: 0,0:17:07.77,0:17:09.27,Default,,0,0,0,,Түсіндім! Хмм
Dialogue: 0,0:17:09.40,0:17:10.69,Default,,0,0,0,,<Түсінбедім! ＞
Dialogue: 0,0:17:12.15,0:17:16.45,Default,,0,0,0,,Сен, жансыз құрал—
Dialogue: 0,0:17:16.82,0:17:17.91,Default,,0,0,0,,(Гоблиндердің айқайы)
Dialogue: 0,0:17:18.78,0:17:20.16,Default,,0,0,0,,Әй!
Dialogue: 0,0:17:20.99,0:17:22.91,Default,,0,0,0,,<Жел қабырғасы>
Dialogue: 0,0:17:25.67,0:17:28.08,Default,,0,0,0,,Сейка-сан, сен жалғыз бара алмайсың!
Dialogue: 0,0:17:28.21,0:17:29.96,Default,,0,0,0,,Ах, кешіріңіз!
Dialogue: 0,0:17:30.09,0:17:32.71,Default,,0,0,0,,<Жел қабырғасы біраз уақытқа созылады, бірақ...>
Dialogue: 0,0:17:33.01,0:17:34.47,Default,,0,0,0,,<Сэйджи-сан ше? ＞
Dialogue: 0,0:17:34.59,0:17:36.97,Default,,0,0,0,,Ахх!
Dialogue: 0,0:17:37.13,0:17:39.01,Default,,0,0,0,,＜Қолжетімді түрлендіру!?＞
Dialogue: 0,0:17:39.18,0:17:41.22,Default,,0,0,0,,<Бәтеңкенің бауы қажет болды ма? ＞
Dialogue: 0,0:17:41.60,0:17:42.93,Default,,0,0,0,,<О, бұл жаман! ＞
Dialogue: 0,0:17:43.10,0:17:45.73,Default,,0,0,0,,<Өзгерсең, киімің жыртылады! ＞
Dialogue: 0,0:17:46.06,0:17:47.77,Default,,0,0,0,,<Жарайды ма? Бұл қымбат...>
Dialogue: 0,0:17:47.90,0:17:49.02,Default,,0,0,0,,Ха!
Dialogue: 0,0:17:49.27,0:17:51.48,Default,,0,0,0,,<О, байқадың ба>
Dialogue: 0,0:17:53.53,0:17:56.53,Default,,0,0,0,,<О, иә, оны дұрыс бүктеңіз...>
Dialogue: 0,0:17:56.65,0:17:59.49,Default,,0,0,0,,<Оны қазір істемегенім жақсы емес пе!?>
Dialogue: 0,0:17:59.74,0:18:01.03,Default,,0,0,0,,(Ватару) Не болып жатыр? Бұл әңгіме… (Ер оқушы) Ол ұялы телефонымен дауласып жатыр.
Dialogue: 0,0:18:01.49,0:18:02.54,Default,,0,0,0,,Ахх!
Dialogue: 0,0:18:02.66,0:18:05.25,Default,,0,0,0,,<Не болды, оны басынан жөндеп алу керек! ＞
Dialogue: 0,0:18:05.66,0:18:08.00,Default,,0,0,0,,<Біраз уақыт алатын сияқты>
Dialogue: 0,0:18:08.12,0:18:10.29,Default,,0,0,0,,<Бұл туралы бірдеңе істей аламыз ба?>
Dialogue: 0,0:18:10.50,0:18:13.55,Default,,0,0,0,,<Мен де Сейка-санның өз деңгейін көтергенін қалаймын>
Dialogue: 0,0:18:14.05,0:18:15.97,Default,,0,0,0,,Құбыжықтар келе жатыр!
Dialogue: 0,0:18:16.13,0:18:17.51,Default,,0,0,0,,Біз не істеуіміз керек...
Dialogue: 0,0:18:17.63,0:18:19.51,Default,,0,0,0,,Оны жоғарыдан соғып, құлап кетсін!
Dialogue: 0,0:18:20.97,0:18:23.47,Default,,0,0,0,,＜Абсолютті илаһи қорғауға ие болды＞
Dialogue: 0,0:18:23.60,0:18:28.56,Default,,0,0,0,,<Жақсартылған дәлдік, жақсартылған шабуыл күші, жақсартылған шабуыл дәлдігі>
Dialogue: 0,0:18:29.94,0:18:32.52,Default,,0,0,0,,<Сейка-сан және басқалары бұған жақсы> (Сейка) Уау! Мен оны істедім!
Dialogue: 0,0:18:32.82,0:18:35.28,Default,,0,0,0,,<Енді, құбыжықтарды тарайық...>
Dialogue: 0,0:18:35.40,0:18:39.03,Default,,0,0,0,,<Тікелей секірсем, барлық жыланбалықтар жоғалады...>
Dialogue: 0,0:18:39.99,0:18:41.87,Default,,0,0,0,,<Балшықтан жасалған тұшпара>
Dialogue: 0,0:18:50.50,0:18:54.84,Default,,0,0,0,,(Құбыжықтар соғысып жатқан дауыстар)
Dialogue: 0,0:18:55.09,0:18:58.01,Default,,0,0,0,,<Енді біз оны жекпе-жекке шығара аламыз>
Dialogue: 0,0:18:58.13,0:18:59.13,Default,,0,0,0,,<Ах, Сэйджи-сан...>
Dialogue: 0,0:18:59.26,0:19:01.55,Default,,0,0,0,,Ахх!
Dialogue: 0,0:19:01.68,0:19:02.89,Default,,0,0,0,,<Әлі де істеп жатырмын! ＞
Dialogue: 0,0:19:03.35,0:19:06.64,Default,,0,0,0,,<Түрлендіру үшін оны бұзу керек пе?>
Dialogue: 0,0:19:06.81,0:19:09.48,Default,,0,0,0,,<Сен оңай ашуланатын түрің емессің...>
Dialogue: 0,0:19:09.64,0:19:12.48,Default,,0,0,0,,Қазір! Сенің аяғыңды кім басты?
Dialogue: 0,0:19:12.61,0:19:14.15,Default,,0,0,0,,<Қашан ашуландың? ＞
Dialogue: 0,0:19:15.02,0:19:16.15,Default,,0,0,0,,Әй!
Dialogue: 0,0:19:16.69,0:19:18.11,Default,,0,0,0,,Уф!
Dialogue: 0,0:19:18.99,0:19:20.15,Default,,0,0,0,,Уф!
Dialogue: 0,0:19:20.70,0:19:21.91,Default,,0,0,0,,Уф!
Dialogue: 0,0:19:24.28,0:19:25.37,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:27.08,0:19:27.91,Default,,0,0,0,,А...
Dialogue: 0,0:19:30.12,0:19:34.17,Default,,0,0,0,,Қайсар Батыр Олдин!
Dialogue: 0,0:19:34.29,0:19:37.67,Default,,0,0,0,,<Жыртылмаған болса! Қандай ішкі жан! ＞
Dialogue: 0,0:19:37.80,0:19:39.42,Default,,0,0,0,,Сондай-ақ!
Dialogue: 0,0:19:40.30,0:19:42.26,Default,,0,0,0,,<Жүгіріп жатырсың ба! ＞
Dialogue: 0,0:19:42.72,0:19:46.51,Default,,0,0,0,,<Жоқ, менің ойымша, пішін мінсіз, бірақ қанаттар нені білдіреді...>
Dialogue: 0,0:19:46.64,0:19:47.43,Default,,0,0,0,,Ха!
Dialogue: 0,0:19:48.10,0:19:49.39,Default,,0,0,0,,Амансың ба? (Лиз) Ух...
Dialogue: 0,0:19:49.52,0:19:51.56,Default,,0,0,0,,<Бұл дұрыс емес сияқты>
Dialogue: 0,0:19:51.77,0:19:53.60,Default,,0,0,0,,Ум, сен...
Dialogue: 0,0:19:53.73,0:19:56.86,Default,,0,0,0,,Мен жай ғана саяхатшымын, қаңғыбас батыр Әлдин!
Dialogue: 0,0:19:56.98,0:19:58.78,Default,,0,0,0,,<Қашан қыдырдың?>
Dialogue: 0,0:19:58.90,0:20:00.44,Default,,0,0,0,,Қалғанын маған қалдырыңыз!
Dialogue: 0,0:20:02.82,0:20:04.78,Default,,0,0,0,,Адамдардан кек алатын құбыжықтар
Dialogue: 0,0:20:04.91,0:20:06.16,Default,,0,0,0,,Егер сіз кеткіңіз келсе, дәл қазір уақыт!
Dialogue: 0,0:20:06.28,0:20:10.45,Default,,0,0,0,,Осы оң қолдың нұры кез келген зұлымдықты тесіп өтеді!
Dialogue: 0,0:20:10.58,0:20:12.46,Default,,0,0,0,,Хм, шайқас таңдаңыз!
Dialogue: 0,0:20:12.58,0:20:14.29,Default,,0,0,0,,Ха! (Құбыжықтар айқайы)
Dialogue: 0,0:20:14.46,0:20:16.21,Default,,0,0,0,,Ха! (Құбыжықтардың айқайы)
Dialogue: 0,0:20:16.34,0:20:17.55,Default,,0,0,0,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,0:20:17.67,0:20:20.67,Default,,0,0,0,,<Ойлап қарасам, нағыз төбелесті бірінші рет көріп тұрмын.>
Dialogue: 0,0:20:20.80,0:20:23.47,Default,,0,0,0,,<Сейка-сан, сен Альдеанды бірінші рет көріп тұрсың.>
Dialogue: 0,0:20:23.59,0:20:24.72,Default,,0,0,0,,Әй!
Dialogue: 0,0:20:25.14,0:20:28.18,Default,,0,0,0,,<Голем! Егер сіз әдеттегідей төбелессеңіз, бұл қиын.>
Dialogue: 0,0:20:28.31,0:20:29.93,Default,,0,0,0,,<Егер бұл Альдин болса>
Dialogue: 0,0:20:30.06,0:20:32.23,Default,,0,0,0,,Мен бұл оң қолдың жауы емеспін!
Dialogue: 0,0:20:32.60,0:20:36.94,Default,,0,0,0,,Қызыл кескішті өлтіріңіз~!
Dialogue: 0,0:20:40.03,0:20:41.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:41.44,0:20:43.78,Default,,0,0,0,,Сәлем! Сіз бұл оң қолды блоктауды жоспарлап отырсыз ба?
Dialogue: 0,0:20:43.90,0:20:45.16,Default,,0,0,0,,<Жоқ, бұл өзін-өзі жою>
Dialogue: 0,0:20:45.28,0:20:47.12,Default,,0,0,0,,Мен бұл деңгейде берілмеймін!
Dialogue: 0,0:20:47.24,0:20:49.74,Default,,0,0,0,,Өйткені мен ант бердім!
Dialogue: 0,0:20:50.74,0:20:52.25,Default,,0,0,0,,<Сіз ұша аласыз ба! ＞
Dialogue: 0,0:20:52.37,0:20:54.33,Default,,0,0,0,,Достарыңды ешқашан сатпаңдар!
Dialogue: 0,0:20:54.50,0:20:58.00,Default,,0,0,0,,Бұл қайсар батыр Әлдин!
Dialogue: 0,0:20:58.17,0:21:00.84,Default,,0,0,0,,Ааааааааааааааааааааааааааааааааа~!!
Dialogue: 0,0:21:00.96,0:21:03.63,Default,,0,0,0,,<Ол тегістелді.>
Dialogue: 0,0:21:03.76,0:21:05.84,Default,,0,0,0,,<Құттықтаймыз...>
Dialogue: 0,0:21:06.18,0:21:09.14,Default,,0,0,0,,♪～
Dialogue: 0,0:22:31.60,0:22:34.56,Default,,0,0,0,,～♪
Dialogue: 0,0:22:37.73,0:22:39.73,Default,,0,0,0,,«Қаңғыбас батыр Альдин!»
Dialogue: 0,0:22:40.19,0:22:42.23,Default,,0,0,0,,Мен атымды айтып, кетіп қалдым.
Dialogue: 0,0:22:42.36,0:22:44.90,Default,,0,0,0,,Ол өте күшті, құштар адам еді!
Dialogue: 0,0:22:45.03,0:22:47.24,Default,,0,0,0,,Ху~ Мен де сенімен танысқым келді.
Dialogue: 0,0:22:47.36,0:22:48.70,Default,,0,0,0,,<Ақ>
Dialogue: 0,0:22:49.07,0:22:50.74,Default,,0,0,0,,Сейджи қайда орналасқан?
Dialogue: 0,0:22:50.91,0:22:53.74,Default,,0,0,0,,Мені ұрған болуы керек, ес-түссіз қалдым.
Dialogue: 0,0:22:53.87,0:22:54.79,Default,,0,0,0,,Масқара...
Dialogue: 0,0:22:54.91,0:22:58.04,Default,,0,0,0,,Амансың ба? Қалпына келтіру сиқырын жасаймын ба?
Dialogue: 0,0:22:58.16,0:23:00.08,Default,,0,0,0,,Мәселе жоқ, рахмет!
Dialogue: 0,0:23:00.29,0:23:03.88,Default,,0,0,0,,<Қызыл кескіш саусақ сүйектеріңізге зақым келтірген жоқ па? ＞
Dialogue: 0,0:23:04.04,0:23:07.26,Default,,0,0,0,,<Мен көмектесе алмаймын, кейін жасырын түрде қалпына келтіруге тырысамын>
Dialogue: 0,0:23:07.80,0:23:10.84,Default,,0,0,0,,Мен сізге дұрыс алғыс айтқым келді.
Dialogue: 0,0:23:11.09,0:23:14.01,Default,,0,0,0,,«Барлығына көмектескеніңіз үшін рахмет»
Dialogue: 0,0:23:14.51,0:23:17.35,Default,,0,0,0,,Сейка-сан, сенің сезіміңді түсінетінімізге сенімдімін.
Dialogue: 0,0:23:17.47,0:23:18.35,Default,,0,0,0,,<Дұрыс>
Dialogue: 0,0:23:18.48,0:23:20.52,Default,,0,0,0,,Сонда ол адамның аты кім?
Dialogue: 0,0:23:20.81,0:23:22.61,Default,,0,0,0,,Эй Лидс (Лидс) Бірақ
Dialogue: 0,0:23:22.73,0:23:24.65,Default,,0,0,0,,<Бұл қандай хара?>
Dialogue: 0,0:23:24.90,0:23:27.86,Default,,0,0,0,,Бұл Әлдин, қаңғыбас батыр!
Dialogue: 0,0:23:27.99,0:23:31.28,Default,,0,0,0,,Дұрыс! Батыл Альдеан!
Dialogue: 0,0:23:31.41,0:23:33.66,Default,,0,0,0,,<Сейджиді патша етіңіз...>
Dialogue: 0,0:23:34.70,0:23:36.79,Default,,0,0,0,,<Мүмкін, мен қайта қарауым керек...>
Dialogue: 0,0:23:36.91,0:23:39.62,Default,,0,0,0,,Алдин... хехе, батыл Әлдин...
Dialogue: 0,0:23:41.12,0:23:47.12,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory