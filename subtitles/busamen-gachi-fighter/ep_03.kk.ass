Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.25,0:00:03.92,Default,,0,0,0,,Мен ешқашан достарыма опасыздық жасамаймын...
Dialogue: 0,0:00:05.25,0:00:06.96,Default,,0,0,0,,Батырдың шайқас айқайы
Dialogue: 0,0:00:07.09,0:00:10.05,Default,,0,0,0,,Ұйықтап жатқан мені ояту...
Dialogue: 0,0:00:10.59,0:00:13.05,Default,,0,0,0,,Үшінші көз ашылмаған...
Dialogue: 0,0:00:13.88,0:00:16.05,Default,,0,0,0,,Қайсар батыр...
Dialogue: 0,0:00:16.68,0:00:18.43,Default,,0,0,0,,Альдин!
Dialogue: 0,0:00:18.93,0:00:20.27,Default,,0,0,0,,<Иә? ＞
Dialogue: 0,0:00:21.60,0:00:24.56,Default,,0,0,0,,♪～
Dialogue: 0,0:01:45.48,0:01:48.44,Default,,0,0,0,,～♪
Dialogue: 0,0:02:00.37,0:02:02.66,Default,,0,0,0,,Ах... (Кёсиро) Ол өзгерді...
Dialogue: 0,0:02:02.83,0:02:04.91,Default,,0,0,0,,<Батыр Әл... Иә? ＞
Dialogue: 0,0:02:05.12,0:02:08.21,Default,,0,0,0,,Кеттік! Жылдам қасиетті найзағай...
Dialogue: 0,0:02:09.42,0:02:10.17,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:02:10.79,0:02:14.38,Default,,0,0,0,,Аврора жарқыраған демалыс орны!
Dialogue: 0,0:02:14.50,0:02:15.71,Default,,0,0,0,,<Найзағай!?> (Сейджи) Ахх!
Dialogue: 0,0:02:18.30,0:02:19.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:20.22,0:02:21.72,Default,,0,0,0,,Тоқтау керек пе?
Dialogue: 0,0:02:22.72,0:02:25.06,Default,,0,0,0,,Неге жұдырығыңды тоқтаттың?
Dialogue: 0,0:02:25.22,0:02:28.31,Default,,0,0,0,,Сізді соттайтын мен емес, заң...
Dialogue: 0,0:02:28.85,0:02:32.73,Default,,0,0,0,,Киоширо-сан, маған бұл жерде әрекет ету оңай.
Dialogue: 0,0:02:32.94,0:02:36.82,Default,,0,0,0,,Бірақ бұл сізді түзету мүмкіндігінен айырады.
Dialogue: 0,0:02:37.74,0:02:40.36,Default,,0,0,0,,Заңның үкімімен күнәларыңызға өкініңіз
Dialogue: 0,0:02:40.49,0:02:42.41,Default,,0,0,0,,Жүректен қайта туыл
Dialogue: 0,0:02:42.53,0:02:43.45,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:02:43.78,0:02:47.04,Default,,0,0,0,,<Сэйджи-сан, сен сондай жақсы адамсың...>
Dialogue: 0,0:02:47.20,0:02:48.33,Default,,0,0,0,,Мен жеңілдім...
Dialogue: 0,0:02:48.83,0:02:50.54,Default,,0,0,0,,Батыл Альдин...
Dialogue: 0,0:02:50.87,0:02:51.79,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:53.54,0:02:56.92,Default,,0,0,0,,Қайтадан жамандық жасасаң, мен сені кешірмеймін...
Dialogue: 0,0:02:57.05,0:02:59.30,Default,,0,0,0,,<Сэйджи-сан, артыңды бұрма! ＞
Dialogue: 0,0:03:00.09,0:03:01.22,Default,,0,0,0,,Бұл қажет болды!
Dialogue: 0,0:03:02.30,0:03:04.30,Default,,0,0,0,,Ха! (Шигеру: Оқиды) Ой, құладым.
Dialogue: 0,0:03:04.43,0:03:05.60,Default,,0,0,0,,О, гуха!
Dialogue: 0,0:03:05.72,0:03:07.64,Default,,0,0,0,,Шошқа!
Dialogue: 0,0:03:08.48,0:03:12.19,Default,,0,0,0,,(Киоширо мен оның достарының қорлауы)
Dialogue: 0,0:03:12.40,0:03:14.36,Default,,0,0,0,,<Кешіріңіз>
Dialogue: 0,0:03:15.77,0:03:17.48,Default,,0,0,0,,Ах! Алдеанның достары!
Dialogue: 0,0:03:17.73,0:03:18.86,Default,,0,0,0,,Не!?
Dialogue: 0,0:03:20.86,0:03:22.03,Default,,0,0,0,,Уф!
Dialogue: 0,0:03:23.91,0:03:25.37,Default,,0,0,0,,(Гиран) Қалай болғанда да, Курокири-сан, комиссия үшін саған сенемін.
Dialogue: 0,0:03:25.49,0:03:27.87,Default,,0,0,0,,Алдеан ше? (Кёсиро және басқалар) Иә!
Dialogue: 0,0:03:28.16,0:03:29.75,Default,,0,0,0,,Қандай күш!
Dialogue: 0,0:03:29.87,0:03:31.71,Default,,0,0,0,,<Менің бугерім>
Dialogue: 0,0:03:31.83,0:03:33.00,Default,,0,0,0,,<Қалғаны - Сэйджи-сан>
Dialogue: 0,0:03:33.13,0:03:34.29,Default,,0,0,0,,А, а... ＜О! ＞
Dialogue: 0,0:03:34.42,0:03:36.25,Default,,0,0,0,,<Сен тіпті таң қалдың! Не істеуім керек? ＞
Dialogue: 0,0:03:36.80,0:03:38.05,Default,,0,0,0,,Мен қазір солаймын ба?
Dialogue: 0,0:03:38.21,0:03:41.13,Default,,0,0,0,,<Мен көріністі қалай да байланыстыруым керек...>
Dialogue: 0,0:03:41.34,0:03:44.09,Default,,0,0,0,,А, мен көрдім...
Dialogue: 0,0:03:44.72,0:03:47.47,Default,,0,0,0,,Ақ қанатты сұңқар төменге көтерілді.
Dialogue: 0,0:03:47.68,0:03:50.39,Default,,0,0,0,,Батырдың ашуына жауап ретінде...
Dialogue: 0,0:03:50.64,0:03:53.73,Default,,0,0,0,,Ал сен мені қауіптен құтқардың.
Dialogue: 0,0:03:53.94,0:03:56.15,Default,,0,0,0,,Сіз ғажайыпқа шақырдыңыз!
Dialogue: 0,0:03:56.36,0:03:57.77,Default,,0,0,0,,Мұндай нәрсе...
Dialogue: 0,0:03:57.90,0:03:59.48,Default,,0,0,0,,<Иә, солай болды...>
Dialogue: 0,0:03:59.78,0:04:00.90,Default,,0,0,0,,Мені кешіріңіз!
Dialogue: 0,0:04:01.03,0:04:03.78,Default,,0,0,0,,Лорд Альдеан! (Миньондардың үрейлі дауыстары)
Dialogue: 0,0:04:04.16,0:04:06.16,Default,,0,0,0,,<Бұл балалар өздерінің қолайсыз жағдайда екенін түсінді>
Dialogue: 0,0:04:06.28,0:04:08.16,Default,,0,0,0,,Ібіліс кенет жоғалып кетті...
Dialogue: 0,0:04:08.29,0:04:11.46,Default,,0,0,0,,Енді зұлымдыққа жол берілмейді! Өтінемін, кешіріңіз!
Dialogue: 0,0:04:11.58,0:04:12.41,Default,,0,0,0,,<Сіз соқтыңыз! ＞
Dialogue: 0,0:04:12.71,0:04:15.29,Default,,0,0,0,,Мен өзгердім! өтінемін!
Dialogue: 0,0:04:15.58,0:04:18.55,Default,,0,0,0,,<Бұл өте кездейсоқ түрлендіру...>
Dialogue: 0,0:04:18.71,0:04:19.71,Default,,0,0,0,,<Жарайды...>
Dialogue: 0,0:04:19.84,0:04:22.01,Default,,0,0,0,,Балалар! Оларды бір қатарға орналастырыңыз!
Dialogue: 0,0:04:22.13,0:04:23.80,Default,,0,0,0,,Иә
Dialogue: 0,0:04:24.84,0:04:26.60,Default,,0,0,0,,Альдиннің арнайы қозғалысы
Dialogue: 0,0:04:26.72,0:04:27.64,Default,,0,0,0,,Уф
Dialogue: 0,0:04:27.76,0:04:30.02,Default,,0,0,0,,Не? Бірақ одан тыс...
Dialogue: 0,0:04:30.14,0:04:31.31,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:04:31.60,0:04:33.77,Default,,0,0,0,,Ендеше мен сені ыстық жұдырықпен ұрамын!
Dialogue: 0,0:04:33.89,0:04:34.69,Default,,0,0,0,,Шапалақ!?
Dialogue: 0,0:04:35.27,0:04:37.94,Default,,0,0,0,,Олар басқалардың қайғысын түсінбейді.
Dialogue: 0,0:04:38.06,0:04:39.77,Default,,0,0,0,,Мен сізге мынаны айтуым керек...
Dialogue: 0,0:04:39.90,0:04:41.19,Default,,0,0,0,,Уф... (Сэйджи) Ах!
Dialogue: 0,0:04:41.53,0:04:43.82,Default,,0,0,0,,Махаббаттың қамшысын кім ұстай алады
Dialogue: 0,0:04:43.95,0:04:47.20,Default,,0,0,0,,Альдин Сен жалғызсың!
Dialogue: 0,0:04:47.37,0:04:48.45,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:49.83,0:04:51.70,Default,,0,0,0,,<Шек, арамзалар>
Dialogue: 0,0:04:51.83,0:04:54.04,Default,,0,0,0,,<Егер сіз шынымен өзгерсеңіз...>
Dialogue: 0,0:04:54.54,0:04:57.71,Default,,0,0,0,,Мұндай жарық кез келген зұлымдықты тесіп өтеді.
Dialogue: 0,0:04:57.96,0:05:00.46,Default,,0,0,0,,<Бұл жұдырық қорқынышты емес, солай ма? ＞
Dialogue: 0,0:05:00.63,0:05:01.80,Default,,0,0,0,,Шынайы сезімдері мен нағыз болмысын жасырып
Dialogue: 0,0:05:02.09,0:05:03.13,Default,,0,0,0,,<Иә? ＞
Dialogue: 0,0:05:03.34,0:05:05.68,Default,,0,0,0,,Түрлендіруді қалай шешесіз?
Dialogue: 0,0:05:05.93,0:05:08.05,Default,,0,0,0,,Өйткені енді ашуға ешқандай себеп жоқ.
Dialogue: 0,0:05:08.18,0:05:09.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:09.51,0:05:12.97,Default,,0,0,0,,Махаббаттың қамшысы болса, ашуға себеп болма...
Dialogue: 0,0:05:13.85,0:05:16.81,Default,,0,0,0,,Бұл тек ренжіткен адамның өзін-өзі қанағаттандыруы.
Dialogue: 0,0:05:17.31,0:05:20.11,Default,,0,0,0,,Соққан қолыңды, қарсыласыңның азабын жүрегіңе ойып жаз.
Dialogue: 0,0:05:20.23,0:05:21.02,Default,,0,0,0,,Хмм
Dialogue: 0,0:05:21.98,0:05:23.36,Default,,0,0,0,,Бұл махаббат!
Dialogue: 0,0:05:23.69,0:05:24.74,Default,,0,0,0,,<Иә...>
Dialogue: 0,0:05:25.03,0:05:26.53,Default,,0,0,0,,Арқаңызды түзетіңіз!!
Dialogue: 0,0:05:26.66,0:05:27.49,Default,,0,0,0,,Сәлем!!
Dialogue: 0,0:05:27.66,0:05:29.70,Default,,0,0,0,,Тістеріңді қайраңдар!!
Dialogue: 0,0:05:29.82,0:05:31.41,Default,,0,0,0,,Ах! (Кёсиро) Рахмет!
Dialogue: 0,0:05:31.58,0:05:33.20,Default,,0,0,0,,Жоқ! (Бағыныңқы) Рахмет!
Dialogue: 0,0:05:33.91,0:05:35.75,Default,,0,0,0,,Рахмет! (Сэйджи) Келесі!
Dialogue: 0,0:05:36.12,0:05:38.00,Default,,0,0,0,,Рахмет! (Сэйджи) Келесі!
Dialogue: 0,0:05:38.58,0:05:39.63,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:05:40.21,0:05:42.71,Default,,0,0,0,,<Не көрсетіліп жатыр...>
Dialogue: 0,0:05:45.22,0:05:47.97,Default,,0,0,0,,(Ұйқыда)
Dialogue: 0,0:05:48.47,0:05:51.14,Default,,0,0,0,,Сосын Сейка-сан...
Dialogue: 0,0:05:52.18,0:05:53.81,Default,,0,0,0,,Иә... Мм...
Dialogue: 0,0:05:53.93,0:05:55.98,Default,,0,0,0,,<Кешіріңіз, бұл менің шегімде>
Dialogue: 0,0:05:56.10,0:05:59.40,Default,,0,0,0,,<Қызға тиіссең, ең жаманы өлу...>
Dialogue: 0,0:06:00.31,0:06:02.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:02.52,0:06:03.86,Default,,0,0,0,,<Сэйдзи-сан! ＞
Dialogue: 0,0:06:03.98,0:06:06.11,Default,,0,0,0,,Дәрі ақыры әсер етті ме?
Dialogue: 0,0:06:06.24,0:06:08.36,Default,,0,0,0,,Мүмкін, біз қазір жеңетін шығармыз.
Dialogue: 0,0:06:08.49,0:06:10.53,Default,,0,0,0,,<Мен өз ойымды өзгерткен жоқпын>
Dialogue: 0,0:06:10.74,0:06:12.83,Default,,0,0,0,,Дұрыс, ей шошқа!
Dialogue: 0,0:06:12.95,0:06:14.79,Default,,0,0,0,,Біздің досымыз бол
Dialogue: 0,0:06:15.00,0:06:17.79,Default,,0,0,0,,Жоғары дәрежелі адамдармен кеште болу қиын емес пе?
Dialogue: 0,0:06:17.96,0:06:20.92,Default,,0,0,0,,Осында келсең, мен сені жақсы әйелмен таныстырамын.
Dialogue: 0,0:06:21.04,0:06:23.25,Default,,0,0,0,,Мен де саған көп ақша беремін.
Dialogue: 0,0:06:25.17,0:06:26.30,Default,,0,0,0,,Хмф!
Dialogue: 0,0:06:27.13,0:06:28.55,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:06:28.72,0:06:31.55,Default,,0,0,0,,Сэйджи-сан менен күштірек.
Dialogue: 0,0:06:31.68,0:06:33.56,Default,,0,0,0,,(қорыққан дауыс)
Dialogue: 0,0:06:33.85,0:06:36.14,Default,,0,0,0,,Өзі сондай сұмдық болса да, жүрегі әділетті...
Dialogue: 0,0:06:36.27,0:06:38.18,Default,,0,0,0,,Сіз бір топ ашкөздікке ұқсайсыз!
Dialogue: 0,0:06:38.48,0:06:40.44,Default,,0,0,0,,<Қалағаныңды айт>
Dialogue: 0,0:06:40.56,0:06:43.44,Default,,0,0,0,,(Ұйқыда)
Dialogue: 0,0:06:43.73,0:06:45.90,Default,,0,0,0,,Еңбегіңізге рахмет, басшы...
Dialogue: 0,0:06:46.03,0:06:49.40,Default,,0,0,0,,Мен сене алар емеспін! Оның ең жақсы келбеті бар!
Dialogue: 0,0:06:49.53,0:06:52.03,Default,,0,0,0,,Қалай қарасаң да, жемқор шошқасың!
Dialogue: 0,0:06:52.32,0:06:54.70,Default,,0,0,0,,<Мен қатты ашуландым...>
Dialogue: 0,0:06:56.62,0:06:58.71,Default,,0,0,0,,Уау...
Dialogue: 0,0:06:59.04,0:07:02.71,Default,,0,0,0,,<Бұл 100 000 лир - Киоширо бандысының сыйы>
Dialogue: 0,0:07:02.83,0:07:05.67,Default,,0,0,0,,<Жапон иеніндегі шамамен 10 миллион иен...>
Dialogue: 0,0:07:06.09,0:07:09.93,Default,,0,0,0,,<Сол ұрлап кеткендер көп жамандық жасаған сияқты...>
Dialogue: 0,0:07:10.05,0:07:11.09,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:07:11.51,0:07:14.05,Default,,0,0,0,,Мен бұл ақшаны барлығына алғанын қалаймын.
Dialogue: 0,0:07:14.18,0:07:17.10,Default,,0,0,0,,Бірақ біз жай ғана ұйықтадық және ештеңе істемедік.
Dialogue: 0,0:07:17.60,0:07:20.14,Default,,0,0,0,,Мен барлығына қауіп төндірдім
Dialogue: 0,0:07:20.27,0:07:23.31,Default,,0,0,0,,Себебі мен байқамай Киоширо мырзаға сеніп қалдым...
Dialogue: 0,0:07:23.48,0:07:25.73,Default,,0,0,0,,Сол жамандарды да жеңді.
Dialogue: 0,0:07:25.86,0:07:27.15,Default,,0,0,0,,Бұл Сэйджи-сан, солай ма?
Dialogue: 0,0:07:27.28,0:07:28.23,Default,,0,0,0,,Керемет
Dialogue: 0,0:07:28.78,0:07:31.24,Default,,0,0,0,,<Бұл, әрине, керемет болды...>
Dialogue: 0,0:07:31.49,0:07:33.74,Default,,0,0,0,,Шигеру де ұйықтап жатыр ма еді?
Dialogue: 0,0:07:33.91,0:07:36.66,Default,,0,0,0,,үшін? О, жоқ... мен...
Dialogue: 0,0:07:36.87,0:07:39.45,Default,,0,0,0,,Шигеру басқалардан да батыл болды
Dialogue: 0,0:07:39.62,0:07:42.08,Default,,0,0,0,,Мені қорғау үшін өміріңді қатерге тіктің.
Dialogue: 0,0:07:42.75,0:07:44.50,Default,,0,0,0,,<Зақым келмеген>
Dialogue: 0,0:07:46.21,0:07:48.92,Default,,0,0,0,,Керемет! Сонда бұл MVP!
Dialogue: 0,0:07:49.05,0:07:49.88,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:07:50.13,0:07:51.42,Default,,0,0,0,,Әлі де менің соңымнан келесің бе?
Dialogue: 0,0:07:51.55,0:07:53.84,Default,,0,0,0,,Шигеру мырза, ақшаны алыңыз.
Dialogue: 0,0:07:53.97,0:07:54.89,Default,,0,0,0,,Жоқ, жоқ...
Dialogue: 0,0:07:55.30,0:07:58.10,Default,,0,0,0,,<Менің депозитім 1/10 000>
Dialogue: 0,0:07:58.22,0:08:02.14,Default,,0,0,0,,<If I repay my debt to Seika-san, I can say goodbye to this party...>
Dialogue: 0,0:08:02.44,0:08:04.90,Default,,0,0,0,,<Көмектесу мүмкін емес, бұрынғы сатушының шеберлігі...>
Dialogue: 0,0:08:05.02,0:08:07.65,Default,,0,0,0,,<Мен сізге ақша төлеймін>
Dialogue: 0,0:08:07.77,0:08:08.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:08.86,0:08:11.74,Default,,0,0,0,,Сэйджи-сан, мен ысырапшылмын...
Dialogue: 0,0:08:11.86,0:08:14.66,Default,,0,0,0,,Менің ақшам таусылады, сондықтан...
Dialogue: 0,0:08:15.03,0:08:18.12,Default,,0,0,0,,Мен сенетін адам оны пайдаланғанын қалаймын.
Dialogue: 0,0:08:18.28,0:08:19.66,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:08:20.87,0:08:23.67,Default,,0,0,0,,Жарайды, бұл менің ақшам...
Dialogue: 0,0:08:24.17,0:08:26.17,Default,,0,0,0,,Партияны нығайту үшін таратылды
Dialogue: 0,0:08:26.29,0:08:28.67,Default,,0,0,0,,<Сіздің қайсарлығыңыздың шегі бар! ＞
Dialogue: 0,0:08:29.13,0:08:31.92,Default,,0,0,0,,Барлығына! Осы ақшаға дайын болыңыз
Dialogue: 0,0:08:32.05,0:08:33.43,Default,,0,0,0,,Болашаққа дайындалуларыңызды қалаймын.
Dialogue: 0,0:08:33.55,0:08:35.55,Default,,0,0,0,,Иә! (Қыз) Түсіндім.
Dialogue: 0,0:08:35.76,0:08:37.22,Default,,0,0,0,,Келіңіздер! Шигеру де!
Dialogue: 0,0:08:37.35,0:08:40.93,Default,,0,0,0,,Ah, no, it's really easier not to have money.
Dialogue: 0,0:08:41.10,0:08:42.56,Default,,0,0,0,,Иә, иә!
Dialogue: 0,0:08:42.68,0:08:46.44,Default,,0,0,0,,As a rich person, I will manage Shigeru-san's money.
Dialogue: 0,0:08:46.60,0:08:47.48,Default,,0,0,0,,<Eh>
Dialogue: 0,0:08:47.61,0:08:49.40,Default,,0,0,0,,Сейка-сан? (Сейка) Иә!
Dialogue: 0,0:08:50.61,0:08:54.15,Default,,0,0,0,,Shigeru-san, you tell me when you go shopping!
Dialogue: 0,0:08:54.28,0:08:55.82,Default,,0,0,0,,<Балалардың қалталы ақшасы>
Dialogue: 0,0:08:56.03,0:08:59.91,Default,,0,0,0,,Күте тұрыңыз! Seika-san, you have a habit of impulse buying, right?
Dialogue: 0,0:09:00.03,0:09:01.83,Default,,0,0,0,,Олай болса... (Сейка) Ах!
Dialogue: 0,0:09:02.87,0:09:03.87,Default,,0,0,0,,Сейджи мырза...
Dialogue: 0,0:09:04.00,0:09:06.04,Default,,0,0,0,,Мен ғана қорлаймын...
Dialogue: 0,0:09:06.17,0:09:07.96,Default,,0,0,0,,А... Мен олай айтқым келген жоқ...
Dialogue: 0,0:09:08.08,0:09:09.21,Default,,0,0,0,,<Ах...>
Dialogue: 0,0:09:09.71,0:09:13.97,Default,,0,0,0,,<Бірақ оны Сейка-санға берген дұрыс болар.>
Dialogue: 0,0:09:16.38,0:09:18.60,Default,,0,0,0,,Шигеру-сан, күте тұрыңыз.
Dialogue: 0,0:09:18.93,0:09:20.39,Default,,0,0,0,,Бұл менің сән-салтанатым
Dialogue: 0,0:09:20.51,0:09:22.14,Default,,0,0,0,,Хмм... (Сейка) Хмф~
Dialogue: 0,0:09:23.31,0:09:26.56,Default,,0,0,0,,<Ақырында менің үлесім Сейка-санға сеніп тапсырылды>
Dialogue: 0,0:09:27.19,0:09:28.98,Default,,0,0,0,,<Егер ол 25 000 лира болса>
Dialogue: 0,0:09:29.11,0:09:31.61,Default,,0,0,0,,<You can say that you have repaid the debt of one lodging and one meal.>
Dialogue: 0,0:09:32.11,0:09:34.11,Default,,0,0,0,,<Өнерім болса күн көремін>
Dialogue: 0,0:09:34.57,0:09:36.45,Default,,0,0,0,,<Менде енді сенімен кездесуге ешқандай себеп жоқ>
Dialogue: 0,0:09:36.57,0:09:39.12,Default,,0,0,0,,<Ал, бұл соңғы кешкі ас.>
Dialogue: 0,0:09:40.53,0:09:42.24,Default,,0,0,0,,Бейшара Шигеру! Уф!
Dialogue: 0,0:09:42.41,0:09:44.33,Default,,0,0,0,,Енді бұл не?
Dialogue: 0,0:09:44.45,0:09:45.75,Default,,0,0,0,,Бұл гамбургер!
Dialogue: 0,0:09:45.87,0:09:47.83,Default,,0,0,0,,<Жауабын тағы айтасың ба? ＞
Dialogue: 0,0:09:47.96,0:09:50.04,Default,,0,0,0,,Енді рахмет айтайық.
Dialogue: 0,0:09:50.17,0:09:51.50,Default,,0,0,0,,Сәлем... (Сейка) А...
Dialogue: 0,0:09:51.80,0:09:53.51,Default,,0,0,0,,«Сәлеметсіз бе, солай ма?
Dialogue: 0,0:09:53.63,0:09:55.01,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:55.59,0:09:57.30,Default,,0,0,0,,Рахмет
Dialogue: 0,0:09:57.43,0:10:00.05,Default,,0,0,0,,Ха, қош келдіңіз.
Dialogue: 0,0:10:00.18,0:10:01.14,Default,,0,0,0,,<О, құдайым>
Dialogue: 0,0:10:01.55,0:10:04.06,Default,,0,0,0,,<"Рахмет" "Қош келдіңіз">
Dialogue: 0,0:10:04.18,0:10:07.39,Default,,0,0,0,,<Сейка-сан бұл алмасудан ләззат алған сияқты>
Dialogue: 0,0:10:07.69,0:10:12.44,Default,,0,0,0,,<Алғашында ол аздап ашулы болды, бірақ шын мәнінде ол өте мейірімді.>
Dialogue: 0,0:10:12.57,0:10:13.40,Default,,0,0,0,,Хмм
Dialogue: 0,0:10:13.86,0:10:15.86,Default,,0,0,0,,Диетадан бас тартып, тамақтануды бастаңыз!
Dialogue: 0,0:10:15.99,0:10:17.11,Default,,0,0,0,,<Шулы>
Dialogue: 0,0:10:19.61,0:10:21.57,Default,,0,0,0,,Гамбургерлерді ұнатасыз ба?
Dialogue: 0,0:10:21.70,0:10:23.70,Default,,0,0,0,,Иә! Мен саған күні кеше ғашық болдым!
Dialogue: 0,0:10:23.83,0:10:24.95,Default,,0,0,0,,<Солай ма? ＞
Dialogue: 0,0:10:25.08,0:10:29.29,Default,,0,0,0,,<Егер кешегі күн бірінші рет болса, сіз әдемі қорапты қызсыз ба? ＞
Dialogue: 0,0:10:29.54,0:10:31.54,Default,,0,0,0,,Ах... Мм.
Dialogue: 0,0:10:32.54,0:10:34.00,Default,,0,0,0,,<Букитчоё...>
Dialogue: 0,0:10:34.75,0:10:38.22,Default,,0,0,0,,Айтпақшы, Шигеру-санның жағдайы қандай?
Dialogue: 0,0:10:38.34,0:10:41.59,Default,,0,0,0,,Жарайды... қызықсыз.
Dialogue: 0,0:10:41.76,0:10:43.14,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:10:43.26,0:10:45.56,Default,,0,0,0,,Мен мұны түсінуім керек еді.
Dialogue: 0,0:10:45.97,0:10:47.14,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:10:47.27,0:10:50.31,Default,,0,0,0,,Негізі мен айла таптым.
Dialogue: 0,0:10:50.69,0:10:53.52,Default,,0,0,0,,Күй енгізуінің көрінісін төмендету
Dialogue: 0,0:10:53.65,0:10:55.65,Default,,0,0,0,,Бонус ұпайлары артады
Dialogue: 0,0:10:55.78,0:10:58.61,Default,,0,0,0,,<Оны түсіндің бе, бірақ...>
Dialogue: 0,0:10:58.95,0:11:00.32,Default,,0,0,0,,Түріңізді төмендеткен сияқтысыз...
Dialogue: 0,0:11:00.86,0:11:03.32,Default,,0,0,0,,16 Мен оны теріс жасадым.
Dialogue: 0,0:11:03.70,0:11:05.03,Default,,0,0,0,,<Сіз нені айтып тұрсыз?＞
Dialogue: 0,0:11:05.16,0:11:08.33,Default,,0,0,0,,＜Бастапқыда қаншалықты жақсы көрінсең де...＞
Dialogue: 0,0:11:09.33,0:11:10.33,Default,,0,0,0,,Фуфу
Dialogue: 0,0:11:10.58,0:11:11.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:11.79,0:11:13.75,Default,,0,0,0,,Мен әдемімін бе?
Dialogue: 0,0:11:13.88,0:11:15.80,Default,,0,0,0,,Не? Иә жақсы...
Dialogue: 0,0:11:15.92,0:11:18.84,Default,,0,0,0,,Хехе, мен сұрадым.
Dialogue: 0,0:11:19.30,0:11:22.59,Default,,0,0,0,,Күйдің астында арнайы ескертулер бар, солай ма?
Dialogue: 0,0:11:22.89,0:11:24.72,Default,,0,0,0,,Мен оны сол жерде толтырдым.
Dialogue: 0,0:11:25.43,0:11:27.22,Default,,0,0,0,,«Мен сұлу болғым келеді»...
Dialogue: 0,0:11:27.43,0:11:30.14,Default,,0,0,0,,<Мм! Сізде осындай қол болды ма? ＞
Dialogue: 0,0:11:30.27,0:11:33.61,Default,,0,0,0,,<Сосын мен: «Дәл сол жарнамадағы сымбатты актер сияқты» дер едім.
Dialogue: 0,0:11:33.73,0:11:35.73,Default,,0,0,0,,<Егер жазып алсаңыз...>
Dialogue: 0,0:11:36.11,0:11:39.19,Default,,0,0,0,,<K… Жоқ, мен сіздің атыңызды білмеймін…>
Dialogue: 0,0:11:39.32,0:11:41.78,Default,,0,0,0,,(Суға құлау дыбысы)
Dialogue: 0,0:11:41.91,0:11:42.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:43.28,0:11:45.58,Default,,0,0,0,,Бұл... мысық па?
Dialogue: 0,0:11:45.70,0:11:47.99,Default,,0,0,0,,Не? Ой бұл мысық
Dialogue: 0,0:11:48.37,0:11:50.79,Default,,0,0,0,,Мен оны бірінші рет жақыннан көріп тұрмын.
Dialogue: 0,0:11:50.96,0:11:54.25,Default,,0,0,0,,Өте сүйкімді! Өтінемін осында келе аласыз ба...
Dialogue: 0,0:11:54.50,0:11:56.09,Default,,0,0,0,,Барып, тиіп кетсем ше?
Dialogue: 0,0:11:56.29,0:11:57.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:57.75,0:11:58.59,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:58.71,0:11:59.92,Default,,0,0,0,,<Не? ＞
Dialogue: 0,0:12:00.05,0:12:00.84,Default,,0,0,0,,Ха!
Dialogue: 0,0:12:00.97,0:12:04.76,Default,,0,0,0,,Иә! Мен қазірдің өзінде тұра алатынмын! Ухуху
Dialogue: 0,0:12:04.97,0:12:06.89,Default,,0,0,0,,<Не, бұл...>
Dialogue: 0,0:12:07.01,0:12:09.27,Default,,0,0,0,,Уау хаха аа...
Dialogue: 0,0:12:09.93,0:12:11.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:11.73,0:12:13.31,Default,,0,0,0,,Коро…
Dialogue: 0,0:12:13.85,0:12:15.69,Default,,0,0,0,,Мм, мысық!
Dialogue: 0,0:12:18.02,0:12:19.98,Default,,0,0,0,,Шигеру-сан, не болды?
Dialogue: 0,0:12:20.19,0:12:22.78,Default,,0,0,0,,А, жоқ, бұл тамақтан кейін жаттығу.
Dialogue: 0,0:12:23.95,0:12:25.41,Default,,0,0,0,,Мысық...
Dialogue: 0,0:12:26.45,0:12:28.08,Default,,0,0,0,,Әке, мен кеттім!
Dialogue: 0,0:12:28.24,0:12:30.79,Default,,0,0,0,,Уф~ Мен сені еркелетейін~
Dialogue: 0,0:12:31.08,0:12:32.54,Default,,0,0,0,,Жоқ~? Тек дәретханаға барыңыз
Dialogue: 0,0:12:32.66,0:12:34.96,Default,,0,0,0,,Иә (мысықтың мияулауы)
Dialogue: 0,0:12:35.08,0:12:36.75,Default,,0,0,0,,Кат-чан
Dialogue: 0,0:12:38.71,0:12:41.13,Default,,0,0,0,,<Солай ма...> (Шигеру жылайды)
Dialogue: 0,0:12:41.55,0:12:44.72,Default,,0,0,0,,<Сейка-сан дәл қазір маған қарай қолын көрсетіп тұрды...>
Dialogue: 0,0:12:45.18,0:12:48.97,Default,,0,0,0,,<Осыдан кейін қарап, ұстағаным өз қолым еді...>
Dialogue: 0,0:12:49.89,0:12:52.48,Default,,0,0,0,,<Қалыпты: Әдемі болғың келсе>
Dialogue: 0,0:12:52.60,0:12:54.64,Default,,0,0,0,,<Қолыңыздың орнына бетіңізді ұстаңыз...>
Dialogue: 0,0:12:58.40,0:13:01.36,Default,,0,0,0,,<Қол ғана емес... аяқ та шығар>
Dialogue: 0,0:13:01.48,0:13:03.99,Default,,0,0,0,,<Ол тұра алмайтындай ыңғайсыз болса керек...>
Dialogue: 0,0:13:04.11,0:13:05.91,Default,,0,0,0,,<Әлі жасөспірім қыз...>
Dialogue: 0,0:13:06.66,0:13:10.28,Default,,0,0,0,,<Бұл дүниеде құдайлар немесе буддалар жоқ па?>
Dialogue: 0,0:13:10.66,0:13:12.00,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:13:12.50,0:13:16.17,Default,,0,0,0,,<О, бұл мен! Әйтеуір, мен абсолютті құдаймын! ＞
Dialogue: 0,0:13:16.29,0:13:18.42,Default,,0,0,0,,Шигеру-сан?
Dialogue: 0,0:13:18.88,0:13:21.13,Default,,0,0,0,,Сіздің асқазаныңыз дыбыс шығарып тұр ма?
Dialogue: 0,0:13:21.30,0:13:23.26,Default,,0,0,0,,Дәрі сатып алайын ба?
Dialogue: 0,0:13:23.38,0:13:26.18,Default,,0,0,0,,Жарайды! Мен жақында шығамын
Dialogue: 0,0:13:26.76,0:13:30.64,Default,,0,0,0,,<Сейка-санның әлеуметтік тәжірибесі тым аз, ол таза ақ>
Dialogue: 0,0:13:30.76,0:13:34.35,Default,,0,0,0,,<Осылай жалғасатын болса, оның бәрі тамаша үйрек...>
Dialogue: 0,0:13:34.64,0:13:37.90,Default,,0,0,0,,<Құдай деген атаққа ие болған менің қолымнан келетін нәрсе...>
Dialogue: 0,0:13:44.90,0:13:47.99,Default,,0,0,0,,Әй, Шигеру-сан! Мен уайымдадым!
Dialogue: 0,0:13:48.11,0:13:50.33,Default,,0,0,0,,Кешіріңіз, рахмет
Dialogue: 0,0:13:50.49,0:13:52.70,Default,,0,0,0,,А... қош келдіңіз!
Dialogue: 0,0:13:53.33,0:13:54.79,Default,,0,0,0,,Жүр, бәрі күтіп тұр!
Dialogue: 0,0:13:54.91,0:13:56.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:56.16,0:13:59.46,Default,,0,0,0,,<Құдай болып кетсем де қолымнан келмейді>
Dialogue: 0,0:14:00.08,0:14:02.46,Default,,0,0,0,,<Сейка-сан, өзіңе алайық>
Dialogue: 0,0:14:03.25,0:14:05.30,Default,,0,0,0,,<Мен сізге жол көрсетемін>
Dialogue: 0,0:14:08.38,0:14:10.43,Default,,0,0,0,,Бұл болашақ туралы...
Dialogue: 0,0:14:10.55,0:14:13.22,Default,,0,0,0,,Әр адамның мамандық таңдауы туралы не айтасыз?
Dialogue: 0,0:14:13.56,0:14:14.81,Default,,0,0,0,,Мамандығы?
Dialogue: 0,0:14:14.93,0:14:17.56,Default,,0,0,0,,Егер сіз сабақты ескере отырып ұпайларды бөлсеңіз
Dialogue: 0,0:14:17.69,0:14:21.44,Default,,0,0,0,,Менің ойымша, бұл сіздің қабілеттеріңізді теңестіреді және күресуді жеңілдетеді.
Dialogue: 0,0:14:21.56,0:14:23.48,Default,,0,0,0,,<Түсіндім, ойладым>
Dialogue: 0,0:14:23.61,0:14:24.98,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:14:25.11,0:14:26.69,Default,,0,0,0,,«Батыр» болуды мақсат етемін!
Dialogue: 0,0:14:26.86,0:14:28.99,Default,,0,0,0,,<Ол мәлімдеме батырлық>
Dialogue: 0,0:14:29.36,0:14:30.87,Default,,0,0,0,,Сіз «сиқыршысыз»
Dialogue: 0,0:14:30.99,0:14:31.78,Default,,0,0,0,,Иә
Dialogue: 0,0:14:31.91,0:14:34.49,Default,,0,0,0,,Ал Шигеру «байыпты күрескер»
Dialogue: 0,0:14:34.83,0:14:36.54,Default,,0,0,0,,<Неге байыпты болдың? ＞
Dialogue: 0,0:14:36.66,0:14:38.46,Default,,0,0,0,,<Мен оны шынымен жек көремін, бірақ...>
Dialogue: 0,0:14:38.58,0:14:39.37,Default,,0,0,0,,Сэйдзи-сан!
Dialogue: 0,0:14:39.87,0:14:41.63,Default,,0,0,0,,Мен де «Батырды» ойнағым келеді!
Dialogue: 0,0:14:41.79,0:14:43.21,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:14:43.38,0:14:45.96,Default,,0,0,0,,Сейка-сан, сен Гачи жауынгерін ойнағың келе ме?
Dialogue: 0,0:14:46.09,0:14:47.97,Default,,0,0,0,,Маған ұнамайды! <Сол емес пе?>
Dialogue: 0,0:14:51.72,0:14:52.89,Default,,0,0,0,,Хмф!
Dialogue: 0,0:14:55.97,0:14:57.14,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:57.35,0:15:00.60,Default,,0,0,0,,<Сэйджи-сан, сен сонша сақ болдың, бірақ толқыдың...>
Dialogue: 0,0:15:00.77,0:15:02.61,Default,,0,0,0,,＜Сіздің мотивацияңыз бар ма...＞
Dialogue: 0,0:15:02.73,0:15:04.15,Default,,0,0,0,,Шигеру-сан! Уау
Dialogue: 0,0:15:04.40,0:15:07.24,Default,,0,0,0,,Менің керемет сиқыршыға айналғаныма қара!
Dialogue: 0,0:15:07.40,0:15:08.28,Default,,0,0,0,,<Иә иә>
Dialogue: 0,0:15:08.57,0:15:11.57,Default,,0,0,0,,<Бір кезде мен батыр болудан бас тарттым, бірақ...>
Dialogue: 0,0:15:11.70,0:15:13.16,Default,,0,0,0,,Бұл сізге жарасады.
Dialogue: 0,0:15:13.28,0:15:15.37,Default,,0,0,0,,А, солай ма?
Dialogue: 0,0:15:15.95,0:15:16.79,Default,,0,0,0,,Уау
Dialogue: 0,0:15:18.12,0:15:20.25,Default,,0,0,0,,Енді келесі баратын жер
Dialogue: 0,0:15:20.41,0:15:23.50,Default,,0,0,0,,Валерия княздігі, жақын маңдағы ең үлкен қала
Dialogue: 0,0:15:23.63,0:15:26.92,Default,,0,0,0,,Бірақ бұған дейін мен бәріне айтқым келетін бір нәрсе бар.
Dialogue: 0,0:15:27.05,0:15:28.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:28.42,0:15:30.34,Default,,0,0,0,,Тәтті тағамдар 3 лирамен шектеледі!
Dialogue: 0,0:15:30.47,0:15:31.59,Default,,0,0,0,,<Экскурсия?>
Dialogue: 0,0:15:31.80,0:15:33.55,Default,,0,0,0,,Иә... <Неге жылайсың? ＞
Dialogue: 0,0:15:33.93,0:15:36.68,Default,,0,0,0,,Ертең таңертең жиналыс! Сосын тара!
Dialogue: 0,0:15:37.01,0:15:39.56,Default,,0,0,0,,<Банандар жеңіл тағамдарға қосыла ма...>
Dialogue: 0,0:15:39.68,0:15:40.89,Default,,0,0,0,,Эй!! Сіздер қалайсыздар? Енді бәрі жақсы!!
Dialogue: 0,0:15:41.69,0:15:43.81,Default,,0,0,0,,Бұл... у...
Dialogue: 0,0:15:44.23,0:15:47.32,Default,,0,0,0,,<Менің бірінші досым, Сейка-сан, қолыңнан келгеннің бәрін істе...>
Dialogue: 0,0:15:47.44,0:15:48.32,Default,,0,0,0,,Ум...
Dialogue: 0,0:15:48.90,0:15:52.49,Default,,0,0,0,,Арқанмен секіру! Оны қазір бірге жасағыңыз келе ме?
Dialogue: 0,0:15:52.70,0:15:53.78,Default,,0,0,0,,Арқанмен секіру?
Dialogue: 0,0:15:53.91,0:15:55.03,Default,,0,0,0,,Мен саған айтамын!
Dialogue: 0,0:15:55.16,0:15:56.70,Default,,0,0,0,,Мен жаттықтым!
Dialogue: 0,0:15:56.83,0:15:58.20,Default,,0,0,0,,Не керек!
Dialogue: 0,0:15:58.87,0:16:01.21,Default,,0,0,0,,Иә (Сейка) Онда саябаққа барайық!
Dialogue: 0,0:16:01.46,0:16:03.29,Default,,0,0,0,,Сіз мұны осылай жасай аласыз ба?
Dialogue: 0,0:16:03.42,0:16:04.92,Default,,0,0,0,,А, мен киімімді ауыстырайын!
Dialogue: 0,0:16:06.96,0:16:08.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:09.96,0:16:13.18,Default,,0,0,0,,＜Неге арқанмен секіру керек? Бірақ...＞
Dialogue: 0,0:16:13.84,0:16:16.35,Default,,0,0,0,,Сиқыршылар үшін қару көп емес.
Dialogue: 0,0:16:16.89,0:16:19.60,Default,,0,0,0,,Жарайды, сиқыр - бұл қару.
Dialogue: 0,0:16:19.77,0:16:20.60,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:20.73,0:16:21.68,Default,,0,0,0,,<Хмм...>
Dialogue: 0,0:16:21.85,0:16:24.31,Default,,0,0,0,,Бұл Gachi Fighter үшін.
Dialogue: 0,0:16:24.44,0:16:26.81,Default,,0,0,0,,Сейка-сан, сен Gachi Fighter ойынын ойнайсың ба?
Dialogue: 0,0:16:26.94,0:16:28.48,Default,,0,0,0,,А... Маған ұнамайды.
Dialogue: 0,0:16:28.61,0:16:31.40,Default,,0,0,0,,<Жарайды, мен қауіпті қарудан аулақ болдым.>
Dialogue: 0,0:16:31.53,0:16:32.61,Default,,0,0,0,,Сонда бұл не?
Dialogue: 0,0:16:32.90,0:16:35.11,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:35.91,0:16:38.41,Default,,0,0,0,,Бұл кунг-фудың ауыр қаруы.
Dialogue: 0,0:16:38.53,0:16:40.58,Default,,0,0,0,,Сіз мұны істейсіз бе? Гачи кунг-фу...
Dialogue: 0,0:16:40.75,0:16:42.62,Default,,0,0,0,,А, мынаны маған берші!
Dialogue: 0,0:16:42.75,0:16:46.46,Default,,0,0,0,,<Не, сізге шын бөлігі ұнамады ма? ＞
Dialogue: 0,0:16:46.63,0:16:48.04,Default,,0,0,0,,Бұл нунчаку ма?
Dialogue: 0,0:16:48.17,0:16:51.51,Default,,0,0,0,,А, жоқ, оның жанында...
Dialogue: 0,0:16:51.63,0:16:53.22,Default,,0,0,0,,<Не? Арқанмен секіру!?>
Dialogue: 0,0:16:53.34,0:16:54.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:55.93,0:16:58.80,Default,,0,0,0,,Аа... Көздерің керемет...
Dialogue: 0,0:16:58.97,0:17:03.23,Default,,0,0,0,,Бұл секіру арқан кунг-фу қолданушылары үшін негізгі және соңғы қару болып табылады.
Dialogue: 0,0:17:03.35,0:17:05.65,Default,,0,0,0,,Сіз әуесқой емессіз...
Dialogue: 0,0:17:05.77,0:17:07.27,Default,,0,0,0,,<Не...>
Dialogue: 0,0:17:07.40,0:17:09.86,Default,,0,0,0,,Қатты жаттығыңыз!
Dialogue: 0,0:17:12.19,0:17:15.53,Default,,0,0,0,,<Білмеймін, бірақ сізге рахмет, қару дүкеніндегі қария>
Dialogue: 0,0:17:15.66,0:17:18.53,Default,,0,0,0,,Ойласам, біз ұзақ уақыт сөйлеспеген сияқтымыз
Dialogue: 0,0:17:18.87,0:17:21.04,Default,,0,0,0,,Сіздің семіз екеніңізді ескерсек, бұл таңқаларлық!
Dialogue: 0,0:17:21.16,0:17:24.16,Default,,0,0,0,,<Жарақаттанбау үшін міндетті түрде мұқият дәріс оқыңыз>
Dialogue: 0,0:17:24.75,0:17:28.17,Default,,0,0,0,,(арқанның дыбысы)
Dialogue: 0,0:17:32.26,0:17:33.13,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:33.26,0:17:34.84,Default,,0,0,0,,Мен мұны жақсы білемін бе?
Dialogue: 0,0:17:34.97,0:17:37.26,Default,,0,0,0,,Ах, бұл керемет жақсарту жылдамдығы.
Dialogue: 0,0:17:37.39,0:17:38.18,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:38.34,0:17:39.30,Default,,0,0,0,,Не болды?
Dialogue: 0,0:17:40.22,0:17:42.52,Default,,0,0,0,,Мен де сол баланы оқытқым келеді.
Dialogue: 0,0:17:42.64,0:17:44.68,Default,,0,0,0,,Анау бала... ол ма?
Dialogue: 0,0:17:44.81,0:17:45.81,Default,,0,0,0,,Иә...
Dialogue: 0,0:17:45.94,0:17:48.81,Default,,0,0,0,,Аты-жөні маған әлі айтылмады...
Dialogue: 0,0:17:49.11,0:17:51.19,Default,,0,0,0,,Маған айтқың келмей ме?
Dialogue: 0,0:17:51.61,0:17:52.73,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:52.86,0:17:56.45,Default,,0,0,0,,<Ал, мен бұрынғы әлемімнен жаңа ғана қаштым...>
Dialogue: 0,0:17:56.78,0:17:59.41,Default,,0,0,0,,Біз жақсы дос болғанымызды қалаймын...
Dialogue: 0,0:17:59.53,0:18:01.33,Default,,0,0,0,,Олай болса, жақсырақ жол бар.
Dialogue: 0,0:18:01.45,0:18:02.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:02.79,0:18:04.04,Default,,0,0,0,,Фу…
Dialogue: 0,0:18:04.16,0:18:06.96,Default,,0,0,0,,<Сондықтан мен қазір осындамын...>
Dialogue: 0,0:18:08.00,0:18:10.13,Default,,0,0,0,,Секіргенде қолды төмен түсіру
Dialogue: 0,0:18:10.25,0:18:13.80,Default,,0,0,0,,Бір секіргенде екі рет бұрылсаң, қос секіру!
Dialogue: 0,0:18:13.92,0:18:15.84,Default,,0,0,0,,Ой, сен жақсысың (қол шапалақтау)
Dialogue: 0,0:18:16.05,0:18:17.88,Default,,0,0,0,,Содан кейін көріңіз.
Dialogue: 0,0:18:18.01,0:18:19.09,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:18:19.89,0:18:20.80,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:22.05,0:18:23.68,Default,,0,0,0,,Керемет! Мен жақсымын!
Dialogue: 0,0:18:23.81,0:18:26.31,Default,,0,0,0,,Бірақ менің шашым... Менің ойымша, сәл қию керек.
Dialogue: 0,0:18:26.43,0:18:28.35,Default,,0,0,0,,Саған да қысқалар жарасады деп ойлаймын!
Dialogue: 0,0:18:28.48,0:18:30.73,Default,,0,0,0,,Оның қазір бар жұмсақтығы да жақсы!
Dialogue: 0,0:18:30.86,0:18:31.86,Default,,0,0,0,,Хехе
Dialogue: 0,0:18:32.06,0:18:33.82,Default,,0,0,0,,Мм... Сонымен...
Dialogue: 0,0:18:33.94,0:18:34.98,Default,,0,0,0,,Ал...
Dialogue: 0,0:18:35.19,0:18:38.45,Default,,0,0,0,,Мен сенің атыңды айтып отырмын...
Dialogue: 0,0:18:41.49,0:18:43.58,Default,,0,0,0,,А, жақсысың ба?
Dialogue: 0,0:18:43.74,0:18:45.79,Default,,0,0,0,,Жарайды, мен ұсталдым.
Dialogue: 0,0:18:45.91,0:18:49.17,Default,,0,0,0,,<Сіз өз атыңыздың аталғанын қаламайтын сияқтысыз.>
Dialogue: 0,0:18:49.29,0:18:52.38,Default,,0,0,0,,Негізі, мен... лақап ат ойладым.
Dialogue: 0,0:18:52.71,0:18:54.25,Default,,0,0,0,,Лақап аты?
Dialogue: 0,0:18:54.38,0:18:56.13,Default,,0,0,0,,Шигеру-санмен кеңесіңіз...
Dialogue: 0,0:18:57.05,0:19:00.05,Default,,0,0,0,,Есіме жұмсақ естілетін сөз түсті...
Dialogue: 0,0:19:00.18,0:19:03.14,Default,,0,0,0,,Ағылшын және француз тілдеріндегі «бриз» сөздері бойынша пьеса...
Dialogue: 0,0:19:04.14,0:19:05.26,Default,,0,0,0,,Лидс
Dialogue: 0,0:19:05.39,0:19:06.77,Default,,0,0,0,,Ха...
Dialogue: 0,0:19:08.68,0:19:10.27,Default,,0,0,0,,Сіз туралы...
Dialogue: 0,0:19:10.64,0:19:12.98,Default,,0,0,0,,Мен сізді Лидс деп атай аламын ба?
Dialogue: 0,0:19:18.49,0:19:19.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:23.16,0:19:24.41,Default,,0,0,0,,(Исуми Миямура) Ишикава-кун, сенде абсурдтай көп зат бар, иә?
Dialogue: 0,0:19:25.49,0:19:26.33,Default,,0,0,0,,Әй!
Dialogue: 0,0:19:27.50,0:19:28.33,Default,,0,0,0,,<Ах...>
Dialogue: 0,0:19:28.45,0:19:30.62,Default,,0,0,0,,<Ол қандай физикалық қабілет!?>
Dialogue: 0,0:19:31.08,0:19:35.38,Default,,0,0,0,,<Ойлап қарасам, бірінші шайқаста бірде-бір жарақат алған жоқпын...>
Dialogue: 0,0:19:36.09,0:19:37.92,Default,,0,0,0,,<Сен кімсің...>
Dialogue: 0,0:19:39.51,0:19:40.55,Default,,0,0,0,,О! (қол шапалақтау)
Dialogue: 0,0:19:40.67,0:19:41.88,Default,,0,0,0,,Керемет!
Dialogue: 0,0:19:42.34,0:19:43.76,Default,,0,0,0,,Сіз гимнастсыз ба?
Dialogue: 0,0:19:43.89,0:19:46.47,Default,,0,0,0,,Маған қайта көрсет (әйел) Бұл керемет!
Dialogue: 0,0:19:46.60,0:19:47.93,Default,,0,0,0,,Құндыз жүріп келеді.
Dialogue: 0,0:19:48.10,0:19:50.31,Default,,0,0,0,,А, у... (Еркек) Эй, эй, сен шытырманшысың ба?
Dialogue: 0,0:19:50.85,0:19:52.44,Default,,0,0,0,,Менің кешіме келгің келе ме?
Dialogue: 0,0:19:52.56,0:19:53.81,Default,,0,0,0,,Жақсы емдеу.
Dialogue: 0,0:19:53.98,0:19:55.82,Default,,0,0,0,,Әй... Әй (Еркек) Әй, қаш!
Dialogue: 0,0:19:55.94,0:19:56.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:58.07,0:19:59.19,Default,,0,0,0,,Ух ＜А...＞
Dialogue: 0,0:19:59.57,0:20:01.20,Default,,0,0,0,,(Сейканың жылауы)
Dialogue: 0,0:20:01.32,0:20:03.45,Default,,0,0,0,,Не? не? (Қыз) Не болды?
Dialogue: 0,0:20:04.49,0:20:06.45,Default,,0,0,0,,<Аа, мен көмектесе алмаймын! ＞
Dialogue: 0,0:20:07.87,0:20:09.45,Default,,0,0,0,,Уау! (Адамдар айқайлайды)
Dialogue: 0,0:20:09.83,0:20:12.08,Default,,0,0,0,,Бусса! (Еркек) Күзетшіні шақыр!
Dialogue: 0,0:20:12.25,0:20:13.71,Default,,0,0,0,,Жоқ! ол
Dialogue: 0,0:20:13.96,0:20:15.58,Default,,0,0,0,,Партия жолдасы
Dialogue: 0,0:20:15.71,0:20:17.96,Default,,0,0,0,,Шынайы ма? (Әйел) Құбыжық сияқты
Dialogue: 0,0:20:18.13,0:20:19.55,Default,,0,0,0,,А, мен...
Dialogue: 0,0:20:19.67,0:20:22.47,Default,,0,0,0,,Мен Сейка-санның бақытты болғанын қаладым...
Dialogue: 0,0:20:22.84,0:20:24.47,Default,,0,0,0,,Э-э…
Dialogue: 0,0:20:24.59,0:20:26.39,Default,,0,0,0,,Кем дегенде жауап беріңіз.
Dialogue: 0,0:20:26.51,0:20:28.22,Default,,0,0,0,,Қатерлі ісіктерді елемеу
Dialogue: 0,0:20:28.47,0:20:30.18,Default,,0,0,0,,Бұл өте жақсы жауап.
Dialogue: 0,0:20:30.31,0:20:31.10,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:31.43,0:20:33.56,Default,,0,0,0,,Ууууууууу...
Dialogue: 0,0:20:34.48,0:20:37.31,Default,,0,0,0,,Кешіріңіз! О, күте тұрыңыз ...
Dialogue: 0,0:20:38.11,0:20:40.61,Default,,0,0,0,,Ей, біз келдік. Шапшаңды босат.
Dialogue: 0,0:20:40.99,0:20:42.99,Default,,0,0,0,,Иә... (иіскеу дыбысы)
Dialogue: 0,0:20:43.11,0:20:44.36,Default,,0,0,0,,<Тоқтату>
Dialogue: 0,0:20:44.70,0:20:47.24,Default,,0,0,0,,Иә, ертеңгі ас 3 лира.
Dialogue: 0,0:20:47.37,0:20:48.49,Default,,0,0,0,,Иә...
Dialogue: 0,0:20:49.49,0:20:50.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:50.70,0:20:51.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:53.33,0:20:56.08,Default,,0,0,0,,Шигеру-сан! Хат сол қыздан!
Dialogue: 0,0:20:56.21,0:20:57.25,Default,,0,0,0,,Не?
Dialogue: 0,0:20:57.63,0:20:59.71,Default,,0,0,0,,«Бұрынғы үшін кешіріңіз».
Dialogue: 0,0:20:59.84,0:21:02.38,Default,,0,0,0,,«Тамаша лақап ат үшін рахмет».
Dialogue: 0,0:21:02.51,0:21:05.38,Default,,0,0,0,,«Достар болуды өтінемін».
Dialogue: 0,0:21:05.68,0:21:07.26,Default,,0,0,0,,«Лидстен»
Dialogue: 0,0:21:07.43,0:21:09.26,Default,,0,0,0,,Әй, жақсы...
Dialogue: 0,0:21:09.51,0:21:11.60,Default,,0,0,0,,Мен сол баланы іздеймін!
Dialogue: 0,0:21:11.77,0:21:12.73,Default,,0,0,0,,Иә.
Dialogue: 0,0:21:16.31,0:21:19.77,Default,,0,0,0,,Міне, Сейка-сан кетті.
Dialogue: 0,0:21:23.69,0:21:25.32,Default,,0,0,0,,Менің саған айтар сөзім бар...
Dialogue: 0,0:21:25.49,0:21:27.82,Default,,0,0,0,,Мен кез келген бөлмеге кіре аламын ба?
Dialogue: 0,0:21:28.24,0:21:30.91,Default,,0,0,0,,Хмм... кейінірек бұл жағдайды жасамаңыз.
Dialogue: 0,0:21:35.92,0:21:37.67,Default,,0,0,0,,Кешіріңіз!! <Жоқ! ＞
Dialogue: 0,0:21:38.17,0:21:40.00,Default,,0,0,0,,<Догезадан секіру!?>
Dialogue: 0,0:21:40.13,0:21:43.05,Default,,0,0,0,,<Физикалық қабілетіңізді сәждеге салмадыңыз ба? ＞
Dialogue: 0,0:21:44.09,0:21:45.72,Default,,0,0,0,,Кешіріңіз! Кешіріңіз!
Dialogue: 0,0:21:45.84,0:21:47.43,Default,,0,0,0,,Жүріңдер, тұрыңдар.
Dialogue: 0,0:21:47.68,0:21:50.30,Default,,0,0,0,,Дәлірек айтсақ, сен неге менен кешірім сұрайсың?
Dialogue: 0,0:21:50.72,0:21:51.93,Default,,0,0,0,,Шигеру-сан...
Dialogue: 0,0:21:52.35,0:21:53.85,Default,,0,0,0,,Сіздің тегіңіз...
Dialogue: 0,0:21:54.02,0:21:56.31,Default,,0,0,0,,Бұл шын мәнінде Сасаки емес, солай ма?
Dialogue: 0,0:21:56.44,0:21:57.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:57.81,0:22:00.56,Default,,0,0,0,,Сіздің шын есіміңіз Шигеру Йошиока
Dialogue: 0,0:22:01.57,0:22:03.28,Default,,0,0,0,,Сейджидің қайырымды адамы
Dialogue: 0,0:22:03.40,0:22:06.15,Default,,0,0,0,,Y мырза, солай ма?
Dialogue: 0,0:22:10.28,0:22:13.24,Default,,0,0,0,,♪～
Dialogue: 0,0:23:35.70,0:23:38.66,Default,,0,0,0,,～♪
Dialogue: 0,0:23:40.16,0:23:46.16,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory