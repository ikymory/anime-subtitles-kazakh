Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.33,0:00:02.83,Default,,0,0,0,,Фу… (есіктің ашылған дыбысы)
Dialogue: 0,0:00:02.96,0:00:03.92,Default,,0,0,0,,Көмектесіңіз!
Dialogue: 0,0:00:04.08,0:00:06.67,Default,,0,0,0,,Менің әпкем, әпкем!
Dialogue: 0,0:00:07.13,0:00:11.51,Default,,0,0,0,,Мүмкін сіз... ол қыздың інісі шығарсыз?
Dialogue: 0,0:00:12.38,0:00:15.30,Default,,0,0,0,,Уф, әпкем... Уф
Dialogue: 0,0:00:15.43,0:00:18.89,Default,,0,0,0,,Бетінде тыртығы бар адам мені алып кетті...
Dialogue: 0,0:00:19.10,0:00:20.47,Default,,0,0,0,,Ха!
Dialogue: 0,0:00:20.60,0:00:22.02,Default,,0,0,0,,Менің бетіме сызат түсті...
Dialogue: 0,0:00:22.60,0:00:23.77,Default,,0,0,0,,Бұл адам ба?
Dialogue: 0,0:00:23.98,0:00:25.73,Default,,0,0,0,,Иә! Бұл дұрыс
Dialogue: 0,0:00:25.94,0:00:28.32,Default,,0,0,0,,Өтінемін! Әпкеме көмектес
Dialogue: 0,0:00:30.36,0:00:32.53,Default,,0,0,0,,Лия мырза, сіз не істеуді жоспарлап отырсыз...
Dialogue: 0,0:00:32.95,0:00:37.03,Default,,0,0,0,,Мен адамдарды дереу компанияға жинаймын. Өтінемін, соншалықты немқұрайлы болмаңыз!
Dialogue: 0,0:00:38.37,0:00:39.45,Default,,0,0,0,,Лия мырза?
Dialogue: 0,0:00:39.58,0:00:43.29,Default,,0,0,0,,Иә, бұл дұрыс болуы мүмкін.
Dialogue: 0,0:00:44.16,0:00:47.83,Default,,0,0,0,,Бірақ сіз білесіз бе, мен бұл мәселені шешуім керек...
Dialogue: 0,0:00:48.75,0:00:50.34,Default,,0,0,0,,«Идиот»
Dialogue: 0,0:00:50.50,0:00:52.80,Default,,0,0,0,,Ха! Ол кетті!
Dialogue: 0,0:00:53.17,0:00:54.76,Default,,0,0,0,,<Арнайы ескертпелермен қабілет...>
Dialogue: 0,0:00:54.88,0:00:56.09,Default,,0,0,0,,Шигеру-сан!
Dialogue: 0,0:00:56.30,0:00:58.01,Default,,0,0,0,,Өзімді жаңарғандай сезінемін, өзімді жаңарғандай сезінемін! Хехехехе
Dialogue: 0,0:00:58.14,0:01:01.56,Default,,0,0,0,,Лия сыйлық алып кеткен қызды құтқаруға барады...
Dialogue: 0,0:01:01.68,0:01:03.98,Default,,0,0,0,,Е! Мен сені қуамын!
Dialogue: 0,0:01:04.10,0:01:05.31,Default,,0,0,0,,Мен де барамын!
Dialogue: 0,0:01:08.61,0:01:10.48,Default,,0,0,0,,Лия мырза...
Dialogue: 0,0:01:13.15,0:01:13.99,Default,,0,0,0,,Уау
Dialogue: 0,0:01:14.82,0:01:17.99,Default,,0,0,0,,<Бұл басқа Габе!?>
Dialogue: 0,0:01:19.16,0:01:20.99,Default,,0,0,0,,Ха!
Dialogue: 0,0:01:21.12,0:01:22.29,Default,,0,0,0,,<Карина…>
Dialogue: 0,0:01:22.41,0:01:23.45,Default,,0,0,0,,Аа…
Dialogue: 0,0:01:24.04,0:01:29.50,Default,,0,0,0,,Шигеру-кун, мен уәде еткендей, таза ақ орамалыңды дақтаймын.
Dialogue: 0,0:01:29.79,0:01:32.84,Default,,0,0,0,,Мен Лияны Сейка-чаннан алып кетемін.
Dialogue: 0,0:01:32.96,0:01:35.76,Default,,0,0,0,,Жарайды... Мен саған кедергі келтірмеймін, жарай ма?
Dialogue: 0,0:01:35.92,0:01:40.22,Default,,0,0,0,,Лия-сан екеуміздің ара-қатынасымыз бар сияқты...
Dialogue: 0,0:01:40.39,0:01:41.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:43.52,0:01:44.56,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:45.60,0:01:47.60,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:01:47.73,0:01:49.52,Default,,0,0,0,,Сізді қамал қабырғасының сыртына лақтырып жіберді ме?
Dialogue: 0,0:01:49.65,0:01:52.02,Default,,0,0,0,,Шигеру-сан, енді әйелдер ше?
Dialogue: 0,0:01:52.52,0:01:53.69,Default,,0,0,0,,Лидс…
Dialogue: 0,0:01:53.82,0:01:58.24,Default,,0,0,0,,Шын мәнінде, Орднунг Найзасында менен басқа абсолютті құдай бар.
Dialogue: 0,0:01:58.45,0:01:59.28,Default,,0,0,0,,Әй!
Dialogue: 0,0:01:59.41,0:02:02.91,Default,,0,0,0,,Тағы бір абсолютті құдай... Карина
Dialogue: 0,0:02:04.29,0:02:05.33,Default,,0,0,0,,Шигеру-сан
Dialogue: 0,0:02:05.45,0:02:08.67,Default,,0,0,0,,Оның аты Карина емес, Не?
Dialogue: 0,0:02:08.87,0:02:12.13,Default,,0,0,0,,Оның аты «Рейко Ширатори» Ах...
Dialogue: 0,0:02:12.71,0:02:15.92,Default,,0,0,0,,<Шигеру-санға түскен «Киоко Ширатори»...>
Dialogue: 0,0:02:16.84,0:02:18.55,Default,,0,0,0,,<Менің егіз әпкем! ＞
Dialogue: 0,0:02:20.64,0:02:23.60,Default,,0,0,0,,♪～
Dialogue: 0,0:03:44.47,0:03:47.43,Default,,0,0,0,,～♪
Dialogue: 0,0:03:50.93,0:03:54.90,Default,,0,0,0,,Като-сан, Риа-санның барған сыйы туралы мәлімет...
Dialogue: 0,0:03:55.06,0:03:56.48,Default,,0,0,0,,Міне!
Dialogue: 0,0:03:57.40,0:03:58.73,Default,,0,0,0,,Кайдо…
Dialogue: 0,0:03:58.86,0:04:01.65,Default,,0,0,0,,Ол да Орднунг Найзасының мүшесі сияқты.
Dialogue: 0,0:04:01.90,0:04:04.16,Default,,0,0,0,,Мен Лияның артынан қуып келемін.
Dialogue: 0,0:04:04.28,0:04:05.20,Default,,0,0,0,,Сейка-сан!
Dialogue: 0,0:04:05.37,0:04:08.20,Default,,0,0,0,,Өйткені, өйткені Лия мырза
Dialogue: 0,0:04:09.29,0:04:11.04,Default,,0,0,0,,Ол менің досым!
Dialogue: 0,0:04:12.21,0:04:13.83,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:04:13.96,0:04:16.54,Default,,0,0,0,,Ол біздің компания үшін маңызды ресурс болып табылады.
Dialogue: 0,0:04:17.63,0:04:20.17,Default,,0,0,0,,Мен бұл баланы сіздің қамқорлығыңызға қалдыра аламын ба?
Dialogue: 0,0:04:20.30,0:04:22.59,Default,,0,0,0,,Хмм, иә! (Кай) Әрине.
Dialogue: 0,0:04:23.26,0:04:26.34,Default,,0,0,0,,Қымбат достарымызды құтқаруға барайық!
Dialogue: 0,0:04:27.26,0:04:28.56,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:29.39,0:04:32.81,Default,,0,0,0,,Каринаның шын аты - Рейко Ширатори
Dialogue: 0,0:04:33.35,0:04:37.81,Default,,0,0,0,,Басқаша айтқанда, маған түскен Киоко Шираторидің егіз әпкесі?
Dialogue: 0,0:04:38.06,0:04:39.11,Default,,0,0,0,,Иә
Dialogue: 0,0:04:39.32,0:04:40.57,Default,,0,0,0,,Кикуна Риа
Dialogue: 0,0:04:40.69,0:04:43.82,Default,,0,0,0,,Ол алдыңғы дүниеде Киоко Шираториге қамқор болған сияқты.
Dialogue: 0,0:04:44.65,0:04:46.45,Default,,0,0,0,,Мен Каринадан күтпеген едім...
Dialogue: 0,0:04:48.99,0:04:52.29,Default,,0,0,0,,Әйтеуір Риа барған Кайдоға барайық.
Dialogue: 0,0:04:52.45,0:04:55.92,Default,,0,0,0,,Сахна артында Карина жіпті тартып жатқан шығар.
Dialogue: 0,0:04:56.83,0:04:57.71,Default,,0,0,0,,Иә
Dialogue: 0,0:05:03.09,0:05:05.72,Default,,0,0,0,,(Қыздың үрейлі дауысы)
Dialogue: 0,0:05:07.80,0:05:10.64,Default,,0,0,0,,Лия, сен осындасың ба?
Dialogue: 0,0:05:10.85,0:05:14.06,Default,,0,0,0,,Кайдо, сен неге уәдеңді бұздың?
Dialogue: 0,0:05:14.18,0:05:16.35,Default,,0,0,0,,Мен ол баланы сатып алуым керек еді, солай ма?
Dialogue: 0,0:05:16.56,0:05:19.15,Default,,0,0,0,,Кешіріңіз, бірақ сізге көп ақша берілді.
Dialogue: 0,0:05:19.27,0:05:20.86,Default,,0,0,0,,Сіз бұған қарсы шыға алмайсыз, солай ма?
Dialogue: 0,0:05:21.36,0:05:26.20,Default,,0,0,0,,Егер сіз көбірек қоссаңыз, мен бұл туралы ойлануға қарсы болмас едім.
Dialogue: 0,0:05:27.66,0:05:29.37,Default,,0,0,0,,Әй!
Dialogue: 0,0:05:29.82,0:05:31.12,Default,,0,0,0,,Ол «Fool» картасының белгісін арқалаған Стэнді қолданушы
Dialogue: 0,0:05:31.83,0:05:33.66,Default,,0,0,0,,Кім! Кайдо
Dialogue: 0,0:05:33.79,0:05:35.08,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:05:35.21,0:05:36.37,Default,,0,0,0,,Мынау ма?
Dialogue: 0,0:05:37.12,0:05:40.00,Default,,0,0,0,,Сіз сияқты адамға жеткілікті, солай ма?
Dialogue: 0,0:05:40.13,0:05:43.00,Default,,0,0,0,,Бұдан артық пайда жоқ, сондықтан жай ғана жоғалып кет.
Dialogue: 0,0:05:43.13,0:05:44.17,Default,,0,0,0,,Неапольдың ең үздік жиһаз шебері Марионың ұлы болып дүниеге келген
Dialogue: 0,0:05:47.13,0:05:51.22,Default,,0,0,0,,Эй, эй! Сіздің атыңыз Риа Кикуна, солай ма?
Dialogue: 0,0:05:51.35,0:05:53.18,Default,,0,0,0,,Сонымен не?
Dialogue: 0,0:05:53.31,0:05:55.68,Default,,0,0,0,,Аха! Бұл хит!
Dialogue: 0,0:05:55.81,0:05:57.73,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:05:58.19,0:06:00.40,Default,,0,0,0,,Мен сені өлтіремін
Dialogue: 0,0:06:00.69,0:06:03.40,Default,,0,0,0,,Уф, неге мен?
Dialogue: 0,0:06:03.57,0:06:05.99,Default,,0,0,0,,Мен сіз туралы білмеймін
Dialogue: 0,0:06:06.86,0:06:10.95,Default,,0,0,0,,Сен білмесең де, біз білеміз.
Dialogue: 0,0:06:11.83,0:06:13.41,Default,,0,0,0,,Сен бар
Dialogue: 0,0:06:13.54,0:06:17.29,Default,,0,0,0,,Сол компанияда... ағам Висбриджде мені күтіп отыр.
Dialogue: 0,0:06:17.41,0:06:18.79,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:06:18.92,0:06:21.59,Default,,0,0,0,,Асығыңыз! Осы жолы сатылып қалғың келе ме?
Dialogue: 0,0:06:24.30,0:06:26.01,Default,,0,0,0,,Сіз мейірімдісіз, солай емес пе?
Dialogue: 0,0:06:26.13,0:06:28.59,Default,,0,0,0,,Сейка-чанның досы күткендей.
Dialogue: 0,0:06:28.93,0:06:30.76,Default,,0,0,0,,Сейка-чан?
Dialogue: 0,0:06:30.93,0:06:33.10,Default,,0,0,0,,Сейка-санмен қандай қарым-қатынасыңыз бар...
Dialogue: 0,0:06:33.39,0:06:35.22,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:06:35.35,0:06:37.23,Default,,0,0,0,,Сондай таза ақ бала
Dialogue: 0,0:06:37.35,0:06:41.15,Default,,0,0,0,,I don't like being guided by God.
Dialogue: 0,0:06:41.44,0:06:44.52,Default,,0,0,0,,Сондықтан мен енді Құдайға сене алмаймын
Dialogue: 0,0:06:44.69,0:06:48.36,Default,,0,0,0,,Мен оны қара түске бояймын.
Dialogue: 0,0:06:51.11,0:06:52.24,Default,,0,0,0,,Казино маңызды
Dialogue: 0,0:06:52.37,0:06:55.29,Default,,0,0,0,,Кажитаның өлтірілгеніне еш күмәнім жоқ...
Dialogue: 0,0:06:55.41,0:06:58.87,Default,,0,0,0,,Yes, although it is ostensibly a cave-in accident.
Dialogue: 0,0:06:59.00,0:07:02.33,Default,,0,0,0,,Каджитаны анау әйелден басқа ешкім өлтіре алмайды.
Dialogue: 0,0:07:02.46,0:07:04.00,Default,,0,0,0,,Неге екенін білмеймін
Dialogue: 0,0:07:04.13,0:07:07.13,Default,,0,0,0,,There's no guarantee that we'll all face the same thing.
Dialogue: 0,0:07:07.26,0:07:10.59,Default,,0,0,0,,Төлеміне сараң болды.
Dialogue: 0,0:07:11.18,0:07:15.14,Default,,0,0,0,,Бұл жағдай... көп ақша табу мүмкіндігі.
Dialogue: 0,0:07:15.26,0:07:19.52,Default,,0,0,0,,Seika-chan's friend In other words, if I kill you
Dialogue: 0,0:07:19.64,0:07:22.90,Default,,0,0,0,,Ол бала мені жек көреді.
Dialogue: 0,0:07:23.02,0:07:27.15,Default,,0,0,0,,I'm stained black and I no longer believe in God.
Dialogue: 0,0:07:27.90,0:07:28.86,Default,,0,0,0,,Қайдасың?
Dialogue: 0,0:07:29.44,0:07:31.07,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:07:31.20,0:07:34.87,Default,,0,0,0,,Осындай бұрмаланған себеппен олар маған қалағаныңызды жасайды деп ойлайсыз ба?
Dialogue: 0,0:07:34.99,0:07:37.12,Default,,0,0,0,,Аха, солай ма?
Dialogue: 0,0:07:37.24,0:07:41.71,Default,,0,0,0,,Actually, there's another reason why I set my eyes on you.
Dialogue: 0,0:07:42.50,0:07:44.46,Default,,0,0,0,,Киоко Ширатори есіңізде ме?
Dialogue: 0,0:07:44.58,0:07:45.38,Default,,0,0,0,,Ха!
Dialogue: 0,0:07:45.84,0:07:49.13,Default,,0,0,0,,Есіңде ме? Киоко туралы
Dialogue: 0,0:07:49.26,0:07:51.59,Default,,0,0,0,,Бұл көздер...
Dialogue: 0,0:07:51.76,0:07:54.14,Default,,0,0,0,,Бұл шынымен Киоко ма?
Dialogue: 0,0:07:54.26,0:07:56.43,Default,,0,0,0,,Хмм? Жоқ?
Dialogue: 0,0:07:56.68,0:07:58.64,Default,,0,0,0,,Сонда сіз...
Dialogue: 0,0:07:58.77,0:08:02.44,Default,,0,0,0,,Хехехе Қорқынышты ма? Бірақ бәрібір
Dialogue: 0,0:08:02.85,0:08:05.40,Default,,0,0,0,,Бір сәтке ғана ауырады
Dialogue: 0,0:08:05.65,0:08:07.15,Default,,0,0,0,,Жоқ, жоқ...
Dialogue: 0,0:08:07.36,0:08:09.15,Default,,0,0,0,,«Мен Құдайға сенбеймін!»
Dialogue: 0,0:08:09.48,0:08:10.90,Default,,0,0,0,,Уф!
Dialogue: 0,0:08:11.24,0:08:12.90,Default,,0,0,0,,Кайдо!?
Dialogue: 0,0:08:13.07,0:08:15.32,Default,,0,0,0,,Иә? Менің күшім жоқ...
Dialogue: 0,0:08:17.12,0:08:19.70,Default,,0,0,0,,Хмм, сіз нені айтып тұрсыз?
Dialogue: 0,0:08:19.87,0:08:24.79,Default,,0,0,0,,Karina, you took advantage of the chaos at the casino to eliminate Kajita, didn't you?
Dialogue: 0,0:08:25.00,0:08:29.30,Default,,0,0,0,,Абсолюттік Құдай? Ұйымның күзетшісі? Жай қалжың
Dialogue: 0,0:08:29.75,0:08:32.22,Default,,0,0,0,,Мен ақшаның күшіне сенемін
Dialogue: 0,0:08:32.34,0:08:35.59,Default,,0,0,0,,I definitely don't believe in the Пауэр of God.
Dialogue: 0,0:08:36.22,0:08:37.35,Default,,0,0,0,,<Қазір...>
Dialogue: 0,0:08:37.47,0:08:39.56,Default,,0,0,0,,«Идиот»
Dialogue: 0,0:08:39.72,0:08:43.02,Default,,0,0,0,,Hmm, it would be troublesome if someone called for help.
Dialogue: 0,0:08:43.14,0:08:45.77,Default,,0,0,0,,With his abilities, he shouldn't be able to go far.
Dialogue: 0,0:08:45.90,0:08:47.19,Default,,0,0,0,,Қазір табыңыз!
Dialogue: 0,0:08:47.31,0:08:48.36,Default,,0,0,0,,О!
Dialogue: 0,0:08:48.57,0:08:51.19,Default,,0,0,0,,If that's the case, you won't be able to move for a while.
Dialogue: 0,0:08:51.32,0:08:53.82,Default,,0,0,0,,Лияны тапқаннан кейін мен сені де өлтіремін.
Dialogue: 0,0:08:54.45,0:08:57.16,Default,,0,0,0,,Егер менде абсолютті құдайды өлтіретін күшім болса ше?
Dialogue: 0,0:08:57.28,0:08:59.74,Default,,0,0,0,,Сіз көбірек ақша ала аласыз
Dialogue: 0,0:08:59.87,0:09:03.20,Default,,0,0,0,,Міне, Орднунг Найзасы.
Dialogue: 0,0:09:03.62,0:09:08.04,Default,,0,0,0,,Егер сізде кек болса, төлемге сараң болғаныңыз үшін өзіңізді жек көруіңіз керек.
Dialogue: 0,0:09:08.17,0:09:10.34,Default,,0,0,0,,Қорлау…
Dialogue: 0,0:09:10.46,0:09:12.96,Default,,0,0,0,,(Рианың қатты тыныс алуы)
Dialogue: 0,0:09:15.72,0:09:17.89,Default,,0,0,0,,Лия! тістері?
Dialogue: 0,0:09:18.26,0:09:19.68,Default,,0,0,0,,(Бакуго) Сол жексұрын данышпан... Маған түк те керек емес!
Dialogue: 0,0:09:20.10,0:09:21.64,Default,,0,0,0,,А, сен ше?
Dialogue: 0,0:09:22.97,0:09:27.65,Default,,0,0,0,,Мен
Dialogue: 0,0:09:28.23,0:09:31.69,Default,,0,0,0,,Қаңғыбас батыр Альдин!
Dialogue: 0,0:09:31.82,0:09:35.15,Default,,0,0,0,,Мен зұлымдықты жоюға келдім!
Dialogue: 0,0:09:36.99,0:09:38.66,Default,,0,0,0,,Не? Иә...
Dialogue: 0,0:09:39.16,0:09:42.45,Default,,0,0,0,,Лия! Батыр - сенуге болатын адам.
Dialogue: 0,0:09:42.58,0:09:45.04,Default,,0,0,0,,Қалғанын маған қалдыр... Жоқ, жоқ!
Dialogue: 0,0:09:45.46,0:09:46.62,Default,,0,0,0,,Лия мырза?
Dialogue: 0,0:09:47.04,0:09:49.63,Default,,0,0,0,,Қанша батыл болсаң да, әлгі әйел...
Dialogue: 0,0:09:49.79,0:09:51.92,Default,,0,0,0,,Құдайға мүлдем сәйкес келмейді
Dialogue: 0,0:09:52.09,0:09:53.63,Default,,0,0,0,,Абсолюттік Құдай?
Dialogue: 0,0:09:54.17,0:09:56.42,Default,,0,0,0,,Сейка-сан, тез қаш.
Dialogue: 0,0:09:56.63,0:09:59.64,Default,,0,0,0,,Ол әйел сен туралы ойлайды...
Dialogue: 0,0:09:59.84,0:10:01.30,Default,,0,0,0,,Жарайды
Dialogue: 0,0:10:01.47,0:10:03.93,Default,,0,0,0,,Мен мән-жайларды түсінбеймін.
Dialogue: 0,0:10:04.14,0:10:06.68,Default,,0,0,0,,Мен енді жыламаймын деп шештім.
Dialogue: 0,0:10:07.02,0:10:08.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:08.65,0:10:11.65,Default,,0,0,0,,Досым қиналса, мен оған көмектескім келеді.
Dialogue: 0,0:10:12.02,0:10:14.07,Default,,0,0,0,,Сейка-сан...
Dialogue: 0,0:10:15.86,0:10:16.95,Default,,0,0,0,,<Міне, болды! ＞
Dialogue: 0,0:10:17.07,0:10:19.20,Default,,0,0,0,,Альдин! Мен саған көмектесемін!
Dialogue: 0,0:10:21.20,0:10:23.66,Default,,0,0,0,,Иә!? (Сэйджи) Сен кімсің!
Dialogue: 0,0:10:23.87,0:10:25.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:27.04,0:10:28.37,Default,,0,0,0,,<Айна? ＞
Dialogue: 0,0:10:28.96,0:10:30.21,Default,,0,0,0,,<Хмм!? Бұл кім? ＞
Dialogue: 0,0:10:32.67,0:10:34.96,Default,,0,0,0,,<Мм! Бұл...>
Dialogue: 0,0:10:35.09,0:10:36.42,Default,,0,0,0,,<Бұл менмін! ＞
Dialogue: 0,0:10:37.09,0:10:38.93,Default,,0,0,0,,<Сәлеметсіздерме! ＞
Dialogue: 0,0:10:39.05,0:10:41.14,Default,,0,0,0,,♬~
Dialogue: 0,0:10:41.26,0:10:42.93,Default,,0,0,0,,А, сен...
Dialogue: 0,0:10:43.64,0:10:46.52,Default,,0,0,0,,«Өтінемін... маған көмектесіңізші».
Dialogue: 0,0:10:46.64,0:10:49.85,Default,,0,0,0,,«Кейде ақ боз атты ханзададай киіну керемет».
Dialogue: 0,0:10:50.35,0:10:53.06,Default,,0,0,0,,Ханзада! Мен сені сағындым!
Dialogue: 0,0:10:53.19,0:10:54.65,Default,,0,0,0,,<Оме туралы арнайы ескертулер! ＞
Dialogue: 0,0:10:54.77,0:10:56.99,Default,,0,0,0,,<Бұл жай ғана жүз! ＞
Dialogue: 0,0:10:57.65,0:10:59.57,Default,,0,0,0,,Ібіліс бала, бұл кім?
Dialogue: 0,0:10:59.70,0:11:02.45,Default,,0,0,0,,Мм, мм... одақтастар?
Dialogue: 0,0:11:02.87,0:11:05.45,Default,,0,0,0,,Сіз мені Альдеан ретінде білетінсіз, солай ма?
Dialogue: 0,0:11:06.08,0:11:07.95,Default,,0,0,0,,Сіз...
Dialogue: 0,0:11:08.08,0:11:09.96,Default,,0,0,0,,Мен...
Dialogue: 0,0:11:10.12,0:11:12.96,Default,,0,0,0,,<Шо, бұл мен екенімді адамдардың білгенін қаламаймын...>
Dialogue: 0,0:11:14.17,0:11:16.21,Default,,0,0,0,,Ай сәулесі!
Dialogue: 0,0:11:16.80,0:11:18.97,Default,,0,0,0,,Зиг Шнайдер!
Dialogue: 0,0:11:19.13,0:11:20.76,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:20.88,0:11:21.72,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:11:21.93,0:11:24.18,Default,,0,0,0,,Лия сонда болды! Міне!
Dialogue: 0,0:11:24.30,0:11:27.97,Default,,0,0,0,,Әй, анау қанатты жігіттер... Кажитаның ойынханасын қиратқан да солар!
Dialogue: 0,0:11:28.10,0:11:29.68,Default,,0,0,0,,Не!
Dialogue: 0,0:11:29.85,0:11:34.15,Default,,0,0,0,,Қарғыс атсын, мен енді сол жігіттердің кесірінен қалада бизнес жасай алмаймын!
Dialogue: 0,0:11:34.27,0:11:36.90,Default,,0,0,0,,Оны қағып тастаңыз! (Миниондар) Эй!
Dialogue: 0,0:11:37.03,0:11:38.03,Default,,0,0,0,,Альдин!
Dialogue: 0,0:11:38.15,0:11:40.65,Default,,0,0,0,,Орднунг Найза менің де жауым!
Dialogue: 0,0:11:40.78,0:11:41.99,Default,,0,0,0,,Бірге күресейік!
Dialogue: 0,0:11:42.11,0:11:43.53,Default,,0,0,0,,Кешкі ас ішейік пе? О…
Dialogue: 0,0:11:43.66,0:11:45.53,Default,,0,0,0,,Ооо!
Dialogue: 0,0:11:45.91,0:11:47.49,Default,,0,0,0,,«Сорасензан»!
Dialogue: 0,0:11:47.66,0:11:49.12,Default,,0,0,0,,(Рюкю) Барлығының өмірі сорып алынып жатыр; тіпті дұрыс тұра да алмайды
Dialogue: 0,0:11:49.25,0:11:50.58,Default,,0,0,0,,«Синку Реппукьяку»!
Dialogue: 0,0:11:50.91,0:11:52.12,Default,,0,0,0,,Ішек
Dialogue: 0,0:11:52.25,0:11:54.54,Default,,0,0,0,,Ха! (Миньон) Бұл үлкен мәселе емес!
Dialogue: 0,0:11:54.67,0:11:55.92,Default,,0,0,0,,Маңыздысы тек бет-әлпет!
Dialogue: 0,0:11:57.25,0:11:59.59,Default,,0,0,0,,<Қарғыс атсын, әдетте бұл бір ғана ату>
Dialogue: 0,0:11:59.71,0:12:02.51,Default,,0,0,0,,<Мүмкін менің қабілеттерім осы көзқарасқа байланысты төмендеген шығар...>
Dialogue: 0,0:12:02.93,0:12:06.68,Default,,0,0,0,,<Әйтеуір, Карина қайда? ＞
Dialogue: 0,0:12:07.72,0:12:11.23,Default,,0,0,0,,Толық соғыс! Оны таратып, оны әйелдің қолынан тастаңыз!
Dialogue: 0,0:12:11.35,0:12:13.06,Default,,0,0,0,,3-тен 1-ге дейін ерлерге арналған!
Dialogue: 0,0:12:13.56,0:12:15.10,Default,,0,0,0,,Абайлаңыз!
Dialogue: 0,0:12:15.23,0:12:18.32,Default,,0,0,0,,Мүмкіндігінше айналып өтіп, ашылу мүмкіндігін пайдаланыңыз...
Dialogue: 0,0:12:18.65,0:12:21.24,Default,,0,0,0,,«Бес саусақты жер асты әлемінің мөрі қайта қаралды»
Dialogue: 0,0:12:21.53,0:12:24.32,Default,,0,0,0,,Гах гах...
Dialogue: 0,0:12:26.95,0:12:28.53,Default,,0,0,0,,♬~
Dialogue: 0,0:12:28.66,0:12:33.29,Default,,0,0,0,,Сіз ерекше қабілетпен «Құдайға сенбейсіз», солай ма?
Dialogue: 0,0:12:33.50,0:12:38.29,Default,,0,0,0,,Сондықтан мен Құдайды өзімді тануға қабілетсіз еттім.
Dialogue: 0,0:12:38.67,0:12:42.01,Default,,0,0,0,,Барлық сезімдеріңізді жоғалту қандай сезімде болады?
Dialogue: 0,0:12:42.17,0:12:44.18,Default,,0,0,0,,А, енді естімейсің бе?
Dialogue: 0,0:12:44.30,0:12:47.10,Default,,0,0,0,,Хэхе ахахха
Dialogue: 0,0:12:47.26,0:12:48.97,Default,,0,0,0,,Сәлем... Карина-сама!
Dialogue: 0,0:12:49.31,0:12:53.23,Default,,0,0,0,,Жоқ, бұл дұрыс емес! О, біз жаңа ғана Кайдоның соңынан ердік...
Dialogue: 0,0:12:53.60,0:12:56.69,Default,,0,0,0,,Мені кешіріңіз! Мен бәрін істеймін
Dialogue: 0,0:12:56.94,0:12:59.73,Default,,0,0,0,,Бірдеңе? Аха мен өте қуаныштымын~
Dialogue: 0,0:13:00.19,0:13:03.40,Default,,0,0,0,,Олай болса, мен үшін билейсің бе?
Dialogue: 0,0:13:03.53,0:13:05.95,Default,,0,0,0,,Бұл парад сияқты жарқыраған!
Dialogue: 0,0:13:06.07,0:13:07.49,Default,,0,0,0,,(Миньондардың үрейлі дауыстары)
Dialogue: 0,0:13:07.62,0:13:10.20,Default,,0,0,0,,«Кемпірқосақ күркіреуі»!
Dialogue: 0,0:13:10.37,0:13:12.91,Default,,0,0,0,,(миниондардың айқайы)
Dialogue: 0,0:13:13.08,0:13:16.62,Default,,0,0,0,,Аха, қаттырақ биле!
Dialogue: 0,0:13:16.75,0:13:18.25,Default,,0,0,0,,басқаша
Dialogue: 0,0:13:18.46,0:13:19.71,Default,,0,0,0,,Гуаааааааааааааааааааааааа
Dialogue: 0,0:13:19.96,0:13:22.46,Default,,0,0,0,,Қараңдар, мен дұрыс түсіндім.
Dialogue: 0,0:13:25.93,0:13:28.59,Default,,0,0,0,,Бұл Карина-сан ба?
Dialogue: 0,0:13:28.72,0:13:32.52,Default,,0,0,0,,Құдайдың құдіреті Кайдода мөрленуі керек еді...
Dialogue: 0,0:13:32.77,0:13:36.19,Default,,0,0,0,,Түрі мен күйін өзгерту, өзгерту арқылы шығар.
Dialogue: 0,0:13:36.31,0:13:38.94,Default,,0,0,0,,Мен Құдайдың атағын алып тастадым.
Dialogue: 0,0:13:39.06,0:13:41.48,Default,,0,0,0,,Кайдоның арнайы жазбаларынан қашу
Dialogue: 0,0:13:41.90,0:13:44.36,Default,,0,0,0,,Карина-сан құдай...
Dialogue: 0,0:13:44.82,0:13:46.70,Default,,0,0,0,,Не болып жатыр!?
Dialogue: 0,0:13:46.82,0:13:47.86,Default,,0,0,0,,Бұл апат сияқты!
Dialogue: 0,0:13:47.99,0:13:49.41,Default,,0,0,0,,Барлығы артта тұр!
Dialogue: 0,0:13:49.66,0:13:53.66,Default,,0,0,0,,Ұйым мүшелері Құдайдың қаһарына ұшырады!
Dialogue: 0,0:13:53.87,0:13:56.87,Default,,0,0,0,,«Найзағай элементі»!
Dialogue: 0,0:14:06.59,0:14:07.88,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:08.09,0:14:10.01,Default,,0,0,0,,Құтты болсын, күш...
Dialogue: 0,0:14:10.18,0:14:13.89,Default,,0,0,0,,Бұл көзқарас мен үшін шынымен қарғыс...
Dialogue: 0,0:14:14.47,0:14:18.77,Default,,0,0,0,,Шигеру-кун шынымен де сымбатты жігіт еді, солай емес пе?
Dialogue: 0,0:14:19.02,0:14:21.61,Default,,0,0,0,,Бұл ең нашар. Мен алданып қалдым.
Dialogue: 0,0:14:22.65,0:14:26.82,Default,,0,0,0,,Шындығында сен де мені мазақ еттің ғой, солай ма?
Dialogue: 0,0:14:26.99,0:14:31.37,Default,,0,0,0,,Солай бола тұра, мен Сейка-чанға жол көрсетуге тырысқаным үшін көңілім қалды.
Dialogue: 0,0:14:31.87,0:14:35.37,Default,,0,0,0,,Карина... жоқ, Рейко Ширатори...
Dialogue: 0,0:14:35.50,0:14:36.70,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:37.33,0:14:41.17,Default,,0,0,0,,Менің Киоконың әпкесі екенімді білдің...
Dialogue: 0,0:14:41.54,0:14:44.88,Default,,0,0,0,,Мен Риа Киоко Шираториді алып кеткенін естідім.
Dialogue: 0,0:14:45.34,0:14:49.05,Default,,0,0,0,,Сіз Лияның қарындасыңыз үшін кек алуын мақсат етесіз бе?
Dialogue: 0,0:14:49.34,0:14:50.68,Default,,0,0,0,,Кек алу?
Dialogue: 0,0:14:50.80,0:14:52.01,Default,,0,0,0,,(Аттың айғайы)
Dialogue: 0,0:14:52.14,0:14:56.35,Default,,0,0,0,,Неліктен? Мен ризамын, солай емес пе?
Dialogue: 0,0:14:56.52,0:14:58.85,Default,,0,0,0,,Киоко... ол өлген жоқ.
Dialogue: 0,0:14:58.98,0:14:59.94,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:00.14,0:15:02.90,Default,,0,0,0,,Риа Кикуна Киоконы өлтіре алмады
Dialogue: 0,0:15:03.77,0:15:05.57,Default,,0,0,0,,<Мен оны өлтірмек болдым, бірақ...>
Dialogue: 0,0:15:05.78,0:15:09.90,Default,,0,0,0,,Ақырында мен оны құтқардым... Ол әлі тірі...
Dialogue: 0,0:15:10.03,0:15:12.91,Default,,0,0,0,,Мені мәңгілік азаптай бер...
Dialogue: 0,0:15:13.24,0:15:15.91,Default,,0,0,0,,Сіз... Киокого кек сақтайсыз ба?
Dialogue: 0,0:15:16.45,0:15:19.21,Default,,0,0,0,,Мен сол баланың мен үшін маңызды болғанын қалаймын.
Dialogue: 0,0:15:19.91,0:15:22.17,Default,,0,0,0,,Құдайды алып кетті...
Dialogue: 0,0:15:23.29,0:15:27.00,Default,,0,0,0,,Сол бала талай адамның жүрегін өлтірді.
Dialogue: 0,0:15:27.13,0:15:29.76,Default,,0,0,0,,Үзілу және өтірік айту
Dialogue: 0,0:15:29.97,0:15:34.18,Default,,0,0,0,,Сіз тек ұрлауға, алдауға және таптауға болады.
Dialogue: 0,0:15:35.39,0:15:37.18,Default,,0,0,0,,Ол нағыз шайтан...
Dialogue: 0,0:15:38.60,0:15:42.23,Default,,0,0,0,,<Киоко кішкентайынан құбыжық...>
Dialogue: 0,0:15:42.52,0:15:46.02,Default,,0,0,0,,<Зорлық-зомбылық және оның отбасынан аулақ болу>
Dialogue: 0,0:15:46.19,0:15:48.69,Default,,0,0,0,,<Ақырында, ол зорлық жасады деп жалған айып тағылған кәдімгі қылмыскер...>
Dialogue: 0,0:15:50.19,0:15:52.24,Default,,0,0,0,,<Бәрі, мені ұрып жатырсың ба? ＞
Dialogue: 0,0:15:52.36,0:15:54.91,Default,,0,0,0,,<Себебі олардың бет-бейнесі мен келбеті ұқсас>
Dialogue: 0,0:15:55.16,0:15:59.20,Default,,0,0,0,,<Бірақ мен Құдайды таптым...>
Dialogue: 0,0:15:59.33,0:16:03.08,Default,,0,0,0,,<Мені тура жол көрсететін Құдай...>
Dialogue: 0,0:16:03.42,0:16:05.59,Default,,0,0,0,,<Бірақ Киоко...>
Dialogue: 0,0:16:06.00,0:16:08.75,Default,,0,0,0,,<Олар тіпті менің құдайымды ұрлап кетті...>
Dialogue: 0,0:16:11.13,0:16:13.34,Default,,0,0,0,,<Менің достарым>
Dialogue: 0,0:16:13.55,0:16:16.10,Default,,0,0,0,,<Тек «Карина» атты қуыршақ...>
Dialogue: 0,0:16:17.76,0:16:20.60,Default,,0,0,0,,<Барабанның Киокого тигеніне сенімдімін...>
Dialogue: 0,0:16:21.48,0:16:25.44,Default,,0,0,0,,<Ақырында бітті, құтқарылдым...>
Dialogue: 0,0:16:25.73,0:16:27.15,Default,,0,0,0,,<Осылай ойладым...>
Dialogue: 0,0:16:28.11,0:16:30.11,Default,,0,0,0,,<Киоко аман қалды>
Dialogue: 0,0:16:31.74,0:16:33.36,Default,,0,0,0,,<Мен сені өлтіруім керек...>
Dialogue: 0,0:16:33.49,0:16:37.12,Default,,0,0,0,,<Олай етпесем, тағы да шатасамын...>
Dialogue: 0,0:16:37.53,0:16:39.41,Default,,0,0,0,,<Осылай ойладым>
Dialogue: 0,0:16:39.54,0:16:42.21,Default,,0,0,0,,<Мен Киоконы өлтіре алмадым>
Dialogue: 0,0:16:42.41,0:16:43.83,Default,,0,0,0,,<Мұндай жағдайда>
Dialogue: 0,0:16:43.96,0:16:46.54,Default,,0,0,0,,<Мен бұл экранды смартфоннан таптым>
Dialogue: 0,0:16:46.92,0:16:49.13,Default,,0,0,0,,<Күндер азапты, ұйықтай алмаймын...>
Dialogue: 0,0:16:49.25,0:16:52.17,Default,,0,0,0,,<Құдайды табуға қанша талпындың...>
Dialogue: 0,0:16:52.80,0:16:56.68,Default,,0,0,0,,<Ешқашан ғашық болмаймын, Ешкімге ғашық болмаймын>
Dialogue: 0,0:16:56.80,0:17:00.60,Default,,0,0,0,,<Біреуге ғашық болсаң, ақырын сүй >
Dialogue: 0,0:17:00.72,0:17:03.52,Default,,0,0,0,,<Көпіршікке айналып, ғайып боламын>
Dialogue: 0,0:17:05.73,0:17:08.65,Default,,0,0,0,,<Мен Рейко да, Киоко да емеспін...>
Dialogue: 0,0:17:09.48,0:17:11.40,Default,,0,0,0,,<Бұл Карина>
Dialogue: 0,0:17:12.69,0:17:13.99,Default,,0,0,0,,Содан кейін I
Dialogue: 0,0:17:14.11,0:17:18.41,Default,,0,0,0,,Мен нәпсіқұмарлық пен ұйқыға деген құштарлығымды жауып тастадым және абсолютті құдай болдым.
Dialogue: 0,0:17:18.70,0:17:22.41,Default,,0,0,0,,Осы кезде мен Шигеру-кунды кездестірдім.
Dialogue: 0,0:17:22.79,0:17:25.75,Default,,0,0,0,,Шигеру-кун да мен сияқты абсолютті құдай.
Dialogue: 0,0:17:25.92,0:17:28.21,Default,,0,0,0,,Менің сезімімді түсінетініңізге сенімдімін.
Dialogue: 0,0:17:28.33,0:17:30.34,Default,,0,0,0,,Бір күні Құдайым
Dialogue: 0,0:17:30.46,0:17:34.09,Default,,0,0,0,,Бір күні маған жол көрсетерсің деп ойладым
Dialogue: 0,0:17:35.42,0:17:37.64,Default,,0,0,0,,Неге мен емес?
Dialogue: 0,0:17:37.76,0:17:39.43,Default,,0,0,0,,А... Сейка-чан?
Dialogue: 0,0:17:39.60,0:17:40.93,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:17:43.22,0:17:46.44,Default,,0,0,0,,(Сейджи мен Лидстің ауыр тыныс алуы)
Dialogue: 0,0:17:46.73,0:17:49.06,Default,,0,0,0,,Лия! Жарайды!
Dialogue: 0,0:17:49.19,0:17:51.11,Default,,0,0,0,,Иә, иә... бірақ...
Dialogue: 0,0:17:51.36,0:17:54.07,Default,,0,0,0,,Қалпына келтіру сиқырын дереу қолданыңыз...
Dialogue: 0,0:17:54.19,0:17:56.32,Default,,0,0,0,,Мен таптым (2 адам) Ха!
Dialogue: 0,0:17:57.41,0:17:58.86,Default,,0,0,0,,Карина!
Dialogue: 0,0:17:59.57,0:18:03.08,Default,,0,0,0,,Менің достарыма сұмдық жасауды доғарыңыз!
Dialogue: 0,0:18:03.58,0:18:05.04,Default,,0,0,0,,Мұны жасамаңыз
Dialogue: 0,0:18:05.16,0:18:09.67,Default,,0,0,0,,Риа Кикунаның сол жерде өлгенін көру керек болды.
Dialogue: 0,0:18:09.88,0:18:11.63,Default,,0,0,0,,Жүр, кет.
Dialogue: 0,0:18:12.09,0:18:13.38,Default,,0,0,0,,Маған ұнамайды!
Dialogue: 0,0:18:13.50,0:18:14.63,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:18:14.76,0:18:17.34,Default,,0,0,0,,Неліктен оны қорғау үшін соншалықты тырысып жатырсыз?
Dialogue: 0,0:18:17.80,0:18:20.60,Default,,0,0,0,,Өйткені Лия менімен бірдей.
Dialogue: 0,0:18:20.80,0:18:23.64,Default,,0,0,0,,Біз доспыз, өйткені біз бірдей адамдарға қамқорлық жасаймыз.
Dialogue: 0,0:18:23.76,0:18:25.22,Default,,0,0,0,,Сейка-сан?
Dialogue: 0,0:18:25.47,0:18:26.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:26.93,0:18:31.27,Default,,0,0,0,,Мен шынымен түсінбеймін, бірақ менің ойымша, бізде берік байланыс бар.
Dialogue: 0,0:18:31.40,0:18:34.86,Default,,0,0,0,,Ал енді, байланыс неғұрлым күшті болса, соғұрлым күшті болады
Dialogue: 0,0:18:34.98,0:18:38.24,Default,,0,0,0,,Сіз мұның бәрін жойғыңыз келеді, солай ма?
Dialogue: 0,0:18:38.65,0:18:40.91,Default,,0,0,0,,Мен бұған жол бермеймін.
Dialogue: 0,0:18:41.28,0:18:43.03,Default,,0,0,0,,Мен Рианы қорғаймын!
Dialogue: 0,0:18:43.62,0:18:46.08,Default,,0,0,0,,Сейка-сан, бұл сыртқы түрі...
Dialogue: 0,0:18:46.20,0:18:48.50,Default,,0,0,0,,Менің ерекше жазбаларымның күші
Dialogue: 0,0:18:48.91,0:18:52.00,Default,,0,0,0,,Мұны барлығынан құпия сақтаңыз.
Dialogue: 0,0:18:52.13,0:18:54.17,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:18:54.30,0:18:56.51,Default,,0,0,0,,Әй, бұл қызық.
Dialogue: 0,0:18:56.63,0:18:59.18,Default,,0,0,0,,Құдайға қарсы шыққанда не болады?
Dialogue: 0,0:18:59.93,0:19:03.26,Default,,0,0,0,,Мен оны денеңе ойып саламын.
Dialogue: 0,0:19:06.27,0:19:08.14,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:08.52,0:19:10.14,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:19:10.44,0:19:14.02,Default,,0,0,0,,Хмм, мен оны жас келіншек деп ойладым.
Dialogue: 0,0:19:14.15,0:19:16.19,Default,,0,0,0,,Мен жақсы күресе аламын.
Dialogue: 0,0:19:16.61,0:19:19.36,Default,,0,0,0,,Сиқырлы қорғаныс жоғары сияқты.
Dialogue: 0,0:19:19.49,0:19:22.91,Default,,0,0,0,,Физикалық шабуылдар туралы не деуге болады?
Dialogue: 0,0:19:23.16,0:19:24.37,Default,,0,0,0,,Карина-сан
Dialogue: 0,0:19:24.49,0:19:27.45,Default,,0,0,0,,Менімен дос болғың келетінін айттың ғой, солай ма?
Dialogue: 0,0:19:28.00,0:19:30.87,Default,,0,0,0,,Солай ма? есімде жоқ
Dialogue: 0,0:19:31.00,0:19:33.96,Default,,0,0,0,,Мен ұйықтамағандықтан басым тұман болып тұр.
Dialogue: 0,0:19:34.67,0:19:38.09,Default,,0,0,0,,Мен сенімен әлі көп сөйлескен жоқпын.
Dialogue: 0,0:19:38.21,0:19:39.80,Default,,0,0,0,,Хмм? сондықтан?
Dialogue: 0,0:19:39.92,0:19:41.84,Default,,0,0,0,,Көп сөйлесейік
Dialogue: 0,0:19:41.97,0:19:44.39,Default,,0,0,0,,Қуанышты да, мұңды да
Dialogue: 0,0:19:44.51,0:19:45.47,Default,,0,0,0,,Цу...
Dialogue: 0,0:19:46.10,0:19:49.93,Default,,0,0,0,,Онда менің досым болшы.
Dialogue: 0,0:19:50.35,0:19:52.31,Default,,0,0,0,,Абсолюттік Құдай...
Dialogue: 0,0:19:52.44,0:19:56.44,Default,,0,0,0,,Құдайдың адамдармен дос болуы мүмкін емес!?
Dialogue: 0,0:19:59.82,0:20:03.53,Default,,0,0,0,,Бұл тітіркендіргіш! Сіз сияқты әйел!
Dialogue: 0,0:20:03.66,0:20:04.95,Default,,0,0,0,,Неге!
Dialogue: 0,0:20:05.07,0:20:07.91,Default,,0,0,0,,Неге сонша! Сіз өте мейірімдісіз!
Dialogue: 0,0:20:08.04,0:20:08.95,Default,,0,0,0,,Уф
Dialogue: 0,0:20:09.08,0:20:11.91,Default,,0,0,0,,Иә, тоқта! өтінемін! Тоқта...
Dialogue: 0,0:20:12.04,0:20:13.79,Default,,0,0,0,,Шулы! Ах! Уф...
Dialogue: 0,0:20:13.96,0:20:14.79,Default,,0,0,0,,Ха...
Dialogue: 0,0:20:14.96,0:20:18.84,Default,,0,0,0,,Сейка-чан, сен ешкімге көмектесе алмайсың.
Dialogue: 0,0:20:19.80,0:20:22.05,Default,,0,0,0,,«Қызыл крест зеңбірегі»!
Dialogue: 0,0:20:22.17,0:20:24.30,Default,,0,0,0,,Хааааааааааааааааааааа!
Dialogue: 0,0:20:28.85,0:20:30.22,Default,,0,0,0,,Уф
Dialogue: 0,0:20:34.94,0:20:37.36,Default,,0,0,0,,Алдеан мырза, шайтан бала да...
Dialogue: 0,0:20:37.57,0:20:40.48,Default,,0,0,0,,Бұл батырға ұқсайды ма?
Dialogue: 0,0:20:40.61,0:20:42.36,Default,,0,0,0,,Бұл шайтан ма?
Dialogue: 0,0:20:42.61,0:20:44.61,Default,,0,0,0,,Лия да, Элькарон да
Dialogue: 0,0:20:44.74,0:20:46.37,Default,,0,0,0,,Мен маңызды доспын.
Dialogue: 0,0:20:46.74,0:20:50.37,Default,,0,0,0,,Құдай қандай болса да, мен сені ренжітуге жол бермеймін.
Dialogue: 0,0:20:51.16,0:20:52.12,Default,,0,0,0,,Және...
Dialogue: 0,0:20:55.71,0:20:58.63,Default,,0,0,0,,Біреу... маған көмектесіңізші...
Dialogue: 0,0:20:59.13,0:21:01.01,Default,,0,0,0,,Қандай болса да
Dialogue: 0,0:21:01.13,0:21:04.09,Default,,0,0,0,,Қажетсіз азап шегудің мәні жоқ.
Dialogue: 0,0:21:04.47,0:21:07.14,Default,,0,0,0,,Сіз құдай емессіз
Dialogue: 0,0:21:07.34,0:21:11.64,Default,,0,0,0,,Бұл шайтанның көрінісі сіздің шынымен зұлым екеніңізді көрсетеді.
Dialogue: 0,0:21:12.10,0:21:13.35,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:21:13.48,0:21:15.60,Default,,0,0,0,,Мен сенімен Сейка-чанның алдында ойнаймын.
Dialogue: 0,0:21:16.31,0:21:18.65,Default,,0,0,0,,Уау! (Лиз) Ах!
Dialogue: 0,0:21:18.77,0:21:19.94,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:20.15,0:21:21.61,Default,,0,0,0,,Хехехе! (Лиз) Ха!
Dialogue: 0,0:21:21.90,0:21:23.90,Default,,0,0,0,,Әй, сен көп жұмыс істейсің.
Dialogue: 0,0:21:25.07,0:21:26.11,Default,,0,0,0,,Ха! (Лис) Қарғыс атсын!
Dialogue: 0,0:21:26.45,0:21:28.91,Default,,0,0,0,,Ааа! (Сэйджи) Декан!
Dialogue: 0,0:21:31.24,0:21:32.62,Default,,0,0,0,,Аха, солай ма?
Dialogue: 0,0:21:32.83,0:21:35.37,Default,,0,0,0,,Кут, бұл жұдырық істемейді!
Dialogue: 0,0:21:38.00,0:21:39.38,Default,,0,0,0,,Хехе
Dialogue: 0,0:21:39.96,0:21:41.67,Default,,0,0,0,,«Найза найзасы»!
Dialogue: 0,0:21:41.88,0:21:45.17,Default,,0,0,0,,Ол ешқандай қосымша күш бола алмайды.
Dialogue: 0,0:21:49.47,0:21:50.85,Default,,0,0,0,,Мен шайқаса аламын!
Dialogue: 0,0:21:51.01,0:21:52.39,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:21:52.52,0:21:54.64,Default,,0,0,0,,Ах... (Сейка) Солай...
Dialogue: 0,0:21:54.77,0:21:57.60,Default,,0,0,0,,Аға, бәрі тоз-тоз болып қалды!
Dialogue: 0,0:21:57.73,0:21:59.65,Default,,0,0,0,,Бұл сізге өте жарасады!
Dialogue: 0,0:22:00.02,0:22:03.90,Default,,0,0,0,,Бірақ мен жарқыраған нәрсені қалаймын ба?
Dialogue: 0,0:22:04.36,0:22:09.87,Default,,0,0,0,,Мысалы, анардай жарқыраған қызыл.
Dialogue: 0,0:22:10.20,0:22:13.16,Default,,0,0,0,,♪～
Dialogue: 0,0:23:35.62,0:23:38.58,Default,,0,0,0,,～♪
Dialogue: 0,0:23:40.08,0:23:46.08,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory