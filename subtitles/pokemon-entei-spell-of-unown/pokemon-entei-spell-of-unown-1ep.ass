Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:22.10,0:00:25.48,Default,,0,0,0,,Бұл дүниеде тек аңыздар ғана бар...
Dialogue: 0,0:00:25.56,0:00:27.27,Default,,0,0,0,,Бұрын ешкім көрмеген Покемон —
Dialogue: 0,0:00:27.36,0:00:29.57,Default,,0,0,0,,Әлі де көп екені айтылады.
Dialogue: 0,0:00:30.48,0:00:34.86,Default,,0,0,0,,Бұл суретті кітапта мұндай Покемонның көптеген қиялдағы суреттері бар.
Dialogue: 0,0:00:36.49,0:00:38.66,Default,,0,0,0,,Әкемнің іздегені осы.
Dialogue: 0,0:00:38.74,0:00:43.87,Default,,0,0,0,,Дұрыс, Unown, менің әкем іздеген жұмбақ Покемон.
Dialogue: 0,0:00:44.42,0:00:47.67,Default,,0,0,0,,Маған... ұнайды
Dialogue: 0,0:00:48.38,0:00:51.17,Default,,0,0,0,,Мифтік Pokemon Энтей
Dialogue: 0,0:00:51.63,0:00:52.92,Default,,0,0,0,,Менің таңдаулыларым
Dialogue: 0,0:00:53.01,0:00:58.47,Default,,0,0,0,,Энтей күшті, мейірімді және әкеме ұқсайды.
Dialogue: 0,0:00:58.55,0:01:01.72,Default,,0,0,0,,Сенің әкең Энтей ме? Мен сондай болғым келеді
Dialogue: 0,0:01:01.81,0:01:05.85,Default,,0,0,0,,Жарайды, әкем Энтей Гао~
Dialogue: 0,0:01:05.94,0:01:08.11,Default,,0,0,0,,Уау, бұл Энтей (Шури) Гао~
Dialogue: 0,0:01:08.19,0:01:09.52,Default,,0,0,0,,Аха (Шури) Уау
Dialogue: 0,0:01:11.40,0:01:14.07,Default,,0,0,0,,Жарайды, кеттік Гао~ (Мен) Ахаха
Dialogue: 0,0:01:14.15,0:01:18.53,Default,,0,0,0,,Гао~ Гао~ (Мен) Ахаха Ахахха
Dialogue: 0,0:01:18.62,0:01:23.66,Default,,0,0,0,,(Шури мен менің күлкісі)
Dialogue: 0,0:01:24.91,0:01:28.63,Default,,0,0,0,,(Пошта қабылдау дыбысы)
Dialogue: 0,0:01:30.09,0:01:32.05,Default,,0,0,0,,А, бұл электрондық пошта.
Dialogue: 0,0:01:32.42,0:01:35.76,Default,,0,0,0,,Әкем үшін шығар. Шұғыл электрондық пошта.
Dialogue: 0,0:01:42.81,0:01:43.97,Default,,0,0,0,,Бұл Джон.
Dialogue: 0,0:01:44.06,0:01:47.31,Default,,0,0,0,,Мұғалім: Сол қирандылардан Белгісіздер туралы мәліметтер бар...
Dialogue: 0,0:01:47.69,0:01:49.27,Default,,0,0,0,,Мүмкіндігінше тезірек келіңіз.
Dialogue: 0,0:01:49.61,0:01:51.32,Default,,0,0,0,,Белгісіз анықтама?
Dialogue: 0,0:01:51.40,0:01:52.98,Default,,0,0,0,,Өйткені, бұл жұмыс...
Dialogue: 0,0:01:53.07,0:01:54.53,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:01:58.07,0:02:00.16,Default,,0,0,0,,Мен мүмкіндігінше тезірек ораламын.
Dialogue: 0,0:02:00.24,0:02:01.41,Default,,0,0,0,,Увааах! Оох…
Dialogue: 0,0:02:14.05,0:02:15.42,Default,,0,0,0,,Қайырлы түн
Dialogue: 0,0:02:37.78,0:02:39.24,Default,,0,0,0,,Міне, сіз доктор Шли.
Dialogue: 0,0:02:39.32,0:02:40.74,Default,,0,0,0,,О
Dialogue: 0,0:02:40.82,0:02:42.12,Default,,0,0,0,,Бұл мен бұрын-соңды көрмеген кейіпкерлер
Dialogue: 0,0:02:42.20,0:02:45.08,Default,,0,0,0,,Менің ойымша, бұл бейтаныс туралы жазылған.
Dialogue: 0,0:02:46.37,0:02:47.91,Default,,0,0,0,,Керемет
Dialogue: 0,0:02:48.00,0:02:52.33,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:02:52.42,0:02:55.25,Default,,0,0,0,,Бұны сізден басқа ешкім шеше алмайды.
Dialogue: 0,0:03:00.63,0:03:02.80,Default,,0,0,0,,(Иесі жоқтардың айқайы)
Dialogue: 0,0:03:02.89,0:03:03.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:15.94,0:03:18.44,Default,,0,0,0,,Бұл... Ха
Dialogue: 0,0:03:18.53,0:03:21.24,Default,,0,0,0,,Уф... уау
Dialogue: 0,0:03:25.99,0:03:27.33,Default,,0,0,0,,Жоқ
Dialogue: 0,0:03:35.21,0:03:37.38,Default,,0,0,0,,О, мұғалім?
Dialogue: 0,0:03:38.96,0:03:41.63,Default,,0,0,0,,Мұғалім... Доктор Шли
Dialogue: 0,0:03:42.34,0:03:45.01,Default,,0,0,0,,Dr.
Dialogue: 0,0:03:46.18,0:03:51.10,Default,,0,0,0,,(Құстардың сайрауы)
Dialogue: 0,0:03:53.15,0:03:56.36,Default,,0,0,0,,(Менің тынысым ауыр)
Dialogue: 0,0:03:59.94,0:04:04.45,Default,,0,0,0,,Жас келіншек шынымен де жалғыз қалды.
Dialogue: 0,0:04:05.66,0:04:08.08,Default,,0,0,0,,Әке, қайтып келдіңіз бе? иә?
Dialogue: 0,0:04:08.66,0:04:09.79,Default,,0,0,0,,Ми-чан
Dialogue: 0,0:04:10.08,0:04:11.37,Default,,0,0,0,,Ол келді.
Dialogue: 0,0:04:23.51,0:04:26.85,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:04:26.93,0:04:30.18,Default,,0,0,0,,Әке, маған электрондық хат жіберіңіз.
Dialogue: 0,0:04:34.02,0:04:35.73,Default,,0,0,0,,Иесіз бе?
Dialogue: 0,0:04:43.49,0:04:46.41,Default,,0,0,0,,Әке, бұл кәдесый.
Dialogue: 0,0:04:57.67,0:05:00.34,Default,,0,0,0,,Мен сені сағындым, әке.
Dialogue: 0,0:05:30.49,0:05:31.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:32.49,0:05:35.21,Default,,0,0,0,,Пами
Dialogue: 0,0:05:42.50,0:05:46.09,Default,,0,0,0,,(Иесі жоқтардың айқайы)
Dialogue: 0,0:05:46.18,0:05:47.68,Default,,0,0,0,,Жоқ
Dialogue: 0,0:05:49.68,0:05:51.68,Default,,0,0,0,,Менімен ойнайсың ба?
Dialogue: 0,0:05:51.76,0:05:54.31,Default,,0,0,0,,(Иесі жоқтардың айқайы)
Dialogue: 0,0:06:20.96,0:06:23.05,Default,,0,0,0,,Ах, бұл...
Dialogue: 0,0:06:24.30,0:06:25.30,Default,,0,0,0,,Уф
Dialogue: 0,0:06:26.72,0:06:28.22,Default,,0,0,0,,Хехехехехехе
Dialogue: 0,0:06:28.30,0:06:29.30,Default,,0,0,0,,Ол келді.
Dialogue: 0,0:06:29.38,0:06:30.80,Default,,0,0,0,,Бұл ие емес
Dialogue: 0,0:06:30.89,0:06:32.26,Default,,0,0,0,,Уау, жас ханым...
Dialogue: 0,0:06:45.19,0:06:46.65,Default,,0,0,0,,Увааах! Оох…
Dialogue: 0,0:06:54.41,0:06:57.25,Default,,0,0,0,,Әке, қайтып келіңізші.
Dialogue: 0,0:06:57.33,0:06:58.33,Default,,0,0,0,,Пино Пино
Dialogue: 0,0:06:58.41,0:07:01.58,Default,,0,0,0,,Пино Пино…
Dialogue: 0,0:07:21.19,0:07:24.36,Default,,0,0,0,,Пино Пино Пино Пино…
Dialogue: 0,0:07:24.44,0:07:27.48,Default,,0,0,0,,Мені шақырған сен бе? (Мен) Ха
Dialogue: 0,0:07:27.86,0:07:28.94,Default,,0,0,0,,Пино
Dialogue: 0,0:07:30.61,0:07:33.16,Default,,0,0,0,,Пи~ Пи~ Пино
Dialogue: 0,0:07:34.62,0:07:36.12,Default,,0,0,0,,Энтей?
Dialogue: 0,0:07:36.49,0:07:38.95,Default,,0,0,0,,Мен Энтеймін
Dialogue: 0,0:07:39.04,0:07:42.83,Default,,0,0,0,,Әй, әке... бұл әке, солай ма?
Dialogue: 0,0:07:42.92,0:07:46.13,Default,,0,0,0,,Әкем Энтейге айналып, қайтып келді.
Dialogue: 0,0:07:46.21,0:07:47.80,Default,,0,0,0,,Жылдам болшы! Уақыт машинасын көпке дейін сол жерде қалдыра алмаймын.
Dialogue: 0,0:07:50.13,0:07:51.38,Default,,0,0,0,,Увааах! Оох…
Dialogue: 0,0:07:55.55,0:07:57.72,Default,,0,0,0,,Мен әкемін бе?
Dialogue: 0,0:08:02.48,0:08:04.77,Default,,0,0,0,,Тілегіңді орындайық
Dialogue: 0,0:09:08.13,0:09:10.96,Default,,0,0,0,,Менің туған жерім Масала қаласынан шалғайда
Dialogue: 0,0:09:11.05,0:09:13.92,Default,,0,0,0,,Сатоси және оның достары Джохто лигасына қатысуды мақсат етеді
Dialogue: 0,0:09:14.01,0:09:17.51,Default,,0,0,0,,Бүгін мен оқу саяхатымды жалғастырдым.
Dialogue: 0,0:09:17.59,0:09:21.72,Default,,0,0,0,,Оооооооооооооооооооооооооооооооооооооооооооооооооооооуууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:09:21.81,0:09:22.93,Default,,0,0,0,,Өл! Мен сенің төменгі ерініңді тіліп өтемін!
Dialogue: 0,0:09:24.35,0:09:26.35,Default,,0,0,0,,Сіз Покемон жаттықтырушысысыз, солай ма?
Dialogue: 0,0:09:26.44,0:09:28.73,Default,,0,0,0,,Масала қаласының Сатоси Ах...
Dialogue: 0,0:09:28.81,0:09:30.52,Default,,0,0,0,,Покемон шебері болуды мақсат ету
Dialogue: 0,0:09:30.61,0:09:33.61,Default,,0,0,0,,Менің атым Такеши. Сіздің есіміңіз кім, жас ханым?
Dialogue: 0,0:09:33.69,0:09:36.57,Default,,0,0,0,,Мен Ринмін. Сіз қалай ойлайсыз? Сізде шайқас болады ма?
Dialogue: 0,0:09:36.66,0:09:38.41,Default,,0,0,0,,Біз не істеуіміз керек? Сатоси
Dialogue: 0,0:09:38.49,0:09:40.28,Default,,0,0,0,,Пика Әрине
Dialogue: 0,0:09:40.37,0:09:42.87,Default,,0,0,0,,Сатылған шайқасты сатып алу әдептілік.
Dialogue: 0,0:09:42.95,0:09:44.41,Default,,0,0,0,,Фуфу (Тогепи) Тогепи~
Dialogue: 0,0:09:44.50,0:09:48.25,Default,,0,0,0,,Рахмет, жаттықтырушының барлық күшін пайдаланыңыз.
Dialogue: 0,0:09:48.92,0:09:52.30,Default,,0,0,0,,Жарайды, шайқасайық.
Dialogue: 0,0:09:53.34,0:09:59.34,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:13:07.12,0:13:13.12,Default,,0,0,0,,~♪
Dialogue: 0,0:13:13.21,0:13:14.21,Default,,0,0,0,,...
Dialogue: 0,0:13:14.29,0:13:15.58,Default,,0,0,0,,Неміс медицинасы мен ғылымында осындай нәрселер бар шығар—
Dialogue: 0,0:13:15.67,0:13:16.67,Default,,0,0,0,,Ча~
Dialogue: 0,0:13:16.75,0:13:20.09,Default,,0,0,0,,Ахаха хахаха... Пикачу
Dialogue: 0,0:13:34.39,0:13:38.56,Default,,0,0,0,,Сатоши екеуің мықтысыңдар, бізге де көбірек жаттығу керек.
Dialogue: 0,0:13:38.65,0:13:41.23,Default,,0,0,0,,Бізге қауіп төнген.
Dialogue: 0,0:13:41.32,0:13:44.74,Default,,0,0,0,,Бұл осы аптада 5-ші ойын. Барлығың шаршаған жоқсыңдар ма?
Dialogue: 0,0:13:44.82,0:13:45.82,Default,,0,0,0,,Иә
Dialogue: 0,0:13:45.90,0:13:47.57,Default,,0,0,0,,Лин мырза, жақын жерде...
Dialogue: 0,0:13:47.66,0:13:49.91,Default,,0,0,0,,Покемон орталығы туралы білесіз бе?
Dialogue: 0,0:13:49.99,0:13:52.58,Default,,0,0,0,,Мына орман арқылы жасыл алқапта.
Dialogue: 0,0:13:52.66,0:13:55.21,Default,,0,0,0,,Гринфилд...
Dialogue: 0,0:13:55.29,0:13:59.29,Default,,0,0,0,,Джохто аймағында қыздарға баратын бірінші орын ретінде таңдалды
Dialogue: 0,0:13:59.38,0:14:03.38,Default,,0,0,0,,Пинг Донг Мен де кетейін деп жатыр едім.
Dialogue: 0,0:14:04.01,0:14:07.30,Default,,0,0,0,,Оооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооуу...
Dialogue: 0,0:14:07.68,0:14:11.26,Default,,0,0,0,,Гринфилд Бейбітшілік мекені
Dialogue: 0,0:14:11.35,0:14:15.56,Default,,0,0,0,,Соққан жел адамдардың да, Покемонның да жүрегін тыныштандырады.
Dialogue: 0,0:14:15.64,0:14:17.77,Default,,0,0,0,,Мен сонда бір рет барғым келді, солай ма?
Dialogue: 0,0:14:17.85,0:14:20.48,Default,,0,0,0,,Қыздар барғысы келетін нөмір бірінші орын
Dialogue: 0,0:14:21.02,0:14:23.23,Default,,0,0,0,,Көп апалар
Dialogue: 0,0:14:23.32,0:14:25.36,Default,,0,0,0,,Нфуфуфуфуфу... Пика?
Dialogue: 0,0:14:29.78,0:14:32.03,Default,,0,0,0,,Сол төбенің арғы жағында жасыл алқап бар.
Dialogue: 0,0:14:32.12,0:14:35.16,Default,,0,0,0,,(Сатоши мен оның достарының толқыған дауыстары)
Dialogue: 0,0:14:38.71,0:14:42.09,Default,,0,0,0,,Күйеуім іссапармен кеткен, бір аптаға дейін келмейді
Dialogue: 0,0:14:43.00,0:14:44.00,Default,,0,0,0,,Иә
Dialogue: 0,0:14:50.64,0:14:54.39,Default,,0,0,0,,Ах, Пикачу, мені қуғаныңа қуаныштымын.
Dialogue: 0,0:14:54.47,0:14:57.89,Default,,0,0,0,,Аңсаған жасыл алаң да келді.
Dialogue: 0,0:14:57.98,0:14:59.52,Default,,0,0,0,,...Бұл не?
Dialogue: 0,0:14:59.60,0:15:03.40,Default,,0,0,0,,Жасылдан да жылтыр. Бұл қазына ма?
Dialogue: 0,0:15:03.48,0:15:06.44,Default,,0,0,0,,Бұл мысықтар үшін кішкентай өлшем бе?
Dialogue: 0,0:15:07.11,0:15:09.90,Default,,0,0,0,,Сонанс
Dialogue: 0,0:15:10.20,0:15:13.07,Default,,0,0,0,,Қайта өз бетімен шығып, қайтып келдің.
Dialogue: 0,0:15:13.16,0:15:14.91,Default,,0,0,0,,Сонымен~
Dialogue: 0,0:15:18.87,0:15:22.50,Default,,0,0,0,,Иә... ааа
Dialogue: 0,0:15:22.58,0:15:26.00,Default,,0,0,0,,
Dialogue: 0,0:15:26.09,0:15:27.71,Default,,0,0,0,,Джунтер мырза
Dialogue: 0,0:15:34.10,0:15:35.76,Default,,0,0,0,,Жарайсың ба? Жарайды
Dialogue: 0,0:15:35.85,0:15:39.77,Default,,0,0,0,,Кеттік, иә 3 2 1
Dialogue: 0,0:15:40.23,0:15:43.69,Default,,0,0,0,,Әдетте жасыл және бейбіт ауыл ретінде белгілі.
Dialogue: 0,0:15:43.77,0:15:46.40,Default,,0,0,0,,Гринфилдте бұрыннан естімеген нәрсе —
Dialogue: 0,0:15:46.48,0:15:49.74,Default,,0,0,0,,Көруге тұрарлық біртүрлі құбылыс болып жатыр.
Dialogue: 0,0:15:50.07,0:15:54.16,Default,,0,0,0,,Бұл оғаш құбылыс Салли Сноудон Хаустан шыққан сияқты.
Dialogue: 0,0:15:54.24,0:15:56.70,Default,,0,0,0,,Біз ешқандай мәліметтерді білмейміз.
Dialogue: 0,0:15:58.50,0:16:00.54,Default,,0,0,0,,Шри Сноудон…
Dialogue: 0,0:16:15.47,0:16:18.81,Default,,0,0,0,,Доктор Салли аңызға айналған Покемон зерттеушісі.
Dialogue: 0,0:16:18.89,0:16:20.93,Default,,0,0,0,,Дүние жүзіне белгілі болды...
Dialogue: 0,0:16:21.02,0:16:24.06,Default,,0,0,0,,Доктор Салли доктор Оуктың шәкірті емес пе?
Dialogue: 0,0:16:24.15,0:16:26.15,Default,,0,0,0,,Ол үздік оқушы болды.
Dialogue: 0,0:16:26.23,0:16:30.90,Default,,0,0,0,,О, енді ойлап қарасам, соңғы қағаз электронды пошта арқылы келді.
Dialogue: 0,0:16:31.82,0:16:33.78,Default,,0,0,0,,Бұл не? (Окидо) Белгісіз
Dialogue: 0,0:16:34.32,0:16:36.07,Default,,0,0,0,,Иесіз бе?
Dialogue: 0,0:16:37.41,0:16:40.12,Default,,0,0,0,,Сіз теледидардан доктор Оакты көрдіңіз бе?
Dialogue: 0,0:16:40.20,0:16:41.71,Default,,0,0,0,,Мен оны дәл қазір көріп отырмын.
Dialogue: 0,0:16:41.79,0:16:43.87,Default,,0,0,0,,Біз оқиға орнына барғалы жатырмыз.
Dialogue: 0,0:16:43.96,0:16:45.75,Default,,0,0,0,,Мен де барамын, иә?
Dialogue: 0,0:16:45.83,0:16:49.59,Default,,0,0,0,,Иә, анам да Саллиді жақсы білетін.
Dialogue: 0,0:16:49.67,0:16:53.09,Default,,0,0,0,,Қызым әлі жас, мен уайымдап жүрмін...
Dialogue: 0,0:16:53.43,0:16:55.22,Default,,0,0,0,,Жарайды, қазір дайындал.
Dialogue: 0,0:16:55.30,0:16:56.34,Default,,0,0,0,,Иә
Dialogue: 0,0:17:27.42,0:17:30.09,Default,,0,0,0,,Дәл қазір Гринфилд Покемон орталығында—
Dialogue: 0,0:17:30.17,0:17:32.76,Default,,0,0,0,,Жұмыс тобының барлық мүшелері келген сияқты.
Dialogue: 0,0:17:34.92,0:17:37.22,Default,,0,0,0,,Доктор Емен, біз сізді күттік.
Dialogue: 0,0:17:37.30,0:17:39.35,Default,,0,0,0,,Дәрігер... Аа, Жылтыр.
Dialogue: 0,0:17:41.43,0:17:42.89,Default,,0,0,0,,Ал, Пикачу
Dialogue: 0,0:17:42.97,0:17:43.98,Default,,0,0,0,,Пикачу~
Dialogue: 0,0:17:44.06,0:17:45.81,Default,,0,0,0,,Ана, Сатоси
Dialogue: 0,0:17:45.89,0:17:48.31,Default,,0,0,0,,Неге сен де осындасың?
Dialogue: 0,0:17:48.40,0:17:50.52,Default,,0,0,0,,Біраз уақыт болды, доктор Оук.
Dialogue: 0,0:17:50.61,0:17:52.48,Default,,0,0,0,,Мен сені келер деп ойладым.
Dialogue: 0,0:17:52.57,0:17:54.32,Default,,0,0,0,,Қалайсың? Сатоси
Dialogue: 0,0:17:54.40,0:17:57.36,Default,,0,0,0,,Анам сол, аһ
Dialogue: 0,0:18:10.63,0:18:14.21,Default,,0,0,0,,Әке, мен де анамды қалаймын.
Dialogue: 0,0:18:16.67,0:18:19.72,Default,,0,0,0,,Мен, егер қаласаңыз...
Dialogue: 0,0:18:20.30,0:18:21.97,Default,,0,0,0,,Доктор Шли бұрын болған-
Dialogue: 0,0:18:22.06,0:18:25.02,Default,,0,0,0,,Мен профессор Оакпен оқуға келдім.
Dialogue: 0,0:18:25.10,0:18:28.65,Default,,0,0,0,,Анам үй тапсырмасын орындауға көмектесетін сенсің.
Dialogue: 0,0:18:28.73,0:18:33.19,Default,,0,0,0,,Иә, содан кейін мен Масала қаласына бірнеше рет келдім...
Dialogue: 0,0:18:33.27,0:18:35.53,Default,,0,0,0,,Түсіндім, сол кезде...
Dialogue: 0,0:18:36.24,0:18:40.24,Default,,0,0,0,,Бұл доктор Шлидің үйі, мен уайымдап тұрмын, мен уайымдаймын...
Dialogue: 0,0:18:40.32,0:18:41.53,Default,,0,0,0,,Мүлдем.
Dialogue: 0,0:18:41.99,0:18:44.16,Default,,0,0,0,,Пика пип? (Тогепи) Чоки Чоки
Dialogue: 0,0:19:01.30,0:19:03.60,Default,,0,0,0,,Пи…pi~
Dialogue: 0,0:19:03.68,0:19:05.10,Default,,0,0,0,,Не болды? Пикачу Пикачу
Dialogue: 0,0:19:07.60,0:19:09.52,Default,,0,0,0,,Не? Покемон?
Dialogue: 0,0:19:09.60,0:19:11.19,Default,,0,0,0,,Мен оны бірінші рет көріп тұрмын.
Dialogue: 0,0:19:11.27,0:19:12.65,Default,,0,0,0,,Ах... (Тогепи) Пи~
Dialogue: 0,0:19:12.73,0:19:13.94,Default,,0,0,0,,Не? сен
Dialogue: 0,0:19:14.02,0:19:17.36,Default,,0,0,0,,Анашым... сіз анасыз
Dialogue: 0,0:19:17.44,0:19:18.78,Default,,0,0,0,,А...
Dialogue: 0,0:19:18.86,0:19:21.20,Default,,0,0,0,,Сіз менің анамсыз
Dialogue: 0,0:19:23.24,0:19:28.12,Default,,0,0,0,,Мен анамын Мен анамын...
Dialogue: 0,0:19:35.88,0:19:38.05,Default,,0,0,0,,Дыбыстық сигнал, күтіңіз.
Dialogue: 0,0:19:41.13,0:19:42.30,Default,,0,0,0,,Ах
Dialogue: 0,0:19:47.31,0:19:50.14,Default,,0,0,0,,Анашым! пикачу
Dialogue: 0,0:19:54.90,0:19:56.48,Default,,0,0,0,,Шайнау
Dialogue: 0,0:19:56.86,0:19:58.15,Default,,0,0,0,,Олар – аң, ал біз – аңшылар!
Dialogue: 0,0:19:58.23,0:19:59.53,Default,,0,0,0,,Пи…
Dialogue: 0,0:20:03.11,0:20:06.03,Default,,0,0,0,,Пикачу, жақсысың ба? пикер
Dialogue: 0,0:20:09.75,0:20:12.42,Default,,0,0,0,,Барма, Сатоши, мен не болып жатқанын білмеймін.
Dialogue: 0,0:20:12.50,0:20:14.92,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:15.96,0:20:19.88,Default,,0,0,0,,Неге... неге, мама... уф
Dialogue: 0,0:20:30.02,0:20:34.73,Default,,0,0,0,,Мен саған қалағаныңды әкелдім.
Dialogue: 0,0:20:34.81,0:20:36.15,Default,,0,0,0,,Аня, көпшіліктен қорықпайсың ба?
Dialogue: 0,0:20:36.98,0:20:38.57,Default,,0,0,0,,Бұл зертхана мүшелерінің жиналысы.
Dialogue: 0,0:20:39.28,0:20:41.57,Default,,0,0,0,,Анашым хехе
Dialogue: 0,0:20:46.12,0:20:48.70,Default,,0,0,0,,Мен анамын...
Dialogue: 0,0:20:50.87,0:20:54.12,Default,,0,0,0,,Анашым, бұл менмін, бұл менмін.
Dialogue: 0,0:20:58.54,0:21:00.63,Default,,0,0,0,,Ах...хехе
Dialogue: 0,0:21:01.88,0:21:02.88,Default,,0,0,0,,Мен
Dialogue: 0,0:21:03.55,0:21:04.76,Default,,0,0,0,,О, өтінемін, мені өлтірме
Dialogue: 0,0:21:10.31,0:21:13.77,Default,,0,0,0,,Ана мен әке, біз мәңгі бірге боламыз
Dialogue: 0,0:21:13.85,0:21:16.81,Default,,0,0,0,,О, егер қаласаңыз...
Dialogue: 0,0:21:18.11,0:21:19.11,Default,,0,0,0,,Хехе
Dialogue: 0,0:21:45.43,0:21:48.68,Default,,0,0,0,,Сіздің әлеміңіз қарқынды дамып келеді.
Dialogue: 0,0:21:50.30,0:21:51.93,Default,,0,0,0,,Сен әзілдескің келгенін түсіндім—
Dialogue: 0,0:21:52.27,0:21:56.19,Default,,0,0,0,,Сен бақытты болсаң, мен де бақыттымын.
Dialogue: 0,0:22:08.45,0:22:11.78,Default,,0,0,0,,Сатошидің анасын ұрлап кеткен Покемон...
Dialogue: 0,0:22:12.20,0:22:13.70,Default,,0,0,0,,Бұл Энтей
Dialogue: 0,0:22:13.79,0:22:14.79,Default,,0,0,0,,Энтей?
Dialogue: 0,0:22:14.87,0:22:17.79,Default,,0,0,0,,Оның бар екені аңыздан ғана белгілі.
Dialogue: 0,0:22:18.50,0:22:22.21,Default,,0,0,0,,Бұл оқиғаға тағы бір жұмбақ Покемон қатысты.
Dialogue: 0,0:22:22.30,0:22:26.59,Default,,0,0,0,,Бұл сіз зерттеп жүрген бейтаныс адам туралы.
Dialogue: 0,0:22:26.67,0:22:29.64,Default,,0,0,0,,Бұл сарайда иесіз адам бар.
Dialogue: 0,0:22:30.18,0:22:33.14,Default,,0,0,0,,Түсіндім, меніңше...
Dialogue: 0,0:22:44.94,0:22:47.78,Default,,0,0,0,,Жасыл далада жұмбақ кристалдану жүріп жатыр.
Dialogue: 0,0:22:47.86,0:22:50.24,Default,,0,0,0,,Қатысушы әйелді алып кеткен Покемон:
Dialogue: 0,0:22:50.32,0:22:53.45,Default,,0,0,0,,Біз оның Энтей деп аталатын Покемонға ұқсайтыны туралы ақпарат алдық.
Dialogue: 0,0:22:53.53,0:22:56.12,Default,,0,0,0,,Бірақ тағы да егжей-тегжейлер жоқ ...
Dialogue: 0,0:22:56.45,0:22:57.58,Default,,0,0,0,,Гару?
Dialogue: 0,0:22:58.87,0:23:00.83,Default,,0,0,0,,Гаруру…
Dialogue: 0,0:23:05.25,0:23:08.84,Default,,0,0,0,,Енді кристалдарды алу үшін бульдозер келді.
Dialogue: 0,0:23:26.65,0:23:29.57,Default,,0,0,0,,Жоқ, бұзба.
Dialogue: 0,0:23:29.65,0:23:33.78,Default,,0,0,0,,(Иесі жоқтардың айқайы)
Dialogue: 0,0:23:39.25,0:23:40.83,Default,,0,0,0,,Ооо
Dialogue: 0,0:23:46.75,0:23:49.09,Default,,0,0,0,,Уау... аа... а...
Dialogue: 0,0:23:56.39,0:23:59.56,Default,,0,0,0,,Доктор Шлидің жоғалып кетуінен Бұл жұмбақ кристалдану құбылысы
Dialogue: 0,0:23:59.64,0:24:01.81,Default,,0,0,0,,Және Энтейдің пайда болуы
Dialogue: 0,0:24:01.89,0:24:04.40,Default,,0,0,0,,Барлық жұмбақтардың бастауы - Белгісіз.
Dialogue: 0,0:24:04.48,0:24:06.02,Default,,0,0,0,,Бұл менің ойыма келетін жалғыз нәрсе
Dialogue: 0,0:24:06.11,0:24:07.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:08.28,0:24:09.74,Default,,0,0,0,,Электрондық пошта
Dialogue: 0,0:24:12.11,0:24:15.28,Default,,0,0,0,,Мен анам мен әкемнің қайтып келгеніне қуаныштымын.
Dialogue: 0,0:24:15.37,0:24:19.50,Default,,0,0,0,,Осылай тұрыңыз, ешкім кірмесін.
Dialogue: 0,0:24:19.58,0:24:20.96,Default,,0,0,0,,Ми-чан
Dialogue: 0,0:24:21.04,0:24:24.58,Default,,0,0,0,,Электрондық поштаны жібергеніңіз бәрі жақсы екенін білдіреді.
Dialogue: 0,0:24:24.67,0:24:28.25,Default,,0,0,0,,Бірақ бұл біртүрлі. Мына баланың әкесі хабарсыз кеткен жоқ па?
Dialogue: 0,0:24:28.34,0:24:30.84,Default,,0,0,0,,Иә, анам...
Dialogue: 0,0:24:30.92,0:24:31.92,Default,,0,0,0,,Бұл жұмбақ...
Dialogue: 0,0:24:33.13,0:24:34.51,Default,,0,0,0,,Пика…
Dialogue: 0,0:24:35.97,0:24:41.98,Default,,0,0,0,,(Мен күлдім)
Dialogue: 0,0:24:47.73,0:24:49.86,Default,,0,0,0,,Әкесінің арқасы үлкен
Dialogue: 0,0:24:49.98,0:24:51.57,Default,,0,0,0,,Көңілді жүрсің бе? (Мен) Иә
Dialogue: 0,0:24:53.82,0:24:57.24,Default,,0,0,0,,(Сатошидің ауыр тыныс алуы)
Dialogue: 0,0:24:57.70,0:25:00.41,Default,,0,0,0,,Жұмбақ шешілгенше шыдамаймын.
Dialogue: 0,0:25:00.49,0:25:02.33,Default,,0,0,0,,Менімен келесің бе? пикачу
Dialogue: 0,0:25:02.41,0:25:03.41,Default,,0,0,0,,Жылтыр
Dialogue: 0,0:25:03.50,0:25:04.50,Default,,0,0,0,,Иә
Dialogue: 0,0:25:05.71,0:25:07.25,Default,,0,0,0,,Сатосиді күтіңіз
Dialogue: 0,0:25:08.46,0:25:10.42,Default,,0,0,0,,Мен де барамын...
Dialogue: 0,0:25:10.50,0:25:11.71,Default,,0,0,0,,Мені тастама
Dialogue: 0,0:25:12.51,0:25:14.13,Default,,0,0,0,,Касуми Такеши…
Dialogue: 0,0:25:14.22,0:25:15.22,Default,,0,0,0,,Хехе
Dialogue: 0,0:25:15.30,0:25:17.51,Default,,0,0,0,,Тогепи~ Айпам
Dialogue: 0,0:25:17.60,0:25:19.93,Default,,0,0,0,,Хо хо хо пам
Dialogue: 0,0:25:22.14,0:25:23.14,Default,,0,0,0,,Бұл...
Dialogue: 0,0:25:23.60,0:25:26.02,Default,,0,0,0,,Сатоши-кун, мына Pokegear-ді ал.
Dialogue: 0,0:25:26.10,0:25:27.15,Default,,0,0,0,,Лин мырза
Dialogue: 0,0:25:27.23,0:25:29.94,Default,,0,0,0,,Покемон орталығымен байланыста болған дұрыс емес пе?
Dialogue: 0,0:25:30.02,0:25:33.07,Default,,0,0,0,,Доктор Еменге сылтау айтуды маған қалдырыңыз.
Dialogue: 0,0:25:33.15,0:25:34.15,Default,,0,0,0,,Айпаму
Dialogue: 0,0:25:34.61,0:25:36.36,Default,,0,0,0,,Рахмет Пикачу
Dialogue: 0,0:25:36.45,0:25:37.62,Default,,0,0,0,,Тогепи~
Dialogue: 0,0:25:41.79,0:25:44.66,Default,,0,0,0,,Су кристалданбайды, солай ма?
Dialogue: 0,0:25:44.75,0:25:49.42,Default,,0,0,0,,Егер біз осы өзенмен жүрсек, Сноудон манорына жетуіміз керек.
Dialogue: 0,0:25:54.47,0:25:56.76,Default,,0,0,0,,Ол жігіттер маған көп қиындық туғызуда.
Dialogue: 0,0:25:56.84,0:25:59.39,Default,,0,0,0,,Біз, зымыран командасы, ғарышқа ұмтыламыз.
Dialogue: 0,0:25:59.47,0:26:01.81,Default,,0,0,0,,Төменгі жағы жұмыс істемесе, жоғарыдан өтіңіз.
Dialogue: 0,0:26:01.89,0:26:05.64,Default,,0,0,0,,Сол қамалдағы қазынаны көзде.
Dialogue: 0,0:26:05.73,0:26:08.69,Default,,0,0,0,,Жақсы көрінеді~
Dialogue: 0,0:26:12.61,0:26:13.61,Default,,0,0,0,,Нян?
Dialogue: 0,0:26:13.69,0:26:16.15,Default,,0,0,0,,Теледидардан осылай айтқан жоқ па?
Dialogue: 0,0:26:16.24,0:26:18.45,Default,,0,0,0,,Энтей... солай ма? (Мияу) Мияу~
Dialogue: 0,0:26:23.58,0:26:26.37,Default,,0,0,0,,Уау, бұл сезім...
Dialogue: 0,0:26:32.25,0:26:34.84,Default,,0,0,0,,Бұл кенеттен қорқынышты емес пе?
Dialogue: 0,0:26:34.92,0:26:37.22,Default,,0,0,0,,Қалай болғанда да, инфильтрация сәтті болды
Dialogue: 0,0:26:37.30,0:26:38.88,Default,,0,0,0,,Бірақ бұл не?
Dialogue: 0,0:26:38.97,0:26:41.43,Default,,0,0,0,,Ол жерде қазына болуы екіталай.
Dialogue: 0,0:26:41.51,0:26:45.60,Default,,0,0,0,,Жалпы, қазына – денеңе жақын ұстайтын заттар.
Dialogue: 0,0:26:45.68,0:26:48.23,Default,,0,0,0,,Сонда қазына сол мұнара няда
Dialogue: 0,0:26:48.31,0:26:50.56,Default,,0,0,0,,Егер сіз сол мұнараға барсаңыз...
Dialogue: 0,0:26:50.65,0:26:51.94,Default,,0,0,0,,(Китамура) Жарайды, Сатору, енді уақыты келген сияқты.
Dialogue: 0,0:26:52.02,0:26:54.15,Default,,0,0,0,,Төмен, жоғары көтеріл, жүр!
Dialogue: 0,0:26:54.23,0:26:56.44,Default,,0,0,0,,Төмен түсу, көтерілу, бару...
Dialogue: 0,0:26:56.53,0:26:57.86,Default,,0,0,0,,Лифт жоқ па?
Dialogue: 0,0:26:57.95,0:27:00.20,Default,,0,0,0,,Бұлай болуы мүмкін емес.
Dialogue: 0,0:27:00.28,0:27:01.62,Default,,0,0,0,,Хаа…
Dialogue: 0,0:27:05.70,0:27:07.00,Default,,0,0,0,,Бұл кім болды?
Dialogue: 0,0:27:07.08,0:27:10.00,Default,,0,0,0,,Жоқ, тек сіз бен біз.
Dialogue: 0,0:27:10.42,0:27:11.58,Default,,0,0,0,,Хехе
Dialogue: 0,0:27:12.67,0:27:15.59,Default,,0,0,0,,Мама, біздің үй көрсетілген.
Dialogue: 0,0:27:15.67,0:27:17.34,Default,,0,0,0,,Әдемі, солай емес пе?
Dialogue: 0,0:27:20.68,0:27:23.05,Default,,0,0,0,,Бұрын, Сноудон Хаустың үстінде—
Dialogue: 0,0:27:23.14,0:27:26.18,Default,,0,0,0,,Мен жалынға ұқсайтын нәрсені көрдім, бірақ оны растай алмадым.
Dialogue: 0,0:27:26.81,0:27:30.56,Default,,0,0,0,,Құтқару тобы ертең таңертең келеді...
Dialogue: 0,0:27:30.64,0:27:33.11,Default,,0,0,0,,Хмм, бұл... Покемон ба?
Dialogue: 0,0:27:34.73,0:27:36.36,Default,,0,0,0,,Хо~
Dialogue: 0,0:27:36.44,0:27:39.82,Default,,0,0,0,,Жарайды Булбасар Чикорита Бұл жүзім қамшысы.
Dialogue: 0,0:27:39.90,0:27:41.70,Default,,0,0,0,,Фуши (Чикорита) Чико
Dialogue: 0,0:27:41.78,0:27:44.16,Default,,0,0,0,,Тогепи, сәл үндемей тұрыңызшы.
Dialogue: 0,0:27:44.24,0:27:46.04,Default,,0,0,0,,Тогепи~
Dialogue: 0,0:27:46.12,0:27:47.83,Default,,0,0,0,,Хмф...
Dialogue: 0,0:27:52.88,0:27:55.46,Default,,0,0,0,,Хмм...
Dialogue: 0,0:27:55.75,0:27:57.88,Default,,0,0,0,,Чико~
Dialogue: 0,0:28:01.43,0:28:04.51,Default,,0,0,0,,Сатоси, сен не істеп жатырсың?
Dialogue: 0,0:28:04.89,0:28:07.18,Default,,0,0,0,,Мені құтқарушы деп ойлайсың ба?
Dialogue: 0,0:28:11.23,0:28:15.02,Default,,0,0,0,,Біздің үйге біреу кірмекші болған сияқты.
Dialogue: 0,0:28:22.57,0:28:23.82,Default,,0,0,0,,Сатоси...
Dialogue: 0,0:28:26.33,0:28:27.45,Default,,0,0,0,,Ах
Dialogue: 0,0:28:27.79,0:28:29.75,Default,,0,0,0,,Бұл қауіпті, олай істеме.
Dialogue: 0,0:28:29.83,0:28:31.96,Default,,0,0,0,,Не? анам
Dialogue: 0,0:28:32.50,0:28:34.33,Default,,0,0,0,,Біраздан соң—
Dialogue: 0,0:28:34.67,0:28:36.75,Default,,0,0,0,,Бұл сіздің арқаңыздағы Пикачу, солай ма?
Dialogue: 0,0:28:39.80,0:28:42.84,Default,,0,0,0,,Ах, Булбасар, Чикорита да бар.
Dialogue: 0,0:28:42.93,0:28:46.18,Default,,0,0,0,,Анасы: Бұл аға Покемон жаттықтырушысы ма?
Dialogue: 0,0:28:46.26,0:28:47.64,Default,,0,0,0,,Иә... иә
Dialogue: 0,0:28:47.72,0:28:50.52,Default,,0,0,0,,Сізде басқа Покемон бар ма?
Dialogue: 0,0:28:50.60,0:28:51.60,Default,,0,0,0,,Сәлем әке
Dialogue: 0,0:28:52.18,0:28:53.52,Default,,0,0,0,,Өткенге… электрондық хат па?
Dialogue: 0,0:28:56.65,0:28:58.40,Default,,0,0,0,,Уф...
Dialogue: 0,0:28:59.15,0:29:01.19,Default,,0,0,0,,Жарайсыңдар бәріңе
Dialogue: 0,0:29:01.28,0:29:02.49,Default,,0,0,0,,Цикорий~
Dialogue: 0,0:29:02.57,0:29:06.45,Default,,0,0,0,,Чикорита мен Булбасар, мені құтқарғаның үшін рахмет.
Dialogue: 0,0:29:29.22,0:29:32.73,Default,,0,0,0,,(Pokégear қоңырау үні)
Dialogue: 0,0:29:32.81,0:29:35.02,Default,,0,0,0,,Амансың ба? Бәріңе, Рин-сан
Dialogue: 0,0:29:35.10,0:29:37.48,Default,,0,0,0,,Сатоши Бұл теледидарда болды.
Dialogue: 0,0:29:37.56,0:29:38.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:29:39.19,0:29:42.40,Default,,0,0,0,,Кешіріңіз, доктор Оук, бірақ мен...
Dialogue: 0,0:29:42.49,0:29:45.11,Default,,0,0,0,,Егер соншалықты алысқа барсаң, мен саған қайтып кел демеймін.
Dialogue: 0,0:29:45.20,0:29:47.32,Default,,0,0,0,,Анамды құтқарып, қайтып кел.
Dialogue: 0,0:29:47.41,0:29:48.41,Default,,0,0,0,,Иә
Dialogue: 0,0:29:48.49,0:29:51.33,Default,,0,0,0,,Сатоси, бұл Джон. Сіз Unow-ды көрдіңіз бе?
Dialogue: 0,0:29:51.41,0:29:52.70,Default,,0,0,0,,Жоқ, әлі жоқ...
Dialogue: 0,0:29:52.79,0:29:56.33,Default,,0,0,0,,көремін. Доктор Шлейдің зерттеу файлына сәйкес—
Dialogue: 0,0:29:56.87,0:30:01.13,Default,,0,0,0,,Шамасы, бейтаныс басқа жаратылыстардың санасын сезіну қабілетіне ие.
Dialogue: 0,0:30:01.21,0:30:02.21,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:30:02.30,0:30:06.26,Default,,0,0,0,,Адамның жүрегін сезініп, оған пішін беру
Dialogue: 0,0:30:06.34,0:30:07.89,Default,,0,0,0,,Жүректі сезіну...
Dialogue: 0,0:30:07.97,0:30:09.60,Default,,0,0,0,,Есімсіздік Ми Чанның жүрегінде.
Dialogue: 0,0:30:09.68,0:30:11.93,Default,,0,0,0,,Менің ойымша, бұл әрекет етуде.
Dialogue: 0,0:30:12.26,0:30:15.52,Default,,0,0,0,,Бұл хрусталь мұнараны оның жүрегіне әрекет еткен бейтаныс адам жасаған.
Dialogue: 0,0:30:15.60,0:30:18.10,Default,,0,0,0,,Ол ойлап тапқан болуы керек.
Dialogue: 0,0:30:23.44,0:30:24.44,Default,,0,0,0,,Хинок
Dialogue: 0,0:30:24.53,0:30:26.40,Default,,0,0,0,,Хиноараши Каенхоша
Dialogue: 0,0:30:26.49,0:30:31.78,Default,,0,0,0,,Хино Хино
Dialogue: 0,0:30:31.87,0:30:34.58,Default,,0,0,0,,Ия, о...
Dialogue: 0,0:30:36.37,0:30:38.21,Default,,0,0,0,,Бұл қайтадан Каенхуша. Бұл қайтадан Каенхушада.
Dialogue: 0,0:30:38.29,0:30:42.13,Default,,0,0,0,,Жүгері хино
Dialogue: 0,0:30:42.21,0:30:43.50,Default,,0,0,0,,Жақсы, Vulpix
Dialogue: 0,0:30:43.59,0:30:45.76,Default,,0,0,0,,Жарайды, ойыншы ауыстырыңыз.
Dialogue: 0,0:30:46.26,0:30:47.72,Default,,0,0,0,,Қолтырауын Крокодил Қолтырауын
Dialogue: 0,0:30:47.80,0:30:48.80,Default,,0,0,0,,Сарқырама
Dialogue: 0,0:30:48.88,0:30:52.14,Default,,0,0,0,,Ия
Dialogue: 0,0:30:54.22,0:30:55.47,Default,,0,0,0,,Жарайды, енді, Пикачу.
Dialogue: 0,0:30:55.56,0:30:56.81,Default,,0,0,0,,Пика
Dialogue: 0,0:31:05.03,0:31:06.53,Default,,0,0,0,,Балалар, кеттік.
Dialogue: 0,0:31:06.61,0:31:10.36,Default,,0,0,0,,Уау!
Dialogue: 0,0:31:10.45,0:31:11.53,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:31:14.20,0:31:16.00,Default,,0,0,0,,Хуу… Крокодил…
Dialogue: 0,0:31:16.08,0:31:18.33,Default,,0,0,0,,Теңіз жұлдызы, еңбегіңіз үшін рахмет.
Dialogue: 0,0:31:18.41,0:31:20.58,Default,,0,0,0,,Вани-но-ко да жақсы өнер көрсетті.
Dialogue: 0,0:31:39.18,0:31:41.52,Default,,0,0,0,,Не... не? Пика?
Dialogue: 0,0:31:41.60,0:31:45.15,Default,,0,0,0,,Бұл доктор Эмен айтып отырған Иесіздің күші ме?
Dialogue: 0,0:31:45.23,0:31:46.32,Default,,0,0,0,,О, расымен бе?
Dialogue: 0,0:31:46.40,0:31:48.40,Default,,0,0,0,,Мен бәрібір кетуім керек.
Dialogue: 0,0:32:05.17,0:32:06.34,Default,,0,0,0,,Хокс та керемет болды.
Dialogue: 0,0:32:06.42,0:32:10.47,Default,,0,0,0,,Бұл Ми-чанның Жүрегінің әлемі.
Dialogue: 0,0:32:10.55,0:32:11.76,Default,,0,0,0,,Бұл...
Dialogue: 0,0:32:14.18,0:32:16.60,Default,,0,0,0,,Хмф, ой...
Dialogue: 0,0:32:17.60,0:32:19.73,Default,,0,0,0,,Көз-tat-tat... (Мияу) Мяу~
Dialogue: 0,0:32:20.56,0:32:24.02,Default,,0,0,0,,Мен түбіне жеттім деп ойлаған кезде...
Dialogue: 0,0:32:25.27,0:32:27.36,Default,,0,0,0,,Бұл Покемон ба?
Dialogue: 0,0:32:27.65,0:32:30.78,Default,,0,0,0,,Түсінбейтін нәрселерден аулақ болған дұрыс.
Dialogue: 0,0:32:30.86,0:32:32.66,Default,,0,0,0,,Бірақ біз осы жерден өтуіміз керек...
Dialogue: 0,0:32:32.74,0:32:34.62,Default,,0,0,0,,Мен ол мұнараға бара алмаймын.
Dialogue: 0,0:32:34.70,0:32:36.99,Default,,0,0,0,,Егер бұлай болса, онда жасырын бармау керек.
Dialogue: 0,0:32:37.08,0:32:38.24,Default,,0,0,0,,Аяқсыз...
Dialogue: 0,0:32:38.33,0:32:40.12,Default,,0,0,0,,Сасашиаши... Шинобиаши
Dialogue: 0,0:32:40.20,0:32:41.66,Default,,0,0,0,,Қосылған аяқ... (Мияу) Қосылған аяқ...
Dialogue: 0,0:32:41.75,0:32:43.08,Default,,0,0,0,,Шинобиаши
Dialogue: 0,0:32:44.75,0:32:46.25,Default,,0,0,0,,Бұрынғы ағалар —
Dialogue: 0,0:32:46.34,0:32:49.05,Default,,0,0,0,,Сіз бұл үйге кірген сияқтысыз.
Dialogue: 0,0:32:49.38,0:32:50.80,Default,,0,0,0,,Сіз мені қуып жібергіңіз келе ме?
Dialogue: 0,0:32:52.55,0:32:55.05,Default,,0,0,0,,Мен Покемон шайқасын өткізгім келеді
Dialogue: 0,0:32:55.14,0:32:56.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:32:56.22,0:32:57.81,Default,,0,0,0,,Бірақ мұны істеуге бола ма?
Dialogue: 0,0:32:58.22,0:33:01.35,Default,,0,0,0,,Мен мұны істей аламын, егер сіз қаласаңыз.
Dialogue: 0,0:33:01.68,0:33:04.10,Default,,0,0,0,,Иә, мұны істей аласыз.
Dialogue: 0,0:33:04.69,0:33:06.36,Default,,0,0,0,,Мен әлі кішкентаймын, бірақ...
Dialogue: 0,0:33:07.23,0:33:10.86,Default,,0,0,0,,Сен өскенде істей аласың.
Dialogue: 0,0:33:22.87,0:33:23.87,Default,,0,0,0,,Ах!
Dialogue: 0,0:33:32.09,0:33:35.51,Default,,0,0,0,,Мен, бұл менің бірінші рет Покемон шайқасым.
Dialogue: 0,0:33:35.59,0:33:37.43,Default,,0,0,0,,Мен мұны істей аламын.
Dialogue: 0,0:33:42.60,0:33:43.73,Default,,0,0,0,,Сіз мұны істей аласыз.
Dialogue: 0,0:33:48.27,0:33:49.44,Default,,0,0,0,,Энтей
Dialogue: 0,0:33:51.07,0:33:53.40,Default,,0,0,0,,Балалар, сендер Pokemon жаттықтырушыларсыңдар, солай ма?
Dialogue: 0,0:33:53.78,0:33:55.53,Default,,0,0,0,,Сонда не болды?
Dialogue: 0,0:34:01.16,0:34:02.58,Default,,0,0,0,,Соғысайық
Dialogue: 0,0:34:02.66,0:34:06.25,Default,,0,0,0,,Мен сенің кім екеніңді білмеймін, бірақ қазір оған уақытым жоқ.
Dialogue: 0,0:34:06.33,0:34:07.96,Default,,0,0,0,,Бұл қызықсыз.
Dialogue: 0,0:34:08.04,0:34:09.21,Default,,0,0,0,,Онда
Dialogue: 0,0:34:09.29,0:34:11.34,Default,,0,0,0,,Анамды қайда апардың?
Dialogue: 0,0:34:12.00,0:34:15.26,Default,,0,0,0,,Мұнда тек мен және анам мен әкем ғана бар.
Dialogue: 0,0:34:15.34,0:34:16.34,Default,,0,0,0,,Иә.
Dialogue: 0,0:34:16.43,0:34:17.76,Default,,0,0,0,,Не?
Dialogue: 0,0:34:17.84,0:34:19.01,Default,,0,0,0,,Сатоси...
Dialogue: 0,0:34:19.30,0:34:21.97,Default,,0,0,0,,Сенің атың Мен, солай емес пе?
Dialogue: 0,0:34:22.43,0:34:24.39,Default,,0,0,0,,О, сен мені жақсы білесің.
Dialogue: 0,0:34:26.31,0:34:29.27,Default,,0,0,0,,Ми Чан кішірек бала болуы керек...
Dialogue: 0,0:34:29.35,0:34:33.44,Default,,0,0,0,,Бұл Ми-чанның Бейненің күшімен жасалған әлемі.
Dialogue: 0,0:34:33.82,0:34:37.36,Default,,0,0,0,,Ол бала кез келген нәрсені жасай алады, кез келген нәрсеге айнала алады.
Dialogue: 0,0:34:37.82,0:34:38.86,Default,,0,0,0,,Бұл...
Dialogue: 0,0:34:38.95,0:34:40.70,Default,,0,0,0,,Сіз шайқасқа барасыз ба? Неге жоқ?
Dialogue: 0,0:34:40.78,0:34:43.62,Default,,0,0,0,,Қарғыс атсын... Жарайды, а...
Dialogue: 0,0:34:43.70,0:34:46.25,Default,,0,0,0,,Менің әпкемнің серіктесі мен...
Dialogue: 0,0:34:46.33,0:34:47.41,Default,,0,0,0,,Мен маңызды тақырып қозғағаннан кейін айтатының осы ма?
Dialogue: 0,0:34:47.83,0:34:49.08,Default,,0,0,0,,Такеши
Dialogue: 0,0:34:49.17,0:34:50.92,Default,,0,0,0,,Энтей жоғарыдан келді.
Dialogue: 0,0:34:51.00,0:34:53.42,Default,,0,0,0,,Анам осында болуы керек.
Dialogue: 0,0:34:53.50,0:34:57.26,Default,,0,0,0,,Кеттік, Сатоши, алдымен анамды тап.
Dialogue: 0,0:34:57.84,0:35:00.64,Default,,0,0,0,,Иә, кеттік, Пикачу, Пика.
Dialogue: 0,0:35:02.51,0:35:04.47,Default,,0,0,0,,Үш Покемон пайдаланылды
Dialogue: 0,0:35:04.56,0:35:06.14,Default,,0,0,0,,Сіз ауыстыруға еркін болу туралы не ойлайсыз?
Dialogue: 0,0:35:06.23,0:35:07.68,Default,,0,0,0,,Оны алып кетуге келген анасымен бірге —
Dialogue: 0,0:35:23.70,0:35:26.20,Default,,0,0,0,,Зубатқа барыңыз
Dialogue: 0,0:35:28.41,0:35:29.92,Default,,0,0,0,,Зуба
Dialogue: 0,0:35:33.46,0:35:35.00,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:35:35.84,0:35:37.13,Default,,0,0,0,,...
Dialogue: 0,0:35:41.55,0:35:42.72,Default,,0,0,0,,Моко~
Dialogue: 0,0:35:43.14,0:35:45.56,Default,,0,0,0,,Зубат Чоонпада Зубат
Dialogue: 0,0:35:45.64,0:35:46.64,Default,,0,0,0,,(Чуонпа дыбысы)
Dialogue: 0,0:35:48.18,0:35:51.10,Default,,0,0,0,,Мококо Мококо Мококо…
Dialogue: 0,0:35:51.19,0:35:54.77,Default,,0,0,0,,Бұл жұмыс істейді Zubat Tsubasa депрессиялық шабуыл
Dialogue: 0,0:35:56.57,0:35:57.99,Default,,0,0,0,,Ол келе жатыр, қашыңыз.
Dialogue: 0,0:35:58.07,0:35:59.36,Default,,0,0,0,,Зуба Мококо~
Dialogue: 0,0:35:59.86,0:36:02.20,Default,,0,0,0,,Жақсы, мен тағы келемін, Цуцуки.
Dialogue: 0,0:36:02.28,0:36:03.66,Default,,0,0,0,,Мокозуба
Dialogue: 0,0:36:03.74,0:36:05.49,Default,,0,0,0,,Енді электр тогының соғуы
Dialogue: 0,0:36:05.58,0:36:08.87,Default,,0,0,0,,Мо~ Мокок
Dialogue: 0,0:36:09.50,0:36:11.00,Default,,0,0,0,,Зубатқа қайтыңыз
Dialogue: 0,0:36:14.38,0:36:15.59,Default,,0,0,0,,Сіз қолыңыздан келгеннің бәрін жасадыңыз
Dialogue: 0,0:36:15.96,0:36:19.38,Default,,0,0,0,,Ия, бұл керемет! Мококо Мокококо Мококо…
Dialogue: 0,0:36:19.46,0:36:21.80,Default,,0,0,0,,Шайқас қазір басталады.
Dialogue: 0,0:36:21.88,0:36:23.84,Default,,0,0,0,,...
Dialogue: 0,0:36:25.39,0:36:27.06,Default,,0,0,0,,Жүгері
Dialogue: 0,0:36:27.72,0:36:31.10,Default,,0,0,0,,Сонда бұл бала ше?
Dialogue: 0,0:36:35.94,0:36:37.65,Default,,0,0,0,,Ол
Dialogue: 0,0:36:37.73,0:36:39.57,Default,,0,0,0,,Бұл қоңыр аю ма?
Dialogue: 0,0:36:39.65,0:36:42.28,Default,,0,0,0,,Бұл әпкеңізге жарасатын сүйкімді Покемон.
Dialogue: 0,0:36:42.74,0:36:44.70,Default,,0,0,0,,Тек сүйкімді емес
Dialogue: 0,0:36:44.78,0:36:46.24,Default,,0,0,0,,Химегума Бакурецу соққысы
Dialogue: 0,0:36:47.08,0:36:48.54,Default,,0,0,0,,Оған~
Dialogue: 0,0:36:48.62,0:36:50.16,Default,,0,0,0,,Жүгері
Dialogue: 0,0:36:51.91,0:36:54.33,Default,,0,0,0,,Vulpix бос емес.
Dialogue: 0,0:36:54.42,0:36:56.08,Default,,0,0,0,,Химегума Мидарашикаки
Dialogue: 0,0:36:56.17,0:36:58.42,Default,,0,0,0,,Химеккон
Dialogue: 0,0:36:58.75,0:37:00.38,Default,,0,0,0,,Жүгері
Dialogue: 0,0:37:00.80,0:37:02.47,Default,,0,0,0,,Химе ~ Жүгері ~
Dialogue: 0,0:37:02.55,0:37:04.47,Default,,0,0,0,,Ахаха
Dialogue: 0,0:37:05.93,0:37:08.64,Default,,0,0,0,,Ми-чанның жүрегімен жасалған Покемон...
Dialogue: 0,0:37:08.72,0:37:10.97,Default,,0,0,0,,Көрінгеннен де күшті
Dialogue: 0,0:37:11.43,0:37:15.48,Default,,0,0,0,,Нукиаши, Сашиаши, Шинобиаши...
Dialogue: 0,0:37:15.98,0:37:18.90,Default,,0,0,0,,Мұндай жерде шынымен қазына бар ма?
Dialogue: 0,0:37:18.98,0:37:20.28,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:37:20.36,0:37:23.32,Default,,0,0,0,,Енді үйге құр қол қайту мүмкін емес.
Dialogue: 0,0:37:23.40,0:37:25.28,Default,,0,0,0,,Жүгері Химет
Dialogue: 0,0:37:27.66,0:37:29.12,Default,,0,0,0,,Артқа оралыңыз, Vulpix
Dialogue: 0,0:37:31.16,0:37:33.79,Default,,0,0,0,,Уау ахаха хаха... Мықты екенсің.
Dialogue: 0,0:37:33.87,0:37:35.21,Default,,0,0,0,,Сіз де
Dialogue: 0,0:37:35.29,0:37:38.42,Default,,0,0,0,,Әлі де әлемдегі ең жақсы покемон өсіруші болуды мақсат етеді —
Dialogue: 0,0:37:38.50,0:37:39.75,Default,,0,0,0,,Мен жаттығудамын
Dialogue: 0,0:37:42.76,0:37:45.01,Default,,0,0,0,,Ива~
Dialogue: 0,0:37:45.38,0:37:48.55,Default,,0,0,0,,Тренинг - жаттықтырушылар үшін де, Покемон үшін де кілт.
Dialogue: 0,0:37:48.89,0:37:52.72,Default,,0,0,0,,Көтеру - бұл кілт... Иә, хехехе
Dialogue: 0,0:37:52.81,0:37:55.94,Default,,0,0,0,,Иә, бұл күлімсіреу жақсы күлкі.
Dialogue: 0,0:37:56.02,0:37:58.19,Default,,0,0,0,,Уфуфу, біртүрлі бала
Dialogue: 0,0:38:01.02,0:38:02.15,Default,,0,0,0,,Киіз үй~
Dialogue: 0,0:38:02.23,0:38:04.11,Default,,0,0,0,,Күнжіт пілінің айналмалы шабуылы
Dialogue: 0,0:38:05.40,0:38:06.49,Default,,0,0,0,,Паопао
Dialogue: 0,0:38:09.24,0:38:11.87,Default,,0,0,0,,Ива~
Dialogue: 0,0:38:12.91,0:38:13.91,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:38:14.00,0:38:18.33,Default,,0,0,0,,Уууу, мынау кішкентай болғандықтан, сақтығыңызды түсірмеңіз.
Dialogue: 0,0:38:50.62,0:38:53.29,Default,,0,0,0,,Бұл суретті кітап Ми Чандікі ме?
Dialogue: 0,0:38:53.37,0:38:54.54,Default,,0,0,0,,Иә
Dialogue: 0,0:38:54.62,0:38:57.46,Default,,0,0,0,,Оны маған әкем үнемі оқып беретін.
Dialogue: 0,0:38:57.58,0:38:58.58,Default,,0,0,0,,Иә
Dialogue: 0,0:38:59.29,0:39:02.00,Default,,0,0,0,,Сіз оны анаңызға бере аласыз.
Dialogue: 0,0:39:06.51,0:39:08.68,Default,,0,0,0,,Ми-чан, сен осы уақыт бойы жалғыз болдың ба?
Dialogue: 0,0:39:08.76,0:39:09.76,Default,,0,0,0,,Иә
Dialogue: 0,0:39:09.84,0:39:11.34,Default,,0,0,0,,Сіз жалғыз болдыңыз ба?
Dialogue: 0,0:39:12.18,0:39:14.10,Default,,0,0,0,,Кішкене ғана...
Dialogue: 0,0:39:17.52,0:39:22.90,Default,,0,0,0,,Бірақ қазір бәрі жақсы, анам мен әкем осында...
Dialogue: 0,0:39:49.17,0:39:52.30,Default,,0,0,0,,Пи~ka~ pi?
Dialogue: 0,0:39:58.31,0:40:01.06,Default,,0,0,0,,Бұл жолы менің жауынгерлік серіктесім кім болады?
Dialogue: 0,0:40:01.52,0:40:03.44,Default,,0,0,0,,Сонымен, Такеши... Пика?
Dialogue: 0,0:40:07.57,0:40:09.53,Default,,0,0,0,,Мен жоғалтуға жол жоқ.
Dialogue: 0,0:40:10.03,0:40:12.11,Default,,0,0,0,,Энтей де иллюзия ма?
Dialogue: 0,0:40:12.20,0:40:13.20,Default,,0,0,0,,Пи~ка
Dialogue: 0,0:40:13.78,0:40:15.99,Default,,0,0,0,,Мен күштірек жаттықтырушымен шайқасқым келеді.
Dialogue: 0,0:40:16.08,0:40:19.91,Default,,0,0,0,,Не? Сатоси, мұны маған қалдыр
Dialogue: 0,0:40:20.00,0:40:21.08,Default,,0,0,0,,Мен тастап кеткен құралдар—
Dialogue: 0,0:40:21.16,0:40:23.38,Default,,0,0,0,,Әлемнің сұлу қызы, оның аты Касуми
Dialogue: 0,0:40:23.46,0:40:27.25,Default,,0,0,0,,Егер әлем шын болса, Hanada Gym спорт залының жетекшісі болатын қыз.
Dialogue: 0,0:40:27.34,0:40:29.05,Default,,0,0,0,,Сіз жаттығу залының жетекшісісіз бе?
Dialogue: 0,0:40:29.13,0:40:31.51,Default,,0,0,0,,Осыны есте ұстай аласыз ба?
Dialogue: 0,0:40:31.88,0:40:34.76,Default,,0,0,0,,Спортзал жетекшісі болу үшін ересек болу міндетті емес.
Dialogue: 0,0:40:34.85,0:40:37.81,Default,,0,0,0,,Мен кез келген нәрсеге айнала аламын.
Dialogue: 0,0:40:37.89,0:40:38.97,Default,,0,0,0,,Уау
Dialogue: 0,0:40:48.11,0:40:49.23,Default,,0,0,0,,Уау
Dialogue: 0,0:40:50.94,0:40:54.32,Default,,0,0,0,,Бұл баланың шынайы тұлғасы Сатошидің анасымен бірдей болуы керек.
Dialogue: 0,0:40:54.41,0:40:55.91,Default,,0,0,0,,Ананың орнына асығыңыз
Dialogue: 0,0:40:55.99,0:40:56.99,Default,,0,0,0,,Иә
Dialogue: 0,0:40:58.29,0:41:02.08,Default,,0,0,0,,Мен Ханада спорт залынанмын, мен сізбен су түрі ретінде әрекет етемін.
Dialogue: 0,0:41:02.16,0:41:05.00,Default,,0,0,0,,Онда мен де су типіндегі Покемонмын.
Dialogue: 0,0:41:15.22,0:41:16.22,Default,,0,0,0,,Уау, жылтыр
Dialogue: 0,0:41:20.14,0:41:21.64,Default,,0,0,0,,Пика?
Dialogue: 0,0:41:22.02,0:41:24.02,Default,,0,0,0,,Хмм... Аа...
Dialogue: 0,0:41:27.94,0:41:31.57,Default,,0,0,0,,Түсіндім, мұнда сіз кез келген нәрсені жасай аласыз.
Dialogue: 0,0:41:31.65,0:41:33.36,Default,,0,0,0,,Шайқасайық
Dialogue: 0,0:41:33.74,0:41:36.41,Default,,0,0,0,,Уууу, кеттік.
Dialogue: 0,0:41:36.49,0:41:38.87,Default,,0,0,0,,Кингдра өтінемін
Dialogue: 0,0:41:40.54,0:41:41.54,Default,,0,0,0,,Осы жолы жеңіске жеткеніңізбен құттықтаймын.
Dialogue: 0,0:41:42.25,0:41:44.46,Default,,0,0,0,,...
Dialogue: 0,0:41:45.33,0:41:47.08,Default,,0,0,0,,Тосаки~n
Dialogue: 0,0:41:47.17,0:41:48.75,Default,,0,0,0,,Дора
Dialogue: 0,0:41:49.00,0:41:50.30,Default,,0,0,0,,Тоса
Dialogue: 0,0:41:50.80,0:41:53.34,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,0:41:53.42,0:41:54.93,Default,,0,0,0,,Дора
Dialogue: 0,0:41:55.01,0:41:56.47,Default,,0,0,0,,Тоса
Dialogue: 0,0:41:57.72,0:41:59.89,Default,,0,0,0,,Тосакинто Мидарезукиё
Dialogue: 0,0:41:59.97,0:42:01.89,Default,,0,0,0,,Тосаки~ndora
Dialogue: 0,0:42:02.22,0:42:04.10,Default,,0,0,0,,Тоса Тоса Дора Дора
Dialogue: 0,0:42:04.18,0:42:05.35,Default,,0,0,0,,Тоса
Dialogue: 0,0:42:05.44,0:42:07.69,Default,,0,0,0,,Dr... Sa...
Dialogue: 0,0:42:07.77,0:42:08.94,Default,,0,0,0,,Ах
Dialogue: 0,0:42:12.15,0:42:14.49,Default,,0,0,0,,Тосакинто, сен керемет жұмыс жасадың.
Dialogue: 0,0:42:14.57,0:42:17.86,Default,,0,0,0,,Мен жасадым, мен жасадым, хехехе
Dialogue: 0,0:42:19.37,0:42:21.16,Default,,0,0,0,,Келесіде мына бала.
Dialogue: 0,0:42:23.45,0:42:24.66,Default,,0,0,0,,Мұны жасамаңыз
Dialogue: 0,0:42:24.75,0:42:26.37,Default,,0,0,0,,Бұл мүмкін бе?
Dialogue: 0,0:42:26.46,0:42:29.79,Default,,0,0,0,,Қызықсыз логика туралы ойламаңыз, тек әрекет етіңіз.
Dialogue: 0,0:42:29.88,0:42:32.59,Default,,0,0,0,,Командалық зымыран ғарышқа бағытталған
Dialogue: 0,0:42:32.67,0:42:36.51,Default,,0,0,0,,Биікті көздеу, мияу, ня
Dialogue: 0,0:42:38.34,0:42:39.89,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:42:43.77,0:42:45.27,Default,,0,0,0,,Bo~
Dialogue: 0,0:42:45.35,0:42:46.48,Default,,0,0,0,,Бұл үлкен мәселе
Dialogue: 0,0:42:47.06,0:42:49.02,Default,,0,0,0,,Bo~
Dialogue: 0,0:42:52.07,0:42:53.98,Default,,0,0,0,,Мантин бар
Dialogue: 0,0:42:54.48,0:42:56.32,Default,,0,0,0,,Bo~
Dialogue: 0,0:43:00.28,0:43:01.57,Default,,0,0,0,,Тұтқынға түсті
Dialogue: 0,0:43:01.66,0:43:02.95,Default,,0,0,0,,Көпіршік Көсен
Dialogue: 0,0:43:04.45,0:43:06.54,Default,,0,0,0,,Бобобобо... Сәлем!
Dialogue: 0,0:43:07.87,0:43:09.29,Default,,0,0,0,,Теңіз жұлдыздарының айналуы
Dialogue: 0,0:43:09.67,0:43:10.67,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:43:13.63,0:43:14.71,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:43:16.30,0:43:19.59,Default,,0,0,0,,Уфуфу, сен қалай ойлайсың?
Dialogue: 0,0:43:19.68,0:43:22.64,Default,,0,0,0,,Керемет уау
Dialogue: 0,0:43:22.72,0:43:24.51,Default,,0,0,0,,Мантиндік шабуыл
Dialogue: 0,0:43:24.60,0:43:25.97,Default,,0,0,0,,Теңіз жұлдызы
Dialogue: 0,0:43:26.06,0:43:28.56,Default,,0,0,0,,Хеябо~
Dialogue: 0,0:43:29.56,0:43:31.56,Default,,0,0,0,,Хеябо~
Dialogue: 0,0:43:31.69,0:43:34.40,Default,,0,0,0,,Хеябо~
Dialogue: 0,0:43:35.94,0:43:39.65,Default,,0,0,0,,Көңілді Бұл шынымен қызық
Dialogue: 0,0:43:40.11,0:43:43.95,Default,,0,0,0,,Сенің күлгеніңді көргенде қатты қуанамын.
Dialogue: 0,0:43:44.28,0:43:46.37,Default,,0,0,0,,Рахмет, әке.
Dialogue: 0,0:44:02.93,0:44:04.14,Default,,0,0,0,,Жылтыр
Dialogue: 0,0:44:07.14,0:44:08.39,Default,,0,0,0,,Сатоши…
Dialogue: 0,0:44:08.48,0:44:10.10,Default,,0,0,0,,Анашым, амансыз ба?
Dialogue: 0,0:44:10.19,0:44:11.73,Default,,0,0,0,,Менде бәрі жақсы
Dialogue: 0,0:44:11.81,0:44:16.07,Default,,0,0,0,,Бірақ сен әлі мұндай жерге келуге бейқам бала екенсің.
Dialogue: 0,0:44:16.15,0:44:17.73,Default,,0,0,0,,Себебі мен мамамның баласымын
Dialogue: 0,0:44:17.82,0:44:18.99,Default,,0,0,0,,Уау
Dialogue: 0,0:44:19.82,0:44:20.86,Default,,0,0,0,,Ми-чан?
Dialogue: 0,0:44:20.95,0:44:22.07,Default,,0,0,0,,Иә
Dialogue: 0,0:44:22.16,0:44:25.20,Default,,0,0,0,,«Белгісіз» жоқ па?
Dialogue: 0,0:44:25.28,0:44:28.83,Default,,0,0,0,,Мені осында әкелген Покемон жаңа ғана кетіп қалды.
Dialogue: 0,0:44:29.62,0:44:30.87,Default,,0,0,0,,That's Энтей
Dialogue: 0,0:44:30.96,0:44:34.38,Default,,0,0,0,,Бұл хрусталь мұнара да, Энтей де Ми Чанның жүрегін сезді.
Dialogue: 0,0:44:34.46,0:44:37.09,Default,,0,0,0,,Оны Unown деп аталатын покемон жасаған.
Dialogue: 0,0:44:37.17,0:44:38.42,Default,,0,0,0,,Бұл...
Dialogue: 0,0:44:38.51,0:44:40.88,Default,,0,0,0,,Әйтеуір, бұл жерден кетейік.
Dialogue: 0,0:44:40.97,0:44:42.30,Default,,0,0,0,,Оны алып кетуге келген анасымен бірге —
Dialogue: 0,0:44:43.09,0:44:47.22,Default,,0,0,0,,Оян, оян, Ми Чан
Dialogue: 0,0:44:50.31,0:44:52.31,Default,,0,0,0,,Не болды? анам
Dialogue: 0,0:44:52.39,0:44:54.44,Default,,0,0,0,,Мұқият тыңда, Ми Чан.
Dialogue: 0,0:44:59.48,0:45:02.24,Default,,0,0,0,,Мен Ми Чанның нағыз анасы емеспін.
Dialogue: 0,0:45:02.32,0:45:03.53,Default,,0,0,0,,А...
Dialogue: 0,0:45:03.61,0:45:07.37,Default,,0,0,0,,Мен Ми Чанның анасы емес, Сатошидің анасымын.
Dialogue: 0,0:45:08.58,0:45:11.45,Default,,0,0,0,,Ми-чан, сен мені есіңде ме?
Dialogue: 0,0:45:11.75,0:45:14.04,Default,,0,0,0,,Біз Масала қаласында бұрын кездескенбіз, солай ма?
Dialogue: 0,0:45:14.67,0:45:16.75,Default,,0,0,0,,Менімен бірге жүр
Dialogue: 0,0:45:16.84,0:45:18.38,Default,,0,0,0,,Аня, көпшіліктен қорықпайсың ба?
Dialogue: 0,0:45:20.71,0:45:22.13,Default,,0,0,0,,Бұл жерде қалуға болмайды.
Dialogue: 0,0:45:25.01,0:45:26.01,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:45:29.01,0:45:30.01,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:45:31.77,0:45:33.81,Default,,0,0,0,,Ай!
Dialogue: 0,0:45:33.89,0:45:35.85,Default,,0,0,0,,Ах!
Dialogue: 0,0:45:45.82,0:45:48.37,Default,,0,0,0,,Мама... Мама
Dialogue: 0,0:45:48.87,0:45:50.33,Default,,0,0,0,,Анашым, амансыз ба?
Dialogue: 0,0:45:50.41,0:45:52.45,Default,,0,0,0,,Иә, ә...
Dialogue: 0,0:45:54.54,0:45:56.04,Default,,0,0,0,,Ха…
Dialogue: 0,0:46:01.63,0:46:03.38,Default,,0,0,0,,Анам осында
Dialogue: 0,0:46:07.14,0:46:08.22,Default,,0,0,0,,Ах
Dialogue: 0,0:46:13.43,0:46:14.60,Default,,0,0,0,,Не болды? мен
Dialogue: 0,0:46:14.68,0:46:18.15,Default,,0,0,0,,Анасы мен әкесін сол бала алып кетеді.
Dialogue: 0,0:46:19.27,0:46:22.03,Default,,0,0,0,,Ah... Ah Сатоши
Dialogue: 0,0:46:22.11,0:46:23.86,Default,,0,0,0,,Мама Мама
Dialogue: 0,0:46:23.94,0:46:26.53,Default,,0,0,0,,Ол адамды тастап кет.
Dialogue: 0,0:46:26.61,0:46:29.07,Default,,0,0,0,,Сен мұны істей аласың ба, анашым?
Dialogue: 0,0:46:29.16,0:46:30.16,Default,,0,0,0,,Пика
Dialogue: 0,0:46:30.99,0:46:34.04,Default,,0,0,0,,Міне, бұл адам Мидың анасы.
Dialogue: 0,0:46:34.12,0:46:35.58,Default,,0,0,0,,Өз еркімен шешім қабылдамаңыз
Dialogue: 0,0:46:35.66,0:46:39.92,Default,,0,0,0,,Шығу. Егер кетпесеңіз, Мен сізді қуып шығамын.
Dialogue: 0,0:46:40.00,0:46:41.59,Default,,0,0,0,,Қатты… қатты қиын…
Dialogue: 0,0:46:41.67,0:46:43.76,Default,,0,0,0,,Вани-но-ко мен сені таңдадым.
Dialogue: 0,0:46:48.01,0:46:50.01,Default,,0,0,0,,...
Dialogue: 0,0:46:50.35,0:46:52.14,Default,,0,0,0,,Сіз мені жеңе аласыз ба?
Dialogue: 0,0:46:52.22,0:46:54.39,Default,,0,0,0,,Мен иллюзияға жеңілуге ​​бола ма?
Dialogue: 0,0:46:54.47,0:46:56.94,Default,,0,0,0,,Крокодил
Dialogue: 0,0:46:57.02,0:46:59.56,Default,,0,0,0,,Ваня~
Dialogue: 0,0:47:00.02,0:47:03.78,Default,,0,0,0,,Мен елес екенімді ме? ақымақ
Dialogue: 0,0:47:03.86,0:47:06.19,Default,,0,0,0,,Ванива~
Dialogue: 0,0:47:07.65,0:47:10.03,Default,,0,0,0,,Вани Вани Вани Вани Вани Ваня~
Dialogue: 0,0:47:11.37,0:47:13.24,Default,,0,0,0,,Кері қайт, қолтырауын
Dialogue: 0,0:47:15.50,0:47:17.79,Default,,0,0,0,,Су жұмыс істемесе, от жағып көріңіз.
Dialogue: 0,0:47:17.87,0:47:19.04,Default,,0,0,0,,Хиноараши, өтінемін.
Dialogue: 0,0:47:23.21,0:47:24.30,Default,,0,0,0,,Хино
Dialogue: 0,0:47:24.71,0:47:27.38,Default,,0,0,0,,Хиноараши Каенхошада
Dialogue: 0,0:47:27.47,0:47:31.34,Default,,0,0,0,,Хинок
Dialogue: 0,0:47:32.01,0:47:34.81,Default,,0,0,0,,Хино хи хи...
Dialogue: 0,0:47:35.35,0:47:36.98,Default,,0,0,0,,Артқа қайт, Хиноараши
Dialogue: 0,0:47:39.81,0:47:40.90,Default,,0,0,0,,Пайдасы жоқ.
Dialogue: 0,0:47:40.98,0:47:44.07,Default,,0,0,0,,Бұл менің елес екенімді білдіре ме?
Dialogue: 0,0:47:44.48,0:47:48.11,Default,,0,0,0,,Сен сол баланың жүрегінен жаралған елессің.
Dialogue: 0,0:47:48.49,0:47:51.61,Default,,0,0,0,,Жоқ... жоқ
Dialogue: 0,0:47:52.82,0:47:53.83,Default,,0,0,0,,Уау, жылтыр
Dialogue: 0,0:48:00.16,0:48:02.54,Default,,0,0,0,,Мен иллюзиямын?
Dialogue: 0,0:48:02.96,0:48:06.55,Default,,0,0,0,,(Гүрілдеу)
Dialogue: 0,0:48:13.14,0:48:16.43,Default,,0,0,0,,Мен... мен...
Dialogue: 0,0:48:17.64,0:48:19.48,Default,,0,0,0,,Ол осы баланың әкесі.
Dialogue: 0,0:48:19.56,0:48:22.69,Default,,0,0,0,,Таңдау
Dialogue: 0,0:48:22.77,0:48:24.69,Default,,0,0,0,,Пикачу Уау
Dialogue: 0,0:48:26.32,0:48:30.40,Default,,0,0,0,,Пикапикачу
Dialogue: 0,0:48:31.61,0:48:33.07,Default,,0,0,0,,Пикачу
Dialogue: 0,0:48:34.74,0:48:36.58,Default,,0,0,0,,Шайнау
Dialogue: 0,0:48:46.46,0:48:48.63,Default,,0,0,0,,Ми-чан, есіңізде болсын
Dialogue: 0,0:48:48.71,0:48:51.17,Default,,0,0,0,,Ми Чанның нағыз әкесі мен анасы туралы
Dialogue: 0,0:48:51.88,0:48:53.43,Default,,0,0,0,,Е...
Dialogue: 0,0:48:53.51,0:48:54.55,Default,,0,0,0,,Ми-чан
Dialogue: 0,0:48:55.05,0:48:57.68,Default,,0,0,0,,Әй... Ақыры келдім. Апыр-ай.
Dialogue: 0,0:48:57.76,0:48:59.43,Default,,0,0,0,,Шайнау
Dialogue: 0,0:48:59.52,0:49:02.44,Default,,0,0,0,,Мұнда да? (Мияу) Баттленя
Dialogue: 0,0:49:02.52,0:49:04.77,Default,,0,0,0,,Ал дәл ортасында...
Dialogue: 0,0:49:04.85,0:49:06.23,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:49:17.91,0:49:19.45,Default,,0,0,0,,Пика~
Dialogue: 0,0:49:19.95,0:49:21.33,Default,,0,0,0,,Пикачу
Dialogue: 0,0:49:23.41,0:49:24.54,Default,,0,0,0,,Жылтыр
Dialogue: 0,0:49:26.38,0:49:27.38,Default,,0,0,0,,Ах!
Dialogue: 0,0:49:29.75,0:49:31.59,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:49:32.80,0:49:34.59,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:49:36.76,0:49:37.76,Default,,0,0,0,,Иә? Пика?
Dialogue: 0,0:49:39.64,0:49:41.47,Default,,0,0,0,,Чаризард Пикачу
Dialogue: 0,0:49:41.56,0:49:43.18,Default,,0,0,0,,Лиза~
Dialogue: 0,0:49:44.56,0:49:46.40,Default,,0,0,0,,Шаризард, ол келді.
Dialogue: 0,0:49:46.48,0:49:47.90,Default,,0,0,0,,Ризза
Dialogue: 0,0:49:47.98,0:49:49.07,Default,,0,0,0,,Рахмет
Dialogue: 0,0:49:49.15,0:49:50.36,Default,,0,0,0,,Пикачу
Dialogue: 0,0:49:56.36,0:49:57.99,Default,,0,0,0,,Сатоси
Dialogue: 0,0:49:59.08,0:50:00.54,Default,,0,0,0,,Жақсы болды ма?
Dialogue: 0,0:50:00.62,0:50:01.74,Default,,0,0,0,,Иә
Dialogue: 0,0:50:04.37,0:50:07.04,Default,,0,0,0,,Лиза~
Dialogue: 0,0:50:07.13,0:50:08.88,Default,,0,0,0,,Не? Сол
Dialogue: 0,0:50:08.96,0:50:10.42,Default,,0,0,0,,Ол менің досым.
Dialogue: 0,0:50:10.50,0:50:12.46,Default,,0,0,0,,Достар? Пика
Dialogue: 0,0:50:12.55,0:50:14.26,Default,,0,0,0,,Ризза
Dialogue: 0,0:50:14.88,0:50:16.55,Default,,0,0,0,,Менің барлық Покемондарым...
Dialogue: 0,0:50:16.63,0:50:18.72,Default,,0,0,0,,Бұл мен саяхаттап жүргенде танысқан достарым.
Dialogue: 0,0:50:19.14,0:50:20.76,Default,,0,0,0,,Ха... жолдас?
Dialogue: 0,0:50:20.85,0:50:23.14,Default,,0,0,0,,Қанша жиналсаң да солай.
Dialogue: 0,0:50:25.18,0:50:26.64,Default,,0,0,0,,Риза: Әй!
Dialogue: 0,0:50:27.40,0:50:28.40,Default,,0,0,0,,Уау
Dialogue: 0,0:50:28.73,0:50:33.61,Default,,0,0,0,,Уау, аа, а... а...
Dialogue: 0,0:50:33.69,0:50:35.24,Default,,0,0,0,,Біз де...
Dialogue: 0,0:50:35.32,0:50:36.95,Default,,0,0,0,,Біз доспыз, солай ма?
Dialogue: 0,0:50:37.03,0:50:39.28,Default,,0,0,0,,Касуми Такеши
Dialogue: 0,0:50:39.37,0:50:42.62,Default,,0,0,0,,Енді бірдеңе айтпас бұрын, айтайын...
Dialogue: 0,0:50:42.70,0:50:43.79,Default,,0,0,0,,Мусаши
Dialogue: 0,0:50:43.87,0:50:45.00,Default,,0,0,0,,Кодзиро
Dialogue: 0,0:50:45.08,0:50:46.83,Default,,0,0,0,,Миовта мияулау
Dialogue: 0,0:50:46.91,0:50:49.54,Default,,0,0,0,,Мен ракета командасының мүшесімін.
Dialogue: 0,0:50:49.63,0:50:51.04,Default,,0,0,0,,Зымыран командасы
Dialogue: 0,0:50:51.13,0:50:52.13,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:50:52.21,0:50:54.71,Default,,0,0,0,,Бұл өнер жабдықтары дүкендерінде сатылатын өмірден сурет салуға арналған манекендердің бірі ме?
Dialogue: 0,0:50:54.80,0:50:55.88,Default,,0,0,0,,Тек...
Dialogue: 0,0:50:55.97,0:50:57.05,Default,,0,0,0,,Мияу ма...
Dialogue: 0,0:50:57.13,0:50:58.76,Default,,0,0,0,,Менің қолым шығып кетті...
Dialogue: 0,0:50:58.84,0:51:02.01,Default,,0,0,0,,Жау болсақ та, бұрыннан таныспыз.
Dialogue: 0,0:51:04.22,0:51:07.94,Default,,0,0,0,,Лиза~
Dialogue: 0,0:51:11.27,0:51:13.98,Default,,0,0,0,,Жүр, Ми Чан, бізбен бірге жүр.
Dialogue: 0,0:51:15.99,0:51:19.78,Default,,0,0,0,,Менің досым келді, шығыңыз.
Dialogue: 0,0:51:21.37,0:51:22.49,Default,,0,0,0,,Жылтыр
Dialogue: 0,0:51:22.58,0:51:24.95,Default,,0,0,0,,Шаризард (Чаризард) Риза~
Dialogue: 0,0:51:26.95,0:51:28.50,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:51:28.58,0:51:32.71,Default,,0,0,0,,Сіз шынымен Ми Чанның әкесі бола аламын деп ойлайсыз ба?
Dialogue: 0,0:51:33.09,0:51:37.42,Default,,0,0,0,,Мен қалағанша менің әкесімін.
Dialogue: 0,0:51:49.48,0:51:50.73,Default,,0,0,0,,Ах!
Dialogue: 0,0:51:50.81,0:51:52.48,Default,,0,0,0,,Мен H...
Dialogue: 0,0:52:00.86,0:52:03.32,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:52:09.00,0:52:11.33,Default,,0,0,0,,Чаризард Каенхушада
Dialogue: 0,0:52:18.09,0:52:20.17,Default,,0,0,0,,Шаризард тағы бір ату
Dialogue: 0,0:52:21.93,0:52:23.76,Default,,0,0,0,,Ah Ah Ah
Dialogue: 0,0:52:26.76,0:52:27.77,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:52:39.11,0:52:40.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:53:12.60,0:53:14.94,Default,,0,0,0,,Шаризард Өрт Узуда
Dialogue: 0,0:53:21.49,0:53:23.61,Default,,0,0,0,,Әлде бұл өкпеден бе? Карс
Dialogue: 0,0:53:29.66,0:53:32.04,Default,,0,0,0,,Энтей, өтінемін, мені тыңда.
Dialogue: 0,0:53:32.66,0:53:35.12,Default,,0,0,0,,Егер сіз Ми Чанды шынымен де ойласаңыз—
Dialogue: 0,0:53:35.21,0:53:37.21,Default,,0,0,0,,Мені тыңда
Dialogue: 0,0:53:40.50,0:53:42.38,Default,,0,0,0,,Лиза~
Dialogue: 0,0:53:46.09,0:53:49.01,Default,,0,0,0,,Сенің мына қызбен жүргенің дұрыс емес.
Dialogue: 0,0:53:49.10,0:53:50.72,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:53:52.14,0:53:57.06,Default,,0,0,0,,Қате болса да, Менің тілегімді орындағым келеді.
Dialogue: 0,0:54:00.32,0:54:02.49,Default,,0,0,0,,Шаризард (Чаризард) Риза~
Dialogue: 0,0:54:13.20,0:54:14.71,Default,,0,0,0,,Уау
Dialogue: 0,0:54:20.25,0:54:23.84,Default,,0,0,0,,Осылай жалғаса берсе, Мен әрқашан жалғыз қаламын.
Dialogue: 0,0:54:30.22,0:54:34.89,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:54:53.41,0:54:54.66,Default,,0,0,0,,Уф
Dialogue: 0,0:54:55.00,0:54:56.04,Default,,0,0,0,,Уау
Dialogue: 0,0:54:57.29,0:54:58.37,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:55:06.88,0:55:08.22,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:55:11.76,0:55:12.97,Default,,0,0,0,,Шаризард
Dialogue: 0,0:55:13.76,0:55:15.39,Default,,0,0,0,,айтқан жоқпын ба?
Dialogue: 0,0:55:15.47,0:55:16.64,Default,,0,0,0,,Тоқта
Dialogue: 0,0:55:28.36,0:55:33.87,Default,,0,0,0,,Әке, тоқтаңыз, болды... болды.
Dialogue: 0,0:55:46.55,0:55:48.88,Default,,0,0,0,,Ми-чан, мен сенен жеңілдім.
Dialogue: 0,0:55:48.97,0:55:49.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:55:50.34,0:55:53.39,Default,,0,0,0,,Домалаған күнжіт пілі қатты болды.
Dialogue: 0,0:55:53.47,0:55:55.68,Default,,0,0,0,,Мантиннің құйындысы
Dialogue: 0,0:55:55.77,0:55:59.39,Default,,0,0,0,,Егер сіз менің орнымда болсаңыз, спорт залының жетекшісі бола алатыныңызға сенімдімін.
Dialogue: 0,0:55:59.48,0:56:03.86,Default,,0,0,0,,Шайқас аяқталғаннан кейін сол Покемонды жақсы көретіндер...
Dialogue: 0,0:56:03.94,0:56:05.57,Default,,0,0,0,,Біз доспыз
Dialogue: 0,0:56:05.65,0:56:07.23,Default,,0,0,0,,Лиза~
Dialogue: 0,0:56:07.32,0:56:08.94,Default,,0,0,0,,Пика Пика
Dialogue: 0,0:56:09.82,0:56:10.99,Default,,0,0,0,,Е...
Dialogue: 0,0:56:11.32,0:56:12.49,Default,,0,0,0,,Сыртқа шығайық.
Dialogue: 0,0:56:13.07,0:56:15.16,Default,,0,0,0,,Сыртқа шығып төбелесіп қалсақ...
Dialogue: 0,0:56:15.24,0:56:16.95,Default,,0,0,0,,Сондай-ақ достасуға болады
Dialogue: 0,0:56:17.83,0:56:18.91,Default,,0,0,0,,Көп.
Dialogue: 0,0:56:25.80,0:56:28.55,Default,,0,0,0,,Кеттік, Ми Чан
Dialogue: 0,0:56:56.45,0:56:58.37,Default,,0,0,0,,Сен бақыттысың, Гриша…
Dialogue: 0,0:57:19.14,0:57:21.10,Default,,0,0,0,,А... Әке.
Dialogue: 0,0:57:21.52,0:57:26.52,Default,,0,0,0,,Мен сені бақытты ететін әке болып тудым.
Dialogue: 0,0:57:27.11,0:57:32.90,Default,,0,0,0,,Сенің бақытың сыртқы әлемде болса, мен...
Dialogue: 0,0:57:39.03,0:57:40.41,Default,,0,0,0,,Дыбыстық сигнал? (Чаризард) Риза?
Dialogue: 0,0:57:40.49,0:57:41.50,Default,,0,0,0,,Жылтыр
Dialogue: 0,0:57:41.83,0:57:43.37,Default,,0,0,0,,Не? (Мияу) Не, Мияу?
Dialogue: 0,0:57:43.46,0:57:44.54,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:57:44.62,0:57:46.17,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:57:46.58,0:57:50.13,Default,,0,0,0,,(Энтейдің ырылдауы)
Dialogue: 0,0:57:50.67,0:57:52.38,Default,,0,0,0,,Лизапика
Dialogue: 0,0:57:55.68,0:57:56.93,Default,,0,0,0,,Уау
Dialogue: 0,0:58:01.02,0:58:02.93,Default,,0,0,0,,(Тодороки) Алда не күтіп тұрғанын біртүрлі ұмытып кетіппін
Dialogue: 0,0:58:06.98,0:58:08.19,Default,,0,0,0,,«бір жылдық төтенше көмек заттарын қамтамасыз етеді»
Dialogue: 0,0:58:08.77,0:58:10.98,Default,,0,0,0,,Дыбыстық сигнал сигналы
Dialogue: 0,0:58:12.65,0:58:14.70,Default,,0,0,0,,Мені Чаризард сұраңыз
Dialogue: 0,0:58:14.78,0:58:16.16,Default,,0,0,0,,Лиза
Dialogue: 0,0:58:17.11,0:58:19.41,Default,,0,0,0,,Мықтап ұстаңыз.
Dialogue: 0,0:58:19.49,0:58:20.95,Default,,0,0,0,,Барлығы асығыңыздар
Dialogue: 0,0:58:26.42,0:58:27.42,Default,,0,0,0,,(үру)
Dialogue: 0,0:58:35.05,0:58:37.05,Default,,0,0,0,,Дәрігер, не болып жатыр?
Dialogue: 0,0:58:37.13,0:58:40.51,Default,,0,0,0,,Бірде иесіз өз күшін ашты...
Dialogue: 0,0:58:40.60,0:58:42.77,Default,,0,0,0,,Мен өзімді тоқтата алмаймын.
Dialogue: 0,0:58:42.85,0:58:45.18,Default,,0,0,0,,Кристалдану бізге қарай келе жатыр.
Dialogue: 0,0:58:45.27,0:58:48.15,Default,,0,0,0,,Сатоши, өтінемін, Unown-ның шабуылын тоқтатыңыз.
Dialogue: 0,0:58:48.23,0:58:49.23,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:58:57.95,0:59:00.07,Default,,0,0,0,,(Сатоши мен оның достарының ауыр тыныс алуы)
Dialogue: 0,0:59:00.41,0:59:02.33,Default,,0,0,0,,Ой... (Мяу) Мияу...
Dialogue: 0,0:59:07.33,0:59:10.00,Default,,0,0,0,,Кристалдану құбылысы кеңінен таралуда
Dialogue: 0,0:59:10.08,0:59:14.34,Default,,0,0,0,,Соңында, Покемон орталығын да кристалдар жұтып жатыр.
Dialogue: 0,0:59:14.42,0:59:15.63,Default,,0,0,0,,Қаш
Dialogue: 0,0:59:15.71,0:59:17.30,Default,,0,0,0,,Иә (Джунсер) Тезірек.
Dialogue: 0,0:59:31.86,0:59:33.48,Default,,0,0,0,,Бұл ие емес...
Dialogue: 0,0:59:33.57,0:59:35.23,Default,,0,0,0,,Оны қалай тоқтатуға болады?
Dialogue: 0,0:59:35.32,0:59:37.78,Default,,0,0,0,,Әлде бұл өкпеден бе? Карс
Dialogue: 0,0:59:37.86,0:59:40.28,Default,,0,0,0,,Уау, аа...
Dialogue: 0,0:59:40.36,0:59:41.57,Default,,0,0,0,,...
Dialogue: 0,0:59:41.66,0:59:43.95,Default,,0,0,0,,Тосқауылмен қорғалған
Dialogue: 0,0:59:44.03,0:59:45.54,Default,,0,0,0,,Чаризард, өтінемін.
Dialogue: 0,0:59:45.62,0:59:48.00,Default,,0,0,0,,Риза~ Риза
Dialogue: 0,0:59:50.83,0:59:52.38,Default,,0,0,0,,Ризза
Dialogue: 0,0:59:56.13,0:59:58.26,Default,,0,0,0,,Иә Пика
Dialogue: 0,1:00:08.81,1:00:10.19,Default,,0,0,0,,Жылтыр
Dialogue: 0,1:00:10.27,1:00:13.36,Default,,0,0,0,,Пикачу, өтінемін, 10 адам болт.
Dialogue: 0,1:00:14.57,1:00:19.03,Default,,0,0,0,,Пикачу!
Dialogue: 0,1:00:23.82,1:00:26.54,Default,,0,0,0,,Шайнаңыз!
Dialogue: 0,1:00:26.62,1:00:29.25,Default,,0,0,0,,Шайнаңыз! (Чаризард) Бум!
Dialogue: 0,1:00:45.35,1:00:46.68,Default,,0,0,0,,Пикачу, жақсысың ба?
Dialogue: 0,1:00:46.76,1:00:47.77,Default,,0,0,0,,Пика…
Dialogue: 0,1:00:51.14,1:00:52.52,Default,,0,0,0,,Ах, Пика...
Dialogue: 0,1:00:58.19,1:00:59.94,Default,,0,0,0,,Уау (Чаризард) Дон
Dialogue: 0,1:01:09.20,1:01:11.87,Default,,0,0,0,,Бұл қауіпті емес пе? Бұл...
Dialogue: 0,1:01:11.96,1:01:14.88,Default,,0,0,0,,Ешқандай қазына жоқ сияқты, мен үйге тез қайтайын.
Dialogue: 0,1:01:14.96,1:01:16.79,Default,,0,0,0,,Бұл тек қателік шегі ғой, иә?
Dialogue: 0,1:01:16.88,1:01:18.30,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,1:01:18.38,1:01:21.55,Default,,0,0,0,,Эххххххх... Уау
Dialogue: 0,1:01:22.26,1:01:23.68,Default,,0,0,0,,Тосенбоня
Dialogue: 0,1:01:23.76,1:01:26.93,Default,,0,0,0,,Біреу бірдеңе жасайды~
Dialogue: 0,1:01:30.52,1:01:34.06,Default,,0,0,0,,Қолданбаңыз, тоқтатыңыз. Ах... ой...
Dialogue: 0,1:01:34.48,1:01:36.61,Default,,0,0,0,,(Менің қорқынышты дауысым)
Dialogue: 0,1:01:36.69,1:01:38.86,Default,,0,0,0,,(Энтей's Roar)
Dialogue: 0,1:01:39.40,1:01:40.61,Default,,0,0,0,,Ах...
Dialogue: 0,1:01:49.24,1:01:53.00,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,1:02:09.26,1:02:10.81,Default,,0,0,0,,Мен (мен) а
Dialogue: 0,1:02:11.52,1:02:16.02,Default,,0,0,0,,Мен сенің әкең болғаныма қуандым.
Dialogue: 0,1:02:16.94,1:02:19.31,Default,,0,0,0,,Соңында, мен істей алатын нәрсе -
Dialogue: 0,1:02:19.77,1:02:22.69,Default,,0,0,0,,Сізді бұл жерден шығару үшін.
Dialogue: 0,1:02:23.28,1:02:24.49,Default,,0,0,0,,Увааах! Оох…
Dialogue: 0,1:02:24.57,1:02:28.03,Default,,0,0,0,,Мен сенің арманыңнан тудым
Dialogue: 0,1:02:28.12,1:02:32.70,Default,,0,0,0,,Сенсең, менің қолымнан бәрі келеді.
Dialogue: 0,1:02:32.79,1:02:34.37,Default,,0,0,0,,(үру)
Dialogue: 0,1:02:46.47,1:02:49.22,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,1:02:50.18,1:02:53.14,Default,,0,0,0,,Уа, ау, ау...
Dialogue: 0,1:02:53.22,1:02:58.81,Default,,0,0,0,,Әке Ух... Ми... Мен
Dialogue: 0,1:03:00.19,1:03:03.98,Default,,0,0,0,,Қарғыс атсын... Мен Энтейге сенемін.
Dialogue: 0,1:03:04.07,1:03:05.94,Default,,0,0,0,,Сіздің Энтей жеңілмейді
Dialogue: 0,1:03:17.25,1:03:19.83,Default,,0,0,0,,Сәттілік әке
Dialogue: 0,1:03:20.25,1:03:21.38,Default,,0,0,0,,Мен
Dialogue: 0,1:03:45.69,1:03:47.32,Default,,0,0,0,,Мен!
Dialogue: 0,1:04:18.31,1:04:21.81,Default,,0,0,0,,Мен мен
Dialogue: 0,1:04:21.90,1:04:23.48,Default,,0,0,0,,Уф…
Dialogue: 0,1:04:30.86,1:04:31.86,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,1:04:32.49,1:04:35.24,Default,,0,0,0,,Мені әке деп атағаныңызға рахмет
Dialogue: 0,1:04:37.12,1:04:40.71,Default,,0,0,0,,Мен сенің арманыңа қайтамын
Dialogue: 0,1:04:56.81,1:04:58.31,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,1:05:23.87,1:05:26.21,Default,,0,0,0,,Уау...
Dialogue: 0,1:05:27.13,1:05:33.01,Default,,0,0,0,,(Иесі жоқтардың айқайы)
Dialogue: 0,1:05:38.10,1:05:39.72,Default,,0,0,0,,Уау...
Dialogue: 0,1:06:07.38,1:06:13.17,Default,,0,0,0,,(Құстардың сайрауы)
Dialogue: 0,1:06:23.18,1:06:25.14,Default,,0,0,0,,Тогепи~
Dialogue: 0,1:06:34.07,1:06:35.95,Default,,0,0,0,,Бұл нақты нәрсе...
Dialogue: 0,1:06:36.03,1:06:37.82,Default,,0,0,0,,Гринфилд
Dialogue: 0,1:06:37.91,1:06:39.37,Default,,0,0,0,,Бұл әдемі
Dialogue: 0,1:06:39.45,1:06:40.78,Default,,0,0,0,,Жылтыр~
Dialogue: 0,1:06:40.87,1:06:41.87,Default,,0,0,0,,Чоки Чоки
Dialogue: 0,1:06:41.95,1:06:43.41,Default,,0,0,0,,Иә?
Dialogue: 0,1:06:47.04,1:06:49.71,Default,,0,0,0,,Әй, бәрің, жақсысыңдар ма?
Dialogue: 0,1:06:49.79,1:06:53.00,Default,,0,0,0,,Дәрігер Оук Рин-сан
Dialogue: 0,1:06:53.09,1:06:56.72,Default,,0,0,0,,Сәлем, мұнда.
Dialogue: 0,1:06:59.01,1:07:00.01,Default,,0,0,0,,Ах
Dialogue: 0,1:07:06.44,1:07:08.06,Default,,0,0,0,,Рахмет
Dialogue: 0,1:07:12.02,1:07:13.36,Default,,0,0,0,,Пикачу~
Dialogue: 0,1:07:13.44,1:07:15.94,Default,,0,0,0,,Сенімен танысайық, Ми Чан.
Dialogue: 0,1:07:16.03,1:07:17.99,Default,,0,0,0,,Барлығы уайымдады.
Dialogue: 0,1:07:18.07,1:07:19.07,Default,,0,0,0,,Келіңіздер
Dialogue: 0,1:07:19.16,1:07:21.28,Default,,0,0,0,,Иә, Пика
Dialogue: 0,1:07:24.66,1:07:25.75,Default,,0,0,0,,Ми-чан
Dialogue: 0,1:07:27.62,1:07:29.29,Default,,0,0,0,,Ол келді.
Dialogue: 0,1:07:33.09,1:07:35.67,Default,,0,0,0,,-де? Енді не істейсіз?
Dialogue: 0,1:07:36.09,1:07:38.51,Default,,0,0,0,,Төменгі қабатта полиция көп...
Dialogue: 0,1:07:38.59,1:07:40.47,Default,,0,0,0,,Мен төмен түссем де түсе алмаймын...
Dialogue: 0,1:07:40.55,1:07:43.26,Default,,0,0,0,,Сонанс
Dialogue: 0,1:07:44.14,1:07:45.89,Default,,0,0,0,,Хаа…
Dialogue: 0,1:07:49.35,1:07:51.52,Default,,0,0,0,,Хаха, бәрібір...
Dialogue: 0,1:07:51.61,1:07:54.82,Default,,0,0,0,,Бір кем жалғыз қыз, ня
Dialogue: 0,1:07:54.90,1:07:56.86,Default,,0,0,0,,Бірақ мұнда басқа адам бар.
Dialogue: 0,1:07:56.94,1:08:00.82,Default,,0,0,0,,Жалғыз қыз... Мусаши
Dialogue: 0,1:08:01.16,1:08:04.87,Default,,0,0,0,,Жалғыз тұрған жас жігіт... Кодзиро
Dialogue: 0,1:08:04.95,1:08:08.75,Default,,0,0,0,,Ай әрқашан жалғыз болады
Dialogue: 0,1:08:09.04,1:08:12.33,Default,,0,0,0,,Қараңдаршы, жел жасыл алқапта қозғалады.
Dialogue: 0,1:08:12.42,1:08:14.75,Default,,0,0,0,,Жалғыз болсам да, Досыңмын.
Dialogue: 0,1:08:14.84,1:08:17.05,Default,,0,0,0,,Әйтеуір, бұл өте...
Dialogue: 0,1:08:17.13,1:08:23.14,Default,,0,0,0,,Жақсы көрінеді~
Dialogue: 0,1:08:41.20,1:08:47.49,Default,,0,0,0,,(Иесі жоқтардың айқайы)
Dialogue: 0,1:08:51.08,1:08:57.09,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,1:13:27.02,1:13:33.03,Default,,0,0,0,,~♪
