Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:09.09,0:01:10.17,Default,,0,0,0,,Оған нүкте қойыңыз.
Dialogue: 0,0:01:10.53,0:01:12.88,Default,,0,0,0,,Оны түтінін шығарып, осында әкел.
Dialogue: 0,0:01:13.01,0:01:14.30,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:01:14.52,0:01:15.80,Default,,0,0,0,,Бұл қауіпсіз.
Dialogue: 0,0:01:16.02,0:01:16.79,Default,,0,0,0,,Қазір тек екеуміз ғана қалдық.
Dialogue: 0,0:01:17.01,0:01:19.97,Default,,0,0,0,,Әйелің мен қызың да мініп жүр.
Dialogue: 0,0:01:20.14,0:01:21.35,Default,,0,0,0,,Теміржол трассасы дегеніміз не?
Dialogue: 0,0:01:21.89,0:01:24.33,Default,,0,0,0,,Халық... жоғалады.
Dialogue: 0,0:01:24.33,0:01:28.19,Default,,0,0,0,,Пойыз алғашында болмаған сияқты.
Dialogue: 0,0:02:02.20,0:02:04.46,Default,,0,0,0,,Жарайды, жарайды!
Dialogue: 0,0:02:02.23,0:02:04.56,Default-ja,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:02:08.28,0:02:13.94,Default-ja,,0,0,0,,Жас келіншек... Теңіз самалына көп ұшырасаңыз, денсаулығыңызға зиян тигізеді.
Dialogue: 0,0:02:08.34,0:02:13.50,Default,,0,0,0,,Ханым, тұзды желде ұзақ тұру денсаулыққа пайдалы емес.
Dialogue: 0,0:02:14.16,0:02:18.07,Default-ja,,0,0,0,,Кешіріңіз, Бенджамин мырза... бірақ...
Dialogue: 0,0:02:14.25,0:02:16.59,Default,,0,0,0,,Кешіріңіз, Бенджамин мырза.
Dialogue: 0,0:02:17.39,0:02:18.07,Default,,0,0,0,,Қазір тек екеуміз ғана қалдық.
Dialogue: 0,0:02:19.25,0:02:24.08,Default-ja,,0,0,0,,Мен осында тағы біраз күткім келеді.
Dialogue: 0,0:02:19.27,0:02:20.32,Default,,0,0,0,,Аз ғана...
Dialogue: 0,0:02:21.07,0:02:24.08,Default,,0,0,0,,Мен осында тағы біраз күткім келеді.
Dialogue: 0,0:02:24.64,0:02:25.86,Default,,0,0,0,,Ханым...
Dialogue: 0,0:02:24.75,0:02:26.24,Default-ja,,0,0,0,,Ханым…
Dialogue: 0,0:02:34.05,0:02:35.79,Default-ja,,0,0,0,,Нойф) Даллас-нии-сан...
Dialogue: 0,0:02:34.10,0:02:35.55,Default,,0,0,0,,Даллас-ниисан...
Dialogue: 0,0:02:58.79,0:03:00.24,Default,,0,0,0,,Капипа
Dialogue: 0,0:02:58.83,0:03:00.24,Default-ja,,0,0,0,,Қош келдіңіз!
Dialogue: 0,0:03:01.23,0:03:03.55,Default,,0,0,0,,Мен ағылшын тілінде жұмыс істеймін.
Dialogue: 0,0:03:01.29,0:03:05.37,Default-ja,,0,0,0,,Менің атым Николас, мен ағылшын тілінде жұмыс істеймін.
Dialogue: 0,0:03:03.55,0:03:05.55,Default,,0,0,0,,Менің атым Николай.
Dialogue: 0,0:03:05.55,0:03:06.90,Default,,0,0,0,,Ал, жақсы!
Dialogue: 0,0:03:05.59,0:03:09.17,Default-ja,,0,0,0,,Мынау.
Dialogue: 0,0:03:07.22,0:03:11.46,Default,,0,0,0,,Сіз мырзалар, Рунората отбасының Густавосының қол астында болуыңыз керек, иә?
Dialogue: 0,0:03:09.30,0:03:11.46,Default-ja,,0,0,0,,Гус Юичи Вуо мырзаның қарамағындағылар.
Dialogue: 0,0:03:13.47,0:03:14.63,Default-ja,,0,0,0,,Сіз қайдан білдіңіз?
Dialogue: 0,0:03:13.50,0:03:14.63,Default,,0,0,0,,Сіз қайдан білдіңіз?
Dialogue: 0,0:03:14.97,0:03:19.09,Default-ja,,0,0,0,,Себебі мен Daily Days қызметкерімін.
Dialogue: 0,0:03:14.98,0:03:19.26,Default,,0,0,0,,Себебі мен Күнделікті күндердің қызметкерімін.
Dialogue: 0,0:03:19.26,0:03:21.38,Default,,0,0,0,,Біздікі сияқты ақпараттық дүкен үшін,
Dialogue: 0,0:03:19.31,0:03:23.89,Default-ja,,0,0,0,,Ақпарат беруші ретінде біз білмейтін ештеңе жоқ.
Dialogue: 0,0:03:21.38,0:03:23.89,Default,,0,0,0,,біз білмейтін ештеңе жоқ.
Dialogue: 0,0:03:24.19,0:03:26.02,Default-ja,,0,0,0,,Олай болса, әңгіме тез.
Dialogue: 0,0:03:24.22,0:03:26.34,Default,,0,0,0,,Содан кейін біз қуып жетуге болады.
Dialogue: 0,0:03:26.27,0:03:28.98,Default-ja,,0,0,0,,Сіз Дарасзи Инженер Ноа есімді баланы білесіз бе?
Dialogue: 0,0:03:26.34,0:03:28.97,Default,,0,0,0,,Сіз Даллас Генуард деген баланы білесіз бе?
Dialogue: 0,0:03:29.13,0:03:33.81,Default,,0,0,0,,Иә! Әйгілі Генуардтар отбасының екінші ұлы Даллас Геноард...
Dialogue: 0,0:03:29.15,0:03:34.02,Default-ja,,0,0,0,,Иә, Даллас инженері Нұх - беделді инженер Нұхтың отбасының екінші ұлы.
Dialogue: 0,0:03:34.20,0:03:37.56,Default-ja,,0,0,0,,Қазіргі уақытта із-түссіз жоғалған тегі бар кәмелетке толмаған қылмыскер...
Dialogue: 0,0:03:34.30,0:03:37.61,Default,,0,0,0,,атышулы кәмелетке толмаған қылмыскер, қазіргі уақытта қайда екені белгісіз.
Dialogue: 0,0:03:37.90,0:03:39.86,Default,,0,0,0,,Оның қайда екенін айт!
Dialogue: 0,0:03:37.91,0:03:41.24,Default-ja,,0,0,0,,Қамал болса да, арқан болса да, қайда бара жатқаныңды айт.
Dialogue: 0,0:03:39.86,0:03:41.44,Default,,0,0,0,,Тіпті ең ұсақ-түйек нәрсе де жасайды.
Dialogue: 0,0:03:41.41,0:03:42.74,Default-ja,,0,0,0,,500 доллар
Dialogue: 0,0:03:41.44,0:03:42.52,Default,,0,0,0,,500 доллар.
Dialogue: 0,0:03:43.04,0:03:44.03,Default-ja,,0,0,0,,Біз Әйел Титан сияқты көрінетін біреуді байқадық.
Dialogue: 0,0:03:43.27,0:03:44.03,Default,,0,0,0,,Жер
Dialogue: 0,0:03:44.36,0:03:47.24,Default,,0,0,0,,Бұл ақпарат қолма-қол ақшамен 500 доллар тұрады.
Dialogue: 0,0:03:44.37,0:03:47.08,Default-ja,,0,0,0,,Бұл ақпарат қолма-қол 5 KRW үшін қол жетімді.
Dialogue: 0,0:03:47.26,0:03:51.06,Default,,0,0,0,,Оның үстіне мен сізден біраз ақпарат алғым келеді.
Dialogue: 0,0:03:47.29,0:03:50.88,Default-ja,,0,0,0,,Сізден алмасу үшін қосымша ақпарат.
Dialogue: 0,0:03:51.05,0:03:52.25,Default-ja,,0,0,0,,Ақпарат?
Dialogue: 0,0:03:51.06,0:03:52.29,Default,,0,0,0,,Ақпарат, айтасыз ба?
Dialogue: 0,0:03:52.42,0:03:56.95,Default,,0,0,0,,Неліктен Рунората отбасы Даллас Геноардты қуып келеді.
Dialogue: 0,0:03:52.47,0:03:56.80,Default-ja,,0,0,0,,Неліктен Нора Казуяның отбасы Даллас Джордж пен Ноа Айдоны қуып келеді?
Dialogue: 0,0:03:56.95,0:03:58.88,Default,,0,0,0,,Себебін айтайын деп едім.
Dialogue: 0,0:03:56.97,0:03:58.88,Default-ja,,0,0,0,,Маған соны айтқаныңызды қалаймын.
Dialogue: 0,0:03:59.18,0:04:00.92,Default-ja,,0,0,0,,Маған не істеу керектігін айтыңыз
Dialogue: 0,0:03:59.20,0:04:01.22,Default,,0,0,0,,Ал сіз бұл ақпаратпен не істейсіз?
Dialogue: 0,0:04:01.22,0:04:04.81,Default-ja,,0,0,0,,Ақпарат берушіде ақпарат болмаса не болады?
Dialogue: 0,0:04:01.23,0:04:04.66,Default,,0,0,0,,Ақпаратсыз ақпарат дүкені дегеніміз не?
Dialogue: 0,0:04:04.98,0:04:10.02,Default-ja,,0,0,0,,Егер біз бұл ақпаратты берсек және біреу бұл ақпаратты сатып алуға келсе...
Dialogue: 0,0:04:05.00,0:04:10.02,Default,,0,0,0,,Біз сізге айтамыз делік, ал біреу бұл ақпаратты сатып алуға келеді...
Dialogue: 0,0:04:10.22,0:04:12.50,Default,,0,0,0,,Әрине, біз оны оларға сататын едік!
Dialogue: 0,0:04:10.23,0:04:14.23,Default-ja,,0,0,0,,Әрине сатамын! Бұл бизнес!
Dialogue: 0,0:04:12.50,0:04:14.23,Default,,0,0,0,,Бұл біздің шаруамыз ғой.
Dialogue: 0,0:04:15.06,0:04:18.32,Default,,0,0,0,,Сіз! Егер сіз жай ғана үнсіз тыңдаған болсаңыз, сіз...
Dialogue: 0,0:04:15.07,0:04:18.06,Default-ja,,0,0,0,,Тыңдап, үндемесең, өзімшілдік жасайсың!
Dialogue: 0,0:04:24.63,0:04:25.63,Default,,0,0,0,,Кешірім сұраймын.
Dialogue: 0,0:04:24.66,0:04:25.70,Default-ja,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,0:04:25.87,0:04:29.37,Default-ja,,0,0,0,,Ісімнің кесірінен мен көп қиындық тудырдым.
Dialogue: 0,0:04:25.90,0:04:29.17,Default,,0,0,0,,Бұл бизнес өте қауіпті, сондықтан...
Dialogue: 0,0:04:29.70,0:04:33.83,Default,,0,0,0,,Ал енді Даллас Генуарды не үшін іздеп жүрсіз?
Dialogue: 0,0:04:29.84,0:04:33.88,Default-ja,,0,0,0,,Енді... Дарасзи инженер Нұхты іздеудегі мақсат не?
Dialogue: 0,0:04:43.82,0:04:44.85,Default,,0,0,0,,Ей, ақымақ!
Dialogue: 0,0:04:43.89,0:04:45.10,Default-ja,,0,0,0,,Сәлем!
Dialogue: 0,0:04:45.26,0:04:47.68,Default,,0,0,0,,Сізде проблема бар ма, брат?
Dialogue: 0,0:04:45.27,0:04:47.73,Default-ja,,0,0,0,,Сен шағымданып тұрсың ба, бала?
Dialogue: 0,0:04:47.89,0:04:52.39,Default,,0,0,0,,Мұны аласыз ба? Мен Рунората отбасының мүшесімін.
Dialogue: 0,0:04:47.94,0:04:52.40,Default-ja,,0,0,0,,Тыңда, мен Кочитора Рунора Казуя мен Фа Санриичиге қарыздармын.
Dialogue: 0,0:04:52.76,0:04:56.02,Default,,0,0,0,,Мен гангстер панктары қалаған адам емеспін...
Dialogue: 0,0:04:52.82,0:04:55.98,Default-ja,,0,0,0,,Мен саған қараймын, ал менің шымилла келбетім мені қорғайды...
Dialogue: 0,0:04:56.15,0:04:57.14,Default-ja,,0,0,0,,Дохатсу
Dialogue: 0,0:04:57.66,0:04:58.65,Default-ja,,0,0,0,,Гухатсу!
Dialogue: 0,0:04:58.94,0:05:00.62,Default,,0,0,0,,Рунорат, айтасыз ба?
Dialogue: 0,0:04:58.95,0:05:00.44,Default-ja,,0,0,0,,Бұл Нора Казуя ма?
Dialogue: 0,0:05:00.58,0:05:02.86,Default-ja,,0,0,0,,Неге сонша мақтанышпен сөйлейсің?
Dialogue: 0,0:05:00.62,0:05:03.03,Default,,0,0,0,,Немен мақтанасың?!
Dialogue: 0,0:05:03.03,0:05:05.74,Default,,0,0,0,,Сіз біздің қызметшілер сияқтысыз!
Dialogue: 0,0:05:03.04,0:05:05.70,Default-ja,,0,0,0,,Менің қызметшіме қалай қарайсың!
Dialogue: 0,0:05:05.98,0:05:09.18,Default,,0,0,0,,Қарт ағамды сорып жатыр,
Dialogue: 0,0:05:06.00,0:05:09.03,Default-ja,,0,0,0,,Әкең мен ағаңның қолына кіріп, билікке ие бол!
Dialogue: 0,0:05:09.18,0:05:11.69,Default,,0,0,0,,ал енді мені қанап жатырсың ба?!
Dialogue: 0,0:05:09.21,0:05:11.54,Default-ja,,0,0,0,,Олар бізді аңдып жатыр!
Dialogue: 0,0:05:11.69,0:05:15.33,Default,,0,0,0,,Балалар, сендердің тамақ жеулеріңнің себебі біз үшін!
Dialogue: 0,0:05:11.71,0:05:15.00,Default-ja,,0,0,0,,Сіздің аман қалуыңыздың арқасы болар!
Dialogue: 0,0:05:19.67,0:05:21.00,Default,,0,0,0,,Оны қазірдің өзінде тоқтатыңыз.
Dialogue: 0,0:05:19.72,0:05:21.00,Default-ja,,0,0,0,,Жалғастырыңыз
Dialogue: 0,0:05:21.51,0:05:23.25,Default-ja,,0,0,0,,Сен өлесің.
Dialogue: 0,0:05:21.54,0:05:22.83,Default,,0,0,0,,Ол өледі.
Dialogue: 0,0:05:23.47,0:05:24.76,Default-ja,,0,0,0,,Не деген сұмдық!
Dialogue: 0,0:05:23.66,0:05:24.76,Default,,0,0,0,,М-мен бұған енді маңызды емес дедім!
Dialogue: 0,0:05:25.27,0:05:26.25,Default,,0,0,0,,Кетіңіз!
Dialogue: 0,0:05:25.27,0:05:29.35,Default-ja,,0,0,0,,Бар, бұл біздің Гандур аралы.
Dialogue: 0,0:05:26.59,0:05:29.52,Default,,0,0,0,,Бұл біздің, Гандордың, шымтезек!
Dialogue: 0,0:05:29.52,0:05:33.01,Default-ja,,0,0,0,,Нора Казуяның атын көп таратпаған дұрыс.
Dialogue: 0,0:05:29.52,0:05:33.02,Default,,0,0,0,,Мен бұл жерде Рунората атауын көрмегенім жөн.
Dialogue: 0,0:05:36.40,0:05:37.39,Default-ja,,0,0,0,,Хатсу!
Dialogue: 0,0:05:37.51,0:05:39.92,Default,,0,0,0,,Гандор немесе сіз қандай боласыз, мен білмеймін, бірақ...
Dialogue: 0,0:05:37.53,0:05:41.65,Default-ja,,0,0,0,,Гандору ма, әлде не екенін білмеймін, бірақ ол қажетсіз нәрселермен айналысады және тым көп күшке ие!
Dialogue: 0,0:05:39.92,0:05:41.86,Default,,0,0,0,,Басқа адамдардың ісімен айналысу...
Dialogue: 0,0:05:41.78,0:05:42.77,Default-ja,,0,0,0,,Кеттік!
Dialogue: 0,0:05:41.86,0:05:42.49,Default,,0,0,0,,Вент одан әрі ашылмауына қол жеткіздік.
Dialogue: 0,0:05:47.87,0:05:49.99,Default-ja,,0,0,0,,Олар кімдер?
Dialogue: 0,0:05:47.93,0:05:50.02,Default,,0,0,0,,Олар кімдер?
Dialogue: 0,0:05:50.21,0:05:51.79,Default-ja,,0,0,0,,Бейтаныс
Dialogue: 0,0:05:50.25,0:05:51.74,Default,,0,0,0,,Оларды білмеймін.
Dialogue: 0,0:05:56.31,0:05:58.04,Default,,0,0,0,,Олай болса, жарайды, онда жақсы!
Dialogue: 0,0:05:56.38,0:05:58.04,Default-ja,,0,0,0,,Ал, енді
Dialogue: 0,0:05:58.47,0:06:01.96,Default-ja,,0,0,0,,Біздің шоудың уақыты жақындап қалды!
Dialogue: 0,0:05:58.54,0:06:00.13,Default,,0,0,0,,Бұл басталғалы жатыр!
Dialogue: 0,0:06:00.13,0:06:02.00,Default,,0,0,0,,Біздің шоу, яғни!
Dialogue: 0,0:06:02.00,0:06:03.70,Default,,0,0,0,,Олар аяқталуға жақын, ә...
Dialogue: 0,0:06:02.18,0:06:05.55,Default-ja,,0,0,0,,Олардың өмірі аяқталуға жақын!
Dialogue: 0,0:06:03.70,0:06:05.55,Default,,0,0,0,,Олардың өмірі!
Dialogue: 0,0:06:05.93,0:06:09.10,Default-ja,,0,0,0,,Өте бақытты, сондай көңілді!
Dialogue: 0,0:06:06.13,0:06:09.26,Default,,0,0,0,,Мен өте қуаныштымын! Бұл өте қызық!
Dialogue: 0,0:06:09.27,0:06:12.30,Default,,0,0,0,,Толқып кеткенім сонша, бүгін түнде ұйықтай алмаймын!
Dialogue: 0,0:06:09.27,0:06:12.31,Default-ja,,0,0,0,,Толқып кеткенім сонша, бүгін түнде ұйықтай алмаймын!
Dialogue: 0,0:06:12.88,0:06:14.49,Default,,0,0,0,,Егер сіз оны асыға күткен болсаңыз,
Dialogue: 0,0:06:12.94,0:06:15.98,Default-ja,,0,0,0,,Егер сіз оны асыға күткен болсаңыз, өзіңіз баруыңыз керек еді.
Dialogue: 0,0:06:14.49,0:06:15.97,Default,,0,0,0,,Неге өзің бармадың?
Dialogue: 0,0:06:16.28,0:06:19.44,Default-ja,,0,0,0,,Мен бұл туралы ештеңе істей алмаймын.
Dialogue: 0,0:06:16.29,0:06:19.57,Default,,0,0,0,,Бірақ... Айтайын дегенім... Оған көмектесу мүмкін емес еді, солай ма?
Dialogue: 0,0:06:19.61,0:06:21.98,Default,,0,0,0,,Мен сабан тартуда жеңілдім...
Dialogue: 0,0:06:19.61,0:06:21.98,Default-ja,,0,0,0,,Мен лотереядан ұтылып қала жаздадым!
Dialogue: 0,0:06:22.49,0:06:25.20,Default-ja,,0,0,0,,Луя! Менің көңілім қалды!
Dialogue: 0,0:06:23.40,0:06:24.95,Default,,0,0,0,,Менің көңілім қалды!
Dialogue: 0,0:06:25.62,0:06:27.07,Default,,0,0,0,,Менің арманым...
Dialogue: 0,0:06:25.62,0:06:30.66,Default-ja,,0,0,0,,Менің арманым - бұл дүниеде сенен артық өмір сүргісі келетіндердің бәрін өлтіру.
Dialogue: 0,0:06:27.07,0:06:30.61,Default,,0,0,0,,түнде сенен артық өмір сүргісі келетіндердің бәрін өлтір,
Dialogue: 0,0:06:31.10,0:06:36.50,Default,,0,0,0,,және, ең соңында, мен сені мұқият өлтіремін. Оған өмірімді тігу.
Dialogue: 0,0:06:31.17,0:06:36.50,Default-ja,,0,0,0,,Менің ең соңғы іс-әрекетім - өмірімнің соңына дейін қолымнан келгенше сені өлтіру.
Dialogue: 0,0:06:37.21,0:06:40.83,Default-ja,,0,0,0,,Мені дәл осы жерде өлтірсең, жарайды...
Dialogue: 0,0:06:37.24,0:06:40.83,Default,,0,0,0,,Мені осы жерде және қазір өлтірсең де, қарсы емеспін, Лэдд.
Dialogue: 0,0:06:40.98,0:06:42.43,Default,,0,0,0,,Не айтып тұрсың?!
Dialogue: 0,0:06:41.01,0:06:44.25,Default-ja,,0,0,0,,Не айтып тұрсың! Жоқ, жоқ, жоқ!
Dialogue: 0,0:06:42.43,0:06:44.12,Default,,0,0,0,,Жоқ, жоқ, жоқ!
Dialogue: 0,0:06:44.51,0:06:46.59,Default-ja,,0,0,0,,Бұл дүниеде әлі көп нәрсе бар.
Dialogue: 0,0:06:44.57,0:06:50.70,Default,,0,0,0,,Бұл түн әлі де көп және көптеген адамдармен толып жатыр және мен өлтіруім керек!
Dialogue: 0,0:06:46.77,0:06:50.55,Default-ja,,0,0,0,,Ол өлтіру керек адамдарға толы!
Dialogue: 0,0:06:50.70,0:06:53.85,Default,,0,0,0,,Мен сені өлтіргенше ұзақ, ұзақ, көп уақыт өтеді!
Dialogue: 0,0:06:50.73,0:06:53.84,Default-ja,,0,0,0,,Мен сені өлтіргенше әлі көп жұмыс істеуім керек!
Dialogue: 0,0:06:54.90,0:06:55.89,Default-ja,,0,0,0,,Рату де...
Dialogue: 0,0:06:54.95,0:06:55.89,Default,,0,0,0,,Лад...
Dialogue: 0,0:06:57.65,0:07:00.77,Default,,0,0,0,,Олай болса, оған дейін өлме, менімен бірге бол.
Dialogue: 0,0:06:57.65,0:07:01.11,Default-ja,,0,0,0,,Олай болса, оған дейін өлмей, менің артымнан жүр.
Dialogue: 0,0:07:01.24,0:07:02.23,Default-ja,,0,0,0,,Жақсы ма?
Dialogue: 0,0:07:01.42,0:07:02.23,Default,,0,0,0,,О, Ято.
Dialogue: 0,0:07:04.15,0:07:04.51,Default,,0,0,0,,Иә...
Dialogue: 0,0:07:07.33,0:07:09.24,Default-ja,,0,0,0,,Бицукидің бірінші нөмірі қатты толқыды.
Dialogue: 0,0:07:07.37,0:07:09.59,Default,,0,0,0,,Виккидің көңіл-күйі өте жақсы.
Dialogue: 0,0:07:12.21,0:07:13.91,Default-ja,,0,0,0,,Әй, шіркін~
Dialogue: 0,0:07:12.36,0:07:13.84,Default,,0,0,0,,Ах, бәлен...
Dialogue: 0,0:07:15.03,0:07:16.38,Default,,0,0,0,,Қарғыс атсын Вики!
Dialogue: 0,0:07:15.04,0:07:19.25,Default-ja,,0,0,0,,Мен Биккидің бірінші нөмірін қызғанамын. Шынайы, шын!
Dialogue: 0,0:07:16.38,0:07:18.08,Default,,0,0,0,,Көптеген оқиғалар болды, бірақ
Dialogue: 0,0:07:18.09,0:07:19.25,Default,,0,0,0,,Шынайы, шын!
Dialogue: 0,0:07:19.71,0:07:24.08,Default-ja,,0,0,0,,Әй, маған ұнамайды, ұнамайды, бұл дүниеде Құдай жоқ.
Dialogue: 0,0:07:20.28,0:07:21.82,Default,,0,0,0,,Мен қаламаймын!
Dialogue: 0,0:07:21.82,0:07:24.37,Default,,0,0,0,,Құдай енді бұл дүниеде жоқ.
Dialogue: 0,0:07:24.30,0:07:27.21,Default-ja,,0,0,0,,Бицуки Хаджиме оны дәл қазір өлтірген болуы керек!
Dialogue: 0,0:07:24.37,0:07:26.94,Default,,0,0,0,,Вики оны дәл қазір өлтірген болуы керек!
Dialogue: 0,0:07:28.22,0:07:30.05,Default-ja,,0,0,0,,Дацутараға барсаң
Dialogue: 0,0:07:28.26,0:07:30.01,Default,,0,0,0,,Онда неге барып көрмейсің?
Dialogue: 0,0:07:30.56,0:07:31.55,Default-ja,,0,0,0,,Міне!
Dialogue: 0,0:07:30.61,0:07:31.55,Default,,0,0,0,,Міне!
Dialogue: 0,0:07:31.90,0:07:33.22,Default,,0,0,0,,Дұрыс айтасыз.
Dialogue: 0,0:07:32.10,0:07:34.89,Default-ja,,0,0,0,,Дұрыс, барып көр.
Dialogue: 0,0:07:33.22,0:07:35.08,Default,,0,0,0,,Мен барып көре аламын.
Dialogue: 0,0:07:35.06,0:07:36.55,Default-ja,,0,0,0,,Бұл мен үшін күшті нәрсе.
Dialogue: 0,0:07:35.08,0:07:36.73,Default,,0,0,0,,Мен сондай ақымақпын.
Dialogue: 0,0:07:36.73,0:07:39.77,Default-ja,,0,0,0,,Мұндай жерде күтудің қажеті жоқ еді.
Dialogue: 0,0:07:36.73,0:07:39.91,Default,,0,0,0,,Мен мұнда күтудің қажеті жоқ.
Dialogue: 0,0:07:39.91,0:07:44.06,Default,,0,0,0,,Мен бұл жерде шыдамдылықпен күтуім керек деп біраз ойландым.
Dialogue: 0,0:07:39.94,0:07:44.06,Default-ja,,0,0,0,,Мен бұл жерде тыныш болуым керек деп ойладым.
Dialogue: 0,0:07:44.29,0:07:46.05,Default,,0,0,0,,Мен сәлден кейін қайтамын.
Dialogue: 0,0:07:44.61,0:07:45.82,Default-ja,,0,0,0,,Мен келемін!
Dialogue: 0,0:07:46.62,0:07:47.90,Default-ja,,0,0,0,,О!
Dialogue: 0,0:07:47.90,0:07:50.07,Default,,0,0,0,,Абайлаңыз, сіз...
Dialogue: 0,0:07:48.12,0:07:50.03,Default-ja,,0,0,0,,Абайлаңыз, мына бала... көңілсіз.
Dialogue: 0,0:07:50.25,0:07:54.28,Default-ja,,0,0,0,,А-а, кешіріңіз. Кешіріңіз.
Dialogue: 0,0:07:52.18,0:07:53.24,Default,,0,0,0,,Неге?!
Dialogue: 0,0:07:53.24,0:07:54.40,Default,,0,0,0,,Кешірім сұраймын.
Dialogue: 0,0:07:54.40,0:07:55.78,Default,,0,0,0,,Пойызға қауіп төніп тұр!
Dialogue: 0,0:07:54.46,0:07:55.79,Default-ja,,0,0,0,,Пойыз қиындыққа тап болды!
Dialogue: 0,0:07:56.54,0:07:59.71,Default-ja,,0,0,0,,Сондықтан мен кондуктор бөлмесіне баруым керек.
Dialogue: 0,0:07:56.78,0:08:00.42,Default,,0,0,0,,Сондықтан мен кондуктор бөлмесіне баруым керек.
Dialogue: 0,0:07:59.88,0:08:02.34,Default-ja,,0,0,0,,Қалай болғанда да, кешіріңіз!
Dialogue: 0,0:08:00.42,0:08:01.84,Default,,0,0,0,,Қалай болғанда да, кешіріңіз!
Dialogue: 0,0:08:03.01,0:08:04.71,Default-ja,,0,0,0,,Сол жігіт
Dialogue: 0,0:08:03.02,0:08:03.99,Default,,0,0,0,,Ол...
Dialogue: 0,0:08:05.50,0:08:06.92,Default,,0,0,0,,Мен оның...
Dialogue: 0,0:08:05.51,0:08:06.92,Default-ja,,0,0,0,,Белгілі
Dialogue: 0,0:08:07.95,0:08:10.92,Default,,0,0,0,,Қызықты болды.
Dialogue: 0,0:08:08.01,0:08:10.93,Default-ja,,0,0,0,,Қызық болып барады
Dialogue: 0,0:08:11.26,0:08:16.93,Default,,0,0,0,,Луа, сен онымен бірге кондуктор бөлмесіне барып тексере аласың ба?
Dialogue: 0,0:08:11.27,0:08:14.13,Default-ja,,0,0,0,,Руа! Чийотсутойо, онымен.
Dialogue: 0,0:08:14.31,0:08:16.93,Default-ja,,0,0,0,,Кондуктор бөлмесіндегі Киоконы көріп жібере аласыз ба?
Dialogue: 0,0:08:18.19,0:08:20.77,Default-ja,,0,0,0,,~ Бетінде жанама әсері бар устрица бар
Dialogue: 0,0:08:18.23,0:08:23.62,Default,,0,0,0,,Бетінде татуировкасы бар бала болса, оны әзірше ұстап алыңыз.
Dialogue: 0,0:08:20.94,0:08:23.40,Default-ja,,0,0,0,,Әзірге оны алыңыз.
Dialogue: 0,0:08:23.62,0:08:24.20,Default,,0,0,0,,Алдымен, ортаңғы және көрсеткі саусақтарыңызды осылайша қосыңыз,
Dialogue: 0,0:08:30.41,0:08:35.58,Default-ja,,0,0,0,,Бұл не? Бұл пойыз шынымен қызық болып барады...
Dialogue: 0,0:08:30.48,0:08:32.31,Default,,0,0,0,,Бұл пойызға не болды?
Dialogue: 0,0:08:32.31,0:08:35.76,Default,,0,0,0,,Істер қызық болып бара жатқаны сөзсіз.
Dialogue: 0,0:08:35.75,0:08:38.87,Default-ja,,0,0,0,,Әлгі татуировкасы бар бала қорқынышты нәрсе айтты.
Dialogue: 0,0:08:35.76,0:08:40.45,Default,,0,0,0,,Маған таң қалдыратын бала татуировкасы туралы айтқан қорқынышты нәрсе не болуы мүмкін?
Dialogue: 0,0:08:39.04,0:08:40.45,Default-ja,,0,0,0,,Қызық, бұл не?
Dialogue: 0,0:08:41.10,0:08:42.98,Default,,0,0,0,,Бұл қауіпті...
Dialogue: 0,0:08:41.13,0:08:46.72,Default-ja,,0,0,0,,О, құдайым, мені босататын кез келді, әйтпесе мен бұзыламын.
Dialogue: 0,0:08:42.98,0:08:46.71,Default,,0,0,0,,Тезірек босамасам, жарылып кетем!
Dialogue: 0,0:08:52.71,0:08:54.72,Default,,0,0,0,,Әй, тоқта!
Dialogue: 0,0:08:52.93,0:08:56.64,Default-ja,,0,0,0,,Эй, кел! Қолдарыңыз күйіп кетеді!
Dialogue: 0,0:08:54.72,0:08:56.58,Default,,0,0,0,,Қолың күйіп күл болады!
Dialogue: 0,0:08:56.94,0:08:58.14,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:08:56.94,0:08:58.14,Default-ja,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:09:01.35,0:09:02.28,Default,,0,0,0,,Ф-Фатирлеу ештеңе әкелмейді.
Dialogue: 0,0:09:02.23,0:09:05.07,Default-ja,,0,0,0,,О, керемет Рэнди
Dialogue: 0,0:09:02.28,0:09:05.37,Default,,0,0,0,,Бұл керемет, Рэнди!
Dialogue: 0,0:09:05.37,0:09:08.91,Default,,0,0,0,,Бүгінгі кештегі ойын-сауық үшін тамаша болады.
Dialogue: 0,0:09:05.40,0:09:08.77,Default-ja,,0,0,0,,Бүгінгі түнгі ойын-сауық үшін өте қолайлы.
Dialogue: 0,0:09:08.91,0:09:11.23,Default,,0,0,0,,Фиро да бақытты болады!
Dialogue: 0,0:09:08.95,0:09:11.23,Default-ja,,0,0,0,,Фуиитиро да өте бақытты болады.
Dialogue: 0,0:09:14.54,0:09:18.00,Default-ja,,0,0,0,,Эй Петучио, сен не істеп жатырсың?
Dialogue: 0,0:09:14.77,0:09:15.64,Default,,0,0,0,,Та-да!
Dialogue: 0,0:09:16.25,0:09:17.99,Default,,0,0,0,,Пеццо, сен не істеп жатырсың?
Dialogue: 0,0:09:18.47,0:09:20.08,Default,,0,0,0,,Мен де солай істеймін.
Dialogue: 0,0:09:18.54,0:09:20.03,Default-ja,,0,0,0,,Мен де істеймін
Dialogue: 0,0:09:20.90,0:09:22.11,Default,,0,0,0,,Эй, күт!
Dialogue: 0,0:09:20.92,0:09:22.83,Default-ja,,0,0,0,,Әй, күте тұрыңыз, қолғаптарыңыз...
Dialogue: 0,0:09:22.11,0:09:23.56,Default,,0,0,0,,Қолғаптарыңыз...
Dialogue: 0,0:09:23.55,0:09:24.63,Default-ja,,0,0,0,,Матадан жасалған болса да!
Dialogue: 0,0:09:23.56,0:09:25.00,Default,,0,0,0,,Матадан жасалған, солай емес пе?!
Dialogue: 0,0:09:24.80,0:09:26.54,Default-ja,,0,0,0,,О, өте ыстық!
Dialogue: 0,0:09:26.80,0:09:29.09,Default-ja,,0,0,0,,Сәлем! Ол жоғалып кетпейді!
Dialogue: 0,0:09:27.52,0:09:29.04,Default,,0,0,0,,Ол шықпайды!
Dialogue: 0,0:09:29.04,0:09:31.46,Default,,0,0,0,,Егер олар былғарыдан жасалмаса, ол жұмыс істемейді!
Dialogue: 0,0:09:29.34,0:09:31.30,Default-ja,,0,0,0,,Былғары кимеген жақсы емес!
Dialogue: 0,0:09:31.46,0:09:34.24,Default,,0,0,0,,Оны шешіңіз! Қолғапыңды шеш!
Dialogue: 0,0:09:31.55,0:09:34.67,Default-ja,,0,0,0,,Тынышталыңыз! Қолғаптарыңды шешіңдер! Кәне!
Dialogue: 0,0:09:35.89,0:09:38.93,Default-ja,,0,0,0,,Жылу! Жылу!
Dialogue: 0,0:09:41.23,0:09:42.27,Default-ja,,0,0,0,,Амансың ба?
Dialogue: 0,0:09:41.23,0:09:42.29,Default,,0,0,0,,Сенде бәрі жақсы ма?
Dialogue: 0,0:09:42.29,0:09:45.44,Default,,0,0,0,,Иә... Мен өлемін деп ойладым.
Dialogue: 0,0:09:42.44,0:09:45.40,Default-ja,,0,0,0,,А... Мен өлемін деп ойладым.
Dialogue: 0,0:09:45.57,0:09:49.06,Default-ja,,0,0,0,,Мен гарнир қосылған тұтас қуырылған тағамды жегім келмейді.
Dialogue: 0,0:09:45.63,0:09:48.80,Default,,0,0,0,,Мен сенімен бірге тірідей өртенгім келмейді.
Dialogue: 0,0:09:49.24,0:09:52.61,Default-ja,,0,0,0,,Қандай ұят хахахахахахаха...
Dialogue: 0,0:09:49.29,0:09:52.02,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:10:45.39,0:10:47.28,Default,,0,0,0,,Негізгі дәйексөздер!
Dialogue: 0,0:10:45.42,0:10:49.46,Default-ja,,0,0,0,,Кукойчицу-сама! Ақыры аяқталды!
Dialogue: 0,0:10:47.28,0:10:49.46,Default,,0,0,0,,Бұл аяқталды!
Dialogue: 0,0:10:57.97,0:11:00.47,Default-ja,,0,0,0,,Аяқ киім
Dialogue: 0,0:11:06.22,0:11:07.84,Default,,0,0,0,,Мұнда.
Dialogue: 0,0:11:06.48,0:11:08.94,Default-ja,,0,0,0,,Қат! Неліктен мұндай уақытта?
Dialogue: 0,0:11:07.84,0:11:09.55,Default,,0,0,0,,Неге мұндай уақытта?!
Dialogue: 0,0:11:31.01,0:11:33.59,Default-ja,,0,0,0,,Жас ханым, мұнда көп нәрсе болып жатыр.
Dialogue: 0,0:11:31.05,0:11:33.79,Default,,0,0,0,,Ханым, міне!
Dialogue: 0,0:11:33.76,0:11:37.55,Default-ja,,0,0,0,,Менің бала күнгі досым жасөспірім.
Dialogue: 0,0:11:33.79,0:11:37.75,Default,,0,0,0,,Бұл менің ескі досым жұмыс істейтін ақпарат дүкені.
Dialogue: 0,0:11:37.72,0:11:40.96,Default-ja,,0,0,0,,Не? Газет компаниясы емес пе?
Dialogue: 0,0:11:37.75,0:11:40.92,Default,,0,0,0,,Бұл не? Газет компаниясы емес пе?
Dialogue: 0,0:11:41.39,0:11:46.64,Default-ja,,0,0,0,,Хмм, мен бұған белгілі бір дәрежеде сенетін шығармын.
Dialogue: 0,0:11:42.67,0:11:46.86,Default,,0,0,0,,Біз оларға белгілі бір дәрежеде сене аламыз.
Dialogue: 0,0:11:46.81,0:11:50.52,Default-ja,,0,0,0,,Менен Даллас Ботчама туралы ештеңе сұрама, мен түсінемін.
Dialogue: 0,0:11:46.86,0:11:50.52,Default,,0,0,0,,Барып, олардан Даллас мырза туралы сұраңыз... Олар біледі.
Dialogue: 0,0:11:51.90,0:11:53.23,Default-ja,,0,0,0,,Әрқашан!
Dialogue: 0,0:11:51.94,0:11:53.52,Default,,0,0,0,,Қайта оралыңыз!
Dialogue: 0,0:12:08.04,0:12:12.00,Default-ja,,0,0,0,,Танысқаныма қуаныштымын, Хонми, сенің ісің не?
Dialogue: 0,0:12:08.24,0:12:09.99,Default,,0,0,0,,Капипа
Dialogue: 0,0:12:09.99,0:12:12.00,Default,,0,0,0,,Бүгін біз сізге қалай көмектесе аламыз?
Dialogue: 0,0:12:13.51,0:12:14.50,Default-ja,,0,0,0,,3‥
Dialogue: 0,0:12:13.67,0:12:16.95,Default,,0,0,0,,Уау, керемет!
Dialogue: 0,0:12:15.22,0:12:17.00,Default-ja,,0,0,0,,Бұл керемет...
Dialogue: 0,0:12:17.30,0:12:19.84,Default-ja,,0,0,0,,Бұл керемет, Майза Хажиме мырза
Dialogue: 0,0:12:17.37,0:12:19.84,Default,,0,0,0,,Бұл таңқаларлық, солай емес пе, Майза мырза?
Dialogue: 0,0:12:20.43,0:12:25.54,Default,,0,0,0,,Мартилло отбасындағы басшыларға арналған шляпалар ұрпақтар үшін осында таңдалған.
Dialogue: 0,0:12:20.43,0:12:25.72,Default-ja,,0,0,0,,Дәл осы жерде басшылардың бас киімдері таңдалады, ол ұрпақтар бойы жалғасып келеді.
Dialogue: 0,0:12:26.00,0:12:28.17,Default,,0,0,0,,Мен өзімді де осы жерден сатып алдым.
Dialogue: 0,0:12:26.02,0:12:28.18,Default-ja,,0,0,0,,Мен өзімді де осы жерден сатып алдым.
Dialogue: 0,0:12:28.52,0:12:31.69,Default-ja,,0,0,0,,Басшылар... Мен өзімді күшті сезінбеймін.
Dialogue: 0,0:12:28.54,0:12:30.24,Default,,0,0,0,,Атқарушы, иә?
Dialogue: 0,0:12:30.24,0:12:31.67,Default,,0,0,0,,Мен оны әлі толық түсінген жоқпын...
Dialogue: 0,0:12:32.03,0:12:35.56,Default-ja,,0,0,0,,Нағыз сезім үйренгеннен кейін ғана пайда болады.
Dialogue: 0,0:12:32.09,0:12:35.65,Default,,0,0,0,,Түсіну - сіз оған айналғаннан кейін жасайтын нәрсе.
Dialogue: 0,0:12:35.65,0:12:39.02,Default,,0,0,0,,Бұл шынымен жақсы ма? Менімен бірге?
Dialogue: 0,0:12:35.74,0:12:38.73,Default-ja,,0,0,0,,Менің мұны істегенімді қалайтыныңызға сенімдісіз бе?
Dialogue: 0,0:12:38.99,0:12:41.86,Default-ja,,0,0,0,,Жарайды, себебі бұл сенсің.
Dialogue: 0,0:12:39.03,0:12:41.82,Default,,0,0,0,,Жарайды, өйткені бұл сенсің, Фиро.
Dialogue: 0,0:12:47.33,0:12:49.54,Default-ja,,0,0,0,,Бұл тамаша, Майза мырза!
Dialogue: 0,0:12:47.34,0:12:49.75,Default,,0,0,0,,Маған ұнады, Майза мырза!
Dialogue: 0,0:12:49.71,0:12:51.42,Default-ja,,0,0,0,,Бұл мен үшін қаншық!
Dialogue: 0,0:12:49.75,0:12:51.62,Default,,0,0,0,,Бұл маған өте сәйкес келеді.
Dialogue: 0,0:12:51.59,0:12:54.20,Default-ja,,0,0,0,,Бірінші бетке қош келдіңіз...
Dialogue: 0,0:12:51.62,0:12:54.33,Default,,0,0,0,,Мартилло отбасына қош келдіңіз!
Dialogue: 0,0:12:54.33,0:12:55.92,Default,,0,0,0,,Каморра әлеміне.
Dialogue: 0,0:12:54.33,0:12:55.92,Default-top,TLNOTE,0,0,0,,Каморра — Италияның Кампания аймағындағы және Неаполь қаласындағы мафияға ұқсас қылмыстық ұйым немесе құпия қоғам.
Dialogue: 0,0:12:54.38,0:12:55.92,Default-ja,,0,0,0,,Күш әлеміне
Dialogue: 0,0:12:56.38,0:12:59.79,Default,,0,0,0,,Майза мырза, сіз бір күн ерте емессіз бе?
Dialogue: 0,0:12:56.38,0:12:59.80,Default-ja,,0,0,0,,Майза мырза, әлі ерте емес пе?
Dialogue: 0,0:13:00.43,0:13:03.80,Default-ja,,0,0,0,,Рәсім басталды.
Dialogue: 0,0:13:00.47,0:13:03.80,Default,,0,0,0,,Рәсім басталды, Фиро.
Dialogue: 0,0:13:07.42,0:13:08.93,Default,,0,0,0,,О, кешірім сұраймын.
Dialogue: 0,0:13:07.48,0:13:08.59,Default-ja,,0,0,0,,Ой, кешіріңіз...
Dialogue: 0,0:13:08.93,0:13:11.73,Default,,0,0,0,,Әй, эй, қайда жүргеніңді байқа.
Dialogue: 0,0:13:08.94,0:13:11.55,Default-ja,,0,0,0,,Ей, абай бол.
Dialogue: 0,0:13:12.07,0:13:13.85,Default-ja,,0,0,0,,Абайлаңыз
Dialogue: 0,0:13:12.09,0:13:13.95,Default,,0,0,0,,Қай жерде жүргеніңізді бақылаңыз.
Dialogue: 0,0:13:24.22,0:13:26.11,Default,,0,0,0,,Майза мырза, мына жерде.
Dialogue: 0,0:13:24.25,0:13:25.86,Default-ja,,0,0,0,,Майза Хаджиме мырза...
Dialogue: 0,0:13:30.29,0:13:32.33,Default-ja,,0,0,0,,Мен қараймын!
Dialogue: 0,0:13:30.30,0:13:32.62,Default,,0,0,0,,Мен жылдам қарап шығайын.
Dialogue: 0,0:13:32.62,0:13:35.37,Default,,0,0,0,,Фиро, енді маған ашуланба.
Dialogue: 0,0:13:32.71,0:13:35.42,Default-ja,,0,0,0,,Фуичиро! Мазалауды тоқтатыңыз!
Dialogue: 0,0:13:35.92,0:13:37.83,Default-ja,,0,0,0,,Мен жай ғана уайымдап тұрмын.
Dialogue: 0,0:13:35.97,0:13:37.81,Default,,0,0,0,,Мен жай ғана уайымдап тұрмын.
Dialogue: 0,0:13:52.97,0:13:54.63,Default,,0,0,0,,Маған көмектес...
Dialogue: 0,0:13:52.98,0:13:54.44,Default-ja,,0,0,0,,Амансың ба?
Dialogue: 0,0:13:54.63,0:13:56.27,Default,,0,0,0,,А, иә.
Dialogue: 0,0:13:57.47,0:13:59.34,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:13:57.49,0:13:59.35,Default-ja,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:13:59.82,0:14:03.59,Default,,0,0,0,,Мен біреуді іздеп жүрмін, сондықтан...
Dialogue: 0,0:13:59.82,0:14:03.94,Default-ja,,0,0,0,,Мен біреуді іздеп жүрмін, сондықтан бұл...
Dialogue: 0,0:14:15.88,0:14:17.21,Default-ja,,0,0,0,,Сәлем!
Dialogue: 0,0:14:15.92,0:14:16.69,Default,,0,0,0,,Бір сәт те жоғалтуға болмайды.
Dialogue: 0,0:14:16.69,0:14:17.72,Default,,0,0,0,,Сіз!
Dialogue: 0,0:14:20.42,0:14:21.33,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:14:20.43,0:14:21.54,Default-ja,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:14:27.89,0:14:28.88,Default-ja,,0,0,0,,Ой
Dialogue: 0,0:14:29.48,0:14:32.34,Default-ja,,0,0,0,,Не болды, Джиякудзиичи, сен сонша асығып тұрсың ба?
Dialogue: 0,0:14:29.50,0:14:33.14,Default,,0,0,0,,Не болды, джакузи? Осылай асығыс.
Dialogue: 0,0:14:34.02,0:14:37.73,Default-ja,,0,0,0,,Бұл үлкен мәселе. Бұл пойыз жоғалып кетуі мүмкін!
Dialogue: 0,0:14:34.10,0:14:37.92,Default,,0,0,0,,Апат! Бұл пойыз жоғалып кетуі мүмкін!
Dialogue: 0,0:14:37.90,0:14:40.61,Default-ja,,0,0,0,,Сондықтан мен кондукторға барамын!
Dialogue: 0,0:14:37.92,0:14:40.80,Default,,0,0,0,,Сондықтан мен кондукторға барамын!
Dialogue: 0,0:14:40.78,0:14:42.40,Default-ja,,0,0,0,,Иә? иә?
Dialogue: 0,0:14:42.57,0:14:44.53,Default-ja,,0,0,0,,Жақсы болды.
Dialogue: 0,0:14:43.15,0:14:44.76,Default,,0,0,0,,Дәл уақытында.
Dialogue: 0,0:14:44.70,0:14:46.24,Default-ja,,0,0,0,,21 әпкесі Әне
Dialogue: 0,0:14:44.76,0:14:45.56,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:14:45.56,0:14:46.23,Default,,0,0,0,,Сис.
Dialogue: 0,0:14:46.66,0:14:47.65,Default-ja,,0,0,0,,Джиякуджи деген кім?
Dialogue: 0,0:14:46.72,0:14:47.65,Default,,0,0,0,,Джакузи қайда?
Dialogue: 0,0:14:48.00,0:14:50.58,Default-ja,,0,0,0,,Дирижер Сацуки Имаға бару
Dialogue: 0,0:14:48.01,0:14:50.57,Default,,0,0,0,,Ол дәл қазір кондуктор бөлмесіне бара жатқанын айтты...
Dialogue: 0,0:14:50.83,0:14:53.04,Default-ja,,0,0,0,,До Ниичи менімен бірге жүріңізші.
Dialogue: 0,0:14:50.87,0:14:53.19,Default,,0,0,0,,Менімен бірге жүрші, Донни.
Dialogue: 0,0:14:53.19,0:14:57.53,Default,,0,0,0,,Джакузиді өзімізбен бірге алып бара жатқанда, біз багаж бөлмесін тексереміз.
Dialogue: 0,0:14:53.21,0:14:57.37,Default-ja,,0,0,0,,Мен Джиякуджиді қайтарып жатқанда, жүк қоймасын қараймын.
Dialogue: 0,0:14:57.53,0:14:59.98,Default,,0,0,0,,Мен саған асхана үшін сенемін, Ник.
Dialogue: 0,0:14:57.55,0:15:00.08,Default-ja,,0,0,0,,Ницуку, асхана вагонын пайдаланыңыз.
Dialogue: 0,0:15:03.13,0:15:05.87,Default,,0,0,0,,Не айтасың, Ницца-неесан...
Dialogue: 0,0:15:03.14,0:15:05.84,Default-ja,,0,0,0,,Бұл не, 21-ші ханым?
Dialogue: 0,0:15:05.87,0:15:08.97,Default,,0,0,0,,Менің асхананы не істегенімді қалайсың?
Dialogue: 0,0:15:06.01,0:15:08.97,Default-ja,,0,0,0,,Асханамен не істеуім керек?
Dialogue: 0,0:15:09.45,0:15:11.97,Default,,0,0,0,,«Мен саған асхана үшін сенемін, Ник».
Dialogue: 0,0:15:09.48,0:15:12.01,Default-ja,,0,0,0,,Ницуку, асхана вагонын пайдаланыңыз.
Dialogue: 0,0:15:12.19,0:15:15.31,Default,,0,0,0,,Аа, ол былай деген сияқты...
Dialogue: 0,0:15:12.23,0:15:15.31,Default-ja,,0,0,0,,Аа, менің ойымша, бұл мағынаны білдіреді.
Dialogue: 0,0:15:15.60,0:15:21.31,Default,,0,0,0,,«Біз жұмыс істеп жатқанда, вагондағы адамдарды қадағалаңыздар».
Dialogue: 0,0:15:15.73,0:15:18.89,Default-ja,,0,0,0,,Біз жұмыс істеп жатқанда, Ницуку
Dialogue: 0,0:15:19.03,0:15:21.31,Default-ja,,0,0,0,,Асханада отырғандарды қадағалаңыз!
Dialogue: 0,0:15:21.82,0:15:25.94,Default-ja,,0,0,0,,Аа, бұл негізінен осыны білдіреді.
Dialogue: 0,0:15:22.96,0:15:25.94,Default,,0,0,0,,Сонымен, басқаша айтқанда... осыған ұқсас нәрсе болуы мүмкін бе?
Dialogue: 0,0:15:26.49,0:15:31.20,Default-ja,,0,0,0,,Біз оларды тонап жатқанда, олар бізді ұстап алып, шу шығарды.
Dialogue: 0,0:15:26.50,0:15:28.93,Default,,0,0,0,,«Егер бізді тонау кезінде табылса,»
Dialogue: 0,0:15:28.93,0:15:34.45,Default,,0,0,0,,«біз олардың шу шығарып, пойызды тоқтатуына жол бере алмаймыз»,
Dialogue: 0,0:15:31.37,0:15:34.16,Default-ja,,0,0,0,,Пойыз тоқтатса, қарсы болмас едім.
Dialogue: 0,0:15:34.38,0:15:38.71,Default-ja,,0,0,0,,Сонымен, Ник, вагондағы адамдар тыныш болсын.
Dialogue: 0,0:15:34.45,0:15:38.70,Default,,0,0,0,,«Олай болса, Ник, вагондағы адамдарды тыныш ұста.»
Dialogue: 0,0:15:39.57,0:15:41.65,Default,,0,0,0,,Түсінікті! Әпке!
Dialogue: 0,0:15:39.59,0:15:41.71,Default-ja,,0,0,0,,Мен түсіндім, ханым.
Dialogue: 0,0:15:47.43,0:15:48.42,Default-ja,,0,0,0,,Мырзалар...
Dialogue: 0,0:15:47.49,0:15:48.41,Default,,0,0,0,,Мырзалар!
Dialogue: 0,0:15:49.02,0:15:51.88,Default-ja,,0,0,0,,Біз енді Мастер Хиюиді құтқаруды бастаймыз.
Dialogue: 0,0:15:49.03,0:15:51.91,Default,,0,0,0,,Біз сэр Хьюиді құтқару операциясын қазір бастаймыз.
Dialogue: 0,0:16:02.40,0:16:04.74,Default-ja,,0,0,0,,О... Самааичиса!
Dialogue: 0,0:16:03.67,0:16:04.73,Default,,0,0,0,,Самат!
Dialogue: 0,0:16:05.17,0:16:06.81,Default,,0,0,0,,Бруно!
Dialogue: 0,0:16:05.20,0:16:06.81,Default-ja,,0,0,0,,Инженерлік сирек!
Dialogue: 0,0:16:07.33,0:16:10.82,Default-ja,,0,0,0,,Көп уақыт өтті! Бұл шынымен де көп уақыт болды!
Dialogue: 0,0:16:07.51,0:16:10.82,Default,,0,0,0,,Біраз уақыт өтті! Әрине, біраз уақыт өтті!
Dialogue: 0,0:16:15.04,0:16:16.62,Default-ja,,0,0,0,,Daraszi Engineering Noah Id!
Dialogue: 0,0:16:15.11,0:16:16.62,Default,,0,0,0,,Даллас Геноард.
Dialogue: 0,0:16:16.83,0:16:19.62,Default-ja,,0,0,0,,Сіз менің ағамды білесіз.
Dialogue: 0,0:16:16.88,0:16:19.62,Default,,0,0,0,,Сіз менің ағамды танисыз, солай ма?
Dialogue: 0,0:16:19.95,0:16:21.74,Default,,0,0,0,,Сіз мені кім деп ойлайсыз?
Dialogue: 0,0:16:20.00,0:16:24.12,Default-ja,,0,0,0,,Мен кіммін? Бұл қай жер деп ойлайсыңдар?
Dialogue: 0,0:16:21.74,0:16:24.12,Default,,0,0,0,,Бұл қайда деп ойлайсың?
Dialogue: 0,0:16:24.80,0:16:28.59,Default-ja,,0,0,0,,- Нұх әулетінің бірнеше жылдан бері хабарсыз кеткен ұлы.
Dialogue: 0,0:16:24.82,0:16:28.75,Default,,0,0,0,,Бір жыл бұрын жоғалып кеткен Геноардтар отбасының ұлы,
Dialogue: 0,0:16:28.75,0:16:33.61,Default,,0,0,0,,біздің дәуірдегі ең үлкен кәмелетке толмаған қылмыскер, Даллас Геноард!
Dialogue: 0,0:16:28.89,0:16:33.26,Default-ja,,0,0,0,,Біздің заманымыздың ең үлкен зұлым баласы, Нұх!
Dialogue: 0,0:16:33.56,0:16:37.52,Default-ja,,0,0,0,,Күштіге жалтақтау, әлсізді қорлау, жұрт жек көру
Dialogue: 0,0:16:33.61,0:16:35.92,Default,,0,0,0,,Агрессияға көмілген, әлсіздерді қорлау,
Dialogue: 0,0:16:35.92,0:16:39.64,Default,,0,0,0,,бәрінен жиіркенішті, ең жаман түрдегі бейбақ!
Dialogue: 0,0:16:37.69,0:16:39.64,Default-ja,,0,0,0,,Ең жаман ақымақ!
Dialogue: 0,0:16:41.44,0:16:44.81,Default-ja,,0,0,0,,Ағам маған мейірімді болды.
Dialogue: 0,0:16:41.53,0:16:44.72,Default,,0,0,0,,Ағам маған мейірімді адам еді.
Dialogue: 0,0:16:47.28,0:16:51.57,Default-ja,,0,0,0,,Нашар L\! Жаман болды! Аздап L гасу бетчиматсута!
Dialogue: 0,0:16:47.29,0:16:49.51,Default,,0,0,0,,Кешіріңіз, кешірім сұраймын.
Dialogue: 0,0:16:49.51,0:16:51.67,Default,,0,0,0,,Мен шектен шығып кеттім.
Dialogue: 0,0:16:51.67,0:16:54.27,Default,,0,0,0,,Кешіріңіз, кешіріңіз.
Dialogue: 0,0:16:51.74,0:16:54.61,Default-ja,,0,0,0,,Кешіріңіз! кешіріңіз...
Dialogue: 0,0:16:55.00,0:16:58.99,Default-ja,,0,0,0,,Ағаң аман-есен табылсын! Ол аман-есен табылады!
Dialogue: 0,0:16:55.02,0:16:57.34,Default,,0,0,0,,Ағаң міндетті түрде табылады.
Dialogue: 0,0:16:57.34,0:17:01.04,Default,,0,0,0,,Оның бәрі жақсы болады, уайымдама. Жақсы?
Dialogue: 0,0:16:59.17,0:17:01.03,Default-ja,,0,0,0,,Сондықтан уайымдамаңыз!
Dialogue: 0,0:17:14.98,0:17:17.34,Default-ja,,0,0,0,,Кеш болды! Кеш!
Dialogue: 0,0:17:15.29,0:17:17.59,Default,,0,0,0,,Кеш! Сіз кешіктіңіз!
Dialogue: 0,0:17:17.52,0:17:21.31,Default-ja,,0,0,0,,Біздің тұтынушылар күте алмайды! Біз күте алмаймыз!
Dialogue: 0,0:17:17.59,0:17:19.77,Default,,0,0,0,,Біздің клиент күтті!
Dialogue: 0,0:17:19.77,0:17:21.31,Default,,0,0,0,,Тым ұзақ күту!
Dialogue: 0,0:17:25.61,0:17:26.60,Default-ja,,0,0,0,,Рахмет!
Dialogue: 0,0:17:25.63,0:17:27.14,Default,,0,0,0,,Хиёри, қош келдің.
Dialogue: 0,0:17:27.14,0:17:28.91,Default,,0,0,0,,Сәл күтіңіз.
Dialogue: 0,0:17:27.15,0:17:30.52,Default-ja,,0,0,0,,Күте тұрыңыз! Мен оны қазір қараймын!
Dialogue: 0,0:17:28.91,0:17:30.52,Default,,0,0,0,,Маған оны біраз оқып шығуға рұқсат етіңіз.
Dialogue: 0,0:17:44.96,0:17:46.25,Default-ja,,0,0,0,,Сіз нені айтасыз!?
Dialogue: 0,0:17:45.01,0:17:46.45,Default,,0,0,0,,Бұл қалай?
Dialogue: 0,0:17:46.42,0:17:50.09,Default-ja,,0,0,0,,Менің ағам Даллас қайда?
Dialogue: 0,0:17:46.45,0:17:50.25,Default,,0,0,0,,Ағам... Менің ағам қайда?
Dialogue: 0,0:17:50.25,0:17:51.59,Default,,0,0,0,,Айтыңызшы, өтінемін!
Dialogue: 0,0:17:50.26,0:17:51.59,Default-ja,,0,0,0,,Айтыңызшы!
Dialogue: 0,0:17:52.01,0:17:54.35,Default-ja,,0,0,0,,А, иә...
Dialogue: 0,0:17:52.05,0:17:53.41,Default,,0,0,0,,И-Иә...
Dialogue: 0,0:17:53.41,0:17:54.34,Default,,0,0,0,,Өте талғампаз болма.
Dialogue: 0,0:17:56.85,0:18:02.10,Default-ja,,0,0,0,,А... Кешіріңіз... Мен ештеңе түсінбеймін.
Dialogue: 0,0:17:58.07,0:17:59.50,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:17:59.73,0:18:02.32,Default,,0,0,0,,Біз ештеңе білмейміз.
Dialogue: 0,0:18:02.32,0:18:04.68,Default-ja,,0,0,0,,Біздің жеке ақпараттық желі болса да
Dialogue: 0,0:18:02.32,0:18:04.71,Default,,0,0,0,,Біздің компанияда бар ақпарат болса да,
Dialogue: 0,0:18:04.71,0:18:08.34,Default,,0,0,0,,ағаңның қайда екені жұмбақ күйінде қалды.
Dialogue: 0,0:18:08.32,0:18:12.53,Default-ja,,0,0,0,,Мацутаку белгісіз сияқты... Шынымен кешіріңіз!
Dialogue: 0,0:18:08.34,0:18:10.59,Default,,0,0,0,,Толығымен белгісіз сияқты.
Dialogue: 0,0:18:10.59,0:18:12.48,Default,,0,0,0,,Мен шынымен кешірім сұраймын.
Dialogue: 0,0:18:17.96,0:18:19.16,Default-ja,,0,0,0,,Хмм…
Dialogue: 0,0:18:19.25,0:18:20.97,Default,,0,0,0,,Не, қария?
Dialogue: 0,0:18:19.33,0:18:23.20,Default-ja,,0,0,0,,Бұл не, қария? Бұл қорап шынымен маңызды ма?
Dialogue: 0,0:18:20.97,0:18:23.20,Default,,0,0,0,,Сіз үшін бұл қорап шынымен де қымбат па?
Dialogue: 0,0:18:23.38,0:18:25.99,Default-ja,,0,0,0,,Мына жерге әкел!
Dialogue: 0,0:18:23.40,0:18:25.98,Default,,0,0,0,,Көрейік. Мұнда беріңіз.
Dialogue: 0,0:18:25.98,0:18:28.14,Default,,0,0,0,,Ұстаңыз.
Dialogue: 0,0:18:26.17,0:18:27.41,Default-ja,,0,0,0,,Ку… ой…
Dialogue: 0,0:18:27.55,0:18:28.54,Default-ja,,0,0,0,,Угу
Dialogue: 0,0:18:28.72,0:18:30.83,Default-ja,,0,0,0,,Сақымды түсіріп, ғашық болып қалған шығармын.
Dialogue: 0,0:18:28.75,0:18:30.88,Default,,0,0,0,,Бұл жігітке бөлме бере алмаймын!
Dialogue: 0,0:18:33.39,0:18:35.67,Default-ja,,0,0,0,,Мені жазалаңыз, қария.
Dialogue: 0,0:18:33.41,0:18:35.77,Default,,0,0,0,,Сен бір қыңыр бейбақсың!
Dialogue: 0,0:18:38.06,0:18:40.05,Default-ja,,0,0,0,,Не қарап тұрсың, балақай?
Dialogue: 0,0:18:38.08,0:18:40.05,Default,,0,0,0,,Не қарап тұрсың, брат?!
Dialogue: 0,0:18:40.27,0:18:45.39,Default-ja,,0,0,0,,Жоқ... Егер сіз тонау жасағыңыз келсе, сізде оны жасауға шешіміңіз бен техникалық мүмкіндігіңіз бар ма?
Dialogue: 0,0:18:40.28,0:18:45.61,Default,,0,0,0,,Жоқ, мен сендер дұрыс дайындалдыңдар ма, жоқ па тексердім.
Dialogue: 0,0:18:45.57,0:18:47.23,Default-ja,,0,0,0,,Маған оны көруге рұқсат берілді.
Dialogue: 0,0:18:45.61,0:18:47.19,Default,,0,0,0,,және сізде тонауды орындау үшін тиісті дағдыларыңыз болса.
Dialogue: 0,0:18:47.44,0:18:52.44,Default-ja,,0,0,0,,Хэцу...жарайды, балақай, үйге барып, маманың есегіне кигіз.
Dialogue: 0,0:18:48.64,0:18:52.48,Default,,0,0,0,,Үйге барып, анаңның кеудесін сорып ал.
Dialogue: 0,0:18:52.87,0:18:55.15,Default-ja,,0,0,0,,Тіпті сол баланың көзқарасы бойынша
Dialogue: 0,0:18:52.89,0:18:55.30,Default,,0,0,0,,Тіпті мына бәйбішенің көзінен де,
Dialogue: 0,0:18:55.28,0:18:58.95,Default-ja,,0,0,0,,Менің ойымша, сіздердің істеп жатқандарыңыз тек балалардың ойыны.
Dialogue: 0,0:18:55.30,0:18:58.95,Default,,0,0,0,,істеп жатқаныңыз баланың ойынынан басқа ештеңеге ұқсамайды.
Dialogue: 0,0:19:00.46,0:19:01.95,Default-ja,,0,0,0,,Мына қарғыс атқыр бала...
Dialogue: 0,0:19:00.49,0:19:01.97,Default,,0,0,0,,Ей, ақымақ!
Dialogue: 0,0:19:02.45,0:19:05.56,Default,,0,0,0,,Сізге зиян тигізгіңіз келетін сияқты, солай емес пе?
Dialogue: 0,0:19:02.46,0:19:05.42,Default-ja,,0,0,0,,Сіз қатты қиналған сияқтысыз.
Dialogue: 0,0:19:05.56,0:19:10.24,Default,,0,0,0,,Менің атым Фиро, бірақ...
Dialogue: 0,0:19:05.59,0:19:10.05,Default-ja,,0,0,0,,Мен ақымақ бала емеспін, бірақ менің атым Фуичиро...
Dialogue: 0,0:19:10.22,0:19:14.00,Default-ja,,0,0,0,,Десе де Марути Джио отбасындағы ең жақсы жігіт.
Dialogue: 0,0:19:10.24,0:19:14.00,Default,,0,0,0,,Мен әлі де Мартилло отбасының жас көшбасшысымын.
Dialogue: 0,0:19:14.18,0:19:15.34,Default-ja,,0,0,0,,Бұған не болды?
Dialogue: 0,0:19:14.26,0:19:15.34,Default,,0,0,0,,Бұл қалай болуы керек?
Dialogue: 0,0:19:23.52,0:19:24.51,Default-ja,,0,0,0,,Жігіт!
Dialogue: 0,0:19:23.76,0:19:25.24,Default,,0,0,0,,Бітім!
Dialogue: 0,0:19:27.61,0:19:28.60,Default-ja,,0,0,0,,Сәлем!
Dialogue: 0,0:19:34.49,0:19:35.48,Default-ja,,0,0,0,,Хэту
Dialogue: 0,0:19:35.48,0:19:39.53,Default,,0,0,0,,Сіз осындай төбелесте пышақ шығарып жатырсыз ба?
Dialogue: 0,0:19:35.78,0:19:39.53,Default-ja,,0,0,0,,Эй, эй... сен мұндай күш үшін бірдеңе бересің бе?
Dialogue: 0,0:19:39.70,0:19:41.11,Default-ja,,0,0,0,,Шулы!
Dialogue: 0,0:19:39.71,0:19:40.86,Default,,0,0,0,,Бұл тек менің алаңдаулы жүрегімді жеделдетті
Dialogue: 0,0:19:51.47,0:19:53.33,Default-ja,,0,0,0,,Амансың ба? Мин-сан
Dialogue: 0,0:19:51.56,0:19:53.32,Default,,0,0,0,,Амансың ба, қария?
Dialogue: 0,0:19:59.49,0:20:01.47,Default,,0,0,0,,Бұл сіз үшін қымбат па?
Dialogue: 0,0:19:59.60,0:20:01.46,Default-ja,,0,0,0,,Бұл маңызды ма?
Dialogue: 0,0:20:01.99,0:20:06.76,Default,,0,0,0,,Тыныш! Оның сен сияқтыларға қатысы жоқ!
Dialogue: 0,0:20:02.02,0:20:03.18,Default-ja,,0,0,0,,Шулы!
Dialogue: 0,0:20:03.35,0:20:06.52,Default-ja,,0,0,0,,Яашуконың саған қатысы жоқ!
Dialogue: 0,0:20:06.73,0:20:10.57,Default-ja,,0,0,0,,Ақша үшін болса, беремін! Ендеше, оны маған беріңіз!
Dialogue: 0,0:20:06.76,0:20:09.04,Default,,0,0,0,,Ақша алғың келсе, беремін!
Dialogue: 0,0:20:09.04,0:20:10.56,Default,,0,0,0,,Сондықтан қазір кетіңіз!
Dialogue: 0,0:20:11.68,0:20:14.48,Default,,0,0,0,,Мен сенің өміріңді сақтап қалдым, білесің бе?
Dialogue: 0,0:20:11.69,0:20:14.73,Default-ja,,0,0,0,,Мен сенің құтқарушыңмын.
Dialogue: 0,0:20:16.13,0:20:18.28,Default,,0,0,0,,Бәрі жақсы...
Dialogue: 0,0:20:16.16,0:20:18.27,Default-ja,,0,0,0,,Ма... L, L, ya
Dialogue: 0,0:20:18.95,0:20:22.16,Default-ja,,0,0,0,,Ей, ақсақал, мен сенен бірдеңе сұрайын деп едім...
Dialogue: 0,0:20:18.99,0:20:22.15,Default,,0,0,0,,Әй, қария, мен сенен бірдеңе сұрайын деп едім.
Dialogue: 0,0:20:22.75,0:20:26.82,Default,,0,0,0,,Сіз кездейсоқ қара түсті костюм киген әйелді көрмедіңіз бе?
Dialogue: 0,0:20:22.75,0:20:26.83,Default-ja,,0,0,0,,Сіз бұл жерде жұқа қара костюм киген әйелді көрдіңіз бе?
Dialogue: 0,0:20:27.06,0:20:30.39,Default,,0,0,0,,Хм, кім туралы айтып тұрғаныңызды түсінбедім.
Dialogue: 0,0:20:27.13,0:20:30.66,Default-ja,,0,0,0,,Ал, енді... Білмеймін.
Dialogue: 0,0:20:31.34,0:20:32.33,Default-ja,,0,0,0,,Мен көремін.
Dialogue: 0,0:20:31.48,0:20:32.33,Default,,0,0,0,,Б... бір сызық
Dialogue: 0,0:20:32.67,0:20:36.79,Default,,0,0,0,,Бұл жігіттер әлі сыртта жүргенде кеткеніңіз дұрыс.
Dialogue: 0,0:20:32.72,0:20:36.63,Default-ja,,0,0,0,,Бұл жігіттер шаршағанша, біз алға жылжуымыз керек.
Dialogue: 0,0:20:36.79,0:20:37.69,Default,,0,0,0,,Кездескенше!
Dialogue: 0,0:20:36.80,0:20:37.79,Default-ja,,0,0,0,,Джияана
Dialogue: 0,0:20:38.89,0:20:45.60,Default-ja,,0,0,0,,Хаа... хаа... хаа... хаа...
Dialogue: 0,0:20:48.69,0:20:52.23,Default-ja,,0,0,0,,А... ха... ха...
Dialogue: 0,0:20:59.00,0:21:00.65,Default,,0,0,0,,Фиро...
Dialogue: 0,0:20:59.16,0:21:00.69,Default-ja,,0,0,0,,Фиичиро…
Dialogue: 0,0:21:08.00,0:21:10.08,Default-ja,,0,0,0,,Нихихи Нихихи…
Dialogue: 0,0:21:12.75,0:21:14.87,Default,,0,0,0,,Менің тәбетім де жоқ, Мирия.
Dialogue: 0,0:21:12.84,0:21:14.58,Default-ja,,0,0,0,,Мен енді қарным да ашпайды.
Dialogue: 0,0:21:14.91,0:21:16.58,Default-top,TLNOTE,0,0,0,,Жапон мақалы, егер біреу белгілі бір тағамды бұдан былай жей алмаса, бірақ қандай да бір себептермен десертке орын бар, демек, «басқа асқазан».
Dialogue: 0,0:21:14.93,0:21:16.58,Default,,0,0,0,,Басқа асқазан нәрсе, солай ма?
Dialogue: 0,0:21:15.09,0:21:17.17,Default-ja,,0,0,0,,Бұл басқа әңгіме.
Dialogue: 0,0:21:21.35,0:21:23.46,Default-ja,,0,0,0,,Бааан... хи хи хи
Dialogue: 0,0:21:25.67,0:21:28.14,Default,,0,0,0,,Олай болса, бастайық па?
Dialogue: 0,0:21:25.68,0:21:28.14,Default-ja,,0,0,0,,Бастаймыз ба?
Dialogue: 0,0:21:30.77,0:21:32.56,Default-ja,,0,0,0,,Жасай бер! Жаса!
Dialogue: 0,0:21:30.83,0:21:32.56,Default,,0,0,0,,Олай болса, мұны істейік!
Dialogue: 0,0:21:34.95,0:21:36.77,Default,,0,0,0,,Баршаңызға! Жерге түс!
Dialogue: 0,0:21:35.03,0:21:36.77,Default-ja,,0,0,0,,Барлығың еденге отырыңдар!
Dialogue: 0,0:21:37.14,0:21:39.02,Default,,0,0,0,,Екі қолды көтеріңіз. Барлығыңыз!
Dialogue: 0,0:21:37.15,0:21:39.07,Default-ja,,0,0,0,,Барлығың қолдарыңды көтеріңдер!
Dialogue: 0,0:21:39.53,0:21:42.57,Default-ja,,0,0,0,,Жоқ, жоқ, жоқ! Барлығың қозғалмаңдар!
Dialogue: 0,0:21:39.59,0:21:42.53,Default,,0,0,0,,Эй, эй, эй! Барлығың қозғалмаңдар!
Dialogue: 0,0:21:46.61,0:21:48.20,Default,,0,0,0,,Бізге не қалайсыз...
Dialogue: 0,0:21:46.66,0:21:48.25,Default-ja,,0,0,0,,Не істеуім керек?
Dialogue: 0,0:21:52.25,0:21:53.41,Default-ja,,0,0,0,,Санрия
Dialogue: 0,0:21:52.27,0:21:53.56,Default,,0,0,0,,Мирия.
Dialogue: 0,0:21:53.56,0:21:55.75,Default,,0,0,0,,Не, Ысқақ?
Dialogue: 0,0:21:53.59,0:21:55.42,Default-ja,,0,0,0,,Не, Ысқақ?
Dialogue: 0,0:21:55.75,0:21:58.61,Default,,0,0,0,,Жерге түсіңіз, екі қолыңызды көтеріңіз...
Dialogue: 0,0:21:55.80,0:22:00.34,Default-ja,,0,0,0,,Еденге жат, қолыңды көтер, тағы не?
Dialogue: 0,0:21:58.61,0:22:00.61,Default,,0,0,0,,Тағы не болды?
Dialogue: 0,0:22:00.61,0:22:03.00,Default,,0,0,0,,«Қозғалма!» деді ол.
Dialogue: 0,0:22:00.64,0:22:02.80,Default-ja,,0,0,0,,Қозғалмаңыз!
Dialogue: 0,0:22:03.00,0:22:04.60,Default,,0,0,0,,Аа, түсіндім.
Dialogue: 0,0:22:03.01,0:22:04.47,Default-ja,,0,0,0,,Айчи мен көріп тұрмын!
Dialogue: 0,0:22:16.19,0:22:19.69,Default-ja,,0,0,0,,Эйчи... Мазалағаным үшін кешіріңіз.
Dialogue: 0,0:22:16.19,0:22:19.85,Default,,0,0,0,,Ухм, сізді мазалағаным үшін кешіріңіз.
Dialogue: 0,0:22:27.68,0:22:28.74,Default,,0,0,0,,Мұнда рух бар.
Dialogue: 0,0:22:27.71,0:22:28.74,Default-ja,,0,0,0,,Сіз
Dialogue: 0,0:22:30.38,0:22:31.74,Default,,0,0,0,,Барнс мырза.
Dialogue: 0,0:22:30.50,0:22:31.78,Default-ja,,0,0,0,,Бунинс мырза
Dialogue: 0,0:22:41.70,0:22:43.29,Default,,0,0,0,,Міне!
Dialogue: 0,0:22:41.72,0:22:45.43,Default-ja,,0,0,0,,Мен келдім... Кешігіп қалдым...
Dialogue: 0,0:22:43.74,0:22:45.28,Default,,0,0,0,,Біз кешігіп қалдық!
Dialogue: 0,0:22:45.99,0:22:48.26,Default,,0,0,0,,Ол қазірдің өзінде аяқталды!
Dialogue: 0,0:22:46.02,0:22:48.26,Default-ja,,0,0,0,,Мен үлгердім
Dialogue: 0,0:22:49.05,0:22:50.95,Default,,0,0,0,,Теміржол трассасы!
Dialogue: 0,0:22:49.10,0:22:51.43,Default-ja,,0,0,0,,Сәулені қабылдау
Dialogue: 0,0:22:57.48,0:23:11.57,ED Roma,,0,0,0,,докомадэ мо цузуитеру хошизора миагете утау
Dialogue: 0,0:22:57.48,0:23:11.57,ED Eng,,0,0,0,,Ән саламын, Түксіз жұлдызды түнге қарап.
Dialogue: 0,0:23:11.57,0:23:26.17,ED Roma,,0,0,0,,Кагириару бокутачи но эйен во юме миру әуені
Dialogue: 0,0:23:11.57,0:23:26.17,ED Eng,,0,0,0,,Түсіндегі әуен... шектеулі мәңгілігіміз туралы.
Dialogue: 0,0:23:26.17,0:23:33.26,ED Roma,,0,0,0,,mune ni afureru itoshisa no mizu wa
Dialogue: 0,0:23:26.17,0:23:33.26,ED Eng,,0,0,0,,Кеудемнен тасып жатқан бұл махаббат суы...
Dialogue: 0,0:23:33.26,0:23:40.23,ED Roma,,0,0,0,,mirai no hate de dareka ni todoku darou
Dialogue: 0,0:23:33.26,0:23:40.23,ED Eng,,0,0,0,,Қызық, болашақта біреуге жетеді ме?
Dialogue: 0,0:23:40.23,0:23:47.32,ED Roma,,0,0,0,,Шинджит ируйо
Dialogue: 0,0:23:40.23,0:23:47.32,ED Eng,,0,0,0,,Мен саған сенемін.
Dialogue: 0,0:23:47.32,0:23:54.37,ED Roma,,0,0,0,,харукана токи во каке нукете
Dialogue: 0,0:23:47.32,0:23:54.37,ED Eng,,0,0,0,,Ұрпақтардың уақыт аралығы...
Dialogue: 0,0:23:54.37,0:24:02.00,ED Roma,,0,0,0,,bokutachi no yobigoe wa itsuka ookina uta ni naru
Dialogue: 0,0:23:54.37,0:24:02.00,ED Eng,,0,0,0,,Қоңырауларымыз бір күні әсем әнге айналар ма?
Dialogue: 0,0:24:02.00,0:24:08.59,ED Roma,,0,0,0,,ai wo tsumuide юкеру йо
Dialogue: 0,0:24:02.00,0:24:08.59,ED Eng,,0,0,0,,Сіз өзіңіздің махаббатыңызды құра бастай аласыз,
Dialogue: 0,0:24:08.59,0:24:21.06,ED Roma,,0,0,0,,има ва мада коннани чиисана хикари дакедо
Dialogue: 0,0:24:08.59,0:24:21.06,ED Eng,,0,0,0,,Дәл қазір жарық әлі де әлсіз.
Dialogue: 0,0:24:24.98,0:24:39.99,Next title,,0,0,0,,Келесі эпизодты алдын ала қарау
Dialogue: 0,0:24:24.98,0:24:39.99,Next title,,0,0,0,,Лэдд Руссо ләззат алады
Dialogue: 0,0:24:24.98,0:24:39.99,Next title,,0,0,0,,Көп сөйлеп, көп сояды
Dialogue: 0,0:24:25.36,0:24:27.90,episode preview,,0,0,0,,Эй Исаак, сатсурику (сою) нені білдіреді?
Dialogue: 0,0:24:27.90,0:24:30.30,episode preview,,0,0,0,,Рику бөлігі тайрикудың (материктің) рикосы болуы керек.
Dialogue: 0,0:24:30.30,0:24:31.17,episode preview,,0,0,0,,Бұл жер, солай ма?
Dialogue: 0,0:24:31.17,0:24:32.83,episode preview,,0,0,0,,Ал сацу осацудың (банкноталардың) бөлігі болуы керек.
Dialogue: 0,0:24:32.83,0:24:33.79,episode preview,,0,0,0,,Бұл ақша, солай ма?!
Dialogue: 0,0:24:33.79,0:24:36.39,episode preview,,0,0,0,,Басқаша айтқанда, бұл банкноттардан жасалған жерді білдіруі керек!
Dialogue: 0,0:24:36.39,0:24:37.66,episode preview,,0,0,0,,Бұл өте қызық сияқты!
Dialogue: 0,0:24:37.66,0:24:39.99,episode preview,,0,0,0,,Бұл шынымен қызық сияқты!
Dialogue: 0,0:24:41.49,0:24:47.49,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory