Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:52.27,0:01:53.56,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:01:58.57,0:01:59.94,Default,,0,0,0,,О... Әй!
Dialogue: 0,0:02:20.34,0:02:21.71,Default,,0,0,0,,Грет
Dialogue: 0,0:02:21.97,0:02:24.43,Default,,0,0,0,,Сен ағаң үшін алаңдайсың ба?
Dialogue: 0,0:02:27.64,0:02:30.26,Default,,0,0,0,,Мен қорқамын мен қорқамын
Dialogue: 0,0:02:30.52,0:02:33.98,Default,,0,0,0,,Алхимик жынды шақырады...
Dialogue: 0,0:02:34.86,0:02:37.60,Default,,0,0,0,,Мұндай нәрсеге жол беріле ме?
Dialogue: 0,0:02:38.53,0:02:41.44,Default,,0,0,0,,Мәңгілік өмір немесе өлместік
Dialogue: 0,0:02:41.62,0:02:45.45,Default,,0,0,0,,Мұндай нәрсе адамдарға шынымен қажет пе?
Dialogue: 0,0:02:45.70,0:02:48.32,Default,,0,0,0,,Мен шынымен түсінбеймін.
Dialogue: 0,0:02:48.79,0:02:53.25,Default,,0,0,0,,Бірақ егер бұл ұлы панацеяның құпиясына жақындаудың жолы болса
Dialogue: 0,0:02:53.42,0:02:56.66,Default,,0,0,0,,Жарайды, көмектесуге болмайды... Ах...
Dialogue: 0,0:02:58.38,0:03:03.59,Default,,0,0,0,,Менің ойымша, мәңгілік өмір міндетті түрде керемет нәрсе емес.
Dialogue: 0,0:03:03.76,0:03:06.17,Default,,0,0,0,,Менің өмірім шектеулі болса да, Сильви...
Dialogue: 0,0:03:06.35,0:03:07.88,Default,,0,0,0,,Егер мен сенімен болсам
Dialogue: 0,0:03:08.89,0:03:12.26,Default,,0,0,0,,Бізге мәңгілік өмір берілсе де
Dialogue: 0,0:03:12.44,0:03:15.80,Default,,0,0,0,,Мен сенімен қорықпаймын
Dialogue: 0,0:03:16.27,0:03:17.64,Default,,0,0,0,,Сильви
Dialogue: 0,0:03:18.65,0:03:21.11,Default,,0,0,0,,Ондай адамды танисың ба? ?
Dialogue: 0,0:03:21.28,0:03:23.02,Default,,0,0,0,,Мизер-доно өте жақсы.
Dialogue: 0,0:03:23.20,0:03:27.57,Default,,0,0,0,,Егер алхимик жын шақырса, бұл ауыр бидғат!
Dialogue: 0,0:03:27.74,0:03:31.95,Default,,0,0,0,,Бір қызығы, сенің басқалардан артық білгің келеді.
Dialogue: 0,0:03:32.12,0:03:36.66,Default,,0,0,0,,Ұлы эликсир - алхимиктің арманы.
Dialogue: 0,0:03:37.21,0:03:40.58,Default,,0,0,0,,Шайтанның қолына түссе де
Dialogue: 0,0:03:40.76,0:03:42.50,Default,,0,0,0,,Адамзат тарихындағы өзгерістер
Dialogue: 0,0:03:42.68,0:03:44.88,Default,,0,0,0,,Ақсақ болуға шешім қабылдаса да!
Dialogue: 0,0:03:45.30,0:03:47.51,Default,,0,0,0,,Бірақ бұл шындық болса ше?
Dialogue: 0,0:03:47.68,0:03:51.72,Default,,0,0,0,,Мизер Синесиос пен Зосимоспен тең.
Dialogue: 0,0:03:51.89,0:03:54.35,Default,,0,0,0,,Ол ұлы алхимик болуы мүмкін.
Dialogue: 0,0:03:55.94,0:03:57.05,Default,,0,0,0,,Бәріміз күлейік!
Dialogue: 0,0:03:57.23,0:04:01.07,Default,,0,0,0,,Күлімсіре! Күлімсіре! Хахахахахахаха!
Dialogue: 0,0:04:01.78,0:04:03.86,Default,,0,0,0,,Қорқатын ештеңе жоқ
Dialogue: 0,0:04:04.11,0:04:05.35,Default,,0,0,0,,Huey
Dialogue: 0,0:04:05.91,0:04:09.15,Default,,0,0,0,,Ғажайыпты жүзеге асыруда
Dialogue: 0,0:04:09.33,0:04:12.29,Default,,0,0,0,,Төмендегі нәрсе жоғарыдағыға ұқсайды.
Dialogue: 0,0:04:12.46,0:04:16.67,Default,,0,0,0,,Жоғарыда не бар, төменде де солай
Dialogue: 0,0:04:16.84,0:04:20.79,Default,,0,0,0,,Ал барлық нәрсе Бірдің ойымен
Dialogue: 0,0:04:20.96,0:04:23.05,Default,,0,0,0,,Бірден
Dialogue: 0,0:04:23.22,0:04:27.63,Default,,0,0,0,,Барлық заттар бейімделу арқылы осыдан туды.
Dialogue: 0,0:04:27.80,0:04:29.42,Default,,0,0,0,,Әкеміз шашыңды көрсе, сені кешірмес еді.
Dialogue: 0,0:04:30.39,0:04:33.22,Default,,0,0,0,,Барлығы біреуге апарады, шеңбер жабылады
Dialogue: 0,0:04:33.44,0:04:37.39,Default,,0,0,0,,Біз ойлайтын шайтан міндетті түрде зұлым емес.
Dialogue: 0,0:04:37.56,0:04:40.98,Default,,0,0,0,,Алхимик қара магия саласымен айналысуға тырысады.
Dialogue: 0,0:04:41.15,0:04:43.23,Default,,0,0,0,,Барлығы бір нәрсеге әкеледі
Dialogue: 0,0:04:43.40,0:04:45.23,Default,,0,0,0,,Хьюи уайымдап тұрған жоқ па?
Dialogue: 0,0:04:45.53,0:04:47.57,Default,,0,0,0,,Мазасыздық? Жоқ, жоқ
Dialogue: 0,0:04:47.74,0:04:50.61,Default,,0,0,0,,Мен жай ғана қызықпын
Dialogue: 0,0:04:50.79,0:04:53.20,Default,,0,0,0,,Ібіліс те, ұлы эликсир де
Dialogue: 0,0:04:53.37,0:04:56.33,Default,,0,0,0,,Осының нәтижесінде адамдар қалай өзгереді және өмір сүреді?
Dialogue: 0,0:04:56.50,0:04:58.46,Default,,0,0,0,,Қызық
Dialogue: 0,0:04:58.63,0:05:00.49,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:05:01.80,0:05:03.33,Default,,0,0,0,,Хе... хе хе хе
Dialogue: 0,0:05:10.01,0:05:12.38,Default,,0,0,0,,Барлығын әкеле аласыз ба?
Dialogue: 0,0:05:12.64,0:05:16.30,Default,,0,0,0,,Тек оның киімдері түсіп жатыр; Пьер еш жерде көрінбеді.
Dialogue: 0,0:05:16.48,0:05:19.60,Default,,0,0,0,,Иро да! Иро да жоқ!
Dialogue: 0,0:05:20.23,0:05:22.14,Default,,0,0,0,,Хмм, сіз нені айтып тұрсыз?
Dialogue: 0,0:05:50.76,0:05:54.00,Default,,0,0,0,,Менің қазір не істемекшімін
Dialogue: 0,0:05:54.22,0:05:58.18,Default,,0,0,0,,Ал біз мұның дұрыс екенін білмейміз.
Dialogue: 0,0:05:58.35,0:06:03.14,Default,,0,0,0,,Мұны маған айтқан адам бұрын менің сыныптасым болған адам еді.
Dialogue: 0,0:06:04.53,0:06:09.69,Default,,0,0,0,,Ер атамнан бері қартайған емес.
Dialogue: 0,0:06:10.24,0:06:13.32,Default,,0,0,0,,300 жыл бұрын шайтанды шақыру
Dialogue: 0,0:06:13.74,0:06:17.33,Default,,0,0,0,,Өйткені мен үлкен панацеяға қол жеткіздім.
Dialogue: 0,0:06:17.96,0:06:22.50,Default,,0,0,0,,Ол кісі бүгінде бір жерде тірі болса керек.
Dialogue: 0,0:06:22.67,0:06:25.83,Default,,0,0,0,,Ешқашан қартаюға болмайды
Dialogue: 0,0:06:26.21,0:06:32.13,Default,,0,0,0,,Дегенмен, бұл біздің алхимиктің үлкен панацеяға жақындауға деген шын ниеті!
Dialogue: 0,0:06:32.55,0:06:35.80,Default,,0,0,0,,Мен жындарды шақырамын.
Dialogue: 0,0:06:39.19,0:06:41.43,Default,,0,0,0,,Ұтқаныңыздан ұтқаныңыз көп.
Dialogue: 0,0:06:41.61,0:06:45.77,Default,,0,0,0,,Алғаныңыз алғаныңыздан қымбат екеніне сеніңіз!
Dialogue: 0,0:06:45.94,0:06:50.15,Default,,0,0,0,,Бауырларым, мені соңына дейін бақылаңыздар.
Dialogue: 0,0:06:54.28,0:06:57.40,Default,,0,0,0,,Такуро Грет
Dialogue: 0,0:07:03.17,0:07:07.16,Default,,0,0,0,,Мен сізді осында шақырамын! Сіз аспан мен жерсіз!
Dialogue: 0,0:07:07.34,0:07:09.75,Default,,0,0,0,,Күн мен түн! Қараңғы және жарық!
Dialogue: 0,0:07:10.63,0:07:13.75,Default,,0,0,0,,Жақсылық пен жамандық! көруші және көруші
Dialogue: 0,0:07:14.55,0:07:17.72,Default,,0,0,0,,Жаратушы мен жойылушы!
Dialogue: 0,0:07:18.02,0:07:21.01,Default,,0,0,0,,Өзгелерді жақсы көріп, өзгені жек көретіндер! Сіз...
Dialogue: 0,0:07:21.19,0:07:22.60,Default,,0,0,0,,Бұл жеткілікті
Dialogue: 0,0:07:25.23,0:07:26.60,Default,,0,0,0,,Не болды! ?
Dialogue: 0,0:07:27.65,0:07:30.39,Default,,0,0,0,,Мен білмеймін! Бұл құбыжық! Мұнда бірдеңе бар!
Dialogue: 0,0:07:30.57,0:07:33.15,Default,,0,0,0,,Бұл шайтан! Әлгі жын-шайтан бас көтеріп жүрсе керек!
Dialogue: 0,0:07:33.57,0:07:37.19,Default,,0,0,0,,Сол Гретпен не болғанын білмейсің бе? ?
Dialogue: 0,0:07:38.41,0:07:40.07,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:07:43.79,0:07:48.08,Default,,0,0,0,,Көтермелеу сөздері манипуляциялық сөздерден басқа ештеңе емес.
Dialogue: 0,0:07:48.59,0:07:52.00,Default,,0,0,0,,Сөздеріңді тыңдаймын.
Dialogue: 0,0:07:52.18,0:07:55.63,Default,,0,0,0,,Мен сендердің не ойлайтындарыңды білемін.
Dialogue: 0,0:07:56.26,0:08:01.10,Default,,0,0,0,,Мен туралы ойласаң, мен бармын.
Dialogue: 0,0:08:01.27,0:08:03.05,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:08:03.44,0:08:06.14,Default,,0,0,0,,Менің атымды атаудың қажеті жоқ
Dialogue: 0,0:08:06.44,0:08:10.85,Default,,0,0,0,,Әу баста шайтан дегенге көңілім толмайды...
Dialogue: 0,0:08:11.19,0:08:12.93,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:08:13.95,0:08:17.66,Default,,0,0,0,,Қалай болғанда да, мен сендердің не ойлайтындарыңды білемін.
Dialogue: 0,0:08:17.83,0:08:20.57,Default,,0,0,0,,Сіз өлместік туралы бәрін білгіңіз келеді, солай ма?
Dialogue: 0,0:08:20.75,0:08:22.99,Default,,0,0,0,,Мен сізге тек айтамын
Dialogue: 0,0:08:23.16,0:08:27.03,Default,,0,0,0,,Сіз айтқан керемет панацеяны қалай жасауға болады
Dialogue: 0,0:08:27.21,0:08:28.79,Default,,0,0,0,,Неліктен мен?
Dialogue: 0,0:08:30.17,0:08:33.08,Default,,0,0,0,,Оны ішсең, өлмейтін боласың.
Dialogue: 0,0:08:33.26,0:08:34.62,Default,,0,0,0,,Жүр, іш.
Dialogue: 0,0:08:34.84,0:08:38.46,Default,,0,0,0,,Бәрін білгің келсе, алдымен іш.
Dialogue: 0,0:08:38.68,0:08:42.05,Default,,0,0,0,,Әй, қария, ерте өлгің келмейтін сияқты.
Dialogue: 0,0:08:42.18,0:08:43.17,Default,,0,0,0,,Фуфун
Dialogue: 0,0:08:43.35,0:08:47.01,Default,,0,0,0,,Бұл фарсты мүмкіндігінше тезірек аяқтайық.
Dialogue: 0,0:08:57.49,0:08:59.45,Default,,0,0,0,,Бұл алаяқтық емес пе?
Dialogue: 0,0:08:59.62,0:09:02.03,Default,,0,0,0,,Мен мұны істемесем, маған сене алмайсың ба?
Dialogue: 0,0:09:27.23,0:09:30.52,Default,,0,0,0,,Өлмейтіндікке қалай қарайсың, қария?
Dialogue: 0,0:09:42.87,0:09:47.95,Default,,0,0,0,,Сабыр ет, ұрыспа, мен жомартпын.
Dialogue: 0,0:09:48.12,0:09:52.87,Default,,0,0,0,,Бұл жерде қанша адам болса, сонша керемет эликсир бар.
Dialogue: 0,0:10:00.68,0:10:01.76,Default,,0,0,0,,Аға
Dialogue: 0,0:10:02.14,0:10:03.47,Default,,0,0,0,,Грет…
Dialogue: 0,0:10:18.53,0:10:21.24,Default,,0,0,0,,Кейбір ережелерді шешейік.
Dialogue: 0,0:10:22.20,0:10:26.82,Default,,0,0,0,,Өлмейтіндіктен шаршап, өлгің келсе ше?
Dialogue: 0,0:10:27.41,0:10:30.70,Default,,0,0,0,,Достарыңызға барып, тамақ ішулерін сұраудан тартынбаңыз.
Dialogue: 0,0:10:31.13,0:10:33.46,Default,,0,0,0,,Жеймін десең де, аузыңнан шықпайды.
Dialogue: 0,0:10:33.63,0:10:35.16,Default,,0,0,0,,Ишитеден
Dialogue: 0,0:10:35.42,0:10:41.29,Default,,0,0,0,,Басқа адамнан оң қолын басыңызға қойып, «Мен оны жегім келеді» деп ойлауын сұраңыз.
Dialogue: 0,0:10:41.47,0:10:43.93,Default,,0,0,0,,Тас қолға сорыласың.
Dialogue: 0,0:10:44.18,0:10:46.22,Default,,0,0,0,,Өмір аяқталды
Dialogue: 0,0:10:46.60,0:10:49.26,Default,,0,0,0,,Ал оны жеген адамдар
Dialogue: 0,0:10:49.44,0:10:54.93,Default,,0,0,0,,Сіз жеген адамдардың барлық білімі мен тәжірибесін мұра етесіз.
Dialogue: 0,0:10:56.19,0:11:01.53,Default,,0,0,0,,Керісінше, білім бергенде басқа адамның басына тас қолды қою.
Dialogue: 0,0:11:01.70,0:11:03.65,Default,,0,0,0,,Мұның бәрі бар.
Dialogue: 0,0:11:03.91,0:11:05.49,Default,,0,0,0,,Оған қоса, осы деңгейдегі қарғыс энергиясы…
Dialogue: 0,0:11:05.70,0:11:10.37,Default,,0,0,0,,Бұны ішкен адам енді жалған есім қолдана алмайды.
Dialogue: 0,0:11:11.12,0:11:14.71,Default,,0,0,0,,Өлмейтін жолдастар тек өздерінің шын есімдерін пайдаланып сөйлесе алады.
Dialogue: 0,0:11:14.88,0:11:16.29,Default,,0,0,0,,Әйтпесе
Dialogue: 0,0:11:16.46,0:11:21.00,Default,,0,0,0,,Сіз өзіңіздің серіктесіңізді мәңгі таба алмайсыз.
Dialogue: 0,0:11:21.18,0:11:24.92,Default,,0,0,0,,Ой, мен маңызды нәрсені ұмытып қалдым.
Dialogue: 0,0:11:25.10,0:11:28.21,Default,,0,0,0,,Осы дәріні қалай дайындау керектігін білгіңіз келсе
Dialogue: 0,0:11:28.39,0:11:31.68,Default,,0,0,0,,Мені шақырған адамнан сұраңыз.
Dialogue: 0,0:11:31.85,0:11:33.68,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:11:37.19,0:11:40.94,Default,,0,0,0,,Білімді бекітіңіз! ? Не айтып тұрсың, сараң?
Dialogue: 0,0:11:41.11,0:11:44.86,Default,,0,0,0,,Бұл менің түнде ойланып-толғанып, қорытынды жасағаным.
Dialogue: 0,0:11:45.03,0:11:49.12,Default,,0,0,0,,Мұны өзімізде сақтағанымыз жөн.
Dialogue: 0,0:11:49.29,0:11:50.49,Default,,0,0,0,,Олар әрекетке көшті, Эмилияны нысанаға алды.
Dialogue: 0,0:11:50.83,0:11:53.99,Default,,0,0,0,,Білім қауіпті болғандықтан қажет емес пе?
Dialogue: 0,0:11:54.46,0:11:59.08,Default,,0,0,0,,Серрадо мырза... Мен сен сияқты адамдарға сенбеймін.
Dialogue: 0,0:11:59.26,0:12:00.96,Default,,0,0,0,,Бұл ирониялық па?
Dialogue: 0,0:12:01.13,0:12:03.34,Default,,0,0,0,,Жоқ, бұл менің шынайы сезімім.
Dialogue: 0,0:12:03.68,0:12:07.17,Default,,0,0,0,,Қария, мен сараңның пікірімен келісемін.
Dialogue: 0,0:12:07.39,0:12:09.67,Default,,0,0,0,,Бұл жай ғана түсініксіз ой...
Dialogue: 0,0:12:09.85,0:12:11.43,Default,,0,0,0,,Не айтып тұрсың! ?
Dialogue: 0,0:12:12.60,0:12:15.97,Default,,0,0,0,,Осылайша мен өлмейтін болдым...
Dialogue: 0,0:12:16.15,0:12:18.76,Default,,0,0,0,,Мен мұны айтқаным өзгердім дегенді білдірмейді.
Dialogue: 0,0:12:18.94,0:12:19.93,Default,,0,0,0,,Әдеттегідей
Dialogue: 0,0:12:20.57,0:12:23.53,Default,,0,0,0,,Осылай өмір сүрсем де, өлмеймін, қартаймаймын.
Dialogue: 0,0:12:23.78,0:12:27.90,Default,,0,0,0,,Мен ешкімнен ештеңе ерекшеленбейтін сияқтымын.
Dialogue: 0,0:12:28.24,0:12:31.33,Default,,0,0,0,,Екінші жағынан, бұл мені қатты қайғыратын сияқты.
Dialogue: 0,0:12:31.50,0:12:34.20,Default,,0,0,0,,Мен бұл өте қызық болар еді деп ойлаймын.
Dialogue: 0,0:12:34.37,0:12:38.16,Default,,0,0,0,,Не болса да, бұл шынымен де бір нәрсе
Dialogue: 0,0:12:38.34,0:12:39.92,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:12:42.22,0:12:45.30,Default,,0,0,0,,Біз сияқты адамдар көп болмаса, жақсы деп ойлаймын.
Dialogue: 0,0:12:45.47,0:12:47.21,Default,,0,0,0,,Бұл мағынасы жоқ!
Dialogue: 0,0:12:47.55,0:12:50.04,Default,,0,0,0,,Білемін, бірақ сен қартайдың.
Dialogue: 0,0:12:50.52,0:12:53.88,Default,,0,0,0,,Менің айтқаным соншалықты алыс емес деп ойлаймын.
Dialogue: 0,0:12:54.06,0:12:55.52,Default,,0,0,0,,Мен оны интуитивті түрде сезінемін.
Dialogue: 0,0:12:55.69,0:12:56.77,Default,,0,0,0,,Ха!
Dialogue: 0,0:12:58.36,0:13:00.06,Default,,0,0,0,,Эльмерді қолдау
Dialogue: 0,0:13:00.23,0:13:02.22,Default,,0,0,0,,Сондықтан мен Мизер-дононың үкімін ұстанамын.
Dialogue: 0,0:13:02.40,0:13:03.86,Default,,0,0,0,,Қый!
Dialogue: 0,0:13:05.11,0:13:07.95,Default,,0,0,0,,Мен ағамның шешімін қолдаймын.
Dialogue: 0,0:13:08.24,0:13:10.57,Default,,0,0,0,,Мен де сараң мырзаның соңынан еремін.
Dialogue: 0,0:13:11.16,0:13:14.82,Default,,0,0,0,,Біліммен бөлісу кейінірек мүмкін болады
Dialogue: 0,0:13:15.00,0:13:19.46,Default,,0,0,0,,Қай жаққа бара жатқанымызды көру әлі де кеш емес.
Dialogue: 0,0:13:20.13,0:13:22.79,Default,,0,0,0,,Сараңның үкіміне байланысты
Dialogue: 0,0:13:23.63,0:13:25.92,Default,,0,0,0,,Ферма солай айтса, мен де солай айтамын...
Dialogue: 0,0:13:26.09,0:13:27.50,Default,,0,0,0,,Сараңға еріңіз
Dialogue: 0,0:13:28.39,0:13:29.75,Default,,0,0,0,,Мен де сараңмын
Dialogue: 0,0:13:31.89,0:13:33.25,Default,,0,0,0,,Күтуде
Dialogue: 0,0:13:35.35,0:13:39.89,Default,,0,0,0,,Бұл жерде бәріміз талқыласақ та қорытындыға келетін мәселе емес.
Dialogue: 0,0:13:40.06,0:13:43.90,Default,,0,0,0,,Оның үстіне, бұл көпшілік дауыспен шешілетін нәрсе емес.
Dialogue: 0,0:13:44.07,0:13:48.19,Default,,0,0,0,,Менің ойларым Эльмер мен Фермат сияқты.
Dialogue: 0,0:13:48.36,0:13:49.77,Default,,0,0,0,,Маған...
Dialogue: 0,0:13:50.16,0:13:54.28,Default,,0,0,0,,Ештеңені білмей өз пікірімді айта алмаймын.
Dialogue: 0,0:13:55.04,0:13:57.12,Default,,0,0,0,,Сондықтан мен оны уақытша тоқтатамын.
Dialogue: 0,0:13:57.33,0:13:59.16,Default,,0,0,0,,Қорытындыға қашан келеміз?
Dialogue: 0,0:13:59.33,0:14:03.20,Default,,0,0,0,,Қазір... 100 жылдан кейін немесе 200 жылдан кейін...
Dialogue: 0,0:14:03.71,0:14:08.63,Default,,0,0,0,,Қалай болғанда да, шешім қабылдауға әлі де кеш емес, солай ма?
Dialogue: 0,0:14:10.80,0:14:12.84,Default,,0,0,0,,Рахмет, ағайын
Dialogue: 0,0:14:13.10,0:14:16.64,Default,,0,0,0,,Сонда ұлы панацея туралы білім қандай?
Dialogue: 0,0:14:16.93,0:14:21.43,Default,,0,0,0,,Мен оны әзірге өзіме сақтаймын.
Dialogue: 0,0:14:25.82,0:14:26.85,Default,,0,0,0,,Грет?
Dialogue: 0,0:14:32.49,0:14:34.15,Default,,0,0,0,,Уф аа
Dialogue: 0,0:14:34.62,0:14:35.98,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:37.29,0:14:40.03,Default,,0,0,0,,Gret Мен өкінемін.
Dialogue: 0,0:14:40.21,0:14:43.95,Default,,0,0,0,,Өйткені, адамның білмеуі керек білімі бар.
Dialogue: 0,0:14:44.92,0:14:46.46,Default,,0,0,0,,Бұл қауіпті
Dialogue: 0,0:14:46.63,0:14:49.09,Default,,0,0,0,,Бір-бірін жек көретін адамдар арасында ғана емес
Dialogue: 0,0:14:49.30,0:14:51.84,Default,,0,0,0,,Бірін-бірі жақсы көргендердің де ұрысуына себеп болады
Dialogue: 0,0:14:52.39,0:14:54.72,Default,,0,0,0,,Бауырым, бұл нені білдіреді?
Dialogue: 0,0:14:54.89,0:14:57.63,Default,,0,0,0,,Негізі мен қазір абдырап тұрмын.
Dialogue: 0,0:14:58.18,0:15:00.85,Default,,0,0,0,,Серрадо жеу керек пе?
Dialogue: 0,0:15:01.35,0:15:04.60,Default,,0,0,0,,Мен және ол адам онша ерекшеленбейді.
Dialogue: 0,0:15:04.77,0:15:05.98,Default,,0,0,0,,Ағай...
Dialogue: 0,0:15:06.15,0:15:07.23,Default,,0,0,0,,Бірақ Грет
Dialogue: 0,0:15:08.36,0:15:10.82,Default,,0,0,0,,Өлмейтін болып кеткен ғажайып адам.
Dialogue: 0,0:15:10.99,0:15:14.53,Default,,0,0,0,,Бұл дүниеге бақыт пен ғажайыптар әкелетін адам болсаңыз...
Dialogue: 0,0:15:14.70,0:15:17.66,Default,,0,0,0,,Бұл білім баға жетпес құнды болады
Dialogue: 0,0:15:18.20,0:15:24.37,Default,,0,0,0,,Сондықтан Грет, мен қазір сендермен осы білімнің жартысымен бөлісемін.
Dialogue: 0,0:15:24.75,0:15:27.74,Default,,0,0,0,,Егер сіз осындай адамды кездестірсеңіз
Dialogue: 0,0:15:27.92,0:15:30.54,Default,,0,0,0,,Еш ойланбастан маған кел.
Dialogue: 0,0:15:30.80,0:15:34.59,Default,,0,0,0,,Мен ол кезде бұл дүниеде болмасам...
Dialogue: 0,0:15:34.76,0:15:41.10,Default,,0,0,0,,Осы жарты білім мен құдіретіңізбен дәрінің сырын біліңіз.
Dialogue: 0,0:15:41.56,0:15:45.65,Default,,0,0,0,,Тоқта... Ол жауапкершілік мен үшін тым үлкен.
Dialogue: 0,0:15:45.82,0:15:50.65,Default,,0,0,0,,Грет! Сіз бұл кемеде мен шынымен сене алатын жалғыз адамсыз.
Dialogue: 0,0:15:50.86,0:15:53.73,Default,,0,0,0,,Нағыз тазалық сенде ғана...
Dialogue: 0,0:15:54.45,0:15:56.19,Default,,0,0,0,,Мен оны қабылдағаныңызды қалаймын.
Dialogue: 0,0:15:56.53,0:15:58.78,Default,,0,0,0,,Бұл біздің тағдырымыз
Dialogue: 0,0:15:58.95,0:16:00.07,Default,,0,0,0,,Аға
Dialogue: 0,0:16:14.22,0:16:15.83,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:16.26,0:16:17.75,Default,,0,0,0,,Аға
Dialogue: 0,0:16:33.32,0:16:34.81,Default,,0,0,0,,Тоқта, сараң.
Dialogue: 0,0:16:37.24,0:16:38.48,Default,,0,0,0,,Элмер
Dialogue: 0,0:16:38.99,0:16:42.11,Default,,0,0,0,,Жоқ... бұл жақсы емес
Dialogue: 0,0:16:42.29,0:16:44.75,Default,,0,0,0,,Серрадо ақырында зиян келтіреді
Dialogue: 0,0:16:44.92,0:16:48.16,Default,,0,0,0,,Бір күні біреу бірін-бірі жей бастайды.
Dialogue: 0,0:16:48.34,0:16:50.50,Default,,0,0,0,,Бірақ сіз оны бастай алмайсыз.
Dialogue: 0,0:16:50.88,0:16:52.09,Default,,0,0,0,,Элмер
Dialogue: 0,0:16:53.13,0:16:54.34,Default,,0,0,0,,Күлейік сараң
Dialogue: 0,0:16:54.84,0:16:58.26,Default,,0,0,0,,Әлгі қарттың өзі де өзгеруі мүмкін.
Dialogue: 0,0:17:01.60,0:17:02.84,Default,,0,0,0,,Бұл...
Dialogue: 0,0:17:03.02,0:17:07.76,Default,,0,0,0,,Жас қызды мұндай жерде қалай жеуге болады?
Dialogue: 0,0:17:07.94,0:17:09.30,Default,,0,0,0,,Бұл сен едің
Dialogue: 0,0:17:09.73,0:17:13.15,Default,,0,0,0,,Менің жыныстық құштарлығым әлдеқашан таусылғанына сенімдімін...
Dialogue: 0,0:17:13.32,0:17:17.69,Default,,0,0,0,,Мен сені шақырған дауысты естимін...
Dialogue: 0,0:17:18.28,0:17:23.20,Default,,0,0,0,,Қарасам, әлгі жігіт саған ғашық болып қалған сияқты.
Dialogue: 0,0:17:23.37,0:17:25.86,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:17:26.04,0:17:29.33,Default,,0,0,0,,Тоқта... тоқтаңыз, өтінемін.
Dialogue: 0,0:17:29.50,0:17:31.99,Default,,0,0,0,,Gret Бұл жаза.
Dialogue: 0,0:17:32.17,0:17:35.66,Default,,0,0,0,,Бұл адам үлкен білімді монополиялауға тырысты.
Dialogue: 0,0:17:35.84,0:17:38.63,Default,,0,0,0,,Бұл бірінші кезекте қате болды.
Dialogue: 0,0:17:38.84,0:17:39.92,Default,,0,0,0,,Бұл мүмкін емес қой?
Dialogue: 0,0:17:40.05,0:17:42.47,Default,,0,0,0,,Сильви Мен көңілді жүрмін
Dialogue: 0,0:17:42.64,0:17:45.51,Default,,0,0,0,,Әрбір тәжірибе, әрбір білім
Dialogue: 0,0:17:45.69,0:17:47.52,Default,,0,0,0,,Әрбір тілек...
Dialogue: 0,0:17:47.69,0:17:52.35,Default,,0,0,0,,Өмірде ысырап жоқ, білу керек нәрсенің шегі жоқ.
Dialogue: 0,0:17:52.53,0:17:55.48,Default,,0,0,0,,Мен әлі де көбірек білгім келеді
Dialogue: 0,0:17:55.65,0:18:00.07,Default,,0,0,0,,Мен әлі тойған жоқпын, Сильви.
Dialogue: 0,0:18:00.24,0:18:03.40,Default,,0,0,0,,Сен... ол адамды жедің.
Dialogue: 0,0:18:03.74,0:18:08.86,Default,,0,0,0,,Сол кісінің інісі болып туылған тағдырға қарғыс.
Dialogue: 0,0:18:09.04,0:18:13.08,Default,,0,0,0,,Уайымдама, мен сені ішіме біріктіремін.
Dialogue: 0,0:18:13.25,0:18:14.37,Default,,0,0,0,,Тамағың жеткілікті болды!
Dialogue: 0,0:18:14.55,0:18:15.54,Default,,0,0,0,,Нуу
Dialogue: 0,0:18:23.60,0:18:25.81,Default,,0,0,0,,Сильви...
Dialogue: 0,0:18:30.98,0:18:33.72,Default,,0,0,0,,Сараң... Мен...
Dialogue: 0,0:18:34.94,0:18:37.18,Default,,0,0,0,,Серрадоны іздейік.
Dialogue: 0,0:18:37.36,0:18:39.60,Default,,0,0,0,,Сильви, сен ішкен жоқсың! ?
Dialogue: 0,0:18:39.74,0:18:40.73,Default,,0,0,0,,О...
Dialogue: 0,0:18:42.33,0:18:43.36,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:43.66,0:18:45.20,Default,,0,0,0,,Ніл, сен~
Dialogue: 0,0:18:45.37,0:18:48.78,Default,,0,0,0,,Мен қазір қатты ашуланып тұрмын.
Dialogue: 0,0:18:48.96,0:18:51.37,Default,,0,0,0,,Осы сезімді сөзбен жеткізуге батылдықпен қарайық
Dialogue: 0,0:18:51.58,0:18:52.66,Default,,0,0,0,,Һм? Ә… Не? Неге?
Dialogue: 0,0:19:00.76,0:19:01.80,Default,,0,0,0,,Сараң мырза
Dialogue: 0,0:19:05.26,0:19:07.80,Default,,0,0,0,,Сильви, жақсысың ба?
Dialogue: 0,0:19:08.18,0:19:10.18,Default,,0,0,0,,Олай болса бірге күлейік
Dialogue: 0,0:19:12.10,0:19:13.26,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:19:13.44,0:19:17.35,Default,,0,0,0,,Мен барып, кәрі Серрадоны сендіруге тырысамын.
Dialogue: 0,0:19:17.53,0:19:18.81,Default,,0,0,0,,Сендіру?
Dialogue: 0,0:19:19.07,0:19:21.44,Default,,0,0,0,,Сіз біреуді осылай сендіргіңіз келеді?
Dialogue: 0,0:19:21.74,0:19:23.82,Default,,0,0,0,,Мүмкіндік нөлге тең емес
Dialogue: 0,0:19:25.87,0:19:27.23,Default,,0,0,0,,Эльмер мырза!
Dialogue: 0,0:19:32.12,0:19:34.37,Default,,0,0,0,,Ойланып көріңізші, Серрадо мырза!
Dialogue: 0,0:19:34.79,0:19:37.21,Default,,0,0,0,,Енді ойланбаңыз, Серрадо мырза.
Dialogue: 0,0:19:38.46,0:19:40.75,Default,,0,0,0,,Сәлем! Серрадоның атасы!
Dialogue: 0,0:19:41.13,0:19:43.04,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:19:43.18,0:19:44.17,Default,,0,0,0,,Ой! Ол аурады!
Dialogue: 0,0:19:44.30,0:19:45.29,Default,,0,0,0,,Эльмер!
Dialogue: 0,0:19:45.43,0:19:47.17,Default,,0,0,0,,Мызаааааааааааааааааааааааааааааа
Dialogue: 0,0:19:55.73,0:19:56.81,Default,,0,0,0,,Эльмер!
Dialogue: 0,0:20:00.99,0:20:06.48,Default,,0,0,0,,Әлгі қарттың назарын аудару үшін мұндай әрекетке барарыңа сенбеймін...
Dialogue: 0,0:20:06.66,0:20:10.99,Default,,0,0,0,,Сіз біртүрлі адамсыз... Қызық...
Dialogue: 0,0:20:11.21,0:20:14.54,Default,,0,0,0,,Мен сенің бір тілегіңді орындаймын
Dialogue: 0,0:20:15.25,0:20:17.99,Default,,0,0,0,,Бұл араб жынына ұқсайды.
Dialogue: 0,0:20:18.25,0:20:23.29,Default,,0,0,0,,Алайда менде үш емес, бір ғана тілек бар.
Dialogue: 0,0:20:24.09,0:20:26.96,Default,,0,0,0,,Жарайды, мен шештім, шайтан.
Dialogue: 0,0:20:30.56,0:20:31.80,Default,,0,0,0,,Эльмер мырза!
Dialogue: 0,0:20:33.27,0:20:34.98,Default,,0,0,0,,Амансың ба? Элмер мырза!
Dialogue: 0,0:20:35.15,0:20:36.89,Default,,0,0,0,,Серрадоның атасы кім?
Dialogue: 0,0:20:37.06,0:20:41.35,Default,,0,0,0,,Мен теңізге құлап қалдым, ондай жағдайда қайтып келе алмайтын шығармын.
Dialogue: 0,0:20:41.57,0:20:45.31,Default,,0,0,0,,Мен сендіруге орын бар деп ойладым.
Dialogue: 0,0:20:45.70,0:20:46.73,Default,,0,0,0,,Сильви
Dialogue: 0,0:20:48.12,0:20:49.73,Default,,0,0,0,,Сіз осындай уақытта не істейсіз?
Dialogue: 0,0:20:50.12,0:20:53.16,Default,,0,0,0,,Бұл күлімсіреу. Бұл күлімсіреу, Сильви.
Dialogue: 0,0:20:54.29,0:20:55.41,Default,,0,0,0,,Элмер мырза
Dialogue: 0,0:20:55.58,0:20:56.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:58.63,0:21:01.66,Default,,0,0,0,,Мүмкіндік нөлге тең деп ойладым.
Dialogue: 0,0:21:06.05,0:21:07.67,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:21:08.43,0:21:11.22,Default,,0,0,0,,Мен әлі бас тартқан жоқпын.
Dialogue: 0,0:21:24.95,0:21:25.93,Default,,0,0,0,,Грет…
Dialogue: 0,0:21:27.28,0:21:29.74,Default,,0,0,0,,Мен мұны ерте басталады деп ойламадым.
Dialogue: 0,0:21:29.91,0:21:34.95,Default,,0,0,0,,Мен арандатқан сияқтымын, бірақ адам баласы өте сараң.
Dialogue: 0,0:21:35.29,0:21:37.62,Default,,0,0,0,,Маған неге қоңырау шаласың?
Dialogue: 0,0:21:37.79,0:21:39.95,Default,,0,0,0,,Өйткені сіз сонда болдыңыз
Dialogue: 0,0:21:40.13,0:21:45.29,Default,,0,0,0,,Биік жерлерден ләззат алуды шешкен бір-бірімізбен тіл табысайық.
Dialogue: 0,0:21:45.51,0:21:47.97,Default,,0,0,0,,Мен жай ғана қызықпын.
Dialogue: 0,0:21:48.47,0:21:52.43,Default,,0,0,0,,Сен де солайсың... Жарайды.
Dialogue: 0,0:21:52.60,0:21:54.96,Default,,0,0,0,,Осы жолы болар деп ойладым.
Dialogue: 0,0:21:55.94,0:21:57.47,Default,,0,0,0,,Мен есімде сақтамасам да,
Dialogue: 0,0:21:57.73,0:21:58.97,Default,,0,0,0,,Бөлек
Dialogue: 0,0:21:59.31,0:22:02.35,Default,,0,0,0,,Бұл кішкентай ғана сезім.
Dialogue: 0,0:22:02.53,0:22:05.48,Default,,0,0,0,,Олар бізден бірдеңе күткендей.
Dialogue: 0,0:22:06.20,0:22:08.40,Default,,0,0,0,,Иә, асықпа.
Dialogue: 0,0:22:08.57,0:22:12.57,Default,,0,0,0,,Біз бәрібір бұдан былай ұзақ мерзімді қарым-қатынаста боламыз.
Dialogue: 0,0:22:12.95,0:22:16.07,Default,,0,0,0,,Тағы да кездесуге мүмкіндік болады.
Dialogue: 0,0:22:17.54,0:22:19.08,Default,,0,0,0,,А... Иә
Dialogue: 0,0:22:19.42,0:22:22.12,Default,,0,0,0,,Руноратаға жау ретінде ие болу қиын.
Dialogue: 0,0:22:22.34,0:22:26.71,Default,,0,0,0,,Густаво деген адамның қорқатын жері жоқ па?
Dialogue: 0,0:22:26.88,0:22:31.09,Default,,0,0,0,,Түсіндім, онда ұшқындарды сейілту керек.
Dialogue: 0,0:22:31.26,0:22:33.25,Default,,0,0,0,,Бұл араласпау жақсы дегенді білдіреді.
Dialogue: 0,0:22:33.43,0:22:35.64,Default,,0,0,0,,Менде ешқандай мәселе жоқ деп ойлаймын
Dialogue: 0,0:22:42.90,0:22:48.48,Default,,0,0,0,,Сараң... Мен Серрадоның барын дәл сол жерде сезінемін...
Dialogue: 0,0:22:48.70,0:22:51.44,Default,,0,0,0,,Сіз ештеңе сезбейсіз бе?
Dialogue: 0,0:22:52.37,0:22:54.11,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:22:55.61,0:23:01.61,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory