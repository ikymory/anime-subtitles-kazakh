Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.54,0:00:04.21,Default,,0,0,0,,♪～
Dialogue: 0,0:01:26.58,0:01:28.42,Default,,0,0,0,,～♪
Dialogue: 0,0:01:32.17,0:01:35.47,Default,,0,0,0,,Ай!
Dialogue: 0,0:01:38.01,0:01:41.22,Default,,0,0,0,,Бұл жай ғана басқа жағдай.
Dialogue: 0,0:01:41.35,0:01:45.85,Default,,0,0,0,,Нағыз өлтіруші осы ма деп ойлаймын.
Dialogue: 0,0:01:45.98,0:01:49.10,Default,,0,0,0,,Оның кеткен жолын қараңыз.
Dialogue: 0,0:01:49.23,0:01:52.44,Default,,0,0,0,,Ештеңеге тұрмайтын сияқтымыз.
Dialogue: 0,0:01:52.57,0:01:54.82,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:01:59.36,0:02:00.62,Default,,0,0,0,,Бірдеңе айт!
Dialogue: 0,0:02:00.74,0:02:02.83,Default,,0,0,0,,Сіз соншалықты мұқият болған шығарсыз!
Dialogue: 0,0:02:02.95,0:02:05.37,Default,,0,0,0,,Бұлай істеме, сонда шаш болады.
Dialogue: 0,0:02:05.91,0:02:08.37,Default,,0,0,0,,Шаш? Әй, мен қалағанымша саламын.
Dialogue: 0,0:02:08.50,0:02:10.88,Default,,0,0,0,,Ол лас, құм мен қоқысқа толы...
Dialogue: 0,0:02:11.00,0:02:12.71,Default,,0,0,0,,Аузыңыз тым ыстық
Dialogue: 0,0:02:13.05,0:02:14.21,Default,,0,0,0,,Е... а...
Dialogue: 0,0:02:14.59,0:02:15.67,Default,,0,0,0,,Гррр…
Dialogue: 0,0:02:19.34,0:02:23.18,Default,,0,0,0,,Қайтып оралғанда не істейсің? Казино немесе алкоголь?
Dialogue: 0,0:02:23.89,0:02:24.89,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:25.31,0:02:26.18,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:02:26.52,0:02:30.06,Default,,0,0,0,,Артық ештеңе айтпа. Бұл екеуі. Жақсы!
Dialogue: 0,0:02:30.19,0:02:31.19,Default,,0,0,0,,О!
Dialogue: 0,0:02:31.69,0:02:33.19,Default,,0,0,0,,Бұл күріш.
Dialogue: 0,0:02:35.82,0:02:37.19,Default,,0,0,0,,Мен аш емеспін.
Dialogue: 0,0:02:38.45,0:02:40.28,Default,,0,0,0,,Сәлем! Рұқсатсыз кезбеңіз
Dialogue: 0,0:02:40.41,0:02:44.20,Default,,0,0,0,,Ішіп алғаннан кейін мен кетемін. Мен қалаға қайтамын!
Dialogue: 0,0:02:44.49,0:02:45.45,Default,,0,0,0,,Мені қайтар
Dialogue: 0,0:02:45.58,0:02:48.21,Default,,0,0,0,,Басыңды суытқан дұрыс.
Dialogue: 0,0:02:48.50,0:02:50.21,Default,,0,0,0,,Бұл да дұрыс.
Dialogue: 0,0:02:50.54,0:02:52.67,Default,,0,0,0,,Сұлулық – улану.
Dialogue: 0,0:02:52.79,0:02:56.21,Default,,0,0,0,,Көрген уы, естіген уы, қалғаны уы, қуғаны уы.
Dialogue: 0,0:02:56.71,0:02:59.22,Default,,0,0,0,,Үшеуің де түсінбейсіңдер.
Dialogue: 0,0:02:59.97,0:03:00.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:00.88,0:03:03.97,Default,,0,0,0,,Төртеуі де түсінбегендерін айтты.
Dialogue: 0,0:03:04.51,0:03:06.47,Default,,0,0,0,,Уф, мен де?
Dialogue: 0,0:03:13.77,0:03:14.65,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:03:18.11,0:03:20.11,Default,,0,0,0,,Иә? иә? иә?
Dialogue: 0,0:03:20.24,0:03:22.61,Default,,0,0,0,,(тышқан жылайды)
Dialogue: 0,0:03:24.37,0:03:27.12,Default,,0,0,0,,Жылама! Менің көзім жыпылықтайды!
Dialogue: 0,0:03:27.99,0:03:31.04,Default,,0,0,0,,Сіз сондай сұмдық жерде тұра аласыз.
Dialogue: 0,0:03:31.16,0:03:32.62,Default,,0,0,0,,Денсаулыққа зияны сөзсіз.
Dialogue: 0,0:03:32.75,0:03:35.09,Default,,0,0,0,,(Егеуқұйрықтар тобының дыбысы)
Dialogue: 0,0:03:35.63,0:03:37.21,Default,,0,0,0,,Барған сайын ақымақ болып барады.
Dialogue: 0,0:03:37.34,0:03:39.76,Default,,0,0,0,,Сіз не ойлап отырсыз?
Dialogue: 0,0:03:41.22,0:03:43.43,Default,,0,0,0,,Иә? Балалар сендер қандайсыңдар?
Dialogue: 0,0:03:43.55,0:03:45.80,Default,,0,0,0,,Мен оны түсінбеймін. Мен оны мүлдем түсінбеймін!
Dialogue: 0,0:03:48.39,0:03:49.81,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:03:50.85,0:03:53.90,Default,,0,0,0,,Мен ештеңе білмеймін, мен ештеңе білмеймін
Dialogue: 0,0:03:54.44,0:03:59.99,Default,,0,0,0,,Сонымен теңіздің иісі мен көзімдегі ауру сезімі мен үшін жаңалық болды.
Dialogue: 0,0:04:00.57,0:04:02.95,Default,,0,0,0,,Мен қорқақтан бірінші рет таяқ жеуім.
Dialogue: 0,0:04:03.45,0:04:06.87,Default,,0,0,0,,Менің ойымша, бұл қорқынышты және қорқынышты.
Dialogue: 0,0:04:08.45,0:04:12.25,Default,,0,0,0,,Маған бірінші рет ұнамайды.
Dialogue: 0,0:04:13.54,0:04:15.79,Default,,0,0,0,,Иә? Не айтқың келеді?
Dialogue: 0,0:04:15.92,0:04:19.09,Default,,0,0,0,,Берілістерді не қозғайды?
Dialogue: 0,0:04:19.38,0:04:22.09,Default,,0,0,0,,Сол әдемі әйелмен «жыныстық қатынаста болыңыз», солай ма?
Dialogue: 0,0:04:22.51,0:04:25.30,Default,,0,0,0,,Сен шынымен арсыз екенсің, сиыр.
Dialogue: 0,0:04:25.43,0:04:28.18,Default,,0,0,0,,А? Сіз маған бұл басқаша деп айтуға тырысасыз ба?
Dialogue: 0,0:04:28.31,0:04:30.35,Default,,0,0,0,,Ешқандай айырмашылық жоқ.
Dialogue: 0,0:04:30.47,0:04:33.73,Default,,0,0,0,,Либидо күлкілі, бірақ тәтті
Dialogue: 0,0:04:34.39,0:04:36.56,Default,,0,0,0,,Бұл бәрі емес.
Dialogue: 0,0:04:37.23,0:04:42.07,Default,,0,0,0,,Мен ештеңе істей алмай қалаға қайтамын деп ойладым.
Dialogue: 0,0:04:42.57,0:04:44.07,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:04:44.74,0:04:49.08,Default,,0,0,0,,Әжем мен әпкелерімді уайымдатқаным өзімшілдік пе?
Dialogue: 0,0:04:49.58,0:04:53.00,Default,,0,0,0,,Дұрыс, мен де аюды ұнатпаймын.
Dialogue: 0,0:04:53.33,0:04:56.79,Default,,0,0,0,,Менің де жарақат алғым келмейді.
Dialogue: 0,0:04:59.09,0:05:01.34,Default,,0,0,0,,Ах! қазірдің өзінде!
Dialogue: 0,0:05:12.56,0:05:15.44,Default,,0,0,0,,Сол себепті жыламайсың.
Dialogue: 0,0:05:27.78,0:05:28.99,Default,,0,0,0,,Сіз өзіңізді қандай кейіпке келтіресіз?
Dialogue: 0,0:05:29.41,0:05:31.12,Default,,0,0,0,,Жасандылық жасамау
Dialogue: 0,0:05:31.24,0:05:33.41,Default,,0,0,0,,Бұл тамақ деп аталады.
Dialogue: 0,0:05:33.79,0:05:37.50,Default,,0,0,0,,Бұл пісірілген жұмыртқа қосылған салат. Ләззат алыңыз.
Dialogue: 0,0:05:37.79,0:05:39.63,Default,,0,0,0,,Бұл жұмыртқалар мен көкөністер
Dialogue: 0,0:05:39.75,0:05:41.88,Default,,0,0,0,,Бұл менің фермамнан.
Dialogue: 0,0:05:42.00,0:05:43.00,Default,,0,0,0,,Ферма?
Dialogue: 0,0:05:43.38,0:05:45.72,Default,,0,0,0,,Иә Жерді залалсыздандырыңыз
Dialogue: 0,0:05:45.84,0:05:51.51,Default,,0,0,0,,Топырақты жуып, компост қосқаннан кейін біз 600 000 ярдты қамтамасыз еттік.
Dialogue: 0,0:05:52.10,0:05:53.68,Default,,0,0,0,,Бұл қабырғалар да қуырылады
Dialogue: 0,0:05:53.81,0:05:55.18,Default,,0,0,0,,Сіз ше?
Dialogue: 0,0:05:55.31,0:05:56.52,Default,,0,0,0,,Иә
Dialogue: 0,0:05:56.81,0:05:59.02,Default,,0,0,0,,Бүгінгі күн ерекше
Dialogue: 0,0:06:00.52,0:06:03.02,Default,,0,0,0,,Шарап - болашақ сынақ
Dialogue: 0,0:06:04.11,0:06:06.11,Default,,0,0,0,,Ақырында өзіңіз жасауды жоспарлайсыз ба?
Dialogue: 0,0:06:06.24,0:06:07.95,Default,,0,0,0,,Анау ферма немесе басқасы.
Dialogue: 0,0:06:08.07,0:06:09.53,Default,,0,0,0,,Әлі де менің соңымнан келесің бе?
Dialogue: 0,0:06:09.82,0:06:14.37,Default,,0,0,0,,Менің бір қойым бар. Бет-аузы, аяғы қара жігіт екен.
Dialogue: 0,0:06:14.49,0:06:16.08,Default,,0,0,0,,Мен Каролина Рейпермін!
Dialogue: 0,0:06:22.84,0:06:23.88,Default,,0,0,0,,Бұл шынайы
Dialogue: 0,0:06:24.80,0:06:28.88,Default,,0,0,0,,Елорданың өзінде мұндай тамаққа қалтасы көтеретіндер көп емес.
Dialogue: 0,0:06:29.38,0:06:31.14,Default,,0,0,0,,Сіз не жоспарлап отырсыз?
Dialogue: 0,0:06:31.39,0:06:34.14,Default,,0,0,0,,Ашық айтсақ, бұл мәміле.
Dialogue: 0,0:06:34.72,0:06:39.14,Default,,0,0,0,,Бізді сенен кейін келетін біреу жалдады.
Dialogue: 0,0:06:39.60,0:06:43.65,Default,,0,0,0,,Біреу сені де таспа іздеп келуіңді өтінді.
Dialogue: 0,0:06:44.27,0:06:46.94,Default,,0,0,0,,Содан кейін сөмкеңізде «біреу» бар
Dialogue: 0,0:06:47.07,0:06:49.65,Default,,0,0,0,,Біз тікелей бизнес жүргізу туралы айтып отырмыз.
Dialogue: 0,0:06:50.03,0:06:52.16,Default,,0,0,0,,Маңыздысы ақша!
Dialogue: 0,0:06:52.28,0:06:54.03,Default,,0,0,0,,Ақша маңызды!
Dialogue: 0,0:06:54.16,0:06:55.16,Default,,0,0,0,,Ақша жақсы
Dialogue: 0,0:06:55.49,0:06:58.75,Default,,0,0,0,,Арасында адам аз болса, соғұрлым жақсы.
Dialogue: 0,0:06:59.25,0:07:00.92,Default,,0,0,0,,Сол ферма үшін?
Dialogue: 0,0:07:01.21,0:07:02.46,Default,,0,0,0,,бұл дұрыс
Dialogue: 0,0:07:02.58,0:07:06.92,Default,,0,0,0,,Китмен болу уақытша ғана жұмыс. Сіздің жұмыс берушімен өтемақы үшін ғана қарым-қатынасыңыз бар.
Dialogue: 0,0:07:07.30,0:07:11.05,Default,,0,0,0,,Ол кісі өлтірушілер рейтингінде бірінші орында.
Dialogue: 0,0:07:12.51,0:07:16.35,Default,,0,0,0,,Маған сіздің жұмыс берушінің кім екені де маңызды емес.
Dialogue: 0,0:07:16.47,0:07:17.93,Default,,0,0,0,,Шарт бұзылса
Dialogue: 0,0:07:18.06,0:07:20.10,Default,,0,0,0,,Өзімізді тұншықтырып өлтірмейміз бе?
Dialogue: 0,0:07:20.23,0:07:23.69,Default,,0,0,0,,Сондықтан біз тікелей сауда жасамаймыз.
Dialogue: 0,0:07:24.02,0:07:29.19,Default,,0,0,0,,Тазалау жұмыстарын сенің жаныңдағы біреу атқарады.
Dialogue: 0,0:07:29.69,0:07:31.70,Default,,0,0,0,,Бұл жаман оқиға емес.
Dialogue: 0,0:07:31.82,0:07:33.24,Default,,0,0,0,,Біз ақшамыз
Dialogue: 0,0:07:33.37,0:07:34.91,Default,,0,0,0,,Сіз қауіпсізсіз
Dialogue: 0,0:07:35.03,0:07:37.20,Default,,0,0,0,,Бұл мүлдем жаман оқиға емес.
Dialogue: 0,0:07:37.66,0:07:42.21,Default,,0,0,0,,Иә десеңіз, жағдай оңай өзгереді.
Dialogue: 0,0:07:42.33,0:07:45.71,Default,,0,0,0,,Иә иә хмм
Dialogue: 0,0:07:42.75,0:07:44.54,Default,,0,0,0,,Сонымен, ол жұмыс істей ме?
Dialogue: 0,0:07:44.67,0:07:47.34,Default,,0,0,0,,Күтпеген жағдайлар орын алуы мүмкін.
Dialogue: 0,0:07:47.46,0:07:48.46,Default,,0,0,0,,басқа біреудің ұялы телефоны қоңырау шалғанда шыдай алмаймын.
Dialogue: 0,0:07:48.76,0:07:51.47,Default,,0,0,0,,Сол кешегі жігіттер
Dialogue: 0,0:07:51.80,0:07:53.18,Default,,0,0,0,,(Қыңқыл) Бірақ қазір менде қорқыныштың бір ұшқыны да жоқ
Dialogue: 0,0:07:53.30,0:07:54.97,Default,,0,0,0,,Әрине күтпеген
Dialogue: 0,0:07:55.68,0:07:58.35,Default,,0,0,0,,Жарайды, мен сізбен байланысуға тырысамын.
Dialogue: 0,0:07:58.47,0:08:00.85,Default,,0,0,0,,Бірақ келіссөздерді сонда жүргізіңіз.
Dialogue: 0,0:08:00.98,0:08:01.98,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:08:02.35,0:08:05.15,Default,,0,0,0,,Менің орналасқан жерім туралы хабардар болдым.
Dialogue: 0,0:08:05.27,0:08:06.77,Default,,0,0,0,,Сіз қашып кете алмайсыз.
Dialogue: 0,0:08:08.27,0:08:09.98,Default,,0,0,0,,Тамақтан кейінгі кофе
Dialogue: 0,0:08:11.70,0:08:13.99,Default,,0,0,0,,Менің үйге барғым келмейді
Dialogue: 0,0:08:14.41,0:08:19.49,Default,,0,0,0,,Менде қызметтік кілт жоқ, сондықтан мен қаруды немесе ештеңені өз бетімше пайдалана алмаймын.
Dialogue: 0,0:08:21.25,0:08:23.21,Default,,0,0,0,,Мен қоқыс тастадым ба?
Dialogue: 0,0:08:23.54,0:08:26.58,Default,,0,0,0,,Қоқыстан да аз. Қоқысты қайта пайдалануға болады.
Dialogue: 0,0:08:27.29,0:08:28.25,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:30.00,0:08:31.59,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:08:32.67,0:08:33.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:35.01,0:08:37.93,Default,,0,0,0,,«Ұлы зұлым лордтың қашу тарихы»
Dialogue: 0,0:08:38.85,0:08:39.81,Default,,0,0,0,,Жүктеме
Dialogue: 0,0:08:40.52,0:08:43.64,Default,,0,0,0,,Оның сезімін түсінудің де қажеті жоқ.
Dialogue: 0,0:08:43.98,0:08:46.27,Default,,0,0,0,,Түсіндім, түсінемін.
Dialogue: 0,0:08:46.40,0:08:48.23,Default,,0,0,0,,Артында бірдеңе қалдырсаңыз да
Dialogue: 0,0:08:48.36,0:08:50.40,Default,,0,0,0,,Бірдеңе істеуге тура келетін кездер болады, солай ма?
Dialogue: 0,0:08:50.73,0:08:51.90,Default,,0,0,0,,Иә Иә~
Dialogue: 0,0:08:52.36,0:08:53.57,Default,,0,0,0,,Мен де.
Dialogue: 0,0:08:53.70,0:08:56.24,Default,,0,0,0,,Өмір атты ұзақ жолда
Dialogue: 0,0:08:58.37,0:08:59.58,Default,,0,0,0,,Мен қанша маңызды нәрселерден бас тарттым?
Dialogue: 0,0:08:59.70,0:09:00.79,Default,,0,0,0,,Бұл келді!
Dialogue: 0,0:09:01.24,0:09:02.91,Default,,0,0,0,,Сіз мені тыңдап тұрсыз ба?
Dialogue: 0,0:09:03.33,0:09:06.12,Default,,0,0,0,,Кума, сен 4 жаста емессің бе?
Dialogue: 0,0:09:06.46,0:09:09.59,Default,,0,0,0,,Уф...жылдар жас емес.
Dialogue: 0,0:09:09.71,0:09:12.09,Default,,0,0,0,,ше? Сіз не айттыңыз? Ақымақ болма!
Dialogue: 0,0:09:09.88,0:09:10.75,Default,,0,0,0,,Уф!
Dialogue: 0,0:09:12.21,0:09:13.26,Default,,0,0,0,,Сәлем қара! Мынаны қара!
Dialogue: 0,0:09:13.38,0:09:14.22,Default,,0,0,0,,Әй?
Dialogue: 0,0:09:14.63,0:09:16.13,Default,,0,0,0,,Не болды, Gear?
Dialogue: 0,0:09:16.47,0:09:18.14,Default,,0,0,0,,Бұл жол!
Dialogue: 0,0:09:19.14,0:09:21.35,Default,,0,0,0,,Мен болмашы нәрсе таптым.
Dialogue: 0,0:09:21.47,0:09:23.14,Default,,0,0,0,,«Готчаның» спин-оффы?
Dialogue: 0,0:09:23.60,0:09:25.27,Default,,0,0,0,,Ондай нәрсе бар ма?
Dialogue: 0,0:09:25.39,0:09:28.65,Default,,0,0,0,,Оны сұлулық лентасы деп атайды, оның біртүрлі қатысы бар.
Dialogue: 0,0:09:29.02,0:09:32.32,Default,,0,0,0,,Мұны сол таспа сияқты ойнатуға бола ма?
Dialogue: 0,0:09:32.44,0:09:33.53,Default,,0,0,0,,Сіз мұны істей аласыз.
Dialogue: 0,0:09:33.65,0:09:35.40,Default,,0,0,0,,-Ха! -Қалай?
Dialogue: 0,0:09:36.86,0:09:38.57,Default,,0,0,0,,Мен оны осында қоюым керек пе?
Dialogue: 0,0:09:43.12,0:09:44.58,Default,,0,0,0,,(проектордың айналу дыбысы)
Dialogue: 0,0:09:44.70,0:09:46.92,Default,,0,0,0,,(Ашық музыка)
Dialogue: 0,0:09:47.04,0:09:49.58,Default,,0,0,0,,Ха! Бұл жол!
Dialogue: 0,0:09:50.04,0:09:53.92,Default,,0,0,0,,Мен Лорд, әлемдегі ең үлкен зұлым адаммын.
Dialogue: 0,0:09:54.05,0:09:57.80,Default,,0,0,0,,Менің атымды естігенде үлкендер де, балалар да қалтырап қалады.
Dialogue: 0,0:09:54.05,0:09:55.09,Default,,0,0,0,,(полиция көлігінің сиренасы)
Dialogue: 0,0:09:57.93,0:09:59.22,Default,,0,0,0,,Зәр шығару
Dialogue: 0,0:09:59.34,0:10:00.39,Default,,0,0,0,,Уа, Раббым
Dialogue: 0,0:10:00.51,0:10:02.43,Default,,0,0,0,,Ол бірден келді.
Dialogue: 0,0:10:03.35,0:10:06.39,Default,,0,0,0,,Полис? Уайымдайтын ештеңе жоқ
Dialogue: 0,0:10:06.52,0:10:09.27,Default,,0,0,0,,Біздің көлігіміз әлемдегі ең жылдам
Dialogue: 0,0:10:09.40,0:10:10.48,Default,,0,0,0,,(қозғалтқыш шуының жоғарылауы)
Dialogue: 0,0:10:11.94,0:10:13.11,Default,,0,0,0,,Жоқ, дәл алдында!
Dialogue: 0,0:10:15.49,0:10:16.78,Default,,0,0,0,,Қауіпті жол!
Dialogue: 0,0:10:16.90,0:10:20.20,Default,,0,0,0,,Мен сені бұл жерден ешқашан өткізбеймін!
Dialogue: 0,0:10:20.32,0:10:22.70,Default,,0,0,0,,Маған қашып кетуге рұқсат етесіз бе, үлкен зұлым мырза!
Dialogue: 0,0:10:22.95,0:10:24.45,Default,,0,0,0,,Мен өтемін.
Dialogue: 0,0:10:25.04,0:10:27.33,Default,,0,0,0,,Жақсы жұмыс хахахаха...
Dialogue: 0,0:10:27.46,0:10:29.17,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:10:29.58,0:10:30.42,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:32.29,0:10:33.42,Default,,0,0,0,,мотивацияң — мүлде басқаша болады ғой?
Dialogue: 0,0:10:33.63,0:10:34.67,Default,,0,0,0,,Киотодан келген вице-канцлер де сол жоғары лауазымды тұлғалардың бірі ғой, иә?
Dialogue: 0,0:10:34.80,0:10:36.13,Default,,0,0,0,,Хахахахаха
Dialogue: 0,0:10:36.55,0:10:37.84,Default,,0,0,0,,Ухммм… ммм…
Dialogue: 0,0:10:38.22,0:10:39.13,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:39.26,0:10:40.59,Default,,0,0,0,,(Бейнені үзу дыбысы)
Dialogue: 0,0:10:39.84,0:10:40.59,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:41.43,0:10:43.01,Default,,0,0,0,,Не болды? Не болды?
Dialogue: 0,0:10:43.14,0:10:45.52,Default,,0,0,0,,-Оро Ороророро -Таспа!
Dialogue: 0,0:10:46.10,0:10:48.23,Default,,0,0,0,,А, бұл енді жақсы емес.
Dialogue: 0,0:10:48.35,0:10:49.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:50.19,0:10:54.07,Default,,0,0,0,,Иә? Үлкен зұлым Лорд туралы басқа әңгімелер бар ма?
Dialogue: 0,0:10:54.19,0:10:55.78,Default,,0,0,0,,Мен білемін деп ойлайсың ба?
Dialogue: 0,0:10:56.99,0:10:59.28,Default,,0,0,0,,Мен көбірек көргім келеді! Мен көп көргім келеді!
Dialogue: 0,0:10:59.70,0:11:02.62,Default,,0,0,0,,Ей, сен соншалықты алыссың...
Dialogue: 0,0:11:04.33,0:11:06.79,Default,,0,0,0,,Жоқ, жоқ, бұл басқаша.
Dialogue: 0,0:11:06.91,0:11:08.58,Default,,0,0,0,,Мияу
Dialogue: 0,0:11:07.16,0:11:10.29,Default,,0,0,0,,Мен Gear қалай сезінетінін түсінемін, бірақ...
Dialogue: 0,0:11:10.83,0:11:14.79,Default,,0,0,0,,Бұл шынымен де күлкілі емес пе? Бұл баланың қулығы.
Dialogue: 0,0:11:15.13,0:11:16.71,Default,,0,0,0,,Қызық!
Dialogue: 0,0:11:16.84,0:11:21.80,Default,,0,0,0,,Өйткені ол жол ебедейсіз, күлетін, әдепсіз болатын.
Dialogue: 0,0:11:22.47,0:11:25.81,Default,,0,0,0,,Бірақ мен мүлде бас тарта алмаймын.
Dialogue: 0,0:11:26.31,0:11:27.93,Default,,0,0,0,,Яғни, осы адамдарға зиян келтіру...
Dialogue: 0,0:11:28.06,0:11:29.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:29.77,0:11:31.56,Default,,0,0,0,,Жаңа әлемге барайық
Dialogue: 0,0:11:32.10,0:11:35.40,Default,,0,0,0,,Не айтып тұрсың, ана... қалаға қайт!
Dialogue: 0,0:11:35.52,0:11:38.44,Default,,0,0,0,,Менің үйге барғым келмейді, бірақ...
Dialogue: 0,0:11:36.36,0:11:37.36,Default,,0,0,0,,италиялықтарға тән —
Dialogue: 0,0:11:38.57,0:11:41.57,Default,,0,0,0,,Ия, ия, сен мені жылаттың...
Dialogue: 0,0:11:42.11,0:11:45.28,Default,,0,0,0,,Кума мен Нака-ни, Сиыр-ни, Носа-ни
Dialogue: 0,0:11:45.62,0:11:48.20,Default,,0,0,0,,Эй әже үйге барамын десе, мен көмектесе алмаймын.
Dialogue: 0,0:11:48.79,0:11:50.41,Default,,0,0,0,,Мен сенімен барғым келеді.
Dialogue: 0,0:11:50.54,0:11:54.25,Default,,0,0,0,,Бірақ бұл менің өзімшілдігім, сондықтан мен жалғыз болсам да...
Dialogue: 0,0:11:54.54,0:11:56.50,Default,,0,0,0,,Жалғыз ба? бірақ?
Dialogue: 0,0:11:56.63,0:11:58.00,Default,,0,0,0,,-Мен барамын! - бұршақ пастасы?
Dialogue: 0,0:11:58.13,0:11:59.55,Default,,0,0,0,,Сүйкімді құралға арналған
Dialogue: 0,0:11:59.67,0:12:02.05,Default,,0,0,0,,«Мен» деген не?
Dialogue: 0,0:11:59.67,0:12:00.67,Default,,0,0,0,,Эй!
Dialogue: 0,0:12:02.43,0:12:06.64,Default,,0,0,0,,Жағдайдың мүлде өзгермегенін түсінесіз бе?
Dialogue: 0,0:12:06.89,0:12:08.10,Default,,0,0,0,,Мен сенімен біргемін
Dialogue: 0,0:12:08.39,0:12:09.43,Default,,0,0,0,,Нака-нии, үндеме!
Dialogue: 0,0:12:09.56,0:12:12.69,Default,,0,0,0,,Бұл ішкі хабар.
Dialogue: 0,0:12:10.31,0:12:11.35,Default,,0,0,0,,Әй?
Dialogue: 0,0:12:12.81,0:12:16.77,Default,,0,0,0,,Қалың тұман туралы ескерту жарияланды.
Dialogue: 0,0:12:17.11,0:12:20.11,Default,,0,0,0,,Тұтынушылар абай болыңыз
Dialogue: 0,0:12:17.94,0:12:20.11,Default,,0,0,0,,- Мияу? -Ол қандай автоматтандырылған дауыс?
Dialogue: 0,0:12:20.53,0:12:23.28,Default,,0,0,0,,Күте тұрыңыз, мен диспетчер бөлмесін қараймын.
Dialogue: 0,0:12:23.57,0:12:24.82,Default,,0,0,0,,Мен де барамын!
Dialogue: 0,0:12:25.07,0:12:28.74,Default,,0,0,0,,Эй, кел! Өз бетінше әрекет ететіндер әдетте бірінші өледі.
Dialogue: 0,0:12:29.58,0:12:31.75,Default,,0,0,0,,Келесі өлетін адам - ​​қалған адам.
Dialogue: 0,0:12:32.79,0:12:37.00,Default,,0,0,0,,Сөйлеуге шебер балалар аман қалады.
Dialogue: 0,0:12:38.17,0:12:39.00,Default,,0,0,0,,италиялықтарға тән —
Dialogue: 0,0:12:39.63,0:12:42.51,Default,,0,0,0,,Бұлай айтуды қайдан үйрендің?
Dialogue: 0,0:12:46.59,0:12:47.93,Default,,0,0,0,,(Есікті автоматты түрде ашу дыбысы)
Dialogue: 0,0:12:48.05,0:12:49.43,Default,,0,0,0,,Ай!
Dialogue: 0,0:12:49.56,0:12:50.93,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:12:51.31,0:12:54.31,Default,,0,0,0,,Бұл ішкі хабар.
Dialogue: 0,0:12:54.44,0:12:58.61,Default,,0,0,0,,Қалың тұман туралы ескерту жарияланды.
Dialogue: 0,0:12:59.07,0:13:02.07,Default,,0,0,0,,Тұтынушылар абай болыңыз
Dialogue: 0,0:13:00.61,0:13:03.36,Default,,0,0,0,,«Ному»? Тұман ба?
Dialogue: 0,0:13:03.49,0:13:04.45,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:04.57,0:13:05.53,Default,,0,0,0,,- Беріліс! -Ой!
Dialogue: 0,0:13:05.66,0:13:08.95,Default,,0,0,0,,Хахаха~ Мен ештеңе көрмеймін!
Dialogue: 0,0:13:09.08,0:13:10.74,Default,,0,0,0,,Қайтып кел!
Dialogue: 0,0:13:10.87,0:13:13.08,Default,,0,0,0,,Носа-ни, сен мені көре аласың ба?
Dialogue: 0,0:13:13.20,0:13:14.75,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:13:15.12,0:13:18.92,Default,,0,0,0,,Беріліс! Бұл сіз көре алмайтын нәрсе!
Dialogue: 0,0:13:19.04,0:13:21.50,Default,,0,0,0,,Қайтып келсем де, жоқ болса да, білмеймін!
Dialogue: 0,0:13:23.30,0:13:27.72,Default,,0,0,0,,Бұл сізді ағайынды аспаздармен жақындастырады!
Dialogue: 0,0:13:34.10,0:13:36.52,Default,,0,0,0,,Газым тез таусылды.
Dialogue: 0,0:13:36.64,0:13:39.73,Default,,0,0,0,,Достарыңыз да адасып кетпей ме?
Dialogue: 0,0:13:40.36,0:13:42.65,Default,,0,0,0,,Уақытты өзгерту мүмкін емес.
Dialogue: 0,0:13:42.78,0:13:45.49,Default,,0,0,0,,Маған ең аз байланыста болу керектігін айтты.
Dialogue: 0,0:13:45.86,0:13:49.99,Default,,0,0,0,,Сіз таралуды шештіңіз бе? Кез келген ауытқулар туралы дереу хабарлаңыз.
Dialogue: 0,0:13:50.53,0:13:53.37,Default,,0,0,0,,Содан кейін мен оңтүстік шығысқа барамын.
Dialogue: 0,0:13:53.49,0:13:55.20,Default,,0,0,0,,Мен жер астындамын
Dialogue: 0,0:13:55.33,0:13:57.46,Default,,0,0,0,,Мен бірінші қабаттың алдында тұрмын
Dialogue: 0,0:13:57.58,0:13:58.71,Default,,0,0,0,,Мен… алдымен сені өлтіремін… Буга…ратти…
Dialogue: 0,0:13:59.58,0:14:00.88,Default,,0,0,0,,Бірақ не?
Dialogue: 0,0:14:01.00,0:14:01.75,Default,,0,0,0,,Әй?
Dialogue: 0,0:14:01.92,0:14:05.67,Default,,0,0,0,,Әлгі әйелдің серігі қалай келеді? Осындай жер
Dialogue: 0,0:14:06.05,0:14:08.63,Default,,0,0,0,,Аспаннан жол жоқ.
Dialogue: 0,0:14:08.80,0:14:12.39,Default,,0,0,0,,Нин полярлық аю Ниндзя Жасырын тұман өнері
Dialogue: 0,0:14:13.89,0:14:16.06,Default,,0,0,0,,Егер сіз бетпе-бет келсеңіз, бұл мүмкін болмауы мүмкін.
Dialogue: 0,0:14:16.18,0:14:19.02,Default,,0,0,0,,Егер сіз жасырын қозғалсаңыз, Нұхты құтқара аласыз.
Dialogue: 0,0:14:19.15,0:14:20.31,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:14:20.44,0:14:22.98,Default,,0,0,0,,Олай болса, мұны істеуді қайдан үйрендің?
Dialogue: 0,0:14:23.27,0:14:25.65,Default,,0,0,0,,Бірақ байқап көруге тұрарлық
Dialogue: 0,0:14:26.24,0:14:29.16,Default,,0,0,0,,Сенің айтқаның мені тітіркендіреді.
Dialogue: 0,0:14:29.28,0:14:30.66,Default,,0,0,0,,-Өтінемін! -иә?
Dialogue: 0,0:14:32.28,0:14:33.91,Default,,0,0,0,,Уаааа... кукку...
Dialogue: 0,0:14:35.79,0:14:38.21,Default,,0,0,0,,Егер заттар қауіпті болса, біз дереу эвакуациялаймыз!
Dialogue: 0,0:14:38.33,0:14:39.17,Default,,0,0,0,,О
Dialogue: 0,0:14:40.46,0:14:41.42,Default,,0,0,0,,Nii
Dialogue: 0,0:14:42.17,0:14:43.17,Default,,0,0,0,,(Сиқырлы қаламмен сурет салу дыбысы)
Dialogue: 0,0:14:43.29,0:14:44.55,Default,,0,0,0,,Hihi
Dialogue: 0,0:14:44.67,0:14:45.67,Default,,0,0,0,,Мияу
Dialogue: 0,0:14:47.22,0:14:48.22,Default,,0,0,0,,Иә
Dialogue: 0,0:14:50.84,0:14:52.72,Default,,0,0,0,,Жұмыс уақыты!
Dialogue: 0,0:14:53.30,0:14:55.56,Default,,0,0,0,,Ууууууу...
Dialogue: 0,0:14:55.85,0:14:58.81,Default,,0,0,0,,Бұл қорқынышты жер. Уф.
Dialogue: 0,0:14:59.44,0:15:00.44,Default,,0,0,0,,(шу)
Dialogue: 0,0:15:00.14,0:15:01.10,Default,,0,0,0,,Уф!
Dialogue: 0,0:15:01.77,0:15:02.81,Default,,0,0,0,,Естуімше, ол сенің бала кезден бергі досың.
Dialogue: 0,0:15:04.69,0:15:05.61,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:05.73,0:15:06.73,Default,,0,0,0,,Уф!
Dialogue: 0,0:15:08.11,0:15:11.28,Default,,0,0,0,,Уф... Эй!
Dialogue: 0,0:15:11.78,0:15:15.08,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:15.54,0:15:16.33,Default,,0,0,0,,Паку
Dialogue: 0,0:15:16.62,0:15:18.29,Default,,0,0,0,,Жақсы кадрлар
Dialogue: 0,0:15:18.91,0:15:19.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:19.83,0:15:21.08,Default,,0,0,0,,(Пышақ қағу дыбысы)
Dialogue: 0,0:15:21.92,0:15:22.92,Default,,0,0,0,,Әй?
Dialogue: 0,0:15:26.17,0:15:27.42,Default,,0,0,0,,Оларды мына жерге ыстық шоколадпен қойып кетейін, жарай ма?
Dialogue: 0,0:15:27.67,0:15:29.63,Default,,0,0,0,,Ууууууууууу, қарғыс атсын!
Dialogue: 0,0:15:29.17,0:15:32.64,Default,,0,0,0,,Ихи Ахахха Ахаха!
Dialogue: 0,0:15:29.76,0:15:31.68,Default,,0,0,0,,Аузыңды жап! Ойшо
Dialogue: 0,0:15:32.76,0:15:35.56,Default,,0,0,0,,Уа, уау, ау!
Dialogue: 0,0:15:32.76,0:15:35.56,Default,,0,0,0,,Уууу Ахахахха!
Dialogue: 0,0:15:35.68,0:15:37.77,Default,,0,0,0,,Ой!
Dialogue: 0,0:15:38.06,0:15:40.64,Default,,0,0,0,,Абуне Уау! Апыр-ай!
Dialogue: 0,0:15:38.06,0:15:39.27,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:15:40.77,0:15:42.35,Default,,0,0,0,,Ааааааа!
Dialogue: 0,0:15:42.98,0:15:43.81,Default,,0,0,0,,- (Түстен кейінгі шай) Эй! -ой!
Dialogue: 0,0:15:44.02,0:15:47.73,Default,,0,0,0,,Костюм әдемі көрінеді. Оны шешіп алсаңыз ше?
Dialogue: 0,0:15:48.07,0:15:50.24,Default,,0,0,0,,Айтыңызшы, ақ аю мырза
Dialogue: 0,0:15:50.57,0:15:53.74,Default,,0,0,0,,Мен аю болып көрінсем де, жұмыс дыбысы әлі естіледі...
Dialogue: 0,0:15:53.91,0:15:55.32,Default,,0,0,0,,Хмм, иә!
Dialogue: 0,0:15:54.12,0:15:56.16,Default,,0,0,0,,Ең алдымен, техникалық колледжде—
Dialogue: 0,0:15:55.45,0:15:58.29,Default,,0,0,0,,Уа, ау, ау... Ах!
Dialogue: 0,0:15:59.33,0:16:00.29,Default,,0,0,0,,Га
Dialogue: 0,0:16:00.41,0:16:01.41,Default,,0,0,0,,Эй!
Dialogue: 0,0:16:01.54,0:16:06.59,Default,,0,0,0,,Тамақ пісіру үшін тілің жақсы болуы керек, бірақ құлағың да жақсы болуы керек.
Dialogue: 0,0:16:01.54,0:16:04.46,Default,,0,0,0,,А-а-а-а-а
Dialogue: 0,0:16:06.96,0:16:10.05,Default,,0,0,0,,Алдымен мен саған тамақ дайындап берейін.
Dialogue: 0,0:16:10.72,0:16:12.51,Default,,0,0,0,,Hihiio?
Dialogue: 0,0:16:12.63,0:16:13.38,Default,,0,0,0,,Енді тілек болмайды~
Dialogue: 0,0:16:13.51,0:16:16.64,Default,,0,0,0,,Арх! Арх!
Dialogue: 0,0:16:17.26,0:16:19.64,Default,,0,0,0,,Ууууууууууууууууууууууууууууу!
Dialogue: 0,0:16:18.14,0:16:19.14,Default,,0,0,0,,Не!
Dialogue: 0,0:16:21.52,0:16:23.10,Default,,0,0,0,,Лас...
Dialogue: 0,0:16:23.81,0:16:24.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:25.19,0:16:29.23,Default,,0,0,0,,А, жоқ, жоқ, жоқ... тоқта... тоқта...
Dialogue: 0,0:16:27.11,0:16:29.23,Default,,0,0,0,,Мияу!
Dialogue: 0,0:16:29.36,0:16:30.69,Default,,0,0,0,,Хайхиихии Уау ха!
Dialogue: 0,0:16:30.82,0:16:32.86,Default,,0,0,0,,Уф! Апыр-ай! Ура!
Dialogue: 0,0:16:33.15,0:16:35.66,Default,,0,0,0,,А... иә? иә?
Dialogue: 0,0:16:35.95,0:16:38.66,Default,,0,0,0,,Уау! Гия!
Dialogue: 0,0:16:38.78,0:16:39.95,Default,,0,0,0,,(дронды тарату дыбысы)
Dialogue: 0,0:16:40.75,0:16:42.33,Default,,0,0,0,,Бірдеңе болған сияқты.
Dialogue: 0,0:16:43.00,0:16:44.92,Default,,0,0,0,,Мен ештеңе естімеймін
Dialogue: 0,0:16:45.04,0:16:47.34,Default,,0,0,0,,Аспаз оны естиді.
Dialogue: 0,0:16:47.88,0:16:53.34,Default,,0,0,0,,Мен грильдегі ет пен көкөністерді кесу дыбысын естуге үйренгенмін.
Dialogue: 0,0:16:53.93,0:16:57.26,Default,,0,0,0,,Тұман дыбысты сорып алады, бұл қиындық тудырады.
Dialogue: 0,0:16:57.39,0:16:59.85,Default,,0,0,0,,Барсам ше? Мен енді қашпаймын
Dialogue: 0,0:17:00.72,0:17:01.85,Default,,0,0,0,,Мағынасыз
Dialogue: 0,0:17:03.39,0:17:06.06,Default,,0,0,0,,Мм!
Dialogue: 0,0:17:03.64,0:17:04.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:06.19,0:17:07.06,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:17:07.19,0:17:08.15,Default,,0,0,0,,Әй!
Dialogue: 0,0:17:09.15,0:17:10.61,Default,,0,0,0,,Не істеп жатырсың!
Dialogue: 0,0:17:10.73,0:17:13.15,Default,,0,0,0,,Хм... мен саған көмектесуге келдім.
Dialogue: 0,0:17:13.49,0:17:15.74,Default,,0,0,0,,Мен? Көмек беру үшін бе?
Dialogue: 0,0:17:15.86,0:17:16.70,Default,,0,0,0,,Иә
Dialogue: 0,0:17:16.82,0:17:17.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:18.49,0:17:19.53,Default,,0,0,0,,Ах
Dialogue: 0,0:17:19.99,0:17:20.91,Default,,0,0,0,,Жоқ
Dialogue: 0,0:17:21.04,0:17:22.16,Default,,0,0,0,,Өйткені ол басқаша!
Dialogue: 0,0:17:23.12,0:17:24.12,Default,,0,0,0,,Сен ақымақсың.
Dialogue: 0,0:17:24.25,0:17:25.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:25.16,0:17:27.92,Default,,0,0,0,,Мен нені сағындым
Dialogue: 0,0:17:28.50,0:17:31.42,Default,,0,0,0,,Өмір босқа кететін нәрсе емес
Dialogue: 0,0:17:32.26,0:17:33.92,Default,,0,0,0,,(Дон) Дегенмен, сыртта бәрі де соншалықты алып, иә?
Dialogue: 0,0:17:34.34,0:17:35.42,Default,,0,0,0,,Тіпті ұйықтап қалғаннан кейін де, кем дегенде—
Dialogue: 0,0:17:35.76,0:17:37.72,Default,,0,0,0,,Мен сені астанаға жіберемін
Dialogue: 0,0:17:37.84,0:17:41.43,Default,,0,0,0,,Сондықтан мен сені тастап, қалаға қайта алмаймын!
Dialogue: 0,0:17:41.89,0:17:44.48,Default,,0,0,0,,Үлкен уәде
Dialogue: 0,0:17:44.60,0:17:47.27,Default,,0,0,0,,Неге әуре? осы уақытқа дейін?
Dialogue: 0,0:17:47.40,0:17:50.69,Default,,0,0,0,,Қалғаны тек менің жеке сезімім.
Dialogue: 0,0:17:50.82,0:17:53.44,Default,,0,0,0,,Қалаға осылай қайтатын болсаң, өкінесің.
Dialogue: 0,0:17:53.65,0:17:55.07,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:17:55.19,0:18:00.03,Default,,0,0,0,,Өмір сүріп, өкінгенше, өліп, өкінбей өткен жақсы.
Dialogue: 0,0:18:00.83,0:18:02.79,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:18:05.00,0:18:07.50,Default,,0,0,0,,Менің итім болған.
Dialogue: 0,0:18:07.62,0:18:09.75,Default,,0,0,0,,Ит түсіндің бе?
Dialogue: 0,0:18:09.88,0:18:12.71,Default,,0,0,0,,Малды күзету үшін қолданылатын жұмыс жануары, т.б.
Dialogue: 0,0:18:13.42,0:18:16.72,Default,,0,0,0,,Сіз дәл сол итке ұқсайсыз.
Dialogue: 0,0:18:17.17,0:18:20.72,Default,,0,0,0,,Біздің фермада жұмыс істегіңіз келе ме? Снак-кун
Dialogue: 0,0:18:21.10,0:18:23.22,Default,,0,0,0,,Суна… Ауыл шаруашылығы…
Dialogue: 0,0:18:23.56,0:18:27.27,Default,,0,0,0,,Мен оны жеңіл тамақ үшін қайтарамын.
Dialogue: 0,0:18:27.77,0:18:30.73,Default,,0,0,0,,Біз тек кассета үшін төлейміз.
Dialogue: 0,0:18:31.23,0:18:32.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:32.48,0:18:37.40,Default,,0,0,0,,Итке «тек» дегеннің орнына бәрін қайтарудың жолы бар емес пе?
Dialogue: 0,0:18:38.28,0:18:43.74,Default,,0,0,0,,Салған тұзды қайтып ала алмайсың, тым сараң болма.
Dialogue: 0,0:18:46.20,0:18:47.75,Default,,0,0,0,,Жарайды, түсіндім.
Dialogue: 0,0:18:48.79,0:18:52.00,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:18:49.21,0:18:50.04,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:52.96,0:18:56.67,Default,,0,0,0,,(Жақындаған аяқ дыбысы)
Dialogue: 0,0:19:02.55,0:19:03.68,Default,,0,0,0,,Бөшке
Dialogue: 0,0:19:04.14,0:19:08.23,Default,,0,0,0,,Мен сатқындық пен төңкерісті көп көрдім.
Dialogue: 0,0:19:08.43,0:19:13.69,Default,,0,0,0,,Олардың барлығына ортақ бір нәрсе бар: олардың бәрі өлді.
Dialogue: 0,0:19:13.81,0:19:15.11,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:19:14.23,0:19:15.07,Default,,0,0,0,,Түскі ас!
Dialogue: 0,0:19:15.32,0:19:16.28,Default,,0,0,0,,Таңғы ас!
Dialogue: 0,0:19:15.82,0:19:16.98,Default,,0,0,0,,Арх!
Dialogue: 0,0:19:18.82,0:19:23.91,Default,,0,0,0,,Сонда мен бірінші аман қалуым керек пе?
Dialogue: 0,0:19:24.58,0:19:27.79,Default,,0,0,0,,Мен де аман қалуға бәс тігемін.
Dialogue: 0,0:19:27.91,0:19:28.87,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:32.25,0:19:33.17,Default,,0,0,0,,Аһ!
Dialogue: 0,0:19:35.13,0:19:36.13,Default,,0,0,0,,Га
Dialogue: 0,0:19:38.34,0:19:39.30,Default,,0,0,0,,(Оқ тиеу дыбысы)
Dialogue: 0,0:19:39.42,0:19:40.42,Default,,0,0,0,,Ах
Dialogue: 0,0:19:40.68,0:19:42.51,Default,,0,0,0,,Енді сіз білесіз.
Dialogue: 0,0:19:44.47,0:19:45.51,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:19:45.64,0:19:47.01,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:47.64,0:19:49.77,Default,,0,0,0,,-Уф... -Ит
Dialogue: 0,0:19:50.27,0:19:51.77,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:50.89,0:19:51.77,Default,,0,0,0,,Ол – Лорд Широ.
Dialogue: 0,0:19:52.60,0:19:53.65,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:19:53.77,0:19:57.78,Default,,0,0,0,,Оның орнына менің айтқанымды тыңда.
Dialogue: 0,0:20:05.95,0:20:06.95,Default,,0,0,0,,Мен толықтай жазылып кеттім! (Косей) Оу!
Dialogue: 0,0:20:15.13,0:20:16.79,Default,,0,0,0,,- (Түскі ас/Таңғы ас) Брат! -(Түстен кейінгі шай) Эй!
Dialogue: 0,0:20:16.92,0:20:17.92,Default,,0,0,0,,Беріліс!
Dialogue: 0,0:20:18.63,0:20:20.17,Default,,0,0,0,,Грр... грр...
Dialogue: 0,0:20:26.93,0:20:27.93,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:28.72,0:20:30.39,Default,,0,0,0,,Мен аман қалдым.
Dialogue: 0,0:20:32.31,0:20:33.39,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:33.81,0:20:36.65,Default,,0,0,0,,Мен бөшкеден айласын асырдым!
Dialogue: 0,0:20:38.77,0:20:41.15,Default,,0,0,0,,- (Түскі ас/Бранч) Жарайсыңдар! -(Түстен кейінгі шай)?
Dialogue: 0,0:20:41.28,0:20:45.32,Default,,0,0,0,,А, аа... уф...
Dialogue: 0,0:20:41.49,0:20:44.74,Default,,0,0,0,,Ол әйел сізге шынайы нәрсені береді деп ойлайсыз ба?
Dialogue: 0,0:20:44.86,0:20:47.41,Default,,0,0,0,,Сізде әлі де бар екеніне сенімдімін.
Dialogue: 0,0:20:47.53,0:20:49.58,Default,,0,0,0,,Бұны Баррель де біледі.
Dialogue: 0,0:20:49.70,0:20:51.12,Default,,0,0,0,,Мынау тәтті нәрсе!
Dialogue: 0,0:20:52.08,0:20:53.29,Default,,0,0,0,,Маған көмек керек
Dialogue: 0,0:20:53.41,0:20:54.50,Default,,0,0,0,,Мен қайықты тексеріп бітірдім.
Dialogue: 0,0:20:54.62,0:20:57.13,Default,,0,0,0,,Тоқта, көрдің бе? Бұл ақылсыз
Dialogue: 0,0:20:57.63,0:21:00.88,Default,,0,0,0,,Gear Егер сіз байыпты болсаңыз, асығыңыз!
Dialogue: 0,0:21:01.01,0:21:03.63,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:07.18,0:21:09.43,Default,,0,0,0,,Достар қалды ма?
Dialogue: 0,0:21:10.10,0:21:11.64,Default,,0,0,0,,Бұл ит.
Dialogue: 0,0:21:12.14,0:21:14.64,Default,,0,0,0,,Бұл сөз тіркесін естігелі көп уақыт болды.
Dialogue: 0,0:21:15.44,0:21:19.40,Default,,0,0,0,,Иттің өзі өлді немесе жойылғалы тұр.
Dialogue: 0,0:21:20.02,0:21:22.65,Default,,0,0,0,,Мен солай деп ойлаймын, мүмкін емес пе?
Dialogue: 0,0:21:23.03,0:21:23.99,Default,,0,0,0,,Қарапайымдылық
Dialogue: 0,0:21:24.11,0:21:25.40,Default,,0,0,0,,(шинаның үйкеліс шуы)
Dialogue: 0,0:21:24.53,0:21:25.40,Default,,0,0,0,,Ах
Dialogue: 0,0:21:26.70,0:21:27.95,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:21:28.07,0:21:29.74,Default,,0,0,0,,Уф! сурет?
Dialogue: 0,0:21:30.12,0:21:32.20,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:41.17,0:21:42.67,Default,,0,0,0,,Гугугу... Уф!
Dialogue: 0,0:21:47.72,0:21:48.68,Default,,0,0,0,,Уау!
Dialogue: 0,0:22:01.69,0:22:03.19,Default,,0,0,0,,Болттарды қатайтыңыз
Dialogue: 0,0:22:03.32,0:22:05.28,Default,,0,0,0,,Үдеткішке қадам бас!
Dialogue: 0,0:22:07.07,0:22:08.24,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:22:15.96,0:22:19.21,Default,,0,0,0,,Нұх! қол!
Dialogue: 0,0:22:22.84,0:22:23.84,Default,,0,0,0,,Уф!
Dialogue: 0,0:22:39.90,0:22:40.86,Default,,0,0,0,,Баррет
Dialogue: 0,0:22:51.20,0:22:53.49,Default,,0,0,0,,Ай!
Dialogue: 0,0:22:59.83,0:23:01.29,Default,,0,0,0,,Онда ешкім жоқ
Dialogue: 0,0:23:01.42,0:23:02.59,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:23:03.21,0:23:04.30,Default,,0,0,0,,Міне
Dialogue: 0,0:23:04.63,0:23:05.59,Default,,0,0,0,,Не?
Dialogue: 0,0:23:17.06,0:23:18.98,Default,,0,0,0,,Елордадағылар.
Dialogue: 0,0:23:22.73,0:23:23.69,Default,,0,0,0,,Әй!
Dialogue: 0,0:23:23.81,0:23:28.78,Default,,0,0,0,,Диверсия және тәртіп бұзғаны үшін қамауға алу
Dialogue: 0,0:23:25.65,0:23:26.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:29.61,0:23:30.78,Default,,0,0,0,,Сізге
Dialogue: 0,0:23:31.57,0:23:34.28,Default,,0,0,0,,Құқықтар жоқ.
Dialogue: 0,0:23:42.04,0:23:44.25,Default,,0,0,0,,♪～
Dialogue: 0,0:25:04.42,0:25:09.63,Default,,0,0,0,,～♪
