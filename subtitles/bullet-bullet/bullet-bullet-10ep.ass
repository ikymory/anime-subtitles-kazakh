Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.04,0:00:04.21,Default,,0,0,0,,♪～
Dialogue: 0,0:01:26.58,0:01:29.13,Default,,0,0,0,,～♪
Dialogue: 0,0:01:35.09,0:01:36.01,Default,,0,0,0,,Сан!
Dialogue: 0,0:01:36.13,0:01:37.59,Default,,0,0,0,,-ichi -ni
Dialogue: 0,0:01:37.80,0:01:39.18,Default,,0,0,0,,Сан!
Dialogue: 0,0:01:42.31,0:01:43.18,Default,,0,0,0,,Сан!
Dialogue: 0,0:01:45.56,0:01:46.77,Default,,0,0,0,,Сан!
Dialogue: 0,0:01:46.89,0:01:49.94,Default,,0,0,0,,Аа, менің белім ауырып тұр.
Dialogue: 0,0:01:50.48,0:01:51.44,Default,,0,0,0,,Жоспар
Dialogue: 0,0:01:52.15,0:01:55.19,Default,,0,0,0,,Бұл жаман болған сияқты.
Dialogue: 0,0:01:55.32,0:01:56.70,Default,,0,0,0,,Міне~
Dialogue: 0,0:01:56.82,0:01:59.99,Default,,0,0,0,,(жүгірген аяқ дыбысы)
Dialogue: 0,0:02:00.53,0:02:02.83,Default,,0,0,0,,Не?!
Dialogue: 0,0:02:03.99,0:02:05.25,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,0:02:06.62,0:02:07.71,Default,,0,0,0,,Нуу!
Dialogue: 0,0:02:08.58,0:02:12.59,Default,,0,0,0,,Тағам дымқыл. Бұл не тағам?
Dialogue: 0,0:02:12.71,0:02:14.71,Default,,0,0,0,,Біз осында жұмыс істеп жатырмыз!
Dialogue: 0,0:02:14.84,0:02:17.17,Default,,0,0,0,,Мен сенің жақсырақ жегеніңді қалаймын!
Dialogue: 0,0:02:17.30,0:02:21.39,Default,,0,0,0,,Кунокукуфуфу!
Dialogue: 0,0:02:21.80,0:02:23.85,Default,,0,0,0,,Сіз жақсы тамақ жейсіз бе?
Dialogue: 0,0:02:24.85,0:02:25.85,Default,,0,0,0,,Хмм
Dialogue: 0,0:02:26.93,0:02:29.52,Default,,0,0,0,,Мен кеш екенін білемін, бірақ сен мұнда неге келдің?
Dialogue: 0,0:02:29.85,0:02:33.02,Default,,0,0,0,,Ха, ұмыттың ба?
Dialogue: 0,0:02:36.19,0:02:37.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:37.57,0:02:40.11,Default,,0,0,0,,Сонымен, сіздің мәртебеңіз бізбен бірдей емес пе?
Dialogue: 0,0:02:40.24,0:02:41.70,Default,,0,0,0,,Онда неге мұндай той...
Dialogue: 0,0:02:41.82,0:02:43.62,Default,,0,0,0,,Мен мүлде жұмыс істемедім.
Dialogue: 0,0:02:43.99,0:02:45.37,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:02:45.49,0:02:47.00,Default,,0,0,0,,-Иә Иә Иә -Ғұн ғұн ғұн
Dialogue: 0,0:02:47.12,0:02:48.00,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:02:48.37,0:02:51.75,Default,,0,0,0,,Ағай! Құшақтау...
Dialogue: 0,0:02:51.88,0:02:54.00,Default,,0,0,0,,Ах
Dialogue: 0,0:02:54.13,0:02:55.46,Default,,0,0,0,,Ммммммммммммм
Dialogue: 0,0:02:55.84,0:03:00.09,Default,,0,0,0,,Тіпті түрме қызметкерлері де қарындарынан ұстап отыр.
Dialogue: 0,0:03:00.63,0:03:04.60,Default,,0,0,0,,Асқазанды басқарған түрмені де басқарады!
Dialogue: 0,0:03:04.89,0:03:07.60,Default,,0,0,0,,Дұрыс, Снэк-кун.
Dialogue: 0,0:03:05.60,0:03:06.60,Default,,0,0,0,,Ах
Dialogue: 0,0:03:07.72,0:03:10.06,Default,,0,0,0,,Мен бұл жерде патшамын, былайша айтқанда.
Dialogue: 0,0:03:10.39,0:03:15.82,Default,,0,0,0,,Егер сіз мен үшін жұмыс істеуді таңдасаңыз, мен сізге күнделікті жайлы өмір сүруге кепілдік беремін.
Dialogue: 0,0:03:15.94,0:03:17.15,Default,,0,0,0,,Хмм.
Dialogue: 0,0:03:17.28,0:03:20.95,Default,,0,0,0,,А, тағы бір қиыншылық.
Dialogue: 0,0:03:21.07,0:03:22.78,Default,,0,0,0,,Егер мен бұны қазір айтпасам, кейін қарама-қайшылықтар туындауы мүмкін.
Dialogue: 0,0:03:22.91,0:03:24.70,Default,,0,0,0,,Мен бас тартуды қойдым.
Dialogue: 0,0:03:24.83,0:03:26.83,Default,,0,0,0,,Әрі қарай жүріңіз
Dialogue: 0,0:03:25.83,0:03:26.83,Default,,0,0,0,,О
Dialogue: 0,0:03:26.95,0:03:28.58,Default,,0,0,0,,Гооахх! Фуууууу!
Dialogue: 0,0:03:29.16,0:03:31.29,Default,,0,0,0,,Сонымен не істеуіміз керек?
Dialogue: 0,0:03:31.42,0:03:35.13,Default,,0,0,0,,Егер ол түрменің бақылауында болса, бұл одан да жақсы.
Dialogue: 0,0:03:35.25,0:03:37.46,Default,,0,0,0,,Маған көмектесіп, осы жерден қашып кетейін.
Dialogue: 0,0:03:37.59,0:03:40.38,Default,,0,0,0,,Мен оған дүние туралы шындықты үйретемін!
Dialogue: 0,0:03:40.84,0:03:42.80,Default,,0,0,0,,(Ағайындылардың күлкісі)
Dialogue: 0,0:03:42.93,0:03:44.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:44.18,0:03:46.18,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:03:46.43,0:03:50.77,Default,,0,0,0,,(біреудің ізі)
Dialogue: 0,0:03:46.72,0:03:48.31,Default,,0,0,0,,Менің айтарым бар, тыңдаңыз.
Dialogue: 0,0:03:48.43,0:03:49.68,Default,,0,0,0,,- Иә? -Бұл дүние...
Dialogue: 0,0:03:50.06,0:03:53.69,Default,,0,0,0,,Қарсы емеспін, бірақ олардың да айтары бар сияқты.
Dialogue: 0,0:03:53.94,0:03:56.61,Default,,0,0,0,,Досукой!
Dialogue: 0,0:03:54.19,0:03:55.19,Default,,0,0,0,,Не!
Dialogue: 0,0:03:55.61,0:03:56.61,Default,,0,0,0,,Ал егер Цуки Кира болса, онда Цуки Нианы өлтіреді
Dialogue: 0,0:04:00.32,0:04:01.45,Default,,0,0,0,,Геарааа~?
Dialogue: 0,0:04:03.36,0:04:05.57,Default,,0,0,0,,- (Дестро ит) Уау! -Апыр-ай! Міне бітті!
Dialogue: 0,0:04:07.08,0:04:09.16,Default,,0,0,0,,Бұл әңгіме емес!
Dialogue: 0,0:04:09.45,0:04:12.21,Default,,0,0,0,,Өйткені оларды сен өлтірдің
Dialogue: 0,0:04:12.33,0:04:15.92,Default,,0,0,0,,Оны билік тұтқындап, осында қамады.
Dialogue: 0,0:04:16.29,0:04:17.88,Default,,0,0,0,,Тіпті біз үшін
Dialogue: 0,0:04:16.29,0:04:21.17,Default,,0,0,0,,Цуяко! Цуяко~ Цуяко~
Dialogue: 0,0:04:18.00,0:04:21.17,Default,,0,0,0,,Егер мен сіздің жолыңызға түспесем, мен бұлай ыңғайсыз болмас едім...
Dialogue: 0,0:04:21.42,0:04:24.80,Default,,0,0,0,,Балалар сендерге не болды? Уау
Dialogue: 0,0:04:25.22,0:04:27.10,Default,,0,0,0,,Осындай жерде қамалған
Dialogue: 0,0:04:27.22,0:04:30.89,Default,,0,0,0,,Шаруашылық басшылығына да көңіліңіз толмайтынына сенімдімін!
Dialogue: 0,0:04:31.02,0:04:35.69,Default,,0,0,0,,Сиырлар мен шошқаларды бағуды басқаларға тапсыру маған ұнамайды.
Dialogue: 0,0:04:35.94,0:04:38.15,Default,,0,0,0,,А... а... а... а...
Dialogue: 0,0:04:38.27,0:04:40.36,Default,,0,0,0,,Хехехе! Алақай!
Dialogue: 0,0:04:39.48,0:04:40.36,Default,,0,0,0,,Уау
Dialogue: 0,0:04:41.49,0:04:42.32,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:42.86,0:04:46.41,Default,,0,0,0,,Уайымдама, мен сенің өміріңді алмаймын.
Dialogue: 0,0:04:47.20,0:04:50.83,Default,,0,0,0,,Өлтіретін уақыт келгенде, біз мұны өз жолымызбен жасаймыз!
Dialogue: 0,0:04:50.95,0:04:54.50,Default,,0,0,0,,Жарайсыңдар, сендер де білгендеріңді қалаймын!
Dialogue: 0,0:04:54.62,0:04:55.58,Default,,0,0,0,,Тыңдаңыз!
Dialogue: 0,0:04:55.71,0:04:56.83,Default,,0,0,0,,Бұл дүние...
Dialogue: 0,0:04:56.04,0:04:56.83,Default,,0,0,0,,Уф
Dialogue: 0,0:04:57.54,0:04:58.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:02.09,0:05:04.01,Default,,0,0,0,,Сенің кесіріңнен Цуяко...
Dialogue: 0,0:05:04.13,0:05:05.22,Default,,0,0,0,,Жетеді!
Dialogue: 0,0:05:05.51,0:05:07.47,Default,,0,0,0,,Цуяко Ах!
Dialogue: 0,0:05:06.64,0:05:10.64,Default,,0,0,0,,Тоқта! Қазірдің өзінде тоқтатыңыз!
Dialogue: 0,0:05:11.72,0:05:15.44,Default,,0,0,0,,Тыңдаңыз! Елордадағылар бізге жұмыс істеуге рұқсат береді...
Dialogue: 0,0:05:15.56,0:05:16.35,Default,,0,0,0,,О!
Dialogue: 0,0:05:16.48,0:05:17.90,Default,,0,0,0,,Біз олар...
Dialogue: 0,0:05:18.02,0:05:18.98,Default,,0,0,0,,- (SSS) Қалыңыз! -Апыр-ай!
Dialogue: 0,0:05:19.11,0:05:22.36,Default,,0,0,0,,Гах! Гах... Иә?
Dialogue: 0,0:05:19.11,0:05:22.36,Default,,0,0,0,,Гах! Гах... Иә?
Dialogue: 0,0:05:20.73,0:05:22.36,Default,,0,0,0,,Сондықтан тыңдаңыз!
Dialogue: 0,0:05:23.36,0:05:24.90,Default,,0,0,0,,Біз ғана жақсы өмір сүре аламыз...
Dialogue: 0,0:05:25.03,0:05:26.24,Default,,0,0,0,,Қалай!
Dialogue: 0,0:05:26.36,0:05:27.91,Default,,0,0,0,,Мұқият тыңдаңыз!
Dialogue: 0,0:05:28.03,0:05:29.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:29.16,0:05:32.04,Default,,0,0,0,,-Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:05:33.83,0:05:36.50,Default,,0,0,0,,Тыңдаңыз! Мен бұл жерден қашуым керек...
Dialogue: 0,0:05:36.62,0:05:38.29,Default,,0,0,0,,Ах... Ах!
Dialogue: 0,0:05:38.42,0:05:39.50,Default,,0,0,0,,италиялықтарға тән —
Dialogue: 0,0:05:40.17,0:05:41.46,Default,,0,0,0,,Балалар...
Dialogue: 0,0:05:41.59,0:05:45.88,Default,,0,0,0,,Күте тұрыңыз, мен мұны шешемін.
Dialogue: 0,0:05:41.88,0:05:45.51,Default,,0,0,0,,Иә? Ой... ой... ой!
Dialogue: 0,0:05:46.01,0:05:47.88,Default,,0,0,0,,Уф
Dialogue: 0,0:05:48.01,0:05:53.64,Default,,0,0,0,,(Боранның дыбысы)
Dialogue: 0,0:05:49.14,0:05:51.60,Default,,0,0,0,,Бұл мекемеде бақылаусыз
Dialogue: 0,0:05:51.72,0:05:53.64,Default,,0,0,0,,Жалғыз орын
Dialogue: 0,0:05:54.35,0:05:57.02,Default,,0,0,0,,Менің көмегіммен, әрине.
Dialogue: 0,0:05:57.48,0:05:59.90,Default,,0,0,0,,Сондықтан не айтқаның маңызды емес.
Dialogue: 0,0:06:00.94,0:06:03.78,Default,,0,0,0,,«Бұл жерден қашу» нені білдіреді?
Dialogue: 0,0:06:04.36,0:06:06.65,Default,,0,0,0,,Мен бұл жерден кеткенде істегім келетін нәрселер бар.
Dialogue: 0,0:06:07.78,0:06:09.66,Default,,0,0,0,,Астананы жойыңыз!
Dialogue: 0,0:06:10.20,0:06:11.20,Default,,0,0,0,,Әй?
Dialogue: 0,0:06:11.91,0:06:16.71,Default,,0,0,0,,Айтқанымды ойласам, түс сияқты
Dialogue: 0,0:06:16.83,0:06:18.67,Default,,0,0,0,,Бұл тақырыптан тыс.
Dialogue: 0,0:06:19.17,0:06:22.50,Default,,0,0,0,,Елордада өміріңді кетіретін жер асты жүйесі бар.
Dialogue: 0,0:06:22.63,0:06:24.17,Default,,0,0,0,,оны ұсақтаңыз
Dialogue: 0,0:06:24.55,0:06:29.13,Default,,0,0,0,,Олар бұл жүйені біздің өмірімізді ұрлау үшін пайдаланып жатыр!
Dialogue: 0,0:06:29.43,0:06:33.18,Default,,0,0,0,,Олар өздерін білмей, елсіз даланың өмірін тонады.
Dialogue: 0,0:06:33.56,0:06:35.85,Default,,0,0,0,,Тек біз ұзағырақ өмір сүре аламыз...
Dialogue: 0,0:06:35.97,0:06:39.77,Default,,0,0,0,,Өмірді алып кету керек пе? Бірдеңе...
Dialogue: 0,0:06:39.90,0:06:41.69,Default,,0,0,0,,Ақпарат дұрыс па?
Dialogue: 0,0:06:42.15,0:06:43.69,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:06:44.52,0:06:47.69,Default,,0,0,0,,Мен айдаладағы адамдарға өтініш жасадым, бірақ нәтиже болмады.
Dialogue: 0,0:06:48.45,0:06:51.57,Default,,0,0,0,,Сондықтан мен қолымнан келгенін істеймін
Dialogue: 0,0:06:51.70,0:06:55.83,Default,,0,0,0,,Олардың ең маңыздысы... жүйені жойыңыз!
Dialogue: 0,0:06:56.20,0:06:59.83,Default,,0,0,0,,Біздің де тірі екенімізді еске саламын!
Dialogue: 0,0:07:00.54,0:07:03.71,Default,,0,0,0,,Сонымен сіз астанаға шабуыл жасадыңыз ба?
Dialogue: 0,0:07:03.84,0:07:05.84,Default,,0,0,0,,Бұл террорист сияқты.
Dialogue: 0,0:07:06.46,0:07:09.26,Default,,0,0,0,,Иә, мен үлкен жаман боламын.
Dialogue: 0,0:07:09.38,0:07:12.26,Default,,0,0,0,,Кяхахахахаха! Хи хи хи
Dialogue: 0,0:07:09.59,0:07:10.59,Default,,0,0,0,,Ах
Dialogue: 0,0:07:12.39,0:07:14.93,Default,,0,0,0,,Тіпті үлкен жаман жігіттер де күлкілі!
Dialogue: 0,0:07:15.26,0:07:19.68,Default,,0,0,0,,Сол үлкен зұлыммен бірге тамақтанған жақсы ма?
Dialogue: 0,0:07:19.81,0:07:20.89,Default,,0,0,0,,Дәмі өте нашар.
Dialogue: 0,0:07:21.02,0:07:25.82,Default,,0,0,0,,Вахахаха!
Dialogue: 0,0:07:26.27,0:07:27.61,Default,,0,0,0,,А, а...
Dialogue: 0,0:07:27.94,0:07:34.20,Default,,0,0,0,,Вахахахаха!
Dialogue: 0,0:07:34.57,0:07:36.70,Default,,0,0,0,,Оның орнына!
Dialogue: 0,0:07:36.83,0:07:38.54,Default,,0,0,0,,Тез мас болайық!
Dialogue: 0,0:07:38.66,0:07:40.37,Default,,0,0,0,,Қажетсіз ештеңе жасамаңыз!
Dialogue: 0,0:07:40.50,0:07:42.79,Default,,0,0,0,,Біз бұған қанағаттандық!
Dialogue: 0,0:07:42.92,0:07:44.79,Default,,0,0,0,,Жақсы өмір деген жоқ!
Dialogue: 0,0:07:44.92,0:07:47.80,Default,,0,0,0,,Хахахахаха!
Dialogue: 0,0:07:48.38,0:07:50.51,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:07:50.80,0:07:51.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:52.01,0:07:53.51,Default,,0,0,0,,-Gi… Беріліс? -а? мм... хмм?
Dialogue: 0,0:07:53.64,0:07:54.51,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:54.64,0:07:57.51,Default,,0,0,0,,Қайырлы жігіттер!
Dialogue: 0,0:07:58.22,0:08:00.60,Default,,0,0,0,,Сіз ештеңе сезбейсіз бе?
Dialogue: 0,0:08:00.73,0:08:04.48,Default,,0,0,0,,Бізден кек алсаңыз, көңіліңіз толар ма?
Dialogue: 0,0:08:04.60,0:08:06.23,Default,,0,0,0,,Ашуланыңыз!
Dialogue: 0,0:08:06.36,0:08:07.98,Default,,0,0,0,,Одан да ашуланыңыз!
Dialogue: 0,0:08:08.11,0:08:09.48,Default,,0,0,0,,(кісі өлтірушілерді өлтіру)
Dialogue: 0,0:08:09.61,0:08:14.82,Default,,0,0,0,,Ей, соңғы кезде ашуланып жүр...
Dialogue: 0,0:08:14.95,0:08:16.87,Default,,0,0,0,,Әй, сәл жұмсақ бол...
Dialogue: 0,0:08:16.99,0:08:17.95,Default,,0,0,0,,-Ей! -Апыр-ай!
Dialogue: 0,0:08:18.08,0:08:22.62,Default,,0,0,0,,Үкіметтегі үлкендер ойына келгенін істеп жатқанда, сен үндемейсің бе?
Dialogue: 0,0:08:22.75,0:08:25.42,Default,,0,0,0,,Сіздің өміріңіздің жойылуы жақсы ма?
Dialogue: 0,0:08:25.54,0:08:28.04,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,0:08:28.71,0:08:32.76,Default,,0,0,0,,Балалар, сендер бірінші дәрежелі өлтірушісіңдер, солай ма?
Dialogue: 0,0:08:32.88,0:08:37.76,Default,,0,0,0,,Егер солай болса, мына сұм дүниені өлтіріп көріңіз!
Dialogue: 0,0:08:39.06,0:08:43.06,Default,,0,0,0,,Елордалық жүйе өміріңді тонап жатыр десең.
Dialogue: 0,0:08:43.64,0:08:46.35,Default,,0,0,0,,Бұл өлтіруші сияқты
Dialogue: 0,0:08:46.77,0:08:47.77,Default,,0,0,0,,Ах
Dialogue: 0,0:08:47.15,0:08:51.07,Default,,0,0,0,,Біздің әрқайсымыздың өлтірудің өзіндік стилі бар.
Dialogue: 0,0:08:51.28,0:08:54.82,Default,,0,0,0,,Өз іс-әрекетінде эстетикалық және мақтанышқа ие болу.
Dialogue: 0,0:08:55.41,0:08:59.08,Default,,0,0,0,,Бірақ мен бұл жүйеде мұның ешқайсысын сезбеймін.
Dialogue: 0,0:08:59.45,0:09:03.46,Default,,0,0,0,,Бір саладағы адам ретінде мен мұны кешіре алмаймын.
Dialogue: 0,0:09:03.58,0:09:05.08,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:05.21,0:09:06.25,Default,,0,0,0,,- Ал егер! -Аа...
Dialogue: 0,0:09:06.37,0:09:09.59,Default,,0,0,0,,Бірақ сендерде кек бар.
Dialogue: 0,0:09:09.71,0:09:10.92,Default,,0,0,0,,(Изуку) Качан… әдетте оң қолымен мықты соққы жасап бастайды
Dialogue: 0,0:09:11.30,0:09:12.55,Default,,0,0,0,,-Ух... -Ух...
Dialogue: 0,0:09:12.67,0:09:15.09,Default,,0,0,0,,Олай болса, осыны шешейік.
Dialogue: 0,0:09:12.67,0:09:13.67,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:15.38,0:09:18.85,Default,,0,0,0,,Snack-kun жеңсе, бәрі шайылады.
Dialogue: 0,0:09:19.30,0:09:22.10,Default,,0,0,0,,Қол ұшын беруге ше?
Dialogue: 0,0:09:23.14,0:09:24.27,Default,,0,0,0,,Қызықты
Dialogue: 0,0:09:26.81,0:09:29.44,Default,,0,0,0,,Сәлеметсіз бе, мен келдім!
Dialogue: 0,0:09:30.77,0:09:33.65,Default,,0,0,0,,Ааа! Ааа аааа ааа ааа
Dialogue: 0,0:09:33.78,0:09:34.78,Default,,0,0,0,,Уау
Dialogue: 0,0:09:35.61,0:09:37.20,Default,,0,0,0,,Жартысы! Динг?
Dialogue: 0,0:09:36.15,0:09:37.20,Default,,0,0,0,,Га
Dialogue: 0,0:09:38.07,0:09:41.08,Default,,0,0,0,,Жеңіс үлгісі 6 есе 6, яғни 36 өрнек.
Dialogue: 0,0:09:41.20,0:09:44.12,Default,,0,0,0,,12 жарым - 9 12 жарым
Dialogue: 0,0:09:44.25,0:09:48.67,Default,,0,0,0,,Бір қарағанда, көп Динг бар сияқты, бірақ біреуін алу ықтималдығы 50%.
Dialogue: 0,0:09:48.79,0:09:51.21,Default,,0,0,0,,Хмм, жарты!
Dialogue: 0,0:09:51.34,0:09:52.42,Default,,0,0,0,,-Динг! -Динг?
Dialogue: 0,0:09:53.88,0:09:54.96,Default,,0,0,0,,Шайқас!
Dialogue: 0,0:09:55.09,0:09:56.13,Default,,0,0,0,,Хё
Dialogue: 0,0:09:56.26,0:09:57.80,Default,,0,0,0,,Пинзороның Дингі!
Dialogue: 0,0:09:57.93,0:09:58.93,Default,,0,0,0,,Охх~
Dialogue: 0,0:09:59.05,0:10:00.55,Default,,0,0,0,,Шааааааааааааа!
Dialogue: 0,0:10:00.68,0:10:04.31,Default,,0,0,0,,Дұрыс жауап – ақыр соңында аюға қарсы дау.
Dialogue: 0,0:10:00.68,0:10:04.31,Default,,0,0,0,,Grrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrr...
Dialogue: 0,0:10:04.43,0:10:07.44,Default,,0,0,0,,Сонымен, Снэк-кун қалайды.
Dialogue: 0,0:10:07.56,0:10:09.77,Default,,0,0,0,,Бұл жерден дереу кетеміз бе?
Dialogue: 0,0:10:07.85,0:10:08.85,Default,,0,0,0,,-Аа? -иә?
Dialogue: 0,0:10:09.90,0:10:10.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:11.11,0:10:13.07,Default,,0,0,0,,Дайын, ағайын.
Dialogue: 0,0:10:13.48,0:10:15.44,Default,,0,0,0,,Қолайсыздық үшін кешіріңіз, кешкі ас
Dialogue: 0,0:10:15.57,0:10:16.90,Default,,0,0,0,,Мориё қаласы дейсіз бе? Хмм…
Dialogue: 0,0:10:17.03,0:10:18.45,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:10:18.57,0:10:20.20,Default,,0,0,0,,О!
Dialogue: 0,0:10:20.62,0:10:21.87,Default,,0,0,0,,О...
Dialogue: 0,0:10:22.45,0:10:24.24,Default,,0,0,0,,(Сымның қырылуы дыбысы)
Dialogue: 0,0:10:26.79,0:10:27.71,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:27.83,0:10:28.83,Default,,0,0,0,,Ура!
Dialogue: 0,0:10:28.96,0:10:33.59,Default,,0,0,0,,(Кісі өлтірушілердің айқайы)
Dialogue: 0,0:10:33.71,0:10:36.71,Default,,0,0,0,,Сіз түрмеден қашуға ұзақ уақыт дайындалдыңыз ба?
Dialogue: 0,0:10:33.71,0:10:36.71,Default,,0,0,0,,...
Dialogue: 0,0:10:36.84,0:10:40.14,Default,,0,0,0,,Уақыт өте жақсы болғаны үшін сіз бақытты болдыңыз!
Dialogue: 0,0:10:36.84,0:10:40.14,Default,,0,0,0,,...
Dialogue: 0,0:10:42.01,0:10:43.76,Default,,0,0,0,,Қауіпсіздік ұясына байланысты
Dialogue: 0,0:10:43.89,0:10:45.60,Default,,0,0,0,,Сіз сондай-ақ осындай нәрсені жасай аласыз
Dialogue: 0,0:10:47.10,0:10:48.10,Default,,0,0,0,,(құлыпты ашу дыбысы)
Dialogue: 0,0:10:48.23,0:10:50.77,Default,,0,0,0,,Ах... о... Уау!
Dialogue: 0,0:10:51.15,0:10:53.98,Default,,0,0,0,,Қаласаңыз, келіңіз!
Dialogue: 0,0:10:54.11,0:10:56.32,Default,,0,0,0,,...
Dialogue: 0,0:10:56.44,0:10:57.53,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:58.86,0:11:00.57,Default,,0,0,0,,- (Түрме қызметкері С) Эй! Түрмеге қайт! - (Түрме қызметкері D) Уау...
Dialogue: 0,0:11:00.70,0:11:02.95,Default,,0,0,0,,- (Түскі ас/Таңғы ас) Тоя! -аа!
Dialogue: 0,0:11:03.07,0:11:04.08,Default,,0,0,0,,(Көрермен) Мен оны мінген күйдегі шайқасқа дейін қызықты жігіт деп ойладым…
Dialogue: 0,0:11:04.20,0:11:05.20,Default,,0,0,0,,Конняро!
Dialogue: 0,0:11:12.33,0:11:13.33,Default,,0,0,0,,Кек алу
Dialogue: 0,0:11:13.46,0:11:14.96,Default,,0,0,0,,Мен мұны істеймін!
Dialogue: 0,0:11:15.09,0:11:18.97,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:19.09,0:11:22.30,Default,,0,0,0,,(бұзылған заттардың дыбысы)
Dialogue: 0,0:11:20.38,0:11:21.55,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:11:22.43,0:11:24.60,Default,,0,0,0,,Жалқау болмаңыз! Барайық!
Dialogue: 0,0:11:25.01,0:11:25.85,Default,,0,0,0,,Уф
Dialogue: 0,0:11:27.85,0:11:29.35,Default,,0,0,0,,О~
Dialogue: 0,0:11:29.98,0:11:33.10,Default,,0,0,0,,Бұл аралды астанамен байланыстыратын су асты жолы.
Dialogue: 0,0:11:33.56,0:11:35.94,Default,,0,0,0,,О! О!
Dialogue: 0,0:11:33.73,0:11:37.57,Default,,0,0,0,,Мен таң қалдым! Мен мұндай нәрсе бар екенін ешқашан білмедім.
Dialogue: 0,0:11:37.69,0:11:40.03,Default,,0,0,0,,Ал, мен шыға берісте күтемін.
Dialogue: 0,0:11:41.70,0:11:47.08,Default,,0,0,0,,Қарғыс атқыр тұтқындар бұл жерден тірі шыға алмайсыңдар!
Dialogue: 0,0:11:47.74,0:11:49.00,Default,,0,0,0,,- (Барлығы) Уау! - (жарылыс дыбысы)
Dialogue: 0,0:11:51.75,0:11:52.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:53.33,0:11:54.38,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:11:55.75,0:11:56.96,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:01.76,0:12:02.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:02.72,0:12:06.01,Default,,0,0,0,,(Су астында күресіп жатқан адамдардың дыбыстары)
Dialogue: 0,0:12:04.97,0:12:06.01,Default,,0,0,0,,италиялықтарға тән —
Dialogue: 0,0:12:08.47,0:12:13.69,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:12:17.32,0:12:18.48,Default,,0,0,0,,(Су астында тыныс алу дыбысы)
Dialogue: 0,0:12:18.61,0:12:22.49,Default,,0,0,0,,Пуха! Ха ха ха ха
Dialogue: 0,0:12:21.19,0:12:27.03,Default,,0,0,0,,(кеменің жақындап келе жатқан қозғалтқышының дыбысы)
Dialogue: 0,0:12:22.99,0:12:24.20,Default,,0,0,0,,Ха!
Dialogue: 0,0:12:30.58,0:12:31.54,Default,,0,0,0,,О
Dialogue: 0,0:12:31.66,0:12:33.79,Default,,0,0,0,,Ах! Нұх!
Dialogue: 0,0:12:34.58,0:12:36.88,Default,,0,0,0,,Сақтық көшірме пайдалы болды
Dialogue: 0,0:12:39.46,0:12:40.59,Default,,0,0,0,,Өтірікші
Dialogue: 0,0:12:41.05,0:12:41.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:43.38,0:12:45.84,Default,,0,0,0,,Мен сізге міндетті түрде көмектесемін дедім.
Dialogue: 0,0:12:45.97,0:12:47.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:48.64,0:12:52.52,Default,,0,0,0,,Ол ешқашан келмеді, сондықтан мен оны осында әкелдім.
Dialogue: 0,0:12:59.48,0:13:00.94,Default,,0,0,0,,О~
Dialogue: 0,0:13:01.78,0:13:02.69,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:13:03.32,0:13:04.74,Default,,0,0,0,,Менің үйім
Dialogue: 0,0:13:05.36,0:13:07.45,Default,,0,0,0,,Уау, бәрі мүмкін.
Dialogue: 0,0:13:07.57,0:13:08.78,Default,,0,0,0,,Менің қарным ашты~
Dialogue: 0,0:13:08.91,0:13:10.12,Default,,0,0,0,,Мен ұйықтап қалдым
Dialogue: 0,0:13:10.24,0:13:11.83,Default,,0,0,0,,Берри құс
Dialogue: 0,0:13:12.45,0:13:15.12,Default,,0,0,0,,Бұл сіздің жұмыс орныңыз ба?
Dialogue: 0,0:13:15.25,0:13:17.42,Default,,0,0,0,,Ол бізбен төбелесіп жатты.
Dialogue: 0,0:13:17.54,0:13:19.46,Default,,0,0,0,,Олай емес~
Dialogue: 0,0:13:19.88,0:13:21.42,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:13:21.55,0:13:22.55,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:13:21.88,0:13:22.96,Default,,0,0,0,,-Ах - (түскі шай) А?
Dialogue: 0,0:13:23.67,0:13:24.67,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:25.59,0:13:26.84,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:13:27.93,0:13:30.26,Default,,0,0,0,,Шөл далаға тастау туралы
Dialogue: 0,0:13:30.39,0:13:32.31,Default,,0,0,0,,Нұх мені құтқарды
Dialogue: 0,0:13:32.43,0:13:34.52,Default,,0,0,0,,-Ня~о -Ой!
Dialogue: 0,0:13:35.18,0:13:36.64,Default,,0,0,0,,Нерон~?
Dialogue: 0,0:13:36.77,0:13:39.77,Default,,0,0,0,,Сен бейбақ~ сенің де жақсысың деп үміттенемін!
Dialogue: 0,0:13:39.86,0:13:42.90,Default,,0,0,0,,А, қазірдің өзінде... буруруруру...
Dialogue: 0,0:13:41.32,0:13:43.86,Default,,0,0,0,,Бірақ Дайтенжин Полдан қалай...
Dialogue: 0,0:13:44.82,0:13:47.99,Default,,0,0,0,,Олардың көздегені – құрал болды.
Dialogue: 0,0:13:48.11,0:13:51.08,Default,,0,0,0,,Мені оңаша қалдырыңыз да, тетікке тез еріңіз...
Dialogue: 0,0:13:51.62,0:13:53.75,Default,,0,0,0,,Олай ма еді?
Dialogue: 0,0:13:54.41,0:13:57.54,Default,,0,0,0,,Елордадан шығып, далада Гирдің сөзін естідім.
Dialogue: 0,0:13:58.58,0:14:00.04,Default,,0,0,0,,Өте жақсы болды
Dialogue: 0,0:14:01.46,0:14:04.76,Default,,0,0,0,,Бірақ мен ештеңені өзгерте алмадым.
Dialogue: 0,0:14:06.63,0:14:11.22,Default,,0,0,0,,Gear Мен оның біреудің жүрегіне жететініне сенімдімін
Dialogue: 0,0:14:12.06,0:14:13.97,Default,,0,0,0,,Сол күні мен сияқты
Dialogue: 0,0:14:14.72,0:14:15.68,Default,,0,0,0,,Га
Dialogue: 0,0:14:16.81,0:14:19.48,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:14:19.90,0:14:21.48,Default,,0,0,0,,-Хехе~ Хэхе -Хехе
Dialogue: 0,0:14:22.61,0:14:23.65,Default,,0,0,0,,Хмм
Dialogue: 0,0:14:23.78,0:14:24.98,Default,,0,0,0,,Мен шештім
Dialogue: 0,0:14:25.74,0:14:27.95,Default,,0,0,0,,Енді өзіңіз үшін күресіңіз!
Dialogue: 0,0:14:29.45,0:14:31.70,Default,,0,0,0,,Келіңіздер.
Dialogue: 0,0:14:35.54,0:14:37.58,Default,,0,0,0,,Егер сіз шайқасатын болсаңыз, сізге бұл керек.
Dialogue: 0,0:14:38.50,0:14:40.83,Default,,0,0,0,,Уф... аа!
Dialogue: 0,0:14:41.29,0:14:44.05,Default,,0,0,0,,Дөңгелек…
Dialogue: 0,0:14:44.71,0:14:46.55,Default,,0,0,0,,Баррет…
Dialogue: 0,0:14:47.59,0:14:50.76,Default,,0,0,0,,Оны мұнда алып жүру қиын болды.
Dialogue: 0,0:14:47.59,0:14:51.30,Default,,0,0,0,,Уф... Уф!
Dialogue: 0,0:14:51.39,0:14:52.55,Default,,0,0,0,,Оқ!
Dialogue: 0,0:14:52.68,0:14:56.97,Default,,0,0,0,,Сіздің қауіпсіз болғаныңызға қуаныштымын! Уф
Dialogue: 0,0:14:57.10,0:14:59.64,Default,,0,0,0,,Солай бола тұра, оның жағдайы өте қорқынышты.
Dialogue: 0,0:15:00.02,0:15:00.98,Default,,0,0,0,,Бітті!
Dialogue: 0,0:15:01.10,0:15:03.82,Default,,0,0,0,,Уф! Бұл дұрыс емес!
Dialogue: 0,0:15:04.52,0:15:08.32,Default,,0,0,0,,Әлі жоқ... Бұл жігіт әлі тірі!
Dialogue: 0,0:15:09.78,0:15:12.70,Default,,0,0,0,,Риннің қазір не істеп жатқанын білесің бе?
Dialogue: 0,0:15:14.62,0:15:15.99,Default,,0,0,0,,Өйткені ол...
Dialogue: 0,0:15:17.41,0:15:21.21,Default,,0,0,0,,Мушода кездескенше, сенің аман екеніңді білемін.
Dialogue: 0,0:15:21.62,0:15:23.88,Default,,0,0,0,,Ха... бұл жаман болды.
Dialogue: 0,0:15:26.25,0:15:33.26,Default,,0,0,0,,(Телефон қоңырауының дыбысы)
Dialogue: 0,0:15:35.64,0:15:37.56,Default,,0,0,0,,Сіз енді боссыз
Dialogue: 0,0:15:37.68,0:15:42.10,Default,,0,0,0,,Полиция қызметкерлері және басқалары бұрынғыдай.
Dialogue: 0,0:15:42.23,0:15:47.07,Default,,0,0,0,,(Қоңыраудың үздіксіз соғуы)
Dialogue: 0,0:15:42.77,0:15:44.56,Default,,0,0,0,,Сол себепті
Dialogue: 0,0:15:47.28,0:15:49.07,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:15:49.19,0:15:50.19,Default,,0,0,0,,(Жауап беру құрылғысының теру сигналы)
Dialogue: 0,0:15:50.32,0:15:51.36,Default,,0,0,0,,Оқиғаның орын алуы
Dialogue: 0,0:15:51.49,0:15:55.20,Default,,0,0,0,,Тұтқын түрме аралынан қашып кетіп, теңізге ағып кеткен сияқты
Dialogue: 0,0:15:55.32,0:15:58.16,Default,,0,0,0,,Тұтқындар мен олардың денелерін іздеуге қатысу
Dialogue: 0,0:15:58.33,0:15:59.58,Default,,0,0,0,,(Жазылған хабарламаның дыбысы жойылады)
Dialogue: 0,0:15:59.04,0:16:00.79,Default,,0,0,0,,Хехехе
Dialogue: 0,0:16:00.91,0:16:04.00,Default,,0,0,0,,Мен оларды дәл қазір толықтай сіңіріп алдым.
Dialogue: 0,0:16:04.13,0:16:08.46,Default,,0,0,0,,Хахахаха! Хахахаха!
Dialogue: 0,0:16:09.21,0:16:11.47,Default,,0,0,0,,Әлгі бала түрмеден қашып кеткен сияқты.
Dialogue: 0,0:16:13.01,0:16:14.18,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:16.51,0:16:19.47,Default,,0,0,0,,Сіз дұрыс емес бұрылыс жасадыңыз.
Dialogue: 0,0:16:19.60,0:16:23.64,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:16:21.02,0:16:22.60,Default,,0,0,0,,Кумар! Нұх!
Dialogue: 0,0:16:22.73,0:16:25.02,Default,,0,0,0,,Маған көмектес! Мен мұны пайдалана аламын деп ойлаймын!
Dialogue: 0,0:16:27.73,0:16:31.44,Default,,0,0,0,,Сол жыртылған оқты жөндеп, жылжытуға келгенде.
Dialogue: 0,0:16:31.57,0:16:33.70,Default,,0,0,0,,А, бұл өте азап.
Dialogue: 0,0:16:34.36,0:16:37.24,Default,,0,0,0,,Бұл бөліктердің көп болуына көмектеседі.
Dialogue: 0,0:16:37.37,0:16:41.58,Default,,0,0,0,,Ал, мен білмеймін, олар да маған көмектесіп жатыр.
Dialogue: 0,0:16:42.08,0:16:43.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:43.46,0:16:44.58,Default,,0,0,0,,(дәнекерлеу жұмыстарының дыбысы)
Dialogue: 0,0:16:44.71,0:16:48.21,Default,,0,0,0,,(Өлтіргендердің дыбыстары)
Dialogue: 0,0:16:48.71,0:16:51.46,Default,,0,0,0,,Көлікпен бірге иелерін сою
Dialogue: 0,0:16:52.17,0:16:54.43,Default,,0,0,0,,Мойынды жуып, күт!
Dialogue: 0,0:16:54.55,0:16:55.68,Default,,0,0,0,,Міне осылай
Dialogue: 0,0:16:56.55,0:16:59.81,Default,,0,0,0,,А... кек алу үшін шығар?
Dialogue: 0,0:16:59.93,0:17:01.47,Default,,0,0,0,,Келіңіздер...
Dialogue: 0,0:17:02.77,0:17:06.98,Default,,0,0,0,,Мен астананы өлтіргеннен кейін не болатынын асыға күтемін~
Dialogue: 0,0:17:07.56,0:17:10.94,Default,,0,0,0,,Ахахахахаха
Dialogue: 0,0:17:11.44,0:17:12.44,Default,,0,0,0,,Қолдануға болады
Dialogue: 0,0:17:13.24,0:17:14.24,Default,,0,0,0,,Пайдалану мүмкін емес
Dialogue: 0,0:17:14.61,0:17:15.66,Default,,0,0,0,,Пайдалану мүмкін емес
Dialogue: 0,0:17:16.07,0:17:17.03,Default,,0,0,0,,Қолдануға болады
Dialogue: 0,0:17:17.16,0:17:21.62,Default,,0,0,0,,Эй-баа-баа~ Бүгін кешкі асқа не бар?
Dialogue: 0,0:17:21.74,0:17:25.33,Default,,0,0,0,,Мапо татымды мапо Шин Рамен~
Dialogue: 0,0:17:25.46,0:17:27.42,Default,,0,0,0,,-Уау! иә! -(Үнсіз өлтіруші Лиза) Хмм...
Dialogue: 0,0:17:31.25,0:17:33.71,Default,,0,0,0,,Ақылсыз бұзу жүктемесі астында
Dialogue: 0,0:17:33.84,0:17:36.88,Default,,0,0,0,,Өйткені негізгі жады шынымен нашар болды.
Dialogue: 0,0:17:37.55,0:17:39.30,Default,,0,0,0,,Қанша уақыт...
Dialogue: 0,0:17:40.39,0:17:41.81,Default,,0,0,0,,Уақыт келді ме?
Dialogue: 0,0:17:41.93,0:17:43.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:43.18,0:17:46.10,Default,,0,0,0,,Носамен танысқанымыз жақсы болар еді.
Dialogue: 0,0:17:46.23,0:17:48.81,Default,,0,0,0,,Сіз не туралы айтып тұрсыз, әже?
Dialogue: 0,0:17:48.94,0:17:52.40,Default,,0,0,0,,Жоғалып кетсеңіз, Носаны енді ешқашан көрмейсіз.
Dialogue: 0,0:17:52.69,0:17:53.73,Default,,0,0,0,,Эй-баа
Dialogue: 0,0:17:54.40,0:17:57.66,Default,,0,0,0,,Бірақ сіз білесіз бе, бұл өте қызық.
Dialogue: 0,0:17:58.24,0:18:01.58,Default,,0,0,0,,Мен қазір өте бақыттымын
Dialogue: 0,0:18:05.00,0:18:08.50,Default,,0,0,0,,Сәлем! Қалыңыз қалай?
Dialogue: 0,0:18:08.92,0:18:10.96,Default,,0,0,0,,Жақсы сезіну
Dialogue: 0,0:18:11.09,0:18:13.38,Default,,0,0,0,,Қолөнер ағылып жатыр!
Dialogue: 0,0:18:13.80,0:18:15.13,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:18:15.92,0:18:20.72,Default,,0,0,0,,Бүгінгі күнді жақсы және бақытты өткізейік!
Dialogue: 0,0:18:21.85,0:18:25.56,Default,,0,0,0,,Сіз! Депрессияңызды жойыңыз! Балақай!
Dialogue: 0,0:18:25.68,0:18:27.44,Default,,0,0,0,,Хахаха!
Dialogue: 0,0:18:37.03,0:18:38.03,Default,,0,0,0,,(Үнсіз әңгіме)
Dialogue: 0,0:18:42.28,0:18:44.04,Default,,0,0,0,,(Үнсіз әңгіме)
Dialogue: 0,0:18:51.33,0:18:53.13,Default,,0,0,0,,Иә! Йо! Йо!
Dialogue: 0,0:18:53.63,0:18:56.76,Default,,0,0,0,,Ай мен жұлдыз билеген түн
Dialogue: 0,0:18:56.88,0:19:01.55,Default,,0,0,0,,Махаббат сиқырлы ырғақпен жарқырайды!
Dialogue: 0,0:19:02.18,0:19:06.47,Default,,0,0,0,,Кеттік! Би! Безгек!
Dialogue: 0,0:19:19.61,0:19:24.78,Default,,0,0,0,,(Кісі өлтірушілердің қуанышты дауыстары)
Dialogue: 0,0:19:27.58,0:19:30.50,Default,,0,0,0,,Адам кетіп қалды.
Dialogue: 0,0:19:30.62,0:19:32.67,Default,,0,0,0,,Әркімнің өз дайындығы бар.
Dialogue: 0,0:19:33.29,0:19:35.96,Default,,0,0,0,,Барлығы қайтып келеді деп ойлайсыз ба?
Dialogue: 0,0:19:36.38,0:19:38.55,Default,,0,0,0,,Қайтып келмесең, жақсы.
Dialogue: 0,0:19:38.67,0:19:43.64,Default,,0,0,0,,Мен сізге айттым, мен енді ешкімнің соңынан ергім келмейді немесе маған бағындырғым келмейді.
Dialogue: 0,0:19:44.01,0:19:46.56,Default,,0,0,0,,Әркім өзі үшін күреседі
Dialogue: 0,0:19:48.60,0:19:54.31,Default,,0,0,0,,Сонымен қатар, қалғанын өзіміз басқаратын сияқтымыз.
Dialogue: 0,0:20:12.37,0:20:14.42,Default,,0,0,0,,О! Бұл жақсы~
Dialogue: 0,0:20:14.96,0:20:16.71,Default,,0,0,0,,Сізде әлі бар ма?
Dialogue: 0,0:20:16.84,0:20:18.88,Default,,0,0,0,,Осының бәрін бастаған жігіт
Dialogue: 0,0:20:23.38,0:20:25.14,Default,,0,0,0,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,0:20:30.52,0:20:31.64,Default,,0,0,0,,Жақсы көрінеді!
Dialogue: 0,0:20:31.77,0:20:33.06,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:20:33.19,0:20:34.94,Default,,0,0,0,,- Иә! -аа!
Dialogue: 0,0:20:35.23,0:20:36.36,Default,,0,0,0,,Олай болса.
Dialogue: 0,0:20:36.48,0:20:39.86,Default,,0,0,0,,Менің сынақ жүргізуімді қалайсыз ба?
Dialogue: 0,0:20:43.45,0:20:45.87,Default,,0,0,0,,Доңғалақ Мен оны орнатамын.
Dialogue: 0,0:20:46.28,0:20:49.66,Default,,0,0,0,,Бұл күн де ​​келді.
Dialogue: 0,0:20:51.25,0:20:54.37,Default,,0,0,0,,Мен саған сол жолы бәс тіккеніме қуаныштымын.
Dialogue: 0,0:20:54.50,0:20:56.42,Default,,0,0,0,,Мен үшін де солай.
Dialogue: 0,0:20:56.88,0:20:59.38,Default,,0,0,0,,Сенің арқаңда осы уақытқа дейін келдім.
Dialogue: 0,0:20:59.71,0:21:03.67,Default,,0,0,0,,Мен сенімен бірге болғандықтан, жүгіре алдым.
Dialogue: 0,0:21:05.01,0:21:06.39,Default,,0,0,0,,Беррелл мырза
Dialogue: 0,0:21:06.76,0:21:07.60,Default,,0,0,0,,Хааа~
Dialogue: 0,0:21:07.72,0:21:09.51,Default,,0,0,0,,Ах~ менің қарным ашты~
Dialogue: 0,0:21:09.64,0:21:11.22,Default,,0,0,0,,Мен шаршадым
Dialogue: 0,0:21:11.72,0:21:14.69,Default,,0,0,0,,Уау! Стингрей әже күткендей! рақмет сізге!
Dialogue: 0,0:21:18.40,0:21:19.44,Default,,0,0,0,,Стингрей кемпір?
Dialogue: 0,0:21:22.32,0:21:23.94,Default,,0,0,0,,Ммм
Dialogue: 0,0:21:24.65,0:21:27.57,Default,,0,0,0,,Gear Eiba қазірдің өзінде...
Dialogue: 0,0:21:28.87,0:21:29.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:32.79,0:21:36.71,Default,,0,0,0,,Сіздің постыңызды Конгресс ресми түрде мақұлдады.
Dialogue: 0,0:21:36.83,0:21:41.46,Default,,0,0,0,,Бұдан былай менің оң қолым болып, көңіліңізден шыққанша еңбек етіңіз.
Dialogue: 0,0:21:42.63,0:21:46.47,Default,,0,0,0,,Мемлекет басшысы, мен сіздің өтінішіңізді орындай алмаймын деп қорқамын.
Dialogue: 0,0:21:46.59,0:21:47.51,Default,,0,0,0,,Хмм?
Dialogue: 0,0:21:47.64,0:21:53.22,Default,,0,0,0,,Мына шіркін дүниені өзгерте аламын деп бірде жүгірдім.
Dialogue: 0,0:21:53.93,0:21:56.85,Default,,0,0,0,,Бірақ мен оны қате жасадым.
Dialogue: 0,0:21:57.81,0:21:59.81,Default,,0,0,0,,Заттарды өзгерту
Dialogue: 0,0:21:59.94,0:22:02.94,Default,,0,0,0,,Әлемнің ортасында орналасуы керек
Dialogue: 0,0:22:05.03,0:22:07.86,Default,,0,0,0,,Солай деп ойлап, көзқарасымды өзгерттім.
Dialogue: 0,0:22:08.36,0:22:11.28,Default,,0,0,0,,10 жыл бұрын мен Қарсылықты өз қолыммен саттым.
Dialogue: 0,0:22:11.41,0:22:14.70,Default,,0,0,0,,Бүгінге дейін мен өзімді үкіметке қызмет етуге арнадым.
Dialogue: 0,0:22:15.33,0:22:17.29,Default,,0,0,0,,Үкіметтің жүрегіне ену
Dialogue: 0,0:22:17.71,0:22:18.71,Default,,0,0,0,,Ах
Dialogue: 0,0:22:17.87,0:22:19.79,Default,,0,0,0,,Бұл әлемді өзгерту
Dialogue: 0,0:22:20.67,0:22:22.80,Default,,0,0,0,,Енді көптен күткен тілегім орындалады
Dialogue: 0,0:22:23.46,0:22:28.55,Default,,0,0,0,,Парламентке арналған барлық шаралар мен сіздің жоғалып кетуіңіздің сценарийі бар.
Dialogue: 0,0:22:29.30,0:22:32.56,Default,,0,0,0,,Мен сіздің орныңызда мемлекет басшысының креслосына отырамын.
Dialogue: 0,0:22:33.60,0:22:37.06,Default,,0,0,0,,Мен саясаттың шыңында боламын.
Dialogue: 0,0:22:41.02,0:22:42.15,Default,,0,0,0,,Уау!
Dialogue: 0,0:22:42.27,0:22:43.27,Default,,0,0,0,,(Еденге құлаған дыбыс)
Dialogue: 0,0:22:46.90,0:22:47.90,Default,,0,0,0,,Уау!
Dialogue: 0,0:22:49.57,0:22:52.83,Default,,0,0,0,,Уф... ақымақ жігіт.
Dialogue: 0,0:22:57.37,0:22:58.37,Default,,0,0,0,,Беррелл мырза
Dialogue: 0,0:22:59.42,0:23:00.42,Default,,0,0,0,,О
Dialogue: 0,0:23:01.83,0:23:04.09,Default,,0,0,0,,Бұл шынымен де дұрыс.
Dialogue: 0,0:23:06.30,0:23:09.01,Default,,0,0,0,,Ол нағыз қайырымды адам.
Dialogue: 0,0:23:09.13,0:23:12.47,Default,,0,0,0,,Мұндай нәрселер әлемді өзгертпейді.
Dialogue: 0,0:23:13.89,0:23:19.73,Default,,0,0,0,,Сен менің алақанымда билеп тұрдың
Dialogue: 0,0:23:23.19,0:23:25.73,Default,,0,0,0,,Жолдан бері
Dialogue: 0,0:23:25.86,0:23:27.03,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:23:28.53,0:23:29.99,Default,,0,0,0,,Хмм... хмм?
Dialogue: 0,0:23:30.86,0:23:31.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:33.70,0:23:34.66,Default,,0,0,0,,(ауада атыс дыбысы)
Dialogue: 0,0:23:34.78,0:23:38.00,Default,,0,0,0,,Оёёёёёёё~
Dialogue: 0,0:23:38.12,0:23:40.50,Default,,0,0,0,,(ауада атыс дыбысы)
Dialogue: 0,0:23:40.79,0:23:43.33,Default,,0,0,0,,Ой... сен несің!
Dialogue: 0,0:23:44.08,0:23:49.26,Default,,0,0,0,,Ол бұл әлемді шынымен басқарады.
Dialogue: 0,0:23:49.38,0:23:50.55,Default,,0,0,0,,(қуатты өшіру дыбысы)
Dialogue: 0,0:23:53.55,0:23:57.85,Default,,0,0,0,,Дүние сен ойлағаннан да күрделі.
Dialogue: 0,0:24:02.81,0:24:04.15,Default,,0,0,0,,Уф
Dialogue: 0,0:24:04.52,0:24:05.52,Default,,0,0,0,,Әдетте, сақ болу үшін, су астында олардың бірнешеуін күзетте ұстауымыз керек еді.
Dialogue: 0,0:24:06.32,0:24:10.65,Default,,0,0,0,,Бұл Лордтың шытырман оқиғасының соңы.
Dialogue: 0,0:24:10.78,0:24:12.28,Default,,0,0,0,,(Лазерлік жұмыс дыбысы)
Dialogue: 0,0:24:12.40,0:24:14.91,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:24:19.04,0:24:20.33,Default,,0,0,0,,Wi…
Dialogue: 0,0:24:20.45,0:24:22.21,Default,,0,0,0,,Баррель мырза…
Dialogue: 0,0:24:22.33,0:24:23.50,Default,,0,0,0,,Уф!
Dialogue: 0,0:24:22.33,0:24:23.96,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:24:27.09,0:24:30.38,Default,,0,0,0,,Дөңгелектер! Мықты болыңыз! Доңғалақ!
Dialogue: 0,0:24:30.51,0:24:32.30,Default,,0,0,0,,Вертолёт қонды.
Dialogue: 0,0:24:32.42,0:24:36.18,Default,,0,0,0,,Немесе... сөзсіз... орындаңыз...
Dialogue: 0,0:24:38.60,0:24:40.06,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:24:40.39,0:24:43.56,Default,,0,0,0,,Мен оның өлетінін күтпедім.
Dialogue: 0,0:24:43.69,0:24:46.52,Default,,0,0,0,,Бұдан ләззат ала алмайсыз.
Dialogue: 0,0:24:46.65,0:24:48.32,Default,,0,0,0,,Мен не істерімді білмеймін
Dialogue: 0,0:24:49.69,0:24:50.78,Default,,0,0,0,,Иә
Dialogue: 0,0:24:50.90,0:24:53.20,Default,,0,0,0,,Бұл жақсы жұмыс болды.
Dialogue: 0,0:24:56.82,0:25:02.54,Default,,0,0,0,,Сіз мұны әлі де жасай аласыз, тек көбірек тырысыңыз.
Dialogue: 0,0:25:02.66,0:25:03.71,Default,,0,0,0,,Адам аяғы тимейтін орынды әдейі таңдаған...
Dialogue: 0,0:25:04.46,0:25:07.08,Default,,0,0,0,,Өйткені бұл көп күлкі болатын сияқты
Dialogue: 0,0:25:07.54,0:25:12.84,Default,,0,0,0,,Ит ешқашан шынжырдан құтыла алмайды, солай ма?
Dialogue: 0,0:25:13.51,0:25:18.35,Default,,0,0,0,,Хахахахахаха! Ахахахаххахаха!
Dialogue: 0,0:25:18.47,0:25:21.85,Default,,0,0,0,,Мен жалғыз қалдым ба?
Dialogue: 0,0:25:26.31,0:25:27.86,Default,,0,0,0,,(терезені түрту дыбысы)
Dialogue: 0,0:25:27.02,0:25:27.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:27.98,0:25:28.90,Default,,0,0,0,,Сонымен…
Dialogue: 0,0:25:29.02,0:25:30.11,Default,,0,0,0,,Иә
Dialogue: 0,0:25:32.82,0:25:35.15,Default,,0,0,0,,Сіз Стингрей әжей туралы ойладыңыз ба?
Dialogue: 0,0:25:36.28,0:25:39.03,Default,,0,0,0,,Ертең мен сені қолымнан келгенше ұрамын
Dialogue: 0,0:25:39.62,0:25:43.66,Default,,0,0,0,,Эй-ба мен Носа-ни де дәл осылай айтатынына сенімдімін.
Dialogue: 0,0:25:44.04,0:25:45.04,Default,,0,0,0,,Иә.
Dialogue: 0,0:25:46.00,0:25:47.79,Default,,0,0,0,,Иә?не?
Dialogue: 0,0:25:48.42,0:25:50.13,Default,,0,0,0,,Бұрынғы өтемақы
Dialogue: 0,0:25:50.25,0:25:53.05,Default,,0,0,0,,Мен уәдемді орындаймын.
Dialogue: 0,0:25:53.34,0:25:56.43,Default,,0,0,0,,Не болды? Кенеттен осылай
Dialogue: 0,0:25:56.80,0:25:59.43,Default,,0,0,0,,Мен ертең Gear-мен бара алмаймын.
Dialogue: 0,0:25:59.55,0:26:01.18,Default,,0,0,0,,Мен басқаша әрекет етемін
Dialogue: 0,0:26:01.31,0:26:02.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:26:02.39,0:26:03.35,Default,,0,0,0,,(сөмкені салу дыбысы)
Dialogue: 0,0:26:03.47,0:26:05.31,Default,,0,0,0,,Сіздің басқа істеріңіз бар ма?
Dialogue: 0,0:26:06.23,0:26:07.06,Default,,0,0,0,,Не?
Dialogue: 0,0:26:07.19,0:26:09.40,Default,,0,0,0,,♪～
Dialogue: 0,0:26:07.85,0:26:11.48,Default,,0,0,0,,Мен әлемді өзгерту үшін күрестім.
Dialogue: 0,0:26:11.61,0:26:16.03,Default,,0,0,0,,Мен әлемді тек мен ғана өзгерте алатынымды түсіндім.
Dialogue: 0,0:26:16.86,0:26:17.86,Default,,0,0,0,,Нұх
Dialogue: 0,0:26:19.24,0:26:24.12,Default,,0,0,0,,Бұл жекпе-жек мен өзім үшін күресуді шештім.
Dialogue: 0,0:26:24.24,0:26:25.62,Default,,0,0,0,,Мен сенімен бара алмаймын.
Dialogue: 0,0:26:26.37,0:26:31.63,Default,,0,0,0,,Бірақ баратын жер бірдей болса, жолдар қайтадан араласады.
Dialogue: 0,0:26:31.75,0:26:32.96,Default,,0,0,0,,Міндетті түрде.
Dialogue: 0,0:26:33.75,0:26:34.76,Default,,0,0,0,,Иә
Dialogue: 0,0:26:35.42,0:26:37.01,Default,,0,0,0,,Ей, тыңдайыншы.
Dialogue: 0,0:26:37.13,0:26:40.72,Default,,0,0,0,,Эй-ба мен Носа-ни туралы және менің шеберім туралы естеліктер
Dialogue: 0,0:26:41.30,0:26:44.10,Default,,0,0,0,,Мен беріліс туралы көбірек білгім келеді
Dialogue: 0,0:26:46.14,0:26:49.73,Default,,0,0,0,,Иә, Нұх туралы да айтып беріңізші.
Dialogue: 0,0:26:50.27,0:26:52.44,Default,,0,0,0,,Мен Нұх туралы көбірек білгім келеді
Dialogue: 0,0:26:59.99,0:27:03.74,Default,,0,0,0,,(Үнсіз әңгіме)
Dialogue: 0,0:27:05.04,0:27:07.75,Default,,0,0,0,,(Үнсіз әңгіме)
Dialogue: 0,0:27:31.65,0:27:34.69,Default,,0,0,0,,～♪
Dialogue: 0,0:27:34.82,0:27:38.65,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:27:35.52,0:27:42.41,Default,,0,0,0,,(Көптеген көліктердің дыбысы)
Dialogue: 0,0:27:42.53,0:27:45.95,Default,,0,0,0,,(Бірнеше мүйіз дыбысы)
Dialogue: 0,0:27:47.45,0:27:53.45,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
