Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.61,0:00:08.17,Default,,0,0,0,,Галлияға бет алған материал жинау тобымен байланыс үзілді.
Dialogue: 0,0:00:08.47,0:00:09.61,Default,,0,0,0,,Есеп алынды.
Dialogue: 0,0:00:09.84,0:00:10.71,Default,,0,0,0,,Тоқтатылды ма?
Dialogue: 0,0:00:10.99,0:00:12.33,Default,,0,0,0,,Оның себебі неде?
Dialogue: 0,0:00:12.71,0:00:13.72,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,0:00:14.00,0:00:16.34,Default,,0,0,0,,Материал жинау тобы қайда жетекшілік етті?
Dialogue: 0,0:00:16.60,0:00:17.87,Default,,0,0,0,,Үлкен аңғар
Dialogue: 0,0:00:18.39,0:00:19.21,Default,,0,0,0,,Ұлы алқап…
Dialogue: 0,0:00:19.84,0:00:22.17,Default,,0,0,0,,Құтқару жұмыстарына дереу дайындалыңыз!
Dialogue: 0,0:00:22.20,0:00:22.90,Default,,0,0,0,,Ха!
Dialogue: 0,0:00:22.96,0:00:24.62,Default,,0,0,0,,Қазір Галлияға барыңыз!
Dialogue: 0,0:00:27.63,0:00:28.78,Default,,0,0,0,,Сиқырлы кристал?
Dialogue: 0,0:00:28.80,0:00:29.68,Default,,0,0,0,,Иә
Dialogue: 0,0:00:29.99,0:00:34.81,Default,,0,0,0,,Бұл материал Мукуроның қылышына сай қабық жасау үшін өте қажет.
Dialogue: 0,0:00:34.94,0:00:37.63,Default,,0,0,0,,Бірақ соңғы кездері ала алмай жүрмін.
Dialogue: 0,0:00:38.53,0:00:39.95,Default,,0,0,0,,Келу мүмкіндігі бар ма?
Dialogue: 0,0:00:40.21,0:00:44.44,Default,,0,0,0,,Сиқырлы кристалды корольдік астаналық армия басқарады, сондықтан мен егжей-тегжейлерін білмеймін...
Dialogue: 0,0:00:44.48,0:00:47.30,Default,,0,0,0,,Егер сізде жоқ болса, оны өзіңіз аласыз.
Dialogue: 0,0:00:47.49,0:00:49.17,Default,,0,0,0,,Тағдыр Мен барып аламын.
Dialogue: 0,0:00:49.70,0:00:52.55,Default,,0,0,0,,Нефрит Сиқырлы кристалды қайдан алуға болады?
Dialogue: 0,0:00:52.57,0:00:54.55,Default,,0,0,0,,Оны Галлияда алуға болады...
Dialogue: 0,0:00:54.82,0:00:55.93,Default,,0,0,0,,Галлия?
Dialogue: 0,0:00:55.95,0:00:57.95,Default,,0,0,0,,Мен Тодомен мүмкіндігінше тезірек кездескім келеді—немесе ең болмағанда Мивамен—бірақ
Dialogue: 0,0:00:58.11,0:00:58.77,Default,,0,0,0,,Мен барып аламын.
Dialogue: 0,0:00:58.80,0:00:59.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:59.38,0:01:00.26,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:01:00.49,0:01:02.15,Default,,0,0,0,,Біз оны сәйкесінше арзандатамыз.
Dialogue: 0,0:01:02.91,0:01:04.82,Default,,0,0,0,,Менің қожайыным бұрынғы әскери адам болатын.
Dialogue: 0,0:01:04.98,0:01:08.26,Default,,0,0,0,,Бұл менің жас кезімде материал жинауға барған жерлерімнің картасы.
Dialogue: 0,0:01:09.35,0:01:12.31,Default,,0,0,0,,Белгіленген аумақ біршама оңтүстікте.
Dialogue: 0,0:01:12.69,0:01:14.12,Default,,0,0,0,,Ұлы алқаптың жанында.
Dialogue: 0,0:01:14.28,0:01:15.13,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:01:15.16,0:01:18.37,Default,,0,0,0,,Өзімнің қынабымды жасау үшін саяхатқа аттанайық!
Dialogue: 0,0:01:19.54,0:01:24.54,Default,,0,0,0,,♪～
Dialogue: 0,0:02:43.20,0:02:48.20,Default,,0,0,0,,～♪
Dialogue: 0,0:02:53.39,0:02:54.41,Default,,0,0,0,,Ашкөздік!
Dialogue: 0,0:02:54.44,0:02:54.92,Default,,0,0,0,,О!
Dialogue: 0,0:02:54.94,0:02:56.25,Default,,0,0,0,,Қалқан башпен барайық!
Dialogue: 0,0:02:56.27,0:02:58.27,Default,,0,0,0,,Енді түсіндіңдер, мақтауға рұқсат етіңіздер.
Dialogue: 0,0:03:03.46,0:03:05.12,Default,,0,0,0,,Келесі жолы осы жерден кетеміз!
Dialogue: 0,0:03:12.46,0:03:14.87,Default,,0,0,0,,Ашкөздік дағдысы іске қосылады
Dialogue: 0,0:03:15.92,0:03:17.92,Default,,0,0,0,,Ашкөздік дағдысы іске қосылады
Dialogue: 0,0:03:16.88,0:03:18.88,Default,,0,0,0,,Ашкөздік дағдысы іске қосылады
Dialogue: 0,0:03:17.92,0:03:19.92,Default,,0,0,0,,Ашкөздік дағдысы іске қосылады
Dialogue: 0,0:03:18.90,0:03:20.90,Default,,0,0,0,,Ашкөздік дағдысы іске қосылады
Dialogue: 0,0:03:19.94,0:03:21.94,Default,,0,0,0,,Ашкөздік дағдысы іске қосылады
Dialogue: 0,0:03:20.98,0:03:22.98,Default,,0,0,0,,Ашкөздік дағдысы іске қосылады
Dialogue: 0,0:03:22.00,0:03:24.00,Default,,0,0,0,,Ашкөздік дағдысы іске қосылады
Dialogue: 0,0:03:26.32,0:03:30.39,Default,,0,0,0,,Құрметті Рокси, мынаны қараңызшы.
Dialogue: 0,0:03:31.45,0:03:32.49,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:03:33.15,0:03:35.47,Default,,0,0,0,,Ой, мен компасты пайдалана алмаймын.
Dialogue: 0,0:03:35.49,0:03:36.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:36.34,0:03:39.43,Default,,0,0,0,,Сонымен Ұлы аңғарға қалай жетеміз?
Dialogue: 0,0:03:39.89,0:03:43.57,Default,,0,0,0,,Әдетте біз ай мен жұлдыздардың орналасуынан бағытты таба аламыз.
Dialogue: 0,0:03:44.20,0:03:45.59,Default,,0,0,0,,Бұл бұлтта...
Dialogue: 0,0:03:46.20,0:03:48.40,Default,,0,0,0,,Айды да көре алмайсың...
Dialogue: 0,0:03:50.49,0:03:55.20,Default,,0,0,0,,Бұлтты ақымақ――! !
Dialogue: 0,0:03:56.62,0:03:58.46,Default,,0,0,0,,Галияның шамамен орналасқан жері
Dialogue: 0,0:03:58.49,0:04:00.94,Default,,0,0,0,,Орктардың тығыздығына қарап білуге болады.
Dialogue: 0,0:04:00.96,0:04:02.82,Default,,0,0,0,,Орк тығыздығы?
Dialogue: 0,0:04:02.96,0:04:04.77,Default,,0,0,0,,А?
Dialogue: 0,0:04:04.89,0:04:05.58,Default,,0,0,0,,Иә
Dialogue: 0,0:04:05.93,0:04:09.79,Default,,0,0,0,,Жазбалар орк колониясының ең оңтүстік шетінде екенін көрсетеді.
Dialogue: 0,0:04:10.08,0:04:14.60,Default,,0,0,0,,Басқаша айтқанда, егер сіз орктар пайда болған бағытта жүрсеңіз, сіз Ұлы аңғарға жақындайсыз.
Dialogue: 0,0:04:15.15,0:04:17.77,Default,,0,0,0,,Орктар Галлиядағы жалғыз құбыжықтар емес.
Dialogue: 0,0:04:17.84,0:04:20.49,Default,,0,0,0,,Тәжі құбыжықтар да осы нүктеден тыс өмір сүреді.
Dialogue: 0,0:04:20.62,0:04:22.32,Default,,0,0,0,,Ендеше, өзімізді дайындап алайық
Dialogue: 0,0:04:25.69,0:04:27.58,Default,,0,0,0,,Мен тақтаны аздап бақылап отырдым.
Dialogue: 0,0:04:27.83,0:04:28.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:28.62,0:04:29.60,Default,,0,0,0,,Не?
Dialogue: 0,0:04:29.62,0:04:34.76,Default,,0,0,0,,Жауынгер ретінде кез келген жағдайда денеңізді демалдырып, ұрысқа дайындалыңыз.
Dialogue: 0,0:04:34.78,0:04:36.19,Default,,0,0,0,,Шу!
Dialogue: 0,0:04:43.49,0:04:45.82,Default,,0,0,0,,Бұл қай жер?
Dialogue: 0,0:04:50.21,0:04:51.21,Default,,0,0,0,,Сен…
Dialogue: 0,0:04:54.27,0:04:55.56,Default,,0,0,0,,Сол кезде...
Dialogue: 0,0:05:00.94,0:05:01.68,Default,,0,0,0,,―Қа…
Dialogue: 0,0:05:03.48,0:05:07.03,Default,,0,0,0,,Шудың қатты шыққаны сонша, мен оны ести алмаймын...не деп тұрсың...
Dialogue: 0,0:05:07.74,0:05:08.55,Default,,0,0,0,,Га
Dialogue: 0,0:05:09.04,0:05:09.76,Default,,0,0,0,,Ха!?
Dialogue: 0,0:05:19.67,0:05:20.23,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:05:20.57,0:05:21.18,Default,,0,0,0,,Га
Dialogue: 0,0:05:23.84,0:05:24.92,Default,,0,0,0,,Уау
Dialogue: 0,0:05:26.08,0:05:27.56,Default,,0,0,0,,Ха болды…
Dialogue: 0,0:05:29.02,0:05:30.34,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:05:33.07,0:05:34.56,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:05:42.78,0:05:43.73,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:44.29,0:05:47.17,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,0:05:47.87,0:05:48.81,Default,,0,0,0,,Бұл не болды?
Dialogue: 0,0:05:49.12,0:05:49.82,Default,,0,0,0,,Қазір ғана…
Dialogue: 0,0:05:50.11,0:05:50.89,Default,,0,0,0,,Га
Dialogue: 0,0:05:51.20,0:05:52.60,Default,,0,0,0,,Ашкөздік Бұл құбыжық.
Dialogue: 0,0:05:53.16,0:05:54.98,Default,,0,0,0,,Бұл оркқа ұқсамайды.
Dialogue: 0,0:05:55.17,0:05:56.35,Default,,0,0,0,,Бұл тәж.
Dialogue: 0,0:05:56.38,0:05:57.44,Default,,0,0,0,,Бұл бірден көп!
Dialogue: 0,0:05:57.48,0:05:58.36,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:06:03.74,0:06:04.57,Default,,0,0,0,,Ол қайда?
Dialogue: 0,0:06:04.95,0:06:06.57,Default,,0,0,0,,Түнгі көру дағдыларыңызды пайдаланыңыз!
Dialogue: 0,0:06:06.60,0:06:07.69,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:06:10.46,0:06:11.28,Default,,0,0,0,,Міне болды!
Dialogue: 0,0:06:11.36,0:06:13.25,Default,,0,0,0,,Саламандр
Dialogue: 0,0:06:13.28,0:06:14.55,Default,,0,0,0,,4!
Dialogue: 0,0:06:15.45,0:06:17.38,Default,,0,0,0,,Мені қара бантикке айналдыр!
Dialogue: 0,0:06:17.51,0:06:20.13,Default,,0,0,0,,Тастау сиқырымен алдын ала шабуыл!
Dialogue: 0,0:06:23.32,0:06:24.09,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:06:24.48,0:06:26.16,Default,,0,0,0,,Мен тағы біреуін өлтіремін!
Dialogue: 0,0:06:26.45,0:06:27.28,Default,,0,0,0,,Күте тұрыңыз, Ашкөздік!
Dialogue: 0,0:06:27.30,0:06:27.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:27.82,0:06:29.88,Default,,0,0,0,,Саламандр біртүрлі әрекет етеді.
Dialogue: 0,0:06:31.93,0:06:36.52,Default,,0,0,0,,Иә, ауыр жарақат алған кезде сіздің түйсігіңіз қашып кетеді.
Dialogue: 0,0:06:36.54,0:06:40.88,Default,,0,0,0,,Мен қашпаймын, өлтірілген достарымнан кек алуға келмеймін.
Dialogue: 0,0:06:40.90,0:06:42.04,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:06:42.06,0:06:44.79,Default,,0,0,0,,Сізді бірдеңе басқарып жатқан сияқты.
Dialogue: 0,0:06:45.26,0:06:46.72,Default,,0,0,0,,Сізді манипуляциялап жатыр ма?
Dialogue: 0,0:06:47.27,0:06:48.60,Default,,0,0,0,,Жарайды, қуып жіберейік!
Dialogue: 0,0:06:48.62,0:06:50.12,Default,,0,0,0,,О
Dialogue: 0,0:06:59.66,0:07:00.54,Default,,0,0,0,,Не болды?
Dialogue: 0,0:07:02.21,0:07:04.13,Default,,0,0,0,,Саламандрлармен қоршалған!
Dialogue: 0,0:07:12.27,0:07:14.72,Default,,0,0,0,,Солтүстік! Солтүстік қайда?
Dialogue: 0,0:07:14.74,0:07:16.23,Default,,0,0,0,,Құрметті Рокси
Dialogue: 0,0:07:17.28,0:07:20.87,Default,,0,0,0,,Кешіріңіз, сізді бұзды.
Dialogue: 0,0:07:20.90,0:07:21.92,Default,,0,0,0,,...
Dialogue: 0,0:07:21.94,0:07:23.66,Default,,0,0,0,,Қауіпті!
Dialogue: 0,0:07:23.68,0:07:24.66,Default,,0,0,0,,Мен… мен…
Dialogue: 0,0:07:24.68,0:07:26.26,Default,,0,0,0,,Бұл керемет күш.
Dialogue: 0,0:07:26.53,0:07:30.09,Default,,0,0,0,,Рокси-самамен аралассаң, мен сені кешірмеймін!
Dialogue: 0,0:07:30.11,0:07:32.57,Default,,0,0,0,,Сиқырлы қылыш Фламберг!
Dialogue: 0,0:07:35.26,0:07:36.55,Default,,0,0,0,,Бұл жұмыс істемейді!
Dialogue: 0,0:07:37.01,0:07:39.15,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:39.90,0:07:40.92,Default,,0,0,0,,Идиот!
Dialogue: 0,0:07:40.95,0:07:43.52,Default,,0,0,0,,Саламандрға қарсы сиқырлы қылыш қолдана алатын адам бар ма?
Dialogue: 0,0:07:44.08,0:07:45.96,Default,,0,0,0,,Жақсысың ба? Милия!
Dialogue: 0,0:07:53.43,0:07:54.43,Default,,0,0,0,,Сіз жарақат алдыңыз ба?
Dialogue: 0,0:07:55.20,0:07:56.15,Default,,0,0,0,,Мукуро мырза?
Dialogue: 0,0:07:58.83,0:07:59.86,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:08:01.73,0:08:03.07,Default,,0,0,0,,Өткір жиектер!
Dialogue: 0,0:08:06.60,0:08:09.37,Default,,0,0,0,,Жалпы өткір қыры бар бұл күш?
Dialogue: 0,0:08:09.39,0:08:10.77,Default,,0,0,0,,Бұл үлкен мәселе.
Dialogue: 0,0:08:17.73,0:08:18.46,Default,,0,0,0,,...
Dialogue: 0,0:08:20.02,0:08:22.59,Default,,0,0,0,,...
Dialogue: 0,0:08:22.89,0:08:26.78,Default,,0,0,0,,...
Dialogue: 0,0:08:27.91,0:08:29.18,Default,,0,0,0,,Қарашы, Мирия да.
Dialogue: 0,0:08:29.30,0:08:32.56,Default,,0,0,0,,...
Dialogue: 0,0:08:32.76,0:08:35.99,Default,,0,0,0,,Тіпті мен Рокси-самаға көмектескім келді.
Dialogue: 0,0:08:36.07,0:08:37.14,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:08:37.43,0:08:37.95,Default,,0,0,0,,...
Dialogue: 0,0:08:38.32,0:08:39.55,Default,,0,0,0,,Қыздың жеткізуге тиіс жері қай жерде—
Dialogue: 0,0:08:40.43,0:08:42.21,Default,,0,0,0,,Мен Мұған, бөлімше командирімін.
Dialogue: 0,0:08:42.73,0:08:44.32,Default,,0,0,0,,Бұл ақымақ Мирия.
Dialogue: 0,0:08:44.42,0:08:44.97,Default,,0,0,0,,Хун
Dialogue: 0,0:08:44.99,0:08:46.62,Default,,0,0,0,,Кәне, маған дұрыс рахмет айт.
Dialogue: 0,0:08:46.74,0:08:49.36,Default,,0,0,0,,Сізге үлкен рахмет~
Dialogue: 0,0:08:49.81,0:08:52.60,Default,,0,0,0,,Ол солтүстік, Вавилонның қасиетті рыцары.
Dialogue: 0,0:08:53.44,0:08:55.43,Default,,0,0,0,,Бұл маған шынымен көмектесті
Dialogue: 0,0:08:55.50,0:08:56.90,Default,,0,0,0,,Алғыс айту жақсы
Dialogue: 0,0:08:57.42,0:08:59.87,Default,,0,0,0,,Тағы бір алаңдатарлық нәрсе бар.
Dialogue: 0,0:09:00.68,0:09:01.64,Default,,0,0,0,,Уау~
Dialogue: 0,0:09:02.31,0:09:03.93,Default,,0,0,0,,Елтаңбаға ұқсайды
Dialogue: 0,0:09:04.73,0:09:07.39,Default,,0,0,0,,Бұл саламандрдың да қыры бар.
Dialogue: 0,0:09:07.97,0:09:09.40,Default,,0,0,0,,Сондай-ақ осы жерден табуға болады
Dialogue: 0,0:09:10.13,0:09:14.03,Default,,0,0,0,,4
Dialogue: 0,0:09:14.05,0:09:16.05,Default,,0,0,0,,Барған сайын күдікті болып барады.
Dialogue: 0,0:09:16.07,0:09:17.29,Default,,0,0,0,,...
Dialogue: 0,0:09:17.32,0:09:18.82,Default,,0,0,0,,Ұф… сен, кішкентай сорлы.
Dialogue: 0,0:09:19.26,0:09:22.71,Default,,0,0,0,,Тәж киген құбыжықтар әдетте ынтымақтаспайды.
Dialogue: 0,0:09:22.73,0:09:24.30,Default,,0,0,0,,(Деку) Иә. (Яо) Жарайды.
Dialogue: 0,0:09:24.32,0:09:27.13,Default,,0,0,0,,Олар Рокси-саманы нысанаға алғандай болды.
Dialogue: 0,0:09:27.46,0:09:29.09,Default,,0,0,0,,Бұл жай ғана кездейсоқтық.
Dialogue: 0,0:09:32.36,0:09:34.87,Default,,0,0,0,,Біз Галлияда не болатынын білмейміз.
Dialogue: 0,0:09:35.49,0:09:38.86,Default,,0,0,0,,Әсіресе Тенрю ұядан кеткен соң.
Dialogue: 0,0:09:46.68,0:09:48.40,Default,,0,0,0,,Бұл Ұлы алқап.
Dialogue: 0,0:09:48.55,0:09:50.24,Default,,0,0,0,,Рахмет, бұл пайдалы болды.
Dialogue: 0,0:09:50.51,0:09:51.51,Default,,0,0,0,,Жоқ
Dialogue: 0,0:09:51.76,0:09:55.47,Default,,0,0,0,,Сенің баратын жерің біздікімен бірдей болғанына қуаныштымын, Мукуро-доно.
Dialogue: 0,0:09:55.50,0:10:00.19,Default,,0,0,0,,...
Dialogue: 0,0:10:00.46,0:10:02.92,Default,,0,0,0,,Кеттік, Рокси-сама.
Dialogue: 0,0:10:03.23,0:10:05.51,Default,,0,0,0,,Сіз қауіпсізсіз деп үміттенемін.
Dialogue: 0,0:10:08.38,0:10:12.03,Default,,0,0,0,,Ақыл оқу дағдысының іске қосылғанын қаламайсыз ба?
Dialogue: 0,0:10:15.31,0:10:18.14,Default,,0,0,0,,Мен мұнда Рокси-саманы қорғауым керек.
Dialogue: 0,0:10:18.16,0:10:21.72,Default,,0,0,0,,Кішкене күштірек болдым деп алданып қалма, қаңқа жігіт.
Dialogue: 0,0:10:21.74,0:10:24.41,Default,,0,0,0,,Жаман жәндіктерден тез арыл.
Dialogue: 0,0:10:24.95,0:10:27.34,Default,,0,0,0,,Милия, сен не істеп жатырсың?
Dialogue: 0,0:10:27.48,0:10:27.75,Default,,0,0,0,,Ах
Dialogue: 0,0:10:27.78,0:10:28.51,Default,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:10:29.54,0:10:30.90,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:10:30.93,0:10:31.70,Default,,0,0,0,,Жоқ
Dialogue: 0,0:10:32.89,0:10:34.49,Default,,0,0,0,,Енді барайық
Dialogue: 0,0:10:34.51,0:10:35.26,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:35.69,0:10:37.55,Default,,0,0,0,,Фу хахахахаха
Dialogue: 0,0:10:37.66,0:10:39.14,Default,,0,0,0,,Жаман жәндік?
Dialogue: 0,0:10:39.37,0:10:40.29,Default,,0,0,0,,Шу!
Dialogue: 0,0:10:51.91,0:10:53.50,Default,,0,0,0,,Ауа жақсы
Dialogue: 0,0:10:53.52,0:10:56.77,Default,,0,0,0,,Тек осы бөлігі ғана тазартылғандай.
Dialogue: 0,0:10:57.05,0:10:59.69,Default,,0,0,0,,Бұл ескі шайқастың әсері болуы керек.
Dialogue: 0,0:11:02.01,0:11:03.78,Default,,0,0,0,,Құбыжық тасқа айналған ба?
Dialogue: 0,0:11:04.52,0:11:06.70,Default,,0,0,0,,Осы ерекше ортаның арқасында шығар
Dialogue: 0,0:11:07.20,0:11:09.10,Default,,0,0,0,,Құбыжық зираты?
Dialogue: 0,0:11:09.93,0:11:10.44,Default,,0,0,0,,Ха!
Dialogue: 0,0:11:10.83,0:11:11.49,Default,,0,0,0,,Не болды?
Dialogue: 0,0:11:11.56,0:11:13.04,Default,,0,0,0,,Сиқырлы кристал болды ма?
Dialogue: 0,0:11:14.33,0:11:16.61,Default,,0,0,0,,Е, жоқ, ештеңе.
Dialogue: 0,0:11:18.70,0:11:23.40,Default,,0,0,0,,Сиқырлы кристал түссіз және мөлдір, ақшыл күлгін түспен жарқырайды.
Dialogue: 0,0:11:24.34,0:11:26.29,Default,,0,0,0,,Жоқ, солай ма? Ол емес
Dialogue: 0,0:11:29.63,0:11:30.53,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:11:33.57,0:11:34.45,Default,,0,0,0,,Эллис?
Dialogue: 0,0:11:44.06,0:11:46.16,Default,,0,0,0,,Цк, жоғалтып алдың ба?
Dialogue: 0,0:11:46.18,0:11:46.89,Default,,0,0,0,,Тағдыр!
Dialogue: 0,0:11:47.22,0:11:48.63,Default,,0,0,0,,Қараңызшы.
Dialogue: 0,0:11:48.66,0:11:48.96,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:11:49.36,0:11:50.39,Default,,0,0,0,,Міне!
Dialogue: 0,0:11:51.76,0:11:53.27,Default,,0,0,0,,Химера?
Dialogue: 0,0:11:55.44,0:11:56.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:56.10,0:11:57.18,Default,,0,0,0,,Қаза алмаймыз ба? Бұл бұйрық па?
Dialogue: 0,0:11:57.20,0:11:59.99,Default,,0,0,0,,Бұл прототип. Жақынырақ қараңыз.
Dialogue: 0,0:12:00.01,0:12:01.31,Default,,0,0,0,,Өзегі жоқ
Dialogue: 0,0:12:01.42,0:12:02.43,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:12:02.69,0:12:05.21,Default,,0,0,0,,Бұрынғы шайқаста не көмілген
Dialogue: 0,0:12:05.24,0:12:08.45,Default,,0,0,0,,Тау жынысы опырылып, беті ашылды?
Dialogue: 0,0:12:11.66,0:12:14.41,Default,,0,0,0,,Сондай-ақ сол жерде іргетастың құлаған жері бар.
Dialogue: 0,0:12:16.85,0:12:18.84,Default,,0,0,0,,Ол біршама бұзылған.
Dialogue: 0,0:12:18.88,0:12:21.24,Default,,0,0,0,,Біреулер оянған сияқты.
Dialogue: 0,0:12:22.79,0:12:24.08,Default,,0,0,0,,Үш дене...
Dialogue: 0,0:12:25.94,0:12:27.58,Default,,0,0,0,,Ол солай істеді ме?
Dialogue: 0,0:12:32.15,0:12:33.51,Default,,0,0,0,,Шығыс жағы?
Dialogue: 0,0:12:33.54,0:12:35.61,Default,,0,0,0,,Рокси-сама оны іздеп кетті.
Dialogue: 0,0:12:35.63,0:12:37.66,Default,,0,0,0,,Бұрынғыдай үлгі.
Dialogue: 0,0:12:37.68,0:12:39.19,Default,,0,0,0,,Сіз тағы да Роксиді нысанаға аласыз ба?
Dialogue: 0,0:12:39.40,0:12:41.95,Default,,0,0,0,,Ол енді сиқырлы кристалға да тұрмайды.
Dialogue: 0,0:12:46.80,0:12:49.10,Default,,0,0,0,,Мен Рокси-саманы қорғаймын!
Dialogue: 0,0:12:49.13,0:12:49.89,Default,,0,0,0,,Милия!
Dialogue: 0,0:12:53.07,0:12:53.95,Default,,0,0,0,,Милия!
Dialogue: 0,0:12:56.95,0:12:57.27,Default,,0,0,0,,Өтірік!
Dialogue: 0,0:12:57.27,0:12:58.02,Default,,0,0,0,,Мұған!
Dialogue: 0,0:12:58.52,0:12:59.25,Default,,0,0,0,,Мұған!
Dialogue: 0,0:13:00.72,0:13:01.83,Default,,0,0,0,,Солтүстік!
Dialogue: 0,0:13:11.35,0:13:12.53,Default,,0,0,0,,Мукуро мырза!
Dialogue: 0,0:13:17.29,0:13:18.02,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:13:18.04,0:13:21.81,Default,,0,0,0,,Мұған Мирияны қорғау кезінде жарақат алды.
Dialogue: 0,0:13:22.39,0:13:23.34,Default,,0,0,0,,Солтүстік
Dialogue: 0,0:13:28.57,0:13:30.71,Default,,0,0,0,,Ойнату жылдамдығы осыған байланысты ма?
Dialogue: 0,0:13:31.02,0:13:32.69,Default,,0,0,0,,...
Dialogue: 0,0:13:32.93,0:13:36.23,Default,,0,0,0,,Бұл жігіттерді химералар деп атайды, ал олардың өзегі - әлсіз жері.
Dialogue: 0,0:13:36.26,0:13:37.15,Default,,0,0,0,,Негізгі?
Dialogue: 0,0:13:37.18,0:13:40.05,Default,,0,0,0,,Сіздің кеудеңізде құбыжық бар, солай ма?
Dialogue: 0,0:13:40.53,0:13:41.18,Default,,0,0,0,,Иә
Dialogue: 0,0:13:41.48,0:13:44.01,Default,,0,0,0,,Бұл химераны қуаттандыратын ядро.
Dialogue: 0,0:13:44.14,0:13:46.63,Default,,0,0,0,,Маған бұл нәрсені жеңу керек. Мен бара аламын ба?
Dialogue: 0,0:13:46.66,0:13:49.21,Default,,0,0,0,,...
Dialogue: 0,0:13:49.23,0:13:50.08,Default,,0,0,0,,Иә
Dialogue: 0,0:13:50.11,0:13:51.05,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:13:51.07,0:13:51.58,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:54.89,0:13:56.92,Default,,0,0,0,,Бұл сізді жақындатудан сақтайтын стратегия ма?
Dialogue: 0,0:13:56.95,0:14:00.19,Default,,0,0,0,,Өкінішке орай, бізде отқа төзімділік дағдылары бар!
Dialogue: 0,0:14:02.04,0:14:03.58,Default,,0,0,0,,...
Dialogue: 0,0:14:03.61,0:14:05.10,Default,,0,0,0,,Нысанаға дәл.
Dialogue: 0,0:14:12.78,0:14:13.58,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:14:13.91,0:14:15.57,Default,,0,0,0,,...
Dialogue: 0,0:14:17.29,0:14:19.06,Default,,0,0,0,,...
Dialogue: 0,0:14:19.66,0:14:24.11,Default,,0,0,0,,～～～～
Dialogue: 0,0:14:24.13,0:14:25.13,Default,,0,0,0,,Сен өлесің!
Dialogue: 0,0:14:25.19,0:14:26.37,Default,,0,0,0,,Сен өлесің!
Dialogue: 0,0:14:27.23,0:14:29.03,Default,,0,0,0,,Иә, Юта Отокоцу
Dialogue: 0,0:14:29.67,0:14:31.23,Default,,0,0,0,,...
Dialogue: 0,0:14:31.39,0:14:36.59,Default,,0,0,0,,Ах, химерадан шыққан жалынды Фламбердждің жалынымен тойтару үшін.
Dialogue: 0,0:14:36.61,0:14:40.81,Default,,0,0,0,,Оның аузы нашар, бірақ бұл жас келіншектің төбелесу сезімі жақсы.
Dialogue: 0,0:14:43.98,0:14:45.25,Default,,0,0,0,,Мұны маған қалдырыңыз!
Dialogue: 0,0:14:47.23,0:14:50.37,Default,,0,0,0,,Куу, мені тағы бір қаңқалы жігіт құтқарып жатқанына сене алар емеспін.
Dialogue: 0,0:14:50.39,0:14:53.92,Default,,0,0,0,,Мен оны ешқашан есіме түсіре алмасам да, көп рахмет!
Dialogue: 0,0:14:55.46,0:14:56.99,Default,,0,0,0,,...
Dialogue: 0,0:14:57.02,0:14:57.75,Default,,0,0,0,,Жоқ
Dialogue: 0,0:14:57.89,0:14:58.77,Default,,0,0,0,,Милия!
Dialogue: 0,0:14:59.20,0:15:00.36,Default,,0,0,0,,Құрметті Рокси!
Dialogue: 0,0:15:00.96,0:15:02.55,Default,,0,0,0,,Барлығын қауіпсіз жерге жеткізіңіз
Dialogue: 0,0:15:02.89,0:15:05.84,Default,,0,0,0,,Мукуро-сан екеуміз қалған химераларға қамқор боламыз!
Dialogue: 0,0:15:06.11,0:15:06.71,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:07.57,0:15:08.97,Default,,0,0,0,,...
Dialogue: 0,0:15:09.19,0:15:10.19,Default,,0,0,0,,Кешкі ас ішейік пе? О…
Dialogue: 0,0:15:12.15,0:15:14.02,Default,,0,0,0,,Ой!
Dialogue: 0,0:15:19.84,0:15:21.18,Default,,0,0,0,,О! !
Dialogue: 0,0:15:21.71,0:15:22.74,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:27.62,0:15:30.11,Default,,0,0,0,,Мен Рокси-самамен бірінші рет жекпе-жек өткіздім.
Dialogue: 0,0:15:30.14,0:15:32.14,Default,,0,0,0,,Mine немесе Aaron қарағанда жақсырақ сәйкес келеді
Dialogue: 0,0:15:33.88,0:15:34.98,Default,,0,0,0,,Бір ғана қалды.
Dialogue: 0,0:15:35.12,0:15:36.12,Default,,0,0,0,,Иә
Dialogue: 0,0:15:36.44,0:15:38.64,Default,,0,0,0,,Осының бәрін бірден аяқтайық.
Dialogue: 0,0:15:39.39,0:15:40.46,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:15:40.76,0:15:41.99,Default,,0,0,0,,Менің тынысым тарылды.
Dialogue: 0,0:15:42.21,0:15:43.44,Default,,0,0,0,,Сіз әлі де бара аласыз!
Dialogue: 0,0:15:47.89,0:15:48.74,Default,,0,0,0,,Ол ұшты! ?
Dialogue: 0,0:15:49.35,0:15:50.90,Default,,0,0,0,,Қонған бойда мұны жасаңыз!
Dialogue: 0,0:15:50.93,0:15:51.80,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:59.16,0:16:00.85,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:01.53,0:16:03.23,Default,,0,0,0,,Құрметті Рокси!
Dialogue: 0,0:16:13.73,0:16:18.00,Default,,0,0,0,,Ол осылай көрінсе де, мен оның беріктігіне сенімдімін.
Dialogue: 0,0:16:18.69,0:16:19.75,Default,,0,0,0,,Сенің әрекетің тым балалық… немесе жай ғана қысқа көзді.
Dialogue: 0,0:16:20.06,0:16:21.35,Default,,0,0,0,,Мен мұны сізге қалдырамын!
Dialogue: 0,0:16:22.56,0:16:24.66,Default,,0,0,0,,Әй, маған сеніп тапсырылған!
Dialogue: 0,0:16:33.24,0:16:34.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:36.11,0:16:37.62,Default,,0,0,0,,Байқадың ба, Тағдыр?
Dialogue: 0,0:16:37.65,0:16:38.65,Default,,0,0,0,,Ашкөздік?
Dialogue: 0,0:16:39.64,0:16:43.15,Default,,0,0,0,,Көрдім, мен сол жерден құладым...
Dialogue: 0,0:16:44.45,0:16:45.11,Default,,0,0,0,,Fei…
Dialogue: 0,0:16:45.29,0:16:46.03,Default,,0,0,0,,Иә
Dialogue: 0,0:16:46.19,0:16:46.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:47.25,0:16:49.13,Default,,0,0,0,,Құрметті Рокси!
Dialogue: 0,0:16:49.51,0:16:52.12,Default,,0,0,0,,Дұрыс! Бұл дұрыс!
Dialogue: 0,0:16:52.34,0:16:54.77,Default,,0,0,0,,Бұл жаман. Бұл мүлдем жаман!
Dialogue: 0,0:16:54.83,0:16:55.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:55.63,0:16:56.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:56.46,0:16:58.35,Default,,0,0,0,,Жоқ? иә?
Dialogue: 0,0:16:58.37,0:16:59.72,Default,,0,0,0,,Мен сені екеуіңді де жақсы көремін, сондықтан оны өзім бергім келеді.
Dialogue: 0,0:17:00.84,0:17:01.70,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:17:02.88,0:17:04.87,Default,,0,0,0,,О, мен...
Dialogue: 0,0:17:05.11,0:17:06.69,Default,,0,0,0,,А-а-а
Dialogue: 0,0:17:06.83,0:17:08.46,Default,,0,0,0,,Мукуро-сан!
Dialogue: 0,0:17:08.83,0:17:09.84,Default,,0,0,0,,Мен Иносукэні құтқарамын
Dialogue: 0,0:17:09.86,0:17:10.60,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:17:10.65,0:17:11.34,Default,,0,0,0,,Хмм!
Dialogue: 0,0:17:14.07,0:17:15.04,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:17:15.63,0:17:17.59,Default,,0,0,0,,Кішкене демалсаңыз жақсы болады.
Dialogue: 0,0:17:17.61,0:17:19.51,Default,,0,0,0,,Қасиетті рыцарь күткендей.
Dialogue: 0,0:17:21.82,0:17:24.37,Default,,0,0,0,,Сіз сондай-ақ жалын оқының сиқырын пайдалана аласыз.
Dialogue: 0,0:17:24.89,0:17:26.65,Default,,0,0,0,,Бұл дерлік болды.
Dialogue: 0,0:17:27.28,0:17:31.06,Default,,0,0,0,,Егер тіреуіш құламағанда, химераны жеңе алар едік.
Dialogue: 0,0:17:31.22,0:17:32.32,Default,,0,0,0,,Химера?
Dialogue: 0,0:17:32.49,0:17:33.19,Default,,0,0,0,,О
Dialogue: 0,0:17:34.15,0:17:38.45,Default,,0,0,0,,Шамасы, бұл 4000 жыл бұрын Галлияда жасалған жасанды құбыжық.
Dialogue: 0,0:17:39.20,0:17:41.12,Default,,0,0,0,,Бұған не болды?
Dialogue: 0,0:17:41.40,0:17:43.75,Default,,0,0,0,,Материал жинау тобын таптыңыз ба?
Dialogue: 0,0:17:44.19,0:17:45.97,Default,,0,0,0,,Уақытында үлгермедім
Dialogue: 0,0:17:47.01,0:17:50.28,Default,,0,0,0,,Әрбір мүшенің негізін өртеп жіберді.
Dialogue: 0,0:17:51.03,0:17:51.98,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:17:52.77,0:17:55.36,Default,,0,0,0,,Мукуро мырза, мен химераны айтып отырмын.
Dialogue: 0,0:17:55.52,0:17:57.38,Default,,0,0,0,,Оны кімнен естідің?
Dialogue: 0,0:17:57.88,0:18:00.01,Default,,0,0,0,,Галлдардың қалдықтарынан
Dialogue: 0,0:18:00.69,0:18:04.34,Default,,0,0,0,,Мүмкін ол үлкен балта ұстаған қыз шығар?
Dialogue: 0,0:18:04.36,0:18:05.22,Default,,0,0,0,,Уф
Dialogue: 0,0:18:05.58,0:18:08.65,Default,,0,0,0,,Мен сізді бұрын өз территориямда көргенмін.
Dialogue: 0,0:18:08.81,0:18:12.16,Default,,0,0,0,,Мен Вавилонға бара жатқанда өсек естідім.
Dialogue: 0,0:18:12.80,0:18:15.74,Default,,0,0,0,,Лордты үлкен балтамен ұшырды.
Dialogue: 0,0:18:16.01,0:18:17.44,Default,,0,0,0,,А?
Dialogue: 0,0:18:17.64,0:18:19.60,Default,,0,0,0,,Бұл алаңдатады
Dialogue: 0,0:18:20.48,0:18:25.04,Default,,0,0,0,,Ол бас сүйегіне бетперде киген жас жігітпен бірге болған деген қауесет бар.
Dialogue: 0,0:18:28.40,0:18:30.23,Default,,0,0,0,,А, бұл дұрыс.
Dialogue: 0,0:18:30.26,0:18:31.28,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:18:31.55,0:18:33.86,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:18:34.82,0:18:36.74,Default,,0,0,0,,Жеңіске жетсең қуанатын сияқтысың.
Dialogue: 0,0:18:36.79,0:18:37.78,Default,,0,0,0,,Хехе…
Dialogue: 0,0:18:38.33,0:18:41.64,Default,,0,0,0,,Сондықтан мен саған бұлай көп қарама деп айттым.
Dialogue: 0,0:18:42.41,0:18:43.53,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:18:43.71,0:18:46.94,Default,,0,0,0,,Сіздің атмосфераңыз таныс адамның атмосферасына ұқсайды,
Dialogue: 0,0:18:46.96,0:18:48.01,Default,,0,0,0,,Танысу?
Dialogue: 0,0:18:48.37,0:18:49.17,Default,,0,0,0,,Иә
Dialogue: 0,0:18:50.66,0:18:53.31,Default,,0,0,0,,Ол астанада болуы керек
Dialogue: 0,0:18:53.83,0:18:57.25,Default,,0,0,0,,Мен өзімді сенің жаныңда жүргендей сезінемін
Dialogue: 0,0:18:58.40,0:18:59.80,Default,,0,0,0,,Бұл біртүрлі, солай емес пе?
Dialogue: 0,0:19:01.47,0:19:05.25,Default,,0,0,0,,Мен осылай алыста болған соң, кейде ойлаймын:
Dialogue: 0,0:19:06.24,0:19:09.66,Default,,0,0,0,,Бұл жақсы болды ма? Бұл оған пайда әкелді ме?
Dialogue: 0,0:19:09.96,0:19:12.88,Default,,0,0,0,,Қызық, Фэй шынымен бақытты ма?
Dialogue: 0,0:19:14.01,0:19:15.77,Default,,0,0,0,,Ол адам бақытты.
Dialogue: 0,0:19:16.01,0:19:16.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:18.38,0:19:20.78,Default,,0,0,0,,Мен туралы көп ойлайтыныңа сене алар емеспін
Dialogue: 0,0:19:21.11,0:19:23.30,Default,,0,0,0,,Ол керемет бақытты адам.
Dialogue: 0,0:19:24.41,0:19:26.43,Default,,0,0,0,,Мен солай деп үміттенемін.
Dialogue: 0,0:19:28.15,0:19:29.63,Default,,0,0,0,,(Өзгеріс жоқ)
Dialogue: 0,0:19:30.44,0:19:31.67,Default,,0,0,0,,(Құрметті Рокси)
Dialogue: 0,0:19:32.40,0:19:33.36,Default,,0,0,0,,Уф
Dialogue: 0,0:19:33.79,0:19:35.92,Default,,0,0,0,,Неліктен мұндай уақытта?
Dialogue: 0,0:19:36.36,0:19:38.19,Default,,0,0,0,,Не болды? Мукуро мырза
Dialogue: 0,0:19:38.60,0:19:39.66,Default,,0,0,0,,Бұл көздер...
Dialogue: 0,0:19:39.78,0:19:40.65,Default,,0,0,0,,(Танжиро) Ой… (Чунтарo) Чип, чип
Dialogue: 0,0:19:40.82,0:19:41.90,Default,,0,0,0,,Қарама!
Dialogue: 0,0:19:41.93,0:19:42.36,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:19:44.24,0:19:45.34,Default,,0,0,0,,Мукуро мырза!
Dialogue: 0,0:19:48.17,0:19:49.76,Default,,0,0,0,,Мен адамдардың өмірін сақтайтын жұмыста істедім
Dialogue: 0,0:19:50.11,0:19:53.72,Default,,0,0,0,,Бұл иіс жақын жерде
Dialogue: 0,0:19:57.28,0:19:58.63,Default,,0,0,0,,Бұл шықты!
Dialogue: 0,0:20:11.16,0:20:12.41,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:20:13.69,0:20:15.16,Default,,0,0,0,,Маған осылай қара!
Dialogue: 0,0:20:18.11,0:20:19.11,Default,,0,0,0,,Мен!
Dialogue: 0,0:20:19.49,0:20:20.91,Default,,0,0,0,,(Танжиро) Ой… (Чунтарo) Чип, чип
Dialogue: 0,0:20:25.34,0:20:27.11,Default,,0,0,0,,Хаха...
Dialogue: 0,0:20:33.05,0:20:34.31,Default,,0,0,0,,Бұл...
Dialogue: 0,0:20:34.97,0:20:36.64,Default,,0,0,0,,Сондай-ақ осы Елтаңба
Dialogue: 0,0:20:36.66,0:20:39.51,Default,,0,0,0,,Саламандр мен Химера
Dialogue: 0,0:20:39.54,0:20:44.02,Default,,0,0,0,,Біреу Роксидің өмірін мақсат етіп отырғанына күмән жоқ.
Dialogue: 0,0:20:45.92,0:20:47.53,Default,,0,0,0,,Рокси Харт
Dialogue: 0,0:20:48.70,0:20:51.56,Default,,0,0,0,,Галлияда өлсін.
Dialogue: 0,0:20:53.42,0:20:56.29,Default,,0,0,0,,Эллиске рұқсат етілмейді
Dialogue: 0,0:20:56.67,0:20:57.71,Default,,0,0,0,,Мукуро мырза!
Dialogue: 0,0:20:59.04,0:21:00.09,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:21:00.36,0:21:01.70,Default,,0,0,0,,Мен оны жеңдім
Dialogue: 0,0:21:01.73,0:21:02.98,Default,,0,0,0,,Қазір бәрі жақсы.
Dialogue: 0,0:21:03.01,0:21:04.11,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:21:06.28,0:21:07.36,Default,,0,0,0,,Қауіпті!
Dialogue: 0,0:21:13.84,0:21:14.98,Default,,0,0,0,,Сиқырлы кристал!
Dialogue: 0,0:21:15.32,0:21:17.82,Default,,0,0,0,,Бұл құбыжық тас па?
Dialogue: 0,0:21:18.37,0:21:20.94,Default,,0,0,0,,Сиқырлы кристалдар құбыжықтардан шығады.
Dialogue: 0,0:21:20.97,0:21:21.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:21.86,0:21:23.95,Default,,0,0,0,,Білмей іздедің бе?
Dialogue: 0,0:21:24.42,0:21:24.98,Default,,0,0,0,,Жарайды. Бұл отбасыңызға ма?
Dialogue: 0,0:21:25.27,0:21:27.43,Default,,0,0,0,,Ақылмен табылмауы керек еді.
Dialogue: 0,0:21:27.45,0:21:28.78,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:21:28.87,0:21:32.69,Default,,0,0,0,,Әй, Рокси-сама~! !
Dialogue: 0,0:21:35.04,0:21:37.72,Default,,0,0,0,,Аман-есен болғаныңызға қуаныштымын.
Dialogue: 0,0:21:40.61,0:21:42.44,Default,,0,0,0,,Барлығының қауіпсіз болғанына қуаныштымын.
Dialogue: 0,0:22:06.56,0:22:11.56,Default,,0,0,0,,♪～
Dialogue: 0,0:23:28.96,0:23:33.96,Default,,0,0,0,,~♪
