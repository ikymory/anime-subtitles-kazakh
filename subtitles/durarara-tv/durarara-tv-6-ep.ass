Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:07.62,0:01:08.71,Dialogue,,0,0,0,,Доллар?
Dialogue: 0,0:01:07.69,0:01:08.88,*Default-ja,NTP,0,0,0,,Доллар?
Dialogue: 0,0:01:08.71,0:01:12.70,Dialogue,,0,0,0,,Олар «Пи пиру пиру» деп ұшатын періштелер, трусиларын көрсетеді.
Dialogue: 0,0:01:08.96,0:01:12.79,*Default-ja,NTP,0,0,0,,Трусисын көрсетіп, аспанға ұшып бара жатқан дірілдеген періште.
Dialogue: 0,0:01:12.70,0:01:17.76,Dialogue,,0,0,0,,Жеткілікті мөлшерде салыңыз. Егер ол оянбаса, оның құны әлдеқайда төмен болады.
Dialogue: 0,0:01:13.00,0:01:14.69,*Default-ja,NTP,0,0,0,,Сіз дұрыс емес соманы алмайсыз.
Dialogue: 0,0:01:14.80,0:01:18.04,*Default-ja,NTP,0,0,0,,Оянбасаңыз, көтерілу күрт төмендейді.
Dialogue: 0,0:01:17.76,0:01:20.76,Dialogue,,0,0,0,,Біз доллар туралы көп білмейтін сияқтымыз.
Dialogue: 0,0:01:18.06,0:01:20.90,*Default-ja,NTP,0,0,0,,Тіпті біз доллар туралы көп білмейміз.
Dialogue: 0,0:01:20.76,0:01:22.85,Dialogue,,0,0,0,,Бірақ мен сізге білетініміздің бәрін айтып беремін.
Dialogue: 0,0:01:21.04,0:01:23.14,*Default-ja,NTP,0,0,0,,Мен саған білгенімнің бәрін айтамын.
Dialogue: 0,0:01:22.85,0:01:26.48,Dialogue,,0,0,0,,Шамасы, олар түсті банда, бірақ олардың түсін ешкім білмейді.
Dialogue: 0,0:01:23.16,0:01:26.69,*Default-ja,NTP,0,0,0,,Бұл түсті топ сияқты, бірақ мен оның түсі қандай екенін білмеймін.
Dialogue: 0,0:01:26.48,0:01:28.98,Dialogue,,0,0,0,,«Деңгеки» жаңа қалта басылымдарын шығарды, сондықтан...
Dialogue: 0,0:01:26.92,0:01:29.26,*Default-ja,NTP,0,0,0,,«Деңгеки бунко» журналының жаңа басылымы шықты.
Dialogue: 0,0:01:28.98,0:01:31.22,Dialogue,,0,0,0,,Біз әртүрлі себептермен он сатып алдық.
Dialogue: 0,0:01:29.48,0:01:31.32,*Default-ja,NTP,0,0,0,,Түрлі мақсатта 10 шақты кітапты редакцияладым.
Dialogue: 0,0:01:31.22,0:01:32.57,Dialogue,,0,0,0,,Әртүрлі, шын мәнінде.
Dialogue: 0,0:01:31.50,0:01:32.61,*Default-ja,NTP,0,0,0,,Әртүрлі мақсаттар үшін.
Dialogue: 0,0:02:09.86,0:02:13.18,Dialogue,,0,0,0,,Қашып кетем деп ойламаңыз! иә!
Dialogue: 0,0:02:09.99,0:02:12.23,*Default-ja,NTP,0,0,0,,Қашып кетем деп ойламаңыз!
Dialogue: 0,0:02:13.18,0:02:14.98,Dialogue,,0,0,0,,Мен оңға бұрыламын!
Dialogue: 0,0:02:13.37,0:02:14.97,*Default-ja,NTP,0,0,0,,Оңға бұрылыңыз!
Dialogue: 0,0:02:23.54,0:02:24.95,Thought,,0,0,0,,Іш қуысы ер адамды жасайды.
Dialogue: 0,0:02:23.89,0:02:25.27,*Default-ja,NTP,0,0,0,,Адамның іш қуысы бар
Dialogue: 0,0:02:26.14,0:02:30.21,Dialogue,,0,0,0,,Біз долларға кіргеннен бері бірінші рет осындай әрекет жасадық, солай емес пе, Кадота?
Dialogue: 0,0:02:26.40,0:02:30.24,*Default-ja,NTP,0,0,0,,Жоқ, жоқ, жоқ, мен долларға қосылғаннан бері мұндай әрекетті бірінші рет жасап отырмын~ Кадота мырза!
Dialogue: 0,0:02:30.21,0:02:31.72,Dialogue,,0,0,0,,Отыр да, үндеме!
Dialogue: 0,0:02:30.51,0:02:31.89,*Default-ja,NTP,0,0,0,,Тыныш отырыңыз!
Dialogue: 0,0:02:31.72,0:02:38.63,Dialogue,,0,0,0,,Доллар «Пи пиру пиру» деп ұшып, трусиларын көрсететін періштелер емес пе, Дотачин?
Dialogue: 0,0:02:31.91,0:02:38.57,*Default-ja,NTP,0,0,0,,Доллар трусиларын көрсетіп, аспанға ұшатын періштелер емес.
Dialogue: 0,0:02:38.63,0:02:40.34,Dialogue,,0,0,0,,Мен саған олай атама дедім ғой!
Dialogue: 0,0:02:38.87,0:02:40.30,*Default-ja,NTP,0,0,0,,Сондықтан мені бұл атпен атама!
Dialogue: 0,0:02:44.72,0:02:46.72,Dialogue,,0,0,0,,Жарайды, біз оларды тастадық.
Dialogue: 0,0:02:45.03,0:02:47.10,*Default-ja,NTP,0,0,0,,Жарайды, мен оны сілкіп тастадым!
Dialogue: 0,0:02:51.19,0:02:53.42,Dialogue,,0,0,0,,Бұл ақылсыз!
Dialogue: 0,0:02:51.58,0:02:52.71,*Default-ja,NTP,0,0,0,,Бұл ақылсыз!
Dialogue: 0,0:02:56.76,0:02:57.28,Dialogue,,0,0,0,,Мұнда.
Dialogue: 0,0:02:56.89,0:02:57.65,*Default-ja,NTP,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:03:17.15,0:03:22.51,Dialogue,,0,0,0,,Адамдарға тәжірибе жасап жатқан топпен бірлесе екеніңді неге айтпайсың...?
Dialogue: 0,0:03:17.35,0:03:19.47,*Default-ja,NTP,0,0,0,,Енді мен сенен бірнәрсе сұрайын.
Dialogue: 0,0:03:19.73,0:03:22.64,*Default-ja,NTP,0,0,0,,Екеуіңіз де жауапты адам тәжірибесінің тарихы.
Dialogue: 0,0:03:23.06,0:03:25.03,Dialogue,,0,0,0,,Мен Кадота Кёхэймін.
Dialogue: 0,0:03:23.17,0:03:24.73,*Default-ja,NTP,0,0,0,,Мен Кёхэй Кадотамын
Dialogue: 0,0:03:25.03,0:03:28.10,Dialogue,,0,0,0,,Маған "Дотачин" деген ат ұнамайды.
Dialogue: 0,0:03:25.14,0:03:28.37,*Default-ja,NTP,0,0,0,,Мені дотачин деп атағандары ұнамайды.
Dialogue: 0,0:03:28.46,0:03:32.14,Dialogue,,0,0,0,,Қалай болғанда да, мұның бәрі сегіз сағат бұрын басталды.
Dialogue: 0,0:03:28.69,0:03:31.96,*Default-ja,NTP,0,0,0,,Енді бұл сегіз сағат бұрын болды.
Dialogue: 0,0:03:34.78,0:03:39.15,Dialogue,,0,0,0,,Мен сіздерге белгілі Казтано оқиғасының тарихын айтайын деп отырмын.
Dialogue: 0,0:03:34.95,0:03:39.03,*Default-ja,NTP,0,0,0,,Енді менің айтайын дегенім әлемге әйгілі Казутано ісі.
Dialogue: 0,0:03:39.90,0:03:42.84,Chat,,0,0,0,,Жоғалған адам менің сыныптасым.
Dialogue: 0,0:03:42.84,0:03:45.58,Chat,,0,0,0,,Дәлірек айтсақ, ол досының досы...
Dialogue: 0,0:03:45.58,0:03:48.49,Chat,,0,0,0,,Мен онымен бір рет те кездескен емеспін.
Dialogue: 0,0:03:48.49,0:03:51.91,Chat,,0,0,0,,Сонымен, сіздің досыңыз жоғалып кетті, Танака Таро?
Dialogue: 0,0:03:51.91,0:03:54.83,Chat,,0,0,0,,Бұл туралы айтатын болсақ, соңғы уақытта көптеген адамдар жоғалып кетті ...
Dialogue: 0,0:03:54.83,0:03:57.67,Chat,,0,0,0,,Немесе, кем дегенде, жоғалған адамдар туралы көптеген қауесеттер бар.
Dialogue: 0,0:03:57.67,0:03:59.71,Chat,,0,0,0,,Канра, сен өсекші маньяксың.
Dialogue: 0,0:03:59.71,0:04:00.79,Chat,,0,0,0,,Ахахаха.
Dialogue: 0,0:04:01.80,0:04:03.24,*Default-ja,NTP,0,0,0,,Мен естіген өсек осы
Dialogue: 0,0:04:01.80,0:04:07.51,Chat,,0,0,0,,Мен естіген жоғалған адамдар негізінен үйден қашып кеткен балалар немесе заңсыз шетелдіктер.
Dialogue: 0,0:04:03.29,0:04:05.86,*Default-ja,NTP,0,0,0,,Жоғалған балалар ауылдан үйінен қашып кеткен балалар.
Dialogue: 0,0:04:05.94,0:04:07.78,*Default-ja,NTP,0,0,0,,Заңсыз шетелдіктер
Dialogue: 0,0:04:07.89,0:04:12.48,Chat,,0,0,0,,Мен жоғалып кеткеннен кейін ізін қалдырмайтын адамдарды айтып отырмын.
Dialogue: 0,0:04:08.09,0:04:11.90,*Default-ja,NTP,0,0,0,,Басқаша айтқанда, бұлар жоғалса да ізін қалдырмайтын адамдар.
Dialogue: 0,0:04:16.52,0:04:21.93,Chat,,0,0,0,,Осындай мыңдаған адамдар Икебукуро мен Шибуяның арасында жоғалып барады.
Dialogue: 0,0:04:16.94,0:04:21.83,*Default-ja,NTP,0,0,0,,Икебукуро мен Шибуяның арасында осындай көп адамдар жоғалып бара жатқан сияқты.
Dialogue: 0,0:04:21.93,0:04:25.03,Chat,,0,0,0,,Олар жоғалып кетсе, енді ешқашан көрінбейді.
Dialogue: 0,0:04:21.97,0:04:25.04,*Default-ja,NTP,0,0,0,,Оның үстіне ол бір жоғалып кетсе, енді ешқашан табылмайды.
Dialogue: 0,0:04:25.03,0:04:26.64,Chat,,0,0,0,,Бұл рас па?!
Dialogue: 0,0:04:25.30,0:04:26.29,*Default-ja,NTP,0,0,0,,Шынымен бе?
Dialogue: 0,0:04:26.64,0:04:30.51,Chat,,0,0,0,,Одан да қорқынышты қауесеттер бар.
Dialogue: 0,0:04:26.86,0:04:30.00,*Default-ja,NTP,0,0,0,,Одан да қорқынышты қауесеттер бар...
Dialogue: 0,0:04:31.66,0:04:38.01,Chat,,0,0,0,,Олар бұл адамдардың табылмауының себебін доллардың мәйіттерді бір жерге тастап, жеп қоюы деп болжайды!
Dialogue: 0,0:04:31.92,0:04:33.58,*Default-ja,NTP,0,0,0,,Сіз ешқашан таба алмайтын нәрсе
Dialogue: 0,0:04:33.76,0:04:37.75,*Default-ja,NTP,0,0,0,,Өйткені долларлар бір жерде адам денесін өңдеп, жеп жатыр.
Dialogue: 0,0:04:38.01,0:04:38.67,Chat,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:04:43.89,0:04:44.66,Dialogue,,0,0,0,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,0:04:44.66,0:04:46.53,Dialogue,,0,0,0,,Жақсы тот басқан белгі.
Dialogue: 0,0:04:45.09,0:04:46.58,*Default-ja,NTP,0,0,0,,Керемет тот белгісі!
Dialogue: 0,0:04:46.53,0:04:50.18,Dialogue,,0,0,0,,Сонымен, бұл ақпарат дилері жеткізуші болатынын айтты ма?
Dialogue: 0,0:04:46.71,0:04:50.55,*Default-ja,NTP,0,0,0,,Бұл ақпарат беруші айтқан жеткізуші.
Dialogue: 0,0:04:50.18,0:04:53.68,Dialogue,,0,0,0,,Бұл жер заңсыз шетелдіктер жүріп жатқан сияқты.
Dialogue: 0,0:04:50.67,0:04:53.74,*Default-ja,NTP,0,0,0,,Бұл жерде заңсыз иммигранттар көп тұратын сияқты.
Dialogue: 0,0:04:53.68,0:04:57.73,Dialogue,,0,0,0,,Тамақ билетімізді алып, жеткізейік.
Dialogue: 0,0:04:53.98,0:04:57.67,*Default-ja,NTP,0,0,0,,Жарайды, күріш тұқымын алып, тезірек жеткізіп алайық.
Dialogue: 0,0:05:22.01,0:05:23.01,Dialogue,,0,0,0,,Казтано!
Dialogue: 0,0:05:22.25,0:05:23.30,*Default-ja,NTP,0,0,0,,Казутано!
Dialogue: 0,0:05:23.37,0:05:24.74,Dialogue,,0,0,0,,Казтано!
Dialogue: 0,0:05:23.51,0:05:24.42,*Default-ja,NTP,0,0,0,,Казутано!
Dialogue: 0,0:05:32.83,0:05:34.56,Dialogue,,0,0,0,,Сәлем, қазір!
Dialogue: 0,0:05:34.67,0:05:35.84,*Default-ja,NTP,0,0,0,,Өте қызық!
Dialogue: 0,0:05:34.89,0:05:36.77,Dialogue,,0,0,0,,Бұл қызық!
Dialogue: 0,0:05:38.35,0:05:40.26,Dialogue,,0,0,0,,Ой, жасөспірім қыздар!
Dialogue: 0,0:05:38.80,0:05:40.14,*Default-ja,NTP,0,0,0,,Ой, жасөспірім қыз!
Dialogue: 0,0:05:40.26,0:05:41.57,Dialogue,,0,0,0,,Бұл жиырма пайызға көп ақша!
Dialogue: 0,0:05:40.35,0:05:41.64,*Default-ja,NTP,0,0,0,,Бұл 20% артық!
Dialogue: 0,0:05:41.57,0:05:43.48,Dialogue,,0,0,0,,Жаңа, бүгін қолымыздан келгенді алайық.
Dialogue: 0,0:05:41.83,0:05:43.76,*Default-ja,NTP,0,0,0,,Жоқ, бүгін берік болайық.
Dialogue: 0,0:05:43.48,0:05:46.99,Dialogue,,0,0,0,,Егер біз осындай адамдардың артынан баратын болсақ, ол нәрсе қайтадан пайда болуы мүмкін.
Dialogue: 0,0:05:43.92,0:05:47.17,*Default-ja,NTP,0,0,0,,Егер сіз сол қолды көздесеңіз, сіз бұрынғыдай бірдеңе аласыз.
Dialogue: 0,0:05:47.95,0:05:50.28,Dialogue,,0,0,0,,Уф. Басы жоқ нәрсе?
Dialogue: 0,0:05:48.19,0:05:50.10,*Default-ja,NTP,0,0,0,,Ку...бассыз ба?
Dialogue: 0,0:05:50.28,0:05:52.83,Dialogue,,0,0,0,,Бүгін осы жігітпен бәс тігулерімізді хеджирлейік.
Dialogue: 0,0:05:50.57,0:05:53.06,*Default-ja,NTP,0,0,0,,Бүгін осыны орындайық.
Dialogue: 0,0:05:53.76,0:05:54.91,Dialogue,,0,0,0,,Көп нәрсе болды, бірақ ақыры өз орныңды тапқан сияқтысың.
Dialogue: 0,0:05:53.99,0:05:54.89,*Default-ja,NTP,0,0,0,,Не болды?
Dialogue: 0,0:05:56.00,0:05:59.10,Dialogue,,0,0,0,,Оған бірдеңе дұрыс емес сияқты.
Dialogue: 0,0:05:56.38,0:05:58.99,*Default-ja,NTP,0,0,0,,Бір жерде ақау жоқ па?
Dialogue: 0,0:05:59.10,0:06:00.92,Dialogue,,0,0,0,,Жарайды, ол әлі адам.
Dialogue: 0,0:05:59.35,0:06:01.31,*Default-ja,NTP,0,0,0,,Бұл да адам ғой.
Dialogue: 0,0:06:00.92,0:06:05.68,Dialogue,,0,0,0,,Жарайды, орта жастағы жігіт бүлінген тауар деп есептейді, сондықтан мен оған азырақ алуға дайынбыз деп ойлаймын?
Dialogue: 0,0:06:01.47,0:06:03.70,*Default-ja,NTP,0,0,0,,Олай болса, бұл орта жастағы әкенің туындысы.
Dialogue: 0,0:06:03.77,0:06:05.44,*Default-ja,NTP,0,0,0,,Жеңілдікке дайын болыңыз
Dialogue: 0,0:06:08.00,0:06:09.07,Dialogue,,0,0,0,,Та-да!
Dialogue: 0,0:06:09.99,0:06:12.50,Dialogue,,0,0,0,,Йо, тамақтану билеті.
Dialogue: 0,0:06:10.13,0:06:12.05,*Default-ja,NTP,0,0,0,,Күріш тұқымы
Dialogue: 0,0:06:19.35,0:06:21.33,Dialogue,,0,0,0,,Мен жапонмын!
Dialogue: 0,0:06:19.54,0:06:21.17,*Default-ja,NTP,0,0,0,,Мен жапонмын.
Dialogue: 0,0:06:21.33,0:06:23.42,Dialogue,,0,0,0,,Мен де сен сияқтымын!
Dialogue: 0,0:06:21.40,0:06:23.26,*Default-ja,NTP,0,0,0,,Балалар сендер сияқты.
Dialogue: 0,0:06:23.42,0:06:26.04,Dialogue,,0,0,0,,Бірақ көбі мені шетелдікке ұқсайды дейді.
Dialogue: 0,0:06:23.45,0:06:26.12,*Default-ja,NTP,0,0,0,,Бірақ мені шетелдікке ұқсайды деп жиі айтады.
Dialogue: 0,0:06:26.04,0:06:27.69,Dialogue,,0,0,0,,Бұл мені қынжылтады.
Dialogue: 0,0:06:26.17,0:06:27.68,*Default-ja,NTP,0,0,0,,Өте өкінішті
Dialogue: 0,0:06:27.69,0:06:30.61,TL Note,,0,0,0,,T/L Ескерту: Ол жапон тілін шатастырады.
Dialogue: 0,0:06:27.69,0:06:30.61,Dialogue,,0,0,0,,Кейде қорлау болады.
Dialogue: 0,0:06:28.04,0:06:30.07,*Default-ja,NTP,0,0,0,,Кейде мені қорқытады.
Dialogue: 0,0:06:44.84,0:06:46.91,Dialogue,,0,0,0,,Біз тамақтың құнын өтеуге де жетпейміз.
Dialogue: 0,0:06:45.21,0:06:47.08,*Default-ja,NTP,0,0,0,,Тамақтың ақысын да төлемейді, солай ма?
Dialogue: 0,0:06:46.91,0:06:49.42,Dialogue,,0,0,0,,«Нпоко sad» деген нені білдіреді?
Dialogue: 0,0:06:47.22,0:06:49.49,*Default-ja,NTP,0,0,0,,Бұл не? Бұл өте өкінішті.
Dialogue: 0,0:06:50.22,0:06:55.44,Dialogue,,0,0,0,,Сондықтан оның айналасында Юута сияқты «іні құтқарушы» мінезі болмаса,
Dialogue: 0,0:06:50.62,0:06:55.57,*Default-ja,NTP,0,0,0,,Сондықтан~ Бізге Юта сияқты кіші іні типті көмекші ертегі керек.
Dialogue: 0,0:06:55.44,0:06:58.60,Dialogue,,0,0,0,,ол жай ғана жынды, шашы фетишімен мазохист қасқыр.
Dialogue: 0,0:06:55.69,0:06:58.57,*Default-ja,NTP,0,0,0,,Менің ойымша, ол жай ғана супер мазохистік шаш фетиш қасқыр.
Dialogue: 0,0:06:58.60,0:07:01.82,Dialogue,,0,0,0,,«Інім» дейсің, бірақ ол қыз сияқты киінген жігіт.
Dialogue: 0,0:06:58.70,0:07:01.78,*Default-ja,NTP,0,0,0,,Ол інісіне көбірек ұқсайды, дәлірек айтсақ, киінген бала.
Dialogue: 0,0:07:01.82,0:07:04.93,Dialogue,,0,0,0,,Мен «кіші сіңлі құтқарушы» кейіпкерін қалаймын.
Dialogue: 0,0:07:02.00,0:07:05.08,*Default-ja,NTP,0,0,0,,Мен әпке типті көмекші ертегі кейіпкерін қалаймын.
Dialogue: 0,0:07:04.93,0:07:07.71,Dialogue,,0,0,0,,Әй, бірақ үлкен апаның кейіпкері де жақсы болар еді.
Dialogue: 0,0:07:05.14,0:07:07.04,*Default-ja,NTP,0,0,0,,Аа, апаның түрі де жарайды.
Dialogue: 0,0:07:07.71,0:07:10.43,Dialogue,,0,0,0,,Кешкі ас кезінде осылай сөйлегеніңіз кешірілмейді.
Dialogue: 0,0:07:07.76,0:07:10.40,*Default-ja,NTP,0,0,0,,Мен саған тамақ ішкенде бұл туралы айтуға рұқсат бермеймін.
Dialogue: 0,0:07:10.43,0:07:13.21,Dialogue,,0,0,0,,Дотачин, тамақ алайық.
Dialogue: 0,0:07:10.66,0:07:13.15,*Default-ja,NTP,0,0,0,,Дотачин, тамақ ішейік!
Dialogue: 0,0:07:13.21,0:07:14.88,Dialogue,,0,0,0,,Тамақ, тамақ!
Dialogue: 0,0:07:13.48,0:07:15.18,*Default-ja,NTP,0,0,0,,Күріш күріш~!
Dialogue: 0,0:07:14.88,0:07:15.60,Dialogue,,0,0,0,,Алдымен, ортаңғы және көрсеткі саусақтарыңызды осылайша қосыңыз,
Dialogue: 0,0:07:15.60,0:07:19.86,Dialogue,,0,0,0,,Уау, уау, уау, сен әдеттегідей керемет жұмыс жасадың.
Dialogue: 0,0:07:16.91,0:07:19.93,*Default-ja,NTP,0,0,0,,Жоқ, жоқ, жоқ, Кадота мырзаның шеберлігі бұрынғысынша таң қалдырады~
Dialogue: 0,0:07:19.86,0:07:21.71,Dialogue,,0,0,0,,Бұл жуынатын бөлме менің жатын бөлмемнен үлкен.
Dialogue: 0,0:07:20.10,0:07:21.96,*Default-ja,NTP,0,0,0,,Дәретхана менің бөлмемнен үлкен.
Dialogue: 0,0:07:21.71,0:07:26.95,Dialogue,,0,0,0,,Олар маған бұл жердің тұжырымдамасын «басқа орындардан бір саты жоғары және демалуға болатын тыныш кеңістікті қамтамасыз ететін кабаре» дейді.
Dialogue: 0,0:07:21.96,0:07:27.09,*Default-ja,NTP,0,0,0,,Тұжырымдама `` тыныш релаксацияны қамтамасыз ететін жоғары дәрежелі кабаре клубы '' сияқты.
Dialogue: 0,0:07:26.95,0:07:28.00,Dialogue,,0,0,0,,Хмф.
Dialogue: 0,0:07:28.00,0:07:32.29,Dialogue,,0,0,0,,А, біз асығуымыз керек. Бұл күн айына бір рет келеді.
Dialogue: 0,0:07:28.57,0:07:29.98,*Default-ja,NTP,0,0,0,,Жылдамдағанымыз жөн.
Dialogue: 0,0:07:30.12,0:07:32.32,*Default-ja,NTP,0,0,0,,Бүгін айына бір рет болады ғой.
Dialogue: 0,0:07:32.29,0:07:33.77,Dialogue,,0,0,0,,Оқу, оқу
Dialogue: 0,0:07:35.65,0:07:36.72,Dialogue,,0,0,0,,Бұл кім?
Dialogue: 0,0:07:35.97,0:07:36.86,*Default-ja,NTP,0,0,0,,Who?
Dialogue: 0,0:07:36.72,0:07:37.72,Dialogue,,0,0,0,,Қазтанодан.
Dialogue: 0,0:07:36.90,0:07:38.15,*Default-ja,NTP,0,0,0,,Казутанодан
Dialogue: 0,0:07:38.41,0:07:40.47,Dialogue,,0,0,0,,«Табақ... сынды».
Dialogue: 0,0:07:38.66,0:07:40.52,*Default-ja,NTP,0,0,0,,«Табақ сынды».
Dialogue: 0,0:07:40.47,0:07:42.26,Dialogue,,0,0,0,,Ол жаңасын сатып ала алмайды ма?
Dialogue: 0,0:07:40.62,0:07:42.38,*Default-ja,NTP,0,0,0,,Жаңа табақ сатып алыңыз.
Dialogue: 0,0:07:42.26,0:07:43.77,Dialogue,,0,0,0,,100 иендік дүкенде!
Dialogue: 0,0:07:42.42,0:07:43.94,*Default-ja,NTP,0,0,0,,100 иен 100 иен!
Dialogue: 0,0:07:45.04,0:07:47.86,Dialogue,,0,0,0,,Мен жапонмын!
Dialogue: 0,0:07:45.19,0:07:47.41,*Default-ja,NTP,0,0,0,,Мен жапонмын~!
Dialogue: 0,0:07:50.78,0:07:55.02,Dialogue,,0,0,0,,"Мені біреу ұрлап кетті?"
Dialogue: 0,0:07:51.12,0:07:54.41,*Default-ja,NTP,0,0,0,,«Мені біреу ұрлап кетті» деген қателік шығар.
Dialogue: 0,0:07:55.02,0:07:56.20,Dialogue,,0,0,0,,Сіз бұл туралы ойланып қалдыңыз.
Dialogue: 0,0:07:55.20,0:07:56.40,*Default-ja,NTP,0,0,0,,Сіз тым көп ойлап отырсыз.
Dialogue: 0,0:07:58.22,0:08:00.20,Dialogue,,0,0,0,,Бұл жігіт тым қатты. Оны қазір ұйықтатыңыз!
Dialogue: 0,0:07:58.62,0:08:00.44,*Default-ja,NTP,0,0,0,,Шулы екен, тез ұйықтайыншы!
Dialogue: 0,0:08:00.53,0:08:01.66,Dialogue,,0,0,0,,Готчя.
Dialogue: 0,0:08:00.64,0:08:01.55,*Default-ja,NTP,0,0,0,,Уау!
Dialogue: 0,0:08:05.85,0:08:07.18,Dialogue,,0,0,0,,Шекара сызықтары?
Dialogue: 0,0:08:10.67,0:08:12.97,Dialogue,,0,0,0,,Келіңіздер, бұл арзан!
Dialogue: 0,0:08:10.92,0:08:12.70,*Default-ja,NTP,0,0,0,,Келіңіздер, бұл арзан!
Dialogue: 0,0:08:12.97,0:08:16.21,Dialogue,,0,0,0,,Біздің ингредиенттер жаңа!
Dialogue: 0,0:08:13.05,0:08:15.94,*Default-ja,NTP,0,0,0,,Әңгіме жаңа!
Dialogue: 0,0:08:13.38,0:08:16.21,Secondary,,0,0,0,,Сонохара, сіз қауесет туралы естідіңіз бе?
Dialogue: 0,0:08:13.90,0:08:16.33,*Default-ja,NTP,0,0,0,,Сонохара мырза да бұл қауесетті естіді.
Dialogue: 0,0:08:16.21,0:08:17.22,Dialogue,,0,0,0,,Оған не болды? Ол жалғыз өзі салқынқанды болып жүр.
Dialogue: 0,0:08:16.48,0:08:17.26,*Default-ja,NTP,0,0,0,,Иә...
Dialogue: 0,0:08:17.22,0:08:20.24,Dialogue,,0,0,0,,Оның жағдайы жақсы. Бұл қауесет мүлдем өтірік.
Dialogue: 0,0:08:17.40,0:08:20.31,*Default-ja,NTP,0,0,0,,Жарайды. Бұл өсектер өтірік.
Dialogue: 0,0:08:20.24,0:08:25.12,Dialogue,,0,0,0,,Дұрыс. Харима із-түзсіз жоғалып кетті, оны тек ұрлап кетуі мүмкін емес.
Dialogue: 0,0:08:20.37,0:08:23.07,*Default-ja,NTP,0,0,0,,Иә! Харима мырза жоғалып кетті.
Dialogue: 0,0:08:23.20,0:08:25.11,*Default-ja,NTP,0,0,0,,Оның ұрланғаны расталмаған.
Dialogue: 0,0:08:25.12,0:08:28.98,Dialogue,,0,0,0,,Оны ұрлап әкетуге мүмкіндік жоқ...
Dialogue: 0,0:08:25.28,0:08:28.89,*Default-ja,NTP,0,0,0,,Харима мырзаны ұрлап әкетуге мүлдем жол жоқ...
Dialogue: 0,0:08:30.72,0:08:32.49,Thought,,0,0,0,,Неліктен бұл туралы айтып отырсыз?
Dialogue: 0,0:08:30.94,0:08:32.79,*Default-ja,NTP,0,0,0,,Неліктен нақты өрнек керек?
Dialogue: 0,0:08:32.49,0:08:34.32,Thought,,0,0,0,,Мен өз бейітімді қазып алдым.
Dialogue: 0,0:08:32.99,0:08:33.96,*Default-ja,NTP,0,0,0,,Қабір…
Dialogue: 0,0:08:34.32,0:08:38.03,Dialogue,,0,0,0,,Жарайды, үшке нигири.
Dialogue: 0,0:08:34.52,0:08:37.69,*Default-ja,NTP,0,0,0,,Эй, 3 порция нигири!
Dialogue: 0,0:08:38.03,0:08:41.07,Dialogue,,0,0,0,,Жарайды, біз сушиде балықты пайдаланамыз.
Dialogue: 0,0:08:38.35,0:08:41.11,*Default-ja,NTP,0,0,0,,Жарайды, менің сушиім балық.
Dialogue: 0,0:08:41.07,0:08:43.87,Dialogue,,0,0,0,,Тіпті жарты күннің өзінде біз адамдарды пайдаланбаймыз.
Dialogue: 0,0:08:41.20,0:08:43.36,*Default-ja,NTP,0,0,0,,Жарты күндерде де ешкім шықпайды.
Dialogue: 0,0:08:44.18,0:08:47.92,Dialogue,,0,0,0,,Бірақ, бұрыштағы суши-бар...
Dialogue: 0,0:08:44.27,0:08:47.39,*Default-ja,NTP,0,0,0,,Мен аш емеспін. Хүү…
Dialogue: 0,0:08:44.87,0:08:47.26,Secondary Thought,,0,0,0,,Ол осы сұмдық тақырыпты жалғастыра бермек пе?!
Dialogue: 0,0:08:45.36,0:08:47.19,*Default-ja,NTP,0,0,0,,Бұл жалғаса ма!? Бұл тақырып!
Dialogue: 0,0:08:47.26,0:08:50.54,Secondary,,0,0,0,,Саймон, алдыңғы жағындағы баннер екіге бөлінген!
Dialogue: 0,0:08:47.49,0:08:50.53,*Default-ja,NTP,0,0,0,,Саймон! Алдыңғы баннер сынған!
Dialogue: 0,0:08:50.54,0:08:51.65,Dialogue,,0,0,0,,Баннер?!
Dialogue: 0,0:08:50.60,0:08:51.50,*Default-ja,NTP,0,0,0,,Нобори!?
Dialogue: 0,0:08:51.65,0:08:53.00,Dialogue,,0,0,0,,Иә, баннер.
Dialogue: 0,0:08:51.70,0:08:52.85,*Default-ja,NTP,0,0,0,,Иә Нобори!
Dialogue: 0,0:08:53.00,0:08:54.03,Dialogue,,0,0,0,,Оны түзетейік!
Dialogue: 0,0:08:53.06,0:08:54.67,*Default-ja,NTP,0,0,0,,Оны жөндейміз! Эй!?
Dialogue: 0,0:08:54.03,0:08:54.57,Dialogue,,0,0,0,,Мен бір қолымда оқталған винтовка ұстап тұрмын
Dialogue: 0,0:08:54.89,0:08:55.48,Dialogue,,0,0,0,,Мен бір қолымда оқталған винтовка ұстап тұрмын
Dialogue: 0,0:08:54.96,0:08:56.96,*Default-ja,NTP,0,0,0,,Эй!? Оны жөндейміз!
Dialogue: 0,0:08:55.48,0:08:56.90,Dialogue,,0,0,0,,Түзетейік!
Dialogue: 0,0:08:55.81,0:08:57.03,Secondary,,0,0,0,,Бұл рас!
Dialogue: 0,0:08:57.03,0:09:03.01,Dialogue,,0,0,0,,Бұрыштағы суши-бар жарты баға күні балықты пайдаланбайды, олар адамдарды пайдаланады! Адамдар!
Dialogue: 0,0:08:57.12,0:08:57.98,*Default-ja,NTP,0,0,0,,Бұрыштық суши мейрамханасы
Dialogue: 0,0:08:58.00,0:09:01.57,*Default-ja,NTP,0,0,0,,Жарты баға күні, балық, адам, адам
Dialogue: 0,0:09:01.84,0:09:02.28,*Default-ja,NTP,0,0,0,,Қорқынышты~
Dialogue: 0,0:09:02.04,0:09:03.01,Secondary,,0,0,0,,Тоғуса,
Dialogue: 0,0:09:02.28,0:09:05.03,*Default-ja,NTP,0,0,0,,Ватакуса мырза, басқа көлік алғыңыз келе ме? Бұл көлік
Dialogue: 0,0:09:03.01,0:09:05.01,Dialogue,,0,0,0,,көлікті аниме кейіпкерлерімен және заттармен безендірейік.
Dialogue: 0,0:09:05.01,0:09:06.56,Dialogue,,0,0,0,,Бұл керемет көрінеді.
Dialogue: 0,0:09:05.26,0:09:06.59,*Default-ja,NTP,0,0,0,,Бұл жақсы~ Ita көлігі
Dialogue: 0,0:09:06.56,0:09:07.43,Dialogue,,0,0,0,,Мен сені өлтірер едім.
Dialogue: 0,0:09:06.80,0:09:07.48,*Default-ja,NTP,0,0,0,,I'll kill you
Dialogue: 0,0:09:07.43,0:09:10.15,Dialogue,,0,0,0,,Итальяндық көліктер қымбат, солай ма? Өйткені олар шетелдік және бәрі.
Dialogue: 0,0:09:07.55,0:09:10.56,*Default-ja,NTP,0,0,0,,Итальяндық көліктер қымбат, солай ма? Өйткені бұл шетелдік көлік
Dialogue: 0,0:09:10.15,0:09:12.72,Dialogue,,0,0,0,,Ішкі теңізден алынған лосось, өтінемін!
Dialogue: 0,0:09:10.77,0:09:12.82,*Default-ja,NTP,0,0,0,,Маған Сетучидегі манты асшаянын беріңізші!
Dialogue: 0,0:09:12.72,0:09:14.78,Dialogue,,0,0,0,,Сарықұйрықты және жолақты теңіз басы!
Dialogue: 0,0:09:12.95,0:09:14.32,*Default-ja,NTP,0,0,0,,Сарықұйрық пен жолақты скумбрия!
Dialogue: 0,0:09:22.28,0:09:23.40,Dialogue,,0,0,0,,5 йен
Dialogue: 0,0:09:22.46,0:09:23.36,*Default-ja,NTP,0,0,0,,Бұл қауіпті.
Dialogue: 0,0:09:23.40,0:09:24.66,Dialogue,,0,0,0,,Иә, солай.
Dialogue: 0,0:09:23.50,0:09:24.61,*Default-ja,NTP,0,0,0,,Бұл қауіпті.
Dialogue: 0,0:09:24.66,0:09:29.85,Dialogue,,0,0,0,,Уф. Ешкім оның бір бөтелкесін, әсіресе өзіне төгіп тастамайды.
Dialogue: 0,0:09:25.12,0:09:29.11,*Default-ja,NTP,0,0,0,,Қалыпты Бөтелкені толығымен төгуім керек пе? Ал өзіме...
Dialogue: 0,0:09:29.85,0:09:33.55,Dialogue,,0,0,0,,Бұл жақсы емес. Мен...тым ұйықтап жатырмын.
Dialogue: 0,0:09:30.09,0:09:33.78,*Default-ja,NTP,0,0,0,,Жоқ, мен тым ұйықтап жатырмын.
Dialogue: 0,0:09:33.55,0:09:36.30,Dialogue,,0,0,0,,Біз тауарды жеткізгенше ұйықтай алмайсың.
Dialogue: 0,0:09:34.01,0:09:35.99,*Default-ja,NTP,0,0,0,,Ол жеткізілгенше ұйықтама
Dialogue: 0,0:09:36.30,0:09:38.01,Dialogue,,0,0,0,,Ой, сұмдық.
Dialogue: 0,0:09:36.52,0:09:40.13,*Default-ja,NTP,0,0,0,,Сұмдық, сұмдық... Менің қабақтарым...!
Dialogue: 0,0:09:38.01,0:09:40.35,Dialogue,,0,0,0,,М-Менің қабақтарым!
Dialogue: 0,0:09:40.79,0:09:41.76,Dialogue,,0,0,0,,Алға қара!
Dialogue: 0,0:09:40.96,0:09:41.94,*Default-ja,NTP,0,0,0,,Алға қара!
Dialogue: 0,0:09:42.32,0:09:44.22,Dialogue,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:09:43.34,0:09:44.19,*Default-ja,NTP,0,0,0,,Кешіріңіз
Dialogue: 0,0:09:44.22,0:09:45.16,Dialogue,,0,0,0,,Сабаққа қатыса алмайтыны үшін оған ерекше қарайды...
Dialogue: 0,0:09:44.27,0:09:45.06,*Default-ja,NTP,0,0,0,,Не?
Dialogue: 0,0:09:45.16,0:09:49.98,Dialogue,,0,0,0,,Бұл жігіт ұйқының көзі. Егер сіз оны сол жерге тастасаңыз, бәріміз жақсы боламыз.
Dialogue: 0,0:09:45.27,0:09:47.27,*Default-ja,NTP,0,0,0,,Коно халқы, ұйқышылдық көзі
Dialogue: 0,0:09:47.30,0:09:49.69,*Default-ja,NTP,0,0,0,,Лақтырсаң Миннаның жағдайы жақсарады.
Dialogue: 0,0:09:49.98,0:09:51.52,Dialogue,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:09:59.03,0:10:00.62,Dialogue,,0,0,0,,Казтано?
Dialogue: 0,0:09:59.46,0:10:02.48,*Default-ja,NTP,0,0,0,,Казутано мен саған суши әкелдім!
Dialogue: 0,0:10:00.62,0:10:02.53,Dialogue,,0,0,0,,Біз саған суши әкелдік.
Dialogue: 0,0:10:02.53,0:10:06.76,Dialogue,,0,0,0,,Ей, біз саған Ресейден суши әкелген ескі табақ алдық.
Dialogue: 0,0:10:02.99,0:10:06.39,*Default-ja,NTP,0,0,0,,Сәлем! Мен «Россия сушиден» ескі тәрелке алдым!
Dialogue: 0,0:10:07.95,0:10:10.04,Dialogue,,0,0,0,,Әй, не болды?!
Dialogue: 0,0:10:08.73,0:10:09.71,*Default-ja,NTP,0,0,0,,Бұл не!?
Dialogue: 0,0:10:15.87,0:10:19.72,Dialogue,,0,0,0,,Оның электрондық поштасы табақты бұзу туралы емес еді...
Dialogue: 0,0:10:16.22,0:10:19.70,*Default-ja,NTP,0,0,0,,Электрондық пошта бұрын тақтайша сынбаған.
Dialogue: 0,0:10:19.72,0:10:20.64,Dialogue,,0,0,0,,Иә...
Dialogue: 0,0:10:19.79,0:10:20.59,*Default-ja,NTP,0,0,0,,О
Dialogue: 0,0:10:21.27,0:10:23.61,Dialogue,,0,0,0,,Бұл тостаған еді!
Dialogue: 0,0:10:21.48,0:10:22.71,*Default-ja,NTP,0,0,0,,Бұл ыдыс!
Dialogue: 0,0:10:23.61,0:10:24.89,Dialogue,,0,0,0,,Дотачин.
Dialogue: 0,0:10:23.93,0:10:27.81,*Default-ja,NTP,0,0,0,,Dotachin «Оңай канджи түрлендіру»…
Dialogue: 0,0:10:25.28,0:10:27.39,Dialogue,,0,0,0,,"Қарапайым канжиді түрлендіру..."
Dialogue: 0,0:10:27.39,0:10:30.27,Dialogue,,0,0,0,,Казтано...
Dialogue: 0,0:10:27.93,0:10:29.71,*Default-ja,NTP,0,0,0,,Казутаноның жігіті...
Dialogue: 0,0:10:32.35,0:10:36.32,Dialogue,,0,0,0,,Қазтаноны адам саудагерлері ұрлап кеткен.
Dialogue: 0,0:10:32.76,0:10:35.94,*Default-ja,NTP,0,0,0,,Казутаноны адам аңшылары ұрлап әкетті.
Dialogue: 0,0:10:36.32,0:10:38.51,Dialogue,,0,0,0,,Біз оны енді ешқашан таба алмаймыз.
Dialogue: 0,0:10:36.65,0:10:38.00,*Default-ja,NTP,0,0,0,,Мен оны енді ешқашан таба алмаймын...
Dialogue: 0,0:10:40.43,0:10:44.02,Dialogue,,0,0,0,,Қазтаносыз мен қалай жүремін?!
Dialogue: 0,0:10:40.66,0:10:43.83,*Default-ja,NTP,0,0,0,,Мен қазірден бастап Казутаносыз не істеуім керек?
Dialogue: 0,0:10:44.02,0:10:46.70,Dialogue,,0,0,0,,Мен не үшін тұрамын?!
Dialogue: 0,0:10:44.07,0:10:46.50,*Default-ja,NTP,0,0,0,,Мен өз өмірімді не нәрсеге сүйенуім керек?
Dialogue: 0,0:10:48.81,0:10:54.92,Dialogue,,0,0,0,,Казтаноның Тоғуса үшін қаншалықты маңызды екенін бәріміз білдік.
Dialogue: 0,0:10:49.06,0:10:54.53,*Default-ja,NTP,0,0,0,,Казутаноның Ватанакуса үшін қаншалықты маңызды екенін бәріміз білдік.
Dialogue: 0,0:10:54.92,0:10:57.88,Dialogue,,0,0,0,,Қазтаноның орнын ешкім баса алмады.
Dialogue: 0,0:10:55.14,0:10:57.61,*Default-ja,NTP,0,0,0,,Казутаноны ешкім алмастыра алмайды.
Dialogue: 0,0:10:57.88,0:11:01.12,Dialogue,,0,0,0,,Карисава емес, Юмасаки емес, мен емес.
Dialogue: 0,0:10:57.99,0:10:59.84,*Default-ja,NTP,0,0,0,,Каризавада да, Юмасакиде де
Dialogue: 0,0:11:00.16,0:11:00.98,*Default-ja,NTP,0,0,0,,Мен де
Dialogue: 0,0:11:01.12,0:11:02.43,Dialogue,,0,0,0,,Бәріміз де мұңайып қалдық.
Dialogue: 0,0:11:01.36,0:11:02.80,*Default-ja,NTP,0,0,0,,Мен өзімді аздап жалғыз сезінемін...
Dialogue: 0,0:11:04.87,0:11:09.42,Dialogue,,0,0,0,,Егер ол электрондық поштаны жіберген уақытта ұрланған болса, көп уақыт өткен жоқ.
Dialogue: 0,0:11:05.31,0:11:07.50,*Default-ja,NTP,0,0,0,,Электрондық хат келген кезде сізді ұрлап кетсе ше?
Dialogue: 0,0:11:07.61,0:11:09.07,*Default-ja,NTP,0,0,0,,Жақында
Dialogue: 0,0:11:09.42,0:11:13.98,Dialogue,,0,0,0,,Біз оны тауып береміз де, оны ұстап бермейінше қайтарамыз.
Dialogue: 0,0:11:09.70,0:11:13.53,*Default-ja,NTP,0,0,0,,Казутаноны тауып, оны жеткізгенше қайтарып алыңыз.
Dialogue: 0,0:11:13.98,0:11:16.88,Dialogue,,0,0,0,,Бірақ қалай?!
Dialogue: 0,0:11:14.12,0:11:15.59,*Default-ja,NTP,0,0,0,,Бірақ қалай?
Dialogue: 0,0:11:16.88,0:11:18.44,Dialogue,,0,0,0,,Жүріңдер, асығыңдар, жігіттер
Dialogue: 0,0:11:17.08,0:11:17.98,*Default-ja,NTP,0,0,0,,Мен білемін!
Dialogue: 0,0:11:20.06,0:11:22.41,Dialogue,,0,0,0,,Мен олардың көлігін көрдім!
Dialogue: 0,0:11:20.22,0:11:22.38,*Default-ja,NTP,0,0,0,,Мен олардың көлігін көрдім!
Dialogue: 0,0:11:22.82,0:11:24.01,Dialogue,,0,0,0,,Хасим!
Dialogue: 0,0:11:23.03,0:11:24.08,*Default-ja,NTP,0,0,0,,Хашем!
Dialogue: 0,0:11:24.01,0:11:24.90,Dialogue,,0,0,0,,Ол осында!
Dialogue: 0,0:11:24.15,0:11:28.18,*Default-ja,NTP,0,0,0,,Міне! Кіші іні типіндегі көмекші ертегі кейіпкері!
Dialogue: 0,0:11:24.90,0:11:28.41,Dialogue,,0,0,0,,«Кіші іні құтқарушы» кейіпкерінің ең жақсы түрі!
Dialogue: 0,0:11:30.40,0:11:35.49,Dialogue,,0,0,0,,Техас штатындағы Аверс қаласында бөтен планетаның мәйіті жасалды!
Dialogue: 0,0:11:31.75,0:11:38.34,Secondary,,0,0,0,,Жарайды, түсіндім. Ол көлікті тапқанда, ол шетелдікті босатып алуы керек, солай ма?
Dialogue: 0,0:11:33.29,0:11:34.11,*Default-ja,NTP,0,0,0,,Түсіндім
Dialogue: 0,0:11:34.64,0:11:37.90,*Default-ja,NTP,0,0,0,,Егер тауып алсаңыз, ішіндегі шетелдікті босатуыңыз керек.
Dialogue: 0,0:11:36.22,0:11:42.50,Dialogue,,0,0,0,,Біз мәйітті тексеруге қатысқан адаммен сұхбаттасудың сәті түсті.
Dialogue: 0,0:11:38.34,0:11:43.47,Secondary,,0,0,0,,Иә, бірақ тапсыру қашан және қайда болатынын білмейміз.
Dialogue: 0,0:11:38.72,0:11:39.52,*Default-ja,NTP,0,0,0,,О
Dialogue: 0,0:11:39.68,0:11:43.35,*Default-ja,NTP,0,0,0,,Біз олардың тауарды қашан, қайда тапсыратынын білмейміз.
Dialogue: 0,0:11:43.47,0:11:46.03,Dialogue,,0,0,0,,Біз оған мүмкіндігінше тезірек көмектескіміз келеді.
Dialogue: 0,0:11:43.61,0:11:45.77,*Default-ja,NTP,0,0,0,,Бірақ мен сені тезірек құтқарғым келеді.
Dialogue: 0,0:11:46.03,0:11:48.35,Dialogue,,0,0,0,,Жарайды, бұл қара фургон.
Dialogue: 0,0:11:46.25,0:11:47.93,*Default-ja,NTP,0,0,0,,Жарайды, қара фургон.
Dialogue: 0,0:11:48.35,0:11:49.68,Dialogue,,0,0,0,,Сіз нөмірді білесіз бе?
Dialogue: 0,0:11:48.45,0:11:49.72,*Default-ja,NTP,0,0,0,,Сіз нөмірді білесіз бе?
Dialogue: 0,0:11:49.68,0:11:50.77,Dialogue,,0,0,0,,Иә, мен оны саған беремін.
Dialogue: 0,0:11:49.75,0:11:50.67,*Default-ja,NTP,0,0,0,,О, мен айтайын.
Dialogue: 0,0:11:50.77,0:11:51.85,Dialogue,,0,0,0,,Бір секунд.
Dialogue: 0,0:11:50.98,0:11:52.04,*Default-ja,NTP,0,0,0,,А, сәл күте тұрыңыз.
Dialogue: 0,0:11:53.40,0:11:55.21,Dialogue,,0,0,0,,Алдымен, ортаңғы және көрсеткі саусақтарыңызды осылайша қосыңыз,
Dialogue: 0,0:11:53.77,0:11:54.50,*Default-ja,NTP,0,0,0,,Жарайды.
Dialogue: 0,0:11:56.15,0:11:58.64,Dialogue,,0,0,0,,Рахмет, Хасим.
Dialogue: 0,0:11:56.54,0:11:57.85,*Default-ja,NTP,0,0,0,,Рахмет саған Хашим
Dialogue: 0,0:11:58.04,0:11:58.68,*Default-ja,NTP,0,0,0,,Иә
Dialogue: 0,0:11:58.64,0:12:00.13,Dialogue,,0,0,0,,Сіз суши жей аласыз ба?
Dialogue: 0,0:11:58.82,0:12:00.09,*Default-ja,NTP,0,0,0,,Сіз суши жей аласыз ба?
Dialogue: 0,0:12:00.13,0:12:00.84,Dialogue,,0,0,0,,Мен бір қолымда оқталған винтовка ұстап тұрмын
Dialogue: 0,0:12:00.19,0:12:00.91,*Default-ja,NTP,0,0,0,,Иә!
Dialogue: 0,0:12:00.84,0:12:01.40,Dialogue,,0,0,0,,Кездескенше.
Dialogue: 0,0:12:01.03,0:12:01.74,*Default-ja,NTP,0,0,0,,Мен... Мен ондай жігіттерді шын жек көремін!
Dialogue: 0,0:12:01.40,0:12:03.02,Dialogue,,0,0,0,,Мұның васаби бар ма?
Dialogue: 0,0:12:01.87,0:12:02.84,*Default-ja,NTP,0,0,0,,Бұл васаби ме?
Dialogue: 0,0:12:03.02,0:12:03.70,Dialogue,,0,0,0,,Иә, солай.
Dialogue: 0,0:12:03.20,0:12:04.08,*Default-ja,NTP,0,0,0,,Ішінде.
Dialogue: 0,0:12:04.02,0:12:07.01,Dialogue,,0,0,0,,Сізде бәрі жақсы болады. Орыс васаби онша күшті емес.
Dialogue: 0,0:12:04.12,0:12:07.05,*Default-ja,NTP,0,0,0,,Жарайды, орысша васаби ащы емес.
Dialogue: 0,0:12:07.01,0:12:08.92,Dialogue,,0,0,0,,Оған өтірік айтпау керек.
Dialogue: 0,0:12:07.09,0:12:08.91,*Default-ja,NTP,0,0,0,,Өтірік айтпа
Dialogue: 0,0:12:08.92,0:12:09.64,Dialogue,,0,0,0,,Вент одан әрі ашылмауына қол жеткіздік.
Dialogue: 0,0:12:09.00,0:12:09.71,*Default-ja,NTP,0,0,0,,Кеттік
Dialogue: 0,0:12:09.64,0:12:10.20,Dialogue,,0,0,0,,Жарайсыңдар!
Dialogue: 0,0:12:14.86,0:12:16.21,Dialogue,,0,0,0,,Бұл қара фургон, солай ма?
Dialogue: 0,0:12:14.93,0:12:17.58,*Default-ja,NTP,0,0,0,,Қара фургонда бұл сан.
Dialogue: 0,0:12:16.21,0:12:17.71,Dialogue,,0,0,0,,Бұл нөмірдің нөмірі.
Dialogue: 0,0:12:19.84,0:12:21.53,Dialogue,,0,0,0,,Абайлаңыз!
Dialogue: 0,0:12:20.09,0:12:21.30,*Default-ja,NTP,0,0,0,,Абайлаңыз~
Dialogue: 0,0:12:25.90,0:12:29.01,Dialogue,,0,0,0,,Қылмыскерлерге қандай да бір сыбайлас жемқорлық ұйымның келісімі болуы керек.
Dialogue: 0,0:12:26.26,0:12:29.22,*Default-ja,NTP,0,0,0,,Орындау бөлімі қандай да бір жосықсыз компанияның қосалқы мердігері болып табылады.
Dialogue: 0,0:12:29.45,0:12:31.77,Dialogue,,0,0,0,,Олар жай ғана астарлылар шығар.
Dialogue: 0,0:12:29.70,0:12:31.33,*Default-ja,NTP,0,0,0,,Ал, түбінің түбі.
Dialogue: 0,0:12:34.31,0:12:39.34,Dialogue,,0,0,0,,Олар жоғалып кеткеннен кейін ешкім іздемейтін адамдарды ұрлап әкетсе керек.
Dialogue: 0,0:12:34.65,0:12:38.98,*Default-ja,NTP,0,0,0,,Жоғалып кетсе де шыдай алмайтын адамдарды ұрлап, жоғарыдағыларға тапсыратын көрінеді.
Dialogue: 0,0:12:39.34,0:12:44.82,Dialogue,,0,0,0,,Бұл адамдар әртүрлі нәрселер үшін пайдаланылған болуы мүмкін.
Dialogue: 0,0:12:39.45,0:12:43.65,*Default-ja,NTP,0,0,0,,Менің ойымша, адамдар көп нәрсеге материал ретінде пайдаланылады.
Dialogue: 0,0:12:44.82,0:12:47.35,Dialogue,,0,0,0,,Бұл каннибализм сияқты.
Dialogue: 0,0:12:45.30,0:12:46.79,*Default-ja,NTP,0,0,0,,Бұл каннибализм сияқты.
Dialogue: 0,0:12:47.99,0:12:51.45,Dialogue,,0,0,0,,Осы айда көп жөнелтілген жоқ.
Dialogue: 0,0:12:48.23,0:12:51.75,*Default-ja,NTP,0,0,0,,Осы айда қосалқы мердігер жеткізілімдерінің саны аз.
Dialogue: 0,0:12:51.45,0:12:53.99,Dialogue,,0,0,0,,Дұрыс. Соңғы кездері біздің материалдарымыз аса сақ бола бастады —
Dialogue: 0,0:12:52.88,0:12:54.23,*Default-ja,NTP,0,0,0,,Күлсін... Соңғы кездері материалдарға сақтықпен қарайтын болдым...
Dialogue: 0,0:12:53.99,0:12:55.74,Dialogue,,0,0,0,,Сылтаулар жеткілікті.
Dialogue: 0,0:12:54.27,0:12:55.62,*Default-ja,NTP,0,0,0,,Сақтау жақсы.
Dialogue: 0,0:12:55.74,0:12:58.31,Dialogue,,0,0,0,,Сандарын көтере алмайтын кез келген мердігерлермен байланысыңызды үзіңіз.
Dialogue: 0,0:12:55.84,0:12:58.27,*Default-ja,NTP,0,0,0,,Сандарды көбейте алмайтын қосалқы мердігерлердің жұмысын тоқтату
Dialogue: 0,0:12:58.31,0:12:59.00,Dialogue,,0,0,0,,Бірақ—
Dialogue: 0,0:12:58.39,0:12:59.04,*Default-ja,NTP,0,0,0,,Бірақ...
Dialogue: 0,0:12:59.00,0:13:01.67,Dialogue,,0,0,0,,Немесе сіз субъект болғыңыз келе ме?
Dialogue: 0,0:12:59.09,0:13:01.94,*Default-ja,NTP,0,0,0,,Әлде сіз материалсыз ба?
Dialogue: 0,0:13:03.12,0:13:05.53,Dialogue,,0,0,0,,Сіз қазір кете аласыз.
Dialogue: 0,0:13:03.31,0:13:04.25,*Default-ja,NTP,0,0,0,,Сіз артқа шегінуге болады.
Dialogue: 0,0:13:13.86,0:13:15.64,Thought,,0,0,0,,Сейджи...
Dialogue: 0,0:13:14.13,0:13:15.39,*Default-ja,NTP,0,0,0,,Сейджи...
Dialogue: 0,0:13:32.66,0:13:34.41,Dialogue,,0,0,0,,Шинра, сен ақымақ!
Dialogue: 0,0:13:33.20,0:13:34.38,*Default-ja,NTP,0,0,0,,Ақымақ Силла
Dialogue: 0,0:13:34.41,0:13:38.17,Dialogue,,0,0,0,,Жұмсақ самалмен желпілдеп, тербеледі.
Dialogue: 0,0:13:34.57,0:13:40.02,*Default-ja,NTP,0,0,0,,Кирамеку… О-доро…
Dialogue: 0,0:13:38.17,0:13:40.02,Dialogue,,0,0,0,,Гүрілдеген дыбыс—
Dialogue: 0,0:13:40.96,0:13:45.34,Dialogue,,0,0,0,,Қазтаноны ұрлап кеткен қара фургонды іздедік...
Dialogue: 0,0:13:41.30,0:13:44.64,*Default-ja,NTP,0,0,0,,Біз Казутаноны ұрлап кеткен қара фургонды іздедік.
Dialogue: 0,0:13:45.34,0:13:48.01,Dialogue,,0,0,0,,...біз оны құтқарамыз деген ұғыммен жүрегімізде берік орнықты.
Dialogue: 0,0:13:45.57,0:13:48.11,*Default-ja,NTP,0,0,0,,Мен сені міндетті түрде құтқарамын деген сезіммен...
Dialogue: 0,0:13:49.05,0:13:51.67,Dialogue,,0,0,0,,Біз ойымызға келгеннің бәрін қолданып көрдік...
Dialogue: 0,0:13:49.53,0:13:51.59,*Default-ja,NTP,0,0,0,,Мен ойыма келгеннің бәрін сынап көрдім
Dialogue: 0,0:13:49.78,0:13:52.29,Secondary,,0,0,0,,Жақсы бала. Жақсы...
Dialogue: 0,0:13:51.67,0:13:55.39,Dialogue,,0,0,0,,Бірақ оның қайда болуы мүмкін екенін білмедік.
Dialogue: 0,0:13:51.79,0:13:54.26,*Default-ja,NTP,0,0,0,,Казутаноның қайда екені белгісіз.
Dialogue: 0,0:13:53.39,0:13:54.68,Secondary,,0,0,0,,Бар!
Dialogue: 0,0:13:55.39,0:13:57.86,Dialogue,,0,0,0,,Менің санамды қорқыныш билей бастады.
Dialogue: 0,0:13:55.67,0:13:57.67,*Default-ja,NTP,0,0,0,,Мазасыздық санамнан өтті
Dialogue: 0,0:13:57.86,0:14:03.00,Dialogue,,0,0,0,,Қазтано айтатын ностальгиялық сөзді енді ешқашан естімей ме деп қорқамын.
Dialogue: 0,0:13:58.23,0:14:02.69,*Default-ja,NTP,0,0,0,,Мен Казутаноның ностальгиялық фразасын енді ешқашан естімейтін шығармын.
Dialogue: 0,0:14:03.00,0:14:06.06,Dialogue,,0,0,0,,Мен бала кезімде жиі еститін ностальгиялық сөйлемді.
Dialogue: 0,0:14:03.12,0:14:06.18,*Default-ja,NTP,0,0,0,,Бала кезімде жиі еститін ностальгиялық тіркесті.
Dialogue: 0,0:14:06.64,0:14:10.87,Dialogue,,0,0,0,,Бұл сөзді мен өскенде қайта естимін деп ойламаппын...
Dialogue: 0,0:14:06.95,0:14:11.00,*Default-ja,NTP,0,0,0,,Мен өскенде ешқашан естімеймін деп ойлаған сөйлемдер
Dialogue: 0,0:14:10.87,0:14:15.87,Dialogue,,0,0,0,,Сізде билеттер бар ма? Билеттер осында!
Dialogue: 0,0:14:11.18,0:14:16.11,*Default-ja,NTP,0,0,0,,Билет жоқ па? Билет Al!
Dialogue: 0,0:14:15.87,0:14:20.04,Secondary,,0,0,0,,Сізде билеттер бар ма?
Dialogue: 0,0:14:15.87,0:14:20.47,Dialogue,,0,0,0,,Иә, Қазтано кәсіпшілігі жойылудың аз-ақ алдында еді.
Dialogue: 0,0:14:16.14,0:14:20.31,*Default-ja,NTP,0,0,0,,Иә, Казутано – қазір жойылып бара жатқан адам.
Dialogue: 0,0:14:20.47,0:14:26.73,Dialogue,,0,0,0,,Ал Тоғұсаға өміріндегі ең үлкен қуаныш сыйлаған Қазтано болды.
Dialogue: 0,0:14:20.76,0:14:26.15,*Default-ja,NTP,0,0,0,,Ал Ватакуса Казутаноға өміріндегі ең үлкен қуанышты сеніп тапсырды.
Dialogue: 0,0:14:20.79,0:14:23.08,Secondary,,0,0,0,,Мырза, екі билет беріңізші.
Dialogue: 0,0:14:26.73,0:14:27.88,Dialogue,,0,0,0,,Керемет.
Dialogue: 0,0:14:29.29,0:14:33.68,Dialogue,,0,0,0,,Хиджирибе Рури мәңгілік Тогусаның құдайы болады...
Dialogue: 0,0:14:29.59,0:14:31.31,*Default-ja,NTP,0,0,0,,Ватакусаның мәңгілік құдайы
Dialogue: 0,0:14:31.58,0:14:32.91,*Default-ja,NTP,0,0,0,,Руридің қасиетті жағы
Dialogue: 0,0:14:33.67,0:14:36.92,*Default-ja,NTP,0,0,0,,Ватакуса бір жақты сүйіспеншілігін ұсынатын құдай
Dialogue: 0,0:14:33.68,0:14:36.89,Dialogue,,0,0,0,,Тоғуса бір жақты мейірім төгетін құдай.
Dialogue: 0,0:14:37.37,0:14:44.40,Dialogue,,0,0,0,,Тоғуса Қазтаноға сиқыршы ретінде қарайды, өйткені ол лық толы концерт кезінде оған құдайына ең жақын орын алып берді.
Dialogue: 0,0:14:37.59,0:14:42.16,*Default-ja,NTP,0,0,0,,Казутано сізге богиняға ең жақын орынды береді, оны алу қиын.
Dialogue: 0,0:14:42.35,0:14:44.28,*Default-ja,NTP,0,0,0,,Бұл Ватакусаның сиқыршысы.
Dialogue: 0,0:14:47.69,0:14:52.00,Dialogue,,0,0,0,,Тоғуса үшін, Казтаноны құтқаруымыз керек, құнына қарамастан.
Dialogue: 0,0:14:47.91,0:14:52.03,*Default-ja,NTP,0,0,0,,Ватакуса үшін біз Казутаноны құтқаруымыз керек.
Dialogue: 0,0:14:52.00,0:14:52.70,Dialogue,,0,0,0,,Дотачин?
Dialogue: 0,0:14:52.17,0:14:54.30,*Default-ja,NTP,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:14:52.78,0:14:54.54,Dialogue,,0,0,0,,Сіз не туралы айтып тұрсыз?
Dialogue: 0,0:14:54.54,0:14:55.89,Dialogue,,0,0,0,,Және кімге?
Dialogue: 0,0:14:54.72,0:14:55.89,*Default-ja,NTP,0,0,0,,Және кіммен?
Dialogue: 0,0:14:55.89,0:14:56.87,Dialogue,,0,0,0,,Ал...
Dialogue: 0,0:14:56.00,0:14:56.76,*Default-ja,NTP,0,0,0,,Жоқ…
Dialogue: 0,0:14:56.87,0:15:02.00,Dialogue,,0,0,0,,Мен енді ойладым, неге Қазтаноның телефонына хабарласпасқа?
Dialogue: 0,0:14:57.16,0:15:02.02,*Default-ja,NTP,0,0,0,,Мен Казутаноның телефонына осы жерден қоңырау шалып көре аласыз ба деп ойладым.
Dialogue: 0,0:15:02.00,0:15:05.55,Dialogue,,0,0,0,,Мүмкін біз оны ұрлап кеткендермен келіссөздер жүргізе аламыз.
Dialogue: 0,0:15:02.19,0:15:05.47,*Default-ja,NTP,0,0,0,,Мүмкін сол жақтағы жігіттермен келіссөздер жүргізетін шығармыз.
Dialogue: 0,0:15:15.61,0:15:18.79,Dialogue,,0,0,0,,Суши махаббаты. Маған майлы тунец ұнайды.
Dialogue: 0,0:15:15.88,0:15:17.29,*Default-ja,NTP,0,0,0,,Суши махаббаты
Dialogue: 0,0:15:17.36,0:15:18.72,*Default-ja,NTP,0,0,0,,Маған оторо ұнайды
Dialogue: 0,0:15:18.79,0:15:20.39,Dialogue,,0,0,0,,М-мен бұған енді маңызды емес дедім!
Dialogue: 0,0:15:18.97,0:15:20.24,*Default-ja,NTP,0,0,0,,Не? Сіз
Dialogue: 0,0:15:20.99,0:15:22.69,*Default-ja,NTP,0,0,0,,Әй, бұл дауыс өте қатты!
Dialogue: 0,0:15:20.99,0:15:22.90,Dialogue,,0,0,0,,Бұл сенің дауысың ба, Дотачин?
Dialogue: 0,0:15:22.90,0:15:28.34,Dialogue,,0,0,0,,Иә, мен өтіп бара жатып, мына жігіттің ұйықтап жатқанын көрдім де, оның шырылдағанын естіп, телефонды алдым.
Dialogue: 0,0:15:23.12,0:15:26.49,*Default-ja,NTP,0,0,0,,Иә! Мен өтіп бара жатқанда ұйықтап жатқан адамдарды көрдім.
Dialogue: 0,0:15:26.60,0:15:28.24,*Default-ja,NTP,0,0,0,,Менің ұялы телефоным шырылдап жатыр, оның орнына...
Dialogue: 0,0:15:28.34,0:15:30.45,Dialogue,,0,0,0,,Иә? Мұнда?
Dialogue: 0,0:15:28.44,0:15:30.06,*Default-ja,NTP,0,0,0,,Не? Мұнда?
Dialogue: 0,0:15:30.45,0:15:34.51,Dialogue,,0,0,0,,Мен оңтүстік Икебукуро Тайшоукеннен диагональмын...
Dialogue: 0,0:15:30.91,0:15:33.77,*Default-ja,NTP,0,0,0,,Минами Икебукуро «Тайшөкеңнің» алдында қиғаш.
Dialogue: 0,0:15:34.99,0:15:39.20,Dialogue,,0,0,0,,Айтайын дегенім, қазір Ресей сушиінде жеңілдік күні...
Dialogue: 0,0:15:35.18,0:15:38.68,*Default-ja,NTP,0,0,0,,Иә? Өйткені, бүгін «Россия Азия сушиге» қызмет көрсететін күн емес пе?
Dialogue: 0,0:15:43.78,0:15:46.38,Dialogue,,0,0,0,,Изая, ешқашан Икебукураға келме!
Dialogue: 0,0:15:43.91,0:15:46.76,*Default-ja,NTP,0,0,0,,Изая! Икебукуроға келме!
Dialogue: 0,0:15:46.72,0:15:50.34,Dialogue,,0,0,0,,Ой, Шизу-чан мені тауып алды. Кейінірек.
Dialogue: 0,0:15:46.76,0:15:49.38,*Default-ja,NTP,0,0,0,,Ах, Шизу-чан мені тапты! Сонда кездескенше!
Dialogue: 0,0:15:50.30,0:15:53.23,*Default-ja,NTP,0,0,0,,Міне кеттік!
Dialogue: 0,0:15:50.34,0:15:53.43,Dialogue,,0,0,0,,IIIзааааааа!
Dialogue: 0,0:15:54.62,0:15:55.89,Dialogue,,0,0,0,,Оян!
Dialogue: 0,0:15:54.73,0:15:56.83,*Default-ja,NTP,0,0,0,,Оян! Эй оян!
Dialogue: 0,0:15:55.89,0:15:57.14,Dialogue,,0,0,0,,Әй, оян!
Dialogue: 0,0:15:57.53,0:16:01.67,*Default-ja,NTP,0,0,0,,Әй, оян! Оян, эй!
Dialogue: 0,0:15:57.86,0:16:00.14,Dialogue,,0,0,0,,Әй, оян!
Dialogue: 0,0:16:00.14,0:16:02.03,Dialogue,,0,0,0,,Оян!
Dialogue: 0,0:16:02.03,0:16:05.96,Dialogue,,0,0,0,,Оларды қолданбаңыз; егер сен жасасаң, ол мәңгі ұйықтап қалады.
Dialogue: 0,0:16:02.28,0:16:05.66,*Default-ja,NTP,0,0,0,,Оны жайына қалдыр да, мәңгілік ұйқыға кет.
Dialogue: 0,0:16:05.88,0:16:08.34,*Default-ja,NTP,0,0,0,,Бірақ асықпасақ, Казутано келеді!
Dialogue: 0,0:16:05.96,0:16:08.50,Dialogue,,0,0,0,,Бірақ асықпасақ, Қазтано...
Dialogue: 0,0:16:08.42,0:16:11.94,*Default-ja,NTP,0,0,0,,Иә, ол жеткізілгеннен кейін өңделеді!
Dialogue: 0,0:16:08.50,0:16:12.95,Dialogue,,0,0,0,,Оның айтқаны дұрыс! Оны тапсырған соң, ол жойылады!
Dialogue: 0,0:16:22.22,0:16:24.27,Dialogue,,0,0,0,,Сіз не істейсіз?
Dialogue: 0,0:16:22.48,0:16:23.82,*Default-ja,NTP,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:16:24.27,0:16:28.13,Dialogue,,0,0,0,,Мен сіздің кейпіңізге кіріп, Казтаноны қайда тапсыратындарын айтып берейін деп жатырмын.
Dialogue: 0,0:16:24.46,0:16:28.40,*Default-ja,NTP,0,0,0,,Мен бұл жігіттің серігіне Казутаноны қайда тапсыратынын айтамын.
Dialogue: 0,0:16:29.49,0:16:32.03,Dialogue,,0,0,0,,Бұл жігітті тапсыратын уақыт та қалды.
Dialogue: 0,0:16:29.78,0:16:31.85,*Default-ja,NTP,0,0,0,,Жеткізу уақыты жақындап қалды.
Dialogue: 0,0:16:32.03,0:16:34.22,Dialogue,,0,0,0,,Жоғары адам келе жатыр, сондықтан сергек болыңыз.
Dialogue: 0,0:16:32.12,0:16:34.62,*Default-ja,NTP,0,0,0,,Үстіңіздегі адам келе жатыр, сондықтан мұқият болыңыз.
Dialogue: 0,0:16:34.67,0:16:35.50,Dialogue,,0,0,0,,Алдымен, ортаңғы және көрсеткі саусақтарыңызды осылайша қосыңыз,
Dialogue: 0,0:16:35.50,0:16:37.91,Dialogue,,0,0,0,,Мен жапонмын, солай ма?
Dialogue: 0,0:16:35.73,0:16:37.92,*Default-ja,NTP,0,0,0,,Мен жапонмын.
Dialogue: 0,0:16:37.91,0:16:40.68,Dialogue,,0,0,0,,Сіз қателескеніңізді түсінесіз, солай ма?
Dialogue: 0,0:16:38.00,0:16:40.73,*Default-ja,NTP,0,0,0,,Балалар, соло қатесін байқаңдар!
Dialogue: 0,0:16:40.68,0:16:42.25,Dialogue,,0,0,0,,Сіз әлі де солай айтып тұрсыз ба?
Dialogue: 0,0:16:40.79,0:16:41.99,*Default-ja,NTP,0,0,0,,Әлі де талап етесіз бе?
Dialogue: 0,0:16:42.25,0:16:46.36,Dialogue,,0,0,0,,Сонда сіздің отбасыңыздың тізілімінде жапон екеніңіз жазылған, солай ма?
Dialogue: 0,0:16:42.37,0:16:46.16,*Default-ja,NTP,0,0,0,,Сонымен, менің ойымша, бұл отбасылық тіркеуде жапонша деп жазылған шығар?
Dialogue: 0,0:16:46.36,0:16:50.25,Dialogue,,0,0,0,,Мәселе мынада; Менің отбасылық тізілім өрт жарылыстарында жойылды!
Dialogue: 0,0:16:46.42,0:16:47.74,*Default-ja,NTP,0,0,0,,Мәселе мынада!
Dialogue: 0,0:16:48.09,0:16:50.24,*Default-ja,NTP,0,0,0,,Әуе шабуылында отбасылық кітапша жойылды!
Dialogue: 0,0:16:50.25,0:16:52.79,Dialogue,,0,0,0,,Жасың нешеде?!
Dialogue: 0,0:16:50.34,0:16:52.20,*Default-ja,NTP,0,0,0,,Жасың нешеде? Эй!
Dialogue: 0,0:16:52.79,0:16:53.89,Dialogue,,0,0,0,,Уф, емтихандар.
Dialogue: 0,0:16:52.95,0:16:53.72,*Default-ja,NTP,0,0,0,,Иә
Dialogue: 0,0:16:53.89,0:16:55.97,Dialogue,,0,0,0,,Эй, бұл менмін.
Dialogue: 0,0:16:54.00,0:16:55.76,*Default-ja,NTP,0,0,0,,А, мен, мен, мен.
Dialogue: 0,0:16:55.97,0:16:58.73,Dialogue,,0,0,0,,О, Каназава? Сіз ояндыңыз ба?
Dialogue: 0,0:16:56.04,0:16:58.63,*Default-ja,NTP,0,0,0,,А, Каназава? Сіз ояндыңыз ба?
Dialogue: 0,0:16:58.73,0:17:01.11,Dialogue,,0,0,0,,Кешіріңіз, мен дәл қазір барамын.
Dialogue: 0,0:16:58.93,0:17:01.14,*Default-ja,NTP,0,0,0,,Өкінішті, мен қазір барамын.
Dialogue: 0,0:17:01.11,0:17:03.25,Dialogue,,0,0,0,,Айтпақшы, тағы да тапсыру орны қайда?
Dialogue: 0,0:17:01.23,0:17:03.31,*Default-ja,NTP,0,0,0,,Сонымен жеткізу орны қайда?
Dialogue: 0,0:17:03.25,0:17:05.50,Dialogue,,0,0,0,,Адам, сен үмітсізсің.
Dialogue: 0,0:17:03.55,0:17:05.59,*Default-ja,NTP,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:17:05.86,0:17:13.34,Dialogue,,0,0,0,,Біз кереметпіз...
Dialogue: 0,0:17:05.91,0:17:11.82,*Default-ja,NTP,0,0,0,,«Ешкім ұйықтамайды» пародиясы
Dialogue: 0,0:17:05.91,0:17:11.82,*Default-ja,NTP,0,0,0,,Бұл керемет~ Біз~
Dialogue: 0,0:17:06.57,0:17:08.96,Secondary,,0,0,0,,Біз мұны жасадық!
Dialogue: 0,0:17:08.96,0:17:10.53,Secondary,,0,0,0,,Иә!
Dialogue: 0,0:17:11.30,0:17:13.34,Secondary,,0,0,0,,Бұл өз жемісін берді!
Dialogue: 0,0:17:13.34,0:17:17.30,Dialogue,,0,0,0,,Біз мұны жасадық...
Dialogue: 0,0:17:14.73,0:17:17.30,Secondary,,0,0,0,,Сен кімсің?
Dialogue: 0,0:17:15.72,0:17:17.02,*Default-ja,NTP,0,0,0,,Не... не? Балалар сендер
Dialogue: 0,0:17:17.30,0:17:18.39,Dialogue,,0,0,0,,Біз...
Dialogue: 0,0:17:17.50,0:17:21.49,*Default-ja,NTP,0,0,0,,Біз... Доллар
Dialogue: 0,0:17:18.39,0:17:21.01,Dialogue,,0,0,0,,Доллар!
Dialogue: 0,0:17:21.01,0:17:23.02,Dialogue,,0,0,0,,Доллар...?
Dialogue: 0,0:17:21.59,0:17:23.38,*Default-ja,NTP,0,0,0,,Доллар…
Dialogue: 0,0:17:23.02,0:17:24.48,Dialogue,,0,0,0,,«S»!
Dialogue: 0,0:17:23.39,0:17:25.85,*Default-ja,NTP,0,0,0,,Zu! Есіңізде болсын!
Dialogue: 0,0:17:24.48,0:17:25.69,Dialogue,,0,0,0,,Есіңізде болсын!
Dialogue: 0,0:17:28.14,0:17:29.43,Thought,,0,0,0,,Менің ұйқым келіп тұр...
Dialogue: 0,0:17:28.47,0:17:30.62,*Default-ja,NTP,0,0,0,,Менің ұйқым келді... Ұйқым келді...
Dialogue: 0,0:17:29.43,0:17:31.25,Thought,,0,0,0,,Ұйқысыз...
Dialogue: 0,0:17:31.25,0:17:32.28,Dialogue,,0,0,0,,Вент одан әрі ашылмауына қол жеткіздік.
Dialogue: 0,0:17:31.47,0:17:32.26,*Default-ja,NTP,0,0,0,,Кеттік
Dialogue: 0,0:17:32.38,0:17:37.09,Dialogue,,0,0,0,,Бізді The Dollars-қа қосылуға әкелген оқиғалар қатары қарапайым болды.
Dialogue: 0,0:17:32.60,0:17:36.35,*Default-ja,NTP,0,0,0,,Біздің долларға қалай қосылғанымыз туралы әңгіме өте қарапайым болды.
Dialogue: 0,0:17:38.84,0:17:44.54,Dialogue,,0,0,0,,Мен білмей тұрып, Тогуса, Юмасаки және Карисава менің айналамда ілулі тұрды.
Dialogue: 0,0:17:39.01,0:17:41.55,*Default-ja,NTP,0,0,0,,Бастапқыда Ватанакуса, Юмасаки және Карисава болды
Dialogue: 0,0:17:41.71,0:17:44.11,*Default-ja,NTP,0,0,0,,Мен білмей тұрып, айналама адамдар жиналып қалды.
Dialogue: 0,0:17:45.17,0:17:47.63,*Default-ja,NTP,0,0,0,,Мен сияқты адамдарда не жақсы?
Dialogue: 0,0:17:45.25,0:17:47.99,Dialogue,,0,0,0,,Мен сияқты адамның несі керемет екенін білмеймін...
Dialogue: 0,0:17:47.89,0:17:50.05,*Default-ja,NTP,0,0,0,,Мүлдем... біртүрлі шоқ.
Dialogue: 0,0:17:47.99,0:17:50.50,Dialogue,,0,0,0,,Жақсы, олар керемет адамдар.
Dialogue: 0,0:17:50.83,0:17:54.36,Dialogue,,0,0,0,,Бір күні ұялы телефоныма хат келді.
Dialogue: 0,0:17:51.00,0:17:53.95,*Default-ja,NTP,0,0,0,,Бір күні ұялы телефоныма хат келді.
Dialogue: 0,0:17:54.36,0:17:58.71,Dialogue,,0,0,0,,Онда "The Dollars-қа қосылғыңыз келе ме? Ешқандай шектеулер немесе ережелер жоқ.
Dialogue: 0,0:17:54.75,0:17:56.47,*Default-ja,NTP,0,0,0,,«Сіз долларға қосылғыңыз келе ме?»
Dialogue: 0,0:17:56.71,0:17:58.63,*Default-ja,NTP,0,0,0,,«Ешқандай шектеулер немесе ережелер жоқ».
Dialogue: 0,0:17:58.71,0:18:01.11,Dialogue,,0,0,0,,Сізге доллардың бір бөлігі екеніңізді айту жеткілікті».
Dialogue: 0,0:17:58.75,0:18:01.02,*Default-ja,NTP,0,0,0,,«Өзіңізді доллар деп атаңыз».
Dialogue: 0,0:18:01.11,0:18:03.02,Dialogue,,0,0,0,,Бұл біртүрлі шақыру болды...
Dialogue: 0,0:18:01.23,0:18:02.73,*Default-ja,NTP,0,0,0,,Біртүрлі шақыру
Dialogue: 0,0:18:03.02,0:18:07.09,Dialogue,,0,0,0,,Осы эксцентрик долларлардан мен туралы қауесеттер ести бастадым.
Dialogue: 0,0:18:03.14,0:18:06.91,*Default-ja,NTP,0,0,0,,Доллар біраз уақыттан бері әдеттен тыс ұйым деген қауесет тарады.
Dialogue: 0,0:18:07.09,0:18:09.27,Dialogue,,0,0,0,,Алғашында бұл жай еркелік деп ойладым...
Dialogue: 0,0:18:07.31,0:18:09.51,*Default-ja,NTP,0,0,0,,Басында біреудің еркелігі деп ойладым
Dialogue: 0,0:18:09.73,0:18:15.51,Dialogue,,0,0,0,,Бірақ мен бұл тозақтың бәрін қабылдадым, ал келесі күні маған URL мекенжайы мен құпия сөз жіберілді.
Dialogue: 0,0:18:09.82,0:18:11.63,*Default-ja,NTP,0,0,0,,Қабылдауға тырыссаңыз
Dialogue: 0,0:18:11.76,0:18:15.11,*Default-ja,NTP,0,0,0,,URL мекенжайы мен құпия сөз келесі күні жіберілді.
Dialogue: 0,0:18:17.00,0:18:22.24,Dialogue,,0,0,0,,Мен жүйеге кірген кезде, веб-сайтта менің тұтқам көрсетілді.
Dialogue: 0,0:18:17.32,0:18:22.44,*Default-ja,NTP,0,0,0,,Жүйеге кірген кезде менің тұтқам Dollars веб-сайтында көрсетілді.
Dialogue: 0,0:18:23.21,0:18:28.63,Dialogue,,0,0,0,,Мүшелердің ешқайсысы, соның ішінде мен де, сіз көшбасшы деп атауға болатын адамды кездестірмедім.
Dialogue: 0,0:18:23.46,0:18:28.19,*Default-ja,NTP,0,0,0,,Мүшелердің ешқайсысы, оның ішінде мен де көшбасшыны көрген емеспін.
Dialogue: 0,0:18:28.63,0:18:31.61,Dialogue,,0,0,0,,Негізгі ұйымда бірнеше кішігірім ұйымдар бар...
Dialogue: 0,0:18:28.73,0:18:31.29,*Default-ja,NTP,0,0,0,,Ұйымда көптеген ішкі ұйымдар бар.
Dialogue: 0,0:18:31.61,0:18:37.47,Dialogue,,0,0,0,,...және олар иерархияны құраса да, абсолютті шыңды ешкім таба алмайды.
Dialogue: 0,0:18:31.73,0:18:34.30,*Default-ja,NTP,0,0,0,,Олардың әрқайсысы тік қоғам құраса да.
Dialogue: 0,0:18:34.43,0:18:36.63,*Default-ja,NTP,0,0,0,,Тек жоғарғы бөлігі жоқ
Dialogue: 0,0:18:37.82,0:18:42.35,Dialogue,,0,0,0,,Төбесі жоқ болғандықтан, өзімді ешкімнің астына қойғандай сезінбеймін.
Dialogue: 0,0:18:38.05,0:18:42.02,*Default-ja,NTP,0,0,0,,Менің үстімде ешкім болмағандықтан, өзімді ешкімнен төмен сезінбеймін.
Dialogue: 0,0:18:42.35,0:18:49.21,Dialogue,,0,0,0,,Алайда, мен бұл ұйымды кім құрғанын білгім келмейді десем, өтірік айтқан болар едім.
Dialogue: 0,0:18:42.65,0:18:46.72,*Default-ja,NTP,0,0,0,,Бірақ бұл оғаш ұйымдық жүйені кім жасады?
Dialogue: 0,0:18:46.88,0:18:49.05,*Default-ja,NTP,0,0,0,,Мазаламады десем, өтірік айтқан болар едім
Dialogue: 0,0:18:49.21,0:18:53.69,Dialogue,,0,0,0,,Ешкімге айтпа, бірақ кейбіреулер оны сол болды деп ойлайды.
Dialogue: 0,0:18:49.39,0:18:50.60,*Default-ja,NTP,0,0,0,,Тек осында
Dialogue: 0,0:18:50.81,0:18:53.59,*Default-ja,NTP,0,0,0,,Расында, ол кісі екен деп күдіктенетіндер бар.
Dialogue: 0,0:18:53.69,0:18:58.02,Dialogue,,0,0,0,,Мені Дотачин деп атай бастаған әлгі дөрекі жігіт.
Dialogue: 0,0:18:53.88,0:18:57.83,*Default-ja,NTP,0,0,0,,Мені Дотачин деп атай бастаған дөрекілік...
Dialogue: 0,0:18:58.02,0:19:00.75,Dialogue,,0,0,0,,Мм, майлы тунец ең жақсысы.
Dialogue: 0,0:18:58.78,0:19:00.12,*Default-ja,NTP,0,0,0,,Өйткені, Оторо
Dialogue: 0,0:19:04.81,0:19:08.96,Dialogue,,0,0,0,,Сіз іздеген нәрсе олай емес...
Dialogue: 0,0:19:04.96,0:19:08.77,*Default-ja,NTP,0,0,0,,Мен іздеген нәрсе бұл бағытта емес.
Dialogue: 0,0:19:11.42,0:19:13.47,Dialogue,,0,0,0,,Жоқ!
Dialogue: 0,0:19:14.87,0:19:17.34,Dialogue,,0,0,0,,Кешіріңіз, Селти.
Dialogue: 0,0:19:15.01,0:19:17.05,*Default-ja,NTP,0,0,0,,Кешіріңіз... Селти
Dialogue: 0,0:19:17.85,0:19:20.85,Dialogue,,0,0,0,,Оны қаншаға сата аламыз деп ойлайсыз?
Dialogue: 0,0:19:17.99,0:19:20.64,*Default-ja,NTP,0,0,0,,Ол қаншаға сатылады деп ойлайсыз?
Dialogue: 0,0:19:20.85,0:19:23.26,Dialogue,,0,0,0,,Біздің шығындарымызды өтеуге жеткілікті.
Dialogue: 0,0:19:20.90,0:19:23.48,*Default-ja,NTP,0,0,0,,Бұл жұмыс элементі болуы керек.
Dialogue: 0,0:19:23.61,0:19:25.97,Dialogue,,0,0,0,,Барлығы осы ма? Типтік.
Dialogue: 0,0:19:23.74,0:19:25.83,*Default-ja,NTP,0,0,0,,Менің ойымша~ Өйткені
Dialogue: 0,0:19:37.45,0:19:38.68,Dialogue,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:19:38.68,0:19:40.99,Dialogue,,0,0,0,,Бұл жоғарырақ па?
Dialogue: 0,0:19:38.87,0:19:40.18,*Default-ja,NTP,0,0,0,,Бұл жоғарыдағы адам ба?
Dialogue: 0,0:19:42.41,0:19:44.16,Dialogue,,0,0,0,,Мүмкін...
Dialogue: 0,0:19:42.75,0:19:43.94,*Default-ja,NTP,0,0,0,,Мүмкін.
Dialogue: 0,0:19:45.66,0:19:46.83,Dialogue,,0,0,0,,Тағы бір қосымша сабақ па, иә...
Dialogue: 0,0:19:51.34,0:19:52.50,Dialogue,,0,0,0,,Не деген сұмдық?!
Dialogue: 0,0:19:51.39,0:19:52.57,*Default-ja,NTP,0,0,0,,《Егер мен бұны істей алмасам, мен…
Dialogue: 0,0:19:53.39,0:19:54.25,Dialogue,,0,0,0,,Казтано!
Dialogue: 0,0:19:53.67,0:19:54.66,*Default-ja,NTP,0,0,0,,Казутано!
Dialogue: 0,0:19:55.97,0:19:58.34,Dialogue,,0,0,0,,Біз сені құтқару үшін келдік, Қазтано!
Dialogue: 0,0:19:56.22,0:19:58.51,*Default-ja,NTP,0,0,0,,Казутано Мен саған қазір көмектесемін!
Dialogue: 0,0:19:58.83,0:20:00.54,Dialogue,,0,0,0,,Бұл оңай болмайды.
Dialogue: 0,0:19:58.96,0:20:00.61,*Default-ja,NTP,0,0,0,,Бұл оңай ма?
Dialogue: 0,0:20:00.54,0:20:01.33,Dialogue,,0,0,0,,Сіз өте ұятсыз!
Dialogue: 0,0:20:00.67,0:20:01.42,*Default-ja,NTP,0,0,0,,Ұят болды!
Dialogue: 0,0:20:01.33,0:20:03.14,Dialogue,,0,0,0,,Ой, бұл не деген ретро тіркес.
Dialogue: 0,0:20:01.50,0:20:03.06,*Default-ja,NTP,0,0,0,,Ретро сызықтар
Dialogue: 0,0:20:03.14,0:20:05.19,Dialogue,,0,0,0,,«Арсыз» деген не?
Dialogue: 0,0:20:03.15,0:20:04.65,*Default-ja,NTP,0,0,0,,«Шара» дегеніміз не?
Dialogue: 0,0:20:12.73,0:20:14.90,Dialogue,,0,0,0,,Бұл-Басы жоқ нәрсе!
Dialogue: 0,0:20:12.93,0:20:14.23,*Default-ja,NTP,0,0,0,,Ку... Басы жоқ!
Dialogue: 0,0:20:15.19,0:20:18.17,Dialogue,,0,0,0,,Бірақ біз түкке тұрғысыз кәрі жігітті алуды көздедік!
Dialogue: 0,0:20:15.25,0:20:17.55,*Default-ja,NTP,0,0,0,,Мен оған жеңілдік жасауға дайын едім!
Dialogue: 0,0:20:20.25,0:20:22.15,Dialogue,,0,0,0,,Біз енді мұны істемейміз! Біз енді мұны істемейміз!
Dialogue: 0,0:20:20.39,0:20:22.27,*Default-ja,NTP,0,0,0,,Мен енді мұны істемеймін, енді істемеймін!
Dialogue: 0,0:20:22.97,0:20:24.24,Dialogue,,0,0,0,,Жер
Dialogue: 0,0:20:23.26,0:20:24.23,*Default-ja,NTP,0,0,0,,Не?
Dialogue: 0,0:20:24.68,0:20:25.87,Dialogue,,0,0,0,,Казтано!
Dialogue: 0,0:20:24.88,0:20:25.73,*Default-ja,NTP,0,0,0,,Казутано!
Dialogue: 0,0:20:26.49,0:20:27.62,Dialogue,,0,0,0,,Дотакчино!
Dialogue: 0,0:20:26.67,0:20:27.57,*Default-ja,NTP,0,0,0,,Dotacino!
Dialogue: 0,0:20:27.62,0:20:28.91,Dialogue,,0,0,0,,Олар қашып барады!
Dialogue: 0,0:20:28.03,0:20:29.14,*Default-ja,NTP,0,0,0,,Ол Дзётаромен бірге.
Dialogue: 0,0:20:39.50,0:20:43.26,Dialogue,,0,0,0,,Қашып кетем деп ойламаңыз! иә!
Dialogue: 0,0:20:39.79,0:20:42.12,*Default-ja,NTP,0,0,0,,Қашып кетем деп ойламаңыз!
Dialogue: 0,0:20:43.26,0:20:45.05,Dialogue,,0,0,0,,Мен оңға бұрыламын!
Dialogue: 0,0:20:43.28,0:20:44.74,*Default-ja,NTP,0,0,0,,Оңға бұрылыңыз!
Dialogue: 0,0:20:56.74,0:20:58.65,Thought,,0,0,0,,Үйге бара аламын ба?
Dialogue: 0,0:20:56.88,0:20:58.20,*Default-ja,NTP,0,0,0,,Үйге бара аламын ба?
Dialogue: 0,0:20:59.94,0:21:04.45,Dialogue,,0,0,0,,Сіз оны қайда тапсыратыныңызды бізге қазір айтуыңыз керек.
Dialogue: 0,0:21:00.30,0:21:03.08,*Default-ja,NTP,0,0,0,,Енді өнімдеріңізді қайда жеткізесіз?
Dialogue: 0,0:21:03.15,0:21:04.62,*Default-ja,NTP,0,0,0,,Қазір құсқаныңыз жөн.
Dialogue: 0,0:21:05.10,0:21:09.57,Dialogue,,0,0,0,,Жоқ, бұл азаптаусыз қызықсыз болады, солай ма?
Dialogue: 0,0:21:05.21,0:21:09.13,*Default-ja,NTP,0,0,0,,Жоқ, жоқ, жоқ, егер сізді қинамай құстыратын болса, қызықсыз болмай ма?
Dialogue: 0,0:21:09.42,0:21:12.09,*Default-ja,NTP,0,0,0,,Бір кітапты таңдаңыз.
Dialogue: 0,0:21:09.57,0:21:11.91,Dialogue,,0,0,0,,Кітапты таңдаңыз.
Dialogue: 0,0:21:11.91,0:21:14.29,Dialogue,,0,0,0,,Біз азаптау әдісімізді сіз таңдаған кітаптың мазмұнына негіздейміз.
Dialogue: 0,0:21:12.16,0:21:14.64,*Default-ja,NTP,0,0,0,,Кітаптың мазмұнына негізделгендіктен, бұл азаптау.
Dialogue: 0,0:21:15.79,0:21:20.83,Dialogue,,0,0,0,,Енді мен сіздердің не істеріңізге батылдық танытпаймын, тек машинаның ішінде бензинді қайта қолданбасаңыздар.
Dialogue: 0,0:21:16.00,0:21:17.05,*Default-ja,NTP,0,0,0,,Келесі шайқас!
Dialogue: 0,0:21:17.22,0:21:20.63,*Default-ja,NTP,0,0,0,,Не қаласаңыз да, кешегідей көлігіңізде бензин қолданбаңыз.
Dialogue: 0,0:21:20.83,0:21:22.13,Dialogue,,0,0,0,,Бензин?!
Dialogue: 0,0:21:20.93,0:21:21.52,*Default-ja,NTP,0,0,0,,Газо...
Dialogue: 0,0:21:21.06,0:21:24.88,Secondary,,0,0,0,,Тогуссано, таңғы салттық уақыт!
Dialogue: 0,0:21:21.54,0:21:24.09,*Default-ja,NTP,0,0,0,,Токсано! Таңертеңгілік ырым жасаңыз!
Dialogue: 0,0:21:31.57,0:21:35.14,Dialogue,,0,0,0,,Жарайды, айтамын, айтамын!
Dialogue: 0,0:21:31.68,0:21:34.68,*Default-ja,NTP,0,0,0,,Айт! Мен айтамын! Айтуға рұқсат етіңізші!
Dialogue: 0,0:21:41.26,0:21:43.52,Dialogue,,0,0,0,,Yagiri Pharmaceuticals, иә?
Dialogue: 0,0:21:41.62,0:21:43.44,*Default-ja,NTP,0,0,0,,«Ягири фармацевтика»
Dialogue: 0,0:21:43.52,0:21:45.76,Dialogue,,0,0,0,,Қандай әсем жер.
Dialogue: 0,0:21:43.82,0:21:45.73,*Default-ja,NTP,0,0,0,,Қандай керемет жер.
Dialogue: 0,0:21:45.76,0:21:47.36,Dialogue,,0,0,0,,Бұл шынымен солай ма?
Dialogue: 0,0:21:45.84,0:21:49.37,*Default-ja,NTP,0,0,0,,Бұл шынымен де осында ма? Сіз адамдарға эксперимент жасайсыз ба?
Dialogue: 0,0:21:47.36,0:21:50.31,Dialogue,,0,0,0,,Олар мұнда адамдарға тәжірибе жасап жатыр.
Dialogue: 0,0:21:50.31,0:21:52.83,Dialogue,,0,0,0,,Біз бұған жартылай күмәндандық.
Dialogue: 0,0:21:50.51,0:21:52.47,*Default-ja,NTP,0,0,0,,Біз күмәндандық.
Dialogue: 0,0:21:52.83,0:21:55.41,Dialogue,,0,0,0,,Тым болмаса, сырттан білгенімізше...
Dialogue: 0,0:21:52.96,0:21:55.55,*Default-ja,NTP,0,0,0,,Ең болмағанда кестеден...
Dialogue: 0,0:21:55.85,0:21:59.98,Dialogue,,0,0,0,,Дегенмен, әдетте әр нәрсенің сыртқы және ішкі астары болады.
Dialogue: 0,0:21:56.04,0:21:59.67,*Default-ja,NTP,0,0,0,,Бірақ көп нәрсенің екі жағы болады.
Dialogue: 0,0:21:59.98,0:22:05.42,Dialogue,,0,0,0,,Икебукурода астарында зұлымдық бар таулар бар.
Dialogue: 0,0:22:00.07,0:22:02.22,*Default-ja,NTP,0,0,0,,Әсіресе осы Икебукуро қаласында.
Dialogue: 0,0:22:02.33,0:22:05.19,*Default-ja,NTP,0,0,0,,Сіз тіпті елестете де алмайтын көптеген жасырын құпиялар бар.
Dialogue: 0,0:22:06.59,0:22:09.15,Dialogue,,0,0,0,,Жарайды, тамақ алуға барамыз ба?
Dialogue: 0,0:22:06.83,0:22:09.02,*Default-ja,NTP,0,0,0,,Енді бір жерге барып тамақтанайық.
Dialogue: 0,0:22:09.15,0:22:10.14,Dialogue,,0,0,0,,Жақсы естіледі!
Dialogue: 0,0:22:09.19,0:22:10.26,*Default-ja,NTP,0,0,0,,Дұрыс!
Dialogue: 0,0:22:10.14,0:22:12.07,Dialogue,,0,0,0,,Таңертеңгілік ресейлік сушиде болғанын қалаймын!
Dialogue: 0,0:22:10.34,0:22:12.15,*Default-ja,NTP,0,0,0,,«Ресей сушиінің» Асадасы Кеттік!
Dialogue: 0,0:22:12.07,0:22:13.56,Dialogue,,0,0,0,,Мен үшін жеткілікті. Барайық!
Dialogue: 0,0:22:12.27,0:22:13.85,*Default-ja,NTP,0,0,0,,Лайк, кеттік, кеттік!
Dialogue: 0,0:22:13.86,0:22:15.68,Dialogue,,0,0,0,,Жарайды, шешілді!
Dialogue: 0,0:22:13.91,0:22:15.30,*Default-ja,NTP,0,0,0,,Жарайды, шешілді!
Dialogue: 0,0:22:16.34,0:22:20.19,Dialogue,,0,0,0,,Сіз қанша ақшаны қаласаңыз, сонша пайдалана аласыз.
Dialogue: 0,0:22:16.62,0:22:20.23,*Default-ja,NTP,0,0,0,,Қалағаныңызша ақша жұмсай аласыз.
Dialogue: 0,0:22:20.19,0:22:22.36,Dialogue,,0,0,0,,Рахмет, әпке.
Dialogue: 0,0:22:20.43,0:22:22.25,*Default-ja,NTP,0,0,0,,Рахмет, әпке
Dialogue: 0,0:22:22.36,0:22:25.57,Dialogue,,0,0,0,,Кездескенше, Сейджи.
Dialogue: 0,0:22:22.76,0:22:24.50,*Default-ja,NTP,0,0,0,,Кездескенше, Сейджи
Dialogue: 0,0:22:28.23,0:22:29.98,Dialogue,,0,0,0,,Вент одан әрі ашылмауына қол жеткіздік.
Dialogue: 0,0:22:28.52,0:22:29.43,*Default-ja,NTP,0,0,0,,Кеттік
Dialogue: 0,0:22:34.91,0:22:38.75,Dialogue,,0,0,0,,Бұл Қазтано оқиғасының оқиғасы.
Dialogue: 0,0:22:35.35,0:22:38.45,*Default-ja,NTP,0,0,0,,Мұны әлем Казутано оқиғасы деп атайды.
Dialogue: 0,0:22:38.75,0:22:45.80,Dialogue,,0,0,0,,Қалай болғанда да, досымызды аман-есен қайтарғанымызға қуаныштымыз.
Dialogue: 0,0:22:38.92,0:22:42.79,*Default-ja,NTP,0,0,0,,Міне, бүгін достарым аман-есен оралды.
Dialogue: 0,0:22:43.11,0:22:44.80,*Default-ja,NTP,0,0,0,,Біз бақыттымыз
Dialogue: 0,0:24:15.10,0:24:19.72,staff,NTP,0,0,0,,Өндіріс: LASTZZZ Демалыс бұлт акира Акира
Dialogue: 0,0:24:15.16,0:24:16.25,Dialogue,,0,0,0,,Қандай тітіркендіргіш!
Dialogue: 0,0:24:15.46,0:24:17.94,*Default-ja,NTP,0,0,0,,Шулы, тітіркендіргіш, жиіркенішті
Dialogue: 0,0:24:16.25,0:24:17.02,Dialogue,,0,0,0,,Қандай азап!
Dialogue: 0,0:24:17.02,0:24:17.81,Dialogue,,0,0,0,,Қандай жиіркенішті!
Dialogue: 0,0:24:18.09,0:24:21.23,Dialogue,,0,0,0,,Менің денем өз бетімен қозғалады, егер мен оны бақылай алмасам.
Dialogue: 0,0:24:18.22,0:24:19.70,*Default-ja,NTP,0,0,0,,Мен ашуымды ұстай алмаймын
Dialogue: 0,0:24:19.76,0:24:21.33,*Default-ja,NTP,0,0,0,,Менің денем өздігінен қозғалады
Dialogue: 0,0:24:19.88,0:24:24.87,staff,NTP,0,0,0,,Manyu субтитрлер жұбы http://popgo.net/bbs/
Dialogue: 0,0:24:21.23,0:24:23.73,Dialogue,,0,0,0,,Маған не болатыны маңызды емес.
Dialogue: 0,0:24:21.59,0:24:23.84,*Default-ja,NTP,0,0,0,,Маған не болғаны бәрібір
Dialogue: 0,0:24:23.73,0:24:26.27,Dialogue,,0,0,0,,Келесі жолы: Жердегі ең жақсы.
Dialogue: 0,0:24:26.27,0:24:29.51,Dialogue,,0,0,0,,Сондықтан мен зорлықты жек көремін!
Dialogue: 0,0:24:26.47,0:24:28.88,*Default-ja,NTP,0,0,0,,Бірақ мен зорлық-зомбылықты жек көремін!!
Dialogue: 0,0:24:31.01,0:24:37.01,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory