Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:00.74,0:01:02.23,Dialogue,,0,0,0,,Масами қайда кетті?
Dialogue: 0,0:01:00.84,0:01:02.36,*Default-ja,NTP,0,0,0,,Масаоми қайда орналасқан?
Dialogue: 0,0:01:02.23,0:01:05.38,Dialogue,,0,0,0,,Ол алға шықты. Ол бірдеңе жасайтынын айтты.
Dialogue: 0,0:01:02.36,0:01:03.88,*Default-ja,NTP,0,0,0,,Мен жаңа ғана оралдым
Dialogue: 0,0:01:03.90,0:01:05.52,*Default-ja,NTP,0,0,0,,Менің бірдеңе істеуім керек...
Dialogue: 0,0:01:05.38,0:01:08.99,Dialogue,,0,0,0,,Жалын жоғарылаған сайын —
Dialogue: 0,0:01:05.57,0:01:09.02,*Default-ja,NTP,0,0,0,,Біраз қалдырсаң, ұшқын сөніп қалады...
Dialogue: 0,0:01:08.99,0:01:11.92,Dialogue,,0,0,0,,Біз аяқталды, аяқталды!
Dialogue: 0,0:01:09.24,0:01:11.95,*Default-ja,NTP,0,0,0,,Біз дайынбыз, мәре
Dialogue: 0,0:01:11.92,0:01:14.58,Dialogue,,0,0,0,,Сіз тек дұрыс деп санаған нәрсені жасадыңыз, солай емес пе?
Dialogue: 0,0:01:12.07,0:01:14.82,*Default-ja,NTP,0,0,0,,Сіз дұрыс деп ойлаған нәрсені істедіңіз бе?
Dialogue: 0,0:01:14.58,0:01:18.12,Dialogue,,0,0,0,,Бұл долларлар көшбасшысынан алынған, солай емес пе?
Dialogue: 0,0:01:14.89,0:01:18.13,*Default-ja,NTP,0,0,0,,Бұл доллардың көшбасшысы ма?
Dialogue: 0,0:01:18.12,0:01:22.33,Dialogue,,0,0,0,,Ал егер мұның артында доллар тұрса, онда... біз долларды талқандаймыз.
Dialogue: 0,0:01:18.29,0:01:21.17,*Default-ja,NTP,0,0,0,,Егер доллар фонда болса, онда
Dialogue: 0,0:01:21.23,0:01:22.52,*Default-ja,NTP,0,0,0,,Долларды қиратыңыз!
Dialogue: 0,0:01:58.61,0:01:59.38,Dialogue,,0,0,0,,Осы жолмен!
Dialogue: 0,0:01:58.95,0:01:59.71,*Default-ja,NTP,0,0,0,,Мына жерде!
Dialogue: 0,0:02:02.82,0:02:06.09,Dialogue,,0,0,0,,Сен сол жолмен жүр! Кіруді жауып тастаңыз!
Dialogue: 0,0:02:03.20,0:02:04.21,*Default-ja,NTP,0,0,0,,Балалар, мына жерде екенсіңдер.
Dialogue: 0,0:02:04.50,0:02:05.63,*Default-ja,NTP,0,0,0,,Кіруді жауып тастаңыз!
Dialogue: 0,0:02:07.29,0:02:08.09,Thought,,0,0,0,,Неліктен...?
Dialogue: 0,0:02:07.38,0:02:10.41,*Default-ja,NTP,0,0,0,,Неге... Кида-кун неге...
Dialogue: 0,0:02:08.75,0:02:10.67,Thought,,0,0,0,,Неліктен Кида...?
Dialogue: 0,0:02:12.72,0:02:14.56,Thought,,0,0,0,,Қыз жүгірді...
Dialogue: 0,0:02:12.97,0:02:14.01,*Default-ja,NTP,0,0,0,,Қыз жүгіреді
Dialogue: 0,0:02:14.56,0:02:17.23,Thought,,0,0,0,,...оны қуып келе жатқан көлеңкеден құтылу үшін.
Dialogue: 0,0:02:14.81,0:02:17.17,*Default-ja,NTP,0,0,0,,Тек қуып бара жатқан көлеңкеден құтылу үшін
Dialogue: 0,0:02:17.99,0:02:20.49,Thought,,0,0,0,,Ол жай ғана білгісі келді...
Dialogue: 0,0:02:18.14,0:02:21.77,*Default-ja,NTP,0,0,0,,Ол жай ғана шындықты білгісі келді.
Dialogue: 0,0:02:20.49,0:02:22.20,Thought,,0,0,0,,...шындық.
Dialogue: 0,0:02:34.07,0:02:36.33,Dialogue,,0,0,0,,Қандай азап.
Dialogue: 0,0:02:34.48,0:02:36.46,*Default-ja,NTP,0,0,0,,Бұл өте қиын.
Dialogue: 0,0:02:38.33,0:02:40.09,Dialogue,,0,0,0,,Мынау қайда кетті?
Dialogue: 0,0:02:38.88,0:02:39.99,*Default-ja,NTP,0,0,0,,Сен қайда бардың?
Dialogue: 0,0:02:40.09,0:02:41.67,Dialogue,,0,0,0,,Біз оның қашып кетуіне жол бермейміз.
Dialogue: 0,0:02:40.24,0:02:41.56,*Default-ja,NTP,0,0,0,,Сіз қашып құтыла алмайсыз
Dialogue: 0,0:02:41.67,0:02:43.21,Thought,,0,0,0,,Неліктен Кида...?
Dialogue: 0,0:02:41.77,0:02:43.24,*Default-ja,NTP,0,0,0,,Неліктен Кида...
Dialogue: 0,0:02:43.21,0:02:44.98,Thought,,0,0,0,,Ол басқа ештеңе сезе алмады.
Dialogue: 0,0:02:43.77,0:02:45.19,*Default-ja,NTP,0,0,0,,Мен ештеңе сезе алмаймын
Dialogue: 0,0:02:44.98,0:02:46.33,Thought,,0,0,0,,Неліктен...?
Dialogue: 0,0:02:46.33,0:02:51.09,Thought,,0,0,0,,Оның жаңа ғана көргенінен дірілдегені оның бүкіл денесінде резонанс тудырды.
Dialogue: 0,0:02:46.53,0:02:51.27,*Default-ja,NTP,0,0,0,,Көргенімнің дүбірі ғана жүрегімде жаңғырды.
Dialogue: 0,0:02:58.74,0:03:02.20,Dialogue,,0,0,0,,Сіз күткеннен тезірек босатылғаныңызға қуанышты болуыңыз керек.
Dialogue: 0,0:02:59.10,0:03:02.29,*Default-ja,NTP,0,0,0,,Мен ауруханадан күткеннен ерте шыққаныма қуаныштымын.
Dialogue: 0,0:03:02.20,0:03:04.19,Dialogue,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:03:02.42,0:03:05.97,*Default-ja,NTP,0,0,0,,Көмегің үшін көп рахмет.
Dialogue: 0,0:03:04.19,0:03:05.86,Dialogue,,0,0,0,,Мен сенің мен үшін істеген істеріңді өте бағалаймын.
Dialogue: 0,0:03:20.26,0:03:21.38,Dialogue,,0,0,0,,Жер
Dialogue: 0,0:03:20.63,0:03:21.47,*Default-ja,NTP,0,0,0,,Иә
Dialogue: 0,0:03:21.38,0:03:23.02,Dialogue,,0,0,0,,Хиёри, қош келдің.
Dialogue: 0,0:03:21.78,0:03:22.68,*Default-ja,NTP,0,0,0,,Рахмет
Dialogue: 0,0:03:25.43,0:03:31.43,Thought,,0,0,0,,Slasher оқиғалары сол түннен кейін кенеттен тоқтап, қала тыныштығы қалпына келтірілді.
Dialogue: 0,0:03:25.76,0:03:28.44,*Default-ja,NTP,0,0,0,,Slasher оқиғасы сол түннен бері кенет тоқтады.
Dialogue: 0,0:03:28.79,0:03:30.74,*Default-ja,NTP,0,0,0,,Қала тыныштық орнады.
Dialogue: 0,0:03:31.43,0:03:36.65,Thought,,0,0,0,,Сонохара Анридің біркелкі емес күнделікті өмірі оған да қайта оралуы керек еді.
Dialogue: 0,0:03:31.95,0:03:36.71,*Default-ja,NTP,0,0,0,,Анри Сонохара үшін оның қалыпты өмірі қайта оралуы керек еді.
Dialogue: 0,0:03:39.24,0:03:40.64,Dialogue,,0,0,0,,Сонохара!
Dialogue: 0,0:03:39.43,0:03:40.75,*Default-ja,NTP,0,0,0,,Сонохара-сан!
Dialogue: 0,0:03:41.65,0:03:44.26,Dialogue,,0,0,0,,Керемет! Мен оны уақытында жасадым!
Dialogue: 0,0:03:42.06,0:03:44.11,*Default-ja,NTP,0,0,0,,Жақсы, мен оны уақытында жасадым.
Dialogue: 0,0:03:44.26,0:03:46.53,Dialogue,,0,0,0,,Мені сыныптық комиссия ұстады...
Dialogue: 0,0:03:44.70,0:03:46.49,*Default-ja,NTP,0,0,0,,Мен комитет отырысына кешігіп қалдым.
Dialogue: 0,0:03:46.53,0:03:48.06,Dialogue,,0,0,0,,Рюгамин...
Dialogue: 0,0:03:46.77,0:03:48.06,*Default-ja,NTP,0,0,0,,Рюгамин-кун
Dialogue: 0,0:03:48.06,0:03:51.65,Dialogue,,0,0,0,,Мен сенің ертең мектепке қайта баратыныңды естідім, сонда жақсысың ба?
Dialogue: 0,0:03:48.26,0:03:51.80,*Default-ja,NTP,0,0,0,,Ертеңнен бастап мектепке барасың деп естідім, жарай ма?
Dialogue: 0,0:03:51.65,0:03:53.97,Dialogue,,0,0,0,,Иә, менде қазір бәрі жақсы.
Dialogue: 0,0:03:51.86,0:03:53.66,*Default-ja,NTP,0,0,0,,Иә, мен қазір жақсымын.
Dialogue: 0,0:03:53.97,0:03:56.18,Dialogue,,0,0,0,,Әй, мен сөмкелеріңді аламын.
Dialogue: 0,0:03:54.28,0:03:55.98,*Default-ja,NTP,0,0,0,,А, мен жүктерімді алып кетейін.
Dialogue: 0,0:03:56.18,0:03:58.89,Dialogue,,0,0,0,,Н-Жоқ...менде бәрі жақсы...
Dialogue: 0,0:03:56.50,0:03:58.83,*Default-ja,NTP,0,0,0,,А, жоқ, бәрі жақсы.
Dialogue: 0,0:03:58.89,0:04:00.42,Dialogue,,0,0,0,,Оларды алсын!
Dialogue: 0,0:03:59.11,0:04:00.63,*Default-ja,NTP,0,0,0,,Оны ұстамаңыз!
Dialogue: 0,0:04:00.42,0:04:04.54,Dialogue,,0,0,0,,Микадо сол сөмкелерді саған ұстату үшін жүрегін шымырлатты.
Dialogue: 0,0:04:00.84,0:04:04.72,*Default-ja,NTP,0,0,0,,Микадо оны алғысы келгендіктен, ол үшін ессіз сызық жасады.
Dialogue: 0,0:04:04.54,0:04:08.59,Dialogue,,0,0,0,,Анри, қалай ойлайсың, мен бүгін оны қаншалықты тыңдауым керек болды?
Dialogue: 0,0:04:04.93,0:04:08.34,*Default-ja,NTP,0,0,0,,Анри бүгін таңертең ол маған не деді деп ойлайсың?
Dialogue: 0,0:04:08.59,0:04:11.01,Dialogue,,0,0,0,,"Сонохара бүгін шығарылады!"
Dialogue: 0,0:04:08.77,0:04:11.05,*Default-ja,NTP,0,0,0,,«Сонохара мырза, сізді бүгін ауруханадан шығарып жатырсыз!»
Dialogue: 0,0:04:11.01,0:04:13.30,Dialogue,,0,0,0,,«Ол ертең сабаққа келе ала ма?».
Dialogue: 0,0:04:11.07,0:04:13.30,*Default-ja,NTP,0,0,0,,«Ертең мектепке барған дұрыс па?»
Dialogue: 0,0:04:13.30,0:04:14.98,Dialogue,,0,0,0,,«Анри сондай эротикалық сүйкімді».
Dialogue: 0,0:04:13.37,0:04:15.20,*Default-ja,NTP,0,0,0,,«Анри эротикалық сүйкімді, солай емес пе?»
Dialogue: 0,0:04:14.98,0:04:16.18,Dialogue,,0,0,0,,Мен бұл соңғы бөлімді айтқан жоқпын!
Dialogue: 0,0:04:15.21,0:04:16.49,*Default-ja,NTP,0,0,0,,Соңғысын айтқан жоқпын!
Dialogue: 0,0:04:16.18,0:04:22.05,Dialogue,,0,0,0,,Ум... маған жиі келгеніңіз үшін рахмет, Кида мен Рюгамин.
Dialogue: 0,0:04:16.69,0:04:22.38,*Default-ja,NTP,0,0,0,,Мм... Рюгамин-кун мен Кида-кун, бізге көп рет келгеніңіз үшін рахмет.
Dialogue: 0,0:04:22.48,0:04:24.55,Dialogue,,0,0,0,,Бұл үлкен мәселе емес...
Dialogue: 0,0:04:22.65,0:04:24.53,*Default-ja,NTP,0,0,0,,барлығына өзімді дәлелдеуім керек сияқты.
Dialogue: 0,0:04:24.55,0:04:28.14,Dialogue,,0,0,0,,Айтпақшы, Масаоми, сен ауруханадан жаңа шықтың ғой, солай ма?
Dialogue: 0,0:04:24.76,0:04:28.15,*Default-ja,NTP,0,0,0,,Айтпақшы, Масаоми, сен ауруханадан жаңа шықтың ғой, солай ма?
Dialogue: 0,0:04:28.14,0:04:29.82,Dialogue,,0,0,0,,А, иә...
Dialogue: 0,0:04:28.35,0:04:29.64,*Default-ja,NTP,0,0,0,,Ах, оо
Dialogue: 0,0:04:29.82,0:04:31.48,Dialogue,,0,0,0,,Мен оны ішке бара жатқанда сағындым.
Dialogue: 0,0:04:30.05,0:04:31.64,*Default-ja,NTP,0,0,0,,Мен оны дұрыс емес жерге қойдым.
Dialogue: 0,0:04:31.48,0:04:32.45,Dialogue,,0,0,0,,Хмм.
Dialogue: 0,0:04:32.45,0:04:34.45,Dialogue,,0,0,0,,Иә, Сонохара.
Dialogue: 0,0:04:33.07,0:04:33.88,*Default-ja,NTP,0,0,0,,Иә.
Dialogue: 0,0:04:33.90,0:04:37.00,*Default-ja,NTP,0,0,0,,Сонохара мырза: Үзіліс кезіндегі сабақтардан жазбалар
Dialogue: 0,0:04:34.45,0:04:36.99,Dialogue,,0,0,0,,Міне, сіз болмаған уақыттағы жазбаларым.
Dialogue: 0,0:04:36.99,0:04:39.75,Dialogue,,0,0,0,,Егер мендікін пайдалануға рұқсат етсеңіз, мен сізге оларды қарызға алуға рұқсат етемін.
Dialogue: 0,0:04:37.39,0:04:39.36,*Default-ja,NTP,0,0,0,,Қарсы болмасаң, қарызға беремін.
Dialogue: 0,0:04:39.75,0:04:43.69,Dialogue,,0,0,0,,Менің қолжазбам өте нашар, сондықтан оларды оқу қиын болуы мүмкін, бірақ...
Dialogue: 0,0:04:40.65,0:04:43.74,*Default-ja,NTP,0,0,0,,Қолжазба лас және оқу қиын болуы мүмкін, бірақ
Dialogue: 0,0:04:43.69,0:04:45.76,Dialogue,,0,0,0,,Егер бұл жақсы болса, оларды қолдануға болады.
Dialogue: 0,0:04:43.89,0:04:45.62,*Default-ja,NTP,0,0,0,,Қарсы болмасаңыз, пайдаланыңыз.
Dialogue: 0,0:04:45.76,0:04:47.09,Dialogue,,0,0,0,,О, бір секунд.
Dialogue: 0,0:04:45.98,0:04:50.16,*Default-ja,NTP,0,0,0,,Бір минут күтіңіз...
Dialogue: 0,0:04:47.09,0:04:50.04,Dialogue,,0,0,0,,Мен мұны бүгін әкелгенімді білемін...
Dialogue: 0,0:04:50.04,0:04:53.38,Thought,,0,0,0,,Кида... әйтеуір басқаша көрінеді.
Dialogue: 0,0:04:50.59,0:04:53.97,*Default-ja,NTP,0,0,0,,Кида-кунның бір ерекшелігі бар...
Dialogue: 0,0:04:53.98,0:04:57.89,Thought,,0,0,0,,Ол өзін ыңғайсыз сезінді...
Dialogue: 0,0:04:54.19,0:04:58.33,*Default-ja,NTP,0,0,0,,Қыз балаға түсініксіз жайсыздық сезімін сезінді.
Dialogue: 0,0:04:58.65,0:05:02.01,Thought,,0,0,0,,Ол оны алғаш рет ауруханаға барғаннан бері.
Dialogue: 0,0:04:58.81,0:05:01.91,*Default-ja,NTP,0,0,0,,Бала аурухана бөлмесіне алғаш барған кезден бастап
Dialogue: 0,0:05:03.13,0:05:05.05,Dialogue,,0,0,0,,Онда. Мұны істеу керек.
Dialogue: 0,0:05:03.42,0:05:05.13,*Default-ja,NTP,0,0,0,,Иә, бұл жақсы.
Dialogue: 0,0:05:09.15,0:05:10.35,Dialogue,,0,0,0,,Кида...?
Dialogue: 0,0:05:09.50,0:05:10.75,*Default-ja,NTP,0,0,0,,Кида-кун?
Dialogue: 0,0:05:13.24,0:05:14.52,Dialogue,,0,0,0,,Анри...
Dialogue: 0,0:05:13.51,0:05:16.77,*Default-ja,NTP,0,0,0,,Анри: Неге...
Dialogue: 0,0:05:14.52,0:05:16.36,Dialogue,,0,0,0,,Не болды?
Dialogue: 0,0:05:17.36,0:05:20.33,Dialogue,,0,0,0,,Ештеңе емес, шынымен.
Dialogue: 0,0:05:17.55,0:05:20.06,*Default-ja,NTP,0,0,0,,Мм... бұл маңызды емес.
Dialogue: 0,0:05:20.33,0:05:22.02,Dialogue,,0,0,0,,Slasher түрі...
Dialogue: 0,0:05:20.46,0:05:22.25,*Default-ja,NTP,0,0,0,,Кішкене жын-шайтан сияқты... енді!
Dialogue: 0,0:05:25.70,0:05:29.44,Dialogue,,0,0,0,,О, бірақ бұл мүлдем ештеңе емес.
Dialogue: 0,0:05:26.52,0:05:29.64,*Default-ja,NTP,0,0,0,,Бірақ шын мәнінде бұл үлкен мәселе емес.
Dialogue: 0,0:05:39.77,0:05:42.64,Dialogue,,0,0,0,,Кешіріңіз, бірдеңе шықты.
Dialogue: 0,0:05:40.00,0:05:42.45,*Default-ja,NTP,0,0,0,,Кешіріңіз, бұл Yabo үшін жасалды.
Dialogue: 0,0:05:42.64,0:05:46.90,Dialogue,,0,0,0,,Менің ойымша, мен ханзада Микадоға ханшайымды үйге қайтару құрметін орындауға рұқсат беруім керек.
Dialogue: 0,0:05:42.84,0:05:46.95,*Default-ja,NTP,0,0,0,,Ханшайымды үйіне жіберу рөлін Микадо ханзадаға тапсырайық.
Dialogue: 0,0:05:46.90,0:05:49.95,Dialogue,,0,0,0,,Сізге жүз жыл бойы мұндай мүмкіндік болмайды!
Dialogue: 0,0:05:47.30,0:05:49.97,*Default-ja,NTP,0,0,0,,Алдағы 100 жылда мүмкіндік болмайды деп ойлаймын.
Dialogue: 0,0:05:49.95,0:05:51.33,Dialogue,,0,0,0,,Кездескенше.
Dialogue: 0,0:05:50.16,0:05:51.19,*Default-ja,NTP,0,0,0,,Сонда кездескенше
Dialogue: 0,0:05:51.33,0:05:53.07,Dialogue,,0,0,0,,Ой... Ертең кездескенше!
Dialogue: 0,0:05:52.38,0:05:53.43,*Default-ja,NTP,0,0,0,,Ертең кездескенше!
Dialogue: 0,0:05:54.63,0:05:58.86,Thought,,0,0,0,,Осылайша, белгісіз бір сенімсіздік сезімі оны орап алды.
Dialogue: 0,0:05:54.90,0:05:58.77,*Default-ja,NTP,0,0,0,,Сосын оны жұмбақ алаңдаушылық биледі.
Dialogue: 0,0:05:59.42,0:06:02.46,Dialogue,,0,0,0,,Мен жеткенше ештеңе істеме!
Dialogue: 0,0:05:59.67,0:06:03.72,*Default-ja,NTP,0,0,0,,Мен бармайынша, олардың қалағанын істеуіне жол берме. Тамаша!
Dialogue: 0,0:06:02.46,0:06:03.41,Dialogue,,0,0,0,,Түсінді ме?
Dialogue: 0,0:06:06.92,0:06:10.77,Chat,,0,0,0,,Соңғы уақытта «Сары орамалдарға» көп адам қосылды, иә?
Dialogue: 0,0:06:07.25,0:06:10.91,*Default-ja,NTP,0,0,0,,Соңғы кезде сары тақиялы қарақшылар көбейіп кетті.
Dialogue: 0,0:06:11.91,0:06:13.67,Chat,,0,0,0,,Бұл өте дұрыс.
Dialogue: 0,0:06:13.67,0:06:17.63,Chat,,0,0,0,,Олар долларға қарағанда әлдеқайда ерекшеленеді, өйткені олардың кім екенін білуге ​​болады.
Dialogue: 0,0:06:17.63,0:06:20.14,Chat,,0,0,0,,Бұл банда біраз уақыттан бері болды,
Dialogue: 0,0:06:20.14,0:06:22.52,Chat,,0,0,0,,бірақ олар қандай да бір жолмен өзгерген сияқты.
Dialogue: 0,0:06:22.99,0:06:24.26,Chat,,0,0,0,,Олар өзгерді ме?
Dialogue: 0,0:06:24.26,0:06:26.23,Chat,,0,0,0,,Мен оған саусағымды қоя алмаймын,
Dialogue: 0,0:06:26.23,0:06:29.27,Chat,,0,0,0,,бірақ олар бұрынғыдан басқаша...
Dialogue: 0,0:06:29.27,0:06:30.35,Chat,,0,0,0,,Әйтеуір...
Dialogue: 0,0:06:30.35,0:06:33.60,Chat,,0,0,0,,Мен олардың қатыгез болып кеткенін сеземін.
Dialogue: 0,0:06:34.82,0:06:35.95,Chat,,0,0,0,,Сайка сөйлесу бөлмесіне кірді.
Dialogue: 0,0:06:35.95,0:06:38.03,Chat,,0,0,0,,Сайка сөйлесу бөлмесіне кірді.
Dialogue: 0,0:06:35.95,0:06:38.03,Chat,,0,0,0,,Қайырлы кеш Сайка.
Dialogue: 0,0:06:38.03,0:06:38.95,Chat,,0,0,0,,Сайка сөйлесу бөлмесіне кірді.
Dialogue: 0,0:06:38.03,0:06:38.95,Chat,,0,0,0,,Қайырлы кеш.
Dialogue: 0,0:06:38.95,0:06:40.02,Chat,,0,0,0,,Қош келдіңіз.
Dialogue: 0,0:06:40.36,0:06:42.50,Chat,,0,0,0,,Қайырлы... кеш.
Dialogue: 0,0:06:42.50,0:06:44.37,Chat,,0,0,0,,Ум, кешіріңіз.
Dialogue: 0,0:06:44.37,0:06:46.54,Chat,,0,0,0,,Неге кешірім сұрайсыз?
Dialogue: 0,0:06:46.54,0:06:49.13,Chat,,0,0,0,,Сіз бұрын Интернетпен таныс емессіз,
Dialogue: 0,0:06:49.13,0:06:52.79,Chat,,0,0,0,,сондықтан сізде вирус болды және бәрі осылай болды, солай ма?
Dialogue: 0,0:06:52.79,0:06:54.66,Chat,,0,0,0,,Сіз бұған көмектесе алмайсыз.
Dialogue: 0,0:06:54.66,0:06:57.20,Chat,,0,0,0,,Кешіріңіз. Мен өте өкінемін.
Dialogue: 0,0:06:59.01,0:07:00.43,Chat,,0,0,0,,Сіз тым көп кешірім сұрайсыз.
Dialogue: 0,0:07:00.81,0:07:05.35,Chat,,0,0,0,,Айтпақшы, Сайка, сен сары орамалдар деп аталатын банданы білесің бе?
Dialogue: 0,0:07:00.98,0:07:02.57,*Default-ja,NTP,0,0,0,,Айтпақшы, Синка мырза
Dialogue: 0,0:07:02.92,0:07:05.62,*Default-ja,NTP,0,0,0,,Сары тақиялар – түсті банда. Түсінесіз бе?
Dialogue: 0,0:07:05.52,0:07:08.68,Chat,,0,0,0,,Қаланы айнала сары киім киіп жүргендерді айтасыз ба?
Dialogue: 0,0:07:08.68,0:07:10.60,Chat,,0,0,0,,Иә, олар.
Dialogue: 0,0:07:10.60,0:07:14.69,Chat,,0,0,0,,Сондай-ақ доллар деп аталатын оларға ұқсас басқа топ бар.
Dialogue: 0,0:07:14.69,0:07:19.16,Chat,,0,0,0,,Slasher оқиғаларына байланысты сол топтардың екеуі де...
Dialogue: 0,0:07:15.09,0:07:19.04,*Default-ja,NTP,0,0,0,,Жақында болған қырғын оқиғасына байланысты бұл екі ұйым...
Dialogue: 0,0:07:19.16,0:07:22.24,Chat,,0,0,0,,...дәл қазір өте қиын жағдайда.
Dialogue: 0,0:07:22.24,0:07:23.00,Chat,,0,0,0,,Олар дәл қашан осы үйдің бір бөлігіне айналды?
Dialogue: 0,0:07:23.66,0:07:25.66,Chat,,0,0,0,,Мұнымен нені айтасыз?
Dialogue: 0,0:07:27.20,0:07:29.37,Chat,,0,0,0,,Демалыңыз, Канра.
Dialogue: 0,0:07:29.37,0:07:32.75,Chat,,0,0,0,,Бұл туралы ештеңе білмейтін адамға бұл туралы айтпаңыз.
Dialogue: 0,0:07:32.75,0:07:33.97,Chat,,0,0,0,,Жоқ,
Dialogue: 0,0:07:33.97,0:07:36.54,Chat,,0,0,0,,егер сіз Икебукурада тұрсаңыз, бұл ақпаратты білуіңіз керек!
Dialogue: 0,0:07:36.99,0:07:42.06,Chat,,0,0,0,,Slasher ісіндегі қылмыскер әлі ұсталған жоқ, солай ма?
Dialogue: 0,0:07:37.19,0:07:38.79,*Default-ja,NTP,0,0,0,,Өткен күнгі қырғын оқиғасы
Dialogue: 0,0:07:39.34,0:07:41.82,*Default-ja,NTP,0,0,0,,Өйткені, қылмыскер ұсталған жоқ, солай ма?
Dialogue: 0,0:07:42.60,0:07:46.80,Chat,,0,0,0,,Қалай болғанда да, сары орамалдар да, долларлар да өз мүшелерін Slasher құрбанына айналдырды.
Dialogue: 0,0:07:42.78,0:07:46.94,*Default-ja,NTP,0,0,0,,-де сары тақиялардың да, долларлардың да құрбандары бар.
Dialogue: 0,0:07:46.80,0:07:51.56,Chat,,0,0,0,,Шамасы, екеуі де Слэшерді басқа бандамен тіл табысады деп ойласа керек.
Dialogue: 0,0:07:47.21,0:07:51.75,*Default-ja,NTP,0,0,0,,Екеуі екіншісін кінәлі деп ойлайтын сияқты.
Dialogue: 0,0:07:54.67,0:07:57.74,Chat,,0,0,0,,Доллар бұл идеяға онша құмар емес сияқты...
Dialogue: 0,0:07:54.82,0:07:58.10,*Default-ja,NTP,0,0,0,,Доллар соншалықты маңызды емес сияқты...
Dialogue: 0,0:07:58.23,0:08:02.23,Chat,,0,0,0,,Олар бір-бірін көп білмейді, сондықтан түсінбеушілік тудыратынына сенімдімін.
Dialogue: 0,0:08:02.76,0:08:11.62,Chat,,0,0,0,,Қалай болғанда да, егер олардың ешқайсысы Slasher-мен мәселені өз қолдарына алмаса, Икебукуроға қан жауады.
Dialogue: 0,0:08:02.87,0:08:07.80,*Default-ja,NTP,0,0,0,,Қалай болғанда да, Слейшердің нағыз кінәлісін екі қолмен линчке түсіру керек...
Dialogue: 0,0:08:08.22,0:08:11.75,*Default-ja,NTP,0,0,0,,Бұлай жалғаса берсе, Икебукурада қан жауады.
Dialogue: 0,0:08:11.62,0:08:13.15,Chat,,0,0,0,,Бұл өте қорқынышты болады...
Dialogue: 0,0:08:13.15,0:08:14.92,Chat,,0,0,0,,Енді бұл нағыз бәсекелестік!
Dialogue: 0,0:08:20.69,0:08:23.17,Chat,,0,0,0,,Сенде уайымдайтын ештеңе жоқ, Анри.
Dialogue: 0,0:08:23.17,0:08:26.68,Chat,,0,0,0,,Бұл бандалар өз еркімен әуре-сарсаңға түсіп жатыр.
Dialogue: 0,0:08:26.68,0:08:30.82,Chat,,0,0,0,,Сіз нағыз қылмыскер емессіз, сондықтан алға шыққаныңыз немесе келмегеніңіз маңызды емес.
Dialogue: 0,0:08:30.82,0:08:32.57,Chat,,0,0,0,,Асықпаңыз.
Dialogue: 0,0:08:32.57,0:08:35.48,Chat,,0,0,0,,Полиция қазір өте қорқынышты.
Dialogue: 0,0:08:35.48,0:08:37.65,Chat,,0,0,0,,Олар шынымен де қорқынышты.
Dialogue: 0,0:08:35.87,0:08:37.18,*Default-ja,NTP,0,0,0,,Өйткені бұл өте қорқынышты...
Dialogue: 0,0:08:37.65,0:08:39.16,Chat,,0,0,0,,Олар шынымен!
Dialogue: 0,0:08:37.75,0:08:39.34,*Default-ja,NTP,0,0,0,,Бұл өте қорқынышты...
Dialogue: 0,0:08:39.35,0:08:40.40,Chat,,0,0,0,,Әсіресе жол сақшылары!
Dialogue: 0,0:08:43.03,0:08:45.41,Chat,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:08:48.04,0:08:50.61,Chat,,0,0,0,,Иә?! О, дұрыс...
Dialogue: 0,0:08:49.30,0:08:50.50,*Default-ja,NTP,0,0,0,,Мм... түсіндім.
Dialogue: 0,0:08:51.34,0:08:54.79,Chat,,0,0,0,,Мен сізге жеке әңгімелер туралы кейінірек үйретемін.
Dialogue: 0,0:08:56.00,0:08:58.76,Chat,,0,0,0,,Кешіріңіз, бұл мен үшін бүгін.
Dialogue: 0,0:08:58.76,0:08:59.87,Chat,,0,0,0,,О, жарайды.
Dialogue: 0,0:08:59.87,0:09:01.84,Chat,,0,0,0,,Кездескенше, Сайка.
Dialogue: 0,0:09:01.84,0:09:02.88,Chat,,0,0,0,,«Түн.
Dialogue: 0,0:09:02.88,0:09:03.39,Chat,,0,0,0,,Кездескенше.
Dialogue: 0,0:09:03.48,0:09:05.10,Chat,,0,0,0,,Сайка чат бөлмесінен шығып кетті.
Dialogue: 0,0:09:07.26,0:09:09.81,Chat,,0,0,0,,Жарайды, мен де жүйеден шығамын деп ойлаймын.
Dialogue: 0,0:09:09.81,0:09:10.72,Chat,,0,0,0,,Кейінірек кездескенше.
Dialogue: 0,0:09:10.72,0:09:12.73,Chat,,0,0,0,,Кездескенше.
Dialogue: 0,0:09:12.73,0:09:14.28,Chat,,0,0,0,,Сеттон сөйлесу бөлмесінен шықты.
Dialogue: 0,0:09:14.27,0:09:15.52,Chat,,0,0,0,,Канра...
Dialogue: 0,0:09:14.81,0:09:15.65,*Default-ja,NTP,0,0,0,,Канра мырза
Dialogue: 0,0:09:15.52,0:09:17.28,Chat,,0,0,0,,Slasher оқиғалары туралы...
Dialogue: 0,0:09:15.74,0:09:16.98,*Default-ja,NTP,0,0,0,,Слейшер мәселесі...
Dialogue: 0,0:09:17.70,0:09:19.90,Chat,,0,0,0,,Егер мен бірдеңе тапсам, сізге хабарлаймын.
Dialogue: 0,0:09:17.80,0:09:19.54,*Default-ja,NTP,0,0,0,,Егер сіз бірдеңе білсеңіз, маған хабарлаңыз
Dialogue: 0,0:09:19.90,0:09:21.28,Chat,,0,0,0,,Келісілген баға бойынша, яғни.
Dialogue: 0,0:09:20.13,0:09:21.27,*Default-ja,NTP,0,0,0,,Бұл арзан.
Dialogue: 0,0:09:21.54,0:09:24.29,Chat,,0,0,0,,Нағыз қылмыскер осы қаланың бір жерінде болуы керек.
Dialogue: 0,0:09:21.75,0:09:24.68,*Default-ja,NTP,0,0,0,,Нағыз кінәлі осы қаланың бір жерінде болуы керек.
Dialogue: 0,0:09:24.83,0:09:30.28,Chat,,0,0,0,,Ол неғұрлым тезірек ұсталса, сары орамалдар мен долларлар түсініспеушілікті соғұрлым тезірек жояды.
Dialogue: 0,0:09:24.98,0:09:26.48,*Default-ja,NTP,0,0,0,,Егер мені тезірек ұстап алсаңыз
Dialogue: 0,0:09:26.60,0:09:30.04,*Default-ja,NTP,0,0,0,,Менің ойымша, бұл сары тақиялар мен долларлар арасындағы түсініспеушілікті жояды.
Dialogue: 0,0:09:34.32,0:09:36.66,Chat,,0,0,0,,Бұл шынымен де оңай бола ма деп ойлаймын.
Dialogue: 0,0:09:34.38,0:09:36.16,*Default-ja,NTP,0,0,0,,Менің ойымша, бұл оңай бола ма?
Dialogue: 0,0:09:36.66,0:09:40.18,Chat,,0,0,0,,Сары орамалдар да, долларлар да біртұтас топтар емес.
Dialogue: 0,0:09:37.13,0:09:38.72,*Default-ja,NTP,0,0,0,,Сары тюрбандар мен долларлар
Dialogue: 0,0:09:38.82,0:09:40.47,*Default-ja,NTP,0,0,0,,Бұл монолит емес.
Dialogue: 0,0:09:40.73,0:09:45.63,Chat,,0,0,0,,Осы бәсекелестік үшін басқа топтың мүшелерін шайқайтын адамдар болады.
Dialogue: 0,0:09:40.88,0:09:45.99,*Default-ja,NTP,0,0,0,,Өз мүддесін көздеп, дау-дамайдың атын жамылған кесірлі іс-әрекет жасайтындар да болатынына сенімдімін.
Dialogue: 0,0:09:54.67,0:09:58.35,Chat,,0,0,0,,Іс осылай жалғаса берсе, ол нағыз қақтығысқа айналады.
Dialogue: 0,0:09:54.90,0:09:58.47,*Default-ja,NTP,0,0,0,,Осылай жүре берсек, нағыз қақтығысқа тап боламыз.
Dialogue: 0,0:09:59.17,0:10:01.35,Chat,,0,0,0,,Мен бұған жол бермеймін.
Dialogue: 0,0:09:59.38,0:10:01.66,*Default-ja,NTP,0,0,0,,Мен саған бұлай істеуге рұқсат бермеймін...
Dialogue: 0,0:10:01.73,0:10:02.86,Chat,,0,0,0,,Рабу
Dialogue: 0,0:10:02.03,0:10:03.31,*Default-ja,NTP,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:10:02.86,0:10:05.74,Chat,,0,0,0,,Менің ойымша, сіз оны енді тоқтата алмайсыз.
Dialogue: 0,0:10:03.44,0:10:05.42,*Default-ja,NTP,0,0,0,,Мен оны қазір тоқтата алмаймын деп ойлаймын.
Dialogue: 0,0:10:05.74,0:10:09.04,Chat,,0,0,0,,Сары орамалдар туралы ештеңе істей алмайсыз.
Dialogue: 0,0:10:06.01,0:10:09.09,*Default-ja,NTP,0,0,0,,Сары тақияларды тоқтата алмайсың.
Dialogue: 0,0:10:09.44,0:10:11.70,Chat,,0,0,0,,Солай болса да, мен бұған жол бермеймін.
Dialogue: 0,0:10:09.51,0:10:11.66,*Default-ja,NTP,0,0,0,,Сонда да... Мен саған рұқсат бермеймін.
Dialogue: 0,0:10:11.70,0:10:14.53,Chat,,0,0,0,,Хмм. Мен мұны асыға күтемін.
Dialogue: 0,0:10:11.98,0:10:14.45,*Default-ja,NTP,0,0,0,,Хмм, мен оны асыға күтемін.
Dialogue: 0,0:10:15.92,0:10:17.92,Thought,,0,0,0,,«Мен бірдеңе істеуім керек»,
Dialogue: 0,0:10:16.21,0:10:17.74,*Default-ja,NTP,0,0,0,,Егер біз бірдеңе жасамасақ...
Dialogue: 0,0:10:17.92,0:10:21.25,Thought,,0,0,0,,денесінің ішінде эфирлік қылыш бар қыз ойлады.
Dialogue: 0,0:10:18.09,0:10:21.21,*Default-ja,NTP,0,0,0,,Ішінде сиқырлы қылыш бар қыз ойлайды.
Dialogue: 0,0:10:21.25,0:10:23.52,Thought,,0,0,0,,«Мен бірдеңе істеуім керек»,
Dialogue: 0,0:10:21.76,0:10:23.28,*Default-ja,NTP,0,0,0,,Егер біз бірдеңе жасамасақ...
Dialogue: 0,0:10:23.51,0:10:26.64,Thought,,0,0,0,,әлемді тек сурет жақтауынан көрген қыз ойлады.
Dialogue: 0,0:10:23.68,0:10:26.69,*Default-ja,NTP,0,0,0,,Дүниені сурет жақтауынан көрген қыз ойлайды
Dialogue: 0,0:10:26.64,0:10:27.73,Thought,,0,0,0,,Қазір тек екеуміз ғана қалдық.
Dialogue: 0,0:10:26.91,0:10:27.88,*Default-ja,NTP,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:10:29.94,0:10:35.48,Thought,,0,0,0,,...сол терезеден өтіп, оның әлеміне барған бала қазірдің өзінде ұстамды болды ...
Dialogue: 0,0:10:30.12,0:10:33.68,*Default-ja,NTP,0,0,0,,Сурет жақтауын кесіп өтіп, оның әлеміне барған бала
Dialogue: 0,0:10:34.06,0:10:35.81,*Default-ja,NTP,0,0,0,,Қазірдің өзінде түсірілген
Dialogue: 0,0:10:38.11,0:10:41.07,Thought,,0,0,0,,...өз өткенінің ауыр қамыты арқылы.
Dialogue: 0,0:10:38.44,0:10:41.57,*Default-ja,NTP,0,0,0,,Менің өткенімнің ауыр қамыты астында
Dialogue: 0,0:10:45.33,0:10:47.45,Thought,,0,0,0,,Ол енді қашып құтыла алмады.
Dialogue: 0,0:10:45.51,0:10:47.90,*Default-ja,NTP,0,0,0,,Ол енді қашып құтыла алмайды
Dialogue: 0,0:10:57.65,0:10:58.66,Dialogue,,0,0,0,,Сәлеметсіз бе?
Dialogue: 0,0:10:57.89,0:10:58.83,*Default-ja,NTP,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:10:59.26,0:11:00.26,Dialogue,,0,0,0,,Б... бір сызық
Dialogue: 0,0:10:59.41,0:11:01.36,*Default-ja,NTP,0,0,0,,Иә, түсіндім.
Dialogue: 0,0:11:00.26,0:11:01.08,Dialogue,,0,0,0,,Түсіндім.
Dialogue: 0,0:11:01.42,0:11:03.11,Dialogue,,0,0,0,,Мен дәл сол жерде боламын.
Dialogue: 0,0:11:01.61,0:11:02.79,*Default-ja,NTP,0,0,0,,Жарайды, мен бірден кетемін.
Dialogue: 0,0:11:03.11,0:11:05.84,Dialogue,,0,0,0,,Кешіріңіз! Менің досыма бір нәрсе келді!
Dialogue: 0,0:11:03.37,0:11:05.98,*Default-ja,NTP,0,0,0,,Нашар! Менің досымның шұғыл ісі бар.
Dialogue: 0,0:11:06.23,0:11:07.51,Dialogue,,0,0,0,,Өтірік, жеккөру, құлдырау—әр күнді лақтыру
Dialogue: 0,0:11:06.72,0:11:07.64,*Default-ja,NTP,0,0,0,,Солай ма?
Dialogue: 0,0:11:07.51,0:11:10.83,Dialogue,,0,0,0,,Біреуді жек көргің келсе, менің досымды іштей жек көр!
Dialogue: 0,0:11:07.67,0:11:10.79,*Default-ja,NTP,0,0,0,,Кек сақтағың келсе, досыма қалағанша кек сақта.
Dialogue: 0,0:11:10.83,0:11:14.21,Dialogue,,0,0,0,,Жек көрудің құны жоқ, маған зияны да жоқ!
Dialogue: 0,0:11:11.21,0:11:13.81,*Default-ja,NTP,0,0,0,,Кек сақтасаң, ол тегін, маған зияны жоқ.
Dialogue: 0,0:11:14.21,0:11:17.97,Dialogue,,0,0,0,,«Бір таспен екі құс» мінсіз, «Бір еркекке көп әйел!».
Dialogue: 0,0:11:14.32,0:11:17.52,*Default-ja,NTP,0,0,0,,Бұл көп әйел алу, екі құсты бір оқпен өлтіру!
Dialogue: 0,0:11:17.97,0:11:18.97,Dialogue,,0,0,0,,«Бір еркекке көп әйел?»
Dialogue: 0,0:11:18.05,0:11:19.22,*Default-ja,NTP,0,0,0,,Көп әйел алу?
Dialogue: 0,0:11:19.25,0:11:21.98,Dialogue,,0,0,0,,Ертең кездескенше!
Dialogue: 0,0:11:19.36,0:11:22.80,*Default-ja,NTP,0,0,0,,Ертең кездескенше!
Dialogue: 0,0:11:23.14,0:11:25.37,Dialogue,,0,0,0,,Қызық, бұл шынымен де соншалықты маңызды ма?
Dialogue: 0,0:11:23.33,0:11:25.42,*Default-ja,NTP,0,0,0,,А... Бұл шынымен де шұғыл ма?
Dialogue: 0,0:11:25.37,0:11:29.20,Dialogue,,0,0,0,,Сіздің ойыңызша Кида соңғы кездері біртүрлі әрекет етіп жүр емес пе?
Dialogue: 0,0:11:25.63,0:11:29.51,*Default-ja,NTP,0,0,0,,Кида-кун, соңғы кездері оның әрекеті біртүрлі болды деп ойламайсың ба?
Dialogue: 0,0:11:29.20,0:11:30.23,Dialogue,,0,0,0,,Мен бір қолымда оқ жалғанған винтовка ұстап тұрмын
Dialogue: 0,0:11:29.55,0:11:31.44,*Default-ja,NTP,0,0,0,,Қызық, бұл жай ғана менің қиялым ба?
Dialogue: 0,0:11:30.23,0:11:31.24,Dialogue,,0,0,0,,Мұның бәрі сіздің ойыңызда емес екеніне сенімдісіз бе?
Dialogue: 0,0:11:36.52,0:11:38.46,Dialogue,,0,0,0,,Мм...кешіріңіз.
Dialogue: 0,0:11:37.29,0:11:40.54,*Default-ja,NTP,0,0,0,,Кешіріңіз, менің бір ісім бар.
Dialogue: 0,0:11:38.46,0:11:40.72,Dialogue,,0,0,0,,Менің айналысатын ісім бар.
Dialogue: 0,0:11:40.72,0:11:41.61,Dialogue,,0,0,0,,Кездескенше.
Dialogue: 0,0:11:40.92,0:11:41.91,*Default-ja,NTP,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:11:44.99,0:11:49.03,Dialogue,,0,0,0,,Сіз кейбір долларларды сары орамалдар шайқағанын естідіңіз бе?
Dialogue: 0,0:11:45.20,0:11:49.38,*Default-ja,NTP,0,0,0,,Юбе долларының мүшелерін сары тақиялы қарақшылар ұрлап кеткен деп естідім?
Dialogue: 0,0:11:49.03,0:11:53.10,Dialogue,,0,0,0,,Шамасы, олар өмірінің бір дюйміне дейін соққыға жығылды.
Dialogue: 0,0:11:49.39,0:11:53.34,*Default-ja,NTP,0,0,0,,А-а~ Шамасы, біреу өліп қала жаздады.
Dialogue: 0,0:11:53.10,0:11:57.01,Dialogue,,0,0,0,,Сары орамалдар «Слейшер» доллардың бір бөлігі екенін айтады, солай емес пе?
Dialogue: 0,0:11:53.38,0:11:57.16,*Default-ja,NTP,0,0,0,,Сары тақиялар «Қарашы» доллардың туындысы дейді.
Dialogue: 0,0:11:59.03,0:12:03.62,Thought,,0,0,0,,Долларды басқаратын бала жағдайдың бұлай жалғаса алмайтынын білді.
Dialogue: 0,0:11:59.23,0:12:00.63,*Default-ja,NTP,0,0,0,,Мұны жалғастыру мүмкін емес
Dialogue: 0,0:12:00.99,0:12:03.39,*Default-ja,NTP,0,0,0,,Долларды басқарған бала мұны білді.
Dialogue: 0,0:12:04.74,0:12:10.16,Thought,,0,0,0,,Алайда, ол шахмат тақтасындағы пешка сияқты қолданылып жатқанын әлі білмеді.
Dialogue: 0,0:12:04.95,0:12:09.75,*Default-ja,NTP,0,0,0,,Дегенмен, ол тақтада кесінді ретінде де тұрғанын әлі білмейді.
Dialogue: 0,0:12:10.16,0:12:13.00,Dialogue,,0,0,0,,Тұтынушылар, суши жеңіз!
Dialogue: 0,0:12:10.52,0:12:13.11,*Default-ja,NTP,0,0,0,,Тұтынушылар суши жейді.
Dialogue: 0,0:12:13.00,0:12:15.30,Dialogue,,0,0,0,,Суши - Жапонияның жүрегі.
Dialogue: 0,0:12:13.17,0:12:17.02,*Default-ja,NTP,0,0,0,,Суши - Жапонияның жүрегі.
Dialogue: 0,0:12:15.30,0:12:16.41,Dialogue,,0,0,0,,Бұл енка!
Dialogue: 0,0:12:16.84,0:12:20.88,Dialogue,,0,0,0,,Алып кетуге тапсырыс бергенде казак биін билейді деген рас па?
Dialogue: 0,0:12:17.03,0:12:21.04,*Default-ja,NTP,0,0,0,,Жеткізіп алсаң, саған казак биін береді деген рас па?
Dialogue: 0,0:12:20.88,0:12:25.16,Dialogue,,0,0,0,,Ойлап қарасам, ол кеше түнде сол балалардың соңынан еріп бара жатқанда босану үстінде екен.
Dialogue: 0,0:12:21.15,0:12:22.72,*Default-ja,NTP,0,0,0,,Бірақ Юбенің балалары
Dialogue: 0,0:12:22.79,0:12:25.36,*Default-ja,NTP,0,0,0,,Саймон жеткізуге шықты және твиттер жазды.
Dialogue: 0,0:12:27.72,0:12:31.42,Dialogue,,0,0,0,,Егер сен сол таяқшаны сермесең, мен сені сушиге айналдырамын.
Dialogue: 0,0:12:28.08,0:12:31.42,*Default-ja,NTP,0,0,0,,Егер сіз бұл таяқшаны төмен қарай сермесеңіз, сіз сушиге айналасыз.
Dialogue: 0,0:12:31.42,0:12:35.79,Dialogue,,0,0,0,,Адам сушиі... Ой, ауырады, дәмі нашар.
Dialogue: 0,0:12:31.75,0:12:33.13,*Default-ja,NTP,0,0,0,,Адам Зуши
Dialogue: 0,0:12:33.17,0:12:35.66,*Default-ja,NTP,0,0,0,,О~ Ауырды және өте жаман~
Dialogue: 0,0:12:36.72,0:12:39.99,Dialogue,,0,0,0,,Сәттілік ұзаққа созылмайды.
Dialogue: 0,0:12:36.83,0:12:39.35,*Default-ja,NTP,0,0,0,,Сәттілік соншалықты ұзаққа созылмайды.
Dialogue: 0,0:12:39.99,0:12:40.68,Dialogue,,0,0,0,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,0:12:43.76,0:12:47.01,Dialogue,,0,0,0,,Адам, бұл бұлттар қорқынышты көрінеді...
Dialogue: 0,0:12:44.12,0:12:47.07,*Default-ja,NTP,0,0,0,,Менің бұлтқа барғым келмейді.
Dialogue: 0,0:12:53.53,0:12:58.24,Thought,,0,0,0,,Доллар немесе сары орамалдар туралы бірдеңе білетін адам бар ма?
Dialogue: 0,0:12:54.02,0:12:59.37,*Default-ja,NTP,0,0,0,,Сары тақиялар мен долларлар туралы білетіндер бар ма? Біреу...
Dialogue: 0,0:12:58.24,0:12:59.04,Thought,,0,0,0,,Біреу...?
Dialogue: 0,0:13:02.31,0:13:04.66,Dialogue,,0,0,0,,Біздің бастығымыз Кида Масаоми.
Dialogue: 0,0:13:02.52,0:13:04.76,*Default-ja,NTP,0,0,0,,Менің бастығым – Масаоми Кида.
Dialogue: 0,0:13:04.66,0:13:07.37,Dialogue,,0,0,0,,Мен оны сенімен бірге көрдім, анашым.
Dialogue: 0,0:13:04.86,0:13:07.47,*Default-ja,NTP,0,0,0,,Мен сені «Анашым» арқылы да көрдім.
Dialogue: 0,0:13:08.50,0:13:13.46,Dialogue,,0,0,0,,Жауыңнан кек алмақшымын деді, ана.
Dialogue: 0,0:13:08.76,0:13:13.40,*Default-ja,NTP,0,0,0,,«Анашым»... Аяулы досының жауын алмақшымын деді.
Dialogue: 0,0:13:13.46,0:13:15.15,Dialogue,,0,0,0,,Мен сенің дірілдеп тұрған жеріңе асығып барамын
Dialogue: 0,0:13:13.77,0:13:14.86,*Default-ja,NTP,0,0,0,,Бұл...
Dialogue: 0,0:13:15.14,0:13:17.77,Thought,,0,0,0,,Әрине, ол сенбеді.
Dialogue: 0,0:13:15.47,0:13:17.88,*Default-ja,NTP,0,0,0,,Әрине сене алмайды.
Dialogue: 0,0:13:17.77,0:13:21.90,Thought,,0,0,0,,Алайда балалары оған өтірік айта алмайды.
Dialogue: 0,0:13:18.18,0:13:22.10,*Default-ja,NTP,0,0,0,,Бірақ «ана» болған қызға «бала» өтірік айта алмайды.
Dialogue: 0,0:13:22.43,0:13:23.49,Dialogue,,0,0,0,,Кида қайда...?
Dialogue: 0,0:13:22.59,0:13:23.61,*Default-ja,NTP,0,0,0,,Кида ше?
Dialogue: 0,0:13:23.49,0:13:25.66,Dialogue,,0,0,0,,Ол бүгін кездесуге барады.
Dialogue: 0,0:13:23.69,0:13:25.57,*Default-ja,NTP,0,0,0,,Мен бүгін кездесуге келемін.
Dialogue: 0,0:13:27.38,0:13:29.65,Dialogue,,0,0,0,,Мені сол кездесуге апаруыңызды өтінемін.
Dialogue: 0,0:13:27.53,0:13:29.73,*Default-ja,NTP,0,0,0,,Мені жиналысқа апаруыңызды өтінемін
Dialogue: 0,0:13:30.33,0:13:31.66,Thought,,0,0,0,,Сонымен...
Dialogue: 0,0:13:30.54,0:13:31.78,*Default-ja,NTP,0,0,0,,Содан кейін...
Dialogue: 0,0:13:35.25,0:13:37.86,Thought,,0,0,0,,...ол бәрін білді.
Dialogue: 0,0:13:35.54,0:13:37.52,*Default-ja,NTP,0,0,0,,Ол бәрін білді
Dialogue: 0,0:13:39.96,0:13:41.04,Thought,,0,0,0,,Кида бұл...
Dialogue: 0,0:13:40.21,0:13:41.53,*Default-ja,NTP,0,0,0,,Кида-кун...
Dialogue: 0,0:13:41.04,0:13:43.52,Dialogue,,0,0,0,,Артқы жақта ма?
Dialogue: 0,0:13:41.56,0:13:43.50,*Default-ja,NTP,0,0,0,,Артқы жағында емес пе?
Dialogue: 0,0:13:46.26,0:13:47.38,Thought,,0,0,0,,Егер ол жүгірмесе...
Dialogue: 0,0:13:46.45,0:13:47.71,*Default-ja,NTP,0,0,0,,Қашпасаң...
Dialogue: 0,0:13:47.38,0:13:48.47,Dialogue,,0,0,0,,Бұл оңай.
Dialogue: 0,0:13:48.47,0:13:52.35,Secondary Thought,,0,0,0,,Неліктен Кида...?
Dialogue: 0,0:13:48.80,0:13:49.53,*Default-ja,NTP,0,0,0,,Неліктен?
Dialogue: 0,0:13:49.26,0:13:51.18,Dialogue,,0,0,0,,Мен бәрін жақсы көремін.
Dialogue: 0,0:13:49.54,0:13:51.32,*Default-ja,NTP,0,0,0,,Мен бәріңді жақсы көремін
Dialogue: 0,0:13:51.51,0:13:52.47,*Default-ja,NTP,0,0,0,,Кида-кун...
Dialogue: 0,0:13:52.56,0:13:56.14,Dialogue,,0,0,0,,Мен де анау сары балаларды қиып ашып, жақсы көремін.
Dialogue: 0,0:13:53.00,0:13:55.01,*Default-ja,NTP,0,0,0,,Сары балалар да
Dialogue: 0,0:13:55.02,0:13:56.25,*Default-ja,NTP,0,0,0,,Денені кесектерге кесіңіз
Dialogue: 0,0:13:56.14,0:13:58.35,Thought,,0,0,0,,Оған не болады?
Dialogue: 0,0:13:56.33,0:13:57.53,*Default-ja,NTP,0,0,0,,Мен сені сүйемін
Dialogue: 0,0:13:56.61,0:13:58.62,*Default-ja,NTP,0,0,0,,Мен ұсталып қалсам не болады?
Dialogue: 0,0:13:58.35,0:14:03.11,Dialogue,,0,0,0,,Мен оларды сенің орныңа жақсы көремін, өйткені сен істей алмайсың.
Dialogue: 0,0:13:58.74,0:14:01.58,*Default-ja,NTP,0,0,0,,Мен сенің орныңа біреуді сүйе алмаймын
Dialogue: 0,0:14:01.62,0:14:03.94,*Default-ja,NTP,0,0,0,,Мен сені сүйемін
Dialogue: 0,0:14:03.37,0:14:06.00,Thought,,0,0,0,,Мен... ешкімді ренжіткім келмейді!
Dialogue: 0,0:14:03.67,0:14:06.01,*Default-ja,NTP,0,0,0,,Мен ешкімді ренжіткім келмейді!
Dialogue: 0,0:14:05.99,0:14:09.11,Thought,,0,0,0,,Бала оның құбыжық екенін біледі.
Dialogue: 0,0:14:06.27,0:14:09.24,*Default-ja,NTP,0,0,0,,Бала менің құбыжық екенімді біледі
Dialogue: 0,0:14:09.11,0:14:11.53,Thought,,0,0,0,,Ол қорқып дірілдеп кетті.
Dialogue: 0,0:14:09.41,0:14:11.61,*Default-ja,NTP,0,0,0,,Қыз қорқып дірілдейді
Dialogue: 0,0:14:11.53,0:14:13.10,Dialogue,,0,0,0,,Бұл тым тар.
Dialogue: 0,0:14:11.77,0:14:13.15,*Default-ja,NTP,0,0,0,,Бұл тым тар және мүмкін емес.
Dialogue: 0,0:14:13.10,0:14:13.92,Dialogue,,0,0,0,,Мен барамын.
Dialogue: 0,0:14:13.22,0:14:14.05,*Default-ja,NTP,0,0,0,,Мен барамын
Dialogue: 0,0:14:13.92,0:14:14.61,Thought,,0,0,0,,Кида?!
Dialogue: 0,0:14:14.16,0:14:14.98,*Default-ja,NTP,0,0,0,,Кида-кун!
Dialogue: 0,0:14:16.45,0:14:17.72,Thought,,0,0,0,,Маған көмектес!
Dialogue: 0,0:14:16.80,0:14:19.54,*Default-ja,NTP,0,0,0,,Маған көмектесіңізші...біреу маған көмектесіңізші!
Dialogue: 0,0:14:17.72,0:14:19.21,Thought,,0,0,0,,Біреу, маған көмектесіңізші!
Dialogue: 0,0:14:20.64,0:14:22.33,Dialogue,,0,0,0,,Сәлем! Бұл сол нәрсе...
Dialogue: 0,0:14:20.88,0:14:22.09,*Default-ja,NTP,0,0,0,,Сәлем! Бұл...
Dialogue: 0,0:14:23.71,0:14:25.92,Thought,,0,0,0,,Жаңбыр астында тұрып...
Dialogue: 0,0:14:23.90,0:14:25.85,*Default-ja,NTP,0,0,0,,Жаңбыр астында тұру
Dialogue: 0,0:14:27.05,0:14:29.13,Thought,,0,0,0,,...дуллахан әйел еді.
Dialogue: 0,0:14:27.26,0:14:28.92,*Default-ja,NTP,0,0,0,,Дуллахан әйел
Dialogue: 0,0:14:35.52,0:14:44.23,Thought,,0,0,0,,Тұтқынға түскен қыздың қолынан келетін жалғыз нәрсе – бұл дүниеде болмауы тиіс өзі сияқты біреуден көмек сұрау.
Dialogue: 0,0:14:35.73,0:14:38.52,*Default-ja,NTP,0,0,0,,Бұрышта отырған қыздың қолынан келетін жалғыз нәрсе болды
Dialogue: 0,0:14:38.76,0:14:44.48,*Default-ja,NTP,0,0,0,,Мен бар болғаны мен сияқты бұл дүниеде болмауы керек біреуден көмек сұрау болды.
Dialogue: 0,0:14:44.82,0:14:47.61,Dialogue,,0,0,0,,Велосипедімен қабырғаны басып өтті!
Dialogue: 0,0:14:45.34,0:14:47.88,*Default-ja,NTP,0,0,0,,Велосипедімен қабырғадан асып түсті.
Dialogue: 0,0:14:47.87,0:14:49.40,Dialogue,,0,0,0,,Мен бұған сене аламын.
Dialogue: 0,0:14:48.01,0:14:49.47,*Default-ja,NTP,0,0,0,,Ол мұны істей алады.
Dialogue: 0,0:14:53.01,0:14:54.33,Dialogue,,0,0,0,,Ол қимыл жасайды!
Dialogue: 0,0:14:53.28,0:14:54.09,*Default-ja,NTP,0,0,0,,Қозғалайық
Dialogue: 0,0:15:06.92,0:15:08.00,Dialogue,,0,0,0,,...Сіз байсалдысыз ба...?
Dialogue: 0,0:15:07.12,0:15:08.22,*Default-ja,NTP,0,0,0,,Тағы да әуеніңді бұздың! Қанша рет айтуым керек саған түсіну үшін!—
Dialogue: 0,0:15:08.76,0:15:09.66,Dialogue,,0,0,0,,Селти!
Dialogue: 0,0:15:08.96,0:15:09.95,*Default-ja,NTP,0,0,0,,Мистер Селти!
Dialogue: 0,0:15:10.87,0:15:12.45,Dialogue,,0,0,0,,Мен кейінірек түсіндіремін.
Dialogue: 0,0:15:11.04,0:15:12.51,*Default-ja,NTP,0,0,0,,Жағдайды кейінірек талқылаймыз.
Dialogue: 0,0:15:12.45,0:15:14.42,Dialogue,,0,0,0,,Біз бұл жерден кетеміз. Артқы жағына секіріңіз.
Dialogue: 0,0:15:12.82,0:15:14.62,*Default-ja,NTP,0,0,0,,Қаш, артқа мін
Dialogue: 0,0:15:14.42,0:15:15.88,Dialogue,,0,0,0,,О-Жарайды!
Dialogue: 0,0:15:15.33,0:15:16.04,*Default-ja,NTP,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,0:15:21.54,0:15:23.71,Dialogue,,0,0,0,,Саған көп рахмет.
Dialogue: 0,0:15:22.14,0:15:23.37,*Default-ja,NTP,0,0,0,,Рахмет
Dialogue: 0,0:15:23.71,0:15:25.19,Dialogue,,0,0,0,,Мықтап ұстаңыз.
Dialogue: 0,0:15:23.95,0:15:25.30,*Default-ja,NTP,0,0,0,,Мықтап ұстаңыз
Dialogue: 0,0:15:37.26,0:15:40.37,Dialogue,,0,0,0,,Мен сізді біраз уақыттан бері көрдім,
Dialogue: 0,0:15:37.49,0:15:40.50,*Default-ja,NTP,0,0,0,,Мен сені көптен бері көрдім.
Dialogue: 0,0:15:40.37,0:15:42.02,Dialogue,,0,0,0,,бұл костюм жігітке аздап тар көрінеді.
Dialogue: 0,0:15:40.62,0:15:45.35,*Default-ja,NTP,0,0,0,,Сол шабандоз костюміндегі сызықтар ер адам үшін тым жұқа деп есептелді.
Dialogue: 0,0:15:42.02,0:15:47.60,Dialogue,,0,0,0,,Жігіт болсаң маған бәрібір, бірақ мен сені тек костюм үшін жақсы көретін едім, егер сен қыз болсаң.
Dialogue: 0,0:15:45.64,0:15:47.25,*Default-ja,NTP,0,0,0,,Маған бәрібір бұл еркек пе.
Dialogue: 0,0:15:47.59,0:15:54.47,Dialogue,,0,0,0,,Олар «Будданы жақсы көр, оның киімін жақсы көр» дейді.
Dialogue: 0,0:15:47.86,0:15:51.75,*Default-ja,NTP,0,0,0,,Егер сен әйел болсаң, мені сол шабандоз костюмін киіп жақсы көре аласың.
Dialogue: 0,0:15:51.88,0:15:54.63,*Default-ja,NTP,0,0,0,,Егер сен монахты жақсы көрсең, оның шапанын да жақсы көресің.
Dialogue: 0,0:15:54.48,0:15:57.46,Thought,,0,0,0,,Бұл Микадо мен Анримен үнемі бірге жүретін жігіт...
Dialogue: 0,0:15:54.68,0:15:57.42,*Default-ja,NTP,0,0,0,,Бұл жігіт үнемі Микадо мен Анридің қасында...
Dialogue: 0,0:15:59.35,0:16:01.16,Thought,,0,0,0,,О, түсіндім...
Dialogue: 0,0:16:00.29,0:16:03.33,*Default-ja,NTP,0,0,0,,Түсіндім, мен бұл жігіттің менің бетімді көргенін қаламаймын.
Dialogue: 0,0:16:01.16,0:16:03.18,Thought,,0,0,0,,Оның жүзін көргенін қаламайды.
Dialogue: 0,0:16:03.18,0:16:05.94,Thought,,0,0,0,,Мен жағдайды түсінбеймін, бірақ істеймін.
Dialogue: 0,0:16:03.61,0:16:06.04,*Default-ja,NTP,0,0,0,,Мен мән-жайды білмеймін, бірақ түсінемін.
Dialogue: 0,0:16:10.56,0:16:11.27,Dialogue,,0,0,0,,Жер
Dialogue: 0,0:16:10.90,0:16:11.89,*Default-ja,NTP,0,0,0,,Не?
Dialogue: 0,0:16:24.60,0:16:25.64,Dialogue,,0,0,0,,Мұнда.
Dialogue: 0,0:16:24.97,0:16:26.21,*Default-ja,NTP,0,0,0,,Боқта~
Dialogue: 0,0:16:27.41,0:16:28.57,Dialogue,,0,0,0,,Құбыжық!
Dialogue: 0,0:16:27.60,0:16:28.85,*Default-ja,NTP,0,0,0,,Құбыжық!
Dialogue: 0,0:16:28.57,0:16:29.28,Dialogue,,0,0,0,,Болма!
Dialogue: 0,0:16:28.85,0:16:29.57,*Default-ja,NTP,0,0,0,,Келіңіздер!
Dialogue: 0,0:16:38.60,0:16:42.06,Thought,,0,0,0,,Олардың бірі аты аңызға айналған басы жоқ шабандоз болуы керек екенін білді.
Dialogue: 0,0:16:38.80,0:16:42.13,*Default-ja,NTP,0,0,0,,Оның келбеті аты аңызға айналған басы жоқ шабандозға ұқсайды.
Dialogue: 0,0:16:53.70,0:16:58.57,Thought,,0,0,0,,Өздері білетін ақпараттың үзінділері әп-сәтте жиналды.
Dialogue: 0,0:16:53.96,0:16:58.11,*Default-ja,NTP,0,0,0,,Ақпарат фрагменттері олардың ішінде бір сәтте біріктіріледі.
Dialogue: 0,0:16:58.60,0:17:01.57,Thought,,0,0,0,,Шабуылшы Қылшықтың қылышын ұстады.
Dialogue: 0,0:16:58.97,0:17:01.67,*Default-ja,NTP,0,0,0,,Пышақты шабақ тәрізді ұстаған қаскүнем.
Dialogue: 0,0:17:01.57,0:17:03.83,Thought,,0,0,0,,Қара байкер оны құтқаруға келді.
Dialogue: 0,0:17:01.90,0:17:03.92,*Default-ja,NTP,0,0,0,,Қара велосипед көмекке келді.
Dialogue: 0,0:17:04.59,0:17:07.56,Thought,,0,0,0,,Сондай-ақ қара байкер доллардың бір бөлігі деген қауесет тарады.
Dialogue: 0,0:17:04.76,0:17:07.43,*Default-ja,NTP,0,0,0,,Ал қара велосипед доллар деген қауесет.
Dialogue: 0,0:17:07.56,0:17:10.08,Thought,,0,0,0,,Олардың барлығы бір қорытындыға келді:
Dialogue: 0,0:17:07.90,0:17:10.05,*Default-ja,NTP,0,0,0,,Олар қорытынды жасайды
Dialogue: 0,0:17:10.85,0:17:12.65,Thought,,0,0,0,,Slasher доллардың бір бөлігі болып табылады.
Dialogue: 0,0:17:10.93,0:17:12.81,*Default-ja,NTP,0,0,0,,Slasher - бұл доллар
Dialogue: 0,0:17:13.57,0:17:17.58,Thought,,0,0,0,,Бала бұл тұжырымның дұрыс немесе дұрыс еместігін білмеді.
Dialogue: 0,0:17:13.71,0:17:17.75,*Default-ja,NTP,0,0,0,,Бала өз тұжырымының дұрыс немесе бұрыс екенін білмейді.
Dialogue: 0,0:17:18.34,0:17:21.72,Thought,,0,0,0,,Бірақ оның білгені, ол бұл туралы қанша ойласа да,
Dialogue: 0,0:17:18.47,0:17:19.70,*Default-ja,NTP,0,0,0,,Бір нәрсе анық:
Dialogue: 0,0:17:19.95,0:17:21.57,*Default-ja,NTP,0,0,0,,Ол не ойласа да
Dialogue: 0,0:17:21.72,0:17:26.60,Thought,,0,0,0,,ол бұл оқиғаға куә болғандарды тежей алмас еді.
Dialogue: 0,0:17:21.82,0:17:26.57,*Default-ja,NTP,0,0,0,,Бұл жағдайды басынан өткерген достарымды енді басқара алмайтынымды білдіреді.
Dialogue: 0,0:17:26.60,0:17:27.89,Dialogue,,0,0,0,,Эй...
Dialogue: 0,0:17:27.09,0:17:29.33,*Default-ja,NTP,0,0,0,,Әй, сен Дуллаханның не екенін білесің бе?
Dialogue: 0,0:17:27.89,0:17:29.12,Dialogue,,0,0,0,,Дуллахтар туралы білесің бе?
Dialogue: 0,0:17:29.12,0:17:32.06,Dialogue,,0,0,0,,Иә? Мм... Жоқ, білмеймін.
Dialogue: 0,0:17:31.06,0:17:32.13,*Default-ja,NTP,0,0,0,,Мен білмеймін
Dialogue: 0,0:17:32.06,0:17:35.18,Dialogue,,0,0,0,,Олар өлейін деп жатқандардың үйіне барады.
Dialogue: 0,0:17:32.42,0:17:34.61,*Default-ja,NTP,0,0,0,,Өлейін деп жатқан адамның үйіне бару
Dialogue: 0,0:17:35.18,0:17:39.15,Dialogue,,0,0,0,,Олар бассыз атқа мінетін бассыз рыцарьлар.
Dialogue: 0,0:17:35.42,0:17:38.68,*Default-ja,NTP,0,0,0,,Ол бассыз атқа мінген басы жоқ рыцарь.
Dialogue: 0,0:17:39.15,0:17:41.56,Dialogue,,0,0,0,,Міне, менің ойымша, олар «Қырсық» сияқты.
Dialogue: 0,0:17:39.42,0:17:41.60,*Default-ja,NTP,0,0,0,,Бұл өлім құдайы сияқты.
Dialogue: 0,0:17:43.04,0:17:44.58,Thought,,0,0,0,,Бала кенет ойлады:
Dialogue: 0,0:17:43.29,0:17:44.63,*Default-ja,NTP,0,0,0,,Бала кенет ойланып қалады
Dialogue: 0,0:17:44.58,0:17:47.87,Thought,,0,0,0,,«Арамызда біреу өлуі мүмкін...»
Dialogue: 0,0:17:45.04,0:17:48.39,*Default-ja,NTP,0,0,0,,Мүмкін арамызда біреу өлетін шығар...
Dialogue: 0,0:17:49.87,0:17:54.19,Dialogue,,0,0,0,,Неге...осындай уақытта Сақиды көргім келеді?
Dialogue: 0,0:17:50.05,0:17:53.82,*Default-ja,NTP,0,0,0,,Неліктен осындай уақытта Сакимен кездескіңіз келеді...
Dialogue: 0,0:17:58.38,0:18:00.60,Thought,,0,0,0,,«Көк әулет өлді».
Dialogue: 0,0:17:58.70,0:18:00.67,*Default-ja,NTP,0,0,0,,Көк аспанда өл
Dialogue: 0,0:18:00.59,0:18:02.25,Thought,,0,0,0,,«Аспан құлады».
Dialogue: 0,0:18:00.88,0:18:02.17,*Default-ja,NTP,0,0,0,,Аспан өлі
Dialogue: 0,0:18:02.26,0:18:07.42,Thought,,0,0,0,,Үш патшалық шежіресінде сары жалау ұстаған белгілі бір топ осы ұран болды.
Dialogue: 0,0:18:02.56,0:18:07.53,*Default-ja,NTP,0,0,0,,«Үш патшалық романында» сары тақиялар көтерілген кезде қолданылған ту деп айтылады.
Dialogue: 0,0:18:10.98,0:18:13.22,Dialogue,,0,0,0,,Бұл өте көк емес.
Dialogue: 0,0:18:11.37,0:18:13.07,*Default-ja,NTP,0,0,0,,Әрине көк емес
Dialogue: 0,0:18:14.00,0:18:16.43,Dialogue,,0,0,0,,Жарайды, ол да сары емес.
Dialogue: 0,0:18:14.21,0:18:16.07,*Default-ja,NTP,0,0,0,,Бұл да сары емес.
Dialogue: 0,0:18:16.44,0:18:16.69,Chat,,0,0,0,,Танака Таро чат бөлмесіне кірді.
Dialogue: 0,0:18:16.69,0:18:17.20,Chat,,0,0,0,,Танака Таро чат бөлмесіне кірді.
Dialogue: 0,0:18:16.69,0:18:17.24,Chat,,0,0,0,,Канра чат бөлмесіне кірді.
Dialogue: 0,0:18:17.24,0:18:18.94,Chat,,0,0,0,,Танака Таро чат бөлмесіне кірді.
Dialogue: 0,0:18:17.24,0:18:18.95,Chat,,0,0,0,,Канра чат бөлмесіне кірді.
Dialogue: 0,0:18:17.25,0:18:18.94,Chat,,0,0,0,,Қайырлы кеш.
Dialogue: 0,0:18:18.94,0:18:21.03,Chat,,0,0,0,,Мұнда жалғыз сенсің бе, Таро?
Dialogue: 0,0:18:18.95,0:18:20.95,Chat,,0,0,0,,Канра чат бөлмесіне кірді.
Dialogue: 0,0:18:21.03,0:18:21.73,Chat,,0,0,0,,Қайырлы кеш.
Dialogue: 0,0:18:21.73,0:18:22.98,Chat,,0,0,0,,Соған ұқсайды.
Dialogue: 0,0:18:23.39,0:18:25.44,Chat,,0,0,0,,Жеке әңгімеден бастасақ, солай ма?
Dialogue: 0,0:18:23.55,0:18:25.55,*Default-ja,NTP,0,0,0,,Сіз кенеттен құпия режимде болдыңыз ба?
Dialogue: 0,0:18:25.44,0:18:27.86,Chat,,0,0,0,,Мен сізден бір нәрсе сұрайын деп едім.
Dialogue: 0,0:18:25.89,0:18:27.64,*Default-ja,NTP,0,0,0,,Мен сізден бір нәрсе сұрайын деп едім.
Dialogue: 0,0:18:27.86,0:18:32.24,Chat,,0,0,0,,Ым, сары орамалдар әрқашан Икебукурада болды ма?
Dialogue: 0,0:18:28.05,0:18:31.90,*Default-ja,NTP,0,0,0,,Әлгі сары тақиялар Икебукурада көп болды ма?
Dialogue: 0,0:18:32.24,0:18:34.75,Chat,,0,0,0,,Олар үш жыл бұрын басталды.
Dialogue: 0,0:18:34.75,0:18:37.73,Chat,,0,0,0,,Басында олар өте мойынсұнғыш болды.
Dialogue: 0,0:18:39.88,0:18:46.18,Thought,,0,0,0,,Долларды басқаратын бала көк шаршылар мен сары орамалдар арасындағы қызу бәсеке туралы білді.
Dialogue: 0,0:18:40.22,0:18:45.76,*Default-ja,NTP,0,0,0,,Долларды басқаратын бала Сары тақиялар мен Көк алаң арасындағы сұмдық қақтығыс туралы біледі.
Dialogue: 0,0:18:46.18,0:18:51.65,Thought,,0,0,0,,Ол өзінің жақын досының бұрынғы ғашығы сол жанжалдың құрбаны болғанын білмей қалды...
Dialogue: 0,0:18:46.47,0:18:51.51,*Default-ja,NTP,0,0,0,,Құрбандыққа шалынған қыз өзінің жақын досының бұрынғы сүйіктісі екенін білмей...
Dialogue: 0,0:18:51.65,0:18:56.39,Thought,,0,0,0,,...және оның сұрақтарына жауап берген адам сол қыздың ақыл-ойын басқарды,
Dialogue: 0,0:18:52.20,0:18:54.44,*Default-ja,NTP,0,0,0,,Ал сөйлеген адам
Dialogue: 0,0:18:54.57,0:18:56.33,*Default-ja,NTP,0,0,0,,Қыздың жүрегін басқар
Dialogue: 0,0:18:56.39,0:18:59.99,Thought,,0,0,0,,, сондай-ақ жақын досына жазылмас жара қалдырды.
Dialogue: 0,0:18:56.54,0:19:00.37,*Default-ja,NTP,0,0,0,,Ең жақын досыма ешқашан жазылмайтын жара салғанымды білмей...
Dialogue: 0,0:19:00.90,0:19:03.45,Chat,,0,0,0,,...Сонымен, сары орамалдар ғана аман қалды...
Dialogue: 0,0:19:03.45,0:19:06.44,Chat,,0,0,0,,Дегенмен, Көк шаршылар өлмеді.
Dialogue: 0,0:19:08.09,0:19:09.24,Chat,,0,0,0,,Ұзақ жұмыс күнінен кейін бір шыныаяқ сакэ ішуден артық ештеңе жоқ!
Dialogue: 0,0:19:09.24,0:19:12.28,Chat,,0,0,0,,Сары орамалдар көсемі шайқасудан шаршады,
Dialogue: 0,0:19:12.28,0:19:13.99,Chat,,0,0,0,,және ол кеткеннен кейін,
Dialogue: 0,0:19:13.99,0:19:16.25,Chat,,0,0,0,,олар сары орамалдарға қосылды.
Dialogue: 0,0:19:17.21,0:19:19.24,Chat,,0,0,0,,Сіз олар біріктірілді дейсіз бе?
Dialogue: 0,0:19:17.28,0:19:19.39,*Default-ja,NTP,0,0,0,,Бұл олардың біріктірілгенін білдіре ме?
Dialogue: 0,0:19:19.29,0:19:21.13,Chat,,0,0,0,,Қарапайым тілмен айтқанда, иә.
Dialogue: 0,0:19:21.21,0:19:28.21,Chat,,0,0,0,,Бірде-бір топ (өз басшыларынан басқа) адамдардың қайдан келгенін білуге ​​жеткілікті мән бермегеніне сенімдімін.
Dialogue: 0,0:19:21.34,0:19:23.46,*Default-ja,NTP,0,0,0,,Бір-бірінің ұйымдарында кім болды?
Dialogue: 0,0:19:23.76,0:19:28.15,*Default-ja,NTP,0,0,0,,Басшылық қызметтегі адамдардан басқа, менің ойымша, оны әр уақытта ешкім тексере бермейді.
Dialogue: 0,0:19:28.85,0:19:30.80,Chat,,0,0,0,,Олар көк киімдерін тастағаннан кейін,
Dialogue: 0,0:19:30.80,0:19:34.97,Chat,,0,0,0,,Олар «Мен сары орамалда болғым келеді» дегені үшін ғана рұқсат алар еді.
Dialogue: 0,0:19:35.89,0:19:38.20,Chat,,0,0,0,,Бірақ жұмыстан кеткен басшы ше?
Dialogue: 0,0:19:35.99,0:19:38.43,*Default-ja,NTP,0,0,0,,Бірақ бұл басшыны тастаған дегенді білдірмейді...
Dialogue: 0,0:19:38.20,0:19:40.01,Chat,,0,0,0,,Ол білмейтін шығар...
Dialogue: 0,0:19:38.46,0:19:39.72,*Default-ja,NTP,0,0,0,,Білмейтін шығарсыз.
Dialogue: 0,0:19:40.01,0:19:45.57,Chat,,0,0,0,,...қыз сүйгенін ауруханаға жіберген жігіттер қазір оның ескі достарымен асылып жатыр.
Dialogue: 0,0:19:40.21,0:19:42.99,*Default-ja,NTP,0,0,0,,Ғашықтарын ауруханаға жіберген адамдар
Dialogue: 0,0:19:43.25,0:19:45.80,*Default-ja,NTP,0,0,0,,Ескі достарыммен араласып жүргеніме сене алар емеспін.
Dialogue: 0,0:19:47.15,0:19:48.66,Chat,,0,0,0,,Сіз де абай болғаныңыз жөн.
Dialogue: 0,0:19:48.66,0:19:52.81,Chat,,0,0,0,,Долларға да, сары орамалға да енген жігіттер бар сияқты.
Dialogue: 0,0:19:53.03,0:20:00.79,Chat,,0,0,0,,Егер мен бұған біздің қатысымыз жоқ деген сөзді таратсам, олар оны сары орамалдарға беруі мүмкін.
Dialogue: 0,0:19:53.20,0:19:54.18,*Default-ja,NTP,0,0,0,,Саған үйрететін кез келді
Dialogue: 0,0:19:54.49,0:19:57.39,*Default-ja,NTP,0,0,0,,Егер біз долларға қатысымыз жоқ екенін айтсақ,
Dialogue: 0,0:19:57.76,0:20:00.87,*Default-ja,NTP,0,0,0,,Мүмкін ол кісі Сары тақияларға айтар.
Dialogue: 0,0:20:01.12,0:20:03.75,Chat,,0,0,0,,Егер бұл шынымен доллардың жұмысы болмаса, яғни.
Dialogue: 0,0:20:05.34,0:20:10.89,Chat,,0,0,0,,Долларда ешқандай ережелер жоқ, және бұл сіз әркімнің әрекетін басқаратын сияқты емес.
Dialogue: 0,0:20:05.66,0:20:07.33,*Default-ja,NTP,0,0,0,,Долларға қатысты ережелер жоқ.
Dialogue: 0,0:20:07.73,0:20:10.38,*Default-ja,NTP,0,0,0,,Сіз де әркімнің әрекетін басқара алмайсыз.
Dialogue: 0,0:20:11.18,0:20:12.92,Chat,,0,0,0,,Сіз іздемегенде...
Dialogue: 0,0:20:12.92,0:20:14.47,Chat,,0,0,0,,...доллардың кейбір мүшесі...
Dialogue: 0,0:20:14.47,0:20:16.65,Chat,,0,0,0,,...Slasher болуы мүмкін еді.
Dialogue: 0,0:20:19.16,0:20:21.79,Chat,,0,0,0,,Басқаша айтқанда, бұл доллар жүйесі.
Dialogue: 0,0:20:19.23,0:20:21.75,*Default-ja,NTP,0,0,0,,Демек, бұл доллар жүйесі.
Dialogue: 0,0:20:21.79,0:20:24.35,Chat,,0,0,0,,Сіз осы жаққа келуді жоспарлап жатсаңыз...
Dialogue: 0,0:20:22.02,0:20:24.57,*Default-ja,NTP,0,0,0,,«Осы жаққа» осылай келуді жоспарласаңыз...
Dialogue: 0,0:20:25.01,0:20:27.36,Chat,,0,0,0,,Дайын болғаныңыз жөн.
Dialogue: 0,0:20:28.57,0:20:30.15,Chat,,0,0,0,,Мен мұны жүрегіммен қабылдаймын.
Dialogue: 0,0:20:39.06,0:20:40.03,Dialogue,,0,0,0,,«Таң.
Dialogue: 0,0:20:39.33,0:20:40.25,*Default-ja,NTP,0,0,0,,Қайырлы таң
Dialogue: 0,0:20:41.06,0:20:42.08,Dialogue,,0,0,0,,«Таңертең!
Dialogue: 0,0:20:41.39,0:20:42.35,*Default-ja,NTP,0,0,0,,Қайырлы таң
Dialogue: 0,0:20:43.39,0:20:44.64,Dialogue,,0,0,0,,Қайырлы таң.
Dialogue: 0,0:20:43.61,0:20:44.84,*Default-ja,NTP,0,0,0,,Қайырлы таң
Dialogue: 0,0:20:44.64,0:20:47.61,Dialogue,,0,0,0,,Не болды? Сіз тым жақсы емессіз.
Dialogue: 0,0:20:44.91,0:20:47.48,*Default-ja,NTP,0,0,0,,Не болды? Мен өзімді жақсы сезінбейтін сияқтымын.
Dialogue: 0,0:20:47.61,0:20:49.47,Dialogue,,0,0,0,,Мүмкін толық қалпына келмеген шығарсыз...?
Dialogue: 0,0:20:47.76,0:20:49.38,*Default-ja,NTP,0,0,0,,Өзіңізді әлі де жақсы сезінбейсіз бе?
Dialogue: 0,0:20:50.19,0:20:52.80,Dialogue,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:20:50.31,0:20:52.52,*Default-ja,NTP,0,0,0,,Жоқ, бұл дұрыс емес.
Dialogue: 0,0:20:52.80,0:20:53.56,Dialogue,,0,0,0,,«Таң.
Dialogue: 0,0:20:52.98,0:20:53.57,*Default-ja,NTP,0,0,0,,Қайырлы таң
Dialogue: 0,0:20:53.56,0:20:54.80,Dialogue,,0,0,0,,О, таң.
Dialogue: 0,0:20:54.13,0:20:54.98,*Default-ja,NTP,0,0,0,,Қайырлы таң
Dialogue: 0,0:20:54.80,0:20:59.63,Dialogue,,0,0,0,,Иә, мен Киданы вокзалда кездестірдім, ол бүгін сабаққа келмейтінін айтты.
Dialogue: 0,0:20:55.67,0:20:58.23,*Default-ja,NTP,0,0,0,,Мен Киданы вокзал алдында кездестірдім.
Dialogue: 0,0:20:58.44,0:20:59.76,*Default-ja,NTP,0,0,0,,Себебі мен бүгін демаламын
Dialogue: 0,0:20:59.63,0:21:01.17,Dialogue,,0,0,0,,А? Неліктен?
Dialogue: 0,0:20:59.84,0:21:01.17,*Default-ja,NTP,0,0,0,,Неліктен?
Dialogue: 0,0:21:01.17,0:21:03.77,Dialogue,,0,0,0,,Мен білмеймін. Ол маған айтқан жоқ.
Dialogue: 0,0:21:01.33,0:21:03.69,*Default-ja,NTP,0,0,0,,Келіңіздер ме? Неге екенін айтпадым
Dialogue: 0,0:21:03.77,0:21:04.88,Dialogue,,0,0,0,,Б... бір сызық
Dialogue: 0,0:21:04.11,0:21:04.94,*Default-ja,NTP,0,0,0,,Сонымен...
Dialogue: 0,0:21:04.88,0:21:05.77,Dialogue,,0,0,0,,Кездескенше.
Dialogue: 0,0:21:05.05,0:21:05.83,*Default-ja,NTP,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:21:05.77,0:21:08.28,Dialogue,,0,0,0,,О... Рахмет!
Dialogue: 0,0:21:07.03,0:21:08.06,*Default-ja,NTP,0,0,0,,Рахмет
Dialogue: 0,0:21:08.28,0:21:11.12,Dialogue,,0,0,0,,Өткеннен қашып құтыла алмайсың, Масаоми.
Dialogue: 0,0:21:08.61,0:21:11.06,*Default-ja,NTP,0,0,0,,Масаоми өткен өмірінен қашып құтыла алмайды.
Dialogue: 0,0:21:11.12,0:21:14.81,Dialogue,,0,0,0,,Сіз өткенге қатысты бірдеңе туралы уайымдап жатырсыз, солай емес пе?
Dialogue: 0,0:21:11.39,0:21:15.06,*Default-ja,NTP,0,0,0,,Сіздің қазір уайымдап отырғаныңыздың себебі ол сіздің өткеніңізбен байланысты, солай ма?
Dialogue: 0,0:21:16.57,0:21:20.27,Dialogue,,0,0,0,,Егер сіз одан қаша алмасаңыз, онда сіз онымен бетпе-бет келіп, оны ұруыңыз керек.
Dialogue: 0,0:21:17.01,0:21:20.07,*Default-ja,NTP,0,0,0,,Қашып кете алмасаң, онымен күресіп, жең.
Dialogue: 0,0:21:20.27,0:21:24.94,Dialogue,,0,0,0,,Егер мен де сенің өткеніңмен күресу арқылы бәрін реттей алсам...
Dialogue: 0,0:21:20.57,0:21:24.83,*Default-ja,NTP,0,0,0,,Сенімен жекпе-жек өткізіп, өткенімді шешсем ғой.
Dialogue: 0,0:21:24.94,0:21:26.13,Dialogue,,0,0,0,,Мен ұнатамын.
Dialogue: 0,0:21:25.17,0:21:26.52,*Default-ja,NTP,0,0,0,,Мен қалаймын.
Dialogue: 0,0:21:26.91,0:21:28.46,Dialogue,,0,0,0,,Неге алмайсың?
Dialogue: 0,0:21:27.05,0:21:28.39,*Default-ja,NTP,0,0,0,,Неліктен мұны істей алмайсың?
Dialogue: 0,0:21:29.28,0:21:32.76,Dialogue,,0,0,0,,Саки, сенімен күресу мүмкін емес.
Dialogue: 0,0:21:29.39,0:21:32.87,*Default-ja,NTP,0,0,0,,Сакимен күресу мүмкін емес.
Dialogue: 0,0:21:33.58,0:21:36.30,Thought,,0,0,0,,Ол жай ғана өзіне тиесілі жерді қалады.
Dialogue: 0,0:21:33.79,0:21:35.70,*Default-ja,NTP,0,0,0,,Мен жай ғана қалғым келді.
Dialogue: 0,0:21:36.30,0:21:40.56,Thought,,0,0,0,,Ол бала күнгі досымен жаңа үйі туралы сөйлескен сайын,
Dialogue: 0,0:21:36.65,0:21:40.65,*Default-ja,NTP,0,0,0,,Бала күнгі досыма жаңа қала туралы айтқан сайын
Dialogue: 0,0:21:40.56,0:21:45.07,Thought,,0,0,0,,ол қаланың қол-аяғымен жабылған өзінің бар екеніне алаңдайтын еді.
Dialogue: 0,0:21:41.18,0:21:45.25,*Default-ja,NTP,0,0,0,,Қаладан қарызға киініп, тіршілігіме күмән келтірдім.
Dialogue: 0,0:21:45.55,0:21:47.27,Thought,,0,0,0,,Ол енді түсінді...
Dialogue: 0,0:21:45.76,0:21:47.09,*Default-ja,NTP,0,0,0,,Мен енді түсіндім
Dialogue: 0,0:21:47.27,0:21:51.65,Thought,,0,0,0,,...Сары орамалдар арасында, ол жататын жер...
Dialogue: 0,0:21:47.50,0:21:51.66,*Default-ja,NTP,0,0,0,,Баяғыда «Сары тақиялы қарақшылар» деген топта мен қай жаққа қайтсем екен деп ойладым.
Dialogue: 0,0:21:52.33,0:21:56.41,Thought,,0,0,0,,...Микадзима Саки есімді жалғыз адаммен бірге болды.
Dialogue: 0,0:21:52.43,0:21:56.28,*Default-ja,NTP,0,0,0,,Саки Микашима деген бір ғана адам болды.
Dialogue: 0,0:21:56.41,0:22:03.62,Thought,,0,0,0,,Ал енді оның мотивациясы маңызды досымен жаңа орын тапқанынан туындайды.
Dialogue: 0,0:21:56.61,0:22:00.68,*Default-ja,NTP,0,0,0,,Енді бұл менің жаңа үйім
Dialogue: 0,0:22:00.75,0:22:03.39,*Default-ja,NTP,0,0,0,,Қымбатты дос үшін әрекет ету
Dialogue: 0,0:22:08.94,0:22:12.04,Dialogue,,0,0,0,,Аға, тағы да жаңбыр жауып тұр...
Dialogue: 0,0:22:09.12,0:22:11.68,*Default-ja,NTP,0,0,0,,Тағы да жаңбыр жауып тұр!
Dialogue: 0,0:22:12.04,0:22:13.96,Dialogue,,0,0,0,,Кадота...
Dialogue: 0,0:22:12.30,0:22:13.40,*Default-ja,NTP,0,0,0,,Кадота мырза
Dialogue: 0,0:22:22.50,0:22:23.98,Dialogue,,0,0,0,,Сіз қайтып келдіңіз бе?
Dialogue: 0,0:22:22.81,0:22:23.89,*Default-ja,NTP,0,0,0,,Қайтып келдіңіз бе?
Dialogue: 0,0:22:24.36,0:22:25.66,Dialogue,,0,0,0,,Оған не болды? Ол жалғыз өзі салқынқанды болып жүр.
Dialogue: 0,0:22:24.52,0:22:25.49,*Default-ja,NTP,0,0,0,,Иә
Dialogue: 0,0:22:27.67,0:22:29.74,Dialogue,,0,0,0,,Мен осындамын, сондықтан менде бар.
Dialogue: 0,0:22:28.00,0:22:29.27,*Default-ja,NTP,0,0,0,,Өйткені мұнда...
Dialogue: 0,0:24:00.32,0:24:02.58,Dialogue,,0,0,0,,Бірде бір ұлы тұлға: «Дүние – ақыл-ойдың құрылымы» деген екен.
Dialogue: 0,0:24:00.49,0:24:02.89,*Default-ja,NTP,0,0,0,,«Дүние – өтірік» деген ұлы тұлға.
Dialogue: 0,0:24:02.58,0:24:04.96,Dialogue,,0,0,0,,Бірде бір ұлы тұлға: «Дүние – нышан» деген екен.
Dialogue: 0,0:24:02.92,0:24:05.23,*Default-ja,NTP,0,0,0,,«Дүние – нышан» деген ұлы адам.
Dialogue: 0,0:24:04.96,0:24:07.49,Dialogue,,0,0,0,,Жиренішті өткен - сіздің қиялыңыздың жемісі.
Dialogue: 0,0:24:05.29,0:24:07.46,*Default-ja,NTP,0,0,0,,Жағымсыз өткен – адасушылықтың туындысы
Dialogue: 0,0:24:07.49,0:24:09.43,Dialogue,,0,0,0,,Бұл шындық ешқашан болған емес.
Dialogue: 0,0:24:07.52,0:24:09.51,*Default-ja,NTP,0,0,0,,Бұл шындық ешқашан болған емес.
Dialogue: 0,0:24:09.43,0:24:11.04,Dialogue,,0,0,0,,Бұл жеткілікті жақсы емес пе?
Dialogue: 0,0:24:09.54,0:24:10.83,*Default-ja,NTP,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:24:11.04,0:24:13.94,Dialogue,,0,0,0,,Келесі жолы: Сары әулет көтеріледі.
Dialogue: 0,0:24:16.31,0:24:21.47,staff,NTP,0,0,0,,Өндіріс: lastzzz akira Демалыс бұлты Акира
