Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:08.01,0:01:10.70,Dialogue,,0,0,0,,Оны қорлауда. Және мүлдем клишеленген түрде.
Dialogue: 0,0:01:08.16,0:01:10.56,*Default-ja,NTP,0,0,0,,Қорқыту және өте қатыгездік
Dialogue: 0,0:01:10.70,0:01:12.55,Dialogue,,0,0,0,,Мен оңға бұрыламын!
Dialogue: 0,0:01:10.83,0:01:12.81,*Default-ja,NTP,0,0,0,,Оңға бұрылыңыз!
Dialogue: 0,0:01:13.00,0:01:17.71,Dialogue,,0,0,0,,Неліктен бізге көмектесуге көмектесіп жатқан адам эксперименттері туралы айтпайсыз?
Dialogue: 0,0:01:13.03,0:01:14.91,*Default-ja,NTP,0,0,0,,Енді мен сенен бірнәрсе сұрайын.
Dialogue: 0,0:01:15.07,0:01:17.92,*Default-ja,NTP,0,0,0,,Сіз басқаратын адам эксперименті туралы әңгіме.
Dialogue: 0,0:01:17.71,0:01:20.62,Dialogue,,0,0,0,,Мен болдым. Бұл сөзсіз мен болдым.
Dialogue: 0,0:01:17.95,0:01:20.20,*Default-ja,NTP,0,0,0,,Бұл менмін, мен сенімдімін.
Dialogue: 0,0:01:20.58,0:01:22.98,*Default-ja,NTP,0,0,0,,Мен қайда жүгірдім?
Dialogue: 0,0:01:20.62,0:01:22.88,Dialogue,,0,0,0,,Мен қайда бардым?
Dialogue: 0,0:01:22.88,0:01:25.23,Dialogue,,0,0,0,,Мен сені таптым... махаббатым.
Dialogue: 0,0:01:23.04,0:01:25.47,*Default-ja,NTP,0,0,0,,Мен... махаббатымды таптым
Dialogue: 0,0:01:25.23,0:01:29.43,Dialogue,,0,0,0,,Сылтаулар жеткілікті. Немесе сіз субъект болғыңыз келе ме?
Dialogue: 0,0:01:25.53,0:01:26.93,*Default-ja,NTP,0,0,0,,Сақтау жақсы.
Dialogue: 0,0:01:26.98,0:01:29.75,*Default-ja,NTP,0,0,0,,Әлде сіз материалсыз ба?
Dialogue: 0,0:01:29.43,0:01:32.57,Dialogue,,0,0,0,,Тек басыңыздан бас тартыңыз. Онсыз жақсысың.
Dialogue: 0,0:01:29.82,0:01:30.56,*Default-ja,NTP,0,0,0,,Берілмеңіз
Dialogue: 0,0:01:30.58,0:01:32.81,*Default-ja,NTP,0,0,0,,Басың болмаса, жарайды деп ойлаймын.
Dialogue: 0,0:01:56.08,0:01:59.16,Chat,,0,0,0,,Адамдар әрқашан олар үшін шынымен маңызды нәрсені жоғалтады, солай емес пе?
Dialogue: 0,0:01:59.16,0:02:01.25,Chat,,0,0,0,,Жаңа ғана сатып алған қолшатыр сияқты...
Dialogue: 0,0:02:01.25,0:02:04.14,Chat,,0,0,0,,Сіз әрқашан пластикті ала аласыз...
Dialogue: 0,0:02:04.14,0:02:07.34,Chat,,0,0,0,,Қолшатырларды ұмыту; лотерея ұтып алу туралы не деуге болады?
Dialogue: 0,0:02:07.34,0:02:10.31,Chat,,0,0,0,,Сіз билетті қауіпсіз сақтау үшін алып тастайсыз, содан кейін оны қайда қойғаныңызды ұмытыңыз.
Dialogue: 0,0:02:10.31,0:02:13.81,Chat,,0,0,0,,Сосын іздеген кезде осы керексіз заттардың бәрін табасың.
Dialogue: 0,0:02:13.81,0:02:17.80,Chat,,0,0,0,,Мен әрқашан маңызды нәрселерді жоғалтқандай сезінемін...
Dialogue: 0,0:02:17.80,0:02:19.06,Chat,,0,0,0,,Кеш.
Dialogue: 0,0:02:19.06,0:02:21.58,Chat,,0,0,0,,Бірдеңе іздеп жатыр ма?
Dialogue: 0,0:02:24.17,0:02:26.00,Thought,,0,0,0,,Мен кейде ойлаймын...
Dialogue: 0,0:02:24.34,0:02:25.67,*Default-ja,NTP,0,0,0,,Кейде ойлаймын
Dialogue: 0,0:02:26.96,0:02:32.62,*Default-ja,NTP,0,0,0,,Мен ұйықтап жатсам, сен сонда ояу емессің бе?
Dialogue: 0,0:02:26.99,0:02:32.56,Thought,,0,0,0,,«Мен осында ұйықтап жатқанда, ана жақта ояу емес пе?».
Dialogue: 0,0:02:33.69,0:02:39.38,Thought,,0,0,0,,Мен есте сақтау қабілетім бұлыңғыр болған кезден бастап, уақытты да сезініп тұрғандай сезінемін.
Dialogue: 0,0:02:33.83,0:02:35.67,*Default-ja,NTP,0,0,0,,Менің жадым бұлыңғыр болғаннан кейін
Dialogue: 0,0:02:36.15,0:02:39.67,*Default-ja,NTP,0,0,0,,Уақыт ағымы да бұлыңғыр болып бара жатқандай сезінемін.
Dialogue: 0,0:02:41.70,0:02:43.20,Thought,,0,0,0,,Ол қашан басталды?
Dialogue: 0,0:02:41.76,0:02:42.94,*Default-ja,NTP,0,0,0,,Қашан басталғанын білгім келеді
Dialogue: 0,0:02:43.98,0:02:49.43,Thought,,0,0,0,,Мен енді түсімде өзімді толық көрмеймін.
Dialogue: 0,0:02:44.10,0:02:49.56,*Default-ja,NTP,0,0,0,,Мен енді өзімді бір болуды армандамаймын.
Dialogue: 0,0:02:52.44,0:02:54.39,Thought,,0,0,0,,Мұнда және мұнда ...
Dialogue: 0,0:02:52.58,0:02:54.55,*Default-ja,NTP,0,0,0,,Мұнда және мұнда
Dialogue: 0,0:02:55.67,0:03:00.00,Thought,,0,0,0,,Мұнда жоқ бөлік нені көре алады?
Dialogue: 0,0:02:55.71,0:02:59.78,*Default-ja,NTP,0,0,0,,Ол жақтан мұндағыдан қандай табиғат көрінісін көруге болады?
Dialogue: 0,0:03:00.86,0:03:02.35,Thought,,0,0,0,,Нені қарап тұр?
Dialogue: 0,0:03:00.94,0:03:02.21,*Default-ja,NTP,0,0,0,,Сіз не қарап тұрсыз?
Dialogue: 0,0:03:03.34,0:03:06.74,Thought,,0,0,0,,Қайталанатын түсімде мен сансыз рет көрдім...
Dialogue: 0,0:03:03.62,0:03:06.60,*Default-ja,NTP,0,0,0,,Бір түсінде қайта-қайта
Dialogue: 0,0:03:07.41,0:03:10.58,Thought,,0,0,0,,Мен... анықтауға тырысамын.
Dialogue: 0,0:03:07.59,0:03:10.80,*Default-ja,NTP,0,0,0,,Мен мұны растауға тырысамын
Dialogue: 0,0:03:17.98,0:03:19.20,Thought,,0,0,0,,Дегенмен...
Dialogue: 0,0:03:18.26,0:03:21.52,*Default-ja,NTP,0,0,0,,Бірақ арман әрқашан бірдей
Dialogue: 0,0:03:19.20,0:03:21.62,Thought,,0,0,0,,Арман әрқашан бірдей...
Dialogue: 0,0:03:40.72,0:03:41.59,Dialogue,,0,0,0,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,0:03:57.71,0:03:59.89,Dialogue,,0,0,0,,Селти! Бұл керемет!
Dialogue: 0,0:03:57.78,0:03:59.58,*Default-ja,NTP,0,0,0,,Селти Бұл керемет!
Dialogue: 0,0:03:59.89,0:04:02.76,Dialogue,,0,0,0,,Кеше сен бүгін жұмыс істемеймін дедің ғой, солай ма?
Dialogue: 0,0:04:00.08,0:04:02.95,*Default-ja,NTP,0,0,0,,Юбе Сіз ертең жұмысқа бармаймын дедіңіз ғой, солай ма?
Dialogue: 0,0:04:03.01,0:04:09.00,Dialogue,,0,0,0,,Мен оны жаңа ғана есептедім, бұл сенің 265 күннен кейінгі бірінші демалыс күнің!
Dialogue: 0,0:04:03.45,0:04:08.61,*Default-ja,NTP,0,0,0,,Мен жаңа есептедім, бүгін сенің 265 күннен кейінгі алғашқы мерекең!
Dialogue: 0,0:04:13.78,0:04:15.16,*Default-ja,NTP,0,0,0,,Бұл мұңды жүз.
Dialogue: 0,0:04:13.80,0:04:16.00,Dialogue,,0,0,0,,Бұл өте бақытсыз өрнек.
Dialogue: 0,0:04:16.00,0:04:20.15,Thought,,0,0,0,,Ол үнемі менің бет-әлпетімді осылай оқиды.
Dialogue: 0,0:04:16.16,0:04:20.13,*Default-ja,NTP,0,0,0,,Менің жоқ жүзімнің өңін осылай оқиды.
Dialogue: 0,0:04:24.17,0:04:28.87,Dialogue,,0,0,0,,Түс көру адамның есте сақтау қабілетін ретке келтіру тәсілі деп естідім, бірақ бұл рас па?
Dialogue: 0,0:04:28.87,0:04:31.15,Dialogue,,0,0,0,,Бұл не болды?
Dialogue: 0,0:04:29.21,0:04:30.89,*Default-ja,NTP,0,0,0,,Бұл не? Бұталардан таяқтарға дейін
Dialogue: 0,0:04:31.15,0:04:33.37,Dialogue,,0,0,0,,Адамдар неге армандайды?
Dialogue: 0,0:04:31.30,0:04:33.14,*Default-ja,NTP,0,0,0,,Адамдар неге армандайды?
Dialogue: 0,0:04:33.37,0:04:37.32,Dialogue,,0,0,0,,Осыған қысқаша жауап беру үшін...білмеймін.
Dialogue: 0,0:04:33.50,0:04:35.05,*Default-ja,NTP,0,0,0,,Бұған бір сөзбен жауап беру:
Dialogue: 0,0:04:35.56,0:04:36.97,*Default-ja,NTP,0,0,0,,«Мен білмеймін»
Dialogue: 0,0:04:37.32,0:04:42.38,Dialogue,,0,0,0,,Медицина ғылымы әлі ашпаған көптеген нәрселер бар, әсіресе осы нәрсеге қатысты.
Dialogue: 0,0:04:37.42,0:04:40.37,*Default-ja,NTP,0,0,0,,Медицинада әлі түсінілмейтін көптеген нәрселер бар.
Dialogue: 0,0:04:40.58,0:04:42.33,*Default-ja,NTP,0,0,0,,Әсіресе мұнда.
Dialogue: 0,0:04:42.38,0:04:47.50,Dialogue,,0,0,0,,Біз армандарды REM-мен байланыстырамыз. Ұйқыдағы көздің жылдам қозғалысы кезінде түс көретіні белгілі...
Dialogue: 0,0:04:42.62,0:04:44.20,*Default-ja,NTP,0,0,0,,Түстер туралы айтқанда, Рем
Dialogue: 0,0:04:44.41,0:04:47.72,*Default-ja,NTP,0,0,0,,Көздің жылдам қозғалысы кезінде ұйқыны көретініміз белгілі...
Dialogue: 0,0:04:47.50,0:04:51.37,Dialogue,,0,0,0,,Ол дәрігер. Немесе, дәлірек айтсақ, қара базардың дәрігері.
Dialogue: 0,0:04:47.86,0:04:48.82,*Default-ja,NTP,0,0,0,,Ол дәрігер
Dialogue: 0,0:04:49.29,0:04:51.18,*Default-ja,NTP,0,0,0,,Дәлірек айтқанда, қараңғы дәрігер
Dialogue: 0,0:04:51.37,0:04:54.60,Dialogue,,0,0,0,,Бірақ мен оның қандай жұмыс істейтінін әлі білмеймін.
Dialogue: 0,0:04:51.65,0:04:54.97,*Default-ja,NTP,0,0,0,,Бірақ шындығында мен қандай жұмыс істейтінімді білмеймін.
Dialogue: 0,0:04:55.69,0:05:03.15,Dialogue,,0,0,0,,Ол маған осында тұруға рұқсат берді, сонымен қатар курьер болып жұмыс істеуіме себепші болды.
Dialogue: 0,0:04:55.78,0:04:58.18,*Default-ja,NTP,0,0,0,,Ол маған осында тұруға рұқсат берді.
Dialogue: 0,0:04:58.49,0:05:02.59,*Default-ja,NTP,0,0,0,,Соның арқасында мен одан әрі курьер болып жұмыс істей аламын.
Dialogue: 0,0:05:04.44,0:05:08.22,Dialogue,,0,0,0,,Қалай болғанда да, естеліктердің нақты не екенін білу де мәселе болып табылады.
Dialogue: 0,0:05:04.58,0:05:08.22,*Default-ja,NTP,0,0,0,,Ал, ең алдымен есте сақтау дегеніміз не?
Dialogue: 0,0:05:09.66,0:05:11.03,Dialogue,,0,0,0,,Сіз тыңдайсыз ба?
Dialogue: 0,0:05:09.80,0:05:10.84,*Default-ja,NTP,0,0,0,,Сіз тыңдайсыз ба?
Dialogue: 0,0:05:11.03,0:05:12.78,Dialogue,,0,0,0,,Мен ризамын.
Dialogue: 0,0:05:11.23,0:05:12.45,*Default-ja,NTP,0,0,0,,Мен ризамын.
Dialogue: 0,0:05:13.16,0:05:20.58,Dialogue,,0,0,0,,Оның үстіне, мен жақында ғана байланудың осындай екенін түсіне бастадым.
Dialogue: 0,0:05:13.20,0:05:15.92,*Default-ja,NTP,0,0,0,,Сонымен қатар, біз жалғыз қалғанда,
Dialogue: 0,0:05:16.30,0:05:20.28,*Default-ja,NTP,0,0,0,,Махаббатқа деген сағыныш сезімі осы екенін түсінген шығармын.
Dialogue: 0,0:05:21.42,0:05:22.75,Dialogue,,0,0,0,,Мен сенің жаныңа дүрлігіп бара жатырмын, дірілдеп
Dialogue: 0,0:05:21.55,0:05:22.62,*Default-ja,NTP,0,0,0,,Бірақ…
Dialogue: 0,0:05:22.75,0:05:27.98,Dialogue,,0,0,0,,Сіз өзіңіздің естеліктеріңіз сіздің басыңызда екеніне сенесіз, бірақ біз оны нақты білмейміз.
Dialogue: 0,0:05:22.90,0:05:26.48,*Default-ja,NTP,0,0,0,,Жадыңыз мойныңызда деп сенетін сияқтысыз.
Dialogue: 0,0:05:26.68,0:05:28.05,*Default-ja,NTP,0,0,0,,Мен бұл туралы білмеймін.
Dialogue: 0,0:05:28.76,0:05:30.05,Dialogue,,0,0,0,,Әрине, олар!
Dialogue: 0,0:05:31.63,0:05:34.81,Dialogue,,0,0,0,,Оны былай қойғанда, киіну керек!
Dialogue: 0,0:05:31.79,0:05:33.00,*Default-ja,NTP,0,0,0,,Бұл одан да көп.
Dialogue: 0,0:05:33.08,0:05:34.41,*Default-ja,NTP,0,0,0,,Алдымен киімімізді ауыстырайық.
Dialogue: 0,0:05:34.81,0:05:36.98,Dialogue,,0,0,0,,Біз жолға шығып жатырмыз.
Dialogue: 0,0:05:34.82,0:05:36.48,*Default-ja,NTP,0,0,0,,Бір жерге бірге барайық!
Dialogue: 0,0:05:36.98,0:05:39.00,Dialogue,,0,0,0,,Мен де демалыс күнін аламын.
Dialogue: 0,0:05:37.13,0:05:38.88,*Default-ja,NTP,0,0,0,,Мен де бүгін демалысқа шығамын.
Dialogue: 0,0:05:39.00,0:05:41.48,Dialogue,,0,0,0,,Қараңызшы, мен ұялы телефонымды да өшіремін.
Dialogue: 0,0:05:39.26,0:05:41.31,*Default-ja,NTP,0,0,0,,Жүр, мен де ұялы телефонымды өшіремін.
Dialogue: 0,0:05:43.99,0:05:47.31,Dialogue,,0,0,0,,Мен де модемді шығарамын. Осылайша мен электрондық поштамды міндетті түрде тексермеймін!
Dialogue: 0,0:05:44.03,0:05:47.26,*Default-ja,NTP,0,0,0,,Телефон желісін ажыратыңыз және электрондық поштаңызды ешқашан тексермеңіз!
Dialogue: 0,0:05:47.75,0:05:50.72,Dialogue,,0,0,0,,Жер бетіндегі бейбітшілік. Енді біз қыдыруға көңіл бөле аламыз!
Dialogue: 0,0:05:48.03,0:05:50.38,*Default-ja,NTP,0,0,0,,Дүние тыныш, бұл қызық ойын!
Dialogue: 0,0:05:50.72,0:05:52.71,Dialogue,,0,0,0,,Сонымен, біз қайда баруымыз керек?
Dialogue: 0,0:05:50.85,0:05:52.36,*Default-ja,NTP,0,0,0,,Енді қайда барамыз?
Dialogue: 0,0:05:52.71,0:05:55.15,Dialogue,,0,0,0,,Сүйікті атыңды теңізге мінгізейік пе?
Dialogue: 0,0:05:52.85,0:05:55.07,*Default-ja,NTP,0,0,0,,Сүйікті атыңа мініп мені теңізге апарасың ба?
Dialogue: 0,0:05:55.15,0:05:56.61,Dialogue,,0,0,0,,Әлде ыстық бұлаққа бару керек пе?
Dialogue: 0,0:05:55.27,0:05:56.80,*Default-ja,NTP,0,0,0,,Әлде ыстық бұлақ ба?
Dialogue: 0,0:05:57.30,0:05:58.75,Dialogue,,0,0,0,,Мен ешқайда кеткім келмейді.
Dialogue: 0,0:05:58.99,0:06:00.00,Dialogue,,0,0,0,,Тағы бір қосымша сабақ па, қазірден-ақ?
Dialogue: 0,0:05:59.26,0:06:00.05,*Default-ja,NTP,0,0,0,,Неліктен?
Dialogue: 0,0:06:00.69,0:06:05.00,Dialogue,,0,0,0,,Менің демалыс күнім болғандықтан, маған үнемі қамқорлық жасағаныңыз үшін алғыс білдіру үшін тамақ әзірлегім келеді.
Dialogue: 0,0:06:00.72,0:06:03.73,*Default-ja,NTP,0,0,0,,Демалыс күні болса, күнделікті қолдауларыңыз үшін алғыс айтқым келеді.
Dialogue: 0,0:06:04.02,0:06:05.15,*Default-ja,NTP,0,0,0,,Тамақты дайындау
Dialogue: 0,0:06:05.35,0:06:06.30,Dialogue,,0,0,0,,Үйде пісіру?!
Dialogue: 0,0:06:05.50,0:06:06.51,*Default-ja,NTP,0,0,0,,Үйде пісіру!
Dialogue: 0,0:06:06.78,0:06:09.67,Dialogue,,0,0,0,,Не жегің келеді? Мен бірнеше рецепттерді қарастырамын.
Dialogue: 0,0:06:14.18,0:06:16.35,Dialogue,,0,0,0,,Сезімге батып кеттім, Селти!
Dialogue: 0,0:06:14.41,0:06:16.00,*Default-ja,NTP,0,0,0,,Маған қатты әсер етті, Селти! Хаха! →
Dialogue: 0,0:06:18.01,0:06:19.99,Dialogue,,0,0,0,,Бізде не болуы керек?
Dialogue: 0,0:06:18.12,0:06:19.59,*Default-ja,NTP,0,0,0,,Сіз нені қалайсыз?
Dialogue: 0,0:06:25.80,0:06:28.07,Dialogue,,0,0,0,,Қарызға алғаныңызға көп рахмет.
Dialogue: 0,0:06:25.98,0:06:27.96,*Default-ja,NTP,0,0,0,,Мен шынымен кешірім сұраймын.
Dialogue: 0,0:06:28.53,0:06:29.99,Dialogue,,0,0,0,,Бұл нағыз көмек.
Dialogue: 0,0:06:28.63,0:06:29.80,*Default-ja,NTP,0,0,0,,(Нацуки Субару) Ол қыз неге мұнда? Әлі күндізгі уақыт қой.
Dialogue: 0,0:06:29.99,0:06:31.73,Dialogue,,0,0,0,,Мен бүгін ұйықтадым, сондықтан...
Dialogue: 0,0:06:30.02,0:06:31.84,*Default-ja,NTP,0,0,0,,Мен таңертең біраз ұйықтадым.
Dialogue: 0,0:06:32.22,0:06:34.03,Dialogue,,0,0,0,,Уайымдама, жас жігіт.
Dialogue: 0,0:06:32.25,0:06:33.74,*Default-ja,NTP,0,0,0,,Дон Май жастары
Dialogue: 0,0:06:34.03,0:06:36.82,Dialogue,,0,0,0,,Токиоға көшудің ауыртпалығын сезіне бастаған кез келді.
Dialogue: 0,0:06:34.10,0:06:37.11,*Default-ja,NTP,0,0,0,,Токиоға келудің шаршау уақыты жақындап қалды.
Dialogue: 0,0:06:36.84,0:06:41.02,Dialogue,,0,0,0,,Негізі бұл сізге қыз алудың тамаша мүмкіндігі!
Dialogue: 0,0:06:37.25,0:06:40.72,*Default-ja,NTP,0,0,0,,Мұндай жағдайда бұл аңшының мүмкіндігі!
Dialogue: 0,0:06:41.02,0:06:45.91,Dialogue,,0,0,0,,Жаныңдағы тамаша қызға жақындап, оқулығыңды көрсін.
Dialogue: 0,0:06:41.51,0:06:44.13,*Default-ja,NTP,0,0,0,,Жанымдағы сүйкімді қызбен иық тірестіру
Dialogue: 0,0:06:44.15,0:06:45.85,*Default-ja,NTP,0,0,0,,Оқулықты көрсетуімді өтініңіз~
Dialogue: 0,0:06:45.91,0:06:48.79,Dialogue,,0,0,0,,Ал бұл не? «Галстук жоқ» деген әдейі жасалған нәрсе ме?
Dialogue: 0,0:06:46.07,0:06:49.60,*Default-ja,NTP,0,0,0,,Сонымен не? Галстук батыл ба? Бұл да?
Dialogue: 0,0:06:48.79,0:06:49.51,Dialogue,,0,0,0,,Бұл да?
Dialogue: 0,0:06:51.02,0:06:52.35,Dialogue,,0,0,0,,Қандай сәнсіз...
Dialogue: 0,0:06:51.09,0:06:54.21,*Default-ja,NTP,0,0,0,,Амансың ба? Әмияныңызды ұмытып қалдыңыз ба?
Dialogue: 0,0:06:52.35,0:06:54.30,Dialogue,,0,0,0,,Сіз әмияныңызды да ұмытқан жоқсыз, солай ма?
Dialogue: 0,0:06:54.50,0:06:56.08,Dialogue,,0,0,0,,Мен алмадым...
Dialogue: 0,0:06:54.87,0:06:55.78,*Default-ja,NTP,0,0,0,,Мүмкін емес...
Dialogue: 0,0:06:56.08,0:06:57.85,Dialogue,,0,0,0,,Иә? Не?
Dialogue: 0,0:06:56.50,0:06:59.62,*Default-ja,NTP,0,0,0,,Иә? иә? иә? Уф...
Dialogue: 0,0:06:58.37,0:06:59.85,Dialogue,,0,0,0,,Иә!?
Dialogue: 0,0:07:09.34,0:07:11.11,Dialogue,,0,0,0,,Бұл жақсы. Бұл орысша
Dialogue: 0,0:07:09.43,0:07:10.96,*Default-ja,NTP,0,0,0,,Бұл дәмді~ «Русиазуши»…
Dialogue: 0,0:07:10.83,0:07:11.98,Secondary,,0,0,0,,Саймон!
Dialogue: 0,0:07:10.96,0:07:13.80,*Default-ja,NTP,0,0,0,,Саймон Эй, сен Юматчиді көрмедің бе?
Dialogue: 0,0:07:11.98,0:07:13.81,Dialogue,,0,0,0,,Юма-чиді көрдіңіз бе?
Dialogue: 0,0:07:13.81,0:07:16.68,Dialogue,,0,0,0,,Ой, Карисава, сен суши жегің келе ме?
Dialogue: 0,0:07:13.87,0:07:16.52,*Default-ja,NTP,0,0,0,,О~ Каризава: Суши жегің келе ме?
Dialogue: 0,0:07:16.68,0:07:18.15,Dialogue,,0,0,0,,Жоқ, менде жоқ.
Dialogue: 0,0:07:16.82,0:07:18.55,*Default-ja,NTP,0,0,0,,Ондай нәрсе жоқ.
Dialogue: 0,0:07:19.01,0:07:21.03,Dialogue,,0,0,0,,Мұнда емес, иә...
Dialogue: 0,0:07:19.22,0:07:20.28,*Default-ja,NTP,0,0,0,,Ондай емес пе...
Dialogue: 0,0:07:19.57,0:07:22.67,Secondary,,0,0,0,,Ауа райы жағдайында менеджердің сезімі.
Dialogue: 0,0:07:21.03,0:07:24.85,Dialogue,,0,0,0,,Бүгін Денгекінің қалталы Accel World басылымы сатылымға шыққан бірінші күн.
Dialogue: 0,0:07:21.16,0:07:24.58,*Default-ja,NTP,0,0,0,,Бүгін Денгеки Бунконың «Accel World» фильмінің шығу күні емес пе?
Dialogue: 0,0:07:23.68,0:07:26.84,Secondary,,0,0,0,,Бірақ оның жағдайы жақсы. Ол біраз дәрі қабылдады.
Dialogue: 0,0:07:24.83,0:07:26.18,*Default-ja,NTP,0,0,0,,Оны екі адамға алыңыз
Dialogue: 0,0:07:24.86,0:07:28.47,Dialogue,,0,0,0,,Бірге сатып алуға бардық, шай іштік, сосын қоштастық...
Dialogue: 0,0:07:26.45,0:07:28.46,*Default-ja,NTP,0,0,0,,Шай ішіп, рахмет айт
Dialogue: 0,0:07:27.53,0:07:29.65,Secondary,,0,0,0,,Бірақ ол бүгін балық базарына бара алмады...
Dialogue: 0,0:07:27.80,0:07:31.60,*Default-ja,NTP,0,0,0,,Мен ештеңе сатып алуға бара алмадым. Менде ешқандай материал жоқ.
Dialogue: 0,0:07:28.47,0:07:32.54,Dialogue,,0,0,0,,Сол кезде кафедегі қызметші қыз маған ұялы телефонды беруге жүгіріп келді.
Dialogue: 0,0:07:28.61,0:07:31.73,*Default-ja,NTP,0,0,0,,Сол кезде дүкендегі қызметші қыз мені қуып келді...
Dialogue: 0,0:07:29.65,0:07:31.26,Secondary,,0,0,0,,Демек, ештеңе жоқ.
Dialogue: 0,0:07:31.93,0:07:33.90,*Default-ja,NTP,0,0,0,,Ұялы телефон Бұл Юмачи...
Dialogue: 0,0:07:32.00,0:07:34.03,Secondary,,0,0,0,,Біз қазір іздеп жатырмыз.
Dialogue: 0,0:07:32.21,0:07:33.95,*Default-ja,NTP,0,0,0,,Мен қазір бірдеңе іздеп жүрмін.
Dialogue: 0,0:07:32.55,0:07:34.03,Dialogue,,0,0,0,,Бұл Юма-чидікі, сондықтан...
Dialogue: 0,0:07:34.03,0:07:35.85,Dialogue,,0,0,0,,А? Содан кейін тұтынушыларды тартуға тырыспаңыз!
Dialogue: 0,0:07:34.13,0:07:36.09,*Default-ja,NTP,0,0,0,,Иә? Содан кейін тұтынушыларды тартпаңыз
Dialogue: 0,0:07:35.85,0:07:37.84,Dialogue,,0,0,0,,Сәлеметсіз бе. Кешіріңіз.
Dialogue: 0,0:07:36.10,0:07:37.85,*Default-ja,NTP,0,0,0,,Сәлеметсіз бе! Сумимасен
Dialogue: 0,0:07:37.84,0:07:39.97,Dialogue,,0,0,0,,Сіз не іздеп жүрсіз?
Dialogue: 0,0:07:37.99,0:07:40.16,*Default-ja,NTP,0,0,0,,Сіз не іздеп жүрсіз?
Dialogue: 0,0:07:39.97,0:07:41.12,Dialogue,,0,0,0,,Мен айттым -
Dialogue: 0,0:07:40.17,0:07:41.25,*Default-ja,NTP,0,0,0,,Сонымен Юмачи!
Dialogue: 0,0:07:41.55,0:07:42.47,Dialogue,,0,0,0,,М-мен бұған енді маңызды емес дедім!
Dialogue: 0,0:07:41.75,0:07:42.58,*Default-ja,NTP,0,0,0,,Who?
Dialogue: 0,0:07:44.52,0:07:46.11,Dialogue,,0,0,0,,«Адамдар іздейтін нәрселер?»
Dialogue: 0,0:07:44.72,0:07:46.09,*Default-ja,NTP,0,0,0,,«Бірдеңе іздейсің»?
Dialogue: 0,0:07:46.11,0:07:49.87,Dialogue,,0,0,0,,Іздегеніңізді осында жазыңыз.
Dialogue: 0,0:07:46.45,0:07:50.04,*Default-ja,NTP,0,0,0,,Іздегеніңізді осында жазыңыз.
Dialogue: 0,0:07:49.87,0:07:51.01,Dialogue,,0,0,0,,Айтыңызшы.
Dialogue: 0,0:07:50.16,0:07:51.20,*Default-ja,NTP,0,0,0,,Үйрет бізге.
Dialogue: 0,0:07:53.65,0:07:56.70,Dialogue,,0,0,0,,Сіз күні бойы осында боласыз ба?
Dialogue: 0,0:07:53.66,0:07:56.49,*Default-ja,NTP,0,0,0,,Сіз бұл жерде үнемі осылай істейсіз бе?
Dialogue: 0,0:07:56.70,0:07:59.00,Dialogue,,0,0,0,,Мен барлығынан сұраймын.
Dialogue: 0,0:07:56.87,0:07:59.37,*Default-ja,NTP,0,0,0,,Барлығы Күннен сұрайды.
Dialogue: 0,0:08:05.21,0:08:06.24,Dialogue,,0,0,0,,Менің ұяшықым!
Dialogue: 0,0:08:05.41,0:08:06.33,*Default-ja,NTP,0,0,0,,Ұялы телефон!
Dialogue: 0,0:08:07.62,0:08:09.49,Dialogue,,0,0,0,,Сізді қайтарғанымызға қуаныштымыз.
Dialogue: 0,0:08:07.66,0:08:09.43,*Default-ja,NTP,0,0,0,,Қолымды ұсташы, өтінемін. Әрқашан істейтіндей.
Dialogue: 0,0:08:13.43,0:08:16.73,Thought,,0,0,0,,Мен не іздеймін?
Dialogue: 0,0:08:13.60,0:08:16.72,*Default-ja,NTP,0,0,0,,Мен не іздеп жүрмін деп ойлаймын
Dialogue: 0,0:08:17.55,0:08:19.95,Thought,,0,0,0,,Мен Казтаноның жақсы болғанына қуаныштымын.
Dialogue: 0,0:08:17.67,0:08:19.68,*Default-ja,NTP,0,0,0,,Мен Казутаноның қауіпсіз болғанына қуаныштымын.
Dialogue: 0,0:08:19.95,0:08:25.00,Thought,,0,0,0,,Мен Карисава мен Юмасакиге тергеуге бармаймыз деп уәде бердім.
Dialogue: 0,0:08:20.12,0:08:21.76,*Default-ja,NTP,0,0,0,,Барлау жақсы.
Dialogue: 0,0:08:22.19,0:08:24.81,*Default-ja,NTP,0,0,0,,Мен Каризава мен Юмасакиге уәде берсем де
Dialogue: 0,0:08:26.61,0:08:28.25,Thought,,0,0,0,,Yagiri Pharmaceuticals...
Dialogue: 0,0:08:26.70,0:08:28.25,*Default-ja,NTP,0,0,0,,«Yagiri Pharmaceutical»…
Dialogue: 0,0:08:28.90,0:08:35.53,Thought,,0,0,0,,Оның сахна артында Awakusu қауымдастығымен қатысы бар және Солтүстік Американың Nebula фирмасымен байланысы бар деген қауесет бар.
Dialogue: 0,0:08:28.97,0:08:31.29,*Default-ja,NTP,0,0,0,,Сахна артында Авакусу-каймен байланыс бар сияқты.
Dialogue: 0,0:08:31.43,0:08:34.88,*Default-ja,NTP,0,0,0,,Солтүстік Американың «Nebula» компаниясымен де байланысты деген қауесет бар.
Dialogue: 0,0:08:36.00,0:08:40.99,Thought,,0,0,0,,Бірақ мен мұны істеу арқылы ештеңе таба алмаймын.
Dialogue: 0,0:08:36.51,0:08:41.10,*Default-ja,NTP,0,0,0,,Бірақ, мен мұндай нәрсені таба алмаймын деп ойлаймын.
Dialogue: 0,0:09:09.30,0:09:11.14,Dialogue,,0,0,0,,Сіз Карисаваны көрдіңіз бе?
Dialogue: 0,0:09:09.44,0:09:10.90,*Default-ja,NTP,0,0,0,,Каризава мырза, сіз көрмедіңіз бе?
Dialogue: 0,0:09:11.45,0:09:13.02,Dialogue,,0,0,0,,Менде жоқ.
Dialogue: 0,0:09:11.62,0:09:12.73,*Default-ja,NTP,0,0,0,,Жоқ!
Dialogue: 0,0:09:13.02,0:09:14.71,Dialogue,,0,0,0,,Б... бір сызық
Dialogue: 0,0:09:13.10,0:09:14.11,*Default-ja,NTP,0,0,0,,Сонымен...
Dialogue: 0,0:09:14.71,0:09:17.60,Dialogue,,0,0,0,,Ресейлік суши туралы не айтасыз?
Dialogue: 0,0:09:14.86,0:09:17.37,*Default-ja,NTP,0,0,0,,Енді «Русиазуши» ше?
Dialogue: 0,0:09:26.37,0:09:29.98,Dialogue,,0,0,0,,Селти! Оны кәдімгі пышақпен кесіп тастаңыз ... қалыпты жағдайда.
Dialogue: 0,0:09:26.38,0:09:29.82,*Default-ja,NTP,0,0,0,,Селти! Оны әдеттегідей пышақпен кесеміз.
Dialogue: 0,0:09:34.33,0:09:36.55,Dialogue,,0,0,0,,Дәмді! Мүлдем дәмді!
Dialogue: 0,0:09:34.52,0:09:36.59,*Default-ja,NTP,0,0,0,,Дәмді Бұл дәмді!
Dialogue: 0,0:09:37.77,0:09:39.31,*Default-ja,NTP,0,0,0,,Иә, бұл дәмді.
Dialogue: 0,0:09:38.42,0:09:39.09,Dialogue,,0,0,0,,Дәмді.
Dialogue: 0,0:09:41.56,0:09:43.54,Dialogue,,0,0,0,,Күтіңіз. Неге жылайсың?
Dialogue: 0,0:09:41.67,0:09:43.70,*Default-ja,NTP,0,0,0,,Күт, сен неге жылайсың?
Dialogue: 0,0:09:44.00,0:09:45.45,Dialogue,,0,0,0,,Хм? мен жылап жатырмын?
Dialogue: 0,0:09:44.47,0:09:45.31,*Default-ja,NTP,0,0,0,,Сіз жылап жатырсыз ба?
Dialogue: 0,0:09:45.45,0:09:47.68,Dialogue,,0,0,0,,Мен жай ғана эмоцияға ие болдым.
Dialogue: 0,0:09:46.25,0:09:49.32,*Default-ja,NTP,0,0,0,,Жоқ... Мен қатты әсерлендім, бұл керемет.
Dialogue: 0,0:09:47.68,0:09:49.65,Dialogue,,0,0,0,,Мұның бәрі өте керемет.
Dialogue: 0,0:09:49.65,0:09:53.56,Dialogue,,0,0,0,,Бұл керемет тәтті түйежапырақ тамыры, мисо сорпасының ащы тұзды дәмі...
Dialogue: 0,0:09:49.89,0:09:51.52,*Default-ja,NTP,0,0,0,,Бұл өте тәтті Кинпира
Dialogue: 0,0:09:51.75,0:09:53.36,*Default-ja,NTP,0,0,0,,Мисо сорпасының ащы және тұздылығы
Dialogue: 0,0:09:53.56,0:09:55.18,Dialogue,,0,0,0,,Бірдеңе өшіп қалды.
Dialogue: 0,0:09:53.80,0:09:54.90,*Default-ja,NTP,0,0,0,,Біртүрлі нәрсе.
Dialogue: 0,0:09:55.18,0:09:59.94,Dialogue,,0,0,0,,Жоқ, сіздің тағамыңыз жаңа және түпнұсқа, дәл сіз сияқты!
Dialogue: 0,0:09:55.38,0:09:57.98,*Default-ja,NTP,0,0,0,,Жоқ, сіздің тағам әзірлеуіңіз жаңашыл.
Dialogue: 0,0:09:58.48,0:09:59.96,*Default-ja,NTP,0,0,0,,Дәл сіз сияқты!
Dialogue: 0,0:10:01.03,0:10:02.60,Dialogue,,0,0,0,,Бұл мақтау емес!
Dialogue: 0,0:10:01.10,0:10:02.83,*Default-ja,NTP,0,0,0,,Бұл мақтау емес
Dialogue: 0,0:10:03.03,0:10:06.20,Dialogue,,0,0,0,,Мен түсіндім. Мен оны дұрыс дәмдете алмадым.
Dialogue: 0,0:10:03.32,0:10:05.76,*Default-ja,NTP,0,0,0,,Жарайды, мен дәмдеуішті тағы да шатастырдым.
Dialogue: 0,0:10:06.20,0:10:07.99,Dialogue,,0,0,0,,Бұл жеткілікті. Сіз оны асыра пайдаланудың қажеті жоқ!
Dialogue: 0,0:10:06.23,0:10:08.16,*Default-ja,NTP,0,0,0,,Жетеді! Өзіңізді тамақ ішуге мәжбүрлемеңіз!
Dialogue: 0,0:10:08.59,0:10:12.20,Dialogue,,0,0,0,,Нені асыра орындаңыз? Бұл шынымен жақсы.
Dialogue: 0,0:10:08.70,0:10:10.12,*Default-ja,NTP,0,0,0,,Не мүмкін емес?
Dialogue: 0,0:10:10.44,0:10:11.69,*Default-ja,NTP,0,0,0,,Өте дәмді болса да
Dialogue: 0,0:10:12.63,0:10:14.03,Dialogue,,0,0,0,,«Жеме!» дедім.
Dialogue: 0,0:10:18.99,0:10:20.00,Dialogue,,0,0,0,,Не істеп жатырсың?!
Dialogue: 0,0:10:19.19,0:10:20.23,*Default-ja,NTP,0,0,0,,Не істеп жатырсың!
Dialogue: 0,0:10:28.82,0:10:30.48,Dialogue,,0,0,0,,Бұл не болып жатыр?
Dialogue: 0,0:10:28.99,0:10:30.37,*Default-ja,NTP,0,0,0,,Не болып жатыр? Бұл
Dialogue: 0,0:10:31.12,0:10:34.99,Dialogue,,0,0,0,,Сізде ас әзірлеуге қабілет бар.
Dialogue: 0,0:10:31.30,0:10:34.63,*Default-ja,NTP,0,0,0,,Ей, сенің ас әзірлеуге қабілетің бар екені сөзсіз.
Dialogue: 0,0:10:35.43,0:10:38.38,Dialogue,,0,0,0,,Бұл не? Тіпті қарбыз жасушалары жоқ сияқты.
Dialogue: 0,0:10:35.48,0:10:38.06,*Default-ja,NTP,0,0,0,,Немене, қарбыз ұяшықтары жоқ...
Dialogue: 0,0:10:39.98,0:10:41.61,Dialogue,,0,0,0,,Не? Қарбыз?
Dialogue: 0,0:10:40.09,0:10:42.03,*Default-ja,NTP,0,0,0,,Не? Қарбыз?
Dialogue: 0,0:10:42.31,0:10:44.02,Dialogue,,0,0,0,,Бұл сіздің дәм сезуіңізге қатысты.
Dialogue: 0,0:10:42.38,0:10:43.64,*Default-ja,NTP,0,0,0,,Дәм
Dialogue: 0,0:10:44.02,0:10:48.49,Dialogue,,0,0,0,,Ми сіздің ДНҚ-ға енбеген дәмдерді түсінбейді.
Dialogue: 0,0:10:44.23,0:10:48.49,*Default-ja,NTP,0,0,0,,ДНҚ-да жазылмаған дәмдерді ми түсіне алмайды.
Dialogue: 0,0:10:49.44,0:10:53.37,Dialogue,,0,0,0,,Дегенмен, сізде тамақтанудың қажеті жоқ және сіздің миыңыз қатыспайды.
Dialogue: 0,0:10:49.47,0:10:51.29,*Default-ja,NTP,0,0,0,,Сізге тамақ ішудің қажеті жоқ.
Dialogue: 0,0:10:51.54,0:10:53.19,*Default-ja,NTP,0,0,0,,Мидың да қатысы жоқ сияқты.
Dialogue: 0,0:10:56.00,0:10:57.62,*Default-ja,NTP,0,0,0,,Иә, көңіліңді түсірме.
Dialogue: 0,0:10:56.01,0:10:57.59,Dialogue,,0,0,0,,Көңіліңді түсірме.
Dialogue: 0,0:10:58.73,0:11:00.50,Dialogue,,0,0,0,,Кәне, ойын ойнайық.
Dialogue: 0,0:10:58.83,0:11:00.89,*Default-ja,NTP,0,0,0,,Әй, ойын ойнасақ қалай болады?
Dialogue: 0,0:11:01.65,0:11:03.74,Dialogue,,0,0,0,,Маған бала сияқты қарама.
Dialogue: 0,0:11:01.98,0:11:03.41,*Default-ja,NTP,0,0,0,,Маған бала сияқты қарама
Dialogue: 0,0:11:03.74,0:11:05.86,Dialogue,,0,0,0,,Мені ең қатты ашуландыратыны осы.
Dialogue: 0,0:11:03.90,0:11:05.69,*Default-ja,NTP,0,0,0,,Мені ең қатты ренжіткені осы.
Dialogue: 0,0:11:05.86,0:11:07.17,Dialogue,,0,0,0,,Мен олай айтқым келген жоқ...
Dialogue: 0,0:11:06.06,0:11:07.25,*Default-ja,NTP,0,0,0,,Шынымен де...
Dialogue: 0,0:11:07.58,0:11:16.00,Dialogue,,0,0,0,,Сіз маған көп нәрсені үйреттіңіз, бірақ менде жүз жыл бұрынғы бұлыңғыр естеліктер бар.
Dialogue: 0,0:11:07.69,0:11:11.35,*Default-ja,NTP,0,0,0,,Маған көп нәрсені үйреткеніңізге сенімдімін, бірақ
Dialogue: 0,0:11:11.62,0:11:13.87,*Default-ja,NTP,0,0,0,,Менің санамда бұлыңғыр қалған естеліктер
Dialogue: 0,0:11:13.99,0:11:15.55,*Default-ja,NTP,0,0,0,,Шамамен 100 жыл бұрынғы бір.
Dialogue: 0,0:11:16.00,0:11:17.60,Dialogue,,0,0,0,,Менің басым көбірек тұруы керек...
Dialogue: 0,0:11:16.36,0:11:17.54,*Default-ja,NTP,0,0,0,,Мойынға көбірек
Dialogue: 0,0:11:18.13,0:11:20.48,Dialogue,,0,0,0,,Сізге жүздеген жылдар бұрынғы естеліктер керек пе?
Dialogue: 0,0:11:18.23,0:11:20.63,*Default-ja,NTP,0,0,0,,Бізге жүздеген жылдық жады керек пе?
Dialogue: 0,0:11:22.30,0:11:23.24,Dialogue,,0,0,0,,Ұзақ жұмыс күнінен кейін бір шыныаяқ сакэ ішуден артық ештеңе жоқ!
Dialogue: 0,0:11:24.01,0:11:26.18,Dialogue,,0,0,0,,Мен оны үнемі айтамын, солай емес пе?
Dialogue: 0,0:11:24.08,0:11:25.86,*Default-ja,NTP,0,0,0,,Сондықтан мен үнемі айтамын.
Dialogue: 0,0:11:26.74,0:11:29.15,Dialogue,,0,0,0,,Сенің қандай болсаң жақсы екеніңді.
Dialogue: 0,0:11:26.79,0:11:29.21,*Default-ja,NTP,0,0,0,,Бұл сіз қандай болсаңыз, солай қала аласыз дегенді білдіреді.
Dialogue: 0,0:11:29.91,0:11:31.15,Dialogue,,0,0,0,,Сен қайдан білер едің?!
Dialogue: 0,0:11:33.81,0:11:37.49,Dialogue,,0,0,0,,Жақында өз бетімді де есіме түсірмеймін!
Dialogue: 0,0:11:40.97,0:11:43.01,Dialogue,,0,0,0,,Күте тұрыңыз! Мен қателестім!
Dialogue: 0,0:11:41.11,0:11:42.85,*Default-ja,NTP,0,0,0,,Күте тұрыңыз! Бұл менің кінәм болды!
Dialogue: 0,0:11:54.23,0:11:55.43,Dialogue,,0,0,0,,Селти?!
Dialogue: 0,0:11:54.35,0:11:57.47,*Default-ja,NTP,0,0,0,,Селти! Сен қайтып келдің!
Dialogue: 0,0:11:55.99,0:11:57.99,Dialogue,,0,0,0,,Үйдесің, солай емес пе?!
Dialogue: 0,0:12:00.60,0:12:06.07,Dialogue,,0,0,0,,Төтенше жағдайда сізбен байланыса алмасақ, бұл біз үшін өте қиын.
Dialogue: 0,0:12:00.89,0:12:02.90,*Default-ja,NTP,0,0,0,,Мен қиындыққа тап болдым, сэр.
Dialogue: 0,0:12:03.43,0:12:06.02,*Default-ja,NTP,0,0,0,,Төтенше жағдай болса да, мен сізбен байланыса алмаймын.
Dialogue: 0,0:12:21.11,0:12:23.51,Dialogue,,0,0,0,,Бірдеңе дұрыс емес пе, Сонохара?
Dialogue: 0,0:12:21.40,0:12:23.32,*Default-ja,NTP,0,0,0,,Сонохара мырза, не болды?
Dialogue: 0,0:12:23.51,0:12:24.62,Dialogue,,0,0,0,,Олар мұнда жоқ.
Dialogue: 0,0:12:23.78,0:12:24.71,*Default-ja,NTP,0,0,0,,Жоқ?
Dialogue: 0,0:12:24.62,0:12:25.53,Dialogue,,0,0,0,,Онда емес пе?
Dialogue: 0,0:12:24.93,0:12:25.75,*Default-ja,NTP,0,0,0,,Жоқ?
Dialogue: 0,0:12:25.53,0:12:26.69,Dialogue,,0,0,0,,Сабаққа қатыса алмайтыны үшін оған ерекше қарайды...
Dialogue: 0,0:12:25.86,0:12:28.88,*Default-ja,NTP,0,0,0,,Не?! Бұл жолы не болып жатқан жоқ? Тэйцзин~
Dialogue: 0,0:12:26.69,0:12:28.84,Dialogue,,0,0,0,,Бұл жолы не болды, Микадо?
Dialogue: 0,0:12:28.99,0:12:31.02,Dialogue,,0,0,0,,Сонохараның аяқ киімі...
Dialogue: 0,0:12:29.30,0:12:31.04,*Default-ja,NTP,0,0,0,,Сонохара мырзаның аяқ киімі...
Dialogue: 0,0:12:31.02,0:12:32.34,Dialogue,,0,0,0,,Бәрі жақсы болады, иә?
Dialogue: 0,0:12:31.31,0:12:33.91,*Default-ja,NTP,0,0,0,,Тағы да~ Бұл қулық.
Dialogue: 0,0:12:32.34,0:12:33.98,Dialogue,,0,0,0,,Қандай сұмдық...
Dialogue: 0,0:12:34.88,0:12:37.94,Dialogue,,0,0,0,,Мен мұндай нәрсені кім жасайтынын білемін деп ойлаймын.
Dialogue: 0,0:12:34.97,0:12:38.23,*Default-ja,NTP,0,0,0,,Мен мұндай істермен айналысатын адамдарды дерлік түсінемін.
Dialogue: 0,0:12:38.31,0:12:39.35,Dialogue,,0,0,0,,Кида?
Dialogue: 0,0:12:38.43,0:12:39.42,*Default-ja,NTP,0,0,0,,Кида-кун?
Dialogue: 0,0:12:39.35,0:12:40.20,Dialogue,,0,0,0,,Жарайды.
Dialogue: 0,0:12:39.65,0:12:40.39,*Default-ja,NTP,0,0,0,,Жарайды!
Dialogue: 0,0:12:40.91,0:12:42.42,*Default-ja,NTP,0,0,0,,Тоқта... Кида-кун!?
Dialogue: 0,0:12:41.06,0:12:42.37,Dialogue,,0,0,0,,Күте тұрыңыз, Кида!
Dialogue: 0,0:12:46.23,0:12:51.74,Dialogue,,0,0,0,,Киданың әрекеті әдеттегіден өзгеше және қорқынышты, иә?
Dialogue: 0,0:12:46.43,0:12:52.06,*Default-ja,NTP,0,0,0,,Кида-кун, сен әдеттегіден басқаша қорқып қалдың.
Dialogue: 0,0:12:52.32,0:12:53.52,Dialogue,,0,0,0,,Мен бір қолымда оқ жалғанған винтовка ұстап тұрмын
Dialogue: 0,0:12:52.34,0:12:53.30,*Default-ja,NTP,0,0,0,,(Изуна) Ә? (Сора) Қашан?
Dialogue: 0,0:12:53.52,0:12:55.03,Dialogue,,0,0,0,,Ол өте жігерлі еді...
Dialogue: 0,0:12:53.64,0:12:56.66,*Default-ja,NTP,0,0,0,,Сіз қиындыққа тап болдыңыз, солай емес пе?
Dialogue: 0,0:12:55.03,0:12:56.65,Dialogue,,0,0,0,,Қандай қиындық, солай ма?
Dialogue: 0,0:13:12.00,0:13:22.98,Dialogue,,0,0,0,,Кішкентай кезімде көп заттарымды жоғалтып алатынмын, анам маған іздеуге көмектесетін болса, «Ол кетті!
Dialogue: 0,0:13:12.38,0:13:15.88,*Default-ja,NTP,0,0,0,,Кішкентай кезімде заттарымды жиі жоғалтып алатынмын.
Dialogue: 0,0:13:16.27,0:13:19.91,*Default-ja,NTP,0,0,0,,Мен басымды тырнап отырып: «Жоқ, жоқ» дедім.
Dialogue: 0,0:13:20.15,0:13:23.00,*Default-ja,NTP,0,0,0,,Анам әрқашан менімен бірге іздейді...
Dialogue: 0,0:13:23.98,0:13:25.35,Dialogue,,0,0,0,,Сенің жақсы анаң бар.
Dialogue: 0,0:13:24.03,0:13:25.46,*Default-ja,NTP,0,0,0,,Сіз мейірімді анасыз.
Dialogue: 0,0:13:25.99,0:13:29.41,Dialogue,,0,0,0,,Иә, анам да, әкем де солай.
Dialogue: 0,0:13:26.27,0:13:29.40,*Default-ja,NTP,0,0,0,,Иә, әке де, шеше де.
Dialogue: 0,0:13:34.49,0:13:35.87,Dialogue,,0,0,0,,Менде бәрі жақсы.
Dialogue: 0,0:13:34.71,0:13:35.84,*Default-ja,NTP,0,0,0,,Қазір бәрі жақсы
Dialogue: 0,0:13:36.25,0:13:38.96,Dialogue,,0,0,0,,Мен қазір үйге барамын.
Dialogue: 0,0:13:36.43,0:13:38.53,*Default-ja,NTP,0,0,0,,Мен үйге осылай бара жатырмын.
Dialogue: 0,0:13:38.96,0:13:43.00,Dialogue,,0,0,0,,Маған іздеуге көмектескеніңіз үшін рахмет, Рюгамин.
Dialogue: 0,0:13:39.13,0:13:42.63,*Default-ja,NTP,0,0,0,,Рюгамин-кун, менімен бірге іздегеніңіз үшін рахмет.
Dialogue: 0,0:13:43.00,0:13:45.00,Dialogue,,0,0,0,,Эх, уф...
Dialogue: 0,0:13:49.22,0:13:52.82,Dialogue,,0,0,0,,Қылмыскерді немесе басқа нәрсені табудың қажеті жоқ, Кида.
Dialogue: 0,0:13:49.48,0:13:50.92,*Default-ja,NTP,0,0,0,,Жетеді, Кида-кун.
Dialogue: 0,0:13:51.17,0:13:52.57,*Default-ja,NTP,0,0,0,,Қылмыстық
Dialogue: 0,0:13:53.44,0:13:56.33,Dialogue,,0,0,0,,Жоқ, Сонохара кетіп қалды.
Dialogue: 0,0:13:53.55,0:13:56.26,*Default-ja,NTP,0,0,0,,Жоқ, Сонохара мырза үйіне кетіп қалды.
Dialogue: 0,0:13:57.21,0:13:59.46,Dialogue,,0,0,0,,А? Мен білмеймін...
Dialogue: 0,0:13:57.35,0:13:59.33,*Default-ja,NTP,0,0,0,,Не? Білмеймін бірақ
Dialogue: 0,0:14:00.40,0:14:03.52,Dialogue,,0,0,0,,Мен? Мен оларды әлі де іздеймін, анық...
Dialogue: 0,0:14:00.55,0:14:03.52,*Default-ja,NTP,0,0,0,,Мен? Әлі іздеймін, әрине.
Dialogue: 0,0:14:04.67,0:14:07.03,Dialogue,,0,0,0,,Әйтеуір ертең кездескенше.
Dialogue: 0,0:14:04.77,0:14:06.63,*Default-ja,NTP,0,0,0,,Әйтеуір ертең кездескенше
Dialogue: 0,0:14:13.33,0:14:15.05,*Default-ja,NTP,0,0,0,,Ха! сонда болды!
Dialogue: 0,0:14:14.01,0:14:14.78,Dialogue,,0,0,0,,Міне, олар!
Dialogue: 0,0:14:22.35,0:14:25.83,Thought,,0,0,0,,Мен не істеп жатырмын?
Dialogue: 0,0:14:22.44,0:14:25.34,*Default-ja,NTP,0,0,0,,Мен не істеп жатырмын?
Dialogue: 0,0:14:29.54,0:14:31.64,Dialogue,,0,0,0,,Эй, бірдеңе дұрыс емес пе?
Dialogue: 0,0:14:29.72,0:14:31.39,*Default-ja,NTP,0,0,0,,Бұл біртүрлі емес пе?
Dialogue: 0,0:14:33.79,0:14:35.68,Dialogue,,0,0,0,,Есіңе түсіре алмайсың, солай ма?
Dialogue: 0,0:14:33.94,0:14:37.54,*Default-ja,NTP,0,0,0,,Мен есімде жоқ. Бұл біртүрлі. Бұл бос жер.
Dialogue: 0,0:14:35.68,0:14:37.60,Dialogue,,0,0,0,,Бос лоттар таңқаларлық.
Dialogue: 0,0:14:38.25,0:14:41.20,Dialogue,,0,0,0,,Ғимараттар жойылғанда, сіз онда не болғанын ұмытып кетесіз.
Dialogue: 0,0:14:38.42,0:14:41.09,*Default-ja,NTP,0,0,0,,Ол кеткенде мен не болғанын ұмытамын.
Dialogue: 0,0:14:42.37,0:14:44.18,Dialogue,,0,0,0,,Бұл аз ғана бұрын болған жоқ па?
Dialogue: 0,0:14:42.52,0:14:44.23,*Default-ja,NTP,0,0,0,,Бұл өткен күні болған болуы керек, солай ма?
Dialogue: 0,0:14:44.72,0:14:47.02,Dialogue,,0,0,0,,Бұл өте үлкен болды...
Dialogue: 0,0:14:44.93,0:14:47.14,*Default-ja,NTP,0,0,0,,Бұл үлкен.
Dialogue: 0,0:14:50.45,0:14:52.65,Thought,,0,0,0,,Мен не істеп жатырмын?
Dialogue: 0,0:14:50.62,0:14:52.42,*Default-ja,NTP,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:14:53.28,0:14:57.61,Thought,,0,0,0,,Шинра менің басымды іздеуден бас тарт десе, мен ашуланамын.
Dialogue: 0,0:14:53.46,0:14:57.63,*Default-ja,NTP,0,0,0,,Силла маған оның басын іздеуден бас тарт десе, мен ашуланамын.
Dialogue: 0,0:14:58.50,0:15:02.96,Thought,,0,0,0,,Бірақ мен жұмыс істеймін, мен достар деп атайтын адамдарды білемін...
Dialogue: 0,0:14:58.68,0:15:03.22,*Default-ja,NTP,0,0,0,,Бірақ мен жұмысқа орналастым, біраз достар таптым.
Dialogue: 0,0:15:03.58,0:15:06.43,Thought,,0,0,0,,Мен адам болуды жоспарлаймын ба?
Dialogue: 0,0:15:03.74,0:15:06.08,*Default-ja,NTP,0,0,0,,Сіз өзіңізді адам сияқты сезінесіз бе?
Dialogue: 0,0:15:07.43,0:15:11.33,Dialogue,,0,0,0,,Сенің менімен ісің бар ма?
Dialogue: 0,0:15:07.60,0:15:11.54,*Default-ja,NTP,0,0,0,,Айтайын дегенім, сенің бір ісің бар еді, солай емес пе? Маған
Dialogue: 0,0:15:17.52,0:15:21.94,Dialogue,,0,0,0,,I remember! Мұнда биік, жіңішке, көк түсті ғимарат бар еді.
Dialogue: 0,0:15:24.50,0:15:26.91,Dialogue,,0,0,0,,А, бұл ескі нәрсе?
Dialogue: 0,0:15:24.66,0:15:26.68,*Default-ja,NTP,0,0,0,,Ах~ Бұл соншалықты тозған ба?
Dialogue: 0,0:15:26.91,0:15:29.19,Dialogue,,0,0,0,,Бірінші қабатта бір әйел темекі сататын.
Dialogue: 0,0:15:27.04,0:15:29.10,*Default-ja,NTP,0,0,0,,Бірінші қабатта темекі дүкенінен кемпір бар еді.
Dialogue: 0,0:15:29.19,0:15:31.19,Dialogue,,0,0,0,,Бұл сізге курьер.
Dialogue: 0,0:15:29.40,0:15:31.36,*Default-ja,NTP,0,0,0,,Курьер күткендей
Dialogue: 0,0:15:33.58,0:15:37.95,Thought,,0,0,0,,Мен бұл қалада басымды сеземін, бірақ...
Dialogue: 0,0:15:33.76,0:15:37.61,*Default-ja,NTP,0,0,0,,Бұл қалада бастың белгілері бар екені сөзсіз...
Dialogue: 0,0:15:50.36,0:15:52.08,Dialogue,,0,0,0,,Hello. Қайырлы күн.
Dialogue: 0,0:15:50.49,0:15:52.46,*Default-ja,NTP,0,0,0,,Hello Konnichiha~
Dialogue: 0,0:15:52.97,0:15:53.97,Dialogue,,0,0,0,,Мен?
Dialogue: 0,0:15:53.15,0:15:53.97,*Default-ja,NTP,0,0,0,,Мен?
Dialogue: 0,0:15:53.97,0:15:57.66,Dialogue,,0,0,0,,Мен әдемі жапон тілін іздеп жүрмін.
Dialogue: 0,0:15:54.20,0:15:57.52,*Default-ja,NTP,0,0,0,,Мен әдемі жапон тілін іздеймін
Dialogue: 0,0:15:57.66,0:16:02.64,Dialogue,,0,0,0,,Нені шын жүректен іздеп жатқаныңызды айтыңызшы.
Dialogue: 0,0:15:57.86,0:16:02.57,*Default-ja,NTP,0,0,0,,Жүрегің не іздеп жатқанын айт.
Dialogue: 0,0:16:04.47,0:16:08.18,Dialogue,,0,0,0,,Мм, мен оны көре аламын ба?
Dialogue: 0,0:16:04.60,0:16:08.18,*Default-ja,NTP,0,0,0,,Мм, мен мұны көре аламын ба?
Dialogue: 0,0:16:08.18,0:16:09.27,Dialogue,,0,0,0,,Ә... ә... білесің бе...
Dialogue: 0,0:16:08.55,0:16:09.45,*Default-ja,NTP,0,0,0,,Жарайды
Dialogue: 0,0:16:21.88,0:16:23.45,Dialogue,,0,0,0,,Мен оны тапты ма деп ойлаймын.
Dialogue: 0,0:16:22.09,0:16:23.29,*Default-ja,NTP,0,0,0,,Did we meet?
Dialogue: 0,0:16:28.64,0:16:31.84,Dialogue,,0,0,0,,Мен бүгін көп нәрсені іздедім.
Dialogue: 0,0:16:28.83,0:16:31.60,*Default-ja,NTP,0,0,0,,Бүгін мен әртүрлі нәрселерді іздедім.
Dialogue: 0,0:16:32.00,0:16:35.93,Dialogue,,0,0,0,,Мен кейбірін таптым... бірақ басқаларын емес...
Dialogue: 0,0:16:32.28,0:16:35.87,*Default-ja,NTP,0,0,0,,табылды немесе табылмады
Dialogue: 0,0:16:57.53,0:17:00.72,Dialogue,,0,0,0,,Оның сөмкесі жоқ, сондықтан мен оны жұмыста деп ойладым.
Dialogue: 0,0:16:57.76,0:17:00.64,*Default-ja,NTP,0,0,0,,Менің сөмкем жоқ, сондықтан жұмыс деп ойладым.
Dialogue: 0,0:17:01.18,0:17:02.53,Dialogue,,0,0,0,,Мен сенің жаныңа дүрлігіп бара жатырмын, дірілдеп
Dialogue: 0,0:17:01.67,0:17:06.20,*Default-ja,NTP,0,0,0,,Бірақ... бірдеңе әдеттегіден өзгеше...
Dialogue: 0,0:17:03.46,0:17:06.43,Dialogue,,0,0,0,,Мен бірдеңе басқаша болғандай сезіндім...
Dialogue: 0,0:17:14.52,0:17:15.84,Dialogue,,0,0,0,,Отшашу?
Dialogue: 0,0:17:14.81,0:17:15.78,*Default-ja,NTP,0,0,0,,Fireworks?
Dialogue: 0,0:17:15.84,0:17:18.37,Dialogue,,0,0,0,,Иә, ол қобалжыды.
Dialogue: 0,0:17:16.05,0:17:17.99,*Default-ja,NTP,0,0,0,,Иә, ашу үстінде.
Dialogue: 0,0:17:18.37,0:17:21.09,Dialogue,,0,0,0,,Оны осында әкелу үшін бірнеше адам қажет болды.
Dialogue: 0,0:17:18.57,0:17:21.23,*Default-ja,NTP,0,0,0,,Мұны істеу үшін бірнеше ересек адам қажет болды.
Dialogue: 0,0:17:21.37,0:17:23.62,Dialogue,,0,0,0,,Мұның бәрі кейбір отшашулардан...?
Dialogue: 0,0:17:21.57,0:17:22.84,*Default-ja,NTP,0,0,0,,Just fireworks...
Dialogue: 0,0:17:23.62,0:17:26.31,Dialogue,,0,0,0,,Сізде дөрекі қызметкерлер бар.
Dialogue: 0,0:17:23.75,0:17:26.43,*Default-ja,NTP,0,0,0,,Бұл жерде өте өрескел қызметкерлер бар.
Dialogue: 0,0:17:27.26,0:17:29.36,Dialogue,,0,0,0,,Бұл ауыртпалық.
Dialogue: 0,0:17:27.48,0:17:29.35,*Default-ja,NTP,0,0,0,,Бұл ыңғайсыздық.
Dialogue: 0,0:17:29.64,0:17:33.68,Dialogue,,0,0,0,,Ол өзінің құрбысын ұрлап кетті деп таңқаларлық айып тақты...
Dialogue: 0,0:17:29.79,0:17:31.09,*Default-ja,NTP,0,0,0,,Біртүрлі айыптаумен
Dialogue: 0,0:17:31.51,0:17:33.88,*Default-ja,NTP,0,0,0,,«Менің дос қызымды ұрлап кетті».
Dialogue: 0,0:17:34.14,0:17:36.98,Dialogue,,0,0,0,,Бұл оның есінде қалған жалғыз жер болды.
Dialogue: 0,0:17:34.34,0:17:37.06,*Default-ja,NTP,0,0,0,,«Ол тек осы жерді есіне алды».
Dialogue: 0,0:17:36.98,0:17:39.48,Dialogue,,0,0,0,,Ол: «Оған не істегеніңді айт!» деп айқайлап жатты.
Dialogue: 0,0:17:37.27,0:17:39.10,*Default-ja,NTP,0,0,0,,«Не істегеніңді айт»
Dialogue: 0,0:17:39.48,0:17:42.37,Dialogue,,0,0,0,,Бұл жай айыптау емес, шындық, солай емес пе?
Dialogue: 0,0:17:39.78,0:17:42.42,*Default-ja,NTP,0,0,0,,Бұл жай ғана сылтау емес, бұл факт, солай емес пе?
Dialogue: 0,0:17:42.79,0:17:51.50,Dialogue,,0,0,0,,Сіз оянғаннан кейін оның біздің компания туралы ештеңе есіне түсірмейтініне көз жеткізесіз, солай емес пе, дәрігер?
Dialogue: 0,0:17:42.94,0:17:45.32,*Default-ja,NTP,0,0,0,,Бала оянғанда
Dialogue: 0,0:17:45.54,0:17:51.97,*Default-ja,NTP,0,0,0,,Мен туралы ештеңе есіңізде жоқ екеніне көз жеткізе аласыз ба? мұғалім
Dialogue: 0,0:17:52.04,0:17:56.03,Dialogue,,0,0,0,,Біреудің жадын өшірудің ыңғайлы жолы жоқ.
Dialogue: 0,0:17:52.30,0:17:56.10,*Default-ja,NTP,0,0,0,,Естеліктерді өшірудің мұндай ыңғайлы жолы жоқ.
Dialogue: 0,0:17:56.03,0:17:59.13,Dialogue,,0,0,0,,Оның үстіне, мен оны әлі есімде сақтаймын.
Dialogue: 0,0:17:56.42,0:17:59.45,*Default-ja,NTP,0,0,0,,Бұл қыз есімде.
Dialogue: 0,0:17:59.54,0:18:01.32,Dialogue,,0,0,0,,Біз оны жолға жібереміз.
Dialogue: 0,0:17:59.70,0:18:01.33,*Default-ja,NTP,0,0,0,,Мен сені үйге дұрыстап апарамын.
Dialogue: 0,0:18:01.61,0:18:05.30,*Default-ja,NTP,0,0,0,,Жарайды, мен үйге барамын ба, жоқ па білмеймін.
Dialogue: 0,0:18:02.41,0:18:05.05,Dialogue,,0,0,0,,Үйге жете ме, жоқ па білмеймін.
Dialogue: 0,0:18:08.81,0:18:14.65,Dialogue,,0,0,0,,Дәрігер, директор және мен сізге сенеміз.
Dialogue: 0,0:18:09.03,0:18:14.47,*Default-ja,NTP,0,0,0,,Мұғалім, директор да, мен де сізге сенемін.
Dialogue: 0,0:18:14.99,0:18:18.63,Dialogue,,0,0,0,,Біз сіздің «бұл» туралы құпияңызды сақтаймыз.
Dialogue: 0,0:18:15.07,0:18:18.58,*Default-ja,NTP,0,0,0,,Ол да бұл құпияны сақтауда.
Dialogue: 0,0:18:19.63,0:18:26.02,Dialogue,,0,0,0,,О, дұрыс. Сіз өте эксцентрик адаммен тұрып жатқан сияқтысыз.
Dialogue: 0,0:18:19.80,0:18:25.79,*Default-ja,NTP,0,0,0,,Дұрыс, мұғалім тағы да эксцентрик біреумен тұрып жатқан сияқты.
Dialogue: 0,0:18:26.99,0:18:30.89,Dialogue,,0,0,0,,Ол кезде мен ұмытып кеткен едім.
Dialogue: 0,0:18:27.11,0:18:30.41,*Default-ja,NTP,0,0,0,,Сол кезде мен ұмытып кетіппін
Dialogue: 0,0:18:30.89,0:18:36.51,Dialogue,,0,0,0,,Басым туралы, Дуллахан болған жүздеген жылдық естеліктерім туралы...
Dialogue: 0,0:18:31.11,0:18:36.77,*Default-ja,NTP,0,0,0,,Мойын туралы және ондағы Дуллахан болған жүздеген жылдардағы естеліктер.
Dialogue: 0,0:18:38.43,0:18:41.04,Dialogue,,0,0,0,,Мен ештеңе туралы ойлаған жоқпын.
Dialogue: 0,0:18:38.68,0:18:40.91,*Default-ja,NTP,0,0,0,,Мен ештеңе ойлаған жоқпын.
Dialogue: 0,0:18:41.04,0:18:42.75,Dialogue,,0,0,0,,Мен жай ғана... жай... болдым.
Dialogue: 0,0:18:41.37,0:18:43.36,*Default-ja,NTP,0,0,0,,Жай… жай…
Dialogue: 0,0:19:00.71,0:19:03.76,Dialogue,,0,0,0,,Әй, сен маған серік бола аласың ба?
Dialogue: 0,0:19:00.97,0:19:03.39,*Default-ja,NTP,0,0,0,,Эй, сен менімен бірге бола аласың ба?
Dialogue: 0,0:19:03.76,0:19:07.78,Dialogue,,0,0,0,,Екі адамға тапсырыс берсем, олар шағымданбайды.
Dialogue: 0,0:19:04.15,0:19:08.23,*Default-ja,NTP,0,0,0,,Екі порцияға тапсырыс берсем, мейрамхана шағымданбайды.
Dialogue: 0,0:19:08.51,0:19:10.02,Dialogue,,0,0,0,,Мен жақсы жерді білемін.
Dialogue: 0,0:19:08.71,0:19:09.83,*Default-ja,NTP,0,0,0,,Жақсы жерлер бар
Dialogue: 0,0:19:10.02,0:19:11.71,Dialogue,,0,0,0,,Өтінемін, Селти.
Dialogue: 0,0:19:10.36,0:19:11.64,*Default-ja,NTP,0,0,0,,Өтінемін, Селти
Dialogue: 0,0:19:12.25,0:19:15.65,Dialogue,,0,0,0,,Жалғыз тамақ ішу... соншалықты жалғыздық.
Dialogue: 0,0:19:12.38,0:19:15.51,*Default-ja,NTP,0,0,0,,Жалғыз тамақ ішу - жалғыздық.
Dialogue: 0,0:19:17.71,0:19:20.72,Dialogue,,0,0,0,,Бұл таңқаларлық және жұмбақ тағам не?!
Dialogue: 0,0:19:18.09,0:19:20.41,*Default-ja,NTP,0,0,0,,Не? Бұл күрделі және жұмбақ тағам
Dialogue: 0,0:19:25.12,0:19:33.47,Dialogue,,0,0,0,,Қуырылған тауық сушиі, ірімшік сушиі, сычуань стиліндегі суши, борщ сушиі және бұл қаймақ сушиі.
Dialogue: 0,0:19:25.44,0:19:27.88,*Default-ja,NTP,0,0,0,,Карааж сушиі Ірімшік суши
Dialogue: 0,0:19:28.12,0:19:30.91,*Default-ja,NTP,0,0,0,,Мабо суши борщ сушиі
Dialogue: 0,0:19:31.00,0:19:33.74,*Default-ja,NTP,0,0,0,,Бұл қаймақ суши~
Dialogue: 0,0:19:33.47,0:19:35.38,Dialogue,,0,0,0,,Оларды сушиге айналдырудың қажеті жоқ!
Dialogue: 0,0:19:33.82,0:19:35.25,*Default-ja,NTP,0,0,0,,Бұл суши болуы міндетті емес!
Dialogue: 0,0:19:35.38,0:19:36.56,Dialogue,,0,0,0,,Сіз не айтып тұрсыз?
Dialogue: 0,0:19:35.55,0:19:36.81,*Default-ja,NTP,0,0,0,,Жоқ деп айт!
Dialogue: 0,0:19:36.56,0:19:39.59,Dialogue,,0,0,0,,Бұл арнайы жинақ. Бұл шынымен арзан!
Dialogue: 0,0:19:36.88,0:19:39.52,*Default-ja,NTP,0,0,0,,Арнайы жиынтық! Тамаша қызмет!
Dialogue: 0,0:19:42.04,0:19:45.79,Dialogue,,0,0,0,,Ал десертке арналған печенье, иә?
Dialogue: 0,0:19:42.45,0:19:45.74,*Default-ja,NTP,0,0,0,,Сонымен, десерт печенье болып табылады ма?
Dialogue: 0,0:19:45.79,0:19:46.77,Dialogue,,0,0,0,,Ия...
Dialogue: 0,0:19:46.05,0:19:46.83,*Default-ja,NTP,0,0,0,,Маған үш дана беріңіз.
Dialogue: 0,0:19:47.35,0:19:50.17,Dialogue,,0,0,0,,Ішінде сенің байлығың жазылған бір жапырақ қағаз бар.
Dialogue: 0,0:19:47.62,0:19:50.09,*Default-ja,NTP,0,0,0,,Мынаның ішінде байлық бар.
Dialogue: 0,0:19:50.17,0:19:52.06,Dialogue,,0,0,0,,Бұл негізінен болжау.
Dialogue: 0,0:19:50.40,0:19:51.56,*Default-ja,NTP,0,0,0,,Қысқасы, болжау
Dialogue: 0,0:19:52.06,0:19:53.44,Dialogue,,0,0,0,,Міне, мен оларды ашамын.
Dialogue: 0,0:19:52.30,0:19:53.50,*Default-ja,NTP,0,0,0,,Қайсысын бөлемін?
Dialogue: 0,0:19:53.44,0:19:55.03,Dialogue,,0,0,0,,Бұл сіздікі.
Dialogue: 0,0:19:53.83,0:19:54.88,*Default-ja,NTP,0,0,0,,Бұл сіздікі
Dialogue: 0,0:20:01.56,0:20:02.35,Dialogue,,0,0,0,,Маған көрсет.
Dialogue: 0,0:20:01.78,0:20:02.55,*Default-ja,NTP,0,0,0,,Маған көрсет
Dialogue: 0,0:20:05.62,0:20:08.00,Dialogue,,0,0,0,,Бұл сіз іздеген нәрсені табасыз дегенді білдіреді.
Dialogue: 0,0:20:05.76,0:20:08.06,*Default-ja,NTP,0,0,0,,Бұл сіз іздеген нәрсені табасыз дегенді білдіреді.
Dialogue: 0,0:20:11.24,0:20:13.05,*Default-ja,NTP,0,0,0,,Егер сен сондай бақытты болсаң...
Dialogue: 0,0:20:11.28,0:20:13.01,Dialogue,,0,0,0,,Бақытты болғанша...
Dialogue: 0,0:20:25.73,0:20:27.87,Dialogue,,0,0,0,,Мен өте қуаныштымын, Шинра!
Dialogue: 0,0:20:25.96,0:20:27.42,*Default-ja,NTP,0,0,0,,Мен қуаныштымын, Силла!
Dialogue: 0,0:20:28.16,0:20:29.87,Dialogue,,0,0,0,,Сіз не айтасыз?
Dialogue: 0,0:20:28.30,0:20:29.67,*Default-ja,NTP,0,0,0,,Сіздікі қалай болды?
Dialogue: 0,0:20:31.39,0:20:34.28,Dialogue,,0,0,0,,Ішінде біреу болмаған сияқты...
Dialogue: 0,0:20:32.54,0:20:34.08,*Default-ja,NTP,0,0,0,,Менің ойымша, ол қосылмаған.
Dialogue: 0,0:20:35.61,0:20:38.99,Thought,,0,0,0,,Мен...көз жасымды шығара алмаймын.
Dialogue: 0,0:20:35.79,0:20:38.88,*Default-ja,NTP,0,0,0,,Көз жасымды шығара алмаймын
Dialogue: 0,0:20:47.02,0:20:49.18,Thought,,0,0,0,,Мен мұнда мұңайғанда...
Dialogue: 0,0:20:47.30,0:20:53.11,*Default-ja,NTP,0,0,0,,Мұңайғанда көз жасымыз ағар ма?
Dialogue: 0,0:20:49.89,0:20:53.23,Thought,,0,0,0,,Ол жерде көз жасын төге ме?
Dialogue: 0,0:21:04.42,0:21:05.49,Dialogue,,0,0,0,,Кел де жуынып ал.
Dialogue: 0,0:21:04.60,0:21:05.78,*Default-ja,NTP,0,0,0,,Рахмет
Dialogue: 0,0:21:10.43,0:21:11.86,Thought,,0,0,0,,Олай болмаса, жақсы.
Dialogue: 0,0:21:10.61,0:21:12.08,*Default-ja,NTP,0,0,0,,Бұлай болуы міндетті емес.
Dialogue: 0,0:21:16.56,0:21:19.28,Thought,,0,0,0,,Ол жай ғана күліп тұрса, жарайды.
Dialogue: 0,0:21:16.80,0:21:19.53,*Default-ja,NTP,0,0,0,,Сіз күліп жатырсыз деп үміттенемін.
Dialogue: 0,0:21:22.40,0:21:23.66,Dialogue,,0,0,0,,Құдайым, маған көмектес
Dialogue: 0,0:21:22.51,0:21:23.51,*Default-ja,NTP,0,0,0,,Не болды?
Dialogue: 0,0:21:25.14,0:21:27.00,Dialogue,,0,0,0,,Тағы да қорқасың.
Dialogue: 0,0:21:25.34,0:21:26.59,*Default-ja,NTP,0,0,0,,Тағы да қорқып кетті
Dialogue: 0,0:21:27.00,0:21:30.55,Dialogue,,0,0,0,,Мұнда ешкім жоқ. Бұл екеуміз ғана.
Dialogue: 0,0:21:27.43,0:21:30.29,*Default-ja,NTP,0,0,0,,Онда ешкім жоқ. Бұл екеуміз ғана.
Dialogue: 0,0:21:32.38,0:21:34.99,Dialogue,,0,0,0,,Сіз... бірдеңені есіңе түсірейін деп жатырсың ба?
Dialogue: 0,0:21:32.60,0:21:34.87,*Default-ja,NTP,0,0,0,,Есіңде бірдеңе бар сияқты ма?
Dialogue: 0,0:21:38.41,0:21:41.79,*Default-ja,NTP,0,0,0,,Иә, ештеңені есте сақтаудың қажеті жоқ.
Dialogue: 0,0:21:39.62,0:21:42.03,Dialogue,,0,0,0,,Сізге қажеті жоқ.
Dialogue: 0,0:21:42.03,0:21:43.69,Dialogue,,0,0,0,,Мен саған айттым ғой, солай емес пе?
Dialogue: 0,0:21:42.55,0:21:46.22,*Default-ja,NTP,0,0,0,,Мен бұл туралы айттым ба? Маған сенің өткенің де, болашағың да керек емес
Dialogue: 0,0:21:43.69,0:21:46.27,Dialogue,,0,0,0,,Маған сенің өткенің де, болашағың да керек емес.
Dialogue: 0,0:21:47.14,0:21:49.37,Dialogue,,0,0,0,,Қазіргі кезде менімен жақсы.
Dialogue: 0,0:21:47.34,0:21:48.79,*Default-ja,NTP,0,0,0,,Қазір сен жеткілікті
Dialogue: 0,0:21:49.37,0:21:51.52,Dialogue,,0,0,0,,Біз мәңгі бірге боламыз.
Dialogue: 0,0:21:49.67,0:21:51.45,*Default-ja,NTP,0,0,0,,Біз қазір қандай боламыз, ол мәңгілік
Dialogue: 0,0:21:55.64,0:21:58.24,Dialogue,,0,0,0,,Мен сені сүйемін, Селти.
Dialogue: 0,0:21:55.79,0:21:57.87,*Default-ja,NTP,0,0,0,,Мен сені сүйемін Селти
Dialogue: 0,0:22:15.23,0:22:16.67,Dialogue,,0,0,0,,Сол түн...
Dialogue: 0,0:22:15.45,0:22:22.19,*Default-ja,NTP,0,0,0,,Сол түні мен алғаш рет түсімде екеуміз бір болған кезді көрдім.
Dialogue: 0,0:22:16.67,0:22:18.95,Dialogue,,0,0,0,,Ұзақ уақыттан бері алғаш рет...
Dialogue: 0,0:22:18.95,0:22:22.01,Dialogue,,0,0,0,,Мен бүтін кезімде армандадым.
Dialogue: 0,0:22:41.58,0:22:43.17,Dialogue,,0,0,0,,Мен дәл осындамын.
Dialogue: 0,0:22:44.13,0:22:45.67,Dialogue,,0,0,0,,Дәл осы жерде.
Dialogue: 0,0:24:15.10,0:24:19.72,staff,NTP,0,0,0,,Өндіріс: lastzzz Rest Cloud akira Akira
Dialogue: 0,0:24:15.46,0:24:17.34,Dialogue,,0,0,0,,Менің махаббатым бөлек.
Dialogue: 0,0:24:17.34,0:24:20.51,Dialogue,,0,0,0,,Адамдарға құмарлық пен құмарлықпен айналысатын махаббаттан басқа.
Dialogue: 0,0:24:17.56,0:24:20.84,*Default-ja,NTP,0,0,0,,Менің махаббатым бөлек
Dialogue: 0,0:24:19.88,0:24:24.87,staff,NTP,0,0,0,,Manyu субтитрлер жұбы http://popgo.net/bbs/
Dialogue: 0,0:24:21.01,0:24:22.60,Dialogue,,0,0,0,,Толығырақ.
Dialogue: 0,0:24:21.14,0:24:23.04,*Default-ja,NTP,0,0,0,,Тек талап етіп, еркелететін махаббат түрінен өзгеше.
Dialogue: 0,0:24:23.57,0:24:25.39,Dialogue,,0,0,0,,Келесі жолы: ажырамас махаббат.
Dialogue: 0,0:24:25.39,0:24:28.10,Dialogue,,0,0,0,,Сейджиге керек адам ол менмін.
Dialogue: 0,0:24:25.85,0:24:28.42,*Default-ja,NTP,0,0,0,,Бұл тамашарақ
Dialogue: 0,0:24:29.92,0:24:35.92,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory