Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.00,0:00:10.00,Default,,0,0,0,,...
Dialogue: 0,0:14:53.28,0:14:57.00,Default,,0,0,0,,Жеңіске жету үшін полюстер: мотоспортта полюстен бастап, жарыста жеңіске жетуді білдіреді.
Dialogue: 0,0:15:01.00,0:15:04.96,Default,,0,0,0,,Духан мәртебесі: 1994 жылдан 1998 жылға дейін бес жыл қатарынан чемпион болған 500 cc жол жарысы бойынша әлем чемпионатының абсолютті чемпионы Майкл Духан туралы.
Dialogue: 0,0:00:06.44,0:00:07.42,Default,,0,0,0,,Мұрын...
Dialogue: 0,0:00:08.38,0:00:12.15,Default,,0,0,0,,Сезар танауларды көз деп қателесті...
Dialogue: 0,0:00:12.15,0:00:15.72,Default,,0,0,0,,Бұл өзіңді бұрмалауға тырысқанның сыйы ма?
Dialogue: 0,0:00:22.52,0:00:25.86,Default,,0,0,0,,Бұл ойын Чиаме-чан үшін тамаша емес.
Dialogue: 0,0:00:25.86,0:00:29.29,Default,,0,0,0,,Жоқ, жоқ, Юме, мен ондай балалық әрекет жасамаймын.
Dialogue: 0,0:00:29.29,0:00:32.67,Default,,0,0,0,,Не, Чисам мотоциклге қызығатын адам түрі ме?
Dialogue: 0,0:00:32.67,0:00:35.48,Default,,0,0,0,,Ол бәйгеде және сол сияқты нәрселерде жеңіске жетті.
Dialogue: 0,0:00:35.48,0:00:38.01,Default,,0,0,0,,Велосипедпен жүру керемет.
Dialogue: 0,0:02:16.42,0:02:19.52,Default,,0,0,0,,Ойын болса да жете алмаймын
Dialogue: 0,0:02:20.70,0:02:23.17,Default,,0,0,0,,Тежегіштер әдеттен тыс жеңіл
Dialogue: 0,0:02:23.17,0:02:25.70,Default,,0,0,0,,Бұл жай ғана ресми ойын ма?
Dialogue: 0,0:02:27.84,0:02:29.72,Default,,0,0,0,,Мен үшін жүгіруші ретінде
Dialogue: 0,0:02:29.72,0:02:32.68,Default,,0,0,0,,Велосипед тәрізді ойынның бұл түрі ерекше емес.
Dialogue: 0,0:02:32.68,0:02:35.52,Default,,0,0,0,,Мен сізге қаншалықты байсалды екенімді көрсетемін.
Dialogue: 0,0:02:44.60,0:02:48.14,Default,,0,0,0,,Бірінші бұрышта ілу
Dialogue: 0,0:02:48.14,0:02:50.86,Default,,0,0,0,,Көлікті газды қосу арқылы көтеріңіз
Dialogue: 0,0:02:51.76,0:02:53.38,Default,,0,0,0,,Бұл болмайды.
Dialogue: 0,0:02:53.38,0:02:55.28,Default,,0,0,0,,Бізге тезірек жолға оралу керек.
Dialogue: 0,0:03:01.54,0:03:05.22,Default,,0,0,0,,күйік
Dialogue: 0,0:03:05.22,0:03:07.92,Default,,0,0,0,,Сол жігіт мүлде есінен танып кетті – адамдар оны ұстап тұруға мәжбүр болды.
Dialogue: 0,0:03:09.92,0:03:11.01,Default,,0,0,0,,Юме
Dialogue: 0,0:03:11.01,0:03:13.14,Default,,0,0,0,,Енді...
Dialogue: 0,0:03:13.54,0:03:16.52,Default,,0,0,0,,Бұл Чиу-чанның дауысы еді.
Dialogue: 0,0:03:16.52,0:03:18.89,Default,,0,0,0,,Сол апалар
Dialogue: 0,0:03:19.12,0:03:22.98,Default,,0,0,0,,Чисамэ-чан, сен ойынға шынымен араластың.
Dialogue: 0,0:03:22.98,0:03:25.40,Default,,0,0,0,,Бұл бейнені оқыту деп аталады.
Dialogue: 0,0:03:25.40,0:03:28.54,Default,,0,0,0,,Бұл сіздің басыңыздағы жарысты қайта құрудың жаттығу әдісі.
Dialogue: 0,0:03:28.54,0:03:31.28,Default,,0,0,0,,Қайда жазатайым оқиға орын алады?
Dialogue: 0,0:03:35.87,0:03:38.90,Default,,0,0,0,,Ашу: Осыған екі аяқты қойсаңыз
Dialogue: 0,0:03:38.90,0:03:40.82,Default,,0,0,0,,Бұл өте оңай болуы мүмкін.
Dialogue: 0,0:03:42.54,0:03:44.42,Default,,0,0,0,,Бітті
Dialogue: 0,0:03:44.42,0:03:47.06,Default,,0,0,0,,Бірақ мен үшінші жаққа жеттім.
Dialogue: 0,0:03:47.06,0:03:48.80,Default,,0,0,0,,Чисамэ-чан да қолданып көрді.
Dialogue: 0,0:03:48.80,0:03:51.16,Default,,0,0,0,,Мен белсенді жүгірушімін
Dialogue: 0,0:03:51.16,0:03:52.46,Default,,0,0,0,,Бұл ойын болса да
Dialogue: 0,0:03:52.46,0:03:55.79,Default,,0,0,0,,Аяқпен жүгіру сияқты әдепсіз нәрсені істеуге бола ма?
Dialogue: 0,0:03:55.79,0:03:57.30,Default,,0,0,0,,Мен үзілді-кесілді бас тартамын.
Dialogue: 0,0:03:57.30,0:03:59.90,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:04:01.14,0:04:03.94,Default,,0,0,0,,Қанша тырыссам да, аяғым бір-біріне тимейді.
Dialogue: 0,0:04:07.50,0:04:10.90,Default,,0,0,0,,Ұялғаным сонша, мен мұны істей алмаймын.
Dialogue: 0,0:04:12.30,0:04:13.98,Default,,0,0,0,,Бұл жерден кет!
Dialogue: 0,0:04:13.98,0:04:17.41,Default,,0,0,0,,Ойынның бұл түрінде басқалардың не ойлайтынына мән берсеңіз, ұтыласыз.
Dialogue: 0,0:04:20.44,0:04:23.04,Default,,0,0,0,,Мен бұрынғы айтқанымды қайтарамын.
Dialogue: 0,0:04:23.04,0:04:25.92,Default,,0,0,0,,Мотоцикл мінсе де, сырт келбетіне жараспайтын адамдар бар.
Dialogue: 0,0:04:27.30,0:04:29.96,Default,,0,0,0,,Біртүрлі дыбыс шыққан жоқ.
Dialogue: 0,0:04:33.88,0:04:35.70,Default,,0,0,0,,Бұл машинаның сипаттамалары
Dialogue: 0,0:04:35.70,0:04:38.85,Default,,0,0,0,,Курс жоспары түсінілді
Dialogue: 0,0:04:38.85,0:04:40.92,Default,,0,0,0,,Бұл кек алудың басы
Dialogue: 0,0:04:40.92,0:04:42.96,Default,,0,0,0,,Оң сол
Dialogue: 0,0:04:47.14,0:04:48.14,Default,,0,0,0,,Келесі
Dialogue: 0,0:04:55.78,0:04:56.86,Default,,0,0,0,,Жарайды
Dialogue: 0,0:04:57.18,0:05:00.00,Default,,0,0,0,,Ойындарда жазатайым оқиғалар шынымен бола ма?
Dialogue: 0,0:05:00.00,0:05:02.54,Default,,0,0,0,,Бейне жаттығулары тиімді болды ма?
Dialogue: 0,0:05:02.54,0:05:04.72,Default,,0,0,0,,Сіз жарақат алдыңыз ба?
Dialogue: 0,0:05:04.72,0:05:06.62,Default,,0,0,0,,бөліміне өтіңіз.
Dialogue: 0,0:05:06.62,0:05:08.70,Default,,0,0,0,,Мен жүгірушімін
Dialogue: 0,0:05:08.70,0:05:13.86,Default,,0,0,0,,Чиаме-чан, ойынды жалғастыра алмағаның ұят болды.
Dialogue: 0,0:05:13.86,0:05:17.10,Default,,0,0,0,,Осы қарқынмен мен мотоциклді жеткілікті айдай алмаймын деп ойлаймын.
Dialogue: 0,0:05:21.74,0:05:24.34,Default,,0,0,0,,Мен тандемге бірінші рет мініп отырмын.
Dialogue: 0,0:05:24.34,0:05:27.00,Default,,0,0,0,,Жарайды, мен де бірінші рет.
Dialogue: 0,0:05:27.00,0:05:29.46,Default,,0,0,0,,Өйткені Юме мені мүлде мінбейді.
Dialogue: 0,0:05:31.66,0:05:34.44,Default,,0,0,0,,Артқа бұрылу қауіпті.
Dialogue: 0,0:05:34.44,0:05:37.94,Default,,0,0,0,,Қадамды бірінші басып, аяғымды қате қойдым.
Dialogue: 0,0:05:37.94,0:05:39.60,Default,,0,0,0,,Кету
Dialogue: 0,0:05:46.72,0:05:49.17,Default,,0,0,0,,Сіздің бірінші тандеміңіз қандай?
Dialogue: 0,0:05:51.20,0:05:55.04,Default,,0,0,0,,Райму-сенпай мені алғаш рет атқа мінгізді.
Dialogue: 0,0:06:04.88,0:06:08.81,Default,,0,0,0,,Чисамэ-чан, сен маған қатты жабысып тұрсаң, көлік жүргізу қиын.
Dialogue: 0,0:06:08.81,0:06:13.10,Default,,0,0,0,,Джу Ауырлық центрін центрге шоғырландырған дұрыс.
Dialogue: 0,0:06:13.10,0:06:15.02,Default,,0,0,0,,Бәйгедегі жалпы ой
Dialogue: 0,0:06:15.02,0:06:16.82,Default,,0,0,0,,Юкине-кун, бұл адамды танисың ба?
Dialogue: 0,0:06:24.83,0:06:26.54,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:06:26.54,0:06:27.64,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:06:27.64,0:06:29.18,Default,,0,0,0,,Қайырлы таң Чисаме
Dialogue: 0,0:06:29.94,0:06:32.12,Default,,0,0,0,,Биылғы жарыс туралы.
Dialogue: 0,0:06:32.12,0:06:34.04,Default,,0,0,0,,Сіз жоғарылатуға дайынсыз ба?
Dialogue: 0,0:06:34.04,0:06:35.21,Default,,0,0,0,,Қай нәсіл
Dialogue: 0,0:06:35.58,0:06:38.82,Default,,0,0,0,,...
Dialogue: 0,0:06:38.82,0:06:42.30,Default,,0,0,0,,Менің ойымша, бұл машина орта мектепке түсу мерекесі.
Dialogue: 0,0:06:43.24,0:06:46.56,Default,,0,0,0,,Бұл 4 тактілі бір цилиндрлі CBR ма?
Dialogue: 0,0:06:46.93,0:06:50.22,Default,,0,0,0,,Дегенмен, CBR кәдімгі шағын велосипедтерге қарағанда жақсы.
Dialogue: 0,0:06:50.22,0:06:52.20,Default,,0,0,0,,Орынның биіктігі жоғары.
Dialogue: 0,0:06:53.20,0:06:55.78,Default,,0,0,0,,Бойыңыз дұрыс па?
Dialogue: 0,0:06:55.78,0:06:57.28,Default,,0,0,0,,Әйтеуір, оның қандай жақсылығы бар?
Dialogue: 0,0:06:57.28,0:06:59.49,Default,,0,0,0,,Жүгіруді бастау маңызды емес.
Dialogue: 0,0:07:00.02,0:07:02.12,Default,,0,0,0,,Ал велосипедтің отыру биіктігі туралы не деуге болады?
Dialogue: 0,0:07:02.12,0:07:04.62,Default,,0,0,0,,Өндірушілер көп ақша мен уақыт жұмсайды
Dialogue: 0,0:07:04.62,0:07:06.90,Default,,0,0,0,,Бұл жаттығу өнімділігін анықтаудың кілті.
Dialogue: 0,0:07:06.90,0:07:09.50,Default,,0,0,0,,Аяғыңызды сезбеймін деп оны өзгертуге болмайды.
Dialogue: 0,0:07:09.83,0:07:11.98,Default,,0,0,0,,Енді тапсырыс беруге болады.
Dialogue: 0,0:07:16.30,0:07:19.80,Default,,0,0,0,,Сіз бұл тапсырысты біраз уақыт күте аласыз.
Dialogue: 0,0:07:22.50,0:07:25.93,Default,,0,0,0,,Жаңа мотоцикл клубының жетекшісін құттықтаймыз
Dialogue: 0,0:07:25.93,0:07:29.70,Default,,0,0,0,,Жоқ, жоқ, мен Амано Онсаға лайық емеспін.
Dialogue: 0,0:07:29.70,0:07:32.20,Default,,0,0,0,,Мен жаңа менеджер ретінде қызмет етемін.
Dialogue: 0,0:07:35.24,0:07:37.38,Default,,0,0,0,,Айтпақшы, біздің мотоцикл клубы қазір
Dialogue: 0,0:07:37.38,0:07:39.32,Default,,0,0,0,,Проблемаға тап болу
Dialogue: 0,0:07:39.32,0:07:41.48,Default,,0,0,0,,Жаңа мүшелер келмейді
Dialogue: 0,0:07:41.48,0:07:44.68,Default,,0,0,0,,Кімнің қосылуы ықтимал?
Dialogue: 0,0:07:44.68,0:07:46.44,Default,,0,0,0,,Менің ойымша, бұл Чисамэ-чан.
Dialogue: 0,0:07:46.44,0:07:48.84,Default,,0,0,0,,Бірақ сен оны сезбейсің бе?
Dialogue: 0,0:07:48.84,0:07:52.92,Default,,0,0,0,,Ол қыңыр және велосипедке біртүрлі құмар...
Dialogue: 0,0:07:52.92,0:07:55.83,Default,,0,0,0,,Сузуноги Рин сияқты қауіпті иіс
Dialogue: 0,0:07:55.83,0:07:59.42,Default,,0,0,0,,Мотоциклдерге ерекше мән беру жақсы.
Dialogue: 0,0:07:59.42,0:08:01.63,Default,,0,0,0,,Ал мен оны мініп жүрмін.
Dialogue: 0,0:08:01.63,0:08:03.30,Default,,0,0,0,,Мысалы,
Dialogue: 0,0:08:03.30,0:08:09.44,Default,,0,0,0,,Жасыл пияз, тофу, қазан, кассеталық пешті алып бара жатқан үйрек сияқты.
Dialogue: 0,0:08:11.54,0:08:13.48,Default,,0,0,0,,Әңгіме дегеніміз не?
Dialogue: 0,0:08:13.48,0:08:17.80,Default,,0,0,0,,Мен байкер ретінде дос болғым келеді.
Dialogue: 0,0:08:17.80,0:08:21.12,Default,,0,0,0,,Айтпақшы, тегің кім, Чисаме?
Dialogue: 0,0:08:21.12,0:08:22.08,Default,,0,0,0,,Накано
Dialogue: 0,0:08:22.08,0:08:23.86,Default,,0,0,0,,Накано?
Dialogue: 0,0:08:23.86,0:08:27.07,Default,,0,0,0,,Бұрынғы GP шабандозы Киня Накано сияқты.
Dialogue: 0,0:08:28.42,0:08:30.64,Default,,0,0,0,,Сіз Чиамды білмейсіз бе?
Dialogue: 0,0:08:30.64,0:08:31.86,Default,,0,0,0,,Ол өте әдемі.
Dialogue: 0,0:08:31.86,0:08:34.36,Default,,0,0,0,,Өздерін танымал шабандоздар деп атайтын адамдар
Dialogue: 0,0:08:34.36,0:08:36.64,Default,,0,0,0,,Бұл менің әкем.
Dialogue: 0,0:08:38.40,0:08:39.32,Default,,0,0,0,,Шынайы
Dialogue: 0,0:08:40.10,0:08:41.96,Default,,0,0,0,,Сіз бұл туралы айтып отырсыз ба?
Dialogue: 0,0:08:41.96,0:08:45.90,Default,,0,0,0,,Жоқ, мен Чиу-чанның бүгін келуін өтіндім.
Dialogue: 0,0:08:47.68,0:08:52.72,Default,,0,0,0,,Біз қазіргі жүгірушіге мотоциклімізді айдап, қарап шығуға рұқсат беру туралы айтып отырмыз.
Dialogue: 0,0:08:53.60,0:08:55.90,Default,,0,0,0,,Қайсысын бассаң да маңызды емес.
Dialogue: 0,0:08:55.90,0:08:56.76,Default,,0,0,0,,Мотоциклдерге арналған
Dialogue: 0,0:08:56.76,0:08:59.20,Default,,0,0,0,,Чисамэ-чан мұғалімге көбірек ұқсайды.
Dialogue: 0,0:08:59.20,0:09:00.89,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:09:01.42,0:09:03.74,Default,,0,0,0,,Өз аяғыңыздың ұзындығы
Dialogue: 0,0:09:03.74,0:09:06.23,Default,,0,0,0,,Коммерциялық автокөліктердің салмағын ескере отырып...
Dialogue: 0,0:09:06.82,0:09:08.16,Default,,0,0,0,,Ой
Dialogue: 0,0:09:08.16,0:09:09.27,Default,,0,0,0,,өлтіру
Dialogue: 0,0:09:12.08,0:09:17.50,Default,,0,0,0,,Ал, мен велосипедімді тек тізбектерде жүруді шештім.
Dialogue: 0,0:09:17.50,0:09:18.87,Default,,0,0,0,,Тағы бір қадам
Dialogue: 0,0:09:18.87,0:09:21.90,Default,,0,0,0,,Тек алға және оны мініңіз.
Dialogue: 0,0:09:21.90,0:09:24.10,Default,,0,0,0,,Мен өзімді итеріп жіберетіндей сезінемін.
Dialogue: 0,0:09:24.96,0:09:28.02,Default,,0,0,0,,Балалар, не істеп жатырсыңдар?
Dialogue: 0,0:09:28.02,0:09:30.92,Default,,0,0,0,,Бірінші курс студенттерімен танысу үшін сынақ жүргізу шарасы.
Dialogue: 0,0:09:30.92,0:09:32.12,Default,,0,0,0,,Иә, Рин
Dialogue: 0,0:09:32.12,0:09:34.92,Default,,0,0,0,,Чисами де сол катанаға мінсін.
Dialogue: 0,0:09:34.92,0:09:37.64,Default,,0,0,0,,Жоқ, жоқ
Dialogue: 0,0:09:37.64,0:09:39.06,Default,,0,0,0,,Қажет болса
Dialogue: 0,0:09:39.06,0:09:41.22,Default,,0,0,0,,Оны сатып алу үшін өз ақшаңызды төледіңіз.
Dialogue: 0,0:09:42.16,0:09:44.32,Default,,0,0,0,,Ренжімеңіз.
Dialogue: 0,0:09:44.32,0:09:47.32,Default,,0,0,0,,Бірақ менің ойымша, бұл велосипед тебу.
Dialogue: 0,0:09:47.82,0:09:50.18,Default,,0,0,0,,Рин-сенпайдың қазіргі мінез-құлқы
Dialogue: 0,0:09:50.18,0:09:52.90,Default,,0,0,0,,Маған жарық сәулесі әкелді
Dialogue: 0,0:09:53.34,0:09:54.44,Default,,0,0,0,,Жарайды
Dialogue: 0,0:09:54.44,0:09:56.68,Default,,0,0,0,,(Отокоцудың дауысы)
Dialogue: 0,0:09:56.68,0:09:59.12,Default,,0,0,0,,Үлкендер, мен естідім.
Dialogue: 0,0:09:59.12,0:10:01.42,Default,,0,0,0,,Велосипедіңізге ешкімге қол тигізбеңіз
Dialogue: 0,0:10:01.42,0:10:03.50,Default,,0,0,0,,Бұл нағыз шабандоз
Dialogue: 0,0:10:03.50,0:10:05.71,Default,,0,0,0,,Мен сізді құрметтеймін.
Dialogue: 0,0:10:06.28,0:10:08.18,Default,,0,0,0,,Бұл керемет катана
Dialogue: 0,0:10:08.18,0:10:10.38,Default,,0,0,0,,Мен оны міндетті түрде басып алғым келеді.
Dialogue: 0,0:10:10.38,0:10:12.78,Default,,0,0,0,,Бірақ мен шыдамды боламын.
Dialogue: 0,0:10:12.78,0:10:16.48,Default,,0,0,0,,Өйткені мен де нағыз шабандозмын
Dialogue: 0,0:10:16.48,0:10:19.12,Default,,0,0,0,,Үлкендер Рин-сенпайдан үлгі алуы керек.
Dialogue: 0,0:10:19.12,0:10:21.68,Default,,0,0,0,,Басқалардың сіздің үстіңізден басып кетуіне жол бермеңіз.
Dialogue: 0,0:10:22.42,0:10:24.94,Default,,0,0,0,,Мен Ринге еліктегім келмейді.
Dialogue: 0,0:10:24.94,0:10:26.76,Default,,0,0,0,,Мен аман қалдым.
Dialogue: 0,0:10:26.76,0:10:29.81,Default,,0,0,0,,Неліктен Supernatural мінуге болмайтын себебін қате көрсету
Dialogue: 0,0:10:33.12,0:10:35.54,Default,,0,0,0,,Енді оның пайдасы болмаса
Dialogue: 0,0:10:35.54,0:10:37.04,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:10:38.98,0:10:40.84,Default,,0,0,0,,Сонымен
Dialogue: 0,0:10:40.84,0:10:43.36,Default,,0,0,0,,Егер сіз шынымен осы Катанаға мінгіңіз келсе
Dialogue: 0,0:10:43.36,0:10:45.37,Default,,0,0,0,,Мен мұны істеуге болады деп жатырмын.
Dialogue: 0,0:10:47.02,0:10:50.54,Default,,0,0,0,,Олай болса, мені сонша құрметтесең.
Dialogue: 0,0:10:50.54,0:10:52.24,Default,,0,0,0,,Мен және сен
Dialogue: 0,0:10:52.24,0:10:56.34,Default,,0,0,0,,«Құпия егіз құйрықты» құруға болмайды дейсіз бе?
Dialogue: 0,0:10:56.66,0:10:58.26,Default,,0,0,0,,Маған ұнамайды.
Dialogue: 0,0:10:59.00,0:11:02.10,Default,,0,0,0,,Бірақ Рин-сенпайдың қымбат катанасы...
Dialogue: 0,0:11:02.10,0:11:05.36,Default,,0,0,0,,Мен нағыз жазушымын.
Dialogue: 0,0:11:05.36,0:11:08.02,Default,,0,0,0,,Мен салқын катана мінген дұрыс деп жатырмын.
Dialogue: 0,0:11:08.02,0:11:09.74,Default,,0,0,0,,Қуанышпен атқа мін
Dialogue: 0,0:11:09.74,0:11:11.78,Default,,0,0,0,,Бұл адам не айтып тұр?
Dialogue: 0,0:11:11.78,0:11:14.04,Default,,0,0,0,,Мен Ринмен келіскенді жек көремін, бірақ
Dialogue: 0,0:11:14.04,0:11:16.16,Default,,0,0,0,,Егер сіз осы уақытқа дейін келген болсаңыз, маған міну керек.
Dialogue: 0,0:11:16.16,0:11:17.04,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:11:17.04,0:11:18.10,Default,,0,0,0,,...
Dialogue: 0,0:11:18.10,0:11:26.36,Default,,0,0,0,,Жүру...
Dialogue: 0,0:11:26.36,0:11:33.38,Default,,0,0,0,,Жүру...
Dialogue: 0,0:11:28.32,0:11:31.32,Default,,0,0,0,,Велосипедпен жүрмейінше, бұл сәйкес келмейді.
Dialogue: 0,0:11:31.32,0:11:33.80,Default,,0,0,0,,Дегенмен, мен оны жеңдім, бірақ соңында ...
Dialogue: 0,0:11:33.80,0:11:36.80,Default,,0,0,0,,Өтірік, анау қыздың аяғы тым қысқа
Dialogue: 0,0:11:37.34,0:11:39.80,Default,,0,0,0,,Мен шағын велосипед жарысында бірінші орынды жеңіп алдым
Dialogue: 0,0:11:39.80,0:11:42.14,Default,,0,0,0,,Мен мұндай қорлыққа шыдай алмаймын.
Dialogue: 0,0:11:42.14,0:11:43.66,Default,,0,0,0,,Кираны қуалау – кешірілмейтін әрекет; оны тіпті қылмыс деп те айтуға болады
Dialogue: 0,0:11:43.66,0:11:45.05,Default,,0,0,0,,Кираны қуалау – кешірілмейтін әрекет; оны тіпті қылмыс деп те айтуға болады
Dialogue: 0,0:11:45.05,0:11:49.27,Default,,0,0,0,,Жүру...
Dialogue: 0,0:11:45.48,0:11:47.40,Default,,0,0,0,,Бірақ егер басшыны құлату жоспарың жарты жолда әшкереленсе,
Dialogue: 0,0:11:49.36,0:11:52.38,Default,,0,0,0,,Мен енді түсіндім. Мен түссіндім.
Dialogue: 0,0:11:52.38,0:11:55.20,Default,,0,0,0,,Иә, иә, бәрібір менің бойым қысқа.
Dialogue: 0,0:11:55.20,0:11:57.44,Default,,0,0,0,,Мен велосипедте аяғымды ұстай алмаймын
Dialogue: 0,0:11:57.44,0:11:59.72,Default,,0,0,0,,Сіз қалай ойлайсыз? Осыған көңіліңіз тола ма?
Dialogue: 0,0:11:59.72,0:12:02.03,Default,,0,0,0,,Күлгің келсе күл.
Dialogue: 0,0:12:06.52,0:12:09.90,Default,,0,0,0,,Жоқ, қате түсінбеңіз.
Dialogue: 0,0:12:10.32,0:12:13.18,Default,,0,0,0,,Білесіз бе, біз қыздар үшін
Dialogue: 0,0:12:13.18,0:12:14.98,Default,,0,0,0,,Бұл қалыпты жағдай.
Dialogue: 0,0:12:14.98,0:12:17.44,Default,,0,0,0,,Менің мотоциклімді айдап көріңіз
Dialogue: 0,0:12:17.44,0:12:18.76,Default,,0,0,0,,Бірақ
Dialogue: 0,0:12:20.54,0:12:21.70,Default,,0,0,0,,О, бұл
Dialogue: 0,0:12:22.00,0:12:24.12,Default,,0,0,0,,Парақ қалыңдығын азайтыңыз
Dialogue: 0,0:12:24.12,0:12:26.34,Default,,0,0,0,,Маған басқа да істер жасадым.
Dialogue: 0,0:12:28.00,0:12:31.02,Default,,0,0,0,,Енді менің виолончельге мініп көріңіз
Dialogue: 0,0:12:34.14,0:12:36.62,Default,,0,0,0,,Қорқынышты суға бату
Dialogue: 0,0:12:36.62,0:12:39.03,Default,,0,0,0,,Суспензия айтарлықтай салбырап тұр.
Dialogue: 0,0:12:39.03,0:12:41.14,Default,,0,0,0,,Не болды?
Dialogue: 0,0:12:41.14,0:12:42.86,Default,,0,0,0,,Қазір
Dialogue: 0,0:12:42.86,0:12:45.82,Default,,0,0,0,,Бұрыштарға қалай шабуыл жасау керек
Dialogue: 0,0:12:45.82,0:12:47.94,Default,,0,0,0,,Орын түсірілсе де
Dialogue: 0,0:12:47.94,0:12:50.12,Default,,0,0,0,,Мен мұндай велосипедпен жүре алмаймын.
Dialogue: 0,0:12:50.74,0:12:53.24,Default,,0,0,0,,Ал орындық биіктігі
Dialogue: 0,0:12:53.24,0:12:56.54,Default,,0,0,0,,Өндіруші анықтаған маневрлік талаптар
Dialogue: 0,0:12:57.46,0:12:59.60,Default,,0,0,0,,Аяғыңнан тұра алмасаң да
Dialogue: 0,0:12:59.60,0:13:01.59,Default,,0,0,0,,Ат міне алмасаң да
Dialogue: 0,0:13:02.04,0:13:05.16,Default,,0,0,0,,Оны өзгертуге болмайды
Dialogue: 0,0:13:07.90,0:13:09.20,Default,,0,0,0,,Мың жаңбыр
Dialogue: 0,0:13:09.68,0:13:13.88,Default,,0,0,0,,Өндіруші туралы шешім қабылдамайынша не істейсіз?
Dialogue: 0,0:13:15.56,0:13:18.98,Default,,0,0,0,,Мінгің келсе, әйтеуір мін.
Dialogue: 0,0:13:18.98,0:13:20.80,Default,,0,0,0,,Қыңыр болма
Dialogue: 0,0:13:23.90,0:13:27.80,Default,,0,0,0,,Велосипед тебу үшін дөрекі немесе ұнамды болудың қажеті жоқ.
Dialogue: 0,0:13:27.80,0:13:29.37,Default,,0,0,0,,Адал болған дұрыс
Dialogue: 0,0:13:34.38,0:13:35.96,Default,,0,0,0,,Осы сияқты...
Dialogue: 0,0:13:39.26,0:13:41.30,Default,,0,0,0,,Велосипедпен осылай жүру
Dialogue: 0,0:13:41.30,0:13:44.66,Default,,0,0,0,,Салқын бірдеңе айтсаң да көңіліңді көтермейді.
Dialogue: 0,0:13:45.26,0:13:48.10,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:13:48.10,0:13:50.31,Default,,0,0,0,,Бірақ егер сіз қыңыр болсаңыз
Dialogue: 0,0:13:50.66,0:13:52.86,Default,,0,0,0,,Мен де ол сияқты болғым келеді.
Dialogue: 0,0:13:53.38,0:13:55.10,Default,,0,0,0,,Қазір әлі уақыт бар
Dialogue: 0,0:13:59.64,0:14:00.98,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:14:00.98,0:14:02.24,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:14:02.24,0:14:03.78,Default,,0,0,0,,Қайтадан қош келдіңіз Чисам
Dialogue: 0,0:14:03.78,0:14:05.22,Default,,0,0,0,,Осымен
Dialogue: 0,0:14:05.22,0:14:09.66,Default,,0,0,0,,Әйтеуір мотоцикл клубына қосылдым.
Dialogue: 0,0:14:09.66,0:14:13.84,Default,,0,0,0,,Сонымен, мен бүгін таңертең айтқан жаңа машинаның орнына.
Dialogue: 0,0:14:15.14,0:14:17.66,Default,,0,0,0,,Мотоцикл лицензиясын алуым керек пе?
Dialogue: 0,0:14:18.52,0:14:21.50,Default,,0,0,0,,Жарайды, Чисам өз қалағанын істесін.
Dialogue: 0,0:14:21.50,0:14:24.44,Default,,0,0,0,,Шынымен, рахмет, әке.
Dialogue: 0,0:14:25.62,0:14:27.00,Default,,0,0,0,,Қараңдар!
Dialogue: 0,0:14:27.00,0:14:29.54,Default,,0,0,0,,Сіз оның қоғамдық жолмен жүретінін айттыңыз.
Dialogue: 0,0:14:29.54,0:14:31.32,Default,,0,0,0,,Мен жеңілдім
Dialogue: 0,0:14:31.80,0:14:34.22,Default,,0,0,0,,Мен жоқ деп ойладым.
Dialogue: 0,0:14:50.24,0:14:51.38,Default,,0,0,0,,Мақсат
Dialogue: 0,0:14:51.38,0:14:53.28,Default,,0,0,0,,1-ші орын Чиу Накано
Dialogue: 0,0:14:53.28,0:14:57.00,Default,,0,0,0,,Полюс егізі 2-ші орынға 5 секундтан астам айырмашылықпен жеңіске жетті
Dialogue: 0,0:14:57.00,0:15:01.00,Default,,0,0,0,,Істер осыншама басым болғанда қызықсыз.
Dialogue: 0,0:15:01.00,0:15:04.96,Default,,0,0,0,,Сонда ол қашан духан мемлекетіне айналды?
Dialogue: 0,0:15:06.24,0:15:09.32,Default,,0,0,0,,Қараңдаршы, Чисамның нәсіліне қатысты мақала бар.
Dialogue: 0,0:15:09.32,0:15:11.90,Default,,0,0,0,,№1 болса да, мақала шағын
Dialogue: 0,0:15:11.90,0:15:14.00,Default,,0,0,0,,Өйткені жеңімпаз әрқашан Чисам
Dialogue: 0,0:15:14.00,0:15:16.56,Default,,0,0,0,,Енді оны өңдеу қиын болып барады.
Dialogue: 0,0:15:16.56,0:15:19.96,Default,,0,0,0,,Мен оны қалыпты түрде сақтаймын деп ойлаймын.
Dialogue: 0,0:15:20.86,0:15:22.30,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:15:22.30,0:15:25.94,Default,,0,0,0,,Бұл GP шабандозына арналған жаттығу тобы
Dialogue: 0,0:15:25.94,0:15:29.58,Default,,0,0,0,,Велосипедпен жүруге қажетті барлық бұлшықеттерді жаттықтыру кезінде,
Dialogue: 0,0:15:29.58,0:15:33.60,Default,,0,0,0,,Тым көп пайдалансаңыз, денеңізді тепе-теңдікке түсіретін екі жүзді қылыш.
Dialogue: 0,0:15:33.60,0:15:36.58,Default,,0,0,0,,Егер сіз осындай қарсыласты жеңсеңіз де,
Dialogue: 0,0:15:36.58,0:15:38.34,Default,,0,0,0,,Күткендей, солай емес пе?
Dialogue: 0,0:15:38.34,0:15:41.96,Default,,0,0,0,,Егер сіз жақсы болсаңыз, лицензия алу оңай сияқты.
Dialogue: 0,0:15:41.96,0:15:45.40,Default,,0,0,0,,Иә, менің ойымша, Чисам мұны істей алады.
Dialogue: 0,0:15:45.40,0:15:46.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:46.28,0:15:48.68,Default,,0,0,0,,Лицензиялық емтихан орталығында бір реттік сынақ
Dialogue: 0,0:15:48.68,0:15:51.18,Default,,0,0,0,,Автомектепте жалқау болғаннан жақсы.
Dialogue: 0,0:15:51.18,0:15:54.46,Default,,0,0,0,,Өйткені, Чисам мотоцикл генийі.
Dialogue: 0,0:15:59.26,0:16:01.64,Default,,0,0,0,,Сонымен, 1 саны бар адам.
Dialogue: 0,0:16:01.64,0:16:02.54,Default,,0,0,0,,Иә
Dialogue: 0,0:16:03.16,0:16:05.69,Default,,0,0,0,,Мен оны үнемі жарыстарда мінемін.
Dialogue: 0,0:16:06.50,0:16:08.86,Default,,0,0,0,,Иә кері тексеру шегерімі
Dialogue: 0,0:16:08.86,0:16:10.92,Default,,0,0,0,,Бүйірлік тірек шегерімі
Dialogue: 0,0:16:10.92,0:16:12.42,Default,,0,0,0,,Айнаны реттеу шегерімі
Dialogue: 0,0:16:12.42,0:16:14.91,Default,,0,0,0,,Шегерім ұпайларын шегерім
Dialogue: 0,0:16:12.70,0:16:14.46,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,0:16:17.66,0:16:20.56,Default,,0,0,0,,Иә, емтиханды тоқтатыңыз, түсіңіз.
Dialogue: 0,0:16:24.22,0:16:26.66,Default,,0,0,0,,Ережелер жарыстан өзгеше.
Dialogue: 0,0:16:26.66,0:16:28.66,Default,,0,0,0,,Маған дұрыстап хабарлаңыз.
Dialogue: 0,0:16:28.66,0:16:30.34,Default,,0,0,0,,Чисамэ-чан
Dialogue: 0,0:16:30.34,0:16:33.06,Default,,0,0,0,,Чисамэ-чан да осы автомектепте оқыды ма?
Dialogue: 0,0:16:33.06,0:16:35.02,Default,,0,0,0,,Қараңызшы, мен де.
Dialogue: 0,0:16:35.02,0:16:37.08,Default,,0,0,0,,Бірақ бұл таң қалдырады.
Dialogue: 0,0:16:37.08,0:16:41.56,Default,,0,0,0,,Теккири Чисаме-чан бір реттік сынақ болады деп ойладым.
Dialogue: 0,0:16:42.32,0:16:45.18,Default,,0,0,0,,Мен бұған жақсы болдым.
Dialogue: 0,0:16:45.18,0:16:48.74,Default,,0,0,0,,Әкем рұқсатсыз оқуға түсуге өтініш берді.
Dialogue: 0,0:16:48.74,0:16:50.40,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:16:50.40,0:16:54.22,Default,,0,0,0,,Біраз уақыт мектепке бірге баратын сияқтымыз.
Dialogue: 0,0:16:58.06,0:17:00.48,Default,,0,0,0,,Алғашқы тәжірибелік сабақ.
Dialogue: 0,0:17:01.34,0:17:04.76,Default,,0,0,0,,Түсіндім, сен Наканоның қызысың.
Dialogue: 0,0:17:04.76,0:17:08.30,Default,,0,0,0,,Сіз шағын велосипед жарысы чемпионатының данышпан шабандозысыз ​​ба?
Dialogue: 0,0:17:08.96,0:17:11.64,Default,,0,0,0,,Ол белгілі адам.
Dialogue: 0,0:17:11.64,0:17:15.14,Default,,0,0,0,,Менің ойымша, сіз оған біраз үйреніп қалдыңыз.
Dialogue: 0,0:17:15.14,0:17:17.38,Default,,0,0,0,,Жаттығудың қажеті жоқ
Dialogue: 0,0:17:19.02,0:17:22.22,Default,,0,0,0,,Иә, мен мұнда қарау үшін келдім.
Dialogue: 0,0:17:22.22,0:17:25.46,Default,,0,0,0,,Олай болса, Накано мырза, сіз қалағаныңызша жүгіре аласыз.
Dialogue: 0,0:17:26.12,0:17:27.80,Default,,0,0,0,,Минова мырза, келіңіз.
Dialogue: 0,0:17:27.80,0:17:29.70,Default,,0,0,0,,Мен саған бәрін нөлден бастап үйретемін.
Dialogue: 0,0:17:29.70,0:17:30.68,Default,,0,0,0,,Иә
Dialogue: 0,0:17:34.00,0:17:35.98,Default,,0,0,0,,Мен оны бәрібір айдап көремін деп ойлаймын.
Dialogue: 0,0:17:41.28,0:17:44.60,Default,,0,0,0,,Мен жарыс көліктерінен басқа ештеңе түсінбеймін.
Dialogue: 0,0:17:46.66,0:17:48.82,Default,,0,0,0,,Құлаған велосипедті дереу көтеріңіз
Dialogue: 0,0:17:48.82,0:17:49.96,Default,,0,0,0,,Иә
Dialogue: 0,0:17:49.96,0:17:52.28,Default,,0,0,0,,Сей-сенпайдан жақсы ма?
Dialogue: 0,0:17:52.28,0:17:55.32,Default,,0,0,0,,Тренинг доңғалақтарынсыз велосипедпен жүру мүмкін емес.
Dialogue: 0,0:17:56.64,0:18:00.12,Default,,0,0,0,,Мен жүгіре бастағанда бұрылыс сигналын қолдануға тура келді.
Dialogue: 0,0:18:00.12,0:18:02.28,Default,,0,0,0,,Ол қайда? Бұл қайда?
Dialogue: 0,0:18:03.84,0:18:04.92,Default,,0,0,0,,Міне
Dialogue: 0,0:18:05.30,0:18:07.16,Default,,0,0,0,,(Жаңа атқарушы)
Dialogue: 0,0:18:13.88,0:18:15.44,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:18:15.44,0:18:17.36,Default,,0,0,0,,Мен сенімді болу үшін сұраймын.
Dialogue: 0,0:18:17.36,0:18:19.70,Default,,0,0,0,,Жүгіру кезінде түсінбейтін нәрселер бар.
Dialogue: 0,0:18:21.60,0:18:24.36,Default,,0,0,0,,Жыпылықтағышты қалай қосу керектігін айтыңызшы...
Dialogue: 0,0:18:24.36,0:18:26.87,Default,,0,0,0,,Жыпылықтағышты қалай қосу керектігін айтыңызшы...
Dialogue: 0,0:18:28.68,0:18:30.78,Default,,0,0,0,,Бұл дұрыс емес пе?
Dialogue: 0,0:18:30.78,0:18:32.52,Default,,0,0,0,,Джакоре оқу кітабы
Dialogue: 0,0:18:32.52,0:18:34.40,Default,,0,0,0,,Мен оған мөр қойдым.
Dialogue: 0,0:18:36.10,0:18:37.56,Default,,0,0,0,,Біз кесіп өтетін нәрсе – ақымақтық сызығы
Dialogue: 0,0:18:40.22,0:18:43.68,Default,,0,0,0,,Содан кейін Фукуока Бургты максималды қиындықпен бастаңыз.
Dialogue: 0,0:18:45.60,0:18:47.72,Default,,0,0,0,,Жаяу жүргіншілер сізге шабуыл жасайды
Dialogue: 0,0:18:47.72,0:18:49.04,Default,,0,0,0,,Болмау және жүгіру
Dialogue: 0,0:18:49.04,0:18:50.78,Default,,0,0,0,,Жол қозғалысы ережелерін сақтаңыз.
Dialogue: 0,0:18:50.78,0:18:52.73,Default,,0,0,0,,Оны қорғаудың мәні бар ма?
Dialogue: 0,0:18:55.70,0:18:57.74,Default,,0,0,0,,Мен бар күшіммен сенің үстіңнен жүгірдім
Dialogue: 0,0:18:58.76,0:19:02.83,Default,,0,0,0,,Мен соғыссыз елде туғым келді.
Dialogue: 0,0:19:04.04,0:19:06.36,Default,,0,0,0,,Өйткені тренажер тек тәжірибе
Dialogue: 0,0:19:06.36,0:19:08.66,Default,,0,0,0,,Таза алмасаң да, мөр басамын.
Dialogue: 0,0:19:08.66,0:19:11.25,Default,,0,0,0,,Мұны тазартатын адам бар ма?
Dialogue: 0,0:19:13.34,0:19:15.38,Default,,0,0,0,,Міне, бүгін Иппонбаши.
Dialogue: 0,0:19:15.38,0:19:18.02,Default,,0,0,0,,Накано мырза еркін жүгіре алады.
Dialogue: 0,0:19:18.80,0:19:20.42,Default,,0,0,0,,Олай болса, слалом.
Dialogue: 0,0:19:20.42,0:19:22.94,Default,,0,0,0,,Накано-кун өзіне ұнайтын нәрсемен айналысады.
Dialogue: 0,0:19:23.68,0:19:26.98,Default,,0,0,0,,Накано-кун, сенен бірнәрсе сұрайын дегенім бар.
Dialogue: 0,0:19:26.98,0:19:28.38,Default,,0,0,0,,Жоқ, солай ма?
Dialogue: 0,0:19:31.24,0:19:32.77,Default,,0,0,0,,Ұсыныс
Dialogue: 0,0:19:32.77,0:19:34.96,Default,,0,0,0,,Маған ештеңе үйретпеген болса да
Dialogue: 0,0:19:34.96,0:19:37.72,Default,,0,0,0,,Тек сабақ уақыты алға жылжиды
Dialogue: 0,0:19:37.72,0:19:39.45,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:19:43.66,0:19:47.79,Default,,0,0,0,,Хиджири-сенпай, білмей тұрып, атқа мінерсің.
Dialogue: 0,0:19:47.79,0:19:51.21,Default,,0,0,0,,Минова Мен слаломға барамын
Dialogue: 0,0:19:55.94,0:20:01.26,Default,,0,0,0,,Автомектепте сен менен артық шығарсың.
Dialogue: 0,0:20:04.46,0:20:06.12,Default,,0,0,0,,Жоғары жылжытыңыз
Dialogue: 0,0:20:07.80,0:20:10.16,Default,,0,0,0,,Бұл жарыс ауысымына қарама-қарсы болды.
Dialogue: 0,0:20:18.14,0:20:19.99,Default,,0,0,0,,Жақсысың ба, Накано-кун?
Dialogue: 0,0:20:30.32,0:20:33.04,Default,,0,0,0,,Чисамэ-чан, бәрі жақсы болды.
Dialogue: 0,0:20:34.00,0:20:35.46,Default,,0,0,0,,Сіз белсенді жарысушы болсаңыз да
Dialogue: 0,0:20:35.46,0:20:38.08,Default,,0,0,0,,Сәтсіз қалуыңыз мүмкін.
Dialogue: 0,0:20:39.66,0:20:41.20,Default,,0,0,0,,Чисамэ-чан
Dialogue: 0,0:20:41.68,0:20:44.58,Default,,0,0,0,,Чи Накано 16 жаста
Dialogue: 0,0:20:44.58,0:20:49.52,Default,,0,0,0,,Бойы: 144,8 см Салмағы: 39 кг
Dialogue: 0,0:20:52.00,0:20:54.38,Default,,0,0,0,,Маған ұнайтыны – мотоцикл міну
Dialogue: 0,0:20:54.38,0:20:56.70,Default,,0,0,0,,Контур бойынша жүгіру
Dialogue: 0,0:20:56.70,0:20:58.46,Default,,0,0,0,,Ата-ана - GP шабандозы
Dialogue: 0,0:20:58.46,0:21:01.80,Default,,0,0,0,,Мотоцикл жарысы чемпионатының 12 кубогының иегері.
Dialogue: 0,0:21:01.80,0:21:03.54,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:21:04.76,0:21:06.92,Default,,0,0,0,,Мен мотоциклмен жүруді бастаушымын.
Dialogue: 0,0:21:09.38,0:21:12.68,Default,,0,0,0,,Менің ағам мұны жақсы біледі.
Dialogue: 0,0:21:12.68,0:21:15.28,Default,,0,0,0,,Айтшы, Хиджири-сенпай.
Dialogue: 0,0:21:15.28,0:21:18.02,Default,,0,0,0,,Велосипедті қалай айдауға болады?
Dialogue: 0,0:21:19.60,0:21:20.92,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:21:21.64,0:21:23.06,Default,,0,0,0,,Аға
Dialogue: 0,0:21:24.70,0:21:28.35,Default,,0,0,0,,Оны басқалардан құпия сақтаңыз.
Dialogue: 0,0:21:29.50,0:21:33.64,Default,,0,0,0,,Соның арқасында мен енді мотоцикл айдай аламын.
Dialogue: 0,0:21:41.65,0:21:45.61,Default,,0,0,0,,GP шабандозының жаттығуы бойынша баллдар?
Dialogue: 0,0:21:47.53,0:21:50.90,Default,,0,0,0,,Сол қасиетті аға
Dialogue: 0,0:21:50.90,0:21:53.96,Default,,0,0,0,,Мен мұны барлығына үнсіз қалдырамын.
Dialogue: 0,0:21:53.96,0:21:57.38,Default,,0,0,0,,Менің жылап жатқанымды жасыруыңызды өтінемін.
Dialogue: 0,0:21:59.04,0:22:00.64,Default,,0,0,0,,Түсінікті.
