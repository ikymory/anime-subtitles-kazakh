Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:10.00,0:00:15.00,,,0,0,0,,Бұл субтитр ✿Hanago және Chinatsu FanSubs✿-пен бірлесіп берілген.
Dialogue: 0,0:04:42.60,0:04:45.30,1080,,0,0,0,,Есептегішті қалпына келтіру: Қысқа қашықтықтағы пайдаланылған велосипедтерді жоғары бағаға сатуға болады, сондықтан есептегішті қайтаратын компаниялар бар. Бұл қылмыс.
Dialogue: 0,0:12:35.15,0:12:38.55,1080,,0,0,0,,Бейбітшілік: Байкерлердің сәлемдесу, бір-бірінің жанынан өтуі және гастрольдік орындарда тыныштық деңгейі жоғары. Онса мағынасын мүлде бұрмалаған.
Dialogue: 0,0:00:03.96,0:00:06.92,1080,,0,0,0,,Хикае Хикае Хикаэору
Dialogue: 0,0:00:06.92,0:00:09.88,1080,,0,0,0,,Осы лицензияны көре аласыз ба?
Dialogue: 0,0:00:09.88,0:00:12.40,1080,,0,0,0,,Сіз оны ақырында түсіндіңіз бе?
Dialogue: 0,0:00:12.40,0:00:14.23,1080,,0,0,0,,Сіз мұны жасадыңыз Ханане
Dialogue: 0,0:01:45.59,0:01:49.51,1080,,0,0,0,,Қараңдар, мен де пайдаланылған мотоцикл журналын сатып алдым.
Dialogue: 0,0:01:49.78,0:01:51.26,1080,,0,0,0,,Мен оны сатып алуға дайынмын.
Dialogue: 0,0:01:51.26,0:01:54.84,1080,,0,0,0,,Бірақ мен қайсысын істейтінімді білмеймін.
Dialogue: 0,0:01:55.17,0:01:57.61,1080,,0,0,0,,Сыртқы түрі – ең маңыздысы
Dialogue: 0,0:01:57.61,0:01:59.78,1080,,0,0,0,,Келесі модель жылы және жүгіріс.
Dialogue: 0,0:01:59.78,0:02:01.52,1080,,0,0,0,,Екінші қолды сатып алғыңыз келе ме?
Dialogue: 0,0:02:01.52,0:02:03.83,1080,,0,0,0,,Менің Катанам жаңа.
Dialogue: 0,0:02:03.83,0:02:07.14,1080,,0,0,0,,Жаңа көлік болса да, мен оны сен туғанда сатып алдым.
Dialogue: 0,0:02:07.14,0:02:08.64,1080,,0,0,0,,16 жаста шығар
Dialogue: 0,0:02:08.64,0:02:11.39,1080,,0,0,0,,Катананың 250cc көлемі туралы не деуге болады?
Dialogue: 0,0:02:11.39,0:02:13.40,1080,,0,0,0,,Рин-Чанмен бірдей ме?
Dialogue: 0,0:02:13.40,0:02:15.93,1080,,0,0,0,,Бір көлік үлгісі болса да
Dialogue: 0,0:02:15.93,0:02:18.58,1080,,0,0,0,,Қозғалтқыштың кішірек ығысуын кездейсоқ ұсыну
Dialogue: 0,0:02:18.58,0:02:21.95,1080,,0,0,0,,Катана шабандозының орын ауыстыруына сәйкестігі қорқынышты
Dialogue: 0,0:02:23.34,0:02:24.62,1080,,0,0,0,,Таңғалатын ештеңе жоқ — кенеттен біздің көптеген жолдастарымыз қаза тауып жатыр.
Dialogue: 0,0:02:24.62,0:02:26.48,1080,,0,0,0,,Суфора жоқ
Dialogue: 0,0:02:26.48,0:02:30.45,1080,,0,0,0,,Мен әдеттегідей сатылатын машинаның жаттығу көлігінен басқаша екенін естідім.
Dialogue: 0,0:02:30.78,0:02:32.93,1080,,0,0,0,,Суфор?
Dialogue: 0,0:02:32.93,0:02:34.28,1080,,0,0,0,,Пайдасыз емес
Dialogue: 0,0:02:34.28,0:02:36.00,1080,,0,0,0,,Өте тамаша
Dialogue: 0,0:02:36.00,0:02:36.98,1080,,0,0,0,,Содан кейін...
Dialogue: 0,0:02:36.98,0:02:39.27,1080,,0,0,0,,Дегенмен, бұл өте тамаша.
Dialogue: 0,0:02:39.88,0:02:43.71,1080,,0,0,0,,Мотоциклдер бірінен соң бірі ауыстырылатын нәрсе.
Dialogue: 0,0:02:43.71,0:02:47.51,1080,,0,0,0,,Дегенмен, егер сіз суфуорға мінсеңіз, келесі сатып алатын нәрсе - суфуор.
Dialogue: 0,0:02:47.51,0:02:50.32,1080,,0,0,0,,Үлкен мотоцикл лицензиясын алудың қажеті жоқ
Dialogue: 0,0:02:50.32,0:02:53.97,1080,,0,0,0,,Басқа мотоциклді білмей-ақ, мотоциклді пайдалану мерзімін аяқтаңыз.
Dialogue: 0,0:02:53.97,0:02:56.22,1080,,0,0,0,,Суфораны таңдайтын адам
Dialogue: 0,0:02:56.22,0:02:57.80,1080,,0,0,0,,Яғни алдаусыз.
Dialogue: 0,0:02:57.80,0:03:01.92,1080,,0,0,0,,Өмірінде бір ғана еркекті танитын әйел сияқты.
Dialogue: 0,0:03:02.09,0:03:04.42,1080,,0,0,0,,Бұл жаман нәрсе ме?
Dialogue: 0,0:03:04.42,0:03:06.45,1080,,0,0,0,,Катана менімен жақсы
Dialogue: 0,0:03:06.45,0:03:09.48,1080,,0,0,0,,Мен қателескен шығармын.
Dialogue: 0,0:03:09.48,0:03:10.76,1080,,0,0,0,,Әй, қарашы
Dialogue: 0,0:03:10.76,0:03:14.24,1080,,0,0,0,,Бұл дүкен Суфуор мен Катананы өте арзан сатады.
Dialogue: 0,0:03:14.24,0:03:16.15,1080,,0,0,0,,Қандай керемет дүкен
Dialogue: 0,0:03:16.15,0:03:19.28,1080,,0,0,0,,Сонымен, Nikoichi Motors.
Dialogue: 0,0:03:19.28,0:03:22.37,1080,,0,0,0,,Ол дүкеннен алыс болған дұрыс.
Dialogue: 0,0:03:22.37,0:03:23.46,1080,,0,0,0,,Неліктен?
Dialogue: 0,0:03:23.46,0:03:27.01,1080,,0,0,0,,Жоқ...Негізі мен Серовты сол жерден сатып алдым.
Dialogue: 0,0:03:27.01,0:03:28.84,1080,,0,0,0,,Мен өзімді үнемі нашар сезінемін.
Dialogue: 0,0:03:28.84,0:03:32.13,1080,,0,0,0,,Менің ойымша, сіз өте әлсіз болғандықтан ұсталды деп ойлаймын.
Dialogue: 0,0:03:32.13,0:03:34.36,1080,,0,0,0,,Бұндай нәрсе – білгіш.
Dialogue: 0,0:03:34.36,0:03:36.30,1080,,0,0,0,,Мен солай ойлаймын.
Dialogue: 0,0:03:36.30,0:03:38.05,1080,,0,0,0,,Әйтеуір, кеттік.
Dialogue: 0,0:03:38.05,0:03:41.29,1080,,0,0,0,,Егер ол шынымен жұмыс істемесе, жай ғана басқа дүкенге барыңыз.
Dialogue: 0,0:03:55.48,0:03:56.88,1080,,0,0,0,,Мұнда
Dialogue: 0,0:03:57.67,0:04:00.37,1080,,0,0,0,,Көптеген мотоциклдер
Dialogue: 0,0:04:00.37,0:04:03.02,1080,,0,0,0,,Бірақ олардың барлығы шаң басқан.
Dialogue: 0,0:04:03.02,0:04:05.46,1080,,0,0,0,,Сіз оны күтіп тұрған сияқтысыз.
Dialogue: 0,0:04:07.47,0:04:10.53,1080,,0,0,0,,Менің ойымша, жүгіріс орындалмады.
Dialogue: 0,0:04:10.85,0:04:13.20,1080,,0,0,0,,Осы сияқты нәрсе Катана 250
Dialogue: 0,0:04:13.20,0:04:16.22,1080,,0,0,0,,16 жыл болды, менің салмағым 3000 км-ден сәл ғана асты.
Dialogue: 0,0:04:16.22,0:04:18.32,1080,,0,0,0,,Бірақ жақтау қайта боялған.
Dialogue: 0,0:04:18.32,0:04:20.92,1080,,0,0,0,,Катанаға деген махаббат жоқ. Бұл тот емес.
Dialogue: 0,0:04:20.92,0:04:21.92,1080,,0,0,0,,Бұл рас
Dialogue: 0,0:04:21.92,0:04:25.58,1080,,0,0,0,,Қараңызшы, бұл дүкен жақсы емес.
Dialogue: 0,0:04:25.58,0:04:27.90,1080,,0,0,0,,Басқа дүкенге барайық.
Dialogue: 0,0:04:27.90,0:04:29.22,1080,,0,0,0,,На на
Dialogue: 0,0:04:29.22,0:04:30.26,1080,,0,0,0,,Бір минут күтіңіз
Dialogue: 0,0:04:30.26,0:04:31.87,1080,,0,0,0,,Үлкен әпке
Dialogue: 0,0:04:32.76,0:04:34.54,1080,,0,0,0,,Қайта оралдын.
Dialogue: 0,0:04:34.99,0:04:36.71,1080,,0,0,0,,Үлкен әпке?
Dialogue: 0,0:04:37.77,0:04:40.14,1080,,0,0,0,,Неге оралдың? Онса.
Dialogue: 0,0:04:40.14,0:04:42.60,1080,,0,0,0,,Мен мұны бірден сұраймын.
Dialogue: 0,0:04:42.60,0:04:45.30,1080,,0,0,0,,Әдеттегідей есептегішті қайтарыңыз.
Dialogue: 0,0:04:46.62,0:04:49.75,1080,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:04:50.51,0:04:52.85,1080,,0,0,0,,Ал...
Dialogue: 0,0:04:55.43,0:04:57.90,1080,,0,0,0,,Міне, менің дүкенімде
Dialogue: 0,0:04:59.40,0:05:03.11,1080,,0,0,0,,Жоқ, мен оны жасырғым келмеді.
Dialogue: 0,0:05:03.11,0:05:06.78,1080,,0,0,0,,Көріп отырғаныңыздай, бұл өте заңды велосипед дүкені емес.
Dialogue: 0,0:05:13.48,0:05:15.40,1080,,0,0,0,,Жарайды, енді іске кірісейік.
Dialogue: 0,0:05:14.09,0:05:15.90,1080,,0,0,0,,Сіз қайдан білесіз?
Dialogue: 0,0:05:15.90,0:05:17.79,1080,,0,0,0,,Жоқ, ол анықталды.
Dialogue: 0,0:05:17.79,0:05:20.44,1080,,0,0,0,,Бір цилиндрдің өлгенін қайдан білдің?
Dialogue: 0,0:05:20.44,0:05:22.34,1080,,0,0,0,,Қозғалмаса да
Dialogue: 0,0:05:22.97,0:05:25.36,1080,,0,0,0,,Әй, менің де Серуым.
Dialogue: 0,0:05:25.36,0:05:28.38,1080,,0,0,0,,Мен екі керексіз көлікті жапсыру арқылы жасадым.
Dialogue: 0,0:05:28.38,0:05:30.96,1080,,0,0,0,,Бұл мүмкін бе?
Dialogue: 0,0:05:30.96,0:05:32.81,1080,,0,0,0,,Көп нәрсе болды, бірақ ақыры өз орныңды тапқан сияқтысың.
Dialogue: 0,0:05:38.43,0:05:40.54,1080,,0,0,0,,Генетика қорқынышты.
Dialogue: 0,0:05:40.54,0:05:43.23,1080,,0,0,0,,Мен әкеме ұқсамайтыныма қуаныштымын.
Dialogue: 0,0:05:44.21,0:05:48.72,1080,,0,0,0,,Түсіндім, мұнда жақсы мотоциклдер жоқ па?
Dialogue: 0,0:05:53.15,0:05:55.82,1080,,0,0,0,,Эй, бұл не катана?
Dialogue: 0,0:05:55.82,0:05:59.99,1080,,0,0,0,,Глушитель ішінен кептірілген шаян мен теңіз балдыры шықты.
Dialogue: 0,0:05:59.99,0:06:02.59,1080,,0,0,0,,Бұл суға батқан көлік.
Dialogue: 0,0:06:02.59,0:06:05.43,1080,,0,0,0,,Балалар, сендер ақаулы велосипедтерге толы емессіңдер.
Dialogue: 0,0:06:05.43,0:06:08.29,1080,,0,0,0,,Өндірушінің агенті Оларды алып тастау таңқаларлық емес.
Dialogue: 0,0:06:08.29,0:06:11.73,1080,,0,0,0,,Мен саған Хананның велосипедін осындай қорқынышты дүкеннен сатып алуға рұқсат ете алмаймын.
Dialogue: 0,0:06:11.73,0:06:14.83,1080,,0,0,0,,Сондықтан басынан тоқтаған дұрыс дедім.
Dialogue: 0,0:06:14.83,0:06:17.29,1080,,0,0,0,,Әпкеңді қорлама
Dialogue: 0,0:06:16.49,0:06:18.54,1080,,0,0,0,,Үлкен кеуделі жын
Dialogue: 0,0:06:18.54,0:06:21.29,1080,,0,0,0,,Қызғылт суфор
Dialogue: 0,0:06:25.74,0:06:28.32,1080,,0,0,0,,Қалай ойлайсыңдар, осылайша кәсіппен айналысу дұрыс па?
Dialogue: 0,0:06:28.32,0:06:29.60,1080,,0,0,0,,Мен білемін
Dialogue: 0,0:06:29.60,0:06:31.40,1080,,0,0,0,,Мен білемін.
Dialogue: 0,0:06:31.40,0:06:34.24,1080,,0,0,0,,Менің айтарым, біз ең нашар велосипед дүкеніміз.
Dialogue: 0,0:06:34.24,0:06:37.40,1080,,0,0,0,,Бірақ мен есептегіші артқы жағы бар арзан велосипед саттым.
Dialogue: 0,0:06:37.40,0:06:40.51,1080,,0,0,0,,Біздің ағаларымыз осы уақытқа дейін өсті.
Dialogue: 0,0:06:40.51,0:06:44.51,1080,,0,0,0,,Тіпті Рин менің үйіме арзан болғандықтан келді.
Dialogue: 0,0:06:44.96,0:06:48.26,1080,,0,0,0,,Мұндай велосипедті қалайтын тұтынушылар бар.
Dialogue: 0,0:06:48.26,0:06:50.47,1080,,0,0,0,,Бірақ...
Dialogue: 0,0:06:50.47,0:06:54.19,1080,,0,0,0,,Мен Хейннің кем дегенде лайықты велосипед сатып алғанын қалаймын.
Dialogue: 0,0:06:54.64,0:06:58.07,1080,,0,0,0,,Онса-чан, мен шештім.
Dialogue: 0,0:06:58.43,0:07:00.85,1080,,0,0,0,,Мен бұл мотоциклді сатып аламын
Dialogue: 0,0:07:00.85,0:07:03.52,1080,,0,0,0,,Мына қызғылт суфо
Dialogue: 0,0:07:03.52,0:07:05.74,1080,,0,0,0,,Ханане есі дұрыс па?
Dialogue: 0,0:07:05.74,0:07:07.77,1080,,0,0,0,,Неге байсалдысың?
Dialogue: 0,0:07:07.77,0:07:09.26,1080,,0,0,0,,Миссия аяқталған соң маған үйлен.
Dialogue: 0,0:07:09.26,0:07:10.92,1080,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:07:11.51,0:07:14.65,1080,,0,0,0,,Хане: Бізден велосипед сатып алмаңыз.
Dialogue: 0,0:07:15.22,0:07:18.19,1080,,0,0,0,,Басқа да көптеген сенімді дүкендер бар.
Dialogue: 0,0:07:18.19,0:07:18.96,1080,,0,0,0,,Сонымен...
Dialogue: 0,0:07:18.96,0:07:20.25,1080,,0,0,0,,Онса-чан
Dialogue: 0,0:07:20.25,0:07:24.13,1080,,0,0,0,,Маған басқалар ұнайтын мотоциклдің түрі ұнамайды.
Dialogue: 0,0:07:24.13,0:07:27.05,1080,,0,0,0,,Мен қай дүкенге сенетінімді білмеймін
Dialogue: 0,0:07:27.05,0:07:29.28,1080,,0,0,0,,Бірақ мотоциклдерге келгенде.
Dialogue: 0,0:07:29.28,0:07:31.44,1080,,0,0,0,,Мен Онса-чанға сенемін
Dialogue: 0,0:07:31.44,0:07:34.51,1080,,0,0,0,,Сондықтан мен оны Онса-чанның дүкенінен аламын.
Dialogue: 0,0:07:35.11,0:07:36.56,1080,,0,0,0,,Қанат дыбысы
Dialogue: 0,0:07:36.56,0:07:39.22,1080,,0,0,0,,Жоқ, мүлдем жоқ.
Dialogue: 0,0:07:39.22,0:07:42.87,1080,,0,0,0,,Мен сізге мұндай дүкеннен велосипед сатып алуға рұқсат бермеймін...
Dialogue: 0,0:07:43.34,0:07:44.99,1080,,0,0,0,,Бұл қандай дыбыс?
Dialogue: 0,0:07:45.48,0:07:48.00,1080,,0,0,0,,О, Сузуноги, біраз уақыт өтті.
Dialogue: 0,0:07:48.00,0:07:49.14,1080,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:07:49.14,0:07:51.21,1080,,0,0,0,,Суға батқан жақсы көлік бар ма?
Dialogue: 0,0:07:51.21,0:07:52.43,1080,,0,0,0,,Иә, бір жағынан солай.
Dialogue: 0,0:07:52.43,0:07:56.94,1080,,0,0,0,,Айтпақшы, сіз баяғыда сатып алған су астында қалған Катана 400 не болды?
Dialogue: 0,0:07:56.94,0:07:59.99,1080,,0,0,0,,Әй, қызым дәл қазір мініп жүр.
Dialogue: 0,0:08:00.51,0:08:02.31,1080,,0,0,0,,Себебі есептегішті қайтардым.
Dialogue: 0,0:08:02.31,0:08:05.25,1080,,0,0,0,,Менің ойымша, ол жаңа көлік сатып алды.
Dialogue: 0,0:08:07.64,0:08:09.29,1080,,0,0,0,,Жақында кездескенше
Dialogue: 0,0:08:14.81,0:08:17.70,1080,,0,0,0,,Са Ханане, мына суфурды сатып ал.
Dialogue: 0,0:08:17.70,0:08:19.22,1080,,0,0,0,,О, сен шештің бе?
Dialogue: 0,0:08:19.22,0:08:20.92,1080,,0,0,0,,Ал, есептегішті бірден қосайық.
Dialogue: 0,0:08:20.92,0:08:21.93,1080,,0,0,0,,Миссия аяқталған соң маған үйлен.
Dialogue: 0,0:08:22.63,0:08:24.27,1080,,0,0,0,,Онса-чан
Dialogue: 0,0:08:24.27,0:08:28.26,1080,,0,0,0,,Уайымдама, Хане, мен әкеңнің саған тиісуіне мүлде жол бермеймін.
Dialogue: 0,0:08:28.26,0:08:31.43,1080,,0,0,0,,Мен сіздің барлық велосипедтеріңізді күтемін.
Dialogue: 0,0:08:31.43,0:08:33.46,1080,,0,0,0,,OK
Dialogue: 0,0:08:33.46,0:08:35.59,1080,,0,0,0,,Онса-чанға рахмет
Dialogue: 0,0:08:40.21,0:08:42.50,1080,,0,0,0,,Әкем сатып алуға болатынын айтты.
Dialogue: 0,0:08:42.50,0:08:45.02,1080,,0,0,0,,36 есе несие?
Dialogue: 0,0:08:45.02,0:08:47.04,1080,,0,0,0,,Мен орта мектепті бітіргенше.
Dialogue: 0,0:08:47.04,0:08:49.24,1080,,0,0,0,,Олай болса, мөрді шығарыңыз.
Dialogue: 0,0:08:49.24,0:08:52.69,1080,,0,0,0,,Әпке, тіркелген пломбаны баспас бұрын оның үстіңгі және астыңғы жағын тексеріңіз...
Dialogue: 0,0:09:00.01,0:09:03.47,1080,,0,0,0,,Сенім тек сөз бе?
Dialogue: 0,0:09:03.47,0:09:06.81,1080,,0,0,0,,Мен арзан әйелмін.
Dialogue: 0,0:09:13.21,0:09:14.85,1080,,0,0,0,,Қолданылады ма?
Dialogue: 0,0:09:14.85,0:09:18.72,1080,,0,0,0,,Егер мен жаныңда болсам, саған бұл велосипедті сатып алуға рұқсат етпес едім.
Dialogue: 0,0:09:18.72,0:09:19.80,1080,,0,0,0,,Жарайды.
Dialogue: 0,0:09:19.80,0:09:23.34,1080,,0,0,0,,Өйткені маған бұл қызғылт суфо ұнайды
Dialogue: 0,0:09:23.34,0:09:25.91,1080,,0,0,0,,Ханане Бұл бонус.
Dialogue: 0,0:09:26.59,0:09:28.68,1080,,0,0,0,,Қызғылт дулыға
Dialogue: 0,0:09:28.68,0:09:29.78,1080,,0,0,0,,Рахмет
Dialogue: 0,0:09:29.78,0:09:30.77,1080,,0,0,0,,Қараңыз
Dialogue: 0,0:09:31.51,0:09:34.52,1080,,0,0,0,,Шындығында, мен Ханеге ризамын.
Dialogue: 0,0:09:34.52,0:09:37.49,1080,,0,0,0,,Мен мотоциклге қызықпаған қанаттардың дыбысын естідім.
Dialogue: 0,0:09:37.49,0:09:39.06,1080,,0,0,0,,Лицензияңызды алуға рұқсат етіңіз.
Dialogue: 0,0:09:39.06,0:09:41.68,1080,,0,0,0,,Мен оны велосипед сатып алатындай дәрежеге жеткіздім.
Dialogue: 0,0:09:41.68,0:09:45.64,1080,,0,0,0,,Бұл менің өмірімде мақтан тұтатын нәрсе.
Dialogue: 0,0:09:45.64,0:09:48.37,1080,,0,0,0,,Жоқ, мен әлі білмеймін.
Dialogue: 0,0:09:48.37,0:09:49.81,1080,,0,0,0,,Өйткені...
Dialogue: 0,0:10:10.27,0:10:12.21,1080,,0,0,0,,Дұрыс, Ханане.
Dialogue: 0,0:10:21.64,0:10:25.17,1080,,0,0,0,,Мен дәл қазір үлкен жылдамдықпен жүгіріп келе жатқан сияқтымын.
Dialogue: 0,0:10:25.17,0:10:26.91,1080,,0,0,0,,Бұл сұмдық.
Dialogue: 0,0:10:26.91,0:10:31.90,1080,,0,0,0,,Мүмкін, бірақ мен оны велосипедіме отырғызуым керек деп ойламаймын.
Dialogue: 0,0:10:31.90,0:10:33.67,1080,,0,0,0,,Иә.
Dialogue: 0,0:10:36.28,0:10:39.29,1080,,0,0,0,,Иә, мен әлі білмеймін
Dialogue: 0,0:10:40.29,0:10:41.85,1080,,0,0,0,,Барлығы
Dialogue: 0,0:10:45.39,0:10:47.21,1080,,0,0,0,,Өйткені бұл болғалы тұр
Dialogue: 0,0:10:49.41,0:10:51.97,1080,,0,0,0,,Қызық, түсінеді ме?
Dialogue: 0,0:10:51.97,0:10:55.28,1080,,0,0,0,,Ішінде аз ғана бензин бар.
Dialogue: 0,0:10:59.73,0:11:02.75,1080,,0,0,0,,Менің бензинім таусылды.
Dialogue: 0,0:11:21.70,0:11:24.00,1080,,0,0,0,,Өзін жақсы сезіну
Dialogue: 0,0:11:24.00,0:11:25.60,1080,,0,0,0,,Аспан ашық
Dialogue: 0,0:11:25.60,0:11:27.20,1080,,0,0,0,,Гастрольдік сапарға тамаша күн.
Dialogue: 0,0:11:27.20,0:11:28.58,1080,,0,0,0,,Бұл рас.
Dialogue: 0,0:11:28.58,0:11:30.84,1080,,0,0,0,,Рин-Чанның да келгенін қалаймын.
Dialogue: 0,0:11:30.84,0:11:33.89,1080,,0,0,0,,Жоқ, бірақ олай емес...
Dialogue: 0,0:11:33.89,0:11:36.62,1080,,0,0,0,,гастрольде ме?
Dialogue: 0,0:11:36.62,0:11:39.80,1080,,0,0,0,,Мотоцикл - жалғыз көлік.
Dialogue: 0,0:11:39.80,0:11:42.28,1080,,0,0,0,,Басқа адамдармен жүгіру - күлкілі.
Dialogue: 0,0:11:42.28,0:11:43.68,1080,,0,0,0,,Мұны істеу мүмкін емес.
Dialogue: 0,0:11:43.68,0:11:44.82,1080,,0,0,0,,Күте тұрыңыз, Рин.
Dialogue: 0,0:11:44.82,0:11:46.46,1080,,0,0,0,,Сіз неге шағымданасыз?
Dialogue: 0,0:11:46.46,0:11:49.04,1080,,0,0,0,,Біріншіден, сіз мотоцикл клубының мүшесі емессіз.
Dialogue: 0,0:11:49.04,0:11:51.28,1080,,0,0,0,,Сондықтан мен сені шақырмадым.
Dialogue: 0,0:11:51.28,0:11:52.26,1080,,0,0,0,,Не
Dialogue: 0,0:11:52.26,0:11:54.90,1080,,0,0,0,,Мен велосипед тепкен сыныптастарымды шақырмаймын.
Dialogue: 0,0:11:54.90,0:11:56.58,1080,,0,0,0,,Менің ойымша, сіз бармайсыз.
Dialogue: 0,0:11:56.58,0:11:57.70,1080,,0,0,0,,Мен бармаймын.
Dialogue: 0,0:11:57.70,0:11:59.13,1080,,0,0,0,,Жақсы емес пе?
Dialogue: 0,0:11:59.13,0:12:00.70,1080,,0,0,0,,Мәселе бұл емес.
Dialogue: 0,0:12:00.70,0:12:03.23,1080,,0,0,0,,Сей Чан, бұл не?
Dialogue: 0,0:12:03.23,0:12:05.58,1080,,0,0,0,,Бұл сымсыз гарнитура.
Dialogue: 0,0:12:05.58,0:12:06.72,1080,,0,0,0,,Егер сіз мұны істесеңіз
Dialogue: 0,0:12:06.72,0:12:09.17,1080,,0,0,0,,Велосипедте отырып сөйлесе аласыз.
Dialogue: 0,0:12:09.17,0:12:10.90,1080,,0,0,0,,Бұл жеткілікті.
Dialogue: 0,0:12:10.90,0:12:13.99,1080,,0,0,0,,Қазір сұрасаң да бармаймын.
Dialogue: 0,0:12:15.17,0:12:17.72,1080,,0,0,0,,Жоқ, мен сізді шақырмадым.
Dialogue: 0,0:12:17.72,0:12:19.29,1080,,0,0,0,,Анрема?
Dialogue: 0,0:12:20.01,0:12:21.86,1080,,0,0,0,,Қасиетті деген не?
Dialogue: 0,0:12:21.86,0:12:23.38,1080,,0,0,0,,Бұл құлаққап.
Dialogue: 0,0:12:23.38,0:12:28.29,1080,,0,0,0,,Бұны орнатпасақ, дауысымыз естілмейді.
Dialogue: 0,0:12:35.15,0:12:38.55,1080,,0,0,0,,Эй, эй, неге бәрі фигура жасап жатыр?
Dialogue: 0,0:12:38.86,0:12:42.99,1080,,0,0,0,,Болды, жас ханым, мен сұрайын дегенім 20 000 иен қанша тұрады?
Dialogue: 0,0:12:43.57,0:12:45.94,1080,,0,0,0,,Сондықтан мен осылай жауап беремін.
Dialogue: 0,0:12:45.94,0:12:48.51,1080,,0,0,0,,50,000 дұрыс.
Dialogue: 0,0:12:50.34,0:12:52.91,1080,,0,0,0,,Бірақ ақшаны не істейсің?
Dialogue: 0,0:12:52.91,0:12:54.80,1080,,0,0,0,,Дұрыс.
Dialogue: 0,0:12:54.80,0:12:56.95,1080,,0,0,0,,Көңілді әңгімелесу... т.б.
Dialogue: 0,0:12:56.95,0:12:59.87,1080,,0,0,0,,Сіз құлаққапты киіп дұрыс істедіңіз.
Dialogue: 0,0:12:59.87,0:13:02.77,1080,,0,0,0,,Иә, бұл өте қызықты көрінеді.
Dialogue: 0,0:13:03.42,0:13:06.53,1080,,0,0,0,,Біраз уақыттан бері сөз жоқ па?
Dialogue: 0,0:13:06.53,0:13:08.40,1080,,0,0,0,,Кейде біреудің дауысы
Dialogue: 0,0:13:08.40,0:13:11.64,1080,,0,0,0,,Катана Катана Катана
Dialogue: 0,0:13:11.64,0:13:15.70,1080,,0,0,0,,Катана мінгенде
Dialogue: 0,0:13:15.70,0:13:19.19,1080,,0,0,0,,Бас басы
Dialogue: 0,0:13:19.19,0:13:23.49,1080,,0,0,0,,Менің басым күлкілі болып қалады
Dialogue: 0,0:13:19.36,0:13:21.76,1080,,0,0,0,,Бұл дауыс шынымен Рин ба?
Dialogue: 0,0:13:21.76,0:13:24.55,1080,,0,0,0,,Сіз жақын жерде жүрген сияқтысыз.
Dialogue: 0,0:13:23.56,0:13:27.03,1080,,0,0,0,,Катана Катана Катана
Dialogue: 0,0:13:24.55,0:13:28.02,1080,,0,0,0,,Бірақ мен құлаққапты тағуды ұмытып кетіппін, сондықтан бұл дауыс...
Dialogue: 0,0:13:27.03,0:13:31.12,1080,,0,0,0,,Катана мінгенде
Dialogue: 0,0:13:28.02,0:13:29.02,1080,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:13:29.02,0:13:31.47,1080,,0,0,0,,Олай болса, бұл оғаш әнді тоқтата алмаймыз ба?
Dialogue: 0,0:13:31.47,0:13:33.85,1080,,0,0,0,,Можаның велосипеді табылды
Dialogue: 0,0:13:35.71,0:13:38.42,1080,,0,0,0,,Мен сені қуып бара жатқанымды білмеймін
Dialogue: 0,0:13:38.42,0:13:39.86,1080,,0,0,0,,Мені сүюге тиіс еді! Мені сүюге тиіс!
Dialogue: 0,0:13:38.42,0:13:39.86,1080,,0,0,0,,Иә…♡
Dialogue: 0,0:13:40.27,0:13:42.13,1080,,0,0,0,,Сен неге өтіп бара жатырсың?
Dialogue: 0,0:13:42.13,0:13:45.36,1080,,0,0,0,,Можадағы Серовқа қарай зымыран ұшыру
Dialogue: 0,0:13:47.59,0:13:49.68,1080,,0,0,0,,Серовты жеңу
Dialogue: 0,0:13:47.99,0:13:50.72,1080,,0,0,0,,Ол сондай ұятсыз еліктеуіш
Dialogue: 0,0:13:50.72,0:13:52.38,1080,,0,0,0,,Рин Чан керемет
Dialogue: 0,0:13:52.38,0:13:54.74,1080,,0,0,0,,Осы қарқынмен мен күлкіден өлемін.
Dialogue: 0,0:13:54.74,0:13:58.31,1080,,0,0,0,,Барлығы, Риннің байланыс аймағынан қашыңдар.
Dialogue: 0,0:14:07.28,0:14:10.52,1080,,0,0,0,,Әй, мұндай жерде кездесу қандай кездейсоқтық.
Dialogue: 0,0:14:10.52,0:14:12.78,1080,,0,0,0,,Сіз мұны кездейсоқтық деп көрсеткіңіз келе ме?
Dialogue: 0,0:14:12.78,0:14:15.28,1080,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:14:15.28,0:14:18.30,1080,,0,0,0,,Менің тағы бір жиналысым болды.
Dialogue: 0,0:14:18.30,0:14:19.52,1080,,0,0,0,,Жиналу?
Dialogue: 0,0:14:19.52,0:14:21.87,1080,,0,0,0,,Иә, мен мұны істедім.
Dialogue: 0,0:14:21.87,0:14:23.22,1080,,0,0,0,,Қараңыз
Dialogue: 0,0:14:23.22,0:14:26.50,1080,,0,0,0,,Катана 250 жиналысы
Dialogue: 0,0:14:26.50,0:14:28.92,1080,,0,0,0,,Бұл үлкен катана кездесуі
Dialogue: 0,0:14:28.92,0:14:30.73,1080,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:14:33.44,0:14:35.55,1080,,0,0,0,,Үлкенін таңдау керек пе?
Dialogue: 0,0:14:35.55,0:14:36.70,1080,,0,0,0,,Менмендік
Dialogue: 0,0:14:36.70,0:14:38.52,1080,,0,0,0,,Ол қатты жараланған еді...
Dialogue: 0,0:14:38.52,0:14:41.55,1080,,0,0,0,,Бұл дүниеде мен кешіре алмайтын екі нәрсе бар.
Dialogue: 0,0:14:41.55,0:14:43.65,1080,,0,0,0,,Біреуі – біреуді өлтіру
Dialogue: 0,0:14:43.65,0:14:47.82,1080,,0,0,0,,Екіншісі – орташа өлшемді катанада сапқа тұру.
Dialogue: 0,0:14:50.47,0:14:52.35,1080,,0,0,0,,Мен артта қалдым.
Dialogue: 0,0:14:52.35,0:14:53.20,1080,,0,0,0,,О.
Dialogue: 0,0:14:53.20,0:14:56.33,1080,,0,0,0,,Енді сол адамдар жақындап келеді.
Dialogue: 0,0:14:56.33,0:14:58.68,1080,,0,0,0,,Жақсы катана 400
Dialogue: 0,0:14:58.68,0:15:01.41,1080,,0,0,0,,Алдыңғы қос тежегіш!
Dialogue: 0,0:15:01.72,0:15:05.01,1080,,0,0,0,,Бірақ 400-де көлікті тексеру бар.
Dialogue: 0,0:15:05.01,0:15:06.20,1080,,0,0,0,,Оған не болды?
Dialogue: 0,0:15:06.20,0:15:09.22,1080,,0,0,0,,Менің ақшам жоқ еді, сондықтан оны 2 жарымға дейін қысқартудан басқа амалым қалмады.
Dialogue: 0,0:15:09.22,0:15:11.80,1080,,0,0,0,,Бірақ ол кейде үлкен өлшем деп қателеседі.
Dialogue: 0,0:15:11.80,0:15:12.94,1080,,0,0,0,,Оған не болды?
Dialogue: 0,0:15:12.94,0:15:16.23,1080,,0,0,0,,Бұл ең үлкен қуаныш.
Dialogue: 0,0:15:16.23,0:15:18.23,1080,,0,0,0,,Жеңілген
Dialogue: 0,0:15:24.68,0:15:26.48,1080,,0,0,0,,Дәмді
Dialogue: 0,0:15:26.48,0:15:28.93,1080,,0,0,0,,Жұмсақ тофу дәмді
Dialogue: 0,0:15:32.87,0:15:35.42,1080,,0,0,0,,Ханане, сен нені айтып тұрсың?
Dialogue: 0,0:15:35.42,0:15:37.84,1080,,0,0,0,,Рин, мен сені естимін.
Dialogue: 0,0:15:37.84,0:15:38.96,1080,,0,0,0,,Moja?
Dialogue: 0,0:15:38.96,0:15:41.65,1080,,0,0,0,,Тез кел, біз естелік суретке түсейік.
Dialogue: 0,0:15:44.23,0:15:46.06,1080,,0,0,0,,Гарнитура?
Dialogue: 0,0:15:46.06,0:15:48.82,1080,,0,0,0,,Сіз осындай нәрсемен жүгірдіңіз бе?
Dialogue: 0,0:15:48.82,0:15:51.13,1080,,0,0,0,,Не болып жатыр? Бірдеңе айтыңызшы.
Dialogue: 0,0:15:51.13,0:15:53.50,1080,,0,0,0,,Мен суретке түспеймін.
Dialogue: 0,0:15:53.50,0:15:56.38,1080,,0,0,0,,Рин Чан, мен білемін.
Dialogue: 0,0:15:56.38,0:15:57.46,1080,,0,0,0,,Не?
Dialogue: 0,0:15:57.46,0:16:01.00,1080,,0,0,0,,Рин-чан, тек дулығада
Dialogue: 0,0:16:01.00,0:16:03.77,1080,,0,0,0,,Сен адал қыз бола аласың
Dialogue: 0,0:16:04.09,0:16:05.51,1080,,0,0,0,,Дұрыс.
Dialogue: 0,0:16:05.51,0:16:09.22,1080,,0,0,0,,Шыншыл болғаным сонша, тіпті катана әндерін айта бастадым.
Dialogue: 0,0:16:09.22,0:16:09.88,1080,,0,0,0,,На
Dialogue: 0,0:16:09.88,0:16:11.74,1080,,0,0,0,,Тіпті менің Met-те ме?
Dialogue: 0,0:16:11.74,0:16:15.61,1080,,0,0,0,,А, мен де зымыранның ұшырылғанын естідім.
Dialogue: 0,0:16:16.69,0:16:18.46,1080,,0,0,0,,Кел, Рин.
Dialogue: 0,0:16:22.86,0:16:24.99,1080,,0,0,0,,Ең бастысы - катана.
Dialogue: 0,0:16:24.99,0:16:26.07,1080,,0,0,0,,Не?
Dialogue: 0,0:16:26.07,0:16:29.52,1080,,0,0,0,,Балалар сендер менің катанамның қасындасыңдар
Dialogue: 0,0:16:29.52,0:16:32.08,1080,,0,0,0,,Мен саған фольга бол деп жатырмын.
Dialogue: 0,0:16:32.08,0:16:35.58,1080,,0,0,0,,Ол ең көп тапсырыс алған.
Dialogue: 0,0:16:35.58,0:16:38.55,1080,,0,0,0,,Түсіндім, тез кел.
Dialogue: 0,0:16:43.67,0:16:45.43,1080,,0,0,0,,Бұл мотоцикл ме?
Dialogue: 0,0:16:45.43,0:16:47.44,1080,,0,0,0,,Менің сыныбыма иә
Dialogue: 0,0:16:47.44,0:16:50.34,1080,,0,0,0,,Мектепке мотоциклмен баратын балалар бар.
Dialogue: 0,0:16:50.34,0:16:53.86,1080,,0,0,0,,Біз мектепке велосипедпен баруға тыйым салмаймыз.
Dialogue: 0,0:16:53.86,0:16:56.35,1080,,0,0,0,,1 В сыныбынан Минова мырза.
Dialogue: 0,0:16:56.35,0:16:58.58,1080,,0,0,0,,Минова тобының қызы болғандықтан,
Dialogue: 0,0:16:58.58,0:17:01.56,1080,,0,0,0,,Мен орта мектепте оқып жүрген кезімде мен мектепке жаңа ғана баратынмын.
Dialogue: 0,0:17:01.56,0:17:03.74,1080,,0,0,0,,Жоқ, бұл жақсы.
Dialogue: 0,0:17:03.74,0:17:05.57,1080,,0,0,0,,Олар осылай дейді.
Dialogue: 0,0:17:05.57,0:17:07.90,1080,,0,0,0,,Мен сізді мотоцикл клубының мүшесі деп естідім.
Dialogue: 0,0:17:07.90,0:17:09.17,1080,,0,0,0,,Мотоцикл клубы?
Dialogue: 0,0:17:09.17,0:17:10.38,1080,,0,0,0,,Иә
Dialogue: 0,0:17:10.38,0:17:13.49,1080,,0,0,0,,Бірақ бізде ондай клуб жоқ.
Dialogue: 0,0:17:13.49,0:17:16.89,1080,,0,0,0,,Жоқ, бар, Саруяма мырза.
Dialogue: 0,0:17:17.67,0:17:21.68,1080,,0,0,0,,Бұл дәл болды ма деп ойлаймын...
Dialogue: 0,0:17:25.25,0:17:28.53,1080,,0,0,0,,Сіз барлық уақытта сонда болдыңыз, солай емес пе?
Dialogue: 0,0:17:28.53,0:17:30.34,1080,,0,0,0,,Райму Сенпай
Dialogue: 0,0:17:30.34,0:17:33.16,1080,,0,0,0,,Мотоцикл клубы бұзылды ма?
Dialogue: 0,0:17:33.16,0:17:36.44,1080,,0,0,0,,20 жыл бұрын нені айтасыз?
Dialogue: 0,0:17:36.44,0:17:38.71,1080,,0,0,0,,Мен оны мүлдем түсінбеймін.
Dialogue: 0,0:17:38.71,0:17:43.42,1080,,0,0,0,,Студенттер кеңесінің мүшесі маған бұл мектепте мотоцикл клубы жоқ екенін айтты.
Dialogue: 0,0:17:43.42,0:17:45.16,1080,,0,0,0,,Бұл клуб бөлмесі
Dialogue: 0,0:17:45.16,0:17:49.20,1080,,0,0,0,,Райму-сенпай бос бөлмені рұқсатсыз пайдаланып жүрген сияқты.
Dialogue: 0,0:17:49.20,0:17:51.94,1080,,0,0,0,,Маған да бүгін кет деген.
Dialogue: 0,0:17:51.94,0:17:53.78,1080,,0,0,0,,Қандай текко
Dialogue: 0,0:17:53.78,0:17:56.90,1080,,0,0,0,,Сонымен мотоцикл клубы танылмай қалды ма?
Dialogue: 0,0:17:57.61,0:17:59.62,1080,,0,0,0,,Өте өкінішті, Можа.
Dialogue: 0,0:17:59.62,0:18:03.39,1080,,0,0,0,,Осы уақытқа дейін мотоцикл клубына қатысуды ойладым.
Dialogue: 0,0:18:03.39,0:18:06.42,1080,,0,0,0,,Кеттік, Хиджири Ханане.
Dialogue: 0,0:18:06.42,0:18:08.31,1080,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:18:08.31,0:18:09.82,1080,,0,0,0,,Әрине
Dialogue: 0,0:18:09.82,0:18:12.79,1080,,0,0,0,,Біз жаңа мотоцикл клубын өзіміз жасап жатырмыз.
Dialogue: 0,0:18:12.79,0:18:15.55,1080,,0,0,0,,Әдемі велосипед клубы
Dialogue: 0,0:18:16.67,0:18:20.60,1080,,0,0,0,,Рин-чан, осы жерден жаңа мотоцикл клубын ашайық.
Dialogue: 0,0:18:20.60,0:18:21.77,1080,,0,0,0,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:18:23.03,0:18:25.78,1080,,0,0,0,,Кемінде төрт мүше бар ма?
Dialogue: 0,0:18:25.78,0:18:29.24,1080,,0,0,0,,Хане Сакура Хиджири Минова
Dialogue: 0,0:18:29.24,0:18:32.04,1080,,0,0,0,,Онса Амано Райму...
Dialogue: 0,0:18:32.04,0:18:36.33,1080,,0,0,0,,Райму-сенпайдың толық аты-жөнін білетіндер бар ма?
Dialogue: 0,0:18:36.33,0:18:37.41,1080,,0,0,0,,Мен бірге тұратын отбасыммен келдім.
Dialogue: 0,0:18:37.41,0:18:41.43,1080,,0,0,0,,Райму менің фамилиям, немесе менің атым.
Dialogue: 0,0:18:42.30,0:18:45.56,1080,,0,0,0,,Сенпай, сен бүгін жоқсың, сондықтан сұрай алмаймын.
Dialogue: 0,0:18:45.56,0:18:47.61,1080,,0,0,0,,Төртінші адамға не істеу керек
Dialogue: 0,0:18:47.61,0:18:49.46,1080,,0,0,0,,Дұрыс, Рин.
Dialogue: 0,0:18:49.46,0:18:51.90,1080,,0,0,0,,Маған атыңды берші, маған қарызға бер.
Dialogue: 0,0:18:51.90,0:18:54.59,1080,,0,0,0,,Тек аты Бұл жай ғана атау ма?
Dialogue: 0,0:18:57.40,0:19:00.90,1080,,0,0,0,,Дулығаңды ауыстырдың, сенпай.
Dialogue: 0,0:19:04.92,0:19:07.20,1080,,0,0,0,,Тазуко да алдын ала раундта сәтсіздікке ұшырады ма?
Dialogue: 0,0:19:07.20,0:19:11.20,1080,,0,0,0,,Соңында біз, Team Virgin, финалға өттік.
Dialogue: 0,0:19:11.20,0:19:13.51,1080,,0,0,0,,Тек Райму-сенпай.
Dialogue: 0,0:19:14.51,0:19:16.32,1080,,0,0,0,,Райму Сенпай
Dialogue: 0,0:19:16.32,0:19:18.62,1080,,0,0,0,,Біз техникалық қызмет көрсетеміз
Dialogue: 0,0:19:18.62,0:19:22.24,1080,,0,0,0,,Сенпай - Team Virgin үшін маңызды шабандоз.
Dialogue: 0,0:19:22.24,0:19:25.56,1080,,0,0,0,,Жарыс басталғанша жақсылап демалыңыз.
Dialogue: 0,0:19:24.67,0:19:27.89,1080,,0,0,0,,Метрикалық бұрандалар және дюймдік бұрандалар дегеніміз не?
Dialogue: 0,0:19:25.56,0:19:29.11,1080,,0,0,0,,Орта мектептегі механик қыз оны қолдары қара күйде ұстайды.
Dialogue: 0,0:19:29.11,0:19:31.64,1080,,0,0,0,,Өзіңді үлкен қайықта жүргендей көрсет
Dialogue: 0,0:19:41.50,0:19:43.29,1080,,0,0,0,,Соңғы айналым
Dialogue: 0,0:19:43.29,0:19:45.56,1080,,0,0,0,,Райму-сенпай – шың
Dialogue: 0,0:19:45.56,0:19:48.67,1080,,0,0,0,,Біз техникалық қызмет көрсету үшін көп еңбек еткен машиналар
Dialogue: 0,0:19:48.67,0:19:51.40,1080,,0,0,0,,Сен менің ағам болсаң, жеңетініңе сенімдімін.
Dialogue: 0,0:19:51.40,0:19:53.70,1080,,0,0,0,,О, бұл не?
Dialogue: 0,0:19:53.70,0:19:55.24,1080,,0,0,0,,Бұл бұранда емес.
Dialogue: 0,0:19:55.24,0:19:57.70,1080,,0,0,0,,Жоқ, мен оны қатайтуды ұмытып кеттім деп ойлаймын.
Dialogue: 0,0:20:07.61,0:20:10.08,1080,,0,0,0,,Жану
Dialogue: 0,0:20:10.08,0:20:11.46,1080,,0,0,0,,Райму-сенпай
Dialogue: 0,0:20:11.46,0:20:13.26,1080,,0,0,0,,Сенпай, сен әлі көш басындасың.
Dialogue: 0,0:20:13.26,0:20:15.18,1080,,0,0,0,,Егер сіз дойбыны осылай алсаңыз
Dialogue: 0,0:20:15.18,0:20:16.67,1080,,0,0,0,,Райму Сенпай
Dialogue: 0,0:20:18.96,0:20:21.18,1080,,0,0,0,,Ұш
Dialogue: 0,0:20:21.84,0:20:24.20,1080,,0,0,0,,Мен велосипед жаман деп айтпаймын.
Dialogue: 0,0:20:24.20,0:20:28.64,1080,,0,0,0,,Дегенмен, жоғары сынып оқушылары мен мотоциклдердің тіркесімі ең нашар.
Dialogue: 0,0:20:28.64,0:20:32.93,1080,,0,0,0,,Сол кезде оны жөндеген орта мектептегі қыз болмаса...
Dialogue: 0,0:20:34.08,0:20:35.83,1080,,0,0,0,,Содан бері 20 жыл
Dialogue: 0,0:20:35.83,0:20:38.19,1080,,0,0,0,,Мен велосипедтен түстім.
Dialogue: 0,0:20:38.76,0:20:40.73,1080,,0,0,0,,Мен ересек адам болдым.
Dialogue: 0,0:20:41.36,0:20:43.64,1080,,0,0,0,,Бәрі де Райму-сенпай сияқты
Dialogue: 0,0:20:43.64,0:20:46.23,1080,,0,0,0,,Мен мәңгілік мектеп қызы бола алмаймын
Dialogue: 0,0:20:47.11,0:20:49.54,1080,,0,0,0,,Мотоцикл клубына рұқсат етілмейді
Dialogue: 0,0:20:50.43,0:20:51.70,1080,,0,0,0,,Бірақ
Dialogue: 0,0:20:52.49,0:20:56.36,1080,,0,0,0,,Егер сіздің аға буыныңыз мотоциклдермен байланысты барлық қауіптерден қауіпсіз болса.
Dialogue: 0,0:20:56.36,0:20:59.03,1080,,0,0,0,,Сол балаларды қорғағың келсе
Dialogue: 0,0:21:03.02,0:21:06.15,1080,,0,0,0,,Дұрыс, Сенпай, мен саған жақсы нәрсе беремін.
Dialogue: 0,0:21:06.15,0:21:09.73,1080,,0,0,0,,Менің ағам осыны қаласа керек.
Dialogue: 0,0:21:12.03,0:21:15.40,1080,,0,0,0,,Мотоцикл клубының мақұлдануымен құттықтаймыз!
Dialogue: 0,0:21:15.40,0:21:18.52,1080,,0,0,0,,Өмір жасы ұзақ болсын
Dialogue: 0,0:21:18.52,0:21:22.37,1080,,0,0,0,,Есіміңді бергенімді ұмытпа.
Dialogue: 0,0:21:22.37,0:21:25.54,1080,,0,0,0,,Бірақ мен өз атымды жазғаннан бері
Dialogue: 0,0:21:25.54,0:21:27.06,1080,,0,0,0,,Мен қаламасам да, мен...
Dialogue: 0,0:21:27.06,0:21:28.84,1080,,0,0,0,,Бұл туралы.
Dialogue: 0,0:21:28.84,0:21:31.41,1080,,0,0,0,,Райму-сенпайдың атын, сыныбын білдім.
Dialogue: 0,0:21:31.41,0:21:33.75,1080,,0,0,0,,Мен Риннің атын өшіруге тырыстым.
Dialogue: 0,0:21:33.75,0:21:36.80,1080,,0,0,0,,Бірақ қосылғыңыз келсе.
Dialogue: 0,0:21:37.14,0:21:41.63,1080,,0,0,0,,Кім келеді?
Dialogue: 0,0:21:43.86,0:21:46.29,1080,,0,0,0,,Олар сені қумайды.
Dialogue: 0,0:21:51.23,0:21:54.56,1080,,0,0,0,,Сен сол балаларды қорғауың керек емес пе еді?
Dialogue: 0,0:21:55.32,0:21:58.93,1080,,0,0,0,,Бұл бала мотоцикл клубының мүшесі емес пе?
Dialogue: 0,0:21:58.93,0:22:00.53,1080,,0,0,0,,Ахсо
Dialogue: 0,0:23:31.29,0:23:33.78,1080,,0,0,0,,Келесі жолы Бакуон
Dialogue: 0,0:23:33.78,0:23:35.35,1080,,0,0,0,,Ыстық бұлақ
Dialogue: 0,0:23:36.85,0:23:42.85,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
