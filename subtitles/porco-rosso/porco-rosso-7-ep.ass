Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:20.27,0:00:22.27,Default,,0000,0000,0000,,<Шілдедегі «Жұмадағы жол шоуы» бұл...>
Dialogue: 0,0:00:24.31,0:00:27.17,Default,,0000,0000,0000,,<Барлық шедеврлерді бірден таратамыз>
Dialogue: 0,0:00:27.17,0:00:29.36,Default,,0000,0000,0000,,<Оны өткізіп алмаңыз>
Dialogue: 0,0:00:29.36,0:00:31.38,Default,,0000,0000,0000,,<«Friday Roadshow» мобильді сайтында →
Dialogue: 0,0:00:31.38,0:00:34.38,Default,,0000,0000,0000,,«Ghibli» компаниясымен бірлесіп жұмыс істейтін арнайы электрондық хаттар да тегін＞
Dialogue: 0,0:00:36.42,0:00:38.28,Default,,0000,0000,0000,,<Ал бүгін кешкі «Жұмадағы роудшоу» →
Dialogue: 0,0:00:38.28,0:00:42.32,Default,,0000,0000,0000,,Режиссер Хаяо Миядзаки салқындық пен анимация қуанышын әкеледі →
Dialogue: 0,0:00:42.32,0:00:45.36,Default,,0000,0000,0000,,«Порко Россо» мұқият орындалды>
Dialogue: 0,0:00:45.36,0:00:48.36,Default,,0000,0000,0000,,<Танығанша ләззат алыңыз>
Dialogue: 0,0:04:44.57,0:04:49.12,Default,,0000,0000,0000,,♪~ «Шие піскен кезде»
Dialogue: 0,0:04:49.12,0:05:09.16,Default,,0000,0000,0000,,♪~
Dialogue: 0,0:05:09.16,0:05:16.23,Default,,0000,0000,0000,,♪~
Dialogue: 0,0:05:16.23,0:05:30.20,Default,,0000,0000,0000,,
Dialogue: 0,0:05:30.20,0:05:32.05,Default,,0000,0000,0000,,Сәлеметсіз бе.
Dialogue: 0,0:05:32.05,0:05:34.07,Default,,0000,0000,0000,,Porco Rosso қазір ұшып кетіңіз.
Dialogue: 0,0:05:34.07,0:05:37.10,Default,,0000,0000,0000,,Маммут тобы пайда болды. Манмают?
Dialogue: 0,0:05:37.10,0:05:39.96,Default,,0000,0000,0000,,Арзан жұмыс жасама.
Dialogue: 0,0:05:39.96,0:05:42.15,Default,,0000,0000,0000,,Венециядан жалданған кеме нысанаға алынды.
Dialogue: 0,0:05:42.15,0:05:44.34,Default,,0000,0000,0000,,Мен жалақымды тау-кен компаниясына жинап жатырмын.
Dialogue: 0,0:05:44.34,0:05:47.87,Default,,0000,0000,0000,,Барлығы осы ма? иә? О, жоқ... бұл...
Dialogue: 0,0:05:47.87,0:05:50.07,Default,,0000,0000,0000,,Қыздар мектебінің демалыста жүрген оқушылары бортта.
Dialogue: 0,0:05:50.07,0:05:54.94,Default,,0000,0000,0000,,Бұл біраз қымбат. Шарттың 14-бабының 3-тармағы қолданылады.
Dialogue: 0,0:05:54.94,0:05:56.94,Default,,0000,0000,0000,,4-параграф.
Dialogue: 0,0:05:59.99,0:06:01.17,Default,,0000,0000,0000,,Тоқта!
Dialogue: 0,0:06:01.17,0:06:03.37,Default,,0000,0000,0000,,Тоқтатпасаң, мен сені суға батырамын!
Dialogue: 0,0:06:03.37,0:06:05.72,Default,,0000,0000,0000,,Ұрланған! Бұл қарақшы!
Dialogue: 0,0:06:05.72,0:06:08.08,Default,,0000,0000,0000,,Олар қарақшылар емес, олар аспандағы қарақшылар.
Dialogue: 0,0:06:08.08,0:06:28.28,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:06:28.28,0:06:34.17,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:06:34.17,0:06:38.04,Default,,0000,0000,0000,,Гехо! Менің ойымша, күрделі жөндеудің уақыты келді.
Dialogue: 0,0:06:38.04,0:06:58.08,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:06:58.08,0:07:09.69,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:07:09.69,0:07:12.05,Default,,0000,0000,0000,,Сіз зұлым адамдарсыз ба? Бұл дұрыс.
Dialogue: 0,0:07:12.05,0:07:14.08,Default,,0000,0000,0000,,Біз кепілміз. Бұл дұрыс.
Dialogue: 0,0:07:14.08,0:07:17.11,Default,,0000,0000,0000,,Сіз аспан қарақшылары дейсіз бе? Сіз мені өте жақсы білесіз.
Dialogue: 0,0:07:17.11,0:07:20.96,Default,,0000,0000,0000,,Қаңқа! Сен жақсысың.
Dialogue: 0,0:07:20.96,0:07:24.17,Default,,0000,0000,0000,,Тез кел! Мен қазірдің өзінде бос емеспін!
Dialogue: 0,0:07:24.17,0:07:27.20,Default,,0000,0000,0000,,15 адам бар, бірақ барлығын әкелесің бе?
Dialogue: 0,0:07:27.20,0:07:30.56,Default,,0000,0000,0000,,Достарыңды аямайсыңдар ма?
Dialogue: 0,0:07:30.56,0:07:45.21,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:07:45.21,0:07:48.08,Default,,0000,0000,0000,,Сәлем! Эй!
Dialogue: 0,0:07:48.08,0:07:50.10,Default,,0000,0000,0000,,Тым кеш болды ма?
Dialogue: 0,0:07:50.10,0:07:55.48,Default,,0000,0000,0000,,Қызды және алтын теңгелерді ұрлап кетті! Өтінемін, қайтарып алыңыз!
Dialogue: 0,0:07:55.48,0:07:58.48,Default,,0000,0000,0000,,Ол қашып кетті!
Dialogue: 0,0:08:06.26,0:08:09.13,Default,,0000,0000,0000,,Жоқ! Бұл сол емес.
Dialogue: 0,0:08:09.13,0:08:13.16,Default,,0000,0000,0000,,Қате болма, мен олардың айлаларын білемін.
Dialogue: 0,0:08:13.16,0:08:16.19,Default,,0000,0000,0000,,Ол көзден таса болғанша ұшып, бағытын бірден өзгертуі керек.
Dialogue: 0,0:08:16.19,0:08:18.88,Default,,0000,0000,0000,,Өйткені олар кедей және сараң→
Dialogue: 0,0:08:18.88,0:08:21.88,Default,,0000,0000,0000,,Мен газдың ақысын құлықсыз төлеп, осы маңдағы аралға бардым...
Dialogue: 0,0:08:24.10,0:08:25.11,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:08:25.11,0:08:33.03,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:08:33.03,0:08:35.03,Default,,0000,0000,0000,,Бұл...!
Dialogue: 0,0:08:48.01,0:08:51.01,Default,,0000,0000,0000,,Менің уақытым көп емес шығар...
Dialogue: 0,0:08:55.25,0:08:57.25,Default,,0000,0000,0000,,Мен оны жек көремін!
Dialogue: 0,0:09:10.90,0:09:14.10,Default,,0000,0000,0000,,Бұл не? Бұл аралға секіруге арналған көрікті қайық, солай емес пе?
Dialogue: 0,0:09:14.10,0:09:17.13,Default,,0000,0000,0000,,Кя! Шошқа! Эй шошқа!
Dialogue: 0,0:09:17.13,0:09:20.00,Default,,0000,0000,0000,,Шошқа!
Dialogue: 0,0:09:20.00,0:09:25.00,Default,,0000,0000,0000,,Егер сіз осындай жерде ойнасаңыз, сізді топ ұрлап кетеді!
Dialogue: 0,0:09:27.74,0:09:30.74,Default,,0000,0000,0000,,Өте керемет!
Dialogue: 0,0:09:37.17,0:09:42.05,Default,,0000,0000,0000,,(Балалар шуы)
Dialogue: 0,0:09:42.05,0:09:45.91,Default,,0000,0000,0000,,Бұл шулы.
Dialogue: 0,0:09:45.91,0:09:47.27,Default,,0000,0000,0000,,Ұшу! Маған көрсет~
Dialogue: 0,0:09:47.27,0:09:49.96,Default,,0000,0000,0000,,Сәлем! Жоқ!
Dialogue: 0,0:09:49.96,0:09:55.01,Default,,0000,0000,0000,,Тыныш! Тыныш бол! Эй, бірдеңе істе!
Dialogue: 0,0:09:55.01,0:09:59.01,Default,,0000,0000,0000,,Сондықтан мен бәрін өзіңізбен бірге алып кетесіз бе деп сұрадым...
Dialogue: 0,0:09:59.22,0:10:03.10,Default,,0000,0000,0000,,Кішкене ғана, өйткені мен шынымен...
Dialogue: 0,0:10:03.10,0:10:08.15,Default,,0000,0000,0000,,Әдемі~ Ой, қарашы! Қызыл ұшақ!
Dialogue: 0,0:10:08.15,0:10:10.16,Default,,0000,0000,0000,,Қайда? қайда?
Dialogue: 0,0:10:10.16,0:10:12.16,Default,,0000,0000,0000,,Міне, сіз болдыңыз! Эй!
Dialogue: 0,0:10:17.07,0:10:19.07,Default,,0000,0000,0000,,Мен сенің қашып кетуіңе жол бермеймін!
Dialogue: 0,0:10:20.27,0:10:23.13,Default,,0000,0000,0000,,Эй, мұнда!
Dialogue: 0,0:10:23.13,0:10:25.13,Default,,0000,0000,0000,,Бұл Porco Rosso! Мен оны көре алмаймын!
Dialogue: 0,0:10:30.03,0:10:33.06,Default,,0000,0000,0000,,А, жоқ! Ол тоқтады!
Dialogue: 0,0:10:33.06,0:10:37.06,Default,,0000,0000,0000,,Құлап жатырмын! Құлап қалма! Тағы бір ату бар.
Dialogue: 0,0:10:40.97,0:10:44.17,Default,,0000,0000,0000,,Қақпақ~! Сен не істеп жатырсың? Ату, ату! Мені атып таста!
Dialogue: 0,0:10:44.17,0:10:46.17,Default,,0000,0000,0000,,Бұл күшті қызыл жазықтық.
Dialogue: 0,0:10:50.23,0:10:53.23,Default,,0000,0000,0000,,Дұрыс емес. Мазасыздық...
Dialogue: 0,0:11:00.99,0:11:03.20,Default,,0000,0000,0000,,Шошқадан сигнал! «Бұл сенің жоғалтың, мені тыңда».
Dialogue: 0,0:11:03.20,0:11:05.20,Default,,0000,0000,0000,,Шулы!
Dialogue: 0,0:11:08.25,0:11:11.25,Default,,0000,0000,0000,,Келеді! кел! Мында кел! Басыңызды иіңіз!
Dialogue: 0,0:11:14.30,0:11:18.00,Default,,0000,0000,0000,,Қайда? Қайда бардың? О, бұл жасырын!
Dialogue: 0,0:11:18.00,0:11:19.19,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:11:19.19,0:11:28.11,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:11:28.11,0:11:32.99,Default,,0000,0000,0000,,Кя~! Құлды! Батып бара жатыр! Батып бара жатыр!
Dialogue: 0,0:11:32.99,0:11:35.68,Default,,0000,0000,0000,,Батып кетпеңіз! Бұл дирижабль!
Dialogue: 0,0:11:35.68,0:11:38.68,Default,,0000,0000,0000,,Әй...!
Dialogue: 0,0:11:41.24,0:11:43.10,Default,,0000,0000,0000,,Уау! Батып бара жатыр!
Dialogue: 0,0:11:43.10,0:11:46.12,Default,,0000,0000,0000,,Тоқта! қауіпті!
Dialogue: 0,0:11:46.12,0:11:48.14,Default,,0000,0000,0000,,Тоқта! Ол маңызды кепіл!
Dialogue: 0,0:11:48.14,0:11:52.01,Default,,0000,0000,0000,,Уайымдама, біз жүзу үйірмесіненміз.
Dialogue: 0,0:11:52.01,0:11:54.21,Default,,0000,0000,0000,,Жоқ, егер қате болса...!
Dialogue: 0,0:11:54.21,0:11:57.90,Default,,0000,0000,0000,,Шошқадан тағы да байланыс!
Dialogue: 0,0:11:57.90,0:12:03.12,Default,,0000,0000,0000,,«Алтынның жартысын беремін, қалғанын және кепілге қалдырып, оны жоғалтып аламын»?
Dialogue: 0,0:12:03.12,0:12:06.15,Default,,0000,0000,0000,,Әйтпесе бәріңді өлтіремін.
Dialogue: 0,0:12:06.15,0:12:08.01,Default,,0000,0000,0000,,... бірақ! Жарты алтын монета?
Dialogue: 0,0:12:08.01,0:12:13.01,Default,,0000,0000,0000,,Шулы! Жүр, шошқа! Бұл соңғы шайқас!
Dialogue: 0,0:12:18.44,0:12:20.79,Default,,0000,0000,0000,,Жеңдер!
Dialogue: 0,0:12:20.79,0:12:22.98,Default,,0000,0000,0000,,Не!?
Dialogue: 0,0:12:22.98,0:12:23.00,Default,,0000,0000,0000,,Сынған!
Dialogue: 0,0:12:23.00,0:12:26.00,Default,,0000,0000,0000,,Беріңіз! Бағыну!
Dialogue: 0,0:12:31.08,0:12:35.12,Default,,0000,0000,0000,,Қош бол. Қайта ойнаңыз!
Dialogue: 0,0:12:35.12,0:12:37.30,Default,,0000,0000,0000,,Қош бол.
Dialogue: 0,0:12:37.30,0:12:39.82,Default,,0000,0000,0000,,Бір жақсысы, жөндеуге әлі ақшам қалды.
Dialogue: 0,0:12:39.82,0:12:42.82,Default,,0000,0000,0000,,Ақымақ! Үлкен армандарыңыз болсын!
Dialogue: 0,0:12:46.05,0:12:48.91,Default,,0000,0000,0000,,Кя~ Кяхахаха!
Dialogue: 0,0:12:48.91,0:12:52.12,Default,,0000,0000,0000,,Тыныш бол...! Тыныш бол!
Dialogue: 0,0:12:52.12,0:12:56.99,Default,,0000,0000,0000,,А, ол жаққа тартпа, сынып қалады!
Dialogue: 0,0:12:56.99,0:12:59.02,Default,,0000,0000,0000,,Киахаха ахахаха….
Dialogue: 0,0:12:59.02,0:13:01.54,Default,,0000,0000,0000,,Қауіпті Пропеллерге жақындамаңыз!
Dialogue: 0,0:13:01.54,0:13:04.54,Default,,0000,0000,0000,,Пи! Сись!? Онда жасаңыз!
Dialogue: 0,0:13:08.94,0:13:11.14,Default,,0000,0000,0000,,Манмают жігіттері бүгін келе алмайды.
Dialogue: 0,0:13:11.14,0:13:15.02,Default,,0000,0000,0000,,Батыр болып көрінген лас олжашы!
Dialogue: 0,0:13:15.02,0:13:18.05,Default,,0000,0000,0000,,Бірақ бұл жас жігіт американдық, солай ма?
Dialogue: 0,0:13:18.05,0:13:23.43,Default,,0000,0000,0000,,Адриа ұшқышының америкалықтан көмек сұрауы ұят болар еді.
Dialogue: 0,0:13:23.43,0:13:27.13,Default,,0000,0000,0000,,Оның әжесі 1/4 итальяндық.
Dialogue: 0,0:13:27.13,0:13:31.00,Default,,0000,0000,0000,,Қалай болғанда да, егер біз Порко туралы бірдеңе жасамасақ, бәріңіз де қиыншылықта боласыз.
Dialogue: 0,0:13:31.00,0:13:35.00,Default,,0000,0000,0000,,Бірақ 10% шектен шыққан. (Кертис) Тынш!
Dialogue: 0,0:13:36.06,0:13:42.11,Default,,0000,0000,0000,,♪~ «Шие піскен кезде»
Dialogue: 0,0:13:42.11,0:13:56.09,Default,,0000,0000,0000,,♪~
Dialogue: 0,0:13:56.09,0:13:58.11,Default,,0000,0000,0000,,♪~ Әдемі….
Dialogue: 0,0:13:58.11,0:14:18.98,Default,,0000,0000,0000,,♪~
Dialogue: 0,0:14:18.98,0:14:38.18,Default,,0000,0000,0000,,♪~
Dialogue: 0,0:14:38.18,0:14:58.21,Default,,0000,0000,0000,,♪~
Dialogue: 0,0:14:58.21,0:15:17.07,Default,,0000,0000,0000,,♪~
Dialogue: 0,0:15:17.07,0:15:19.08,Default,,0000,0000,0000,,Спорт күні керемет өтті, иә?
Dialogue: 0,0:15:19.08,0:15:22.12,Default,,0000,0000,0000,,Бұл жаман нәрсе. Жай ғана салқын болуға тырысады.
Dialogue: 0,0:15:22.12,0:15:24.13,Default,,0000,0000,0000,,Тыныш.
Dialogue: 0,0:15:24.13,0:15:37.09,Default,,0000,0000,0000,,♪~
Dialogue: 0,0:15:37.09,0:15:38.27,Default,,0000,0000,0000,,Порко Россо мырза!
Dialogue: 0,0:15:38.27,0:15:41.97,Default,,0000,0000,0000,,``Neptune Publishing'' тілшісі ретінде сіз бұл жолы да жақсы жұмыс істедіңіз.
Dialogue: 0,0:15:41.97,0:15:44.00,Default,,0000,0000,0000,,Маммаюто тобы біраз уақытқа дейін қалпына келе алмайды.
Dialogue: 0,0:15:44.00,0:15:47.03,Default,,0000,0000,0000,,Айтпақшы, биылғы жалпы жүлде қоры бойынша қандай болжам бар?
Dialogue: 0,0:15:47.03,0:15:51.07,Default,,0000,0000,0000,,Менің ойымша, бұл өткен жылдан оңай асып түседі, бірақ о! аздап….
Dialogue: 0,0:15:51.07,0:15:54.07,Default,,0000,0000,0000,,Мені жіберуіңізді өтінемін! Сәл күте тұрыңыз... О!
Dialogue: 0,0:15:55.94,0:15:57.30,Default,,0000,0000,0000,,Әнді тыныш тыңдаңыз...!
Dialogue: 0,0:15:57.30,0:16:05.21,Default,,0000,0000,0000,,♪~ (қол шапалақтау)
Dialogue: 0,0:16:05.21,0:16:06.22,Default,,0000,0000,0000,,♪~
Dialogue: 0,0:16:06.22,0:16:08.08,Default,,0000,0000,0000,,Ол керемет адам...
Dialogue: 0,0:16:08.08,0:16:11.27,Default,,0000,0000,0000,,«Адриано қонақ үйіндегі» ханым Джина→
Dialogue: 0,0:16:11.27,0:16:14.80,Default,,0000,0000,0000,,Бұл менің туған жерімдегі дирижабль жүргізушілерінің арасында да танымал.
Dialogue: 0,0:16:14.80,0:16:17.00,Default,,0000,0000,0000,,Ол жерде аспан қарақшылары мен сыйлы аңшылар жақсы жұмыс істейді дейді.
Dialogue: 0,0:16:17.00,0:16:20.03,Default,,0000,0000,0000,,Бұл алдыңғы жақтағы Кертис пе?
Dialogue: 0,0:16:20.03,0:16:24.90,Default,,0000,0000,0000,,Әй, атақ пен ақша әкелетін ырыс-құт.
Dialogue: 0,0:16:24.90,0:16:28.11,Default,,0000,0000,0000,,Бұл екі жыл қатарынан Шнайдер кубогында итальяндық қайықтарды жеңген қайық болды.
Dialogue: 0,0:16:28.11,0:16:32.31,Default,,0000,0000,0000,,Бұл тек жылдамдыққа қатысты емес; ол әуедегі шайқаста да күшті.
Dialogue: 0,0:16:32.31,0:16:35.84,Default,,0000,0000,0000,,Мына жерде Порко Россо деген шошқа бар→
Dialogue: 0,0:16:35.84,0:16:37.03,Default,,0000,0000,0000,,Сіз өз атыңызды сатып жатырсыз, солай емес пе?
Dialogue: 0,0:16:37.03,0:16:40.23,Default,,0000,0000,0000,,Егер сіз аспан қарақшыларымен бірігетін болсаңыз, абай болыңыз, жас жігіт.
Dialogue: 0,0:16:40.23,0:16:42.92,Default,,0000,0000,0000,,Олар сараң, кедей.
Dialogue: 0,0:16:42.92,0:16:45.11,Default,,0000,0000,0000,,Мен тіпті суға түспеймін, сондықтан сасық.
Dialogue: 0,0:16:45.11,0:16:47.13,Default,,0000,0000,0000,,Хэхехе... Әрине.
Dialogue: 0,0:16:47.13,0:16:50.33,Default,,0000,0000,0000,,Не!? Кусаребута, жасайсың ба!?
Dialogue: 0,0:16:50.33,0:16:53.86,Default,,0000,0000,0000,,Не? Бүгін түнде... барлық ұлы адамдар жиналды →
Dialogue: 0,0:16:53.86,0:16:57.23,Default,,0000,0000,0000,,Сізде тағы да жақсылық жоқ па? Басыңыз~.
Dialogue: 0,0:16:57.23,0:17:01.10,Default,,0000,0000,0000,,Келгеніңізге қуаныштымын, бірақ соғыс ойнай алмайсыз.
Dialogue: 0,0:17:01.10,0:17:03.12,Default,,0000,0000,0000,,Мен білемін, Джина.
Dialogue: 0,0:17:03.12,0:17:06.15,Default,,0000,0000,0000,,Бұл дүкеннен 50 км қашықтықта жұмыс жоқ.
Dialogue: 0,0:17:06.15,0:17:09.15,Default,,0000,0000,0000,,Ол тіпті шошқалармен жақсы тіл табысады!
Dialogue: 0,0:17:10.20,0:17:12.55,Default,,0000,0000,0000,,Барлығы жақсы.
Dialogue: 0,0:17:12.55,0:17:14.55,Default,,0000,0000,0000,,Қайта кездескенше.
Dialogue: 0,0:17:24.16,0:17:26.02,Default,,0000,0000,0000,,Порко, маған ертегі айтып берші.
Dialogue: 0,0:17:26.02,0:17:29.02,Default,,0000,0000,0000,,Келесі жолы біз жалғызбыз. Уху...
Dialogue: 0,0:17:37.47,0:17:41.16,Default,,0000,0000,0000,,Американың біртүрлі екені.
Dialogue: 0,0:17:41.16,0:17:44.03,Default,,0000,0000,0000,,Менің жүзімді көрген бойда оған тұрмысқа шығуымды өтінді.
Dialogue: 0,0:17:44.03,0:17:46.05,Default,,0000,0000,0000,,Сондықтан мен саған айттым.
Dialogue: 0,0:17:46.05,0:17:49.08,Default,,0000,0000,0000,,Мен ұшатын қайықшыға үш рет үйлендім→
Dialogue: 0,0:17:49.08,0:17:51.94,Default,,0000,0000,0000,,Бірі соғыста, бірі Атлант мұхитында →
Dialogue: 0,0:17:51.94,0:17:55.94,Default,,0000,0000,0000,,Соңғысы Азияда қайтыс болды...
Dialogue: 0,0:17:57.00,0:18:00.52,Default,,0000,0000,0000,,Түсіндіңіз бе...?
Dialogue: 0,0:18:00.52,0:18:03.05,Default,,0000,0000,0000,,Бүгін маған қоңырау шалды.
Dialogue: 0,0:18:03.05,0:18:07.05,Default,,0000,0000,0000,,Үйінділер Бенгалияның ішкі аймақтарынан табылды...
Dialogue: 0,0:18:12.98,0:18:17.03,Default,,0000,0000,0000,,Үш жыл күттім, Көз жасым кепті...
Dialogue: 0,0:18:17.03,0:18:20.06,Default,,0000,0000,0000,,Барлық жақсылар өледі...
Dialogue: 0,0:18:20.06,0:18:22.25,Default,,0000,0000,0000,,Менің досыма….
Dialogue: 0,0:18:22.25,0:18:27.25,Default,,0000,0000,0000,,Марко, әрқашан жанымда болғаныңыз үшін рахмет.
Dialogue: 0,0:18:33.19,0:18:37.19,Default,,0000,0000,0000,,Енді сен ғана қалдың, ескі досым.
Dialogue: 0,0:18:38.07,0:18:41.93,Default,,0000,0000,0000,,Бұл дүкенде маған ұнамайтын жалғыз нәрсе - →
Dialogue: 0,0:18:41.93,0:18:43.29,Default,,0000,0000,0000,,Бұл фотосуретті жоймаңыз.
Dialogue: 0,0:18:43.29,0:18:47.33,Default,,0000,0000,0000,,Жоқ, жыртып алма... Марко адам болған кезде →
Dialogue: 0,0:18:47.33,0:18:50.33,Default,,0000,0000,0000,,Бұл жалғыз фотосурет қалды.
Dialogue: 0,0:18:52.22,0:18:57.22,Default,,0000,0000,0000,,Мен саған жасалған сиқырды қалай бұза аламын деп ойлаймын.
Dialogue: 0,0:19:16.29,0:19:20.29,Default,,0000,0000,0000,,Мына американдық жігіттің қолдары жақсы.
Dialogue: 0,0:19:30.93,0:19:35.14,Default,,0000,0000,0000,,♪~ (Барабан мен флейта корпусы ойнаған наурыз)
Dialogue: 0,0:19:35.14,0:19:45.14,Default,,0000,0000,0000,,♪~
Dialogue: 0,0:19:48.11,0:19:53.99,Default,,0000,0000,0000,,Мен қызғанамын. Мен де осыншама ақша тапсам деп едім.
Dialogue: 0,0:19:53.99,0:19:55.18,Default,,0000,0000,0000,,Осы айдың төлемі.
Dialogue: 0,0:19:55.18,0:19:57.03,Default,,0000,0000,0000,,Әуе кемелерінің несиелері аяқталды.
Dialogue: 0,0:19:57.03,0:20:01.07,Default,,0000,0000,0000,,Сіз қалай ойлайсыз? Патриоттық облигацияларды сатып алу және т.б. →
Dialogue: 0,0:20:01.07,0:20:03.92,Default,,0000,0000,0000,,Елге үлес қосу туралы не айтасыз?
Dialogue: 0,0:20:03.92,0:20:06.92,Default,,0000,0000,0000,,Адамдар арасында олай емес.
Dialogue: 0,0:20:08.14,0:20:14.14,Default,,0000,0000,0000,,♪～ (наурыз)
Dialogue: 0,0:20:22.11,0:20:25.98,Default,,0000,0000,0000,,Қош келдіңіз, Порко Россо мырза, ол дайын.
Dialogue: 0,0:20:25.98,0:20:28.98,Default,,0000,0000,0000,,Маған 60 оқ беріңіз. иә.
Dialogue: 0,0:20:29.18,0:20:33.06,Default,,0000,0000,0000,,Жерде өте шулы. Солай ма?
Dialogue: 0,0:20:33.06,0:20:35.41,Default,,0000,0000,0000,,Үкімет қайтадан ауыса ма?
Dialogue: 0,0:20:35.41,0:20:39.12,Default,,0000,0000,0000,,Олай болса, сен де заңсыз боласың.
Dialogue: 0,0:20:39.12,0:20:42.98,Default,,0000,0000,0000,,Шошқалардың елі немесе заңдары жоқ.
Dialogue: 0,0:20:42.98,0:20:46.98,Default,,0000,0000,0000,,Хи хи хи! Еш айырмашылығы жоқ, меңдермен бірдей.
Dialogue: 0,0:20:48.04,0:20:50.23,Default,,0000,0000,0000,,Жай ғана әдеттегідей істеу дұрыс па?
Dialogue: 0,0:20:50.23,0:20:53.09,Default,,0000,0000,0000,,Бізде сондай-ақ жоғары өнімді тұтандырғыш және броньды тесіп өтетін оқтар бар.
Dialogue: 0,0:20:53.09,0:20:56.79,Default,,0000,0000,0000,,Бала... біз соғысып жатқан жоқпыз.
Dialogue: 0,0:20:56.79,0:20:59.79,Default,,0000,0000,0000,,Жақында кездескенше. Майдо!
Dialogue: 0,0:21:01.00,0:21:05.21,Default,,0000,0000,0000,,Ұстаз, соғыс пен сыйлы аңшылықтың айырмашылығы неде?
Dialogue: 0,0:21:05.21,0:21:08.24,Default,,0000,0000,0000,,О? Соғыстан ақша табатындар жауыз.
Dialogue: 0,0:21:08.24,0:21:12.24,Default,,0000,0000,0000,,Сыйлықты аңшы ретінде ақша таба алмаған адам қабілетсіз.
Dialogue: 0,0:21:13.96,0:21:17.33,Default,,0000,0000,0000,,Арқасында қарызы бар аспан қарақшысы. Бұл тіпті сурет емес.
Dialogue: 0,0:21:17.33,0:21:21.03,Default,,0000,0000,0000,,Мен ештеңе істей алмаймын, себебі жөндеуге кететін шығындар жиналып қалды.
Dialogue: 0,0:21:21.03,0:21:23.03,Default,,0000,0000,0000,,Бұл одақтың қайығы!
Dialogue: 0,0:21:30.96,0:21:33.99,Default,,0000,0000,0000,,...Таку! Ондай беймаза адамдардың пайда болуына не себеп болды?
Dialogue: 0,0:21:33.99,0:21:36.35,Default,,0000,0000,0000,,Цуруманың қажеті жоқ па? Бұл шошқа кінәлі!
Dialogue: 0,0:21:36.35,0:21:40.06,Default,,0000,0000,0000,,Бұл не? Мамма Ют жігіттері, бояуға ақша төлемейсіздер ме?
Dialogue: 0,0:21:40.06,0:21:42.08,Default,,0000,0000,0000,,Бұл жиіркенішті.
Dialogue: 0,0:21:42.08,0:21:45.11,Default,,0000,0000,0000,,Соңында барлығы осында.
Dialogue: 0,0:21:45.11,0:21:49.15,Default,,0000,0000,0000,,Сәлем! Артқы жағы ше? Американдық жігіттер келе ме?
Dialogue: 0,0:21:49.15,0:21:53.15,Default,,0000,0000,0000,,Қазір күнде! Мен теорияны ұстанамын.
Dialogue: 0,0:22:01.27,0:22:05.14,Default,,0000,0000,0000,,Мақсат табылды! Бұл Жерорта теңізінің патшайымы!
Dialogue: 0,0:22:05.14,0:22:07.00,Default,,0000,0000,0000,,Сіз соншалықты үлкен нәрсе жасайсыз ба?
Dialogue: 0,0:22:07.00,0:22:11.03,Default,,0000,0000,0000,,Топ құрғаныңыздың себебі осы емес пе? Қорықпа!
Dialogue: 0,0:22:11.03,0:22:15.41,Default,,0000,0000,0000,,"Менің қозғалтқышым дұрыс жұмыс істемейді. Мен сізге бірінші көмектесемін."
Dialogue: 0,0:22:15.41,0:22:18.94,Default,,0000,0000,0000,,"Сен сондай қу екенсің! Өзің шешкеніңді істе!"
Dialogue: 0,0:22:18.94,0:22:22.14,Default,,0000,0000,0000,,«Зақымдалған жағдайда жөндеу ақысы - Варикан, солай ма?»
Dialogue: 0,0:22:22.14,0:22:27.03,Default,,0000,0000,0000,,"Сен сондай әйел затысың! Бұл ақшаны өзің төлеуге тура келетініне бәс тігемін!"
Dialogue: 0,0:22:27.03,0:22:30.06,Default,,0000,0000,0000,,«Менің қозғалтқышым дұрыс жұмыс істемейді...» «Бұл анық, солай емес пе?
Dialogue: 0,0:22:30.06,0:22:34.27,Default,,0000,0000,0000,,«Менің қозғалтқышым дұрыс жұмыс істемейді...» «Бұл оқиға сонда болуы керек».
Dialogue: 0,0:22:34.27,0:22:38.27,Default,,0000,0000,0000,,Шулы! Ауызыңды жап!
Dialogue: 0,0:22:41.17,0:22:45.04,Default,,0000,0000,0000,,Біз сізге хабарлаймыз. Біз сізге хабарлаймыз.
Dialogue: 0,0:22:45.04,0:22:49.08,Default,,0000,0000,0000,,Әуе қарақшылары біздің кемені нысанаға алып жатыр, бірақ уайымдамаңыз.
Dialogue: 0,0:22:49.08,0:22:53.29,Default,,0000,0000,0000,,Кеме тамаша жауынгерлік катерлермен жабдықталған.
Dialogue: 0,0:22:53.29,0:22:57.29,Default,,0000,0000,0000,,Сіздерді екі ержүрек ұшқышпен таныстыруға рұқсат етіңіздер.
Dialogue: 0,0:22:59.18,0:23:04.18,Default,,0000,0000,0000,,№1 қайық «Қара Эстальон» Синьор Варакка.
Dialogue: 0,0:23:05.07,0:23:09.12,Default,,0000,0000,0000,,№2 қайық «Тибра қасқыры» лейтенант Висконти.
Dialogue: 0,0:23:09.12,0:23:20.05,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:23:20.05,0:23:24.09,Default,,0000,0000,0000,,Ол өзімен бірге оққағар әкелді! Мұны тыңдамаңыз!
Dialogue: 0,0:23:24.09,0:23:30.16,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:23:30.16,0:23:33.19,Default,,0000,0000,0000,,А, мен қатты күйзелдім, жақсы...
Dialogue: 0,0:23:33.19,0:23:37.89,Default,,0000,0000,0000,,Мұнда келме! Кертис!
Dialogue: 0,0:23:37.89,0:23:39.08,Default,,0000,0000,0000,,Жарайды! Күте тұрыңыз!
Dialogue: 0,0:23:39.08,0:23:45.08,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:23:56.92,0:23:59.92,Default,,0000,0000,0000,,Енді кететін уақыт келді.
Dialogue: 0,0:24:00.13,0:24:03.13,Default,,0000,0000,0000,,Өйткені, оны Миланға апарудан басқа амалым жоқ.
Dialogue: 0,0:24:08.04,0:24:13.92,Default,,0000,0000,0000,,... атып түсірілді, бірақ парашютпен сәтті құтылды.
Dialogue: 0,0:24:13.92,0:24:17.79,Default,,0000,0000,0000,,Кемедегі барлық құндылықтарды ұрлаған әуе қарақшылары коалициясы →
Dialogue: 0,0:24:17.79,0:24:19.98,Default,,0000,0000,0000,,Мен келесі хабарламаны қалдырдым:
Dialogue: 0,0:24:19.98,0:24:21.17,Default,,0000,0000,0000,,Келесі мен!
Dialogue: 0,0:24:21.17,0:24:24.03,Default,,0000,0000,0000,,Шошқа, шық!
Dialogue: 0,0:24:24.03,0:24:29.03,Default,,0000,0000,0000,,Қайталау: «Келесі сенсің, шық шошқа».
Dialogue: 0,0:24:30.09,0:24:33.09,Default,,0000,0000,0000,,Бұлай етпе, қоқыс.
Dialogue: 0,0:24:34.30,0:24:38.01,Default,,0000,0000,0000,,Хехе... хахахаха...!
Dialogue: 0,0:24:38.01,0:24:41.01,Default,,0000,0000,0000,,Кешіріңіз, мен демалыстамын.
Dialogue: 0,0:24:43.05,0:24:49.05,Default,,0000,0000,0000,,Таза ақ жаймалар... сұлу әйелдер...
Dialogue: 0,0:24:54.33,0:24:58.03,Default,,0000,0000,0000,,Мені Миланға апарыңызшы, Engine-чан.
Dialogue: 0,0:24:58.03,0:25:08.13,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:08.13,0:25:17.13,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:21.27,0:25:27.27,Default,,0000,0000,0000,,Ауа райы қолайсыз болып кетті. Бұлттардың астына түсуден басқа амалымыз жоқ.
Dialogue: 0,0:25:32.04,0:25:52.08,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:52.08,0:26:12.28,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:26:12.28,0:26:21.20,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:26:21.20,0:26:24.20,Default,,0000,0000,0000,,Жақсы жұмыс! Іске сәт! Қараңдар, қараңдар!
Dialogue: 0,0:26:28.93,0:26:31.93,Default,,0000,0000,0000,,Дұрыс, сен кереметсің, Engine-чан.
Dialogue: 0,0:26:42.24,0:26:44.24,Default,,0000,0000,0000,,Шошқа!
Dialogue: 0,0:26:52.68,0:26:55.04,Default,,0000,0000,0000,,Бұл бір-бірден. Ұрыс!
Dialogue: 0,0:26:55.04,0:26:57.04,Default,,0000,0000,0000,,Қазір емес!
Dialogue: 0,0:27:05.30,0:27:08.00,Default,,0000,0000,0000,,Қашпа! Мен бәріне айтамын.
Dialogue: 0,0:27:08.00,0:27:14.05,Default,,0000,0000,0000,,Қайта кездескенше, америкалық жігіт! Хахаха….
Dialogue: 0,0:27:14.05,0:27:16.05,Default,,0000,0000,0000,,Жүр! Ол шықты!
Dialogue: 0,0:27:18.10,0:27:20.29,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:27:20.29,0:27:21.30,Default,,0000,0000,0000,,сәби әлі тірі. Бұл адам баланы қорғап қалған болар.
Dialogue: 0,0:27:21.30,0:27:25.30,Default,,0000,0000,0000,,Ол оқтар саған тимейді! Ол дұрыс жұмыс істемейді!
Dialogue: 0,0:27:35.94,0:27:40.94,Default,,0000,0000,0000,,Иә! Енді мен де атақтымын! Yahoo!
Dialogue: 0,0:30:27.66,0:30:30.02,Default,,0000,0000,0000,,Құр қол қайтпа, олар саған сенбейді.
Dialogue: 0,0:30:30.02,0:30:32.04,Default,,0000,0000,0000,,Қандай дәлел...?
Dialogue: 0,0:30:32.04,0:30:34.04,Default,,0000,0000,0000,,Қандай да бір себепті,
Dialogue: 0,0:30:39.94,0:30:41.94,Default,,0000,0000,0000,,Міне болды!
Dialogue: 0,0:30:57.96,0:31:01.96,Default,,0000,0000,0000,,Бұл жеңіл-желпі қызылмен қателесуге болмайды.
Dialogue: 0,0:31:02.00,0:31:05.00,Default,,0000,0000,0000,,Мен Алабамадағы анама жақсы кәдесый жасадым.
Dialogue: 0,0:31:49.98,0:31:51.98,Default,,0000,0000,0000,,Асығыңыз.
Dialogue: 0,0:31:56.04,0:31:58.57,Default,,0000,0000,0000,,ханым~!
Dialogue: 0,0:31:58.57,0:32:03.95,Default,,0000,0000,0000,,Ханым! Мен телефондамын! Сен амансың, сен тірісің!
Dialogue: 0,0:32:03.95,0:32:04.96,Default,,0000,0000,0000,,Иә!?
Dialogue: 0,0:32:04.96,0:32:07.96,Default,,0000,0000,0000,,Қабылдау бөліміне қоңырау шалыңыз.
Dialogue: 0,0:32:15.90,0:32:17.92,Default,,0000,0000,0000,,Марко! Сіз бе!? Сіз жарақат алдыңыз ба?
Dialogue: 0,0:32:17.92,0:32:20.95,Default,,0000,0000,0000,,Мен оны қайықпен іздеп кете жаздадым.
Dialogue: 0,0:32:20.95,0:32:23.15,Default,,0000,0000,0000,,Иә... бұл жақсы.
Dialogue: 0,0:32:23.15,0:32:27.19,Default,,0000,0000,0000,,Мен екі күн бойы қаңырап бос қалған аралда болғандықтан арықтадым.
Dialogue: 0,0:32:27.19,0:32:30.22,Default,,0000,0000,0000,,Мен Миланға қайықты жөндеуге барғалы жатырмын.
Dialogue: 0,0:32:30.22,0:32:34.59,Default,,0000,0000,0000,,Егер сол американдық жігіт дүкенге келсе, маған хабарлаңыз.
Dialogue: 0,0:32:34.59,0:32:37.95,Default,,0000,0000,0000,,Келесі жолы тағы кездесейік.
Dialogue: 0,0:32:37.95,0:32:40.15,Default,,0000,0000,0000,,Не?! Сіз адамдарды хабарлама тақтасы немесе бір нәрсе деп ойлайсыз!
Dialogue: 0,0:32:40.15,0:32:43.02,Default,,0000,0000,0000,,Қанша уайымдасаңыз да, дирижабльдегі жігіттер →
Dialogue: 0,0:32:43.02,0:32:47.02,Default,,0000,0000,0000,,Сіз әйелдерді пирстің металл арматурасы деп ойлауыңыз керек!
Dialogue: 0,0:32:48.23,0:32:52.60,Default,,0000,0000,0000,,Марко... Мен қуырылған шошқа етіне айналайын...
Dialogue: 0,0:32:52.60,0:32:55.60,Default,,0000,0000,0000,,Мен мұндай жерлеуді қаламаймын.
Dialogue: 0,0:32:56.14,0:33:00.19,Default,,0000,0000,0000,,Ұша алмайтын шошқа - жай шошқа. ақымақ!
Dialogue: 0,0:33:00.19,0:33:20.05,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:33:20.05,0:33:26.05,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:33:53.05,0:33:57.75,Default,,0000,0000,0000,,Бүгін түнде келеді деп ойлап, күттім.
Dialogue: 0,0:33:57.75,0:34:01.96,Default,,0000,0000,0000,,Бұл қайтадан қиын болады. Маған тағы қатты соққы болды.
Dialogue: 0,0:34:01.96,0:34:06.17,Default,,0000,0000,0000,,Жаңасын салу жылдамырақ емес пе? Мынаны қалдырыңыз.
Dialogue: 0,0:34:06.17,0:34:08.03,Default,,0000,0000,0000,,Мен сенің сезіміңді түсінемін.
Dialogue: 0,0:34:08.03,0:34:11.03,Default,,0000,0000,0000,,Артқа тұрыңыз! Мен оны артқы жағына қоямын.
Dialogue: 0,0:34:14.09,0:34:17.62,Default,,0000,0000,0000,,Бұл кім? Сол сүйкімді.
Dialogue: 0,0:34:17.62,0:34:20.62,Default,,0000,0000,0000,,Бұл менің Америкаға барған немерем.
Dialogue: 0,0:34:22.17,0:34:25.17,Default,,0000,0000,0000,,Жарайды, жарайды!
Dialogue: 0,0:34:43.04,0:34:47.92,Default,,0000,0000,0000,,О, қандай әдемі қайық! Ата, сіз әдемісіз.
Dialogue: 0,0:34:47.92,0:34:49.11,Default,,0000,0000,0000,,Жақсы сызық.
Dialogue: 0,0:34:49.11,0:34:53.98,Default,,0000,0000,0000,,Қазіргі кезде мұндай жұмысты жасайтын шеберлер жоқ.
Dialogue: 0,0:34:53.98,0:34:55.17,Default,,0000,0000,0000,,Олар бір-біріне ұқсамайды. иә?
Dialogue: 0,0:34:55.17,0:34:58.36,Default,,0000,0000,0000,,Сіз шынымен атаның немересісіз бе?
Dialogue: 0,0:34:58.36,0:35:00.36,Default,,0000,0000,0000,,Оған қол тигізбеңіз. Аа...!?
Dialogue: 0,0:35:03.08,0:35:06.08,Default,,0000,0000,0000,,Fio Мен сізден көбірек сұраймын. иә! Ақырында.
Dialogue: 0,0:35:07.12,0:35:11.99,Default,,0000,0000,0000,,Менің қарсыласым - Кертис. Мен тағы 15 түйін алғым келеді.
Dialogue: 0,0:35:11.99,0:35:14.99,Default,,0000,0000,0000,,Кертис... бұл ностальгия.
Dialogue: 0,0:35:19.57,0:35:22.10,Default,,0000,0000,0000,,Сіз қалай ойлайсыз? Бұл Folgore!
Dialogue: 0,0:35:22.10,0:35:24.12,Default,,0000,0000,0000,,Қайдан келгенін сұрама.
Dialogue: 0,0:35:24.12,0:35:26.98,Default,,0000,0000,0000,,1927 жылғы Шнайдер кубогында→
Dialogue: 0,0:35:26.98,0:35:30.18,Default,,0000,0000,0000,,Бұл қайығы бар итальяндық қайық Кертистен жеңіліп қалды.
Dialogue: 0,0:35:30.18,0:35:34.23,Default,,0000,0000,0000,,Бірақ бұл жігіттің кінәсі емес, механиктің ақымақ болғаны.
Dialogue: 0,0:35:34.23,0:35:37.42,Default,,0000,0000,0000,,Хехехе... Қаным қайнап жатыр!
Dialogue: 0,0:35:37.42,0:35:40.95,Default,,0000,0000,0000,,Тым нәзік күйге келтірмеңіз.
Dialogue: 0,0:35:40.95,0:35:43.98,Default,,0000,0000,0000,,Бұл жарыс емес. Мұндай нәрсе→
Dialogue: 0,0:35:43.98,0:35:46.98,Default,,0000,0000,0000,,Азияда «Будда ілімін уағыздау» деп аталады.
Dialogue: 0,0:35:50.88,0:35:53.91,Default,,0000,0000,0000,,Сізде бар ақшаны әкелуді жоспарлап отырсыз ба?
Dialogue: 0,0:35:53.91,0:35:58.29,Default,,0000,0000,0000,,Бұл күндері вексельдердің құны қағаз сынықтарындай.
Dialogue: 0,0:35:58.29,0:36:02.00,Default,,0000,0000,0000,,Пропеллерге және бояуға кеткен шығындарды төлемеңіз...
Dialogue: 0,0:36:02.00,0:36:05.03,Default,,0000,0000,0000,,Бұл қонақүй шығындары және тамақтану шығындары сияқты тұру шығындары.
Dialogue: 0,0:36:05.03,0:36:09.03,Default,,0000,0000,0000,,Осы жерде қалуыңызға болады. Мен оны арзандатамын, оның ішінде тамақ.
Dialogue: 0,0:36:11.92,0:36:14.95,Default,,0000,0000,0000,,Мен ұлымды көре алмаймын. Сіз шеберсіз бе?
Dialogue: 0,0:36:14.95,0:36:16.14,Default,,0000,0000,0000,,Үшеуі де еңбек мигранттары.
Dialogue: 0,0:36:16.14,0:36:19.17,Default,,0000,0000,0000,,Сонда дизайнды кім жасайды? Фио мұны жасайды.
Dialogue: 0,0:36:19.17,0:36:23.88,Default,,0000,0000,0000,,Фио!? Бұрынғы қыз ба!?
Dialogue: 0,0:36:23.88,0:36:28.88,Default,,0000,0000,0000,,Фиода жас болса да, ұлында жоқ нәрсе бар.
Dialogue: 0,0:36:31.12,0:36:34.15,Default,,0000,0000,0000,,Ата, біз бұрыннан таныспыз.→
Dialogue: 0,0:36:34.15,0:36:37.15,Default,,0000,0000,0000,,Келесі жолы мен басқа біреуге тапсырма беремін.
Dialogue: 0,0:36:38.03,0:36:40.03,Default,,0000,0000,0000,,...
Dialogue: 0,0:36:45.10,0:36:50.14,Default,,0000,0000,0000,,Мен әйелмін деп уайымдап тұрсың ба? Әлде тым жас болғандықтан ба?
Dialogue: 0,0:36:50.14,0:36:51.99,Default,,0000,0000,0000,,Екеуі де, жас ханым.
Dialogue: 0,0:36:51.99,0:36:55.03,Default,,0000,0000,0000,,Иә, әрине. Хмм...
Dialogue: 0,0:36:55.03,0:36:59.07,Default,,0000,0000,0000,,Сәлем! Жақсы ұшқыштың бірінші шартын айтыңызшы.
Dialogue: 0,0:36:59.07,0:37:03.11,Default,,0000,0000,0000,,Тәжірибе? Жоқ, бұл шабыт.
Dialogue: 0,0:37:03.11,0:37:06.14,Default,,0000,0000,0000,,Сіз мұны тәжірибе деп атамағаныңыз жақсы.
Dialogue: 0,0:37:06.14,0:37:08.66,Default,,0000,0000,0000,,Әй, мен атадан сұрадым→
Dialogue: 0,0:37:08.66,0:37:11.03,Default,,0000,0000,0000,,Мен сіздің жеке ұшуыңыз өте жылдам болғанын естідім.
Dialogue: 0,0:37:11.03,0:37:14.05,Default,,0000,0000,0000,,Содан бастап ол өте шебер болды.
Dialogue: 0,0:37:14.05,0:37:18.93,Default,,0000,0000,0000,,1910 жыл. Мен 17 жаста едім.
Dialogue: 0,0:37:18.93,0:37:22.13,Default,,0000,0000,0000,,17 жаста! Қазір мен сияқты.
Dialogue: 0,0:37:22.13,0:37:24.99,Default,,0000,0000,0000,,Мен әйел болуды тоқтата алмаймын, бірақ...
Dialogue: 0,0:37:24.99,0:37:27.52,Default,,0000,0000,0000,,Маған мұны істеуге рұқсат бересіз бе? Бұрынғы сызбалар да бар...
Dialogue: 0,0:37:27.52,0:37:30.05,Default,,0000,0000,0000,,Іс жақсы болмаса, маған ақша керек емес.
Dialogue: 0,0:37:30.05,0:37:34.09,Default,,0000,0000,0000,,Сәлем! Ата. Ол менің немерем. Ол жақсы болады.
Dialogue: 0,0:37:34.09,0:37:37.12,Default,,0000,0000,0000,,Мен де 12 жасымда қозғалтқыштарды бөлшектедім.
Dialogue: 0,0:37:37.12,0:37:40.15,Default,,0000,0000,0000,,Мен бүгін түнде осында ұйықтаймын, ертең төсегімді жинаймын.
Dialogue: 0,0:37:40.15,0:37:42.00,Default,,0000,0000,0000,,Таңғы ас 7-де! Душ Ыстық су бар!
Dialogue: 0,0:37:42.00,0:37:45.00,Default,,0000,0000,0000,,Орамал бар! қайырлы түн!
Dialogue: 0,0:37:47.05,0:37:50.58,Default,,0000,0000,0000,,Менде ақша жетпейді, бірақ бұл өткеннен жақсы нәрсе.
Dialogue: 0,0:37:50.58,0:37:52.58,Default,,0000,0000,0000,,Қалғанын қарыз ретінде қалдырамын.
Dialogue: 0,0:38:34.19,0:38:35.20,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:38:35.20,0:38:37.89,Default,,0000,0000,0000,,(есіктің ашылған дыбысы)
Dialogue: 0,0:38:37.89,0:38:41.59,Default,,0000,0000,0000,,Қайырлы таң, ұйықтадың ба? Сіз түні бойы ұйықтадыңыз ба?
Dialogue: 0,0:38:41.59,0:38:43.95,Default,,0000,0000,0000,,Бұл дөрекі жоспар, бірақ сіз қалай ойлайсыз?
Dialogue: 0,0:38:43.95,0:38:48.99,Default,,0000,0000,0000,,Мен жоспарды сол күйінде сақтап, жаңа қанат қимасын қолданғым келеді.
Dialogue: 0,0:38:48.99,0:38:51.85,Default,,0000,0000,0000,,Осының өзі оны 5 түйінге жылдамырақ етеді.
Dialogue: 0,0:38:51.85,0:38:56.07,Default,,0000,0000,0000,,Мен алдыңғы сызбаны көріп таң қалдым. Қанаттар да ағаштан жасалған монокок.
Dialogue: 0,0:38:56.07,0:38:58.43,Default,,0000,0000,0000,,Бұл есептеу парағы керемет.
Dialogue: 0,0:38:58.43,0:39:02.96,Default,,0000,0000,0000,,Бұл қанаттарды жасаған адам ағаштың табиғатын жақсы біледі.
Dialogue: 0,0:39:02.96,0:39:04.15,Default,,0000,0000,0000,,Маған қатты әсер етті.
Dialogue: 0,0:39:04.15,0:39:07.85,Default,,0000,0000,0000,,Бұл не? Бір ғана қайық жасалды→
Dialogue: 0,0:39:07.85,0:39:13.07,Default,,0000,0000,0000,,Ұшу тым қауіпті болғандықтан қоймада шаң жиналып жатты.
Dialogue: 0,0:39:13.07,0:39:14.09,Default,,0000,0000,0000,,Сізден бір нәрсе сұрасам…
Dialogue: 0,0:39:14.09,0:39:18.63,Default,,0000,0000,0000,,Мұндай экстремалды параметрмен сіз судан оңай кете аласыз.
Dialogue: 0,0:39:18.63,0:39:21.99,Default,,0000,0000,0000,,Жалғыз қиыны - суға көтерілу және қону.
Dialogue: 0,0:39:21.99,0:39:24.02,Default,,0000,0000,0000,,Қанаттар жылдамдыққа жеткенде жабысқақ болады.
Dialogue: 0,0:39:24.02,0:39:29.07,Default,,0000,0000,0000,,Қанаттың бекіту бұрышын сызбадан 0,5 градусқа арттырыңыз.
Dialogue: 0,0:39:29.07,0:39:31.93,Default,,0000,0000,0000,,Сіз бұрынғыдай жалғастыра аласыз.
Dialogue: 0,0:39:31.93,0:39:35.93,Default,,0000,0000,0000,,Сіз маған мұны істеуге рұқсат бересіз! Рахмет, мен қолымнан келгеннің бәрін жасаймын!
Dialogue: 0,0:39:36.31,0:39:40.31,Default,,0000,0000,0000,,Бірақ, жас ханым, бір шарт бар.
Dialogue: 0,0:39:41.19,0:39:45.07,Default,,0000,0000,0000,,Түні бойы ұйықтама. Ұйқысыздық - жақсы жұмыстың жауы.
Dialogue: 0,0:39:45.07,0:39:48.92,Default,,0000,0000,0000,,Бұл да сұлулыққа жарамайды.
Dialogue: 0,0:39:48.92,0:39:50.12,Default,,0000,0000,0000,,Хехе... Мен мұны істеймін.
Dialogue: 0,0:39:50.12,0:39:54.99,Default,,0000,0000,0000,,Кеше түнде жүрегім қатты соғып, ұйықтай алмадым.
Dialogue: 0,0:39:54.99,0:39:57.51,Default,,0000,0000,0000,,Шынымды айтсам, бұл жұмыс түптеп келгенде→
Dialogue: 0,0:39:57.51,0:40:00.88,Default,,0000,0000,0000,,Маған қалдырмайсың ба деп уайымдадым, сондықтан мен бақыттымын!
Dialogue: 0,0:40:00.88,0:40:02.88,Default,,0000,0000,0000,,Мен кофе дайындаймын!
Dialogue: 0,0:40:03.08,0:40:08.12,Default,,0000,0000,0000,,Менің ойымша, сіз оны өзіңіз жасай алмайсыз ...
Dialogue: 0,0:40:08.12,0:40:16.54,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:40:16.54,0:40:19.07,Default,,0000,0000,0000,,Келесіде менің жиенім Моника бірнеше сурет салады. сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:40:19.07,0:40:22.10,Default,,0000,0000,0000,,Менің жиенімнің әйелі Сильвана Мен әрлеуді жасаймын.
Dialogue: 0,0:40:22.10,0:40:26.14,Default,,0000,0000,0000,,Менің немере ағаларым София, Лаура, Констанс және Валентина.
Dialogue: 0,0:40:26.14,0:40:29.17,Default,,0000,0000,0000,,Фионың әпкесі Гириора Сандра да келді ме?
Dialogue: 0,0:40:29.17,0:40:32.03,Default,,0000,0000,0000,,Менің немере ағам... Мариетта Сен қазір әдемісің.
Dialogue: 0,0:40:32.03,0:40:37.41,Default,,0000,0000,0000,,Ұлымның келіндері: Мария Тина Анна және оның әпкесі Миретта.
Dialogue: 0,0:40:37.41,0:40:41.12,Default,,0000,0000,0000,,Порчеллино! Әже!
Dialogue: 0,0:40:41.12,0:40:45.99,Default,,0000,0000,0000,,Әлі сені алып кетуге ешкім келмеді ме? Хахаха...!
Dialogue: 0,0:40:45.99,0:40:48.02,Default,,0000,0000,0000,,Сен де жақсы адам болып кеттің.
Dialogue: 0,0:40:48.02,0:40:50.22,Default,,0000,0000,0000,,Ахх— бұл мені қатты қорқытты
Dialogue: 0,0:40:50.22,0:40:53.25,Default,,0000,0000,0000,,Әжелер де жұмыс істей ме?
Dialogue: 0,0:40:53.25,0:40:58.25,Default,,0000,0000,0000,,Мен шөбереме қалталы ақша берейін деп едім. Хахахаха...
Dialogue: 0,0:41:02.16,0:41:05.20,Default,,0000,0000,0000,,Тіпті бір адам да жоқ. аа….
Dialogue: 0,0:41:05.20,0:41:08.06,Default,,0000,0000,0000,,Олардың барлығы қарттардың отбасы ма?
Dialogue: 0,0:41:08.06,0:41:11.09,Default,,0000,0000,0000,,Дұрыс, соңғы кездері жұмысым болмай қалды→
Dialogue: 0,0:41:11.09,0:41:14.09,Default,,0000,0000,0000,,Барлық ер адамдар жұмысқа кетті.
Dialogue: 0,0:41:15.96,0:41:17.49,Default,,0000,0000,0000,,Ұлы депрессия.
Dialogue: 0,0:41:17.49,0:41:22.04,Default,,0000,0000,0000,,Уайымдама, әйелдер жақсы. Олар табанды және көп жұмыс істейді.
Dialogue: 0,0:41:22.04,0:41:26.04,Default,,0000,0000,0000,,Мен құймақ жасамауым керек...
Dialogue: 0,0:41:33.15,0:41:38.36,Default,,0000,0000,0000,,Көктегі Құдайымыз, банкрот болудың аз-ақ алдында тұрған компаниямызды құрттың→
Dialogue: 0,0:41:38.36,0:41:40.88,Default,,0000,0000,0000,,Ол бізге нан берді, жұмыс жасады.
Dialogue: 0,0:41:40.88,0:41:45.10,Default,,0000,0000,0000,,Әйелдің көмегімен соғыс кемесін жасаған күнәкарларды кешіре гөр.
Dialogue: 0,0:41:45.10,0:41:47.10,Default,,0000,0000,0000,,Әумин.
Dialogue: 0,0:41:49.13,0:41:53.18,Default,,0000,0000,0000,,Кел, жақсы тамақтанып, еңбектенейік!
Dialogue: 0,0:41:53.18,0:41:56.18,Default,,0000,0000,0000,,Ухахаха...!
Dialogue: 0,0:42:02.77,0:42:06.77,Default,,0000,0000,0000,,Жақсы естіледі! Бұл қозғалтқыш хит!
Dialogue: 0,0:42:13.87,0:42:15.06,Default,,0000,0000,0000,,Сіз қалай ойлайсыз? Ол жақсы айналады!
Dialogue: 0,0:42:15.06,0:42:19.10,Default,,0000,0000,0000,,Өзіңе қамқор болмасаң, саятшылық ұшады!
Dialogue: 0,0:42:19.10,0:42:23.10,Default,,0000,0000,0000,,Ах! Кертис осырық емес.
Dialogue: 0,0:42:31.06,0:42:41.99,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:42:41.99,0:42:53.11,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:42:53.11,0:42:58.16,Default,,0000,0000,0000,,Хмм, бұл сөзсіз жақсы идея. эй! Сондықтан өтінемін!
Dialogue: 0,0:42:58.16,0:43:03.21,Default,,0000,0000,0000,,Бірақ... бұл қымбатқа түседі.
Dialogue: 0,0:43:03.21,0:43:07.41,Default,,0000,0000,0000,,Менде бюджеттен асып кеткен көптеген шоттары бар.
Dialogue: 0,0:43:07.41,0:43:09.41,Default,,0000,0000,0000,,Демеушім бар ма екен...
Dialogue: 0,0:43:11.95,0:43:13.95,Default,,0000,0000,0000,,Порко…!
Dialogue: 0,0:43:14.99,0:43:19.03,Default,,0000,0000,0000,,Жарайды, адамдарға олай қарама... Қалағаныңды істе.
Dialogue: 0,0:43:19.03,0:43:23.91,Default,,0000,0000,0000,,Иә! Мен зауытпен сөйлестім және бірден тапсырыс беремін!
Dialogue: 0,0:43:23.91,0:43:25.91,Default,,0000,0000,0000,,Мен Порконы жақсы көремін!
Dialogue: 0,0:43:29.80,0:43:34.02,Default,,0000,0000,0000,,Мен үш ай күтемін. Аспан қарақшысы болу үшін жұмысымды өзгертуім керек пе?
Dialogue: 0,0:43:34.02,0:43:36.20,Default,,0000,0000,0000,,Жақсы емес пе? иә?
Dialogue: 0,0:43:36.20,0:43:38.89,Default,,0000,0000,0000,,Онымен араласпаңыз.
Dialogue: 0,0:43:38.89,0:43:42.10,Default,,0000,0000,0000,,Тіпті бөксесімдегі шаштар да жұлынды, мұрным да қанбайды.
Dialogue: 0,0:43:42.10,0:44:02.96,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:44:02.96,0:44:22.99,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:44:22.99,0:44:32.99,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:47:25.99,0:47:28.52,Default,,0000,0000,0000,,Сіз майорға көтерілдіңіз, Феррарин.
Dialogue: 0,0:47:28.52,0:47:31.05,Default,,0000,0000,0000,,Ақымақ! Неге қайтып келдің?
Dialogue: 0,0:47:31.05,0:47:33.07,Default,,0000,0000,0000,,Мен қайда барғым келсе, соған барамын.
Dialogue: 0,0:47:33.07,0:47:36.10,Default,,0000,0000,0000,,Билік бұл жолы да сені сағынбайды.
Dialogue: 0,0:47:36.10,0:47:39.13,Default,,0000,0000,0000,,Сізге ерген жоқ па? Мен оны шашып жібердім.
Dialogue: 0,0:47:39.13,0:47:44.18,Default,,0000,0000,0000,,Сіз ұлтқа қарсы ынтымақтастыққа, контрабандаға және декадентті ойлауға кінәлісіз →
Dialogue: 0,0:47:44.18,0:47:46.04,Default,,0000,0000,0000,,Ұятсыз, жалқау шошқа болу күнәсі →
Dialogue: 0,0:47:46.04,0:47:49.74,Default,,0000,0000,0000,,Әдепсіз заттарды көрсеткені үшін қамауға алу ордері.
Dialogue: 0,0:47:49.74,0:47:53.94,Default,,0000,0000,0000,,Хехе... хахахаха…. Ақымақ, күліп тұрғанда!
Dialogue: 0,0:47:53.94,0:47:57.15,Default,,0000,0000,0000,,Олар сіздің жауынгерлік қайығыңызды да тәркілейміз дейді.
Dialogue: 0,0:47:57.15,0:48:00.01,Default,,0000,0000,0000,,Бұл қорқынышты фильм, солай емес пе?
Dialogue: 0,0:48:00.01,0:48:05.89,Default,,0000,0000,0000,,Эй, Марко, Әуе күштеріне қайт. Біз қазір өз күшімізбен бірдеңе істейміз.
Dialogue: 0,0:48:05.89,0:48:08.26,Default,,0000,0000,0000,,Фашист болғанша шошқа болған жақсы.
Dialogue: 0,0:48:08.26,0:48:11.78,Default,,0000,0000,0000,,Шытырман оқиғалы ұшқыштардың дәуірі аяқталды.
Dialogue: 0,0:48:11.78,0:48:14.15,Default,,0000,0000,0000,,Ұлт, ұлт сияқты мағынасыз демеуші алып жүру→
Dialogue: 0,0:48:14.15,0:48:16.00,Default,,0000,0000,0000,,Менің ұшудан басқа амалым жоқ.
Dialogue: 0,0:48:16.00,0:48:20.04,Default,,0000,0000,0000,,Мен тек тапқаныммен ғана ұша аламын.
Dialogue: 0,0:48:20.04,0:48:24.08,Default,,0000,0000,0000,,Шошқа - ұшқаннан кейінгі шошқа.
Dialogue: 0,0:48:24.08,0:48:28.08,Default,,0000,0000,0000,,Рахмет, Феррарин және барлығына үлкен сәлем.
Dialogue: 0,0:48:29.46,0:48:31.82,Default,,0000,0000,0000,,Жақсы фильм емес пе?
Dialogue: 0,0:48:31.82,0:48:35.19,Default,,0000,0000,0000,,Абайлаңыз, олар шошқаларды сотқа бергілері келмейді.
Dialogue: 0,0:48:35.19,0:48:36.20,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:48:36.20,0:48:38.89,Default,,0000,0000,0000,,Абайо жолдас.
Dialogue: 0,0:48:38.89,0:48:56.90,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:48:56.90,0:48:59.90,Default,,0000,0000,0000,,Порко, сіз мінгіңіз келе ме?
Dialogue: 0,0:49:03.14,0:49:05.14,Default,,0000,0000,0000,,Міне, мен құтқарылдым.
Dialogue: 0,0:49:11.22,0:49:14.92,Default,,0000,0000,0000,,Мен ертең көлге апару үшін қайықты қарызға алдым.
Dialogue: 0,0:49:14.92,0:49:16.10,Default,,0000,0000,0000,,Сынақ ұшуының уақыты келді.
Dialogue: 0,0:49:16.10,0:49:19.13,Default,,0000,0000,0000,,Сынақ жоқ. Мен бірден ұшуым керек.
Dialogue: 0,0:49:19.13,0:49:21.15,Default,,0000,0000,0000,,Ақылсыз ештеңе айтпа!
Dialogue: 0,0:49:21.15,0:49:24.01,Default,,0000,0000,0000,,Мен сені сынамай тапсыра алмаймын!
Dialogue: 0,0:49:24.01,0:49:28.05,Default,,0000,0000,0000,,Оны бөлшектеп, көлге апару бір күнді алады.
Dialogue: 0,0:49:28.05,0:49:33.05,Default,,0000,0000,0000,,Менің уақытым көп емес. Тек сол терезеден артыңа қара.
Dialogue: 0,0:49:34.95,0:49:39.17,Default,,0000,0000,0000,,Бұл фашистік құпия полиция. Олар Фионың артынан жүрді.
Dialogue: 0,0:49:39.17,0:49:44.05,Default,,0000,0000,0000,,Мен? неге? Себебі мен оның соңынан ермегенмін.
Dialogue: 0,0:49:44.05,0:49:48.05,Default,,0000,0000,0000,,Сонымен қатар, Фио менің дирижабльмен араласып жатыр.
Dialogue: 0,0:49:51.12,0:49:54.48,Default,,0000,0000,0000,,Сәлем! Порко шынымен тыңшы ма?
Dialogue: 0,0:49:54.48,0:49:58.02,Default,,0000,0000,0000,,Ахх— бұл мені қатты қорқытты
Dialogue: 0,0:49:58.02,0:50:01.05,Default,,0000,0000,0000,,Мен шпионмын ба? Хахаха...
Dialogue: 0,0:50:01.05,0:50:05.09,Default,,0000,0000,0000,,Шпион деген жоқ; бұл жігерлі бейбақтарға арналған.
Dialogue: 0,0:50:05.09,0:50:09.13,Default,,0000,0000,0000,,Бірақ сіз соғыс кезінде батыр болдыңыз, солай ма?
Dialogue: 0,0:50:09.13,0:50:11.99,Default,,0000,0000,0000,,Бұл біртүрлі, егер сіз ештеңе істемей жатсаңыз.
Dialogue: 0,0:50:11.99,0:50:14.99,Default,,0000,0000,0000,,Мен де солай ойлаймын!
Dialogue: 0,0:50:17.05,0:50:20.24,Default,,0000,0000,0000,,Ой! Бұлай емес.
Dialogue: 0,0:50:20.24,0:50:30.24,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:50:32.19,0:50:35.89,Default,,0000,0000,0000,,Олар ештеңе істемейтін сияқты.
Dialogue: 0,0:50:35.89,0:50:38.89,Default,,0000,0000,0000,,Енді жұмысты қолға алайық.
Dialogue: 0,0:51:06.87,0:51:08.06,Default,,0000,0000,0000,,Сіз кез келген уақытта ұша аласыз.
Dialogue: 0,0:51:08.06,0:51:14.12,Default,,0000,0000,0000,,Артқы жағында екі адам тығылып отыр. Алдында үш адам бар. Бір қызық нәрсе бар...
Dialogue: 0,0:51:14.12,0:51:17.12,Default,,0000,0000,0000,,Әже, көп қыдырмаңыз.
Dialogue: 0,0:51:19.17,0:51:22.17,Default,,0000,0000,0000,,Мен келемін! сақ болыңыз.
Dialogue: 0,0:51:33.13,0:51:35.99,Default,,0000,0000,0000,,Fio! Бұл қандай ақша!?
Dialogue: 0,0:51:35.99,0:51:39.19,Default,,0000,0000,0000,,Мен де барамын. Мен мінетін жер тауып беремін. 5 минут күтіңіз.
Dialogue: 0,0:51:39.19,0:51:43.07,Default,,0000,0000,0000,,Қалжың емес! Сіз не туралы айтып жатқаныңызды білесіз бе!?
Dialogue: 0,0:51:43.07,0:51:48.07,Default,,0000,0000,0000,,Тынш! Даусыңды көтерме. Fio Көрдіңіз бе!
Dialogue: 0,0:51:50.80,0:51:54.18,Default,,0000,0000,0000,,Сен Катагидің қызысың, әлі үйленбейсің...
Dialogue: 0,0:51:54.18,0:51:56.18,Default,,0000,0000,0000,,Сіз мұны қабылдай аласыз ба?
Dialogue: 0,0:51:57.21,0:52:01.21,Default,,0000,0000,0000,,Рахмет... Мен мұны асығыс жасадым. Қараңдар!
Dialogue: 0,0:52:04.12,0:52:06.97,Default,,0000,0000,0000,,Керемет!
Dialogue: 0,0:52:06.97,0:52:09.97,Default,,0000,0000,0000,,Сіз мені сонда ұстай аласыз ба?
Dialogue: 0,0:52:10.67,0:52:14.04,Default,,0000,0000,0000,,Кішкентай ханым, мен соттылығы бар сауыншымын.
Dialogue: 0,0:52:14.04,0:52:17.91,Default,,0000,0000,0000,,Көрікті рейске шықпаңыз!
Dialogue: 0,0:52:17.91,0:52:18.92,Default,,0000,0000,0000,,Кешіріңіз...
Dialogue: 0,0:52:18.92,0:52:21.11,Default,,0000,0000,0000,,Бірақ бұл менің бірінші жұмысым, сондықтан оны дұрыс орындағым келеді.
Dialogue: 0,0:52:21.11,0:52:23.14,Default,,0000,0000,0000,,Бір рет ұшқаннан кейін түзетулер енгізу керек.
Dialogue: 0,0:52:23.14,0:52:26.00,Default,,0000,0000,0000,,Алайда ол артқы жағындағы дренаждық өзеннен ұшады.
Dialogue: 0,0:52:26.00,0:52:29.37,Default,,0000,0000,0000,,Мен аман-есен көтеріле алатынымды да білмеймін.
Dialogue: 0,0:52:29.37,0:52:32.90,Default,,0000,0000,0000,,Сондықтан, әсіресе Кертиспен айналысатын болсаңыз→
Dialogue: 0,0:52:32.90,0:52:35.92,Default,,0000,0000,0000,,Тиісті механик бар, солай ма?
Dialogue: 0,0:52:35.92,0:52:40.14,Default,,0000,0000,0000,,Көрдіңіз бе, мен ер адаммын, біз қаңырап бос аралда тұрамыз, тек екеуміз.
Dialogue: 0,0:52:40.14,0:52:42.16,Default,,0000,0000,0000,,Уайымдамаңыз! Мен кемпингті жақсы көремін.
Dialogue: 0,0:52:42.16,0:52:45.19,Default,,0000,0000,0000,,Бұл емес!
Dialogue: 0,0:52:45.19,0:52:46.20,Default,,0000,0000,0000,,Мені өзіңізбен бірге алыңыз.
Dialogue: 0,0:52:46.20,0:52:50.57,Default,,0000,0000,0000,,Кертис жеңбесе, мен әлі де төлеуім керек.
Dialogue: 0,0:52:50.57,0:52:53.93,Default,,0000,0000,0000,,Төлемесек, біздің компания банкротқа ұшырайды.
Dialogue: 0,0:52:53.93,0:52:55.12,Default,,0000,0000,0000,,Ей, сен әлі менің атамсың ба?
Dialogue: 0,0:52:55.12,0:52:59.16,Default,,0000,0000,0000,,Мен жалақымды бір жаққа қалдырамын, мінекей! Мен сондай-ақ сөйлеу түтігін қосамын.
Dialogue: 0,0:52:59.16,0:53:02.03,Default,,0000,0000,0000,,Менің ойымша, сіз шынымен немерелеріңізді іздеуші адам еткіңіз келеді.
Dialogue: 0,0:53:02.03,0:53:05.06,Default,,0000,0000,0000,,Жоқ, мен Порконың кепілі боламын.
Dialogue: 0,0:53:05.06,0:53:09.43,Default,,0000,0000,0000,,Сонымен, зауыттағылардың барлығында ынтымақтастық жасаудан басқа амал қалмады →
Dialogue: 0,0:53:09.43,0:53:11.95,Default,,0000,0000,0000,,Биліктің сылтауы бола ма?
Dialogue: 0,0:53:11.95,0:53:16.95,Default,,0000,0000,0000,,Олай болса, мені де өзіңізбен бірге алып кетіңіз, бұл пайдалы болады!
Dialogue: 0,0:53:19.03,0:53:22.06,Default,,0000,0000,0000,,Оң жақтағы пулеметті алыңыз. иә?
Dialogue: 0,0:53:22.06,0:53:27.27,Default,,0000,0000,0000,,Бөксесі қанша кішкентай болса да, пулеметтердің арасы тым тар. Төменгі!
Dialogue: 0,0:53:27.27,0:53:30.14,Default,,0000,0000,0000,,Керемет! Менің бөксесі көрінгеннен үлкен.
Dialogue: 0,0:53:30.14,0:53:31.14,Default,,0000,0000,0000,,Мен оны бір минуттан кейін шешемін.
Dialogue: 0,0:53:32.16,0:53:35.52,Default,,0000,0000,0000,,Қазір кет! Егер сіз шатассаңыз →
Dialogue: 0,0:53:35.52,0:53:37.04,Default,,0000,0000,0000,,Менің артымнан әжем де келетін сияқты.
Dialogue: 0,0:53:37.04,0:53:41.04,Default,,0000,0000,0000,,Түсіндім! Бұл да мүмкін еді, хехехе...
Dialogue: 0,0:53:41.08,0:53:43.27,Default,,0000,0000,0000,,Әже, асығыңыз, асығыңыз!
Dialogue: 0,0:53:43.27,0:53:46.27,Default,,0000,0000,0000,,Фио: Сувенирлер жақсы.
Dialogue: 0,0:53:54.05,0:53:56.05,Default,,0000,0000,0000,,Байланыс!
Dialogue: 0,0:54:05.16,0:54:07.16,Default,,0000,0000,0000,,Оны ашыңыз!
Dialogue: 0,0:54:13.24,0:54:15.09,Default,,0000,0000,0000,,(шақырушы флейта)
Dialogue: 0,0:54:15.09,0:54:17.09,Default,,0000,0000,0000,,Жібер!
Dialogue: 0,0:54:19.13,0:54:37.14,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:54:37.14,0:54:40.17,Default,,0000,0000,0000,,～ ～ ～
Dialogue: 0,0:54:40.17,0:54:49.09,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:54:49.09,0:54:51.95,Default,,0000,0000,0000,,Каджи ше? Порко!
Dialogue: 0,0:54:51.95,0:54:55.95,Default,,0000,0000,0000,,Бұл да сен сияқты жажа атты. Ол одан да шектен шықты!
Dialogue: 0,0:54:58.18,0:55:00.04,Default,,0000,0000,0000,,Тоқта! Мен параметрлерді өзгертемін.
Dialogue: 0,0:55:00.04,0:55:04.04,Default,,0000,0000,0000,,Менің бұған уақытым жоқ! Оны қалай да көтерейік!
Dialogue: 0,0:55:07.77,0:55:09.96,Default,,0000,0000,0000,,...
Dialogue: 0,0:55:09.96,0:55:11.96,Default,,0000,0000,0000,,Майданнан кеме!
Dialogue: 0,0:55:15.02,0:55:16.02,Default,,0000,0000,0000,,Ұшайық!
Dialogue: 0,0:55:19.90,0:55:21.08,Default,,0000,0000,0000,,Қайт, Джажаума!
Dialogue: 0,0:55:21.08,0:55:24.28,Default,,0000,0000,0000,,Айнерлер сумен соғылуда.
Dialogue: 0,0:55:24.28,0:55:27.98,Default,,0000,0000,0000,,...
Dialogue: 0,0:55:27.98,0:55:29.99,Default,,0000,0000,0000,,...
Dialogue: 0,0:55:29.99,0:55:41.12,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:55:41.12,0:55:44.48,Default,,0000,0000,0000,,Жақсы. Ол кенеттен шыншыл бола бастады.
Dialogue: 0,0:55:44.48,0:56:00.48,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:56:04.17,0:56:19.00,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:56:19.00,0:56:23.00,Default,,0000,0000,0000,,Әдемі... Дүние шынымен де әдемі...
Dialogue: 0,0:56:27.90,0:56:31.95,Default,,0000,0000,0000,,Сіз қуғыншысыз ба? Шабуылға келгенде бәрі басқаша көрінеді.
Dialogue: 0,0:56:31.95,0:56:35.32,Default,,0000,0000,0000,,Қазір Италияның әуе күштері осында.
Dialogue: 0,0:56:35.32,0:56:37.84,Default,,0000,0000,0000,,Ол Феррариндік бейбақ.
Dialogue: 0,0:56:37.84,0:56:43.23,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:56:43.23,0:56:44.25,Default,,0000,0000,0000,,Сіз бір-біріңізді танисыз ба?
Dialogue: 0,0:56:44.25,0:56:49.12,Default,,0000,0000,0000,,Әуе күштері біздің алдымызда тор орнатып жатыр, сондықтан бізге саңылау көрсетіңіз.
Dialogue: 0,0:56:49.12,0:57:07.14,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:57:07.14,0:57:11.01,Default,,0000,0000,0000,,Мен сізге төмен болып, Адриатика теңізіне өтуіңізді айтып тұрмын.
Dialogue: 0,0:57:11.01,0:57:13.20,Default,,0000,0000,0000,,Рахмет, жолдас!
Dialogue: 0,0:57:13.20,0:57:15.05,Default,,0000,0000,0000,,Рахмет!
Dialogue: 0,0:57:15.05,0:57:22.63,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:57:22.63,0:57:26.17,Default,,0000,0000,0000,,Әлгі бейбақ Фиоға қарап: ''Шошқаларға арналған інжу-маржандар'' деді.
Dialogue: 0,0:57:26.17,0:57:36.10,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:57:36.10,0:57:49.10,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:58:32.49,0:58:35.02,Default,,0000,0000,0000,,Әдемі….
Dialogue: 0,0:58:35.02,0:58:40.02,Default,,0000,0000,0000,,Құпия бақшада гүлдеген раушан гүлі сияқты.
Dialogue: 0,0:58:42.09,0:58:46.96,Default,,0000,0000,0000,,Кімге болмайды... Бұл жеке бақ.
Dialogue: 0,0:58:46.96,0:58:49.96,Default,,0000,0000,0000,,Мұны көргеніңізді қалаймын.
Dialogue: 0,0:58:55.88,0:58:57.40,Default,,0000,0000,0000,,Голливудтан.
Dialogue: 0,0:58:57.40,0:59:01.11,Default,,0000,0000,0000,,«Сіз жіберген сценарийді фильмге түсіру және оған түсу туралы...»
Dialogue: 0,0:59:01.11,0:59:05.98,Default,,0000,0000,0000,,«Біз бұл мәселеге оң көзқараспен қарап жатырмыз және мүмкіндігінше тезірек хабарластық».
Dialogue: 0,0:59:05.98,0:59:08.01,Default,,0000,0000,0000,,Тақырыбы ``Адриатика гүл шоғы''.
Dialogue: 0,0:59:08.01,0:59:12.89,Default,,0000,0000,0000,,Бұл жақсы емес. Шынымен!? Сосын шешіледі.
Dialogue: 0,0:59:12.89,0:59:15.89,Default,,0000,0000,0000,,Джина Голливудқа бірге барайық.
Dialogue: 0,0:59:16.93,0:59:21.48,Default,,0000,0000,0000,,Аспан қарақшысының оққағары жұмбақ. Бұл ақша мен атаққа бір қадам ғана.
Dialogue: 0,0:59:21.48,0:59:24.01,Default,,0000,0000,0000,,Келесі үлкен Голливуд жұлдызы.
Dialogue: 0,0:59:24.01,0:59:25.02,Default,,0000,0000,0000,,Әрі қарай не болады?
Dialogue: 0,0:59:25.02,0:59:27.04,Default,,0000,0000,0000,,Президент!
Dialogue: 0,0:59:27.04,0:59:34.94,Default,,0000,0000,0000,,Ахахахаха...! Ахахаха….
Dialogue: 0,0:59:34.94,0:59:40.50,Default,,0000,0000,0000,,Мен байсалдымын! Мен міндетті түрде Джинаны бірінші ханым етемін!
Dialogue: 0,0:59:40.50,0:59:42.85,Default,,0000,0000,0000,,Джина!
Dialogue: 0,0:59:42.85,0:59:45.05,Default,,0000,0000,0000,,Маған сенің мұндай ақымақтық ұнайды.
Dialogue: 0,0:59:45.05,0:59:47.24,Default,,0000,0000,0000,,Сені махаббат сиқырымен баурап алатын боламын.
Dialogue: 0,0:59:47.24,0:59:52.24,Default,,0000,0000,0000,,Бірақ жоқ, мен қазір бәс тігіп жатырмын.
Dialogue: 0,0:59:54.97,0:59:58.18,Default,,0000,0000,0000,,Егер мен осы бақта жүргенімде ол кісі маған қонаққа келсе →
Dialogue: 0,0:59:58.18,1:00:01.55,Default,,0000,0000,0000,,Мен сені бұл жолы жақсы көремін деп бәс тігемін.
Dialogue: 0,1:00:01.55,1:00:05.09,Default,,0000,0000,0000,,Бірақ ол ақымақ мейрамханаға түнде ғана келеді.
Dialogue: 0,1:00:05.09,1:00:08.12,Default,,0000,0000,0000,,Ол ешқашан күн сәулесіне түспейді.
Dialogue: 0,1:00:08.12,1:00:18.05,Default,,0000,0000,0000,,～ （）
Dialogue: 0,1:00:18.05,1:00:38.08,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:00:38.08,1:00:50.20,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:00:50.20,1:00:53.06,Default,,0000,0000,0000,,Әлгі бейбақ... Қайтып келді.
Dialogue: 0,1:00:53.06,1:01:13.26,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:01:13.26,1:01:33.96,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:01:33.96,1:01:53.16,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:01:53.16,1:01:55.18,Default,,0000,0000,0000,,～ …
Dialogue: 0,1:01:55.18,1:02:04.27,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:02:04.27,1:02:08.48,Default,,0000,0000,0000,,Мен түспей кетіп қалдым. Мен тағы бір ставкадан ұтылдым.
Dialogue: 0,1:02:08.48,1:02:11.01,Default,,0000,0000,0000,,Кез келген жағдайда... бәс тігу дегеніңізде әлгі бейбақты меңзеп тұрсыз!?
Dialogue: 0,1:02:11.01,1:02:13.19,Default,,0000,0000,0000,,Менде «B» рейтингі бар!
Dialogue: 0,1:02:13.19,1:02:17.07,Default,,0000,0000,0000,,Сіздің туған қалаңызға қарағанда мұнда өмір біршама күрделірек.
Dialogue: 0,1:02:17.07,1:02:20.27,Default,,0000,0000,0000,,Егер бұл махаббат болса, мен оны кез келген уақытта істей аламын, бірақ...
Dialogue: 0,1:02:20.27,1:02:23.30,Default,,0000,0000,0000,,Голливудқа өзім барамын.
Dialogue: 0,1:02:23.30,1:02:25.30,Default,,0000,0000,0000,,Бо... Мен!?
Dialogue: 0,1:02:29.86,1:02:33.06,Default,,0000,0000,0000,,Кенеттен акробатика жасап жатып басымды соқтым.
Dialogue: 0,1:02:33.06,1:02:35.92,Default,,0000,0000,0000,,Мен ескі досыма сәлем бердім.
Dialogue: 0,1:02:35.92,1:02:38.92,Default,,0000,0000,0000,,«Адриано қонақ үйіндегі» Джина?
Dialogue: 0,1:02:39.95,1:02:41.98,Default,,0000,0000,0000,,Бұл бұрын террасада болған ақ киімді адам.
Dialogue: 0,1:02:41.98,1:02:43.00,Default,,0000,0000,0000,,Мұны маған атам үйреткен.
Dialogue: 0,1:02:43.00,1:02:47.70,Default,,0000,0000,0000,,Адриатикалық теңіздегі барлық дирижабль жолаушылары Джинаға ғашық болады дейді.
Dialogue: 0,1:02:47.70,1:02:49.70,Default,,0000,0000,0000,,Қария Қосымша заттар...
Dialogue: 0,1:02:50.90,1:02:54.10,Default,,0000,0000,0000,,Әй, Джина қандай адам? Сіз де Поркоға ғашық болдыңыз ба?
Dialogue: 0,1:02:54.10,1:02:57.97,Default,,0000,0000,0000,,Мен жанармай құюға бара жатырмын. Сөйлеуді доғар, әйтпесе тіліңді тістейсің.
Dialogue: 0,1:02:57.97,1:02:59.97,Default,,0000,0000,0000,,Уау! асылу! Ах!
Dialogue: 0,1:03:13.13,1:03:14.13,Default,,0000,0000,0000,,Уф….
Dialogue: 0,1:03:22.05,1:03:27.05,Default,,0000,0000,0000,,Иә! Жауынгерлік қайықта бір қыз бар.
Dialogue: 0,1:03:28.94,1:03:32.98,Default,,0000,0000,0000,,Порко ше? Мен әкеммен қиын сөйлесіп жатырмын.
Dialogue: 0,1:03:32.98,1:03:36.03,Default,,0000,0000,0000,,…
Dialogue: 0,1:03:36.03,1:03:40.24,Default,,0000,0000,0000,,Олар әуе қарақшылары альянсын қабылдауға тырысады деп айтылады.
Dialogue: 0,1:03:40.24,1:03:44.94,Default,,0000,0000,0000,,Аспандағы қарақшыларды ауласаң да, бүгін бір тиын таппайсың.
Dialogue: 0,1:03:44.94,1:03:46.13,Default,,0000,0000,0000,,Орындалды. Кешіріңіз.
Dialogue: 0,1:03:46.13,1:03:49.65,Default,,0000,0000,0000,,Жоқ, барлық әңгіме рецессия туралы.
Dialogue: 0,1:03:49.65,1:03:53.03,Default,,0000,0000,0000,,Не, Порко екеуіне де сатуы керек.
Dialogue: 0,1:03:53.03,1:03:56.89,Default,,0000,0000,0000,,Сіздің дағдыларыңыз көп ақша төлейді.
Dialogue: 0,1:03:56.89,1:03:57.90,Default,,0000,0000,0000,,Сізде темекі бар ма?
Dialogue: 0,1:03:57.90,1:04:00.93,Default,,0000,0000,0000,,Кертис жақында Америкаға қайтады.
Dialogue: 0,1:04:00.93,1:04:05.98,Default,,0000,0000,0000,,Америкаға баруымыз керек.
Dialogue: 0,1:04:05.98,1:04:09.53,Default,,0000,0000,0000,,``Адриатика теңізіндегі азаттық пен азғындық күндерімен қоштасу.''
Dialogue: 0,1:04:09.53,1:04:12.05,Default,,0000,0000,0000,,Бұл Байрон ба? Жоқ, бұл қайтадан менмін.
Dialogue: 0,1:04:12.05,1:04:14.05,Default,,0000,0000,0000,,...
Dialogue: 0,1:04:17.93,1:04:19.12,Default,,0000,0000,0000,,Порко Бұл қорқынышты.
Dialogue: 0,1:04:19.12,1:04:23.12,Default,,0000,0000,0000,,Бензиннің Италиядағыдан үш есе қымбат екені ессіз.
Dialogue: 0,1:04:24.01,1:04:27.20,Default,,0000,0000,0000,,Аяғыңызға қарамаңыз.
Dialogue: 0,1:04:27.20,1:04:32.08,Default,,0000,0000,0000,,Менікі қоспасыз, сондықтан әйелдерге ұнамайды.
Dialogue: 0,1:04:32.08,1:04:34.10,Default,,0000,0000,0000,,Күйеуім, бірдеңе істе.
Dialogue: 0,1:04:34.10,1:04:36.12,Default,,0000,0000,0000,,Ол үшін төле, Фио.
Dialogue: 0,1:04:36.12,1:04:38.15,Default,,0000,0000,0000,,Жұмысты аяқтағаннан кейін бұл бөксе көрінгеннен үлкенірек болады→
Dialogue: 0,1:04:38.15,1:04:41.01,Default,,0000,0000,0000,,Оны пулемет саңылауына салыңыз.
Dialogue: 0,1:04:41.01,1:04:42.02,Default,,0000,0000,0000,,Жасыратын жерге ұшайық.
Dialogue: 0,1:04:42.02,1:04:46.02,Default,,0000,0000,0000,,Мен сіздің шотыңызға газ ақысын қосуды қамтамасыз етемін.
Dialogue: 0,1:04:51.95,1:04:56.99,Default,,0000,0000,0000,,Сен алдамайсың, ұстайсың.
Dialogue: 0,1:04:56.99,1:05:00.03,Default,,0000,0000,0000,,Теңіз де, жер де әдемі көрінеді, бірақ бұл жер тып-типыл.
Dialogue: 0,1:05:00.03,1:05:02.03,Default,,0000,0000,0000,,Һмм.
Dialogue: 0,1:05:03.23,1:05:05.23,Default,,0000,0000,0000,,Мен бұл аралды көріп тұрмын.
Dialogue: 0,1:05:21.08,1:05:23.08,Default,,0000,0000,0000,,Уау...!
Dialogue: 0,1:05:25.11,1:05:27.11,Default,,0000,0000,0000,,Әдемі...!
Dialogue: 0,1:05:43.13,1:05:46.16,Default,,0000,0000,0000,,Жақсы жасырыну.
Dialogue: 0,1:05:46.16,1:05:50.16,Default,,0000,0000,0000,,Ах! Менің бөксем қатып қалды.
Dialogue: 0,1:05:59.62,1:06:01.62,Default,,0000,0000,0000,,Шошқа!!
Dialogue: 0,1:06:04.17,1:06:06.17,Default,,0000,0000,0000,,Қозғалмаңыз!
Dialogue: 0,1:06:07.20,1:06:10.06,Default,,0000,0000,0000,,Талай лас заттар қайтадан шықты.
Dialogue: 0,1:06:10.06,1:06:12.09,Default,,0000,0000,0000,,Бастық! Мен сізді ұстадым, бастық!
Dialogue: 0,1:06:12.09,1:06:15.28,Default,,0000,0000,0000,,Қат! Сіз адамдарды жаншып жатырсыз.
Dialogue: 0,1:06:15.28,1:06:19.49,Default,,0000,0000,0000,,Жолдан кет! Мен сені күттім, шошқа.
Dialogue: 0,1:06:19.49,1:06:21.84,Default,,0000,0000,0000,,Мен сенің келетініңді білдім...
Dialogue: 0,1:06:21.84,1:06:24.87,Default,,0000,0000,0000,,Мен сізге көп қарыздармын.
Dialogue: 0,1:06:24.87,1:06:28.08,Default,,0000,0000,0000,,Бұл қыз! Мен қызды мінгіздім. сүйкімді!
Dialogue: 0,1:06:28.08,1:06:32.12,Default,,0000,0000,0000,,Шулы! Әйелге не болды? Әлемнің жартысы әйелдер.
Dialogue: 0,1:06:32.12,1:06:36.99,Default,,0000,0000,0000,,Сәлем! Ол қыз жай қыз емес.
Dialogue: 0,1:06:36.99,1:06:38.18,Default,,0000,0000,0000,,Ол Piccolo компаниясының бас дизайнері. Аа!?
Dialogue: 0,1:06:38.18,1:06:43.90,Default,,0000,0000,0000,,Жас әрі сүйкімді ме? Бұл әйел, бұл рас па?
Dialogue: 0,1:06:43.90,1:06:47.10,Default,,0000,0000,0000,,Сіз менің қайығымды бұрынғыдан да жақсы еттіңіз.
Dialogue: 0,1:06:47.10,1:06:49.12,Default,,0000,0000,0000,,Ол жас, бірақ қолы жақсы.
Dialogue: 0,1:06:49.12,1:06:52.15,Default,,0000,0000,0000,,Не? ШЫН? Порко.
Dialogue: 0,1:06:52.15,1:06:55.18,Default,,0000,0000,0000,,Ұшатын қайықтар туралы өтірік айтуға болмайды.
Dialogue: 0,1:06:55.18,1:06:59.39,Default,,0000,0000,0000,,Оған құрметпен қара, оның соңынан өндіріп алушы барды.
Dialogue: 0,1:06:59.39,1:07:03.92,Default,,0000,0000,0000,,Гахаха! Сізде несие бар ма? Қараңдар!
Dialogue: 0,1:07:03.92,1:07:06.13,Default,,0000,0000,0000,,Сәлем! Мына жігіттің ұятсыз ашық қызыл қайығы →
Dialogue: 0,1:07:06.13,1:07:09.13,Default,,0000,0000,0000,,Қарызды ғана қалдыр да, құрт!
Dialogue: 0,1:07:10.16,1:07:13.03,Default,,0000,0000,0000,,Оны жою!? Мен жасаған қайықты жоймақшысың ба?
Dialogue: 0,1:07:13.03,1:07:17.40,Default,,0000,0000,0000,,Осындай әдемі қайықты балтамен жоюға қалай дәтің бар!?
Dialogue: 0,1:07:17.40,1:07:21.10,Default,,0000,0000,0000,,Ханым, мұның терең себебі бар.
Dialogue: 0,1:07:21.10,1:07:23.12,Default,,0000,0000,0000,,Сен оны құртпақсың ба? Сонымен...
Dialogue: 0,1:07:23.12,1:07:26.99,Default,,0000,0000,0000,,Балалар, сіз әлі де дирижабльдесіз бе?
Dialogue: 0,1:07:26.99,1:07:28.99,Default,,0000,0000,0000,,Кет! менің аяқ киімім.
Dialogue: 0,1:07:36.09,1:07:42.14,Default,,0000,0000,0000,,Мен кішкентай кезімнен ұшатын қайықтар туралы ертегілерді тыңдайтынмын.
Dialogue: 0,1:07:42.14,1:07:45.01,Default,,0000,0000,0000,,Ұшатын қайықтарға мінгеннен асқан сүйкімді еркек жоқ дейді→
Dialogue: 0,1:07:45.01,1:07:47.03,Default,,0000,0000,0000,,Атам үнемі солай айтатын.
Dialogue: 0,1:07:47.03,1:07:51.08,Default,,0000,0000,0000,,Себебі олардың жүрегін теңіз де, аспан да жуады.
Dialogue: 0,1:07:51.08,1:07:55.11,Default,,0000,0000,0000,,Демек, дирижабль мінген адам теңізшіден батыл→
Dialogue: 0,1:07:55.11,1:07:58.14,Default,,0000,0000,0000,,Ол жердегі ұшқыштан да мақтаншақ.
Dialogue: 0,1:07:58.14,1:08:00.33,Default,,0000,0000,0000,,Дұрыс, дұрыс!
Dialogue: 0,1:08:00.33,1:08:04.04,Default,,0000,0000,0000,,Ұшатын қайықпен жүрудің мәні осы екенін айтудың қажеті жоқ.
Dialogue: 0,1:08:04.04,1:08:10.09,Default,,0000,0000,0000,,Олар үшін ең маңыздысы ақша немесе әйел емес, абырой.
Dialogue: 0,1:08:10.09,1:08:12.12,Default,,0000,0000,0000,,Иә! Бұл дұрыс! Не Чан, керемет!
Dialogue: 0,1:08:12.12,1:08:15.15,Default,,0000,0000,0000,,Ұшатын қайық аман болсын! Ха~!
Dialogue: 0,1:08:15.15,1:08:18.01,Default,,0000,0000,0000,,Қандай керемет қыз.
Dialogue: 0,1:08:18.01,1:08:20.20,Default,,0000,0000,0000,,Мен әңгімені түсіндім.
Dialogue: 0,1:08:20.20,1:08:23.23,Default,,0000,0000,0000,,Мен сіз жасаған дирижабльді жою үшін балта қолдануды қойдым.
Dialogue: 0,1:08:23.23,1:08:28.11,Default,,0000,0000,0000,,Бірақ шегініс жасай берсек, аспан қарақшыларының намысын қорғай алмаймыз!
Dialogue: 0,1:08:28.11,1:08:33.16,Default,,0000,0000,0000,,Мен шошқаны фаршқа айналдырамын! Бұл дұрыс! Шошқаны сындырыңыз!
Dialogue: 0,1:08:33.16,1:08:37.20,Default,,0000,0000,0000,,Не айтып тұрсың?! Сіз мүлде түсінбейсіз!
Dialogue: 0,1:08:37.20,1:08:40.23,Default,,0000,0000,0000,,Ұялмайсың ба дейсің бе?
Dialogue: 0,1:08:40.23,1:08:43.26,Default,,0000,0000,0000,,Мен Америкадан келген Кертистің көмегімен жақсымын.
Dialogue: 0,1:08:43.26,1:08:45.94,Default,,0000,0000,0000,,Анаң мұны естісе, жылайтын шығар!
Dialogue: 0,1:08:45.94,1:08:47.13,Default,,0000,0000,0000,,Не! Тіпті ваннаға түспеңіз.
Dialogue: 0,1:08:47.13,1:08:52.01,Default,,0000,0000,0000,,Порко, Адриатикадағы ұшатын қайықтардың құрметі мен мақтанышы үшін →
Dialogue: 0,1:08:52.01,1:08:55.05,Default,,0000,0000,0000,,Мен мұнда Кертиспен жеке-жеке жекпе-жек өткізу үшін келдім!
Dialogue: 0,1:08:55.05,1:09:00.05,Default,,0000,0000,0000,,Ешқандай ерік-жігері жоқ адам - ​​ең жаман. Батыл күрес!
Dialogue: 0,1:09:01.27,1:09:04.13,Default,,0000,0000,0000,,Сондықтан мен Кертисті жұмысқа алуға қарсы болдым.
Dialogue: 0,1:09:04.13,1:09:07.00,Default,,0000,0000,0000,,Ол қатыгез бейбақ. Ол қашуға тырысады.
Dialogue: 0,1:09:07.00,1:09:10.53,Default,,0000,0000,0000,,Бастық, не істеуіміз керек? Оның сендіру күші бар.
Dialogue: 0,1:09:10.53,1:09:15.08,Default,,0000,0000,0000,,Мұнда бір ғана орын бар. Екі жаққа да қарап, Кертис деген жігіттен сұрайық.
Dialogue: 0,1:09:15.08,1:09:18.11,Default,,0000,0000,0000,,Сіз шошқамен тағы да жарысуымды сұрайсыз ба?
Dialogue: 0,1:09:18.11,1:09:23.16,Default,,0000,0000,0000,,Келісімшарттың мерзімі аяқталды, солай ма? Мен ұялып тұрмын...
Dialogue: 0,1:09:23.16,1:09:27.03,Default,,0000,0000,0000,,… …
Dialogue: 0,1:09:27.03,1:09:29.03,Default,,0000,0000,0000,,Бұл Кертистің бейбақы!
Dialogue: 0,1:09:32.75,1:09:36.75,Default,,0000,0000,0000,,Мен әңгімені естідім! Мен қашпаймын немесе жасырмаймын!
Dialogue: 0,1:09:37.97,1:09:41.17,Default,,0000,0000,0000,,Анау ақымақтар осындай жерге жол салыпты...
Dialogue: 0,1:09:41.17,1:09:52.28,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:09:52.28,1:09:54.28,Default,,0000,0000,0000,,Эй, сақта.
Dialogue: 0,1:09:58.01,1:10:01.04,Default,,0000,0000,0000,,Басқаша айтқанда, сіз жауапты матч өткізгіңіз келеді, солай ма?
Dialogue: 0,1:10:01.04,1:10:04.23,Default,,0000,0000,0000,,Бірақ бұл бір рет жеңіске жеткен шайқас.
Dialogue: 0,1:10:04.23,1:10:07.10,Default,,0000,0000,0000,,Мен енді олардың күзетшісі емеспін.
Dialogue: 0,1:10:07.10,1:10:10.96,Default,,0000,0000,0000,,Бұл сіз мұны тегін жасамайсыз дегенді білдіре ме? Қандай шарттар бар?
Dialogue: 0,1:10:10.96,1:10:20.90,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:10:20.90,1:10:23.09,Default,,0000,0000,0000,,Әдемі...!
Dialogue: 0,1:10:23.09,1:10:26.96,Default,,0000,0000,0000,,Мен жеңсем, маған үйленесің бе?
Dialogue: 0,1:10:26.96,1:10:28.96,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:10:29.99,1:10:32.18,Default,,0000,0000,0000,,Мен байсалдымын. Мен түссіндім.
Dialogue: 0,1:10:32.18,1:10:36.39,Default,,0000,0000,0000,,Керісінше, Порко жеңсе, сіз бұл шотты төлейсіз.
Dialogue: 0,1:10:36.39,1:10:37.73,Default,,0000,0000,0000,,Күте тұрыңыз! Fio!
Dialogue: 0,1:10:37.73,1:10:39.73,Default,,0000,0000,0000,,Аузыңды жап!
Dialogue: 0,1:10:43.96,1:10:46.99,Default,,0000,0000,0000,,Фио мырза, егер сіз одан бас тартқыңыз келсе, дәл қазір уақыт.
Dialogue: 0,1:10:46.99,1:10:48.01,Default,,0000,0000,0000,,Сұрағыңыз келсе, осы адамнан сұраңыз.
Dialogue: 0,1:10:48.01,1:10:51.04,Default,,0000,0000,0000,,Бұл шот сәл қымбат. Бұл арзан.
Dialogue: 0,1:10:51.04,1:10:53.89,Default,,0000,0000,0000,,Мұны істеу керек пе, орындамау!?
Dialogue: 0,1:10:53.89,1:10:58.28,Default,,0000,0000,0000,,Мен сүйген адамдарым үшін қуана күресемін. Жақсы!
Dialogue: 0,1:10:58.28,1:11:03.99,Default,,0000,0000,0000,,Барлығың тыңдаңдар! Мені Фио ханымның рухы таң қалдырды!
Dialogue: 0,1:11:03.99,1:11:06.02,Default,,0000,0000,0000,,Бұл жекпе-жекті менің Маммаюто командасы басқарады!
Dialogue: 0,1:11:06.02,1:11:07.03,Default,,0000,0000,0000,,О!
Dialogue: 0,1:11:07.03,1:11:12.91,Default,,0000,0000,0000,,Әуе қарақшылары альянсына да шабуыл жасайық! Бұл дұрыс!
Dialogue: 0,1:11:12.91,1:11:14.10,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:11:14.10,1:11:18.31,Default,,0000,0000,0000,,Фио-сан, мен сені күтемін! Қайта кездескенше!
Dialogue: 0,1:11:18.31,1:11:21.84,Default,,0000,0000,0000,,Иә! Сені қарғаймын!
Dialogue: 0,1:11:21.84,1:11:24.04,Default,,0000,0000,0000,,Шошқа! Қашпа!
Dialogue: 0,1:11:24.04,1:11:28.91,Default,,0000,0000,0000,,Шулы! Тез жоғалтып ал!
Dialogue: 0,1:11:28.91,1:11:30.91,Default,,0000,0000,0000,,Сау болыңыз!
Dialogue: 0,1:11:33.13,1:11:36.99,Default,,0000,0000,0000,,Біртүрлі нәрсе болды.
Dialogue: 0,1:11:36.99,1:11:38.18,Default,,0000,0000,0000,,Жалпы айтқанда, сіз...!
Dialogue: 0,1:11:38.18,1:11:40.53,Default,,0000,0000,0000,,Ашуланба!
Dialogue: 0,1:11:40.53,1:11:43.53,Default,,0000,0000,0000,,Мен өзім ақымақ екенімді білемін.
Dialogue: 0,1:11:49.12,1:11:50.13,Default,,0000,0000,0000,,Fio….
Dialogue: 0,1:11:50.13,1:11:54.00,Default,,0000,0000,0000,,Мен сізге алғыс айтуым керек сияқты.
Dialogue: 0,1:11:54.00,1:11:56.19,Default,,0000,0000,0000,,Сіз маған мүмкіндік бердіңіз.
Dialogue: 0,1:11:56.19,1:12:01.24,Default,,0000,0000,0000,,Рахмет. Екеуміздің тағдырымыз ортақ.
Dialogue: 0,1:12:01.24,1:12:03.24,Default,,0000,0000,0000,,Біз серіктеспіз.
Dialogue: 0,1:12:05.61,1:12:08.14,Default,,0000,0000,0000,,Бұл 50-50 шайқас.
Dialogue: 0,1:12:08.14,1:12:11.00,Default,,0000,0000,0000,,Мен Поркоға сенемін.
Dialogue: 0,1:12:11.00,1:12:14.20,Default,,0000,0000,0000,,«Мен сенемін»...Мен бұл сөзді жек көремін, бірақ→
Dialogue: 0,1:12:14.20,1:12:17.20,Default,,0000,0000,0000,,Айтқанда басқаша естіледі.
Dialogue: 0,1:12:22.11,1:12:27.49,Default,,0000,0000,0000,,Не болды? Өзіңізді нашар сезінесіз бе? Фио...?
Dialogue: 0,1:12:27.49,1:12:28.01,Default,,0000,0000,0000,,Жарайды...
Dialogue: 0,1:12:28.01,1:12:32.05,Default,,0000,0000,0000,,Дәл қазір жүрегім кенет соғып, ауыра бастады.
Dialogue: 0,1:12:32.05,1:12:35.91,Default,,0000,0000,0000,,Негізі мен қатты қорықтым...
Dialogue: 0,1:12:35.91,1:12:38.91,Default,,0000,0000,0000,,Мен қиындыққа тап болдым. Менің тізем дірілдеп тұр.
Dialogue: 0,1:12:41.97,1:12:43.32,Default,,0000,0000,0000,,О... Эй!
Dialogue: 0,1:12:43.32,1:12:45.68,Default,,0000,0000,0000,,Мен жүземін!
Dialogue: 0,1:12:45.68,1:13:03.19,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:13:03.19,1:13:06.05,Default,,0000,0000,0000,,Порко Үлкен сәтсіздік!
Dialogue: 0,1:13:06.05,1:13:08.24,Default,,0000,0000,0000,,Не болды~!?
Dialogue: 0,1:13:08.24,1:13:11.94,Default,,0000,0000,0000,,Мен бұл есепшотты көбейтуім керек еді!
Dialogue: 0,1:13:11.94,1:13:14.13,Default,,0000,0000,0000,,Мен жеңілдім!
Dialogue: 0,1:13:14.13,1:13:17.16,Default,,0000,0000,0000,,Ой… Бұл сәл ағаттық болды.
Dialogue: 0,1:13:17.16,1:13:22.16,Default,,0000,0000,0000,,Бұл дұрыс емес хахахаха...!
Dialogue: 0,1:18:32.31,1:18:43.08,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:18:43.08,1:18:45.94,Default,,0000,0000,0000,,Порко….
Dialogue: 0,1:18:45.94,1:18:48.97,Default,,0000,0000,0000,,Хмм...? Ұйықтау мүмкін емес пе?
Dialogue: 0,1:18:48.97,1:18:51.00,Default,,0000,0000,0000,,Қазір...!
Dialogue: 0,1:18:51.00,1:18:54.03,Default,,0000,0000,0000,,Бұл арман болды ма?
Dialogue: 0,1:18:54.03,1:18:59.58,Default,,0000,0000,0000,,Ұйқыларыңыз тыныш, ертең ерте.
Dialogue: 0,1:18:59.58,1:19:01.10,Default,,0000,0000,0000,,Порко. а?
Dialogue: 0,1:19:01.10,1:19:03.12,Default,,0000,0000,0000,,Порко неліктен шошқаға айналды?
Dialogue: 0,1:19:03.12,1:19:06.98,Default,,0000,0000,0000,,Келіңіздер...
Dialogue: 0,1:19:06.98,1:19:10.19,Default,,0000,0000,0000,,Мен капитан Марко Пагот туралы көп білемін.
Dialogue: 0,1:19:10.19,1:19:12.05,Default,,0000,0000,0000,,Сенің әкең бір бөлімде болған, солай ма?
Dialogue: 0,1:19:12.05,1:19:17.10,Default,,0000,0000,0000,,Жау ұшқышын құтқару үшін дауылды теңізге түсіп кеткен капитан оқиғасы→
Dialogue: 0,1:19:17.10,1:19:20.10,Default,,0000,0000,0000,,Маған ұнады, талай рет тыңдадым.
Dialogue: 0,1:19:24.00,1:19:26.02,Default,,0000,0000,0000,,Порко! Мен сені сүйейін бе?
Dialogue: 0,1:19:26.02,1:19:28.03,Default,,0000,0000,0000,,Иә!?
Dialogue: 0,1:19:28.03,1:19:30.89,Default,,0000,0000,0000,,Қараңдар! Ханзада бақаға айналды →
Dialogue: 0,1:19:30.89,1:19:33.92,Default,,0000,0000,0000,,Ханшайымның сүйісі сені қайтадан адамға айналдыратын оқиға бар.
Dialogue: 0,1:19:33.92,1:19:38.92,Default,,0000,0000,0000,,Ақымақ! Бұл заттарды ең маңызды кезде сақтаңыз!
Dialogue: 0,1:19:39.15,1:19:42.15,Default,,0000,0000,0000,,Менің қолымнан келмейді...
Dialogue: 0,1:19:43.85,1:19:47.90,Default,,0000,0000,0000,,Хехе... Фиоға қарап жақсы қызсың→
Dialogue: 0,1:19:47.90,1:19:51.10,Default,,0000,0000,0000,,Мен адамдар да біз бас тартқан нәрсе емес деп ойлай бастадым.
Dialogue: 0,1:19:51.10,1:19:53.12,Default,,0000,0000,0000,,Енді сен жақсы қызсың, ұйықта.
Dialogue: 0,1:19:53.12,1:19:56.12,Default,,0000,0000,0000,,Бірдеңе туралы сөйлесейік, сосын мен ұйықтайын.
Dialogue: 0,1:19:57.16,1:20:02.16,Default,,0000,0000,0000,,Әңгіме...? Бұл дұрыс...
Dialogue: 0,1:20:11.13,1:20:14.00,Default,,0000,0000,0000,,Бұл соғыстың соңғы жазы болатын.
Dialogue: 0,1:20:14.00,1:20:17.03,Default,,0000,0000,0000,,Біз әдеттегі патрульдеміз →
Dialogue: 0,1:20:17.03,1:20:21.03,Default,,0000,0000,0000,,Истрияны көздеп, Адриатика теңізіне шықтым.
Dialogue: 0,1:20:26.45,1:20:29.98,Default,,0000,0000,0000,,Қасымда берлиндік жігіт ұшып бара жатты.
Dialogue: 0,1:20:29.98,1:20:35.20,Default,,0000,0000,0000,,Біз ескі достармыз, Якко-сан, екі күн бұрын үйлендік.
Dialogue: 0,1:20:35.20,1:20:39.08,Default,,0000,0000,0000,,Мен салтанатты рәсімнің куәгері болдым, бірақ→
Dialogue: 0,1:20:39.08,1:20:44.13,Default,,0000,0000,0000,,Демалыс уақытым жетпей, майдан даласына қайта оралдым.
Dialogue: 0,1:20:44.13,1:21:03.15,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:21:03.15,1:21:07.03,Default,,0000,0000,0000,,Жан-жағым, дос пен дұшпан шыбын боп құлады.
Dialogue: 0,1:21:07.03,1:21:11.56,Default,,0000,0000,0000,,Мені үш білікті ұшақ қуып бара жатты.
Dialogue: 0,1:21:11.56,1:21:13.92,Default,,0000,0000,0000,,Достарыма көңіл бөлуге уақытым болмады.
Dialogue: 0,1:21:13.92,1:21:16.12,Default,,0000,0000,0000,,Көп ұзамай мен жалғыз одақтас болдым.
Dialogue: 0,1:21:16.12,1:21:21.17,Default,,0000,0000,0000,,Сөйтсе де олар берілмей, тозақтай жүгірді.
Dialogue: 0,1:21:21.17,1:21:26.21,Default,,0000,0000,0000,,Қол-аяғым жансызданып, тіпті көзім айналып барады.→
Dialogue: 0,1:21:26.21,1:21:29.24,Default,,0000,0000,0000,,Міне, мен бәрі бітті деп ойладым...
Dialogue: 0,1:21:29.24,1:21:32.44,Default,,0000,0000,0000,,Кенет менің көз алдымда бәрі аппақ болып кетті.
Dialogue: 0,1:21:32.44,1:21:36.44,Default,,0000,0000,0000,,Таза ақ? О, іштегі жарық жақсырақ болар еді.
Dialogue: 0,1:21:37.16,1:21:40.19,Default,,0000,0000,0000,,Жарық болғаны сонша, мен бұлттардың ішінде екенімді түсіндім→
Dialogue: 0,1:21:40.19,1:21:43.05,Default,,0000,0000,0000,,Бұл көп уақытты алды.
Dialogue: 0,1:21:43.05,1:21:47.09,Default,,0000,0000,0000,,Мен шаршадым, ұшқышқа күш-қуатым қалмады.
Dialogue: 0,1:21:47.09,1:21:51.46,Default,,0000,0000,0000,,Десе де, қайық өздігінен ұшады.
Dialogue: 0,1:21:51.46,1:22:11.00,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:22:11.00,1:22:16.38,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:22:16.38,1:22:19.91,Default,,0000,0000,0000,,Бұлттардың жазықтары...?
Dialogue: 0,1:22:19.91,1:22:25.97,Default,,0000,0000,0000,,А... тым тыныш, аспан қандай әдемі.
Dialogue: 0,1:22:25.97,1:22:31.03,Default,,0000,0000,0000,,Жұмбақ бұлт жол бойы көтеріліп бара жатты.
Dialogue: 0,1:22:31.03,1:22:51.23,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:22:51.23,1:22:57.96,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:22:57.96,1:23:00.96,Default,,0000,0000,0000,,Берлини! Жақсы болды ма?
Dialogue: 0,1:23:03.02,1:23:07.72,Default,,0000,0000,0000,,Берлинді күтіңіз! Қайда барасың!?
Dialogue: 0,1:23:07.72,1:23:19.01,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:23:19.01,1:23:23.05,Default,,0000,0000,0000,,Берлини! Барма! Сіз Джинамен не істеуді жоспарлап отырсыз?
Dialogue: 0,1:23:23.05,1:23:25.07,Default,,0000,0000,0000,,Оның орнына мен барамын!
Dialogue: 0,1:23:25.07,1:23:45.10,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:23:45.10,1:24:04.13,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:24:04.13,1:24:11.13,Default,,0000,0000,0000,,Оянсам, теңіз бетінде жалғыз ұшып бара жатырмын...
Dialogue: 0,1:24:13.05,1:24:17.25,Default,,0000,0000,0000,,Құдай: «Әлі келме» деді.
Dialogue: 0,1:24:17.25,1:24:20.95,Default,,0000,0000,0000,,Ха... Маған: «Сіз әрқашан → болдыңыз
Dialogue: 0,1:24:20.95,1:24:23.98,Default,,0000,0000,0000,,Маған тек соны істеп, жалғыз ұшып кетуді бұйырғандай болдым.
Dialogue: 0,1:24:23.98,1:24:26.01,Default,,0000,0000,0000,,Бұл шындық болуы мүмкін емес! Порко - жақсы адам!
Dialogue: 0,1:24:26.01,1:24:28.20,Default,,0000,0000,0000,,Жақсы жігіт өлген жігітпен тең.
Dialogue: 0,1:24:28.20,1:24:31.23,Default,,0000,0000,0000,,Оның үстіне бұл жер тозақ болуы мүмкін.
Dialogue: 0,1:24:31.23,1:24:35.23,Default,,0000,0000,0000,,Ертегі бітті, енді ұйықта.
Dialogue: 0,1:24:37.12,1:24:40.82,Default,,0000,0000,0000,,Қоқыс дүкенінің жігіті, тат оқ, қылмыскер...
Dialogue: 0,1:24:40.82,1:24:42.17,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:24:42.17,1:24:45.20,Default,,0000,0000,0000,,Порконың тірі оралғанына қуаныштымын.
Dialogue: 0,1:24:45.20,1:24:47.20,Default,,0000,0000,0000,,Маған Порко ұнайды.
Dialogue: 0,1:24:49.07,1:24:50.07,Default,,0000,0000,0000,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,1:27:27.99,1:27:31.03,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:27:31.03,1:27:45.83,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:27:45.83,1:27:49.21,Default,,0000,0000,0000,,Кел, кел! Шошқа жеңе ме, әлде Кертис жеңе ме?
Dialogue: 0,1:27:49.21,1:27:51.06,Default,,0000,0000,0000,,Еркек болсаң жаса!
Dialogue: 0,1:27:51.06,1:27:53.25,Default,,0000,0000,0000,,Балмұздақ алғыңыз келе ме?
Dialogue: 0,1:27:53.25,1:28:02.17,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:28:02.17,1:28:05.70,Default,,0000,0000,0000,,Сол ақымақтар фестивальде сахна жасап бітті...
Dialogue: 0,1:28:05.70,1:28:07.06,Default,,0000,0000,0000,,Бұл адамдардың барлығы аспан қарақшылары ма?
Dialogue: 0,1:28:07.06,1:28:10.25,Default,,0000,0000,0000,,Жерорта теңізіндегі қоқыс.
Dialogue: 0,1:28:10.25,1:28:14.12,Default,,0000,0000,0000,,Банды қарақшылар контрабанда тобы Жеке киімдегі тыңшылар...
Dialogue: 0,1:28:14.12,1:28:16.98,Default,,0000,0000,0000,,Катаги да аздап араласып кеткен бе деп ойлаймын.
Dialogue: 0,1:28:16.98,1:28:20.19,Default,,0000,0000,0000,,Хехехе... Бұл менің атақ-даңқымды арттыра түседі.
Dialogue: 0,1:28:20.19,1:28:24.73,Default,,0000,0000,0000,,１０ １０
Dialogue: 0,1:28:24.73,1:28:28.93,Default,,0000,0000,0000,,Бұдан былай Порко Россо және Дональд Кертис→
Dialogue: 0,1:28:28.93,1:28:32.14,Default,,0000,0000,0000,,Дуэль басталсын! Арнайы ережелер жоқ.
Dialogue: 0,1:28:32.14,1:28:37.19,Default,,0000,0000,0000,,Бірақ зұлымдық жасаған адам мәңгілік жек көреді.
Dialogue: 0,1:28:37.19,1:28:41.19,Default,,0000,0000,0000,,Дәптер жақсы! Ерте бастаңыз! Сіз сөзді тыңдауға келген жоқсыз!
Dialogue: 0,1:28:44.42,1:28:48.96,Default,,0000,0000,0000,,Аузыңды жап! Мен айналаны бұзғандарды өлтіремін!
Dialogue: 0,1:28:48.96,1:28:51.96,Default,,0000,0000,0000,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,1:28:54.02,1:28:56.02,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,1:28:57.05,1:29:00.08,Default,,0000,0000,0000,,10 тонналық бомбаны лақтырған дұрыс.
Dialogue: 0,1:29:00.08,1:29:02.27,Default,,0000,0000,0000,,Біздің сүйікті аруымыз Фио Пикколо →
Dialogue: 0,1:29:02.27,1:29:07.15,Default,,0000,0000,0000,,Бұл сенің тағдырыңды шешетін дуэль. Ешқандай шу шығармаңыз!
Dialogue: 0,1:29:07.15,1:29:11.19,Default,,0000,0000,0000,,Түсіндіңіз бе? Түсінсеңіз, шапалақтаңыз! шапалақтау!
Dialogue: 0,1:29:11.19,1:29:13.21,Default,,0000,0000,0000,,(Шапалақтау)
Dialogue: 0,1:29:13.21,1:29:15.06,Default,,0000,0000,0000,,бастайық.
Dialogue: 0,1:29:15.06,1:29:18.10,Default,,0000,0000,0000,,Бұл тітіркендіргіш. Бұл Кеджиме.
Dialogue: 0,1:29:18.10,1:29:22.10,Default,,0000,0000,0000,,Екі тарап өз ставкаларын қоюы керек.
Dialogue: 0,1:29:26.51,1:29:30.04,Default,,0000,0000,0000,,Өтінемін. рахмет.
Dialogue: 0,1:29:30.04,1:29:32.04,Default,,0000,0000,0000,,Қазір қойыңыз!
Dialogue: 0,1:29:34.25,1:29:38.30,Default,,0000,0000,0000,,Екі жақтың да шағымданатын ештеңесі жоқ па? Ендеше, бастамас бұрын қол алысып алайық!
Dialogue: 0,1:29:38.30,1:29:42.30,Default,,0000,0000,0000,,Мен оны жек көремін! Мен тазалықты жақсы көремін.
Dialogue: 0,1:29:44.19,1:29:47.05,Default,,0000,0000,0000,,Че! Ол дос емес бейбақ.
Dialogue: 0,1:29:47.05,1:29:50.75,Default,,0000,0000,0000,,Фио Мен аяқтағаннан кейін бірден шіркеуге барамын.
Dialogue: 0,1:29:50.75,1:29:55.75,Default,,0000,0000,0000,,Уайымдама, анаңның әңгімесі, үйренгеннен гөрі үйреніп кетесің.
Dialogue: 0,1:29:56.14,1:29:57.14,Default,,0000,0000,0000,,Бех! Бол!
Dialogue: 0,1:30:00.01,1:30:03.22,Default,,0000,0000,0000,,Менімен суретіңізді бөлісіңізші... Мен шомылдым!
Dialogue: 0,1:30:03.22,1:30:05.24,Default,,0000,0000,0000,,Барлығына! Күлімсіре!
Dialogue: 0,1:30:05.24,1:30:08.27,Default,,0000,0000,0000,,Күл! жоғары!
Dialogue: 0,1:30:08.27,1:30:10.27,Default,,0000,0000,0000,,(камера ысырмасының дыбысы)
Dialogue: 0,1:30:29.14,1:30:32.17,Default,,0000,0000,0000,,Ойын 3 минутта жеңсе, қара түсті артықшылыққа ие!
Dialogue: 0,1:30:32.17,1:30:36.17,Default,,0000,0000,0000,,Керемет! Сіз мұны ай сайын жасай аласыз ба деп ойлаймын.
Dialogue: 0,1:30:39.90,1:30:41.90,Default,,0000,0000,0000,,１５
Dialogue: 0,1:30:45.13,1:30:48.99,Default,,0000,0000,0000,,Бұл керемет. Хмм.
Dialogue: 0,1:30:48.99,1:30:49.01,Default,,0000,0000,0000,,５
Dialogue: 0,1:30:49.01,1:30:53.21,Default,,0000,0000,0000,,４… ３… ２… １…
Dialogue: 0,1:30:53.21,1:30:54.21,Default,,0000,0000,0000,,...
Dialogue: 0,1:30:55.07,1:31:02.81,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:31:02.81,1:31:04.99,Default,,0000,0000,0000,,Кертис жеңді!
Dialogue: 0,1:31:04.99,1:31:21.83,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:31:21.83,1:31:24.02,Default,,0000,0000,0000,,Біржақты болып шыға бастады.
Dialogue: 0,1:31:24.02,1:31:25.04,Default,,0000,0000,0000,,Маған қарызға бер!
Dialogue: 0,1:31:25.04,1:31:31.10,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:31:31.10,1:31:34.13,Default,,0000,0000,0000,,Порко, сен не істеп жатырсың!? Биіктікке жету!
Dialogue: 0,1:31:34.13,1:31:37.98,Default,,0000,0000,0000,,Қазір басыңды көтерсең, оқ тиеді →
Dialogue: 0,1:31:37.98,1:31:39.51,Default,,0000,0000,0000,,Су бетінде ату қиынырақ.
Dialogue: 0,1:31:39.51,1:31:45.24,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:31:45.24,1:31:49.94,Default,,0000,0000,0000,,Мен сені пайдасыз оқ атуға мәжбүр етсем де, мен саған рұқсат бермеймін.
Dialogue: 0,1:31:49.94,1:32:04.09,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:32:04.09,1:32:07.12,Default,,0000,0000,0000,,Қандай бұралу! Шошқа артынан ерді.
Dialogue: 0,1:32:07.12,1:32:09.14,Default,,0000,0000,0000,,Твист!?
Dialogue: 0,1:32:09.14,1:32:12.17,Default,,0000,0000,0000,,Бұл трюк шошқаны Адриатика теңізінің атына айналдырды.
Dialogue: 0,1:32:12.17,1:32:16.04,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:32:16.04,1:32:18.23,Default,,0000,0000,0000,,～
Dialogue: 0,1:32:18.23,1:32:23.95,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:32:23.95,1:32:25.13,Default,,0000,0000,0000,,～
Dialogue: 0,1:32:25.13,1:32:29.01,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:32:29.01,1:32:33.04,Default,,0000,0000,0000,,Атпа!? Пулемет дұрыс жұмыс істемей ме?
Dialogue: 0,1:32:33.04,1:32:36.24,Default,,0000,0000,0000,,Сен ол бейбақты оқыдың. Ол соңына дейін атпайды.
Dialogue: 0,1:32:36.24,1:32:40.61,Default,,0000,0000,0000,,Не? Шошқалар өлтірмейді.
Dialogue: 0,1:32:40.61,1:32:44.15,Default,,0000,0000,0000,,Американың жігіттері қазір барлық жерде жүр емес пе? Міне! Ат!
Dialogue: 0,1:32:44.15,1:32:47.02,Default,,0000,0000,0000,,Атқан жоқпын! Мен айтқанымдай.
Dialogue: 0,1:32:47.02,1:32:50.05,Default,,0000,0000,0000,,Қазір атсаң, американдық жігітті де соғасың →
Dialogue: 0,1:32:50.05,1:32:52.07,Default,,0000,0000,0000,,Басқа адам ұялшақ және тыныш болғаннан кейін→
Dialogue: 0,1:32:52.07,1:32:55.10,Default,,0000,0000,0000,,Мен қозғалтқышты аяқтау үшін екі-үш атуды жоспарлап отырмын.
Dialogue: 0,1:32:55.10,1:32:59.47,Default,,0000,0000,0000,,Ол соншалықты жиіркенішті бейбақ, бұл соғыс немесе басқа нәрсе емес.
Dialogue: 0,1:32:59.47,1:33:01.99,Default,,0000,0000,0000,,Порко….
Dialogue: 0,1:33:01.99,1:33:04.19,Default,,0000,0000,0000,,Әй, сен мені өлтірейін деп тұрсың ба!? Кел мені ат!
Dialogue: 0,1:33:04.19,1:33:08.23,Default,,0000,0000,0000,,Е, пулемет жынды ғой, солай емес пе?
Dialogue: 0,1:33:08.23,1:33:09.24,Default,,0000,0000,0000,,Қараңдар!
Dialogue: 0,1:33:09.24,1:33:10.24,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,1:33:14.96,1:33:16.96,Default,,0000,0000,0000,,Ах! Мұнда келе жатыр!
Dialogue: 0,1:33:19.34,1:33:22.34,Default,,0000,0000,0000,,Алданба... Маған еріп жүр, шошқа!
Dialogue: 0,1:33:27.08,1:33:29.94,Default,,0000,0000,0000,,Мұнда келме! Апыр-ай!
Dialogue: 0,1:33:29.94,1:33:31.94,Default,,0000,0000,0000,,Мен шошқаға соқтым!
Dialogue: 0,1:33:32.97,1:33:34.97,Default,,0000,0000,0000,,Түсіңіз! Кя~!
Dialogue: 0,1:33:37.19,1:33:39.19,Default,,0000,0000,0000,,Кя!
Dialogue: 0,1:33:41.22,1:33:42.22,Default,,0000,0000,0000,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,1:33:43.75,1:33:45.75,Default,,0000,0000,0000,,Мына жерде жасаңыз!
Dialogue: 0,1:33:50.98,1:33:53.98,Default,,0000,0000,0000,,Керемет! Шошқа бұлтты тартты!
Dialogue: 0,1:33:59.24,1:34:03.28,Default,,0000,0000,0000,,Мұндай әуе шайқасын өміріңізде бір-ақ рет көресіз!
Dialogue: 0,1:34:03.28,1:34:05.28,Default,,0000,0000,0000,,Мен қатты әсерлендім...!
Dialogue: 0,1:34:07.65,1:34:09.65,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:34:14.06,1:34:18.09,Default,,0000,0000,0000,,Біз дайындап қойсақ та, асықпасақ бітеді.
Dialogue: 0,1:34:18.09,1:34:20.12,Default,,0000,0000,0000,,Дәл сол сәтте мен бөлмеге кірдім.
Dialogue: 0,1:34:20.12,1:34:24.12,Default,,0000,0000,0000,,Сіз барасыз ба? Сіз емес пе? Менің де көргім келеді.
Dialogue: 0,1:34:25.17,1:34:30.17,Default,,0000,0000,0000,,(Морзе коды)
Dialogue: 0,1:34:35.10,1:34:39.13,Default,,0000,0000,0000,,«Жүректің G нүктесіне шошқаның сізбен байланысуын сұраңыз».
Dialogue: 0,1:34:39.13,1:34:42.17,Default,,0000,0000,0000,,«Әуе күштері бұл нонсенстің желін ұстады».
Dialogue: 0,1:34:42.17,1:34:45.17,Default,,0000,0000,0000,,F... Бұл Феррарин!
Dialogue: 0,1:34:47.21,1:34:49.21,Default,,0000,0000,0000,,Бізге асығу керек!
Dialogue: 0,1:35:07.09,1:35:11.29,Default,,0000,0000,0000,,Сонда да екеуі де қатал.
Dialogue: 0,1:35:11.29,1:35:13.15,Default,,0000,0000,0000,,Әлі алда!
Dialogue: 0,1:35:13.15,1:35:15.16,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:35:15.16,1:35:18.69,Default,,0000,0000,0000,,Порко~! Іске сәт!
Dialogue: 0,1:35:18.69,1:35:19.69,Default,,0000,0000,0000,,Бұл өтірік болғандықтан ба?>
Dialogue: 0,1:35:20.05,1:35:23.05,Default,,0000,0000,0000,,Ууууу... шошқа...!
Dialogue: 0,1:35:28.13,1:35:32.13,Default,,0000,0000,0000,,Эй, сен Fio ойнай аласың ба?
Dialogue: 0,1:35:37.71,1:35:41.71,Default,,0000,0000,0000,,Жарайды, артымызда шошқа! Бұл финал!
Dialogue: 0,1:35:45.13,1:35:46.13,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:35:48.16,1:35:50.16,Default,,0000,0000,0000,,Бітелу мен оны тудырдым.
Dialogue: 0,1:35:53.04,1:35:55.04,Default,,0000,0000,0000,,Аяқтаңыз!
Dialogue: 0,1:35:58.09,1:36:00.44,Default,,0000,0000,0000,,Не!? Не!?
Dialogue: 0,1:36:00.44,1:36:02.97,Default,,0000,0000,0000,,Ол бітеліп қалды!
Dialogue: 0,1:36:02.97,1:36:06.17,Default,,0000,0000,0000,,Ақымақ, оқ таусылды!
Dialogue: 0,1:36:06.17,1:36:09.04,Default,,0000,0000,0000,,Жарайды, бұзылды. Бұл Фионың бөксесінің кесірінен.
Dialogue: 0,1:36:09.04,1:36:11.06,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,1:36:11.06,1:36:15.26,Default,,0000,0000,0000,,Бұл ұтыс ойыны болмайды!
Dialogue: 0,1:36:15.26,1:36:20.26,Default,,0000,0000,0000,,Хахаха...! Бұл батыстық фильм емес. Осындай бірдеңе болады ма деп ойлаймын.
Dialogue: 0,1:36:22.66,1:36:24.02,Default,,0000,0000,0000,,Эй!
Dialogue: 0,1:36:24.02,1:36:30.02,Default,,0000,0000,0000,,Хахаха...! Ондай нәрсе келе ме!? Хио~Сильва~.
Dialogue: 0,1:36:33.95,1:36:36.95,Default,,0000,0000,0000,,Ахахаха...!
Dialogue: 0,1:36:37.15,1:36:39.15,Default,,0000,0000,0000,,Мына шошқа!
Dialogue: 0,1:36:42.20,1:36:44.06,Default,,0000,0000,0000,,Маған хабарласа аласыз ба? Ау, ауырады! Ахахаха...!
Dialogue: 0,1:36:44.06,1:36:47.58,Default,,0000,0000,0000,,Ей балапан! Сіз жасадыңыз!
Dialogue: 0,1:36:47.58,1:36:50.94,Default,,0000,0000,0000,,Махаббат үшін бұл не!? Тыныш, шошқа!
Dialogue: 0,1:36:50.94,1:36:54.94,Default,,0000,0000,0000,,Бұл жерде біртүрлі нәрсе бар. А, түсіп жатыр!
Dialogue: 0,1:37:02.07,1:37:04.25,Default,,0000,0000,0000,,Мен қайтып келдім!
Dialogue: 0,1:37:04.25,1:37:07.95,Default,,0000,0000,0000,,Күте тұрыңыз! Жүлде жоғалып кетсе жақсы емес.
Dialogue: 0,1:37:07.95,1:37:11.95,Default,,0000,0000,0000,,Оған көмектесу мүмкін емес, күте тұрыңыз! Темера!
Dialogue: 0,1:37:16.04,1:37:18.04,Default,,0000,0000,0000,,Сіз шошқаны артық жейсіз!
Dialogue: 0,1:37:20.24,1:37:22.24,Default,,0000,0000,0000,,Ковбой жігіт!
Dialogue: 0,1:37:28.99,1:37:31.99,Default,,0000,0000,0000,,Бар күшіңді салып кел! Сиырға қайт!
Dialogue: 0,1:37:37.08,1:37:38.09,Default,,0000,0000,0000,,Бар, жүр!
Dialogue: 0,1:37:38.09,1:37:41.29,Default,,0000,0000,0000,,Сәттілік Porco!
Dialogue: 0,1:37:41.29,1:37:45.16,Default,,0000,0000,0000,,Хехе, тұр шошқа!
Dialogue: 0,1:37:45.16,1:37:46.16,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:37:48.19,1:37:50.21,Default,,0000,0000,0000,,Бұл кір!
Dialogue: 0,1:37:50.21,1:38:10.08,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:38:10.08,1:38:14.28,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:38:14.28,1:38:17.31,Default,,0000,0000,0000,,Жоғарғы! жоғарғы! блоктау! блоктау!
Dialogue: 0,1:38:17.31,1:38:19.67,Default,,0000,0000,0000,,Жақсы, жақсы!
Dialogue: 0,1:38:19.67,1:38:23.04,Default,,0000,0000,0000,,Керемет! Бұл бәс тігу! Сіз бәс тігуге болады! Одақ көшбасшы болады!
Dialogue: 0,1:38:23.04,1:38:25.04,Default,,0000,0000,0000,,Гонг жоқ!? Гонг!
Dialogue: 0,1:38:29.27,1:38:33.14,Default,,0000,0000,0000,,Сіз жылдамдықты арттыра алмайсыз ба? Бұл мүмкін емес, қозғалтқыш жанып кетеді.
Dialogue: 0,1:38:33.14,1:38:36.14,Default,,0000,0000,0000,,дирижабль мінгеннің бәрі ақымақ екені рас!
Dialogue: 0,1:41:08.03,1:41:10.03,Default,,0000,0000,0000,,(Гонг дыбысы)
Dialogue: 0,1:41:12.90,1:41:16.90,Default,,0000,0000,0000,,Фио... Менің соққымды дәл қазір көрдіңіз...
Dialogue: 0,1:41:20.47,1:41:23.01,Default,,0000,0000,0000,,Мен оны келесі бөлімде шешемін. (гонг дыбысы)
Dialogue: 0,1:41:23.01,1:41:28.06,Default,,0000,0000,0000,,Бұл жолы ұйықтауға рұқсат етемін. Porco Мықты болыңыз! қолыңнан келгеннің бәрін жаса!
Dialogue: 0,1:41:28.06,1:41:31.06,Default,,0000,0000,0000,,Мен сені жабайы шошқаға айналдырамын!
Dialogue: 0,1:41:32.93,1:41:35.96,Default,,0000,0000,0000,,Кел! Сен бейбақ!
Dialogue: 0,1:41:35.96,1:41:38.96,Default,,0000,0000,0000,,Жынның түсі қорқынышты!
Dialogue: 0,1:41:39.66,1:41:43.04,Default,,0000,0000,0000,,Мені кездейсоқ таңда! Рақмет сізге!
Dialogue: 0,1:41:43.04,1:41:46.07,Default,,0000,0000,0000,,Не Джина, не Фио!
Dialogue: 0,1:41:46.07,1:41:49.10,Default,,0000,0000,0000,,Не?! Уф!
Dialogue: 0,1:41:49.10,1:41:52.10,Default,,0000,0000,0000,,Оны өзіңізге жасырмаңыз!
Dialogue: 0,1:41:54.15,1:41:56.15,Default,,0000,0000,0000,,Джина...!
Dialogue: 0,1:41:57.18,1:42:02.06,Default,,0000,0000,0000,,Джина Мені жайбарақат Джина деп атама!
Dialogue: 0,1:42:02.06,1:42:07.06,Default,,0000,0000,0000,,Джина қатты қорқады!
Dialogue: 0,1:42:09.97,1:42:13.97,Default,,0000,0000,0000,,Ол менің келуімді күтіп тұрды...
Dialogue: 0,1:42:15.19,1:42:17.19,Default,,0000,0000,0000,,Бақшада үнемі...
Dialogue: 0,1:42:18.89,1:42:21.89,Default,,0000,0000,0000,,Мен көптен күттім!
Dialogue: 0,1:42:26.80,1:42:28.16,Default,,0000,0000,0000,,(Гонг дыбысы)
Dialogue: 0,1:42:28.16,1:42:31.02,Default,,0000,0000,0000,,Порко~! Бұл гонг!
Dialogue: 0,1:42:31.02,1:42:35.02,Default,,0000,0000,0000,,Санау! Өйткені, қара!
Dialogue: 0,1:42:40.11,1:42:43.11,Default,,0000,0000,0000,,Мен оны көріп тұрмын! Италия әскері әлі келген жоқ.
Dialogue: 0,1:42:53.90,1:42:54.92,Default,,0000,0000,0000,,(Гонг дыбысы)
Dialogue: 0,1:42:54.92,1:42:58.92,Default,,0000,0000,0000,,Бұл лас өтірік.
Dialogue: 0,1:43:01.98,1:43:04.01,Default,,0000,0000,0000,,Түсінбедім, ақымақ...!
Dialogue: 0,1:43:04.01,1:43:07.01,Default,,0000,0000,0000,,Бұл өтірік емес! Бұл рас болса да!
Dialogue: 0,1:43:09.40,1:43:11.40,Default,,0000,0000,0000,,Fio жасамаңыз!
Dialogue: 0,1:43:12.93,1:43:14.93,Default,,0000,0000,0000,,Бұл Джинаның қайығы!
Dialogue: 0,1:43:16.14,1:43:18.14,Default,,0000,0000,0000,,Бұл апат сигналы!
Dialogue: 0,1:43:29.60,1:43:32.13,Default,,0000,0000,0000,,Бір! Екі!
Dialogue: 0,1:43:32.13,1:43:35.99,Default,,0000,0000,0000,,Кім бірінші тұрса, сол жеңеді!
Dialogue: 0,1:43:35.99,1:43:39.20,Default,,0000,0000,0000,,Барлығыңыз, өтінемін, жолдан өтіңіздер.
Dialogue: 0,1:43:39.20,1:43:43.07,Default,,0000,0000,0000,,Жеті! Джина Жоқ.
Dialogue: 0,1:43:43.07,1:43:44.07,Default,,0000,0000,0000,,Сегіз...!
Dialogue: 0,1:43:46.10,1:43:48.10,Default,,0000,0000,0000,,Марко! Марко, тыңдап тұрсың ба?
Dialogue: 0,1:43:51.15,1:43:55.15,Default,,0000,0000,0000,,Сіз басқа қызды бақытсыз еткіңіз келе ме?
Dialogue: 0,1:43:59.06,1:44:01.06,Default,,0000,0000,0000,,Тоғыз!
Dialogue: 0,1:44:03.10,1:44:05.10,Default,,0000,0000,0000,,Иә! Порко!
Dialogue: 0,1:44:07.14,1:44:10.01,Default,,0000,0000,0000,,Порко~! Porco Рахмет!
Dialogue: 0,1:44:10.01,1:44:13.01,Default,,0000,0000,0000,,Бұл өте жеңіл.
Dialogue: 0,1:44:20.94,1:44:22.13,Default,,0000,0000,0000,,Келіңіздер! Фестиваль аяқталды!
Dialogue: 0,1:44:22.13,1:44:24.98,Default,,0000,0000,0000,,Италияның әуе күштері осында келеді.
Dialogue: 0,1:44:24.98,1:44:27.18,Default,,0000,0000,0000,,Барлығыңыз тезірек қашыңыз.
Dialogue: 0,1:44:27.18,1:44:31.22,Default,,0000,0000,0000,,Оның орнына менің дүкеніме келіңіз! Мен сізге жақсы қызмет етемін.
Dialogue: 0,1:44:31.22,1:44:35.26,Default,,0000,0000,0000,,Уау! Жыртқыштар, кетіңдер!
Dialogue: 0,1:44:35.26,1:44:46.03,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:44:46.03,1:44:48.03,Default,,0000,0000,0000,,Бітті.
Dialogue: 0,1:44:49.06,1:44:55.06,Default,,0000,0000,0000,,Бастық, асығыңыз! Асығыңыз! Шулы! Кеджиме! Кеджиме!
Dialogue: 0,1:44:56.14,1:44:59.17,Default,,0000,0000,0000,,Мен шошқаларды жек көремін, бірақ мен сені жақсы көремін.
Dialogue: 0,1:44:59.17,1:45:02.70,Default,,0000,0000,0000,,Жақсы ұшатын қайық дүкені бол! Абай!
Dialogue: 0,1:45:02.70,1:45:06.23,Default,,0000,0000,0000,,Рахмет! Кейде шомылыңыз!
Dialogue: 0,1:45:06.23,1:45:09.93,Default,,0000,0000,0000,,Сізге де рахмет... Кертис мырза.
Dialogue: 0,1:45:09.93,1:45:13.14,Default,,0000,0000,0000,,Келесі жолы бәс тігудің орнына мен ресми өтінімге барамын.
Dialogue: 0,1:45:13.14,1:45:16.17,Default,,0000,0000,0000,,Жақсы! Бірақ мен шешім қабылдадым.
Dialogue: 0,1:45:16.17,1:45:20.21,Default,,0000,0000,0000,,Сіз Джинаның қайығында боласыз. Мен оны ұнатпаймын!
Dialogue: 0,1:45:20.21,1:45:22.06,Default,,0000,0000,0000,,Порконың қайығына мін!
Dialogue: 0,1:45:22.06,1:45:24.91,Default,,0000,0000,0000,,Сіз менің серіктесім деп айттыңыз!
Dialogue: 0,1:45:24.91,1:45:25.93,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:45:25.93,1:45:30.93,Default,,0000,0000,0000,,Джина Өтінемін, бұл жігітті Катаги әлеміне қайтарыңыз.
Dialogue: 0,1:45:31.15,1:45:34.15,Default,,0000,0000,0000,,Айлакер адамдар... олар үнемі солай істейді.
Dialogue: 0,1:45:36.37,1:45:39.37,Default,,0000,0000,0000,,Кешіріңіз... кетіңіз.
Dialogue: 0,1:45:44.12,1:45:46.13,Default,,0000,0000,0000,,Оны алыңыз.
Dialogue: 0,1:45:46.13,1:46:06.00,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:46:06.00,1:46:17.11,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:46:17.11,1:46:20.97,Default,,0000,0000,0000,,Италияның әуе күштері осында.
Dialogue: 0,1:46:20.97,1:46:24.85,Default,,0000,0000,0000,,Мен сізге көмектесе аламын ба? Оларды бір жаққа тартыңыз.
Dialogue: 0,1:46:24.85,1:46:27.87,Default,,0000,0000,0000,,А...!? О, анау бет! Күте тұрыңыз, эй!
Dialogue: 0,1:46:27.87,1:46:29.06,Default,,0000,0000,0000,,Маған бетіңізді көрсетіңіз!
Dialogue: 0,1:46:29.06,1:46:32.06,Default,,0000,0000,0000,,Бұл сенің қайығың! Аз ғана!
Dialogue: 0,1:46:40.17,1:46:44.71,Default,,0000,0000,0000,,<Итальяндық әуе күштерінің жөнелтілуі нәтижесіз аяқталды→
Dialogue: 0,1:46:44.71,1:46:47.08,Default,,0000,0000,0000,,Миланға қайтатын күн келсе де →
Dialogue: 0,1:46:47.08,1:46:51.95,Default,,0000,0000,0000,,Порко көрінбеді>
Dialogue: 0,1:46:51.95,1:46:53.14,Default,,0000,0000,0000,,＜Бірақ орнына→
Dialogue: 0,1:46:53.14,1:46:57.01,Default,,0000,0000,0000,,Мен Джинамен өте жақсы дос болдым>
Dialogue: 0,1:46:57.01,1:47:02.40,Default,,0000,0000,0000,,<Содан бері көптеген ірі соғыстар мен толқулар болды→
Dialogue: 0,1:47:02.40,1:47:06.40,Default,,0000,0000,0000,,Сол достық әлі де жалғасуда>
Dialogue: 0,1:47:07.95,1:47:10.98,Default,,0000,0000,0000,,<Пикколо компаниясын алғаннан кейін де жазғы демалыс→
Dialogue: 0,1:47:10.98,1:47:16.20,Default,,0000,0000,0000,,Адриано қонақүйінде уақыт өткізу - менің маңызды ережем>
Dialogue: 0,1:47:16.20,1:47:19.90,Default,,0000,0000,0000,,<Джина күннен күнге сұлуланып барады→
Dialogue: 0,1:47:19.90,1:47:22.90,Default,,0000,0000,0000,,Ескі достар да өтеді>
Dialogue: 0,1:47:23.44,1:47:27.97,Default,,0000,0000,0000,,<Иә, бірақ ол әлі президент болған жоқ→
Dialogue: 0,1:47:27.97,1:47:30.01,Default,,0000,0000,0000,,Кертис мырза да маған анда-санда хат жіберіп тұрады>
Dialogue: 0,1:47:30.01,1:47:34.01,Default,,0000,0000,0000,,<Сағындым сол Адриатикалық жаз...>
Dialogue: 0,1:47:35.23,1:47:38.26,Default,,0000,0000,0000,,<Джинаның бәс тігуіне не болды→
Dialogue: 0,1:47:38.26,1:47:41.26,Default,,0000,0000,0000,,Тек біз үшін құпия...>
Dialogue: 0,1:47:45.82,1:47:50.04,Default,,0000,0000,0000,,～ 『』
Dialogue: 0,1:47:50.04,1:47:57.11,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:47:57.11,1:48:04.18,Default,,0000,0000,0000,,～
Dialogue: 0,1:48:04.18,1:48:11.08,Default,,0000,0000,0000,,～
