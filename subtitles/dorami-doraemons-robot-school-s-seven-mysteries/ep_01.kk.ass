Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:54.37,0:00:56.37,Default,,0,0,0,,22 ғасыр
Dialogue: 0,0:00:56.37,0:00:58.39,Default,,0,0,0,,Бұл оқиғаны мен, Дорами шешті.
Dialogue: 0,0:00:58.39,0:01:03.36,Default,,0,0,0,,Бұл роботтарды дайындайтын мектепте болды, мен ертең бітірейін деп жатыр едім.
Dialogue: 0,0:01:03.36,0:01:07.35,Default,,0,0,0,,Тіпті 20 ғасырдан шыққан үлкен ағаны да қатыстыр.
Dialogue: 0,0:01:07.35,0:01:10.38,Default,,0,0,0,,Не? Аспан кенет қараңғыланды
Dialogue: 0,0:01:10.38,0:01:12.39,Default,,0,0,0,,Хо сирек
Dialogue: 0,0:01:12.39,0:01:14.39,Default,,0,0,0,,Мұндай ауа-райы...
Dialogue: 0,0:01:31.36,0:01:34.39,Default,,0,0,0,,Уау! Апыр-ай! Не болды?
Dialogue: 0,0:01:34.39,0:01:37.36,Default,,0,0,0,,Иә!?
Dialogue: 0,0:01:37.36,0:01:39.36,Default,,0,0,0,,О? Апыр-ай!
Dialogue: 0,0:01:39.36,0:01:42.37,Default,,0,0,0,,Директор: Ой... бұл не?
Dialogue: 0,0:01:42.37,0:01:44.37,Default,,0,0,0,,Жек көру? Бұл не?
Dialogue: 0,0:01:44.37,0:01:46.35,Default,,0,0,0,,Уау
Dialogue: 0,0:01:46.35,0:01:50.37,Default,,0,0,0,,Сізді сорып алады!
Dialogue: 0,0:01:50.37,0:01:52.36,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:01:52.36,0:01:54.40,Default,,0,0,0,,...
Dialogue: 0,0:01:54.40,0:01:56.38,Default,,0,0,0,,...
Dialogue: 0,0:01:56.38,0:01:59.38,Default,,0,0,0,,Бұл енді жақсы емес
Dialogue: 0,0:01:59.38,0:02:02.37,Default,,0,0,0,,Ал профессор Гожо ше?
Dialogue: 0,0:02:02.37,0:02:07.36,Default,,0,0,0,,Ах!? Менің қалтамдағының бәрі сорылады!
Dialogue: 0,0:02:07.36,0:02:09.36,Default,,0,0,0,,Енді жоқ!
Dialogue: 0,0:02:09.36,0:02:11.36,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:13.36,0:02:16.38,Default,,0,0,0,,...
Dialogue: 0,0:02:16.38,0:02:19.35,Default,,0,0,0,,Ха, аға! Директор!
Dialogue: 0,0:02:19.35,0:02:22.39,Default,,0,0,0,,А... иә?
Dialogue: 0,0:02:22.39,0:02:26.38,Default,,0,0,0,,Бүкіл мектепте бірдеңе дұрыс емес сияқты.
Dialogue: 0,0:02:26.38,0:02:31.37,Default,,0,0,0,,Әй, мынау ағамның құралы.
Dialogue: 0,0:02:31.37,0:02:33.40,Default,,0,0,0,,Ең жақсы дос телефон картасы
Dialogue: 0,0:02:33.40,0:02:37.39,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:37.39,0:02:40.36,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:40.36,0:02:42.39,Default,,0,0,0,,Иә, бұл достың телефон картасы
Dialogue: 0,0:02:42.39,0:02:45.40,Default,,0,0,0,,Мен ағаммен достыққа ант бердім.
Dialogue: 0,0:02:45.40,0:02:49.40,Default,,0,0,0,,Алтауын шақыратын құрал болды.
Dialogue: 0,0:03:08.39,0:03:12.37,Default,,0,0,0,,Ачо! Аха! Уау! Аа!?
Dialogue: 0,0:03:12.37,0:03:15.38,Default,,0,0,0,,Қытайдың 4000 жылдық соңғы кунг-фу патшасы Дора
Dialogue: 0,0:03:15.38,0:03:17.38,Default,,0,0,0,,Уау!?
Dialogue: 0,0:03:23.38,0:03:25.39,Default,,0,0,0,,Иә? Бұл сол емес.
Dialogue: 0,0:03:25.39,0:03:27.37,Default,,0,0,0,,Ах!?
Dialogue: 0,0:03:27.37,0:03:29.39,Default,,0,0,0,,Бразилияның жас супер шабуылшысы
Dialogue: 0,0:03:29.39,0:03:31.36,Default,,0,0,0,,Дорариньо
Dialogue: 0,0:03:31.36,0:03:33.36,Default,,0,0,0,,Қараңдар!
Dialogue: 0,0:03:38.38,0:03:42.37,Default,,0,0,0,,Уау! Су қорқынышты Су қорқынышты!
Dialogue: 0,0:03:42.37,0:03:47.37,Default,,0,0,0,,Ежелгі Араб шөлі Аңызға айналған сиқыршы Драма III
Dialogue: 0,0:03:51.41,0:03:53.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:53.38,0:03:57.38,Default,,0,0,0,,Мұзды жер Орыс кезбе жұлдыз Драников
Dialogue: 0,0:04:01.37,0:04:05.39,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:04:05.39,0:04:07.36,Default,,0,0,0,,Уау!?
Dialogue: 0,0:04:07.36,0:04:12.40,Default,,0,0,0,,Испания қызыл құмарлықтың корридашысы Эль-Матадора
Dialogue: 0,0:04:12.40,0:04:15.40,Default,,0,0,0,,Ах... Уау!
Dialogue: 0,0:04:23.39,0:04:25.36,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:04:25.36,0:04:28.40,Default,,0,0,0,,Ах... ой!
Dialogue: 0,0:04:28.40,0:04:30.40,Default,,0,0,0,,Саған не болды, Ан-сан?
Dialogue: 0,0:04:30.40,0:04:32.39,Default,,0,0,0,,Ittetetete…
Dialogue: 0,0:04:32.39,0:04:36.37,Default,,0,0,0,,Аа, менің жақын досымның телефон картасы
Dialogue: 0,0:04:36.37,0:04:38.39,Default,,0,0,0,,Барма
Dialogue: 0,0:04:38.39,0:04:40.39,Default,,0,0,0,,Дораемон көмек сұрап тұр
Dialogue: 0,0:04:44.38,0:04:47.38,Default,,0,0,0,,және американдық арман мырза
Dialogue: 0,0:04:47.38,0:04:50.39,Default,,0,0,0,,Батыс Дора Баланың қарулы адамы
Dialogue: 0,0:04:50.39,0:04:52.37,Default,,0,0,0,,Барайық Эд, Жапония.
Dialogue: 0,0:04:52.37,0:04:56.39,Default,,0,0,0,,Ә!? Сен онсыз да жаман жылқышысың.
Dialogue: 0,0:04:56.39,0:04:59.40,Default,,0,0,0,,Ұрыс! Бір ату!
Dialogue: 0,0:04:59.40,0:05:02.40,Default,,0,0,0,,Хихен, биік жерлер қорқынышты!
Dialogue: 0,0:05:11.39,0:05:13.39,Default,,0,0,0,,Менің ақ боз атты ханзадасым
Dialogue: 0,0:05:13.39,0:05:16.36,Default,,0,0,0,,Мектепті қорғаңыз.
Dialogue: 0,0:05:16.36,0:05:20.38,Default,,0,0,0,,Менің ағам мен директорға көмектесіңізші.
Dialogue: 0,0:05:20.38,0:05:23.39,Default,,0,0,0,,Ияху келді!
Dialogue: 0,0:05:23.39,0:05:26.39,Default,,0,0,0,,Ақ боз ат мінген ханзадам
Dialogue: 0,0:05:26.39,0:05:29.39,Default,,0,0,0,,Бухуру Эрусунмахен
Dialogue: 0,0:05:29.39,0:05:32.40,Default,,0,0,0,,Ей, ақ боз атты ханзада Кид-сама келді!
Dialogue: 0,0:05:32.40,0:05:34.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:34.40,0:05:36.42,Default,,0,0,0,,Мені Дораемон шақырды деп ойладым.
Dialogue: 0,0:05:36.42,0:05:38.39,Default,,0,0,0,,Бұл ақылсыз болса да
Dialogue: 0,0:05:38.39,0:05:41.39,Default,,0,0,0,,Бұл сіз күткен баланың әпкесі ме?
Dialogue: 0,0:05:41.39,0:05:43.37,Default,,0,0,0,,Брат?
Dialogue: 0,0:05:43.37,0:05:45.41,Default,,0,0,0,,-де? Дораэмонға не болды?
Dialogue: 0,0:05:45.41,0:05:48.38,Default,,0,0,0,,Хэчамукуре Хэчамукуре!?
Dialogue: 0,0:05:48.38,0:05:52.38,Default,,0,0,0,,Бірақ бұл мектеп мен болған кезден бері өзгерген жоқ.
Dialogue: 0,0:05:52.38,0:05:54.42,Default,,0,0,0,,А-а, не?
Dialogue: 0,0:05:54.42,0:05:56.39,Default,,0,0,0,,Мен Дорамимін
Dialogue: 0,0:05:56.39,0:05:58.37,Default,,0,0,0,,Иә? Ах
Dialogue: 0,0:05:58.37,0:06:00.39,Default,,0,0,0,,Дорами брат және флоп емес пе?
Dialogue: 0,0:06:00.39,0:06:02.39,Default,,0,0,0,,Ех еша...
Dialogue: 0,0:06:02.39,0:06:06.41,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:06.41,0:06:09.42,Default,,0,0,0,,Пу? Хе хе ххун
Dialogue: 0,0:06:09.42,0:06:11.40,Default,,0,0,0,,Ең жақсы дос телефон картасы
Dialogue: 0,0:06:11.40,0:06:13.37,Default,,0,0,0,,Ах!?
Dialogue: 0,0:06:13.37,0:06:16.41,Default,,0,0,0,,Ең жақсы дос телефон картасы
Dialogue: 0,0:06:16.41,0:06:18.39,Default,,0,0,0,,Я...
Dialogue: 0,0:06:18.39,0:06:21.41,Default,,0,0,0,,Мына жігіт мені осында шақырды.
Dialogue: 0,0:06:21.41,0:06:23.40,Default,,0,0,0,,Хмф!
Dialogue: 0,0:06:23.40,0:06:25.38,Default,,0,0,0,,Менің ағамның бір қызығы бар.
Dialogue: 0,0:06:25.38,0:06:27.42,Default,,0,0,0,,Мен іштей сордым
Dialogue: 0,0:06:27.42,0:06:30.39,Default,,0,0,0,,Қызық? бітіру салтанатымды асыға күтемін
Dialogue: 0,0:06:30.39,0:06:32.39,Default,,0,0,0,,Сіз жол бойы келгенмен...
Dialogue: 0,0:06:32.39,0:06:35.39,Default,,0,0,0,,Директор мен басқа студенттер жоғалып кетті.
Dialogue: 0,0:06:35.39,0:06:37.41,Default,,0,0,0,,үшін... Көмек келгенше күтемін деп ойладым.
Dialogue: 0,0:06:37.41,0:06:41.40,Default,,0,0,0,,4D қалтасындағы құралдар да осында жасырылған.
Dialogue: 0,0:06:41.40,0:06:43.38,Default,,0,0,0,,үшін ішке кірді.
Dialogue: 0,0:06:43.38,0:06:45.39,Default,,0,0,0,,Шулы!
Dialogue: 0,0:06:45.39,0:06:49.37,Default,,0,0,0,,Не? Күз, құлау, құлау...
Dialogue: 0,0:06:49.37,0:06:51.43,Default,,0,0,0,,Аа, мен көмектесе алмаймын.
Dialogue: 0,0:06:51.43,0:06:54.40,Default,,0,0,0,,Йотто Йойшо
Dialogue: 0,0:06:54.40,0:06:56.40,Default,,0,0,0,,Дегенмен, олар мектепті басқаруы керек.
Dialogue: 0,0:06:56.40,0:06:58.42,Default,,0,0,0,,13-әкеге не болды?
Dialogue: 0,0:06:58.42,0:07:00.38,Default,,0,0,0,,№13 әке?
Dialogue: 0,0:07:00.38,0:07:03.42,Default,,0,0,0,,Ах, мен осында болған кезде
Dialogue: 0,0:07:03.42,0:07:05.41,Default,,0,0,0,,Мектепті үнемі қорғаған.
Dialogue: 0,0:07:05.41,0:07:08.39,Default,,0,0,0,,Мектептен кететін уақыт келді.
Dialogue: 0,0:07:08.39,0:07:10.38,Default,,0,0,0,,Оқып жатқан студенттер
Dialogue: 0,0:07:10.38,0:07:12.40,Default,,0,0,0,,Сізге ойнау керек.
Dialogue: 0,0:07:12.40,0:07:14.40,Default,,0,0,0,,Қазір мектепті кім қорғайды?
Dialogue: 0,0:07:14.40,0:07:17.40,Default,,0,0,0,,Бұл №14 мумия деп аталатын компьютер.
Dialogue: 0,0:07:17.40,0:07:19.40,Default,,0,0,0,,Мектептен шығатын уақыт келді.
Dialogue: 0,0:07:19.40,0:07:22.37,Default,,0,0,0,,Жақсы балалар өздерін жинап алулары керек.
Dialogue: 0,0:07:22.37,0:07:25.38,Default,,0,0,0,,Үй тапсырмасын ұмытпа, үйге әкел.
Dialogue: 0,0:07:25.38,0:07:27.43,Default,,0,0,0,,Айналма жолдар жоқ
Dialogue: 0,0:07:27.43,0:07:30.40,Default,,0,0,0,,Робот сарайына тура оралыңыз.
Dialogue: 0,0:07:30.40,0:07:34.39,Default,,0,0,0,,үшінна! Өтінемін ертең де мектепке бар.
Dialogue: 0,0:07:34.39,0:07:37.39,Default,,0,0,0,,Мм Мумия №14
Dialogue: 0,0:07:37.39,0:07:41.41,Default,,0,0,0,,Бұл мектепте біртүрлі нәрсе болып жатыр...
Dialogue: 0,0:07:41.41,0:07:44.40,Default,,0,0,0,,Ой, ой!
Dialogue: 0,0:07:44.40,0:07:46.41,Default,,0,0,0,,шықты!
Dialogue: 0,0:07:46.41,0:07:48.42,Default,,0,0,0,,Бала, қаш.
Dialogue: 0,0:07:48.42,0:07:51.39,Default,,0,0,0,,Ақымақ болма, мен Дораэмонға көмектесуге келдім.
Dialogue: 0,0:07:51.39,0:07:54.39,Default,,0,0,0,,Менің пневматикалық қаруым сол ағашты жойды.
Dialogue: 0,0:07:54.39,0:07:57.42,Default,,0,0,0,,Бум бум бум
Dialogue: 0,0:07:57.42,0:08:00.39,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:08:00.39,0:08:02.40,Default,,0,0,0,,Йотто!
Dialogue: 0,0:08:02.40,0:08:04.38,Default,,0,0,0,,(Ино) Шынында да көп қой? Және олар адамдар ғой?
Dialogue: 0,0:08:04.38,0:08:06.42,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:08:06.42,0:08:08.40,Default,,0,0,0,,Міне, таптырмас нәрсе! Керемет!
Dialogue: 0,0:08:08.40,0:08:10.39,Default,,0,0,0,,Міне, келді!
Dialogue: 0,0:08:10.39,0:08:12.42,Default,,0,0,0,,Сіз соншалықты алысқа барғыңыз келе ме?
Dialogue: 0,0:08:12.42,0:08:14.41,Default,,0,0,0,,Сол жаққа бұрылыңыз
Dialogue: 0,0:08:14.41,0:08:17.41,Default,,0,0,0,,Бала, бірдеңе істе!
Dialogue: 0,0:08:17.41,0:08:20.40,Default,,0,0,0,,Мен бұл туралы ештеңе істей алмаймын. Мен Эдге барамын!
Dialogue: 0,0:08:20.40,0:08:22.42,Default,,0,0,0,,Жылқыларды пайдалануда өте нашар екенсің.
Dialogue: 0,0:08:22.42,0:08:24.42,Default,,0,0,0,,Шағымдама, Ан-сан.
Dialogue: 0,0:08:24.42,0:08:27.42,Default,,0,0,0,,Жарайсыңдар! Екі атумен күресіңіз!
Dialogue: 0,0:08:27.42,0:08:30.42,Default,,0,0,0,,Мен биіктіктен қорқамын!
Dialogue: 0,0:08:30.42,0:08:33.43,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:33.43,0:08:35.41,Default,,0,0,0,,Неліктен мұнда қабырға бар?
Dialogue: 0,0:08:35.41,0:08:37.38,Default,,0,0,0,,Иә
Dialogue: 0,0:08:37.38,0:08:39.43,Default,,0,0,0,,Хона сайнара
Dialogue: 0,0:08:39.43,0:08:42.42,Default,,0,0,0,,Эдо Кид
Dialogue: 0,0:08:42.42,0:08:46.39,Default,,0,0,0,,Дорами мені ұстап ал! Бум бум бум бум
Dialogue: 0,0:08:46.39,0:08:48.39,Default,,0,0,0,,Сәтті қашу!
Dialogue: 0,0:08:53.41,0:08:56.40,Default,,0,0,0,,Мен осы жолмен бара жатырмын, артымнан жүр.
Dialogue: 0,0:08:56.40,0:08:58.40,Default,,0,0,0,,Эден мектебіне қабылдау нәтижелері
Dialogue: 0,0:09:02.41,0:09:04.39,Default,,0,0,0,,Haa Chic шоуы
Dialogue: 0,0:09:04.39,0:09:07.41,Default,,0,0,0,,Эд сорып алды. Не болды?
Dialogue: 0,0:09:07.41,0:09:09.43,Default,,0,0,0,,Ах! ше?
Dialogue: 0,0:09:09.43,0:09:11.43,Default,,0,0,0,,Анау, анау, анау?
Dialogue: 0,0:09:23.41,0:09:25.41,Default,,0,0,0,,Бұл шеберхана, солай ма?
Dialogue: 0,0:09:25.41,0:09:28.38,Default,,0,0,0,,Дисплейде осындай нәрсе болды ма?
Dialogue: 0,0:09:28.38,0:09:32.40,Default,,0,0,0,,Қатты! Бұлардың барлығы мектеп оқушылары! Не!?
Dialogue: 0,0:09:32.40,0:09:35.41,Default,,0,0,0,,Бұл қорқынышты. Кім осындай нәрсені жасайды? Ха!
Dialogue: 0,0:09:35.41,0:09:37.39,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:37.39,0:09:41.41,Default,,0,0,0,,Енді ше? Анау, анау, а
Dialogue: 0,0:09:41.41,0:09:43.41,Default,,0,0,0,,Ах...! Тарақан!
Dialogue: 0,0:09:43.41,0:09:45.40,Default,,0,0,0,,Тарақан?
Dialogue: 0,0:09:45.40,0:09:47.42,Default,,0,0,0,,Джоро Джоро?
Dialogue: 0,0:09:47.42,0:09:50.40,Default,,0,0,0,,Оны сізге жасайық. Оны сізге жасайық.
Dialogue: 0,0:09:50.40,0:09:53.41,Default,,0,0,0,,Мен оны сізге жасаймын.
Dialogue: 0,0:09:53.41,0:09:56.41,Default,,0,0,0,,Түсіндім, студенттерді осы жағдайға әкелген сен екенсің.
Dialogue: 0,0:09:56.41,0:09:58.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:58.43,0:10:00.40,Default,,0,0,0,,Менің зеңбірегім!
Dialogue: 0,0:10:00.40,0:10:03.43,Default,,0,0,0,,Оны сізге жасайық. Оны сізге жасайық.
Dialogue: 0,0:10:03.43,0:10:05.42,Default,,0,0,0,,Не істеп жатырсың! Ах!?
Dialogue: 0,0:10:05.42,0:10:08.41,Default,,0,0,0,,Не?
Dialogue: 0,0:10:08.41,0:10:11.41,Default,,0,0,0,,Керемет жұмыс, сен кімсің!?
Dialogue: 0,0:10:16.40,0:10:18.43,Default,,0,0,0,,Сен темір аспапсың!
Dialogue: 0,0:10:18.43,0:10:20.42,Default,,0,0,0,,Темір құрал?
Dialogue: 0,0:10:20.42,0:10:22.39,Default,,0,0,0,,Ах! Ахх
Dialogue: 0,0:10:22.39,0:10:25.42,Default,,0,0,0,,Менің аяғым қозғалмайды.
Dialogue: 0,0:10:25.42,0:10:29.41,Default,,0,0,0,,Оны сізге жасайық. Оны сізге жасайық.
Dialogue: 0,0:10:29.41,0:10:32.41,Default,,0,0,0,,Ааа
Dialogue: 0,0:10:32.41,0:10:36.40,Default,,0,0,0,,Мен сол сұмдар сені қорқақша бірдеңе жасап өлтіргеніне сенімдімін.
Dialogue: 0,0:10:36.40,0:10:39.40,Default,,0,0,0,,Дора патша! Король Дора-сан?
Dialogue: 0,0:10:39.40,0:10:42.41,Default,,0,0,0,,Біз осы мектепте оқыған кезіміз еді.
Dialogue: 0,0:10:42.41,0:10:45.44,Default,,0,0,0,,Шеберханада көмекші болған темір аспапшы
Dialogue: 0,0:10:45.44,0:10:48.41,Default,,0,0,0,,Мен оның қазір қолданылмағанына сенімдімін.
Dialogue: 0,0:10:48.41,0:10:52.40,Default,,0,0,0,,Оны сіз үшін жасайық. Оны сізге жасайық.
Dialogue: 0,0:10:52.40,0:10:55.42,Default,,0,0,0,,Біртүрлі нәрсе болып жатқан сияқты.
Dialogue: 0,0:10:55.42,0:10:58.39,Default,,0,0,0,,Ой! Хохохохохо
Dialogue: 0,0:10:58.39,0:11:02.41,Default,,0,0,0,,Ура!
Dialogue: 0,0:11:02.41,0:11:04.43,Default,,0,0,0,,А, мен аяғымды қозғалта аламын. Апыр-ай!
Dialogue: 0,0:11:04.43,0:11:06.41,Default,,0,0,0,,Дора патшаға рахмет
Dialogue: 0,0:11:06.41,0:11:08.42,Default,,0,0,0,,Вахот патшасы Дора!
Dialogue: 0,0:11:08.42,0:11:13.42,Default,,0,0,0,,Вачочу Очу Очу
Dialogue: 0,0:11:13.42,0:11:16.39,Default,,0,0,0,,Дора патша! Жарайды бум!
Dialogue: 0,0:11:16.39,0:11:20.41,Default,,0,0,0,,Не? Бум! Бум!
Dialogue: 0,0:11:20.41,0:11:23.41,Default,,0,0,0,,Қарғыс атсын, бум! Бум бум!
Dialogue: 0,0:11:23.41,0:11:26.41,Default,,0,0,0,,Бала... Бала! Уау
Dialogue: 0,0:11:28.44,0:11:30.44,Default,,0,0,0,,Бала!?
Dialogue: 0,0:11:30.44,0:11:32.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:32.42,0:11:36.41,Default,,0,0,0,,Оны сізге жасайық. Оны сізге жасайық.
Dialogue: 0,0:11:36.41,0:11:39.45,Default,,0,0,0,,Хехехе
Dialogue: 0,0:11:39.45,0:11:41.42,Default,,0,0,0,,Уау, ау!
Dialogue: 0,0:11:41.42,0:11:44.42,Default,,0,0,0,,Тесік жасайық Тесік жасайық
Dialogue: 0,0:11:44.42,0:11:46.44,Default,,0,0,0,,тесік Ah
Dialogue: 0,0:11:46.44,0:11:50.42,Default,,0,0,0,,Мен тесік жасаймын.
Dialogue: 0,0:11:50.42,0:11:53.43,Default,,0,0,0,,А-а-а
Dialogue: 0,0:11:53.43,0:11:57.41,Default,,0,0,0,,Ах... Агу
Dialogue: 0,0:11:57.41,0:11:59.42,Default,,0,0,0,,Ах! есіме түсті
Dialogue: 0,0:11:59.42,0:12:02.42,Default,,0,0,0,,Темір розеткасыз қозғала алмады.
Dialogue: 0,0:12:02.42,0:12:04.40,Default,,0,0,0,,Вааа ча ча ча ча ча ча!
Dialogue: 0,0:12:04.40,0:12:07.41,Default,,0,0,0,,Қосымша
Dialogue: 0,0:12:07.41,0:12:09.41,Default,,0,0,0,,Тесік Тесік бұрғылаңыз
Dialogue: 0,0:12:09.41,0:12:13.41,Default,,0,0,0,,Ооо
Dialogue: 0,0:12:15.42,0:12:17.42,Default,,0,0,0,,(Iris) Ол жұмысы барын айтып, бүгін таңертең кетті.
Dialogue: 0,0:12:17.42,0:12:19.44,Default,,0,0,0,,Иә, балалар
Dialogue: 0,0:12:19.44,0:12:24.44,Default,,0,0,0,,Аяя…
Dialogue: 0,0:12:26.43,0:12:30.45,Default,,0,0,0,,Ааа
Dialogue: 0,0:12:30.45,0:12:32.42,Default,,0,0,0,,Даа
Dialogue: 0,0:12:32.42,0:12:34.40,Default,,0,0,0,,Балшықты тарту
Dialogue: 0,0:12:34.40,0:12:38.42,Default,,0,0,0,,О, менің ең жақын досым
Dialogue: 0,0:12:38.42,0:12:42.44,Default,,0,0,0,,Драма III! Ах...
Dialogue: 0,0:12:42.44,0:12:44.43,Default,,0,0,0,,Кел, кішкентай қыз.
Dialogue: 0,0:12:44.43,0:12:46.40,Default,,0,0,0,,О, досым! Осы жеңісті тойлайық
Dialogue: 0,0:12:46.40,0:12:49.43,Default,,0,0,0,,Бала Бүкіл мектеп
Dialogue: 0,0:12:49.43,0:12:53.42,Default,,0,0,0,,Тосенбо қақпағымен жабылған сияқты.
Dialogue: 0,0:12:53.42,0:12:55.41,Default,,0,0,0,,Осы қарқынмен мен тіпті мектепке түсуім де мүмкін.
Dialogue: 0,0:12:55.41,0:12:57.44,Default,,0,0,0,,Мен тіпті шыға алмаймын.
Dialogue: 0,0:12:57.44,0:12:59.43,Default,,0,0,0,,Эд, күте тұрыңыз.
Dialogue: 0,0:12:59.43,0:13:01.43,Default,,0,0,0,,Сіздің достарыңыз осында деп үміттенемін.
Dialogue: 0,0:13:01.43,0:13:04.40,Default,,0,0,0,,Король Дора-сан жақсы ма?
Dialogue: 0,0:13:04.40,0:13:06.45,Default,,0,0,0,,Әйтеуір, мен мектепке қараймын.
Dialogue: 0,0:13:06.45,0:13:08.42,Default,,0,0,0,,Менің зеңбірегім
Dialogue: 0,0:13:08.42,0:13:10.40,Default,,0,0,0,,Қайдан білуге болады
Dialogue: 0,0:13:10.40,0:13:12.44,Default,,0,0,0,,Үлкен аға
Dialogue: 0,0:13:12.44,0:13:15.41,Default,,0,0,0,,Балалар, мені тыңдап тұрсыңдар ма?
Dialogue: 0,0:13:15.41,0:13:17.43,Default,,0,0,0,,Гуу кааа
Dialogue: 0,0:13:17.43,0:13:20.43,Default,,0,0,0,,Гуу гаааа
Dialogue: 0,0:13:20.43,0:13:23.43,Default,,0,0,0,,Не болды? бәрі ұйықтап жатыр
Dialogue: 0,0:13:23.43,0:13:26.42,Default,,0,0,0,,Иә, бұл музыка бөлмесі.
Dialogue: 0,0:13:26.42,0:13:28.42,Default,,0,0,0,,Кірейік.
Dialogue: 0,0:13:31.41,0:13:35.43,Default,,0,0,0,,Вах ара
Dialogue: 0,0:13:35.43,0:13:39.43,Default,,0,0,0,,Бұл ненің шулы дыбысы?
Dialogue: 0,0:13:50.43,0:13:52.45,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:13:52.45,0:13:54.41,Default,,0,0,0,,Менің әріптестерім мектепте оқып жүргенде
Dialogue: 0,0:13:54.41,0:13:57.45,Default,,0,0,0,,Құбырлы орган роботы қолданылды
Dialogue: 0,0:13:57.45,0:14:00.42,Default,,0,0,0,,Ұйқымды келтіретін дыбыс.
Dialogue: 0,0:14:00.42,0:14:03.46,Default,,0,0,0,,Ым, жоқ, мен құлағымды жауып жатырмын.
Dialogue: 0,0:14:03.46,0:14:06.44,Default,,0,0,0,,Бұл үндемей, ұйқымды келтіреді.
Dialogue: 0,0:14:06.44,0:14:08.43,Default,,0,0,0,,Ахх
Dialogue: 0,0:14:08.43,0:14:11.43,Default,,0,0,0,,Хм, шамамен бір адам ұйықтап жатыр.
Dialogue: 0,0:14:11.43,0:14:13.43,Default,,0,0,0,,Бақытты жігіт
Dialogue: 0,0:14:13.43,0:14:15.42,Default,,0,0,0,,Юоши
Dialogue: 0,0:14:15.42,0:14:18.42,Default,,0,0,0,,Маған сиқырлы музыкамды тыңдауға рұқсат етіңіз.
Dialogue: 0,0:14:28.42,0:14:31.42,Default,,0,0,0,,73 адам із-түссіз жоғалып кетті
Dialogue: 0,0:14:34.42,0:14:37.42,Default,,0,0,0,,Ааа
Dialogue: 0,0:14:40.44,0:14:44.43,Default,,0,0,0,,Ооо, сіз жеңдіңіз бе?
Dialogue: 0,0:14:44.43,0:14:47.43,Default,,0,0,0,,Уау! Менің флейтам!
Dialogue: 0,0:14:49.44,0:14:51.42,Default,,0,0,0,,О
Dialogue: 0,0:14:51.42,0:14:54.42,Default,,0,0,0,,А... Мен жүрдім!
Dialogue: 0,0:14:57.46,0:14:59.43,Default,,0,0,0,,Егер сіз мектепті одан әрі шатастырғыңыз келсе.
Dialogue: 0,0:14:59.43,0:15:02.43,Default,,0,0,0,,Менің жолдасым ашулы.
Dialogue: 0,0:15:06.45,0:15:09.46,Default,,0,0,0,,Ал оған он алты жасында, Римде…
Dialogue: 0,0:15:09.46,0:15:13.46,Default,,0,0,0,,Сіз бұл кілемді қалай жүргізесіз?
Dialogue: 0,0:15:15.43,0:15:17.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:21.42,0:15:25.42,Default,,0,0,0,,Бәрі бітті
Dialogue: 0,0:15:25.42,0:15:27.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:27.42,0:15:30.46,Default,,0,0,0,,Әй, төбеде тесік бар!?
Dialogue: 0,0:15:30.46,0:15:32.43,Default,,0,0,0,,Уау
Dialogue: 0,0:15:32.43,0:15:36.43,Default,,0,0,0,,Мен суды онша жақсы көрмеймін.
Dialogue: 0,0:15:36.43,0:15:38.44,Default,,0,0,0,,Ик!
Dialogue: 0,0:15:38.44,0:15:41.44,Default,,0,0,0,,Мен мұны қалай тоқтатарымды білмеймін, балақай, оян, оян!
Dialogue: 0,0:15:41.44,0:15:45.43,Default,,0,0,0,,Няун, мен енді тамақ іше алмаймын.
Dialogue: 0,0:15:45.43,0:15:47.43,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:50.43,0:15:52.45,Default,,0,0,0,,Уф
Dialogue: 0,0:15:52.45,0:15:57.42,Default,,0,0,0,,Уф-а-а-а
Dialogue: 0,0:15:57.42,0:15:59.44,Default,,0,0,0,,Қызық, таңғы ас уақыты келді ме?
Dialogue: 0,0:15:59.44,0:16:01.43,Default,,0,0,0,,Ах, сонда ол ма еді?
Dialogue: 0,0:16:01.43,0:16:03.43,Default,,0,0,0,,Мен енді тамақ жей алмаймын.
Dialogue: 0,0:16:03.43,0:16:05.45,Default,,0,0,0,,Таңғы ас ішетін уақыт келді ме?
Dialogue: 0,0:16:05.45,0:16:08.43,Default,,0,0,0,,Иә? Жартылай ұйықтайтын уақыт емес.
Dialogue: 0,0:16:08.43,0:16:10.42,Default,,0,0,0,,Уау Дорами!?
Dialogue: 0,0:16:10.42,0:16:13.45,Default,,0,0,0,,Бұл гимназия ма?
Dialogue: 0,0:16:13.45,0:16:16.42,Default,,0,0,0,,Дорами иә!?
Dialogue: 0,0:16:16.42,0:16:19.44,Default,,0,0,0,,Бұл не? Бұл арманның жалғасы ма?
Dialogue: 0,0:16:19.44,0:16:21.46,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:16:21.46,0:16:23.45,Default,,0,0,0,,Біз ұстанбаймыз!
Dialogue: 0,0:16:23.45,0:16:26.43,Default,,0,0,0,,Ора ора! Олла! Олла! Олла!
Dialogue: 0,0:16:26.43,0:16:29.44,Default,,0,0,0,,Ора, ора, ора, ора! Ол ала ола ара!
Dialogue: 0,0:16:29.44,0:16:32.44,Default,,0,0,0,,Ора, ора, ора, ора, ора, ора!
Dialogue: 0,0:16:32.44,0:16:36.46,Default,,0,0,0,,Соқ! Хехе
Dialogue: 0,0:16:36.46,0:16:40.45,Default,,0,0,0,,Иә? Ол не болды? Онда болды ма?
Dialogue: 0,0:16:40.45,0:16:42.43,Default,,0,0,0,,Аздап қысқартыңыз.
Dialogue: 0,0:16:42.43,0:16:44.43,Default,,0,0,0,,Иә? Уау
Dialogue: 0,0:16:44.43,0:16:47.44,Default,,0,0,0,,Тоби! Бако! Тоби! Бако!
Dialogue: 0,0:16:47.44,0:16:51.46,Default,,0,0,0,,Тобибако Тобибако Тобибако!
Dialogue: 0,0:16:51.46,0:16:55.43,Default,,0,0,0,,Секіргіш робот? Және бұл ескірген қоқыс.
Dialogue: 0,0:16:55.43,0:16:57.43,Default,,0,0,0,,Эй, бұл не?
Dialogue: 0,0:16:57.43,0:17:00.43,Default,,0,0,0,,үшін, Кид-сама, тіпті дыбыс шығармаңдар...
Dialogue: 0,0:17:00.43,0:17:02.44,Default,,0,0,0,,Гуу
Dialogue: 0,0:17:02.44,0:17:05.44,Default,,0,0,0,,Менің қарным ашты, енді қозғала алмаймын.
Dialogue: 0,0:17:05.44,0:17:07.46,Default,,0,0,0,,Бұл өтірік, солай ма?
Dialogue: 0,0:17:07.46,0:17:10.46,Default,,0,0,0,,Тоби! Баку! Тоби! Баку!
Dialogue: 0,0:17:10.46,0:17:12.46,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:17:16.43,0:17:19.45,Default,,0,0,0,,Аспан Жерді шақырады
Dialogue: 0,0:17:19.45,0:17:23.44,Default,,0,0,0,,Сиырды союға мені біреу шақырып жатыр.
Dialogue: 0,0:17:23.44,0:17:26.44,Default,,0,0,0,,Енді Эль Матадора келді,
Dialogue: 0,0:17:26.44,0:17:29.45,Default,,0,0,0,,Енді уайымдама, Сенорита.
Dialogue: 0,0:17:29.45,0:17:31.43,Default,,0,0,0,,Сенорита?
Dialogue: 0,0:17:31.43,0:17:35.45,Default,,0,0,0,,Барлық пайдасыз заттармен бір жерге тығыл!
Dialogue: 0,0:17:35.45,0:17:40.42,Default,,0,0,0,,Онякахекохеко Шынында да пайдасыз
Dialogue: 0,0:17:40.42,0:17:43.46,Default,,0,0,0,,Жүр, қоқыс.
Dialogue: 0,0:17:43.46,0:17:45.46,Default,,0,0,0,,Сылдырлату! Нокаут!
Dialogue: 0,0:17:45.46,0:17:47.45,Default,,0,0,0,,Тоби Бако Хирари Хирари
Dialogue: 0,0:17:47.45,0:17:51.45,Default,,0,0,0,,Күрсін, бірдеңе жей бер!
Dialogue: 0,0:17:53.45,0:17:55.45,Default,,0,0,0,,Не? Не?
Dialogue: 0,0:17:57.44,0:17:59.44,Default,,0,0,0,,Ол біріктірілді ме?
Dialogue: 0,0:17:59.44,0:18:02.45,Default,,0,0,0,,Сіз қоқыс үшін ақылды істер жасайсыз, солай емес пе?
Dialogue: 0,0:18:02.45,0:18:04.43,Default,,0,0,0,,Ол басқа суреттерде де бар емес пе?
Dialogue: 0,0:18:04.43,0:18:06.47,Default,,0,0,0,,Сізді бірдеңе басқарып жатыр ма?
Dialogue: 0,0:18:06.47,0:18:09.47,Default,,0,0,0,,Тоби Бако Уау, бұл кір емес!
Dialogue: 0,0:18:09.47,0:18:12.44,Default,,0,0,0,,Джубако
Dialogue: 0,0:18:12.44,0:18:14.46,Default,,0,0,0,,Бако?
Dialogue: 0,0:18:14.46,0:18:16.43,Default,,0,0,0,,Бұл өкінішті болды.
Dialogue: 0,0:18:16.43,0:18:19.46,Default,,0,0,0,,Мен Дораэмондардың нөмірі біріншімін.
Dialogue: 0,0:18:19.46,0:18:21.46,Default,,0,0,0,,Ол күшті!
Dialogue: 0,0:18:21.46,0:18:23.45,Default,,0,0,0,,Автобус! Ке! дейін!
Dialogue: 0,0:18:23.45,0:18:25.44,Default,,0,0,0,,Бір! Кімге! Мистер мисс!
Dialogue: 0,0:18:25.44,0:18:28.46,Default,,0,0,0,,Ба! а! Бая! Le!
Dialogue: 0,0:18:28.46,0:18:30.47,Default,,0,0,0,,Келдің бе?
Dialogue: 0,0:18:30.47,0:18:34.46,Default,,0,0,0,,А-а, сәл шаршаған шығарсың?
Dialogue: 0,0:18:34.46,0:18:37.46,Default,,0,0,0,,Сондай-ақ үлпілдек төсек бар.
Dialogue: 0,0:18:37.46,0:18:39.47,Default,,0,0,0,,Ой siesta siesta
Dialogue: 0,0:18:39.47,0:18:41.45,Default,,0,0,0,,Ұйықтау уақыты келді.
Dialogue: 0,0:18:41.45,0:18:43.45,Default,,0,0,0,,Гууу
Dialogue: 0,0:18:54.46,0:18:57.45,Default,,0,0,0,,Орындалды, балақай.
Dialogue: 0,0:18:57.45,0:19:00.47,Default,,0,0,0,,Иә!?
Dialogue: 0,0:19:00.47,0:19:02.46,Default,,0,0,0,,Уууух! Ах, бұл кактус екен!
Dialogue: 0,0:19:02.46,0:19:04.46,Default,,0,0,0,,Йойшо
Dialogue: 0,0:19:04.46,0:19:06.46,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:19:09.45,0:19:11.45,Default,,0,0,0,,Мектептегі түскі ас бөлмесінде тамақ әзірлеу механизмі
Dialogue: 0,0:19:11.45,0:19:13.43,Default,,0,0,0,,Мүлдем пайдасыз
Dialogue: 0,0:19:13.43,0:19:16.44,Default,,0,0,0,,Бір дораяки жасау қиын жұмыс болды.
Dialogue: 0,0:19:16.44,0:19:18.44,Default,,0,0,0,,Жоқ, жақсы.
Dialogue: 0,0:19:18.44,0:19:20.46,Default,,0,0,0,,Дорами Сізде ас әзірлеуге қабілет бар.
Dialogue: 0,0:19:20.46,0:19:23.46,Default,,0,0,0,,Ей, тойған соң
Dialogue: 0,0:19:23.46,0:19:25.46,Default,,0,0,0,,Бәріңе, мен сендерге көмектесейін. Күте тұрыңыз.
Dialogue: 0,0:19:25.46,0:19:27.45,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:19:27.45,0:19:30.47,Default,,0,0,0,,Бұл адам маған басқаларға қарағанда тезірек келді.
Dialogue: 0,0:19:30.47,0:19:32.45,Default,,0,0,0,,Досқа көмектесу
Dialogue: 0,0:19:32.45,0:19:34.47,Default,,0,0,0,,Күріш жемей
Dialogue: 0,0:19:34.47,0:19:36.47,Default,,0,0,0,,Қайта толтырыңыз! Аа!?
Dialogue: 0,0:19:36.47,0:19:40.44,Default,,0,0,0,,Жоқ, менде басқа ингредиенттер жоқ. Е!?
Dialogue: 0,0:19:40.44,0:19:43.46,Default,,0,0,0,,Мектептің түскі ас бөлмесінде неге ингредиенттер жоқ?
Dialogue: 0,0:19:43.46,0:19:45.48,Default,,0,0,0,,Эй, неге, неге? Мен білмеймін.
Dialogue: 0,0:19:45.48,0:19:47.45,Default,,0,0,0,,Сіз дұрыс іздедіңіз бе?
Dialogue: 0,0:19:47.45,0:19:49.44,Default,,0,0,0,,Мен оны іздедім.
Dialogue: 0,0:19:49.44,0:19:51.47,Default,,0,0,0,,Мұнда да? Онда да
Dialogue: 0,0:19:51.47,0:19:53.46,Default,,0,0,0,,Бұл туралы не деуге болады? да!
Dialogue: 0,0:19:53.46,0:19:55.44,Default,,0,0,0,,Мына тоңазытқыштың ішінде не бар?
Dialogue: 0,0:19:55.44,0:19:58.46,Default,,0,0,0,,Ол ескі және енді қолданылмайды.
Dialogue: 0,0:19:58.46,0:20:00.48,Default,,0,0,0,,Қайсысы?
Dialogue: 0,0:20:00.48,0:20:02.47,Default,,0,0,0,,Ооо! Эй!
Dialogue: 0,0:20:02.47,0:20:05.45,Default,,0,0,0,,Мен бұл сұмдықты аша алмаймын.
Dialogue: 0,0:20:05.45,0:20:07.44,Default,,0,0,0,,Понкоцу дедіңіз бе?
Dialogue: 0,0:20:07.44,0:20:09.46,Default,,0,0,0,,Не? Уау
Dialogue: 0,0:20:09.46,0:20:13.44,Default,,0,0,0,,Понкоцу дедіңіз бе? Эй!
Dialogue: 0,0:20:13.44,0:20:15.45,Default,,0,0,0,,Бала!
Dialogue: 0,0:20:15.45,0:20:17.46,Default,,0,0,0,,Бұл түрлендіретін робот болды ма?
Dialogue: 0,0:20:17.46,0:20:19.43,Default,,0,0,0,,Тыңдау
Dialogue: 0,0:20:19.43,0:20:21.48,Default,,0,0,0,,Жоқ, қаш!
Dialogue: 0,0:20:21.48,0:20:23.45,Default,,0,0,0,,Бала
Dialogue: 0,0:20:23.45,0:20:25.44,Default,,0,0,0,,Жарайды
Dialogue: 0,0:20:25.44,0:20:27.47,Default,,0,0,0,,Мен сені міндетті түрде қорғаймын!
Dialogue: 0,0:20:27.47,0:20:30.44,Default,,0,0,0,,Бала
Dialogue: 0,0:20:30.44,0:20:32.46,Default,,0,0,0,,А... тұйық ба?
Dialogue: 0,0:20:32.46,0:20:35.47,Default,,0,0,0,,А, міне, осы.
Dialogue: 0,0:20:35.47,0:20:38.47,Default,,0,0,0,,Түскі ас бөлмесіндегі роботтар мұзда қатып қалған.
Dialogue: 0,0:20:38.47,0:20:40.44,Default,,0,0,0,,Әлде сенбейсің бе?
Dialogue: 0,0:20:40.44,0:20:42.46,Default,,0,0,0,,Хиатс
Dialogue: 0,0:20:42.46,0:20:44.46,Default,,0,0,0,,Бала
Dialogue: 0,0:20:44.46,0:20:46.48,Default,,0,0,0,,Мен енді мұны істей алмаймын
Dialogue: 0,0:20:46.48,0:20:49.45,Default,,0,0,0,,Ақымақ, берілме
Dialogue: 0,0:20:49.45,0:20:52.45,Default,,0,0,0,,А? Драников!
Dialogue: 0,0:20:52.45,0:20:54.45,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:20:54.45,0:20:57.49,Default,,0,0,0,,Жақында болмайды деп ойлағанымда, осындай жерде тоңып бара жатқанымды көрдім.
Dialogue: 0,0:20:57.49,0:21:00.46,Default,,0,0,0,,А, сен маған сене алмайсың.
Dialogue: 0,0:21:00.46,0:21:02.46,Default,,0,0,0,,Иә? Иә?
Dialogue: 0,0:21:02.46,0:21:05.46,Default,,0,0,0,,Түсіндім, мен бұл қулықты таптым.
Dialogue: 0,0:21:05.46,0:21:07.45,Default,,0,0,0,,Жақсы кадрлар
Dialogue: 0,0:21:07.45,0:21:09.48,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:21:09.48,0:21:13.48,Default,,0,0,0,,Иә!? Сіз енді алға қарай алмайсыз, солай ма?
Dialogue: 0,0:21:17.46,0:21:19.44,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:19.44,0:21:21.46,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:21:21.46,0:21:25.45,Default,,0,0,0,,Уу-у-хей
Dialogue: 0,0:21:25.45,0:21:27.48,Default,,0,0,0,,Драниковтікі
Dialogue: 0,0:21:27.48,0:21:29.47,Default,,0,0,0,,Дөңгелек затқа қарасаң, аңға айналасың.
Dialogue: 0,0:21:29.47,0:21:31.44,Default,,0,0,0,,Дөңгелек заттар...
Dialogue: 0,0:21:31.44,0:21:33.46,Default,,0,0,0,,Әй, бұл дұрыс.
Dialogue: 0,0:21:33.46,0:21:35.46,Default,,0,0,0,,Бұл чили соусы.
Dialogue: 0,0:21:35.46,0:21:38.46,Default,,0,0,0,,Драников Уау?
Dialogue: 0,0:21:38.46,0:21:42.48,Default,,0,0,0,,Ууу
Dialogue: 0,0:21:42.48,0:21:45.45,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:45.45,0:21:47.47,Default,,0,0,0,,Әлде сенбейсің бе?
Dialogue: 0,0:21:47.47,0:21:49.47,Default,,0,0,0,,Ааа
Dialogue: 0,0:21:49.47,0:21:52.44,Default,,0,0,0,,Жарайсың Драников
Dialogue: 0,0:21:52.44,0:21:54.49,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:54.49,0:21:56.46,Default,,0,0,0,,Жоқ, бұл! Апыр-ай!
Dialogue: 0,0:21:56.46,0:22:00.48,Default,,0,0,0,,Уау уау уау!
Dialogue: 0,0:22:00.48,0:22:02.47,Default,,0,0,0,,Күн ыстық!
Dialogue: 0,0:22:02.47,0:22:05.47,Default,,0,0,0,,Иә
Dialogue: 0,0:22:10.48,0:22:13.45,Default,,0,0,0,,Дорами Жақсысың ба?
Dialogue: 0,0:22:13.45,0:22:15.48,Default,,0,0,0,,Бұл дұрыс емес...
Dialogue: 0,0:22:15.48,0:22:17.47,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:22:17.47,0:22:19.49,Default,,0,0,0,,Бұл ғылым кабинеті емес пе?
Dialogue: 0,0:22:19.49,0:22:21.45,Default,,0,0,0,,Га
Dialogue: 0,0:22:21.45,0:22:23.47,Default,,0,0,0,,Бала! Мұнда да студенттер бар
Dialogue: 0,0:22:23.47,0:22:25.48,Default,,0,0,0,,Не! Не?
Dialogue: 0,0:22:25.48,0:22:27.46,Default,,0,0,0,,Жоқ, мен оны іздедім.
Dialogue: 0,0:22:27.46,0:22:29.46,Default,,0,0,0,,Дорариньо
Dialogue: 0,0:22:29.46,0:22:31.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:31.45,0:22:35.47,Default,,0,0,0,,Минидораны мұндай жерде ұстау өте қорқынышты.
Dialogue: 0,0:22:35.47,0:22:37.49,Default,,0,0,0,,Mini Dora футбол командасы?
Dialogue: 0,0:22:37.49,0:22:40.46,Default,,0,0,0,,Дорариньо? иә?
Dialogue: 0,0:22:40.46,0:22:42.46,Default,,0,0,0,,Мен мектепке не үшін келдім?
Dialogue: 0,0:22:42.46,0:22:44.48,Default,,0,0,0,,Таларн
Dialogue: 0,0:22:44.48,0:22:46.48,Default,,0,0,0,,Ах! есіме түсті
Dialogue: 0,0:22:46.48,0:22:48.46,Default,,0,0,0,,Мен Дораэмонды құтқаруға келдім.
Dialogue: 0,0:22:48.46,0:22:51.48,Default,,0,0,0,,Әй, сен әлі ұмытшақсың.
Dialogue: 0,0:22:51.48,0:22:53.47,Default,,0,0,0,,Ал, дәл қазір осы жерде бір-біріңді сүйіңдер.
Dialogue: 0,0:22:53.47,0:22:55.46,Default,,0,0,0,,Ах!? иә?
Dialogue: 0,0:22:55.46,0:22:58.46,Default,,0,0,0,,Осындай жерде модель робот болды ма?
Dialogue: 0,0:22:58.46,0:23:00.46,Default,,0,0,0,,Honehone
Dialogue: 0,0:23:00.46,0:23:02.48,Default,,0,0,0,,Аа, есімде.
Dialogue: 0,0:23:02.48,0:23:05.47,Default,,0,0,0,,Ескі болғандықтан тастап кеткен.
Dialogue: 0,0:23:05.47,0:23:08.47,Default,,0,0,0,,Иә? Сіз бізге шабуыл жасамақшысыз ба?
Dialogue: 0,0:23:08.47,0:23:12.49,Default,,0,0,0,,Honehone
Dialogue: 0,0:23:12.49,0:23:14.47,Default,,0,0,0,,Дааххонехонехоне
Dialogue: 0,0:23:14.47,0:23:17.48,Default,,0,0,0,,Сен мені неге қуып жүрсің?
Dialogue: 0,0:23:17.48,0:23:19.48,Default,,0,0,0,,Оны біреу басқарып отырған болуы керек, солай ма?
Dialogue: 0,0:23:19.48,0:23:22.48,Default,,0,0,0,,Оны кім басқарады?
Dialogue: 0,0:23:22.48,0:23:24.47,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:23:24.47,0:23:26.47,Default,,0,0,0,,...
Dialogue: 0,0:23:26.47,0:23:29.47,Default,,0,0,0,,Дорариньо Ашуланба, бірдеңе істе.
Dialogue: 0,0:23:29.47,0:23:32.47,Default,,0,0,0,,Иә, мен бірдеңе істеймін.
Dialogue: 0,0:23:39.50,0:23:44.47,Default,,0,0,0,,Тоттенпаның Нянпарарині
Dialogue: 0,0:23:44.47,0:23:46.47,Default,,0,0,0,,Егер біз сол жүк көлігінің кетуіне жол берсек, апат болар еді
Dialogue: 0,0:23:48.49,0:23:51.49,Default,,0,0,0,,Жарайсыңдар!
Dialogue: 0,0:23:51.49,0:23:53.48,Default,,0,0,0,,Мақсат
Dialogue: 0,0:23:53.48,0:23:55.48,Default,,0,0,0,,Уф!
Dialogue: 0,0:23:55.48,0:23:58.45,Default,,0,0,0,,Бұл керемет, Доралиньо.
Dialogue: 0,0:23:58.45,0:24:00.50,Default,,0,0,0,,Ия
Dialogue: 0,0:24:00.50,0:24:02.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:02.47,0:24:04.46,Default,,0,0,0,,Ау аяя дорариньо
Dialogue: 0,0:24:04.46,0:24:06.49,Default,,0,0,0,,Әй, бұл аккорд сияқты.
Dialogue: 0,0:24:06.49,0:24:08.48,Default,,0,0,0,,Қарғыс атсын, мен сені қуамын.
Dialogue: 0,0:24:08.48,0:24:10.46,Default,,0,0,0,,Бала, сен осы жерге дейін көтерілесің бе?
Dialogue: 0,0:24:10.46,0:24:12.50,Default,,0,0,0,,Менің бармауым керек сияқты.
Dialogue: 0,0:24:12.50,0:24:14.48,Default,,0,0,0,,Иә, бірақ
Dialogue: 0,0:24:14.48,0:24:16.48,Default,,0,0,0,,Мен биіктіктен қорқамын
Dialogue: 0,0:24:21.47,0:24:23.48,Default,,0,0,0,,Дорариньо га
Dialogue: 0,0:24:23.48,0:24:25.46,Default,,0,0,0,,Бұл аудиовизуалды бөлме ме?
Dialogue: 0,0:24:25.46,0:24:27.50,Default,,0,0,0,,О, бірақ не?
Dialogue: 0,0:24:27.50,0:24:30.47,Default,,0,0,0,,№14 ананың айналасындағы сақина
Dialogue: 0,0:24:30.47,0:24:32.49,Default,,0,0,0,,Иә, мен сенімдімін
Dialogue: 0,0:24:32.49,0:24:34.45,Default,,0,0,0,,Машинаның қозғалысын тоқтату үшін қоңырауды тоқтату
Dialogue: 0,0:24:34.45,0:24:36.51,Default,,0,0,0,,Неліктен мұндай нәрсе?
Dialogue: 0,0:24:36.51,0:24:38.51,Default,,0,0,0,,Ах!?
Dialogue: 0,0:24:40.46,0:24:42.50,Default,,0,0,0,,шықты. О, күте тұрыңыз.
Dialogue: 0,0:24:42.50,0:24:44.48,Default,,0,0,0,,Жау әзірге
Dialogue: 0,0:24:44.48,0:24:47.48,Default,,0,0,0,,үшін қазір пайдаланылмайды
Dialogue: 0,0:24:47.48,0:24:49.45,Default,,0,0,0,,Олар ескі роботтар еді.
Dialogue: 0,0:24:49.45,0:24:51.50,Default,,0,0,0,,Мәселе мынада
Dialogue: 0,0:24:51.50,0:24:54.47,Default,,0,0,0,,Мен оның шынайы болмысын түсінемін!
Dialogue: 0,0:24:54.47,0:24:56.48,Default,,0,0,0,,Дорами кішкене құлаққап итататата
Dialogue: 0,0:24:56.48,0:24:58.49,Default,,0,0,0,,Басқа нәрсемен айналысқыңыз келе ме?
Dialogue: 0,0:24:58.49,0:25:00.50,Default,,0,0,0,,Гонё гонё гонё иә?
Dialogue: 0,0:25:00.50,0:25:03.50,Default,,0,0,0,,Міне, асығыңыз!
Dialogue: 0,0:25:14.48,0:25:17.48,Default,,0,0,0,,Қазір! Дорами!
Dialogue: 0,0:25:17.48,0:25:20.48,Default,,0,0,0,,Иә
Dialogue: 0,0:25:20.48,0:25:24.47,Default,,0,0,0,,Ооо!
Dialogue: 0,0:25:24.47,0:25:27.51,Default,,0,0,0,,Ия, Дорами
Dialogue: 0,0:25:27.51,0:25:31.46,Default,,0,0,0,,Бұл шынымен де бұрыннан қолданылған шаңсорғыш болатын.
Dialogue: 0,0:25:31.46,0:25:35.48,Default,,0,0,0,,Аа, мына жігіт сөндіргіш өшірілмесе қозғала алмайды.
Dialogue: 0,0:25:35.48,0:25:40.49,Default,,0,0,0,,Жарайды, сол адамдарды іштей сорып алайық.
Dialogue: 0,0:25:40.49,0:25:42.51,Default,,0,0,0,,Э? Естімеймін.
Dialogue: 0,0:25:42.51,0:25:44.49,Default,,0,0,0,,Ааа
Dialogue: 0,0:25:44.49,0:25:47.48,Default,,0,0,0,,Биіктен қорқады
Dialogue: 0,0:25:47.48,0:25:51.50,Default,,0,0,0,,Бұл шаршаған роботтар демалатын асхана.
Dialogue: 0,0:25:51.50,0:25:54.47,Default,,0,0,0,,Не? Бұл жылтыр компьютер
Dialogue: 0,0:25:54.47,0:25:56.49,Default,,0,0,0,,Біраз уақыт өтті.
Dialogue: 0,0:25:56.49,0:25:59.49,Default,,0,0,0,,Бала биіктіктен қорқады
Dialogue: 0,0:25:59.49,0:26:01.46,Default,,0,0,0,,№13 әке?
Dialogue: 0,0:26:01.46,0:26:05.48,Default,,0,0,0,,Сіз ескі роботтарды басқарған болуыңыз мүмкін бе?
Dialogue: 0,0:26:05.48,0:26:08.48,Default,,0,0,0,,Ескі болғандықтан оны тастау керек дегенді білдірмейді.
Dialogue: 0,0:26:08.48,0:26:10.47,Default,,0,0,0,,Дұрыс, Хиди.
Dialogue: 0,0:26:10.47,0:26:14.49,Default,,0,0,0,,Жоқ, ол жаңартылып, жаңа болуы керек еді.
Dialogue: 0,0:26:14.49,0:26:16.49,Default,,0,0,0,,Сонда да сегізге жеттіңіз бе?
Dialogue: 0,0:26:16.49,0:26:18.47,Default,,0,0,0,,Иә, дұрыс, Хиди.
Dialogue: 0,0:26:18.47,0:26:22.46,Default,,0,0,0,,Балалар, роботтың сезімін енді сендер пайдаланбайсыңдар.
Dialogue: 0,0:26:22.46,0:26:24.51,Default,,0,0,0,,Сіз білуге ​​мүмкіндік жоқ.
Dialogue: 0,0:26:24.51,0:26:27.50,Default,,0,0,0,,Ей, бәрі бірдей роботтар ғой, дос емес пе?
Dialogue: 0,0:26:27.50,0:26:30.50,Default,,0,0,0,,Серіктес? Сосын сол дос
Dialogue: 0,0:26:30.50,0:26:33.51,Default,,0,0,0,,Мен саған оның қаншалықты сенімсіз екенін көрсетемін.
Dialogue: 0,0:26:33.51,0:26:35.51,Default,,0,0,0,,Не!?
Dialogue: 0,0:26:37.49,0:26:41.48,Default,,0,0,0,,үшін? Үлкен аға, жарайсың.
Dialogue: 0,0:26:41.48,0:26:43.47,Default,,0,0,0,,Ммм
Dialogue: 0,0:26:43.47,0:26:47.49,Default,,0,0,0,,Әй, ей, балалар, биік жерде ақымақ болуды доғарыңдар.
Dialogue: 0,0:26:47.49,0:26:49.47,Default,,0,0,0,,Фууняа Фууняа
Dialogue: 0,0:26:49.47,0:26:54.48,Default,,0,0,0,,үшін әкеге мойынсұнғыш антеннамен бағынады.
Dialogue: 0,0:26:54.48,0:26:56.50,Default,,0,0,0,,Бала сіз айтқандай жасайды.
Dialogue: 0,0:26:56.50,0:26:59.48,Default,,0,0,0,,Тоқта! Оян!
Dialogue: 0,0:26:59.48,0:27:03.49,Default,,0,0,0,,Жақсы, келесі Дорамизо.
Dialogue: 0,0:27:03.49,0:27:05.49,Default,,0,0,0,,Киддо Фуньяа
Dialogue: 0,0:27:05.49,0:27:10.49,Default,,0,0,0,,А, балам, сен өтірік айтып тұрған шығарсың.
Dialogue: 0,0:27:10.49,0:27:13.46,Default,,0,0,0,,Осы уақытқа дейін бірге жұмыс істеп келеміз.
Dialogue: 0,0:27:13.46,0:27:16.47,Default,,0,0,0,,Сен мені ұмыттың, балам.
Dialogue: 0,0:27:16.47,0:27:18.52,Default,,0,0,0,,Фуньяа
Dialogue: 0,0:27:18.52,0:27:20.49,Default,,0,0,0,,Тоқта
Dialogue: 0,0:27:20.49,0:27:24.51,Default,,0,0,0,,Фу няаах
Dialogue: 0,0:27:24.51,0:27:26.49,Default,,0,0,0,,Бала?
Dialogue: 0,0:27:26.49,0:27:30.51,Default,,0,0,0,,Мен саған айттым, мен сені қандай жағдайда да қорғаймын.
Dialogue: 0,0:27:30.51,0:27:32.50,Default,,0,0,0,,Бала! Мен сен айтқандай істемеймін.
Dialogue: 0,0:27:32.50,0:27:34.47,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:27:34.47,0:27:36.52,Default,,0,0,0,,Бұл қалпақ арнайы жасалмаған.
Dialogue: 0,0:27:36.52,0:27:40.47,Default,,0,0,0,,Валлуи, ол электр тогын өткізбейді.
Dialogue: 0,0:27:40.47,0:27:43.48,Default,,0,0,0,,Теми және басқалары аянышты.
Dialogue: 0,0:27:43.48,0:27:46.48,Default,,0,0,0,,Мен антеннаның осындай түрімен айналыстым
Dialogue: 0,0:27:46.48,0:27:49.50,Default,,0,0,0,,Дорэмонның достығы әлсіз бе?
Dialogue: 0,0:27:49.50,0:27:51.52,Default,,0,0,0,,Достық дегеніміз не?
Dialogue: 0,0:27:51.52,0:27:56.52,Default,,0,0,0,,Дораемонның достығы туралы аңызды ұмытып қалдым деп айтуға рұқсат етпеңіз.
Dialogue: 0,0:27:58.47,0:28:03.51,Default,,0,0,0,,Сіздің өміріңізге қауіп төндіретін фантомдық ежелгі ғибадатханадағы тамаша шытырман оқиға
Dialogue: 0,0:28:03.51,0:28:07.50,Default,,0,0,0,,Оны тек мәңгілік достыққа ант еткендер ғана пайдалана алады.
Dialogue: 0,0:28:07.50,0:28:09.52,Default,,0,0,0,,Аңызға айналған құпия құрал
Dialogue: 0,0:28:09.52,0:28:14.49,Default,,0,0,0,,Ең жақын досымның телефон картасын алған күн туралы
Dialogue: 0,0:28:14.49,0:28:16.51,Default,,0,0,0,,Есте сақта!
Dialogue: 0,0:28:16.51,0:28:20.50,Default,,0,0,0,,О, эй!
Dialogue: 0,0:28:20.50,0:28:22.50,Default,,0,0,0,,Доремондар...
Dialogue: 0,0:28:32.49,0:28:35.49,Default,,0,0,0,,Соған қарамастан, бұл түтін неге осынша көп?
Dialogue: 0,0:28:35.49,0:28:37.48,Default,,0,0,0,,Күштерді біріктіру
Dialogue: 0,0:28:37.48,0:28:40.50,Default,,0,0,0,,Сәлем
Dialogue: 0,0:28:40.50,0:28:42.52,Default,,0,0,0,,Йоша Жарайды
Dialogue: 0,0:28:42.52,0:28:44.50,Default,,0,0,0,,Бір
Dialogue: 0,0:28:44.50,0:28:47.49,Default,,0,0,0,,Біз Доремондармыз
Dialogue: 0,0:28:47.49,0:28:49.48,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:28:49.48,0:28:52.51,Default,,0,0,0,,Әкем менің үйімде
Dialogue: 0,0:28:52.51,0:28:54.48,Default,,0,0,0,,Мен нашар электр тогын айдаймын.
Dialogue: 0,0:28:54.48,0:28:56.50,Default,,0,0,0,,Хехе
Dialogue: 0,0:28:56.50,0:28:58.50,Default,,0,0,0,,Доккан
Dialogue: 0,0:29:09.51,0:29:12.50,Default,,0,0,0,,Мен сергіп қалдым.
Dialogue: 0,0:29:12.50,0:29:15.48,Default,,0,0,0,,Нашар электр қуаты өшіп қалды.
Dialogue: 0,0:29:15.48,0:29:18.49,Default,,0,0,0,,Жоқ, мен биіктен қорқатынмын.
Dialogue: 0,0:29:18.49,0:29:22.48,Default,,0,0,0,,Еңбегіңізге рахмет Бала, бұл жаман болды.
Dialogue: 0,0:29:22.48,0:29:27.50,Default,,0,0,0,,Біз Доремондар
Dialogue: 0,0:29:27.50,0:29:29.50,Default,,0,0,0,,Әй?
Dialogue: 0,0:29:29.50,0:29:31.52,Default,,0,0,0,,Баршаңыз да сапарыңызды жалғастырғанда абай болыңыздар
Dialogue: 0,0:29:31.52,0:29:33.49,Default,,0,0,0,,Біраз кеш болды, солай емес пе?
Dialogue: 0,0:29:33.49,0:29:36.49,Default,,0,0,0,,Әжеміздің бір ескі танысы шығар. Ах, дұрыс.
Dialogue: 0,0:29:37.47,0:29:40.48,Default,,0,0,0,,Іс осылай шешілді.
Dialogue: 0,0:29:40.48,0:29:43.51,Default,,0,0,0,,Мектепті жынды еткен сол найзағай
Dialogue: 0,0:29:43.51,0:29:49.52,Default,,0,0,0,,Бұл ауа райын бақылау спутнигінің дұрыс жұмыс істемеуінен кездейсоқ пайда болған сияқты.
Dialogue: 0,0:29:49.52,0:29:52.51,Default,,0,0,0,,13-әке 14-анамен ынтымақтасады
Dialogue: 0,0:29:52.51,0:29:56.51,Default,,0,0,0,,Мектепті қорғауға уәде берді.
Dialogue: 0,0:29:56.51,0:30:01.51,Default,,0,0,0,,үшін бос, тіпті ескі роботтар да сергітеді
Dialogue: 0,0:30:04.52,0:30:09.52,Default,,0,0,0,,Енді бітіру салтанаты.
Dialogue: 0,0:30:09.52,0:30:19.52,Default,,0,0,0,,Мен естіген нәзік әуен
Dialogue: 0,0:30:19.52,0:30:34.51,Default,,0,0,0,,Ауырсынатын көз жасын әкелу
Dialogue: 0,0:30:34.51,0:30:45.49,Default,,0,0,0,,Халлилуя, мен сені ешқашан ұмытпаймын
Dialogue: 0,0:30:45.49,0:30:57.50,Default,,0,0,0,,Құшағыңда тағы ұйықтағым келеді
Dialogue: 0,0:30:57.50,0:31:05.51,Default,,0,0,0,,Мен сені ұмытпаймын
Dialogue: 0,0:31:05.51,0:31:15.51,Default,,0,0,0,,Вау аллелуя Вау аллелуя
Dialogue: 0,0:31:17.01,0:31:23.01,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
