Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.00,0:00:06.00,Default,,0,0,0,,♪～
Dialogue: 0,0:01:22.08,0:01:27.08,Default,,0,0,0,,～♪
Dialogue: 0,0:01:37.59,0:01:39.89,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:01:39.97,0:01:42.81,Default,,0,0,0,,Бүгін түнде Motor Sands үлкен шоуы!
Dialogue: 0,0:01:42.89,0:01:45.85,Default,,0,0,0,,Стадионға келіңіз.
Dialogue: 0,0:01:47.60,0:01:50.36,Default,,0,0,0,,Ой, мадақтау тобының мүшелері.
Dialogue: 0,0:01:50.86,0:01:53.61,Default,,0,0,0,,Ең үлкен нәрсе не?
Dialogue: 0,0:01:53.69,0:01:55.32,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:01:56.24,0:01:58.28,Default,,0,0,0,,Иә? Сол бала...
Dialogue: 0,0:02:03.16,0:02:05.00,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:02:09.88,0:02:12.88,Default,,0,0,0,,Сіздің қолдауыңыз спортшылардың күші болады!
Dialogue: 0,0:02:12.96,0:02:14.88,Default,,0,0,0,,Биыл, биыл!
Dialogue: 0,0:02:14.96,0:02:19.72,Default,,0,0,0,,Климакс сериясындағы алғашқы көріністі бірге орындайық!
Dialogue: 0,0:02:25.43,0:02:26.52,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:27.98,0:02:28.98,Default,,0,0,0,,Ум...
Dialogue: 0,0:02:29.23,0:02:30.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:31.40,0:02:34.73,Default,,0,0,0,,Мен де қобалжып барамын.
Dialogue: 0,0:02:34.82,0:02:35.86,Default,,0,0,0,,Не?
Dialogue: 0,0:02:35.94,0:02:38.03,Default,,0,0,0,,Сізге Motor Sands ұнайды ма?
Dialogue: 0,0:02:38.53,0:02:39.99,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:46.12,0:02:48.12,Default,,0,0,0,,Мұны да бәрі біледі деп ойлаймын⸺
Dialogue: 0,0:02:48.37,0:02:52.71,Default,,0,0,0,,Біздің Motor Suns үшін бүгінгі Фукуока Стикске қарсы ойын⸺
Dialogue: 0,0:02:52.79,0:02:55.55,Default,,0,0,0,,Бұл ең үлкен оқиға болады.
Dialogue: 0,0:02:55.84,0:02:57.88,Default,,0,0,0,,О, үлкен мәселе
Dialogue: 0,0:02:58.38,0:03:00.84,Default,,0,0,0,,Қазіргі уақытта біз 3-орынға тең келеміз
Dialogue: 0,0:03:01.51,0:03:03.10,Default,,0,0,0,,Бірақ бүгін Styx⸺ қарсы
Dialogue: 0,0:03:03.18,0:03:06.06,Default,,0,0,0,,Жеңіске жетсек, жалғыз 3-орын боламыз⸺
Dialogue: 0,0:03:06.14,0:03:09.35,Default,,0,0,0,,Бірінші CS жазбасы шешілді!
Dialogue: 0,0:03:09.94,0:03:13.56,Default,,0,0,0,,Бүгін түн Мотор құмдарының тарихы өзгеретін түн болады.
Dialogue: 0,0:03:13.65,0:03:14.65,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:03:14.94,0:03:17.86,Default,,0,0,0,,Сыра мен күлімсіреу арқылы оны жандандырайық!
Dialogue: 0,0:03:17.94,0:03:21.74,Default,,0,0,0,,Сондай-ақ біз өндіруші бойынша сатылымда бірінші орынға шығуды мақсат етеміз!
Dialogue: 0,0:03:21.82,0:03:23.12,Default,,0,0,0,,Иә!
Dialogue: 0,0:03:24.66,0:03:27.45,Default,,0,0,0,,Сыра сатушы болып жұмыс істегеніме 4 ай болды
Dialogue: 0,0:03:28.29,0:03:33.63,Default,,0,0,0,,Бүгін бүкіл стадион аздап қобалжыды...
Dialogue: 0,0:03:35.71,0:03:38.63,Default,,0,0,0,,Парақшаларды таратқан жақсы жұмыс.
Dialogue: 0,0:03:38.84,0:03:40.93,Default,,0,0,0,,Бүгін де көңіл-күйімізді көтерейік.
Dialogue: 0,0:03:41.01,0:03:43.01,Default,,0,0,0,,Иә? Ал сол бала ше?
Dialogue: 0,0:03:43.09,0:03:46.76,Default,,0,0,0,,Ахахха Қосылғысы келетіндер... Не?
Dialogue: 0,0:03:46.85,0:03:49.14,Default,,0,0,0,,Сізді ұятқа қалдыратын ештеңе айтпаңыз
Dialogue: 0,0:03:49.81,0:03:55.19,Default,,0,0,0,,А... у... Мен де ойынды осы жерден көрсем болады ма?
Dialogue: 0,0:03:55.77,0:03:59.15,Default,,0,0,0,,Бұл матчты екінші рет көруім.
Dialogue: 0,0:03:59.78,0:04:01.57,Default,,0,0,0,,Әрине, қош келдіңіз.
Dialogue: 0,0:04:01.65,0:04:04.53,Default,,0,0,0,,Бірақ бұл күтпеген күнде келді.
Dialogue: 0,0:04:04.62,0:04:09.16,Default,,0,0,0,,Қалыпты ойынға көңіліңіз толмауы мүмкін.
Dialogue: 0,0:04:09.41,0:04:11.41,Default,,0,0,0,,Бірақ неге кенеттен?
Dialogue: 0,0:04:11.50,0:04:14.50,Default,,0,0,0,,Бұл аспап емес пе? Сіз клубтық іс-шаралардан үйге барасыз ба?
Dialogue: 0,0:04:14.58,0:04:15.71,Default,,0,0,0,,Ах
Dialogue: 0,0:04:17.84,0:04:21.13,Default,,0,0,0,,-та біз сайыс мүшелерін жариялаймыз.
Dialogue: 0,0:04:21.22,0:04:22.84,Default,,0,0,0,,Керней...
Dialogue: 0,0:04:22.93,0:04:24.22,Default,,0,0,0,,Сузуки
Dialogue: 0,0:04:24.30,0:04:25.39,Default,,0,0,0,,Ояма (Ояма) Жарайды.
Dialogue: 0,0:04:25.47,0:04:27.93,Default,,0,0,0,,Исағай 3 адамнан артық
Dialogue: 0,0:04:29.68,0:04:35.85,Default,,0,0,0,,үшін парақшаларды таратқанда өте көңілді болып көрінді, сондықтан...
Dialogue: 0,0:04:36.11,0:04:38.15,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:04:38.23,0:04:41.40,Default,,0,0,0,,Бұл сіздің мұнда не үшін келгеніңізді түсіндірмейді.
Dialogue: 0,0:04:43.45,0:04:44.82,Default,,0,0,0,,Не?!
Dialogue: 0,0:04:44.91,0:04:47.78,Default,,0,0,0,,Балалар, парақшалар таратып көңілді жүрген сияқтысыңдар.
Dialogue: 0,0:04:47.99,0:04:51.25,Default,,0,0,0,,Бетіңізге көрінді ме? (Қолдау көрсеткен топ мүшесі) Хахаха, кешіріңіз.
Dialogue: 0,0:04:51.45,0:04:54.96,Default,,0,0,0,,Жарайды, себебі жақсы, рахаттанайық.
Dialogue: 0,0:04:55.17,0:04:58.63,Default,,0,0,0,,Ах... Рахмет.
Dialogue: 0,0:04:58.92,0:05:02.59,Default,,0,0,0,,Жарайды, аздан кейін жаттығу жасаймыз, дайындал.
Dialogue: 0,0:05:02.67,0:05:04.26,Default,,0,0,0,,Иә
Dialogue: 0,0:05:07.26,0:05:10.60,Default,,0,0,0,,Бүгін мұнда келгеніңіз дұрыс шығар.
Dialogue: 0,0:05:10.68,0:05:11.68,Default,,0,0,0,,Ах
Dialogue: 0,0:05:12.60,0:05:16.02,Default,,0,0,0,,Егер сіз дәл қазір бірдеңе бойынша шатассаңыз⸺
Dialogue: 0,0:05:16.10,0:05:18.86,Default,,0,0,0,,Мен олардың оны тазартатынына сенімдімін.
Dialogue: 0,0:05:19.06,0:05:21.90,Default,,0,0,0,,Ол... ра?
Dialogue: 0,0:05:22.19,0:05:23.65,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:05:23.65,0:05:27.99,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:05:23.65,0:05:27.99,Default,,0,0,0,,Жоғарыдағылар бүгінгі негізгі құрам.
Dialogue: 0,0:05:31.49,0:05:34.33,Default,,0,0,0,,Кодзиро маған үйде қалуымды айтты, бірақ...
Dialogue: 0,0:05:35.66,0:05:38.75,Default,,0,0,0,,Мен саған әкенің не жақсы екенін көрсетуім керек.
Dialogue: 0,0:05:42.17,0:05:44.80,Default,,0,0,0,,Мицуидің жеке басын ескеру⸺
Dialogue: 0,0:05:44.88,0:05:49.09,Default,,0,0,0,,Бәлкім, мен бүгін ұтпасам, ол ұсыныс жасамайтын шығар.
Dialogue: 0,0:05:49.76,0:05:51.72,Default,,0,0,0,,Жеңіске жетуіңізді өтінемін~ Жеңіске жетуіңізді өтінемін~!
Dialogue: 0,0:05:51.81,0:05:56.23,Default,,0,0,0,,Барлық алаң иелеріне, күшті қолдау!
Dialogue: 0,0:05:59.35,0:06:01.02,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе
Dialogue: 0,0:06:04.23,0:06:05.65,Default,,0,0,0,,Фу…
Dialogue: 0,0:06:06.32,0:06:09.62,Default,,0,0,0,,Жеңісті жариялауға рұқсат етіңіздер.
Dialogue: 0,0:06:11.95,0:06:13.87,Default,,0,0,0,,Қуырылған тауық еті сізді күтеді!
Dialogue: 0,0:06:14.12,0:06:16.71,Default,,0,0,0,,Рахмет... Иә? Бұл...
Dialogue: 0,0:06:16.91,0:06:20.17,Default,,0,0,0,,Иә, бүгінгі таяқшалар арнайы шығарылым.
Dialogue: 0,0:06:23.50,0:06:27.55,Default,,0,0,0,,Келесі адам №18, тыңдау өтетін жерге келіңіз.
Dialogue: 0,0:06:28.30,0:06:29.38,Default,,0,0,0,,Иә
Dialogue: 0,0:06:30.09,0:06:31.10,Default,,0,0,0,,Ах
Dialogue: 0,0:06:32.35,0:06:35.10,Default,,0,0,0,,Бұл да Теннозан болуы керек...
Dialogue: 0,0:06:36.48,0:06:38.85,Default,,0,0,0,,Мен мұндай тұтынушының кіретініне сенбеймін⸺
Dialogue: 0,0:06:38.94,0:06:42.40,Default,,0,0,0,,Chiba Purple Haze дәуірінен бері жанкүйер ретінде,
Dialogue: 0,0:06:42.48,0:06:45.48,Default,,0,0,0,,Мен қатты әсер алдым.
Dialogue: 0,0:06:45.57,0:06:46.90,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:06:46.99,0:06:48.90,Default,,0,0,0,,Бүгінгі күн өте нашар.
Dialogue: 0,0:06:48.99,0:06:50.95,Default,,0,0,0,,Шынымен.
Dialogue: 0,0:06:52.12,0:06:54.41,Default,,0,0,0,,Қызық, Мұрата-сенпай да келе ме?
Dialogue: 0,0:06:58.54,0:07:00.33,Default,,0,0,0,,Фофофофо
Dialogue: 0,0:07:00.67,0:07:02.38,Default,,0,0,0,,Сара есте қаларлық күнде
Dialogue: 0,0:07:02.46,0:07:03.88,Default,,0,0,0,,Мен көп суретке түсемін!
Dialogue: 0,0:07:03.96,0:07:05.21,Default,,0,0,0,,Қазіргі соққың мүлде уақытынан тыс, аянышты болды!
Dialogue: 0,0:07:05.30,0:07:07.71,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:07:07.80,0:07:08.80,Default,,0,0,0,,О
Dialogue: 0,0:07:09.17,0:07:11.64,Default,,0,0,0,,(Ұялы телефонның діріл дыбысы)
Dialogue: 0,0:07:11.64,0:07:14.05,Default,,0,0,0,,(Ұялы телефонның діріл дыбысы)
Dialogue: 0,0:07:11.64,0:07:14.05,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:14.05,0:07:14.81,Default,,0,0,0,,(Ұялы телефонның діріл дыбысы)
Dialogue: 0,0:07:14.81,0:07:15.81,Default,,0,0,0,,(Ұялы телефонның діріл дыбысы)
Dialogue: 0,0:07:14.81,0:07:15.81,Default,,0,0,0,,Хмм
Dialogue: 0,0:07:16.93,0:07:18.23,Default,,0,0,0,,Я...
Dialogue: 0,0:07:18.31,0:07:21.44,Default,,0,0,0,,Hyper Dry туралы не айтасыз?
Dialogue: 0,0:07:21.52,0:07:24.31,Default,,0,0,0,,Мм... Рурико, бір сыра.
Dialogue: 0,0:07:24.40,0:07:27.23,Default,,0,0,0,,Әй, аға, келдің бе?
Dialogue: 0,0:07:27.32,0:07:28.82,Default,,0,0,0,,Бұл ерекше күн
Dialogue: 0,0:07:28.90,0:07:31.53,Default,,0,0,0,,Хехе, көп рахмет.
Dialogue: 0,0:07:31.61,0:07:34.28,Default,,0,0,0,,Дұрыс~ Бұл ең үлкен нәрсе.
Dialogue: 0,0:07:35.37,0:07:37.95,Default,,0,0,0,,Ойын жақындаған сайын⸺
Dialogue: 0,0:07:38.04,0:07:41.67,Default,,0,0,0,,Мен де неге екені белгісіз қобалжыдым...
Dialogue: 0,0:07:41.92,0:07:44.54,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:07:44.63,0:07:48.42,Default,,0,0,0,,Міне, біздің кейіпкерлеріміз де келді.
Dialogue: 0,0:07:48.63,0:07:49.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:51.05,0:07:53.84,Default,,0,0,0,,Міне, күн де ​​жетті.
Dialogue: 0,0:07:54.30,0:07:59.81,Default,,0,0,0,,Біздің Chiba Motor Suns үшін CS-те алғаш рет жарысатын тағдырлы сәт
Dialogue: 0,0:08:00.27,0:08:02.81,Default,,0,0,0,,Бұл матчта жеңіске жету - абсолютті талап
Dialogue: 0,0:08:02.90,0:08:05.56,Default,,0,0,0,,Егер сіз ұтсаңыз, CS мүмкіндігі жоғалады.
Dialogue: 0,0:08:05.65,0:08:09.40,Default,,0,0,0,,Жыласаң да, күлсең де тағдырың осы түнде шешіледі.
Dialogue: 0,0:08:19.33,0:08:21.91,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:08:22.00,0:08:23.17,Default,,0,0,0,,Chiba Motor Sands қарсы.
Dialogue: 0,0:08:23.25,0:08:24.92,Default,,0,0,0,,Фукуока Стикс матчы –⸺
Dialogue: 0,0:08:25.00,0:08:26.88,Default,,0,0,0,,1-ші иннинг 0-ден 0-ден жоғары
Dialogue: 0,0:08:26.96,0:08:28.92,Default,,0,0,0,,Екі армия да 3-орынға тең түсті
Dialogue: 0,0:08:29.13,0:08:30.92,Default,,0,0,0,,Жеңімпаз CS⸺-ге өтеді
Dialogue: 0,0:08:31.01,0:08:34.13,Default,,0,0,0,,Ең бастысы жеңілген алға жылжымайды.
Dialogue: 0,0:08:34.47,0:08:35.47,Default,,0,0,0,,Курихара мырза
Dialogue: 0,0:08:35.55,0:08:39.22,Default,,0,0,0,,Бірінші ойын үш ойыншының да шегінуімен басталды.
Dialogue: 0,0:08:39.31,0:08:43.02,Default,,0,0,0,,...
Dialogue: 0,0:08:43.10,0:08:46.73,Default,,0,0,0,,Екі құмыраның да дерлік жын рухы бар.
Dialogue: 0,0:08:46.81,0:08:48.40,Default,,0,0,0,,Әрине
Dialogue: 0,0:08:49.07,0:08:50.19,Default,,0,0,0,,Хмм
Dialogue: 0,0:08:51.24,0:08:52.65,Default,,0,0,0,,Мицуи мырза
Dialogue: 0,0:08:54.40,0:08:56.28,Default,,0,0,0,,Сатушы Сыраны толтырыңыз!
Dialogue: 0,0:08:56.37,0:08:59.58,Default,,0,0,0,,Ах... Пейс Еггс апа, бұл менің төртінші сусыным.
Dialogue: 0,0:09:00.66,0:09:01.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:01.87,0:09:05.00,Default,,0,0,0,,Енді екінші рет Стикстің шабуылы...
Dialogue: 0,0:09:07.21,0:09:09.84,Default,,0,0,0,,№4 Орталық Сусуму Арайба
Dialogue: 0,0:09:09.92,0:09:11.88,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:09:12.21,0:09:14.63,Default,,0,0,0,,Әзірге орташа соққы 30% және 5 минутты құрайды.
Dialogue: 0,0:09:14.72,0:09:17.47,Default,,0,0,0,,40 үй 115 RBI жұмыс істейді
Dialogue: 0,0:09:17.76,0:09:21.52,Default,,0,0,0,,Тынық мұхиты лигасы... Жоқ, оны Жапониядағы ең күшті соққышы деп айтуға болады.
Dialogue: 0,0:09:22.06,0:09:24.69,Default,,0,0,0,,Киса-сан, қараңызшы.
Dialogue: 0,0:09:24.77,0:09:27.40,Default,,0,0,0,,Мен... Рето Мицуи бұл⸺
Dialogue: 0,0:09:27.94,0:09:30.36,Default,,0,0,0,,Мен бүгін кешке адам боламын!
Dialogue: 0,0:09:30.57,0:09:34.49,Default,,0,0,0,,Мицуи Динамикалық формадан бірінші доп
Dialogue: 0,0:09:34.95,0:09:36.32,Default,,0,0,0,,Мен лақтырдым!
Dialogue: 0,0:09:38.49,0:09:38.82,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:09:38.82,0:09:41.41,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:09:38.82,0:09:41.41,Default,,0,0,0,,Мен соқтым! Үлкен жеңіс!
Dialogue: 0,0:09:41.41,0:09:41.49,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:09:41.49,0:09:43.08,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:09:41.49,0:09:43.08,Default,,0,0,0,,(Дарио) Бұл нағыз апат. Бұл жігіт те сол жерде-ақ қаза тапты. ➡
Dialogue: 0,0:09:43.33,0:09:46.96,Default,,0,0,0,,Стикс күшті үйге жүгірумен алға шығады!
Dialogue: 0,0:09:47.75,0:09:50.17,Default,,0,0,0,,...
Dialogue: 0,0:09:50.38,0:09:52.63,Default,,0,0,0,,Ми... Мицуи мырза
Dialogue: 0,0:09:54.21,0:09:55.72,Default,,0,0,0,,Фу…
Dialogue: 0,0:09:56.05,0:09:58.84,Default,,0,0,0,,Бұл өте жаман. Ол жеткіліксіз.
Dialogue: 0,0:09:59.22,0:10:01.39,Default,,0,0,0,,Бірақ келесі жолы міндетті түрде түсіруді бастаймын.
Dialogue: 0,0:10:01.47,0:10:02.60,Default,,0,0,0,,О
Dialogue: 0,0:10:02.97,0:10:04.52,Default,,0,0,0,,Шынымды айтсам, бұл күткендей.
Dialogue: 0,0:10:04.60,0:10:05.60,Default,,0,0,0,,Ендеше, ертең кездескенше.
Dialogue: 0,0:10:05.68,0:10:07.98,Default,,0,0,0,,Соло деген сөз жоқ.
Dialogue: 0,0:10:08.06,0:10:09.06,Default,,0,0,0,,О
Dialogue: 0,0:10:10.61,0:10:14.65,Default,,0,0,0,,Мен бейсболды түсінбеймін.
Dialogue: 0,0:10:14.94,0:10:19.07,Default,,0,0,0,,Мен жаңа ғана байқадым, барлығы әдеттегіден күштірек көрінеді.
Dialogue: 0,0:10:19.61,0:10:21.99,Default,,0,0,0,,Бірінші голға рұқсат бергенімізбен⸺
Dialogue: 0,0:10:22.08,0:10:25.08,Default,,0,0,0,,Төмендегілер ереуіл, шабуыл мен қорғаныстың өзгеруі.
Dialogue: 0,0:10:25.50,0:10:28.04,Default,,0,0,0,,Моторлы құмдардың 2-ші айналымның төменгі бөлігі⸺
Dialogue: 0,0:10:28.12,0:10:31.29,Default,,0,0,0,,Деннис пен Брайан жағымсыз соққымен тіреледі⸺
Dialogue: 0,0:10:31.75,0:10:32.75,Default,,0,0,0,,Және…
Dialogue: 0,0:10:32.84,0:10:33.96,Default,,0,0,0,,Хмм
Dialogue: 0,0:10:34.96,0:10:37.22,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:10:37.30,0:10:38.51,Default,,0,0,0,,Кодзиро бұл⸺
Dialogue: 0,0:10:38.59,0:10:41.01,Default,,0,0,0,,3 жүгіруден тұратын үйге жүгірумен шұғыл айналым
Dialogue: 0,0:10:41.09,0:10:42.80,Default,,0,0,0,,Уау! (Ер) Жарайды, 3-тен 1-ге!
Dialogue: 0,0:10:43.39,0:10:46.64,Default,,0,0,0,,Мен мұны істей аламын! Мен мұны істей аламын!
Dialogue: 0,0:10:47.23,0:10:48.89,Default,,0,0,0,,Бірақ 3-реттен кейін⸺
Dialogue: 0,0:10:48.98,0:10:52.06,Default,,0,0,0,,Motor Sands әрқашан жүгірушілерді жібереді⸺
Dialogue: 0,0:10:52.15,0:10:54.27,Default,,0,0,0,,Қосымша ұпай жинай алмау
Dialogue: 0,0:10:54.36,0:10:56.44,Default,,0,0,0,,Екінші жағынан, Стикс - бұл⸺
Dialogue: 0,0:10:56.53,0:11:00.36,Default,,0,0,0,,5-ші иннингте Арайба өзінің екінші үйінде екінші ұпайын алды.
Dialogue: 0,0:11:00.91,0:11:02.74,Default,,0,0,0,,Ойын 3-тен 2⸺ке дейін
Dialogue: 0,0:11:02.82,0:11:04.41,Default,,0,0,0,,Әрең дегенде бірінші орында⸺
Dialogue: 0,0:11:04.49,0:11:06.83,Default,,0,0,0,,Біз 6-шы иннингке жететін болдық.
Dialogue: 0,0:11:07.08,0:11:09.87,Default,,0,0,0,,Жарайды, қорғанысқа да шабуыл жасайық!
Dialogue: 0,0:11:10.08,0:11:12.67,Default,,0,0,0,,Брайан, бізге қолдау көрсетіңіз!
Dialogue: 0,0:11:12.75,0:11:15.21,Default,,0,0,0,,Өтінемін, келіп мені қорға.
Dialogue: 0,0:11:19.76,0:11:21.55,Default,,0,0,0,,Шишио? (Шишио) Иә?
Dialogue: 0,0:11:21.64,0:11:23.18,Default,,0,0,0,,Не болды? кеттік
Dialogue: 0,0:11:23.26,0:11:25.43,Default,,0,0,0,,А, мен қазір барамын.
Dialogue: 0,0:11:26.43,0:11:27.89,Default,,0,0,0,,Енді, 6-шы иннингтің жоғарғы жағы
Dialogue: 0,0:11:27.97,0:11:29.31,Default,,0,0,0,,1 сыртқа, 1-негіз
Dialogue: 0,0:11:29.39,0:11:31.23,Default,,0,0,0,,Батареяларға қалай шабуыл жасауға болады?
Dialogue: 0,0:11:31.44,0:11:33.61,Default,,0,0,0,,Осы уақытқа дейін Мицуи жақсы жұмыс істеп жатыр.
Dialogue: 0,0:11:33.69,0:11:35.98,Default,,0,0,0,,Кавамацу да жақсы көш бастады.
Dialogue: 0,0:11:36.07,0:11:39.28,Default,,0,0,0,,Motor Suns құмыра жетіспеушілігінен зардап шекті⸺
Dialogue: 0,0:11:39.36,0:11:42.36,Default,,0,0,0,,Ол, әрине, өсіп келеді.
Dialogue: 0,0:11:44.03,0:11:45.03,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:11:45.12,0:11:47.49,Default,,0,0,0,,Мен соқтым! Бірақ бұл Гецзу курсы
Dialogue: 0,0:11:47.58,0:11:49.87,Default,,0,0,0,,Ичиномиядан Шишиоға өту, екеуі шықты!
Dialogue: 0,0:11:51.08,0:11:52.42,Default,,0,0,0,,1-базаға көшіру...
Dialogue: 0,0:11:52.50,0:11:53.75,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:55.09,0:11:57.71,Default,,0,0,0,,А, Шишио күтпеген жерден нашар лақтыру жасады!
Dialogue: 0,0:11:57.80,0:11:59.17,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:01.13,0:12:02.38,Default,,0,0,0,,Қаптаушы екінші базаға ауысады
Dialogue: 0,0:12:02.63,0:12:05.43,Default,,0,0,0,,Жоқ, лақтырылған допты ұстаушы жауып тастады!
Dialogue: 0,0:12:05.64,0:12:07.31,Default,,0,0,0,,Каваматсу Керемет мұқаба!
Dialogue: 0,0:12:07.39,0:12:08.39,Default,,0,0,0,,Эй!
Dialogue: 0,0:12:09.10,0:12:11.73,Default,,0,0,0,,Түртіңіз! Қос ойын!
Dialogue: 0,0:12:12.19,0:12:14.65,Default,,0,0,0,,Каваматсу, командадағы ең байыпты адам
Dialogue: 0,0:12:14.73,0:12:18.82,Default,,0,0,0,,Ештеңе болмаған сияқты, өте байсалды
Dialogue: 0,0:12:18.90,0:12:22.40,Default,,0,0,0,,(Қуаныш тобының өнері)
Dialogue: 0,0:12:22.82,0:12:24.57,Default,,0,0,0,,Уау...
Dialogue: 0,0:12:25.32,0:12:26.32,Default,,0,0,0,,Ах
Dialogue: 0,0:12:27.37,0:12:29.95,Default,,0,0,0,,Әй, жаңбырлы күннің баласы ғой.
Dialogue: 0,0:12:30.04,0:12:31.16,Default,,0,0,0,,Хехехе
Dialogue: 0,0:12:34.37,0:12:35.79,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:12:35.79,0:12:39.13,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:12:35.79,0:12:39.13,Default,,0,0,0,,үшінның дауысы жерден дірілдей естілді⸺
Dialogue: 0,0:12:39.13,0:12:39.21,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:12:39.21,0:12:40.38,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:12:39.21,0:12:40.38,Default,,0,0,0,,Мен стадион біртұтас болып жатқанын сезіндім.
Dialogue: 0,0:12:40.38,0:12:41.84,Default,,0,0,0,,Мен стадионның біртұтас болып жатқанын сезіндім.
Dialogue: 0,0:12:42.55,0:12:45.51,Default,,0,0,0,,Осылай жалғаса берсе, әркімнің тілегі орындалатыны сөзсіз.
Dialogue: 0,0:12:45.59,0:12:47.51,Default,,0,0,0,,CS-ге бара алады
Dialogue: 0,0:12:49.18,0:12:52.27,Default,,0,0,0,,7-ші иннингтің жоғарғы бөлігі, 1-шығару, 2-ші және 3-ші негіз
Dialogue: 0,0:12:52.56,0:12:55.85,Default,,0,0,0,,Біз кездескен ұршық — Роппонмацу, күшті соққышы.
Dialogue: 0,0:12:55.94,0:12:57.31,Default,,0,0,0,,Қазіргі уақытта 3-тен 2-ге дейін
Dialogue: 0,0:12:57.40,0:13:00.73,Default,,0,0,0,,Бір оқ алсаңыз, Стикс бірден айналады.
Dialogue: 0,0:13:00.94,0:13:03.32,Default,,0,0,0,,Ми... Мицуи Ганбатте
Dialogue: 0,0:13:03.40,0:13:05.95,Default,,0,0,0,,Жарайды, доп әлі қозғалады.
Dialogue: 0,0:13:06.32,0:13:08.33,Default,,0,0,0,,Шабуылға барыңыз, Мицуи
Dialogue: 0,0:13:08.41,0:13:09.41,Default,,0,0,0,,Хмм
Dialogue: 0,0:13:12.00,0:13:14.25,Default,,0,0,0,,Ша! Барайық! (үшін) О!
Dialogue: 0,0:13:15.04,0:13:17.71,Default,,0,0,0,,Ойын тығырыққа тіреледі және ойын аяқталады
Dialogue: 0,0:13:17.79,0:13:20.63,Default,,0,0,0,,Жарғанаттағы бұл бұрылыс бұрылыс нүктесі бола ма?
Dialogue: 0,0:13:23.59,0:13:26.84,Default,,0,0,0,,Егер сіз жеңсеңіз, CS Егер сіз жеңсеңіз, ұсыныс жасаңыз
Dialogue: 0,0:13:26.93,0:13:29.93,Default,,0,0,0,,Егер сіз жеңсеңіз, CS Егер сіз жеңсеңіз, ұсыныс жасаңыз
Dialogue: 0,0:13:30.39,0:13:33.39,Default,,0,0,0,,Егер сіз ұтсаңыз, бұл сіздің алғашқы екі таңбалы жеңісіңіз болады!
Dialogue: 0,0:13:34.48,0:13:35.48,Default,,0,0,0,,Взвод мүшелерінің бір-бірімен шайқасуына болмайды!
Dialogue: 0,0:13:36.94,0:13:37.94,Default,,0,0,0,,Хмм
Dialogue: 0,0:13:38.44,0:13:39.48,Default,,0,0,0,,Түсірілді!
Dialogue: 0,0:13:39.56,0:13:41.86,Default,,0,0,0,,Доп қысқа соққы. Шишио - шабуылшы!
Dialogue: 0,0:13:42.07,0:13:43.53,Default,,0,0,0,,Жарайды, Шишио.
Dialogue: 0,0:13:43.61,0:13:45.82,Default,,0,0,0,,Уф... уф!
Dialogue: 0,0:13:45.90,0:13:46.95,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:47.03,0:13:49.45,Default,,0,0,0,,жеткізілмеген! Ол кетті!
Dialogue: 0,0:13:49.70,0:13:53.41,Default,,0,0,0,,Үшінші табандағы жүйрік аман қалады, ал екінші табандағы жүгіруші де аман қалады.
Dialogue: 0,0:13:53.91,0:13:56.29,Default,,0,0,0,,4 3-ке қарсы стиксті өзгерту!
Dialogue: 0,0:13:57.54,0:13:59.96,Default,,0,0,0,,А... бұлай ойлауға не себеп болды?
Dialogue: 0,0:14:00.04,0:14:03.05,Default,,0,0,0,,Неліктен мен жұлдыздарды жеңу туралы ойладым?
Dialogue: 0,0:14:04.09,0:14:05.09,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:05.42,0:14:06.47,Default,,0,0,0,,Мицуи мырза
Dialogue: 0,0:14:06.55,0:14:09.05,Default,,0,0,0,,Сәлем! Мицуи: Сен енді жынды емессің бе?
Dialogue: 0,0:14:09.14,0:14:10.14,Default,,0,0,0,,Ах
Dialogue: 0,0:14:10.35,0:14:11.89,Default,,0,0,0,,Оны тез өзгертіңіз!
Dialogue: 0,0:14:11.97,0:14:15.39,Default,,0,0,0,,А, жоқ, жоқ, мен мұны жоғалтамын.
Dialogue: 0,0:14:15.48,0:14:17.81,Default,,0,0,0,,Сіз мені көп күтуге мәжбүр еттіңіз.
Dialogue: 0,0:14:17.89,0:14:19.60,Default,,0,0,0,,Қайт, үйге қайт
Dialogue: 0,0:14:20.77,0:14:24.40,Default,,0,0,0,,Төмен қарама! Алға қарай алға!
Dialogue: 0,0:14:24.69,0:14:27.03,Default,,0,0,0,,Әлі біткен жоқ!
Dialogue: 0,0:14:27.11,0:14:29.82,Default,,0,0,0,,Мицуи! Уайымдама!
Dialogue: 0,0:14:29.91,0:14:33.70,Default,,0,0,0,,Енді мұны істеуге мүмкіндік жоқ! Маған ұнайды!
Dialogue: 0,0:14:34.12,0:14:35.37,Default,,0,0,0,,Сатушы?
Dialogue: 0,0:14:35.58,0:14:37.29,Default,,0,0,0,,Ру… Рулико-сан
Dialogue: 0,0:14:37.37,0:14:39.29,Default,,0,0,0,,Рурико Бұл қыз...
Dialogue: 0,0:14:39.50,0:14:41.42,Default,,0,0,0,,Сатушы дұрыс айтады.
Dialogue: 0,0:14:41.50,0:14:43.21,Default,,0,0,0,,Әлі біткен жоқ.
Dialogue: 0,0:14:43.30,0:14:44.67,Default,,0,0,0,,(Изуку) Качан… әдетте оң қолымен мықты соққы жасап бастайды
Dialogue: 0,0:14:44.75,0:14:46.76,Default,,0,0,0,,Рурико-сан дұрыс айтады!
Dialogue: 0,0:14:46.84,0:14:48.17,Default,,0,0,0,,Жоғалтпа! Ха!
Dialogue: 0,0:14:48.26,0:14:50.34,Default,,0,0,0,,Мицуиге сәттілік!
Dialogue: 0,0:14:50.43,0:14:53.35,Default,,0,0,0,,Көңілді Мицуи! Біз сенімен біргеміз!
Dialogue: 0,0:14:53.43,0:14:55.60,Default,,0,0,0,,Жақсы питчинг, Мицуи!
Dialogue: 0,0:14:55.68,0:14:56.81,Default,,0,0,0,,Ауыстыру!
Dialogue: 0,0:14:56.89,0:14:58.77,Default,,0,0,0,,...
Dialogue: 0,0:14:58.85,0:15:00.40,Default,,0,0,0,,Алда көп нәрсе бар!
Dialogue: 0,0:15:00.48,0:15:02.98,Default,,0,0,0,,Бізге Motor Sands-тің шынайы күшін көрсетіңіз!
Dialogue: 0,0:15:03.06,0:15:06.53,Default,,0,0,0,,Міндетті түрде CS-ге барайық, Мицуи!
Dialogue: 0,0:15:06.61,0:15:08.53,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:09.53,0:15:13.83,Default,,0,0,0,,Бұл күні мен өмірімдегі ең қатты дауысты шығардым⸺
Dialogue: 0,0:15:13.91,0:15:19.54,Default,,0,0,0,,Алда әлі де толқулар күтіп тұрғанын ешкім білмейді.
Dialogue: 0,0:15:21.50,0:15:22.75,Default,,0,0,0,,Мен әлі жеңілген жоқпын!
Dialogue: 0,0:15:22.83,0:15:23.84,Default,,0,0,0,,Берілмеңіз!
Dialogue: 0,0:15:23.92,0:15:25.50,Default,,0,0,0,,Осы жерден! Осы жерден!
Dialogue: 0,0:15:25.59,0:15:29.34,Default,,0,0,0,,7-ші кезеңнің жоғарғы бөлігі Ойын ақыры басталды
Dialogue: 0,0:15:29.59,0:15:30.97,Default,,0,0,0,,Роппонматсуда уақтылы⸺
Dialogue: 0,0:15:31.05,0:15:33.47,Default,,0,0,0,,Стикстің кері айналуы 4 қарсы 3
Dialogue: 0,0:15:33.55,0:15:37.68,Default,,0,0,0,,Моторлы құмдар Біз кез келген жағдайда артық ұпайларды жіберіп алмауды қалаймыз.
Dialogue: 0,0:15:37.77,0:15:40.27,Default,,0,0,0,,Ой! Орындық осында қозғалады!
Dialogue: 0,0:15:40.81,0:15:44.77,Default,,0,0,0,,Мицуи орнына құмыра Нанами
Dialogue: 0,0:15:44.86,0:15:47.23,Default,,0,0,0,,Бірыңғай нөмір 54
Dialogue: 0,0:15:49.11,0:15:51.11,Default,,0,0,0,,Ах... (Ер) Ах, Мицуи.
Dialogue: 0,0:15:51.36,0:15:52.99,Default,,0,0,0,,Жақсы жұмыс Мицуи!
Dialogue: 0,0:15:51.36,0:15:52.99,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:15:52.99,0:15:53.07,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:15:53.07,0:15:54.62,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:15:53.07,0:15:54.62,Default,,0,0,0,,Бұл жақсы қадам болды!
Dialogue: 0,0:15:54.82,0:15:58.37,Default,,0,0,0,,Мицуи-кун! Бұл өте керемет болды!
Dialogue: 0,0:15:58.45,0:16:01.37,Default,,0,0,0,,Мен сені жақсы көремін, Мицуи!
Dialogue: 0,0:16:01.67,0:16:03.12,Default,,0,0,0,,Мицуи мырза
Dialogue: 0,0:16:03.54,0:16:07.05,Default,,0,0,0,,Қысқа Шишио Мориге ауыстырылды
Dialogue: 0,0:16:07.13,0:16:08.13,Default,,0,0,0,,Ах
Dialogue: 0,0:16:10.88,0:16:12.18,Default,,0,0,0,,Шишио?
Dialogue: 0,0:16:14.84,0:16:16.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:16.43,0:16:19.77,Default,,0,0,0,,Сенің әлі аяғың бар... Ойын солай ма?
Dialogue: 0,0:16:19.85,0:16:20.89,Default,,0,0,0,,Навигация
Dialogue: 0,0:16:21.98,0:16:24.35,Default,,0,0,0,,Нашар, мен де кезектесіп тұруым керек.
Dialogue: 0,0:16:26.27,0:16:27.77,Default,,0,0,0,,Мен сізден көбірек сұраймын.
Dialogue: 0,0:16:32.49,0:16:37.49,Default,,0,0,0,,Шишио, жүр... ауырған жүзіңді менен тіпті жасырма.
Dialogue: 0,0:16:37.87,0:16:38.99,Default,,0,0,0,,Ақымақ.
Dialogue: 0,0:16:39.49,0:16:41.37,Default,,0,0,0,,Ей, тіпті Шишио да кезектесіп жүр ме?
Dialogue: 0,0:16:41.45,0:16:42.87,Default,,0,0,0,,Бір жеріңіз ауырды ма?
Dialogue: 0,0:16:42.96,0:16:44.62,Default,,0,0,0,,Сіз осылай жеңе аласыз ба?
Dialogue: 0,0:16:44.71,0:16:45.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:48.80,0:16:53.01,Default,,0,0,0,,Осы жылы 8-ші иннингтен кейін 5 рет жеңіске жетті.
Dialogue: 0,0:16:53.09,0:16:55.34,Default,,0,0,0,,Олардың екеуі Стикске қарсы.
Dialogue: 0,0:16:55.43,0:16:58.10,Default,,0,0,0,,Жарайды, мүлдем жарайды
Dialogue: 0,0:16:58.18,0:16:59.18,Default,,0,0,0,,Ах
Dialogue: 0,0:17:00.27,0:17:01.27,Default,,0,0,0,,Хмм
Dialogue: 0,0:17:01.47,0:17:02.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:04.56,0:17:05.85,Default,,0,0,0,,Лу... Лулико-сан!
Dialogue: 0,0:17:05.94,0:17:08.15,Default,,0,0,0,,Ах... Иә!
Dialogue: 0,0:17:09.32,0:17:11.61,Default,,0,0,0,,1 сыра
Dialogue: 0,0:17:14.07,0:17:15.07,Default,,0,0,0,,Иә
Dialogue: 0,0:17:15.32,0:17:17.95,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:17:18.32,0:17:22.25,Default,,0,0,0,,Ауыстырылған Нанами Арайба мен Кросбиді қуып жіберді⸺
Dialogue: 0,0:17:22.33,0:17:26.58,Default,,0,0,0,,Мотор Сэндс 1 ұпай басымдығымен 7-ші иннингтің жоғарғы сатысынан өтті
Dialogue: 0,0:17:26.96,0:17:30.38,Default,,0,0,0,,Бірақ мен 7-8-ші иннингте әлі гол соға алмадым⸺
Dialogue: 0,0:17:30.46,0:17:31.96,Default,,0,0,0,,Матч ақыры...
Dialogue: 0,0:17:33.13,0:17:34.47,Default,,0,0,0,,Ягино шығып кетті!
Dialogue: 0,0:17:34.55,0:17:35.55,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:17:35.63,0:17:36.97,Default,,0,0,0,,Келіңіздер, 9-шы иннингтің төменгі жағы.
Dialogue: 0,0:17:37.05,0:17:40.47,Default,,0,0,0,,Ягино соққы берді, 1 шықты, жүгірушілер жоқ.
Dialogue: 0,0:17:40.56,0:17:44.02,Default,,0,0,0,,Моторлы құмдар баяу бұралып жатыр
Dialogue: 0,0:17:44.10,0:17:46.06,Default,,0,0,0,,Өтінемін, бірдеңе жасаңыз!
Dialogue: 0,0:17:46.14,0:17:48.10,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:17:48.19,0:17:51.65,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:17:55.03,0:17:56.11,Default,,0,0,0,,Хмм
Dialogue: 0,0:18:01.79,0:18:05.16,Default,,0,0,0,,Сіз Styx Guardian Ишимаруды жеңе аласыз ба?
Dialogue: 0,0:18:05.37,0:18:07.87,Default,,0,0,0,,Ногияма қандай жағдай болмасын базисте болғысы келеді.
Dialogue: 0,0:18:08.83,0:18:10.59,Default,,0,0,0,,Құмыраның динамикалық пішінінен⸺
Dialogue: 0,0:18:10.67,0:18:12.46,Default,,0,0,0,,Бірінші қадам лақтырылды!
Dialogue: 0,0:18:12.55,0:18:13.55,Default,,0,0,0,,Хамф!
Dialogue: 0,0:18:14.42,0:18:15.88,Default,,0,0,0,,Жарғанат сынды!
Dialogue: 0,0:18:16.17,0:18:17.88,Default,,0,0,0,,Кептеліп қалған доп сол алаңның алдында тұр!
Dialogue: 0,0:18:17.97,0:18:18.72,Default,,0,0,0,,(Әйелдердің қошеметі)
Dialogue: 0,0:18:18.72,0:18:22.43,Default,,0,0,0,,(Әйелдердің қошеметі)
Dialogue: 0,0:18:18.72,0:18:22.43,Default,,0,0,0,,Нокояманың табанды соққысы, 1-базадағы жүгіруші!
Dialogue: 0,0:18:23.43,0:18:24.43,Default,,0,0,0,,Ах
Dialogue: 0,0:18:25.60,0:18:28.56,Default,,0,0,0,,Келіңіздер, Motorsans, сіз ағын жасай аласыз ба?
Dialogue: 0,0:18:28.77,0:18:30.77,Default,,0,0,0,,Уф! (Тікелей эфир) Деннистің басы сырғып жатыр!
Dialogue: 0,0:18:30.86,0:18:31.86,Default,,0,0,0,,Қауіпсіз!
Dialogue: 0,0:18:32.15,0:18:34.65,Default,,0,0,0,,Төртінші доп! (Тікелей түсініктеме) Брайан да базада
Dialogue: 0,0:18:34.73,0:18:36.99,Default,,0,0,0,,1 шықты, негіздер жүктелді!
Dialogue: 0,0:18:37.07,0:18:38.45,Default,,0,0,0,,Ал... негіздер жүктелді.
Dialogue: 0,0:18:38.53,0:18:39.66,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:39.74,0:18:42.12,Default,,0,0,0,,Мен мұны істей аламын!
Dialogue: 0,0:18:42.41,0:18:43.95,Default,,0,0,0,,Үшті ұр!
Dialogue: 0,0:18:44.04,0:18:46.41,Default,,0,0,0,,№ 6 Такада шығып, 2 ұпай алды.
Dialogue: 0,0:18:46.50,0:18:48.41,Default,,0,0,0,,О, жоқ, жоқ, жоқ, жоқ
Dialogue: 0,0:18:48.50,0:18:50.88,Default,,0,0,0,,Жоқ, жақсы. Келесі қамыр...
Dialogue: 0,0:18:50.96,0:18:53.34,Default,,0,0,0,,9-шы иннингтің төменгі бөлігі, 2 шығу, негіз жүктелді
Dialogue: 0,0:18:53.42,0:18:57.59,Default,,0,0,0,,Бұл матчтың ең үлкен драмасы соңғы эпизодты күтті.
Dialogue: 0,0:18:57.67,0:19:01.18,Default,,0,0,0,,Бұл жігіт 2-ші иннингтің төменгі жағында 3 жүгіруден соқты, жарғанатты!
Dialogue: 0,0:19:01.26,0:19:05.85,Default,,0,0,0,,№ 7 Жарық Кодзиро
Dialogue: 0,0:19:06.22,0:19:07.39,Default,,0,0,0,,Хмм
Dialogue: 0,0:19:08.10,0:19:11.56,Default,,0,0,0,,Кодзиро мен Ишимару Бірінші қарау керек...
Dialogue: 0,0:19:13.31,0:19:14.44,Default,,0,0,0,,Әй!
Dialogue: 0,0:19:15.65,0:19:16.94,Default,,0,0,0,,Польнареффтің қылышынан да жылдам болды. Құдай-ай!》
Dialogue: 0,0:19:17.03,0:19:21.95,Default,,0,0,0,,Ишимару: Ол 150 кг кесілген допты ішкі бұрышпен соқты!
Dialogue: 0,0:19:22.28,0:19:23.28,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:23.58,0:19:24.58,Default,,0,0,0,,Хун
Dialogue: 0,0:19:25.45,0:19:27.12,Default,,0,0,0,,Бір ату, қоштасу
Dialogue: 0,0:19:27.20,0:19:30.50,Default,,0,0,0,,Егер ол шықса, мұнда Motorsans жеңілді.
Dialogue: 0,0:19:30.79,0:19:32.04,Default,,0,0,0,,Құмыраның басын изеді
Dialogue: 0,0:19:32.13,0:19:33.79,Default,,0,0,0,,Қол қою туралы шешім қабылданды.
Dialogue: 0,0:19:38.88,0:19:40.97,Default,,0,0,0,,Ұзақ уақыттан кейін...
Dialogue: 0,0:19:42.97,0:19:44.64,Default,,0,0,0,,Екінші қадам лақтырылды!
Dialogue: 0,0:19:45.51,0:19:48.60,Default,,0,0,0,,Мен соқтым! Өткір соққы!
Dialogue: 0,0:20:02.99,0:20:03.99,Default,,0,0,0,,Га
Dialogue: 0,0:20:05.33,0:20:06.45,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:20:07.29,0:20:08.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:12.17,0:20:15.92,Default,,0,0,0,,... Құмыраны төсеу
Dialogue: 0,0:20:16.38,0:20:18.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:19.46,0:20:22.34,Default,,0,0,0,,Демек, ойлағанымдай…
Dialogue: 0,0:20:22.72,0:20:23.30,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:20:23.30,0:20:25.85,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:20:23.30,0:20:25.85,Default,,0,0,0,,Ойын аяқталды!
Dialogue: 0,0:20:25.85,0:20:25.93,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:20:25.93,0:20:29.06,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:20:25.93,0:20:29.06,Default,,0,0,0,,Жеңімпаз Фукуока Стикс болды!
Dialogue: 0,0:20:29.27,0:20:32.14,Default,,0,0,0,,Styx CS-ге өтеді!
Dialogue: 0,0:20:32.39,0:20:38.61,Default,,0,0,0,,Мотор Сэндстің CS-тегі алғашқы шабуылы аяқталды!
Dialogue: 0,0:20:40.15,0:20:42.90,Default,,0,0,0,,Мен... Бұл менің кінәм.
Dialogue: 0,0:20:42.99,0:20:46.28,Default,,0,0,0,,Кешіріңіз, бәрі... Кешіріңіз!
Dialogue: 0,0:20:46.57,0:20:47.87,Default,,0,0,0,,Мицуи мырза
Dialogue: 0,0:20:47.95,0:20:49.62,Default,,0,0,0,,Бұл Мицуидің кінәсі емес
Dialogue: 0,0:20:49.70,0:20:52.75,Default,,0,0,0,,Мен көмектесе алмадым, өйткені менде соққы болмады.
Dialogue: 0,0:20:54.75,0:20:57.59,Default,,0,0,0,,Кодзиро Жақсысың ба?
Dialogue: 0,0:20:59.80,0:21:02.13,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:21:05.18,0:21:08.43,Default,,0,0,0,,Кешіріңіз, мен пайдасыз капитанмын.
Dialogue: 0,0:21:09.56,0:21:10.56,Default,,0,0,0,,Уау
Dialogue: 0,0:21:10.64,0:21:13.43,Default,,0,0,0,,Эй Деннис, бұл не? Кенет тоқтады...
Dialogue: 0,0:21:13.52,0:21:16.02,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:21:17.52,0:21:20.36,Default,,0,0,0,,Әй, бәрің, тездетіп шық.
Dialogue: 0,0:21:20.61,0:21:21.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:21.90,0:21:23.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:26.49,0:21:28.32,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:21:28.32,0:21:30.83,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:21:28.32,0:21:30.83,Default,,0,0,0,,Мынау... мынау
Dialogue: 0,0:21:30.83,0:21:31.29,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:21:31.29,0:21:33.45,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:21:31.29,0:21:33.45,Default,,0,0,0,,Motorsans компаниясына рахмет!
Dialogue: 0,0:21:33.54,0:21:37.71,Default,,0,0,0,,Кодзиро! Ол команданы жақсы басқарды!
Dialogue: 0,0:21:37.79,0:21:40.17,Default,,0,0,0,,Шишио да тамаша жұмыс жасады!
Dialogue: 0,0:21:40.25,0:21:44.42,Default,,0,0,0,,Келесі жылы міндетті түрде CS алыңыз!
Dialogue: 0,0:21:47.59,0:21:52.47,Default,,0,0,0,,Стадион қайғылы және қатал.
Dialogue: 0,0:21:53.56,0:21:57.10,Default,,0,0,0,,Үлкен кісі жылап тұрды...
Dialogue: 0,0:21:58.40,0:22:01.27,Default,,0,0,0,,Мен бейсбол ережесін әлі білмеймін⸺
Dialogue: 0,0:22:02.78,0:22:04.90,Default,,0,0,0,,Менің ойымша, бұл жер⸺
Dialogue: 0,0:22:06.15,0:22:09.82,Default,,0,0,0,,Мен сені кешегі күннен артық жақсы көремін
Dialogue: 0,0:22:15.46,0:22:20.33,Default,,0,0,0,,♪～
Dialogue: 0,0:23:39.91,0:23:44.92,Default,,0,0,0,,～♪
