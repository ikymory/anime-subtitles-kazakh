Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.00,0:00:06.00,Default,,0,0,0,,♪～
Dialogue: 0,0:01:22.08,0:01:27.08,Default,,0,0,0,,～♪
Dialogue: 0,0:01:37.43,0:01:39.80,Default,,0,0,0,,Менің атым Юки Такино
Dialogue: 0,0:01:39.89,0:01:42.22,Default,,0,0,0,,Міне, бұрынғы диктор әйел
Dialogue: 0,0:01:43.02,0:01:45.39,Default,,0,0,0,,Кейио желісі 17:00-де
Dialogue: 0,0:01:46.02,0:01:48.23,Default,,0,0,0,,Мен ренжідім
Dialogue: 0,0:01:49.15,0:01:51.61,Default,,0,0,0,,Кайхин Макухари станциясына жақындағанда⸺
Dialogue: 0,0:01:51.69,0:01:55.95,Default,,0,0,0,,Өйткені пойыз мен жек көретін адамдарға толы.
Dialogue: 0,0:01:56.61,0:01:59.57,Default,,0,0,0,,Толық бас киіммен және формамен жабдықталған
Dialogue: 0,0:02:00.28,0:02:03.29,Default,,0,0,0,,Қаптан шығып тұрған тірек тауарлар
Dialogue: 0,0:02:03.54,0:02:07.16,Default,,0,0,0,,А... а...
Dialogue: 0,0:02:07.25,0:02:10.33,Default,,0,0,0,,Қараңызшы, көңілді әннің ырғағы
Dialogue: 0,0:02:10.42,0:02:13.55,Default,,0,0,0,,Ммм... ммм
Dialogue: 0,0:02:16.67,0:02:19.64,Default,,0,0,0,,Бейсбол жанкүйерлері барлық жерде
Dialogue: 0,0:02:19.72,0:02:21.35,Default,,0,0,0,,О, бұл тітіркендіргіш!
Dialogue: 0,0:02:22.68,0:02:23.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:24.64,0:02:28.39,Default,,0,0,0,,«Ивакава өзінің жаңа питчинг формасын жақсы сезінеді»
Dialogue: 0,0:02:28.48,0:02:31.36,Default,,0,0,0,,«3 қатарынан СБС»
Dialogue: 0,0:02:32.31,0:02:34.57,Default,,0,0,0,,HQS? бұл не
Dialogue: 0,0:02:35.28,0:02:37.28,Default,,0,0,0,,Бұл қыз да!
Dialogue: 0,0:02:37.36,0:02:39.11,Default,,0,0,0,,Ммм
Dialogue: 0,0:02:39.32,0:02:43.37,Default,,0,0,0,,Пойызда жас балаларға спорт газеттерін оқуға жол бермеңіз!
Dialogue: 0,0:02:43.45,0:02:46.25,Default,,0,0,0,,Сондықтан бейсбол жанкүйерлері
Dialogue: 0,0:02:46.83,0:02:50.71,Default,,0,0,0,,Жақында Кайхин Макухари Кайхин Макухари
Dialogue: 0,0:02:50.79,0:02:53.04,Default,,0,0,0,,Шығу оң жақта
Dialogue: 0,0:02:53.88,0:02:55.17,Default,,0,0,0,,Бірақ жақсы⸺
Dialogue: 0,0:02:55.59,0:02:59.38,Default,,0,0,0,,Менің баратын жерім де бейсбол стадионы.
Dialogue: 0,0:03:01.09,0:03:04.93,Default,,0,0,0,,Бірақ тереңірек себеп бар.
Dialogue: 0,0:03:06.18,0:03:10.39,Default,,0,0,0,,Бірыңғай киім нөмірі 1 Кодзиро формасы орнатылды
Dialogue: 0,0:03:10.48,0:03:12.15,Default,,0,0,0,,Ах
Dialogue: 0,0:03:12.48,0:03:14.52,Default,,0,0,0,,Шишио-кун!
Dialogue: 0,0:03:14.61,0:03:16.40,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:03:16.61,0:03:19.65,Default,,0,0,0,,Аа... соншалықты
Dialogue: 0,0:03:20.61,0:03:24.37,Default,,0,0,0,,Жас әйелдердің барлығы Шишио жанкүйерлері.
Dialogue: 0,0:03:24.45,0:03:28.62,Default,,0,0,0,,Онымен салыстырғанда, менің Кодзиро қыздар арасында танымал емес.
Dialogue: 0,0:03:29.75,0:03:30.75,Default,,0,0,0,,Я...
Dialogue: 0,0:03:31.50,0:03:33.79,Default,,0,0,0,,Сізге қалай ұнайды? Иә?
Dialogue: 0,0:03:34.00,0:03:37.13,Default,,0,0,0,,Hyper Dry туралы не айтасыз?
Dialogue: 0,0:03:38.51,0:03:41.76,Default,,0,0,0,,А... Мен сыра ішуім керек пе?
Dialogue: 0,0:03:41.84,0:03:43.22,Default,,0,0,0,,Кешіріңіз—
Dialogue: 0,0:03:44.30,0:03:46.18,Default,,0,0,0,,Міне, солай!
Dialogue: 0,0:03:46.56,0:03:49.64,Default,,0,0,0,,Не? Бұрынғы спорт газеті?
Dialogue: 0,0:03:49.73,0:03:51.64,Default,,0,0,0,,Бұл сатушы болды ма?
Dialogue: 0,0:03:53.27,0:03:56.27,Default,,0,0,0,,Ах, бұл форма Кодзиро.
Dialogue: 0,0:03:56.36,0:03:59.40,Default,,0,0,0,,А, а... ой.
Dialogue: 0,0:04:00.40,0:04:04.82,Default,,0,0,0,,Сізге Кодзиро ұнай ма? Ол жақсы ойыншы
Dialogue: 0,0:04:05.12,0:04:07.12,Default,,0,0,0,,Бір сыра Азассу
Dialogue: 0,0:04:07.45,0:04:11.71,Default,,0,0,0,,Жас ханымның Кодзироның формасын киюі өте сирек.
Dialogue: 0,0:04:11.79,0:04:13.42,Default,,0,0,0,,Бұл өте жиі емес.
Dialogue: 0,0:04:13.50,0:04:14.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:16.00,0:04:18.75,Default,,0,0,0,,Қыздар арасында өте танымал емес
Dialogue: 0,0:04:18.84,0:04:21.17,Default,,0,0,0,,«Жас ханым» бақытты, бірақ
Dialogue: 0,0:04:26.68,0:04:30.27,Default,,0,0,0,,Мен Кодзироға неге соншалықты ерекше қараймын?
Dialogue: 0,0:04:32.94,0:04:37.69,Default,,0,0,0,,Мен неге стадионға құлықсыз барамын?
Dialogue: 0,0:04:38.52,0:04:40.65,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:04:40.94,0:04:46.62,Default,,0,0,0,,No 7 Оң жақтағы Кодзиро Бірыңғай киім нөмірі 1
Dialogue: 0,0:04:47.16,0:04:49.95,Default,,0,0,0,,Себебі мен Кодзироның әйелімін!
Dialogue: 0,0:04:50.91,0:04:54.50,Default,,0,0,0,,Тұрмысқа шыққандықтан ойнай алмаймын деп жұрттың айтқанын қаламаймын.
Dialogue: 0,0:04:55.54,0:04:59.00,Default,,0,0,0,,Бүгін, жарғанаттағы 2-ші бұрылыс, 2 (екі) шығу, 1-ші және 2-ші негіз
Dialogue: 0,0:04:59.25,0:05:01.42,Default,,0,0,0,,Мен жақсы жерге келдім
Dialogue: 0,0:05:02.21,0:05:03.34,Default,,0,0,0,,Ммм
Dialogue: 0,0:05:03.42,0:05:05.43,Default,,0,0,0,,Бұл не, Кодзиро?
Dialogue: 0,0:05:05.51,0:05:07.30,Default,,0,0,0,,шымшу! Шымшушы! Ах
Dialogue: 0,0:05:07.39,0:05:11.77,Default,,0,0,0,,Орташа соғу көрсеткіші 20% болатын нашар ұрушы ұпай жинамайды!
Dialogue: 0,0:05:11.85,0:05:14.73,Default,,0,0,0,,Неліктен бұл қарттар оны пайдаланады?
Dialogue: 0,0:05:14.81,0:05:17.56,Default,,0,0,0,,35 35
Dialogue: 0,0:05:17.65,0:05:20.65,Default,,0,0,0,,Жарғанаттағы алдыңғы бұрылыста аянышты оң жақ ұшады.
Dialogue: 0,0:05:20.73,0:05:22.61,Default,,0,0,0,,Бұл әзіл! Бұл әзіл!
Dialogue: 0,0:05:22.69,0:05:26.36,Default,,0,0,0,,Міне, бейсбол жанкүйерлері!
Dialogue: 0,0:05:26.74,0:05:29.37,Default,,0,0,0,,Жастарды оқытуға кедергі.
Dialogue: 0,0:05:29.45,0:05:31.91,Default,,0,0,0,,Ол биыл кететін шығар.
Dialogue: 0,0:05:31.99,0:05:34.37,Default,,0,0,0,,Мені алып кететін команда жоқ.
Dialogue: 0,0:05:34.46,0:05:36.96,Default,,0,0,0,,Сіз зейнетке шығып, күн көре аласыз ба?
Dialogue: 0,0:05:37.04,0:05:38.04,Default,,0,0,0,,Міне!
Dialogue: 0,0:05:38.13,0:05:41.80,Default,,0,0,0,,(Ерлердің күлкісі)
Dialogue: 0,0:05:41.88,0:05:43.76,Default,,0,0,0,,Мен енді шыдай алмаймын!
Dialogue: 0,0:05:44.42,0:05:47.18,Default,,0,0,0,,Сәлем! Сол әуесқой сыншылар!
Dialogue: 0,0:05:47.26,0:05:51.26,Default,,0,0,0,,Егер сіз жанкүйер болсаңыз, ойыншыдан жақсы нәрсе таба алмайсыз ба?
Dialogue: 0,0:05:51.64,0:05:52.72,Default,,0,0,0,,Иә!?
Dialogue: 0,0:05:53.27,0:05:56.77,Default,,0,0,0,,Егер сіз мені біраз уақыт тыңдасаңыз, сіз әрқашан қалағаныңызды айтасыз.
Dialogue: 0,0:05:56.85,0:05:57.98,Default,,0,0,0,,Конняро!
Dialogue: 0,0:05:58.06,0:06:02.23,Default,,0,0,0,,Не... Әпке, тіпті шындықты айттыңыз!
Dialogue: 0,0:06:02.32,0:06:03.32,Default,,0,0,0,,Хмм
Dialogue: 0,0:06:04.03,0:06:06.49,Default,,0,0,0,,Сонда да қол соғып, жігерлендірдім⸺
Dialogue: 0,0:06:06.57,0:06:09.28,Default,,0,0,0,,Сіз нағыз жанкүйер емессіз бе?
Dialogue: 0,0:06:09.66,0:06:11.28,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:06:11.58,0:06:15.37,Default,,0,0,0,,Сәлем! Ондағы сатушы да солай ойлайды, солай ма?
Dialogue: 0,0:06:16.25,0:06:20.04,Default,,0,0,0,,О, не? Мен бе?
Dialogue: 0,0:06:20.13,0:06:21.96,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:23.00,0:06:24.00,Default,,0,0,0,,Ах
Dialogue: 0,0:06:26.72,0:06:30.39,Default,,0,0,0,,Кодзирода wRC+120 бар
Dialogue: 0,0:06:30.64,0:06:33.51,Default,,0,0,0,,Иә? (Еркек) Ой... бұл не?
Dialogue: 0,0:06:33.89,0:06:36.81,Default,,0,0,0,,Дұрыс... хехе
Dialogue: 0,0:06:36.89,0:06:39.69,Default,,0,0,0,,Кодзиро әлі де көп нәрсе істей алады.
Dialogue: 0,0:06:39.77,0:06:41.56,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:06:41.65,0:06:42.65,Default,,0,0,0,,Ах
Dialogue: 0,0:06:44.86,0:06:46.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:46.11,0:06:48.74,Default,,0,0,0,,Кодзиро үш жүгіруді кері қайтарды!
Dialogue: 0,0:06:48.95,0:06:50.99,Default,,0,0,0,,(Лэйди тауы) Хмм? Не айтқың келеді?
Dialogue: 0,0:06:51.20,0:06:54.24,Default,,0,0,0,,Міне! (Еркек) Мен мұнда ұрайын ба?
Dialogue: 0,0:06:55.04,0:06:56.62,Default,,0,0,0,,Біз тез әрекет етуіміз керек
Dialogue: 0,0:06:56.70,0:06:59.25,Default,,0,0,0,,Кодзиро! (Еркектер) Кодзиро!
Dialogue: 0,0:06:59.33,0:07:03.59,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:07:06.80,0:07:08.72,Default,,0,0,0,,Бірдеңе дұрыс болмады.
Dialogue: 0,0:07:08.80,0:07:10.68,Default,,0,0,0,,Кешірім сұраймын, сізге тағы бір сусын сатып алуға рұқсат етіңіз.
Dialogue: 0,0:07:10.76,0:07:14.39,Default,,0,0,0,,Менің айтқым келгені бұл емес...
Dialogue: 0,0:07:14.47,0:07:15.93,Default,,0,0,0,,Мен де сатып аламын
Dialogue: 0,0:07:16.01,0:07:17.35,Default,,0,0,0,,Сосын мен де
Dialogue: 0,0:07:17.43,0:07:20.69,Default,,0,0,0,,Иә? Міне бітті!
Dialogue: 0,0:07:21.60,0:07:23.02,Default,,0,0,0,,Тіпті егер...
Dialogue: 0,0:07:23.65,0:07:25.44,Default,,0,0,0,,Жарайды, міне келдік.
Dialogue: 0,0:07:25.52,0:07:28.61,Default,,0,0,0,,Барлығы 200-ден астам үйге жүгірген ұлы ардагер
Dialogue: 0,0:07:28.69,0:07:32.03,Default,,0,0,0,,Қазіргі уақытта wRC+ 120
Dialogue: 0,0:07:33.74,0:07:37.70,Default,,0,0,0,,wRC+ дегеніміз не?
Dialogue: 0,0:07:44.33,0:07:46.00,Default,,0,0,0,,Сіз душқа түскіңіз келе ме?
Dialogue: 0,0:07:46.55,0:07:48.71,Default,,0,0,0,,Бос емес кезде кешіріңіз.
Dialogue: 0,0:07:49.76,0:07:54.85,Default,,0,0,0,,Иә, мен көрдім. Күтілгендей, wRC+ 120
Dialogue: 0,0:07:54.93,0:07:58.31,Default,,0,0,0,,Не? Мен шынымен түсінбеймін, бірақ бұл керемет болды
Dialogue: 0,0:07:58.39,0:07:59.56,Default,,0,0,0,,Уау
Dialogue: 0,0:07:59.64,0:08:02.90,Default,,0,0,0,,Еңбегіңізге рахмет, қайтып келгенде абай болыңыз.
Dialogue: 0,0:08:05.90,0:08:10.07,Default,,0,0,0,,Кодзиро шенеуніктердің орындарына соқпаса, ыңғайсыз болар еді⸺
Dialogue: 0,0:08:10.15,0:08:13.03,Default,,0,0,0,,Жалпы орындарға келгеніме біраз болды.
Dialogue: 0,0:08:20.20,0:08:23.21,Default,,0,0,0,,Кейде осындай нәрселер болады⸺
Dialogue: 0,0:08:23.29,0:08:24.96,Default,,0,0,0,,Менің ойымша, бұл жаман емес.
Dialogue: 0,0:08:29.17,0:08:31.80,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:33.97,0:08:37.55,Default,,0,0,0,,Ой, тамаша емес пе, Рурико, спорт газеті?
Dialogue: 0,0:08:38.10,0:08:41.23,Default,,0,0,0,,Ах, Накайзуми-сан, еңбегіңе рахмет.
Dialogue: 0,0:08:41.73,0:08:45.15,Default,,0,0,0,,Сатушы ретінде сіз бейсбол ойынын білуіңіз керек.
Dialogue: 0,0:08:45.23,0:08:47.27,Default,,0,0,0,,Сіз қызықты нәрсе ойлап таптыңыз ба?
Dialogue: 0,0:08:47.36,0:08:49.36,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:49.44,0:08:52.57,Default,,0,0,0,,Иә, бұл қызықты болды.
Dialogue: 0,0:09:09.04,0:09:12.13,Default,,0,0,0,,Ахахаха…
Dialogue: 0,0:09:12.21,0:09:15.22,Default,,0,0,0,,...Бұл төрт панельді комикс емес пе?
Dialogue: 0,0:09:15.43,0:09:19.76,Default,,0,0,0,,Уф... Бейсбол қиын.
Dialogue: 0,0:09:30.48,0:09:31.78,Default,,0,0,0,,Аға
Dialogue: 0,0:09:31.86,0:09:33.94,Default,,0,0,0,,Менің талқылайтын нәрсем бар.
Dialogue: 0,0:09:34.40,0:09:36.32,Default,,0,0,0,,Тұтынушыларды қабылдау⸺
Dialogue: 0,0:09:36.41,0:09:39.32,Default,,0,0,0,,Мен одан әлі құтыла алмаймын.
Dialogue: 0,0:09:39.41,0:09:40.70,Default,,0,0,0,,Байланыс ақпараты сұралса⸺
Dialogue: 0,0:09:40.78,0:09:42.74,Default,,0,0,0,,Қалдарыңыз қалай?
Dialogue: 0,0:09:43.08,0:09:44.45,Default,,0,0,0,,Мен түсіндім~
Dialogue: 0,0:09:44.54,0:09:46.71,Default,,0,0,0,,Мен де басында солай болдым.
Dialogue: 0,0:09:46.79,0:09:49.67,Default,,0,0,0,,Мен қазір күліп, қашып жүрген шығармын.
Dialogue: 0,0:09:49.75,0:09:51.63,Default,,0,0,0,,Байланыс деректерінің орнына⸺
Dialogue: 0,0:09:51.71,0:09:54.01,Default,,0,0,0,,Ninsta есептік жазбаңызды айтыңыз.
Dialogue: 0,0:09:54.30,0:09:56.17,Default,,0,0,0,,Жазылушылар санын көбейтуге болады.
Dialogue: 0,0:09:56.26,0:09:57.93,Default,,0,0,0,,Сәлем? Кохината-сан
Dialogue: 0,0:09:58.01,0:10:01.05,Default,,0,0,0,,Иә, бірақ Ninsta⸺
Dialogue: 0,0:10:01.14,0:10:02.22,Default,,0,0,0,,Жазылушылар санын есептеңіз⸺
Dialogue: 0,0:10:02.31,0:10:04.93,Default,,0,0,0,,Бұл тек ұлғайту туралы емес ...
Dialogue: 0,0:10:06.02,0:10:09.81,Default,,0,0,0,,Кейде мынандай үлкен тостаған күріш салғанда⸺
Dialogue: 0,0:10:10.27,0:10:12.19,Default,,0,0,0,,Маған еретін тұрақты адамдармен⸺
Dialogue: 0,0:10:12.27,0:10:14.48,Default,,0,0,0,,Бұл тамаша әңгіме тақырыбы.
Dialogue: 0,0:10:14.94,0:10:17.11,Default,,0,0,0,,Сіз сол дүкенге бардыңыз.
Dialogue: 0,0:10:17.20,0:10:19.70,Default,,0,0,0,,Бұл жерде өте дәмді.
Dialogue: 0,0:10:19.78,0:10:21.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:21.41,0:10:22.53,Default,,0,0,0,,Pro!
Dialogue: 0,0:10:22.62,0:10:24.33,Default,,0,0,0,,Күтілгендей, Кохината-сан
Dialogue: 0,0:10:24.41,0:10:26.75,Default,,0,0,0,,Мен сізді құрметтеймін.
Dialogue: 0,0:10:26.83,0:10:29.50,Default,,0,0,0,,Барлығын алып кетті немесе бірдеңе.
Dialogue: 0,0:10:29.58,0:10:31.21,Default,,0,0,0,,Айтайын дегенім, Аона-сан.
Dialogue: 0,0:10:31.29,0:10:34.55,Default,,0,0,0,,Чеккерден Оматсу мырзамен кездесе бастадыңыз ба?
Dialogue: 0,0:10:34.63,0:10:37.26,Default,,0,0,0,,А, мен де солай ойладым.
Dialogue: 0,0:10:37.34,0:10:39.05,Default,,0,0,0,,Хехехе біліп қалды ма?
Dialogue: 0,0:10:39.13,0:10:42.18,Default,,0,0,0,,Ақыры, күтуден шаршадым.
Dialogue: 0,0:10:42.26,0:10:44.31,Default,,0,0,0,,О, құттықтаймын
Dialogue: 0,0:10:44.64,0:10:47.10,Default,,0,0,0,,Көпшіліктің алдында көп сырласу жақсы емес.
Dialogue: 0,0:10:47.18,0:10:49.69,Default,,0,0,0,,Мен алмаймын.
Dialogue: 0,0:10:50.10,0:10:52.44,Default,,0,0,0,,Адамдарды жинау... Орындалмады.
Dialogue: 0,0:10:52.65,0:10:53.65,Default,,0,0,0,,Ах
Dialogue: 0,0:10:54.57,0:10:57.78,Default,,0,0,0,,Руриконың тұрақты тұтынушылары болмады ма?
Dialogue: 0,0:10:57.86,0:10:58.99,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:10:59.32,0:11:00.32,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:01.24,0:11:02.91,Default,,0,0,0,,Хмм?
Dialogue: 0,0:11:03.12,0:11:07.37,Default,,0,0,0,,Қыздарды жинау... Мені де кеше алып кетті.
Dialogue: 0,0:11:07.95,0:11:12.25,Default,,0,0,0,,Қолдау формасы әр адамда әртүрлі.
Dialogue: 0,0:11:12.50,0:11:16.25,Default,,0,0,0,,Мен шынымен де қиналып жатырмын, солай емес пе?
Dialogue: 0,0:11:16.63,0:11:19.80,Default,,0,0,0,,Олай болса, Руриконы да пайдалану керек.
Dialogue: 0,0:11:19.88,0:11:21.84,Default,,0,0,0,,Мүмкін мен де солай істеуім керек шығар.
Dialogue: 0,0:11:21.93,0:11:24.35,Default,,0,0,0,,Иә? Ninsta…
Dialogue: 0,0:11:24.43,0:11:25.72,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:11:25.93,0:11:28.48,Default,,0,0,0,,Рурико, кейінірек егжей-тегжейлі айтып беріңізші
Dialogue: 0,0:11:28.56,0:11:30.69,Default,,0,0,0,,Сонда мен үшін де солай.
Dialogue: 0,0:11:30.77,0:11:32.98,Default,,0,0,0,,Маған да хабарлаңыз.
Dialogue: 0,0:11:33.19,0:11:35.11,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:35.19,0:11:38.28,Default,,0,0,0,,А, алдымен кездесуге бара аласыз ба?
Dialogue: 0,0:11:38.36,0:11:39.61,Default,,0,0,0,,Мен бірден барамын
Dialogue: 0,0:11:39.86,0:11:41.28,Default,,0,0,0,,Мұндай жағдай болса деп, астымда бронежилет киіп жүрмін.
Dialogue: 0,0:11:42.57,0:11:46.95,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:11:47.04,0:11:48.04,Default,,0,0,0,,Хмм
Dialogue: 0,0:11:48.37,0:11:53.46,Default,,0,0,0,,Хмм, Нистаны қалай жасайсыз?
Dialogue: 0,0:11:53.54,0:11:56.59,Default,,0,0,0,,Мен мұндай нәрсеге жақсы емеспін!
Dialogue: 0,0:11:57.34,0:12:00.05,Default,,0,0,0,,(Әйел) Жолдасым! Арбадағы әйел өліп қалды, бірақ➡
Dialogue: 0,0:12:00.34,0:12:03.01,Default,,0,0,0,,Ах! Мүмкін емес!
Dialogue: 0,0:12:04.51,0:12:07.97,Default,,0,0,0,,Иә, жиналысты бастайық.
Dialogue: 0,0:12:08.52,0:12:11.94,Default,,0,0,0,,Менің ойымша, оны әркім анда-санда естіген⸺
Dialogue: 0,0:12:12.19,0:12:17.90,Default,,0,0,0,,Соңғы уақытта Triple Three-тен алып кететін тұтынушылар көп болды!
Dialogue: 0,0:12:18.11,0:12:20.65,Default,,0,0,0,,Тек растау үшін⸺
Dialogue: 0,0:12:20.74,0:12:24.61,Default,,0,0,0,,Тұтынушыларға ешқашан жеке ақпаратты бермеңіз.
Dialogue: 0,0:12:25.24,0:12:27.41,Default,,0,0,0,,Іздеу мүмкіндігі нөлге тең емес.
Dialogue: 0,0:12:27.41,0:12:28.74,Default,,0,0,0,,Іздеу мүмкіндігі нөлге тең емес.
Dialogue: 0,0:12:27.41,0:12:28.74,Default,,0,0,0,,Хехе
Dialogue: 0,0:12:28.74,0:12:29.49,Default,,0,0,0,,Іздеу мүмкіндігі нөлге тең емес.
Dialogue: 0,0:12:29.58,0:12:29.95,Default,,0,0,0,,Тіпті біз дойбылар да патрульдерді күшейтеміз⸺
Dialogue: 0,0:12:29.95,0:12:30.95,Default,,0,0,0,,Тіпті біз дойбылар да патрульдерді күшейтеміз⸺
Dialogue: 0,0:12:29.95,0:12:30.95,Default,,0,0,0,,Хмм
Dialogue: 0,0:12:30.95,0:12:33.62,Default,,0,0,0,,Тіпті біз дойбылар да патрульдерді күшейтеміз⸺
Dialogue: 0,0:12:33.71,0:12:37.92,Default,,0,0,0,,Тұтынушылармен қарым-қатынаста қалыпты болыңыз.
Dialogue: 0,0:12:38.00,0:12:41.34,Default,,0,0,0,,Иә? Сіз дұрыс тыңдайсыз ба? Рурико!
Dialogue: 0,0:12:41.55,0:12:43.51,Default,,0,0,0,,Ааа... ой!
Dialogue: 0,0:12:43.59,0:12:46.76,Default,,0,0,0,,Жеке ақпарат Жоқ, жоқ!
Dialogue: 0,0:12:47.55,0:12:52.18,Default,,0,0,0,,Боқ~ Тіркелуді мүлде түсінбеймін!
Dialogue: 0,0:12:52.27,0:12:54.77,Default,,0,0,0,,Нинста~!
Dialogue: 0,0:12:55.52,0:13:00.48,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:13:00.73,0:13:02.94,Default,,0,0,0,,Стадион күткендей ең жақсысы!
Dialogue: 0,0:13:03.03,0:13:04.99,Default,,0,0,0,,Тек жұмыс!
Dialogue: 0,0:13:05.07,0:13:08.03,Default,,0,0,0,,Бүгін қай сатушыға баруым керек?
Dialogue: 0,0:13:08.12,0:13:09.49,Default,,0,0,0,,Мен қатты толқып тұрмын!
Dialogue: 0,0:13:09.58,0:13:13.04,Default,,0,0,0,,(Мұрттардың дыбыстары)
Dialogue: 0,0:13:13.12,0:13:16.79,Default,,0,0,0,,Yabasa Triple Three... Осымен бітті.
Dialogue: 0,0:13:18.00,0:13:21.00,Default,,0,0,0,,Эй, ана жақтағы сатушы, міне.
Dialogue: 0,0:13:21.09,0:13:22.63,Default,,0,0,0,,Маған сыра беріңізші.
Dialogue: 0,0:13:22.71,0:13:24.09,Default,,0,0,0,,Үш.
Dialogue: 0,0:13:24.30,0:13:25.34,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:25.43,0:13:28.18,Default,,0,0,0,,2100 иенге 3 сыра
Dialogue: 0,0:13:28.89,0:13:31.93,Default,,0,0,0,,Сен өте әдемісің~ Сенің атың кім?
Dialogue: 0,0:13:32.02,0:13:34.10,Default,,0,0,0,,Иә? Рурико-чан?
Dialogue: 0,0:13:34.18,0:13:35.69,Default,,0,0,0,,Эй, сен нешедесің?
Dialogue: 0,0:13:35.77,0:13:37.52,Default,,0,0,0,,Кино түсірейік
Dialogue: 0,0:13:37.98,0:13:38.98,Default,,0,0,0,,Хмм
Dialogue: 0,0:13:39.31,0:13:42.53,Default,,0,0,0,,Жеке мәліметтерге тыйым салынады.
Dialogue: 0,0:13:42.73,0:13:46.78,Default,,0,0,0,,Эй Рурико-чан, телефон нөміріңді айтшы.
Dialogue: 0,0:13:47.24,0:13:50.45,Default,,0,0,0,,Кешіріңіз, бұл оқыту ережелеріне қайшы.
Dialogue: 0,0:13:50.53,0:13:52.74,Default,,0,0,0,,Жақсы емес
Dialogue: 0,0:13:53.12,0:13:56.50,Default,,0,0,0,,Сонымен, үй қайда? Келесіде барып ішейік
Dialogue: 0,0:13:56.92,0:13:58.58,Default,,0,0,0,,Токиода
Dialogue: 0,0:13:58.67,0:14:00.46,Default,,0,0,0,,Жақсы емес
Dialogue: 0,0:14:00.84,0:14:03.59,Default,,0,0,0,,Сіз әдетте не істейсіз? университет студенті?
Dialogue: 0,0:14:04.13,0:14:06.05,Default,,0,0,0,,Ол неге ұқсайды?
Dialogue: 0,0:14:06.13,0:14:07.80,Default,,0,0,0,,Жақсы емес
Dialogue: 0,0:14:07.97,0:14:10.30,Default,,0,0,0,,Ши... қатты, солай емес пе?
Dialogue: 0,0:14:10.39,0:14:12.76,Default,,0,0,0,,Сіздің іні-қарындасыңыз бар ма?
Dialogue: 0,0:14:13.10,0:14:18.23,Default,,0,0,0,,Ініңіз бар сияқты... әлде сіңліңіз бар сияқты ма?
Dialogue: 0,0:14:18.48,0:14:20.27,Default,,0,0,0,,Жақсы емес
Dialogue: 0,0:14:20.44,0:14:23.78,Default,,0,0,0,,Мұқият болудың қажеті жоқ.
Dialogue: 0,0:14:23.86,0:14:25.36,Default,,0,0,0,,Сіздің жігітіңіз бар ма, әлде бір нәрсе бар ма?
Dialogue: 0,0:14:25.69,0:14:29.24,Default,,0,0,0,,Мен өмір бойы оңаша өмір сүремін
Dialogue: 0,0:14:29.32,0:14:30.99,Default,,0,0,0,,Жоқ, жоқ!
Dialogue: 0,0:14:31.32,0:14:35.20,Default,,0,0,0,,Өмір бойы жалғыз жүретін отбасылар бар, солай емес пе?
Dialogue: 0,0:14:35.62,0:14:39.25,Default,,0,0,0,,А... Мен кеше атаңа телефон соқтым.
Dialogue: 0,0:14:39.33,0:14:41.29,Default,,0,0,0,,Хидеаки 65 жаста
Dialogue: 0,0:14:41.38,0:14:43.71,Default,,0,0,0,,Мен мұны сізге айтуға қарсы емеспін.
Dialogue: 0,0:14:44.42,0:14:46.92,Default,,0,0,0,,Кенеттен бұл ғана маңызды нәрсе
Dialogue: 0,0:14:48.59,0:14:52.68,Default,,0,0,0,,Рурико туралы ақпарат тек Хидеаки ата...
Dialogue: 0,0:14:52.76,0:14:55.06,Default,,0,0,0,,Иә, иә, жеткілікті.
Dialogue: 0,0:14:55.14,0:14:58.52,Default,,0,0,0,,Онда маған Нинста туралы айт. Тек Нинста.
Dialogue: 0,0:14:58.73,0:15:00.85,Default,,0,0,0,,Ха... Нинста!
Dialogue: 0,0:15:01.77,0:15:04.32,Default,,0,0,0,,Тоғыз... жұлдыз... (3 адам) Иә?
Dialogue: 0,0:15:04.40,0:15:07.19,Default,,0,0,0,,Нин... Нинста!
Dialogue: 0,0:15:07.44,0:15:10.86,Default,,0,0,0,,Мен қалай тіркелу керектігін білмеймін.
Dialogue: 0,0:15:10.95,0:15:16.08,Default,,0,0,0,,Мен сізді №1 ізбасар етемін, сондықтан маған Ninsta жасауды үйретіңіз!
Dialogue: 0,0:15:16.16,0:15:17.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:17.91,0:15:20.42,Default,,0,0,0,,Иә, қарсы емеспін.
Dialogue: 0,0:15:20.50,0:15:23.13,Default,,0,0,0,,Алдымен қолданбаны жүктеп алыңыз⸺
Dialogue: 0,0:15:23.21,0:15:27.09,Default,,0,0,0,,Нөміріңізді немесе мекенжайыңызды енгізгеннен кейін растау кодын енгізіңіз.
Dialogue: 0,0:15:27.17,0:15:29.34,Default,,0,0,0,,Сондықтан мен түсінбеймін!
Dialogue: 0,0:15:29.42,0:15:31.43,Default,,0,0,0,,Міне!? А... бұл жаман.
Dialogue: 0,0:15:31.51,0:15:34.18,Default,,0,0,0,,Ах, аутентификация коды...
Dialogue: 0,0:15:34.89,0:15:38.02,Default,,0,0,0,,Қызықты балалар да болды.
Dialogue: 0,0:15:38.10,0:15:39.56,Default,,0,0,0,,Фофофофо
Dialogue: 0,0:15:39.64,0:15:43.56,Default,,0,0,0,,Бейсбол стадионы - сіз ешқашан жалықпайтын орын.
Dialogue: 0,0:15:46.52,0:15:48.99,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:49.19,0:15:51.95,Default,,0,0,0,,Ninsta-ны қалай жасау керектігін айтыңызшы!
Dialogue: 0,0:15:53.82,0:15:54.95,Default,,0,0,0,,Шуылдады
Dialogue: 0,0:15:55.53,0:15:58.12,Default,,0,0,0,,Хэхе, Нинста, Нинста~
Dialogue: 0,0:15:58.20,0:15:59.62,Default,,0,0,0,,Хаха~
Dialogue: 0,0:16:00.37,0:16:02.96,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:16:03.04,0:16:06.84,Default,,0,0,0,,Екі жыл бұрын мен орта мектептің үшінші курсында оқып жүрген кезімде⸺
Dialogue: 0,0:16:06.92,0:16:11.63,Default,,0,0,0,,Бейсбол стадионында менің досым мені Нацуно Ямадаға апарды⸺
Dialogue: 0,0:16:12.22,0:16:14.80,Default,,0,0,0,,Мен сыра сатушысына жабысып қалдым.
Dialogue: 0,0:16:14.89,0:16:16.47,Default,,0,0,0,,～
Dialogue: 0,0:16:17.06,0:16:20.48,Default,,0,0,0,,Басыңда гүл, жарқыраған күлімсіреп
Dialogue: 0,0:16:21.06,0:16:23.48,Default,,0,0,0,,Және сүйкімді формалар
Dialogue: 0,0:16:23.77,0:16:28.73,Default,,0,0,0,,Ол фигура маған кумирдей көрінді.
Dialogue: 0,0:16:31.99,0:16:33.57,Default,,0,0,0,,Қош келдіңіз~
Dialogue: 0,0:16:33.66,0:16:36.41,Default,,0,0,0,,1 Макунучи бенто
Dialogue: 0,0:16:36.66,0:16:39.16,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:16:39.54,0:16:42.08,Default,,0,0,0,,Бірақ мен неге қазір⸺
Dialogue: 0,0:16:42.16,0:16:47.13,Default,,0,0,0,,Менің ойымша, ол басына гүлдердің орнына итарқа тағып, түскі ас қораптарын сатады.
Dialogue: 0,0:16:48.04,0:16:50.71,Default,,0,0,0,,«Balpark толық емес жұмыс күнін» іздеңіз және өтініш беріңіз⸺
Dialogue: 0,0:16:50.80,0:16:53.01,Default,,0,0,0,,Мен мұны білмей тұрып, осында болдым ...
Dialogue: 0,0:16:53.09,0:16:54.97,Default,,0,0,0,,Жарайды, ертең сұраймын.
Dialogue: 0,0:16:55.05,0:16:56.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:56.43,0:17:00.56,Default,,0,0,0,,Ха... Қайдан, қалай қателестім деп ойлаймын.
Dialogue: 0,0:17:00.64,0:17:02.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:02.64,0:17:03.77,Default,,0,0,0,,Фу…
Dialogue: 0,0:17:05.31,0:17:07.19,Default,,0,0,0,,Сатушы
Dialogue: 0,0:17:07.90,0:17:11.40,Default,,0,0,0,,Мен бұл көйлекті кигім келеді.
Dialogue: 0,0:17:12.28,0:17:15.78,Default,,0,0,0,,Мен... Мен де аяғымды шығарғым келеді~
Dialogue: 0,0:17:15.86,0:17:20.91,Default,,0,0,0,,Мен де, мен де сенімдімін~
Dialogue: 0,0:17:21.87,0:17:25.04,Default,,0,0,0,,Аа, мен неге мұндамын...
Dialogue: 0,0:17:25.12,0:17:27.92,Default,,0,0,0,,Умм… 1 мега ультра бенто
Dialogue: 0,0:17:28.00,0:17:29.00,Default,,0,0,0,,Га
Dialogue: 0,0:17:29.09,0:17:32.67,Default,,0,0,0,,Сізге көп рахмет! Мега бөлік!
Dialogue: 0,0:17:32.92,0:17:36.13,Default,,0,0,0,,Аа, мен неге...
Dialogue: 0,0:17:36.22,0:17:37.55,Default,,0,0,0,,Мен пісірілген ішімдікті аламын.
Dialogue: 0,0:17:37.64,0:17:38.64,Default,,0,0,0,,Га
Dialogue: 0,0:17:38.72,0:17:41.35,Default,,0,0,0,,Бір тостаған пісірілген ішімдік, сізді күттіргенім үшін кешіріңіз!
Dialogue: 0,0:17:41.93,0:17:44.85,Default,,0,0,0,,Ах! Мен неге...
Dialogue: 0,0:17:44.93,0:17:47.23,Default,,0,0,0,,Маған бір теңіз балдыры клапанын беріңізші (Нацуно) хаха
Dialogue: 0,0:17:47.31,0:17:49.36,Default,,0,0,0,,Жарайсыңдар! Бір Норибен!
Dialogue: 0,0:17:49.44,0:17:52.03,Default,,0,0,0,,Басқа таяқшалар жинағын қосу уақыты келді!
Dialogue: 0,0:17:52.69,0:17:56.65,Default,,0,0,0,,Жарайды... Мен саған 300 иен беремін.
Dialogue: 0,0:17:57.61,0:18:01.41,Default,,0,0,0,,Нацуно Ямаданың аяқтары осылай әдемі (өзін-өзі жариялады)⸺
Dialogue: 0,0:18:01.49,0:18:05.71,Default,,0,0,0,,Ешкім байқамай екі жыл өтті.
Dialogue: 0,0:18:06.66,0:18:08.04,Default,,0,0,0,,Яй Мада-чан
Dialogue: 0,0:18:08.12,0:18:09.42,Default,,0,0,0,,Ә… Мен келдім бе…
Dialogue: 0,0:18:09.50,0:18:11.42,Default,,0,0,0,,Қуырылған тауық етін жеуге бола ма?
Dialogue: 0,0:18:11.50,0:18:13.67,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:18:13.76,0:18:16.38,Default,,0,0,0,,Эй, сен бүгін көп түскі ас қораптарын саттың.
Dialogue: 0,0:18:16.47,0:18:19.84,Default,,0,0,0,,Сіздердің арқаларыңызда мен бір нүктеге жеттім.
Dialogue: 0,0:18:20.43,0:18:24.68,Default,,0,0,0,,5-ші иннингте есепті теңестіргеннен кейін, тұтынушылардың саны таң қалдырды.
Dialogue: 0,0:18:24.77,0:18:27.10,Default,,0,0,0,,Шишио бүгінде үлкен хит болды.
Dialogue: 0,0:18:27.19,0:18:29.06,Default,,0,0,0,,3 Қатты соққы жүлдесі үшін RBI
Dialogue: 0,0:18:29.27,0:18:32.02,Default,,0,0,0,,Сізді күткеніңіз үшін рахмет (Ер адам)
Dialogue: 0,0:18:32.36,0:18:34.36,Default,,0,0,0,,Тағы да сәттілік
Dialogue: 0,0:18:34.44,0:18:37.82,Default,,0,0,0,,Сәлем~ Тағы да рахмет.
Dialogue: 0,0:18:38.40,0:18:39.99,Default,,0,0,0,,Ямада (Нацуно) Ах.
Dialogue: 0,0:18:40.20,0:18:41.74,Default,,0,0,0,,Ах, менеджер.
Dialogue: 0,0:18:41.83,0:18:45.33,Default,,0,0,0,,Өзіңізді жақсы сезінбейсіз бе? Сенімен бәрі жақсы ма?
Dialogue: 0,0:18:45.54,0:18:48.71,Default,,0,0,0,,Жоқ, олай емес деп ойлаймын.
Dialogue: 0,0:18:48.96,0:18:52.17,Default,,0,0,0,,Хм... Біраз ойланып қалдым⸺
Dialogue: 0,0:18:52.25,0:18:56.42,Default,,0,0,0,,Менің ойымша, келісімшартты жаңарту тек ойыншыларға ғана қатысты емес.
Dialogue: 0,0:18:56.92,0:18:58.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:58.51,0:19:00.80,Default,,0,0,0,,Ямаданың сағаттық жалақысы 100 иенге өсті!
Dialogue: 0,0:19:01.05,0:19:02.35,Default,,0,0,0,,(Нанами) Болмайды. Мен саған бүгін таңертең неге екенін айттым ғой, иә?
Dialogue: 0,0:19:04.97,0:19:08.31,Default,,0,0,0,,Ах... Рахмет.
Dialogue: 0,0:19:08.60,0:19:12.56,Default,,0,0,0,,Сәлем! Мен өсіремін!
Dialogue: 0,0:19:12.98,0:19:17.15,Default,,0,0,0,,Ямада әрқашан жігерлі жұмыс істейтіні сонша, мен бақыттымын.
Dialogue: 0,0:19:17.24,0:19:19.74,Default,,0,0,0,,Менің еңбекшім!
Dialogue: 0,0:19:19.95,0:19:21.49,Default,,0,0,0,,Менің ақымақ!
Dialogue: 0,0:19:21.57,0:19:22.99,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:19:23.28,0:19:24.95,Default,,0,0,0,,Ум (Нацуно) Иә?
Dialogue: 0,0:19:25.79,0:19:27.70,Default,,0,0,0,,Қош келдіңіз~
Dialogue: 0,0:19:27.95,0:19:30.16,Default,,0,0,0,,Қуырылған тауық еті әлі бар ма?
Dialogue: 0,0:19:30.67,0:19:34.17,Default,,0,0,0,,Иә... Бір кесек қуырылған тауық еті
Dialogue: 0,0:19:34.59,0:19:36.84,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:19:37.30,0:19:39.13,Default,,0,0,0,,Мм... (Нацуно) Иә?
Dialogue: 0,0:19:39.42,0:19:43.09,Default,,0,0,0,,Бозарып кеткен сияқтысың, жақсысың ба?
Dialogue: 0,0:19:43.60,0:19:44.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:44.68,0:19:47.93,Default,,0,0,0,,А... а, жоқ... бұл ештеңе емес.
Dialogue: 0,0:19:48.02,0:19:49.77,Default,,0,0,0,,Сонымен… онда
Dialogue: 0,0:19:53.44,0:19:56.36,Default,,0,0,0,,Мен...Тамақ бергеніңізге рахмет.
Dialogue: 0,0:19:56.98,0:19:58.40,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:59.69,0:20:03.78,Default,,0,0,0,,Ол дәл қазір ханзадаға ұқсамады ма?
Dialogue: 0,0:20:03.87,0:20:06.91,Default,,0,0,0,,Жүрегіңізге де рахмет.
Dialogue: 0,0:20:07.24,0:20:11.16,Default,,0,0,0,,Ха... жоқ жоқ, мен не ойладым?
Dialogue: 0,0:20:11.25,0:20:13.29,Default,,0,0,0,,Сонда ше?
Dialogue: 0,0:20:13.83,0:20:15.63,Default,,0,0,0,,Ямада (Нацуно) Ах.
Dialogue: 0,0:20:15.71,0:20:18.92,Default,,0,0,0,,Сіз шынымен жақсысыз ба? Сенімен бәрі жақсы ма?
Dialogue: 0,0:20:19.30,0:20:23.76,Default,,0,0,0,,Аа... Бүгін тұтынушылар көп болды, сондықтан ыстық болдым.
Dialogue: 0,0:20:24.18,0:20:26.85,Default,,0,0,0,,Хм... Мен бұл туралы ойладым⸺
Dialogue: 0,0:20:26.93,0:20:28.72,Default,,0,0,0,,Кез келген жұмыс бейсбол сияқты⸺
Dialogue: 0,0:20:28.81,0:20:31.98,Default,,0,0,0,,Менің ойымша, сізге лайықты орын бар.
Dialogue: 0,0:20:32.52,0:20:33.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:34.15,0:20:37.23,Default,,0,0,0,,Мен Ямададан толық емес жетекші ретінде кетуді ойлаймын!
Dialogue: 0,0:20:37.44,0:20:38.44,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:20:41.40,0:20:43.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:43.61,0:20:47.83,Default,,0,0,0,,Ахх! Мен жоғарылап жатырмын!
Dialogue: 0,0:20:49.49,0:20:53.21,Default,,0,0,0,,Бұл дүкенде Ямаданың болғаны сенімді.
Dialogue: 0,0:20:53.54,0:20:56.71,Default,,0,0,0,,Хаха... Жақсы.
Dialogue: 0,0:21:01.17,0:21:03.34,Default,,0,0,0,,Жақсы кадрлар
Dialogue: 0,0:21:03.42,0:21:05.76,Default,,0,0,0,,Бүгін барлығы көп ішіп отырды.
Dialogue: 0,0:21:05.84,0:21:08.22,Default,,0,0,0,,Иә, 1-ші негіз жағы да, 3-ші табан жағы да⸺
Dialogue: 0,0:21:08.30,0:21:10.68,Default,,0,0,0,,Топтар көп болған сияқты.
Dialogue: 0,0:21:10.93,0:21:12.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:16.77,0:21:19.40,Default,,0,0,0,,Слинг және ұзын шалбар
Dialogue: 0,0:21:19.94,0:21:23.70,Default,,0,0,0,,Бұл менің колледждегі өмірім бе?
Dialogue: 0,0:21:23.78,0:21:26.20,Default,,0,0,0,,А, әпке (Нацуно)?
Dialogue: 0,0:21:26.45,0:21:29.33,Default,,0,0,0,,Мен әпкемнің түскі асын түгел жедім.
Dialogue: 0,0:21:29.41,0:21:30.83,Default,,0,0,0,,Мен тағы келемін~
Dialogue: 0,0:21:30.91,0:21:34.04,Default,,0,0,0,,Ах... иә!
Dialogue: 0,0:21:35.92,0:21:38.13,Default,,0,0,0,,«Мен қайтамын»?
Dialogue: 0,0:21:45.63,0:21:49.93,Default,,0,0,0,,Менің басымда гүл жоқ, тіпті аяғымды да шығара алмаймын⸺
Dialogue: 0,0:21:50.51,0:21:52.72,Default,,0,0,0,,Мен сәл ұзағырақ жалғастыруым керек пе?
Dialogue: 0,0:21:53.35,0:21:54.89,Default,,0,0,0,,Ямада! (Нацуно) Ах
Dialogue: 0,0:21:55.69,0:21:59.11,Default,,0,0,0,,Біз келесі жылдан бастап жаңа түлектерді жұмысқа аламыз. Сіз қалай ойлайсыз?
Dialogue: 0,0:21:59.36,0:22:03.28,Default,,0,0,0,,А... иә, жоқ, у...
Dialogue: 0,0:22:03.48,0:22:06.74,Default,,0,0,0,,Ал... Ойланып көрейін!
Dialogue: 0,0:22:15.33,0:22:20.33,Default,,0,0,0,,♪～
Dialogue: 0,0:23:39.87,0:23:44.88,Default,,0,0,0,,～♪
