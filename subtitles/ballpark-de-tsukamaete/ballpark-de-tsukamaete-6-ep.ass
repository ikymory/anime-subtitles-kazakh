Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.00,0:00:06.00,Default,,0,0,0,,♪～
Dialogue: 0,0:01:22.08,0:01:27.08,Default,,0,0,0,,～♪
Dialogue: 0,0:01:34.05,0:01:36.84,Default,,0,0,0,,(Сара ызылдап)
Dialogue: 0,0:01:37.30,0:01:40.05,Default,,0,0,0,,Сара Сен де бүгін көңілді жүрген сияқтысың~
Dialogue: 0,0:01:40.14,0:01:44.23,Default,,0,0,0,,Өйткені бұл форма өте сүйкімді.
Dialogue: 0,0:01:45.23,0:01:48.02,Default,,0,0,0,,Сара мәңгілік кінәсіз
Dialogue: 0,0:01:48.10,0:01:50.40,Default,,0,0,0,,Мен мұны бір жылдан бері істеп келемін.
Dialogue: 0,0:01:50.86,0:01:52.23,Default,,0,0,0,,Тору~!
Dialogue: 0,0:01:52.73,0:01:54.69,Default,,0,0,0,,Иә? Ол кім?
Dialogue: 0,0:01:57.07,0:02:00.53,Default,,0,0,0,,Иә! Бүгін келесің бе?
Dialogue: 0,0:02:05.37,0:02:07.83,Default,,0,0,0,,Сыра алғыңыз келе ме?
Dialogue: 0,0:02:07.92,0:02:11.75,Default,,0,0,0,,Салқын сыра алғыңыз келе ме?
Dialogue: 0,0:02:11.84,0:02:16.34,Default,,0,0,0,,Сара-чан осы стадиондағы жалғыз орта мектеп сатушысы.
Dialogue: 0,0:02:16.72,0:02:19.05,Default,,0,0,0,,Маған сыра берші.
Dialogue: 0,0:02:19.13,0:02:21.47,Default,,0,0,0,,Аа, көп рахмет.
Dialogue: 0,0:02:21.72,0:02:23.85,Default,,0,0,0,,Юухи сыра сатушысы
Dialogue: 0,0:02:23.93,0:02:26.18,Default,,0,0,0,,Иә! Дәл қазір!
Dialogue: 0,0:02:27.14,0:02:28.64,Default,,0,0,0,,Кохинатачан
Dialogue: 0,0:02:28.85,0:02:29.94,Default,,0,0,0,,Хмм
Dialogue: 0,0:02:30.35,0:02:32.86,Default,,0,0,0,,Әдеттегідей рахмет
Dialogue: 0,0:02:32.94,0:02:34.69,Default,,0,0,0,,Бүгін де ыстық.
Dialogue: 0,0:02:34.78,0:02:36.65,Default,,0,0,0,,Кохината жақсы ма?
Dialogue: 0,0:02:36.74,0:02:40.53,Default,,0,0,0,,Иә, мен міндетті түрде су ішіп, үзіліс жасаймын.
Dialogue: 0,0:02:41.28,0:02:45.70,Default,,0,0,0,,Менің атымды атайтындар көп емес.
Dialogue: 0,0:02:45.79,0:02:47.12,Default,,0,0,0,,Рахмет
Dialogue: 0,0:02:47.20,0:02:49.46,Default,,0,0,0,,Сара-чан, міне, міне!
Dialogue: 0,0:02:49.54,0:02:50.54,Default,,0,0,0,,Хмм
Dialogue: 0,0:02:51.50,0:02:52.92,Default,,0,0,0,,Ух... мында.
Dialogue: 0,0:02:53.00,0:02:57.01,Default,,0,0,0,,Сіздің атыңызды шақыратын тұтынушылар аз
Dialogue: 0,0:02:57.30,0:02:58.76,Default,,0,0,0,,Сара-чан
Dialogue: 0,0:02:58.84,0:03:00.01,Default,,0,0,0,,Маңызы бар деп саналатын бір куәгерлік көрсету бар
Dialogue: 0,0:03:00.97,0:03:04.76,Default,,0,0,0,,Сен де келме, әке-шеше.
Dialogue: 0,0:03:04.97,0:03:07.02,Default,,0,0,0,,Маған солай қарама.
Dialogue: 0,0:03:07.10,0:03:09.81,Default,,0,0,0,,Бүгін әкем екеуміз тұтынушыларымыз.
Dialogue: 0,0:03:09.89,0:03:12.56,Default,,0,0,0,,Сол форма сізге жарасады ғой.
Dialogue: 0,0:03:12.65,0:03:16.15,Default,,0,0,0,,Бұл ұят, сондықтан қатты дыбыс шығармаңыз.
Dialogue: 0,0:03:16.40,0:03:18.82,Default,,0,0,0,,Қараңыз, Сара-чан фотосуреті
Dialogue: 0,0:03:18.90,0:03:22.20,Default,,0,0,0,,Жұмыс кезінде фотосуреттер жоқ дедіңіз.
Dialogue: 0,0:03:22.28,0:03:23.99,Default,,0,0,0,,Иә Сыр
Dialogue: 0,0:03:24.07,0:03:25.74,Default,,0,0,0,,Сондай-ақ...
Dialogue: 0,0:03:25.83,0:03:28.54,Default,,0,0,0,,Сара жақсы қыз.
Dialogue: 0,0:03:28.75,0:03:33.08,Default,,0,0,0,,Сара стадиондағы сатушылар арасында бірінші орында.
Dialogue: 0,0:03:28.75,0:03:33.08,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:03:33.08,0:03:33.17,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:03:33.17,0:03:34.17,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:03:33.17,0:03:34.17,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:03:34.38,0:03:36.88,Default,,0,0,0,,Иә? Бұл дұрыс емес.
Dialogue: 0,0:03:37.34,0:03:39.80,Default,,0,0,0,,Сыра алғыңыз келе ме?
Dialogue: 0,0:03:39.88,0:03:42.38,Default,,0,0,0,,Кохината-сан өте әдемі⸺
Dialogue: 0,0:03:42.47,0:03:46.14,Default,,0,0,0,,Бұл бір күнде 400 кесе сатқан біздің үлкен эйсіміз.
Dialogue: 0,0:03:46.47,0:03:48.93,Default,,0,0,0,,Аона университетте мұғалім болуды мақсат етеді⸺
Dialogue: 0,0:03:49.02,0:03:51.48,Default,,0,0,0,,Сабақ беру әдісі: Өте жақсы
Dialogue: 0,0:03:51.56,0:03:56.11,Default,,0,0,0,,Тұтынушының көз алдында ұзақ уақыт қалу үшін баспалдақпен төменнен көтеріліңіз.
Dialogue: 0,0:03:56.32,0:03:58.65,Default,,0,0,0,,Рурико-сан, жақында қосылды...
Dialogue: 0,0:03:58.73,0:04:00.07,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:00.15,0:04:03.07,Default,,0,0,0,,Ем... Мм...
Dialogue: 0,0:04:03.74,0:04:04.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:05.82,0:04:08.62,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:04:08.70,0:04:10.96,Default,,0,0,0,,Керемет!
Dialogue: 0,0:04:11.33,0:04:14.63,Default,,0,0,0,,Сондай-ақ, Кокоро-сан актер болуды мақсат етеді⸺
Dialogue: 0,0:04:14.71,0:04:17.59,Default,,0,0,0,,Өте жарқын және мейірімді
Dialogue: 0,0:04:17.67,0:04:19.84,Default,,0,0,0,,Сонда...
Dialogue: 0,0:04:19.92,0:04:21.51,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:04:21.59,0:04:24.18,Default,,0,0,0,,Сара жақсы қыз.
Dialogue: 0,0:04:24.51,0:04:27.18,Default,,0,0,0,,Сіздің үлкен апаларыңыз көп.
Dialogue: 0,0:04:27.26,0:04:30.31,Default,,0,0,0,,Сара, сенің жалғыз бала болғаныңа қуаныштымын.
Dialogue: 0,0:04:30.39,0:04:32.27,Default,,0,0,0,,Олай болса, тағы бір сурет.
Dialogue: 0,0:04:32.48,0:04:34.73,Default,,0,0,0,,Жоқ, мен барамын.
Dialogue: 0,0:04:34.81,0:04:36.86,Default,,0,0,0,,Енді мұнда көп келме.
Dialogue: 0,0:04:36.94,0:04:38.40,Default,,0,0,0,,О, күтіңіз, күтіңіз
Dialogue: 0,0:04:38.48,0:04:40.78,Default,,0,0,0,,Хмм... не?
Dialogue: 0,0:04:41.11,0:04:43.49,Default,,0,0,0,,үшінмен сәлемдесу
Dialogue: 0,0:04:43.74,0:04:45.99,Default,,0,0,0,,Бәріңе?
Dialogue: 0,0:04:46.45,0:04:50.20,Default,,0,0,0,,(сөйлейтіндердің дауыстары)
Dialogue: 0,0:04:50.45,0:04:52.79,Default,,0,0,0,,Е... Иә!
Dialogue: 0,0:04:53.00,0:04:56.25,Default,,0,0,0,,Сара-чанның фотосуреті
Dialogue: 0,0:04:56.33,0:05:00.30,Default,,0,0,0,,Сондай-ақ! Сондықтан фотоға рұқсат етілмейді!
Dialogue: 0,0:05:00.38,0:05:01.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:01.96,0:05:03.51,Default,,0,0,0,,Эххе
Dialogue: 0,0:05:03.59,0:05:05.30,Default,,0,0,0,,Ахаха
Dialogue: 0,0:05:05.68,0:05:08.68,Default,,0,0,0,,Сара жақсы қыз.
Dialogue: 0,0:05:15.98,0:05:17.44,Default,,0,0,0,,Белгілі бір шілде⸺
Dialogue: 0,0:05:17.52,0:05:19.48,Default,,0,0,0,,Матчтан кейін
Dialogue: 0,0:05:21.94,0:05:23.57,Default,,0,0,0,,Жарайды, бірде бірге шай ішуге баруымыз керек қой?
Dialogue: 0,0:05:23.99,0:05:25.53,Default,,0,0,0,,(құты ашылған дыбыс)
Dialogue: 0,0:05:25.74,0:05:27.49,Default,,0,0,0,,(ішу дыбысы)
Dialogue: 0,0:05:29.74,0:05:33.04,Default,,0,0,0,,Пуха~! Бүгін ыстық болды!
Dialogue: 0,0:05:33.12,0:05:36.29,Default,,0,0,0,,Суық ваннаға түсіп, дайындал.
Dialogue: 0,0:05:36.37,0:05:40.29,Default,,0,0,0,,Хехе, жаз әлі бар, Рурико.
Dialogue: 0,0:05:40.71,0:05:44.59,Default,,0,0,0,,Бүгіннен кейін шаршап жатсаңыз, бұдан былай жағдай қиын болады.
Dialogue: 0,0:05:44.80,0:05:47.80,Default,,0,0,0,,Иә? Шынайы ма?
Dialogue: 0,0:05:48.14,0:05:51.35,Default,,0,0,0,,Мен автоматқа барамын, бірақ мен бірдеңе алғым келеді~
Dialogue: 0,0:05:51.43,0:05:53.93,Default,,0,0,0,,А, су берші.
Dialogue: 0,0:05:54.02,0:05:55.93,Default,,0,0,0,,Олай болса, маған арпа шайын қалайсың ба?
Dialogue: 0,0:05:56.02,0:05:57.27,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:57.35,0:05:58.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:59.06,0:06:01.36,Default,,0,0,0,,Не, не, не болды?
Dialogue: 0,0:06:01.82,0:06:03.94,Default,,0,0,0,,Ух... кешіріңіз.
Dialogue: 0,0:06:04.03,0:06:07.61,Default,,0,0,0,,Мен кір себетін алайын десем, бәрі құлап қалды...
Dialogue: 0,0:06:07.70,0:06:09.28,Default,,0,0,0,,Қылышты қолына алғаннан кейін екі айдың ішінде-ақ қоғам тірегіне айналғандар да бар.
Dialogue: 0,0:06:09.36,0:06:11.66,Default,,0,0,0,,Амансың ба? Сіз зардап шеккен жоқсыз ба?
Dialogue: 0,0:06:11.87,0:06:16.16,Default,,0,0,0,,Иә, жақсы, рахмет.
Dialogue: 0,0:06:20.75,0:06:24.21,Default,,0,0,0,,А, міне? Ол ақыры құлады ма?
Dialogue: 0,0:06:24.30,0:06:28.18,Default,,0,0,0,,Күту және киім ауыстыратын бөлме тым бейберекет.
Dialogue: 0,0:06:28.26,0:06:32.01,Default,,0,0,0,,Мен олардың қанша уақыт болғанын білмеймін, көп нәрсе бар.
Dialogue: 0,0:06:32.10,0:06:34.52,Default,,0,0,0,,Көзді жұмыудың да шегі бар.
Dialogue: 0,0:06:34.60,0:06:36.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:37.81,0:06:38.89,Default,,0,0,0,,Жарайды
Dialogue: 0,0:06:39.35,0:06:42.15,Default,,0,0,0,,Мен оны тазалаймын ба? Иә!
Dialogue: 0,0:06:42.23,0:06:45.11,Default,,0,0,0,,Кохинаттың қосқышы қосылды.
Dialogue: 0,0:06:57.91,0:07:01.21,Default,,0,0,0,,Бұл қажет Бұл қажет емес
Dialogue: 0,0:07:01.46,0:07:04.34,Default,,0,0,0,,Бұл осында Бұл да осында
Dialogue: 0,0:07:04.42,0:07:06.55,Default,,0,0,0,,Бұл қажет емес
Dialogue: 0,0:07:07.09,0:07:09.84,Default,,0,0,0,,Бұл... хмм.
Dialogue: 0,0:07:09.93,0:07:11.26,Default,,0,0,0,,Бір рет тоқтатылды
Dialogue: 0,0:07:11.89,0:07:13.18,Default,,0,0,0,,Ах... Ах!
Dialogue: 0,0:07:13.26,0:07:16.31,Default,,0,0,0,,Сатушы Бұл мен алғаш бастаған кезде пайдаланған жаднама тақтасы!
Dialogue: 0,0:07:16.39,0:07:20.19,Default,,0,0,0,,Мен енді қарамаймын, бірақ оны тастағым келмейді.
Dialogue: 0,0:07:20.39,0:07:22.31,Default,,0,0,0,,Сара Чуван
Dialogue: 0,0:07:22.40,0:07:27.28,Default,,0,0,0,,Мұндай нәрсені істеу үшін 5 сағат қажет.
Dialogue: 0,0:07:28.36,0:07:31.16,Default,,0,0,0,,Мен мұны әлі де шындап істеп жатырмын.
Dialogue: 0,0:07:31.41,0:07:34.41,Default,,0,0,0,,Тазалауды ұнататыныңыз өте жақсы.
Dialogue: 0,0:07:34.49,0:07:38.50,Default,,0,0,0,,Өйткені мұндай іс-әрекет үйірме іс-әрекеті сияқты және ол қызық емес пе?
Dialogue: 0,0:07:38.58,0:07:40.79,Default,,0,0,0,,Мен клубтық іс-шараларға қатыспаймын.
Dialogue: 0,0:07:40.87,0:07:44.17,Default,,0,0,0,,Ахаха, сенің жастық шағың ғажап!
Dialogue: 0,0:07:44.25,0:07:44.63,Default,,0,0,0,,О, күте тұрыңыз ...
Dialogue: 0,0:07:44.63,0:07:46.00,Default,,0,0,0,,О, күте тұрыңыз ...
Dialogue: 0,0:07:44.63,0:07:46.00,Default,,0,0,0,,Балалар үшін ештеңе қазына емес, солай ма?
Dialogue: 0,0:07:46.00,0:07:46.09,Default,,0,0,0,,Балалар үшін ештеңе қазына емес, солай ма?
Dialogue: 0,0:07:46.09,0:07:48.80,Default,,0,0,0,,Балалар үшін ештеңе қазына емес, солай ма?
Dialogue: 0,0:07:46.09,0:07:48.80,Default,,0,0,0,,Рурико-сан, тоқташы өтінемін!
Dialogue: 0,0:07:48.88,0:07:52.13,Default,,0,0,0,,Қарашы, саған осылай қараған ұнайды, солай емес пе? Қараңдар, қараңдар
Dialogue: 0,0:07:52.22,0:07:54.34,Default,,0,0,0,,Ой, қарашы, хехехе
Dialogue: 0,0:07:54.55,0:07:58.18,Default,,0,0,0,,Біздің арамызда үш-ақ айырмашылық бар!
Dialogue: 0,0:07:58.27,0:08:00.73,Default,,0,0,0,,О? 20 жаста болғаныма өкінемін
Dialogue: 0,0:08:00.81,0:08:02.14,Default,,0,0,0,,Мен жалап жатқан жоқпын.
Dialogue: 0,0:08:02.23,0:08:05.90,Default,,0,0,0,,Қазір Рурико үшін де қазына.
Dialogue: 0,0:08:05.98,0:08:07.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:07.27,0:08:08.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:08.36,0:08:10.90,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:08:10.99,0:08:12.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:12.15,0:08:14.36,Default,,0,0,0,,Амансың ба? Аона мырза
Dialogue: 0,0:08:14.45,0:08:15.49,Default,,0,0,0,,Ой…
Dialogue: 0,0:08:15.57,0:08:19.66,Default,,0,0,0,,Ух... Иә, бәрі жақсы, бұл ештеңе емес~
Dialogue: 0,0:08:20.08,0:08:21.08,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:26.96,0:08:28.17,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:08:28.25,0:08:30.34,Default,,0,0,0,,Мен мұны Оматсу-кунмен кездеспей тұрып жаздым⸺
Dialogue: 0,0:08:30.42,0:08:33.22,Default,,0,0,0,,Алмасу күнделігі осында!
Dialogue: 0,0:08:36.60,0:08:40.52,Default,,0,0,0,,Жоқ... Мен оны шкафта қалдырдым.
Dialogue: 0,0:08:41.06,0:08:42.31,Default,,0,0,0,,Аона-сан
Dialogue: 0,0:08:42.60,0:08:46.02,Default,,0,0,0,,Ууу... у... уф... болды.
Dialogue: 0,0:08:46.10,0:08:47.40,Default,,0,0,0,,А, жоқ, жоқ, жоқ...
Dialogue: 0,0:08:47.48,0:08:49.32,Default,,0,0,0,,Салах! кел!
Dialogue: 0,0:08:49.40,0:08:52.03,Default,,0,0,0,,Аона-санда ұятсыз нәрсе бар!
Dialogue: 0,0:08:52.11,0:08:54.24,Default,,0,0,0,,Тоқта! Келме!
Dialogue: 0,0:08:54.53,0:08:56.28,Default,,0,0,0,,Өтінемін~
Dialogue: 0,0:08:56.37,0:09:00.29,Default,,0,0,0,,Махаббаттың жоқтығынан кеуіп бара жатқандай бізге батасын бер!
Dialogue: 0,0:09:00.37,0:09:02.45,Default,,0,0,0,,Мен оны көргім келеді! Джи
Dialogue: 0,0:09:02.54,0:09:04.29,Default,,0,0,0,,Ми... көрсетші!
Dialogue: 0,0:09:04.37,0:09:06.75,Default,,0,0,0,,Олай айтпа! Айтпа!
Dialogue: 0,0:09:06.83,0:09:08.96,Default,,0,0,0,,Кет!
Dialogue: 0,0:09:09.17,0:09:12.76,Default,,0,0,0,,Иә, иә, жалқаулықтың жұқпалы болуына жол бермеңіз.
Dialogue: 0,0:09:12.84,0:09:15.76,Default,,0,0,0,,Иә? Не деп шу шығарып жатырсың?
Dialogue: 0,0:09:15.84,0:09:16.89,Default,,0,0,0,,Сол жігіт пен оның адамдарының бәрі Стэнд қолданушылары сияқты
Dialogue: 0,0:09:16.97,0:09:19.93,Default,,0,0,0,,Аа, дұрыс, Накайзуми-сан, сен мұны не істейсің?
Dialogue: 0,0:09:20.01,0:09:21.01,Default,,0,0,0,,Не?
Dialogue: 0,0:09:21.10,0:09:23.18,Default,,0,0,0,,Мен оны лақтыру керектігін білмеймін бе?
Dialogue: 0,0:09:23.27,0:09:25.06,Default,,0,0,0,,Иә? қайсысы
Dialogue: 0,0:09:27.19,0:09:29.48,Default,,0,0,0,,Эй, Изуна.
Dialogue: 0,0:09:29.56,0:09:33.44,Default,,0,0,0,,Бұл қазына емес! Ескі «Wikbe»!
Dialogue: 0,0:09:33.53,0:09:36.03,Default,,0,0,0,,Бұл шамамен 20 жыл бұрын болды!
Dialogue: 0,0:09:36.28,0:09:39.37,Default,,0,0,0,,Аа~ Сағынышпен өткен жастық шағым қайта оралады
Dialogue: 0,0:09:39.45,0:09:43.87,Default,,0,0,0,,Бағасы да қазіргіден арзан Эй хахаха~
Dialogue: 0,0:09:43.95,0:09:48.21,Default,,0,0,0,,Накайзуми мырза, әлсіреу жұқпалы.
Dialogue: 0,0:09:48.58,0:09:49.96,Default,,0,0,0,,Сәлем бәріңе
Dialogue: 0,0:09:50.04,0:09:51.96,Default,,0,0,0,,Сіз бұл кім екенін білесіз бе?
Dialogue: 0,0:09:55.05,0:09:57.88,Default,,0,0,0,,Иә? Такино мүмкін...
Dialogue: 0,0:09:57.97,0:09:58.97,Default,,0,0,0,,Ах
Dialogue: 0,0:09:59.59,0:10:02.01,Default,,0,0,0,,Бұл Кодзиро! Жас
Dialogue: 0,0:10:02.31,0:10:07.69,Default,,0,0,0,,Шибуи Кодзиро сүйкімді ашулы бала болған, солай ма?
Dialogue: 0,0:10:07.77,0:10:10.44,Default,,0,0,0,,Жаныңыздағы Цубаки ойыншысы?
Dialogue: 0,0:10:10.52,0:10:13.07,Default,,0,0,0,,Хмм... Мен білмеймін.
Dialogue: 0,0:10:14.19,0:10:19.53,Default,,0,0,0,,Цубаки - орта мектепті бітіргеннен кейін бірінші раундта Мотор Сансқа қосылған ойыншы⸺
Dialogue: 0,0:10:19.61,0:10:23.29,Default,,0,0,0,,Алты жыл бұрын мен зейнеткерлікке шықтым.
Dialogue: 0,0:10:24.33,0:10:28.79,Default,,0,0,0,,Такино мен Цубаки - Макуяма орта мектебінің әйгілі дуэті
Dialogue: 0,0:10:29.33,0:10:32.17,Default,,0,0,0,,Екеуіміз де Motor Sands-ке қосылғымыз келді⸺
Dialogue: 0,0:10:32.84,0:10:37.09,Default,,0,0,0,,Кодзиро басқа командаға тағайындалды, кейінірек жұлдызды ойыншы болды.
Dialogue: 0,0:10:37.76,0:10:41.35,Default,,0,0,0,,Осы уақытта Цубаки Motor Sons тобына қосыла алды⸺
Dialogue: 0,0:10:41.68,0:10:45.60,Default,,0,0,0,,Жарақат алу кезінде қызметтік міндетін аяқтады
Dialogue: 0,0:10:47.02,0:10:50.27,Default,,0,0,0,,Кодзиро менің үйіме келгенде Цубаки кетіп қалды⸺
Dialogue: 0,0:10:50.35,0:10:53.19,Default,,0,0,0,,ТТ дуэтінің қайта қосылуы сөзсіз.
Dialogue: 0,0:10:53.27,0:10:56.90,Default,,0,0,0,,Сондай-ақ, Цубаки Америкадағы тәуелсіз лигаға барды деген ақпарат болды⸺
Dialogue: 0,0:10:56.99,0:10:59.70,Default,,0,0,0,,Маған қызық, қазір не істеп жатырсың~
Dialogue: 0,0:11:00.03,0:11:02.16,Default,,0,0,0,,Бұл сіз тоқтата алмайтын нәрсе.
Dialogue: 0,0:11:02.24,0:11:06.20,Default,,0,0,0,,Оқып болған соң, лақтырып тастаңыз немесе үйіңізге алып кетіңіз.
Dialogue: 0,0:11:07.83,0:11:10.12,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:10.21,0:11:11.54,Default,,0,0,0,,Сәлем Сара!
Dialogue: 0,0:11:11.63,0:11:13.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:13.17,0:11:14.88,Default,,0,0,0,,Б-бұл қызық екен, иә?
Dialogue: 0,0:11:16.17,0:11:18.42,Default,,0,0,0,,Бұл не? Ах
Dialogue: 0,0:11:20.47,0:11:22.18,Default,,0,0,0,,О, жоқ!
Dialogue: 0,0:11:22.43,0:11:23.85,Default,,0,0,0,,Сара-чан
Dialogue: 0,0:11:23.93,0:11:27.43,Default,,0,0,0,,Сынақты өзіңізбен бірге үйге апару керек, солай ма?
Dialogue: 0,0:11:27.52,0:11:29.31,Default,,0,0,0,,Неліктен сіз бастауыш сынып оқушысысыз?
Dialogue: 0,0:11:29.39,0:11:31.60,Default,,0,0,0,,Сондай-ақ... Мен оны үйге апарамын.
Dialogue: 0,0:11:31.69,0:11:34.11,Default,,0,0,0,,Рұқсатсыз қарауға болмайды.
Dialogue: 0,0:11:34.19,0:11:37.28,Default,,0,0,0,,Сара үздік студент болуы мүмкін бе?
Dialogue: 0,0:11:37.36,0:11:42.03,Default,,0,0,0,,Сіз әрқашан 100 тамаша балл жинағаныңыз үшін ұялдыңыз ба?
Dialogue: 0,0:11:42.11,0:11:43.20,Default,,0,0,0,,Иә? Хмм?
Dialogue: 0,0:11:43.28,0:11:45.16,Default,,0,0,0,,Мо~, мені мазақ ет!
Dialogue: 0,0:11:45.24,0:11:47.95,Default,,0,0,0,,Рурико-сан бастауыш сынып оқушысына көбірек ұқсайды!
Dialogue: 0,0:11:48.04,0:11:49.04,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:49.62,0:11:51.83,Default,,0,0,0,,Иә, иә, кешіріңіз, кешіріңіз.
Dialogue: 0,0:11:51.92,0:11:54.38,Default,,0,0,0,,Өте көңілсіз!
Dialogue: 0,0:11:54.71,0:11:56.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:57.05,0:12:00.59,Default,,0,0,0,,Мен бастауыш сынып оқушысы сияқтымын ба?
Dialogue: 0,0:12:01.30,0:12:03.80,Default,,0,0,0,,үшінның назарына! Бұл таңқаларлық болды.
Dialogue: 0,0:12:03.89,0:12:04.89,Default,,0,0,0,,О
Dialogue: 0,0:12:05.26,0:12:08.52,Default,,0,0,0,,Юухидің ескі формасы пайда болды~
Dialogue: 0,0:12:08.60,0:12:12.35,Default,,0,0,0,,Бұл бейсбол формасына ұқсайды және сүйкімді
Dialogue: 0,0:12:12.56,0:12:15.73,Default,,0,0,0,,О, бұл тамаша. Мен оны қазір де кие аламын.
Dialogue: 0,0:12:15.81,0:12:17.90,Default,,0,0,0,,Ол қысқа шалбар киген.
Dialogue: 0,0:12:17.98,0:12:22.28,Default,,0,0,0,,А, мен оны штабқа қайтаруды ұмытып кетіппін.
Dialogue: 0,0:12:22.36,0:12:24.57,Default,,0,0,0,,Бір ұрпақ бұрын.
Dialogue: 0,0:12:25.37,0:12:27.91,Default,,0,0,0,,Бұл күндері сатушы еркектер де болды.
Dialogue: 0,0:12:27.99,0:12:31.46,Default,,0,0,0,,Олар бірге әдемі көрінді.
Dialogue: 0,0:12:31.54,0:12:33.33,Default,,0,0,0,,Я~
Dialogue: 0,0:12:33.87,0:12:37.46,Default,,0,0,0,,Оны тұтынушылар да жақсы қабылдады.
Dialogue: 0,0:12:37.54,0:12:40.05,Default,,0,0,0,,Бұл ескірген сияқты.
Dialogue: 0,0:12:40.71,0:12:45.84,Default,,0,0,0,,Сол күндерді Накайзуми екеуің ғана білесіңдер ме?
Dialogue: 0,0:12:46.34,0:12:49.10,Default,,0,0,0,,Иә? қалтамда бірдеңе бар
Dialogue: 0,0:12:49.18,0:12:50.93,Default,,0,0,0,,Сізге не керек? Саған не керек?
Dialogue: 0,0:12:51.02,0:12:53.94,Default,,0,0,0,,Ой... ау, бұл фото!
Dialogue: 0,0:12:54.14,0:12:56.65,Default,,0,0,0,,Бұл киімді кім киген?
Dialogue: 0,0:12:56.73,0:12:58.32,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:12:58.40,0:13:01.94,Default,,0,0,0,,Уау, ол үлкен шашты қыз. Ол сондай сүйкімді!
Dialogue: 0,0:13:02.03,0:13:06.11,Default,,0,0,0,,Иә? Мен көзілдірікті бір жерден көргендей болдым...
Dialogue: 0,0:13:06.20,0:13:09.62,Default,,0,0,0,,Галдың аңызға айналған аурасы Пани!
Dialogue: 0,0:13:09.70,0:13:12.70,Default,,0,0,0,,Мм... Мен оны көрмеймін.
Dialogue: 0,0:13:12.79,0:13:17.13,Default,,0,0,0,,Хехе, міне, тағы бір ностальгия.
Dialogue: 0,0:13:17.33,0:13:20.59,Default,,0,0,0,,Е, Накайзуми мырза, сіз бұл қызды танисыз ба?
Dialogue: 0,0:13:20.67,0:13:22.71,Default,,0,0,0,,Маған көрсетіңізші! Қандай адам? Қандай адам?
Dialogue: 0,0:13:22.80,0:13:26.59,Default,,0,0,0,,Иә? Ух... мм... иә
Dialogue: 0,0:13:27.01,0:13:30.81,Default,,0,0,0,,Жоқ, айтайын дегенім, оны бәрі жақсы біледі.
Dialogue: 0,0:13:31.01,0:13:33.23,Default,,0,0,0,,Не? Сен білесің бе?
Dialogue: 0,0:13:33.31,0:13:35.48,Default,,0,0,0,,Осы стадионда осындай адам бар ма?
Dialogue: 0,0:13:35.56,0:13:36.56,Default,,0,0,0,,Хмм
Dialogue: 0,0:13:36.65,0:13:38.81,Default,,0,0,0,,Мүмкін...
Dialogue: 0,0:13:38.90,0:13:40.90,Default,,0,0,0,,Кук… кукуку…
Dialogue: 0,0:13:41.11,0:13:42.23,Default,,0,0,0,,Хмм
Dialogue: 0,0:13:42.82,0:13:45.11,Default,,0,0,0,,Иә
Dialogue: 0,0:13:45.20,0:13:46.78,Default,,0,0,0,,Кохината-сан!?
Dialogue: 0,0:13:47.16,0:13:48.62,Default,,0,0,0,,Бұл өтірік, солай ма?
Dialogue: 0,0:13:48.70,0:13:50.95,Default,,0,0,0,,Қазіргіден тым басқа
Dialogue: 0,0:13:51.49,0:13:54.29,Default,,0,0,0,,Бұл Нацумэ-чан сіздің артыңызда емес пе?
Dialogue: 0,0:13:54.37,0:13:56.75,Default,,0,0,0,,Бұл 10 жыл бұрын болды ма?
Dialogue: 0,0:13:57.00,0:14:00.88,Default,,0,0,0,,Ах... Демек, бұл 19 жастағы Кохината!
Dialogue: 0,0:14:00.96,0:14:03.05,Default,,0,0,0,,А... бұрылма.
Dialogue: 0,0:14:03.13,0:14:05.42,Default,,0,0,0,,Қағида тек прогресс!
Dialogue: 0,0:14:05.63,0:14:07.68,Default,,0,0,0,,Неліктен мінезіңізді өзгерттіңіз?
Dialogue: 0,0:14:07.76,0:14:09.09,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:14:09.18,0:14:11.93,Default,,0,0,0,,10 жыл бұрын бәрі осылай болған
Dialogue: 0,0:14:12.01,0:14:15.02,Default,,0,0,0,,Кохината-сан, мына форманы киіп ал~
Dialogue: 0,0:14:15.23,0:14:16.94,Default,,0,0,0,,Мен сенің де шашың ұзын болғаныңды қалаймын!
Dialogue: 0,0:14:17.02,0:14:19.85,Default,,0,0,0,,А, бұл жақсы! Қазір жасайық
Dialogue: 0,0:14:19.94,0:14:22.11,Default,,0,0,0,,Аа, маған үзіліс беріңіз~
Dialogue: 0,0:14:22.19,0:14:24.57,Default,,0,0,0,,(үшін қолдайды)
Dialogue: 0,0:14:24.65,0:14:28.78,Default,,0,0,0,,Соңында тазалау жақсы болмады.
Dialogue: 0,0:14:29.99,0:14:30.99,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:14:31.99,0:14:35.20,Default,,0,0,0,,О, жақсы емес пе?
Dialogue: 0,0:14:40.46,0:14:42.21,Default,,0,0,0,,Шілденің белгілі бір күні
Dialogue: 0,0:14:42.29,0:14:46.80,Default,,0,0,0,,Әдеттен тыс, Чиба Мотор Сэндс стадионы лық толы
Dialogue: 0,0:14:46.88,0:14:48.84,Default,,0,0,0,,Себебі бүгін⸺
Dialogue: 0,0:14:49.13,0:14:53.81,Default,,0,0,0,,Ниппон кәсіпқой бейсбол фестивалінің жыл сайынғы жұлдызды ойыны
Dialogue: 0,0:14:54.60,0:14:58.27,Default,,0,0,0,,12 команданың танымал ойыншылары Орталық және Тынық мұхиты командаларына бөлінген⸺
Dialogue: 0,0:14:58.35,0:15:00.52,Default,,0,0,0,,Екі күндік қақтығыс
Dialogue: 0,0:15:01.06,0:15:03.48,Default,,0,0,0,,Өтетін орны жыл сайын өзгеріп отырады⸺
Dialogue: 0,0:15:03.69,0:15:06.44,Default,,0,0,0,,Біздің Motor Sands стадионында⸺
Dialogue: 0,0:15:06.69,0:15:10.20,Default,,0,0,0,,Бұл іс-шара сегіз жылда бірінші рет өткізіліп отыр.
Dialogue: 0,0:15:11.11,0:15:13.74,Default,,0,0,0,,Сыра алғыңыз келе ме?
Dialogue: 0,0:15:14.08,0:15:19.33,Default,,0,0,0,,Суық сыра, Hyper Dry алғыңыз келе ме?
Dialogue: 0,0:15:19.41,0:15:20.50,Default,,0,0,0,,Я~
Dialogue: 0,0:15:20.58,0:15:23.63,Default,,0,0,0,,Мотор Сэндс стадионы осылай көрінеді ме?
Dialogue: 0,0:15:23.71,0:15:25.00,Default,,0,0,0,,Өте орынды.
Dialogue: 0,0:15:25.09,0:15:27.42,Default,,0,0,0,,Әй, қарашы, сатушы әйел
Dialogue: 0,0:15:27.67,0:15:28.67,Default,,0,0,0,,Хмм
Dialogue: 0,0:15:28.76,0:15:31.18,Default,,0,0,0,,Өйткені бізде әдеттегіден басқа тұтынушы бар⸺
Dialogue: 0,0:15:31.26,0:15:33.93,Default,,0,0,0,,Сатушылар да қобалжыды
Dialogue: 0,0:15:34.60,0:15:36.10,Default,,0,0,0,,Хмм…
Dialogue: 0,0:15:39.18,0:15:42.19,Default,,0,0,0,,Сатушы деңгейіне келетін болсақ, Стикс жеңеді.
Dialogue: 0,0:15:42.27,0:15:44.11,Default,,0,0,0,,Жоқ, бұл да сатушы, солай ма?
Dialogue: 0,0:15:44.19,0:15:46.65,Default,,0,0,0,,білімі All Star Motor Sands ойынынан⸺
Dialogue: 0,0:15:46.73,0:15:49.61,Default,,0,0,0,,Тек үш адам таңдалды.
Dialogue: 0,0:15:49.69,0:15:52.57,Default,,0,0,0,,Уф... жалап ал!
Dialogue: 0,0:15:53.11,0:15:55.12,Default,,0,0,0,,Ммм
Dialogue: 0,0:15:58.75,0:16:00.04,Default,,0,0,0,,(доп соғу дыбысы)
Dialogue: 0,0:16:00.12,0:16:02.58,Default,,0,0,0,,Бұл да болды!
Dialogue: 0,0:16:03.08,0:16:06.13,Default,,0,0,0,,Қазір қызықты бола түсуде: Үйге жүгіру дербиі
Dialogue: 0,0:16:06.21,0:16:10.55,Default,,0,0,0,,Өткен жылғы Тынық мұхиты лигасының королі Арайба Фукуока Стикс
Dialogue: 0,0:16:10.76,0:16:14.30,Default,,0,0,0,,13 керемет қоршау өткелдері!
Dialogue: 0,0:16:15.01,0:16:17.68,Default,,0,0,0,,Арайба тек билік туралы емес⸺
Dialogue: 0,0:16:17.76,0:16:19.85,Default,,0,0,0,,Сондай-ақ контактілерді соғушы
Dialogue: 0,0:16:19.93,0:16:23.73,Default,,0,0,0,,Мамандық бойынша өте алатын адам.
Dialogue: 0,0:16:24.35,0:16:26.94,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:16:27.23,0:16:31.15,Default,,0,0,0,,Деннис! Кек ал!
Dialogue: 0,0:16:32.74,0:16:34.57,Default,,0,0,0,,сұрады Деннис
Dialogue: 0,0:16:34.86,0:16:36.12,Default,,0,0,0,,Шишио
Dialogue: 0,0:16:36.99,0:16:39.29,Default,,0,0,0,,А... Жарайды.
Dialogue: 0,0:16:39.49,0:16:41.41,Default,,0,0,0,,Келесі соққы - Деннис Янг!
Dialogue: 0,0:16:41.41,0:16:43.42,Default,,0,0,0,,Келесі соққы - Деннис Янг!
Dialogue: 0,0:16:41.41,0:16:43.42,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:16:43.50,0:16:45.13,Default,,0,0,0,,(доп соғу дыбысы)
Dialogue: 0,0:16:45.21,0:16:48.67,Default,,0,0,0,,(Деннистің айқайы)
Dialogue: 0,0:16:52.59,0:16:53.05,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:16:53.05,0:16:56.14,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:16:53.05,0:16:56.14,Default,,0,0,0,,Керемет! Деннис Янг Бұл 10-шы!
Dialogue: 0,0:16:56.14,0:16:56.22,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:16:56.22,0:16:58.56,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:16:56.22,0:16:58.56,Default,,0,0,0,,Арайбаның рекордын жеңе аласың ба?
Dialogue: 0,0:16:58.56,0:16:59.14,Default,,0,0,0,,Арайбаның рекордын жеңе аласың ба?
Dialogue: 0,0:16:59.22,0:17:02.64,Default,,0,0,0,,Бұл соққы әдісі пішініңізді бұзады.
Dialogue: 0,0:17:02.73,0:17:05.69,Default,,0,0,0,,Мен байсалды болғым келмеді, бірақ...
Dialogue: 0,0:17:05.77,0:17:08.23,Default,,0,0,0,,11-ші!
Dialogue: 0,0:17:10.57,0:17:14.90,Default,,0,0,0,,Мен жеңіліп, командам сынға түскенде одан сайын жек көремін!
Dialogue: 0,0:17:14.99,0:17:16.03,Default,,0,0,0,,(доп соғу дыбысы)
Dialogue: 0,0:17:16.11,0:17:18.45,Default,,0,0,0,,Міне! Деннис Янг
Dialogue: 0,0:17:18.53,0:17:20.29,Default,,0,0,0,,Жоғары траекториясы бар шарларды жаппай өндіру⸺
Dialogue: 0,0:17:20.37,0:17:23.25,Default,,0,0,0,,Соңында 12-ші
Dialogue: 0,0:17:24.04,0:17:27.79,Default,,0,0,0,,Жүр, жыласаң да, күлсең де соңғы доп
Dialogue: 0,0:17:29.79,0:17:31.46,Default,,0,0,0,,Иә? Ах!
Dialogue: 0,0:17:35.68,0:17:40.64,Default,,0,0,0,,Ааа... Ма... Менің тағдырым маған қарайды...
Dialogue: 0,0:17:42.35,0:17:45.35,Default,,0,0,0,,Ахх, мен соңын өткізіп алдым!
Dialogue: 0,0:17:45.44,0:17:49.11,Default,,0,0,0,,Араиба биылғы Home Run дербиінде жеңіске жетті!
Dialogue: 0,0:17:49.31,0:17:52.11,Default,,0,0,0,,Олар сіздің жағдайыңызды өздеріне тапсыруымды сұрады.
Dialogue: 0,0:17:52.19,0:17:56.15,Default,,0,0,0,,(Деннистің өкініш дауысы)
Dialogue: 0,0:17:59.62,0:18:03.79,Default,,0,0,0,,Тұмарлар, черлидерлер, жақында сіздің кезегіңіз.
Dialogue: 0,0:18:03.87,0:18:08.00,Default,,0,0,0,,Мен сағатты сәл басып тұрмын, сондықтан сценарийді орындаңыз.
Dialogue: 0,0:18:08.08,0:18:10.08,Default,,0,0,0,,Күн ыстық, солай емес пе?
Dialogue: 0,0:18:10.17,0:18:12.00,Default,,0,0,0,,Әсіресе, егер ол шынымен ұнтақталған болса.
Dialogue: 0,0:18:12.09,0:18:14.96,Default,,0,0,0,,Мен әдеттегіден көбірек қозғалуым керек.
Dialogue: 0,0:18:15.05,0:18:18.01,Default,,0,0,0,,Еңбегіңіз үшін рахмет, Санширо-сан.
Dialogue: 0,0:18:18.30,0:18:21.22,Default,,0,0,0,,Профессорлық күрес туралы әңгіме Рахмет
Dialogue: 0,0:18:24.52,0:18:27.02,Default,,0,0,0,,Иә, кеттік!
Dialogue: 0,0:18:27.73,0:18:29.44,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:18:29.52,0:18:30.90,Default,,0,0,0,,Енді күте тұрыңыз.
Dialogue: 0,0:18:31.36,0:18:35.07,Default,,0,0,0,,12 команданың тұмар биі басталды!
Dialogue: 0,0:18:35.15,0:18:41.16,Default,,0,0,0,,(Музыка)
Dialogue: 0,0:18:48.62,0:18:51.46,Default,,0,0,0,,Ах! Motor Sands-тен Санширомен⸺
Dialogue: 0,0:18:51.54,0:18:53.92,Default,,0,0,0,,Стикстің Кайзері құлады!
Dialogue: 0,0:18:54.96,0:18:56.42,Default,,0,0,0,,Ал, уақыт келді.
Dialogue: 0,0:18:59.26,0:19:00.26,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:00.34,0:19:03.81,Default,,0,0,0,,Кенеттен Кайзердің соққысы!
Dialogue: 0,0:19:04.26,0:19:07.27,Default,,0,0,0,,Санширо ойланбастан ұшып кетеді. Сенімен бәрі жақсы ма!?
Dialogue: 0,0:19:08.18,0:19:10.98,Default,,0,0,0,,Санширо орнынан тұра алды⸺
Dialogue: 0,0:19:11.06,0:19:14.23,Default,,0,0,0,,Мен Кайзерге қарай жүгіре бастадым!
Dialogue: 0,0:19:15.28,0:19:19.03,Default,,0,0,0,,Бұл шықты! Санширо баспен соққымен қарсы шабуыл жасайды!
Dialogue: 0,0:19:19.11,0:19:21.66,Default,,0,0,0,,Керемет! (Ер) Көбірек жасаңыз!
Dialogue: 0,0:19:22.03,0:19:25.99,Default,,0,0,0,,Әй, төбелес басталды!
Dialogue: 0,0:19:31.29,0:19:33.79,Default,,0,0,0,,Кайзердің тұншықтырғышы!
Dialogue: 0,0:19:33.88,0:19:37.92,Default,,0,0,0,,Ахаха... (Еркек) Жақсы, жақсы, көп жаса!
Dialogue: 0,0:19:41.09,0:19:44.89,Default,,0,0,0,,Санширо нокаутпен жеңілді!
Dialogue: 0,0:19:45.14,0:19:48.60,Default,,0,0,0,,Фукуока Стикс Кайзер жеңді!
Dialogue: 0,0:19:49.02,0:19:51.69,Default,,0,0,0,,Жақсы, Кайзер, бір жақты!
Dialogue: 0,0:19:51.77,0:19:54.69,Default,,0,0,0,,Екі команданың күші Рас емес пе?
Dialogue: 0,0:19:54.77,0:19:59.11,Default,,0,0,0,,Motor Suns-қа қарсы кәдімгі ойынды әзірлеу Тамаша қайталану мүмкіндігі!
Dialogue: 0,0:19:59.32,0:20:01.40,Default,,0,0,0,,Бұл орынның сыртында күтпеген жанжал болды⸺
Dialogue: 0,0:20:01.49,0:20:04.82,Default,,0,0,0,,Жеңімпаз стикстік Кайзерге бұйырды.
Dialogue: 0,0:20:04.91,0:20:08.37,Default,,0,0,0,,(аудитория күлкі)
Dialogue: 0,0:20:08.45,0:20:10.41,Default,,0,0,0,,Санширо!
Dialogue: 0,0:20:11.29,0:20:14.63,Default,,0,0,0,,Тұр! Тұр, Санширо!
Dialogue: 0,0:20:15.88,0:20:18.34,Default,,0,0,0,,Сен не істеп жатырсың, Санширо?
Dialogue: 0,0:20:18.42,0:20:23.18,Default,,0,0,0,,Моторлы ұлдар... Бізге ашық қалғанымыз дұрыс па?
Dialogue: 0,0:20:23.26,0:20:26.14,Default,,0,0,0,,Өзіңізді көрсетіңіз!
Dialogue: 0,0:20:29.14,0:20:33.10,Default,,0,0,0,,(Денистің өкінішті дауысы)
Dialogue: 0,0:20:33.52,0:20:36.19,Default,,0,0,0,,Жақсы, Кайзер, бір жақты!
Dialogue: 0,0:20:36.27,0:20:39.19,Default,,0,0,0,,Екі команданың күші Рас емес пе?
Dialogue: 0,0:20:39.28,0:20:43.74,Default,,0,0,0,,Motor Suns-қа қарсы әдеттегі ойынды әзірлеу Керемет қайталану мүмкіндігі!
Dialogue: 0,0:20:46.12,0:20:50.50,Default,,0,0,0,,Осы кезде Саншироның ішінен бірдеңе жарылып кетті.
Dialogue: 0,0:20:54.04,0:20:55.04,Default,,0,0,0,,Ах
Dialogue: 0,0:20:57.92,0:20:59.92,Default,,0,0,0,,Не? Санширо-сан
Dialogue: 0,0:21:00.00,0:21:02.22,Default,,0,0,0,,Енді тұрудың қажеті жоқ.
Dialogue: 0,0:21:02.30,0:21:05.18,Default,,0,0,0,,Зембіл жақын арада келеді, сондықтан мен уақытты басып тұрмын!
Dialogue: 0,0:21:09.35,0:21:11.39,Default,,0,0,0,,Са... Санширо-сан?
Dialogue: 0,0:21:11.64,0:21:13.60,Default,,0,0,0,,Не? Бір минут күте тұрыңыз...
Dialogue: 0,0:21:18.15,0:21:20.48,Default,,0,0,0,,Күте тұрыңыз! Сценарийден айырмашылығы...
Dialogue: 0,0:21:21.82,0:21:23.19,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:23.57,0:21:25.28,Default,,0,0,0,,Жоқ... Уф!
Dialogue: 0,0:21:25.36,0:21:27.82,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:21:28.03,0:21:29.24,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:21:29.33,0:21:30.54,Default,,0,0,0,,Е...
Dialogue: 0,0:21:32.58,0:21:35.58,Default,,0,0,0,,Жоқ... Құдай-ау! Санширо қайта тірілді!
Dialogue: 0,0:21:35.67,0:21:39.29,Default,,0,0,0,,Арттағы жеңіс үшін неміс суплексі!
Dialogue: 0,0:21:39.38,0:21:44.22,Default,,0,0,0,,Санширо! Санширо! Санширо! Санширо!
Dialogue: 0,0:21:44.30,0:21:50.30,Default,,0,0,0,,(барлығы айғайлайды)
Dialogue: 0,0:21:56.81,0:22:00.48,Default,,0,0,0,,Сценарийді орындамасаң, қиналып қаламын.
Dialogue: 0,0:22:00.98,0:22:04.11,Default,,0,0,0,,Мұнда да қадамдар бар.
Dialogue: 0,0:22:06.74,0:22:08.49,Default,,0,0,0,,Ашулы
Dialogue: 0,0:22:15.50,0:22:20.38,Default,,0,0,0,,♪～
Dialogue: 0,0:23:39.96,0:23:44.96,Default,,0,0,0,,～♪
