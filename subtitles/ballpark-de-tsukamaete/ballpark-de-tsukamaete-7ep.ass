Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.00,0:00:06.00,Default,,0,0,0,,♪～
Dialogue: 0,0:01:22.08,0:01:27.08,Default,,0,0,0,,～♪
Dialogue: 0,0:01:32.92,0:01:36.97,Default,,0,0,0,,(доп соғу дыбысы)
Dialogue: 0,0:01:37.30,0:01:40.85,Default,,0,0,0,,Директор Мацудо Мотор Сэндс жақсы жұмыс істейді.
Dialogue: 0,0:01:41.18,0:01:44.93,Default,,0,0,0,,Сіздің шынайы күшіңіз ақырында пайда бола бастады ма?
Dialogue: 0,0:01:45.02,0:01:48.48,Default,,0,0,0,,Біз 4-орындамыз, көшбасшы Стикстен 5 ойынға қалып келеміз⸺
Dialogue: 0,0:01:48.77,0:01:52.23,Default,,0,0,0,,Екінші таймға байланысты әлі де мүмкіндік бар.
Dialogue: 0,0:01:52.32,0:01:54.32,Default,,0,0,0,,Әрине, мен соған ұмтыламын...
Dialogue: 0,0:01:54.82,0:01:58.32,Default,,0,0,0,,Біріншіден, біреуін ұтып ал және оны жинақтай бер.
Dialogue: 0,0:01:58.57,0:02:04.08,Default,,0,0,0,,Catcher Kawamatsu-ның өткен жылмен салыстырғанда ойнау мүмкіндігі айтарлықтай көп.
Dialogue: 0,0:02:04.16,0:02:06.87,Default,,0,0,0,,Тұрақты аулағышты таңдаудың себебі неде?
Dialogue: 0,0:02:06.96,0:02:08.62,Default,,0,0,0,,Сәлем балалар
Dialogue: 0,0:02:09.08,0:02:10.63,Default,,0,0,0,,Каваматсудың басқа пьесалары⸺
Dialogue: 0,0:02:10.71,0:02:12.96,Default,,0,0,0,,Мұқият қараңыз.
Dialogue: 0,0:02:14.84,0:02:17.22,Default,,0,0,0,,Дәйексөз уақыты келе ме?
Dialogue: 0,0:02:17.80,0:02:20.55,Default,,0,0,0,,Кавамацу далада жерлеушіге рұқсат бергенде⸺
Dialogue: 0,0:02:21.18,0:02:24.06,Default,,0,0,0,,Әрқашан бар күшіңізбен қорғануға жүгіріңіз
Dialogue: 0,0:02:24.14,0:02:26.43,Default,,0,0,0,,Жастар бейсболы сияқты.
Dialogue: 0,0:02:26.52,0:02:30.23,Default,,0,0,0,,Кәсіби бейсболда лақтырылған доп 100 реттен бір рет қана қате жібереді.
Dialogue: 0,0:02:30.31,0:02:31.52,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:02:31.77,0:02:33.90,Default,,0,0,0,,Бұл 1/100.
Dialogue: 0,0:02:33.98,0:02:35.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:36.15,0:02:37.90,Default,,0,0,0,,Бірақ мен⸺
Dialogue: 0,0:02:37.99,0:02:41.91,Default,,0,0,0,,Маған 99 босқа уақыт өтсе де қолынан келгеннің бәрін жасай алатын жігіт ұнайды.
Dialogue: 0,0:02:41.99,0:02:43.37,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:02:47.58,0:02:51.08,Default,,0,0,0,,Бұл атақты дәйексөз... Шынымен әйгілі дәйексөз!
Dialogue: 0,0:02:55.38,0:02:59.76,Default,,0,0,0,,Жарайды, бүгінгі хабар үшін осының бәрі.
Dialogue: 0,0:02:59.84,0:03:02.76,Default,,0,0,0,,Соңында әдеттегі дауысты орындайық.
Dialogue: 0,0:03:03.35,0:03:07.31,Default,,0,0,0,,Мен бұған ешқашан үйренбеймін.
Dialogue: 0,0:03:07.39,0:03:10.52,Default,,0,0,0,,Жарайды, шынымды айтсам, бұл ысырап емес пе?
Dialogue: 0,0:03:10.94,0:03:12.69,Default,,0,0,0,,Хмм...қалдық па?
Dialogue: 0,0:03:17.28,0:03:19.57,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:03:19.78,0:03:21.95,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:03:22.03,0:03:24.49,Default,,0,0,0,,Күткеніңізге рахмет!
Dialogue: 0,0:03:24.70,0:03:26.95,Default,,0,0,0,,Күткеніңізге рахмет!
Dialogue: 0,0:03:27.20,0:03:29.83,Default,,0,0,0,,Біз өте өкінеміз!
Dialogue: 0,0:03:29.91,0:03:32.88,Default,,0,0,0,,Біз өте өкінеміз!
Dialogue: 0,0:03:33.08,0:03:35.34,Default,,0,0,0,,Күніңіз сәтті өтсін!
Dialogue: 0,0:03:35.63,0:03:37.84,Default,,0,0,0,,Күніңіз сәтті өтсін!
Dialogue: 0,0:03:38.21,0:03:40.97,Default,,0,0,0,,Иә Жарайды Таратыңыз!
Dialogue: 0,0:03:41.05,0:03:43.26,Default,,0,0,0,,Бүгін де бар күшіңізді салыңыз~
Dialogue: 0,0:03:43.34,0:03:44.80,Default,,0,0,0,,Иә
Dialogue: 0,0:03:45.01,0:03:46.56,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:03:46.56,0:03:48.31,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:03:46.56,0:03:48.31,Default,,0,0,0,,Әсіресе соңғысы, бұл мүлдем пайдасыз.
Dialogue: 0,0:03:48.31,0:03:50.10,Default,,0,0,0,,Әсіресе соңғысы, бұл мүлдем пайдасыз.
Dialogue: 0,0:03:50.18,0:03:55.19,Default,,0,0,0,,Шетелдік тұтынушылар саны көбейіп жатса да, олай айтуға мүмкіндігім жоқ.
Dialogue: 0,0:03:55.44,0:03:57.61,Default,,0,0,0,,Бұл туралы кім ойлады?
Dialogue: 0,0:03:59.15,0:04:01.82,Default,,0,0,0,,Ал, бәрі, иә?
Dialogue: 0,0:04:02.32,0:04:06.74,Default,,0,0,0,,99 рет босқа кетті, өкінбеуім керек.
Dialogue: 0,0:04:06.95,0:04:11.50,Default,,0,0,0,,Рюрико директор Мацудоның сөздерінен шабыттанды.
Dialogue: 0,0:04:15.38,0:04:17.67,Default,,0,0,0,,Hyper Dry туралы не айтасыз?
Dialogue: 0,0:04:17.75,0:04:19.42,Default,,0,0,0,,Сәлем! иә?
Dialogue: 0,0:04:19.67,0:04:20.97,Default,,0,0,0,,Сатушы
Dialogue: 0,0:04:21.05,0:04:23.38,Default,,0,0,0,,Сыра! (Еркек) Өтінемін!
Dialogue: 0,0:04:23.47,0:04:25.09,Default,,0,0,0,,О, үштік ойын
Dialogue: 0,0:04:26.89,0:04:29.60,Default,,0,0,0,,Сіз дәл уақытында келдіңіз.
Dialogue: 0,0:04:29.68,0:04:31.64,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:04:33.06,0:04:35.10,Default,,0,0,0,,Сізге үлкен рахмет~
Dialogue: 0,0:04:35.31,0:04:38.52,Default,,0,0,0,,Юухи сыра сатушысы қатты қуанды.
Dialogue: 0,0:04:38.61,0:04:40.11,Default,,0,0,0,,Жоқ
Dialogue: 0,0:04:40.19,0:04:41.94,Default,,0,0,0,,Сәлем мұнда да
Dialogue: 0,0:04:42.03,0:04:43.11,Default,,0,0,0,,Иә
Dialogue: 0,0:04:43.99,0:04:45.41,Default,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,0:04:45.49,0:04:47.49,Default,,0,0,0,,Жоқ, жоқ, бәрі жақсы.
Dialogue: 0,0:04:50.16,0:04:51.66,Default,,0,0,0,,Рахмет
Dialogue: 0,0:04:51.75,0:04:54.37,Default,,0,0,0,,Юхидің баласы сыпайы.
Dialogue: 0,0:04:54.46,0:04:57.13,Default,,0,0,0,,Иә? Солай ма?
Dialogue: 0,0:04:57.21,0:04:58.46,Default,,0,0,0,,Ах
Dialogue: 0,0:04:58.54,0:05:00.21,Default,,0,0,0,,Рурико байқады
Dialogue: 0,0:05:00.63,0:05:02.72,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:05:03.09,0:05:05.13,Default,,0,0,0,,Сізге үлкен рахмет~
Dialogue: 0,0:05:05.38,0:05:07.59,Default,,0,0,0,,Күткеніңізге рахмет!
Dialogue: 0,0:05:07.85,0:05:09.97,Default,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,0:05:10.64,0:05:12.73,Default,,0,0,0,,Дауыстап сөйлеу Бұл пайдалы!
Dialogue: 0,0:05:12.81,0:05:15.19,Default,,0,0,0,,Бұл ысырап болған жоқ!
Dialogue: 0,0:05:15.48,0:05:16.65,Default,,0,0,0,,О, ә
Dialogue: 0,0:05:16.73,0:05:18.11,Default,,0,0,0,,Кешіріңіз, кешіріңіз, жақсысыз ба?
Dialogue: 0,0:05:18.19,0:05:20.65,Default,,0,0,0,,Аа, кешіріңіз!
Dialogue: 0,0:05:20.73,0:05:22.11,Default,,0,0,0,,Га
Dialogue: 0,0:05:22.19,0:05:24.65,Default,,0,0,0,,Біз өте өкінеміз!
Dialogue: 0,0:05:25.90,0:05:30.33,Default,,0,0,0,,Сөздерді дауыстап айту қорқынышты
Dialogue: 0,0:05:30.53,0:05:32.37,Default,,0,0,0,,Не қалды...
Dialogue: 0,0:05:32.91,0:05:35.12,Default,,0,0,0,,Күніңіз сәтті өтсін!
Dialogue: 0,0:05:35.58,0:05:37.79,Default,,0,0,0,,Күтілгендей, бұл...
Dialogue: 0,0:05:37.88,0:05:38.88,Default,,0,0,0,,Ах
Dialogue: 0,0:05:41.13,0:05:43.71,Default,,0,0,0,,«Күніңіз сәтті өтсін» мүмкіндігі осында!
Dialogue: 0,0:05:44.01,0:05:47.68,Default,,0,0,0,,Ха... Сәлем Би... Сыра Хаумени?
Dialogue: 0,0:05:47.93,0:05:50.68,Default,,0,0,0,,Сыра Футацу Онегайишимасу
Dialogue: 0,0:05:50.76,0:05:53.43,Default,,0,0,0,,Жапон тілі өте ыстық
Dialogue: 0,0:05:53.64,0:05:55.39,Default,,0,0,0,,Өте жатық!
Dialogue: 0,0:05:56.14,0:05:59.35,Default,,0,0,0,,Сізге ұнайды деп үміттенемін...
Dialogue: 0,0:05:59.61,0:06:01.98,Default,,0,0,0,,Аригатон~ (Шетелдік) Қанпай
Dialogue: 0,0:06:02.07,0:06:05.69,Default,,0,0,0,,«Күндеріңіз сәтті өтсін» Айтуға рұқсат етіңіздер!
Dialogue: 0,0:06:05.78,0:06:07.74,Default,,0,0,0,,Сәлем! иә?
Dialogue: 0,0:06:07.82,0:06:10.57,Default,,0,0,0,,Сатушы осында
Dialogue: 0,0:06:10.91,0:06:12.91,Default,,0,0,0,,Иә, рахмет.
Dialogue: 0,0:06:12.99,0:06:14.41,Default,,0,0,0,,Мен лимон қышқыл
Dialogue: 0,0:06:14.50,0:06:15.95,Default,,0,0,0,,Мен биік доппын
Dialogue: 0,0:06:16.04,0:06:19.67,Default,,0,0,0,,А... Мен тек сыраны сатамын, солай ма?
Dialogue: 0,0:06:19.75,0:06:22.71,Default,,0,0,0,,Сонда шочу немесе шарап жақсы.
Dialogue: 0,0:06:22.80,0:06:24.59,Default,,0,0,0,,Бұл жай сыра деп айтуға батылы барма!
Dialogue: 0,0:06:24.67,0:06:26.38,Default,,0,0,0,,(Ерлердің күлкісі)
Dialogue: 0,0:06:26.47,0:06:28.34,Default,,0,0,0,,A… Ахаха…
Dialogue: 0,0:06:28.93,0:06:31.22,Default,,0,0,0,,Ликер сатушы хаб бар емес пе?
Dialogue: 0,0:06:31.30,0:06:35.31,Default,,0,0,0,,Қарт болғанда, хабтың күші керек.
Dialogue: 0,0:06:35.64,0:06:37.43,Default,,0,0,0,,Хаб жоқ.
Dialogue: 0,0:06:37.52,0:06:41.02,Default,,0,0,0,,Мен көмектесе алмаймын, онда маған екі сыра беріңіз.
Dialogue: 0,0:06:41.23,0:06:43.40,Default,,0,0,0,,Иә, мен сыра емеспін.
Dialogue: 0,0:06:43.48,0:06:44.69,Default,,0,0,0,,Сондықтан ол жерде жоқ.
Dialogue: 0,0:06:44.78,0:06:46.07,Default,,0,0,0,,Концентратор
Dialogue: 0,0:06:46.15,0:06:47.40,Default,,0,0,0,,(Нанами) Болмайды. Мен саған бүгін таңертең неге екенін айттым ғой, иә?
Dialogue: 0,0:06:47.49,0:06:50.03,Default,,0,0,0,,Рурико байқады
Dialogue: 0,0:06:50.11,0:06:52.99,Default,,0,0,0,,Хаб жоқ, солай ма?
Dialogue: 0,0:06:53.08,0:06:55.45,Default,,0,0,0,,Күніңіз сәтті өтсін!
Dialogue: 0,0:06:55.54,0:06:57.50,Default,,0,0,0,,Хаб жоқ~
Dialogue: 0,0:06:57.75,0:07:00.21,Default,,0,0,0,,Күніңіз сәтті өтсін!
Dialogue: 0,0:07:00.42,0:07:02.13,Default,,0,0,0,,Айтуға жақын!
Dialogue: 0,0:07:02.21,0:07:04.55,Default,,0,0,0,,Әй, әпке, әпке!
Dialogue: 0,0:07:04.80,0:07:06.76,Default,,0,0,0,,Мен таң қалдым!
Dialogue: 0,0:07:06.84,0:07:08.88,Default,,0,0,0,,Сіз бақытты көрінесіз.
Dialogue: 0,0:07:08.97,0:07:10.01,Default,,0,0,0,,Жоқ-қ-қ-қ-қ…
Dialogue: 0,0:07:13.80,0:07:15.76,Default,,0,0,0,,Бұл үшінші доптың алдында соғылған доп.
Dialogue: 0,0:07:15.85,0:07:17.18,Default,,0,0,0,,Деннис, қатты ұста⸺
Dialogue: 0,0:07:17.27,0:07:20.52,Default,,0,0,0,,Оны 1-ші негізде Такадаға жіберіп, 1-ді оңай алыңыз.
Dialogue: 0,0:07:20.60,0:07:21.65,Default,,0,0,0,,Фу…
Dialogue: 0,0:07:24.27,0:07:27.86,Default,,0,0,0,,Кавамацу әр жолы бар күшімен жабылады⸺
Dialogue: 0,0:07:28.07,0:07:30.65,Default,,0,0,0,,Жиналыстағы барлық дауыстар⸺
Dialogue: 0,0:07:31.07,0:07:33.78,Default,,0,0,0,,Бұл ысырап, бірақ бұл бос емес.
Dialogue: 0,0:07:39.33,0:07:40.75,Default,,0,0,0,,Директор Мацудо
Dialogue: 0,0:07:42.00,0:07:44.13,Default,,0,0,0,,Мен сенің соңынан еремін!
Dialogue: 0,0:07:45.50,0:07:46.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:46.92,0:07:48.42,Default,,0,0,0,,Сіз суық тиіп қалдыңыз ба?
Dialogue: 0,0:07:58.77,0:08:01.89,Default,,0,0,0,,Стадион жанындағы клуб үйі
Dialogue: 0,0:08:02.48,0:08:06.86,Default,,0,0,0,,Бұл клуб үйінде тек ойыншыларға арналған асхана бар.
Dialogue: 0,0:08:07.32,0:08:09.82,Default,,0,0,0,,Және буфет стилі
Dialogue: 0,0:08:10.44,0:08:14.28,Default,,0,0,0,,Үйдегі ойын күндері, жалпы жаттығу алдында сағат 14:00⸺
Dialogue: 0,0:08:14.36,0:08:16.62,Default,,0,0,0,,Оны көптеген ойыншылар пайдаланады
Dialogue: 0,0:08:16.70,0:08:18.91,Default,,0,0,0,,Сағат 13:30 болып қалды.
Dialogue: 0,0:08:18.99,0:08:20.95,Default,,0,0,0,,Кеш болды.
Dialogue: 0,0:08:23.79,0:08:25.54,Default,,0,0,0,,О, саяхат
Dialogue: 0,0:08:25.63,0:08:27.63,Default,,0,0,0,,Ши... Шишио
Dialogue: 0,0:08:27.71,0:08:29.67,Default,,0,0,0,,Ичиномия қазір басталып жатыр ма?
Dialogue: 0,0:08:29.76,0:08:30.76,Default,,0,0,0,,Иә
Dialogue: 0,0:08:30.84,0:08:33.68,Default,,0,0,0,,Кеш болды. Сіз уақытында жаттығу жасай аласыз ба?
Dialogue: 0,0:08:33.97,0:08:35.43,Default,,0,0,0,,Ах... хаха
Dialogue: 0,0:08:35.51,0:08:37.64,Default,,0,0,0,,Иә, жақсы...
Dialogue: 0,0:08:37.85,0:08:40.35,Default,,0,0,0,,Олай болса, кейінірек (Ичиномия) Ах.
Dialogue: 0,0:08:41.81,0:08:43.35,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:08:43.44,0:08:44.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:44.65,0:08:46.98,Default,,0,0,0,,Қуырылған анкаке соусы дәмді болды, мен оны қолданып көрдім.
Dialogue: 0,0:08:47.06,0:08:49.82,Default,,0,0,0,,Мен сені қатты жақсы көремін.
Dialogue: 0,0:08:49.90,0:08:52.15,Default,,0,0,0,,(Ходжинс) Көріп тұрғаныңыздай, базадағы сарбаздар қуыршақтарға сұраныс жоғары.
Dialogue: 0,0:08:52.24,0:08:54.86,Default,,0,0,0,,Мен сені көргім келмеді, бірақ мен жынды болып бара жатырмын.
Dialogue: 0,0:08:55.07,0:08:58.28,Default,,0,0,0,,Әй, күтсең, қалдырамын.
Dialogue: 0,0:08:58.37,0:08:59.37,Default,,0,0,0,,Иә
Dialogue: 0,0:08:59.95,0:09:01.58,Default,,0,0,0,,Сен де тез кел.
Dialogue: 0,0:09:03.00,0:09:04.21,Default,,0,0,0,,О
Dialogue: 0,0:09:06.25,0:09:08.46,Default,,0,0,0,,«Тез кел!»
Dialogue: 0,0:09:09.00,0:09:12.17,Default,,0,0,0,,Оның менімен бір жастағы орташа соққысы ,32%.
Dialogue: 0,0:09:12.26,0:09:15.68,Default,,0,0,0,,Екінші жағынан, менде 19% бар.
Dialogue: 0,0:09:15.88,0:09:17.47,Default,,0,0,0,,Я...
Dialogue: 0,0:09:17.55,0:09:19.64,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:09:20.56,0:09:21.64,Default,,0,0,0,,Ол Дора 1⸺
Dialogue: 0,0:09:21.72,0:09:22.85,Default,,0,0,0,,Физикалық элита⸺
Dialogue: 0,0:09:22.93,0:09:25.35,Default,,0,0,0,,Ерте жұлдызды ойыншылар
Dialogue: 0,0:09:25.44,0:09:27.44,Default,,0,0,0,,Екінші жағынан, мен кішкентай Дорамын 6⸺
Dialogue: 0,0:09:27.52,0:09:29.36,Default,,0,0,0,,Зардап шеккен ағаның орнына⸺
Dialogue: 0,0:09:29.44,0:09:31.86,Default,,0,0,0,,Соңында бірінші командаға қатысты
Dialogue: 0,0:09:34.61,0:09:35.61,Default,,0,0,0,,(доп соғу дыбысы)
Dialogue: 0,0:09:36.03,0:09:37.16,Default,,0,0,0,,Ах
Dialogue: 0,0:09:37.24,0:09:41.54,Default,,0,0,0,,Мен қорғаныста жақсырақ деп ойладым, бірақ...
Dialogue: 0,0:09:42.16,0:09:43.54,Default,,0,0,0,,Екі жақты бөлмені біріктірейік⸺
Dialogue: 0,0:09:43.62,0:09:47.62,Default,,0,0,0,,Мен оның жылдамдығына ілесу үшін бар күшімді саламын.
Dialogue: 0,0:09:47.96,0:09:51.75,Default,,0,0,0,,Шишио – данышпан, Ичиномия – қарапайым талант.
Dialogue: 0,0:09:51.84,0:09:54.92,Default,,0,0,0,,Мен мұны көптен бері байқадым.
Dialogue: 0,0:09:55.30,0:09:58.30,Default,,0,0,0,,А, тамақ ішіп, ұмытайық.
Dialogue: 0,0:09:59.09,0:10:01.31,Default,,0,0,0,,Қашан қуып жетемін деп ойлаймын
Dialogue: 0,0:10:01.39,0:10:04.22,Default,,0,0,0,,Жоқ, сен тағы да ойлап отырсың.
Dialogue: 0,0:10:04.31,0:10:08.52,Default,,0,0,0,,Мм, анкаке қосылған қуырылған тауық еті анкаке соусы қосылған қуырылған тауық еті...
Dialogue: 0,0:10:08.60,0:10:10.90,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:10:11.15,0:10:12.32,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:10:12.40,0:10:15.15,Default,,0,0,0,,Анкаке соусы қосылған қуырылған карааж жойылды.
Dialogue: 0,0:10:15.24,0:10:17.78,Default,,0,0,0,,Иә? ол болды?
Dialogue: 0,0:10:18.07,0:10:19.11,Default,,0,0,0,,Я...
Dialogue: 0,0:10:19.82,0:10:23.83,Default,,0,0,0,,Ей, мен мұндай әрекет жасаған сайын ауырып қаламын.
Dialogue: 0,0:10:25.04,0:10:28.54,Default,,0,0,0,,Қуырылған тауықтың болмауы да нашар бағаны білдіреді⸺
Dialogue: 0,0:10:28.62,0:10:30.79,Default,,0,0,0,,Кеш келу немесе біліктіліксіз болу⸺
Dialogue: 0,0:10:30.88,0:10:34.30,Default,,0,0,0,,Мен бәріне себепкер екенімді білемін, бірақ...
Dialogue: 0,0:10:34.88,0:10:38.72,Default,,0,0,0,,Мен осылайша бірінші командада мәңгі қала аламын ба?
Dialogue: 0,0:10:39.47,0:10:43.39,Default,,0,0,0,,Тоқта, бұлай ойлаудың қажеті жоқ.
Dialogue: 0,0:10:44.72,0:10:48.06,Default,,0,0,0,,Сіз мен жақтасыз ба?
Dialogue: 0,0:10:48.77,0:10:49.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:50.73,0:10:53.65,Default,,0,0,0,,Анкаке қуырылған тауық еті
Dialogue: 0,0:10:54.98,0:10:57.36,Default,,0,0,0,,Иә? мм...
Dialogue: 0,0:10:57.44,0:11:00.20,Default,,0,0,0,,Не, жегің келді ме?
Dialogue: 0,0:11:00.49,0:11:04.16,Default,,0,0,0,,Әй, уау... мен үшін бар күшіңді салдың ба?
Dialogue: 0,0:11:04.41,0:11:08.12,Default,,0,0,0,,Бұдан былай ешкім келмейді, қалағаныңызша жей беріңіз.
Dialogue: 0,0:11:10.12,0:11:12.04,Default,,0,0,0,,Ех... Еркінсіз.
Dialogue: 0,0:11:13.42,0:11:15.09,Default,,0,0,0,,Эй, Ичиномия-кун
Dialogue: 0,0:11:15.17,0:11:16.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:16.92,0:11:19.13,Default,,0,0,0,,Мен сенің жағындамын
Dialogue: 0,0:11:19.38,0:11:23.60,Default,,0,0,0,,Не? Жоқ... сәлем
Dialogue: 0,0:11:23.68,0:11:25.22,Default,,0,0,0,,Шынымен...
Dialogue: 0,0:11:25.31,0:11:28.89,Default,,0,0,0,,Менің өлген итіме ұқсайды.
Dialogue: 0,0:11:30.60,0:11:32.23,Default,,0,0,0,,Ғибадатхана қыз-қызметшісінің киімі оған жарасады.
Dialogue: 0,0:11:32.31,0:11:35.40,Default,,0,0,0,,Эхехехехе Жарайды, жарайды.
Dialogue: 0,0:11:35.48,0:11:36.48,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:38.36,0:11:40.20,Default,,0,0,0,,Ал сіз не білесіз?
Dialogue: 0,0:11:40.28,0:11:41.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:41.74,0:11:45.74,Default,,0,0,0,,Стадион ішінде шенеуніктерге арналған асхана да бар.
Dialogue: 0,0:11:45.99,0:11:49.70,Default,,0,0,0,,Ондағы күріш пен осы спортшының асханасындағы күріш⸺
Dialogue: 0,0:11:50.12,0:11:53.33,Default,,0,0,0,,Екеуі де бір орталық ас үйде дайындалады.
Dialogue: 0,0:11:57.38,0:11:59.97,Default,,0,0,0,,Менің айтқым келгені
Dialogue: 0,0:12:00.63,0:12:06.14,Default,,0,0,0,,Стадионда жұмыс істейтіндердің бәрі сізбен бір қазаннан тамақ ішіп жатыр.
Dialogue: 0,0:12:06.22,0:12:10.35,Default,,0,0,0,,Сондықтан бәрі сенің жағында.
Dialogue: 0,0:12:10.43,0:12:11.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:12.27,0:12:15.06,Default,,0,0,0,,Жоқ... нені айтып тұрсың?
Dialogue: 0,0:12:15.27,0:12:16.40,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:12:16.98,0:12:18.28,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:12:22.45,0:12:23.45,Default,,0,0,0,,Хмм
Dialogue: 0,0:12:23.99,0:12:26.32,Default,,0,0,0,,Мен сені қатты жақсы көремін.
Dialogue: 0,0:12:30.33,0:12:33.00,Default,,0,0,0,,Бұл дәмді...
Dialogue: 0,0:12:34.00,0:12:38.04,Default,,0,0,0,,Ақырын тамақ іш, тамағыңа кептеліп қаласың.
Dialogue: 0,0:12:46.22,0:12:50.72,Default,,0,0,0,,5-ші иннингтің жоғарғы жағы: Сайтама Жаратылыс шабуылының бір шығуы және 1-ші және 2-ші базаға шығу мүмкіндігі бар.
Dialogue: 0,0:12:51.10,0:12:53.89,Default,,0,0,0,,Motor Suns құмыра Хашимото орнатылған күйден⸺
Dialogue: 0,0:12:53.98,0:12:54.98,Default,,0,0,0,,Мен лақтырдым!
Dialogue: 0,0:12:55.06,0:12:56.15,Default,,0,0,0,,Мен соқтым! (Хашимото) Ах.
Dialogue: 0,0:12:56.23,0:12:58.90,Default,,0,0,0,,Құмыраны сипап жіберді. Орталыққа барады ма?
Dialogue: 0,0:12:58.98,0:12:59.98,Default,,0,0,0,,Екінші жетті
Dialogue: 0,0:13:00.07,0:13:02.40,Default,,0,0,0,,Қолғапты лақтырыңыз. Оны жалаң қолыңызбен ұстап, 1-базаға өтіңіз.
Dialogue: 0,0:13:02.49,0:13:04.15,Default,,0,0,0,,Уақытында!
Dialogue: 0,0:13:04.36,0:13:05.99,Default,,0,0,0,,Бұл тамаша ойын
Dialogue: 0,0:13:06.07,0:13:09.62,Default,,0,0,0,,Сен осында келіп, үлкен спектакль қойдың. Курихара мырза, комментатор.
Dialogue: 0,0:13:09.70,0:13:13.00,Default,,0,0,0,,Ах~ Бұл сыныптың негізгі ойыны.
Dialogue: 0,0:13:13.08,0:13:14.62,Default,,0,0,0,,Әрине
Dialogue: 0,0:13:14.71,0:13:16.71,Default,,0,0,0,,Хахаха
Dialogue: 0,0:13:16.92,0:13:20.34,Default,,0,0,0,,Жарайды, жарайды, екеуіңнен де жақсы ойын!
Dialogue: 0,0:13:20.42,0:13:22.42,Default,,0,0,0,,Шишио Ичиномия
Dialogue: 0,0:13:22.51,0:13:25.30,Default,,0,0,0,,Балалар сендер тамаша жұпсыңдар.
Dialogue: 0,0:13:25.38,0:13:28.14,Default,,0,0,0,,Хахаха рахмет Брайан
Dialogue: 0,0:13:28.22,0:13:29.39,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:29.47,0:13:31.35,Default,,0,0,0,,Керемет комбинация
Dialogue: 0,0:13:31.60,0:13:35.94,Default,,0,0,0,,Хмм, осылай аталады...
Dialogue: 0,0:13:36.02,0:13:39.19,Default,,0,0,0,,Иә! Ниюума жартаста!
Dialogue: 0,0:13:39.27,0:13:42.61,Default,,0,0,0,,Хахахаха Егер мен оны осылай атасам, ол «темір қабырғалы» болар еді.
Dialogue: 0,0:13:42.69,0:13:45.74,Default,,0,0,0,,Хахаха... (Ичиномия) Болды, Шишио.
Dialogue: 0,0:13:45.82,0:13:46.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:47.53,0:13:53.04,Default,,0,0,0,,Ертең асханада бірге түскі ас ішеміз бе?
Dialogue: 0,0:13:53.54,0:13:56.67,Default,,0,0,0,,О? Әй, бәрі жақсы
Dialogue: 0,0:13:56.96,0:13:57.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:01.04,0:14:03.67,Default,,0,0,0,,Эй, сен білесің бе? Шишио
Dialogue: 0,0:14:03.76,0:14:04.88,Default,,0,0,0,,​​О?
Dialogue: 0,0:14:05.72,0:14:09.80,Default,,0,0,0,,Біз асханада жейтін күріш шын мәнінде...
Dialogue: 0,0:14:09.89,0:14:11.05,Default,,0,0,0,,Ах~
Dialogue: 0,0:14:11.35,0:14:15.14,Default,,0,0,0,,Мен нан жейтін адаммын, сондықтан асханадан күріш жеген емеспін.
Dialogue: 0,0:14:15.23,0:14:16.60,Default,,0,0,0,,Гах...
Dialogue: 0,0:14:16.69,0:14:19.02,Default,,0,0,0,,күрішпен не болды?
Dialogue: 0,0:14:19.10,0:14:20.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:20.23,0:14:23.48,Default,,0,0,0,,Мен бұл жігітті жек көремін!
Dialogue: 0,0:14:28.86,0:14:30.91,Default,,0,0,0,,Біраз бұрын болған оқиға
Dialogue: 0,0:14:30.91,0:14:31.49,Default,,0,0,0,,Біраз бұрын болған оқиға
Dialogue: 0,0:14:30.91,0:14:31.49,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:14:31.49,0:14:32.66,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:14:32.66,0:14:33.66,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:14:32.66,0:14:33.66,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:33.66,0:14:33.74,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:14:33.74,0:14:36.00,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:14:33.74,0:14:36.00,Default,,0,0,0,,Керемет
Dialogue: 0,0:14:36.00,0:14:36.83,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:14:37.16,0:14:40.67,Default,,0,0,0,,Жақсы, қобалжудың қажеті жоқ.
Dialogue: 0,0:14:40.75,0:14:42.21,Default,,0,0,0,,Табиғи күлімсіреп
Dialogue: 0,0:14:42.50,0:14:45.21,Default,,0,0,0,,Иә, бұл жақсы сезінеді.
Dialogue: 0,0:14:45.92,0:14:48.59,Default,,0,0,0,,Келесі жолы өзімізді елестетіп көрейік
Dialogue: 0,0:14:48.84,0:14:51.30,Default,,0,0,0,,Ұнады! Өте жақсы
Dialogue: 0,0:14:52.55,0:14:56.93,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:14:58.27,0:14:59.77,Default,,0,0,0,,Бүгінгі күні осымен бітті⸺
Dialogue: 0,0:14:59.85,0:15:02.52,Default,,0,0,0,,Бұл бастапқы құрам.
Dialogue: 0,0:15:05.19,0:15:06.94,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:07.03,0:15:08.78,Default,,0,0,0,,Жақсы нәрселерге қараңыз
Dialogue: 0,0:15:08.86,0:15:10.86,Default,,0,0,0,,Әй, аға.
Dialogue: 0,0:15:10.95,0:15:12.62,Default,,0,0,0,,Ру… Рулико-сан
Dialogue: 0,0:15:12.70,0:15:15.41,Default,,0,0,0,,Бауырым, мен Wikbe оқырманы болдым.
Dialogue: 0,0:15:15.66,0:15:17.79,Default,,0,0,0,,Иә... иә
Dialogue: 0,0:15:18.12,0:15:19.12,Default,,0,0,0,,(Гильда) Бірден көп жеме – аздап-аздап же.
Dialogue: 0,0:15:19.33,0:15:23.42,Default,,0,0,0,,Не? Әй, бұл кітаптың басындағы 4-ші ерекшелік пе?
Dialogue: 0,0:15:23.50,0:15:25.50,Default,,0,0,0,,Деннистің де оң жазылғанына қуаныштымын...
Dialogue: 0,0:15:25.59,0:15:29.26,Default,,0,0,0,,Жоқ, бұл 146 бет! 146 бет!
Dialogue: 0,0:15:29.34,0:15:30.80,Default,,0,0,0,,Не? Иә
Dialogue: 0,0:15:32.97,0:15:35.47,Default,,0,0,0,,«Бейсбол стадионының талғампаз ерекшелігі»
Dialogue: 0,0:15:37.43,0:15:38.43,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:39.39,0:15:42.56,Default,,0,0,0,,Рурико «Wikbe» сайтында көрсетіледі!
Dialogue: 0,0:15:42.65,0:15:44.48,Default,,0,0,0,,Керемет! Керемет!
Dialogue: 0,0:15:44.56,0:15:45.61,Default,,0,0,0,,Сәнді дизайнерлік аяқ киім алу үшін жинап жүрген 20 000 йенім...
Dialogue: 0,0:15:45.69,0:15:49.99,Default,,0,0,0,,Оператор көп шу шығарып, көп сұрап жатыр!
Dialogue: 0,0:15:50.07,0:15:53.78,Default,,0,0,0,,Жоқ, егер жанкүйерлер саны экспоненциалды түрде көбейсе, не істеуіміз керек?
Dialogue: 0,0:15:53.87,0:15:58.50,Default,,0,0,0,,Бейсбол жанкүйерлері үшін «Wikbe» сайтында көріну үлкен жетістік.
Dialogue: 0,0:15:59.33,0:16:00.37,Default,,0,0,0,,Ах
Dialogue: 0,0:16:06.29,0:16:09.96,Default,,0,0,0,,Әй, аға, мен тым көп қарап отырмын.
Dialogue: 0,0:16:10.05,0:16:15.97,Default,,0,0,0,,Бірақ Рурико-сан алыстағы фигураға айналғандай...
Dialogue: 0,0:16:16.05,0:16:17.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:17.43,0:16:20.06,Default,,0,0,0,,Ол жақын жерде. Жақын жерде. (Мұрата) Әй, эй...
Dialogue: 0,0:16:20.14,0:16:23.10,Default,,0,0,0,,Нама Рурико-сан... (Мұрата) Мен... түсіндім.
Dialogue: 0,0:16:23.19,0:16:27.11,Default,,0,0,0,,Бүгінгі күнді еске алу үшін бір кесе 700 иенді құрайды.
Dialogue: 0,0:16:27.65,0:16:30.36,Default,,0,0,0,,Бағасы әдеттегідей.
Dialogue: 0,0:16:31.99,0:16:33.41,Default,,0,0,0,,Нжа (Мұрата) Ах.
Dialogue: 0,0:16:33.61,0:16:36.16,Default,,0,0,0,,Танымал адамдар бос емес.
Dialogue: 0,0:16:36.24,0:16:41.00,Default,,0,0,0,,Мен қашан оралатынымды білмеймін, бірақ мен сені күттім~
Dialogue: 0,0:16:41.08,0:16:43.16,Default,,0,0,0,,Көңіл күйлерің жақсы болғанына қуаныштымын.
Dialogue: 0,0:16:45.00,0:16:46.00,Default,,0,0,0,,Я...
Dialogue: 0,0:16:46.08,0:16:48.38,Default,,0,0,0,,Уау, бүгін тұтынушылар көп емес.
Dialogue: 0,0:16:48.46,0:16:49.96,Default,,0,0,0,,Тезірек оралыңыз!
Dialogue: 0,0:16:50.05,0:16:52.72,Default,,0,0,0,,«Wikbe» сайтында көрсетілсе де
Dialogue: 0,0:16:52.80,0:16:55.01,Default,,0,0,0,,А, бірақ менде басқа амал жоқ.
Dialogue: 0,0:16:55.39,0:16:59.81,Default,,0,0,0,,Бұл 4-орын картасы және 6-орынға арналған Nickelbacks картасы.
Dialogue: 0,0:17:01.60,0:17:04.39,Default,,0,0,0,,А, бұл Наги.
Dialogue: 0,0:17:05.23,0:17:06.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:08.15,0:17:11.03,Default,,0,0,0,,Сіздің ағаңыз бейсбол клубының мүшесі болды ма?
Dialogue: 0,0:17:11.11,0:17:14.28,Default,,0,0,0,,Не? Жоқ, олай емес, бірақ
Dialogue: 0,0:17:14.36,0:17:17.16,Default,,0,0,0,,Солай ма? Өйткені бұл өте егжей-тегжейлі
Dialogue: 0,0:17:17.53,0:17:21.20,Default,,0,0,0,,Мен бейсболды кішкентай кезімнен жақсы көремін.
Dialogue: 0,0:17:21.29,0:17:24.33,Default,,0,0,0,,Бірақ жаттығу мүлдем жақсы емес.
Dialogue: 0,0:17:24.41,0:17:27.79,Default,,0,0,0,,Мен өнер үйірмесіне тіркелдім⸺
Dialogue: 0,0:17:27.88,0:17:29.84,Default,,0,0,0,,Бұл үйге қайту клубы болды.
Dialogue: 0,0:17:29.92,0:17:31.50,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:17:31.59,0:17:36.55,Default,,0,0,0,,Бірақ мен спортта жақсы болмағандықтан, мен спортшыларға таң қаламын...
Dialogue: 0,0:17:37.01,0:17:41.51,Default,,0,0,0,,Кәсіби бейсболшылардың физикалық қабілеттері шынымен де адамгершілігінен жоғары⸺
Dialogue: 0,0:17:41.97,0:17:44.73,Default,,0,0,0,,Ол мен үшін батыр.
Dialogue: 0,0:17:45.06,0:17:46.77,Default,,0,0,0,,Я~
Dialogue: 0,0:17:47.85,0:17:50.40,Default,,0,0,0,,Мүмкін мен көп сөйлеген шығармын.
Dialogue: 0,0:17:51.19,0:17:54.53,Default,,0,0,0,,Лу... Лулико-сан қандай да бір клубтық іс-шараларға қатысты ма?
Dialogue: 0,0:17:54.61,0:17:58.99,Default,,0,0,0,,Сабақтан кейін достарыммен караокеге барамын⸺
Dialogue: 0,0:17:59.07,0:18:01.99,Default,,0,0,0,,Алдын ала түсіру... Ал, яғни үйге қайту бөлімі.
Dialogue: 0,0:18:02.08,0:18:03.62,Default,,0,0,0,,Эй... Әй~
Dialogue: 0,0:18:03.70,0:18:05.66,Default,,0,0,0,,Фуфуфу (Мұрата) Иә?
Dialogue: 0,0:18:07.17,0:18:08.17,Default,,0,0,0,,Дәл солай.
Dialogue: 0,0:18:08.37,0:18:09.38,Default,,0,0,0,,Ах
Dialogue: 0,0:18:09.88,0:18:13.67,Default,,0,0,0,,Ал... дұрыс... солай ма?
Dialogue: 0,0:18:14.67,0:18:19.68,Default,,0,0,0,,Мен командамын ба? Мен бірінші рет бірдеңе жасап жатырмын
Dialogue: 0,0:18:20.22,0:18:23.14,Default,,0,0,0,,Бұл жұмыс өте қызық, солай емес пе?
Dialogue: 0,0:18:24.89,0:18:27.39,Default,,0,0,0,,Жұмысқа форма кию⸺
Dialogue: 0,0:18:27.81,0:18:30.36,Default,,0,0,0,,Мені «сатушы» деп те атамайды⸺
Dialogue: 0,0:18:30.81,0:18:34.57,Default,,0,0,0,,Мен басқа нәрсеге айналғандай болдым⸺
Dialogue: 0,0:18:35.11,0:18:38.03,Default,,0,0,0,,Бірдеңе солай сезіледі.
Dialogue: 0,0:18:39.49,0:18:43.99,Default,,0,0,0,,Мм... Мен түсіндім деп ойлаймын.
Dialogue: 0,0:18:46.91,0:18:48.21,Default,,0,0,0,,Жоқ! (Мұрата) Уау
Dialogue: 0,0:18:48.29,0:18:50.79,Default,,0,0,0,,Жақсылық жоқ, бұзсаң
Dialogue: 0,0:18:50.88,0:18:52.75,Default,,0,0,0,,Трансформация Мен оны шеше аламын!
Dialogue: 0,0:18:53.04,0:18:55.34,Default,,0,0,0,,Ахахаха…
Dialogue: 0,0:18:55.42,0:18:56.59,Default,,0,0,0,,Жарайды
Dialogue: 0,0:18:57.05,0:19:00.34,Default,,0,0,0,,Біртүрлі! Дене!
Dialogue: 0,0:19:00.43,0:19:02.30,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:02.76,0:19:04.72,Default,,0,0,0,,Не?
Dialogue: 0,0:19:04.93,0:19:06.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:06.60,0:19:09.23,Default,,0,0,0,,Қараңдар, қараңдар, қазір сіздің фотосурет мүмкіндігіңіз.
Dialogue: 0,0:19:09.31,0:19:11.40,Default,,0,0,0,,Жоқ... жоқ, мен суретке түспеймін.
Dialogue: 0,0:19:11.48,0:19:14.32,Default,,0,0,0,,Менің алдымда «Wikbe» сайтындағы Рурико.
Dialogue: 0,0:19:14.40,0:19:16.11,Default,,0,0,0,,Ал... Мен суретке түспеймін.
Dialogue: 0,0:19:16.19,0:19:18.95,Default,,0,0,0,,Хехехе, неменеге байсалдысың?
Dialogue: 0,0:19:19.20,0:19:21.95,Default,,0,0,0,,Бауырым, сен шынында да тоқырауды түсінбейсің.
Dialogue: 0,0:19:22.03,0:19:26.37,Default,,0,0,0,,(Руриконың күлкісі)
Dialogue: 0,0:19:26.62,0:19:30.50,Default,,0,0,0,,Эй, бұл Рурикодан табиғи нәрсе ме?
Dialogue: 0,0:19:30.58,0:19:33.25,Default,,0,0,0,,Иә, ол күнәкар әйел.
Dialogue: 0,0:19:33.33,0:19:36.17,Default,,0,0,0,,Бүгін бір нәрсе ерекше таң қалдырады.
Dialogue: 0,0:19:36.25,0:19:39.34,Default,,0,0,0,,Ағаңды аямаймын.
Dialogue: 0,0:19:39.42,0:19:40.88,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:19:41.30,0:19:43.09,Default,,0,0,0,,Енді жұмысқа қайта оралайық.
Dialogue: 0,0:19:43.18,0:19:44.80,Default,,0,0,0,,Иә
Dialogue: 0,0:19:49.14,0:19:50.14,Default,,0,0,0,,Я...
Dialogue: 0,0:19:50.23,0:19:52.65,Default,,0,0,0,,Түскі асты ішіп, тынышталайық.
Dialogue: 0,0:19:52.73,0:19:56.19,Default,,0,0,0,,Эй Ямада-чан, қуырылған тауық етіне салатын лимон бар ма?
Dialogue: 0,0:19:56.40,0:19:58.61,Default,,0,0,0,,Кешіріңіз, мен дайын емеспін...
Dialogue: 0,0:19:58.69,0:20:00.36,Default,,0,0,0,,Мен дүкен менеджерімен кеңесемін.
Dialogue: 0,0:20:00.45,0:20:02.32,Default,,0,0,0,,Рахмет және жақын арада кездескенше.
Dialogue: 0,0:20:02.41,0:20:04.07,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:20:04.16,0:20:05.16,Default,,0,0,0,,Ах
Dialogue: 0,0:20:06.20,0:20:08.12,Default,,0,0,0,,О... ханзада!
Dialogue: 0,0:20:08.70,0:20:10.16,Default,,0,0,0,,Қош келдіңіз!
Dialogue: 0,0:20:10.25,0:20:12.25,Default,,0,0,0,,Бір қуырылған тауық бентосы
Dialogue: 0,0:20:12.33,0:20:16.09,Default,,0,0,0,,Бір қуырылған тауық бентосы үшін рахмет!
Dialogue: 0,0:20:16.42,0:20:18.42,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:19.30,0:20:23.13,Default,,0,0,0,,Мен басқа нәрсеге айналғандай болдым...
Dialogue: 0,0:20:24.55,0:20:26.39,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:20:27.56,0:20:32.56,Default,,0,0,0,,Стадиондағы әрбір адамның өз драмасы бар деп ойлаймын.
Dialogue: 0,0:20:33.35,0:20:35.44,Default,,0,0,0,,Бұл баланың да болатынына сенімдімін.
Dialogue: 0,0:20:35.52,0:20:37.94,Default,,0,0,0,,Мм... тұтынушы?
Dialogue: 0,0:20:38.02,0:20:39.98,Default,,0,0,0,,Ах... Кешіріңіз.
Dialogue: 0,0:20:40.99,0:20:43.36,Default,,0,0,0,,Біз сіздің депозитіңізді 2000 иенге сақтаймыз.
Dialogue: 0,0:20:44.66,0:20:45.78,Default,,0,0,0,,Ханзада
Dialogue: 0,0:20:45.87,0:20:50.33,Default,,0,0,0,,Неге дәл қазір маған бұлай қарап тұрсың?
Dialogue: 0,0:20:50.41,0:20:51.62,Default,,0,0,0,,Га
Dialogue: 0,0:20:52.04,0:20:57.38,Default,,0,0,0,,Сондай-ақ... Сіз осы аптадағы «Wikbe» журналын оқыдыңыз ба?
Dialogue: 0,0:20:57.46,0:21:01.42,Default,,0,0,0,,Не? Иә, мен оны оқыдым ...
Dialogue: 0,0:21:01.67,0:21:03.30,Default,,0,0,0,,Сізден бір нәрсе сұрасам…
Dialogue: 0,0:21:03.38,0:21:06.18,Default,,0,0,0,,Бұл жақсы мақала болды.
Dialogue: 0,0:21:10.35,0:21:12.68,Default,,0,0,0,,Оның көргеніне сенімдімін.
Dialogue: 0,0:21:17.02,0:21:20.57,Default,,0,0,0,,Өзіңнен басқа нәрсеге айналу
Dialogue: 0,0:21:20.65,0:21:23.78,Default,,0,0,0,,Енді мен ше?
Dialogue: 0,0:21:24.15,0:21:26.11,Default,,0,0,0,,Сәлем, сатушы!
Dialogue: 0,0:21:26.20,0:21:28.20,Default,,0,0,0,,Иә
Dialogue: 0,0:21:31.24,0:21:35.75,Default,,0,0,0,,Шаштаразға барып, суретке түскеніме қуаныштымын.
Dialogue: 0,0:21:36.08,0:21:37.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:38.00,0:21:40.50,Default,,0,0,0,,Хмм? Кавада!?
Dialogue: 0,0:21:41.05,0:21:42.46,Default,,0,0,0,,Солай деді. Маған берді — жарты бағасына екен.
Dialogue: 0,0:21:42.71,0:21:46.68,Default,,0,0,0,,Сіз қате жібердіңіз, "Wikbe" редакциясы!
Dialogue: 0,0:21:46.88,0:21:51.68,Default,,0,0,0,,Ханзада менің атымды қате есіне алады!
Dialogue: 0,0:21:51.76,0:21:52.85,Default,,0,0,0,,(Нацуноның жылауы)
Dialogue: 0,0:21:52.85,0:21:56.14,Default,,0,0,0,,(Нацуно жылап жатыр)
Dialogue: 0,0:21:52.85,0:21:56.14,Default,,0,0,0,,Ой... Эй Ямада, сен неге жылайсың?
Dialogue: 0,0:21:56.14,0:21:56.81,Default,,0,0,0,,(Нацуноның жылауы)
Dialogue: 0,0:21:56.81,0:21:57.77,Default,,0,0,0,,(Нацуноның жылауы)
Dialogue: 0,0:21:56.81,0:21:57.77,Default,,0,0,0,,Жарайды, Ямада-чан.
Dialogue: 0,0:21:57.77,0:21:59.06,Default,,0,0,0,,Жарайды, Ямада-чан.
Dialogue: 0,0:21:59.15,0:22:02.78,Default,,0,0,0,,Өйткені Мұрат оны алғаш оқымаған.
Dialogue: 0,0:22:07.20,0:22:09.16,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:22:09.24,0:22:11.03,Default,,0,0,0,,Эххе
Dialogue: 0,0:22:15.46,0:22:20.33,Default,,0,0,0,,♪～
Dialogue: 0,0:23:39.91,0:23:44.92,Default,,0,0,0,,～♪
