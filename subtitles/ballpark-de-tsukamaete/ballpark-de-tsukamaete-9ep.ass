Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.00,0:00:06.00,Default,,0,0,0,,♪～
Dialogue: 0,0:01:22.08,0:01:27.08,Default,,0,0,0,,～♪
Dialogue: 0,0:01:31.38,0:01:33.84,Default,,0,0,0,,Моши Моши Рурико
Dialogue: 0,0:01:33.92,0:01:34.92,Default,,0,0,0,,Қазір қайдасың?
Dialogue: 0,0:01:35.01,0:01:36.93,Default,,0,0,0,,Ах, Накайзуми мырза
Dialogue: 0,0:01:37.13,0:01:40.39,Default,,0,0,0,,Біз стадионға жеттік, енді ішке кірмекпіз.
Dialogue: 0,0:01:40.60,0:01:42.39,Default,,0,0,0,,Иә.
Dialogue: 0,0:01:42.47,0:01:45.60,Default,,0,0,0,,Кездесу аяқталды⸺
Dialogue: 0,0:01:45.68,0:01:49.27,Default,,0,0,0,,Керісінше, матч басталып кетті ғой, солай ма? Ах!?
Dialogue: 0,0:01:49.36,0:01:51.07,Default,,0,0,0,,Уф... Кешіріңіз.
Dialogue: 0,0:01:51.15,0:01:54.57,Default,,0,0,0,,Мен екі рет ұйықтап қалдым... жоқ, үш рет!
Dialogue: 0,0:01:54.78,0:01:55.95,Default,,0,0,0,,Кешкі жұмыс үшін⸺
Dialogue: 0,0:01:56.03,0:01:57.24,Default,,0,0,0,,Көп ұйықтамаңыз!
Dialogue: 0,0:01:57.32,0:01:58.66,Default,,0,0,0,,Жарайды, асығыңыз!
Dialogue: 0,0:01:58.74,0:02:00.62,Default,,0,0,0,,...
Dialogue: 0,0:02:01.28,0:02:03.83,Default,,0,0,0,,Жаңа күзетші, эй! (Такимото) Күте тұрыңыз!
Dialogue: 0,0:02:03.91,0:02:05.45,Default,,0,0,0,,Маған кіру картаңызды көрсетіңіз
Dialogue: 0,0:02:05.66,0:02:08.46,Default,,0,0,0,,Түсінесіз! Біз асығып жатырмыз!
Dialogue: 0,0:02:08.54,0:02:10.67,Default,,0,0,0,,Жоқ! Қабылдау картасы
Dialogue: 0,0:02:10.75,0:02:12.04,Default,,0,0,0,,Ммм
Dialogue: 0,0:02:12.13,0:02:13.71,Default,,0,0,0,,Ах
Dialogue: 0,0:02:13.80,0:02:16.92,Default,,0,0,0,,Такимото: Бұл жерде мәселе бар.
Dialogue: 0,0:02:17.01,0:02:18.34,Default,,0,0,0,,Ауыстыру кешіктірілетін сияқты.
Dialogue: 0,0:02:18.43,0:02:21.22,Default,,0,0,0,,Иә? Шынайы ма?
Dialogue: 0,0:02:21.30,0:02:22.35,Default,,0,0,0,,Түсінді
Dialogue: 0,0:02:22.68,0:02:23.68,Default,,0,0,0,,Мен енді жылап жібергім келеді!
Dialogue: 0,0:02:23.76,0:02:26.10,Default,,0,0,0,,Жарайды~ (Такимото) Ой, эй!
Dialogue: 0,0:02:26.31,0:02:29.44,Default,,0,0,0,,Қараңдаршы, мен саған дұрыстап көрсеттім! Бае~
Dialogue: 0,0:02:30.86,0:02:32.40,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:02:35.32,0:02:38.03,Default,,0,0,0,,А, мен мұны істедім.
Dialogue: 0,0:02:38.65,0:02:41.91,Default,,0,0,0,,Ересек болған соң айғайлау.
Dialogue: 0,0:02:41.99,0:02:43.74,Default,,0,0,0,,Асығыңыз, асығыңыз
Dialogue: 0,0:02:43.95,0:02:47.54,Default,,0,0,0,,Уф... Жұмысқа барғым келмейді.
Dialogue: 0,0:02:47.62,0:02:50.62,Default,,0,0,0,,Мен базада барлығымен кездескім келмейді.
Dialogue: 0,0:02:52.63,0:02:54.63,Default,,0,0,0,,Бірақ мұны істеуден басқа амалым жоқ.
Dialogue: 0,0:02:54.71,0:02:56.34,Default,,0,0,0,,Маған сәттілік!
Dialogue: 0,0:02:56.55,0:02:58.76,Default,,0,0,0,,Асығыңыз, асығыңыз!
Dialogue: 0,0:02:59.05,0:03:00.05,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:03.51,0:03:06.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:21.61,0:03:22.62,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:03:25.58,0:03:28.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:31.25,0:03:33.54,Default,,0,0,0,,Е, ә, неге!?
Dialogue: 0,0:03:33.63,0:03:35.38,Default,,0,0,0,,Тек сол жаққа барыңыз!
Dialogue: 0,0:03:37.55,0:03:40.93,Default,,0,0,0,,Жоқ, у... Мен мысық адаммын.
Dialogue: 0,0:03:41.01,0:03:42.84,Default,,0,0,0,,Уф... кешіріңіз.
Dialogue: 0,0:03:42.93,0:03:45.47,Default,,0,0,0,,Қорқыныш! Беті өте қорқынышты!
Dialogue: 0,0:03:45.55,0:03:46.56,Default,,0,0,0,,Томми қайда?
Dialogue: 0,0:03:46.64,0:03:48.60,Default,,0,0,0,,Ізде, ізде! Ах
Dialogue: 0,0:03:49.10,0:03:51.44,Default,,0,0,0,,Осындай кезде қайда барасың?
Dialogue: 0,0:03:51.52,0:03:54.61,Default,,0,0,0,,Рұқсатсыз көшеге шықпайды деп ойлаймын...
Dialogue: 0,0:03:54.81,0:03:56.86,Default,,0,0,0,,Мен қиындыққа тап болдым, Сасаки мырза.
Dialogue: 0,0:03:56.94,0:03:59.53,Default,,0,0,0,,Жаттықтырушы оны қадағалап отыруы керек.
Dialogue: 0,0:03:59.61,0:04:01.32,Default,,0,0,0,,Ақыл-есіңді сақта.
Dialogue: 0,0:04:01.40,0:04:05.66,Default,,0,0,0,,Әзірге мен әртүрлі орындардағы бүйірлік кіреберіс пен күзетшілерге хабарласамын.
Dialogue: 0,0:04:05.74,0:04:07.24,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:04:07.33,0:04:08.74,Default,,0,0,0,,Не болды?
Dialogue: 0,0:04:09.08,0:04:12.12,Default,,0,0,0,,Томми бейсбол иті жоғалып кетті.
Dialogue: 0,0:04:12.67,0:04:14.29,Default,,0,0,0,,Бейсбол иті дегеніміз не?
Dialogue: 0,0:04:14.67,0:04:17.38,Default,,0,0,0,,Бұрын мен допты бірінші алаңға шығару рәсімінде алып жүрген едім...
Dialogue: 0,0:04:18.38,0:04:21.92,Default,,0,0,0,,Тұқым - Сібір хаскиі. Мен оны тез табуым керек.
Dialogue: 0,0:04:22.13,0:04:24.39,Default,,0,0,0,,Ах, Рё... Түсінікті.
Dialogue: 0,0:04:24.59,0:04:28.43,Default,,0,0,0,,Біз іздеуді стадионның айналасын қамту үшін кеңейтеміз.
Dialogue: 0,0:04:28.51,0:04:29.81,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:04:29.89,0:04:32.31,Default,,0,0,0,,Ми... барлығына.
Dialogue: 0,0:04:32.39,0:04:35.31,Default,,0,0,0,,Міне, мен мұндамын~
Dialogue: 0,0:04:35.40,0:04:37.27,Default,,0,0,0,,Сәлем! Кешіріңіз, кешіріңіз
Dialogue: 0,0:04:37.36,0:04:40.61,Default,,0,0,0,,Қате үшін кешіріңіз! Ашуланба!
Dialogue: 0,0:04:43.45,0:04:47.91,Default,,0,0,0,,(шу)
Dialogue: 0,0:04:51.91,0:04:53.79,Default,,0,0,0,,Менің жоспарым бар
Dialogue: 0,0:04:58.46,0:04:59.46,Default,,0,0,0,,Хмм
Dialogue: 0,0:05:00.25,0:05:02.76,Default,,0,0,0,,Тото... Барып ал!
Dialogue: 0,0:05:03.01,0:05:04.72,Default,,0,0,0,,(Томидің айқайы)
Dialogue: 0,0:05:04.80,0:05:06.47,Default,,0,0,0,,Жарайды, иә?
Dialogue: 0,0:05:06.76,0:05:08.51,Default,,0,0,0,,Ой, жаңбыр жауып тұр—
Dialogue: 0,0:05:18.19,0:05:21.73,Default,,0,0,0,,Бір... Мен кептеліп қалдым!
Dialogue: 0,0:05:22.61,0:05:24.32,Default,,0,0,0,,Ол мұнда болмады.
Dialogue: 0,0:05:24.57,0:05:26.57,Default,,0,0,0,,Ол да мұнда болмады.
Dialogue: 0,0:05:26.66,0:05:29.28,Default,,0,0,0,,Мен сәйкес аймақтардың көпшілігін іздедім.
Dialogue: 0,0:05:29.62,0:05:32.54,Default,,0,0,0,,Бұл басқа стадиондарда болған жоқ, солай ма?
Dialogue: 0,0:05:32.62,0:05:33.62,Default,,0,0,0,,Иә
Dialogue: 0,0:05:33.70,0:05:36.92,Default,,0,0,0,,Бұл бала, мен Мотор Сэндс стадионында бірінші рет болдым⸺
Dialogue: 0,0:05:37.00,0:05:38.83,Default,,0,0,0,,Сіз қобалжыған сияқтысыз.
Dialogue: 0,0:05:38.92,0:05:41.84,Default,,0,0,0,,Тұтынушы аймағына кіргенде жаман.
Dialogue: 0,0:05:41.92,0:05:43.76,Default,,0,0,0,,Сіз есеп алдыңыз ба?
Dialogue: 0,0:05:44.17,0:05:48.59,Default,,0,0,0,,Әзірге бұл бағыттағы күзетшілерден ешқандай хабарлама түскен жоқ.
Dialogue: 0,0:05:48.80,0:05:52.56,Default,,0,0,0,,Жарайды, қатысты аймақты қайтадан іздейік.
Dialogue: 0,0:05:52.77,0:05:54.56,Default,,0,0,0,,Иә, түсіндім.
Dialogue: 0,0:05:54.64,0:05:57.60,Default,,0,0,0,,(Руриконың ауыр тыныс алуы)
Dialogue: 0,0:05:58.10,0:06:02.11,Default,,0,0,0,,Менің... жоғалдың, ит.
Dialogue: 0,0:06:02.19,0:06:06.99,Default,,0,0,0,,Барын бергеннен кейін құмыра Рурико ойынды өкінішпен тастап кетеді
Dialogue: 0,0:06:07.07,0:06:10.53,Default,,0,0,0,,Сонымен, сіздің жұмысыңыз жақсы ма?
Dialogue: 0,0:06:12.58,0:06:14.04,Default,,0,0,0,,Хехе
Dialogue: 0,0:06:14.12,0:06:18.21,Default,,0,0,0,,Мүмкін бүгін жұмысқа барғың келмей тұрған шығар?
Dialogue: 0,0:06:21.84,0:06:25.21,Default,,0,0,0,,Бүгінгі алғашқы құмыра мэр Накадзима болды.
Dialogue: 0,0:06:25.30,0:06:26.88,Default,,0,0,0,,Жарайды, жарайды, жарайды.
Dialogue: 0,0:06:26.97,0:06:30.30,Default,,0,0,0,,Жарайды, жарайды, жарайды... хахахаха
Dialogue: 0,0:06:30.51,0:06:31.51,Default,,0,0,0,,Мен енді жылап жібергім келеді!
Dialogue: 0,0:06:32.76,0:06:36.06,Default,,0,0,0,,Уф! Тааа!
Dialogue: 0,0:06:41.19,0:06:44.19,Default,,0,0,0,,Мен сенің сезіміңді түсінемін.
Dialogue: 0,0:06:47.36,0:06:51.12,Default,,0,0,0,,Бітім... Әлгі ит
Dialogue: 0,0:06:51.91,0:06:54.83,Default,,0,0,0,,Мен... ұйықтап жатырмын.
Dialogue: 0,0:06:56.37,0:06:58.96,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:06:58.96,0:07:00.12,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:06:58.96,0:07:00.12,Default,,0,0,0,,Кешіріңіз, менде осы ғана қалды.
Dialogue: 0,0:07:00.12,0:07:01.79,Default,,0,0,0,,Кешіріңіз, менде осы ғана қалды.
Dialogue: 0,0:07:01.88,0:07:03.71,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:07:03.79,0:07:06.30,Default,,0,0,0,,Міне болды! (Сасаки және т.б.) Ах.
Dialogue: 0,0:07:07.05,0:07:09.51,Default,,0,0,0,,Хмм... Ню?
Dialogue: 0,0:07:09.97,0:07:14.85,Default,,0,0,0,,Бейсбол итін іздеп жатыр. Юхи сырасының күту бөлмесінде қамтамасыз етілген.
Dialogue: 0,0:07:14.93,0:07:17.22,Default,,0,0,0,,Уф... Жақсы.
Dialogue: 0,0:07:17.31,0:07:19.85,Default,,0,0,0,,Тым~ Бұл жақсы емес, Томми.
Dialogue: 0,0:07:20.31,0:07:22.69,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз!
Dialogue: 0,0:07:22.90,0:07:26.65,Default,,0,0,0,,Ах... Жоқ, иә, бұл...
Dialogue: 0,0:07:30.24,0:07:31.24,Default,,0,0,0,,Ах
Dialogue: 0,0:07:34.16,0:07:36.58,Default,,0,0,0,,Ах... ит
Dialogue: 0,0:07:39.62,0:07:41.58,Default,,0,0,0,,Ит~!
Dialogue: 0,0:07:41.83,0:07:44.33,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:07:44.42,0:07:45.50,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:07:47.59,0:07:49.88,Default,,0,0,0,,Ах... ит...
Dialogue: 0,0:07:49.97,0:07:51.51,Default,,0,0,0,,Бұл «ит» емес!
Dialogue: 0,0:07:51.59,0:07:55.01,Default,,0,0,0,,Уф, а, а, жоқ, мынау ит...
Dialogue: 0,0:07:55.10,0:07:57.56,Default,,0,0,0,,Жұмысқа тезірек кірісіңіз!
Dialogue: 0,0:07:57.64,0:07:59.14,Default,,0,0,0,,Ух... уф
Dialogue: 0,0:08:02.02,0:08:03.31,Default,,0,0,0,,Я...
Dialogue: 0,0:08:03.77,0:08:05.77,Default,,0,0,0,,Алдағы жұмыс
Dialogue: 0,0:08:06.15,0:08:08.53,Default,,0,0,0,,Денем мен көңіл күйім ауыр.
Dialogue: 0,0:08:09.61,0:08:13.66,Default,,0,0,0,,Ол жұмысқа дұрыс орала ала ма?
Dialogue: 0,0:08:17.91,0:08:19.54,Default,,0,0,0,,Томми бейсбол иті
Dialogue: 0,0:08:19.87,0:08:24.58,Default,,0,0,0,,Салтанатты бірінші алаңнан кейін ол допты төрешіге керемет түрде жеткізді.
Dialogue: 0,0:08:27.63,0:08:29.76,Default,,0,0,0,,Бұл жігіт кәсіпқой.
Dialogue: 0,0:08:29.84,0:08:31.97,Default,,0,0,0,,Иттер керемет, солай емес пе?
Dialogue: 0,0:08:32.05,0:08:34.01,Default,,0,0,0,,Еңбекқор және мойынсұнғыш⸺
Dialogue: 0,0:08:34.38,0:08:35.68,Default,,0,0,0,,Басқа біреуге ұқсамайды⸺
Dialogue: 0,0:08:35.76,0:08:39.72,Default,,0,0,0,,Мен кешкі ауысымға ешқашан кешікпеймін.
Dialogue: 0,0:08:39.93,0:08:42.60,Default,,0,0,0,,Сіз түсінбейсіз, Накайзуми-сан.
Dialogue: 0,0:08:42.68,0:08:43.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:46.90,0:08:50.78,Default,,0,0,0,,Мен бүгін жақсырақ түсіндім.
Dialogue: 0,0:08:51.32,0:08:53.28,Default,,0,0,0,,Иттер мен адамдар да⸺
Dialogue: 0,0:08:53.36,0:08:57.78,Default,,0,0,0,,Кейде шаршап, жұмысқа алаңдаймын.
Dialogue: 0,0:08:58.45,0:08:59.45,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:03.66,0:09:06.54,Default,,0,0,0,,Сіздікі жай ғана ұйықтап жатқан шығар!
Dialogue: 0,0:09:06.63,0:09:08.96,Default,,0,0,0,,Жұмыста төрт рет ұйықтап қалдым!
Dialogue: 0,0:09:09.04,0:09:11.00,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:09:21.64,0:09:24.43,Default,,0,0,0,,Иә, аға, күте тұрыңыз~
Dialogue: 0,0:09:24.69,0:09:26.10,Default,,0,0,0,,Сәлем
Dialogue: 0,0:09:26.19,0:09:29.65,Default,,0,0,0,,Ах, Рурико-сан, сенің мойныңдағы орамал...
Dialogue: 0,0:09:30.02,0:09:32.65,Default,,0,0,0,,Иә? О, мынау?
Dialogue: 0,0:09:32.73,0:09:34.36,Default,,0,0,0,,Сәнді дизайнерлік аяқ киім алу үшін жинап жүрген 20 000 йенім...
Dialogue: 0,0:09:34.74,0:09:39.87,Default,,0,0,0,,Мен Руриконың Motor Sands тауарларын кигенін бірінші рет көруім.
Dialogue: 0,0:09:39.95,0:09:44.33,Default,,0,0,0,,Мен оны сатушы әріптесіммен жеке қарау сеансына барған кезде сатып алдым.
Dialogue: 0,0:09:44.41,0:09:47.75,Default,,0,0,0,,Сол күні ағам мені байқамаған...
Dialogue: 0,0:09:47.83,0:09:48.83,Default,,0,0,0,,Уф
Dialogue: 0,0:09:53.01,0:09:55.26,Default,,0,0,0,,А... сол күні?
Dialogue: 0,0:09:55.34,0:09:57.63,Default,,0,0,0,,Кешіріңіз, бұл бөлім
Dialogue: 0,0:09:57.84,0:10:01.14,Default,,0,0,0,,Менің айтайын дегенім, сен маған қарап тұрсың.
Dialogue: 0,0:10:01.22,0:10:04.10,Default,,0,0,0,,Сен маған көп қарап тұрсың, солай ма? Хмм?
Dialogue: 0,0:10:04.43,0:10:08.10,Default,,0,0,0,,Жоқ, олай емес... уф, кешіріңіз.
Dialogue: 0,0:10:08.19,0:10:10.94,Default,,0,0,0,,Иә, біз 1000 иенді сақтаймыз.
Dialogue: 0,0:10:11.44,0:10:15.90,Default,,0,0,0,,А... Мен қос көр қазып жатқаныма сенбеймін.
Dialogue: 0,0:10:16.11,0:10:18.99,Default,,0,0,0,,Айтайын дегенім, ағаңның тауары жоқ па?
Dialogue: 0,0:10:19.28,0:10:21.20,Default,,0,0,0,,Иносукэ… Иносукэ, өзіңді жина! Иносукэ!
Dialogue: 0,0:10:21.28,0:10:23.79,Default,,0,0,0,,Эй... сен мені жақсы сұрадың.
Dialogue: 0,0:10:23.87,0:10:25.00,Default,,0,0,0,,Қауіп-қатер сезімінің жоқтығы.
Dialogue: 0,0:10:25.08,0:10:28.37,Default,,0,0,0,,Іс жүзінде бұл әмиян Motor Sands тауарлары.
Dialogue: 0,0:10:28.46,0:10:30.54,Default,,0,0,0,,Бұл жай ғана дірілдеген әмиян.
Dialogue: 0,0:10:30.63,0:10:32.46,Default,,0,0,0,,Мұқият қараңыз
Dialogue: 0,0:10:32.92,0:10:36.72,Default,,0,0,0,,Бұл нәзік гравюра сәл жағымсыз емес пе?
Dialogue: 0,0:10:37.22,0:10:38.93,Default,,0,0,0,,Motor Sands тауарларына ⸺ кіреді
Dialogue: 0,0:10:39.01,0:10:40.14,Default,,0,0,0,,«Оңай күндер» деп аталады⸺
Dialogue: 0,0:10:40.22,0:10:42.14,Default,,0,0,0,,Мен сияқты сериал бар⸺
Dialogue: 0,0:10:42.22,0:10:45.31,Default,,0,0,0,,Оны үнемі қолданғысы келетін адамдар үшін өте қолайлы.
Dialogue: 0,0:10:45.89,0:10:49.06,Default,,0,0,0,,Бұл әмиянның терісі қолғаппен бірдей материал⸺
Dialogue: 0,0:10:49.14,0:10:51.77,Default,,0,0,0,,Неғұрлым көп пайдалансаңыз, соғұрлым дәмі болады.
Dialogue: 0,0:10:51.86,0:10:55.28,Default,,0,0,0,,Ол тіпті рұқсат қағазымен бірге келеді және өте функционалды...
Dialogue: 0,0:10:55.36,0:10:57.53,Default,,0,0,0,,Иә, иә, мен жеңілдім, жеңілдім.
Dialogue: 0,0:10:57.61,0:10:58.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:58.82,0:11:01.99,Default,,0,0,0,,Тауарды жақсы көру сайысында аға жеңеді
Dialogue: 0,0:11:02.07,0:11:04.62,Default,,0,0,0,,Иә, менде біраз өзгеріс бар.
Dialogue: 0,0:11:04.70,0:11:06.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:07.45,0:11:10.50,Default,,0,0,0,,Мен... Мен тым көп сөйледім.
Dialogue: 0,0:11:13.88,0:11:16.76,Default,,0,0,0,,7-ші иннингтің төменгі жағы?
Dialogue: 0,0:11:16.84,0:11:18.92,Default,,0,0,0,,Аяқтауға жақын.
Dialogue: 0,0:11:19.01,0:11:22.64,Default,,0,0,0,,Мен бүгін ең жақсы сатылымымды жаңартқым келеді.
Dialogue: 0,0:11:22.72,0:11:23.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:27.31,0:11:30.35,Default,,0,0,0,,Әмиян... Бұл жоғалған зат.
Dialogue: 0,0:11:30.44,0:11:31.60,Default,,0,0,0,,Екеуін біз қараймыз.
Dialogue: 0,0:11:31.69,0:11:34.56,Default,,0,0,0,,Бұл тербеліс сенің ағаңдікі.
Dialogue: 0,0:11:38.74,0:11:43.07,Default,,0,0,0,,Сен ақымақсың~ Құмарланып сөйлеп тұрсаң да.
Dialogue: 0,0:11:49.12,0:11:51.46,Default,,0,0,0,,Хмм.
Dialogue: 0,0:11:52.04,0:11:53.42,Default,,0,0,0,,Маңызы бар деп саналатын бір куәгерлік көрсету бар
Dialogue: 0,0:11:53.67,0:11:56.29,Default,,0,0,0,,Үлкен аға... Иә?
Dialogue: 0,0:11:56.71,0:12:00.92,Default,,0,0,0,,Не? Ол жерде жоқ. Бұл әжетхана ма?
Dialogue: 0,0:12:06.89,0:12:08.60,Default,,0,0,0,,Ммм!
Dialogue: 0,0:12:08.68,0:12:13.31,Default,,0,0,0,,Адамдардың ізгі ниетін таптап жатырсың, ағайын!
Dialogue: 0,0:12:13.40,0:12:16.73,Default,,0,0,0,,Ойынның тұрғыны сияқты қимылсыз болыңыз!
Dialogue: 0,0:12:20.57,0:12:21.86,Default,,0,0,0,,Мұнда емес.
Dialogue: 0,0:12:23.24,0:12:24.61,Default,,0,0,0,,Мұнда емес.
Dialogue: 0,0:12:26.20,0:12:28.37,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:12:29.20,0:12:30.54,Default,,0,0,0,,Азассу
Dialogue: 0,0:12:30.62,0:12:33.25,Default,,0,0,0,,Сенің ағаң қайда!?
Dialogue: 0,0:12:33.33,0:12:34.88,Default,,0,0,0,,Үлкен аға!
Dialogue: 0,0:12:34.96,0:12:37.50,Default,,0,0,0,,Уа, уай, уай... Кешіріңіз!
Dialogue: 0,0:12:38.42,0:12:39.46,Default,,0,0,0,,Я...
Dialogue: 0,0:12:39.55,0:12:42.47,Default,,0,0,0,,Ал, мен есепшотты төлеу үшін қайтуым керек.
Dialogue: 0,0:12:42.67,0:12:46.80,Default,,0,0,0,,Әмиянды күзетшіге кейінірек беруім керек пе?
Dialogue: 0,0:12:50.27,0:12:52.43,Default,,0,0,0,,Кеш жарық.
Dialogue: 0,0:12:52.52,0:12:53.89,Default,,0,0,0,,Рурико
Dialogue: 0,0:12:53.98,0:12:57.06,Default,,0,0,0,,Төлем Сіз соңғысыз, асығыңыз.
Dialogue: 0,0:12:57.15,0:12:59.94,Default,,0,0,0,,Әй, бұл...
Dialogue: 0,0:13:00.03,0:13:01.11,Default,,0,0,0,,Ах
Dialogue: 0,0:13:02.82,0:13:04.78,Default,,0,0,0,,100 иен жеткіліксіз!
Dialogue: 0,0:13:04.86,0:13:07.12,Default,,0,0,0,,Хм... Қызық, қай тұтынушы?
Dialogue: 0,0:13:07.37,0:13:10.74,Default,,0,0,0,,Ақшаның оған тұрарлық емес екеніне сенімдісіз бе?
Dialogue: 0,0:13:10.83,0:13:15.21,Default,,0,0,0,,Хия... мүмкін 100 иен жеткіліксіз шығар? Бұл
Dialogue: 0,0:13:15.58,0:13:19.54,Default,,0,0,0,,100 иен Сыймаса да бұл үлкен мәселе дейді, солай ма?
Dialogue: 0,0:13:19.63,0:13:22.21,Default,,0,0,0,,Бұл... Иә, бұл...
Dialogue: 0,0:13:22.63,0:13:26.13,Default,,0,0,0,,Рурико, тұтынушы қоңырау шалып жатыр, сондықтан базаға барыңыз.
Dialogue: 0,0:13:26.22,0:13:28.14,Default,,0,0,0,,Иә?Иә
Dialogue: 0,0:13:28.22,0:13:30.47,Default,,0,0,0,,Мен біраз уақытқа барамын.
Dialogue: 0,0:13:31.14,0:13:34.39,Default,,0,0,0,,А... Мен бүгін бос емеспін.
Dialogue: 0,0:13:35.31,0:13:37.60,Default,,0,0,0,,Жоқ, яғни, ол қайда…
Dialogue: 0,0:13:37.81,0:13:39.48,Default,,0,0,0,,Бауырым!
Dialogue: 0,0:13:39.56,0:13:41.07,Default,,0,0,0,,Кете барсам, қоштасу сүйісін бересің бе?
Dialogue: 0,0:13:41.27,0:13:43.24,Default,,0,0,0,,Сіз қайда болдыңыз?
Dialogue: 0,0:13:43.32,0:13:46.49,Default,,0,0,0,,Бауырым, мен сені іздеп стадионды аралап шықтым...
Dialogue: 0,0:13:46.57,0:13:49.57,Default,,0,0,0,,Кешіріңіз, мен қазір беремін.
Dialogue: 0,0:13:49.66,0:13:52.24,Default,,0,0,0,,Иә? Не?
Dialogue: 0,0:13:52.45,0:13:54.29,Default,,0,0,0,,Не, өзгерту?
Dialogue: 0,0:13:54.37,0:13:57.37,Default,,0,0,0,,Мен тағы 100 иен алдым, сондықтан оны өзіммен бірге алып келдім.
Dialogue: 0,0:13:57.46,0:13:59.00,Default,,0,0,0,,Иә? (Мұрата) А?
Dialogue: 0,0:13:59.08,0:14:01.13,Default,,0,0,0,,Сондықтан мені іздедіңіз...
Dialogue: 0,0:14:01.42,0:14:05.92,Default,,0,0,0,,Ах... Не? Бұл ағаңыздың кезінде болды ма?
Dialogue: 0,0:14:06.01,0:14:08.05,Default,,0,0,0,,Хаха шешілді!
Dialogue: 0,0:14:08.26,0:14:11.05,Default,,0,0,0,,Иә? Сосын саған беремін.
Dialogue: 0,0:14:11.14,0:14:14.27,Default,,0,0,0,,Не? Бұл біртүрлі
Dialogue: 0,0:14:14.47,0:14:18.06,Default,,0,0,0,,Иә? жоқ! жоқ! Менде әмиян жоқ!
Dialogue: 0,0:14:18.14,0:14:20.27,Default,,0,0,0,,Е, қайда, қайда!? Хехе
Dialogue: 0,0:14:20.36,0:14:21.86,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:22.94,0:14:25.36,Default,,0,0,0,,Әй, менің әмияным!
Dialogue: 0,0:14:25.61,0:14:27.82,Default,,0,0,0,,Ненің құлап жатқанын табыңыз
Dialogue: 0,0:14:27.90,0:14:31.12,Default,,0,0,0,,Мен оны сізге жеткізгім келді, бірақ ағаңыз орнында болмады.
Dialogue: 0,0:14:31.20,0:14:35.00,Default,,0,0,0,,Не? Аа, кешіріңіз, шынымен кешіріңіз!
Dialogue: 0,0:14:35.08,0:14:39.12,Default,,0,0,0,,Мен Рурико-санға ақшаны қайтару үшін бүкіл стадионды ақтардым.
Dialogue: 0,0:14:39.50,0:14:40.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:40.96,0:14:44.92,Default,,0,0,0,,Біз бір-бірімізді кесіп өттік пе? Ахах... Кешіріңіз.
Dialogue: 0,0:14:45.26,0:14:46.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:57.14,0:14:59.60,Default,,0,0,0,,Иә, әрине 100 иен
Dialogue: 0,0:14:59.98,0:15:05.07,Default,,0,0,0,,Менің болмаған себебім, олар мені іздеді.
Dialogue: 0,0:15:05.15,0:15:07.90,Default,,0,0,0,,Не? Ах, мм
Dialogue: 0,0:15:07.99,0:15:11.03,Default,,0,0,0,,Иә, кешіріңіз.
Dialogue: 0,0:15:14.12,0:15:18.75,Default,,0,0,0,,Олай болса, әмиян үшін көп рахмет.
Dialogue: 0,0:15:20.67,0:15:21.67,Default,,0,0,0,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,0:15:21.75,0:15:23.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:24.34,0:15:28.17,Default,,0,0,0,,Мені стадионнан іздегеніңізге рахмет.
Dialogue: 0,0:15:28.97,0:15:30.22,Default,,0,0,0,,Біз жіберген жасақ мүшелері жойылып қалған сияқты.
Dialogue: 0,0:15:30.30,0:15:31.30,Default,,0,0,0,,Ах
Dialogue: 0,0:15:32.72,0:15:34.01,Default,,0,0,0,,Ха, ха, ха!
Dialogue: 0,0:15:34.10,0:15:36.18,Default,,0,0,0,,Ах... Не?
Dialogue: 0,0:15:36.26,0:15:39.31,Default,,0,0,0,,Иә, кездескенше.
Dialogue: 0,0:15:39.39,0:15:41.56,Default,,0,0,0,,Иә, онда...
Dialogue: 0,0:15:44.56,0:15:48.99,Default,,0,0,0,,Иә? Рурико-сан, сен менің атымды білдің бе?
Dialogue: 0,0:16:02.67,0:16:04.04,Default,,0,0,0,,Жарайсыңдар⸺
Dialogue: 0,0:16:04.13,0:16:05.46,Default,,0,0,0,,Менің ойымша, сіз тыңдап жатырсыз⸺
Dialogue: 0,0:16:05.54,0:16:07.80,Default,,0,0,0,,Енді Motor Sands-те бірінші⸺
Dialogue: 0,0:16:07.88,0:16:11.30,Default,,0,0,0,,Климакс сериясына көтерілуді мақсат ету...
Dialogue: 0,0:16:11.51,0:16:13.64,Default,,0,0,0,,«КҮН КӨРСЕТ»⸺
Dialogue: 0,0:16:13.72,0:16:15.89,Default,,0,0,0,,Аудиторияны осы күн логотипі орамалмен жабыңыз⸺
Dialogue: 0,0:16:15.97,0:16:17.51,Default,,0,0,0,,Олқылықтың орнын толтыру науқаны⸺
Dialogue: 0,0:16:17.60,0:16:18.77,Default,,0,0,0,,Орындау
Dialogue: 0,0:16:18.97,0:16:20.60,Default,,0,0,0,,Біз де...
Dialogue: 0,0:16:20.68,0:16:22.48,Default,,0,0,0,,Өткен күні кешігіп қалдым⸺
Dialogue: 0,0:16:22.56,0:16:25.81,Default,,0,0,0,,Маған Накайзуми мырза телефон соқты, мен қатты қорықтым.
Dialogue: 0,0:16:26.15,0:16:27.36,Default,,0,0,0,,Иә.
Dialogue: 0,0:16:27.44,0:16:30.69,Default,,0,0,0,,SNS буыны телефонды пайдалануға үйренбеген.
Dialogue: 0,0:16:30.90,0:16:32.86,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:16:32.95,0:16:36.66,Default,,0,0,0,,Қоңырау шалғанда шошып кетемін.
Dialogue: 0,0:16:36.74,0:16:38.20,Default,,0,0,0,,Түсіндім! Ах
Dialogue: 0,0:16:38.83,0:16:42.62,Default,,0,0,0,,Телефон қоңыраулары таң қалдырады, солай емес пе?
Dialogue: 0,0:16:42.71,0:16:44.46,Default,,0,0,0,,'Жоқ—ол қайта қосылып жатыр ма? Бөлініп кеткен бөліктері…'
Dialogue: 0,0:16:44.54,0:16:48.04,Default,,0,0,0,,Эй Накайзуми-сан, таң қалма!
Dialogue: 0,0:16:48.13,0:16:50.46,Default,,0,0,0,,Менің жүрегім тоқтап қалады деп ойладым!
Dialogue: 0,0:16:50.55,0:16:53.72,Default,,0,0,0,,Мен неге жаман адаммын! Кездесу барысында жеке сөйлесуге қатаң тыйым салынады!
Dialogue: 0,0:16:53.80,0:16:55.72,Default,,0,0,0,,Кешіріңіз~
Dialogue: 0,0:17:03.39,0:17:04.60,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:06.81,0:17:09.82,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:17:10.02,0:17:11.03,Default,,0,0,0,,Уау
Dialogue: 0,0:17:11.32,0:17:13.65,Default,,0,0,0,,Телефон қоңыраулары мені қобалжытады, солай емес пе?
Dialogue: 0,0:17:14.82,0:17:16.32,Default,,0,0,0,,Ю... Юки?
Dialogue: 0,0:17:17.07,0:17:19.99,Default,,0,0,0,,Ойынның алдында үнемі телефон соғып тұрмасам да.
Dialogue: 0,0:17:20.08,0:17:21.95,Default,,0,0,0,,Директор осында.
Dialogue: 0,0:17:22.04,0:17:24.79,Default,,0,0,0,,Жалпы жиналыс басталады
Dialogue: 0,0:17:29.34,0:17:34.22,Default,,0,0,0,,Маусым аяқталуға жақын, бірақ біз қазір 3-ші орыннан 1 ойынға қалып, 4-орындамыз.
Dialogue: 0,0:17:34.30,0:17:39.26,Default,,0,0,0,,Енді біз CS-ке алғаш рет кіруге бір қадам қалдық, біз сізге сұрақ қоямыз.
Dialogue: 0,0:17:40.43,0:17:43.73,Default,,0,0,0,,Неліктен біз CS-ге барамыз?
Dialogue: 0,0:17:46.85,0:17:48.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:48.10,0:17:51.82,Default,,0,0,0,,Мен CS-тен тыс Жапониядағы ең үздік болғым келеді.
Dialogue: 0,0:17:51.90,0:17:53.74,Default,,0,0,0,,Достарыма... (Шишио) Ах.
Dialogue: 0,0:17:54.19,0:17:56.49,Default,,0,0,0,,Бұл жанкүйерлерді мойындау үшін!
Dialogue: 0,0:17:56.78,0:17:58.20,Default,,0,0,0,,Бізге сеніңіз⸺
Dialogue: 0,0:17:58.28,0:17:59.82,Default,,0,0,0,,Сахна артындағылар үшін
Dialogue: 0,0:18:00.12,0:18:03.91,Default,,0,0,0,,(Деннис Ағылшын тілі)
Dialogue: 0,0:18:04.33,0:18:06.79,Default,,0,0,0,,«Бейсбол құдайының сүйіктісіне айналу».
Dialogue: 0,0:18:07.04,0:18:09.17,Default,,0,0,0,,(Брайанның ағылшыншасы)
Dialogue: 0,0:18:09.25,0:18:11.71,Default,,0,0,0,,Және көп ақша
Dialogue: 0,0:18:11.80,0:18:14.88,Default,,0,0,0,,«Мен екенімді дәлелдеу үшін»
Dialogue: 0,0:18:14.96,0:18:16.80,Default,,0,0,0,,«Және көп ақша»
Dialogue: 0,0:18:16.88,0:18:18.80,Default,,0,0,0,,(Барлығы күледі)
Dialogue: 0,0:18:19.22,0:18:21.39,Default,,0,0,0,,Мені үнемі қолдайтын отбасым⸺
Dialogue: 0,0:18:21.47,0:18:22.76,Default,,0,0,0,,Ең бастысы⸺
Dialogue: 0,0:18:22.85,0:18:25.39,Default,,0,0,0,,Жанкүйерлерге алғыс
Dialogue: 0,0:18:25.64,0:18:29.06,Default,,0,0,0,,Егер CS сатысы жақсылықты өтеу болса...
Dialogue: 0,0:18:29.40,0:18:31.15,Default,,0,0,0,,Мақтаныш үшін
Dialogue: 0,0:18:31.40,0:18:34.28,Default,,0,0,0,,Жоқ, мақтанышымды қайтару үшін.
Dialogue: 0,0:18:34.65,0:18:37.61,Default,,0,0,0,,Бейсболда жақсырақ болу
Dialogue: 0,0:18:37.86,0:18:39.95,Default,,0,0,0,,Еркек болып, ұсыныс жаса...
Dialogue: 0,0:18:40.03,0:18:43.58,Default,,0,0,0,,Жоқ, бұл... Болды!
Dialogue: 0,0:18:43.79,0:18:47.16,Default,,0,0,0,,Біз білмейтін бейсбол туралы білу
Dialogue: 0,0:18:47.58,0:18:48.58,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:18:48.83,0:18:52.29,Default,,0,0,0,,Кодзиро, қалайсың, капитан?
Dialogue: 0,0:18:56.05,0:18:59.63,Default,,0,0,0,,Кодзиро мырза Жапониядағы ең жақсы тәжірибеге ие жалғыз адам.
Dialogue: 0,0:18:59.97,0:19:02.05,Default,,0,0,0,,Қандай сөздер айтасың?
Dialogue: 0,0:19:05.39,0:19:06.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:06.60,0:19:10.69,Default,,0,0,0,,Команда CS-ге өту үшін жиналуда
Dialogue: 0,0:19:11.06,0:19:13.90,Default,,0,0,0,,Мен бұрын-соңды мұндай көңіл-күйде болған емеспін.
Dialogue: 0,0:19:14.27,0:19:18.03,Default,,0,0,0,,Мен де ұжымды шабыттандыратын құмарлығымды жеткізгім келеді.
Dialogue: 0,0:19:18.11,0:19:18.74,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:19:18.74,0:19:19.45,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:19:18.74,0:19:19.45,Default,,0,0,0,,(Ұялы телефонның діріл дыбысы)
Dialogue: 0,0:19:19.45,0:19:19.53,Default,,0,0,0,,(Ұялы телефонның діріл дыбысы)
Dialogue: 0,0:19:19.53,0:19:22.70,Default,,0,0,0,,(Ұялы телефонның діріл дыбысы)
Dialogue: 0,0:19:19.53,0:19:22.70,Default,,0,0,0,,Юки маған супер онии-ден беріп жатыр!
Dialogue: 0,0:19:22.70,0:19:22.91,Default,,0,0,0,,(Ұялы телефонның діріл дыбысы)
Dialogue: 0,0:19:22.91,0:19:23.87,Default,,0,0,0,,(Ұялы телефонның діріл дыбысы)
Dialogue: 0,0:19:22.91,0:19:23.87,Default,,0,0,0,,Ммм...
Dialogue: 0,0:19:23.87,0:19:25.70,Default,,0,0,0,,Ммм...
Dialogue: 0,0:19:25.79,0:19:29.46,Default,,0,0,0,,Сәлем Кодзиро Сәлем
Dialogue: 0,0:19:30.00,0:19:33.21,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:19:33.63,0:19:37.26,Default,,0,0,0,,№ 7 Жарық Кодзиро
Dialogue: 0,0:19:39.42,0:19:40.59,Default,,0,0,0,,Фу…
Dialogue: 0,0:19:42.30,0:19:44.30,Default,,0,0,0,,Ямада-чан, сенде лимон жоқ па?
Dialogue: 0,0:19:44.39,0:19:47.02,Default,,0,0,0,,Сондықтан жоқ.
Dialogue: 0,0:19:48.14,0:19:51.56,Default,,0,0,0,,Қуырылған тауық етіне лимон әкелуім керек пе?
Dialogue: 0,0:19:51.64,0:19:52.90,Default,,0,0,0,,Әпке, иә?
Dialogue: 0,0:19:52.98,0:19:54.90,Default,,0,0,0,,О, Рурико-чан
Dialogue: 0,0:19:54.98,0:19:57.15,Default,,0,0,0,,Стадиондағы қуырылған тауық еті
Dialogue: 0,0:19:57.23,0:19:58.94,Default,,0,0,0,,Сізге бірдеңе жетіспейді ме?
Dialogue: 0,0:19:59.28,0:20:02.74,Default,,0,0,0,,Рахмет, бірақ мен бүгін сыраны өткізіп жіберемін.
Dialogue: 0,0:20:02.82,0:20:04.82,Default,,0,0,0,,Не? Солай ма?
Dialogue: 0,0:20:04.91,0:20:06.66,Default,,0,0,0,,Мм, түсіндім.
Dialogue: 0,0:20:06.74,0:20:09.62,Default,,0,0,0,,Сыраны қаламайсыз ба?
Dialogue: 0,0:20:09.87,0:20:12.62,Default,,0,0,0,,Хехе, мен көмектесе алмаймын.
Dialogue: 0,0:20:12.71,0:20:14.50,Default,,0,0,0,,Маған бір тамақ беріңізші.
Dialogue: 0,0:20:14.71,0:20:16.59,Default,,0,0,0,,Хаха, солай!
Dialogue: 0,0:20:16.67,0:20:18.63,Default,,0,0,0,,Ора Кодзиро! иә?
Dialogue: 0,0:20:18.92,0:20:20.97,Default,,0,0,0,,Мені міндетті түрде ұр, бейбақ!
Dialogue: 0,0:20:21.05,0:20:25.09,Default,,0,0,0,,Мен сенің тағы жұмыстан қуылғаныңды қаламаймын!
Dialogue: 0,0:20:25.30,0:20:28.81,Default,,0,0,0,,Талай қариялар мені тағы да ерсі етті.
Dialogue: 0,0:20:28.89,0:20:31.31,Default,,0,0,0,,Жарайды, Рурико-чан, иә?
Dialogue: 0,0:20:31.52,0:20:34.52,Default,,0,0,0,,Құлақшының енді бір сүйіспеншілігі болды.
Dialogue: 0,0:20:34.60,0:20:37.02,Default,,0,0,0,,Анау қарттар да өсіп жатыр емес пе?
Dialogue: 0,0:20:37.36,0:20:39.61,Default,,0,0,0,,Хехе, өсіп жатырсың~
Dialogue: 0,0:20:39.90,0:20:42.61,Default,,0,0,0,,Маған неге қарайсың?
Dialogue: 0,0:20:42.70,0:20:46.82,Default,,0,0,0,,Хехе, әпке, жүзіңіз мейірімді болып кетті.
Dialogue: 0,0:20:47.03,0:20:49.79,Default,,0,0,0,,Иә? Бұл... бұл ...
Dialogue: 0,0:20:49.99,0:20:52.79,Default,,0,0,0,,Эххе, солай!
Dialogue: 0,0:20:54.21,0:20:54.71,Default,,0,0,0,,Фу…
Dialogue: 0,0:20:54.71,0:20:55.38,Default,,0,0,0,,Фу…
Dialogue: 0,0:20:54.71,0:20:55.38,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:20:55.38,0:20:56.38,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:20:56.38,0:20:57.71,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:20:56.38,0:20:57.71,Default,,0,0,0,,Қалай болғанда да...
Dialogue: 0,0:20:57.71,0:21:00.76,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:21:03.80,0:21:06.47,Default,,0,0,0,,Біз жақсы командаға айналдық.
Dialogue: 0,0:21:06.89,0:21:08.01,Default,,0,0,0,,Хмм
Dialogue: 0,0:21:09.93,0:21:10.68,Default,,0,0,0,,Хамф!
Dialogue: 0,0:21:10.68,0:21:11.22,Default,,0,0,0,,Хамф!
Dialogue: 0,0:21:10.68,0:21:11.22,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:21:11.22,0:21:14.35,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:21:18.23,0:21:20.73,Default,,0,0,0,,Кодзиро-сан, бүгін керемет болды.
Dialogue: 0,0:21:20.82,0:21:21.99,Default,,0,0,0,,5/5
Dialogue: 0,0:21:22.07,0:21:25.07,Default,,0,0,0,,А, капитан күткендей.
Dialogue: 0,0:21:25.15,0:21:28.70,Default,,0,0,0,,Коджи-сан, команда өте жақсы көрінеді.
Dialogue: 0,0:21:28.78,0:21:30.87,Default,,0,0,0,,Ол ұран да өте жақсы.
Dialogue: 0,0:21:31.08,0:21:32.33,Default,,0,0,0,,Қараңызшы...
Dialogue: 0,0:21:32.83,0:21:34.41,Default,,0,0,0,,На… «КҮН КӨРСЕТ»
Dialogue: 0,0:21:34.50,0:21:36.21,Default,,0,0,0,,Сонымен... кім сұрады!?
Dialogue: 0,0:21:36.29,0:21:39.50,Default,,0,0,0,,О, мен әлі Сан туралы шешім қабылдаған жоқпын...
Dialogue: 0,0:21:39.96,0:21:41.25,Default,,0,0,0,,Мм... иә?
Dialogue: 0,0:21:41.67,0:21:45.43,Default,,0,0,0,,Ах... А, жоқ, кешіріңіз, бұл ештеңе емес.
Dialogue: 0,0:21:45.51,0:21:49.39,Default,,0,0,0,,Амансың ба? Өзіңізді итермеңіз, хехехе
Dialogue: 0,0:22:01.32,0:22:03.57,Default,,0,0,0,,Ең алдымен, техникалық колледжде—
Dialogue: 0,0:22:04.74,0:22:05.82,Default,,0,0,0,,Рахмет
Dialogue: 0,0:22:08.82,0:22:13.45,Default,,0,0,0,,Бұл менің CS-те көрінуімнің жалғыз себебі
Dialogue: 0,0:22:15.00,0:22:20.00,Default,,0,0,0,,♪～
Dialogue: 0,0:23:39.96,0:23:44.96,Default,,0,0,0,,～♪
