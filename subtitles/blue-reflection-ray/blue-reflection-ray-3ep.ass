Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:34.51,0:01:43.12,Default,,0,0,0,,Сен
Dialogue: 0,0:01:43.12,0:01:47.52,Default,,0,0,0,,≪Кішкентай кезімнен әдемі және жылтыр нәрселерді ұнататынмын≫
Dialogue: 0,0:01:48.89,0:01:50.92,Default,,0,0,0,,Хаха
Dialogue: 0,0:01:50.92,0:01:53.63,Default,,0,0,0,,Ах. Хаха.
Dialogue: 0,0:01:53.63,0:01:55.66,Default,,0,0,0,,Ана, мынау!
Dialogue: 0,0:01:55.66,0:01:58.37,Default,,0,0,0,,Ах... уф!
Dialogue: 0,0:01:58.37,0:02:01.84,Default,,0,0,0,,≪Рефлексия... көзіңе нұр
Dialogue: 0,0:02:01.84,0:02:05.84,Default,,0,0,0,,Жарқырап, осында екеніңді айт
Dialogue: 0,0:02:07.24,0:02:09.28,Default,,0,0,0,,Мен бір күні сенімдімін...≫
Dialogue: 0,0:02:09.28,0:02:14.18,Default,,0,0,0,,Сен
Dialogue: 0,0:02:14.18,0:02:16.18,Default,,0,0,0,,≪Себебі сізді табуға болады≫
Dialogue: 0,0:02:19.55,0:02:34.37,Default,,0,0,0,,Сен
Dialogue: 0,0:02:34.37,0:02:36.40,Default,,0,0,0,,Фрагмент…
Dialogue: 0,0:02:36.40,0:02:40.07,Default,,0,0,0,,Бұл Мияко-чанның ойларының бір бөлігі.
Dialogue: 0,0:02:40.07,0:02:42.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:42.11,0:02:45.01,Default,,0,0,0,,Мен оны қорғауым керек. Эй!
Dialogue: 0,0:02:46.51,0:02:49.32,Default,,0,0,0,,Мен саған Хана-чанды бермеймін.
Dialogue: 0,0:02:49.32,0:02:51.35,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:02:51.35,0:02:53.39,Default,,0,0,0,,Уф...｡ Бум!
Dialogue: 0,0:02:53.39,0:02:57.19,Default,,0,0,0,,Сен
Dialogue: 0,0:02:57.19,0:03:00.53,Default,,0,0,0,,Рука-чан, жасырын! Бірақ...
Dialogue: 0,0:03:00.53,0:03:04.93,Default,,0,0,0,,Сен
Dialogue: 0,0:03:04.93,0:03:09.54,Default,,0,0,0,,Уфуфу. Бұл жолы жолыма түсуге жол бермеймін.
Dialogue: 0,0:03:09.54,0:03:12.91,Default,,0,0,0,,Сақинаңызды лақтырып, кетіңіз.
Dialogue: 0,0:03:12.91,0:03:15.04,Default,,0,0,0,,Менің ойларымның үзінділері...
Dialogue: 0,0:03:15.04,0:03:17.78,Default,,0,0,0,,Мияко-чанмен не істеуді жоспарлап отырсыз?
Dialogue: 0,0:03:17.78,0:03:21.15,Default,,0,0,0,,Маған бұл туралы айтудың қажеті жоқ
Dialogue: 0,0:03:21.15,0:03:24.18,Default,,0,0,0,,Мен...
Dialogue: 0,0:03:24.18,0:03:26.85,Default,,0,0,0,,Мен Мияко-чанды жалғыз қалдырмаймын.
Dialogue: 0,0:03:26.85,0:03:46.51,Default,,0,0,0,,Сен
Dialogue: 0,0:03:46.51,0:03:57.65,Default,,0,0,0,,Сен
Dialogue: 0,0:03:57.65,0:04:02.42,Default,,0,0,0,,Сен
Dialogue: 0,0:04:02.42,0:04:21.44,Default,,0,0,0,,Сен
Dialogue: 0,0:04:21.44,0:04:37.29,Default,,0,0,0,,Сен
Dialogue: 0,0:04:37.29,0:04:40.69,Default,,0,0,0,,Сен
Dialogue: 0,0:04:40.69,0:04:56.09,Default,,0,0,0,,Сен
Dialogue: 0,0:04:57.51,0:05:02.51,Default,,0,0,0,,Қалаан Қалаан Қалаан… (қоңырау дыбысы)
Dialogue: 0,0:05:11.59,0:05:14.66,Default,,0,0,0,,Сен
Dialogue: 0,0:05:14.66,0:05:18.60,Default,,0,0,0,,≪Бұл жігіт не өзі?!≫
Dialogue: 0,0:05:18.60,0:05:22.24,Default,,0,0,0,,Не? Хаа ха ха...｡ Ах
Dialogue: 0,0:05:22.24,0:05:25.97,Default,,0,0,0,,≪Бұрын-соңды секіріс ауқымы мұнша кеңейген емес≫
Dialogue: 0,0:05:25.97,0:05:28.48,Default,,0,0,0,,≪Жер бетінде не болды...≫
Dialogue: 0,0:05:28.48,0:05:31.21,Default,,0,0,0,,Қарғыс атсын! Ха ха ха ха...
Dialogue: 0,0:05:31.21,0:05:33.25,Default,,0,0,0,,Гакин! Уф!
Dialogue: 0,0:05:33.25,0:05:36.52,Default,,0,0,0,,Уф... уф! Арх!
Dialogue: 0,0:05:36.52,0:05:38.55,Default,,0,0,0,,Бұл не? сол екеуі
Dialogue: 0,0:05:38.55,0:05:42.35,Default,,0,0,0,,Ха…｡ Ку… ха! Күрсін...
Dialogue: 0,0:05:43.62,0:05:46.83,Default,,0,0,0,,Сонымен қатар, менің жүрегім...
Dialogue: 0,0:05:46.83,0:05:50.60,Default,,0,0,0,,Сен
Dialogue: 0,0:05:50.60,0:05:54.00,Default,,0,0,0,,Мен ол балаға жаным ашиды...
Dialogue: 0,0:05:55.97,0:05:58.00,Default,,0,0,0,,Ха! Уф!
Dialogue: 0,0:05:58.00,0:06:01.27,Default,,0,0,0,,Уф! Арх! Гррр...
Dialogue: 0,0:06:01.27,0:06:03.38,Default,,0,0,0,,Неге мені жалғыз қалдырмайсың?
Dialogue: 0,0:06:03.38,0:06:07.35,Default,,0,0,0,,Адамдарды өз күштерін қалай пайдалану керектігін білмей күлдіріңіз
Dialogue: 0,0:06:07.35,0:06:11.45,Default,,0,0,0,,Қазір ғана бас тартқан дұрыс емес пе?
Dialogue: 0,0:06:11.45,0:06:15.19,Default,,0,0,0,,Ол бала өзгере алмайтын сияқты.
Dialogue: 0,0:06:15.19,0:06:18.26,Default,,0,0,0,,Иә, айтыңызшы.
Dialogue: 0,0:06:18.26,0:06:20.83,Default,,0,0,0,,Неге бұлай істеп жатырсың?
Dialogue: 0,0:06:20.83,0:06:24.76,Default,,0,0,0,,Рефлектор – біреудің ойын қорғайтын нәрсе...
Dialogue: 0,0:06:24.76,0:06:28.36,Default,,0,0,0,,Мен айттым ба? Маған үйретудің қажеті жоқ
Dialogue: 0,0:06:30.37,0:06:32.67,Default,,0,0,0,,Бассейн! Уф!
Dialogue: 0,0:06:32.67,0:06:36.31,Default,,0,0,0,,Ах. Қарғыс атсын! (2 адам) Әй!
Dialogue: 0,0:06:36.31,0:06:39.08,Default,,0,0,0,,Айтыңызшы! (Нина) Әй!
Dialogue: 0,0:06:39.08,0:06:42.58,Default,,0,0,0,,Неліктен сіз күресу үшін ұзаққа барасыз?
Dialogue: 0,0:06:42.58,0:06:45.72,Default,,0,0,0,,Себебі біреу қиналып жатыр.
Dialogue: 0,0:06:45.72,0:06:47.89,Default,,0,0,0,,Сіз ештеңені жалғыз қалдыра алмайсыз
Dialogue: 0,0:06:47.89,0:06:50.82,Default,,0,0,0,,Уау! (Поэзия) Уфуфу. Керемет жұмыс!
Dialogue: 0,0:06:50.82,0:06:55.36,Default,,0,0,0,,Соған қарамастан, мен ештеңе білмеймін және өз күшімді ... өз ойымды қолданамын.
Dialogue: 0,0:06:55.36,0:06:57.66,Default,,0,0,0,,Бұл зорлық-зомбылық және жансыздандыру.
Dialogue: 0,0:06:57.66,0:07:00.06,Default,,0,0,0,,Біз сізден ерекшеміз
Dialogue: 0,0:07:01.53,0:07:06.04,Default,,0,0,0,,Мақсат қойыңыз және ол үшін үмітсіздіктен қорықпаңыз.
Dialogue: 0,0:07:06.04,0:07:08.07,Default,,0,0,0,,Поэзия!
Dialogue: 0,0:07:08.07,0:07:14.08,Default,,0,0,0,,Сен
Dialogue: 0,0:07:14.08,0:07:17.48,Default,,0,0,0,,Жүрегіңнің түбіне басып кіремін
Dialogue: 0,0:07:19.65,0:07:22.36,Default,,0,0,0,,Шындықты өзіңіз біліңіз!
Dialogue: 0,0:07:22.36,0:07:25.39,Default,,0,0,0,,Сен
Dialogue: 0,0:07:25.39,0:07:28.26,Default,,0,0,0,,Бассейн! Уф!
Dialogue: 0,0:07:28.26,0:07:31.63,Default,,0,0,0,,А... Уф...
Dialogue: 0,0:07:31.63,0:07:35.44,Default,,0,0,0,,Сен
Dialogue: 0,0:07:35.44,0:07:38.00,Default,,0,0,0,,Мен, Джоэстар, бұл жақсылықты ешқашан ұмытпаймын
Dialogue: 0,0:07:38.00,0:07:40.00,Default,,0,0,0,,Рука-чан!
Dialogue: 0,0:07:41.57,0:07:44.44,Default,,0,0,0,,Бум!
Dialogue: 0,0:07:44.44,0:07:46.78,Default,,0,0,0,,А... а...
Dialogue: 0,0:07:46.78,0:07:50.08,Default,,0,0,0,,Уф... Жүрегім кенет... Ха!
Dialogue: 0,0:07:52.25,0:07:55.85,Default,,0,0,0,,Уф! Ааа...хаа...
Dialogue: 0,0:07:57.96,0:08:01.03,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:01.03,0:08:02.96,Default,,0,0,0,,Рефлектор?
Dialogue: 0,0:08:02.96,0:08:08.60,Default,,0,0,0,,Сен
Dialogue: 0,0:08:08.60,0:08:10.80,Default,,0,0,0,,Мен сені ары қарай жібермеймін.
Dialogue: 0,0:08:13.47,0:08:15.51,Default,,0,0,0,,Га
Dialogue: 0,0:08:15.51,0:08:19.48,Default,,0,0,0,,Сен
Dialogue: 0,0:08:19.48,0:08:21.51,Default,,0,0,0,,Хирахара мырза…
Dialogue: 0,0:08:21.51,0:08:25.59,Default,,0,0,0,,Құдайға шүкір, мен оны уақытында жасадым.
Dialogue: 0,0:08:25.59,0:08:27.62,Default,,0,0,0,,Неге...
Dialogue: 0,0:08:27.62,0:08:31.19,Default,,0,0,0,,Сен
Dialogue: 0,0:08:31.19,0:08:34.16,Default,,0,0,0,,Гүлдер баяу гүлдейді
Dialogue: 0,0:08:34.16,0:08:37.26,Default,,0,0,0,,Сол балалар бір кеңістікте болғандықтан ба?
Dialogue: 0,0:08:37.26,0:08:39.30,Default,,0,0,0,,Кин (қылыш ұстаған дыбыс) (2 адам) Иә?
Dialogue: 0,0:08:39.30,0:08:43.47,Default,,0,0,0,,≪Бұл жігіт не өзі?!≫
Dialogue: 0,0:08:43.47,0:08:46.11,Default,,0,0,0,,Сізде ептілік бар сияқты.
Dialogue: 0,0:08:46.11,0:08:48.54,Default,,0,0,0,,Ха...｡ Ха, ха...
Dialogue: 0,0:08:48.54,0:08:53.14,Default,,0,0,0,,≪Неге... сіз ештеңеге қарамастан алға қарай ұмтыла аласыз ба? ≫
Dialogue: 0,0:08:54.61,0:08:57.62,Default,,0,0,0,,≪Жүрегім неге ауырады?≫
Dialogue: 0,0:08:57.62,0:09:03.02,Default,,0,0,0,,≪Mr. Хирахараның сезімі соншалықты анық≫
Dialogue: 0,0:09:03.02,0:09:07.99,Default,,0,0,0,,≪Сол күшті сезім, менде мүмкін емес≫
Dialogue: 0,0:09:07.99,0:09:14.97,Default,,0,0,0,,Сен
Dialogue: 0,0:09:14.97,0:09:17.07,Default,,0,0,0,,Ах
Dialogue: 0,0:09:19.61,0:09:23.24,Default,,0,0,0,,≪Мен оның атын да білмеймін. Мен онымен сөйлескен де жоқпын≫
Dialogue: 0,0:09:23.24,0:09:26.41,Default,,0,0,0,,...
Dialogue: 0,0:09:26.41,0:09:33.29,Default,,0,0,0,,Сен
Dialogue: 0,0:09:33.29,0:09:36.39,Default,,0,0,0,,≪Егер сіз маңызды емес десеңіз, бұл болуы мүмкін.≫
Dialogue: 0,0:09:38.32,0:09:41.33,Default,,0,0,0,,Сіз естідіңіз бе? Көрші сыныпта...
Dialogue: 0,0:09:41.33,0:09:43.26,Default,,0,0,0,,Өтірік! Иә...
Dialogue: 0,0:09:43.26,0:09:59.65,Default,,0,0,0,,Сен
Dialogue: 0,0:09:59.65,0:10:03.65,Default,,0,0,0,,≪Бірақ мен...≫
Dialogue: 0,0:10:06.12,0:10:10.59,Default,,0,0,0,,Ой... Қарғыс атсын! Уф...
Dialogue: 0,0:10:10.59,0:10:14.09,Default,,0,0,0,,Енді не істейміз?
Dialogue: 0,0:10:14.09,0:10:18.43,Default,,0,0,0,,Сіз бұл баланы қалай қорғайсыз? айтшы
Dialogue: 0,0:10:18.43,0:10:21.57,Default,,0,0,0,,Хаха хаха
Dialogue: 0,0:10:21.57,0:10:25.17,Default,,0,0,0,,♬~
Dialogue: 0,0:10:25.17,0:10:39.79,Default,,0,0,0,,Сен
Dialogue: 0,0:10:39.79,0:10:41.82,Default,,0,0,0,,Әй!
Dialogue: 0,0:10:41.82,0:10:43.86,Default,,0,0,0,,Бұл кішкентай вакуумдық торнадоның соңғы әсері!
Dialogue: 0,0:10:43.86,0:10:45.79,Default,,0,0,0,,Гакин! (100) Әй!
Dialogue: 0,0:10:45.79,0:10:50.93,Default,,0,0,0,,Сен
Dialogue: 0,0:10:50.93,0:10:54.87,Default,,0,0,0,,Уф! Хм... ой...
Dialogue: 0,0:10:54.87,0:11:01.94,Default,,0,0,0,,Сен
Dialogue: 0,0:11:01.94,0:11:05.21,Default,,0,0,0,,≪Ширакаба қаласының азабын сезіну≫
Dialogue: 0,0:11:05.21,0:11:08.35,Default,,0,0,0,,≪Оларға көмектесуге тырысқан Хосакуридің ойлары≫
Dialogue: 0,0:11:08.35,0:11:10.38,Default,,0,0,0,,Күрсін!
Dialogue: 0,0:11:10.38,0:11:12.52,Default,,0,0,0,,Бакин! Хмм
Dialogue: 0,0:11:12.52,0:11:16.12,Default,,0,0,0,,Сен
Dialogue: 0,0:11:16.12,0:11:19.16,Default,,0,0,0,,≪Егер бұл жігіттің мақсаты біздікінен басқа болса...
Dialogue: 0,0:11:19.16,0:11:21.19,Default,,0,0,0,,Мен тезірек кетуім керек≫
Dialogue: 0,0:11:21.19,0:11:24.73,Default,,0,0,0,,Сен
Dialogue: 0,0:11:24.73,0:11:26.77,Default,,0,0,0,,Жүр!
Dialogue: 0,0:11:26.77,0:11:33.27,Default,,0,0,0,,Сен
Dialogue: 0,0:11:33.27,0:11:35.31,Default,,0,0,0,,Дабыл!
Dialogue: 0,0:11:35.31,0:11:42.01,Default,,0,0,0,,Сен
Dialogue: 0,0:11:42.01,0:11:46.55,Default,,0,0,0,,Иә! Бұл оңай емес
Dialogue: 0,0:11:46.55,0:11:51.46,Default,,0,0,0,,Дұрыс. Өзін-өзі таныстыру. Мен Момо Танабемін.
Dialogue: 0,0:11:51.46,0:11:56.40,Default,,0,0,0,,Сіз ше? Ха…｡ Ах…
Dialogue: 0,0:11:56.40,0:11:59.47,Default,,0,0,0,,Сіз өзіңізді осылай атай алмайсыз ба?
Dialogue: 0,0:11:59.47,0:12:02.37,Default,,0,0,0,,Сіз бұл қол туралы әлі де сенімдісіз бе?
Dialogue: 0,0:12:02.37,0:12:04.40,Default,,0,0,0,,Ах
Dialogue: 0,0:12:04.40,0:12:07.70,Default,,0,0,0,,Сіз шынымен кімсіз?
Dialogue: 0,0:12:10.44,0:12:13.05,Default,,0,0,0,,Мияко-чанды жібер. (Поэзия) Ах!
Dialogue: 0,0:12:13.05,0:12:15.95,Default,,0,0,0,,Мен бұл табандылыққа шыдай алмаймын!
Dialogue: 0,0:12:15.95,0:12:19.85,Default,,0,0,0,,Жарайды. Мен сіздің ойларыңыздың бір бөлігін алғанша
Dialogue: 0,0:12:19.85,0:12:21.95,Default,,0,0,0,,Мен бұл баланы дұрыстап қайтарамын.
Dialogue: 0,0:12:21.95,0:12:25.93,Default,,0,0,0,,Ойларыңызды алып тастаңыз ба? (Нина) Оны ұрламаңыз.
Dialogue: 0,0:12:25.93,0:12:29.63,Default,,0,0,0,,Мен сенен қарғыс атқан іріңді жұлып аламын.
Dialogue: 0,0:12:29.63,0:12:33.70,Default,,0,0,0,,Бұл адамды да жіберіп, құтқаруға болады.
Dialogue: 0,0:12:33.70,0:12:35.70,Default,,0,0,0,,№ (Нина) Ах.
Dialogue: 0,0:12:37.27,0:12:42.11,Default,,0,0,0,,Сезіміңіз қандай болса да, ол тек сол адамға ғана тән. Оларды алып кетпеңіз!
Dialogue: 0,0:12:42.11,0:12:45.51,Default,,0,0,0,,Иә! Өзіңіз білетіндей сөйлеңіз!
Dialogue: 0,0:12:45.51,0:12:48.01,Default,,0,0,0,,Иә! Уф...
Dialogue: 0,0:12:48.01,0:12:50.05,Default,,0,0,0,,Аһ!
Dialogue: 0,0:12:50.05,0:12:52.08,Default,,0,0,0,,Ох… Уф~ Мен қатты ашпын.
Dialogue: 0,0:12:52.08,0:12:54.12,Default,,0,0,0,,Хирахара мырза! Таң!
Dialogue: 0,0:12:54.12,0:12:58.62,Default,,0,0,0,,Ах! Күрсін... Күрсін...
Dialogue: 0,0:12:58.62,0:13:01.36,Default,,0,0,0,,күрсіну...｡ Рука-чан
Dialogue: 0,0:13:01.36,0:13:04.20,Default,,0,0,0,,А, мен мұны істеймін.
Dialogue: 0,0:13:04.20,0:13:06.53,Default,,0,0,0,,Бір-біріне көмектесу қандай тамаша.
Dialogue: 0,0:13:06.53,0:13:10.04,Default,,0,0,0,,Бірақ тым кеш сияқты.
Dialogue: 0,0:13:10.04,0:13:12.54,Default,,0,0,0,,А... уф...
Dialogue: 0,0:13:17.74,0:13:21.78,Default,,0,0,0,,Енді сіз қайтадан босатыласыз. иә?
Dialogue: 0,0:13:21.78,0:13:25.38,Default,,0,0,0,,♬~
Dialogue: 0,0:13:27.09,0:13:29.12,Default,,0,0,0,,Рука-чан
Dialogue: 0,0:13:29.12,0:13:33.66,Default,,0,0,0,,Мен өзімді кешіре алмадым
Dialogue: 0,0:13:33.66,0:13:37.73,Default,,0,0,0,,Не? Енді мен болғаным дұрыс дедіңіз
Dialogue: 0,0:13:37.73,0:13:39.77,Default,,0,0,0,,Сіз осылай айттыңыз.
Dialogue: 0,0:13:39.77,0:13:43.17,Default,,0,0,0,,Саа...
Dialogue: 0,0:13:43.17,0:13:50.28,Default,,0,0,0,,Сен
Dialogue: 0,0:13:50.28,0:13:54.18,Default,,0,0,0,,Өйткені ол кезде қолымды созбадым.
Dialogue: 0,0:13:54.18,0:13:57.98,Default,,0,0,0,,Сен
Dialogue: 0,0:13:57.98,0:14:00.39,Default,,0,0,0,,Мен саған керек емеспін
Dialogue: 0,0:14:00.39,0:14:03.46,Default,,0,0,0,,Ешқандай көмек жоқ
Dialogue: 0,0:14:03.46,0:14:06.46,Default,,0,0,0,,Сол баланың сезіміне өзіңізді сендіріңіз
Dialogue: 0,0:14:06.46,0:14:08.46,Default,,0,0,0,,Мен өз шешімімді қабылдадым.
Dialogue: 0,0:14:10.40,0:14:13.47,Default,,0,0,0,,Бір ғана сөзді айтсаңыз
Dialogue: 0,0:14:13.47,0:14:17.70,Default,,0,0,0,,Егер мен мұны істесем, бірдеңе өзгерген болуы мүмкін.
Dialogue: 0,0:14:17.70,0:14:21.27,Default,,0,0,0,,Бірақ мен енді білмеймін
Dialogue: 0,0:14:21.27,0:14:25.38,Default,,0,0,0,,Сол бала... кетті.
Dialogue: 0,0:14:25.38,0:14:29.38,Default,,0,0,0,,Ах. Мен көмектескім келді.
Dialogue: 0,0:14:29.38,0:14:32.29,Default,,0,0,0,,Талай рет өкіндім
Dialogue: 0,0:14:32.29,0:14:34.32,Default,,0,0,0,,Мен мұны енді қаламаймын!
Dialogue: 0,0:14:34.32,0:14:38.32,Default,,0,0,0,,Сіз жалғыз емессіз... Мен мұны қайталағым келмейді.
Dialogue: 0,0:14:38.32,0:14:40.36,Default,,0,0,0,,Мен өзгергім келеді!
Dialogue: 0,0:14:40.36,0:14:42.40,Default,,0,0,0,,Күн…
Dialogue: 0,0:14:42.40,0:14:44.43,Default,,0,0,0,,Ах! Амал жоқ...
Dialogue: 0,0:14:44.43,0:15:04.43,Default,,0,0,0,,Сен
Dialogue: 0,0:17:07.17,0:17:10.64,Default,,0,0,0,,Мен…｡ Рука-чан
Dialogue: 0,0:17:10.64,0:17:13.31,Default,,0,0,0,,Әй
Dialogue: 0,0:17:13.31,0:17:15.35,Default,,0,0,0,,Иә
Dialogue: 0,0:17:15.35,0:17:20.85,Default,,0,0,0,,Сен
Dialogue: 0,0:17:20.85,0:17:23.62,Default,,0,0,0,,Кешір, бірақ мен әлі өлуге дайын емеспін.
Dialogue: 0,0:17:23.62,0:17:28.29,Default,,0,0,0,,Қаласаң да тастай алмайтын дүниелер бар.
Dialogue: 0,0:17:28.29,0:17:32.40,Default,,0,0,0,,Өткенге байланып, қажетсіз ойлармен қиналған...
Dialogue: 0,0:17:32.40,0:17:34.80,Default,,0,0,0,,Иә! Уф... уф...
Dialogue: 0,0:17:34.80,0:17:50.75,Default,,0,0,0,,Сен
Dialogue: 0,0:17:50.75,0:17:54.85,Default,,0,0,0,,Жаман өмір сүру сұмдық.
Dialogue: 0,0:17:54.85,0:17:58.56,Default,,0,0,0,,Балалар, бұл туралы ештеңе білмейсіңдер!
Dialogue: 0,0:17:58.56,0:18:01.03,Default,,0,0,0,,Рука-чан! Арх!
Dialogue: 0,0:18:01.03,0:18:04.76,Default,,0,0,0,,Мүмкін солай шығар. Бірақ
Dialogue: 0,0:18:04.76,0:18:06.96,Default,,0,0,0,,Мен де бір нәрсені білдім
Dialogue: 0,0:18:08.33,0:18:11.20,Default,,0,0,0,,Бұл сезім қанша мұңды болса да
Dialogue: 0,0:18:11.20,0:18:13.20,Default,,0,0,0,,Ауыруы мүмкін.
Dialogue: 0,0:18:20.81,0:18:22.85,Default,,0,0,0,,Ах
Dialogue: 0,0:18:22.85,0:18:26.95,Default,,0,0,0,,Десе де, бұл шешімді басқа біреу немесе өзіміз шешеді.
Dialogue: 0,0:18:26.95,0:18:29.56,Default,,0,0,0,,Мен алмаймын! Tsk!
Dialogue: 0,0:18:29.56,0:18:31.99,Default,,0,0,0,,Сенпай! (Нина) Маған кедергі жасама.
Dialogue: 0,0:18:31.99,0:18:35.59,Default,,0,0,0,,Бұл менің шайқасым!
Dialogue: 0,0:18:35.59,0:18:38.20,Default,,0,0,0,,Бассейн! Уф!
Dialogue: 0,0:18:38.20,0:18:40.27,Default,,0,0,0,,Ха! Шашырау!
Dialogue: 0,0:18:40.27,0:18:44.37,Default,,0,0,0,,Рука-чан! (Нина) Әй! Боқ...
Dialogue: 0,0:18:44.37,0:18:48.61,Default,,0,0,0,,Ой тек сол адамға ғана тән
Dialogue: 0,0:18:48.61,0:18:51.61,Default,,0,0,0,,Ұмытқым келетін нәрселер көп.
Dialogue: 0,0:18:51.61,0:18:54.11,Default,,0,0,0,,Басқа амал жоқ па?!
Dialogue: 0,0:18:54.11,0:18:56.15,Default,,0,0,0,,Ах
Dialogue: 0,0:18:56.15,0:19:14.27,Default,,0,0,0,,Сен
Dialogue: 0,0:19:14.27,0:19:18.67,Default,,0,0,0,,Менің өз ойым болғандықтан, мен алға жылжи аламын.
Dialogue: 0,0:19:18.67,0:19:24.38,Default,,0,0,0,,Сен
Dialogue: 0,0:19:24.38,0:19:26.41,Default,,0,0,0,,Біз ұрысамыз
Dialogue: 0,0:19:26.41,0:19:29.18,Default,,0,0,0,,Мияко-чанның өмір туралы ойлары
Dialogue: 0,0:19:29.18,0:19:32.59,Default,,0,0,0,,Мен оны ешкімнің алып кетуіне жол бермеймін!
Dialogue: 0,0:19:32.59,0:19:35.49,Default,,0,0,0,,Жоқ! (Поэзия) Сенпай!
Dialogue: 0,0:19:35.49,0:19:39.36,Default,,0,0,0,,Тап... Оны тастама
Dialogue: 0,0:19:39.36,0:19:42.96,Default,,0,0,0,,Маған қарашы!
Dialogue: 0,0:19:49.37,0:19:51.40,Default,,0,0,0,,Нағыз мен!
Dialogue: 0,0:19:51.40,0:20:00.95,Default,,0,0,0,,Сен
Dialogue: 0,0:20:00.95,0:20:03.28,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:20:03.28,0:20:06.89,Default,,0,0,0,,Келесі кездескенімізде мен сені міндетті түрде жеңемін.
Dialogue: 0,0:20:06.89,0:20:10.22,Default,,0,0,0,,Мен Рефлектор Нина Ямадамын
Dialogue: 0,0:20:10.22,0:20:14.29,Default,,0,0,0,,Сіз сияқты адамдарды өткенге байлау
Dialogue: 0,0:20:14.29,0:20:17.16,Default,,0,0,0,,Кеше… Ах…
Dialogue: 0,0:20:17.16,0:20:22.23,Default,,0,0,0,,Йосакури Хирахара. Мен әрқашан өз ойымды қорғаймын.
Dialogue: 0,0:20:22.23,0:20:29.71,Default,,0,0,0,,Сен
Dialogue: 0,0:20:29.71,0:20:34.01,Default,,0,0,0,,Ах. Жақында көріскенше, гүлдер.
Dialogue: 0,0:20:36.05,0:20:38.05,Default,,0,0,0,,Ах
Dialogue: 0,0:20:46.13,0:20:48.19,Default,,0,0,0,,Әңгіме біткен жоқ!
Dialogue: 0,0:20:48.19,0:20:50.19,Default,,0,0,0,,Гакин!
Dialogue: 0,0:20:53.13,0:20:55.07,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:55.07,0:20:57.57,Default,,0,0,0,,Парин!
Dialogue: 0,0:20:59.07,0:21:01.07,Default,,0,0,0,,Қазір бұл не?
Dialogue: 0,0:21:07.15,0:21:12.18,Default,,0,0,0,,Сен
Dialogue: 0,0:21:12.18,0:21:15.22,Default,,0,0,0,,Saa…
Dialogue: 0,0:21:15.22,0:21:18.76,Default,,0,0,0,,Сен
Dialogue: 0,0:21:18.76,0:21:22.70,Default,,0,0,0,,Қайтып келдіңіз бе? Солай сияқты
Dialogue: 0,0:21:22.70,0:21:25.83,Default,,0,0,0,,Хехе. Мен үйге баруым керек пе?
Dialogue: 0,0:21:25.83,0:21:30.73,Default,,0,0,0,,Канг канг канг...(темір жол өткелінің дыбысы)
Dialogue: 0,0:21:32.67,0:21:38.48,Default,,0,0,0,,Сен
Dialogue: 0,0:21:38.48,0:21:42.18,Default,,0,0,0,,Иә? Мен оны қысқартудың қажеті жоқ. Жоқ, бірақ бұл...
Dialogue: 0,0:21:42.18,0:21:46.19,Default,,0,0,0,,Мынау сияқты сүйкімді. О, мен...
Dialogue: 0,0:21:46.19,0:21:48.69,Default,,0,0,0,,А, Мияко-чан, сен ояндың.
Dialogue: 0,0:21:48.69,0:21:51.22,Default,,0,0,0,,Өзіңізді біртүрлі сезінбейсіз бе? Сенімен бәрі жақсы ма?
Dialogue: 0,0:21:51.22,0:21:53.59,Default,,0,0,0,,Не? Эй...мм...
Dialogue: 0,0:21:53.59,0:21:57.59,Default,,0,0,0,,Іс бұзылды. Мен оны түзетуге тырыстым.
Dialogue: 0,0:22:00.27,0:22:04.70,Default,,0,0,0,,Не? Бұл мен үшін бе? иә!
Dialogue: 0,0:22:04.70,0:22:07.57,Default,,0,0,0,,Рука-чан, сен шынымен де заттарды жөндейсің.
Dialogue: 0,0:22:07.57,0:22:12.41,Default,,0,0,0,,А, айтайын, ол жұлдызды таңдаған мен емес едім.
Dialogue: 0,0:22:12.41,0:22:16.05,Default,,0,0,0,,Иә! Эй, сен қалай ойлайсың?
Dialogue: 0,0:22:16.05,0:22:18.55,Default,,0,0,0,,Мен үшін…
Dialogue: 0,0:22:18.55,0:22:21.12,Default,,0,0,0,,Сіз оны мен үшін таптыңыз.
Dialogue: 0,0:22:21.12,0:22:25.02,Default,,0,0,0,,Мен осында қала аламын...
Dialogue: 0,0:22:25.02,0:22:28.09,Default,,0,0,0,,Ха! А... көп қарамаңыз
Dialogue: 0,0:22:28.09,0:22:32.39,Default,,0,0,0,,Сіз біртүрлі көрінесіз. Мен мұндай нәрсені бірінші рет көруім.
Dialogue: 0,0:22:34.80,0:22:36.97,Default,,0,0,0,,Кешіріңізші!
Dialogue: 0,0:22:36.97,0:22:39.84,Default,,0,0,0,,Бірақ стильді сезінуіңіз күмәнді. Ха!
Dialogue: 0,0:22:39.84,0:22:44.18,Default,,0,0,0,,О... бұл жұлдыз ғой, солай ма? Жарқыраған, бұл бірінші жұлдыз, солай ма?
Dialogue: 0,0:22:44.18,0:22:47.98,Default,,0,0,0,,Сол үшін айттым ғой, солай ма? Ұстау оңай, ал тегіс қырынған дұрыс...
Dialogue: 0,0:22:47.98,0:22:50.72,Default,,0,0,0,,Иә? Оны жою мүмкін емес.
Dialogue: 0,0:22:50.72,0:22:52.75,Default,,0,0,0,,Га. (Кімге) Балалар.
Dialogue: 0,0:22:52.75,0:22:55.89,Default,,0,0,0,,Сіз бастауыш сынып оқушысысыз ба? (2 адам) Иә?
Dialogue: 0,0:22:55.89,0:22:58.02,Default,,0,0,0,,Маған моншақтарды қарызға бер!
Dialogue: 0,0:22:58.02,0:23:00.39,Default,,0,0,0,,Бұл түс үшін жақсырақ
Dialogue: 0,0:23:00.39,0:23:03.36,Default,,0,0,0,,Түсіндім...｡ О, жарайсың!
Dialogue: 0,0:23:03.36,0:23:06.46,Default,,0,0,0,,Сен
Dialogue: 0,0:23:07.87,0:23:17.88,Default,,0,0,0,,Сен
Dialogue: 0,0:23:17.88,0:23:19.95,Default,,0,0,0,,Рука-чан, бірінші бар.
Dialogue: 0,0:23:19.95,0:23:22.88,Default,,0,0,0,,Не? О, күте тұрыңыз ...
Dialogue: 0,0:23:22.88,0:23:25.68,Default,,0,0,0,,А... м... бұл...
Dialogue: 0,0:23:25.68,0:23:28.18,Default,,0,0,0,,500 рефлексия.
Dialogue: 0,0:23:29.82,0:23:32.76,Default,,0,0,0,,Сонымен бұл мәселе аяқталды.
Dialogue: 0,0:23:32.76,0:23:36.50,Default,,0,0,0,,үшінна! Дайынсыз ба? Қараңыз...
Dialogue: 0,0:23:36.50,0:23:39.13,Default,,0,0,0,,Пан! Пан!
Dialogue: 0,0:23:39.13,0:23:41.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:41.17,0:23:44.57,Default,,0,0,0,,Цукиномияға қош келдіңіз!
Dialogue: 0,0:23:45.90,0:23:48.51,Default,,0,0,0,,Тіпті сен де... Хехе!
Dialogue: 0,0:23:48.51,0:23:51.98,Default,,0,0,0,,Хаха! (Жатақхана студенті) Эй, дәмді көрінеді!
Dialogue: 0,0:23:51.98,0:23:54.01,Default,,0,0,0,,Уау~ Маған да бер!
Dialogue: 0,0:23:54.01,0:24:01.39,Default,,0,0,0,,Сен
Dialogue: 0,0:24:01.39,0:24:04.46,Default,,0,0,0,,Бұл балалар шамамен бір жаста еді, солай емес пе?
Dialogue: 0,0:24:04.46,0:24:07.09,Default,,0,0,0,,Иә? рефлектордың
Dialogue: 0,0:24:07.09,0:24:11.10,Default,,0,0,0,,Ах...бірдей, бірақ мүлде басқа
Dialogue: 0,0:24:11.10,0:24:14.80,Default,,0,0,0,,О! Ахахха!
Dialogue: 0,0:24:14.80,0:24:17.80,Default,,0,0,0,,Біз тағы ұрысамыз ба?
Dialogue: 0,0:24:17.80,0:24:22.11,Default,,0,0,0,,Бірақ мен Рука-чанның қасында болсам, жеңілдеп қаламын.
Dialogue: 0,0:24:22.11,0:24:26.01,Default,,0,0,0,,Сіз мұндай нәрсені қалай айтасыз? жұп? Бұл сіздің досыңыз ба?
Dialogue: 0,0:24:26.01,0:24:30.05,Default,,0,0,0,,Ах. Екеуміз күресеміз деп шешкен сияқты емеспіз...
Dialogue: 0,0:24:30.05,0:24:34.52,Default,,0,0,0,,О, дұрыс... А, дұрыс...
Dialogue: 0,0:24:34.52,0:24:37.56,Default,,0,0,0,,О, солай.
Dialogue: 0,0:24:37.56,0:24:41.33,Default,,0,0,0,,Бұл сіздің әпкеңіз туралы. иә?
Dialogue: 0,0:24:41.33,0:24:45.26,Default,,0,0,0,,Маған қарсы болмасаңыз, менімен сөйлесіңіз.
Dialogue: 0,0:24:45.26,0:24:48.03,Default,,0,0,0,,Сіз сондай бос емес болсаңыз да
Dialogue: 0,0:24:48.03,0:24:51.37,Default,,0,0,0,,Өзіме келгенде...
Dialogue: 0,0:24:51.37,0:24:53.67,Default,,0,0,0,,Ах... Ах, мм...
Dialogue: 0,0:24:58.08,0:25:00.75,Default,,0,0,0,,Ах
Dialogue: 0,0:25:00.75,0:25:04.65,Default,,0,0,0,,Бірге ойланатын нәрсе болуы мүмкін.
Dialogue: 0,0:25:04.65,0:25:06.79,Default,,0,0,0,,Рука-чан
Dialogue: 0,0:25:06.79,0:25:09.39,Default,,0,0,0,,...
Dialogue: 0,0:25:09.39,0:25:13.03,Default,,0,0,0,,Ах. Мен білмей тұрып, біз жақсы достар едік.
Dialogue: 0,0:25:13.03,0:25:16.60,Default,,0,0,0,,А, біз басқамыз... (Жатақхана директоры) Бұл жақсы емес!
Dialogue: 0,0:25:16.60,0:25:20.93,Default,,0,0,0,,Дұрыс? Бұл рас, бірақ...
Dialogue: 0,0:25:20.93,0:25:23.57,Default,,0,0,0,,Хехе, бұл теле. Сіз...
Dialogue: 0,0:25:23.57,0:25:26.57,Default,,0,0,0,,Ей, екеуің де осында келіңдер!
Dialogue: 0,0:25:26.57,0:25:29.27,Default,,0,0,0,,Тәттілер көп.
Dialogue: 0,0:25:29.27,0:25:31.27,Default,,0,0,0,,Біз барамыз ба?
Dialogue: 0,0:25:33.31,0:25:35.35,Default,,0,0,0,,Ах
Dialogue: 0,0:25:35.35,0:25:38.35,Default,,0,0,0,,Сен
Dialogue: 0,0:25:38.35,0:25:40.95,Default,,0,0,0,,Не? Сондай-ақ Хирахара Йосакуридің үлкен әпкесі
Dialogue: 0,0:25:40.95,0:25:42.99,Default,,0,0,0,,Бұл рефлекторға үміткер болды ма?
Dialogue: 0,0:25:42.99,0:25:47.43,Default,,0,0,0,,Сен
Dialogue: 0,0:25:47.43,0:25:50.33,Default,,0,0,0,,Иә, деректер
Dialogue: 0,0:25:50.33,0:25:53.40,Default,,0,0,0,,Ол сақинаны тастап, жоғалып кетті.
Dialogue: 0,0:25:53.40,0:25:56.50,Default,,0,0,0,,Сіз нені айтасыз? (Пошта қабылдау/Ұнсыз режим)
Dialogue: 0,0:25:56.50,0:25:59.67,Default,,0,0,0,,Ах! Сол сияқты...
Dialogue: 0,0:25:59.67,0:26:15.17,Default,,0,0,0,,Сен
Dialogue: 0,0:26:16.52,0:26:36.48,Default,,0,0,0,,Сен
Dialogue: 0,0:26:36.48,0:26:56.50,Default,,0,0,0,,Сен
Dialogue: 0,0:26:56.50,0:27:00.20,Default,,0,0,0,,Сен
Dialogue: 0,0:27:00.20,0:27:06.80,Default,,0,0,0,,Сен
Dialogue: 0,0:27:13.21,0:27:23.59,Default,,0,0,0,,Сен
Dialogue: 0,0:27:23.59,0:27:33.47,Default,,0,0,0,,Сен
Dialogue: 0,0:27:33.47,0:27:45.47,Default,,0,0,0,,Сен
Dialogue: 0,0:29:18.17,0:29:20.31,Default,,0,0,0,,Сіздің әпкеңіз де рефлектор болды ма? (100) Қалай болғанда да
Dialogue: 0,0:29:20.31,0:29:22.47,Default,,0,0,0,,Мен әйтеуір үлгердім... Біз... деп ойламадым.
Dialogue: 0,0:29:22.47,0:29:24.51,Default,,0,0,0,,Мен қазір болып жатқан оқиғадан бас тартқым келмейді.
Dialogue: 0,0:29:24.51,0:29:26.78,Default,,0,0,0,,Себебі мен оны дұрыс орындағым келеді. (100) Бұл жігіттер
Dialogue: 0,0:29:26.78,0:29:30.58,Default,,0,0,0,,Сіз дұрыс алға жылжып жатсаңыз да. Біреудің сезімі селт ете түседі.
Dialogue: 0,0:29:32.08,0:29:38.08,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
