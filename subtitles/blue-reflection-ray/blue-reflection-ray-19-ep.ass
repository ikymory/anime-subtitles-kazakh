Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:33.83,0:01:37.90,Default,,0,0,0,,♬～
Dialogue: 0,0:01:37.90,0:01:40.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:40.27,0:01:42.31,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:42.31,0:01:45.04,Default,,0,0,0,,Хирахара мырза…
Dialogue: 0,0:01:45.04,0:01:47.08,Default,,0,0,0,,Әй
Dialogue: 0,0:01:47.08,0:01:52.62,Default,,0,0,0,,♬～
Dialogue: 0,0:01:52.62,0:01:55.45,Default,,0,0,0,,Барлығы бір-бірімен үндеседі
Dialogue: 0,0:01:55.45,0:01:59.65,Default,,0,0,0,,Бұл есікті ашатын кілт.
Dialogue: 0,0:02:01.86,0:02:21.88,Default,,0,0,0,,♬～
Dialogue: 0,0:02:21.88,0:02:40.30,Default,,0,0,0,,♬～
Dialogue: 0,0:02:40.30,0:02:43.70,Default,,0,0,0,,♬～
Dialogue: 0,0:02:43.70,0:03:02.75,Default,,0,0,0,,♬～
Dialogue: 0,0:03:02.75,0:03:14.55,Default,,0,0,0,,♬～
Dialogue: 0,0:03:16.03,0:03:19.54,Default,,0,0,0,,♬～
Dialogue: 0,0:03:19.54,0:03:30.44,Default,,0,0,0,,♬～
Dialogue: 0,0:03:37.55,0:03:40.19,Default,,0,0,0,,Ах...｡ (Мияко) Ах... болды.
Dialogue: 0,0:03:40.19,0:03:42.23,Default,,0,0,0,,Жалпы есік ашылды
Dialogue: 0,0:03:42.23,0:03:45.80,Default,,0,0,0,,♬～
Dialogue: 0,0:03:45.80,0:03:48.83,Default,,0,0,0,,Әй, Сакурай! Уф... Уф!
Dialogue: 0,0:03:48.83,0:03:51.13,Default,,0,0,0,,Ах! (Нина) А
Dialogue: 0,0:03:51.13,0:03:54.17,Default,,0,0,0,,Ах. Эй, мынаны қара! Ах
Dialogue: 0,0:03:54.17,0:03:58.74,Default,,0,0,0,,♬～
Dialogue: 0,0:03:58.74,0:04:00.74,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:03.18,0:04:05.18,Default,,0,0,0,,[TEL] (Мәнер режимі) (Мияко) Ах
Dialogue: 0,0:04:06.68,0:04:08.72,Default,,0,0,0,,[ТЕЛ] (Мияко) Бұл аздап қорқынышты!
Dialogue: 0,0:04:08.72,0:04:10.75,Default,,0,0,0,,Тынышталыңыз. [TEL] (Мияко)...
Dialogue: 0,0:04:10.75,0:04:15.12,Default,,0,0,0,,Кеңістік пен уақытқа сызат тудырып, ортақ есік ашылды.
Dialogue: 0,0:04:15.12,0:04:17.99,Default,,0,0,0,,Солай ма? [TEL] (Токио) Жарық дегеніміз...
Dialogue: 0,0:04:17.99,0:04:22.43,Default,,0,0,0,,[TEL] (Рационалды) Қабырғада Ортақ пен осы дүниені бөліп тұрған тесік бар.➡
Dialogue: 0,0:04:22.43,0:04:25.43,Default,,0,0,0,,Екі бос орын осылай қосылса➡
Dialogue: 0,0:04:25.43,0:04:28.04,Default,,0,0,0,,Дүниенің қағидалары қайтадан күйреді
Dialogue: 0,0:04:28.04,0:04:30.74,Default,,0,0,0,,Мен логиканы немесе осыған ұқсас нәрсені түсінбеймін!
Dialogue: 0,0:04:30.74,0:04:33.78,Default,,0,0,0,,[ТЕЛ] (Рационалды) Мені тыңда. Егер логика бұзылса➡
Dialogue: 0,0:04:33.78,0:04:36.38,Default,,0,0,0,,Ойдың қадірі кеткен... А...➡
Dialogue: 0,0:04:36.38,0:04:39.82,Default,,0,0,0,,Әй, құласа не болады!?
Dialogue: 0,0:04:39.82,0:04:47.79,Default,,0,0,0,,♬～
Dialogue: 0,0:04:47.79,0:04:49.89,Default,,0,0,0,,Өтініш жазылған конверт жоғалып кетті.
Dialogue: 0,0:04:51.89,0:04:56.50,Default,,0,0,0,,Ақыры менің дұрыс уақытым қозғала бастады.
Dialogue: 0,0:04:56.50,0:04:58.60,Default,,0,0,0,,Ах
Dialogue: 0,0:05:01.00,0:05:03.94,Default,,0,0,0,,Мен Шино-чанға өзіне ұнайтын нәрсені істеуге рұқсат бермеймін!
Dialogue: 0,0:05:03.94,0:05:06.14,Default,,0,0,0,,Біз ортақты қорғаймыз!
Dialogue: 0,0:05:08.04,0:05:12.35,Default,,0,0,0,,Жалпы жұрттың қамқоршылары менің жолыма бөгет болмайсыңдар ма!
Dialogue: 0,0:05:12.35,0:05:15.99,Default,,0,0,0,,♬～
Dialogue: 0,0:05:15.99,0:05:18.02,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:18.02,0:05:21.12,Default,,0,0,0,,♬～
Dialogue: 0,0:05:21.12,0:05:24.53,Default,,0,0,0,,Не болды? Common-ға Шино шабуыл жасайды
Dialogue: 0,0:05:24.53,0:05:27.56,Default,,0,0,0,,Хмм... Менің кетуім керек!
Dialogue: 0,0:05:27.56,0:05:30.33,Default,,0,0,0,,Уф! Уф... күрсін...
Dialogue: 0,0:05:30.33,0:05:32.43,Default,,0,0,0,,Эй, бұл жарақат...
Dialogue: 0,0:05:33.74,0:05:36.91,Default,,0,0,0,,Рука-чан…｡ Ах.
Dialogue: 0,0:05:36.91,0:05:39.71,Default,,0,0,0,,Бұл менің кінәм
Dialogue: 0,0:05:39.71,0:05:42.65,Default,,0,0,0,,Мен мұның бәрін жасадым.
Dialogue: 0,0:05:42.65,0:05:45.38,Default,,0,0,0,,Рио Каэде де, Ами Рю да...➡
Dialogue: 0,0:05:45.38,0:05:47.52,Default,,0,0,0,,Рука-чан, мен...
Dialogue: 0,0:05:47.52,0:05:49.99,Default,,0,0,0,,Сакурай, сабыр ет.
Dialogue: 0,0:05:49.99,0:05:53.86,Default,,0,0,0,,Біз не істеуіміз керек? Не істеуім керек?
Dialogue: 0,0:05:53.86,0:05:56.33,Default,,0,0,0,,Жарайды, Йо Сакурай.
Dialogue: 0,0:05:56.33,0:06:01.26,Default,,0,0,0,,Үлкен әпке. (Мизуру) Йо Сакурайдың еш кінәсі жоқ.➡
Dialogue: 0,0:06:01.26,0:06:05.10,Default,,0,0,0,,Не болды бұл бұрыс дүние.➡
Dialogue: 0,0:06:05.10,0:06:08.10,Default,,0,0,0,,Мен мұны білдім.➡
Dialogue: 0,0:06:08.10,0:06:10.94,Default,,0,0,0,,Сіз маған есікті аша аласыз
Dialogue: 0,0:06:10.94,0:06:12.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:14.38,0:06:17.88,Default,,0,0,0,,Сіз нені айтасыз? (2 адам) А
Dialogue: 0,0:06:17.88,0:06:20.78,Default,,0,0,0,,Біздің ең басынан мақсатымыз➡
Dialogue: 0,0:06:20.78,0:06:23.12,Default,,0,0,0,,Гүлдердің сезімін білдіру үшін екеуіңді қолданыңдар➡
Dialogue: 0,0:06:23.12,0:06:25.22,Default,,0,0,0,,Бұл оны жабайы жүргізу үшін болды.
Dialogue: 0,0:06:26.99,0:06:31.09,Default,,0,0,0,,Хана-чанды ренжітіп, оның ой-пікірін қалдыру үшін не істей аламын➡
Dialogue: 0,0:06:31.09,0:06:33.13,Default,,0,0,0,,Барлығы түсінікті.➡
Dialogue: 0,0:06:33.13,0:06:36.87,Default,,0,0,0,,Бұл менің байланғанымды білдіреді!
Dialogue: 0,0:06:36.87,0:06:38.90,Default,,0,0,0,,Поэзия! (Поэзия) Уау! ➡
Dialogue: 0,0:06:38.90,0:06:41.57,Default,,0,0,0,,Айта кетейін, мен осыны ойладым➡
Dialogue: 0,0:06:41.57,0:06:46.11,Default,,0,0,0,,Ол Шино-танның әпкесі. иә? Сіздің әпкеңіз?
Dialogue: 0,0:06:46.11,0:06:48.91,Default,,0,0,0,,Барлығы сізді қорғау үшін.➡
Dialogue: 0,0:06:48.91,0:06:51.45,Default,,0,0,0,,Бұл дүние қателескенше➡
Dialogue: 0,0:06:51.45,0:06:55.99,Default,,0,0,0,,Қайғы мен қайғы ешқашан жойылмайды
Dialogue: 0,0:06:55.99,0:07:01.52,Default,,0,0,0,,Бірақ біз есікті ашып, адамдардың ақымақ ойларын басқарғанша➡
Dialogue: 0,0:07:01.52,0:07:05.39,Default,,0,0,0,,Сакурайдың ойлары бұдан былай жабайы емес.
Dialogue: 0,0:07:05.39,0:07:09.03,Default,,0,0,0,,Хосакуридің бақытына кепілдік беріледі
Dialogue: 0,0:07:09.03,0:07:12.84,Default,,0,0,0,,Менің бақытым? (Миген) Иә.
Dialogue: 0,0:07:12.84,0:07:15.87,Default,,0,0,0,,Сіз әлі де нәзік болсаңыз да➡
Dialogue: 0,0:07:15.87,0:07:18.94,Default,,0,0,0,,Сіз мейірімді ойлар әлемінде өмір сүре аласыз.
Dialogue: 0,0:07:18.94,0:07:21.68,Default,,0,0,0,,Хосакуриді ерікті түрде соттамаңыз!
Dialogue: 0,0:07:21.68,0:07:25.05,Default,,0,0,0,,Йо Сакурай бақытты бола алатын әлем?
Dialogue: 0,0:07:25.05,0:07:28.78,Default,,0,0,0,,Сіздің бақытты немесе бақытты емесіңізді Йосакури шешеді.
Dialogue: 0,0:07:28.78,0:07:32.15,Default,,0,0,0,,Бұл сенің әпкең емес! Ах...
Dialogue: 0,0:07:32.15,0:07:37.09,Default,,0,0,0,,Йо Сакурайдың сезімі де нәзік емес.
Dialogue: 0,0:07:37.09,0:07:40.10,Default,,0,0,0,,Аа, мен біреуге көңіл бөлемін➡
Dialogue: 0,0:07:40.10,0:07:43.50,Default,,0,0,0,,Сол адамға қатты ашуланыңыз➡
Dialogue: 0,0:07:43.50,0:07:48.37,Default,,0,0,0,,Жылап, көмектескісі келеді
Dialogue: 0,0:07:48.37,0:07:51.37,Default,,0,0,0,,Сол сезімді пайдаланғаныңды кешіре алмаймын.
Dialogue: 0,0:07:53.38,0:07:57.31,Default,,0,0,0,,Әділ дүние, бақыт, т.б.➡
Dialogue: 0,0:07:57.31,0:08:02.25,Default,,0,0,0,,Әпкеңнің тілегін орындау үшін Йо Сакурайды қолданба!
Dialogue: 0,0:08:02.25,0:08:04.25,Default,,0,0,0,,Рука-чан...
Dialogue: 0,0:08:06.76,0:08:10.63,Default,,0,0,0,,Бұл кісінің ойы көмектескендер көп.
Dialogue: 0,0:08:10.63,0:08:14.56,Default,,0,0,0,,Сіздің әпкеңіздің қарап тұрғаны өткендегі Хирахара Йосури➡
Dialogue: 0,0:08:14.56,0:08:18.10,Default,,0,0,0,,Дәл қазір менің алдымдағы жігіт ол емес. Ах.
Dialogue: 0,0:08:18.10,0:08:20.94,Default,,0,0,0,,Дұрыс. Момо осында болса➡
Dialogue: 0,0:08:20.94,0:08:23.51,Default,,0,0,0,,Қызық, үлкен көңіл-күй бола ма?
Dialogue: 0,0:08:23.51,0:08:25.64,Default,,0,0,0,,…қашып кету…
Dialogue: 0,0:08:25.64,0:08:27.64,Default,,0,0,0,,(Ватару) Не болып жатыр? Бұл әңгіме… (Ер оқушы) Ол ұялы телефонымен дауласып жатыр.
Dialogue: 0,0:08:33.95,0:08:38.65,Default,,0,0,0,,Әй, кәдімгі. Мен не істеуім керек...
Dialogue: 0,0:08:38.65,0:08:41.66,Default,,0,0,0,,Сакурай екеуміз есікті жабамыз.
Dialogue: 0,0:08:41.66,0:08:45.46,Default,,0,0,0,,Ах...｡ Иә!
Dialogue: 0,0:08:45.46,0:08:48.03,Default,,0,0,0,,Білмесеңіз, жақсы.
Dialogue: 0,0:08:48.03,0:08:51.43,Default,,0,0,0,,Мен Йосакуриді өз жолыммен қорғаймын.➡
Dialogue: 0,0:08:51.43,0:08:53.93,Default,,0,0,0,,Дұрыс дүниені толтырыңыз
Dialogue: 0,0:08:56.37,0:08:58.71,Default,,0,0,0,,Мияко-чан Нина-чан➡
Dialogue: 0,0:08:58.71,0:09:01.31,Default,,0,0,0,,Мен Рио Каэде мен Ами Рюден сұрай аламын ба?
Dialogue: 0,0:09:01.31,0:09:03.31,Default,,0,0,0,,О. (Мияко) Маған қалдырыңыз. Ха!
Dialogue: 0,0:09:04.88,0:09:07.22,Default,,0,0,0,,Комагава мырза. Ута-чан тег ойыны➡
Dialogue: 0,0:09:07.22,0:09:09.95,Default,,0,0,0,,Мен сені қатты жақсы көремін! Хехехе!
Dialogue: 0,0:09:09.95,0:09:12.32,Default,,0,0,0,,Мен саған жол бермеймін
Dialogue: 0,0:09:12.32,0:09:31.21,Default,,0,0,0,,♬～
Dialogue: 0,0:09:31.21,0:09:35.08,Default,,0,0,0,,Арх! Уф! Уф! Хмм...
Dialogue: 0,0:09:35.08,0:09:38.68,Default,,0,0,0,,≪Бұл жігіт не өзі?!≫
Dialogue: 0,0:09:38.68,0:09:41.48,Default,,0,0,0,,Асығыңыз! (Токио) Мен білемін! ➡
Dialogue: 0,0:09:41.48,0:09:43.52,Default,,0,0,0,,А... менің бөлмемде.
Dialogue: 0,0:09:43.52,0:09:45.62,Default,,0,0,0,,Мен оны ұстадым. (Мияко) Уау!
Dialogue: 0,0:09:45.62,0:09:48.42,Default,,0,0,0,,Уфуфу. Ах!
Dialogue: 0,0:09:48.42,0:09:51.26,Default,,0,0,0,,Хмф! Башу!
Dialogue: 0,0:09:51.26,0:09:53.30,Default,,0,0,0,,Ах. Апыр-ай!
Dialogue: 0,0:09:53.30,0:09:55.33,Default,,0,0,0,,Гакин! Арх!
Dialogue: 0,0:09:55.33,0:09:57.27,Default,,0,0,0,,Жүр! (Токио) Иә
Dialogue: 0,0:09:57.27,0:10:00.30,Default,,0,0,0,,♬～
Dialogue: 0,0:10:00.30,0:10:03.44,Default,,0,0,0,,Уау. Біз қайтадан жалғыз қалдық.
Dialogue: 0,0:10:03.44,0:10:06.88,Default,,0,0,0,,А, мен саған көп еркелетемін.
Dialogue: 0,0:10:06.88,0:10:08.91,Default,,0,0,0,,Өтініш жазылған конверт жоғалып кетті.
Dialogue: 0,0:10:08.91,0:10:14.95,Default,,0,0,0,,♬～
Dialogue: 0,0:10:14.95,0:10:16.99,Default,,0,0,0,,Сонымен, мен Кираны қоса алғанда сегіз адаммен бірге сусын іштім.
Dialogue: 0,0:10:16.99,0:10:21.36,Default,,0,0,0,,♬～
Dialogue: 0,0:10:21.36,0:10:23.39,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:23.39,0:10:27.90,Default,,0,0,0,,Күрсін... Күрсін... Күрсін...
Dialogue: 0,0:10:27.90,0:10:31.47,Default,,0,0,0,,Мен тағы да қателік жібердім деп ойлаймын...｡➡
Dialogue: 0,0:10:31.47,0:10:34.14,Default,,0,0,0,,Ами Рюді қатыстырыңыз.➡
Dialogue: 0,0:10:34.14,0:10:37.01,Default,,0,0,0,,Ух... ой...
Dialogue: 0,0:10:37.01,0:10:41.61,Default,,0,0,0,,Сол сақина сіздің асыл сезімдеріңізді құрбан етеді.➡
Dialogue: 0,0:10:41.61,0:10:45.68,Default,,0,0,0,,Ами-сан сіз қорғамақ болған сезімдеріңізді алып тастайды.
Dialogue: 0,0:10:45.68,0:10:49.18,Default,,0,0,0,,Ами Рюу? (Мияко) Бірақ мен көңілім қалды➡
Dialogue: 0,0:10:49.18,0:10:53.36,Default,,0,0,0,,Өкінемін және қатты ауырғаны сонша, мен ештеңе істей алмаймын.
Dialogue: 0,0:10:53.36,0:10:57.06,Default,,0,0,0,,Сізде дәл қазір ой бар.➡
Dialogue: 0,0:10:57.06,0:10:59.80,Default,,0,0,0,,Шайқас әлі аяқталған жоқ. Ах.
Dialogue: 0,0:10:59.80,0:11:04.40,Default,,0,0,0,,♬～
Dialogue: 0,0:11:04.40,0:11:06.80,Default,,0,0,0,,Бұл жерде де қауіпті. Барайық.
Dialogue: 0,0:11:06.80,0:11:09.87,Default,,0,0,0,,♬～
Dialogue: 0,0:11:09.87,0:11:12.61,Default,,0,0,0,,Хмм... Аа, не істеп жатырсың...
Dialogue: 0,0:11:12.61,0:11:15.44,Default,,0,0,0,,Шиноның қайда екенін табыңыз
Dialogue: 0,0:11:15.44,0:11:18.38,Default,,0,0,0,,Ол бала қазір бұл дүниеде жоқ.
Dialogue: 0,0:11:18.38,0:11:20.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:20.82,0:11:25.22,Default,,0,0,0,,Өзіңізді жасыру үшін осы әлем мен жалпының арасында кеңістік жасаңыз.
Dialogue: 0,0:11:25.22,0:11:27.26,Default,,0,0,0,,Хехехе
Dialogue: 0,0:11:27.26,0:11:30.29,Default,,0,0,0,,≪Бұл жігіт не өзі?!≫
Dialogue: 0,0:11:30.29,0:11:34.13,Default,,0,0,0,,Бірақ мына сақина менде болса➡
Dialogue: 0,0:11:34.13,0:11:36.67,Default,,0,0,0,,Мен Шиноны таба алатыныма сенімдімін.
Dialogue: 0,0:11:36.67,0:11:39.74,Default,,0,0,0,,♬～
Dialogue: 0,0:11:39.74,0:11:42.67,Default,,0,0,0,,Догон! Уф!
Dialogue: 0,0:11:42.67,0:11:44.67,Default,,0,0,0,,Рука-чан!
Dialogue: 0,0:11:46.61,0:11:49.01,Default,,0,0,0,,Ха. Қарғыс атсын! Бишу!
Dialogue: 0,0:11:50.31,0:11:52.41,Default,,0,0,0,,Бассейн!
Dialogue: 0,0:11:54.45,0:11:57.02,Default,,0,0,0,,Хааааааааааааааааааааааааааааааа... Хмм!
Dialogue: 0,0:11:57.02,0:12:00.72,Default,,0,0,0,,♬～
Dialogue: 0,0:12:00.72,0:12:03.36,Default,,0,0,0,,Ха! Башан!
Dialogue: 0,0:12:03.36,0:12:12.84,Default,,0,0,0,,♬～
Dialogue: 0,0:12:12.84,0:12:17.14,Default,,0,0,0,,Ха ха ха ха...｡➡
Dialogue: 0,0:12:17.14,0:12:21.24,Default,,0,0,0,,Күрсін... Күрсін... Қалай күресуім керек?
Dialogue: 0,0:12:23.15,0:12:27.15,Default,,0,0,0,,Кешіріңіз, Рука-чан. Бұл туралы...
Dialogue: 0,0:12:27.15,0:12:30.15,Default,,0,0,0,,Мен әрқашан үмітсіз болдым
Dialogue: 0,0:12:30.15,0:12:33.59,Default,,0,0,0,,Менің әпкем мен үшін маңызды, мен оны қорғағым келеді.
Dialogue: 0,0:12:33.59,0:12:37.49,Default,,0,0,0,,Бір кезде шындықты айтуға қорықтым.
Dialogue: 0,0:12:39.70,0:12:43.33,Default,,0,0,0,,Бұл жай ғана көңілді емес.
Dialogue: 0,0:12:43.33,0:12:46.07,Default,,0,0,0,,Қайғылы немесе ашулы сезім➡
Dialogue: 0,0:12:46.07,0:12:48.57,Default,,0,0,0,,Екеуміз бірге жүргенде неше түрлі сезімдерді сезінеміз.
Dialogue: 0,0:12:49.91,0:12:53.91,Default,,0,0,0,,Бұл әлі де маңызды.
Dialogue: 0,0:12:53.91,0:12:56.21,Default,,0,0,0,,Рука-чан маған айтты
Dialogue: 0,0:12:56.21,0:12:58.25,Default,,0,0,0,,…
Dialogue: 0,0:12:58.25,0:13:01.02,Default,,0,0,0,,<<Шыңғыр...(тізбектердің дыбысы) (2 адам) Ха!
Dialogue: 0,0:13:01.02,0:13:03.12,Default,,0,0,0,,Дабыл!
Dialogue: 0,0:13:09.06,0:13:12.16,Default,,0,0,0,,Мен сені қайдан білсем де, өзгермеймін.
Dialogue: 0,0:13:14.66,0:13:18.73,Default,,0,0,0,,Егер сіз ақымақтық жасасаңыз, мені ақымақ деп айтыңыз.
Dialogue: 0,0:13:18.73,0:13:21.40,Default,,0,0,0,,Мен тек оқуды бітіргендіктен ойлаймын
Dialogue: 0,0:13:21.40,0:13:24.47,Default,,0,0,0,,Хехе. Сосын мен де ақымақпын дейсің.
Dialogue: 0,0:13:24.47,0:13:26.51,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:13:26.51,0:13:30.18,Default,,0,0,0,,♬～
Dialogue: 0,0:13:30.18,0:13:34.48,Default,,0,0,0,,Есікті бірге жабайық. Хосакури екеуміздің ойымызбен.
Dialogue: 0,0:13:36.62,0:13:38.69,Default,,0,0,0,,<<Ол бала әлі білмейді>>
Dialogue: 0,0:13:38.69,0:13:42.62,Default,,0,0,0,,≪Білсең, қашып құтыла алмайтын қараңғылық бар≫
Dialogue: 0,0:13:42.62,0:13:44.63,Default,,0,0,0,,Күрсін!
Dialogue: 0,0:13:44.63,0:13:46.73,Default,,0,0,0,,≪Сол қараңғылықтан...➡
Dialogue: 0,0:13:46.73,0:13:49.70,Default,,0,0,0,,Йосакуриді үмітсіздіктен қорғай алатын жалғыз адаммын≫
Dialogue: 0,0:13:49.70,0:13:52.40,Default,,0,0,0,,Күрсін! Гакин!
Dialogue: 0,0:13:54.80,0:13:57.40,Default,,0,0,0,,Уф! Арх!
Dialogue: 0,0:13:58.71,0:14:00.74,Default,,0,0,0,,≪Мен Сакураймын! ≫
Dialogue: 0,0:14:00.74,0:14:10.74,Default,,0,0,0,,♬～
Dialogue: 0,0:16:15.28,0:16:17.75,Default,,0,0,0,,≪Бұл қашан болды? Бұл➡
Dialogue: 0,0:16:17.75,0:16:21.82,Default,,0,0,0,,Мәңгіліктей сезілетін азапты кім білген?➡
Dialogue: 0,0:16:21.82,0:16:24.79,Default,,0,0,0,,Бір адам Басқа адам➡
Dialogue: 0,0:16:24.79,0:16:28.49,Default,,0,0,0,,Менің қымбат заттарымды алып кетіп жатыр≫
Dialogue: 0,0:16:28.49,0:16:34.30,Default,,0,0,0,,♬～
Dialogue: 0,0:16:34.30,0:16:36.77,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:16:36.77,0:16:41.87,Default,,0,0,0,,≪Мұндай болған сайын жүрегім қатты батады.➡
Dialogue: 0,0:16:41.87,0:16:45.87,Default,,0,0,0,,Шығуы жоқ терең, қараңғы тереңдіктерге≫
Dialogue: 0,0:16:45.87,0:16:48.17,Default,,0,0,0,,)
Dialogue: 0,0:16:49.85,0:16:52.48,Default,,0,0,0,,)
Dialogue: 0,0:16:52.48,0:16:55.05,Default,,0,0,0,,≪Бәрі де маған жарқырайды➡
Dialogue: 0,0:16:55.05,0:16:57.09,Default,,0,0,0,,Бір ғана жарық болды≫
