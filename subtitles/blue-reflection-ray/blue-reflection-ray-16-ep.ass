Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:34.29,0:01:39.76,Default,,0,0,0,,♬～
Dialogue: 0,0:01:39.76,0:01:43.94,Default,,0,0,0,,Эй, Райо Каэде, тазалау қиын болды➡
Dialogue: 0,0:01:43.94,0:01:46.24,Default,,0,0,0,,Көңілді болды.➡
Dialogue: 0,0:01:46.24,0:01:50.24,Default,,0,0,0,,Барлығымен дос болыңыз. (Рё Каэде) Дұрыс.
Dialogue: 0,0:01:50.24,0:01:53.98,Default,,0,0,0,,Бәріміз бірге болайық...
Dialogue: 0,0:01:53.98,0:02:05.42,Default,,0,0,0,,♬～
Dialogue: 0,0:02:05.42,0:02:08.49,Default,,0,0,0,,(((Неге осылай қала алмайды?))
Dialogue: 0,0:02:08.49,0:02:13.10,Default,,0,0,0,,((Аа…｡ Рюкаэде: Сіз мұны бұрын айттыңыз, солай ма?➡)
Dialogue: 0,0:02:13.10,0:02:15.67,Default,,0,0,0,,Мен ешкіммен кездескім келмейді))
Dialogue: 0,0:02:15.67,0:02:20.54,Default,,0,0,0,,♬～
Dialogue: 0,0:02:20.54,0:02:24.84,Default,,0,0,0,,((Егер сіз бірдеңені байлап алсаңыз, ол шешілмейтін уақыт келеді.➡)
Dialogue: 0,0:02:24.84,0:02:29.74,Default,,0,0,0,,Мен Амирумен бірге бола аламын))
Dialogue: 0,0:02:31.18,0:02:33.22,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:02:33.22,0:02:35.19,Default,,0,0,0,,)
Dialogue: 0,0:02:35.19,0:02:38.29,Default,,0,0,0,,)
Dialogue: 0,0:02:40.09,0:02:42.09,Default,,0,0,0,,Ами Рю…
Dialogue: 0,0:02:45.13,0:02:47.13,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:48.63,0:02:50.67,Default,,0,0,0,,'Ол да сондай.'
Dialogue: 0,0:02:50.67,0:02:54.97,Default,,0,0,0,,♬～
Dialogue: 0,0:02:54.97,0:02:57.11,Default,,0,0,0,,Сіздің…➡
Dialogue: 0,0:02:57.11,0:02:59.81,Default,,0,0,0,,Мен сенің мұңыңды қалаймын
Dialogue: 0,0:03:01.31,0:03:21.33,Default,,0,0,0,,♬～
Dialogue: 0,0:03:21.33,0:03:39.72,Default,,0,0,0,,♬～
Dialogue: 0,0:03:39.72,0:03:43.12,Default,,0,0,0,,♬～
Dialogue: 0,0:03:43.12,0:04:02.21,Default,,0,0,0,,♬～
Dialogue: 0,0:04:02.21,0:04:13.91,Default,,0,0,0,,♬～
Dialogue: 0,0:04:15.45,0:04:18.96,Default,,0,0,0,,♬～
Dialogue: 0,0:04:18.96,0:04:29.96,Default,,0,0,0,,♬～
Dialogue: 0,0:04:31.34,0:04:34.37,Default,,0,0,0,,♬～
Dialogue: 0,0:04:34.37,0:04:37.21,Default,,0,0,0,,Ойды ортақ оймен байланыстыру?
Dialogue: 0,0:04:37.21,0:04:40.91,Default,,0,0,0,,Жалпыға Райму Шидзо және Юдзуки кіреді.➡
Dialogue: 0,0:04:40.91,0:04:43.45,Default,,0,0,0,,Егер олар жалпыға қамқоршы болса➡
Dialogue: 0,0:04:43.45,0:04:46.28,Default,,0,0,0,,Сіз өз ойларыңызды қайтарудың жолын таба аласыз
Dialogue: 0,0:04:46.28,0:04:48.32,Default,,0,0,0,,Юдзу-чан және Лайм-чан➡
Dialogue: 0,0:04:48.32,0:04:51.06,Default,,0,0,0,,Екі адаммен сөйлесу керек пе? Хирахара мырза➡
Dialogue: 0,0:04:51.06,0:04:54.66,Default,,0,0,0,,Ол бұрын екі дауыс естігенін айтты. Иә.
Dialogue: 0,0:04:54.66,0:04:58.76,Default,,0,0,0,,Бірақ кеңістік-уақыттың бұрмалануынан бері,
Dialogue: 0,0:04:58.76,0:05:01.83,Default,,0,0,0,,Жай ғана күтсеңіз де, қосылу мүмкіндігі төмен.
Dialogue: 0,0:05:01.83,0:05:04.70,Default,,0,0,0,,Сонымен не істейміз?
Dialogue: 0,0:05:04.70,0:05:07.77,Default,,0,0,0,,Момо-санның сезімін ұрлаған күн есіңде ме?
Dialogue: 0,0:05:07.77,0:05:09.81,Default,,0,0,0,,Иә
Dialogue: 0,0:05:09.81,0:05:14.68,Default,,0,0,0,,Сол күні Хосакуридің әпкесі кенеттен ойының күшін арттырды➡
Dialogue: 0,0:05:14.68,0:05:17.82,Default,,0,0,0,,Шынайы әлемге ортақ тартады
Dialogue: 0,0:05:17.82,0:05:21.72,Default,,0,0,0,,Юри Сайки қыздың сезімін қашыртпай➡ дейді
Dialogue: 0,0:05:21.72,0:05:25.42,Default,,0,0,0,,Тіпті секіріс ауқымына ұқсас жағдайды жасасаңыз да.
Dialogue: 0,0:05:25.42,0:05:28.23,Default,,0,0,0,,Секіру диапазоны. Сол кезде➡
Dialogue: 0,0:05:28.23,0:05:32.90,Default,,0,0,0,,Мен Юдзу-чан мен Лайм-чанның дауысын естідім, олар маған күш берді.
Dialogue: 0,0:05:32.90,0:05:36.90,Default,,0,0,0,,Осыған ұқсас жағдайда... (Мияко) Ойлар байланысқан➡
Dialogue: 0,0:05:36.90,0:05:39.94,Default,,0,0,0,,Ортақ екі адаммен сөйлесуге болады.
Dialogue: 0,0:05:39.94,0:05:42.21,Default,,0,0,0,,Енді орындайық.
Dialogue: 0,0:05:42.21,0:05:44.51,Default,,0,0,0,,Амиру ұйықтар алдында➡
Dialogue: 0,0:05:44.51,0:05:49.21,Default,,0,0,0,,Мен екеумізге бір-бірімізге сезімімізді қайтара алатынымызды айтқым келеді.
Dialogue: 0,0:05:49.21,0:05:51.21,Default,,0,0,0,,Рука-чан...
Dialogue: 0,0:05:53.28,0:06:00.76,Default,,0,0,0,,♬～
Dialogue: 0,0:06:00.76,0:06:04.90,Default,,0,0,0,,Хмм... Мм! Хмм! Bang! Bang!
Dialogue: 0,0:06:04.90,0:06:08.27,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:06:08.27,0:06:11.20,Default,,0,0,0,,((Бұл үй.➡
Dialogue: 0,0:06:11.20,0:06:15.17,Default,,0,0,0,,Мен әкеммен ажырасқанда сен екеуміз маңызды едік➡
Dialogue: 0,0:06:15.17,0:06:17.78,Default,,0,0,0,,Барлығын жинап шықтым))
Dialogue: 0,0:06:17.78,0:06:20.08,Default,,0,0,0,,Мм! Bang!
Dialogue: 0,0:06:20.08,0:06:23.18,Default,,0,0,0,,Ах, ха, ха...｡➡
Dialogue: 0,0:06:23.18,0:06:25.28,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:27.49,0:06:30.99,Default,,0,0,0,,Хе... әлгі қарғыс атқыр қарғыс.
Dialogue: 0,0:06:32.82,0:06:36.42,Default,,0,0,0,,Нина-чан? Не болды?
Dialogue: 0,0:06:37.80,0:06:39.83,Default,,0,0,0,,Ол қашан шешіледі?
Dialogue: 0,0:06:39.83,0:06:43.47,Default,,0,0,0,,♬～
Dialogue: 0,0:06:43.47,0:06:46.94,Default,,0,0,0,,Мұнда үлкен апалар Юзу-чан мен Лайм-чан ➡
Dialogue: 0,0:06:46.94,0:06:50.01,Default,,0,0,0,,Сақинаны алды
Dialogue: 0,0:06:50.01,0:06:52.44,Default,,0,0,0,,Бірде құрдымға кеткен дүниеде.➡
Dialogue: 0,0:06:52.44,0:06:55.45,Default,,0,0,0,,Апамның есінде қалған жер осы.
Dialogue: 0,0:06:55.45,0:06:58.92,Default,,0,0,0,,Біздің ойларымызды байланыстыру үшін оларға байланысты орынды табыңыз➡
Dialogue: 0,0:06:58.92,0:07:02.35,Default,,0,0,0,,Бұл қажет болды... бірақ бұл тамаша.
Dialogue: 0,0:07:02.35,0:07:06.36,Default,,0,0,0,,Сайки мырза осылай деді ме? (Мияко) Ух... бұл солай.
Dialogue: 0,0:07:06.36,0:07:09.46,Default,,0,0,0,,Нина-чан, маған хабарлағаныңызға рахмет.
Dialogue: 0,0:07:09.46,0:07:13.86,Default,,0,0,0,,Хм... Мен сізге айтамын, егер сіз оны жалпыға қоссаңыз➡
Dialogue: 0,0:07:13.86,0:07:17.94,Default,,0,0,0,,Шино міндетті түрде байқап, шабуыл жасайды.
Dialogue: 0,0:07:17.94,0:07:20.91,Default,,0,0,0,,Әңгімені тыңдап болған бойда байланысты үзіңіз.
Dialogue: 0,0:07:20.91,0:07:24.91,Default,,0,0,0,,Иә. Рука-чан, бастайық.
Dialogue: 0,0:07:24.91,0:07:26.94,Default,,0,0,0,,Иә
Dialogue: 0,0:07:26.94,0:07:37.46,Default,,0,0,0,,♬～
Dialogue: 0,0:07:37.46,0:07:40.83,Default,,0,0,0,,≪Келіңіз≫
Dialogue: 0,0:07:40.83,0:07:43.33,Default,,0,0,0,,≪Юдзу-чан Лайм-чан≫
Dialogue: 0,0:07:45.96,0:07:49.33,Default,,0,0,0,,Аа...｡ Иә.➡
Dialogue: 0,0:07:49.33,0:07:53.67,Default,,0,0,0,,Мені топтан қалдыруға қалай дәтің бар➡
Dialogue: 0,0:07:53.67,0:07:55.77,Default,,0,0,0,,Өте дөрекі
Dialogue: 0,0:07:59.54,0:08:01.58,Default,,0,0,0,,Thump Thump (құлап түскен дыбыс) Ио, Сакурай! Ханари мырза!
Dialogue: 0,0:08:01.58,0:08:04.55,Default,,0,0,0,,Тынышталыңыз. Бірақ...
Dialogue: 0,0:08:04.55,0:08:09.22,Default,,0,0,0,,Оған тек сана ғана тартылған шығар.➡
Dialogue: 0,0:08:09.22,0:08:11.82,Default,,0,0,0,,Тек күту ғана қалды
Dialogue: 0,0:08:11.82,0:08:15.86,Default,,0,0,0,,Haaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa, 10, 20, 2017
Dialogue: 0,0:08:15.86,0:08:17.96,Default,,0,0,0,,Уф!
Dialogue: 0,0:08:19.40,0:08:23.00,Default,,0,0,0,,Әй, Момо-сан!
Dialogue: 0,0:08:23.00,0:08:25.47,Default,,0,0,0,,Момо-сан, оян! Мен ұйықтап қалдым...
Dialogue: 0,0:08:25.47,0:08:27.57,Default,,0,0,0,,Ха...
Dialogue: 0,0:08:30.17,0:08:32.71,Default,,0,0,0,,Неге тек екі адам?
Dialogue: 0,0:08:32.71,0:08:34.75,Default,,0,0,0,,Уақытында үлгермедің бе?
Dialogue: 0,0:08:34.75,0:08:37.15,Default,,0,0,0,,Рука-чан. Маған бұл ұнамайды!
Dialogue: 0,0:08:37.15,0:08:40.62,Default,,0,0,0,,Йо Сакурай-чан. Өтінемін, басқа ешкім...
Dialogue: 0,0:08:40.62,0:08:43.82,Default,,0,0,0,,Оян. (2 адам) А.
Dialogue: 0,0:08:45.66,0:08:48.16,Default,,0,0,0,,Бұл жиі кездеседі ме?
Dialogue: 0,0:08:48.16,0:08:52.83,Default,,0,0,0,,Жоқ (Райму) Нақты да, жалпы емес➡
Dialogue: 0,0:08:52.83,0:08:54.97,Default,,0,0,0,,Аралық әлем
Dialogue: 0,0:08:54.97,0:08:57.27,Default,,0,0,0,,Юдзу-чан! Лайм-чан!
Dialogue: 0,0:08:57.27,0:08:59.27,Default,,0,0,0,,Сіз...
Dialogue: 0,0:09:01.31,0:09:05.01,Default,,0,0,0,,Маған сезімімді қалай қайтаруға болатынын айтыңызшы.
Dialogue: 0,0:09:05.01,0:09:09.38,Default,,0,0,0,,Мен көмектескім келетін адамдар бар. Олардың барлығы қиналып жатыр.
Dialogue: 0,0:09:09.38,0:09:12.88,Default,,0,0,0,,Есі кеткен адам да, айналасындағы адамдар да
Dialogue: 0,0:09:14.42,0:09:19.02,Default,,0,0,0,,Мен де сенен сұраймын. Екеуіңіз мұны қалай жасау керектігін анықтай алатыныңызға сенімдімін...
Dialogue: 0,0:09:19.02,0:09:22.63,Default,,0,0,0,,Мен түсіндім. (Райму) Менің сезімдерімді бастапқы күйіне қайтаруға болады.
Dialogue: 0,0:09:22.63,0:09:24.63,Default,,0,0,0,,Ах
Dialogue: 0,0:09:26.03,0:09:28.07,Default,,0,0,0,,Сезімдерді қайтаруға болады
Dialogue: 0,0:09:28.07,0:09:31.84,Default,,0,0,0,,Мм... Ой тек сол адамға ғана тән.
Dialogue: 0,0:09:31.84,0:09:35.57,Default,,0,0,0,,Алып кетсе де, ешкімдікі емес.
Dialogue: 0,0:09:35.57,0:09:40.58,Default,,0,0,0,,Егер сізде фрагмент болса, оны қайтадан біріктіруге болады.
Dialogue: 0,0:09:40.58,0:09:43.08,Default,,0,0,0,,Бірақ...｡ (2 адам) Ах.
Dialogue: 0,0:09:45.18,0:09:49.52,Default,,0,0,0,,Эй, Ами-Рю туралы не ойлайсың? ➡
Dialogue: 0,0:09:49.52,0:09:51.59,Default,,0,0,0,,Себебін білесіз бе?
Dialogue: 0,0:09:51.59,0:09:56.43,Default,,0,0,0,,Оның маған деген сезімі әпкемге деген сезіміне ұқсас болды.
Dialogue: 0,0:09:56.43,0:09:58.80,Default,,0,0,0,,Мен жібергім келмейді
Dialogue: 0,0:09:58.80,0:10:01.73,Default,,0,0,0,,Ондай жағдайда Ами-сан неге...
Dialogue: 0,0:10:01.73,0:10:05.77,Default,,0,0,0,,Коа Миру басқа қыздардан ерекше болды.
Dialogue: 0,0:10:05.77,0:10:08.77,Default,,0,0,0,,))
Dialogue: 0,0:10:08.77,0:10:13.68,Default,,0,0,0,,♬～
Dialogue: 0,0:10:13.68,0:10:17.31,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:10:17.31,0:10:22.12,Default,,0,0,0,,((Алғаш кездескенде біртүрлі болды))
Dialogue: 0,0:10:22.12,0:10:27.12,Default,,0,0,0,,((Екеумізде басқа біреу бар сияқты араласамыз➡
Dialogue: 0,0:10:27.12,0:10:31.72,Default,,0,0,0,,Мен оның бойынан көптеген ойларды таптым))
Dialogue: 0,0:10:33.06,0:10:36.47,Default,,0,0,0,,((Мен оны тастағым келмейді. Бірақ➡
Dialogue: 0,0:10:36.47,0:10:39.54,Default,,0,0,0,,Тек осы ойдың пайдасы жоқ.➡
Dialogue: 0,0:10:39.54,0:10:43.94,Default,,0,0,0,,Екеуміз бірдей болмасақ, мен Рио Каэдемен бірге бола алмаймын))
Dialogue: 0,0:10:46.01,0:10:50.91,Default,,0,0,0,,Бұл жігіт Риокае Тачибанаға деген сезімін тастауды жөн көрді.
Dialogue: 0,0:10:53.02,0:10:56.32,Default,,0,0,0,,Уф...｡ (Нина) Бірақ...
Dialogue: 0,0:10:56.32,0:11:00.86,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:11:00.86,0:11:03.86,Default,,0,0,0,,Коаамирудың сезімі қайтып келмейінше➡
Dialogue: 0,0:11:03.86,0:11:06.86,Default,,0,0,0,,Екеуің өмір бойы бір-біріңмен байланыста боласыңдар.➡
Dialogue: 0,0:11:06.86,0:11:09.60,Default,,0,0,0,,Ақырында артта қалған сезімдер...
Dialogue: 0,0:11:09.60,0:11:17.64,Default,,0,0,0,,♬～
Dialogue: 0,0:11:17.64,0:11:20.44,Default,,0,0,0,,Сіз қайтадан бардыңыз. Иә.
Dialogue: 0,0:11:20.44,0:11:25.88,Default,,0,0,0,,♬～
Dialogue: 0,0:11:25.88,0:11:29.92,Default,,0,0,0,,Бұл менмін. Рио Каэде қай автобуспен жүреді?
Dialogue: 0,0:11:29.92,0:11:33.76,Default,,0,0,0,,Сіз болжам жасайсыз ба? Әлі шықты ма?
Dialogue: 0,0:11:33.76,0:11:36.36,Default,,0,0,0,,Жоқ, бұл сөзсіз рас.
Dialogue: 0,0:11:37.70,0:11:39.70,Default,,0,0,0,,Шынымен айтамын, рас.
Dialogue: 0,0:11:41.10,0:11:44.47,Default,,0,0,0,,Өйткені Рио Каэде екеуміз ұқсаспыз.
Dialogue: 0,0:11:44.47,0:11:47.57,Default,,0,0,0,,♬～
Dialogue: 0,0:11:47.57,0:11:49.61,Default,,0,0,0,,Ами Рю…
Dialogue: 0,0:11:49.61,0:11:53.01,Default,,0,0,0,,♬～
Dialogue: 0,0:11:53.01,0:11:56.08,Default,,0,0,0,,Менімен келесің бе?
Dialogue: 0,0:11:56.08,0:11:58.02,Default,,0,0,0,,Иә
Dialogue: 0,0:11:58.02,0:12:02.02,Default,,0,0,0,,Солай... Сонда мен не істеуім керек...
Dialogue: 0,0:12:02.02,0:12:05.62,Default,,0,0,0,,Ойымызды өзгерту үшін не істеуіміз керек?
Dialogue: 0,0:12:05.62,0:12:07.72,Default,,0,0,0,,Бұл... (2 адам) А!
Dialogue: 0,0:12:09.16,0:12:12.50,Default,,0,0,0,,Не болды...
Dialogue: 0,0:12:12.50,0:12:14.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:14.53,0:12:16.57,Default,,0,0,0,,Екеуің тез оралыңдар!
Dialogue: 0,0:12:16.57,0:12:18.57,Default,,0,0,0,,Шино-чан мені мазалайды
Dialogue: 0,0:12:20.57,0:12:24.14,Default,,0,0,0,,Әй, пәле жігіт келе жатыр.
Dialogue: 0,0:12:24.14,0:12:26.14,Default,,0,0,0,,Не? (Нина) Артында бол!
Dialogue: 0,0:12:28.21,0:12:31.05,Default,,0,0,0,,Иә!? (Нина) Әй!
Dialogue: 0,0:12:31.05,0:12:33.95,Default,,0,0,0,,Уф...｡ Ммм.
Dialogue: 0,0:12:33.95,0:12:38.72,Default,,0,0,0,,Сенпай! Мен бұл жақта екенімді сене алмадым.➡
Dialogue: 0,0:12:38.72,0:12:43.73,Default,,0,0,0,,Сен аға ретінде мені қалай қуанту керектігін жақсы білесің.
Dialogue: 0,0:12:43.73,0:12:45.80,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:12:45.80,0:12:49.03,Default,,0,0,0,,Ахх. Таңқаларлық аңғал реакция.
Dialogue: 0,0:12:49.03,0:12:53.13,Default,,0,0,0,,Цк...｡ Уфуху. Фуфу!
Dialogue: 0,0:12:55.04,0:12:57.51,Default,,0,0,0,,Капитал! (Мияко) Не? Күте тұрыңыз... сіз мені бірдеңе деп атайсыз ба?
Dialogue: 0,0:12:57.51,0:12:59.88,Default,,0,0,0,,Сіз оларды қорғауыңыз керек!
Dialogue: 0,0:12:59.88,0:13:02.98,Default,,0,0,0,,Иә!? Мені қорғаңыз...
Dialogue: 0,0:13:05.42,0:13:09.35,Default,,0,0,0,,Сіздің қарсыласыңыз – мен. Әрине~｡➡
Dialogue: 0,0:13:09.35,0:13:14.43,Default,,0,0,0,,Ах! Енді біз бір-бірімізді шынымен ренжіте аламыз.
Dialogue: 0,0:13:14.43,0:13:16.99,Default,,0,0,0,,Ең жақсы түнге айналдырайық!
Dialogue: 0,0:13:16.99,0:13:21.63,Default,,0,0,0,,♬～
Dialogue: 0,0:13:21.63,0:13:26.17,Default,,0,0,0,,Енді көбірек! Сондай-ақ! Гакин!
Dialogue: 0,0:13:26.17,0:13:28.37,Default,,0,0,0,,Ах. Хмм...
Dialogue: 0,0:13:31.14,0:13:34.48,Default,,0,0,0,,Сенпай, сыртқа қарауға болмайды.➡
Dialogue: 0,0:13:34.48,0:13:37.08,Default,,0,0,0,,｡ ➡
Dialogue: 0,0:13:37.08,0:13:41.02,Default,,0,0,0,,Өтінемін, мені жынды қылыңыз!
Dialogue: 0,0:13:41.02,0:13:43.05,Default,,0,0,0,,≪Жоқ...≫ (Мияко) Иә?
Dialogue: 0,0:13:43.05,0:13:47.16,Default,,0,0,0,,Хехе. Сіз бұл туралы шындап айтасыз ба?
Dialogue: 0,0:13:47.16,0:13:49.49,Default,,0,0,0,,Ха! Ой...｡➡
Dialogue: 0,0:13:49.49,0:13:53.59,Default,,0,0,0,,Ах... уф... Иә?
Dialogue: 0,0:13:55.00,0:13:59.70,Default,,0,0,0,,Кешіріңіз, кешігіп қалдым. Қазір бәрі жақсы.
Dialogue: 0,0:13:59.70,0:14:02.81,Default,,0,0,0,,Күрсініп... Сондай кешігіп қалдыңыз.
Dialogue: 0,0:14:02.81,0:14:04.81,Default,,0,0,0,,...
Dialogue: 0,0:14:06.31,0:14:10.28,Default,,0,0,0,,Дұрыс, мен ағама айтуды ұмытып кетіппін.
Dialogue: 0,0:14:10.28,0:14:13.78,Default,,0,0,0,,Менде де кенже бар.➡
Dialogue: 0,0:14:13.78,0:14:17.89,Default,,0,0,0,,Дұрыс, менің екі сүйкімді жасым бар.
Dialogue: 0,0:14:17.89,0:14:19.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:21.43,0:14:23.46,Default,,0,0,0,,Бұл...
Dialogue: 0,0:14:23.46,0:14:31.26,Default,,0,0,0,,♬～
Dialogue: 0,0:16:33.96,0:16:36.59,Default,,0,0,0,,…｡ ➡
Dialogue: 0,0:16:36.59,0:16:39.10,Default,,0,0,0,,…
Dialogue: 0,0:16:39.10,0:16:41.13,Default,,0,0,0,,Барлығыңызды кешіріңіз
Dialogue: 0,0:16:41.13,0:16:44.10,Default,,0,0,0,,Біздің бас қосуымыз осылай болатынына сене алар емеспін.
Dialogue: 0,0:16:44.10,0:16:46.14,Default,,0,0,0,,Ах... (поэзия) А?
Dialogue: 0,0:16:46.14,0:16:49.61,Default,,0,0,0,,Екеуің сондай сүйкімді емессіңдер ме?
Dialogue: 0,0:16:49.61,0:16:53.54,Default,,0,0,0,,Бұл... қандай да бір қате, солай ма?
Dialogue: 0,0:16:53.54,0:16:57.31,Default,,0,0,0,,Ойыңды ұрлайтындар ғой, солай ма?
Dialogue: 0,0:16:57.31,0:16:59.35,Default,,0,0,0,,Тек Ами Рю емес➡
Dialogue: 0,0:16:59.35,0:17:02.35,Default,,0,0,0,,Көп баланың ойын ұрладым.
Dialogue: 0,0:17:02.35,0:17:05.99,Default,,0,0,0,,｡
Dialogue: 0,0:17:05.99,0:17:08.03,Default,,0,0,0,,Мен неге екенін білемін!?
Dialogue: 0,0:17:08.03,0:17:10.66,Default,,0,0,0,,Әлі қиналып жүрген балалар көп➡
Dialogue: 0,0:17:10.66,0:17:13.80,Default,,0,0,0,,Бұл сезімді басқалардан жақсы түсінуі керек екі адам
Dialogue: 0,0:17:13.80,0:17:16.30,Default,,0,0,0,,➡
Dialogue: 0,0:17:16.30,0:17:18.90,Default,,0,0,0,,Бұл менің таңдаған жолым деп айта аласыз.
Dialogue: 0,0:17:18.90,0:17:20.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:20.94,0:17:24.01,Default,,0,0,0,,Рука-чан, бұл мен➡
Dialogue: 0,0:17:24.01,0:17:28.78,Default,,0,0,0,,Ажыратылуы керек болған жүрегім қозғалғандай болды.
Dialogue: 0,0:17:28.78,0:17:33.38,Default,,0,0,0,,Егер сіз қазір бар ойларыңызбен әрекет етпесеңіз, сіз міндетті түрде өкінесіз.
Dialogue: 0,0:17:33.38,0:17:37.29,Default,,0,0,0,,Ами-сан…｡ Маған бұл ұнамайды.
Dialogue: 0,0:17:37.29,0:17:39.69,Default,,0,0,0,,Мен ол екеуімен төбелескім келмейді.
Dialogue: 0,0:17:39.69,0:17:44.56,Default,,0,0,0,,Хиорин... сенің әпкең айтты.
Dialogue: 0,0:17:44.56,0:17:47.30,Default,,0,0,0,,Ах. Ах.
Dialogue: 0,0:17:47.30,0:17:49.33,Default,,0,0,0,,«Бұл туралы қалай ойласаңыз да»...｡ ((Қалай ойласаңыз да➡)
Dialogue: 0,0:17:49.33,0:17:51.53,Default,,0,0,0,,Бір-бірімізбен резонанс жасай алмайтын кездер болады.➡
Dialogue: 0,0:17:52.94,0:17:56.41,Default,,0,0,0,,Барар жері жоқ ойлар сізді жеп қояды➡
Dialogue: 0,0:17:56.41,0:18:00.28,Default,,0,0,0,,Айналаңыздағы адамдарды да бұрмалайды)) ((Не дейсіз...))
Dialogue: 0,0:18:00.28,0:18:02.68,Default,,0,0,0,,((Сіз қорқып қалдыңыз)) ()
Dialogue: 0,0:18:02.68,0:18:06.28,Default,,0,0,0,,((Мен шынайы сезімдерімнен бұрылып, өзімді жалғыз жаптым))
Dialogue: 0,0:18:06.28,0:18:08.32,Default,,0,0,0,,) (Миген)((және➡
Dialogue: 0,0:18:08.32,0:18:13.09,Default,,0,0,0,,Көзімді жұмып, өзгенің сезімін өлтірдім.➡
Dialogue: 0,0:18:13.09,0:18:17.23,Default,,0,0,0,,Бар қарым-қатынасты бұзудан қорқу))
Dialogue: 0,0:18:17.23,0:18:21.23,Default,,0,0,0,,((мен...)) (Мизуру)((Мен сені басқалардан артық бағаладым))
Dialogue: 0,0:18:23.00,0:18:25.04,Default,,0,0,0,,((қорғауға тырыстым.➡
Dialogue: 0,0:18:25.04,0:18:29.14,Default,,0,0,0,,Бірақ "маңызды" жоғалып кетті))
Dialogue: 0,0:18:29.14,0:18:31.14,Default,,0,0,0,,)
Dialogue: 0,0:18:33.58,0:18:36.61,Default,,0,0,0,,((Сіз бен мен ұқсаспыз.➡
Dialogue: 0,0:18:36.61,0:18:39.58,Default,,0,0,0,,Барар жерім жоқ сияқты...➡
Dialogue: 0,0:18:39.58,0:18:42.12,Default,,0,0,0,,Өкінішімді күшке айналдырдым))
Dialogue: 0,0:18:42.12,0:18:48.46,Default,,0,0,0,,♬～
Dialogue: 0,0:18:48.46,0:18:52.23,Default,,0,0,0,,((Бұл не?)) ((Өз ойыңызша➡
Dialogue: 0,0:18:52.23,0:18:56.03,Default,,0,0,0,,Жасаған қателіктеріңізді түзетіңіз))
Dialogue: 0,0:18:56.03,0:18:58.07,Default,,0,0,0,,)
Dialogue: 0,0:18:58.07,0:19:01.54,Default,,0,0,0,,♬～
Dialogue: 0,0:19:01.54,0:19:04.04,Default,,0,0,0,,Әпкеңе рахмет.
Dialogue: 0,0:19:04.04,0:19:08.15,Default,,0,0,0,,Мен жүруім керек жолды таба алдым.
Dialogue: 0,0:19:08.15,0:19:11.48,Default,,0,0,0,,Рио Каэде. (2 адам) Хехе
Dialogue: 0,0:19:11.48,0:19:14.38,Default,,0,0,0,,Солай... Қарғыс атсын!
Dialogue: 0,0:19:16.59,0:19:20.52,Default,,0,0,0,,Өкінішімді күшке айналдырамын!
Dialogue: 0,0:19:20.52,0:19:22.56,Default,,0,0,0,,Ами Рюді құтқару үшін➡
Dialogue: 0,0:19:22.56,0:19:26.56,Default,,0,0,0,,Ойымнан қашпаймын, қанша төмен болса да!
Dialogue: 0,0:19:26.56,0:19:30.97,Default,,0,0,0,,Біз міндетті түрде Ами-санның сезімін бастапқы қалпына келтіреміз.
Dialogue: 0,0:19:30.97,0:19:34.84,Default,,0,0,0,,Неліктен мұны бізге қалдырмайсың?
Dialogue: 0,0:19:34.84,0:19:36.84,Default,,0,0,0,,Сіз өз ойларыңызды қайтара аласыз! (2 адам) А
Dialogue: 0,0:19:36.84,0:19:41.81,Default,,0,0,0,,Қайтуыңызға болады! Өтінемін, бізге сеніңіз
Dialogue: 0,0:19:41.81,0:19:43.98,Default,,0,0,0,,Рука-чан...
Dialogue: 0,0:19:43.98,0:19:47.55,Default,,0,0,0,,Дұрыс. Сіз өзіңіздің сезімдеріңізді қайтара аласыз. (3 адам) Иә?
Dialogue: 0,0:19:47.55,0:19:50.25,Default,,0,0,0,,Бірақ ол үшін жалпы есікті ашыңыз➡
Dialogue: 0,0:19:50.25,0:19:52.39,Default,,0,0,0,,Ашылуы керек
Dialogue: 0,0:19:52.39,0:19:55.79,Default,,0,0,0,,Балалар, қазір жауып тастағалы тұрған есік
Dialogue: 0,0:19:55.79,0:19:58.23,Default,,0,0,0,,Ах. (Рё Каэде) Бұл дұрыс емес пе?
Dialogue: 0,0:19:58.23,0:20:00.56,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:20:00.56,0:20:04.37,Default,,0,0,0,,Иә. Сезімдерді тек ортақ сезіммен қайтаруға болады.
Dialogue: 0,0:20:04.37,0:20:07.30,Default,,0,0,0,,Ах...｡ Онда бізге ➡ керек
Dialogue: 0,0:20:07.30,0:20:10.37,Default,,0,0,0,,Бұл мен Сино Мизусаки сияқты әрекет жасауым керек дегенді білдіре ме?
Dialogue: 0,0:20:10.37,0:20:14.31,Default,,0,0,0,,Иә. Ал бізге фрагменттер керек.➡
Dialogue: 0,0:20:14.31,0:20:18.72,Default,,0,0,0,,Хирахара Йо Сакурай! Ол сенікі. Хмм...
Dialogue: 0,0:20:18.72,0:20:22.69,Default,,0,0,0,,)
Dialogue: 0,0:20:22.69,0:20:25.39,Default,,0,0,0,,((Бірақ есікті ашу үшін➡
Dialogue: 0,0:20:25.39,0:20:28.09,Default,,0,0,0,,Сізге Хирахара мырзаның фрагменті керек, солай ма? ))
Dialogue: 0,0:20:28.09,0:20:30.13,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:20:30.13,0:20:33.56,Default,,0,0,0,,() ((Онда мен не істеуім керек...))
Dialogue: 0,0:20:33.56,0:20:36.67,Default,,0,0,0,,)
Dialogue: 0,0:20:36.67,0:20:40.44,Default,,0,0,0,,♬～
Dialogue: 0,0:20:40.44,0:20:42.57,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:20:42.57,0:20:44.57,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:20:46.51,0:20:49.05,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:20:49.05,0:20:51.95,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:20:51.95,0:20:55.59,Default,,0,0,0,,♬～
Dialogue: 0,0:20:55.59,0:20:58.26,Default,,0,0,0,,Рио Каэде-сан, күте тұр! Егер ойласақ...
Dialogue: 0,0:20:58.26,0:21:00.29,Default,,0,0,0,,Сіз оны қайтарып алуға болады дейсіз бе? ➡
Dialogue: 0,0:21:00.29,0:21:03.63,Default,,0,0,0,,Егер басқа жол бар болса, маған хабарлай аласыз ба?
Dialogue: 0,0:21:03.63,0:21:06.33,Default,,0,0,0,,Әдіс... Ммм...
Dialogue: 0,0:21:07.73,0:21:10.33,Default,,0,0,0,,Жоқ. Жоқ...
Dialogue: 0,0:21:10.33,0:21:13.04,Default,,0,0,0,,Маған үзіндіні бермейінше➡
Dialogue: 0,0:21:13.04,0:21:15.47,Default,,0,0,0,,Тек өз ойларыңызды ұрлай беріңіз
Dialogue: 0,0:21:15.47,0:21:20.88,Default,,0,0,0,,♬～
Dialogue: 0,0:21:20.88,0:21:23.68,Default,,0,0,0,,Әлгі бала... Жоқ!
Dialogue: 0,0:21:23.68,0:21:26.55,Default,,0,0,0,,Өтірік өмір сүретін қыз
Dialogue: 0,0:21:26.55,0:21:29.92,Default,,0,0,0,,Сол қайғы. Өтінемін...
Dialogue: 0,0:21:29.92,0:21:33.69,Default,,0,0,0,,Гүлденген үмітсіздік. Біз бәріміз...
Dialogue: 0,0:21:33.69,0:21:35.73,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:21:35.73,0:21:37.73,Default,,0,0,0,,Мұрагерлік
Dialogue: 0,0:21:41.33,0:21:46.33,Default,,0,0,0,,Қалаан Қалаан…(қоңырау дыбысы)
Dialogue: 0,0:21:51.37,0:21:54.24,Default,,0,0,0,,Қандай мұңды дыбыс
Dialogue: 0,0:21:54.24,0:21:59.35,Default,,0,0,0,,Сол екеуі болса, менің асыл гүлдерім міндетті түрде жауап береді.
Dialogue: 0,0:21:59.35,0:22:02.19,Default,,0,0,0,,Иә, әрине.➡
Dialogue: 0,0:22:02.19,0:22:04.49,Default,,0,0,0,,Ал есік ашылады
Dialogue: 0,0:22:06.49,0:22:08.49,Default,,0,0,0,,бастайық
Dialogue: 0,0:22:13.80,0:22:18.84,Default,,0,0,0,,Кин...
Dialogue: 0,0:22:18.84,0:22:20.90,Default,,0,0,0,,Ха! Ха! мылтық!
Dialogue: 0,0:22:20.90,0:22:26.18,Default,,0,0,0,,Кин…
Dialogue: 0,0:22:26.18,0:22:28.18,Default,,0,0,0,,Әй!
Dialogue: 0,0:22:29.58,0:22:31.62,Default,,0,0,0,,Парин! Парин!
Dialogue: 0,0:22:31.62,0:22:34.18,Default,,0,0,0,,Уф! Менің басым...
Dialogue: 0,0:22:34.18,0:22:36.25,Default,,0,0,0,,Сіз не істеп жатырсыз!? Асығыңыз және күресіңіз!
Dialogue: 0,0:22:36.25,0:22:40.19,Default,,0,0,0,,Гакин! Жоқ. Сенпай осында~
Dialogue: 0,0:22:40.19,0:22:43.79,Default,,0,0,0,,Әлі де қанағаттанбаған мені қанағаттандырыңызшы!
Dialogue: 0,0:22:43.79,0:22:45.83,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:22:45.83,0:22:49.30,Default,,0,0,0,,♬～
Dialogue: 0,0:22:49.30,0:22:51.37,Default,,0,0,0,,Иә! (Поэзия) Ах!
Dialogue: 0,0:22:51.37,0:22:53.90,Default,,0,0,0,,Иә! Бури бірі!
Dialogue: 0,0:22:53.90,0:22:56.84,Default,,0,0,0,,Ах! Tsk!
Dialogue: 0,0:22:56.84,0:23:00.28,Default,,0,0,0,,♬～
Dialogue: 0,0:23:00.28,0:23:03.11,Default,,0,0,0,,Күте тұрыңыз! Сіз әлі түсінбейсіз! ➡
Dialogue: 0,0:23:03.11,0:23:06.25,Default,,0,0,0,,Олардың сақиналары сенікінен өзгеше➡
Dialogue: 0,0:23:06.25,0:23:09.82,Default,,0,0,0,,Бұл сіздің теріс ойларыңызды күшейтеді. Тәуелді болған соң➡
Dialogue: 0,0:23:09.82,0:23:12.56,Default,,0,0,0,,Одан құтылу оңай емес. Ұрыс➡
Dialogue: 0,0:23:12.56,0:23:14.59,Default,,0,0,0,,Олардың ойларын бұзыңыз!
Dialogue: 0,0:23:14.59,0:23:18.16,Default,,0,0,0,,Иә! Ұялудың қажеті жоқ!
Dialogue: 0,0:23:18.16,0:23:20.70,Default,,0,0,0,,Гакин! Ах!
Dialogue: 0,0:23:20.70,0:23:23.37,Default,,0,0,0,,Рука-чан! Уф!
Dialogue: 0,0:23:23.37,0:23:26.97,Default,,0,0,0,,♬～
Dialogue: 0,0:23:26.97,0:23:29.01,Default,,0,0,0,,Га
Dialogue: 0,0:23:29.01,0:23:31.04,Default,,0,0,0,,Райо Каэде｡ О
Dialogue: 0,0:23:31.04,0:23:39.52,Default,,0,0,0,,♬～
Dialogue: 0,0:23:39.52,0:23:42.55,Default,,0,0,0,,≪Ах... Мен Ами Рюдің сезімін сезінемін≫
Dialogue: 0,0:23:42.55,0:23:46.32,Default,,0,0,0,,♬～
Dialogue: 0,0:23:46.32,0:23:49.06,Default,,0,0,0,,≪Сағыныш.➡
Dialogue: 0,0:23:49.06,0:23:51.46,Default,,0,0,0,,Мен қазір жоғалтқан дыбыс...≫
Dialogue: 0,0:23:53.83,0:23:56.37,Default,,0,0,0,,Өтінемін, ренжіме, Рука.
Dialogue: 0,0:23:56.37,0:23:58.37,Default,,0,0,0,,Бишун! (Рё Каэде) Ах!
Dialogue: 0,0:23:59.77,0:24:01.81,Default,,0,0,0,,Бассейн! (2 адам) Ой!
Dialogue: 0,0:24:01.81,0:24:07.38,Default,,0,0,0,,♬～
Dialogue: 0,0:24:07.38,0:24:09.41,Default,,0,0,0,,Бакин!
Dialogue: 0,0:24:09.41,0:24:18.86,Default,,0,0,0,,♬～
Dialogue: 0,0:24:18.86,0:24:21.46,Default,,0,0,0,,(Дарио) Бала ма!? Қоя бер!
Dialogue: 0,0:24:22.83,0:24:24.93,Default,,0,0,0,,(Декү) Кешір мені (Каири) Ах…
Dialogue: 0,0:24:26.73,0:24:28.77,Default,,0,0,0,,Райо Каэде!
Dialogue: 0,0:24:28.77,0:24:35.21,Default,,0,0,0,,♬～
Dialogue: 0,0:24:35.21,0:24:37.51,Default,,0,0,0,,Рио Каэде. Хмм...
Dialogue: 0,0:24:37.51,0:24:41.91,Default,,0,0,0,,Уау. Бұл бірінші рет ең жақсы болды.
Dialogue: 0,0:24:41.91,0:24:44.05,Default,,0,0,0,,Райо Каэде!
Dialogue: 0,0:24:44.05,0:24:46.28,Default,,0,0,0,,Күте тұрыңыз, Ами-сан...
Dialogue: 0,0:24:46.28,0:24:48.32,Default,,0,0,0,,Ами-сан!
Dialogue: 0,0:24:48.32,0:24:50.99,Default,,0,0,0,,Хехе. Ах.
Dialogue: 0,0:24:50.99,0:24:53.02,Default,,0,0,0,,Рио Каэде…
Dialogue: 0,0:24:53.02,0:25:04.62,Default,,0,0,0,,♬～
Dialogue: 0,0:25:07.07,0:25:11.41,Default,,0,0,0,,Эй, не болды? Райо Каэде мен Ами Рю ше? ➡
Dialogue: 0,0:25:11.41,0:25:13.44,Default,,0,0,0,,Ах
Dialogue: 0,0:25:13.44,0:25:18.18,Default,,0,0,0,,Мен оны қорғай алмадым. А... Хмм.
Dialogue: 0,0:25:18.18,0:25:22.25,Default,,0,0,0,,Tsk! Ха! Ах
Dialogue: 0,0:25:22.25,0:25:24.19,Default,,0,0,0,,Иә! Уф!
Dialogue: 0,0:25:24.19,0:25:27.06,Default,,0,0,0,,Түсіндіңіз бе? Сіз білетін қарындас➡
Dialogue: 0,0:25:27.06,0:25:29.49,Default,,0,0,0,,Ол енді еш жерде жоқ. Бірақ мен...
Dialogue: 0,0:25:29.49,0:25:32.20,Default,,0,0,0,,Сіз әпкеңізді одан да көп қылмыс жасауға тырысасыз ба?
Dialogue: 0,0:25:32.20,0:25:34.23,Default,,0,0,0,,Ха...
Dialogue: 0,0:25:34.23,0:25:37.63,Default,,0,0,0,,Ойыма орала алсам, адасуға уақытым болмас еді.
Dialogue: 0,0:25:37.63,0:25:39.63,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:25:41.04,0:25:43.04,Default,,0,0,0,,Хмм. Ах.
Dialogue: 0,0:25:48.61,0:25:51.31,Default,,0,0,0,,≪Бұл Нина Чандікі ме? ≫
Dialogue: 0,0:25:51.31,0:25:55.05,Default,,0,0,0,,≪Жоқ. Бұл естелік...≫
Dialogue: 0,0:25:55.05,0:25:57.15,Default,,0,0,0,,Әр нәрсенің басын біл
Dialogue: 0,0:26:00.02,0:26:03.39,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:26:03.39,0:26:05.59,Default,,0,0,0,,)
Dialogue: 0,0:26:06.96,0:26:10.80,Default,,0,0,0,,)
Dialogue: 0,0:26:10.80,0:26:12.90,Default,,0,0,0,,()
Dialogue: 0,0:26:16.34,0:26:35.39,Default,,0,0,0,,♬～
Dialogue: 0,0:26:35.39,0:26:49.71,Default,,0,0,0,,♬～
Dialogue: 0,0:26:49.71,0:26:57.25,Default,,0,0,0,,♬～
Dialogue: 0,0:26:57.25,0:27:10.33,Default,,0,0,0,,♬～
Dialogue: 0,0:27:10.33,0:27:26.38,Default,,0,0,0,,♬～
Dialogue: 0,0:27:26.38,0:27:30.88,Default,,0,0,0,,♬～
Dialogue: 0,0:27:30.88,0:27:45.38,Default,,0,0,0,,♬～
Dialogue: 0,0:29:17.95,0:29:19.99,Default,,0,0,0,,Не болды? Үлкен әпке. Күткендей, әпке!
Dialogue: 0,0:29:19.99,0:29:22.33,Default,,0,0,0,,Сіздің әпкеңіз? Бұл шынымен жақсы ма? Үлкен әпке
Dialogue: 0,0:29:22.33,0:29:24.33,Default,,0,0,0,,Сіздің әпкеңіз ше? (Мизуру) Ананың оралуы➡
Dialogue: 0,0:29:24.33,0:29:26.36,Default,,0,0,0,,Мен саған сенемін. Ақымақ, әпке!
Dialogue: 0,0:29:26.36,0:29:30.26,Default,,0,0,0,,Өйткені сен менің жалғызымсың...
Dialogue: 0,0:29:31.76,0:29:37.76,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
