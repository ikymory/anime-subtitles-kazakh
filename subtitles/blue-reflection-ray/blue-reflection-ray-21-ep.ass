Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:33.90,0:01:46.77,Default,,0,0,0,,♬～
Dialogue: 0,0:01:46.77,0:01:50.14,Default,,0,0,0,,≪Сол күні Шино-чан кәдімгі➡ болып жоғалып кетті
Dialogue: 0,0:01:50.14,0:01:53.05,Default,,0,0,0,,Дүние қайтадан өзгерді≫
Dialogue: 0,0:01:53.05,0:01:55.75,Default,,0,0,0,,Ол 1743 иен болады
Dialogue: 0,0:01:55.75,0:01:58.85,Default,,0,0,0,,♬～
Dialogue: 0,0:01:58.85,0:02:00.95,Default,,0,0,0,,Сықырлау (салынып жатқан монеталардың дыбысы) (Сатушы) Рахмет.
Dialogue: 0,0:02:02.76,0:02:05.53,Default,,0,0,0,,Мм... сізде көп өзгерістер бар...
Dialogue: 0,0:02:05.53,0:02:08.23,Default,,0,0,0,,Қош келдіңіз. Ах.
Dialogue: 0,0:02:09.96,0:02:12.07,Default,,0,0,0,,≪Ой әлсіз болады➡
Dialogue: 0,0:02:12.07,0:02:16.60,Default,,0,0,0,,Адамдар өмірдің минимумын қайталайды≫
Dialogue: 0,0:02:16.60,0:02:21.78,Default,,0,0,0,,♬～
Dialogue: 0,0:02:21.78,0:02:26.08,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз.
Dialogue: 0,0:02:26.08,0:02:30.22,Default,,0,0,0,,Осылайша сіз оны сатып ала алдыңыз.
Dialogue: 0,0:02:30.22,0:02:33.62,Default,,0,0,0,,Сізбен сөйлесетін адам болды ма? хмм...
Dialogue: 0,0:02:35.02,0:02:39.56,Default,,0,0,0,,үшін мені көрмейтіндей қасымнан өтіп жатыр.
Dialogue: 0,0:02:39.56,0:02:42.10,Default,,0,0,0,,≪Әлем баяу➡
Dialogue: 0,0:02:42.10,0:02:44.90,Default,,0,0,0,,Бірақ ол, әрине, жойылуға бет алады≫
Dialogue: 0,0:02:44.90,0:02:50.67,Default,,0,0,0,,♬～(Орголдан «Жабайы раушан» музыкасы)
Dialogue: 0,0:02:50.67,0:02:53.47,Default,,0,0,0,,≪Әйтсе де, біз...≫
Dialogue: 0,0:02:55.51,0:02:57.51,Default,,0,0,0,,≪Мен...≫
Dialogue: 0,0:02:58.91,0:03:18.93,Default,,0,0,0,,♬～
Dialogue: 0,0:03:18.93,0:03:37.32,Default,,0,0,0,,♬～
Dialogue: 0,0:03:37.32,0:03:40.72,Default,,0,0,0,,♬～
Dialogue: 0,0:03:40.72,0:03:59.81,Default,,0,0,0,,♬～
Dialogue: 0,0:03:59.81,0:04:11.51,Default,,0,0,0,,♬～
Dialogue: 0,0:04:13.05,0:04:16.56,Default,,0,0,0,,♬～
Dialogue: 0,0:04:16.56,0:04:27.96,Default,,0,0,0,,♬～
Dialogue: 0,0:04:34.74,0:04:36.94,Default,,0,0,0,,Иә? Хмм...
Dialogue: 0,0:04:39.11,0:04:43.02,Default,,0,0,0,,Иә! Ей, мұнда шөп тастама! ➡
Dialogue: 0,0:04:43.02,0:04:45.02,Default,,0,0,0,,Сіз мұны міндетті түрде әдейі істеп жатырсыз!?
Dialogue: 0,0:04:46.42,0:04:49.86,Default,,0,0,0,,Не? (Нина) Сен ашулысың➡
Dialogue: 0,0:04:49.86,0:04:52.63,Default,,0,0,0,,Сенде бәрі жақсы сияқты. Ах.
Dialogue: 0,0:04:52.63,0:04:54.93,Default,,0,0,0,,Мұны қалай тексеруге болады...｡➡
Dialogue: 0,0:04:56.53,0:04:59.40,Default,,0,0,0,,Осының арқасында.
Dialogue: 0,0:04:59.40,0:05:03.97,Default,,0,0,0,,♬～
Dialogue: 0,0:05:03.97,0:05:06.51,Default,,0,0,0,,() ((≫(рационал) жақсы))
Dialogue: 0,0:05:06.51,0:05:08.98,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:05:08.98,0:05:12.41,Default,,0,0,0,,)
Dialogue: 0,0:05:12.41,0:05:15.78,Default,,0,0,0,,♬～
Dialogue: 0,0:05:15.78,0:05:18.92,Default,,0,0,0,,Көк шағылысу прототипі
Dialogue: 0,0:05:18.92,0:05:23.66,Default,,0,0,0,,Ол өзгере алмайды, бірақ ол менің ойымды қорғайды.
Dialogue: 0,0:05:23.66,0:05:25.73,Default,,0,0,0,,≪Мен үйдемін! Ах
Dialogue: 0,0:05:25.73,0:05:27.73,Default,,0,0,0,,Хехе
Dialogue: 0,0:05:29.66,0:05:32.30,Default,,0,0,0,,Жалпы эрозия таралуда
Dialogue: 0,0:05:32.30,0:05:35.34,Default,,0,0,0,,Себеп сөзсіз Мидзусаки Шино.
Dialogue: 0,0:05:35.34,0:05:38.24,Default,,0,0,0,,Сонымен, сіз ортақ нәрсемен қалағаныңызды жасай аласыз ба?
Dialogue: 0,0:05:38.24,0:05:42.24,Default,,0,0,0,,Шино-чан оған сезім керек емес деді.
Dialogue: 0,0:05:44.58,0:05:46.88,Default,,0,0,0,,Тезірек жалпыға барыңыз➡
Dialogue: 0,0:05:46.88,0:05:50.82,Default,,0,0,0,,Шиноны тоқтатпасақ, адамның ойы жойылады.
Dialogue: 0,0:05:50.82,0:05:54.92,Default,,0,0,0,,Мұны қазір сақиналары барлар ғана жасай алады.
Dialogue: 0,0:05:56.49,0:05:59.06,Default,,0,0,0,,Рука-чан мен Рио Каэде ше?
Dialogue: 0,0:05:59.06,0:06:07.40,Default,,0,0,0,,♬～
Dialogue: 0,0:06:07.40,0:06:10.57,Default,,0,0,0,,Мен Ами-санға үнемі еріп жүрдім.
Dialogue: 0,0:06:10.57,0:06:14.58,Default,,0,0,0,,Күшсіз бе? Олай айтпа.
Dialogue: 0,0:06:14.58,0:06:17.98,Default,,0,0,0,,Әй, бұл сіздің әпкеңіз туралы➡
Dialogue: 0,0:06:17.98,0:06:21.05,Default,,0,0,0,,Сіз шынымен бізбен бірге күресе аласыз ба?
Dialogue: 0,0:06:21.05,0:06:24.72,Default,,0,0,0,,Ах... Эй! Сіз әпкеңізге күмәндануға тырысасыз ба?
Dialogue: 0,0:06:24.72,0:06:29.26,Default,,0,0,0,,Дұрыс! Қанша қиналдық...
Dialogue: 0,0:06:29.26,0:06:32.86,Default,,0,0,0,,Хмм... Сіз де мұны білесіз бе? ➡
Dialogue: 0,0:06:32.86,0:06:36.36,Default,,0,0,0,,Мен бұған оңай сене алмаймын. Хмм!
Dialogue: 0,0:06:36.36,0:06:42.54,Default,,0,0,0,,♬～
Dialogue: 0,0:06:42.54,0:06:45.17,Default,,0,0,0,,≪Гача (есік дыбысы) (2 адам) Ах
Dialogue: 0,0:06:45.17,0:06:48.21,Default,,0,0,0,,Әпке. (Мизуру) Кешіктіргенім үшін кешіріңіз.
Dialogue: 0,0:06:48.21,0:06:50.61,Default,,0,0,0,,Ах
Dialogue: 0,0:06:50.61,0:06:53.35,Default,,0,0,0,,Хм... Білесіз бе, дәл қазір біз айтып отырған нәрсе...
Dialogue: 0,0:06:53.35,0:06:55.95,Default,,0,0,0,,Маған күмәндануыңыз табиғи нәрсе.
Dialogue: 0,0:06:57.85,0:07:00.75,Default,,0,0,0,,Сонда да бәрі тыңдағанын қалаймын.➡
Dialogue: 0,0:07:02.02,0:07:05.73,Default,,0,0,0,,Жалпыға бару үшін қыздардың ойлары ➡ жиналды
Dialogue: 0,0:07:05.73,0:07:08.56,Default,,0,0,0,,Біз резонанс жасауымыз керек.➡
Dialogue: 0,0:07:08.56,0:07:11.63,Default,,0,0,0,,Ал фрагмент ➡
Dialogue: 0,0:07:11.63,0:07:14.57,Default,,0,0,0,,Шино жасаған әртүрлі кеңістікте
Dialogue: 0,0:07:14.57,0:07:17.67,Default,,0,0,0,,Ах. (Нина) Егер сіз сол сезіммен жаңғырсаңыз➡
Dialogue: 0,0:07:17.67,0:07:20.17,Default,,0,0,0,,Мен Шиноға бара алуым керек. Хмм...
Dialogue: 0,0:07:22.08,0:07:27.38,Default,,0,0,0,,Маған сену қиын деп ойлаймын. Бірақ...
Dialogue: 0,0:07:27.38,0:07:29.78,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:07:29.78,0:07:33.49,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:07:33.49,0:07:37.93,Default,,0,0,0,,Мен жасап көремін. Ха.
Dialogue: 0,0:07:37.93,0:07:42.00,Default,,0,0,0,,Рука-чан екеуміз бірге резонанс тудырдық. иә?
Dialogue: 0,0:07:42.00,0:07:44.60,Default,,0,0,0,,Иә. Кез келген жағдайда➡
Dialogue: 0,0:07:44.60,0:07:47.30,Default,,0,0,0,,Жалпыға жетудің жолын табуым керек.
Dialogue: 0,0:07:47.30,0:07:50.70,Default,,0,0,0,,Түсіндім. Өзіміз байқап көрейік.
Dialogue: 0,0:07:52.11,0:07:54.14,Default,,0,0,0,,Хехе
Dialogue: 0,0:07:54.14,0:08:12.66,Default,,0,0,0,,♬～
Dialogue: 0,0:08:12.66,0:08:16.63,Default,,0,0,0,,Кюн... (Мизуру) Ах
Dialogue: 0,0:08:16.63,0:08:18.67,Default,,0,0,0,,Мен оны сезінемін.➡
Dialogue: 0,0:08:18.67,0:08:22.80,Default,,0,0,0,,Менің ойыма жауап берген қыздардың үзінділерін көрдім.
Dialogue: 0,0:08:22.80,0:08:27.17,Default,,0,0,0,,♬～
Dialogue: 0,0:08:27.17,0:08:29.27,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:30.58,0:08:32.75,Default,,0,0,0,,Ах. Уф!
Dialogue: 0,0:08:32.75,0:08:36.25,Default,,0,0,0,,♬～
Dialogue: 0,0:08:36.25,0:08:38.42,Default,,0,0,0,,Ах! Сакурай!
Dialogue: 0,0:08:38.42,0:08:43.42,Default,,0,0,0,,♬～
Dialogue: 0,0:08:44.86,0:09:04.41,Default,,0,0,0,,♬～
Dialogue: 0,0:09:04.41,0:09:07.78,Default,,0,0,0,,Мен Йо Сакурайды қайтадан мәжбүрлеуге мәжбүр еттім деп ойлаймын.
Dialogue: 0,0:09:07.78,0:09:11.62,Default,,0,0,0,,Бұл оның 18 саны. Уф... осылай айтасың...
Dialogue: 0,0:09:11.62,0:09:15.69,Default,,0,0,0,,Иә? Әй, шамаларды дұрыс өлше, жарай ма?
Dialogue: 0,0:09:15.69,0:09:18.63,Default,,0,0,0,,Tsk! (Мияко) Эй, сен жаңа ғана тіліңді шерттің!
Dialogue: 0,0:09:18.63,0:09:21.56,Default,,0,0,0,,Бәрі жақсы! (Мияко) Иә!?
Dialogue: 0,0:09:21.56,0:09:23.66,Default,,0,0,0,,Мен саған көмектесемін. (2 адам) Иә?
Dialogue: 0,0:09:24.97,0:09:27.70,Default,,0,0,0,,Олай болса, ет алайын ба?
Dialogue: 0,0:09:27.70,0:09:30.74,Default,,0,0,0,,Иә. Тон тонна тонна...(пышақ кескен дыбыс)
Dialogue: 0,0:09:30.74,0:09:34.78,Default,,0,0,0,,♬～
Dialogue: 0,0:09:34.78,0:09:39.65,Default,,0,0,0,,Ширакаба мырза... солай ма? Иә
Dialogue: 0,0:09:39.65,0:09:42.48,Default,,0,0,0,,Мен сізден Йо Сакурай туралы сұрай аламын ба? ➡
Dialogue: 0,0:09:42.48,0:09:45.38,Default,,0,0,0,,Мектепте уақытыңызды қалай өткіздіңіз?
Dialogue: 0,0:09:47.52,0:09:51.16,Default,,0,0,0,,Мен сенің әпкең туралы ойладым.
Dialogue: 0,0:09:51.16,0:09:54.60,Default,,0,0,0,,Сакурай Йоға тек өзіне күтім жасау қиынға соғады➡
Dialogue: 0,0:09:54.60,0:09:57.60,Default,,0,0,0,,Сен де маған қамқорсың.➡
Dialogue: 0,0:09:57.60,0:10:01.57,Default,,0,0,0,,Ол өте еңбекқор, үнемі күліп жүретін.➡
Dialogue: 0,0:10:01.57,0:10:04.61,Default,,0,0,0,,Бірақ шын мәнінде мен оңай ренжітемін➡
Dialogue: 0,0:10:04.61,0:10:07.34,Default,,0,0,0,,Көбінесе мен өзімді мәжбүрлеймін.➡
Dialogue: 0,0:10:07.34,0:10:10.71,Default,,0,0,0,,Сен маған шынымен қамқорсың. Ах.
Dialogue: 0,0:10:10.71,0:10:15.32,Default,,0,0,0,,♬～
Dialogue: 0,0:10:15.32,0:10:17.35,Default,,0,0,0,,Иә.
Dialogue: 0,0:10:17.35,0:10:20.35,Default,,0,0,0,,♬～
Dialogue: 0,0:10:20.35,0:10:23.32,Default,,0,0,0,,Сіз мені ең нашар деп ойлайсыз, солай ма?
Dialogue: 0,0:10:23.32,0:10:26.99,Default,,0,0,0,,Хмм. Сіз мұны шынымен жағымсыз түрде айттыңыз.
Dialogue: 0,0:10:26.99,0:10:30.99,Default,,0,0,0,,Ол үшін әпкеңмен жарысып жатқан сияқтысың.
Dialogue: 0,0:10:33.90,0:10:35.97,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:35.97,0:10:37.97,Default,,0,0,0,,≫(Мизуру) Ханари-сан
Dialogue: 0,0:10:39.84,0:10:41.94,Default,,0,0,0,,Сакурай қалай?
Dialogue: 0,0:10:41.94,0:10:44.91,Default,,0,0,0,,Мен қазір ұйықтап жатырмын. (Миген) Иә.➡
Dialogue: 0,0:10:44.91,0:10:47.01,Default,,0,0,0,,Мен мұны сұрай аламын ба?
Dialogue: 0,0:10:48.45,0:10:51.12,Default,,0,0,0,,Бірақ үлкен апа...
Dialogue: 0,0:10:51.12,0:10:53.85,Default,,0,0,0,,Мен Ханари мырзадан сұрағым келді. Ах.
Dialogue: 0,0:10:53.85,0:10:58.96,Default,,0,0,0,,♬～
Dialogue: 0,0:10:58.96,0:11:02.93,Default,,0,0,0,,Мен Ханари мырзаның кешкі асын оның бөлмесіне кейін әкелемін.
Dialogue: 0,0:11:02.93,0:11:06.87,Default,,0,0,0,,Сондықтан мен бүгін сенің жаныңда боламын, Сакурай.
Dialogue: 0,0:11:06.87,0:11:11.21,Default,,0,0,0,,♬～
Dialogue: 0,0:11:11.21,0:11:13.97,Default,,0,0,0,,Ах
Dialogue: 0,0:11:13.97,0:11:18.81,Default,,0,0,0,,Сіз ояндыңыз ба? Сіз сәл ұзағырақ ұйықтай аласыз.
Dialogue: 0,0:11:18.81,0:11:22.15,Default,,0,0,0,,Рука-чан. Не?
Dialogue: 0,0:11:22.15,0:11:26.02,Default,,0,0,0,,Иә. Кішкентай кезімнен➡
Dialogue: 0,0:11:26.02,0:11:29.49,Default,,0,0,0,,Мен оянғанда қасында біреу болса, өзімді жеңіл сезінемін.
Dialogue: 0,0:11:29.49,0:11:31.53,Default,,0,0,0,,Кешіріңізші!
Dialogue: 0,0:11:31.53,0:11:36.50,Default,,0,0,0,,♬～
Dialogue: 0,0:11:36.50,0:11:40.10,Default,,0,0,0,,Мұны маған әпкем жасады. Оны бірге жейік.
Dialogue: 0,0:11:40.10,0:11:42.14,Default,,0,0,0,,Уау! иә!
Dialogue: 0,0:11:42.14,0:11:49.01,Default,,0,0,0,,♬～
Dialogue: 0,0:11:49.01,0:11:53.08,Default,,0,0,0,,Йо Сакурай Сіздің тамаша достарыңыз көп.
Dialogue: 0,0:11:53.08,0:11:56.12,Default,,0,0,0,,♬～
Dialogue: 0,0:11:56.12,0:11:59.32,Default,,0,0,0,,үшін Йо Сакурай➡ туралы ойлайды
Dialogue: 0,0:11:59.32,0:12:02.42,Default,,0,0,0,,Өзіңізбен дұрыс қарым-қатынас жасаңыз
Dialogue: 0,0:12:02.42,0:12:07.80,Default,,0,0,0,,Бір кезде мен мен Сакурайдың арасындағы шекара жоғалып кетті.
Dialogue: 0,0:12:07.80,0:12:11.50,Default,,0,0,0,,Йо Сакурайды өзіңіздікі сияқты ойлаңыз.
Dialogue: 0,0:12:12.83,0:12:16.74,Default,,0,0,0,,Ханари мырза айтқандай, өз бақытыңызға көңіл бөліңіз➡
Dialogue: 0,0:12:16.74,0:12:19.44,Default,,0,0,0,,Йо Сакурай сияқты бақытты шешіңіз...｡➡
Dialogue: 0,0:12:20.77,0:12:23.78,Default,,0,0,0,,Уф…｡➡
Dialogue: 0,0:12:23.78,0:12:26.81,Default,,0,0,0,,Сәлем Момо, мен➡
Dialogue: 0,0:12:26.81,0:12:29.48,Default,,0,0,0,,Мен сенің жаныңда бола аламын ба? ➡
Dialogue: 0,0:12:29.48,0:12:32.28,Default,,0,0,0,,Мен Йо Сакурай туралы ойлауды жалғастыра аламын ба?
Dialogue: 0,0:12:34.29,0:12:37.29,Default,,0,0,0,,Момо мені қорғағандай➡
Dialogue: 0,0:12:37.29,0:12:41.90,Default,,0,0,0,,Мен де біреудің сезімін қорғай аламын ба?
Dialogue: 0,0:12:41.90,0:12:47.94,Default,,0,0,0,,♬～
Dialogue: 0,0:12:47.94,0:12:50.84,Default,,0,0,0,,Жылы…｡ Ха
Dialogue: 0,0:12:54.21,0:12:56.21,Default,,0,0,0,,Ха...
Dialogue: 0,0:12:58.68,0:13:00.78,Default,,0,0,0,,Момо!
Dialogue: 0,0:13:02.18,0:13:06.09,Default,,0,0,0,,Уф... Уф!
Dialogue: 0,0:13:06.09,0:13:09.16,Default,,0,0,0,,Миген мұны істей алады. (Миген) Момо!
Dialogue: 0,0:13:09.16,0:13:15.03,Default,,0,0,0,,♬～
Dialogue: 0,0:13:15.03,0:13:17.57,Default,,0,0,0,,Ей, ояну дұрыс екеніне сенімдісің бе?
Dialogue: 0,0:13:17.57,0:13:20.60,Default,,0,0,0,,Иә. Бір түн ұйықтадым, қызуым түсіп кетті➡
Dialogue: 0,0:13:20.60,0:13:23.64,Default,,0,0,0,,Жарайды... уф... (Мияко) Шынымен, шынымен!?
Dialogue: 0,0:13:23.64,0:13:26.91,Default,,0,0,0,,Шынымен, шынымен!
Dialogue: 0,0:13:26.91,0:13:29.61,Default,,0,0,0,,А, Момо-сан... (2 адам) Иә?
Dialogue: 0,0:13:29.61,0:13:35.65,Default,,0,0,0,,♬～
Dialogue: 0,0:13:35.65,0:13:37.69,Default,,0,0,0,,Әй
Dialogue: 0,0:13:37.69,0:13:41.92,Default,,0,0,0,,♬～
Dialogue: 0,0:13:41.92,0:13:44.89,Default,,0,0,0,,...
Dialogue: 0,0:13:44.89,0:13:47.56,Default,,0,0,0,,...
Dialogue: 0,0:13:47.56,0:13:50.33,Default,,0,0,0,,...
Dialogue: 0,0:13:50.33,0:13:52.37,Default,,0,0,0,,Эрен сияқты, бронясымен және Коллоссал Титанмен
Dialogue: 0,0:13:52.37,0:13:54.97,Default,,0,0,0,,➡
Dialogue: 0,0:13:54.97,0:13:57.00,Default,,0,0,0,,➡
Dialogue: 0,0:13:57.00,0:14:00.98,Default,,0,0,0,,Анпонтан! (100) Мен уайымдадым.
Dialogue: 0,0:14:00.98,0:14:03.01,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:14:03.01,0:14:08.52,Default,,0,0,0,,♬～
Dialogue: 0,0:14:08.52,0:14:10.55,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:14:10.55,0:14:14.95,Default,,0,0,0,,♬～
Dialogue: 0,0:16:17.54,0:16:20.28,Default,,0,0,0,,Қайтадан көп нәрсе өзгерді.
Dialogue: 0,0:16:20.28,0:16:22.62,Default,,0,0,0,,Жалпы есіктің ашылуына байланысты...
Dialogue: 0,0:16:22.62,0:16:26.45,Default,,0,0,0,,Қала да, адамдар да тез өзгеруде.
Dialogue: 0,0:16:26.45,0:16:30.19,Default,,0,0,0,,Менде әлі де маңызды сәттерім бар.➡
Dialogue: 0,0:16:30.19,0:16:32.49,Default,,0,0,0,,Хехе. Момо-сан...
Dialogue: 0,0:16:32.49,0:16:35.53,Default,,0,0,0,,Және осы жағдайға байланысты➡
Dialogue: 0,0:16:35.53,0:16:39.20,Default,,0,0,0,,Мен Момо-санның сезімін қайтара алдым. (2 адам) Хехе.
Dialogue: 0,0:16:39.20,0:16:41.80,Default,,0,0,0,,Ах. Ах...
Dialogue: 0,0:16:41.80,0:16:44.41,Default,,0,0,0,,()➡
Dialogue: 0,0:16:44.41,0:16:47.01,Default,,0,0,0,,Мен оны көре алмаймын.
Dialogue: 0,0:16:49.14,0:16:51.31,Default,,0,0,0,,≪Гача ≪Аа, Нина-чан!
Dialogue: 0,0:16:51.31,0:16:54.55,Default,,0,0,0,,Уф! (100) О, ол шынымен де сонда болды.
Dialogue: 0,0:16:54.55,0:16:57.89,Default,,0,0,0,,Не!? Мен Мизурудан естігенде таң қалдым.
Dialogue: 0,0:16:57.89,0:17:00.55,Default,,0,0,0,,Сонда сен бізге өз күшіңді бердің бе?
Dialogue: 0,0:17:00.55,0:17:03.16,Default,,0,0,0,,Рахмет. Уф... шынымен емес ➡
Dialogue: 0,0:17:03.16,0:17:06.26,Default,,0,0,0,,Мен әпкеме көмектескім келді...
Dialogue: 0,0:17:06.26,0:17:08.76,Default,,0,0,0,,Өйткені Мизуру
Dialogue: 0,0:17:08.76,0:17:10.90,Default,,0,0,0,,Рахмет
Dialogue: 0,0:17:10.90,0:17:13.67,Default,,0,0,0,,Жоқ... (100) Әй, қызыл түсті!
Dialogue: 0,0:17:13.67,0:17:15.77,Default,,0,0,0,,➡
Dialogue: 0,0:17:15.77,0:17:18.67,Default,,0,0,0,,Мен саған ештеңе демеймін. Ол рұқсатсыз басымды ұстайды➡
Dialogue: 0,0:17:18.67,0:17:21.04,Default,,0,0,0,,()!?➡
Dialogue: 0,0:17:21.04,0:17:23.08,Default,,0,0,0,,()➡
Dialogue: 0,0:17:23.08,0:17:25.85,Default,,0,0,0,,«Докочу» нені білдіреді? Кіші орта мектеп?
Dialogue: 0,0:17:25.85,0:17:28.18,Default,,0,0,0,,Ей, екеуің де тоқтаңдар!
Dialogue: 0,0:17:28.18,0:17:31.19,Default,,0,0,0,,...
Dialogue: 0,0:17:31.19,0:17:34.66,Default,,0,0,0,,Хм... Уау! Бұл жігіт үнемі осылай бола ма!?
Dialogue: 0,0:17:34.66,0:17:38.09,Default,,0,0,0,,Хмм... Мүмкін қуат қосылған шығар.
Dialogue: 0,0:17:38.09,0:17:41.96,Default,,0,0,0,,Әй, өзіңді қатты итерме. Оянғаныңызға біраз уақыт болды.
Dialogue: 0,0:17:41.96,0:17:45.50,Default,,0,0,0,,Керісінше, мен тым көп ұйықтаймын және қосымша күш аламын.➡
Dialogue: 0,0:17:45.50,0:17:49.17,Default,,0,0,0,,Ендеше, ең алдымен тойып ал.
Dialogue: 0,0:17:49.17,0:18:08.86,Default,,0,0,0,,♬～
Dialogue: 0,0:18:08.86,0:18:10.86,Default,,0,0,0,,♬～
Dialogue: 0,0:18:10.86,0:18:12.86,Default,,0,0,0,,Ах
Dialogue: 0,0:18:14.36,0:18:18.03,Default,,0,0,0,,Ой. Оны қайнату ғана қалды.
Dialogue: 0,0:18:18.03,0:18:21.03,Default,,0,0,0,,Момо-сан, міне, осы. Ах.
Dialogue: 0,0:18:21.03,0:18:24.91,Default,,0,0,0,,Момо-сан, мен оны сенің үйіңнен тауып алып, рұқсатсыз саған әкелдім.
Dialogue: 0,0:18:24.91,0:18:27.57,Default,,0,0,0,,Рука-чан, мен оны күнде араластыруым керек.
Dialogue: 0,0:18:27.57,0:18:30.14,Default,,0,0,0,,Сіз тіпті оған ат қойдыңыз. «Нука-сан»?
Dialogue: 0,0:18:30.14,0:18:32.25,Default,,0,0,0,,Міне. Хмм!
Dialogue: 0,0:18:32.25,0:18:34.65,Default,,0,0,0,,Ах...｡ Момо
Dialogue: 0,0:18:34.65,0:18:38.39,Default,,0,0,0,,Бұл маған әжемнен қалған нәрсе.➡
Dialogue: 0,0:18:38.39,0:18:42.56,Default,,0,0,0,,Жаман болса, бітті.
Dialogue: 0,0:18:42.56,0:18:45.16,Default,,0,0,0,,Рахмет. Мен сондай қуаныштымын.
Dialogue: 0,0:18:45.16,0:18:54.17,Default,,0,0,0,,♬～
Dialogue: 0,0:18:54.17,0:18:57.50,Default,,0,0,0,,Жарай ма? Әпкеңмен емес
Dialogue: 0,0:18:57.50,0:19:00.34,Default,,0,0,0,,Иә. Біз бұл туралы бұрын айтқанбыз, солай ма?
Dialogue: 0,0:19:00.34,0:19:04.04,Default,,0,0,0,,Әпкем басқа әлем туралы білгенімді қалайды➡
Dialogue: 0,0:19:04.04,0:19:06.41,Default,,0,0,0,,Сіз осылай айттыңыз. Иә.
Dialogue: 0,0:19:06.41,0:19:08.58,Default,,0,0,0,,Бүгінгі әпкемізді көріп жүрген кезім➡
Dialogue: 0,0:19:08.58,0:19:12.02,Default,,0,0,0,,Мен бұл сезімді аздап түсінемін.
Dialogue: 0,0:19:12.02,0:19:16.86,Default,,0,0,0,,Момо-санның әпкесі мен танымайтын әпке➡
Dialogue: 0,0:19:16.86,0:19:21.93,Default,,0,0,0,,Мен өзімді қытықтаймын және аздап жалғыз сезінемін.
Dialogue: 0,0:19:21.93,0:19:25.77,Default,,0,0,0,,Бірақ мен бақыттырақ болдым.
Dialogue: 0,0:19:25.77,0:19:27.80,Default,,0,0,0,,Бұдан былай апаңның күлкісін көбірек көремін➡
Dialogue: 0,0:19:27.80,0:19:30.60,Default,,0,0,0,,Бұл қызықтырақ
Dialogue: 0,0:19:30.60,0:19:35.71,Default,,0,0,0,,Мен туралы әпкең де солай ойлағанына сенімдімін.
Dialogue: 0,0:19:35.71,0:19:40.35,Default,,0,0,0,,Жарайды... жастық төбелесейік! иә?
Dialogue: 0,0:19:40.35,0:19:44.28,Default,,0,0,0,,Мен Йо Сакураймен көбірек көңіл көтергім келеді...
Dialogue: 0,0:19:44.28,0:19:47.35,Default,,0,0,0,,Уау! жақсы! Нина-чан да?
Dialogue: 0,0:19:47.35,0:19:51.43,Default,,0,0,0,,Эй, Нина Чан! (Нина) Цк!
Dialogue: 0,0:19:51.43,0:19:53.73,Default,,0,0,0,,Нина-чан... Буха!
Dialogue: 0,0:19:53.73,0:19:56.56,Default,,0,0,0,,≪Сіз мұны жасадыңыз! ≪(Нина) Хмм... бұл!
Dialogue: 0,0:19:56.56,0:19:59.60,Default,,0,0,0,,≪Уфуфу! Хмм, эй! (Токио) Хехе
Dialogue: 0,0:19:59.60,0:20:02.74,Default,,0,0,0,,[TEL] (Рационалды) Бұл өте шулы. Шынымен.
Dialogue: 0,0:20:02.74,0:20:06.24,Default,,0,0,0,,Момо-сан оянғаннан бері әр күні шулы болды.
Dialogue: 0,0:20:06.24,0:20:09.78,Default,,0,0,0,,Бұл туралы не деуге болады? (Рационалды) Бұл жойқын.➡
Dialogue: 0,0:20:09.78,0:20:14.75,Default,,0,0,0,,Ойлар жасына, жынысына қарамастан бірдей жоғалады.➡
Dialogue: 0,0:20:14.75,0:20:17.55,Default,,0,0,0,,Енді AASA➡ арқылы жылжытуға болады
Dialogue: 0,0:20:17.55,0:20:21.49,Default,,0,0,0,,Мен және рефлекторға үміткер қатал жүрек➡
Dialogue: 0,0:20:21.49,0:20:24.83,Default,,0,0,0,,Екеуміз ғана. Мен түсінемін.
Dialogue: 0,0:20:24.83,0:20:28.90,Default,,0,0,0,,Біз Мидзусаки Шиноны тоқтату үшін Common-ға барамыз.
Dialogue: 0,0:20:28.90,0:20:31.20,Default,,0,0,0,,Мен бұл балалардың қолынан келетініне сенімдімін.
Dialogue: 0,0:20:33.83,0:20:36.84,Default,,0,0,0,,Ах. Сіз мұны міндетті түрде жасайсыз.
Dialogue: 0,0:20:36.84,0:20:39.47,Default,,0,0,0,,≪Юри-чанның досы ма? (Рационалды) Иә?
Dialogue: 0,0:20:39.47,0:20:44.54,Default,,0,0,0,,♬～
Dialogue: 0,0:20:44.54,0:20:46.58,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:20:46.58,0:20:50.35,Default,,0,0,0,,♬～
Dialogue: 0,0:20:50.35,0:20:53.35,Default,,0,0,0,,≫А? Бұл біртүрлі. (Рё Каэде) Иә?
Dialogue: 0,0:20:53.35,0:20:56.42,Default,,0,0,0,,≫(100) Бұл дұрыс емес. Мынадай. ≫Ой!
Dialogue: 0,0:20:56.42,0:20:59.06,Default,,0,0,0,,≫Момо-сан, бұл керемет! Райо Каэде!
Dialogue: 0,0:20:59.06,0:21:01.96,Default,,0,0,0,,Қайтадан қош келдіңіз. Мен үйдемін, Кожика-чан.
Dialogue: 0,0:21:05.23,0:21:08.50,Default,,0,0,0,,Түсіндім, ол сенің ағаң ба?
Dialogue: 0,0:21:08.50,0:21:11.57,Default,,0,0,0,,Иә. Момо-сан бізге айтты➡
Dialogue: 0,0:21:11.57,0:21:15.94,Default,,0,0,0,,Ол маған шағылыстырғыштар және басқа да нәрселер туралы көп нәрсені үйретті.
Dialogue: 0,0:21:15.94,0:21:18.78,Default,,0,0,0,,Ақжелкен?
Dialogue: 0,0:21:18.78,0:21:21.85,Default,,0,0,0,,Момо-сан да ойдан тайды.
Dialogue: 0,0:21:21.85,0:21:23.85,Default,,0,0,0,,Осылайша мен барлық уақытта ұйықтадым
Dialogue: 0,0:21:25.62,0:21:27.72,Default,,0,0,0,,Сіз ойыңызды қайтардыңыз ба?
Dialogue: 0,0:21:31.46,0:21:33.63,Default,,0,0,0,,Ах
Dialogue: 0,0:21:33.63,0:21:35.73,Default,,0,0,0,,Райо Каэде…
Dialogue: 0,0:21:38.03,0:21:40.10,Default,,0,0,0,,Қосымша кір... ah
Dialogue: 0,0:21:40.10,0:21:43.40,Default,,0,0,0,,Рио Каэде-сан, мен сезімсіз болып тұрмын...
Dialogue: 0,0:21:45.07,0:21:47.71,Default,,0,0,0,,Мазалағаным үшін кешіріңіз.➡
Dialogue: 0,0:21:47.71,0:21:50.68,Default,,0,0,0,,Момо-сан➡ туралы сұрасаңыз
Dialogue: 0,0:21:50.68,0:21:53.75,Default,,0,0,0,,Сезіміңді қайтаруға болады...➡
Dialogue: 0,0:21:53.75,0:21:57.25,Default,,0,0,0,,Мен Амирумен қайта сөйлесуге болатынын естідім.
Dialogue: 0,0:21:59.25,0:22:01.29,Default,,0,0,0,,Тачибана мырза
Dialogue: 0,0:22:01.29,0:22:05.83,Default,,0,0,0,,Оны сіздің ойларыңыз құтқарды.➡
Dialogue: 0,0:22:05.83,0:22:09.33,Default,,0,0,0,,Мен де істей аламын ба? (Мизуру) Иә.➡
Dialogue: 0,0:22:09.33,0:22:12.53,Default,,0,0,0,,Егер сіз мұны қаласаңыз, сөзсіз.
Dialogue: 0,0:22:14.90,0:22:18.94,Default,,0,0,0,,♬～
Dialogue: 0,0:22:18.94,0:22:20.94,Default,,0,0,0,,Мизуру?
Dialogue: 0,0:22:22.71,0:22:25.28,Default,,0,0,0,,Ол «Fool» картасының белгісін арқалаған Стэнді қолданушы
Dialogue: 0,0:22:25.28,0:22:28.22,Default,,0,0,0,,Неліктен бұл жара...
Dialogue: 0,0:22:28.22,0:22:30.55,Default,,0,0,0,,Мен бұны жойғым келмейді.➡
Dialogue: 0,0:22:30.55,0:22:34.42,Default,,0,0,0,,Өшіруге болмайтын жара. Не айтқың келеді?
Dialogue: 0,0:22:34.42,0:22:37.42,Default,,0,0,0,,Өйткені бұл менің күнәмнің дәлелі.
Dialogue: 0,0:22:38.79,0:22:41.83,Default,,0,0,0,,Мен көп адамды ренжіттім.➡
Dialogue: 0,0:22:41.83,0:22:47.13,Default,,0,0,0,,Менің ойымды ұрлаған адам да, айналасындағы адамдар да.➡
Dialogue: 0,0:22:47.13,0:22:52.51,Default,,0,0,0,,Сол адамдардың көрген азабы мен жарасы ешқашан кетпейді.➡
Dialogue: 0,0:22:52.51,0:22:55.38,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:22:55.38,0:22:58.98,Default,,0,0,0,,Бұл жағдайда мен де Мизурудың дәлелі боламын.
Dialogue: 0,0:23:00.45,0:23:02.55,Default,,0,0,0,,Мизуру маған қайтарған сезімдер
Dialogue: 0,0:23:02.55,0:23:05.45,Default,,0,0,0,,Га. Момо...
Dialogue: 0,0:23:07.42,0:23:11.73,Default,,0,0,0,,Эй, енді не істегің келеді, Мизуру?
Dialogue: 0,0:23:11.73,0:23:14.36,Default,,0,0,0,,Мен Мизурудың ойын білгім келеді
Dialogue: 0,0:23:14.36,0:23:17.23,Default,,0,0,0,,Хмм…｡ Мен…
Dialogue: 0,0:23:17.23,0:23:20.30,Default,,0,0,0,,♬～
Dialogue: 0,0:23:20.30,0:23:22.67,Default,,0,0,0,,Мен Шиноға көмектескім келеді
Dialogue: 0,0:23:22.67,0:23:24.81,Default,,0,0,0,,Әй, әпке
Dialogue: 0,0:23:24.81,0:23:27.97,Default,,0,0,0,,Мен көп қателік жібердім.➡
Dialogue: 0,0:23:27.97,0:23:31.71,Default,,0,0,0,,Мен әрқашан Рефлектор ешкімді құтқара алмайды деп ойладым.
Dialogue: 0,0:23:31.71,0:23:35.75,Default,,0,0,0,,Бірақ... сендер маған үйреттіңдер.
Dialogue: 0,0:23:35.75,0:23:37.78,Default,,0,0,0,,Ах
Dialogue: 0,0:23:37.78,0:23:40.22,Default,,0,0,0,,Көптеген қыздармен таныстым➡
Dialogue: 0,0:23:40.22,0:23:43.06,Default,,0,0,0,,Міне, мен алған ойлар.➡
Dialogue: 0,0:23:43.06,0:23:45.36,Default,,0,0,0,,Фрагментті сақтау соңы емес.➡
Dialogue: 0,0:23:45.36,0:23:48.96,Default,,0,0,0,,Осыдан кейін мен істей алатын бірдеңе болуы керек.
Dialogue: 0,0:23:51.43,0:23:53.93,Default,,0,0,0,,Мен Мизуру сияқты сезінемін.
Dialogue: 0,0:23:53.93,0:23:57.60,Default,,0,0,0,,Мен де маған күш беруіңізді сұраймын.
Dialogue: 0,0:23:57.60,0:23:59.71,Default,,0,0,0,,Момо-сан...
Dialogue: 0,0:23:59.71,0:24:02.14,Default,,0,0,0,,Кешіріңіз! (2 адам) Иә?
Dialogue: 0,0:24:02.14,0:24:05.58,Default,,0,0,0,,Тек оны кимеңіз! Міне бітті!
Dialogue: 0,0:24:05.58,0:24:07.61,Default,,0,0,0,,Бұл жақсы емес дегенді білдіре ме?
Dialogue: 0,0:24:07.61,0:24:10.15,Default,,0,0,0,,Жоқ! (Мияко) Шынымен де...
Dialogue: 0,0:24:10.15,0:24:12.79,Default,,0,0,0,,Хехе. Бұл...➡
Dialogue: 0,0:24:12.79,0:24:15.89,Default,,0,0,0,,Әпкең маған қарсы тұруға тырысса да➡
Dialogue: 0,0:24:15.89,0:24:18.43,Default,,0,0,0,,Себебі мен біртүрлі біреуге соқтығыстым...
Dialogue: 0,0:24:18.43,0:24:21.13,Default,,0,0,0,,Мен де. Екеуміз де...
Dialogue: 0,0:24:21.13,0:24:23.80,Default,,0,0,0,,Мен, әрине, әпкеңізбен келісемін.
Dialogue: 0,0:24:23.80,0:24:26.70,Default,,0,0,0,,Сол Янки әйелінің алдында
Dialogue: 0,0:24:26.70,0:24:29.04,Default,,0,0,0,,Маған да ынтымақтасуға рұқсат бере аласыз ба?
Dialogue: 0,0:24:29.04,0:24:31.97,Default,,0,0,0,,үшін... (100) Йо Сакурай ше?
Dialogue: 0,0:24:31.97,0:24:35.58,Default,,0,0,0,,Оған жоғары баға қояды!
Dialogue: 0,0:24:35.58,0:24:40.48,Default,,0,0,0,,Мен әркімнің сезімін қорғағым келгендіктен рефлектор болдым.
Dialogue: 0,0:24:42.15,0:24:44.92,Default,,0,0,0,,Мен де сенің әпкең сияқты сезінемін.
Dialogue: 0,0:24:44.92,0:24:48.26,Default,,0,0,0,,Йо Сакурай...｡ Иә
Dialogue: 0,0:24:48.26,0:24:50.96,Default,,0,0,0,,Рахмет
Dialogue: 0,0:24:50.96,0:24:55.66,Default,,0,0,0,,Егер біз қазір болсак, біз өз ойымызбен резонанс жасай аламыз.
Dialogue: 0,0:24:55.66,0:24:59.03,Default,,0,0,0,,Дұрыс. Мен барлығының ойымен осындамын➡
Dialogue: 0,0:24:59.03,0:25:01.77,Default,,0,0,0,,Мен Жалпыға барғым келеді. (Мизуру) үшінның ойы?
Dialogue: 0,0:25:01.77,0:25:05.24,Default,,0,0,0,,Керемет емес пе? (Мияко) Бұл бұрын-соңды болмаған резонанс.
Dialogue: 0,0:25:05.24,0:25:07.71,Default,,0,0,0,,Табысты болу үшін➡
Dialogue: 0,0:25:07.71,0:25:10.84,Default,,0,0,0,,үшін бір бөлмеде ұйықтай ма? Онда ма?
Dialogue: 0,0:25:10.84,0:25:13.75,Default,,0,0,0,,Негізгі идея - бірге тамақтану және бірге ұйықтау.
Dialogue: 0,0:25:13.75,0:25:16.15,Default,,0,0,0,,Менің ойым ескірген.
Dialogue: 0,0:25:16.15,0:25:18.55,Default,,0,0,0,,Шоу дәуірі? (100) О!?
Dialogue: 0,0:25:18.55,0:25:27.46,Default,,0,0,0,,♬～
Dialogue: 0,0:25:27.46,0:25:32.17,Default,,0,0,0,,Зазазазазаза...(аяқ дыбысы)
Dialogue: 0,0:25:32.17,0:25:36.94,Default,,0,0,0,,Керемет таңқаларлық! Бұл керемет, Шино-тан! ➡
Dialogue: 0,0:25:36.94,0:25:40.34,Default,,0,0,0,,Бұл сіз қалаған әлем.➡
Dialogue: 0,0:25:40.34,0:25:44.41,Default,,0,0,0,,Иә. Мен не істеу керектігін білемін.
Dialogue: 0,0:25:44.41,0:25:48.01,Default,,0,0,0,,♬～
Dialogue: 0,0:25:48.01,0:25:50.65,Default,,0,0,0,,Жиренішті ойлар үшін➡
Dialogue: 0,0:25:50.65,0:25:53.02,Default,,0,0,0,,Мәңгілік қоштасу
Dialogue: 0,0:25:53.02,0:25:59.52,Default,,0,0,0,,♬～
Dialogue: 0,0:26:00.86,0:26:19.91,Default,,0,0,0,,♬～
Dialogue: 0,0:26:19.91,0:26:34.23,Default,,0,0,0,,♬～
Dialogue: 0,0:26:34.23,0:26:41.77,Default,,0,0,0,,♬～
Dialogue: 0,0:26:41.77,0:26:54.85,Default,,0,0,0,,♬～
Dialogue: 0,0:26:54.85,0:27:10.90,Default,,0,0,0,,♬～
Dialogue: 0,0:27:10.90,0:27:15.40,Default,,0,0,0,,♬～
Dialogue: 0,0:27:15.40,0:27:29.90,Default,,0,0,0,,♬～
Dialogue: 0,0:29:02.94,0:29:05.48,Default,,0,0,0,,Сіз маңызды анықтама әкелдіңіз.
Dialogue: 0,0:29:05.48,0:29:09.35,Default,,0,0,0,,Сонда мына бала... (100) Оның мұндай болуы мүмкін емес пе?
Dialogue: 0,0:29:09.35,0:29:12.85,Default,,0,0,0,,Сонымен, сіз Шиноның өткенін көрдіңіз бе? (Мизуру) Шиноның ойлары
Dialogue: 0,0:29:12.85,0:29:14.95,Default,,0,0,0,,Өткен шақ қандай?
Dialogue: 0,0:29:16.45,0:29:22.45,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
