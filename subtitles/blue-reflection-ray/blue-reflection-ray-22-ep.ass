Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:34.69,0:01:36.69,Default,,0,0,0,,♬～
Dialogue: 0,0:01:36.69,0:01:39.19,Default,,0,0,0,,≪Мен қайда барғым келеді? ➡
Dialogue: 0,0:01:40.69,0:01:43.70,Default,,0,0,0,,Мен кімді іздеймін? ≫
Dialogue: 0,0:01:43.70,0:01:46.73,Default,,0,0,0,,♬～
Dialogue: 0,0:01:46.73,0:01:49.64,Default,,0,0,0,,[TEL] (Рука Ханари) Сент-Инес академиясы? ➡
Dialogue: 0,0:01:49.64,0:01:52.24,Default,,0,0,0,,Неліктен мұндай жерде жүрсің?
Dialogue: 0,0:01:52.24,0:01:54.27,Default,,0,0,0,,Мен есіме түсіргім келді
Dialogue: 0,0:01:54.27,0:01:57.41,Default,,0,0,0,,♬～
Dialogue: 0,0:01:57.41,0:02:02.88,Default,,0,0,0,,Біз туралы...Шино-чан
Dialogue: 0,0:02:02.88,0:02:06.35,Default,,0,0,0,,((Ойлар адам кейпіне енген➡
Dialogue: 0,0:02:06.35,0:02:08.72,Default,,0,0,0,,Қорқынышты заттар.➡
Dialogue: 0,0:02:08.72,0:02:11.46,Default,,0,0,0,,Қош болыңыздар ханымдар.➡
Dialogue: 0,0:02:11.46,0:02:15.13,Default,,0,0,0,,Ақыры ақымақ ойларыммен қоштастым➡
Dialogue: 0,0:02:15.13,0:02:17.13,Default,,0,0,0,,Мен бақыттымын))
Dialogue: 0,0:02:22.57,0:02:24.57,Default,,0,0,0,,≪Casa Ah
Dialogue: 0,0:02:25.97,0:02:28.14,Default,,0,0,0,,Ах... [ТЕЛ] Не болды?
Dialogue: 0,0:02:28.14,0:02:30.14,Default,,0,0,0,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,0:02:35.75,0:02:37.85,Default,,0,0,0,,Сәлем
Dialogue: 0,0:02:39.82,0:02:43.76,Default,,0,0,0,,А, сен менің даусыма жауап бердің. [TEL] Иә?
Dialogue: 0,0:02:43.76,0:02:46.73,Default,,0,0,0,,Бұл бала, менің сезімім қалады
Dialogue: 0,0:02:46.73,0:02:50.30,Default,,0,0,0,,Сіздің қызыңыз бар ма? [TEL] Қыз?
Dialogue: 0,0:02:50.30,0:02:54.30,Default,,0,0,0,,Мұндай жерде не болып жатыр? Сіз адасып қалдыңыз ба?
Dialogue: 0,0:02:56.04,0:02:58.54,Default,,0,0,0,,Әкең мен анаң ше?
Dialogue: 0,0:03:00.97,0:03:05.38,Default,,0,0,0,,Хехе, менімен барғың келе ме? Эй?
Dialogue: 0,0:03:05.38,0:03:09.35,Default,,0,0,0,,♬～
Dialogue: 0,0:03:09.35,0:03:11.35,Default,,0,0,0,,Ах
Dialogue: 0,0:03:13.95,0:03:16.12,Default,,0,0,0,,Ха...
Dialogue: 0,0:03:16.12,0:03:19.72,Default,,0,0,0,,[TEL] Сакурайсыз ба? не болды? Сакурай!
Dialogue: 0,0:03:21.73,0:03:41.68,Default,,0,0,0,,♬～
Dialogue: 0,0:03:41.68,0:04:00.13,Default,,0,0,0,,♬～
Dialogue: 0,0:04:00.13,0:04:03.54,Default,,0,0,0,,♬～
Dialogue: 0,0:04:03.54,0:04:22.62,Default,,0,0,0,,♬～
Dialogue: 0,0:04:22.62,0:04:34.42,Default,,0,0,0,,♬～
Dialogue: 0,0:04:35.87,0:04:39.37,Default,,0,0,0,,♬～
Dialogue: 0,0:04:39.37,0:04:50.67,Default,,0,0,0,,♬～
Dialogue: 0,0:04:53.85,0:04:56.32,Default,,0,0,0,,Ха...
Dialogue: 0,0:04:56.32,0:05:00.13,Default,,0,0,0,,Кешіріңіз, мен... Рука-чан, жақсысыз ба?
Dialogue: 0,0:05:00.13,0:05:02.49,Default,,0,0,0,,Бөлмеңізде демаласыз ба?
Dialogue: 0,0:05:02.49,0:05:05.09,Default,,0,0,0,,Сіз осында болыңыз. Ол...➡
Dialogue: 0,0:05:06.50,0:05:09.44,Default,,0,0,0,,Мен не айтарымды білмеймін➡
Dialogue: 0,0:05:09.44,0:05:12.97,Default,,0,0,0,,Қалай болғанда да, бұл сіз өзіңізбен бірге алып келген маңызды анықтама.➡
Dialogue: 0,0:05:12.97,0:05:15.37,Default,,0,0,0,,Жүр, кеттік, Фаун-чан.
Dialogue: 0,0:05:18.01,0:05:20.98,Default,,0,0,0,,Ондай нәрсе болуы мүмкін емес пе?
Dialogue: 0,0:05:20.98,0:05:24.52,Default,,0,0,0,,Маған соншалықты жиіркенішті жамандық көрсеттің.
Dialogue: 0,0:05:24.52,0:05:26.55,Default,,0,0,0,,Сәлем! (100) Иә?
Dialogue: 0,0:05:26.55,0:05:29.42,Default,,0,0,0,,Рефлекторлар арқылы бір-біріңізге олай жанашырлық танытпаңыз➡
Dialogue: 0,0:05:29.42,0:05:31.99,Default,,0,0,0,,Маған да түсіндіре аласыз ба? ➡
Dialogue: 0,0:05:31.99,0:05:34.63,Default,,0,0,0,,Анықтама дегеніміз не? Өзіңізді ауырып тұрсыз ба? ➡
Dialogue: 0,0:05:34.63,0:05:37.23,Default,,0,0,0,,Мынау не бала?
Dialogue: 0,0:05:37.23,0:05:39.27,Default,,0,0,0,,Шино. Ах.
Dialogue: 0,0:05:39.27,0:05:42.27,Default,,0,0,0,,Не? (Мизуру) Бұл қыз Шино.➡
Dialogue: 0,0:05:42.27,0:05:45.54,Default,,0,0,0,,Дәлірек айтсақ, оның үзіндісі.➡
Dialogue: 0,0:05:45.54,0:05:49.44,Default,,0,0,0,,Өздігінен қирап, жерленген➡
Dialogue: 0,0:05:49.44,0:05:52.21,Default,,0,0,0,,Шиноның өз ойлары
Dialogue: 0,0:05:52.21,0:05:57.08,Default,,0,0,0,,А... у... мен не айтып тұрғаныңызды түсінбеймін.
Dialogue: 0,0:05:57.08,0:06:00.75,Default,,0,0,0,,Менің ойымша. (Токио) Бұның еш зияны жоқ! ➡
Dialogue: 0,0:06:00.75,0:06:02.79,Default,,0,0,0,,Бұл нені білдіреді? Мизуру-сан｡➡
Dialogue: 0,0:06:02.79,0:06:06.39,Default,,0,0,0,,Фрагменттің өзі қандай? (Мизуру) Енді бұл әлем➡
Dialogue: 0,0:06:06.39,0:06:09.90,Default,,0,0,0,,Шындық пен ортақтық аралас күйде болады
Dialogue: 0,0:06:09.90,0:06:13.77,Default,,0,0,0,,Адамдар есінен танып, барған сайын депрессияға ұшырайды.
Dialogue: 0,0:06:13.77,0:06:18.67,Default,,0,0,0,,Екінші жағынан, жоғалған сезімдер қандай да бір формада болуы мүмкін.
Dialogue: 0,0:06:18.67,0:06:21.21,Default,,0,0,0,,А, онда мына бала...
Dialogue: 0,0:06:21.21,0:06:25.21,Default,,0,0,0,,Адам емес. Шиноның естеліктері мен өшпенділігі➡
Dialogue: 0,0:06:25.21,0:06:29.78,Default,,0,0,0,,Адам кейпіндегі ашу мен мұң.
Dialogue: 0,0:06:29.78,0:06:31.85,Default,,0,0,0,,Сонымен, сіз Шиноның өткенін көрдіңіз бе? ➡
Dialogue: 0,0:06:31.85,0:06:35.12,Default,,0,0,0,,Өткен шақ қандай? Хмм...
Dialogue: 0,0:06:35.12,0:06:37.16,Default,,0,0,0,,Ах
Dialogue: 0,0:06:37.16,0:06:44.60,Default,,0,0,0,,♬～
Dialogue: 0,0:06:44.60,0:06:48.00,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:06:48.00,0:06:52.00,Default,,0,0,0,,)
Dialogue: 0,0:06:52.00,0:06:54.57,Default,,0,0,0,,)
Dialogue: 0,0:06:54.57,0:06:57.91,Default,,0,0,0,,) (Модератор)((Әлсіздер ше?))
Dialogue: 0,0:06:57.91,0:07:01.45,Default,,0,0,0,,((Мен әлеуметтік жағынан әлсізмін. Болашақ әлсіздермен ➡
Dialogue: 0,0:07:01.45,0:07:05.55,Default,,0,0,0,,Оны ойлаған екіжүзділер құртты))
Dialogue: 0,0:07:05.55,0:07:10.09,Default,,0,0,0,,)
Dialogue: 0,0:07:10.09,0:07:12.73,Default,,0,0,0,,Мен көремін. Қалай болғанда да➡
Dialogue: 0,0:07:12.73,0:07:16.36,Default,,0,0,0,,Бұл өте радикалды идея)) (([TV] (Шино) Солай ма?➡
Dialogue: 0,0:07:16.36,0:07:21.10,Default,,0,0,0,,Мен бүкіл адамзаттың жүрегінің түкпірінде жасыратын сезіммін➡
Dialogue: 0,0:07:21.10,0:07:23.20,Default,,0,0,0,,Бұл жай ғана дауыс.➡
Dialogue: 0,0:07:23.20,0:07:27.04,Default,,0,0,0,,Ал бұл ой емес.➡
Dialogue: 0,0:07:27.04,0:07:29.34,Default,,0,0,0,,Шындық))
Dialogue: 0,0:07:29.34,0:07:32.38,Default,,0,0,0,,((Сен бүгін жақсы орындадың, Шино-чан.➡
Dialogue: 0,0:07:32.38,0:07:35.35,Default,,0,0,0,,Ананың айтқанын орындадың.➡
Dialogue: 0,0:07:35.35,0:07:40.45,Default,,0,0,0,,Шаршаған шығарсың, келесі лекцияны тоқтатамын.➡
Dialogue: 0,0:07:40.45,0:07:43.22,Default,,0,0,0,,Оның орнына Каноға сәлем айтыңыз))
Dialogue: 0,0:07:43.22,0:07:46.26,Default,,0,0,0,,() (Шиноның анасы)((Атың кім?))
Dialogue: 0,0:07:46.26,0:07:48.29,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:07:48.29,0:07:50.23,Default,,0,0,0,,((Тоқтаңыз)) ((Шықылдаңыз!))
Dialogue: 0,0:07:50.23,0:07:52.26,Default,,0,0,0,,)) ((≫баш! баш! (түрту дыбысы))))
Dialogue: 0,0:07:52.26,0:07:56.20,Default,,0,0,0,,Жарайсың ба? Сен Шиносың. Мизусаки Шино.➡
Dialogue: 0,0:07:56.20,0:07:58.94,Default,,0,0,0,,≫“Кано” – дифференциацияның аты ғана.➡
Dialogue: 0,0:07:58.94,0:08:02.37,Default,,0,0,0,,≫Шино әрқашан және барлық жерде сыртта.➡
Dialogue: 0,0:08:02.37,0:08:06.11,Default,,0,0,0,,≫Иә Сіздің атыңыз кім? )) ((≫(Кано) Шино Мизусаки…))
Dialogue: 0,0:08:06.11,0:08:09.01,Default,,0,0,0,,)) ((≫(Шиноның анасы) Жарайсың))
Dialogue: 0,0:08:10.55,0:08:14.62,Default,,0,0,0,,((Жарайды? Шино-чан. Бұл да саған.➡
Dialogue: 0,0:08:14.62,0:08:17.36,Default,,0,0,0,,Түсіндіңіз бе? )) (Шино)((Иә...))
Dialogue: 0,0:08:17.36,0:08:23.16,Default,,0,0,0,,♬～
Dialogue: 0,0:08:23.16,0:08:26.93,Default,,0,0,0,,((Әлсізді болашақта құрбан ету керек))
Dialogue: 0,0:08:26.93,0:08:31.00,Default,,0,0,0,,(«Әлсізді болашақта құрбан ету керек»))
Dialogue: 0,0:08:31.00,0:08:33.27,Default,,0,0,0,,((қарттар, ауру адамдар➡
Dialogue: 0,0:08:33.27,0:08:35.57,Default,,0,0,0,,Кедей, надан))
Dialogue: 0,0:08:35.57,0:08:38.21,Default,,0,0,0,,((`` Қарттар, ауру адамдар ➡
Dialogue: 0,0:08:38.21,0:08:41.51,Default,,0,0,0,,Кедей, надан»))
Dialogue: 0,0:08:41.51,0:08:44.48,Default,,0,0,0,,((Бұл тек зиянды))
Dialogue: 0,0:08:44.48,0:08:46.52,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:08:46.52,0:08:49.99,Default,,0,0,0,,(("Жоқ")) (Шино)(("Жоқ"... Ах. Ах...))
Dialogue: 0,0:08:49.99,0:08:52.02,Default,,0,0,0,,) ((дүрілдеген дыбыс)))
Dialogue: 0,0:08:52.02,0:08:55.93,Default,,0,0,0,,((Хмм~ Бұл енді жақсы емес, Шино-чан.➡
Dialogue: 0,0:08:55.93,0:08:59.50,Default,,0,0,0,,Қателік жасасаң, апаңның басы осылай болады.➡
Dialogue: 0,0:08:59.50,0:09:02.97,Default,,0,0,0,,Түсіндіңіз бе? )) (Шино)((Иә...))
Dialogue: 0,0:09:02.97,0:09:05.14,Default,,0,0,0,,)
Dialogue: 0,0:09:05.14,0:09:07.91,Default,,0,0,0,,((Сәлеметсіз бе? О, сіз｡➡
Dialogue: 0,0:09:07.91,0:09:11.38,Default,,0,0,0,,Иә. Иә... Иә!?➡
Dialogue: 0,0:09:11.38,0:09:13.51,Default,,0,0,0,,Неліктен мен префектуралық ассамблеяның мүшесі болдым?
Dialogue: 0,0:09:13.51,0:09:15.75,Default,,0,0,0,,Мен сен маған оқиғаны айтып берді деп ойладым! ➡
Dialogue: 0,0:09:15.75,0:09:20.25,Default,,0,0,0,,Маған қаражат керек. Қорлар. Түсінді ме? Ақымақ! ))
Dialogue: 0,0:09:22.49,0:09:26.36,Default,,0,0,0,,((Жақсысың ба? Они-чан)) (Кано)((Жақсы.｡➡)
Dialogue: 0,0:09:26.36,0:09:30.30,Default,,0,0,0,,Мен сенің азабыңмын)) (Шино)()
Dialogue: 0,0:09:30.30,0:09:34.30,Default,,0,0,0,,((Сен құтқарушысың. Мен шейітпін.➡
Dialogue: 0,0:09:34.30,0:09:38.24,Default,,0,0,0,,Екі адам бір болғанда ғана керемет болады.➡
Dialogue: 0,0:09:38.24,0:09:41.57,Default,,0,0,0,,Ауырғаным табиғи нәрсе))
Dialogue: 0,0:09:41.57,0:09:44.08,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:09:44.08,0:09:46.75,Default,,0,0,0,,((Шындық)) (Шино)((Бірақ➡
Dialogue: 0,0:09:46.75,0:09:51.48,Default,,0,0,0,,Сонымен, маған не болды? Қайғылы ма? Ауырды ма? ))
Dialogue: 0,0:09:51.48,0:09:54.95,Default,,0,0,0,,((Бұл сенің ішіңдегі әлсіз, Шино.➡
Dialogue: 0,0:09:54.95,0:09:56.95,Default,,0,0,0,,Алынып тасталсын))
Dialogue: 0,0:09:58.52,0:10:00.62,Default,,0,0,0,,()
Dialogue: 0,0:10:02.93,0:10:06.60,Default,,0,0,0,,((Біз бұл дүниеден зұлымдықты тазартуымыз керек.➡
Dialogue: 0,0:10:06.60,0:10:09.27,Default,,0,0,0,,Жамандық... яғни әлсіздер.➡
Dialogue: 0,0:10:09.27,0:10:14.61,Default,,0,0,0,,Қарт, ауру, кедей, надан.➡
Dialogue: 0,0:10:14.61,0:10:19.51,Default,,0,0,0,,Олар болашақты құртады. Елестетіп көріңізші➡
Dialogue: 0,0:10:19.51,0:10:24.22,Default,,0,0,0,,Бұл заттар жойылатын болашақ. Сіздің қасіретіңіз сонда➡
Dialogue: 0,0:10:24.22,0:10:27.75,Default,,0,0,0,,Ешқандай мұң немесе азап жоқ))
Dialogue: 0,0:10:27.75,0:10:30.52,Default,,0,0,0,,Бұл мәселе! )) (Кано)()
Dialogue: 0,0:10:30.52,0:10:34.43,Default,,0,0,0,,((Аурусыз дүние қызықсыз, Некунан-сама.➡
Dialogue: 0,0:10:34.43,0:10:37.43,Default,,0,0,0,,Себебі ауырсыну жақсы сезінеді))
Dialogue: 0,0:10:37.43,0:10:40.90,Default,,0,0,0,,((Ах...)) (Поэзия)((Ауырып – бар болу))
Dialogue: 0,0:10:40.90,0:10:45.04,Default,,0,0,0,,((Таза өзін-өзі ақтамай. Сіз ойламайсыз ба?➡
Dialogue: 0,0:10:45.04,0:10:47.54,Default,,0,0,0,,Некунан-сама)) (Кано)((Ах...))
