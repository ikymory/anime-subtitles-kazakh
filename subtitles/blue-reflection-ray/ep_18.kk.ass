Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:34.42,0:01:41.40,Default,,0,0,0,,♬～
Dialogue: 0,0:01:41.40,0:01:44.20,Default,,0,0,0,,Бұл менмін... (Мияко) Сакурайсың ба?
Dialogue: 0,0:01:44.20,0:01:48.77,Default,,0,0,0,,А... бұл менің кінәм. (Рука Ханари) Иә?
Dialogue: 0,0:01:48.77,0:01:52.71,Default,,0,0,0,,Мен әпкемнің өліміне себепкер болдым!
Dialogue: 0,0:01:52.71,0:01:54.81,Default,,0,0,0,,Хирахара мырза!
Dialogue: 0,0:01:56.81,0:01:59.91,Default,,0,0,0,,Сен Йо Сакурайға не істедің?
Dialogue: 0,0:02:01.45,0:02:21.47,Default,,0,0,0,,♬～
Dialogue: 0,0:02:21.47,0:02:39.89,Default,,0,0,0,,♬～
Dialogue: 0,0:02:39.89,0:02:43.29,Default,,0,0,0,,♬～
Dialogue: 0,0:02:43.29,0:03:02.35,Default,,0,0,0,,♬～
Dialogue: 0,0:03:02.35,0:03:14.15,Default,,0,0,0,,♬～
Dialogue: 0,0:03:15.63,0:03:19.13,Default,,0,0,0,,♬～
Dialogue: 0,0:03:19.13,0:03:30.53,Default,,0,0,0,,♬～
Dialogue: 0,0:03:34.24,0:03:36.81,Default,,0,0,0,,Иә! Ширакаба мырза!
Dialogue: 0,0:03:36.81,0:03:39.18,Default,,0,0,0,,Мен үшін не істедің! ➡
Dialogue: 0,0:03:39.18,0:03:41.85,Default,,0,0,0,,Осы маңызды уақытта Йо Сакурайдың өткені...➡
Dialogue: 0,0:03:41.85,0:03:44.42,Default,,0,0,0,,Бір кездері жойылып кеткен дүние туралы айтып жатқаныңызға сене алар емеспін➡
Dialogue: 0,0:03:44.42,0:03:48.26,Default,,0,0,0,,Сіз нені айтасыз? Міне, солай...
Dialogue: 0,0:03:48.26,0:03:50.29,Default,,0,0,0,,Юдзу мен Лайм не деді?
Dialogue: 0,0:03:50.29,0:03:54.03,Default,,0,0,0,,Не? (Нина) Жалпы есікті ашу үшін➡
Dialogue: 0,0:03:54.03,0:03:56.33,Default,,0,0,0,,Хирахара Йосакуриді Шиноға бергенімді қалайсың ба?
Dialogue: 0,0:03:56.33,0:03:58.37,Default,,0,0,0,,Ах
Dialogue: 0,0:03:58.37,0:04:00.64,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:04:00.64,0:04:03.44,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:04:05.01,0:04:07.61,Default,,0,0,0,,Есік сіздің қолыңызда➡ болады
Dialogue: 0,0:04:07.61,0:04:10.91,Default,,0,0,0,,Мен оны ашуым керек. Бірақ қараңызшы.
Dialogue: 0,0:04:10.91,0:04:13.51,Default,,0,0,0,,Сезімдерің мүлде бұзылды.➡
Dialogue: 0,0:04:14.95,0:04:18.39,Default,,0,0,0,,Фрагментті осылай қайтаруға болады ма?
Dialogue: 0,0:04:18.39,0:04:21.22,Default,,0,0,0,,Хмм...｡ (Нина) Менің қолымнан ештеңе келмейді➡
Dialogue: 0,0:04:21.22,0:04:24.06,Default,,0,0,0,,Мен әпкемнің қылмыс жасағанын қаламаймын.➡
Dialogue: 0,0:04:24.06,0:04:26.83,Default,,0,0,0,,Ал мұны істей алатын жалғыз адам - Хирахара Йосури.
Dialogue: 0,0:04:26.83,0:04:28.86,Default,,0,0,0,,Ах
Dialogue: 0,0:04:28.86,0:04:31.97,Default,,0,0,0,,Оған батылдық қажет!
Dialogue: 0,0:04:31.97,0:04:46.25,Default,,0,0,0,,♬～
Dialogue: 0,0:04:46.25,0:04:50.05,Default,,0,0,0,,)
Dialogue: 0,0:04:50.05,0:04:52.79,Default,,0,0,0,,≪Мен ештеңе білмедім≫
Dialogue: 0,0:04:52.79,0:04:56.26,Default,,0,0,0,,((Әпке, бұл ауырады.
Dialogue: 0,0:04:56.26,0:04:58.63,Default,,0,0,0,,Мен мазасыз болдым ба? ➡
Dialogue: 0,0:04:58.63,0:05:02.63,Default,,0,0,0,,Бұл сізге қажет емес пе? Сол үшін оны лақтырып жібердің бе? ➡
Dialogue: 0,0:05:02.63,0:05:07.44,Default,,0,0,0,,Артық емес. Ауырды... Жоғалғым келеді...➡
Dialogue: 0,0:05:07.44,0:05:09.97,Default,,0,0,0,,Менің жоғалғым келеді! ))
Dialogue: 0,0:05:09.97,0:05:12.01,Default,,0,0,0,,≪Бұл мен болдым...≫
Dialogue: 0,0:05:12.01,0:05:13.98,Default,,0,0,0,,((Мен не істеуім керек➡
Dialogue: 0,0:05:13.98,0:05:16.98,Default,,0,0,0,,Енді... білмеймін))
Dialogue: 0,0:05:16.98,0:05:19.15,Default,,0,0,0,,≪Әпкеңе қамқор боламын...≫
Dialogue: 0,0:05:24.62,0:05:30.63,Default,,0,0,0,,♬～
Dialogue: 0,0:05:30.63,0:05:33.76,Default,,0,0,0,,≪Бұл дүние...≫
Dialogue: 0,0:05:33.76,0:05:36.27,Default,,0,0,0,,[ТЕЛ] (ﾏﾅｰﾓｰﾄﾞ)
Dialogue: 0,0:05:36.27,0:05:40.34,Default,,0,0,0,,[TEL] (қоңырау үні)
Dialogue: 0,0:05:40.34,0:05:42.64,Default,,0,0,0,,Дыбыс жоқ. түртіңіз (ұялы телефон жұмысының дыбысы)
Dialogue: 0,0:05:42.64,0:05:44.67,Default,,0,0,0,,Мен сені алып кетейін.
Dialogue: 0,0:05:44.67,0:05:47.34,Default,,0,0,0,,Сіз қайда екеніңізді білмесеңіз де?
Dialogue: 0,0:05:47.34,0:05:49.68,Default,,0,0,0,,Мен дерлік түсінемін. Крек (тұру дыбысы)
Dialogue: 0,0:05:49.68,0:05:52.55,Default,,0,0,0,,Сәлем. Ах.
Dialogue: 0,0:05:52.55,0:05:55.38,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:05:55.38,0:05:57.48,Default,,0,0,0,,Мен бар күшімді салып, сол екі команданың ұпайларын жұлып аламын!
Dialogue: 0,0:05:59.69,0:06:03.79,Default,,0,0,0,,≪Бұл жігіт не өзі?!≫
Dialogue: 0,0:06:05.09,0:06:07.70,Default,,0,0,0,,((Мен оны қайтаратыныма сенімдімін➡
Dialogue: 0,0:06:07.70,0:06:10.43,Default,,0,0,0,,Ами Рюдің ойлары))
Dialogue: 0,0:06:10.43,0:06:13.60,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:06:13.60,0:06:16.07,Default,,0,0,0,,♬~
Dialogue: 0,0:06:16.07,0:06:19.24,Default,,0,0,0,,((Рука-чан, бұл мен➡
Dialogue: 0,0:06:19.24,0:06:23.95,Default,,0,0,0,,Ажыратылады деген жүрегім елжіреп тұрғандай болды))
Dialogue: 0,0:06:23.95,0:06:27.45,Default,,0,0,0,,)
Dialogue: 0,0:06:28.85,0:06:32.79,Default,,0,0,0,,((Мен өкінішімді күшке айналдырамын!))
Dialogue: 0,0:06:32.79,0:06:35.39,Default,,0,0,0,,)
Dialogue: 0,0:06:35.39,0:06:40.86,Default,,0,0,0,,♬～
Dialogue: 0,0:06:40.86,0:06:46.26,Default,,0,0,0,,≪Бұл жігіт не өзі?!≫
Dialogue: 0,0:06:49.51,0:06:51.54,Default,,0,0,0,,Плюс Ультра‼
Dialogue: 0,0:06:51.54,0:06:53.64,Default,,0,0,0,,♬～(Iaphone музыкасы “stay night”)
Dialogue: 0,0:06:53.64,0:06:57.08,Default,,0,0,0,,Қараңдаршы, бұл әнді біз үнемі бірге тыңдайтынбыз.
Dialogue: 0,0:06:57.08,0:07:01.68,Default,,0,0,0,,♬～(Iaphone музыкасы “stay night”)
Dialogue: 0,0:07:01.68,0:07:04.45,Default,,0,0,0,,Мен есімде жоқ. Сонымен бұл не?
Dialogue: 0,0:07:04.45,0:07:08.39,Default,,0,0,0,,♬～(Иахонның музыкасы «Әртүрлілік»)
Dialogue: 0,0:07:08.39,0:07:10.89,Default,,0,0,0,,Ах. Ами-Рю?
Dialogue: 0,0:07:10.89,0:07:14.80,Default,,0,0,0,,Әй. Сіз өзіңізді көбірек санасыз сезінесіз бе? ➡
Dialogue: 0,0:07:14.80,0:07:18.87,Default,,0,0,0,,Жарайды. Бұл оң реакция.➡
Dialogue: 0,0:07:18.87,0:07:22.30,Default,,0,0,0,,Шағылдырғыш ретінде ол күш қолданатын реакция.➡
Dialogue: 0,0:07:22.30,0:07:24.94,Default,,0,0,0,,Жақында қайтып келетінін айтты.➡
Dialogue: 0,0:07:24.94,0:07:27.64,Default,,0,0,0,,Не болды? (Рё Каэде) Қарғыс атсын!
Dialogue: 0,0:07:27.64,0:07:30.75,Default,,0,0,0,,Жоқ, бұл қорқынышты! Ашулы, ашулы.➡
Dialogue: 0,0:07:30.75,0:07:34.55,Default,,0,0,0,,Мен Рио Каэдеге айқайлауға тырыстым. Ха!
Dialogue: 0,0:07:34.55,0:07:38.22,Default,,0,0,0,,Менің күшім артып келеді. (Рё Каэде) Иә?
Dialogue: 0,0:07:38.22,0:07:42.19,Default,,0,0,0,,Екеуің. Екеуің бе?
Dialogue: 0,0:07:42.19,0:07:45.16,Default,,0,0,0,,Оның жүрегі бос.➡
Dialogue: 0,0:07:45.16,0:07:48.30,Default,,0,0,0,,Қоқыс тараған сайын➡
Dialogue: 0,0:07:48.30,0:07:51.20,Default,,0,0,0,,Сіздің ойларыңыз көбірек резонанс тудырады➡
Dialogue: 0,0:07:51.20,0:07:55.97,Default,,0,0,0,,Мұңды дыбысты ойнайды. Ұнайды...
Dialogue: 0,0:07:55.97,0:07:58.41,Default,,0,0,0,,Пичон…
Dialogue: 0,0:07:58.41,0:08:02.91,Default,,0,0,0,,Пичон… Пичон…
Dialogue: 0,0:08:02.91,0:08:06.28,Default,,0,0,0,,Суикинкуцу сияқты
Dialogue: 0,0:08:06.28,0:08:10.65,Default,,0,0,0,,Пичон… Пичон…
Dialogue: 0,0:08:10.65,0:08:14.82,Default,,0,0,0,,Пичон… Пичон…
Dialogue: 0,0:08:14.82,0:08:16.96,Default,,0,0,0,,Пичон…
Dialogue: 0,0:08:16.96,0:08:19.36,Default,,0,0,0,,Сәлем, әпке
Dialogue: 0,0:08:19.36,0:08:21.73,Default,,0,0,0,,Сіз өкінесіз...➡
Dialogue: 0,0:08:21.73,0:08:25.47,Default,,0,0,0,,Қателіктерімді күшке айналдырдым.
Dialogue: 0,0:08:25.47,0:08:28.34,Default,,0,0,0,,Оның ішінде жаңғырық➡
Dialogue: 0,0:08:28.34,0:08:31.11,Default,,0,0,0,,Осы жолы әлемді резонансқа айналдырайық
Dialogue: 0,0:08:31.11,0:08:35.08,Default,,0,0,0,,Дүние? (Мизуру) Байқап көрсеңіз түсінесіз.➡
Dialogue: 0,0:08:35.08,0:08:39.15,Default,,0,0,0,,Келесі жолы ол есін жинайды.➡
Dialogue: 0,0:08:39.15,0:08:41.62,Default,,0,0,0,,Менің уақытым жоқ. Бірақ➡
Dialogue: 0,0:08:41.62,0:08:44.95,Default,,0,0,0,,Келесі жолы табысты боласыз.➡
Dialogue: 0,0:08:44.95,0:08:48.92,Default,,0,0,0,,Сіз Йо Сакурай фрагментін ала аласыз.
Dialogue: 0,0:08:48.92,0:08:52.39,Default,,0,0,0,,Оның саған деген сезімі күшті болды.
Dialogue: 0,0:08:52.39,0:08:55.90,Default,,0,0,0,,Сондықтан ол нәзік. Ах.
Dialogue: 0,0:08:55.90,0:09:00.70,Default,,0,0,0,,Дәл қазір ол бала басқаларға қарағанда ыңғайлырақ болғысы келеді.➡
Dialogue: 0,0:09:00.70,0:09:03.37,Default,,0,0,0,,Сол кездегідей
Dialogue: 0,0:09:03.37,0:09:06.77,Default,,0,0,0,,Сіз қайдан білесіз? (Мизуру) Түсіндім.➡
Dialogue: 0,0:09:08.11,0:09:10.11,Default,,0,0,0,,Маған сеніңіз
Dialogue: 0,0:09:13.75,0:09:20.82,Default,,0,0,0,,♬～
Dialogue: 0,0:09:20.82,0:09:22.82,Default,,0,0,0,,≫Біз тағы кездесетінімізге сенімдімін
Dialogue: 0,0:09:25.19,0:09:29.20,Default,,0,0,0,,Орихиме және Хикобоши. Рука-чан...
Dialogue: 0,0:09:29.20,0:09:32.17,Default,,0,0,0,,Мен оны осында деп ойладым.
Dialogue: 0,0:09:32.17,0:09:35.57,Default,,0,0,0,,Мен Ямада мырзадан естідім. Менің ойымша, бұл қиын.
Dialogue: 0,0:09:35.57,0:09:38.94,Default,,0,0,0,,Бірақ ол да жаман оймен айтқан жоқ.
Dialogue: 0,0:09:38.94,0:09:41.84,Default,,0,0,0,,Тек Хирахара мырзаға...➡
Dialogue: 0,0:09:41.84,0:09:46.15,Default,,0,0,0,,Жоқ, біз дайындалуымыз керек.
Dialogue: 0,0:09:46.15,0:09:48.25,Default,,0,0,0,,Дайын ба?
Dialogue: 0,0:09:49.55,0:09:51.55,Default,,0,0,0,,деді әпкем
Dialogue: 0,0:09:51.55,0:09:55.19,Default,,0,0,0,,Қатені қайталағым келмейді
Dialogue: 0,0:09:55.19,0:09:59.93,Default,,0,0,0,,Сіз мені қинағыңыз келмейді. Иә.
Dialogue: 0,0:09:59.93,0:10:03.97,Default,,0,0,0,,Бірақ қателескен мен болдым.
Dialogue: 0,0:10:03.97,0:10:07.77,Default,,0,0,0,,Мен сенің әпкеңді қинадым.
Dialogue: 0,0:10:07.77,0:10:09.84,Default,,0,0,0,,Хирахара мырза…
Dialogue: 0,0:10:09.84,0:10:14.78,Default,,0,0,0,,Әпкемнің қайтыс болу себебі және бұл дүниенің жойылу себебі➡
Dialogue: 0,0:10:14.78,0:10:19.08,Default,,0,0,0,,Мен… Мен…｡ Хирахара-сан
Dialogue: 0,0:10:20.65,0:10:23.55,Default,,0,0,0,,Рука-чан…｡ Уф…
Dialogue: 0,0:10:24.79,0:10:29.76,Default,,0,0,0,,Мен... мен не істерімді білмеймін.
Dialogue: 0,0:10:29.76,0:10:33.66,Default,,0,0,0,,Уф... Уф...
Dialogue: 0,0:10:35.33,0:10:40.34,Default,,0,0,0,,Сіз ұйықтадыңыз ба? [TEL] Шаршап, абдырап қалды
Dialogue: 0,0:10:40.34,0:10:43.47,Default,,0,0,0,,Менің ойымша, бұл біраз уақытты алады.
Dialogue: 0,0:10:43.47,0:10:46.84,Default,,0,0,0,,Сонда ше? Сіз де сонда тұрасыз ба?
Dialogue: 0,0:10:46.84,0:10:49.41,Default,,0,0,0,,[ТЕЛ] Сіз мені жалғыз қалдыра алмайсыз, солай ма?
Dialogue: 0,0:10:49.41,0:10:51.78,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:10:51.78,0:10:54.58,Default,,0,0,0,,Ертең мені міндетті түрде үйге әкеліңіз.
Dialogue: 0,0:10:54.58,0:10:58.49,Default,,0,0,0,,Бұл екеуі маған кез келген уақытта қайта шабуыл жасауы мүмкін➡
Dialogue: 0,0:10:58.49,0:11:02.26,Default,,0,0,0,,Бірінші: Нина Ямада➡мен бір шаңырақ астында
Dialogue: 0,0:11:02.26,0:11:06.23,Default,,0,0,0,,Мен ұйықтай алмаймын. [TEL] Менің бөлмем басқа.
Dialogue: 0,0:11:06.23,0:11:09.23,Default,,0,0,0,,Уәде. Міне бітті. түртіңіз.
Dialogue: 0,0:11:13.40,0:11:15.74,Default,,0,0,0,,≪Оны да түсіндіңіз➡
Dialogue: 0,0:11:15.74,0:11:18.87,Default,,0,0,0,,Мен оны неге кешірмеймін.➡
Dialogue: 0,0:11:18.87,0:11:23.75,Default,,0,0,0,,Бірақ бұл бәрі емес. Мойындауды жек көремін, бірақ➡
Dialogue: 0,0:11:23.75,0:11:27.72,Default,,0,0,0,,Оның менде жоқ сезімдері бар≫
Dialogue: 0,0:11:27.72,0:11:32.15,Default,,0,0,0,,≪Ойымның күші. Сондықтан мен оны сеніп тапсырдым≫
Dialogue: 0,0:11:32.15,0:11:37.26,Default,,0,0,0,,≪Әпкеңіздің мұңын қабылдап, оны өз күшіңізге айналдырыңыз.➡
Dialogue: 0,0:11:37.26,0:11:40.33,Default,,0,0,0,,Йосакури Хирахара мұны істей алады.➡
Dialogue: 0,0:11:40.33,0:11:43.43,Default,,0,0,0,,Сіз өз мүмкіндігіңізді іске асырғанша≫
Dialogue: 0,0:11:46.34,0:11:50.77,Default,,0,0,0,,♬～
Dialogue: 0,0:11:50.77,0:11:53.94,Default,,0,0,0,,≪(Әдемі ішектер/ызылдау)♬ Хэхе~ Хэхе~
Dialogue: 0,0:11:53.94,0:11:57.08,Default,,0,0,0,,(Суға құлау дыбысы)
Dialogue: 0,0:11:57.08,0:11:59.15,Default,,0,0,0,,≪(Әдемі ішектер/ызылдау) ♬ Хэхехехе~
Dialogue: 0,0:11:59.15,0:12:01.52,Default,,0,0,0,,Әпке, сіз қу екенсіз!
Dialogue: 0,0:12:01.52,0:12:03.85,Default,,0,0,0,,Қайырлы таң Йо Сакурай
Dialogue: 0,0:12:03.85,0:12:06.62,Default,,0,0,0,,Бүгін менің таңғы ас әзірлеу кезегім.
Dialogue: 0,0:12:06.62,0:12:08.66,Default,,0,0,0,,Жарайды, Сакурай.
Dialogue: 0,0:12:08.66,0:12:11.76,Default,,0,0,0,,Енді өзіңізді итермелеудің қажеті жоқ. иә?
Dialogue: 0,0:12:13.73,0:12:17.30,Default,,0,0,0,,Маған енді күшті болудың қажеті жоқ, енді уайымдаудың қажеті жоқ...
Dialogue: 0,0:12:17.30,0:12:19.30,Default,,0,0,0,,Ха... үлкен апа?
Dialogue: 0,0:12:20.84,0:12:24.01,Default,,0,0,0,,Өзіңізге өтірік айтудың қажеті жоқ
Dialogue: 0,0:12:24.01,0:12:26.14,Default,,0,0,0,,Хирахара мырза! Хаха
Dialogue: 0,0:12:26.14,0:12:29.24,Default,,0,0,0,,Ju…(пісіру дыбысы)
Dialogue: 0,0:12:29.24,0:12:31.34,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:12:32.75,0:12:36.82,Default,,0,0,0,,♬～
Dialogue: 0,0:12:36.82,0:12:40.42,Default,,0,0,0,,Бірдеңе жемесең, ол денеңе улы.
Dialogue: 0,0:12:40.42,0:12:42.46,Default,,0,0,0,,Иә...
Dialogue: 0,0:12:42.46,0:12:46.36,Default,,0,0,0,,♬～
Dialogue: 0,0:12:46.36,0:12:51.00,Default,,0,0,0,,Ширакаба-сан да, Ямада-сан да сенің қайтуыңды күтіп отыр.
Dialogue: 0,0:12:51.00,0:12:53.77,Default,,0,0,0,,Иә...
Dialogue: 0,0:12:53.77,0:12:57.51,Default,,0,0,0,,Хирахара мырза, бұлай уайымдамаңыз.
Dialogue: 0,0:12:57.51,0:13:01.44,Default,,0,0,0,,Мен саған үлкен апа сияқтымын...хехе
Dialogue: 0,0:13:01.44,0:13:05.44,Default,,0,0,0,,Не? Менің әпкем де солай айтты.
Dialogue: 0,0:13:08.35,0:13:11.99,Default,,0,0,0,,Әйтеуір, тамақтанып болған соң, жатақханаға қайтайық.
Dialogue: 0,0:13:11.99,0:13:14.02,Default,,0,0,0,,Бұл жерде болу жақсы емес.
Dialogue: 0,0:13:14.02,0:13:17.76,Default,,0,0,0,,♬～
Dialogue: 0,0:13:17.76,0:13:19.80,Default,,0,0,0,,Ол барлық күшін тек саусақ ұштарына шоғырлатты ма?≫
Dialogue: 0,0:13:19.80,0:13:24.13,Default,,0,0,0,,Мен қайтып келгенде, бізде тағы бір стратегиялық кездесу болады. Кеңістік-уақыттың бұрмалануы кеңейеді➡
Dialogue: 0,0:13:24.13,0:13:27.07,Default,,0,0,0,,Әр адамның ойы бақылаудан шығып кетеді.
Dialogue: 0,0:13:27.07,0:13:29.47,Default,,0,0,0,,Фрагменттерді жинау үшін➡
Dialogue: 0,0:13:29.47,0:13:32.44,Default,,0,0,0,,Екінші жағы шағылыстырғыштардың санын көбейтті.
Dialogue: 0,0:13:32.44,0:13:34.44,Default,,0,0,0,,Біз не істей аламыз...
Dialogue: 0,0:13:36.45,0:13:39.28,Default,,0,0,0,,Рука-чан, бұл менмін...
Dialogue: 0,0:13:39.28,0:13:41.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:41.35,0:13:45.45,Default,,0,0,0,,Мен өз үзіндімді ойлаймын...
Dialogue: 0,0:13:47.62,0:13:50.09,Default,,0,0,0,,Ха! Содан кейін➡
Dialogue: 0,0:13:50.09,0:13:52.96,Default,,0,0,0,,Әпкем ешкімге зиян тигізбейтін дүние бар дейді...
Dialogue: 0,0:13:52.96,0:13:55.00,Default,,0,0,0,,Бұлай айтуға қалай дәтің бар!
Dialogue: 0,0:13:55.00,0:13:57.80,Default,,0,0,0,,Әпкеңді қайтарып алғың келмеді ме?
Dialogue: 0,0:13:57.80,0:14:01.40,Default,,0,0,0,,Олай жасасақ, Момо-сан мен Амиру-санға не болады!?
Dialogue: 0,0:14:01.40,0:14:03.47,Default,,0,0,0,,Өйткені сіздің әпкеңіз...
Dialogue: 0,0:14:03.47,0:14:06.31,Default,,0,0,0,,Уайымдамаңыз! Ах...
Dialogue: 0,0:14:06.31,0:14:11.05,Default,,0,0,0,,Үлкен апа Үлкен әпке... Сонда мен ше?
Dialogue: 0,0:14:11.05,0:14:14.05,Default,,0,0,0,,Менің ойым не болады?
Dialogue: 0,0:14:14.05,0:14:18.15,Default,,0,0,0,,Рука-чанның... сезімі?
Dialogue: 0,0:14:18.15,0:14:20.19,Default,,0,0,0,,Сіз білмейсіз бе?
Dialogue: 0,0:14:20.19,0:14:28.96,Default,,0,0,0,,♬～
Dialogue: 0,0:14:28.96,0:14:31.00,Default,,0,0,0,,Ах
Dialogue: 0,0:14:31.00,0:14:41.88,Default,,0,0,0,,♬～
Dialogue: 0,0:14:41.88,0:14:43.91,Default,,0,0,0,,Жабық
Dialogue: 0,0:14:43.91,0:14:47.58,Default,,0,0,0,,Ол жабық емес. Жүрегіңді ашатын сенсің.
Dialogue: 0,0:14:47.58,0:14:51.65,Default,,0,0,0,,Мен саған ашықпын. Менің ойымды білгендеріңізді қалаймын➡
Dialogue: 0,0:14:51.65,0:14:55.19,Default,,0,0,0,,Мен Рука-чанның ойын білгім келеді...
Dialogue: 0,0:14:55.19,0:14:57.99,Default,,0,0,0,,Ах. (2 адам) Ах!
Dialogue: 0,0:14:57.99,0:15:01.83,Default,,0,0,0,,Жоқ... Жаңғыра алмайсыз ба?
Dialogue: 0,0:15:01.83,0:15:04.63,Default,,0,0,0,,А...
Dialogue: 0,0:15:04.63,0:15:07.70,Default,,0,0,0,,Кешіріңіз, Рука-чан, бұл менің кінәм...
Dialogue: 0,0:15:07.70,0:15:09.80,Default,,0,0,0,,Хирахара мырза! кешіріңіз!
Dialogue: 0,0:15:11.21,0:15:13.24,Default,,0,0,0,,Хирахара мырза!
Dialogue: 0,0:15:13.24,0:15:20.44,Default,,0,0,0,,♬～
Dialogue: 0,0:17:23.11,0:17:27.11,Default,,0,0,0,,Жоғалтып алдың ба!? Кешіріңіз! бұл менің кінәм
Dialogue: 0,0:17:27.11,0:17:29.95,Default,,0,0,0,,[ТЕЛ] (Мияко) Мен солай ойлаймын.
Dialogue: 0,0:17:29.95,0:17:34.38,Default,,0,0,0,,Ширакаба мырзаның да маған телефон соғуын қалаймын. Мен қоңырау шалғанда жауап бермейді.
Dialogue: 0,0:17:34.38,0:17:38.22,Default,,0,0,0,,Күрсініп... Көмек көрсету мүмкін емес. Мен түссіндім.
Dialogue: 0,0:17:38.22,0:17:41.69,Default,,0,0,0,,Та Та Та
Dialogue: 0,0:17:41.69,0:17:45.99,Default,,0,0,0,,≪Бұл жігіт не өзі?!≫
Dialogue: 0,0:17:47.36,0:17:50.73,Default,,0,0,0,,[ТЕЛ] (ﾏﾅｰﾓｰﾄﾞ)
Dialogue: 0,0:17:50.73,0:17:57.11,Default,,0,0,0,,♬～
Dialogue: 0,0:17:57.11,0:17:59.14,Default,,0,0,0,,≪Тоқтату≫
Dialogue: 0,0:17:59.14,0:18:01.94,Default,,0,0,0,,((Неге мені Цукиномияға қойдыңыз?➡
Dialogue: 0,0:18:01.94,0:18:06.88,Default,,0,0,0,,Мен мазасыз болдым ба? Сіздің анаңыз да солай ма еді? ))
Dialogue: 0,0:18:06.88,0:18:10.79,Default,,0,0,0,,<<Оны қазірдің өзінде тоқтатыңыз. Әпкеңді кінәлама>>
Dialogue: 0,0:18:10.79,0:18:14.62,Default,,0,0,0,,((Сен ақымақсың! Енді жоқ.➡
Dialogue: 0,0:18:14.62,0:18:19.29,Default,,0,0,0,,Ауырды... Жоғалғым келеді... Жоғалғым келеді! ))
Dialogue: 0,0:18:19.29,0:18:23.17,Default,,0,0,0,,Тоқта! Хахаха...
Dialogue: 0,0:18:23.17,0:18:27.94,Default,,0,0,0,,Хаа ха ха... хаа...
Dialogue: 0,0:18:27.94,0:18:32.37,Default,,0,0,0,,♬~
Dialogue: 0,0:18:32.37,0:18:37.37,Default,,0,0,0,,Оған жоғары баға қояды!
Dialogue: 0,0:18:39.28,0:18:42.15,Default,,0,0,0,,Keen…(дыбыс толқындарының дыбысы)
Dialogue: 0,0:18:42.15,0:18:44.92,Default,,0,0,0,,Ах. Догон!
Dialogue: 0,0:18:44.92,0:18:47.29,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:47.29,0:18:51.03,Default,,0,0,0,,Ах, Рё Каэде-сан, Ами-сан
Dialogue: 0,0:18:51.03,0:18:54.46,Default,,0,0,0,,Әпкең айтқандай... ұқсайды
Dialogue: 0,0:18:54.46,0:18:56.50,Default,,0,0,0,,Ах
Dialogue: 0,0:18:56.50,0:19:00.07,Default,,0,0,0,,Ыңғайлы болғың келсе, мен саған рұқсат беремін.
Dialogue: 0,0:19:00.07,0:19:10.51,Default,,0,0,0,,♬～
Dialogue: 0,0:19:10.51,0:19:12.51,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:19:14.02,0:19:16.05,Default,,0,0,0,,Ах
Dialogue: 0,0:19:16.05,0:19:19.79,Default,,0,0,0,,♬～
Dialogue: 0,0:19:19.79,0:19:22.56,Default,,0,0,0,,Өтірік өмір сүретін қыздар
Dialogue: 0,0:19:22.56,0:19:24.59,Default,,0,0,0,,Сол қайғы
Dialogue: 0,0:19:24.59,0:19:26.63,Default,,0,0,0,,Гүлденген үмітсіздік
Dialogue: 0,0:19:26.63,0:19:28.63,Default,,0,0,0,,Біз бәріміз...
Dialogue: 0,0:19:30.13,0:19:32.23,Default,,0,0,0,,Уф...｡ (Рё Каэде) Не!?
Dialogue: 0,0:19:37.87,0:19:40.31,Default,,0,0,0,,Рука
Dialogue: 0,0:19:40.31,0:19:43.65,Default,,0,0,0,,Мм... Рука-чан
Dialogue: 0,0:19:43.65,0:19:47.22,Default,,0,0,0,,Хирахара мырза! сен не істеп жатырсың? тез! Хмм
Dialogue: 0,0:19:47.22,0:20:06.30,Default,,0,0,0,,♬～
Dialogue: 0,0:20:06.30,0:20:09.14,Default,,0,0,0,,♬～
Dialogue: 0,0:20:09.14,0:20:11.17,Default,,0,0,0,,Әй
Dialogue: 0,0:20:11.17,0:20:14.68,Default,,0,0,0,,Тоқташы, Райо Каэде! Мұны істеудің қажеті жоқ➡
Dialogue: 0,0:20:14.68,0:20:17.75,Default,,0,0,0,,Ами-санның ойы әрқашан біздікі!
Dialogue: 0,0:20:17.75,0:20:21.18,Default,,0,0,0,,Кешіріңіз, мен тоқтай алмаймын. Ах.
Dialogue: 0,0:20:21.18,0:20:23.95,Default,,0,0,0,,Өйткені бұл менің соңғы сәтім.
Dialogue: 0,0:20:23.95,0:20:25.99,Default,,0,0,0,,Уф! Қарғыс атсын!
Dialogue: 0,0:20:25.99,0:20:31.39,Default,,0,0,0,,Кин…
Dialogue: 0,0:20:31.39,0:20:33.49,Default,,0,0,0,,Пичон
Dialogue: 0,0:20:45.37,0:20:50.37,Default,,0,0,0,,Кин…
Dialogue: 0,0:21:02.42,0:21:04.46,Default,,0,0,0,,Аһ!
Dialogue: 0,0:21:04.46,0:21:07.46,Default,,0,0,0,,Уф! (Мияко) Уф... уф!
Dialogue: 0,0:21:07.46,0:21:10.10,Default,,0,0,0,,Не болды!? Екі адам келе жатыр.
Dialogue: 0,0:21:10.10,0:21:12.80,Default,,0,0,0,,Тез шағылыстырғышқа айналдыр...Мүмкін болса, мен!
Dialogue: 0,0:21:12.80,0:21:16.74,Default,,0,0,0,,Не? Жоқ... Бұл не?
Dialogue: 0,0:21:16.74,0:21:20.74,Default,,0,0,0,,≪Мүмкін емес...≫ ≪Осы қаладағы барлық балалар? ≫
Dialogue: 0,0:21:20.74,0:21:23.35,Default,,0,0,0,,Үлкен апа дұрыс айтты.➡
Dialogue: 0,0:21:23.35,0:21:27.25,Default,,0,0,0,,Менің өкініштерім енді Ами Рюда жаңғырық➡
Dialogue: 0,0:21:27.25,0:21:29.58,Default,,0,0,0,,Дүниені жаңғыртты
Dialogue: 0,0:21:29.58,0:21:32.52,Default,,0,0,0,,♬～
Dialogue: 0,0:21:32.52,0:21:34.56,Default,,0,0,0,,Бишу!
Dialogue: 0,0:21:34.56,0:21:37.66,Default,,0,0,0,,♬～
Dialogue: 0,0:21:37.66,0:21:41.06,Default,,0,0,0,,Уф! Рука-чан!
Dialogue: 0,0:21:41.06,0:21:44.10,Default,,0,0,0,,Тоқта, Райо Каэде! Оның Рука-чанға еш қатысы жоқ!
Dialogue: 0,0:21:44.10,0:21:46.87,Default,,0,0,0,,Не? Бұл менің...
Dialogue: 0,0:21:46.87,0:21:49.00,Default,,0,0,0,,Иә, бұл сіздің мәселеңіз!
Dialogue: 0,0:21:49.00,0:21:51.10,Default,,0,0,0,,Бас!
Dialogue: 0,0:21:54.58,0:21:56.68,Default,,0,0,0,,Рука-чан...
Dialogue: 0,0:21:56.68,0:21:59.95,Default,,0,0,0,,Хирахара мырза, қазір не істеп жатырсыз?
Dialogue: 0,0:21:59.95,0:22:03.65,Default,,0,0,0,,Не? Маған маңызды емес пе?
Dialogue: 0,0:22:03.65,0:22:07.12,Default,,0,0,0,,Мен доспын. Мен сенің серігіңмін!
Dialogue: 0,0:22:07.12,0:22:10.53,Default,,0,0,0,,♬～
Dialogue: 0,0:22:10.53,0:22:14.23,Default,,0,0,0,,Рио Каэде-сан, Ами-сан, бұл біртүрлі.
Dialogue: 0,0:22:14.23,0:22:16.97,Default,,0,0,0,,Бұл мүлдем дұрыс емес.
Dialogue: 0,0:22:16.97,0:22:20.00,Default,,0,0,0,,Кешіріңіз, Рука, бірақ мен сізбен көп уақытты ұрысып жатырмын➡
Dialogue: 0,0:22:20.00,0:22:22.90,Default,,0,0,0,,Бізде енді жоқ! Қарғыс атсын!
Dialogue: 0,0:22:24.77,0:22:27.28,Default,,0,0,0,,Кешіріңіз Хиорин
Dialogue: 0,0:22:27.28,0:22:30.75,Default,,0,0,0,,Өтінемін, Ами-сан. Райо Каэде-санды тоқтатыңыз.
Dialogue: 0,0:22:30.75,0:22:33.38,Default,,0,0,0,,Мен онымен айналысамын. Ах.
Dialogue: 0,0:22:33.38,0:22:37.42,Default,,0,0,0,,Бәріне менің кінәм.
Dialogue: 0,0:22:37.42,0:22:40.19,Default,,0,0,0,,Ах! Сакурай!
Dialogue: 0,0:22:40.19,0:22:42.22,Default,,0,0,0,,Бұл біртүрлі. иә?
Dialogue: 0,0:22:42.22,0:22:44.26,Default,,0,0,0,,Лейденшафтличтің солтүстік-шығысында—
Dialogue: 0,0:22:44.26,0:22:46.19,Default,,0,0,0,,<<Ол бұзды>>
Dialogue: 0,0:22:46.19,0:22:48.23,Default,,0,0,0,,Гакин! Гакин! Уф... Уф!
Dialogue: 0,0:22:48.23,0:22:51.33,Default,,0,0,0,,≪Неге... неге бұлай болды?≫
Dialogue: 0,0:22:51.33,0:22:56.81,Default,,0,0,0,,♬～
Dialogue: 0,0:22:56.81,0:22:59.27,Default,,0,0,0,,≪Мен көмектесуім керек еді≫
Dialogue: 0,0:22:59.27,0:23:03.41,Default,,0,0,0,,((Бәрі тағы да алға жылжуы үшін...➡
Dialogue: 0,0:23:03.41,0:23:06.21,Default,,0,0,0,,Әркімнің жолы жабылмасын))
Dialogue: 0,0:23:06.21,0:23:08.88,Default,,0,0,0,,)
Dialogue: 0,0:23:08.88,0:23:10.92,Default,,0,0,0,,≪Екі адам бірге...≫
Dialogue: 0,0:23:10.92,0:23:15.56,Default,,0,0,0,,)
Dialogue: 0,0:23:15.56,0:23:17.73,Default,,0,0,0,,≪Біздің ойларымыз! ≫
Dialogue: 0,0:23:17.73,0:23:19.86,Default,,0,0,0,,Уф!
Dialogue: 0,0:23:19.86,0:23:21.93,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:23:21.93,0:23:25.90,Default,,0,0,0,,)
Dialogue: 0,0:23:25.90,0:23:29.37,Default,,0,0,0,,)
Dialogue: 0,0:23:29.37,0:23:31.41,Default,,0,0,0,,Ха!
Dialogue: 0,0:23:31.41,0:23:38.15,Default,,0,0,0,,♬～
Dialogue: 0,0:23:38.15,0:23:41.18,Default,,0,0,0,,Бұл сенсің... Иә?
Dialogue: 0,0:23:41.18,0:23:43.28,Default,,0,0,0,,Бұл сен кінәлісің! (Рё Каэде) Ах
Dialogue: 0,0:23:46.62,0:23:49.22,Default,,0,0,0,,Иә!? Хмм...
Dialogue: 0,0:23:54.16,0:23:58.53,Default,,0,0,0,,Сакурай! Олар не істеп жатыр!
Dialogue: 0,0:23:58.53,0:24:01.97,Default,,0,0,0,,Хирахара мырза. Тоқта...
Dialogue: 0,0:24:01.97,0:24:06.41,Default,,0,0,0,,Тоқтамаңыз. Әпкемді ренжітпе.
Dialogue: 0,0:24:06.41,0:24:08.48,Default,,0,0,0,,Ояныңыз, Хирахара мырза!
Dialogue: 0,0:24:08.48,0:24:12.05,Default,,0,0,0,,Бұл адам. Бәрі де осы кісінің арқасы!
Dialogue: 0,0:24:12.05,0:24:14.08,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:24:14.08,0:24:16.08,Default,,0,0,0,,Догон!
Dialogue: 0,0:24:18.79,0:24:20.79,Default,,0,0,0,,Уф...
Dialogue: 0,0:24:23.29,0:24:26.13,Default,,0,0,0,,Ханари мырза!
Dialogue: 0,0:24:26.13,0:24:29.10,Default,,0,0,0,,Рука-чан...
Dialogue: 0,0:24:29.10,0:24:33.10,Default,,0,0,0,,Рахмет, Хиорин. Сен бәрін шешемін дегені үшін.
Dialogue: 0,0:24:33.10,0:24:36.57,Default,,0,0,0,,Мен сіздің үзіндіңізді аламын.
Dialogue: 0,0:24:36.57,0:24:39.17,Default,,0,0,0,,≪Мен не істеп жатырмын? ≫
Dialogue: 0,0:24:39.17,0:24:41.48,Default,,0,0,0,,Кин…
Dialogue: 0,0:24:41.48,0:24:43.58,Default,,0,0,0,,≪Маған не болды? ≫
Dialogue: 0,0:24:45.91,0:24:48.25,Default,,0,0,0,,≪Әпкең өлсін➡
Dialogue: 0,0:24:48.25,0:24:51.22,Default,,0,0,0,,Әлемді құрту➡
Dialogue: 0,0:24:51.22,0:24:53.52,Default,,0,0,0,,Енді, Рука-чан тағы да...≫
Dialogue: 0,0:24:55.79,0:24:59.59,Default,,0,0,0,,<<Мен неге бұл екеуімен ұрысып жатырмын? ≫
Dialogue: 0,0:25:01.73,0:25:03.93,Default,,0,0,0,,≪Олар көмектескісі келсе де...≫
Dialogue: 0,0:25:05.60,0:25:08.90,Default,,0,0,0,,≪Екеуміз де сезімдерімізді қайтарғымыз келсе де≫
Dialogue: 0,0:25:10.24,0:25:12.31,Default,,0,0,0,,Әй!
Dialogue: 0,0:25:12.31,0:25:14.41,Default,,0,0,0,,Бики!
Dialogue: 0,0:25:14.41,0:25:17.68,Default,,0,0,0,,Мен оны жек көремін!!
Dialogue: 0,0:25:17.68,0:25:19.68,Default,,0,0,0,,Уф! (Ами Рю) Ах!
Dialogue: 0,0:25:21.48,0:25:23.52,Default,,0,0,0,,Хехе
Dialogue: 0,0:25:23.52,0:25:25.55,Default,,0,0,0,,Догон! Догон!
Dialogue: 0,0:25:25.55,0:25:32.16,Default,,0,0,0,,♬～
Dialogue: 0,0:25:32.16,0:25:34.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:25:36.00,0:25:38.07,Default,,0,0,0,,Ах!
Dialogue: 0,0:25:38.07,0:25:40.00,Default,,0,0,0,,Хирахара мырза…
Dialogue: 0,0:25:40.00,0:25:47.91,Default,,0,0,0,,♬～
Dialogue: 0,0:25:47.91,0:25:50.81,Default,,0,0,0,,үшін бір-бірімен үндеседі.➡
Dialogue: 0,0:25:50.81,0:25:54.82,Default,,0,0,0,,Бұл есікті ашатын кілт.
Dialogue: 0,0:25:54.82,0:25:58.29,Default,,0,0,0,,♬～
Dialogue: 0,0:25:58.29,0:26:03.32,Default,,0,0,0,,Қалаан Қалаан…(қоңырау дыбысы)
Dialogue: 0,0:26:03.32,0:26:14.92,Default,,0,0,0,,♬～
Dialogue: 0,0:26:16.34,0:26:35.39,Default,,0,0,0,,♬～
Dialogue: 0,0:26:35.39,0:26:49.80,Default,,0,0,0,,♬～
Dialogue: 0,0:26:49.80,0:26:57.35,Default,,0,0,0,,♬～
Dialogue: 0,0:26:57.35,0:27:10.43,Default,,0,0,0,,♬～
Dialogue: 0,0:27:10.43,0:27:26.47,Default,,0,0,0,,♬～
Dialogue: 0,0:27:26.47,0:27:30.98,Default,,0,0,0,,♬～
Dialogue: 0,0:27:30.98,0:27:45.48,Default,,0,0,0,,♬～
Dialogue: 0,0:29:18.12,0:29:20.89,Default,,0,0,0,,Йо Сакурайдың сезімі де нәзік емес.
Dialogue: 0,0:29:20.89,0:29:24.23,Default,,0,0,0,,Бұл сақина сіздің асыл сезімдеріңізді құрбан етеді.
Dialogue: 0,0:29:24.23,0:29:28.03,Default,,0,0,0,,Егер біз мұндай әрекет жасамасақ...
Dialogue: 0,0:29:28.03,0:29:30.53,Default,,0,0,0,,Йо Сакурайда ештеңе жоқ.
Dialogue: 0,0:29:32.03,0:29:38.03,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
