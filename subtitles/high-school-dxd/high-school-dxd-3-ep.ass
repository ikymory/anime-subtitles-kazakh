Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.50,Default,,0,0,0,,Жарқыраған ақ аққұба қыз! Сирек! Бұл өте ыстық!
Dialogue: 0,0:00:06.50,0:00:08.00,Default,,0,0,0,,Не айтып тұрсың!
Dialogue: 0,0:00:08.00,0:00:10.00,Default,,0,0,0,,Эй, жақсысың ба?
Dialogue: 0,0:00:10.00,0:00:13.00,Default,,0,0,0,,Хаа… Хаа… Хаа….
Dialogue: 0,0:00:20.00,0:00:21.00,Default,,0,0,0,,Сүйкімді.
Dialogue: 0,0:00:25.00,0:00:26.00,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:00:26.00,0:00:30.00,Default,,0,0,0,,Ой.
Dialogue: 0,0:00:30.00,0:00:34.00,Default,,0,0,0,,Дәл менің идеал қызым!
Dialogue: 0,0:00:34.00,0:00:37.00,Default,,0,0,0,,нұсқасы аққұба әдемі қыз!
Dialogue: 0,0:00:37.00,0:00:39.00,Default,,0,0,0,,Хаа… Хаа… Хаа….
Dialogue: 0,0:00:39.00,0:00:41.00,Default,,0,0,0,,Жоқ, жоқ.
Dialogue: 0,0:00:41.00,0:00:43.00,Default,,0,0,0,,Әңгімені қандай да бір жолмен жалғастыруымыз керек.
Dialogue: 0,0:00:43.00,0:00:45.00,Default,,0,0,0,,Ал, тақырып, тақырып.
Dialogue: 0,0:00:45.00,0:00:48.00,Default,,0,0,0,,Міне, бүгін ауа-райы жақсы.
Dialogue: 0,0:00:48.00,0:00:51.00,Default,,0,0,0,,Көршінің кемпірі, мен!
Dialogue: 0,0:01:21.00,0:01:24.00,Default,,0,0,0,,Жоқ, ештеңе.
Dialogue: 0,0:01:24.00,0:01:27.00,Default,,0,0,0,,Не, кенеттен?
Dialogue: 0,0:01:27.00,0:01:31.00,Default,,0,0,0,,О, бұл!
Dialogue: 0,0:01:31.00,0:01:33.00,Default,,0,0,0,,Не?
Dialogue: 0,0:01:33.00,0:01:37.00,Default,,0,0,0,,Ұл болсаң, бұлай ренжісе жылама.
Dialogue: 0,0:01:37.00,0:01:38.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:39.00,0:01:41.00,Default,,0,0,0,,Уау.
Dialogue: 0,0:01:43.00,0:01:45.00,Default,,0,0,0,,Ки, сызат.
Dialogue: 0,0:01:45.00,0:01:47.00,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:01:47.00,0:01:51.00,Default,,0,0,0,,Хм. Хахахаха
Dialogue: 0,0:01:51.00,0:01:54.00,Default,,0,0,0,,Мен дәл қазір қиналдым.
Dialogue: 0,0:01:54.00,0:01:57.00,Default,,0,0,0,,Иә, тыртық жоғалып кетті.
Dialogue: 0,0:01:57.00,0:01:59.00,Default,,0,0,0,,Енді бәрі жақсы
Dialogue: 0,0:01:59.00,0:02:01.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:02:01.00,0:02:03.00,Default,,0,0,0,,Құдайдың жазасы зұлымдыққа тиеді.
Dialogue: 0,0:02:07.00,0:02:12.00,Default,,0,0,0,,Бұл менің сол қолым жауап берді дегенді білдіреді.
Dialogue: 0,0:02:12.00,0:02:14.00,Default,,0,0,0,,Сіз таң қалдыңыз ба?
Dialogue: 0,0:02:14.00,0:02:16.00,Default,,0,0,0,,Біз оқиға орнына бірінші жетеміз.
Dialogue: 0,0:02:16.00,0:02:18.00,Default,,0,0,0,,Сізде үлкен күш бар.
Dialogue: 0,0:02:18.00,0:02:22.00,Default,,0,0,0,,Тәңірден алған керемет құдірет.
Dialogue: 0,0:02:22.00,0:02:24.00,Default,,0,0,0,,Иә
Dialogue: 0,0:02:24.00,0:02:26.00,Default,,0,0,0,,(Отокоцудың дауысы)
Dialogue: 0,0:02:28.00,0:02:30.00,Default,,0,0,0,,Мына жерде.
Dialogue: 0,0:02:30.00,0:02:32.00,Default,,0,0,0,,Иә
Dialogue: 0,0:02:32.00,0:02:34.00,Default,,0,0,0,,Бұл қаладағы жалғыз шіркеу - сол.
Dialogue: 0,0:02:34.00,0:02:36.00,Default,,0,0,0,,Жақсы
Dialogue: 0,0:02:36.00,0:02:38.00,Default,,0,0,0,,Бұл маған шынымен көмектесті
Dialogue: 0,0:02:38.00,0:02:40.00,Default,,0,0,0,,Ах
Dialogue: 0,0:02:40.00,0:02:44.00,Default,,0,0,0,,Бірақ мен ол жерде ешкімді көрмедім.
Dialogue: 0,0:02:44.00,0:02:48.00,Default,,0,0,0,,Мен сізге рахмет айтқым келеді, сондықтан менімен бірге келе аласыз ба?
Dialogue: 0,0:02:48.00,0:02:50.00,Default,,0,0,0,,Біз оқиға орнына бірінші жетеміз.
Dialogue: 0,0:02:50.00,0:02:52.00,Default,,0,0,0,,Менің бір ісім бар.
Dialogue: 0,0:02:52.00,0:02:54.00,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:02:54.00,0:02:58.00,Default,,0,0,0,,Менің атым Азия Аргенто.
Dialogue: 0,0:02:58.00,0:03:00.00,Default,,0,0,0,,Мені Азия деп атаңыз
Dialogue: 0,0:03:00.00,0:03:02.00,Default,,0,0,0,,Мен
Dialogue: 0,0:03:02.00,0:03:04.00,Default,,0,0,0,,Иссей жақсы.
Dialogue: 0,0:03:04.00,0:03:06.00,Default,,0,0,0,,Иссей мырза
Dialogue: 0,0:03:06.00,0:03:10.00,Default,,0,0,0,,Мен Жапонияға келгеннен кейін бірден Иссей мырза сияқты мейірімді, жұмсақ адамды кездестірдім.
Dialogue: 0,0:03:10.00,0:03:12.00,Default,,0,0,0,,Мен бақыттымын
Dialogue: 0,0:03:12.00,0:03:14.00,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:03:14.00,0:03:16.00,Default,,0,0,0,,Азия
Dialogue: 0,0:03:16.00,0:03:18.00,Default,,0,0,0,,Уақытыңыз болған кезде оны шіркеуге қалдырыңыз.
Dialogue: 0,0:03:18.00,0:03:20.00,Default,,0,0,0,,Бұл уәде.
Dialogue: 0,0:03:20.00,0:03:22.00,Default,,0,0,0,,О
Dialogue: 0,0:03:22.00,0:03:24.00,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:03:24.00,0:03:26.00,Default,,0,0,0,,Жақында кездескенше
Dialogue: 0,0:03:26.00,0:03:28.00,Default,,0,0,0,,Иә, тағы кездескенше.
Dialogue: 0,0:03:28.00,0:03:32.00,Default,,0,0,0,,Ол өте жақсы қыз.
Dialogue: 0,0:03:32.00,0:03:36.00,Default,,0,0,0,,Ешқашан шіркеуге жақындамаңыз
Dialogue: 0,0:03:36.00,0:03:37.00,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:03:37.00,0:03:40.00,Default,,0,0,0,,Шіркеу - шайтандар үшін жау территориясы
Dialogue: 0,0:03:40.00,0:03:45.00,Default,,0,0,0,,Оған кірсең, Құдай мен шайтанның проблемасына айналады.
Dialogue: 0,0:03:45.00,0:03:48.00,Default,,0,0,0,,Жарық найзасы маған қашан ұшып келетінін білмедім.
Dialogue: 0,0:03:48.00,0:03:50.00,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:03:50.00,0:03:54.00,Default,,0,0,0,,Сонымен, шіркеуге жақындағанда қандай тәж болады?
Dialogue: 0,0:03:54.00,0:03:57.00,Default,,0,0,0,,Ібілістің түйсіктері қауіпті сезді.
Dialogue: 0,0:03:57.00,0:04:02.00,Default,,0,0,0,,Шіркеу мүшелерімен бірге болу өліммен синхрондалады.
Dialogue: 0,0:04:02.00,0:04:10.00,Default,,0,0,0,,Әсіресе шіркеуге жататын кейбір эксзорцисттер Sacred Gear қолданушылары болғандықтан.
Dialogue: 0,0:04:10.00,0:04:13.00,Default,,0,0,0,,Isse
Dialogue: 0,0:04:13.00,0:04:15.00,Default,,0,0,0,,А, иә
Dialogue: 0,0:04:15.00,0:04:20.00,Default,,0,0,0,,Қуылған жындар толығымен жойылды.
Dialogue: 0,0:04:20.00,0:04:21.00,Default,,0,0,0,,Көп емес екен, иә?
Dialogue: 0,0:04:21.00,0:04:25.00,Default,,0,0,0,,Ештеңе, ештеңе сезе алмайды, ештеңе істей алмайды
Dialogue: 0,0:04:25.00,0:04:29.00,Default,,0,0,0,,Мұның қаншалықты маңызды екенін білесіз.
Dialogue: 0,0:04:29.00,0:04:32.00,Default,,0,0,0,,Жоқ, жоқ
Dialogue: 0,0:04:32.00,0:04:35.00,Default,,0,0,0,,Кешіріңіз, мен тым қызып кеттім.
Dialogue: 0,0:04:35.00,0:04:38.00,Default,,0,0,0,,Қалай болғанда да, қазірден бастап сақ болыңыз.
Dialogue: 0,0:04:38.00,0:04:40.00,Default,,0,0,0,,Иә
Dialogue: 0,0:04:40.00,0:04:47.00,Default,,0,0,0,,Күрсін, мені үнемі менеджер ұрысып тұратын.
Dialogue: 0,0:04:47.00,0:04:53.00,Default,,0,0,0,,Кешіріңіз Асия, мен өз уәдемді орындай алмаймын деп ойлаймын.
Dialogue: 0,0:04:53.00,0:04:57.00,Default,,0,0,0,,Директор Иссей-кун үшін алаңдайды.
Dialogue: 0,0:04:57.00,0:04:59.00,Default,,0,0,0,,Уау, Акено-сан.
Dialogue: 0,0:05:01.00,0:05:03.00,Default,,0,0,0,,Акено, мен сені үйде екен деп ойладым.
Dialogue: 0,0:05:03.00,0:05:06.00,Default,,0,0,0,,Маған жаңа ғана Ұлы Герцог қоңырау шалды.
Dialogue: 0,0:05:06.00,0:05:07.00,Default,,0,0,0,,Ұлы Герцогтен?
Dialogue: 0,0:05:07.00,0:05:11.00,Default,,0,0,0,,Осы қаладан адасқан шайтан табылған сияқты.
Dialogue: 0,0:05:11.00,0:05:13.00,Default,,0,0,0,,Ах
Dialogue: 0,0:05:13.00,0:05:15.00,Default,,0,0,0,,Бастапқыда шайтанның қызметшісі
Dialogue: 0,0:05:15.00,0:05:17.00,Default,,0,0,0,,Бізді ұнатасыз ба?
Dialogue: 0,0:05:17.00,0:05:22.00,Default,,0,0,0,,Кейде қожайынына опасыздық жасап немесе өлтіріп, өз қалауынша өмір сүруге тырысатындар болады.
Dialogue: 0,0:05:22.00,0:05:24.00,Default,,0,0,0,,Бұл адасқан шайтан
Dialogue: 0,0:05:24.00,0:05:30.00,Default,,0,0,0,,Қаңғыбас шайтан тісті қанаттарымен азғырған адамдарды жеп жатқаны хабарланған.
Dialogue: 0,0:05:30.00,0:05:32.00,Default,,0,0,0,,Тамақ ішу керек пе?
Dialogue: 0,0:05:32.00,0:05:35.00,Default,,0,0,0,,Сіздің бүгінгі түндегі жұмысыңыз – оны бағындыру.
Dialogue: 0,0:05:35.00,0:05:41.00,Default,,0,0,0,,Қожайынсыз жын күшін шектеусіз пайдалану қалай жағымсыз нәтижелерге әкеледі.
Dialogue: 0,0:05:43.00,0:05:44.00,Default,,0,0,0,,Иссей
Dialogue: 0,0:05:44.00,0:05:45.00,Default,,0,0,0,,Иә, менеджер.
Dialogue: 0,0:05:45.00,0:05:47.00,Default,,0,0,0,,Сіз шахмат ойынын түсінесіз бе?
Dialogue: 0,0:05:47.00,0:05:50.00,Default,,0,0,0,,Шахмат үстел ойыны ма?
Dialogue: 0,0:05:51.00,0:05:55.00,Default,,0,0,0,,Мен Иеміздің Патшасымын, Патшайыммын
Dialogue: 0,0:05:55.00,0:05:57.00,Default,,0,0,0,,Рыцарь/Пышақ
Dialogue: 0,0:05:57.00,0:05:59.00,Default,,0,0,0,,Жауынгер Лука
Dialogue: 0,0:05:59.00,0:06:01.00,Default,,0,0,0,,Жан епископы
Dialogue: 0,0:06:01.00,0:06:03.00,Default,,0,0,0,,Солдат Пон
Dialogue: 0,0:06:03.00,0:06:09.00,Default,,0,0,0,,Борышкер шайтан бұл бөліктің сипаттамаларын өз қызметшісіне береді.
Dialogue: 0,0:06:09.00,0:06:10.00,Default,,0,0,0,,Бөлшектердің сипаттамасы?
Dialogue: 0,0:06:10.00,0:06:14.00,Default,,0,0,0,,Біз мұны зұлымдық бейбітшілік деп атаймыз.
Dialogue: 0,0:06:14.00,0:06:16.00,Default,,0,0,0,,Неге алаңдау керек?
Dialogue: 0,0:06:16.00,0:06:21.00,Default,,0,0,0,,Әйтеуір, бүгін түнде шайтандардың шайқасына жақсылап қараңыз.
Dialogue: 0,0:06:21.00,0:06:22.00,Default,,0,0,0,,А, иә
Dialogue: 0,0:06:22.00,0:06:23.00,Default,,0,0,0,,келді
Dialogue: 0,0:07:23.00,0:07:24.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:24.00,0:07:26.00,Default,,0,0,0,,Сиқырлы шеңбер емес пе?
Dialogue: 0,0:07:26.00,0:07:27.00,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:07:27.00,0:07:37.00,Default,,0,0,0,,Бұл сөзсіз құбыжық.
Dialogue: 0,0:07:37.00,0:07:38.00,Default,,0,0,0,,Сақтықты төмендетпеңіз
Dialogue: 0,0:07:38.00,0:07:43.00,Default,,0,0,0,,Юто
Dialogue: 0,0:07:43.00,0:07:44.00,Default,,0,0,0,,Көру үшін тым жылдам
Dialogue: 0,0:07:44.00,0:07:47.00,Default,,0,0,0,,Ютоның рөлі жоқ.
Dialogue: 0,0:07:47.00,0:07:49.00,Default,,0,0,0,,Сипаттама – жылдамдық
Dialogue: 0,0:07:49.00,0:07:51.00,Default,,0,0,0,,Оның ең үлкен қаруы – қылыш
Dialogue: 0,0:07:51.00,0:08:06.00,Default,,0,0,0,,Қауіпті!
Dialogue: 0,0:08:06.00,0:08:09.00,Default,,0,0,0,,Жарайды
Dialogue: 0,0:08:09.00,0:08:18.00,Default,,0,0,0,,Конеко – Лука
Dialogue: 0,0:08:18.00,0:08:20.00,Default,,0,0,0,,Оның сипаттамалары қарапайым
Dialogue: 0,0:08:20.00,0:08:22.04,Default,,0,0,0,,Абсурдтық күш пен қорғаныс
Dialogue: 0,0:08:22.04,0:08:24.60,Default,,0,0,0,,Мен ондай деңгейде ренжімеймін.
Dialogue: 0,0:08:24.60,0:08:26.44,Default,,0,0,0,,Ұш
Dialogue: 0,0:08:26.44,0:08:37.60,Default,,0,0,0,,Котенкаға бағынбауға тырысыңыз
Dialogue: 0,0:08:37.60,0:08:38.68,Default,,0,0,0,,Акено
Dialogue: 0,0:08:38.68,0:08:40.14,Default,,0,0,0,,Иә, директор
Dialogue: 0,0:08:40.14,0:08:43.56,Default,,0,0,0,,О, менің не істеуім керек?
Dialogue: 0,0:08:43.56,0:08:48.02,Default,,0,0,0,,Менеджер
Dialogue: 0,0:08:48.02,0:08:51.32,Default,,0,0,0,,Сейкрипакирия
Dialogue: 0,0:08:51.32,0:08:59.02,Default,,0,0,0,,Рахмет
Dialogue: 0,0:08:59.02,0:09:02.64,Default,,0,0,0,,Жарайды, жоқ, менің денем мұны өздігінен жасайды.
Dialogue: 0,0:09:02.64,0:09:05.76,Default,,0,0,0,,Бұл
Dialogue: 0,0:09:05.76,0:09:08.72,Default,,0,0,0,,Мұны істеме Акено
Dialogue: 0,0:09:08.72,0:09:10.88,Default,,0,0,0,,Менеджерге қолыңызды тигізуге қалай батылыңыз бар?
Dialogue: 0,0:09:10.88,0:09:12.60,Default,,0,0,0,,Жіп тігу кезінде не істеуге болмайды
Dialogue: 0,0:09:12.60,0:09:14.82,Default,,0,0,0,,Бұл жаза.
Dialogue: 0,0:09:14.82,0:09:17.12,Default,,0,0,0,,Ол патшайым
Dialogue: 0,0:09:17.12,0:09:21.06,Default,,0,0,0,,Басқа бала барлық билікке ие болды
Dialogue: 0,0:09:21.06,0:09:22.50,Default,,0,0,0,,Жеңілмейтін директордың орынбасары
Dialogue: 0,0:09:22.50,0:09:25.78,Default,,0,0,0,,О, әлі де сау көрінесің.
Dialogue: 0,0:09:25.78,0:09:27.98,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:09:27.98,0:09:30.88,Default,,0,0,0,,Ол сиқырды қолданып шабуыл жасауды жақсы біледі.
Dialogue: 0,0:09:30.88,0:09:32.90,Default,,0,0,0,,Сонымен қатар, ол
Dialogue: 0,0:09:32.90,0:09:35.78,Default,,0,0,0,,Әй, сен әлі де жақсы жүрген сияқтысың.
Dialogue: 0,0:09:35.78,0:09:38.96,Default,,0,0,0,,Соңғы секс
Dialogue: 0,0:09:38.96,0:09:41.50,Default,,0,0,0,,Қанша уақыт шыдай аламын?
Dialogue: 0,0:09:41.50,0:09:43.92,Default,,0,0,0,,Мен қабылдаймын
Dialogue: 0,0:09:43.92,0:09:46.40,Default,,0,0,0,,Осымен қалдырайық.
Dialogue: 0,0:09:46.40,0:09:51.00,Default,,0,0,0,,Біткеніне сене алар емеспін
Dialogue: 0,0:09:51.00,0:09:53.62,Default,,0,0,0,,Бұл біраз көңіл көншітеді.
Dialogue: 0,0:09:53.62,0:09:54.62,Default,,0,0,0,,Хехехе
Dialogue: 0,0:09:54.62,0:09:59.30,Default,,0,0,0,,Уфуфуфу
Dialogue: 0,0:09:59.30,0:10:01.52,Default,,0,0,0,,Үйге қайтып бара жатқанда қолымды қалдырмаймын.
Dialogue: 0,0:10:01.52,0:10:02.18,Default,,0,0,0,,Уфуфуфу
Dialogue: 0,0:10:02.18,0:10:03.12,Default,,0,0,0,,Әзірге
Dialogue: 0,0:10:03.12,0:10:06.84,Default,,0,0,0,,Тек оны өшіріп, ұшып кет.
Dialogue: 0,0:10:06.84,0:10:09.04,Default,,0,0,0,,(Сора) Сол жақтағы қарт кітапханада мені бақылап тұрды—
Dialogue: 0,0:10:09.04,0:10:20.34,Default,,0,0,0,,Бітті.
Dialogue: 0,0:10:20.34,0:10:21.72,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:10:21.72,0:10:23.34,Default,,0,0,0,,Мен үйге бара жатырмын
Dialogue: 0,0:10:23.34,0:10:25.16,Default,,0,0,0,,Иә, директор
Dialogue: 0,0:10:25.16,0:10:28.50,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:10:28.50,0:10:30.70,Default,,0,0,0,,Сонымен, I
Dialogue: 0,0:10:30.70,0:10:33.08,Default,,0,0,0,,Сіз менің шығармамды айтасыз ба?
Dialogue: 0,0:10:33.08,0:10:35.58,Default,,0,0,0,,Қызметші ретіндегі қызметіңіз қандай?
Dialogue: 0,0:10:35.58,0:10:37.04,Default,,0,0,0,,Пешкаға
Dialogue: 0,0:10:37.04,0:10:39.32,Default,,0,0,0,,Мен оны пешка деп ешқашан ойламаппын.
Dialogue: 0,0:10:39.32,0:10:39.88,Default,,0,0,0,,Иә
Dialogue: 0,0:10:39.88,0:10:42.80,Default,,0,0,0,,Исей сен солдатсың
Dialogue: 0,0:10:42.80,0:10:44.30,Default,,0,0,0,,Солдат
Dialogue: 0,0:10:44.30,0:10:47.76,Default,,0,0,0,,Ең төменгі
Dialogue: 0,0:10:47.76,0:10:48.52,Default,,0,0,0,,Бұл
Dialogue: 0,0:10:55.16,0:11:02.88,Default,,0,0,0,,Қызметші болу
Dialogue: 0,0:11:02.88,0:11:05.22,Default,,0,0,0,,Жоғары дәрежелі шайтанға айналуы керек
Dialogue: 0,0:11:05.22,0:11:08.56,Default,,0,0,0,,Басынан бастап аға шайтан менеджерінен айырмашылығы.
Dialogue: 0,0:11:08.56,0:11:11.10,Default,,0,0,0,,Біз реинкарнацияланған адамдар біздің күшімізбен танылды.
Dialogue: 0,0:11:11.10,0:11:12.66,Default,,0,0,0,,Жоғарылату керек
Dialogue: 0,0:11:12.66,0:11:14.30,Default,,0,0,0,,Бірақ мен әскеримін
Dialogue: 0,0:11:14.30,0:11:15.42,Default,,0,0,0,,Ең әлсіз бөлік
Dialogue: 0,0:11:15.42,0:11:16.88,Default,,0,0,0,,Бұл тасталған кесек емес пе?
Dialogue: 0,0:11:16.88,0:11:19.22,Default,,0,0,0,,О
Dialogue: 0,0:11:19.22,0:11:21.84,Default,,0,0,0,,Гарем патшасы болудың жолы ұзақ.
Dialogue: 0,0:11:25.16,0:11:31.30,Default,,0,0,0,,Оны ашық қалдыру - мәселе.
Dialogue: 0,0:11:31.30,0:11:32.88,Default,,0,0,0,,Құмыралар
Dialogue: 0,0:11:32.88,0:11:35.54,Default,,0,0,0,,Мен Гремори-саманың таныс жынмын.
Dialogue: 0,0:11:35.54,0:11:37.54,Default,,0,0,0,,Клиент үшін:
Dialogue: 0,0:11:37.54,0:11:39.38,Default,,0,0,0,,Дұшпан тұзақты тарылтып жатыр.
Dialogue: 0,0:11:39.38,0:11:40.42,Default,,0,0,0,,Көп емес екен, иә?
Dialogue: 0,0:11:40.42,0:11:42.02,Default,,0,0,0,,Мен өзімді нашар сезінемін
Dialogue: 0,0:11:42.02,0:11:44.38,Default,,0,0,0,,Сіз сондасыз ба?
Dialogue: 0,0:11:44.38,0:11:51.76,Default,,0,0,0,,Котенка тағы да шақырылды.
Dialogue: 0,0:11:51.76,0:11:54.60,Default,,0,0,0,,Маған бүгін кешке біреуін бере аласыз ба?
Dialogue: 0,0:11:54.60,0:11:55.44,Default,,0,0,0,,Иә, директор
Dialogue: 0,0:11:55.44,0:11:58.90,Default,,0,0,0,,Мен бұл жолы міндетті түрде келісім-шарт аламын.
Dialogue: 0,0:11:58.90,0:12:01.60,Default,,0,0,0,,Менің үмітімді ақтамаңыз
Dialogue: 0,0:12:01.60,0:12:03.78,Default,,0,0,0,,Иә
Dialogue: 0,0:12:03.78,0:12:06.96,Default,,0,0,0,,Мен осылай қайтып оралсам
Dialogue: 0,0:12:06.96,0:12:09.40,Default,,0,0,0,,Менеджермен кездесудің уақыты келді.
Dialogue: 0,0:12:09.40,0:12:15.74,Default,,0,0,0,,Мазалағаным үшін кешіріңіз
Dialogue: 0,0:12:15.74,0:12:21.66,Default,,0,0,0,,Атмосфера құру
Dialogue: 0,0:12:21.66,0:12:23.60,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:12:23.60,0:12:27.32,Default,,0,0,0,,Бір нәрсе төгілді
Dialogue: 0,0:12:27.32,0:12:31.60,Default,,0,0,0,,(Шиозаки) «Кісі өлтіруші» дегенің не?
Dialogue: 0,0:12:31.60,0:12:43.12,Default,,0,0,0,,Жаман адамдар
Dialogue: 0,0:12:43.12,0:12:44.66,Default,,0,0,0,,Жаза
Dialogue: 0,0:12:44.66,0:12:48.76,Default,,0,0,0,,Қасиетті адамның сөзін алу,
Dialogue: 0,0:12:48.76,0:12:50.10,Default,,0,0,0,,Аралау
Dialogue: 0,0:12:50.10,0:12:54.88,Default,,0,0,0,,Мынау
Dialogue: 0,0:12:54.88,0:12:57.76,Default,,0,0,0,,Бұл шайтан емес пе?
Dialogue: 0,0:12:57.76,0:13:01.76,Default,,0,0,0,,Менің атым Фридсельсен
Dialogue: 0,0:13:01.76,0:13:04.56,Default,,0,0,0,,Белгілі бір жын шығару ұйымына жатады.
Dialogue: 0,0:13:04.56,0:13:06.56,Default,,0,0,0,,Оны діни қызметкер ретінде қалдырыңыз
Dialogue: 0,0:13:06.56,0:13:08.28,Default,,0,0,0,,Fr.
Dialogue: 0,0:13:08.28,0:13:12.28,Default,,0,0,0,,Бұл, әрине, шайтандық емес.
Dialogue: 0,0:13:12.28,0:13:14.88,Default,,0,0,0,,Сіз мұны жасадыңыз ба?
Dialogue: 0,0:13:14.88,0:13:18.16,Default,,0,0,0,,Шайтанға төзе білу – адам болып біткендігіңнің дәлелі.
Dialogue: 0,0:13:18.16,0:13:20.04,Default,,0,0,0,,Бұл соңы, ақыры.
Dialogue: 0,0:13:20.04,0:13:23.16,Default,,0,0,0,,Сондықтан мен оны өлтірдім.
Dialogue: 0,0:13:23.16,0:13:27.58,Default,,0,0,0,,Қарғыс атқан шайтан мен қарғыс атқан кальмарды жою
Dialogue: 0,0:13:27.58,0:13:29.58,Default,,0,0,0,,Бұл менің жұмысым.
Dialogue: 0,0:13:29.58,0:13:33.30,Default,,0,0,0,,Жарық қылыш
Dialogue: 0,0:13:33.30,0:13:35.58,Default,,0,0,0,,Бұдан былай бұл жебе сіздің жүрегіңізді қуып келеді.
Dialogue: 0,0:13:35.58,0:13:36.58,Default,,0,0,0,,Бұл адамдарды құтқаруда
Dialogue: 0,0:13:36.58,0:13:38.58,Default,,0,0,0,,Сіздің басыңызға өлімші соққы
Dialogue: 0,0:13:38.58,0:13:41.58,Default,,0,0,0,,Холин любовник
Dialogue: 0,0:13:41.58,0:13:43.58,Default,,0,0,0,,алдау
Dialogue: 0,0:13:43.58,0:13:45.58,Default,,0,0,0,,Сіз үшін
Dialogue: 0,0:13:45.58,0:13:51.58,Default,,0,0,0,,Эксорцист мінездің қалыптылығы
Dialogue: 0,0:13:51.58,0:13:53.58,Default,,0,0,0,,Оның дәмі қандай?
Dialogue: 0,0:13:53.58,0:13:59.58,Default,,0,0,0,,Тек шайтан
Dialogue: 0,0:13:59.58,0:14:03.58,Default,,0,0,0,,Бұл оны жын шығару сияқты сезінеді.
Dialogue: 0,0:14:03.58,0:14:09.58,Default,,0,0,0,,Ой, бұл не деген алдамшы нәрсе?
Dialogue: 0,0:14:09.58,0:14:13.58,Default,,0,0,0,,ең тітіркендіретін нәрсе.
Dialogue: 0,0:14:13.58,0:14:19.58,Default,,0,0,0,,Оня
Dialogue: 0,0:14:19.58,0:14:21.58,Default,,0,0,0,,Әйел Азия-чан
Dialogue: 0,0:14:21.58,0:14:23.58,Default,,0,0,0,,Қызық, тосқауыл қойылды ма?
Dialogue: 0,0:14:23.58,0:14:25.58,Default,,0,0,0,,T-бұл
Dialogue: 0,0:14:25.58,0:14:27.58,Default,,0,0,0,,Дұрыс, дұрыс.
Dialogue: 0,0:14:27.58,0:14:29.58,Default,,0,0,0,,Сіз бастаушы болдыңыз.
Dialogue: 0,0:14:29.58,0:14:31.58,Default,,0,0,0,,Бұл біздің жұмысымыз
Dialogue: 0,0:14:31.58,0:14:33.58,Default,,0,0,0,,Ібілістің ықыласына бөленген пайдасыз адамнан осылай құтыласың.
Dialogue: 0,0:14:33.58,0:14:35.58,Default,,0,0,0,,Сонымен, солай, солай, солай,
Dialogue: 0,0:14:35.58,0:14:38.58,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:14:38.58,0:14:41.58,Default,,0,0,0,,Иссей мырза
Dialogue: 0,0:14:41.58,0:14:42.58,Default,,0,0,0,,Азия
Dialogue: 0,0:14:42.58,0:14:44.58,Default,,0,0,0,,Не?
Dialogue: 0,0:14:44.58,0:14:45.58,Default,,0,0,0,,Сізбен танысу
Dialogue: 0,0:14:45.58,0:14:47.58,Default,,0,0,0,,Неге сен
Dialogue: 0,0:14:47.58,0:14:50.58,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:14:50.58,0:14:51.58,Default,,0,0,0,,Мен
Dialogue: 0,0:14:51.58,0:14:53.58,Default,,0,0,0,,Бұл шайтан
Dialogue: 0,0:14:53.58,0:14:55.58,Default,,0,0,0,,Ібіліс?
Dialogue: 0,0:14:55.58,0:14:56.58,Default,,0,0,0,,Иссей мырза
Dialogue: 0,0:14:56.58,0:14:58.58,Default,,0,0,0,,Мен алдамадым.
Dialogue: 0,0:14:58.58,0:15:00.58,Default,,0,0,0,,Сонда сен кімсің?
Dialogue: 0,0:15:00.58,0:15:02.58,Default,,0,0,0,,Ешқашан кездеспегеніміз жақсы
Dialogue: 0,0:15:02.58,0:15:04.58,Default,,0,0,0,,Мен шешіп қойғанмын
Dialogue: 0,0:15:04.58,0:15:05.58,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:15:05.58,0:15:07.58,Default,,0,0,0,,Кешіріңіз, Асия-чан.
Dialogue: 0,0:15:07.58,0:15:09.58,Default,,0,0,0,,Жындар мен адамдар
Dialogue: 0,0:15:09.58,0:15:11.58,Default,,0,0,0,,Имашии
Dialogue: 0,0:15:11.58,0:15:12.58,Default,,0,0,0,,Одан да біз
Dialogue: 0,0:15:12.58,0:15:14.58,Default,,0,0,0,,Мектептен кейінгі Учитенши-самасыз
Dialogue: 0,0:15:14.58,0:15:15.58,Default,,0,0,0,,Өмір сүрме
Dialogue: 0,0:15:15.58,0:15:17.58,Default,,0,0,0,,Өйткені мен жарымжан адаммын.
Dialogue: 0,0:15:17.58,0:15:19.58,Default,,0,0,0,,Періште
Dialogue: 0,0:15:19.58,0:15:20.58,Default,,0,0,0,,♪ Ка-та-на
Dialogue: 0,0:15:20.58,0:15:22.58,Default,,0,0,0,,Бір сәт жұмысымды аяқтауға рұқсат етіңіз.
Dialogue: 0,0:15:22.58,0:15:24.58,Default,,0,0,0,,Дайынсың ба?
Dialogue: 0,0:15:24.58,0:15:26.58,Default,,0,0,0,,Сіз онсыз жүре аласыз
Dialogue: 0,0:15:26.58,0:15:32.58,Default,,0,0,0,,Азия
Dialogue: 0,0:15:32.58,0:15:33.58,Default,,0,0,0,,Эй, шын айтасың ба?
Dialogue: 0,0:15:33.58,0:15:35.58,Default,,0,0,0,,Ата Кред, өтінемін.
Dialogue: 0,0:15:35.58,0:15:37.58,Default,,0,0,0,,Бұл адамды кешіріңіз.
Dialogue: 0,0:15:37.58,0:15:39.58,Default,,0,0,0,,Өтінемін, жіберіп алмаңыз
Dialogue: 0,0:15:39.58,0:15:44.58,Default,,0,0,0,,Сіз не істеп жатқаныңызды білесіз бе?
Dialogue: 0,0:15:44.58,0:15:46.58,Default,,0,0,0,,Шайтан болса да
Dialogue: 0,0:15:46.58,0:15:47.58,Default,,0,0,0,,Иссей-сан жақсы адам.
Dialogue: 0,0:15:47.58,0:15:49.58,Default,,0,0,0,,Және бұл
Dialogue: 0,0:15:49.58,0:15:52.58,Default,,0,0,0,,Жаратқан Ие мені кешірмейді
Dialogue: 0,0:15:52.58,0:15:54.58,Default,,0,0,0,,Ааа
Dialogue: 0,0:15:54.58,0:15:56.58,Default,,0,0,0,,Сонша ақымақ болма
Dialogue: 0,0:15:56.58,0:16:00.58,Default,,0,0,0,,Ааа
Dialogue: 0,0:16:00.58,0:16:01.58,Default,,0,0,0,,Жарайды
Dialogue: 0,0:16:01.58,0:16:02.58,Default,,0,0,0,,Азия
Dialogue: 0,0:16:02.58,0:16:04.58,Default,,0,0,0,,Мына қарғыс атқан Анна
Dialogue: 0,0:16:04.58,0:16:07.58,Default,,0,0,0,,Сіздің басыңызда құрт жоқ па?
Dialogue: 0,0:16:07.58,0:16:09.58,Default,,0,0,0,,Ааа
Dialogue: 0,0:16:09.58,0:16:10.58,Default,,0,0,0,,Жарайды
Dialogue: 0,0:16:10.58,0:16:14.58,Default,,0,0,0,,Періште апа оны ренжітпеуімді ескертіп тұр.
Dialogue: 0,0:16:14.58,0:16:18.58,Default,,0,0,0,,Менің ойымша, бұл аздап жазалау керек.
Dialogue: 0,0:16:18.58,0:16:20.58,Default,,0,0,0,,Ааа
Dialogue: 0,0:16:20.58,0:16:22.58,Default,,0,0,0,,Жарайды
Dialogue: 0,0:16:22.58,0:16:24.58,Default,,0,0,0,,А
Dialogue: 0,0:16:24.58,0:16:28.58,Default,,0,0,0,,Мінсіз апаны аспазшы ауыр жарақаттады.
Dialogue: 0,0:16:28.58,0:16:30.58,Default,,0,0,0,,Бұл сәл жақсырақ.
Dialogue: 0,0:16:30.58,0:16:32.58,Default,,0,0,0,,Ааа
Dialogue: 0,0:16:32.58,0:16:33.58,Default,,0,0,0,,Тоқта
Dialogue: 0,0:16:33.58,0:16:38.58,Default,,0,0,0,,А
Dialogue: 0,0:16:38.58,0:16:39.58,Default,,0,0,0,,Отта
Dialogue: 0,0:16:39.58,0:16:41.58,Default,,0,0,0,,Тегін сұраудан аулақ болыңыз.
Dialogue: 0,0:16:41.58,0:16:42.58,Default,,0,0,0,,Тапсырыс беруші
Dialogue: 0,0:16:42.58,0:16:50.58,Default,,0,0,0,,А
Dialogue: 0,0:16:51.58,0:16:52.58,Default,,0,0,0,,А
Dialogue: 0,0:16:52.58,0:16:53.88,Default,,0,0,0,,Сіз ауырып өлесіз!
Dialogue: 0,0:16:53.88,0:16:55.04,Default,,0,0,0,,Иә! Жоқ!
Dialogue: 0,0:16:55.76,0:16:57.08,Default,,0,0,0,,Жеңіске жету мүмкіндігі жоқ
Dialogue: 0,0:16:57.08,0:17:00.72,Default,,0,0,0,,Мүмкін мен өлетін шығармын
Dialogue: 0,0:17:00.72,0:17:04.52,Default,,0,0,0,,Мені қорғаған мына қыздың алдында
Dialogue: 0,0:17:04.52,0:17:07.26,Default,,0,0,0,,Қашудың қажеті жоқ
Dialogue: 0,0:17:07.26,0:17:10.18,Default,,0,0,0,,Ой!
Dialogue: 0,0:17:15.28,0:17:17.18,Default,,0,0,0,,Бұл қызық.
Dialogue: 0,0:17:17.18,0:17:19.88,Default,,0,0,0,,Етті қанша қашықтықта кесуге болады?
Dialogue: 0,0:17:19.88,0:17:23.08,Default,,0,0,0,,Әлемдік рекордты сынаймыз ба?
Dialogue: 0,0:17:23.08,0:17:31.76,Default,,0,0,0,,Сиқырлы
Dialogue: 0,0:17:31.76,0:17:36.26,Default,,0,0,0,,Гиодон-кун
Dialogue: 0,0:17:36.26,0:17:37.64,Default,,0,0,0,,Мен көмектесуге келдім.
Dialogue: 0,0:17:37.64,0:17:39.36,Default,,0,0,0,,О, құдай!
Dialogue: 0,0:17:39.36,0:17:41.24,Default,,0,0,0,,Бұл қиын, солай емес пе?
Dialogue: 0,0:17:41.24,0:17:42.74,Default,,0,0,0,,Эксорцист
Dialogue: 0,0:17:42.74,0:17:44.00,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:17:44.00,0:17:48.24,Default,,0,0,0,,Ібіліс ұйымының келуі
Dialogue: 0,0:17:48.24,0:17:49.86,Default,,0,0,0,,Жаман емес.
Dialogue: 0,0:17:49.86,0:17:51.86,Default,,0,0,0,,Ол біздің біріміз
Dialogue: 0,0:17:51.86,0:17:55.00,Default,,0,0,0,,О, бұл жақсы.
Dialogue: 0,0:17:55.00,0:17:56.46,Default,,0,0,0,,Сізге не керек?
Dialogue: 0,0:17:56.46,0:17:58.38,Default,,0,0,0,,Сіз оны кінәлайсыз және бұл оған ұнайды
Dialogue: 0,0:17:58.38,0:18:01.24,Default,,0,0,0,,Оның аузы дөрекі болғандықтан, оның діни қызметкер екеніне сене алар емеспін.
Dialogue: 0,0:18:01.24,0:18:03.18,Default,,0,0,0,,Класс жасама, қарғыс атқан шайтан.
Dialogue: 0,0:18:03.18,0:18:05.44,Default,,0,0,0,,Қарғыс атқыр қожайынды аулай алмайсың.
Dialogue: 0,0:18:05.44,0:18:06.68,Default,,0,0,0,,Бұл менің өмірдегі мақсатым
Dialogue: 0,0:18:06.68,0:18:09.46,Default,,0,0,0,,Үніңді жап, сені өлтіруге рұқсат ет.
Dialogue: 0,0:18:09.46,0:18:12.36,Default,,0,0,0,,Тіпті шайтанның өзі жар таңдайды.
Dialogue: 0,0:18:12.36,0:18:14.52,Default,,0,0,0,,Ақырында, сол ыстық көзқарас
Dialogue: 0,0:18:14.52,0:18:16.52,Default,,0,0,0,,А, бұл махаббат пен кісі өлтіру ниеті
Dialogue: 0,0:18:16.52,0:18:20.66,Default,,0,0,0,,Адам өлтіру ниетін бағыттау немесе соған бағыттау төзгісіз.
Dialogue: 0,0:18:20.66,0:18:22.02,Default,,0,0,0,,Олай болса, оны сүртіңіз.
Dialogue: 0,0:18:22.02,0:18:28.60,Default,,0,0,0,,Менің сүйкімді Гаго-куным
Dialogue: 0,0:18:28.60,0:18:30.52,Default,,0,0,0,,Сіз маған қамқор болған сияқтысыз.
Dialogue: 0,0:18:30.52,0:18:31.52,Default,,0,0,0,,Менеджер
Dialogue: 0,0:18:31.52,0:18:34.40,Default,,0,0,0,,Бұл да тәңірлік аяушылық.
Dialogue: 0,0:18:34.40,0:18:36.80,Default,,0,0,0,,Иә, мен сені сүйдім, бірақ
Dialogue: 0,0:18:36.80,0:18:37.72,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:18:37.72,0:18:38.60,Default,,0,0,0,,Жарайды
Dialogue: 0,0:18:38.60,0:18:39.44,Default,,0,0,0,,Иссей
Dialogue: 0,0:18:39.44,0:18:41.24,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:18:41.24,0:18:43.52,Default,,0,0,0,,Жаңа ғана ұрысып қалсам да
Dialogue: 0,0:18:43.52,0:18:45.38,Default,,0,0,0,,Мен мұны қайтадан жасадым.
Dialogue: 0,0:18:45.38,0:18:47.52,Default,,0,0,0,,Мен қатты қиналдым.
Dialogue: 0,0:18:47.52,0:18:50.32,Default,,0,0,0,,Жоқ—сол қолымды пайдаланбай-ақ ең үздікке айналу арқылы—
Dialogue: 0,0:18:50.32,0:18:53.52,Default,,0,0,0,,Гагре эксорцист осында болды.
Dialogue: 0,0:18:53.52,0:18:56.92,Default,,0,0,0,,Осы уақытқа дейін тосқауыл қойылды.
Dialogue: 0,0:18:56.92,0:18:58.20,Default,,0,0,0,,Мен байқамадым
Dialogue: 0,0:18:58.20,0:19:01.02,Default,,0,0,0,,Не істеп жатырсың, қарғыс атқан шайтан?
Dialogue: 0,0:19:01.02,0:19:03.18,Default,,0,0,0,,Кедергі – белгісіз жұмыс.
Dialogue: 0,0:19:03.18,0:19:04.44,Default,,0,0,0,,Орындаңыз
Dialogue: 0,0:19:04.44,0:19:08.24,Default,,0,0,0,,Өйткені мен қызметшімді ренжіттім
Dialogue: 0,0:19:08.24,0:19:10.76,Default,,0,0,0,,Мен бұған ешқашан жол бермеймін деп шештім.
Dialogue: 0,0:19:10.76,0:19:14.56,Default,,0,0,0,,Әсіресе сіз сияқты жаман адамға.
Dialogue: 0,0:19:14.56,0:19:17.06,Default,,0,0,0,,Кім өз мүлкіне зиян келтіруі мүмкін?
Dialogue: 0,0:19:17.06,0:19:18.80,Default,,0,0,0,,Мен бұған шыдай алмаймын
Dialogue: 0,0:19:18.80,0:19:20.04,Default,,0,0,0,,Қосымша
Dialogue: 0,0:19:20.04,0:19:22.14,Default,,0,0,0,,Бұл қуат жақсы емес.
Dialogue: 0,0:19:22.14,0:19:24.30,Default,,0,0,0,,Бір күні бұл өте нашар болады
Dialogue: 0,0:19:24.30,0:19:26.74,Default,,0,0,0,,Көптеген өлі нүктелер
Dialogue: 0,0:19:26.74,0:19:30.26,Default,,0,0,0,,Толқынды бұрма
Dialogue: 0,0:19:30.26,0:19:31.38,Default,,0,0,0,,Барлығы бірге
Dialogue: 0,0:19:31.38,0:19:32.66,Default,,0,0,0,,Жарық көрінісін анықтау
Dialogue: 0,0:19:32.66,0:19:34.08,Default,,0,0,0,,Менеджер
Dialogue: 0,0:19:34.08,0:19:37.38,Default,,0,0,0,,Дәл қазір Иссейдің сауығуы бірінші орында тұр.
Dialogue: 0,0:19:37.38,0:19:39.14,Default,,0,0,0,,Таңертеңгілік секіруге дайындалу
Dialogue: 0,0:19:39.14,0:19:39.84,Default,,0,0,0,,Иә
Dialogue: 0,0:19:39.84,0:19:42.42,Default,,0,0,0,,Конеко Иссейден сұрайды
Dialogue: 0,0:19:42.42,0:19:43.70,Default,,0,0,0,,Иә
Dialogue: 0,0:19:43.70,0:19:45.46,Default,,0,0,0,,Шайтанды қарғыс атсын
Dialogue: 0,0:19:45.46,0:19:46.48,Default,,0,0,0,,Мен сізге қашуға рұқсат бердім.
Dialogue: 0,0:19:46.48,0:19:46.98,Default,,0,0,0,,Отатата
Dialogue: 0,0:19:46.98,0:19:47.86,Default,,0,0,0,,Б-Бірақ соншама Титан бар кезде адамды көтеріп ұшу…
Dialogue: 0,0:19:52.14,0:19:57.36,Default,,0,0,0,,Менеджер
Dialogue: 0,0:19:57.36,0:19:59.42,Default,,0,0,0,,Амоко да
Dialogue: 0,0:19:59.42,0:20:00.98,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:20:00.98,0:20:02.46,Default,,0,0,0,,Бұл сиқырлы құдай
Dialogue: 0,0:20:02.46,0:20:05.46,Default,,0,0,0,,Менің қол астындағылар ғана секіре алады.
Dialogue: 0,0:20:05.46,0:20:06.58,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:20:06.58,0:20:08.74,Default,,0,0,0,,Сиқырлы Құдай
Dialogue: 0,0:20:08.74,0:20:09.86,Default,,0,0,0,,Босатыңыз
Dialogue: 0,0:20:09.86,0:20:11.48,Default,,0,0,0,,Эшке көмектес
Dialogue: 0,0:20:11.48,0:20:12.46,Default,,0,0,0,,Босатыңыз
Dialogue: 0,0:20:12.46,0:20:13.86,Default,,0,0,0,,Эш
Dialogue: 0,0:20:13.86,0:20:15.50,Default,,0,0,0,,Иссей мырза
Dialogue: 0,0:20:15.50,0:20:16.38,Default,,0,0,0,,Сондай-ақ
Dialogue: 0,0:20:16.38,0:20:18.74,Default,,0,0,0,,Бір күні кездескенше
Dialogue: 0,0:20:18.74,0:20:20.52,Default,,0,0,0,,Бір жерде
Dialogue: 0,0:20:20.52,0:20:21.74,Default,,0,0,0,,Сиқырлы Құдай
Dialogue: 0,0:20:21.74,0:20:22.74,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:20:22.74,0:20:28.52,Default,,0,0,0,,Тыныш болыңыз
Dialogue: 0,0:20:28.52,0:20:29.52,Default,,0,0,0,,Киана
Dialogue: 0,0:20:29.52,0:20:30.58,Default,,0,0,0,,Ой
Dialogue: 0,0:20:30.58,0:20:31.86,Default,,0,0,0,,Келгеніңіз үшін рахмет.
Dialogue: 0,0:20:31.86,0:20:33.66,Default,,0,0,0,,Атчерлер
Dialogue: 0,0:20:33.66,0:20:34.46,Default,,0,0,0,,Иә
Dialogue: 0,0:20:34.46,0:20:36.18,Default,,0,0,0,,Бұл кездесу
Dialogue: 0,0:20:36.18,0:20:38.26,Default,,0,0,0,,Бүгінгі күн үшін ғана маңызды
Dialogue: 0,0:20:38.26,0:20:39.92,Default,,0,0,0,,Мен достарымды қорғай алмаймын
Dialogue: 0,0:20:39.92,0:20:40.96,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:20:40.96,0:20:42.96,Default,,0,0,0,,Қарағаныңызға рахмет
Dialogue: 0,0:20:44.46,0:20:49.46,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
