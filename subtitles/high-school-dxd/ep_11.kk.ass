Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:07.00,Default,,0,0,0,,Қиямет! Ризер патшайымы! Кешіріңіз
Dialogue: 0,0:00:07.00,0:00:09.00,Default,,0,0,0,,Конеко-чан!
Dialogue: 0,0:00:09.00,0:00:11.00,Default,,0,0,0,,Менеджер ретінде тезірек
Dialogue: 0,0:00:11.00,0:00:15.00,Default,,0,0,0,,Жарайды! Асия бұл жарақатынан жақын арада айығады.
Dialogue: 0,0:00:15.00,0:00:19.00,Default,,0,0,0,,Конеко-чан! Конеко!
Dialogue: 0,0:00:30.00,0:00:34.00,Default,,0,0,0,,Бір Риас-сама роки зейнетке шықты
Dialogue: 0,0:00:34.00,0:00:37.00,Default,,0,0,0,,Қат! Жақсы жұмыс Конеко-чан!
Dialogue: 0,0:00:37.00,0:00:39.00,Default,,0,0,0,,Түсіңіз! Мен сенің қарсыласыңмын!
Dialogue: 0,0:00:39.00,0:00:41.00,Default,,0,0,0,,Тынышталыңыз
Dialogue: 0,0:00:41.00,0:00:43.00,Default,,0,0,0,,Күресуге қабілетсіздер
Dialogue: 0,0:00:43.00,0:00:45.00,Default,,0,0,0,,Ұрысу керек жерге ауыстырылды
Dialogue: 0,0:00:45.00,0:00:47.00,Default,,0,0,0,,Кім емделеді?
Dialogue: 0,0:00:47.00,0:00:49.00,Default,,0,0,0,,Конеко өлген жоқ.
Dialogue: 0,0:00:49.00,0:00:51.00,Default,,0,0,0,,Сабырлы болыңыз
Dialogue: 0,0:00:51.00,0:00:52.00,Default,,0,0,0,,Бірақ!
Dialogue: 0,0:00:52.00,0:00:53.00,Default,,0,0,0,,Бас тарту ұяшықтары
Dialogue: 0,0:00:53.00,0:00:55.00,Default,,0,0,0,,Қанша күрессек те, біз
Dialogue: 0,0:00:55.00,0:00:57.00,Default,,0,0,0,,Сіз жеңе алмайсыз.
Dialogue: 0,0:00:57.00,0:00:59.00,Default,,0,0,0,,О, құдай!
Dialogue: 0,0:00:59.00,0:01:00.00,Default,,0,0,0,,Акено мырза!
Dialogue: 0,0:01:00.00,0:01:01.00,Default,,0,0,0,,Иссей-кун
Dialogue: 0,0:01:01.00,0:01:04.00,Default,,0,0,0,,Бұны маған қалдыр да, тезірек.
Dialogue: 0,0:01:04.00,0:01:07.00,Default,,0,0,0,,Уайымдамаңыз.
Dialogue: 0,0:01:07.00,0:01:09.00,Default,,0,0,0,,Бар жан-тәніммен
Dialogue: 0,0:01:09.00,0:01:11.00,Default,,0,0,0,,Мен Конеко-чаннан кек аламын.
Dialogue: 0,0:01:11.00,0:01:14.00,Default,,0,0,0,,Түсінікті! Акено мырза!
Dialogue: 0,0:01:14.00,0:01:17.00,Default,,0,0,0,,Мен сенімен бір рет ұрысқым келді
Dialogue: 0,0:01:17.00,0:01:19.00,Default,,0,0,0,,Номика Иказучи
Dialogue: 0,0:01:19.00,0:01:20.00,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,0:01:20.00,0:01:22.00,Default,,0,0,0,,Бұл құрмет болар еді.
Dialogue: 0,0:01:22.00,0:01:24.00,Default,,0,0,0,,Бомба ханшайымы
Dialogue: 0,0:01:26.00,0:01:28.00,Default,,0,0,0,,Райзер мырзаның хабарламасы
Dialogue: 0,0:01:28.00,0:01:29.00,Default,,0,0,0,,Самре
Dialogue: 0,0:01:29.00,0:01:30.00,Default,,0,0,0,,Ретиллер
Dialogue: 0,0:01:30.00,0:01:31.00,Default,,0,0,0,,Үш адам!
Dialogue: 0,0:01:31.00,0:01:32.00,Default,,0,0,0,,Не!
Dialogue: 0,0:01:32.00,0:01:33.00,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:34.00,0:01:35.00,Default,,0,0,0,,Сәлем
Dialogue: 0,0:01:35.00,0:01:36.00,Default,,0,0,0,,Сіз бе!
Dialogue: 0,0:01:36.00,0:01:38.00,Default,,0,0,0,,А, қазір үшеуміз.
Dialogue: 0,0:01:38.00,0:01:40.00,Default,,0,0,0,,Әкеноның күйреуінің арқасында
Dialogue: 0,0:01:40.00,0:01:41.00,Default,,0,0,0,,Бұл өте оңай келді.
Dialogue: 0,0:01:41.00,0:01:45.00,Default,,0,0,0,,Енді қалған кадрлар
Dialogue: 0,0:01:45.00,0:01:47.00,Default,,0,0,0,,Разер-сама - 9
Dialogue: 0,0:01:47.00,0:01:49.00,Default,,0,0,0,,Риас-сама 5-ке айналды.
Dialogue: 0,0:01:49.00,0:01:51.00,Default,,0,0,0,,Әзірге ешқандай болжам жасай алмаймыз.
Dialogue: 0,0:01:51.00,0:01:53.00,Default,,0,0,0,,Киба жаман
Dialogue: 0,0:01:53.00,0:01:54.00,Default,,0,0,0,,Котенка
Dialogue: 0,0:01:54.00,0:01:55.00,Default,,0,0,0,,Мен оны естідім.
Dialogue: 0,0:01:55.00,0:01:58.00,Default,,0,0,0,,Көп көрсетпейтін баламын.
Dialogue: 0,0:01:58.00,0:02:00.00,Default,,0,0,0,,Мен бүгін қатты толқыдым.
Dialogue: 0,0:02:00.00,0:02:02.00,Default,,0,0,0,,Бұл ұят болса керек.
Dialogue: 0,0:02:02.00,0:02:04.00,Default,,0,0,0,,Жеңіске жетейік
Dialogue: 0,0:02:04.00,0:02:05.00,Default,,0,0,0,,(Ватару) Бұл жігіт суға түсе алмайды! (Цубаки) Косэй!
Dialogue: 0,0:02:05.00,0:02:10.00,Default,,0,0,0,,Әрине, білемін.
Dialogue: 0,0:02:11.00,0:02:14.00,Default,,0,0,0,,Юто, Иссей, сен мені естисің бе?
Dialogue: 0,0:02:14.00,0:02:17.00,Default,,0,0,0,,Мен Азияға және негізгі лагерьге тосын шабуыл жасаймын.
Dialogue: 0,0:02:17.00,0:02:20.00,Default,,0,0,0,,Мүмкіндігінше көп жау тарту арқылы уақытты ұтыңыз.
Dialogue: 0,0:02:20.00,0:02:21.00,Default,,0,0,0,,Тосын шабуыл?
Dialogue: 0,0:02:21.00,0:02:23.00,Default,,0,0,0,,Бұл сөзсіз.
Dialogue: 0,0:02:23.00,0:02:25.00,Default,,0,0,0,,Акеноның сауығып кетуін күту
Dialogue: 0,0:02:25.00,0:02:27.00,Default,,0,0,0,,Мен Какконы жоюды жоспарладым.
Dialogue: 0,0:02:27.00,0:02:30.00,Default,,0,0,0,,Жаудың патшайыммен тікелей соққыға түсуіне жол берме.
Dialogue: 0,0:02:30.00,0:02:32.00,Default,,0,0,0,,Дегенмен, директор
Dialogue: 0,0:02:32.00,0:02:33.00,Default,,0,0,0,,Король негізгі лагерьден шыққанда
Dialogue: 0,0:02:33.00,0:02:35.00,Default,,0,0,0,,Тәуекел тым үлкен.
Dialogue: 0,0:02:35.00,0:02:37.00,Default,,0,0,0,,Жау да солай ойлайтын.
Dialogue: 0,0:02:37.00,0:02:39.00,Default,,0,0,0,,Бұл мақсат
Dialogue: 0,0:02:39.00,0:02:42.00,Default,,0,0,0,,Феникстің денесі қанша өлмейтін болса да,
Dialogue: 0,0:02:42.00,0:02:44.00,Default,,0,0,0,,Тіпті жүрек те емес
Dialogue: 0,0:02:44.00,0:02:47.00,Default,,0,0,0,,Егер сіз біреуге қатты шабуыл жасасаңыз, оның шайқасуға деген ықыласын жоғалтыңыз,
Dialogue: 0,0:02:47.00,0:02:49.00,Default,,0,0,0,,Ризерді жеңуге болады
Dialogue: 0,0:02:49.00,0:02:54.00,Default,,0,0,0,,Мен Ризердің жүрегін жаралаймын.
Dialogue: 0,0:02:54.00,0:02:56.00,Default,,0,0,0,,Егер солай шешілсе
Dialogue: 0,0:02:56.00,0:02:59.00,Default,,0,0,0,,Оккульттік зерттеу клубының ерлер дуэті
Dialogue: 0,0:02:59.00,0:03:01.00,Default,,0,0,0,,Сіз жарқырайсыз ба?
Dialogue: 0,0:03:04.00,0:03:07.00,Default,,0,0,0,,Сәлем! Сіз бәрібір жасырынып жүрген болуыңыз керек!
Dialogue: 0,0:03:07.00,0:03:09.00,Default,,0,0,0,,Әділ және әділ күрес!
Dialogue: 0,0:03:16.00,0:03:18.00,Default,,0,0,0,,Мен Ризер-сама қолдана алатын рыцарьмын.
Dialogue: 0,0:03:18.00,0:03:20.00,Default,,0,0,0,,Бұл Карамин.
Dialogue: 0,0:03:20.00,0:03:22.00,Default,,0,0,0,,Майданнан сенімді шығу, т.б.
Dialogue: 0,0:03:22.00,0:03:24.00,Default,,0,0,0,,түн
Dialogue: 0,0:03:24.00,0:03:25.00,Default,,0,0,0,,Бірақ
Dialogue: 0,0:03:25.00,0:03:28.00,Default,,0,0,0,,Мен сен сияқты ақымақтарды жақсы көремін.
Dialogue: 0,0:03:28.00,0:03:30.00,Default,,0,0,0,,Мен Риас-сама қолдана алатын рыцарьмын.
Dialogue: 0,0:03:30.00,0:03:32.00,Default,,0,0,0,,Кибают
Dialogue: 0,0:03:32.00,0:03:34.00,Default,,0,0,0,,Рыцарлар арасындағы шайқас
Dialogue: 0,0:03:34.00,0:03:36.00,Default,,0,0,0,,Мен оны көптен күттім.
Dialogue: 0,0:03:36.00,0:03:38.00,Default,,0,0,0,,Жақсы айтылған.
Dialogue: 0,0:03:38.00,0:03:40.00,Default,,0,0,0,,Риас Греморидің рыцары
Dialogue: 0,0:03:40.00,0:03:42.00,Default,,0,0,0,,Ах, сенің халқың
Dialogue: 0,0:03:42.00,0:03:44.00,Default,,0,0,0,,Риас Греморидің рыцары
Dialogue: 0,0:03:44.00,0:03:52.00,Default,,0,0,0,,Уф!
Dialogue: 0,0:03:52.00,0:03:54.54,Default,,0,0,0,,Бірақ менің беркакуным сенің беркакуның
Dialogue: 0,0:03:54.54,0:03:56.22,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:03:56.22,0:04:02.40,Default,,0,0,0,,Караминнің басы қылыш пен қылышқа толы.
Dialogue: 0,0:04:02.40,0:04:06.38,Default,,0,0,0,,Ол бір кесекті құрбан етуге құлықсыз көрінді.
Dialogue: 0,0:04:06.38,0:04:08.40,Default,,0,0,0,,Егер ол толығымен кір болса
Dialogue: 0,0:04:08.40,0:04:12.40,Default,,0,0,0,,Оның үстіне, мен сүйкімді қыз таптым деп ойлаған кезде,
Dialogue: 0,0:04:12.40,0:04:15.14,Default,,0,0,0,,Сендер де қылыш ақымақсыңдар.
Dialogue: 0,0:04:15.14,0:04:18.40,Default,,0,0,0,,Мүлде жоқ.
Dialogue: 0,0:04:18.40,0:04:23.24,Default,,0,0,0,,Сонымен, сіз барлық қалған бөліктерді салдыңыз ба?
Dialogue: 0,0:04:23.24,0:04:26.08,Default,,0,0,0,,Менеджердің оқуы дұрыс болды.
Dialogue: 0,0:04:26.08,0:04:30.88,Default,,0,0,0,,Қалай болғанда да, Риас-сама
Dialogue: 0,0:04:30.88,0:04:34.14,Default,,0,0,0,,Қызық, мырзаның талғамы нашар ма?
Dialogue: 0,0:04:34.14,0:04:36.70,Default,,0,0,0,,Оның жүзі сүйкімді, мінезі ерекше.
Dialogue: 0,0:04:36.70,0:04:38.56,Default,,0,0,0,,Көк қорқу
Dialogue: 0,0:04:38.56,0:04:41.56,Default,,0,0,0,,Кешіріңіз, ойнауға рұқсат етіңіз.
Dialogue: 0,0:04:41.56,0:04:43.72,Default,,0,0,0,,Мен ұрыспаймын
Dialogue: 0,0:04:43.72,0:04:45.94,Default,,0,0,0,,Изабелла
Dialogue: 0,0:04:45.94,0:04:50.46,Default,,0,0,0,,Мен Изабелламын
Dialogue: 0,0:04:50.46,0:04:53.32,Default,,0,0,0,,Бұл Ризер-сама пайдаланған ілмек.
Dialogue: 0,0:04:53.32,0:04:55.10,Default,,0,0,0,,Кеттік.
Dialogue: 0,0:04:55.10,0:04:56.70,Default,,0,0,0,,Риас Гремори
Dialogue: 0,0:04:56.70,0:04:57.32,Default,,0,0,0,,Сәлем
Dialogue: 0,0:04:57.32,0:04:59.74,Default,,0,0,0,,Эй
Dialogue: 0,0:04:59.74,0:05:01.36,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:05:01.36,0:05:03.72,Default,,0,0,0,,Ұрыспас дегенді қалай түсінесіңдер?
Dialogue: 0,0:05:03.72,0:05:05.78,Default,,0,0,0,,Ол епископ ретінде қатысқанымен.
Dialogue: 0,0:05:05.78,0:05:08.20,Default,,0,0,0,,Толық дерлік
Dialogue: 0,0:05:08.20,0:05:09.16,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:05:09.16,0:05:10.08,Default,,0,0,0,,Дәптерді ұстап тұрған адамға тек өлтірмекші болған адамның ғұмырлық мерзімін көру жеткілікті
Dialogue: 0,0:05:10.08,0:05:12.58,Default,,0,0,0,,Артқысы - Рэйбел Феникс
Dialogue: 0,0:05:12.58,0:05:13.68,Default,,0,0,0,,Феникс
Dialogue: 0,0:05:13.68,0:05:15.86,Default,,0,0,0,,Қылыш тайпасы шайтан дейді.
Dialogue: 0,0:05:15.86,0:05:18.62,Default,,0,0,0,,Ол Рисер-саманың қарындасына ұқсайды.
Dialogue: 0,0:05:18.62,0:05:19.12,Default,,0,0,0,,Әпке
Dialogue: 0,0:05:19.12,0:05:23.64,Default,,0,0,0,,Қараңызшы, оны Мо апа деп атайды.
Dialogue: 0,0:05:23.64,0:05:26.90,Default,,0,0,0,,Мен сүйетін, қызғанатын адамдар көп.
Dialogue: 0,0:05:26.90,0:05:29.32,Default,,0,0,0,,Жарайды, мен Мое қарындасы емеспін.
Dialogue: 0,0:05:29.32,0:05:32.32,Default,,0,0,0,,Пішін - қылыш тайпасы жын.
Dialogue: 0,0:05:32.32,0:05:33.84,Default,,0,0,0,,Бұл Дано.
Dialogue: 0,0:05:33.84,0:05:34.34,Default,,0,0,0,,Иә.
Dialogue: 0,0:05:34.32,0:05:35.58,Default,,0,0,0,,Әлгі құс жігіт
Dialogue: 0,0:05:35.58,0:05:38.06,Default,,0,0,0,,Ол шынымен бұзық және ақымақ болды ма?
Dialogue: 0,0:05:38.06,0:05:41.06,Default,,0,0,0,,Бірақ сіз қарындасыңызды гареміңізге қосқыңыз келе ме?
Dialogue: 0,0:05:41.06,0:05:42.70,Default,,0,0,0,,Мен толық түсінемін.
Dialogue: 0,0:05:42.70,0:05:45.42,Default,,0,0,0,,Сіз мен ойлағаннан да жақсы жұмыс істеп жатқан сияқтысыз.
Dialogue: 0,0:05:45.42,0:05:46.14,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:05:46.14,0:05:48.38,Default,,0,0,0,,Менің де котенка қуыратын жерім бар.
Dialogue: 0,0:05:48.38,0:05:50.10,Default,,0,0,0,,Менің ойымша, ол жаттығады.
Dialogue: 0,0:05:50.10,0:05:53.82,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:05:53.82,0:05:55.70,Default,,0,0,0,,Белгілі бір деңгейден жоғары қуат алғанша
Dialogue: 0,0:05:55.70,0:05:56.98,Default,,0,0,0,,Тек қашу мағынасында
Dialogue: 0,0:05:56.98,0:06:01.56,Default,,0,0,0,,Бұл 5-ші қуат қосу
Dialogue: 0,0:06:01.56,0:06:04.02,Default,,0,0,0,,Ломкадағы қарсылас үшін жеткілікті болуы мүмкін
Dialogue: 0,0:06:04.02,0:06:05.32,Default,,0,0,0,,Лұқаға қарсы
Dialogue: 0,0:06:05.32,0:06:07.24,Default,,0,0,0,,Хо
Dialogue: 0,0:06:07.24,0:06:10.80,Default,,0,0,0,,Мира мені алып кеткен кездегіден мүлде басқа.
Dialogue: 0,0:06:10.80,0:06:14.40,Default,,0,0,0,,Риас Гремори жақсы дайындалған сияқты.
Dialogue: 0,0:06:14.40,0:06:15.38,Default,,0,0,0,,Иә.
Dialogue: 0,0:06:15.38,0:06:18.16,Default,,0,0,0,,Менеджер мені жан-жақты оқытты.
Dialogue: 0,0:06:18.16,0:06:20.06,Default,,0,0,0,,Директор Риастың қызметшісі.
Dialogue: 0,0:06:20.06,0:06:22.20,Default,,0,0,0,,Сондықтан мен жеңіле алмаймын
Dialogue: 0,0:06:22.20,0:06:25.78,Default,,0,0,0,,Менеджер үшін мен Сыртқыды жеңемін.
Dialogue: 0,0:06:25.78,0:06:31.34,Default,,0,0,0,,Дұрыс. Менің Стэндім, «Close-up», қазір тіліңе жалғанған
Dialogue: 0,0:06:31.34,0:06:36.74,Default,,0,0,0,,Құрметті Риас
Dialogue: 0,0:06:36.74,0:06:39.88,Default,,0,0,0,,Холли лазері
Dialogue: 0,0:06:39.88,0:06:43.60,Default,,0,0,0,,Өкінішке орай, бұл шабуыл маған әсер етпейді.
Dialogue: 0,0:06:43.60,0:06:45.30,Default,,0,0,0,,Сонда бұл туралы не деуге болады?
Dialogue: 0,0:06:45.30,0:06:46.30,Default,,0,0,0,,Осы мектепті бітіру – шеберліктің дәлелі.
Dialogue: 0,0:06:46.30,0:06:51.84,Default,,0,0,0,,Кисаманың екі қасиетті берілістері бар
Dialogue: 0,0:06:51.84,0:06:56.98,Default,,0,0,0,,Не
Dialogue: 0,0:06:56.98,0:07:02.70,Default,,0,0,0,,Біз, мақтаншақ Феникс данышпандары, отты қалқандарымыз бен өмірімізді пайдаландық.
Dialogue: 0,0:07:02.70,0:07:05.44,Default,,0,0,0,,Жоғалыңыз!
Dialogue: 0,0:07:05.44,0:07:07.76,Default,,0,0,0,,Хун
Dialogue: 0,0:07:07.76,0:07:12.80,Default,,0,0,0,,Га
Dialogue: 0,0:07:12.80,0:07:14.08,Default,,0,0,0,,Бұл
Dialogue: 0,0:07:14.08,0:07:17.58,Default,,0,0,0,,Сізде қанша велосипед құралы бар?
Dialogue: 0,0:07:17.98,0:07:20.98,Default,,0,0,0,,Менде бірнеше велосипед дулығалары жоқ.
Dialogue: 0,0:07:21.48,0:07:22.98,Default,,0,0,0,,Жаңа ғана жасадым.
Dialogue: 0,0:07:23.68,0:07:25.68,Default,,0,0,0,,Сиқырлы қылыш жасау Қылышверс
Dialogue: 0,0:07:26.38,0:07:27.18,Default,,0,0,0,,Яғни
Dialogue: 0,0:07:28.08,0:07:29.18,Default,,0,0,0,,Тас көшеде
Dialogue: 0,0:07:29.78,0:07:31.18,Default,,0,0,0,,Сиқырлы қылыш жасай алады
Dialogue: 0,0:07:33.08,0:07:33.88,Default,,0,0,0,,Ей, көмектес! Оның алдыңғы тістерін жұлып ал—мен оларды тіс дәрігеріне апарамын!
Dialogue: 0,0:07:34.18,0:07:35.68,Default,,0,0,0,,Біз тез әрекет етуіміз керек
Dialogue: 0,0:07:36.28,0:07:38.38,Default,,0,0,0,,Оның мұндай күші бар...
Dialogue: 0,0:07:39.08,0:07:40.08,Default,,0,0,0,,Сіз!
Dialogue: 0,0:07:40.18,0:07:41.98,Default,,0,0,0,,Ұрыс кезінде қарамаңыз!
Dialogue: 0,0:07:44.08,0:07:47.58,Default,,0,0,0,,Шүкір, уақыт келді.
Dialogue: 0,0:07:47.68,0:07:48.88,Default,,0,0,0,,Көк қылыш!
Dialogue: 0,0:07:49.08,0:07:50.08,Default,,0,0,0,,Міне!
Dialogue: 0,0:07:51.08,0:07:52.38,Default,,0,0,0,,Бұрынғы Робо Джожо!
Dialogue: 0,0:07:52.48,0:07:53.38,Default,,0,0,0,,Ооо!
Dialogue: 0,0:07:53.48,0:07:54.78,Default,,0,0,0,,Драгонхан емес!
Dialogue: 0,0:07:54.88,0:07:56.58,Default,,0,0,0,,Айдаһар қылыш!
Dialogue: 0,0:08:01.68,0:08:02.98,Default,,0,0,0,,Кәдімгі түс...
Dialogue: 0,0:08:05.18,0:08:07.98,Default,,0,0,0,,Мен көп қуат үнемдеймін деп ойладым...
Dialogue: 0,0:08:08.28,0:08:11.28,Default,,0,0,0,,Мен естідім...бұл қасиетті құрал...
Dialogue: 0,0:08:11.38,0:08:13.48,Default,,0,0,0,,Мен сені осында өлтіремін!
Dialogue: 0,0:08:13.48,0:08:14.68,Default,,0,0,0,,Жабық!
Dialogue: 0,0:08:16.88,0:08:18.28,Default,,0,0,0,,Сонымен, сіз оны болжадым деп ойлайсыз!
Dialogue: 0,0:08:18.38,0:08:19.28,Default,,0,0,0,,Жарылыс!
Dialogue: 0,0:08:19.38,0:08:20.78,Default,,0,0,0,,Киім үзіліс!
Dialogue: 0,0:08:21.78,0:08:23.58,Default,,0,0,0,,Не, бұл не!?
Dialogue: 0,0:08:25.18,0:08:27.88,Default,,0,0,0,,Миыңыздағы джентльмен қалтасын атаңыз және сақтаңыз!
Dialogue: 0,0:08:28.28,0:08:29.58,Default,,0,0,0,,Сақталды!
Dialogue: 0,0:08:29.88,0:08:30.98,Default,,0,0,0,,Жарайды, кеттік!
Dialogue: 0,0:08:31.38,0:08:33.28,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:08:33.28,0:08:36.28,Default,,0,0,0,,Юкине-кун, барсың ба?
Dialogue: 0,0:08:38.38,0:08:41.50,Default,,0,0,0,,мен Ран-саманың қазығы 1 адам
Dialogue: 0,0:08:41.50,0:08:45.28,Default,,0,0,0,,Зейнеткерлік кескіш
Dialogue: 0,0:08:45.28,0:08:53.04,Default,,0,0,0,,Дегенмен, мен оны бірінші рет көріп тұрмын және бұл қорқынышты техника, әлде әйел үшін қорқынышты деп айту керек пе.
Dialogue: 0,0:08:53.04,0:08:57.20,Default,,0,0,0,,Әйтеуір, әдепсіз болғаным үшін кешіріңіз.
Dialogue: 0,0:08:57.20,0:09:03.58,Default,,0,0,0,,Бұл көп, ah3 Liberty.
Dialogue: 0,0:09:03.58,0:09:05.30,Default,,0,0,0,,Соңы
Dialogue: 0,0:09:05.30,0:09:08.00,Default,,0,0,0,,rl
Dialogue: 0,0:09:08.00,0:09:08.50,Default,,0,0,0,,...
Dialogue: 0,0:09:08.26,0:09:10.26,Default,,0,0,0,,иә
Dialogue: 0,0:09:10.26,0:09:26.08,Default,,0,0,0,,Оны тікелей орнату әлі ерте болар еді.
Dialogue: 0,0:09:26.08,0:09:29.08,Default,,0,0,0,,Менің қолым оқылды ма?
Dialogue: 0,0:09:29.08,0:09:32.26,Default,,0,0,0,,Менің келе жатқанымды білдің.
Dialogue: 0,0:09:32.94,0:09:35.58,Default,,0,0,0,,Қыздар тәжірибелі адамдарды сынамауы керек.
Dialogue: 0,0:09:35.58,0:09:36.46,Default,,0,0,0,,Раиас
Dialogue: 0,0:09:36.46,0:09:39.44,Default,,0,0,0,,Сіз әлі де тапқыр адамсыз.
Dialogue: 0,0:09:39.44,0:09:41.24,Default,,0,0,0,,Күйреген ханшайым
Dialogue: 0,0:09:41.24,0:09:43.18,Default,,0,0,0,,Ымырттың емі
Dialogue: 0,0:09:43.18,0:09:45.50,Default,,0,0,0,,Найзағайдың ғибадатхана қызына
Dialogue: 0,0:09:45.50,0:09:47.08,Default,,0,0,0,,Қылыш
Dialogue: 0,0:09:47.08,0:09:48.74,Default,,0,0,0,,Күшейтілген беріліс
Dialogue: 0,0:09:48.74,0:09:51.82,Default,,0,0,0,,Жаттығулардың атаулары берілген.
Dialogue: 0,0:09:51.82,0:09:54.50,Default,,0,0,0,,Бұл Феникс
Dialogue: 0,0:09:54.50,0:09:55.28,Default,,0,0,0,,Феникс
Dialogue: 0,0:09:55.28,0:09:57.20,Default,,0,0,0,,Мен өлмейтінмін.
Dialogue: 0,0:09:57.20,0:10:00.92,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:10:00.92,0:10:04.78,Default,,0,0,0,,Бұл сен үшін қандай үмітсіз
Dialogue: 0,0:10:04.78,0:10:05.62,Default,,0,0,0,,Тізе
Dialogue: 0,0:10:05.62,0:10:06.54,Default,,0,0,0,,Ли
Dialogue: 0,0:10:06.54,0:10:08.78,Default,,0,0,0,,Бұл пешкалар
Dialogue: 0,0:10:08.78,0:10:10.78,Default,,0,0,0,,Мен көзбен көргеннен көп нәрсені істеймін.
Dialogue: 0,0:10:10.78,0:10:13.68,Default,,0,0,0,,Күшейтілген беріліс
Dialogue: 0,0:10:13.68,0:10:17.26,Default,,0,0,0,,Ең нашар ұсыныс
Dialogue: 0,0:10:17.26,0:10:19.42,Default,,0,0,0,,Мониторды төменгі денеңізбен ұстайсыз ба?
Dialogue: 0,0:10:19.42,0:10:20.92,Default,,0,0,0,,Жылтыратылған Жан
Dialogue: 0,0:10:20.92,0:10:26.62,Default,,0,0,0,,Шешуші Сирис
Dialogue: 0,0:10:26.62,0:10:30.62,Default,,0,0,0,,Күшейтілген беріліс
Dialogue: 0,0:10:30.62,0:10:31.42,Default,,0,0,0,,Өте нашар
Dialogue: 0,0:10:31.42,0:10:32.42,Default,,0,0,0,,Иссей-кун
Dialogue: 0,0:10:32.42,0:10:38.42,Default,,0,0,0,,Күшейтілген беріліс
Dialogue: 0,0:10:38.42,0:10:40.42,Default,,0,0,0,,Бұл сізге көбірек ұнайды деп үміттенемін.
Dialogue: 0,0:10:40.42,0:10:43.42,Default,,0,0,0,,Өйткені, бұл күрделі келіссөз.
Dialogue: 0,0:10:43.42,0:10:44.42,Default,,0,0,0,,Кім
Dialogue: 0,0:10:44.42,0:10:48.42,Default,,0,0,0,,Күшейтілген беріліс
Dialogue: 0,0:10:48.42,0:10:49.42,Default,,0,0,0,,Менде бәрі жақсы
Dialogue: 0,0:10:49.42,0:10:50.42,Default,,0,0,0,,Мен туралы
Dialogue: 0,0:10:50.42,0:10:51.42,Default,,0,0,0,,Сіз мұны қазір көз алдыңызда жасай аласыз.
Dialogue: 0,0:10:51.42,0:10:52.42,Default,,0,0,0,,Бірақ
Dialogue: 0,0:10:52.42,0:10:54.42,Default,,0,0,0,,Мен саған сенемін
Dialogue: 0,0:10:54.42,0:10:55.42,Default,,0,0,0,,Барыңыз
Dialogue: 0,0:10:55.42,0:10:58.42,Default,,0,0,0,,Осы Геасс Гремори қызметшісінің күші
Dialogue: 0,0:10:58.42,0:11:00.42,Default,,0,0,0,,Көрсетейік
Dialogue: 0,0:11:00.42,0:11:02.42,Default,,0,0,0,,Иә.
Dialogue: 0,0:11:02.42,0:11:04.42,Default,,0,0,0,,Мен менеджердің қызметшісімін.
Dialogue: 0,0:11:04.42,0:11:06.42,Default,,0,0,0,,Сирис қылышы
Dialogue: 0,0:11:06.42,0:11:07.42,Default,,0,0,0,,Қолмен
Dialogue: 0,0:11:07.42,0:11:09.42,Default,,0,0,0,,Ойланатын ештеңе жоқ
Dialogue: 0,0:11:09.42,0:11:11.42,Default,,0,0,0,,Тек менеджерге арналған
Dialogue: 0,0:11:11.42,0:11:12.42,Default,,0,0,0,,Сен оны тым асыра бағалап жатырсың.
Dialogue: 0,0:11:12.42,0:11:13.42,Default,,0,0,0,,Сіз
Dialogue: 0,0:11:13.42,0:11:15.42,Default,,0,0,0,,Оны құлатыңыз
Dialogue: 0,0:11:15.42,0:11:16.42,Default,,0,0,0,,Біз Әйел Титан сияқты көрінетін біреуді байқадық.
Dialogue: 0,0:11:16.42,0:11:18.42,Default,,0,0,0,,Қызыл айдаһар данышпан
Dialogue: 0,0:11:18.42,0:11:19.42,Default,,0,0,0,,Мені естімесеңіз, жауап беріңіз.
Dialogue: 0,0:11:19.42,0:11:21.42,Default,,0,0,0,,Маған күш беретін кім?
Dialogue: 0,0:11:21.42,0:11:23.42,Default,,0,0,0,,Айдаһар Бо жұлдызы
Dialogue: 0,0:11:23.42,0:11:24.42,Default,,0,0,0,,(Шукуна) Ә, мен бұған мұқтаж емеспін, білесің бе—
Dialogue: 0,0:11:24.42,0:11:26.42,Default,,0,0,0,,Менің ойыма көбірек жауап беріңізші.
Dialogue: 0,0:11:26.42,0:11:29.42,Default,,0,0,0,,Күшейтілген беріліс
Dialogue: 0,0:11:29.42,0:11:31.42,Default,,0,0,0,,Айдаһар Бостар әлеміндегі Vibe Ray
Dialogue: 0,0:11:31.42,0:11:32.42,Default,,0,0,0,,Не?
Dialogue: 0,0:11:32.42,0:11:33.42,Default,,0,0,0,,Айдаһар Бостар әлеміндегі Vibe Ray
Dialogue: 0,0:11:33.42,0:11:34.42,Default,,0,0,0,,Не?
Dialogue: 0,0:11:34.42,0:11:36.42,Default,,0,0,0,,Айдаһар Бостар әлеміндегі Вивирай
Dialogue: 0,0:11:36.42,0:11:39.42,Default,,0,0,0,,Жасау
Dialogue: 0,0:11:43.42,0:11:45.42,Default,,0,0,0,,Өзгертілді
Dialogue: 0,0:11:45.42,0:11:50.42,Default,,0,0,0,,I, Иказучи Мико
Dialogue: 0,0:11:50.42,0:11:51.42,Default,,0,0,0,,Ах, міне ол.
Dialogue: 0,0:11:51.42,0:11:52.42,Default,,0,0,0,,Бірақ
Dialogue: 0,0:11:52.42,0:11:54.42,Default,,0,0,0,,Сіздің сиқырлы күшіңіз қазірдің өзінде бар
Dialogue: 0,0:11:54.42,0:11:55.42,Default,,0,0,0,,(Идзуми) Уау! Бұл өте қызықты естіледі.
Dialogue: 0,0:11:55.42,0:11:56.42,Default,,0,0,0,,Сәл демалсаң, сауығып кетесің.
Dialogue: 0,0:11:56.42,0:12:00.06,Default,,0,0,0,,Аздап демалғаннан кейін заттар қалпына келеді.
Dialogue: 0,0:12:00.06,0:12:04.80,Default,,0,0,0,,Оған шамамыз жетеді ме деп ойлаймын.
Dialogue: 0,0:12:04.80,0:12:05.60,Default,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:12:05.60,0:12:09.26,Default,,0,0,0,,Біраз уақыт қажет болды.
Dialogue: 0,0:12:09.26,0:12:13.60,Default,,0,0,0,,Түсіндім, бұл менің жаңа күшім
Dialogue: 0,0:12:13.60,0:12:20.90,Default,,0,0,0,,Қасиетті құралды босатыңыз
Dialogue: 0,0:12:20.90,0:12:21.88,Default,,0,0,0,,Шығарылым
Dialogue: 0,0:12:21.88,0:12:24.42,Default,,0,0,0,,Мен жеңдім
Dialogue: 0,0:12:24.42,0:12:27.04,Default,,0,0,0,,Қылыш
Dialogue: 0,0:12:27.04,0:12:36.42,Default,,0,0,0,,Транс.
Dialogue: 0,0:12:36.42,0:12:55.42,Default,,0,0,0,,Менің жоғалтуым
Dialogue: 0,0:12:55.42,0:12:57.42,Default,,0,0,0,,Жоғалған
Dialogue: 0,0:12:57.42,0:13:01.12,Default,,0,0,0,,Ризердің екі пешкасы
Dialogue: 0,0:13:01.12,0:13:02.54,Default,,0,0,0,,2 рыцарь
Dialogue: 0,0:13:02.54,0:13:03.84,Default,,0,0,0,,Ришок 1 адам
Dialogue: 0,0:13:03.84,0:13:04.62,Default,,0,0,0,,Зейнеткерлікке шығу
Dialogue: 0,0:13:04.62,0:13:08.12,Default,,0,0,0,,Рыцарьдың қабілеттері күшейтілген жабдықпен жақсарған кезде.
Dialogue: 0,0:13:08.12,0:13:11.22,Default,,0,0,0,,Ішірютейден жіберілген жаңа күш
Dialogue: 0,0:13:11.22,0:13:14.84,Default,,0,0,0,,Күшейтілген жабдық сыйлығы!
Dialogue: 0,0:13:14.84,0:13:22.28,Default,,0,0,0,,1 Риас-сама ханшайымы
Dialogue: 0,0:13:22.28,0:13:23.22,Default,,0,0,0,,Зейнеткерлікке шығу
Dialogue: 0,0:13:23.22,0:13:28.74,Default,,0,0,0,,Акено мырза
Dialogue: 0,0:13:28.74,0:13:33.22,Default,,0,0,0,,Акено
Dialogue: 0,0:13:33.22,0:13:35.72,Default,,0,0,0,,Акено мырза
Dialogue: 0,0:13:35.72,0:13:38.74,Default,,0,0,0,,Сіз мақтаншақ қолыңыздан айырылған сияқтысыз.
Dialogue: 0,0:13:38.74,0:13:41.36,Default,,0,0,0,,Юто мен Иссей әлі осында.
Dialogue: 0,0:13:41.36,0:13:43.86,Default,,0,0,0,,Мен сені дәл қазір осы жерде атып тастасам да, жоғарыдағылар қарсы болмас еді, иә?
Dialogue: 0,0:13:43.86,0:13:47.32,Default,,0,0,0,,Акено мырзаның жеңілгеніне сене алар емеспін.
Dialogue: 0,0:13:47.32,0:13:50.74,Default,,0,0,0,,Кибар
Dialogue: 0,0:13:50.74,0:13:55.74,Default,,0,0,0,,Акено
Dialogue: 0,0:13:55.74,0:13:56.74,Default,,0,0,0,,Жалған
Dialogue: 0,0:13:57.74,0:13:59.74,Default,,0,0,0,,1 Риас-сама рыцарь
Dialogue: 0,0:13:59.74,0:14:00.74,Default,,0,0,0,,Зейнеткерлікке шығу
Dialogue: 0,0:14:00.74,0:14:01.74,Default,,0,0,0,,Юто
Dialogue: 0,0:14:01.74,0:14:02.74,Default,,0,0,0,,Оны құрастырыңыз.
Dialogue: 0,0:14:02.74,0:14:03.74,Default,,0,0,0,,Риас
Dialogue: 0,0:14:03.74,0:14:04.74,Default,,0,0,0,,Кім
Dialogue: 0,0:14:04.74,0:14:09.74,Default,,0,0,0,,Мен әлі білмеймін.
Dialogue: 0,0:14:09.74,0:14:11.74,Default,,0,0,0,,Оның гастрономиясы және
Dialogue: 0,0:14:11.74,0:14:13.74,Default,,0,0,0,,Сіздің сүйкімді пешкаңыз
Dialogue: 0,0:14:13.74,0:14:16.74,Default,,0,0,0,,Бұл сізге тек зиян тигізеді.
Dialogue: 0,0:14:16.74,0:14:19.74,Default,,0,0,0,,Құрметті Риас
Dialogue: 0,0:14:19.74,0:14:21.74,Default,,0,0,0,,Кеш болды.
Dialogue: 0,0:14:21.74,0:14:22.74,Default,,0,0,0,,Юберна
Dialogue: 0,0:14:22.74,0:14:23.74,Default,,0,0,0,,Сол ханшайым
Dialogue: 0,0:14:23.74,0:14:25.74,Default,,0,0,0,,Бұл қауесет сияқты күшті болды.
Dialogue: 0,0:14:25.74,0:14:27.74,Default,,0,0,0,,Осының күшін қарызға ал
Dialogue: 0,0:14:27.74,0:14:29.74,Default,,0,0,0,,Жеңіс - жеңіс
Dialogue: 0,0:14:29.74,0:14:32.74,Default,,0,0,0,,Өйткені, сен мен ең көп арқа сүйейтін адамсың.
Dialogue: 0,0:14:32.74,0:14:33.74,Default,,0,0,0,,Сонымен
Dialogue: 0,0:14:33.74,0:14:34.74,Default,,0,0,0,,Бұл қандай сұлулық?
Dialogue: 0,0:14:34.74,0:14:36.74,Default,,0,0,0,,Пеникстің көз жасы
Dialogue: 0,0:14:36.74,0:14:40.74,Default,,0,0,0,,Бұл менің отбасымның кез келген зақымдануды бірден сезетін қазынасы.
Dialogue: 0,0:14:40.74,0:14:42.74,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,0:14:42.74,0:14:45.74,Default,,0,0,0,,Ойында екі спецификацияға дейін рұқсат етілген.
Dialogue: 0,0:14:45.74,0:14:51.74,Default,,0,0,0,,Ымырттан емдейтін епископтар да бар, солай ма?
Dialogue: 0,0:14:51.74,0:14:57.74,Default,,0,0,0,,Бұл қымбат бағаға сатылады, себебі оны тек менің отбасым жасай алады.
Dialogue: 0,0:14:57.74,0:14:59.74,Default,,0,0,0,,Өлмейтін үшін көз жасы
Dialogue: 0,0:14:59.74,0:15:03.74,Default,,0,0,0,,Рейтингтік ойын басталғаннан бері Феникс отбасы жақсы нәрселерге толы болды.
Dialogue: 0,0:15:03.74,0:15:07.74,Default,,0,0,0,,Еленбейді
Dialogue: 0,0:15:07.74,0:15:13.74,Default,,0,0,0,,Көтермелеу
Dialogue: 0,0:15:13.74,0:15:15.74,Default,,0,0,0,,Маған патшайымның билігін беріңіз
Dialogue: 0,0:15:15.74,0:15:19.74,Default,,0,0,0,,Күте тұрыңыз
Dialogue: 0,0:15:19.74,0:15:21.74,Default,,0,0,0,,Мен әрқашан менеджер боламын.
Dialogue: 0,0:15:21.74,0:15:23.74,Default,,0,0,0,,Мен сені жеңемін
Dialogue: 0,0:15:23.74,0:15:27.74,Default,,0,0,0,,Менеджер
Dialogue: 0,0:15:27.74,0:15:29.74,Default,,0,0,0,,Хеймичи I
Dialogue: 0,0:15:29.74,0:15:31.74,Default,,0,0,0,,Мен жаңа ғана келдім.
Dialogue: 0,0:15:31.74,0:15:33.74,Default,,0,0,0,,Иссей
Dialogue: 0,0:15:33.74,0:15:37.74,Default,,0,0,0,,Борнның баласы мен епископтың ханымы менікі.
Dialogue: 0,0:15:37.74,0:15:39.74,Default,,0,0,0,,Мен бәріңмен айналысамын.
Dialogue: 0,0:15:39.74,0:15:41.74,Default,,0,0,0,,Бұл жігіттер үшін қолайлырақ болар еді.
Dialogue: 0,0:15:41.74,0:15:43.74,Default,,0,0,0,,Алданбаңыз
Dialogue: 0,0:15:43.74,0:15:45.74,Default,,0,0,0,,Бұл сен мені бірінші жеңгеннен кейін.
Dialogue: 0,0:15:45.74,0:15:49.74,Default,,0,0,0,,Оны жобалаңыз, Риас.
Dialogue: 0,0:15:49.74,0:15:51.74,Default,,0,0,0,,Сіз кептеліп қалдыңыз
Dialogue: 0,0:15:51.74,0:15:53.74,Default,,0,0,0,,Мен бұлай болатынын оқыдым.
Dialogue: 0,0:15:53.74,0:15:55.74,Default,,0,0,0,,(Стефани) Аңыздар рас екен — Соғыс жануарлары шынымен ойды оқитын нәсіл.
Dialogue: 0,0:15:55.74,0:15:57.74,Default,,0,0,0,,Үніңді жап, Ризер.
Dialogue: 0,0:15:57.74,0:15:59.74,Default,,0,0,0,,Бітелген
Dialogue: 0,0:15:59.74,0:16:01.74,Default,,0,0,0,,Қандай батыл бала.
Dialogue: 0,0:16:01.74,0:16:03.74,Default,,0,0,0,,Мен Патшамын, мен аманмын.
Dialogue: 0,0:16:03.74,0:16:05.74,Default,,0,0,0,,Бұл сөзсіз.
Dialogue: 0,0:16:05.74,0:16:07.74,Default,,0,0,0,,Мұны орындаңыз
Dialogue: 0,0:16:07.74,0:16:09.74,Default,,0,0,0,,Иә
Dialogue: 0,0:16:09.74,0:16:11.74,Default,,0,0,0,,Ханым
Dialogue: 0,0:16:11.74,0:16:13.74,Default,,0,0,0,,Бұл сондай кескілескен шайқас болды
Dialogue: 0,0:16:13.74,0:16:15.74,Default,,0,0,0,,Сіз осы уақытқа дейін келдіңіз.
Dialogue: 0,0:16:15.74,0:16:17.74,Default,,0,0,0,,Мен уәде берер едім
Dialogue: 0,0:16:17.74,0:16:19.74,Default,,0,0,0,,Иә
Dialogue: 0,0:16:19.74,0:16:21.74,Default,,0,0,0,,Рахмет
Dialogue: 0,0:16:21.74,0:16:23.74,Default,,0,0,0,,Азия – біздің өмірлік арқамыз
Dialogue: 0,0:16:23.74,0:16:25.74,Default,,0,0,0,,Артқа тұрыңыз.
Dialogue: 0,0:16:25.74,0:16:27.74,Default,,0,0,0,,Азия
Dialogue: 0,0:16:27.74,0:16:29.74,Default,,0,0,0,,Уф
Dialogue: 0,0:16:29.74,0:16:31.74,Default,,0,0,0,,Азия
Dialogue: 0,0:16:31.74,0:16:33.74,Default,,0,0,0,,Уф
Dialogue: 0,0:16:33.74,0:16:35.74,Default,,0,0,0,,Жарайды
Dialogue: 0,0:16:35.74,0:16:37.74,Default,,0,0,0,,Азия
Dialogue: 0,0:16:37.74,0:16:39.74,Default,,0,0,0,,Зиян жоқ
Dialogue: 0,0:16:39.74,0:16:41.74,Default,,0,0,0,,Мүмкін мен есеңгіреп қалған шығармын.
Dialogue: 0,0:16:41.74,0:16:45.74,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:45.74,0:16:47.74,Default,,0,0,0,,Мен оны баланың денесімен бірге аламын деп ойламадым.
Dialogue: 0,0:16:47.74,0:16:49.74,Default,,0,0,0,,Мен сізбен кездескім келеді
Dialogue: 0,0:16:49.74,0:16:52.74,Default,,0,0,0,,Ымырттың емі әзірге мөрленді.
Dialogue: 0,0:16:52.74,0:16:53.74,Default,,0,0,0,,Сен
Dialogue: 0,0:16:53.74,0:16:55.74,Default,,0,0,0,,Менен тура соққы алсаң да
Dialogue: 0,0:16:55.74,0:16:57.74,Default,,0,0,0,,Королеваның қорғаныс күші
Dialogue: 0,0:16:57.74,0:16:59.74,Default,,0,0,0,,Мені жоғарылату құтқарды
Dialogue: 0,0:16:59.74,0:17:00.74,Default,,0,0,0,,Менеджер
Dialogue: 0,0:17:00.74,0:17:01.74,Default,,0,0,0,,Ойын жалғасады, солай ма?
Dialogue: 0,0:17:01.74,0:17:02.74,Default,,0,0,0,,Иә
Dialogue: 0,0:17:02.74,0:17:03.74,Default,,0,0,0,,Өйткені мен ақымақпын
Dialogue: 0,0:17:03.74,0:17:06.74,Default,,0,0,0,,Білмеймін бұл оқу ма, цун ба.
Dialogue: 0,0:17:06.74,0:17:09.74,Default,,0,0,0,,Мен әлі күресе алмаймын
Dialogue: 0,0:17:09.74,0:17:12.74,Default,,0,0,0,,Жұдырық ұстағанша күресе алмайсың.
Dialogue: 0,0:17:12.74,0:17:14.74,Default,,0,0,0,,Жақсы айтылған.
Dialogue: 0,0:17:16.74,0:17:18.74,Default,,0,0,0,,Райзерді бірге жеңейік
Dialogue: 0,0:17:18.74,0:17:19.74,Default,,0,0,0,,Иә, директор
Dialogue: 0,0:17:19.74,0:17:22.74,Default,,0,0,0,,Күте тұр, Азия.
Dialogue: 0,0:17:22.74,0:17:23.74,Default,,0,0,0,,Әрқашан жеңіңіз
Dialogue: 0,0:17:23.74,0:17:26.74,Default,,0,0,0,,Ал біз үйге бірге барамыз
Dialogue: 0,0:17:26.74,0:17:33.74,Default,,0,0,0,,Күшейтіңіз
Dialogue: 0,0:17:33.74,0:17:34.68,Default,,0,0,0,,Жақсы мінез-құлық мақтауға лайық, ал жаман әрекет лайықты жазаға тартылуы тиіс.
Dialogue: 0,0:17:34.68,0:17:35.74,Default,,0,0,0,,Күшейтіңіз
Dialogue: 0,0:17:35.74,0:17:36.74,Default,,0,0,0,,Заң
Dialogue: 0,0:17:36.74,0:17:37.74,Default,,0,0,0,,Ұзақ жұмыс күнінен кейін бір шыныаяқ сакэ ішуден артық ештеңе жоқ!
Dialogue: 0,0:17:37.74,0:17:39.74,Default,,0,0,0,,жарықтар
Dialogue: 0,0:17:39.74,0:17:40.74,Default,,0,0,0,,2
Dialogue: 0,0:17:40.74,0:17:41.74,Default,,0,0,0,,ашылды
Dialogue: 0,0:17:41.74,0:17:42.74,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:17:42.74,0:17:45.74,Default,,0,0,0,,Күшейтіңіз
Dialogue: 0,0:17:45.74,0:17:47.14,Default,,0,0,0,,Boost Agia - бұл
Dialogue: 0,0:17:47.14,0:17:49.74,Default,,0,0,0,,Басқа Sacred Gear-мен салыстыруға келмейді
Dialogue: 0,0:17:49.74,0:17:52.32,Default,,0,0,0,,Үй иесіне ауыр физикалық жүктеме түсіреді.
Dialogue: 0,0:17:52.32,0:17:58.52,Default,,0,0,0,,Шындығында, оның күш-қуатын нығайтып, талай рет жекпе-жекке шығуы ғажап дерлік.
Dialogue: 0,0:17:58.52,0:18:02.88,Default,,0,0,0,,Юбелун сиқырлы күш әлдеқашан түңілген кезде тікелей соққы береді.
Dialogue: 0,0:18:02.88,0:18:06.60,Default,,0,0,0,,Оның денесі өз шегінен асып кетті.
Dialogue: 0,0:18:06.60,0:18:08.92,Default,,0,0,0,,Періштенің нұры
Dialogue: 0,0:18:08.92,0:18:11.22,Default,,0,0,0,,Сирек
Dialogue: 0,0:18:11.22,0:18:14.04,Default,,0,0,0,,Тіпті сізде осынша сиқырлы күш қана қалды.
Dialogue: 0,0:18:14.04,0:18:17.84,Default,,0,0,0,,Жеңілгенді мойындап, тез отставкаға кетуге қалай қарайсыз?
Dialogue: 0,0:18:17.84,0:18:20.72,Default,,0,0,0,,Кім жақсы, директор?
Dialogue: 0,0:18:20.72,0:18:25.34,Default,,0,0,0,,Мен не істесем де жеңемін.
Dialogue: 0,0:18:25.34,0:18:29.60,Default,,0,0,0,,Мен сенің ең күшті пешкаң боламын.
Dialogue: 0,0:18:29.60,0:18:32.90,Default,,0,0,0,,Мен менеджерге осылай уәде бердім.
Dialogue: 0,0:18:32.90,0:18:35.84,Default,,0,0,0,,Менеджер мені оқытты.
Dialogue: 0,0:18:35.84,0:18:37.98,Default,,0,0,0,,Өлме!
Dialogue: 0,0:18:37.98,0:18:40.78,Default,,0,0,0,,Әлі ұрысуға болмайды
Dialogue: 0,0:18:40.78,0:18:43.56,Default,,0,0,0,,Мен уәдемді орындаймын
Dialogue: 0,0:18:43.56,0:18:46.44,Default,,0,0,0,,Резаин
Dialogue: 0,0:18:46.44,0:18:48.04,Default,,0,0,0,,Мен күресемін
Dialogue: 0,0:18:48.04,0:18:51.00,Default,,0,0,0,,Мен менеджердің пешясымын.
Dialogue: 0,0:18:51.00,0:18:52.94,Default,,0,0,0,,Сіз әлі де күресе аласыз.
Dialogue: 0,0:18:52.94,0:18:54.44,Default,,0,0,0,,Біз жеңеміз.
Dialogue: 0,0:18:54.44,0:18:57.44,Default,,0,0,0,,Түс, түс.
Dialogue: 0,0:18:57.44,0:18:58.08,Default,,0,0,0,,Мен
Dialogue: 0,0:18:58.44,0:18:59.44,Default,,0,0,0,,Резаин
Dialogue: 0,0:18:59.44,0:19:01.26,Default,,0,0,0,,Неліктен менің бұйрығым?
Dialogue: 0,0:19:01.26,0:19:01.76,Default,,0,0,0,,Мен
Dialogue: 0,0:19:01.68,0:19:06.04,Default,,0,0,0,,Егер менеджер күлсе
Dialogue: 0,0:19:06.04,0:19:11.04,Default,,0,0,0,,Осыған қарамастан, маған менеджер ұнайды.
Dialogue: 0,0:19:11.04,0:19:15.32,Default,,0,0,0,,Өйткені Риас-сенпай мен үшін ең жақсысы.
Dialogue: 0,0:19:15.32,0:19:16.56,Default,,0,0,0,,Барлығы бірден
Dialogue: 0,0:19:16.56,0:19:17.96,Default,,0,0,0,,Не керек, Крюгер мырза?
Dialogue: 0,0:19:17.96,0:19:20.38,Default,,0,0,0,,Бұл жағымсыз.
Dialogue: 0,0:19:20.38,0:19:23.18,Default,,0,0,0,,Дәл қызметші сияқты
Dialogue: 0,0:19:23.18,0:19:26.96,Default,,0,0,0,,Мен осы Ризер Феникске қарсы тұруым керек пе?
Dialogue: 0,0:19:26.96,0:19:29.06,Default,,0,0,0,,Көтергіш дегенді қалай түсінесіңдер?
Dialogue: 0,0:19:29.06,0:19:31.60,Default,,0,0,0,,Мына кісінің іші нені айқастырып алған?
Dialogue: 0,0:19:31.60,0:19:33.20,Default,,0,0,0,,Оны жай ғана өртеп жіберіңіз.
Dialogue: 0,0:19:33.20,0:19:36.40,Default,,0,0,0,,Емдеу мағынасыз
Dialogue: 0,0:19:36.40,0:19:40.38,Default,,0,0,0,,Ойын кезіндегі өлім жазатайым оқиға деп танылады.
Dialogue: 0,0:19:40.38,0:19:42.38,Default,,0,0,0,,Куна
Dialogue: 0,0:19:42.38,0:19:45.66,Default,,0,0,0,,Сен Кираны асып өлтіремін дедің, ал қазір оны өлтірді деп айтып тұрсың ба? Дәл осыны айтқың келе ме?
Dialogue: 0,0:19:45.66,0:19:47.06,Default,,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:19:47.06,0:19:49.00,Default,,0,0,0,,Тоқта, Ризер.
Dialogue: 0,0:19:49.00,0:19:56.00,Default,,0,0,0,,Га
Dialogue: 0,0:19:56.72,0:19:59.00,Default,,0,0,0,,Тек мен
Dialogue: 0,0:19:59.00,0:20:01.00,Default,,0,0,0,,Отставкаға кету
Dialogue: 0,0:20:09.00,0:20:10.50,Default,,0,0,0,,Бұл балаларды ойнауға әкелетін орын емес
Dialogue: 0,0:20:10.50,0:20:13.00,Default,,0,0,0,,Жолдас
Dialogue: 0,0:20:13.00,0:20:15.80,Default,,0,0,0,,Менеджер
Dialogue: 0,0:20:15.80,0:20:17.50,Default,,0,0,0,,Егер біз сол жүк көлігінің кетуіне жол берсек, апат болар еді
Dialogue: 0,0:20:17.50,0:20:19.50,Default,,0,0,0,,Риас-саманың дизайнын тексеріңіз
Dialogue: 0,0:20:19.50,0:20:24.50,Default,,0,0,0,,Бұл ойынды Ризер Феникс жеңеді.
Dialogue: 0,0:20:24.50,0:20:29.96,Default,,0,0,0,,Бұл келісім кеші болса да
Dialogue: 0,0:20:29.96,0:20:31.50,Default,,0,0,0,,Бұл той көйлегі
Dialogue: 0,0:20:31.50,0:20:32.50,Default,,0,0,0,,Көтерілген жеріміз – құлайтын жеріміз.
Dialogue: 0,0:20:32.50,0:20:34.50,Default,,0,0,0,,Неге мен?
Dialogue: 0,0:20:34.50,0:20:35.50,Default,,0,0,0,,Өте әлсіз
Dialogue: 0,0:20:35.50,0:20:37.50,Default,,0,0,0,,Менің ханшайымым
Dialogue: 0,0:20:37.50,0:20:39.50,Default,,0,0,0,,Эйрс Гремори
Dialogue: 0,0:20:39.50,0:20:42.50,Default,,0,0,0,,Аяқталмаған
Dialogue: 0,0:20:42.50,0:20:44.50,Default,,0,0,0,,Абсолюттік жалақы да
Dialogue: 0,0:20:44.50,0:20:45.50,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:20:45.50,0:20:47.50,Default,,0,0,0,,Гиль мәселесі
Dialogue: 0,0:20:47.50,0:20:59.12,Default,,0,0,0,,Астық түйіршіктеу
Dialogue: 0,0:21:00.62,0:21:05.62,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
