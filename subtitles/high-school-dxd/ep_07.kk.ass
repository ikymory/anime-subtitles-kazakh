Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.96,Default,,0,0,0,,Дайын Азияға барайық
Dialogue: 0,0:00:06.96,0:00:07.60,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:00:07.60,0:00:08.42,Default,,0,0,0,,Иә
Dialogue: 0,0:00:08.42,0:00:12.00,Default,,0,0,0,,Осы аптаға дейін парақшаларды тарата аласыз.
Dialogue: 0,0:00:12.62,0:00:13.12,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:00:12.90,0:00:16.00,Default,,0,0,0,,Сіз бұған дейін бардыңыз, солай ма?
Dialogue: 0,0:00:16.00,0:00:18.40,Default,,0,0,0,,Мен мұны жаттығуымның бір бөлігі ретінде жасадым.
Dialogue: 0,0:00:18.40,0:00:21.42,Default,,0,0,0,,Парақшаларды тарату бастапқыда таныс жұмыс.
Dialogue: 0,0:00:21.42,0:00:24.12,Default,,0,0,0,,Бұл сіздің парақшалар таратуды бітіргеніңізді білдіре ме?
Dialogue: 0,0:00:24.12,0:00:26.20,Default,,0,0,0,,Ең алдымен,
Dialogue: 0,0:00:26.20,0:00:29.34,Default,,0,0,0,,Барлығыңыз да өз таныстарыңызды алуыңыз керек.
Dialogue: 0,0:00:30.00,0:00:38.44,Default,,0,0,0,,Бұл менің танысым
Dialogue: 0,0:00:38.44,0:00:40.62,Default,,0,0,0,,Исей сені бұрын кездестірген.
Dialogue: 0,0:00:40.62,0:00:45.70,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,0:00:45.70,0:00:49.38,Default,,0,0,0,,Содан кейін сол кездегі бала
Dialogue: 0,0:00:49.38,0:00:53.92,Default,,0,0,0,,Бұл менікі
Dialogue: 0,0:00:53.92,0:00:57.78,Default,,0,0,0,,Куни
Dialogue: 0,0:00:57.78,0:00:58.86,Default,,0,0,0,,Бұл Широ.
Dialogue: 0,0:00:58.86,0:01:01.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:01.86,0:01:03.24,Default,,0,0,0,,Менікі
Dialogue: 0,0:01:03.24,0:01:05.30,Default,,0,0,0,,О, сенікі жақсы.
Dialogue: 0,0:01:05.30,0:01:06.74,Default,,0,0,0,,Мен балық аулай алмаймын.
Dialogue: 0,0:01:06.74,0:01:09.30,Default,,0,0,0,,Шайтанның негізі
Dialogue: 0,0:01:09.30,0:01:13.30,Default,,0,0,0,,Шеберге көмектесу және ақпаратты жіберуді қадағалау үшін пайдалануға болады.
Dialogue: 0,0:01:13.30,0:01:17.30,Default,,0,0,0,,Мен бұл таныстарды қалай аламын?
Dialogue: 0,0:01:17.30,0:01:18.30,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:01:18.30,0:01:20.30,Default,,0,0,0,,Иә
Dialogue: 0,0:01:20.30,0:01:25.74,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:01:25.74,0:01:27.74,Default,,0,0,0,,А, бұл адам
Dialogue: 0,0:01:27.74,0:01:32.18,Default,,0,0,0,,Осы мектептің студенттер кеңесінің төрағасы
Dialogue: 0,0:01:32.18,0:01:34.18,Default,,0,0,0,,Ол сыпайы аға сияқты.
Dialogue: 0,0:01:34.18,0:01:36.18,Default,,0,0,0,,Менің қасымда вице-президент Силла Цубаки-сенпай тұр.
Dialogue: 0,0:01:36.18,0:01:40.18,Default,,0,0,0,,Студенттік кеңес мүшелері барлығы бірге.
Dialogue: 0,0:01:40.18,0:01:41.90,Default,,0,0,0,,Сәйкестендірудің қандай қатесі бар?
Dialogue: 0,0:01:41.90,0:01:44.06,Default,,0,0,0,,Екеуіміздің де қызметшілеріміз көп.
Dialogue: 0,0:01:44.06,0:01:45.66,Default,,0,0,0,,Тағы да сәлем
Dialogue: 0,0:01:45.66,0:01:47.18,Default,,0,0,0,,Қызметші?
Dialogue: 0,0:01:47.18,0:01:49.18,Default,,0,0,0,,Бұл адамның шын аты кім?
Dialogue: 0,0:01:49.18,0:01:50.18,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:01:50.18,0:01:53.62,Default,,0,0,0,,Мен Шитори әулетінің келесі басшысымын, аға шайтанмын.
Dialogue: 0,0:01:53.62,0:01:56.18,Default,,0,0,0,,Бұл мектепте басқа жындар бар ма?
Dialogue: 0,0:01:56.18,0:02:01.18,Default,,0,0,0,,Риас-сенпай, сен оған біз туралы айтқан жоқсың ба?
Dialogue: 0,0:02:01.18,0:02:04.62,Default,,0,0,0,,Баяғы шайтан болса да байқамайтын мына жігіттің не жазығы бар деп ойлаймын.
Dialogue: 0,0:02:04.62,0:02:08.18,Default,,0,0,0,,Саджи, біз бір-бірімізге араласпауымыз керек.
Dialogue: 0,0:02:08.18,0:02:10.18,Default,,0,0,0,,Хьюду-кунның білмейтіні заңды.
Dialogue: 0,0:02:10.18,0:02:14.18,Default,,0,0,0,,Сіз жақында студенттік кеңестің қосымша мүшесі болдыңыз.
Dialogue: 0,0:02:14.18,0:02:16.18,Default,,0,0,0,,Мен сенімдімін 2 курс С сыныбы
Dialogue: 0,0:02:16.18,0:02:18.18,Default,,0,0,0,,Саджикенширо - пешка
Dialogue: 0,0:02:18.18,0:02:20.18,Default,,0,0,0,,Пешка Хиодо I
Dialogue: 0,0:02:20.18,0:02:22.18,Default,,0,0,0,,епископ Азия Аргенто
Dialogue: 0,0:02:22.18,0:02:24.18,Default,,0,0,0,,Әй, сен де пешкасың ба?
Dialogue: 0,0:02:24.18,0:02:26.18,Default,,0,0,0,,Бұл да сол мектеп.
Dialogue: 0,0:02:26.18,0:02:27.18,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:27.18,0:02:31.18,Default,,0,0,0,,Маған мен де сен сияқтымын, үш бұзықтардың бірімін.
Dialogue: 0,0:02:31.18,0:02:33.18,Default,,0,0,0,,Менің мақтанышым қатты жараланды.
Dialogue: 0,0:02:33.18,0:02:35.18,Default,,0,0,0,,О, бұл не деген!
Dialogue: 0,0:02:35.18,0:02:37.18,Default,,0,0,0,,Ой, мұны істейміз бе?
Dialogue: 0,0:02:37.18,0:02:39.18,Default,,0,0,0,,Мен жаңа ғана шайтанға айналдым
Dialogue: 0,0:02:39.18,0:02:41.18,Default,,0,0,0,,Мынадай көрінсе де, 4 дана тұратын солдат.
Dialogue: 0,0:02:41.18,0:02:43.18,Default,,0,0,0,,Саджи, тоқташы өтінемін.
Dialogue: 0,0:02:43.18,0:02:46.18,Default,,0,0,0,,Сонымен қатар, ол жерде 8 дана жұмсайды.
Dialogue: 0,0:02:46.18,0:02:49.18,Default,,0,0,0,,Олардың барлығы 8 емес пе?
Dialogue: 0,0:02:49.18,0:02:51.18,Default,,0,0,0,,Мен енді бұл қызықсыз адамға сене алар емеспін.
Dialogue: 0,0:02:51.18,0:02:52.18,Default,,0,0,0,,Ой!
Dialogue: 0,0:02:52.18,0:02:55.18,Default,,0,0,0,,Кешіріңіз, Хёуду-кун.
Dialogue: 0,0:02:55.18,0:02:56.18,Default,,0,0,0,,Аргенто мырза
Dialogue: 0,0:02:56.18,0:03:00.18,Default,,0,0,0,,Қаласаңыз, жаңа шайтандардың бір-бірімен жақсы тіл табысуына көмектесіңіз.
Dialogue: 0,0:03:00.18,0:03:01.18,Default,,0,0,0,,Саджи
Dialogue: 0,0:03:01.18,0:03:03.18,Default,,0,0,0,,А, иә
Dialogue: 0,0:03:03.18,0:03:04.18,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:03:05.18,0:03:07.18,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:03:07.18,0:03:11.18,Default,,0,0,0,,Бұл жерде сіз сияқты сүйкімді қызды қарсы алады.
Dialogue: 0,0:03:11.18,0:03:12.18,Default,,0,0,0,,Байя!
Dialogue: 0,0:03:12.18,0:03:13.18,Default,,0,0,0,,Міне кеттік!
Dialogue: 0,0:03:13.18,0:03:15.18,Default,,0,0,0,,Ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха !
Dialogue: 0,0:03:15.18,0:03:17.18,Default,,0,0,0,,Саджи-кун, маған да қамқор болшы!
Dialogue: 0,0:03:17.18,0:03:20.18,Default,,0,0,0,,Бірақ егер Ашермен аралассаң, мен сені қатты өлтіремін, Саджи-кун!
Dialogue: 0,0:03:20.18,0:03:22.18,Default,,0,0,0,,Арх!
Dialogue: 0,0:03:22.18,0:03:24.18,Default,,0,0,0,,Сіз әдемі аққұба қызды монополиялауға тырысасыз ба?
Dialogue: 0,0:03:24.18,0:03:26.18,Default,,0,0,0,,Ол Ашер үшін эротикалық шайтан-кун!
Dialogue: 0,0:03:26.18,0:03:28.18,Default,,0,0,0,,Бұл да қиын.
Dialogue: 0,0:03:28.18,0:03:32.18,Default,,0,0,0,,Менің дебютімнен кейін көп ұзамай танысуға рұқсат етілді.
Dialogue: 0,0:03:32.18,0:03:35.18,Default,,0,0,0,,Сіз әлі де парақшалар таратып жатқаныңызды естідім.
Dialogue: 0,0:03:35.18,0:03:40.18,Default,,0,0,0,,Ақымақ болма! Менеджер маған да бір танысыңыз болсын деді!
Dialogue: 0,0:03:40.18,0:03:42.18,Default,,0,0,0,,Не, сенің де орның?
Dialogue: 0,0:03:42.18,0:03:46.18,Default,,0,0,0,,Иә, мен келесі апта туралы ойладым, бірақ...
Dialogue: 0,0:03:46.18,0:03:49.18,Default,,0,0,0,,Ол маған айына бір рет қана қамқорлық жасайды...
Dialogue: 0,0:03:49.18,0:03:50.18,Default,,0,0,0,,Олай болса...
Dialogue: 0,0:03:50.18,0:03:52.18,Default,,0,0,0,,Қабілеттің әділ бәсекесі туралы не деуге болады?
Dialogue: 0,0:03:52.18,0:03:53.18,Default,,0,0,0,,Жарыс?
Dialogue: 0,0:03:53.18,0:03:56.18,Default,,0,0,0,,Жеңімпаз одан сұрау құқығын алады
Dialogue: 0,0:03:56.18,0:03:59.18,Default,,0,0,0,,Мүмкін рейтингтік ойын шығар?
Dialogue: 0,0:03:59.18,0:04:03.18,Default,,0,0,0,,Жоқ, алдымен рұқсат ала алмайсыз ба?
Dialogue: 0,0:04:03.18,0:04:04.18,Default,,0,0,0,,Мен қойған сұрақтарға ғана жауап бер.
Dialogue: 0,0:04:04.18,0:04:07.18,Default,,0,0,0,,Сонымен қатар, сіздің денеңіз дәл қазір маңызды...
Dialogue: 0,0:04:07.18,0:04:09.18,Default,,0,0,0,,Бұл маңызды емес...
Dialogue: 0,0:04:10.18,0:04:14.18,Default,,0,0,0,,Дұрыс, мектеп оқушылары сияқты спортпен шұғылданайық!
Dialogue: 0,0:04:18.18,0:04:22.18,Default,,0,0,0,,Қолыңнан келгеннің бәрін жаса! Менеджер, бұл Акено!
Dialogue: 0,0:04:22.18,0:04:25.18,Default,,0,0,0,,Төраға, жеңіңіз!
Dialogue: 0,0:04:25.18,0:04:28.18,Default,,0,0,0,,Акено, мен бұл матчта жеңіске жетемін.
Dialogue: 0,0:04:28.18,0:04:30.18,Default,,0,0,0,,Иә, директор!
Dialogue: 0,0:04:30.18,0:04:31.18,Default,,0,0,0,,Кеттік, иә!
Dialogue: 0,0:04:31.18,0:04:33.18,Default,,0,0,0,,Иә, жарайсың, Риас!
Dialogue: 0,0:04:33.18,0:04:36.18,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:36.18,0:04:37.18,Default,,0,0,0,,не үшін шайқасып жүрсің?
Dialogue: 0,0:04:37.18,0:04:40.18,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:40.18,0:04:43.18,Default,,0,0,0,,Әрине, мен менеджердің жеңгенін қалаймын, бірақ...
Dialogue: 0,0:04:43.18,0:04:45.18,Default,,0,0,0,,Мәңгі осылай...
Dialogue: 0,0:04:45.18,0:04:47.18,Default,,0,0,0,,Бұл қарау керек нәрсе!
Dialogue: 0,0:04:47.18,0:04:48.18,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:48.18,0:04:50.18,Default,,0,0,0,,Сонымен, балалар!
Dialogue: 0,0:04:50.18,0:04:56.18,Default,,0,0,0,,Біздің мектептің жоғары санатты арулары жарқыраған таза ақ іш киімде жарысады!
Dialogue: 0,0:04:56.18,0:04:59.18,Default,,0,0,0,,Бұл жарық жылдамдығымен бүкіл мектепке таралмауы мүмкін емес!
Dialogue: 0,0:04:59.18,0:05:02.18,Default,,0,0,0,,Оның үстіне, олардың теннис шеберлігі кәсіби деңгейде болуы мүмкін!
Dialogue: 0,0:05:02.18,0:05:05.18,Default,,0,0,0,,Жоқ, егер сіз көрнекі бейнелерді қоссаңыз, бұл шынымен құдай!
Dialogue: 0,0:05:05.18,0:05:06.18,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:05:06.18,0:05:11.18,Default,,0,0,0,,Мен мұны білмей тұрып, галереялардың саны айтарлықтай өсті!
Dialogue: 0,0:05:11.18,0:05:13.18,Default,,0,0,0,,Уф!
Dialogue: 0,0:05:13.18,0:05:19.18,Default,,0,0,0,,Балалар!
Dialogue: 0,0:05:19.18,0:05:21.18,Default,,0,0,0,,Бұл сиқырды қолданбайды...
Dialogue: 0,0:05:21.18,0:05:22.18,Default,,0,0,0,,Маған ақша беріңізші!
Dialogue: 0,0:05:22.18,0:05:24.18,Default,,0,0,0,,Жалғыз айдаһар бұршақ!
Dialogue: 0,0:05:24.18,0:05:25.18,Default,,0,0,0,,Балалар!
Dialogue: 0,0:05:27.18,0:05:28.18,Default,,0,0,0,,Өте тәтті!
Dialogue: 0,0:05:28.18,0:05:30.18,Default,,0,0,0,,Gremori стиліндегі есептегішті пайдаланыңыз!
Dialogue: 0,0:05:33.18,0:05:34.18,Default,,0,0,0,,15-30!
Dialogue: 0,0:05:34.18,0:05:35.18,Default,,0,0,0,,Қиямет!
Dialogue: 0,0:05:36.18,0:05:37.18,Default,,0,0,0,,Хахахахаха!
Dialogue: 0,0:05:37.18,0:05:39.18,Default,,0,0,0,,Менің төрағасым жұмыссыз қалды!
Dialogue: 0,0:05:40.18,0:05:42.18,Default,,0,0,0,,Сіз өзіңіздің сиқырыңызды жақсы пайдаланасыз...
Dialogue: 0,0:05:42.18,0:05:44.18,Default,,0,0,0,,Аздап ыстық болуы мүмкін...
Dialogue: 0,0:05:45.18,0:05:46.18,Default,,0,0,0,,Бұл сиқырлы доп!
Dialogue: 0,0:05:46.18,0:05:47.18,Default,,0,0,0,,Балалар!
Dialogue: 0,0:05:47.18,0:05:49.18,Default,,0,0,0,,Тапсырма!
Dialogue: 0,0:05:49.18,0:05:51.18,Default,,0,0,0,,Сіз сиқырлы допқа қанағаттанған сияқтысыз...
Dialogue: 0,0:05:51.18,0:05:54.18,Default,,0,0,0,,Бәрі тыныш болғанына қуаныштымын...
Dialogue: 0,0:05:54.18,0:05:56.18,Default,,0,0,0,,Сондықтан сен менің қарсыласымсың...
Dialogue: 0,0:05:56.18,0:05:59.18,Default,,0,0,0,,Бірақ мен сізге міндетті түрде жеңіске жетуге мүмкіндік беремін!
Dialogue: 0,0:05:59.18,0:06:01.18,Default,,0,0,0,,Менің сиқырлы шарым...
Dialogue: 0,0:06:01.18,0:06:02.18,Default,,0,0,0,,Жүз адам бар!
Dialogue: 0,0:06:02.18,0:06:04.18,Default,,0,0,0,,Ариас жауап береді...
Dialogue: 0,0:06:04.18,0:06:05.18,Default,,0,0,0,,Бұл менің...
Dialogue: 0,0:06:05.18,0:06:07.18,Default,,0,0,0,,Сізге деген махаббат!
Dialogue: 0,0:06:09.18,0:06:10.18,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:06:10.18,0:06:14.18,Default,,0,0,0,,Біз мәңгі жеңе алмадық, сондықтан...
Dialogue: 0,0:06:14.18,0:06:15.18,Default,,0,0,0,,Командалық шайқас?
Dialogue: 0,0:06:15.18,0:06:19.18,Default,,0,0,0,,Міне, дәл қазір директор мен Акено мырза студенттер кеңесімен жарысып жатыр...
Dialogue: 0,0:06:19.18,0:06:22.18,Default,,0,0,0,,италиялықтарға тән —
Dialogue: 0,0:06:22.18,0:06:25.18,Default,,0,0,0,,Іс-шара доджбол деп шешілді...
Dialogue: 0,0:06:25.18,0:06:27.18,Default,,0,0,0,,Матч ертең түнде гимназияда болады...
Dialogue: 0,0:06:27.18,0:06:30.18,Default,,0,0,0,,Рисей мен Азия үшін барымызды салайық...
Dialogue: 0,0:06:30.18,0:06:31.18,Default,,0,0,0,,Взвод командирі, тіпті біз Әйел Титанын қолға түсірсек те,
Dialogue: 0,0:06:31.18,0:06:33.18,Default,,0,0,0,,Рахмет...
Dialogue: 0,0:06:33.18,0:06:35.18,Default,,0,0,0,,…қашып кету…
Dialogue: 0,0:06:35.18,0:06:49.18,Default,,0,0,0,,Асия, сен ояусың ба?
Dialogue: 0,0:06:49.18,0:06:51.18,Default,,0,0,0,,Иссей мырза...
Dialogue: 0,0:06:51.18,0:06:52.18,Default,,0,0,0,,Жалғастырыңыз...
Dialogue: 0,0:06:52.18,0:06:53.18,Default,,0,0,0,,Өтінемін...
Dialogue: 0,0:06:53.18,0:06:54.18,Default,,0,0,0,,Мың йен бе?
Dialogue: 0,0:06:54.18,0:06:56.18,Default,,0,0,0,,Жоқ, бұл... түн батып кетті...
Dialogue: 0,0:06:56.18,0:06:57.18,Default,,0,0,0,,Ум...
Dialogue: 0,0:06:57.18,0:06:59.18,Default,,0,0,0,,Асия, сенде ине мен жіп бар ма?
Dialogue: 0,0:06:59.18,0:07:02.18,Default,,0,0,0,,Түсінікті.
Dialogue: 0,0:07:04.18,0:07:07.18,Default,,0,0,0,,Арғы жағында тағы екі адам бар еді, мен олардан соттауын өтіндім...
Dialogue: 0,0:07:07.18,0:07:08.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:08.18,0:07:09.18,Default,,0,0,0,,Доджбол...
Dialogue: 0,0:07:09.18,0:07:11.18,Default,,0,0,0,,Бұл бастауыш мектептен бері болды!
Dialogue: 0,0:07:11.18,0:07:16.18,Default,,0,0,0,,Мақсат жеңу немесе жеңілу болғандықтан, ережелер қарапайым болуы керек, солай емес пе?
Dialogue: 0,0:07:16.18,0:07:19.18,Default,,0,0,0,,Азия да тез үйренді...
Dialogue: 0,0:07:19.18,0:07:21.18,Default,,0,0,0,,Аа, енді жоқ...
Dialogue: 0,0:07:21.18,0:07:24.18,Default,,0,0,0,,Кішкене тырысайық...
Dialogue: 0,0:07:24.18,0:07:26.18,Default,,0,0,0,,Иә...
Dialogue: 0,0:07:26.18,0:07:27.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:27.18,0:07:30.18,Default,,0,0,0,,У...у...у...у...у...
Dialogue: 0,0:07:30.18,0:07:33.18,Default,,0,0,0,,Мен екеуіне қарасам, мен бір нәрсені сезінемін ...
Dialogue: 0,0:07:33.18,0:07:36.18,Default,,0,0,0,,Біртүрлі адасушылықтарды сезінбесе амалым жоқ...
Dialogue: 0,0:07:36.18,0:07:38.18,Default,,0,0,0,,Аххх...
Dialogue: 0,0:07:38.18,0:07:43.18,Default,,0,0,0,,Ой... ой... ой, ой...
Dialogue: 0,0:07:44.18,0:07:45.18,Default,,0,0,0,,Хачимаки?
Dialogue: 0,0:07:45.18,0:07:46.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:46.18,0:07:48.18,Default,,0,0,0,,О, бұл тамаша!
Dialogue: 0,0:07:48.18,0:07:50.18,Default,,0,0,0,,Мен оны жасау үшін түні бойы ұйықтадым!
Dialogue: 0,0:07:50.18,0:07:51.18,Default,,0,0,0,,Ұйықтамайсыз ба?
Dialogue: 0,0:07:51.18,0:07:55.18,Default,,0,0,0,,Менеджер мен Акено мырза біз үшін көп еңбек етті...
Dialogue: 0,0:07:55.18,0:07:57.18,Default,,0,0,0,,Бүгін Конеко-чан мен Фанг...
Dialogue: 0,0:07:57.18,0:08:02.18,Default,,0,0,0,,Сонымен, мен барлығына бір ғана нәрсе істей алсам...
Dialogue: 0,0:08:02.18,0:08:05.18,Default,,0,0,0,,Мм...бас бау шынымен ақсақ екен...
Dialogue: 0,0:08:05.18,0:08:06.18,Default,,0,0,0,,Таяз су
Dialogue: 0,0:08:06.18,0:08:08.48,Default,,0,0,0,,Жарайсыңдар.
Dialogue: 0,0:08:08.48,0:08:10.28,Default,,0,0,0,,Өте жақсы және жақсы
Dialogue: 0,0:08:10.28,0:08:12.88,Default,,0,0,0,,Жоқ, мұның бәрі бар.
Dialogue: 0,0:08:12.88,0:08:14.88,Default,,0,0,0,,Күтпеген орындау
Dialogue: 0,0:08:14.88,0:08:18.28,Default,,0,0,0,,Осыны қорытындылап, топ болып жұмыс жасайық.
Dialogue: 0,0:08:18.28,0:08:18.98,Default,,0,0,0,,Иә
Dialogue: 0,0:08:18.98,0:08:20.08,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:08:20.08,0:08:21.08,Default,,0,0,0,,О?
Dialogue: 0,0:08:35.18,0:08:36.18,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:08:36.18,0:08:37.18,Default,,0,0,0,,Ах
Dialogue: 0,0:08:37.18,0:08:38.18,Default,,0,0,0,,Га
Dialogue: 0,0:08:38.18,0:08:40.18,Default,,0,0,0,,Ах
Dialogue: 0,0:08:40.18,0:08:42.18,Default,,0,0,0,,Айто!
Dialogue: 0,0:08:42.18,0:08:43.18,Default,,0,0,0,,Котенка
Dialogue: 0,0:08:43.18,0:08:44.18,Default,,0,0,0,,Мәселе жоқ
Dialogue: 0,0:08:44.18,0:08:45.18,Default,,0,0,0,,Әй
Dialogue: 0,0:08:45.18,0:08:48.18,Default,,0,0,0,,Естеліктер лақтыру
Dialogue: 0,0:08:52.18,0:08:53.18,Default,,0,0,0,,Күтілгендей.
Dialogue: 0,0:08:53.18,0:08:55.18,Default,,0,0,0,,Цубакидің майданнан атқан оғы
Dialogue: 0,0:08:55.18,0:08:58.18,Default,,0,0,0,,Мені кім деп ойлайсың?
Dialogue: 0,0:09:05.18,0:09:07.18,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:09:07.18,0:09:08.18,Default,,0,0,0,,О!
Dialogue: 0,0:09:08.18,0:09:09.18,Default,,0,0,0,,Тессаку!
Dialogue: 0,0:09:11.18,0:09:14.18,Default,,0,0,0,,Әй, ой, сақауыңды түсірме.
Dialogue: 0,0:09:14.18,0:09:16.18,Default,,0,0,0,,Мен-кешіріңіз!
Dialogue: 0,0:09:24.18,0:09:26.18,Default,,0,0,0,,Су құмарлығыңызды тастаңыз!
Dialogue: 0,0:09:26.18,0:09:29.18,Default,,0,0,0,,Қайсысы нашар болса, қорқынышты!
Dialogue: 0,0:09:29.18,0:09:32.18,Default,,0,0,0,,Мен енді қандай ойындар болып жатқанын білмеймін!
Dialogue: 0,0:09:32.18,0:09:34.18,Default,,0,0,0,,Төраға, алдымен мұзды топырақты ұсақтайық!
Dialogue: 0,0:09:35.18,0:09:37.18,Default,,0,0,0,,Төмен келе жатқан айдаһар кері айналдыруда!
Dialogue: 0,0:09:37.18,0:09:38.18,Default,,0,0,0,,О!
Dialogue: 0,0:09:38.18,0:09:39.18,Default,,0,0,0,,Не!?
Dialogue: 0,0:09:39.18,0:09:41.18,Default,,0,0,0,,Жоқ, неге!?
Dialogue: 0,0:09:41.18,0:09:42.18,Default,,0,0,0,,Тартыңыз! аулақ болыңыз!
Dialogue: 0,0:09:42.18,0:09:44.18,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:48.18,0:09:49.18,Default,,0,0,0,,Куухаа!
Dialogue: 0,0:09:49.18,0:09:52.18,Default,,0,0,0,,А, аяқталды!
Dialogue: 0,0:09:52.18,0:09:54.18,Default,,0,0,0,,Барлығы.
Dialogue: 0,0:09:54.18,0:09:57.18,Default,,0,0,0,,Біз сізді Dubai Лайт Healing арқылы емдейміз, сондықтан
Dialogue: 0,0:09:57.18,0:09:59.18,Default,,0,0,0,,Қай жерде жарақат алғаныңызды көрсетіңізші!
Dialogue: 0,0:09:59.18,0:10:02.18,Default,,0,0,0,,О, жоқ, бұл мүмкін емес!
Dialogue: 0,0:10:02.18,0:10:04.18,Default,,0,0,0,,Бірақ егер сіз зардап шеккен аймаққа қарамасаңыз,
Dialogue: 0,0:10:04.18,0:10:05.52,Default,,0,0,0,,Дұрыс емдеу...
Dialogue: 0,0:10:05.52,0:10:07.92,Default,,0,0,0,,Сәлем! Атқарушы деңгейден өтті! Құпия бөлігі аздап...
Dialogue: 0,0:10:07.92,0:10:09.28,Default,,0,0,0,,Көп нәрсе дұрыс емес!
Dialogue: 0,0:10:09.28,0:10:11.08,Default,,0,0,0,,Өтінемін! Өтінемін, мені кешірші!
Dialogue: 0,0:10:11.68,0:10:13.28,Default,,0,0,0,,Менің жұмысым жоқ...
Dialogue: 0,0:10:13.28,0:10:15.02,Default,,0,0,0,,Енді киімнің үстінен...
Dialogue: 0,0:10:19.42,0:10:20.62,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:10:20.62,0:10:21.94,Default,,0,0,0,,Тек ол ғана жұтылып кеткен азаматтардың өкпе-ренішін қайтара алады
Dialogue: 0,0:10:21.94,0:10:24.04,Default,,0,0,0,,Сөзбен жеткізу мүмкін емес көрініс...
Dialogue: 0,0:10:24.04,0:10:25.44,Default,,0,0,0,,Мен де солай ойлаймын...
Dialogue: 0,0:10:25.44,0:10:27.78,Default,,0,0,0,,Антея Иссейді емізуді жалғастыруда...
Dialogue: 0,0:10:27.78,0:10:29.24,Default,,0,0,0,,Ах! Иә!
Dialogue: 0,0:10:29.24,0:10:31.68,Default,,0,0,0,,Баршаңызға, бұл Иссейдің жерлеу шайқасы!
Dialogue: 0,0:10:31.68,0:10:34.04,Default,,0,0,0,,Ал, Иссейкунның өлімі...
Dialogue: 0,0:10:34.04,0:10:35.60,Default,,0,0,0,,Біз оны ысырап ете алмаймыз!
Dialogue: 0,0:10:35.60,0:10:36.60,Default,,0,0,0,,Әрине!
Dialogue: 0,0:10:36.60,0:10:38.28,Default,,0,0,0,,Ал...
Dialogue: 0,0:10:38.28,0:10:40.58,Default,,0,0,0,,Мен өлген жоқпын...
Dialogue: 0,0:10:43.18,0:10:43.68,Default,,0,0,0,,Кел!
Dialogue: 0,0:10:48.68,0:10:50.28,Default,,0,0,0,,Енді сен жалғызсың!
Dialogue: 0,0:10:50.28,0:10:52.50,Default,,0,0,0,,Дайын болу керек сияқты!
Dialogue: 0,0:10:52.50,0:10:54.00,Default,,0,0,0,,Шайқас қазір басталады!
Dialogue: 0,0:10:54.00,0:10:55.20,Default,,0,0,0,,Қосымша жұмыс уақыты!
Dialogue: 0,0:10:55.20,0:10:56.70,Default,,0,0,0,,Қуа келе жатқандар кетті.
Dialogue: 0,0:10:56.70,0:10:59.30,Default,,0,0,0,,Қанда! Қанда!
Dialogue: 0,0:10:59.30,0:11:00.80,Default,,0,0,0,,Сонымен, уәде етілгендей!
Dialogue: 0,0:11:00.80,0:11:03.50,Default,,0,0,0,,Менің танысымнан басымдық бар ма?
Dialogue: 0,0:11:03.50,0:11:04.64,Default,,0,0,0,,Әрине!
Dialogue: 0,0:11:04.64,0:11:07.64,Default,,0,0,0,,Бұл көңілсіз, бірақ мен аздап көңілді болдым...
Dialogue: 0,0:11:07.64,0:11:10.94,Default,,0,0,0,,Бірақ егер бұл ойынның орнына рейтингтік ойын болса...
Dialogue: 0,0:11:10.94,0:11:12.30,Default,,0,0,0,,Мен жеңілмеймін!
Dialogue: 0,0:11:12.30,0:11:13.74,Default,,0,0,0,,Мен де...
Dialogue: 0,0:11:13.74,0:11:16.30,Default,,0,0,0,,Мен сенен ұтыла алмаймын, бала кездегі досым!
Dialogue: 0,0:11:16.30,0:11:17.30,Default,,0,0,0,,Квирктерін қылмыстық мақсатта пайдаланатын жауыздармен күресу үшін —
Dialogue: 0,0:11:17.30,0:11:19.86,Default,,0,0,0,,Әлі біраз уақыт өтетін сияқты...
Dialogue: 0,0:11:19.86,0:11:20.64,Default,,0,0,0,,Мен қойған сұрақтарға ғана жауап бер.
Dialogue: 0,0:11:20.64,0:11:22.74,Default,,0,0,0,,Еңбектеріңіз үшін рахмет...
Dialogue: 0,0:11:22.74,0:11:26.74,Default,,0,0,0,,Бағалау ойыны…
Dialogue: 0,0:11:26.74,0:11:29.02,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:11:29.02,0:11:29.82,Default,,0,0,0,,Еңбегіңіз үшін рахмет!
Dialogue: 0,0:11:29.82,0:11:34.44,Default,,0,0,0,,Біздің оккульттік ғылыми-зерттеу клубы студенттік кеңесті сәтті жеңіп, жеңіске жетті.
Dialogue: 0,0:11:35.28,0:11:36.58,Default,,0,0,0,,Бұл да барлығына алғыс.
Dialogue: 0,0:11:37.02,0:11:38.84,Default,,0,0,0,,Бірақ мен зейнетке шықтым.
Dialogue: 0,0:11:39.52,0:11:43.64,Default,,0,0,0,,Соның арқасында әркімнің рухы көтерілді, Ичихоши-кун да еңбегі сіңген адам.
Dialogue: 0,0:11:43.88,0:11:44.38,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:11:45.08,0:11:46.66,Default,,0,0,0,,Дұрыс, Ичихоси мырза.
Dialogue: 0,0:11:47.22,0:11:47.72,Default,,0,0,0,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:11:48.42,0:11:53.64,Default,,0,0,0,,Уф, Киба! Сымбатты жігіт болсаң да, анда-санда жақсы сөздер айтасың!
Dialogue: 0,0:11:55.02,0:11:59.40,Default,,0,0,0,,Жарайды, мен мұңая алмаймын. Мен танысымды алып келейін.
Dialogue: 0,0:11:59.82,0:12:02.56,Default,,0,0,0,,Мм, енді бастайсың ба?
Dialogue: 0,0:12:03.04,0:12:05.40,Default,,0,0,0,,Толық ай болмаса, мен оны көре алмаймын.
Dialogue: 0,0:12:05.68,0:12:06.18,Default,,0,0,0,,Ол?
Dialogue: 0,0:12:07.12,0:12:08.44,Default,,0,0,0,,Мастер таныс.
Dialogue: 0,0:12:12.72,0:12:13.48,Default,,0,0,0,,Міне, осында.
Dialogue: 0,0:12:14.04,0:12:16.26,Default,,0,0,0,,Бұл таныстар жасаған орман.
Dialogue: 0,0:12:16.94,0:12:18.96,Default,,0,0,0,,Біз де осы жерден таныс болдық.
Dialogue: 0,0:12:20.34,0:12:23.20,Default,,0,0,0,,Әрине, кез келген нәрсе шығуы мүмкін.
Dialogue: 0,0:12:23.54,0:12:24.64,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:12:25.22,0:12:25.92,Default,,0,0,0,,Оны алыңыз!
Dialogue: 0,0:12:26.16,0:12:27.78,Default,,0,0,0,,Қайсысы!
Dialogue: 0,0:12:27.78,0:12:32.16,Default,,0,0,0,,Мен Затожимын, таныс шебермін!
Dialogue: 0,0:12:32.66,0:12:33.30,Default,,0,0,0,,Таныссыз ба?
Dialogue: 0,0:12:33.54,0:12:34.14,Default,,0,0,0,,Мастер?
Dialogue: 0,0:12:34.64,0:12:38.78,Default,,0,0,0,,Хмм, бүгін түнде тамаша толық ай бар. Танысу үшін тамаша!
Dialogue: 0,0:12:39.50,0:12:42.90,Default,,0,0,0,,Сіз маған кастинг арқылы кез келген танысыңызды сол күні ала аласыз!
Dialogue: 0,0:12:43.34,0:12:46.18,Default,,0,0,0,,Таныстарға келгенде кәсіпқой.
Dialogue: 0,0:12:46.56,0:12:47.06,Default,,0,0,0,,Ах.
Dialogue: 0,0:12:47.78,0:12:50.50,Default,,0,0,0,,Енді қандай таныс алғың келеді?
Dialogue: 0,0:12:50.50,0:12:53.72,Default,,0,0,0,,Бұл күшті ме? Жылдам? Әлде улы ма?
Dialogue: 0,0:12:54.18,0:12:57.16,Default,,0,0,0,,Дұрыс. Сүйкімді таныс емес пе?
Dialogue: 0,0:12:57.46,0:12:58.46,Default,,0,0,0,,Қыздар сияқты нәрсе.
Dialogue: 0,0:12:58.88,0:13:01.96,Default,,0,0,0,,Чо-чо-чо. Сондықтан әуесқойлар жақсы емес.
Dialogue: 0,0:13:02.72,0:13:06.18,Default,,0,0,0,,Пайдалы және күшті таныс алудың мәні неде?
Dialogue: 0,0:13:06.54,0:13:11.10,Default,,0,0,0,,Басқаша айтқанда, жеке адамдардың қабілеттерін түсініп, олардың өзіндік ерекшеліктерін толықтыру.
Dialogue: 0,0:13:11.10,0:13:14.52,Default,,0,0,0,,Мм, мен де сүйкімді таныс алғым келеді.
Dialogue: 0,0:13:15.02,0:13:16.28,Default,,0,0,0,,Хмм, түсіндім.
Dialogue: 0,0:13:16.46,0:13:17.08,Default,,0,0,0,,Хаа… Хаа… Хаа….
Dialogue: 0,0:13:18.04,0:13:18.90,Default,,0,0,0,,Сіз.
Dialogue: 0,0:13:21.90,0:13:26.12,Default,,0,0,0,,Бұл көлде Undine атты су рухы өмір сүреді.
Dialogue: 0,0:13:26.68,0:13:30.08,Default,,0,0,0,,Ах, су рухы. Атауынан болар.
Dialogue: 0,0:13:30.74,0:13:33.44,Default,,0,0,0,,А, мен оның болашақ гарем патшасы ретінде қасымда болғанын қалаймын.
Dialogue: 0,0:13:33.78,0:13:39.88,Default,,0,0,0,,Құлағын таңдайын дегендей тіземе ұйықтатып жібердім де, ақырын қолымды созып, сырға толы омырауын ұстадым.
Dialogue: 0,0:13:39.88,0:13:42.52,Default,,0,0,0,,Ах, көл.
Dialogue: 0,0:13:44.14,0:13:46.84,Default,,0,0,0,,О, Undine пайда болады.
Dialogue: 0,0:13:47.14,0:13:47.84,Default,,0,0,0,,О,
Dialogue: 0,0:13:56.56,0:13:58.76,Default,,0,0,0,,О,
Dialogue: 0,0:13:59.88,0:14:01.34,Default,,0,0,0,,Бұл Undine.
Dialogue: 0,0:14:01.66,0:14:04.94,Default,,0,0,0,,Жоқ, қалай қарасаң да, суға түсуге келген күрескер.
Dialogue: 0,0:14:05.24,0:14:08.02,Default,,0,0,0,,Сәттілік, балам. Бұл өте сирек.
Dialogue: 0,0:14:08.02,0:14:11.06,Default,,0,0,0,,Соққы ретінде қолданылған су спирті де жаман емес.
Dialogue: 0,0:14:11.24,0:14:13.82,Default,,0,0,0,,Нашар. Бұл емдік түрі және күшті өлтіретін түрі емес пе?
Dialogue: 0,0:14:14.20,0:14:16.44,Default,,0,0,0,,Бірақ бұл әйел түрі.
Dialogue: 0,0:14:16.84,0:14:19.24,Default,,0,0,0,,Бұл менің ең білгім келмейтін нәрсе болды.
Dialogue: 0,0:14:20.76,0:14:22.94,Default,,0,0,0,,Бірақ бұл баланың көзі таза еді.
Dialogue: 0,0:14:23.58,0:14:26.22,Default,,0,0,0,,Оның жүрегі сұлу қыз екеніне сенімдімін.
Dialogue: 0,0:14:27.06,0:14:29.36,Default,,0,0,0,,Оны қыз деп атама.
Dialogue: 0,0:14:29.36,0:14:31.08,Default,,0,0,0,,'Белдік менің денеме тартылып жатыр.'
Dialogue: 0,0:14:32.58,0:14:33.12,Default,,0,0,0,,Қараңыз.
Dialogue: 0,0:14:35.58,0:14:36.38,Default,,0,0,0,,күрсіну.
Dialogue: 0,0:14:36.74,0:14:37.24,Default,,0,0,0,,Толық?
Dialogue: 0,0:14:37.62,0:14:38.58,Default,,0,0,0,,Жаса, Айдаһар.
Dialogue: 0,0:14:39.04,0:14:40.48,Default,,0,0,0,,Ха, бұл сүйкімді.
Dialogue: 0,0:14:40.82,0:14:42.08,Default,,0,0,0,,Спрайт Айдаһар.
Dialogue: 0,0:14:42.50,0:14:44.96,Default,,0,0,0,,Бұл көк найзағайды пайдаланатын айдаһар баласы.
Dialogue: 0,0:14:44.96,0:14:47.16,Default,,0,0,0,,Бұл өте жоғары сынып.
Dialogue: 0,0:14:47.58,0:14:49.38,Default,,0,0,0,,Мен оны бірінші рет көріп тұрмын.
Dialogue: 0,0:14:50.14,0:14:51.48,Default,,0,0,0,,Енді оны алатын кез келді.
Dialogue: 0,0:14:51.90,0:14:53.96,Default,,0,0,0,,Ол жетілгеннен кейін оны алу мүмкін емес.
Dialogue: 0,0:14:54.40,0:14:57.14,Default,,0,0,0,,Иссей-кун император Секирюдің билігіне ие,
Dialogue: 0,0:14:57.50,0:14:58.98,Default,,0,0,0,,Менің ойымша, біз жақсы сәйкестік.
Dialogue: 0,0:14:59.34,0:14:59.84,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:15:00.40,0:15:00.90,Default,,0,0,0,,Мен музыка колледжінде Саки Аримамен бір курс болғанмын, сондықтан→
Dialogue: 0,0:15:01.36,0:15:02.64,Default,,0,0,0,,Спрайт Айдаһар,
Dialogue: 0,0:15:02.64,0:15:03.18,Default,,0,0,0,,Сумари!
Dialogue: 0,0:15:03.18,0:15:04.18,Default,,0,0,0,,О!
Dialogue: 0,0:15:04.96,0:15:15.10,Default,,0,0,0,,О!
Dialogue: 0,0:15:15.10,0:15:16.88,Default,,0,0,0,,Бұл ауыр!
Dialogue: 0,0:15:17.88,0:15:18.38,Default,,0,0,0,,Ұшқын!
Dialogue: 0,0:15:20.42,0:15:21.14,Default,,0,0,0,,Касуми!
Dialogue: 0,0:15:21.62,0:15:22.12,Default,,0,0,0,,О!
Dialogue: 0,0:15:22.24,0:15:24.58,Default,,0,0,0,,ұяң өмір 사�ника емес!
Dialogue: 0,0:15:24.58,0:15:25.54,Default,,0,0,0,,О!
Dialogue: 0,0:15:26.70,0:15:27.46,Default,,0,0,0,,О!
Dialogue: 0,0:15:27.46,0:15:32.54,Default,,0,0,0,,Гол!
Dialogue: 0,0:15:33.00,0:15:33.54,Default,,0,0,0,,Гол!
Dialogue: 0,0:15:40.78,0:15:42.16,Default,,0,0,0,,бетті кесіңіз
Dialogue: 0,0:15:42.16,0:15:43.88,Default,,0,0,0,,Атақты зұлымдық Біз,
Dialogue: 0,0:15:43.88,0:15:46.06,Default,,0,0,0,,Жалпы, дөрекі, өрескел
Dialogue: 0,0:15:46.06,0:15:46.88,Default,,0,0,0,,Қат!
Dialogue: 0,0:15:48.88,0:15:50.88,Default,,0,0,0,,Қандай тамаша даму!
Dialogue: 0,0:15:52.88,0:15:54.18,Default,,0,0,0,,Қарама
Dialogue: 0,0:15:54.18,0:15:57.48,Default,,0,0,0,,Олай десеңіз де, бәрі қиналып жатыр деп аузыңызды жап!
Dialogue: 0,0:16:03.48,0:16:06.28,Default,,0,0,0,,Сіз мұнымен сиқырды да пайдалана алмайсыз!
Dialogue: 0,0:16:06.28,0:16:09.28,Default,,0,0,0,,Әй, бұл мәселе!
Dialogue: 0,0:16:09.28,0:16:10.78,Default,,0,0,0,,Бучо!
Dialogue: 0,0:16:10.78,0:16:13.78,Default,,0,0,0,,Ой, мида сақталған, мида сақталған!
Dialogue: 0,0:16:13.78,0:16:16.78,Default,,0,0,0,,Бұл матамен қоректенетін шлам, солай ма?
Dialogue: 0,0:16:16.78,0:16:19.78,Default,,0,0,0,,Әйелдер киімін ерітуден басқа, бұл жерде ерекше жағымсыз ештеңе жоқ ...
Dialogue: 0,0:16:19.78,0:16:21.78,Default,,0,0,0,,Киімді ерітетін шлам!?
Dialogue: 0,0:16:21.78,0:16:22.78,Default,,0,0,0,,Шлам!?
Dialogue: 0,0:16:22.78,0:16:24.78,Default,,0,0,0,,Мен бұл шламды қолданамын!
Dialogue: 0,0:16:24.78,0:16:28.78,Default,,0,0,0,,Жоқ, мен мұнда бара алмаймын!
Dialogue: 0,0:16:30.78,0:16:33.78,Default,,0,0,0,,Дәл осы мен іздегенім!
Dialogue: 0,0:16:33.78,0:16:38.78,Default,,0,0,0,,Жаңбыр, шлам шайтан үшін маңызды!
Dialogue: 0,0:16:38.78,0:16:40.78,Default,,0,0,0,,Сәлем! Ойлан!
Dialogue: 0,0:16:43.78,0:16:44.78,Default,,0,0,0,,Сіз бұл туралы ойлайсыз ба?
Dialogue: 0,0:16:44.78,0:16:46.78,Default,,0,0,0,,Мен Яхари Гайба жасаймын!
Dialogue: 0,0:16:52.78,0:16:54.78,Default,,0,0,0,,О, кешіріңіз!
Dialogue: 0,0:16:54.78,0:16:55.78,Default,,0,0,0,,Бұл таңқаларлық.
Dialogue: 0,0:16:55.78,0:16:57.78,Default,,0,0,0,,Увааааааааааааааааааааааааа
Dialogue: 0,0:16:57.78,0:17:00.78,Default,,0,0,0,,Дегенмен, патшаңыздың қазір есінен адасқаны анық.
Dialogue: 0,0:17:00.78,0:17:05.78,Default,,0,0,0,,Бұл жерден кет, Иссе.
Dialogue: 0,0:17:05.78,0:17:08.78,Default,,0,0,0,,Бұндай жаратылыстарды тек өртеуге болады.
Dialogue: 0,0:17:08.78,0:17:09.58,Default,,0,0,0,,(Мектеп оқушысы) Ой, Хори ханым саған бұны өзі жасап берді ме? Өте сүйкімді екен~
Dialogue: 0,0:17:09.58,0:17:12.18,Default,,0,0,0,,Бұл шлам менімен кездесуге келді.
Dialogue: 0,0:17:12.18,0:17:14.48,Default,,0,0,0,,Бұл дүниеге келген болуы керек
Dialogue: 0,0:17:14.48,0:17:16.52,Default,,0,0,0,,Бұл жай ғана тағдыр
Dialogue: 0,0:17:16.52,0:17:18.42,Default,,0,0,0,,Мен енді бөтен емеспін.
Dialogue: 0,0:17:18.42,0:17:21.78,Default,,0,0,0,,Иссей-сан мені құшақтайды
Dialogue: 0,0:17:21.78,0:17:24.88,Default,,0,0,0,,Суратару менің серіктесім.
Dialogue: 0,0:17:24.88,0:17:26.52,Default,,0,0,0,,Аты бар
Dialogue: 0,0:17:26.52,0:17:30.36,Default,,0,0,0,,Мен орманның мазасын соншалықты қалайтын жындыны бірінші рет көруім.
Dialogue: 0,0:17:30.36,0:17:32.88,Default,,0,0,0,,Дүние шынымен де үлкен.
Dialogue: 0,0:17:32.88,0:17:34.66,Default,,0,0,0,,Ол әдетте жақсы қыз.
Dialogue: 0,0:17:34.66,0:17:38.18,Default,,0,0,0,,Бірақ мен өз қалауыма қатысты тым адалмын.
Dialogue: 0,0:17:38.18,0:17:41.78,Default,,0,0,0,,Директор, мұндай бейшара балаға қарамаңызшы.
Dialogue: 0,0:17:41.78,0:17:45.02,Default,,0,0,0,,Мен мұны қанаттарымды кең жаю үшін қолданамын
Dialogue: 0,0:17:45.02,0:17:49.12,Default,,0,0,0,,бірдеңе
Dialogue: 0,0:17:49.12,0:17:52.22,Default,,0,0,0,,Спрайт Айдаһардың найзағай соғуы
Dialogue: 0,0:17:52.22,0:17:54.26,Default,,0,0,0,,Суратаро
Dialogue: 0,0:17:54.26,0:17:55.62,Default,,0,0,0,,Өмір бойы
Dialogue: 0,0:17:55.62,0:18:00.02,Default,,0,0,0,,Иссей мырза
Dialogue: 0,0:18:00.02,0:18:04.22,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:18:04.22,0:18:08.38,Default,,0,0,0,,Бұл жігіт өзі дұрыс танитын адамдарға ғана шабуыл жасайды.
Dialogue: 0,0:18:08.38,0:18:13.22,Default,,0,0,0,,Сондықтан мен бала мен шлам әдемі аққұба қызға шабуыл жасады деп ойладым.
Dialogue: 0,0:18:13.22,0:18:15.06,Default,,0,0,0,,Ей, сен, кішкентай бүлікші.
Dialogue: 0,0:18:15.06,0:18:16.22,Default,,0,0,0,,Сүйкімді
Dialogue: 0,0:18:16.22,0:18:22.66,Default,,0,0,0,,Бұл ереже, сұлу қыздар танысады.
Dialogue: 0,0:18:22.66,0:18:27.32,Default,,0,0,0,,Азия Аргентоның атымен
Dialogue: 0,0:18:27.32,0:18:31.32,Default,,0,0,0,,Менің танысым ретінде мен бұл туралы келісім-шартқа хабарлаймын.
Dialogue: 0,0:18:31.32,0:18:36.92,Default,,0,0,0,,Иә, солай.
Dialogue: 0,0:18:36.92,0:18:38.96,Default,,0,0,0,,Жарайсың Асия-чан
Dialogue: 0,0:18:38.96,0:18:44.42,Default,,0,0,0,,Бұл қытық, Лэсси-кун.
Dialogue: 0,0:18:44.42,0:18:45.42,Default,,0,0,0,,Ласси
Dialogue: 0,0:18:45.42,0:18:48.12,Default,,0,0,0,,Иә, бұл Огеки Оханацуко.
Dialogue: 0,0:18:48.12,0:18:50.98,Default,,0,0,0,,Мен де сол Миссидің есімін алдым.
Dialogue: 0,0:18:50.98,0:18:53.18,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:18:53.18,0:18:55.08,Default,,0,0,0,,Танысқаныма қуаныштымын, Лэсси
Dialogue: 0,0:18:55.08,0:18:56.08,Default,,0,0,0,,Кассуке
Dialogue: 0,0:18:56.08,0:19:00.38,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:19:00.38,0:19:04.48,Default,,0,0,0,,Мен бұл туралы айтуды ұмытып кетіппін, бірақ еркек айдаһарлар басқа тіршілік иелерінің еркектерін жек көреді.
Dialogue: 0,0:19:04.48,0:19:06.52,Default,,0,0,0,,Жаман Лэсси
Dialogue: 0,0:19:06.52,0:19:09.02,Default,,0,0,0,,Неге өлдің?
Dialogue: 0,0:19:09.02,0:19:10.52,Default,,0,0,0,,Менің досым Суратаро
Dialogue: 0,0:19:10.52,0:19:14.58,Default,,0,0,0,,Сол керемет қуатты пайдаланыңыз!
Dialogue: 0,0:19:14.58,0:19:16.46,Default,,0,0,0,,Қосымша болуы керек
Dialogue: 0,0:19:16.46,0:19:23.90,Default,,0,0,0,,Спрайт айдаһарлары тек жүрегі таза адамдарға ғана ашады.
Dialogue: 0,0:19:23.90,0:19:27.06,Default,,0,0,0,,Әдетте, жындарға мән бермеу керек
Dialogue: 0,0:19:27.06,0:19:31.26,Default,,0,0,0,,Бұған Азия-чанның апалы-сіңлілі болғаны әсер еткен болуы мүмкін.
Dialogue: 0,0:19:31.26,0:19:32.26,Default,,0,0,0,,Кира өзімен-өзі айналысып жүр ғой?
Dialogue: 0,0:19:32.26,0:19:34.06,Default,,0,0,0,,Каабу
Dialogue: 0,0:19:34.06,0:19:35.82,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:19:35.82,0:19:36.72,Default,,0,0,0,,Ласси
Dialogue: 0,0:19:36.72,0:19:38.08,Default,,0,0,0,,Азияға не істеп жатырсың?
Dialogue: 0,0:19:38.08,0:19:38.70,Default,,0,0,0,,Капуя
Dialogue: 0,0:19:38.70,0:19:42.90,Default,,0,0,0,,Расси Кунтара
Dialogue: 0,0:19:42.90,0:19:44.72,Default,,0,0,0,,Көрсеткіштерге рұқсат етілмейді
Dialogue: 0,0:19:44.72,0:19:49.58,Default,,0,0,0,,Олай болса, қайырлы түн, Расси-кун.
Dialogue: 0,0:19:49.58,0:19:57.92,Default,,0,0,0,,Менің кіші қызым Асия шайтанға көбірек ұқсайтынына көңілім қалды.
Dialogue: 0,0:19:57.92,0:20:03.32,Default,,0,0,0,,Қарғыс атсын, мен ақыры бәрінің тамағын жұлып алатын таныс аламын.
Dialogue: 0,0:20:03.32,0:20:05.56,Default,,0,0,0,,Мен сенің үмітіңді артамын
Dialogue: 0,0:20:05.56,0:20:07.24,Default,,0,0,0,,Олай болса, еңбектеріңізге рахмет.
Dialogue: 0,0:20:07.24,0:20:08.54,Default,,0,0,0,,Сен бүкіл отбасыңмен бірге осыған көшіп алғаның дұрыс.
Dialogue: 0,0:20:08.54,0:20:15.72,Default,,0,0,0,,Иссейдің әлі талай жолы бар.
Dialogue: 0,0:20:15.72,0:20:22.10,Default,,0,0,0,,Иә.
Dialogue: 0,0:20:22.10,0:20:29.72,Default,,0,0,0,,Тек қызғылт адамдар
Dialogue: 0,0:20:29.72,0:20:33.74,Default,,0,0,0,,Иссей-сан адамдарды жалаңаш көргенді ұнататын шығар.
Dialogue: 0,0:20:33.74,0:20:36.74,Default,,0,0,0,,Юко-доно, Гремори отбасының келесі басшысы
Dialogue: 0,0:20:36.74,0:20:39.70,Default,,0,0,0,,Менің қыздығымды ал
Dialogue: 0,0:20:39.70,0:20:40.58,Default,,0,0,0,,Мүмкіндігінше тезірек сұраңыз.
Dialogue: 0,0:20:42.08,0:20:47.08,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
