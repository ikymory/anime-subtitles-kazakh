Dialogue: 0,0:00:33.65,0:00:36.53,Default,,0,0,0,,(ызылдаған дауыс)
Dialogue: 0,0:00:40.49,0:00:43.20,Default,,0,0,0,,(айқайлаған дауыс)
Dialogue: 0,0:00:43.83,0:00:47.29,Default,,0,0,0,,Легенда мырзаның бірқатар іс-әрекеттеріне байланысты,
Dialogue: 0,0:00:47.38,0:00:48.29,Default,,0,0,0,,Бейбітшілік символы
Dialogue: 0,0:00:48.29,0:00:48.88,Default,,0,0,0,,Бейбітшілік символы
Dialogue: 0,0:00:48.29,0:00:48.88,Default,,0,0,0,,«Әділет мүсіні»
Dialogue: 0,0:00:48.88,0:00:48.96,Default,,0,0,0,,«Әділет мүсіні»
Dialogue: 0,0:00:48.96,0:00:51.34,Default,,0,0,0,,«Әділет мүсіні»
Dialogue: 0,0:00:48.96,0:00:51.34,Default,,0,0,0,,Әділет мүсіні қорғалды.
Dialogue: 0,0:00:51.34,0:00:53.26,Default,,0,0,0,,Әділет мүсіні қорғалды.
Dialogue: 0,0:00:53.34,0:00:54.84,Default,,0,0,0,,Бұл өте керемет.
Dialogue: 0,0:00:54.92,0:00:57.68,Default,,0,0,0,,(Дабыл дыбысы)
Dialogue: 0,0:01:01.97,0:01:03.81,Default,,0,0,0,,...Онда барамын.
Dialogue: 0,0:01:03.89,0:01:04.89,Default,,0,0,0,,Қарғыс атсын...!
Dialogue: 0,0:01:05.52,0:01:06.31,Default,,0,0,0,,Ой және...
Dialogue: 0,0:01:17.70,0:01:20.70,Default,,0,0,0,,(♪ ~Тақырыпты ашу)
Dialogue: 0,0:01:27.92,0:01:29.79,Default,,0,0,0,,♪ Біздің
Dialogue: 0,0:01:29.88,0:01:32.38,Default,,0,0,0,,♪ Уақыт біреу үшін
Dialogue: 0,0:01:32.96,0:01:35.92,Default,,0,0,0,,♪ Егер сіз бірдеңе сатып алуға мәжбүр болсаңыз
Dialogue: 0,0:01:36.01,0:01:38.01,Default,,0,0,0,,♪ Бұл есімде жоқ
Dialogue: 0,0:01:38.09,0:01:40.22,Default,,0,0,0,,♪ Бағасы
Dialogue: 0,0:01:40.30,0:01:43.14,Default,,0,0,0,,♪ Сіз не төледіңіз?
Dialogue: 0,0:01:43.22,0:01:45.85,Default,,0,0,0,,♪ Бұл бітпейтін өмір ме?
Dialogue: 0,0:01:45.93,0:01:48.27,Default,,0,0,0,,♪ Арқамдағы қанаттар
Dialogue: 0,0:01:48.35,0:01:51.73,Default,,0,0,0,,♪ Жолда не қаласаң, соны істе
Dialogue: 0,0:01:51.82,0:01:53.40,Default,,0,0,0,,♪ Қазір тым кеш
Dialogue: 0,0:01:53.48,0:01:56.24,Default,,0,0,0,,♪ Уайымдауға да уақыт келді
Dialogue: 0,0:01:56.32,0:01:58.53,Default,,0,0,0,,♪ Қалған уақытты пайдаланамын
Dialogue: 0,0:01:58.61,0:02:02.62,Default,,0,0,0,,♪ Шектеу болмауы керек
Dialogue: 0,0:02:02.70,0:02:06.04,Default,,0,0,0,,♪ Неліктен істемеу керек екенін есте сақтаңыз
Dialogue: 0,0:02:06.12,0:02:08.66,Default,,0,0,0,,♪ Жақында ұмытылатын жүрек соғысы
Dialogue: 0,0:02:08.75,0:02:11.71,Default,,0,0,0,,♪ Мәңгі емес
Dialogue: 0,0:02:11.79,0:02:15.76,Default,,0,0,0,,♪ Айтпасаң да
Dialogue: 0,0:02:15.84,0:02:19.68,Default,,0,0,0,,♪ О, мен білемін, бірақ
Dialogue: 0,0:02:19.76,0:02:22.35,Default,,0,0,0,,♪ Мен не кездестірдім
Dialogue: 0,0:02:22.43,0:02:24.31,Default,,0,0,0,,♪ Мен сізге не айта аламын?
Dialogue: 0,0:02:24.39,0:02:27.48,Default,,0,0,0,,♪ Ұша алмасам да
Dialogue: 0,0:02:27.56,0:02:32.56,Default,,0,0,0,,♪ Сараңдық – шектеулі өмір
Dialogue: 0,0:02:32.65,0:02:35.19,Default,,0,0,0,,♪ Менің ойымша, сіз оны таңдадыңыз.
Dialogue: 0,0:02:35.28,0:02:37.74,Default,,0,0,0,,♪ Сізбен бірге
Dialogue: 0,0:02:37.82,0:02:40.32,Default,,0,0,0,,♪ Басталуын көру үшін
Dialogue: 0,0:02:40.41,0:02:42.95,Default,,0,0,0,,♪ Және бір күні келеді
Dialogue: 0,0:02:43.03,0:02:46.66,Default,,0,0,0,,♪ Аяқтауды растау үшін
Dialogue: 0,0:02:52.29,0:02:54.21,Default,,0,0,0,,Мен… біраз ойланып алайын.
Dialogue: 0,0:02:54.29,0:02:56.00,Default,,0,0,0,,(Шұғылдық сезімі бар музыка)
Dialogue: 0,0:02:56.09,0:02:57.63,Default,,0,0,0,,Енді бір оқиға болды!
Dialogue: 0,0:02:57.71,0:02:59.51,Default,,0,0,0,,Бұрын, Штернмедайль ауданы
Dialogue: 0,0:02:59.59,0:03:01.84,Default,,0,0,0,,Батыс Силверде ақша жүк көлігіне шабуыл жасалды
Dialogue: 0,0:03:01.93,0:03:04.76,Default,,0,0,0,,Үш миллион Стерндоль тоналды.
Dialogue: 0,0:03:07.02,0:03:07.81,Default,,0,0,0,,(таңданғаннан айқайлаған дауыс)
Dialogue: 0,0:03:08.39,0:03:10.48,Default,,0,0,0,,Қандай полиция көлігі!
Dialogue: 0,0:03:11.39,0:03:13.81,Default,,0,0,0,,Мен осылай құтыла аламын ба?
Dialogue: 0,0:03:13.90,0:03:14.94,Default,,0,0,0,,(Ойын ұясының дыбысы)
Dialogue: 0,0:03:15.02,0:03:16.52,Default,,0,0,0,,«Тонау» «Жолаушы орындығы/жүргізуші орындығы/артқы тасымалдаушы»
Dialogue: 0,0:03:17.07,0:03:20.15,Default,,0,0,0,,Батырдың сыртқы түрін әлі растау мүмкін емес.
Dialogue: 0,0:03:20.90,0:03:24.87,Default,,0,0,0,,Айтпақшы, бұл бағдарламаны бәрі біледі, табиғаттан тыс күштері бар батырлар туралы.
Dialogue: 0,0:03:24.95,0:03:28.04,Default,,0,0,0,,Оның қылмыстар мен апаттар сияқты нақты оқиға орындарында қалай жұмыс істейтінін қараңыз⸺
Dialogue: 0,0:03:28.12,0:03:30.54,Default,,0,0,0,,Тікелей эфир сіздің қонақ бөлмеңізге жеткізілді!
Dialogue: 0,0:03:31.50,0:03:33.25,Default,,0,0,0,,Сіздің өнімділігіңізге сәйкес ұпайларды қосыңыз.
Dialogue: 0,0:03:31.50,0:03:33.25,Default,,0,0,0,,«Кулпер тұтқындалды +200 ұпай»
Dialogue: 0,0:03:33.33,0:03:35.38,Default,,0,0,0,,Батырлар патшасын шешейік⸺
Dialogue: 0,0:03:33.33,0:03:35.38,Default,,0,0,0,,«Өмірді сақтау плюс 100 ұпай»
Dialogue: 0,0:03:35.38,0:03:35.46,Default,,0,0,0,,«Өмірді сақтау плюс 100 ұпай»
Dialogue: 0,0:03:35.46,0:03:35.67,Default,,0,0,0,,«Өмірді сақтау плюс 100 ұпай»
Dialogue: 0,0:03:35.46,0:03:35.67,Default,,0,0,0,,Көңіл көтеруден құтқару бағдарламасы
Dialogue: 0,0:03:35.67,0:03:38.46,Default,,0,0,0,,Көңіл көтеруден құтқару бағдарламасы
Dialogue: 0,0:03:38.55,0:03:41.01,Default,,0,0,0,,...
Dialogue: 0,0:03:41.09,0:03:42.51,Default,,0,0,0,,(таңданған дауыс)
Dialogue: 0,0:03:42.59,0:03:43.22,Default,,0,0,0,,Керісінше, қанша адам қарғысқа ұшырап өлетінін болжау мүмкін емес.
Dialogue: 0,0:03:46.22,0:03:48.47,Default,,0,0,0,,Ахх! Бұл жерде!
Dialogue: 0,0:03:48.56,0:03:49.43,Default,,0,0,0,,Буржуазиялық гриль
Dialogue: 0,0:03:49.52,0:03:51.27,Default,,0,0,0,,Өрт эмблемасы
Dialogue: 0,0:03:51.85,0:03:54.23,Default,,0,0,0,,Кінәлі бүгін де сәтті ұсталады ма? «Өрт эмблемасы»
Dialogue: 0,0:03:54.23,0:03:54.31,Default,,0,0,0,,Кінәлі бүгін де сәтті ұсталады ма?
Dialogue: 0,0:03:54.31,0:03:55.02,Default,,0,0,0,,Кінәлі бүгін де сәтті ұсталады ма? «Бірінші келген +25 ұпай»
Dialogue: 0,0:03:55.02,0:03:55.65,Default,,0,0,0,,«Бірінші келген +25 ұпай»
Dialogue: 0,0:03:56.44,0:03:57.73,Default,,0,0,0,,Камера, жақында!
Dialogue: 0,0:03:58.32,0:03:58.98,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:03:59.07,0:04:00.36,Default,,0,0,0,,(сирена дыбысы)
Dialogue: 0,0:04:00.44,0:04:03.36,Default,,0,0,0,,(Тездіргіш музыка)
Dialogue: 0,0:04:03.45,0:04:04.70,Default,,0,0,0,,Ой! Ол шығады ма?
Dialogue: 0,0:04:04.78,0:04:06.78,Default,,0,0,0,,От шары!
Dialogue: 0,0:04:06.87,0:04:07.62,Default,,0,0,0,,«Бас тарту»
Dialogue: 0,0:04:08.74,0:04:09.70,Default,,0,0,0,,Шыу!
Dialogue: 0,0:04:09.79,0:04:10.95,Default,,0,0,0,,Аяусыз шабуыл!
Dialogue: 0,0:04:17.13,0:04:18.80,Default,,0,0,0,,Ах! Бұл жерде!
Dialogue: 0,0:04:18.88,0:04:21.59,Default,,0,0,0,,...
Dialogue: 0,0:04:22.22,0:04:23.17,Default,,0,0,0,,«Рок бизон 2 орын»
Dialogue: 0,0:04:24.88,0:04:26.39,Default,,0,0,0,,Бұл маусымда жақсы ештеңе болған жоқ⸺
Dialogue: 0,0:04:26.47,0:04:27.80,Default,,0,0,0,,Рок бизон!
Dialogue: 0,0:04:27.89,0:04:30.43,Default,,0,0,0,,Біз оны біраз уақыттан кейін бірінші рет әрекетте көретін сияқтымыз!
Dialogue: 0,0:04:31.31,0:04:33.64,Default,,0,0,0,,А... жарайды... а...?
Dialogue: 0,0:04:34.23,0:04:36.23,Default,,0,0,0,,Хмф! …сурет? иә?
Dialogue: 0,0:04:37.94,0:04:41.28,Default,,0,0,0,,О... Әй, міне!
Dialogue: 0,0:04:41.36,0:04:42.32,Default,,0,0,0,,Рок бизон!
Dialogue: 0,0:04:42.40,0:04:44.11,Default,,0,0,0,,Мүйіз шықпайтын сияқты!
Dialogue: 0,0:04:44.20,0:04:45.95,Default,,0,0,0,,(Тездіргіш музыка)
Dialogue: 0,0:04:46.03,0:04:48.41,Default,,0,0,0,,…өйткені ол ит алғысы келетінін айта бастады
Dialogue: 0,0:04:49.58,0:04:52.58,Default,,0,0,0,,Сәлем! Менің таксиімді ұрлап кетті!
Dialogue: 0,0:04:54.87,0:04:56.71,Default,,0,0,0,,Хмф! қазірдің өзінде!
Dialogue: 0,0:04:56.79,0:04:59.13,Default,,0,0,0,,Ал...
Dialogue: 0,0:05:01.21,0:05:03.46,Default,,0,0,0,,(Тездіргіш музыка)
Dialogue: 0,0:05:03.55,0:05:04.72,Default,,0,0,0,,22 мамыр: Біз Аоямада бір-бірімізге дәптерлерімізді көрсетеміз.
Dialogue: 0,0:05:07.89,0:05:08.55,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:10.93,0:05:12.43,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:05:12.52,0:05:13.73,Default,,0,0,0,,(Ичи) Вице-канцлермен кездесуге әлі біраз уақыт бар, бірақ—
Dialogue: 0,0:05:15.27,0:05:15.77,Default,,0,0,0,,Жарайды, барлығыңыз, ережелерді түсіндірейін
Dialogue: 0,0:05:15.85,0:05:19.15,Default,,0,0,0,,Жоғары вольтты ток жинайтын өлімге әкелетін қол соққысы.
Dialogue: 0,0:05:19.23,0:05:20.19,Default,,0,0,0,,Екі адам қамауға алынды! «Айдаһар бала»
Dialogue: 0,0:05:20.19,0:05:20.27,Default,,0,0,0,,Екі адам қамауға алынды!
Dialogue: 0,0:05:20.27,0:05:21.27,Default,,0,0,0,,Екі адам қамауға алынды! «2 адамды және 400 ұпайды қорғаңыз»
Dialogue: 0,0:05:21.36,0:05:24.19,Default,,0,0,0,,(Адамдар қолдайды)
Dialogue: 0,0:05:24.28,0:05:25.61,Default,,0,0,0,,Найзағай кунг-фу шебері
Dialogue: 0,0:05:25.70,0:05:28.70,Default,,0,0,0,,Айдаһар бала! Дәл осы сәт!
Dialogue: 0,0:05:30.53,0:05:31.66,Default,,0,0,0,,Оригами циклоны әдеттегідей⸺
Dialogue: 0,0:05:31.66,0:05:32.24,Default,,0,0,0,,Оригами циклоны әдеттегідей⸺ «Hero TV дерекқоры»
Dialogue: 0,0:05:32.24,0:05:32.33,Default,,0,0,0,,«Hero TV дерекқоры»
Dialogue: 0,0:05:32.33,0:05:33.66,Default,,0,0,0,,«Hero TV Database» қоймада жоқ.
Dialogue: 0,0:05:34.25,0:05:35.66,Default,,0,0,0,,«Оригами циклоны нүктесі жоқ»
Dialogue: 0,0:05:37.08,0:05:39.92,Default,,0,0,0,,Келіңіздер! Енді оқиға... Әй?
Dialogue: 0,0:05:40.00,0:05:43.34,Default,,0,0,0,,Ах! Бір қарақшы әлі қашып жүрген!
Dialogue: 0,0:05:43.42,0:05:44.21,Default,,0,0,0,,(Шұғылдық сезімі бар музыка)
Dialogue: 0,0:05:44.30,0:05:46.05,Default,,0,0,0,,…өйткені ол ит алғысы келетінін айта бастады
Dialogue: 0,0:05:47.63,0:05:48.68,Default,,0,0,0,,Тез шығарыңыз!
Dialogue: 0,0:05:48.76,0:05:50.80,Default,,0,0,0,,Бұл үлкен мәселе!
Dialogue: 0,0:05:50.89,0:05:52.06,Default,,0,0,0,,Мен жаңа ғана алған ақпарат бойынша,
Dialogue: 0,0:05:52.14,0:05:55.31,Default,,0,0,0,,Қарақшылар монорельсті басып алған көрінеді.
Dialogue: 0,0:05:55.39,0:05:57.10,Default,,0,0,0,,Не болды? (2-жолаушы) Ақырын!
Dialogue: 0,0:05:57.19,0:06:00.10,Default,,0,0,0,,(Тездіргіш музыка)
Dialogue: 0,0:06:01.27,0:06:02.32,Default,,0,0,0,,Даа!
Dialogue: 0,0:06:06.15,0:06:07.61,Default,,0,0,0,,(Нацуо) Жоқ, «шектеу» дегеніміз – ақыр соңында адам өз-өзіне қоятын нәрсе.
Dialogue: 0,0:06:08.32,0:06:10.57,Default,,0,0,0,,Бұл жерде араласпағаныңыз дұрыс...
Dialogue: 0,0:06:10.66,0:06:11.20,Default,,0,0,0,,Ах! Бұл!
Dialogue: 0,0:06:11.28,0:06:13.66,Default,,0,0,0,,(Тездіргіш музыка)
Dialogue: 0,0:06:14.66,0:06:15.41,Default,,0,0,0,,Уау...!
Dialogue: 0,0:06:16.00,0:06:17.25,Default,,0,0,0,,Ой, жақсысың ба?
Dialogue: 0,0:06:17.25,0:06:17.75,Default,,0,0,0,,Ой, жақсысың ба?
Dialogue: 0,0:06:17.25,0:06:17.75,Default,,0,0,0,,«Hero TV дерекқоры»
Dialogue: 0,0:06:17.75,0:06:17.83,Default,,0,0,0,,«Hero TV дерекқоры»
Dialogue: 0,0:06:17.83,0:06:20.17,Default,,0,0,0,,«Hero TV дерекқоры»
Dialogue: 0,0:06:17.83,0:06:20.17,Default,,0,0,0,,Осындай қиын жағдайда әділдікті бұзушы
Dialogue: 0,0:06:20.25,0:06:22.42,Default,,0,0,0,,Жабайы жолбарыс «Жабайы жолбарыс әділетті жоюшы» болып көрінеді
Dialogue: 0,0:06:23.34,0:06:25.05,Default,,0,0,0,,Онда жарнамаға өтіңіз!
Dialogue: 0,0:06:25.13,0:06:26.17,Default,,0,0,0,,Жолбарыстың дыбысын естисіз бе?
Dialogue: 0,0:06:26.80,0:06:29.26,Default,,0,0,0,,30 секундтан кейін Жарнамалық үзілістен кейін кеттік!
Dialogue: 0,0:06:29.34,0:06:30.64,Default,,0,0,0,,Иә? CM?
Dialogue: 0,0:06:30.72,0:06:32.30,Default,,0,0,0,,(Жарнама алдындағы жарқын джингл әні)
Dialogue: 0,0:06:32.39,0:06:33.64,Default,,0,0,0,,«Монарельстік драма шарықтау шегі ме?»
Dialogue: 0,0:06:34.39,0:06:35.64,Default,,0,0,0,,Бұл жүйкеңе тиіп тұр ма? Егер ашуланатын батылың болса, ашулан да.
Dialogue: 0,0:06:36.14,0:06:39.27,Default,,0,0,0,,Осындай уақытта жарнаманы қалай күтуге болады?
Dialogue: 0,0:06:39.35,0:06:41.52,Default,,0,0,0,,Сәлем! Мені тыңда!
Dialogue: 0,0:06:42.15,0:06:43.86,Default,,0,0,0,,Бұл әлдеқайда қызықты болар еді!
Dialogue: 0,0:06:43.94,0:06:44.94,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:06:46.61,0:06:50.41,Default,,0,0,0,,Біз батырлар... Бейбітшілікті қорғай алсақ...
Dialogue: 0,0:06:50.91,0:06:53.03,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:06:54.33,0:06:56.62,Default,,0,0,0,,Айқай!
Dialogue: 0,0:06:56.70,0:06:58.87,Default,,0,0,0,,Әлгі жігіт тағы да...
Dialogue: 0,0:06:59.83,0:07:00.62,Default,,0,0,0,,Жалғастырыңыз!
Dialogue: 0,0:07:00.71,0:07:01.37,Default,,0,0,0,,А... иә
Dialogue: 0,0:07:01.96,0:07:03.13,Default,,0,0,0,,Ой?
Dialogue: 0,0:07:03.21,0:07:04.92,Default,,0,0,0,,Мұнда жабайы жолбарыс «Жабайы жолбарыс уақытын шектейді»
Dialogue: 0,0:07:04.92,0:07:05.00,Default,,0,0,0,,«Жабайы жолбарыстың шекті уақыты»
Dialogue: 0,0:07:05.00,0:07:06.84,Default,,0,0,0,,«Жабайы жолбарыстың шектеу уақыты» Жүз қуат қосылды!
Dialogue: 0,0:07:06.84,0:07:06.92,Default,,0,0,0,,Жүз қуат қосылды!
Dialogue: 0,0:07:06.92,0:07:07.59,Default,,0,0,0,,Жүз қуат қосылды! «Жүз күш»
Dialogue: 0,0:07:07.59,0:07:07.67,Default,,0,0,0,,«Жүз күш»
Dialogue: 0,0:07:07.67,0:07:10.05,Default,,0,0,0,,«Жүз күш» Осы арқылы сіздің физикалық қабілетіңіз қалыпты болады...
Dialogue: 0,0:07:10.13,0:07:11.18,Default,,0,0,0,,Тезірек жалғастырыңыз! «Посейдон сызығы»
Dialogue: 0,0:07:11.18,0:07:11.26,Default,,0,0,0,,«Посейдон сызығы»
Dialogue: 0,0:07:11.26,0:07:12.18,Default,,0,0,0,,«Посейдон сызығы» мүмкін емес.
Dialogue: 0,0:07:12.26,0:07:13.09,Default,,0,0,0,,Егер ағам мен әпкем әлі тірі болса…
Dialogue: 0,0:07:13.18,0:07:14.39,Default,,0,0,0,,100 есе көп!
Dialogue: 0,0:07:14.47,0:07:15.30,Default,,0,0,0,,(Шұғылдық сезімі бар музыка)
Dialogue: 0,0:07:15.39,0:07:16.51,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:07:20.64,0:07:21.73,Default,,0,0,0,,Егер ағам мен әпкем әлі тірі болса…
Dialogue: 0,0:07:21.81,0:07:22.98,Default,,0,0,0,,…өйткені ол ит алғысы келетінін айта бастады
Dialogue: 0,0:07:23.06,0:07:24.77,Default,,0,0,0,,Тыныш идеялар...
Dialogue: 0,0:07:26.02,0:07:26.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:28.07,0:07:29.61,Default,,0,0,0,,Идиот! Төмен, төмен!
Dialogue: 0,0:07:29.69,0:07:31.40,Default,,0,0,0,,Ал... мен білмей тұрып
Dialogue: 0,0:07:33.49,0:07:35.62,Default,,0,0,0,,Қарақшы дирижабльге қарай жылжиды!
Dialogue: 0,0:07:37.62,0:07:40.66,Default,,0,0,0,,Міне, биік аспан, жел пайдаланушысы келеді!
Dialogue: 0,0:07:40.75,0:07:41.25,Default,,0,0,0,,«Hero TV дерекқоры»
Dialogue: 0,0:07:41.25,0:07:43.00,Default,,0,0,0,,«Hero TV Database» Осы маусымда керемет табысқа жетуде⸺
Dialogue: 0,0:07:43.08,0:07:44.29,Default,,0,0,0,,Батыр мырза – «Батырлардың аспанмен сырғанау патшасы»
Dialogue: 0,0:07:44.29,0:07:44.38,Default,,0,0,0,,«Батырлардың аспан патшасы»
Dialogue: 0,0:07:44.38,0:07:45.00,Default,,0,0,0,,«Батырлардың аспанмен сырғанау патшасы» келді!
Dialogue: 0,0:07:45.00,0:07:45.92,Default,,0,0,0,,Міне, осында!
Dialogue: 0,0:07:46.00,0:07:47.50,Default,,0,0,0,,(Адамдар қолдайды)
Dialogue: 0,0:07:47.59,0:07:49.01,Default,,0,0,0,,Сол бейбақ...
Dialogue: 0,0:07:49.59,0:07:51.92,Default,,0,0,0,,Дәмді жерде шық!
Dialogue: 0,0:07:53.97,0:07:54.55,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:07:56.39,0:07:59.43,Default,,0,0,0,,(Көңілсіз айқай)
Dialogue: 0,0:08:02.85,0:08:03.94,Default,,0,0,0,,(өкінішті дауыс)
Dialogue: 0,0:08:05.40,0:08:07.73,Default,,0,0,0,,Пайдасыз қарсылықты тоқтату.
Dialogue: 0,0:08:08.32,0:08:09.69,Default,,0,0,0,,Пайдасыз қарсылықты тоқтату.
Dialogue: 0,0:08:09.78,0:08:12.90,Default,,0,0,0,,Уа! Менің айтарым... Оны киме!
Dialogue: 0,0:08:15.57,0:08:16.32,Default,,0,0,0,,Әй?
Dialogue: 0,0:08:16.41,0:08:18.74,Default,,0,0,0,,(Таңдану айқайы)
Dialogue: 0,0:08:19.33,0:08:20.70,Default,,0,0,0,,Ал...!
Dialogue: 0,0:08:25.04,0:08:27.46,Default,,0,0,0,,Ах! Қылмыскер атқан оқ жарылды!
Dialogue: 0,0:08:27.54,0:08:28.96,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:08:30.38,0:08:31.38,Default,,0,0,0,,О!
Dialogue: 0,0:08:32.17,0:08:35.01,Default,,0,0,0,,Желді басқарыңыз және адамдарды құтқаруға басымдық беріңіз!
Dialogue: 0,0:08:35.09,0:08:36.76,Default,,0,0,0,,Sky High-тен күткендей!
Dialogue: 0,0:08:37.60,0:08:40.52,Default,,0,0,0,,Ах! Дирижабль ғимаратқа соғылды ма?
Dialogue: 0,0:08:42.56,0:08:43.73,Default,,0,0,0,,«Аполлон Медиа»
Dialogue: 0,0:08:43.81,0:08:45.27,Default,,0,0,0,,(сирена дыбысы)
Dialogue: 0,0:08:45.35,0:08:48.40,Default,,0,0,0,,(Тездіргіш музыка)
Dialogue: 0,0:08:48.48,0:08:51.32,Default,,0,0,0,,Осылай жүре берсек, жолаушылар кемесіне соғылып қаламыз!
Dialogue: 0,0:08:53.15,0:08:55.07,Default,,0,0,0,,Ах...! Алақай!
Dialogue: 0,0:08:55.15,0:08:57.45,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:09:03.62,0:09:04.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:04.46,0:09:07.08,Default,,0,0,0,,Сен не істеп жатырсың, Чинтара?
Dialogue: 0,0:09:07.17,0:09:07.92,Default,,0,0,0,,(Адамдар қолдайды)
Dialogue: 0,0:09:08.00,0:09:11.09,Default,,0,0,0,,Құрметті жанкүйерлер, күткендеріңізге рахмет!
Dialogue: 0,0:09:11.17,0:09:13.01,Default,,0,0,0,,Батырлар әлемінің супер кумирі
Dialogue: 0,0:09:13.09,0:09:14.09,Default,,0,0,0,,Көк раушан
Dialogue: 0,0:09:14.17,0:09:15.55,Default,,0,0,0,,Мұздату сұйықтығы
Dialogue: 0,0:09:15.63,0:09:17.13,Default,,0,0,0,,Жолаушы кемесін құтқарыңыз!
Dialogue: 0,0:09:17.22,0:09:18.18,Default,,0,0,0,,«Hero TV дерекқоры»
Dialogue: 0,0:09:18.26,0:09:20.10,Default,,0,0,0,,«Көк раушан өмірді сақтайтын MAX 500 ұпай»
Dialogue: 0,0:09:20.18,0:09:22.60,Default,,0,0,0,,B-камера! Төмен бұрыштан айналыңыз
Dialogue: 0,0:09:24.18,0:09:26.39,Default,,0,0,0,,Менің мұзым сәл салқын
Dialogue: 0,0:09:26.48,0:09:28.85,Default,,0,0,0,,Сіздің теріс қылықтарыңыз толығымен жабылады!
Dialogue: 0,0:09:28.94,0:09:30.61,Default,,0,0,0,,Шешілді!
Dialogue: 0,0:09:31.57,0:09:34.11,Default,,0,0,0,,Сіз шынымен де сандарды қалайсыз ба?
Dialogue: 0,0:09:35.11,0:09:37.53,Default,,0,0,0,,Біз қылмыскерді ұстадық...
Dialogue: 0,0:09:37.61,0:09:38.61,Default,,0,0,0,,(көңілді музыка)
Dialogue: 0,0:09:38.70,0:09:39.70,Default,,0,0,0,,(үлкен күрсіну)
Dialogue: 0,0:09:39.78,0:09:40.53,Default,,0,0,0,,(Мылтық дыбысы)
Dialogue: 0,0:09:40.62,0:09:41.53,Default,,0,0,0,,(Кенеттен түсінген дауыс)
Dialogue: 0,0:09:42.95,0:09:43.70,Default,,0,0,0,,(Таңдану дауысы)
Dialogue: 0,0:09:43.79,0:09:45.58,Default,,0,0,0,,(Тыныс алу дауысы)
Dialogue: 0,0:09:45.66,0:09:48.21,Default,,0,0,0,,Өйткені сен... (қарақшы) Темее жолға түсіп қалады.
Dialogue: 0,0:09:48.29,0:09:49.67,Default,,0,0,0,,Ахх... «Жабайы жолбарыс соғылды!»
Dialogue: 0,0:09:49.75,0:09:51.42,Default,,0,0,0,,Мен үшін не істедің?
Dialogue: 0,0:09:51.50,0:09:52.25,Default,,0,0,0,,Сіз қауіпсізсіз!
Dialogue: 0,0:09:52.34,0:09:53.25,Default,,0,0,0,,Атқан жабайы жолбарыс⸺
Dialogue: 0,0:09:53.34,0:09:54.21,Default,,0,0,0,,Сіз қауіпсіз сияқтысыз!
Dialogue: 0,0:09:55.05,0:09:56.22,Default,,0,0,0,,(Ооо! айқай)
Dialogue: 0,0:09:57.80,0:09:58.84,Default,,0,0,0,,Ей!
Dialogue: 0,0:09:58.93,0:10:00.01,Default,,0,0,0,,Мұнда келме!
Dialogue: 0,0:10:00.09,0:10:01.72,Default,,0,0,0,,Қазірдің өзінде! О, жоқ
Dialogue: 0,0:10:01.80,0:10:02.97,Default,,0,0,0,,О, жарылып кетті!
Dialogue: 0,0:10:03.06,0:10:04.68,Default,,0,0,0,,Сүйкімді қашу!
Dialogue: 0,0:10:07.18,0:10:08.60,Default,,0,0,0,,Сіз жай ғана қашып бара жатырсыз!
Dialogue: 0,0:10:08.69,0:10:10.77,Default,,0,0,0,,Қауіпті! ...Апыр-ай!
Dialogue: 0,0:10:11.36,0:10:13.27,Default,,0,0,0,,Қандай тамаша секіру!
Dialogue: 0,0:10:13.36,0:10:14.44,Default,,0,0,0,,Әлгі бейбақ!
Dialogue: 0,0:10:14.53,0:10:17.36,Default,,0,0,0,,«Жабайы жолбарыстың шекті уақыты» «Жабайы жолбарыстың шекті уақыты»
Dialogue: 0,0:10:17.36,0:10:17.45,Default,,0,0,0,,«Жабайы жолбарыстың шекті уақыты»
Dialogue: 0,0:10:17.45,0:10:17.90,Default,,0,0,0,,«Жабайы жолбарыстың шекті уақыты» «Жүз күш»
Dialogue: 0,0:10:17.90,0:10:17.99,Default,,0,0,0,,«Жүз күш»
Dialogue: 0,0:10:17.99,0:10:18.95,Default,,0,0,0,,«Жүз күш» Ах!
Dialogue: 0,0:10:18.95,0:10:19.03,Default,,0,0,0,,«Жүз күш»
Dialogue: 0,0:10:19.03,0:10:19.57,Default,,0,0,0,,«Жүз қуат» Уақыт аяқталды!
Dialogue: 0,0:10:19.57,0:10:20.49,Default,,0,0,0,,Уақыт аяқталды!
Dialogue: 0,0:10:20.57,0:10:23.62,Default,,0,0,0,,Жабайы жолбарыстың қабілеті 5 минутқа ғана жетеді!
Dialogue: 0,0:10:23.70,0:10:25.24,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:25.33,0:10:27.41,Default,,0,0,0,,Жолбарыс қалыпты адам болып қайта оралды!
Dialogue: 0,0:10:27.50,0:10:30.08,Default,,0,0,0,,Бұл қалай болса да қауіпті!
Dialogue: 0,0:10:30.17,0:10:32.34,Default,,0,0,0,,(мазасыз музыка)
Dialogue: 0,0:10:32.42,0:10:33.09,Default,,0,0,0,,Шыу!
Dialogue: 0,0:10:46.27,0:10:47.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:49.02,0:10:50.39,Default,,0,0,0,,Бұл кім? Сіз
Dialogue: 0,0:10:50.48,0:10:52.40,Default,,0,0,0,,Оны асыра алмаңыз
Dialogue: 0,0:10:52.48,0:10:53.69,Default,,0,0,0,,Шыу!
Dialogue: 0,0:10:55.32,0:10:55.94,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:10:56.03,0:10:57.03,Default,,0,0,0,,Кім?
Dialogue: 0,0:11:00.99,0:11:01.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:01.82,0:11:03.16,Default,,0,0,0,,…өйткені ол ит алғысы келетінін айта бастады
Dialogue: 0,0:11:03.74,0:11:06.49,Default,,0,0,0,,Ах! Жұмбақ адам қылмыскерді ұстады!
Dialogue: 0,0:11:11.87,0:11:12.75,Default,,0,0,0,,(Күлкі)
Dialogue: 0,0:11:13.38,0:11:16.59,Default,,0,0,0,,Бұл жаңа жұлдыздың тууы ма?
Dialogue: 0,0:11:16.67,0:11:18.09,Default,,0,0,0,,Осы маусымдағы жұмбақ кейіпкер⸺
Dialogue: 0,0:11:18.17,0:11:19.47,Default,,0,0,0,,Қорытынды!
Dialogue: 0,0:11:19.55,0:11:20.42,Default,,0,0,0,,(Адамдар қолдайды)
Dialogue: 0,0:11:20.51,0:11:21.43,Default,,0,0,0,,Мектеп оқушысы үшін ол өзімен бірге таңғаларлықтай 50 000 йен алып жүр
Dialogue: 0,0:11:21.51,0:11:24.51,Default,,0,0,0,,(эпикалық музыка)
Dialogue: 0,0:11:29.81,0:11:31.27,Default,,0,0,0,,Бір рет коммерциялық!
Dialogue: 0,0:11:36.57,0:11:37.73,Default,,0,0,0,,Сонымен қатар, Алл Майт мені қазірдің өзінде бақылап отыр—
Dialogue: 0,0:11:38.86,0:11:40.36,Default,,0,0,0,,Мен сені жақын арада көргім келеді
Dialogue: 0,0:11:40.86,0:11:42.28,Default,,0,0,0,,(сирена дыбысы)
Dialogue: 0,0:11:43.86,0:11:46.78,Default,,0,0,0,,Әйтеуір, олай емес!
Dialogue: 0,0:11:46.87,0:11:48.29,Default,,0,0,0,,...
Dialogue: 0,0:11:49.70,0:11:52.79,Default,,0,0,0,,Сіздің NEX сергітетіндей салқын
Dialogue: 0,0:11:52.87,0:11:56.79,Default,,0,0,0,,Жүрегімді толығымен ұста!
Dialogue: 0,0:11:57.84,0:11:59.30,Default,,0,0,0,,Танысқың келетін дәмділік
Dialogue: 0,0:12:01.17,0:12:02.80,Default,,0,0,0,,...
Dialogue: 0,0:12:02.88,0:12:04.30,Default,,0,0,0,,NEX! (Адамдар) NEX!
Dialogue: 0,0:12:04.39,0:12:06.80,Default,,0,0,0,,(CM тақырыптық ән)
Dialogue: 0,0:12:07.85,0:12:09.31,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:14.15,0:12:19.86,Default,,0,0,0,,♪ Қалағанымдай өмір сүремін, жарқыраған күндерім
Dialogue: 0,0:12:19.94,0:12:22.11,Default,,0,0,0,,♪ Жарқыраған жұлдыздан да артық
Dialogue: 0,0:12:22.19,0:12:24.28,Default,,0,0,0,,♪ Иә! Таңқаларлық...
Dialogue: 0,0:12:25.61,0:12:28.58,Default,,0,0,0,,Әй, сен қайдасың?
Dialogue: 0,0:12:28.66,0:12:29.58,Default,,0,0,0,,Филиал?
Dialogue: 0,0:12:29.66,0:12:32.04,Default,,0,0,0,,Бос болсаң да, мойыныңды шығардың ба?
Dialogue: 0,0:12:32.12,0:12:33.25,Default,,0,0,0,,Сіз не ойлап отырсыз?
Dialogue: 0,0:12:33.83,0:12:34.62,Default,,0,0,0,,Хмф...
Dialogue: 0,0:12:34.71,0:12:37.33,Default,,0,0,0,,Бұл жақсы емес пе? Біз оны ұстай алдық.
Dialogue: 0,0:12:37.42,0:12:39.38,Default,,0,0,0,,Көбінесе сіз...
Dialogue: 0,0:12:39.46,0:12:42.17,Default,,0,0,0,,Батырлар көпшілік алдында бетперделерін шешпейді.
Dialogue: 0,0:12:42.26,0:12:43.26,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:12:43.34,0:12:44.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:44.18,0:12:45.84,Default,,0,0,0,,Батыр дегеніміз не?
Dialogue: 0,0:12:45.93,0:12:48.43,Default,,0,0,0,,Батыр - өзінің шынайы болмысын ашпайтын адам...
Dialogue: 0,0:12:48.51,0:12:49.60,Default,,0,0,0,,Бұл ескі
Dialogue: 0,0:12:49.68,0:12:50.43,Default,,0,0,0,,​​О?
Dialogue: 0,0:12:50.51,0:12:52.31,Default,,0,0,0,,Сіз заманнан артта қалдыңыз.
Dialogue: 0,0:12:52.39,0:12:53.93,Default,,0,0,0,,Ағай
Dialogue: 0,0:12:54.02,0:12:55.02,Default,,0,0,0,,Не?
Dialogue: 0,0:12:58.02,0:13:00.98,Default,,0,0,0,,(Тамаша музыка)
Dialogue: 0,0:13:01.07,0:13:03.94,Default,,0,0,0,,...
Dialogue: 0,0:13:04.03,0:13:07.45,Default,,0,0,0,,Олай болса, барлығына, көп күткендеріңізге рахмет.
Dialogue: 0,0:13:08.03,0:13:12.24,Default,,0,0,0,,Hero TV Осы маусымның нәтижелері жарияланды.
Dialogue: 0,0:13:12.33,0:13:15.33,Default,,0,0,0,,(Адамдар қолдайды)
Dialogue: 0,0:13:19.04,0:13:21.46,Default,,0,0,0,,Өкінбейсің бе, Котецу?
Dialogue: 0,0:13:21.55,0:13:24.05,Default,,0,0,0,,Неліктен рельсті бүгуге тура келді?
Dialogue: 0,0:13:24.13,0:13:26.72,Default,,0,0,0,,Көліктің терезесін сындырудың да қажеті жоқ еді, солай ма?
Dialogue: 0,0:13:26.80,0:13:27.64,Default,,0,0,0,,Квирктерін қылмыстық мақсатта пайдаланатын жауыздармен күресу үшін —
Dialogue: 0,0:13:27.72,0:13:28.55,Default,,0,0,0,,Онда неге бұздың?
Dialogue: 0,0:13:28.55,0:13:29.09,Default,,0,0,0,,Онда неге бұздың?
Dialogue: 0,0:13:28.55,0:13:29.09,Default,,0,0,0,,«Бен Джексонға кіру билеті»
Dialogue: 0,0:13:29.09,0:13:29.18,Default,,0,0,0,,«Бен Джексонға кіру билеті»
Dialogue: 0,0:13:29.18,0:13:29.47,Default,,0,0,0,,«Бен Джексонға кіру билеті»
Dialogue: 0,0:13:29.18,0:13:29.47,Default,,0,0,0,,Мұның қанша тұратынын білесіз бе?
Dialogue: 0,0:13:29.47,0:13:29.55,Default,,0,0,0,,Мұның қанша тұратынын білесіз бе?
Dialogue: 0,0:13:29.55,0:13:30.64,Default,,0,0,0,,Мұның қанша тұратынын білесіз бе?
Dialogue: 0,0:13:29.55,0:13:30.64,Default,,0,0,0,,«Үздік магиялық қаһарман бизнес бөлімі»
Dialogue: 0,0:13:30.72,0:13:32.39,Default,,0,0,0,,Мен әрқашан кешірім сұраймын.
Dialogue: 0,0:13:32.47,0:13:35.81,Default,,0,0,0,,Сені кім батыр ететінін білесің ғой, солай ма?
Dialogue: 0,0:13:35.89,0:13:37.65,Default,,0,0,0,,(тыныш музыка)
Dialogue: 0,0:13:37.73,0:13:38.81,Default,,0,0,0,,Құрметті демеуші!
Dialogue: 0,0:13:39.40,0:13:40.31,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:13:40.40,0:13:42.69,Default,,0,0,0,,Марапаттау рәсіміне барайық!
Dialogue: 0,0:13:42.78,0:13:43.90,Default,,0,0,0,,Ол ісініп, қан ағып тұр
Dialogue: 0,0:13:44.90,0:13:45.95,Default,,0,0,0,,Өрт эмблемасы!
Dialogue: 0,0:13:46.03,0:13:47.24,Default,,0,0,0,,Рок бизон!
Dialogue: 0,0:13:47.32,0:13:48.95,Default,,0,0,0,,Айдаһар бала!
Dialogue: 0,0:13:49.03,0:13:50.20,Default,,0,0,0,,Оригами циклоны!
Dialogue: 0,0:13:50.87,0:13:51.99,Default,,0,0,0,,Биік аспан!
Dialogue: 0,0:13:52.08,0:13:53.37,Default,,0,0,0,,Көк раушан!
Dialogue: 0,0:13:53.45,0:13:54.83,Default,,0,0,0,,Жабайы жолбарыс!
Dialogue: 0,0:13:54.91,0:13:57.33,Default,,0,0,0,,Енді тәжді кім алады!
Dialogue: 0,0:13:57.92,0:13:58.87,Default,,0,0,0,,Кеш болды.
Dialogue: 0,0:13:58.96,0:14:00.67,Default,,0,0,0,,MVP хабарландыруы туралы не деуге болады?
Dialogue: 0,0:14:00.75,0:14:01.67,Default,,0,0,0,,Бұдан былай
Dialogue: 0,0:14:01.75,0:14:02.80,Default,,0,0,0,,Қауіпсіз
Dialogue: 0,0:14:02.88,0:14:04.38,Default,,0,0,0,,Бұл сен емессің.
Dialogue: 0,0:14:04.46,0:14:06.84,Default,,0,0,0,,Шулы! Хахаха...!
Dialogue: 0,0:14:06.92,0:14:10.64,Default,,0,0,0,,Күткеніңізге рахмет. Ақырында MVP жариялау уақыты келді!
Dialogue: 0,0:14:10.72,0:14:13.10,Default,,0,0,0,,(барабан дыбысы)
Dialogue: 0,0:14:19.14,0:14:20.94,Default,,0,0,0,,«1-ші орын Аспан биік»
Dialogue: 0,0:14:21.02,0:14:21.94,Default,,0,0,0,,Жиналған ұпай 12730
Dialogue: 0,0:14:21.94,0:14:24.07,Default,,0,0,0,,Жиналған ұпай 12730
Dialogue: 0,0:14:21.94,0:14:24.07,Default,,0,0,0,,«1 орын 12730 ұпай»
Dialogue: 0,0:14:24.07,0:14:24.15,Default,,0,0,0,,«1 орын 12730 ұпай»
Dialogue: 0,0:14:24.15,0:14:24.98,Default,,0,0,0,,«1 орын 12730 ұпай» Батыр аспан патшасы Жоғары!
Dialogue: 0,0:14:24.98,0:14:27.70,Default,,0,0,0,,Батырлар патшасы Аспан биік!
Dialogue: 0,0:14:27.78,0:14:28.74,Default,,0,0,0,,...
Dialogue: 0,0:14:28.82,0:14:31.16,Default,,0,0,0,,Неге… неге мен
Dialogue: 0,0:14:31.24,0:14:33.37,Default,,0,0,0,,Қолдауыңыз үшін барлығына рахмет.
Dialogue: 0,0:14:33.45,0:14:36.25,Default,,0,0,0,,Рахмет! Және рахмет!
Dialogue: 0,0:14:36.33,0:14:38.00,Default,,0,0,0,,«6-орын Жабайы жолбарыс 8360 ұпай»
Dialogue: 0,0:14:38.08,0:14:40.46,Default,,0,0,0,,(Адамдар қолдайды)
Dialogue: 0,0:14:40.54,0:14:43.13,Default,,0,0,0,,(отшашулардың дыбысы)
Dialogue: 0,0:14:44.17,0:14:45.25,Default,,0,0,0,,Жалғасы
Dialogue: 0,0:14:45.34,0:14:48.47,Default,,0,0,0,,Apollon Media бас директоры және OBC президенті
Dialogue: 0,0:14:48.55,0:14:50.05,Default,,0,0,0,,Альберт Мавериктен
Dialogue: 0,0:14:50.13,0:14:51.97,Default,,0,0,0,,Мен сәлем айтқым келеді!
Dialogue: 0,0:14:54.01,0:14:54.31,Default,,0,0,0,,Ал... Оның алдында мен сені таныстырғым келетін адам бар.
Dialogue: 0,0:14:54.31,0:14:57.64,Default,,0,0,0,,Ал... Оның алдында мен сені таныстырғым келетін адам бар.
Dialogue: 0,0:14:54.31,0:14:57.64,Default,,0,0,0,,«Apollon Media бас директоры және OBC президенті»
Dialogue: 0,0:14:57.73,0:14:59.52,Default,,0,0,0,,Кіріңіз.
Dialogue: 0,0:14:59.60,0:15:02.73,Default,,0,0,0,,(Адамдар қолдайды)
Dialogue: 0,0:15:02.81,0:15:07.57,Default,,0,0,0,,Ол қазір Сот бюросының ресми рұқсатын алды⸺
Dialogue: 0,0:15:07.65,0:15:09.78,Default,,0,0,0,,Кіші Барнаби Брукс.
Dialogue: 0,0:15:10.45,0:15:13.03,Default,,0,0,0,,Мен Штернбилттің тыныштығын қорғаймын деп шешілді⸺
Dialogue: 0,0:15:10.45,0:15:13.03,Default,,0,0,0,,«Кіші Барнаби Брукс»
Dialogue: 0,0:15:13.03,0:15:13.12,Default,,0,0,0,,«Кіші Барнаби Брукс»
Dialogue: 0,0:15:13.12,0:15:14.37,Default,,0,0,0,,«Кіші Барнаби Брукс»
Dialogue: 0,0:15:13.12,0:15:14.37,Default,,0,0,0,,Жаңа кейіпкер
Dialogue: 0,0:15:16.20,0:15:18.25,Default,,0,0,0,,(Әйелдердің қошеметі)
Dialogue: 0,0:15:18.33,0:15:19.91,Default,,0,0,0,,...Жоқ!
Dialogue: 0,0:15:20.00,0:15:20.75,Default,,0,0,0,,Енді, енді.
Dialogue: 0,0:15:20.83,0:15:24.25,Default,,0,0,0,,Өз қабілетін белсендіру арқылы
Dialogue: 0,0:15:24.34,0:15:26.50,Default,,0,0,0,,Физикалық қабілетіңізді қалыптыдан 100 есе арттырыңыз⸺
Dialogue: 0,0:15:26.59,0:15:28.30,Default,,0,0,0,,арттыруға болады
Dialogue: 0,0:15:28.38,0:15:29.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:29.13,0:15:31.76,Default,,0,0,0,,Іске қосу уақыты небәрі 5 минут.
Dialogue: 0,0:15:31.84,0:15:35.47,Default,,0,0,0,,Белгілі бір қаһарманның қабілеттері дәл солай.
Dialogue: 0,0:15:35.55,0:15:38.06,Default,,0,0,0,,Өйткені, ол әлі жас!
Dialogue: 0,0:15:38.14,0:15:41.44,Default,,0,0,0,,Қателік жасасаң да, ханшайымның құшағында жүргендей⸺
Dialogue: 0,0:15:41.52,0:15:43.98,Default,,0,0,0,,Батыр болма
Dialogue: 0,0:15:44.06,0:15:44.98,Default,,0,0,0,,(иіскеу)
Dialogue: 0,0:15:45.06,0:15:46.02,Default,,0,0,0,,(өкінішті дауыс)
Dialogue: 0,0:15:46.11,0:15:47.07,Default,,0,0,0,,Хехе...
Dialogue: 0,0:15:47.15,0:15:50.65,Default,,0,0,0,,Ал, Келесі деген ерекше қабілеті бар адам бар.
Dialogue: 0,0:15:50.74,0:15:54.11,Default,,0,0,0,,Менің бұл әлемде мутация ретінде пайда болғаныма 45 жыл болды...
Dialogue: 0,0:15:54.20,0:15:56.41,Default,,0,0,0,,Сәлем! (Жабайы жолбарыс) Мен үйге бара жатырмын
Dialogue: 0,0:15:59.83,0:16:01.87,Default,,0,0,0,,(тыныш музыка)
Dialogue: 0,0:16:04.63,0:16:07.42,Default,,0,0,0,,♪ Егер сол кезде
Dialogue: 0,0:16:07.50,0:16:10.59,Default,,0,0,0,,♪ Мен саған
Dialogue: 0,0:16:10.67,0:16:16.80,Default,,0,0,0,,♪ Бармаймын десең
Dialogue: 0,0:16:16.89,0:16:19.68,Default,,0,0,0,,♪ Сен менің жанымдасың
Dialogue: 0,0:16:19.77,0:16:23.44,Default,,0,0,0,,♪ Сенің осында болғаныңды қалаймын.
Dialogue: 0,0:16:23.52,0:16:26.15,Default,,0,0,0,,♪ Аяқ дыбыстары
Dialogue: 0,0:16:26.23,0:16:30.15,Default,,0,0,0,,♪ Қабағыма шаншылған
Dialogue: 0,0:16:30.23,0:16:32.44,Default,,0,0,0,,♪ Біз кездестік және қазірдің өзінде
Dialogue: 0,0:16:32.53,0:16:35.53,Default,,0,0,0,,♪ Қазір қай жыл?
Dialogue: 0,0:16:35.61,0:16:38.58,Default,,0,0,0,,♪ Өте жылдам
Dialogue: 0,0:16:38.66,0:16:41.75,Default,,0,0,0,,♪ Бұл осы уақытқа дейін болды.
Dialogue: 0,0:16:41.83,0:16:44.71,Default,,0,0,0,,♪ Уақыт өтеді
Dialogue: 0,0:16:44.79,0:16:47.88,Default,,0,0,0,,♪ Қазір ерте
Dialogue: 0,0:16:48.50,0:16:53.51,Default,,0,0,0,,♪ Мен сені кездестіргеннен бері
Dialogue: 0,0:16:56.01,0:17:00.76,Default,,0,0,0,,♪ Мен саған
Dialogue: 0,0:17:00.85,0:17:05.64,Default,,0,0,0,,♪ Не істеуге болады?
Dialogue: 0,0:17:08.27,0:17:11.90,Default,,0,0,0,,♪ Мен оны жаңа ғана алдым.
Dialogue: 0,0:17:11.98,0:17:15.57,Default,,0,0,0,,Сіз әрқашан батыр болып қаласыз
Dialogue: 0,0:17:16.61,0:17:17.70,Default,,0,0,0,,Мен ғой, мен…-сан ба?
Dialogue: 0,0:17:17.78,0:17:20.32,Default,,0,0,0,,♪ Не болып жатыр?
Dialogue: 0,0:17:20.41,0:17:24.33,Default,,0,0,0,,♪ Сізбен бірге
Dialogue: 0,0:17:24.41,0:17:27.33,Default,,0,0,0,,♪ Шексіз
Dialogue: 0,0:17:27.42,0:17:32.21,Default,,0,0,0,,♪ Өйткені мен күлімдей алдым
Dialogue: 0,0:17:33.88,0:17:37.68,Default,,0,0,0,,Бұл маусым әйтеуір... сәтті аяқталды.
Dialogue: 0,0:17:39.34,0:17:40.10,Default,,0,0,0,,Томое
Dialogue: 0,0:17:40.18,0:17:44.60,Default,,0,0,0,,♪ Мен сені қатты жақсы көремін
Dialogue: 0,0:17:46.31,0:17:50.44,Default,,0,0,0,,♪ Бір уақытта
Dialogue: 0,0:18:01.78,0:18:04.50,Default,,0,0,0,,(Музыка бірте-бірте аяқталады)
Dialogue: 0,0:18:11.04,0:18:12.25,Default,,0,0,0,,Онда «Лайт» орнына «Рыцарь» деп атай алам ба?
Dialogue: 0,0:18:12.84,0:18:14.76,Default,,0,0,0,,«Жабайы жолбарыс»
Dialogue: 0,0:18:14.84,0:18:18.01,Default,,0,0,0,,«Ардагер батыр өзінің дебютіне 10 жыл толды»
Dialogue: 0,0:18:18.09,0:18:21.30,Default,,0,0,0,,«Мен өзімді шыңнан өткендей сезінсем де...»
Dialogue: 0,0:18:22.60,0:18:25.35,Default,,0,0,0,,«Сатылған»
Dialogue: 0,0:18:25.43,0:18:26.52,Default,,0,0,0,,(өкінішті дауыс)
Dialogue: 0,0:18:26.60,0:18:28.69,Default,,0,0,0,,Ах! Апай, бұл 10 сурет!
Dialogue: 0,0:18:28.77,0:18:29.56,Default,,0,0,0,,Иә.
Dialogue: 0,0:18:29.65,0:18:31.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:31.11,0:18:32.90,Default,,0,0,0,,«Антонио кіріс қоңырауы»
Dialogue: 0,0:18:35.03,0:18:36.40,Default,,0,0,0,,О! ше?
Dialogue: 0,0:18:36.49,0:18:37.90,Default,,0,0,0,,(фортепианоға арналған талғампаз музыка)
Dialogue: 0,0:18:37.99,0:18:40.24,Default,,0,0,0,,Сәлем! Ол тіпті ұшырылымға келмей ме?
Dialogue: 0,0:18:40.32,0:18:42.03,Default,,0,0,0,,Мен мұндай нәрсеге жақсы емеспін.
Dialogue: 0,0:18:42.12,0:18:45.37,Default,,0,0,0,,Маңызды адамдармен дұрыс амандасу керек.
Dialogue: 0,0:18:45.45,0:18:47.50,Default,,0,0,0,,Содан мен де өзімді сұрадым.
Dialogue: 0,0:18:45.45,0:18:47.50,Default,,0,0,0,,«Котецу»
Dialogue: 0,0:18:47.50,0:18:47.91,Default,,0,0,0,,«Котецу»
Dialogue: 0,0:18:48.00,0:18:51.54,Default,,0,0,0,,Ах... Эй! Хм...эй!
Dialogue: 0,0:18:51.63,0:18:53.92,Default,,0,0,0,,Қол тигізсем де жақсы есек
Dialogue: 0,0:18:54.00,0:18:54.88,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:54.96,0:18:56.67,Default,,0,0,0,,Идиот! Күтіңіз!
Dialogue: 0,0:18:57.30,0:19:01.39,Default,,0,0,0,,Бүгінгі аяқтаған жолыңыз керемет болды. Келесі жолы қайталаңыз.
Dialogue: 0,0:19:01.47,0:19:02.47,Default,,0,0,0,,Керемет компания атауы
Dialogue: 0,0:19:02.55,0:19:04.14,Default,,0,0,0,,Апелляциялық шағым
Dialogue: 0,0:19:04.22,0:19:05.93,Default,,0,0,0,,Ах! Жоқ... аламын.
Dialogue: 0,0:19:06.01,0:19:08.56,Default,,0,0,0,,Президент, шешуші жол
Dialogue: 0,0:19:08.64,0:19:10.89,Default,,0,0,0,,Ұят болғандықтан өзгертуге бола ма?
Dialogue: 0,0:19:10.98,0:19:13.56,Default,,0,0,0,,Жоғарыдан төмен қарайтын бұл көрініс танымал.
Dialogue: 0,0:19:13.65,0:19:15.52,Default,,0,0,0,,Хм... Түсінбейсің.
Dialogue: 0,0:19:15.61,0:19:17.48,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:19:19.11,0:19:22.53,Default,,0,0,0,,Рахмет! Және...рахмет!
Dialogue: 0,0:19:22.61,0:19:23.99,Default,,0,0,0,,Маверик мырза!
Dialogue: 0,0:19:24.07,0:19:25.66,Default,,0,0,0,,Иә? О, жоқ
Dialogue: 0,0:19:25.74,0:19:29.54,Default,,0,0,0,,Мен сізді осы бағдарламаның продюсері ретінде таңдау арқылы дұрыс таңдау жасадым.
Dialogue: 0,0:19:30.12,0:19:32.25,Default,,0,0,0,,Олардың соншалықты көп көрермен жинағанына сене алмаймын.
Dialogue: 0,0:19:32.33,0:19:35.13,Default,,0,0,0,,Осы Агнес Жубер көбірек!
Dialogue: 0,0:19:36.00,0:19:37.96,Default,,0,0,0,,Мен оны шектен шығарамын!
Dialogue: 0,0:19:38.05,0:19:39.72,Default,,0,0,0,,(қанағаттанған дауыс)
Dialogue: 0,0:19:51.10,0:19:52.73,Default,,0,0,0,,(аяқ киімнің жақындаған дыбысы)
Dialogue: 0,0:19:52.81,0:19:54.02,Default,,0,0,0,,Барнаби мырза
Dialogue: 0,0:19:54.86,0:19:58.53,Default,,0,0,0,,Бүгіннен бастап мен Сот бюросына тағайындалдым.
Dialogue: 0,0:19:58.61,0:20:00.99,Default,,0,0,0,,Менің атым - Юрий Петров.
Dialogue: 0,0:20:01.07,0:20:03.16,Default,,0,0,0,,Назар аударғаныңызға рахмет.
Dialogue: 0,0:20:03.24,0:20:06.03,Default,,0,0,0,,Мен сенің алдағы істеріңді асыға күтемін.
Dialogue: 0,0:20:06.62,0:20:09.12,Default,,0,0,0,,Мен сіздің үміттеріңізді ақтауға бар күшімді саламын.
Dialogue: 0,0:20:09.20,0:20:12.54,Default,,0,0,0,,Әділдігіңізді орындаңыз.
Dialogue: 0,0:20:14.46,0:20:15.58,Default,,0,0,0,,Иә...
Dialogue: 0,0:20:16.63,0:20:19.05,Default,,0,0,0,,(мазасыз музыка)
Dialogue: 0,0:20:20.42,0:20:23.05,Default,,0,0,0,,(Телефон қоңырау үні)
Dialogue: 0,0:20:23.80,0:20:24.55,Default,,0,0,0,,Иә, иә…
Dialogue: 0,0:20:26.80,0:20:28.35,Default,,0,0,0,,Иә? (Кейде) Әке?
Dialogue: 0,0:20:28.43,0:20:31.10,Default,,0,0,0,,Уа! Кайде не болды?
Dialogue: 0,0:20:31.68,0:20:34.98,Default,,0,0,0,,Сіз ертеңгі презентацияны ұмытқан жоқсыз, солай ма?
Dialogue: 0,0:20:35.06,0:20:38.40,Default,,0,0,0,,Әрине! Әке, сіз барып көремін деп уәде бергенсіз ғой?
Dialogue: 0,0:20:38.98,0:20:40.40,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:20:40.48,0:20:42.49,Default,,0,0,0,,Әке, сіздің жұмысыңыз жоқ па?
Dialogue: 0,0:20:42.57,0:20:43.65,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:20:44.24,0:20:46.66,Default,,0,0,0,,Ертең мен Каеданың сүйкімді келбетін көремін.
Dialogue: 0,0:20:46.74,0:20:49.37,Default,,0,0,0,,Мен оны өз көзіме оттаймын.
Dialogue: 0,0:20:49.45,0:20:51.16,Default,,0,0,0,,Әке, мен міндетті түрде барамын!
Dialogue: 0,0:20:51.25,0:20:53.29,Default,,0,0,0,,О, түсіндім.
Dialogue: 0,0:20:54.00,0:20:56.92,Default,,0,0,0,,Өзгерсең өзгердім де, мама!
Dialogue: 0,0:20:57.00,0:21:00.00,Default,,0,0,0,,Мен теледидар қарап отырдым! Қайтадан өтемақы?
Dialogue: 0,0:21:00.09,0:21:01.55,Default,,0,0,0,,(Котецудың ащы күлкісі)
Dialogue: 0,0:21:01.63,0:21:03.92,Default,,0,0,0,,Сен, ыстығыңда, немқұрайлы боласың.
Dialogue: 0,0:21:04.01,0:21:05.18,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:21:05.26,0:21:07.01,Default,,0,0,0,,Роджер!
Dialogue: 0,0:21:07.09,0:21:09.43,Default,,0,0,0,,Әйтеуір, өлсең
Dialogue: 0,0:21:09.51,0:21:12.22,Default,,0,0,0,,«Шынында менің әкем батыр болған»
Dialogue: 0,0:21:12.31,0:21:16.69,Default,,0,0,0,,Мен Кайдеге айтуым керек, сондықтан өте сақ бол.
Dialogue: 0,0:21:16.77,0:21:18.86,Default,,0,0,0,,(қараңғы және төмен фортепиано дыбысы)
Dialogue: 0,0:21:33.58,0:21:35.08,Default,,0,0,0,,(әнші әйелдің жоғары дауысы)
Dialogue: 0,0:21:47.59,0:21:49.51,Default,,0,0,0,,...
Dialogue: 0,0:21:49.59,0:21:51.14,Default,,0,0,0,,«Үстіңгі кружка»
Dialogue: 0,0:21:51.22,0:21:52.43,Default,,0,0,0,,«Батыр агенттігінің жабылуы туралы хабарлама»
Dialogue: 0,0:21:52.51,0:21:53.89,Default,,0,0,0,,«Батыр агенттік»
Dialogue: 0,0:21:53.97,0:21:55.43,Default,,0,0,0,,«Операцияны тоқтату»
Dialogue: 0,0:21:55.52,0:21:56.69,Default,,0,0,0,,Дааа?
Dialogue: 0,0:21:57.35,0:21:59.44,Default,,0,0,0,,Кешіріңіз, Котецу
Dialogue: 0,0:21:59.52,0:22:01.27,Default,,0,0,0,,Бен мырза…
Dialogue: 0,0:22:01.90,0:22:02.86,Default,,0,0,0,,Бірігу?
Dialogue: 0,0:22:02.94,0:22:04.82,Default,,0,0,0,,Ірі капиталдың араласуы
Dialogue: 0,0:22:04.90,0:22:07.20,Default,,0,0,0,,Бізде де қаржылық қиындықтар болды.
Dialogue: 0,0:22:07.28,0:22:09.28,Default,,0,0,0,,Мен жақсы сатып алушы таптым деп ойлаймын.
Dialogue: 0,0:22:09.36,0:22:09.99,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:22:09.36,0:22:09.99,Default,,0,0,0,,«Александр Ллойдс»
Dialogue: 0,0:22:09.99,0:22:10.07,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:22:10.07,0:22:10.53,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:22:10.07,0:22:10.53,Default,,0,0,0,,«Батыр дивизионының директоры»
Dialogue: 0,0:22:10.53,0:22:10.62,Default,,0,0,0,,«Батыр дивизионының директоры»
Dialogue: 0,0:22:10.62,0:22:10.70,Default,,0,0,0,,Иә? Бұл кім?
Dialogue: 0,0:22:10.70,0:22:11.28,Default,,0,0,0,,Иә? Бұл кім?
Dialogue: 0,0:22:10.70,0:22:11.28,Default,,0,0,0,,«Аполлон медиа компаниясы»
Dialogue: 0,0:22:11.28,0:22:13.37,Default,,0,0,0,,Иә? Бұл кім?
Dialogue: 0,0:22:13.45,0:22:15.54,Default,,0,0,0,,Бұл сіздің жаңа бастығыңыз. (Котецу) А?
Dialogue: 0,0:22:16.25,0:22:18.29,Default,,0,0,0,,Енді сол жаққа барып, сәлемдесіңіз.
Dialogue: 0,0:22:18.37,0:22:21.54,Default,,0,0,0,,Сәл күте тұрыңыз. Жағдай сергітеді...
Dialogue: 0,0:22:22.13,0:22:24.59,Default,,0,0,0,,Келесі қаржы жылынан бастап жеті ірі компания кейіпкерге айналады⸺
Dialogue: 0,0:22:24.67,0:22:27.13,Default,,0,0,0,,Бұл монополиялау және бақылау туралы.
Dialogue: 0,0:22:27.63,0:22:30.34,Default,,0,0,0,,Сонымен, біздің компания мұны жасаған соңғы компания болды.
Dialogue: 0,0:22:30.43,0:22:32.55,Default,,0,0,0,,Осыны айтып тұрсыз ба?
Dialogue: 0,0:22:33.31,0:22:35.22,Default,,0,0,0,,Түсінудің қажеті жоқ!
Dialogue: 0,0:22:35.31,0:22:37.64,Default,,0,0,0,,Сіз басқа батырлар туралы білесіз бе?
Dialogue: 0,0:22:39.90,0:22:41.06,Default,,0,0,0,,Мен ғана ма?
Dialogue: 0,0:22:41.86,0:22:43.07,Default,,0,0,0,,Кавабуки мен Цукуёми командасы
Dialogue: 0,0:22:47.82,0:22:49.53,Default,,0,0,0,,Сен жабайы жолбарыссың ба?
Dialogue: 0,0:22:50.49,0:22:53.37,Default,,0,0,0,,А... Оның аты Торатецу, сондықтан Жолбарыс шығар?
Dialogue: 0,0:22:53.45,0:22:56.41,Default,,0,0,0,,Котецу Кабураги Котецу
Dialogue: 0,0:22:56.50,0:22:57.62,Default,,0,0,0,,Хмм.
Dialogue: 0,0:22:59.62,0:23:02.92,Default,,0,0,0,,Олай болса, неге ҒЗТКЖ бөлімінен костюмді түсіндіруді сұрамайсыз?
Dialogue: 0,0:23:03.00,0:23:05.92,Default,,0,0,0,,Жоқ... Бүгіннен бері ештеңе естіген жоқпын...
Dialogue: 0,0:23:06.00,0:23:08.42,Default,,0,0,0,,Егер бұл сізге ұнамаса, мені тастауды сұрай аласыз.
Dialogue: 0,0:23:08.51,0:23:10.43,Default,,0,0,0,,(дыбысты дауыс)
Dialogue: 0,0:23:13.51,0:23:14.43,Default,,0,0,0,,Мен мұны істеймін...
Dialogue: 0,0:23:14.51,0:23:16.43,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:23:16.52,0:23:17.56,Default,,0,0,0,,«Шұғыл»
Dialogue: 0,0:23:17.64,0:23:19.43,Default,,0,0,0,,Өнеркәсіптік аудан ма?
Dialogue: 0,0:23:20.81,0:23:22.10,Default,,0,0,0,,Болат балға мүсіні?
Dialogue: 0,0:23:22.69,0:23:25.77,Default,,0,0,0,,Бұл жай ғана символдық нысан болуы керек...
Dialogue: 0,0:23:26.36,0:23:27.82,Default,,0,0,0,,Неліктен қозғалады?
Dialogue: 0,0:23:27.90,0:23:29.57,Default,,0,0,0,,Бұл Next жұмысы болуы мүмкін
Dialogue: 0,0:23:29.65,0:23:31.61,Default,,0,0,0,,Жақсы! Бірден шығыңыз
Dialogue: 0,0:23:31.70,0:23:32.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:32.41,0:23:33.07,Default,,0,0,0,,(Мотоциклдің жүгіру дыбысы)
Dialogue: 0,0:23:33.16,0:23:36.20,Default,,0,0,0,,Бұдан былай мен сені жаңа костюммен жұмысқа шақырамын.
Dialogue: 0,0:23:37.54,0:23:39.29,Default,,0,0,0,,Сіз не істей аласыз?
Dialogue: 0,0:23:40.12,0:23:41.83,Default,,0,0,0,,Шағымдарыңыз бар ма?
Dialogue: 0,0:23:42.58,0:23:45.67,Default,,0,0,0,,Менің өз костюмімнен басқа ештеңе киюге ниетім жоқ.
Dialogue: 0,0:23:45.75,0:23:47.17,Default,,0,0,0,,Қорықпа.
Dialogue: 0,0:23:47.25,0:23:50.17,Default,,0,0,0,,Өнімділік сіз кигеніңізден әлдеқайда жоғары.
Dialogue: 0,0:23:50.26,0:23:51.93,Default,,0,0,0,,Мәселе бұл емес!
Dialogue: 0,0:23:52.55,0:23:54.09,Default,,0,0,0,,Мен үшін батыр
Dialogue: 0,0:23:54.18,0:23:56.56,Default,,0,0,0,,Ол костюмсіз жақсы емес!
Dialogue: 0,0:23:56.64,0:23:58.97,Default,,0,0,0,,Бұл фигура мені таң қалдырады...
Dialogue: 0,0:23:59.06,0:24:00.89,Default,,0,0,0,,Жарайды, тез жүр!
Dialogue: 0,0:24:00.98,0:24:02.14,Default,,0,0,0,,Иә
Dialogue: 0,0:24:02.23,0:24:04.19,Default,,0,0,0,,(Полиция көлігінің сиренасының дыбысы)
Dialogue: 0,0:24:09.57,0:24:12.24,Default,,0,0,0,,(Тездіргіш музыка)
Dialogue: 0,0:24:18.83,0:24:20.50,Default,,0,0,0,,Бұл таңқаларлық жақсы...
Dialogue: 0,0:24:20.58,0:24:22.50,Default,,0,0,0,,(қатты соққы дыбысы)
Dialogue: 0,0:24:23.29,0:24:25.42,Default,,0,0,0,,Бұл ол! Жақсы!
Dialogue: 0,0:24:25.50,0:24:27.13,Default,,0,0,0,,Бір маңызды нәрсе
Dialogue: 0,0:24:27.21,0:24:30.13,Default,,0,0,0,,Мен сені белгілі бір кейіпкермен біріктіремін.
Dialogue: 0,0:24:30.21,0:24:31.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:31.30,0:24:33.38,Default,,0,0,0,,Батырлар әлеміндегі алғашқы дуэттің құрылуы
Dialogue: 0,0:24:33.47,0:24:35.47,Default,,0,0,0,,Бұл біздің Apollo Media-ның сауда нүктесі.
Dialogue: 0,0:24:35.55,0:24:37.47,Default,,0,0,0,,Мен бұл туралы естіген жоқпын ...
Dialogue: 0,0:24:37.55,0:24:39.97,Default,,0,0,0,,Егер бұл сізге ұнамаса, мені тастауды сұрай аласыз.
Dialogue: 0,0:24:41.56,0:24:43.69,Default,,0,0,0,,(қатты соққы дыбысы)
Dialogue: 0,0:24:43.77,0:24:45.23,Default,,0,0,0,,Бұл не, комбинация?
Dialogue: 0,0:24:45.31,0:24:47.15,Default,,0,0,0,,Кіммен... топтасуым керек?
Dialogue: 0,0:24:47.23,0:24:49.23,Default,,0,0,0,,...!
Dialogue: 0,0:24:50.32,0:24:53.82,Default,,0,0,0,,Айт... Жалғыз сенің қолыңнан келмейді деп ойлаймын.
Dialogue: 0,0:24:53.90,0:24:55.28,Default,,0,0,0,,Не? сен?
Dialogue: 0,0:24:58.24,0:25:00.12,Default,,0,0,0,,Иә? Шынайы ма? Бұл рок бизоны ма?
Dialogue: 0,0:25:01.75,0:25:02.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:02.79,0:25:05.79,Default,,0,0,0,,Жоқ, «Иә?» емес! сен менікісің...
Dialogue: 0,0:25:10.92,0:25:13.38,Default,,0,0,0,,Хе... Барамын, ағай.
Dialogue: 0,0:25:15.38,0:25:17.22,Default,,0,0,0,,Не? ...Бұл сенсің!
Dialogue: 0,0:25:19.26,0:25:20.72,Default,,0,0,0,,«Чейзер ауыстыру»
Dialogue: 0,0:25:24.56,0:25:26.06,Default,,0,0,0,,〈Қос қуу! 〉
Dialogue: 0,0:25:29.11,0:25:30.69,Default,,0,0,0,,Мен неге мұндамын?
Dialogue: 0,0:25:31.65,0:25:32.73,Default,,0,0,0,,Бұл сізге сәйкес келеді.
Dialogue: 0,0:25:33.49,0:25:35.03,Default,,0,0,0,,Бұл жауап емес!
Dialogue: 0,0:25:35.11,0:25:36.86,Default,,0,0,0,,Компанияның тапсырысы
Dialogue: 0,0:25:38.99,0:25:40.87,Default,,0,0,0,,(мазасыз музыка)
Dialogue: 0,0:25:40.95,0:25:44.25,Default,,0,0,0,,«Қысқы балғын салқын жалбыз»
Dialogue: 0,0:25:50.79,0:25:52.92,Default,,0,0,0,,(Адамдардың қашып бара жатқан дыбыстары)
Dialogue: 0,0:26:00.55,0:26:00.60,Default,,0,0,0,,Бұл бөлімді маған қалдырыңыз, әзірге...
Dialogue: 0,0:26:00.60,0:26:02.60,Default,,0,0,0,,Бұл бөлімді маған қалдырыңыз, әзірге...
Dialogue: 0,0:26:00.60,0:26:02.60,Default,,0,0,0,,«Қалыпты режим» «Айдаһар бала»
Dialogue: 0,0:26:05.77,0:26:08.10,Default,,0,0,0,,«Талдау»
Dialogue: 0,0:26:08.19,0:26:09.44,Default,,0,0,0,,«Өрт эмблемасы»
Dialogue: 0,0:26:09.52,0:26:12.11,Default,,0,0,0,,Неге қазір бармайсың?
Dialogue: 0,0:26:12.19,0:26:13.23,Default,,0,0,0,,Мәліметтерді жинау
Dialogue: 0,0:26:14.94,0:26:17.32,Default,,0,0,0,,Басқа батырлардың жағдайын білсең
Dialogue: 0,0:26:17.40,0:26:20.24,Default,,0,0,0,,Көрініс үлгісі бір-біріне қайшы келмейді және бағдарламада көзге түседі
Dialogue: 0,0:26:20.32,0:26:21.99,Default,,0,0,0,,Әй... Бұл қоқыс!
Dialogue: 0,0:26:23.03,0:26:23.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:26:25.16,0:26:28.25,Default,,0,0,0,,Қылмыскер көзге түссе ұсталады ма? Қаланың тыныштығы қандай?
Dialogue: 0,0:26:28.33,0:26:29.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:26:29.62,0:26:31.08,Default,,0,0,0,,Тыңдаңыз! Батырлар ше?
Dialogue: 0,0:26:31.17,0:26:32.67,Default,,0,0,0,,Бонжур батыры
Dialogue: 0,0:26:33.25,0:26:35.17,Default,,0,0,0,,Нақты бастау Бүгінгі қолдауыңыз үшін рахмет!
Dialogue: 0,0:26:35.92,0:26:37.67,Default,,0,0,0,,3… 2…
Dialogue: 0,0:26:38.80,0:26:40.59,Default,,0,0,0,,Келіңіздер! Ол басталды
Dialogue: 0,0:26:40.68,0:26:42.72,Default,,0,0,0,,...
Dialogue: 0,0:26:42.80,0:26:44.18,Default,,0,0,0,,(Шұғылдық сезімі бар музыка)
Dialogue: 0,0:26:44.26,0:26:45.43,Default,,0,0,0,,Sternbild жеті ірі компаниясы⸺
Dialogue: 0,0:26:45.52,0:26:47.73,Default,,0,0,0,,Батырды монополияландырыңыз!
Dialogue: 0,0:26:47.81,0:26:48.39,Default,,0,0,0,,«Посейдон сызығы жоғары аспан»
Dialogue: 0,0:26:48.39,0:26:49.06,Default,,0,0,0,,«Poseidon Line Sky High» жаңа жүйе бойынша жіберіледі
Dialogue: 0,0:26:49.06,0:26:49.14,Default,,0,0,0,,Жаңа жүйе бойынша жеткізіледі
Dialogue: 0,0:26:49.14,0:26:49.64,Default,,0,0,0,,«Оригами циклоны» жаңа жүйе бойынша жеткізіледі
Dialogue: 0,0:26:49.64,0:26:49.73,Default,,0,0,0,,«Оригами циклоны»
Dialogue: 0,0:26:49.73,0:26:50.56,Default,,0,0,0,,«Оригами циклоны» маусымы ақыры аяқталуға жақын
Dialogue: 0,0:26:50.56,0:26:50.65,Default,,0,0,0,,Маусымның шымылдығы ақыры төмендейді.
Dialogue: 0,0:26:50.65,0:26:52.06,Default,,0,0,0,,Маусымның шымылдығы аяқталады «Айдаһар бала»
Dialogue: 0,0:26:52.15,0:26:53.06,Default,,0,0,0,,«Рок бизон»
Dialogue: 0,0:26:53.06,0:26:53.57,Default,,0,0,0,,«Рок бизон» Сонымен, осы маусымда қай кейіпкер болады?
Dialogue: 0,0:26:53.57,0:26:53.65,Default,,0,0,0,,Енді осы маусымда қай кейіпкер болады?
Dialogue: 0,0:26:53.65,0:26:55.07,Default,,0,0,0,,Енді осы маусымда «От эмблемасы» қай кейіпкер болады?
Dialogue: 0,0:26:55.07,0:26:55.15,Default,,0,0,0,,Енді осы маусымда қай кейіпкер болады?
Dialogue: 0,0:26:55.15,0:26:55.73,Default,,0,0,0,,Енді осы маусымда қай кейіпкер «Көк раушан» болады?
Dialogue: 0,0:26:55.73,0:26:55.82,Default,,0,0,0,,«Көк раушан»
Dialogue: 0,0:26:55.82,0:26:56.57,Default,,0,0,0,,«Көк раушан» патшаның даңқымен жарқырай ма?
Dialogue: 0,0:26:56.57,0:26:56.65,Default,,0,0,0,,Патшаның даңқымен жарқыраймыз ба?
Dialogue: 0,0:26:56.65,0:26:58.65,Default,,0,0,0,,Патша даңқын жарқырата ма? «Жабайы жолбарыс пен Барнаби»
Dialogue: 0,0:27:01.74,0:27:03.16,Default,,0,0,0,,Енді жұмысқа кірісу уақыты келді.
Dialogue: 0,0:27:03.24,0:27:05.95,Default,,0,0,0,,Күте тұрыңыз, әңгіме әлі біткен жоқ...
Dialogue: 0,0:27:06.04,0:27:07.20,Default,,0,0,0,,Ха!
Dialogue: 0,0:27:07.29,0:27:08.29,Default,,0,0,0,,Мен шыдай алмаймын!
Dialogue: 0,0:27:10.04,0:27:10.62,Default,,0,0,0,,Не?
Dialogue: 0,0:27:11.75,0:27:15.13,Default,,0,0,0,,Ой! Бұл жүк көлігі ше?
Dialogue: 0,0:27:18.05,0:27:20.97,Default,,0,0,0,,Менің мұзым сәл салқын
Dialogue: 0,0:27:21.55,0:27:23.93,Default,,0,0,0,,Сіздің теріс қылықтарыңыз толығымен жабылады!
Dialogue: 0,0:27:24.01,0:27:25.26,Default,,0,0,0,,Бұл шықты!
Dialogue: 0,0:27:25.35,0:27:28.10,Default,,0,0,0,,«Тек дене ғана емес!
Dialogue: 0,0:27:28.18,0:27:30.73,Default,,0,0,0,,Көк раушан гүлімен таныстыру!
Dialogue: 0,0:27:31.23,0:27:33.90,Default,,0,0,0,,Жарайсыңдар! Мен оны сағындым!
Dialogue: 0,0:27:33.98,0:27:36.61,Default,,0,0,0,,Бұл жігіт кім... Иә?
Dialogue: 0,0:27:38.65,0:27:40.78,Default,,0,0,0,,О! Бір минут күтіңіз!
Dialogue: 0,0:27:45.28,0:27:47.08,Default,,0,0,0,,Мен оны сымға іліп, құлатамын!
Dialogue: 0,0:27:47.16,0:27:48.08,Default,,0,0,0,,Жұмыстан шығару
Dialogue: 0,0:27:48.16,0:27:49.70,Default,,0,0,0,,Шу!
Dialogue: 0,0:27:49.79,0:27:51.87,Default,,0,0,0,,Мен саған батырдың не екенін көрсетемін!
Dialogue: 0,0:27:51.96,0:27:52.83,Default,,0,0,0,,Хаа!
Dialogue: 0,0:27:52.92,0:27:54.96,Default,,0,0,0,,(әлсіз механикалық дыбыс)
Dialogue: 0,0:27:55.04,0:27:57.84,Default,,0,0,0,,Иә? А...?
Dialogue: 0,0:27:59.76,0:28:01.59,Default,,0,0,0,,Ой!
Dialogue: 0,0:28:03.55,0:28:04.89,Default,,0,0,0,,Мұқият қараңыз!
Dialogue: 0,0:28:05.80,0:28:07.35,Default,,0,0,0,,(дірілдеген дауыс)
Dialogue: 0,0:28:10.23,0:28:12.27,Default,,0,0,0,,Онда не бар...
Dialogue: 0,0:28:12.35,0:28:14.23,Default,,0,0,0,,Бұл шықты!
Dialogue: 0,0:28:14.31,0:28:17.77,Default,,0,0,0,,Жаңа кейіпкер! Бұл Барнаби!
Dialogue: 0,0:28:17.86,0:28:18.78,Default,,0,0,0,,Фу…
Dialogue: 0,0:28:19.36,0:28:21.32,Default,,0,0,0,,«Ах...» Олай етпе!
Dialogue: 0,0:28:22.15,0:28:23.15,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:28:23.24,0:28:25.03,Default,,0,0,0,,«Нысанды блоктау»
Dialogue: 0,0:28:32.00,0:28:32.58,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:28:32.66,0:28:33.50,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:28:35.42,0:28:36.75,Default,,0,0,0,,Иә? а?
Dialogue: 0,0:28:38.59,0:28:41.72,Default,,0,0,0,,(Лақтырып бара жатқан дауыс)
Dialogue: 0,0:28:41.80,0:28:42.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:28:44.76,0:28:46.22,Default,,0,0,0,,(Айналмалы дауыс)
Dialogue: 0,0:28:47.80,0:28:49.22,Default,,0,0,0,,Не қалжыңдап тұрсың?
Dialogue: 0,0:28:49.31,0:28:52.02,Default,,0,0,0,,Ұсталған сенсің ғой?
Dialogue: 0,0:28:52.60,0:28:54.23,Default,,0,0,0,,Иә... иә?
Dialogue: 0,0:28:54.31,0:28:56.52,Default,,0,0,0,,(Музыка қауіпті)
Dialogue: 0,0:28:57.31,0:28:59.61,Default,,0,0,0,,(қорқыныш айқайы)
Dialogue: 0,0:29:03.11,0:29:05.24,Default,,0,0,0,,Мен енді ондай адаммен жұмыс істей алмаймын.
Dialogue: 0,0:29:06.03,0:29:09.08,Default,,0,0,0,,Нәтижелерді алғаннан кейін делік, жарай ма?
Dialogue: 0,0:29:09.16,0:29:12.66,Default,,0,0,0,,Дәл қазір мен: «Сендер үшін бәрі бітті» деп ойладым.
Dialogue: 0,0:29:13.75,0:29:16.83,Default,,0,0,0,,Мен оның тоқтағанына қуаныштымын.
Dialogue: 0,0:29:16.92,0:29:19.42,Default,,0,0,0,,Мүсіннің қозғалуын тоқтатқанына бір сағат болды.
Dialogue: 0,0:29:19.50,0:29:22.30,Default,,0,0,0,,Әлі де қозғалыс белгісі жоқ.
Dialogue: 0,0:29:22.38,0:29:25.68,Default,,0,0,0,,Бұл не сұмдық? қылмыскердің мақсаты
Dialogue: 0,0:29:25.76,0:29:27.76,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:29:27.84,0:29:28.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:28.97,0:29:31.31,Default,,0,0,0,,Мен оқиғадан гөрі сені уайымдап тұрмын!
Dialogue: 0,0:29:31.39,0:29:32.85,Default,,0,0,0,,Позиция Түсінесіз бе?
Dialogue: 0,0:29:32.93,0:29:33.64,Default,,0,0,0,,Позиция?
Dialogue: 0,0:29:33.73,0:29:36.64,Default,,0,0,0,,Иә! Бернабиді толықтыратын екінші тұлға ретінде
Dialogue: 0,0:29:36.73,0:29:38.56,Default,,0,0,0,,Мен сізбен келісім-шарт жасадым.
Dialogue: 0,0:29:38.65,0:29:39.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:39.98,0:29:43.61,Default,,0,0,0,,Барнабидің екіншісі! Көмекші! бонус! Түсінесіз бе?
Dialogue: 0,0:29:43.69,0:29:46.82,Default,,0,0,0,,Эй...күте тұрыңыз! Мен неге ол жігітпін?
Dialogue: 0,0:29:46.91,0:29:50.58,Default,,0,0,0,,Иә! Механик те саған ашуланды.
Dialogue: 0,0:29:58.42,0:29:59.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:59.50,0:30:01.84,Default,,0,0,0,,(Мен дауысты ести алмаймын)
Dialogue: 0,0:30:02.88,0:30:03.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:03.92,0:30:06.84,Default,,0,0,0,,(Мен дауысты ести алмаймын)
Dialogue: 0,0:30:07.43,0:30:09.34,Default,,0,0,0,,Иә? Хмм? иә?
Dialogue: 0,0:30:09.43,0:30:12.93,Default,,0,0,0,,Мен Сайтомын, сіздің костюміңізді жасаған адаммын.
Dialogue: 0,0:30:13.01,0:30:14.10,Default,,0,0,0,,Жоқ... бұл дауыс...
Dialogue: 0,0:30:14.68,0:30:17.52,Default,,0,0,0,,Егер сіз оны жақсырақ пайдаланбасаңыз, сіз қиындыққа тап боласыз.
Dialogue: 0,0:30:17.60,0:30:20.10,Default,,0,0,0,,Жоқ, мен оны әлі түсінбеймін.
Dialogue: 0,0:30:20.19,0:30:24.86,Default,,0,0,0,,Қараңдаршы, бұл мен әзірлеген костюм.
Dialogue: 0,0:30:25.44,0:30:28.36,Default,,0,0,0,,Бұл сенің бұрын киген қарғыс костюмің.
Dialogue: 0,0:30:29.11,0:30:31.37,Default,,0,0,0,,Бұлай айту қиын...
Dialogue: 0,0:30:31.45,0:30:32.62,Default,,0,0,0,,Мен бұл туралы білмеймін.
Dialogue: 0,0:30:32.70,0:30:34.12,Default,,0,0,0,,...
Dialogue: 0,0:30:34.20,0:30:36.04,Default,,0,0,0,,(жану дыбысы)
Dialogue: 0,0:30:44.09,0:30:44.88,Default,,0,0,0,,(Ақылсыз күлкі)
Dialogue: 0,0:30:52.97,0:30:54.14,Default,,0,0,0,,(Қорқыған дауыс)
Dialogue: 0,0:30:55.06,0:30:55.89,Default,,0,0,0,,(Ақымақ сияқты күледі)
Dialogue: 0,0:30:56.68,0:30:58.48,Default,,0,0,0,,(таңданған дауыс)
Dialogue: 0,0:31:00.14,0:31:02.69,Default,,0,0,0,,(қорыққан дауыс)
Dialogue: 0,0:31:03.27,0:31:05.19,Default,,0,0,0,,Түсіндім! Мен түссіндім!
Dialogue: 0,0:31:08.99,0:31:10.78,Default,,0,0,0,,Мен жеткілікті түсіндім...
Dialogue: 0,0:31:13.70,0:31:15.79,Default,,0,0,0,,Бұл жүз жеткілікті...
Dialogue: 0,0:31:15.87,0:31:19.50,Default,,0,0,0,,Айтпақшы, сіздің мүмкіндігіңізді ескере отырып, бұл бар болғаны 5 минутты алады.
Dialogue: 0,0:31:19.58,0:31:21.96,Default,,0,0,0,,Арнайы функциялар орнатылды.
Dialogue: 0,0:31:22.04,0:31:22.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:31:22.92,0:31:24.79,Default,,0,0,0,,Қолыңызда түйме бар, солай ма?
Dialogue: 0,0:31:29.80,0:31:30.88,Default,,0,0,0,,Бұл ма?
Dialogue: 0,0:31:30.97,0:31:32.18,Default,,0,0,0,,Түсіндіруді дұрыс тыңдаңыз!
Dialogue: 0,0:31:32.26,0:31:35.18,Default,,0,0,0,,(комикалық музыка)
Dialogue: 0,0:31:39.52,0:31:42.44,Default,,0,0,0,,Сағат 15:28.
Dialogue: 0,0:31:43.10,0:31:45.94,Default,,0,0,0,,Бұл сағат па?
Dialogue: 0,0:31:47.53,0:31:51.28,Default,,0,0,0,,Уау! Тоттотто...!
Dialogue: 0,0:31:51.36,0:31:52.95,Default,,0,0,0,,Сіз таң қалдыңыз ба?
Dialogue: 0,0:31:53.03,0:31:54.45,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:31:54.53,0:31:56.33,Default,,0,0,0,,Мен онда сағат 3-те боламын деп жоспарлап едім.
Dialogue: 0,0:31:56.41,0:31:58.66,Default,,0,0,0,,-да? Қазір қайдасың?
Dialogue: 0,0:31:58.75,0:32:00.16,Default,,0,0,0,,Менің әлі жұмысым қалды.
Dialogue: 0,0:32:00.91,0:32:02.67,Default,,0,0,0,,Келетініңізге сенімдісіз бе?
Dialogue: 0,0:32:02.75,0:32:03.88,Default,,0,0,0,,Әрине!
Dialogue: 0,0:32:03.96,0:32:06.17,Default,,0,0,0,,Қашан? Тағы қанша?
Dialogue: 0,0:32:06.25,0:32:08.17,Default,,0,0,0,,Ах... мм...
Dialogue: 0,0:32:08.25,0:32:10.21,Default,,0,0,0,,(мұңды музыка)
Dialogue: 0,0:32:10.30,0:32:11.67,Default,,0,0,0,,Ол бәрібір келмейді.
Dialogue: 0,0:32:11.76,0:32:14.30,Default,,0,0,0,,Кеттік! Ол сағат нешеде басталды?
Dialogue: 0,0:32:14.39,0:32:14.97,Default,,0,0,0,,4 сағат
Dialogue: 0,0:32:15.55,0:32:16.68,Default,,0,0,0,,Жарайды! Мен бірден сонда барамын
Dialogue: 0,0:32:16.76,0:32:18.68,Default,,0,0,0,,(Қоңырау үні)
Dialogue: 0,0:32:18.77,0:32:20.14,Default,,0,0,0,,Ах! Бір сәт кешіріңіз
Dialogue: 0,0:32:20.22,0:32:23.06,Default,,0,0,0,,Жолбарыс пен Барнабиді жіберу туралы сұрау жіберілді!
Dialogue: 0,0:32:23.14,0:32:25.02,Default,,0,0,0,,Тас мүсін қозғала бастаған сияқты.
Dialogue: 0,0:32:25.10,0:32:27.82,Default,,0,0,0,,Тез дайындалып, оқиға орнына барыңыз.
Dialogue: 0,0:32:28.65,0:32:30.49,Default,,0,0,0,,Білесің бе... (Кэде) Не істеуіміз керек!
Dialogue: 0,0:32:30.57,0:32:32.07,Default,,0,0,0,,Мен қобалжыдым!
Dialogue: 0,0:32:32.65,0:32:34.61,Default,,0,0,0,,Әке! Өтінемін, тезірек келіңіз!
Dialogue: 0,0:32:35.20,0:32:37.62,Default,,0,0,0,,Мүлдем!
Dialogue: 0,0:32:39.45,0:32:41.12,Default,,0,0,0,,(Кенеттен түсінген дауыс)
Dialogue: 0,0:32:43.71,0:32:45.12,Default,,0,0,0,,Warii! Мен сені күтуге мәжбүр еттім
Dialogue: 0,0:32:45.79,0:32:48.80,Default,,0,0,0,,Менің өмірімнің 3 минутын босқа өткіздің
Dialogue: 0,0:32:48.88,0:32:49.88,Default,,0,0,0,,Мен оны ешқашан ұмытпаймын
Dialogue: 0,0:32:50.96,0:32:53.38,Default,,0,0,0,,Сенің... сенің достарың жоқ, солай ма?
Dialogue: 0,0:32:54.18,0:32:54.72,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:32:54.80,0:32:56.80,Default,,0,0,0,,Блоктар аймағынан үлкен сирек келуші.
Dialogue: 0,0:32:56.89,0:32:58.89,Default,,0,0,0,,Батырлар мұны қалай шешеді?
Dialogue: 0,0:33:02.10,0:33:03.14,Default,,0,0,0,,Ух⸺!
Dialogue: 0,0:33:03.23,0:33:03.56,Default,,0,0,0,,Көк раушан - бірінші!
Dialogue: 0,0:33:03.56,0:33:05.40,Default,,0,0,0,,Біріншісі - Көк раушан!
Dialogue: 0,0:33:03.56,0:33:05.40,Default,,0,0,0,,«Көк раушан бірінші плюс 25 ұпай»
Dialogue: 0,0:33:07.86,0:33:09.65,Default,,0,0,0,,Сол жерде қалмаңыз!
Dialogue: 0,0:33:10.23,0:33:11.65,Default,,0,0,0,,Қандай тез!
Dialogue: 0,0:33:11.73,0:33:14.78,Default,,0,0,0,,Менің мұзым сәл салқын
Dialogue: 0,0:33:35.05,0:33:38.55,Default,,0,0,0,,Сіздің қозғалыстарыңызды толық бақылау...
Dialogue: 0,0:33:38.64,0:33:39.39,Default,,0,0,0,,(таңданған дауыс)
Dialogue: 0,0:33:43.14,0:33:44.56,Default,,0,0,0,,(Көк раушан айқайы)
Dialogue: 0,0:33:48.10,0:33:49.90,Default,,0,0,0,,(Адамдардың дүрбелең дауысы)
Dialogue: 0,0:33:51.48,0:33:53.40,Default,,0,0,0,,Мұз жеткіліксіз болды ма?
Dialogue: 0,0:33:53.48,0:33:55.28,Default,,0,0,0,,Бұл өтірік емес пе?
Dialogue: 0,0:33:57.45,0:33:58.99,Default,,0,0,0,,Ахх!
Dialogue: 0,0:34:02.37,0:34:03.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:34:04.04,0:34:05.04,Default,,0,0,0,,Сүйкімді қашу⸺
Dialogue: 0,0:34:05.12,0:34:06.54,Default,,0,0,0,,Мен одан өттім!
Dialogue: 0,0:34:10.13,0:34:12.42,Default,,0,0,0,,(Полиция қызметкерлерінің суық дауыстары)
Dialogue: 0,0:34:13.05,0:34:17.97,Default,,0,0,0,,Егер сіз соншалықты керемет нәрсе істеп жатсаңыз, өзіңізді тоқтатыңыз!
Dialogue: 0,0:34:18.05,0:34:19.59,Default,,0,0,0,,Бұл тітіркендіргіш
Dialogue: 0,0:34:24.27,0:34:26.18,Default,,0,0,0,,Саа!
Dialogue: 0,0:34:26.77,0:34:28.98,Default,,0,0,0,,Азаматтарды құтқару үшін батырлар
Dialogue: 0,0:34:29.06,0:34:31.19,Default,,0,0,0,,Тас мүсінмен жұмыс істеу қиынға соғатын сияқты.
Dialogue: 0,0:34:34.44,0:34:36.86,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:34:37.44,0:34:39.11,Default,,0,0,0,,Тез... Тездетіңіз
Dialogue: 0,0:34:39.20,0:34:40.49,Default,,0,0,0,,Баруға дайын
Dialogue: 0,0:34:40.57,0:34:42.24,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:34:42.33,0:34:45.29,Default,,0,0,0,,321 ұшыруға дейін… «Рок бизонды ұшыру»
Dialogue: 0,0:34:45.29,0:34:46.87,Default,,0,0,0,,321 ұшыруға дейін...
Dialogue: 0,0:34:48.62,0:34:51.29,Default,,0,0,0,,Тас бизоны ұшып кетті
Dialogue: 0,0:34:51.38,0:34:53.88,Default,,0,0,0,,Иә! Ой!
Dialogue: 0,0:34:54.46,0:34:56.71,Default,,0,0,0,,Бұрғымен бағытты дәл баптаңыз!
Dialogue: 0,0:34:56.80,0:35:00.13,Default,,0,0,0,,Бұл мен күткендей болмады...
Dialogue: 0,0:35:00.22,0:35:01.64,Default,,0,0,0,,(қорқыған дауыс)
Dialogue: 0,0:35:03.76,0:35:05.01,Default,,0,0,0,,Сонымен, осы екі адамның қайсысы Стэнді қолданады?
Dialogue: 0,0:35:06.06,0:35:07.48,Default,,0,0,0,,(Қабырғаға соғылған дауыс)
Dialogue: 0,0:35:07.56,0:35:10.69,Default,,0,0,0,,Қоңырауды жабу! Және дәл уақытында!
Dialogue: 0,0:35:10.77,0:35:12.40,Default,,0,0,0,,Сангю…
Dialogue: 0,0:35:12.48,0:35:14.82,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:35:14.90,0:35:16.32,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:35:20.40,0:35:21.53,Default,,0,0,0,,♬ Бос соңғы бетте
Dialogue: 0,0:35:22.91,0:35:24.53,Default,,0,0,0,,Иә? сурет? сурет?
Dialogue: 0,0:35:25.33,0:35:26.74,Default,,0,0,0,,«Sky High Life Saving Plus 100 ұпай»
Dialogue: 0,0:35:26.83,0:35:30.29,Default,,0,0,0,,(Адамдардың қашып бара жатқан дыбыстары)
Dialogue: 0,0:35:32.38,0:35:34.29,Default,,0,0,0,,(мазасыз музыка)
Dialogue: 0,0:35:36.38,0:35:37.96,Default,,0,0,0,,«Жабайы жолбарыс» «Қалыпты режим»
Dialogue: 0,0:35:38.05,0:35:39.42,Default,,0,0,0,,Оған өз күнәларының ауырлығын түсіну үшін—
Dialogue: 0,0:35:42.55,0:35:43.64,Default,,0,0,0,,Сәл күте тұрыңыз
Dialogue: 0,0:35:44.35,0:35:44.97,Default,,0,0,0,,Әй?
Dialogue: 0,0:35:45.72,0:35:46.93,Default,,0,0,0,,Неге біз мұнда бірге тұрмаймыз?
Dialogue: 0,0:35:47.01,0:35:48.72,Default,,0,0,0,,Маған көмектесетініңізге сенімдімін!
Dialogue: 0,0:35:48.81,0:35:50.43,Default,,0,0,0,,Менің шегерім дұрыс болса
Dialogue: 0,0:35:50.52,0:35:52.23,Default,,0,0,0,,Менің мұндай әңгімелерді тыңдауға уақытым жоқ!
Dialogue: 0,0:35:52.31,0:35:54.06,Default,,0,0,0,,Айналада ешкім жоқ кезде
Dialogue: 0,0:35:54.15,0:35:56.11,Default,,0,0,0,,Әлгі бала мүсінді жылжытып тұрған жоқ па?
Dialogue: 0,0:35:56.19,0:35:57.57,Default,,0,0,0,,Жолдан кет (Барнаби) Мүмкін...
Dialogue: 0,0:35:57.65,0:35:59.69,Default,,0,0,0,,КЕЛЕСІ, ол өз қалауы бойынша не түртетінін басқарады
Dialogue: 0,0:35:59.78,0:36:01.36,Default,,0,0,0,,Жарайды, жолдан кет!
Dialogue: 0,0:36:01.45,0:36:02.78,Default,,0,0,0,,Сол бала кінәлі болуы мүмкін.
Dialogue: 0,0:36:02.86,0:36:05.03,Default,,0,0,0,,Кінәлі кім болса да, қандай болса да қауіпті!
Dialogue: 0,0:36:06.91,0:36:10.20,Default,,0,0,0,,Мені ертерек өлтірген сенің қателігің болды.
Dialogue: 0,0:36:10.29,0:36:11.96,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:36:12.04,0:36:14.71,Default,,0,0,0,,Мен саған сенбеймін
Dialogue: 0,0:36:15.79,0:36:19.38,Default,,0,0,0,,Негізі мен сенімен бірге болғым келмеді...
Dialogue: 0,0:36:19.46,0:36:21.47,Default,,0,0,0,,Бірақ бұл компания тапсырысы болғандықтан
Dialogue: 0,0:36:21.55,0:36:23.93,Default,,0,0,0,,О, түсіндім...
Dialogue: 0,0:36:24.01,0:36:25.89,Default,,0,0,0,,(мазасыз музыка)
Dialogue: 0,0:36:30.27,0:36:31.81,Default,,0,0,0,,(қатты соққы дыбысы)
Dialogue: 0,0:36:33.90,0:36:36.02,Default,,0,0,0,,Тыныш болыңыз!
Dialogue: 0,0:36:36.11,0:36:37.11,Default,,0,0,0,,(Адамдардың үрейлі дауыстары)
Dialogue: 0,0:36:39.07,0:36:40.44,Default,,0,0,0,,(таңданған дауыс)
Dialogue: 0,0:36:41.03,0:36:42.61,Default,,0,0,0,,Бұл аңыз мырза.
Dialogue: 0,0:36:42.70,0:36:44.53,Default,,0,0,0,,( дүрбелең дауысы)
Dialogue: 0,0:36:47.28,0:36:48.99,Default,,0,0,0,,Сізге бұл баланың не болғаны қызықты ма?
Dialogue: 0,0:36:51.00,0:36:52.16,Default,,0,0,0,,Шыу!
Dialogue: 0,0:36:56.96,0:36:58.46,Default,,0,0,0,,Сен…
Dialogue: 0,0:37:01.59,0:37:04.22,Default,,0,0,0,,Бұл күш адамдарды қорғау үшін бар.
Dialogue: 0,0:37:06.30,0:37:08.14,Default,,0,0,0,,Сіздің арқаңызда мен құтқарылдым.
Dialogue: 0,0:37:08.22,0:37:10.31,Default,,0,0,0,,Енді сен де батырсың!
Dialogue: 0,0:37:20.07,0:37:21.44,Default,,0,0,0,,(сізді оятатын дауыс)
Dialogue: 0,0:37:21.53,0:37:22.90,Default,,0,0,0,,Хмм... аа...
Dialogue: 0,0:37:24.40,0:37:25.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:28.49,0:37:30.28,Default,,0,0,0,,Сіз ояусыз ба?
Dialogue: 0,0:37:30.37,0:37:32.54,Default,,0,0,0,,Мұндай кезде ашуланба!
Dialogue: 0,0:37:32.62,0:37:35.21,Default,,0,0,0,,Бұл тас мүсін қайтадан қозғалуды тоқтатты.
Dialogue: 0,0:37:35.29,0:37:37.25,Default,,0,0,0,,Олай болса, ол жерден тез кет!
Dialogue: 0,0:37:37.88,0:37:39.71,Default,,0,0,0,,Бұл мүмкін емес. (Жабайы жолбарыс) А?
Dialogue: 0,0:37:39.79,0:37:41.75,Default,,0,0,0,,Мүмкіндікті пайдаланбасаңыз, бұл
Dialogue: 0,0:37:41.84,0:37:43.97,Default,,0,0,0,,Олай болса оны қазір іске қосыңыз!
Dialogue: 0,0:37:44.05,0:37:45.80,Default,,0,0,0,,Ол бар болғаны 5 минутқа созылады ма?
Dialogue: 0,0:37:45.88,0:37:47.84,Default,,0,0,0,,Мұнда біз аздап қолданамыз
Dialogue: 0,0:37:47.93,0:37:49.76,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:37:49.85,0:37:52.27,Default,,0,0,0,,Олай болса, Банни-чан, өзіңе ұнағаныңды істей бер!
Dialogue: 0,0:37:52.35,0:37:53.10,Default,,0,0,0,,Ааа!
Dialogue: 0,0:37:53.18,0:37:53.77,Default,,0,0,0,,Сәл күте тұрыңыз
Dialogue: 0,0:37:53.85,0:37:55.23,Default,,0,0,0,,Не!
Dialogue: 0,0:37:55.31,0:37:56.73,Default,,0,0,0,,Мен қате естігенім болмаса.
Dialogue: 0,0:37:56.81,0:37:59.23,Default,,0,0,0,,Мен туралы қазір Bunny-chan...?
Dialogue: 0,0:37:59.31,0:38:01.57,Default,,0,0,0,,Ұзын құлақпен жоғары-төмен секіру
Dialogue: 0,0:38:02.15,0:38:04.28,Default,,0,0,0,,Сүйкімді қоянға ұқсайды
Dialogue: 0,0:38:04.36,0:38:07.07,Default,,0,0,0,,Мен қоян емеспін! Бұл Барнаби!
Dialogue: 0,0:38:07.15,0:38:09.95,Default,,0,0,0,,«Мен қоян емеспін, мен Барнабимін!»
Dialogue: 0,0:38:10.03,0:38:11.49,Default,,0,0,0,,Мен олай айтқан жоқпын!
Dialogue: 0,0:38:11.58,0:38:13.08,Default,,0,0,0,,«Мен бұлай айтқан жоқпын!»
Dialogue: 0,0:38:13.16,0:38:14.25,Default,,0,0,0,,Жарай, бастайық!
Dialogue: 0,0:38:14.83,0:38:16.75,Default,,0,0,0,,Бұл жолы тағы бір тас мүсін қозғала бастады.
Dialogue: 0,0:38:17.87,0:38:18.25,Default,,0,0,0,,«Ресурс суреті»
Dialogue: 0,0:38:18.25,0:38:18.58,Default,,0,0,0,,«Ресурс кескіні» Герперид қаржысының символы
Dialogue: 0,0:38:18.58,0:38:18.67,Default,,0,0,0,,Герперид қаржысының символы
Dialogue: 0,0:38:18.67,0:38:19.54,Default,,0,0,0,,Herperides Finance символы «Heliperides Finance»
Dialogue: 0,0:38:19.54,0:38:20.21,Default,,0,0,0,,Герперид қаржысының символы
Dialogue: 0,0:38:20.29,0:38:23.67,Default,,0,0,0,,Арыстан мүсіні Жаңа Морген аймағына қарай қашып барады.
Dialogue: 0,0:38:25.59,0:38:29.01,Default,,0,0,0,,(екпінді дауыс)
Dialogue: 0,0:38:31.10,0:38:32.81,Default,,0,0,0,,(Тездіргіш музыка)
Dialogue: 0,0:38:32.89,0:38:34.68,Default,,0,0,0,,Сондай-ақ өтінемін
Dialogue: 0,0:38:34.77,0:38:35.60,Default,,0,0,0,,Әй?
Dialogue: 0,0:38:36.23,0:38:39.35,Default,,0,0,0,,Егер олар бір сәтте іске қосылса, ол байқалмайды.
Dialogue: 0,0:38:41.11,0:38:42.32,Default,,0,0,0,,Иә
Dialogue: 0,0:38:42.94,0:38:45.61,Default,,0,0,0,,(Шұғылдық сезімі бар музыка)
Dialogue: 0,0:38:49.07,0:38:51.99,Default,,0,0,0,,(Адамдардың қашып бара жатқан дыбыстары)
Dialogue: 0,0:38:54.08,0:38:55.20,Default,,0,0,0,,​​О?
Dialogue: 0,0:38:55.29,0:38:58.21,Default,,0,0,0,,(нәзік музыка)
Dialogue: 0,0:38:58.29,0:38:59.54,Default,,0,0,0,,696-санды тұтқын – Мұнда не болып жатыр өзі?
Dialogue: 0,0:39:01.21,0:39:02.50,Default,,0,0,0,,Түсіңіз
Dialogue: 0,0:39:03.25,0:39:04.59,Default,,0,0,0,,Келме!
Dialogue: 0,0:39:04.67,0:39:08.26,Default,,0,0,0,,(Арыстанның айқайы)
Dialogue: 0,0:39:08.34,0:39:09.51,Default,,0,0,0,,Эй!
Dialogue: 0,0:39:13.30,0:39:15.43,Default,,0,0,0,,(екпінді дауыс)
Dialogue: 0,0:39:15.51,0:39:16.77,Default,,0,0,0,,(Шұғылдық сезімі бар музыка)
Dialogue: 0,0:39:21.73,0:39:25.98,Default,,0,0,0,,Әй... Әдемі мырза, не істеп жатырсыз?
Dialogue: 0,0:39:26.07,0:39:28.28,Default,,0,0,0,,Кешіріңіз, бірақ мен үшін бірдеңе істей аласыз ба?
Dialogue: 0,0:39:28.36,0:39:29.90,Default,,0,0,0,,Хмм…
Dialogue: 0,0:39:29.99,0:39:31.86,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:39:31.95,0:39:34.45,Default,,0,0,0,,Жақсы адам сенен соны сұрайды!
Dialogue: 0,0:39:46.67,0:39:48.26,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:39:48.34,0:39:49.01,Default,,0,0,0,,Маюри үшін сол сәт келгенде қасында болғым келеді… яғни…
Dialogue: 0,0:39:49.84,0:39:51.05,Default,,0,0,0,,Хмм, қазірдің өзінде!
Dialogue: 0,0:39:51.13,0:39:54.60,Default,,0,0,0,,Бөксеңе тиюге рұқсат ет! Бұл ақылсыз!
Dialogue: 0,0:39:54.68,0:39:57.18,Default,,0,0,0,,Иә? О, жоқ!
Dialogue: 0,0:40:01.48,0:40:04.90,Default,,0,0,0,,Жоқ! Сіз қозғала алмайсыз! қазірдің өзінде!
Dialogue: 0,0:40:08.69,0:40:09.65,Default,,0,0,0,,Не?
Dialogue: 0,0:40:09.74,0:40:12.15,Default,,0,0,0,,(Таңданған адамдардың дауысы)
Dialogue: 0,0:40:16.33,0:40:18.29,Default,,0,0,0,,Ашуланба!
Dialogue: 0,0:40:22.25,0:40:24.42,Default,,0,0,0,,…өйткені ол ит алғысы келетінін айта бастады
Dialogue: 0,0:40:26.09,0:40:29.71,Default,,0,0,0,,Каэде! Каэде! Каэде!
Dialogue: 0,0:40:29.80,0:40:30.88,Default,,0,0,0,,(Анджудың таңданған дауысы)
Dialogue: 0,0:40:32.17,0:40:32.76,Default,,0,0,0,,Ана?
Dialogue: 0,0:40:33.34,0:40:34.76,Default,,0,0,0,,Котецу?
Dialogue: 0,0:40:34.84,0:40:37.72,Default,,0,0,0,,Мм... Каэде... Каэде мұнда жоқ!
Dialogue: 0,0:40:37.81,0:40:38.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:40:38.89,0:40:40.98,Default,,0,0,0,,Мен бұл баланың... қашуға тым кеш болғанына сенімдімін...
Dialogue: 0,0:40:41.06,0:40:42.23,Default,,0,0,0,,(демілеу)
Dialogue: 0,0:40:42.31,0:40:44.44,Default,,0,0,0,,Жарайды, мен бұл туралы бірдеңе істеймін!
Dialogue: 0,0:40:44.52,0:40:45.65,Default,,0,0,0,,Мама сыртта!
Dialogue: 0,0:40:53.20,0:40:55.74,Default,,0,0,0,,(екпінді дауыс)
Dialogue: 0,0:40:56.57,0:40:58.70,Default,,0,0,0,,(Адамдардың дүрбелең дауысы)
Dialogue: 0,0:40:58.78,0:40:59.37,Default,,0,0,0,,Әй?
Dialogue: 0,0:41:01.62,0:41:04.37,Default,,0,0,0,,(Шернеуді арттыратын музыка)
Dialogue: 0,0:41:26.02,0:41:28.69,Default,,0,0,0,,(жарқырау дыбысы)
Dialogue: 0,0:41:30.15,0:41:33.15,Default,,0,0,0,,(Қоқыстар құлаған сияқты)
Dialogue: 0,0:41:36.78,0:41:37.95,Default,,0,0,0,,Каэде…
Dialogue: 0,0:41:42.58,0:41:44.62,Default,,0,0,0,,Үйде болуға әлі де ерте емес пе?
Dialogue: 0,0:41:44.71,0:41:45.62,Default,,0,0,0,,Иә! иә?
Dialogue: 0,0:41:47.17,0:41:48.71,Default,,0,0,0,,(нәзік музыка)
Dialogue: 0,0:41:48.79,0:41:50.59,Default,,0,0,0,,Келіңіздер! Тез қаш
Dialogue: 0,0:41:50.67,0:41:51.88,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:41:57.18,0:41:58.47,Default,,0,0,0,,Рақмет.
Dialogue: 0,0:41:58.55,0:41:59.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:42:00.26,0:42:03.06,Default,,0,0,0,,Рахмет дегеніңіздің мағынасын түсінбедім.
Dialogue: 0,0:42:03.14,0:42:04.56,Default,,0,0,0,,... (Арыстанның ақыруы)
Dialogue: 0,0:42:04.64,0:42:07.73,Default,,0,0,0,,Көмектесіңіз! Маған көмектесші!
Dialogue: 0,0:42:07.81,0:42:10.06,Default,,0,0,0,,Шыу!
Dialogue: 0,0:42:11.82,0:42:12.57,Default,,0,0,0,,Абуне…
Dialogue: 0,0:42:13.44,0:42:14.65,Default,,0,0,0,,Маған кедергі жасама
Dialogue: 0,0:42:14.74,0:42:16.74,Default,,0,0,0,,Неге бұлай істеп жатырсың?
Dialogue: 0,0:42:16.82,0:42:19.07,Default,,0,0,0,,Мен туралы... Мен сені топтан қалдырамын.
Dialogue: 0,0:42:19.16,0:42:19.95,Default,,0,0,0,,Жауапсыз адам?
Dialogue: 0,0:42:20.53,0:42:21.49,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:42:21.58,0:42:24.20,Default,,0,0,0,,Мені «жеккөрінішті» деп атап, менсінбе!
Dialogue: 0,0:42:24.95,0:42:28.12,Default,,0,0,0,,Өйткені бұл жігіт қуыршақтарды жылжытады...
Dialogue: 0,0:42:30.17,0:42:33.75,Default,,0,0,0,,КЕЛЕСІ деп айтасың, бірақ адам емессің!
Dialogue: 0,0:42:33.84,0:42:35.46,Default,,0,0,0,,Жиренішті сезіну табиғи нәрсе!
Dialogue: 0,0:42:35.55,0:42:38.47,Default,,0,0,0,,Маған ұнағандықтан мен де өз күштерімді ала алмадым!
Dialogue: 0,0:42:39.13,0:42:41.80,Default,,0,0,0,,(Арыстанның айқайы)
Dialogue: 0,0:42:43.89,0:42:45.52,Default,,0,0,0,,Сенің сезіміңді түсінемін.
Dialogue: 0,0:42:45.60,0:42:46.43,Default,,0,0,0,,Мынаны есте сақта: негізінен, демонның күші ол жеген адамдар санына байланысты анықталады.
Dialogue: 0,0:42:46.52,0:42:47.89,Default,,0,0,0,,Өтірік емес
Dialogue: 0,0:42:48.69,0:42:50.44,Default,,0,0,0,,Мен сізбен бір жастамын
Dialogue: 0,0:42:50.52,0:42:52.19,Default,,0,0,0,,Ол КЕЛЕСІ болды
Dialogue: 0,0:42:52.27,0:42:53.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:42:55.53,0:42:59.53,Default,,0,0,0,,Сол сияқты менің достарым да бұл қорқынышты деп ойлады.
Dialogue: 0,0:42:59.61,0:43:02.03,Default,,0,0,0,,Мен де мұндай күшті қаламадым.
Dialogue: 0,0:43:02.12,0:43:03.20,Default,,0,0,0,,Мен күнде жыладым
Dialogue: 0,0:43:04.12,0:43:07.12,Default,,0,0,0,,Бірақ бір күні Аңыз дейтін батыр
Dialogue: 0,0:43:07.20,0:43:08.71,Default,,0,0,0,,Ол маған айтты
Dialogue: 0,0:43:09.75,0:43:12.46,Default,,0,0,0,,«Бұл күш адамдарға көмектесуге арналған».
Dialogue: 0,0:43:13.92,0:43:15.55,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:43:15.63,0:43:16.80,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:43:16.88,0:43:20.68,Default,,0,0,0,,Өйткені менің күшім батырдың күшіндей салқын емес.
Dialogue: 0,0:43:20.76,0:43:25.06,Default,,0,0,0,,Жарайды! Сол күштің пайдалы болатын кезі келетіні сөзсіз.
Dialogue: 0,0:43:25.64,0:43:26.31,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:43:26.97,0:43:28.35,Default,,0,0,0,,Мен уәде беремін
Dialogue: 0,0:43:28.43,0:43:29.39,Default,,0,0,0,,Косэй?
Dialogue: 0,0:43:29.48,0:43:33.56,Default,,0,0,0,,Аа, ендеше бәрінен кешірім сұрап, полицияға бар.
Dialogue: 0,0:43:33.65,0:43:37.11,Default,,0,0,0,,Не айтып тұрсың! Егер сіз оны ұстамасаңыз, сіз ұпай аласыз.
Dialogue: 0,0:43:37.19,0:43:38.90,Default,,0,0,0,,Міне, осындай бір теория бар:
Dialogue: 0,0:43:39.90,0:43:42.87,Default,,0,0,0,,Бүгіннен бастап сіз бұл күшті жақсылыққа пайдаланасыз, солай ма?
Dialogue: 0,0:43:42.95,0:43:45.20,Default,,0,0,0,,Содан кейін сол жерден түсіңіз.
Dialogue: 0,0:43:50.66,0:43:52.50,Default,,0,0,0,,(Мұңды музыка)
Dialogue: 0,0:43:57.30,0:43:58.42,Default,,0,0,0,,Иә
Dialogue: 0,0:44:04.35,0:44:05.39,Default,,0,0,0,,(Әйелдің айқайы)
Dialogue: 0,0:44:05.47,0:44:06.47,Default,,0,0,0,,Қауіпті!
Dialogue: 0,0:44:06.56,0:44:09.48,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:44:10.02,0:44:10.89,Default,,0,0,0,,Ой!
Dialogue: 0,0:44:11.98,0:44:13.90,Default,,0,0,0,,(Шұғылдық сезімі бар музыка)
Dialogue: 0,0:44:18.78,0:44:20.03,Default,,0,0,0,,(Дауыс құлағалы жатыр)
Dialogue: 0,0:44:22.74,0:44:23.91,Default,,0,0,0,,​​Маған көмектес!
Dialogue: 0,0:44:26.20,0:44:27.58,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,0:44:28.33,0:44:31.08,Default,,0,0,0,,Сіз өз қабілеттеріңізді әлі пайдалана алмайсыз.
Dialogue: 0,0:44:31.91,0:44:33.62,Default,,0,0,0,,Бізге қайтып оралатын уақыт келді!
Dialogue: 0,0:44:36.79,0:44:38.21,Default,,0,0,0,,Рахмет! Және рахмет
Dialogue: 0,0:44:38.30,0:44:38.96,Default,,0,0,0,,Бұл қорқынышты…
Dialogue: 0,0:44:39.55,0:44:40.59,Default,,0,0,0,,біздің қамқорлығымызға Джудзцу техникалық колледжінде алынады.
Dialogue: 0,0:44:40.67,0:44:42.63,Default,,0,0,0,,Уақыт таусылды.
Dialogue: 0,0:44:42.72,0:44:44.43,Default,,0,0,0,,Қабілет... мерзімі бітеді...
Dialogue: 0,0:44:44.51,0:44:45.93,Default,,0,0,0,,Егер бұлай болса, мен сізге қолдау көрсете алмаймын!
Dialogue: 0,0:44:46.01,0:44:49.72,Default,,0,0,0,,Эй Тони, маған көмектесші!
Dialogue: 0,0:44:49.81,0:44:51.68,Default,,0,0,0,,(Адамдардың қашып бара жатқан дыбыстары)
Dialogue: 0,0:44:51.77,0:44:55.19,Default,,0,0,0,,Бұлай жалғаса берсе, барлығына қауіп төнеді! Өтінемін маған көмектесіңіз!
Dialogue: 0,0:44:55.98,0:44:57.11,Default,,0,0,0,,Ол L-дің атын білген бойда мен тергеу штабын түгел жоямын.
Dialogue: 0,0:44:57.19,0:44:59.69,Default,,0,0,0,,Сіз мұны істей аласыз! Сіз міндетті түрде жасай аласыз!
Dialogue: 0,0:45:01.36,0:45:05.28,Default,,0,0,0,,Бар болғаны 5 секунд қалды! 5… 4… 3…
Dialogue: 0,0:45:14.67,0:45:18.54,Default,,0,0,0,,О, бұл қиын! Сен не істеп жатырсың?
Dialogue: 0,0:45:19.13,0:45:21.17,Default,,0,0,0,,Мен жай ғана сіздің жағдайыңызға қарап тұрмын.
Dialogue: 0,0:45:21.26,0:45:23.72,Default,,0,0,0,,Жоқ! Жаман мінез!
Dialogue: 0,0:45:26.51,0:45:27.43,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:45:36.94,0:45:38.15,Default,,0,0,0,,(нәзік музыка)
Dialogue: 0,0:45:41.02,0:45:42.94,Default,,0,0,0,,Рахмет, рахмет
Dialogue: 0,0:45:43.03,0:45:44.95,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:45:45.03,0:45:46.66,Default,,0,0,0,,(Адамдар қолдайды)
Dialogue: 0,0:45:46.74,0:45:48.16,Default,,0,0,0,,Керемет!
Dialogue: 0,0:45:50.74,0:45:53.95,Default,,0,0,0,,Тони, мен сенің арқаңда құтқарылдым.
Dialogue: 0,0:45:54.04,0:45:56.75,Default,,0,0,0,,Сіз енді батырлардың бірісіз.
Dialogue: 0,0:45:57.29,0:45:58.17,Default,,0,0,0,,Батыр…
Dialogue: 0,0:46:12.06,0:46:12.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:46:12.77,0:46:15.14,Default,,0,0,0,,Сізде әлі де біраз қабілет бар, солай ма?
Dialogue: 0,0:46:15.23,0:46:19.73,Default,,0,0,0,,Иә? Бұл біртүрлі...
Dialogue: 0,0:46:20.36,0:46:21.23,Default,,0,0,0,,Фу…
Dialogue: 0,0:46:21.73,0:46:23.98,Default,,0,0,0,,Хаха...
Dialogue: 0,0:46:24.07,0:46:25.65,Default,,0,0,0,,А...?
Dialogue: 0,0:46:25.74,0:46:28.57,Default,,0,0,0,,Жүр, үйге қайтайық, Каэде.
Dialogue: 0,0:46:28.66,0:46:31.16,Default,,0,0,0,,Иә, әже
Dialogue: 0,0:46:31.24,0:46:33.66,Default,,0,0,0,,Сіздің қауіпсіз болғаныңызға қуаныштымын.
Dialogue: 0,0:46:36.00,0:46:37.66,Default,,0,0,0,,(нәзік музыка)
Dialogue: 0,0:46:48.30,0:46:52.55,Default,,0,0,0,,Мен айттым ғой, солай ма? Сен Барнабидің екіншісісің.
Dialogue: 0,0:46:52.64,0:46:55.64,Default,,0,0,0,,Мен мұны білемін.
Dialogue: 0,0:46:55.72,0:46:56.98,Default,,0,0,0,,Дене өздігінен қозғалады
Dialogue: 0,0:46:57.06,0:46:58.10,Default,,0,0,0,,Мен бұған сене алмаймын
Dialogue: 0,0:46:58.94,0:47:00.85,Default,,0,0,0,,Барнабиді артта қалдыруға қалай дәтің бар?
Dialogue: 0,0:47:01.86,0:47:03.07,Default,,0,0,0,,Яғни
Dialogue: 0,0:47:03.15,0:47:05.78,Default,,0,0,0,,Ол өзінің қабілетін іске қосқысы келмейтінін айта бастайды.
Dialogue: 0,0:47:05.86,0:47:08.65,Default,,0,0,0,,Олай болса, оны іске қосыңыз!
Dialogue: 0,0:47:08.74,0:47:09.53,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:47:09.61,0:47:13.37,Default,,0,0,0,,Батыр ретінде тәжірибесі аз болғандықтан, оны қолдау сіздің міндетіңіз!
Dialogue: 0,0:47:13.45,0:47:14.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:47:15.45,0:47:19.16,Default,,0,0,0,,Сені ақылмен қолдайтын ағаң емес пе?
Dialogue: 0,0:47:19.79,0:47:20.67,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:47:20.75,0:47:23.17,Default,,0,0,0,,Мұны күтуге болмайды.
Dialogue: 0,0:47:23.25,0:47:25.17,Default,,0,0,0,,Мені жұмысқа алудың мәні жоқ.
Dialogue: 0,0:47:25.25,0:47:29.01,Default,,0,0,0,,Сендей тәжірибе мені батыр ететін жалғыз нәрсе.
Dialogue: 0,0:47:30.76,0:47:33.05,Default,,0,0,0,,Көбірек ойланыңыз
Dialogue: 0,0:47:33.14,0:47:36.39,Default,,0,0,0,,Барнаби ыңғайлы жұмыс істей алатындай жағдай жасау...
Dialogue: 0,0:47:37.14,0:47:37.93,Default,,0,0,0,,бұл бұлыңғыр кадрлардан оны анықтау қиын болар еді.
Dialogue: 0,0:47:38.02,0:47:39.31,Default,,0,0,0,,Не? Иә...
Dialogue: 0,0:47:39.39,0:47:40.81,Default,,0,0,0,,Иә...
Dialogue: 0,0:47:41.94,0:47:44.31,Default,,0,0,0,,Мен ол жігітпен енді серіктес бола алмаймын.
Dialogue: 0,0:47:44.40,0:47:45.40,Default,,0,0,0,,«Әділет, күш, еркіндік»
Dialogue: 0,0:47:45.40,0:47:46.86,Default,,0,0,0,,«Әділет, күш, еркіндік»
Dialogue: 0,0:47:45.40,0:47:46.86,Default,,0,0,0,,Сондай тәтті адам...
Dialogue: 0,0:47:46.86,0:47:46.94,Default,,0,0,0,,«Әділет, күш, еркіндік»
Dialogue: 0,0:47:46.94,0:47:48.40,Default,,0,0,0,,«Әділет, күш, еркіндік»
Dialogue: 0,0:47:46.94,0:47:48.40,Default,,0,0,0,,Бұл тек бастамасы ғана
Dialogue: 0,0:47:48.40,0:47:48.99,Default,,0,0,0,,Бұл тек бастамасы ғана
Dialogue: 0,0:47:49.07,0:47:49.82,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:47:50.40,0:47:52.36,Default,,0,0,0,,Бұл батырлардың алғашқы комбинациясы.
Dialogue: 0,0:47:52.45,0:47:55.08,Default,,0,0,0,,Сізге көп назар аударылатынына сенімдімін.
Dialogue: 0,0:47:55.16,0:47:56.83,Default,,0,0,0,,Бұл сіздің атыңызды сату мүмкіндігі.
Dialogue: 0,0:47:57.70,0:47:59.87,Default,,0,0,0,,Егер сіз бұл мүмкіндікті пайдаланбасаңыз
Dialogue: 0,0:47:59.96,0:48:03.92,Default,,0,0,0,,Шын аты-жөніңізді жариялауға батылы баруыңыздың қажеті жоқ.
Dialogue: 0,0:48:04.00,0:48:05.21,Default,,0,0,0,,Оны қалай тоқтатамыз?
Dialogue: 0,0:48:06.17,0:48:07.17,Default,,0,0,0,,Иә
Dialogue: 0,0:48:08.17,0:48:10.80,Default,,0,0,0,,Сіз қуып бара жатқан белгінің артындағы шындық
Dialogue: 0,0:48:10.88,0:48:12.59,Default,,0,0,0,,Белсенді рөліңіз бойынша
Dialogue: 0,0:48:12.68,0:48:15.76,Default,,0,0,0,,Мүмкін бұл сізге оны анықтауға мүмкіндік берер ме?
Dialogue: 0,0:48:15.85,0:48:17.60,Default,,0,0,0,,(Фортепианоның қайғылы музыкасы)
Dialogue: 0,0:48:24.69,0:48:27.69,Default,,0,0,0,,(әйел дауысы жоғары деңгейде ән айтады)
Dialogue: 0,0:48:46.84,0:48:48.55,Default,,0,0,0,,Өзіңіз жайлы болыңыз
Dialogue: 0,0:48:49.13,0:48:51.67,Default,,0,0,0,,Бір күні ата-анам маған жау боларына сенімдімін...
Dialogue: 0,0:48:58.35,0:49:00.97,Default,,0,0,0,,«Аполлон IC»
Dialogue: 0,0:49:05.65,0:49:08.57,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:49:08.65,0:49:10.57,Default,,0,0,0,,«Котецу Т.Кабураги»
Dialogue: 0,0:49:16.28,0:49:18.37,Default,,0,0,0,,Сәлем! Оны елемеңіз
Dialogue: 0,0:49:21.33,0:49:23.54,Default,,0,0,0,,Уақытты қажет ететін ештеңе жасамаңыз.
Dialogue: 0,0:49:24.92,0:49:26.67,Default,,0,0,0,,…Таку!
Dialogue: 0,0:49:26.75,0:49:29.92,Default,,0,0,0,,Қоян әдеттегідей сүйкімді емес.
Dialogue: 0,0:49:30.00,0:49:31.92,Default,,0,0,0,,Сонымен! Оны қалай атауға болады...
Dialogue: 0,0:49:32.01,0:49:34.30,Default,,0,0,0,,Тыңдаңыз және қуаныңыз! Негізі, қазірден бастап...
Dialogue: 0,0:49:34.38,0:49:35.43,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:49:35.51,0:49:37.39,Default,,0,0,0,,Эй... тыңда!
Dialogue: 0,0:49:37.47,0:49:39.10,Default,,0,0,0,,Енді бірге тамақтанайық...
Dialogue: 0,0:49:39.18,0:49:41.89,Default,,0,0,0,,Мен бәрібір солай деп ойладым.
Dialogue: 0,0:49:41.97,0:49:43.48,Default,,0,0,0,,Менің бір ісім бар.
Dialogue: 0,0:49:43.56,0:49:45.19,Default,,0,0,0,,Жоқ, біраз уақыт кетті...
Dialogue: 0,0:49:45.27,0:49:46.19,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:49:46.27,0:49:48.31,Default,,0,0,0,,Барлығы жиналып қалды!
Dialogue: 0,0:49:49.40,0:49:50.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:49:51.27,0:49:54.78,Default,,0,0,0,,(жеңіл музыка)
Dialogue: 0,0:49:54.86,0:49:56.07,Default,,0,0,0,,(От-шағал жәндігінің дыбысы)
Dialogue: 0,0:49:56.15,0:49:58.62,Default,,0,0,0,,Ал, сіз қалай ойлайсыз? менің денем
Dialogue: 0,0:49:58.70,0:50:02.12,Default,,0,0,0,,Керемет! Бұл келесідей болады
Dialogue: 0,0:50:02.20,0:50:04.66,Default,,0,0,0,,Мен сені тек батырдың киімінде көрдім.
Dialogue: 0,0:50:04.75,0:50:08.21,Default,,0,0,0,,Дұрыс! Эй, сен мені ұра аласың! Эй, эй!
Dialogue: 0,0:50:08.29,0:50:11.21,Default,,0,0,0,,Жоқ! Бұл ауыр көрінеді
Dialogue: 0,0:50:11.29,0:50:12.71,Default,,0,0,0,,Ұстамаңыз! Қараңыз
Dialogue: 0,0:50:12.80,0:50:13.84,Default,,0,0,0,,Жеңіл
Dialogue: 0,0:50:13.92,0:50:14.51,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:50:15.34,0:50:17.38,Default,,0,0,0,,Неліктен бұл жаңа ойыншының құттықтау кеші?
Dialogue: 0,0:50:17.47,0:50:19.26,Default,,0,0,0,,Неліктен біз қиындықтан өтуіміз керек?
Dialogue: 0,0:50:19.34,0:50:20.64,Default,,0,0,0,,Бізден басқа барлығы Сакурадзима-сенпайды ұмытып қалған болар.
Dialogue: 0,0:50:22.22,0:50:26.60,Default,,0,0,0,,Салқын қимыл жасасаңыз да: «Мен үлкендермен тіл табысқым келеді» дейсіз.
Dialogue: 0,0:50:26.69,0:50:30.27,Default,,0,0,0,,Бұл әдемі адам жұмбақ және тартымды.
Dialogue: 0,0:50:31.06,0:50:32.44,Default,,0,0,0,,Жұмбақ...
Dialogue: 0,0:50:33.03,0:50:36.24,Default,,0,0,0,,Негізі мен ол туралы білемін.
Dialogue: 0,0:50:36.32,0:50:39.57,Default,,0,0,0,,Мен оқыған батырлар академиясында.
Dialogue: 0,0:50:39.66,0:50:41.99,Default,,0,0,0,,Ол көптің назарын аударды.
Dialogue: 0,0:50:42.62,0:50:45.08,Default,,0,0,0,,Маған ұқсамайтын жаман болды.
Dialogue: 0,0:50:45.16,0:50:49.33,Default,,0,0,0,,Мектепте оның қаншалықты дарынды екенін білмейтін адам болған жоқ.
Dialogue: 0,0:50:51.46,0:50:52.88,Default,,0,0,0,,Дегенмен, бұл менмін!
Dialogue: 0,0:50:52.96,0:50:55.34,Default,,0,0,0,,Мен мұндай нәрсеге бірінші рет шақырылып отырмын!
Dialogue: 0,0:50:55.42,0:50:56.97,Default,,0,0,0,,Мен қобалжыдым.
Dialogue: 0,0:50:57.72,0:51:00.05,Default,,0,0,0,,Уайымдамаңыз, біз де солай істейміз⸺
Dialogue: 0,0:51:00.14,0:51:02.14,Default,,0,0,0,,Біз бірінші рет оңаша кездесіп тұрмыз.
Dialogue: 0,0:51:02.22,0:51:03.72,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:51:03.81,0:51:06.77,Default,,0,0,0,,Сондықтан бүгінгі күн шынымен жақсы мүмкіндік деп ойлаймын.
Dialogue: 0,0:51:07.39,0:51:08.98,Default,,0,0,0,,Бәріміз көңіл көтерейік!
Dialogue: 0,0:51:09.06,0:51:11.02,Default,,0,0,0,,Ал ләззат алайық!
Dialogue: 0,0:51:11.61,0:51:12.81,Default,,0,0,0,,(Нисимура) Цубасаның кеудесі өте үлкен, сондықтан ол жүгіргенде әр жаққа секіріп тұрады.
Dialogue: 0,0:51:12.90,0:51:15.28,Default,,0,0,0,,Батырлар патшасы айтса...
Dialogue: 0,0:51:15.36,0:51:16.86,Default,,0,0,0,,Мен түсіндім, бірақ...
Dialogue: 0,0:51:16.94,0:51:18.95,Default,,0,0,0,,жаман жаман
Dialogue: 0,0:51:19.03,0:51:20.91,Default,,0,0,0,,Сіз кешігіп қалдыңыз, Котецу!
Dialogue: 0,0:51:20.99,0:51:22.91,Default,,0,0,0,,Балалар мен сендермен кездесемін, ендеше киініңдер.
Dialogue: 0,0:51:22.99,0:51:25.45,Default,,0,0,0,,Мұны істеудің қажеті жоқ, солай ма?
Dialogue: 0,0:51:25.54,0:51:27.29,Default,,0,0,0,,Басты кейіпкер – Барнаби.
Dialogue: 0,0:51:27.37,0:51:29.00,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:51:29.71,0:51:33.50,Default,,0,0,0,,Уайлд мырза, өзімізді тағы таныстырсақ қалай болады?
Dialogue: 0,0:51:34.09,0:51:35.42,Default,,0,0,0,,О, дұрыс.
Dialogue: 0,0:51:35.50,0:51:38.38,Default,,0,0,0,,Олай болса, сәлем! Менен
Dialogue: 0,0:51:38.47,0:51:39.55,Default,,0,0,0,,Иә! (Шапалақтау дыбысы)
Dialogue: 0,0:51:39.63,0:51:44.05,Default,,0,0,0,,Қайырлы кеш, сұлу. Мен өрт белгісімін.
Dialogue: 0,0:51:44.14,0:51:46.10,Default,,0,0,0,,Шын аты - Натан Сеймур
Dialogue: 0,0:51:46.18,0:51:48.81,Default,,0,0,0,,Мынадай көрінсе де, Helios Energy...
Dialogue: 0,0:51:48.89,0:51:50.81,Default,,0,0,0,,Сіз иесісіз, солай ма?
Dialogue: 0,0:51:51.39,0:51:53.19,Default,,0,0,0,,Айтпасаң да білемін
Dialogue: 0,0:51:53.27,0:51:55.07,Default,,0,0,0,,(Иура) Жарайды, жарайды. (Мотоко) Оны қолыңмен тиме.
Dialogue: 0,0:51:55.15,0:51:57.11,Default,,0,0,0,,Үздік студент күткендей!
Dialogue: 0,0:51:57.19,0:51:59.36,Default,,0,0,0,,Сіздің дұрыс тергеу жүргізгеніңіз өте жақсы.
Dialogue: 0,0:51:59.44,0:52:00.45,Default,,0,0,0,,Келесіні қараңыз! Келесі!
Dialogue: 0,0:52:00.53,0:52:01.45,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:52:02.03,0:52:03.16,Default,,0,0,0,,Жетеді.
Dialogue: 0,0:52:03.24,0:52:04.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:52:04.16,0:52:06.41,Default,,0,0,0,,Мен де сені зерттедім.
Dialogue: 0,0:52:06.49,0:52:07.95,Default,,0,0,0,,А, иә...
Dialogue: 0,0:52:08.04,0:52:09.96,Default,,0,0,0,,(сөздерді жоғалтқан дауыс)
Dialogue: 0,0:52:11.50,0:52:13.92,Default,,0,0,0,,Сәлем! Бұл жігіт өзін нашар сезінеді.
Dialogue: 0,0:52:14.00,0:52:16.50,Default,,0,0,0,,Жоқ, сіз жай ғана ебедейсіз.
Dialogue: 0,0:52:16.59,0:52:20.09,Default,,0,0,0,,Қызық, сіз өзіңіздің таңдаған ағаңыздың алдында тұрсыз ба?
Dialogue: 0,0:52:20.17,0:52:21.22,Default,,0,0,0,,Онда мен үйге барамын.
Dialogue: 0,0:52:21.30,0:52:21.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:52:22.05,0:52:25.22,Default,,0,0,0,,Өйткені, бұлай уақыт өткізудің қажеті жоқ.
Dialogue: 0,0:52:25.30,0:52:26.72,Default,,0,0,0,,Вегетариандық деген нәрсе бар емес пе?
Dialogue: 0,0:52:26.81,0:52:28.22,Default,,0,0,0,,Сабыр етіңіз.
Dialogue: 0,0:52:29.47,0:52:31.35,Default,,0,0,0,,Бұрын не болды? сол көзқарас
Dialogue: 0,0:52:31.94,0:52:33.81,Default,,0,0,0,,Себебі сіз тіл табысқым келеді дейсіз.
Dialogue: 0,0:52:33.90,0:52:35.19,Default,,0,0,0,,Мен осында жиналып жатырмын.
Dialogue: 0,0:52:35.27,0:52:38.15,Default,,0,0,0,,ше? Мен олай айтқан жоқпын.
Dialogue: 0,0:52:38.73,0:52:40.28,Default,,0,0,0,,Сіз, солай ма?
Dialogue: 0,0:52:40.36,0:52:42.82,Default,,0,0,0,,Менімен дос болғың келетінін саған кім айтты?
Dialogue: 0,0:52:42.90,0:52:43.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:52:43.86,0:52:46.16,Default,,0,0,0,,Сіз нені айтасыз? Уайлд мырза
Dialogue: 0,0:52:46.24,0:52:49.74,Default,,0,0,0,,Әй, Әдемі менімен кездескісі келеді дедім ғой.
Dialogue: 0,0:52:50.33,0:52:52.62,Default,,0,0,0,,Менде барлығы бар.
Dialogue: 0,0:52:52.71,0:52:54.79,Default,,0,0,0,,Мен де қобалжып барамын.
Dialogue: 0,0:52:54.88,0:52:56.88,Default,,0,0,0,,Котецу! (Котецу) Ал...
Dialogue: 0,0:52:56.96,0:53:00.67,Default,,0,0,0,,Мен барлығымен жақынырақ таныссам, қоянға жұмыс істеу оңайырақ болады деп ойладым.
Dialogue: 0,0:53:00.76,0:53:03.18,Default,,0,0,0,,Сонда сен өтірік айттың ба?
Dialogue: 0,0:53:03.26,0:53:04.01,Default,,0,0,0,,Жақсы
Dialogue: 0,0:53:04.09,0:53:05.18,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:53:05.26,0:53:06.22,Default,,0,0,0,,Ең нашар!
Dialogue: 0,0:53:06.30,0:53:07.80,Default,,0,0,0,,Қайта оралдын.
Dialogue: 0,0:53:07.89,0:53:10.93,Default,,0,0,0,,Мен сенің не айтып тұрғаныңды мүлдем түсінбеймін. Ол нені білдіреді?
Dialogue: 0,0:53:11.02,0:53:12.73,Default,,0,0,0,,Мен кейінірек түсіндіремін.
Dialogue: 0,0:53:13.31,0:53:17.73,Default,,0,0,0,,Бірақ... мұны бәріміз тіл табысу мүмкіндігі ретінде пайдалансақ жақсы емес пе?
Dialogue: 0,0:53:17.81,0:53:20.15,Default,,0,0,0,,Сіз жақсы араласасыз ба? Сен ақымақ емессің бе?
Dialogue: 0,0:53:20.73,0:53:22.15,Default,,0,0,0,,Біз қарсыласпыз
Dialogue: 0,0:53:22.24,0:53:23.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:53:24.15,0:53:26.36,Default,,0,0,0,,Демек, бұл менмін
Dialogue: 0,0:53:27.99,0:53:29.87,Default,,0,0,0,,Сәлем! қоян!
Dialogue: 0,0:53:29.95,0:53:32.91,Default,,0,0,0,,А, мен бір нәрсені бүлдіріп алдым.
Dialogue: 0,0:53:33.00,0:53:35.00,Default,,0,0,0,,Үйге бару (Котецу) Иә?
Dialogue: 0,0:53:35.08,0:53:36.58,Default,,0,0,0,,Хмф!
Dialogue: 0,0:53:36.67,0:53:38.92,Default,,0,0,0,,(Антонио ырылдап)
Dialogue: 0,0:53:39.00,0:53:40.46,Default,,0,0,0,,Шүрікеңді мен де бағып жүрмін...
Dialogue: 0,0:53:40.55,0:53:42.42,Default,,0,0,0,,Содан кейін мен Джонмен жүремін
Dialogue: 0,0:53:42.51,0:53:43.97,Default,,0,0,0,,Жоқ, сәл күте тұрыңыз...
Dialogue: 0,0:53:44.05,0:53:45.01,Default,,0,0,0,,Бұл! ?
Dialogue: 0,0:53:45.09,0:53:46.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:53:47.80,0:53:49.55,Default,,0,0,0,,Бонжур батыры
Dialogue: 0,0:53:49.64,0:53:51.68,Default,,0,0,0,,Штернмедайль аймағында ауыр оқиға орын алды.
Dialogue: 0,0:53:51.77,0:53:54.85,Default,,0,0,0,,Тонаудың нарықтық құны жүздеген миллион Стерн доллары немесе одан да көп...
Dialogue: 0,0:53:54.94,0:53:56.56,Default,,0,0,0,,Қалай болғанда да, дереу сол жаққа барыңыз!
Dialogue: 0,0:53:56.65,0:53:59.31,Default,,0,0,0,,(мазасыз музыка)
Dialogue: 0,0:54:04.65,0:54:06.49,Default,,0,0,0,,Жоқ! Қараңғыда қорқынышты!
Dialogue: 0,0:54:06.57,0:54:07.82,Default,,0,0,0,,Уау! Оған тиме
Dialogue: 0,0:54:10.33,0:54:12.29,Default,,0,0,0,,Енді мен қорықпаймын
Dialogue: 0,0:54:12.37,0:54:14.45,Default,,0,0,0,,Мен сенен қорқамын! Алға барайық!
Dialogue: 0,0:54:14.54,0:54:15.87,Default,,0,0,0,,Мен бүкіл әлемді араладым.
Dialogue: 0,0:54:19.25,0:54:20.38,Default,,0,0,0,,Тасымалдаушы
Dialogue: 0,0:54:20.46,0:54:23.13,Default,,0,0,0,,Тоғызыншы авеню Оңтүстік саябағы, өтінемін.
Dialogue: 0,0:54:36.85,0:54:38.27,Default,,0,0,0,,(От-шағал жәндігінің дыбысы)
Dialogue: 0,0:54:38.77,0:54:41.90,Default,,0,0,0,,Таусам, Бақытты құлаққа айналар ма екен.
Dialogue: 0,0:54:41.98,0:54:44.48,Default,,0,0,0,,Иә... байқап көргіңіз келе ме?
Dialogue: 0,0:54:44.57,0:54:45.69,Default,,0,0,0,,Жақсы, жақсы, жақсы...!
Dialogue: 0,0:54:45.78,0:54:48.78,Default,,0,0,0,,(Шернеуді арттыратын музыка)
Dialogue: 0,0:54:52.78,0:54:55.62,Default,,0,0,0,,Мм... неге жүгіресің?
Dialogue: 0,0:54:55.70,0:54:57.58,Default,,0,0,0,,Бұл жүруден жылдамырақ.
Dialogue: 0,0:54:58.50,0:55:00.08,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:55:00.17,0:55:02.84,Default,,0,0,0,,Желді басқара алсаң, бірден ұша алсаң ше...?
Dialogue: 0,0:55:02.92,0:55:04.09,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:55:04.17,0:55:05.88,Default,,0,0,0,,Ұшу жылдамдығына жету үшін
Dialogue: 0,0:55:05.96,0:55:08.55,Default,,0,0,0,,Реактивті пакет өте маңызды.
Dialogue: 0,0:55:05.96,0:55:08.55,Default,,0,0,0,,...
Dialogue: 0,0:55:08.55,0:55:09.47,Default,,0,0,0,,...
Dialogue: 0,0:55:09.55,0:55:11.47,Default,,0,0,0,,Сонда онсыз...
Dialogue: 0,0:55:11.55,0:55:14.68,Default,,0,0,0,,Иә! Тек жүзіңіз!
Dialogue: 0,0:55:14.76,0:55:16.18,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:55:16.27,0:55:17.85,Default,,0,0,0,,Жоғары аспан мырза! (Кит) Хахаха!
Dialogue: 0,0:55:19.39,0:55:24.90,Default,,0,0,0,,...Оқиғалар бүгінде бірінен соң бірі... О, жоқ!
Dialogue: 0,0:55:26.40,0:55:28.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:55:30.49,0:55:31.95,Default,,0,0,0,,(Тікұшақтың дыбысы)
Dialogue: 0,0:55:35.95,0:55:37.04,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:55:37.12,0:55:39.29,Default,,0,0,0,,Сәлем! қарыз! жеміс!
Dialogue: 0,0:55:44.63,0:55:46.55,Default,,0,0,0,,(көтермелейтін музыка)
Dialogue: 0,0:55:50.38,0:55:51.55,Default,,0,0,0,,Уф… Мұнда не болып жатыр өзі?
Dialogue: 0,0:56:01.14,0:56:02.06,Default,,0,0,0,,Иә!
Dialogue: 0,0:56:03.86,0:56:04.56,Default,,0,0,0,,Фу…
Dialogue: 0,0:56:06.32,0:56:07.57,Default,,0,0,0,,Ммм.
Dialogue: 0,0:56:10.03,0:56:10.90,Default,,0,0,0,,Көрінбейтін белгілері жоқ, біртіндеп өршіп бара жатқан ауру сияқты—
Dialogue: 0,0:56:14.62,0:56:15.49,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:56:18.95,0:56:19.70,Default,,0,0,0,,Сааа!
Dialogue: 0,0:56:22.87,0:56:24.54,Default,,0,0,0,,Иә!
Dialogue: 0,0:56:38.64,0:56:40.35,Default,,0,0,0,,Кінәлі әлі қашуда!
Dialogue: 0,0:56:40.43,0:56:43.31,Default,,0,0,0,,Осы Әділет мүсінін алыңыз.
Dialogue: 0,0:56:43.40,0:56:44.31,Default,,0,0,0,,Эй, бұл...
Dialogue: 0,0:56:44.90,0:56:47.11,Default,,0,0,0,,Иә, баяғыда Аңыз мырза
Dialogue: 0,0:56:47.19,0:56:49.57,Default,,0,0,0,,Қаскөйлерден қалпына келтірілген бейбітшілік символы
Dialogue: 0,0:56:47.19,0:56:49.57,Default,,0,0,0,,«Әділет мүсіні»
Dialogue: 0,0:56:50.15,0:56:53.95,Default,,0,0,0,,Оның ұрланғаны нені білдіретінін білесіз бе?
Dialogue: 0,0:56:54.70,0:56:58.20,Default,,0,0,0,,Халықтың батырларға деген сенімі жойылды.
Dialogue: 0,0:56:58.28,0:57:02.00,Default,,0,0,0,,Сондықтан оны міндетті түрде қайтарыңыз!
Dialogue: 0,0:57:10.46,0:57:14.30,Default,,0,0,0,,(ызылдаған дауыс)
Dialogue: 0,0:57:14.38,0:57:16.89,Default,,0,0,0,,(Шернеуді арттыратын музыка)
Dialogue: 0,0:57:16.97,0:57:19.06,Default,,0,0,0,,Хэхе!
Dialogue: 0,0:57:23.39,0:57:25.06,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:57:23.39,0:57:25.06,Default,,0,0,0,,«Стернбилт полициясы»
Dialogue: 0,0:57:25.15,0:57:27.23,Default,,0,0,0,,№
Dialogue: 0,0:57:28.02,0:57:29.36,Default,,0,0,0,,Ат!
Dialogue: 0,0:57:32.82,0:57:34.24,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:57:34.32,0:57:35.74,Default,,0,0,0,,Жооой!
Dialogue: 0,0:57:36.49,0:57:38.49,Default,,0,0,0,,Қылмыскер полициядан қашып кетті!
Dialogue: 0,0:57:39.24,0:57:41.87,Default,,0,0,0,,Батырдың әлі ешбір белгісі жоқ!
Dialogue: 0,0:57:42.45,0:57:44.66,Default,,0,0,0,,Қазірдің өзінде! Сен не істеп жатырсың?
Dialogue: 0,0:57:44.75,0:57:45.37,Default,,0,0,0,,Міне!
Dialogue: 0,0:57:47.42,0:57:48.67,Default,,0,0,0,,Ой!
Dialogue: 0,0:57:48.75,0:57:51.46,Default,,0,0,0,,Tiger & Barnaby жаңа дуэті осында!
Dialogue: 0,0:57:51.55,0:57:54.51,Default,,0,0,0,,Сіз оны үйлесімді ойын арқылы түсіре аласыз ба?
Dialogue: 0,0:57:59.22,0:58:00.47,Default,,0,0,0,,Уа! Мен көрдім
Dialogue: 0,0:58:01.60,0:58:03.60,Default,,0,0,0,,Қажетсіз ештеңе жасамаңыз.
Dialogue: 0,0:58:03.68,0:58:05.14,Default,,0,0,0,,Роджер!
Dialogue: 0,0:58:05.23,0:58:07.65,Default,,0,0,0,,Мені ұстаңыз! Ооо!
Dialogue: 0,0:58:09.73,0:58:11.36,Default,,0,0,0,,Бұл құрылыс баррикадасы.
Dialogue: 0,0:58:11.44,0:58:12.19,Default,,0,0,0,,Бөлек
Dialogue: 0,0:58:12.28,0:58:13.03,Default,,0,0,0,,Не?
Dialogue: 0,0:58:15.15,0:58:16.07,Default,,0,0,0,,Эй, эй!
Dialogue: 0,0:58:15.15,0:58:16.07,Default,,0,0,0,,«Қауіпті, тыйым салынған»
Dialogue: 0,0:58:17.41,0:58:19.03,Default,,0,0,0,,Уау!
Dialogue: 0,0:58:23.79,0:58:27.79,Default,,0,0,0,,Гах... бұл қауіпті! Ой...!
Dialogue: 0,0:58:33.80,0:58:35.09,Default,,0,0,0,,Мазасыздық!
Dialogue: 0,0:58:36.67,0:58:38.84,Default,,0,0,0,,Нашар! Ұпай!
Dialogue: 0,0:58:39.43,0:58:43.43,Default,,0,0,0,,(ызылдаған дауыс)
Dialogue: 0,0:58:43.52,0:58:46.18,Default,,0,0,0,,(Тездіргіш музыка)
Dialogue: 0,0:58:49.02,0:58:51.56,Default,,0,0,0,,Көк раушан Барнаби Брукс кіші.
Dialogue: 0,0:58:51.65,0:58:53.90,Default,,0,0,0,,Және жабайы жолбарыс
Dialogue: 0,0:58:53.98,0:58:57.32,Default,,0,0,0,,Кінәліге кім бірінші жетеді?
Dialogue: 0,0:59:00.62,0:59:02.03,Default,,0,0,0,,Балалар, сендерде көлік қуу немесе тағы бір нәрсе бар.
Dialogue: 0,0:59:02.12,0:59:03.91,Default,,0,0,0,,Қазір мұны жасайтын уақыт емес!
Dialogue: 0,0:59:07.21,0:59:08.92,Default,,0,0,0,,О...?
Dialogue: 0,0:59:09.83,0:59:10.79,Default,,0,0,0,,Ал әйелім ше? Әйелім мен ұлым? Екеуі де аман ба?
Dialogue: 0,0:59:16.17,0:59:17.26,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:59:17.97,0:59:20.26,Default,,0,0,0,,Уау! О?
Dialogue: 0,0:59:20.89,0:59:23.26,Default,,0,0,0,,О, құдай! Кінәлі еш жерде көрінбейді!
Dialogue: 0,0:59:23.93,0:59:26.35,Default,,0,0,0,,Қайда кетті?
Dialogue: 0,0:59:26.43,0:59:27.60,Default,,0,0,0,,Қап…
Dialogue: 0,0:59:27.68,0:59:29.64,Default,,0,0,0,,Мен оны сіздердің кесіріңізден жоғалтып алдым!
Dialogue: 0,0:59:29.73,0:59:32.15,Default,,0,0,0,,А... Сонымен?
Dialogue: 0,0:59:33.86,0:59:36.48,Default,,0,0,0,,Әже... мұнда неге келдің?
Dialogue: 0,0:59:37.57,0:59:39.78,Default,,0,0,0,,(Жақсы дауыс)
Dialogue: 0,0:59:39.86,0:59:42.87,Default,,0,0,0,,(Тездіргіш музыка)
Dialogue: 0,0:59:51.83,0:59:53.29,Default,,0,0,0,,Уайымдамаңыз! (2-ші жолаушы) Не?
Dialogue: 0,0:59:53.38,0:59:54.29,Default,,0,0,0,,Онда неге сол тікұшақ келді?
Dialogue: 0,0:59:54.38,0:59:55.38,Default,,0,0,0,,Әй, тұтынушы!
Dialogue: 0,0:59:56.59,0:59:57.88,Default,,0,0,0,,Бәрі жақсы, мен бұны істей аламын!
Dialogue: 0,0:59:58.46,1:00:01.30,Default,,0,0,0,,Мен ойын-сауық саябағына қашамын деп ешқашан ойламаппын.
Dialogue: 0,1:00:01.38,1:00:04.14,Default,,0,0,0,,Жарайды... Сіз маған оны қызықтырақ етуіңіз керек.
Dialogue: 0,1:00:06.22,1:00:07.56,Default,,0,0,0,,(арандатушы дауыс)
Dialogue: 0,1:00:07.64,1:00:09.93,Default,,0,0,0,,(Өтіп бара жатқан адамның таңғаларлық дауысы)
Dialogue: 0,1:00:10.02,1:00:11.19,Default,,0,0,0,,Бұл оңай-ақ болар, иә? Хех, хе-хех, хе
Dialogue: 0,1:00:16.23,1:00:17.32,Default,,0,0,0,,Хмм.
Dialogue: 0,1:00:19.74,1:00:20.36,Default,,0,0,0,,(Сора) Мен оны біршама болжаған едім, бірақ осыншалықты шектен тыс боларын ойламаппын.
Dialogue: 0,1:00:20.45,1:00:24.03,Default,,0,0,0,,Бізді тас бизон күтіп тұрды!
Dialogue: 0,1:00:24.12,1:00:25.83,Default,,0,0,0,,Мен ұпай жинадым!
Dialogue: 0,1:00:25.91,1:00:28.95,Default,,0,0,0,,Ах! Айдаһардың баласы да бар
Dialogue: 0,1:00:29.04,1:00:30.25,Default,,0,0,0,,Алға!
Dialogue: 0,1:00:30.33,1:00:32.37,Default,,0,0,0,,Сенің Ат арбаларыңның қозғалысы мен күші—
Dialogue: 0,1:00:33.33,1:00:35.13,Default,,0,0,0,,Хмм…
Dialogue: 0,1:00:35.21,1:00:36.25,Default,,0,0,0,,Сааа!
Dialogue: 0,1:00:42.55,1:00:44.34,Default,,0,0,0,,Қош бол!
Dialogue: 0,1:00:46.10,1:00:47.06,Default,,0,0,0,,Кешіріңіз... Ах!
Dialogue: 0,1:00:48.18,1:00:49.47,Default,,0,0,0,,Ах!
Dialogue: 0,1:00:53.77,1:00:54.48,Default,,0,0,0,,Иә?
Dialogue: 0,1:00:55.31,1:00:56.81,Default,,0,0,0,,(жарылыс сияқты естіледі)
Dialogue: 0,1:00:56.90,1:00:57.82,Default,,0,0,0,,Эх!
Dialogue: 0,1:00:57.90,1:01:00.23,Default,,0,0,0,,Ах! Бұл қауіпті!
Dialogue: 0,1:01:00.32,1:01:02.07,Default,,0,0,0,,Майки!
Dialogue: 0,1:01:04.28,1:01:05.62,Default,,0,0,0,,Жүр, асығыңыз!
Dialogue: 0,1:01:05.70,1:01:08.37,Default,,0,0,0,,Майки! Майки...
Dialogue: 0,1:01:10.16,1:01:11.75,Default,,0,0,0,,Мен оны тоқтаттым!
Dialogue: 0,1:01:11.83,1:01:13.79,Default,,0,0,0,,Бірақ бұл қалай болды?
Dialogue: 0,1:01:15.46,1:01:16.79,Default,,0,0,0,,Мен де, мен де~
Dialogue: 0,1:01:18.59,1:01:23.38,Default,,0,0,0,,Енді міне! Биік аспан!
Dialogue: 0,1:01:24.47,1:01:25.59,Default,,0,0,0,,Хмм.
Dialogue: 0,1:01:25.68,1:01:26.68,Default,,0,0,0,,Осы үш кадрды қайтадан қатар қойып көрсетіңізші.
Dialogue: 0,1:01:27.35,1:01:29.76,Default,,0,0,0,,Иә! Саусағыңызды көрсетпеңіз!
Dialogue: 0,1:01:30.68,1:01:31.60,Default,,0,0,0,,Мм...!
Dialogue: 0,1:01:31.68,1:01:34.52,Default,,0,0,0,,Аспан Сәлем!
Dialogue: 0,1:01:34.60,1:01:37.40,Default,,0,0,0,,Арх! ...Тоттотто!
Dialogue: 0,1:01:37.48,1:01:40.57,Default,,0,0,0,,(Шұғылдық сезімі бар музыка)
Dialogue: 0,1:01:40.65,1:01:41.98,Default,,0,0,0,,Олай болса!
Dialogue: 0,1:01:43.36,1:01:45.07,Default,,0,0,0,,Әй, бұл не?
Dialogue: 0,1:01:48.07,1:01:50.12,Default,,0,0,0,,Онда неге сол тікұшақ келді?
Dialogue: 0,1:01:52.95,1:01:54.96,Default,,0,0,0,,Йотто!
Dialogue: 0,1:01:55.50,1:01:56.62,Default,,0,0,0,,Хэхе!
Dialogue: 0,1:01:56.71,1:01:59.25,Default,,0,0,0,,Курурин Патто!
Dialogue: 0,1:02:00.21,1:02:01.63,Default,,0,0,0,,Иә!
Dialogue: 0,1:02:04.72,1:02:05.93,Default,,0,0,0,,Иә?
Dialogue: 0,1:02:10.60,1:02:11.64,Default,,0,0,0,,Сағынып қаласыз ба?
Dialogue: 0,1:02:12.47,1:02:14.14,Default,,0,0,0,,Сәлем! Сәлем!
Dialogue: 0,1:02:21.86,1:02:22.65,Default,,0,0,0,,(таңданған дауыс)
Dialogue: 0,1:02:22.73,1:02:23.28,Default,,0,0,0,,Жарайды!
Dialogue: 0,1:02:23.99,1:02:25.15,Default,,0,0,0,,Ура!
Dialogue: 0,1:02:25.24,1:02:27.32,Default,,0,0,0,,Батырлар патшасы күткендей!
Dialogue: 0,1:02:27.41,1:02:29.45,Default,,0,0,0,,Осы маусымның желі де оған қарсы соққандай.
Dialogue: 0,1:02:30.66,1:02:33.20,Default,,0,0,0,,Кәне, тыныш болыңыз және Әділет мүсінін тамашалаңыз.
Dialogue: 0,1:02:33.29,1:02:34.58,Default,,0,0,0,,Саған берейін!
Dialogue: 0,1:02:34.66,1:02:38.04,Default,,0,0,0,,Егер сіз оны соншалықты қаласаңыз, оны алып кетіңіз.
Dialogue: 0,1:02:38.12,1:02:39.42,Default,,0,0,0,,Иә?
Dialogue: 0,1:02:40.25,1:02:41.79,Default,,0,0,0,,Ах!
Dialogue: 0,1:02:41.88,1:02:43.67,Default,,0,0,0,,Неге!
Dialogue: 0,1:02:47.84,1:02:49.26,Default,,0,0,0,,Тоу! Апыр-ай!
Dialogue: 0,1:02:50.30,1:02:52.39,Default,,0,0,0,,(Шернеуді арттыратын музыка)
Dialogue: 0,1:02:56.43,1:02:58.39,Default,,0,0,0,,Қуу аяқталуға жақын.
Dialogue: 0,1:02:58.48,1:03:02.40,Default,,0,0,0,,Бұл шынымен біте ме?
Dialogue: 0,1:03:02.48,1:03:06.32,Default,,0,0,0,,Менің мұзым сәл салқын
Dialogue: 0,1:03:06.40,1:03:07.65,Default,,0,0,0,,Сіздің теріс қылықтарыңыз...
Dialogue: 0,1:03:07.74,1:03:10.16,Default,,0,0,0,,Шаку тым көп!
Dialogue: 0,1:03:10.24,1:03:11.70,Default,,0,0,0,,Мазаламау!
Dialogue: 0,1:03:11.78,1:03:13.66,Default,,0,0,0,,Егер сізде осындай нәрсені мазақтауға уақытыңыз болса
Dialogue: 0,1:03:13.74,1:03:17.08,Default,,0,0,0,,Қазір ұстаңыз!
Dialogue: 0,1:03:17.16,1:03:19.42,Default,,0,0,0,,Сәлем! Оны ұрламаңыз!
Dialogue: 0,1:03:22.71,1:03:24.55,Default,,0,0,0,,(Көк раушанның айқайы)
Dialogue: 0,1:03:24.63,1:03:26.80,Default,,0,0,0,,Бұл ережелерге қайшы келеді!
Dialogue: 0,1:03:26.88,1:03:28.59,Default,,0,0,0,,Бұл менің жолым!
Dialogue: 0,1:03:29.18,1:03:31.30,Default,,0,0,0,,Нақты не болды?
Dialogue: 0,1:03:31.39,1:03:32.76,Default,,0,0,0,,Бұл біртүрлі...
Dialogue: 0,1:03:32.85,1:03:35.47,Default,,0,0,0,,Әдетте... қашып құтылу мүмкін емес.
Dialogue: 0,1:03:36.93,1:03:38.52,Default,,0,0,0,,Биік аспан! (Ер) Бұл таңқаларлық.
Dialogue: 0,1:03:39.56,1:03:42.36,Default,,0,0,0,,Қылмыскер әлі ұсталған жоқ.
Dialogue: 0,1:03:42.86,1:03:45.40,Default,,0,0,0,,(көңілді күлген дауыс)
Dialogue: 0,1:03:46.11,1:03:47.24,Default,,0,0,0,,Э? Не болып жатыр? Неге!?
Dialogue: 0,1:03:49.15,1:03:50.32,Default,,0,0,0,,Келесі шайқас үшін!
Dialogue: 0,1:03:50.40,1:03:52.37,Default,,0,0,0,,Мен қажетсіз ештеңе жасамауға уәде беремін.
Dialogue: 0,1:03:52.45,1:03:55.37,Default,,0,0,0,,Иә? Сіз бұл уәде бердіңіз бе?
Dialogue: 0,1:03:56.04,1:03:57.37,Default,,0,0,0,,Сіз шынымен...
Dialogue: 0,1:03:57.45,1:03:59.79,Default,,0,0,0,,Сонымен не істеуіміз керек?
Dialogue: 0,1:03:59.87,1:04:02.04,Default,,0,0,0,,Ол өте жылдам жігіт сияқты.
Dialogue: 0,1:04:02.12,1:04:03.58,Default,,0,0,0,,Қаншалықты жылдам болса да
Dialogue: 0,1:04:03.67,1:04:06.25,Default,,0,0,0,,Біздің қабілетімізді белсендірген арамызда қалып қойсаңыз
Dialogue: 0,1:04:06.34,1:04:07.67,Default,,0,0,0,,Сіз қашып құтыла алмайсыз.
Dialogue: 0,1:04:07.76,1:04:09.05,Default,,0,0,0,,Пинсер шабуылы...
Dialogue: 0,1:04:09.63,1:04:10.80,Default,,0,0,0,,орындауыңызды сұраймын.
Dialogue: 0,1:04:11.59,1:04:13.89,Default,,0,0,0,,Бұл біздің батыр дуэт екенімізді білдіреді⸺
Dialogue: 0,1:04:13.97,1:04:15.43,Default,,0,0,0,,Керемет үндеу жасайды
Dialogue: 0,1:04:15.51,1:04:17.89,Default,,0,0,0,,Мен сені қамауға алсам, бәрі жақсы.
Dialogue: 0,1:04:17.97,1:04:20.02,Default,,0,0,0,,Содан кейін қарама-қарсы бағытта бұрылыңыз.
Dialogue: 0,1:04:20.10,1:04:21.48,Default,,0,0,0,,Мен осы жерденмін
Dialogue: 0,1:04:21.56,1:04:22.85,Default,,0,0,0,,Мен қарсыласымды өлтіру үшін келген жоқпын
Dialogue: 0,1:04:24.77,1:04:27.19,Default,,0,0,0,,(Шұғылдық сезімі бар музыка)
Dialogue: 0,1:04:27.28,1:04:29.40,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,1:04:30.82,1:04:32.11,Default,,0,0,0,,О!
Dialogue: 0,1:04:32.20,1:04:33.61,Default,,0,0,0,,Менің ойымша, сіз қазірдің өзінде бас тартуыңыз керек.
Dialogue: 0,1:04:33.70,1:04:35.32,Default,,0,0,0,,Сіз келесі жаңа жігітсіз бе?
Dialogue: 0,1:04:35.91,1:04:38.37,Default,,0,0,0,,Ой! Жаңадан келгендер ғана емес!
Dialogue: 0,1:04:38.45,1:04:39.95,Default,,0,0,0,,Ой... ой...
Dialogue: 0,1:04:40.04,1:04:41.04,Default,,0,0,0,,Қазір!
Dialogue: 0,1:04:48.21,1:04:49.76,Default,,0,0,0,,(баяу қозғалыста айқайлаған дауыс)
Dialogue: 0,1:04:54.09,1:04:54.76,Default,,0,0,0,,Неге сен?
Dialogue: 0,1:04:54.84,1:04:56.01,Default,,0,0,0,,Сіз білесіз бе!
Dialogue: 0,1:04:56.64,1:04:58.35,Default,,0,0,0,,Қап…
Dialogue: 0,1:04:59.93,1:05:01.35,Default,,0,0,0,,Иә?
Dialogue: 0,1:05:01.89,1:05:03.98,Default,,0,0,0,,Бұл өте жақсы идея болды.
Dialogue: 0,1:05:04.69,1:05:07.57,Default,,0,0,0,,Бұл мен емес!
Dialogue: 0,1:05:10.11,1:05:10.99,Default,,0,0,0,,Ах!
Dialogue: 0,1:05:16.82,1:05:21.79,Default,,0,0,0,,О! Тотото... О!
Dialogue: 0,1:05:22.50,1:05:25.71,Default,,0,0,0,,Tattotto... Уау!
Dialogue: 0,1:05:34.38,1:05:35.64,Default,,0,0,0,,Егер ішіне әдемі қызбен бірге мінгенімде ғой.
Dialogue: 0,1:05:35.72,1:05:38.05,Default,,0,0,0,,Бернабиден келген Агнес
Dialogue: 0,1:05:38.14,1:05:38.68,Default,,0,0,0,,Не болды?
Dialogue: 0,1:05:38.76,1:05:41.14,Default,,0,0,0,,Менің бір өтінішім бар.
Dialogue: 0,1:05:41.22,1:05:42.39,Default,,0,0,0,,(Ақсақ дауыс)
Dialogue: 0,1:05:42.48,1:05:44.73,Default,,0,0,0,,Әй бәріңе, Барнабиден хабар берші.
Dialogue: 0,1:05:44.81,1:05:46.65,Default,,0,0,0,,Мен арнайы жол ашамын.
Dialogue: 0,1:05:47.36,1:05:49.11,Default,,0,0,0,,Сәлем! Бұл Барнаби
Dialogue: 0,1:05:49.19,1:05:50.78,Default,,0,0,0,,Кінәлінің қабілетін анықтады
Dialogue: 0,1:05:50.86,1:05:52.90,Default,,0,0,0,,Орналасқан жері өзгерген сияқты.
Dialogue: 0,1:05:52.99,1:05:54.40,Default,,0,0,0,,Орынның өзгеруі?
Dialogue: 0,1:05:54.49,1:05:56.32,Default,,0,0,0,,Көз алдында адамдармен⸺
Dialogue: 0,1:05:56.41,1:05:58.66,Default,,0,0,0,,Орын ауыстыруға болатын сияқты.
Dialogue: 0,1:05:58.74,1:06:00.28,Default,,0,0,0,,Дәл қазір...!
Dialogue: 0,1:06:00.37,1:06:03.04,Default,,0,0,0,,Сондықтан бәріңізге бір өтінішім бар.
Dialogue: 0,1:06:03.62,1:06:06.96,Default,,0,0,0,,Жоқ! Неге олай дейсің?
Dialogue: 0,1:06:11.63,1:06:12.76,Default,,0,0,0,,Сааа!
Dialogue: 0,1:06:12.84,1:06:13.76,Default,,0,0,0,,Шыу!
Dialogue: 0,1:06:14.30,1:06:15.26,Default,,0,0,0,,Ах! Кешіріңіз
Dialogue: 0,1:06:15.84,1:06:16.84,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,1:06:16.93,1:06:17.76,Default,,0,0,0,,Өйткені...
Dialogue: 0,1:06:18.47,1:06:20.68,Default,,0,0,0,,(ақымақ күлкі)
Dialogue: 0,1:06:20.76,1:06:21.51,Default,,0,0,0,,Иә?
Dialogue: 0,1:06:24.39,1:06:25.89,Default,,0,0,0,,Азаматтарға зиян келтірмеу
Dialogue: 0,1:06:25.98,1:06:27.27,Default,,0,0,0,,Сақ болыңыз.
Dialogue: 0,1:06:28.10,1:06:31.11,Default,,0,0,0,,Өйткені біз азаматтарды қорғайтын батырмыз.
Dialogue: 0,1:06:34.57,1:06:36.99,Default,,0,0,0,,Тұтынушыларымызға рахмет
Dialogue: 0,1:06:37.07,1:06:40.49,Default,,0,0,0,,Саябаққа Next қабілеті бар ұры кірді.
Dialogue: 0,1:06:41.12,1:06:43.49,Default,,0,0,0,,Қызметкерлердің нұсқауларына сәйкес қозғалыңыз
Dialogue: 0,1:06:44.20,1:06:47.00,Default,,0,0,0,,Қызметкерлердің нұсқауы бойынша қайталаңыз...
Dialogue: 0,1:06:48.08,1:06:50.88,Default,,0,0,0,,Мен оны қарап шықтым. Сіздер де азаматтардың игілігі үшін...
Dialogue: 0,1:06:50.96,1:06:52.63,Default,,0,0,0,,Қазір күлетін уақыт па?
Dialogue: 0,1:06:52.71,1:06:53.25,Default,,0,0,0,,Иә?
Dialogue: 0,1:06:53.34,1:06:56.88,Default,,0,0,0,,Жоғарыда айтқаным, Hero TV-нің имиджіне нұқсан келтірмеу болды.
Dialogue: 0,1:06:56.97,1:07:00.34,Default,,0,0,0,,Сондай-ақ, қазір басқа кейіпкерлердің қолына түсу оңай болмайды.
Dialogue: 0,1:07:01.47,1:07:03.10,Default,,0,0,0,,Бұл менің несие алу мүмкіндігім.
Dialogue: 0,1:07:03.68,1:07:07.31,Default,,0,0,0,,Иә? Мен кішкентай болуды ойлап жүрмін.
Dialogue: 0,1:07:07.39,1:07:09.10,Default,,0,0,0,,Рахмет айтыңыз.
Dialogue: 0,1:07:09.19,1:07:11.65,Default,,0,0,0,,Маған рахмет, сен де ерекшелендің.
Dialogue: 0,1:07:11.73,1:07:13.73,Default,,0,0,0,,Иә, иә... Рахмет, Маасу.
Dialogue: 0,1:07:14.53,1:07:18.28,Default,,0,0,0,,Мәселе мынада: біздің қабілеттеріміз таусылуда.
Dialogue: 0,1:07:18.36,1:07:21.49,Default,,0,0,0,,Мен сауығып кеткенше не істеу керек деген стратегияны ойлап табуым керек.
Dialogue: 0,1:07:21.57,1:07:23.20,Default,,0,0,0,,Олай болса менде жақсы ой бар.
Dialogue: 0,1:07:23.28,1:07:24.49,Default,,0,0,0,,Мен оны қабылдамаймын (Жабайы жолбарыс) Тыңдаңыз!
Dialogue: 0,1:07:25.08,1:07:26.45,Default,,0,0,0,,Бұл бәрібір жақсы емес.
Dialogue: 0,1:07:26.54,1:07:28.46,Default,,0,0,0,,Не...?
Dialogue: 0,1:07:29.37,1:07:32.75,Default,,0,0,0,,Сіздің қабілеттеріңізді пайдалана алмауыңыздың себебі кімнің стратегиясы болды?
Dialogue: 0,1:07:32.84,1:07:34.55,Default,,0,0,0,,Сіз сенімді болдыңыз, солай ма?
Dialogue: 0,1:07:34.63,1:07:35.92,Default,,0,0,0,,Мұны жасамаңыз.
Dialogue: 0,1:07:36.01,1:07:38.67,Default,,0,0,0,,Бар дедім басынан.
Dialogue: 0,1:07:38.76,1:07:41.09,Default,,0,0,0,,Мен мұны істеуді ойладым!
Dialogue: 0,1:07:41.84,1:07:43.10,Default,,0,0,0,,Менде түсінік жоқ
Dialogue: 0,1:07:43.18,1:07:45.01,Default,,0,0,0,,Мен екпінмен айтқым келеді!
Dialogue: 0,1:07:45.10,1:07:48.18,Default,,0,0,0,,Бір нәрсені осылай жасауға тырысатын адамдардың стратегиялары⸺
Dialogue: 0,1:07:48.27,1:07:49.35,Default,,0,0,0,,Мен күте алмаймын.
Dialogue: 0,1:07:49.44,1:07:51.85,Default,,0,0,0,,Стратегияға келгенде менің де басым қатты болады⸺
Dialogue: 0,1:07:51.94,1:07:53.61,Default,,0,0,0,,Мен үлгере алмаймын!
Dialogue: 0,1:07:54.52,1:07:56.61,Default,,0,0,0,,(Жарқыраған дауыстар)
Dialogue: 0,1:07:57.28,1:07:57.86,Default,,0,0,0,,Ей!
Dialogue: 0,1:07:58.86,1:08:01.41,Default,,0,0,0,,Осындай уақытта не үшін ұрысып жатырсың?
Dialogue: 0,1:08:01.49,1:08:03.24,Default,,0,0,0,,Мен Сот бюросынан ақпарат алдым.
Dialogue: 0,1:08:03.32,1:08:03.82,Default,,0,0,0,,«Халықаралық қылмыскер Робин Бакстер»
Dialogue: 0,1:08:03.82,1:08:05.95,Default,,0,0,0,,«Халықаралық қылмыскер Робин Бакстер»
Dialogue: 0,1:08:03.82,1:08:05.95,Default,,0,0,0,,Кінәлі - Робин Бакстер
Dialogue: 0,1:08:05.95,1:08:06.04,Default,,0,0,0,,«Халықаралық қылмыскер Робин Бакстер»
Dialogue: 0,1:08:06.04,1:08:06.08,Default,,0,0,0,,«Халықаралық қылмыскер Робин Бакстер»
Dialogue: 0,1:08:06.04,1:08:06.08,Default,,0,0,0,,Халықаралық танымал зорлықшы қарақшы.
Dialogue: 0,1:08:06.08,1:08:06.16,Default,,0,0,0,,Халықаралық танымал зорлықшы қарақшы.
Dialogue: 0,1:08:06.16,1:08:08.75,Default,,0,0,0,,Халықаралық танымал зорлық-зомбылық жасаушы қарақшы.
Dialogue: 0,1:08:06.16,1:08:08.75,Default,,0,0,0,,«Физикалық сипаттамалары Қылмыстық тарих»
Dialogue: 0,1:08:08.83,1:08:11.79,Default,,0,0,0,,Әртүрлі елдерде Робиннің зақымдануы туралы хабарланды.
Dialogue: 0,1:08:11.87,1:08:15.38,Default,,0,0,0,,Бірақ менде қамауға алынғаны туралы хаттама жоқ, мен барлығынан құтылдым.
Dialogue: 0,1:08:16.09,1:08:17.88,Default,,0,0,0,,Ақымақ даулардың соңы!
Dialogue: 0,1:08:18.46,1:08:20.80,Default,,0,0,0,,Келесіде мен мұны орындасам, ұпайларды азайтамын!
Dialogue: 0,1:08:20.88,1:08:21.76,Default,,0,0,0,,Эй (Барнаби) Иә.
Dialogue: 0,1:08:21.84,1:08:23.55,Default,,0,0,0,,(Қара және ауыр музыка)
Dialogue: 0,1:08:23.64,1:08:26.01,Default,,0,0,0,,Қазіргі уақытта батырлар бейбіт тұрғындарды эвакуациялауды сұрап жатыр⸺
Dialogue: 0,1:08:26.10,1:08:27.77,Default,,0,0,0,,Қоңырау шалу
Dialogue: 0,1:08:28.47,1:08:30.77,Default,,0,0,0,,Хо…
Dialogue: 0,1:08:30.85,1:08:33.56,Default,,0,0,0,,Не болып жатыр! бұршақ пастасы?
Dialogue: 0,1:08:34.15,1:08:36.82,Default,,0,0,0,,Біз кіру жарнасын төледік!
Dialogue: 0,1:08:36.90,1:08:39.53,Default,,0,0,0,,Мені тез ұстаңыз!
Dialogue: 0,1:08:39.61,1:08:40.86,Default,,0,0,0,,(таңданған дауыс)
Dialogue: 0,1:08:41.61,1:08:43.36,Default,,0,0,0,,Сәлем әке! Хихихи!
Dialogue: 0,1:08:43.45,1:08:45.45,Default,,0,0,0,,Бұл шықты! (ақымақ күлкі)
Dialogue: 0,1:08:45.53,1:08:46.37,Default,,0,0,0,,Ой...
Dialogue: 0,1:08:48.70,1:08:50.12,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,1:08:50.87,1:08:52.37,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,1:08:52.46,1:08:53.46,Default,,0,0,0,,Иә
Dialogue: 0,1:08:53.54,1:08:54.63,Default,,0,0,0,,Әлгі бейбақ!
Dialogue: 0,1:08:55.38,1:08:57.38,Default,,0,0,0,,Иә? (Саябақтағы адам) Иә?
Dialogue: 0,1:08:57.46,1:08:59.30,Default,,0,0,0,,Иә? (Саябақтағы адам) Не болды?
Dialogue: 0,1:08:59.38,1:09:01.17,Default,,0,0,0,,Уау!
Dialogue: 0,1:09:02.47,1:09:03.63,Default,,0,0,0,,Кетіңіз!
Dialogue: 0,1:09:04.22,1:09:06.14,Default,,0,0,0,,Қауіпті! сен!
Dialogue: 0,1:09:06.76,1:09:10.35,Default,,0,0,0,,Кінәлі шығуға бет алған сияқты. Мен оның алдынан өтемін!
Dialogue: 0,1:09:10.43,1:09:13.64,Default,,0,0,0,,Не? Эй! Сондықтан тыңдаңыз!
Dialogue: 0,1:09:14.23,1:09:15.90,Default,,0,0,0,,Осы жолмен!
Dialogue: 0,1:09:22.74,1:09:25.45,Default,,0,0,0,,(таңданғаннан айқайлаған дауыс)
Dialogue: 0,1:09:25.53,1:09:28.16,Default,,0,0,0,,(Робиннің мазақтаған күлкісі)
Dialogue: 0,1:09:28.24,1:09:30.37,Default,,0,0,0,,Уф!
Dialogue: 0,1:09:32.58,1:09:35.75,Default,,0,0,0,,О! Бұл жолы мохавк костюмі ме?
Dialogue: 0,1:09:36.54,1:09:38.25,Default,,0,0,0,,Қоян жақсы болды ма?
Dialogue: 0,1:09:42.01,1:09:43.01,Default,,0,0,0,,♬ Мен бара жатқан жер — әлі көрінбеген тағдыр
Dialogue: 0,1:09:47.72,1:09:48.85,Default,,0,0,0,,Сізге телефон соғуға болады ма?
Dialogue: 0,1:09:48.93,1:09:50.31,Default,,0,0,0,,А...? (көтеретін музыка)
Dialogue: 0,1:09:52.10,1:09:53.93,Default,,0,0,0,,Оны бір күн деп атайық.
Dialogue: 0,1:09:54.02,1:09:54.98,Default,,0,0,0,,Цк...!
Dialogue: 0,1:09:55.06,1:09:57.15,Default,,0,0,0,,Калорияларды босқа жұмсамаңыз
Dialogue: 0,1:09:57.23,1:09:58.90,Default,,0,0,0,,Қазір қашып құтыла алмайсың.
Dialogue: 0,1:09:58.98,1:10:02.69,Default,,0,0,0,,Аа...! Сендер шынымен ақымақсыңдар
Dialogue: 0,1:10:03.61,1:10:05.78,Default,,0,0,0,,Кім ақымақ?
Dialogue: 0,1:10:06.82,1:10:08.24,Default,,0,0,0,,Ой!
Dialogue: 0,1:10:09.87,1:10:10.66,Default,,0,0,0,,Бұл тек менің қиялым ғана болды.
Dialogue: 0,1:10:11.54,1:10:12.83,Default,,0,0,0,,Эй, не болып жатыр?
Dialogue: 0,1:10:12.91,1:10:14.08,Default,,0,0,0,,Неліктен орын ауыстырмайсың?
Dialogue: 0,1:10:14.66,1:10:16.33,Default,,0,0,0,,Кіммен ауысқаныңыз маңызды емес.
Dialogue: 0,1:10:16.42,1:10:17.21,Default,,0,0,0,,Ура!
Dialogue: 0,1:10:17.29,1:10:19.08,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:10:19.67,1:10:23.92,Default,,0,0,0,,Жарайды... сен шынымен ақымақсың.
Dialogue: 0,1:10:24.01,1:10:25.93,Default,,0,0,0,,Не? Оны ауыстырмайсың ба?
Dialogue: 0,1:10:26.01,1:10:27.18,Default,,0,0,0,,(Музыка кенет аяқталады)
Dialogue: 0,1:10:28.14,1:10:29.51,Default,,0,0,0,,Иә?
Dialogue: 0,1:10:30.01,1:10:31.60,Default,,0,0,0,,Жолбарыс пен Барнаби
Dialogue: 0,1:10:31.68,1:10:33.56,Default,,0,0,0,,Қаншалықты жақын екеніңізге жүгінсеңіз де,
Dialogue: 0,1:10:33.64,1:10:35.81,Default,,0,0,0,,Кінәлі ешқашан ұсталмайды.
Dialogue: 0,1:10:35.89,1:10:37.35,Default,,0,0,0,,(адамдар күледі)
Dialogue: 0,1:10:38.35,1:10:40.36,Default,,0,0,0,,Сіз мені жібере аласыз ба?
Dialogue: 0,1:10:40.98,1:10:43.03,Default,,0,0,0,,Ах... (Барнаби) Бұл қандай стратегия?
Dialogue: 0,1:10:43.11,1:10:45.40,Default,,0,0,0,,Жоқ... Мен оларды ауыстырады деп ойладым...
Dialogue: 0,1:10:45.49,1:10:46.82,Default,,0,0,0,,Мұндай балалық стратегия⸺
Dialogue: 0,1:10:46.90,1:10:49.24,Default,,0,0,0,,Қылмыскердің көлік жүргізуіне жол жоқ, солай ма?
Dialogue: 0,1:10:49.32,1:10:51.87,Default,,0,0,0,,Енді арнаны өзгертуге болады.
Dialogue: 0,1:10:52.58,1:10:54.54,Default,,0,0,0,,Арна сізсіз!
Dialogue: 0,1:10:54.62,1:10:57.75,Default,,0,0,0,,Біздің мақсатымыз теледидарға шығу емес!
Dialogue: 0,1:10:57.83,1:10:59.21,Default,,0,0,0,,Иә, иә
Dialogue: 0,1:10:59.29,1:11:00.38,Default,,0,0,0,,Эй, түсіндің бе?
Dialogue: 0,1:11:01.50,1:11:02.71,Default,,0,0,0,,Бұл қозғалыста не дұрыс емес?
Dialogue: 0,1:11:03.46,1:11:05.46,Default,,0,0,0,,Біз азаматтарымыздың қауіпсіздігін қамтамасыз етеміз...
Dialogue: 0,1:11:05.55,1:11:07.68,Default,,0,0,0,,Сіз маған қылмыскерді іздеуді айттыңыз!
Dialogue: 0,1:11:07.76,1:11:08.84,Default,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,1:11:08.93,1:11:09.76,Default,,0,0,0,,Не!
Dialogue: 0,1:11:09.84,1:11:12.22,Default,,0,0,0,,Тағы да...
Dialogue: 0,1:11:12.97,1:11:14.72,Default,,0,0,0,,Дүние жүзінде қайталанатын қылмыстар⸺
Dialogue: 0,1:11:14.81,1:11:15.93,Default,,0,0,0,,Робин Бакстер
Dialogue: 0,1:11:16.02,1:11:17.89,Default,,0,0,0,,Әлі де қиын ба?
Dialogue: 0,1:11:18.48,1:11:21.56,Default,,0,0,0,,Батырлар қашу жолын жасамауы керек
Dialogue: 0,1:11:21.65,1:11:23.57,Default,,0,0,0,,Ойын-сауық саябағы жабық сияқты.
Dialogue: 0,1:11:23.65,1:11:25.03,Default,,0,0,0,,(Шыншыл музыка)
Dialogue: 0,1:11:25.11,1:11:25.94,Default,,0,0,0,,Саябақта болған азаматтар
Dialogue: 0,1:11:26.03,1:11:29.49,Default,,0,0,0,,Бізді батырларымыздың нұсқауымен бірінен соң бірі көшіруде.
Dialogue: 0,1:11:31.53,1:11:34.08,Default,,0,0,0,,Sky Сәлем!
Dialogue: 0,1:11:34.16,1:11:37.96,Default,,0,0,0,,Ой! Біз тіпті жақындай алмаймыз
Dialogue: 0,1:11:38.04,1:11:41.38,Default,,0,0,0,,Бұл аймақ қазір жабық.
Dialogue: 0,1:11:41.46,1:11:42.96,Default,,0,0,0,,Тұтынушы нұсқауларды орындауы керек.
Dialogue: 0,1:11:43.04,1:11:45.55,Default,,0,0,0,,Тез арада қақпа алдында кездесіңіз.
Dialogue: 0,1:11:49.30,1:11:53.14,Default,,0,0,0,,(Балалардың күлкісі)
Dialogue: 0,1:12:00.31,1:12:02.86,Default,,0,0,0,,Барлығына! Қозғалма!
Dialogue: 0,1:12:08.40,1:12:11.91,Default,,0,0,0,,Хэхе... Хмм?
Dialogue: 0,1:12:11.99,1:12:14.20,Default,,0,0,0,,Бәрі жақсы, мен бұны істей аламын!
Dialogue: 0,1:12:14.28,1:12:15.41,Default,,0,0,0,,(ренжіген дауыс)
Dialogue: 0,1:12:15.49,1:12:16.95,Default,,0,0,0,,Сен де осында кел.
Dialogue: 0,1:12:17.04,1:12:18.29,Default,,0,0,0,,Не? не?
Dialogue: 0,1:12:18.37,1:12:19.96,Default,,0,0,0,,Асығыңыз! Бірге жиналыңдар!
Dialogue: 0,1:12:20.04,1:12:21.79,Default,,0,0,0,,Барлығына! Тек қозғалма!
Dialogue: 0,1:12:21.87,1:12:23.21,Default,,0,0,0,,(Адамдардың абдырап қалған дауыстары)
Dialogue: 0,1:12:24.04,1:12:25.21,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,1:12:25.29,1:12:26.84,Default,,0,0,0,,Сен ақымақсың.
Dialogue: 0,1:12:26.92,1:12:29.38,Default,,0,0,0,,Бұл аймақ енді сыртқы әлемнен оқшауланған!
Dialogue: 0,1:12:29.47,1:12:30.67,Default,,0,0,0,,Сонымен?
Dialogue: 0,1:12:31.26,1:12:33.18,Default,,0,0,0,,Барлығы осында жиналса
Dialogue: 0,1:12:33.26,1:12:37.39,Default,,0,0,0,,Оның орнына кім келсе де шыға алмайды.
Dialogue: 0,1:12:37.47,1:12:41.52,Default,,0,0,0,,Хмф! Олардың бәрі ақымақ емес пе?
Dialogue: 0,1:12:41.60,1:12:45.77,Default,,0,0,0,,Енді сіз оны қалай ұстау керектігін ойласаңыз болғаны, мистер Уайлд.
Dialogue: 0,1:12:45.86,1:12:48.53,Default,,0,0,0,,Ей, сендер ақылдысыңдар...
Dialogue: 0,1:12:50.44,1:12:54.16,Default,,0,0,0,,Мұнымен қанша уақыт күресуіміз керек?
Dialogue: 0,1:12:55.82,1:12:57.24,Default,,0,0,0,,(Әйелдің таңданған дауысы)
Dialogue: 0,1:12:57.33,1:12:57.99,Default,,0,0,0,,О!
Dialogue: 0,1:12:58.08,1:12:59.50,Default,,0,0,0,,А... өтінемін, қайтыңыз!
Dialogue: 0,1:13:05.42,1:13:07.29,Default,,0,0,0,,Қазіргі соққың мүлде уақытынан тыс, аянышты болды!
Dialogue: 0,1:13:08.67,1:13:10.21,Default,,0,0,0,,Маған көмектес!
Dialogue: 0,1:13:10.30,1:13:11.05,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,1:13:11.13,1:13:13.97,Default,,0,0,0,,Гокуро-сан
Dialogue: 0,1:13:14.05,1:13:16.89,Default,,0,0,0,,Хяхахаха! Пури!
Dialogue: 0,1:13:18.18,1:13:19.81,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,1:13:19.89,1:13:21.43,Default,,0,0,0,,Себебі сіз өзіңіз қалаған нәрсені істеп жатырсыз.
Dialogue: 0,1:13:21.52,1:13:22.68,Default,,0,0,0,,Эй, мен көмектесемін!
Dialogue: 0,1:13:22.77,1:13:26.15,Default,,0,0,0,,Сен ғана жеткіліктісің, солай ма? Кінәлі?
Dialogue: 0,1:13:26.23,1:13:28.07,Default,,0,0,0,,Әке!
Dialogue: 0,1:13:30.07,1:13:31.86,Default,,0,0,0,,Әке! (халық әбігері)
Dialogue: 0,1:13:31.94,1:13:33.65,Default,,0,0,0,,Қозғалмаңыз!
Dialogue: 0,1:13:33.74,1:13:34.74,Default,,0,0,0,,Сонымен...! Ахх...
Dialogue: 0,1:13:34.82,1:13:36.62,Default,,0,0,0,,Уау...? Иә...?
Dialogue: 0,1:13:36.70,1:13:39.70,Default,,0,0,0,,(Мұңды музыка)
Dialogue: 0,1:13:42.20,1:13:43.96,Default,,0,0,0,,Иә?
Dialogue: 0,1:13:47.75,1:13:48.63,Default,,0,0,0,,Әке!
Dialogue: 0,1:13:52.01,1:13:54.13,Default,,0,0,0,,(Ата-ана мен баланың жылаған дыбысы)
Dialogue: 0,1:13:55.63,1:13:59.14,Default,,0,0,0,,Әке, ұлыңызды қалдырмаңыз.
Dialogue: 0,1:13:59.97,1:14:02.39,Default,,0,0,0,,Бұл бала үшін сен жалғызсың⸺
Dialogue: 0,1:14:03.18,1:14:05.23,Default,,0,0,0,,Ол маңызды әке.
Dialogue: 0,1:14:05.85,1:14:06.90,Default,,0,0,0,,Иә
Dialogue: 0,1:14:09.44,1:14:11.94,Default,,0,0,0,,Сізге... балалар ұнайды ма?
Dialogue: 0,1:14:12.03,1:14:12.78,Default,,0,0,0,,Иә?
Dialogue: 0,1:14:12.86,1:14:14.90,Default,,0,0,0,,Сол баланың кесірінен...
Dialogue: 0,1:14:16.20,1:14:17.41,Default,,0,0,0,,Тіпті күндіз де...
Dialogue: 0,1:14:21.12,1:14:24.04,Default,,0,0,0,,Қандай тосынсый...
Dialogue: 0,1:14:25.58,1:14:27.92,Default,,0,0,0,,Арнайы мағынасы жоқ.
Dialogue: 0,1:14:30.38,1:14:31.13,Default,,0,0,0,,(Сора) Мен оны біршама болжаған едім, бірақ осыншалықты шектен тыс боларын ойламаппын.
Dialogue: 0,1:14:31.21,1:14:33.38,Default,,0,0,0,,Кінәлі Робин аттракционға жүгірді.
Dialogue: 0,1:14:33.46,1:14:35.38,Default,,0,0,0,,Батырлар жолда келе жатыр.
Dialogue: 0,1:14:35.97,1:14:38.39,Default,,0,0,0,,Әдетте, жағдай басымдылықпен тиімді, бірақ
Dialogue: 0,1:14:38.47,1:14:40.22,Default,,0,0,0,,Бұл жолы бәрі керісінше.
Dialogue: 0,1:14:40.30,1:14:43.22,Default,,0,0,0,,Тұйықтық жалғасуы мүмкін.
Dialogue: 0,1:14:43.31,1:14:44.43,Default,,0,0,0,,Жаман жаңалықтар.
Dialogue: 0,1:14:45.02,1:14:47.27,Default,,0,0,0,,Қылмыскер соқтығысқан ролик болды
Dialogue: 0,1:14:47.35,1:14:49.15,Default,,0,0,0,,Ішінен Стернбилттің басына⸺
Dialogue: 0,1:14:49.15,1:14:49.48,Default,,0,0,0,,Интерьерден Штернбилт шыңына дейін⸺
Dialogue: 0,1:14:49.15,1:14:49.48,Default,,0,0,0,,«Үлкен ағаш»
Dialogue: 0,1:14:49.48,1:14:49.56,Default,,0,0,0,,«Үлкен ағаш»
Dialogue: 0,1:14:49.56,1:14:51.61,Default,,0,0,0,,«Үлкен ағаш»
Dialogue: 0,1:14:49.56,1:14:51.61,Default,,0,0,0,,Оның жалғасатынын білдім.
Dialogue: 0,1:14:51.61,1:14:51.65,Default,,0,0,0,,Оның жалғасатынын білдім.
Dialogue: 0,1:14:51.69,1:14:51.73,Default,,0,0,0,,«Ойын-сауық алаңы»
Dialogue: 0,1:14:51.73,1:14:53.65,Default,,0,0,0,,«Ойын алаңы»
Dialogue: 0,1:14:51.73,1:14:53.65,Default,,0,0,0,,Ұзын тік туннель
Dialogue: 0,1:14:53.73,1:14:55.15,Default,,0,0,0,,Жасыл аймақ Айна аймағы
Dialogue: 0,1:14:55.24,1:14:57.20,Default,,0,0,0,,Аспан аймақтарына бөлінген
Dialogue: 0,1:14:57.28,1:14:57.74,Default,,0,0,0,,Жоғарыға төтенше шығу
Dialogue: 0,1:14:57.74,1:14:58.74,Default,,0,0,0,,Төбеге шығатын апаттық шығу – «қауіпсіздік камерасы»
Dialogue: 0,1:14:58.74,1:14:58.82,Default,,0,0,0,,«Қауіпсіздік камерасы»
Dialogue: 0,1:14:58.82,1:15:00.57,Default,,0,0,0,,Барлық «қауіпсіздік камералары» жабылды.
Dialogue: 0,1:15:00.57,1:15:00.66,Default,,0,0,0,,Менде барлығы жабық болды.
Dialogue: 0,1:15:00.66,1:15:01.07,Default,,0,0,0,,Барлығы жабылды, бірақ «Аспан палубасы»
Dialogue: 0,1:15:01.07,1:15:01.16,Default,,0,0,0,,«Аспан палубасы»
Dialogue: 0,1:15:01.16,1:15:02.45,Default,,0,0,0,,«Аспан палубасы» Соңғы аспан аймағынан өткеннен кейін
Dialogue: 0,1:15:02.45,1:15:03.20,Default,,0,0,0,,Соңғы Аспан аймағынан өткеннен кейін
Dialogue: 0,1:15:03.29,1:15:06.12,Default,,0,0,0,,Бақылау алаңынан қаланың панорамалық көрінісін көруге болады.
Dialogue: 0,1:15:06.21,1:15:08.96,Default,,0,0,0,,Сосын, егер кінәлі соншалықты...
Dialogue: 0,1:15:09.04,1:15:11.21,Default,,0,0,0,,Мен бұл қалада кез келген адаммен орын ауыстыра аламын.
Dialogue: 0,1:15:11.29,1:15:12.50,Default,,0,0,0,,Бұл...
Dialogue: 0,1:15:12.59,1:15:14.46,Default,,0,0,0,,Сонымен обсерваторияға жеткенше
Dialogue: 0,1:15:14.55,1:15:16.72,Default,,0,0,0,,Не болса да мені ұста!
Dialogue: 0,1:15:16.80,1:15:19.55,Default,,0,0,0,,Осы қарқынмен Әділдік мүсіні
Dialogue: 0,1:15:19.64,1:15:20.80,Default,,0,0,0,,Алып кету керек
Dialogue: 0,1:15:20.89,1:15:23.22,Default,,0,0,0,,Бірақ жақындасаң, сені ауыстырады...
Dialogue: 0,1:15:24.43,1:15:27.48,Default,,0,0,0,,Ең дұрысы, осы ғимаратты түгел қиратайық.
Dialogue: 0,1:15:27.56,1:15:30.06,Default,,0,0,0,,Өтемақыны қарастыру қорқынышты.
Dialogue: 0,1:15:31.27,1:15:33.73,Default,,0,0,0,,Нағыз жиіркенішті қылмыскер.
Dialogue: 0,1:15:34.32,1:15:37.57,Default,,0,0,0,,Бұл жүйкеңе тиіп тұр ма? Егер ашуланатын батылың болса, ашулан да.
Dialogue: 0,1:15:37.65,1:15:39.32,Default,,0,0,0,,Қазір Робин жасыл аймақтан өтіп жатыр.
Dialogue: 0,1:15:39.40,1:15:41.20,Default,,0,0,0,,Мен айна аймағына кірдім.
Dialogue: 0,1:15:41.28,1:15:42.57,Default,,0,0,0,,Е! қазірдің өзінде?
Dialogue: 0,1:15:42.66,1:15:45.58,Default,,0,0,0,,Мені асықпа, мен қазір ойлап жатырмын!
Dialogue: 0,1:15:45.66,1:15:48.00,Default,,0,0,0,,Дааа! Қазірдің өзінде Рачи Акане!
Dialogue: 0,1:15:48.91,1:15:50.75,Default,,0,0,0,,Мен сені тура кесіп алып, ұстап аламын.
Dialogue: 0,1:15:50.83,1:15:53.09,Default,,0,0,0,,Қайтадан сәтсіздікке ұшыраңыз
Dialogue: 0,1:15:54.25,1:15:56.38,Default,,0,0,0,,Келіңіздер! Маған қолдау көрсетуіңізді өтінемін!
Dialogue: 0,1:15:56.46,1:15:58.92,Default,,0,0,0,,Мен сол қолдауға қатты алаңдаймын.
Dialogue: 0,1:15:59.01,1:16:00.13,Default,,0,0,0,,Не деген сұмдық!
Dialogue: 0,1:16:00.22,1:16:02.55,Default,,0,0,0,,Мен қармақтың рөлін ойнауды ойладым!
Dialogue: 0,1:16:03.89,1:16:05.60,Default,,0,0,0,,Оған сіздер, студенттер де кіресіздер.
Dialogue: 0,1:16:05.68,1:16:06.81,Default,,0,0,0,,Не? Не болды?
Dialogue: 0,1:16:06.89,1:16:08.14,Default,,0,0,0,,Келмеңіз!
Dialogue: 0,1:16:08.23,1:16:11.10,Default,,0,0,0,,Иә? Ақыр аяғында бұл комбинация...
Dialogue: 0,1:16:11.19,1:16:12.81,Default,,0,0,0,,Әрине...
Dialogue: 0,1:16:12.90,1:16:15.15,Default,,0,0,0,,Мен қылмыскерді ұстаймын!
Dialogue: 0,1:16:15.23,1:16:16.32,Default,,0,0,0,,(Шернеуді арттыратын музыка)
Dialogue: 0,1:16:23.70,1:16:26.95,Default,,0,0,0,,Сәлем! Жаңадан келгендерге қалағанын жасауға рұқсат беру дұрыс па?
Dialogue: 0,1:16:29.96,1:16:32.96,Default,,0,0,0,,(мазасыз музыка)
Dialogue: 0,1:16:41.13,1:16:42.09,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,1:16:42.18,1:16:45.47,Default,,0,0,0,,Робин Бакстер жақында айна аймағын тастап кетеді!
Dialogue: 0,1:16:47.85,1:16:51.02,Default,,0,0,0,,Хамф! Хамф!
Dialogue: 0,1:16:59.36,1:17:00.03,Default,,0,0,0,,Иә?
Dialogue: 0,1:17:02.61,1:17:03.66,Default,,0,0,0,,Хмм…
Dialogue: 0,1:17:06.99,1:17:10.04,Default,,0,0,0,,Кінәлі жақын арада бақылау алаңына жетеді.
Dialogue: 0,1:17:10.87,1:17:12.54,Default,,0,0,0,,Сіз не істеп жатырсыз? Барнаби бұл...
Dialogue: 0,1:17:12.62,1:17:16.54,Default,,0,0,0,,(ызылдаған дауыс)
Dialogue: 0,1:17:16.63,1:17:18.92,Default,,0,0,0,,Сіз оны көп қиындыққа душар еттіңіз!
Dialogue: 0,1:17:19.00,1:17:20.55,Default,,0,0,0,,Не...? Уф!
Dialogue: 0,1:17:20.63,1:17:22.63,Default,,0,0,0,,Бітті!
Dialogue: 0,1:17:22.72,1:17:25.14,Default,,0,0,0,,Біз сізді міндетті түрде ұстаймыз!
Dialogue: 0,1:17:28.64,1:17:31.73,Default,,0,0,0,,Олардың ақымақ дуэт болуы мүмкін емес.
Dialogue: 0,1:17:37.11,1:17:38.44,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,1:17:40.28,1:17:42.69,Default,,0,0,0,,Хмф! Ха!
Dialogue: 0,1:17:47.12,1:17:49.49,Default,,0,0,0,,А...? А...?
Dialogue: 0,1:17:50.20,1:17:51.04,Default,,0,0,0,,Не болды?
Dialogue: 0,1:17:51.12,1:17:53.91,Default,,0,0,0,,Мақсат дерлік осында.
Dialogue: 0,1:17:54.00,1:17:56.29,Default,,0,0,0,,(Робиннің күшті дауысы)
Dialogue: 0,1:18:05.63,1:18:06.84,Default,,0,0,0,,(төмен күлкі)
Dialogue: 0,1:18:14.64,1:18:16.77,Default,,0,0,0,,Қабілеттің аяқталуына 30 секунд қалғанда
Dialogue: 0,1:18:16.85,1:18:17.60,Default,,0,0,0,,(күрсіну)
Dialogue: 0,1:18:17.69,1:18:20.65,Default,,0,0,0,,(Шұғылдық сезімі бар музыка)
Dialogue: 0,1:18:20.73,1:18:21.65,Default,,0,0,0,,Әй!
Dialogue: 0,1:18:24.86,1:18:26.15,Default,,0,0,0,,Шыу!
Dialogue: 0,1:18:26.24,1:18:29.32,Default,,0,0,0,,Қарғыс атсын! Мен оны көре алмаймын!
Dialogue: 0,1:18:30.78,1:18:31.79,Default,,0,0,0,,Хмф!
Dialogue: 0,1:18:31.87,1:18:34.58,Default,,0,0,0,,Шыу!
Dialogue: 0,1:18:43.38,1:18:44.55,Default,,0,0,0,,Бітті
Dialogue: 0,1:18:45.26,1:18:47.01,Default,,0,0,0,,Робин Бакстерді қорғау
Dialogue: 0,1:18:47.63,1:18:50.51,Default,,0,0,0,,(Баталы музыка)
Dialogue: 0,1:18:51.85,1:18:53.60,Default,,0,0,0,,Соңында орындадым!
Dialogue: 0,1:18:53.68,1:18:55.43,Default,,0,0,0,,Робин Бакстерді кім қамтамасыз етті?
Dialogue: 0,1:18:55.52,1:18:56.44,Default,,0,0,0,,Жаңа кейіпкер
Dialogue: 0,1:18:56.52,1:18:58.90,Default,,0,0,0,,Кіші Барнаби Брукс!
Dialogue: 0,1:18:58.98,1:19:00.11,Default,,0,0,0,,Керемет Стернбилт
Dialogue: 0,1:19:00.19,1:19:01.61,Default,,0,0,0,,Әділет мүсіні
Dialogue: 0,1:19:01.69,1:19:03.19,Default,,0,0,0,,Мен оны қайтардым!
Dialogue: 0,1:19:03.28,1:19:06.11,Default,,0,0,0,,(Адамдар қолдайды)
Dialogue: 0,1:19:06.19,1:19:08.11,Default,,0,0,0,,(көңілді музыка)
Dialogue: 0,1:19:08.20,1:19:09.82,Default,,0,0,0,,Керемет!
Dialogue: 0,1:19:09.91,1:19:11.41,Default,,0,0,0,,Керемет! (Бала) Ия!
Dialogue: 0,1:19:11.49,1:19:13.33,Default,,0,0,0,,(Адамдар қолдайды)
Dialogue: 0,1:19:13.91,1:19:16.12,Default,,0,0,0,,Уау, бұл өте қызықты болды!
Dialogue: 0,1:19:16.20,1:19:17.87,Default,,0,0,0,,Сандар да аспандап тұр!
Dialogue: 0,1:19:17.96,1:19:20.46,Default,,0,0,0,,Жақсы! Барнабидің де арнайы бағдарламасы!
Dialogue: 0,1:19:20.54,1:19:22.04,Default,,0,0,0,,Құжатты жабыңыз!
Dialogue: 0,1:19:22.71,1:19:23.96,Default,,0,0,0,,Робин қазір қамауға алынды.
Dialogue: 0,1:19:24.05,1:19:27.72,Default,,0,0,0,,Батырлар полицияға тапсырды
Dialogue: 0,1:19:27.80,1:19:29.55,Default,,0,0,0,,Бұл туралы ма...
Dialogue: 0,1:19:32.14,1:19:34.56,Default,,0,0,0,,(ызылдаған дауыс)
Dialogue: 0,1:19:37.39,1:19:38.31,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,1:19:38.39,1:19:39.06,Default,,0,0,0,,О...
Dialogue: 0,1:19:41.86,1:19:43.06,Default,,0,0,0,,Құттықтаймыз
Dialogue: 0,1:19:43.73,1:19:46.90,Default,,0,0,0,,Жарайсың, Банни Чан.
Dialogue: 0,1:19:47.40,1:19:50.99,Default,,0,0,0,,Сондықтан бұл есімді қанша айтсам да...
Dialogue: 0,1:19:51.07,1:19:53.12,Default,,0,0,0,,Көңіл күйіңіз әлі де жақсы ма?
Dialogue: 0,1:19:53.20,1:19:56.33,Default,,0,0,0,,Жетер, өткенді жуып тастайық.
Dialogue: 0,1:19:57.70,1:20:00.08,Default,,0,0,0,,Уау! ...Бұл не?
Dialogue: 0,1:20:00.67,1:20:02.75,Default,,0,0,0,,Бүгін не істедің?
Dialogue: 0,1:20:02.83,1:20:03.42,Default,,0,0,0,,Иә?
Dialogue: 0,1:20:03.50,1:20:05.80,Default,,0,0,0,,Барлық үлкен нәрселерді айту
Dialogue: 0,1:20:05.88,1:20:08.67,Default,,0,0,0,,Соңында қария аяғын сүйретіп жүрген жоқ па?
Dialogue: 0,1:20:09.26,1:20:10.63,Default,,0,0,0,,Сіз бұлай айта алмайсыз!
Dialogue: 0,1:20:10.72,1:20:11.72,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,1:20:11.80,1:20:12.68,Default,,0,0,0,,Фалько…
Dialogue: 0,1:20:12.76,1:20:13.68,Default,,0,0,0,,(жеңіл музыка)
Dialogue: 0,1:20:13.76,1:20:14.93,Default,,0,0,0,,Жақсы жұмыс
Dialogue: 0,1:20:15.51,1:20:16.39,Default,,0,0,0,,Ах!
Dialogue: 0,1:20:18.23,1:20:19.43,Default,,0,0,0,,Сәлем
Dialogue: 0,1:20:19.52,1:20:22.65,Default,,0,0,0,,Міне, бүгін ұзақ шайқас болды.
Dialogue: 0,1:20:22.73,1:20:24.65,Default,,0,0,0,,Мен мұны саған айтқан жоқпын.
Dialogue: 0,1:20:24.73,1:20:27.94,Default,,0,0,0,,Сіз жалықтыратын жұмыс жасамайсыз, солай ма?
Dialogue: 0,1:20:28.03,1:20:30.36,Default,,0,0,0,,Жоқ, жоқ, менде де әртүрлі заттар бар.
Dialogue: 0,1:20:30.45,1:20:32.28,Default,,0,0,0,,Бұл керемет болды.
Dialogue: 0,1:20:32.99,1:20:34.78,Default,,0,0,0,,Мен сенен осылай сұраймын.
Dialogue: 0,1:20:35.37,1:20:36.37,Default,,0,0,0,,Иә
Dialogue: 0,1:20:38.91,1:20:40.37,Default,,0,0,0,,(Шиозаки) «Кісі өлтіруші» дегенің не?
Dialogue: 0,1:20:41.21,1:20:43.71,Default,,0,0,0,,Қазірдің өзінде! Менде шынымен қорқынышты оқиға болды!
Dialogue: 0,1:20:43.71,1:20:44.58,Default,,0,0,0,,Қазірдің өзінде! Менде шынымен қорқынышты оқиға болды!
Dialogue: 0,1:20:43.71,1:20:44.58,Default,,0,0,0,,«Кэде дауысы»
Dialogue: 0,1:20:44.58,1:20:44.67,Default,,0,0,0,,«Кэде дауысы»
Dialogue: 0,1:20:44.67,1:20:46.17,Default,,0,0,0,,«Кэде дауысы»
Dialogue: 0,1:20:44.67,1:20:46.17,Default,,0,0,0,,Менің әкем болса!
Dialogue: 0,1:20:46.17,1:20:46.25,Default,,0,0,0,,«Кэде дауысы»
Dialogue: 0,1:20:46.25,1:20:46.34,Default,,0,0,0,,«Кейде дауысы»
Dialogue: 0,1:20:46.25,1:20:46.34,Default,,0,0,0,,Мен Каедені дұрыстап қорғай алсам ғой.
Dialogue: 0,1:20:46.34,1:20:49.38,Default,,0,0,0,,Мен Каедені дұрыстап қорғай алсам ғой.
Dialogue: 0,1:20:49.46,1:20:51.47,Default,,0,0,0,,Әкеңсіз бәрібір
Dialogue: 0,1:20:51.55,1:20:52.34,Default,,0,0,0,,Иә?
Dialogue: 0,1:20:52.43,1:20:54.85,Default,,0,0,0,,Барнаби деген жаңа батыр келді.
Dialogue: 0,1:20:54.93,1:20:57.14,Default,,0,0,0,,Ол Каэдеге көмектесті!
Dialogue: 0,1:20:57.22,1:21:01.69,Default,,0,0,0,,Бұл өте керемет, мен қазірдің өзінде жанкүйермін!
Dialogue: 0,1:21:03.27,1:21:04.15,Default,,0,0,0,,(Ватару) Не болып жатыр? Бұл әңгіме… (Ер оқушы) Ол ұялы телефонымен дауласып жатыр.
Dialogue: 0,1:21:09.73,1:21:10.90,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,1:21:10.99,1:21:12.53,Default,,0,0,0,,Оны шешудің жеңілдігі жағынан сәл артық
Dialogue: 0,1:21:12.61,1:21:14.20,Default,,0,0,0,,Мен жақсартулар жасауға тырысамын.
Dialogue: 0,1:21:14.74,1:21:15.66,Default,,0,0,0,,Өтінемін
Dialogue: 0,1:21:15.74,1:21:19.16,Default,,0,0,0,,Бірақ сіз костюміңізді шешуді жақсы ойладыңыз.
Dialogue: 0,1:21:19.24,1:21:21.54,Default,,0,0,0,,Жарайды... әйтпесе
Dialogue: 0,1:21:21.62,1:21:22.66,Default,,0,0,0,,Тіпті егер...
Dialogue: 0,1:21:23.50,1:21:26.29,Default,,0,0,0,,Балалар сендер шынымен біртүрлі жұп құрасыңдар.
Dialogue: 0,1:21:26.38,1:21:27.04,Default,,0,0,0,,Иә?
Dialogue: 0,1:21:27.13,1:21:30.09,Default,,0,0,0,,Бұл екі адамның костюмінде түсірілген сурет.
Dialogue: 0,1:21:30.17,1:21:31.17,Default,,0,0,0,,«Ойын»
Dialogue: 0,1:21:33.51,1:21:35.30,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,1:21:35.39,1:21:36.72,Default,,0,0,0,,«Ремсон хот-дог»
Dialogue: 0,1:21:38.05,1:21:40.27,Default,,0,0,0,,(нәзік музыка)
Dialogue: 0,1:21:40.35,1:21:41.39,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,1:21:42.52,1:21:45.06,Default,,0,0,0,,Сіз мені кеше шынымен таң қалдырдыңыз.
Dialogue: 0,1:21:47.40,1:21:48.90,Default,,0,0,0,,Келмеңіз!
Dialogue: 0,1:21:49.48,1:21:53.32,Default,,0,0,0,,Мен қылмыскерді міндетті түрде ұстаймын!
Dialogue: 0,1:21:53.40,1:21:55.99,Default,,0,0,0,,(нәзік музыка)
Dialogue: 0,1:21:57.70,1:22:00.83,Default,,0,0,0,,Сәлем! Жаңадан келгендерге қалағанын жасауға рұқсат беру дұрыс па?
Dialogue: 0,1:22:00.91,1:22:04.04,Default,,0,0,0,,Оның айтқанын тыңдауға ниетім жоқ.
Dialogue: 0,1:22:04.92,1:22:06.54,Default,,0,0,0,,Әдемі ғана дәмді⸺
Dialogue: 0,1:22:06.63,1:22:07.79,Default,,0,0,0,,Олар оны алып кетеді.
Dialogue: 0,1:22:09.13,1:22:11.30,Default,,0,0,0,,(Танжиро) Тұр, тұр! Тоқта, Иносукэ~!
Dialogue: 0,1:22:11.92,1:22:13.80,Default,,0,0,0,,Маған қалдыра аласыз ба?
Dialogue: 0,1:22:18.64,1:22:22.31,Default,,0,0,0,,Жоқ, мен... Мен оның өмірінің үш минутын босқа өткіздім.
Dialogue: 0,1:22:22.39,1:22:24.18,Default,,0,0,0,,Сіз не айтып тұрсыз?
Dialogue: 0,1:22:24.27,1:22:25.06,Default,,0,0,0,,Мен түсінбеймін
Dialogue: 0,1:22:25.14,1:22:26.44,Default,,0,0,0,,Уақыт таусылып барады!
Dialogue: 0,1:22:26.52,1:22:28.98,Default,,0,0,0,,Жабайы-кун (Оригами циклоны) Гозару
Dialogue: 0,1:22:29.06,1:22:31.82,Default,,0,0,0,,Әдеміге қалдырудың себебі бар ма?
Dialogue: 0,1:22:33.15,1:22:34.07,Default,,0,0,0,,Дәлел бар!
Dialogue: 0,1:22:36.28,1:22:37.82,Default,,0,0,0,,Менің... болжамым!
Dialogue: 0,1:22:37.91,1:22:39.41,Default,,0,0,0,,Иә?
Dialogue: 0,1:22:39.91,1:22:44.16,Default,,0,0,0,,Оның мінезінде біраз проблемалар бар... жоқ, оның мінезінде көптеген проблемалар бар.
Dialogue: 0,1:22:44.25,1:22:47.83,Default,,0,0,0,,Қалай болғанда да, олардың дәл қазір қылмыскерді ұстауға тырысып жатқанына сенімдімін!
Dialogue: 0,1:22:48.46,1:22:50.29,Default,,0,0,0,,Мен сені дуэт ретінде бақылаймын!
Dialogue: 0,1:22:51.04,1:22:52.30,Default,,0,0,0,,Бірдеңе болса...
Dialogue: 0,1:22:52.38,1:22:54.71,Default,,0,0,0,,Мен де жауапкершілікті аламын! Сонымен...
Dialogue: 0,1:22:56.30,1:22:57.93,Default,,0,0,0,,Маған қалдырыңыз!
Dialogue: 0,1:22:58.01,1:22:59.68,Default,,0,0,0,,Ха!
Dialogue: 0,1:22:59.76,1:23:03.14,Default,,0,0,0,,(эмоционалды музыка)
Dialogue: 0,1:23:12.98,1:23:15.82,Default,,0,0,0,,Қажетсіз істермен айналыспаңыз
Dialogue: 0,1:23:15.90,1:23:17.40,Default,,0,0,0,,Қажетсіз ештеңе жасамаңыз
Dialogue: 0,1:23:19.99,1:23:24.41,Default,,0,0,0,,Мен қажетсіз ештеңе жасамауға уәде беремін.
Dialogue: 0,1:23:25.08,1:23:26.16,Default,,0,0,0,,Хмф!
Dialogue: 0,1:23:29.54,1:23:30.67,Default,,0,0,0,,Бітті
Dialogue: 0,1:23:33.75,1:23:36.13,Default,,0,0,0,,Робин Бакстерді қорғау
Dialogue: 0,1:23:36.76,1:23:39.05,Default,,0,0,0,,(тыныш музыка)
Dialogue: 0,1:23:46.98,1:23:47.81,Default,,0,0,0,,Фу…
Dialogue: 0,1:23:48.44,1:23:51.60,Default,,0,0,0,,Шынымды айтсам, іштей қобалжыдым.
Dialogue: 0,1:23:51.69,1:23:54.90,Default,,0,0,0,,Жауапкершілікті аламын десем де, қолымнан ештеңе келмейді.
Dialogue: 0,1:23:54.98,1:23:56.32,Default,,0,0,0,,Әй?
Dialogue: 0,1:23:56.40,1:23:58.53,Default,,0,0,0,,(қатты күлу)
Dialogue: 0,1:23:59.40,1:24:02.62,Default,,0,0,0,,Ақырында, мен оны жақсы түсіндім.
Dialogue: 0,1:24:02.70,1:24:05.12,Default,,0,0,0,,Бұл сіздің көретін көзіңіз бар дегенді білдіреді.
Dialogue: 0,1:24:06.12,1:24:08.25,Default,,0,0,0,,«Жабайы жолбарыстың жазылған кадрлары»
Dialogue: 0,1:24:08.33,1:24:10.42,Default,,0,0,0,,Уау! Ой...
Dialogue: 0,1:24:10.50,1:24:11.37,Default,,0,0,0,,(дауыс шуы)
Dialogue: 0,1:24:11.46,1:24:13.29,Default,,0,0,0,,Сәлем! Уайымдама!
Dialogue: 0,1:24:14.67,1:24:17.59,Default,,0,0,0,,Қосымша заттар...
Dialogue: 0,1:24:19.38,1:24:22.18,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,1:24:22.26,1:24:24.80,Default,,0,0,0,,«Әділет мүсіні»
Dialogue: 0,1:24:27.39,1:24:28.31,Default,,0,0,0,,Бұл жәндік емес.
Dialogue: 0,1:24:28.89,1:24:33.44,Default,,0,0,0,,Эфир кезінде ән айта алмай, тырнақтарым тырнап кететін.
Dialogue: 0,1:24:33.52,1:24:35.90,Default,,0,0,0,,Үйге келсем де тітіркенгенім сонша, ұйықтай алмай қалдым.
Dialogue: 0,1:24:35.98,1:24:37.94,Default,,0,0,0,,Түн ортасында балмұздақ жедің!
Dialogue: 0,1:24:38.69,1:24:40.36,Default,,0,0,0,,Сіз мұны айтса да...
Dialogue: 0,1:24:40.45,1:24:42.74,Default,,0,0,0,,Бұл сіздің серіктесіңіз кінәлі!
Dialogue: 0,1:24:42.82,1:24:43.57,Default,,0,0,0,,Рас!
Dialogue: 0,1:24:43.66,1:24:46.24,Default,,0,0,0,,Барлық дәмді тағамды алыңыз!
Dialogue: 0,1:24:46.33,1:24:49.41,Default,,0,0,0,,Жүзің көрікті болса да, Мейірімді болмайынша жұртшылыққа қонбайсың.
Dialogue: 0,1:24:49.50,1:24:52.92,Default,,0,0,0,,Жоқ, мен Батыр академиясында танымал болдым.
Dialogue: 0,1:24:53.58,1:24:55.71,Default,,0,0,0,,Фан-клуб ашылып жатыр⸺\NБұл
Dialogue: 0,1:24:55.79,1:24:58.63,Default,,0,0,0,,туралы болды...
Dialogue: 0,1:24:58.71,1:25:02.01,Default,,0,0,0,,Мен де оны шынымен түсінбеймін.
Dialogue: 0,1:25:02.09,1:25:04.84,Default,,0,0,0,,Ал, бүгін де бәріміз сусын ішейік!
Dialogue: 0,1:25:04.93,1:25:06.22,Default,,0,0,0,,Сәлем! (Карина) Иә?
Dialogue: 0,1:25:06.30,1:25:09.97,Default,,0,0,0,,Қараңдаршы, кешегі құттықтау кеші қызық болмады, солай ма?
Dialogue: 0,1:25:10.06,1:25:12.94,Default,,0,0,0,,Сондықтан бүгін мен сендерді Жабайы жолбарыспен сыйлаймын.
Dialogue: 0,1:25:13.02,1:25:13.73,Default,,0,0,0,,Иә?
Dialogue: 0,1:25:14.35,1:25:17.65,Default,,0,0,0,,Кеше мен сіздің өтінішіңізді тыңдадым.
Dialogue: 0,1:25:17.73,1:25:19.98,Default,,0,0,0,,Қарызыңызды тез арада реттегіңіз келеді.
Dialogue: 0,1:25:20.07,1:25:21.95,Default,,0,0,0,,Сіз қаншалықты итермелейсіз?
Dialogue: 0,1:25:22.03,1:25:24.28,Default,,0,0,0,,Жарайды, егер бұл сыйлық болса, жақсы.
Dialogue: 0,1:25:24.36,1:25:25.24,Default,,0,0,0,,(Нисимура) Цубасаның кеудесі өте үлкен, сондықтан ол жүгіргенде әр жаққа секіріп тұрады.
Dialogue: 0,1:25:25.32,1:25:28.16,Default,,0,0,0,,Жабайы, мен сенің сезіміңді босқа жібере алмаймын.
Dialogue: 0,1:25:28.24,1:25:29.58,Default,,0,0,0,,Барлығы бара жатса, мен де барамын.
Dialogue: 0,1:25:29.66,1:25:30.50,Default,,0,0,0,,Даа!
Dialogue: 0,1:25:31.16,1:25:34.00,Default,,0,0,0,,Мен мисо сорпасын ішетін мейрамханаға барғым келеді.
Dialogue: 0,1:25:34.08,1:25:35.46,Default,,0,0,0,,Білегім мен қолым аман қалғаны, бәлкім,
Dialogue: 0,1:25:36.58,1:25:39.59,Default,,0,0,0,,(мазасыз музыка)
Dialogue: 0,1:25:41.09,1:25:42.97,Default,,0,0,0,,Горилла Ра… Керней
Dialogue: 0,1:25:43.05,1:25:44.59,Default,,0,0,0,,Нан...
Dialogue: 0,1:25:44.68,1:25:45.89,Default,,0,0,0,,Кочи Кокчи
Dialogue: 0,1:25:45.97,1:25:47.22,Default,,0,0,0,,Ой!
Dialogue: 0,1:25:47.30,1:25:48.10,Default,,0,0,0,,Мазасыздық!
Dialogue: 0,1:25:48.18,1:25:52.35,Default,,0,0,0,,Иә! тез!
Dialogue: 0,1:25:54.06,1:25:55.40,Default,,0,0,0,,(Ватару) Не болып жатыр? Бұл әңгіме… (Ер оқушы) Ол ұялы телефонымен дауласып жатыр.
Dialogue: 0,1:25:57.27,1:26:00.28,Default,,0,0,0,,Жарайсыңдар! Томе…
Dialogue: 0,1:26:02.19,1:26:05.86,Default,,0,0,0,,Әзірше... Мен онымен бар күшімді саламын.
Dialogue: 0,1:26:05.95,1:26:07.12,Default,,0,0,0,,«Барнаби 3329 жылы 31 қазанда дүниеге келген»
Dialogue: 0,1:26:07.70,1:26:08.37,Default,,0,0,0,,«Брукс отбасы»
Dialogue: 0,1:26:08.45,1:26:08.70,Default,,0,0,0,,«Барнаби Брукс»
Dialogue: 0,1:26:08.70,1:26:09.08,Default,,0,0,0,,«Барнаби Брукс»
Dialogue: 0,1:26:08.70,1:26:09.08,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,1:26:09.08,1:26:09.16,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,1:26:09.16,1:26:09.70,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,1:26:09.16,1:26:09.70,Default,,0,0,0,,«НК, 4 қараша, 1913 ~»
Dialogue: 0,1:26:09.70,1:26:09.78,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,1:26:09.78,1:26:10.49,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,1:26:09.78,1:26:10.49,Default,,0,0,0,,«24 желтоқсан 1957 жыл»
Dialogue: 0,1:26:11.87,1:26:15.00,Default,,0,0,0,,Мен... Ақыры батыр болдым.
Dialogue: 0,1:26:15.71,1:26:16.92,Default,,0,0,0,,Бұл — бір сәт бұрынғы Итадори ешқашан жасамайтын қимыл
Dialogue: 0,1:26:17.50,1:26:20.92,Default,,0,0,0,,Мен міндетті түрде шындықты табамын
Dialogue: 0,1:26:22.88,1:26:25.63,Default,,0,0,0,,Мен серігім үшін аздап алаңдаймын.
Dialogue: 0,1:26:27.09,1:26:29.39,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,1:26:31.60,1:26:33.27,Default,,0,0,0,,«Котецу Т.Кабураги»
Dialogue: 0,1:26:44.53,1:26:45.28,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,1:26:46.36,1:26:48.99,Default,,0,0,0,,(♪ ~Соңғы тақырып)
Dialogue: 0,1:27:04.17,1:27:06.84,Default,,0,0,0,,♪ Қайталау Сіз әлі де жақсысыз ба?
Dialogue: 0,1:27:06.93,1:27:10.35,Default,,0,0,0,,♪ Бұл тоқтамайды
Dialogue: 0,1:27:10.43,1:27:14.31,Default,,0,0,0,,♪ Неліктен нақты себеп жоқ
Dialogue: 0,1:27:14.39,1:27:17.23,Default,,0,0,0,,♪ Бүгін жетпесе
Dialogue: 0,1:27:17.31,1:27:20.65,Default,,0,0,0,,♪ Мен оны қайтадан алып жүруім керек.
Dialogue: 0,1:27:20.73,1:27:22.61,Default,,0,0,0,,♪ Эй, теңгерімсіз бе?
Dialogue: 0,1:27:22.69,1:27:26.32,Default,,0,0,0,,♪ Түсіну оңай болмаса да
Dialogue: 0,1:27:26.40,1:27:30.24,Default,,0,0,0,,♪ Көпке дейін байқамай
Dialogue: 0,1:27:30.32,1:27:35.29,Default,,0,0,0,,♪ Қайталанатын күрсіністерді өшіру
Dialogue: 0,1:27:35.37,1:27:36.00,Default,,0,0,0,,♪ Яғни⸺
Dialogue: 0,1:27:36.08,1:27:38.37,Default,,0,0,0,,♪ Еліктеушілікке шыдамсыз
Dialogue: 0,1:27:38.46,1:27:41.13,Default,,0,0,0,,♪ Біреудің әділдігімен соқтығыссам да
Dialogue: 0,1:27:41.21,1:27:44.55,Default,,0,0,0,,♪ Жарайды.
Dialogue: 0,1:27:44.63,1:27:49.09,Default,,0,0,0,,♪ Мен өзім болуға рұқсат етіңіз
Dialogue: 0,1:27:50.51,1:27:51.59,Default,,0,0,0,,♪ Мен жалғыз болсам да
Dialogue: 0,1:27:51.68,1:27:55.22,Default,,0,0,0,,♪ Linear Blue тыңдау кезінде
Dialogue: 0,1:27:55.31,1:27:56.77,Default,,0,0,0,,♪ Соңында
Dialogue: 0,1:27:56.85,1:27:58.89,Default,,0,0,0,,♪ Сіз не күтесіз
Dialogue: 0,1:27:58.98,1:28:01.90,Default,,0,0,0,,♪ Мен бұған сенгім келеді.
Dialogue: 0,1:28:01.98,1:28:05.53,Default,,0,0,0,,♪ Бас тартсаң, жете алмайсың
Dialogue: 0,1:28:05.61,1:28:07.78,Default,,0,0,0,,♪ Тарихтағы ең маңыздысы
Dialogue: 0,1:28:07.86,1:28:11.16,Default,,0,0,0,,♪ Өйткені ертең міндетті түрде болады
Dialogue: 0,1:28:11.24,1:28:14.62,Default,,0,0,0,,♪ Бүгін барыңыз, қалағаныңызша әуен
Dialogue: 0,1:28:28.88,1:28:31.72,Default,,0,0,0,,♪ Уонди, құлағанның бәрі
Dialogue: 0,1:28:31.80,1:28:35.18,Default,,0,0,0,,♪ Астрономиялық мүмкіндіктер
Dialogue: 0,1:28:35.26,1:28:37.02,Default,,0,0,0,,♪ О, солай ма?
Dialogue: 0,1:28:37.10,1:28:39.27,Default,,0,0,0,,♪ тривиальды үлкен жарылыс шоуы
Dialogue: 0,1:28:39.35,1:28:42.15,Default,,0,0,0,,♪ Бұл жеткілікті.
Dialogue: 0,1:28:42.23,1:28:45.61,Default,,0,0,0,,♪ Түс көретін уақыт өтсе де
Dialogue: 0,1:28:45.69,1:28:47.65,Default,,0,0,0,,♪ Эй, мен саған көрсетемін.
Dialogue: 0,1:28:47.73,1:28:49.65,Default,,0,0,0,,♪ Келешекте параболаны сал
Dialogue: 0,1:28:49.74,1:28:51.20,Default,,0,0,0,,♪ Лезде көрсетілім
Dialogue: 0,1:28:51.28,1:28:55.03,Default,,0,0,0,,♪ Ешбір ниетсіз немесе мақсатсыз
Dialogue: 0,1:28:55.12,1:28:59.91,Default,,0,0,0,,♪ Жүрегіміздің қосылған сәті
Dialogue: 0,1:29:00.00,1:29:02.83,Default,,0,0,0,,♪ Қозғалыс эмоциялар тоқтамайды
Dialogue: 0,1:29:02.92,1:29:05.42,Default,,0,0,0,,♪ Жауаптың дұрыс емес екенін айтасың ба?
Dialogue: 0,1:29:05.50,1:29:09.42,Default,,0,0,0,,♪ Бірақ бұл менің білгенім емес.
Dialogue: 0,1:29:09.51,1:29:13.13,Default,,0,0,0,,♪ Кім шешті?
Dialogue: 0,1:29:15.26,1:29:16.39,Default,,0,0,0,,♪ Қазір зерігу
Dialogue: 0,1:29:16.47,1:29:19.89,Default,,0,0,0,,♪ Сызықты көк түске боялған
Dialogue: 0,1:29:19.97,1:29:23.60,Default,,0,0,0,,♪ Аспан сиқырына сәл жақынырақ
Dialogue: 0,1:29:23.69,1:29:26.73,Default,,0,0,0,,♪ Мен оны сезінемін. Сен мені ести аласың ба?
Dialogue: 0,1:29:26.81,1:29:30.36,Default,,0,0,0,,♪ Көп ұзамай күн батуы жақындады
Dialogue: 0,1:29:30.44,1:29:33.45,Default,,0,0,0,,♪ Әр адамды бақытты ету
Dialogue: 0,1:29:33.53,1:29:36.03,Default,,0,0,0,,♪ Дәл солай
Dialogue: 0,1:29:36.12,1:29:39.24,Default,,0,0,0,,♪ Бірінен соң бірі әуеде билейді
Dialogue: 0,1:30:00.47,1:30:04.39,Default,,0,0,0,,♪ Бірден болмаса да
Dialogue: 0,1:30:04.48,1:30:06.81,Default,,0,0,0,,♪ Ең соңында
Dialogue: 0,1:30:06.90,1:30:09.61,Default,,0,0,0,,♪ Егер қолым тисе
Dialogue: 0,1:30:09.69,1:30:12.24,Default,,0,0,0,,♪ Кішкене қиыншылық
Dialogue: 0,1:30:12.32,1:30:14.57,Default,,0,0,0,,♪ Құлап кету босқа
Dialogue: 0,1:30:14.65,1:30:16.45,Default,,0,0,0,,♪ Өйткені мен байсалдымын.
Dialogue: 0,1:30:16.53,1:30:18.57,Default,,0,0,0,,♪ Мен байсалдымын.
Dialogue: 0,1:30:18.66,1:30:22.25,Default,,0,0,0,,♪ Бұл жалғыз себеп
Dialogue: 0,1:30:24.37,1:30:25.42,Default,,0,0,0,,♪ Мен жалғыз болсам да
Dialogue: 0,1:30:25.50,1:30:28.00,Default,,0,0,0,,♪ Linear Blue тыңдау кезінде
Dialogue: 0,1:30:29.09,1:30:30.71,Default,,0,0,0,,♪ Соңында
Dialogue: 0,1:30:30.80,1:30:32.76,Default,,0,0,0,,♪ Сіз не күтесіз
Dialogue: 0,1:30:32.84,1:30:35.84,Default,,0,0,0,,♪ Мен бұған сенгім келеді.
Dialogue: 0,1:30:35.93,1:30:39.43,Default,,0,0,0,,♪ Бас тартсаң, жете алмайсың
Dialogue: 0,1:30:39.51,1:30:41.60,Default,,0,0,0,,♪ Тарихтағы ең маңыздысы
Dialogue: 0,1:30:41.68,1:30:44.98,Default,,0,0,0,,♪ Өйткені ертең міндетті түрде болады
Dialogue: 0,1:30:45.06,1:30:47.10,Default,,0,0,0,,♪ Ешқандай ойлануға болмайды.
Dialogue: 0,1:30:47.19,1:30:48.27,Default,,0,0,0,,♪ Өйткені жоқ
Dialogue: 0,1:30:48.35,1:30:51.15,Default,,0,0,0,,♪ Күліп, жарқырай бер
Dialogue: 0,1:30:51.23,1:30:53.32,Default,,0,0,0,,♪ Соңы қайда?
Dialogue: 0,1:30:53.40,1:30:54.78,Default,,0,0,0,,♪ Әлі жоқ
Dialogue: 0,1:30:54.86,1:30:57.95,Default,,0,0,0,,♪ Түні бойы өзіңнен сұра
Dialogue: 0,1:30:58.03,1:31:01.58,Default,,0,0,0,,♪ Бас тартсаң, жете алмайсың
Dialogue: 0,1:31:01.66,1:31:03.91,Default,,0,0,0,,♪ Сол аспанда
Dialogue: 0,1:31:04.00,1:31:08.12,Default,,0,0,0,,♪ Өйткені сіз күтіп отырсыз
Dialogue: 0,1:31:08.21,1:31:10.46,Default,,0,0,0,,♪ Мен сенімен ойнағым келеді
Dialogue: 0,1:31:10.54,1:31:12.92,Default,,0,0,0,,♪ Енді бүгінгі күнді қалағаныңызша жалғастырыңыз
Dialogue: 0,1:31:13.00,1:31:14.30,Default,,0,0,0,,♪ Әуен
Dialogue: 0,1:31:34.86,1:31:36.94,Default,,0,0,0,,(Соңғы тақырып ~ ♪ )
