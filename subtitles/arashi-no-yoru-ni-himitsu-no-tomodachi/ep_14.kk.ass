Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:02:53.30,0:02:57.67,Default,,0000,0000,0000,,<Екеуі боранды түнде кездесті.
Dialogue: 0,0:02:57.67,0:03:01.71,Default,,0000,0000,0000,,Көрісе алмай дос болып кеттік
Dialogue: 0,0:03:01.71,0:03:04.57,Default,,0000,0000,0000,,Қайта кездесуге уәде беріңіз
Dialogue: 0,0:03:04.57,0:03:08.44,Default,,0000,0000,0000,,Құпия сөзді ауыстырғаннан кейін «Дауылға байланысты».
Dialogue: 0,0:03:08.44,0:03:12.48,Default,,0000,0000,0000,,Бірі – ешкі сүйіп жейтін қасқыр.
Dialogue: 0,0:03:12.48,0:03:17.37,Default,,0000,0000,0000,,Бірі қасқырдан қашпаса жейтін ешкі еді.
Dialogue: 0,0:03:17.37,0:03:22.59,Default,,0000,0000,0000,,Бірақ Габу мен Мэй дос болып кетті>
Dialogue: 0,0:03:22.59,0:03:28.65,Default,,0000,0000,0000,,«Хуруру хуруру – мен желмін»
Dialogue: 0,0:03:28.65,0:03:34.04,Default,,0000,0000,0000,,«Хуруру хуруру, тіпті сіз оны көрмесеңіз де»
Dialogue: 0,0:03:34.04,0:03:40.59,Default,,0000,0000,0000,,«Хуруру хуруру – мен желмін»
Dialogue: 0,0:03:40.59,0:03:44.59,Default,,0000,0000,0000,,«Хюруру, мен әрқашан сенің жаныңдамын».
Dialogue: 0,0:03:47.17,0:03:49.52,Default,,0000,0000,0000,,Габ!
Dialogue: 0,0:03:49.52,0:03:52.05,Default,,0000,0000,0000,,Бұл қасқырдың иісі.
Dialogue: 0,0:03:52.05,0:03:54.05,Default,,0000,0000,0000,,Жасыру! иә!
Dialogue: 0,0:03:59.95,0:04:16.46,Default,,0000,0000,0000,,～
Dialogue: 0,0:04:16.46,0:04:19.83,Default,,0000,0000,0000,,Қазір бәрі жақсы. Мен кеттім де өлдім.
Dialogue: 0,0:04:19.83,0:04:23.19,Default,,0000,0000,0000,,Жақсы. Фу~.
Dialogue: 0,0:04:23.19,0:04:27.90,Default,,0000,0000,0000,,Мен таң қалдым.
Dialogue: 0,0:04:27.90,0:04:29.92,Default,,0000,0000,0000,,Мен олардың мұндай жерге келеді деп күткен жоқпын→
Dialogue: 0,0:04:29.92,0:04:31.44,Default,,0000,0000,0000,,Мен олай ойламадым.
Dialogue: 0,0:04:31.44,0:04:33.96,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:04:33.96,0:04:37.16,Default,,0000,0000,0000,,Әй, Ғабу. Неге бұлай істеп жатырсың?
Dialogue: 0,0:04:37.16,0:04:40.86,Default,,0000,0000,0000,,Ғабу менімен неге кездесіп жүр?
Dialogue: 0,0:04:40.86,0:04:42.55,Default,,0000,0000,0000,,Иә, иә! ?
Dialogue: 0,0:04:42.55,0:04:48.78,Default,,0000,0000,0000,,Қашып, тығылуда көп қиналамыз.
Dialogue: 0,0:04:48.78,0:04:51.80,Default,,0000,0000,0000,,Бұл рас.
Dialogue: 0,0:04:51.80,0:04:54.34,Default,,0000,0000,0000,,Қиын болса, неге кездесеміз?
Dialogue: 0,0:04:54.34,0:04:58.38,Default,,0000,0000,0000,,Неліктен? Эй, неге?
Dialogue: 0,0:04:58.38,0:05:03.43,Default,,0000,0000,0000,,Не? Аа, дұрыс...
Dialogue: 0,0:05:03.43,0:05:05.78,Default,,0000,0000,0000,,Мен сені көргім келеді.
Dialogue: 0,0:05:05.78,0:05:08.14,Default,,0000,0000,0000,,Менімен неге кездескің келеді?
Dialogue: 0,0:05:08.14,0:05:14.04,Default,,0000,0000,0000,,А, міне, солай...
Dialogue: 0,0:05:14.04,0:05:19.92,Default,,0000,0000,0000,,Меймен кездесу әрқашан қызық, солай ма?
Dialogue: 0,0:05:19.92,0:05:22.62,Default,,0000,0000,0000,,Бұл қызық болғандықтан ба? Хмм.
Dialogue: 0,0:05:22.62,0:05:25.15,Default,,0000,0000,0000,,Хмм? А, не?
Dialogue: 0,0:05:25.15,0:05:27.67,Default,,0000,0000,0000,,Иә? Мен туралы бірдеңе→
Dialogue: 0,0:05:27.67,0:05:31.37,Default,,0000,0000,0000,,Мен жаман нәрсе айттым ба? жоқ.
Dialogue: 0,0:05:31.37,0:05:33.37,Default,,0000,0000,0000,,Эй...
Dialogue: 0,0:05:36.59,0:05:39.96,Default,,0000,0000,0000,,Сондықтан, егер Урарака ханым алғашқы қадамды жасаса…
Dialogue: 0,0:05:39.96,0:05:41.96,Default,,0000,0000,0000,,Ахх.
Dialogue: 0,0:05:52.42,0:05:56.29,Default,,0000,0000,0000,,《Мм... Көңілді болғандықтан кездесеміз дедім→
Dialogue: 0,0:05:56.29,0:05:59.15,Default,,0000,0000,0000,,Мен де солай істеймін.
Dialogue: 0,0:05:59.15,0:06:02.85,Default,,0000,0000,0000,,Онда қызық болмаса→
Dialogue: 0,0:06:02.85,0:06:05.55,Default,,0000,0000,0000,,Бұл мені көргің келмейтінін білдіре ме? 》
Dialogue: 0,0:06:05.55,0:06:10.26,Default,,0000,0000,0000,,Сіз осында болдыңыз ба? Әй, әже.
Dialogue: 0,0:06:10.26,0:06:12.62,Default,,0000,0000,0000,,Енді ұйықтайтын уақыт келді.
Dialogue: 0,0:06:12.62,0:06:15.81,Default,,0000,0000,0000,,Мен әлі ұйықтаған жоқпын.
Dialogue: 0,0:06:15.81,0:06:20.19,Default,,0000,0000,0000,,Ертең біз Мезомесо тауына шығамыз.
Dialogue: 0,0:06:20.19,0:06:22.55,Default,,0000,0000,0000,,Иә! ? Мезомесо тауы?
Dialogue: 0,0:06:22.55,0:06:25.75,Default,,0000,0000,0000,,Ол жерде дәмді оксалис көп өседі дейді.
Dialogue: 0,0:06:25.75,0:06:29.78,Default,,0000,0000,0000,,Мезомесо тауы? Бұл дұрыс.
Dialogue: 0,0:06:29.78,0:06:31.47,Default,,0000,0000,0000,,Уау! Мен оны істедім!
Dialogue: 0,0:06:31.47,0:06:34.47,Default,,0000,0000,0000,,Қайырлы түн. қайырлы түн.
Dialogue: 0,0:06:38.87,0:06:40.73,Default,,0000,0000,0000,,Әже.
Dialogue: 0,0:06:40.73,0:06:43.59,Default,,0000,0000,0000,,Тез кеттік, әже.
Dialogue: 0,0:06:43.59,0:06:45.59,Default,,0000,0000,0000,,Иә, иә.
Dialogue: 0,0:06:48.48,0:06:50.33,Default,,0000,0000,0000,,Мынау, Мэй Чан.
Dialogue: 0,0:06:50.33,0:06:52.35,Default,,0000,0000,0000,,Не? Әже.
Dialogue: 0,0:06:52.35,0:06:55.72,Default,,0000,0000,0000,,Сонша жүгірсең, шаршайсың.
Dialogue: 0,0:06:55.72,0:06:58.72,Default,,0000,0000,0000,,Себебі мен бақыттымын.
Dialogue: 0,0:07:04.13,0:07:07.67,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:07:07.67,0:07:09.67,Default,,0000,0000,0000,,Уау! а….
Dialogue: 0,0:07:13.39,0:07:17.94,Default,,0000,0000,0000,,Артқа қарама, алға қара Мамыр.
Dialogue: 0,0:07:17.94,0:07:20.96,Default,,0000,0000,0000,,Не, бұрын?
Dialogue: 0,0:07:20.96,0:07:22.65,Default,,0000,0000,0000,,Иә, мамыр.
Dialogue: 0,0:07:22.65,0:07:26.18,Default,,0000,0000,0000,,Құлап кеткің келсе, алға қара.
Dialogue: 0,0:07:26.18,0:07:30.90,Default,,0000,0000,0000,,Сонда қуат табиғи түрде алдыңғы аяқтарға келеді.
Dialogue: 0,0:07:30.90,0:07:33.90,Default,,0000,0000,0000,,Алға қара...
Dialogue: 0,0:07:38.98,0:07:41.98,Default,,0000,0000,0000,,Жарайды, Мамыр, болды.
Dialogue: 0,0:07:55.81,0:07:59.85,Default,,0000,0000,0000,,Ой~!
Dialogue: 0,0:07:59.85,0:08:01.87,Default,,0000,0000,0000,,Ухухуху.
Dialogue: 0,0:08:01.87,0:08:06.59,Default,,0000,0000,0000,,Уау Ахахахха!
Dialogue: 0,0:08:06.59,0:08:09.95,Default,,0000,0000,0000,,Түскі асты ішіп болған соң, біраз ұйықтадым.
Dialogue: 0,0:08:09.95,0:08:14.84,Default,,0000,0000,0000,,Таудан түсіп бара жатқанда шаршайсың.
Dialogue: 0,0:08:14.84,0:08:16.84,Default,,0000,0000,0000,,Иә, әже.
Dialogue: 0,0:08:18.38,0:08:21.40,Default,,0000,0000,0000,,Хмм, дәмді!
Dialogue: 0,0:08:21.40,0:08:23.40,Default,,0000,0000,0000,,Ахахаха мен көрдім.
Dialogue: 0,0:08:31.34,0:08:34.37,Default,,0000,0000,0000,,Мм... Ах!
Dialogue: 0,0:08:34.37,0:08:37.23,Default,,0000,0000,0000,,Эй, сен ояндың.
Dialogue: 0,0:08:37.23,0:08:43.96,Default,,0000,0000,0000,,Үйге барар алдында мен Парапарахараға біраз тоқтаймын.
Dialogue: 0,0:08:43.96,0:08:45.98,Default,,0000,0000,0000,,Мұны маған жеткізіңіз.
Dialogue: 0,0:08:45.98,0:08:49.02,Default,,0000,0000,0000,,Парапарахара! ? Қазір барасың ба?
Dialogue: 0,0:08:49.02,0:08:55.41,Default,,0000,0000,0000,,Біз жолда Куракура орманындағы үңгірде ұйықтаймыз, содан кейін таңертең жолға шығамыз.
Dialogue: 0,0:08:55.41,0:08:58.94,Default,,0000,0000,0000,,Сені қара ешкі күтіп тұр.
Dialogue: 0,0:08:58.94,0:09:03.99,Default,,0000,0000,0000,,《Не істеуім керек... Мен ертең Кабумен кездесуге уәде бердім.
Dialogue: 0,0:09:03.99,0:09:06.69,Default,,0000,0000,0000,,Бірақ мен олай айта алмаймын.
Dialogue: 0,0:09:06.69,0:09:09.72,Default,,0000,0000,0000,,Жақсы ату! Ах хаха.
Dialogue: 0,0:09:09.72,0:09:12.75,Default,,0000,0000,0000,,Кеттік, мамыр.
Dialogue: 0,0:09:12.75,0:09:16.75,Default,,0000,0000,0000,,А... күте тұрыңыз, әже.
Dialogue: 0,0:09:30.76,0:09:33.63,Default,,0000,0000,0000,,Ах! Хокудами гүлдері.
Dialogue: 0,0:09:33.63,0:09:35.65,Default,,0000,0000,0000,,Әдемі!
Dialogue: 0,0:09:35.65,0:09:38.51,Default,,0000,0000,0000,,Хмм!
Dialogue: 0,0:09:38.51,0:09:41.87,Default,,0000,0000,0000,,Бұл жақсы үңгір.
Dialogue: 0,0:09:41.87,0:09:44.40,Default,,0000,0000,0000,,Бұл жерде мүлдем қауіпсіз.
Dialogue: 0,0:09:44.40,0:09:48.11,Default,,0000,0000,0000,,Мұны маған әжемнің досы баяғыда айтқан болатын.
Dialogue: 0,0:09:48.11,0:09:50.63,Default,,0000,0000,0000,,Иә! ? Дос па?
Dialogue: 0,0:09:50.63,0:09:55.51,Default,,0000,0000,0000,,Иә. Әжесі Мэйдің жасында еді.
Dialogue: 0,0:09:55.51,0:10:00.51,Default,,0000,0000,0000,,Мен тобыммен бірге осы орманда болдым, бірақ бөлініп кеттім...
Dialogue: 0,0:10:05.78,0:10:09.31,Default,,0000,0000,0000,,Не істеуім керек... Қараңғы түсті.
Dialogue: 0,0:10:09.31,0:10:13.69,Default,,0000,0000,0000,,Бұл қайда? (шу)
Dialogue: 0,0:10:13.69,0:10:15.88,Default,,0000,0000,0000,,Сіз адасып қалдыңыз ба?
Dialogue: 0,0:10:15.88,0:10:17.90,Default,,0000,0000,0000,,Кім?
Dialogue: 0,0:10:17.90,0:10:23.46,Default,,0000,0000,0000,,Керемет, сен де ешкісің. Мен иісінен айта аламын.
Dialogue: 0,0:10:23.46,0:10:25.15,Default,,0000,0000,0000,,Иә. Ол да сен сияқты ешкі.
Dialogue: 0,0:10:25.15,0:10:28.17,Default,,0000,0000,0000,,Бұл жерде қараңғы және қауіпті.
Dialogue: 0,0:10:28.17,0:10:31.54,Default,,0000,0000,0000,,Жақын жерде қауіпсіз үңгір бар. Мен саған айналаны көрсетемін.
Dialogue: 0,0:10:31.54,0:10:33.54,Default,,0000,0000,0000,,Рахмет.
Dialogue: 0,0:10:38.11,0:10:41.80,Default,,0000,0000,0000,,Бұл осында.
Dialogue: 0,0:10:41.80,0:10:45.68,Default,,0000,0000,0000,,Бұл хокудами гүлдерінің иісі.
Dialogue: 0,0:10:45.68,0:10:50.06,Default,,0000,0000,0000,,Иә. Осы иістің арқасында қасқырлар сені таба алмайды.
Dialogue: 0,0:10:50.06,0:10:53.92,Default,,0000,0000,0000,,Таңға дейін осында тығылғанша, жақсы боласыз.
Dialogue: 0,0:10:53.92,0:10:57.80,Default,,0000,0000,0000,,Қалай таңға дейін қара үңгірде тығыласың?
Dialogue: 0,0:10:57.80,0:11:01.34,Default,,0000,0000,0000,,Мен мұны жалғыз жасауға қорқатын едім.
Dialogue: 0,0:11:01.34,0:11:05.21,Default,,0000,0000,0000,,Өйткені бала менімен бірге болды.
Dialogue: 0,0:11:05.21,0:11:08.74,Default,,0000,0000,0000,,Әр түрлі тақырыпта әңгімелесу қызықты болды.
Dialogue: 0,0:11:08.74,0:11:14.80,Default,,0000,0000,0000,,Ақырында ұйқым келіп, біраз ұйықтап қалдым да, ояндым.
Dialogue: 0,0:11:14.80,0:11:18.84,Default,,0000,0000,0000,,Бала енді ол жерде болмады.
Dialogue: 0,0:11:18.84,0:11:22.21,Default,,0000,0000,0000,,Не? Таңертеңгі күн енді ғана жарқырай бастады
Dialogue: 0,0:11:22.21,0:11:24.40,Default,,0000,0000,0000,,Бұл күңгірт жарықта болды.
Dialogue: 0,0:11:24.40,0:11:27.40,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:11:34.67,0:11:41.24,Default,,0000,0000,0000,,Қап-қара түнде мүлде байқамадым.
Dialogue: 0,0:11:41.24,0:11:46.24,Default,,0000,0000,0000,,Бала қара ешкі еді.
Dialogue: 0,0:11:48.47,0:11:51.33,Default,,0000,0000,0000,,Иә? Қара ешкі болды ма?
Dialogue: 0,0:11:51.33,0:11:54.03,Default,,0000,0000,0000,,Бала кезімде қазіргіден басқаша болды.
Dialogue: 0,0:11:54.03,0:11:59.75,Default,,0000,0000,0000,,Ақ ешкі мен қара ешкінің арасы жараспады.
Dialogue: 0,0:11:59.75,0:12:02.95,Default,,0000,0000,0000,,Дұрыс! Қараңғы, әжесі ақ ешкі дейді
Dialogue: 0,0:12:02.95,0:12:04.14,Default,,0000,0000,0000,,Мен түсінбедім.
Dialogue: 0,0:12:04.14,0:12:07.50,Default,,0000,0000,0000,,Кейін талай рет өкіндім.
Dialogue: 0,0:12:07.50,0:12:11.71,Default,,0000,0000,0000,,Рахмет, қош бол деген жоқпын.
Dialogue: 0,0:12:11.71,0:12:16.59,Default,,0000,0000,0000,,Мен сені неге сол кезде қудым?
Dialogue: 0,0:12:16.59,0:12:20.59,Default,,0000,0000,0000,,Бірдеңе айтуға батылым жетпеді ме?
Dialogue: 0,0:12:26.69,0:12:30.56,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:12:30.56,0:12:32.58,Default,,0000,0000,0000,,Біреу келді ме?
Dialogue: 0,0:12:32.58,0:12:34.77,Default,,0000,0000,0000,,Ах…. 《Тұяқтардың дыбысы! ?
Dialogue: 0,0:12:34.77,0:12:38.47,Default,,0000,0000,0000,,Керемет... бұл ешкі》
Dialogue: 0,0:12:38.47,0:12:44.04,Default,,0000,0000,0000,,Эй, сені біреу емдеді ме? Хахаха бұл жігіт дөрекі болды.
Dialogue: 0,0:12:44.04,0:12:47.73,Default,,0000,0000,0000,,Қап қараңғы, мен байқамай қалдым.
Dialogue: 0,0:12:47.73,0:12:52.28,Default,,0000,0000,0000,,《Біз бір-біріміздің шынайы болмысымызды білмей, қараңғы түнде кездестік.
Dialogue: 0,0:12:52.28,0:12:55.64,Default,,0000,0000,0000,,әжемен бірдей.
Dialogue: 0,0:12:55.64,0:12:58.84,Default,,0000,0000,0000,,Бірақ Ғабу екеуміз басқамыз.
Dialogue: 0,0:12:58.84,0:13:02.04,Default,,0000,0000,0000,,Қасқыр мен ешкі екенін білгеннен кейін де.
Dialogue: 0,0:13:02.04,0:13:05.24,Default,,0000,0000,0000,,Біз мәңгі доспыз》
Dialogue: 0,0:13:05.24,0:13:08.44,Default,,0000,0000,0000,,Хахаха! Хмм!
Dialogue: 0,0:13:08.44,0:13:11.44,Default,,0000,0000,0000,,Няха... хаха!
Dialogue: 0,0:14:57.70,0:14:59.70,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:15:04.93,0:15:07.30,Default,,0000,0000,0000,,《Әже демалып жатыр.
Dialogue: 0,0:15:07.30,0:15:14.03,Default,,0000,0000,0000,,Мен қара ешкілерді қарсы алғым келеді, бірақ тезірек оралуым керек.
Dialogue: 0,0:15:14.03,0:15:19.24,Default,,0000,0000,0000,,Келме. Ақыр соңында, келме!
Dialogue: 0,0:15:19.24,0:15:23.79,Default,,0000,0000,0000,,Бұл оның келмейтінін білдіре ме?
Dialogue: 0,0:15:23.79,0:15:27.33,Default,,0000,0000,0000,,《Мен Ғабумен кездесе алмаймын. Жақсы! 》
Dialogue: 0,0:15:27.33,0:15:30.02,Default,,0000,0000,0000,,Әже, тезірек барайық!
Dialogue: 0,0:15:30.02,0:15:33.02,Default,,0000,0000,0000,,Ендеше, оның мәні неде?
Dialogue: 0,0:15:35.24,0:15:40.29,Default,,0000,0000,0000,,Әдемі келбет тек өзің үшін емес.
Dialogue: 0,0:15:40.29,0:15:45.01,Default,,0000,0000,0000,,Барлығы үшін Бұл екеуміз үшін де маңызды.
Dialogue: 0,0:15:45.01,0:15:48.21,Default,,0000,0000,0000,,Өзім үшін бе, әлде барлығы үшін бе?
Dialogue: 0,0:15:48.21,0:15:54.10,Default,,0000,0000,0000,,Егер сіз оны дұрыс тазаласаңыз, өзіңізді сергек сезінесіз, солай емес пе?
Dialogue: 0,0:15:54.10,0:15:59.82,Default,,0000,0000,0000,,Сонымен қатар, сіздің сыртқы келбетіңіз барлығына көрінетін нәрсе.
Dialogue: 0,0:15:59.82,0:16:04.20,Default,,0000,0000,0000,,Таза ұстамасаң дөрекі болады.
Dialogue: 0,0:16:04.20,0:16:06.20,Default,,0000,0000,0000,,Иә! о иә.
Dialogue: 0,0:16:09.24,0:16:12.78,Default,,0000,0000,0000,,(сыбырлау)
Dialogue: 0,0:16:12.78,0:16:15.14,Default,,0000,0000,0000,,Көңілді көрінеді, әже!
Dialogue: 0,0:16:15.14,0:16:18.50,Default,,0000,0000,0000,,Бұл қызық!
Dialogue: 0,0:16:18.50,0:16:22.04,Default,,0000,0000,0000,,Қара ешкіге биыл тағы да барамын деп үміттенемін.
Dialogue: 0,0:16:22.04,0:16:24.89,Default,,0000,0000,0000,,Өйткені мұны жасауға болады.
Dialogue: 0,0:16:24.89,0:16:26.08,Default,,0000,0000,0000,,Бірақ мен сенбеймін!
Dialogue: 0,0:16:26.08,0:16:30.08,Default,,0000,0000,0000,,Қара ешкі мен ақ ешкі жараспады.
Dialogue: 0,0:16:32.81,0:16:35.17,Default,,0000,0000,0000,,Біз қазір өте жақын болсақ та.
Dialogue: 0,0:16:35.17,0:16:38.70,Default,,0000,0000,0000,,Бала кезімде әжемдікі
Dialogue: 0,0:16:38.70,0:16:40.56,Default,,0000,0000,0000,,Мен әжемнен сұрадым.
Dialogue: 0,0:16:40.56,0:16:46.78,Default,,0000,0000,0000,,Ертеде адамдар тамақ пен су үшін жарысқан.
Dialogue: 0,0:16:46.78,0:16:49.14,Default,,0000,0000,0000,,Олар таласып, төбелесіп жатқан сияқты.
Dialogue: 0,0:16:49.14,0:16:53.85,Default,,0000,0000,0000,,-де мен мұны тоқтатуды шештім.
Dialogue: 0,0:16:53.85,0:16:56.88,Default,,0000,0000,0000,,Қара ешкі ауылының қазіргі ақсақалы.
Dialogue: 0,0:16:56.88,0:16:58.07,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:16:58.07,0:17:03.46,Default,,0000,0000,0000,,Төбелесті тоқтат, қара ешкі мен ақ ешкі, бір-бірімізге көмектесейік.
Dialogue: 0,0:17:03.46,0:17:09.35,Default,,0000,0000,0000,,Соның арқасында қара ешкі мен ақ ешкі дос болды.
Dialogue: 0,0:17:09.35,0:17:13.05,Default,,0000,0000,0000,,Ей, керемет екен, ақсақал мырза!
Dialogue: 0,0:17:13.05,0:17:19.94,Default,,0000,0000,0000,,Ақсақал-сан Мезомесо тауындағы оксалисті жақсы көреді.
Dialogue: 0,0:17:19.94,0:17:21.96,Default,,0000,0000,0000,,Қайдасың!
Dialogue: 0,0:17:21.96,0:17:23.16,Default,,0000,0000,0000,,Мен оны арқама салып алып жүремін! бәрі жақсы.
Dialogue: 0,0:17:23.16,0:17:27.03,Default,,0000,0000,0000,,Ауыр емес пе? Менің арқам кеңірек.
Dialogue: 0,0:17:27.03,0:17:32.74,Default,,0000,0000,0000,,Дұрыс! Фуфуфу!
Dialogue: 0,0:17:32.74,0:17:34.43,Default,,0000,0000,0000,,Иә? Әже.
Dialogue: 0,0:17:34.43,0:17:36.95,Default,,0000,0000,0000,,Ахахаха….
Dialogue: 0,0:17:36.95,0:17:41.00,Default,,0000,0000,0000,,Мезомесо тауына келгенде, ол өте жақын, солай емес пе?
Dialogue: 0,0:17:41.00,0:17:43.00,Default,,0000,0000,0000,,Не? иә?
Dialogue: 0,0:17:46.88,0:17:50.75,Default,,0000,0000,0000,,Керемет! Бұл жақын болды ма?
Dialogue: 0,0:17:50.75,0:17:53.45,Default,,0000,0000,0000,,Уфуфуфуфу….
Dialogue: 0,0:17:53.45,0:17:55.45,Default,,0000,0000,0000,,Сол үңгір...
Dialogue: 0,0:17:59.01,0:18:02.54,Default,,0000,0000,0000,,Мынаны да же, Мэй Чан. рақмет сізге.
Dialogue: 0,0:18:02.54,0:18:04.06,Default,,0000,0000,0000,,Жоқ. Қош келдіңіз.
Dialogue: 0,0:18:04.06,0:18:07.92,Default,,0000,0000,0000,,Оны саған Мэй Чанның әжесі жеткізеді.
Dialogue: 0,0:18:07.92,0:18:09.11,Default,,0000,0000,0000,,Мезомесо тауы оксалис болып табылады
Dialogue: 0,0:18:09.11,0:18:12.14,Default,,0000,0000,0000,,Әркім жыл сайын оны асыға күтеді.
Dialogue: 0,0:18:12.14,0:18:15.84,Default,,0000,0000,0000,,Жыл сайын? Хмм.
Dialogue: 0,0:18:15.84,0:18:19.88,Default,,0000,0000,0000,,《Әже, мен мұнда жыл сайын келемін.
Dialogue: 0,0:18:19.88,0:18:22.91,Default,,0000,0000,0000,,Сіз кеше айтқан бала
Dialogue: 0,0:18:22.91,0:18:26.91,Default,,0000,0000,0000,,Мен сіздің осында екеніңізге сенімдімін, солай ма? 》
Dialogue: 0,0:18:28.97,0:18:30.82,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:18:30.82,0:18:36.04,Default,,0000,0000,0000,,《Мен әжеммен құрдас едім.
Dialogue: 0,0:18:36.04,0:18:40.76,Default,,0000,0000,0000,,Әсіресе жақсы араласатын адам...》
Dialogue: 0,0:18:40.76,0:18:45.14,Default,,0000,0000,0000,,Иә? Хмм….
Dialogue: 0,0:18:45.14,0:18:47.14,Default,,0000,0000,0000,,Онда жоқ.
Dialogue: 0,0:18:56.08,0:18:58.11,Default,,0000,0000,0000,,Келесі жылы кездескенше.
Dialogue: 0,0:18:58.11,0:19:01.30,Default,,0000,0000,0000,,Мен оны асыға күтемін.
Dialogue: 0,0:19:01.30,0:19:04.16,Default,,0000,0000,0000,,Абайлаңыз. рақмет сізге.
Dialogue: 0,0:19:04.16,0:19:06.52,Default,,0000,0000,0000,,Жұмысыңыз жақсы деп үміттенемін.
Dialogue: 0,0:19:06.52,0:19:09.04,Default,,0000,0000,0000,,Келесі жылы кездескенше.
Dialogue: 0,0:19:09.04,0:19:10.73,Default,,0000,0000,0000,,Жақында кездескенше, Мэй Чан.
Dialogue: 0,0:19:10.73,0:19:12.73,Default,,0000,0000,0000,,Иә, кездескенше.
Dialogue: 0,0:19:20.99,0:19:22.99,Default,,0000,0000,0000,,Қош бол. қош бол.
Dialogue: 0,0:19:37.65,0:19:39.65,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:19:43.05,0:19:45.05,Default,,0000,0000,0000,,Ақсақал.
Dialogue: 0,0:19:47.42,0:19:49.42,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:19:52.81,0:19:55.67,Default,,0000,0000,0000,,Иә, әже, кеттік!
Dialogue: 0,0:19:55.67,0:19:57.67,Default,,0000,0000,0000,,Үйге қайтайық.
Dialogue: 0,0:20:02.91,0:20:06.12,Default,,0000,0000,0000,,《Кешіріңіз, әже, асығыңыз...》
Dialogue: 0,0:20:06.12,0:20:08.12,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:20:19.24,0:20:22.24,Default,,0000,0000,0000,,Әй, әже...
Dialogue: 0,0:20:41.29,0:20:43.32,Default,,0000,0000,0000,,《Кеш болды.
Dialogue: 0,0:20:43.32,0:20:45.32,Default,,0000,0000,0000,,Ғабу, сен үйге кетіп қалдың.
Dialogue: 0,0:20:53.59,0:20:55.59,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:21:03.35,0:21:08.90,Default,,0000,0000,0000,,Габ! Әй, мамыр.
Dialogue: 0,0:21:08.90,0:21:11.43,Default,,0000,0000,0000,,О, Ғаб! мамыр!
Dialogue: 0,0:21:11.43,0:21:14.43,Default,,0000,0000,0000,,Ғабу! мамыр!
Dialogue: 0,0:21:16.82,0:21:19.34,Default,,0000,0000,0000,,Не? Кешіріңіз.
Dialogue: 0,0:21:19.34,0:21:23.21,Default,,0000,0000,0000,,Кешіріңіз, мен әжемнің қасында болдым.
Dialogue: 0,0:21:23.21,0:21:25.90,Default,,0000,0000,0000,,Мен жаңа ғана оралдым.
Dialogue: 0,0:21:25.90,0:21:27.42,Default,,0000,0000,0000,,ше? Иә иә.
Dialogue: 0,0:21:27.42,0:21:30.45,Default,,0000,0000,0000,,Иә, түсінемін. Бұл тамаша.
Dialogue: 0,0:21:30.45,0:21:32.65,Default,,0000,0000,0000,,Жақсы болды ма? Сіз ашулы емессіз бе?
Dialogue: 0,0:21:32.65,0:21:36.52,Default,,0000,0000,0000,,Мен сені көп күттірдім.
Dialogue: 0,0:21:36.52,0:21:39.87,Default,,0000,0000,0000,,Ашуланба!
Dialogue: 0,0:21:39.87,0:21:41.07,Default,,0000,0000,0000,,Мэйге бірдеңе болған шығар→
Dialogue: 0,0:21:41.07,0:21:44.42,Default,,0000,0000,0000,,Мазасыз нәрсе болған болуы керек →
Dialogue: 0,0:21:44.42,0:21:48.47,Default,,0000,0000,0000,,Мен сені жарақаттап алған шығарсың ба деп қорықтым.
Dialogue: 0,0:21:48.47,0:21:50.49,Default,,0000,0000,0000,,Сіздің қауіпсіз болғаныңызға өте қуаныштымын.
Dialogue: 0,0:21:50.49,0:21:54.03,Default,,0000,0000,0000,,Әй, рахмет саған Ғабу!
Dialogue: 0,0:21:54.03,0:21:57.39,Default,,0000,0000,0000,,Ой, мен қатты ұялып тұрмын.
Dialogue: 0,0:21:57.39,0:22:01.26,Default,,0000,0000,0000,,Хахаха мамыр Күн батып бара жатыр.
Dialogue: 0,0:22:01.26,0:22:03.78,Default,,0000,0000,0000,,Эй, мен сені сонда жіберемін.
Dialogue: 0,0:22:03.78,0:22:05.78,Default,,0000,0000,0000,,Уху Рахмет.
Dialogue: 0,0:22:07.82,0:22:10.35,Default,,0000,0000,0000,,Сәлем Ғабу. Неліктен?
Dialogue: 0,0:22:10.35,0:22:14.23,Default,,0000,0000,0000,,Қызық болмаса да, менімен кездесесің бе?
Dialogue: 0,0:22:14.23,0:22:18.10,Default,,0000,0000,0000,,Иә? Тіпті қызық болмаса да?
Dialogue: 0,0:22:18.10,0:22:22.31,Default,,0000,0000,0000,,Мысалы, ұрыс...
Dialogue: 0,0:22:22.31,0:22:25.84,Default,,0000,0000,0000,,Мен мүмкіндігінше ұрысудан аулақ болғым келеді.
Dialogue: 0,0:22:25.84,0:22:30.05,Default,,0000,0000,0000,,Кездесіп қалсақ та, міндетті түрде ұрысып қалатын болсақ та, кездесеміз.
Dialogue: 0,0:22:30.05,0:22:32.07,Default,,0000,0000,0000,,Иә? Шынымен! ?
Dialogue: 0,0:22:32.07,0:22:35.27,Default,,0000,0000,0000,,Әрине. Неліктен?
Dialogue: 0,0:22:35.27,0:22:39.98,Default,,0000,0000,0000,,Сізге тек макияж жасау керек. сурет?
Dialogue: 0,0:22:39.98,0:22:42.01,Default,,0000,0000,0000,,Хахаха Сонда не?
Dialogue: 0,0:22:42.01,0:22:45.01,Default,,0000,0000,0000,,Иә... иә!
Dialogue: 0,0:22:46.72,0:22:48.57,Default,,0000,0000,0000,,Сонда кездескенше.
Dialogue: 0,0:22:48.57,0:22:50.76,Default,,0000,0000,0000,,Үйге бара жатқанда абай болыңыз.
Dialogue: 0,0:22:50.76,0:22:54.76,Default,,0000,0000,0000,,Иә, сау болыңыз. Сау бол.
Dialogue: 0,0:23:01.69,0:23:03.69,Default,,0000,0000,0000,,М-м-мұнда… мұнда… мұнда… осы зат!
Dialogue: 0,0:23:11.97,0:23:15.00,Default,,0000,0000,0000,,Рахмет Ғабу. Қош бол, жақын арада көріскенше.
Dialogue: 0,0:23:15.00,0:23:18.00,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:23:27.62,0:23:29.62,Default,,0000,0000,0000,,Дұрыс!
Dialogue: 0,0:23:31.83,0:23:33.85,Default,,0000,0000,0000,,Әже!
Dialogue: 0,0:23:33.85,0:23:38.06,Default,,0000,0000,0000,,Бұл не, Мэй? Мен сондай асықтым.
Dialogue: 0,0:23:38.06,0:23:42.44,Default,,0000,0000,0000,,Әже, әже! Білесің бе, қара ешкі баласы.
Dialogue: 0,0:23:42.44,0:23:44.30,Default,,0000,0000,0000,,Мен әжемнің ақ ешкі екенін білемін.
Dialogue: 0,0:23:44.30,0:23:46.98,Default,,0000,0000,0000,,Маған көмектесуге келмедің бе?
Dialogue: 0,0:23:46.98,0:23:51.86,Default,,0000,0000,0000,,Сол себепті жарық түспей тұрғанда үнсіз жоғалып кетті емес пе?
Dialogue: 0,0:23:51.86,0:23:53.72,Default,,0000,0000,0000,,Ахаха.
Dialogue: 0,0:23:53.72,0:23:57.09,Default,,0000,0000,0000,,Демек, әлгі бала – ақсақал қара ешкі.
Dialogue: 0,0:23:57.09,0:24:01.13,Default,,0000,0000,0000,,Бұл ақсақал! Мен оны түсіндім!
Dialogue: 0,0:24:01.13,0:24:05.00,Default,,0000,0000,0000,,Ол ақсақал екені сөзсіз! эй? Әже.
Dialogue: 0,0:24:05.00,0:24:09.20,Default,,0000,0000,0000,,Мүлдем Уфуфу!
Dialogue: 0,0:24:09.20,0:24:11.56,Default,,0000,0000,0000,,Мүлдем Уфуфу!
Dialogue: 0,0:24:11.56,0:24:15.94,Default,,0000,0000,0000,,Мен түсіндім! Кәне?
Dialogue: 0,0:24:15.94,0:24:18.94,Default,,0000,0000,0000,,Сіз қалай ойлайсыз?
Dialogue: 0,0:24:20.44,0:24:26.44,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
