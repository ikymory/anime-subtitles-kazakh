Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:02:53.97,0:03:02.06,Default,,0000,0000,0000,,<Дауылды түнде, желде, жаңбырда және қою қараңғыда екеуі
Dialogue: 0,0:03:02.06,0:03:08.06,Default,,0000,0000,0000,,А, сосын екеуі күн күркірегенде кездесті>
Dialogue: 0,0:03:10.97,0:03:14.35,Default,,0000,0000,0000,,＜ Бір-бірімізді көрмей дос болып кеттік.
Dialogue: 0,0:03:14.35,0:03:19.56,Default,,0000,0000,0000,,Қайта кездесуге уәде беріңіз
Dialogue: 0,0:03:19.56,0:03:22.43,Default,,0000,0000,0000,,Жарқыраған күн астында
Dialogue: 0,0:03:22.43,0:03:28.65,Default,,0000,0000,0000,,«Дауылға байланысты» құпия сөзін ауыстырған кезде
Dialogue: 0,0:03:28.65,0:03:33.87,Default,,0000,0000,0000,,Бірі – ешкі сүйіп жейтін қасқыр.
Dialogue: 0,0:03:33.87,0:03:39.60,Default,,0000,0000,0000,,Бірі қасқырдан қашпаса жейтін ешкі еді.
Dialogue: 0,0:03:39.60,0:03:43.97,Default,,0000,0000,0000,,Бірақ қасқыр ешкіні жеген жоқ.
Dialogue: 0,0:03:43.97,0:03:47.18,Default,,0000,0000,0000,,Ешкі қасқырдан қашпады.
Dialogue: 0,0:03:47.18,0:03:52.56,Default,,0000,0000,0000,,Габу мен Мэй дос болды>
Dialogue: 0,0:03:52.56,0:03:55.43,Default,,0000,0000,0000,,Қасқырды кездестірсең
Dialogue: 0,0:03:55.43,0:04:00.47,Default,,0000,0000,0000,,Мына керемет мүйізбен осылай итеріңіз!
Dialogue: 0,0:04:00.47,0:04:03.17,Default,,0000,0000,0000,,Және осы күшті артқы аяқтарымен
Dialogue: 0,0:04:03.17,0:04:07.70,Default,,0000,0000,0000,,Осылай! Ой!
Dialogue: 0,0:04:07.70,0:04:09.23,Default,,0000,0000,0000,,Жоқ! Мен оларды осымен қуып жіберемін.
Dialogue: 0,0:04:09.23,0:04:13.77,Default,,0000,0000,0000,,Керемет Тапу! Мен бүгін құлаған жоқпын!
Dialogue: 0,0:04:13.77,0:04:16.13,Default,,0000,0000,0000,,Бұл не! ~ түртіңіз!
Dialogue: 0,0:04:16.13,0:04:18.99,Default,,0000,0000,0000,,Иә? Не болды, Мии?
Dialogue: 0,0:04:18.99,0:04:21.01,Default,,0000,0000,0000,,Эй, мұнда кел!
Dialogue: 0,0:04:21.01,0:04:23.54,Default,,0000,0000,0000,,Иә? не? Жарайды!
Dialogue: 0,0:04:23.54,0:04:27.57,Default,,0000,0000,0000,,Мұнда кел! Иә….
Dialogue: 0,0:04:27.57,0:04:30.27,Default,,0000,0000,0000,,Бірдеңе... ой!
Dialogue: 0,0:04:30.27,0:04:33.27,Default,,0000,0000,0000,,Ахаха! Тапу ұсталды!
Dialogue: 0,0:04:35.49,0:04:40.87,Default,,0000,0000,0000,,Кора менің! Мұқият тыңдаңыз. Қанша айтсаң да түсінесің.
Dialogue: 0,0:04:40.87,0:04:43.57,Default,,0000,0000,0000,,Шұңқырлар қауіпті, сондықтан мен саған тоқтауыңды айтамын!
Dialogue: 0,0:04:43.57,0:04:46.43,Default,,0000,0000,0000,,Хэхе! Өйткені, лайықты бағдарлар бар!
Dialogue: 0,0:04:46.43,0:04:48.29,Default,,0000,0000,0000,,Мәселе бұл емес!
Dialogue: 0,0:04:48.29,0:04:51.98,Default,,0000,0000,0000,,Эх! Шынымен бе?
Dialogue: 0,0:04:51.98,0:04:55.53,Default,,0000,0000,0000,,Бұл рас! Ол бала сондай кішкентай
Dialogue: 0,0:04:55.53,0:04:58.05,Default,,0000,0000,0000,,Мұның бәрі қара және өте сүйкімді.
Dialogue: 0,0:04:58.05,0:05:02.76,Default,,0000,0000,0000,,Жақсы! Мен оны көргім келеді.
Dialogue: 0,0:05:02.76,0:05:05.28,Default,,0000,0000,0000,,Кеттік.
Dialogue: 0,0:05:05.28,0:05:07.81,Default,,0000,0000,0000,,Міндетті түрде барып көру керек.
Dialogue: 0,0:05:07.81,0:05:11.69,Default,,0000,0000,0000,,Сіз оны көрмейінше оның қаншалықты сүйкімді екенін түсіне алмайсыз.
Dialogue: 0,0:05:11.69,0:05:16.57,Default,,0000,0000,0000,,Оның үстіне асықпасаң, тез өседі.
Dialogue: 0,0:05:16.57,0:05:21.45,Default,,0000,0000,0000,,Дұрыс! (3 адам) Ахаха!
Dialogue: 0,0:05:21.45,0:05:24.98,Default,,0000,0000,0000,,Не? Эй, не деген сүйкімді?
Dialogue: 0,0:05:24.98,0:05:29.86,Default,,0000,0000,0000,,Хэхехе! Сүйкімді қара ешкінің баласы дүниеге келді.
Dialogue: 0,0:05:29.86,0:05:34.74,Default,,0000,0000,0000,,Қара ешкі баласы! Мен оны көргім келеді! Мен оны көргім келеді!
Dialogue: 0,0:05:34.74,0:05:36.26,Default,,0000,0000,0000,,Қайда? Бұл жерде емес.
Dialogue: 0,0:05:36.26,0:05:38.79,Default,,0000,0000,0000,,Не? Сен жоқсың ба?
Dialogue: 0,0:05:38.79,0:05:41.98,Default,,0000,0000,0000,,Парапара - Хара! қайда?
Dialogue: 0,0:05:41.98,0:05:45.86,Default,,0000,0000,0000,,Куро-сан тұратын жер. аа! барайық! барайық!
Dialogue: 0,0:05:45.86,0:05:47.38,Default,,0000,0000,0000,,Қазір кеттік!
Dialogue: 0,0:05:47.38,0:05:50.57,Default,,0000,0000,0000,,Бұл мүмкін емес!
Dialogue: 0,0:05:50.57,0:05:53.26,Default,,0000,0000,0000,,Иә! ? неге? Неліктен?
Dialogue: 0,0:05:53.26,0:05:57.47,Default,,0000,0000,0000,,Өйткені ол алыс! Бұл шынымен алыс па?
Dialogue: 0,0:05:57.47,0:05:59.32,Default,,0000,0000,0000,,Иә...
Dialogue: 0,0:05:59.32,0:06:02.36,Default,,0000,0000,0000,,Мезомесо тауынан өту қиын.
Dialogue: 0,0:06:02.36,0:06:09.92,Default,,0000,0000,0000,,Сосын, қытырлақ шөптен, үлпілдек орманға кіріңіз.
Dialogue: 0,0:06:09.92,0:06:16.17,Default,,0000,0000,0000,,Үлпілдек орманнан аздап қорқынышты Магамага орманына кіріңіз.
Dialogue: 0,0:06:16.17,0:06:20.20,Default,,0000,0000,0000,,Және Мезомесо тауының етегінен өту.
Dialogue: 0,0:06:20.20,0:06:24.08,Default,,0000,0000,0000,,Пери Пери орманынан өткенде қара ешкілерді кездестіресіз.
Dialogue: 0,0:06:24.08,0:06:28.62,Default,,0000,0000,0000,,Парапарахара. Ақыр соңында, бұл өте алыс.
Dialogue: 0,0:06:28.62,0:06:31.65,Default,,0000,0000,0000,,Не? Мен айтқанымдай.
Dialogue: 0,0:06:31.65,0:06:34.01,Default,,0000,0000,0000,,Иә, жарайды, кеттік!
Dialogue: 0,0:06:34.01,0:06:37.04,Default,,0000,0000,0000,,Не... естімедің бе? ?
Dialogue: 0,0:06:37.04,0:06:39.40,Default,,0000,0000,0000,,Магамага орманы қауіпті!
Dialogue: 0,0:06:39.40,0:06:43.60,Default,,0000,0000,0000,,Адасып қалсаң, қайта шыға алмайсың!
Dialogue: 0,0:06:43.60,0:06:45.12,Default,,0000,0000,0000,,Мии мен Мэй үшін бұл мүмкін емес!
Dialogue: 0,0:06:45.12,0:06:47.31,Default,,0000,0000,0000,,Бірақ Куро-сан осында!
Dialogue: 0,0:06:47.31,0:06:51.34,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:06:51.34,0:06:55.72,Default,,0000,0000,0000,,Бұл бала мықты болды. Тапу ше?
Dialogue: 0,0:06:55.72,0:06:58.58,Default,,0000,0000,0000,,О, мен? Жақсы болатынына сенімдімін!
Dialogue: 0,0:06:58.58,0:07:00.61,Default,,0000,0000,0000,,Мен ол жерде бұрын болғанмын.
Dialogue: 0,0:07:00.61,0:07:03.14,Default,,0000,0000,0000,,Олай болса бірге барайық! Ха! ?
Dialogue: 0,0:07:03.14,0:07:07.84,Default,,0000,0000,0000,,Мені ал! Сондықтан мен...
Dialogue: 0,0:07:07.84,0:07:12.39,Default,,0000,0000,0000,,Егер бұл мен болсам, мен басқара аламын, бірақ істей алмаймын, өйткені оны өзіммен бірге алып кету қиын болар еді!
Dialogue: 0,0:07:12.39,0:07:16.93,Default,,0000,0000,0000,,Е-е, бұл өте қулық!
Dialogue: 0,0:07:16.93,0:07:20.31,Default,,0000,0000,0000,,Мені ал, мені ал! Қара ешкінің баласын көрдім!
Dialogue: 0,0:07:20.31,0:07:22.83,Default,,0000,0000,0000,,Жақсы емес, жақсы емес!
Dialogue: 0,0:07:22.83,0:07:26.03,Default,,0000,0000,0000,,Мені ал! Ханым!
Dialogue: 0,0:07:26.03,0:07:30.91,Default,,0000,0000,0000,,Жоқ, сен ше, Ғабу?
Dialogue: 0,0:07:30.91,0:07:36.30,Default,,0000,0000,0000,,Ештеңе. Ах, қарным ашты.
Dialogue: 0,0:07:36.30,0:07:38.65,Default,,0000,0000,0000,,Ахх. аа.
Dialogue: 0,0:07:38.65,0:07:40.17,Default,,0000,0000,0000,,Менің ойымша, бұл бізде де солай!
Dialogue: 0,0:07:40.17,0:07:42.69,Default,,0000,0000,0000,,Әр кезде есіме түсірме!
Dialogue: 0,0:07:42.69,0:07:46.23,Default,,0000,0000,0000,,Ендеше аң аулап, жақсы олжа тап.
Dialogue: 0,0:07:46.23,0:07:48.58,Default,,0000,0000,0000,,Көп тамақтаныңыз
Dialogue: 0,0:07:48.58,0:07:52.29,Default,,0000,0000,0000,,Тойғаным сонша, тамақ іше алмаймын
Dialogue: 0,0:07:52.29,0:07:55.65,Default,,0000,0000,0000,,Аа, енді тамақ туралы біраз уақыт ойланудың қажеті жоқ...
Dialogue: 0,0:07:55.65,0:07:57.65,Default,,0000,0000,0000,,Тоқта!
Dialogue: 0,0:08:00.87,0:08:03.06,Default,,0000,0000,0000,,Эй!
Dialogue: 0,0:08:03.06,0:08:05.92,Default,,0000,0000,0000,,Қайда бара жатырсыңдар?
Dialogue: 0,0:08:05.92,0:08:07.44,Default,,0000,0000,0000,,Ал... Мен серуендеуге барамын.
Dialogue: 0,0:08:07.44,0:08:10.97,Default,,0000,0000,0000,,Сәлем Мии! Ух... иә!
Dialogue: 0,0:08:10.97,0:08:15.85,Default,,0000,0000,0000,,Өтірікші! Екеуің Парапарахараға баруды жоспарлап отырсыңдар, солай ма?
Dialogue: 0,0:08:15.85,0:08:17.54,Default,,0000,0000,0000,,Жарайды, бізде де солай.
Dialogue: 0,0:08:17.54,0:08:20.24,Default,,0000,0000,0000,,Қара ешкінің баласы Көргім келетін нәрсе!
Dialogue: 0,0:08:20.24,0:08:23.93,Default,,0000,0000,0000,,Иә, мен нәрестені көргім келеді!
Dialogue: 0,0:08:23.93,0:08:27.48,Default,,0000,0000,0000,,Демек, бұл мүмкін емес деп айтасыз, себебі бұл қауіпті!
Dialogue: 0,0:08:27.48,0:08:33.70,Default,,0000,0000,0000,,Бірақ егер Тапу сонда болған болса, біз де жасай аламыз!
Dialogue: 0,0:08:33.70,0:08:35.05,Default,,0000,0000,0000,,Мұның себебі неде! ?
Dialogue: 0,0:08:35.05,0:08:39.26,Default,,0000,0000,0000,,Орманда қасқыр кездессе, қашып құтыла алмайсың!
Dialogue: 0,0:08:39.26,0:08:43.13,Default,,0000,0000,0000,,Ондай жағдайда Тапу сені алып кетеді! иә?
Dialogue: 0,0:08:43.13,0:08:46.49,Default,,0000,0000,0000,,Кеттік! Сіз сонда болдыңыз ба?
Dialogue: 0,0:08:46.49,0:08:50.70,Default,,0000,0000,0000,,Қасқырды кездестірсең де, Тапу бар болғанша жақсы боласың.
Dialogue: 0,0:08:50.70,0:08:54.74,Default,,0000,0000,0000,,Иә! Мен мұны әрдайым айта бермеймін.
Dialogue: 0,0:08:54.74,0:08:57.94,Default,,0000,0000,0000,,Мына жіңішке мүйізбен, осылай
Dialogue: 0,0:08:57.94,0:09:04.18,Default,,0000,0000,0000,,Сен күшті артқы аяғыңмен қасқырды қуасың, солай ма?
Dialogue: 0,0:09:04.18,0:09:07.54,Default,,0000,0000,0000,,О, бұл...
Dialogue: 0,0:09:07.54,0:09:12.26,Default,,0000,0000,0000,,Жоқ? Жоқ, мұның еш айырмашылығы жоқ!
Dialogue: 0,0:09:12.26,0:09:15.62,Default,,0000,0000,0000,,Содан кейін шешілді! Фуфуфу….
Dialogue: 0,0:09:15.62,0:09:18.98,Default,,0000,0000,0000,,О, сәл күте тұрыңыз!
Dialogue: 0,0:09:18.98,0:09:21.34,Default,,0000,0000,0000,,Моро! Өз-өзіңді күт!
Dialogue: 0,0:09:21.34,0:09:24.71,Default,,0000,0000,0000,,А? Сіз де келуіңіз керек.
Dialogue: 0,0:09:24.71,0:09:26.89,Default,,0000,0000,0000,,Не? Әлі де жеп жатыр.
Dialogue: 0,0:09:26.89,0:09:28.08,Default,,0000,0000,0000,,Кеттік!
Dialogue: 0,0:09:28.08,0:09:31.11,Default,,0000,0000,0000,,А... Адасып қалғанымды білмеймін.
Dialogue: 0,0:09:31.11,0:09:35.65,Default,,0000,0000,0000,,Менің қарным ашты.
Dialogue: 0,0:09:35.65,0:09:37.67,Default,,0000,0000,0000,,О, мен таптым.
Dialogue: 0,0:09:37.67,0:09:39.86,Default,,0000,0000,0000,,мамыр!
Dialogue: 0,0:09:39.86,0:09:41.55,Default,,0000,0000,0000,,Не? Не таптың?
Dialogue: 0,0:09:41.55,0:09:43.07,Default,,0000,0000,0000,,Ми деген не?
Dialogue: 0,0:09:43.07,0:09:45.26,Default,,0000,0000,0000,,Жоқ...
Dialogue: 0,0:09:45.26,0:09:50.13,Default,,0000,0000,0000,,Мен... Бұл сирек, солай емес пе? Төрт жапырақты беде.
Dialogue: 0,0:09:50.13,0:09:53.00,Default,,0000,0000,0000,,ше? Сен не айтып тұрсың?
Dialogue: 0,0:09:53.00,0:09:55.19,Default,,0000,0000,0000,,Сіз мұны жей аласыз ба?
Dialogue: 0,0:09:55.19,0:09:58.21,Default,,0000,0000,0000,,Қарным одан сайын ашылып барады.
Dialogue: 0,0:09:58.21,0:10:01.24,Default,,0000,0000,0000,,Дұрыс...
Dialogue: 0,0:10:01.24,0:10:03.76,Default,,0000,0000,0000,,Әй, әлі қанша?
Dialogue: 0,0:10:03.76,0:10:05.45,Default,,0000,0000,0000,,Әлі жоқ! Қанша уақытқа дейін?
Dialogue: 0,0:10:05.45,0:10:08.81,Default,,0000,0000,0000,,Сондықтан ол әлі де алыс.
Dialogue: 0,0:10:08.81,0:10:11.51,Default,,0000,0000,0000,,Бұл қай жерде? Магамага орманы?
Dialogue: 0,0:10:11.51,0:10:14.38,Default,,0000,0000,0000,,Жоқ Бұл әлі үлпілдек орман.
Dialogue: 0,0:10:14.38,0:10:17.08,Default,,0000,0000,0000,,Магамага орманы алда.
Dialogue: 0,0:10:17.08,0:10:21.11,Default,,0000,0000,0000,,Эй, мына жерде. сурет?
Dialogue: 0,0:10:21.11,0:10:23.46,Default,,0000,0000,0000,,Мына жерде! Иә?
Dialogue: 0,0:10:23.46,0:10:27.17,Default,,0000,0000,0000,,А... дұрыс.
Dialogue: 0,0:10:27.17,0:10:29.19,Default,,0000,0000,0000,,Бұл Магамага орманының кіреберісі.
Dialogue: 0,0:10:29.19,0:10:31.88,Default,,0000,0000,0000,,Уау! Эй Мии!
Dialogue: 0,0:10:31.88,0:10:34.91,Default,,0000,0000,0000,,Күте тұрыңыз! Мии!
Dialogue: 0,0:10:34.91,0:10:37.27,Default,,0000,0000,0000,,Мамыр, мені тастама.
Dialogue: 0,0:10:37.27,0:10:42.48,Default,,0000,0000,0000,,Уау! Мен бұрын ешқашан мұндай нәрсені көрген емеспін.
Dialogue: 0,0:10:42.48,0:10:44.34,Default,,0000,0000,0000,,Өз бетіңізше бармаңыз.
Dialogue: 0,0:10:44.34,0:10:47.03,Default,,0000,0000,0000,,Магамага орманында адасу оңай.
Dialogue: 0,0:10:47.03,0:10:50.40,Default,,0000,0000,0000,,Жарайсың ба? Сіз маған міндетті түрде келесіз.
Dialogue: 0,0:10:50.40,0:10:54.27,Default,,0000,0000,0000,,Тиін мең қоян тышқан!
Dialogue: 0,0:10:54.27,0:10:56.46,Default,,0000,0000,0000,,Тиін мең….
Dialogue: 0,0:10:56.46,0:10:58.46,Default,,0000,0000,0000,,Хмм, тоқтатыңыз!
Dialogue: 0,0:11:03.87,0:11:06.39,Default,,0000,0000,0000,,О, мамыр!
Dialogue: 0,0:11:06.39,0:11:08.91,Default,,0000,0000,0000,,Бұл жерде жақсы емес.
Dialogue: 0,0:11:08.91,0:11:11.11,Default,,0000,0000,0000,,Магамага орманына барайық. Мага….
Dialogue: 0,0:11:11.11,0:11:14.14,Default,,0000,0000,0000,,Ахх! Не? Не болды?
Dialogue: 0,0:11:14.14,0:11:19.19,Default,,0000,0000,0000,,А, мен ана жақтағы бұталардың артында қоянды көрдім.
Dialogue: 0,0:11:19.19,0:11:21.04,Default,,0000,0000,0000,,Не! қоян!
Dialogue: 0,0:11:21.04,0:11:23.73,Default,,0000,0000,0000,,Маған бұл жерден жасырын өту оңай.
Dialogue: 0,0:11:23.73,0:11:26.59,Default,,0000,0000,0000,,Жарайды, түсіндім. Сонда біз...
Dialogue: 0,0:11:26.59,0:11:30.47,Default,,0000,0000,0000,,Осы жерден кетейік!
Dialogue: 0,0:11:30.47,0:11:32.16,Default,,0000,0000,0000,,Қазір мен өзімді қауіпсіз сезіне аламын.
Dialogue: 0,0:11:32.16,0:11:34.51,Default,,0000,0000,0000,,Қанша уақыт?
Dialogue: 0,0:11:34.51,0:11:38.88,Default,,0000,0000,0000,,Әлі жоқ. Қанша уақытқа дейін?
Dialogue: 0,0:11:38.88,0:11:40.73,Default,,0000,0000,0000,,Әлі жоқ.
Dialogue: 0,0:11:40.73,0:11:42.25,Default,,0000,0000,0000,,Қанша уақыт?
Dialogue: 0,0:11:42.25,0:11:45.61,Default,,0000,0000,0000,,Әлі жоқ десем, әлі жоқ!
Dialogue: 0,0:11:45.61,0:11:47.14,Default,,0000,0000,0000,,Магамага орманы кең.
Dialogue: 0,0:11:47.14,0:11:50.84,Default,,0000,0000,0000,,Сондықтан мен сендерге мұны істей алмайсыңдар дедім.
Dialogue: 0,0:11:50.84,0:11:54.21,Default,,0000,0000,0000,,Бұл мүмкін емес! (шу)
Dialogue: 0,0:11:54.21,0:11:57.24,Default,,0000,0000,0000,,Енді ше? Бұл жылау ма?
Dialogue: 0,0:11:57.24,0:12:01.94,Default,,0000,0000,0000,,Эй, енді ше? Бәрі жақсы.
Dialogue: 0,0:12:01.94,0:12:05.98,Default,,0000,0000,0000,,Сіз білмейсіз бе? Мен саған айтамын, ол үшін уайымдама.
Dialogue: 0,0:12:05.98,0:12:08.01,Default,,0000,0000,0000,,Менің, бұл құс екеніне сенімдімін.
Dialogue: 0,0:12:08.01,0:12:10.03,Default,,0000,0000,0000,,Менің қарным ашты.
Dialogue: 0,0:12:10.03,0:12:12.22,Default,,0000,0000,0000,,Не? Сіз оны жай ғана жедіңіз!
Dialogue: 0,0:12:12.22,0:12:16.76,Default,,0000,0000,0000,,Мен асығуым керек болғандықтан, көп жей алмадым...
Dialogue: 0,0:12:16.76,0:12:18.28,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:12:18.28,0:12:20.63,Default,,0000,0000,0000,,Балалар, сендер тым қатты дауыстайсыңдар.
Dialogue: 0,0:12:20.63,0:12:23.66,Default,,0000,0000,0000,,Сіз көрнекті орыннан айырылдыңыз!
Dialogue: 0,0:12:23.66,0:12:26.53,Default,,0000,0000,0000,,Осымен Парапар далаға шықпайды.
Dialogue: 0,0:12:26.53,0:12:30.90,Default,,0000,0000,0000,,Бұл жерде адасып кете бересіз.
Dialogue: 0,0:12:30.90,0:12:32.76,Default,,0000,0000,0000,,Ол сонда. сурет?
Dialogue: 0,0:12:32.76,0:12:36.96,Default,,0000,0000,0000,,Эй... Мен Парапарахараға барамын.
Dialogue: 0,0:12:36.96,0:12:40.16,Default,,0000,0000,0000,,Қараңызшы. иә?
Dialogue: 0,0:12:40.16,0:12:42.69,Default,,0000,0000,0000,,Уууу... Мен өтіп кеттім.
Dialogue: 0,0:12:42.69,0:12:46.23,Default,,0000,0000,0000,,《Жоқ, енді ешкілер қасқырға айналды.
Dialogue: 0,0:12:46.23,0:12:50.10,Default,,0000,0000,0000,,Барлығы жиналып тамақ сұрап тұрған сияқты.
Dialogue: 0,0:12:50.10,0:12:54.64,Default,,0000,0000,0000,,А, жоқ, жоқ, жоқ... олай істеме.
Dialogue: 0,0:12:54.64,0:12:56.83,Default,,0000,0000,0000,,Бұлай жасамаңыз.
Dialogue: 0,0:12:56.83,0:13:01.83,Default,,0000,0000,0000,,Бізді бізден басқа қасқыр тапса, бұл үлкен іс.
Dialogue: 0,0:13:07.61,0:13:11.47,Default,,0000,0000,0000,,Қараңызшы, мінеки. Бұл сөзсіз.
Dialogue: 0,0:13:11.47,0:13:14.01,Default,,0000,0000,0000,,Керемет! Кез келген сәтте құлап қалатын сияқты.
Dialogue: 0,0:13:14.01,0:13:17.37,Default,,0000,0000,0000,,Тез жетейік. (шу)
Dialogue: 0,0:13:17.37,0:13:19.22,Default,,0000,0000,0000,,Қандай дыбыс?
Dialogue: 0,0:13:19.22,0:13:21.91,Default,,0000,0000,0000,,Барлығымыз кеттік!
Dialogue: 0,0:13:21.91,0:13:23.91,Default,,0000,0000,0000,,Менің артымнан жүр!
Dialogue: 0,0:13:27.80,0:13:30.80,Default,,0000,0000,0000,,Бұл қауіпті болды...
Dialogue: 0,0:15:10.16,0:15:13.86,Default,,0000,0000,0000,,Орман қараңғы. Иә.
Dialogue: 0,0:15:13.86,0:15:17.57,Default,,0000,0000,0000,,Бірақ қараңызшы, ол әлі де жарқырап тұр. Иә.
Dialogue: 0,0:15:17.57,0:15:21.77,Default,,0000,0000,0000,,Хмм, жақсысың ба? сурет?
Dialogue: 0,0:15:21.77,0:15:23.13,Default,,0000,0000,0000,,Ештеңе.
Dialogue: 0,0:15:23.13,0:15:25.65,Default,,0000,0000,0000,,Иә? не?
Dialogue: 0,0:15:25.65,0:15:27.67,Default,,0000,0000,0000,,Тапу? Уақыт келді
Dialogue: 0,0:15:27.67,0:15:31.38,Default,,0000,0000,0000,,Белгі болуы керек, бірақ мен оны таба алмаймын.
Dialogue: 0,0:15:31.38,0:15:34.58,Default,,0000,0000,0000,,Шынымен бе? екінші ойлар туралы.
Dialogue: 0,0:15:34.58,0:15:36.76,Default,,0000,0000,0000,,Ақыр соңында?
Dialogue: 0,0:15:36.76,0:15:40.80,Default,,0000,0000,0000,,Бірдеңе басқаша болды. Тапу! ?
Dialogue: 0,0:15:40.80,0:15:43.67,Default,,0000,0000,0000,,Жоқ, ол міндетті түрде осы жерде болуы керек.
Dialogue: 0,0:15:43.67,0:15:47.86,Default,,0000,0000,0000,,Тау лалагүлінің гүлі. не білесің.
Dialogue: 0,0:15:47.86,0:15:50.39,Default,,0000,0000,0000,,Гүлдер қурап қалса, не істеуім керек?
Dialogue: 0,0:15:50.39,0:15:54.60,Default,,0000,0000,0000,,Жарайды! мен адасып қалдым.
Dialogue: 0,0:15:54.60,0:15:57.80,Default,,0000,0000,0000,,Міне. Жарайды!
Dialogue: 0,0:15:57.80,0:15:59.66,Default,,0000,0000,0000,,Мен осы уақытқа дейін қателескен жоқпын.
Dialogue: 0,0:15:59.66,0:16:04.37,Default,,0000,0000,0000,,Иә, дәл солай! Бұл тау арыстаны емес еді.
Dialogue: 0,0:16:04.37,0:16:06.89,Default,,0000,0000,0000,,Сонымен...
Dialogue: 0,0:16:06.89,0:16:09.59,Default,,0000,0000,0000,,Бұл жол. Барайық.
Dialogue: 0,0:16:09.59,0:16:12.12,Default,,0000,0000,0000,,Солай ма? Сенімен бәрі жақсы ма?
Dialogue: 0,0:16:12.12,0:16:15.48,Default,,0000,0000,0000,,О, жарайды!
Dialogue: 0,0:16:15.48,0:16:18.18,Default,,0000,0000,0000,,《Ой, бұл басқаша.
Dialogue: 0,0:16:18.18,0:16:22.38,Default,,0000,0000,0000,,Мен қиындыққа тап болдым.
Dialogue: 0,0:16:22.38,0:16:25.92,Default,,0000,0000,0000,,Мен сені жалғыз қалдыра алмаймын.
Dialogue: 0,0:16:25.92,0:16:30.29,Default,,0000,0000,0000,,Уау! Бұл тоған!
Dialogue: 0,0:16:30.29,0:16:34.18,Default,,0000,0000,0000,,Ахаха, қарашы, аспанға қара!
Dialogue: 0,0:16:34.18,0:16:38.87,Default,,0000,0000,0000,,Ахаха, өте жарқын!
Dialogue: 0,0:16:38.87,0:16:40.57,Default,,0000,0000,0000,,Тоған? Иә?
Dialogue: 0,0:16:40.57,0:16:43.92,Default,,0000,0000,0000,,《Мен ешқашан тоғанға барған емеспін》
Dialogue: 0,0:16:43.92,0:16:45.45,Default,,0000,0000,0000,,Тапу? сурет?
Dialogue: 0,0:16:45.45,0:16:47.14,Default,,0000,0000,0000,,Не болды? аа!
Dialogue: 0,0:16:47.14,0:16:51.67,Default,,0000,0000,0000,,А, ештеңе жоқ. Бір үзіліс жасайық.
Dialogue: 0,0:16:51.67,0:16:53.03,Default,,0000,0000,0000,,Мен мұны істеп қойдым.
Dialogue: 0,0:16:53.03,0:16:56.05,Default,,0000,0000,0000,,Уфуфу О, дәмді екен.
Dialogue: 0,0:16:56.05,0:16:58.08,Default,,0000,0000,0000,,Өйткені мен шөлдедім.
Dialogue: 0,0:16:58.08,0:17:03.46,Default,,0000,0000,0000,,Хмм, дәмді!
Dialogue: 0,0:17:03.46,0:17:05.46,Default,,0000,0000,0000,,Сәлем Уфуфу!
Dialogue: 0,0:17:11.20,0:17:16.26,Default,,0000,0000,0000,,Уау, тамаша жер екен, Ғабу.
Dialogue: 0,0:17:16.26,0:17:20.80,Default,,0000,0000,0000,,Әй, Ғабу? Ах, ой, аа...
Dialogue: 0,0:17:20.80,0:17:24.50,Default,,0000,0000,0000,,Мии, суды көп ішпе.
Dialogue: 0,0:17:24.50,0:17:27.20,Default,,0000,0000,0000,,Не? Мен шөлдедім →
Dialogue: 0,0:17:27.20,0:17:30.39,Default,,0000,0000,0000,,Бұл су өте дәмді.
Dialogue: 0,0:17:30.39,0:17:33.09,Default,,0000,0000,0000,,Сонымен қанша уақыт қалды? сурет?
Dialogue: 0,0:17:33.09,0:17:36.13,Default,,0000,0000,0000,,Е-е... аз қалды.
Dialogue: 0,0:17:36.13,0:17:39.15,Default,,0000,0000,0000,,Шынымен бе? Ааа.
Dialogue: 0,0:17:39.15,0:17:42.85,Default,,0000,0000,0000,,Иә! Әзірше емес.
Dialogue: 0,0:17:42.85,0:17:44.04,Default,,0000,0000,0000,,《Бұл қызық сияқты.
Dialogue: 0,0:17:44.04,0:17:49.42,Default,,0000,0000,0000,,А...бірақ біз қасқырмыз→
Dialogue: 0,0:17:49.42,0:17:52.45,Default,,0000,0000,0000,,Оның ішіне ешқашан кірмеңіз.
Dialogue: 0,0:17:52.45,0:17:54.45,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:17:57.16,0:17:59.19,Default,,0000,0000,0000,,《Неге! ? 》
Dialogue: 0,0:17:59.19,0:18:02.89,Default,,0000,0000,0000,,А, мен суланып қалдым.
Dialogue: 0,0:18:02.89,0:18:06.09,Default,,0000,0000,0000,,Бұл жақсы емес пе? Уау!
Dialogue: 0,0:18:06.09,0:18:08.94,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:18:08.94,0:18:10.47,Default,,0000,0000,0000,,Барлығыңызға сәлем!
Dialogue: 0,0:18:10.47,0:18:13.66,Default,,0000,0000,0000,,О….
Dialogue: 0,0:18:13.66,0:18:17.03,Default,,0000,0000,0000,,Тапу Тамақты жеуге болмайды.
Dialogue: 0,0:18:17.03,0:18:20.23,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:18:20.23,0:18:24.94,Default,,0000,0000,0000,,Габ? Міне бітті.
Dialogue: 0,0:18:24.94,0:18:27.97,Default,,0000,0000,0000,,Сен мұнда не үшін келдің?
Dialogue: 0,0:18:27.97,0:18:30.67,Default,,0000,0000,0000,,Бұл қиын. сурет?
Dialogue: 0,0:18:30.67,0:18:34.70,Default,,0000,0000,0000,,Мен осы жерден айналайын →
Dialogue: 0,0:18:34.70,0:18:36.06,Default,,0000,0000,0000,,Сен, тоғанның арғы бетіне өт.
Dialogue: 0,0:18:36.06,0:18:40.60,Default,,0000,0000,0000,,Жарайсың ба? Ой... мен судамын.
Dialogue: 0,0:18:40.60,0:18:42.45,Default,,0000,0000,0000,,Егер ол батып кетсе не істеу керек?
Dialogue: 0,0:18:42.45,0:18:45.14,Default,,0000,0000,0000,,Ол таяз, сондықтан ол суға батпайды!
Dialogue: 0,0:18:45.14,0:18:47.84,Default,,0000,0000,0000,,Бұл қасқыр! (3 адам) Әй! ?
Dialogue: 0,0:18:47.84,0:18:52.55,Default,,0000,0000,0000,,Барлығы осылай! Не, байқадың ба?
Dialogue: 0,0:18:52.55,0:18:55.74,Default,,0000,0000,0000,,Ах~. (Іштің ырылдаған дыбысы)
Dialogue: 0,0:18:55.74,0:18:59.74,Default,,0000,0000,0000,,күрсіну. (Іштің ырылдаған дыбысы)
Dialogue: 0,0:19:05.85,0:19:09.05,Default,,0000,0000,0000,,Мм. Осылай емес пе?
Dialogue: 0,0:19:09.05,0:19:13.43,Default,,0000,0000,0000,,Хмм... Жоқ, менің ойымша, бұл осы болды.
Dialogue: 0,0:19:13.43,0:19:15.28,Default,,0000,0000,0000,,Қайсысы?
Dialogue: 0,0:19:15.28,0:19:20.16,Default,,0000,0000,0000,,Менің ойымша, бұл жол. Сіз қалай білесіз?
Dialogue: 0,0:19:20.16,0:19:23.86,Default,,0000,0000,0000,,А, мен бұл туралы әжемнен бұрын сұрағанмын.
Dialogue: 0,0:19:23.86,0:19:25.38,Default,,0000,0000,0000,,Әй, сәлем.
Dialogue: 0,0:19:25.38,0:19:29.09,Default,,0000,0000,0000,,Мейдің әжесі айтса, бұл сөзсіз рас.
Dialogue: 0,0:19:29.09,0:19:33.63,Default,,0000,0000,0000,,Мен де солай сезіндім.
Dialogue: 0,0:19:33.63,0:19:35.63,Default,,0000,0000,0000,,Уау! Хахаха!
Dialogue: 0,0:19:46.26,0:19:48.26,Default,,0000,0000,0000,,Мына жерде!
Dialogue: 0,0:19:51.14,0:19:54.50,Default,,0000,0000,0000,,Мына жерде!
Dialogue: 0,0:19:54.50,0:19:56.69,Default,,0000,0000,0000,,Не? Қасқыр?
Dialogue: 0,0:19:56.69,0:19:59.55,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:19:59.55,0:20:01.40,Default,,0000,0000,0000,,Бұл ненің дыбысы? Сіз оны көрдіңіз бе?
Dialogue: 0,0:20:01.40,0:20:04.60,Default,,0000,0000,0000,,А-а-а... Жақсы болатынына сенімдімін.
Dialogue: 0,0:20:04.60,0:20:06.79,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:20:06.79,0:20:10.83,Default,,0000,0000,0000,,А, иә... Менің ойымша, бұл бір нәрсенің құлаған дыбысы шығар.
Dialogue: 0,0:20:10.83,0:20:13.52,Default,,0000,0000,0000,,Құлады? Бұл не?
Dialogue: 0,0:20:13.52,0:20:16.22,Default,,0000,0000,0000,,Кеттік. Мүмкін сонда.
Dialogue: 0,0:20:16.22,0:20:18.41,Default,,0000,0000,0000,,Мии! барайық!
Dialogue: 0,0:20:18.41,0:20:20.43,Default,,0000,0000,0000,,Бұл шынымен жақсы ма?
Dialogue: 0,0:20:20.43,0:20:22.12,Default,,0000,0000,0000,,Иә, уайымдамаңыз.
Dialogue: 0,0:20:22.12,0:20:25.98,Default,,0000,0000,0000,,《Себебі Ғабу осында》
Dialogue: 0,0:20:25.98,0:20:29.85,Default,,0000,0000,0000,,«Мен мұны сізге қалдырамын».
Dialogue: 0,0:20:29.85,0:20:31.87,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:20:31.87,0:20:36.42,Default,,0000,0000,0000,,Не? Уфуфу Тапу қорқынышты.
Dialogue: 0,0:20:36.42,0:20:40.42,Default,,0000,0000,0000,,Ей, қорқатын ештеңе жоқ!
Dialogue: 0,0:20:46.69,0:20:51.74,Default,,0000,0000,0000,,Уау! Парапара - бұл Хара!
Dialogue: 0,0:20:51.74,0:20:53.09,Default,,0000,0000,0000,,Хахаха!
Dialogue: 0,0:20:53.09,0:20:57.30,Default,,0000,0000,0000,,Біз келдік! Уууу.
Dialogue: 0,0:20:57.30,0:21:00.99,Default,,0000,0000,0000,,Күрсін.
Dialogue: 0,0:21:00.99,0:21:03.52,Default,,0000,0000,0000,,Уау өте сүйкімді!
Dialogue: 0,0:21:03.52,0:21:06.55,Default,,0000,0000,0000,,Бұл сүйкімді.
Dialogue: 0,0:21:06.55,0:21:08.74,Default,,0000,0000,0000,,Сізді осында көргеніме қуаныштымын.
Dialogue: 0,0:21:08.74,0:21:12.11,Default,,0000,0000,0000,,Әй, бәрі сәбиді көргісі келеді→
Dialogue: 0,0:21:12.11,0:21:16.99,Default,,0000,0000,0000,,Мен сені осында әкелдім. Уау, бұл керемет.
Dialogue: 0,0:21:16.99,0:21:19.85,Default,,0000,0000,0000,,Уууу, бұл керемет.
Dialogue: 0,0:21:19.85,0:21:21.87,Default,,0000,0000,0000,,Жүгіруге барғыңыз келе ме?
Dialogue: 0,0:21:21.87,0:21:23.89,Default,,0000,0000,0000,,Уау, жүгіре аласың ба?
Dialogue: 0,0:21:23.89,0:21:26.89,Default,,0000,0000,0000,,Келіңіздер. Келіңіздер, бұл осылай.
Dialogue: 0,0:21:29.45,0:21:34.66,Default,,0000,0000,0000,,Уау хахаха сүйкімді!
Dialogue: 0,0:21:34.66,0:21:38.88,Default,,0000,0000,0000,,О~ Бұл өте дәмді көрінеді!
Dialogue: 0,0:21:38.88,0:21:43.26,Default,,0000,0000,0000,,Дәмді емес, сүйкімді.
Dialogue: 0,0:21:43.26,0:21:46.26,Default,,0000,0000,0000,,Сау болыңыз, жақында кездескенше!
Dialogue: 0,0:21:53.35,0:21:55.71,Default,,0000,0000,0000,,А, мен оны көріп тұрмын!
Dialogue: 0,0:21:55.71,0:21:59.25,Default,,0000,0000,0000,,Уфуфуфу Яй! Мен қайтып келдім.
Dialogue: 0,0:21:59.25,0:22:02.45,Default,,0000,0000,0000,,Менің қарным ашты.
Dialogue: 0,0:22:02.45,0:22:05.98,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:22:05.98,0:22:07.33,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:22:07.33,0:22:12.88,Default,,0000,0000,0000,,Уф... Әйтеуір, солай болды ғой?
Dialogue: 0,0:22:12.88,0:22:17.88,Default,,0000,0000,0000,,Мен сонда болғаным үшін бәрі аман-есен болды... А?
Dialogue: 0,0:22:22.65,0:22:26.52,Default,,0000,0000,0000,,Әй, үйге қайтайық. Қараңғы түсіп жатыр.
Dialogue: 0,0:22:26.52,0:22:31.90,Default,,0000,0000,0000,,Күрсін... Міне, осы уақытқа дейін келген соң өзімді қауіпсіз сезінемін деп ойлаймын.
Dialogue: 0,0:22:31.90,0:22:34.94,Default,,0000,0000,0000,,Ах! ? Бұл ешкі емес пе?
Dialogue: 0,0:22:34.94,0:22:39.82,Default,,0000,0000,0000,,Барри мырза! ? (Барри) Жақсы көрінеді.
Dialogue: 0,0:22:39.82,0:22:43.53,Default,,0000,0000,0000,,Сіз мұның бәрін өзіңізге қалдыруды ойладыңыз ба? Бұлай болады деп ойламадым...
Dialogue: 0,0:22:43.53,0:22:48.91,Default,,0000,0000,0000,,Хахахаха мен саған көмектесемін. көмек?
Dialogue: 0,0:22:48.91,0:22:51.44,Default,,0000,0000,0000,,Бұл не? Сава Сава тауында жесе жақсы болар еді.
Dialogue: 0,0:22:51.44,0:22:53.46,Default,,0000,0000,0000,,Ах! Ха! ?
Dialogue: 0,0:22:53.46,0:22:55.48,Default,,0000,0000,0000,,Ештеңе.
Dialogue: 0,0:22:55.48,0:22:58.17,Default,,0000,0000,0000,,《Мынаны Ғабуға берейік》
Dialogue: 0,0:22:58.17,0:23:02.04,Default,,0000,0000,0000,,Ах... анау Барри. Эй.
Dialogue: 0,0:23:02.04,0:23:06.08,Default,,0000,0000,0000,,Тағам сізге қарай келе жатыр. Ха! ?
Dialogue: 0,0:23:06.08,0:23:10.63,Default,,0000,0000,0000,,Мамыр, қайда бара жатырсың? Мен бірден қайтамын.
Dialogue: 0,0:23:10.63,0:23:12.48,Default,,0000,0000,0000,,Сіз үнемі осылай айтасыз.
Dialogue: 0,0:23:12.48,0:23:15.34,Default,,0000,0000,0000,,《Мей, неге? 》
Dialogue: 0,0:23:15.34,0:23:17.20,Default,,0000,0000,0000,,Ах! Эй!
Dialogue: 0,0:23:17.20,0:23:20.57,Default,,0000,0000,0000,,Уау! ! 《Габ? 》
Dialogue: 0,0:23:20.57,0:23:23.59,Default,,0000,0000,0000,,Ол!
Dialogue: 0,0:23:23.59,0:23:25.95,Default,,0000,0000,0000,,Бұл қасқыр! Бұл қасқыр! Бұл қасқыр! Бұл қасқыр!
Dialogue: 0,0:23:25.95,0:23:28.64,Default,,0000,0000,0000,,Иә! ? Апыр-ай! ! Апыр-ай! Апыр-ай!
Dialogue: 0,0:23:28.64,0:23:30.16,Default,,0000,0000,0000,,Тапу! Уф….
Dialogue: 0,0:23:30.16,0:23:33.69,Default,,0000,0000,0000,,Уау! Апыр-ай! !
Dialogue: 0,0:23:33.69,0:23:37.40,Default,,0000,0000,0000,,Тапу! Ах~! !
Dialogue: 0,0:23:37.40,0:23:41.93,Default,,0000,0000,0000,,《Егер бұлай болса, мен Барри мырзаның алдында әдейі құлап қаламын.
Dialogue: 0,0:23:41.93,0:23:43.95,Default,,0000,0000,0000,,Бізде соқтығысудан басқа амал жоқ.》
Dialogue: 0,0:23:43.95,0:23:45.48,Default,,0000,0000,0000,,Уау! Апыр-ай!
Dialogue: 0,0:23:45.48,0:23:47.00,Default,,0000,0000,0000,,《Қазір》
Dialogue: 0,0:23:47.00,0:23:50.20,Default,,0000,0000,0000,,Уау! Апыр-ай! О?
Dialogue: 0,0:23:50.20,0:23:54.23,Default,,0000,0000,0000,,Иә! ? аа!
Dialogue: 0,0:23:54.23,0:23:58.77,Default,,0000,0000,0000,,Не? бұл.
Dialogue: 0,0:23:58.77,0:24:00.80,Default,,0000,0000,0000,,Неге бұлай істеп жатырсың?
Dialogue: 0,0:24:00.80,0:24:03.49,Default,,0000,0000,0000,,Мии тұзағы Бұл қауіпті, сондықтан оны жасамаңыз.
Dialogue: 0,0:24:03.49,0:24:06.19,Default,,0000,0000,0000,,Сіз мұны бірнеше рет айттыңыз. Иә.
Dialogue: 0,0:24:06.19,0:24:10.89,Default,,0000,0000,0000,,Қанша айтсам да, түсінбеймін.
Dialogue: 0,0:24:10.89,0:24:14.94,Default,,0000,0000,0000,,Оны жасауды тоқтату үшін қанша айтуым керек?
Dialogue: 0,0:24:14.94,0:24:16.94,Default,,0000,0000,0000,,Ухуху.
Dialogue: 0,0:24:18.44,0:24:24.44,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
