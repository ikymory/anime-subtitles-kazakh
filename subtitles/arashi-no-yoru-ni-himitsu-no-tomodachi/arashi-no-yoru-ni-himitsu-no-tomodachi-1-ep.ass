Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:03:27.83,0:03:29.83,Default,,0000,0000,0000,,(Найзағай)
Dialogue: 0,0:03:31.71,0:03:33.71,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:03:42.14,0:03:44.14,Default,,0000,0000,0000,,Уау! !
Dialogue: 0,0:04:13.96,0:04:17.96,Default,,0000,0000,0000,,Мұнда не болып жатыр? Мен мұнда білмей келдім.
Dialogue: 0,0:04:19.35,0:04:22.35,Default,,0000,0000,0000,,Фу. (шу)
Dialogue: 0,0:04:24.40,0:04:26.26,Default,,0000,0000,0000,,Біреу келді ме?
Dialogue: 0,0:04:26.26,0:04:28.26,Default,,0000,0000,0000,,Жарайды….
Dialogue: 0,0:04:30.96,0:04:32.96,Default,,0000,0000,0000,,Уау! (найзағай)
Dialogue: 0,0:04:40.22,0:04:42.22,Default,,0000,0000,0000,,Ах... иә...
Dialogue: 0,0:04:45.94,0:04:48.94,Default,,0000,0000,0000,,Қасқыр болса ше?
Dialogue: 0,0:04:51.33,0:04:54.53,Default,,0000,0000,0000,,(шу)
Dialogue: 0,0:04:54.53,0:04:56.71,Default,,0000,0000,0000,,Тұяқтардың дыбысы?
Dialogue: 0,0:04:56.71,0:04:59.58,Default,,0000,0000,0000,,(тұяқ дыбысы)
Dialogue: 0,0:04:59.58,0:05:03.28,Default,,0000,0000,0000,,Керемет, бұл ешкі.
Dialogue: 0,0:05:03.28,0:05:06.32,Default,,0000,0000,0000,,Бірақ ол жарақат алған шығар?
Dialogue: 0,0:05:06.32,0:05:10.69,Default,,0000,0000,0000,,А... иә...
Dialogue: 0,0:05:10.69,0:05:14.06,Default,,0000,0000,0000,,Амансың ба? иә! ? иә?
Dialogue: 0,0:05:14.06,0:05:16.25,Default,,0000,0000,0000,,Бұл үлкен дауыл.
Dialogue: 0,0:05:16.25,0:05:19.28,Default,,0000,0000,0000,,Эй... сені біреу емдеді ме?
Dialogue: 0,0:05:19.28,0:05:23.49,Default,,0000,0000,0000,,Хахахаха... Мына жігіт дөрекі болды.
Dialogue: 0,0:05:23.49,0:05:26.51,Default,,0000,0000,0000,,Қап қараңғы, мен тіпті байқамай қалдым.
Dialogue: 0,0:05:26.51,0:05:29.55,Default,,0000,0000,0000,,Мен де жаңа ғана секірдім.
Dialogue: 0,0:05:29.55,0:05:32.74,Default,,0000,0000,0000,,Мен әбден сіңіп кеттім.
Dialogue: 0,0:05:32.74,0:05:36.45,Default,,0000,0000,0000,,Мүлдем... Саған рахмет, аяғым босап қалды→
Dialogue: 0,0:05:36.45,0:05:39.98,Default,,0000,0000,0000,,Бұл өте көп. (шу)
Dialogue: 0,0:05:39.98,0:05:41.16,Default,,0000,0000,0000,,Жақсысың ба?
Dialogue: 0,0:05:41.16,0:05:44.70,Default,,0000,0000,0000,,Не? Мұндай ештеңе жоқ.
Dialogue: 0,0:05:44.70,0:05:48.07,Default,,0000,0000,0000,,Мен үйреніп қалдым. солай ма.
Dialogue: 0,0:05:48.07,0:05:52.78,Default,,0000,0000,0000,,Мен де бір жерде, бірде соқтығысып қалған сияқтымын→
Dialogue: 0,0:05:52.78,0:05:56.15,Default,,0000,0000,0000,,Сіз асығыс едіңіз. Жарайды, дәл солай.
Dialogue: 0,0:05:56.15,0:05:59.68,Default,,0000,0000,0000,,Бірақ сенің келгеніңе жеңілдеп қалдым.
Dialogue: 0,0:05:59.68,0:06:01.04,Default,,0000,0000,0000,,Мен де осындамын.
Dialogue: 0,0:06:01.04,0:06:06.25,Default,,0000,0000,0000,,Дауылды түнде жалғыз қалсаң, өзіңді жалғыз сезіну оңай.
Dialogue: 0,0:06:06.25,0:06:09.45,Default,,0000,0000,0000,,Бұл дұрыс. Хахахаха!
Dialogue: 0,0:06:09.45,0:06:13.15,Default,,0000,0000,0000,,бұл... Бұзушылық!
Dialogue: 0,0:06:13.15,0:06:15.50,Default,,0000,0000,0000,,Әй, менің.
Dialogue: 0,0:06:15.50,0:06:19.88,Default,,0000,0000,0000,,Шамасы, мен коризаны ұстадым.
Dialogue: 0,0:06:19.88,0:06:21.90,Default,,0000,0000,0000,,Мен де.
Dialogue: 0,0:06:21.90,0:06:24.76,Default,,0000,0000,0000,,Сізге рахмет, мен мүлде иіс сезбеймін...
Dialogue: 0,0:06:24.76,0:06:26.78,Default,,0000,0000,0000,,Хакушон!
Dialogue: 0,0:06:26.78,0:06:29.98,Default,,0000,0000,0000,,Сонымен, енді біз тек бір-біріміздің дауысымызды түсінеміз.
Dialogue: 0,0:06:29.98,0:06:31.50,Default,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:06:31.50,0:06:34.53,Default,,0000,0000,0000,,Хехе... хехехе!
Dialogue: 0,0:06:34.53,0:06:36.55,Default,,0000,0000,0000,,Бұл біртүрлі ме?
Dialogue: 0,0:06:36.55,0:06:38.90,Default,,0000,0000,0000,,Иә. Фуфуфуфу….
Dialogue: 0,0:06:38.90,0:06:40.26,Default,,0000,0000,0000,,ше?
Dialogue: 0,0:06:40.26,0:06:42.26,Default,,0000,0000,0000,,Хахахаха! Хахахахаха!
Dialogue: 0,0:06:48.33,0:06:50.19,Default,,0000,0000,0000,,Бұл... бұл жерде бәрі жақсы.
Dialogue: 0,0:06:50.19,0:06:52.88,Default,,0000,0000,0000,,Бұл үлкен мәселе емес.
Dialogue: 0,0:06:52.88,0:06:55.58,Default,,0000,0000,0000,,Мм... сен қайда тұрасың?
Dialogue: 0,0:06:55.58,0:06:59.28,Default,,0000,0000,0000,,А, біз Бакубаку аңғарындамыз.
Dialogue: 0,0:06:59.28,0:07:02.28,Default,,0000,0000,0000,,Не, Бакубаку алқабы?
Dialogue: 0,0:07:05.50,0:07:08.20,Default,,0000,0000,0000,,Ол жақта қауіпті емес пе?
Dialogue: 0,0:07:08.20,0:07:10.39,Default,,0000,0000,0000,,Не? Солай ма?
Dialogue: 0,0:07:10.39,0:07:13.58,Default,,0000,0000,0000,,Бұл сәл тік, бірақ...
Dialogue: 0,0:07:13.58,0:07:15.10,Default,,0000,0000,0000,,Бұл жақсы жер.
Dialogue: 0,0:07:15.10,0:07:17.63,Default,,0000,0000,0000,,Сізде батылдық бар.
Dialogue: 0,0:07:17.63,0:07:19.65,Default,,0000,0000,0000,,Мен Сава Сава тауынанмын.
Dialogue: 0,0:07:19.65,0:07:23.52,Default,,0000,0000,0000,,О! Мен бұған қызғанамын!
Dialogue: 0,0:07:23.52,0:07:25.04,Default,,0000,0000,0000,,Онда жақсы тамақ бар→
Dialogue: 0,0:07:25.04,0:07:28.04,Default,,0000,0000,0000,,Өте көп!
Dialogue: 0,0:07:30.43,0:07:33.12,Default,,0000,0000,0000,,Уау! Күрсіну….
Dialogue: 0,0:07:33.12,0:07:38.17,Default,,0000,0000,0000,,Осындай кезде жақын жерде жақсы тамақ болса екен деп тілеймін.
Dialogue: 0,0:07:38.17,0:07:40.53,Default,,0000,0000,0000,,Түсіндім! Мен де қазір →
Dialogue: 0,0:07:40.53,0:07:43.88,Default,,0000,0000,0000,,Мен де солай ойладым.
Dialogue: 0,0:07:43.88,0:07:47.42,Default,,0000,0000,0000,,Ойлап қарасам, мен көбіне Сава Сава тауынан сәл жоғары тұрамын→
Dialogue: 0,0:07:47.42,0:07:50.29,Default,,0000,0000,0000,,Үлпілдек алқаптың айналасында тамақ жеуге бару оңай.
Dialogue: 0,0:07:50.29,0:07:53.99,Default,,0000,0000,0000,,Уау, қандай кездейсоқтық! Мен де!
Dialogue: 0,0:07:53.99,0:07:56.85,Default,,0000,0000,0000,,Ол жердегі тағам әсіресе жақсы.
Dialogue: 0,0:07:56.85,0:08:00.72,Default,,0000,0000,0000,,Иә, оның да иісі жақсы.
Dialogue: 0,0:08:00.72,0:08:04.60,Default,,0000,0000,0000,,Жұмсақ болса да, құрылымы жақсы.
Dialogue: 0,0:08:04.60,0:08:09.81,Default,,0000,0000,0000,,Сіз оны күнде жеуге болатын едіңіз және одан ешқашан шаршамайсыз.
Dialogue: 0,0:08:09.81,0:08:12.85,Default,,0000,0000,0000,,Бір рет қолданып көргеннен кейін оған тәуелді болу шынымен оңай.
Dialogue: 0,0:08:12.85,0:08:16.22,Default,,0000,0000,0000,,Оны тек есте сақтау шыдамайды!
Dialogue: 0,0:08:16.22,0:08:20.25,Default,,0000,0000,0000,,А... Мен дәл қазір қолымнан келгенше жегім келеді...
Dialogue: 0,0:08:20.25,0:08:23.79,Default,,0000,0000,0000,,Бұл өте дәмді...
Dialogue: 0,0:08:23.79,0:08:25.79,Default,,0000,0000,0000,,Ет! шөп!
Dialogue: 0,0:08:28.66,0:08:30.02,Default,,0000,0000,0000,,Жел... иә?
Dialogue: 0,0:08:30.02,0:08:33.89,Default,,0000,0000,0000,,Сонымен... дұрыс.
Dialogue: 0,0:08:33.89,0:08:35.08,Default,,0000,0000,0000,,Тамақ туралы айтатын болсақ, бұл мен→
Dialogue: 0,0:08:35.08,0:08:38.44,Default,,0000,0000,0000,,Бала кезімде арық болғанмын...
Dialogue: 0,0:08:38.44,0:08:42.97,Default,,0000,0000,0000,,Габ. Егер сіз дұрыс тамақтанбасаңыз →
Dialogue: 0,0:08:42.97,0:08:45.01,Default,,0000,0000,0000,,Әкеңдей мықты қасқыр бола алмайсың.
Dialogue: 0,0:08:45.01,0:08:49.54,Default,,0000,0000,0000,,Өйткені... Мен толып кеттім.
Dialogue: 0,0:08:49.54,0:08:53.58,Default,,0000,0000,0000,,Тамақ ішкеннен кейін олжаны зерттеңіз→
Dialogue: 0,0:08:53.58,0:08:56.62,Default,,0000,0000,0000,,Орындағаннан кейін жаттығу жасаңыз!
Dialogue: 0,0:08:56.62,0:09:02.51,Default,,0000,0000,0000,,Мен көбірек ойнағым келеді.
Dialogue: 0,0:09:02.51,0:09:05.21,Default,,0000,0000,0000,,Қазір мен көп жейтін адаммын→
Dialogue: 0,0:09:05.21,0:09:09.91,Default,,0000,0000,0000,,Ол кезде анам көп же, көп жей бер→
Dialogue: 0,0:09:09.91,0:09:11.93,Default,,0000,0000,0000,,Маған бұл туралы жиі айтатын.
Dialogue: 0,0:09:11.93,0:09:14.79,Default,,0000,0000,0000,,Мен де.
Dialogue: 0,0:09:14.79,0:09:17.83,Default,,0000,0000,0000,,Тамақ ішуге болатын кезде жақсы тамақтану керек →
Dialogue: 0,0:09:17.83,0:09:21.70,Default,,0000,0000,0000,,Төтенше жағдайда жылдам жүгіре алмайсыз! Сонымен...
Dialogue: 0,0:09:21.70,0:09:23.55,Default,,0000,0000,0000,,Дұрыс. Ойран және Комо →
Dialogue: 0,0:09:23.55,0:09:26.58,Default,,0000,0000,0000,,Мен де дәл солай айттым.
Dialogue: 0,0:09:26.58,0:09:30.79,Default,,0000,0000,0000,,Жылдам жүгіре алмасаң, аман қалмайсың! Сонымен...
Dialogue: 0,0:09:30.79,0:09:34.83,Default,,0000,0000,0000,,Ахахха. Мен сияқты.
Dialogue: 0,0:09:34.83,0:09:36.35,Default,,0000,0000,0000,,Ах... Бірақ мен→
Dialogue: 0,0:09:36.35,0:09:40.89,Default,,0000,0000,0000,,Ол менің анам емес, әжем болды.
Dialogue: 0,0:09:40.89,0:09:42.91,Default,,0000,0000,0000,,Әй, әжем.
Dialogue: 0,0:09:42.91,0:09:46.28,Default,,0000,0000,0000,,Анам... кішкентай кезімде.
Dialogue: 0,0:09:46.28,0:09:51.66,Default,,0000,0000,0000,,Солай ма? Менің анам қазірдің өзінде...
Dialogue: 0,0:09:51.66,0:09:53.01,Default,,0000,0000,0000,,Мен...
Dialogue: 0,0:09:53.01,0:09:55.37,Default,,0000,0000,0000,,Біз қандай да бір жағынан ұқсаспыз.
Dialogue: 0,0:09:55.37,0:09:58.40,Default,,0000,0000,0000,,Хехехе... Бұл рас.
Dialogue: 0,0:09:58.40,0:10:01.93,Default,,0000,0000,0000,,Қап қараңғы, тіпті бір-біріміздің жүзімізді де көре алмаймыз→
Dialogue: 0,0:10:01.93,0:10:05.63,Default,,0000,0000,0000,,Шындығында, тіпті олардың жүздері де ұқсас. Хахахаха.
Dialogue: 0,0:10:05.63,0:10:07.16,Default,,0000,0000,0000,,Эххехе... Біртүрлі екен.
Dialogue: 0,0:10:07.16,0:10:10.69,Default,,0000,0000,0000,,(күлкі)
Dialogue: 0,0:10:10.69,0:10:12.69,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:10:17.26,0:10:20.96,Default,,0000,0000,0000,,А... Мен төмен қарадым →
Dialogue: 0,0:10:20.96,0:10:25.83,Default,,0000,0000,0000,,Менің бетімді көрдің бе? Бұл ұқсас болды ма?
Dialogue: 0,0:10:25.83,0:10:27.86,Default,,0000,0000,0000,,Бұл... Мен → деп ойламай тұра алмадым
Dialogue: 0,0:10:27.86,0:10:32.57,Default,,0000,0000,0000,,Көзімді жұмып, көрмедім. Хахаха.
Dialogue: 0,0:10:32.57,0:10:34.59,Default,,0000,0000,0000,,Уау! Апыр-ай!
Dialogue: 0,0:10:34.59,0:10:36.59,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:10:44.69,0:10:46.69,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:10:51.77,0:10:55.47,Default,,0000,0000,0000,,Ал... Мен бұл дыбысқа әлсізмін.
Dialogue: 0,0:10:55.47,0:10:58.66,Default,,0000,0000,0000,,Неліктен бұлай істеп жатырсың? Мен таң қалдым.
Dialogue: 0,0:10:58.66,0:11:02.54,Default,,0000,0000,0000,,Біз шынымен ұқсаспыз.
Dialogue: 0,0:11:02.54,0:11:05.54,Default,,0000,0000,0000,,Негізі, біз де жақсы араласамыз.
Dialogue: 0,0:11:07.09,0:11:09.45,Default,,0000,0000,0000,,Иә! Сіз қалай ойлайсыз?
Dialogue: 0,0:11:09.45,0:11:13.15,Default,,0000,0000,0000,,Келесіде ауа-райы жақсы болған кезде бірге кешкі ас ішейік.
Dialogue: 0,0:11:13.15,0:11:19.21,Default,,0000,0000,0000,,Бұл тамаша. Бұл қорқынышты дауыл болды, мен бұл түн ең нашар болады деп ойладым.
Dialogue: 0,0:11:19.21,0:11:22.21,Default,,0000,0000,0000,,Бұл ең жақсы түн болуы мүмкін.
Dialogue: 0,0:11:25.60,0:11:30.32,Default,,0000,0000,0000,,Ая Боран басылған сияқты. Бұл дұрыс.
Dialogue: 0,0:11:30.32,0:11:35.54,Default,,0000,0000,0000,,Ал, ертең түскі асқа ше?
Dialogue: 0,0:11:35.54,0:11:38.40,Default,,0000,0000,0000,,Жақсы! Дауылдан кейін →
Dialogue: 0,0:11:38.40,0:11:40.92,Default,,0000,0000,0000,,Ауа райы жақсы деп айту оңай.
Dialogue: 0,0:11:40.92,0:11:44.46,Default,,0000,0000,0000,,Қай жерде кездесуіміз керек? Хмм.
Dialogue: 0,0:11:44.46,0:11:46.82,Default,,0000,0000,0000,,Олай болса, сен мұнда не істеп жүрсің?
Dialogue: 0,0:11:46.82,0:11:51.53,Default,,0000,0000,0000,,Ереже болса да, бір-біріміздің жүзімізді көре алмадық.
Dialogue: 0,0:11:51.53,0:11:53.39,Default,,0000,0000,0000,,Олай болса, мен осындамын→
Dialogue: 0,0:11:53.39,0:11:58.60,Default,,0000,0000,0000,,Боранды түнде біреуді кездестірдім деп айту оңай.
Dialogue: 0,0:11:58.60,0:12:03.98,Default,,0000,0000,0000,,Хахаха Дауылды түнде ғана айта аласыз.
Dialogue: 0,0:12:03.98,0:12:08.70,Default,,0000,0000,0000,,Сонымен, сіздің құпия сөзіңіз «дауылды түнде».
Dialogue: 0,0:12:08.70,0:12:10.89,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:12:10.89,0:12:16.94,Default,,0000,0000,0000,,А... Не болды?
Dialogue: 0,0:12:16.94,0:12:21.50,Default,,0000,0000,0000,,Хахаха Мен білмей тұрып, аяғым ұйып қалды.
Dialogue: 0,0:12:21.50,0:12:26.05,Default,,0000,0000,0000,,Хахаха... Алдымен барыңыз. Солай ма?
Dialogue: 0,0:12:26.05,0:12:31.76,Default,,0000,0000,0000,,Олай болса, ертең. иә.
Dialogue: 0,0:12:31.76,0:12:46.76,Default,,0000,0000,0000,,～
Dialogue: 0,0:12:48.93,0:12:54.93,Default,,0000,0000,0000,,Дауылды түнмен қош бол! Дауылды түнде!
Dialogue: 0,0:14:36.02,0:14:54.19,Default,,0000,0000,0000,,(сыбырлау)
Dialogue: 0,0:14:54.19,0:15:25.84,Default,,0000,0000,0000,,～
Dialogue: 0,0:15:25.84,0:15:30.84,Default,,0000,0000,0000,,«Дәмді дәмді түскі ас»
Dialogue: 0,0:15:34.26,0:15:38.63,Default,,0000,0000,0000,,«Дәмді дәмді түскі ас»
Dialogue: 0,0:15:38.63,0:15:42.63,Default,,0000,0000,0000,,«Мен оны күнде жегім келеді».
Dialogue: 0,0:15:48.57,0:15:54.29,Default,,0000,0000,0000,,Дауылды түнде. Дауылды түнде.
Dialogue: 0,0:15:54.29,0:15:58.00,Default,,0000,0000,0000,,Хахаха Дауылды түнде.
Dialogue: 0,0:15:58.00,0:16:02.00,Default,,0000,0000,0000,,Дауылды түн...
Dialogue: 0,0:16:04.22,0:16:08.77,Default,,0000,0000,0000,,Уфуфу... Бірақ мен шынымен таң қалдым.
Dialogue: 0,0:16:08.77,0:16:13.31,Default,,0000,0000,0000,,Сенің қасқыр болғаның. Мен де осындамын.
Dialogue: 0,0:16:13.31,0:16:15.17,Default,,0000,0000,0000,,Мен сені ешкі болады деп күтпедім.
Dialogue: 0,0:16:15.17,0:16:22.23,Default,,0000,0000,0000,,Оның үстіне әкелген сыйы сол төрт жапырақты беде еді.
Dialogue: 0,0:16:22.23,0:16:26.78,Default,,0000,0000,0000,,Өйткені, біз жақсы араласамыз. Мен келісемін.
Dialogue: 0,0:16:26.78,0:16:29.47,Default,,0000,0000,0000,,Бірақ бір-бірімізді қаншалықты жақсы көрсек те →
Dialogue: 0,0:16:29.47,0:16:33.18,Default,,0000,0000,0000,,Сіз қасқырмен түскі ас ішуге уәде бердіңіз→
Dialogue: 0,0:16:33.18,0:16:35.87,Default,,0000,0000,0000,,Мен сене алар емеспін. Гахаха.
Dialogue: 0,0:16:35.87,0:16:37.39,Default,,0000,0000,0000,,Мен сізді ренжіткеніңізге сенімдімін.
Dialogue: 0,0:16:37.39,0:16:41.76,Default,,0000,0000,0000,,Күрішті күрішпен жегенмен бірдей.
Dialogue: 0,0:16:41.76,0:16:43.78,Default,,0000,0000,0000,,Ах... Кешіріңіз.
Dialogue: 0,0:16:43.78,0:16:47.48,Default,,0000,0000,0000,,Хахаха маған бәрібір.
Dialogue: 0,0:16:47.48,0:16:49.18,Default,,0000,0000,0000,,Мені жегің келсе→
Dialogue: 0,0:16:49.18,0:16:52.71,Default,,0000,0000,0000,,Сіз ертерек сонда тамақтанғансыз, солай емес пе?
Dialogue: 0,0:16:52.71,0:16:57.58,Default,,0000,0000,0000,,Иә! ? Жарайды... бұл дұрыс.
Dialogue: 0,0:16:57.58,0:17:01.29,Default,,0000,0000,0000,,Басқаша айтқанда, бірінші кезекте I→
Dialogue: 0,0:17:01.29,0:17:06.84,Default,,0000,0000,0000,,Сырт келбетіне қарамастан, мен достықты бәрінен де жоғары қоямын.
Dialogue: 0,0:17:06.84,0:17:10.88,Default,,0000,0000,0000,,Хэхехе…. Бірақ мен...
Dialogue: 0,0:17:10.88,0:17:14.92,Default,,0000,0000,0000,,Менің достарым мені осылай көрсе, қорқынышты болар еді.
Dialogue: 0,0:17:14.92,0:17:16.27,Default,,0000,0000,0000,,(айқай)
Dialogue: 0,0:17:16.27,0:17:18.79,Default,,0000,0000,0000,,Мен де солай істеймін.
Dialogue: 0,0:17:18.79,0:17:20.48,Default,,0000,0000,0000,,Егер сізді біреу көрсе →
Dialogue: 0,0:17:20.48,0:17:24.52,Default,,0000,0000,0000,,Бұл сөзсіз үлкен мәселе. Міне, солай.
Dialogue: 0,0:17:24.52,0:17:26.21,Default,,0000,0000,0000,,Хехехе.
Dialogue: 0,0:17:26.21,0:17:28.23,Default,,0000,0000,0000,,Не болды? Бұл →
Dialogue: 0,0:17:28.23,0:17:32.77,Default,,0000,0000,0000,,Ешкім білмейтін құпия деп ойласаңыз →
Dialogue: 0,0:17:32.77,0:17:35.97,Default,,0000,0000,0000,,Әйтеуір, кенет өзімді бақытты сезіндім. Хехе.
Dialogue: 0,0:17:35.97,0:17:39.01,Default,,0000,0000,0000,,Сонымен, біз құпия достармыз!
Dialogue: 0,0:17:39.01,0:17:43.01,Default,,0000,0000,0000,,Иә хехехе.
Dialogue: 0,0:17:52.47,0:17:55.00,Default,,0000,0000,0000,,Ах! Ол құлап жатыр!
Dialogue: 0,0:17:55.00,0:17:59.21,Default,,0000,0000,0000,,Ол құлап жатыр.
Dialogue: 0,0:17:59.21,0:18:02.74,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:18:02.74,0:18:06.44,Default,,0000,0000,0000,,Бірақ мен бұған үйреніп қалдым.
Dialogue: 0,0:18:06.44,0:18:09.31,Default,,0000,0000,0000,,Жақсы!
Dialogue: 0,0:18:09.31,0:18:11.31,Default,,0000,0000,0000,,Ах! Ах!
Dialogue: 0,0:18:13.85,0:18:15.87,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:18:15.87,0:18:19.24,Default,,0000,0000,0000,,Менің түскі ас қорабым...
Dialogue: 0,0:18:19.24,0:18:22.77,Default,,0000,0000,0000,,Амансың ба? Хаха….
Dialogue: 0,0:18:22.77,0:18:24.96,Default,,0000,0000,0000,,Әй, мен 2-3 күннен бері тамақ ішкен жоқпын→
Dialogue: 0,0:18:24.96,0:18:26.48,Default,,0000,0000,0000,,Өйткені бұл ақылсыз.
Dialogue: 0,0:18:26.48,0:18:31.02,Default,,0000,0000,0000,,Юбе оның ерекше жейтін адам екенін айтты.
Dialogue: 0,0:18:31.02,0:18:34.06,Default,,0000,0000,0000,,Иә? Сіз мұны айттыңыз ба?
Dialogue: 0,0:18:34.06,0:18:38.26,Default,,0000,0000,0000,,Бұлай айтқаныңызға сенімдімін.
Dialogue: 0,0:18:38.26,0:18:41.96,Default,,0000,0000,0000,,Одан жақсы ма?
Dialogue: 0,0:18:41.96,0:18:44.96,Default,,0000,0000,0000,,Не? Бұл қауіпті.
Dialogue: 0,0:18:46.85,0:18:49.38,Default,,0000,0000,0000,,Ха... Менде түскі ас қорабы жоқ деп ойладым →
Dialogue: 0,0:18:49.38,0:18:52.38,Default,,0000,0000,0000,,Мен кенеттен аштық сезіндім.
Dialogue: 0,0:18:57.78,0:18:59.78,Default,,0000,0000,0000,,Дәмді көрінеді...
Dialogue: 0,0:19:12.27,0:19:14.79,Default,,0000,0000,0000,,Оған қарамаңыз.
Dialogue: 0,0:19:14.79,0:19:17.15,Default,,0000,0000,0000,,Біз келдік. осу?
Dialogue: 0,0:19:17.15,0:19:21.36,Default,,0000,0000,0000,,Жоғарғы жағында. Уау!
Dialogue: 0,0:19:21.36,0:19:24.22,Default,,0000,0000,0000,,Хахаха Yahoo!
Dialogue: 0,0:19:24.22,0:19:28.26,Default,,0000,0000,0000,,Қараңыз. Бұл Үлпілдек алқап.
Dialogue: 0,0:19:28.26,0:19:32.97,Default,,0000,0000,0000,,Рас, мен сонда жиі тамақтанамын...
Dialogue: 0,0:19:32.97,0:19:34.16,Default,,0000,0000,0000,,Не? Жоқ, жоқ…
Dialogue: 0,0:19:34.16,0:19:38.36,Default,,0000,0000,0000,,Мен ондай жерге тамақ ішуге бара алмаймын.
Dialogue: 0,0:19:38.36,0:19:40.38,Default,,0000,0000,0000,,Шынымен бе? Әрине оңай!
Dialogue: 0,0:19:40.38,0:19:44.59,Default,,0000,0000,0000,,Мен ешқашан ешкінің етін жеген емеспін!
Dialogue: 0,0:19:44.59,0:19:47.95,Default,,0000,0000,0000,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:19:47.95,0:19:49.30,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:19:49.30,0:19:54.19,Default,,0000,0000,0000,,Олай болса, түскі ас ішеміз бе? А, мен түсінемін...
Dialogue: 0,0:19:54.19,0:19:58.73,Default,,0000,0000,0000,,Мен оны тастадым. Бұл солай.
Dialogue: 0,0:19:58.73,0:20:04.62,Default,,0000,0000,0000,,Менің шөпімнің жартысын жей аласың ба? шөп! ?
Dialogue: 0,0:20:04.62,0:20:08.99,Default,,0000,0000,0000,,Өйткені, бұл ет болуы керек, солай ма?
Dialogue: 0,0:20:08.99,0:20:10.35,Default,,0000,0000,0000,,Жоқ… бұл….
Dialogue: 0,0:20:10.35,0:20:12.87,Default,,0000,0000,0000,,Ах! Мен бұрын түсірген түскі ас қорабы →
Dialogue: 0,0:20:12.87,0:20:15.90,Default,,0000,0000,0000,,Бұл ешкі еті шығар...
Dialogue: 0,0:20:15.90,0:20:18.26,Default,,0000,0000,0000,,О, бұл неткен сұмдық!
Dialogue: 0,0:20:18.26,0:20:22.13,Default,,0000,0000,0000,,Мен жек көретін жалғыз нәрсе - ешкі еті!
Dialogue: 0,0:20:22.13,0:20:25.67,Default,,0000,0000,0000,,Хахаха хахаха….
Dialogue: 0,0:20:25.67,0:20:29.87,Default,,0000,0000,0000,,Дұрыс. Әрине!
Dialogue: 0,0:20:29.87,0:20:32.56,Default,,0000,0000,0000,,Өтінемін, мен үшін алаңдамай тамақ ішіңіз.
Dialogue: 0,0:20:32.56,0:20:35.76,Default,,0000,0000,0000,,Осы арада мен ұйықтай аламын.
Dialogue: 0,0:20:35.76,0:20:37.45,Default,,0000,0000,0000,,Мен...
Dialogue: 0,0:20:37.45,0:20:40.98,Default,,0000,0000,0000,,Олай болса, сөзіңізді қабыл алыңыз...
Dialogue: 0,0:20:40.98,0:20:44.98,Default,,0000,0000,0000,,Уууу. Мен оны аламын!
Dialogue: 0,0:20:46.54,0:20:49.91,Default,,0000,0000,0000,,《Егер сізде бенто қорапшасы бар десеңіз, онда →
Dialogue: 0,0:20:49.91,0:20:52.60,Default,,0000,0000,0000,,Иә, бар. Артында...
Dialogue: 0,0:20:52.60,0:20:55.13,Default,,0000,0000,0000,,Ах, қарным ашты...
Dialogue: 0,0:20:55.13,0:20:59.17,Default,,0000,0000,0000,,Ойлап қарасаңыз, мен оны кішкентайымнан жеп келемін...
Dialogue: 0,0:20:59.17,0:21:01.69,Default,,0000,0000,0000,,Маған қарашы →
Dialogue: 0,0:21:01.69,0:21:04.06,Default,,0000,0000,0000,,Мен мұның дәмін түсінемін.
Dialogue: 0,0:21:04.06,0:21:07.08,Default,,0000,0000,0000,,Бұл жігіт сөзсіз жақсы.
Dialogue: 0,0:21:07.08,0:21:11.12,Default,,0000,0000,0000,,Майлы болғаны сонша, аузыңа тарайды...
Dialogue: 0,0:21:11.12,0:21:15.00,Default,,0000,0000,0000,,Тамақ бергеніңіз үшін рахмет!
Dialogue: 0,0:21:15.00,0:21:17.52,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:21:17.52,0:21:20.55,Default,,0000,0000,0000,,Ішің ісіп кетсе→
Dialogue: 0,0:21:20.55,0:21:24.43,Default,,0000,0000,0000,,Мен кенеттен ұйықтап кеттім.
Dialogue: 0,0:21:24.43,0:21:27.62,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:21:27.62,0:21:33.17,Default,,0000,0000,0000,,(ұйықтау)
Dialogue: 0,0:21:33.17,0:21:36.88,Default,,0000,0000,0000,,《Мына жігіт шынымен жақсы, солай емес пе?
Dialogue: 0,0:21:36.88,0:21:39.90,Default,,0000,0000,0000,,Жегені дәмді болса да→
Dialogue: 0,0:21:39.90,0:21:43.90,Default,,0000,0000,0000,,Аа, мен тістеп алайын ба? 》
Dialogue: 0,0:21:45.80,0:21:49.50,Default,,0000,0000,0000,,《Аа, жақсы иіс шығады.
Dialogue: 0,0:21:49.50,0:21:52.03,Default,,0000,0000,0000,,Бірақ ол бәрібір ауырса керек...
Dialogue: 0,0:21:52.03,0:21:54.22,Default,,0000,0000,0000,,Қан болатын шығар...》
Dialogue: 0,0:21:54.22,0:21:57.42,Default,,0000,0000,0000,,«Аа, сен мені алдадың ғой...
Dialogue: 0,0:21:57.42,0:22:00.62,Default,,0000,0000,0000,,Сонда мені тамақ ішейін деп осында әкелдің бе? ».
Dialogue: 0,0:22:00.62,0:22:02.80,Default,,0000,0000,0000,,«Жоқ~ жоқ жоқ →
Dialogue: 0,0:22:02.80,0:22:05.33,Default,,0000,0000,0000,,Мен оның дәмін біраз көрдім.''
Dialogue: 0,0:22:05.33,0:22:09.54,Default,,0000,0000,0000,,«Мен енді сенің айтқаныңа сенбеймін».
Dialogue: 0,0:22:09.54,0:22:11.72,Default,,0000,0000,0000,,«Маған сеніңізші.
Dialogue: 0,0:22:11.72,0:22:13.08,Default,,0000,0000,0000,,Мені дос деп санау оңай.''
Dialogue: 0,0:22:13.08,0:22:15.27,Default,,0000,0000,0000,,«Ой, құлағым жеп қалды→
Dialogue: 0,0:22:15.27,0:22:18.13,Default,,0000,0000,0000,,Біз дос бола алмаймыз! »
Dialogue: 0,0:22:18.13,0:22:24.52,Default,,0000,0000,0000,,Уф, бәрі осылай болады.
Dialogue: 0,0:22:24.52,0:22:26.71,Default,,0000,0000,0000,,Күрсін.
Dialogue: 0,0:22:26.71,0:22:28.23,Default,,0000,0000,0000,,Уфуфуфуфу! Апыр-ай!
Dialogue: 0,0:22:28.23,0:22:31.26,Default,,0000,0000,0000,,Өтінемін. Ха! ?
Dialogue: 0,0:22:31.26,0:22:36.14,Default,,0000,0000,0000,,Мен қытық адаммын, әсіресе құлағым нашар.
Dialogue: 0,0:22:36.14,0:22:38.66,Default,,0000,0000,0000,,Иә! ?
Dialogue: 0,0:22:38.66,0:22:42.86,Default,,0000,0000,0000,,Мм, мен жақсы ұйықтадым.
Dialogue: 0,0:22:42.86,0:22:44.22,Default,,0000,0000,0000,,Өтірікші ит
Dialogue: 0,0:22:44.22,0:22:46.91,Default,,0000,0000,0000,,Иә? Не болды?
Dialogue: 0,0:22:46.91,0:22:49.44,Default,,0000,0000,0000,,Жоқ... бұл ештеңе емес!
Dialogue: 0,0:22:49.44,0:22:53.98,Default,,0000,0000,0000,,Уфуфуфу! Бұл біртүрлі!
Dialogue: 0,0:22:53.98,0:22:57.85,Default,,0000,0000,0000,,Олай болса, қазір үйге қайтайық.
Dialogue: 0,0:22:57.85,0:22:59.85,Default,,0000,0000,0000,,Жарайды... дұрыс.
Dialogue: 0,0:23:04.42,0:23:06.42,Default,,0000,0000,0000,,(Іштің ырылдаған дыбысы)
Dialogue: 0,0:23:16.04,0:23:20.92,Default,,0000,0000,0000,,Міне, біз қоштасамыз.
Dialogue: 0,0:23:20.92,0:23:23.44,Default,,0000,0000,0000,,Ха! Сол 100 йендік тиынды таста! Ора!
Dialogue: 0,0:23:23.44,0:23:26.13,Default,,0000,0000,0000,,(Хироко) Һм? О…
Dialogue: 0,0:23:26.13,0:23:28.49,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:23:28.49,0:23:34.05,Default,,0000,0000,0000,,Онда мен осындамын.
Dialogue: 0,0:23:34.05,0:23:37.25,Default,,0000,0000,0000,,Бүгінгі күн өте қызық болды.
Dialogue: 0,0:23:37.25,0:23:39.25,Default,,0000,0000,0000,,Қош бол...
Dialogue: 0,0:23:43.64,0:23:48.69,Default,,0000,0000,0000,,Өйткені, мен бұған шыдай алмаймын!
Dialogue: 0,0:23:48.69,0:23:51.55,Default,,0000,0000,0000,,(қабығы)
Dialogue: 0,0:23:51.55,0:23:53.91,Default,,0000,0000,0000,,Ах! Апыр-ай!
Dialogue: 0,0:23:53.91,0:23:55.77,Default,,0000,0000,0000,,Гаруру...!
Dialogue: 0,0:23:55.77,0:23:58.46,Default,,0000,0000,0000,,Не... не болды? ?
Dialogue: 0,0:23:58.46,0:24:02.00,Default,,0000,0000,0000,,Мен бір маңызды нәрсені ұмытып қалдым.
Dialogue: 0,0:24:02.00,0:24:05.37,Default,,0000,0000,0000,,Не... неге?
Dialogue: 0,0:24:05.37,0:24:10.58,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:24:10.58,0:24:16.80,Default,,0000,0000,0000,,Хмм... Мен қатты тітіркеніп кеттім!
Dialogue: 0,0:24:16.80,0:24:18.66,Default,,0000,0000,0000,,Ех! ?
Dialogue: 0,0:24:18.66,0:24:20.51,Default,,0000,0000,0000,,Сонымен→
Dialogue: 0,0:24:20.51,0:24:24.05,Default,,0000,0000,0000,,Келесі жолы...
Dialogue: 0,0:24:24.05,0:24:26.24,Default,,0000,0000,0000,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:24:26.24,0:24:30.28,Default,,0000,0000,0000,,Келесі жолы қашан кездесеміз? ?
Dialogue: 0,0:24:30.28,0:24:32.30,Default,,0000,0000,0000,,М-м-мұнда… мұнда… мұнда… осы зат!
Dialogue: 0,0:24:32.30,0:24:34.30,Default,,0000,0000,0000,,Ахахаха….
Dialogue: 0,0:24:35.80,0:24:41.80,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
