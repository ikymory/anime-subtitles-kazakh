Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:02:57.79,0:02:59.79,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:03:05.70,0:03:07.70,Default,,0,0,0,,(сыбырлау)
Dialogue: 0,0:03:10.25,0:03:13.25,Default,,0,0,0,,Бүгін бұл жерден шығу оңай болды.
Dialogue: 0,0:03:20.36,0:03:24.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:24.40,0:03:27.59,Default,,0,0,0,,Мүмкін мен сәл ерте келген шығармын?
Dialogue: 0,0:03:27.59,0:03:33.32,Default,,0,0,0,,(сыбырлау)
Dialogue: 0,0:03:33.32,0:03:35.32,Default,,0,0,0,,Уау, бұл...
Dialogue: 0,0:03:37.36,0:03:41.23,Default,,0,0,0,,Иә! Ха! Фуфуфу….
Dialogue: 0,0:03:41.23,0:03:43.25,Default,,0,0,0,,Жіңішке мүйіздер.
Dialogue: 0,0:03:43.25,0:03:47.25,Default,,0,0,0,,Әй, қызық, Ғабу кигізсе не болады?
Dialogue: 0,0:03:52.51,0:03:55.51,Default,,0,0,0,,Мынаны Ғабуға сыйлыққа берейік.
Dialogue: 0,0:04:00.25,0:04:05.25,Default,,0,0,0,,Уау, бұл сирек! Қандай жасыл гүл...
Dialogue: 0,0:04:21.80,0:04:25.34,Default,,0,0,0,,2 адам: Уау!
Dialogue: 0,0:04:25.34,0:04:27.03,Default,,0,0,0,,Қандай әдемі!
Dialogue: 0,0:04:27.03,0:04:29.55,Default,,0,0,0,,Бұл әдемі.
Dialogue: 0,0:04:29.55,0:04:33.25,Default,,0,0,0,,Сізге қай түсті көбірек ұнатасыз?
Dialogue: 0,0:04:33.25,0:04:35.43,Default,,0,0,0,,Бұл ең жақсысы ма?
Dialogue: 0,0:04:35.43,0:04:38.13,Default,,0,0,0,,Хмм... бәрі әдемі.
Dialogue: 0,0:04:38.13,0:04:42.67,Default,,0,0,0,,Дұрыс.Ең бастысы жасыл.
Dialogue: 0,0:04:42.67,0:04:44.03,Default,,0,0,0,,Эй, жасыл?
Dialogue: 0,0:04:44.03,0:04:46.55,Default,,0,0,0,,Көктем келсе, бәрі бірден
Dialogue: 0,0:04:46.55,0:04:49.91,Default,,0,0,0,,Ашық жасыл жапырақтар өсіп тұр ма?
Dialogue: 0,0:04:49.91,0:04:55.64,Default,,0,0,0,,Сол түсті көргенде мен өзімді сергек, жарқын сезінемін.
Dialogue: 0,0:04:55.64,0:04:57.64,Default,,0,0,0,,Сен екеуің алда барыңдар!
Dialogue: 0,0:05:02.87,0:05:06.75,Default,,0,0,0,,Желдің бағытына байланысты.
Dialogue: 0,0:05:06.75,0:05:09.78,Default,,0,0,0,,Маған орман жағынан айналу пішіні ұнайды.
Dialogue: 0,0:05:09.78,0:05:11.97,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:05:11.97,0:05:14.83,Default,,0,0,0,,Сонда біз өзеннен болдық.
Dialogue: 0,0:05:14.83,0:05:17.19,Default,,0,0,0,,Әй, Ғабу! Иә, иә!
Dialogue: 0,0:05:17.19,0:05:21.06,Default,,0,0,0,,Бұрынғыдай араласпа.
Dialogue: 0,0:05:21.06,0:05:24.92,Default,,0,0,0,,Жақсы! Эй, солай...
Dialogue: 0,0:05:24.92,0:05:26.92,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:05:29.47,0:05:32.51,Default,,0,0,0,,Келесі жолы олар Соросоло тауында ешкі ауламақшы.
Dialogue: 0,0:05:32.51,0:05:35.71,Default,,0,0,0,,Уау, мен өте қуаныштымын! Мен ешкілерді жақсы көремін!
Dialogue: 0,0:05:35.71,0:05:37.89,Default,,0,0,0,,Мен де!
Dialogue: 0,0:05:37.89,0:05:42.94,Default,,0,0,0,,Өйткені, менің идеалды түрім – Мистер Джило.
Dialogue: 0,0:05:42.94,0:05:45.14,Default,,0,0,0,,Иә! Джиро-сан күшті және керемет.
Dialogue: 0,0:05:45.14,0:05:49.68,Default,,0,0,0,,Мен сенің не ойлайтыныңды білмеймін және бұл аздап қорқынышты.
Dialogue: 0,0:05:49.68,0:05:52.71,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Мәселе осы емес пе?
Dialogue: 0,0:05:52.71,0:05:56.41,Default,,0,0,0,,Бұл бір жұмбақ... Эй, Лала?
Dialogue: 0,0:05:56.41,0:06:00.11,Default,,0,0,0,,Сіз қалай ойлайсыз? Мен шынымен түсінбеймін.
Dialogue: 0,0:06:00.11,0:06:02.81,Default,,0,0,0,,Өйткені, сіз Фурараға қол жеткізе аласыз.
Dialogue: 0,0:06:02.81,0:06:05.17,Default,,0,0,0,,Міне қандай әдемі.
Dialogue: 0,0:06:05.17,0:06:09.21,Default,,0,0,0,,Дәлірек айтсақ, Лала ағаның баласы.
Dialogue: 0,0:06:09.21,0:06:12.57,Default,,0,0,0,,2 саны ағайын болса
Dialogue: 0,0:06:12.57,0:06:15.10,Default,,0,0,0,,Әрине, сіздің идеалдарыңыз да жоғары болады.
Dialogue: 0,0:06:15.10,0:06:18.10,Default,,0,0,0,,Иә? Бұл дұрыс емес.
Dialogue: 0,0:06:23.19,0:06:25.87,Default,,0,0,0,,Сәлем Лала!
Dialogue: 0,0:06:25.87,0:06:28.57,Default,,0,0,0,,Сен әдеттегідей әдемісің, Лала-сан.
Dialogue: 0,0:06:28.57,0:06:31.43,Default,,0,0,0,,Камado Танжиро.
Dialogue: 0,0:06:31.43,0:06:34.96,Default,,0,0,0,,Ол мистер Барриге ұқсамайды.
Dialogue: 0,0:06:34.96,0:06:36.65,Default,,0,0,0,,Бірдеңе айттыңыз ба?
Dialogue: 0,0:06:36.65,0:06:39.65,Default,,0,0,0,,А, жоқ... ештеңе.
Dialogue: 0,0:06:49.61,0:06:52.81,Default,,0,0,0,,Тағы да. не?
Dialogue: 0,0:06:52.81,0:06:57.52,Default,,0,0,0,,Ол әлдебір күдікпен, жасырынып жүр...
Dialogue: 0,0:06:57.52,0:07:00.72,Default,,0,0,0,,Ол кім?
Dialogue: 0,0:07:00.72,0:07:05.10,Default,,0,0,0,,Ғабу, сен бұл күндері бір жаққа жалғыз шығасың, солай ма?
Dialogue: 0,0:07:05.10,0:07:07.63,Default,,0,0,0,,(Изуна) Ә? (Сора) Қашан?
Dialogue: 0,0:07:07.63,0:07:11.99,Default,,0,0,0,,Білмеймін... Маған мүлдем қызық емес.
Dialogue: 0,0:07:11.99,0:07:14.02,Default,,0,0,0,,Біреу, басқа топтың қызы сияқты.
Dialogue: 0,0:07:14.02,0:07:16.55,Default,,0,0,0,,Ол маған қонаққа келе жатқандай сезіндім.
Dialogue: 0,0:07:16.55,0:07:18.24,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:07:18.24,0:07:23.45,Default,,0,0,0,,Әлсіз, әлсіреген, әбден зеріктіретін адам ше?
Dialogue: 0,0:07:23.45,0:07:26.98,Default,,0,0,0,,Мүмкін емес. (2 адам) Ахаха!
Dialogue: 0,0:07:26.98,0:07:28.98,Default,,0,0,0,,Сондықтан. (2 адам) Лала?
Dialogue: 0,0:07:33.54,0:07:35.54,Default,,0,0,0,,Сасаса!
Dialogue: 0,0:07:38.10,0:07:40.29,Default,,0,0,0,,Мен музыка колледжінде Саки Аримамен бір курс болғанмын, сондықтан→
Dialogue: 0,0:07:40.29,0:07:43.82,Default,,0,0,0,,Қайда бара жатырсың? шеңбер! сурет?
Dialogue: 0,0:07:43.82,0:07:45.34,Default,,0,0,0,,Лара мырза?
Dialogue: 0,0:07:45.34,0:07:49.37,Default,,0,0,0,,Жалықсаң Лала жақсы.
Dialogue: 0,0:07:49.37,0:07:51.39,Default,,0,0,0,,Жоқ, хаха... бірақ….
Dialogue: 0,0:07:51.39,0:07:57.12,Default,,0,0,0,,Бұлай сөйлескенімізге көп болды, тек екеуміз.
Dialogue: 0,0:07:57.12,0:08:01.12,Default,,0,0,0,,А, мен солай ойлаймын.
Dialogue: 0,0:08:03.02,0:08:05.54,Default,,0,0,0,,Бэри: Сенің кезегің, Габи!
Dialogue: 0,0:08:05.54,0:08:07.06,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:08:07.06,0:08:10.08,Default,,0,0,0,,Сіз шынымен қорқасыз ба? (Бэрри) Сен жалқаусың, Габ!
Dialogue: 0,0:08:10.08,0:08:12.77,Default,,0,0,0,,Күн батып барады.
Dialogue: 0,0:08:12.77,0:08:14.96,Default,,0,0,0,,Тез секір, Ғабу!
Dialogue: 0,0:08:14.96,0:08:17.96,Default,,0,0,0,,Ахх...
Dialogue: 0,0:08:21.69,0:08:23.21,Default,,0,0,0,,Күтілгендей, жоқ!
Dialogue: 0,0:08:23.21,0:08:26.91,Default,,0,0,0,,Ой-ой!
Dialogue: 0,0:08:26.91,0:08:28.91,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:33.15,0:08:36.68,Default,,0,0,0,,Хахаха, жоқ, Габу.
Dialogue: 0,0:08:36.68,0:08:41.06,Default,,0,0,0,,Сен әлі қасқырсың ба? үшінмыз барайық.
Dialogue: 0,0:08:41.06,0:08:43.42,Default,,0,0,0,,Құлайтындай… Бұл қылыш…
Dialogue: 0,0:08:43.42,0:08:45.42,Default,,0,0,0,,Уау.
Dialogue: 0,0:08:59.75,0:09:04.29,Default,,0,0,0,,Секіре алмасаң жақсы. сурет?
Dialogue: 0,0:09:04.29,0:09:06.82,Default,,0,0,0,,Бүгін секіре алмасам да→
Dialogue: 0,0:09:06.82,0:09:11.03,Default,,0,0,0,,Ертең немесе келесі күні секіру үшін бар күшімді сала алсам →
Dialogue: 0,0:09:11.03,0:09:14.73,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:09:14.73,0:09:17.73,Default,,0,0,0,,Күте тұрыңыз, ағайын!
Dialogue: 0,0:09:21.13,0:09:24.49,Default,,0,0,0,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,0:09:24.49,0:09:27.52,Default,,0,0,0,,Шынында да, сол уақыттан бері →
Dialogue: 0,0:09:27.52,0:09:31.22,Default,,0,0,0,,Біз ешқашан жалғыз сөйлескен емеспіз.
Dialogue: 0,0:09:31.22,0:09:34.76,Default,,0,0,0,,Әй, қайда бара жатырсың? сурет?
Dialogue: 0,0:09:34.76,0:09:36.61,Default,,0,0,0,,Менің қайда бара жатқанымды сұрап тұрсың ба?
Dialogue: 0,0:09:36.61,0:09:41.16,Default,,0,0,0,,Ааа, еш жерде емес...
Dialogue: 0,0:09:41.16,0:09:42.34,Default,,0,0,0,,Біраз жабайы нәрсе.
Dialogue: 0,0:09:42.34,0:09:45.87,Default,,0,0,0,,Мен де сенімен бірге барғым келеді.
Dialogue: 0,0:09:45.87,0:09:48.06,Default,,0,0,0,,Не? Неге бұлай істеп жатырсың?
Dialogue: 0,0:09:48.06,0:09:52.10,Default,,0,0,0,,Мен сенімен барғым келеді дедім.
Dialogue: 0,0:09:52.10,0:09:54.96,Default,,0,0,0,,Сіздермен бірге! ? Бірге шығамыз ба?
Dialogue: 0,0:09:54.96,0:09:59.51,Default,,0,0,0,,Хэхехе! Габи: Басқа ешкім жоқ.
Dialogue: 0,0:09:59.51,0:10:03.04,Default,,0,0,0,,А, бұл...
Dialogue: 0,0:10:03.04,0:10:08.09,Default,,0,0,0,,А, жоқ, бұл жақсы емес.
Dialogue: 0,0:10:08.09,0:10:11.46,Default,,0,0,0,,Жоқ? Неліктен?
Dialogue: 0,0:10:11.46,0:10:15.66,Default,,0,0,0,,Жоқ, мен не айтарымды білмеймін...
Dialogue: 0,0:10:15.66,0:10:20.22,Default,,0,0,0,,Түсіндім, сенің мен айта алмайтын құпия себебің бар.
Dialogue: 0,0:10:20.22,0:10:25.76,Default,,0,0,0,,Құпия! ? Құпия деген мүлдем жоқ.
Dialogue: 0,0:10:25.76,0:10:27.79,Default,,0,0,0,,Онда неге болмасқа?
Dialogue: 0,0:10:27.79,0:10:30.65,Default,,0,0,0,,Міне...
Dialogue: 0,0:10:30.65,0:10:33.85,Default,,0,0,0,,Шынында да...
Dialogue: 0,0:10:33.85,0:10:36.21,Default,,0,0,0,,Ах! Шын мәнінде, мен →
Dialogue: 0,0:10:36.21,0:10:39.57,Default,,0,0,0,,Мен аңыз бойынша тек ер адамдар бару керек деген жерге барамын.
Dialogue: 0,0:10:39.57,0:10:41.76,Default,,0,0,0,,Тек ер адамдар?
Dialogue: 0,0:10:41.76,0:10:44.62,Default,,0,0,0,,Иә, тек ер адамдар.
Dialogue: 0,0:10:44.62,0:10:46.65,Default,,0,0,0,,Мен мұндай аңызды естімеппін.
Dialogue: 0,0:10:46.65,0:10:49.67,Default,,0,0,0,,Бұл туралы тек ер адамдар біледі.
Dialogue: 0,0:10:49.67,0:10:53.38,Default,,0,0,0,,Уау, бұл керемет. сурет?
Dialogue: 0,0:10:53.38,0:10:57.08,Default,,0,0,0,,Бұл өте қауіпті жер болуы керек.
Dialogue: 0,0:10:57.08,0:11:00.11,Default,,0,0,0,,Мұндай жерге жалғыз қалай баруға болады?→
Dialogue: 0,0:11:00.11,0:11:05.50,Default,,0,0,0,,Бұл күшті. А, жоқ, онша емес.
Dialogue: 0,0:11:05.50,0:11:07.02,Default,,0,0,0,,Ғабумен бірге барғым келді→
Dialogue: 0,0:11:07.02,0:11:10.22,Default,,0,0,0,,Олай болса, оған көмектесу мүмкін емес деп ойлаймын. Ха.
Dialogue: 0,0:11:10.22,0:11:13.75,Default,,0,0,0,,Олай болса, маған кәдесый беріңізші.
Dialogue: 0,0:11:13.75,0:11:16.44,Default,,0,0,0,,ше? Сіз оны кәдесый ретінде алғыңыз келе ме?
Dialogue: 0,0:11:16.44,0:11:20.98,Default,,0,0,0,,Сізге бұл ұнамайды ма? Мен оны ұнатпайтыныма сене алар емеспін.
Dialogue: 0,0:11:20.98,0:11:24.69,Default,,0,0,0,,Олай болса, маған уәде бер. Иә, бұл уәде.
Dialogue: 0,0:11:24.69,0:11:29.69,Default,,0,0,0,,Кешке тағы да осында. Мен кешке тағы боламын.
Dialogue: 0,0:11:33.44,0:11:36.64,Default,,0,0,0,,Ғабтың қайда бара жатқанын сұрамағаныңа қуандың ба?
Dialogue: 0,0:11:36.64,0:11:40.68,Default,,0,0,0,,Неліктен кәдесыйлармен алаңдадың?
Dialogue: 0,0:11:40.68,0:11:43.88,Default,,0,0,0,,Мен оны жүзуге мәжбүр еттім. (2 адам) Иә?
Dialogue: 0,0:11:43.88,0:11:46.88,Default,,0,0,0,,Хэхехе! (2 адам) Лала!
Dialogue: 0,0:11:58.19,0:12:00.71,Default,,0,0,0,,Хэхехе!
Dialogue: 0,0:12:00.71,0:12:02.71,Default,,0,0,0,,Уау~ Фуфуфуфу!
Dialogue: 0,0:12:09.81,0:12:15.20,Default,,0,0,0,,Хмм, Ғабу, саған ұнайды деген үміттемін. Хехехе!
Dialogue: 0,0:12:15.20,0:12:19.40,Default,,0,0,0,,мамыр! Габ!
Dialogue: 0,0:12:19.40,0:12:22.60,Default,,0,0,0,,Хахаха! Хехехе!
Dialogue: 0,0:12:22.60,0:12:24.79,Default,,0,0,0,,Жоқ, мен қатты шаршадым...
Dialogue: 0,0:12:24.79,0:12:28.33,Default,,0,0,0,,Ой, қасқыр ғой!
Dialogue: 0,0:12:28.33,0:12:30.83,Default,,0,0,0,,Ей, мен келдім, Май!
Dialogue: 0,0:12:26.65,0:12:28.65,Default,,0,0,0,,Хэхехе!
Dialogue: 0,0:12:28.65,0:12:31.65,Default,,0,0,0,,Әй, сен бүгін осылай айтып тұрсың ба?
Dialogue: 0,0:12:31.65,0:12:33.65,Default,,0,0,0,,Әрине мен қасқырмын.
Dialogue: 0,0:12:33.65,0:12:36.65,Default,,0,0,0,,Гао! маған көмектесші!
Dialogue: 0,0:12:36.65,0:12:41.65,Default,,0,0,0,,Маған біреу көмектессін! Мен сенің қашуыңа жол бермеймін!
Dialogue: 0,0:12:41.65,0:12:43.65,Default,,0,0,0,,Ешкі аулауды бастады!
Dialogue: 0,0:12:43.65,0:12:47.65,Default,,0,0,0,,Бір ғана адам? Керемет Уау!
Dialogue: 0,0:12:47.65,0:12:50.65,Default,,0,0,0,,Лалаға арналған кәдесый?
Dialogue: 0,0:14:28.65,0:14:30.65,Default,,0,0,0,,Гао! Кя!
Dialogue: 0,0:14:30.65,0:14:34.65,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:34.65,0:14:37.65,Default,,0,0,0,,Гао! Хахаха Уау! !
Dialogue: 0,0:14:37.65,0:14:40.65,Default,,0,0,0,,Эй, маған көмектес!
Dialogue: 0,0:14:40.65,0:14:44.65,Default,,0,0,0,,Лараға кәдесый үшін.
Dialogue: 0,0:14:44.65,0:14:47.65,Default,,0,0,0,,Өз бетімен ешкі аулау.
Dialogue: 0,0:14:47.65,0:14:49.65,Default,,0,0,0,,Уау! не?
Dialogue: 0,0:14:49.65,0:14:52.65,Default,,0,0,0,,Жақсы, жақсы, Лара.
Dialogue: 0,0:14:52.65,0:14:54.65,Default,,0,0,0,,Балалар мен сендерге де беремін.
Dialogue: 0,0:14:54.65,0:14:56.65,Default,,0,0,0,,Шынымен! ?
Dialogue: 0,0:14:56.65,0:14:58.65,Default,,0,0,0,,Мен ешкілерді жақсы көремін, бірақ→
Dialogue: 0,0:14:58.65,0:15:01.65,Default,,0,0,0,,Мен жалғыз балықты жей алмаймын.
Dialogue: 0,0:15:01.65,0:15:06.65,Default,,0,0,0,,Өте бақытты! Күткендей, Лала - ең жақсы!
Dialogue: 0,0:15:06.65,0:15:10.65,Default,,0,0,0,,Өтінемін, Ғабу! Хехехе.
Dialogue: 0,0:15:10.65,0:15:13.65,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:13.65,0:15:19.65,Default,,0,0,0,,Кя! ! Апыр-ай! Гао Гао! !
Dialogue: 0,0:15:19.65,0:15:21.65,Default,,0,0,0,,Гао! Кя! !
Dialogue: 0,0:15:21.65,0:15:25.65,Default,,0,0,0,,Ұсталды! Алақай! Жақсы, Ғабу.
Dialogue: 0,0:15:27.65,0:15:30.65,Default,,0,0,0,,Ах! Мен қашып құтылдым. Бұл жақсы емес, Ғабе.
Dialogue: 0,0:15:30.65,0:15:34.65,Default,,0,0,0,,Сәттілік! Берілме балам.
Dialogue: 0,0:15:34.65,0:15:37.65,Default,,0,0,0,,Кя! ! Гао! Күте тұрыңыз.
Dialogue: 0,0:15:46.65,0:15:48.65,Default,,0,0,0,,Кяаа! ! Гао!
Dialogue: 0,0:15:48.65,0:15:51.65,Default,,0,0,0,,Иә! ? Қанекей жүгірейік.
Dialogue: 0,0:15:51.65,0:15:53.65,Default,,0,0,0,,Габу? Гао!
Dialogue: 0,0:15:53.65,0:15:55.65,Default,,0,0,0,,Осылай жүгіруді жалғастырыңыз→
Dialogue: 0,0:15:55.65,0:15:58.65,Default,,0,0,0,,Жар астындағы үңгірге тығылу.
Dialogue: 0,0:15:58.65,0:16:00.65,Default,,0,0,0,,Иә, түсіндім.
Dialogue: 0,0:16:07.65,0:16:10.65,Default,,0,0,0,,Әй, мен Ғабудың ізін жоғалттым.
Dialogue: 0,0:16:10.65,0:16:13.65,Default,,0,0,0,,Арғы бетке барамыз ба? Иә.
Dialogue: 0,0:16:20.65,0:16:23.65,Default,,0,0,0,,Сен қайда бардың? Иә….
Dialogue: 0,0:16:23.65,0:16:25.00,Default,,0,0,0,,Менің таңдауым жоқ. Мен оралып, күтуім керек пе?
Dialogue: 0,0:16:25.00,0:16:29.65,Default,,0,0,0,,А, мен сол аңшылықты көргім келді.
Dialogue: 0,0:16:29.65,0:16:31.65,Default,,0,0,0,,Балалар, байқадыңдар, солай ма?
Dialogue: 0,0:16:31.65,0:16:36.65,Default,,0,0,0,,Мм... сіз қалай ойлайсыз?
Dialogue: 0,0:16:36.65,0:16:38.65,Default,,0,0,0,,Бірақ сен көп нәрсе істейсің, Ғабу.
Dialogue: 0,0:16:38.65,0:16:41.65,Default,,0,0,0,,Менің ойымша, бұл таңқаларлық керемет болды.
Dialogue: 0,0:16:41.65,0:16:44.65,Default,,0,0,0,,Лара үшін ешкіні қатты қу.
Dialogue: 0,0:16:44.65,0:16:47.65,Default,,0,0,0,,Еркек, солай емес пе?
Dialogue: 0,0:16:47.65,0:16:51.65,Default,,0,0,0,,Мен Ғабу туралы қайта ойлаған болармын.
Dialogue: 0,0:16:51.65,0:16:55.65,Default,,0,0,0,,Лала күткендей, сіз оны дәл көрдіңіз. Хехехе.
Dialogue: 0,0:16:57.65,0:17:00.65,Default,,0,0,0,,Күрсін... Қазір бәрі жақсы.
Dialogue: 0,0:17:00.65,0:17:03.65,Default,,0,0,0,,Сізді қорқытқаным үшін кешіріңіз.
Dialogue: 0,0:17:03.65,0:17:05.65,Default,,0,0,0,,Бұл не болды? Қазір не болды?
Dialogue: 0,0:17:05.65,0:17:07.65,Default,,0,0,0,,Бұл менің кінәм.
Dialogue: 0,0:17:07.65,0:17:11.65,Default,,0,0,0,,Маған байланғанына сенімдімін, бірақ байқамадым...
Dialogue: 0,0:17:11.65,0:17:15.65,Default,,0,0,0,,Ол қосылды! ? Бұл дұрыс.
Dialogue: 0,0:17:15.65,0:17:18.65,Default,,0,0,0,,Мен кәдімгідей жасырын шығып кетейін деп қалдым.
Dialogue: 0,0:17:18.65,0:17:21.65,Default,,0,0,0,,Лала-сан мені көрді.
Dialogue: 0,0:17:21.65,0:17:23.65,Default,,0,0,0,,Лара мырза? Бұл дұрыс.
Dialogue: 0,0:17:23.65,0:17:27.65,Default,,0,0,0,,Қайда бара жатырсың? Мен де барғым келеді дедім.
Dialogue: 0,0:17:27.65,0:17:31.65,Default,,0,0,0,,Мен шарасыз бас тарттым... Бірақ?
Dialogue: 0,0:17:31.65,0:17:36.65,Default,,0,0,0,,Бірақ мен саған кәдесый беріп, уәде беруімді өтінді... Ах!
Dialogue: 0,0:17:36.65,0:17:38.65,Default,,0,0,0,,Сіз уәде бердіңіз.
Dialogue: 0,0:17:38.65,0:17:40.65,Default,,0,0,0,,Хмм... Дұрыс.
Dialogue: 0,0:17:40.65,0:17:44.65,Default,,0,0,0,,Күрсін... Түсіндім. Бұл жақсы.
Dialogue: 0,0:17:44.65,0:17:46.65,Default,,0,0,0,,Иә! ?
Dialogue: 0,0:17:46.65,0:17:48.65,Default,,0,0,0,,Сіз ашулысыз ба?
Dialogue: 0,0:17:48.65,0:17:51.65,Default,,0,0,0,,Жоқ.Неге ашуланасың?
Dialogue: 0,0:17:51.65,0:17:54.65,Default,,0,0,0,,Сіз ашулы болуыңыз керек.
Dialogue: 0,0:17:54.65,0:18:00.65,Default,,0,0,0,,Олай болса, Лала-санға кәдесый – мен, Ғабу.
Dialogue: 0,0:18:00.65,0:18:05.65,Default,,0,0,0,,А... жоқ, олай болуы мүмкін емес.
Dialogue: 0,0:18:05.65,0:18:08.65,Default,,0,0,0,,үшін осылай ойлады.
Dialogue: 0,0:18:08.65,0:18:13.65,Default,,0,0,0,,Не? Лала және басқа қасқырлар да.
Dialogue: 0,0:18:13.65,0:18:16.65,Default,,0,0,0,,Бұлай болуы мүмкін емес.
Dialogue: 0,0:18:16.65,0:18:20.65,Default,,0,0,0,,Ғаб... Міне, солай.
Dialogue: 0,0:18:20.65,0:18:23.65,Default,,0,0,0,,Өйткені мен ешкімін.
Dialogue: 0,0:18:23.65,0:18:26.65,Default,,0,0,0,,Ах! Аа….
Dialogue: 0,0:18:30.65,0:18:36.65,Default,,0,0,0,,Бірақ сыр... Құпиямыздың ашылмағанына қуанамын.
Dialogue: 0,0:18:36.65,0:18:38.65,Default,,0,0,0,,Хэхе! Эй!
Dialogue: 0,0:18:38.65,0:18:41.65,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:18:41.65,0:18:44.65,Default,,0,0,0,,-дағы Ғабу туралы не деуге болады?
Dialogue: 0,0:18:44.65,0:18:49.65,Default,,0,0,0,,Иә? Сізге Лала ұнай ма?
Dialogue: 0,0:18:49.65,0:18:53.65,Default,,0,0,0,,Неліктен бұлай сұрайсыз?
Dialogue: 0,0:18:53.65,0:18:55.65,Default,,0,0,0,,Әлде сен оны жек көресің бе?
Dialogue: 0,0:18:55.65,0:18:59.65,Default,,0,0,0,,Ұнату немесе ұнатпау→
Dialogue: 0,0:18:59.65,0:19:01.65,Default,,0,0,0,,Мен бұл туралы ешқашан ойламадым ...
Dialogue: 0,0:19:01.65,0:19:05.65,Default,,0,0,0,,Секіре алмасаң жақсы.
Dialogue: 0,0:19:05.65,0:19:08.65,Default,,0,0,0,,Бүгін секіре алмасам да...
Dialogue: 0,0:19:08.65,0:19:13.65,Default,,0,0,0,,Ертең немесе келесі күні секіру үшін бар күшімді сала алсам →
Dialogue: 0,0:19:13.65,0:19:15.65,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:19:15.65,0:19:17.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:17.65,0:19:20.65,Default,,0,0,0,,Аа, мен бала кезімде қателесетінмін →
Dialogue: 0,0:19:20.65,0:19:22.65,Default,,0,0,0,,Бірде ол мені жігерлендірді.
Dialogue: 0,0:19:22.65,0:19:24.65,Default,,0,0,0,,Ах.
Dialogue: 0,0:19:24.65,0:19:28.65,Default,,0,0,0,,Бұл Лала-санның менен бірінші рет жақсылық сұрап отыр→
Dialogue: 0,0:19:28.65,0:19:34.65,Default,,0,0,0,,Сондықтан маған кәдесый ұсынғанда бас тарта алмадым...
Dialogue: 0,0:19:34.65,0:19:37.65,Default,,0,0,0,,Сонымен менмін.
Dialogue: 0,0:19:37.65,0:19:39.65,Default,,0,0,0,,О, күте тұрыңыз!
Dialogue: 0,0:19:39.65,0:19:42.65,Default,,0,0,0,,Хэхе! Жай ойнам айттым.
Dialogue: 0,0:19:42.65,0:19:44.65,Default,,0,0,0,,А... әзілдеп тұрмын.
Dialogue: 0,0:19:44.65,0:19:47.65,Default,,0,0,0,,Олай болса, кеттік. бару?
Dialogue: 0,0:19:47.65,0:19:50.65,Default,,0,0,0,,Мен кәдесыйлар іздеймін. иә?
Dialogue: 0,0:19:50.65,0:19:54.65,Default,,0,0,0,,Олар қасқыр мен ешкі, бірақ екеуі бір қыз.
Dialogue: 0,0:19:54.65,0:19:57.65,Default,,0,0,0,,Мен не алуға қуанышты болатынымды түсінемін.
Dialogue: 0,0:19:57.65,0:20:00.65,Default,,0,0,0,,Уақыты келді…
Dialogue: 0,0:20:00.65,0:20:02.65,Default,,0,0,0,,мамыр!
Dialogue: 0,0:20:09.65,0:20:14.65,Default,,0,0,0,,Кеш болды... Ақыр соңында, мен оны жіберіп қойғанмын.
Dialogue: 0,0:20:14.65,0:20:18.65,Default,,0,0,0,,Мен оны асыға күттім. жаңа піскен ешкі.
Dialogue: 0,0:20:18.65,0:20:20.65,Default,,0,0,0,,Мен бұл мүлдем мүмкін емес деп ойладым.
Dialogue: 0,0:20:20.65,0:20:23.65,Default,,0,0,0,,Сол гоблин жалғыз өзі ешкіні қалай бағындырады?
Dialogue: 0,0:20:23.65,0:20:26.65,Default,,0,0,0,,Күрсін... Мен қазір баруым керек сияқты. барайық.
Dialogue: 0,0:20:26.65,0:20:28.65,Default,,0,0,0,,Лара ше?
Dialogue: 0,0:20:30.65,0:20:34.65,Default,,0,0,0,,Лала жақсы емес пе? Өйткені күткім келеді.
Dialogue: 0,0:20:34.65,0:20:38.65,Default,,0,0,0,,Сіз оны шынымен жегіңіз келеді. жаңа піскен ешкі.
Dialogue: 0,0:20:38.65,0:20:42.65,Default,,0,0,0,,Лараның күткені →
Dialogue: 0,0:20:42.65,0:20:46.65,Default,,0,0,0,,Ешкі емес, қарлығаш емес пе?
Dialogue: 0,0:20:46.65,0:20:48.65,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:20:48.65,0:20:51.65,Default,,0,0,0,,Дұрыс! (күлкі)
Dialogue: 0,0:20:51.65,0:20:53.65,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:21:08.65,0:21:12.65,Default,,0,0,0,,Қош келдіңіз Ғабу. Кешіріңіз, кеш болды.
Dialogue: 0,0:21:12.65,0:21:18.65,Default,,0,0,0,,Бұл кәдесый. Уау, рахмет!
Dialogue: 0,0:21:18.65,0:21:23.65,Default,,0,0,0,,Ал, сүйкімді сүйектер! Және қызықты тастар!
Dialogue: 0,0:21:23.65,0:21:28.65,Default,,0,0,0,,Рахмет Ғабу. Жоқ, не... хехехе.
Dialogue: 0,0:21:28.65,0:21:30.65,Default,,0,0,0,,Иә? а?
Dialogue: 0,0:21:32.65,0:21:37.65,Default,,0,0,0,,А, сәттілік! Менің жейтін ештеңем жоқ.
Dialogue: 0,0:21:37.65,0:21:41.65,Default,,0,0,0,,Мен ешкіні қуып көрдім, бірақ болмады.
Dialogue: 0,0:21:41.65,0:21:43.65,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:21:43.65,0:21:45.65,Default,,0,0,0,,А... не! ?
Dialogue: 0,0:21:45.65,0:21:47.65,Default,,0,0,0,,Мен оны қарап отырдым.
Dialogue: 0,0:21:47.65,0:21:49.65,Default,,0,0,0,,Сіз не істемексіз? ?
Dialogue: 0,0:21:49.65,0:21:51.65,Default,,0,0,0,,Ғабу ешкіні қуып келеді.
Dialogue: 0,0:21:51.65,0:21:54.65,Default,,0,0,0,,Бұл мені тоқтатуға жеткілікті болды.
Dialogue: 0,0:21:54.65,0:21:56.65,Default,,0,0,0,,А... міне, солай.
Dialogue: 0,0:21:56.65,0:21:59.65,Default,,0,0,0,,Сіз сәтсіздікке ұшырадыңыз ба? Шынымен.
Dialogue: 0,0:21:59.65,0:22:01.65,Default,,0,0,0,,Жоқ, дұрыс.
Dialogue: 0,0:22:01.65,0:22:04.65,Default,,0,0,0,,Мен қашуға бір қадам ғана қалдым...
Dialogue: 0,0:22:04.65,0:22:09.65,Default,,0,0,0,,Сіз ебедейсіз және үнемі сәтсіздікке ұшырайсыз→
Dialogue: 0,0:22:09.65,0:22:12.65,Default,,0,0,0,,Бұл рас суясен.
Dialogue: 0,0:22:12.65,0:22:14.65,Default,,0,0,0,,Не! иә?
Dialogue: 0,0:22:14.65,0:22:17.65,Default,,0,0,0,,Уфуфу Мен жұтқанда, ештеңе өзгерген жоқ.
Dialogue: 0,0:22:17.65,0:22:22.65,Default,,0,0,0,,Бұрынғыдай. Мен уайымдап ақша жоғалттым.
Dialogue: 0,0:22:22.65,0:22:25.65,Default,,0,0,0,,Иә? Сәтсіздіктер көп болғаны дұрыс.
Dialogue: 0,0:22:25.65,0:22:30.65,Default,,0,0,0,,Келесі жолы сәтсіздікке ұшырамауға тырысыңыз.
Dialogue: 0,0:22:30.65,0:22:32.65,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:22:32.65,0:22:34.65,Default,,0,0,0,,Эй?
Dialogue: 0,0:22:41.65,0:22:48.65,Default,,0,0,0,,Өтірік! ? Иә, мен толықпын!
Dialogue: 0,0:22:48.65,0:22:51.65,Default,,0,0,0,,Бұл тым жасырын!
Dialogue: 0,0:22:51.65,0:22:56.65,Default,,0,0,0,,Қане, өсек айтсаң! Габ!
Dialogue: 0,0:22:56.65,0:22:58.65,Default,,0,0,0,,Уфуфу Қайырлы таң Габу!
Dialogue: 0,0:22:58.65,0:23:00.65,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:23:00.65,0:23:03.65,Default,,0,0,0,,Келесі жолы маған кәдесый әкеліңізші!
Dialogue: 0,0:23:03.65,0:23:06.65,Default,,0,0,0,,Түсіндім.
Dialogue: 0,0:23:09.65,0:23:11.65,Default,,0,0,0,,《Сол гүл...》
Dialogue: 0,0:23:11.65,0:23:15.65,Default,,0,0,0,,Бұл жеткілікті.
Dialogue: 0,0:23:15.65,0:23:18.65,Default,,0,0,0,,Мен солай ойлаймын. Май, рахмет!
Dialogue: 0,0:23:18.65,0:23:23.65,Default,,0,0,0,,Мен сенің бақытты болатыныңа сенімдімін! Солай ма?
Dialogue: 0,0:23:23.65,0:23:27.65,Default,,0,0,0,,Хм, бірдеңе жетіспейтін сияқты.
Dialogue: 0,0:23:27.65,0:23:29.65,Default,,0,0,0,,Ах!
Dialogue: 0,0:23:29.65,0:23:33.65,Default,,0,0,0,,Менде бұл болуы керек! Ухуху
Dialogue: 0,0:23:37.65,0:23:40.65,Default,,0,0,0,,《Мэй маған сыйлаған гүлдермен》
Dialogue: 0,0:23:42.65,0:23:46.65,Default,,0,0,0,,Габтың сүйікті ашық жасыл Уфуфуфу!
Dialogue: 0,0:24:02.65,0:24:05.65,Default,,0,0,0,,Рахмет... Деянсу.
Dialogue: 0,0:24:05.65,0:24:09.65,Default,,0,0,0,,А-а-а-а-а-а!
