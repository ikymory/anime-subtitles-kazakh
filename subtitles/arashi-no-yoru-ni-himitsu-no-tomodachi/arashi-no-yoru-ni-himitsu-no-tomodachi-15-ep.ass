Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:02:52.53,0:02:57.74,Default,,0000,0000,0000,,<Екеуі боранды түнде кездесті.
Dialogue: 0,0:02:57.74,0:03:00.77,Default,,0000,0000,0000,,Көрісе алмай дос болып кеттік
Dialogue: 0,0:03:00.77,0:03:03.63,Default,,0000,0000,0000,,Қайта кездесуге уәде беріңіз
Dialogue: 0,0:03:03.63,0:03:07.84,Default,,0000,0000,0000,,Құпия сөзді ауыстырғаннан кейін «Дауылға байланысты».
Dialogue: 0,0:03:07.84,0:03:11.72,Default,,0000,0000,0000,,Бірі – ешкі сүйіп жейтін қасқыр.
Dialogue: 0,0:03:11.72,0:03:16.77,Default,,0000,0000,0000,,Бірі қасқырдан қашпаса жейтін ешкі еді.
Dialogue: 0,0:03:16.77,0:03:21.65,Default,,0000,0000,0000,,Бірақ Габу мен Мэй дос болып кетті>
Dialogue: 0,0:03:21.65,0:03:27.88,Default,,0000,0000,0000,,Хмм… Бұл не өзі!
Dialogue: 0,0:03:27.88,0:03:32.09,Default,,0000,0000,0000,,Хмм… Бұл не өзі!
Dialogue: 0,0:03:32.09,0:03:34.94,Default,,0000,0000,0000,,Аха!
Dialogue: 0,0:03:34.94,0:03:38.15,Default,,0000,0000,0000,,Кешіріңіз Габу! Кеш батты.
Dialogue: 0,0:03:38.15,0:03:40.01,Default,,0000,0000,0000,,Әлі де кеш емес.
Dialogue: 0,0:03:40.01,0:03:44.05,Default,,0000,0000,0000,,Негізі ертерек келгім келді, бірақ хаха.
Dialogue: 0,0:03:44.05,0:03:46.07,Default,,0000,0000,0000,,Не? Не болды?
Dialogue: 0,0:03:46.07,0:03:49.43,Default,,0000,0000,0000,,...
Dialogue: 0,0:03:49.43,0:03:52.46,Default,,0000,0000,0000,,Сіз тағы бір қауіпті ойын ойлап тапқан сияқтысыз.
Dialogue: 0,0:03:52.46,0:03:55.33,Default,,0000,0000,0000,,Оны тоқтату үшін біраз уақыт қажет болды.
Dialogue: 0,0:03:55.33,0:03:57.18,Default,,0000,0000,0000,,Нағыз тентек.
Dialogue: 0,0:03:57.18,0:04:01.88,Default,,0000,0000,0000,,Хахахаха Әдепсіз, бұл жақсы.
Dialogue: 0,0:04:01.88,0:04:03.24,Default,,0000,0000,0000,,Ендеше біз бүгін не ойнаймыз?
Dialogue: 0,0:04:03.24,0:04:08.45,Default,,0000,0000,0000,,Уфуфу Бүгін орманға барып ағашқа шығайық.
Dialogue: 0,0:04:08.45,0:04:13.83,Default,,0000,0000,0000,,Не? Мэй ағаштарға өрмелей ала ма?
Dialogue: 0,0:04:13.83,0:04:16.53,Default,,0000,0000,0000,,Мен мұны ешқашан жасаған емеспін. Бұл дұрыс.
Dialogue: 0,0:04:16.53,0:04:22.26,Default,,0000,0000,0000,,Уфуфу Сол себепті Габу Көрейік!
Dialogue: 0,0:04:22.26,0:04:26.26,Default,,0000,0000,0000,,Ах, Мэй…. Бұл тентек.
Dialogue: 0,0:04:28.99,0:04:33.87,Default,,0000,0000,0000,,«Хмф, иә, иә»
Dialogue: 0,0:04:33.87,0:04:35.56,Default,,0000,0000,0000,,Уау! Иә?
Dialogue: 0,0:04:35.56,0:04:37.91,Default,,0000,0000,0000,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:04:37.91,0:04:41.95,Default,,0000,0000,0000,,Уау, менде жағымсыз сезім бар!
Dialogue: 0,0:04:41.95,0:04:43.81,Default,,0000,0000,0000,,Мен мұны істей аламын!
Dialogue: 0,0:04:43.81,0:04:46.81,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:04:48.18,0:04:50.54,Default,,0000,0000,0000,,Қайта кездескенше Уфуфу! Сондай-ақ.
Dialogue: 0,0:04:50.54,0:04:53.73,Default,,0000,0000,0000,,Габ? Жуықта көріскенше.
Dialogue: 0,0:04:53.73,0:04:55.42,Default,,0000,0000,0000,,Сен бүгін көп ұштың.
Dialogue: 0,0:04:55.42,0:04:59.12,Default,,0000,0000,0000,,♬ Ора ора ора ора, ора ора ора ора
Dialogue: 0,0:04:59.12,0:05:01.31,Default,,0000,0000,0000,,Хахаха.
Dialogue: 0,0:05:01.31,0:05:04.51,Default,,0000,0000,0000,,Уау! (ысқырық)
Dialogue: 0,0:05:04.51,0:05:07.88,Default,,0000,0000,0000,,Хмм… Бұл не өзі!
Dialogue: 0,0:05:07.88,0:05:10.57,Default,,0000,0000,0000,,Жыртыра жігіт Шынайысың ба?
Dialogue: 0,0:05:10.57,0:05:12.42,Default,,0000,0000,0000,,Бұл мүлдем мүмкін емес.
Dialogue: 0,0:05:12.42,0:05:15.96,Default,,0000,0000,0000,,Күтпеген жерден мен бардым.
Dialogue: 0,0:05:15.96,0:05:18.82,Default,,0000,0000,0000,,Боло Жақсысың ба?
Dialogue: 0,0:05:18.82,0:05:24.82,Default,,0000,0000,0000,,《Иә? Шүберек сол жардан секіруді үйренді ме? 》
Dialogue: 0,0:05:33.80,0:05:35.82,Default,,0000,0000,0000,,Иә! а!
Dialogue: 0,0:05:35.82,0:05:39.82,Default,,0000,0000,0000,,Хахаха... Уау!
Dialogue: 0,0:05:41.55,0:05:44.58,Default,,0000,0000,0000,,Боро, біз үшін әлі ерте.
Dialogue: 0,0:05:44.58,0:05:48.45,Default,,0000,0000,0000,,Егер мен осы жартастың үстінен секіре алсам, өзімді ересек адамдай сезінер едім...
Dialogue: 0,0:05:48.45,0:05:54.67,Default,,0000,0000,0000,,Бұл керемет. Иә.
Dialogue: 0,0:05:54.67,0:05:56.03,Default,,0000,0000,0000,,Күткендей, мен әлі де істей алмаймын.
Dialogue: 0,0:05:56.03,0:05:58.55,Default,,0000,0000,0000,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:05:58.55,0:06:00.91,Default,,0000,0000,0000,,Олар не істеп жатыр?
Dialogue: 0,0:06:00.91,0:06:03.44,Default,,0000,0000,0000,,Сол жардан секіргің келетін сияқты.
Dialogue: 0,0:06:03.44,0:06:07.31,Default,,0000,0000,0000,,Түсіндім.
Dialogue: 0,0:06:07.31,0:06:10.33,Default,,0000,0000,0000,,Тыңдаңдар, балалар.
Dialogue: 0,0:06:10.33,0:06:14.71,Default,,0000,0000,0000,,Бүгінгі күннің қалған бөлігінде мен сендерге жұппен жұмыс жасауды сұраймын.
Dialogue: 0,0:06:14.71,0:06:17.58,Default,,0000,0000,0000,,Тыңдашы, кішкентайым, жұптасың →
Dialogue: 0,0:06:17.58,0:06:21.11,Default,,0000,0000,0000,,Маған бәрін дәл айтып беріңізші.
Dialogue: 0,0:06:21.11,0:06:23.80,Default,,0000,0000,0000,,Иә, Барри!
Dialogue: 0,0:06:23.80,0:06:26.00,Default,,0000,0000,0000,,Шынымды айтсам, оқыту жағы да →
Dialogue: 0,0:06:26.00,0:06:31.04,Default,,0000,0000,0000,,Кішкентайлардың алдында жаман үлгі көрсетпе.
Dialogue: 0,0:06:31.04,0:06:33.56,Default,,0000,0000,0000,,Түсіндіңіз бе? Эй!
Dialogue: 0,0:06:33.56,0:06:37.11,Default,,0000,0000,0000,,Түсінді. Жарайды, бар күшіңді сал.
Dialogue: 0,0:06:37.11,0:06:41.48,Default,,0000,0000,0000,,Жарайды, біріншіден, танысқаныма қуаныштымын.
Dialogue: 0,0:06:41.48,0:06:44.51,Default,,0000,0000,0000,,Олай болса кеттік.
Dialogue: 0,0:06:44.51,0:06:48.05,Default,,0000,0000,0000,,Иә, көп рахмет, Габуни.
Dialogue: 0,0:06:48.05,0:06:51.58,Default,,0000,0000,0000,,Танысқаныма қуаныштымын, Боро.
Dialogue: 0,0:06:51.58,0:06:53.58,Default,,0000,0000,0000,,Ынталы болайық!
Dialogue: 0,0:06:58.31,0:07:00.50,Default,,0000,0000,0000,,Жақсы ма? Боло.
Dialogue: 0,0:07:00.50,0:07:03.20,Default,,0000,0000,0000,,Бұл қоян.
Dialogue: 0,0:07:03.20,0:07:05.39,Default,,0000,0000,0000,,Мынау түлкі.
Dialogue: 0,0:07:05.39,0:07:08.58,Default,,0000,0000,0000,,Сонда бұл не?
Dialogue: 0,0:07:08.58,0:07:11.95,Default,,0000,0000,0000,,Бұл иіс ешкі!
Dialogue: 0,0:07:11.95,0:07:13.30,Default,,0000,0000,0000,,Иә, бұл хит болды.
Dialogue: 0,0:07:13.30,0:07:15.82,Default,,0000,0000,0000,,Мұрның жақсы→
Dialogue: 0,0:07:15.82,0:07:18.68,Default,,0000,0000,0000,,Қарап-ақ түсінуге болады.
Dialogue: 0,0:07:18.68,0:07:20.04,Default,,0000,0000,0000,,Иә, Габони!
Dialogue: 0,0:07:20.04,0:07:24.74,Default,,0000,0000,0000,,Хмм! Мен бар күшімді саламын!
Dialogue: 0,0:07:24.74,0:07:27.10,Default,,0000,0000,0000,,Секіргенде тек алға қара →
Dialogue: 0,0:07:27.10,0:07:30.81,Default,,0000,0000,0000,,Бір нәрсеге кірісу маңызды.
Dialogue: 0,0:07:30.81,0:07:33.17,Default,,0000,0000,0000,,Боро. Иә, Габуни!
Dialogue: 0,0:07:33.17,0:07:36.53,Default,,0000,0000,0000,,Жарайды. Барымызды салайық!
Dialogue: 0,0:07:36.53,0:07:39.40,Default,,0000,0000,0000,,А, бұл! ?
Dialogue: 0,0:07:39.40,0:07:42.09,Default,,0000,0000,0000,,Тан тонна!
Dialogue: 0,0:07:42.09,0:07:44.95,Default,,0000,0000,0000,,Үлкенірек тасты таңдаңыз.
Dialogue: 0,0:07:44.95,0:07:47.64,Default,,0000,0000,0000,,Иә, Габони! Бұл дұрыс.
Dialogue: 0,0:07:47.64,0:07:50.17,Default,,0000,0000,0000,,Ынталы болайық!
Dialogue: 0,0:07:50.17,0:07:52.86,Default,,0000,0000,0000,,Иә тонна тонна!
Dialogue: 0,0:07:52.86,0:07:55.05,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:07:55.05,0:07:57.57,Default,,0000,0000,0000,,Габунии!
Dialogue: 0,0:07:57.57,0:08:02.95,Default,,0000,0000,0000,,Осы сияқты сумен шомылу арқылы иістерді кетіру де тиімді.
Dialogue: 0,0:08:02.95,0:08:05.65,Default,,0000,0000,0000,,Иә, Габони!
Dialogue: 0,0:08:05.65,0:08:07.65,Default,,0000,0000,0000,,Ынталы болайық!
Dialogue: 0,0:08:10.37,0:08:16.76,Default,,0000,0000,0000,,《Менің інім бар сияқты.
Dialogue: 0,0:08:16.76,0:08:20.47,Default,,0000,0000,0000,,Мен сізге жақсы үлгі көрсетемін.
Dialogue: 0,0:08:20.47,0:08:23.00,Default,,0000,0000,0000,,Ах! Не болды?
Dialogue: 0,0:08:23.00,0:08:25.52,Default,,0000,0000,0000,,Габу-нии Мына жаққа қара!
Dialogue: 0,0:08:25.52,0:08:28.22,Default,,0000,0000,0000,,Жыртқыш Жем бар.
Dialogue: 0,0:08:28.22,0:08:32.59,Default,,0000,0000,0000,,Сіз қалай аң аулайсыз?
Dialogue: 0,0:08:32.59,0:08:35.45,Default,,0000,0000,0000,,Бұл Габони ме?
Dialogue: 0,0:08:35.45,0:08:39.32,Default,,0000,0000,0000,,А, Боро, қарның аш па?
Dialogue: 0,0:08:39.32,0:08:43.87,Default,,0000,0000,0000,,Сіз аштыңыз ба? Иә, асқазан. Сіз мұны тегіс жасайсыз ба?
Dialogue: 0,0:08:43.87,0:08:47.24,Default,,0000,0000,0000,,Бұл тегіс емес.
Dialogue: 0,0:08:47.24,0:08:49.93,Default,,0000,0000,0000,,Ендеше, бүгін аңға шықпайық.
Dialogue: 0,0:08:49.93,0:08:53.97,Default,,0000,0000,0000,,Не? Бірақ... Ақыры олжамды таптым.
Dialogue: 0,0:08:53.97,0:08:56.17,Default,,0000,0000,0000,,Аш болмасаң да аң аулаудың не керегі бар?
Dialogue: 0,0:08:56.17,0:09:00.20,Default,,0000,0000,0000,,Сен маған ұнамайсың. сурет? Күрсіну….
Dialogue: 0,0:09:00.20,0:09:02.72,Default,,0000,0000,0000,,Егер сіз аң аулағыңыз келсе →
Dialogue: 0,0:09:02.72,0:09:05.75,Default,,0000,0000,0000,,Қарным ашқанда істеймін.
Dialogue: 0,0:09:05.75,0:09:08.78,Default,,0000,0000,0000,,Иә, Габунии.
Dialogue: 0,0:09:08.78,0:09:12.15,Default,,0000,0000,0000,,«Ертең Меймен ойнайтын күн».
Dialogue: 0,0:09:12.15,0:09:14.34,Default,,0000,0000,0000,,Сонымен... иә?
Dialogue: 0,0:09:14.34,0:09:17.04,Default,,0000,0000,0000,,Хехехе, тыңда, тыңда!
Dialogue: 0,0:09:17.04,0:09:22.09,Default,,0000,0000,0000,,Мен Закпен тышқан ұстадым!
Dialogue: 0,0:09:22.09,0:09:27.64,Default,,0000,0000,0000,,Хмф, мен Батчпен қоян ұстадым.
Dialogue: 0,0:09:27.64,0:09:30.17,Default,,0000,0000,0000,,Әй, бұл жақсы.
Dialogue: 0,0:09:30.17,0:09:32.36,Default,,0000,0000,0000,,Боро не ұстады?
Dialogue: 0,0:09:32.36,0:09:36.23,Default,,0000,0000,0000,,Мен бұғы таптым. О!
Dialogue: 0,0:09:36.23,0:09:40.10,Default,,0000,0000,0000,,Бұл керемет! Бұл үлкен нәрсе.
Dialogue: 0,0:09:40.10,0:09:42.28,Default,,0000,0000,0000,,Сонымен... бұл қалай болды?
Dialogue: 0,0:09:42.28,0:09:44.48,Default,,0000,0000,0000,,Бұғыларды ұстау қиын ба?
Dialogue: 0,0:09:44.48,0:09:47.51,Default,,0000,0000,0000,,Мм... Мен білмеймін.
Dialogue: 0,0:09:47.51,0:09:50.87,Default,,0000,0000,0000,,Өйткені оны Габу-нии ұстамады.
Dialogue: 0,0:09:50.87,0:09:53.40,Default,,0000,0000,0000,,Иә! ? Бұл біртүрлі!
Dialogue: 0,0:09:53.40,0:09:58.78,Default,,0000,0000,0000,,Егер сіз олжа тапсаңыз, оны әдетте ұстайсыз, солай ма?
Dialogue: 0,0:09:58.78,0:10:00.97,Default,,0000,0000,0000,,Иә, бірақ...
Dialogue: 0,0:10:00.97,0:10:04.17,Default,,0000,0000,0000,,Габу-ни болса мүмкін емес пе?
Dialogue: 0,0:10:04.17,0:10:06.53,Default,,0000,0000,0000,,Иә, мүмкін!
Dialogue: 0,0:10:06.53,0:10:08.71,Default,,0000,0000,0000,,Неліктен? иә?
Dialogue: 0,0:10:08.71,0:10:11.91,Default,,0000,0000,0000,,Өйткені Габу-нии аңшылықта нашар деп естідім.
Dialogue: 0,0:10:11.91,0:10:15.12,Default,,0000,0000,0000,,Сондықтан мен саған аңшылықты үйрете алмаймын.
Dialogue: 0,0:10:15.12,0:10:19.50,Default,,0000,0000,0000,,Сондай-ақ, Габу-ни қорқақтығымен танымал.
Dialogue: 0,0:10:19.50,0:10:22.36,Default,,0000,0000,0000,,Мүмкін сіз аң аулаудан қорқатын шығарсыз.
Dialogue: 0,0:10:22.36,0:10:28.58,Default,,0000,0000,0000,,Иә! ? Болды...
Dialogue: 0,0:10:28.58,0:10:32.28,Default,,0000,0000,0000,,Мен Боло Габонимен жұптаған кезде оны жаман сезіндім.
Dialogue: 0,0:10:32.28,0:10:36.99,Default,,0000,0000,0000,,Иә! Келесі жолы біз сізге аң аулауды үйретеміз.
Dialogue: 0,0:10:36.99,0:10:39.53,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:10:39.53,0:10:42.53,Default,,0000,0000,0000,,Габ! Ухуху.
Dialogue: 0,0:10:45.42,0:10:48.78,Default,,0000,0000,0000,,Не болды? а….
Dialogue: 0,0:10:48.78,0:10:52.99,Default,,0000,0000,0000,,Жоқ, бұл ештеңе емес.
Dialogue: 0,0:10:52.99,0:10:56.53,Default,,0000,0000,0000,,Ештеңе болмағандай әрекет етпеңіз.
Dialogue: 0,0:10:56.53,0:10:59.89,Default,,0000,0000,0000,,Иә? Хмм….
Dialogue: 0,0:10:59.89,0:11:02.42,Default,,0000,0000,0000,,Сіз уайымдап тұрсыз ба?
Dialogue: 0,0:11:02.42,0:11:04.61,Default,,0000,0000,0000,,Қорқынышты!
Dialogue: 0,0:11:04.61,0:11:06.30,Default,,0000,0000,0000,,Ғабуды қорқақ дейсің.
Dialogue: 0,0:11:06.30,0:11:09.99,Default,,0000,0000,0000,,Мен саған аң аулауды үйреткен жоқпын.
Dialogue: 0,0:11:09.99,0:11:12.86,Default,,0000,0000,0000,,Неліктен бұлай айту керек?
Dialogue: 0,0:11:12.86,0:11:15.38,Default,,0000,0000,0000,,Ах... бұл Мэй.
Dialogue: 0,0:11:15.38,0:11:18.59,Default,,0000,0000,0000,,Әйтеуір Ғабудың батыл, салқын екенін білдім.
Dialogue: 0,0:11:18.59,0:11:22.12,Default,,0000,0000,0000,,Мен сізге түсінуге мәжбүрлеуім керек! иә?
Dialogue: 0,0:11:22.12,0:11:25.15,Default,,0000,0000,0000,,Ғабу, мен де қызметтес боламын.
Dialogue: 0,0:11:25.15,0:11:30.03,Default,,0000,0000,0000,,Е, ынтымақтастық... Жоқ, жоқ, жарайды.
Dialogue: 0,0:11:30.03,0:11:34.74,Default,,0000,0000,0000,,Бұл мұнай мәселесі. Бірақ Ғабу...
Dialogue: 0,0:11:34.74,0:11:37.60,Default,,0000,0000,0000,,Оның үстіне Мэй мен үшін ашуланды.
Dialogue: 0,0:11:37.60,0:11:40.13,Default,,0000,0000,0000,,Әйтеуір мен өзімді еркін сезінемін.
Dialogue: 0,0:11:40.13,0:11:43.66,Default,,0000,0000,0000,,Габ…. Күрсіну….
Dialogue: 0,0:11:43.66,0:11:47.87,Default,,0000,0000,0000,,Бірақ Боро не ойлады?
Dialogue: 0,0:11:47.87,0:11:51.41,Default,,0000,0000,0000,,Сіз нені айтасыз? Шындық, мен сізге хабарлаймын.
Dialogue: 0,0:11:51.41,0:11:53.60,Default,,0000,0000,0000,,Маған ұнамады деп ойлаймын.
Dialogue: 0,0:11:53.60,0:11:56.96,Default,,0000,0000,0000,,А, бұл...
Dialogue: 0,0:11:56.96,0:11:59.16,Default,,0000,0000,0000,,Иә? Әй, мынау!
Dialogue: 0,0:11:59.16,0:12:04.04,Default,,0000,0000,0000,,Әй, сен шынымен ешкінің иісін сездің бе?
Dialogue: 0,0:12:04.04,0:12:06.39,Default,,0000,0000,0000,,О, бұл рас.
Dialogue: 0,0:12:06.39,0:12:10.77,Default,,0000,0000,0000,,Бучни менің жақсы мұрныма мақтау айтты.
Dialogue: 0,0:12:10.77,0:12:13.80,Default,,0000,0000,0000,,Иә? Бұл не, Боло?
Dialogue: 0,0:12:13.80,0:12:17.17,Default,,0000,0000,0000,,Біз саған аң аулауды үйретеміз.
Dialogue: 0,0:12:17.17,0:12:20.37,Default,,0000,0000,0000,,Көңіл көтеру. Иә….
Dialogue: 0,0:12:20.37,0:12:26.59,Default,,0000,0000,0000,,Ммм, мүлде емес. Мұнда гүлдердің иісі тым күшті.
Dialogue: 0,0:12:26.59,0:12:29.29,Default,,0000,0000,0000,,Мен ешкінің иісін сезбеймін.
Dialogue: 0,0:12:29.29,0:12:33.00,Default,,0000,0000,0000,,Осы уақытқа дейін келдіңіз, түсінбейсіз бе? Бұл не?
Dialogue: 0,0:12:33.00,0:12:35.18,Default,,0000,0000,0000,,Өйткені...
Dialogue: 0,0:12:35.18,0:12:39.22,Default,,0000,0000,0000,,Жарайды. Мен осы жерден оның иісін әлі сеземін.
Dialogue: 0,0:12:39.22,0:12:41.58,Default,,0000,0000,0000,,Иә! ? Бұл рас па?
Dialogue: 0,0:12:41.58,0:12:43.93,Default,,0000,0000,0000,,Мен мұны істеймін!
Dialogue: 0,0:12:43.93,0:12:45.45,Default,,0000,0000,0000,,Габонини мақтаған жоқ па?
Dialogue: 0,0:12:45.45,0:12:48.64,Default,,0000,0000,0000,,Қалай болды?
Dialogue: 0,0:12:48.64,0:12:52.35,Default,,0000,0000,0000,,Мен қиындыққа тап болдым. Мен одан қашып құтыла алмаймын.
Dialogue: 0,0:12:52.35,0:12:54.35,Default,,0000,0000,0000,,Мен қатты қысылып қалдым! Біз үлкен шымшудамыз!
Dialogue: 0,0:14:29.99,0:14:34.87,Default,,0000,0000,0000,,Боро Бұл жерде ме? Иә... мүмкін.
Dialogue: 0,0:14:34.87,0:14:39.75,Default,,0000,0000,0000,,Бұл оның ішінде жасырылған дегенді білдіре ме?
Dialogue: 0,0:14:39.75,0:14:41.28,Default,,0000,0000,0000,,Бұл ақылсыз!
Dialogue: 0,0:14:41.28,0:14:45.65,Default,,0000,0000,0000,,Әзірше мен ол балаларға барынша қамқор боламын...
Dialogue: 0,0:14:45.65,0:14:47.33,Default,,0000,0000,0000,,Урья!
Dialogue: 0,0:14:47.33,0:14:49.85,Default,,0000,0000,0000,,Мен сені аулақ ұстаймын.
Dialogue: 0,0:14:49.85,0:14:51.20,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:14:51.20,0:14:53.89,Default,,0000,0000,0000,,Мен таң қалдым, ол шықпайды деп ойладым.
Dialogue: 0,0:14:53.89,0:14:57.77,Default,,0000,0000,0000,,Сосын бұл арада мен қашып кетемін.
Dialogue: 0,0:14:57.77,0:15:00.80,Default,,0000,0000,0000,,Эй, мен бірдеңе естідім! сурет? Бұл рас па?
Dialogue: 0,0:15:00.80,0:15:04.83,Default,,0000,0000,0000,,Урья! Бұл менің қиялым болса керек...
Dialogue: 0,0:15:04.83,0:15:06.19,Default,,0000,0000,0000,,Тексеріңіз! (2 адам) Аа...
Dialogue: 0,0:15:06.19,0:15:08.88,Default,,0000,0000,0000,,Ах! Мен бірдеңені естідім.
Dialogue: 0,0:15:08.88,0:15:11.24,Default,,0000,0000,0000,,Аа, кешіріңіз, мен жаңа ғана айқайладым.
Dialogue: 0,0:15:11.24,0:15:14.77,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:15:14.77,0:15:16.79,Default,,0000,0000,0000,,Сіз де көп жейсіз бе?
Dialogue: 0,0:15:16.79,0:15:19.82,Default,,0000,0000,0000,,Ха! Сіз тым көп жедіңіз деген не?
Dialogue: 0,0:15:19.82,0:15:21.01,Default,,0000,0000,0000,,Мамыр, сен оны елестете алмайсың.
Dialogue: 0,0:15:21.01,0:15:24.37,Default,,0000,0000,0000,,Мен ешкіні қазір ұстасам, оны жей аламын ба?
Dialogue: 0,0:15:24.37,0:15:28.41,Default,,0000,0000,0000,,Мен жеймін... Мықты болсын!
Dialogue: 0,0:15:28.41,0:15:30.93,Default,,0000,0000,0000,,Жарайды! Сіз қашып кете аласыз.
Dialogue: 0,0:15:30.93,0:15:34.97,Default,,0000,0000,0000,,Бір тістеп ал да, қалдыр. Бұл дұрыс.
Dialogue: 0,0:15:34.97,0:15:36.15,Default,,0000,0000,0000,,Кету керек пе?
Dialogue: 0,0:15:36.15,0:15:41.37,Default,,0000,0000,0000,,Ешкілер үлпілдек, баяу жүгіретін сияқты.
Dialogue: 0,0:15:41.37,0:15:46.09,Default,,0000,0000,0000,,Иә, ол үнемі шөп жейді, оның басы нашар сияқты.
Dialogue: 0,0:15:46.09,0:15:49.79,Default,,0000,0000,0000,,Мен болсам, мен ешкіні бірден ұстар едім.
Dialogue: 0,0:15:49.79,0:15:53.33,Default,,0000,0000,0000,,Мен оны Зактан үйрендім, сондықтан мен де мінсізмін!
Dialogue: 0,0:15:53.33,0:15:56.36,Default,,0000,0000,0000,,Тіпті мен Бучниден үйрендім.
Dialogue: 0,0:15:56.36,0:16:02.36,Default,,0000,0000,0000,,Бірақ мен Бороға ренжідім, өйткені ол Габонимен жұптасып кетті.
Dialogue: 0,0:16:07.80,0:16:10.83,Default,,0000,0000,0000,,Жарайды, уайымдама!
Dialogue: 0,0:16:10.83,0:16:13.19,Default,,0000,0000,0000,,Мен сені енді кешіре алмаймын! иә?
Dialogue: 0,0:16:13.19,0:16:18.41,Default,,0000,0000,0000,,Мен ашуланып тұрмын. Мен сені енді кешіре алмаймын!
Dialogue: 0,0:16:18.41,0:16:21.77,Default,,0000,0000,0000,,Хмф! Габ, жасайық!
Dialogue: 0,0:16:21.77,0:16:23.63,Default,,0000,0000,0000,,Міне, осысы бізге жеңіс әкелді.
Dialogue: 0,0:16:23.63,0:16:28.51,Default,,0000,0000,0000,,Сол балаларға ешкіні қорласа не болатынын айт.
Dialogue: 0,0:16:28.51,0:16:32.71,Default,,0000,0000,0000,,Еске саламын. иә?
Dialogue: 0,0:16:32.71,0:16:34.07,Default,,0000,0000,0000,,(шу)
Dialogue: 0,0:16:34.07,0:16:40.80,Default,,0000,0000,0000,,Ах! Мен жақсы ұйықтадым.
Dialogue: 0,0:16:40.80,0:16:44.33,Default,,0000,0000,0000,,Иә? Балалар сендерге не болды?
Dialogue: 0,0:16:44.33,0:16:47.53,Default,,0000,0000,0000,,А, бұл...
Dialogue: 0,0:16:47.53,0:16:49.05,Default,,0000,0000,0000,,Бәріміз бірге аң аулаймыз.
Dialogue: 0,0:16:49.05,0:16:54.27,Default,,0000,0000,0000,,Аң аулау? Одан гөрі неге мені тыңдамайсың?
Dialogue: 0,0:16:54.27,0:16:57.13,Default,,0000,0000,0000,,Мен шынымен қызықты түс көрдім.
Dialogue: 0,0:16:57.13,0:17:01.01,Default,,0000,0000,0000,,Жоқ, мені қызықтырмайды. Солай ма?
Dialogue: 0,0:17:01.01,0:17:03.36,Default,,0000,0000,0000,,Олай болса...
Dialogue: 0,0:17:03.36,0:17:07.73,Default,,0000,0000,0000,,《Қиындыққа тап болдым... Назарыңды басқа жаққа аударғым келеді, бірақ бәрі жақсы емес...》
Dialogue: 0,0:17:07.73,0:17:10.26,Default,,0000,0000,0000,,Иә? Аспанда бұғылар ұшады!
Dialogue: 0,0:17:10.26,0:17:12.12,Default,,0000,0000,0000,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:17:12.12,0:17:15.14,Default,,0000,0000,0000,,Сәлем! Мынаны қара! Бұл ешкі!
Dialogue: 0,0:17:15.14,0:17:17.14,Default,,0000,0000,0000,,Мен сені қуамын!
Dialogue: 0,0:17:21.38,0:17:24.74,Default,,0000,0000,0000,,《Мэй, шынымен жақсысың ба? 》
Dialogue: 0,0:17:24.74,0:17:40.90,Default,,0000,0000,0000,,～
Dialogue: 0,0:17:40.90,0:17:45.28,Default,,0000,0000,0000,,Көмектесіңіз! Қасқырлар! Қасқыр қорқынышты!
Dialogue: 0,0:17:45.28,0:17:48.81,Default,,0000,0000,0000,,《Жоқ, жасама!》
Dialogue: 0,0:17:48.81,0:17:51.34,Default,,0000,0000,0000,,Тым қорқынышты!
Dialogue: 0,0:17:51.34,0:17:53.86,Default,,0000,0000,0000,,Ешкі! Ұстаңыз!
Dialogue: 0,0:17:53.86,0:17:55.86,Default,,0000,0000,0000,,Ta~!
Dialogue: 0,0:17:58.08,0:18:03.13,Default,,0000,0000,0000,,Ақыры жеттім... Е-е! ?
Dialogue: 0,0:18:03.13,0:18:05.98,Default,,0000,0000,0000,,Неге менің үстіме шығып тұрсың?
Dialogue: 0,0:18:05.98,0:18:08.35,Default,,0000,0000,0000,,Мен тек ешкі ұстайын деп едім!
Dialogue: 0,0:18:08.35,0:18:12.38,Default,,0000,0000,0000,,Бастапқыда Баро оны ұстамады, себебі ол сәтсіз аяқталды!
Dialogue: 0,0:18:12.38,0:18:16.25,Default,,0000,0000,0000,,Ал, ешкі қайда?
Dialogue: 0,0:18:16.25,0:18:19.29,Default,,0000,0000,0000,,А... дұрыс!
Dialogue: 0,0:18:19.29,0:18:23.83,Default,,0000,0000,0000,,Жүр! Тұрғың келсе, айт!
Dialogue: 0,0:18:23.83,0:18:27.83,Default,,0000,0000,0000,,Бұл шулы. Барайық! Ешкіні қуып жіберейік!
Dialogue: 0,0:18:30.73,0:18:35.73,Default,,0000,0000,0000,,Бұл қорқынышты. Мм... иә.
Dialogue: 0,0:18:39.49,0:18:43.86,Default,,0000,0000,0000,,Уфуфу… мэ!
Dialogue: 0,0:18:43.86,0:18:47.06,Default,,0000,0000,0000,,Мә! Мэх~!
Dialogue: 0,0:18:47.06,0:18:49.08,Default,,0000,0000,0000,,Не... енді ше?
Dialogue: 0,0:18:49.08,0:18:51.27,Default,,0000,0000,0000,,Мен оны әр жерден естідім.
Dialogue: 0,0:18:51.27,0:18:57.67,Default,,0000,0000,0000,,Мә! Мэх~!
Dialogue: 0,0:18:57.67,0:19:00.69,Default,,0000,0000,0000,,Құдайға шүкір.
Dialogue: 0,0:19:00.69,0:19:03.72,Default,,0000,0000,0000,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:19:03.72,0:19:06.42,Default,,0000,0000,0000,,Ешкі Шынымен келдің бе?
Dialogue: 0,0:19:06.42,0:19:11.30,Default,,0000,0000,0000,,Иә, мен оның иісін жарты жолға дейін сездім.
Dialogue: 0,0:19:11.30,0:19:15.35,Default,,0000,0000,0000,,Жоқ, ылғалдылыққа байланысты нақты айта алмаймын.
Dialogue: 0,0:19:15.35,0:19:17.87,Default,,0000,0000,0000,,Иә, солай!
Dialogue: 0,0:19:17.87,0:19:21.40,Default,,0000,0000,0000,,Осылайша, аяқ іздері бар! Ха! ?
Dialogue: 0,0:19:21.40,0:19:23.42,Default,,0000,0000,0000,,Бұл ешкі ізі!
Dialogue: 0,0:19:23.42,0:19:27.80,Default,,0000,0000,0000,,Иә? Солай ма? Боро мен сені жақсы білемін.
Dialogue: 0,0:19:27.80,0:19:31.80,Default,,0000,0000,0000,,Аяқ іздері сонда жалғасады, сондықтан...
Dialogue: 0,0:19:33.36,0:19:36.36,Default,,0000,0000,0000,,Сәлем Боро! ? Күте тұрыңыз, Боро!
Dialogue: 0,0:19:42.78,0:19:49.01,Default,,0000,0000,0000,,Атта... тозған.
Dialogue: 0,0:19:49.01,0:19:51.01,Default,,0000,0000,0000,,Таптым!
Dialogue: 0,0:19:53.89,0:19:56.89,Default,,0000,0000,0000,,А, сіз оны жақсы таптыңыз. Мен сені мақтаймын.
Dialogue: 0,0:20:00.13,0:20:03.13,Default,,0000,0000,0000,,Уау! А, күте тұрыңыз!
Dialogue: 0,0:20:06.19,0:20:08.19,Default,,0000,0000,0000,,Тастар жоқ!
Dialogue: 0,0:20:17.29,0:20:19.15,Default,,0000,0000,0000,,Ааах— сол сұм!
Dialogue: 0,0:20:19.15,0:20:21.67,Default,,0000,0000,0000,,Біз қалай өтеміз?
Dialogue: 0,0:20:21.67,0:20:23.36,Default,,0000,0000,0000,,Тек үлкенірек тасты таңдаңыз!
Dialogue: 0,0:20:23.36,0:20:25.36,Default,,0000,0000,0000,,Эй!
Dialogue: 0,0:20:29.75,0:20:32.61,Default,,0000,0000,0000,,Ешкіні ұстау қиын. Иә.
Dialogue: 0,0:20:32.61,0:20:36.49,Default,,0000,0000,0000,,Эй, Боло, сен бүгін керемет көрінесің!
Dialogue: 0,0:20:36.49,0:20:41.54,Default,,0000,0000,0000,,Иә, ізі мен өзені не болды?
Dialogue: 0,0:20:41.54,0:20:44.40,Default,,0000,0000,0000,,Габу-ни маған бәрін үйретті!
Dialogue: 0,0:20:44.40,0:20:47.40,Default,,0000,0000,0000,,Габуниига? Бұл ешкі болды!
Dialogue: 0,0:20:50.12,0:20:53.66,Default,,0000,0000,0000,,《Қорқпа. Дем ал.》
Dialogue: 0,0:20:53.66,0:20:55.01,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:20:55.01,0:20:58.04,Default,,0000,0000,0000,,Ұстап алсаң, алға, ұста!
Dialogue: 0,0:20:58.04,0:21:01.74,Default,,0000,0000,0000,,Қарғыс атсын саған ешкі! Біз не істеуіміз керек?
Dialogue: 0,0:21:01.74,0:21:03.93,Default,,0000,0000,0000,,Бізде айналма жолмен жүруден басқа амал қалмайды.
Dialogue: 0,0:21:03.93,0:21:05.11,Default,,0000,0000,0000,,Сәлем, Боло.
Dialogue: 0,0:21:05.11,0:21:07.11,Default,,0000,0000,0000,,Боло?
Dialogue: 0,0:21:09.82,0:21:11.01,Default,,0000,0000,0000,,Тым қобалжымаңыз.
Dialogue: 0,0:21:11.01,0:21:15.04,Default,,0000,0000,0000,,Жарайды. Өйткені бұл туралы маған Габуни айтып берді.
Dialogue: 0,0:21:15.04,0:21:17.04,Default,,0000,0000,0000,,Габуниига?
Dialogue: 0,0:21:20.43,0:21:24.47,Default,,0000,0000,0000,,Өтірік? Сондай кішкентай бала...
Dialogue: 0,0:21:24.47,0:21:26.49,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:21:26.49,0:21:28.51,Default,,0000,0000,0000,,Мен секірдім!
Dialogue: 0,0:21:28.51,0:21:31.51,Default,,0000,0000,0000,,Боло... Мен жардан секірдім!
Dialogue: 0,0:21:39.45,0:21:41.45,Default,,0000,0000,0000,,Қарғыс атсын...
Dialogue: 0,0:21:48.70,0:21:51.07,Default,,0000,0000,0000,,Ия, мен жасадым.
Dialogue: 0,0:21:51.07,0:21:55.45,Default,,0000,0000,0000,,Керемет! Боло керемет!
Dialogue: 0,0:21:55.45,0:21:58.98,Default,,0000,0000,0000,,Керемет, Боло!
Dialogue: 0,0:21:58.98,0:22:02.98,Default,,0000,0000,0000,,Боро! Қалғанын саған қалдырамын.
Dialogue: 0,0:22:04.70,0:22:07.40,Default,,0000,0000,0000,,Габуни!
Dialogue: 0,0:22:07.40,0:22:10.40,Default,,0000,0000,0000,,Сәлем! Габуни аң аулауда...
Dialogue: 0,0:22:27.93,0:22:30.96,Default,,0000,0000,0000,,Уау! Керемет!
Dialogue: 0,0:22:30.96,0:22:33.82,Default,,0000,0000,0000,,Біз оны мүлдем ұстай алмадық.
Dialogue: 0,0:22:33.82,0:22:35.35,Default,,0000,0000,0000,,Ах! Габуни….
Dialogue: 0,0:22:35.35,0:22:38.54,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:22:38.54,0:22:40.56,Default,,0000,0000,0000,,Ол қашып кетті.
Dialogue: 0,0:22:40.56,0:22:42.91,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:22:42.91,0:22:45.77,Default,,0000,0000,0000,,Сәлем, Габонии.
Dialogue: 0,0:22:45.77,0:22:48.64,Default,,0000,0000,0000,,Ешкіні неге ертерек қашып жібердің?
Dialogue: 0,0:22:48.64,0:22:54.70,Default,,0000,0000,0000,,Мен оны қарным ашпаса да ұстап алғаным үшін.
Dialogue: 0,0:22:54.70,0:22:56.05,Default,,0000,0000,0000,,Мен бұрын қуған ешкі
Dialogue: 0,0:22:56.05,0:22:59.25,Default,,0000,0000,0000,,Неліктен бәрі оны ұстай алмады?
Dialogue: 0,0:22:59.25,0:23:01.10,Default,,0000,0000,0000,,Түсіндің бе?
Dialogue: 0,0:23:01.10,0:23:03.95,Default,,0000,0000,0000,,Кішкентай болғандықтан ба?
Dialogue: 0,0:23:03.95,0:23:05.64,Default,,0000,0000,0000,,Жоқ, сіз жеңілдіңіз.
Dialogue: 0,0:23:05.64,0:23:09.68,Default,,0000,0000,0000,,Сол ешкінің ерекше жүйрік болғаны ма?
Dialogue: 0,0:23:09.68,0:23:13.39,Default,,0000,0000,0000,,Кешіріңіз! Менің көңілім қалды!
Dialogue: 0,0:23:13.39,0:23:15.24,Default,,0000,0000,0000,,Сонда неге?
Dialogue: 0,0:23:15.24,0:23:17.76,Default,,0000,0000,0000,,Ешкіні барлығының ұстай алмауының себебі
Dialogue: 0,0:23:17.76,0:23:19.45,Default,,0000,0000,0000,,Қарным ашпаса да
Dialogue: 0,0:23:19.45,0:23:23.66,Default,,0000,0000,0000,,Себебі мен аң аулау үшін жолдан шығып кеттім.
Dialogue: 0,0:23:23.66,0:23:26.02,Default,,0000,0000,0000,,Барлығы ермек үшін аң ауласа да
Dialogue: 0,0:23:26.02,0:23:30.89,Default,,0000,0000,0000,,Ешкі әрқашан салмақты.
Dialogue: 0,0:23:30.89,0:23:36.95,Default,,0000,0000,0000,,Өйткені мені жегім келмейді.
Dialogue: 0,0:23:36.95,0:23:41.67,Default,,0000,0000,0000,,Аңға шыққанда әрқашан аш бол.
Dialogue: 0,0:23:41.67,0:23:44.70,Default,,0000,0000,0000,,Амалсыз қуып жетпесең жақсы емес.
Dialogue: 0,0:23:44.70,0:23:46.22,Default,,0000,0000,0000,,Иә, Габони!
Dialogue: 0,0:23:46.22,0:23:48.22,Default,,0000,0000,0000,,Бұл жақсы жауап.
Dialogue: 0,0:23:50.60,0:23:53.29,Default,,0000,0000,0000,,Габ Жақсы өтті ме?
Dialogue: 0,0:23:53.29,0:23:55.81,Default,,0000,0000,0000,,Сіз мұны тамаша орындадыңыз.
Dialogue: 0,0:23:55.81,0:23:59.35,Default,,0000,0000,0000,,Жақсы. Мен де көңілді болдым.
Dialogue: 0,0:23:59.35,0:24:02.71,Default,,0000,0000,0000,,Көңілді болды ма? Хехехе!
Dialogue: 0,0:24:02.71,0:24:04.40,Default,,0000,0000,0000,,Сол балалар мені гахун деп атауға мәжбүр етті.
Dialogue: 0,0:24:04.40,0:24:07.09,Default,,0000,0000,0000,,Ах Мэй... Хахаха!
Dialogue: 0,0:24:07.09,0:24:10.79,Default,,0000,0000,0000,,Хэхехе! Хахаха!
Dialogue: 0,0:24:10.79,0:24:12.32,Default,,0000,0000,0000,,Сәлем Ғабу. Неліктен?
Dialogue: 0,0:24:12.32,0:24:15.17,Default,,0000,0000,0000,,Бір күні сол балалармен кездескенше
Dialogue: 0,0:24:15.17,0:24:17.17,Default,,0000,0000,0000,,Бір-бірімізді қуып жіберейік. Ха! ?
Dialogue: 0,0:24:18.67,0:24:24.67,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
