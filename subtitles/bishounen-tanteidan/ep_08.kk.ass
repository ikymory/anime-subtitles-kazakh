Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:21:43.49,0:21:47.74,Default,,0,0,0,,Көктен шыққан болт, оқиғасы жанды
Dialogue: 0,0:21:47.33,0:21:50.96,Default,,0,0,0,,Қызық күндеріңізді бояңыз
Dialogue: 0,0:21:51.67,0:21:55.13,Default,,0,0,0,,Көпшілікті алдайтын көркем әдебиет
Dialogue: 0,0:21:55.42,0:21:59.13,Default,,0,0,0,,Біз өзімізден жарықты да жібермейміз.
Dialogue: 0,0:22:01.38,0:22:07.68,Default,,0,0,0,,«Егер» лабиринтінде ойлануға тыйым салынады
Dialogue: 0,0:22:07.97,0:22:14.35,Default,,0,0,0,,Дұрыс, батылдық - шегерудің кілті... иә?
Dialogue: 0,0:22:15.90,0:22:19.03,Default,,0,0,0,,Әр сәт пен секунд туады
Dialogue: 0,0:22:19.40,0:22:22.86,Default,,0,0,0,,Драма Карма Оны жіберіп алмаңыз
Dialogue: 0,0:22:23.20,0:22:24.99,Default,,0,0,0,,Кім қайда не істеді?
Dialogue: 0,0:22:24.99,0:22:31.16,Default,,0,0,0,,Қанша рет бетпердеге тырыссаң да
Dialogue: 0,0:22:31.16,0:22:32.46,Default,,0,0,0,,«Әдемі, солай емес пе?»
Dialogue: 0,0:22:32.62,0:22:35.96,Default,,0,0,0,,Сіз детективті шақырып жатырсыз.
Dialogue: 0,0:22:35.96,0:22:39.96,Default,,0,0,0,,Жұмбақ жерге апатты қону
Dialogue: 0,0:22:39.96,0:22:43.26,Default,,0,0,0,,Әлем қиын сынақтарды іздейді.
Dialogue: 0,0:22:43.26,0:22:46.89,Default,,0,0,0,,Тапсырыспен жасалған Жұмбақ тәсілдер
Dialogue: 0,0:22:46.89,0:22:50.89,Default,,0,0,0,,Жомарт құрметпен бәрін ашайық.
Dialogue: 0,0:22:50.89,0:22:54.81,Default,,0,0,0,,Айдың жасырын жағы
Dialogue: 0,0:22:54.81,0:22:58.44,Default,,0,0,0,,Кешкі асқа дәл уақытында
Dialogue: 0,0:22:58.44,0:23:02.44,Default,,0,0,0,,Бірегей пайымдауды қарастырайық
Dialogue: 0,0:02:52.62,0:02:54.82,Default,,0,0,0,,Докея кедейлер
Dialogue: 0,0:02:54.82,0:02:56.95,Default,,0,0,0,,Мені басып кетуі керек пе еді?
Dialogue: 0,0:03:01.33,0:03:04.08,Default,,0,0,0,,Сіз жолдан шығасыз ба? Сіз өлесіз бе?
Dialogue: 0,0:03:04.08,0:03:09.09,Default,,0,0,0,,Неліктен қарапайым халық алдына сабан салып, аяғынан тік тұрды?
Dialogue: 0,0:03:14.73,0:03:16.72,Default,,0,0,0,,Төменгі дүниенің адамдары сондықтан
Dialogue: 0,0:03:17.47,0:03:21.18,Default,,0,0,0,,Мен болашақта осындай үлкен топты басқаруым керек пе деп ойлаймын.
Dialogue: 0,0:03:21.18,0:03:22.98,Default,,0,0,0,,Өз-өзіме қол жұмсағым келеді
Dialogue: 0,0:03:24.10,0:03:26.98,Default,,0,0,0,,Себебі мен сенің жүзіңді есіме түсірдім
Dialogue: 0,0:03:39.04,0:03:41.74,Default,,0,0,0,,Неге, Майами, сен олай тұрсың?
Dialogue: 0,0:03:41.74,0:03:43.37,Default,,0,0,0,,Әй, жаман бала
Dialogue: 0,0:03:44.04,0:03:46.07,Default,,0,0,0,,Саған не болды?
Dialogue: 0,0:03:46.07,0:03:47.12,Default,,0,0,0,,Не болды
Dialogue: 0,0:03:47.12,0:03:49.54,Default,,0,0,0,,Фукуяку-кунның зұлым жүзіне қараңыз
Dialogue: 0,0:03:49.54,0:03:52.09,Default,,0,0,0,,Мен өзімді осылай еркін сезінемін деп ойламаппын.
Dialogue: 0,0:03:52.09,0:03:55.51,Default,,0,0,0,,Мен бір күні көпіршікті үрлеймін деп ойлап кешірім сұрағым келеді.
Dialogue: 0,0:03:55.51,0:03:57.18,Default,,0,0,0,,Содан кейін кешірім сұраңыз.
Dialogue: 0,0:03:57.18,0:04:00.24,Default,,0,0,0,,Біріншіден, менің жаңағы айтқаным – жауыз жүз.
Dialogue: 0,0:04:01.71,0:04:02.39,Default,,0,0,0,,Иә.
Dialogue: 0,0:04:02.39,0:04:06.35,Default,,0,0,0,,Фукуяку-кун, бүгін Сакигучи-сенпай келеді деп ойлайсың ба?
Dialogue: 0,0:04:07.54,0:04:09.27,Default,,0,0,0,,Нагахиро? Кәне.
Dialogue: 0,0:04:09.90,0:04:13.36,Default,,0,0,0,,Не? Нагахиромен бірдеңе болды ма?
Dialogue: 0,0:04:14.35,0:04:17.03,Default,,0,0,0,,Оның сабаққа қатысу көрсеткіші әйтеуір нашар.
Dialogue: 0,0:04:17.03,0:04:19.36,Default,,0,0,0,,Жылдың осы мезгілінде студенттік кеңес жұмысымен айналысады.
Dialogue: 0,0:04:19.36,0:04:21.37,Default,,0,0,0,,Әрине.
Dialogue: 0,0:04:21.37,0:04:26.70,Default,,0,0,0,,Қашаннан бері Нагахиро Сакигучи-сенпай немесе Дистант деп атайсыз?
Dialogue: 0,0:04:27.23,0:04:29.23,Default,,0,0,0,,Нашар нүкте немесе Икуаши-кун?
Dialogue: 0,0:04:29.23,0:04:31.71,Default,,0,0,0,,Күннің соңында сіз вундеркинд бала боласыз.
Dialogue: 0,0:04:31.71,0:04:34.05,Default,,0,0,0,,Хиди лақап атыңызды беріңіз
Dialogue: 0,0:04:34.05,0:04:37.22,Default,,0,0,0,,Неге оны тек атымен атайсың?
Dialogue: 0,0:04:37.22,0:04:38.70,Default,,0,0,0,,Жоқ...жоқ, өйткені
Dialogue: 0,0:04:38.70,0:04:41.27,Default,,0,0,0,,Сакигучи-сенпай үшінші курс студенті.
Dialogue: 0,0:04:41.27,0:04:44.72,Default,,0,0,0,,Не болса да, үлкенді лоликон деп айта алмайсың.
Dialogue: 0,0:04:44.72,0:04:46.93,Default,,0,0,0,,Маған бұлай көп қоңырау шаламын деп айтпа.
Dialogue: 0,0:04:47.39,0:04:49.44,Default,,0,0,0,,Үлкендер мен кішілер жоқ.
Dialogue: 0,0:04:49.84,0:04:55.27,Default,,0,0,0,,«Әдемі бала детективтері» – топтың жоғарғы жағында көшбасшысы бар әрекет.
Dialogue: 0,0:04:55.27,0:04:57.32,Default,,0,0,0,,Бұдан төмен теңдік бар.
Dialogue: 0,0:04:57.32,0:05:01.20,Default,,0,0,0,,Нагахиромен жұмыс істеуге мүмкіндік жоқ.
Dialogue: 0,0:05:04.24,0:05:07.70,Default,,0,0,0,,Маюми, егер Нагахиро бүгін келсе,
Dialogue: 0,0:05:08.22,0:05:11.67,Default,,0,0,0,,Онымен сөйлесетін бірдеңе болса, бұл жақсы уақыт болар еді.
Dialogue: 0,0:05:11.67,0:05:14.21,Default,,0,0,0,,Бүгіннен бастап мені төраға ретінде қалағаныңызша атай аласыз.
Dialogue: 0,0:05:14.67,0:05:16.67,Default,,0,0,0,,Төраға...
Dialogue: 0,0:05:16.67,0:05:20.01,Default,,0,0,0,,Бірақ мені осылай атасаң, сені қорлап тұрғаным анық емес пе?
Dialogue: 0,0:05:20.01,0:05:22.22,Default,,0,0,0,,Негізінде бұл жалап жатыр.
Dialogue: 0,0:05:33.02,0:05:37.07,Default,,0,0,0,,Бұл үлкен шайқас болды
Dialogue: 0,0:05:40.36,0:05:43.74,Default,,0,0,0,,Оны Оши Хагоита деп атайтын сияқты.
Dialogue: 0,0:05:44.16,0:05:48.01,Default,,0,0,0,,Шығармашылықпен жасалған жаңа өнер туындысы емес пе?
Dialogue: 0,0:05:48.87,0:05:51.00,Default,,0,0,0,,Оның есінде ондай ештеңе жоқ сияқты.
Dialogue: 0,0:05:51.37,0:05:54.00,Default,,0,0,0,,Сонда бұл да Нағай-сенсi шығармасы ма?
Dialogue: 0,0:05:54.00,0:05:56.13,Default,,0,0,0,,Бұл дұрыс емес, Майами-чан.
Dialogue: 0,0:05:56.65,0:06:00.13,Default,,0,0,0,,Нагай-чан қазірдің өзінде бұл мектепке бөгде адам.
Dialogue: 0,0:06:00.13,0:06:04.14,Default,,0,0,0,,Осындай күдікті затты өнер бөлмесіне қалай қоюға болады?
Dialogue: 0,0:06:05.74,0:06:07.89,Default,,0,0,0,,Дұрыс айтасыз.
Dialogue: 0,0:06:07.89,0:06:11.25,Default,,0,0,0,,Ол емес пе? Әлгі айлакер
Dialogue: 0,0:06:12.14,0:06:15.02,Default,,0,0,0,,Қылмыс жасады деп болжауға
Dialogue: 0,0:06:15.02,0:06:17.27,Default,,0,0,0,,Пайда немесе қайтарым тым аз
Dialogue: 0,0:06:17.94,0:06:20.29,Default,,0,0,0,,Өйткені Сатсуки-кун ойнаушы.
Dialogue: 0,0:06:20.29,0:06:22.90,Default,,0,0,0,,Біз көңіл көтеруді бағалауымыз керек.
Dialogue: 0,0:06:24.40,0:06:28.37,Default,,0,0,0,,Мынандай көлеңкелі жігітті қалай түсінесің, таң қалдырады.
Dialogue: 0,0:06:28.37,0:06:30.22,Default,,0,0,0,,О, бұл дұрыс емес, Факу-кун.
Dialogue: 0,0:06:30.22,0:06:34.07,Default,,0,0,0,,Жауыңды танысаң, өзіңді білсең, жүз шайқас болмас.
Dialogue: 0,0:06:34.07,0:06:34.92,Default,,0,0,0,,Қызғаншақ болмаңыз
Dialogue: 0,0:06:34.92,0:06:36.89,Default,,0,0,0,,Мұны кім жасайды?
Dialogue: 0,0:06:36.89,0:06:38.67,Default,,0,0,0,,Сіз өзіңізді тым көп білмейсіз.
Dialogue: 0,0:06:39.15,0:06:41.53,Default,,0,0,0,,Бұл, әрине, олай емес сияқты.
Dialogue: 0,0:06:41.53,0:06:46.42,Default,,0,0,0,,Оның жау лагеріне сыйлық берудегі батылдығы ойнақы болып көрінеді.
Dialogue: 0,0:06:46.42,0:06:49.68,Default,,0,0,0,,Ондай жағдайда мен хагоитаның не екенін түсінбеймін.
Dialogue: 0,0:06:50.22,0:06:53.56,Default,,0,0,0,,Айтуға келмейтін ойнақылықтан асқан мағынасыз ештеңе жоқ.
Dialogue: 0,0:06:53.56,0:06:57.31,Default,,0,0,0,,Балалар, сендер не туралы айтып тұрсыңдар? Бұл анық.
Dialogue: 0,0:06:57.65,0:06:59.82,Default,,0,0,0,,Жаңа жыл жақындап қалды.
Dialogue: 0,0:07:01.57,0:07:05.07,Default,,0,0,0,,Жиырма ше? Бұл Рей-санның ісі емес пе?
Dialogue: 0,0:07:05.07,0:07:08.57,Default,,0,0,0,,Бұл мүмкіндікті жоққа шығаруға болады.
Dialogue: 0,0:07:09.11,0:07:13.70,Default,,0,0,0,,Өйткені, Рей-сан бастаған жиырмалықтар ауыр қылмыстық топ.
Dialogue: 0,0:07:13.70,0:07:16.89,Default,,0,0,0,,Тыңдау құрылғылары мен бомбалар деген осы.
Dialogue: 0,0:07:16.89,0:07:19.84,Default,,0,0,0,,Егер ол жауынгерлік алаңға салынса, жақсы болар еді.
Dialogue: 0,0:07:19.84,0:07:24.01,Default,,0,0,0,,Олай емес екенін өз көзіммен растаймын.
Dialogue: 0,0:07:24.01,0:07:26.68,Default,,0,0,0,,Түсінемін, бұл ұят.
Dialogue: 0,0:07:26.68,0:07:29.68,Default,,0,0,0,,Толқын аяқтарды тағы көремін деп ойладым.
Dialogue: 0,0:07:29.68,0:07:32.68,Default,,0,0,0,,Не? Мен ештеңе білмеймін.
Dialogue: 0,0:07:32.68,0:07:34.73,Default,,0,0,0,,Бұл күшті күдіктілер жоқ дегенді білдіре ме?
Dialogue: 0,0:07:35.22,0:07:37.89,Default,,0,0,0,,Бұны талқылау бекер емес пе?
Dialogue: 0,0:07:37.89,0:07:40.48,Default,,0,0,0,,Олай болса, оны Нагахироға қарастырайық.
Dialogue: 0,0:07:40.86,0:07:45.61,Default,,0,0,0,,Хм, Нагахиросыз бұл туралы сөйлесуге болатын шығар.
Dialogue: 0,0:07:46.14,0:07:49.37,Default,,0,0,0,,Ал, енді келесі тақырыпқа көшейік.
Dialogue: 0,0:07:49.37,0:07:51.14,Default,,0,0,0,,Қысқы демалыс жақындап қалды
Dialogue: 0,0:07:51.14,0:07:54.87,Default,,0,0,0,,Мен «Әдемі бала» детектив тобымен қысқы оқу-жаттығу жиынын өткізуді ойлап жүрмін.
Dialogue: 0,0:07:54.87,0:07:56.62,Default,,0,0,0,,Жылдам прогресс
Dialogue: 0,0:07:57.12,0:08:01.50,Default,,0,0,0,,Менің ойымша, бұл оңайлықпен сөреге шығарылатын нәрсе емес.
Dialogue: 0,0:08:01.89,0:08:08.01,Default,,0,0,0,,Ең болмаса, күдікті адамның күдікті затты алып бара жатқанын көрген куәгер болса...
Dialogue: 0,0:08:09.12,0:08:10.26,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:08:10.26,0:08:15.85,Default,,0,0,0,,Бүгін осы өнер бөлмесіне барғанымда бір құбыжықтың жанынан өттім.
Dialogue: 0,0:08:16.43,0:08:21.90,Default,,0,0,0,,Бұл зашикивараши өнер бөлмесінен қайтып келе жатқан жоқ па еді?
Dialogue: 0,0:08:23.02,0:08:25.28,Default,,0,0,0,,Сонда бұл бала кінәлі ме?
Dialogue: 0,0:08:25.65,0:08:30.11,Default,,0,0,0,,Күдікті затты өнер бөлмесіне әкелген күдікті адам болды ма?
Dialogue: 0,0:08:30.72,0:08:32.03,Default,,0,0,0,,Қысқы оқу-жаттығу жиыны?
Dialogue: 0,0:08:32.70,0:08:34.03,Default,,0,0,0,,Бұл не, көшбасшы?
Dialogue: 0,0:08:34.48,0:08:37.71,Default,,0,0,0,,Сіз бір жерде қарлы кабинаға тығыласыз ба?
Dialogue: 0,0:08:37.71,0:08:40.29,Default,,0,0,0,,Маған үш мезгіл тамақ дайындайсың ба?
Dialogue: 0,0:08:40.29,0:08:42.29,Default,,0,0,0,,Қанша қиындықты қажет етеді?
Dialogue: 0,0:08:43.14,0:08:45.63,Default,,0,0,0,,Мен сіздің жеке аспазыңыз емеспін.
Dialogue: 0,0:08:46.18,0:08:50.68,Default,,0,0,0,,Мен күткендей, қысқы демалыста кем дегенде бір рет үйірме жұмыстарына бармауға мүмкіндігім жоқ.
Dialogue: 0,0:08:51.06,0:08:53.64,Default,,0,0,0,,Күндер санын реттегіңіз келе ме?
Dialogue: 0,0:08:53.64,0:08:56.31,Default,,0,0,0,,Сондай-ақ, мен дайынмын, бірақ
Dialogue: 0,0:08:56.31,0:08:58.64,Default,,0,0,0,,Сіз шынымен суық жерлерге баруды тоқтата аласыз ба?
Dialogue: 0,0:08:59.10,0:09:03.02,Default,,0,0,0,,Қаз шықса, сұлу аяғым бұзылды.
Dialogue: 0,0:09:03.69,0:09:06.53,Default,,0,0,0,,Мм...бір сәтке болар?
Dialogue: 0,0:09:06.53,0:09:08.59,Default,,0,0,0,,Не болып жатыр, не болып жатыр, Майами-кун?
Dialogue: 0,0:09:08.59,0:09:12.66,Default,,0,0,0,,Сіздің де қысқы оқу-жаттығу жиынынан үмітіңіз болса, тыңдайық.
Dialogue: 0,0:09:12.66,0:09:15.66,Default,,0,0,0,,Бұл жекпе-жек туралы емес.
Dialogue: 0,0:09:15.66,0:09:19.00,Default,,0,0,0,,О, құдай-ау, осыны әлі айтып отырсың ба?
Dialogue: 0,0:09:19.00,0:09:20.04,Default,,0,0,0,,Таңдаушы болмаңыз
Dialogue: 0,0:09:20.04,0:09:22.00,Default,,0,0,0,,Бұл не, Майами?
Dialogue: 0,0:09:22.00,0:09:25.29,Default,,0,0,0,,Содан бері бірдеңе айтатын сияқтысың.
Dialogue: 0,0:09:25.94,0:09:27.30,Default,,0,0,0,,Зашикивара
Dialogue: 0,0:09:27.30,0:09:32.01,Default,,0,0,0,,Мұнда келе жатып мен Зашикивараны көрдім.
Dialogue: 0,0:09:32.01,0:09:34.88,Default,,0,0,0,,Ол бала өнер бөлмесінде шығар.
Dialogue: 0,0:09:34.88,0:09:38.81,Default,,0,0,0,,Менің ойымша, бұл қорқынышты басылған жауынгерді әкелген кінәлі ме деп ойлаймын.
Dialogue: 0,0:09:44.91,0:09:47.19,Default,,0,0,0,,Маюми
Dialogue: 0,0:09:47.76,0:09:51.36,Default,,0,0,0,,Сіз кедейденсіз бе, әлде қарапайым халықтансыз ба?
Dialogue: 0,0:09:51.36,0:09:54.96,Default,,0,0,0,,Олар сендерді ақымақ адамдар деп атады ма, әлде қоғамның төменгі бөлігі деп атады ма?
Dialogue: 0,0:09:54.96,0:09:56.20,Default,,0,0,0,,Не? Ал...
Dialogue: 0,0:09:56.61,0:10:00.19,Default,,0,0,0,,Кедейлер мен қарапайым халықтың шығу тегі туралы айттыңыз ба?
Dialogue: 0,0:10:00.19,0:10:02.89,Default,,0,0,0,,Ақымақ адамдар мен қоғамның түбі айтылмайды.
Dialogue: 0,0:10:02.89,0:10:05.71,Default,,0,0,0,,Сондай-ақ бір нәрсе айтылғандай болды...
Dialogue: 0,0:10:06.11,0:10:08.05,Default,,0,0,0,,Өте қорқынышты
Dialogue: 0,0:10:08.05,0:10:11.22,Default,,0,0,0,,Бұл жадтан ыңғайлы түрде кесілген сияқты.
Dialogue: 0,0:10:11.22,0:10:12.84,Default,,0,0,0,,Төменгі әлемнің адамдары, солай ма?
Dialogue: 0,0:10:12.84,0:10:15.09,Default,,0,0,0,,Неге...қайдан білесің?
Dialogue: 0,0:10:15.09,0:10:19.35,Default,,0,0,0,,Фувараку-кун да, Икуаши-кун да Юрика-чан туралы біледі ме?
Dialogue: 0,0:10:19.35,0:10:21.48,Default,,0,0,0,,Бұл Юрика-чан емес.
Dialogue: 0,0:10:21.93,0:10:23.35,Default,,0,0,0,,Баланың аты
Dialogue: 0,0:10:23.35,0:10:27.73,Default,,0,0,0,,Нагахироның қалыңдығы - Кавайке Котаки.
Dialogue: 0,0:10:27.73,0:10:29.36,Default,,0,0,0,,Құбыжық емес
Dialogue: 0,0:10:29.36,0:10:32.11,Default,,0,0,0,,Ібіліс орынды болар еді.
Dialogue: 0,0:10:32.11,0:10:34.11,Default,,0,0,0,,А... шайтан?
Dialogue: 0,0:10:34.11,0:10:39.55,Default,,0,0,0,,Маюми-кун, сені қорқынышты құбыжық байқап қалды.
Dialogue: 0,0:10:42.08,0:10:45.00,Default,,0,0,0,,Маюми-чан топқа қосылғанға дейін көп нәрсе болды.
Dialogue: 0,0:10:45.00,0:10:47.75,Default,,0,0,0,,Нақтырақ айтсақ, жазғы оқу-жаттығу жиынында.
Dialogue: 0,0:10:47.75,0:10:48.88,Default,,0,0,0,,Жазғы оқу-жаттығу жиыны?
Dialogue: 0,0:10:49.37,0:10:51.42,Default,,0,0,0,,Жоқ, нақты айтқанда.
Dialogue: 0,0:10:51.42,0:10:53.67,Default,,0,0,0,,Жазғы оқу-жаттығу жиыны өткізілмеді.
Dialogue: 0,0:10:53.67,0:10:56.26,Default,,0,0,0,,Оны шайтанның қолы үзді.
Dialogue: 0,0:10:56.68,0:10:58.39,Default,,0,0,0,,Жер бетінде не болды?
Dialogue: 0,0:10:58.39,0:11:03.68,Default,,0,0,0,,Иә, менің ойымша, сіз сұраққа жауап беретін адамнан не болғанын сұрауыңыз керек.
Dialogue: 0,0:11:03.68,0:11:06.77,Default,,0,0,0,,Ақырында, әңгіме Нагахиросыз жұмыс істей алмайды.
Dialogue: 0,0:11:07.27,0:11:11.90,Default,,0,0,0,,Маями-кун, кешіріңіз, бірақ сіз маған бір тапсырманы орындауымды сұрай аласыз ба деп ойлаймын.
Dialogue: 0,0:11:26.42,0:11:28.79,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз, Майами-сан.
Dialogue: 0,0:11:28.79,0:11:31.67,Default,,0,0,0,,Сонымен не болды?
Dialogue: 0,0:11:33.68,0:11:36.80,Default,,0,0,0,,Түсіндім, сен осылай айтып тұрсың ба?
Dialogue: 0,0:11:36.80,0:11:41.06,Default,,0,0,0,,Менің келіншегім сізге қиындық тудырды, Майами мырза.
Dialogue: 0,0:11:41.06,0:11:44.06,Default,,0,0,0,,Ата-анам келінімді рұқсатсыз таңдаса да.
Dialogue: 0,0:11:44.06,0:11:47.36,Default,,0,0,0,,Мен оны дұрысырақ енгізсем ғой.
Dialogue: 0,0:11:48.19,0:11:50.56,Default,,0,0,0,,Алдымен мынаны айтайын.
Dialogue: 0,0:11:50.56,0:11:55.03,Default,,0,0,0,,Қылмысты Котаки мырза жасағаны анық.
Dialogue: 0,0:11:55.03,0:11:58.93,Default,,0,0,0,,Менің ойымша, бұл мақсатты түсіндіруге болады.
Dialogue: 0,0:12:00.79,0:12:05.33,Default,,0,0,0,,Майами топқа қосылғанға дейін көп нәрсе болды.
Dialogue: 0,0:12:05.91,0:12:10.33,Default,,0,0,0,,Сонда да мен жай ғана жағдай реттелді деп ойладым.
Dialogue: 0,0:12:10.99,0:12:13.11,Default,,0,0,0,,Маюми ханым топқа қосылғаннан кейін
Dialogue: 0,0:12:13.11,0:12:19.34,Default,,0,0,0,,Мен ол тағы бірдеңе істей ме деп қорықтым.
Dialogue: 0,0:12:21.02,0:12:22.35,Default,,0,0,0,,Ойласам, ол бәріне белгілі нәрсе ғой.
Dialogue: 0,0:12:23.07,0:12:24.85,Default,,0,0,0,,Өйткені ол
Dialogue: 0,0:12:25.44,0:12:30.29,Default,,0,0,0,,Ринг академиясы Бастауыш сынып 1А сыныбы Кавайке Котаки
Dialogue: 0,0:12:30.29,0:12:35.61,Default,,0,0,0,,Көшбасшы Pretty Boy Detectives тобына әсерден бас тартады.
Dialogue: 0,0:12:37.77,0:12:44.74,Default,,0,0,0,,Нақты ат қойғанда, ақпарат құлағыма бәсең дауыспен сыбырлады
Dialogue: 0,0:12:44.74,0:12:49.87,Default,,0,0,0,,Бұл менің басыма мүлдем сәйкес келмеді.
Dialogue: 0,0:12:53.34,0:12:56.64,Default,,0,0,0,,А... анау Сакигучи-сенпай.
Dialogue: 0,0:12:56.64,0:13:01.68,Default,,0,0,0,,Біреу кенеттен осылай айтса, таң қалуыңыз мүмкін, бірақ...
Dialogue: 0,0:13:01.68,0:13:04.68,Default,,0,0,0,,Бірақ мен енді шыдай алмаймын.
Dialogue: 0,0:13:04.68,0:13:06.93,Default,,0,0,0,,Сакигучи-сенпай болуы керек.
Dialogue: 0,0:13:06.93,0:13:10.56,Default,,0,0,0,,Менің сезімімді тыңдай аласыз ба?
Dialogue: 0,0:13:10.56,0:13:11.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:11.97,0:13:15.32,Default,,0,0,0,,Сіз бірдеңені мойындауға тырысып жатқан сияқтысыз ба?
Dialogue: 0,0:13:15.32,0:13:16.72,Default,,0,0,0,,Жоқ, жоқ!
Dialogue: 0,0:13:16.72,0:13:18.69,Default,,0,0,0,,Сакигучи-сенпай әрине әдемі, бірақ
Dialogue: 0,0:13:18.69,0:13:21.03,Default,,0,0,0,,Менің талғамыма мүлдем сәйкес келмейді
Dialogue: 0,0:13:21.03,0:13:23.95,Default,,0,0,0,,Мен неге лақтырылған сияқтымын?
Dialogue: 0,0:13:24.45,0:13:27.70,Default,,0,0,0,,Сакигучи-сенпайдың маған айтқанын қалайтыным бар.
Dialogue: 0,0:13:27.70,0:13:30.64,Default,,0,0,0,,Бұл...дауыс туралы.
Dialogue: 0,0:13:30.64,0:13:31.58,Default,,0,0,0,,Дауыста?
Dialogue: 0,0:13:32.11,0:13:33.46,Default,,0,0,0,,Хор сайысы
Dialogue: 0,0:13:34.04,0:13:36.96,Default,,0,0,0,,Бұл Ring Academy жыл сайынғы жыл соңындағы іс-шара.
Dialogue: 0,0:13:36.96,0:13:39.72,Default,,0,0,0,,Мәселе бөліктерді бөлуде болды.
Dialogue: 0,0:13:42.47,0:13:45.72,Default,,0,0,0,,Неліктен мектепке ұл бала формасын киесің?
Dialogue: 0,0:13:45.72,0:13:48.72,Default,,0,0,0,,Мен осы уақытқа дейін ештеңе түсіндірмедім.
Dialogue: 0,0:13:48.72,0:13:52.23,Default,,0,0,0,,Бір нәрсе болса, менің дауысым жоғарырақ.
Dialogue: 0,0:13:52.23,0:13:55.48,Default,,0,0,0,,Мен горигори балаларымен бірге ән айттым.
Dialogue: 0,0:13:55.92,0:13:57.73,Default,,0,0,0,,Бұл айналды
Dialogue: 0,0:13:57.73,0:14:00.32,Default,,0,0,0,,Сонымен, Сакигучи-сенпай
Dialogue: 0,0:14:00.32,0:14:02.99,Default,,0,0,0,,Дауыс сапасын қалай өзгерту керектігін айта аласыз ба?
Dialogue: 0,0:14:02.99,0:14:07.16,Default,,0,0,0,,1 ән Мен ыңғайсызданбай айтатын төмен үн шығара алдым.
Dialogue: 0,0:14:07.16,0:14:09.75,Default,,0,0,0,,«Себебі» деген не?
Dialogue: 0,0:14:10.26,0:14:12.47,Default,,0,0,0,,Төраға мен төрағаның орынбасарына өтініш
Dialogue: 0,0:14:12.47,0:14:15.13,Default,,0,0,0,,Оны қайтадан сопраноға ауыстырсаңыз жақсы емес пе?
Dialogue: 0,0:14:15.13,0:14:17.34,Default,,0,0,0,,Қараңдаршы, біз сөйлесіп жатырмыз
Dialogue: 0,0:14:17.34,0:14:20.34,Default,,0,0,0,,Маған топтың бар екендігі туралы сөзді төгіп тастасам да, бәрібір.
Dialogue: 0,0:14:20.34,0:14:22.13,Default,,0,0,0,,Бұл дұрыс, бірақ
Dialogue: 0,0:14:23.94,0:14:27.15,Default,,0,0,0,,Жарайды. Котаки мырзаның ісіне қатысты.
Dialogue: 0,0:14:27.15,0:14:30.39,Default,,0,0,0,,Мен Маюми-санға біраз қиындық туғызған сияқтымын.
Dialogue: 0,0:14:30.75,0:14:34.39,Default,,0,0,0,,Ендеше, трюктерді айта білу техникасын үйретейік.
Dialogue: 0,0:14:34.97,0:14:37.77,Default,,0,0,0,,Алайда бір шарт бар.
Dialogue: 0,0:14:41.03,0:14:42.24,Default,,0,0,0,,Жағдайлар?
Dialogue: 0,0:14:42.73,0:14:44.66,Default,,0,0,0,,Шартсыз айттыңыз ба?
Dialogue: 0,0:14:45.98,0:14:49.08,Default,,0,0,0,,Маюми мырза, бұл да байланыстың бір түрі.
Dialogue: 0,0:14:49.08,0:14:52.16,Default,,0,0,0,,Сіз Котаки-санның досы бола аласыз ба?
Dialogue: 0,0:14:52.66,0:14:55.29,Default,,0,0,0,,Ол қыздың достары жоқ.
Dialogue: 0,0:14:55.29,0:14:59.38,Default,,0,0,0,,Иә? Дос болса, менде де жоқ.
Dialogue: 0,0:15:04.30,0:15:06.05,Default,,0,0,0,,Сіз қалай ойлайсыз? Нагахиро
Dialogue: 0,0:15:06.05,0:15:08.85,Default,,0,0,0,,Менің ойымша, бұл Котакидің жұмысы.
Dialogue: 0,0:15:08.85,0:15:10.85,Default,,0,0,0,,Әрине дерлік.
Dialogue: 0,0:15:10.85,0:15:15.35,Default,,0,0,0,,Әдеттегідей, мен сіздің не істегіңіз келетінін білмеймін.
Dialogue: 0,0:15:15.35,0:15:19.06,Default,,0,0,0,,Бұл құбыжық менің ойша бейнем бе?
Dialogue: 0,0:15:20.32,0:15:23.03,Default,,0,0,0,,Сәлем, Көшбасшы, мен кешігіп қалдым.
Dialogue: 0,0:15:23.03,0:15:26.20,Default,,0,0,0,,Жеке мәселелерге байланысты туындаған қолайсыздықтар үшін кешірім сұраймыз.
Dialogue: 0,0:15:26.20,0:15:30.33,Default,,0,0,0,,Эй, бұл маңызды емес. Арамызда жеке шаруа жоқ.
Dialogue: 0,0:15:30.79,0:15:34.50,Default,,0,0,0,,Осы шұғыл жағдайға бәріміз жауап берейік.
Dialogue: 0,0:15:38.58,0:15:40.29,Default,,0,0,0,,Кез келген жағдайда, Юрика-чан...
Dialogue: 0,0:15:40.29,0:15:42.40,Default,,0,0,0,,Котаки-чан емес.
Dialogue: 0,0:15:42.40,0:15:44.78,Default,,0,0,0,,Мен сіздің әдемі бала детектив тобына қосылуыңызды қалаймын.
Dialogue: 0,0:15:44.78,0:15:49.05,Default,,0,0,0,,Бұл сіздің түйіндемеңіздің орнына осы шайқасты тастап кеткеніңізді білдіре ме?
Dialogue: 0,0:15:49.05,0:15:52.72,Default,,0,0,0,,Бұл заттарға өте мейірімді көзқарас, Майами-сан.
Dialogue: 0,0:15:52.72,0:15:55.73,Default,,0,0,0,,Мен де олай ойламаймын.
Dialogue: 0,0:15:55.73,0:15:59.61,Default,,0,0,0,,Соғыс жариялау десеңіз, мен түсінемін.
Dialogue: 0,0:15:59.61,0:16:01.86,Default,,0,0,0,,Соғыс жариялау
Dialogue: 0,0:16:02.32,0:16:05.65,Default,,0,0,0,,Оның орнына шайқас беру дегенді қалай түсінесіңдер?
Dialogue: 0,0:16:05.65,0:16:07.11,Default,,0,0,0,,…қандай зат болмасын, бәрін бомбаға айналдырады.
Dialogue: 0,0:16:07.65,0:16:09.41,Default,,0,0,0,,Қандай ниетпен?
Dialogue: 0,0:16:09.41,0:16:12.99,Default,,0,0,0,,Біз жоқта осындай нәрсе қалдырсаңыз да.
Dialogue: 0,0:16:12.99,0:16:15.37,Default,,0,0,0,,Өкінішке орай, мен оны елеусіз қалдыра алмаймын.
Dialogue: 0,0:16:16.05,0:16:20.13,Default,,0,0,0,,Менің ойымша, оны үйіне апаруға рұқсат берген дұрыс.
Dialogue: 0,0:16:20.13,0:16:22.67,Default,,0,0,0,,Адамды қылмысты мойындатқаннан кейін
Dialogue: 0,0:16:22.67,0:16:25.38,Default,,0,0,0,,Оларды жауапкершілікке тарту дұрыс болар еді.
Dialogue: 0,0:16:25.38,0:16:29.51,Default,,0,0,0,,Адал айтқаныңды шайтан тыңдамайды деп ойлаймын.
Dialogue: 0,0:16:29.84,0:16:31.73,Default,,0,0,0,,Жарайды, Мицуру-кун.
Dialogue: 0,0:16:31.73,0:16:34.01,Default,,0,0,0,,Менде бұл туралы ақылды идея бар.
Dialogue: 0,0:16:34.01,0:16:36.09,Default,,0,0,0,,Қандай тамаша идея.
Dialogue: 0,0:16:36.09,0:16:38.77,Default,,0,0,0,,Мен өзімді араласып кеткендей сезінемін.
Dialogue: 0,0:16:39.77,0:16:41.12,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:16:41.12,0:16:44.69,Default,,0,0,0,,Менің ойымша, бұл келіссөзді Нагахиродан сұрауым керек.
Dialogue: 0,0:16:44.69,0:16:47.36,Default,,0,0,0,,Сенің әдемі дауысыңды ести алмайтын санаулы адамдар
Dialogue: 0,0:16:47.36,0:16:50.78,Default,,0,0,0,,Мен сені шығарып салуым керек, бірақ мен оны саған қалдырамын.
Dialogue: 0,0:16:51.59,0:16:53.75,Default,,0,0,0,,Балама қандай?
Dialogue: 0,0:16:53.75,0:16:57.04,Default,,0,0,0,,Басқа нәрсе туралы ойланайық
Dialogue: 0,0:16:57.52,0:17:01.00,Default,,0,0,0,,Хагоитаның көлемі сонша, оны кәдеге жарату оңай емес.
Dialogue: 0,0:17:01.00,0:17:05.05,Default,,0,0,0,,Оны мына өнер бөлмесіне әлгі шайтан қалай әкелді?
Dialogue: 0,0:17:05.05,0:17:06.94,Default,,0,0,0,,Егер сіз мұны түсінбесеңіз
Dialogue: 0,0:17:06.94,0:17:11.43,Default,,0,0,0,,Біз болашақта не және қашан әкелінетінін білмейміз.
Dialogue: 0,0:17:11.43,0:17:12.43,Default,,0,0,0,,Міне
Dialogue: 0,0:17:12.85,0:17:15.93,Default,,0,0,0,,Қауіпті болса да күдікті емес
Dialogue: 0,0:17:18.68,0:17:20.31,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:17:20.31,0:17:22.69,Default,,0,0,0,,Менің ойымша, бұл біртүрлі емес.
Dialogue: 0,0:17:22.69,0:17:25.02,Default,,0,0,0,,Олар вагонетканы немесе басқаларды пайдаланбады ма?
Dialogue: 0,0:17:25.02,0:17:28.99,Default,,0,0,0,,Сіз вагонетканы пайдалана алмайсыз, себебі мектеп ғимараты баспалдақтарға толы.
Dialogue: 0,0:17:28.99,0:17:32.09,Default,,0,0,0,,Егер сіз бұл мәселені шеше алсаңыз да,
Dialogue: 0,0:17:32.09,0:17:36.03,Default,,0,0,0,,Бойжеткенді өнер бөлмесіне апарған соң, Юрика-чан үйіне қарай бет алды.
Dialogue: 0,0:17:36.03,0:17:39.37,Default,,0,0,0,,Мен ол арбаны өзіммен бірге үйге апаруым керек еді.
Dialogue: 0,0:17:39.37,0:17:44.29,Default,,0,0,0,,Бірақ Зашикивара менің қасымнан өткенде қолы бос болды.
Dialogue: 0,0:17:44.29,0:17:45.46,Default,,0,0,0,,Маған да біреуін оқып бер
Dialogue: 0,0:17:45.46,0:17:49.30,Default,,0,0,0,,Неліктен сіз басқаларды ақылға қондыруға тырысқанда, соншалықты толқисыз?
Dialogue: 0,0:17:49.30,0:17:52.30,Default,,0,0,0,,Кавайке Котакидің тұлғасы дерлік бірдей емес пе?
Dialogue: 0,0:17:52.30,0:17:56.47,Default,,0,0,0,,Біреуден алып жүруді сұрау деген болмайды.
Dialogue: 0,0:17:58.57,0:18:00.47,Default,,0,0,0,,Мүмкін болса да
Dialogue: 0,0:18:00.47,0:18:03.85,Default,,0,0,0,,Ібілістің қасиетін ескерсек, оны біреуден сұрау мүмкін емес.
Dialogue: 0,0:18:05.50,0:18:08.32,Default,,0,0,0,,Және қылмыскерлердің санын көбейту.
Dialogue: 0,0:18:08.32,0:18:11.99,Default,,0,0,0,,Менің ойымша, психологиялық тұрғыдан оңай табылуды қалау мүмкін емес.
Dialogue: 0,0:18:11.99,0:18:15.87,Default,,0,0,0,,Сонда бұл Юрика-чанның кінәлі емес екенін білдіре ме?
Dialogue: 0,0:18:16.22,0:18:19.37,Default,,0,0,0,,Жоқ, кінәлі ол сөзсіз.
Dialogue: 0,0:18:19.81,0:18:22.00,Default,,0,0,0,,Жоғарыда айтқанымдай
Dialogue: 0,0:18:22.00,0:18:26.72,Default,,0,0,0,,Сол шайқас Котакидің шығармасы екені даусыз.
Dialogue: 0,0:18:28.74,0:18:33.20,Default,,0,0,0,,Қазіргі уақытта біз шешуге тиіс екі маңызды жұмбақ бар.
Dialogue: 0,0:18:33.20,0:18:36.01,Default,,0,0,0,,Котаки-чан неге олай жасады?
Dialogue: 0,0:18:36.01,0:18:39.31,Default,,0,0,0,,Котаки-чан мұны қалай жасады?
Dialogue: 0,0:18:39.31,0:18:41.68,Default,,0,0,0,,Мағынасы жоқ мотивке келетін болсақ
Dialogue: 0,0:18:41.68,0:18:44.15,Default,,0,0,0,,Нагахироның өзіне жақындаңыз
Dialogue: 0,0:18:44.15,0:18:48.69,Default,,0,0,0,,Ібіліс кінәлі болса, оғаш болатын әдіс туралы.
Dialogue: 0,0:18:48.69,0:18:50.90,Default,,0,0,0,,Біз осылай ойлаймыз.
Dialogue: 0,0:18:51.51,0:18:53.28,Default,,0,0,0,,Ең бірінші ойға оралатыны
Dialogue: 0,0:18:53.28,0:18:55.66,Default,,0,0,0,,Мен дайын өнімді әкелген жоқпын.
Dialogue: 0,0:18:55.66,0:18:58.08,Default,,0,0,0,,Материалдарды кішкене бөліктерге бөліп әкеліңіз
Dialogue: 0,0:18:58.08,0:19:01.29,Default,,0,0,0,,Өнер бөлмесінде жиналса да, өрнек болып қалады.
Dialogue: 0,0:19:01.29,0:19:04.29,Default,,0,0,0,,Бұл мүмкін емес, Факу-кун.
Dialogue: 0,0:19:04.29,0:19:06.67,Default,,0,0,0,,Бұл бір тақта.
Dialogue: 0,0:19:07.11,0:19:10.96,Default,,0,0,0,,Сол шайқас сол пішінде аяқталды.
Dialogue: 0,0:19:10.96,0:19:13.42,Default,,0,0,0,,Көлемі балаларды көтеруге тым үлкен.
Dialogue: 0,0:19:13.82,0:19:17.30,Default,,0,0,0,,Сіз осындай өлшемдегі есіктен кіре аласыз ба?
Dialogue: 0,0:19:17.30,0:19:20.85,Default,,0,0,0,,Сондай-ақ, бұл таңқаларлық жеңіл нәрсе болуы мүмкін.
Dialogue: 0,0:19:20.85,0:19:22.43,Default,,0,0,0,,Жауынгерлік шеберлікті көтеріңіз
Dialogue: 0,0:19:22.43,0:19:27.14,Default,,0,0,0,,Айтпақшы, оның бастапқы пішінінде есіктен өтетін-өтпейтінін тексеріңіз.
Dialogue: 0,0:19:27.14,0:19:29.36,Default,,0,0,0,,Бір оқпен екі құсты өлтіру
Dialogue: 0,0:19:29.36,0:19:32.44,Default,,0,0,0,,Мұны кім жасайды деген сұрақ туындайды.
Dialogue: 0,0:19:32.44,0:19:36.99,Default,,0,0,0,,Бұл қорқынышты шайқасқа кім тиеді?
Dialogue: 0,0:19:36.99,0:19:42.08,Default,,0,0,0,,Бұл топтағы физикалық күші ең аз адам істеуі керек жұмыс шығар.
Dialogue: 0,0:19:42.63,0:19:43.75,Default,,0,0,0,,Содан кейін Ли...
Dialogue: 0,0:19:44.66,0:19:46.83,Default,,0,0,0,,Жоқ, мен істеймін.
Dialogue: 0,0:19:46.83,0:19:51.00,Default,,0,0,0,,Қорқынышты! Бұл ұйымда көшбасшыны тым жақсы көреді.
Dialogue: 0,0:19:57.22,0:20:00.35,Default,,0,0,0,,Маған біреу көмектессін! Мен мұны істей алмаймын!
Dialogue: 0,0:20:00.35,0:20:02.35,Default,,0,0,0,,Батыр ана Буруна
Dialogue: 0,0:20:06.09,0:20:08.73,Default,,0,0,0,,Жарайсың балам, сен маған сене аласың.
Dialogue: 0,0:20:08.73,0:20:10.69,Default,,0,0,0,,Батыр ана болудан бас тарту
Dialogue: 0,0:20:10.69,0:20:13.23,Default,,0,0,0,,Апалы-сіңлілі позицияға отыруға тырыспаңыз
Dialogue: 0,0:20:13.61,0:20:15.58,Default,,0,0,0,,Ей, мен оны апарамын.
Dialogue: 0,0:20:29.85,0:20:32.04,Default,,0,0,0,,Мен өте оңай өттім.
Dialogue: 0,0:20:33.80,0:20:37.17,Default,,0,0,0,,Оны үстелдің үстіне қойып, қарап шығуым керек пе?
Dialogue: 0,0:20:37.76,0:20:41.43,Default,,0,0,0,,Оны бір рет бөліп алсақ қалай болады?
Dialogue: 0,0:20:41.43,0:20:42.88,Default,,0,0,0,,Иә, бірақ
Dialogue: 0,0:20:42.88,0:20:46.39,Default,,0,0,0,,Енді мен оны сол күйінде кіргізе алатынымды білемін.
Dialogue: 0,0:20:46.39,0:20:49.56,Default,,0,0,0,,Бірақ біз оны бөліп алсақ, бірдеңені анықтай аламыз.
Dialogue: 0,0:20:52.06,0:20:53.65,Default,,0,0,0,,Суретші ретінде
Dialogue: 0,0:20:53.65,0:20:56.57,Default,,0,0,0,,Өзгелердің туындыларының жойылуын назардан тыс қалдыруға болмайтын сияқты.
Dialogue: 0,0:20:57.03,0:21:00.20,Default,,0,0,0,,Жоқ, онда менің орныма Икуаши-кунға айт.
Dialogue: 0,0:21:00.20,0:21:03.46,Default,,0,0,0,,Кімді жоюға дайын?
Dialogue: 0,0:21:04.10,0:21:05.08,Default,,0,0,0,,Хмм
Dialogue: 0,0:21:05.43,0:21:09.04,Default,,0,0,0,,Олай болса, бүгінгі пікірталас осы туралы деп ойлаймын.
Dialogue: 0,0:21:09.04,0:21:11.33,Default,,0,0,0,,Бұл мен ұзаққа созғым келетін мәселе емес.
Dialogue: 0,0:21:11.71,0:21:14.09,Default,,0,0,0,,Ертең ерте кездесейік.
Dialogue: 0,0:21:14.09,0:21:18.84,Default,,0,0,0,,Нагахиродан басқа мүшелердің әрқайсысы өздерінің әдемі шегерімдерін әкелуі керек.
Dialogue: 0,0:21:18.84,0:21:20.41,Default,,0,0,0,,Кавайкекотаки-кун
Dialogue: 0,0:21:20.41,0:21:23.85,Default,,0,0,0,,Алып шайқасты осы бөлмеге қалай кіргіздің?
Dialogue: 0,0:21:24.34,0:21:26.06,Default,,0,0,0,,Олай болса
Dialogue: 0,0:21:26.06,0:21:29.23,Default,,0,0,0,,Оқу-жаттығу жиынының қай жерде болғанын ойлаңыз.
Dialogue: 0,0:21:30.23,0:21:32.48,Default,,0,0,0,,Осымен біз бүгін таратылдық.
Dialogue: 0,0:23:15.71,0:23:17.96,Default,,0,0,0,,Бұл ұсқынсыз поза.
Dialogue: 0,0:23:21.34,0:23:23.42,Default,,0,0,0,,Мадонна
Dialogue: 0,0:00:13.62,0:00:14.70,Default,,0,0,0,,Барып, емтиханға дайындалу стратегияңды жаса
Dialogue: 0,0:00:14.70,0:00:17.50,Default,,0,0,0,,Барып, емтиханға дайындалу стратегияңды жаса
Dialogue: 0,0:00:13.62,0:00:14.70,Default,,0,0,0,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
