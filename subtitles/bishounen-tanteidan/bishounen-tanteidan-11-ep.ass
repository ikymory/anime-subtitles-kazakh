Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:22:02.51,0:22:06.76,Default,,0,0,0,,Көктен шыққан болт, оқиғасы жанды
Dialogue: 0,0:22:06.35,0:22:09.98,Default,,0,0,0,,Қызық күндеріңізді бояңыз
Dialogue: 0,0:22:10.68,0:22:14.15,Default,,0,0,0,,Көпшілікті алдайтын көркем әдебиет
Dialogue: 0,0:22:14.44,0:22:18.15,Default,,0,0,0,,Біз өзімізден жарықты да жібермейміз.
Dialogue: 0,0:22:20.40,0:22:26.70,Default,,0,0,0,,«Егер» лабиринтінде ойлануға тыйым салынады
Dialogue: 0,0:22:26.99,0:22:33.37,Default,,0,0,0,,Дұрыс, батылдық - шегерудің кілті... иә?
Dialogue: 0,0:22:34.92,0:22:38.04,Default,,0,0,0,,Әр сәт пен секунд туады
Dialogue: 0,0:22:38.42,0:22:41.88,Default,,0,0,0,,Драма Карма Оны жіберіп алмаңыз
Dialogue: 0,0:22:42.22,0:22:44.01,Default,,0,0,0,,Кім қайда не істеді?
Dialogue: 0,0:22:44.01,0:22:50.18,Default,,0,0,0,,Қанша рет бетпердеге тырыссаң да
Dialogue: 0,0:22:50.18,0:22:51.47,Default,,0,0,0,,«Әдемі, солай емес пе?»
Dialogue: 0,0:22:51.64,0:22:54.98,Default,,0,0,0,,Сіз детективті шақырып жатырсыз.
Dialogue: 0,0:22:54.98,0:22:58.98,Default,,0,0,0,,Жұмбақ жерге апатты қону
Dialogue: 0,0:22:58.98,0:23:02.28,Default,,0,0,0,,Әлем қиын сынақтарды іздейді.
Dialogue: 0,0:23:02.28,0:23:05.91,Default,,0,0,0,,Тапсырыспен жасалған Жұмбақ тәсілдер
Dialogue: 0,0:23:05.91,0:23:09.91,Default,,0,0,0,,Жомарт құрметпен бәрін ашайық.
Dialogue: 0,0:23:09.91,0:23:11.33,Default,,0,0,0,,Айдың жасырын жағы
Dialogue: 0,0:23:11.33,0:23:11.87,Default,,0,0,0,,Айдың жасырын жағы
Dialogue: 0,0:23:11.87,0:23:12.54,Default,,0,0,0,,Айдың жасырын жағы
Dialogue: 0,0:23:12.54,0:23:13.20,Default,,0,0,0,,Айдың жасырын жағы
Dialogue: 0,0:23:13.20,0:23:13.83,Default,,0,0,0,,Айдың жасырын жағы
Dialogue: 0,0:23:13.83,0:23:17.46,Default,,0,0,0,,Кешкі асқа дәл уақытында
Dialogue: 0,0:23:17.46,0:23:21.46,Default,,0,0,0,,Бірегей пайымдауды қарастырайық
Dialogue: 0,0:06:57.31,0:06:58.69,Default,,0,0,0,,Артқы бөлік
Dialogue: 0,0:01:30.49,0:01:33.99,Default,,0,0,0,,Сайлау науқаны қызу басталды.
Dialogue: 0,0:01:33.99,0:01:37.54,Default,,0,0,0,,Мектеп газетінде жарияланған хабарландырудың бастапқы мақұлдау рейтингі болды
Dialogue: 0,0:01:37.54,0:01:42.00,Default,,0,0,0,,Сенпай-кун оқығанда, үстіңгі жағы Йоно-кун болды.
Dialogue: 0,0:01:42.37,0:01:44.92,Default,,0,0,0,,Бұл өлі мінезді сыныптасы қандай?
Dialogue: 0,0:01:44.92,0:01:48.50,Default,,0,0,0,,Оны қандай адамдар қолдағанын білмедім, бірақ...
Dialogue: 0,0:01:48.50,0:01:51.42,Default,,0,0,0,,Дегенмен, әділ сауалнама нәтижелері
Dialogue: 0,0:01:51.42,0:01:56.51,Default,,0,0,0,,Респонденттердің жартысынан көбі Йоно Кинроға дауыс беретіндерін айтты.
Dialogue: 0,0:01:56.97,0:01:59.64,Default,,0,0,0,,Қалай болғанда да, мұндай Йоно-кун үшін,
Dialogue: 0,0:01:59.64,0:02:04.02,Default,,0,0,0,,Сауалнамада мақұлдау рейтингінде үшінші орын алған Майуми Хитомиджима,
Dialogue: 0,0:02:04.02,0:02:08.02,Default,,0,0,0,,Сонда да мен жақсы күресіп жаттым.
Dialogue: 0,0:02:27.38,0:02:31.01,Default,,0,0,0,,Шындығында, мен өз күндерімді асықпай өткізіп жатырмын.
Dialogue: 0,0:02:31.01,0:02:34.80,Default,,0,0,0,,Наганава мырзаны әдейі басып кетті деп ойлау қисынсыз емес пе?
Dialogue: 0,0:02:34.80,0:02:37.68,Default,,0,0,0,,Мен де солай сезіне бастадым.
Dialogue: 0,0:02:37.68,0:02:41.22,Default,,0,0,0,,Бақытымызға орай, бұл үлкен мәселе емес еді.
Dialogue: 0,0:02:41.22,0:02:42.93,Default,,0,0,0,,Мүмкін Наганава мырза
Dialogue: 0,0:02:42.93,0:02:45.19,Default,,0,0,0,,Ол өліп кетуі мүмкін еді, солай ма?
Dialogue: 0,0:02:45.19,0:02:47.69,Default,,0,0,0,,Тіпті олар мұны оқыс оқиғаға ұқсатқысы келсе де
Dialogue: 0,0:02:47.69,0:02:50.19,Default,,0,0,0,,Басқа жолдар болуы керек
Dialogue: 0,0:02:50.19,0:02:53.44,Default,,0,0,0,,Тіпті егер D-тәрізді ұрып-соққан қылмыскер бар болса да
Dialogue: 0,0:02:54.07,0:02:57.91,Default,,0,0,0,,Неліктен көліктің кісі өлтіру қаруын таңдағаны жұмбақ.
Dialogue: 0,0:02:57.91,0:03:01.83,Default,,0,0,0,,Жақсы, ол мектепті басқаруға қатысқан қаскүнем болса да.
Dialogue: 0,0:03:01.83,0:03:04.50,Default,,0,0,0,,Сюжетті көпшіліктің назарына шығару
Dialogue: 0,0:03:04.50,0:03:07.83,Default,,0,0,0,,Менің сайлауым расталмады.
Dialogue: 0,0:03:08.58,0:03:09.59,Default,,0,0,0,,Ауырды, ауырады!
Dialogue: 0,0:03:09.59,0:03:12.59,Default,,0,0,0,,Кешіріңіз, кешіріңіз, сіз аю бола алмайсыз.
Dialogue: 0,0:03:12.92,0:03:13.59,Default,,0,0,0,,Маю
Dialogue: 0,0:03:13.59,0:03:14.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:15.59,0:03:16.93,Default,,0,0,0,,Маю...
Dialogue: 0,0:03:16.93,0:03:19.60,Default,,0,0,0,,Маю маңызды нәрсені елемеді.
Dialogue: 0,0:03:20.85,0:03:24.98,Default,,0,0,0,,Кісі өлтіру қаруы ретінде көлік таңдалғаны жұмбақ деп ойласаңыз
Dialogue: 0,0:03:24.98,0:03:27.73,Default,,0,0,0,,Детектив жұмбақты шешуі керек
Dialogue: 0,0:03:27.73,0:03:30.36,Default,,0,0,0,,Табиғатсыздықтың әрқашан себебі бар.
Dialogue: 0,0:03:30.36,0:03:32.48,Default,,0,0,0,,Автокөліктер мен...
Dialogue: 0,0:03:35.15,0:03:38.11,Default,,0,0,0,,Банро Йононың ісі
Dialogue: 0,0:03:39.12,0:03:41.24,Default,,0,0,0,,Автокөлікті қару ретінде пайдалану
Dialogue: 0,0:03:41.24,0:03:44.25,Default,,0,0,0,,Оқиға болып көрінгеннен басқа пайда бар ма?
Dialogue: 0,0:03:45.12,0:03:48.12,Default,,0,0,0,,Жаңа куәгерлер пайда болмайды.
Dialogue: 0,0:03:48.12,0:03:51.00,Default,,0,0,0,,Біз мұндай айғақтарды ала алмаймыз.
Dialogue: 0,0:03:51.46,0:03:55.76,Default,,0,0,0,,Ұзын арқанның төңірегінде бұдан басқа мұндай қиыншылықтар болған жоқ.
Dialogue: 0,0:03:56.09,0:03:57.76,Default,,0,0,0,,Түсінікті болу үшін...
Dialogue: 0,0:03:58.89,0:04:00.14,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:04:00.14,0:04:01.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:01.47,0:04:04.31,Default,,0,0,0,,Мен мұны айтсам, Нагахиро ашулануы мүмкін.
Dialogue: 0,0:04:04.31,0:04:06.64,Default,,0,0,0,,Айтқым келмейді.
Dialogue: 0,0:04:06.64,0:04:10.10,Default,,0,0,0,,Нагахиро ашуланса да, басқа амал жоқ.
Dialogue: 0,0:04:10.10,0:04:13.77,Default,,0,0,0,,Әдеттегідей бұл көшбасшының идеясы емес.
Dialogue: 0,0:04:14.82,0:04:16.90,Default,,0,0,0,,Бұл мәселе.
Dialogue: 0,0:04:16.90,0:04:18.32,Default,,0,0,0,,Осымен.
Dialogue: 0,0:04:18.32,0:04:21.62,Default,,0,0,0,,Д-закадағы қағып кеткен қылмыскер шынымен бар екенін бұрын білесіз бе?
Dialogue: 0,0:04:21.62,0:04:25.29,Default,,0,0,0,,Жол-көлік оқиғасының өзі болды ма деген сұрақ туындай бастады.
Dialogue: 0,0:04:25.29,0:04:27.66,Default,,0,0,0,,Не? Бұл нені білдіреді?
Dialogue: 0,0:04:28.87,0:04:30.67,Default,,0,0,0,,Сіз бұл Киоген деп айтасыз ба?
Dialogue: 0,0:04:31.67,0:04:33.50,Default,,0,0,0,,Оны айтқым келмейді.
Dialogue: 0,0:04:33.50,0:04:35.76,Default,,0,0,0,,Сен, масқара, бұл бетті жасасаң да.
Dialogue: 0,0:04:35.76,0:04:38.80,Default,,0,0,0,,Бұл Нагахиро немесе жетекші сізге айта алатын шегерім емес.
Dialogue: 0,0:04:39.13,0:04:43.30,Default,,0,0,0,,Сонымен... бірақ куәлар болмаса да, айғақ бар, солай емес пе?
Dialogue: 0,0:04:43.30,0:04:46.06,Default,,0,0,0,,Досыммен сөйлесіп жатқанда мені басып қалды.
Dialogue: 0,0:04:47.39,0:04:50.44,Default,,0,0,0,,Менің досым көлікті көргендей емес.
Dialogue: 0,0:04:50.85,0:04:53.36,Default,,0,0,0,,Маған жазылған көлік дыбыстарын тыңдауға рұқсат етіңіз.
Dialogue: 0,0:04:53.36,0:04:56.28,Default,,0,0,0,,Жазатайым оқиғаны жасау соншалықты қиын емес.
Dialogue: 0,0:04:56.28,0:04:58.15,Default,,0,0,0,,Аузыңыздың артқы жағын біріктіріп, түпкілікті
Dialogue: 0,0:04:58.15,0:05:00.61,Default,,0,0,0,,Айғақты сұрау мүмкін емес.
Dialogue: 0,0:05:01.45,0:05:04.45,Default,,0,0,0,,«Бұл мүмкін емес.»
Dialogue: 0,0:05:04.45,0:05:06.29,Default,,0,0,0,,Нүкте бойынша
Dialogue: 0,0:05:06.29,0:05:09.96,Default,,0,0,0,,Бұл жағдайда ешқандай дәлел немесе айғақтардың болмауы заңды.
Dialogue: 0,0:05:09.96,0:05:10.96,Default,,0,0,0,,Мәселе мынада
Dialogue: 0,0:05:10.96,0:05:16.71,Default,,0,0,0,,Неліктен Наганава мырзаның өзі шығарған мұндай спектакль қоюы керек?
Dialogue: 0,0:05:18.63,0:05:20.88,Default,,0,0,0,,Киоген деп есептесек
Dialogue: 0,0:05:20.88,0:05:24.47,Default,,0,0,0,,Мен өзімді ауыртатын мотив туралы ғана ойлаймын.
Dialogue: 0,0:05:25.97,0:05:30.02,Default,,0,0,0,,Ойға бірінші келетін нәрсе - қорқу.
Dialogue: 0,0:05:31.14,0:05:34.77,Default,,0,0,0,,Бұл шынымен ойға келмейді.
Dialogue: 0,0:05:35.11,0:05:36.98,Default,,0,0,0,,Күтпеген жазатайым оқиғаны жасау
Dialogue: 0,0:05:36.98,0:05:39.99,Default,,0,0,0,,Науқаннан соңғы минутта шығу арқылы
Dialogue: 0,0:05:39.99,0:05:43.95,Default,,0,0,0,,Қазіргі биліктің жалғасуына кедергі жасауды көздеген
Dialogue: 0,0:05:43.95,0:05:48.91,Default,,0,0,0,,Мен Сенпай-күннің саяси ойларын мазақ етуге тырыстым.
Dialogue: 0,0:05:48.91,0:05:52.42,Default,,0,0,0,,Мысалы, сіз басқа үміткерлерді білесіз бе?
Dialogue: 0,0:05:52.71,0:05:55.67,Default,,0,0,0,,Қазіргі уақытта ең жоғары үміткер - Йоно-кун.
Dialogue: 0,0:05:56.09,0:05:57.92,Default,,0,0,0,,Бұл жақсы болар еді.
Dialogue: 0,0:05:57.92,0:06:01.42,Default,,0,0,0,,Наганава мектеп жағымен сөйлесе алса жақсы болар еді.
Dialogue: 0,0:06:01.42,0:06:02.93,Default,,0,0,0,,Мектеп жағымен?
Dialogue: 0,0:06:02.93,0:06:08.22,Default,,0,0,0,,Нагахироның саяси жүйесі мектеп үшін ыңғайсыз болғаны рас.
Dialogue: 0,0:06:08.22,0:06:12.64,Default,,0,0,0,,Сайлауда Нагахиро лагерімен бетпе-бет күресудің орнына мектеп не істеу керек?
Dialogue: 0,0:06:12.64,0:06:17.06,Default,,0,0,0,,Оның мұрагерін баурап алу тезірек емес пе еді?
Dialogue: 0,0:06:18.82,0:06:20.74,Default,,0,0,0,,Ертең сабақтан кейін де
Dialogue: 0,0:06:20.74,0:06:23.45,Default,,0,0,0,,Мүмкін мен бірден Наганаваға баруым керек.
Dialogue: 0,0:06:24.11,0:06:26.70,Default,,0,0,0,,Нагахироға айтпа
Dialogue: 0,0:06:29.62,0:06:31.70,Default,,0,0,0,,Мен Одори мырзамен кездесуге барамын.
Dialogue: 0,0:06:32.08,0:06:33.46,Default,,0,0,0,,Би-сан…
Dialogue: 0,0:06:33.46,0:06:35.46,Default,,0,0,0,,Созуин биі
Dialogue: 0,0:06:35.46,0:06:37.59,Default,,0,0,0,,Әдемі бала детектив тобының негізін қалаушы
Dialogue: 0,0:06:37.59,0:06:42.21,Default,,0,0,0,,Ал қазіргі басшы, Манабу Сотоиннің ағасы
Dialogue: 0,0:06:42.21,0:06:45.47,Default,,0,0,0,,Адамдар мені «Әдемі әңгімелер одолы» деп атайды.
Dialogue: 0,0:06:45.89,0:06:49.97,Default,,0,0,0,,Іс осылай жалғаса берсе, сайлау науқаны созыла беретін сияқты.
Dialogue: 0,0:06:50.31,0:06:53.98,Default,,0,0,0,,Мүмкін болса қолданғым келмейтін трюкті қолдануды шештім.
Dialogue: 0,0:06:53.98,0:06:56.98,Default,,0,0,0,,Сонымен, Одори-сан қайда?
Dialogue: 0,0:06:57.31,0:06:58.69,Default,,0,0,0,,Орта мектеп.
Dialogue: 0,0:06:58.69,0:06:59.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:59.40,0:07:03.24,Default,,0,0,0,,Көшбасшылар өз бастарында ағайынды ма?
Dialogue: 0,0:07:03.24,0:07:05.24,Default,,0,0,0,,Бастың артқы жағы емес
Dialogue: 0,0:07:05.24,0:07:07.99,Default,,0,0,0,,Мидың ішінде кім тұрады?
Dialogue: 0,0:07:08.70,0:07:12.20,Default,,0,0,0,,Орта мектеп...Мен Ring Academy орта мектебінің екінші курс студентімін.
Dialogue: 0,0:07:12.20,0:07:15.08,Default,,0,0,0,,Сонымен...кеңес сұрайын деп тұрсың ба?
Dialogue: 0,0:07:15.08,0:07:18.00,Default,,0,0,0,,«Әдемі бала» детектив тобының бірінші жетекшісі
Dialogue: 0,0:07:18.00,0:07:21.71,Default,,0,0,0,,Одори-санға бірінші басшы ретінде барудан гөрі.
Dialogue: 0,0:07:21.71,0:07:25.51,Default,,0,0,0,,Мен бұрынғы студенттік кеңестің президенті болған Одори мырзаға барғалы жатырмын.
Dialogue: 0,0:07:25.51,0:07:27.89,Default,,0,0,0,,Студенттік кеңестің бұрынғы төрағасы?
Dialogue: 0,0:07:27.89,0:07:28.80,Default,,0,0,0,,Иә
Dialogue: 0,0:07:28.80,0:07:33.18,Default,,0,0,0,,Одори-сан туралы үшінші курс студенттері арасында әлі де айтылып жүр.
Dialogue: 0,0:07:33.18,0:07:36.02,Default,,0,0,0,,Ол аты аңызға айналған студенттер кеңесінің президенті.
Dialogue: 0,0:07:36.39,0:07:39.02,Default,,0,0,0,,Мен салыстыруға келмейді
Dialogue: 0,0:07:41.65,0:07:44.40,Default,,0,0,0,,Менің қолдауым жеткіліксіз.
Dialogue: 0,0:07:44.40,0:07:48.11,Default,,0,0,0,,Мен Маюмиді шыңға шығара алмадым.
Dialogue: 0,0:07:48.11,0:07:52.37,Default,,0,0,0,,Біз Одори-саннан әрі қарай қолдау аламыз деп үміттенеміз.
Dialogue: 0,0:07:52.37,0:07:57.04,Default,,0,0,0,,Олай болса, жетекшінің қасыңызда болғаны дұрыс емес пе? Ол менің інім.
Dialogue: 0,0:07:57.04,0:07:59.75,Default,,0,0,0,,Көшбасшының сізге еріп жүруінің қажеті жоқ.
Dialogue: 0,0:08:00.79,0:08:04.05,Default,,0,0,0,,Ағайындар, тіл табыса алмай жүрсіңдер ме?
Dialogue: 0,0:08:04.55,0:08:07.01,Default,,0,0,0,,Жоқ, олай емес...
Dialogue: 0,0:08:07.80,0:08:10.30,Default,,0,0,0,,Ал, кездескенде түсінерсің.
Dialogue: 0,0:08:10.97,0:08:14.35,Default,,0,0,0,,Өйткені ол «Әдемі бала» детектив тобының негізін қалаушы.
Dialogue: 0,0:08:14.35,0:08:15.98,Default,,0,0,0,,Бұл әдемі әңгіме.
Dialogue: 0,0:08:15.98,0:08:19.23,Default,,0,0,0,,Ең бастысы, ол сол басшының ағасы.
Dialogue: 0,0:08:19.23,0:08:22.02,Default,,0,0,0,,Менің қиялым ұшады
Dialogue: 0,0:08:22.02,0:08:25.94,Default,,0,0,0,,Бірақ бұл қорқыныш негізсіз болды.
Dialogue: 0,0:08:25.94,0:08:28.70,Default,,0,0,0,,Бағаны нашар өткізіп алды
Dialogue: 0,0:08:28.70,0:08:30.20,Default,,0,0,0,,Қалай айта аламын...
Dialogue: 0,0:08:31.24,0:08:34.12,Default,,0,0,0,,Ол кәдімгі зерделі адам болып көрінді.
Dialogue: 0,0:08:34.12,0:08:37.20,Default,,0,0,0,,Танысқаныма қуаныштымын, бұл Созуин Одори.
Dialogue: 0,0:08:37.54,0:08:39.33,Default,,0,0,0,,Сіз Майами-чансыз, солай ма?
Dialogue: 0,0:08:39.33,0:08:41.50,Default,,0,0,0,,Мен Сакигучиден естідім.
Dialogue: 0,0:08:41.50,0:08:44.46,Default,,0,0,0,,Сіз студенттік кеңестің президенті сайлауына қатысасыз ба?
Dialogue: 0,0:08:44.46,0:08:46.05,Default,,0,0,0,,Әр сынып үшін түрлі жарыстарға іріктеу кезеңдері өткізіледі—
Dialogue: 0,0:08:46.05,0:08:48.80,Default,,0,0,0,,Сакигучидің ұсынысы міндетті түрде болады.
Dialogue: 0,0:08:48.80,0:08:51.59,Default,,0,0,0,,Менің атымды қалағаныңызша пайдалана аласыз.
Dialogue: 0,0:08:51.59,0:08:53.51,Default,,0,0,0,,Әй, ініме сәлем айт.
Dialogue: 0,0:08:53.51,0:08:57.39,Default,,0,0,0,,«Үлкен ағалар мен апаларға мәңгі тәуелді бола алмайсың».\NМаған
Dialogue: 0,0:08:57.39,0:08:59.06,Default,,0,0,0,,айтып бере аласыз ба?
Dialogue: 0,0:09:00.10,0:09:01.85,Default,,0,0,0,,Бұл қалыпты жағдай.
Dialogue: 0,0:09:01.85,0:09:05.23,Default,,0,0,0,,Ол жалпы мейірімді және жалпы жақсы адам.
Dialogue: 0,0:09:05.23,0:09:08.32,Default,,0,0,0,,Мені көсемнің ағасы десең, мен солай ойлаймын.
Dialogue: 0,0:09:08.32,0:09:12.74,Default,,0,0,0,,Көшбасшы өскенде осындай болады деп ойлаймын...
Dialogue: 0,0:09:12.74,0:09:17.12,Default,,0,0,0,,Бірақ бұл жай ғана орынсыз болумен қатар, біртүрлі сезінді.
Dialogue: 0,0:09:17.45,0:09:20.29,Default,,0,0,0,,Тіпті бұрыннан таныс ағаммен.
Dialogue: 0,0:09:20.29,0:09:22.63,Default,,0,0,0,,Мен бір жерде қашықтықты сақтап жүргендей болдым.
Dialogue: 0,0:09:22.63,0:09:25.88,Default,,0,0,0,,Ыңғайсыз және алыс...
Dialogue: 0,0:09:25.88,0:09:31.13,Default,,0,0,0,,Мм... сіз әлі де орта мектебіңіздегі студенттік кеңесте белсендісіз бе?
Dialogue: 0,0:09:34.64,0:09:36.26,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:09:36.72,0:09:40.77,Default,,0,0,0,,Мен мұндай әрекетті қойдым.
Dialogue: 0,0:09:40.77,0:09:43.27,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:43.65,0:09:48.03,Default,,0,0,0,,Одан әрі сұрақ қойғым келмейтіндей етіп айтылды.
Dialogue: 0,0:09:48.03,0:09:52.78,Default,,0,0,0,,Аты аңызға айналған студенттік кеңестің президенті болған кезден ұялғандай.
Dialogue: 0,0:09:53.20,0:09:56.12,Default,,0,0,0,,Жастық ғашықтық әсер еткендей
Dialogue: 0,0:09:57.99,0:09:59.29,Default,,0,0,0,,Сакигучи
Dialogue: 0,0:09:59.29,0:10:02.37,Default,,0,0,0,,Менің ініме қамқорлық жасасаңыз пайдалы болар еді.
Dialogue: 0,0:10:02.37,0:10:04.79,Default,,0,0,0,,Жақында сен де орта мектепке түсесің.
Dialogue: 0,0:10:04.79,0:10:08.25,Default,,0,0,0,,Бала ойынын доғаратын кез келді.
Dialogue: 0,0:10:08.25,0:10:11.55,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:10:11.55,0:10:13.88,Default,,0,0,0,,Ол сонымен қатар студенттер кеңесінің тамаша төрағасы болды.
Dialogue: 0,0:10:13.88,0:10:16.80,Default,,0,0,0,,Ол сонымен қатар Әдемі бала детектив тобының негізін қалаушы болды.
Dialogue: 0,0:10:16.80,0:10:20.85,Default,,0,0,0,,Одори-сан үшін бұл қазірдің өзінде өткен нәрсе.
Dialogue: 0,0:10:20.85,0:10:23.52,Default,,0,0,0,,Мен бұл ешқашан болған емес деп көрсеткім келмейді, бірақ
Dialogue: 0,0:10:23.52,0:10:28.32,Default,,0,0,0,,Одори-сан енді басқару саясаты үшін мектеппен күреспейді.
Dialogue: 0,0:10:28.32,0:10:32.90,Default,,0,0,0,,Менің сұлу бала сияқты детектив боламын деген ниетім жоқ.
Dialogue: 0,0:10:32.90,0:10:37.16,Default,,0,0,0,,Олар әрине ескі достар, бірақ олар команда емес.
Dialogue: 0,0:10:37.16,0:10:39.58,Default,,0,0,0,,Неге олай істедің?
Dialogue: 0,0:10:39.58,0:10:43.71,Default,,0,0,0,,Қаншалықты маңызды болды және ол қаншалықты алмастырылмайтын болды.
Dialogue: 0,0:10:43.71,0:10:46.08,Default,,0,0,0,,Ол кісіні енді есіме түсіре алмаймын.
Dialogue: 0,0:10:46.54,0:10:49.75,Default,,0,0,0,,Иә, біз балалар ойынын бітірдік.
Dialogue: 0,0:10:49.75,0:10:50.84,Default,,0,0,0,,Міне.
Dialogue: 0,0:10:51.21,0:10:54.47,Default,,0,0,0,,Ән айтып, би билеп сөйлесетін адам еді.
Dialogue: 0,0:10:54.97,0:10:58.22,Default,,0,0,0,,Бұл адам қасында болғанда, Әдемі бала детектив тобы болды
Dialogue: 0,0:10:58.22,0:11:01.97,Default,,0,0,0,,Әр күнім мюзикл сияқты өтті.
Dialogue: 0,0:11:02.77,0:11:04.23,Default,,0,0,0,,Әдемі әңгімелер одолы
Dialogue: 0,0:11:04.64,0:11:08.86,Default,,0,0,0,,Ән салғанда кез келген оқиға оқиғаға айналды.
Dialogue: 0,0:11:08.86,0:11:12.53,Default,,0,0,0,,Сіз орта мектепте ән айтуды, би билеуді қойған сияқтысыз.
Dialogue: 0,0:11:12.53,0:11:14.61,Default,,0,0,0,,Неге тоқтадың?
Dialogue: 0,0:11:14.61,0:11:16.95,Default,,0,0,0,,Оқудан қолы босамағандықтан болар.
Dialogue: 0,0:11:16.95,0:11:19.37,Default,,0,0,0,,Себебі мен ұлттық деңгейді білдім
Dialogue: 0,0:11:19.37,0:11:21.58,Default,,0,0,0,,Сіз осылай айттыңыз.
Dialogue: 0,0:11:21.58,0:11:24.12,Default,,0,0,0,,Мен шынымен білмеймін
Dialogue: 0,0:11:24.12,0:11:28.25,Default,,0,0,0,,Мен де қазір осындай қоқыс таңбасын пайдаланып жатырмын.
Dialogue: 0,0:11:28.25,0:11:32.25,Default,,0,0,0,,Мен жоғары сынып оқушысы болғаннан кейін оны ұмытамын ба?
Dialogue: 0,0:11:32.25,0:11:34.76,Default,,0,0,0,,Маями-санның қоқысы өмір бойы.
Dialogue: 0,0:11:34.76,0:11:37.76,Default,,0,0,0,,Менің ойымша, бұл туралы уайымдаудың қажеті жоқ.
Dialogue: 0,0:11:37.76,0:11:42.26,Default,,0,0,0,,Өсу эволюциясы Реабилитация Пісу
Dialogue: 0,0:11:42.26,0:11:43.68,Default,,0,0,0,,Қоқыс тастаңыз
Dialogue: 0,0:11:43.68,0:11:48.02,Default,,0,0,0,,Менің ойымша, ол орта мектептің екінші курсында оқитынына қарамастан, ол әлі ерлердің киімін кимейді.
Dialogue: 0,0:11:48.35,0:11:51.07,Default,,0,0,0,,Шектеулі уақытқа шектелген және уақытша
Dialogue: 0,0:11:51.07,0:11:54.03,Default,,0,0,0,,Бұл баланың ойыны
Dialogue: 0,0:11:54.03,0:11:57.53,Default,,0,0,0,,Бұл бір күні міндетті түрде бітіретін ойын.
Dialogue: 0,0:12:01.08,0:12:03.33,Default,,0,0,0,,Созуин Одори-сан
Dialogue: 0,0:12:03.33,0:12:07.54,Default,,0,0,0,,Өткенге қарамастан, мен қазір орта мектептің екінші курс студентімін.
Dialogue: 0,0:12:07.54,0:12:11.04,Default,,0,0,0,,Иә, бұл қалыпты жағдай.
Dialogue: 0,0:12:11.04,0:12:12.34,Default,,0,0,0,,Қалыпты
Dialogue: 0,0:12:12.84,0:12:15.05,Default,,0,0,0,,Егер бұл қалыпты болса
Dialogue: 0,0:12:15.05,0:12:21.55,Default,,0,0,0,,Өйткені, Банро Йоно қаншалықты қарапайым болып көрінсе де, ол қарапайым емес.
Dialogue: 0,0:12:22.10,0:12:24.22,Default,,0,0,0,,Қарапайымнан алыс
Dialogue: 0,0:12:27.98,0:12:30.65,Default,,0,0,0,,Қазіргі студенттік кеңес төрағасының қолдауы ғана емес
Dialogue: 0,0:12:30.65,0:12:34.94,Default,,0,0,0,,Нәтиже студенттік кеңестің бұрынғы төрағасының қолдауына ие болды деп жарияланды.
Dialogue: 0,0:12:34.94,0:12:38.40,Default,,0,0,0,,Мектеп газеті болжағандай менің мақұлдау рейтингім қандай?
Dialogue: 0,0:12:38.40,0:12:41.99,Default,,0,0,0,,Бір күн ішінде бірден екінші орынға көтерілді
Dialogue: 0,0:12:42.28,0:12:44.49,Default,,0,0,0,,Бірақ бәрібір екінші орын
Dialogue: 0,0:12:44.49,0:12:47.00,Default,,0,0,0,,Мен тағы бір шешуші факторды алғым келеді.
Dialogue: 0,0:12:47.00,0:12:49.46,Default,,0,0,0,,Ол шешуші фактор бола ма?
Dialogue: 0,0:12:49.46,0:12:51.83,Default,,0,0,0,,Әлде керісінше әсер ете ме?
Dialogue: 0,0:12:51.83,0:12:53.79,Default,,0,0,0,,Артқы жел немесе қарсы жел бе?
Dialogue: 0,0:12:53.79,0:12:56.51,Default,,0,0,0,,Сабақтан кейін Фумин екеуміз бірге бардық.
Dialogue: 0,0:12:56.51,0:13:01.76,Default,,0,0,0,,Мен бастапқы үміткер Наганава мырза қабылданатын ауруханаға бет алдым.
Dialogue: 0,0:13:01.76,0:13:03.76,Default,,0,0,0,,Күте тұрыңыз, Наганава мырза.
Dialogue: 0,0:13:03.76,0:13:06.10,Default,,0,0,0,,Құқық бұзушылар мен қоқыстар сізге қонаққа келеді.
Dialogue: 0,0:13:06.10,0:13:09.02,Default,,0,0,0,,Менен көп сұрасаң, олар күлкілі дуэт.
Dialogue: 0,0:13:10.52,0:13:14.40,Default,,0,0,0,,Енді ойлап отырсам, сіз Одори-санды кездестірдіңіз бе?
Dialogue: 0,0:13:14.69,0:13:18.03,Default,,0,0,0,,Мен сізбен көшбасшылық мәселелерге байланысты бірнеше рет кездестім.
Dialogue: 0,0:13:18.03,0:13:22.66,Default,,0,0,0,,Бірақ мен оны кездестіргенше ол әлдеқашан ақталған болатын.
Dialogue: 0,0:13:22.99,0:13:26.08,Default,,0,0,0,,Адамдар: «Мен қызықсыз ересек адамға айналдым» дейді.
Dialogue: 0,0:13:26.08,0:13:27.83,Default,,0,0,0,,Жалықтыратын ересектерге арналған
Dialogue: 0,0:13:27.83,0:13:31.17,Default,,0,0,0,,Ол кезде сіз өзіңізді қызықсыз баламын деп ойлаған шығарсыз.
Dialogue: 0,0:13:31.46,0:13:36.67,Default,,0,0,0,,Енді ойлап қарасам, мектептің екінші курс оқушысы мен ересек адам болу бір бөлек...
Dialogue: 0,0:13:36.67,0:13:37.80,Default,,0,0,0,,Кем дегенде
Dialogue: 0,0:13:37.80,0:13:44.30,Default,,0,0,0,,Меніңше, бүгінгі билердің жігіттік, сымбатты жігіттік қасиеті жойылғанына күмән жоқ.
Dialogue: 0,0:13:44.72,0:13:48.64,Default,,0,0,0,,«Адасқан» бір жақты көзқарас емес пе?
Dialogue: 0,0:13:48.64,0:13:52.44,Default,,0,0,0,,Егер бұл адамнан болса, менің ойымша, бұл жаңа нәрсе.
Dialogue: 0,0:13:52.77,0:13:54.19,Default,,0,0,0,,Рэм де көмектеседі.
Dialogue: 0,0:13:54.19,0:13:57.32,Default,,0,0,0,,Сен өмір бойы қоқыс боласың.
Dialogue: 0,0:13:58.82,0:14:03.66,Default,,0,0,0,,Жаман балалар орта мектеп оқушысы болған кезде оңай түзеледі, солай ма?
Dialogue: 0,0:14:03.66,0:14:08.87,Default,,0,0,0,,«Мен де ақымақ едім» деген сияқты ақсақ сөздерді айту.
Dialogue: 0,0:14:08.87,0:14:10.95,Default,,0,0,0,,Бірақ мен...
Dialogue: 0,0:14:10.95,0:14:13.83,Default,,0,0,0,,Мен орта мектепке барамын ба, жоқ па білмеймін.
Dialogue: 0,0:14:13.83,0:14:15.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:15.08,0:14:18.50,Default,,0,0,0,,Дұрыс, Маюми, бұл Д-зака туралы.
Dialogue: 0,0:14:18.50,0:14:21.42,Default,,0,0,0,,Қауіпсіздік үшін мен түскі үзіліс кезінде мектептен жасырынып шықтым.
Dialogue: 0,0:14:21.42,0:14:23.09,Default,,0,0,0,,Мен қарап шығуға бардым.
Dialogue: 0,0:14:23.09,0:14:25.55,Default,,0,0,0,,Жоқ...қазір...
Dialogue: 0,0:14:25.55,0:14:29.72,Default,,0,0,0,,Сондықтан мен түскі үзіліс кезінде мектептен жасырынып шығып, сайтты тексеруге кеттім.
Dialogue: 0,0:14:30.10,0:14:31.98,Default,,0,0,0,,«Хякуген Генба» деп аталады.
Dialogue: 0,0:14:32.43,0:14:35.48,Default,,0,0,0,,Қараңдаршы, ол жаққа көтерілетін бір жақты көше, солай ма?
Dialogue: 0,0:14:36.23,0:14:37.48,Default,,0,0,0,,Иә...
Dialogue: 0,0:14:37.82,0:14:40.82,Default,,0,0,0,,Наганава мектептен қайтып келе жатқанда, оны басып қалса ше?
Dialogue: 0,0:14:40.82,0:14:45.53,Default,,0,0,0,,Әрине, ол жаяу жүргіншілер жолымен жоғарыдан төмен қарай бара жатты.
Dialogue: 0,0:14:45.53,0:14:50.54,Default,,0,0,0,,Төмен түсіп бара жатқан ұзын арқанның ағыс сызығы мен жоғары көтерілетін автомобильдердің ағын сызығы жаяу жүргіншілер өткелінен өткенше бірдей.
Dialogue: 0,0:14:50.54,0:14:54.04,Default,,0,0,0,,Олар бір-бірінің алдынан өтеді.
Dialogue: 0,0:14:54.04,0:14:58.50,Default,,0,0,0,,Сонымен, қарсы келе жатқан көлік толығымен көрінді, солай ма?
Dialogue: 0,0:14:58.50,0:15:01.51,Default,,0,0,0,,Бұл мен ойламаған болатынмын.
Dialogue: 0,0:15:01.51,0:15:04.76,Default,,0,0,0,,Өйткені жаяу жүргіншілер өткелі жолды кесіп өтеді.
Dialogue: 0,0:15:04.76,0:15:09.26,Default,,0,0,0,,Менің көз алдыма жол қиылысынан ұшып кеткен сәттегі көрініс қана болды.
Dialogue: 0,0:15:09.26,0:15:11.43,Default,,0,0,0,,Уақытты сәл артқа айналдырсақ
Dialogue: 0,0:15:11.43,0:15:13.89,Default,,0,0,0,,Наганава мырзаның еңіспен төмен түскендегі көзқарасы
Dialogue: 0,0:15:13.89,0:15:17.27,Default,,0,0,0,,Қарсы келе жатқан көлікпен бетпе-бет бетпе-бет келуге болатын жағдайға келіңіз.
Dialogue: 0,0:15:17.69,0:15:20.52,Default,,0,0,0,,Төбеден келе жатқан көлікті көрсеңіз
Dialogue: 0,0:15:20.52,0:15:23.44,Default,,0,0,0,,Жаяу жүргіншілер өткелінің сигналы қызыл немесе жасыл.
Dialogue: 0,0:15:23.44,0:15:26.16,Default,,0,0,0,,Әзірше тоқтаймын деп ойламайсың ба?
Dialogue: 0,0:15:26.16,0:15:27.66,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:15:27.66,0:15:29.28,Default,,0,0,0,,Жүргізуші жағынан
Dialogue: 0,0:15:29.28,0:15:33.16,Default,,0,0,0,,Бұл Наганава мырзаны ешбір кедергісіз көруге болатынын білдіреді...
Dialogue: 0,0:15:33.66,0:15:37.12,Default,,0,0,0,,Өйткені бұл D еңістігі, адамсыз және көлік аз.
Dialogue: 0,0:15:37.12,0:15:39.54,Default,,0,0,0,,Мен соғып, жүгіру оңай деп ойладым.
Dialogue: 0,0:15:39.54,0:15:43.34,Default,,0,0,0,,Сайып келгенде, сондықтан жазатайым оқиғалар аз болады.
Dialogue: 0,0:15:43.34,0:15:45.92,Default,,0,0,0,,Оны жазатайым оқиғаға ұқсату дұрыс емес.
Dialogue: 0,0:15:45.92,0:15:51.18,Default,,0,0,0,,Бұл жерді жүгіріп өтсеңіз де, сәтсіздікке ұшырау ықтималдығы жоғары деп айтуға болмайды ма?
Dialogue: 0,0:15:51.93,0:15:55.52,Default,,0,0,0,,Сонымен, қолайлы жер дегеніміз не?
Dialogue: 0,0:15:55.52,0:15:57.35,Default,,0,0,0,,Оны жазатайым оқиғаға ұқсатпаңыз
Dialogue: 0,0:15:57.35,0:15:59.94,Default,,0,0,0,,Жазатайым оқиға болды деп көрсететін орын...
Dialogue: 0,0:16:00.73,0:16:02.57,Default,,0,0,0,,Эй, Фукуяку-кун
Dialogue: 0,0:16:02.57,0:16:07.57,Default,,0,0,0,,Наганава мырза шынымен сатқын болса, сіз не істер едіңіз?
Dialogue: 0,0:16:07.57,0:16:10.70,Default,,0,0,0,,Сіз мұны ағаларыңыз бен жетекшілеріңізге айтасыз ба?
Dialogue: 0,0:16:10.70,0:16:12.33,Default,,0,0,0,,Мен сізге айта алмаймын.
Dialogue: 0,0:16:13.70,0:16:15.83,Default,,0,0,0,,Оны қабірге апарыңыз
Dialogue: 0,0:16:16.29,0:16:18.83,Default,,0,0,0,,Сен екеуміздің арамыздағы өмірлік сыр.
Dialogue: 0,0:16:19.58,0:16:21.84,Default,,0,0,0,,Сайлауда өз бетінше жеңіске жету
Dialogue: 0,0:16:26.09,0:16:28.18,Default,,0,0,0,,Қош келдіңіз?
Dialogue: 0,0:16:28.18,0:16:30.34,Default,,0,0,0,,А...рахмет?
Dialogue: 0,0:16:30.34,0:16:34.10,Default,,0,0,0,,Ол қарлы әйелге де, вице-президентке де ұқсамайтын.
Dialogue: 0,0:16:34.10,0:16:37.89,Default,,0,0,0,,Фукурой-кун әлі түсінеді.
Dialogue: 0,0:16:37.89,0:16:39.85,Default,,0,0,0,,Бұл... сен
Dialogue: 0,0:16:40.27,0:16:41.61,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:16:42.73,0:16:46.15,Default,,0,0,0,,Сіз оны В сыныбында көрдіңіз...
Dialogue: 0,0:16:46.15,0:16:47.74,Default,,0,0,0,,белгілі
Dialogue: 0,0:16:47.74,0:16:53.62,Default,,0,0,0,,Студенттер кеңесінің қызметкері ретінде ол жұмбақ крест киетін қыздардан хабардар болса, бұл таңқаларлық емес пе?
Dialogue: 0,0:16:53.62,0:16:56.37,Default,,0,0,0,,Жұлдыздарға қатты қызығатын бала...
Dialogue: 0,0:16:56.37,0:16:58.50,Default,,0,0,0,,Ол кісі киінбей тұрып-ақ танылған.
Dialogue: 0,0:16:58.50,0:17:00.87,Default,,0,0,0,,Түсіндім, сен қабілеттісің.
Dialogue: 0,0:17:00.87,0:17:02.79,Default,,0,0,0,,Менің атым Майуми Хитомиджима.
Dialogue: 0,0:17:02.79,0:17:07.92,Default,,0,0,0,,Мм, Сенпа...Төраға Сакигучи сәлем беруімді өтінді.
Dialogue: 0,0:17:07.92,0:17:09.34,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:17:09.34,0:17:14.01,Default,,0,0,0,,Демек, сен менің орныма жүгірген Хитомижима-сансың.
Dialogue: 0,0:17:14.35,0:17:15.51,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:17:18.18,0:17:20.98,Default,,0,0,0,,Жақсы, менде саған бір нәрсе бергім келді.
Dialogue: 0,0:17:21.31,0:17:24.61,Default,,0,0,0,,Мм...Мен мұны қажетсіз нәрсе деп ойладым.
Dialogue: 0,0:17:24.61,0:17:26.94,Default,,0,0,0,,Бұл пайдалы болды деп үміттенемін
Dialogue: 0,0:17:26.94,0:17:29.78,Default,,0,0,0,,Вице-президент ретінде атқарған жұмысым
Dialogue: 0,0:17:29.78,0:17:33.49,Default,,0,0,0,,Бұл мен мектеп газетінің соңғы нөмірлерінен алып тастадым...
Dialogue: 0,0:17:34.03,0:17:36.41,Default,,0,0,0,,Қаласаңыз, үйге апарыңыз.
Dialogue: 0,0:17:37.16,0:17:39.00,Default,,0,0,0,,Эй, мына жерге қара.
Dialogue: 0,0:17:39.00,0:17:41.50,Default,,0,0,0,,Менің ойымша, сіз осылай айтқаныңыз үшін келдіңіз.
Dialogue: 0,0:17:41.50,0:17:43.88,Default,,0,0,0,,Оны қар әйел деп қорқады
Dialogue: 0,0:17:43.88,0:17:47.00,Default,,0,0,0,,Маған соншалықты мейірімді екеніңізге сене алар емеспін.
Dialogue: 0,0:17:47.00,0:17:49.51,Default,,0,0,0,,Сонымен қатар, олар кооперативтік.
Dialogue: 0,0:17:49.51,0:17:52.93,Default,,0,0,0,,Фукурой-кун, бізде сенімен көп нәрсе болды.
Dialogue: 0,0:17:52.93,0:17:57.01,Default,,0,0,0,,Егер сіз сайлаумен ынтымақтасатын болсаңыз, онда уақытша бітім бар.
Dialogue: 0,0:17:57.01,0:17:57.93,Default,,0,0,0,,Ах
Dialogue: 0,0:17:57.93,0:17:59.27,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:18:01.02,0:18:04.06,Default,,0,0,0,,Мен сізден бір нәрсе сұрайын деп едім.
Dialogue: 0,0:18:04.06,0:18:08.53,Default,,0,0,0,,Маған апатқа ұшыраған уақытыңызды айта аласыз ба?
Dialogue: 0,0:18:08.53,0:18:11.78,Default,,0,0,0,,Үшінші заң: Детектив болу
Dialogue: 0,0:18:12.15,0:18:14.16,Default,,0,0,0,,Апат кезінде не болды?
Dialogue: 0,0:18:14.16,0:18:17.41,Default,,0,0,0,,Фукурой-кун, неге олай сұрайсың?
Dialogue: 0,0:18:17.41,0:18:21.12,Default,,0,0,0,,Бұл туралы алаңдамаңыз, мен барлық қатысушылардан сұрадым.
Dialogue: 0,0:18:21.12,0:18:24.54,Default,,0,0,0,,Жоқ! Әліби сұрағанда бұл қалыпты тіркес еді!
Dialogue: 0,0:18:24.88,0:18:27.17,Default,,0,0,0,,Оның уәделерінің бірі ретінде.
Dialogue: 0,0:18:27.17,0:18:31.42,Default,,0,0,0,,Мектепке бару және қайту жолын қауіпсіз ету жоспары бар.
Dialogue: 0,0:18:31.97,0:18:35.05,Default,,0,0,0,,Ең болмағанда өкінішіңізді жеңілдете аламын ба?
Dialogue: 0,0:18:35.05,0:18:38.06,Default,,0,0,0,,Студенттік кеңестің қазіргі президенті Сакигучи осылай ойлайды.
Dialogue: 0,0:18:38.39,0:18:39.43,Default,,0,0,0,,Жаман бала
Dialogue: 0,0:18:39.43,0:18:44.44,Default,,0,0,0,,Мен сені шыншыл, өтірік айта алмайтын жаман адам деп ойлайтынмын.
Dialogue: 0,0:18:44.44,0:18:46.94,Default,,0,0,0,,Мен саған енді ешқашан сенбеймін.
Dialogue: 0,0:18:46.94,0:18:48.82,Default,,0,0,0,,Айттым ғой, мен тек жұмысымды істеп жүрмін...
Dialogue: 0,0:18:48.82,0:18:52.15,Default,,0,0,0,,Бірақ мен Сакигучи-сенпайға да айттым.
Dialogue: 0,0:18:52.15,0:18:54.61,Default,,0,0,0,,Ол күндер көп есімде жоқ.
Dialogue: 0,0:18:54.61,0:18:57.57,Default,,0,0,0,,Көліктің түрін немесе нөмірді айтпай-ақ қояйық.
Dialogue: 0,0:18:57.57,0:19:03.58,Default,,0,0,0,,Сол күні үйге қайту үшін D-көлбеу әдісін неліктен шешкенімді де есіме түсіре алмаймын.
Dialogue: 0,0:19:03.58,0:19:07.58,Default,,0,0,0,,Егер мен мектепке әдеттегі маршрутыммен барсам, мұндай жағдай болмас еді...
Dialogue: 0,0:19:07.58,0:19:11.59,Default,,0,0,0,,Бұл әрқашан D көлбеуін пайдаланбайтыныңызды білдіре ме?
Dialogue: 0,0:19:11.59,0:19:14.42,Default,,0,0,0,,Иә, кейде қатты асыққанда.
Dialogue: 0,0:19:14.42,0:19:16.84,Default,,0,0,0,,Ерекше жағдайлар болмаса
Dialogue: 0,0:19:16.84,0:19:19.43,Default,,0,0,0,,Сіз қатты асықтыңыз ба?
Dialogue: 0,0:19:19.43,0:19:22.35,Default,,0,0,0,,Немесе ерекше жағдайлар бар ма?
Dialogue: 0,0:19:22.35,0:19:25.73,Default,,0,0,0,,Кез келген жағдайда, сұхбатты жалғастыра отырып,
Dialogue: 0,0:19:25.73,0:19:28.11,Default,,0,0,0,,Кем дегенде D баурайында жол-көлік оқиғасы
Dialogue: 0,0:19:28.11,0:19:33.07,Default,,0,0,0,,Киоген немесе өздігінен орындалатын спектакльдер мүмкіндігі өте төмен.
Dialogue: 0,0:19:33.07,0:19:36.36,Default,,0,0,0,,Бізде, тергеу тобында мұны мойындаудан басқа амал қалмады
Dialogue: 0,0:19:36.36,0:19:38.49,Default,,0,0,0,,Наганаваға қатысты күдіктер
Dialogue: 0,0:19:38.49,0:19:41.12,Default,,0,0,0,,Менің оны толығымен алып тастаудан басқа амалым қалмады.
Dialogue: 0,0:19:42.33,0:19:44.62,Default,,0,0,0,,Әдемі және сергітетін
Dialogue: 0,0:19:47.50,0:19:48.79,Default,,0,0,0,,Кешіріңіз, жаман жігіт.
Dialogue: 0,0:19:48.79,0:19:49.75,Default,,0,0,0,,Уәде етілгендей
Dialogue: 0,0:19:49.75,0:19:52.92,Default,,0,0,0,,Осы жанашырлық мәселесін көрге апарайық.
Dialogue: 0,0:19:52.92,0:19:54.51,Default,,0,0,0,,Бұл екеуміздің арамыздағы құпия.
Dialogue: 0,0:19:54.51,0:19:57.84,Default,,0,0,0,,Менің күдігім рас болып шықса, бұл уәде.
Dialogue: 0,0:19:57.84,0:20:01.85,Default,,0,0,0,,Көшбасшыға дұрыс есеп беріп, Нагахиромен сөйлесіңіз.
Dialogue: 0,0:20:01.85,0:20:05.14,Default,,0,0,0,,Цк, мені вице-президент толығымен орналастырды.
Dialogue: 0,0:20:06.39,0:20:08.94,Default,,0,0,0,,Егер Наганава мырза сатқын болса
Dialogue: 0,0:20:08.94,0:20:14.15,Default,,0,0,0,,Егер біз мұны анықтай алсақ, оның ұйымдастырушысын санаулы секундтарда анықтауға мүмкіндік бар еді.
Dialogue: 0,0:20:14.15,0:20:14.90,Default,,0,0,0,,Иә
Dialogue: 0,0:20:14.90,0:20:17.15,Default,,0,0,0,,Ондай ұйымдастырушы болған жоқ.
Dialogue: 0,0:20:17.65,0:20:21.78,Default,,0,0,0,,Кем дегенде, ол Наганава мырзаның артында қалмады.
Dialogue: 0,0:20:22.41,0:20:24.79,Default,,0,0,0,,Бірақ мен абайсызда болдым.
Dialogue: 0,0:20:24.79,0:20:27.58,Default,,0,0,0,,Ондай ұйымдастырушының болмағаны
Dialogue: 0,0:20:27.58,0:20:29.42,Default,,0,0,0,,Тең және бәрібір
Dialogue: 0,0:20:29.42,0:20:33.80,Default,,0,0,0,,D беткейінде қағып кеткен күдіктінің болуы мүмкіндігін жою мүмкін емес.
Dialogue: 0,0:20:33.80,0:20:35.05,Default,,0,0,0,,Басқаша айтқанда
Dialogue: 0,0:20:35.05,0:20:38.30,Default,,0,0,0,,Мен Наганава мырзаның атынан кандидат ретінде қатысамын.
Dialogue: 0,0:20:38.30,0:20:40.80,Default,,0,0,0,,Автокөліктің нысанаға түсу мүмкіндігі
Dialogue: 0,0:20:40.80,0:20:44.06,Default,,0,0,0,,Әлі де жалғасып жатқаны айтылды.
Dialogue: 0,0:20:44.35,0:20:46.81,Default,,0,0,0,,Мен мұны ұмытып кетіппін
Dialogue: 0,0:20:50.69,0:20:53.44,Default,,0,0,0,,Маған бағытталғаны анық.
Dialogue: 0,0:20:56.69,0:20:58.45,Default,,0,0,0,,Майами нөмірін растау!
Dialogue: 0,0:21:04.20,0:21:06.08,Default,,0,0,0,,Зұлымдықтың дәлелі
Dialogue: 0,0:21:07.54,0:21:11.79,Default,,0,0,0,,D беткейінде қағып кеткен қылмыскер шынымен бар ма?
Dialogue: 0,0:21:11.79,0:21:14.04,Default,,0,0,0,,Бұл түсінікті.
Dialogue: 0,0:21:14.04,0:21:16.21,Default,,0,0,0,,Бірақ дәл кім...
Dialogue: 0,0:21:16.67,0:21:19.09,Default,,0,0,0,,Бұл да... түсінікті.
Dialogue: 0,0:21:19.42,0:21:20.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:26.35,0:21:28.77,Default,,0,0,0,,Ауада қалқып жүрсем де
Dialogue: 0,0:21:28.77,0:21:32.35,Default,,0,0,0,,Мені көздеген көлікті көзбен көрдім.
