Dialogue: 0,0:01:18.48,0:01:21.06,JP（）,NTP,0000,0000,0000,,Шыңғырған қазан қозғала бастады.
Dialogue: 0,0:01:21.96,0:01:24.00,JP（）,NTP,0000,0000,0000,,Уақыт есігі ашылады
Dialogue: 0,0:01:29.76,0:01:30.63,JP（）,NTP,0000,0000,0000,,Индиго
Dialogue: 0,0:01:35.01,0:01:36.36,JP（）,NTP,0000,0000,0000,,Асаги-неечан
Dialogue: 0,0:01:36.57,0:01:38.19,JP（）,NTP,0000,0000,0000,,Егер сізде мөр жоқ болса
Dialogue: 0,0:01:38.55,0:01:40.08,JP（）,,0000,0000,0000,,Сыртқы әлемге шыға алады
Dialogue: 0,0:01:40.65,0:01:42.42,JP（）,NTP,0000,0000,0000,,Сіз бұл жерден кете аласыз.
Dialogue: 0,0:01:42.87,0:01:45.72,JP（）,NTP,0000,0000,0000,,Бірақ неге бәрің бірге бармайсыңдар?
Dialogue: 0,0:01:46.14,0:01:47.10,JP（）,NTP,0000,0000,0000,,Бұл мүмкін емес.
Dialogue: 0,0:01:47.16,0:01:49.26,JP（）,NTP,0000,0000,0000,,Біз бұл жерден шыға алмаймыз
Dialogue: 0,0:01:49.47,0:01:53.01,JP（）,NTP,0000,0000,0000,,Біз үшін алаңдамаңыз
Dialogue: 0,0:01:53.16,0:01:54.45,JP（）,NTP,0000,0000,0000,,Тез қашыңыз
Dialogue: 0,0:01:54.75,0:01:58.65,JP（）,NTP,0000,0000,0000,,Жоқ, барғым келмейді,әркімнен бөлінгім келмейді.
Dialogue: 0,0:01:58.73,0:02:00.99,JP（）,NTP,0000,0000,0000,,Жоқ,сен қашып кетесің.
Dialogue: 0,0:02:05.43,0:02:07.11,JP（）,NTP,0000,0000,0000,,Үлкен әпке
Dialogue: 0,0:02:09.87,0:02:11.64,JP（）,NTP,0000,0000,0000,,Қош бол Ай
Dialogue: 0,0:02:49.98,0:02:52.98,JP（）,NTP,0000,0000,0000,,Біреуі қашып кеткен сияқты.
Dialogue: 0,0:02:53.04,0:02:54.72,JP（）,NTP,0000,0000,0000,,Ұзақ уақыт өткен соң,...
Dialogue: 0,0:02:57.84,0:02:59.64,JP（）,NTP,0000,0000,0000,,Гора,мені қайтар.
Dialogue: 0,0:03:50.37,0:03:51.93,JP（）,NTP,0000,0000,0000,,Мен желдің иісін сеземін
Dialogue: 0,0:04:10.47,0:04:13.29,JP（）,NTP,0000,0000,0000,,Сіз байқадыңыз,жақсысыз ба?
Dialogue: 0,0:04:14.52,0:04:15.42,JP（）,NTP,0000,0000,0000,,Маржан
Dialogue: 0,0:04:15.51,0:04:17.43,JP（）,NTP,0000,0000,0000,,Мықтап ұстаңыз
Dialogue: 0,0:04:19.54,0:04:21.39,JP（）,NTP,0000,0000,0000,,Слюда осы жерден алыс
Dialogue: 0,0:04:37.14,0:04:38.01,JP（）,NTP,0000,0000,0000,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:04:41.01,0:04:42.21,JP（）,NTP,0000,0000,0000,,Мұнда өтіңіз
Dialogue: 0,0:04:45.30,0:04:46.50,JP（）,NTP,0000,0000,0000,,Құрметті Кагоме
Dialogue: 0,0:04:46.95,0:04:48.45,JP（）,NTP,0000,0000,0000,,Мироку-сама Санго-чан
Dialogue: 0,0:04:49.92,0:04:52.41,JP（）,NTP,0000,0000,0000,,Құрметті Кагоме,маған мына баланы беріңізші.
Dialogue: 0,0:04:52.47,0:04:54.93,JP（）,NTP,0000,0000,0000,,Түсіндім, Шиппо-чан,өтінемін.
Dialogue: 0,0:04:54.93,0:04:55.71,JP（）,NTP,0000,0000,0000,,Хойта
Dialogue: 0,0:04:59.04,0:04:59.58,JP（）,NTP,0000,0000,0000,,Мен… алдымен сені өлтіремін… Буга…ратти…
Dialogue: 0,0:04:59.64,0:05:00.91,JP（）,NTP,0000,0000,0000,,Жаңалықтар «Батырлар өлтіруші» туралы әңгімеге толы болды
Dialogue: 0,0:05:01.17,0:05:01.80,JP（）,NTP,0000,0000,0000,,Маржан
Dialogue: 0,0:05:01.83,0:05:02.49,JP（）,NTP,0000,0000,0000,,Маюшиі енді ғана айтылған сөздердің бір ауызын да түсінбеді.
Dialogue: 0,0:05:04.35,0:05:05.37,JP（）,NTP,0000,0000,0000,,мен шынымен құрмет сезіндім.
Dialogue: 0,0:05:11.01,0:05:11.67,JP（）,NTP,0000,0000,0000,,Құбыжық
Dialogue: 0,0:05:12.36,0:05:13.80,JP（）,NTP,0000,0000,0000,,Неліктен өлшем?
Dialogue: 0,0:05:24.60,0:05:25.98,JP（）,NTP,0000,0000,0000,,Инуяша
Dialogue: 0,0:05:31.50,0:05:33.24,JP（）,NTP,0000,0000,0000,,Инуяша ағасы
Dialogue: 0,0:05:38.25,0:05:40.02,JP（）,NTP,0000,0000,0000,,Оны жалама
Dialogue: 0,0:06:10.29,0:06:11.07,JP（）,NTP,0000,0000,0000,,Тасбақа
Dialogue: 0,0:06:18.12,0:06:19.62,JP（）,NTP,0000,0000,0000,,Міне,тасбақа.
Dialogue: 0,0:06:25.50,0:06:26.46,JP（）,NTP,0000,0000,0000,,Инуяша
Dialogue: 0,0:06:26.55,0:06:27.99,JP（）,NTP,0000,0000,0000,,Инуяша ағасы
Dialogue: 0,0:06:30.99,0:06:31.68,JP（）,NTP,0000,0000,0000,,850 жылы қайта пайда болған Колоссалды Титан қабырғаны бұзып өтті,...
Dialogue: 0,0:06:39.78,0:06:40.53,JP（）,NTP,0000,0000,0000,,Ұшатын сүйектер
Dialogue: 0,0:06:42.24,0:06:43.71,JP（）,NTP,0000,0000,0000,,Жақсы емес
Dialogue: 0,0:06:45.45,0:06:46.29,JP（）,NTP,0000,0000,0000,,Кагоме-чан
Dialogue: 0,0:06:46.44,0:06:47.31,JP（）,NTP,0000,0000,0000,,Құрметті Кагоме
Dialogue: 0,0:06:50.28,0:06:54.30,JP（）,NTP,0000,0000,0000,,Мен үшін де уайымдаңызшы.
Dialogue: 0,0:06:54.31,0:06:55.20,JP（）,NTP,0000,0000,0000,,Кагоме
Dialogue: 0,0:06:57.60,0:06:58.53,JP（）,NTP,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:06:58.59,0:06:59.58,JP（）,NTP,0000,0000,0000,,Өйткені
Dialogue: 0,0:06:59.58,0:07:04.29,JP（）,NTP,0000,0000,0000,,Неге маған көмектесе алмайсың?
Dialogue: 0,0:07:04.32,0:07:07.38,JP（）,NTP,0000,0000,0000,,Ей,менің өлгім келмейді.
Dialogue: 0,0:07:08.13,0:07:09.63,JP（）,NTP,0000,0000,0000,,Мен сені тастамаймын
Dialogue: 0,0:07:09.93,0:07:12.06,JP（）,NTP,0000,0000,0000,,Бұл қорқынышты болды
Dialogue: 0,0:07:12.60,0:07:15.09,JP（）,NTP,0000,0000,0000,,Жақсы болу деген нені білдіреді?
Dialogue: 0,0:07:16.98,0:07:18.72,JP（）,NTP,0000,0000,0000,,Мен оны әлі айта алмаймын деп ойлаймын.
Dialogue: 0,0:07:19.62,0:07:20.67,JP（）,NTP,0000,0000,0000,,Солай сияқты.
Dialogue: 0,0:07:21.78,0:07:22.71,JP（）,NTP,0000,0000,0000,,Мен не істеуім керек?
Dialogue: 0,0:07:25.32,0:07:28.29,JP（）,NTP,0000,0000,0000,,Бұл жанасу кернеуді жеңілдетеді
Dialogue: 0,0:07:29.01,0:07:30.00,JP（）,NTP,0000,0000,0000,,О.
Dialogue: 0,0:07:31.77,0:07:33.66,JP（）,NTP,0000,0000,0000,,Сіз осындай уақытта не істейсіз?
Dialogue: 0,0:07:33.69,0:07:34.68,JP（）,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:07:37.50,0:07:38.88,JP（）,NTP,0000,0000,0000,,Ах~
Dialogue: 0,0:07:38.88,0:07:39.66,JP（）,NTP,0000,0000,0000,,Мастер
Dialogue: 0,0:07:40.08,0:07:40.92,JP（）,NTP,0000,0000,0000,,Майтрея
Dialogue: 0,0:07:41.16,0:07:41.97,JP（）,NTP,0000,0000,0000,,Трансформация
Dialogue: 0,0:07:46.50,0:07:49.68,JP（）,NTP,0000,0000,0000,,Көмегің үшін рахмет. Сен ақымақсың. Шиппо
Dialogue: 0,0:07:49.68,0:07:51.00,JP（）,NTP,0000,0000,0000,,Такаджа
Dialogue: 0,0:07:55.21,0:07:57.03,JP（）,,0000,0000,0000,,Вентиляциялық тесік
Dialogue: 0,0:08:00.42,0:08:01.74,JP（）,NTP,0000,0000,0000,,Жақсы емес,Мироку
Dialogue: 0,0:08:01.80,0:08:03.54,JP（）,NTP,0000,0000,0000,,Мен барлық теңіз суымен дем аламын
Dialogue: 0,0:08:05.82,0:08:06.66,JP（）,NTP,0000,0000,0000,,Лорд Хоуши
Dialogue: 0,0:08:06.69,0:08:07.83,JP（）,NTP,0000,0000,0000,,Мироку Санго шегініп бара жатыр
Dialogue: 0,0:08:08.58,0:08:11.22,JP（）,NTP,0000,0000,0000,,Жел жарақаты
Dialogue: 0,0:08:17.64,0:08:19.59,JP（）,NTP,0000,0000,0000,,өтіңіз,бұл оған тұрарлық емес.
Dialogue: 0,0:08:19.89,0:08:21.24,JP（）,NTP,0000,0000,0000,,Әлі жоқ,Инуяша.
Dialogue: 0,0:08:21.27,0:08:22.08,JP（）,NTP,0000,0000,0000,,Келесі шайқас!
Dialogue: 0,0:08:23.04,0:08:26.28,JP（）,NTP,0000,0000,0000,,Ол мен ойлағаннан да қатал.
Dialogue: 0,0:08:27.21,0:08:30.54,JP（）,NTP,0000,0000,0000,,Оның денесі неге қатты? Оның кемшіліктері бар ма?
Dialogue: 0,0:08:36.90,0:08:38.01,JP（）,NTP,0000,0000,0000,,Сәлем Инуяша
Dialogue: 0,0:08:38.43,0:08:39.72,JP（）,NTP,0000,0000,0000,,Қайталап көріңіз
Dialogue: 0,0:08:40.02,0:08:40.50,JP（）,NTP,0000,0000,0000,,О.
Dialogue: 0,0:08:46.02,0:08:47.52,JP（）,NTP,0000,0000,0000,,Уууууууу!!
Dialogue: 0,0:08:58.98,0:09:03.45,JP（）,NTP,0000,0000,0000,,Жел жарасын жеу
Dialogue: 0,0:09:26.64,0:09:28.89,JP（）,NTP,0000,0000,0000,,Гора жеңілді.
Dialogue: 0,0:09:30.60,0:09:33.99,JP（）,NTP,0000,0000,0000,,Менің сүйкімді ініме қамқор болайық.
Dialogue: 0,0:09:34.50,0:09:37.08,JP（）,NTP,0000,0000,0000,,Мені Инуяша,әлгі жарты жын деп атама.
Dialogue: 0,0:09:37.50,0:09:39.95,JP（）,NTP,0000,0000,0000,,Мен не істеуім керек,Рюраның ағасы?
Dialogue: 0,0:09:40.95,0:09:45.45,JP（）,NTP,0000,0000,0000,,Бұл жолы аралдан кетуіме жол берме
Dialogue: 0,0:09:52.71,0:09:56.60,JP（）,NTP,0000,0000,0000,,Сәлем Инуяша Кагоме
Dialogue: 0,0:09:57.30,0:09:58.47,JP（）,NTP,0000,0000,0000,,Барлығы қауіпсіз бе?
Dialogue: 0,0:09:58.98,0:10:01.26,JP（）,NTP,0000,0000,0000,,Эй Инуяша,ол бала кім?
Dialogue: 0,0:10:03.09,0:10:07.02,JP（）,NTP,0000,0000,0000,,А,мен де сенің жүзіңді алғаш көргенде таң қалдым.
Dialogue: 0,0:10:07.77,0:10:09.48,JP（）,NTP,0000,0000,0000,,Инуяша ағасы
Dialogue: 0,0:10:09.51,0:10:11.45,JP（）,NTP,0000,0000,0000,,Олардың сәйкес келгеніне 50 жыл болды.
Dialogue: 0,0:10:11.55,0:10:11.88,JP（）,NTP,0000,0000,0000,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,...
Dialogue: 0,0:10:15.96,0:10:18.03,JP（）,NTP,0000,0000,0000,,Ах… Аман-есен екеніңе қатты қуаныштымын.
Dialogue: 0,0:10:18.03,0:10:18.66,JP（）,NTP,0000,0000,0000,,Бұл бала
Dialogue: 0,0:10:18.84,0:10:20.73,JP（）,NTP,0000,0000,0000,,Ой,анау бала?
Dialogue: 0,0:10:20.85,0:10:22.56,JP（）,NTP,0000,0000,0000,,That's a half-demon.
Dialogue: 0,0:10:22.74,0:10:24.09,JP（）,NTP,0000,0000,0000,,Олай ма еді?
Dialogue: 0,0:10:26.43,0:10:27.96,JP（）,NTP,0000,0000,0000,,Байланбаңыз
Dialogue: 0,0:10:28.53,0:10:30.30,JP（）,NTP,0000,0000,0000,,Inuyasha brother
Dialogue: 0,0:10:32.07,0:10:34.77,JP（）,NTP,0000,0000,0000,,Please help everyone.
Dialogue: 0,0:10:48.36,0:10:49.32,JP（）,NTP,0000,0000,0000,,Yes,Ai-chan
Dialogue: 0,0:10:56.40,0:10:58.53,JP（）,NTP,0000,0000,0000,,Дәмді Рахмет
Dialogue: 0,0:11:01.65,0:11:04.36,JP（）,NTP,0000,0000,0000,,Сонда сен қайдан қаштың?
Dialogue: 0,0:11:05.01,0:11:08.01,JP（）,NTP,0000,0000,0000,,Хурай аралы Осы теңіздің арғы жағындағы арал
Dialogue: 0,0:11:09.60,0:11:12.55,JP（）,NTP,0000,0000,0000,,Мен оны аспаннан көрдім,бірақ арал бар ма екен?
Dialogue: 0,0:11:12.84,0:11:14.53,JP（）,NTP,0000,0000,0000,,Өйткені тұман
Dialogue: 0,0:11:14.61,0:11:19.23,JP（）,NTP,0000,0000,0000,,Хорай аралы аңызға айналған арал.
Dialogue: 0,0:11:19.32,0:11:19.77,JP（）,NTP,0000,0000,0000,,Тұра аласың ба,Армин?
Dialogue: 0,0:11:22.64,0:11:26.61,JP（）,NTP,0000,0000,0000,,Бұл бірнеше онжылдықтарда бір рет тұманда пайда болатын арал.
Dialogue: 0,0:11:29.55,0:11:33.06,JP（）,NTP,0000,0000,0000,,Бұл мен Кикиоға мөрленгенге дейін болды.
Dialogue: 0,0:11:36.00,0:11:38.31,JP（）,NTP,0000,0000,0000,,Кіреберіс қайсысы? Боқ.
Dialogue: 0,0:11:41.56,0:11:44.30,JP（）,NTP,0000,0000,0000,,It's this fog. Асыққанның жөні жоқ.
Dialogue: 0,0:11:47.43,0:11:47.88,JP（）,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:11:49.71,0:11:50.22,JP（）,NTP,0000,0000,0000,,Island?
Dialogue: 0,0:12:03.36,0:12:03.90,JP（）,NTP,0000,0000,0000,,А?
Dialogue: 0,0:12:05.61,0:12:09.43,JP（）,NTP,0000,0000,0000,,Сол кішкентай жігіт сияқты жартылай жын балалар болды.
Dialogue: 0,0:12:10.77,0:12:12.08,JP（）,NTP,0000,0000,0000,,According to them
Dialogue: 0,0:12:12.53,0:12:14.28,JP（）,NTP,0000,0000,0000,,Өздерін Төрт жауынгерлік құдай деп атайтын құбыжықтармен бірге.
Dialogue: 0,0:12:14.96,0:12:17.35,JP（）,,0000,0000,0000,,Балалар көптен бері бақылауда болған сияқты.
Dialogue: 0,0:12:18.93,0:12:20.04,JP（）,NTP,0000,0000,0000,,Не болды?
Dialogue: 0,0:12:20.28,0:12:21.60,JP（）,NTP,0000,0000,0000,,Күте тұрыңыз,Инуяша
Dialogue: 0,0:12:28.71,0:12:29.28,JP（）,NTP,0000,0000,0000,,Инуяша
Dialogue: 0,0:12:30.90,0:12:32.06,JP（）,NTP,0000,0000,0000,,Ертегіні тыңдайық.
Dialogue: 0,0:12:32.37,0:12:33.96,JP（）,NTP,0000,0000,0000,,қиын
Dialogue: 0,0:12:36.66,0:12:37.83,JP（）,NTP,0000,0000,0000,,Let's run away
Dialogue: 0,0:12:42.93,0:12:43.44,JP（）,NTP,0000,0000,0000,,Қоңырау гүлі
Dialogue: 0,0:12:43.77,0:12:44.67,JP（）,NTP,0000,0000,0000,,Инуяша
Dialogue: 0,0:12:46.59,0:12:48.27,JP（）,NTP,0000,0000,0000,,Сангкон темір тырнақ
Dialogue: 0,0:13:00.87,0:13:02.52,JP（）,NTP,0000,0000,0000,,Ұшатын жүздің қан тырнағы
Dialogue: 0,0:13:07.17,0:13:09.39,JP（）,NTP,0000,0000,0000,,Менің қаным
Dialogue: 0,0:13:12.57,0:13:13.89,JP（）,NTP,0000,0000,0000,,Bellflower
Dialogue: 0,0:13:28.55,0:13:30.03,JP（）,NTP,0000,0000,0000,,Бұл кім?
Dialogue: 0,0:13:30.33,0:13:31.53,JP（）,NTP,0000,0000,0000,,Жартылай жын Фузейга
Dialogue: 0,0:13:33.09,0:13:34.26,JP（）,NTP,0000,0000,0000,,Оған қарсы шықпаңыз.
Dialogue: 0,0:13:38.04,0:13:38.79,JP（）,NTP,0000,0000,0000,,Инуяша
Dialogue: 0,0:13:39.96,0:13:40.56,JP（）,NTP,0000,0000,0000,,Сендердің міндетің не,көпшілік?
Dialogue: 0,0:13:41.61,0:13:43.26,JP（）,NTP,0000,0000,0000,,Сен
Dialogue: 0,0:13:44.34,0:13:49.38,JP（）,NTP,0000,0000,0000,,Бір күні сіздің өміріңізді біздің Төрт күресуші Құдайымыз алады.
Dialogue: 0,0:13:52.05,0:13:53.58,JP（）,NTP,0000,0000,0000,,Өзіңді тым биік ұстама
Dialogue: 0,0:13:56.91,0:13:57.57,JP（）,NTP,0000,0000,0000,,Инуяша
Dialogue: 0,0:13:57.66,0:13:59.43,JP（）,NTP,0000,0000,0000,,Сағындыңыз ба?
Dialogue: 0,0:14:01.65,0:14:03.18,JP（）,NTP,0000,0000,0000,,Амансың ба? Kikyo
Dialogue: 0,0:14:03.63,0:14:05.16,JP（）,NTP,0000,0000,0000,,А,мен сақамды түсірдім.
Dialogue: 0,0:14:06.21,0:14:07.50,JP（）,NTP,0000,0000,0000,,Inuyasha Island
Dialogue: 0,0:14:10.62,0:14:11.64,JP（）,NTP,0000,0000,0000,,Біз Әйел Титан сияқты көрінетін біреуді байқадық.
Dialogue: 0,0:14:14.67,0:14:16.41,JP（）,NTP,0000,0000,0000,,Жоғалған нәрсеге көмектесе алмаймын.
Dialogue: 0,0:14:18.03,0:14:19.53,JP（）,NTP,0000,0000,0000,,Ауылға қайттық
Dialogue: 0,0:14:21.66,0:14:24.10,JP（）,NTP,0000,0000,0000,,Бұл Хорай аралы,ол туралы кейінірек аңызда естиміз.
Dialogue: 0,0:14:24.10,0:14:26.28,JP（）,,0000,0000,0000,,Мен Кикиодан оның не айтқанын сұрадым.
Dialogue: 0,0:14:32.28,0:14:34.89,JP（）,NTP,0000,0000,0000,,Бірде Цинь Шихуан өлместікке ұмтылды
Dialogue: 0,0:14:34.92,0:14:37.92,JP（）,NTP,0000,0000,0000,,Мен сізді Хорай аралын іздеп жүргеніңізді естідім.
Dialogue: 0,0:14:38.70,0:14:40.92,JP（）,NTP,0000,0000,0000,,Неліктен индиго 50 жыл бұрын өзгерген жоқ
Dialogue: 0,0:14:41.28,0:14:42.71,JP（）,,0000,0000,0000,,Олай деуге себеп болған болуы керек.
Dialogue: 0,0:14:43.71,0:14:45.75,JP（）,NTP,0000,0000,0000,,Үлкен аға,үлкен әпке
Dialogue: 0,0:14:51.18,0:14:51.85,JP（）,NTP,0000,0000,0000,,Inuyasha
Dialogue: 0,0:14:52.02,0:14:52.86,JP（）,NTP,0000,0000,0000,,Не болды?
Dialogue: 0,0:14:57.66,0:14:58.71,JP（）,NTP,0000,0000,0000,,Кез келген нәрсе.
Dialogue: 0,0:14:58.86,0:15:01.35,JP（）,NTP,0000,0000,0000,,Арқаңызды ауырттыңыз ба? Көрейін.
Dialogue: 0,0:15:01.47,0:15:03.78,JP（）,NTP,0000,0000,0000,,Мен оның шулы екеніне сенімдімін.
Dialogue: 0,0:15:04.08,0:15:06.36,JP（）,NTP,0000,0000,0000,,Бұл ештеңе емес,көрсетіңізші.
Dialogue: 0,0:15:05.44,0:15:07.60,NOTE（）,NTP,0000,0000,0000,,Бұл,егер сіз сондай қатты дыбыс шығарсаңыз
Dialogue: 0,0:15:07.67,0:15:09.32,NOTE（）,,0000,0000,0000,,Ай Чан оянады.
Dialogue: 0,0:15:07.26,0:15:08.85,JP（）,NTP,0000,0000,0000,,Маған кездейсоқ тиіспе
Dialogue: 0,0:15:11.20,0:15:11.73,JP（）,NTP,0000,0000,0000,,Отыру
Dialogue: 0,0:15:17.04,0:15:19.86,JP（）,NTP,0000,0000,0000,,Бұл соғысушы төрт құдайдың мөрі ме?
Dialogue: 0,0:15:19.98,0:15:22.23,JP（）,NTP,0000,0000,0000,,Есіңізде болсын
Dialogue: 0,0:15:36.99,0:15:40.26,JP（）,NTP,0000,0000,0000,,Мен желдің иісін сеземін деп ойладым,бірақ солай шығар.
Dialogue: 0,0:15:45.18,0:15:46.69,JP（）,NTP,0000,0000,0000,,Бұл Хорай аралы,солай ма?
Dialogue: 0,0:15:47.34,0:15:49.93,JP（）,NTP,0000,0000,0000,,Не,балалар ұйықтамадыңдар ма?
Dialogue: 0,0:15:50.45,0:15:52.21,JP（）,NTP,0000,0000,0000,,Сонымен Инуяша не істеу керек?
Dialogue: 0,0:15:52.71,0:15:54.46,JP（）,,0000,0000,0000,,Балаларға көмектесуге барасың ба?
Dialogue: 0,0:15:54.63,0:15:57.18,JP（）,NTP,0000,0000,0000,,бұл менің ниетім емес.
Dialogue: 0,0:15:57.87,0:16:01.23,JP（）,NTP,0000,0000,0000,,Бірақ арқамдағы тыртық үшін мен саған біржолата өтемін.
Dialogue: 0,0:16:02.76,0:16:03.48,JP（）,NTP,0000,0000,0000,,Бұл шешілді.
Dialogue: 0,0:16:10.32,0:16:12.60,JP（）,NTP,0000,0000,0000,,Бұл арал. Сіз аралды көре аласыз.
Dialogue: 0,0:16:16.02,0:16:20.00,JP（）,NTP,0000,0000,0000,,А,бұл 50 жыл бұрын болды.
Dialogue: 0,0:16:20.07,0:16:24.89,JP（）,,0000,0000,0000,,Онигасима жындармен бірге пайда болды.
Dialogue: 0,0:16:25.38,0:16:28.03,JP（）,NTP,0000,0000,0000,,Бұл қорқынышты.
Dialogue: 0,0:16:28.60,0:16:33.57,JP（）,,0000,0000,0000,,Есімде дұрыс болса,Онигасима 50 жыл бұрын пайда болған.
Dialogue: 0,0:16:34.04,0:16:38.91,JP（）,NTP,0000,0000,0000,,Ауылдың көптеген тұрғындарын келген жындар өлтірді.
Dialogue: 0,0:16:40.20,0:16:44.22,JP（）,NTP,0000,0000,0000,,Жындар әйелдер мен балаларға мейірімділік танытпайды.
Dialogue: 0,0:16:45.33,0:16:47.68,JP（）,NTP,0000,0000,0000,,Қайда қашсаң да солай.
Dialogue: 0,0:16:48.63,0:16:51.57,JP（）,NTP,0000,0000,0000,,Ол жындардан қашып құтыла алмайсың.
Dialogue: 0,0:16:53.22,0:16:54.12,JP（）,NTP,0000,0000,0000,,Бұл мереке болды
Dialogue: 0,0:16:54.24,0:16:56.01,JP（）,NTP,0000,0000,0000,,Қасиетті қыз,мен қайда баруым керек?
Dialogue: 0,0:16:56.61,0:16:57.57,JP（）,NTP,0000,0000,0000,,Аяқтаймыз.
Dialogue: 0,0:16:58.26,0:16:58.89,JP（）,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:17:11.32,0:17:13.28,JP（）,NTP,0000,0000,0000,,Тұздың иісі тамағымды ауыртады.
Dialogue: 0,0:17:16.98,0:17:18.03,JP（）,NTP,0000,0000,0000,,Лорд Сесшомару
Dialogue: 0,0:17:18.28,0:17:20.71,JP（）,,0000,0000,0000,,Осылай жүре берсек,мұхитқа түсеміз.
Dialogue: 0,0:17:21.36,0:17:26.40,JP（）,NTP,0000,0000,0000,,О,олар мүлде тыңдамайды.
Dialogue: 0,0:17:26.91,0:17:27.92,JP（）,NTP,0000,0000,0000,,Жаман көзқарас
Dialogue: 0,0:17:28.25,0:17:31.00,JP（）,,0000,0000,0000,,Жай ғана Сесшомару-саманың соңынан еріңіз,сонда бәрі жақсы болады.
Dialogue: 0,0:17:31.32,0:17:33.45,JP（）,NTP,0000,0000,0000,,Ei Noisy Бұл қажетсіз қиындық.
Dialogue: 0,0:17:33.78,0:17:35.07,JP（）,NTP,0000,0000,0000,,Маған айтпасаң да
Dialogue: 0,0:17:35.10,0:17:37.17,JP（）,,0000,0000,0000,,Лорд Сесшомару туралы сөз болғанда мен ең жақсымын.
Dialogue: 0,0:17:37.17,0:17:38.64,JP（）,NTP,0000,0000,0000,,Ау,ауырып тұр.
Dialogue: 0,0:17:39.15,0:17:41.10,JP（）,NTP,0000,0000,0000,,Мені кешіріңіз,лорд Сесшомару.
Dialogue: 0,0:17:41.43,0:17:44.28,JP（）,NTP,0000,0000,0000,,Сузуменің ақымақтық айтқан қателігі
Dialogue: 0,0:17:44.34,0:17:45.36,JP（）,NTP,0000,0000,0000,,Ол пайда болды ма?
Dialogue: 0,0:17:45.84,0:17:46.22,JP（）,NTP,0000,0000,0000,,Тұра аласың ба,Армин?
Dialogue: 0,0:17:47.28,0:17:50.10,JP（）,NTP,0000,0000,0000,,Не пайда болды? Лорд Сесшомару
Dialogue: 0,0:17:57.99,0:17:59.28,JP（）,NTP,0000,0000,0000,,Енді сіз оны көре аласыз.
Dialogue: 0,0:18:00.81,0:18:02.04,JP（）,NTP,0000,0000,0000,,Бұл Хорай аралы
Dialogue: 0,0:18:02.55,0:18:05.82,JP（）,NTP,0000,0000,0000,,Маған қызық, бұл не,бұл арал қорқынышты.
Dialogue: 0,0:18:07.17,0:18:08.01,JP（）,NTP,0000,0000,0000,,Сақтығыңызды төмендетпеңіз
Dialogue: 0,0:18:11.55,0:18:14.40,JP（）,NTP,0000,0000,0000,,Хехе келді
Dialogue: 0,0:18:14.61,0:18:18.57,JP（）,NTP,0000,0000,0000,,Мен сенен жартылай жын баланы мейірімділікпен түсіреді деп күтпедім.
Dialogue: 0,0:18:18.72,0:18:20.40,JP（）,NTP,0000,0000,0000,,Құдайға шүкір
Dialogue: 0,0:18:20.71,0:18:25.41,JP（）,NTP,0000,0000,0000,,Юра Үйреніп алайық.
Dialogue: 0,0:18:26.61,0:18:28.32,JP（）,NTP,0000,0000,0000,,Хех жақсы
Dialogue: 0,0:18:29.10,0:18:32.82,JP（）,NTP,0000,0000,0000,,Жарайды, аға,мен басқа қонақ боламын.
Dialogue: 0,0:18:47.16,0:18:52.77,JP（）,NTP,0000,0000,0000,,Көмектес, рақым ет,ашуымды бас.
Dialogue: 0,0:18:52.83,0:18:57.36,JP（）,NTP,0000,0000,0000,,Хахахаха~ Мен Төрт күресуші құдаймын,Кюра.
Dialogue: 0,0:19:01.34,0:19:04.67,JP（）,NTP,0000,0000,0000,,Бұл киелі ұрыс алаңы
Dialogue: 0,0:19:05.99,0:19:10.02,JP（）,NTP,0000,0000,0000,,Сондықтан сіз беймазасыз.
Dialogue: 0,0:19:21.48,0:19:23.00,JP（）,NTP,0000,0000,0000,,Күйікті құс
Dialogue: 0,0:19:52.63,0:19:53.82,JP（）,NTP,0000,0000,0000,,Бұл жерде.
Dialogue: 0,0:19:56.00,0:19:59.14,JP（）,NTP,0000,0000,0000,,Мен бұл сәтті көптен күттім.
Dialogue: 0,0:19:59.34,0:20:01.00,JP（）,NTP,0000,0000,0000,,Lord Sesshomaru
Dialogue: 0,0:20:16.25,0:20:20.85,JP（）,NTP,0000,0000,0000,,Хехе,жеп қой!
Dialogue: 0,0:20:22.22,0:20:22.97,JP（）,NTP,0000,0000,0000,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:20:25.33,0:20:29.49,JP（）,NTP,0000,0000,0000,,Яхахахаха мынау
Dialogue: 0,0:20:32.41,0:20:34.19,JP（）,NTP,0000,0000,0000,,Жоғары слюда
Dialogue: 0,0:20:39.67,0:20:42.60,JP（）,NTP,0000,0000,0000,,Хаха,мен оны жіберіп алмаймын.
Dialogue: 0,0:20:43.01,0:20:44.74,JP（）,NTP,0000,0000,0000,,Қалқымай оған жақындай алмайсың.
Dialogue: 0,0:20:45.02,0:20:46.53,JP（）,NTP,0000,0000,0000,,Мен сені Инуяшадан және басқалардан ажыратамын.
Dialogue: 0,0:20:55.55,0:20:56.19,JP（）,NTP,0000,0000,0000,,Сендердің міндетің не,көпшілік?
Dialogue: 0,0:20:56.45,0:20:56.84,JP（）,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:20:57.48,0:20:58.60,JP（）,NTP,0000,0000,0000,,Біраз уақыт өтті.
Dialogue: 0,0:21:01.88,0:21:04.52,JP（）,NTP,0000,0000,0000,,ке
Dialogue: 0,0:21:04.90,0:21:07.80,JP（）,NTP,0000,0000,0000,,Мен сенің осында қайтатыныңды білдім.
Dialogue: 0,0:21:08.65,0:21:10.77,JP（）,,0000,0000,0000,,Бұл жолы қашып кетуге жол бермеймін
Dialogue: 0,0:21:12.76,0:21:15.86,JP（）,NTP,0000,0000,0000,,Егер солай болса,неге бізді жылы қарсы алмасқа?
Dialogue: 0,0:21:22.61,0:21:26.13,JP（）,NTP,0000,0000,0000,,Бұл жақсы қылыш,солай емес пе? Бұл сіз үшін босқа.
Dialogue: 0,0:21:32.07,0:21:35.46,JP（）,NTP,0000,0000,0000,,Бірақ мен Қазе Бәки мен Райбакидің жауы емеспін.
Dialogue: 0,0:21:36.03,0:21:36.62,JP（）,NTP,0000,0000,0000,,Инуяша
Dialogue: 0,0:21:37.04,0:21:38.07,JP（）,NTP,0000,0000,0000,,Рэм де көмектеседі.
Dialogue: 0,0:21:38.77,0:21:39.57,JP（）,NTP,0000,0000,0000,,Алыс болайық
Dialogue: 0,0:21:40.53,0:21:42.02,JP（）,NTP,0000,0000,0000,,Жел жарақаты
Dialogue: 0,0:21:42.77,0:21:44.95,JP（）,NTP,0000,0000,0000,,Жер айдаһары Фугакуре
Dialogue: 0,0:21:47.71,0:21:48.20,JP（）,NTP,0000,0000,0000,,Дұрыс,қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:21:48.95,0:21:51.54,JP（）,NTP,0000,0000,0000,,Хмм,бұл деңгейге таң қалмаңыз.
Dialogue: 0,0:22:02.03,0:22:03.89,JP（）,NTP,0000,0000,0000,,Сіз мұндай көріністің қаупін пайдаланғыңыз келе ме?
Dialogue: 0,0:22:06.40,0:22:07.85,JP（）,NTP,0000,0000,0000,,Тенрюу Джинрай
Dialogue: 0,0:22:23.20,0:22:24.39,JP（）,NTP,0000,0000,0000,,Инуяша
Dialogue: 0,0:22:30.68,0:22:33.93,JP（）,NTP,0000,0000,0000,,Қауіпте, қауіп төнгенде,бұл жойылатын жебе ме?
Dialogue: 0,0:22:34.76,0:22:36.16,JP（）,NTP,0000,0000,0000,,Мен басқасын шығарамын.
Dialogue: 0,0:22:36.16,0:22:37.42,JP（）,NTP,0000,0000,0000,,Шегінейік,Кагоме.
Dialogue: 0,0:22:38.97,0:22:41.48,JP（）,NTP,0000,0000,0000,,Мен бұл жігітті жеңемін.
Dialogue: 0,0:22:44.09,0:22:46.65,JP（）,NTP,0000,0000,0000,,Тоқта,қашып жүрген жоқсың ба?
Dialogue: 0,0:22:48.46,0:22:51.36,JP（）,NTP,0000,0000,0000,,Эй,бұл мен ойлағаннан да қызықсыз.
Dialogue: 0,0:22:51.90,0:22:54.46,JP（）,NTP,0000,0000,0000,,Мен сәл қиынырақ болар деп ойладым.
Dialogue: 0,0:22:54.85,0:22:58.52,JP（）,NTP,0000,0000,0000,,Ұйқыда сөйлеме. Қайтып кел.
Dialogue: 0,0:23:03.43,0:23:04.20,JP（）,NTP,0000,0000,0000,,Өзіңді тым биік ұстама
Dialogue: 0,0:23:04.33,0:23:04.90,JP（）,NTP,0000,0000,0000,,Инуяша
Dialogue: 0,0:23:06.22,0:23:07.49,JP（）,NTP,0000,0000,0000,,Жарайды Инуяша
Dialogue: 0,0:23:09.22,0:23:09.92,JP（）,NTP,0000,0000,0000,,Инуяша
Dialogue: 0,0:23:11.08,0:23:12.09,JP（）,NTP,0000,0000,0000,,Кагоме-чан
Dialogue: 0,0:23:13.59,0:23:15.02,JP（）,NTP,0000,0000,0000,,Екеуің де аман болдыңдар.
Dialogue: 0,0:23:15.77,0:23:17.92,JP（）,NTP,0000,0000,0000,,Жарайды,мен оны сілкіп алдым.
Dialogue: 0,0:23:18.32,0:23:20.53,JP（）,,0000,0000,0000,,Бұл жігіттер біраз қиындық туғызады.
Dialogue: 0,0:23:26.23,0:23:27.05,JP（）,NTP,0000,0000,0000,,Қызыл зұлым жанкүйер
Dialogue: 0,0:23:33.54,0:23:34.42,JP（）,NTP,0000,0000,0000,,Хмм,сізге қалай ұнады?
Dialogue: 0,0:23:49.78,0:23:51.35,JP（）,NTP,0000,0000,0000,,Лорд Сесшомару күткендей
Dialogue: 0,0:24:06.38,0:24:07.43,JP（）,NTP,0000,0000,0000,,Сурюха
Dialogue: 0,0:24:20.43,0:24:21.62,JP（）,NTP,0000,0000,0000,,​​Керемет жұмыс!
Dialogue: 0,0:24:22.37,0:24:25.01,JP（）,NTP,0000,0000,0000,,Енді кездесіп,Хорай аралын көрейік.
Dialogue: 0,0:24:26.54,0:24:28.04,JP（）,NTP,0000,0000,0000,,Бос сөз айту
Dialogue: 0,0:24:29.02,0:24:31.34,JP（）,NTP,0000,0000,0000,,Сіздің таңдауыңыз жоқ.
Dialogue: 0,0:24:32.71,0:24:36.05,JP（）,NTP,0000,0000,0000,,Бізде Күресуші төрт құдайдың мөрі болғанша.
Dialogue: 0,0:24:51.48,0:24:52.96,JP（）,NTP,0000,0000,0000,,Лорд Сесшомару
Dialogue: 0,0:25:02.50,0:25:04.46,JP（）,NTP,0000,0000,0000,,Бұл ұят болды.
Dialogue: 0,0:25:04.60,0:25:06.14,JP（）,,0000,0000,0000,,Бір қадам қалды
Dialogue: 0,0:25:06.14,0:25:07.95,JP（）,,0000,0000,0000,,Бір нәрсені жіберіп алу нені білдіреді?
Dialogue: 0,0:25:08.05,0:25:08.78,JP（）,NTP,0000,0000,0000,,Аяя
Dialogue: 0,0:25:09.34,0:25:10.25,JP（）,,0000,0000,0000,,Мен Сесшомару-саманы күтпедім.
Dialogue: 0,0:25:10.32,0:25:13.35,JP（）,,0000,0000,0000,,Сіз мұндай қателік жібере алмайсыз.
Dialogue: 0,0:25:14.33,0:25:15.39,JP（）,NTP,0000,0000,0000,,Түсіндім
Dialogue: 0,0:25:15.46,0:25:17.75,JP（）,,0000,0000,0000,,Енді көңіл көтеруді кейінге қалдыру
Dialogue: 0,0:25:17.78,0:25:19.57,JP（）,,0000,0000,0000,,Мен оны әдейі өткізіп алдым.
Dialogue: 0,0:25:22.86,0:25:24.23,JP（）,NTP,0000,0000,0000,,Лорд Сесшомару
Dialogue: 0,0:25:27.31,0:25:28.18,JP（）,NTP,0000,0000,0000,,Лорд Сесшомару
Dialogue: 0,0:25:33.59,0:25:36.85,JP（）,NTP,0000,0000,0000,,Мен бір кездері әкеңе қызмет ете алдым.
Dialogue: 0,0:25:37.44,0:25:38.40,JP（）,,0000,0000,0000,,Менің атым Коуя.
Dialogue: 0,0:25:39.50,0:25:40.93,JP（）,NTP,0000,0000,0000,,Цитян қаласында орналасқан
Dialogue: 0,0:25:42.12,0:25:43.67,JP（）,NTP,0000,0000,0000,,Әкесі қайтыс болды
Dialogue: 0,0:25:44.66,0:25:45.48,JP（）,NTP,0000,0000,0000,,(Екі рет) Қорықпа. Іштегілердің бәрі де ауырып жатыр.
Dialogue: 0,0:25:46.67,0:25:48.66,JP（）,NTP,0000,0000,0000,,Олай болса енді артымнан ерме
Dialogue: 0,0:25:49.59,0:25:50.42,JP（）,NTP,0000,0000,0000,,Мен ешкімге оның мағынасыз өлім болғанын айтуға жол бермеймін
Dialogue: 0,0:25:50.94,0:25:55.18,JP（）,,0000,0000,0000,,Біз енді Хорай аралындағы төрт шайқас құдайды жоюға барамыз.
Dialogue: 0,0:25:55.69,0:25:57.68,JP（）,NTP,0000,0000,0000,,Бұл сенің әкеңнің санасы.
Dialogue: 0,0:26:00.81,0:26:01.95,JP（）,NTP,0000,0000,0000,,Қызық емес
Dialogue: 0,0:26:02.39,0:26:03.27,JP（）,NTP,0000,0000,0000,,Лорд Сесшомару
Dialogue: 0,0:26:03.37,0:26:04.25,JP（）,NTP,0000,0000,0000,,Лорд Сесшомару
Dialogue: 0,0:26:09.47,0:26:10.77,JP（）,NTP,0000,0000,0000,,Аня Форджер
Dialogue: 0,0:26:15.31,0:26:17.05,JP（）,NTP,0000,0000,0000,,Лорд Сесшомару өкінеді
Dialogue: 0,0:26:18.44,0:26:20.07,JP（）,NTP,0000,0000,0000,,Сөзбен де емес
Dialogue: 0,0:26:21.57,0:26:24.34,JP（）,NTP,0000,0000,0000,,Мына олжаны ала кетейін.
Dialogue: 0,0:26:29.58,0:26:31.60,JP（）,NTP,0000,0000,0000,,Қалғандары бар ма?
Dialogue: 0,0:26:34.99,0:26:40.00,JP（）,NTP,0000,0000,0000,,Сонымен,сіз Лорд Сесшомарусыз.
Dialogue: 0,0:26:40.34,0:26:43.34,JP（）,NTP,0000,0000,0000,,Сіз өзіңізді Құдай дейсіз бе?
Dialogue: 0,0:26:43.60,0:26:44.65,JP（）,NTP,0000,0000,0000,,Шынында да
Dialogue: 0,0:26:45.67,0:26:46.52,JP（）,NTP,0000,0000,0000,,Күлуді тоқтатыңыз
Dialogue: 0,0:26:59.34,0:27:03.42,JP（）,NTP,0000,0000,0000,,Сенің әкең мұндай адамға не дер еді?
Dialogue: 0,0:27:03.84,0:27:06.81,JP（）,NTP,0000,0000,0000,,Түсіндім,сен мықтысың.
Dialogue: 0,0:27:08.08,0:27:11.49,JP（）,NTP,0000,0000,0000,,Бірақ Алланың құдіретін төмендетпеген абзал.
Dialogue: 0,0:27:15.03,0:27:19.04,JP（）,NTP,0000,0000,0000,,Енді менен қашып құтыла алмайсың.
Dialogue: 0,0:27:35.89,0:27:37.52,JP（）,NTP,0000,0000,0000,,Әй,сол Сесшомару-сама.
Dialogue: 0,0:27:37.98,0:27:41.29,JP（）,NTP,0000,0000,0000,,Сіз қашып кеткен нәрсені жеңуге әлі келе жатырсыз ба?
Dialogue: 0,0:27:42.51,0:27:44.29,JP（）,NTP,0000,0000,0000,,Келесі шайқас!
Dialogue: 0,0:27:44.55,0:27:47.37,JP（）,NTP,0000,0000,0000,,Дұрыс,Сузу.
Dialogue: 0,0:27:47.63,0:27:50.03,JP（）,,0000,0000,0000,,Сіз кенеттен не айтып тұрсыз?
Dialogue: 0,0:27:50.29,0:27:52.33,JP（）,NTP,0000,0000,0000,,Мен ештеңе айтқан жоқпын.
Dialogue: 0,0:28:04.97,0:28:08.28,JP（）,NTP,0000,0000,0000,,Осылай өтуге болмайды ма?
Dialogue: 0,0:28:29.50,0:28:30.62,JP（）,NTP,0000,0000,0000,,Міне осылай
Dialogue: 0,0:29:15.36,0:29:16.03,JP（）,NTP,0000,0000,0000,,Бұл индиго.
Dialogue: 0,0:29:16.81,0:29:18.07,JP（）,NTP,0000,0000,0000,,Ай қайтып келді
Dialogue: 0,0:29:18.96,0:29:20.30,JP（）,NTP,0000,0000,0000,,Инуяша да солай.
Dialogue: 0,0:29:20.84,0:29:21.93,JP（）,NTP,0000,0000,0000,,Мен қайтып келдім
Dialogue: 0,0:29:33.72,0:29:35.71,JP（）,NTP,0000,0000,0000,,Уау,мен мұншама көп отты бірінші рет көріп тұрмын.
Dialogue: 0,0:29:37.65,0:29:40.36,JP（）,NTP,0000,0000,0000,,Оттықтар әдемі,бірақ олар ұшқыр.
Dialogue: 0,0:29:44.00,0:29:56.70,JP（）,NTP,0000,0000,0000,,Әкем айтты,Алақаным – қорғаным.
Dialogue: 0,0:29:57.58,0:30:11.01,JP（）,NTP,0000,0000,0000,,Анам айтты,Адамның қолы – тәрбиеге.
Dialogue: 0,0:30:12.26,0:30:19.88,JP（）,NTP,0000,0000,0000,,Put your hands together,open the door
Dialogue: 0,0:30:20.17,0:30:28.03,JP（）,NTP,0000,0000,0000,,Мен сені қызыл лотоста қайтарамын
Dialogue: 0,0:30:29.97,0:30:52.64,JP（）,NTP,0000,0000,0000,,Жарық болыңыз,балаларыңызды қорғаңыз.
Dialogue: 0,0:30:56.70,0:30:57.70,JP（）,NTP,0000,0000,0000,,Үлкен әпке
Dialogue: 0,0:31:00.29,0:31:02.18,JP（）,NTP,0000,0000,0000,,Үлкен апа,үлкен аға
Dialogue: 0,0:31:02.18,0:31:02.72,JP（）,NTP,0000,0000,0000,,Индиго
Dialogue: 0,0:31:03.31,0:31:03.73,JP（）,NTP,0000,0000,0000,,Индиго
Dialogue: 0,0:31:06.65,0:31:08.30,JP（）,NTP,0000,0000,0000,,Үлкен әпке
Dialogue: 0,0:31:10.74,0:31:12.67,JP（）,NTP,0000,0000,0000,,Идиот,сен неге қайтып келдің?
Dialogue: 0,0:31:13.16,0:31:13.91,JP（）,NTP,0000,0000,0000,,Өйткені
Dialogue: 0,0:31:14.43,0:31:16.03,JP（）,NTP,0000,0000,0000,,Кішкентай жігітті кінәламаңыз
Dialogue: 0,0:31:18.57,0:31:20.01,JP（）,NTP,0000,0000,0000,,Ah Inuyasha-san
Dialogue: 0,0:31:20.63,0:31:23.06,JP（）,NTP,0000,0000,0000,,Төрт соғысушы құдайды бірге жеңемін.
Dialogue: 0,0:31:23.55,0:31:26.03,JP（）,NTP,0000,0000,0000,,Жасыл күресетін төрт құдайды жеңу
Dialogue: 0,0:31:26.53,0:31:28.67,JP（）,NTP,0000,0000,0000,,Сіз мұны 50 жыл бұрын айттыңыз.
Dialogue: 0,0:31:28.82,0:31:31.67,JP（）,,0000,0000,0000,,Қашып кеткен бір әлжуаз болды. Апельсин
Dialogue: 0,0:31:32.19,0:31:33.25,JP（）,NTP,0000,0000,0000,,О,жүр.
Dialogue: 0,0:31:36.05,0:31:39.74,JP（）,NTP,0000,0000,0000,,Remember,Inuyasha is narrow-minded.
Dialogue: 0,0:31:40.07,0:31:41.55,JP（）,,0000,0000,0000,,Балаларға да мейірімділік жоқ
Dialogue: 0,0:31:41.60,0:31:42.27,JP（）,NTP,0000,0000,0000,,Темеемона
Dialogue: 0,0:31:43.10,0:31:45.35,JP（）,NTP,0000,0000,0000,,Шион,сен не жасырып тұрсың?
Dialogue: 0,0:31:45.81,0:31:47.62,JP（）,NTP,0000,0000,0000,,Мен жақында кетемін
Dialogue: 0,0:31:48.11,0:31:50.02,JP（）,,0000,0000,0000,,Ер баладай мықты бол
Dialogue: 0,0:31:50.39,0:31:52.09,JP（）,NTP,0000,0000,0000,,Бірақ әпке,мүмкін
Dialogue: 0,0:31:52.71,0:31:55.61,JP（）,NTP,0000,0000,0000,,Инуяша мырза,Айды осы аралдан алып кетіңізші.
Dialogue: 0,0:31:56.38,0:31:59.38,JP（）,NTP,0000,0000,0000,,Тек Ай ғана Төрт күресуші құдайдың мөрін әлі алған жоқ.
Dialogue: 0,0:31:59.46,0:32:00.21,JP（）,,0000,0000,0000,,Сіз кете аласыз
Dialogue: 0,0:32:00.68,0:32:03.22,JP（）,NTP,0000,0000,0000,,Белгі,мүмкін
Dialogue: 0,0:32:03.70,0:32:04.45,JP（）,NTP,0000,0000,0000,,Эмилияның фракциясы мен Куруштың фракциясы арасындағы тең шарттардағы одақ.
Dialogue: 0,0:32:07.27,0:32:08.69,JP（）,NTP,0000,0000,0000,,Мөр болғанша
Dialogue: 0,0:32:09.23,0:32:12.23,JP（）,,0000,0000,0000,,Біз бұл аралдан кете алмаймыз
Dialogue: 0,0:32:12.77,0:32:14.14,JP（）,NTP,0000,0000,0000,,Моэги дұрыс айтады.
Dialogue: 0,0:32:15.00,0:32:17.17,JP（）,NTP,0000,0000,0000,,Сонда Инуяша да шыға алмайды.
Dialogue: 0,0:32:17.48,0:32:17.89,JP（）,NTP,0000,0000,0000,,Тұра аласың ба,Армин?
Dialogue: 0,0:32:18.69,0:32:21.59,JP（）,NTP,0000,0000,0000,,Инуяшаның арқасында дәл осындай тыртық бар.
Dialogue: 0,0:32:22.18,0:32:22.98,JP（）,NTP,0000,0000,0000,,Жақсы емес
Dialogue: 0,0:32:23.32,0:32:24.74,JP（）,NTP,0000,0000,0000,,Мен саған көмектесуге келген жоқпын.
Dialogue: 0,0:32:25.05,0:32:27.12,JP（）,,0000,0000,0000,,Сізді гравюра шақырды деп ойлаймын.
Dialogue: 0,0:32:27.56,0:32:28.28,JP（）,NTP,0000,0000,0000,,Иә…♡
Dialogue: 0,0:32:28.34,0:32:28.77,NOTE（）,NTP,0000,0000,0000,,өлтіру
Dialogue: 0,0:32:28.54,0:32:29.08,JP（）,NTP,0000,0000,0000,,Барыңыз
Dialogue: 0,0:32:29.55,0:32:32.34,JP（）,NTP,0000,0000,0000,,Олай болса,Айды шығарып жібересің бе?
Dialogue: 0,0:32:32.70,0:32:36.63,JP（）,NTP,0000,0000,0000,,Толығырақ айтып бере аласыз ба?
Dialogue: 0,0:32:37.31,0:32:38.83,JP（）,NTP,0000,0000,0000,,Асаги-неечан.
Dialogue: 0,0:32:41.00,0:32:41.67,JP（）,NTP,0000,0000,0000,,Асаги-чан
Dialogue: 0,0:32:45.34,0:32:48.37,JP（）,NTP,0000,0000,0000,,Бұл аралда бөгет бар сияқты.
Dialogue: 0,0:32:48.94,0:32:51.02,JP（）,NTP,0000,0000,0000,,Сондықтан бұл балалар қашып құтыла алмайды.
Dialogue: 0,0:32:51.45,0:32:52.64,JP（）,NTP,0000,0000,0000,,Содан кейін Инуяша
Dialogue: 0,0:32:53.00,0:32:55.28,JP（）,,0000,0000,0000,,Біріншіден,біз сол тосқауылдың көзін жоюымыз керек.
Dialogue: 0,0:32:56.69,0:32:58.53,JP（）,NTP,0000,0000,0000,,Бұл мүмкін емес.
Dialogue: 0,0:32:59.41,0:33:01.45,JP（）,NTP,0000,0000,0000,,Бірақ егер Инуяша-оний-чан
Dialogue: 0,0:33:01.50,0:33:02.67,JP（）,NTP,0000,0000,0000,,Аузыңды жабу керек.
Dialogue: 0,0:33:03.04,0:33:05.30,JP（）,NTP,0000,0000,0000,,Егер сіз қажетсіз нәрсе жасап,Төрт күресуші құдайдың ашуын келтірсеңіз
Dialogue: 0,0:33:05.59,0:33:07.27,JP（）,,0000,0000,0000,,Сен де өлтіресің.
Dialogue: 0,0:33:21.35,0:33:22.70,JP（）,NTP,0000,0000,0000,,Асаги-неечан
Dialogue: 0,0:33:25.13,0:33:27.14,JP（）,NTP,0000,0000,0000,,Гүрілдеген қазан шақырып тұр.
Dialogue: 0,0:33:28.12,0:33:29.32,JP（）,NTP,0000,0000,0000,,Гүрілдеген қазан
Dialogue: 0,0:33:30.63,0:33:31.49,JP（）,NTP,0000,0000,0000,,Менің қазір кетуім керек
Dialogue: 0,0:33:32.00,0:33:33.20,JP（）,NTP,0000,0000,0000,,Барасыз ба? Қайда?
Dialogue: 0,0:33:33.68,0:33:35.29,JP（）,NTP,0000,0000,0000,,Бұл сіздің шаруаңыз емес.
Dialogue: 0,0:33:35.73,0:33:36.89,JP（）,,0000,0000,0000,,Мені жалғыз қалдырыңызшы.
Dialogue: 0,0:33:37.43,0:33:38.18,JP（）,NTP,0000,0000,0000,,Олар әжептәуір алысқа қашып кеткен болар...
Dialogue: 0,0:33:38.73,0:33:42.06,JP（）,NTP,0000,0000,0000,,Барроу, сен бала болсаң да,сәнді болма.
Dialogue: 0,0:33:42.42,0:33:43.74,JP（）,NTP,0000,0000,0000,,Инуяша отыр
Dialogue: 0,0:33:45.03,0:33:46.69,JP（）,NTP,0000,0000,0000,,Қызға не істейсің?
Dialogue: 0,0:33:46.79,0:33:48.21,JP（）,NTP,0000,0000,0000,,Цуцуэй
Dialogue: 0,0:33:53.07,0:33:54.86,JP（）,NTP,0000,0000,0000,,Асаги-неечан күтіңіз
Dialogue: 0,0:33:55.42,0:33:58.09,JP（）,NTP,0000,0000,0000,,Мұнда не болып жатыр?
Dialogue: 0,0:33:58.55,0:33:59.56,JP（）,NTP,0000,0000,0000,,Біз де барайық
Dialogue: 0,0:34:00.80,0:34:01.76,JP（）,NTP,0000,0000,0000,,Кеттік,Шиппо-чан.
Dialogue: 0,0:34:02.59,0:34:03.18,JP（）,NTP,0000,0000,0000,,О.
Dialogue: 0,0:34:04.86,0:34:08.43,JP（）,NTP,0000,0000,0000,,О, күте тұр,мені артта қалдырма.
Dialogue: 0,0:34:16.21,0:34:19.23,JP（）,NTP,0000,0000,0000,,Бұл аралда басқа ешкім тұра ма?
Dialogue: 0,0:34:19.70,0:34:20.97,JP（）,NTP,0000,0000,0000,,Бұл біз ғана
Dialogue: 0,0:34:21.38,0:34:23.21,JP（）,NTP,0000,0000,0000,,Бұрын олар көп болатын.
Dialogue: 0,0:34:23.46,0:34:25.10,JP（）,,0000,0000,0000,,Өйткені бәрі өлді.
Dialogue: 0,0:34:26.52,0:34:28.46,JP（）,NTP,0000,0000,0000,,Алдыңғы өлең мұңды өлең.
Dialogue: 0,0:34:29.10,0:34:30.10,JP（）,,0000,0000,0000,,Сіз не айтасыз?
Dialogue: 0,0:34:30.61,0:34:32.21,JP（）,NTP,0000,0000,0000,,Бұл қоштасу әні
Dialogue: 0,0:34:32.60,0:34:35.83,JP（）,,0000,0000,0000,,Канаде бұл бастапқыда жоқтау әні екенін айтты.
Dialogue: 0,0:34:36.24,0:34:37.02,JP（）,NTP,0000,0000,0000,,Канаде-сама?
Dialogue: 0,0:34:37.41,0:34:38.95,JP（）,NTP,0000,0000,0000,,Ғибадатхананың ғибадатхана қызы
Dialogue: 0,0:34:39.58,0:34:42.06,JP（）,NTP,0000,0000,0000,,Ол нағыз сұлу әйел болуы керек.
Dialogue: 0,0:34:44.72,0:34:46.40,JP（）,NTP,0000,0000,0000,,Канаде енді жоқ.
Dialogue: 0,0:34:46.99,0:34:49.22,JP（）,NTP,0000,0000,0000,,Төрт соғысушы құдаймен шайқаста қаза тапты
Dialogue: 0,0:34:49.65,0:34:53.23,JP（）,NTP,0000,0000,0000,,Енді соғысушы төрт құдайға құрбандық шалу.
Dialogue: 0,0:34:53.36,0:34:55.50,JP（）,NTP,0000,0000,0000,,Шион,қажетсіз ештеңе айтпа.
Dialogue: 0,0:34:59.28,0:35:01.46,JP（）,NTP,0000,0000,0000,,Құрбан шалу бейбіт емес,солай ма?
Dialogue: 0,0:35:01.83,0:35:03.54,JP（）,NTP,0000,0000,0000,,Сен шынымен өлгің келе ме?
Dialogue: 0,0:35:08.92,0:35:09.69,JP（）,NTP,0000,0000,0000,,Асаги-чан
Dialogue: 0,0:35:20.76,0:35:21.45,JP（）,NTP,0000,0000,0000,,Асаги-чан?
Dialogue: 0,0:35:23.47,0:35:26.60,JP（）,NTP,0000,0000,0000,,Бұдан былай мен отқа айналамын.
Dialogue: 0,0:35:27.43,0:35:28.07,JP（）,NTP,0000,0000,0000,,Өрт сөндірушілер?
Dialogue: 0,0:35:28.72,0:35:33.53,JP（）,NTP,0000,0000,0000,,Бұл от шашулар – шырылдаған қазанға секіріп,өлген ауыл адамдарының бәрі.
Dialogue: 0,0:35:34.31,0:35:36.29,JP（）,NTP,0000,0000,0000,,Біздің әкеміз бен анамыз
Dialogue: 0,0:35:36.50,0:35:38.49,JP（）,,0000,0000,0000,,Аға немесе әпке деп аударылады.
Dialogue: 0,0:35:39.76,0:35:42.99,JP（）,NTP,0000,0000,0000,,Барлығы отқа айналып,бізге қарап тұрды.
Dialogue: 0,0:35:43.82,0:35:45.79,JP（）,NTP,0000,0000,0000,,Демек,біз жалғыз емеспіз
Dialogue: 0,0:35:47.77,0:35:50.25,JP（）,NTP,0000,0000,0000,,Мен де осы балаларды қорғау үшін отқа айналамын.
Dialogue: 0,0:35:51.03,0:35:54.03,JP（）,NTP,0000,0000,0000,,Сондықтан маған кедергі жасамаңыз.
Dialogue: 0,0:35:55.63,0:35:56.40,JP（）,NTP,0000,0000,0000,,Асаги-чан
Dialogue: 0,0:35:57.59,0:35:59.61,JP（）,NTP,0000,0000,0000,,Маған ұнамайды.
Dialogue: 0,0:36:11.60,0:36:13.88,JP（）,NTP,0000,0000,0000,,Қоңыраулы қазан бастапқыда болған
Dialogue: 0,0:36:14.27,0:36:18.53,JP（）,,0000,0000,0000,,Мұнда тұратын йокайларды,адамдарды және олардың ұрпақтары жартылай йокайларды қорғаңыз.
Dialogue: 0,0:36:18.71,0:36:20.47,JP（）,NTP,0000,0000,0000,,Оны киелі деп атаған.
Dialogue: 0,0:36:21.17,0:36:24.01,JP（）,NTP,0000,0000,0000,,Бірақ Төрт күресуші құдай оны ластады.
Dialogue: 0,0:36:24.96,0:36:27.94,JP（）,NTP,0000,0000,0000,,Төрт соғысушы құдай лас қазанды пайдаланады.
Dialogue: 0,0:36:28.46,0:36:30.76,JP（）,NTP,0000,0000,0000,,Біздің жартылай жын күшімізді шығару
Dialogue: 0,0:36:31.33,0:36:32.98,JP（）,,0000,0000,0000,,Менің қолымда сиқырлы күштер бар.
Dialogue: 0,0:36:33.78,0:36:35.70,JP（）,NTP,0000,0000,0000,,Көптеген адамдар қазірдің өзінде құрбан болды.
Dialogue: 0,0:36:36.50,0:36:40.01,JP（）,NTP,0000,0000,0000,,50 жылда бір рет,арал сыртқы әлеммен байланысқан кезде
Dialogue: 0,0:36:40.22,0:36:41.62,JP（）,,0000,0000,0000,,Қазан құрбандыққа шақырады.
Dialogue: 0,0:36:43.45,0:36:46.48,JP（）,NTP,0000,0000,0000,,Асаги-неечаннан кейінгі келесісі мен немесе Апельсин болады.
Dialogue: 0,0:36:52.19,0:36:53.25,JP（）,NTP,0000,0000,0000,,Күн ыстық,солай емес пе?
Dialogue: 0,0:36:53.90,0:36:56.02,JP（）,NTP,0000,0000,0000,,Мен әдеттен тыс жаман сезімді сезінемін.
Dialogue: 0,0:37:10.62,0:37:12.12,JP（）,NTP,0000,0000,0000,,Бұл «Гүрілдеген қазан» ба?
Dialogue: 0,0:37:12.74,0:37:15.07,JP（）,NTP,0000,0000,0000,,Бұл, әрине,өте жағымсыз.
Dialogue: 0,0:37:15.27,0:37:17.73,JP（）,NTP,0000,0000,0000,,Ал... бұл жай ғана үлкен.
Dialogue: 0,0:37:18.53,0:37:21.63,JP（）,NTP,0000,0000,0000,,Бәріңе сау болыңдар
Dialogue: 0,0:37:22.23,0:37:23.52,JP（）,NTP,0000,0000,0000,,Тату-тәтті өмір сүрейік
Dialogue: 0,0:37:23.83,0:37:26.42,JP（）,NTP,0000,0000,0000,,Асаги-неечан, жүр,жоқ!
Dialogue: 0,0:37:28.66,0:37:31.56,JP（）,NTP,0000,0000,0000,,Өйткені мен отқа айналамын және бәрін бақылаймын.
Dialogue: 0,0:37:32.23,0:37:33.45,JP（）,NTP,0000,0000,0000,,Мұны істеудің қажеті жоқ
Dialogue: 0,0:37:33.68,0:37:35.39,JP（）,,0000,0000,0000,,Бұл жерден шығудың жолы болуы керек.
Dialogue: 0,0:37:35.62,0:37:36.70,JP（）,NTP,0000,0000,0000,,Барлығымыз ойланып көрейік
Dialogue: 0,0:37:37.45,0:37:39.60,JP（）,NTP,0000,0000,0000,,Құбыжықты құртқыңыз келсе,мен сізге көмектесемін.
Dialogue: 0,0:37:39.88,0:37:42.03,JP（）,NTP,0000,0000,0000,,Асаги-неечан,өтінемін.
Dialogue: 0,0:37:43.84,0:37:46.17,JP（）,NTP,0000,0000,0000,,Төрт құдайдың қаншалықты қорқынышты екенін бәрі түсінбейді.
Dialogue: 0,0:37:47.17,0:37:47.74,JP（）,NTP,0000,0000,0000,,Бірақ
Dialogue: 0,0:37:48.52,0:37:49.81,JP（）,NTP,0000,0000,0000,,Егер ол құрбандыққа айналса
Dialogue: 0,0:37:50.20,0:37:52.47,JP（）,NTP,0000,0000,0000,,Қалған балалар біраз уақыт өмір сүре алады.
Dialogue: 0,0:37:53.43,0:37:56.07,JP（）,NTP,0000,0000,0000,,Бұл күресетін төрт құдайға емес,барлығына арналған.
Dialogue: 0,0:38:16.18,0:38:17.47,JP（）,NTP,0000,0000,0000,,Менің артымнан ермеңіз
Dialogue: 0,0:38:17.83,0:38:19.10,JP（）,NTP,0000,0000,0000,,Бұл жұмыс істемейді.
Dialogue: 0,0:38:19.38,0:38:21.17,JP（）,NTP,0000,0000,0000,,Кедергі көзі жойылуы керек
Dialogue: 0,0:38:21.24,0:38:23.31,JP（）,,0000,0000,0000,,Мен бұл жерден кете алмаймын.
Dialogue: 0,0:38:47.51,0:38:49.01,JP（）,NTP,0000,0000,0000,,Қорықсаңыз,уайымдамаңыз.
Dialogue: 0,0:38:49.89,0:38:52.06,JP（）,NTP,0000,0000,0000,,Шығарыңыз және қажетсіз ештеңе жасамаңыз.
Dialogue: 0,0:38:53.27,0:38:55.13,JP（）,NTP,0000,0000,0000,,Жел жарақаты
Dialogue: 0,0:38:58.29,0:38:58.66,JP（）,NTP,0000,0000,0000,,Чи
Dialogue: 0,0:38:58.75,0:38:59.58,JP（）,NTP,0000,0000,0000,,Тоқта!
Dialogue: 0,0:38:59.97,0:39:02.53,JP（）,NTP,0000,0000,0000,,Мен құрбан болсам,бәрі құтқарылады.
Dialogue: 0,0:39:02.99,0:39:03.85,JP（）,NTP,0000,0000,0000,,әдепсіз
Dialogue: 0,0:39:04.36,0:39:06.28,JP（）,NTP,0000,0000,0000,,Кездейсоқ өлемін деп ойлама.
Dialogue: 0,0:39:09.17,0:39:09.87,JP（）,NTP,0000,0000,0000,,Инуяша
Dialogue: 0,0:39:09.43,0:39:10.41,JP（）,NTP,0000,0000,0000,,Асаги-неечан
Dialogue: 0,0:39:32.33,0:39:33.08,JP（）,NTP,0000,0000,0000,,Егер бұл операция сәтті өтсе,...
Dialogue: 0,0:39:33.62,0:39:35.02,JP（）,NTP,0000,0000,0000,,Біз әлі өлген жоқпыз
Dialogue: 0,0:39:35.31,0:39:36.83,JP（）,NTP,0000,0000,0000,,Берілме,ақымақ
Dialogue: 0,0:39:38.74,0:39:39.29,JP（）,NTP,0000,0000,0000,,Өзіңді тым биік ұстама
Dialogue: 0,0:40:01.36,0:40:01.72,JP（）,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:40:08.01,0:40:08.91,JP（）,NTP,0000,0000,0000,,Асаги
Dialogue: 0,0:40:09.74,0:40:11.13,JP（）,NTP,0000,0000,0000,,Берілмеңіз
Dialogue: 0,0:40:15.99,0:40:17.36,JP（）,NTP,0000,0000,0000,,Не? Бұл?
Dialogue: 0,0:40:18.17,0:40:19.20,JP（）,NTP,0000,0000,0000,,Асаги-неечан
Dialogue: 0,0:40:41.04,0:40:43.16,JP（）,NTP,0000,0000,0000,,Бұл менің өмірімді сақтап қалды.
Dialogue: 0,0:40:43.21,0:40:44.32,JP（）,NTP,0000,0000,0000,,Кира мен Жапон тергеу басқармасы арасындағы сөйлесулерге қарағанда,...
Dialogue: 0,0:40:44.78,0:40:47.28,JP（）,,0000,0000,0000,,Мұны қанша уақыт істеуіміз керек?
Dialogue: 0,0:40:47.58,0:40:49.62,JP（）,NTP,0000,0000,0000,,Бес жартылай жын бала қалды
Dialogue: 0,0:40:50.31,0:40:53.17,JP（）,NTP,0000,0000,0000,,Барлығын құрбандыққа шалмас бұрын
Dialogue: 0,0:40:53.22,0:40:55.42,JP（）,,0000,0000,0000,,Біз шынайы күшімізді қалпына келтіруіміз керек.
Dialogue: 0,0:40:56.47,0:40:59.32,JP（）,NTP,0000,0000,0000,,Сол үшін әулие қызды дайындаған жоқ па?
Dialogue: 0,0:41:02.60,0:41:04.08,JP（）,NTP,0000,0000,0000,,Асағы қазанға секірді.
Dialogue: 0,0:41:04.33,0:41:05.50,JP（）,NTP,0000,0000,0000,,Бейшара жігіт
Dialogue: 0,0:41:05.76,0:41:08.62,JP（）,NTP,0000,0000,0000,,Бірақ Асаги отшашу келмейді.
Dialogue: 0,0:41:08.81,0:41:10.28,JP（）,NTP,0000,0000,0000,,Қызық,ол әлі тірі ме?
Dialogue: 0,0:41:13.25,0:41:14.75,JP（）,NTP,0000,0000,0000,,Жоқ,қозғалма.
Dialogue: 0,0:41:15.10,0:41:17.23,JP（）,NTP,0000,0000,0000,,Инуяша мен Асаги не болады?
Dialogue: 0,0:41:18.27,0:41:19.39,JP（）,NTP,0000,0000,0000,,Екеуміз де бөлекпіз
Dialogue: 0,0:41:23.31,0:41:25.25,JP（）,NTP,0000,0000,0000,,Тоқтатайық,бұл босқа
Dialogue: 0,0:41:25.53,0:41:28.27,JP（）,NTP,0000,0000,0000,,Бұл қазаннан ештеңе шықпады.
Dialogue: 0,0:41:28.66,0:41:30.34,JP（）,NTP,0000,0000,0000,,Екеуі де өлді.
Dialogue: 0,0:41:30.52,0:41:32.02,JP（）,NTP,0000,0000,0000,,Сіз бас тарта алмайсыз,солай ма?
Dialogue: 0,0:41:32.12,0:41:33.70,JP（）,NTP,0000,0000,0000,,Жол болуы керек.
Dialogue: 0,0:41:39.67,0:41:42.70,JP（）,NTP,0000,0000,0000,,Бұл үлгінің мағынасы бар ма?
Dialogue: 0,0:41:43.37,0:41:47.22,JP（）,NTP,0000,0000,0000,,Әкем айтты,Бесіктегі қол – қорғаныш.
Dialogue: 0,0:41:47.87,0:41:51.80,JP（）,NTP,0000,0000,0000,,Анам айтты,Адамның қолы – тәрбиеге.
Dialogue: 0,0:41:53.68,0:41:54.74,JP（）,NTP,0000,0000,0000,,Алдыңғы ән.
Dialogue: 0,0:41:54.95,0:41:58.59,JP（）,NTP,0000,0000,0000,,Бұл ән есікке көне әріптермен жазылған.
Dialogue: 0,0:41:59.06,0:42:01.81,JP（）,NTP,0000,0000,0000,,Сіз қорғаныш қолдың не екенін білесіз бе?
Dialogue: 0,0:42:02.50,0:42:04.59,JP（）,NTP,0000,0000,0000,,Бұл сол қол болуы керек.
Dialogue: 0,0:42:04.64,0:42:06.48,JP（）,NTP,0000,0000,0000,,Сіз мұны білмейсіз бе?
Dialogue: 0,0:42:07.05,0:42:09.19,JP（）,NTP,0000,0000,0000,,Сонымен,қолды күту дегенді қалай түсінеміз?
Dialogue: 0,0:42:09.53,0:42:10.61,JP（）,NTP,0000,0000,0000,,Оң қол
Dialogue: 0,0:42:11.00,0:42:11.96,JP（）,NTP,0000,0000,0000,,Әннің жалғасы қандай?
Dialogue: 0,0:42:13.30,0:42:15.42,JP（）,NTP,0000,0000,0000,,Қолдарыңызды біріктіріңіз,есікті ашыңыз
Dialogue: 0,0:42:15.89,0:42:17.65,JP（）,NTP,0000,0000,0000,,Мен сені қызыл лотоста қайтарамын
Dialogue: 0,0:42:18.32,0:42:20.93,JP（）,NTP,0000,0000,0000,,Жарық болыңыз,балаларыңызды қорғаңыз.
Dialogue: 0,0:42:22.20,0:42:24.57,JP（）,NTP,0000,0000,0000,,Қолдарыңызды біріктіріңіз,есікті ашыңыз
Dialogue: 0,0:42:25.40,0:42:27.42,JP（）,NTP,0000,0000,0000,,Хоуши-сама нені білдіреді?
Dialogue: 0,0:42:29.59,0:42:32.89,JP（）,NTP,0000,0000,0000,,Егер сіз құбыжықтың сол қолы мен адамның оң қолын біріктірсеңіз,...
Dialogue: 0,0:42:32.96,0:42:33.82,JP（）,,0000,0000,0000,,Есікті ашыңыз
Dialogue: 0,0:42:43.16,0:42:44.58,JP（）,NTP,0000,0000,0000,,Бұл жақсы емес.
Dialogue: 0,0:42:44.81,0:42:46.08,JP（）,NTP,0000,0000,0000,,Үмітімді үздім.
Dialogue: 0,0:42:46.60,0:42:47.89,JP（）,NTP,0000,0000,0000,,Қолды біріктіру
Dialogue: 0,0:42:48.10,0:42:49.03,JP（）,,0000,0000,0000,,Бұл нені білдіреді?
Dialogue: 0,0:42:52.80,0:42:53.65,JP（）,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:42:54.40,0:42:55.23,JP（）,NTP,0000,0000,0000,,Адам жейтін улы жәндік
Dialogue: 0,0:43:09.53,0:43:12.53,JP（）,NTP,0000,0000,0000,,Қарғыс атқыр,менің көзім бұлдырай бастады.
Dialogue: 0,0:43:14.18,0:43:16.02,JP（）,NTP,0000,0000,0000,,Бір жерде шығатын жол жоқ па?
Dialogue: 0,0:43:16.69,0:43:19.21,JP（）,NTP,0000,0000,0000,,Мен мұнда тірідей түсуге қалай батылым бардым?
Dialogue: 0,0:43:19.89,0:43:21.46,JP（）,,0000,0000,0000,,Сен жартылай жынсың.
Dialogue: 0,0:43:22.09,0:43:24.78,JP（）,NTP,0000,0000,0000,,Неліктен оның денесі қызыл жалынға күйген жоқ?
Dialogue: 0,0:43:25.61,0:43:28.60,JP（）,NTP,0000,0000,0000,,Бұл от егеуқұйрықтың киімінен болса керек.
Dialogue: 0,0:43:28.99,0:43:30.08,JP（）,NTP,0000,0000,0000,,Тағы не бар?
Dialogue: 0,0:43:31.06,0:43:32.07,JP（）,NTP,0000,0000,0000,,Бәйбішесі – Канаде
Dialogue: 0,0:43:32.87,0:43:34.47,JP（）,NTP,0000,0000,0000,,Хорай аралының күзетші храмы
Dialogue: 0,0:43:35.43,0:43:39.57,JP（）,NTP,0000,0000,0000,,Ал,маған осы аралда не болғанын айт.
Dialogue: 0,0:43:41.50,0:43:42.72,JP（）,NTP,0000,0000,0000,,Вентиляциялық тесік
Dialogue: 0,0:43:47.24,0:43:49.78,JP（）,NTP,0000,0000,0000,,Хоуши шебері,бұл улы жәндік. Өзіңізді мәжбүрлемеңіз.
Dialogue: 0,0:43:58.57,0:44:01.28,JP（）,NTP,0000,0000,0000,,Улы жәндікке жеп,қазанға жем болу
Dialogue: 0,0:44:01.33,0:44:03.40,JP（）,,0000,0000,0000,,Қайсысы жақсы?
Dialogue: 0,0:44:03.53,0:44:06.22,JP（）,NTP,0000,0000,0000,,Сонымен қатар қару ретінде қолдануға болатын нәрсені іздейік.
Dialogue: 0,0:44:06.27,0:44:06.84,JP（）,NTP,0000,0000,0000,,Үлкен әпке
Dialogue: 0,0:44:06.89,0:44:07.59,JP（）,NTP,0000,0000,0000,,Моеги
Dialogue: 0,0:44:08.65,0:44:10.84,JP（）,NTP,0000,0000,0000,,Оған көмектесу мүмкін емес. Біз де оны іздеуіміз керек пе?
Dialogue: 0,0:44:11.27,0:44:12.01,JP（）,NTP,0000,0000,0000,,Іздеу?
Dialogue: 0,0:44:14.85,0:44:17.46,JP（）,NTP,0000,0000,0000,,Жарайды,мен түлкі сиқырына да шебермін.
Dialogue: 0,0:44:17.85,0:44:19.32,JP（）,NTP,0000,0000,0000,,Шиппо-сан бұл
Dialogue: 0,0:44:21.96,0:44:24.31,JP（）,NTP,0000,0000,0000,,Бірден кетуге рұқсат етілмегендер
Dialogue: 0,0:44:24.54,0:44:26.48,JP（）,,0000,0000,0000,,Бұл сіздің орныңыз емес
Dialogue: 0,0:44:27.62,0:44:31.01,JP（）,NTP,0000,0000,0000,,Тек жүрегі мейірімге толы жандар
Dialogue: 0,0:44:31.47,0:44:33.39,JP（）,,0000,0000,0000,,Қолына жатқызуға рұқсат
Dialogue: 0,0:44:35.27,0:44:38.68,JP（）,NTP,0000,0000,0000,,Енді, Кагоме,әннің сыры шешілді.
Dialogue: 0,0:44:41.85,0:44:43.01,JP（）,NTP,0000,0000,0000,,Баяғыдан бері
Dialogue: 0,0:44:43.41,0:44:47.69,JP（）,,0000,0000,0000,,Бұл Хорай аралы Аякаши мен адамдар бірге тұратын жұмақ болды.
Dialogue: 0,0:44:48.40,0:44:50.65,JP（）,NTP,0000,0000,0000,,Көп ұзамай көптеген жарты жын балалар дүниеге келді.
Dialogue: 0,0:44:50.98,0:44:52.60,JP（）,NTP,0000,0000,0000,,Барлығы тату-тәтті өмір сүрді.
Dialogue: 0,0:44:53.94,0:44:57.14,JP（）,NTP,0000,0000,0000,,Дегенмен,адамдар жартылай жындардан аулақ болады.
Dialogue: 0,0:44:57.46,0:44:59.02,JP（）,,0000,0000,0000,,Құбыжықтар менсінбеген
Dialogue: 0,0:44:59.88,0:45:03.00,JP（）,NTP,0000,0000,0000,,Бұл аралдан тыс жерде өмір сүру өте қиын
Dialogue: 0,0:45:04.09,0:45:07.15,JP（）,NTP,0000,0000,0000,,Бәйбіше бұл балаларды мәңгілікке қорғайды
Dialogue: 0,0:45:07.63,0:45:09.83,JP（）,NTP,0000,0000,0000,,Сыртқы әлеммен байланысын үзуге шешім қабылдады
Dialogue: 0,0:45:11.17,0:45:12.67,JP（）,NTP,0000,0000,0000,,Бірақ 50 жылда бір рет
Dialogue: 0,0:45:13.14,0:45:15.17,JP（）,,0000,0000,0000,,Уақыт кедергісі босайтын уақытты көздеу
Dialogue: 0,0:45:15.53,0:45:17.55,JP（）,,0000,0000,0000,,Йокай жиі шабуылдады
Dialogue: 0,0:45:19.13,0:45:20.67,JP（）,NTP,0000,0000,0000,,Төрт күресуші құдай да қиын
Dialogue: 0,0:45:24.22,0:45:25.84,JP（）,NTP,0000,0000,0000,,Қан көп төгілді
Dialogue: 0,0:45:28.15,0:45:32.59,JP（）,NTP,0000,0000,0000,,Бәйбішелер де төбелесті,бірақ мен олардың денелерін билік доптарына айырбастадым.
Dialogue: 0,0:45:32.78,0:45:35.03,JP（）,,0000,0000,0000,,Менің қолымнан келгені оны осы қазанға жабу болды.
Dialogue: 0,0:45:36.97,0:45:40.22,JP（）,NTP,0000,0000,0000,,Бірақ олар жартылай жынды қазанға тірідей салғанда,...
Dialogue: 0,0:45:40.54,0:45:43.42,JP（）,,0000,0000,0000,,Мен күш-қуатымның біраз бөлігін қайтара алатынымды түсіндім.
Dialogue: 0,0:45:44.03,0:45:45.47,JP（）,NTP,0000,0000,0000,,Неліктен жартылай жын?
Dialogue: 0,0:45:46.08,0:45:51.15,JP（）,NTP,0000,0000,0000,,Бастапқыда адамдардың рухани күші мен құбыжықтардың сиқырлы күші бір-бірін тойтарады.
Dialogue: 0,0:45:51.75,0:45:54.67,JP（）,NTP,0000,0000,0000,,Бірақ жартылай жынның ішінде олар бірігіп кетеді.
Dialogue: 0,0:45:55.33,0:45:57.55,JP（）,NTP,0000,0000,0000,,Екі түрлі күштің бірігуі
Dialogue: 0,0:45:57.73,0:46:00.04,JP（）,,0000,0000,0000,,Бұл қазанды қозғайтын күш.
Dialogue: 0,0:46:00.65,0:46:01.81,JP（）,NTP,0000,0000,0000,,Сейно
Dialogue: 0,0:46:05.50,0:46:06.33,JP（）,NTP,0000,0000,0000,,Сендердің міндетің не,көпшілік?
Dialogue: 0,0:46:06.79,0:46:08.23,JP（）,NTP,0000,0000,0000,,Бұл дұрыс емес
Dialogue: 0,0:46:08.56,0:46:09.75,JP（）,NTP,0000,0000,0000,,Мен сендерді жек көремін
Dialogue: 0,0:46:26.70,0:46:28.65,JP（）,NTP,0000,0000,0000,,Жарайды,Шиппо-чан.
Dialogue: 0,0:46:30.05,0:46:30.94,JP（）,NTP,0000,0000,0000,,Бұл да
Dialogue: 0,0:46:32.19,0:46:35.07,JP（）,NTP,0000,0000,0000,,1 2 3
Dialogue: 0,0:46:48.05,0:46:48.90,JP（）,NTP,0000,0000,0000,,Мен мұны істедім
Dialogue: 0,0:46:53.44,0:46:55.43,JP（）,NTP,0000,0000,0000,,Неліктен бұл жарық?
Dialogue: 0,0:46:56.34,0:46:59.60,JP（）,NTP,0000,0000,0000,,Бұл жарық шын мәнінде есіктің ашылуы болды ма?
Dialogue: 0,0:47:00.23,0:47:02.03,JP（）,NTP,0000,0000,0000,,Міне,шығу.
Dialogue: 0,0:47:05.64,0:47:07.71,JP（）,NTP,0000,0000,0000,,Билікті қазан алып кетер еді.
Dialogue: 0,0:47:08.56,0:47:11.46,JP（）,NTP,0000,0000,0000,,Жақсы,менің өмірім қысқа.
Dialogue: 0,0:47:11.92,0:47:13.07,JP（）,,0000,0000,0000,,Мен оны саған беремін
Dialogue: 0,0:47:14.07,0:47:16.83,JP（）,NTP,0000,0000,0000,,Керісінше мына балаларды құтқаруларыңызды қалаймын.
Dialogue: 0,0:47:17.79,0:47:20.60,JP（）,NTP,0000,0000,0000,,Балаларға не болатыны өз еркі.
Dialogue: 0,0:47:21.33,0:47:23.79,JP（）,,0000,0000,0000,,Маған бар болғаны Төрт күресуші құдайды жеңу керек
Dialogue: 0,0:47:24.48,0:47:26.79,JP（）,NTP,0000,0000,0000,,Жақсы,мен сұрадым.
Dialogue: 0,0:47:38.87,0:47:41.24,JP（）,NTP,0000,0000,0000,,Асаги,мен сені қазір бұл жерден алып кетемін.
Dialogue: 0,0:47:42.05,0:47:43.89,JP（）,NTP,0000,0000,0000,,Менің өмір сүргенім дұрыс па?
Dialogue: 0,0:47:44.24,0:47:46.61,JP（）,NTP,0000,0000,0000,,Адамдардан бірінен соң бірін сұрама.
Dialogue: 0,0:47:47.14,0:47:47.83,JP（）,NTP,0000,0000,0000,,Күтіңіз
Dialogue: 0,0:47:49.74,0:47:50.61,JP（）,NTP,0000,0000,0000,,Канаде-сама
Dialogue: 0,0:47:54.26,0:47:56.16,JP（）,NTP,0000,0000,0000,,Неліктен тоқтау керек?
Dialogue: 0,0:47:56.99,0:47:58.61,JP（）,NTP,0000,0000,0000,,Мүмкін сізде сиқырлы күш жетіспейтін шығар?
Dialogue: 0,0:47:59.16,0:48:00.01,JP（）,NTP,0000,0000,0000,,Бұл кішкентай
Dialogue: 0,0:48:01.03,0:48:01.70,JP（）,NTP,0000,0000,0000,,Қалай болғанда да, Рейнэр,...
Dialogue: 0,0:48:04.09,0:48:05.24,JP（）,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:48:05.97,0:48:07.17,JP（）,NTP,0000,0000,0000,,Нефриттен жасалған қорап
Dialogue: 0,0:48:08.08,0:48:10.19,JP（）,NTP,0000,0000,0000,,Төрт шайқас құдайының құдіретінің шарын бекітіңіз
Dialogue: 0,0:48:10.49,0:48:12.54,JP（）,NTP,0000,0000,0000,,Осы уақытқа дейін күң нені қорғады
Dialogue: 0,0:48:13.31,0:48:14.67,JP（）,NTP,0000,0000,0000,,Ешқашан ашпаңыз
Dialogue: 0,0:48:15.56,0:48:18.32,JP（）,NTP,0000,0000,0000,,Ашылған кезде соңғы доп Төрт күресуші құдайға оралады.
Dialogue: 0,0:48:18.70,0:48:20.71,JP（）,NTP,0000,0000,0000,,Оны енді ешкім ерте жеңе алмайды.
Dialogue: 0,0:48:21.18,0:48:23.75,JP（）,NTP,0000,0000,0000,,Менің ойымша,біз қорапты түгел жоюымыз керек.
Dialogue: 0,0:48:24.60,0:48:26.18,JP（）,NTP,0000,0000,0000,,Кагоме,сен мені естисің бе?
Dialogue: 0,0:48:28.73,0:48:30.22,JP（）,NTP,0000,0000,0000,,Инуяша,сен тірісің бе?
Dialogue: 0,0:48:31.19,0:48:32.14,JP（）,NTP,0000,0000,0000,,Асаги-чан бұл
Dialogue: 0,0:48:32.96,0:48:34.01,JP（）,NTP,0000,0000,0000,,Біз біргеміз
Dialogue: 0,0:48:34.60,0:48:36.18,JP（）,NTP,0000,0000,0000,,Мен қазір есікті бұзғалы жатырмын.
Dialogue: 0,0:48:36.97,0:48:38.59,JP（）,NTP,0000,0000,0000,,Алдыңғы жақтан аулақ болыңыз
Dialogue: 0,0:48:40.01,0:48:40.76,JP（）,NTP,0000,0000,0000,,Түсіндім
Dialogue: 0,0:48:41.39,0:48:43.31,JP（）,NTP,0000,0000,0000,,Барлығың есіктен аулақ болыңдар.
Dialogue: 0,0:48:43.68,0:48:45.14,JP（）,NTP,0000,0000,0000,,Инуяша мен Асаги пайда болады.
Dialogue: 0,0:48:45.42,0:48:46.01,JP（）,NTP,0000,0000,0000,,Маржан
Dialogue: 0,0:48:52.58,0:48:53.35,JP（）,NTP,0000,0000,0000,,Асаги.
Dialogue: 0,0:48:53.77,0:48:57.08,JP（）,NTP,0000,0000,0000,,Кешіріңіз,күң қателескен шығар.
Dialogue: 0,0:48:58.42,0:49:00.55,JP（）,NTP,0000,0000,0000,,Бақыт тілеймін
Dialogue: 0,0:49:01.21,0:49:02.11,JP（）,NTP,0000,0000,0000,,Канаде-сама
Dialogue: 0,0:49:05.47,0:49:07.82,JP（）,NTP,0000,0000,0000,,Конго найзасы
Dialogue: 0,0:49:41.01,0:49:44.15,JP（）,NTP,0000,0000,0000,,Инуяша,сен шектің не екенін білмейсің бе?
Dialogue: 0,0:49:44.39,0:49:45.08,JP（）,NTP,0000,0000,0000,,Сен ақымақ
Dialogue: 0,0:49:45.87,0:49:48.51,JP（）,NTP,0000,0000,0000,,Сыртта салқын.
Dialogue: 0,0:49:53.33,0:49:53.72,JP（）,NTP,0000,0000,0000,,Хехе
Dialogue: 0,0:49:54.60,0:49:56.01,JP（）,NTP,0000,0000,0000,,Асаги-неечан
Dialogue: 0,0:49:57.06,0:49:58.46,JP（）,NTP,0000,0000,0000,,Иә барлығына
Dialogue: 0,0:49:58.50,0:49:59.25,JP（）,NTP,0000,0000,0000,,Инуяша
Dialogue: 0,0:49:59.38,0:50:00.51,JP（）,NTP,0000,0000,0000,,Асаги-ни-сан
Dialogue: 0,0:50:11.64,0:50:13.36,JP（）,NTP,0000,0000,0000,,Нефрит жәшіктердің қорабы
Dialogue: 0,0:50:13.75,0:50:16.28,JP（）,NTP,0000,0000,0000,,Қазаннан шыққан сияқты.
Dialogue: 0,0:50:17.19,0:50:19.39,JP（）,NTP,0000,0000,0000,,Неліктен сіз оны шығару үшін бар күшіңізді саласыз?
Dialogue: 0,0:50:19.50,0:50:20.96,JP（）,,0000,0000,0000,,Бұл сіз үшін мейірімді.
Dialogue: 0,0:50:21.13,0:50:25.49,JP（）,NTP,0000,0000,0000,,Хехе,енді мен өзімнің бастапқы күшімді қайтара аламын.
Dialogue: 0,0:50:26.22,0:50:27.43,JP（）,NTP,0000,0000,0000,,ашуланшақ
Dialogue: 0,0:50:27.80,0:50:30.15,JP（）,NTP,0000,0000,0000,,Алдымен қорапты алу керек.
Dialogue: 0,0:50:30.80,0:50:31.83,JP（）,NTP,0000,0000,0000,,Рахмет
Dialogue: 0,0:50:32.52,0:50:35.20,JP（）,NTP,0000,0000,0000,,Қане қыздың күшін байқап көрейік.
Dialogue: 0,0:51:13.21,0:51:15.42,JP（）,NTP,0000,0000,0000,,Сеи
Dialogue: 0,0:51:20.20,0:51:22.94,JP（）,NTP,0000,0000,0000,,Оны жоя алмайсың,солай ма?
Dialogue: 0,0:51:23.44,0:51:25.92,JP（）,NTP,0000,0000,0000,,Бастық десең де,керексіз итсің.
Dialogue: 0,0:51:26.02,0:51:27.60,JP（）,NTP,0000,0000,0000,,Темера
Dialogue: 0,0:51:30.32,0:51:33.78,JP（）,NTP,0000,0000,0000,,Бұл қораптың кедергісі өте күшті.
Dialogue: 0,0:51:35.04,0:51:37.10,JP（）,NTP,0000,0000,0000,,Егер Кагоме-сама күшті рухани күшке ие болса,...
Dialogue: 0,0:51:37.14,0:51:38.96,JP（）,,0000,0000,0000,,Менің ойымша,сіз оны аша аласыз.
Dialogue: 0,0:51:39.83,0:51:41.93,JP（）,NTP,0000,0000,0000,,Бірақ мен оны ашсам жұмыс істемейді деп ойлаймын.
Dialogue: 0,0:51:42.68,0:51:43.76,JP（）,NTP,0000,0000,0000,,Кагоменің жебесі ше?
Dialogue: 0,0:51:44.16,0:51:47.47,JP（）,NTP,0000,0000,0000,,Мен оны қайда қойдым?
Dialogue: 0,0:51:48.32,0:51:50.04,JP（）,NTP,0000,0000,0000,,Бұл емес пе?
Dialogue: 0,0:51:52.39,0:51:52.80,JP（）,NTP,0000,0000,0000,,Қалай болғанда да, Рейнэр,...
Dialogue: 0,0:51:53.99,0:51:54.76,JP（）,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:51:55.33,0:51:58.60,JP（）,NTP,0000,0000,0000,,өтіңіз. Олардың барлығы өте мәнерлі.
Dialogue: 0,0:51:58.86,0:51:59.69,JP（）,NTP,0000,0000,0000,,Мүлдем емес.
Dialogue: 0,0:52:04.31,0:52:06.70,JP（）,NTP,0000,0000,0000,,Балалар,өздерің туралы айтып беріңдерші.
Dialogue: 0,0:52:07.19,0:52:09.50,JP（）,NTP,0000,0000,0000,,Бір нәрсені айтпас бұрын біраз ойланыңыз.
Dialogue: 0,0:52:18.44,0:52:20.06,JP（）,NTP,0000,0000,0000,,Ки... Кикио
Dialogue: 0,0:52:27.79,0:52:28.33,JP（）,NTP,0000,0000,0000,,Инуяша
Dialogue: 0,0:52:29.49,0:52:30.42,JP（）,NTP,0000,0000,0000,,Бәрің жақсысыңдар ма?
Dialogue: 0,0:52:30.87,0:52:31.97,JP（）,NTP,0000,0000,0000,,Мәселе жоқ.
Dialogue: 0,0:52:32.49,0:52:34.80,JP（）,NTP,0000,0000,0000,,Тецусайганың қынасы мені қорғап қалған сияқты.
Dialogue: 0,0:52:44.80,0:52:45.73,JP（）,NTP,0000,0000,0000,,Қорап алынды
Dialogue: 0,0:52:46.19,0:52:46.92,JP（）,NTP,0000,0000,0000,,Қоңырау гүлі
Dialogue: 0,0:52:47.61,0:52:48.87,JP（）,NTP,0000,0000,0000,,Бұл шынымен Кикио ма?
Dialogue: 0,0:52:49.60,0:52:53.13,JP（）,NTP,0000,0000,0000,,Кикиодан бейіт топырағының иісі жоқ.
Dialogue: 0,0:52:54.89,0:52:55.68,JP（）,NTP,0000,0000,0000,,Инуяша
Dialogue: 0,0:52:56.21,0:52:59.17,JP（）,NTP,0000,0000,0000,,Кагоме,балаларды аралдан алып кет.
Dialogue: 0,0:53:00.93,0:53:01.78,JP（）,NTP,0000,0000,0000,,Инуяша
Dialogue: 0,0:53:04.36,0:53:06.28,JP（）,NTP,0000,0000,0000,,Бұл махаббат үшбұрышы.
Dialogue: 0,0:53:06.63,0:53:07.99,JP（）,NTP,0000,0000,0000,,Екі сырлы жігіт
Dialogue: 0,0:53:10.52,0:53:11.64,JP（）,NTP,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:53:12.26,0:53:13.56,JP（）,NTP,0000,0000,0000,,Тез барайық.
Dialogue: 0,0:53:13.93,0:53:14.64,JP（）,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:53:22.12,0:53:23.01,JP（）,NTP,0000,0000,0000,,Мен ашуландым.
Dialogue: 0,0:53:23.47,0:53:25.32,JP（）,NTP,0000,0000,0000,,Кагоме-оне-чан қорқынышты
Dialogue: 0,0:53:33.04,0:53:34.42,JP（）,NTP,0000,0000,0000,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:53:37.79,0:53:40.60,JP（）,NTP,0000,0000,0000,,Хаха,тезірек бір жерден аш!
Dialogue: 0,0:53:46.14,0:53:47.56,JP（）,NTP,0000,0000,0000,,Кикионы күтіңіз
Dialogue: 0,0:53:50.07,0:53:52.59,JP（）,NTP,0000,0000,0000,,Сіз кемпіріңізді қайтару үшін келдіңіз бе?
Dialogue: 0,0:53:53.14,0:53:54.09,JP（）,NTP,0000,0000,0000,,Темера
Dialogue: 0,0:53:58.14,0:53:59.84,JP（）,NTP,0000,0000,0000,,Кикионы ашыңыз
Dialogue: 0,0:54:00.25,0:54:03.03,JP（）,NTP,0000,0000,0000,,Тоқта,мені түсінбейсің бе?
Dialogue: 0,0:54:03.09,0:54:04.81,JP（）,NTP,0000,0000,0000,,Енді ше?
Dialogue: 0,0:54:05.67,0:54:07.10,JP（）,NTP,0000,0000,0000,,Бұл жігіт 50 жыл бұрын
Dialogue: 0,0:54:07.17,0:54:09.42,JP（）,,0000,0000,0000,,Гора Кикиодан сорған қанмен жасалған.
Dialogue: 0,0:54:09.45,0:54:10.36,JP（）,,0000,0000,0000,,Бұл көшірме.
Dialogue: 0,0:54:10.57,0:54:11.36,JP（）,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:54:12.19,0:54:13.99,JP（）,NTP,0000,0000,0000,,Сізге бұл қорапты алу жеткілікті
Dialogue: 0,0:54:14.03,0:54:16.73,JP（）,,0000,0000,0000,,Ұрланған шарларды қайтару
Dialogue: 0,0:54:17.03,0:54:18.35,JP（）,NTP,0000,0000,0000,,Қораптың кедергісі
Dialogue: 0,0:54:18.88,0:54:20.58,JP（）,NTP,0000,0000,0000,,Оны өзіміз бұза алмаймыз.
Dialogue: 0,0:54:24.29,0:54:25.87,JP（）,NTP,0000,0000,0000,,Эй,тез аш.
Dialogue: 0,0:54:26.56,0:54:27.41,JP（）,NTP,0000,0000,0000,,Тоқта
Dialogue: 0,0:54:44.30,0:54:45.98,JP（）,NTP,0000,0000,0000,,Бұл ұзақ болды
Dialogue: 0,0:55:00.88,0:55:02.97,JP（）,NTP,0000,0000,0000,,Сайтен Кэннон
Dialogue: 0,0:55:10.55,0:55:12.15,JP（）,NTP,0000,0000,0000,,Күйікті құс
Dialogue: 0,0:55:21.68,0:55:22.47,JP（）,NTP,0000,0000,0000,,Өзіңді тым биік ұстама
Dialogue: 0,0:55:37.41,0:55:37.74,JP（）,NTP,0000,0000,0000,,Қоңырау гүлі
Dialogue: 0,0:55:41.69,0:55:43.41,JP（）,NTP,0000,0000,0000,,Әйелдерге немқұрайлы қарау
Dialogue: 0,0:55:44.04,0:55:44.83,JP（）,NTP,0000,0000,0000,,Енді
Dialogue: 0,0:55:45.46,0:55:47.53,JP（）,NTP,0000,0000,0000,,Хорай аралымен қоштаспас бұрын
Dialogue: 0,0:55:47.65,0:55:49.68,JP（）,NTP,0000,0000,0000,,Ауылдағылардың бәрі өлтірілді.
Dialogue: 0,0:55:58.92,0:55:59.57,JP（）,NTP,0000,0000,0000,,Біз ойлағаннан ертерек кездесе аламыз.
Dialogue: 0,0:55:59.88,0:56:00.75,JP（）,NTP,0000,0000,0000,,Қандай жағымсыз!
Dialogue: 0,0:56:01.03,0:56:03.60,JP（）,NTP,0000,0000,0000,,Кагоме-чан Шиппо маған балаларды беріңізші
Dialogue: 0,0:56:03.83,0:56:05.81,JP（）,NTP,0000,0000,0000,,Иә,түсінемін.
Dialogue: 0,0:56:06.02,0:56:06.97,JP（）,NTP,0000,0000,0000,,Маған қалдырыңыз
Dialogue: 0,0:56:14.02,0:56:16.82,JP（）,NTP,0000,0000,0000,,Балаларда Төрт жауынгерлік құдайдың мөрі болғанша
Dialogue: 0,0:56:17.39,0:56:19.96,JP（）,,0000,0000,0000,,Аралдан қашып құтыла алмайсың
Dialogue: 0,0:56:20.29,0:56:23.31,JP（）,NTP,0000,0000,0000,,Бұл бәрібір оларды жеңуден басқа амалымыз жоқ дегенді білдіреді.
Dialogue: 0,0:56:26.59,0:56:27.26,JP（）,NTP,0000,0000,0000,,Хехе
Dialogue: 0,0:56:33.57,0:56:34.48,JP（）,NTP,0000,0000,0000,,Ұшатын сүйектер
Dialogue: 0,0:57:09.47,0:57:10.20,JP（）,NTP,0000,0000,0000,,Өзіңді тым биік ұстама
Dialogue: 0,0:57:10.70,0:57:12.06,JP（）,NTP,0000,0000,0000,,Қайда барсаң да мен саған еремін
Dialogue: 0,0:57:16.77,0:57:18.41,JP（）,NTP,0000,0000,0000,,Қараңызшы,мен айтқандай болды.
Dialogue: 0,0:57:18.87,0:57:21.39,JP（）,NTP,0000,0000,0000,,Кеме ондаған жылдар бойы пайдаланылмаған.
Dialogue: 0,0:57:22.34,0:57:24.21,JP（）,NTP,0000,0000,0000,,Әпке,жарайық
Dialogue: 0,0:57:24.90,0:57:27.55,JP（）,NTP,0000,0000,0000,,Түсіндім,оны өзіміз жасауымыз керек.
Dialogue: 0,0:57:28.16,0:57:28.54,JP（）,NTP,0000,0000,0000,,Орындаңыз
Dialogue: 0,0:57:30.11,0:57:32.38,JP（）,NTP,0000,0000,0000,,Шиппо-чан Оранж-кун,Мидори-кун және Шион-кунмен бірге.
Dialogue: 0,0:57:32.38,0:57:33.61,JP（）,,0000,0000,0000,,Журналдарды бірге жинаңыз
Dialogue: 0,0:57:33.82,0:57:36.96,JP（）,NTP,0000,0000,0000,,Мүмкіндігінше түзу,қалыңдығы мен ұзындығы бірдей.
Dialogue: 0,0:57:37.65,0:57:39.55,JP（）,NTP,0000,0000,0000,,Мен көмектесе алмаймын.
Dialogue: 0,0:57:39.82,0:57:41.80,JP（）,NTP,0000,0000,0000,,Жарайды,бәрің менімен бірге жүріңдер.
Dialogue: 0,0:57:44.74,0:57:47.01,JP（）,NTP,0000,0000,0000,,Әй,бастықтың айтқанын тыңда.
Dialogue: 0,0:57:47.58,0:57:48.65,JP（）,NTP,0000,0000,0000,,Моэги-чан және Ай-чан
Dialogue: 0,0:57:49.12,0:57:51.61,JP（）,,0000,0000,0000,,Ағашты байлау үшін маған арқан мен үлкен мата тауып беріңізші.
Dialogue: 0,0:57:51.88,0:57:52.28,JP（）,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:57:52.83,0:57:54.88,JP（）,NTP,0000,0000,0000,,Асаги-чан,маған сал жасауға көмектесші.
Dialogue: 0,0:58:03.86,0:58:05.80,JP（）,NTP,0000,0000,0000,,Бұл нағыз Кикио емес.
Dialogue: 0,0:58:06.60,0:58:07.93,JP（）,NTP,0000,0000,0000,,Мен мұны білемін.
Dialogue: 0,0:58:30.52,0:58:33.60,JP（）,NTP,0000,0000,0000,,Біз сені күттік,Сесшомару-сама.
Dialogue: 0,0:58:40.15,0:58:44.42,JP（）,NTP,0000,0000,0000,,Жақсы,мен көмектесуге қуаныштымын.
Dialogue: 0,0:58:55.53,0:58:59.30,JP（）,NTP,0000,0000,0000,,Қара, қара, қара,мәңгі қашпа.
Dialogue: 0,0:58:59.36,0:58:59.87,JP（）,NTP,0000,0000,0000,,Ұшатын сүйектер
Dialogue: 0,0:59:02.30,0:59:03.46,JP（）,NTP,0000,0000,0000,,Сайтен Кэннон
Dialogue: 0,0:59:13.21,0:59:15.76,JP（）,NTP,0000,0000,0000,,Ақыр аяғында оны жұтудан басқа амалым жоқ сияқты.
Dialogue: 0,0:59:16.11,0:59:18.22,JP（）,NTP,0000,0000,0000,,Хоуши-сама,жел үңгірі әлі ашық.
Dialogue: 0,0:59:18.24,0:59:20.00,JP（）,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:59:20.47,0:59:21.64,JP（）,NTP,0000,0000,0000,,Вентиляциялық тесік
Dialogue: 0,0:59:33.56,0:59:34.94,JP（）,NTP,0000,0000,0000,,Менің Сайтен зеңбірекім
Dialogue: 0,0:59:40.90,0:59:42.99,JP（）,NTP,0000,0000,0000,,Сенің әкең Эден мектебінің түлегі ғой,иә?
Dialogue: 0,0:59:57.77,1:00:01.32,JP（）,NTP,0000,0000,0000,,Бұл менің бастапқы күшім.
Dialogue: 0,1:00:31.99,1:00:35.39,JP（）,NTP,0000,0000,0000,,Қарғыс атсын,мен... мен...
Dialogue: 0,1:01:03.00,1:01:05.13,JP（）,NTP,0000,0000,0000,,Ки... Кикио
Dialogue: 0,1:01:07.60,1:01:12.21,JP（）,NTP,0000,0000,0000,,Мұндай нашар өнімділікке алаңдау өте аянышты.
Dialogue: 0,1:01:26.44,1:01:27.76,JP（）,NTP,0000,0000,0000,,Күйікті құс
Dialogue: 0,1:01:46.18,1:01:48.86,JP（）,NTP,0000,0000,0000,,Қызық екен,Сесшомару-сама.
Dialogue: 0,1:01:49.30,1:01:51.11,JP（）,NTP,0000,0000,0000,,Сен екеуміз бірдейміз
Dialogue: 0,1:01:52.04,1:01:53.01,JP（）,NTP,0000,0000,0000,,Саналы сөздер
Dialogue: 0,1:01:56.29,1:01:58.81,JP（）,NTP,0000,0000,0000,,Ұрыс кезінде қуаныш сезімі
Dialogue: 0,1:01:58.81,1:02:01.20,JP（）,,0000,0000,0000,,Мен өмір сүрудің мақсаты бір-бірін өлтіру деп ойлаймын.
Dialogue: 0,1:02:01.45,1:02:04.39,JP（）,NTP,0000,0000,0000,,Сіз бен менің айырмашылығымыз неде?
Dialogue: 0,1:02:04.85,1:02:07.79,JP（）,NTP,0000,0000,0000,,Өзің сияқты төмен деңгейдегі құбыжықтармен араласпа.
Dialogue: 0,1:02:18.56,1:02:19.53,JP（）,NTP,0000,0000,0000,,Қызыл зұлым жанкүйер
Dialogue: 0,1:02:22.94,1:02:24.80,JP（）,NTP,0000,0000,0000,,Мен бұған ешқашан жол бере алмаймын.
Dialogue: 0,1:02:24.84,1:02:28.00,JP（）,NTP,0000,0000,0000,,Олай болса,оның айырмашылығы неде екенін айтыңызшы.
Dialogue: 0,1:02:31.88,1:02:34.73,JP（）,NTP,0000,0000,0000,,Сізге айтудың қажеті жоқ
Dialogue: 0,1:02:36.25,1:02:37.33,JP（）,NTP,0000,0000,0000,,Сурюха
Dialogue: 0,1:02:48.92,1:02:52.98,JP（）,NTP,0000,0000,0000,,Не болды? Бұл соңы ма?
Dialogue: 0,1:02:59.60,1:03:03.75,JP（）,NTP,0000,0000,0000,,Менің іздегенім – күшті болмыспен күрес
Dialogue: 0,1:03:04.01,1:03:05.59,JP（）,,0000,0000,0000,,Сіз емес
Dialogue: 0,1:03:55.26,1:03:58.26,JP（）,NTP,0000,0000,0000,,Ах Асаги-неечан
Dialogue: 0,1:03:59.17,1:04:01.17,JP（）,NTP,0000,0000,0000,,Артқы жағындағы мөр жоғалып кетті.
Dialogue: 0,1:04:02.07,1:04:02.83,JP（）,NTP,0000,0000,0000,,Шынымен бе?
Dialogue: 0,1:04:05.13,1:04:05.82,JP（）,NTP,0000,0000,0000,,Бұл рас
Dialogue: 0,1:04:06.26,1:04:08.53,JP（）,NTP,0000,0000,0000,,Төрт соғысушы құдайдың бірі жеңілді.
Dialogue: 0,1:04:09.00,1:04:10.32,JP（）,NTP,0000,0000,0000,,Тек бір адам
Dialogue: 0,1:04:11.13,1:04:12.54,JP（）,NTP,0000,0000,0000,,Тағы үшеуі қалды.
Dialogue: 0,1:04:12.73,1:04:15.77,JP（）,NTP,0000,0000,0000,,Кагоме-оне-чан,бізге көмектесіңізші.
Dialogue: 0,1:04:16.50,1:04:18.71,JP（）,NTP,0000,0000,0000,,Иә,бұл міндетті түрде көмектеседі.
Dialogue: 0,1:04:19.76,1:04:21.79,JP（）,NTP,0000,0000,0000,,Жарайды, аздап болса да,бар күшімізді салайық.
Dialogue: 0,1:04:23.58,1:04:25.28,JP（）,NTP,0000,0000,0000,,Шион,маған арқан әкел.
Dialogue: 0,1:04:31.18,1:04:32.12,JP（）,NTP,0000,0000,0000,,Не болды? Шион
Dialogue: 0,1:04:37.91,1:04:38.54,JP（）,NTP,0000,0000,0000,,Рюра
Dialogue: 0,1:04:40.60,1:04:43.04,JP（）,NTP,0000,0000,0000,,Балалар,онда не істеп жүрсіңдер?
Dialogue: 0,1:04:44.41,1:04:45.00,JP（）,NTP,0000,0000,0000,,Шион-кун
Dialogue: 0,1:04:45.75,1:04:48.87,JP（）,NTP,0000,0000,0000,,Менің ойымша,сіз бұл жерден кетуге асықпайсыз.
Dialogue: 0,1:04:49.44,1:04:52.89,JP（）,NTP,0000,0000,0000,,Сіздің арқаңызда кем дегенде бір мөр болғанша
Dialogue: 0,1:04:52.91,1:04:54.73,JP（）,NTP,0000,0000,0000,,Мен бұл аралдан кете алмаймын
Dialogue: 0,1:04:56.19,1:04:58.23,JP（）,NTP,0000,0000,0000,,Кешіріңіз...кешіріңіз.
Dialogue: 0,1:04:59.07,1:05:01.10,JP（）,NTP,0000,0000,0000,,Сіздің бизнесіңіз аяқталды деп ойлаймын.
Dialogue: 0,1:05:01.50,1:05:02.25,JP（）,,0000,0000,0000,,Ол жерден кет.
Dialogue: 0,1:05:02.80,1:05:07.12,JP（）,NTP,0000,0000,0000,,Хехехехе мен әйелдердің төбелескенін ұнатпаймын.
Dialogue: 0,1:05:07.40,1:05:09.53,JP（）,NTP,0000,0000,0000,,Біз сен сияқтыларды жек көреміз.
Dialogue: 0,1:05:09.96,1:05:12.74,JP（）,NTP,0000,0000,0000,,Балаларды қорлағаныма қуаныштымын. Бұл қорқақ емес.
Dialogue: 0,1:05:13.02,1:05:14.96,JP（）,NTP,0000,0000,0000,,Дұрыс,онда бұл бұзық.
Dialogue: 0,1:05:16.24,1:05:18.90,JP（）,NTP,0000,0000,0000,,Мен білемін,бір адам қаза тапты.
Dialogue: 0,1:05:19.39,1:05:20.26,JP（）,NTP,0000,0000,0000,,Қараңыз
Dialogue: 0,1:05:20.50,1:05:23.34,JP（）,,0000,0000,0000,,Инуяша енді бірігіп,барлығын жеңеді.
Dialogue: 0,1:05:23.80,1:05:27.41,JP（）,NTP,0000,0000,0000,,Аға,менің жолым жоқ.
Dialogue: 0,1:05:28.12,1:05:30.35,JP（）,NTP,0000,0000,0000,,Адам әйел мен жартылай жынның арасы
Dialogue: 0,1:05:30.68,1:05:33.45,JP（）,,0000,0000,0000,,Мен онша ынталы емеспін.
Dialogue: 0,1:05:33.90,1:05:36.05,JP（）,NTP,0000,0000,0000,,Сіз толыққанды юкайсыз.
Dialogue: 0,1:05:42.56,1:05:47.34,JP（）,NTP,0000,0000,0000,,Ол Канатокидің адам әйелін тірі қалдыру арқылы сәтсіздікке ұшырады.
Dialogue: 0,1:05:52.44,1:05:54.19,JP（）,NTP,0000,0000,0000,,Оның рухани күші бар.
Dialogue: 0,1:05:54.48,1:05:57.13,JP（）,,0000,0000,0000,,Мен оны бірден өлтіруім керек еді.
Dialogue: 0,1:06:10.96,1:06:11.93,JP（）,NTP,0000,0000,0000,,Ұшатын сүйектер
Dialogue: 0,1:06:40.70,1:06:42.11,JP（）,NTP,0000,0000,0000,,Қызықты
Dialogue: 0,1:06:43.20,1:06:45.78,JP（）,NTP,0000,0000,0000,,Маржан Бір-бірімен соғыссын
Dialogue: 0,1:06:46.86,1:06:47.32,JP（）,NTP,0000,0000,0000,,Слюда
Dialogue: 0,1:07:01.68,1:07:03.08,JP（）,NTP,0000,0000,0000,,Қашып кеткіңіз келе ме?
Dialogue: 0,1:07:28.76,1:07:29.73,JP（）,NTP,0000,0000,0000,,Енді Маржан
Dialogue: 0,1:07:29.90,1:07:30.50,JP（）,NTP,0000,0000,0000,,Түсіндім
Dialogue: 0,1:07:31.96,1:07:33.52,JP（）,NTP,0000,0000,0000,,Сіз бұл қолды жейсіз бе?
Dialogue: 0,1:07:36.46,1:07:38.88,JP（）,NTP,0000,0000,0000,,Жоқ,мен жеймін.
Dialogue: 0,1:07:39.59,1:07:40.52,JP（）,NTP,0000,0000,0000,,Вентиляциялық тесік
Dialogue: 0,1:08:20.39,1:08:21.85,JP（）,NTP,0000,0000,0000,,Жарайды,тағы бір.
Dialogue: 0,1:08:31.12,1:08:32.35,JP（）,NTP,0000,0000,0000,,Кагоме Оне-чан
Dialogue: 0,1:08:32.60,1:08:34.93,JP（）,NTP,0000,0000,0000,,Мен балаға жақсы қараймын.
Dialogue: 0,1:08:34.97,1:08:36.51,JP（）,,0000,0000,0000,,Уайымдамаңыз.
Dialogue: 0,1:08:37.16,1:08:38.66,JP（）,NTP,0000,0000,0000,,Сәлем Рюра
Dialogue: 0,1:08:39.88,1:08:43.30,JP（）,NTP,0000,0000,0000,,Тағы бір мөр қалды. Тағы екі.
Dialogue: 0,1:08:43.75,1:08:46.28,JP（）,NTP,0000,0000,0000,,Төрт соғысушы құдай да маңызды емес.
Dialogue: 0,1:08:46.67,1:08:49.37,JP（）,NTP,0000,0000,0000,,Әй,мені ренжітетін сөздерді айтпа.
Dialogue: 0,1:08:49.90,1:08:52.36,JP（）,NTP,0000,0000,0000,,Дұрыс,Төрт күресуші құдай әлсіз.
Dialogue: 0,1:08:52.44,1:08:53.21,JP（）,NTP,0000,0000,0000,,Моэги
Dialogue: 0,1:08:53.23,1:08:55.02,JP（）,NTP,0000,0000,0000,,Кагоме-оне-чаннан аулақ болайық
Dialogue: 0,1:08:56.02,1:08:57.93,JP（）,NTP,0000,0000,0000,,Мен енді сенен қорықпаймын.
Dialogue: 0,1:08:58.41,1:08:59.79,JP（）,NTP,0000,0000,0000,,Мына аралдан кет!
Dialogue: 0,1:09:00.63,1:09:02.03,JP（）,NTP,0000,0000,0000,,Шық!
Dialogue: 0,1:09:02.48,1:09:04.18,JP（）,NTP,0000,0000,0000,,Артық емес
Dialogue: 0,1:09:04.59,1:09:07.87,JP（）,NTP,0000,0000,0000,,Уайымдама,баламен байсалды болма.
Dialogue: 0,1:09:08.60,1:09:09.21,JP（）,NTP,0000,0000,0000,,Өзгерту
Dialogue: 0,1:09:12.13,1:09:12.80,JP（）,NTP,0000,0000,0000,,Шиппо-чан
Dialogue: 0,1:09:13.81,1:09:14.84,JP（）,NTP,0000,0000,0000,,Барлығы жақсы ма?
Dialogue: 0,1:09:15.23,1:09:17.36,JP（）,NTP,0000,0000,0000,,Шиппо-нии-чанға рахмет
Dialogue: 0,1:09:31.20,1:09:32.28,JP（）,NTP,0000,0000,0000,,Инуяша ағасы
Dialogue: 0,1:09:32.30,1:09:32.99,JP（）,NTP,0000,0000,0000,,Инуяша
Dialogue: 0,1:09:33.41,1:09:35.38,JP（）,NTP,0000,0000,0000,,Кагомеден аулақ болыңыз
Dialogue: 0,1:09:37.59,1:09:40.10,JP（）,NTP,0000,0000,0000,,Сіздің қарсыласыңыз – мен.
Dialogue: 0,1:09:46.08,1:09:48.58,JP（）,NTP,0000,0000,0000,,Біз күресетін төрт құдайға қарсы шығамыз ба?
Dialogue: 0,1:09:48.88,1:09:50.58,JP（）,NTP,0000,0000,0000,,Бұл жүз жыл ерте.
Dialogue: 0,1:09:53.22,1:09:54.04,JP（）,NTP,0000,0000,0000,,Инуяша
Dialogue: 0,1:09:55.33,1:09:59.77,JP（）,NTP,0000,0000,0000,,Ол қандай құдай? Менің ойымша,ол мені жай ғана еркелетеді.
Dialogue: 0,1:10:09.68,1:10:11.59,JP（）,NTP,0000,0000,0000,,Жел жарақаты
Dialogue: 0,1:10:14.95,1:10:16.51,JP（）,NTP,0000,0000,0000,,Жер айдаһары Фугакуре
Dialogue: 0,1:10:18.28,1:10:19.49,JP（）,NTP,0000,0000,0000,,Чи жейді
Dialogue: 0,1:10:19.65,1:10:21.50,JP（）,NTP,0000,0000,0000,,Конго найзасы
Dialogue: 0,1:10:26.41,1:10:29.63,JP（）,NTP,0000,0000,0000,,Сүйкімді,мені кім деп ойлайсың?
Dialogue: 0,1:10:29.99,1:10:30.38,JP（）,NTP,0000,0000,0000,,Эрен тұрған жаққа
Dialogue: 0,1:11:06.38,1:11:07.80,JP（）,NTP,0000,0000,0000,,Инуяша ағасы
Dialogue: 0,1:11:10.94,1:11:13.34,JP（）,NTP,0000,0000,0000,,Барыңды істе,Инуяша-нии-чан
Dialogue: 0,1:11:15.54,1:11:16.40,JP（）,NTP,0000,0000,0000,,Инуяша
Dialogue: 0,1:11:17.65,1:11:19.72,JP（）,NTP,0000,0000,0000,,Инуяша ағасы
Dialogue: 0,1:11:25.88,1:11:28.70,JP（）,NTP,0000,0000,0000,,бөліміне өтіңіз. Бұл аздап қызықты болды.
Dialogue: 0,1:11:38.45,1:11:40.26,JP（）,NTP,0000,0000,0000,,Егер сіз ойланбасаңыз,жеңу мүмкін емес.
Dialogue: 0,1:11:42.10,1:11:43.38,JP（）,NTP,0000,0000,0000,,Өртеп жеу
Dialogue: 0,1:11:43.42,1:11:44.66,JP（）,NTP,0000,0000,0000,,Осы дем алған нысанды оққа орайық. Меніңше,бұл әрекетке тұрарлық.
Dialogue: 0,1:11:51.45,1:11:53.47,JP（）,NTP,0000,0000,0000,,Көп алданбаңыз.
Dialogue: 0,1:11:54.28,1:11:57.04,JP（）,NTP,0000,0000,0000,,Қарғыс атсын,мен жеңілемін.
Dialogue: 0,1:11:59.68,1:12:01.85,JP（）,NTP,0000,0000,0000,,Жетеді,артқа тартыңыз.
Dialogue: 0,1:12:05.95,1:12:06.65,JP（）,NTP,0000,0000,0000,,Инуяша
Dialogue: 0,1:12:07.10,1:12:08.33,JP（）,NTP,0000,0000,0000,,Инуяша ағасы
Dialogue: 0,1:12:09.25,1:12:11.05,JP（）,NTP,0000,0000,0000,,Мен сендердің сезімдеріңді түсінемін.
Dialogue: 0,1:12:12.16,1:12:13.95,JP（）,NTP,0000,0000,0000,,Аралдан кеткім келетін сияқты
Dialogue: 0,1:12:14.68,1:12:16.87,JP（）,NTP,0000,0000,0000,,Өзімді өлгім келетіндей сезіну
Dialogue: 0,1:12:17.42,1:12:19.68,JP（）,NTP,0000,0000,0000,,Өз бетінше күрескісі келетін сезім
Dialogue: 0,1:12:20.42,1:12:23.05,JP（）,NTP,0000,0000,0000,,Мен де күресетін төрт құдайды жеңгім келеді.
Dialogue: 0,1:12:23.76,1:12:25.06,JP（）,NTP,0000,0000,0000,,Ал Са… сен,тез арада мұнда кет.
Dialogue: 0,1:12:25.36,1:12:30.35,JP（）,NTP,0000,0000,0000,,Қалғанын маған қалдырыңыз
Dialogue: 0,1:12:54.84,1:12:55.81,JP（）,NTP,0000,0000,0000,,Тағы бір
Dialogue: 0,1:13:11.04,1:13:13.06,JP（）,NTP,0000,0000,0000,,Сіз бұл аралды жоюды жоспарлап отырсыз ба?
Dialogue: 0,1:13:16.51,1:13:17.28,JP（）,NTP,0000,0000,0000,,Инуяша
Dialogue: 0,1:13:17.81,1:13:19.40,JP（）,NTP,0000,0000,0000,,Гора ауылға шабуыл жасайды
Dialogue: 0,1:13:20.34,1:13:22.37,JP（）,NTP,0000,0000,0000,,Біз бүкіл аралды суға батыруға тырысуымыз мүмкін.
Dialogue: 0,1:13:22.55,1:13:24.37,JP（）,NTP,0000,0000,0000,,Менің ойымша,оны доғал тасбақамен кескен дұрыс.
Dialogue: 0,1:13:46.13,1:13:47.00,JP（）,NTP,0000,0000,0000,,Инуяша
Dialogue: 0,1:14:28.70,1:14:30.08,JP（）,NTP,0000,0000,0000,,Бакурюха
Dialogue: 0,1:15:09.73,1:15:10.52,JP（）,NTP,0000,0000,0000,,Мен мұны істедім
Dialogue: 0,1:15:11.07,1:15:12.95,JP（）,NTP,0000,0000,0000,,Инуяша-нии-чан керемет
Dialogue: 0,1:15:13.60,1:15:14.53,JP（）,NTP,0000,0000,0000,,Кішкене істе
Dialogue: 0,1:15:15.24,1:15:17.43,JP（）,NTP,0000,0000,0000,,Бірақ әлі де бір тыртық қалды.
Dialogue: 0,1:15:18.02,1:15:19.74,JP（）,NTP,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,1:15:22.36,1:15:23.53,JP（）,NTP,0000,0000,0000,,Жақсысың ба,Инуяша?
Dialogue: 0,1:15:24.06,1:15:25.64,JP（）,NTP,0000,0000,0000,,Көп уайымдамаңыз
Dialogue: 0,1:15:44.96,1:15:47.11,JP（）,NTP,0000,0000,0000,,Сіз өзіңіздің шынайы болмысыңызды көрсеттіңіз.
Dialogue: 0,1:15:48.06,1:15:48.59,JP（）,NTP,0000,0000,0000,,Кагоме
Dialogue: 0,1:15:49.42,1:15:49.77,JP（）,NTP,0000,0000,0000,,Біз Әйел Титан сияқты көрінетін біреуді байқадық.
Dialogue: 0,1:15:50.35,1:15:52.45,JP（）,NTP,0000,0000,0000,,Сіз не істеп жатырсыз? Барайық.
Dialogue: 0,1:15:52.93,1:15:55.16,JP（）,NTP,0000,0000,0000,,Сондықтан садақ пен жебе жоқ.
Dialogue: 0,1:15:57.02,1:15:58.59,JP（）,NTP,0000,0000,0000,,Рухымызбен бірдеңе жасайық.
Dialogue: 0,1:15:59.13,1:16:00.69,JP（）,NTP,0000,0000,0000,,Мен осылай дедім
Dialogue: 0,1:16:02.48,1:16:03.79,JP（）,NTP,0000,0000,0000,,Садаққа айналса да
Dialogue: 0,1:16:04.08,1:16:05.76,JP（）,,0000,0000,0000,,Жоюдың жебесіне айнала алмайсың.
Dialogue: 0,1:16:06.73,1:16:08.74,JP（）,NTP,0000,0000,0000,,Бұл қауіпті болуы керек.
Dialogue: 0,1:16:09.23,1:16:11.66,JP（）,NTP,0000,0000,0000,,Жақсысың ба,Инуяша?
Dialogue: 0,1:16:12.45,1:16:13.36,JP（）,NTP,0000,0000,0000,,Барлығыңыз өтінемін
Dialogue: 0,1:16:13.87,1:16:16.46,JP（）,,0000,0000,0000,,Көрсеткіні алмастыратын нәрсені іздеңіз.
Dialogue: 0,1:16:17.05,1:16:20.66,JP（）,NTP,0000,0000,0000,,Мүмкіндігінше жіңішке және түзу,ағаш кесіндісі мен ұшты тас.
Dialogue: 0,1:16:21.15,1:16:21.47,JP（）,NTP,0000,0000,0000,,Иә
Dialogue: 0,1:16:26.82,1:16:27.49,JP（）,NTP,0000,0000,0000,,Ә? (Кения) Сен➡
Dialogue: 0,1:17:02.66,1:17:04.45,JP（）,NTP,0000,0000,0000,,Шион Шион
Dialogue: 0,1:17:05.02,1:17:06.41,JP（）,NTP,0000,0000,0000,,Сәттілік Шион
Dialogue: 0,1:17:06.70,1:17:08.14,JP（）,NTP,0000,0000,0000,,Біз сенімен біргеміз
Dialogue: 0,1:17:26.57,1:17:27.19,JP（）,NTP,0000,0000,0000,,Слюда
Dialogue: 0,1:17:35.59,1:17:38.38,JP（）,NTP,0000,0000,0000,,Ойын енді ғана басталды.
Dialogue: 0,1:17:40.05,1:17:40.86,JP（）,NTP,0000,0000,0000,,Өзіңді тым биік ұстама
Dialogue: 0,1:17:43.43,1:17:44.45,JP（）,NTP,0000,0000,0000,,Кагоме-неечан
Dialogue: 0,1:17:50.02,1:17:50.65,JP（）,NTP,0000,0000,0000,,Шион
Dialogue: 0,1:17:58.39,1:17:59.16,JP（）,NTP,0000,0000,0000,,Шион
Dialogue: 0,1:17:59.53,1:18:00.54,JP（）,NTP,0000,0000,0000,,Асаги-неечан
Dialogue: 0,1:18:07.33,1:18:08.04,JP（）,NTP,0000,0000,0000,,Инуяша
Dialogue: 0,1:18:20.08,1:18:23.02,JP（）,NTP,0000,0000,0000,,Әпке,мені ұстаңыз!
Dialogue: 0,1:18:23.59,1:18:24.21,JP（）,NTP,0000,0000,0000,,Кеттік
Dialogue: 0,1:18:26.44,1:18:26.77,JP（）,NTP,0000,0000,0000,,Иә
Dialogue: 0,1:18:45.61,1:18:46.58,JP（）,NTP,0000,0000,0000,,Вентиляциялық тесік
Dialogue: 0,1:18:52.15,1:18:52.88,JP（）,NTP,0000,0000,0000,,Майтрея
Dialogue: 0,1:18:53.15,1:18:53.78,JP（）,NTP,0000,0000,0000,,Ұшатын сүйектер
Dialogue: 0,1:18:58.54,1:18:59.48,JP（）,NTP,0000,0000,0000,,Сен
Dialogue: 0,1:19:03.81,1:19:04.42,JP（）,NTP,0000,0000,0000,,Кагоме
Dialogue: 0,1:19:04.09,1:19:05.72,NOTE（）,NTP,0000,0000,0000,,Кагоме-неечан
Dialogue: 0,1:19:07.14,1:19:07.89,JP（）,NTP,0000,0000,0000,,Шиппо-чан
Dialogue: 0,1:19:11.13,1:19:12.22,JP（）,NTP,0000,0000,0000,,Барлығы жақсы ма?
Dialogue: 0,1:19:12.45,1:19:15.87,JP（）,NTP,0000,0000,0000,,Kagome-onee-chan бұл
Dialogue: 0,1:19:16.56,1:19:18.41,JP（）,NTP,0000,0000,0000,,Балалар,мұны қай жерде жасадыңдар?
Dialogue: 0,1:19:18.93,1:19:20.60,JP（）,NTP,0000,0000,0000,,Бұны маған от бәліштері үйретті.
Dialogue: 0,1:19:21.95,1:19:22.64,JP（）,NTP,0000,0000,0000,,Өрт сөндірушілер
Dialogue: 0,1:19:33.83,1:19:34.38,JP（）,NTP,0000,0000,0000,,Инуяша
Dialogue: 0,1:19:48.31,1:19:50.92,JP（）,NTP,0000,0000,0000,,Мен оны біраз қарап шықтым.
Dialogue: 0,1:19:51.65,1:19:54.88,JP（）,NTP,0000,0000,0000,,Сен бәрібір қызықсыз жігітсің.
Dialogue: 0,1:19:58.42,1:19:58.69,JP（）,NTP,0000,0000,0000,,На
Dialogue: 0,1:20:25.77,1:20:28.69,JP（）,NTP,0000,0000,0000,,Өтінемін Инуяша-нии-чан
Dialogue: 0,1:20:35.87,1:20:36.68,JP（）,NTP,0000,0000,0000,,Инуяша
Dialogue: 0,1:20:38.83,1:20:41.42,JP（）,NTP,0000,0000,0000,,Мен өзімді ынталы сезінемін.
Dialogue: 0,1:20:44.04,1:20:45.86,JP（）,NTP,0000,0000,0000,,Кагомеге барайық
Dialogue: 0,1:20:47.00,1:20:50.85,JP（）,NTP,0000,0000,0000,,Ойын аяқталды,өл.
Dialogue: 0,1:20:58.37,1:20:59.71,JP（）,NTP,0000,0000,0000,,Конго
Dialogue: 0,1:21:00.03,1:21:01.31,JP（）,NTP,0000,0000,0000,,Уууууууу!!
Dialogue: 0,1:21:01.75,1:21:03.58,JP（）,NTP,0000,0000,0000,,Бакурюха
Dialogue: 0,1:21:22.98,1:21:24.86,JP（）,NTP,0000,0000,0000,,мен мұны істедім.
Dialogue: 0,1:21:26.51,1:21:27.60,JP（）,NTP,0000,0000,0000,,Шрам жоғалып кетті
Dialogue: 0,1:21:28.20,1:21:29.16,JP（）,NTP,0000,0000,0000,,Бұл рас
Dialogue: 0,1:21:31.86,1:21:33.07,JP（）,NTP,0000,0000,0000,,Біз құтқарылдық,солай емес пе?
Dialogue: 0,1:21:32.75,1:21:33.40,JP（）,NTP,0000,0000,0000,,Мен мұны істедім
Dialogue: 0,1:21:36.03,1:21:38.28,JP（）,NTP,0000,0000,0000,,Рахмет Ай
Dialogue: 0,1:21:58.60,1:21:59.87,JP（）,NTP,0000,0000,0000,,Хорай аралы
Dialogue: 0,1:22:00.70,1:22:01.72,JP（）,NTP,0000,0000,0000,,Жоғалу
Dialogue: 0,1:22:09.81,1:22:13.32,JP（）,NTP,0000,0000,0000,,Дүрілдеген қазанның күшін жоғалтқандықтан болар.
Dialogue: 0,1:22:13.66,1:22:15.93,JP（）,NTP,0000,0000,0000,,Менің ойымша,уақыт түрмесі бұзылды.
Dialogue: 0,1:22:16.90,1:22:18.12,JP（）,NTP,0000,0000,0000,,Мен сол арал туралы ойласам
Dialogue: 0,1:22:18.48,1:22:21.02,JP（）,,0000,0000,0000,,Әу бастан-ақ тағдыр осылай болған шығар.
Dialogue: 0,1:22:24.38,1:22:27.22,JP（）,NTP,0000,0000,0000,,Қош бол,анашым
Dialogue: 0,1:22:34.34,1:22:36.59,JP（）,NTP,0000,0000,0000,,Бәріміз кеттік.
Dialogue: 0,1:26:16.05,1:26:18.46,JP（）,NTP,0000,0000,0000,,Лорд Сесшомару,сен қайда болдың?
Dialogue: 0,1:26:19.39,1:26:21.89,JP（）,NTP,0000,0000,0000,,Эй, айтшы,лорд Сесшомару.
Dialogue: 0,1:26:22.09,1:26:25.80,JP（）,NTP,0000,0000,0000,,Эй Сузу,Сесшомару-самадан қажетсіз нәрселерді сұрама.
Dialogue: 0,1:26:26.23,1:26:29.80,JP（）,NTP,0000,0000,0000,,Бірақ мен Лорд Сесшомару туралы көбірек білгім келеді.
Dialogue: 0,1:26:30.45,1:26:32.76,JP（）,NTP,0000,0000,0000,,Ах, Сесшомару-сама,күте тұрыңыз.
Dialogue: 0,1:26:36.00,1:26:38.74,JP（）,NTP,0000,0000,0000,,Менің ойымша,сендер дайынсыңдар.
Dialogue: 0,1:26:39.00,1:26:39.43,JP（）,NTP,0000,0000,0000,,Тұра аласың ба,Армин?
Dialogue: 0,1:26:40.28,1:26:42.16,JP（）,NTP,0000,0000,0000,,Сыртқы дүние – соғысушы мемлекеттер әлемі.
Dialogue: 0,1:26:42.81,1:26:45.89,JP（）,NTP,0000,0000,0000,,Әлсіз жарты сізді нысанаға алған юкайлар көп.
Dialogue: 0,1:26:46.18,1:26:48.57,JP（）,NTP,0000,0000,0000,,Уайымдама,Инуяша-нии-чан.
Dialogue: 0,1:26:48.91,1:26:50.66,JP（）,NTP,0000,0000,0000,,Хмм,бәрі жақсы.
Dialogue: 0,1:26:51.34,1:26:53.31,JP（）,NTP,0000,0000,0000,,Біз жақсы өмір сүре аламыз.
Dialogue: 0,1:26:53.80,1:26:54.97,JP（）,NTP,0000,0000,0000,,Инуяшаға не болды?
Dialogue: 0,1:26:55.12,1:26:56.86,JP（）,,0000,0000,0000,,Біз мұны істей алмаймыз.
Dialogue: 0,1:26:57.85,1:27:01.28,JP（）,NTP,0000,0000,0000,,Инуяша сияқты болмысыңызды бұрмалаудан сақ болыңыз.
Dialogue: 0,1:27:01.71,1:27:03.57,JP（）,NTP,0000,0000,0000,,Мүлдем істемесең,қиналады.
Dialogue: 0,1:27:03.96,1:27:07.07,JP（）,NTP,0000,0000,0000,,Менің ойымша,біз қандай да бір жолмен басқара аламыз.
Dialogue: 0,1:27:07.38,1:27:10.12,JP（）,NTP,0000,0000,0000,,Мен Инуяшадан жеңілмеу үшін бар күшімді саламын.
Dialogue: 0,1:27:10.54,1:27:12.57,JP（）,NTP,0000,0000,0000,,Бұл балалар жақсы болады.
Dialogue: 0,1:27:12.85,1:27:13.85,JP（）,NTP,0000,0000,0000,,Қорқып қалмаңдар
Dialogue: 0,1:27:14.05,1:27:16.12,JP（）,,0000,0000,0000,,Мен төрт құдайға қарсы тұрдым.
Dialogue: 0,1:27:16.32,1:27:18.21,JP（）,NTP,0000,0000,0000,,Мен түсінемін.
Dialogue: 0,1:27:19.06,1:27:20.23,JP（）,NTP,0000,0000,0000,,Инуяша ағасы
Dialogue: 0,1:27:20.46,1:27:21.06,JP（）,NTP,0000,0000,0000,,Иә?
Dialogue: 0,1:27:21.63,1:27:22.69,JP（）,NTP,0000,0000,0000,,(Виолет) Мен теремін. (Роданс) Жарай бер.
Dialogue: 0,1:27:23.15,1:27:26.40,JP（）,NTP,0000,0000,0000,,Біз Инуяша-нии-чанды ешқашан ұмытпаймыз.
Dialogue: 0,1:27:28.97,1:27:30.17,JP（）,NTP,0000,0000,0000,,О...о
Dialogue: 0,1:27:30.84,1:27:31.46,JP（）,NTP,0000,0000,0000,,Кирит
Dialogue: 0,1:27:37.71,1:27:40.65,JP（）,NTP,0000,0000,0000,,Инуяша,біз де барамыз ба?
Dialogue: 0,1:27:40.85,1:27:41.30,JP（）,NTP,0000,0000,0000,,Қалай болғанда да, Рейнэр,...
Dialogue: 0,0:01:18.48,0:01:21.06,CN（）,NTP,0000,0000,0000,,Дауыстың қимылы
Dialogue: 0,0:01:21.96,0:01:24.00,CN（）,NTP,0000,0000,0000,,Уақыт қақпасының дереу ашылуы
Dialogue: 0,0:01:29.76,0:01:30.63,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:01:35.01,0:01:36.36,CN（）,NTP,0000,0000,0000,,Асаги-нее
Dialogue: 0,0:01:36.57,0:01:38.19,CN（）,NTP,0000,0000,0000,,Сізді қамтыды және мөрмен бекітті
Dialogue: 0,0:01:38.55,0:01:40.08,CN（）,NTP,0000,0000,0000,,Сыртқы дүниеден қашу
Dialogue: 0,0:01:40.65,0:01:42.42,CN（）,NTP,0000,0000,0000,,Сіз осы жерден кете аласыз.
Dialogue: 0,0:01:42.87,0:01:45.72,CN（）,NTP,0000,0000,0000,,Алайда үй иесі кетіп қалды ма?
Dialogue: 0,0:01:46.14,0:01:47.10,CN（）,NTP,0000,0000,0000,,17-ші эпизод: Бэбифейс
Dialogue: 0,0:01:47.16,0:01:49.26,CN（）,NTP,0000,0000,0000,,Мен заңнан қаштым
Dialogue: 0,0:01:49.47,0:01:53.01,CN（）,NTP,0000,0000,0000,,Бөлек басқару
Dialogue: 0,0:01:53.16,0:01:54.45,CN（）,NTP,0000,0000,0000,,Ләззаттан қашу
Dialogue: 0,0:01:54.75,0:01:58.65,CN（）,NTP,0000,0000,0000,,Қажетсіз Гафусусу Гафусува Дайке филиалы
Dialogue: 0,0:01:58.73,0:02:00.99,CN（）,NTP,0000,0000,0000,,Тәртіпсіздік
Dialogue: 0,0:02:05.43,0:02:07.11,CN（）,NTP,0000,0000,0000,,Міне,марапат ретінде сүйіс. Мwah.
Dialogue: 0,0:02:09.87,0:02:11.64,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:02:49.98,0:02:52.98,CN（）,NTP,0000,0000,0000,,Жақсы мүсіннен қашқан адам
Dialogue: 0,0:02:53.04,0:02:54.72,CN（）,NTP,0000,0000,0000,,Тағы да мен соғысқа қосылдым.
Dialogue: 0,0:02:57.84,0:02:59.64,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:03:50.37,0:03:51.93,CN（）,NTP,0000,0000,0000,,Желдің тынысын есту
Dialogue: 0,0:04:10.47,0:04:13.29,CN（）,NTP,0000,0000,0000,,Сіз ояндыңыз ба?
Dialogue: 0,0:04:14.52,0:04:15.42,CN（）,NTP,0000,0000,0000,,Маржан
Dialogue: 0,0:04:15.51,0:04:17.43,CN（）,NTP,0000,0000,0000,,Міндетті түрме
Dialogue: 0,0:04:19.54,0:04:21.39,CN（）,NTP,0000,0000,0000,,Анам мені тастап кеткенде
Dialogue: 0,0:04:37.14,0:04:38.01,CN（）,NTP,0000,0000,0000,,Біз де жаман адамдармыз... бірақ есірткіден пайда табу... адамгершілік қағидаларына қайшы...
Dialogue: 0,0:04:41.01,0:04:42.21,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:04:45.30,0:04:46.50,CN（）,NTP,0000,0000,0000,,Әпке
Dialogue: 0,0:04:46.95,0:04:48.45,CN（）,NTP,0000,0000,0000,,Мироку Дхарма Санго
Dialogue: 0,0:04:49.92,0:04:52.41,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:04:52.47,0:04:54.93,CN（）,NTP,0000,0000,0000,,Чидо Рио! Клузонна
Dialogue: 0,0:04:54.93,0:04:55.71,CN（）,NTP,0000,0000,0000,,Алмасу
Dialogue: 0,0:04:59.04,0:04:59.58,CN（）,NTP,0000,0000,0000,,Қандай ақымақ әңгіме айтып тұрсың? Тіпті біреудің тізесінде шаңқылдай өсіпті деген әңгіме де сенімдірек болар еді.
Dialogue: 0,0:04:59.64,0:05:00.91,CN（）,NTP,0000,0000,0000,,Екеуміздің арамыздағы ойсыз байланыс
Dialogue: 0,0:05:01.17,0:05:01.80,CN（）,NTP,0000,0000,0000,,Маржан
Dialogue: 0,0:05:01.83,0:05:02.49,CN（）,NTP,0000,0000,0000,,Өсу әлеуеті
Dialogue: 0,0:05:04.35,0:05:05.37,CN（）,NTP,0000,0000,0000,,Жабу аяқталды.
Dialogue: 0,0:05:11.01,0:05:11.67,CN（）,NTP,0000,0000,0000,,Құбыжық
Dialogue: 0,0:05:12.36,0:05:13.80,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:05:24.60,0:05:25.98,CN（）,NTP,0000,0000,0000,,Инуяша
Dialogue: 0,0:05:31.50,0:05:33.24,CN（）,NTP,0000,0000,0000,,Инуяша Геге
Dialogue: 0,0:05:38.25,0:05:40.02,CN（）,NTP,0000,0000,0000,,Кіші өзін-өзі ажырату
Dialogue: 0,0:06:10.29,0:06:11.07,CN（）,NTP,0000,0000,0000,,?
Dialogue: 0,0:06:18.12,0:06:19.62,CN（）,NTP,0000,0000,0000,,Мен қайдамын?
Dialogue: 0,0:06:25.50,0:06:26.46,CN（）,NTP,0000,0000,0000,,Инуяша
Dialogue: 0,0:06:26.55,0:06:27.99,CN（）,NTP,0000,0000,0000,,Инуяша Геге
Dialogue: 0,0:06:30.99,0:06:31.68,CN（）,NTP,0000,0000,0000,,Касугао
Dialogue: 0,0:06:39.78,0:06:40.53,CN（）,NTP,0000,0000,0000,,Темір сүйек
Dialogue: 0,0:06:42.24,0:06:43.71,CN（）,NTP,0000,0000,0000,,отбасы құру
Dialogue: 0,0:06:45.45,0:06:46.29,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:06:46.44,0:06:47.31,CN（）,NTP,0000,0000,0000,,Әпке
Dialogue: 0,0:06:50.28,0:06:54.30,CN（）,NTP,0000,0000,0000,,Сіз өзіңіздің қолдауыңызға да жауаптысыз.
Dialogue: 0,0:06:54.31,0:06:55.20,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:06:57.60,0:06:58.53,CN（）,NTP,0000,0000,0000,,Қайдасың?
Dialogue: 0,0:06:58.59,0:06:59.58,CN（）,NTP,0000,0000,0000,,Осы дискідегі ақпарат Неапольде пойызға мініп жатқан кезде жазылды.
Dialogue: 0,0:06:59.58,0:07:04.29,CN（）,NTP,0000,0000,0000,,Өлгендерді құтқару
Dialogue: 0,0:07:04.32,0:07:07.38,CN（）,NTP,0000,0000,0000,,Мен өлімді елестете алмаймын
Dialogue: 0,0:07:08.13,0:07:09.63,CN（）,NTP,0000,0000,0000,,Мен сені көре алмаймын,көмектесе алмаймын
Dialogue: 0,0:07:09.93,0:07:12.06,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:07:12.60,0:07:15.09,CN（）,NTP,0000,0000,0000,,Бұл серияға ұқсас...
Dialogue: 0,0:07:16.98,0:07:18.72,CN（）,NTP,0000,0000,0000,,Қазіргі уақытта орындалуда
Dialogue: 0,0:07:19.62,0:07:20.79,CN（）,NTP,0000,0000,0000,,Осыған ұқсас
Dialogue: 0,0:07:21.78,0:07:22.71,CN（）,NTP,0000,0000,0000,,?
Dialogue: 0,0:07:25.32,0:07:28.29,CN（）,NTP,0000,0000,0000,,Қолдың сезімі шын.
Dialogue: 0,0:07:29.01,0:07:30.00,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:07:31.77,0:07:33.66,CN（）,NTP,0000,0000,0000,,Сіз қашан құрғақсыз?
Dialogue: 0,0:07:33.69,0:07:34.68,CN（）,NTP,0000,0000,0000,,Кешір мені.
Dialogue: 0,0:07:37.50,0:07:38.88,CN（）,NTP,0000,0000,0000,,Әрине,бөлек.
Dialogue: 0,0:07:38.88,0:07:39.66,CN（）,NTP,0000,0000,0000,,Ересек заңгер
Dialogue: 0,0:07:40.08,0:07:40.92,CN（）,NTP,0000,0000,0000,,Майтрея
Dialogue: 0,0:07:41.16,0:07:41.97,CN（）,NTP,0000,0000,0000,,Трансформация
Dialogue: 0,0:07:46.50,0:07:49.68,CN（）,NTP,0000,0000,0000,,Сақталды! Бұл қытайдың үлкен құсы.
Dialogue: 0,0:07:49.68,0:07:51.00,CN（）,NTP,0000,0000,0000,,Бұл ең жақсысы
Dialogue: 0,0:07:55.21,0:07:57.03,CN（）,NTP,0000,0000,0000,,Жел тесігі
Dialogue: 0,0:08:00.42,0:08:01.74,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:08:01.80,0:08:03.54,CN（）,NTP,0000,0000,0000,,Теңіз суы арқылы өту
Dialogue: 0,0:08:05.82,0:08:06.66,CN（）,NTP,0000,0000,0000,,Майтрея заңгері
Dialogue: 0,0:08:06.69,0:08:07.83,CN（）,NTP,0000,0000,0000,,Мироку Санго оқуы
Dialogue: 0,0:08:08.58,0:08:11.22,CN（）,NTP,0000,0000,0000,,Желдің зақымдануы
Dialogue: 0,0:08:17.64,0:08:19.59,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:08:19.89,0:08:21.24,CN（）,NTP,0000,0000,0000,,Аяқталған өлім Инуяша
Dialogue: 0,0:08:21.27,0:08:22.08,CN（）,NTP,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:08:23.04,0:08:26.28,CN（）,NTP,0000,0000,0000,,Әңгіменің мәліметтері төмендегідей:
Dialogue: 0,0:08:27.21,0:08:30.54,CN（）,NTP,0000,0000,0000,,…
Dialogue: 0,0:08:36.90,0:08:38.01,CN（）,NTP,0000,0000,0000,,Инуяша
Dialogue: 0,0:08:38.43,0:08:39.72,CN（）,NTP,0000,0000,0000,,Қайта тексеру және бастапқы бақылау
Dialogue: 0,0:08:40.02,0:08:40.50,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:08:46.02,0:08:47.52,CN（）,NTP,0000,0000,0000,,Кетіңіз
Dialogue: 0,0:08:58.98,0:09:03.45,CN（）,NTP,0000,0000,0000,,Шақыру терезесі
Dialogue: 0,0:09:26.64,0:09:28.89,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:09:30.60,0:09:33.99,CN（）,NTP,0000,0000,0000,,Екі баланың қоспасы,менің сүйікті інілерім…
Dialogue: 0,0:09:34.50,0:09:37.08,CN（）,NTP,0000,0000,0000,,Инуяшако Нана ханью деп айқайлайтын жақсы сурет
Dialogue: 0,0:09:37.50,0:09:39.95,CN（）,NTP,0000,0000,0000,,?
Dialogue: 0,0:09:40.95,0:09:45.45,CN（）,NTP,0000,0000,0000,,Басқа адамдардан қайда қашу керек
Dialogue: 0,0:09:52.71,0:09:56.60,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:09:57.30,0:09:58.47,CN（）,NTP,0000,0000,0000,,Үй иесінің өлімі
Dialogue: 0,0:09:58.98,0:10:01.26,CN（）,NTP,0000,0000,0000,,Инуяшаның аты кім?
Dialogue: 0,0:10:03.09,0:10:07.02,CN（）,NTP,0000,0000,0000,,Талантты көргенде,Көрдім.
Dialogue: 0,0:10:07.77,0:10:09.48,CN（）,NTP,0000,0000,0000,,Инуяша Геге
Dialogue: 0,0:10:09.51,0:10:11.45,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:10:11.55,0:10:11.88,CN（）,NTP,0000,0000,0000,,тақырып
Dialogue: 0,0:10:15.96,0:10:18.03,CN（）,NTP,0000,0000,0000,,Гор
Dialogue: 0,0:10:18.03,0:10:18.66,CN（）,NTP,0000,0000,0000,,Бұл бала
Dialogue: 0,0:10:18.84,0:10:20.73,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:10:20.85,0:10:22.56,CN（）,NTP,0000,0000,0000,,Бұл жартылай жын
Dialogue: 0,0:10:22.74,0:10:24.09,CN（）,NTP,0000,0000,0000,,Оларды таба аламыз ба,Мелони?
Dialogue: 0,0:10:26.43,0:10:27.96,CN（）,NTP,0000,0000,0000,,Қажет емес
Dialogue: 0,0:10:28.53,0:10:30.30,CN（）,NTP,0000,0000,0000,,Инуяша Геге
Dialogue: 0,0:10:32.07,0:10:34.77,CN（）,NTP,0000,0000,0000,,Көмек сұраңыз.
Dialogue: 0,0:10:48.36,0:10:49.32,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:10:56.40,0:10:58.53,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:11:01.65,0:11:04.36,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:11:05.01,0:11:08.01,CN（）,NTP,0000,0000,0000,,Хорай аралы
Dialogue: 0,0:11:09.60,0:11:12.55,CN（）,NTP,0000,0000,0000,,Сен мені ауада көргің келе ме?
Dialogue: 0,0:11:12.84,0:11:14.53,CN（）,NTP,0000,0000,0000,,Ықтимал керек-жарақтар
Dialogue: 0,0:11:14.61,0:11:19.23,CN（）,NTP,0000,0000,0000,,Бұл Пэнлай аралының аралы.
Dialogue: 0,0:11:19.32,0:11:19.77,CN（）,NTP,0000,0000,0000,,?
Dialogue: 0,0:11:22.64,0:11:26.61,CN（）,NTP,0000,0000,0000,,Бұл аралдың он жыл сайын бірінші рет пайда болуы.
Dialogue: 0,0:11:29.55,0:11:33.06,CN（）,NTP,0000,0000,0000,,Мен өліп,мөрленгенге дейін болған оқиға.
Dialogue: 0,0:11:36.00,0:11:38.31,CN（）,NTP,0000,0000,0000,,Шынында да кіреберіс бар ма?
Dialogue: 0,0:11:41.56,0:11:44.30,CN（）,NTP,0000,0000,0000,,Сіз оны көре аласыз және бұл пайдалы болуы мүмкін
Dialogue: 0,0:11:47.43,0:11:47.88,CN（）,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:11:49.71,0:11:50.22,CN（）,NTP,0000,0000,0000,,Арал?
Dialogue: 0,0:12:03.36,0:12:03.90,CN（）,NTP,0000,0000,0000,,?
Dialogue: 0,0:12:05.61,0:12:09.43,CN（）,NTP,0000,0000,0000,,Мен Нариге келдім,мен жартылай жын кішкентай жынмын.
Dialogue: 0,0:12:10.77,0:12:12.08,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:12:12.53,0:12:14.28,CN（）,NTP,0000,0000,0000,,Өзін-өзі жариялаған Йокай тәрізді құбыжықтар,олар басқаларға ұқсайды және олар тікелей әсер етеді.
Dialogue: 0,0:12:14.96,0:12:17.35,CN（）,NTP,0000,0000,0000,,Тоқтату
Dialogue: 0,0:12:18.93,0:12:20.04,CN（）,NTP,0000,0000,0000,,Сіз бір адамсыз ба?
Dialogue: 0,0:12:20.28,0:12:21.60,CN（）,NTP,0000,0000,0000,,Тоичиши Инуяша
Dialogue: 0,0:12:28.71,0:12:29.28,CN（）,NTP,0000,0000,0000,,Инуяша
Dialogue: 0,0:12:30.90,0:12:32.06,CN（）,NTP,0000,0000,0000,,Қажетті басқа ақпарат
Dialogue: 0,0:12:32.37,0:12:33.96,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:12:36.66,0:12:37.83,CN（）,NTP,0000,0000,0000,,Сізге сәттілік
Dialogue: 0,0:12:42.93,0:12:43.44,CN（）,NTP,0000,0000,0000,,Қоңырау гүлі
Dialogue: 0,0:12:43.77,0:12:44.67,CN（）,NTP,0000,0000,0000,,Инуяша
Dialogue: 0,0:12:46.59,0:12:48.27,CN（）,NTP,0000,0000,0000,,Сангкон темір тырнақтары
Dialogue: 0,0:13:00.87,0:13:02.52,CN（）,NTP,0000,0000,0000,,Ұшатын жүздің қан тырнағы
Dialogue: 0,0:13:07.17,0:13:09.39,CN（）,NTP,0000,0000,0000,,Отбасында сорғалаған қан
Dialogue: 0,0:13:12.57,0:13:13.89,CN（）,NTP,0000,0000,0000,,Қоңырау гүлі
Dialogue: 0,0:13:28.55,0:13:30.03,CN（）,NTP,0000,0000,0000,,Сіз кімсіз?
Dialogue: 0,0:13:30.33,0:13:31.53,CN（）,NTP,0000,0000,0000,,Жартылай жын рухы
Dialogue: 0,0:13:33.09,0:13:34.26,CN（）,NTP,0000,0000,0000,,Қалпына келтіру және бүлікшіл мен
Dialogue: 0,0:13:38.04,0:13:38.79,CN（）,NTP,0000,0000,0000,,Инуяша
Dialogue: 0,0:13:39.96,0:13:40.56,CN（）,NTP,0000,0000,0000,,Не болды?
Dialogue: 0,0:13:41.61,0:13:43.26,CN（）,NTP,0000,0000,0000,,Сіз аралас жұмыртқасыз!
Dialogue: 0,0:13:44.34,0:13:49.38,CN（）,NTP,0000,0000,0000,,Сенің кішкентай өмірің кешкі кездесу - менің төрт жасар құдайым.
Dialogue: 0,0:13:52.05,0:13:53.58,CN（）,NTP,0000,0000,0000,,Бұл елдің контрбарлау қызметін талқандау оңай емес.
Dialogue: 0,0:13:56.91,0:13:57.57,CN（）,NTP,0000,0000,0000,,Инуяша
Dialogue: 0,0:13:57.66,0:13:59.43,CN（）,NTP,0000,0000,0000,,Басқалардан қашу
Dialogue: 0,0:14:01.65,0:14:03.18,CN（）,NTP,0000,0000,0000,,Кикио
Dialogue: 0,0:14:03.63,0:14:05.16,CN（）,NTP,0000,0000,0000,,Иә,түсіндім.
Dialogue: 0,0:14:06.21,0:14:07.50,CN（）,NTP,0000,0000,0000,,Инуяша Шима…
Dialogue: 0,0:14:10.62,0:14:11.64,CN（）,NTP,0000,0000,0000,,Ондық?
Dialogue: 0,0:14:14.67,0:14:16.41,CN（）,NTP,0000,0000,0000,,Арал жоғалып,арал жоғалды.
Dialogue: 0,0:14:18.03,0:14:19.53,CN（）,NTP,0000,0000,0000,,Мен Мурасатоға келдім
Dialogue: 0,0:14:21.66,0:14:24.10,CN（）,NTP,0000,0000,0000,,Келгеннен кейінгі қоңырау гүлі әңгімесі
Dialogue: 0,0:14:24.10,0:14:26.28,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:14:32.28,0:14:34.89,CN（）,NTP,0000,0000,0000,,Цинь әулетінің тарихы: ұзақ өмір және мәңгілік жастық
Dialogue: 0,0:14:34.92,0:14:37.92,CN（）,NTP,0000,0000,0000,,Тікелей Пэнлай аралында орналасқан
Dialogue: 0,0:14:38.70,0:14:40.92,CN（）,NTP,0000,0000,0000,,Ренва 50 жыл бұрын бір уақытта бір нүкте жоғалып кетті
Dialogue: 0,0:14:41.28,0:14:42.71,CN（）,NTP,0000,0000,0000,,Бұл да себеп.
Dialogue: 0,0:14:43.71,0:14:45.75,CN（）,NTP,0000,0000,0000,,Миссис
Dialogue: 0,0:14:51.18,0:14:51.85,CN（）,NTP,0000,0000,0000,,Инуяша
Dialogue: 0,0:14:52.02,0:14:52.86,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:14:57.66,0:14:58.71,CN（）,NTP,0000,0000,0000,,Айырбасталған жандар
Dialogue: 0,0:14:58.86,0:15:01.35,CN（）,NTP,0000,0000,0000,,Арқаңыз жарақат алды ма?
Dialogue: 0,0:15:01.47,0:15:03.78,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:15:04.08,0:15:06.36,CN（）,NTP,0000,0000,0000,,Мүмкін ақаулық
Dialogue: 0,0:15:05.44,0:15:07.60,NOTE（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:15:07.67,0:15:09.32,NOTE（）,NTP,0000,0000,0000,,Жиналыс ояту шағын
Dialogue: 0,0:15:07.26,0:15:08.85,CN（）,NTP,0000,0000,0000,,Қосымша ақпарат
Dialogue: 0,0:15:11.20,0:15:11.73,CN（）,NTP,0000,0000,0000,,Отыру
Dialogue: 0,0:15:17.04,0:15:19.86,CN（）,NTP,0000,0000,0000,,Бұл төрт жұлдыздың мөрі ме?
Dialogue: 0,0:15:19.98,0:15:22.23,CN（）,NTP,0000,0000,0000,,Маған жазсаңыз болады
Dialogue: 0,0:15:36.99,0:15:40.26,CN（）,NTP,0000,0000,0000,,Ауаның біртүрлі дәмі келді...
Dialogue: 0,0:15:45.18,0:15:46.69,CN（）,NTP,0000,0000,0000,,Нашу - Пэнлай аралы
Dialogue: 0,0:15:47.34,0:15:49.93,CN（）,NTP,0000,0000,0000,,Ұйқыңыз келе ме?
Dialogue: 0,0:15:50.45,0:15:52.21,CN（）,NTP,0000,0000,0000,,Нана Инуяша?
Dialogue: 0,0:15:52.71,0:15:54.46,CN（）,NTP,0000,0000,0000,,Баланы құтқару
Dialogue: 0,0:15:54.63,0:15:57.18,CN（）,NTP,0000,0000,0000,,Менің жоспарым – талантымды жоғалту.
Dialogue: 0,0:15:57.87,0:16:01.23,CN（）,NTP,0000,0000,0000,,Иә,менің арқамның жарақатына қатысты белгілі бір талап бар.
Dialogue: 0,0:16:02.76,0:16:03.48,CN（）,NTP,0000,0000,0000,,Қорытынды шешім
Dialogue: 0,0:16:10.32,0:16:12.60,CN（）,NTP,0000,0000,0000,,Бұл арал.
Dialogue: 0,0:16:16.02,0:16:20.00,CN（）,NTP,0000,0000,0000,,50 жыл бұрын
Dialogue: 0,0:16:20.07,0:16:24.89,CN（）,NTP,0000,0000,0000,,Вакидің Они аралында пайда болуы
Dialogue: 0,0:16:25.38,0:16:28.03,CN（）,NTP,0000,0000,0000,,Сол сәтте менің өмірімнің соңы келген еді
Dialogue: 0,0:16:28.60,0:16:33.57,CN（）,NTP,0000,0000,0000,,Наза Киношимаяның 50 жыл бұрын пайда болғаны есімде.
Dialogue: 0,0:16:34.04,0:16:38.91,CN（）,NTP,0000,0000,0000,,Осы ауылда көптеген ауыл тұрғындарының өлтірілуі
Dialogue: 0,0:16:40.20,0:16:44.22,CN（）,NTP,0000,0000,0000,,Онишиджожинвабакояшуяруфуджу
Dialogue: 0,0:16:45.33,0:16:47.68,CN（）,NTP,0000,0000,0000,,Сөзсіз қашу
Dialogue: 0,0:16:48.63,0:16:51.57,CN（）,NTP,0000,0000,0000,,Заңнан құтылу үшін болмашы айла
Dialogue: 0,0:16:53.22,0:16:54.12,CN（）,NTP,0000,0000,0000,,Қабылдау
Dialogue: 0,0:16:54.24,0:16:56.01,CN（）,NTP,0000,0000,0000,,Ғибадатхана қыз ересек Юури?
Dialogue: 0,0:16:56.61,0:16:57.57,CN（）,NTP,0000,0000,0000,,Барлық мәліметтер қалды
Dialogue: 0,0:16:58.26,0:16:58.89,CN（）,NTP,0000,0000,0000,,?
Dialogue: 0,0:17:11.32,0:17:13.28,CN（）,NTP,0000,0000,0000,,Теңіз желінің ойыны
Dialogue: 0,0:17:16.98,0:17:18.03,CN（）,NTP,0000,0000,0000,,Ересек Асуумару
Dialogue: 0,0:17:18.28,0:17:20.71,CN（）,NTP,0000,0000,0000,,Маған қайта жүгіру керек.
Dialogue: 0,0:17:21.36,0:17:26.40,CN（）,NTP,0000,0000,0000,,Мен не туралы айтып тұрғанымды толық түсінбеймін.
Dialogue: 0,0:17:26.91,0:17:27.92,CN（）,NTP,0000,0000,0000,,Зұлым ересек
Dialogue: 0,0:17:28.25,0:17:31.00,CN（）,NTP,0000,0000,0000,,Бұл тек ересектер үшін белгілі бір мөлшердегі мәселе
Dialogue: 0,0:17:31.32,0:17:33.45,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:17:33.78,0:17:35.07,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:17:35.10,0:17:37.17,CN（）,NTP,0000,0000,0000,,Ассумарудың ең түсінетіні – мен ересек адаммын.
Dialogue: 0,0:17:37.17,0:17:38.64,CN（）,NTP,0000,0000,0000,,Жақсы ауырсыну
Dialogue: 0,0:17:39.15,0:17:41.10,CN（）,NTP,0000,0000,0000,,Мен ересекпін
Dialogue: 0,0:17:41.43,0:17:44.28,CN（）,NTP,0000,0000,0000,,Сяо Лиңнің құрметтемеу сөздері туралы қауесет
Dialogue: 0,0:17:44.34,0:17:45.36,CN（）,NTP,0000,0000,0000,,Ол пайда болды ма?
Dialogue: 0,0:17:45.84,0:17:46.22,CN（）,NTP,0000,0000,0000,,?
Dialogue: 0,0:17:47.28,0:17:50.10,CN（）,NTP,0000,0000,0000,,Ересек адам ретінде пайда болды ма?
Dialogue: 0,0:17:57.99,0:17:59.28,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:18:00.81,0:18:02.04,CN（）,NTP,0000,0000,0000,,Нанжу - Хорай аралы
Dialogue: 0,0:18:02.55,0:18:05.82,CN（）,NTP,0000,0000,0000,,Аралды көргің келе ме?
Dialogue: 0,0:18:07.17,0:18:08.01,CN（）,NTP,0000,0000,0000,,Бөлек Хошо Кейдан
Dialogue: 0,0:18:11.55,0:18:14.40,CN（）,NTP,0000,0000,0000,,Аа, мұнда кел,мұнда кел.
Dialogue: 0,0:18:14.61,0:18:18.57,CN（）,NTP,0000,0000,0000,,Жолда жартылай жұмбақ баланы жіберу
Dialogue: 0,0:18:18.64,0:18:20.40,CN（）,NTP,0000,0000,0000,,Ақиқатты іздеу мүмкін емес.
Dialogue: 0,0:18:20.71,0:18:25.41,CN（）,NTP,0000,0000,0000,,?
Dialogue: 0,0:18:26.61,0:18:28.32,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:18:29.10,0:18:32.82,CN（）,NTP,0000,0000,0000,,Нана Дайге,құрметті қонақ
Dialogue: 0,0:18:47.16,0:18:52.77,CN（）,NTP,0000,0000,0000,,Мені құтқар және мені құтқар
Dialogue: 0,0:18:52.83,0:18:57.36,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:19:01.34,0:19:04.67,CN（）,NTP,0000,0000,0000,,Әскери қолбасшының киелі орны
Dialogue: 0,0:19:05.99,0:19:10.02,CN（）,NTP,0000,0000,0000,,Бұл жағдайда сіз тапсырманы орындадыңыз.
Dialogue: 0,0:19:21.48,0:19:23.00,CN（）,NTP,0000,0000,0000,,Жанып тұрған құс
Dialogue: 0,0:19:52.63,0:19:53.82,CN（）,NTP,0000,0000,0000,,Келу
Dialogue: 0,0:19:56.00,0:19:59.14,CN（）,NTP,0000,0000,0000,,Ол құпияны ашуды жоспарлап отыр
Dialogue: 0,0:19:59.34,0:20:01.00,CN（）,NTP,0000,0000,0000,,Ересек Асуумару
Dialogue: 0,0:20:16.25,0:20:20.85,CN（）,NTP,0000,0000,0000,,Біреумен кездесуге шақыру
Dialogue: 0,0:20:22.22,0:20:22.97,CN（）,NTP,0000,0000,0000,,Біз де жаман адамдармыз... бірақ есірткіден пайда табу... адамгершілік қағидаларына қайшы...
Dialogue: 0,0:20:25.33,0:20:29.49,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:20:32.41,0:20:34.19,CN（）,NTP,0000,0000,0000,,Юнму екінші ұшу
Dialogue: 0,0:20:39.67,0:20:42.60,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:20:43.01,0:20:44.74,CN（）,NTP,0000,0000,0000,,Қол жеткізуге болмайтын басқа жерлерге кіру
Dialogue: 0,0:20:45.02,0:20:46.53,CN（）,NTP,0000,0000,0000,,Мен басқа адамдарға,соның ішінде Инуяшаға және басқаларға жауаптымын.
Dialogue: 0,0:20:55.55,0:20:56.19,CN（）,NTP,0000,0000,0000,,Өлім оқиғасы
Dialogue: 0,0:20:56.45,0:20:56.84,CN（）,NTP,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:20:57.48,0:20:58.60,CN（）,NTP,0000,0000,0000,,Баяғыда кетті
Dialogue: 0,0:21:01.88,0:21:04.52,CN（）,NTP,0000,0000,0000,,Сенің осында екенің көрініп тұр.
Dialogue: 0,0:21:04.90,0:21:07.80,CN（）,NTP,0000,0000,0000,,Менің жолым осы уақытқа дейін жетті.
Dialogue: 0,0:21:08.65,0:21:10.77,CN（）,NTP,0000,0000,0000,,Қайта кездеспесеңіз,қайталап оқыңыз.
Dialogue: 0,0:21:12.76,0:21:15.86,CN（）,NTP,0000,0000,0000,,Жақсы жерде біреуді кездестіргенде
Dialogue: 0,0:21:22.61,0:21:26.13,CN（）,NTP,0000,0000,0000,,Ақшаға жақсы баға
Dialogue: 0,0:21:32.07,0:21:35.46,CN（）,NTP,0000,0000,0000,,Бұлай істеу мүмкін емес.
Dialogue: 0,0:21:36.03,0:21:36.62,CN（）,NTP,0000,0000,0000,,Инуяша
Dialogue: 0,0:21:37.04,0:21:38.07,CN（）,NTP,0000,0000,0000,,Бөлек ақыл
Dialogue: 0,0:21:38.77,0:21:39.57,CN（）,NTP,0000,0000,0000,,Шығу нүктесі
Dialogue: 0,0:21:40.53,0:21:42.02,CN（）,NTP,0000,0000,0000,,Желдің зақымдануы
Dialogue: 0,0:21:42.77,0:21:44.95,CN（）,NTP,0000,0000,0000,,Жердегі айдаһар жарысы
Dialogue: 0,0:21:47.71,0:21:48.20,CN（）,NTP,0000,0000,0000,,Ондық?
Dialogue: 0,0:21:48.95,0:21:51.54,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:22:02.03,0:22:03.89,CN（）,NTP,0000,0000,0000,,Сіз жалған дауыссыз.
Dialogue: 0,0:22:06.40,0:22:07.85,CN（）,NTP,0000,0000,0000,,Тендуру Джинрай
Dialogue: 0,0:22:23.20,0:22:24.39,CN（）,NTP,0000,0000,0000,,Инуяша
Dialogue: 0,0:22:30.68,0:22:33.93,CN（）,NTP,0000,0000,0000,,Жолың болсын,жолың болсын.
Dialogue: 0,0:22:34.76,0:22:36.16,CN（）,NTP,0000,0000,0000,,Екінші түсірілім аяқталды
Dialogue: 0,0:22:36.16,0:22:37.42,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:22:38.97,0:22:41.48,CN（）,NTP,0000,0000,0000,,Мен сені жеңу үшін келдім.
Dialogue: 0,0:22:44.09,0:22:46.65,CN（）,NTP,0000,0000,0000,,Өз ойларыңызды ұстану
Dialogue: 0,0:22:48.46,0:22:51.36,CN（）,NTP,0000,0000,0000,,Өз еркіңіз туралы не ойлайсыз
Dialogue: 0,0:22:51.90,0:22:54.46,CN（）,NTP,0000,0000,0000,,Мен одан әрі жетілдіру үшін осындамын.
Dialogue: 0,0:22:54.85,0:22:58.52,CN（）,NTP,0000,0000,0000,,Тағы бір арман әңгімесі осында.
Dialogue: 0,0:23:03.43,0:23:04.20,CN（）,NTP,0000,0000,0000,,Бұл елдің контрбарлау қызметін талқандау оңай емес.
Dialogue: 0,0:23:04.33,0:23:04.90,CN（）,NTP,0000,0000,0000,,Инуяша
Dialogue: 0,0:23:06.22,0:23:07.49,CN（）,NTP,0000,0000,0000,,Не болды? Инуяша
Dialogue: 0,0:23:09.22,0:23:09.92,CN（）,NTP,0000,0000,0000,,Инуяша
Dialogue: 0,0:23:11.08,0:23:12.09,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:23:13.59,0:23:15.02,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:23:15.77,0:23:17.92,CN（）,NTP,0000,0000,0000,,Иә! Жақсы тәжірибе және басқа тәжірибе
Dialogue: 0,0:23:18.32,0:23:20.53,CN（）,NTP,0000,0000,0000,,Насаикеяшу
Dialogue: 0,0:23:26.23,0:23:27.05,CN（）,NTP,0000,0000,0000,,Қызыл шайтанның жанкүйері
Dialogue: 0,0:23:33.54,0:23:34.42,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:23:49.78,0:23:51.35,CN（）,NTP,0000,0000,0000,,Фудо — ересек Шошумару
Dialogue: 0,0:24:06.38,0:24:07.43,CN（）,NTP,0000,0000,0000,,Фэнлонгба
Dialogue: 0,0:24:20.43,0:24:21.62,CN（）,NTP,0000,0000,0000,,Дрейф және дрейф
Dialogue: 0,0:24:22.37,0:24:25.01,CN（）,NTP,0000,0000,0000,,Келесі жолы Пэнлай аралында және қайта кездесу
Dialogue: 0,0:24:26.54,0:24:28.04,CN（）,NTP,0000,0000,0000,,Қосымша оқу
Dialogue: 0,0:24:29.02,0:24:31.34,CN（）,NTP,0000,0000,0000,,Таңдау бөлмесі
Dialogue: 0,0:24:32.71,0:24:36.05,CN（）,NTP,0000,0000,0000,,Төрт Тәңірдің мөрі тек сіз қатысуыңыз керек.
Dialogue: 0,0:24:51.48,0:24:52.96,CN（）,NTP,0000,0000,0000,,Ересек Асуумару
Dialogue: 0,0:25:02.50,0:25:04.46,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:25:04.60,0:25:06.14,CN（）,NTP,0000,0000,0000,,Бір ұпай айырмашылығы
Dialogue: 0,0:25:06.14,0:25:07.95,CN（）,NTP,0000,0000,0000,,Мұны естігенім үшін кешіріңіз.
Dialogue: 0,0:25:08.05,0:25:08.78,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:25:09.34,0:25:10.25,CN（）,NTP,0000,0000,0000,,Шошомару Ересек Эйкикай
Dialogue: 0,0:25:10.32,0:25:13.35,CN（）,NTP,0000,0000,0000,,Нақты көрінісі
Dialogue: 0,0:25:14.33,0:25:15.39,CN（）,NTP,0000,0000,0000,,Яғни,біздің ұйымға қосылғың келе ме?
Dialogue: 0,0:25:15.46,0:25:17.75,CN（）,NTP,0000,0000,0000,,Әңгіменің соңында
Dialogue: 0,0:25:17.78,0:25:19.57,CN（）,NTP,0000,0000,0000,,Талантты және әдейі абайсыз
Dialogue: 0,0:25:22.86,0:25:24.23,CN（）,NTP,0000,0000,0000,,Ересек Асуумару
Dialogue: 0,0:25:27.31,0:25:28.18,CN（）,NTP,0000,0000,0000,,Ересек Асуумару
Dialogue: 0,0:25:33.59,0:25:36.85,CN（）,NTP,0000,0000,0000,,Менің алдымда әкемнің қол астындағы қызметкері болдым.
Dialogue: 0,0:25:37.44,0:25:38.40,CN（）,NTP,0000,0000,0000,,Айқайлаған шайтан
Dialogue: 0,0:25:39.50,0:25:40.93,CN（）,NTP,0000,0000,0000,,Мен Читенмін
Dialogue: 0,0:25:42.12,0:25:43.67,CN（）,NTP,0000,0000,0000,,Әкесі қайтыс болды
Dialogue: 0,0:25:44.66,0:25:45.48,CN（）,NTP,0000,0000,0000,,Не болды?
Dialogue: 0,0:25:46.67,0:25:48.66,CN（）,NTP,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймын.
Dialogue: 0,0:25:49.59,0:25:50.42,CN（）,NTP,0000,0000,0000,,Бірінші сынып
Dialogue: 0,0:25:50.94,0:25:55.18,CN（）,NTP,0000,0000,0000,,Хорай аралының төрт құдайы
Dialogue: 0,0:25:55.69,0:25:57.68,CN（）,NTP,0000,0000,0000,,Бұл әкем мен әкемнің тілегі.
Dialogue: 0,0:26:00.81,0:26:01.95,CN（）,NTP,0000,0000,0000,,Иммерсивті қызығушылық
Dialogue: 0,0:26:02.39,0:26:03.27,CN（）,NTP,0000,0000,0000,,Ересек Асуумару
Dialogue: 0,0:26:03.37,0:26:04.25,CN（）,NTP,0000,0000,0000,,Ересек Асуумару
Dialogue: 0,0:26:09.47,0:26:10.77,CN（）,NTP,0000,0000,0000,,Бұйрықтар абсолютті
Dialogue: 0,0:26:15.31,0:26:17.05,CN（）,NTP,0000,0000,0000,,Ересек Шошумару,мен көзімді жұмбаймын
Dialogue: 0,0:26:18.44,0:26:20.07,CN（）,NTP,0000,0000,0000,,Фукуничику но Иэ-суке
Dialogue: 0,0:26:21.57,0:26:24.34,CN（）,NTP,0000,0000,0000,,Бұл мен алған жүлдем.
Dialogue: 0,0:26:29.58,0:26:31.60,CN（）,NTP,0000,0000,0000,,Адамның келуі
Dialogue: 0,0:26:34.99,0:26:40.00,CN（）,NTP,0000,0000,0000,,Сіз осындасыз,мен үлкен әпкеммін.
Dialogue: 0,0:26:40.34,0:26:43.34,CN（）,NTP,0000,0000,0000,,Сіз өзіңізді құдай дейсіз
Dialogue: 0,0:26:43.60,0:26:44.65,CN（）,NTP,0000,0000,0000,,Дұрыс және бұрыс
Dialogue: 0,0:26:45.67,0:26:46.52,CN（）,NTP,0000,0000,0000,,Күлкілі
Dialogue: 0,0:26:59.34,0:27:03.42,CN（）,NTP,0000,0000,0000,,Мұндай нәрсе қабілетсіз. Менің әкем өте дұрыс...
Dialogue: 0,0:27:03.84,0:27:06.81,CN（）,NTP,0000,0000,0000,,Бастауыш осы сияқты күшті.
Dialogue: 0,0:27:08.08,0:27:11.49,CN（）,NTP,0000,0000,0000,,Құдайдың қабілетін байқаудың қажеті жоқ.
Dialogue: 0,0:27:15.03,0:27:19.04,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:27:35.89,0:27:37.52,CN（）,NTP,0000,0000,0000,,…
Dialogue: 0,0:27:37.98,0:27:41.29,CN（）,NTP,0000,0000,0000,,Барсаң,қашып құтылатын таланты бар адамды жеңу керек.
Dialogue: 0,0:27:42.51,0:27:44.29,CN（）,NTP,0000,0000,0000,,Басқаша талап етілмейді
Dialogue: 0,0:27:44.55,0:27:47.37,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:27:47.63,0:27:50.03,CN（）,NTP,0000,0000,0000,,Сіз кенеттен не айттыңыз?
Dialogue: 0,0:27:50.29,0:27:52.33,CN（）,NTP,0000,0000,0000,,Мен капиталымнан айырылдым.
Dialogue: 0,0:28:04.97,0:28:08.28,CN（）,NTP,0000,0000,0000,,Заң қабылданған кезде
Dialogue: 0,0:28:29.50,0:28:30.62,CN（）,NTP,0000,0000,0000,,Жүгіру
Dialogue: 0,0:29:15.36,0:29:16.03,CN（）,NTP,0000,0000,0000,,Дұрыс
Dialogue: 0,0:29:16.81,0:29:18.07,CN（）,NTP,0000,0000,0000,,Қайтару келді
Dialogue: 0,0:29:18.96,0:29:20.30,CN（）,NTP,0000,0000,0000,,Инуяшая Казуя Заиичики
Dialogue: 0,0:29:20.84,0:29:21.93,CN（）,NTP,0000,0000,0000,,Тағы бір сапар аяқталды
Dialogue: 0,0:29:33.72,0:29:35.71,CN（）,NTP,0000,0000,0000,,Бастың басын алғаш көргенде
Dialogue: 0,0:29:37.65,0:29:40.36,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:29:44.00,0:29:56.70,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:29:57.58,0:30:11.01,CN（）,NTP,0000,0000,0000,,Ана мен ананың қолы – адамзат баласының қолы.
Dialogue: 0,0:30:12.26,0:30:19.88,CN（）,NTP,0000,0000,0000,,Екі қол бірге,ашық есік
Dialogue: 0,0:30:20.17,0:30:28.03,CN（）,NTP,0000,0000,0000,,Сіз болу кезінде
Dialogue: 0,0:30:29.97,0:30:52.64,CN（）,NTP,0000,0000,0000,,Аты-жөніңізді, балаларыңызды, балаларыңызды,балаларыңызды және т.б. өзгерттіңіз.
Dialogue: 0,0:30:56.70,0:30:57.70,CN（）,NTP,0000,0000,0000,,Міне,марапат ретінде сүйіс. Мwah.
Dialogue: 0,0:31:00.29,0:31:02.18,CN（）,NTP,0000,0000,0000,,Қайын апа
Dialogue: 0,0:31:02.18,0:31:02.72,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:31:03.31,0:31:03.73,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:31:06.65,0:31:08.30,CN（）,NTP,0000,0000,0000,,Міне,марапат ретінде сүйіс. Мwah.
Dialogue: 0,0:31:10.74,0:31:12.67,CN（）,NTP,0000,0000,0000,,Қайтып оралғыңыз келе ме?
Dialogue: 0,0:31:13.16,0:31:13.91,CN（）,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:31:14.43,0:31:16.03,CN（）,NTP,0000,0000,0000,,Бөлек құбыжық пен кішкентай жын
Dialogue: 0,0:31:18.57,0:31:20.01,CN（）,NTP,0000,0000,0000,,Инуяша
Dialogue: 0,0:31:20.63,0:31:23.06,CN（）,NTP,0000,0000,0000,,Қалғандарының бәрін құлатыңыз
Dialogue: 0,0:31:23.55,0:31:26.03,CN（）,NTP,0000,0000,0000,,Басқа сөздер: Төрт жұлдызды Құдайдың жасылын құлат
Dialogue: 0,0:31:26.53,0:31:28.67,CN（）,NTP,0000,0000,0000,,Осыдан елу жыл бұрын кішкентай жын туралы да әңгіме болған.
Dialogue: 0,0:31:28.82,0:31:31.67,CN（）,NTP,0000,0000,0000,,Ақыры қайтадан қашып құтылды
Dialogue: 0,0:31:32.19,0:31:33.25,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:31:36.05,0:31:39.74,CN（）,NTP,0000,0000,0000,,Инуяша кардиоторакальды стеноз
Dialogue: 0,0:31:40.07,0:31:41.55,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:31:41.60,0:31:42.27,CN（）,NTP,0000,0000,0000,,Мапо
Dialogue: 0,0:31:43.10,0:31:45.35,CN（）,NTP,0000,0000,0000,,Шион Сіз осындасыз ба?
Dialogue: 0,0:31:45.81,0:31:47.62,CN（）,NTP,0000,0000,0000,,Мен өз қызметімде жоқпын.
Dialogue: 0,0:31:48.11,0:31:50.02,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:31:50.39,0:31:52.09,CN（）,NTP,0000,0000,0000,,Мүмкін болса...
Dialogue: 0,0:31:52.71,0:31:55.61,CN（）,NTP,0000,0000,0000,,Инуяша Гор,мені аралға сапарға шығарып салшы.
Dialogue: 0,0:31:56.38,0:31:59.38,CN（）,NTP,0000,0000,0000,,Төрт жұлдыздың мөрі
Dialogue: 0,0:31:59.46,0:32:00.21,CN（）,NTP,0000,0000,0000,,Қашу тәрізді
Dialogue: 0,0:32:00.68,0:32:03.22,CN（）,NTP,0000,0000,0000,,Сіздің атыңыз кім?
Dialogue: 0,0:32:03.70,0:32:04.45,CN（）,NTP,0000,0000,0000,,Міне,осы.
Dialogue: 0,0:32:07.27,0:32:08.69,CN（）,NTP,0000,0000,0000,,Тек қажетті мөр
Dialogue: 0,0:32:09.23,0:32:12.23,CN（）,NTP,0000,0000,0000,,Маған елден шығуға рұқсат жоқ.
Dialogue: 0,0:32:12.77,0:32:14.14,CN（）,NTP,0000,0000,0000,,Мэн сары кітапшасы
Dialogue: 0,0:32:15.00,0:32:17.17,CN（）,NTP,0000,0000,0000,,Инуяша кетпей ме?
Dialogue: 0,0:32:17.48,0:32:17.89,CN（）,NTP,0000,0000,0000,,?
Dialogue: 0,0:32:18.69,0:32:21.59,CN（）,NTP,0000,0000,0000,,Инуяшаның жоғарғы арқасы және оның гомологиялық тыртықтары
Dialogue: 0,0:32:22.18,0:32:22.98,CN（）,NTP,0000,0000,0000,,Бұл тұрарлық емес.
Dialogue: 0,0:32:23.32,0:32:24.74,CN（）,NTP,0000,0000,0000,,Мұнда келіп бізді құтқарма.
Dialogue: 0,0:32:25.05,0:32:27.12,CN（）,NTP,0000,0000,0000,,Сондықтан гравюра шақырылады.
Dialogue: 0,0:32:27.56,0:32:28.28,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:32:28.34,0:32:28.77,title（）,NTP,0000,0000,0000,,Өлтірілді
Dialogue: 0,0:32:28.54,0:32:29.08,CN（）,NTP,0000,0000,0000,,Ауырсыну сияқты
Dialogue: 0,0:32:29.55,0:32:32.34,CN（）,NTP,0000,0000,0000,,Өзіңізге қамқорлық жасағыңыз келе ме?
Dialogue: 0,0:32:32.70,0:32:36.63,CN（）,NTP,0000,0000,0000,,Толық ақпаратты тағы хабарлаймын...
Dialogue: 0,0:32:37.31,0:32:38.83,CN（）,NTP,0000,0000,0000,,Бұл Асаги апа
Dialogue: 0,0:32:41.00,0:32:41.67,CN（）,NTP,0000,0000,0000,,Асаги
Dialogue: 0,0:32:45.34,0:32:48.37,CN（）,NTP,0000,0000,0000,,Аралдағымен бір уақытта
Dialogue: 0,0:32:48.94,0:32:51.02,CN（）,NTP,0000,0000,0000,,Демек,талантсыз бала заңнан қашады
Dialogue: 0,0:32:51.45,0:32:52.64,CN（）,NTP,0000,0000,0000,,Ваказережоко Инуяша
Dialogue: 0,0:32:53.00,0:32:55.28,CN（）,NTP,0000,0000,0000,,Сіздің әлеміңіздің бастауы неде?
Dialogue: 0,0:32:56.69,0:32:58.53,CN（）,NTP,0000,0000,0000,,Нанамотоның келмеуі
Dialogue: 0,0:32:59.41,0:33:01.45,CN（）,NTP,0000,0000,0000,,Иә,Инуяша Геге және басқалар...
Dialogue: 0,0:33:01.50,0:33:02.67,CN（）,NTP,0000,0000,0000,,Оны қайта оқудың қажеті жоқ
Dialogue: 0,0:33:03.04,0:33:05.30,CN（）,NTP,0000,0000,0000,,Нәтижесінде «Қаһарлы төрт жұлдыз» хикаясы
Dialogue: 0,0:33:05.59,0:33:07.27,CN（）,NTP,0000,0000,0000,,Қалада өлтірілгенде
Dialogue: 0,0:33:21.35,0:33:22.70,CN（）,NTP,0000,0000,0000,,Асаги апа
Dialogue: 0,0:33:25.13,0:33:27.14,CN（）,NTP,0000,0000,0000,,Қазандағы дауыс қозғалысы
Dialogue: 0,0:33:28.12,0:33:29.32,CN（）,NTP,0000,0000,0000,,Қозғалатын қазан?
Dialogue: 0,0:33:30.63,0:33:31.49,CN（）,NTP,0000,0000,0000,,Мен жүгіруді аяқтадым
Dialogue: 0,0:33:32.00,0:33:33.20,CN（）,NTP,0000,0000,0000,,Жүгіру?Канари?
Dialogue: 0,0:33:33.68,0:33:35.29,CN（）,NTP,0000,0000,0000,,Қатысқандардың барлығына жауапкершілік жоқ
Dialogue: 0,0:33:35.73,0:33:36.89,CN（）,NTP,0000,0000,0000,,Қайта басқарудың қажеті жоқ
Dialogue: 0,0:33:37.43,0:33:38.18,CN（）,NTP,0000,0000,0000,,Сіз...
Dialogue: 0,0:33:38.73,0:33:42.06,CN（）,NTP,0000,0000,0000,,Аралас жұмыртқалар
Dialogue: 0,0:33:42.42,0:33:43.74,CN（）,NTP,0000,0000,0000,,Инуяша отыр
Dialogue: 0,0:33:45.03,0:33:46.69,CN（）,NTP,0000,0000,0000,,Сіздің балаларыңыз бар ма?
Dialogue: 0,0:33:46.79,0:33:48.21,CN（）,NTP,0000,0000,0000,,Рас...шынайы зиян
Dialogue: 0,0:33:53.07,0:33:54.86,CN（）,NTP,0000,0000,0000,,т.б.Асағи апа
Dialogue: 0,0:33:55.42,0:33:58.09,CN（）,NTP,0000,0000,0000,,Бұл студент өмірінің соңғы нәтижесі ме?
Dialogue: 0,0:33:58.55,0:33:59.56,CN（）,NTP,0000,0000,0000,,Мен де жүгіріп жүрмін
Dialogue: 0,0:34:00.80,0:34:01.76,CN（）,NTP,0000,0000,0000,,Shippo іске қосу керек
Dialogue: 0,0:34:02.59,0:34:03.18,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:34:04.86,0:34:08.43,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:34:16.21,0:34:19.23,CN（）,NTP,0000,0000,0000,,Аралда басқа адамдар тұрады ма?
Dialogue: 0,0:34:19.70,0:34:20.97,CN（）,NTP,0000,0000,0000,,Мен ғана
Dialogue: 0,0:34:21.38,0:34:23.21,CN（）,NTP,0000,0000,0000,,Бұрын көптеген адамдар белгілі
Dialogue: 0,0:34:23.46,0:34:25.10,CN（）,NTP,0000,0000,0000,,Алайда үй иесі қайтыс болды.
Dialogue: 0,0:34:26.52,0:34:28.46,CN（）,NTP,0000,0000,0000,,Талантты әнші шынайы трагедия
Dialogue: 0,0:34:29.10,0:34:30.10,CN（）,NTP,0000,0000,0000,,Әннің аты қалай?
Dialogue: 0,0:34:30.61,0:34:32.21,CN（）,NTP,0000,0000,0000,,Айыру жыры
Dialogue: 0,0:34:32.60,0:34:35.83,CN（）,NTP,0000,0000,0000,,Ән бастапқыда жазылған.
Dialogue: 0,0:34:36.24,0:34:37.02,CN（）,NTP,0000,0000,0000,,Канаджи?
Dialogue: 0,0:34:37.41,0:34:38.95,CN（）,NTP,0000,0000,0000,,Ол – әулие қыз.
Dialogue: 0,0:34:39.58,0:34:42.06,CN（）,NTP,0000,0000,0000,,Менің ойым мен әдемі әйелмін.
Dialogue: 0,0:34:44.72,0:34:46.40,CN（）,NTP,0000,0000,0000,,Канад ханым жоқ.
Dialogue: 0,0:34:46.99,0:34:49.22,CN（）,NTP,0000,0000,0000,,Юва Шитожин шайқасының өлімі
Dialogue: 0,0:34:49.65,0:34:53.23,CN（）,NTP,0000,0000,0000,,Қазіргі уақытта бұл төрт жұлдызды құдайларға арналған сыйлық.
Dialogue: 0,0:34:53.36,0:34:55.50,CN（）,NTP,0000,0000,0000,,Шион
Dialogue: 0,0:34:59.28,0:35:01.46,CN（）,NTP,0000,0000,0000,,Тірі ұсыныстар ойыншық ретінде пайдаланылуы мүмкін немесе пайдаланылмауы мүмкін.
Dialogue: 0,0:35:01.83,0:35:03.54,CN（）,NTP,0000,0000,0000,,Мо Фэй Сіз өлім туралы ойладыңыз ба?
Dialogue: 0,0:35:08.92,0:35:09.69,CN（）,NTP,0000,0000,0000,,Асаги
Dialogue: 0,0:35:20.76,0:35:21.45,CN（）,NTP,0000,0000,0000,,Асаги?
Dialogue: 0,0:35:23.47,0:35:26.60,CN（）,NTP,0000,0000,0000,,Ұзақ уақыттан кейін мен ойымды өзгерттім.
Dialogue: 0,0:35:27.43,0:35:28.07,CN（）,NTP,0000,0000,0000,,Хризантема жәндігі?
Dialogue: 0,0:35:28.72,0:35:33.53,CN（）,NTP,0000,0000,0000,,Кішкентай бөренелердің бәрі секіріп, қозғалады,ал ауыл тұрғындарының жаны өледі
Dialogue: 0,0:35:34.31,0:35:36.29,CN（）,NTP,0000,0000,0000,,Бұл менің әкем.
Dialogue: 0,0:35:36.50,0:35:38.49,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:35:39.76,0:35:42.99,CN（）,NTP,0000,0000,0000,,Үй иесі қамқоршының атын өзгертті.
Dialogue: 0,0:35:43.82,0:35:45.79,CN（）,NTP,0000,0000,0000,,Осының арқасында мен жалғыз емеспін.
Dialogue: 0,0:35:47.77,0:35:50.25,CN（）,NTP,0000,0000,0000,,Өмірін өзгертетін кішкентай балаларды қорғау да маңызды.
Dialogue: 0,0:35:51.03,0:35:54.03,CN（）,NTP,0000,0000,0000,,Осыған байланысты
Dialogue: 0,0:35:55.63,0:35:56.40,CN（）,NTP,0000,0000,0000,,Асаги
Dialogue: 0,0:35:57.59,0:35:59.61,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:36:11.60,0:36:13.88,CN（）,NTP,0000,0000,0000,,Түпнұсқа көшірменің түпнұсқасы
Dialogue: 0,0:36:14.27,0:36:18.53,CN（）,NTP,0000,0000,0000,,Бұл аймақта құбыжықтар және жартылай юкай балалары бар адамдар бар.
Dialogue: 0,0:36:18.71,0:36:20.47,CN（）,NTP,0000,0000,0000,,Бұл төтенше құдайдың шығысы мен батысы.
Dialogue: 0,0:36:21.17,0:36:24.01,CN（）,NTP,0000,0000,0000,,Дегенмен,бұл төрт жұлдызды құдай.
Dialogue: 0,0:36:24.96,0:36:27.94,CN（）,NTP,0000,0000,0000,,Шитогамидің динамикалық қазанды пайдалануы
Dialogue: 0,0:36:28.46,0:36:30.76,CN（）,NTP,0000,0000,0000,,Менің кішкентай жартылай жұмбақ қашу қабілетім
Dialogue: 0,0:36:31.33,0:36:32.98,CN（）,NTP,0000,0000,0000,,Сиқырлы күшке ие болды
Dialogue: 0,0:36:33.78,0:36:35.70,CN（）,NTP,0000,0000,0000,,Бірнеше сәтті сыйлықтар бар
Dialogue: 0,0:36:36.50,0:36:40.01,CN（）,NTP,0000,0000,0000,,Әрбір 50 жыл сайын сыртқы әлеммен байланыс уақыты
Dialogue: 0,0:36:40.22,0:36:41.62,CN（）,NTP,0000,0000,0000,,Қаманшұқайға арналған сөз тартулары
Dialogue: 0,0:36:43.45,0:36:46.48,CN（）,NTP,0000,0000,0000,,Асаги не - патшайым
Dialogue: 0,0:36:52.19,0:36:53.25,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:36:53.90,0:36:56.02,CN（）,NTP,0000,0000,0000,,Мейірімсіздік сезімі
Dialogue: 0,0:37:10.62,0:37:12.12,CN（）,NTP,0000,0000,0000,,Дыбыс қозғалады ма?
Dialogue: 0,0:37:12.74,0:37:15.07,CN（）,NTP,0000,0000,0000,,Әрине өте жағымсыз сезім
Dialogue: 0,0:37:15.27,0:37:17.73,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:37:18.53,0:37:21.63,CN（）,NTP,0000,0000,0000,,Үй иесі қайта қарады
Dialogue: 0,0:37:22.23,0:37:23.52,CN（）,NTP,0000,0000,0000,,Басқа тараптармен татуласу
Dialogue: 0,0:37:23.83,0:37:26.42,CN（）,NTP,0000,0000,0000,,Асаги нее га фусусюшу
Dialogue: 0,0:37:28.66,0:37:31.56,CN（）,NTP,0000,0000,0000,,Трансформациядан кейін Ясуке Вакай шебер болды.
Dialogue: 0,0:37:32.23,0:37:33.45,CN（）,NTP,0000,0000,0000,,Тікелей өкіл
Dialogue: 0,0:37:33.68,0:37:35.39,CN（）,NTP,0000,0000,0000,,Заңның әзірленгенін де растайды.
Dialogue: 0,0:37:35.62,0:37:36.70,CN（）,NTP,0000,0000,0000,,Жалға берушінің бастапқы идеясы
Dialogue: 0,0:37:37.45,0:37:39.60,CN（）,NTP,0000,0000,0000,,Мен белгілі бір жиналыста бос емеспін.
Dialogue: 0,0:37:39.88,0:37:42.03,CN（）,NTP,0000,0000,0000,,Асаги апа және т.б
Dialogue: 0,0:37:43.84,0:37:46.17,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:37:47.17,0:37:47.74,CN（）,NTP,0000,0000,0000,,Бұл рөл де біраз қиын екен…
Dialogue: 0,0:37:48.52,0:37:49.81,CN（）,NTP,0000,0000,0000,,Жеке өсу ұсынысының тарихы
Dialogue: 0,0:37:50.20,0:37:52.47,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:37:53.43,0:37:56.07,CN（）,NTP,0000,0000,0000,,Бұл тұрарлық емес,бірақ оған тұрарлық емес.
Dialogue: 0,0:38:16.18,0:38:17.47,CN（）,NTP,0000,0000,0000,,Қажетсіз ақсау
Dialogue: 0,0:38:17.83,0:38:19.10,CN（）,NTP,0000,0000,0000,,Әрекет етпеңіз
Dialogue: 0,0:38:19.38,0:38:21.17,CN（）,NTP,0000,0000,0000,,Белгісіз көздерді жою
Dialogue: 0,0:38:21.24,0:38:23.31,CN（）,NTP,0000,0000,0000,,Мен кеткен жоқпын
Dialogue: 0,0:38:47.51,0:38:49.01,CN（）,NTP,0000,0000,0000,,Зиянды әңгіменің алыс нүктесі
Dialogue: 0,0:38:49.89,0:38:52.06,CN（）,NTP,0000,0000,0000,,Sumite Қажет емес бірнеше құбыр мәселелері
Dialogue: 0,0:38:53.27,0:38:55.13,CN（）,NTP,0000,0000,0000,,Желдің зақымдануы
Dialogue: 0,0:38:58.29,0:38:58.66,CN（）,NTP,0000,0000,0000,,Бізге асығыс керек.
Dialogue: 0,0:38:58.75,0:38:59.58,CN（）,NTP,0000,0000,0000,,Қонақ бөлмеге айқайлаңыз
Dialogue: 0,0:38:59.97,0:39:02.53,CN（）,NTP,0000,0000,0000,,Сыйлық ретінде менің жеке өзгерісім туралы оқиға.
Dialogue: 0,0:39:02.99,0:39:03.85,CN（）,NTP,0000,0000,0000,,Ай! Бір минут,мына жаққа…
Dialogue: 0,0:39:04.36,0:39:06.28,CN（）,NTP,0000,0000,0000,,Өлімді бөлек қарастырайық
Dialogue: 0,0:39:09.17,0:39:09.87,CN（）,NTP,0000,0000,0000,,Инуяша
Dialogue: 0,0:39:09.43,0:39:10.41,CN（）,NTP,0000,0000,0000,,Асаги апа
Dialogue: 0,0:39:32.33,0:39:33.08,CN（）,NTP,0000,0000,0000,,Тұрғылықты жері
Dialogue: 0,0:39:33.62,0:39:35.02,CN（）,NTP,0000,0000,0000,,Менің өлі денем
Dialogue: 0,0:39:35.31,0:39:36.83,CN（）,NTP,0000,0000,0000,,Қажетсіз сәулелену
Dialogue: 0,0:39:38.74,0:39:39.29,CN（）,NTP,0000,0000,0000,,Бұл елдің контрбарлау қызметін талқандау оңай емес.
Dialogue: 0,0:40:01.36,0:40:01.72,CN（）,NTP,0000,0000,0000,,Ондық?
Dialogue: 0,0:40:08.01,0:40:08.91,CN（）,NTP,0000,0000,0000,,Асаги
Dialogue: 0,0:40:09.74,0:40:11.13,CN（）,NTP,0000,0000,0000,,Рұқсатсыз босату
Dialogue: 0,0:40:15.99,0:40:17.36,CN（）,NTP,0000,0000,0000,,Біз де жаман адамдармыз... бірақ есірткіден пайда табу... адамгершілік қағидаларына қайшы...
Dialogue: 0,0:40:18.17,0:40:19.20,CN（）,NTP,0000,0000,0000,,Асаги апа
Dialogue: 0,0:40:41.04,0:40:43.16,CN（）,NTP,0000,0000,0000,,Иттің өмірі осында.
Dialogue: 0,0:40:43.21,0:40:44.32,CN（）,NTP,0000,0000,0000,,Малды құрбандыққа шалу
Dialogue: 0,0:40:44.78,0:40:47.28,CN（）,NTP,0000,0000,0000,,Жағдайға байланысты мүмкін,...
Dialogue: 0,0:40:47.58,0:40:49.62,CN（）,NTP,0000,0000,0000,,Бес жартылай жын бала
Dialogue: 0,0:40:50.31,0:40:53.17,CN（）,NTP,0000,0000,0000,,Фестивальге қатысқан барлық басқа адамдардың алдында
Dialogue: 0,0:40:53.22,0:40:55.42,CN（）,NTP,0000,0000,0000,,Тапсырыс шынайы құзыреттілікпен қайтарылуы керек екені күмәнсіз.
Dialogue: 0,0:40:56.47,0:40:59.32,CN（）,NTP,0000,0000,0000,,Талантты қыз болсаң,...
Dialogue: 0,0:41:02.60,0:41:04.08,CN（）,NTP,0000,0000,0000,,Асаги шәйнекпен жабылған.
Dialogue: 0,0:41:04.33,0:41:05.50,CN（）,NTP,0000,0000,0000,,Сәттілік
Dialogue: 0,0:41:05.76,0:41:08.62,CN（）,NTP,0000,0000,0000,,Алайда бұл Асагидің өлімі.
Dialogue: 0,0:41:08.81,0:41:10.28,CN（）,NTP,0000,0000,0000,,Киімді қалай кию керек?
Dialogue: 0,0:41:13.25,0:41:14.75,CN（）,NTP,0000,0000,0000,,Тәртіпсіздік
Dialogue: 0,0:41:15.10,0:41:17.23,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:41:18.27,0:41:19.39,CN（）,NTP,0000,0000,0000,,Оны мына жерден оқи аласыз
Dialogue: 0,0:41:23.31,0:41:25.25,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:41:25.53,0:41:28.27,CN（）,NTP,0000,0000,0000,,Өлген адам кеткен қазан
Dialogue: 0,0:41:28.66,0:41:30.34,CN（）,NTP,0000,0000,0000,,Өлгеннен кейін екі адам қайтыс болды
Dialogue: 0,0:41:30.52,0:41:32.02,CN（）,NTP,0000,0000,0000,,Рұқсатсыз босату
Dialogue: 0,0:41:32.12,0:41:33.70,CN（）,NTP,0000,0000,0000,,Бекітуші болмыс немесе әрекет
Dialogue: 0,0:41:39.67,0:41:42.70,CN（）,NTP,0000,0000,0000,,Бұл ешқандай мәліметтерді қамтымайды.
Dialogue: 0,0:41:43.37,0:41:47.22,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:41:47.87,0:41:51.80,CN（）,NTP,0000,0000,0000,,Ана мен ананың алақаны – адам дамуының қолы.
Dialogue: 0,0:41:53.68,0:41:54.74,CN（）,NTP,0000,0000,0000,,Талантты әндер
Dialogue: 0,0:41:54.95,0:41:58.59,CN（）,NTP,0000,0000,0000,,Бұл ескі ауыл әні.
Dialogue: 0,0:41:59.06,0:42:01.81,CN（）,NTP,0000,0000,0000,,Сіз қолыңызды қалай қорғау керектігін білесіз бе?
Dialogue: 0,0:42:02.50,0:42:04.59,CN（）,NTP,0000,0000,0000,,Аффирмация сол жақ оң қол
Dialogue: 0,0:42:04.64,0:42:06.48,CN（）,NTP,0000,0000,0000,,Ел астанасы Ширазумиге саяхат
Dialogue: 0,0:42:07.05,0:42:09.19,CN（）,NTP,0000,0000,0000,,Балаңызды тәрбиелеу дұрыс па?
Dialogue: 0,0:42:09.53,0:42:10.61,CN（）,NTP,0000,0000,0000,,Оң қол
Dialogue: 0,0:42:11.00,0:42:11.96,CN（）,NTP,0000,0000,0000,,Накуби Утаға келгенде солай ма?
Dialogue: 0,0:42:13.30,0:42:15.42,CN（）,NTP,0000,0000,0000,,Екі қол бірге,ашық есік
Dialogue: 0,0:42:15.89,0:42:17.65,CN（）,NTP,0000,0000,0000,,Сіз болу кезінде
Dialogue: 0,0:42:18.32,0:42:20.93,CN（）,NTP,0000,0000,0000,,Балаларды өзгертіп,қорғайсың.
Dialogue: 0,0:42:22.20,0:42:24.57,CN（）,NTP,0000,0000,0000,,Екі қол бірге Қақпаның есігін ашыңыз
Dialogue: 0,0:42:25.40,0:42:27.42,CN（）,NTP,0000,0000,0000,,Ересек заңгер де түсініктеме ретінде қызмет етеді
Dialogue: 0,0:42:29.59,0:42:32.89,CN（）,NTP,0000,0000,0000,,Йокайдың сол қолы Жапон адамның оң қолы біріктіріледі
Dialogue: 0,0:42:32.96,0:42:33.82,CN（）,NTP,0000,0000,0000,,Есікті ашу
Dialogue: 0,0:42:43.16,0:42:44.58,CN（）,NTP,0000,0000,0000,,Бұл дұрыс емес әрекет.
Dialogue: 0,0:42:44.81,0:42:46.08,CN（）,NTP,0000,0000,0000,,Ақ үміттердің көрінісі
Dialogue: 0,0:42:46.60,0:42:47.89,CN（）,NTP,0000,0000,0000,,Екі қол бірге,бір бастау
Dialogue: 0,0:42:48.10,0:42:49.03,CN（）,NTP,0000,0000,0000,,Бұл сөзсіз менің ниетім.
Dialogue: 0,0:42:52.80,0:42:53.65,CN（）,NTP,0000,0000,0000,,Біз де жаман адамдармыз... бірақ есірткіден пайда табу... адамгершілік қағидаларына қайшы...
Dialogue: 0,0:42:54.40,0:42:55.23,CN（）,NTP,0000,0000,0000,,кекештенетін улы жәндік
Dialogue: 0,0:43:09.53,0:43:12.53,CN（）,NTP,0000,0000,0000,,Толтыруға болады
Dialogue: 0,0:43:14.18,0:43:16.02,CN（）,NTP,0000,0000,0000,,Шығу аяқталды ма?
Dialogue: 0,0:43:16.69,0:43:19.21,CN（）,NTP,0000,0000,0000,,Нокатсуға келу қашықтығы
Dialogue: 0,0:43:19.89,0:43:21.46,CN（）,NTP,0000,0000,0000,,Сіз жартылай жынсыз
Dialogue: 0,0:43:22.09,0:43:24.78,CN（）,NTP,0000,0000,0000,,Денең қызылға оранып,от күлге айналады.
Dialogue: 0,0:43:25.61,0:43:28.60,CN（）,NTP,0000,0000,0000,,Мұның себебі мен өрт тінтуірін жүргізуім керек.
Dialogue: 0,0:43:28.99,0:43:30.08,CN（）,NTP,0000,0000,0000,,Сіз тағы кімсіз?
Dialogue: 0,0:43:31.06,0:43:32.07,CN（）,NTP,0000,0000,0000,,Накуя Коресу
Dialogue: 0,0:43:32.87,0:43:34.47,CN（）,NTP,0000,0000,0000,,Хорай аралының ғибадатхана қызы
Dialogue: 0,0:43:35.43,0:43:39.57,CN（）,NTP,0000,0000,0000,,Сіз аралдасыз ба?
Dialogue: 0,0:43:41.50,0:43:42.72,CN（）,NTP,0000,0000,0000,,Жел тесігі
Dialogue: 0,0:43:47.24,0:43:49.78,CN（）,NTP,0000,0000,0000,,Ересек заңгер,бұл улы жәндіктерді қажетсіз зерттеу.
Dialogue: 0,0:43:58.57,0:44:01.28,CN（）,NTP,0000,0000,0000,,Улы жәндіктерді ұнатасың ба?
Dialogue: 0,0:44:01.33,0:44:03.40,CN（）,NTP,0000,0000,0000,,Таңдамалы емес әңгіме...
Dialogue: 0,0:44:03.53,0:44:06.22,CN（）,NTP,0000,0000,0000,,Шығыс пен Батысқа қандай қару қалдырдым?
Dialogue: 0,0:44:06.27,0:44:06.84,CN（）,NTP,0000,0000,0000,,Міне,марапат ретінде сүйіс. Мwah.
Dialogue: 0,0:44:06.89,0:44:07.59,CN（）,NTP,0000,0000,0000,,Моеги
Dialogue: 0,0:44:08.65,0:44:10.84,CN（）,NTP,0000,0000,0000,,Өлім туралы заң қабылданды.
Dialogue: 0,0:44:11.27,0:44:12.01,CN（）,NTP,0000,0000,0000,,Эй,бұл поезд қашан жүреді?
Dialogue: 0,0:44:14.85,0:44:17.46,CN（）,NTP,0000,0000,0000,,Жақсы мен түлкі құбыжықпын
Dialogue: 0,0:44:17.85,0:44:19.32,CN（）,NTP,0000,0000,0000,,Шиппо Кайкан
Dialogue: 0,0:44:21.96,0:44:24.31,CN（）,NTP,0000,0000,0000,,Рұқсат етілмеген адамның тұруы және кетуі
Dialogue: 0,0:44:24.54,0:44:26.48,CN（）,NTP,0000,0000,0000,,Бұл сенің туған жерің емес.
Dialogue: 0,0:44:27.62,0:44:31.01,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:44:31.47,0:44:33.39,CN（）,NTP,0000,0000,0000,,Жоғарғы бет
Dialogue: 0,0:44:35.27,0:44:38.68,CN（）,NTP,0000,0000,0000,,Әннің сыры осы жерден ашылады.
Dialogue: 0,0:44:41.85,0:44:43.01,CN（）,NTP,0000,0000,0000,,Ику алдында
Dialogue: 0,0:44:43.41,0:44:47.69,CN（）,NTP,0000,0000,0000,,Бұл Пэнлай аралы,құбыжықтар мен адамдар қатар өмір сүретін жер.
Dialogue: 0,0:44:48.40,0:44:50.65,CN（）,NTP,0000,0000,0000,,Жартылай жас баланың дүниеге келуі аяқталды.
Dialogue: 0,0:44:50.98,0:44:52.60,CN（）,NTP,0000,0000,0000,,Оятованың өзара өтемақысы
Dialogue: 0,0:44:53.94,0:44:57.14,CN（）,NTP,0000,0000,0000,,Дегенмен,бұл жартылай жындар класы.
Dialogue: 0,0:44:57.46,0:44:59.02,CN（）,NTP,0000,0000,0000,,Сондай-ақ құбыжықтарды алып тастау
Dialogue: 0,0:44:59.88,0:45:03.00,CN（）,NTP,0000,0000,0000,,Бұл аралдан тыс жерде өмір сүру өте ауыр.
Dialogue: 0,0:45:04.09,0:45:07.15,CN（）,NTP,0000,0000,0000,,Біз сізге балаңыздың келуіне тұрақты кепілдік береміз.
Dialogue: 0,0:45:07.63,0:45:09.83,CN（）,NTP,0000,0000,0000,,Сыртқы дүниеден бөлінудің ашылуы
Dialogue: 0,0:45:11.17,0:45:12.67,CN（）,NTP,0000,0000,0000,,Дегенмен,бұл алғашқы 50 жыл.
Dialogue: 0,0:45:13.14,0:45:15.17,CN（）,NTP,0000,0000,0000,,Ақыр аяғында дүние әлсіз.
Dialogue: 0,0:45:15.53,0:45:17.55,CN（）,NTP,0000,0000,0000,,Құбыжықтар қоғамы
Dialogue: 0,0:45:19.13,0:45:20.67,CN（）,NTP,0000,0000,0000,,Шитоджиннің басшысы Тукичи
Dialogue: 0,0:45:24.22,0:45:25.84,CN（）,NTP,0000,0000,0000,,Әр түрлі уақыттағы қан айналымы
Dialogue: 0,0:45:28.15,0:45:32.59,CN（）,NTP,0000,0000,0000,,Мен күрескендіктен,бірақ өзімнің өмірлік жұмысымды өзгерту мүмкіндігіне ие болдым.
Dialogue: 0,0:45:32.78,0:45:35.03,CN（）,NTP,0000,0000,0000,,Жалпы күш-қуат бастауының мөрі қозғалыс қазанында.
Dialogue: 0,0:45:36.97,0:45:40.22,CN（）,NTP,0000,0000,0000,,Дегенмен,басқа адамдар шығарған жартылай юкай өмірінің қысқаша мазмұны
Dialogue: 0,0:45:40.54,0:45:43.42,CN（）,NTP,0000,0000,0000,,Басқа тұлғалармен қосымша құзыреттілік
Dialogue: 0,0:45:44.03,0:45:45.47,CN（）,NTP,0000,0000,0000,,Жапон қоғамы ханью ме?
Dialogue: 0,0:45:46.08,0:45:51.15,CN（）,NTP,0000,0000,0000,,Адам күші мен құбыжық күші бірін-бірі жоққа шығарады.
Dialogue: 0,0:45:51.75,0:45:54.67,CN（）,NTP,0000,0000,0000,,Дегенмен,бұл жартылай жын күші мен екі түрлі қабілеттің қосындысы.
Dialogue: 0,0:45:55.33,0:45:57.55,CN（）,NTP,0000,0000,0000,,Көп салалы біріктіру
Dialogue: 0,0:45:57.73,0:46:00.04,CN（）,NTP,0000,0000,0000,,Елші құдіретінің қазандық қуаты
Dialogue: 0,0:46:00.65,0:46:01.81,CN（）,NTP,0000,0000,0000,,Бір, екі,үш
Dialogue: 0,0:46:05.50,0:46:06.33,CN（）,NTP,0000,0000,0000,,Өлім оқиғасы
Dialogue: 0,0:46:06.79,0:46:08.23,CN（）,NTP,0000,0000,0000,,Партияның өлімі
Dialogue: 0,0:46:08.56,0:46:09.75,CN（）,NTP,0000,0000,0000,,...
Dialogue: 0,0:46:26.70,0:46:28.65,CN（）,NTP,0000,0000,0000,,Бұл Shippo сәтсіздігі мәселесі
Dialogue: 0,0:46:30.05,0:46:30.94,CN（）,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:46:32.19,0:46:35.07,CN（）,NTP,0000,0000,0000,,Бір, екі,үш
Dialogue: 0,0:46:48.05,0:46:48.90,CN（）,NTP,0000,0000,0000,,Қанша уақыт күтуімді күтесің? Жылдам бол.
Dialogue: 0,0:46:53.44,0:46:55.43,CN（）,NTP,0000,0000,0000,,Бұл жарық па?
