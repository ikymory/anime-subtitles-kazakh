Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.89,0:00:15.40,Default,,0,0,0,,Рикка Менің қарным ашты.
Dialogue: 0,0:00:15.40,0:00:19.07,Default,,0,0,0,,Неге мұнда такояки жемейсің?
Dialogue: 0,0:00:19.07,0:00:22.90,Default,,0,0,0,,Мұндағы дәм жақсы емес, бірақ жарайды.
Dialogue: 0,0:00:22.90,0:00:24.91,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:00:24.91,0:00:27.58,Default,,0,0,0,,Кішкентай қыз, сен өте сүйкімдісің~
Dialogue: 0,0:00:27.58,0:00:29.91,Default,,0,0,0,,Иә, 1 қосымша элемент
Dialogue: 0,0:00:29.91,0:00:32.41,Default,,0,0,0,,Уау, рахмет
Dialogue: 0,0:00:32.41,0:00:34.92,Default,,0,0,0,,О, кәдімгі сұлулық!
Dialogue: 0,0:00:34.92,0:00:36.92,Default,,0,0,0,,Міне бонус!
Dialogue: 0,0:00:36.92,0:00:39.42,Default,,0,0,0,,Рахмет
Dialogue: 0,0:00:39.42,0:00:41.92,Default,,0,0,0,,О, сұлу қыз
Dialogue: 0,0:00:41.92,0:00:44.43,Default,,0,0,0,,Иә, бонус!
Dialogue: 0,0:00:44.43,0:00:46.43,Default,,0,0,0,,Хаха, солай!
Dialogue: 0,0:00:46.43,0:00:48.43,Default,,0,0,0,,<Бұл күрделі қанат>
Dialogue: 0,0:00:48.43,0:00:51.60,Default,,0,0,0,,Иә! Гид бар!
Dialogue: 0,0:00:51.60,0:00:54.94,Default,,0,0,0,,Ах! Ах!
Dialogue: 0,0:00:54.94,0:00:56.94,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:56.94,0:00:58.94,Default,,0,0,0,,(Қарғаның айқайы)
Dialogue: 0,0:00:58.94,0:01:00.94,Default,,0,0,0,,<Секине бонуссыз>
Dialogue: 0,0:02:46.91,0:02:51.09,Default,,0,0,0,,《Егер мен сатып алуды немесе жеуді ұсынбасам...》
Dialogue: 0,0:02:51.09,0:02:54.26,Default,,0,0,0,,《Ең болмағанда бонуссыз болмас едім...》
Dialogue: 0,0:02:54.26,0:02:59.09,Default,,0,0,0,,《Секине: Тоқташы... Маған көңіл бөлсең одан бетер аянышты.''
Dialogue: 0,0:02:59.09,0:03:01.60,Default,,0,0,0,,Бұл... Мен осындамын.
Dialogue: 0,0:03:01.60,0:03:04.93,Default,,0,0,0,,Маған бәрібір. Маған шағымдану керек.
Dialogue: 0,0:03:04.93,0:03:08.44,Default,,0,0,0,,А, бонусты қараңыз!
Dialogue: 0,0:03:08.44,0:03:11.54,Default,,0,0,0,,Міне, такояки!
Dialogue: 0,0:03:11.54,0:03:14.21,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:14.21,0:03:18.88,Default,,0,0,0,,Ууууууууу~
Dialogue: 0,0:03:18.88,0:03:23.22,Default,,0,0,0,,Нфффффффф…
Dialogue: 0,0:03:23.22,0:03:28.56,Default,,0,0,0,,Секине мырза! Негізі мен ол дүкенде тұрақты адаммын.
Dialogue: 0,0:03:28.56,0:03:32.56,Default,,0,0,0,,Менің ойымша, ол маған бонус берді.
Dialogue: 0,0:03:32.56,0:03:35.56,Default,,0,0,0,,Сондықтан бұл туралы мүлдем уайымдамаңыз.
Dialogue: 0,0:03:35.56,0:03:39.07,Default,,0,0,0,,Біріншіден, ол мейрамхананың дәмі жақсы емес.
Dialogue: 0,0:03:39.07,0:03:43.40,Default,,0,0,0,,Мен өз талғамыма сенімді емеспін, сондықтан мен тұтынушыларды қосымша заттармен тартуға тырысамын.
Dialogue: 0,0:03:43.40,0:03:47.91,Default,,0,0,0,,Дұрыс. Бұл жақсы болмаса да, маған қосымша қажет емес.
Dialogue: 0,0:03:47.91,0:03:50.41,Default,,0,0,0,,<Әркім соңынан ереді>
Dialogue: 0,0:03:50.41,0:03:53.92,Default,,0,0,0,,《Қарғыс атсын! Барлығы…》
Dialogue: 0,0:03:53.92,0:03:56.52,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:04:01.42,0:04:07.10,Default,,0,0,0,,Бұл менің жеке куәлігім, сондықтан қаласаңыз, маған хабарласыңыз.
Dialogue: 0,0:04:07.10,0:04:09.10,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:04:09.10,0:04:12.03,Default,,0,0,0,,Мен де сізге алғыс айтқым келеді. Эх...
Dialogue: 0,0:04:12.03,0:04:14.93,Default,,0,0,0,,Қош бол. Жуықта көріскенше. Мен күтетін боламын!
Dialogue: 0,0:04:18.37,0:04:22.71,Default,,0,0,0,,《Сол әуесқойларды 3 минутта өлтірейік》
Dialogue: 0,0:04:22.71,0:04:25.38,Default,,0,0,0,,《Жақсы》
Dialogue: 0,0:04:25.38,0:04:32.89,Default,,0,0,0,,А... у... өмір... өмір қымбат.
Dialogue: 0,0:04:32.89,0:04:35.49,Default,,0,0,0,,Өмір!
Dialogue: 0,0:04:37.56,0:04:39.56,Default,,0,0,0,,Ах
Dialogue: 0,0:04:39.56,0:04:41.96,Default,,0,0,0,,Қарғыс атсын... Дамоно!
Dialogue: 0,0:04:43.90,0:04:50.40,Default,,0,0,0,,((Өмір - гүл, ай, жел)
Dialogue: 0,0:04:50.40,0:04:54.24,Default,,0,0,0,,Ал менің досым~
Dialogue: 0,0:04:54.24,0:04:56.24,Default,,0,0,0,,Дамоно~))
Dialogue: 0,0:04:56.24,0:04:59.41,Default,,0,0,0,,《Ал... дұрыс.
Dialogue: 0,0:04:59.41,0:05:03.25,Default,,0,0,0,,Өмір қымбат. Бұл қауіпті жағдай болды.
Dialogue: 0,0:05:03.25,0:05:08.59,Default,,0,0,0,,Жоқ, бірақ анау қарт көрмейді.
Dialogue: 0,0:05:08.59,0:05:13.03,Default,,0,0,0,,Солардың ішінде болашақта ең танымалы Секине болатын сияқты.
Dialogue: 0,0:05:13.03,0:05:15.36,Default,,0,0,0,,Не? Ух... иә!
Dialogue: 0,0:05:15.36,0:05:18.03,Default,,0,0,0,,Иә, дұрыс! Қазір танымал болғаннан гөрі
Dialogue: 0,0:05:18.03,0:05:20.87,Default,,0,0,0,,Болашақта танымал болған дұрыс.
Dialogue: 0,0:05:20.87,0:05:23.54,Default,,0,0,0,,Студенттер жай ғана өту нүктесі.
Dialogue: 0,0:05:23.54,0:05:26.87,Default,,0,0,0,,Біз 100 жаста өмір сүріп жатырмыз! Әрине!
Dialogue: 0,0:05:26.87,0:05:30.88,Default,,0,0,0,,Болашақ қазіргіден маңызды! Барлығы...
Dialogue: 0,0:05:30.88,0:05:34.88,Default,,0,0,0,,Секиненің кеудесі үлкен ғой!
Dialogue: 0,0:05:34.88,0:05:37.05,Default,,0,0,0,,Бұл сыныптағы ең үлкені емес пе?
Dialogue: 0,0:05:37.05,0:05:39.89,Default,,0,0,0,,《Чиё: Мен мұны мақтау деп ойламадым...》
Dialogue: 0,0:05:39.89,0:05:44.23,Default,,0,0,0,,Кеудең болғанша, сәл қалың болса да, танымал боласың.
Dialogue: 0,0:05:44.23,0:05:47.73,Default,,0,0,0,,Ағатай, мен оның жүзін ғана көрдім.
Dialogue: 0,0:05:47.73,0:05:50.40,Default,,0,0,0,,Тоқта...｡ Тоқтатыңыз.
Dialogue: 0,0:05:50.40,0:05:54.57,Default,,0,0,0,,Жарайды! Егер сіз топтық кездесуде немесе бірдеңеде болсаңыз, бәрібір сіздің кеудеңізге ғана қарайды.
Dialogue: 0,0:05:54.57,0:05:59.41,Default,,0,0,0,,)
Dialogue: 0,0:05:59.41,0:06:03.91,Default,,0,0,0,,Ендеше, Цубаса, мына кеуде мен анау жүзді айырбастағың келе ме?
Dialogue: 0,0:06:03.91,0:06:05.91,Default,,0,0,0,,Иә!? Жоқ, бұл...
Dialogue: 0,0:06:05.91,0:06:10.59,Default,,0,0,0,,《Бұл не деген атмосфера... Өз басым сақ болдым.
Dialogue: 0,0:06:10.59,0:06:12.85,Default,,0,0,0,,Неліктен бәрі артқа шегінеді? 》
Dialogue: 0,0:06:12.85,0:06:15.02,Default,,0,0,0,,<2-ші сынып оқушыларының ең жақсы әрекеті>
Dialogue: 0,0:06:15.02,0:06:17.53,Default,,0,0,0,,Сау болыңыз!!
Dialogue: 0,0:06:17.53,0:06:22.86,Default,,0,0,0,,《Кенет жапон стилі? Сіз не ішкіңіз келеді? 》
Dialogue: 0,0:06:22.86,0:06:26.16,Default,,0,0,0,,)
Dialogue: 0,0:06:29.37,0:06:33.88,Default,,0,0,0,,Рикка Менің қарным ашты.
Dialogue: 0,0:06:33.88,0:06:37.04,Default,,0,0,0,,Неге мұнда такояки жемейсің?
Dialogue: 0,0:06:37.04,0:06:40.88,Default,,0,0,0,,Мұндағы дәм жақсы емес, бірақ жарайды.
Dialogue: 0,0:06:40.88,0:06:44.39,Default,,0,0,0,,Ах
Dialogue: 0,0:06:44.39,0:06:47.89,Default,,0,0,0,,《Уақыт кері кетті ме? 》
Dialogue: 0,0:06:47.89,0:06:50.39,Default,,0,0,0,,《Жарайды, уақыт пен кеңістік ауысуы сәтті болған сияқты》
Dialogue: 0,0:06:50.39,0:06:52.56,Default,,0,0,0,,《Сен мұны істей алмайсың!?》
Dialogue: 0,0:06:52.56,0:06:55.40,Default,,0,0,0,,《Мисс Секиненің абыройын қайтару》
Dialogue: 0,0:06:55.40,0:06:57.40,Default,,0,0,0,,《Мен үшін...》
Dialogue: 0,0:06:57.40,0:07:02.40,Default,,0,0,0,,《Осылай сіз оятуға ұқсас атмосферадан аулақ бола аласыз》
Dialogue: 0,0:07:04.41,0:07:07.41,Default,,0,0,0,,Секине-чан, бір сәтке кете аласыз ба?
Dialogue: 0,0:07:07.41,0:07:09.41,Default,,0,0,0,,Иә
Dialogue: 0,0:07:09.41,0:07:11.35,Default,,0,0,0,,《Не? Не? 》
Dialogue: 0,0:07:11.35,0:07:13.35,Default,,0,0,0,,《Рикка: мм. Қалғаны...
Dialogue: 0,0:07:13.35,0:07:17.35,Default,,0,0,0,,Мисс Секиннен басқа барлық адамдарды ғарыш шошқаларына айналдырыңыз.
Dialogue: 0,0:07:17.35,0:07:20.86,Default,,0,0,0,,<Бүкіл адамзатты ғарыш шошқаларына айналдыру жоспары>
Dialogue: 0,0:07:20.86,0:07:27.19,Default,,0,0,0,,((Секине ханымды адамзаттың ең сұлу әйеліне айналдырайық.
Dialogue: 0,0:07:27.19,0:07:31.53,Default,,0,0,0,,Бұл жоғарылау болуы мүмкін, бірақ 1-орын - 1-орын!
Dialogue: 0,0:07:31.53,0:07:35.20,Default,,0,0,0,,Бухи бухи сәлем! Бу-хи-бу-хи-бу!
Dialogue: 0,0:07:35.20,0:07:37.20,Default,,0,0,0,,Уххххххх
Dialogue: 0,0:07:37.20,0:07:39.71,Default,,0,0,0,,Bi buhihibuhibuboo?
Dialogue: 0,0:07:39.71,0:07:42.21,Default,,0,0,0,,Ерекше ештеңе жоқ))
Dialogue: 0,0:07:42.21,0:07:44.88,Default,,0,0,0,,《Мен оны тоқтатуым керек》
Dialogue: 0,0:07:44.88,0:07:47.21,Default,,0,0,0,,<Бір сәтке қарастырылады>
Dialogue: 0,0:07:47.21,0:07:49.21,Default,,0,0,0,,Таа~!
Dialogue: 0,0:07:59.89,0:08:03.56,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:08:03.56,0:08:05.57,Default,,0,0,0,,Бухи
Dialogue: 0,0:08:05.57,0:08:09.24,Default,,0,0,0,,Ә!? (2 адам) Бухи Бухи
Dialogue: 0,0:08:09.24,0:08:16.84,Default,,0,0,0,,《Мисс Секинеден басқа барлық адамдарды ғарыш шошқаларына айналдыру жоспары сәтті болды》
Dialogue: 0,0:08:16.84,0:08:18.85,Default,,0,0,0,,Боу
Dialogue: 0,0:08:18.85,0:08:21.85,Default,,0,0,0,,Бухи! Бухибухи бухи!
Dialogue: 0,0:08:21.85,0:08:27.19,Default,,0,0,0,,Бухи хи хи бухи бу буу…
Dialogue: 0,0:08:27.19,0:08:30.49,Default,,0,0,0,,<Адамзат Секиненің жеңілісі>
Dialogue: 0,0:08:32.53,0:08:36.20,Default,,0,0,0,,Ал егер... сонда!
Dialogue: 0,0:08:36.20,0:08:38.87,Default,,0,0,0,,Барлық адамдар ғарыш бақаларына айналды!
Dialogue: 0,0:08:38.87,0:08:40.87,Default,,0,0,0,,Geko Geko…
Dialogue: 0,0:08:40.87,0:08:42.87,Default,,0,0,0,,<Тағы бір жеңіліс>
Dialogue: 0,0:08:42.87,0:08:45.37,Default,,0,0,0,,Барлық адамдар минералданған!
Dialogue: 0,0:08:50.88,0:08:53.88,Default,,0,0,0,,< Ах~ Секине! ＞
Dialogue: 0,0:08:53.88,0:08:56.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:56.88,0:08:59.05,Default,,0,0,0,,(Iris) Ол жұмысы барын айтып, бүгін таңертең кетті.
Dialogue: 0,0:08:59.05,0:09:01.89,Default,,0,0,0,,《Ойлап қарасаң, шошқа – шошқа.
Dialogue: 0,0:09:01.89,0:09:04.89,Default,,0,0,0,,Бақалар бір-бірін ұнатады деп шешілді.
Dialogue: 0,0:09:04.89,0:09:07.90,Default,,0,0,0,,＜Мен мұны жасамас бұрын байқағанымды қалаймын＞
Dialogue: 0,0:09:07.90,0:09:12.33,Default,,0,0,0,,О? Қазір не істеп жатырмыз...
Dialogue: 0,0:09:12.33,0:09:16.17,Default,,0,0,0,,Эх, мен такояки сатып алайын деп жатыр едім.
Dialogue: 0,0:09:16.17,0:09:20.51,Default,,0,0,0,,《Сіз жадыңызды толығымен өшірдіңіз бе? Полковниктің миын жууы жиіркенішті》
Dialogue: 0,0:09:20.51,0:09:24.35,Default,,0,0,0,,《Келесі, келесі стратегия》
Dialogue: 0,0:09:24.35,0:09:26.35,Default,,0,0,0,,《Жетті! 》
Dialogue: 0,0:09:26.35,0:09:28.35,Default,,0,0,0,,А, бұл кенеттен...
Dialogue: 0,0:09:28.35,0:09:33.35,Default,,0,0,0,,Өйткені, адам үшін маңыздысы оның ішіндегісі деп ойлаймын.
Dialogue: 0,0:09:35.36,0:09:38.36,Default,,0,0,0,,Осы нүктеге жеткенде сергітетіндей болады.
Dialogue: 0,0:09:38.36,0:09:42.20,Default,,0,0,0,,Бұл мені ашуландырады... Қандай көрінсе де...
Dialogue: 0,0:09:42.20,0:09:45.20,Default,,0,0,0,,Менің өз бетімше өмір сүруден басқа амалым жоқ.
Dialogue: 0,0:09:45.20,0:09:50.87,Default,,0,0,0,,Секине-чан, дұрыс айтасың! Секине-чан бұл Секине-чан!
Dialogue: 0,0:09:50.87,0:09:54.88,Default,,0,0,0,,Кенеттен не болды? Сіздің сыртқы келбетіңіз не болды?
Dialogue: 0,0:09:54.88,0:09:58.21,Default,,0,0,0,,Алдымен, Жер тұрғындарының құрылымы қарапайым!
Dialogue: 0,0:09:58.21,0:10:00.21,Default,,0,0,0,,Бұл өте күрделі емес пе?
Dialogue: 0,0:10:00.21,0:10:03.22,Default,,0,0,0,,О, о, анау... достық! Бұл достық!
Dialogue: 0,0:10:03.22,0:10:05.22,Default,,0,0,0,,Уууу. (Чиё) Иә.
Dialogue: 0,0:10:05.22,0:10:07.39,Default,,0,0,0,,Біздің достығымыз сол күйінде қалды.
Dialogue: 0,0:10:07.39,0:10:09.39,Default,,0,0,0,,Сіз не туралы айтып отырсыз? иә?
Dialogue: 0,0:10:15.90,0:10:19.23,Default,,0,0,0,,Ах~｡ Амансың ба?
Dialogue: 0,0:10:19.23,0:10:22.43,Default,,0,0,0,,(Iris) Ол жұмысы барын айтып, бүгін таңертең кетті.
Dialogue: 0,0:10:24.41,0:10:28.41,Default,,0,0,0,,Шынымды айтсам, мен бүгін твиттер жазбадым.
Dialogue: 0,0:10:31.41,0:10:35.58,Default,,0,0,0,,Секине-чан! Секине мырза! Секине...
Dialogue: 0,0:10:35.58,0:10:38.92,Default,,0,0,0,,Мен өмір бойы лай суда қалсам ше?
Dialogue: 0,0:10:38.92,0:10:40.92,Default,,0,0,0,,《Неге!?》
Dialogue: 0,0:10:40.92,0:10:42.92,Default,,0,0,0,,<Ақ ниетті дұрыс түзу>
Dialogue: 0,0:10:42.92,0:10:44.92,Default,,0,0,0,,Уа... ау, ау
Dialogue: 0,0:10:46.93,0:10:49.93,Default,,0,0,0,,Жүр, тағы такояки ішіп, үйге қайтайық!
Dialogue: 0,0:10:49.93,0:10:52.93,Default,,0,0,0,,Содан~｡ Содан~
Dialogue: 0,0:10:52.93,0:10:55.27,Default,,0,0,0,,Мұны істейік
Dialogue: 0,0:10:55.27,0:11:00.44,Default,,0,0,0,,《Бірақ біз Секине Мисс сияқты басқа құрбанның шығуына жол бере алмаймыз.''
Dialogue: 0,0:11:00.44,0:11:02.94,Default,,0,0,0,,Иә! Одан да жақсы такояки жасаңыз
Dialogue: 0,0:11:02.94,0:11:07.44,Default,,0,0,0,,Бонус ретінде тұтынушыларды іздеудің қажеті жоқ.》
Dialogue: 0,0:11:11.05,0:11:13.89,Default,,0,0,0,,Ой уау уау уау!
Dialogue: 0,0:11:13.89,0:11:17.06,Default,,0,0,0,,《Әлемдегі ең жақсы материал ретінде қарастырылады.
Dialogue: 0,0:11:17.06,0:11:20.39,Default,,0,0,0,,Мен сені ғарыштық сегізаяққа айналдырдым. Шүкір етіңіз.
Dialogue: 0,0:11:20.39,0:11:22.40,Default,,0,0,0,,Боу
Dialogue: 0,0:11:22.40,0:11:25.57,Default,,0,0,0,,Бұл... Мен мұндай дәмді көрінетін сегізаяқты ешқашан көрген емеспін.
Dialogue: 0,0:11:25.57,0:11:28.24,Default,,0,0,0,,Boo Boo…｡ Мүмкін, біз онымен талғам бойынша бәсекелесе аламыз.
Dialogue: 0,0:11:28.24,0:11:33.07,Default,,0,0,0,,Бес төрт үш екі бір... Ууууууууууууууу!
Dialogue: 0,0:11:33.07,0:11:35.08,Default,,0,0,0,,Не істейміз, Итерер?
Dialogue: 0,0:11:35.08,0:11:37.08,Default,,0,0,0,,♬~
Dialogue: 0,0:11:37.08,0:11:40.92,Default,,0,0,0,,<Ғарыштық сегізаяқ өзінің мекенге бару инстинкті арқасында ғарышқа оралды.
Dialogue: 0,0:11:40.92,0:11:42.92,Default,,0,0,0,,Содан кейін сол жерде
Dialogue: 0,0:11:42.92,0:11:44.92,Default,,0,0,0,,Такояки дүңгіршегін ешкім көрмеген＞
Dialogue: 0,0:11:51.93,0:11:53.93,Default,,0,0,0,,Гей. иә?
Dialogue: 0,0:11:53.93,0:11:56.93,Default,,0,0,0,,Цубаса-чанның неше сырғасы бар?
Dialogue: 0,0:11:56.93,0:11:59.93,Default,,0,0,0,,Барлығы 9 болуы мүмкін. Апыр-ай!
Dialogue: 0,0:11:59.93,0:12:03.60,Default,,0,0,0,,Жарайды, сен көзіңді сонша аштың. Саған жарасады.
Dialogue: 0,0:12:03.60,0:12:05.77,Default,,0,0,0,,Рахмет. Мен түсінемін.
Dialogue: 0,0:12:05.77,0:12:08.94,Default,,0,0,0,,Пирсингтің арқасында Секинемен дос болдың.
Dialogue: 0,0:12:08.94,0:12:13.94,Default,,0,0,0,,Ах~ Ойланып қарасам... кіру рәсімінен кейін болған.
Dialogue: 0,0:12:17.89,0:12:21.56,Default,,0,0,0,,((Хмм? Сен барсың! Хмм?
Dialogue: 0,0:12:21.56,0:12:26.89,Default,,0,0,0,,Кейінірек қызметкерлер бөлмесіне келіңіз. Иә.
Dialogue: 0,0:12:26.89,0:12:30.06,Default,,0,0,0,,Сырға туралы айтып жатыр ма деп ойлаймын.
Dialogue: 0,0:12:30.06,0:12:32.07,Default,,0,0,0,,Цубаса-сан
Dialogue: 0,0:12:32.07,0:12:35.07,Default,,0,0,0,,Мұғалімге айтар жақсы сөзім бар.
Dialogue: 0,0:12:35.07,0:12:37.57,Default,,0,0,0,,Не? Ах... рахмет
Dialogue: 0,0:12:37.57,0:12:39.57,Default,,0,0,0,,《Мейірімді бала》
Dialogue: 0,0:12:39.57,0:12:41.58,Default,,0,0,0,,500 иен жақсы.
Dialogue: 0,0:12:41.58,0:12:45.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:45.58,0:12:49.08,Default,,0,0,0,,Иә, иә. Бұл діни себептерге байланысты сияқты.
Dialogue: 0,0:12:49.08,0:12:51.25,Default,,0,0,0,,《Цубаса: Қандай сұмдық өтірік》
Dialogue: 0,0:12:51.25,0:12:53.59,Default,,0,0,0,,Сіз мені сәтті алдадыңыз.
Dialogue: 0,0:12:53.59,0:12:55.59,Default,,0,0,0,,Ах... рахмет
Dialogue: 0,0:12:55.59,0:12:58.93,Default,,0,0,0,,Цубаса-сан, түскі асты мектеп асханасында жегің келе ме?
Dialogue: 0,0:12:58.93,0:13:01.93,Default,,0,0,0,,Мен саған 50 иенге шырын сатып аламын!
Dialogue: 0,0:13:01.93,0:13:05.27,Default,,0,0,0,,Менің ақшаммен бе? ))
Dialogue: 0,0:13:05.27,0:13:08.44,Default,,0,0,0,,Бұл менің көпшілдігімнің айласы еді.
Dialogue: 0,0:13:08.44,0:13:11.21,Default,,0,0,0,,Жарайды, бәрі Секиненің арқасы.
Dialogue: 0,0:13:11.21,0:13:16.41,Default,,0,0,0,,Ойлап қарасам, Чио-сан бірінші курстың ортасында мектепке ауысты.
Dialogue: 0,0:13:19.05,0:13:21.55,Default,,0,0,0,,((А, анау қыз...
Dialogue: 0,0:13:21.55,0:13:23.55,Default,,0,0,0,,Иә? ДДСҰ?
Dialogue: 0,0:13:23.55,0:13:28.06,Default,,0,0,0,,Ол керемет жас ханым сияқты. Ол әдемі.
Dialogue: 0,0:13:28.06,0:13:30.06,Default,,0,0,0,,Эй, бұл керемет.
Dialogue: 0,0:13:30.06,0:13:32.56,Default,,0,0,0,,Түскі асқа шақырайын ба? иә?
Dialogue: 0,0:13:32.56,0:13:35.73,Default,,0,0,0,,Маған мейірім ретінде қарайтындай сезінбейсіз бе?
Dialogue: 0,0:13:35.73,0:13:39.07,Default,,0,0,0,,Жаңа мәзір еті удон 390 иен))
Dialogue: 0,0:13:39.07,0:13:41.40,Default,,0,0,0,,<Айнымас Секине>
Dialogue: 0,0:13:41.40,0:13:43.90,Default,,0,0,0,,((Егер қаласаңыз, түскі асты бірге ішейік...
Dialogue: 0,0:13:43.90,0:13:46.41,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:13:46.41,0:13:48.41,Default,,0,0,0,,А...
Dialogue: 0,0:13:48.41,0:13:53.41,Default,,0,0,0,,《Мектеп директорының басшысын мақсат ету
Dialogue: 0,0:13:53.41,0:13:56.42,Default,,0,0,0,,Достасып жатқанда бұлай болмайды》
Dialogue: 0,0:13:56.42,0:14:01.92,Default,,0,0,0,,Бұл ұят. Мен оны сенімен жегім келді.
Dialogue: 0,0:14:08.43,0:14:10.86,Default,,0,0,0,,Үшеуі де дәл бірдей жағдайда қаза тапты.
Dialogue: 0,0:14:10.86,0:14:14.37,Default,,0,0,0,,Бонус маскасы аю. Хмм...
Dialogue: 0,0:14:14.37,0:14:16.87,Default,,0,0,0,,Иә, бұл менде болған.
Dialogue: 0,0:14:16.87,0:14:19.37,Default,,0,0,0,,Осыны қалайсыз ба?
Dialogue: 0,0:14:19.37,0:14:21.88,Default,,0,0,0,,Керек емес деп оны басқаларға мәжбүрлеме.
Dialogue: 0,0:14:21.88,0:14:23.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:28.55,0:14:30.55,Default,,0,0,0,,(айналдыру сылдырлауының дыбысы)
Dialogue: 0,0:14:32.55,0:14:35.89,Default,,0,0,0,,Қайырлы таң. (2 адам) Чи... Чио-сан? ))
Dialogue: 0,0:14:35.89,0:14:38.23,Default,,0,0,0,,Не болды?
Dialogue: 0,0:14:38.23,0:14:41.40,Default,,0,0,0,,Чио-сан, сен Маскумаға қатты ұнадың.
Dialogue: 0,0:14:41.40,0:14:45.07,Default,,0,0,0,,Өте сүйкімді...
Dialogue: 0,0:14:45.07,0:14:48.27,Default,,0,0,0,,《Сондықтан мен...》
Dialogue: 0,0:15:02.92,0:15:09.42,Default,,0,0,0,,((Ууууууууууу...
Dialogue: 0,0:15:09.42,0:15:14.86,Default,,0,0,0,,Қарғыс атсын! Маска аю!
Dialogue: 0,0:15:14.86,0:15:18.87,Default,,0,0,0,,Ма~! Ма~!
Dialogue: 0,0:15:18.87,0:15:22.04,Default,,0,0,0,,Өйткені, мен ешкімді өлтіргім келмейді!
Dialogue: 0,0:15:22.04,0:15:26.04,Default,,0,0,0,,Мен маскалы аюдың шектеулі тауарларын жинағым келеді! ))
Dialogue: 0,0:15:26.04,0:15:28.54,Default,,0,0,0,,《Бетперде киген аюды кездестірмейінше
Dialogue: 0,0:15:28.54,0:15:31.71,Default,,0,0,0,,Мен ауылдан кетуге шешім қабылдаған жоқпын.
Dialogue: 0,0:15:31.71,0:15:34.88,Default,,0,0,0,,《Маскамен!?》
Dialogue: 0,0:15:34.88,0:15:39.39,Default,,0,0,0,,Әйтеуір, барлығында әлі де бар.
Dialogue: 0,0:15:39.39,0:15:42.06,Default,,0,0,0,,Иә. Бұл дұрыс.
Dialogue: 0,0:15:42.06,0:15:44.06,Default,,0,0,0,,Әрине!
Dialogue: 0,0:15:44.06,0:15:46.56,Default,,0,0,0,,《Полковник ол кезде жоқ па еді? 》
Dialogue: 0,0:15:46.56,0:15:51.40,Default,,0,0,0,,Біз орман мектебінде оқып жүргенде, Рикка оны жоғалтып алды, біз оны бәріміз іздедік.
Dialogue: 0,0:15:51.40,0:15:53.90,Default,,0,0,0,,《Бұл полковник ойлап тапқан естелік》
Dialogue: 0,0:15:53.90,0:15:57.74,Default,,0,0,0,,Рождестволық кеште біз қуыршақтарды да жасадық.
Dialogue: 0,0:15:57.74,0:15:59.91,Default,,0,0,0,,Бұл да полковниктің ойдан шығарған ойы еді.
Dialogue: 0,0:15:59.91,0:16:04.24,Default,,0,0,0,,Ұлы көшбасшыларды құрметтеуге арналған кезекті жиналыста мен олардың барлығын бірге кидім.
Dialogue: 0,0:16:04.24,0:16:07.41,Default,,0,0,0,,Иә, болды. (Цубаса) А, иә.
Dialogue: 0,0:16:07.41,0:16:12.19,Default,,0,0,0,,Мен Какумей Набе жедім. Какумей Набе дәмді болды.
Dialogue: 0,0:16:12.19,0:16:15.19,Default,,0,0,0,,《Оның бәрі полковниктің ойдан шығарған ойы еді.
Dialogue: 0,0:16:15.19,0:16:17.86,Default,,0,0,0,,Дәлірек айтсақ, Какумей Набе деген не?
Dialogue: 0,0:16:17.86,0:16:22.86,Default,,0,0,0,,Иә? Айтайын дегенім, полковник қашан пайда болды? 》
Dialogue: 0,0:16:22.86,0:16:25.37,Default,,0,0,0,,<Менің миымды жуып жатқанын білемін, бірақ
Dialogue: 0,0:16:25.37,0:16:27.87,Default,,0,0,0,,Естеліктер қаншалықты ойдан құрастырылған?
Dialogue: 0,0:16:27.87,0:16:29.87,Default,,0,0,0,,Секине белгісіз＞
Dialogue: 0,0:16:29.87,0:16:34.54,Default,,0,0,0,,《Бірақ мен жақсымын ба? Құдай-ау...》
Dialogue: 0,0:16:34.54,0:16:37.38,Default,,0,0,0,,Менің жүрегім әрқашан
Dialogue: 0,0:16:37.38,0:16:39.88,Default,,0,0,0,,Өйткені ол ұлы көсемнің ілімімен!
Dialogue: 0,0:16:39.88,0:16:41.88,Default,,0,0,0,,<Миды жуу күшті болды>
Dialogue: 0,0:16:46.89,0:16:49.22,Default,,0,0,0,,Хмм? Бұл туралы ше?
Dialogue: 0,0:16:49.22,0:16:52.89,Default,,0,0,0,,А, крекер? Басқа күні клубтық іс-шараларда қолданылатын реквизиттер
Dialogue: 0,0:16:52.89,0:16:54.90,Default,,0,0,0,,Хмм? (Чиё мысқылдайды)
Dialogue: 0,0:16:54.90,0:16:57.06,Default,,0,0,0,,Көп нәрсе қалды, солай ма?
Dialogue: 0,0:16:57.06,0:16:59.57,Default,,0,0,0,,Иә? Жоқ!?
Dialogue: 0,0:16:59.57,0:17:02.57,Default,,0,0,0,,Чи... Чио-сан, кешіріңіз!
Dialogue: 0,0:17:02.57,0:17:04.91,Default,,0,0,0,,Ууууууууууу...
Dialogue: 0,0:17:04.91,0:17:07.57,Default,,0,0,0,,《Не... жылап тұрсың? 》
Dialogue: 0,0:17:07.57,0:17:11.01,Default,,0,0,0,,Барлығы тосын сый деп ойлады.
Dialogue: 0,0:17:11.01,0:17:13.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:13.01,0:17:15.35,Default,,0,0,0,,Менің туған күнім
Dialogue: 0,0:17:15.35,0:17:18.35,Default,,0,0,0,,Мені еске алудың өзі жеткілікті.
Dialogue: 0,0:17:18.35,0:17:21.52,Default,,0,0,0,,Маған тосын сый дайындағаныңызға да сене алар емеспін.
Dialogue: 0,0:17:21.52,0:17:24.36,Default,,0,0,0,,Ах... ааа...
Dialogue: 0,0:17:24.36,0:17:28.36,Default,,0,0,0,,Мен әлемдегі ең бақытты адаммын!
Dialogue: 0,0:17:28.36,0:17:30.36,Default,,0,0,0,,Туған күніңмен!
Dialogue: 0,0:17:30.36,0:17:34.20,Default,,0,0,0,,<Таңқаларлық табыс! деп шештім
Dialogue: 0,0:17:34.20,0:17:38.54,Default,,0,0,0,,《Жоқ, бірақ бұл туралы не істеуіміз керек? Ешкім ешқандай дайындық жасаған жоқ...》
Dialogue: 0,0:17:38.54,0:17:41.21,Default,,0,0,0,,Риккадан Чиоға сыйлық!
Dialogue: 0,0:17:41.21,0:17:44.04,Default,,0,0,0,,《Полковник! Қашан дайындаласың!?》
Dialogue: 0,0:17:44.04,0:17:48.38,Default,,0,0,0,,Қандай ерекше...
Dialogue: 0,0:17:48.38,0:17:52.39,Default,,0,0,0,,Ыңғайлы өшіргіш! Аа!?
Dialogue: 0,0:17:52.39,0:17:57.72,Default,,0,0,0,,Рикка-чан, неге...
Dialogue: 0,0:17:57.72,0:18:02.06,Default,,0,0,0,,Менің нені қалайтынымды қайдан білесіз?
Dialogue: 0,0:18:02.06,0:18:04.06,Default,,0,0,0,,Иә!?
Dialogue: 0,0:18:04.06,0:18:06.40,Default,,0,0,0,,Уууу
Dialogue: 0,0:18:06.40,0:18:08.57,Default,,0,0,0,,《Не? Миды жуу?
Dialogue: 0,0:18:08.57,0:18:12.67,Default,,0,0,0,,Полковник Чийоның миына араласып, оған нені қалайтынын айтады.
Dialogue: 0,0:18:12.67,0:18:15.34,Default,,0,0,0,,Мен оны кәдімгі өшіргішпен ауыстырдым! 》
Dialogue: 0,0:18:15.34,0:18:18.35,Default,,0,0,0,,Өшіргіш? Бұл кеңсе тауарлары.
Dialogue: 0,0:18:18.35,0:18:21.18,Default,,0,0,0,,Ке... Өшіргіш!
Dialogue: 0,0:18:21.18,0:18:23.52,Default,,0,0,0,,《Zu… Zurr…
Dialogue: 0,0:18:23.52,0:18:25.52,Default,,0,0,0,,Дәлірек айтқанда, егер сіз соншалықты алысқа баратын болсаңыз, онда
Dialogue: 0,0:18:25.52,0:18:27.52,Default,,0,0,0,,Мен туған күнімді атап өткім келеді
Dialogue: 0,0:18:27.52,0:18:29.52,Default,,0,0,0,,Оны жойсаңыз жақсы болмас па еді!
Dialogue: 0,0:18:29.52,0:18:33.36,Default,,0,0,0,,Цубасаны не істеймін... Екеуміз жерге тізерлеп отырайық па? 》
Dialogue: 0,0:18:33.36,0:18:36.36,Default,,0,0,0,,Аха. Ухуфу
Dialogue: 0,0:18:36.36,0:18:38.86,Default,,0,0,0,,《Мен не істеуім керек...мен》
Dialogue: 0,0:18:42.37,0:18:45.54,Default,,0,0,0,,《Сыйлықтар сатып алу.
Dialogue: 0,0:18:45.54,0:18:48.54,Default,,0,0,0,,Қыздардың көңіл-күйіне сай болуға тырыстым, бірақ
Dialogue: 0,0:18:48.54,0:18:51.88,Default,,0,0,0,,Мен олар тіпті таң қалдырады деп ойламаппын》
Dialogue: 0,0:18:51.88,0:18:54.05,Default,,0,0,0,,Чио-сан, кешіріңіз. иә?
Dialogue: 0,0:18:54.05,0:18:56.88,Default,,0,0,0,,Мен дайындаған жалғыз нәрсе - бұл қарапайым нәрсе...
Dialogue: 0,0:18:56.88,0:19:00.22,Default,,0,0,0,,Рахмет! Сіз оны ашуға қуаныштысыз ба?
Dialogue: 0,0:19:00.22,0:19:03.39,Default,,0,0,0,,Әрине. Жарайды, сүйкімді!
Dialogue: 0,0:19:03.39,0:19:08.23,Default,,0,0,0,,Туған күніме сыйлық ретінде тағы бір нәрсе жасағанымды қалайсыз ба?
Dialogue: 0,0:19:08.23,0:19:10.56,Default,,0,0,0,,Жоқ, бұл шектен шыққан.
Dialogue: 0,0:19:10.56,0:19:12.50,Default,,0,0,0,,Жоқ! Керісінше! Бірдене айтыңыз!
Dialogue: 0,0:19:12.50,0:19:14.84,Default,,0,0,0,,Олай болса...
Dialogue: 0,0:19:14.84,0:19:18.67,Default,,0,0,0,,Шашыңызбен тағы да ойнауға рұқсат етсем, қарсы боласыз ба?
Dialogue: 0,0:19:18.67,0:19:20.67,Default,,0,0,0,,Иә!?
Dialogue: 0,0:19:20.67,0:19:25.18,Default,,0,0,0,,Жазғы форманың орналасуы сізге өте жарасымды болды.
Dialogue: 0,0:19:25.18,0:19:29.52,Default,,0,0,0,,《Егер бұл сені бақытты етсе》
Dialogue: 0,0:19:29.52,0:19:32.02,Default,,0,0,0,,Керемет, Цубаса-сан!
Dialogue: 0,0:19:32.02,0:19:34.02,Default,,0,0,0,,Ах... а. Хехе.
Dialogue: 0,0:19:34.02,0:19:37.02,Default,,0,0,0,,《Ах! Мынау... Ендігі кезек Секине-санға.
Dialogue: 0,0:19:37.02,0:19:40.86,Default,,0,0,0,,Бұл көрініс. Жақсы... бұл жаман.
Dialogue: 0,0:19:40.86,0:19:43.20,Default,,0,0,0,,((Таңдау жоқ
Dialogue: 0,0:19:43.20,0:19:45.70,Default,,0,0,0,,Солай ма? Аа))
Dialogue: 0,0:19:45.70,0:19:51.37,Default,,0,0,0,,< Бұл Секине өзінің табиғаттан тыс күштерін басқара алатын уақыт.
Dialogue: 0,0:19:51.37,0:19:54.37,Default,,0,0,0,,Оны Ханшайым уақыты деп атаңыз.
Dialogue: 0,0:19:54.37,0:19:59.05,Default,,0,0,0,,Дегенмен, үлкен күшпен бірге үлкен баға келеді>
Dialogue: 0,0:19:59.05,0:20:03.55,Default,,0,0,0,,《Ханайым Уақыт өткен сайын мен
Dialogue: 0,0:20:03.55,0:20:05.55,Default,,0,0,0,,А, мен...
Dialogue: 0,0:20:05.55,0:20:08.22,Default,,0,0,0,,Салмағы күрт артады! 》
Dialogue: 0,0:20:08.22,0:20:13.39,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:13.39,0:20:19.49,Default,,0,0,0,,Иә! Олай болса мына дорба тәрізді дронмен аспанға хат жазайық!
Dialogue: 0,0:20:21.90,0:20:25.57,Default,,0,0,0,,О. Бұл керемет! Жақсы!
Dialogue: 0,0:20:25.57,0:20:28.41,Default,,0,0,0,,Туған күніңмен!
Dialogue: 0,0:20:28.41,0:20:32.25,Default,,0,0,0,,Қандай керемет хабар!
Dialogue: 0,0:20:32.25,0:20:35.25,Default,,0,0,0,,《Не... әйтеуір, мен құтыла аламын...》
Dialogue: 0,0:20:35.25,0:20:38.92,Default,,0,0,0,,Секине-сан Цубаса-сан Рикка-чан
Dialogue: 0,0:20:38.92,0:20:41.42,Default,,0,0,0,,(Виолет) Мен теремін. (Роданс) Жарай бер.
Dialogue: 0,0:20:41.42,0:20:45.09,Default,,0,0,0,,Мен туған күнімді осылай тойлаймын
Dialogue: 0,0:20:45.09,0:20:47.93,Default,,0,0,0,,Мені ешқашан құттықтаған адам болған емес.
Dialogue: 0,0:20:47.93,0:20:51.26,Default,,0,0,0,,Мен бұл мектепте оқып, барлығымен дос бола алдым.
Dialogue: 0,0:20:51.26,0:20:55.44,Default,,0,0,0,,Мен өте қуаныштымын. Мен сондай қуаныштымын!
Dialogue: 0,0:20:55.44,0:20:57.60,Default,,0,0,0,,《Бұл қиын болды, бірақ
Dialogue: 0,0:20:57.60,0:21:00.27,Default,,0,0,0,,Егер бұл сізді осылай бақытты етсе, мен мұны істегеніме қуаныштымын...》
Dialogue: 0,0:21:00.27,0:21:04.95,Default,,0,0,0,,Сонымен, Секине мырза, қарсы болмасаңыз, аспанға жазып бере аласыз ба?
Dialogue: 0,0:21:04.95,0:21:06.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:06.95,0:21:10.62,Default,,0,0,0,,Қанша жыл өтсе де, дос боламыз!
Dialogue: 0,0:21:10.62,0:21:13.02,Default,,0,0,0,,А... а... а...
Dialogue: 0,0:21:18.89,0:21:22.56,Default,,0,0,0,,Ммммммммммм
Dialogue: 0,0:21:22.56,0:21:27.96,Default,,0,0,0,,Өте көп!
Dialogue: 0,0:21:34.41,0:21:37.41,Default,,0,0,0,,Мәңгі... Достар...
Dialogue: 0,0:21:37.41,0:21:41.41,Default,,0,0,0,,Ах ха ха ха
Dialogue: 0,0:21:41.41,0:21:44.51,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:46.59,0:21:48.59,Default,,0,0,0,,♬~
Dialogue: 0,0:21:48.59,0:21:51.09,Default,,0,0,0,,О... ой...
Dialogue: 0,0:21:51.09,0:21:56.99,Default,,0,0,0,,<Ханайым уақыты керемет баға>
Dialogue: 0,0:21:58.49,0:22:04.49,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory