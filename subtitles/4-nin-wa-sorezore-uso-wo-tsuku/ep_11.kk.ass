Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:17.61,0:00:21.45,Default,,0,0,0,,Рикка-чан Жерде қанша уақыт болады?
Dialogue: 0,0:00:21.45,0:00:23.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:10.59,0:02:13.26,Default,,0,0,0,,Бұл...
Dialogue: 0,0:02:13.26,0:02:16.26,Default,,0,0,0,,Жақын жерде ғарыш кемесі бар ма?
Dialogue: 0,0:02:28.11,0:02:30.11,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:02:32.45,0:02:34.45,Default,,0,0,0,,Бұл Галактикалық революциялық альянс.
Dialogue: 0,0:02:34.45,0:02:37.78,Default,,0,0,0,,1098-ші батальон полковнигі Папипополо Дурликка.
Dialogue: 0,0:02:37.78,0:02:41.98,Default,,0,0,0,,Мен қазір күн жүйесіндегі үшінші планетадамын. Жауап күтемін!
Dialogue: 0,0:02:47.13,0:02:49.13,Default,,0,0,0,,《Барлық функциялар ақырында тоқтатылады.
Dialogue: 0,0:02:49.13,0:02:52.13,Default,,0,0,0,,Максималды шығыста құтқару сигналын жіберуден басқа амал жоқ па?
Dialogue: 0,0:02:52.13,0:02:56.43,Default,,0,0,0,,Бірақ ол үшін біз әркімнің миын жууды бұзуымыз керек! 》
Dialogue: 0,0:02:59.31,0:03:01.64,Default,,0,0,0,,Жақында жоғарылау емтиханы келеді.
Dialogue: 0,0:03:01.64,0:03:05.31,Default,,0,0,0,,Дұрыс. Жарайды, Секине оңай өтеді.
Dialogue: 0,0:03:05.31,0:03:08.15,Default,,0,0,0,,Қанаттарда орын жеткіліксіз бе?
Dialogue: 0,0:03:08.15,0:03:10.92,Default,,0,0,0,,Ха, мен ұйықтамаймын.
Dialogue: 0,0:03:10.92,0:03:12.92,Default,,0,0,0,,《Жақсы》
Dialogue: 0,0:03:12.92,0:03:15.09,Default,,0,0,0,,《Чиё-сан, сен емтиханға қатты дайындалып жатырсың.》
Dialogue: 0,0:03:15.09,0:03:18.26,Default,,0,0,0,,Негізі мен соңғы кездері кесте тігуге әуестеніп кеттім.
Dialogue: 0,0:03:18.26,0:03:21.60,Default,,0,0,0,,Оқу, Чио-сан! Бұл шынымен жаман болады!
Dialogue: 0,0:03:21.60,0:03:25.27,Default,,0,0,0,,Жарайды, Чио-сан. Рика сенде!
Dialogue: 0,0:03:25.27,0:03:27.27,Default,,0,0,0,,Рикка-чанға рахмет!
Dialogue: 0,0:03:27.27,0:03:29.77,Default,,0,0,0,,《Не болды? 》
Dialogue: 0,0:03:29.77,0:03:32.27,Default,,0,0,0,,Иә. Барлығымыз бірге зерттеу сабағын өткізуіміз керек.
Dialogue: 0,0:03:32.27,0:03:34.27,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:03:34.27,0:03:37.61,Default,,0,0,0,,Иә, дұрыс. Барымызды салайық, Чио-сан!
Dialogue: 0,0:03:37.61,0:03:41.28,Default,,0,0,0,,Бар күшімізді салып, бірге алға басайық! Мен түссіндім!
Dialogue: 0,0:03:41.28,0:03:43.28,Default,,0,0,0,,<Жауап беру жақсы>
Dialogue: 0,0:03:43.28,0:03:46.45,Default,,0,0,0,,Жарайды! Сіз міндетті түрде өтесіз!
Dialogue: 0,0:03:46.45,0:03:50.12,Default,,0,0,0,,Ей Эй О!
Dialogue: 0,0:03:50.12,0:03:52.13,Default,,0,0,0,,Олай болса, 7-қадам!
Dialogue: 0,0:03:52.13,0:03:56.46,Default,,0,0,0,,Иә! Шичи Ичига Шичи Шичи Ниджууши Шичи-сан…
Dialogue: 0,0:03:56.46,0:03:58.47,Default,,0,0,0,,Неге ол бізді өзінен алыстатқысы келеді?
Dialogue: 0,0:03:58.47,0:04:02.30,Default,,0,0,0,,Ура Чио-сан! Ура Чио-сан!
Dialogue: 0,0:04:02.30,0:04:04.64,Default,,0,0,0,,《Мен тым кеш сияқтымын》
Dialogue: 0,0:04:04.64,0:04:08.98,Default,,0,0,0,,Бұл Шичи-сан Нижуичи болды ма?
Dialogue: 0,0:04:08.98,0:04:11.58,Default,,0,0,0,,Дұрыс, солай!
Dialogue: 0,0:04:11.58,0:04:13.58,Default,,0,0,0,,Ммммммм
Dialogue: 0,0:04:13.58,0:04:16.42,Default,,0,0,0,,Амансың ба? Иә
Dialogue: 0,0:04:16.42,0:04:20.75,Default,,0,0,0,,Берген жақсы... Жоқ, мен ешқашан берілмеймін.
Dialogue: 0,0:04:20.75,0:04:23.26,Default,,0,0,0,,Қалған уақытта
Dialogue: 0,0:04:23.26,0:04:25.76,Default,,0,0,0,,Мен қолымнан келгеннің бәрін істегім келеді.
Dialogue: 0,0:04:25.76,0:04:27.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:27.76,0:04:29.76,Default,,0,0,0,,Енді тағы да!
Dialogue: 0,0:04:29.76,0:04:32.27,Default,,0,0,0,,Иә! Шичичигашичи Шичинижууши
Dialogue: 0,0:04:32.27,0:04:36.10,Default,,0,0,0,,Шичи-сан нижууйчи Шичиши… Шичиши…
Dialogue: 0,0:04:36.10,0:04:39.11,Default,,0,0,0,,Фюр Фюр Чио-сан!
Dialogue: 0,0:04:39.11,0:04:42.78,Default,,0,0,0,,《Дұрыс. Уақыт жоқ.》
Dialogue: 0,0:04:42.78,0:04:45.61,Default,,0,0,0,,((Цуйоши: Ммммммм~
Dialogue: 0,0:04:45.61,0:04:49.45,Default,,0,0,0,,Иә? Ах~ Ах~ Ах~...
Dialogue: 0,0:04:49.45,0:04:52.62,Default,,0,0,0,,Цуйоши: Даусыңыз біртүрлі емес пе?
Dialogue: 0,0:04:52.62,0:04:54.62,Default,,0,0,0,,Сіз шынымен солай ойлайсыз ба?
Dialogue: 0,0:04:54.62,0:04:58.12,Default,,0,0,0,,Егер сіз суық тиіп қалсаңыз, оны таратпаңыз. Бұл суық емес.
Dialogue: 0,0:04:58.12,0:05:01.46,Default,,0,0,0,,Сонымен не? Ащы тағамды көп жедіңіз бе?
Dialogue: 0,0:05:01.46,0:05:06.13,Default,,0,0,0,,Жоқ. Бұл дауыстың өзгеруі))
Dialogue: 0,0:05:06.13,0:05:10.74,Default,,0,0,0,,《Даусым мүлде өзгергенде, басқалардан еш айырмашылығым болмады...》
Dialogue: 0,0:05:10.74,0:05:15.58,Default,,0,0,0,,Шичиха Годзюроку Шичикурокуджу…
Dialogue: 0,0:05:15.58,0:05:17.58,Default,,0,0,0,,! Міне бітті!
Dialogue: 0,0:05:17.58,0:05:20.58,Default,,0,0,0,,Бұл таңқаларлық. Бұл керемет. (Цубаса) Иә, келесі 8-қадам!
Dialogue: 0,0:05:20.58,0:05:23.58,Default,,0,0,0,,Ум, Хачиитигахачи
Dialogue: 0,0:05:23.58,0:05:27.59,Default,,0,0,0,,《Болашақ үшін күресіп жатқан адамдарды көру керемет.
Dialogue: 0,0:05:27.59,0:05:30.76,Default,,0,0,0,,Дос ретінде мен де саған көмектесуім керек.
Dialogue: 0,0:05:30.76,0:05:32.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:32.76,0:05:36.46,Default,,0,0,0,,《Чио-санның IQ деңгейін сәл көтеруім керек пе?》
Dialogue: 0,0:05:43.44,0:05:45.94,Default,,0,0,0,,Чио-сан, не болды?
Dialogue: 0,0:05:49.44,0:05:51.95,Default,,0,0,0,,Мен оны дерлік түсіндім.
Dialogue: 0,0:05:51.95,0:05:54.11,Default,,0,0,0,,Енді не!? Иә.
Dialogue: 0,0:05:54.11,0:05:56.78,Default,,0,0,0,,Негіздерді түсінгеннен кейін, қалғаны қолданба
Dialogue: 0,0:05:56.78,0:05:59.12,Default,,0,0,0,,Мен бұны ешқашан күтпеген едім...
Dialogue: 0,0:05:59.12,0:06:02.62,Default,,0,0,0,,Олай болса, 99-ды 99-ға көбейту нешеге тең?
Dialogue: 0,0:06:02.62,0:06:04.62,Default,,0,0,0,,9, 801.
Dialogue: 0,0:06:04.62,0:06:06.63,Default,,0,0,0,,<Тез жауап>
Dialogue: 0,0:06:06.63,0:06:09.96,Default,,0,0,0,,Қараңызшы, 100 бағанды 100 бағанға көбейту торын болжау.
Dialogue: 0,0:06:09.96,0:06:12.07,Default,,0,0,0,,Әрбір соңғы баған өшірілді делік
Dialogue: 0,0:06:12.07,0:06:14.40,Default,,0,0,0,,Бұл жағдайда қабаттасатын шаршыларды қоссаңыз,
Dialogue: 0,0:06:14.40,0:06:16.90,Default,,0,0,0,,Сіз оны әп-сәтте шеше аласыз, солай ма?
Dialogue: 0,0:06:16.90,0:06:20.74,Default,,0,0,0,,Ах, а... а
Dialogue: 0,0:06:20.74,0:06:24.08,Default,,0,0,0,,《Полковниктің допингінің арқасында Чиё жоғары көтерілді.
Dialogue: 0,0:06:24.08,0:06:26.41,Default,,0,0,0,,Жақсы сияқты》 (Цубаса) Уф!
Dialogue: 0,0:06:26.41,0:06:30.25,Default,,0,0,0,,Неліктен оқу сабағын тоқтатып, оның орнына ұйықтауға болмайды?
Dialogue: 0,0:06:30.25,0:06:32.25,Default,,0,0,0,,Кино немесе бір нәрсе көрейік.
Dialogue: 0,0:06:32.25,0:06:34.92,Default,,0,0,0,,Бұл тамаша ұсыныс!
Dialogue: 0,0:06:34.92,0:06:38.43,Default,,0,0,0,,Осындай жағдай орын алса, менде пижамалар дайын.
Dialogue: 0,0:06:38.43,0:06:41.26,Default,,0,0,0,,Жоқ, мен жай ғана түнеймін...
Dialogue: 0,0:06:41.26,0:06:43.26,Default,,0,0,0,,Не? Бұл қандай өрнек!?
Dialogue: 0,0:06:43.26,0:06:46.60,Default,,0,0,0,,Олай болса, шешілді. (Цубаса) Ағын енді шешілді!?
Dialogue: 0,0:06:46.60,0:06:48.94,Default,,0,0,0,,Кәмпит сатып алуға барамыз ба?
Dialogue: 0,0:06:48.94,0:06:51.44,Default,,0,0,0,,!?
Dialogue: 0,0:06:51.44,0:06:53.94,Default,,0,0,0,,Дәріханада шырын т.б. арзанырақ.
Dialogue: 0,0:06:53.94,0:06:56.94,Default,,0,0,0,,Екі топқа бөлінейік. (Чиё және т.б.) Иә.
Dialogue: 0,0:06:56.94,0:07:02.62,Default,,0,0,0,,Секине шоколад деді, солай ма? - деді Рикка.
Dialogue: 0,0:07:02.62,0:07:05.62,Default,,0,0,0,,Хммм...Кәне де жұтқыншақ кәмпит сатып алайық.
Dialogue: 0,0:07:05.62,0:07:07.95,Default,,0,0,0,,Тамақтың кәмпиттері тамақты басады.
Dialogue: 0,0:07:07.95,0:07:11.39,Default,,0,0,0,,Бұл ауырсынуды және жөтелді басатын белсенді ингредиент.
Dialogue: 0,0:07:11.39,0:07:14.56,Default,,0,0,0,,Цубаса-санның тамағындағы кәмпитті жұтып қойса да тамағы ауырмайды.
Dialogue: 0,0:07:14.56,0:07:17.73,Default,,0,0,0,,Емдемейді деп ойлаймын. иә?
Dialogue: 0,0:07:17.73,0:07:21.63,Default,,0,0,0,,А... жоқ, бұл ештеңе емес.
Dialogue: 0,0:07:28.24,0:07:32.94,Default,,0,0,0,,《Мүмкін Чиё-сан дауыстың өзгергенін білетін шығар? 》
Dialogue: 0,0:07:37.08,0:07:39.08,Default,,0,0,0,,Ум...
Dialogue: 0,0:07:43.59,0:07:46.59,Default,,0,0,0,,Ах, у...
Dialogue: 0,0:07:46.59,0:07:49.26,Default,,0,0,0,,Цубаса-сан жалғыз емес.
Dialogue: 0,0:07:49.26,0:07:51.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:51.93,0:07:55.77,Default,,0,0,0,,Екеуің~!
Dialogue: 0,0:07:55.77,0:07:57.94,Default,,0,0,0,,Мен көп заттарды сатып алдым.
Dialogue: 0,0:07:57.94,0:08:01.27,Default,,0,0,0,,Қарашы, қарашы, Чио-сан!
Dialogue: 0,0:08:01.27,0:08:05.95,Default,,0,0,0,,Мен өзімді жақсы сезінбеймін. Не болды?
Dialogue: 0,0:08:05.95,0:08:07.95,Default,,0,0,0,,Жоқ, ой...
Dialogue: 0,0:08:07.95,0:08:09.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:17.56,0:08:21.06,Default,,0,0,0,,Рикка-чан Жерде қанша уақыт болады?
Dialogue: 0,0:08:21.06,0:08:23.73,Default,,0,0,0,,Иә? Осы уақытқа дейін болған көптеген нәрселер
Dialogue: 0,0:08:23.73,0:08:26.23,Default,,0,0,0,,Жұмбақ құбылыстарды қалай түсіндіреміз
Dialogue: 0,0:08:26.23,0:08:29.24,Default,,0,0,0,,Технологиялық жүйесі Жердегіден өзгеше болмыс.
Dialogue: 0,0:08:29.24,0:08:31.40,Default,,0,0,0,,Біз тек болжауға болады
Dialogue: 0,0:08:31.40,0:08:37.58,Default,,0,0,0,,Рикка-чан... ол бөтен планеталық па?
Dialogue: 0,0:08:37.58,0:08:39.91,Default,,0,0,0,,Неге екені белгісіз, Рикка-чан
Dialogue: 0,0:08:39.91,0:08:42.92,Default,,0,0,0,,Мен жақында жұлдыздарға оралуым керек.
Dialogue: 0,0:08:42.92,0:08:45.92,Default,,0,0,0,,Менің үйге барғым келмейді. Үйге барғың келмей ме?
Dialogue: 0,0:08:45.92,0:08:49.09,Default,,0,0,0,,Бірақ егер солай болса, онда біз
Dialogue: 0,0:08:49.09,0:08:52.26,Default,,0,0,0,,Осылай қанша уақыт бірге боламыз деп ойлаймын.
Dialogue: 0,0:08:52.26,0:08:54.93,Default,,0,0,0,,Шынын айтсам, мен әлі де «Арнайы сынып» дегеннің не екенін түсінбеймін.
Dialogue: 0,0:08:54.93,0:08:57.43,Default,,0,0,0,,Ал...
Dialogue: 0,0:08:57.43,0:09:02.63,Default,,0,0,0,,Секине мырза бәрін біледі, солай ма?
Dialogue: 0,0:09:06.77,0:09:09.67,Default,,0,0,0,,Ит!? Әрине, мүмкін емес—осы ит!?
Dialogue: 0,0:09:12.71,0:09:17.88,Default,,0,0,0,,Сіз нені айтасыз? Не деген ~ хахаха...
Dialogue: 0,0:09:17.88,0:09:21.05,Default,,0,0,0,,Чио-сан
Dialogue: 0,0:09:21.05,0:09:23.39,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:23.39,0:09:25.56,Default,,0,0,0,,О, ә?
Dialogue: 0,0:09:25.56,0:09:29.73,Default,,0,0,0,,Не... туралы айтып тұрсыз ба?
Dialogue: 0,0:09:29.73,0:09:33.90,Default,,0,0,0,,Үйге кететін уақыт келді.
Dialogue: 0,0:09:33.90,0:09:35.90,Default,,0,0,0,,Солай болды ма?
Dialogue: 0,0:09:35.90,0:09:38.91,Default,,0,0,0,,Менің есте сақтау қабілетім бұлыңғыр.
Dialogue: 0,0:09:38.91,0:09:41.11,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:09:54.25,0:09:58.26,Default,,0,0,0,,Әй, екеуіңе не болды?
Dialogue: 0,0:09:58.26,0:10:00.43,Default,,0,0,0,,Ештеңе. Ештеңе етпейді.
Dialogue: 0,0:10:00.43,0:10:02.43,Default,,0,0,0,,《Секине: Ауа ең нашар
Dialogue: 0,0:10:02.43,0:10:06.60,Default,,0,0,0,,Чио-сан, оның IQ-ы күрт көтерілгеннен кейін не болғанын есіне түсірмейтін сияқты.
Dialogue: 0,0:10:06.60,0:10:10.44,Default,,0,0,0,,Жеке тұлғаңыздың ашылуына алаңдаудың қажеті жоқ деп ойлаймын...
Dialogue: 0,0:10:10.44,0:10:12.61,Default,,0,0,0,,Қанаттарға не болды деймін? 》
Dialogue: 0,0:10:12.61,0:10:15.94,Default,,0,0,0,,《Мм. Мен ақыры шешім қабылдадым.
Dialogue: 0,0:10:15.94,0:10:18.95,Default,,0,0,0,,Мазасызданудың қажеті жоқ! 》
Dialogue: 0,0:10:18.95,0:10:23.45,Default,,0,0,0,,Сәлем бәріңе! Кино көрейік. Иә, мұны істейік!
Dialogue: 0,0:10:23.45,0:10:25.95,Default,,0,0,0,,Ал, бейнемагнитофонды шығарайық.
Dialogue: 0,0:10:25.95,0:10:27.95,Default,,0,0,0,,Б-бірақ… енді Хигучи Кира екенін білгеннен кейін,
Dialogue: 0,0:10:27.95,0:10:29.96,Default,,0,0,0,,<Мен бұл туралы ешқашан естімеппін>
Dialogue: 0,0:10:29.96,0:10:32.46,Default,,0,0,0,,Blu-ray немесе DVD туралы не деуге болады?
Dialogue: 0,0:10:32.46,0:10:35.46,Default,,0,0,0,,Сонымен, VHS қол жетімді жалғыз нұсқа.
Dialogue: 0,0:10:35.46,0:10:38.30,Default,,0,0,0,,VHS? Оның бейнемагнитофоннан айырмашылығы бар ма?
Dialogue: 0,0:10:38.30,0:10:41.00,Default,,0,0,0,,Ах~ Сол жерден...
Dialogue: 0,0:10:48.14,0:10:50.98,Default,,0,0,0,,《Ха, енді не істеуім керек?
Dialogue: 0,0:10:50.98,0:10:54.15,Default,,0,0,0,,Мен бәріне айтуым керек пе? 》
Dialogue: 0,0:10:54.15,0:10:57.32,Default,,0,0,0,,)
Dialogue: 0,0:10:57.32,0:10:59.82,Default,,0,0,0,,《Бұл нені білдіреді?》
Dialogue: 0,0:10:59.82,0:11:02.82,Default,,0,0,0,,Иә? Мен ояндым
Dialogue: 0,0:11:02.82,0:11:05.66,Default,,0,0,0,,Цубаса-сан, сен де ұйықтай алмайсың ба?
Dialogue: 0,0:11:05.66,0:11:08.76,Default,,0,0,0,,А, иә. Біраз ғана.
Dialogue: 0,0:11:11.60,0:11:13.60,Default,,0,0,0,,Сәлем Чио-сан
Dialogue: 0,0:11:13.60,0:11:16.60,Default,,0,0,0,,Біз бұл туралы дүкеннен үйге қайтып келе жатқанда сөйлескен едік...
Dialogue: 0,0:11:16.60,0:11:21.61,Default,,0,0,0,,Бұл не? сурет? О, жоқ...
Dialogue: 0,0:11:21.61,0:11:25.28,Default,,0,0,0,,Цубаса-санның маған көбейту кестесін үйреткені есімде.
Dialogue: 0,0:11:25.28,0:11:28.62,Default,,0,0,0,,Одан кейін не болғаны көп есімде жоқ.
Dialogue: 0,0:11:28.62,0:11:30.95,Default,,0,0,0,,Мен әдетте сабақ оқымаймын.
Dialogue: 0,0:11:30.95,0:11:34.29,Default,,0,0,0,,Мүмкін кенет басымды пайдаланғандықтан болар.
Dialogue: 0,0:11:34.29,0:11:36.79,Default,,0,0,0,,《Чио-сан әдеттегі жағдайына оралды》
Dialogue: 0,0:11:36.79,0:11:39.63,Default,,0,0,0,,Цубаса-сан, бүгінгі күн үшін көп рахмет.
Dialogue: 0,0:11:39.63,0:11:41.79,Default,,0,0,0,,Менімен бірге оқығаныңыз үшін рахмет.
Dialogue: 0,0:11:41.79,0:11:44.46,Default,,0,0,0,,А, жоқ, бізге қыдырудың қажеті жоқ еді.
Dialogue: 0,0:11:44.46,0:11:47.30,Default,,0,0,0,,Чио-сан, мен келесі сыныпқа оңай өте аламын деп ойлаймын.
Dialogue: 0,0:11:47.30,0:11:50.80,Default,,0,0,0,,Өйткені Цубаса мырза мені мұқият оқытты.
Dialogue: 0,0:11:50.80,0:11:57.48,Default,,0,0,0,,Шичичига Шичи Шичи Ниджуши Шичи-сан... Ниджууши?
Dialogue: 0,0:11:57.48,0:11:59.48,Default,,0,0,0,,Иә!?
Dialogue: 0,0:11:59.48,0:12:02.32,Default,,0,0,0,,Секине оян. Мен түні бойы тұруым керек!
Dialogue: 0,0:12:02.32,0:12:05.22,Default,,0,0,0,,А, мен ұйықтап жатырмын...
Dialogue: 0,0:12:08.49,0:12:11.09,Default,,0,0,0,,Сонымен... мен қолымнан келгенін жасадым.
Dialogue: 0,0:12:11.09,0:12:14.59,Default,,0,0,0,,Емтиханға сәттілік. Чио-сан
Dialogue: 0,0:12:14.59,0:12:18.60,Default,,0,0,0,,Өйткені ғажайыптар болуы мүмкін
Dialogue: 0,0:12:18.60,0:12:23.10,Default,,0,0,0,,Екеуің де көп уайымдама.
Dialogue: 0,0:12:23.10,0:12:25.77,Default,,0,0,0,,《Егер сіз өзіңіздің дағдыларыңызды ниндзя ретінде пайдалансаңыз...
Dialogue: 0,0:12:25.77,0:12:29.11,Default,,0,0,0,,Жауап парағын ұрлау сияқты қарапайым нәрсе》
Dialogue: 0,0:12:29.11,0:12:31.78,Default,,0,0,0,,《Түсініп тұрмын, бұл маған еркіндік береді...》
Dialogue: 0,0:12:31.78,0:12:34.45,Default,,0,0,0,,《Сондықтан мен сені міндетті түрде жоғарылатамын.
Dialogue: 0,0:12:34.45,0:12:36.95,Default,,0,0,0,,Алдамаңыз! 》 《Алдау》
Dialogue: 0,0:12:36.95,0:12:39.45,Default,,0,0,0,,《Қабілетіңізбен! 》 《Жоқ, сізде қабілет бар! 》
Dialogue: 0,0:12:39.45,0:12:43.46,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасаймын! Іске сәт!
Dialogue: 0,0:12:43.46,0:12:47.13,Default,,0,0,0,,《Қош бол Чио-сан》
Dialogue: 0,0:12:47.13,0:12:49.13,Default,,0,0,0,,Мен өттім! (Секине және т.б.) Неге?
Dialogue: 0,0:12:49.13,0:12:52.13,Default,,0,0,0,,Керемет Керемет Керемет Керемет
Dialogue: 0,0:13:00.14,0:13:02.14,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:05.65,0:13:07.65,Default,,0,0,0,,Иә, аты болды.
Dialogue: 0,0:13:07.65,0:13:10.32,Default,,0,0,0,,Мен сенімен қайтадан мектепке бара аламын.
Dialogue: 0,0:13:10.32,0:13:13.25,Default,,0,0,0,,Сен мұны қалай істедің? Яғни...
Dialogue: 0,0:13:13.25,0:13:17.92,Default,,0,0,0,,Мұғалімдер бірінен соң бірі тест тапсырды.
Dialogue: 0,0:13:17.92,0:13:21.26,Default,,0,0,0,,Оның үстіне мен өзімнің ынта-жігерімді білдіретін эссе жібердім!
Dialogue: 0,0:13:21.26,0:13:23.76,Default,,0,0,0,,<Қайырымдылық шаралары>
Dialogue: 0,0:13:23.76,0:13:27.60,Default,,0,0,0,,Солай ма? Сосын түні бойы ұйқысыз отырудың мәні жоқ еді.
Dialogue: 0,0:13:27.60,0:13:29.60,Default,,0,0,0,,Бірақ...｡ Иә.
Dialogue: 0,0:13:29.60,0:13:32.27,Default,,0,0,0,,Рикканың аты...Бәрі!
Dialogue: 0,0:13:32.27,0:13:34.97,Default,,0,0,0,,Сізді жоғарылатуыңызбен құттықтаймыз!
Dialogue: 0,0:13:37.78,0:13:40.78,Default,,0,0,0,,Эй Рикка, сіз жоғарылату емтиханының нәтижелерін көрдіңіз бе?
Dialogue: 0,0:13:40.78,0:13:43.12,Default,,0,0,0,,Рикканың аты ғана жетіспеді.
Dialogue: 0,0:13:43.12,0:13:45.72,Default,,0,0,0,,Иә, мен білемін.
Dialogue: 0,0:13:48.79,0:13:52.29,Default,,0,0,0,,Рикканың бітіру рәсімі бұдан былай өтеді.
Dialogue: 0,0:13:52.29,0:13:54.29,Default,,0,0,0,,Мектеп бітіру рәсімі?
Dialogue: 0,0:13:54.29,0:13:57.80,Default,,0,0,0,,Жауап: Мен Риккамын, бітіруші сыныптың өкілімін.
Dialogue: 0,0:13:57.80,0:14:00.13,Default,,0,0,0,,Қазір қалжыңдайтын уақыт емес.
Dialogue: 0,0:14:00.13,0:14:03.30,Default,,0,0,0,,Бұл қате деп ойлаймын, сондықтан мұғалімдерге айтуым керек.
Dialogue: 0,0:14:03.30,0:14:05.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:05.30,0:14:08.14,Default,,0,0,0,,Есімде болса, бәрімен кездескеннен кейін
Dialogue: 0,0:14:08.14,0:14:10.14,Default,,0,0,0,,Көп нәрсе болды.
Dialogue: 0,0:14:10.14,0:14:12.75,Default,,0,0,0,,Көңілді мәдени фестиваль
Dialogue: 0,0:14:12.75,0:14:14.91,Default,,0,0,0,,Ыңғайсыз шоппинг
Dialogue: 0,0:14:14.91,0:14:17.08,Default,,0,0,0,,Тілек айтқан бассейн
Dialogue: 0,0:14:17.08,0:14:19.25,Default,,0,0,0,,Сәжде теңізі
Dialogue: 0,0:14:19.25,0:14:22.59,Default,,0,0,0,,Тілімді күйдіріп, аузымды ағызып жібере жаздаған Такопа.
Dialogue: 0,0:14:22.59,0:14:24.92,Default,,0,0,0,,Түнде бәріміз ұйықтау тойын өткіздік
Dialogue: 0,0:14:24.92,0:14:30.10,Default,,0,0,0,,Әрбір естелік Рикканың асыл қазынасы.
Dialogue: 0,0:14:30.10,0:14:34.10,Default,,0,0,0,,Мен сенімен бірге өткен күндерді ешқашан ұмытпаймын.
Dialogue: 0,0:14:34.10,0:14:36.77,Default,,0,0,0,,Рикка-чан, кенеттен не болды?
Dialogue: 0,0:14:36.77,0:14:40.27,Default,,0,0,0,,Дұрыс. Енді қоштасу сияқты бірдеңе айтыңыз.
Dialogue: 0,0:14:53.79,0:14:56.79,Default,,0,0,0,,О, бұл не!? НЛО!? Бұл шын ба?
Dialogue: 0,0:14:56.79,0:15:00.99,Default,,0,0,0,,Сен мұнда не үшін келдің? Апыр-ай! Керемет!
Dialogue: 0,0:15:03.13,0:15:05.13,Default,,0,0,0,,Не!
Dialogue: 0,0:15:07.63,0:15:10.47,Default,,0,0,0,,《Полковниктің миын жуу жойылды ма? 》
Dialogue: 0,0:15:10.47,0:15:13.41,Default,,0,0,0,,Бұдан былай барлығының естеліктері өшеді.
Dialogue: 0,0:15:13.41,0:15:16.24,Default,,0,0,0,,НЛО-ның болуы және менің бар болуым
Dialogue: 0,0:15:16.24,0:15:18.24,Default,,0,0,0,,Мен сені ұмыттыруым керек.
Dialogue: 0,0:15:18.24,0:15:20.91,Default,,0,0,0,,Есте сақтауды өшіру деген нені білдіреді?
Dialogue: 0,0:15:20.91,0:15:26.09,Default,,0,0,0,,Чио-сан, мисс Секине, Мисс Цубаса. Осы уақытқа дейін көрсеткен көмегіңіз үшін рахмет.
Dialogue: 0,0:15:26.09,0:15:30.42,Default,,0,0,0,,Қоштасуды ойлау ауыр болуы мүмкін, бірақ мен жыламаймын.
Dialogue: 0,0:15:30.42,0:15:33.26,Default,,0,0,0,,Қанша уақыт өтсе де, И
Dialogue: 0,0:15:33.26,0:15:35.96,Default,,0,0,0,,Досыма бақыт тілеймін!
Dialogue: 0,0:15:38.93,0:15:41.60,Default,,0,0,0,,Рикка Неліктен НЛО?
Dialogue: 0,0:15:41.60,0:15:43.60,Default,,0,0,0,,Бұл менің кінәм
Dialogue: 0,0:15:43.60,0:15:47.44,Default,,0,0,0,,Рикка-чанның ғарышқа қайта оралуына мен кінәлімін!
Dialogue: 0,0:15:47.44,0:15:49.78,Default,,0,0,0,,Сіз жадыңызды жоғалтқаныңызды айттыңыз.
Dialogue: 0,0:15:49.78,0:15:51.78,Default,,0,0,0,,Бұл өтірік болды ма?
Dialogue: 0,0:15:51.78,0:15:54.78,Default,,0,0,0,,Иә. Сол күні менің басым кенет анық болды.
Dialogue: 0,0:15:54.78,0:15:57.12,Default,,0,0,0,,Мен көп нәрсені түсіндім...
Dialogue: 0,0:15:57.12,0:16:02.79,Default,,0,0,0,,Мен бірдеңені айттым, мені бұрышқа түсірді... Уф...
Dialogue: 0,0:16:02.79,0:16:05.63,Default,,0,0,0,,Бұл Чио-санның кінәсі емес.
Dialogue: 0,0:16:05.63,0:16:08.13,Default,,0,0,0,,Біз кездескеннен бері
Dialogue: 0,0:16:08.13,0:16:11.73,Default,,0,0,0,,Рикка ғарышқа қашан ораламын деп ойлады.
Dialogue: 0,0:16:11.73,0:16:15.07,Default,,0,0,0,,Ғарышқа қайта оралуым керек болатын жағдайлар бар.
Dialogue: 0,0:16:15.07,0:16:18.07,Default,,0,0,0,,Бар. Мен шынымен түсінбеймін.
Dialogue: 0,0:16:18.07,0:16:21.41,Default,,0,0,0,,Кенет өзімді осылай сезіндім... Мен өзімді осылай жалғыз сезінемін.
Dialogue: 0,0:16:21.41,0:16:23.74,Default,,0,0,0,,Мен де...
Dialogue: 0,0:16:23.74,0:16:25.91,Default,,0,0,0,,Бірақ бұл Рикканың шешімі болды.
Dialogue: 0,0:16:25.91,0:16:29.08,Default,,0,0,0,,Адамның еркін сыйлау керек деп ойлаймын.
Dialogue: 0,0:16:29.08,0:16:32.42,Default,,0,0,0,,Рикка-чан. Бұл шынымен оның ниеті ме?
Dialogue: 0,0:16:32.42,0:16:35.25,Default,,0,0,0,,Не? Рика жылап отырды
Dialogue: 0,0:16:35.25,0:16:38.09,Default,,0,0,0,,Мен мұнда болмауым керек екенін білемін, бірақ
Dialogue: 0,0:16:38.09,0:16:40.09,Default,,0,0,0,,Мен бәрінен бөлек қалғым келмейді
Dialogue: 0,0:16:40.09,0:16:42.93,Default,,0,0,0,,Мүмкін сіз солай ойлайсыз.
Dialogue: 0,0:16:42.93,0:16:45.10,Default,,0,0,0,,Неліктен бұлай етер едіңіз? Цубаса...
Dialogue: 0,0:16:45.10,0:16:48.20,Default,,0,0,0,,Мен түсіндім. Мен де солаймын.
Dialogue: 0,0:16:50.44,0:16:55.11,Default,,0,0,0,,Мен қанат емеспін! Ол қатты! Аа!?
Dialogue: 0,0:16:55.11,0:16:57.78,Default,,0,0,0,,Алғашында мектепке құлықсыз бардым, бірақ
Dialogue: 0,0:16:57.78,0:17:00.95,Default,,0,0,0,,Мен күн сайын барлығымен кездескеннен өте қызықты болдым.
Dialogue: 0,0:17:00.95,0:17:05.28,Default,,0,0,0,,Мен мұны білмей тұрып, мектепке баруды асыға күттім.
Dialogue: 0,0:17:05.28,0:17:08.62,Default,,0,0,0,,Мен сізге шындықты айтуым керек деп ойладым.
Dialogue: 0,0:17:08.62,0:17:14.06,Default,,0,0,0,,Бірақ мен оны айта алмаймын. Мен сияқты...
Dialogue: 0,0:17:14.06,0:17:17.40,Default,,0,0,0,,Кейде ауырады...
Dialogue: 0,0:17:17.40,0:17:22.10,Default,,0,0,0,,Кешіріңіз. Мен бәріне өтірік айттым.
Dialogue: 0,0:17:24.57,0:17:28.91,Default,,0,0,0,,Мен көремін. Осы уақытқа дейін бәрі байланысты.
Dialogue: 0,0:17:28.91,0:17:32.25,Default,,0,0,0,,Шынымды айтсам, мен қатты таң қалған жоқпын.
Dialogue: 0,0:17:32.25,0:17:34.91,Default,,0,0,0,,Барлығы бірдей өтірік айтады.
Dialogue: 0,0:17:34.91,0:17:38.25,Default,,0,0,0,,Дұрыс. Мен сені кінәлай алмаймын.
Dialogue: 0,0:17:38.25,0:17:40.25,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:17:40.25,0:17:42.26,Default,,0,0,0,,Барлығы қандай өтірік айтады?
Dialogue: 0,0:17:42.26,0:17:44.59,Default,,0,0,0,,Оның орнына қазір Рикка-чан!
Dialogue: 0,0:17:44.59,0:17:47.09,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:17:47.09,0:17:49.26,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:17:49.26,0:17:52.77,Default,,0,0,0,,Мен жай ғана оның ниеті ме деп сұрауым керек пе?
Dialogue: 0,0:17:52.77,0:17:56.94,Default,,0,0,0,,Бірақ сіз оған қалай жеттіңіз?
Dialogue: 0,0:17:56.94,0:17:59.94,Default,,0,0,0,,Мен мұның бәрін естідім! (Чиё) Ханзо!?
Dialogue: 0,0:17:59.94,0:18:02.61,Default,,0,0,0,,Сіз жылап көрдіңіз бе? Болмады ма!?
Dialogue: 0,0:18:02.61,0:18:06.95,Default,,0,0,0,,Уақытша бітім болды, әпке! Бұл!
Dialogue: 0,0:18:06.95,0:18:09.78,Default,,0,0,0,,♬~
Dialogue: 0,0:18:09.78,0:18:12.39,Default,,0,0,0,,О!
Dialogue: 0,0:18:12.39,0:18:16.89,Default,,0,0,0,,Ох… Уф~ Мен қатты ашпын.
Dialogue: 0,0:18:16.89,0:18:19.23,Default,,0,0,0,,Цезарь жастығын да, болашағын да босқа өткізді
Dialogue: 0,0:18:19.23,0:18:21.39,Default,,0,0,0,,Жай ғана секіру!
Dialogue: 0,0:18:21.39,0:18:24.23,Default,,0,0,0,,Кем дегенде шатырдан!
Dialogue: 0,0:18:24.23,0:18:26.23,Default,,0,0,0,,Иә? Ах.
Dialogue: 0,0:18:26.23,0:18:28.73,Default,,0,0,0,,Уау! Ханым уақыты!
Dialogue: 0,0:18:28.73,0:18:30.74,Default,,0,0,0,,О, менің...
Dialogue: 0,0:18:30.74,0:18:32.74,Default,,0,0,0,,Уф. (Цубаса) Қазір жер бетінде не болып жатыр...
Dialogue: 0,0:18:32.74,0:18:36.08,Default,,0,0,0,,Мен мұны басқа жолы түсіндіремін. (Цубаса) Иә.
Dialogue: 0,0:18:36.08,0:18:39.75,Default,,0,0,0,,Бұл жақсы. Енді мен Чио-санның көтерілуін көрдім.
Dialogue: 0,0:18:39.75,0:18:42.25,Default,,0,0,0,,Есте сақтайтын ештеңе қалмады
Dialogue: 0,0:18:42.25,0:18:44.25,Default,,0,0,0,,[Монитор] Попоперо Пеппопепо
Dialogue: 0,0:18:44.25,0:18:47.25,Default,,0,0,0,,Жоспар бойынша күн жүйесінен шығу
Dialogue: 0,0:18:47.25,0:18:50.26,Default,,0,0,0,,Содан кейін өмірді қамтамасыз ету жүйесінен басқа барлық функциялар тоқтатылады.
Dialogue: 0,0:18:50.26,0:18:52.93,Default,,0,0,0,,Рельефтік сигнал жіберу. [Монитор] Попо Пепо
Dialogue: 0,0:18:52.93,0:18:55.43,Default,,0,0,0,,Сіздің достарыңыз сигналды қабылдай ма, жоқ па
Dialogue: 0,0:18:55.43,0:18:57.76,Default,,0,0,0,,Мен білмеймін, бірақ мен тырысуым керек.
Dialogue: 0,0:18:57.76,0:18:59.76,Default,,0,0,0,,Кеттік! [Монитор] Пепо
Dialogue: 0,0:19:01.93,0:19:06.73,Default,,0,0,0,,Жарайды. Мен оны мәңгі есте сақтай аламын.
Dialogue: 0,0:19:12.04,0:19:14.55,Default,,0,0,0,,Оряоря Оряоря…
Dialogue: 0,0:19:14.55,0:19:16.55,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:18.55,0:19:20.55,Default,,0,0,0,,…қашып кету…
Dialogue: 0,0:19:29.90,0:19:33.23,Default,,0,0,0,,Мен саған айтар сөзім болғандықтан келдім.
Dialogue: 0,0:19:33.23,0:19:36.57,Default,,0,0,0,,Мен Рикка-чанмен бітіргім келеді!
Dialogue: 0,0:19:36.57,0:19:39.24,Default,,0,0,0,,Чионың өзімшілдігі Өтінемін, мені тыңда!
Dialogue: 0,0:19:39.24,0:19:42.91,Default,,0,0,0,,Чио-сан. Мен де Риккадан бөлінгім келмейді.
Dialogue: 0,0:19:42.91,0:19:46.75,Default,,0,0,0,,Мен мән-жайлар бар деп ойлаймын, бірақ сіз қайта қарастыра аласыз ба?
Dialogue: 0,0:19:46.75,0:19:49.42,Default,,0,0,0,,Секине ханым
Dialogue: 0,0:19:49.42,0:19:52.59,Default,,0,0,0,,Кенеттен қоштасудың өзі қорқынышты, Рикка.
Dialogue: 0,0:19:52.59,0:19:58.42,Default,,0,0,0,,Бәріміз өтірік айттық, бірақ дос екеніміз рас, солай ма?
Dialogue: 0,0:19:58.42,0:20:00.59,Default,,0,0,0,,Мен айтқым келген нәрсені айттым.
Dialogue: 0,0:20:00.59,0:20:03.93,Default,,0,0,0,,Менің ойымша, маңыздысы Рикканың не істегісі келетіні.
Dialogue: 0,0:20:03.93,0:20:07.27,Default,,0,0,0,,Рикка...
Dialogue: 0,0:20:07.27,0:20:11.10,Default,,0,0,0,,Рикка да барлығымен бірге оқуды бітіргісі келеді!
Dialogue: 0,0:20:11.10,0:20:13.11,Default,,0,0,0,,Олай болса солай істейік.
Dialogue: 0,0:20:13.11,0:20:15.61,Default,,0,0,0,,Көңілді естеліктер жасауды жалғастырайық
Dialogue: 0,0:20:15.61,0:20:18.44,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:20:18.44,0:20:20.61,Default,,0,0,0,,Жарайсың, Секине
Dialogue: 0,0:20:20.61,0:20:23.12,Default,,0,0,0,,Бұл өте жақсы болды.
Dialogue: 0,0:20:23.12,0:20:27.29,Default,,0,0,0,,[Монитор] Пипопоро Поппо Пепопо Попопо Попоро Попоро
Dialogue: 0,0:20:27.29,0:20:33.63,Default,,0,0,0,,[Монитор] Пеппопопо Попоропапепи Папопепипепипопоп Попопо Пепипупо
Dialogue: 0,0:20:33.63,0:20:36.30,Default,,0,0,0,,Ең алдымен! (Цубаса) Не!?
Dialogue: 0,0:20:36.30,0:20:39.30,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:39.30,0:20:42.70,Default,,0,0,0,,Қарғыс атсын, мен оны басқара алмаймын!? Басқа таңдау жоқ!
Dialogue: 0,0:20:46.97,0:20:49.98,Default,,0,0,0,,Уау! Осындай нәрсе болуы мүмкін бе деп ойлаймын!
Dialogue: 0,0:20:49.98,0:20:52.31,Default,,0,0,0,,Суық ұйықтауға арналған киім!
Dialogue: 0,0:20:52.31,0:20:55.65,Default,,0,0,0,,Мұны қазір жасаңыз!? (Чиё) Мен жақсы ұйықтай аламын деп ойлаймын.
Dialogue: 0,0:20:55.65,0:20:57.65,Default,,0,0,0,,[Монитор] Попепопо Лопурпупо
Dialogue: 0,0:21:00.32,0:21:02.82,Default,,0,0,0,,НЛО! Бұл қымбат!
Dialogue: 0,0:21:02.82,0:21:07.16,Default,,0,0,0,,Қашу құрылғысы тым күрделі емес пе!? Жарайды, дәл солай.
Dialogue: 0,0:21:07.16,0:21:09.33,Default,,0,0,0,,Бұл өтірік!
Dialogue: 0,0:21:09.33,0:21:13.93,Default,,0,0,0,,Ал қазір ойлап қарасам, мен қазірдің өзінде аман қалдым...
Dialogue: 0,0:21:13.93,0:21:17.27,Default,,0,0,0,,Бұл рас. Цубаса мырза - Цубаса мырза!
Dialogue: 0,0:21:17.27,0:21:19.77,Default,,0,0,0,,Рахмет, Чио-сан! Мен күштімін бірақ!
Dialogue: 0,0:21:19.77,0:21:23.61,Default,,0,0,0,,《Кешіріңіз, бәріңіз. Барлығын қалыпты жағдайға келтіру үшін.
Dialogue: 0,0:21:23.61,0:21:25.61,Default,,0,0,0,,Менде осы ғана қалды...》 《Полковник? 》
Dialogue: 0,0:21:25.61,0:21:27.61,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:23:04.64,0:23:07.31,Default,,0,0,0,,Жақында жоғарылату емтиханы келеді.
Dialogue: 0,0:23:07.31,0:23:10.75,Default,,0,0,0,,Дұрыс. Жарайды, Секине оңай өтеді.
Dialogue: 0,0:23:10.75,0:23:13.59,Default,,0,0,0,,Қанаттарда орын жеткіліксіз бе?
Dialogue: 0,0:23:13.59,0:23:17.76,Default,,0,0,0,,Менің ойымша, бізде бұрын мұндай алмасу болған сияқты...
Dialogue: 0,0:23:17.76,0:23:20.43,Default,,0,0,0,,Мен бір нәрсені ұмытып бара жатқандай сезінемін...
Dialogue: 0,0:23:20.43,0:23:22.43,Default,,0,0,0,,Ұйқым жетпей жатыр.
Dialogue: 0,0:23:22.43,0:23:24.93,Default,,0,0,0,,Негізі мен соңғы кездері кесте тігуге әуестеніп кеттім.
Dialogue: 0,0:23:24.93,0:23:26.93,Default,,0,0,0,,Оқу, Чио-сан!
Dialogue: 0,0:23:26.93,0:23:30.10,Default,,0,0,0,,Бұл өте нашар болады!
Dialogue: 0,0:23:30.10,0:23:33.27,Default,,0,0,0,,＜ Кіші орта мектептің қарапайым қыздары
Dialogue: 0,0:23:33.27,0:23:38.44,Default,,0,0,0,,Бұл кәдімгі таңғы көрініс сияқты...
Dialogue: 0,0:23:38.44,0:23:41.64,Default,,0,0,0,,Негізі бұл төрт адамның себебі бар＞
Dialogue: 0,0:23:43.14,0:23:49.14,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory