Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.20,0:00:14.20,Default,,0,0,0,,Ханзо!
Dialogue: 0,0:00:14.20,0:00:18.87,Default,,0,0,0,,Егер сіз мені ұра алмасаңыз, артымнан жүріп көріңіз.
Dialogue: 0,0:00:18.87,0:00:23.21,Default,,0,0,0,,Чионың әлсіз жақтарын білу керек.
Dialogue: 0,0:00:23.21,0:00:25.88,Default,,0,0,0,,Чионың әлсіздігі? Хмм
Dialogue: 0,0:00:25.88,0:00:28.55,Default,,0,0,0,,《Мұндай нәрсе болуы мүмкін емес.
Dialogue: 0,0:00:28.55,0:00:31.39,Default,,0,0,0,,Ол жастайынан кез келген жаттығуға шыдайды.
Dialogue: 0,0:00:31.39,0:00:36.22,Default,,0,0,0,,Бірде-бір әлсіреген дауысын шығармаған Чионың әлсіздігі бар еді...
Dialogue: 0,0:00:36.22,0:00:41.23,Default,,0,0,0,,Жоқ, бұрынғыдай емес, Чиё қазір...
Dialogue: 0,0:00:41.23,0:00:44.23,Default,,0,0,0,,Сіз жеңе аласыз! Бұл жолы Чиё!
Dialogue: 0,0:02:25.20,0:02:29.20,Default,,0,0,0,,Уау! Дәмді көрінеді!
Dialogue: 0,0:02:29.20,0:02:31.21,Default,,0,0,0,,Цубаса-чан да жей ме?
Dialogue: 0,0:02:31.21,0:02:34.21,Default,,0,0,0,,Жарайды, мен диетадамын.
Dialogue: 0,0:02:34.21,0:02:36.71,Default,,0,0,0,,Бұл мүлдем жұқа емес. иә?
Dialogue: 0,0:02:36.71,0:02:40.05,Default,,0,0,0,,Иә, иә. Жоқ, шынымен бе?
Dialogue: 0,0:02:40.05,0:02:44.22,Default,,0,0,0,,Шынымен, шынымен. Уфуфуфу, рахмет. Мен сондай қуаныштымын.
Dialogue: 0,0:02:44.22,0:02:46.39,Default,,0,0,0,,《Секине: Сен тым қыңырсың, солай ма?
Dialogue: 0,0:02:46.39,0:02:49.72,Default,,0,0,0,,Сіз тіпті жігітті қалайсыз ба?
Dialogue: 0,0:02:49.72,0:02:53.23,Default,,0,0,0,,Ол әрқашан сабырлы және бейтарап келбеті бар.
Dialogue: 0,0:02:53.23,0:02:55.73,Default,,0,0,0,,Қыздарға арналған мектепте оған ханзадалық сезім болды.
Dialogue: 0,0:02:55.73,0:02:59.57,Default,,0,0,0,,Олай болса, құлпынай жейік~
Dialogue: 0,0:02:59.57,0:03:02.24,Default,,0,0,0,,Мен саған өзімді де беремін. Жарайды?
Dialogue: 0,0:03:02.24,0:03:04.41,Default,,0,0,0,,Жақсы, жақсы.《Әйел беті》
Dialogue: 0,0:03:04.41,0:03:06.41,Default,,0,0,0,,<Төмен тоқтату>
Dialogue: 0,0:03:06.41,0:03:09.58,Default,,0,0,0,,Әй, дәмді!
Dialogue: 0,0:03:09.58,0:03:13.68,Default,,0,0,0,,《Цура. Барлығымыз парфе жеуге келдік.》
Dialogue: 0,0:03:13.68,0:03:15.85,Default,,0,0,0,,)
Dialogue: 0,0:03:15.85,0:03:20.69,Default,,0,0,0,,《Цубаса: Рикка мен жақсы түсінбейтін баланы алып келді.
Dialogue: 0,0:03:20.69,0:03:23.52,Default,,0,0,0,,Чио-сан және басқалары әбден қорқады.
Dialogue: 0,0:03:23.52,0:03:26.69,Default,,0,0,0,,Секиненің де көңілі көтеріліп барады.
Dialogue: 0,0:03:26.69,0:03:29.20,Default,,0,0,0,,Екі адамды да қорғау
Dialogue: 0,0:03:29.20,0:03:32.20,Default,,0,0,0,,Мен ұлдардың назарын осында аудару үшін бар күшімді салуым керек! 》
Dialogue: 0,0:03:32.20,0:03:34.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:34.20,0:03:37.20,Default,,0,0,0,,Жоқ, менмін. Менің туыстарымның бәрі атақты адамдар.
Dialogue: 0,0:03:37.20,0:03:39.37,Default,,0,0,0,,Иә?иә?
Dialogue: 0,0:03:39.37,0:03:41.38,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:41.38,0:03:44.71,Default,,0,0,0,,Иә? Шынымен бе? Керемет
Dialogue: 0,0:03:44.71,0:03:46.71,Default,,0,0,0,,Эхехе солай деп ойлаймын.
Dialogue: 0,0:03:46.71,0:03:50.22,Default,,0,0,0,,《Жарайды, бізде хромосома туралы ақпарат жеткілікті.
Dialogue: 0,0:03:50.22,0:03:53.55,Default,,0,0,0,,Бұл Секине ханымның туған күніне орай келеді.
Dialogue: 0,0:03:53.55,0:03:55.56,Default,,0,0,0,,《Не?》
Dialogue: 0,0:03:55.56,0:03:57.56,Default,,0,0,0,,<Менің миым жете алмайды>
Dialogue: 0,0:03:57.56,0:03:59.73,Default,,0,0,0,,《Менің туған күнім...
Dialogue: 0,0:03:59.73,0:04:02.23,Default,,0,0,0,,Ах! Енді ойлап қарасам, өткен күні...》
Dialogue: 0,0:04:02.23,0:04:06.90,Default,,0,0,0,,((Болашақта мен ұлыммен футбол ойнағым келеді.
Dialogue: 0,0:04:06.90,0:04:08.90,Default,,0,0,0,,...
Dialogue: 0,0:04:08.90,0:04:11.51,Default,,0,0,0,,Мен қызымды қалаймын ба?
Dialogue: 0,0:04:11.51,0:04:15.84,Default,,0,0,0,,А, Секине-чан, қызың керек пе? Иә жақсы
Dialogue: 0,0:04:15.84,0:04:17.85,Default,,0,0,0,,көремін.
Dialogue: 0,0:04:17.85,0:04:22.35,Default,,0,0,0,,Ааа, енді ойлап отырсам, Секине-чанның туған күні жақындап қалды))
Dialogue: 0,0:04:22.35,0:04:24.35,Default,,0,0,0,,Бір минут күтіңіз!
Dialogue: 0,0:04:24.35,0:04:29.19,Default,,0,0,0,,《Сіз бұл маңызды емес чатты сөзбе-сөз түсіндіріп жатырсыз ба?
Dialogue: 0,0:04:29.19,0:04:31.53,Default,,0,0,0,,Спортқа тікелей эфирде көрмейінше қызыға алмайсың
Dialogue: 0,0:04:31.53,0:04:33.53,Default,,0,0,0,,((Иә
Dialogue: 0,0:04:33.53,0:04:35.53,Default,,0,0,0,,Құттықтаймыз. Құттықтаймыз.
Dialogue: 0,0:04:35.53,0:04:38.53,Default,,0,0,0,,Туған күніңмен, Секине-чан))
Dialogue: 0,0:04:38.53,0:04:40.70,Default,,0,0,0,,Келіңіздер, бәріңіз! о?
Dialogue: 0,0:04:40.70,0:04:44.71,Default,,0,0,0,,Орындарды ауыстыратын кез келді. Орындарды ауыстырғыңыз келе ме...?
Dialogue: 0,0:04:44.71,0:04:49.21,Default,,0,0,0,,Иә! Ішінде өзіңізге ұнайтын адамның жанына отырыңыз.
Dialogue: 0,0:04:49.21,0:04:52.21,Default,,0,0,0,,<Білімді қайдан алдың?>
Dialogue: 0,0:04:52.21,0:04:56.72,Default,,0,0,0,,Ал, Секине-чаннан бастап орындарымызды ауыстырайық.
Dialogue: 0,0:04:56.72,0:04:59.22,Default,,0,0,0,,Кімнің жанында болғың келеді?
Dialogue: 0,0:04:59.22,0:05:01.39,Default,,0,0,0,,Мм... (3 адам) А?
Dialogue: 0,0:05:01.39,0:05:03.39,Default,,0,0,0,,Мен...
Dialogue: 0,0:05:03.39,0:05:07.39,Default,,0,0,0,,Мен бірде-бір жаман адам жоқ деп ойладым.
Dialogue: 0,0:05:07.39,0:05:12.00,Default,,0,0,0,,Ах...｡ Ах, не?
Dialogue: 0,0:05:12.00,0:05:15.67,Default,,0,0,0,,Мүмкін Секине-чан цундере түрі шығар?
Dialogue: 0,0:05:15.67,0:05:19.67,Default,,0,0,0,,Немесе... Мені қате түсінбеңіз! сурет?
Dialogue: 0,0:05:19.67,0:05:23.51,Default,,0,0,0,,Мен сенің балаларыңның ешқайсысын алғым келмейді!
Dialogue: 0,0:05:23.51,0:05:25.85,Default,,0,0,0,,оның шынымен білмегенінің дәлелі.
Dialogue: 0,0:05:25.85,0:05:31.19,Default,,0,0,0,,《Қарғыс атсын! Дәл қазір, бұл жерде мен қателеспес, қателескен, боқ әйелмін
Dialogue: 0,0:05:31.19,0:05:33.52,Default,,0,0,0,,Бірақ мен мұны ғана айта аламын...》
Dialogue: 0,0:05:33.52,0:05:37.69,Default,,0,0,0,,Сондай-ақ... Секине болсам ғой. Ол сондай керемет~
Dialogue: 0,0:05:37.69,0:05:41.03,Default,,0,0,0,,《Не!? Олай болса Мисс Цубасаға ұл беріңіз! 》
Dialogue: 0,0:05:41.03,0:05:44.20,Default,,0,0,0,,Ха! Куораа~ Цубаса!
Dialogue: 0,0:05:44.20,0:05:46.20,Default,,0,0,0,,Ха! Тат! Бюро!
Dialogue: 0,0:05:46.20,0:05:49.87,Default,,0,0,0,,Жігіттерге ұнайды... Жігіттерге мынандай...
Dialogue: 0,0:05:49.87,0:05:53.21,Default,,0,0,0,,Мұндай адамдар жойылып кетуі керек түр!
Dialogue: 0,0:05:53.21,0:05:55.88,Default,,0,0,0,,Басқаша айтқанда, адамзат жойылады!
Dialogue: 0,0:05:55.88,0:05:58.28,Default,,0,0,0,,Бұл не?!
Dialogue: 0,0:06:00.21,0:06:03.55,Default,,0,0,0,,Жарайды... тезірек үйге баруым керек.
Dialogue: 0,0:06:03.55,0:06:06.22,Default,,0,0,0,,Біз алдымен есепшотты төлейміз.
Dialogue: 0,0:06:06.22,0:06:08.22,Default,,0,0,0,,Олай болса...
Dialogue: 0,0:06:08.22,0:06:13.49,Default,,0,0,0,,<Түсінбеген қыздан қауіпті адамға дейін көтерілу
Dialogue: 0,0:06:13.49,0:06:20.17,Default,,0,0,0,,Тыныш-ақ, судың суығандай, ұлдар кетіп қалды>
Dialogue: 0,0:06:20.17,0:06:24.17,Default,,0,0,0,,Секине: Сенің қазіргі көзқарасың сәл болды... Уф.
Dialogue: 0,0:06:24.17,0:06:28.18,Default,,0,0,0,,Оны басқаша айту мүмкін емес пе еді?
Dialogue: 0,0:06:28.18,0:06:31.18,Default,,0,0,0,,Мен ештеңе білмесем де
Dialogue: 0,0:06:31.18,0:06:35.35,Default,,0,0,0,,Бұл әйелдің бетін пирсинг тітіркендіреді! Сіз осылай танымал болғыңыз келе ме?
Dialogue: 0,0:06:35.35,0:06:37.35,Default,,0,0,0,,Ха ха!?
Dialogue: 0,0:06:37.35,0:06:41.02,Default,,0,0,0,,《Мен әркімнің сөйлеуге мәжбүр болғанын қаламаймын.
Dialogue: 0,0:06:41.02,0:06:44.19,Default,,0,0,0,,Мен бар күшімді салсам да...》
Dialogue: 0,0:06:44.19,0:06:51.20,Default,,0,0,0,,Мен... Еркектерге ұнамды боламын деген ниетім жоқ!
Dialogue: 0,0:06:51.20,0:06:56.20,Default,,0,0,0,,Мен қазір үйге бара жатырмын. О, Цубаса-сан!
Dialogue: 0,0:06:56.20,0:06:58.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:00.21,0:07:03.88,Default,,0,0,0,,《Осындай жағдайда айту қиын.
Dialogue: 0,0:07:03.88,0:07:05.88,Default,,0,0,0,,Мені кездесуге шақырды...》
Dialogue: 0,0:07:05.88,0:07:07.88,Default,,0,0,0,,Не!
Dialogue: 0,0:07:07.88,0:07:10.08,Default,,0,0,0,,《Полковник, қашан!?》
Dialogue: 0,0:07:12.32,0:07:15.16,Default,,0,0,0,,Ах, Рикка-чан
Dialogue: 0,0:07:15.16,0:07:17.16,Default,,0,0,0,,(ызылдаған)
Dialogue: 0,0:07:17.16,0:07:20.83,Default,,0,0,0,,Күткеніңізге рахмет! Жоқ, мен мұнда жаңа келдім
Dialogue: 0,0:07:20.83,0:07:22.83,Default,,0,0,0,,Эхехе
Dialogue: 0,0:07:22.83,0:07:25.17,Default,,0,0,0,,Мен сенің соңынан ердім
Dialogue: 0,0:07:25.17,0:07:28.84,Default,,0,0,0,,Отырыңыз. Иә.
Dialogue: 0,0:07:28.84,0:07:31.00,Default,,0,0,0,,《Мен байсалды бола аламын.
Dialogue: 0,0:07:31.00,0:07:33.67,Default,,0,0,0,,Сіз менің серігім сияқты мінсізсіз.》
Dialogue: 0,0:07:33.67,0:07:35.84,Default,,0,0,0,,《Жоқ, бұл жер бетінде
Dialogue: 0,0:07:35.84,0:07:40.18,Default,,0,0,0,,Хиоку Ренриге серіктес тапсам ше?
Dialogue: 0,0:07:40.18,0:07:42.18,Default,,0,0,0,,《Чоро...
Dialogue: 0,0:07:42.18,0:07:46.19,Default,,0,0,0,,Осындай жалқау адамның полковник болғаны дұрыс па деп ойлаймын.
Dialogue: 0,0:07:46.19,0:07:51.19,Default,,0,0,0,,Не? Не? Не? Чи... Чио-сан!?
Dialogue: 0,0:07:51.19,0:07:54.03,Default,,0,0,0,,Уф. 《Кешіріңіз Рикка Чан》
Dialogue: 0,0:07:54.03,0:07:56.20,Default,,0,0,0,,Құт
Dialogue: 0,0:07:56.20,0:07:59.70,Default,,0,0,0,,Досыңызды кепілге алу стратегиясын көрдіңіз бе?
Dialogue: 0,0:07:59.70,0:08:03.37,Default,,0,0,0,,Әрине, Ханзо. Сізден күткендей, әпке.
Dialogue: 0,0:08:03.37,0:08:05.71,Default,,0,0,0,,《Не? Олар ағайынды болды》
Dialogue: 0,0:08:05.71,0:08:08.38,Default,,0,0,0,,Бірақ оның асығыстығына қарап,
Dialogue: 0,0:08:08.38,0:08:11.81,Default,,0,0,0,,Әпкеңнің осал тұсы достары болған сияқты.
Dialogue: 0,0:08:11.81,0:08:14.65,Default,,0,0,0,,Қарғыс атсын! Қандай жексұрын!
Dialogue: 0,0:08:14.65,0:08:19.15,Default,,0,0,0,,Арамызға сен келгендіктен, достығымыз бұзылды!
Dialogue: 0,0:08:19.15,0:08:21.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:21.15,0:08:23.49,Default,,0,0,0,,((Олай болса, құлпынай жейміз~
Dialogue: 0,0:08:23.49,0:08:27.49,Default,,0,0,0,,Мен саған өзімді де беремін. Жарайды? Ахх))
Dialogue: 0,0:08:27.49,0:08:30.16,Default,,0,0,0,,《Мүмкін бұл Ханзоның кінәсі шығар》
Dialogue: 0,0:08:30.16,0:08:33.50,Default,,0,0,0,,Сол Цубаса деген қыздың ер адамға байланғаны үшін бе?
Dialogue: 0,0:08:33.50,0:08:36.67,Default,,0,0,0,,Ти! Ғашық болатын жасыңыз!
Dialogue: 0,0:08:36.67,0:08:40.17,Default,,0,0,0,,Хмф, келесі жолы сөзсіз!
Dialogue: 0,0:08:40.17,0:08:42.68,Default,,0,0,0,,Сондықтан, егер Урарака ханым алғашқы қадамды жасаса…
Dialogue: 0,0:08:42.68,0:08:46.51,Default,,0,0,0,,Эй Чио-сан, мұнда бала жоқ па?
Dialogue: 0,0:08:46.51,0:08:51.69,Default,,0,0,0,,Ол кісі қыздардың жүрегімен ойнайтын үлкен жауыз еді!
Dialogue: 0,0:08:51.69,0:08:56.52,Default,,0,0,0,,Не? Дұрыс... Жүрегім ауырды.
Dialogue: 0,0:08:56.52,0:08:59.19,Default,,0,0,0,,《Чиё: Қандай мұңды жүз...》
Dialogue: 0,0:08:59.19,0:09:01.86,Default,,0,0,0,,Кешіріңіз. Бұл менің кінәм.
Dialogue: 0,0:09:01.86,0:09:05.53,Default,,0,0,0,,Бәрін мұңайттым.
Dialogue: 0,0:09:05.53,0:09:09.53,Default,,0,0,0,,Чио-санның еш кінәсі жоқ.
Dialogue: 0,0:09:11.81,0:09:14.14,Default,,0,0,0,,Және Рикка
Dialogue: 0,0:09:14.14,0:09:19.15,Default,,0,0,0,,Чио-сан мені өзімшіл дейтін болса, мен бақытты болар едім.
Dialogue: 0,0:09:19.15,0:09:21.65,Default,,0,0,0,,Рикка-чан
Dialogue: 0,0:09:21.65,0:09:23.82,Default,,0,0,0,,♬~
Dialogue: 0,0:09:23.82,0:09:27.82,Default,,0,0,0,,《Қош бол, махаббатым》
Dialogue: 0,0:09:33.16,0:09:35.16,Default,,0,0,0,,Ах
Dialogue: 0,0:09:35.16,0:09:38.67,Default,,0,0,0,,Қайырлы күн Цубаса-сан. Қайырлы таң!
Dialogue: 0,0:09:38.67,0:09:41.17,Default,,0,0,0,,Түрлі оқиғаларға араласып жүріп—
Dialogue: 0,0:09:41.17,0:09:43.67,Default,,0,0,0,,Иә? кінә?
Dialogue: 0,0:09:43.67,0:09:47.34,Default,,0,0,0,,Бір нәрсе әдеттегіден басқаша болып көрінеді.
Dialogue: 0,0:09:47.34,0:09:50.01,Default,,0,0,0,,Мен күткендей, кеше болған оқиға әлі есімде...
Dialogue: 0,0:09:50.01,0:09:55.18,Default,,0,0,0,,Цубаса мырза. Мен кеше бір нәрсе туралы айтқым келеді ...
Dialogue: 0,0:09:55.18,0:09:57.18,Default,,0,0,0,,Кешегі күн ше? иә
Dialogue: 0,0:09:57.18,0:09:59.69,Default,,0,0,0,,Секине мырзамен ұрысып қалдыңыз.
Dialogue: 0,0:09:59.69,0:10:03.19,Default,,0,0,0,,Сіз таң қалдырғаныңызға сенімдімін, бірақ өтінемін...
Dialogue: 0,0:10:03.19,0:10:07.03,Default,,0,0,0,,Ах~ Маған мүлдем бәрібір. (2 адам) Иә?
Dialogue: 0,0:10:07.03,0:10:11.53,Default,,0,0,0,,Бұған тек кішкентай ер адамдар ғана мән береді.
Dialogue: 0,0:10:11.53,0:10:15.87,Default,,0,0,0,,Ах...мырза. Секине, сұрағаныңызға рахмет.
Dialogue: 0,0:10:15.87,0:10:17.87,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:10:20.71,0:10:23.88,Default,,0,0,0,,Кеше үшін кешірім сұраймын
Dialogue: 0,0:10:23.88,0:10:26.88,Default,,0,0,0,,Керемет! Секине-чан
Dialogue: 0,0:10:26.88,0:10:30.55,Default,,0,0,0,,Мен бұл шаш үлгісін Цубаса-чанмен жасанғым келгендіктен таңдадым!
Dialogue: 0,0:10:30.55,0:10:32.55,Default,,0,0,0,,Не? Цубасаның сүйіктісі
Dialogue: 0,0:10:32.55,0:10:37.39,Default,,0,0,0,,Мен оны жарлық стилінде орналастырдым. Саған өте жарасады!
Dialogue: 0,0:10:37.39,0:10:39.73,Default,,0,0,0,,Уф... мен емес.
Dialogue: 0,0:10:39.73,0:10:43.06,Default,,0,0,0,,Мен оны аздап өзгертейін деп ойладым.
Dialogue: 0,0:10:43.06,0:10:46.23,Default,,0,0,0,,《Сүйкімді》
Dialogue: 0,0:10:46.23,0:10:48.24,Default,,0,0,0,,Не? (ысырма дыбысы)
Dialogue: 0,0:10:48.24,0:10:50.24,Default,,0,0,0,,Иә! Апыр-ай!
Dialogue: 0,0:10:50.24,0:10:53.24,Default,,0,0,0,,Қыздар мектебі көңілді!
Dialogue: 0,0:10:53.24,0:10:57.41,Default,,0,0,0,,《Мен өзім аңсаған Такеин орта мектебіне бара аламын.
Dialogue: 0,0:10:57.41,0:11:00.08,Default,,0,0,0,,Алмасуды тоқтатамын дегеніңізге қуаныштымын.
Dialogue: 0,0:11:00.08,0:11:03.75,Default,,0,0,0,,Менің әпкем достардың нақты тобы жоқ екенін айтты.
Dialogue: 0,0:11:03.75,0:11:06.35,Default,,0,0,0,,Тезірек үйреніп кетесің деп үміттенемін》
Dialogue: 0,0:11:08.42,0:11:10.36,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:10.36,0:11:12.36,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:11:12.36,0:11:17.03,Default,,0,0,0,,Тынш... ол сөйледі. Мен камераның дауысын бірінші рет естідім.
Dialogue: 0,0:11:17.03,0:11:19.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:19.70,0:11:21.70,Default,,0,0,0,,Қайырлы таң.
Dialogue: 0,0:11:21.70,0:11:24.37,Default,,0,0,0,,Иә! Қайырлы таң
Dialogue: 0,0:11:24.37,0:11:28.88,Default,,0,0,0,,Сәлем айтасың. Мен таң қалдым.
Dialogue: 0,0:11:28.88,0:11:32.38,Default,,0,0,0,,Э? Эм…
Dialogue: 0,0:11:32.38,0:11:34.38,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:11:36.88,0:11:40.22,Default,,0,0,0,,Иә. Сіз не істеп жатырсыз, әпке?
Dialogue: 0,0:11:40.22,0:11:44.72,Default,,0,0,0,,Цуйоши-кун, солай ма? иә? Ал...
Dialogue: 0,0:11:44.72,0:11:48.90,Default,,0,0,0,,Бұл менің сыныптасым Ханзава. Наозо Ханзава
Dialogue: 0,0:11:48.90,0:11:53.07,Default,,0,0,0,,Кешіріңіз... Кешіріңіз. Бір сыныпта оқитын болсақ та, мен сенің атыңды да білмеймін.
Dialogue: 0,0:11:53.07,0:11:58.07,Default,,0,0,0,,Бұл маңызды емес. Мен жақында ғана осында көшіп келдім.
Dialogue: 0,0:11:58.07,0:12:00.91,Default,,0,0,0,,Есіміңізде қалмауы заңдылық.
Dialogue: 0,0:12:00.91,0:12:05.58,Default,,0,0,0,,Көрші есік жақсы ма? Иә
Dialogue: 0,0:12:05.58,0:12:09.75,Default,,0,0,0,,《Мен бұл мектепке ауылдан тыс жерде тұруға үйрену үшін түстім, бірақ...
Dialogue: 0,0:12:09.75,0:12:13.85,Default,,0,0,0,,Чиё досының інісіне жақындай алатының қызық.
Dialogue: 0,0:12:13.85,0:12:19.19,Default,,0,0,0,,Мен Чио туралы пайдалы ақпарат жинай аламын.
Dialogue: 0,0:12:19.19,0:12:21.19,Default,,0,0,0,,Мен… (Дамиан) Хм. Тек балалар ойыны ғой.
Dialogue: 0,0:12:21.19,0:12:23.86,Default,,0,0,0,,Жаңа ғана күрсіндіңіз, жақсы ма?
Dialogue: 0,0:12:23.86,0:12:28.20,Default,,0,0,0,,Иә, жақсы. Ханзава-кунның бауырлары бар ма?
Dialogue: 0,0:12:28.20,0:12:31.04,Default,,0,0,0,,Аа, иә, менің үлкен әпкем бар.
Dialogue: 0,0:12:31.04,0:12:34.21,Default,,0,0,0,,Менің де егіз әпкем бар.
Dialogue: 0,0:12:34.21,0:12:39.55,Default,,0,0,0,,Ол шынымен де жынды жігіт, сәл есінен танып қалған ғой, солай емес пе?
Dialogue: 0,0:12:39.55,0:12:43.88,Default,,0,0,0,,Дұрыс. Мен де әпкеммен үнемі кездесіп қаламын.
Dialogue: 0,0:12:43.88,0:12:47.39,Default,,0,0,0,,Менің әпкем күшті, сондықтан оны жеңу қиын.
Dialogue: 0,0:12:47.39,0:12:50.72,Default,,0,0,0,,Бір күні ол екі еселенеді! Мен тырысамын деп ойлаймын
Dialogue: 0,0:12:50.72,0:12:54.23,Default,,0,0,0,,《Оны қайтарғыңыз келе ме? Егер сіз осындай нәрсе жасағыңыз келсе...》
Dialogue: 0,0:12:54.23,0:12:58.23,Default,,0,0,0,,)
Dialogue: 0,0:12:58.23,0:13:00.23,Default,,0,0,0,,Иә.
Dialogue: 0,0:13:00.23,0:13:04.91,Default,,0,0,0,,Қаласаңыз, мектептен кейін күнделікті шағымдарыңызды неге айтпайсыз?
Dialogue: 0,0:13:04.91,0:13:09.08,Default,,0,0,0,,Олай болса, вокзал алдындағы кафеде торт жеп отырып сөйлесейік.
Dialogue: 0,0:13:09.08,0:13:12.85,Default,,0,0,0,,Торт? Жарайды, бірақ қызға ұқсайды.
Dialogue: 0,0:13:12.85,0:13:14.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:14.85,0:13:18.18,Default,,0,0,0,,《Түсіндім... Бұл қыз сияқты ма?》
Dialogue: 0,0:13:18.18,0:13:20.18,Default,,0,0,0,,Мен… (Дамиан) Хм. Тек балалар ойыны ғой.
Dialogue: 0,0:13:22.19,0:13:24.52,Default,,0,0,0,,Әпке! иә?
Dialogue: 0,0:13:24.52,0:13:26.86,Default,,0,0,0,,Белгілі бір жақын топтың болмауы
Dialogue: 0,0:13:26.86,0:13:30.36,Default,,0,0,0,,Менің достарым жоқ деген дұрыс емес! Немесе дұрысырақ
Dialogue: 0,0:13:30.36,0:13:33.70,Default,,0,0,0,,Мен тіпті сыныптастарыммен амандасып көрмегеніме сене алар емеспін!
Dialogue: 0,0:13:33.70,0:13:37.20,Default,,0,0,0,,Мен пұттардың сұлулығын жазу үшін мектепке бара жатырмын.
Dialogue: 0,0:13:37.20,0:13:40.37,Default,,0,0,0,,Қарапайым адамдармен кездескенде не істейсің?
Dialogue: 0,0:13:40.37,0:13:43.88,Default,,0,0,0,,Мен бұл атмосфераға шыдай алмаймын.
Dialogue: 0,0:13:43.88,0:13:46.71,Default,,0,0,0,,Мен бір адаммен тіл табыса аламын деп ойладым.
Dialogue: 0,0:13:46.71,0:13:50.22,Default,,0,0,0,,Бастапқы мектепке оралу. О иә.
Dialogue: 0,0:13:54.22,0:13:56.72,Default,,0,0,0,,Қайырлы таң, Цубаса-чан!
Dialogue: 0,0:13:56.72,0:13:58.73,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:13:58.73,0:14:01.23,Default,,0,0,0,,《Әй, достардың болғаны қандай жақсы》
Dialogue: 0,0:14:01.23,0:14:04.90,Default,,0,0,0,,А... білесің бе, Цубаса-чан. иә? не?
Dialogue: 0,0:14:04.90,0:14:09.07,Default,,0,0,0,,Ал, суретке түскенде бірдеңе айтайық.
Dialogue: 0,0:14:09.07,0:14:12.01,Default,,0,0,0,,Бұл бүкіл ғаламға ортақ түсінік.
Dialogue: 0,0:14:12.01,0:14:14.84,Default,,0,0,0,,Ах. (2 адам) Ух...
Dialogue: 0,0:14:14.84,0:14:18.24,Default,,0,0,0,,《Ол да осында!?》
Dialogue: 0,0:14:24.18,0:14:26.52,Default,,0,0,0,,Секине туған күнің құтты болсын. Құттықтаймыз!
Dialogue: 0,0:14:26.52,0:14:29.52,Default,,0,0,0,,Құттықтаймыз! Сізге көп рахмет
Dialogue: 0,0:14:29.52,0:14:32.19,Default,,0,0,0,,Иә, бұл сыйлық.
Dialogue: 0,0:14:32.19,0:14:35.53,Default,,0,0,0,,Секине мырзаға жарасатын шашқа әшекей жасадым.
Dialogue: 0,0:14:35.53,0:14:37.53,Default,,0,0,0,,Рахмет Чиё-сан
Dialogue: 0,0:14:37.53,0:14:40.37,Default,,0,0,0,,Мен кекстер пісірдім. Қаласаңыз, оларды жеңіз.
Dialogue: 0,0:14:40.37,0:14:42.37,Default,,0,0,0,,Қолмен жасалған ба?
Dialogue: 0,0:14:42.37,0:14:45.54,Default,,0,0,0,,Иә. Соңғы кездері тәттілер жасауға құмар болдым.
Dialogue: 0,0:14:45.54,0:14:48.21,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:14:48.21,0:14:51.88,Default,,0,0,0,,Рикка ерекше сыйлық әкелді.
Dialogue: 0,0:14:51.88,0:14:53.88,Default,,0,0,0,,Не! «Не? 》
Dialogue: 0,0:14:53.88,0:14:57.22,Default,,0,0,0,,Ол сондай сүйкімді қыз!
Dialogue: 0,0:14:57.22,0:15:00.22,Default,,0,0,0,,《Сіз бас тартқан жоқсыз ба, полковник?》
Dialogue: 0,0:15:00.22,0:15:03.22,Default,,0,0,0,,((Сәлеметсіз бе Чурн Бабу!
Dialogue: 0,0:15:03.22,0:15:06.06,Default,,0,0,0,,Мен анамның суретін салдым. Ол бірінші сынып оқушысы))
Dialogue: 0,0:15:06.06,0:15:08.40,Default,,0,0,0,,Ух... у...
Dialogue: 0,0:15:08.40,0:15:11.83,Default,,0,0,0,,《Сыйлық өте сәтті болды, өйткені ол қатты қуанып, жылап жіберді.》
Dialogue: 0,0:15:11.83,0:15:14.17,Default,,0,0,0,,《Мен не істеуім керек?
Dialogue: 0,0:15:14.17,0:15:17.17,Default,,0,0,0,,Алайда бұл дүниеге келген бала кінәлі емес.
Dialogue: 0,0:15:17.17,0:15:20.51,Default,,0,0,0,,Ха... Айтпақшы, сенің әкең кім?
Dialogue: 0,0:15:20.51,0:15:24.84,Default,,0,0,0,,Әке? Хмм... Аа, бұл ниндзя ғой!
Dialogue: 0,0:15:24.84,0:15:26.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:26.85,0:15:31.35,Default,,0,0,0,,《Ханзо! 》 Ниндзя? Қай жерде?
Dialogue: 0,0:15:31.35,0:15:34.52,Default,,0,0,0,,Қараңдаршы... не?
Dialogue: 0,0:15:34.52,0:15:36.86,Default,,0,0,0,,《Ханзо! 》
Dialogue: 0,0:15:36.86,0:15:41.69,Default,,0,0,0,,《Ханзо: Мен Чиёның досының інісінен көп мәлімет ала алмадым.
Dialogue: 0,0:15:41.69,0:15:44.20,Default,,0,0,0,,Келесі жолы сәтсіздікке ұшырау мүмкін емес
Dialogue: 0,0:15:44.20,0:15:47.70,Default,,0,0,0,,Чио досынан алыста жүргенде мен мұны істедім...》
Dialogue: 0,0:15:49.70,0:15:51.70,Default,,0,0,0,,Уф!
Dialogue: 0,0:15:51.70,0:15:56.54,Default,,0,0,0,,Сіз қазір біреумен кездесіп жүрсіз бе?
Dialogue: 0,0:15:56.54,0:15:58.88,Default,,0,0,0,,Иә!? Жоқ... бірақ мен жоқпын.
Dialogue: 0,0:15:58.88,0:16:00.88,Default,,0,0,0,,Шит… шит…
Dialogue: 0,0:16:00.88,0:16:05.55,Default,,0,0,0,,Сонымен, сіз қалай ойлайсыз? Ең алдымен некені тіркеу...
Dialogue: 0,0:16:05.55,0:16:08.56,Default,,0,0,0,,А-а... жоқ, күте тұрыңыз, бұл...
Dialogue: 0,0:16:08.56,0:16:13.49,Default,,0,0,0,,А, дұрыс. Онда неге біз Dada ID айырбастамасқа?
Dialogue: 0,0:16:13.49,0:16:16.16,Default,,0,0,0,,Уф... Жоқ, күдіктенбе!
Dialogue: 0,0:16:16.16,0:16:18.67,Default,,0,0,0,,Бұл... бір көргеннен махаббат!
Dialogue: 0,0:16:18.67,0:16:20.67,Default,,0,0,0,,《Бұл жағдайда!?》
Dialogue: 0,0:16:20.67,0:16:25.00,Default,,0,0,0,,Өтінемін! Мен үшін... жоқ, біздің қызымыз!
Dialogue: 0,0:16:25.00,0:16:28.84,Default,,0,0,0,,Сен менің досыма не істеп жатырсың? Ханзо
Dialogue: 0,0:16:28.84,0:16:31.51,Default,,0,0,0,,Мен бірдеңе істеп жатқан адаммын!
Dialogue: 0,0:16:31.51,0:16:33.68,Default,,0,0,0,,《Жоқ, мен өлдім деп тұрмын! 》
Dialogue: 0,0:16:33.68,0:16:39.18,Default,,0,0,0,,Секине мырза? Мен сені бүгін кешірмеймін! Ах!
Dialogue: 0,0:16:43.19,0:16:46.86,Default,,0,0,0,,«Әпкеме.Ауылды сатқанның жазасы.
Dialogue: 0,0:16:46.86,0:16:49.20,Default,,0,0,0,,қабылдануы керек
Dialogue: 0,0:16:49.20,0:16:54.20,Default,,0,0,0,,Мен пәктік сезімі күштірек дос таңдауым керек пе?» Не?
Dialogue: 0,0:16:54.20,0:16:57.20,Default,,0,0,0,,Әй, бәрі осындай жерде болды. Рикка!
Dialogue: 0,0:16:57.20,0:16:59.71,Default,,0,0,0,,Секине-чан, мен бір нәрсені ұмытып қалдым.
Dialogue: 0,0:16:59.71,0:17:03.21,Default,,0,0,0,,А, а, жоқ, бұл... А?
Dialogue: 0,0:17:05.71,0:17:08.21,Default,,0,0,0,,Иә!? Бабу!
Dialogue: 0,0:17:08.21,0:17:10.15,Default,,0,0,0,,《Ғарыш сегізаяқ!?》
Dialogue: 0,0:17:10.15,0:17:15.49,Default,,0,0,0,,Менің қызым сияқты сүйкімді шығар. Бірақ сіз оған байланған соң, ол жібермейді.
Dialogue: 0,0:17:15.49,0:17:18.49,Default,,0,0,0,,Абайлаңыз! 《Сен бала емес пе едің?
Dialogue: 0,0:17:18.49,0:17:21.19,Default,,0,0,0,,Мен Ханзоға тұрмысқа шыға жаздадым! 》
Dialogue: 0,0:17:28.17,0:17:30.17,Default,,0,0,0,,Мен… (Дамиан) Хм. Тек балалар ойыны ғой.
Dialogue: 0,0:17:30.17,0:17:32.17,Default,,0,0,0,,《Аа~ менің бос уақытым бар》
Dialogue: 0,0:17:32.17,0:17:35.84,Default,,0,0,0,,Иә? Ол Цуйошидің әпкесі емес пе?
Dialogue: 0,0:17:35.84,0:17:39.35,Default,,0,0,0,,А, бұл Ханзава-кун.
Dialogue: 0,0:17:39.35,0:17:42.85,Default,,0,0,0,,Біз бірінші рет кездесіп тұрмыз. Неге маған атымды айттың?
Dialogue: 0,0:17:42.85,0:17:48.52,Default,,0,0,0,,А-а... Ханзава-кунның мінез-құлқы туралы інімнен естідім.
Dialogue: 0,0:17:48.52,0:17:53.36,Default,,0,0,0,,Солай ма? Әңгімені Цюоши-куннан да естідім.
Dialogue: 0,0:17:53.36,0:17:57.70,Default,,0,0,0,,Мен сізге байқаусызда қоңырау шалдым. Мазасыздық болды, солай ма?
Dialogue: 0,0:17:57.70,0:17:59.70,Default,,0,0,0,,Аа, жоқ, шынымен емес.
Dialogue: 0,0:17:59.70,0:18:04.37,Default,,0,0,0,,Мен құрбымның дүкен аралап біткенін күтіп зеріктім. Менің қасыма отырғың келе ме?
Dialogue: 0,0:18:04.37,0:18:09.54,Default,,0,0,0,,Иә. Қаласаңыз, мен кофе алғым келеді. Рақмет сізге.
Dialogue: 0,0:18:09.54,0:18:11.81,Default,,0,0,0,,Неге келдің, Ханзава-кун?
Dialogue: 0,0:18:11.81,0:18:14.65,Default,,0,0,0,,Менің біраз сатып алуым керек.
Dialogue: 0,0:18:14.65,0:18:17.82,Default,,0,0,0,,Ойлап қарасам, Цюоши-куннан естідім.
Dialogue: 0,0:18:17.82,0:18:20.82,Default,,0,0,0,,Менің әпкем сүйкімді нәрселерге бейім.
Dialogue: 0,0:18:20.82,0:18:25.16,Default,,0,0,0,,Дұрыс. Мен сүйкімді заттарды және әдемі жігіттерді жақсы көремін.
Dialogue: 0,0:18:25.16,0:18:28.66,Default,,0,0,0,,Мен тіпті ініме де сүйкімді киім кигіземін!
Dialogue: 0,0:18:28.66,0:18:30.66,Default,,0,0,0,,(Ллойд) Бүгінгі серуен — немесе дұрысы, «Үккі» операциясы
Dialogue: 0,0:18:30.66,0:18:33.83,Default,,0,0,0,,Менде де осындай жағдай болды.
Dialogue: 0,0:18:33.83,0:18:36.00,Default,,0,0,0,,Солай ма? иә
Dialogue: 0,0:18:36.00,0:18:39.17,Default,,0,0,0,,Менің әпкем әрқашан сүйкімді нәрселерді жақсы көреді.
Dialogue: 0,0:18:39.17,0:18:42.77,Default,,0,0,0,,Өйткені ол мені қарындасындай жақсы көретін.
Dialogue: 0,0:18:44.84,0:18:46.85,Default,,0,0,0,,((Хмф! Ха!
Dialogue: 0,0:18:46.85,0:18:49.18,Default,,0,0,0,,Хмф! Әпке?
Dialogue: 0,0:18:49.18,0:18:52.85,Default,,0,0,0,,Сүйкімді болсаң, артта қал! Әпке!?
Dialogue: 0,0:18:52.85,0:18:56.86,Default,,0,0,0,,Ух... у...｡ Ах!
Dialogue: 0,0:18:56.86,0:18:59.53,Default,,0,0,0,,А... Әпке?
Dialogue: 0,0:18:59.53,0:19:03.20,Default,,0,0,0,,Сүйкімді болсаң, артта қал! Әпке!?
Dialogue: 0,0:19:03.20,0:19:05.37,Default,,0,0,0,,(Дарио) Бұл нағыз апат. Бұл жігіт те сол жерде-ақ қаза тапты. ➡
Dialogue: 0,0:19:05.37,0:19:08.37,Default,,0,0,0,,Ха!
Dialogue: 0,0:19:08.37,0:19:11.80,Default,,0,0,0,,Әпке? Сүйкімді болсаң, артта қал...
Dialogue: 0,0:19:11.80,0:19:13.81,Default,,0,0,0,,Әпке!?
Dialogue: 0,0:19:13.81,0:19:17.48,Default,,0,0,0,,Мынау... мынау... менің қолымнан шыққан туынды.
Dialogue: 0,0:19:17.48,0:19:21.31,Default,,0,0,0,,Менің ойымша, сүйкімді бенто сүйкімді адамға жақсы көрінеді.
Dialogue: 0,0:19:21.31,0:19:27.65,Default,,0,0,0,,А... Рахмет, апа. Хехе))
Dialogue: 0,0:19:27.65,0:19:32.66,Default,,0,0,0,,Менің әпкем мені үнемі қорғайтын, шектен тыс қорғанатын.
Dialogue: 0,0:19:32.66,0:19:36.33,Default,,0,0,0,,Ол күшті, бұлшықетті және салқын болды.
Dialogue: 0,0:19:36.33,0:19:40.33,Default,,0,0,0,,Эй, мен Ханзава-кунның үлкен әпкесімен танысқым келеді.
Dialogue: 0,0:19:40.33,0:19:44.17,Default,,0,0,0,,Бірақ қазір өзімді басқа адам сияқты сезінемін.
Dialogue: 0,0:19:44.17,0:19:48.17,Default,,0,0,0,,Отбасына опасыздық жасау, түкке тұрғысыз нәрседен бас тарту
Dialogue: 0,0:19:48.17,0:19:50.84,Default,,0,0,0,,Эй... бұл көп қиындық сияқты.
Dialogue: 0,0:19:50.84,0:19:55.01,Default,,0,0,0,,Жарайды, олар еркіндік жағынан бізге ұқсайтын шығар.
Dialogue: 0,0:19:55.01,0:19:57.85,Default,,0,0,0,,Шынымды айтсам, апама қарасам
Dialogue: 0,0:19:57.85,0:20:00.85,Default,,0,0,0,,Қызғанатын кезім болады.
Dialogue: 0,0:20:00.85,0:20:04.86,Default,,0,0,0,,Мен осылай өмір сүрсем ғой. Хаа.
Dialogue: 0,0:20:04.86,0:20:09.70,Default,,0,0,0,,А, жоқ, інім осылай деді. Ахахаха
Dialogue: 0,0:20:09.70,0:20:12.03,Default,,0,0,0,,Сіз қызғанасыз ба?
Dialogue: 0,0:20:12.03,0:20:14.03,Default,,0,0,0,,()
Dialogue: 0,0:20:14.03,0:20:16.20,Default,,0,0,0,,Мен, әрине, солай ойлаймын.
Dialogue: 0,0:20:16.20,0:20:20.21,Default,,0,0,0,,Інім қиналып жатыр. Олар ағайынды.
Dialogue: 0,0:20:20.21,0:20:24.21,Default,,0,0,0,,Бір-бірімізді түсінетін уақыт келеді деп сенемін.
Dialogue: 0,0:20:24.21,0:20:26.21,Default,,0,0,0,,Итадакимасу. Ах.
Dialogue: 0,0:20:26.21,0:20:28.21,Default,,0,0,0,,Не? А, жоқ
Dialogue: 0,0:20:28.21,0:20:31.22,Default,,0,0,0,,Ішпесең, мен аламын!
Dialogue: 0,0:20:31.22,0:20:33.22,Default,,0,0,0,,Құдай-ай! «Енді бұдан әрі бәрі дәл болжағандай қалай болатынына таңғаламын!»
Dialogue: 0,0:20:33.22,0:20:36.22,Default,,0,0,0,,Әй, бәрі...
Dialogue: 0,0:20:36.22,0:20:39.56,Default,,0,0,0,,Жарайды, досым келді, кездескенше.
Dialogue: 0,0:20:39.56,0:20:41.89,Default,,0,0,0,,Жоқ, Цубаса-сан.
Dialogue: 0,0:20:41.89,0:20:46.40,Default,,0,0,0,,Мен ол адаммен жай сөйлескім келеді.
Dialogue: 0,0:20:46.40,0:20:50.57,Default,,0,0,0,,《Не, тіпті Чио-санның да сымбатты жігіттерге деген көзқарасы бар ма? 》
Dialogue: 0,0:20:50.57,0:20:53.41,Default,,0,0,0,,Коу!
Dialogue: 0,0:20:53.41,0:20:55.41,Default,,0,0,0,,Кешіріңіз, бірақ мен төлеуім керек...
Dialogue: 0,0:20:55.41,0:20:58.41,Default,,0,0,0,,Уау, түсіндім! Бәріміз сол жаққа барайық
Dialogue: 0,0:20:58.41,0:21:00.41,Default,,0,0,0,,О
Dialogue: 0,0:21:00.41,0:21:05.08,Default,,0,0,0,,Мен достарымды бұдан былай қауіп төндіре алмаймын.
Dialogue: 0,0:21:05.08,0:21:08.25,Default,,0,0,0,,Осы тікелей Ханзоны алайық.
Dialogue: 0,0:21:08.25,0:21:10.19,Default,,0,0,0,,Қалыпты әрекеттесу
Dialogue: 0,0:21:10.19,0:21:13.19,Default,,0,0,0,,Саған тең келер жолым жоқ, апа.
Dialogue: 0,0:21:13.19,0:21:16.70,Default,,0,0,0,,Сонымен мен досыма у ішуін өтіндім.
Dialogue: 0,0:21:16.70,0:21:20.70,Default,,0,0,0,,Не?! Удың күшіне енетін уақыты келді.
Dialogue: 0,0:21:20.70,0:21:23.87,Default,,0,0,0,,2 сағат антидот енгізбестен
Dialogue: 0,0:21:23.87,0:21:26.71,Default,,0,0,0,,Азаппен өлесің. Қарғыс атсын!
Dialogue: 0,0:21:26.71,0:21:29.71,Default,,0,0,0,,Момындықпен берілсең, антидот аласың...
Dialogue: 0,0:21:29.71,0:21:32.21,Default,,0,0,0,,Эй, эй!
Dialogue: 0,0:21:32.21,0:21:34.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:34.21,0:21:36.22,Default,,0,0,0,,Рикка-чан, өзіңді жақсы сезінесің бе?
Dialogue: 0,0:21:36.22,0:21:39.22,Default,,0,0,0,,Иә, сіз өте жақсы істеп жатырсыз! иә?
Dialogue: 0,0:21:39.22,0:21:41.39,Default,,0,0,0,,Сіз білесіз. иә?
Dialogue: 0,0:21:41.39,0:21:45.56,Default,,0,0,0,,Мен сенен бұл кофені қайдан алдың деп сұрайын деп едім. Ха!
Dialogue: 0,0:21:45.56,0:21:48.73,Default,,0,0,0,,<Удың жат планеталықтарға әсері болмады>
Dialogue: 0,0:21:48.73,0:21:53.57,Default,,0,0,0,,Қ-қараңыз… ол…
Dialogue: 0,0:21:53.57,0:21:56.27,Default,,0,0,0,,Ханзоның түпнұсқа қоспасы
Dialogue: 0,0:21:57.77,0:22:03.77,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory