Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.69,0:00:17.70,Default,,0,0,0,,[Секине: Ол ұйықтап жатыр еді. иә?
Dialogue: 0,0:00:17.70,0:00:21.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:21.70,0:00:26.54,Default,,0,0,0,,Не? Не болып жатыр? иә?
Dialogue: 0,0:00:26.54,0:00:30.38,Default,,0,0,0,,Иә? Ой...
Dialogue: 0,0:00:30.38,0:00:33.78,Default,,0,0,0,,Ол ұл балаға айналып барады! 》
Dialogue: 0,0:02:16.18,0:02:19.02,Default,,0,0,0,,(ызылдаған)
Dialogue: 0,0:02:19.02,0:02:22.19,Default,,0,0,0,,((Чиё: Уухо, мен жасадым!
Dialogue: 0,0:02:22.19,0:02:25.69,Default,,0,0,0,,Цубаса-санның шашы өте әдемі.
Dialogue: 0,0:02:25.69,0:02:27.70,Default,,0,0,0,,Кутикула да жылтыр
Dialogue: 0,0:02:27.70,0:02:30.20,Default,,0,0,0,,О, досым! Осы жеңісті тойлайық
Dialogue: 0,0:02:30.20,0:02:33.20,Default,,0,0,0,,Қанаттар бейтарап сүйкімділікке ие
Dialogue: 0,0:02:33.20,0:02:36.87,Default,,0,0,0,,Бұл танымал, солай емес пе? Бейтарап
Dialogue: 0,0:02:36.87,0:02:39.71,Default,,0,0,0,,Ол қыздар мектебінің ханзадасы.
Dialogue: 0,0:02:39.71,0:02:43.21,Default,,0,0,0,,Керемет! Жоқ, бұл дұрыс емес!
Dialogue: 0,0:02:43.21,0:02:46.71,Default,,0,0,0,,Цубаса-сан өте сүйкімді қыз!
Dialogue: 0,0:02:46.71,0:02:49.21,Default,,0,0,0,,Уф! Фуфу
Dialogue: 0,0:02:52.05,0:02:56.06,Default,,0,0,0,,《Мисс Цубаса шынымен ханшайым болғысы келеді, солай ма?
Dialogue: 0,0:02:56.06,0:02:59.89,Default,,0,0,0,,Иә! Бұл жағдайда Мисс Цубаса қыз болып қала береді.
Dialogue: 0,0:02:59.89,0:03:02.06,Default,,0,0,0,,Қалғандарының бәрі ұл болса
Dialogue: 0,0:03:02.06,0:03:04.07,Default,,0,0,0,,Бұл жақсы емес пе? 》
Dialogue: 0,0:03:04.07,0:03:08.90,Default,,0,0,0,,[Секине: Бұл Цубаса ханшайым және әдемі еркектердің гаремі бар дегенді білдіре ме? 》
Dialogue: 0,0:03:08.90,0:03:11.67,Default,,0,0,0,,《Жарайды! Сол тілегіміз орындалсын! 》
Dialogue: 0,0:03:11.67,0:03:13.67,Default,,0,0,0,,Ах))
Dialogue: 0,0:03:19.68,0:03:21.68,Default,,0,0,0,,(Хироми) Иә. (Кенъя) Ойласам➡
Dialogue: 0,0:03:21.68,0:03:23.69,Default,,0,0,0,,Секине-кун
Dialogue: 0,0:03:23.69,0:03:26.35,Default,,0,0,0,,Киім ауыстыратын кез келді.
Dialogue: 0,0:03:26.35,0:03:30.36,Default,,0,0,0,,Мм... кім?
Dialogue: 0,0:03:30.36,0:03:33.19,Default,,0,0,0,,Чиёмару деген кім?
Dialogue: 0,0:03:33.19,0:03:35.69,Default,,0,0,0,,Чиёмару…
Dialogue: 0,0:03:38.03,0:03:40.54,Default,,0,0,0,,Ах! Чио-сан!
Dialogue: 0,0:03:40.54,0:03:42.70,Default,,0,0,0,,Чиёмару
Dialogue: 0,0:03:42.70,0:03:44.71,Default,,0,0,0,,Мен бірдеңені есіме түсірдім.
Dialogue: 0,0:03:44.71,0:03:46.88,Default,,0,0,0,,Әй?
Dialogue: 0,0:03:46.88,0:03:50.71,Default,,0,0,0,,Рикка! Қайда!? иә?
Dialogue: 0,0:03:50.71,0:03:53.71,Default,,0,0,0,,Ах
Dialogue: 0,0:03:57.89,0:03:59.89,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:04:02.39,0:04:05.73,Default,,0,0,0,,Қанаттар?
Dialogue: 0,0:04:05.73,0:04:09.73,Default,,0,0,0,,Барлығында жоқ, сондықтан мен оны үлкен ағам Цуйошимен ауыстырамын.
Dialogue: 0,0:04:09.73,0:04:14.00,Default,,0,0,0,,Сондықтан мені Цюоси деп атаңыз. Эй, дұрыс.
Dialogue: 0,0:04:14.00,0:04:18.67,Default,,0,0,0,,《Ханшайымның қанаты деген осы ма? Бұл біраз қызық
Dialogue: 0,0:04:18.67,0:04:21.18,Default,,0,0,0,,Ал мен ер адаммын
Dialogue: 0,0:04:21.18,0:04:25.68,Default,,0,0,0,,Мен тек ер адамда болатын тәжірибе алғым келеді.
Dialogue: 0,0:04:25.68,0:04:29.68,Default,,0,0,0,,Цуйоши, сенен бір жақсылығым бар. Не?
Dialogue: 0,0:04:29.68,0:04:31.68,Default,,0,0,0,,Маған рұқсат бересіз бе?
Dialogue: 0,0:04:35.69,0:04:37.69,Default,,0,0,0,,Сіз мені ұрмайсыз, солай ма?
Dialogue: 0,0:04:37.69,0:04:41.36,Default,,0,0,0,,Кешіріңіз. Бірақ Секиненің де кінәсі бар.
Dialogue: 0,0:04:41.36,0:04:45.53,Default,,0,0,0,,Ах. Қан ағып жатыр, солай ма?
Dialogue: 0,0:04:45.53,0:04:47.54,Default,,0,0,0,,Әдемі бала!
Dialogue: 0,0:04:47.54,0:04:52.54,Default,,0,0,0,,Қазірдің өзінде! Келесі жолы маған мектеп асханасынан бірдеңе сатып алуыңызды өтінемін.
Dialogue: 0,0:04:52.54,0:04:56.71,Default,,0,0,0,,Бұл жай ғана сүйіспеншілік болғанша. Мені ұру жаман болды.
Dialogue: 0,0:04:56.71,0:04:59.71,Default,,0,0,0,,Жоқ, мұны тіпті әйел де жасай алады.
Dialogue: 0,0:05:01.72,0:05:05.05,Default,,0,0,0,,Дұрысы, Секине Тошақайға кешігіп қалады.
Dialogue: 0,0:05:05.05,0:05:07.72,Default,,0,0,0,,Тошақай? Бұл не болды?
Dialogue: 0,0:05:07.72,0:05:09.89,Default,,0,0,0,,Сіздің басыңыз нашар болды ма?
Dialogue: 0,0:05:09.89,0:05:14.33,Default,,0,0,0,,Бүгін жыл сайынғы іс-шара, белдік жарыс күні.
Dialogue: 0,0:05:14.33,0:05:18.67,Default,,0,0,0,,< Гунма префектурасына жаяу жүгіру!
Dialogue: 0,0:05:18.67,0:05:23.00,Default,,0,0,0,,Құсағандар көп болғандықтан, оны Тошақай деп атайды.
Dialogue: 0,0:05:23.00,0:05:26.34,Default,,0,0,0,,Бұл орта мектептегі іс-шара! ＞
Dialogue: 0,0:05:26.34,0:05:28.51,Default,,0,0,0,,《Оқиға қиын.
Dialogue: 0,0:05:28.51,0:05:31.85,Default,,0,0,0,,Бірақ егер бұл жарақат болса, мен экскурсияға барамын.
Dialogue: 0,0:05:31.85,0:05:35.68,Default,,0,0,0,,Секине-кун, сен Рикард-кунды көрмедің бе?
Dialogue: 0,0:05:35.68,0:05:37.78,Default,,0,0,0,,Мен осындамын!
Dialogue: 0,0:05:40.36,0:05:43.02,Default,,0,0,0,,《Полковник, сіз әлі қызсыз ба?》
Dialogue: 0,0:05:43.02,0:05:45.03,Default,,0,0,0,,Рикард-кун?
Dialogue: 0,0:05:45.03,0:05:47.20,Default,,0,0,0,,Мына әдемі адам қандай?
Dialogue: 0,0:05:47.20,0:05:50.03,Default,,0,0,0,,) Ах, Мошия Чиё...
Dialogue: 0,0:05:50.03,0:05:52.03,Default,,0,0,0,,...
Dialogue: 0,0:05:52.03,0:05:54.70,Default,,0,0,0,,Сіз не киіп жүрсіз?
Dialogue: 0,0:05:54.70,0:05:56.70,Default,,0,0,0,,Мен әрқашан айтамын! Ахх
Dialogue: 0,0:05:56.70,0:05:59.87,Default,,0,0,0,,Ерке емес жігіттерді жек көремін!
Dialogue: 0,0:05:59.87,0:06:02.38,Default,,0,0,0,,Бұл кеңейтімдер қандай?
Dialogue: 0,0:06:02.38,0:06:05.38,Default,,0,0,0,,Табиғи шаш?!
Dialogue: 0,0:06:05.38,0:06:07.88,Default,,0,0,0,,Цуйоши шаш қырғыш. Иә
Dialogue: 0,0:06:09.88,0:06:15.16,Default,,0,0,0,,Рикард Мен шашыңды қырамын.
Dialogue: 0,0:06:15.16,0:06:17.16,Default,,0,0,0,,Бұл аз
Dialogue: 0,0:06:20.66,0:06:22.66,Default,,0,0,0,,Сіз бірдеңе айттыңыз ба?
Dialogue: 0,0:06:22.66,0:06:24.67,Default,,0,0,0,,Бұл ештеңе емес!
Dialogue: 0,0:06:24.67,0:06:28.67,Default,,0,0,0,,《Мен түсінемін. Чио-сан қызға ұқсайды.
Dialogue: 0,0:06:28.67,0:06:32.67,Default,,0,0,0,,Ұл болған соң солай бола ма?
Dialogue: 0,0:06:32.67,0:06:35.34,Default,,0,0,0,,Қанаттар...
Dialogue: 0,0:06:35.34,0:06:39.51,Default,,0,0,0,,Бұл сүйкімді. Бұл ханшайым ретінде қойылғандықтан ба? 》
Dialogue: 0,0:06:39.51,0:06:41.52,Default,,0,0,0,,Фу
Dialogue: 0,0:06:41.52,0:06:44.52,Default,,0,0,0,,Айтпақшы, Цюоши Тошақайды не істейді?
Dialogue: 0,0:06:44.52,0:06:47.86,Default,,0,0,0,,Бұл жай ғана экскурсия. Бұл көптеген жолдармен мүмкін емес.
Dialogue: 0,0:06:47.86,0:06:52.19,Default,,0,0,0,,Ах~ Онда мен де экскурсияға барамын. Сен не туралы айтып тұрсың?
Dialogue: 0,0:06:52.19,0:06:54.86,Default,,0,0,0,,Қамқоршы қол қойған өтінішсіз
Dialogue: 0,0:06:54.86,0:06:58.36,Default,,0,0,0,,Сіз экскурсия жасай алмайсыз. Сіз мұны білесіз.
Dialogue: 0,0:07:03.71,0:07:08.71,Default,,0,0,0,,А, а, а...
Dialogue: 0,0:07:08.71,0:07:11.15,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:07:13.65,0:07:15.98,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:15.98,0:07:18.32,Default,,0,0,0,,Тошақайдан кейін жалғастыр
Dialogue: 0,0:07:18.32,0:07:21.82,Default,,0,0,0,,Ерте дайындал және кешікпе
Dialogue: 0,0:07:21.82,0:07:25.49,Default,,0,0,0,,Ей, басым жарылып, қансырап жатыр!
Dialogue: 0,0:07:25.49,0:07:28.00,Default,,0,0,0,,Жоқ, қызуым көтерілмесе, тыныға алмаймын.
Dialogue: 0,0:07:28.00,0:07:31.50,Default,,0,0,0,,Бұл не? (Чиёмару) Сіз демалыс күнін алатыныңызға сенімдісіз бе?
Dialogue: 0,0:07:31.50,0:07:33.84,Default,,0,0,0,,Мүлде жоқ!
Dialogue: 0,0:07:33.84,0:07:39.01,Default,,0,0,0,,Суық. Бұл қиын. Мүмкін емес. Неліктен бұл оқиға болып жатыр?
Dialogue: 0,0:07:39.01,0:07:41.18,Default,,0,0,0,,Мүмкін емес. Сенгісіз.
Dialogue: 0,0:07:41.18,0:07:44.18,Default,,0,0,0,,Секине-күн, дәл қазір бірдеңе дедің бе?
Dialogue: 0,0:07:44.18,0:07:46.35,Default,,0,0,0,,Тошақай - ең жақсы!
Dialogue: 0,0:07:46.35,0:07:49.68,Default,,0,0,0,,Уф... Секине
Dialogue: 0,0:07:49.68,0:07:52.85,Default,,0,0,0,,Бұл өте жаман. Қулық!
Dialogue: 0,0:07:52.85,0:07:56.02,Default,,0,0,0,,Келіңіздер! Біз де Рикард-куннан үлгі алуымыз керек.
Dialogue: 0,0:07:56.02,0:07:58.02,Default,,0,0,0,,Барымызды салайық!
Dialogue: 0,0:08:00.03,0:08:03.87,Default,,0,0,0,,Миды жууға НЛО арқылы саяхаттауды қосқанына қуаныштымын!
Dialogue: 0,0:08:03.87,0:08:05.87,Default,,0,0,0,,Гунмаға дейін секіріңіз!
Dialogue: 0,0:08:05.87,0:08:14.48,Default,,0,0,0,,Ондай жағдайда Тошақайдың да миын шайып ал!
Dialogue: 0,0:08:14.48,0:08:17.48,Default,,0,0,0,,Мақсат! Мақсат мақсат Мақсат мақсат...
Dialogue: 0,0:08:17.48,0:08:22.98,Default,,0,0,0,,Мақсат Мақсат Мақсат Мақсат Мақсат Мақсат Мақсат!
Dialogue: 0,0:08:22.98,0:08:26.49,Default,,0,0,0,,Фу
Dialogue: 0,0:08:26.49,0:08:30.49,Default,,0,0,0,,Аа, мен сәл байыпты болып кеттім.
Dialogue: 0,0:08:30.49,0:08:32.99,Default,,0,0,0,,<Үлкен бөтен жеңіс! ＞
Dialogue: 0,0:08:35.83,0:08:39.00,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:08:39.00,0:08:41.00,Default,,0,0,0,,Бар!
Dialogue: 0,0:08:41.00,0:08:44.01,Default,,0,0,0,,Жоқ, сөзсіз... Мен енді мұны істей алмаймын.
Dialogue: 0,0:08:44.01,0:08:46.01,Default,,0,0,0,,Сәттілік Секине
Dialogue: 0,0:08:46.01,0:08:49.01,Default,,0,0,0,,Мақсат дәл сіздің алдыңызда. Барымызды салайық.
Dialogue: 0,0:08:49.01,0:08:51.51,Default,,0,0,0,,Барлығы барын салды!
Dialogue: 0,0:08:51.51,0:08:54.18,Default,,0,0,0,,Биыл тағы да 1-ші болу керемет!
Dialogue: 0,0:08:54.18,0:08:56.68,Default,,0,0,0,,Құттықтаймыз Рикард-кун
Dialogue: 0,0:08:56.68,0:08:58.78,Default,,0,0,0,,Мен сенің қолыңнан келеді деп ойладым.
Dialogue: 0,0:09:00.86,0:09:04.69,Default,,0,0,0,,Ал, бұрынғыдан жалғастырайық. Дайын болыңыз.
Dialogue: 0,0:09:04.69,0:09:07.86,Default,,0,0,0,,Ааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:09:07.86,0:09:10.97,Default,,0,0,0,,《Рикка: Кешіріңіз, Цубаса ханым! Мен енді шыдай алмаймын! 》
Dialogue: 0,0:09:10.97,0:09:13.17,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:09:15.14,0:09:17.14,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:20.64,0:09:22.81,Default,,0,0,0,,Бұл не...?
Dialogue: 0,0:09:22.81,0:09:24.81,Default,,0,0,0,,Олардың екеуі
Dialogue: 0,0:09:24.81,0:09:27.65,Default,,0,0,0,,Мен шайға кешігіп барамын.
Dialogue: 0,0:09:27.65,0:09:29.65,Default,,0,0,0,,Сіз Точакайсыз ба!?
Dialogue: 0,0:09:29.65,0:09:32.32,Default,,0,0,0,,...
Dialogue: 0,0:09:32.32,0:09:35.66,Default,,0,0,0,,｡ ？
Dialogue: 0,0:09:35.66,0:09:37.66,Default,,0,0,0,,Бұл жыл сайынғы оқиға.
Dialogue: 0,0:09:37.66,0:09:41.83,Default,,0,0,0,,...
Dialogue: 0,0:09:41.83,0:09:44.03,Default,,0,0,0,,Шай ішу! Керемет!
Dialogue: 0,0:09:46.17,0:09:49.67,Default,,0,0,0,,Қыздар мектептері ең жақсы!
Dialogue: 0,0:09:49.67,0:09:53.67,Default,,0,0,0,,｡
Dialogue: 0,0:10:03.68,0:10:06.69,Default,,0,0,0,,Уф
Dialogue: 0,0:10:06.69,0:10:09.69,Default,,0,0,0,,Менің балансым осы айда да тығыз.
Dialogue: 0,0:10:09.69,0:10:12.53,Default,,0,0,0,,Сізге не қиын деп есептейсіз?
Dialogue: 0,0:10:12.53,0:10:16.86,Default,,0,0,0,,Сіздің отбасыңыз қайтып келмейтіндіктен емес пе?
Dialogue: 0,0:10:16.86,0:10:20.03,Default,,0,0,0,,<Қыздар орта мектебінде әдемі жігіт бар!
Dialogue: 0,0:10:20.03,0:10:23.20,Default,,0,0,0,,Бағдарлама Сіз қателесіп жатқаныңызға сенімдісіз бе? ＞
Dialogue: 0,0:10:23.20,0:10:26.04,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:10:26.04,0:10:31.34,Default,,0,0,0,,Уууу. Мен бұл жерде айта алмаймын.
Dialogue: 0,0:10:33.38,0:10:35.78,Default,,0,0,0,,Хмм?
Dialogue: 0,0:10:37.72,0:10:44.23,Default,,0,0,0,,Ертең жаттығу залының артына келсең
Dialogue: 0,0:10:44.23,0:10:46.73,Default,,0,0,0,,Мен сізге айтайын.
Dialogue: 0,0:10:46.73,0:10:48.73,Default,,0,0,0,,Неге мен мұндай жерге баруым керек...
Dialogue: 0,0:10:48.73,0:10:53.23,Default,,0,0,0,,Иә? Сіз елсіз жерде сүйкімді қызды кездестіргіңіз келеді, солай ма?
Dialogue: 0,0:10:53.23,0:10:55.74,Default,,0,0,0,,Бірге жалғыз болайық
Dialogue: 0,0:10:55.74,0:10:58.57,Default,,0,0,0,,Байыппен жауап беруіңізді өтінемін!
Dialogue: 0,0:10:58.57,0:11:01.41,Default,,0,0,0,,Сенің ашулы жүзің де сүйкімді
Dialogue: 0,0:11:01.41,0:11:04.41,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:04.41,0:11:07.42,Default,,0,0,0,,Қорықпаңыз. Ха.
Dialogue: 0,0:11:07.42,0:11:12.02,Default,,0,0,0,,Мен сенің үнемі еңбектенетініңді білемін.
Dialogue: 0,0:11:12.02,0:11:14.52,Default,,0,0,0,,Ішек
Dialogue: 0,0:11:14.52,0:11:17.19,Default,,0,0,0,,Аа, дұрыс. иә?
Dialogue: 0,0:11:17.19,0:11:20.19,Default,,0,0,0,,Көзілдірікті шешіп бере аласыз ба?
Dialogue: 0,0:11:20.19,0:11:24.03,Default,,0,0,0,,Өйткені ол осылай сүйкімдірек
Dialogue: 0,0:11:24.03,0:11:26.03,Default,,0,0,0,,Кешір мені. Қызығушылығымды тежей алмадым; мен жай ғана…
Dialogue: 0,0:11:28.04,0:11:31.24,Default,,0,0,0,,《Енді не болды?》
Dialogue: 0,0:11:34.21,0:11:38.55,Default,,0,0,0,,《
Dialogue: 0,0:11:38.55,0:11:40.55,Default,,0,0,0,,Мен оны танымаймын》
Dialogue: 0,0:11:40.55,0:11:44.22,Default,,0,0,0,,Уф
Dialogue: 0,0:11:44.22,0:11:47.72,Default,,0,0,0,,Сіз өзіңізді жақсы сезінбейтін сияқтысыз. Сенімен бәрі жақсы ма?
Dialogue: 0,0:11:47.72,0:11:51.06,Default,,0,0,0,,～
Dialogue: 0,0:11:51.06,0:11:53.89,Default,,0,0,0,,Ол қашып кетті. Жақсы.
Dialogue: 0,0:11:53.89,0:11:57.73,Default,,0,0,0,,《Ол қайда кетті?》
Dialogue: 0,0:11:57.73,0:12:01.73,Default,,0,0,0,,((Фуку-чан: Cui cui. Мынадай жерде үй жануары бар!?
Dialogue: 0,0:12:03.74,0:12:07.41,Default,,0,0,0,,Осы жерді бірге аман алып шығайық
Dialogue: 0,0:12:07.41,0:12:11.01,Default,,0,0,0,,Достар. Кілт, сықырлау, сықырлау...
Dialogue: 0,0:12:11.01,0:12:14.85,Default,,0,0,0,,Ах. Кю? кезек
Dialogue: 0,0:12:14.85,0:12:16.85,Default,,0,0,0,,Кюкю Кюкю Кюкю…
Dialogue: 0,0:12:16.85,0:12:19.52,Default,,0,0,0,,Ахаха Кенеттен жүгіру қауіпті!
Dialogue: 0,0:12:19.52,0:12:21.52,Default,,0,0,0,,Сәлем! Сықыр-сықыр...))
Dialogue: 0,0:12:21.52,0:12:24.69,Default,,0,0,0,,<Болғанша қашып кетті>
Dialogue: 0,0:12:24.69,0:12:26.69,Default,,0,0,0,,《Фуку-чан》
Dialogue: 0,0:12:26.69,0:12:28.86,Default,,0,0,0,,《Атау мағынасы》
Dialogue: 0,0:12:28.86,0:12:33.37,Default,,0,0,0,,《Белгісіз планетада адасып қалдым. Мен сондай қайғылы болуым керек.
Dialogue: 0,0:12:33.37,0:12:36.37,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:12:36.37,0:12:39.54,Default,,0,0,0,,Фуку-чан басқа адамның миына спораларды имплантациялайды...》
Dialogue: 0,0:12:39.54,0:12:41.54,Default,,0,0,0,,Аю!
Dialogue: 0,0:12:41.54,0:12:46.74,Default,,0,0,0,,《Себебі мен идеалды қарама-қарсы жыныстың елесін көрсететін мамандығым бар! 》
Dialogue: 0,0:12:48.72,0:12:51.82,Default,,0,0,0,,《Бұл планетада өте танымал екеніне сенімдімін》
Dialogue: 0,0:12:57.06,0:13:00.23,Default,,0,0,0,,Кюукюкюкю... Гуаааа
Dialogue: 0,0:13:00.23,0:13:02.23,Default,,0,0,0,,《Споралар?
Dialogue: 0,0:13:02.23,0:13:07.74,Default,,0,0,0,,Не? Басқаша айтқанда, бұл адам полковниктің үй жануарлары маған көрсеткен галлюцинация болды ма?
Dialogue: 0,0:13:07.74,0:13:13.34,Default,,0,0,0,,Бұл менің идеалды қарама-қарсы жынысым дегенді білдіреді! 》
Dialogue: 0,0:13:16.84,0:13:20.01,Default,,0,0,0,,<Қыздың қалауына тікелей қарсы тұра алмау>
Dialogue: 0,0:13:20.01,0:13:23.18,Default,,0,0,0,,Цубаса. Не?
Dialogue: 0,0:13:23.18,0:13:27.52,Default,,0,0,0,,Кешіріңіз, кешегі күні "әйелдің бетін пирсинг" деп айтқаным үшін.
Dialogue: 0,0:13:27.52,0:13:29.52,Default,,0,0,0,,<Рефлексия>
Dialogue: 0,0:13:29.52,0:13:31.53,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:13:31.53,0:13:34.53,Default,,0,0,0,,А, онда жүр, мен сенен бір жақсылық сұрауға рұқсат етіңіз.
Dialogue: 0,0:13:34.53,0:13:37.53,Default,,0,0,0,,Бұл не? Ал...
Dialogue: 0,0:13:37.53,0:13:41.87,Default,,0,0,0,,Дәл қазір жақсы адам бар.
Dialogue: 0,0:13:41.87,0:13:45.21,Default,,0,0,0,,《Сіз жақсылық туралы айтып отырсыз ба? 》
Dialogue: 0,0:13:45.21,0:13:48.04,Default,,0,0,0,,Дәлірек айтқанда, сенің жігітің болды ма?
Dialogue: 0,0:13:48.04,0:13:51.88,Default,,0,0,0,,А, жоқ, бұл менің айтқым келгені емес.
Dialogue: 0,0:13:51.88,0:13:57.72,Default,,0,0,0,,Кеше маған бір дүкеннен келді.
Dialogue: 0,0:13:57.72,0:14:00.05,Default,,0,0,0,,Біз оған шынымен де қол жеткіздік.
Dialogue: 0,0:14:00.05,0:14:02.72,Default,,0,0,0,,...
Dialogue: 0,0:14:02.72,0:14:06.82,Default,,0,0,0,,Аа, сен жалғыз кездесемін дедің ғой?
Dialogue: 0,0:14:10.66,0:14:13.83,Default,,0,0,0,,《Мүмкін қанаттың артқы жағында...》
Dialogue: 0,0:14:13.83,0:14:18.67,Default,,0,0,0,,Бұл: ``Уа, осындай керемет адам бар!'' сияқты.
Dialogue: 0,0:14:18.67,0:14:20.67,Default,,0,0,0,,《Мына қол жолға түсіп тұр! 》
Dialogue: 0,0:14:20.67,0:14:25.01,Default,,0,0,0,,Не айтарымды білмеймін~ Тағдыр жазғандай сезініп тұрмын~
Dialogue: 0,0:14:25.01,0:14:27.18,Default,,0,0,0,,《Қандай қыңыр》
Dialogue: 0,0:14:27.18,0:14:31.28,Default,,0,0,0,,Секине жоқ па? Бұл біртүрлі~
Dialogue: 0,0:14:33.52,0:14:36.52,Default,,0,0,0,,<Балабақша дерлік>
Dialogue: 0,0:14:36.52,0:14:42.86,Default,,0,0,0,,Цубаса мүмкін, бірақ ол басқа әлемде өмір сүреді...
Dialogue: 0,0:14:42.86,0:14:46.53,Default,,0,0,0,,Дүние, дәлірек айтсақ, жұлдыздар ма?
Dialogue: 0,0:14:46.53,0:14:49.37,Default,,0,0,0,,Міне, мен солай ойладым.
Dialogue: 0,0:14:49.37,0:14:52.21,Default,,0,0,0,,Менің жасым үлкен және сәйкес келмеуі мүмкін.
Dialogue: 0,0:14:52.21,0:14:54.21,Default,,0,0,0,,)
Dialogue: 0,0:14:54.21,0:14:57.21,Default,,0,0,0,,Бірақ бұл махаббат тек ауыртады...
Dialogue: 0,0:14:57.21,0:14:59.38,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:14:59.38,0:15:03.72,Default,,0,0,0,,Қалай аяқталса да, романтика - өмірдің түсі.
Dialogue: 0,0:15:03.72,0:15:06.05,Default,,0,0,0,,《Полковник, үндемеңіз.
Dialogue: 0,0:15:06.05,0:15:10.56,Default,,0,0,0,,А, бірақ ер адамдар араласқанда Цубаса ақымақ болып кетеді.
Dialogue: 0,0:15:10.56,0:15:14.66,Default,,0,0,0,,Оның бұл жерде бір рет жүрегінің ауыруына мүмкіндік беру дұрыс па? 》
Dialogue: 0,0:15:14.66,0:15:17.67,Default,,0,0,0,,Не?
Dialogue: 0,0:15:17.67,0:15:21.00,Default,,0,0,0,,《Өмір қысқа, ғашық бол, қыз
Dialogue: 0,0:15:21.00,0:15:24.84,Default,,0,0,0,,Фуку-чан қайтып келмесе де
Dialogue: 0,0:15:24.84,0:15:30.01,Default,,0,0,0,,Мен сенің осы планетада біреумен бақытты болғаныңды қалаймын...
Dialogue: 0,0:15:30.01,0:15:33.51,Default,,0,0,0,,Бірақ бұл мүмкін емес тілек.
Dialogue: 0,0:15:33.51,0:15:35.52,Default,,0,0,0,,《Мазасыз》
Dialogue: 0,0:15:35.52,0:15:38.52,Default,,0,0,0,,《Фуку-чан галлюцинацияға ұшыраған адамды азғырды
Dialogue: 0,0:15:38.52,0:15:41.19,Default,,0,0,0,,Экстазда
Dialogue: 0,0:15:41.19,0:15:43.99,Default,,0,0,0,,Өйткені олар оны жеп, қоректік зат ретінде пайдаланады》
Dialogue: 0,0:15:47.03,0:15:51.53,Default,,0,0,0,,Ол адам сенен бүгін түнеуіңді сұрады, солай ма?
Dialogue: 0,0:15:51.53,0:15:55.20,Default,,0,0,0,,Жоқ! Да, жоқ!
Dialogue: 0,0:15:55.20,0:16:00.71,Default,,0,0,0,,Цубаса-сан! Қандай ұйықтау!
Dialogue: 0,0:16:00.71,0:16:03.88,Default,,0,0,0,,Жарайды! Сол себепті
Dialogue: 0,0:16:03.88,0:16:07.55,Default,,0,0,0,,Менің Секине-нчиде қалғанымды маған қалдыра аласыз ба?
Dialogue: 0,0:16:07.55,0:16:14.82,Default,,0,0,0,,Цубаса Мен сізден тікелей сұрайын деп жатырмын.
Dialogue: 0,0:16:14.82,0:16:17.32,Default,,0,0,0,,Жеп қойсаңыз да өкінбейсіз бе?
Dialogue: 0,0:16:17.32,0:16:20.33,Default,,0,0,0,,Секине тым тура!
Dialogue: 0,0:16:20.33,0:16:23.66,Default,,0,0,0,,Жоқ, мен Секинеде бармын~. 《Мен бүгін өлетін шығармын》
Dialogue: 0,0:16:23.66,0:16:25.67,Default,,0,0,0,,Бұл өте нашар!
Dialogue: 0,0:16:25.67,0:16:29.17,Default,,0,0,0,,《Жоқ, әрине, біз мұны тоқтатуымыз керек.
Dialogue: 0,0:16:29.17,0:16:31.51,Default,,0,0,0,,Бірақ мен не істеуім керек?
Dialogue: 0,0:16:31.51,0:16:35.34,Default,,0,0,0,,Ахххххххххх...
Dialogue: 0,0:16:35.34,0:16:38.18,Default,,0,0,0,,<Пипидепапидепу>
Dialogue: 0,0:16:38.18,0:16:40.85,Default,,0,0,0,,《Секине: Споралар бар деп ойлаймын~
Dialogue: 0,0:16:40.85,0:16:43.68,Default,,0,0,0,,Алып кетсем, әйтеуір әйтеуір болады ма деп.
Dialogue: 0,0:16:43.68,0:16:47.86,Default,,0,0,0,,А, біз Фуку-чан туралы бірдеңе істеуіміз керек.
Dialogue: 0,0:16:47.86,0:16:50.52,Default,,0,0,0,,Құрбандар саны өсуде.
Dialogue: 0,0:16:50.52,0:16:54.86,Default,,0,0,0,,Амансың ба? Секине
Dialogue: 0,0:16:54.86,0:16:56.86,Default,,0,0,0,,А, а, а...
Dialogue: 0,0:16:56.86,0:16:59.03,Default,,0,0,0,,《Кешір мені, Қанаттар.
Dialogue: 0,0:16:59.03,0:17:01.33,Default,,0,0,0,,Мен сізге жем ретінде әрекет етемін! 》
Dialogue: 0,0:17:06.04,0:17:09.38,Default,,0,0,0,,《Келесің бе, Фуку-чан? иә?
Dialogue: 0,0:17:09.38,0:17:12.15,Default,,0,0,0,,Аа, бұл Чио-сан.
Dialogue: 0,0:17:12.15,0:17:15.98,Default,,0,0,0,,《Бұл аздап қорқынышты, бірақ бұл жылқының сүйегі.
Dialogue: 0,0:17:15.98,0:17:18.15,Default,,0,0,0,,Мен сізге дыбысты көрсетейін! 》
Dialogue: 0,0:17:18.15,0:17:21.32,Default,,0,0,0,,((Алдымен екі отбасына сәлем айтайық!
Dialogue: 0,0:17:21.32,0:17:23.32,Default,,0,0,0,,Иә иә))
Dialogue: 0,0:17:23.32,0:17:26.02,Default,,0,0,0,,《Бейне жаттығулары тамаша》
Dialogue: 0,0:17:28.00,0:17:30.50,Default,,0,0,0,,Маған керек!
Dialogue: 0,0:17:30.50,0:17:33.83,Default,,0,0,0,,Ах
Dialogue: 0,0:17:33.83,0:17:36.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:36.17,0:17:40.47,Default,,0,0,0,,《Бұл адам неге менімен сөйлесті? 》
Dialogue: 0,0:17:43.51,0:17:45.51,Default,,0,0,0,,Ах
Dialogue: 0,0:17:48.18,0:17:51.02,Default,,0,0,0,,Сықырлау сигналы...＜Ол әлі қосылып тұрды＞
Dialogue: 0,0:17:51.02,0:17:53.69,Default,,0,0,0,,Хмф! Арх!
Dialogue: 0,0:17:53.69,0:17:55.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:55.69,0:18:00.69,Default,,0,0,0,,《Қайда бардың? бұл жұмбақ жағдай
Dialogue: 0,0:18:00.69,0:18:03.36,Default,,0,0,0,,Мен Фуку-чанның сонда екеніне сенімдімін.
Dialogue: 0,0:18:03.36,0:18:05.70,Default,,0,0,0,,А, а...
Dialogue: 0,0:18:05.70,0:18:10.80,Default,,0,0,0,,Жарайды, жарайды, менімен ыстық уақыт өткізейік.
Dialogue: 0,0:18:10.80,0:18:14.81,Default,,0,0,0,,Цубаса мырза, бұл сіздің хоббиіңіз бе?
Dialogue: 0,0:18:14.81,0:18:18.65,Default,,0,0,0,,Кешірім сұраймын.
Dialogue: 0,0:18:18.65,0:18:23.98,Default,,0,0,0,,《Мүмкін Чио-сан қазір өзінің идеалды серіктесін көруі мүмкін.
Dialogue: 0,0:18:23.98,0:18:28.66,Default,,0,0,0,,Бірақ сізде қиындықтар бар ма? Неге сонша жиіркенішті көрінесің? 》
Dialogue: 0,0:18:28.66,0:18:33.66,Default,,0,0,0,,О, сен Цубаса-санның досысың ба?
Dialogue: 0,0:18:33.66,0:18:36.50,Default,,0,0,0,,<Сызба күйзеліс салдарынан құлады>
Dialogue: 0,0:18:36.50,0:18:40.17,Default,,0,0,0,,《Мен не істеуім керек? Егер мен оны көрмесем, мен сізге көмектесе алмаймын.
Dialogue: 0,0:18:40.17,0:18:42.67,Default,,0,0,0,,Егер менде ерекше өкілеттіктер болса...
Dialogue: 0,0:18:42.67,0:18:44.67,Default,,0,0,0,,Иә! 》
Dialogue: 0,0:18:44.67,0:18:47.17,Default,,0,0,0,,<Ханайым уақыты
Dialogue: 0,0:18:47.17,0:18:51.68,Default,,0,0,0,,Бұл Секине өзінің табиғаттан тыс күштерін басқара алатын уақытты білдіреді.＞
Dialogue: 0,0:18:51.68,0:18:54.52,Default,,0,0,0,,《Бірақ мен оны қолдансам...
Dialogue: 0,0:18:54.52,0:18:58.02,Default,,0,0,0,,Жоқ, бұлай жалғаса берсе, екеумізге қауіп төнеді.
Dialogue: 0,0:18:58.02,0:19:02.69,Default,,0,0,0,,Сәлем! Секине Ай!
Dialogue: 0,0:19:02.69,0:19:06.53,Default,,0,0,0,,<Түсіндірейік! Секине қазір
Dialogue: 0,0:19:06.53,0:19:10.03,Default,,0,0,0,,Мен Чиёның не көріп тұрғанын көріп тұрмын＞
Dialogue: 0,0:19:10.03,0:19:13.63,Default,,0,0,0,,《Мүмкін бұл Фуку-чан шығар.
Dialogue: 0,0:19:13.63,0:19:16.64,Default,,0,0,0,,Ішімді құрбандыққа шалуға тұрды.
Dialogue: 0,0:19:16.64,0:19:18.64,Default,,0,0,0,,Қалай болғанда да...
Dialogue: 0,0:19:18.64,0:19:21.81,Default,,0,0,0,,Ол ересектерге арналған комикстерде көрінетін жігіт.
Dialogue: 0,0:19:21.81,0:19:25.48,Default,,0,0,0,,Чио-сан, саған бұл түрі ұнай ма?
Dialogue: 0,0:19:25.48,0:19:27.82,Default,,0,0,0,,Аа~ түсіндім. Жарайды, жарайды.
Dialogue: 0,0:19:27.82,0:19:30.82,Default,,0,0,0,,Сіз Чанцубаның досысыз ба?
Dialogue: 0,0:19:30.82,0:19:35.49,Default,,0,0,0,,Мен сені қатты жақсы көремін~
Dialogue: 0,0:19:35.49,0:19:40.16,Default,,0,0,0,,Цубаса мырзамен араласпаңыз.
Dialogue: 0,0:19:40.16,0:19:44.50,Default,,0,0,0,,Бір өтінемін
Dialogue: 0,0:19:44.50,0:19:47.50,Default,,0,0,0,,Олай болса, сен маған серік боласың ба?
Dialogue: 0,0:19:47.50,0:19:49.67,Default,,0,0,0,,Чанцуба~ орнына
Dialogue: 0,0:19:49.67,0:19:53.34,Default,,0,0,0,,《Сіз нені айтып тұрсыз? А, мүмкін
Dialogue: 0,0:19:53.34,0:19:57.34,Default,,0,0,0,,Фуку-чан міндетті түрде менің идеалды серіктесім емес.
Dialogue: 0,0:19:57.34,0:20:01.01,Default,,0,0,0,,Көбеюге әкелетін галлюцинацияларды көрсету\NБұл
Dialogue: 0,0:20:01.01,0:20:03.18,Default,,0,0,0,,дегенді білдіре ме?
Dialogue: 0,0:20:03.18,0:20:06.19,Default,,0,0,0,,Сондықтан мен Цубаса-санды енді ешқашан көрмеймін...
Dialogue: 0,0:20:06.19,0:20:09.36,Default,,0,0,0,,Ронмочи~ Мен кездеспеймін. Мен сені кездестірмеймін.
Dialogue: 0,0:20:09.36,0:20:11.36,Default,,0,0,0,,Түсінді.
Dialogue: 0,0:20:11.36,0:20:13.36,Default,,0,0,0,,Өлтірейік
Dialogue: 0,0:20:13.36,0:20:15.70,Default,,0,0,0,,《Болады.》
Dialogue: 0,0:20:15.70,0:20:19.53,Default,,0,0,0,,《Чиё: Бірақ мен қолымды кірлетпеуді шештім.
Dialogue: 0,0:20:19.53,0:20:21.87,Default,,0,0,0,,Асура жолына қарай? 》
Dialogue: 0,0:20:21.87,0:20:24.04,Default,,0,0,0,,Әй, тезірек~
Dialogue: 0,0:20:24.04,0:20:26.37,Default,,0,0,0,,Біз жалғыз боламыз ба?
Dialogue: 0,0:20:26.37,0:20:29.38,Default,,0,0,0,,《Қорқынышты! 》＜Мен сені өлтіретін сияқтымын＞
Dialogue: 0,0:20:29.38,0:20:31.88,Default,,0,0,0,,Чио-сан!
Dialogue: 0,0:20:31.88,0:20:34.05,Default,,0,0,0,,Кілт. Жақсы емес.
Dialogue: 0,0:20:34.05,0:20:36.72,Default,,0,0,0,,Тым үлкен
Dialogue: 0,0:20:36.72,0:20:39.05,Default,,0,0,0,,Кілт!
Dialogue: 0,0:20:39.05,0:20:42.56,Default,,0,0,0,,《Тамаша~ Полковник! Бұл матч сорғы! 》
Dialogue: 0,0:20:42.56,0:20:45.06,Default,,0,0,0,,Әй, бұрынғысын ше?
Dialogue: 0,0:20:45.06,0:20:48.40,Default,,0,0,0,,Мен бұл туралы хабарладым! Мен оның қашып кеткеніне сенімдімін
Dialogue: 0,0:20:48.40,0:20:51.23,Default,,0,0,0,,《Бірақ мен бұл шындық деп ешқашан ойламадым.
Dialogue: 0,0:20:51.23,0:20:54.40,Default,,0,0,0,,Жер бетіндегілермен ұрпақ өсіруге тырысу.
Dialogue: 0,0:20:54.40,0:20:59.07,Default,,0,0,0,,(ызылдаған)
Dialogue: 0,0:20:59.07,0:21:01.07,Default,,0,0,0,,Әй?
Dialogue: 0,0:21:01.07,0:21:04.75,Default,,0,0,0,,Иә? Барлығы, неге мұндасыңдар?
Dialogue: 0,0:21:04.75,0:21:09.85,Default,,0,0,0,,Сіз ештеңе істей алмайсыз! Дезинфекциялау!
Dialogue: 0,0:21:14.19,0:21:16.69,Default,,0,0,0,,Не? Гехо Гехо
Dialogue: 0,0:21:22.70,0:21:24.70,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:21:26.70,0:21:28.70,Default,,0,0,0,,Не?
Dialogue: 0,0:21:35.21,0:21:37.21,Default,,0,0,0,,Өте сүйкімді
Dialogue: 0,0:21:37.21,0:21:39.88,Default,,0,0,0,,Мен саған көмектесемін
Dialogue: 0,0:21:39.88,0:21:42.55,Default,,0,0,0,,Мен жалғыз болдым.
Dialogue: 0,0:21:42.55,0:21:45.55,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:21:45.55,0:21:50.22,Default,,0,0,0,,<Кейінгі әсерлер Элингиді әдемі етіп көрсетті>
Dialogue: 0,0:21:50.22,0:21:52.23,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:21:52.23,0:21:54.56,Default,,0,0,0,,<Жалғыз қалдырсам жазылды>
Dialogue: 0,0:21:54.56,0:21:56.76,Default,,0,0,0,,Қош бол
Dialogue: 0,0:21:58.26,0:22:04.26,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory