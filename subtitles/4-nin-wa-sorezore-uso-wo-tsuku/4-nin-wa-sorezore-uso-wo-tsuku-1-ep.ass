Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:13.44,0:00:15.61,Default,,0,0,0,,＜ Бұл Кашихара қыздар академиясы
Dialogue: 0,0:00:15.61,0:00:18.78,Default,,0,0,0,,Жақсы ескі қыздар мектебі ретінде белгілі
Dialogue: 0,0:00:18.78,0:00:21.62,Default,,0,0,0,,Бұл беделді орта мектеп＞
Dialogue: 0,0:00:21.62,0:00:23.62,Default,,0,0,0,,Хехехе... аа
Dialogue: 0,0:00:28.79,0:00:32.46,Default,,0,0,0,,Әдемі екен. Бұл дәмді көрінеді.
Dialogue: 0,0:00:32.46,0:00:36.63,Default,,0,0,0,,Чио-сан, ерте.
Dialogue: 0,0:00:36.63,0:00:40.97,Default,,0,0,0,,Қайырлы күн, Секине мырза. Сіз Цубаса мырзамен бірге келдіңіз бе?
Dialogue: 0,0:00:40.97,0:00:44.81,Default,,0,0,0,,Баршаңызға~!
Dialogue: 0,0:00:44.81,0:00:46.81,Default,,0,0,0,,Қайырлы таң!
Dialogue: 0,0:00:46.81,0:00:50.81,Default,,0,0,0,,Қайырлы таң. Қайырлы күн Рикка Чан
Dialogue: 0,0:00:50.81,0:00:53.15,Default,,0,0,0,,Хехехе
Dialogue: 0,0:00:53.15,0:00:56.15,Default,,0,0,0,,＜ Кіші орта мектептің қарапайым қыздары
Dialogue: 0,0:00:56.15,0:01:00.49,Default,,0,0,0,,Бұл әдеттегі таңғы көрініске ұқсайды...
Dialogue: 0,0:01:00.49,0:01:04.49,Default,,0,0,0,,Негізі бұл төрт адамның себебі бар＞
Dialogue: 0,0:02:49.13,0:02:53.14,Default,,0,0,0,,Уау~ Чио-санның бентосы дәмді көрінеді~!
Dialogue: 0,0:02:53.14,0:02:55.64,Default,,0,0,0,,Мен бәрін жасадым.
Dialogue: 0,0:02:55.64,0:02:57.64,Default,,0,0,0,,Керемет!
Dialogue: 0,0:02:57.64,0:03:00.48,Default,,0,0,0,,Секине гарнир ретінде тек натто ма?
Dialogue: 0,0:03:00.48,0:03:02.81,Default,,0,0,0,,Натто денсаулыққа пайдалы
Dialogue: 0,0:03:02.81,0:03:05.15,Default,,0,0,0,,Бұл рас болуы мүмкін.
Dialogue: 0,0:03:05.15,0:03:08.82,Default,,0,0,0,,Қарсы болмасаңыз, қуырылған жұмыртқа алғыңыз келе ме?
Dialogue: 0,0:03:08.82,0:03:11.32,Default,,0,0,0,,Жарайды ма? Апыр-ай!
Dialogue: 0,0:03:13.42,0:03:17.43,Default,,0,0,0,,<Өтірікші – ұрының басы дейді.
Dialogue: 0,0:03:17.43,0:03:21.23,Default,,0,0,0,,Негізі мұндағылардың бәрі өтірік айтады.＞
Dialogue: 0,0:03:23.27,0:03:26.27,Default,,0,0,0,,《Олар ешқашан түсінбеуі керек...
Dialogue: 0,0:03:26.27,0:03:31.44,Default,,0,0,0,,Мен Галактикалық революциялық альянстың 1098-ші батальонының полковнигімін.
Dialogue: 0,0:03:31.44,0:03:34.04,Default,,0,0,0,,Папипополо Дуррикка болу! 》
Dialogue: 0,0:03:42.95,0:03:46.12,Default,,0,0,0,,《Ғарыш империясымен шайқас кезінде ұшақ жойылды.
Dialogue: 0,0:03:46.12,0:03:48.46,Default,,0,0,0,,Апат осы планетаға қонды
Dialogue: 0,0:03:48.46,0:03:51.79,Default,,0,0,0,,Бақытымызға орай, менде апаттық құрал болды.
Dialogue: 0,0:03:51.79,0:03:54.30,Default,,0,0,0,,Оны жергілікті тұрғындардың жадын басқару үшін пайдаланыңыз.
Dialogue: 0,0:03:54.30,0:03:58.13,Default,,0,0,0,,Мен бұл мектепке жасырын түрде кіре алдым, бірақ...
Dialogue: 0,0:03:58.13,0:04:00.97,Default,,0,0,0,,Хмм, Чобелиг, эй!
Dialogue: 0,0:04:00.97,0:04:03.64,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,0:04:03.64,0:04:07.14,Default,,0,0,0,,《Қате ме? Мен бірдеңені дұрыс істемедім бе?
Dialogue: 0,0:04:07.14,0:04:09.98,Default,,0,0,0,,Мен бейкүнә қыздың рөлін ойнап жатырмын деп ойладым.
Dialogue: 0,0:04:09.98,0:04:11.92,Default,,0,0,0,,Бірдеңе дұрыс болмады ма? 》
Dialogue: 0,0:04:11.92,0:04:15.08,Default,,0,0,0,,<Мен жаңа ғана дәуірді қате қойдым>
Dialogue: 0,0:04:15.08,0:04:17.92,Default,,0,0,0,,《Жад манипуляциясы арқылы олар мені жасады
Dialogue: 0,0:04:17.92,0:04:20.59,Default,,0,0,0,,Мен өзімді бейкүнә дос санаймын.
Dialogue: 0,0:04:20.59,0:04:24.26,Default,,0,0,0,,Бірақ кінәсіздік дегеніміз не?
Dialogue: 0,0:04:24.26,0:04:26.43,Default,,0,0,0,,Егер сіз күдіктенсеңіз...
Dialogue: 0,0:04:26.43,0:04:29.27,Default,,0,0,0,,Шынымды айтсам, стресстен ештеңенің дәмін тата алмаймын.
Dialogue: 0,0:04:29.27,0:04:32.27,Default,,0,0,0,,Менің достарымның құтқаруын күтуден басқа амалым жоқ.
Dialogue: 0,0:04:34.27,0:04:37.77,Default,,0,0,0,,《Аа, мен сүйкімді қыз дос таптым.
Dialogue: 0,0:04:37.77,0:04:40.28,Default,,0,0,0,,Мен қаншалықты бақыттымын?
Dialogue: 0,0:04:40.28,0:04:43.08,Default,,0,0,0,,Ниндзя болуды қойғаныма өте қуаныштымын》
Dialogue: 0,0:04:48.95,0:04:53.12,Default,,0,0,0,,《Бірнеше ай бұрын маған бірінші өлтіру миссиясын орындау бұйырылды.
Dialogue: 0,0:04:53.12,0:04:55.29,Default,,0,0,0,,Осы мектепке жасырын түрде кіріп кетті
Dialogue: 0,0:04:55.29,0:04:58.13,Default,,0,0,0,,Мектеп директорының өміріне мақсат қою
Dialogue: 0,0:04:58.13,0:05:01.97,Default,,0,0,0,,Бірақ мен тапсырманы орындамадым.
Dialogue: 0,0:05:01.97,0:05:05.97,Default,,0,0,0,,Мен мұнда қарапайым қыз болып өмір сүруді таңдадым》
Dialogue: 0,0:05:12.91,0:05:14.91,Default,,0,0,0,,Ханзо: Ха
Dialogue: 0,0:05:17.41,0:05:19.41,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:23.59,0:05:28.42,Default,,0,0,0,,《Содан бері менің өмірім ауылдан босатқан қастандықтардың нысанасына айналды.
Dialogue: 0,0:05:28.42,0:05:31.43,Default,,0,0,0,,Мен бұл бақыттан қол үзгім келмейді! 》
Dialogue: 0,0:05:31.43,0:05:33.93,Default,,0,0,0,,Чио-сан, қолың жарақаттанып қалды ма?
Dialogue: 0,0:05:33.93,0:05:37.27,Default,,0,0,0,,Иә, иә. Менің итім мені тістеп алды.
Dialogue: 0,0:05:37.27,0:05:39.44,Default,,0,0,0,,Эй, менің итім бар.
Dialogue: 0,0:05:39.44,0:05:41.77,Default,,0,0,0,,Сізде лабрадор немесе басқа нәрсе бар сияқты.
Dialogue: 0,0:05:41.77,0:05:43.77,Default,,0,0,0,,Сүйесің бе?
Dialogue: 0,0:05:43.77,0:05:46.44,Default,,0,0,0,,Менің ойымша, жас ханым ит тұқымдарына мән бермейді.
Dialogue: 0,0:05:46.44,0:05:49.11,Default,,0,0,0,,Қамқоршы сізге бәрін реттеп беретін сияқты.
Dialogue: 0,0:05:49.11,0:05:51.95,Default,,0,0,0,,Жоқ, бұл дұрыс емес.
Dialogue: 0,0:05:51.95,0:05:54.78,Default,,0,0,0,,《Жеке өмірімді барынша ашпауға тырыстым.
Dialogue: 0,0:05:54.78,0:05:57.79,Default,,0,0,0,,Мені жас ханым деп атады.
Dialogue: 0,0:05:57.79,0:06:00.09,Default,,0,0,0,,Мен өзімді аздап кінәлі сезінемін》
Dialogue: 0,0:06:02.46,0:06:05.96,Default,,0,0,0,,《Жат планеталықтар ниндзя деген өтірік, солай ма? 》
Dialogue: 0,0:06:08.46,0:06:10.63,Default,,0,0,0,,《Мен жай ғана орта мектеп оқушысымын
Dialogue: 0,0:06:10.63,0:06:12.57,Default,,0,0,0,,Өйткені оның ерекше табиғаттан тыс күштері бар.
Dialogue: 0,0:06:12.57,0:06:14.57,Default,,0,0,0,,Кейде басқалар не ойлайды
Dialogue: 0,0:06:14.57,0:06:16.91,Default,,0,0,0,,Менің өміріме жаңадан енетін нәрселер бар...
Dialogue: 0,0:06:16.91,0:06:20.91,Default,,0,0,0,,Дәлірек айтқанда, олардың миын бөтен технологиямен жуу керек еді.
Dialogue: 0,0:06:20.91,0:06:23.75,Default,,0,0,0,,Миыңызды жуып жатқаныңызды қалай түсіндіңіз?
Dialogue: 0,0:06:23.75,0:06:26.92,Default,,0,0,0,,Бұл экстрасенстердің ми құрылымы адамдардан өзгеше болғандықтан ба?
Dialogue: 0,0:06:26.92,0:06:29.92,Default,,0,0,0,,Осыған байланысты дәрі-дәрмек соншалықты тиімді болмауы мүмкін...
Dialogue: 0,0:06:29.92,0:06:34.26,Default,,0,0,0,,Қолдарында сәйкестендіру нөмірі және сүйектеріне орнатылған GPS бар.
Dialogue: 0,0:06:34.26,0:06:38.09,Default,,0,0,0,,Біз экстрасенстердің ұйымның бақылауында өмір сүруден басқа амалымыз жоқ.
Dialogue: 0,0:06:38.09,0:06:41.79,Default,,0,0,0,,Шынымды айтсам, маған бәрібір.
Dialogue: 0,0:06:44.10,0:06:46.10,Default,,0,0,0,,《Неге мен?
Dialogue: 0,0:06:46.10,0:06:48.10,Default,,0,0,0,,Менің ойымша, ол қыздар мектебіне барған шығар》
Dialogue: 0,0:06:48.10,0:06:51.27,Default,,0,0,0,,< Айқыш киінген бала Цубаса
Dialogue: 0,0:06:51.27,0:06:53.94,Default,,0,0,0,,Шын аты Цюйоши>
Dialogue: 0,0:06:53.94,0:06:56.28,Default,,0,0,0,,《Цубаса: Бәрі қалай басталды...》
Dialogue: 0,0:06:56.28,0:06:59.45,Default,,0,0,0,,Цуйоши! Takekage Boys сізді қабылдады ма?
Dialogue: 0,0:06:59.45,0:07:01.45,Default,,0,0,0,,Иә
Dialogue: 0,0:07:01.45,0:07:04.95,Default,,0,0,0,,Менің орныма сіз қыздар мектебіне баруыңыз керек.
Dialogue: 0,0:07:04.95,0:07:07.12,Default,,0,0,0,,Иә? Не дейсіз...
Dialogue: 0,0:07:07.12,0:07:11.29,Default,,0,0,0,,Дженниден Такахаши-кун биыл Такекаге Даншиге баратын сияқты.
Dialogue: 0,0:07:11.29,0:07:13.56,Default,,0,0,0,,Бірақ... Жарайды.
Dialogue: 0,0:07:13.56,0:07:16.40,Default,,0,0,0,,Олар егіздерге ұқсайды. Эй!
Dialogue: 0,0:07:16.40,0:07:19.74,Default,,0,0,0,,《Осындай күйде әпкеме бірдеңе дегеннің мәні жоқ.
Dialogue: 0,0:07:19.74,0:07:23.41,Default,,0,0,0,,Сонымен қатар, қыздар мектебіне жасырын кіру сияқты бақытсыз тентек оқиға болатынына сенімдімін.
Dialogue: 0,0:07:23.41,0:07:25.74,Default,,0,0,0,,Менің біраз үмітім бар еді.
Dialogue: 0,0:07:25.74,0:07:28.08,Default,,0,0,0,,Ең алдымен маған не ұнайды?
Dialogue: 0,0:07:28.08,0:07:32.28,Default,,0,0,0,,Бір сөзбен айтқанда, ол сексуалды ханым》
Dialogue: 0,0:07:37.92,0:07:40.92,Default,,0,0,0,,《Қызық екен, жарайды》
Dialogue: 0,0:07:40.92,0:07:44.59,Default,,0,0,0,,《Менің ойымша, Цубаса ақылды мүлдем оқи алмайды~》
Dialogue: 0,0:07:44.59,0:07:48.29,Default,,0,0,0,,<Секиненің табиғаттан тыс күштері бір жыныстағыларға ғана тән>
Dialogue: 0,0:07:50.27,0:07:53.10,Default,,0,0,0,,Эй, Рикка, кел, анау тұлып
Dialogue: 0,0:07:53.10,0:07:55.77,Default,,0,0,0,,Маған қол тигізуге рұқсат бере аласыз ба? иә?
Dialogue: 0,0:07:55.77,0:07:58.94,Default,,0,0,0,,Менде бұрыннан бар, бірақ қол тигізгенде жақсы сезінеді ме?
Dialogue: 0,0:07:58.94,0:08:03.78,Default,,0,0,0,,Қарсы болмасаң, аздап түртіп алайын.
Dialogue: 0,0:08:03.78,0:08:05.78,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:08:05.78,0:08:08.95,Default,,0,0,0,,Бұл атамның маған берген маңызды нәрсесі.
Dialogue: 0,0:08:08.95,0:08:11.89,Default,,0,0,0,,Түсіндім, туған күнге сыйлық?
Dialogue: 0,0:08:11.89,0:08:16.06,Default,,0,0,0,,Бұл Риккаға арналған...
Dialogue: 0,0:08:16.06,0:08:19.96,Default,,0,0,0,,Жоқ, бұл барлық азаматтар үшін бәрінен де маңызды...
Dialogue: 0,0:08:21.90,0:08:24.40,Default,,0,0,0,,Мен оны Ұлттық құрылу күнінде алдым!
Dialogue: 0,0:08:24.40,0:08:26.90,Default,,0,0,0,,《Полковник, полковник тағы да қателесті!
Dialogue: 0,0:08:26.90,0:08:30.57,Default,,0,0,0,,Біз Жердегі Ұлттық Құрылған күні сыйлық бермейміз! 》
Dialogue: 0,0:08:30.57,0:08:36.25,Default,,0,0,0,,Мен көремін. Мұндай ойлау тәсілі бар ма?
Dialogue: 0,0:08:36.25,0:08:39.08,Default,,0,0,0,,《Аа, ең қауіпсіз серіктестік》
Dialogue: 0,0:08:39.08,0:08:42.25,Default,,0,0,0,,Иә! Ұлттық құрылу күні біздің ұлттық егемендігіміздің бар екендігін атап өтеді...
Dialogue: 0,0:08:42.25,0:08:44.25,Default,,0,0,0,,《Полковник~! 》
Dialogue: 0,0:08:44.25,0:08:48.26,Default,,0,0,0,,Мен дәретханаға барғым келеді.
Dialogue: 0,0:08:48.26,0:08:50.26,Default,,0,0,0,,《Қанаттар ажыратылған》
Dialogue: 0,0:08:50.26,0:08:53.43,Default,,0,0,0,,Менің қарттың баласы екенімді бәрі білді.
Dialogue: 0,0:08:53.43,0:08:55.60,Default,,0,0,0,,《Бұл рас па? 》
Dialogue: 0,0:08:55.60,0:08:59.10,Default,,0,0,0,,《Иә, атам бастаған революциялық әскердің ұмтылысы.
Dialogue: 0,0:08:59.10,0:09:01.10,Default,,0,0,0,,Қорғау менің міндетім!
Dialogue: 0,0:09:01.10,0:09:05.27,Default,,0,0,0,,Мен полковник және ұшқыш ретінде ғарышқа мүмкіндігінше тезірек оралуым керек! 》
Dialogue: 0,0:09:05.27,0:09:07.44,Default,,0,0,0,,《Эйс ұшқышы?!》
Dialogue: 0,0:09:07.44,0:09:10.45,Default,,0,0,0,,《:
Dialogue: 0,0:09:10.45,0:09:13.22,Default,,0,0,0,,Бір-бірімізбен сырласайық. Содан кейін қалған энергиямен,
Dialogue: 0,0:09:13.22,0:09:15.55,Default,,0,0,0,,Апат сигналын жіберу мүмкіндігі болуы керек
Dialogue: 0,0:09:15.55,0:09:17.55,Default,,0,0,0,,Қош болыңыздар
Dialogue: 0,0:09:17.55,0:09:20.39,Default,,0,0,0,,...
Dialogue: 0,0:09:20.39,0:09:23.23,Default,,0,0,0,,Қайта кездескенше, жерлес достар!
Dialogue: 0,0:09:23.23,0:09:27.73,Default,,0,0,0,,. 》
Dialogue: 0,0:09:36.41,0:09:38.41,Default,,0,0,0,,《
Dialogue: 0,0:09:38.41,0:09:40.41,Default,,0,0,0,,Не, сен оны жаңа ғана аяқтадың! 》
Dialogue: 0,0:09:43.91,0:09:47.92,Default,,0,0,0,,…
Dialogue: 0,0:09:47.92,0:09:49.92,Default,,0,0,0,,Сіз не істедіңіз?
Dialogue: 0,0:09:49.92,0:09:51.92,Default,,0,0,0,,Не?
Dialogue: 0,0:09:51.92,0:09:54.26,Default,,0,0,0,,《 》
Dialogue: 0,0:09:54.26,0:09:57.59,Default,,0,0,0,,Негізі мен барлығынан жасыратын бір нәрсе бар.
Dialogue: 0,0:09:57.59,0:10:00.60,Default,,0,0,0,,...
Dialogue: 0,0:10:00.60,0:10:04.43,Default,,0,0,0,,Мен сені жек көретініме сене алар емеспін! мен не болса да
Dialogue: 0,0:10:04.43,0:10:06.60,Default,,0,0,0,,...
Dialogue: 0,0:10:06.60,0:10:08.77,Default,,0,0,0,,Чио-сан...
Dialogue: 0,0:10:08.77,0:10:12.11,Default,,0,0,0,,《Аа~ Тоқташы~! 》
Dialogue: 0,0:10:12.11,0:10:16.11,Default,,0,0,0,,Сонымен, менмендікпен ...
Dialogue: 0,0:10:16.11,0:10:18.28,Default,,0,0,0,,Эх… Не?
Dialogue: 0,0:10:18.28,0:10:21.78,Default,,0,0,0,,Кешіріңіз, мен дәретханаға баруым керек.
Dialogue: 0,0:10:21.78,0:10:24.45,Default,,0,0,0,,Жаңа ғана үлкен шурикен алдым
Dialogue: 0,0:10:24.45,0:10:28.62,Default,,0,0,0,,《:
Dialogue: 0,0:10:28.62,0:10:31.46,Default,,0,0,0,,...
Dialogue: 0,0:10:31.46,0:10:34.96,Default,,0,0,0,,Ал, қайтатын кез келді.
Dialogue: 0,0:10:34.96,0:10:36.96,Default,,0,0,0,,Рюука — Ягами Лайттың беткі досы ғана.
Dialogue: 0,0:10:38.97,0:10:43.27,Default,,0,0,0,,…
Dialogue: 0,0:10:46.14,0:10:49.48,Default,,0,0,0,,Ах. Не!?
Dialogue: 0,0:10:49.48,0:10:52.82,Default,,0,0,0,,Не? Екеуі де осында... Эй!
Dialogue: 0,0:10:52.82,0:10:55.65,Default,,0,0,0,,Аа, солай.
Dialogue: 0,0:10:55.65,0:10:57.82,Default,,0,0,0,,Бұл айдан!
Dialogue: 0,0:10:57.82,0:11:00.66,Default,,0,0,0,,《Ай заты? 》
Dialogue: 0,0:11:00.66,0:11:04.66,Default,,0,0,0,,Түсіндім... бұл қиын, солай емес пе?
Dialogue: 0,0:11:04.66,0:11:09.17,Default,,0,0,0,,《Ай? Сіз Жердің спутниктері туралы айтып отырсыз ба? Мұның не қатысы бар...》
Dialogue: 0,0:11:09.17,0:11:12.10,Default,,0,0,0,,Иә, иә! Рикка да!
Dialogue: 0,0:11:12.10,0:11:14.60,Default,,0,0,0,,Шашыңнан аяғыңның ұшына дейін қанға боясың.
Dialogue: 0,0:11:14.60,0:11:16.61,Default,,0,0,0,,《Әрине, бұл дұрыс емес.
Dialogue: 0,0:11:16.61,0:11:18.94,Default,,0,0,0,,Дәлірек айтқанда
Dialogue: 0,0:11:18.94,0:11:22.61,Default,,0,0,0,,Бұл мектепте не болып жатыр? 》
Dialogue: 0,0:11:22.61,0:11:27.01,Default,,0,0,0,,<Өзімді сөреге қойып, Секине болды> деп ойладым
Dialogue: 0,0:11:29.45,0:11:31.45,Default,,0,0,0,,Сөре!
Dialogue: 0,0:11:33.46,0:11:38.13,Default,,0,0,0,,Ухуху, бұл біртүрлі~. Хуу, бұл рас па?
Dialogue: 0,0:11:38.13,0:11:41.13,Default,,0,0,0,,Байыпты, байыпты. Ал Секине ол кезде...
Dialogue: 0,0:11:41.13,0:11:44.80,Default,,0,0,0,,Бұл жеткілікті. (Цубаса) Жарайды, жасайық.
Dialogue: 0,0:11:44.80,0:11:46.80,Default,,0,0,0,,《Мен не істеуім керек...》
Dialogue: 0,0:11:49.47,0:11:52.48,Default,,0,0,0,,《Осылайын деп тұрмын
Dialogue: 0,0:11:52.48,0:11:56.31,Default,,0,0,0,,Неліктен? Неліктен бұл кенеттен осылай болды...》
Dialogue: 0,0:11:56.31,0:11:58.31,Default,,0,0,0,,Рикка, не болды?
Dialogue: 0,0:11:58.31,0:12:01.32,Default,,0,0,0,,Жарайды, проблема жоқ! сурет?
Dialogue: 0,0:12:01.32,0:12:03.65,Default,,0,0,0,,《Жоқ, жоқ! Негіздерге қайтып оралмаңыз!
Dialogue: 0,0:12:03.65,0:12:08.32,Default,,0,0,0,,Миды жуу арқылы барлығына берілген жағдай оның бейкүнә қыз екендігі болды》
Dialogue: 0,0:12:08.32,0:12:10.33,Default,,0,0,0,,Терлейсіз бе?
Dialogue: 0,0:12:10.33,0:12:12.26,Default,,0,0,0,,Мен оны жазған жоқпын.
Dialogue: 0,0:12:12.26,0:12:15.93,Default,,0,0,0,,Бұл жұлдыздың көз жасы ма? Эххе
Dialogue: 0,0:12:15.93,0:12:18.77,Default,,0,0,0,,《Қоғамға түскен соң бұл бала жақсы бола ма?》
Dialogue: 0,0:12:18.77,0:12:21.10,Default,,0,0,0,,< Белгілі бір мағынада кейіпкер жасау сәтті болды.
Dialogue: 0,0:12:21.10,0:12:23.11,Default,,0,0,0,,Бұл полковник Рикка болды＞
Dialogue: 0,0:12:23.11,0:12:25.44,Default,,0,0,0,,Бірақ менің түсім жақсы емес.
Dialogue: 0,0:12:25.44,0:12:28.44,Default,,0,0,0,,Менің ойымша, солай ма? Мен өте жақсы жүрмін!
Dialogue: 0,0:12:28.44,0:12:33.78,Default,,0,0,0,,《Ааа! Мен бәрін алаңдата алмаймын...》
Dialogue: 0,0:12:33.78,0:12:36.62,Default,,0,0,0,,Лента да дымқыл емес пе?
Dialogue: 0,0:12:36.62,0:12:38.62,Default,,0,0,0,,Таспа?
Dialogue: 0,0:12:38.62,0:12:42.29,Default,,0,0,0,,《Сіз антенналарды айтасыз ба? Мимикрия бұзылып кетуі мүмкін бе? 》
Dialogue: 0,0:12:42.29,0:12:45.13,Default,,0,0,0,,《Бұл антенна ма?
Dialogue: 0,0:12:45.13,0:12:47.30,Default,,0,0,0,,Жұмбақ шырын шығып жатыр!?
Dialogue: 0,0:12:47.30,0:12:50.80,Default,,0,0,0,,Сен жақсысың деп үміттенемін. Аа, дұрыс.
Dialogue: 0,0:12:50.80,0:12:54.80,Default,,0,0,0,,Мен барлығына печенье пісірдім. Рикка-чан да келіңізші.
Dialogue: 0,0:12:54.80,0:12:57.64,Default,,0,0,0,,Ах, рахмет
Dialogue: 0,0:12:57.64,0:13:01.14,Default,,0,0,0,,Чио-сан, сен бұл күндері өте белсенді сияқтысың.
Dialogue: 0,0:13:01.14,0:13:03.98,Default,,0,0,0,,Ал, енді түсіндің.
Dialogue: 0,0:13:03.98,0:13:08.98,Default,,0,0,0,,Негізі мен осы уақытқа дейін тек оқумен ғана айналыстым...
Dialogue: 0,0:13:08.98,0:13:13.26,Default,,0,0,0,,Соңғы кездері хоббиім ретінде тәттілер жасап, мүсіндер жасаумен айналыстым.
Dialogue: 0,0:13:13.26,0:13:16.59,Default,,0,0,0,,Әр күн орындалады! Бұл дұрыс
Dialogue: 0,0:13:16.59,0:13:19.43,Default,,0,0,0,,《Жас ханымның талғампаз хоббилері де бар.》
Dialogue: 0,0:13:19.43,0:13:22.93,Default,,0,0,0,,Бұл өте пайдалы!
Dialogue: 0,0:13:22.93,0:13:27.94,Default,,0,0,0,,<Себебі отбасы оған қамқор болған адамдардың санына сәйкес Буддаларды оюды шешті>
Dialogue: 0,0:13:27.94,0:13:30.94,Default,,0,0,0,,《Бұл ауыр, Ниндзя қыз》
Dialogue: 0,0:13:30.94,0:13:35.11,Default,,0,0,0,,Сәлем, бәріңе. Көпшілік алдында.
Dialogue: 0,0:13:35.11,0:13:37.78,Default,,0,0,0,,Сіз ысқырған кезіңіз болды ма?
Dialogue: 0,0:13:37.78,0:13:39.78,Default,,0,0,0,,《Мен өзімнің шынайы сезімдерім бойынша жарыстым》
Dialogue: 0,0:13:39.78,0:13:41.78,Default,,0,0,0,,Иә Иә Мүлдем Иә
Dialogue: 0,0:13:41.78,0:13:44.79,Default,,0,0,0,,Ұят, бірақ мен де.
Dialogue: 0,0:13:44.79,0:13:46.96,Default,,0,0,0,,《Түсіндім, бұл жақсы болды.
Dialogue: 0,0:13:46.96,0:13:50.63,Default,,0,0,0,,Сондықтан мен оны осында жариялауымда ешқандай проблема жоқ...
Dialogue: 0,0:13:50.63,0:13:52.63,Default,,0,0,0,,Хлор газы》
Dialogue: 0,0:13:52.63,0:13:55.30,Default,,0,0,0,,《Ашулы у, оны араластырмаңыз! Қауіпті! 》
Dialogue: 0,0:13:55.30,0:13:58.30,Default,,0,0,0,,Адамдардың көзінше ұрып-соғуға жол берілмейді!
Dialogue: 0,0:13:58.30,0:14:00.80,Default,,0,0,0,,Жарайды, бұл физиологиялық құбылыс, сондықтан біз оған қарсы ештеңе істей алмаймыз.
Dialogue: 0,0:14:00.80,0:14:02.81,Default,,0,0,0,,Мен өлетін сияқты емеспін.
Dialogue: 0,0:14:02.81,0:14:05.47,Default,,0,0,0,,Мен мұны барлығы үшін айтып отырмын!
Dialogue: 0,0:14:05.47,0:14:09.31,Default,,0,0,0,,Рикканың ақыл-парасатының жоқтығы бүгін немесе ертең түзетілетін нәрсе емес.
Dialogue: 0,0:14:09.31,0:14:11.75,Default,,0,0,0,,Кәдімгі мінез-құлқыма қарағанда, бұл осар сияқты.
Dialogue: 0,0:14:11.75,0:14:15.58,Default,,0,0,0,,《Әй... Сен солай ойладың ба?
Dialogue: 0,0:14:15.58,0:14:20.42,Default,,0,0,0,,Мен осы планетаның мәдениетімен араласуға тырыссам да...》
Dialogue: 0,0:14:20.42,0:14:23.43,Default,,0,0,0,,Олай болса, оны ешкім жоқ жерде жасаңыз!
Dialogue: 0,0:14:23.43,0:14:27.26,Default,,0,0,0,,Немесе скотчпен жабылған жабық бөлмеде!
Dialogue: 0,0:14:27.26,0:14:29.60,Default,,0,0,0,,Әзірге, ең болмағанда ваннаға барыңыз!
Dialogue: 0,0:14:29.60,0:14:31.60,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:31.60,0:14:33.60,Default,,0,0,0,,《Басқа студенттердің өміріне қауіп төніп тұр! 》
Dialogue: 0,0:14:33.60,0:14:38.11,Default,,0,0,0,,Ах аа
Dialogue: 0,0:14:38.11,0:14:40.44,Default,,0,0,0,,Қый!
Dialogue: 0,0:14:40.44,0:14:42.61,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:42.61,0:14:44.61,Default,,0,0,0,,Ааа...
Dialogue: 0,0:14:44.61,0:14:46.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:46.78,0:14:48.78,Default,,0,0,0,,(ысқыру дыбысы)
Dialogue: 0,0:14:48.78,0:14:50.78,Default,,0,0,0,,Жануар демі: жетінші форма
Dialogue: 0,0:14:54.12,0:14:56.13,Default,,0,0,0,,Техе!
Dialogue: 0,0:14:56.13,0:14:58.46,Default,,0,0,0,,<Айтпақшы, егер сіз өзіңізді ұстасаңыз,
Dialogue: 0,0:14:58.46,0:15:01.46,Default,,0,0,0,,Ауыз бен мұрыннан дем шығарылған ауа араласқан газ шығады>
Dialogue: 0,0:15:01.46,0:15:04.97,Default,,0,0,0,,Хи~ Хи~ Хи~ Хи~ Хи~
Dialogue: 0,0:15:04.97,0:15:07.30,Default,,0,0,0,,<5 Уау...>
Dialogue: 0,0:15:12.91,0:15:15.91,Default,,0,0,0,,《Ой, полковник Рикка бірдеңені ұмытып қалды.
Dialogue: 0,0:15:15.91,0:15:18.75,Default,,0,0,0,,Олар осылайша бәрінің миын шайып тастады》
Dialogue: 0,0:15:18.75,0:15:20.75,Default,,0,0,0,,О, Секине мырза
Dialogue: 0,0:15:20.75,0:15:22.75,Default,,0,0,0,,Сіз әлі оралмадыңыз ба?
Dialogue: 0,0:15:22.75,0:15:25.75,Default,,0,0,0,,Себебі мен сынып күнделігін жазып отырдым.
Dialogue: 0,0:15:25.75,0:15:27.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:30.26,0:15:32.43,Default,,0,0,0,,Пи Гага Га Пи. Апыр-ай!
Dialogue: 0,0:15:32.43,0:15:34.93,Default,,0,0,0,,Бип Гагагапи. Мен бір нәрсені ұмытып қалдым!
Dialogue: 0,0:15:34.93,0:15:36.93,Default,,0,0,0,,болды
Dialogue: 0,0:15:36.93,0:15:40.93,Default,,0,0,0,,Пипипопурулупопипипуппоппирири пурипурипуриппо
Dialogue: 0,0:15:44.44,0:15:46.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:55.95,0:16:00.46,Default,,0,0,0,,Барлығың, дәл қазір қолдарыңды бастың артына қойып сапқа тұрыңдар.
Dialogue: 0,0:16:00.46,0:16:03.63,Default,,0,0,0,,Бұл солай ма? Сіз кенеттен не айтып тұрсыз?
Dialogue: 0,0:16:03.63,0:16:06.30,Default,,0,0,0,,Кешіріңіз, бірақ мен сізді көндіргім келмейді.
Dialogue: 0,0:16:06.30,0:16:08.63,Default,,0,0,0,,10 секунд ішінде орындамасаңыз
Dialogue: 0,0:16:08.63,0:16:10.97,Default,,0,0,0,,Мен оны сұйықтыққа айналдыру үшін Pupurum су пистолетін қолданамын.
Dialogue: 0,0:16:10.97,0:16:14.24,Default,,0,0,0,,3 адам: Пурупуру~н
Dialogue: 0,0:16:14.24,0:16:16.24,Default,,0,0,0,,《Бұл өте маңызды! 》
Dialogue: 0,0:16:16.24,0:16:19.58,Default,,0,0,0,,10 9 8 7…｡ Жоқ, тіпті егер сіз кенеттен солай айтса да.
Dialogue: 0,0:16:19.58,0:16:23.75,Default,,0,0,0,,Жарайды. Маған жазылыңыз.
Dialogue: 0,0:16:23.75,0:16:26.42,Default,,0,0,0,,＜Шынымды айтсам, оны атып өлтіргенге дейін 5 секунд болды＞
Dialogue: 0,0:16:26.42,0:16:28.42,Default,,0,0,0,,５４３２１…
Dialogue: 0,0:16:30.42,0:16:33.26,Default,,0,0,0,,Бұл қандай ойын түрі?
Dialogue: 0,0:16:33.26,0:16:37.76,Default,,0,0,0,,《Мен мұны істедім~ Құрылғыға су шашыратқаным үшін.
Dialogue: 0,0:16:37.76,0:16:40.96,Default,,0,0,0,,Мен шыншыл болуым керек пе? Бірақ…》
Dialogue: 0,0:16:42.93,0:16:46.27,Default,,0,0,0,,《Мен саған шындықты айтсам да, мені кешірмейтін шығарсың!
Dialogue: 0,0:16:46.27,0:16:48.60,Default,,0,0,0,,Мен бәрібір өлтіретін болсам...》
Dialogue: 0,0:16:48.60,0:16:51.94,Default,,0,0,0,,Иә! Мен шынымен сұрағым келген нәрсе бар!
Dialogue: 0,0:16:51.94,0:16:54.74,Default,,0,0,0,,Не? Рикка…
Dialogue: 0,0:16:58.45,0:17:00.62,Default,,0,0,0,,Антенналардан да нәжіс шыға ма?
Dialogue: 0,0:17:00.62,0:17:04.12,Default,,0,0,0,,Абаба Бабаба...
Dialogue: 0,0:17:04.12,0:17:07.62,Default,,0,0,0,,《Жоқ, жоқ. Мен әлсіреп, біртүрлі елестедім.》
Dialogue: 0,0:17:09.63,0:17:14.23,Default,,0,0,0,,Сен менің досыма жасырын кірген жасырын тыңшысың.
Dialogue: 0,0:17:14.23,0:17:16.90,Default,,0,0,0,,Тезірек қуыруды бастайық.
Dialogue: 0,0:17:16.90,0:17:18.90,Default,,0,0,0,,Сондықтан...
Dialogue: 0,0:17:21.40,0:17:25.24,Default,,0,0,0,,Жер туралы сұрақ-жауап 1!
Dialogue: 0,0:17:25.24,0:17:27.91,Default,,0,0,0,,Кейбір негізгі сұрақтардан бастайық.
Dialogue: 0,0:17:27.91,0:17:30.75,Default,,0,0,0,,Жер қанша жыл бұрын дүниеге келді?
Dialogue: 0,0:17:30.75,0:17:33.75,Default,,0,0,0,,Жер тұрғыны бұл сұраққа жауап бере алуы керек.
Dialogue: 0,0:17:33.75,0:17:35.92,Default,,0,0,0,,А... 4,6 миллиард жыл?
Dialogue: 0,0:17:35.92,0:17:39.59,Default,,0,0,0,,Күн жүйесіндегі Жердің тығыздығы қанша?
Dialogue: 0,0:17:39.59,0:17:41.59,Default,,0,0,0,,№1, солай ма?
Dialogue: 0,0:17:41.59,0:17:44.93,Default,,0,0,0,,Жердің пайда болуына қатысты ең ықтимал гипотеза қандай?
Dialogue: 0,0:17:44.93,0:17:49.10,Default,,0,0,0,,Планетацималдардан алынған протопланета моделі?
Dialogue: 0,0:17:49.10,0:17:53.10,Default,,0,0,0,,Цубаса ханым, сіз...
Dialogue: 0,0:17:55.10,0:17:57.27,Default,,0,0,0,,Ол сөзсіз Жерлік!
Dialogue: 0,0:17:57.27,0:18:01.11,Default,,0,0,0,,Жер тұрғындары... Оларға аспан денелері ұнайды.
Dialogue: 0,0:18:01.11,0:18:03.45,Default,,0,0,0,,Келесіде Секине ханым. Иә!
Dialogue: 0,0:18:03.45,0:18:08.05,Default,,0,0,0,,298.257222101 бөлім!
Dialogue: 0,0:18:10.29,0:18:12.22,Default,,0,0,0,,Дұрыс
Dialogue: 0,0:18:12.22,0:18:15.39,Default,,0,0,0,,《Психикалық алдау - ең жақсы! 》
Dialogue: 0,0:18:15.39,0:18:18.23,Default,,0,0,0,,Бір ғана адам қалды, Чио-сан.
Dialogue: 0,0:18:18.23,0:18:20.23,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасаймын!
Dialogue: 0,0:18:20.23,0:18:23.90,Default,,0,0,0,,《Мынау сұлу да мейірімді Тиё-сан империяның тыңшысы ма?
Dialogue: 0,0:18:23.90,0:18:26.24,Default,,0,0,0,,Сондықтан...》
Dialogue: 0,0:18:26.24,0:18:29.91,Default,,0,0,0,,Рикка-чан шынымен сүйкімді нәрсе
Dialogue: 0,0:18:29.91,0:18:33.91,Default,,0,0,0,,Жарайды, парасаттылық жоқ деген сөз жоқ!
Dialogue: 0,0:18:33.91,0:18:36.41,Default,,0,0,0,,Чио! Уфуфуфуфуфуфуфуфу…
Dialogue: 0,0:18:36.41,0:18:41.42,Default,,0,0,0,,《Мен сенгім келмейді. Бірақ мен жеке сезімдердің араласуына жол бере алмаймын! 》
Dialogue: 0,0:18:41.42,0:18:45.02,Default,,0,0,0,,Жер туралы викторина да жақсы идея...
Dialogue: 0,0:18:47.26,0:18:50.26,Default,,0,0,0,,Төмендегілердің қайсысы Жердің пішіні?
Dialogue: 0,0:18:50.26,0:18:52.26,Default,,0,0,0,,Бұл үшбұрыш па?
Dialogue: 0,0:18:54.43,0:18:56.43,Default,,0,0,0,,Чио-сан?
Dialogue: 0,0:18:56.43,0:19:00.10,Default,,0,0,0,,Дұрыс жауап қандай? Мен сондай қуаныштымын!
Dialogue: 0,0:19:00.10,0:19:03.94,Default,,0,0,0,,Чио-сан, кешіріңіз.
Dialogue: 0,0:19:03.94,0:19:06.11,Default,,0,0,0,,Революцияның негізі бол!
Dialogue: 0,0:19:06.11,0:19:08.11,Default,,0,0,0,,Уау
Dialogue: 0,0:19:08.11,0:19:10.95,Default,,0,0,0,,Күте тұрыңыз! Жоқ, Чио...
Dialogue: 0,0:19:10.95,0:19:12.88,Default,,0,0,0,,Сен жай ғана ақымақсың!
Dialogue: 0,0:19:12.88,0:19:15.88,Default,,0,0,0,,Бухаааааааааааааааааааааааа...
Dialogue: 0,0:19:15.88,0:19:17.89,Default,,0,0,0,,Бұл не!?
Dialogue: 0,0:19:17.89,0:19:21.06,Default,,0,0,0,,Сағынып қалдыңыз ба!? Оның үстіне жердегілерге өлтіретін әсері жоқ!?
Dialogue: 0,0:19:21.06,0:19:24.56,Default,,0,0,0,,Ах. Ха.
Dialogue: 0,0:19:24.56,0:19:29.46,Default,,0,0,0,,《Әй, әдетім бойынша мен қарсы шықтым》
Dialogue: 0,0:19:34.07,0:19:36.07,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:36.07,0:19:39.07,Default,,0,0,0,,Амансың ба? Рикка-чан
Dialogue: 0,0:19:39.07,0:19:41.24,Default,,0,0,0,,《Менің құрылғым ше? 》
Dialogue: 0,0:19:41.24,0:19:44.58,Default,,0,0,0,,Ол дымқыл болды, сондықтан мен оны көлеңкеде кептірдім.
Dialogue: 0,0:19:44.58,0:19:47.42,Default,,0,0,0,,《Бұл түзетілді деп үміттенемін! 》
Dialogue: 0,0:19:47.42,0:19:50.25,Default,,0,0,0,,《Жау сарбаздары енді көрсетілмейді.
Dialogue: 0,0:19:50.25,0:19:52.75,Default,,0,0,0,,Бұл ақаулық болды ма? 》
Dialogue: 0,0:19:52.75,0:19:54.76,Default,,0,0,0,,Рикка, кел...
Dialogue: 0,0:19:54.76,0:19:57.09,Default,,0,0,0,,Бұрын бұл не туралы болды?
Dialogue: 0,0:19:57.09,0:19:59.09,Default,,0,0,0,,Ал...
Dialogue: 0,0:19:59.09,0:20:02.76,Default,,0,0,0,,Күдікті болып, бір азаматты атып өлтіре жаздады
Dialogue: 0,0:20:02.76,0:20:05.77,Default,,0,0,0,,Асығыс солдат ойнау... мүмкін бе?
Dialogue: 0,0:20:05.77,0:20:07.77,Default,,0,0,0,,<Мойындауға жақын>
Dialogue: 0,0:20:07.77,0:20:11.61,Default,,0,0,0,,Хоббилер өзімшіл, бірақ мен шынымды айтсам, олар туралы ойлануларыңызды қалаймын.
Dialogue: 0,0:20:11.61,0:20:14.44,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:20:14.44,0:20:16.78,Default,,0,0,0,,Өкініштің дәлелі ретінде
Dialogue: 0,0:20:16.78,0:20:19.11,Default,,0,0,0,,Ұлы көсем берген
Dialogue: 0,0:20:19.11,0:20:21.62,Default,,0,0,0,,Мен бұл медальді қайтарамын.
Dialogue: 0,0:20:21.62,0:20:24.45,Default,,0,0,0,,<Бұл полковник Рикканың қазынасы болды>
Dialogue: 0,0:20:24.45,0:20:26.79,Default,,0,0,0,,Сіз бұған мүлдем өкінбейсіз, солай ма?
Dialogue: 0,0:20:26.79,0:20:29.29,Default,,0,0,0,,Ойынның бұл кезеңі жасанды ойын ба?
Dialogue: 0,0:20:29.29,0:20:33.46,Default,,0,0,0,,Жоқ, мен өз басым бұған қатты өкінетін сияқтымын!
Dialogue: 0,0:20:33.46,0:20:35.96,Default,,0,0,0,,Менің жүрегім ауыратын сияқты!
Dialogue: 0,0:20:35.96,0:20:39.13,Default,,0,0,0,,Өтінемін, бұлай ашуланба.
Dialogue: 0,0:20:39.13,0:20:41.97,Default,,0,0,0,,Менде жаңа ғана анемия пайда болды.
Dialogue: 0,0:20:41.97,0:20:44.14,Default,,0,0,0,,<Мен осылай шештім>
Dialogue: 0,0:20:44.14,0:20:47.64,Default,,0,0,0,,Екеуіңіз де Риккаға мейірімдісіздер.
Dialogue: 0,0:20:47.64,0:20:50.48,Default,,0,0,0,,Әйтеуір, келесі жолы жыныстық қатынасқа түсеміз.
Dialogue: 0,0:20:50.48,0:20:52.48,Default,,0,0,0,,Иә
Dialogue: 0,0:20:52.48,0:20:57.99,Default,,0,0,0,,《Егер сіз бұл туралы сабырлы түрде ойласаңыз, оны мойындауға мәжбүрлеу үшін жауап алу функциясын пайдалануыңыз керек еді.
Dialogue: 0,0:20:57.99,0:21:00.82,Default,,0,0,0,,Жанама әсерлер сізді құмыраға айналдырса да.
Dialogue: 0,0:21:00.82,0:21:03.12,Default,,0,0,0,,Өтірік айтпаса зиянсыз》
Dialogue: 0,0:21:13.60,0:21:17.11,Default,,0,0,0,,Мен бүгіннен аман-есен өттім, бірақ...
Dialogue: 0,0:21:17.11,0:21:20.51,Default,,0,0,0,,Өтірік айту да өте қиын.
Dialogue: 0,0:21:24.28,0:21:29.08,Default,,0,0,0,,Қандай қиыншылық болса да, мен бұл өмір жолын қорғаймын.
Dialogue: 0,0:21:31.12,0:21:33.79,Default,,0,0,0,,Маку Маку Кума Кума Кума Маку!
Dialogue: 0,0:21:33.79,0:21:36.96,Default,,0,0,0,,Ха... Мен не істеп жатырмын?
Dialogue: 0,0:21:36.96,0:21:39.46,Default,,0,0,0,,Олар білсе қауіпті болар еді.
Dialogue: 0,0:21:43.47,0:21:48.47,Default,,0,0,0,,Уф, неге сонша уайымдайтын жалғыз мен...
Dialogue: 0,0:21:48.47,0:21:50.97,Default,,0,0,0,,<Өтірікші ұры емес
Dialogue: 0,0:21:50.97,0:21:54.64,Default,,0,0,0,,Осы төрт адамның жағдайында бұл олардың достығының басы.
Dialogue: 0,0:21:54.64,0:21:57.54,Default,,0,0,0,,Төрт адамның достығы не болмақ?＞
Dialogue: 0,0:25:13.44,0:25:20.12,Default,,0,0,0,,(цикаданың шырылдауы)
Dialogue: 0,0:25:20.12,0:25:22.45,Default,,0,0,0,,Азу…
Dialogue: 0,0:25:22.45,0:25:26.45,Default,,0,0,0,,《Мен бұны киіп жүрмін, өйткені мен матрос формасынан құтылғым келеді.
Dialogue: 0,0:25:26.45,0:25:29.46,Default,,0,0,0,,Күтілгендей, күн ыстық...》
Dialogue: 0,0:25:29.46,0:25:32.96,Default,,0,0,0,,<Кросс-киіну сезімін барынша жеңіл еткісі келетін Цубаса
Dialogue: 0,0:25:32.96,0:25:35.96,Default,,0,0,0,,Шын есімі - Цуйоши＞
Dialogue: 0,0:25:35.96,0:25:37.97,Default,,0,0,0,,Мен үйдемін~
Dialogue: 0,0:25:37.97,0:25:41.47,Default,,0,0,0,,Қош келдіңіз~ Фуфун
Dialogue: 0,0:27:20.44,0:27:24.44,Default,,0,0,0,,(цикаданың шырылдауы)
Dialogue: 0,0:27:24.44,0:27:26.44,Default,,0,0,0,,Уау...
Dialogue: 0,0:27:26.44,0:27:30.11,Default,,0,0,0,,<Түсіндірейік. Бұл мектепте бар
Dialogue: 0,0:27:30.11,0:27:34.45,Default,,0,0,0,,Жаз мезгілінде ғана киетін, жазғы киім деп аталатын арнайы форма бар.
Dialogue: 0,0:27:34.45,0:27:38.45,Default,,0,0,0,,Өтпейтін арнайы іш киімдер бар.＞
Dialogue: 0,0:27:38.45,0:27:41.96,Default,,0,0,0,,《Бұл... жақсы емес.
Dialogue: 0,0:27:41.96,0:27:44.46,Default,,0,0,0,,Жоқ жоқ жоқ жоқ мүлдем жоқ
Dialogue: 0,0:27:44.46,0:27:48.30,Default,,0,0,0,,Мен матрос формасына шыдадым, бірақ...》
Dialogue: 0,0:27:48.30,0:27:52.47,Default,,0,0,0,,Әпке, енді қолымнан келмейді. Орын ауыстыруды доғарайық!
Dialogue: 0,0:27:52.47,0:27:54.47,Default,,0,0,0,,Суретке түспеңіз! (ысырма дыбысы)
Dialogue: 0,0:27:54.47,0:27:56.47,Default,,0,0,0,,Hmph. Ах!
Dialogue: 0,0:27:56.47,0:28:00.14,Default,,0,0,0,,Жоқ, мүмкін емес, мүмкін емес, мүмкін емес... болды!
Dialogue: 0,0:28:05.98,0:28:10.15,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:28:10.15,0:28:14.09,Default,,0,0,0,,Қайырлы таң!
Dialogue: 0,0:28:14.09,0:28:17.43,Default,,0,0,0,,Қайырлы күн Цубаса-сан
Dialogue: 0,0:28:17.43,0:28:20.10,Default,,0,0,0,,Бүгін барлығы жазғы киім киіп жүр.
Dialogue: 0,0:28:20.10,0:28:22.93,Default,,0,0,0,,Өйткені тым ыстық.
Dialogue: 0,0:28:22.93,0:28:27.10,Default,,0,0,0,,Шынымды айтсам, іш киімді нақтылау азап емес пе?
Dialogue: 0,0:28:27.10,0:28:30.10,Default,,0,0,0,,《Мектепте тек қыздар бар, сондықтан шектен шыққан...》
Dialogue: 0,0:28:32.11,0:28:34.11,Default,,0,0,0,,2 адам: Ахаха Уфуфу Уау!
Dialogue: 0,0:28:34.11,0:28:36.44,Default,,0,0,0,,《Секине: Мен тіпті солай деп ойлаймын》
Dialogue: 0,0:28:36.44,0:28:38.45,Default,,0,0,0,,<Цин…>
Dialogue: 0,0:28:38.45,0:28:42.78,Default,,0,0,0,,Бірақ мына іш киім де сүйкімді.
Dialogue: 0,0:28:42.78,0:28:45.45,Default,,0,0,0,,Мен жарысты жақсы көремін.
Dialogue: 0,0:28:45.45,0:28:49.79,Default,,0,0,0,,А, маған Чио-сан ұнайды, солай емес пе? Ол саған ұнаса жақсы.
Dialogue: 0,0:28:49.79,0:28:51.79,Default,,0,0,0,,Шиеленіс күшейіп келеді
Dialogue: 0,0:28:51.79,0:28:55.46,Default,,0,0,0,,Мен жазғы киімге жарасатын аксессуар жасадым!
Dialogue: 0,0:28:55.46,0:28:57.80,Default,,0,0,0,,Оу!
Dialogue: 0,0:28:57.80,0:28:59.97,Default,,0,0,0,,Мен оны үш әдіспен аяқтадым.
Dialogue: 0,0:28:59.97,0:29:02.47,Default,,0,0,0,,《Оның сүйкімділікке әуестігі бар》
Dialogue: 0,0:29:02.47,0:29:06.98,Default,,0,0,0,,Мен әрқашан сүйкімді нәрселерге көзім жетті. иә?
Dialogue: 0,0:29:06.98,0:29:09.48,Default,,0,0,0,,《Есімде》
Dialogue: 0,0:29:11.91,0:29:13.92,Default,,0,0,0,,Артында болыңыз!
Dialogue: 0,0:29:13.92,0:29:16.42,Default,,0,0,0,,Бірақ егер сіз жалғыз болсаңыз...
Dialogue: 0,0:29:16.42,0:29:18.92,Default,,0,0,0,,Сүйкімді болсаң, артта қал!
Dialogue: 0,0:29:18.92,0:29:21.76,Default,,0,0,0,,Чио бұл туралы бірдеңе жасайды! Хаха!
Dialogue: 0,0:29:21.76,0:29:23.76,Default,,0,0,0,,《Бұл адам Чио-сан ба!?》
Dialogue: 0,0:29:23.76,0:29:26.59,Default,,0,0,0,,《Ол құйрық менің арманым еді》
Dialogue: 0,0:29:26.59,0:29:30.27,Default,,0,0,0,,Мм, қарсы болмасаңыз.
Dialogue: 0,0:29:30.27,0:29:34.10,Default,,0,0,0,,Кішкентай заттар бәріңізге ұнайды деп үміттенемін.
Dialogue: 0,0:29:34.10,0:29:36.10,Default,,0,0,0,,Иә!?
Dialogue: 0,0:29:38.11,0:29:41.44,Default,,0,0,0,,Өте сүйкімді
Dialogue: 0,0:29:41.44,0:29:43.45,Default,,0,0,0,,(Абдул) Жүрейік. Егер біз сұрастыруды жалғастырсақ, сөзсіз
Dialogue: 0,0:29:43.45,0:29:46.95,Default,,0,0,0,,Мен осындай нәрсені киюді армандадым.
Dialogue: 0,0:29:46.95,0:29:49.45,Default,,0,0,0,,《Полковник те қыз.》
Dialogue: 0,0:29:49.45,0:29:52.45,Default,,0,0,0,,《Менің антенналарым ауырады! 》
Dialogue: 0,0:29:52.45,0:29:56.62,Default,,0,0,0,,Екіге, сосын екіге бүкте
Dialogue: 0,0:29:56.62,0:29:58.63,Default,,0,0,0,,Оны резеңкемен байлаңыз...
Dialogue: 0,0:29:58.63,0:30:00.63,Default,,0,0,0,,Кептеліс!
Dialogue: 0,0:30:00.63,0:30:04.47,Default,,0,0,0,,《Чиё-сан, бәрін мықтап байлаудың қажеті жоқ...
Dialogue: 0,0:30:04.47,0:30:08.97,Default,,0,0,0,,Әскери қызметке, мысалы киім-кешекке кедергі келтірмесе, жақсы...
Dialogue: 0,0:30:08.97,0:30:10.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:15.41,0:30:17.91,Default,,0,0,0,,《Қан кеткенше? 》
Dialogue: 0,0:30:17.91,0:30:20.58,Default,,0,0,0,,Ол көлемді болды ма?
Dialogue: 0,0:30:20.58,0:30:23.25,Default,,0,0,0,,Жоқ! Бұл өте тығыз!
Dialogue: 0,0:30:23.25,0:30:25.25,Default,,0,0,0,,<Адал бол>
Dialogue: 0,0:30:25.25,0:30:27.26,Default,,0,0,0,,Қарсы болмасаң, Цубаса-сан...
Dialogue: 0,0:30:27.26,0:30:30.43,Default,,0,0,0,,Аа, жарайды, жарайды, қарап тұрсаңыз жеткілікті.
Dialogue: 0,0:30:30.43,0:30:34.60,Default,,0,0,0,,Цубаса-чан, оны да киіп көріңіз~ Саған жақсы көрінеді, солай ма?
Dialogue: 0,0:30:34.60,0:30:36.93,Default,,0,0,0,,Маған жараспайды Маған жараспайды
Dialogue: 0,0:30:36.93,0:30:39.10,Default,,0,0,0,,Жоқ, бәрі жақсы.
Dialogue: 0,0:30:39.10,0:30:42.60,Default,,0,0,0,,Бірақ бұл сізге сәйкес келетініне сенімдімін.
Dialogue: 0,0:30:42.60,0:30:44.61,Default,,0,0,0,,Иә, бұл не?
Dialogue: 0,0:30:44.61,0:30:46.61,Default,,0,0,0,,Бұл ұлттық киім!
Dialogue: 0,0:30:46.61,0:30:49.44,Default,,0,0,0,,《Бәрі мені тым қатты итеріп жатыр.
Dialogue: 0,0:30:49.44,0:30:51.45,Default,,0,0,0,,А, мүмкін...
Dialogue: 0,0:30:51.45,0:30:55.45,Default,,0,0,0,,Сүйкімді заттар маған жараспайды.
Dialogue: 0,0:30:55.45,0:30:58.45,Default,,0,0,0,,Сіз осылай ойлайсыз ба? 》
Dialogue: 0,0:31:00.46,0:31:04.46,Default,,0,0,0,,<Өйткені Секиненің қабілеті бір жыныспен шектеледі
Dialogue: 0,0:31:04.46,0:31:08.13,Default,,0,0,0,,Қанаттардың ойын түсінбедім>
Dialogue: 0,0:31:08.13,0:31:11.73,Default,,0,0,0,,Менің ойымша, бұл үлкен жігіт маған ұқсамайды.
Dialogue: 0,0:31:11.73,0:31:13.74,Default,,0,0,0,,《Әдемі болуды біл》
Dialogue: 0,0:31:13.74,0:31:17.24,Default,,0,0,0,,Егер сізге қажет болмаса, оны барахолка сайтында сата аласыз.
Dialogue: 0,0:31:17.24,0:31:20.24,Default,,0,0,0,,Иә!? 《Цубаса: Бұл адамға қатысты ма?》
Dialogue: 0,0:31:20.24,0:31:22.91,Default,,0,0,0,,Цубаса-чан оны киіп алса, бітеді!
Dialogue: 0,0:31:22.91,0:31:25.08,Default,,0,0,0,,<Мен кептеліп жатырмын>
Dialogue: 0,0:31:25.08,0:31:27.42,Default,,0,0,0,,Уфуфуфуфу…
Dialogue: 0,0:31:27.42,0:31:30.92,Default,,0,0,0,,《Уф...》
Dialogue: 0,0:31:30.92,0:31:33.76,Default,,0,0,0,,Мен аздап макияж жасау мүмкіндігін пайдаланып жатырмын...
Dialogue: 0,0:31:33.76,0:31:36.42,Default,,0,0,0,,《Жоқ, бұл дұрыс емес.
Dialogue: 0,0:31:36.42,0:31:38.93,Default,,0,0,0,,Ұл қыздар ұялшақ.
Dialogue: 0,0:31:38.93,0:31:43.10,Default,,0,0,0,,Бұл олай емес. Мен, мен шынымен
Dialogue: 0,0:31:43.10,0:31:46.43,Default,,0,0,0,,Мен оны кигім келмейді! 》
Dialogue: 0,0:31:46.43,0:31:51.11,Default,,0,0,0,,<Жанның қол жетпес зары>
Dialogue: 0,0:31:51.11,0:31:54.44,Default,,0,0,0,,Ах~ Бар, қош келдің...
Dialogue: 0,0:31:54.44,0:31:59.11,Default,,0,0,0,,Қый!
Dialogue: 0,0:31:59.11,0:32:01.51,Default,,0,0,0,,Суретке түспеңіз! (ысырма дыбысы)
Dialogue: 0,0:32:07.46,0:32:10.96,Default,,0,0,0,,О? Бұл қамқоршы рухты болжау.
Dialogue: 0,0:32:10.96,0:32:12.89,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:32:12.89,0:32:14.90,Default,,0,0,0,,Маған қызық, бұл не!
Dialogue: 0,0:32:14.90,0:32:17.40,Default,,0,0,0,,《Осындай нәрсеге қалай сенесің?
Dialogue: 0,0:32:17.40,0:32:19.90,Default,,0,0,0,,Жер деп аталатын бұл планета артта қалды...》
Dialogue: 0,0:32:19.90,0:32:22.90,Default,,0,0,0,,《Така! Оның құны қанша күндік тамақ?
Dialogue: 0,0:32:22.90,0:32:27.41,Default,,0,0,0,,《Күдікті, рухани жанрларды ұнатпаймын.》
Dialogue: 0,0:32:27.41,0:32:30.41,Default,,0,0,0,,Хехе…
Dialogue: 0,0:32:30.41,0:32:34.58,Default,,0,0,0,,《Бұл күдікті болып көрінуі мүмкін, бірақ мен нағыз экстрасенспін》
Dialogue: 0,0:32:34.58,0:32:37.75,Default,,0,0,0,,Мен сені сонда қараймын, жарай ма?
Dialogue: 0,0:32:37.75,0:32:41.42,Default,,0,0,0,,Ал, қамқоршы рух немесе бір нәрсе...
Dialogue: 0,0:32:41.42,0:32:46.43,Default,,0,0,0,,Хехе, сен маған сенбейсің. Сонда біз болашаққа көз жүгіртеміз бе?
Dialogue: 0,0:32:46.43,0:32:49.76,Default,,0,0,0,,Енді маған болашақта кімге үйленетініңді айт.
Dialogue: 0,0:32:49.76,0:32:52.93,Default,,0,0,0,,Мен маңызды тақырып қозғағаннан кейін айтатының осы ма?
Dialogue: 0,0:32:52.93,0:32:57.53,Default,,0,0,0,,Түсіндім, сіздің жұбайыңыз...
Dialogue: 0,0:32:59.61,0:33:01.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:33:01.94,0:33:04.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:33:04.45,0:33:08.95,Default,,0,0,0,,《А, түсіндім. Сізге қыздар ұнайды. Жақсы! 》
Dialogue: 0,0:33:08.95,0:33:10.95,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:33:10.95,0:33:14.89,Default,,0,0,0,,Мен егжей-тегжейлерді ашпаймын, себебі олар құпия болуы мүмкін.
Dialogue: 0,0:33:14.89,0:33:18.39,Default,,0,0,0,,Сіз тамаша неке жарын кездестіре аласыз.
Dialogue: 0,0:33:18.39,0:33:22.40,Default,,0,0,0,,Әкімшілікті асыға күтіңіз. Әкімшілік?
Dialogue: 0,0:33:22.40,0:33:27.07,Default,,0,0,0,,Сізді қазір уайымдауыңыз мүмкін. Бірақ бәрібір.
Dialogue: 0,0:33:27.07,0:33:32.07,Default,,0,0,0,,Қоғам өзгерді, мен тамаша тойды көрдім.
Dialogue: 0,0:33:32.07,0:33:34.08,Default,,0,0,0,,Иә
Dialogue: 0,0:33:34.08,0:33:37.41,Default,,0,0,0,,Мм, мен де болсам қарсы болмайсың ба?
Dialogue: 0,0:33:37.41,0:33:39.41,Default,,0,0,0,,Әрине.
Dialogue: 0,0:33:39.41,0:33:42.42,Default,,0,0,0,,Мен қамқоршы рухымның әулие болғанын қалаймын.
Dialogue: 0,0:33:42.42,0:33:46.92,Default,,0,0,0,,《Хохо... Онда терең терезе ханымның атмосферасы бар.
Dialogue: 0,0:33:46.92,0:33:51.42,Default,,0,0,0,,Баланың бұл түріне қатысты ата-баба жалғанатын жағдайлар бар...》
Dialogue: 0,0:33:53.93,0:33:55.93,Default,,0,0,0,,Әй?
Dialogue: 0,0:33:55.93,0:33:59.43,Default,,0,0,0,,《Бұл... ірі компанияның бұрынғы төрағасы
Dialogue: 0,0:33:59.43,0:34:02.44,Default,,0,0,0,,Ол атақты әулеттің қызы болған.
Dialogue: 0,0:34:02.44,0:34:06.61,Default,,0,0,0,,Иә? Бұрынғы қытай? Тіпті сол миллионер!?
Dialogue: 0,0:34:06.61,0:34:11.11,Default,,0,0,0,,Сіз өзіңіздің қандастығыңызға сенімдісіз бе? 》
Dialogue: 0,0:34:11.11,0:34:13.05,Default,,0,0,0,,Уау
Dialogue: 0,0:34:13.05,0:34:17.05,Default,,0,0,0,,Мені тамаша адамдар қорғайды.
Dialogue: 0,0:34:17.05,0:34:19.39,Default,,0,0,0,,Ал, мен бақыттымын!
Dialogue: 0,0:34:19.39,0:34:23.39,Default,,0,0,0,,《Мен оны міндетті түрде түсіріп жатыр деп ойладым.
Dialogue: 0,0:34:23.39,0:34:26.73,Default,,0,0,0,,Отбасы қамқорлығына алғандарға》
Dialogue: 0,0:34:26.73,0:34:29.06,Default,,0,0,0,,＜Бұл күріш кебегінің қуанышы＞
Dialogue: 0,0:34:29.06,0:34:32.57,Default,,0,0,0,,Рикка, өтінемін, қамқоршы рухын болжаңыз!
Dialogue: 0,0:34:32.57,0:34:35.90,Default,,0,0,0,,《Ой, сүйкімді бала.
Dialogue: 0,0:34:35.90,0:34:40.00,Default,,0,0,0,,Мұндай бала үшін бұл ата-әжесі немесе үй жануары болуы мүмкін.
Dialogue: 0,0:34:47.25,0:34:50.59,Default,,0,0,0,,Му. 《Бұл не, балықшы!?》
Dialogue: 0,0:34:50.59,0:34:54.42,Default,,0,0,0,,《Егер жандар бар болса, онда
Dialogue: 0,0:34:54.42,0:34:58.43,Default,,0,0,0,,Менің арқам жау әскерінің арқасы болады.
Dialogue: 0,0:34:58.43,0:35:00.43,Default,,0,0,0,,Кух》
Dialogue: 0,0:35:00.43,0:35:02.43,Default,,0,0,0,,《Ха ха…》
Dialogue: 0,0:35:04.43,0:35:06.93,Default,,0,0,0,,Чинджао Чинжао бел!
Dialogue: 0,0:35:06.93,0:35:09.43,Default,,0,0,0,,Негима! рамен!
Dialogue: 0,0:35:16.94,0:35:19.95,Default,,0,0,0,,Ах~
Dialogue: 0,0:35:19.95,0:35:22.45,Default,,0,0,0,,Мен сенің оны қаншалықты жақсы басқара алатыныңды білгім келеді.
Dialogue: 0,0:35:31.46,0:35:33.46,Default,,0,0,0,,Мәдени фестиваль, иә?
Dialogue: 0,0:35:35.46,0:35:38.13,Default,,0,0,0,,<Жазғы киім бітті>
Dialogue: 0,0:35:38.13,0:35:43.14,Default,,0,0,0,,Мектеп фестивалінде не көргілерің келеді?
Dialogue: 0,0:35:43.14,0:35:46.14,Default,,0,0,0,,Кофехана шығар.
Dialogue: 0,0:35:46.14,0:35:48.48,Default,,0,0,0,,Жарайды, кофехана!
Dialogue: 0,0:35:48.48,0:35:51.98,Default,,0,0,0,,Осындай жағдай бола ма, мен костюм жасадым!
Dialogue: 0,0:35:51.98,0:35:53.98,Default,,0,0,0,,Иә!?
Dialogue: 0,0:35:53.98,0:35:57.49,Default,,0,0,0,,Эххе, қош келдіңіз~
Dialogue: 0,0:35:57.49,0:36:00.49,Default,,0,0,0,,Рикка-чан даяшы.
Dialogue: 0,0:36:00.49,0:36:03.49,Default,,0,0,0,,Тұрақтылықтың сүйкімділігі. Бұл эротикалық емес екені таңқаларлық.
Dialogue: 0,0:36:03.49,0:36:07.50,Default,,0,0,0,,Жаңа пісірілген печенье туралы не айтасыз?
Dialogue: 0,0:36:07.50,0:36:09.83,Default,,0,0,0,,Секине мырзаның елдік стилі бар.
Dialogue: 0,0:36:09.83,0:36:11.93,Default,,0,0,0,,Бұл өте сүйкімді!
Dialogue: 0,0:36:11.93,0:36:13.93,Default,,0,0,0,,Стелла апай
Dialogue: 0,0:36:15.94,0:36:18.77,Default,,0,0,0,,Цубаса-санға арналған Гаркон.
Dialogue: 0,0:36:18.77,0:36:21.11,Default,,0,0,0,,Бұл біртүрлі сәйкес келеді.
Dialogue: 0,0:36:21.11,0:36:23.44,Default,,0,0,0,,Өте құрметті!
Dialogue: 0,0:36:23.44,0:36:25.45,Default,,0,0,0,,Чио не істейді?
Dialogue: 0,0:36:25.45,0:36:28.12,Default,,0,0,0,,Ал, мен...
Dialogue: 0,0:36:28.12,0:36:31.95,Default,,0,0,0,,Қош келдіңіздер, ханымдар.
Dialogue: 0,0:36:31.95,0:36:34.46,Default,,0,0,0,,Керемет! Тым әдемі
Dialogue: 0,0:36:34.46,0:36:36.46,Default,,0,0,0,,Мен жеңілдім...
Dialogue: 0,0:36:36.46,0:36:39.13,Default,,0,0,0,,Егер сізде басқа костюмдер болса
Dialogue: 0,0:36:39.13,0:36:41.80,Default,,0,0,0,,Кез келген уақытта Чиодан сұраңыз.
Dialogue: 0,0:36:41.80,0:36:43.80,Default,,0,0,0,,Содан кейін...
Dialogue: 0,0:36:43.80,0:36:46.63,Default,,0,0,0,,Бірақ бұл Рикка-чанның қызметші киімі шығар.
Dialogue: 0,0:36:46.63,0:36:48.97,Default,,0,0,0,,Пукуно…
Dialogue: 0,0:36:48.97,0:36:52.47,Default,,0,0,0,,Мен қызметші киімін кигім келеді.
Dialogue: 0,0:36:52.47,0:36:54.47,Default,,0,0,0,,<Полковник Рикка: Достыққа басымдық беріңіз>
Dialogue: 0,0:37:07.49,0:37:11.43,Default,,0,0,0,,(ызылдаған)
Dialogue: 0,0:37:11.43,0:37:14.43,Default,,0,0,0,,Чио-сан, сен не тігіп жатырсың?
Dialogue: 0,0:37:14.43,0:37:17.43,Default,,0,0,0,,Бұл Рикка-чанға арналған жаңа костюм.
Dialogue: 0,0:37:17.43,0:37:21.44,Default,,0,0,0,,Мен оны қайтадан жасадым. Чиё да киеді деп үміттенемін.
Dialogue: 0,0:37:21.44,0:37:24.94,Default,,0,0,0,,Жоқ, бірақ мен...
Dialogue: 0,0:37:24.94,0:37:29.44,Default,,0,0,0,,Бұл жай ғана сынақ. А, күте тұрыңыз...
Dialogue: 0,0:37:29.44,0:37:31.45,Default,,0,0,0,,италиялықтарға тән —
Dialogue: 0,0:37:31.45,0:37:33.95,Default,,0,0,0,,А...
Dialogue: 0,0:37:33.95,0:37:38.45,Default,,0,0,0,,Мен... саған қалай ұнайды?
Dialogue: 0,0:37:38.45,0:37:40.96,Default,,0,0,0,,《Дүкеннің адамы осындай》
Dialogue: 0,0:37:40.96,0:37:42.96,Default,,0,0,0,,<Тым түзу>
Dialogue: 0,0:37:42.96,0:37:45.46,Default,,0,0,0,,♬~
Dialogue: 0,0:37:50.13,0:37:54.14,Default,,0,0,0,,Эй... бірдеңе айтшы.
Dialogue: 0,0:37:54.14,0:37:56.97,Default,,0,0,0,,《Дұрыс жауап қандай? Бұл...》
Dialogue: 0,0:37:56.97,0:37:59.47,Default,,0,0,0,,Қайырлы таң~ Иә?
Dialogue: 0,0:38:02.48,0:38:05.48,Default,,0,0,0,,♬~
Dialogue: 0,0:38:05.48,0:38:08.15,Default,,0,0,0,,《Бұзық дүкендегі адам》
Dialogue: 0,0:38:08.15,0:38:10.55,Default,,0,0,0,,<Ортада жылдам доп>
Dialogue: 0,0:38:12.92,0:38:16.92,Default,,0,0,0,,Ум, Чио-сан, бұл...
Dialogue: 0,0:38:16.92,0:38:20.43,Default,,0,0,0,,Мазалағаным үшін кешіріңіз. иә?
Dialogue: 0,0:38:20.43,0:38:23.43,Default,,0,0,0,,Маған сәйкес келмейтінін білсем де.
Dialogue: 0,0:38:23.43,0:38:25.43,Default,,0,0,0,,《Екі адам: Олар бірге жақсы көрінеді.》
Dialogue: 0,0:38:25.43,0:38:27.77,Default,,0,0,0,,Жоқ, Чио-сан, менің айтайын дегенім бұл емес.
Dialogue: 0,0:38:27.77,0:38:30.77,Default,,0,0,0,,Ол ұсынылатын сияқты. Ұсынылды ма?
Dialogue: 0,0:38:30.77,0:38:34.94,Default,,0,0,0,,<Секиннің ашуы шығып, бірдеңені сөйлеп тұр>
Dialogue: 0,0:38:34.94,0:38:37.44,Default,,0,0,0,,Тоқта, Секине, мұны маған қалдыр!
Dialogue: 0,0:38:39.95,0:38:43.12,Default,,0,0,0,,Чио-сан, бірінші сұрайын дегенім
Dialogue: 0,0:38:43.12,0:38:46.45,Default,,0,0,0,,Тіпті бұл адамзаттың ең көне кәсібі деген теория бар.
Dialogue: 0,0:38:46.45,0:38:48.96,Default,,0,0,0,,Ешқашан асыл адам емес, керісінше көп адамдар
Dialogue: 0,0:38:48.96,0:38:50.96,Default,,0,0,0,,Оның сізді бақытты ету мүмкіндігі бар...
Dialogue: 0,0:38:50.96,0:38:52.96,Default,,0,0,0,,<Ұзақ кіріспе>
Dialogue: 0,0:38:52.96,0:38:56.96,Default,,0,0,0,,Уау, Чио-сан! Бұл киімдерге не болды? Ах
Dialogue: 0,0:38:56.96,0:39:00.80,Default,,0,0,0,,Суретті кітаптан шыққан сияқты! Сондай сүйкімді!
Dialogue: 0,0:39:00.80,0:39:03.64,Default,,0,0,0,,Шынымен...?
Dialogue: 0,0:39:03.64,0:39:05.97,Default,,0,0,0,,Рикка Мен өтірік айтпаймын~
Dialogue: 0,0:39:05.97,0:39:07.98,Default,,0,0,0,,《Әрқашан бар》
Dialogue: 0,0:39:07.98,0:39:11.91,Default,,0,0,0,,Ах! 《Хм, қандай керемет сұлулық!
Dialogue: 0,0:39:11.91,0:39:16.42,Default,,0,0,0,,Мен мұны кеше көшеде алып едім... Мына суретті кітаптан тура шыққан сияқты.
Dialogue: 0,0:39:16.42,0:39:18.42,Default,,0,0,0,,<Оны алмаңыз>
Dialogue: 0,0:39:23.42,0:39:27.09,Default,,0,0,0,,Мәдени фестивальдің барлық дерлік жоспарлары бар деп ойлаймын.
Dialogue: 0,0:39:27.09,0:39:30.10,Default,,0,0,0,,Қазіргі уақытта кофехана - ең ықтимал идея.
Dialogue: 0,0:39:30.10,0:39:33.93,Default,,0,0,0,,Мен оны басқа сыныптардан ажыратқым келеді, солай ма?
Dialogue: 0,0:39:33.93,0:39:37.10,Default,,0,0,0,,Сатылымдар іске қосу шығындары үшін пайдаланылады.
Dialogue: 0,0:39:37.10,0:39:39.44,Default,,0,0,0,,Басқа сыныптар не істейді?
Dialogue: 0,0:39:39.44,0:39:44.11,Default,,0,0,0,,Креп, печенье сияқты тәттілер сататын дүкен сияқты.
Dialogue: 0,0:39:44.11,0:39:47.95,Default,,0,0,0,,Сондықтан қандай да бір әдеттен тыс орындау жақсы.
Dialogue: 0,0:39:47.95,0:39:49.95,Default,,0,0,0,,Бұл жақсы болуы мүмкін.
Dialogue: 0,0:39:49.95,0:39:52.45,Default,,0,0,0,,Сосын мен ниндзя сарайын немесе бір нәрсе жасағым келеді.
Dialogue: 0,0:39:52.45,0:39:55.29,Default,,0,0,0,,Сонда ажыратуға болатын сияқты.
Dialogue: 0,0:39:55.29,0:39:57.29,Default,,0,0,0,,Бұл жақсы емес пе? Жарайды, жарайды.
Dialogue: 0,0:39:57.29,0:40:00.13,Default,,0,0,0,,Бұл жеткілікті. Жоқ, бұл...
Dialogue: 0,0:40:00.13,0:40:04.97,Default,,0,0,0,,Ниндзя сарайына қош келдіңіз!
Dialogue: 0,0:40:04.97,0:40:08.47,Default,,0,0,0,,Мен сізге бағыттайтын Нинденгозарунин
Dialogue: 0,0:40:08.47,0:40:11.91,Default,,0,0,0,,《Ондай ниндзя жоқ...
Dialogue: 0,0:40:11.91,0:40:14.91,Default,,0,0,0,,Маған ниндзялардың үйлері мүлдем ұнамайды.
Dialogue: 0,0:40:14.91,0:40:17.91,Default,,0,0,0,,Кейбір элементтерді сақтай отырып, басқа нәрсе》
Dialogue: 0,0:40:17.91,0:40:19.91,Default,,0,0,0,,Ах!
Dialogue: 0,0:40:19.91,0:40:21.92,Default,,0,0,0,,Цубаса-сан! иә?
Dialogue: 0,0:40:21.92,0:40:23.92,Default,,0,0,0,,Жапон стиліндегі кафе туралы не айтасыз?
Dialogue: 0,0:40:23.92,0:40:26.25,Default,,0,0,0,,Жапон стилі... Кафе?
Dialogue: 0,0:40:26.25,0:40:28.59,Default,,0,0,0,,Ошируко мен жапон тәттілерін ұсына отырып, өзіңізді ерекшелей аласыз.
Dialogue: 0,0:40:28.59,0:40:30.59,Default,,0,0,0,,Қош келдіңіз~｡ Мұнда келіңіз.
Dialogue: 0,0:40:30.59,0:40:34.76,Default,,0,0,0,,Менің ойымша, бұл өте керемет!
Dialogue: 0,0:40:34.76,0:40:37.26,Default,,0,0,0,,Кофехана - кофехана, солай ма?
Dialogue: 0,0:40:37.26,0:40:40.10,Default,,0,0,0,,<Чиёның презентациясы оңай қабылданбайды>
Dialogue: 0,0:40:40.10,0:40:44.11,Default,,0,0,0,,Ниндзя сарайларын ұнататын адамдар
Dialogue: 0,0:40:44.11,0:40:48.11,Default,,0,0,0,,Сонымен, біздің сынып не істейді?
Dialogue: 0,0:40:48.11,0:40:50.61,Default,,0,0,0,,<Ниндзя сарайы
Dialogue: 0,0:40:50.61,0:40:53.51,Default,,0,0,0,,Маған көп жағынан ұнамайды>
Dialogue: 0,0:40:57.45,0:41:01.62,Default,,0,0,0,,Негізі мен ниндзяларды қатты жақсы көремін. Аа!?
Dialogue: 0,0:41:01.62,0:41:05.79,Default,,0,0,0,,Мен кішкентай кезімде ниндзя болғым келді.
Dialogue: 0,0:41:05.79,0:41:08.46,Default,,0,0,0,,Әйтеуір, ниндзялар керемет.
Dialogue: 0,0:41:08.46,0:41:13.07,Default,,0,0,0,,Менде әлі де оған деген сағыныш бар...
Dialogue: 0,0:41:13.07,0:41:15.07,Default,,0,0,0,,《Ал... осынша айтсаң.
Dialogue: 0,0:41:15.07,0:41:17.07,Default,,0,0,0,,Тіпті ниндзя сарайында...》
Dialogue: 0,0:41:17.07,0:41:20.07,Default,,0,0,0,,Сондықтан оның ниндзя ретіндегі шеберлігі жоғары деп ойлаймын.
Dialogue: 0,0:41:20.07,0:41:22.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:41:24.08,0:41:26.08,Default,,0,0,0,,Қабыл ал!
Dialogue: 0,0:41:26.08,0:41:28.42,Default,,0,0,0,,Сіз шурикенмен жақсы емессіз бе?
Dialogue: 0,0:41:28.42,0:41:30.92,Default,,0,0,0,,Иә
Dialogue: 0,0:41:30.92,0:41:33.42,Default,,0,0,0,,Инд өзені дельта аймағында орналасқан—
Dialogue: 0,0:41:33.42,0:41:37.93,Default,,0,0,0,,Чио-сан, бұл керемет. Ал кері лақтыру?
Dialogue: 0,0:41:37.93,0:41:40.93,Default,,0,0,0,,Жоқ, егер сіз өзіңізді ниндзя деп атасаңыз...
Dialogue: 0,0:41:40.93,0:41:45.43,Default,,0,0,0,,Менің ең болмағанда осыншама қолымнан келгенімді қалайсыз ба? Ұнайды
Dialogue: 0,0:41:45.43,0:41:47.43,Default,,0,0,0,,<Толған кәсібилік>
Dialogue: 0,0:41:47.43,0:41:50.94,Default,,0,0,0,,Сіз көп жаттықтыңыз, солай ма? Тамаша!
Dialogue: 0,0:41:50.94,0:41:55.61,Default,,0,0,0,,А, жоқ, бұл... ханымның дәмі.
Dialogue: 0,0:41:55.61,0:41:57.61,Default,,0,0,0,,<Хан деген не?>
Dialogue: 0,0:41:57.61,0:42:01.95,Default,,0,0,0,,《Мен алмаймын, мен тітіркенгенім сонша, мен жай ғана...
Dialogue: 0,0:42:01.95,0:42:04.95,Default,,0,0,0,,Мен ниндзя болудан осы уақытқа дейін бас тартуым керек еді.
Dialogue: 0,0:42:04.95,0:42:11.39,Default,,0,0,0,,Қалған өмірімді қарапайым қыз болып өткіземін, шурикендер...
Dialogue: 0,0:42:11.39,0:42:15.90,Default,,0,0,0,,Тәтті, мен бұл өте жақсы деп ойладым~
Dialogue: 0,0:42:15.90,0:42:17.90,Default,,0,0,0,,Уф...｡ Цубаса
Dialogue: 0,0:42:17.90,0:42:20.40,Default,,0,0,0,,Оны сол жерде қалдырған дұрыс.
Dialogue: 0,0:42:20.40,0:42:23.90,Default,,0,0,0,,Ой! Күніне 1000 отжимания жасаңыз
Dialogue: 0,0:42:23.90,0:42:26.91,Default,,0,0,0,,Сіз Чио-санға қарағанда шурикенде жақсырақ боласыз!
Dialogue: 0,0:42:26.91,0:42:29.08,Default,,0,0,0,,Ууууууу…
Dialogue: 0,0:42:29.08,0:42:32.08,Default,,0,0,0,,《Ан!?》
Dialogue: 0,0:42:35.42,0:42:37.59,Default,,0,0,0,,《Цубаса: Расында...》
Dialogue: 0,0:42:37.59,0:42:39.59,Default,,0,0,0,,156
Dialogue: 0,0:42:39.59,0:42:43.42,Default,,0,0,0,,Осу. Ку... у...
Dialogue: 0,0:42:43.42,0:42:48.10,Default,,0,0,0,,《Расында, мен 1000 отжиман жасаймын дедім》
Dialogue: 0,0:42:48.10,0:42:50.10,Default,,0,0,0,,Сәттілік~
Dialogue: 0,0:42:50.10,0:42:52.43,Default,,0,0,0,,157｡ Оссу
Dialogue: 0,0:42:52.43,0:42:57.10,Default,,0,0,0,,《Бірақ бұл оның сонша күші бар дегенді білдірмейді.''
Dialogue: 0,0:42:57.10,0:42:59.77,Default,,0,0,0,,Менің мұны істеу ниетім жоқ...》
Dialogue: 0,0:42:59.77,0:43:01.97,Default,,0,0,0,,158
Dialogue: 0,0:43:04.45,0:43:08.45,Default,,0,0,0,,О? Жауабыңызды естімей тұрмын ба?
Dialogue: 0,0:43:08.45,0:43:10.45,Default,,0,0,0,,О... Осу!
Dialogue: 0,0:43:10.45,0:43:13.72,Default,,0,0,0,,Кук кук…
Dialogue: 0,0:43:13.72,0:43:16.72,Default,,0,0,0,,О! Ороролороро...
Dialogue: 0,0:43:16.72,0:43:19.56,Default,,0,0,0,,Grrrrrrrrrr.
Dialogue: 0,0:43:19.56,0:43:22.90,Default,,0,0,0,,Мен... Кешіріңіз, енді қолымнан келмейді.
Dialogue: 0,0:43:22.90,0:43:24.90,Default,,0,0,0,,<Ардақты тіл енді жоқ>
Dialogue: 0,0:43:24.90,0:43:29.40,Default,,0,0,0,,Ал, Рикка-чан, Цубаса-сан...
Dialogue: 0,0:43:29.40,0:43:31.57,Default,,0,0,0,,《Маған су бере аласыз ба?》
Dialogue: 0,0:43:31.57,0:43:33.57,Default,,0,0,0,,Маған көлік беріңіз
Dialogue: 0,0:43:33.57,0:43:37.41,Default,,0,0,0,,Иә! О...
Dialogue: 0,0:43:37.41,0:43:40.08,Default,,0,0,0,,О, о...
Dialogue: 0,0:43:40.08,0:43:42.92,Default,,0,0,0,,Нағыз іс құсқаннан кейін басталады, солай ма?
Dialogue: 0,0:43:42.92,0:43:44.92,Default,,0,0,0,,《Жын? 》
Dialogue: 0,0:43:44.92,0:43:47.42,Default,,0,0,0,,Бірақ Рикканың мінгені жақсы емес.
Dialogue: 0,0:43:47.42,0:43:49.92,Default,,0,0,0,,《Рахмет Рикка! Өтінемін, төмен түсіңіз.
Dialogue: 0,0:43:49.92,0:43:52.59,Default,,0,0,0,,Өйткені ол тым жеңіл. иә?
Dialogue: 0,0:43:52.59,0:43:55.43,Default,,0,0,0,,Секине-чанның мінгені жақсы.
Dialogue: 0,0:43:55.43,0:43:57.43,Default,,0,0,0,,Ғафу!
Dialogue: 0,0:43:57.43,0:43:59.43,Default,,0,0,0,,<Секине түсінді.
Dialogue: 0,0:43:59.43,0:44:04.44,Default,,0,0,0,,Бұл полковниктің жақсы ниетпен айтқан ұсынысы...яғни оның шынайы ниеті.＞
Dialogue: 0,0:44:04.44,0:44:06.94,Default,,0,0,0,,Гуг… Гуггу…
Dialogue: 0,0:44:06.94,0:44:10.61,Default,,0,0,0,,Ауыр ма? Цубаса…｡ О…
Dialogue: 0,0:44:10.61,0:44:12.55,Default,,0,0,0,,Сәттілік~
Dialogue: 0,0:44:12.55,0:44:17.05,Default,,0,0,0,,Мен мұның ауыр екеніне сенбеймін, Цубаса-сан?
Dialogue: 0,0:44:17.05,0:44:19.39,Default,,0,0,0,,Бұл мүлдем ауыр емес!
Dialogue: 0,0:44:19.39,0:44:21.56,Default,,0,0,0,,<Қос ықылас>
Dialogue: 0,0:44:21.56,0:44:27.06,Default,,0,0,0,,Өкінішке орай, бұлшық еттері ауырғандықтан Цубаса келе алмады.
Dialogue: 0,0:44:27.06,0:44:29.06,Default,,0,0,0,,Эх!
Dialogue: 0,0:44:29.06,0:44:31.07,Default,,0,0,0,,Мен күткен едім.
Dialogue: 0,0:44:31.07,0:44:34.40,Default,,0,0,0,,Ахахаха хахаха...
Dialogue: 0,0:44:34.40,0:44:37.91,Default,,0,0,0,,Сондықтан біз тұтынушыларға қызмет көрсету персоналын ауыстырамыз...
Dialogue: 0,0:44:37.91,0:44:41.91,Default,,0,0,0,,Жасай берші... Мен аламын.
Dialogue: 0,0:44:44.91,0:44:46.91,Default,,0,0,0,,Уау!
Dialogue: 0,0:44:46.91,0:44:50.92,Default,,0,0,0,,2-В ниндзя сарайы ма?
Dialogue: 0,0:44:50.92,0:44:53.75,Default,,0,0,0,,А, ағылшын тілі мұғалімі Брайан!
Dialogue: 0,0:44:53.75,0:44:57.45,Default,,0,0,0,,Ниндзя сарайына қош келдіңіз!
Dialogue: 0,0:45:00.93,0:45:02.93,Default,,0,0,0,,Хмм
Dialogue: 0,0:45:08.94,0:45:12.77,Default,,0,0,0,,《Жарайсың, бірақ бәрібір мәдениет мерекесі.
Dialogue: 0,0:45:12.77,0:45:16.44,Default,,0,0,0,,Мен шәкіртім үшін келдім, сондықтан қуанышымды асырып жіберейін.
Dialogue: 0,0:45:16.44,0:45:18.45,Default,,0,0,0,,Мұғалім Брайан!
Dialogue: 0,0:45:18.45,0:45:21.12,Default,,0,0,0,,Мен сені Нинденгозарунинге апарамын!
Dialogue: 0,0:45:21.12,0:45:23.45,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:45:23.45,0:45:26.12,Default,,0,0,0,,Не болып жатыр!?
Dialogue: 0,0:45:26.12,0:45:28.12,Default,,0,0,0,,Ура! О!
Dialogue: 0,0:45:28.12,0:45:30.12,Default,,0,0,0,,Иә! Апыр-ай!
Dialogue: 0,0:45:30.12,0:45:32.13,Default,,0,0,0,,Иә! О, құдайым!
Dialogue: 0,0:45:32.13,0:45:34.13,Default,,0,0,0,,Соо! Әзіл емес!
Dialogue: 0,0:45:34.13,0:45:37.46,Default,,0,0,0,,Керемет! Жапон ниндзясы!
Dialogue: 0,0:45:37.46,0:45:40.96,Default,,0,0,0,,Керемет! Керемет!
Dialogue: 0,0:45:43.14,0:45:49.98,Default,,0,0,0,,Мен мұны істедім. Бірақ... жоғалтқан достығым қайтып келмейді.
Dialogue: 0,0:45:49.98,0:45:52.65,Default,,0,0,0,,Менің ойымша, сіз барып кешірім сұрауыңыз керек.
Dialogue: 0,0:45:52.65,0:45:55.48,Default,,0,0,0,,Бірақ мені кешіре аласың ба...
Dialogue: 0,0:45:55.48,0:46:00.49,Default,,0,0,0,,А, онда мен саған Цубасаның сүйікті асын әкелемін.
Dialogue: 0,0:46:00.49,0:46:03.99,Default,,0,0,0,,Бұл Цубасаның сүйікті тағамы ма?
Dialogue: 0,0:46:03.99,0:46:10.00,Default,,0,0,0,,Мен шынымен... шынымен кешірім сұраймын.
Dialogue: 0,0:46:10.00,0:46:13.43,Default,,0,0,0,,Жоқ...жақсы. Сәжде жасауды тоқтату керек пе?
Dialogue: 0,0:46:13.43,0:46:15.44,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:46:15.44,0:46:19.61,Default,,0,0,0,,Мен Чийоның әдеттегі Чиё-сан болғанын қалаймын.
Dialogue: 0,0:46:19.61,0:46:21.61,Default,,0,0,0,,Цубаса-сан
Dialogue: 0,0:46:21.61,0:46:26.61,Default,,0,0,0,,Мен ниндзя ретінде косплей ойнап көргім келді... Ахаха
Dialogue: 0,0:46:26.61,0:46:30.12,Default,,0,0,0,,Мен ниндзя құралдарының жиынтығын әкелдім.
Dialogue: 0,0:46:30.12,0:46:32.95,Default,,0,0,0,,Бұл кем дегенде кешірім сұрау. иә?
Dialogue: 0,0:46:32.95,0:46:36.96,Default,,0,0,0,,Мен саған мынаны беремін. Бұл жақсы ма? Уау...
Dialogue: 0,0:46:36.96,0:46:40.13,Default,,0,0,0,,Керемет, рахмет!
Dialogue: 0,0:46:40.13,0:46:42.46,Default,,0,0,0,,Қайтар қанның тот сезімі соншалықты шынайы.
Dialogue: 0,0:46:42.46,0:46:44.47,Default,,0,0,0,,Мұндағы сызаттар мен төгілген пышақ...
Dialogue: 0,0:46:44.47,0:46:46.47,Default,,0,0,0,,<Жуғаннан кейін де шықпады>
Dialogue: 0,0:46:52.47,0:46:54.48,Default,,0,0,0,,Ол жоғары бағаға сатылды. Мен үшін не істеп жатырсың?
Dialogue: 0,0:46:54.48,0:46:56.48,Default,,0,0,0,,Бұл сыйлық!?
Dialogue: 0,0:50:13.44,0:50:15.94,Default,,0,0,0,,Рикка, менің қарным ашты.
Dialogue: 0,0:50:15.94,0:50:19.61,Default,,0,0,0,,Мұнда тек такояки жеуге болмайды ма?
Dialogue: 0,0:50:19.61,0:50:23.45,Default,,0,0,0,,Мұндағы дәм жақсы емес, бірақ жарайды.
Dialogue: 0,0:50:23.45,0:50:25.45,Default,,0,0,0,,Қош келдіңіз!
Dialogue: 0,0:50:25.45,0:50:28.12,Default,,0,0,0,,Кішкентай қыз сүйкімді~
Dialogue: 0,0:50:28.12,0:50:30.46,Default,,0,0,0,,Иә, 1 қосымша элемент
Dialogue: 0,0:50:30.46,0:50:32.96,Default,,0,0,0,,Уау, рахмет
Dialogue: 0,0:50:32.96,0:50:35.46,Default,,0,0,0,,О, кәдімгі сұлулық!
Dialogue: 0,0:50:35.46,0:50:37.46,Default,,0,0,0,,Міне бонус!
Dialogue: 0,0:50:37.46,0:50:39.97,Default,,0,0,0,,Рахмет
Dialogue: 0,0:50:39.97,0:50:42.47,Default,,0,0,0,,О, сұлу қыз
Dialogue: 0,0:50:42.47,0:50:44.97,Default,,0,0,0,,Иә, бонус!
Dialogue: 0,0:50:44.97,0:50:46.97,Default,,0,0,0,,Хаха, солай!
Dialogue: 0,0:50:46.97,0:50:48.98,Default,,0,0,0,,<Бұл күрделі қанат>
Dialogue: 0,0:50:48.98,0:50:52.15,Default,,0,0,0,,Иә! Гид бар!
Dialogue: 0,0:50:52.15,0:50:55.48,Default,,0,0,0,,Ах! Ах!
Dialogue: 0,0:50:55.48,0:50:57.48,Default,,0,0,0,,Ах!
Dialogue: 0,0:50:57.48,0:50:59.49,Default,,0,0,0,,(Қарғаның айқайы)
Dialogue: 0,0:50:59.49,0:51:01.49,Default,,0,0,0,,<Секине бонуссыз>
Dialogue: 0,0:52:47.46,0:52:51.63,Default,,0,0,0,,《Егер мен сатып алуды немесе жеуді ұсынбасам...》
Dialogue: 0,0:52:51.63,0:52:54.80,Default,,0,0,0,,《Ең болмағанда бонуссыз менде болмас еді...》
Dialogue: 0,0:52:54.80,0:52:59.64,Default,,0,0,0,,《Секине: Қойшы... Адамдардың маған назар аударуы одан да аянышты.''
Dialogue: 0,0:52:59.64,0:53:02.14,Default,,0,0,0,,Бұл... Мен осындамын.
Dialogue: 0,0:53:02.14,0:53:05.48,Default,,0,0,0,,Маған бәрібір. Маған шағымдану керек.
Dialogue: 0,0:53:05.48,0:53:08.98,Default,,0,0,0,,А, бонусты қараңыз!
Dialogue: 0,0:53:08.98,0:53:12.09,Default,,0,0,0,,Қараңдар~ Такояки!
Dialogue: 0,0:53:12.09,0:53:14.75,Default,,0,0,0,,Уф...
Dialogue: 0,0:53:14.75,0:53:19.43,Default,,0,0,0,,Ууууууууу~
Dialogue: 0,0:53:19.43,0:53:23.76,Default,,0,0,0,,Нфффффффф…
Dialogue: 0,0:53:23.76,0:53:29.10,Default,,0,0,0,,Секине мырза! Негізі мен ол дүкенде тұрақты адаммын.
Dialogue: 0,0:53:29.10,0:53:33.11,Default,,0,0,0,,Менің ойымша, ол маған бонус берді.
Dialogue: 0,0:53:33.11,0:53:36.11,Default,,0,0,0,,Сондықтан бұл туралы мүлдем уайымдамаңыз.
Dialogue: 0,0:53:36.11,0:53:39.61,Default,,0,0,0,,Біріншіден, ол мейрамхананың дәмі жақсы емес.
Dialogue: 0,0:53:39.61,0:53:43.95,Default,,0,0,0,,Мен өз талғамыма сенімді емеспін, сондықтан мен тұтынушыларды қосымша заттармен тартуға тырысамын.
Dialogue: 0,0:53:43.95,0:53:48.46,Default,,0,0,0,,Дұрыс. Бұл жақсы болмаса да, маған қосымша қажет емес.
Dialogue: 0,0:53:48.46,0:53:50.96,Default,,0,0,0,,<Әркім соңынан ереді>
Dialogue: 0,0:53:50.96,0:53:54.46,Default,,0,0,0,,《Қарғыс атсын! Барлығы…》
Dialogue: 0,0:53:54.46,0:53:57.06,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:54:01.97,0:54:07.64,Default,,0,0,0,,Бұл менің жеке куәлігім, сондықтан қаласаңыз, маған хабарласыңыз.
Dialogue: 0,0:54:07.64,0:54:09.64,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:54:09.64,0:54:12.58,Default,,0,0,0,,Мен де сізге алғыс айтқым келеді. Эх...
Dialogue: 0,0:54:12.58,0:54:15.48,Default,,0,0,0,,Қош бол. Жуықта көріскенше. Мен күтетін боламын!
Dialogue: 0,0:54:18.92,0:54:23.26,Default,,0,0,0,,《Сол әуесқойларды 3 минутта өлтірейік》
Dialogue: 0,0:54:23.26,0:54:25.93,Default,,0,0,0,,《Жақсы》
Dialogue: 0,0:54:25.93,0:54:33.43,Default,,0,0,0,,Әй, у... өмір... өмір қымбат.
Dialogue: 0,0:54:33.43,0:54:36.03,Default,,0,0,0,,Өмір!
Dialogue: 0,0:54:38.10,0:54:40.11,Default,,0,0,0,,Ах
Dialogue: 0,0:54:40.11,0:54:42.51,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:54:44.44,0:54:50.95,Default,,0,0,0,,Өмір – гүл, ай, жел
Dialogue: 0,0:54:50.95,0:54:54.79,Default,,0,0,0,,Ал менің досым~
Dialogue: 0,0:54:54.79,0:54:56.79,Default,,0,0,0,,Дамоно~
Dialogue: 0,0:54:56.79,0:54:59.96,Default,,0,0,0,,《Ал... дұрыс.
Dialogue: 0,0:54:59.96,0:55:03.80,Default,,0,0,0,,Өмір қымбат. Бұл қауіпті жағдай болды.
Dialogue: 0,0:55:03.80,0:55:09.14,Default,,0,0,0,,Жоқ, бірақ анау қарттың көзі көрмейді.
Dialogue: 0,0:55:09.14,0:55:13.57,Default,,0,0,0,,Солардың ішінде болашақта ең танымалы Секине болатын сияқты.
Dialogue: 0,0:55:13.57,0:55:15.91,Default,,0,0,0,,Иә? Ух... иә!
Dialogue: 0,0:55:15.91,0:55:18.58,Default,,0,0,0,,Иә, дұрыс! Қазір танымал болғаннан гөрі
Dialogue: 0,0:55:18.58,0:55:21.41,Default,,0,0,0,,Болашақта танымал болған дұрыс.
Dialogue: 0,0:55:21.41,0:55:24.08,Default,,0,0,0,,Студенттер жай ғана өту нүктесі.
Dialogue: 0,0:55:24.08,0:55:27.42,Default,,0,0,0,,Біз 100 жаста өмір сүріп жатырмыз! Әрине!
Dialogue: 0,0:55:27.42,0:55:31.42,Default,,0,0,0,,Бүгінгі күннен болашақ маңызды! Барлығы...
Dialogue: 0,0:55:31.42,0:55:35.43,Default,,0,0,0,,Өйткені, Секиненің кеудесі үлкен!
Dialogue: 0,0:55:35.43,0:55:37.60,Default,,0,0,0,,Бұл сыныптағы ең үлкені емес пе?
Dialogue: 0,0:55:37.60,0:55:40.43,Default,,0,0,0,,《Чиё: Мен сені мақтап жатыр деп ойламадым...》
Dialogue: 0,0:55:40.43,0:55:44.77,Default,,0,0,0,,Кеудең болғанша, сәл қалың болса да, танымал боласың.
Dialogue: 0,0:55:44.77,0:55:48.27,Default,,0,0,0,,Ағатай, мен оның жүзін ғана көрдім.
Dialogue: 0,0:55:48.27,0:55:50.94,Default,,0,0,0,,Тоқта...｡ Тоқтатыңыз.
Dialogue: 0,0:55:50.94,0:55:55.12,Default,,0,0,0,,Жарайды! Егер сіз топтық кездесуде немесе бірдеңеде болсаңыз, бәрібір сіздің кеудеңізге ғана қарайды.
Dialogue: 0,0:55:55.12,0:55:59.95,Default,,0,0,0,,Бәрібір менің кеудеме ғана қарайды. Олар тек кеудеме қарайды.
Dialogue: 0,0:55:59.95,0:56:04.46,Default,,0,0,0,,Ендеше, Цубаса, мына кеуде мен анау жүзді айырбастағың келе ме?
Dialogue: 0,0:56:04.46,0:56:06.46,Default,,0,0,0,,Иә!? Жоқ, бұл...
Dialogue: 0,0:56:06.46,0:56:11.13,Default,,0,0,0,,《Бұл не деген атмосфера... Мен өз жолымда сақ болдым.
Dialogue: 0,0:56:11.13,0:56:13.40,Default,,0,0,0,,Неліктен бәрі артқа шегінеді? 》
Dialogue: 0,0:56:13.40,0:56:15.57,Default,,0,0,0,,<Орта мектептің 2 курс оқушысының ең жақсы талпынысы>
Dialogue: 0,0:56:15.57,0:56:18.07,Default,,0,0,0,,Алдау
Dialogue: 0,0:56:18.07,0:56:23.41,Default,,0,0,0,,《Кенет жапон стилі? Сіз не ішкіңіз келеді? 》
Dialogue: 0,0:56:23.41,0:56:26.71,Default,,0,0,0,,А, а, а...
Dialogue: 0,0:56:29.92,0:56:34.42,Default,,0,0,0,,Рикка Менің қарным ашты.
Dialogue: 0,0:56:34.42,0:56:37.59,Default,,0,0,0,,Мұнда тек такояки жеуге болмайды ма?
Dialogue: 0,0:56:37.59,0:56:41.43,Default,,0,0,0,,Мұндағы дәм жақсы емес, бірақ жарайды.
Dialogue: 0,0:56:41.43,0:56:44.93,Default,,0,0,0,,Ах
Dialogue: 0,0:56:44.93,0:56:48.44,Default,,0,0,0,,《Уақыт кері кетті ме? 》
Dialogue: 0,0:56:48.44,0:56:50.94,Default,,0,0,0,,《Жарайды, кеңістік-уақыт телепортациясы сәтті болған сияқты》
Dialogue: 0,0:56:50.94,0:56:53.11,Default,,0,0,0,,《Сен мұны істей алмайсың!?》
Dialogue: 0,0:56:53.11,0:56:55.94,Default,,0,0,0,,《Мисс Секиненің абыройын қайтару》
Dialogue: 0,0:56:55.94,0:56:57.94,Default,,0,0,0,,《Мен үшін...》
Dialogue: 0,0:56:57.94,0:57:02.94,Default,,0,0,0,,《Осы арқылы сіз оятуға ұқсас атмосферадан аулақ бола аласыз》
Dialogue: 0,0:57:04.95,0:57:07.95,Default,,0,0,0,,Секине-чан, бір сәтке кете аласыз ба?
Dialogue: 0,0:57:07.95,0:57:09.96,Default,,0,0,0,,Иә
Dialogue: 0,0:57:09.96,0:57:11.89,Default,,0,0,0,,《Не? Не? 》
Dialogue: 0,0:57:11.89,0:57:13.89,Default,,0,0,0,,《Рикка: мм. Қалғаны...
Dialogue: 0,0:57:13.89,0:57:17.90,Default,,0,0,0,,Мисс Секиннен басқа барлық адамдарды ғарыш шошқаларына айналдырыңыз.
Dialogue: 0,0:57:17.90,0:57:21.40,Default,,0,0,0,,<Бүкіл адамзатты ғарыш шошқаларына айналдыру жоспары>
Dialogue: 0,0:57:21.40,0:57:27.74,Default,,0,0,0,,Секине бикешті адамзаттың ең сұлу әйеліне айналдырайық.
Dialogue: 0,0:57:27.74,0:57:32.08,Default,,0,0,0,,Бұл жоғарылау болуы мүмкін, бірақ 1-орын - 1-орын!
Dialogue: 0,0:57:32.08,0:57:35.75,Default,,0,0,0,,Бухи бухи сәлем! Бу-хи-бу-хи-бу!
Dialogue: 0,0:57:35.75,0:57:37.75,Default,,0,0,0,,Уххххххх
Dialogue: 0,0:57:37.75,0:57:40.25,Default,,0,0,0,,Bi buhihibuhibuboo?
Dialogue: 0,0:57:40.25,0:57:42.76,Default,,0,0,0,,Ерекше ештеңе жоқ
Dialogue: 0,0:57:42.76,0:57:45.43,Default,,0,0,0,,《Мен оны тоқтатуым керек》
Dialogue: 0,0:57:45.43,0:57:47.76,Default,,0,0,0,,<Бір сәтке қарастырылады>
Dialogue: 0,0:57:47.76,0:57:49.76,Default,,0,0,0,,Таа~!
Dialogue: 0,0:58:00.44,0:58:04.11,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:58:04.11,0:58:06.11,Default,,0,0,0,,Бухи
Dialogue: 0,0:58:06.11,0:58:09.78,Default,,0,0,0,,Иә!? (2 адам) Бухи Бухи
Dialogue: 0,0:58:09.78,0:58:17.39,Default,,0,0,0,,《Мисс Секинеден басқа барлық адамдарды ғарыш шошқаларына айналдыру жоспары сәтті болды》
Dialogue: 0,0:58:17.39,0:58:19.39,Default,,0,0,0,,Боу
Dialogue: 0,0:58:19.39,0:58:22.40,Default,,0,0,0,,Бухи! Бухибухи бухи!
Dialogue: 0,0:58:22.40,0:58:27.73,Default,,0,0,0,,Бу хи хи бухи бу буу…
Dialogue: 0,0:58:27.73,0:58:31.03,Default,,0,0,0,,<Адамзат Секиненің жеңілісі>
Dialogue: 0,0:58:33.07,0:58:36.74,Default,,0,0,0,,Ал егер... сонда!
Dialogue: 0,0:58:36.74,0:58:39.41,Default,,0,0,0,,Барлық адамдар ғарыш бақаларына айналды!
Dialogue: 0,0:58:39.41,0:58:41.41,Default,,0,0,0,,Geko Geko…
Dialogue: 0,0:58:41.41,0:58:43.42,Default,,0,0,0,,<Тағы бір жеңіліс>
Dialogue: 0,0:58:43.42,0:58:45.92,Default,,0,0,0,,Барлық адамдар минералданған!
Dialogue: 0,0:58:51.42,0:58:54.43,Default,,0,0,0,,< Ах~ Секине! ＞
Dialogue: 0,0:58:54.43,0:58:57.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:58:57.43,0:58:59.60,Default,,0,0,0,,(Iris) Ол жұмысы барын айтып, бүгін таңертең кетті.
Dialogue: 0,0:58:59.60,0:59:02.44,Default,,0,0,0,,《Ойлап қарасаң, шошқа – шошқа.
Dialogue: 0,0:59:02.44,0:59:05.44,Default,,0,0,0,,Бақалар бір-бірін ұнатады деп шешілді.
Dialogue: 0,0:59:05.44,0:59:08.44,Default,,0,0,0,,＜Мен мұны жасамас бұрын байқағанымды қалаймын＞
Dialogue: 0,0:59:08.44,0:59:12.88,Default,,0,0,0,,О? Қазір не істеп жатырмыз...
Dialogue: 0,0:59:12.88,0:59:16.72,Default,,0,0,0,,Эх, мен такояки сатып алайын деп жатыр едім.
Dialogue: 0,0:59:16.72,0:59:21.05,Default,,0,0,0,,《Сіз жадыңызды толығымен өшірдіңіз бе? Полковниктің миын жууы жиіркенішті》
Dialogue: 0,0:59:21.05,0:59:24.89,Default,,0,0,0,,《Келесі, келесі стратегия》
Dialogue: 0,0:59:24.89,0:59:26.89,Default,,0,0,0,,《Жетті! 》
Dialogue: 0,0:59:26.89,0:59:28.90,Default,,0,0,0,,А, бұл кенеттен...
Dialogue: 0,0:59:28.90,0:59:33.90,Default,,0,0,0,,Өйткені, менің ойымша, адам үшін оның ішіндегісі маңызды.
Dialogue: 0,0:59:35.90,0:59:38.91,Default,,0,0,0,,Осы нүктеге жеткенде сергітетіндей болады.
Dialogue: 0,0:59:38.91,0:59:42.74,Default,,0,0,0,,Керісінше, ашуымды келтіреді... Қандай көрінсе де...
Dialogue: 0,0:59:42.74,0:59:45.75,Default,,0,0,0,,Менің өз бетімше өмір сүруден басқа амалым жоқ.
Dialogue: 0,0:59:45.75,0:59:51.42,Default,,0,0,0,,Секине-чан, дұрыс айтасың! Секине-чан бұл Секине-чан!
Dialogue: 0,0:59:51.42,0:59:55.42,Default,,0,0,0,,Кенеттен не болды? Сіздің сыртқы келбетіңіз не болды?
Dialogue: 0,0:59:55.42,0:59:58.76,Default,,0,0,0,,Біріншіден, Жер тұрғындары қарапайым құрылымға ие!
Dialogue: 0,0:59:58.76,1:00:00.76,Default,,0,0,0,,Бұл өте күрделі емес пе?
Dialogue: 0,1:00:00.76,1:00:03.76,Default,,0,0,0,,О, о, анау... достық! Бұл достық!
Dialogue: 0,1:00:03.76,1:00:05.77,Default,,0,0,0,,Уууу. (Чиё) Иә.
Dialogue: 0,1:00:05.77,1:00:07.93,Default,,0,0,0,,Біздің достығымыз сол қалпында қалады.
Dialogue: 0,1:00:07.93,1:00:09.93,Default,,0,0,0,,Сіз не туралы айтып отырсыз? иә?
Dialogue: 0,1:00:16.44,1:00:19.78,Default,,0,0,0,,Ах~｡ Жақсысың ба?
Dialogue: 0,1:00:19.78,1:00:22.98,Default,,0,0,0,,(Iris) Ол жұмысы барын айтып, бүгін таңертең кетті.
Dialogue: 0,1:00:24.95,1:00:28.95,Default,,0,0,0,,Шынымды айтсам, мен бүгін твиттер жазбадым.
Dialogue: 0,1:00:31.96,1:00:36.13,Default,,0,0,0,,Секине-чан! Секине мырза! Секине...
Dialogue: 0,1:00:36.13,1:00:39.47,Default,,0,0,0,,Мен өмір бойы лай суда қалсам ше?
Dialogue: 0,1:00:39.47,1:00:41.47,Default,,0,0,0,,《Неге!?》
Dialogue: 0,1:00:41.47,1:00:43.47,Default,,0,0,0,,<Гудвилл тіке құқығы>
Dialogue: 0,1:00:43.47,1:00:45.47,Default,,0,0,0,,Уа... ау, ау
Dialogue: 0,1:00:47.47,1:00:50.48,Default,,0,0,0,,Жүр, келесі жолы такояки ішіп, үйге қайтайық!
Dialogue: 0,1:00:50.48,1:00:53.48,Default,,0,0,0,,Содан~｡ Содан~
Dialogue: 0,1:00:53.48,1:00:55.82,Default,,0,0,0,,Мұны істейік
Dialogue: 0,1:00:55.82,1:01:00.99,Default,,0,0,0,,《Бірақ біз Секине Мисс сияқты басқа құрбанның шығуына жол бере алмаймыз.''
Dialogue: 0,1:01:00.99,1:01:03.49,Default,,0,0,0,,Иә! Одан да жақсы такояки жасаңыз
Dialogue: 0,1:01:03.49,1:01:07.99,Default,,0,0,0,,Бонус ретінде тұтынушыларды іздеудің қажеті жоқ.》
Dialogue: 0,1:01:11.60,1:01:14.43,Default,,0,0,0,,Ой уау уау уау уау!
Dialogue: 0,1:01:14.43,1:01:17.60,Default,,0,0,0,,《Әлемдегі ең жақсы материал ретінде қарастырылады.
Dialogue: 0,1:01:17.60,1:01:20.94,Default,,0,0,0,,Мен сені ғарыштық сегізаяққа айналдырдым. Шүкір етіңіз.
Dialogue: 0,1:01:20.94,1:01:22.94,Default,,0,0,0,,Боу
Dialogue: 0,1:01:22.94,1:01:26.11,Default,,0,0,0,,Бұл... Мен мұндай дәмді көрінетін сегізаяқты ешқашан көрген емеспін.
Dialogue: 0,1:01:26.11,1:01:28.78,Default,,0,0,0,,Boo Boo…｡ Мүмкін, біз онымен талғам бойынша бәсекелесе аламыз.
Dialogue: 0,1:01:28.78,1:01:33.62,Default,,0,0,0,,Бес төрт үш екі бір... Ууууууууууууууу!
Dialogue: 0,1:01:33.62,1:01:35.62,Default,,0,0,0,,Не істейміз, Итерер?
Dialogue: 0,1:01:35.62,1:01:37.62,Default,,0,0,0,,♬~
Dialogue: 0,1:01:37.62,1:01:41.46,Default,,0,0,0,,<Ғарыштық сегізаяқ өзінің мекенге бару инстинкті арқасында ғарышқа оралды.
Dialogue: 0,1:01:41.46,1:01:43.46,Default,,0,0,0,,Содан кейін сол жерде
Dialogue: 0,1:01:43.46,1:01:45.46,Default,,0,0,0,,Такояки дүңгіршесін ешкім көрмеген＞
Dialogue: 0,1:01:52.47,1:01:54.47,Default,,0,0,0,,Гей. иә?
Dialogue: 0,1:01:54.47,1:01:57.48,Default,,0,0,0,,Цубаса-чанның неше сырғасы бар?
Dialogue: 0,1:01:57.48,1:02:00.48,Default,,0,0,0,,Барлығы 9 болуы мүмкін. Апыр-ай!
Dialogue: 0,1:02:00.48,1:02:04.15,Default,,0,0,0,,Жарайсың, көзіңді аштың. Саған жарасады.
Dialogue: 0,1:02:04.15,1:02:06.32,Default,,0,0,0,,Рахмет. Мен түсінемін.
Dialogue: 0,1:02:06.32,1:02:09.49,Default,,0,0,0,,Пирсингтің кесірінен Секинемен дос болдың ғой, солай ма?
Dialogue: 0,1:02:09.49,1:02:14.49,Default,,0,0,0,,Әй, енді ойлап қарасам... қабылдау рәсімінен кейін болған екен.
Dialogue: 0,1:02:18.43,1:02:22.10,Default,,0,0,0,,Иә? Сен ондасын ба! иә?
Dialogue: 0,1:02:22.10,1:02:27.44,Default,,0,0,0,,Қызметкерлер бөлмесіне кейінірек келіңіз. Иә.
Dialogue: 0,1:02:27.44,1:02:30.61,Default,,0,0,0,,Сіз пирсинг туралы айтып отырсыз ба?
Dialogue: 0,1:02:30.61,1:02:32.61,Default,,0,0,0,,Цубаса-сан
Dialogue: 0,1:02:32.61,1:02:35.62,Default,,0,0,0,,Мұғалімге айтар жақсы сөзім бар.
Dialogue: 0,1:02:35.62,1:02:38.12,Default,,0,0,0,,Не? Ах... рахмет
Dialogue: 0,1:02:38.12,1:02:40.12,Default,,0,0,0,,《Мейірімді бала》
Dialogue: 0,1:02:40.12,1:02:42.12,Default,,0,0,0,,500 иен жақсы.
Dialogue: 0,1:02:42.12,1:02:46.13,Default,,0,0,0,,Иә?
Dialogue: 0,1:02:46.13,1:02:49.63,Default,,0,0,0,,Иә, иә. Бұл діни себептерге байланысты сияқты.
Dialogue: 0,1:02:49.63,1:02:51.80,Default,,0,0,0,,《Цубаса: Қандай сұмдық өтірік》
Dialogue: 0,1:02:51.80,1:02:54.13,Default,,0,0,0,,Сіз мені сәтті алдадыңыз.
Dialogue: 0,1:02:54.13,1:02:56.14,Default,,0,0,0,,Ах... рахмет
Dialogue: 0,1:02:56.14,1:02:59.47,Default,,0,0,0,,Цубаса-сан, түскі асты мектеп асханасында жегің келе ме?
Dialogue: 0,1:02:59.47,1:03:02.48,Default,,0,0,0,,Мен саған 50 иенге шырын сатып аламын!
Dialogue: 0,1:03:02.48,1:03:05.81,Default,,0,0,0,,Менің ақшаммен бе?
Dialogue: 0,1:03:05.81,1:03:08.98,Default,,0,0,0,,Бұл менің көпшілдігімнің айласы болды.
Dialogue: 0,1:03:08.98,1:03:11.75,Default,,0,0,0,,Бәрі де Секиненің арқасы.
Dialogue: 0,1:03:11.75,1:03:16.95,Default,,0,0,0,,Ойлап қарасам, Чио-сан бірінші курстың ортасында басқа мектепке ауысты.
Dialogue: 0,1:03:19.59,1:03:22.10,Default,,0,0,0,,А, анау қыз...
Dialogue: 0,1:03:22.10,1:03:24.10,Default,,0,0,0,,Иә? ДДСҰ?
Dialogue: 0,1:03:24.10,1:03:28.60,Default,,0,0,0,,Ол керемет жас ханым сияқты. Ол әдемі.
Dialogue: 0,1:03:28.60,1:03:30.60,Default,,0,0,0,,Эй, бұл керемет.
Dialogue: 0,1:03:30.60,1:03:33.11,Default,,0,0,0,,Түскі асқа шақырайын ба? иә?
Dialogue: 0,1:03:33.11,1:03:36.28,Default,,0,0,0,,Маған бірдеңедей қарайтындай сезінбейсіз бе?
Dialogue: 0,1:03:36.28,1:03:39.61,Default,,0,0,0,,Жаңа мәзір еті удон 390 иен
Dialogue: 0,1:03:39.61,1:03:41.95,Default,,0,0,0,,<Айнымас Секине>
Dialogue: 0,1:03:41.95,1:03:44.45,Default,,0,0,0,,Қаласаң, бірге түскі ас ішейік...
Dialogue: 0,1:03:44.45,1:03:46.95,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,1:03:46.95,1:03:48.96,Default,,0,0,0,,А...
Dialogue: 0,1:03:48.96,1:03:53.96,Default,,0,0,0,,《Мектеп директорының басшысын мақсат ету
Dialogue: 0,1:03:53.96,1:03:56.96,Default,,0,0,0,,Достасып жатқанда бұлай болмайды》
Dialogue: 0,1:03:56.96,1:04:02.46,Default,,0,0,0,,Бұл ұят. Мен оны сенімен жегім келді.
Dialogue: 0,1:04:08.98,1:04:11.41,Default,,0,0,0,,Үшеуі де дәл бірдей жағдайда қаза тапты.
Dialogue: 0,1:04:11.41,1:04:14.91,Default,,0,0,0,,Бонус маскасы аю. Хмм...
Dialogue: 0,1:04:14.91,1:04:17.42,Default,,0,0,0,,Иә, бұл менде болған.
Dialogue: 0,1:04:17.42,1:04:19.92,Default,,0,0,0,,Осыны қалайсыз ба?
Dialogue: 0,1:04:19.92,1:04:22.42,Default,,0,0,0,,Керек емес деп оны басқаларға мәжбүрлеме.
Dialogue: 0,1:04:22.42,1:04:24.42,Default,,0,0,0,,Ах...
Dialogue: 0,1:04:29.10,1:04:31.10,Default,,0,0,0,,(айналдыру сылдырлауының дыбысы)
Dialogue: 0,1:04:33.10,1:04:36.44,Default,,0,0,0,,Қайырлы таң. (2 адам) Чи... Чио-сан?
Dialogue: 0,1:04:36.44,1:04:38.77,Default,,0,0,0,,Не болды?
Dialogue: 0,1:04:38.77,1:04:41.94,Default,,0,0,0,,Чио-сан, сен Маскумаға қатты ұнадың.
Dialogue: 0,1:04:41.94,1:04:45.61,Default,,0,0,0,,Өте сүйкімді...
Dialogue: 0,1:04:45.61,1:04:48.81,Default,,0,0,0,,《Сондықтан мен...》
Dialogue: 0,1:05:03.46,1:05:09.97,Default,,0,0,0,,Ой... ой...
Dialogue: 0,1:05:09.97,1:05:15.41,Default,,0,0,0,,Қарғыс атсын! Маска аю!
Dialogue: 0,1:05:15.41,1:05:19.41,Default,,0,0,0,,Ма~! Ма~!
Dialogue: 0,1:05:19.41,1:05:22.58,Default,,0,0,0,,Өйткені, мен ешкімді өлтіргім келмейді!
Dialogue: 0,1:05:22.58,1:05:26.59,Default,,0,0,0,,Мен маскалы аюдың шектеулі тауарларын жинағым келеді!
Dialogue: 0,1:05:26.59,1:05:29.09,Default,,0,0,0,,《Егер бетперде киген аюды кездестірмесең
Dialogue: 0,1:05:29.09,1:05:32.26,Default,,0,0,0,,Мен ауылдан кетуге шешім қабылдаған жоқпын.
Dialogue: 0,1:05:32.26,1:05:35.43,Default,,0,0,0,,《Маскамен!?》
Dialogue: 0,1:05:35.43,1:05:39.93,Default,,0,0,0,,Әйтеуір, бәрі де бар.
Dialogue: 0,1:05:39.93,1:05:42.60,Default,,0,0,0,,Иә. Бұл дұрыс.
Dialogue: 0,1:05:42.60,1:05:44.60,Default,,0,0,0,,Әрине!
Dialogue: 0,1:05:44.60,1:05:47.11,Default,,0,0,0,,《Ол кезде полковник жоқ па еді? 》
Dialogue: 0,1:05:47.11,1:05:51.94,Default,,0,0,0,,Біз орман мектебінде оқып жүргенде, Рикка оны жоғалтып алды, оны бәріміз іздедік.
Dialogue: 0,1:05:51.94,1:05:54.45,Default,,0,0,0,,《Бұл полковник ойлап тапқан естелік》
Dialogue: 0,1:05:54.45,1:05:58.28,Default,,0,0,0,,Рождестволық кеште біз қуыршақтарды да жасадық.
Dialogue: 0,1:05:58.28,1:06:00.45,Default,,0,0,0,,Бұл да полковниктің ойдан шығарған сөзі еді.
Dialogue: 0,1:06:00.45,1:06:04.79,Default,,0,0,0,,Олар сондай-ақ ұлы көшбасшыларды құрметтеу үшін тұрақты жиналыстарда киілетін.
Dialogue: 0,1:06:04.79,1:06:07.96,Default,,0,0,0,,болды. (Цубаса) А, иә.
Dialogue: 0,1:06:07.96,1:06:12.73,Default,,0,0,0,,Мен Какумей Набе жедім. Какумей Набе дәмді болды.
Dialogue: 0,1:06:12.73,1:06:15.74,Default,,0,0,0,,《Оның бәрі полковниктің ойдан шығарған ойы еді.
Dialogue: 0,1:06:15.74,1:06:18.40,Default,,0,0,0,,Дәлірек айтсақ, Какумей Набе деген не?
Dialogue: 0,1:06:18.40,1:06:23.41,Default,,0,0,0,,Иә? Айтайын дегенім, полковник қашан пайда болды? 》
Dialogue: 0,1:06:23.41,1:06:25.91,Default,,0,0,0,,<Менің миымды жуып жатқанын білемін, бірақ
Dialogue: 0,1:06:25.91,1:06:28.41,Default,,0,0,0,,Жад қаншалықты ойдан құрастырылған?
Dialogue: 0,1:06:28.41,1:06:30.42,Default,,0,0,0,,Секине белгісіз＞
Dialogue: 0,1:06:30.42,1:06:35.09,Default,,0,0,0,,《Бірақ мен жақсымын ба? Құдай-ау...》
Dialogue: 0,1:06:35.09,1:06:37.92,Default,,0,0,0,,Менің жүрегім әрқашан
Dialogue: 0,1:06:37.92,1:06:40.43,Default,,0,0,0,,Өйткені ол ұлы көсемнің ілімімен!
Dialogue: 0,1:06:40.43,1:06:42.43,Default,,0,0,0,,<Миды жуу күшті болды>
Dialogue: 0,1:06:47.43,1:06:49.77,Default,,0,0,0,,Хмм? Бұл туралы ше?
Dialogue: 0,1:06:49.77,1:06:53.44,Default,,0,0,0,,А, крекер? Басқа күні клубтық іс-шараларда қолданылатын реквизиттер
Dialogue: 0,1:06:53.44,1:06:55.44,Default,,0,0,0,,Хмм? (Чиё мысқылдайды)
Dialogue: 0,1:06:55.44,1:06:57.61,Default,,0,0,0,,Көп нәрсе қалды, солай ма?
Dialogue: 0,1:06:57.61,1:07:00.11,Default,,0,0,0,,Иә? Жоқ!?
Dialogue: 0,1:07:00.11,1:07:03.12,Default,,0,0,0,,Чи... Чио-сан, кешіріңіз!
Dialogue: 0,1:07:03.12,1:07:05.45,Default,,0,0,0,,Ууууууууу...
Dialogue: 0,1:07:05.45,1:07:08.12,Default,,0,0,0,,《Не... жылап тұрсың? 》
Dialogue: 0,1:07:08.12,1:07:11.56,Default,,0,0,0,,Барлығы тосын сый деп ойлайды.
Dialogue: 0,1:07:11.56,1:07:13.56,Default,,0,0,0,,Иә?
Dialogue: 0,1:07:13.56,1:07:15.90,Default,,0,0,0,,Менің туған күнім
Dialogue: 0,1:07:15.90,1:07:18.90,Default,,0,0,0,,Мені еске түсіру жеткілікті.
Dialogue: 0,1:07:18.90,1:07:22.07,Default,,0,0,0,,Сіз маған тосын сый да жоспарлап қойғансыз.
Dialogue: 0,1:07:22.07,1:07:24.90,Default,,0,0,0,,Ах... ааа...
Dialogue: 0,1:07:24.90,1:07:28.91,Default,,0,0,0,,Мен әлемдегі ең бақытты адаммын!
Dialogue: 0,1:07:28.91,1:07:30.91,Default,,0,0,0,,Туған күніңмен!
Dialogue: 0,1:07:30.91,1:07:34.75,Default,,0,0,0,,<Таңқаларлық табыс! деп шештім
Dialogue: 0,1:07:34.75,1:07:39.09,Default,,0,0,0,,《Жоқ, бірақ бұл туралы не істеу керек? Ешкім ешқандай дайындық жасаған жоқ...》
Dialogue: 0,1:07:39.09,1:07:41.75,Default,,0,0,0,,Риккадан Чиоға сыйлық!
Dialogue: 0,1:07:41.75,1:07:44.59,Default,,0,0,0,,《Полковник! Қашан дайындаласың!?》
Dialogue: 0,1:07:44.59,1:07:48.93,Default,,0,0,0,,Қандай ерекше...
Dialogue: 0,1:07:48.93,1:07:52.93,Default,,0,0,0,,Ыңғайлы өшіргіш! Аа!?
Dialogue: 0,1:07:52.93,1:07:58.27,Default,,0,0,0,,Рикка-чан, неге...
Dialogue: 0,1:07:58.27,1:08:02.61,Default,,0,0,0,,Менің нені қалайтынымды қайдан білесіз?
Dialogue: 0,1:08:02.61,1:08:04.61,Default,,0,0,0,,Иә!?
Dialogue: 0,1:08:04.61,1:08:06.95,Default,,0,0,0,,Уууу
Dialogue: 0,1:08:06.95,1:08:09.12,Default,,0,0,0,,《Не? Миды жуу?
Dialogue: 0,1:08:09.12,1:08:13.22,Default,,0,0,0,,Полковник Чийоның миына араласып, оған нені қалайтынын айтады.
Dialogue: 0,1:08:13.22,1:08:15.89,Default,,0,0,0,,Мен оны кәдімгі өшіргішпен ауыстырдым! 》
Dialogue: 0,1:08:15.89,1:08:18.89,Default,,0,0,0,,Өшіргіш? Бұл кеңсе тауарлары.
Dialogue: 0,1:08:18.89,1:08:21.73,Default,,0,0,0,,Ке... Өшіргіш~!
Dialogue: 0,1:08:21.73,1:08:24.06,Default,,0,0,0,,《Zu… Zurr…
Dialogue: 0,1:08:24.06,1:08:26.07,Default,,0,0,0,,Менің айтайын дегенім, егер сіз соншалықты алысқа баратын болсаңыз, онда бәрі жақсы.
Dialogue: 0,1:08:26.07,1:08:28.07,Default,,0,0,0,,Сіздің туған күніңізді тойлағыңыз келетін сезім
Dialogue: 0,1:08:28.07,1:08:30.07,Default,,0,0,0,,Оны жойсаңыз жақсы болмас па еді!
Dialogue: 0,1:08:30.07,1:08:33.91,Default,,0,0,0,,Цубасаны не істейміз... Екеуміз де жерге тізерлеп отырайық па? 》
Dialogue: 0,1:08:33.91,1:08:36.91,Default,,0,0,0,,Аха. Уфуфу
Dialogue: 0,1:08:36.91,1:08:39.41,Default,,0,0,0,,《Мен не істеуім керек...мен》
Dialogue: 0,1:08:42.92,1:08:46.09,Default,,0,0,0,,《Мен сыйлық сатып жатырмын.
Dialogue: 0,1:08:46.09,1:08:49.09,Default,,0,0,0,,Қыздардың көңіл-күйіне сай болуға тырыстым, бірақ
Dialogue: 0,1:08:49.09,1:08:52.43,Default,,0,0,0,,Мен тосын элемент қажет болады деп ешқашан күткен емеспін》
Dialogue: 0,1:08:52.43,1:08:54.59,Default,,0,0,0,,Чио-сан, кешіріңіз. иә?
Dialogue: 0,1:08:54.59,1:08:57.43,Default,,0,0,0,,Мен дайындаған жалғыз нәрсе мына сияқты қарапайым нәрсе...
Dialogue: 0,1:08:57.43,1:09:00.77,Default,,0,0,0,,Рахмет! Сіз оны ашуға қуаныштысыз ба?
Dialogue: 0,1:09:00.77,1:09:03.94,Default,,0,0,0,,Әрине. Жарайды, сүйкімді!
Dialogue: 0,1:09:03.94,1:09:08.77,Default,,0,0,0,,Туған күніме сыйлық ретінде тағы бір нәрсе жасағанымды қалайсыз ба?
Dialogue: 0,1:09:08.77,1:09:11.11,Default,,0,0,0,,Жоқ, бұл шектен шыққан.
Dialogue: 0,1:09:11.11,1:09:13.05,Default,,0,0,0,,Жоқ! Керісінше! Бірдене айтыңыз!
Dialogue: 0,1:09:13.05,1:09:15.38,Default,,0,0,0,,Олай болса...
Dialogue: 0,1:09:15.38,1:09:19.22,Default,,0,0,0,,Шашыңызбен тағы да ойнауға рұқсат етсем, қарсы боласыз ба?
Dialogue: 0,1:09:19.22,1:09:21.22,Default,,0,0,0,,Иә!?
Dialogue: 0,1:09:21.22,1:09:25.72,Default,,0,0,0,,Жазғы форманың орналасуы сізге өте жарасымды болды.
Dialogue: 0,1:09:25.72,1:09:30.06,Default,,0,0,0,,《Егер бұл сені бақытты етсе》
Dialogue: 0,1:09:30.06,1:09:32.57,Default,,0,0,0,,Керемет, Цубаса-сан!
Dialogue: 0,1:09:32.57,1:09:34.57,Default,,0,0,0,,Ах... а. Хехе.
Dialogue: 0,1:09:34.57,1:09:37.57,Default,,0,0,0,,《Ах! Мынау... Ендігі кезек Секине-санға.
Dialogue: 0,1:09:37.57,1:09:41.41,Default,,0,0,0,,Бұл көрініс. Жақсы... бұл жаман.
Dialogue: 0,1:09:41.41,1:09:43.74,Default,,0,0,0,,Менің таңдауым жоқ
Dialogue: 0,1:09:43.74,1:09:46.25,Default,,0,0,0,,Солай ма? Ах.
Dialogue: 0,1:09:46.25,1:09:51.92,Default,,0,0,0,,< Бұл Секине өзінің табиғаттан тыс күштерін басқара алатын уақыт.
Dialogue: 0,1:09:51.92,1:09:54.92,Default,,0,0,0,,Оны Ханшайым уақыты деп атаңыз.
Dialogue: 0,1:09:54.92,1:09:59.59,Default,,0,0,0,,Дегенмен, үлкен күшпен бірге үлкен баға келеді>
Dialogue: 0,1:09:59.59,1:10:04.10,Default,,0,0,0,,``Ханайым Уақыт өткен сайын мен
Dialogue: 0,1:10:04.10,1:10:06.10,Default,,0,0,0,,А, мен...
Dialogue: 0,1:10:06.10,1:10:08.77,Default,,0,0,0,,Сіздің салмағыңыз күрт артады! 》
Dialogue: 0,1:10:08.77,1:10:13.94,Default,,0,0,0,,Уау!
Dialogue: 0,1:10:13.94,1:10:20.04,Default,,0,0,0,,Иә! Олай болса мына дорба тәрізді дронмен аспанға хат жазайық!
Dialogue: 0,1:10:22.45,1:10:26.12,Default,,0,0,0,,О. Бұл керемет! Жақсы!
Dialogue: 0,1:10:26.12,1:10:28.95,Default,,0,0,0,,Туған күніңмен!
Dialogue: 0,1:10:28.95,1:10:32.79,Default,,0,0,0,,Қандай керемет хабар!
Dialogue: 0,1:10:32.79,1:10:35.79,Default,,0,0,0,,《Не... әйтеуір, мен құтыла аламын...》
Dialogue: 0,1:10:35.79,1:10:39.47,Default,,0,0,0,,Секине-сан Цубаса-сан Рикка-чан
Dialogue: 0,1:10:39.47,1:10:41.97,Default,,0,0,0,,(Виолет) Мен теремін. (Роданс) Жарай бер.
Dialogue: 0,1:10:41.97,1:10:45.64,Default,,0,0,0,,Мен туған күнімді осылай тойлаймын
Dialogue: 0,1:10:45.64,1:10:48.47,Default,,0,0,0,,Мені ешқашан ешкім құттықтаған емес.
Dialogue: 0,1:10:48.47,1:10:51.81,Default,,0,0,0,,Мен бұл мектепке барамын және барлығымен дос бола аламын.
Dialogue: 0,1:10:51.81,1:10:55.98,Default,,0,0,0,,Мен өте қуаныштымын. Мен сондай қуаныштымын!
Dialogue: 0,1:10:55.98,1:10:58.15,Default,,0,0,0,,《Бұл қиын болды, бірақ
Dialogue: 0,1:10:58.15,1:11:00.82,Default,,0,0,0,,Егер бұл сізді бақытты етсе, мен мұны істегеніме қуаныштымын...》
Dialogue: 0,1:11:00.82,1:11:05.49,Default,,0,0,0,,Сонымен, Секине мырза, қарсы болмасаңыз, аспанға жазып бере аласыз ба?
Dialogue: 0,1:11:05.49,1:11:07.49,Default,,0,0,0,,Иә?
Dialogue: 0,1:11:07.49,1:11:11.16,Default,,0,0,0,,Қанша жыл өтсе де, дос боламыз!
Dialogue: 0,1:11:11.16,1:11:13.56,Default,,0,0,0,,Ах... аа... а...
Dialogue: 0,1:11:19.44,1:11:23.11,Default,,0,0,0,,Ммммммммммммм
Dialogue: 0,1:11:23.11,1:11:28.51,Default,,0,0,0,,Өте көп!
Dialogue: 0,1:11:34.95,1:11:37.96,Default,,0,0,0,,Мәңгі... Достар...
Dialogue: 0,1:11:37.96,1:11:41.96,Default,,0,0,0,,Ах ха ха ха
Dialogue: 0,1:11:41.96,1:11:45.06,Default,,0,0,0,,Уф...
Dialogue: 0,1:11:47.13,1:11:49.13,Default,,0,0,0,,♬~
Dialogue: 0,1:11:49.13,1:11:51.64,Default,,0,0,0,,О... ой...
Dialogue: 0,1:11:51.64,1:11:57.54,Default,,0,0,0,,<Ханайым уақыты керемет баға>
Dialogue: 0,1:15:13.44,1:15:15.94,Default,,0,0,0,,<Кашихара қыздар мектебі 1-бөлім>
Dialogue: 0,1:15:15.94,1:15:19.44,Default,,0,0,0,,О, НЛО тұманмен жабылған.
Dialogue: 0,1:15:19.44,1:15:22.11,Default,,0,0,0,,Рас, ертең жаңбыр жаууы мүмкін.
Dialogue: 0,1:15:22.11,1:15:25.12,Default,,0,0,0,,<НЛО көмегімен ауа райын болжау>
Dialogue: 0,1:15:25.12,1:15:28.45,Default,,0,0,0,,《Секине: Оны да бәрі көреді.
Dialogue: 0,1:15:28.45,1:15:30.46,Default,,0,0,0,,Менің ойымша, бұл күлкілі емес》
Dialogue: 0,1:15:30.46,1:15:33.96,Default,,0,0,0,,Иә! Бәріміз бірге ән айтайық!
Dialogue: 0,1:15:33.96,1:15:36.13,Default,,0,0,0,,Керемет ұсыныс!
Dialogue: 0,1:15:36.13,1:15:44.97,Default,,0,0,0,,«О, биік, мұнарадағы жарқыраған НЛО.»
Dialogue: 0,1:15:44.97,1:15:49.81,Default,,0,0,0,,«Хикари енді біздікі».
Dialogue: 0,1:15:49.81,1:15:53.15,Default,,0,0,0,,<Кашихара қыздар мектебі 2-бөлім
Dialogue: 0,1:15:53.15,1:15:56.48,Default,,0,0,0,,Барлығымыз жиналғанда мектеп әнін шырқаймыз＞
Dialogue: 0,1:15:56.48,1:15:58.98,Default,,0,0,0,,《Дәлірек айтсақ, мектеп әні бұрмаланған!
Dialogue: 0,1:15:58.98,1:16:00.99,Default,,0,0,0,,Бұл қашан болды!?》
Dialogue: 0,1:16:00.99,1:16:04.16,Default,,0,0,0,,<Кашихара қыздар мектебі 3-бөлім
Dialogue: 0,1:16:04.16,1:16:08.99,Default,,0,0,0,,Шетелдіктер кейде ымырт кезінде НЛО-лардың үстінде пайда болады>
Dialogue: 0,1:16:08.99,1:16:11.16,Default,,0,0,0,,《Қазір ғарышта
Dialogue: 0,1:16:11.16,1:16:14.60,Default,,0,0,0,,Революция жолдастары шайқасады.
Dialogue: 0,1:16:14.60,1:16:20.11,Default,,0,0,0,,Сонда мен мұнда не істеп жүрмін?
Dialogue: 0,1:16:20.11,1:16:24.51,Default,,0,0,0,,Мені күт...Мен міндетті түрде қайтамын》
Dialogue: 0,1:18:06.48,1:18:10.65,Default,,0,0,0,,Мм, бүгін мен бәріңе печенье пісірдім.
Dialogue: 0,1:18:10.65,1:18:13.59,Default,,0,0,0,,Қаласаңыз, ләззат алыңыз.
Dialogue: 0,1:18:13.59,1:18:15.92,Default,,0,0,0,,Уау! Дәмді көрінеді!
Dialogue: 0,1:18:15.92,1:18:18.42,Default,,0,0,0,,Ол Аня-чанның әкесі бола ма?
Dialogue: 0,1:18:18.42,1:18:20.43,Default,,0,0,0,,Дәмді
Dialogue: 0,1:18:20.43,1:18:22.93,Default,,0,0,0,,Иә, иә, бұл дәмді~
Dialogue: 0,1:18:22.93,1:18:25.76,Default,,0,0,0,,Рикка Мен Чиё-санға үйленгім келеді~
Dialogue: 0,1:18:25.76,1:18:27.77,Default,,0,0,0,,Мен қуаныштымын.
Dialogue: 0,1:18:27.77,1:18:31.44,Default,,0,0,0,,Мен де үйленетін болсам, ол Чиё-сан болар еді.
Dialogue: 0,1:18:31.44,1:18:34.27,Default,,0,0,0,,Уфуфу Тіпті Секине мырза да сондай.
Dialogue: 0,1:18:34.27,1:18:38.61,Default,,0,0,0,,Цубаса бұлардың қайсысына үйленгісі келеді?
Dialogue: 0,1:18:38.61,1:18:41.45,Default,,0,0,0,,Иә?
Dialogue: 0,1:18:41.45,1:18:43.45,Default,,0,0,0,,(Жұтыну дыбысы)
Dialogue: 0,1:18:43.45,1:18:47.45,Default,,0,0,0,,《Бұған қалай жауап беруім керек?
Dialogue: 0,1:18:47.45,1:18:51.79,Default,,0,0,0,,Біріншіден, біз бәріміз доспыз және ешқашан үйленеміз деп ойлаған емеспіз.
Dialogue: 0,1:18:51.79,1:18:54.63,Default,,0,0,0,,Бірақ мен мұндай сұрақтарға жеңіл жауап беруім керек.
Dialogue: 0,1:18:54.63,1:18:59.46,Default,,0,0,0,,Неге деп ойлайтын шығарсыз.
Dialogue: 0,1:18:59.46,1:19:02.97,Default,,0,0,0,,Мен бұл жерде сабыр етіп, Чио-санға жауап беремін.
Dialogue: 0,1:19:02.97,1:19:07.14,Default,,0,0,0,,Ол мейірімді және әдемі, тамақ пісіруге және тігуге жақсы.
Dialogue: 0,1:19:07.14,1:19:09.98,Default,,0,0,0,,Менің ойымша, сіз достарыңызбен мақтана аласыз.》
Dialogue: 0,1:19:09.98,1:19:12.91,Default,,0,0,0,,Инуэ: О! Не?
Dialogue: 0,1:19:12.91,1:19:16.92,Default,,0,0,0,,《Бірақ бөлменің бетперде киген аюларға толы болуы біраз қиын...
Dialogue: 0,1:19:16.92,1:19:20.09,Default,,0,0,0,,Сондай-ақ, миналардың нүктесі тым жұмбақ》
Dialogue: 0,1:19:20.09,1:19:23.42,Default,,0,0,0,,Нағыз іс құсқаннан кейін басталады, солай ма?
Dialogue: 0,1:19:23.42,1:19:27.09,Default,,0,0,0,,《Оны ойласам әлі ішім ауырады...
Dialogue: 0,1:19:27.09,1:19:30.26,Default,,0,0,0,,Секине - ең оңай адам.
Dialogue: 0,1:19:30.26,1:19:32.93,Default,,0,0,0,,Сабақтан кейін отбасылық мейрамханаға барғыңыз келе ме?
Dialogue: 0,1:19:32.93,1:19:37.60,Default,,0,0,0,,Енді қолданба арқылы төлесеңіз, 40% қайтарып аласыз!
Dialogue: 0,1:19:37.60,1:19:42.44,Default,,0,0,0,,《Ол қарапайым адам сияқты, сондықтан мен қатты қобалжымай-ақ тіл табыса аламыз деп ойлаймын. Бірақ...》
Dialogue: 0,1:19:42.44,1:19:44.94,Default,,0,0,0,,Әдетте Джерси.
Dialogue: 0,1:19:44.94,1:19:47.61,Default,,0,0,0,,Ыңғайлы, мен кірлеуге қарсы емеспін.
Dialogue: 0,1:19:47.61,1:19:50.12,Default,,0,0,0,,Пижама, демалыс немесе сырт киім ретінде пайдалануға болады.
Dialogue: 0,1:19:50.12,1:19:52.12,Default,,0,0,0,,Бұл ең жақсы
Dialogue: 0,1:19:52.12,1:19:55.45,Default,,0,0,0,,《Тым қызықсыз》
Dialogue: 0,1:19:55.45,1:19:57.96,Default,,0,0,0,,《Ой ағылмайды
Dialogue: 0,1:19:57.96,1:20:00.79,Default,,0,0,0,,Мен сенің не ойлағаныңды түсінемін.
Dialogue: 0,1:20:00.79,1:20:03.46,Default,,0,0,0,,《Цубаса: Рикка Тенма Ранман және сүйкімді
Dialogue: 0,1:20:03.46,1:20:05.96,Default,,0,0,0,,Егер сіз оны досыңызға таныстырсаңыз...》
Dialogue: 0,1:20:05.96,1:20:09.80,Default,,0,0,0,,Цуйоши Сіз бастауыш сынып оқушысымен кездесіп жүрсіз бе?
Dialogue: 0,1:20:09.80,1:20:12.90,Default,,0,0,0,,《Сізді лоликон ретінде қарастыруы мүмкін.
Dialogue: 0,1:20:12.90,1:20:15.74,Default,,0,0,0,,Сондай-ақ, мен жұмбақ жиындарға шақырғанды ​​ұнатпаймын.
Dialogue: 0,1:20:15.74,1:20:19.91,Default,,0,0,0,,Біз әр жексенбіде НЛО-да кездесеміз.
Dialogue: 0,1:20:19.91,1:20:22.25,Default,,0,0,0,,Рикка мені қатты құрметтейді.
Dialogue: 0,1:20:22.25,1:20:26.92,Default,,0,0,0,,Мен сендерге ұлы көсем туралы айтып беремін.
Dialogue: 0,1:20:26.92,1:20:31.09,Default,,0,0,0,,Бұл ең дұрыс таңдау.
Dialogue: 0,1:20:31.09,1:20:34.76,Default,,0,0,0,,Кешіріңіз! Сонымен, сіз қандай адамды қалайсыз?
Dialogue: 0,1:20:34.76,1:20:36.93,Default,,0,0,0,,Не? Хмм
Dialogue: 0,1:20:36.93,1:20:41.27,Default,,0,0,0,,Мен оның мінезінің сергітетінін қалаймын. Кем дегенде еркектік.
Dialogue: 0,1:20:41.27,1:20:45.44,Default,,0,0,0,,Әйелге ұқсап, көбірек әсер ету жақсы.
Dialogue: 0,1:20:45.44,1:20:47.77,Default,,0,0,0,,Сондай-ақ, қысқа шаш жақсырақ.
Dialogue: 0,1:20:47.77,1:20:50.94,Default,,0,0,0,,Бірақ, ондай адамдар көп емес.
Dialogue: 0,1:20:50.94,1:20:52.94,Default,,0,0,0,,<Мен осында болдым>
Dialogue: 0,1:20:52.94,1:20:54.95,Default,,0,0,0,,Аха…
Dialogue: 0,1:20:54.95,1:20:56.95,Default,,0,0,0,,《Сіз өзіңізді жақсы көресіз бе! 》
Dialogue: 0,1:20:58.95,1:21:02.29,Default,,0,0,0,,Сіз мұны кеше көрдіңіз бе? (2 адам) көрді
Dialogue: 0,1:21:02.29,1:21:05.29,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,1:21:05.29,1:21:07.29,Default,,0,0,0,,Қайырлы таң Секине
Dialogue: 0,1:21:07.29,1:21:09.46,Default,,0,0,0,,Аа, енді ойлап қарасам.
Dialogue: 0,1:21:09.46,1:21:13.90,Default,,0,0,0,,Кеше мен Чиёға ұқсайтын кумир таптым. Қараңыз.
Dialogue: 0,1:21:13.90,1:21:16.23,Default,,0,0,0,,Рас, олар бір-біріне ұқсайды.
Dialogue: 0,1:21:16.23,1:21:19.24,Default,,0,0,0,,Оң. Оның үстіне бұл суретті қайдан алдың?
Dialogue: 0,1:21:19.24,1:21:21.57,Default,,0,0,0,,Уф, бұл журнал!
Dialogue: 0,1:21:21.57,1:21:26.24,Default,,0,0,0,,Оны маған інім Цюоши сатып алды. Ахахаха…｡ О, түсіндім.
Dialogue: 0,1:21:26.24,1:21:30.42,Default,,0,0,0,,Эй, бұл фотолар не үшін?
Dialogue: 0,1:21:30.42,1:21:36.09,Default,,0,0,0,,Ой, бұл не үшін... Менің ойымша, бұл еркектерге арналған шығар...?
Dialogue: 0,1:21:36.09,1:21:38.76,Default,,0,0,0,,Ер адамдар неге ұқсайды?
Dialogue: 0,1:21:38.76,1:21:42.93,Default,,0,0,0,,А, хмм, көңіл көтеру үшін бе?
Dialogue: 0,1:21:42.93,1:21:45.10,Default,,0,0,0,,Неліктен толқығыңыз келеді?
Dialogue: 0,1:21:45.10,1:21:48.10,Default,,0,0,0,,Сонымен, ұрпақ қалдыру ма?
Dialogue: 0,1:21:48.10,1:21:52.44,Default,,0,0,0,,Бұны көрсем ұрпақ қалдыра аламын ба? Бұл жүйе ме?
Dialogue: 0,1:21:52.44,1:21:55.44,Default,,0,0,0,,Жоқ, менің ойымша, сіз оған қарап тұра алмайсыз.
Dialogue: 0,1:21:55.44,1:21:57.78,Default,,0,0,0,,Олай болса, сіз бұған қарап қалай сезінесіз?
Dialogue: 0,1:21:57.78,1:22:01.45,Default,,0,0,0,,Сіз шынымен қымбат уақытыңызды оны көруге жұмсауыңыз керек пе?
Dialogue: 0,1:22:01.45,1:22:05.12,Default,,0,0,0,,Сіз тек бір рет өмір сүресіз, солай ма? Сіз мұңаймайсыз ба?
Dialogue: 0,1:22:05.12,1:22:07.12,Default,,0,0,0,,Уф
Dialogue: 0,1:22:07.12,1:22:09.45,Default,,0,0,0,,<Тазалығынан ащы>
Dialogue: 0,1:22:09.45,1:22:11.89,Default,,0,0,0,,Баршаңызға қайырлы күн
Dialogue: 0,1:22:11.89,1:22:14.06,Default,,0,0,0,,《Чио-сан жақсы жерде》
Dialogue: 0,1:22:14.06,1:22:16.39,Default,,0,0,0,,Қайырлы таң Чио-сан
Dialogue: 0,1:22:16.39,1:22:19.56,Default,,0,0,0,,Чиёге ұқсайтын кумир бар.
Dialogue: 0,1:22:19.56,1:22:23.57,Default,,0,0,0,,Хмм... ұқсайсың ба?
Dialogue: 0,1:22:23.57,1:22:25.90,Default,,0,0,0,,Иә. Олардың жүздері ұқсас.
Dialogue: 0,1:22:25.90,1:22:28.24,Default,,0,0,0,,Солай ма?
Dialogue: 0,1:22:28.24,1:22:30.91,Default,,0,0,0,,Қараңдар, мынау, мынау, т.б.
Dialogue: 0,1:22:30.91,1:22:32.91,Default,,0,0,0,,Ах...
Dialogue: 0,1:22:32.91,1:22:36.92,Default,,0,0,0,,Бұл купальник купальникке ұқсайды~. Уф...
Dialogue: 0,1:22:36.92,1:22:40.09,Default,,0,0,0,,Ал... дұрыс... солай ма?
Dialogue: 0,1:22:40.09,1:22:43.42,Default,,0,0,0,,Бұл шынымен де...
Dialogue: 0,1:22:43.42,1:22:45.42,Default,,0,0,0,,《Неге жылайсың!?》
Dialogue: 0,1:22:45.42,1:22:50.60,Default,,0,0,0,,Ах~ Ах~ Ах~ Чийо-санға мұны көрсетпеу керек.
Dialogue: 0,1:22:50.60,1:22:54.60,Default,,0,0,0,,Жоқ, бірақ бұл кумир сондай әдемі.
Dialogue: 0,1:22:54.60,1:22:56.60,Default,,0,0,0,,Иә
Dialogue: 0,1:22:56.60,1:22:58.94,Default,,0,0,0,,Мәселе бұл емес.
Dialogue: 0,1:22:58.94,1:23:01.27,Default,,0,0,0,,Иммунитетсіз адамдарға ескертусіз
Dialogue: 0,1:23:01.27,1:23:04.28,Default,,0,0,0,,Мен арандатушы нәрсені көрсетуге қарсымын.
Dialogue: 0,1:23:04.28,1:23:07.78,Default,,0,0,0,,《Цубаса: Мен... кенет төраға кейіпкер шықты》
Dialogue: 0,1:23:07.78,1:23:11.72,Default,,0,0,0,,Иә, бірақ бұл соншалықты қызықты емес...
Dialogue: 0,1:23:11.72,1:23:15.05,Default,,0,0,0,,Ащы тағамды ұнатпайтындар үшін бір ащылықтың өзі ауырады. Уф.
Dialogue: 0,1:23:15.05,1:23:17.06,Default,,0,0,0,,Дүниеде тіпті балалардың карри
Dialogue: 0,1:23:17.06,1:23:20.39,Default,,0,0,0,,Кейбір адамдар ащылықты Super Spicy Hell Раменмен бірдей деңгейде деп санайды.
Dialogue: 0,1:23:20.39,1:23:22.39,Default,,0,0,0,,Уф, а, а...｡ (Цубаса) Жоқ, бұл дұрыс
Dialogue: 0,1:23:22.39,1:23:24.90,Default,,0,0,0,,Бұл тұзды рамен немесе танмен сияқты жұмсақ...
Dialogue: 0,1:23:24.90,1:23:26.90,Default,,0,0,0,,Не, бұл жарылыс!?
Dialogue: 0,1:23:26.90,1:23:31.90,Default,,0,0,0,,Жарайды. Мен... мен
Dialogue: 0,1:23:31.90,1:23:34.07,Default,,0,0,0,,Оны шешіңіз! 《Неге!?》
Dialogue: 0,1:23:34.07,1:23:36.41,Default,,0,0,0,,Кішкене тынышталайық.
Dialogue: 0,1:23:36.41,1:23:43.08,Default,,0,0,0,,《Неге? Мен мұны... соншалықты жаман жасадым ба? 》
Dialogue: 0,1:23:43.08,1:23:46.58,Default,,0,0,0,,《Мм, ол жақсы қыз.
Dialogue: 0,1:23:46.58,1:23:49.42,Default,,0,0,0,,Мұндай жағдайлар кейде болады.
Dialogue: 0,1:23:49.42,1:23:52.42,Default,,0,0,0,,Менің сезімім аздап бұзылған сияқты.
Dialogue: 0,1:23:52.42,1:23:57.93,Default,,0,0,0,,Менің ойларым мүлдем қозғалмайды, сондықтан мен олардың не ойлайтынын білмеймін.
Dialogue: 0,1:23:57.93,1:24:01.60,Default,,0,0,0,,<Өйткені Секиненің күштері тым тозған
Dialogue: 0,1:24:01.60,1:24:06.44,Default,,0,0,0,,Қабілет бір жыныста ғана шектелетінін түсінбедім.
Dialogue: 0,1:24:06.44,1:24:08.94,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,1:24:08.94,1:24:11.71,Default,,0,0,0,,Мен мектепті тастаймын
Dialogue: 0,1:24:11.71,1:24:14.38,Default,,0,0,0,,Чио-сан, сен тынышталдың ба?
Dialogue: 0,1:24:14.38,1:24:17.05,Default,,0,0,0,,Сиқыр формуласын ашу
Dialogue: 0,1:24:17.05,1:24:21.39,Default,,0,0,0,,Мен мектепті тастап жатырмын.
Dialogue: 0,1:24:21.39,1:24:23.39,Default,,0,0,0,,<Синхрондалған>
Dialogue: 0,1:24:23.39,1:24:27.23,Default,,0,0,0,,Жоқ, жоқ, жоқ, маған тоқтау керек емес.
Dialogue: 0,1:24:27.23,1:24:32.23,Default,,0,0,0,,Мен енді мұны істей алмаймын. Секине: Барлығы үшін рахмет.
Dialogue: 0,1:24:32.23,1:24:35.57,Default,,0,0,0,,Ертеңнен кейін Секине есіме түспесе...
Dialogue: 0,1:24:35.57,1:24:39.40,Default,,0,0,0,,Сіздің мінез-құлқыңыз оғаш деп алаңдамаңыз.
Dialogue: 0,1:24:39.40,1:24:42.07,Default,,0,0,0,,《Сен тоқтайсың ба? Қайсысы? 》
Dialogue: 0,1:24:42.07,1:24:47.25,Default,,0,0,0,,Аа... жақсы, менің тоқтауымның қажеті жоқ сияқты.
Dialogue: 0,1:24:47.25,1:24:51.08,Default,,0,0,0,,Бірақ мен бұдан былай қиындық тудырғым келмейді.
Dialogue: 0,1:24:51.08,1:24:57.59,Default,,0,0,0,,Мен... жай ғана тентек нәрселер мен еркектерді ұнатпаймын...
Dialogue: 0,1:24:57.59,1:25:03.43,Default,,0,0,0,,Оны жақсы білмеу үшін ештеңе істей алмайсыз. Жарайды. Рика сені қорғайды.
Dialogue: 0,1:25:03.43,1:25:05.43,Default,,0,0,0,,Ах!
Dialogue: 0,1:25:05.43,1:25:07.93,Default,,0,0,0,,Мен саған бір саусақты тигізуге жол бермеймін
Dialogue: 0,1:25:07.93,1:25:10.94,Default,,0,0,0,,Рикка-чан...
Dialogue: 0,1:25:10.94,1:25:12.94,Default,,0,0,0,,Оның келбеті де, аурасы да бұрынғыдан өзгеше.
Dialogue: 0,1:25:12.94,1:25:15.44,Default,,0,0,0,,Секине-чан, не болды?
Dialogue: 0,1:25:15.44,1:25:19.78,Default,,0,0,0,,Әйтеуір Цубаса мектепті тастап жатқанын айта бастады. Эх!
Dialogue: 0,1:25:19.78,1:25:24.62,Default,,0,0,0,,Екеуі де жарайды дейді. Жасалайық.
Dialogue: 0,1:25:24.62,1:25:26.62,Default,,0,0,0,,Чио-сан, кешіріңіз.
Dialogue: 0,1:25:26.62,1:25:31.46,Default,,0,0,0,,Бұл менмін. Цубасаға мектепті тастаудың қажеті жоқ.
Dialogue: 0,1:25:31.46,1:25:34.96,Default,,0,0,0,,Жақсы араласуды жалғастырыңыз.
Dialogue: 0,1:25:34.96,1:25:38.96,Default,,0,0,0,,Рахмет. иә? О...
Dialogue: 0,1:25:38.96,1:25:42.30,Default,,0,0,0,,Кешіріңіз. иә? Кішкене дәретхана
Dialogue: 0,1:25:42.30,1:25:46.14,Default,,0,0,0,,Бірақ Чийо-сан, сенің тыныштанғаныңа қуаныштымын.
Dialogue: 0,1:25:46.14,1:25:48.47,Default,,0,0,0,,Иә! Рикка-чан
Dialogue: 0,1:25:48.47,1:25:51.31,Default,,0,0,0,,Мені әрдайым жұбатқаныңыз үшін рахмет. Хехе
Dialogue: 0,1:25:51.31,1:25:53.31,Default,,0,0,0,,《Жасай бер, полковник! 》
Dialogue: 0,1:25:53.31,1:25:57.98,Default,,0,0,0,,《Рикка: Мен уәдемді орындаймын! Чио-сан үшін біз теріге тиген сәтте,
Dialogue: 0,1:25:57.98,1:26:01.15,Default,,0,0,0,,Мен еркектерді әйелдікке айналдыратын құрылғы орнаттым! 》
Dialogue: 0,1:26:01.15,1:26:03.49,Default,,0,0,0,,《Солай ма? 》
Dialogue: 0,1:26:03.49,1:26:06.16,Default,,0,0,0,,Қайырлы таң баршаңызға!
Dialogue: 0,1:26:06.16,1:26:09.16,Default,,0,0,0,,Хахахаха. Қайырлы таң!
Dialogue: 0,1:26:09.16,1:26:13.43,Default,,0,0,0,,О, Брайан мырза, менің киімімде талшық бар...
Dialogue: 0,1:26:13.43,1:26:16.43,Default,,0,0,0,,Жоқ! Брайанға тиіспе! Гуаа!
Dialogue: 0,1:26:16.43,1:26:18.44,Default,,0,0,0,,Ватт!?
Dialogue: 0,1:26:18.44,1:26:20.44,Default,,0,0,0,,♬~
Dialogue: 0,1:26:22.44,1:26:24.44,Default,,0,0,0,,《Жоқ...
Dialogue: 0,1:26:24.44,1:26:26.44,Default,,0,0,0,,Онда болуы керек нәрсе жоғалып кетті.
Dialogue: 0,1:26:32.45,1:26:35.45,Default,,0,0,0,,Сол жаққа барайық. Иә. Кеттік, кеттік.
Dialogue: 0,1:26:35.45,1:26:39.46,Default,,0,0,0,,《Мен маңызды нәрсені жоғалтып алдым》
Dialogue: 0,1:26:39.46,1:26:42.79,Default,,0,0,0,,Цубаса мырза, не болды?
Dialogue: 0,1:26:42.79,1:26:45.46,Default,,0,0,0,,Бүгін таңертеңнен бері өзімді жақсы сезінбеймін. иә?
Dialogue: 0,1:26:45.46,1:26:50.13,Default,,0,0,0,,<Цубаса әйел болған кезде күтпеген оқиға болды>
Dialogue: 0,1:26:50.13,1:26:52.97,Default,,0,0,0,,《Не маңызды? 》
Dialogue: 0,1:26:52.97,1:26:57.31,Default,,0,0,0,,<Секине Цубасаның ойын оқи алды>
Dialogue: 0,1:26:57.31,1:27:00.98,Default,,0,0,0,,《Егер маған хабар берсең, мен оны сенімен бірге іздегім келеді...
Dialogue: 0,1:27:00.98,1:27:03.65,Default,,0,0,0,,Бірақ мен де тыңдағым келеді.
Dialogue: 0,1:27:03.65,1:27:05.82,Default,,0,0,0,,Цубаса-чан!
Dialogue: 0,1:27:05.82,1:27:07.99,Default,,0,0,0,,Сіз қоғамдық пәндер бойынша үй тапсырмасын орындадыңыз ба?
Dialogue: 0,1:27:07.99,1:27:12.26,Default,,0,0,0,,Қараңдаршы, бұл үйге тапсырма, онда сіз өз есіміңіздің шығу тегін білуіңіз керек.
Dialogue: 0,1:27:12.26,1:27:15.59,Default,,0,0,0,,Маған есімді атам қойған, солай ма?
Dialogue: 0,1:27:15.59,1:27:18.60,Default,,0,0,0,,Мықты бала болып өскеніңді қалаймын!
Dialogue: 0,1:27:18.60,1:27:21.77,Default,,0,0,0,,Уф, ата, кешіріңіз!
Dialogue: 0,1:27:21.77,1:27:23.94,Default,,0,0,0,,《Жылау элементі болды ма? 》
Dialogue: 0,1:27:23.94,1:27:26.94,Default,,0,0,0,,Ой...《Секине: Неге полковник!?》
Dialogue: 0,1:27:26.94,1:27:29.27,Default,,0,0,0,,Қандай керемет ата!
Dialogue: 0,1:27:29.27,1:27:31.78,Default,,0,0,0,,Цубасада осындай мағына болды.
Dialogue: 0,1:27:31.78,1:27:36.45,Default,,0,0,0,,А, жоқ, бұл менің інім Цюйоши есімінің шығу тегі.
Dialogue: 0,1:27:36.45,1:27:38.95,Default,,0,0,0,,Қанаттар еркін өседі
Dialogue: 0,1:27:38.95,1:27:42.95,Default,,0,0,0,,Цубаса: Эй Цуёси, мен академиялық білімім бойынша өте жақсы көрінемін, солай емес пе?
Dialogue: 0,1:27:42.95,1:27:46.12,Default,,0,0,0,,Менің сүйкімді қызым бар!
Dialogue: 0,1:27:46.12,1:27:49.46,Default,,0,0,0,,Керемет табыс! Мүмкін сіз тым еркін өмір сүретін шығарсыз!
Dialogue: 0,1:27:49.46,1:27:51.46,Default,,0,0,0,,Бұл бәрінен де көп.
Dialogue: 0,1:27:51.46,1:27:54.47,Default,,0,0,0,,《Қанаттың бір қызығы бар.
Dialogue: 0,1:27:54.47,1:27:57.47,Default,,0,0,0,,Мен маңызды нәрсені жоғалтқандықтан депрессияға ұшыраймын.
Dialogue: 0,1:27:57.47,1:28:00.47,Default,,0,0,0,,Ата тақырыбы бойынша табиғи емес көз жасы
Dialogue: 0,1:28:00.47,1:28:02.47,Default,,0,0,0,,Түсіндім!
Dialogue: 0,1:28:02.47,1:28:05.64,Default,,0,0,0,,Мүмкін мен атамның естелігін жоғалтып алған шығармын.
Dialogue: 0,1:28:05.64,1:28:08.65,Default,,0,0,0,,Ал, мен депрессиядамын.
Dialogue: 0,1:28:08.65,1:28:11.58,Default,,0,0,0,,<Айтпақшы, менің атам әлі тірі>
Dialogue: 0,1:28:11.58,1:28:14.75,Default,,0,0,0,,Цубаса мырза, қарсы болмасаңыз.
Dialogue: 0,1:28:14.75,1:28:17.59,Default,,0,0,0,,Келесі демалыста бір жерге барғыңыз келе ме?
Dialogue: 0,1:28:17.59,1:28:21.09,Default,,0,0,0,,А, онда бәріміз бассейнге барсақ ше?
Dialogue: 0,1:28:21.09,1:28:23.09,Default,,0,0,0,,Бассейн? Жақсы!
Dialogue: 0,1:28:23.09,1:28:27.43,Default,,0,0,0,,Ракураку Лэндте тек әйелдерге арналған түнгі бассейн болатын сияқты.
Dialogue: 0,1:28:27.43,1:28:30.44,Default,,0,0,0,,Жоқ, бұл әйелдерге қатысты.
Dialogue: 0,1:28:30.44,1:28:33.77,Default,,0,0,0,,Сіз кездесу іздеп жүрсіз бе?
Dialogue: 0,1:28:33.77,1:28:38.78,Default,,0,0,0,,Ах... иә, жоқ, аздап мәселе бар...
Dialogue: 0,1:28:38.78,1:28:40.95,Default,,0,0,0,,《Ешқандай мәселе жоқ》
Dialogue: 0,1:28:40.95,1:28:42.95,Default,,0,0,0,,＜Бұл да емес＞
Dialogue: 0,1:28:46.28,1:28:48.29,Default,,0,0,0,,Аа, бұл бір жолақ қағаз.
Dialogue: 0,1:28:48.29,1:28:51.12,Default,,0,0,0,,Айтпақшы, бүгін Танабата~ болды
Dialogue: 0,1:28:51.12,1:28:54.96,Default,,0,0,0,,Біз де тілектерімізді жазып, безендірейік.
Dialogue: 0,1:28:54.96,1:28:57.80,Default,,0,0,0,,Чио қандай тілек айтады?
Dialogue: 0,1:28:57.80,1:29:01.47,Default,,0,0,0,,Уау, бұл құпия.
Dialogue: 0,1:29:01.47,1:29:04.57,Default,,0,0,0,,《Тілеген тілектерің орындалсын! 》
Dialogue: 0,1:29:06.64,1:29:08.81,Default,,0,0,0,,О, Цубаса-сан ше?
Dialogue: 0,1:29:08.81,1:29:12.08,Default,,0,0,0,,Мен артта бір жерде киім ауыстырып отырдым.
Dialogue: 0,1:29:12.08,1:29:14.75,Default,,0,0,0,,Мен сізді ұятқа қалдырудың қажеті жоқ деп ойлаймын.
Dialogue: 0,1:29:14.75,1:29:17.58,Default,,0,0,0,,Иә, иә, киім ауыстыру бір сәтке ғана алады.
Dialogue: 0,1:29:17.58,1:29:21.42,Default,,0,0,0,,<Полковник Рикканың тез киім ауыстыруы сәтті болды>
Dialogue: 0,1:29:21.42,1:29:26.76,Default,,0,0,0,,Сен сондай сүйкімдісің, Рикка-чан!
Dialogue: 0,1:29:26.76,1:29:31.26,Default,,0,0,0,,Хэхехе. Чио-сан шынымен киінген көрінеді.
Dialogue: 0,1:29:31.26,1:29:35.43,Default,,0,0,0,,Тривиальды заттар
Dialogue: 0,1:29:35.43,1:29:37.60,Default,,0,0,0,,《Қыздың жүрегі ме? 》
Dialogue: 0,1:29:37.60,1:29:41.11,Default,,0,0,0,,《Ақырында, мен сонша киюім керек.
Dialogue: 0,1:29:41.11,1:29:43.44,Default,,0,0,0,,Аяғымдағы қылыш жарасын жасыра алмаймын.
Dialogue: 0,1:29:43.44,1:29:46.44,Default,,0,0,0,,Сіз өлтірушінің қай жерде пайда болатынын ешқашан білмейсіз.
Dialogue: 0,1:29:46.44,1:29:48.45,Default,,0,0,0,,<Ниндзя жүрегі>
Dialogue: 0,1:29:48.45,1:29:51.78,Default,,0,0,0,,Не дегіңіз келеді…
Dialogue: 0,1:29:51.78,1:29:54.79,Default,,0,0,0,,Бұл өте қызық сияқты!
Dialogue: 0,1:29:54.79,1:29:58.29,Default,,0,0,0,,《Жақсысың ба... Мен қалқып тұрған жоқпын, солай ма? 》
Dialogue: 0,1:29:58.29,1:30:00.46,Default,,0,0,0,,Жүр, кеттік! иә?
Dialogue: 0,1:30:00.46,1:30:02.46,Default,,0,0,0,,Уау!
Dialogue: 0,1:30:02.46,1:30:05.30,Default,,0,0,0,,Әуелі, денені қыздыру жаттығулары!
Dialogue: 0,1:30:05.30,1:30:10.10,Default,,0,0,0,,Алға! Бұл шабуыл! Ти!
Dialogue: 0,1:30:12.40,1:30:15.24,Default,,0,0,0,,Қарсы болмасаң, менімен сусындар ма едің?
Dialogue: 0,1:30:15.24,1:30:17.58,Default,,0,0,0,,Сіз сенімдісіз бе? иә!
Dialogue: 0,1:30:17.58,1:30:21.41,Default,,0,0,0,,Ухухуху. Ухухуху.
Dialogue: 0,1:30:21.41,1:30:23.41,Default,,0,0,0,,Аха ахахха
Dialogue: 0,1:30:25.75,1:30:30.42,Default,,0,0,0,,《Жай ғана әдемі ханымдар бар. Бұл бір қызық》
Dialogue: 0,1:30:30.42,1:30:32.42,Default,,0,0,0,,Сәлем, балақай. иә?
Dialogue: 0,1:30:32.42,1:30:34.43,Default,,0,0,0,,Бұл біраз нашар.
Dialogue: 0,1:30:34.43,1:30:37.76,Default,,0,0,0,,Менің алқам ілмекке оралған. Өтінемін, алып тастай аласыз ба? Уууу
Dialogue: 0,1:30:37.76,1:30:39.76,Default,,0,0,0,,(Жолаушы) Соңғы сегіздік пе? Сен керемет көріндің.
Dialogue: 0,1:30:39.76,1:30:41.77,Default,,0,0,0,,《Хо, хоа~》
Dialogue: 0,1:30:41.77,1:30:44.97,Default,,0,0,0,,Кешіріңіз~ Рахмет. Уууу
Dialogue: 0,1:30:47.94,1:30:52.28,Default,,0,0,0,,Цубаса мырза, көңіл-күйіңізді сәл өзгерттіңіз бе?
Dialogue: 0,1:30:52.28,1:30:55.45,Default,,0,0,0,,Баршаңызға~!
Dialogue: 0,1:30:55.45,1:31:00.45,Default,,0,0,0,,Түнгі бассейн өте қызықты! Мен сондай қуаныштымын!
Dialogue: 0,1:31:00.45,1:31:02.45,Default,,0,0,0,,《3 адам: Иә? 》
Dialogue: 0,1:31:02.45,1:31:04.96,Default,,0,0,0,,Ол сондай болды ма?
Dialogue: 0,1:31:04.96,1:31:07.13,Default,,0,0,0,,Сіз не айтып тұрсыз?
Dialogue: 0,1:31:07.13,1:31:10.96,Default,,0,0,0,,Мен әрқашан осындай болғанмын!
Dialogue: 0,1:31:10.96,1:31:15.07,Default,,0,0,0,,《Жақсы болсам, жақсы ма? 》
Dialogue: 0,1:31:15.07,1:31:19.07,Default,,0,0,0,,А, дұрыс! Жолақтарды безендірейік!
Dialogue: 0,1:31:19.07,1:31:21.27,Default,,0,0,0,,Ал, солай істейік!
Dialogue: 0,1:31:23.24,1:31:26.74,Default,,0,0,0,,《Мен бұрынғы келбетіме ораламын деп үміттенемін.''
Dialogue: 0,1:31:26.74,1:31:31.92,Default,,0,0,0,,Осы уақытқа дейін менде ештеңе болмады.
Dialogue: 0,1:31:31.92,1:31:35.42,Default,,0,0,0,,《Қылыштың ізі өшсін》
Dialogue: 0,1:31:35.42,1:31:39.42,Default,,0,0,0,,《Мен 3 кг тастағым келеді. Бұл жағдайда тіпті 2 кг жақсы》
Dialogue: 0,1:31:39.42,1:31:44.93,Default,,0,0,0,,《Бәрі шындап намаз оқып жатыр. Олардың тілектерін орындауға тырысады.
Dialogue: 0,1:31:44.93,1:31:48.93,Default,,0,0,0,,Қалай... Жердегі адамдар қаншалықты ақымақ?
Dialogue: 0,1:31:48.93,1:31:53.44,Default,,0,0,0,,Мақсат жалықпас ізденіспен қолға алынатын нәрсе емес пе?
Dialogue: 0,1:31:53.44,1:31:56.61,Default,,0,0,0,,Мен Жер мәдениетіне бейімделуге күш салғаныммен,
Dialogue: 0,1:31:56.61,1:31:59.44,Default,,0,0,0,,Күтілгендей, бұл қабылданбайды.
Dialogue: 0,1:31:59.44,1:32:02.28,Default,,0,0,0,,Рикка қағаз жолақтарын ілмейді ме?
Dialogue: 0,1:32:02.28,1:32:05.95,Default,,0,0,0,,Иә? мм... хмм...
Dialogue: 0,1:32:05.95,1:32:10.12,Default,,0,0,0,,Қаласам да орындалмайтын сияқты, сондықтан тоқтаймын.
Dialogue: 0,1:32:10.12,1:32:14.06,Default,,0,0,0,,Әй, онда мен де Рикканың тілегін жазамын!
Dialogue: 0,1:32:14.06,1:32:16.06,Default,,0,0,0,,Иә?
Dialogue: 0,1:32:16.06,1:32:18.90,Default,,0,0,0,,Қызық, тілегім жетеді ме?
Dialogue: 0,1:32:18.90,1:32:22.73,Default,,0,0,0,,Ал екі адамға жазсаңыз, тілегіңіз міндетті түрде орындалады.
Dialogue: 0,1:32:22.73,1:32:25.24,Default,,0,0,0,,Цубаса-чанға рахмет
Dialogue: 0,1:32:25.24,1:32:27.91,Default,,0,0,0,,Бірақ сезімнің өзі жеткілікті~
Dialogue: 0,1:32:27.91,1:32:33.91,Default,,0,0,0,,Ал, қараңызшы! Бұл аққан жұлдыз!
Dialogue: 0,1:32:33.91,1:32:36.58,Default,,0,0,0,,Мен тілек айтуым керек.
Dialogue: 0,1:32:36.58,1:32:40.92,Default,,0,0,0,,《Менің тілегім орындалуы мүмкін, бірақ өтінемін
Dialogue: 0,1:32:40.92,1:32:45.42,Default,,0,0,0,,Тек достарымның тілегі...》
Dialogue: 0,1:32:45.42,1:32:49.09,Default,,0,0,0,,О? Бірдеңе...
Dialogue: 0,1:32:49.09,1:32:51.10,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,1:32:51.10,1:32:53.10,Default,,0,0,0,,Ах
Dialogue: 0,1:32:53.10,1:32:56.27,Default,,0,0,0,,Цубаса-сан, саған не болды?
Dialogue: 0,1:32:56.27,1:32:59.27,Default,,0,0,0,,Әй, кенет салқындап кетті.
Dialogue: 0,1:32:59.27,1:33:03.94,Default,,0,0,0,,Бұл өте қиын! Ах...
Dialogue: 0,1:33:03.94,1:33:06.11,Default,,0,0,0,,《Менің таңдауым жоқ.》
Dialogue: 0,1:33:06.11,1:33:08.11,Default,,0,0,0,,Мынаны жинаңыз!
Dialogue: 0,1:33:08.11,1:33:10.45,Default,,0,0,0,,Ах... рахмет
Dialogue: 0,1:33:10.45,1:33:14.55,Default,,0,0,0,,Уау~ Чио-сан, сенің аяғың сондай әдемі.
Dialogue: 0,1:33:14.55,1:33:16.55,Default,,0,0,0,,Иә?
Dialogue: 0,1:33:16.55,1:33:18.72,Default,,0,0,0,,《Ал... қылыштың тыртығы жоғалып кетті! 》
Dialogue: 0,1:33:18.72,1:33:22.39,Default,,0,0,0,,《Полковниктің тілегі орындалып жатыр ма?''
Dialogue: 0,1:33:22.39,1:33:25.23,Default,,0,0,0,,Мен салмағымды жоғалтқандай сезінемін.
Dialogue: 0,1:33:25.23,1:33:28.40,Default,,0,0,0,,Мен үлкенірек нәрсені тілеуім керек еді》
Dialogue: 0,1:33:28.40,1:33:30.40,Default,,0,0,0,,＜Айтпақшы, полковник
Dialogue: 0,1:33:30.40,1:33:33.07,Default,,0,0,0,,Бұл Чиёның желке тұсына бекітілген құрылғы...>
Dialogue: 0,1:33:33.07,1:33:35.41,Default,,0,0,0,,《Мен оны жасырын ұстадым.
Dialogue: 0,1:33:35.41,1:33:37.91,Default,,0,0,0,,Әрине бұл полковниктің құпиясы》
Dialogue: 0,1:33:37.91,1:33:40.41,Default,,0,0,0,,Кума!
Dialogue: 0,1:33:40.41,1:33:42.75,Default,,0,0,0,,Гахаха!
Dialogue: 0,1:33:42.75,1:33:45.75,Default,,0,0,0,,Коомат! Аю!
Dialogue: 0,1:33:45.75,1:33:47.92,Default,,0,0,0,,О!
Dialogue: 0,1:33:47.92,1:33:50.25,Default,,0,0,0,,Маскума фильмінің шығарылымын еске алу!
Dialogue: 0,1:33:50.25,1:33:53.09,Default,,0,0,0,,Егер сіз маған нүктелері бар затты көрсетсеңіз,
Dialogue: 0,1:33:53.09,1:33:55.76,Default,,0,0,0,,Біз сізге шектеулі шығарылым бауын береміз!
Dialogue: 0,1:33:55.76,1:34:00.43,Default,,0,0,0,,《Шектеулі маска аю бауы! О... мен оны қалаймын》
Dialogue: 0,1:34:00.43,1:34:03.43,Default,,0,0,0,,Аа, кешіріңіз, менде нүктелер жоқ.
Dialogue: 0,1:34:03.43,1:34:06.27,Default,,0,0,0,,Мен де. Рикка да.
Dialogue: 0,1:34:06.27,1:34:08.27,Default,,0,0,0,,А...
Dialogue: 0,1:34:08.27,1:34:11.38,Default,,0,0,0,,Ха! Иә, дұрыс.
Dialogue: 0,1:34:11.38,1:34:13.54,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл сүйкімді
Dialogue: 0,1:34:13.54,1:34:16.05,Default,,0,0,0,,Мм, тіпті бұл...
Dialogue: 0,1:34:16.05,1:34:18.05,Default,,0,0,0,,Чио-сан!?
Dialogue: 0,1:34:18.05,1:34:21.05,Default,,0,0,0,,Да... жоқ! Бұлай істеме!
Dialogue: 0,1:34:21.05,1:34:23.22,Default,,0,0,0,,Бірақ... Бірақ бұл жалғыз жол...
Dialogue: 0,1:34:23.22,1:34:26.89,Default,,0,0,0,,Мен саған бір жерден полка нүктелері бар бірдеңе сатып аламын!
Dialogue: 0,1:34:26.89,1:34:29.39,Default,,0,0,0,,Науқан жақында аяқталады!
Dialogue: 0,1:34:29.39,1:34:31.56,Default,,0,0,0,,Эх! Мен не істеуім керек...
Dialogue: 0,1:34:31.56,1:34:33.56,Default,,0,0,0,,Уайымдамаңыз!
Dialogue: 0,1:34:33.56,1:34:35.73,Default,,0,0,0,,Рикка-чан
Dialogue: 0,1:34:35.73,1:34:38.74,Default,,0,0,0,,Шектеулі бау, өтінемін!
Dialogue: 0,1:34:38.74,1:34:41.57,Default,,0,0,0,,Енді нүктелері бар заттарды қарастырайық...
Dialogue: 0,1:34:41.57,1:34:44.41,Default,,0,0,0,,Хмф!
Dialogue: 0,1:34:44.41,1:34:46.74,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:34:46.74,1:34:49.91,Default,,0,0,0,,Мен шектеулі бауды алдым!
Dialogue: 0,1:34:49.91,1:34:51.92,Default,,0,0,0,,Уау!
Dialogue: 0,1:34:51.92,1:34:54.09,Default,,0,0,0,,Рахмет, Рикка-чан!
Dialogue: 0,1:34:54.09,1:34:56.09,Default,,0,0,0,,Сізге жақсы
Dialogue: 0,1:34:56.09,1:34:58.09,Default,,0,0,0,,《Ауыздың ішінде де》
Dialogue: 0,1:34:58.09,1:35:03.43,Default,,0,0,0,,<Бүкіл дененің шырышты қабаттары полка нүктелі үлгіге өзгерді.>
Dialogue: 0,1:35:03.43,1:35:05.43,Default,,0,0,0,,Ha
Dialogue: 0,1:35:05.43,1:35:07.43,Default,,0,0,0,,Уф
Dialogue: 0,1:35:09.43,1:35:13.10,Default,,0,0,0,,Әй, бау! Не, тастап кеттің!?
Dialogue: 0,1:35:13.10,1:35:16.61,Default,,0,0,0,,Мен... Мен бұған көмектесе алмаймын, Чио-сан.
Dialogue: 0,1:35:16.61,1:35:23.11,Default,,0,0,0,,Бәрің, мен гүл теруге барамын.
Dialogue: 0,1:35:23.11,1:35:26.12,Default,,0,0,0,,Бұл қашан болды!?
Dialogue: 0,1:35:26.12,1:35:29.45,Default,,0,0,0,,Мен сені бүгін кешірмеймін, Ханзо!
Dialogue: 0,1:35:29.45,1:35:31.46,Default,,0,0,0,,А...
Dialogue: 0,1:35:31.46,1:35:36.96,Default,,0,0,0,,Мен Чийо-санға арналған шектеулі шығарылым бауын алғым келеді.
Dialogue: 0,1:35:36.96,1:35:42.30,Default,,0,0,0,,Уау, өте қымбат бағаға сатылып жатыр. Мен оны барахолка сайтынан да сатып ала алмаймын.
Dialogue: 0,1:35:42.30,1:35:46.80,Default,,0,0,0,,Әй, бау осы жерде түсіп қалды.
Dialogue: 0,1:35:48.81,1:35:50.98,Default,,0,0,0,,<Қалай қарасаң да, бұл жалған>
Dialogue: 0,1:35:50.98,1:35:54.81,Default,,0,0,0,,《Мен де бүгін іш киімімде полька киемін.
Dialogue: 0,1:35:54.81,1:36:01.01,Default,,0,0,0,,Менің ер екенімді білсе, қиын болар еді. Бірақ...》
Dialogue: 0,1:36:02.99,1:36:06.16,Default,,0,0,0,,《Бұл бекер.》
Dialogue: 0,1:36:06.16,1:36:08.83,Default,,0,0,0,,Ах, Чио-сан
Dialogue: 0,1:36:08.83,1:36:11.93,Default,,0,0,0,,Барлығына! Мені күттің бе?
Dialogue: 0,1:36:11.93,1:36:14.10,Default,,0,0,0,,Әрине. иә?
Dialogue: 0,1:36:14.10,1:36:17.94,Default,,0,0,0,,Иә, бұл. Мен оны түсіндім. Шектеулі шығарылым бау.
Dialogue: 0,1:36:17.94,1:36:19.94,Default,,0,0,0,,Жақсы!
Dialogue: 0,1:36:19.94,1:36:23.77,Default,,0,0,0,,Хаха... Менде полка нүктелі орамал бар екенін ұмытып кетіппін.
Dialogue: 0,1:36:23.77,1:36:26.44,Default,,0,0,0,,Мен оған көрсеттім, ол маған берді.
Dialogue: 0,1:36:26.44,1:36:29.45,Default,,0,0,0,,Саған жақсы, Чио-сан.
Dialogue: 0,1:36:29.45,1:36:31.45,Default,,0,0,0,,Иә!
Dialogue: 0,1:36:31.45,1:36:33.45,Default,,0,0,0,,Олай болса, үйге қайтайық.
Dialogue: 0,1:36:33.45,1:36:35.45,Default,,0,0,0,,Мұны істейік
Dialogue: 0,1:36:39.79,1:36:42.49,Default,,0,0,0,,Уау! (жел дыбысы)
Dialogue: 0,1:36:50.47,1:36:54.47,Default,,0,0,0,,Paypropepe перпилоппе қағазы
Dialogue: 0,1:36:54.47,1:36:57.47,Default,,0,0,0,,Бело бебобабе баба
Dialogue: 0,1:40:13.44,1:40:15.44,Default,,0,0,0,,<Чиёның таңы ерте>
Dialogue: 0,1:40:18.44,1:40:21.11,Default,,0,0,0,,<Сол жақта ұйықтау
Dialogue: 0,1:40:21.11,1:40:24.95,Default,,0,0,0,,Жау шапқанда жүректі қорғау
Dialogue: 0,1:40:24.95,1:40:27.28,Default,,0,0,0,,Бұл менің ауылда болған кездегі естелік＞
Dialogue: 0,1:40:27.28,1:40:29.28,Default,,0,0,0,,Хмф!
Dialogue: 0,1:40:36.96,1:40:41.47,Default,,0,0,0,,《Чиё: Бүгін тағы да тыныш таң.》
Dialogue: 0,1:40:41.47,1:40:47.47,Default,,0,0,0,,<Чиёның таңғы тәртібі тістерін тазалаудан және шурикеннен басталады>
Dialogue: 0,1:40:57.98,1:41:00.82,Default,,0,0,0,,Сіздің әдеттегі шаш үлгісіңіз аяқталды!
Dialogue: 0,1:41:00.82,1:41:03.15,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,1:41:03.15,1:41:06.82,Default,,0,0,0,,《Мен де бүгін барамын》
Dialogue: 0,1:41:06.82,1:41:10.66,Default,,0,0,0,,< Кәдімгі бейбіт күнделікті өмір жалғасуда
Dialogue: 0,1:41:10.66,1:41:15.56,Default,,0,0,0,,Мен бұған күмәнсіз сенемін. Бұл Чио болатын.
Dialogue: 0,1:43:08.48,1:43:12.42,Default,,0,0,0,,《Барымызды салайық》
Dialogue: 0,1:43:12.42,1:43:15.92,Default,,0,0,0,,《Секине: Полковник, бәрі жақсы болып жатыр》
Dialogue: 0,1:43:15.92,1:43:17.92,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,1:43:21.43,1:43:24.60,Default,,0,0,0,,《Егер алдасаң, жасырын істе!
Dialogue: 0,1:43:24.60,1:43:27.60,Default,,0,0,0,,Концентрация концентрациясы》
Dialogue: 0,1:43:29.93,1:43:33.44,Default,,0,0,0,,《Тест кезінде ешқандай психикалық күш қолданбадым! 》
Dialogue: 0,1:43:33.44,1:43:36.94,Default,,0,0,0,,<Нақты кімге сылтау айтып отырсыз?>
Dialogue: 0,1:43:38.94,1:43:41.11,Default,,0,0,0,,Қорытынды тест қалай өтті?
Dialogue: 0,1:43:41.11,1:43:43.11,Default,,0,0,0,,Бұл өте оңай болды.
Dialogue: 0,1:43:43.11,1:43:45.12,Default,,0,0,0,,Жарайды деп ойлаймын.
Dialogue: 0,1:43:45.12,1:43:47.12,Default,,0,0,0,,Ағылшын тілі 100 ұпаймен бағаланады
Dialogue: 0,1:43:47.12,1:43:49.12,Default,,0,0,0,,98 ұпай болды.
Dialogue: 0,1:43:49.12,1:43:51.79,Default,,0,0,0,,Рикканың 51 ұпайы бар.
Dialogue: 0,1:43:51.79,1:43:55.29,Default,,0,0,0,,《Мен сонша алдап-соғып, неге бұл балл алдым? 》
Dialogue: 0,1:43:55.29,1:43:57.59,Default,,0,0,0,,Мен...
Dialogue: 0,1:44:00.46,1:44:02.97,Default,,0,0,0,,Барлығы эсселер жинағын құрастыра алды.
Dialogue: 0,1:44:02.97,1:44:05.14,Default,,0,0,0,,Оқыңыз. Иә.
Dialogue: 0,1:44:05.14,1:44:09.04,Default,,0,0,0,,Маған ойыңызды кейінірек айтыңыз. Түсінді.
Dialogue: 0,1:44:11.41,1:44:13.41,Default,,0,0,0,,Мадонна сыныбы?
Dialogue: 0,1:44:13.41,1:44:16.41,Default,,0,0,0,,Барлығы Чио-сан жасап жатыр.
Dialogue: 0,1:44:16.41,1:44:19.75,Default,,0,0,0,,Ол әдемі болғандықтан көмектесу мүмкін емес.
Dialogue: 0,1:44:19.75,1:44:21.75,Default,,0,0,0,,Мен мақтанамын~
Dialogue: 0,1:44:23.75,1:44:27.09,Default,,0,0,0,,Мен біраз уақытқа дүкен аралауға барамын.
Dialogue: 0,1:44:27.09,1:44:30.59,Default,,0,0,0,,《Мен де солаймын
Dialogue: 0,1:44:30.59,1:44:33.60,Default,,0,0,0,,Ол әдемі! 》
Dialogue: 0,1:44:33.60,1:44:35.80,Default,,0,0,0,,<Өте бақытты>
Dialogue: 0,1:44:38.27,1:44:41.10,Default,,0,0,0,,《Чиё: Қатты жаттығулармен қатар
Dialogue: 0,1:44:41.10,1:44:45.61,Default,,0,0,0,,Оны жасырын түрде қарақұйрықпен бояғандықтан ба?
Dialogue: 0,1:44:45.61,1:44:47.61,Default,,0,0,0,,Әлде…
Dialogue: 0,1:44:47.61,1:44:50.45,Default,,0,0,0,,Балшық жинағы жақсы болды ма?
Dialogue: 0,1:44:50.45,1:44:54.28,Default,,0,0,0,,Мүмкін жоғары сапалы белок шығар? 》
Dialogue: 0,1:44:54.28,1:44:58.62,Default,,0,0,0,,<Барлық органикалық және табиғи>
Dialogue: 0,1:44:58.62,1:45:01.63,Default,,0,0,0,,Хехе, жалығып бара жатырмын.
Dialogue: 0,1:45:01.63,1:45:03.63,Default,,0,0,0,,Чио-сан
Dialogue: 0,1:45:03.63,1:45:06.13,Default,,0,0,0,,Сіз аздап алданып бара жатырсыз, солай емес пе?
Dialogue: 0,1:45:06.13,1:45:09.13,Default,,0,0,0,,Мен де солай ойладым.
Dialogue: 0,1:45:09.13,1:45:11.74,Default,,0,0,0,,Жағымпаздыққа мән бермеңіз
Dialogue: 0,1:45:11.74,1:45:15.07,Default,,0,0,0,,Егер бәрі осылай жалғаса берсе, біз бірге түскі ас іше алмаймыз.
Dialogue: 0,1:45:15.07,1:45:17.07,Default,,0,0,0,,...
Dialogue: 0,1:45:17.07,1:45:19.41,Default,,0,0,0,,Қайда барсаң да, есіктен кері қайтарады.
Dialogue: 0,1:45:19.41,1:45:22.08,Default,,0,0,0,,Бұл аздап асыра сілтеу.
Dialogue: 0,1:45:22.08,1:45:24.25,Default,,0,0,0,,Ах...
Dialogue: 0,1:45:27.58,1:45:29.75,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,1:45:29.75,1:45:31.76,Default,,0,0,0,,Қайырлы таң...
Dialogue: 0,1:45:31.76,1:45:35.26,Default,,0,0,0,,Чио-сан, шаш үлгісін өзгерттің бе?
Dialogue: 0,1:45:35.26,1:45:38.10,Default,,0,0,0,,Мен жылдамдықты өзгертіп көрейін деп ойладым.
Dialogue: 0,1:45:38.10,1:45:41.77,Default,,0,0,0,,Бұл сізге өте жақсы көрінді. (Секине) Аа~
Dialogue: 0,1:45:41.77,1:45:44.60,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,1:45:44.60,1:45:48.61,Default,,0,0,0,,Әлде қысқарту керек пе?
Dialogue: 0,1:45:48.61,1:45:50.61,Default,,0,0,0,,Ах...
Dialogue: 0,1:46:00.12,1:46:03.45,Default,,0,0,0,,Чио: Мен ауылдан босап шықтым!
Dialogue: 0,1:46:03.45,1:46:07.75,Default,,0,0,0,,Шашыңыз бірте-бірте өсіп, сәнге айналсын... Уууу
Dialogue: 0,1:46:10.63,1:46:15.40,Default,,0,0,0,,Егер бәрі осылай жалғаса берсе, біз бірге түскі ас іше алмаймыз.
Dialogue: 0,1:46:15.40,1:46:17.57,Default,,0,0,0,,...
Dialogue: 0,1:46:17.57,1:46:20.47,Default,,0,0,0,,Қайда барсаң да, есіктің алдында кері қайтарады.
Dialogue: 0,1:46:23.91,1:46:26.91,Default,,0,0,0,,Бір минут күте тұрыңыз!
Dialogue: 0,1:46:26.91,1:46:31.42,Default,,0,0,0,,Оны неге кесіп тастадың!? Рикка-чан
Dialogue: 0,1:46:31.42,1:46:35.09,Default,,0,0,0,,Себебі мені ренжітті...
Dialogue: 0,1:46:35.09,1:46:37.09,Default,,0,0,0,,Ах
Dialogue: 0,1:46:37.09,1:46:39.09,Default,,0,0,0,,Сәлем, Рикка-чан?
Dialogue: 0,1:46:39.09,1:46:42.26,Default,,0,0,0,,Екеуің де ең жамансыңдар! (2 адам) Иә?
Dialogue: 0,1:46:42.26,1:46:46.46,Default,,0,0,0,,Қанша... Чиё қанша...
Dialogue: 0,1:46:50.27,1:46:54.60,Default,,0,0,0,,Өйткені қорытынды емтихан ең нашар!
Dialogue: 0,1:46:54.60,1:46:56.77,Default,,0,0,0,,Иә?
Dialogue: 0,1:46:56.77,1:47:00.44,Default,,0,0,0,,Саған әділдік жетіспейді!
Dialogue: 0,1:47:00.44,1:47:03.11,Default,,0,0,0,,Шынымен. Кешіріңіз.
Dialogue: 0,1:47:03.11,1:47:05.12,Default,,0,0,0,,Бұл ел бітті ғой, иә?
Dialogue: 0,1:47:05.12,1:47:07.28,Default,,0,0,0,,<Мынау мынау>
Dialogue: 0,1:47:07.28,1:47:12.72,Default,,0,0,0,,Чио: Мен біраз уақытқа дүкен аралауға барамын.
Dialogue: 0,1:47:12.72,1:47:14.73,Default,,0,0,0,,Уф
Dialogue: 0,1:47:14.73,1:47:18.56,Default,,0,0,0,,Не болды? Бұл тіпті мәтіндер жинағы емес.
Dialogue: 0,1:47:18.56,1:47:21.23,Default,,0,0,0,,Чионың қорытынды емтиханы
Dialogue: 0,1:47:21.23,1:47:24.43,Default,,0,0,0,,Ммм
Dialogue: 0,1:47:26.40,1:47:28.90,Default,,0,0,0,,《Телендіргіш》
Dialogue: 0,1:47:42.42,1:47:44.72,Default,,0,0,0,,Гений!
Dialogue: 0,1:47:47.92,1:47:50.43,Default,,0,0,0,,Мен бірінші рет ұпай алдым!
Dialogue: 0,1:47:50.43,1:47:52.43,Default,,0,0,0,,Қандай үлкен жетістік!
Dialogue: 0,1:47:52.43,1:47:55.10,Default,,0,0,0,,Жағымпаздыққа мән бермеңіз
Dialogue: 0,1:47:55.10,1:47:58.77,Default,,0,0,0,,Егер бәрі осылай жалғаса берсе, біз бірге түскі ас іше алмаймыз.
Dialogue: 0,1:47:58.77,1:48:02.44,Default,,0,0,0,,Ендеше, қайда барсаң да, есік алдынан кері қайтарылады.
Dialogue: 0,1:48:02.44,1:48:05.11,Default,,0,0,0,,Бұл аздап асыра сілтеу.
Dialogue: 0,1:48:05.11,1:48:09.78,Default,,0,0,0,,Менің мектебімде оқуға түсу өте қиын.
Dialogue: 0,1:48:09.78,1:48:13.78,Default,,0,0,0,,Осылай жалғаса берсе, жоғары оқу орындарына бірге түсу мүмкін емес.
Dialogue: 0,1:48:17.05,1:48:19.89,Default,,0,0,0,,Бұл қорытынды емтихан туралы болды.
Dialogue: 0,1:48:19.89,1:48:24.23,Default,,0,0,0,,Бірақ сіз шашыңызды да қиюыңыз керек дедіңіз...
Dialogue: 0,1:48:24.23,1:48:26.56,Default,,0,0,0,,Уақыт аса маңызды.
Dialogue: 0,1:48:26.56,1:48:29.73,Default,,0,0,0,,《Себебі шаш үлгісіне мән бересің! 》
Dialogue: 0,1:48:29.73,1:48:33.74,Default,,0,0,0,,Чиё: Алдымен шашыңды жу, сосын емде.
Dialogue: 0,1:48:33.74,1:48:36.41,Default,,0,0,0,,Түзу үтікпен түзетілгеннен кейін
Dialogue: 0,1:48:36.41,1:48:40.74,Default,,0,0,0,,Бос толқындар жасау үшін бұйралағыш үтікті пайдаланыңыз және бұл аяқталды!
Dialogue: 0,1:48:40.74,1:48:43.08,Default,,0,0,0,,《Чио-сан, меніңше
Dialogue: 0,1:48:43.08,1:48:46.42,Default,,0,0,0,,Сіз бүкіл процеске бір сағаттай уақыт кетеді дедіңіз.
Dialogue: 0,1:48:46.42,1:48:49.75,Default,,0,0,0,,Осы уақыт ішінде кем дегенде бір ағылшын сөзін үйреніңіз! 》
Dialogue: 0,1:48:49.75,1:48:52.42,Default,,0,0,0,,Уф
Dialogue: 0,1:48:52.42,1:48:56.59,Default,,0,0,0,,Артыңнан жасырын айтқаным үшін кешірім сұраймын.
Dialogue: 0,1:48:56.59,1:49:00.93,Default,,0,0,0,,Бірақ біз Чио-санмен бірге келесі сыныпқа өткіміз келеді!
Dialogue: 0,1:49:00.93,1:49:02.93,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,1:49:02.93,1:49:07.94,Default,,0,0,0,,О, бұл жақсы!
Dialogue: 0,1:49:07.94,1:49:11.11,Default,,0,0,0,,《Секине: Ештеңе жақсы емес!?》 《Цубаса: Жақсысың ба, балақай!?》
Dialogue: 0,1:49:11.11,1:49:13.71,Default,,0,0,0,,Мен мұны енді жасырмаймын, сондықтан дағдарысты сезініңіз!
Dialogue: 0,1:49:13.71,1:49:15.71,Default,,0,0,0,,Бұл өте қауіпті!
Dialogue: 0,1:49:15.71,1:49:18.55,Default,,0,0,0,,Уайымдамаңыз.
Dialogue: 0,1:49:18.55,1:49:23.72,Default,,0,0,0,,Профессор Брайан да Токио университетіне түсетінімді айтты.
Dialogue: 0,1:49:23.72,1:49:26.56,Default,,0,0,0,,Сіз қолыңыздан келгеннің бәрін жасадыңыз, Чио ханым.
Dialogue: 0,1:49:26.56,1:49:29.23,Default,,0,0,0,,Мен Токио университетінің болашақ студентімін.
Dialogue: 0,1:49:29.23,1:49:31.43,Default,,0,0,0,,《2 адам: Сондықтан оны байыппен қабылдамаңыз! 》
Dialogue: 0,1:49:35.73,1:49:37.73,Default,,0,0,0,,Сонда ше? Сіз оқуыңызда алға жылжып жатырсыз ба?
Dialogue: 0,1:49:37.73,1:49:39.74,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасаймын.
Dialogue: 0,1:49:39.74,1:49:43.24,Default,,0,0,0,,Әзірше бір оқулықты жаттап алдым.
Dialogue: 0,1:49:43.24,1:49:46.41,Default,,0,0,0,,《Ақымақтардың жиі жасайтын зерттеу әдісі! 》
Dialogue: 0,1:49:46.41,1:49:49.91,Default,,0,0,0,,жаттамаңыз! Түсініңіз! Цубаса тынышталсын!
Dialogue: 0,1:49:49.91,1:49:53.08,Default,,0,0,0,,Сіз мұнымен жоғарылату емтиханынан өте аласыз.
Dialogue: 0,1:49:53.08,1:49:55.59,Default,,0,0,0,,Мені тыңдаңыз. (2 адам) Әй?
Dialogue: 0,1:49:55.59,1:50:01.59,Default,,0,0,0,,Бұл оқулықты редакциялау кезінде мен ерекше назар аудардым
Dialogue: 0,1:50:01.59,1:50:04.43,Default,,0,0,0,,Сіз орта мектептің екінші курсына түсіп жатырсыз.
Dialogue: 0,1:50:04.43,1:50:06.43,Default,,0,0,0,,Көңілді және қызықты... (Цубаса) Алғы сөз!
Dialogue: 0,1:50:06.43,1:50:08.43,Default,,0,0,0,,Керемет! Бұл керемет!
Dialogue: 0,1:50:08.43,1:50:10.43,Default,,0,0,0,,Сұрақтар т.б.
Dialogue: 0,1:50:10.43,1:50:13.27,Default,,0,0,0,,Тапқыр құрылымы бар...
Dialogue: 0,1:50:13.27,1:50:16.27,Default,,0,0,0,,<Чио мақтауды күтуде>
Dialogue: 0,1:50:25.45,1:50:28.95,Default,,0,0,0,,Жазғы демалыс жақындап қалды. Мен сондай қуаныштымын.
Dialogue: 0,1:50:28.95,1:50:31.62,Default,,0,0,0,,Бәріміз бір жерге шығамыз ба?
Dialogue: 0,1:50:31.62,1:50:34.79,Default,,0,0,0,,Кеттік, кеттік! Қайда бара жатырсың?
Dialogue: 0,1:50:34.79,1:50:37.29,Default,,0,0,0,,Ум, теңіз?
Dialogue: 0,1:50:37.29,1:50:39.80,Default,,0,0,0,,Теңіз! Бұл керемет
Dialogue: 0,1:50:39.80,1:50:42.97,Default,,0,0,0,,Сіз купальник әкелгіңіз келе ме? Соны істейік
Dialogue: 0,1:50:42.97,1:50:47.14,Default,,0,0,0,,《Шууға арналған костюм? Мен көп нәрсені жасыруым керек.
Dialogue: 0,1:50:47.14,1:50:49.14,Default,,0,0,0,,Шынымды айтсам, бұл қиын》
Dialogue: 0,1:50:49.14,1:50:53.64,Default,,0,0,0,,Әй, теңіздің орнына тауға немесе өзенге баруға болады...
Dialogue: 0,1:50:53.64,1:50:57.48,Default,,0,0,0,,Мен жағадағы толқынмен ойнағым келеді!
Dialogue: 0,1:50:57.48,1:50:59.98,Default,,0,0,0,,Жағажайдағы үйде дәмді тамақ ішейік!
Dialogue: 0,1:50:59.98,1:51:02.99,Default,,0,0,0,,Аңшылық және балық аулау да!
Dialogue: 0,1:51:02.99,1:51:05.99,Default,,0,0,0,,《Шешім теңізде қабылданады.
Dialogue: 0,1:51:05.99,1:51:08.79,Default,,0,0,0,,Мен бұл қалай болады деп ойлаймын》
Dialogue: 0,1:51:10.83,1:51:13.10,Default,,0,0,0,,Жаз келді! (Чиё) Бұл теңіз!
Dialogue: 0,1:51:13.10,1:51:15.43,Default,,0,0,0,,Догеза!
Dialogue: 0,1:51:15.43,1:51:18.73,Default,,0,0,0,,<Оқиға бірнеше минутқа созылады>
Dialogue: 0,1:51:26.61,1:51:29.61,Default,,0,0,0,,Біз мұны істейміз бе? Иә
Dialogue: 0,1:51:29.61,1:51:32.01,Default,,0,0,0,,Маған сусын сатып ал
Dialogue: 0,1:51:36.95,1:51:38.96,Default,,0,0,0,,《Секине: Ойой》
Dialogue: 0,1:51:38.96,1:51:42.29,Default,,0,0,0,,Жүр, жүзейік~ Иә.
Dialogue: 0,1:51:42.29,1:51:44.29,Default,,0,0,0,,《Тезірек киіміңді ауыстыр! 》
Dialogue: 0,1:51:44.29,1:51:46.30,Default,,0,0,0,,Енді, Секине мырза да.
Dialogue: 0,1:51:46.30,1:51:48.30,Default,,0,0,0,,Иә
Dialogue: 0,1:51:51.47,1:51:54.97,Default,,0,0,0,,Умм, Чио-сан жасаған купальник.
Dialogue: 0,1:51:54.97,1:51:56.97,Default,,0,0,0,,Мен оны киіп көрдім.
Dialogue: 0,1:51:56.97,1:51:59.14,Default,,0,0,0,,Бұл сізге өте жарасады!
Dialogue: 0,1:51:59.14,1:52:01.81,Default,,0,0,0,,Тез жүзейік! Ах Рика
Dialogue: 0,1:52:01.81,1:52:04.98,Default,,0,0,0,,Бір минут күтіңіз. Гах!
Dialogue: 0,1:52:04.98,1:52:07.15,Default,,0,0,0,,Күннен қорғайтын крем жаққаннан кейін ғана ойнаңыз
Dialogue: 0,1:52:07.15,1:52:09.15,Default,,0,0,0,,Бұл жақсы. Ха ха...
Dialogue: 0,1:52:09.15,1:52:11.59,Default,,0,0,0,,Мен оны Секине-чанға да қолданамын.
Dialogue: 0,1:52:11.59,1:52:13.59,Default,,0,0,0,,Өтінемін
Dialogue: 0,1:52:13.59,1:52:17.93,Default,,0,0,0,,《Неге ғарышта жұмыс істеуге мүмкіндік бермеске?》
Dialogue: 0,1:52:17.93,1:52:20.23,Default,,0,0,0,,《Иә? Полковник, не? 》
Dialogue: 0,1:52:31.11,1:52:33.11,Default,,0,0,0,,Иә?
Dialogue: 0,1:52:39.45,1:52:43.62,Default,,0,0,0,,Баб буруруруру…
Dialogue: 0,1:52:43.62,1:52:46.12,Default,,0,0,0,,Эй...｡ Эй, эй
Dialogue: 0,1:52:46.12,1:52:49.46,Default,,0,0,0,,Мына қыз. Онымен ойнағың келе ме?
Dialogue: 0,1:52:49.46,1:52:51.46,Default,,0,0,0,,А...
Dialogue: 0,1:52:51.46,1:52:55.30,Default,,0,0,0,,Әй, біраз сөйлесейік.
Dialogue: 0,1:52:55.30,1:52:57.30,Default,,0,0,0,,Әй?
Dialogue: 0,1:53:04.31,1:53:06.98,Default,,0,0,0,,Уф!
Dialogue: 0,1:53:06.98,1:53:09.98,Default,,0,0,0,,Арх! Гухе!
Dialogue: 0,1:53:09.98,1:53:11.92,Default,,0,0,0,,Ах!
Dialogue: 0,1:53:11.92,1:53:14.25,Default,,0,0,0,,<Және осы уақытқа дейін>
Dialogue: 0,1:53:14.25,1:53:17.09,Default,,0,0,0,,Өйткені ол қазіргі уақытта шабуыл жасаған қылмыскер!
Dialogue: 0,1:53:17.09,1:53:20.59,Default,,0,0,0,,Егер кешірім сұрай алсаңыз, бізге полицияның қажеті жоқ.
Dialogue: 0,1:53:20.59,1:53:22.93,Default,,0,0,0,,《Kugo most! 》
Dialogue: 0,1:53:22.93,1:53:27.60,Default,,0,0,0,,Зақым туралы есеп беруден бас тарта аласыз ба?
Dialogue: 0,1:53:27.60,1:53:29.77,Default,,0,0,0,,Қандай есеп айырысу...
Dialogue: 0,1:53:29.77,1:53:33.10,Default,,0,0,0,,Есеп айырысу дегеніміз не? Жанашырлық ақша туралы!
Dialogue: 0,1:53:33.10,1:53:35.77,Default,,0,0,0,,Сізге полицияның барғаны жақсы!
Dialogue: 0,1:53:35.77,1:53:39.61,Default,,0,0,0,,《Бұл маңызды ақша, бірақ Чио-сан үшін》
Dialogue: 0,1:53:39.61,1:53:42.95,Default,,0,0,0,,Мұның бәрі менің мүлкім.
Dialogue: 0,1:53:42.95,1:53:45.12,Default,,0,0,0,,бастап... 230 иен
Dialogue: 0,1:53:45.12,1:53:47.45,Default,,0,0,0,,Менде тек автобустың ақысы бар.
Dialogue: 0,1:53:47.45,1:53:52.55,Default,,0,0,0,,Секине мырза, қойыңызшы. Жарайды.
Dialogue: 0,1:53:54.62,1:53:58.29,Default,,0,0,0,,Мен дәл осы жерде өзімді өлтіремін!
Dialogue: 0,1:53:58.29,1:54:00.30,Default,,0,0,0,,<Өзін-өзі өлтіру жазасы>
Dialogue: 0,1:54:00.30,1:54:02.47,Default,,0,0,0,,Бұл жақсы емес! Асықпаңыз!
Dialogue: 0,1:54:02.47,1:54:06.30,Default,,0,0,0,,Бірақ... (Цубаса) Бір минут күте тұрыңыз!
Dialogue: 0,1:54:06.30,1:54:08.97,Default,,0,0,0,,Досыңа бірдеңе керек пе?
Dialogue: 0,1:54:08.97,1:54:12.91,Default,,0,0,0,,Сіз қандайсыз! Біз құрбандармыз!
Dialogue: 0,1:54:12.91,1:54:15.75,Default,,0,0,0,,Жәбірленуші? Аа сол
Dialogue: 0,1:54:15.75,1:54:18.41,Default,,0,0,0,,Екеуіңді жұдырықпен ұрдым...
Dialogue: 0,1:54:18.41,1:54:21.58,Default,,0,0,0,,Бұл тонна емес. Чудон! болып табылады!
Dialogue: 0,1:54:21.58,1:54:23.59,Default,,0,0,0,,Дәлелдер де бар~
Dialogue: 0,1:54:23.59,1:54:26.59,Default,,0,0,0,,Міне! Бұл орындалды
Dialogue: 0,1:54:26.59,1:54:29.43,Default,,0,0,0,,< Чудон >
Dialogue: 0,1:54:29.43,1:54:32.76,Default,,0,0,0,,Хмф! Қандай бұлшықет горилла
Dialogue: 0,1:54:32.76,1:54:35.10,Default,,0,0,0,,Шынайы өмірде мұны істеу мүмкін емес!
Dialogue: 0,1:54:35.10,1:54:37.10,Default,,0,0,0,,Бұлшық етті горилла
Dialogue: 0,1:54:37.10,1:54:40.27,Default,,0,0,0,,Бір жерде көрінгеніңіз маңызды емес.
Dialogue: 0,1:54:40.27,1:54:42.27,Default,,0,0,0,,《Бұл жаман》
Dialogue: 0,1:54:42.27,1:54:45.78,Default,,0,0,0,,Қанаттар! Мен мұны өтірік стратегиясы арқылы жеңемін.
Dialogue: 0,1:54:45.78,1:54:48.28,Default,,0,0,0,,Иә?
Dialogue: 0,1:54:48.28,1:54:53.95,Default,,0,0,0,,Кешіріңіз, мен қорқамын.
Dialogue: 0,1:54:53.95,1:54:58.79,Default,,0,0,0,,Үлкен ағалар қорқынышты~
Dialogue: 0,1:54:58.79,1:55:02.46,Default,,0,0,0,,Ууууууууууу...
Dialogue: 0,1:55:02.46,1:55:04.46,Default,,0,0,0,,<Шынымен жылап отыр>
Dialogue: 0,1:55:04.46,1:55:06.46,Default,,0,0,0,,Жылама
Dialogue: 0,1:55:06.46,1:55:08.97,Default,,0,0,0,,Қылмыскер өзіміз сияқтымыз.
Dialogue: 0,1:55:08.97,1:55:11.97,Default,,0,0,0,,《Цубаса: Иә!? Мен де? 》
Dialogue: 0,1:55:15.74,1:55:19.41,Default,,0,0,0,,Мен көмектесе алмадым ...
Dialogue: 0,1:55:19.41,1:55:23.51,Default,,0,0,0,,<Қорлыққа көп шыдайтын қанаттар>
Dialogue: 0,1:55:25.75,1:55:30.75,Default,,0,0,0,,Баршаңыз, мен өз кінәм үшін кешіріңіздер!
Dialogue: 0,1:55:30.75,1:55:33.59,Default,,0,0,0,,Сіздің қауіпсіз болғаныңызға қуаныштымын.
Dialogue: 0,1:55:33.59,1:55:37.09,Default,,0,0,0,,《Бүкіл активтеріңіз сізде болғаны рас па?
Dialogue: 0,1:55:37.09,1:55:39.10,Default,,0,0,0,,Оқиға өтетін орынға кірудің ешқандай жолы жоқ…
Dialogue: 0,1:55:39.10,1:55:44.10,Default,,0,0,0,,Жүр, дәмді нәрсе жеп ал, бұрын болған оқиғаны ұмыт!
Dialogue: 0,1:55:44.10,1:55:48.30,Default,,0,0,0,,О~｡ Рикка: Мен мұны білмей тұрып...
Dialogue: 0,1:55:57.28,1:56:00.28,Default,,0,0,0,,Ха, дәмді болды~
Dialogue: 0,1:56:00.28,1:56:03.62,Default,,0,0,0,,Иә? Қазір ойлап қарасам, тамақтың құны...
Dialogue: 0,1:56:03.62,1:56:06.46,Default,,0,0,0,,Жарайды! Ақша болса...
Dialogue: 0,1:56:06.46,1:56:09.63,Default,,0,0,0,,Мұнда тағы да бар!
Dialogue: 0,1:56:09.63,1:56:13.06,Default,,0,0,0,,Ол ақшаға не болды!? Құлап жатты!
Dialogue: 0,1:56:13.06,1:56:15.40,Default,,0,0,0,,Сіз құлап қалдыңыз ба? Сонша ақша?
Dialogue: 0,1:56:15.40,1:56:18.40,Default,,0,0,0,,Бұл оқиға болуы керек...
Dialogue: 0,1:56:20.40,1:56:23.24,Default,,0,0,0,,《Табиғи емес... Бұл болды ма? 》
Dialogue: 0,1:56:23.24,1:56:26.08,Default,,0,0,0,,Полковник, оның жалған екеніне сене алар емеспін...
Dialogue: 0,1:56:26.08,1:56:32.42,Default,,0,0,0,,Бұл қазір...
Dialogue: 0,1:56:32.42,1:56:34.58,Default,,0,0,0,,Бұл гиперинфляция дәуірі емес пе?
Dialogue: 0,1:56:34.58,1:56:37.25,Default,,0,0,0,,Ақша тек макулатура!
Dialogue: 0,1:56:37.25,1:56:39.26,Default,,0,0,0,,<Jab-Jab>
Dialogue: 0,1:56:39.26,1:56:42.59,Default,,0,0,0,,Қанаттар! Рикканың айтқысы келетіні
Dialogue: 0,1:56:42.59,1:56:44.93,Default,,0,0,0,,Мм...
Dialogue: 0,1:56:44.93,1:56:47.43,Default,,0,0,0,,Бұл шынымен құлаған сияқты емес.
Dialogue: 0,1:56:47.43,1:56:50.27,Default,,0,0,0,,Сөреден жабысқақ күріш түсіп кеткендей.
Dialogue: 0,1:56:50.27,1:56:52.27,Default,,0,0,0,,Қалтадағы ақшаны білдіреді.
Dialogue: 0,1:56:52.27,1:56:55.44,Default,,0,0,0,,Солай ма? Бұл дегенді білдіреді.
Dialogue: 0,1:56:55.44,1:56:58.94,Default,,0,0,0,,《Фуу, бірақ бұл жалған...
Dialogue: 0,1:56:58.94,1:57:02.61,Default,,0,0,0,,Одан әрі пайдалансаңыз, жаман болады. Мен оны кейін тастауым керек》
Dialogue: 0,1:57:02.61,1:57:05.28,Default,,0,0,0,,<Заңға бағыну рухы маңызды>
Dialogue: 0,1:57:05.28,1:57:07.95,Default,,0,0,0,,《Қанша тәрелке якисоба алуға болады? 》
Dialogue: 0,1:57:07.95,1:57:10.45,Default,,0,0,0,,<Заңға бағыну рухы қайда>
Dialogue: 0,1:57:10.45,1:57:12.56,Default,,0,0,0,,《Зорлық-зомбылықтың үстіне
Dialogue: 0,1:57:12.56,1:57:16.06,Default,,0,0,0,,Мен тіпті Рикка-чанға қалтасының ақшасын жұмсауға рұқсат бердім.
Dialogue: 0,1:57:16.06,1:57:18.06,Default,,0,0,0,,Кешіріңіз》
Dialogue: 0,1:57:18.06,1:57:20.56,Default,,0,0,0,,Мен гүл теруге барамын.
Dialogue: 0,1:57:20.56,1:57:24.07,Default,,0,0,0,,Иә?
Dialogue: 0,1:57:24.07,1:57:27.27,Default,,0,0,0,,Чио-сан? Мен оның қалай болатынын көремін
Dialogue: 0,1:57:32.41,1:57:34.91,Default,,0,0,0,,Эй, сәлем. иә?
Dialogue: 0,1:57:34.91,1:57:38.58,Default,,0,0,0,,Балалар сендер бұрын пикаппен төбелестіңдер ғой, солай ма?
Dialogue: 0,1:57:38.58,1:57:40.58,Default,,0,0,0,,Иә?
Dialogue: 0,1:57:40.58,1:57:45.42,Default,,0,0,0,,Олар мені шақырғанда мен де жеңілдеп қалдым!
Dialogue: 0,1:57:45.42,1:57:48.26,Default,,0,0,0,,Ұзын қара шашты қыз да керемет болды~
Dialogue: 0,1:57:48.26,1:57:50.59,Default,,0,0,0,,Ол өзін жас ханым сияқты сезінеді.
Dialogue: 0,1:57:50.59,1:57:53.76,Default,,0,0,0,,Не? Сіз...
Dialogue: 0,1:57:53.76,1:57:56.43,Default,,0,0,0,,Қандай әдемі бала!
Dialogue: 0,1:57:56.43,1:57:58.77,Default,,0,0,0,,Әдемі бала...?
Dialogue: 0,1:57:58.77,1:58:00.94,Default,,0,0,0,,Иә?
Dialogue: 0,1:58:00.94,1:58:04.77,Default,,0,0,0,,Сіз әдемі балаға ұқсайсыз ба?
Dialogue: 0,1:58:04.77,1:58:06.94,Default,,0,0,0,,<Қуанғаным үшін жыладым>
Dialogue: 0,1:58:06.94,1:58:08.94,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,1:58:14.88,1:58:16.88,Default,,0,0,0,,Чио-сан
Dialogue: 0,1:58:26.23,1:58:29.23,Default,,0,0,0,,Сізге көп рахмет! сурет?
Dialogue: 0,1:58:29.23,1:58:31.23,Default,,0,0,0,,Уууу Чио-санға рахмет
Dialogue: 0,1:58:31.23,1:58:33.93,Default,,0,0,0,,Менде керемет естеліктер болды!
Dialogue: 0,1:58:35.91,1:58:40.74,Default,,0,0,0,,Мына түріммен жағаға тағы келгім келеді.
Dialogue: 0,1:58:40.74,1:58:42.74,Default,,0,0,0,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,1:58:45.75,1:58:47.75,Default,,0,0,0,,Иә
Dialogue: 0,1:58:49.75,1:58:52.92,Default,,0,0,0,,Сегізаяқ Сегізаяқ Сегізаяқ Татако
Dialogue: 0,1:58:52.92,1:58:57.59,Default,,0,0,0,,Сонымен... сен не ойнайсың?
Dialogue: 0,1:58:57.59,1:59:00.10,Default,,0,0,0,,Барлығымыз құмнан бірдеңе жасайық!
Dialogue: 0,1:59:00.10,1:59:02.43,Default,,0,0,0,,Сіз нені қалайсыз?
Dialogue: 0,1:59:02.43,1:59:04.43,Default,,0,0,0,,Міне!
Dialogue: 0,1:59:04.43,1:59:07.94,Default,,0,0,0,,Асығыңыз! Фухи~
Dialogue: 0,1:59:07.94,1:59:10.94,Default,,0,0,0,,Толқындар! Бұл қиын!
Dialogue: 0,1:59:10.94,1:59:14.71,Default,,0,0,0,,Барлық жолдастарға хабарландыру! Флагманды дереу қорғаңыз!
Dialogue: 0,1:59:14.71,1:59:17.21,Default,,0,0,0,,Раджа!
Dialogue: 0,1:59:17.21,1:59:19.88,Default,,0,0,0,,Hmph. (толқындардың дыбысы)
Dialogue: 0,1:59:19.88,1:59:23.72,Default,,0,0,0,,Пепе Пепе…
Dialogue: 0,1:59:23.72,1:59:26.89,Default,,0,0,0,,Сәтті қорғаныс! Жарайсыңдар балалар
Dialogue: 0,1:59:26.89,1:59:30.73,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,1:59:30.73,1:59:58.25,Default,,0,0,0,,～
Dialogue: 0,1:59:58.25,2:00:00.76,Default,,0,0,0,,Сіз ештеңе ұмыттыңыз ба?
Dialogue: 0,2:00:00.76,2:00:04.26,Default,,0,0,0,,Әй, бұрынғы бала! Күте тұрыңыз!
Dialogue: 0,2:00:04.26,2:00:07.26,Default,,0,0,0,,Мен сені іздегенім жақсы болды.
Dialogue: 0,2:00:07.26,2:00:09.27,Default,,0,0,0,,《Сіз оны іздедіңіз бе? 》
Dialogue: 0,2:00:09.27,2:00:11.60,Default,,0,0,0,,Негізі бұл туралы көптен бері ойланып жүрмін.
Dialogue: 0,2:00:11.60,2:00:13.60,Default,,0,0,0,,《Сізді қызықтырды ма!?》
Dialogue: 0,2:00:13.60,2:00:17.44,Default,,0,0,0,,Ертерек сені әдемі бала деп атағаным үшін кешір.
Dialogue: 0,2:00:17.44,2:00:21.28,Default,,0,0,0,,Сізде андрогендік сүйкімділік бар.
Dialogue: 0,2:00:21.28,2:00:25.28,Default,,0,0,0,,Ол шынымен де әдемі қыз!
Dialogue: 0,2:00:25.28,2:00:28.95,Default,,0,0,0,,Оның терісі ақшыл және жұқа сызықтары бар.
Dialogue: 0,2:00:28.95,2:00:31.45,Default,,0,0,0,,<Мен жаңа ғана соңғы соққыны беруге келдім>
Dialogue: 0,2:00:33.46,2:00:37.63,Default,,0,0,0,,Теңіз Бұл көңілді болды! Дүкендер де дәмді болды.
Dialogue: 0,2:00:37.63,2:00:40.13,Default,,0,0,0,,Цубаса-сан, не болды?
Dialogue: 0,2:00:40.13,2:00:42.47,Default,,0,0,0,,Кенет қараңғы түсті.
Dialogue: 0,2:00:42.47,2:00:44.47,Default,,0,0,0,,Иә, иә, түсінемін!
Dialogue: 0,2:00:44.47,2:00:47.14,Default,,0,0,0,,Мен өте көңілді болдым, үйге барғым келмеді!
Dialogue: 0,2:00:47.14,2:00:49.47,Default,,0,0,0,,Бәріміз тағы келейік.
Dialogue: 0,2:00:49.47,2:00:51.47,Default,,0,0,0,,Иә
Dialogue: 0,2:01:03.99,2:01:07.99,Default,,0,0,0,,Маған өзінің сүйкімді түрін көрсеткен Ухотанға.
Dialogue: 0,2:01:07.99,2:01:10.49,Default,,0,0,0,,Клиенттер қатты қуанды!
Dialogue: 0,2:01:10.49,2:01:13.93,Default,,0,0,0,,Алайда, ол жерде үлкен оқиға бар.
Dialogue: 0,2:01:13.93,2:01:17.93,Default,,0,0,0,,Ухотанның алғаны дәу тезек болды.
Dialogue: 0,2:01:17.93,2:01:21.44,Default,,0,0,0,,《Оны қалай жою керек?》
Dialogue: 0,2:01:21.44,2:01:23.94,Default,,0,0,0,,Я...
Dialogue: 0,2:01:23.94,2:01:25.94,Default,,0,0,0,,Келесі жаңалықтар
Dialogue: 0,2:01:25.94,2:01:31.45,Default,,0,0,0,,Чиба префектурасындағы жағажай үйлерінде жалған купюралар келтірген зиян туралы бірнеше хабарламалар болды.
Dialogue: 0,2:01:31.45,2:01:34.78,Default,,0,0,0,,Жалған ақша өте күрделі болғанымен,
Dialogue: 0,2:01:34.78,2:01:37.79,Default,,0,0,0,,Су таңбасында кім екені белгісіз адам бар.
Dialogue: 0,2:01:37.79,2:01:39.79,Default,,0,0,0,,Полицияда...
Dialogue: 0,2:01:39.79,2:01:44.49,Default,,0,0,0,,Бұл Рикка планетасының ұлы көшбасшысы!
Dialogue: 0,2:05:13.44,2:05:15.44,Default,,0,0,0,,Бұл шындық па?
Dialogue: 0,2:05:15.44,2:05:17.77,Default,,0,0,0,,Мен ақырында
Dialogue: 0,2:05:17.77,2:05:20.44,Default,,0,0,0,,Секине мырзаның үйінде
Dialogue: 0,2:05:20.44,2:05:22.95,Default,,0,0,0,,Сізді шақырды!
Dialogue: 0,2:05:22.95,2:05:25.78,Default,,0,0,0,,Құттықтаймыз аю! Құттықтаймыз аю!
Dialogue: 0,2:05:25.78,2:05:28.78,Default,,0,0,0,,Уау. Кумар
Dialogue: 0,2:05:28.78,2:05:30.78,Default,,0,0,0,,Уфуфуфуфу Ахахахха. Кумакума
Dialogue: 0,2:05:32.79,2:05:34.79,Default,,0,0,0,,< Түнеу
Dialogue: 0,2:05:34.79,2:05:39.49,Default,,0,0,0,,Бұл Чиё аңсаған оқиға>
Dialogue: 0,2:07:19.43,2:07:21.43,Default,,0,0,0,,《Секине: Аа...
Dialogue: 0,2:07:21.43,2:07:25.43,Default,,0,0,0,,Шынымды айтсам, үйіме адам шақырғым келмеді.
Dialogue: 0,2:07:25.43,2:07:27.77,Default,,0,0,0,,Бірақ амал жоқ.》 Хаа~ Уфуфуфу
Dialogue: 0,2:07:27.77,2:07:31.44,Default,,0,0,0,,<Бірнеше сағат бұрын>
Dialogue: 0,2:07:31.44,2:07:34.28,Default,,0,0,0,,Уау~ Тайфун қорқынышты.
Dialogue: 0,2:07:34.28,2:07:36.78,Default,,0,0,0,,Бұл ең үлкені сияқты.
Dialogue: 0,2:07:36.78,2:07:39.95,Default,,0,0,0,,Мен бүгін түнде ағашта ұйықтай алмаймын.
Dialogue: 0,2:07:39.95,2:07:42.28,Default,,0,0,0,,Сіз таңдағаныңызды жей алмайсыз.
Dialogue: 0,2:07:42.28,2:07:46.12,Default,,0,0,0,,《Мм? Ағаш үй? Үй бақшасы? 》
Dialogue: 0,2:07:46.12,2:07:49.46,Default,,0,0,0,,Уфуфуфуфу, жігіт!
Dialogue: 0,2:07:49.46,2:07:54.80,Default,,0,0,0,,Біз Чийо-самаға тек органикалық өсіруді ұсынамыз.
Dialogue: 0,2:07:54.80,2:07:56.97,Default,,0,0,0,,Байлар ғажап.
Dialogue: 0,2:07:56.97,2:08:03.14,Default,,0,0,0,,＜Бірақ шындық бұл жай ғана лагерь және жабайы шөп＞
Dialogue: 0,2:08:03.14,2:08:08.48,Default,,0,0,0,,《Сіз осы тайфунның ортасында лагерь құруды жоспарлап отырсыз ба?》
Dialogue: 0,2:08:08.48,2:08:15.75,Default,,0,0,0,,Қатты жел. Бүгін күзетпен жүреміз бе?
Dialogue: 0,2:08:15.75,2:08:17.75,Default,,0,0,0,,Чио-сан! иә?
Dialogue: 0,2:08:17.75,2:08:21.26,Default,,0,0,0,,Ах...
Dialogue: 0,2:08:21.26,2:08:27.43,Default,,0,0,0,,Менің ата-анам бүгін үйде жоқ.
Dialogue: 0,2:08:27.43,2:08:31.27,Default,,0,0,0,,Мен жалғыз қалғанда мазасызданамын.
Dialogue: 0,2:08:31.27,2:08:34.27,Default,,0,0,0,,Мен бұны күтпедім...
Dialogue: 0,2:08:34.27,2:08:36.77,Default,,0,0,0,,Егер сіз менімен бірге болсаңыз
Dialogue: 0,2:08:36.77,2:08:39.61,Default,,0,0,0,,Мен қуаныштымын
Dialogue: 0,2:08:39.61,2:08:41.94,Default,,0,0,0,,Ах
Dialogue: 0,2:08:41.94,2:08:43.95,Default,,0,0,0,,Менің барғым келеді!
Dialogue: 0,2:08:43.95,2:08:47.28,Default,,0,0,0,,Мен! Секине мырзаның үйінде!
Dialogue: 0,2:08:47.28,2:08:50.28,Default,,0,0,0,,Пупукупукумаа!
Dialogue: 0,2:08:53.29,2:08:56.29,Default,,0,0,0,,Керемет~ Рикка да бара ала ма?
Dialogue: 0,2:08:56.29,2:08:58.29,Default,,0,0,0,,Тек ол ғана жұтылып кеткен азаматтардың өкпе-ренішін қайтара алады
Dialogue: 0,2:08:58.29,2:09:00.63,Default,,0,0,0,,Бұл жақсы. Алақай!
Dialogue: 0,2:09:00.63,2:09:05.13,Default,,0,0,0,,Уфуфу Мен де Рикка-чанның қасымда болғанына қуаныштымын.
Dialogue: 0,2:09:05.13,2:09:07.14,Default,,0,0,0,,Цубаса-чан, біз де кеттік!
Dialogue: 0,2:09:07.14,2:09:09.14,Default,,0,0,0,,Иә! (Секине) Аа!?
Dialogue: 0,2:09:09.14,2:09:12.57,Default,,0,0,0,,《Жақсы, үйге бару аздап...
Dialogue: 0,2:09:12.57,2:09:16.41,Default,,0,0,0,,Бірақ мен осылай бас тартсам, бұл табиғи емес болар еді...》
Dialogue: 0,2:09:16.41,2:09:19.92,Default,,0,0,0,,Жарайды, саған Секине ұнамайды, солай ма?
Dialogue: 0,2:09:19.92,2:09:21.92,Default,,0,0,0,,Фу…
Dialogue: 0,2:09:21.92,2:09:25.42,Default,,0,0,0,,1 адамға және 3 адамға бірдей. иә?
Dialogue: 0,2:09:25.42,2:09:27.42,Default,,0,0,0,,<Ясагуре Секине>
Dialogue: 0,2:09:27.42,2:09:29.76,Default,,0,0,0,,Мен оны асыға күтемін!
Dialogue: 0,2:09:29.76,2:09:32.09,Default,,0,0,0,,Бәріміз бірге тамақтансақ ше?
Dialogue: 0,2:09:32.09,2:09:35.60,Default,,0,0,0,,Жақсы! Егер солай болса...
Dialogue: 0,2:09:35.60,2:09:37.93,Default,,0,0,0,,Мен мектепте оқып жүрген кезімде
Dialogue: 0,2:09:37.93,2:09:42.60,Default,,0,0,0,,Мен істегім келетін іс-шара бар.
Dialogue: 0,2:09:42.60,2:09:44.94,Default,,0,0,0,,Маған бірдеңе айтқың келеді~
Dialogue: 0,2:09:44.94,2:09:47.11,Default,,0,0,0,,Өзіміз жасай алсақ
Dialogue: 0,2:09:47.11,2:09:49.11,Default,,0,0,0,,Не? Яғни...
Dialogue: 0,2:09:49.11,2:09:53.12,Default,,0,0,0,,Бұл Такопа!
Dialogue: 0,2:09:53.12,2:09:55.12,Default,,0,0,0,,Ах, Такопа.
Dialogue: 0,2:09:55.12,2:09:57.45,Default,,0,0,0,,Бұл жақсы емес пе, Такопа?
Dialogue: 0,2:09:57.45,2:10:00.46,Default,,0,0,0,,Бұл рас па!?
Dialogue: 0,2:10:00.46,2:10:02.46,Default,,0,0,0,,Такопа!?
Dialogue: 0,2:10:02.46,2:10:06.30,Default,,0,0,0,,《Рикка: Такопа деген не? елестетемін
Dialogue: 0,2:10:06.30,2:10:12.73,Default,,0,0,0,,Менің ойымша, бұл бәрі жиналатын шара...
Dialogue: 0,2:10:12.73,2:10:15.90,Default,,0,0,0,,Ха! Революциялық ыстық қазан сияқты нәрсе! 》
Dialogue: 0,2:10:15.90,2:10:18.41,Default,,0,0,0,,<Жұмбақ соттау>
Dialogue: 0,2:10:18.41,2:10:21.41,Default,,0,0,0,,《Мен түсінемін. Полковник, мен Такопа туралы білмеймін.》
Dialogue: 0,2:10:21.41,2:10:23.91,Default,,0,0,0,,Бұл Такояки партиясының аббревиатурасы.
Dialogue: 0,2:10:23.91,2:10:26.42,Default,,0,0,0,,туралы білдім.
Dialogue: 0,2:10:26.42,2:10:29.92,Default,,0,0,0,,Қалаған ингредиенттерді салуға болады. О!
Dialogue: 0,2:10:29.92,2:10:34.26,Default,,0,0,0,,Қыздар бас қосқанда ол мұны көп жасайтын көрінеді.
Dialogue: 0,2:10:34.26,2:10:38.26,Default,,0,0,0,,Бұл артқы заряд жарылып кететін оқиға.
Dialogue: 0,2:10:38.26,2:10:40.26,Default,,0,0,0,,Не болды? Секине
Dialogue: 0,2:10:40.26,2:10:42.43,Default,,0,0,0,,＜Кенеттен күдікті адам＞
Dialogue: 0,2:10:42.43,2:10:44.77,Default,,0,0,0,,Материалдарды сатып алып, үйге қайтайық.
Dialogue: 0,2:10:44.77,2:10:46.94,Default,,0,0,0,,Әрине, есепшотты бөліңіз.
Dialogue: 0,2:10:46.94,2:10:48.94,Default,,0,0,0,,Уау!
Dialogue: 0,2:10:48.94,2:10:52.44,Default,,0,0,0,,Уақыты келді…
Dialogue: 0,2:10:52.44,2:10:56.61,Default,,0,0,0,,Жүр, өтінемін~. Үйдегі адамға сәлем айтыңыз...
Dialogue: 0,2:10:56.61,2:10:59.62,Default,,0,0,0,,Аа, ол жоқ, сондықтан жақсы.
Dialogue: 0,2:10:59.62,2:11:03.62,Default,,0,0,0,,Сіздің ата-анаңыз жұмыс істей ме? А... иә
Dialogue: 0,2:11:03.62,2:11:06.96,Default,,0,0,0,,Мен жалғыз тұрамын, солай ма?
Dialogue: 0,2:11:06.96,2:11:10.96,Default,,0,0,0,,Не? Әке-шешемнің жұмысына байланысты.
Dialogue: 0,2:11:10.96,2:11:15.56,Default,,0,0,0,,《Негізі менің отбасым түгелдей экстрасенс, олар ғылыми-зерттеу институтында ұсталады.
Dialogue: 0,2:11:15.56,2:11:17.57,Default,,0,0,0,,Айтпақшы, тірі немесе өлі белгісіз!
Dialogue: 0,2:11:17.57,2:11:21.07,Default,,0,0,0,,Ұйымнан ай сайын аударылатын жұмбақ өтемақы ақшасына сүйену
Dialogue: 0,2:11:21.07,2:11:24.74,Default,,0,0,0,,Мен стипендияның көмегімен өзімді асырап отырмын》
Dialogue: 0,2:11:24.74,2:11:29.41,Default,,0,0,0,,<Секиненің сыныптары сыныпта 2-орын>
Dialogue: 0,2:11:29.41,2:11:32.75,Default,,0,0,0,,《Бірақ, мен қалай болса да басқарып жатырмын! 》
Dialogue: 0,2:11:32.75,2:11:36.75,Default,,0,0,0,,Енді жоғары көтеріліңіз. Бірақ бұл шын мәнінде тозған.
Dialogue: 0,2:11:36.75,2:11:38.75,Default,,0,0,0,,Бұл туралы алаңдамаңыз.
Dialogue: 0,2:11:38.75,2:11:41.76,Default,,0,0,0,,О!
Dialogue: 0,2:11:41.76,2:11:45.59,Default,,0,0,0,,Сонда да жақсы атмосфера бар, Секине Нчи.
Dialogue: 0,2:11:45.59,2:11:48.93,Default,,0,0,0,,Кешіріңіз, мен өте жалқау болдым.
Dialogue: 0,2:11:48.93,2:11:51.60,Default,,0,0,0,,О
Dialogue: 0,2:11:51.60,2:11:55.10,Default,,0,0,0,,Эй!? Қазір аяғымның астында бірдеңе бар!?
Dialogue: 0,2:11:55.10,2:11:57.27,Default,,0,0,0,,А, уайымдама~
Dialogue: 0,2:11:57.27,2:11:59.27,Default,,0,0,0,,Иә?
Dialogue: 0,2:11:59.27,2:12:01.94,Default,,0,0,0,,Сәлем!
Dialogue: 0,2:12:01.94,2:12:05.28,Default,,0,0,0,,Мен оларды зиянкес емес, үй жануарлары ретінде қарастыруға тырысамын.
Dialogue: 0,2:12:05.28,2:12:07.62,Default,,0,0,0,,<Қуатты жүрек>
Dialogue: 0,2:12:07.62,2:12:11.12,Default,,0,0,0,,Түрлі себептерге байланысты тозығы жеткен.
Dialogue: 0,2:12:11.12,2:12:13.82,Default,,0,0,0,,Біздің үйге қош келдіңіз!
Dialogue: 0,2:12:15.89,2:12:19.06,Default,,0,0,0,,Менің ойымша, бұл өмір сүруге жақсы жер.
Dialogue: 0,2:12:19.06,2:12:23.07,Default,,0,0,0,,Өзіңді қорғайтын үлкен қабырға. Жаңбыр мен шықтан қорғайтын шатыр.
Dialogue: 0,2:12:23.07,2:12:25.73,Default,,0,0,0,,Және сүйкімді үй жануарлары
Dialogue: 0,2:12:25.73,2:12:27.74,Default,,0,0,0,,《Жоқ, бұл егеуқұйрық.
Dialogue: 0,2:12:27.74,2:12:32.07,Default,,0,0,0,,Егер салыстыру пәні кемпинг болса, ол құрметті көрінеді ме?
Dialogue: 0,2:12:32.07,2:12:34.41,Default,,0,0,0,,Досының үйінде түней алу
Dialogue: 0,2:12:34.41,2:12:36.41,Default,,0,0,0,,Бұл арман сияқты!
Dialogue: 0,2:12:36.41,2:12:40.08,Default,,0,0,0,,<Армандауға қабілеті күшті>
Dialogue: 0,2:12:40.08,2:12:42.25,Default,,0,0,0,,Йо хо хо
Dialogue: 0,2:12:42.25,2:12:45.42,Default,,0,0,0,,Жарайсың...
Dialogue: 0,2:12:45.42,2:12:50.09,Default,,0,0,0,,Бұл шебердің шеберлігі! Цубаса-чан заттарды жасауда өте шебер!
Dialogue: 0,2:12:50.09,2:12:52.43,Default,,0,0,0,,Бұл шынымен де күтпеген шеберлік.
Dialogue: 0,2:12:52.43,2:12:54.43,Default,,0,0,0,,Ахахахаха…
Dialogue: 0,2:12:54.43,2:12:57.27,Default,,0,0,0,,《Әпкемнің үнемі пайдалануының нәтижесі
Dialogue: 0,2:12:57.27,2:12:59.94,Default,,0,0,0,,Мен мұндай жерге шығамын деп ойламаппын》
Dialogue: 0,2:12:59.94,2:13:04.04,Default,,0,0,0,,Сонымен, жегің келе ме? (Барлығы) Кеттік!
Dialogue: 0,2:13:06.11,2:13:09.11,Default,,0,0,0,,Ммм!
Dialogue: 0,2:13:09.11,2:13:12.88,Default,,0,0,0,,《А, бірдеңе...
Dialogue: 0,2:13:12.88,2:13:17.22,Default,,0,0,0,,Осындай нәрсе...》
Dialogue: 0,2:13:17.22,2:13:22.56,Default,,0,0,0,,Тұзды, аузымды қуантады!
Dialogue: 0,2:13:22.56,2:13:24.89,Default,,0,0,0,,<Бақытсыз тамақ туралы есеп>
Dialogue: 0,2:13:24.89,2:13:27.56,Default,,0,0,0,,Қыздар жиналды
Dialogue: 0,2:13:27.56,2:13:31.40,Default,,0,0,0,,Бір-біріңіздің такояки Такопасын қағып алыңыздар
Dialogue: 0,2:13:31.40,2:13:33.57,Default,,0,0,0,,Мен оған таң қалдым.
Dialogue: 0,2:13:33.57,2:13:36.74,Default,,0,0,0,,Сізге жақсы~ Чиё-сан!
Dialogue: 0,2:13:36.74,2:13:41.24,Default,,0,0,0,,Иә!? Аузың күйіп тұрғандай!
Dialogue: 0,2:13:41.24,2:13:43.25,Default,,0,0,0,,Рикка, жақсысың ба?
Dialogue: 0,2:13:43.25,2:13:46.75,Default,,0,0,0,,Уау, ыстық екен, аузым толып кетті!
Dialogue: 0,2:13:46.75,2:13:48.75,Default,,0,0,0,,Ах...
Dialogue: 0,2:13:48.75,2:13:50.92,Default,,0,0,0,,Бухаха
Dialogue: 0,2:13:50.92,2:13:53.76,Default,,0,0,0,,Уф!
Dialogue: 0,2:13:53.76,2:13:56.76,Default,,0,0,0,,Ішінде не бар? Қайда? (Цубаса) Дұрыс!
Dialogue: 0,2:13:59.93,2:14:05.93,Default,,0,0,0,,Уау! Ішінде жылы шырын бар еді.
Dialogue: 0,2:14:05.93,2:14:09.77,Default,,0,0,0,,Сенімді болу үшін барлығыңыз не салдыңыз?
Dialogue: 0,2:14:09.77,2:14:13.88,Default,,0,0,0,,Рикка - сағыз! Бұл өте дәмді көрінді
Dialogue: 0,2:14:13.88,2:14:15.88,Default,,0,0,0,,《Секине: Осылай қалса! 》
Dialogue: 0,2:14:15.88,2:14:18.88,Default,,0,0,0,,Мен сашими жеймін...
Dialogue: 0,2:14:18.88,2:14:20.88,Default,,0,0,0,,Бұл сашими болды ма!?
Dialogue: 0,2:14:20.88,2:14:23.72,Default,,0,0,0,,Балық сізге пайдалы
Dialogue: 0,2:14:23.72,2:14:27.06,Default,,0,0,0,,《Цубаса: Жоқ, егер бұл сашими болса, шикі жеуге рұқсат етіңіз.》
Dialogue: 0,2:14:27.06,2:14:29.06,Default,,0,0,0,,Секине-чан ше?
Dialogue: 0,2:14:29.06,2:14:31.39,Default,,0,0,0,,Құпия!
Dialogue: 0,2:14:31.39,2:14:33.73,Default,,0,0,0,,Неліктен? Өзіңізден сұраңыз.
Dialogue: 0,2:14:33.73,2:14:37.23,Default,,0,0,0,,Жақсы. Бұл қызық болғанша.
Dialogue: 0,2:14:37.23,2:14:40.90,Default,,0,0,0,,Бұл рас.
Dialogue: 0,2:14:40.90,2:14:44.91,Default,,0,0,0,,Ащы!
Dialogue: 0,2:14:44.91,2:14:48.41,Default,,0,0,0,,А, бұл менмін. Бхут Жолокия
Dialogue: 0,2:14:48.41,2:14:50.75,Default,,0,0,0,,Жүктеу? Жолокия?
Dialogue: 0,2:14:50.75,2:14:53.75,Default,,0,0,0,,Бұл әлемдегі ең ауыр деп айтылады.
Dialogue: 0,2:14:53.75,2:14:57.75,Default,,0,0,0,,Мен оны Carolina Reaper жасауға тырыстым.
Dialogue: 0,2:14:57.75,2:15:01.42,Default,,0,0,0,,Жаңадан бастаушыларға қиын деп ойлаймын.
Dialogue: 0,2:15:01.42,2:15:03.43,Default,,0,0,0,,<Жұмбақ қарау>
Dialogue: 0,2:15:03.43,2:15:06.09,Default,,0,0,0,,Бұл да жеткілікті қиын.
Dialogue: 0,2:15:06.09,2:15:09.93,Default,,0,0,0,,Мен оны жегім келеді! Рикка да!
Dialogue: 0,2:15:09.93,2:15:12.77,Default,,0,0,0,,Қайсысы? Бұл ма?
Dialogue: 0,2:15:12.77,2:15:15.97,Default,,0,0,0,,Кеттік! Уақыт келді!
Dialogue: 0,2:15:17.94,2:15:20.78,Default,,0,0,0,,Өте өкінішті, бұл сағыз кәмпит болды.
Dialogue: 0,2:15:20.78,2:15:25.95,Default,,0,0,0,,Рикка да басқаша болды. Өте тәтті!
Dialogue: 0,2:15:25.95,2:15:28.78,Default,,0,0,0,,<Полковник Джекпот~>
Dialogue: 0,2:15:28.78,2:15:32.29,Default,,0,0,0,,Қайсысы?
Dialogue: 0,2:15:32.29,2:15:34.29,Default,,0,0,0,,(Дарио) Қ… Қандай қорқынышты маска. Маған бұл керек емес.
Dialogue: 0,2:15:34.29,2:15:37.29,Default,,0,0,0,,Айтпақшы, сен қандай қанат сатып алдың?
Dialogue: 0,2:15:37.29,2:15:41.46,Default,,0,0,0,,Ментайко мен ірімшік...
Dialogue: 0,2:15:41.46,2:15:44.30,Default,,0,0,0,,Ментайко және... Сыр
Dialogue: 0,2:15:44.30,2:15:49.47,Default,,0,0,0,,Әй, расында да, қазір ойлап қарасам, сол тұзды дәм ірімшік еді.
Dialogue: 0,2:15:49.47,2:15:52.14,Default,,0,0,0,,Бұл темір табақтардың қосындысы!
Dialogue: 0,2:15:52.14,2:15:56.98,Default,,0,0,0,,《Мен де революциялық қазанға саламын! 》
Dialogue: 0,2:15:56.98,2:16:03.15,Default,,0,0,0,,Тека Цубаса Бұл олардың ішіндегі ең әйелдік таңдау.
Dialogue: 0,2:16:03.15,2:16:06.65,Default,,0,0,0,,<Менің ақыл-ойым мен денем қалпына келе алмайды>
Dialogue: 0,2:16:09.49,2:16:11.43,Default,,0,0,0,,Уф~
Dialogue: 0,2:16:11.43,2:16:14.43,Default,,0,0,0,,Сыртта жеген такояки де дәмді болды.
Dialogue: 0,2:16:14.43,2:16:16.60,Default,,0,0,0,,Барлығы жасайтын такояки
Dialogue: 0,2:16:16.60,2:16:19.43,Default,,0,0,0,,Бұл ерекше. Иә!
Dialogue: 0,2:16:19.43,2:16:22.60,Default,,0,0,0,,《Жоқ~ Бұл дүңгіршек жеткіліксіз.》
Dialogue: 0,2:16:22.60,2:16:28.11,Default,,0,0,0,,Чио-санның маған кәдесый ретінде берген шайы өте дәмді.
Dialogue: 0,2:16:28.11,2:16:30.28,Default,,0,0,0,,Оның ерекше ащы дәмі бар.
Dialogue: 0,2:16:30.28,2:16:33.62,Default,,0,0,0,,Бұл Докудами. Бұл өте тәтті!
Dialogue: 0,2:16:33.62,2:16:35.62,Default,,0,0,0,,Не? (Цубаса/Секине) Иә?
Dialogue: 0,2:16:35.62,2:16:38.52,Default,,0,0,0,,<Жат дәм>
Dialogue: 0,2:16:44.96,2:16:49.13,Default,,0,0,0,,Сіз шынымен де осы тайфун кезінде үйге қайтуды жоспарлап отырсыз ба?
Dialogue: 0,2:16:49.13,2:16:53.30,Default,,0,0,0,,Әй, жастығым өзгерсе ұйықтай алмаймын.
Dialogue: 0,2:16:53.30,2:16:55.47,Default,,0,0,0,,《Түнде қалуым мүмкін емес! 》
Dialogue: 0,2:16:55.47,2:17:00.14,Default,,0,0,0,,Рикка-чан да... Рикка мен үйді қорғауым керек.
Dialogue: 0,2:17:00.14,2:17:04.48,Default,,0,0,0,,《Біз аналық кемеден хабар алуымыз мүмкін.》
Dialogue: 0,2:17:04.48,2:17:06.48,Default,,0,0,0,,Уау! Уау!
Dialogue: 0,2:17:15.92,2:17:19.09,Default,,0,0,0,,Қуат Ол күшті емес пе?
Dialogue: 0,2:17:19.09,2:17:22.10,Default,,0,0,0,,Жоқ, жақсы сезінеді~
Dialogue: 0,2:17:22.10,2:17:24.43,Default,,0,0,0,,Сіз оны шешіп жатқан жоқсыз ба?
Dialogue: 0,2:17:24.43,2:17:27.60,Default,,0,0,0,,Сіз ештеңе көре алмайсыз.
Dialogue: 0,2:17:27.60,2:17:32.44,Default,,0,0,0,,<Көпшілік жерде ешқашан көзілдірікті шешпеу керек.
Dialogue: 0,2:17:32.44,2:17:35.74,Default,,0,0,0,,Секинеде осындай сыр бар>
Dialogue: 0,2:17:37.78,2:17:42.12,Default,,0,0,0,,Чио-сан, келесі жолы ойнаймын. Ах.
Dialogue: 0,2:17:42.12,2:17:47.46,Default,,0,0,0,,Бұл жақтастық! Бұл жақтастық~!
Dialogue: 0,2:17:47.46,2:17:51.29,Default,,0,0,0,,<Ешқашан ешкімге арқаңызды көрсетпеңіз. Сіз оны көрсете алмайсыз.
Dialogue: 0,2:17:51.29,2:17:54.59,Default,,0,0,0,,Ниндзялардың қайғылы әдеттері>
Dialogue: 0,2:17:56.63,2:17:59.97,Default,,0,0,0,,Иә
Dialogue: 0,2:17:59.97,2:18:04.64,Default,,0,0,0,,Аа, мұны біреудің сізге жасағаны оңайырақ.
Dialogue: 0,2:18:04.64,2:18:08.14,Default,,0,0,0,,Уфуфу, Чийоға қалдыр.
Dialogue: 0,2:18:11.75,2:18:15.75,Default,,0,0,0,,《Чиё: Мен әрқашан ниндзя күндерім туралы армандайтынмын.
Dialogue: 0,2:18:15.75,2:18:19.42,Default,,0,0,0,,Бір күні, бір күні ауылдан кетемін
Dialogue: 0,2:18:19.42,2:18:24.09,Default,,0,0,0,,Сүйкімді достарыңа жақсылық жасай алсаң
Dialogue: 0,2:18:24.09,2:18:29.10,Default,,0,0,0,,Ұйқы кешін өткізгіңіз келетініне сенімдімін.
Dialogue: 0,2:18:29.10,2:18:34.94,Default,,0,0,0,,Мұндай күннің шынымен келетініне сене алар емеспін.
Dialogue: 0,2:18:34.94,2:18:40.94,Default,,0,0,0,,《Секине: Егер сонша жасағың келсе, мен саған мүмкіндігінше рұқсат беремін》
Dialogue: 0,2:18:40.94,2:18:43.45,Default,,0,0,0,,Чио-сан. Иә?
Dialogue: 0,2:18:43.45,2:18:45.78,Default,,0,0,0,,Бүгін тағы не істеп көргіңіз келеді?
Dialogue: 0,2:18:45.78,2:18:48.12,Default,,0,0,0,,Бар ма? сурет?
Dialogue: 0,2:18:48.12,2:18:52.12,Default,,0,0,0,,Бар болса... Жарайды ма!?
Dialogue: 0,2:18:52.12,2:18:58.79,Default,,0,0,0,,Айналдыру!? Ұйықтау кезінде жасағыңыз келетін 100 нәрсе?
Dialogue: 0,2:18:58.79,2:19:02.63,Default,,0,0,0,,Ата-анаңды менсінбей амандас
Dialogue: 0,2:19:02.63,2:19:04.63,Default,,0,0,0,,Кәдесый әкеліңіз
Dialogue: 0,2:19:04.63,2:19:06.80,Default,,0,0,0,,Tacopa ойнаңыз
Dialogue: 0,2:19:06.80,2:19:08.80,Default,,0,0,0,,Бірге шомылыңыз
Dialogue: 0,2:19:08.80,2:19:12.91,Default,,0,0,0,,Бір-біріне бояну. Жұлдызнамаға қараңыз
Dialogue: 0,2:19:12.91,2:19:15.08,Default,,0,0,0,,Шаш үлгілерін ауыстыру
Dialogue: 0,2:19:15.08,2:19:19.08,Default,,0,0,0,,Сіз төсекте өзіңізге ұнайтын адам туралы айтасыз ба?
Dialogue: 0,2:19:19.08,2:19:24.25,Default,,0,0,0,,Секине мырза, сіз маған кім ұнайтынын білесіз бе?
Dialogue: 0,2:19:24.25,2:19:26.59,Default,,0,0,0,,<Күтпеген викторина пішімі>
Dialogue: 0,2:19:26.59,2:19:29.42,Default,,0,0,0,,Хмм, Рикка, солай ма?
Dialogue: 0,2:19:29.42,2:19:32.76,Default,,0,0,0,,Ухуху, бұл тек жартысы ғана дұрыс.
Dialogue: 0,2:19:32.76,2:19:36.93,Default,,0,0,0,,Иә? Рикка-чан Секине-сан Цубаса-сан
Dialogue: 0,2:19:36.93,2:19:41.94,Default,,0,0,0,,Үшеуі де мен жақсы көретін, көңіл бөлетін жандар.
Dialogue: 0,2:19:41.94,2:19:46.94,Default,,0,0,0,,Әсіресе, Секине мырза, мен жаңа мектепке ауысқан едім.
Dialogue: 0,2:19:46.94,2:19:51.95,Default,,0,0,0,,Сіз мені бірінші рет түскі асқа шақырдыңыз, солай ма?
Dialogue: 0,2:19:51.95,2:19:56.28,Default,,0,0,0,,Негізі мен қатты қуандым.
Dialogue: 0,2:19:56.28,2:20:00.29,Default,,0,0,0,,А, бұл да болды.
Dialogue: 0,2:20:00.29,2:20:03.09,Default,,0,0,0,,Олай болса, ұйықтайын ба?
Dialogue: 0,2:20:06.96,2:20:10.47,Default,,0,0,0,,Сізде бар ма? Жарқырап барады
Dialogue: 0,2:20:10.47,2:20:15.07,Default,,0,0,0,,Уфуфу, анау футонға кірейік.
Dialogue: 0,2:20:17.57,2:20:19.57,Default,,0,0,0,,Бұл тар.
Dialogue: 0,2:20:19.57,2:20:22.74,Default,,0,0,0,,Тек таңдаулы бірнешеуге ғана тән делінген күш—
Dialogue: 0,2:20:22.74,2:20:25.58,Default,,0,0,0,,Қызарып барады, сүйкімді
Dialogue: 0,2:20:25.58,2:20:27.58,Default,,0,0,0,,Хмм...
Dialogue: 0,2:20:39.93,2:20:42.93,Default,,0,0,0,,Чио-сан?
Dialogue: 0,2:20:46.43,2:20:49.60,Default,,0,0,0,,Бұл Чио-сан ба?
Dialogue: 0,2:20:49.60,2:20:52.61,Default,,0,0,0,,Мен саған таңғы ас әзірледім.
Dialogue: 0,2:20:52.61,2:20:55.78,Default,,0,0,0,,Біз нөлдік материалдық шығындармен бар күшімізді салдық!
Dialogue: 0,2:20:55.78,2:20:59.78,Default,,0,0,0,,Бұл нөлдік материалдық шығын! Бұл керемет!
Dialogue: 0,2:20:59.78,2:21:01.78,Default,,0,0,0,,Онда мен аламын!
Dialogue: 0,2:21:01.78,2:21:03.79,Default,,0,0,0,,Ет?
Dialogue: 0,2:21:03.79,2:21:05.99,Default,,0,0,0,,Менің үйімде осындай нәрсе болды...
Dialogue: 0,2:21:13.39,2:21:15.73,Default,,0,0,0,,《Мен бұл туралы ешқашан тым терең ойламаймын! 》
Dialogue: 0,2:21:15.73,2:21:17.73,Default,,0,0,0,,Хмф!
Dialogue: 0,2:21:19.90,2:21:22.07,Default,,0,0,0,,Аа, қазір ойлап қарасам
Dialogue: 0,2:21:22.07,2:21:27.08,Default,,0,0,0,,Жартылай дұрыс жауапқа қарағанда, үшінші дұрыс жауап сияқты емес пе?
Dialogue: 0,2:21:27.08,2:21:30.75,Default,,0,0,0,,Иә? Қараңызшы, Чио-санның өзіне ұнайтын адам туралы әңгімесі.
Dialogue: 0,2:21:30.75,2:21:33.41,Default,,0,0,0,,Секине мырза, кешіріңіз.
Dialogue: 0,2:21:33.41,2:21:35.92,Default,,0,0,0,,《Аа... менің Риккаға деген махаббатым
Dialogue: 0,2:21:35.92,2:21:38.25,Default,,0,0,0,,Сіз 50 пайызды айтасыз ба? 》
Dialogue: 0,2:21:38.25,2:21:41.42,Default,,0,0,0,,I Көлденең таңбалар аздап...
Dialogue: 0,2:21:41.42,2:21:44.09,Default,,0,0,0,,《Көлденең мәтін? Мүмкін емес!
Dialogue: 0,2:21:44.09,2:21:48.26,Default,,0,0,0,,Сіздің ойыңызша, Санбун ноичи шет тілі ме?》
Dialogue: 0,2:21:48.26,2:21:50.60,Default,,0,0,0,,Санаулы сиқыршы!
Dialogue: 0,2:21:50.60,2:21:54.60,Default,,0,0,0,,Мен Брайан-сенсиге лайықты өмір сүруге тырысамын!
Dialogue: 0,2:21:54.60,2:21:56.60,Default,,0,0,0,,Чио-сан
Dialogue: 0,2:21:56.60,2:22:02.60,Default,,0,0,0,,<Осылайша Чионың бақытты күні аяқталды>
Dialogue: 0,2:22:09.28,2:22:13.05,Default,,0,0,0,,Ал, үйге қайтайық. Бұл дұрыс.
Dialogue: 0,2:22:13.05,2:22:15.89,Default,,0,0,0,,Чио-сан Рикка... Иә?
Dialogue: 0,2:22:15.89,2:22:18.56,Default,,0,0,0,,Хмм?
Dialogue: 0,2:22:18.56,2:22:20.56,Default,,0,0,0,,Уф, уау!
Dialogue: 0,2:22:22.73,2:22:24.73,Default,,0,0,0,,Уф...
Dialogue: 0,2:22:34.58,2:22:36.58,Default,,0,0,0,,《Жоқ》
Dialogue: 0,2:22:36.58,2:22:40.58,Default,,0,0,0,,<Түсіндірейік. Секине көзілдірігін шешкенде,
Dialogue: 0,2:22:40.58,2:22:46.75,Default,,0,0,0,,Сіз бұдан былай ешқандай психикалық күштерді басқара алмайсыз.
Dialogue: 0,2:22:46.75,2:22:51.45,Default,,0,0,0,,Мен көзілдірікті шешкен кезде...＞
Dialogue: 0,2:22:59.93,2:23:05.94,Default,,0,0,0,,《Секине: Мен мұндай нәрсе болады деп күтпедім...》
Dialogue: 0,2:23:05.94,2:23:08.11,Default,,0,0,0,,Ах...
Dialogue: 0,2:23:08.11,2:23:10.95,Default,,0,0,0,,Мен…
Dialogue: 0,2:23:10.95,2:23:15.38,Default,,0,0,0,,Мен Рикка-чанды өлтірдім.
Dialogue: 0,2:23:15.38,2:23:19.72,Default,,0,0,0,,《Чиё: Бала кезінен ниндзя болып дайындалған.
Dialogue: 0,2:23:19.72,2:23:24.23,Default,,0,0,0,,Ауылдың бұйрығымен қайта-қайта қастандық дайындау...
Dialogue: 0,2:23:24.23,2:23:29.23,Default,,0,0,0,,Алайда ол бетперде киген аюды кездестіріп, ауылдан қашып кетеді.
Dialogue: 0,2:23:29.23,2:23:31.57,Default,,0,0,0,,Қарапайым қыз сияқты
Dialogue: 0,2:23:31.57,2:23:35.40,Default,,0,0,0,,Менде бейбіт күндер болды》
Dialogue: 0,2:23:35.40,2:23:38.07,Default,,0,0,0,,Барлығын кешіріңіз
Dialogue: 0,2:23:38.07,2:23:41.41,Default,,0,0,0,,Жоқ, бұл! Бұл Чио-санның кінәсі емес, солай ма?
Dialogue: 0,2:23:41.41,2:23:44.41,Default,,0,0,0,,Бәріне кеш.
Dialogue: 0,2:23:44.41,2:23:49.25,Default,,0,0,0,,Мен қазір өзімді тапсырамын.
Dialogue: 0,2:23:49.25,2:23:51.92,Default,,0,0,0,,Бірақ бұған дейін
Dialogue: 0,2:23:51.92,2:23:54.09,Default,,0,0,0,,Шура болу
Dialogue: 0,2:23:54.09,2:23:56.29,Default,,0,0,0,,《Ауылды құрту...》
Dialogue: 0,2:23:58.43,2:24:01.73,Default,,0,0,0,,Ааа аа...
Dialogue: 0,2:24:04.43,2:24:07.27,Default,,0,0,0,,《Қанаттар: Шүрікен иә?
Dialogue: 0,2:24:07.27,2:24:12.04,Default,,0,0,0,,Мен жаңа ғана байқадым. Бұл еркелік, солай емес пе?
Dialogue: 0,2:24:12.04,2:24:15.88,Default,,0,0,0,,Бұл тереңдетілген, бірақ бұл ұят. Қанның түсі жоқ.
Dialogue: 0,2:24:15.88,2:24:18.38,Default,,0,0,0,,<Люминесцентті қызғылт>
Dialogue: 0,2:24:18.38,2:24:21.05,Default,,0,0,0,,《Чиё-сан, мен саған сенемін.
Dialogue: 0,2:24:21.05,2:24:24.39,Default,,0,0,0,,Бірақ неге еркелік...
Dialogue: 0,2:24:24.39,2:24:26.49,Default,,0,0,0,,Таң қалдырыңыз! 》
Dialogue: 0,2:24:28.56,2:24:31.39,Default,,0,0,0,,《Бұрын Чио-санға тосын сый жасадым...
Dialogue: 0,2:24:31.39,2:24:35.06,Default,,0,0,0,,Иә? Бүгін біреудің туған күні болды ма?
Dialogue: 0,2:24:35.06,2:24:39.40,Default,,0,0,0,,Мүмкін мен сізге біраз уақыт мінуге рұқсат беруім керек.
Dialogue: 0,2:24:39.40,2:24:42.40,Default,,0,0,0,,Иә?
Dialogue: 0,2:24:42.40,2:24:44.91,Default,,0,0,0,,Уа, мен той-томалақ киіп жүрмін.
Dialogue: 0,2:24:44.91,2:24:48.24,Default,,0,0,0,,Дайындық үшін көп еңбек еттіңіз.
Dialogue: 0,2:24:48.24,2:24:50.24,Default,,0,0,0,,Секине сабырлы》
Dialogue: 0,2:24:52.25,2:24:57.09,Default,,0,0,0,,《Секине: Полковниктің мимикасы тозып бара жатыр, бірақ жарайды.
Dialogue: 0,2:24:57.09,2:24:59.75,Default,,0,0,0,,Тезірек заттарыңызды жинап, дайындалыңыз! 》
Dialogue: 0,2:24:59.75,2:25:01.76,Default,,0,0,0,,< Жарайсың ба, Секине! ＞
Dialogue: 0,2:25:01.76,2:25:03.76,Default,,0,0,0,,《Бұл не? 》
Dialogue: 0,2:25:03.76,2:25:07.26,Default,,0,0,0,,<Чио өзін сондай жауапкершілікпен сезінсе де.
Dialogue: 0,2:25:07.26,2:25:09.43,Default,,0,0,0,,Сен ұялмайсың ба? ＞
Dialogue: 0,2:25:09.43,2:25:11.77,Default,,0,0,0,,《Мақтанышпен тамақ іше аласың ба? 》
Dialogue: 0,2:25:11.77,2:25:14.44,Default,,0,0,0,,＜Бұл оның тұлғасы болды＞
Dialogue: 0,2:25:14.44,2:25:18.44,Default,,0,0,0,,《Кочитора 14 жыл бойы бір ұйымның бақылауында тұрады!
Dialogue: 0,2:25:18.44,2:25:22.78,Default,,0,0,0,,Менің қабілеттерімді бақылаудағы қателіктен кісі өлтіру жасалғанын білсем ше...
Dialogue: 0,2:25:22.78,2:25:25.78,Default,,0,0,0,,өшірілді
Dialogue: 0,2:25:25.78,2:25:31.95,Default,,0,0,0,,Таң атқанша бұл қаладан кетейік》
Dialogue: 0,2:25:31.95,2:25:35.29,Default,,0,0,0,,《Рикка: Бұл...》 Иә?
Dialogue: 0,2:25:35.29,2:25:38.63,Default,,0,0,0,,《Кенеттен ойыма бірдеңе болды...
Dialogue: 0,2:25:38.63,2:25:41.96,Default,,0,0,0,,Мен өзімді қалпына келтіру қабілетіммен өмір сүре алсам да...
Dialogue: 0,2:25:41.96,2:25:47.64,Default,,0,0,0,,Бұл не, Жер мәдениеті?
Dialogue: 0,2:25:47.64,2:25:49.64,Default,,0,0,0,,Мен тірілемін
Dialogue: 0,2:25:49.64,2:25:51.81,Default,,0,0,0,,Босатыңызшы, Цубаса-сан!
Dialogue: 0,2:25:51.81,2:25:54.81,Default,,0,0,0,,Мен... мен кеттім!
Dialogue: 0,2:25:54.81,2:25:57.15,Default,,0,0,0,,Мен бәріңмен бірге бола алмаймын!
Dialogue: 0,2:25:57.15,2:25:59.48,Default,,0,0,0,,Чио-сан! Чио-сан, күт!
Dialogue: 0,2:25:59.48,2:26:02.32,Default,,0,0,0,,Бұл жай еркелік! сурет?
Dialogue: 0,2:26:02.32,2:26:04.65,Default,,0,0,0,,Қараңдар, Рикка да оян! Оян!
Dialogue: 0,2:26:04.65,2:26:08.49,Default,,0,0,0,,Бұл еркелік пе?
Dialogue: 0,2:26:08.49,2:26:13.09,Default,,0,0,0,,Хехехехе бәрі менің жоспарым бойынша.
Dialogue: 0,2:26:13.09,2:26:15.43,Default,,0,0,0,,Секине? Секине мырза?
Dialogue: 0,2:26:15.43,2:26:18.60,Default,,0,0,0,,Иә! Мен шурикенді онлайн сатып алдым, қаны бояу!
Dialogue: 0,2:26:18.60,2:26:21.27,Default,,0,0,0,,Мен мұның бәрін Риккаға айтпай өзім жоспарладым!
Dialogue: 0,2:26:21.27,2:26:23.44,Default,,0,0,0,,Рикканың таңғалғаны соншалық, есінен танып қалды.
Dialogue: 0,2:26:23.44,2:26:25.44,Default,,0,0,0,,Айтпақшы, еркеліктің себебі
Dialogue: 0,2:26:25.44,2:26:28.78,Default,,0,0,0,,Өйткені бұл менің үлкен әжемнің қайтыс болған күні!
Dialogue: 0,2:26:28.78,2:26:31.11,Default,,0,0,0,,<Күш>
Dialogue: 0,2:26:31.11,2:26:33.78,Default,,0,0,0,,Саған жақсылық, Рикка-чан!
Dialogue: 0,2:26:33.78,2:26:36.28,Default,,0,0,0,,Қандай еркелік!
Dialogue: 0,2:26:36.28,2:26:41.29,Default,,0,0,0,,《Жер бетіндегі ата-әжелеріміздің қазасын осылай жоқтаймыз ба?》
Dialogue: 0,2:26:41.29,2:26:45.46,Default,,0,0,0,,Қарашы, Рикка, неге бояуды сүртпейсің? Сізге көп рахмет
Dialogue: 0,2:26:45.46,2:26:50.76,Default,,0,0,0,,《Енді ұйым мені нысанаға алмайды.》
Dialogue: 0,2:26:53.47,2:26:57.47,Default,,0,0,0,,<Бүгін де бейбітшілік сақталды>
Dialogue: 0,2:30:19.44,2:30:22.44,Default,,0,0,0,,Уф...
Dialogue: 0,2:30:28.45,2:30:30.45,Default,,0,0,0,,Бұл қай жерде?
Dialogue: 0,2:32:11.42,2:32:13.92,Default,,0,0,0,,Ммм (шкафтың ашылған дыбысы)
Dialogue: 0,2:32:13.92,2:32:16.42,Default,,0,0,0,,Секине! ояндым?
Dialogue: 0,2:32:18.93,2:32:21.76,Default,,0,0,0,,Иә? Ал караоке ше?
Dialogue: 0,2:32:21.76,2:32:23.76,Default,,0,0,0,,Бұл жердің не жері...
Dialogue: 0,2:32:23.76,2:32:25.77,Default,,0,0,0,,Мен мұны түсінбеймін.
Dialogue: 0,2:32:25.77,2:32:29.44,Default,,0,0,0,,Мен қазір ғана караокеде ән айтуым керек еді.
Dialogue: 0,2:32:29.44,2:32:32.04,Default,,0,0,0,,《Мен сол уақытқа сенемін...》
Dialogue: 0,2:32:41.95,2:32:46.95,Default,,0,0,0,,Антенналар дыбыс шығарады ма? Ол сондай-ақ осқырады, солай ма?
Dialogue: 0,2:32:46.95,2:32:51.95,Default,,0,0,0,,Бұл не? Мен кенеттен ұйықтап кеттім ...
Dialogue: 0,2:32:59.97,2:33:03.14,Default,,0,0,0,,《Мен түсіндім, сондықтан...》
Dialogue: 0,2:33:03.14,2:33:05.97,Default,,0,0,0,,Сусынның ішінде бірдеңе болуы керек.
Dialogue: 0,2:33:05.97,2:33:09.48,Default,,0,0,0,,Бұл сөзсіз адам саудасы!
Dialogue: 0,2:33:09.48,2:33:11.41,Default,,0,0,0,,Мен оны қандай да бір азғын миллионерге сатуды жоспарлап отырмын!
Dialogue: 0,2:33:11.41,2:33:13.41,Default,,0,0,0,,Уақыты келді…
Dialogue: 0,2:33:13.41,2:33:15.42,Default,,0,0,0,,Мм...
Dialogue: 0,2:33:15.42,2:33:18.09,Default,,0,0,0,,Біреу келсе, мен сені ұрып жіберемін, сондықтан бәрі қашады!
Dialogue: 0,2:33:18.09,2:33:20.09,Default,,0,0,0,,Жоқ, бірақ...
Dialogue: 0,2:33:20.09,2:33:23.59,Default,,0,0,0,,Жарайды. Басқалар сияқты, сіз сатып алушы таба алмайтыныңызға сенімдімін.
Dialogue: 0,2:33:23.59,2:33:27.99,Default,,0,0,0,,《Егер олар менің адам екенімді білсе, мені өлтіруі мүмкін.》
Dialogue: 0,2:33:29.93,2:33:33.10,Default,,0,0,0,,《Бұл адам саудасы емес.
Dialogue: 0,2:33:33.10,2:33:35.94,Default,,0,0,0,,Ауылдан келген қуғыншылар ұйықтататын дәрі бергеніне сенімдімін...》
Dialogue: 0,2:33:35.94,2:33:39.94,Default,,0,0,0,,Барлығыңызды кешіріңіз! Мен оны гарнир жасадым
Dialogue: 0,2:33:39.94,2:33:42.94,Default,,0,0,0,,Мен ғана нысанаға алдым!
Dialogue: 0,2:33:42.94,2:33:46.78,Default,,0,0,0,,Не? Жоқ, мен бұл жай Чио-сан ба, білмеймін, солай ма?
Dialogue: 0,2:33:46.78,2:33:50.45,Default,,0,0,0,,Жоқ, бұл мен ғана!
Dialogue: 0,2:33:50.45,2:33:55.46,Default,,0,0,0,,Егер кінәлі мені нысанаға алса, мен үшін бұл мүмкін емес еді!
Dialogue: 0,2:33:55.46,2:33:57.46,Default,,0,0,0,,《Уау, сен сондай сенімдісің.》
Dialogue: 0,2:33:57.46,2:34:02.13,Default,,0,0,0,,Бұл дұрыс болуы мүмкін. Бірақ бұл Чио-санның кінәсі емес.
Dialogue: 0,2:34:02.13,2:34:06.47,Default,,0,0,0,,《
Dialogue: 0,2:34:06.47,2:34:09.47,Default,,0,0,0,,Мен мұның бәрін бастан өткергенім жөн.
Dialogue: 0,2:34:09.47,2:34:12.41,Default,,0,0,0,,Мен сізге жеңілдетемін.
Dialogue: 0,2:34:12.41,2:34:16.08,Default,,0,0,0,,<Өл немесе өл, әрқашан 2 таңдау>
Dialogue: 0,2:34:16.08,2:34:20.08,Default,,0,0,0,,Бакамон! Буу!
Dialogue: 0,2:34:20.08,2:34:22.08,Default,,0,0,0,,《Полковник!?》 Уф!
Dialogue: 0,2:34:25.92,2:34:30.42,Default,,0,0,0,,А...өміріңді босқа өткізсең жақсы емес!
Dialogue: 0,2:34:30.42,2:34:33.26,Default,,0,0,0,,Тым болмаса тыныш өл...
Dialogue: 0,2:34:33.26,2:34:36.76,Default,,0,0,0,,Мм, мұнда бәрі жақсы.
Dialogue: 0,2:34:36.76,2:34:38.77,Default,,0,0,0,,Сіз ояусыз ба? (Қанаттар) Уау!
Dialogue: 0,2:34:38.77,2:34:41.94,Default,,0,0,0,,Директор! Біраз уақыт болды, Секине-кун.
Dialogue: 0,2:34:41.94,2:34:44.94,Default,,0,0,0,,Сіз нені айтасыз? Сіз бір-біріңізді танисыз ба?
Dialogue: 0,2:34:44.94,2:34:46.94,Default,,0,0,0,,Жоқ, бұл... Секине-күн
Dialogue: 0,2:34:46.94,2:34:51.11,Default,,0,0,0,,Уау! Мен саған көзілдірікті шешпе дедім.
Dialogue: 0,2:34:51.11,2:34:53.45,Default,,0,0,0,,Соның арқасында Секине-кунның қабілеті жарылды.
Dialogue: 0,2:34:53.45,2:34:56.12,Default,,0,0,0,,Бір қорқынышты нәрсе болды.
Dialogue: 0,2:34:56.12,2:34:59.45,Default,,0,0,0,,Сіз болған бөлме бейберекет.
Dialogue: 0,2:34:59.45,2:35:02.29,Default,,0,0,0,,Мен кейінгі өңдеулер жасадым.
Dialogue: 0,2:35:02.29,2:35:06.96,Default,,0,0,0,,Мен сенің ешқандай жамандық айтқың келмейтініңді білемін. Бірақ сен уәде бердің.
Dialogue: 0,2:35:06.96,2:35:09.63,Default,,0,0,0,,Егер сіз өз қабілеттеріңізді басқара алмасаңыз және зиян келтірсеңіз
Dialogue: 0,2:35:09.63,2:35:13.90,Default,,0,0,0,,Ғылыми-зерттеу институтына оралғанда. 《Директор, сіз қартайдыңыз~》
Dialogue: 0,2:35:13.90,2:35:15.90,Default,,0,0,0,,<Шындықтан қашу>
Dialogue: 0,2:35:15.90,2:35:20.07,Default,,0,0,0,,Я, қартаюы сөзсіз.
Dialogue: 0,2:35:20.07,2:35:23.91,Default,,0,0,0,,Біз соңғы рет Секине-кун орта мектепке кірер алдында кездестік.
Dialogue: 0,2:35:23.91,2:35:28.42,Default,,0,0,0,,<Режиссер де экстрасенс. Айтпақшы, A-класс>
Dialogue: 0,2:35:28.42,2:35:31.42,Default,,0,0,0,,Мен зертханаға оралуға келісемін.
Dialogue: 0,2:35:31.42,2:35:33.92,Default,,0,0,0,,Әзірше барлығына түсіндіруге рұқсат етіңіз...
Dialogue: 0,2:35:33.92,2:35:36.59,Default,,0,0,0,,Сен менің досым болсаң, мен оны бұрынғы орнына қояр едім.
Dialogue: 0,2:35:36.59,2:35:38.59,Default,,0,0,0,,Сенімді болыңыз.
Dialogue: 0,2:35:38.59,2:35:41.76,Default,,0,0,0,,Мен сені олардың естеліктерінен өшірдім.
Dialogue: 0,2:35:41.76,2:35:44.96,Default,,0,0,0,,《Жылдам жұмыс істейді》
Dialogue: 0,2:35:47.94,2:35:51.94,Default,,0,0,0,,О? Сен мұнда не істеп жүрсің?
Dialogue: 0,2:35:51.94,2:35:56.28,Default,,0,0,0,,Сіз не істеп жатырсыз? Үшеуміз караоке жасап отырдық. Бұл көңілді болды.
Dialogue: 0,2:35:56.28,2:36:00.61,Default,,0,0,0,,Дұрыс. Бұл менің бірінші рет болды, бірақ маған ұнады!
Dialogue: 0,2:36:00.61,2:36:04.79,Default,,0,0,0,,Иә, иә! Секине-чанның ән айтатын даусының сүйкімділігіне таң қалдым.
Dialogue: 0,2:36:04.79,2:36:07.29,Default,,0,0,0,,Секине? Сіз кім туралы айтып тұрсыз?
Dialogue: 0,2:36:07.29,2:36:10.62,Default,,0,0,0,,Сіз Рикка-чанның досысыз ба? сурет?
Dialogue: 0,2:36:10.62,2:36:13.06,Default,,0,0,0,,А, мен көргім келген бағдарлама бар еді.
Dialogue: 0,2:36:13.06,2:36:16.40,Default,,0,0,0,,Маған тезірек үйге бару керек. (Чиё) кеттік.
Dialogue: 0,2:36:16.40,2:36:19.40,Default,,0,0,0,,Сіз білесіз бе? Сол бағдарлама. Иә, білемін.
Dialogue: 0,2:36:19.40,2:36:21.74,Default,,0,0,0,,Осы арқылы айта аласыз ба? Мен түссіндім.
Dialogue: 0,2:36:21.74,2:36:24.07,Default,,0,0,0,,《Секине ханым қайда кетті? 》
Dialogue: 0,2:36:24.07,2:36:30.47,Default,,0,0,0,,<А-сыныптағы экстрасенстердің ұлы күштері де шетелдіктерге әсер еткен жоқ>
Dialogue: 0,2:36:32.41,2:36:34.92,Default,,0,0,0,,Бүгін тыныш емес пе?
Dialogue: 0,2:36:34.92,2:36:37.25,Default,,0,0,0,,Ойланып қарасақ, бұл рас.
Dialogue: 0,2:36:37.25,2:36:40.42,Default,,0,0,0,,Әрқашан жандырақ болып көрінетін.
Dialogue: 0,2:36:40.42,2:36:44.76,Default,,0,0,0,,Бұл менің қиялым ғана. Иә, бұл менің қиялым ғана.
Dialogue: 0,2:36:44.76,2:36:48.93,Default,,0,0,0,,《Рикка: Неге бәрі Секине миссті ұмытып кетті?
Dialogue: 0,2:36:48.93,2:36:52.77,Default,,0,0,0,,Жер тұрғындары үшін мұндай нәрсе әдеттегідей ме? 》
Dialogue: 0,2:36:52.77,2:36:56.44,Default,,0,0,0,,Эй, мен сенің досың туралы айтып отырмын.
Dialogue: 0,2:36:56.44,2:37:00.11,Default,,0,0,0,,Караокеде қандай да бір қабілет бар ма? Бұл таңқаларлық нәрсе болып шықты
Dialogue: 0,2:37:00.11,2:37:03.28,Default,,0,0,0,,Мені үлкен ұйымнан біреу алып кетті.
Dialogue: 0,2:37:03.28,2:37:05.28,Default,,0,0,0,,Бұл жиі кездеседі ме?
Dialogue: 0,2:37:05.28,2:37:07.95,Default,,0,0,0,,《Караокеде мен керемет қабілеттерге ие екенімді білдім.
Dialogue: 0,2:37:07.95,2:37:10.95,Default,,0,0,0,,Сізді үлкен ұйымнан біреу алып кетеді...》
Dialogue: 0,2:37:10.95,2:37:15.06,Default,,0,0,0,,Менің кеңсемде бар ма екен?
Dialogue: 0,2:37:15.06,2:37:17.89,Default,,0,0,0,,Әншінің дебюті және т.б. Дұрыс.
Dialogue: 0,2:37:17.89,2:37:20.89,Default,,0,0,0,,Сонда бәрі бала туралы ұмытады ма?
Dialogue: 0,2:37:20.89,2:37:24.40,Default,,0,0,0,,Мм... Мен алыс адам болып кететін шығармын.
Dialogue: 0,2:37:24.40,2:37:27.40,Default,,0,0,0,,Мен көремін. Бірақ... бірақ...
Dialogue: 0,2:37:27.40,2:37:29.90,Default,,0,0,0,,Әнші ретіндегі дебют қандай тамаша!
Dialogue: 0,2:37:29.90,2:37:32.41,Default,,0,0,0,,Достарыңызды қолдаңыз
Dialogue: 0,2:37:32.41,2:37:35.74,Default,,0,0,0,,Дұрыс!
Dialogue: 0,2:37:35.74,2:37:39.41,Default,,0,0,0,,《Арманыңызға бар күшіңізді салыңыз, Секине ханым
Dialogue: 0,2:37:39.41,2:37:42.42,Default,,0,0,0,,Ән айтатын даусыңыз бүкіл галактикада жаңғырық.
Dialogue: 0,2:37:42.42,2:37:44.42,Default,,0,0,0,,Иә!
Dialogue: 0,2:37:54.43,2:37:56.43,Default,,0,0,0,,Мен жалықтым
Dialogue: 0,2:37:56.43,2:37:59.93,Default,,0,0,0,,Мен сенімен сөйлесетін адам болайын ба? бастық!
Dialogue: 0,2:37:59.93,2:38:04.10,Default,,0,0,0,,《Біз әртүрлі ұрпақтар болғандықтан, ортақтығымыз көп емес.》
Dialogue: 0,2:38:04.10,2:38:07.44,Default,,0,0,0,,Кешіріңіз. Мен мұны осында қалдырамын.
Dialogue: 0,2:38:07.44,2:38:09.44,Default,,0,0,0,,«Отоме» ойыны
Dialogue: 0,2:38:09.44,2:38:11.38,Default,,0,0,0,,Рахмет!
Dialogue: 0,2:38:11.38,2:38:14.38,Default,,0,0,0,,Егер сізге тағы бір нәрсе керек болса, маған хабарлаңыз.
Dialogue: 0,2:38:14.38,2:38:17.38,Default,,0,0,0,,Иә, мен бақыттымын!
Dialogue: 0,2:38:17.38,2:38:58.93,Default,,0,0,0,,～
Dialogue: 0,2:38:58.93,2:39:04.43,Default,,0,0,0,,Уф!
Dialogue: 0,2:39:04.43,2:39:06.43,Default,,0,0,0,,Бұл ұят!
Dialogue: 0,2:39:08.44,2:39:10.94,Default,,0,0,0,,(Iris) Ол жұмысы барын айтып, бүгін таңертең кетті.
Dialogue: 0,2:39:10.94,2:39:14.88,Default,,0,0,0,,《Менің ойымша, мұнда да өмір жаман емес.
Dialogue: 0,2:39:14.88,2:39:18.38,Default,,0,0,0,,Жоқ, тек рұқсатсыз көшеге шығуға болмайды.
Dialogue: 0,2:39:18.38,2:39:21.38,Default,,0,0,0,,Бұл бұрынғыдан әлдеқайда жақсы болуы мүмкін.
Dialogue: 0,2:39:21.38,2:39:26.22,Default,,0,0,0,,Жарайды, бұл менің табиғаттан тыс күштерімнен.
Dialogue: 0,2:39:26.22,2:39:30.06,Default,,0,0,0,,Осы уақытқа дейін көп нәрсе болды》
Dialogue: 0,2:39:30.06,2:39:34.39,Default,,0,0,0,,Эй, сен маған үй тапсырмасын көрсете аласың ба? Мен ұмыттым
Dialogue: 0,2:39:34.39,2:39:36.40,Default,,0,0,0,,Біз доспыз, солай ма?
Dialogue: 0,2:39:36.40,2:39:38.40,Default,,0,0,0,,《Біз шынымен дос емеспіз》
Dialogue: 0,2:39:38.40,2:39:41.90,Default,,0,0,0,,《Мен сенімен араласып тұрмын, өйткені сен маған үй тапсырмасын көрсетесің》
Dialogue: 0,2:39:41.90,2:39:44.24,Default,,0,0,0,,《Себебі мен адамдардың ойын оқи аламын.
Dialogue: 0,2:39:44.24,2:39:47.91,Default,,0,0,0,,Кішкентай кезімнен достарым көп болмады.
Dialogue: 0,2:39:47.91,2:39:51.41,Default,,0,0,0,,Табиғаттан тыс күштерге ие отбасы мүшелерінің тірі немесе өлі екені белгісіз.
Dialogue: 0,2:39:51.41,2:39:55.42,Default,,0,0,0,,Жалғыз аман қалуды армандадым.
Dialogue: 0,2:39:55.42,2:40:00.09,Default,,0,0,0,,Соған қарамастан мен одан да көп қиындықты шешуге мәжбүр болдым.
Dialogue: 0,2:40:00.09,2:40:03.76,Default,,0,0,0,,Бұрынғы ниндзя Чио-санға, шетелдік полковник Риккаға
Dialogue: 0,2:40:03.76,2:40:07.43,Default,,0,0,0,,Цубаса кәдімгі бала, бірақ неге екені белгісіз оның ойын оқи алмаймын.
Dialogue: 0,2:40:07.43,2:40:11.60,Default,,0,0,0,,Бүгін ауа-райы жақсы! Бұлтты
Dialogue: 0,2:40:11.60,2:40:14.94,Default,,0,0,0,,Рикка: Таспаны дұрыстап байлап алайық!
Dialogue: 0,2:40:14.94,2:40:16.94,Default,,0,0,0,,Бұл... ауырады, ауырады
Dialogue: 0,2:40:16.94,2:40:19.94,Default,,0,0,0,,《Мен әрқашан жағдайды түзеуге қиналдым.
Dialogue: 0,2:40:19.94,2:40:24.44,Default,,0,0,0,,Қызық, мен кеткеннен кейін сол үшеуі жақсы бола ма?
Dialogue: 0,2:40:24.44,2:40:26.95,Default,,0,0,0,,Чио-сан оңай жылайды.
Dialogue: 0,2:40:26.95,2:40:29.95,Default,,0,0,0,,Мен уайымдап отырмын, өйткені бірдеңе болып қалса, өзіңді кінәлайсың.
Dialogue: 0,2:40:29.95,2:40:32.62,Default,,0,0,0,,Полковник Жерге әлі үйренген жоқ.
Dialogue: 0,2:40:32.62,2:40:35.62,Default,,0,0,0,,Сіз оғаш ештеңе істеп жатқан жоқсыз деп үміттенемін.
Dialogue: 0,2:40:35.62,2:40:37.96,Default,,0,0,0,,Цубаса екеуміз көп ұрыстық.
Dialogue: 0,2:40:37.96,2:40:42.46,Default,,0,0,0,,Бірақ ол өте жақсы жігіт, сондықтан біз бір-бірімізді оңай таныдық.
Dialogue: 0,2:40:42.46,2:40:45.63,Default,,0,0,0,,Ұйымдастырушы Цубаса болатынына сенімдімін.
Dialogue: 0,2:40:45.63,2:40:50.97,Default,,0,0,0,,Иә, бәрі жақсы. Бұл үшеуі жақсы тіл табыса алады.
Dialogue: 0,2:40:50.97,2:40:57.48,Default,,0,0,0,,Ах, енді ойлап қарасам, келесі аптада бәріміз сыртқа парфе жеуге уәде бердік.
Dialogue: 0,2:40:57.48,2:41:03.48,Default,,0,0,0,,Өзім бітіре алмаған үлкен парфей. Мен оны қайтадан жегім келді.
Dialogue: 0,2:41:03.48,2:41:06.99,Default,,0,0,0,,Жоқ, қобалжудың қажеті жоқ.
Dialogue: 0,2:41:06.99,2:41:08.99,Default,,0,0,0,,Тірі болсам бір күні
Dialogue: 0,2:41:08.99,2:41:11.43,Default,,0,0,0,,Үлкен парфе жейтін күн келеді!
Dialogue: 0,2:41:11.43,2:41:13.43,Default,,0,0,0,,Біздің отбасылық ұранымыз
Dialogue: 0,2:41:13.43,2:41:15.93,Default,,0,0,0,,«Өмірді ұста» Неге! 》
Dialogue: 0,2:41:15.93,2:41:18.43,Default,,0,0,0,,Секине-чан
Dialogue: 0,2:41:26.44,2:41:29.94,Default,,0,0,0,,Мен тек түсті қағазды қалдыруды жоспарладым.
Dialogue: 0,2:41:29.94,2:41:33.11,Default,,0,0,0,,Мен өзімді жалғыз сезіндім, сондықтан мен сені шақырдым.
Dialogue: 0,2:41:33.11,2:41:36.12,Default,,0,0,0,,Мен өзімді жалғыз сезінбеймін...
Dialogue: 0,2:41:36.12,2:41:39.79,Default,,0,0,0,,Солай ма? Сонда сен неге жылайсың?
Dialogue: 0,2:41:39.79,2:41:42.46,Default,,0,0,0,,Ах...
Dialogue: 0,2:41:42.46,2:41:44.96,Default,,0,0,0,,Мен жыламаймын
Dialogue: 0,2:41:44.96,2:41:48.63,Default,,0,0,0,,Тағы не бар? Бұл қандай түсті қағаз? (Иіскеу дыбысы)
Dialogue: 0,2:41:48.63,2:41:52.13,Default,,0,0,0,,Бұл Секине-чанға жігер беретін хабар.
Dialogue: 0,2:41:52.13,2:41:55.53,Default,,0,0,0,,Қолыңнан келгеннің бәрін жаса, Чио-сан мен Цубаса-чан!
Dialogue: 0,2:42:03.48,2:42:06.65,Default,,0,0,0,,Мен үшін алаңдама
Dialogue: 0,2:42:06.65,2:42:09.65,Default,,0,0,0,,Негізі бұл жерде достардың болуы ережеге қайшы.
Dialogue: 0,2:42:09.65,2:42:12.25,Default,,0,0,0,,Егер мен білсем, тіпті Рикка да...
Dialogue: 0,2:42:12.25,2:42:16.09,Default,,0,0,0,,Мен физикалық емтихан тапсырамын, сондықтан киімімді ауыстыруым керек.
Dialogue: 0,2:42:16.09,2:42:18.09,Default,,0,0,0,,Қазір үйге бара аласыз ба?
Dialogue: 0,2:42:18.09,2:42:20.43,Default,,0,0,0,,Секине-чан... аа
Dialogue: 0,2:42:20.43,2:42:23.76,Default,,0,0,0,,Ауызға сиып алғанға дейін және кейін «мырза» деп айт! Түсіндің бе, құрттар?
Dialogue: 0,2:42:23.76,2:42:25.93,Default,,0,0,0,,Мырза! Иә!
Dialogue: 0,2:42:25.93,2:42:28.27,Default,,0,0,0,,Сәлеметсіз бе? (Цубаса) А, Рикка?
Dialogue: 0,2:42:28.27,2:42:32.61,Default,,0,0,0,,Сен досыңа түрлі-түсті қағаз бердің бе? Мен оны саған берейін деп едім.
Dialogue: 0,2:42:32.61,2:42:36.11,Default,,0,0,0,,Мен көремін. Көрдің бе, үлкен әпкем... інім...
Dialogue: 0,2:42:36.11,2:42:38.78,Default,,0,0,0,,Мен сізден оның қай кеңсе екенін айтуыңызды өтіндім.
Dialogue: 0,2:42:38.78,2:42:40.95,Default,,0,0,0,,Менің ойымша, қазір қиын.
Dialogue: 0,2:42:40.95,2:42:43.62,Default,,0,0,0,,Енді әлгі бала жылап, киімін шешпек болып жатыр.
Dialogue: 0,2:42:43.62,2:42:47.29,Default,,0,0,0,,Иә? Бұл не, қандай жағдай!? Амал жоқ...
Dialogue: 0,2:42:47.29,2:42:50.96,Default,,0,0,0,,《Бұл өте жаман емес пе? 》
Dialogue: 0,2:42:50.96,2:42:54.46,Default,,0,0,0,,Бұл... Жақсысың ба? Бала мұнымен келіседі ме?
Dialogue: 0,2:42:54.46,2:42:56.46,Default,,0,0,0,,Хмм...
Dialogue: 0,2:42:58.47,2:43:01.47,Default,,0,0,0,,Ауырсынатын көрінеді. Мен түсінемін.
Dialogue: 0,2:43:01.47,2:43:04.47,Default,,0,0,0,,Сіздің пайымдауыңыз бұзылған болуы мүмкін.
Dialogue: 0,2:43:04.47,2:43:07.81,Default,,0,0,0,,Бұны жаман ересектер пайдаланып жатқан шығар.
Dialogue: 0,2:43:07.81,2:43:10.81,Default,,0,0,0,,Рикка оны тоқтатқаны жақсы емес пе?
Dialogue: 0,2:43:10.81,2:43:13.41,Default,,0,0,0,,Иә. Рахмет, Цубаса-чан.
Dialogue: 0,2:43:13.41,2:43:15.42,Default,,0,0,0,,()
Dialogue: 0,2:43:15.42,2:43:19.59,Default,,0,0,0,,Секине-чан, бірге қашайық!
Dialogue: 0,2:43:19.59,2:43:22.76,Default,,0,0,0,,Рикка сен үшін бірдеңе жасайды!
Dialogue: 0,2:43:22.76,2:43:26.76,Default,,0,0,0,,Керісінше, қызыл мен ақ армандарыңыздан бас тартыңыз.
Dialogue: 0,2:43:26.76,2:43:28.76,Default,,0,0,0,,Не? Иә...
Dialogue: 0,2:43:28.76,2:43:32.93,Default,,0,0,0,,Жақсы дос таптыңыз, Секине-күн. Директор!
Dialogue: 0,2:43:32.93,2:43:35.43,Default,,0,0,0,,Мен жат планеталықтар келеді деп ойламадым.
Dialogue: 0,2:43:42.44,2:43:44.44,Default,,0,0,0,,《Тамаша
Dialogue: 0,2:43:44.44,2:43:48.95,Default,,0,0,0,,Осы үлгі арқылы мен қуат аламын.
Dialogue: 0,2:43:48.95,2:43:52.95,Default,,0,0,0,,Бұл трагедияны қайталамау үшін күш》
Dialogue: 0,2:43:52.95,2:43:55.62,Default,,0,0,0,,Ол жас, сүйкімді және жақсы аспаз.
Dialogue: 0,2:43:55.62,2:43:58.96,Default,,0,0,0,,Сұлулықты ұнататын, мінезі жақсы адамдар тым сараң бола ма?
Dialogue: 0,2:43:58.96,2:44:04.46,Default,,0,0,0,,Маған махаббат керек емес. Сіз мені сөйлейтін банкомат деп ойласаңыз да!
Dialogue: 0,2:44:04.46,2:44:07.13,Default,,0,0,0,,Бірақ бұл 100-ші реттелген неке кездесуі.
Dialogue: 0,2:44:07.13,2:44:11.14,Default,,0,0,0,,Қарғыс атсын... Жылдық табыстың күші болса ғой!
Dialogue: 0,2:44:11.14,2:44:15.58,Default,,0,0,0,,《Алайда, егер сіз осы үлгі бойынша зерттеуіңізді жарияласаңыз, сіз міндетті түрде жалақы аласыз.
Dialogue: 0,2:44:15.58,2:44:17.91,Default,,0,0,0,,Үйленген неке де сәтті болуы керек》
Dialogue: 0,2:44:17.91,2:44:19.91,Default,,0,0,0,,《Ойларды оқи алмаймын, бірақ
Dialogue: 0,2:44:19.91,2:44:22.92,Default,,0,0,0,,Мен шектен шыққан бірдеңе ойлап тұрғандай сезінемін.
Dialogue: 0,2:44:22.92,2:44:26.42,Default,,0,0,0,,<Дұрыс сияқты, өшіп қалған сияқты...>
Dialogue: 0,2:44:26.42,2:44:30.26,Default,,0,0,0,,Маған жақсы мүмкіндік бергеніңіз үшін рахмет ретінде Секине-күнді жіберіп алайын.
Dialogue: 0,2:44:30.26,2:44:32.26,Default,,0,0,0,,Иә? Оның орнына
Dialogue: 0,2:44:32.26,2:44:36.76,Default,,0,0,0,,Сіз бөтен досыңыз туралы үндемей аласыз ба?
Dialogue: 0,2:44:36.76,2:44:40.56,Default,,0,0,0,,Қоштасқың келсе, қазір.
Dialogue: 0,2:44:45.61,2:44:49.61,Default,,0,0,0,,Сіз мұндай нәрсені жасамас едіңіз!
Dialogue: 0,2:44:49.61,2:44:53.95,Default,,0,0,0,,Рикка - қымбатты дос! Мен достарыма опасыздық жасамаймын!
Dialogue: 0,2:44:53.95,2:44:55.95,Default,,0,0,0,,Рикка Ән айтыңызшы!
Dialogue: 0,2:44:55.95,2:44:58.12,Default,,0,0,0,,Мен толқығым келеді!
Dialogue: 0,2:44:58.12,2:45:00.12,Default,,0,0,0,,Ой, түсіндім...
Dialogue: 0,2:45:00.12,2:45:05.79,Default,,0,0,0,,Бое~
Dialogue: 0,2:45:05.79,2:45:07.79,Default,,0,0,0,,Ішек
Dialogue: 0,2:45:07.79,2:45:09.99,Default,,0,0,0,,Хэхехехе...
Dialogue: 0,2:45:13.90,2:45:16.40,Default,,0,0,0,,Көмегің үшін рахмет, Рикка.
Dialogue: 0,2:45:16.40,2:45:18.41,Default,,0,0,0,,Ха!
Dialogue: 0,2:45:18.41,2:45:21.91,Default,,0,0,0,,Қазір қашыңыз! Секине-чан!
Dialogue: 0,2:45:21.91,2:45:28.75,Default,,0,0,0,,Не? Ал, сол жерден!
Dialogue: 0,2:45:28.75,2:45:32.75,Default,,0,0,0,,Енді қаш! Smokey!
Dialogue: 0,2:45:32.75,2:45:35.09,Default,,0,0,0,,Бұл кім?
Dialogue: 0,2:45:35.09,2:45:38.43,Default,,0,0,0,,Уф...
Dialogue: 0,2:45:38.43,2:45:42.10,Default,,0,0,0,,Мен мұнда не істеп жүрмін?
Dialogue: 0,2:45:42.10,2:45:45.10,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,2:45:45.10,2:45:49.94,Default,,0,0,0,,Эй, менің артымнан біреу келе жатыр ма? Ал, сіз қалай ойлайсыз?
Dialogue: 0,2:45:49.94,2:45:53.11,Default,,0,0,0,,Олар мені қуып кетсе де, менің ойымша, бұл қалай болады?
Dialogue: 0,2:45:53.11,2:45:56.78,Default,,0,0,0,,А... білесің бе, Секине-чан?
Dialogue: 0,2:45:56.78,2:46:00.78,Default,,0,0,0,,Бұрынғы Рикка деген адам жат планеталық...
Dialogue: 0,2:46:00.78,2:46:02.78,Default,,0,0,0,,Жұлдызды аспан... Иә?
Dialogue: 0,2:46:02.78,2:46:04.78,Default,,0,0,0,,Бұл әдемі.
Dialogue: 0,2:46:04.78,2:46:07.79,Default,,0,0,0,,Жер ғарыштан қарағанда әдемі болып көрінеді ме?
Dialogue: 0,2:46:07.79,2:46:11.39,Default,,0,0,0,,Иә. Ол көгілдір жарқырайды және өте әдемі!
Dialogue: 0,2:46:11.39,2:46:13.89,Default,,0,0,0,,Менің ойымша, бөтен адам мұны айтады!
Dialogue: 0,2:46:13.89,2:46:18.40,Default,,0,0,0,,Мен көремін. Күшті. Мен оны бір күні көргім келеді.
Dialogue: 0,2:46:18.40,2:46:22.90,Default,,0,0,0,,Ондай жағдайда мен Секине-чанды НЛО-мен ғарышқа апарамын!
Dialogue: 0,2:46:22.90,2:46:26.07,Default,,0,0,0,,Менің ойымша, бөтен адам мұны айтады!
Dialogue: 0,2:46:26.07,2:46:30.08,Default,,0,0,0,,Егер осындай жат планеталық болса, мен оның досы болғым келеді.
Dialogue: 0,2:46:30.08,2:46:34.41,Default,,0,0,0,,Сәлем Секине-чан
Dialogue: 0,2:46:34.41,2:46:39.09,Default,,0,0,0,,Рикка дәл қазір Секине-чанды ғарышқа апара алмайды.
Dialogue: 0,2:46:39.09,2:46:43.26,Default,,0,0,0,,Егер сізде қиындық туындаса, бізбен кеңесіңіз.
Dialogue: 0,2:46:43.26,2:46:45.76,Default,,0,0,0,,Рикка үшін!
Dialogue: 0,2:46:45.76,2:46:49.60,Default,,0,0,0,,Оны өзім шешемін.
Dialogue: 0,2:46:49.60,2:46:52.50,Default,,0,0,0,,Негізінен
Dialogue: 0,2:46:55.94,2:46:58.10,Default,,0,0,0,,Қайырлы таң Секине
Dialogue: 0,2:46:58.10,2:47:01.44,Default,,0,0,0,,Қайырлы күн, Секине мырза
Dialogue: 0,2:47:01.44,2:47:03.94,Default,,0,0,0,,Не? Не болды?
Dialogue: 0,2:47:03.94,2:47:07.45,Default,,0,0,0,,Жоқ... бұл ештеңе емес. Қайырлы таң.
Dialogue: 0,2:47:07.45,2:47:11.12,Default,,0,0,0,,《Жарайды, барлығының естеліктері қалыпты жағдайға оралған сияқты.》
Dialogue: 0,2:47:11.12,2:47:15.06,Default,,0,0,0,,《Полковник есте сақтау қабілетін қалпына келтірді ме?》
Dialogue: 0,2:47:15.06,2:47:19.06,Default,,0,0,0,,Дұрыс. Бүгін сабақтан кейін бәріміз үлкен парфе жейміз бе?
Dialogue: 0,2:47:19.06,2:47:21.90,Default,,0,0,0,,Бұл жақсы ұсыныс!
Dialogue: 0,2:47:21.90,2:47:24.40,Default,,0,0,0,,Иә, кеттік, кеттік! (Цубаса) Жақсы!
Dialogue: 0,2:47:26.73,2:47:30.07,Default,,0,0,0,,Бұл соңғы шайқас. Барайық.
Dialogue: 0,2:47:30.07,2:47:32.24,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,2:47:32.24,2:47:35.41,Default,,0,0,0,,《Мәселені осылай шешеді! 》
Dialogue: 0,2:47:35.41,2:47:39.41,Default,,0,0,0,,《Тағдырымды қай картаға сеніп тапсыруым керек?》
Dialogue: 0,2:47:39.41,2:47:42.92,Default,,0,0,0,,＜ Бұл жағдайдың себебі бар.
Dialogue: 0,2:47:42.92,2:47:45.92,Default,,0,0,0,,Бұл түскі үзілістен кейін болды＞
Dialogue: 0,2:47:45.92,2:47:50.42,Default,,0,0,0,,Назар аударыңыз! Мен сүйікті әйелімнің бентосын әкелуді ұмытып кетіппін.
Dialogue: 0,2:47:50.42,2:47:54.43,Default,,0,0,0,,Мына нанды біреуге берем!
Dialogue: 0,2:47:54.43,2:47:57.26,Default,,0,0,0,,Уф! Міне бітті!
Dialogue: 0,2:47:57.26,2:47:59.43,Default,,0,0,0,,Мектеп асханасында күніне 10 данамен шектелген.
Dialogue: 0,2:47:59.43,2:48:02.10,Default,,0,0,0,,Нағыз қауын целлюлозасы мол өте жоғары сапалы қауын наны!
Dialogue: 0,2:48:02.10,2:48:04.10,Default,,0,0,0,,Мен... жегім келеді!
Dialogue: 0,2:48:04.10,2:48:08.44,Default,,0,0,0,,Мен де жасап көргім келеді. Төртеумізбен бөлісе алмаймыз ба?
Dialogue: 0,2:48:08.44,2:48:10.44,Default,,0,0,0,,Кешіріңіз Чио-сан
Dialogue: 0,2:48:10.44,2:48:12.88,Default,,0,0,0,,Тек осы қауын нанын бөлуге болмайды.
Dialogue: 0,2:48:12.88,2:48:15.55,Default,,0,0,0,,Мен де бір жегім келеді!
Dialogue: 0,2:48:15.55,2:48:17.55,Default,,0,0,0,,Рикка да!
Dialogue: 0,2:48:17.55,2:48:20.89,Default,,0,0,0,,Тас, қағаз, қайшы картасы бар. Осымен ойнайық
Dialogue: 0,2:48:20.89,2:48:26.49,Default,,0,0,0,,<Содан кейін Чиё мен полковник Рикка жеңіледі, ал Секине мен Цубаса жеке жекпе-жекке шығады>
Dialogue: 0,2:48:29.06,2:48:31.06,Default,,0,0,0,,Мен жеңемін
Dialogue: 0,2:48:31.06,2:48:34.73,Default,,0,0,0,,Жеңіске жетсең, лас өміріңнен жоғары көтерілесің.
Dialogue: 0,2:48:34.73,2:48:37.40,Default,,0,0,0,,Егер сіз жеңбесеңіз, сіз қоқыссыз!
Dialogue: 0,2:48:37.40,2:48:39.91,Default,,0,0,0,,Кім жеңсе де, кек сақтамаймын!
Dialogue: 0,2:48:39.91,2:48:41.91,Default,,0,0,0,,Жарайды!
Dialogue: 0,2:48:41.91,2:48:47.75,Default,,0,0,0,,Жақсысың ба, Цубаса? Сіздің өміріңіз сол картаға байланысты, солай ма?
Dialogue: 0,2:48:47.75,2:48:50.58,Default,,0,0,0,,Гүлп.
Dialogue: 0,2:48:50.58,2:48:56.76,Default,,0,0,0,,Хехе, келесі шығаратыным...
Dialogue: 0,2:48:56.76,2:48:59.09,Default,,0,0,0,,Пар!
Dialogue: 0,2:48:59.09,2:49:03.76,Default,,0,0,0,,《Пар? Сонда мен...
Dialogue: 0,2:49:03.76,2:49:06.77,Default,,0,0,0,,Бұл қайшымен ойнасаңыз, жеңе аласыз дегенді білдіре ме?
Dialogue: 0,2:49:06.77,2:49:11.87,Default,,0,0,0,,Жоқ, сіз алданбайсыз! 》 Маған сеніңізші.
Dialogue: 0,2:49:11.87,2:49:15.54,Default,,0,0,0,,<Секиненің жеңілмеуге себебі бар еді>
Dialogue: 0,2:49:15.54,2:49:17.88,Default,,0,0,0,,Сіздің бағаларыңыз төмендейді.
Dialogue: 0,2:49:17.88,2:49:21.88,Default,,0,0,0,,Сіз стипендия ала алмауыңыз мүмкін. Эх!
Dialogue: 0,2:49:21.88,2:49:24.55,Default,,0,0,0,,Мен соңғы кездері Чионың оқуын бақылап жүрмін.
Dialogue: 0,2:49:24.55,2:49:27.39,Default,,0,0,0,,Себебі мен оқуыма немқұрайлы қарадым.
Dialogue: 0,2:49:27.39,2:49:31.06,Default,,0,0,0,,Стипендиям тоқтатылған жағдайда ақша үнемдеуім керек.
Dialogue: 0,2:49:31.06,2:49:33.73,Default,,0,0,0,,《Тамаққа кететін шығынды азайтып, жеңіл тамақ жеме.
Dialogue: 0,2:49:33.73,2:49:35.73,Default,,0,0,0,,Мен ақшаны мұқият жинадым.
Dialogue: 0,2:49:35.73,2:49:40.07,Default,,0,0,0,,Мен бұл ойында жеңіп, біраз уақыттан кейін бірінші рет дәмді нәрсе жегім келеді.
Dialogue: 0,2:49:40.07,2:49:42.07,Default,,0,0,0,,(Найзағай)
Dialogue: 0,2:49:42.07,2:49:46.74,Default,,0,0,0,,《Кешіріңіз, бірақ мен бұл матчтан бас тарта алмаймын.》
Dialogue: 0,2:49:46.74,2:49:50.74,Default,,0,0,0,,<Цубасаның да жеңілмеуге себебі бар еді>
Dialogue: 0,2:49:50.74,2:49:55.08,Default,,0,0,0,,Цубаса: Маған мектеп асханасында сатылатын өте жоғары сапалы қауын нан сатып алшы~. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,2:49:55.08,2:49:58.42,Default,,0,0,0,,《Мен күнде мектеп асханасына жүгіретінмін, бірақ ол үнемі сатылып кететін.
Dialogue: 0,2:49:58.42,2:50:00.75,Default,,0,0,0,,Мен оны үйге әкелуім керек...》
Dialogue: 0,2:50:00.75,2:50:04.42,Default,,0,0,0,,Мен сені жер астына жіберіп, болат жақтауды кесіп өтейін!
Dialogue: 0,2:50:04.42,2:50:07.09,Default,,0,0,0,,《Сен Секине сеніп, жұдырықтайсың ба?
Dialogue: 0,2:50:07.09,2:50:09.93,Default,,0,0,0,,Әлде сенбейсіз бе?
Dialogue: 0,2:50:09.93,2:50:13.10,Default,,0,0,0,,Жоқ, олар мені одан да алдайтын шығар.
Dialogue: 0,2:50:13.10,2:50:15.10,Default,,0,0,0,,Зава Зава…》
Dialogue: 0,2:50:15.10,2:50:17.77,Default,,0,0,0,,Осы қарқынмен түскі үзіліс аяқталады!
Dialogue: 0,2:50:17.77,2:50:19.77,Default,,0,0,0,,Рикка мұны түсінді...
Dialogue: 0,2:50:19.77,2:50:21.94,Default,,0,0,0,,Гууууууууууууууууууууууууууу!
Dialogue: 0,2:50:21.94,2:50:24.94,Default,,0,0,0,,<Нан өмірден ауыр>
Dialogue: 0,2:50:24.94,2:50:27.45,Default,,0,0,0,,Енді шайқас! Ал...
Dialogue: 0,2:50:27.45,2:50:29.78,Default,,0,0,0,,Бір минут күтіңіз! иә?
Dialogue: 0,2:50:29.78,2:50:33.45,Default,,0,0,0,,Пара алатынмын дегенде жұдырықтай бермейсің ғой?
Dialogue: 0,2:50:33.45,2:50:35.46,Default,,0,0,0,,Иә
Dialogue: 0,2:50:35.46,2:50:37.79,Default,,0,0,0,,Wow~｡ <4 секунд қалды>
Dialogue: 0,2:50:37.79,2:50:40.79,Default,,0,0,0,,Сіз шынымен тең дәрежеге жеттіңіз, солай ма?
Dialogue: 0,2:50:40.79,2:50:42.80,Default,,0,0,0,,Иә
Dialogue: 0,2:50:42.80,2:50:46.13,Default,,0,0,0,,Иа, сен 100% жетістікке жете алмайтын типсің!
Dialogue: 0,2:50:46.13,2:50:48.13,Default,,0,0,0,,Не?
Dialogue: 0,2:50:53.47,2:50:56.48,Default,,0,0,0,,Цу-е-фа!
Dialogue: 0,2:50:56.48,2:50:58.48,Default,,0,0,0,,Не!
Dialogue: 0,2:50:58.48,2:51:00.48,Default,,0,0,0,,Сіз байқаған жоқсыз деп ойлаймын.
Dialogue: 0,2:51:00.48,2:51:02.82,Default,,0,0,0,,Секине бірдеңе үшін өзін кінәлі сезінгенде
Dialogue: 0,2:51:02.82,2:51:05.15,Default,,0,0,0,,Менің қасым сәл ғана көтеріледі.
Dialogue: 0,2:51:05.15,2:51:07.15,Default,,0,0,0,,Ха!
Dialogue: 0,2:51:07.15,2:51:09.66,Default,,0,0,0,,Қайшысын алғың келе ме деп сұрасам, қабағы көтерілмеді.
Dialogue: 0,2:51:09.66,2:51:13.93,Default,,0,0,0,,Бірақ мен парақты жасаймын ба деп сұрағанда...
Dialogue: 0,2:51:13.93,2:51:16.76,Default,,0,0,0,,Сол себепті парыз аламын деу өтірік.
Dialogue: 0,2:51:16.76,2:51:18.77,Default,,0,0,0,,Мен мұның көңілді болатынын білдім!
Dialogue: 0,2:51:18.77,2:51:22.44,Default,,0,0,0,,<12 секунд аяқталды>
Dialogue: 0,2:51:22.44,2:51:25.77,Default,,0,0,0,,Құттықтаймыз Цубаса-сан. Хахаха... Рахмет!
Dialogue: 0,2:51:25.77,2:51:28.61,Default,,0,0,0,,＜Осыдан кейін әпкем мені өлтірді＞
Dialogue: 0,2:51:28.61,2:51:31.44,Default,,0,0,0,,Рагудан басқа да тағамдарды мүмкіндігінше тезірек жақсы пісіре білгім келеді.
Dialogue: 0,2:51:31.44,2:51:33.45,Default,,0,0,0,,Иә!
Dialogue: 0,2:51:33.45,2:51:37.45,Default,,0,0,0,,Бу Бу Бу Бу... Геро
Dialogue: 0,2:51:37.45,2:51:39.79,Default,,0,0,0,,Мен кездейсоқ ұмытып қалдым
Dialogue: 0,2:51:39.79,2:51:42.46,Default,,0,0,0,,Рикка да шектеулі нан алды.
Dialogue: 0,2:51:42.46,2:51:45.06,Default,,0,0,0,,Келіңіздер! Рикка…
Dialogue: 0,2:51:53.97,2:51:57.47,Default,,0,0,0,,《Қатты суық》
Dialogue: 0,2:55:13.43,2:55:15.43,Default,,0,0,0,,Ханзо!
Dialogue: 0,2:55:15.43,2:55:20.11,Default,,0,0,0,,Егер сіз оны бетпе-бет ұра алмасаңыз, оны артқы жағынан ұрыңыз.
Dialogue: 0,2:55:20.11,2:55:24.44,Default,,0,0,0,,Чионың әлсіз жақтарын білу керек.
Dialogue: 0,2:55:24.44,2:55:27.11,Default,,0,0,0,,Чионың әлсіздігі? Хмм
Dialogue: 0,2:55:27.11,2:55:29.78,Default,,0,0,0,,《Мұндай нәрсе болуы мүмкін емес.
Dialogue: 0,2:55:29.78,2:55:32.62,Default,,0,0,0,,Жастайынан кез келген жаттығуға шыдады.
Dialogue: 0,2:55:32.62,2:55:37.46,Default,,0,0,0,,Бірде-бір әлсіз дауысты шығармайтын Чионың әлсіздігі бар...
Dialogue: 0,2:55:37.46,2:55:42.46,Default,,0,0,0,,Жоқ, бұрынғыдай емес, Чиё қазір...
Dialogue: 0,2:55:42.46,2:55:45.46,Default,,0,0,0,,Сіз жеңе аласыз! Бұл жолы Чиё!
Dialogue: 0,2:57:26.43,2:57:30.44,Default,,0,0,0,,Уау! Дәмді көрінеді!
Dialogue: 0,2:57:30.44,2:57:32.44,Default,,0,0,0,,Цубаса-чан да жей ме?
Dialogue: 0,2:57:32.44,2:57:35.44,Default,,0,0,0,,Жарайды, мен диетадамын.
Dialogue: 0,2:57:35.44,2:57:37.94,Default,,0,0,0,,Бұл мүлдем жұқа емес. иә?
Dialogue: 0,2:57:37.94,2:57:41.28,Default,,0,0,0,,Иә, иә. Жоқ, шынымен бе?
Dialogue: 0,2:57:41.28,2:57:45.45,Default,,0,0,0,,Шынымен, шынымен. Уфуфуфу, рахмет. Мен сондай қуаныштымын.
Dialogue: 0,2:57:45.45,2:57:47.62,Default,,0,0,0,,《Секине: Сен тым қыңырсың, солай ма?
Dialogue: 0,2:57:47.62,2:57:50.96,Default,,0,0,0,,Қызық, сіз жігітті осылай қалайсыз ба?
Dialogue: 0,2:57:50.96,2:57:54.46,Default,,0,0,0,,Ол әрқашан сабырлы және бейтарап келбеті бар.
Dialogue: 0,2:57:54.46,2:57:56.96,Default,,0,0,0,,Қыздарға арналған мектепте бұл өзін князьдік сезімге бөледі.
Dialogue: 0,2:57:56.96,2:58:00.80,Default,,0,0,0,,Олай болса, құлпынай жейік~
Dialogue: 0,2:58:00.80,2:58:03.47,Default,,0,0,0,,Мен саған өзімді де беремін. Жарайды?
Dialogue: 0,2:58:03.47,2:58:05.64,Default,,0,0,0,,Жақсы, жақсы.《Әйел тұлғасы》
Dialogue: 0,2:58:05.64,2:58:07.64,Default,,0,0,0,,<Төмен тоқтату>
Dialogue: 0,2:58:07.64,2:58:10.81,Default,,0,0,0,,Әй, дәмді!
Dialogue: 0,2:58:10.81,2:58:14.91,Default,,0,0,0,,《Цура. Барлығымыз парфе жеуге келдік.》
Dialogue: 0,2:58:14.91,2:58:17.08,Default,,0,0,0,,Рикка: Бәріміз бірге тамақтанайық.
Dialogue: 0,2:58:17.08,2:58:21.92,Default,,0,0,0,,《Цубаса: Рикка мен жақсы түсінбейтін бала әкелді.
Dialogue: 0,2:58:21.92,2:58:24.76,Default,,0,0,0,,Чио-сан және басқалары әбден қорқады.
Dialogue: 0,2:58:24.76,2:58:27.93,Default,,0,0,0,,Секиненің де көңілі көтеріліп барады.
Dialogue: 0,2:58:27.93,2:58:30.43,Default,,0,0,0,,Екеуімізді қорғау үшін
Dialogue: 0,2:58:30.43,2:58:33.43,Default,,0,0,0,,Мен ұлдардың назарын осында аудару үшін бар күшімді салуым керек! 》
Dialogue: 0,2:58:33.43,2:58:35.43,Default,,0,0,0,,Иә?
Dialogue: 0,2:58:35.43,2:58:38.44,Default,,0,0,0,,Жоқ, менмін. Менің туыстарымның бәрі атақты адамдар.
Dialogue: 0,2:58:38.44,2:58:40.61,Default,,0,0,0,,Иә?иә?
Dialogue: 0,2:58:40.61,2:58:42.61,Default,,0,0,0,,Ах!
Dialogue: 0,2:58:42.61,2:58:45.95,Default,,0,0,0,,Иә? Шынымен бе? Керемет
Dialogue: 0,2:58:45.95,2:58:47.95,Default,,0,0,0,,Эхехе солай деп ойлаймын.
Dialogue: 0,2:58:47.95,2:58:51.45,Default,,0,0,0,,《Жарайды, хромосомалар туралы бізде жеткілікті ақпарат бар.
Dialogue: 0,2:58:51.45,2:58:54.79,Default,,0,0,0,,Бұл Секине ханымның туған күніне орай келеді.
Dialogue: 0,2:58:54.79,2:58:56.79,Default,,0,0,0,,《Не?》
Dialogue: 0,2:58:56.79,2:58:58.79,Default,,0,0,0,,<Менің миым жете алмайды>
Dialogue: 0,2:58:58.79,2:59:00.96,Default,,0,0,0,,《Менің туған күнім...
Dialogue: 0,2:59:00.96,2:59:03.46,Default,,0,0,0,,Ах! Енді ойлап қарасам, өткен күні...》
Dialogue: 0,2:59:03.46,2:59:08.13,Default,,0,0,0,,Болашақта ұлыммен футбол ойнағым келеді.
Dialogue: 0,2:59:08.13,2:59:10.14,Default,,0,0,0,,...
Dialogue: 0,2:59:10.14,2:59:12.74,Default,,0,0,0,,Мен қызымды қалаймын ба?
Dialogue: 0,2:59:12.74,2:59:17.08,Default,,0,0,0,,А, Секине-чан, қызың керек пе? Иә жақсы
Dialogue: 0,2:59:17.08,2:59:19.08,Default,,0,0,0,,көремін.
Dialogue: 0,2:59:19.08,2:59:23.58,Default,,0,0,0,,Аа, қазір ойлап қарасам, Секине-чанның туған күні жақындап қалды.
Dialogue: 0,2:59:23.58,2:59:25.58,Default,,0,0,0,,Бір минут күтіңіз!
Dialogue: 0,2:59:25.58,2:59:30.42,Default,,0,0,0,,《Сіз бұл маңызды емес чатты сөзбе-сөз түсіндіріп жатырсыз ба?
Dialogue: 0,2:59:30.42,2:59:32.76,Default,,0,0,0,,Спортқа тікелей эфирде көрмейінше қызыға алмайсың
Dialogue: 0,2:59:32.76,2:59:34.76,Default,,0,0,0,,Иә
Dialogue: 0,2:59:34.76,2:59:36.76,Default,,0,0,0,,Құттықтаймыз. Құттықтаймыз.
Dialogue: 0,2:59:36.76,2:59:39.77,Default,,0,0,0,,Туған күнің құтты болсын, Секине-чан!
Dialogue: 0,2:59:39.77,2:59:41.93,Default,,0,0,0,,Келіңіздер, бәріңіз! о?
Dialogue: 0,2:59:41.93,2:59:45.94,Default,,0,0,0,,Орындарды ауыстыратын кез келді. Орындарды ауыстырғыңыз келе ме...?
Dialogue: 0,2:59:45.94,2:59:50.44,Default,,0,0,0,,Иә! Ішінде өзіңізге ұнайтын адамның жанына отырыңыз.
Dialogue: 0,2:59:50.44,2:59:53.45,Default,,0,0,0,,<Білімді қайдан алдың?>
Dialogue: 0,2:59:53.45,2:59:57.95,Default,,0,0,0,,Олай болса, Секине-чаннан бастап орындарымызды ауыстырайық.
Dialogue: 0,2:59:57.95,3:00:00.45,Default,,0,0,0,,Кімнің жанында болғың келеді?
Dialogue: 0,3:00:00.45,3:00:02.62,Default,,0,0,0,,Мм... (3 адам) Иә?
Dialogue: 0,3:00:02.62,3:00:04.62,Default,,0,0,0,,Мен...
Dialogue: 0,3:00:04.62,3:00:08.63,Default,,0,0,0,,Мен бірде-бір жаман адам жоқ деп ойладым.
Dialogue: 0,3:00:08.63,3:00:13.23,Default,,0,0,0,,Ах...｡ Ах, не?
Dialogue: 0,3:00:13.23,3:00:16.90,Default,,0,0,0,,Мүмкін Секине-чан цундере түрі шығар?
Dialogue: 0,3:00:16.90,3:00:20.91,Default,,0,0,0,,Немесе... Мені қате түсінбеңіз! сурет?
Dialogue: 0,3:00:20.91,3:00:24.74,Default,,0,0,0,,Мен сенің балаларыңның ешқайсысын алғым келмейді!
Dialogue: 0,3:00:24.74,3:00:27.08,Default,,0,0,0,,оның шынымен білмегенінің дәлелі.
Dialogue: 0,3:00:27.08,3:00:32.42,Default,,0,0,0,,《Қарғыс атсын! Дәл қазір, бұл жерде мен қателеспес, қателескен, боқ әйелмін
Dialogue: 0,3:00:32.42,3:00:34.75,Default,,0,0,0,,Бірақ мен мұны ғана айта аламын...》
Dialogue: 0,3:00:34.75,3:00:38.92,Default,,0,0,0,,Сондай-ақ... Секине болсам ғой. Ол сондай керемет~
Dialogue: 0,3:00:38.92,3:00:42.26,Default,,0,0,0,,《Не!? Олай болса Мисс Цубасаға ұл беріңіз! 》
Dialogue: 0,3:00:42.26,3:00:45.43,Default,,0,0,0,,Ха! Куораа~ Цубаса!
Dialogue: 0,3:00:45.43,3:00:47.43,Default,,0,0,0,,Ха! Тат! Бюро!
Dialogue: 0,3:00:47.43,3:00:51.10,Default,,0,0,0,,Жігіттерге ұнайды... Жігіттерге мынандай...
Dialogue: 0,3:00:51.10,3:00:54.44,Default,,0,0,0,,Мұндай адамдар жойылып кетуі керек түр!
Dialogue: 0,3:00:54.44,3:00:57.11,Default,,0,0,0,,Басқаша айтқанда, адамзат жойылады!
Dialogue: 0,3:00:57.11,3:00:59.51,Default,,0,0,0,,Бұл не?!
Dialogue: 0,3:01:01.45,3:01:04.78,Default,,0,0,0,,Жарайды... тезірек үйге баруым керек.
Dialogue: 0,3:01:04.78,3:01:07.45,Default,,0,0,0,,Біз алдымен есепшотты төлейміз.
Dialogue: 0,3:01:07.45,3:01:09.46,Default,,0,0,0,,Олай болса...
Dialogue: 0,3:01:09.46,3:01:14.73,Default,,0,0,0,,<Түсінбейтін сұм әйелден қауіпті адамға дейін көтерілу
Dialogue: 0,3:01:14.73,3:01:21.40,Default,,0,0,0,,Тыныш, судың суығандай, ұлдар кетіп қалды>
Dialogue: 0,3:01:21.40,3:01:25.40,Default,,0,0,0,,Секине: Сенің қазіргі көзқарасың сәл болды... Уф.
Dialogue: 0,3:01:25.40,3:01:29.41,Default,,0,0,0,,Оны басқаша айту мүмкін емес пе еді?
Dialogue: 0,3:01:29.41,3:01:32.41,Default,,0,0,0,,Мен ештеңе білмесем де
Dialogue: 0,3:01:32.41,3:01:36.58,Default,,0,0,0,,Бұл әйелдің бетін пирсинг тітіркендіреді! Сіз осылай танымал болғыңыз келе ме?
Dialogue: 0,3:01:36.58,3:01:38.58,Default,,0,0,0,,Ха ха!?
Dialogue: 0,3:01:38.58,3:01:42.25,Default,,0,0,0,,《Мен әркімнің сөйлеуге мәжбүр болғанын қаламаймын.
Dialogue: 0,3:01:42.25,3:01:45.42,Default,,0,0,0,,Қолымнан келгенше тырыссам да...》
Dialogue: 0,3:01:45.42,3:01:52.43,Default,,0,0,0,,Мен... Еркектер арасында танымал боламын деген ниетім жоқ!
Dialogue: 0,3:01:52.43,3:01:57.44,Default,,0,0,0,,Мен қазір үйге бара жатырмын. О, Цубаса-сан!
Dialogue: 0,3:01:57.44,3:01:59.44,Default,,0,0,0,,Ах...
Dialogue: 0,3:02:01.44,3:02:05.11,Default,,0,0,0,,《Бұл жағдайда бірдеңе айту қиын.
Dialogue: 0,3:02:05.11,3:02:07.11,Default,,0,0,0,,Мені кездесуге шақырды...》
Dialogue: 0,3:02:07.11,3:02:09.11,Default,,0,0,0,,Не!
Dialogue: 0,3:02:09.11,3:02:11.31,Default,,0,0,0,,《Полковник, қашан?!》
Dialogue: 0,3:02:13.55,3:02:16.39,Default,,0,0,0,,Ах, Рикка-чан
Dialogue: 0,3:02:16.39,3:02:18.39,Default,,0,0,0,,(ызылдаған)
Dialogue: 0,3:02:18.39,3:02:22.06,Default,,0,0,0,,Күткеніңізге рахмет! Жоқ, мен мұнда жаңа келдім
Dialogue: 0,3:02:22.06,3:02:24.06,Default,,0,0,0,,Эхехе
Dialogue: 0,3:02:24.06,3:02:26.40,Default,,0,0,0,,Мен сенің соңынан ердім.
Dialogue: 0,3:02:26.40,3:02:30.07,Default,,0,0,0,,Отырыңыз. Иә.
Dialogue: 0,3:02:30.07,3:02:32.24,Default,,0,0,0,,《Мен байсалды бола аламын.
Dialogue: 0,3:02:32.24,3:02:34.91,Default,,0,0,0,,Сіз менің серігім сияқты мінсізсіз.》
Dialogue: 0,3:02:34.91,3:02:37.08,Default,,0,0,0,,《Жоқ, бұл жер бетінде
Dialogue: 0,3:02:37.08,3:02:41.41,Default,,0,0,0,,Хиоку Ренриге серіктес тапсам ше?
Dialogue: 0,3:02:41.41,3:02:43.42,Default,,0,0,0,,《Чоро...
Dialogue: 0,3:02:43.42,3:02:47.42,Default,,0,0,0,,Осындай жалқау адамның полковник болғаны дұрыс па деп ойлаймын.
Dialogue: 0,3:02:47.42,3:02:52.42,Default,,0,0,0,,Не? Не? Не? Чи... Чио-сан!?
Dialogue: 0,3:02:52.42,3:02:55.26,Default,,0,0,0,,Уф. 《Кешіріңіз Рикка Чан》
Dialogue: 0,3:02:55.26,3:02:57.43,Default,,0,0,0,,Құт
Dialogue: 0,3:02:57.43,3:03:00.93,Default,,0,0,0,,Досыңызды кепілге алу стратегиясын көрдіңіз бе?
Dialogue: 0,3:03:00.93,3:03:04.60,Default,,0,0,0,,Әрине, Ханзо. Сізден күткендей, әпке.
Dialogue: 0,3:03:04.60,3:03:06.94,Default,,0,0,0,,《Не? Олар ағайынды болды》
Dialogue: 0,3:03:06.94,3:03:09.61,Default,,0,0,0,,Бірақ оның асығыстығына қарап,
Dialogue: 0,3:03:09.61,3:03:13.05,Default,,0,0,0,,Әпкеңнің осал тұсы достары болған сияқты.
Dialogue: 0,3:03:13.05,3:03:15.88,Default,,0,0,0,,Қарғыс атсын! Қандай жексұрын!
Dialogue: 0,3:03:15.88,3:03:20.39,Default,,0,0,0,,Арамызға сен келгендіктен, достығымыз бұзылды!
Dialogue: 0,3:03:20.39,3:03:22.39,Default,,0,0,0,,Иә?
Dialogue: 0,3:03:22.39,3:03:24.72,Default,,0,0,0,,Олай болса, құлпынай жейік~
Dialogue: 0,3:03:24.72,3:03:28.73,Default,,0,0,0,,Мен саған өзімді де беремін. Жарайды? Ахх
Dialogue: 0,3:03:28.73,3:03:31.40,Default,,0,0,0,,《Мүмкін бұл Ханзоның кінәсі шығар》
Dialogue: 0,3:03:31.40,3:03:34.73,Default,,0,0,0,,Сол Цубаса деген қыздың еркекке байланып қалғаны ма?
Dialogue: 0,3:03:34.73,3:03:37.90,Default,,0,0,0,,Ти! Ғашық болатын жасыңыз!
Dialogue: 0,3:03:37.90,3:03:41.41,Default,,0,0,0,,Хмф, келесі жолы сөзсіз!
Dialogue: 0,3:03:41.41,3:03:43.91,Default,,0,0,0,,Сондықтан, егер Урарака ханым алғашқы қадамды жасаса…
Dialogue: 0,3:03:43.91,3:03:47.75,Default,,0,0,0,,Эй Чио-сан, мұнда бала жоқ па?
Dialogue: 0,3:03:47.75,3:03:52.92,Default,,0,0,0,,Ол кісі қыздардың жүрегімен ойнайтын үлкен жаман жігіт еді!
Dialogue: 0,3:03:52.92,3:03:57.76,Default,,0,0,0,,Не? Дұрыс... Жүрегім ауырды.
Dialogue: 0,3:03:57.76,3:04:00.43,Default,,0,0,0,,《Чиё: Қандай мұңды жүз...》
Dialogue: 0,3:04:00.43,3:04:03.10,Default,,0,0,0,,Кешіріңіз. Бұл менің кінәм.
Dialogue: 0,3:04:03.10,3:04:06.77,Default,,0,0,0,,Бәрін мұңайттым.
Dialogue: 0,3:04:06.77,3:04:10.77,Default,,0,0,0,,Чио-сан ештеңе істеген жоқ.
Dialogue: 0,3:04:13.04,3:04:15.37,Default,,0,0,0,,Және Рикка
Dialogue: 0,3:04:15.37,3:04:20.38,Default,,0,0,0,,Чио-сан мені өзімшіл дейтін болса, мен бақытты болар едім.
Dialogue: 0,3:04:20.38,3:04:22.88,Default,,0,0,0,,Рикка-чан
Dialogue: 0,3:04:22.88,3:04:25.05,Default,,0,0,0,,♬~
Dialogue: 0,3:04:25.05,3:04:29.05,Default,,0,0,0,,《Қош бол, махаббатым》
Dialogue: 0,3:04:34.39,3:04:36.40,Default,,0,0,0,,Ах
Dialogue: 0,3:04:36.40,3:04:39.90,Default,,0,0,0,,Қайырлы күн Цубаса-сан. Қайырлы таң!
Dialogue: 0,3:04:39.90,3:04:42.40,Default,,0,0,0,,Түрлі оқиғаларға араласып жүріп—
Dialogue: 0,3:04:42.40,3:04:44.90,Default,,0,0,0,,Иә? кінә?
Dialogue: 0,3:04:44.90,3:04:48.57,Default,,0,0,0,,Бір нәрсе әдеттегіден басқаша болып көрінеді.
Dialogue: 0,3:04:48.57,3:04:51.24,Default,,0,0,0,,Күткендей, кеше болған оқиға әлі есімде...
Dialogue: 0,3:04:51.24,3:04:56.42,Default,,0,0,0,,Цубаса мырза. Мен кеше бір нәрсе туралы айтқым келеді ...
Dialogue: 0,3:04:56.42,3:04:58.42,Default,,0,0,0,,Кешегі күн ше? иә
Dialogue: 0,3:04:58.42,3:05:00.92,Default,,0,0,0,,Секине мырзамен ұрысып қалдыңыз.
Dialogue: 0,3:05:00.92,3:05:04.42,Default,,0,0,0,,Сіздің есеңгіреп қалғаныңызға сенімдімін, бірақ түзеліңіз...
Dialogue: 0,3:05:04.42,3:05:08.26,Default,,0,0,0,,Ах~ Маған мүлдем бәрібір. (2 адам) Иә?
Dialogue: 0,3:05:08.26,3:05:12.77,Default,,0,0,0,,Бұған тек кішкентай ер адамдар ғана мән береді.
Dialogue: 0,3:05:12.77,3:05:17.10,Default,,0,0,0,,Ах...мырза. Секине, сұрағаныңызға рахмет.
Dialogue: 0,3:05:17.10,3:05:19.10,Default,,0,0,0,,Ух... иә
Dialogue: 0,3:05:21.94,3:05:25.11,Default,,0,0,0,,Кеше үшін кешірім сұраймын
Dialogue: 0,3:05:25.11,3:05:28.11,Default,,0,0,0,,Керемет! Секине-чан
Dialogue: 0,3:05:28.11,3:05:31.78,Default,,0,0,0,,Мен бұл шаш үлгісін Цубаса-чанмен жасанғым келгендіктен таңдадым!
Dialogue: 0,3:05:31.78,3:05:33.79,Default,,0,0,0,,Не? Цубасаның сүйіктісі
Dialogue: 0,3:05:33.79,3:05:38.62,Default,,0,0,0,,Мен оны жарлық стилінде орналастырдым. Саған өте жарасады!
Dialogue: 0,3:05:38.62,3:05:40.96,Default,,0,0,0,,Уф... мен емес.
Dialogue: 0,3:05:40.96,3:05:44.30,Default,,0,0,0,,Мен оны аздап өзгертейін деп ойладым.
Dialogue: 0,3:05:44.30,3:05:47.47,Default,,0,0,0,,《Сүйкімді》
Dialogue: 0,3:05:47.47,3:05:49.47,Default,,0,0,0,,Не? (ысырма дыбысы)
Dialogue: 0,3:05:49.47,3:05:51.47,Default,,0,0,0,,Иә! Апыр-ай!
Dialogue: 0,3:05:51.47,3:05:54.47,Default,,0,0,0,,Қыздар мектебі көңілді!
Dialogue: 0,3:05:54.47,3:05:58.64,Default,,0,0,0,,《Мен әрқашан таңданатын Такеин орта мектебіне бара аламын.
Dialogue: 0,3:05:58.64,3:06:01.31,Default,,0,0,0,,Алмасуды тоқтатамын дегеніңізге қуаныштымын.
Dialogue: 0,3:06:01.31,3:06:04.98,Default,,0,0,0,,Менің әпкем достардың нақты тобы жоқ екенін айтты.
Dialogue: 0,3:06:04.98,3:06:07.58,Default,,0,0,0,,Тезірек үйреніп кетесің деп үміттенемін》
Dialogue: 0,3:06:09.66,3:06:11.59,Default,,0,0,0,,Иә!
Dialogue: 0,3:06:11.59,3:06:13.59,Default,,0,0,0,,Ах, а...
Dialogue: 0,3:06:13.59,3:06:18.26,Default,,0,0,0,,Эй... ол сөйледі. Мен камераның дауысын бірінші рет естідім.
Dialogue: 0,3:06:18.26,3:06:20.93,Default,,0,0,0,,Иә?
Dialogue: 0,3:06:20.93,3:06:22.94,Default,,0,0,0,,Қайырлы таң.
Dialogue: 0,3:06:22.94,3:06:25.60,Default,,0,0,0,,Иә! Қайырлы таң
Dialogue: 0,3:06:25.60,3:06:30.11,Default,,0,0,0,,Сәлем айттыңыз. Мен таң қалдым.
Dialogue: 0,3:06:30.11,3:06:33.61,Default,,0,0,0,,Э? Эм…
Dialogue: 0,3:06:33.61,3:06:35.61,Default,,0,0,0,,Ах... а...
Dialogue: 0,3:06:38.12,3:06:41.45,Default,,0,0,0,,Иә. Сіз не істеп жатырсыз, әпке?
Dialogue: 0,3:06:41.45,3:06:45.96,Default,,0,0,0,,Цуйоши-кун, солай ма? иә? Ал...
Dialogue: 0,3:06:45.96,3:06:50.13,Default,,0,0,0,,Бұл менің сыныптасым Ханзава. Наозо Ханзава
Dialogue: 0,3:06:50.13,3:06:54.30,Default,,0,0,0,,Кешіріңіз... Кешіріңіз. Бір сыныпта оқитын болсақ та, мен сенің атыңды да білмеймін.
Dialogue: 0,3:06:54.30,3:06:59.30,Default,,0,0,0,,Бұл маңызды емес. Мен жақында ғана осында көшіп келдім.
Dialogue: 0,3:06:59.30,3:07:02.14,Default,,0,0,0,,Есіміңізде қалмауы заңдылық.
Dialogue: 0,3:07:02.14,3:07:06.81,Default,,0,0,0,,Көрші есік жақсы ма? Иә
Dialogue: 0,3:07:06.81,3:07:10.98,Default,,0,0,0,,《Мен бұл мектепке ауылдан тыс жерде тұруға үйрену үшін түстім, бірақ...
Dialogue: 0,3:07:10.98,3:07:15.09,Default,,0,0,0,,Чиё досының інісіне жақындай алатының қызық.
Dialogue: 0,3:07:15.09,3:07:20.43,Default,,0,0,0,,Мен Чио туралы пайдалы ақпарат жинай аламын.
Dialogue: 0,3:07:20.43,3:07:22.43,Default,,0,0,0,,Мен… (Дамиан) Хм. Тек балалар ойыны ғой.
Dialogue: 0,3:07:22.43,3:07:25.10,Default,,0,0,0,,Жаңа ғана күрсіндіңіз, жақсы ма?
Dialogue: 0,3:07:25.10,3:07:29.43,Default,,0,0,0,,Иә, жақсы. Ханзава-кунның бауырлары бар ма?
Dialogue: 0,3:07:29.43,3:07:32.27,Default,,0,0,0,,А, иә, менің үлкен әпкем бар.
Dialogue: 0,3:07:32.27,3:07:35.44,Default,,0,0,0,,Менің де егіз әпкем бар.
Dialogue: 0,3:07:35.44,3:07:40.78,Default,,0,0,0,,Ол шынымен ессіз жігіт, ал ол аздап есінен танып қалған емес пе?
Dialogue: 0,3:07:40.78,3:07:45.12,Default,,0,0,0,,Дұрыс. Мен де әпкеммен үнемі кездесіп қаламын.
Dialogue: 0,3:07:45.12,3:07:48.62,Default,,0,0,0,,Менің әпкем күшті, сондықтан оны жеңу қиын.
Dialogue: 0,3:07:48.62,3:07:51.96,Default,,0,0,0,,Бір күні ол екі еселенеді! Мен тырысамын деп ойлаймын
Dialogue: 0,3:07:51.96,3:07:55.46,Default,,0,0,0,,《Оны қайтарғыңыз келе ме? Егер сіз осындай нәрсе жасағыңыз келсе...》
Dialogue: 0,3:07:55.46,3:07:59.46,Default,,0,0,0,,Қызық, мен бұл фотоны қаншаға сата аламын?
Dialogue: 0,3:07:59.46,3:08:01.47,Default,,0,0,0,,Иә.
Dialogue: 0,3:08:01.47,3:08:06.14,Default,,0,0,0,,Қаласаңыз, мектептен кейін күнделікті шағымдарыңызды неге айтпайсыз?
Dialogue: 0,3:08:06.14,3:08:10.31,Default,,0,0,0,,Олай болса, вокзал алдындағы кафеде торт жеп отырып сөйлесейік.
Dialogue: 0,3:08:10.31,3:08:14.08,Default,,0,0,0,,Торт? Жарайды, бірақ қызға ұқсайды.
Dialogue: 0,3:08:14.08,3:08:16.08,Default,,0,0,0,,Иә?
Dialogue: 0,3:08:16.08,3:08:19.42,Default,,0,0,0,,《Түсіндім... Бұл қыз сияқты ма?》
Dialogue: 0,3:08:19.42,3:08:21.42,Default,,0,0,0,,Мен… (Дамиан) Хм. Тек балалар ойыны ғой.
Dialogue: 0,3:08:23.42,3:08:25.76,Default,,0,0,0,,Әпке! иә?
Dialogue: 0,3:08:25.76,3:08:28.09,Default,,0,0,0,,Белгілі бір жақын топтың болмауы
Dialogue: 0,3:08:28.09,3:08:31.60,Default,,0,0,0,,Менің достарым жоқ деген дұрыс емес! Немесе дұрысырақ
Dialogue: 0,3:08:31.60,3:08:34.93,Default,,0,0,0,,Мен тіпті сыныптастарыммен амандасып көрмегеніме сене алар емеспін!
Dialogue: 0,3:08:34.93,3:08:38.44,Default,,0,0,0,,Мектепке пұттардың сұлулығын жазу үшін барамын.
Dialogue: 0,3:08:38.44,3:08:41.61,Default,,0,0,0,,Қарапайым адамдармен танысқанда не істейсің?
Dialogue: 0,3:08:41.61,3:08:45.11,Default,,0,0,0,,Мен бұл атмосфераға шыдай алмаймын.
Dialogue: 0,3:08:45.11,3:08:47.95,Default,,0,0,0,,Мен бір адаммен тіл табыса аламын деп ойладым.
Dialogue: 0,3:08:47.95,3:08:51.45,Default,,0,0,0,,Бастапқы мектепке оралу. О иә.
Dialogue: 0,3:08:55.45,3:08:57.96,Default,,0,0,0,,Қайырлы таң, Цубаса-чан!
Dialogue: 0,3:08:57.96,3:08:59.96,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,3:08:59.96,3:09:02.46,Default,,0,0,0,,《Әй, достардың болғаны қандай жақсы》
Dialogue: 0,3:09:02.46,3:09:06.13,Default,,0,0,0,,А... білесің бе, Цубаса-чан. иә? не?
Dialogue: 0,3:09:06.13,3:09:10.30,Default,,0,0,0,,Ал, суретке түскенде бірдеңе айтайық.
Dialogue: 0,3:09:10.30,3:09:13.24,Default,,0,0,0,,Бұл бүкіл ғаламға ортақ түсінік.
Dialogue: 0,3:09:13.24,3:09:16.07,Default,,0,0,0,,Ах. (2 адам) Ух...
Dialogue: 0,3:09:16.07,3:09:19.47,Default,,0,0,0,,《Ол да осында!?》
Dialogue: 0,3:09:25.42,3:09:27.75,Default,,0,0,0,,Секине туған күніңмен. Құттықтаймыз!
Dialogue: 0,3:09:27.75,3:09:30.76,Default,,0,0,0,,Құттықтаймыз! Сізге көп рахмет
Dialogue: 0,3:09:30.76,3:09:33.43,Default,,0,0,0,,Иә, бұл сыйлық.
Dialogue: 0,3:09:33.43,3:09:36.76,Default,,0,0,0,,Секине мырзаға жарасатын шашқа әшекей жасадым.
Dialogue: 0,3:09:36.76,3:09:38.76,Default,,0,0,0,,Рахмет Чиё-сан
Dialogue: 0,3:09:38.76,3:09:41.60,Default,,0,0,0,,Мен кекстер пісірдім. Қаласаңыз, оларды жеңіз.
Dialogue: 0,3:09:41.60,3:09:43.60,Default,,0,0,0,,Қолмен жасалған ба?
Dialogue: 0,3:09:43.60,3:09:46.77,Default,,0,0,0,,Иә. Соңғы кездері тәттілер жасауға құмар болдым.
Dialogue: 0,3:09:46.77,3:09:49.44,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,3:09:49.44,3:09:53.11,Default,,0,0,0,,Рикка ерекше сыйлық әкелді.
Dialogue: 0,3:09:53.11,3:09:55.11,Default,,0,0,0,,Не! «Не? 》
Dialogue: 0,3:09:55.11,3:09:58.45,Default,,0,0,0,,Ол сондай сүйкімді қыз!
Dialogue: 0,3:09:58.45,3:10:01.45,Default,,0,0,0,,《Сіз бас тартқан жоқсыз ба, полковник?》
Dialogue: 0,3:10:01.45,3:10:04.46,Default,,0,0,0,,Сәлем Чурн Бабу!
Dialogue: 0,3:10:04.46,3:10:07.29,Default,,0,0,0,,Мен анамды салдым. Ол бірінші сыныпта оқиды.
Dialogue: 0,3:10:07.29,3:10:09.63,Default,,0,0,0,,Ой... ой...
Dialogue: 0,3:10:09.63,3:10:13.07,Default,,0,0,0,,《Сыйлық үлкен табыс болды, ол қатты қуанып, жылап жіберді.》
Dialogue: 0,3:10:13.07,3:10:15.40,Default,,0,0,0,,《Мен не істеуім керек?
Dialogue: 0,3:10:15.40,3:10:18.40,Default,,0,0,0,,Бірақ бұл дүниеге келген бала кінәлі емес.
Dialogue: 0,3:10:18.40,3:10:21.74,Default,,0,0,0,,Ха... Айтпақшы, сенің әкең кім?
Dialogue: 0,3:10:21.74,3:10:26.08,Default,,0,0,0,,Әке? Хмм... Аа, бұл ниндзя ғой!
Dialogue: 0,3:10:26.08,3:10:28.08,Default,,0,0,0,,Иә?
Dialogue: 0,3:10:28.08,3:10:32.58,Default,,0,0,0,,《Ханзо! 》 Ниндзя? Қай жерде?
Dialogue: 0,3:10:32.58,3:10:35.75,Default,,0,0,0,,Қараңдаршы... не?
Dialogue: 0,3:10:35.75,3:10:38.09,Default,,0,0,0,,《Ханзо! 》
Dialogue: 0,3:10:38.09,3:10:42.93,Default,,0,0,0,,《Ханзо: Мен Чиёның досының інісінен көп мәлімет ала алмадым.
Dialogue: 0,3:10:42.93,3:10:45.43,Default,,0,0,0,,Келесі жолы сәтсіздікке ұшырамайды
Dialogue: 0,3:10:45.43,3:10:48.93,Default,,0,0,0,,Чио досынан алыста жүргенде мен мұны істедім...》
Dialogue: 0,3:10:50.94,3:10:52.94,Default,,0,0,0,,Уф!
Dialogue: 0,3:10:52.94,3:10:57.78,Default,,0,0,0,,Сіз қазір біреумен кездесіп жүрсіз бе?
Dialogue: 0,3:10:57.78,3:11:00.11,Default,,0,0,0,,Иә!? Жоқ... бірақ мен жоқпын.
Dialogue: 0,3:11:00.11,3:11:02.11,Default,,0,0,0,,Шит… шит…
Dialogue: 0,3:11:02.11,3:11:06.79,Default,,0,0,0,,Сонымен, сіз қалай ойлайсыз? Ең алдымен некені тіркеу...
Dialogue: 0,3:11:06.79,3:11:09.79,Default,,0,0,0,,А-а... жоқ, күте тұрыңыз, бұл...
Dialogue: 0,3:11:09.79,3:11:14.73,Default,,0,0,0,,Аа, дұрыс. Ендеше, біз неге Dada идентификаторларын алмастырмаймыз?
Dialogue: 0,3:11:14.73,3:11:17.40,Default,,0,0,0,,Уф... Жоқ, күдіктенбе!
Dialogue: 0,3:11:17.40,3:11:19.90,Default,,0,0,0,,Бұл... бір көргеннен махаббат!
Dialogue: 0,3:11:19.90,3:11:21.90,Default,,0,0,0,,《Бұл жағдайда!?》
Dialogue: 0,3:11:21.90,3:11:26.24,Default,,0,0,0,,Өтінемін! Мен үшін... жоқ, біздің қызымыз!
Dialogue: 0,3:11:26.24,3:11:30.08,Default,,0,0,0,,Сен менің досыма не істеп жатырсың? Ханзо
Dialogue: 0,3:11:30.08,3:11:32.74,Default,,0,0,0,,Мен бірдеңе істеп жатқан адаммын!
Dialogue: 0,3:11:32.74,3:11:34.91,Default,,0,0,0,,《Жоқ, мен өлдім деп тұрмын! 》
Dialogue: 0,3:11:34.91,3:11:40.41,Default,,0,0,0,,Секине мырза? Мен сені бүгін кешірмеймін! Ах!
Dialogue: 0,3:11:44.42,3:11:48.09,Default,,0,0,0,,«Әпкеме.Ауылды сатқанның жазасы.
Dialogue: 0,3:11:48.09,3:11:50.43,Default,,0,0,0,,қабылдануы керек
Dialogue: 0,3:11:50.43,3:11:55.43,Default,,0,0,0,,Мен пәктік сезімі күштірек дос таңдауым керек пе?» Не?
Dialogue: 0,3:11:55.43,3:11:58.44,Default,,0,0,0,,Әй, бәрі осындай жерде болды. Рикка!
Dialogue: 0,3:11:58.44,3:12:00.94,Default,,0,0,0,,Секине-чан, мен бір нәрсені ұмытып қалдым.
Dialogue: 0,3:12:00.94,3:12:04.44,Default,,0,0,0,,А, а, жоқ, бұл... А?
Dialogue: 0,3:12:06.95,3:12:09.45,Default,,0,0,0,,Иә!? Бабу!
Dialogue: 0,3:12:09.45,3:12:11.38,Default,,0,0,0,,《Ғарыш сегізаяқ!?》
Dialogue: 0,3:12:11.38,3:12:16.72,Default,,0,0,0,,Менің қызым сияқты сүйкімді шығар. Бірақ сіз оған қосылғаннан кейін ол сізді жібермейді.
Dialogue: 0,3:12:16.72,3:12:19.72,Default,,0,0,0,,Абайлаңыз! 《Сен бала емес пе едің?
Dialogue: 0,3:12:19.72,3:12:22.42,Default,,0,0,0,,Мен Ханзоға тұрмысқа шыға жаздадым! 》
Dialogue: 0,3:12:29.40,3:12:31.40,Default,,0,0,0,,Мен… (Дамиан) Хм. Тек балалар ойыны ғой.
Dialogue: 0,3:12:31.40,3:12:33.41,Default,,0,0,0,,《Аа~ менің бос уақытым бар》
Dialogue: 0,3:12:33.41,3:12:37.08,Default,,0,0,0,,Иә? Ол Цуйошидің әпкесі емес пе?
Dialogue: 0,3:12:37.08,3:12:40.58,Default,,0,0,0,,А, бұл Ханзава-кун.
Dialogue: 0,3:12:40.58,3:12:44.08,Default,,0,0,0,,Мен сенімен бірінші рет кездесіп тұрмын. Неге маған атымды айттың?
Dialogue: 0,3:12:44.08,3:12:49.75,Default,,0,0,0,,А-а-а... Ханзава-кунның мінездерін інімнен естідім.
Dialogue: 0,3:12:49.75,3:12:54.59,Default,,0,0,0,,Солай ма? Әңгімені Цюоши-куннан да естідім.
Dialogue: 0,3:12:54.59,3:12:58.93,Default,,0,0,0,,Мен сізге байқаусызда қоңырау шалдым. Қолайсыздық үшін кешірім сұраймын, солай ма?
Dialogue: 0,3:12:58.93,3:13:00.93,Default,,0,0,0,,Аа, жоқ, шынымен емес.
Dialogue: 0,3:13:00.93,3:13:05.60,Default,,0,0,0,,Мен досымның дүкен аралап біткенін күтіп зеріктім. Менің қасыма отырғың келе ме?
Dialogue: 0,3:13:05.60,3:13:10.78,Default,,0,0,0,,Иә. Қаласаңыз, мен кофе алғым келеді. Рақмет сізге.
Dialogue: 0,3:13:10.78,3:13:13.04,Default,,0,0,0,,Неге келдің, Ханзава-кун?
Dialogue: 0,3:13:13.04,3:13:15.88,Default,,0,0,0,,Менің біраз сатып алуым керек.
Dialogue: 0,3:13:15.88,3:13:19.05,Default,,0,0,0,,Енді ойлап қарасам, Цюоши-куннан естідім.
Dialogue: 0,3:13:19.05,3:13:22.05,Default,,0,0,0,,Менің әпкем сүйкімді нәрселерге бейім.
Dialogue: 0,3:13:22.05,3:13:26.39,Default,,0,0,0,,Дұрыс. Мен сүйкімді заттарды және әдемі жігіттерді жақсы көремін.
Dialogue: 0,3:13:26.39,3:13:29.90,Default,,0,0,0,,Мен тіпті ініме де сүйкімді киім кигіземін!
Dialogue: 0,3:13:29.90,3:13:31.90,Default,,0,0,0,,(Ллойд) Бүгінгі серуен — немесе дұрысы, «Үккі» операциясы
Dialogue: 0,3:13:31.90,3:13:35.07,Default,,0,0,0,,Менде де осындай жағдай болды.
Dialogue: 0,3:13:35.07,3:13:37.24,Default,,0,0,0,,Солай ма? иә
Dialogue: 0,3:13:37.24,3:13:40.41,Default,,0,0,0,,Менің әпкем әрқашан сүйкімді нәрселерді жақсы көреді.
Dialogue: 0,3:13:40.41,3:13:44.01,Default,,0,0,0,,Себебі ол мені қарындасындай жақсы көретін.
Dialogue: 0,3:13:46.08,3:13:48.08,Default,,0,0,0,,Хмф! Ха!
Dialogue: 0,3:13:48.08,3:13:50.42,Default,,0,0,0,,Хмф! Әпке?
Dialogue: 0,3:13:50.42,3:13:54.09,Default,,0,0,0,,Сүйкімді болсаң, артта қал! Әпке!?
Dialogue: 0,3:13:54.09,3:13:58.09,Default,,0,0,0,,Ух... у...｡ Ах!
Dialogue: 0,3:13:58.09,3:14:00.76,Default,,0,0,0,,А... Әпке?
Dialogue: 0,3:14:00.76,3:14:04.43,Default,,0,0,0,,Сүйкімді болсаң, артта қал! Әпке!?
Dialogue: 0,3:14:04.43,3:14:06.60,Default,,0,0,0,,(Дарио) Бұл нағыз апат. Бұл жігіт те сол жерде-ақ қаза тапты. ➡
Dialogue: 0,3:14:06.60,3:14:09.60,Default,,0,0,0,,Ха!
Dialogue: 0,3:14:09.60,3:14:13.04,Default,,0,0,0,,Әпке? Сүйкімді болсаң, артта қал...
Dialogue: 0,3:14:13.04,3:14:15.04,Default,,0,0,0,,Әпке!?
Dialogue: 0,3:14:15.04,3:14:18.71,Default,,0,0,0,,Бұл… бұл…｡ Бұл менің қолөнерім.
Dialogue: 0,3:14:18.71,3:14:22.55,Default,,0,0,0,,Менің ойымша, сүйкімді адамдар сүйкімді түскі ас қораптарында жақсы көрінеді.
Dialogue: 0,3:14:22.55,3:14:28.89,Default,,0,0,0,,Аа... Рахмет, апа. Хехе
Dialogue: 0,3:14:28.89,3:14:33.89,Default,,0,0,0,,Менің әпкем мені үнемі қорғап, шектен тыс қорған болатын.
Dialogue: 0,3:14:33.89,3:14:37.56,Default,,0,0,0,,Ол күшті, қатал және салқын болды.
Dialogue: 0,3:14:37.56,3:14:41.57,Default,,0,0,0,,Эй, мен Ханзава-кунның үлкен әпкесімен танысқым келеді.
Dialogue: 0,3:14:41.57,3:14:45.40,Default,,0,0,0,,Бірақ қазір өзімді басқа адам сияқты сезінемін.
Dialogue: 0,3:14:45.40,3:14:49.41,Default,,0,0,0,,Отбасына опасыздық жасау, түкке тұрғысыз нәрседен бас тарту
Dialogue: 0,3:14:49.41,3:14:52.08,Default,,0,0,0,,Эй... қиын сияқты.
Dialogue: 0,3:14:52.08,3:14:56.25,Default,,0,0,0,,Жарайды, еркіндік жағынан бізге ұқсайтын шығарсың.
Dialogue: 0,3:14:56.25,3:14:59.08,Default,,0,0,0,,Шынымды айтсам, апама қарасам
Dialogue: 0,3:14:59.08,3:15:02.09,Default,,0,0,0,,Қызғанатын кезім болады.
Dialogue: 0,3:15:02.09,3:15:06.09,Default,,0,0,0,,Мен солай өмір сүрсем ғой. Хаа.
Dialogue: 0,3:15:06.09,3:15:10.93,Default,,0,0,0,,А, жоқ, інім осылай деді. Ахахаха
Dialogue: 0,3:15:10.93,3:15:13.26,Default,,0,0,0,,Сіз қызғанасыз ба?
Dialogue: 0,3:15:13.26,3:15:15.27,Default,,0,0,0,,Әжеміздің бір ескі танысы шығар. Ах, дұрыс.
Dialogue: 0,3:15:15.27,3:15:17.44,Default,,0,0,0,,Мен, әрине, солай ойлаймын.
Dialogue: 0,3:15:17.44,3:15:21.44,Default,,0,0,0,,Інім қиналады. Олар ағайынды.
Dialogue: 0,3:15:21.44,3:15:25.44,Default,,0,0,0,,Бір-бірімізді түсінетін уақыт келеді деп сенемін.
Dialogue: 0,3:15:25.44,3:15:27.45,Default,,0,0,0,,Итадакимасу. Ах.
Dialogue: 0,3:15:27.45,3:15:29.45,Default,,0,0,0,,Не? А, жоқ
Dialogue: 0,3:15:29.45,3:15:32.45,Default,,0,0,0,,Ішпесең, мен аламын!
Dialogue: 0,3:15:32.45,3:15:34.45,Default,,0,0,0,,Құдай-ай! «Енді бұдан әрі бәрі дәл болжағандай қалай болатынына таңғаламын!»
Dialogue: 0,3:15:34.45,3:15:37.46,Default,,0,0,0,,Әй, бәрі...
Dialogue: 0,3:15:37.46,3:15:40.79,Default,,0,0,0,,Жарайды, досым келді, кездескенше.
Dialogue: 0,3:15:40.79,3:15:43.13,Default,,0,0,0,,Жоқ, Цубаса мырза.
Dialogue: 0,3:15:43.13,3:15:47.63,Default,,0,0,0,,Мен сенімен жай сөйлескім келеді.
Dialogue: 0,3:15:47.63,3:15:51.80,Default,,0,0,0,,《Не, тіпті Чио-санның да сымбатты жігіттерге деген көзқарасы бар ма? 》
Dialogue: 0,3:15:51.80,3:15:54.64,Default,,0,0,0,,Коу!
Dialogue: 0,3:15:54.64,3:15:56.64,Default,,0,0,0,,Кешіріңіз, бірақ мен төлеуім керек...
Dialogue: 0,3:15:56.64,3:15:59.64,Default,,0,0,0,,Уау, түсіндім! Бәріміз сол жаққа барайық
Dialogue: 0,3:15:59.64,3:16:01.65,Default,,0,0,0,,О
Dialogue: 0,3:16:01.65,3:16:06.32,Default,,0,0,0,,Мен достарыма бұдан былай қауіп төндіре алмаймын.
Dialogue: 0,3:16:06.32,3:16:09.49,Default,,0,0,0,,Осы тура Ханзоны алайық.
Dialogue: 0,3:16:09.49,3:16:11.42,Default,,0,0,0,,Қалыпты әрекеттесу
Dialogue: 0,3:16:11.42,3:16:14.43,Default,,0,0,0,,Мен сізге тең келе алмаймын, апа.
Dialogue: 0,3:16:14.43,3:16:17.93,Default,,0,0,0,,Сонымен мен досыма у ішуін өтіндім.
Dialogue: 0,3:16:17.93,3:16:21.93,Default,,0,0,0,,Не?! Удың күшіне енетін уақыты келді.
Dialogue: 0,3:16:21.93,3:16:25.10,Default,,0,0,0,,Егер антидот енгізілмесе, оған 2 сағат кетеді.
Dialogue: 0,3:16:25.10,3:16:27.94,Default,,0,0,0,,Қиналып өлесің. Қарғыс атсын!
Dialogue: 0,3:16:27.94,3:16:30.94,Default,,0,0,0,,Момындықпен берілсең, антидот аласың...
Dialogue: 0,3:16:30.94,3:16:33.45,Default,,0,0,0,,Эй, эй!
Dialogue: 0,3:16:33.45,3:16:35.45,Default,,0,0,0,,Иә?
Dialogue: 0,3:16:35.45,3:16:37.45,Default,,0,0,0,,Рикка-чан, өзіңді жақсы сезінесің бе?
Dialogue: 0,3:16:37.45,3:16:40.45,Default,,0,0,0,,Иә, сіз өте жақсы істеп жатырсыз! иә?
Dialogue: 0,3:16:40.45,3:16:42.62,Default,,0,0,0,,Сіз білесіз. иә?
Dialogue: 0,3:16:42.62,3:16:46.79,Default,,0,0,0,,Мен сенен бұл кофені қайдан алдың деп сұрайын деп едім. Ха!
Dialogue: 0,3:16:46.79,3:16:49.96,Default,,0,0,0,,<Удың жат планеталықтарға әсері болмады>
Dialogue: 0,3:16:49.96,3:16:54.80,Default,,0,0,0,,Қ-қараңыз… ол…
Dialogue: 0,3:16:54.80,3:16:57.50,Default,,0,0,0,,Ханзоның түпнұсқа қоспасы
Dialogue: 0,3:20:13.43,3:20:18.44,Default,,0,0,0,,《Секине: Ол ұйықтап жатыр еді. иә?
Dialogue: 0,3:20:18.44,3:20:22.44,Default,,0,0,0,,Иә?
Dialogue: 0,3:20:22.44,3:20:27.28,Default,,0,0,0,,Не? Не болып жатыр? иә?
Dialogue: 0,3:20:27.28,3:20:31.12,Default,,0,0,0,,Иә? Ой...
Dialogue: 0,3:20:31.12,3:20:34.52,Default,,0,0,0,,Ол ұл балаға айналады! 》
Dialogue: 0,3:22:16.92,3:22:19.76,Default,,0,0,0,,(ызылдаған)
Dialogue: 0,3:22:19.76,3:22:22.93,Default,,0,0,0,,Чиё: Уууу, болды!
Dialogue: 0,3:22:22.93,3:22:26.43,Default,,0,0,0,,Цубаса-санның шашы өте әдемі.
Dialogue: 0,3:22:26.43,3:22:28.43,Default,,0,0,0,,Кутикула да жылтыр
Dialogue: 0,3:22:28.43,3:22:30.94,Default,,0,0,0,,О, досым! Осы жеңісті тойлайық
Dialogue: 0,3:22:30.94,3:22:33.94,Default,,0,0,0,,Қанаттардың андрогендік сүйкімділігі бар.
Dialogue: 0,3:22:33.94,3:22:37.61,Default,,0,0,0,,Бұл танымал, солай емес пе? Бейтарап
Dialogue: 0,3:22:37.61,3:22:40.45,Default,,0,0,0,,Ол қыздар мектебінің ханзадасы.
Dialogue: 0,3:22:40.45,3:22:43.95,Default,,0,0,0,,Керемет! Жоқ, бұл дұрыс емес!
Dialogue: 0,3:22:43.95,3:22:47.45,Default,,0,0,0,,Цубаса-сан өте сүйкімді қыз!
Dialogue: 0,3:22:47.45,3:22:49.95,Default,,0,0,0,,Уф! Фуфу
Dialogue: 0,3:22:52.79,3:22:56.79,Default,,0,0,0,,《Мисс Цубаса шынымен ханшайым болғысы келеді, солай ма?
Dialogue: 0,3:22:56.79,3:23:00.63,Default,,0,0,0,,Иә! Бұл жағдайда Мисс Цубаса қыз болып қала береді.
Dialogue: 0,3:23:00.63,3:23:02.80,Default,,0,0,0,,Қалғандардың бәрі ұл болса
Dialogue: 0,3:23:02.80,3:23:04.80,Default,,0,0,0,,Бұл жақсы емес пе? 》
Dialogue: 0,3:23:04.80,3:23:09.64,Default,,0,0,0,,[Секине: Бұл Цубаса ханшайым және әдемі еркектердің гаремі бар дегенді білдіре ме? 》
Dialogue: 0,3:23:09.64,3:23:12.41,Default,,0,0,0,,《Жарайды! Сол тілегіміз орындалсын! 》
Dialogue: 0,3:23:12.41,3:23:14.41,Default,,0,0,0,,Ах
Dialogue: 0,3:23:20.42,3:23:22.42,Default,,0,0,0,,(Хироми) Иә. (Кенъя) Ойласам➡
Dialogue: 0,3:23:22.42,3:23:24.42,Default,,0,0,0,,Секине-кун
Dialogue: 0,3:23:24.42,3:23:27.09,Default,,0,0,0,,Киім ауыстыратын кез келді.
Dialogue: 0,3:23:27.09,3:23:31.10,Default,,0,0,0,,Мм... кім?
Dialogue: 0,3:23:31.10,3:23:33.93,Default,,0,0,0,,Чиёмару деген кім?
Dialogue: 0,3:23:33.93,3:23:36.43,Default,,0,0,0,,Чиёмару…
Dialogue: 0,3:23:38.77,3:23:41.27,Default,,0,0,0,,Ах! Чио-сан!
Dialogue: 0,3:23:41.27,3:23:43.44,Default,,0,0,0,,Чиёмару
Dialogue: 0,3:23:43.44,3:23:45.44,Default,,0,0,0,,Мен бірдеңені есіме түсірдім.
Dialogue: 0,3:23:45.44,3:23:47.61,Default,,0,0,0,,Әй?
Dialogue: 0,3:23:47.61,3:23:51.45,Default,,0,0,0,,Рикка! Қайда!? иә?
Dialogue: 0,3:23:51.45,3:23:54.45,Default,,0,0,0,,Ах
Dialogue: 0,3:23:58.62,3:24:00.62,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,3:24:03.13,3:24:06.46,Default,,0,0,0,,Қанаттар?
Dialogue: 0,3:24:06.46,3:24:10.47,Default,,0,0,0,,Әркімде жоқ, сондықтан мен оны үлкен ағам Цюйошимен ауыстырамын.
Dialogue: 0,3:24:10.47,3:24:14.74,Default,,0,0,0,,Сондықтан мені Цюоси деп атаңыз. Ху~ Дұрыс.
Dialogue: 0,3:24:14.74,3:24:19.41,Default,,0,0,0,,《Ханшайымның қанаты деген осы ма? Бұл біраз қызық
Dialogue: 0,3:24:19.41,3:24:21.91,Default,,0,0,0,,Ал мен ер адаммын
Dialogue: 0,3:24:21.91,3:24:26.42,Default,,0,0,0,,Мен тек ер адамда болатын тәжірибе алғым келеді.
Dialogue: 0,3:24:26.42,3:24:30.42,Default,,0,0,0,,Цуйоши, сенен бір өтінішім бар. Не?
Dialogue: 0,3:24:30.42,3:24:32.42,Default,,0,0,0,,Маған рұқсат бере аласыз ба?
Dialogue: 0,3:24:36.43,3:24:38.43,Default,,0,0,0,,Сіз мені ұрмайсыз, солай ма?
Dialogue: 0,3:24:38.43,3:24:42.10,Default,,0,0,0,,Кешіріңіз. Бірақ Секиненің де кінәсі бар.
Dialogue: 0,3:24:42.10,3:24:46.27,Default,,0,0,0,,Ах. Қан ағып жатыр, солай ма?
Dialogue: 0,3:24:46.27,3:24:48.27,Default,,0,0,0,,Әдемі бала!
Dialogue: 0,3:24:48.27,3:24:53.28,Default,,0,0,0,,Қазірдің өзінде! Келесі жолы маған мектеп асханасынан бірдеңе сатып алуыңызды өтінемін.
Dialogue: 0,3:24:53.28,3:24:57.45,Default,,0,0,0,,Бұл сүйіспеншілік болғанша. Сені ұрғаны үшін менің кінәм болды.
Dialogue: 0,3:24:57.45,3:25:00.45,Default,,0,0,0,,Жоқ, мұны тіпті әйел де жасай алады.
Dialogue: 0,3:25:02.45,3:25:05.79,Default,,0,0,0,,Дұрысы, Секине Тошақайға кешігіп қалады.
Dialogue: 0,3:25:05.79,3:25:08.46,Default,,0,0,0,,Тошақай? Бұл не болды?
Dialogue: 0,3:25:08.46,3:25:10.63,Default,,0,0,0,,Сіздің басыңыз нашар болды ма?
Dialogue: 0,3:25:10.63,3:25:15.07,Default,,0,0,0,,Бүгін жыл сайынғы іс-шара, белдемше жарысы күні.
Dialogue: 0,3:25:15.07,3:25:19.40,Default,,0,0,0,,< Гунма префектурасына жаяу жүгіру!
Dialogue: 0,3:25:19.40,3:25:23.74,Default,,0,0,0,,Құсайтындар көп болғандықтан, оны Тошақай деп атайды.
Dialogue: 0,3:25:23.74,3:25:27.08,Default,,0,0,0,,Бұл орта мектептегі іс-шара! ＞
Dialogue: 0,3:25:27.08,3:25:29.25,Default,,0,0,0,,《Оқиға қиын.
Dialogue: 0,3:25:29.25,3:25:32.58,Default,,0,0,0,,Бірақ егер бұл жарақат болса, сіз экскурсияға баруыңыз керек.
Dialogue: 0,3:25:32.58,3:25:36.42,Default,,0,0,0,,Секине-кун, Рикард-кунды көрмедің бе?
Dialogue: 0,3:25:36.42,3:25:38.52,Default,,0,0,0,,Мен осындамын!
Dialogue: 0,3:25:41.09,3:25:43.76,Default,,0,0,0,,《Полковник, сіз әлі қызсыз ба?》
Dialogue: 0,3:25:43.76,3:25:45.76,Default,,0,0,0,,Рикард-кун?
Dialogue: 0,3:25:45.76,3:25:47.93,Default,,0,0,0,,Мына әдемі адам қандай?
Dialogue: 0,3:25:47.93,3:25:50.77,Default,,0,0,0,,Рикка-чан! А, мүмкін Чиё...
Dialogue: 0,3:25:50.77,3:25:52.77,Default,,0,0,0,,...
Dialogue: 0,3:25:52.77,3:25:55.44,Default,,0,0,0,,Сіз не киіп жүрсіз?
Dialogue: 0,3:25:55.44,3:25:57.44,Default,,0,0,0,,Мен әрқашан айтамын! Ахх
Dialogue: 0,3:25:57.44,3:26:00.61,Default,,0,0,0,,Ерке емес жігіттерді жек көремін!
Dialogue: 0,3:26:00.61,3:26:03.11,Default,,0,0,0,,Бұл кеңейтімдер қандай?
Dialogue: 0,3:26:03.11,3:26:06.12,Default,,0,0,0,,Табиғи шаш?!
Dialogue: 0,3:26:06.12,3:26:08.62,Default,,0,0,0,,Цуйоши шаш қырғыш. Иә
Dialogue: 0,3:26:10.62,3:26:15.89,Default,,0,0,0,,Рикард Мен шашыңды қырамын.
Dialogue: 0,3:26:15.89,3:26:17.89,Default,,0,0,0,,Бұл аз
Dialogue: 0,3:26:21.40,3:26:23.40,Default,,0,0,0,,Сіз бірдеңе айттыңыз ба?
Dialogue: 0,3:26:23.40,3:26:25.40,Default,,0,0,0,,Бұл ештеңе емес!
Dialogue: 0,3:26:25.40,3:26:29.41,Default,,0,0,0,,《Мен түсіндім. Чио-сан қыз сияқты.
Dialogue: 0,3:26:29.41,3:26:33.41,Default,,0,0,0,,Ұл болған соң солай бола ма?
Dialogue: 0,3:26:33.41,3:26:36.08,Default,,0,0,0,,Қанаттар...
Dialogue: 0,3:26:36.08,3:26:40.25,Default,,0,0,0,,Бұл сүйкімді. Бұл ханшайым ретінде қойылғандықтан ба? 》
Dialogue: 0,3:26:40.25,3:26:42.25,Default,,0,0,0,,Фу
Dialogue: 0,3:26:42.25,3:26:45.26,Default,,0,0,0,,Айтпақшы, Цюоши Тошакайды не істейді?
Dialogue: 0,3:26:45.26,3:26:48.59,Default,,0,0,0,,Бұл жай ғана экскурсия. Бұл көптеген жолдармен мүмкін емес.
Dialogue: 0,3:26:48.59,3:26:52.93,Default,,0,0,0,,Ах~ Онда мен де экскурсияға барамын. Сен не туралы айтып тұрсың?
Dialogue: 0,3:26:52.93,3:26:55.60,Default,,0,0,0,,Қамқоршы қол қойған өтініш формасынсыз
Dialogue: 0,3:26:55.60,3:26:59.10,Default,,0,0,0,,Сіз экскурсия жасай алмайсыз. Сіз мұны білесіз.
Dialogue: 0,3:27:04.44,3:27:09.45,Default,,0,0,0,,А, а, а...
Dialogue: 0,3:27:09.45,3:27:11.88,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,3:27:14.39,3:27:16.72,Default,,0,0,0,,Ах!
Dialogue: 0,3:27:16.72,3:27:19.06,Default,,0,0,0,,Тошақайдан кейін жалғастыр
Dialogue: 0,3:27:19.06,3:27:22.56,Default,,0,0,0,,Ерте дайындалып, кешікпеу керек
Dialogue: 0,3:27:22.56,3:27:26.23,Default,,0,0,0,,Ей, басым жарылып, қансырап жатырмын!
Dialogue: 0,3:27:26.23,3:27:28.73,Default,,0,0,0,,Жоқ, қызуым көтерілмесе, тыныға алмаймын.
Dialogue: 0,3:27:28.73,3:27:32.24,Default,,0,0,0,,Бұл не? (Чиёмару) Сіз демалыс күнін алатыныңызға сенімдісіз бе?
Dialogue: 0,3:27:32.24,3:27:34.57,Default,,0,0,0,,Мүлде жоқ!
Dialogue: 0,3:27:34.57,3:27:39.74,Default,,0,0,0,,Суық. Ауырды. Мүмкін емес. Неліктен мұндай оқиға бар?
Dialogue: 0,3:27:39.74,3:27:41.91,Default,,0,0,0,,Мүмкін емес. Сенгісіз.
Dialogue: 0,3:27:41.91,3:27:44.92,Default,,0,0,0,,Секине-күн, бірдеңе дедіңіз бе?
Dialogue: 0,3:27:44.92,3:27:47.08,Default,,0,0,0,,Тошақай ең жақсы!
Dialogue: 0,3:27:47.08,3:27:50.42,Default,,0,0,0,,Уф... Секине
Dialogue: 0,3:27:50.42,3:27:53.59,Default,,0,0,0,,Бұл өте жаман. Сен соншалықты жасырынсың!
Dialogue: 0,3:27:53.59,3:27:56.76,Default,,0,0,0,,Келіңіздер! Біз де Рикард-куннан үлгі алуымыз керек.
Dialogue: 0,3:27:56.76,3:27:58.76,Default,,0,0,0,,Барымызды салайық!
Dialogue: 0,3:28:00.77,3:28:04.60,Default,,0,0,0,,Мен олардың миды жуудың бөлігі ретінде НЛО-да саяхаттауды қосқанына қуаныштымын!
Dialogue: 0,3:28:04.60,3:28:06.60,Default,,0,0,0,,Гунмаға дейін секіріңіз!
Dialogue: 0,3:28:06.60,3:28:15.21,Default,,0,0,0,,Ондайда Тошақайдың да миын шайып ал!
Dialogue: 0,3:28:15.21,3:28:18.22,Default,,0,0,0,,Мақсат! Мақсат мақсат Мақсат мақсат...
Dialogue: 0,3:28:18.22,3:28:23.72,Default,,0,0,0,,Мақсат Мақсат Мақсат Мақсат Мақсат Мақсат Мақсат!
Dialogue: 0,3:28:23.72,3:28:27.22,Default,,0,0,0,,Фу
Dialogue: 0,3:28:27.22,3:28:31.23,Default,,0,0,0,,Ааа, мен сәл байыпты болып кеттім.
Dialogue: 0,3:28:31.23,3:28:33.73,Default,,0,0,0,,<Үлкен бөтен жеңіс! ＞
Dialogue: 0,3:28:36.57,3:28:39.74,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,3:28:39.74,3:28:41.74,Default,,0,0,0,,Бар!
Dialogue: 0,3:28:41.74,3:28:44.74,Default,,0,0,0,,Жоқ, мен енді мұны істей алмаймын.
Dialogue: 0,3:28:44.74,3:28:46.74,Default,,0,0,0,,Сәттілік Секине
Dialogue: 0,3:28:46.74,3:28:49.75,Default,,0,0,0,,Мақсат дәл сіздің алдыңызда. Барымызды салайық.
Dialogue: 0,3:28:49.75,3:28:52.25,Default,,0,0,0,,Барлығы қолдан келгеннің бәрін жасады!
Dialogue: 0,3:28:52.25,3:28:54.92,Default,,0,0,0,,Биыл тағы да 1-ші болу керемет!
Dialogue: 0,3:28:54.92,3:28:57.42,Default,,0,0,0,,Құттықтаймыз Рикард-кун
Dialogue: 0,3:28:57.42,3:28:59.52,Default,,0,0,0,,Мен сенің қолыңнан келеді деп ойладым.
Dialogue: 0,3:29:01.59,3:29:05.43,Default,,0,0,0,,Ал, бұрынғыдан жалғастырайық. Дайын болыңыз.
Dialogue: 0,3:29:05.43,3:29:08.60,Default,,0,0,0,,Ааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,3:29:08.60,3:29:11.70,Default,,0,0,0,,《Рикка: Кешіріңіз, Цубаса ханым! Мен енді шыдай алмаймын! 》
Dialogue: 0,3:29:11.70,3:29:13.90,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,3:29:15.87,3:29:17.87,Default,,0,0,0,,Ха!
Dialogue: 0,3:29:21.38,3:29:23.55,Default,,0,0,0,,Бұл не...?
Dialogue: 0,3:29:23.55,3:29:25.55,Default,,0,0,0,,Олардың екеуі
Dialogue: 0,3:29:25.55,3:29:28.39,Default,,0,0,0,,Мен шайға кешігіп барамын.
Dialogue: 0,3:29:28.39,3:29:30.39,Default,,0,0,0,,Сіз Точакайсыз ба!?
Dialogue: 0,3:29:30.39,3:29:33.06,Default,,0,0,0,,Мен сенің не айтып тұрғаныңды түсінбеймін!
Dialogue: 0,3:29:33.06,3:29:36.39,Default,,0,0,0,,Бұл шай ішу. Басыңды ұрдың ба?
Dialogue: 0,3:29:36.39,3:29:38.40,Default,,0,0,0,,Бұл жыл сайынғы оқиға.
Dialogue: 0,3:29:38.40,3:29:42.57,Default,,0,0,0,,Уфуфу Мен тәттілер пісірдім.
Dialogue: 0,3:29:42.57,3:29:44.77,Default,,0,0,0,,Шай ішу! Керемет!
Dialogue: 0,3:29:46.90,3:29:50.41,Default,,0,0,0,,Қыздар мектептері ең жақсы!
Dialogue: 0,3:29:50.41,3:29:54.41,Default,,0,0,0,,Гүлдер құлағандықтан әдемі. О, жоқ.
Dialogue: 0,3:30:04.42,3:30:07.42,Default,,0,0,0,,Уф
Dialogue: 0,3:30:07.42,3:30:10.43,Default,,0,0,0,,Менің балансым осы айда да тығыз.
Dialogue: 0,3:30:10.43,3:30:13.26,Default,,0,0,0,,Сізге не қиын деп есептейсіз?
Dialogue: 0,3:30:13.26,3:30:17.60,Default,,0,0,0,,Сіздің отбасыңыз қайтып келмейтіндіктен емес пе?
Dialogue: 0,3:30:17.60,3:30:20.77,Default,,0,0,0,,<Қыздар орта мектебінде әдемі жігіт бар!
Dialogue: 0,3:30:20.77,3:30:23.94,Default,,0,0,0,,Бағдарламаға сенімдісіз бе? ＞
Dialogue: 0,3:30:23.94,3:30:26.78,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,3:30:26.78,3:30:32.08,Default,,0,0,0,,Уфуфу. Мен бұл жерде айта алмаймын.
Dialogue: 0,3:30:34.12,3:30:36.52,Default,,0,0,0,,Хмм?
Dialogue: 0,3:30:38.46,3:30:44.96,Default,,0,0,0,,Ертең жаттығу залының артына келсең
Dialogue: 0,3:30:44.96,3:30:47.46,Default,,0,0,0,,Мен сізге айтайын.
Dialogue: 0,3:30:47.46,3:30:49.47,Default,,0,0,0,,Ондай жерге неге баруым керек...
Dialogue: 0,3:30:49.47,3:30:53.97,Default,,0,0,0,,Иә? Сіз елсіз жерде сүйкімді қызды кездестіргіңіз келеді, солай ма?
Dialogue: 0,3:30:53.97,3:30:56.47,Default,,0,0,0,,Бірге жалғыз болайық
Dialogue: 0,3:30:56.47,3:30:59.31,Default,,0,0,0,,Байыппен жауап беруіңізді өтінемін!
Dialogue: 0,3:30:59.31,3:31:02.15,Default,,0,0,0,,Сенің ашулы жүзің де сүйкімді
Dialogue: 0,3:31:02.15,3:31:05.15,Default,,0,0,0,,Уф...
Dialogue: 0,3:31:05.15,3:31:08.15,Default,,0,0,0,,Уайымдамаңыз. Ха.
Dialogue: 0,3:31:08.15,3:31:12.76,Default,,0,0,0,,Мен сенің үнемі еңбектенетініңді білемін.
Dialogue: 0,3:31:12.76,3:31:15.26,Default,,0,0,0,,Ішек
Dialogue: 0,3:31:15.26,3:31:17.93,Default,,0,0,0,,Аа, дұрыс. иә?
Dialogue: 0,3:31:17.93,3:31:20.93,Default,,0,0,0,,Көзілдірікті шешіп жібере аласыз ба?
Dialogue: 0,3:31:20.93,3:31:24.77,Default,,0,0,0,,Өйткені ол осылай сүйкімдірек
Dialogue: 0,3:31:24.77,3:31:26.77,Default,,0,0,0,,Кешір мені. Қызығушылығымды тежей алмадым; мен жай ғана…
Dialogue: 0,3:31:28.77,3:31:31.97,Default,,0,0,0,,《Енді не болды?》
Dialogue: 0,3:31:34.95,3:31:39.28,Default,,0,0,0,,《Мүмкін бұл басқа сыныптың мұғалімі шығар?
Dialogue: 0,3:31:39.28,3:31:41.29,Default,,0,0,0,,Мен оны танымаймын》
Dialogue: 0,3:31:41.29,3:31:44.96,Default,,0,0,0,,Уф
Dialogue: 0,3:31:44.96,3:31:48.46,Default,,0,0,0,,Сіз өзіңізді жақсы сезінбейтін сияқтысыз. Сенімен бәрі жақсы ма?
Dialogue: 0,3:31:48.46,3:31:51.80,Default,,0,0,0,,Бұл дұрыс емес~ Негізі, үй жануарым
Dialogue: 0,3:31:51.80,3:31:54.63,Default,,0,0,0,,Ол қашып кетті. Жақсы.
Dialogue: 0,3:31:54.63,3:31:58.47,Default,,0,0,0,,《Ол қайда кетті?》
Dialogue: 0,3:31:58.47,3:32:02.47,Default,,0,0,0,,Фуку-чан: Cui cui. Мұндай жерде үй жануары бар ма!?
Dialogue: 0,3:32:04.48,3:32:08.15,Default,,0,0,0,,Осы жерден бірге аман шығайық
Dialogue: 0,3:32:08.15,3:32:11.75,Default,,0,0,0,,Достар. Кілт, сықырлау, сықырлау...
Dialogue: 0,3:32:11.75,3:32:15.59,Default,,0,0,0,,Ах. Кю? кезек
Dialogue: 0,3:32:15.59,3:32:17.59,Default,,0,0,0,,Кюкю Кюкю Кюкю…
Dialogue: 0,3:32:17.59,3:32:20.26,Default,,0,0,0,,Ахаха Тез жүгірсең қауіпті!
Dialogue: 0,3:32:20.26,3:32:22.26,Default,,0,0,0,,Сәлем! Шырылдаған...
Dialogue: 0,3:32:22.26,3:32:25.43,Default,,0,0,0,,<Болғанша қашып кетті>
Dialogue: 0,3:32:25.43,3:32:27.43,Default,,0,0,0,,《Фуку-чан》
Dialogue: 0,3:32:27.43,3:32:29.60,Default,,0,0,0,,《Атау мағынасы》
Dialogue: 0,3:32:29.60,3:32:34.10,Default,,0,0,0,,《Белгісіз планетада адасып қалдым. Мен сондай қайғылы болуым керек.
Dialogue: 0,3:32:34.10,3:32:37.11,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,3:32:37.11,3:32:40.28,Default,,0,0,0,,Фуку-чан басқа адамның миына спораларды имплантациялайды...》
Dialogue: 0,3:32:40.28,3:32:42.28,Default,,0,0,0,,Аю!
Dialogue: 0,3:32:42.28,3:32:47.48,Default,,0,0,0,,《Себебі менде идеалды қарама-қарсы жыныстың елесін көрсету мамандығы бар! 》
Dialogue: 0,3:32:49.45,3:32:52.55,Default,,0,0,0,,《Бұл планетада өте танымал екеніне сенімдімін》
Dialogue: 0,3:32:57.80,3:33:00.96,Default,,0,0,0,,Кюукюкюкю... Гуаааа
Dialogue: 0,3:33:00.96,3:33:02.97,Default,,0,0,0,,《Споралар?
Dialogue: 0,3:33:02.97,3:33:08.47,Default,,0,0,0,,Не? Басқаша айтқанда, бұл адам полковниктің үй жануарлары маған көрсеткен галлюцинация болды ма?
Dialogue: 0,3:33:08.47,3:33:14.07,Default,,0,0,0,,Бұл менің идеалды қарама-қарсы жынысым дегенді білдіреді! 》
Dialogue: 0,3:33:17.58,3:33:20.75,Default,,0,0,0,,<Қыздың қалауына тікелей қарсы тұра алмау>
Dialogue: 0,3:33:20.75,3:33:23.92,Default,,0,0,0,,Цубаса. Не?
Dialogue: 0,3:33:23.92,3:33:28.26,Default,,0,0,0,,Кешіріңіз, кеше "әйелдің бетін пирсинг" деп айтқаным үшін.
Dialogue: 0,3:33:28.26,3:33:30.26,Default,,0,0,0,,<Рефлексия>
Dialogue: 0,3:33:30.26,3:33:32.26,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,3:33:32.26,3:33:35.27,Default,,0,0,0,,А, онда жүр, мен сенен бір жақсылық сұрайын.
Dialogue: 0,3:33:35.27,3:33:38.27,Default,,0,0,0,,Бұл не? Ал...
Dialogue: 0,3:33:38.27,3:33:42.61,Default,,0,0,0,,Негізі қазір жақсы адам бар~
Dialogue: 0,3:33:42.61,3:33:45.94,Default,,0,0,0,,《Сіз жақсылық туралы айтып отырсыз ба? 》
Dialogue: 0,3:33:45.94,3:33:48.78,Default,,0,0,0,,Дәлірек айтсақ, сенің жігітің болды ма?
Dialogue: 0,3:33:48.78,3:33:52.62,Default,,0,0,0,,Аа, жоқ, менің айтқым келгені бұл емес.
Dialogue: 0,3:33:52.62,3:33:58.46,Default,,0,0,0,,Кеше бір дүкеннен мені шақырды.
Dialogue: 0,3:33:58.46,3:34:00.79,Default,,0,0,0,,Біз оған шынымен де қол жеткіздік.
Dialogue: 0,3:34:00.79,3:34:03.46,Default,,0,0,0,,...
Dialogue: 0,3:34:03.46,3:34:07.56,Default,,0,0,0,,Аа, сен жалғыз кездесемін дедің ғой, солай ма?
Dialogue: 0,3:34:11.40,3:34:14.57,Default,,0,0,0,,《Мүмкін қанаттың артқы жағында...》
Dialogue: 0,3:34:14.57,3:34:19.41,Default,,0,0,0,,Бұл: ``Уау, мұнда сондай керемет адам бар!'' сияқты.
Dialogue: 0,3:34:19.41,3:34:21.41,Default,,0,0,0,,《Мына қол жолға түсіп тұр! 》
Dialogue: 0,3:34:21.41,3:34:25.75,Default,,0,0,0,,Не айтарымды білмеймін~ Маған тағдырдың жазғаны сияқты~
Dialogue: 0,3:34:25.75,3:34:27.92,Default,,0,0,0,,《Қандай қыңыр》
Dialogue: 0,3:34:27.92,3:34:32.02,Default,,0,0,0,,Секине жоқ па? Бұл біртүрлі~
Dialogue: 0,3:34:34.26,3:34:37.26,Default,,0,0,0,,<Балабақша дерлік>
Dialogue: 0,3:34:37.26,3:34:43.60,Default,,0,0,0,,Цубаса мүмкін, бірақ ол басқа әлемде өмір сүреді...
Dialogue: 0,3:34:43.60,3:34:47.27,Default,,0,0,0,,Дүние, дәлірек айтсақ, жұлдыздар ма?
Dialogue: 0,3:34:47.27,3:34:50.11,Default,,0,0,0,,Міне, мен солай ойладым.
Dialogue: 0,3:34:50.11,3:34:52.94,Default,,0,0,0,,Менің жасым үлкен және сәйкес келмеуі мүмкін.
Dialogue: 0,3:34:52.94,3:34:54.95,Default,,0,0,0,,Қатты!
Dialogue: 0,3:34:54.95,3:34:57.95,Default,,0,0,0,,Бірақ бұл махаббат тек ауыртады...
Dialogue: 0,3:34:57.95,3:35:00.12,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,3:35:00.12,3:35:04.45,Default,,0,0,0,,Қалай аяқталса да, романтика - өмірдің түсі.
Dialogue: 0,3:35:04.45,3:35:06.79,Default,,0,0,0,,《Полковник, үндемеңіз.
Dialogue: 0,3:35:06.79,3:35:11.30,Default,,0,0,0,,Ах, бірақ адам араласқанда Цубаса ақымақ болып кетеді.
Dialogue: 0,3:35:11.30,3:35:15.40,Default,,0,0,0,,Осы жерде бір рет оның жүрегін сыздату дұрыс па? 》
Dialogue: 0,3:35:15.40,3:35:18.40,Default,,0,0,0,,Не?
Dialogue: 0,3:35:18.40,3:35:21.74,Default,,0,0,0,,《Өмір қысқа, ғашық бол, қыз
Dialogue: 0,3:35:21.74,3:35:25.58,Default,,0,0,0,,Фуку-чан қайтып келмесе де
Dialogue: 0,3:35:25.58,3:35:30.75,Default,,0,0,0,,Мен сенің осы планетада біреумен бақытты болғаныңды қалаймын...
Dialogue: 0,3:35:30.75,3:35:34.25,Default,,0,0,0,,Бірақ бұл мүмкін емес тілек.
Dialogue: 0,3:35:34.25,3:35:36.25,Default,,0,0,0,,《Мазаламау》
Dialogue: 0,3:35:36.25,3:35:39.26,Default,,0,0,0,,《Фуку-чан галлюцинацияға ұшыраған адамды азғырды
Dialogue: 0,3:35:39.26,3:35:41.93,Default,,0,0,0,,Экстазда
Dialogue: 0,3:35:41.93,3:35:44.73,Default,,0,0,0,,Өйткені олар оны жеп, қоректік зат ретінде пайдаланады》
Dialogue: 0,3:35:47.76,3:35:52.27,Default,,0,0,0,,Ол кісі сенен бүгін түнеуіңді сұрады.
Dialogue: 0,3:35:52.27,3:35:55.94,Default,,0,0,0,,Жоқ! Да, жоқ!
Dialogue: 0,3:35:55.94,3:36:01.45,Default,,0,0,0,,Цубаса-сан! Қандай ұйықтау!
Dialogue: 0,3:36:01.45,3:36:04.62,Default,,0,0,0,,Жарайды! Сол себепті
Dialogue: 0,3:36:04.62,3:36:08.29,Default,,0,0,0,,Секине-нчиде қалғанымды маған қалдыра аласыз ба?
Dialogue: 0,3:36:08.29,3:36:15.56,Default,,0,0,0,,Цубаса Мен сізден тікелей сұраймын.
Dialogue: 0,3:36:15.56,3:36:18.06,Default,,0,0,0,,Жеп қойсаңыз да өкінбейсіз бе?
Dialogue: 0,3:36:18.06,3:36:21.06,Default,,0,0,0,,Секине тым тура!
Dialogue: 0,3:36:21.06,3:36:24.40,Default,,0,0,0,,Жоқ, мен Секинеде бармын. 《Мен бүгін өлетін шығармын.》
Dialogue: 0,3:36:24.40,3:36:26.40,Default,,0,0,0,,Бұл өте нашар!
Dialogue: 0,3:36:26.40,3:36:29.91,Default,,0,0,0,,《Жоқ, әрине, біз мұны тоқтатуымыз керек.
Dialogue: 0,3:36:29.91,3:36:32.24,Default,,0,0,0,,Бірақ мен не істеуім керек?
Dialogue: 0,3:36:32.24,3:36:36.08,Default,,0,0,0,,Аххххххххх...
Dialogue: 0,3:36:36.08,3:36:38.92,Default,,0,0,0,,<Пипидепапидепу>
Dialogue: 0,3:36:38.92,3:36:41.59,Default,,0,0,0,,《Секине: Споралар бар деп ойлаймын~
Dialogue: 0,3:36:41.59,3:36:44.42,Default,,0,0,0,,Алсам, әйтеуір әйтеуір орындала ма деп ойлаймын.
Dialogue: 0,3:36:44.42,3:36:48.59,Default,,0,0,0,,А, біз Фуку-чан туралы бірдеңе істеуіміз керек.
Dialogue: 0,3:36:48.59,3:36:51.26,Default,,0,0,0,,Құрбандар саны өсуде》
Dialogue: 0,3:36:51.26,3:36:55.60,Default,,0,0,0,,Амансың ба? Секине
Dialogue: 0,3:36:55.60,3:36:57.60,Default,,0,0,0,,А, а, а...
Dialogue: 0,3:36:57.60,3:36:59.77,Default,,0,0,0,,《Кешір мені, Қанаттар.
Dialogue: 0,3:36:59.77,3:37:02.07,Default,,0,0,0,,Мен сізге жем ретінде әрекет етемін! 》
Dialogue: 0,3:37:06.78,3:37:10.11,Default,,0,0,0,,《Келесің бе, Фуку-чан? иә?
Dialogue: 0,3:37:10.11,3:37:12.88,Default,,0,0,0,,А, бұл Чио-сан.
Dialogue: 0,3:37:12.88,3:37:16.72,Default,,0,0,0,,《Бұл аздап қорқынышты, бірақ бұл жылқының сүйегі.
Dialogue: 0,3:37:16.72,3:37:18.89,Default,,0,0,0,,Мен сізге дыбысты көрсетейін! 》
Dialogue: 0,3:37:18.89,3:37:22.06,Default,,0,0,0,,Алдымен екі отбасына сәлем айтайық!
Dialogue: 0,3:37:22.06,3:37:24.06,Default,,0,0,0,,Өрмектей өрілген тағдырлар
Dialogue: 0,3:37:24.06,3:37:26.76,Default,,0,0,0,,《Бейне жаттығулары тамаша》
Dialogue: 0,3:37:28.73,3:37:31.23,Default,,0,0,0,,Маған керек!
Dialogue: 0,3:37:31.23,3:37:34.57,Default,,0,0,0,,Ах
Dialogue: 0,3:37:34.57,3:37:36.91,Default,,0,0,0,,Иә?
Dialogue: 0,3:37:36.91,3:37:41.21,Default,,0,0,0,,《Бұл адам неге менімен сөйлесті? 》
Dialogue: 0,3:37:44.25,3:37:46.25,Default,,0,0,0,,Ах
Dialogue: 0,3:37:48.92,3:37:51.76,Default,,0,0,0,,Сықырлау сигналы...＜Ол әлі қосылып тұрды＞
Dialogue: 0,3:37:51.76,3:37:54.42,Default,,0,0,0,,Хмф! Арх!
Dialogue: 0,3:37:54.42,3:37:56.43,Default,,0,0,0,,Иә?
Dialogue: 0,3:37:56.43,3:38:01.43,Default,,0,0,0,,《Қайда бардың? бұл жұмбақ жағдай
Dialogue: 0,3:38:01.43,3:38:04.10,Default,,0,0,0,,Мен Фуку-чанның осында екеніне сенімдімін》
Dialogue: 0,3:38:04.10,3:38:06.44,Default,,0,0,0,,А, а...
Dialogue: 0,3:38:06.44,3:38:11.54,Default,,0,0,0,,Жарайды, жарайды, менімен ыстық уақыт өткізейік.
Dialogue: 0,3:38:11.54,3:38:15.55,Default,,0,0,0,,Цубаса мырза, бұл сіздің хоббиіңіз бе?
Dialogue: 0,3:38:15.55,3:38:19.38,Default,,0,0,0,,Кешірім сұраймын.
Dialogue: 0,3:38:19.38,3:38:24.72,Default,,0,0,0,,《Мүмкін Чио-сан қазір өзінің идеалды серіктесін көруі мүмкін.
Dialogue: 0,3:38:24.72,3:38:29.39,Default,,0,0,0,,Бірақ сізде қиындықтар бар ма? Неге сонша жиіркенішті көрінесің? 》
Dialogue: 0,3:38:29.39,3:38:34.40,Default,,0,0,0,,Сіз Цубаса-санның досысыз ба?
Dialogue: 0,3:38:34.40,3:38:37.23,Default,,0,0,0,,<Сызба күйзеліс салдарынан құлады>
Dialogue: 0,3:38:37.23,3:38:40.90,Default,,0,0,0,,《Мен не істеуім керек? Егер мен оны көрмесем, мен сізге көмектесе алмаймын.
Dialogue: 0,3:38:40.90,3:38:43.41,Default,,0,0,0,,Егер менде ерекше өкілеттіктер болса...
Dialogue: 0,3:38:43.41,3:38:45.41,Default,,0,0,0,,Иә! 》
Dialogue: 0,3:38:45.41,3:38:47.91,Default,,0,0,0,,<Ханайым уақыты
Dialogue: 0,3:38:47.91,3:38:52.42,Default,,0,0,0,,Бұл Секине өзінің табиғаттан тыс күштерін басқара алатын уақытты білдіреді.＞
Dialogue: 0,3:38:52.42,3:38:55.25,Default,,0,0,0,,《Бірақ мен оны қолдансам...
Dialogue: 0,3:38:55.25,3:38:58.76,Default,,0,0,0,,Жоқ, бұлай жалғаса берсе, екеумізге қауіп төнеді.
Dialogue: 0,3:38:58.76,3:39:03.43,Default,,0,0,0,,Сәлем! Секине Ай!
Dialogue: 0,3:39:03.43,3:39:07.26,Default,,0,0,0,,<Түсіндірейік! Секине қазір
Dialogue: 0,3:39:07.26,3:39:10.77,Default,,0,0,0,,Мен Чиёның не көріп тұрғанын көріп тұрмын＞
Dialogue: 0,3:39:10.77,3:39:14.37,Default,,0,0,0,,《Мүмкін бұл Фуку-чан шығар.
Dialogue: 0,3:39:14.37,3:39:17.37,Default,,0,0,0,,Ішімді құрбандыққа шалуға тұрарлық еді.
Dialogue: 0,3:39:17.37,3:39:19.38,Default,,0,0,0,,Қалай болғанда да...
Dialogue: 0,3:39:19.38,3:39:22.55,Default,,0,0,0,,Ол ересектерге арналған комикстерде көрінетін жігіт.
Dialogue: 0,3:39:22.55,3:39:26.22,Default,,0,0,0,,Чио-сан, саған бұл түрі ұнай ма?
Dialogue: 0,3:39:26.22,3:39:28.55,Default,,0,0,0,,Аа~ түсіндім. Жарайды, жарайды.
Dialogue: 0,3:39:28.55,3:39:31.56,Default,,0,0,0,,Сіз Чанцубаның досысыз ба?
Dialogue: 0,3:39:31.56,3:39:36.23,Default,,0,0,0,,Мен сені қатты жақсы көремін~
Dialogue: 0,3:39:36.23,3:39:40.90,Default,,0,0,0,,Цубаса мырзамен араласпаңыз.
Dialogue: 0,3:39:40.90,3:39:45.24,Default,,0,0,0,,Бір өтінемін
Dialogue: 0,3:39:45.24,3:39:48.24,Default,,0,0,0,,Олай болса, сен маған серік боласың ба?
Dialogue: 0,3:39:48.24,3:39:50.41,Default,,0,0,0,,Чанцуба~ орнына
Dialogue: 0,3:39:50.41,3:39:54.08,Default,,0,0,0,,《Сіз нені айтып тұрсыз? А, мүмкін
Dialogue: 0,3:39:54.08,3:39:58.08,Default,,0,0,0,,Фуку-чан міндетті түрде менің идеалды серіктесім емес.
Dialogue: 0,3:39:58.08,3:40:01.75,Default,,0,0,0,,Көбеюге әкелетін галлюцинацияларды көрсету\NБұл
Dialogue: 0,3:40:01.75,3:40:03.92,Default,,0,0,0,,дегенді білдіре ме?
Dialogue: 0,3:40:03.92,3:40:06.92,Default,,0,0,0,,Сондықтан мен Цубаса-санды енді ешқашан көрмеймін...
Dialogue: 0,3:40:06.92,3:40:10.09,Default,,0,0,0,,Ронмочи~ Мен кездеспеймін. Мен сені кездестірмеймін.
Dialogue: 0,3:40:10.09,3:40:12.10,Default,,0,0,0,,Түсінді.
Dialogue: 0,3:40:12.10,3:40:14.10,Default,,0,0,0,,Өлтірейік
Dialogue: 0,3:40:14.10,3:40:16.43,Default,,0,0,0,,《Ол болады.》
Dialogue: 0,3:40:16.43,3:40:20.27,Default,,0,0,0,,《Чиё: Бірақ мен қолымды кірлетпеуді шештім.
Dialogue: 0,3:40:20.27,3:40:22.61,Default,,0,0,0,,Шура жолына қарай? 》
Dialogue: 0,3:40:22.61,3:40:24.77,Default,,0,0,0,,Эй, асығыңыз~
Dialogue: 0,3:40:24.77,3:40:27.11,Default,,0,0,0,,Біз жалғыз боламыз ба?
Dialogue: 0,3:40:27.11,3:40:30.11,Default,,0,0,0,,《Қорқынышты! 》＜Мен сені өлтіретін сияқтымын＞
Dialogue: 0,3:40:30.11,3:40:32.62,Default,,0,0,0,,Чио-сан!
Dialogue: 0,3:40:32.62,3:40:34.78,Default,,0,0,0,,Кілт. Жақсы емес.
Dialogue: 0,3:40:34.78,3:40:37.45,Default,,0,0,0,,Ойтаға тым көп
Dialogue: 0,3:40:37.45,3:40:39.79,Default,,0,0,0,,Тапсырма!
Dialogue: 0,3:40:39.79,3:40:43.29,Default,,0,0,0,,《Тамаша~ Полковник! Бұл матч сорғы! 》
Dialogue: 0,3:40:43.29,3:40:45.80,Default,,0,0,0,,О, бұрынғы адам ше?
Dialogue: 0,3:40:45.80,3:40:49.13,Default,,0,0,0,,Мен бұл туралы хабарладым! Мен оның қашып кеткеніне сенімдімін
Dialogue: 0,3:40:49.13,3:40:51.97,Default,,0,0,0,,《Бірақ мен бұл шындық деп ешқашан ойламадым.
Dialogue: 0,3:40:51.97,3:40:55.14,Default,,0,0,0,,Жер бетіндегілермен ұрпақ өсіруге тырысу.
Dialogue: 0,3:40:55.14,3:40:59.81,Default,,0,0,0,,(ызылдаған)
Dialogue: 0,3:40:59.81,3:41:01.81,Default,,0,0,0,,Әй?
Dialogue: 0,3:41:01.81,3:41:05.48,Default,,0,0,0,,Иә? Барлығы, неге мұндасыңдар?
Dialogue: 0,3:41:05.48,3:41:10.58,Default,,0,0,0,,Сіз ештеңе істей алмайсыз! Дезинфекциялау!
Dialogue: 0,3:41:14.93,3:41:17.43,Default,,0,0,0,,Не? Гехо Гехо
Dialogue: 0,3:41:23.43,3:41:25.43,Default,,0,0,0,,Жарайды!
Dialogue: 0,3:41:27.44,3:41:29.44,Default,,0,0,0,,Не?
Dialogue: 0,3:41:35.95,3:41:37.95,Default,,0,0,0,,Өте сүйкімді
Dialogue: 0,3:41:37.95,3:41:40.62,Default,,0,0,0,,Мен саған көмектесемін
Dialogue: 0,3:41:40.62,3:41:43.29,Default,,0,0,0,,Мен жалғыз болдым.
Dialogue: 0,3:41:43.29,3:41:46.29,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,3:41:46.29,3:41:50.96,Default,,0,0,0,,<Кейінгі әсерлер Элингиді әдемі етіп көрсетті>
Dialogue: 0,3:41:50.96,3:41:52.96,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,3:41:52.96,3:41:55.30,Default,,0,0,0,,<Жалғыз қалдырсам жазылды>
Dialogue: 0,3:41:55.30,3:41:57.50,Default,,0,0,0,,Қош бол
Dialogue: 0,3:45:13.43,3:45:16.27,Default,,0,0,0,,《Секине: Сәлем. Бұл Секине, D класындағы экстрасенс.
Dialogue: 0,3:45:16.27,3:45:19.60,Default,,0,0,0,,Менің жалғыз қабілетім - кейде басқалардың ойын оқи білу! 》
Dialogue: 0,3:45:19.60,3:45:23.77,Default,,0,0,0,,《Бір адам қалса да, тұтынушылар келмейді.》
Dialogue: 0,3:45:23.77,3:45:28.28,Default,,0,0,0,,《Секине: Мен тым болмаса біреуге көмектескім келеді...》
Dialogue: 0,3:45:28.28,3:45:30.28,Default,,0,0,0,,Иә?
Dialogue: 0,3:45:30.28,3:45:33.78,Default,,0,0,0,,1000-шы келуіңізбен құттықтаймыз!
Dialogue: 0,3:45:33.78,3:45:37.45,Default,,0,0,0,,《Секине: Бірақ егер сіз өз қабілеттеріңізді пайда табу үшін пайдалансаңыз...》
Dialogue: 0,3:45:37.45,3:45:40.46,Default,,0,0,0,,Біз керемет сыйлықтарды ұсынамыз!
Dialogue: 0,3:45:40.46,3:45:43.46,Default,,0,0,0,,《Секине: Ұйым сені тартып алады~! 》
Dialogue: 0,3:47:23.43,3:47:27.26,Default,,0,0,0,,Ойын-сауық саябағы билеттерін алғысы келетіндер!
Dialogue: 0,3:47:27.26,3:47:29.27,Default,,0,0,0,,Иә Иә Иә…
Dialogue: 0,3:47:29.27,3:47:32.44,Default,,0,0,0,,<Ал билет Рикканың қолында>
Dialogue: 0,3:47:32.44,3:47:36.11,Default,,0,0,0,,Чио-сан, бірге...
Dialogue: 0,3:47:36.11,3:47:38.44,Default,,0,0,0,,Иә, кеттік!
Dialogue: 0,3:47:38.44,3:47:41.28,Default,,0,0,0,,Секине бару керек пе?
Dialogue: 0,3:47:41.28,3:47:46.62,Default,,0,0,0,,Иә. Комитет төрағасы ретінде мен бүкіл сыныпқа қызмет еткім келеді.
Dialogue: 0,3:47:46.62,3:47:49.79,Default,,0,0,0,,Секине мырза, қандай мейірімді адам!
Dialogue: 0,3:47:49.79,3:47:52.46,Default,,0,0,0,,《Секине: Менің де барғым келеді! 》
Dialogue: 0,3:47:52.46,3:47:55.96,Default,,0,0,0,,《Рикка: Мен ойын-сауық саябағын асыға күтемін.
Dialogue: 0,3:47:55.96,3:48:01.06,Default,,0,0,0,,Балалық шағым, ұшқыш ретінде арнайы білім алған кезді еске алғанда...》
Dialogue: 0,3:48:04.13,3:48:08.30,Default,,0,0,0,,《Жас ерекшелігіне сай ойын болған жоқ》
Dialogue: 0,3:48:08.30,3:48:12.60,Default,,0,0,0,,Ғарыштық сегізаяқ: Сегізаяқ сегізаяқ...｡ Ахахахаха…
Dialogue: 0,3:48:14.58,3:48:17.91,Default,,0,0,0,,《Ха, жоқ! Мен не істедім
Dialogue: 0,3:48:17.91,3:48:21.91,Default,,0,0,0,,Революция ұмтылысына қайшы келетін істермен айналысу
Dialogue: 0,3:48:24.59,3:48:27.42,Default,,0,0,0,,Ойын-сауық саябағы?
Dialogue: 0,3:48:27.42,3:48:29.93,Default,,0,0,0,,《Рикка сондай бақытты көрінеді.
Dialogue: 0,3:48:29.93,3:48:33.93,Default,,0,0,0,,Сіз ойын-сауық саябағына бара алатыныңызға шынымен бақыттысыз ба?
Dialogue: 0,3:48:33.93,3:48:38.77,Default,,0,0,0,,《Рикка: Бірақ мен күні не киюім керек?
Dialogue: 0,3:48:38.77,3:48:43.27,Default,,0,0,0,,Сәнді Чиёны ұятқа қалдырмайтындай етіп киінуіміз керек.
Dialogue: 0,3:48:43.27,3:48:47.11,Default,,0,0,0,,Біркелкі... әдеттегідей тым көп.
Dialogue: 0,3:48:47.11,3:48:50.11,Default,,0,0,0,,Әскери киімдер де... жұмсақ.
Dialogue: 0,3:48:50.11,3:48:53.45,Default,,0,0,0,,туралы айтатын болсақ, бұл жалғыз нұсқа! 》
Dialogue: 0,3:48:53.45,3:48:56.05,Default,,0,0,0,,(діріл дыбысы)
Dialogue: 0,3:48:58.12,3:49:00.12,Default,,0,0,0,,Не!
Dialogue: 0,3:49:00.12,3:49:04.63,Default,,0,0,0,,Мен ойын-сауық саябағы үшін киіндім.
Dialogue: 0,3:49:04.63,3:49:07.30,Default,,0,0,0,,Рикканың киім сезімі
Dialogue: 0,3:49:07.30,3:49:11.73,Default,,0,0,0,,Осы киімді киген адаммен жүруге мәжбүр болатын жазалау ойыны!?
Dialogue: 0,3:49:11.73,3:49:14.24,Default,,0,0,0,,Жауап беру үшін не істеуім керек?
Dialogue: 0,3:49:14.24,3:49:18.07,Default,,0,0,0,,А, бірақ мен Чио-санның мұны тоқтататынына сенімдімін.
Dialogue: 0,3:49:18.07,3:49:21.91,Default,,0,0,0,,Ұнады, ұнайды, ұнайды...
Dialogue: 0,3:49:21.91,3:49:25.01,Default,,0,0,0,,《Цубаса: күтпеген толық растау! 》
Dialogue: 0,3:49:30.42,3:49:32.59,Default,,0,0,0,,Ауа райы жақсы.
Dialogue: 0,3:49:32.59,3:49:35.09,Default,,0,0,0,,Қызық, қазір екеуіміз көңіл көтеріп жүрміз бе?
Dialogue: 0,3:49:37.09,3:49:39.43,Default,,0,0,0,,Цубаса мырза, жақсы жерде
Dialogue: 0,3:49:39.43,3:49:41.76,Default,,0,0,0,,Иә!? Чио-сан!?
Dialogue: 0,3:49:41.76,3:49:43.77,Default,,0,0,0,,Бұл қызыл түсті!?
Dialogue: 0,3:49:43.77,3:49:45.77,Default,,0,0,0,,Кенет күшті жау...
Dialogue: 0,3:49:45.77,3:49:49.94,Default,,0,0,0,,Жоқ, мен жұмысқа байланысты бара алмаймын, сондықтан Рикка-чанға хабар беріңіз!
Dialogue: 0,3:49:49.94,3:49:53.44,Default,,0,0,0,,А? Қош бол!
Dialogue: 0,3:49:53.44,3:49:55.78,Default,,0,0,0,,Қоштасу?
Dialogue: 0,3:49:55.78,3:49:59.45,Default,,0,0,0,,Бірақ бұл керемет сурет болды, Чио-сан.
Dialogue: 0,3:49:59.45,3:50:01.95,Default,,0,0,0,,Әзірге Риккаға қоңырау шалыңыз...
Dialogue: 0,3:50:01.95,3:50:04.45,Default,,0,0,0,,Қосылмаған
Dialogue: 0,3:50:04.45,3:50:07.12,Default,,0,0,0,,Сайтқа кіруден басқа амал жоқ па?
Dialogue: 0,3:50:07.12,3:50:09.46,Default,,0,0,0,,А, оған дейін мен формамды ауыстыруым керек.
Dialogue: 0,3:50:09.46,3:50:11.73,Default,,0,0,0,,Жоқ, осылай жалғастыра аламыз ба?
Dialogue: 0,3:50:11.73,3:50:14.73,Default,,0,0,0,,Чио-сан, тіпті мен бірден түсіндім.
Dialogue: 0,3:50:14.73,3:50:17.23,Default,,0,0,0,,Не!? Бұл мені білдіреді.
Dialogue: 0,3:50:17.23,3:50:21.74,Default,,0,0,0,,Әйел сияқты киінбесең де қызға ұқсайсың деген сөз бе?
Dialogue: 0,3:50:21.74,3:50:24.94,Default,,0,0,0,,Гаан! <Есті-зайыпты>
Dialogue: 0,3:50:30.41,3:50:33.42,Default,,0,0,0,,《Чионың кешігуі әдеттен тыс.
Dialogue: 0,3:50:33.42,3:50:36.59,Default,,0,0,0,,Мен апатқа ұшыраған жоқпын деп үміттенемін.
Dialogue: 0,3:50:36.59,3:50:40.59,Default,,0,0,0,,Оның келе алмауының бір себебі болуы керек.
Dialogue: 0,3:50:40.59,3:50:42.76,Default,,0,0,0,,Мәселе жоқ!
Dialogue: 0,3:50:42.76,3:50:47.43,Default,,0,0,0,,Бірінші кезекте дәл қазір ғарышта жолдастар жауға қарсы соғысуда.
Dialogue: 0,3:50:47.43,3:50:52.77,Default,,0,0,0,,Жалғыз ләззат алу идеясы өзімшілдік еді! 》
Dialogue: 0,3:50:52.77,3:50:54.94,Default,,0,0,0,,Қарғыс атсын. (Цубаса) Рикка!
Dialogue: 0,3:50:54.94,3:50:56.94,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,3:50:56.94,3:50:59.28,Default,,0,0,0,,Цубаса неге мұнда?
Dialogue: 0,3:50:59.28,3:51:01.94,Default,,0,0,0,,Бұл... Цюоси (Иноуэ)!
Dialogue: 0,3:51:01.94,3:51:05.28,Default,,0,0,0,,Иоу!? Бұл бала туысы ма?
Dialogue: 0,3:51:05.28,3:51:07.62,Default,,0,0,0,,Ах, мм. Инуэ!
Dialogue: 0,3:51:07.62,3:51:11.02,Default,,0,0,0,,А, менің досым келді. Жуықта көріскенше!
Dialogue: 0,3:51:12.89,3:51:14.89,Default,,0,0,0,,Иә?
Dialogue: 0,3:51:14.89,3:51:19.06,Default,,0,0,0,,Цубасаның... егіз ағасы Цюёси.
Dialogue: 0,3:51:19.06,3:51:21.40,Default,,0,0,0,,《Олар бір адамға ұқсайды! 》
Dialogue: 0,3:51:21.40,3:51:23.57,Default,,0,0,0,,<Тамаша жауап! ＞
Dialogue: 0,3:51:23.57,3:51:28.07,Default,,0,0,0,,Чио-сан кейбір жағдайларға байланысты келе алмайды...
Dialogue: 0,3:51:28.07,3:51:31.74,Default,,0,0,0,,Менің орныма әпкем келуі керек еді, бірақ...
Dialogue: 0,3:51:31.74,3:51:33.74,Default,,0,0,0,,Мен енді олай істей алмаймын...
Dialogue: 0,3:51:33.74,3:51:36.41,Default,,0,0,0,,Солай ма?
Dialogue: 0,3:51:36.41,3:51:38.58,Default,,0,0,0,,Рахмет
Dialogue: 0,3:51:38.58,3:51:42.98,Default,,0,0,0,,Мен жалғыз жүргенді ұнатпаймын, сондықтан мен үйге қарай бет алдым.
Dialogue: 0,3:51:46.09,3:51:48.09,Default,,0,0,0,,О!
Dialogue: 0,3:51:48.09,3:51:52.09,Default,,0,0,0,,Маған жақсы болса, менімен бірге айналайын ба?
Dialogue: 0,3:51:54.43,3:51:57.77,Default,,0,0,0,,Мен не мінуім керек?
Dialogue: 0,3:51:57.77,3:52:00.10,Default,,0,0,0,,Оны кездейсоқ түрде айту дұрыс.
Dialogue: 0,3:52:00.10,3:52:02.30,Default,,0,0,0,,Иә
Dialogue: 0,3:52:06.44,3:52:12.22,Default,,0,0,0,,Рикка не мінгісі келсе, соны жасайық. Мен қалағанымды істеймін.
Dialogue: 0,3:52:12.22,3:52:15.05,Default,,0,0,0,,Уау!
Dialogue: 0,3:52:15.05,3:52:17.89,Default,,0,0,0,,(Тынысы тарылған дыбыс)
Dialogue: 0,3:52:17.89,3:52:19.89,Default,,0,0,0,,Әрі қарай немен жүруім керек?
Dialogue: 0,3:52:19.89,3:52:23.73,Default,,0,0,0,,Мен не жақсы болар еді деп ойлаймын. Мен сондай қуаныштымын.
Dialogue: 0,3:52:23.73,3:52:26.06,Default,,0,0,0,,Иә. Ах...
Dialogue: 0,3:52:26.06,3:52:28.40,Default,,0,0,0,,《Екі адам: Көңіл көтеру өте қиын》
Dialogue: 0,3:52:28.40,3:52:32.74,Default,,0,0,0,,《Ойын-сауық саябағы соншалықты қызық емес пе еді? 》
Dialogue: 0,3:52:32.74,3:52:35.91,Default,,0,0,0,,《Чио-санды сағындым》
Dialogue: 0,3:52:35.91,3:52:39.58,Default,,0,0,0,,Әй, қарағым, сен шаттыққа мінгің келе ме?
Dialogue: 0,3:52:39.58,3:52:42.75,Default,,0,0,0,,Әй, мінгің келсе.
Dialogue: 0,3:52:42.75,3:52:45.08,Default,,0,0,0,,Маған бәрібір. иә?
Dialogue: 0,3:52:45.08,3:52:48.25,Default,,0,0,0,,Хехе...＜Полковник, күйзелістен шаршаған＞
Dialogue: 0,3:52:48.25,3:52:50.42,Default,,0,0,0,,《Қандай жеңілдік?
Dialogue: 0,3:52:50.42,3:52:53.59,Default,,0,0,0,,Мен оны мінгім келген сияқты.
Dialogue: 0,3:52:53.59,3:52:59.43,Default,,0,0,0,,Ахахаха Уау~ Мен көңілді раундтарды жақсы көремін~!
Dialogue: 0,3:52:59.43,3:53:03.43,Default,,0,0,0,,《Бұл бала да маған мейірімділік танытты.
Dialogue: 0,3:53:03.43,3:53:05.94,Default,,0,0,0,,Ең дұрысы, біз мұны бірге істеуіміз керек》
Dialogue: 0,3:53:05.94,3:53:08.27,Default,,0,0,0,,Қане, сапқа тұрайық.
Dialogue: 0,3:53:08.27,3:53:11.87,Default,,0,0,0,,Маған ұнады... Бұл не?
Dialogue: 0,3:53:11.87,3:53:14.38,Default,,0,0,0,,《Маған ұнады... Бұл не? 》
Dialogue: 0,3:53:14.38,3:53:18.88,Default,,0,0,0,,Егер бірдеңе болса, маған айқайлау түрлері ұнайды.
Dialogue: 0,3:53:18.88,3:53:21.98,Default,,0,0,0,,Айқайлау түрі? Мүмкін...
Dialogue: 0,3:53:24.05,3:53:26.06,Default,,0,0,0,,О!
Dialogue: 0,3:53:26.06,3:53:28.39,Default,,0,0,0,,Уау! Ах~!
Dialogue: 0,3:53:28.39,3:53:30.73,Default,,0,0,0,,Ах~
Dialogue: 0,3:53:30.73,3:53:34.56,Default,,0,0,0,,Ууууууу!
Dialogue: 0,3:53:34.56,3:53:37.40,Default,,0,0,0,,《2 адам: Бұл қызық болуы мүмкін! 》
Dialogue: 0,3:53:37.40,3:53:44.24,Default,,0,0,0,,Ахахахаха...｡ Ахахаха хехехехехе...
Dialogue: 0,3:53:44.24,3:53:46.58,Default,,0,0,0,,<Сол кездегі Чиё>
Dialogue: 0,3:53:46.58,3:53:49.78,Default,,0,0,0,,Құпия техника Ролик костер!
Dialogue: 0,3:53:52.75,3:53:55.08,Default,,0,0,0,,<Сол кездегі Секине>
Dialogue: 0,3:53:55.08,3:53:58.59,Default,,0,0,0,,Мен өз қабілеттерімді пайда табу үшін пайдаланбадым.
Dialogue: 0,3:53:58.59,3:54:00.59,Default,,0,0,0,,Ешқашан!
Dialogue: 0,3:54:00.59,3:54:03.93,Default,,0,0,0,,Мен ойнамайтын жер де осы.
Dialogue: 0,3:54:03.93,3:54:05.93,Default,,0,0,0,,《Бұл қызықсыз сияқты》
Dialogue: 0,3:54:05.93,3:54:09.27,Default,,0,0,0,,Осыған тоқталайық. Е, қорқынышты.
Dialogue: 0,3:54:09.27,3:54:11.27,Default,,0,0,0,,Олай болса, тоқталайық.
Dialogue: 0,3:54:11.27,3:54:16.04,Default,,0,0,0,,《Мен кірудің қажеті жоқ па? Түсіндім.》
Dialogue: 0,3:54:16.04,3:54:19.38,Default,,0,0,0,,Жақсы! Бұл қорқынышты!
Dialogue: 0,3:54:19.38,3:54:23.71,Default,,0,0,0,,Мен кіре алмаймын, өйткені бұл өте қорқынышты! Бір шолу
Dialogue: 0,3:54:23.71,3:54:26.72,Default,,0,0,0,,《Не, кенет жалқау бала!
Dialogue: 0,3:54:26.72,3:54:28.72,Default,,0,0,0,,Мен бұған дейін сенімдімін...》
Dialogue: 0,3:54:28.72,3:54:32.05,Default,,0,0,0,,Мен тағы да қамқоршы рухты болжауды сынап көргім келеді.
Dialogue: 0,3:54:32.05,3:54:35.39,Default,,0,0,0,,Кешіріңіз, бірақ рухтар мен кейінгі өмір сияқты нәрселер бар.
Dialogue: 0,3:54:35.39,3:54:39.06,Default,,0,0,0,,Мен сене алар емеспін. Мен түссіндім.
Dialogue: 0,3:54:39.06,3:54:43.57,Default,,0,0,0,,Өлім ғаламда шаңға айналу деген сөз.
Dialogue: 0,3:54:43.57,3:54:45.57,Default,,0,0,0,,《Осылай дедіңіз! 》
Dialogue: 0,3:54:45.57,3:54:47.57,Default,,0,0,0,,Бұл қорқынышты!
Dialogue: 0,3:54:47.57,3:54:52.41,Default,,0,0,0,,《Не істеуім керек...күте тұрыңыз, егер бұл Чиё-санда болса...》
Dialogue: 0,3:54:52.41,3:54:55.24,Default,,0,0,0,,Кя~! Ядда! Бұл қорқынышты!
Dialogue: 0,3:54:55.24,3:54:57.75,Default,,0,0,0,,《``Кяаакяа'' деп шу шығарғысы келген!
Dialogue: 0,3:54:57.75,3:55:01.75,Default,,0,0,0,,Қыздар бар, солай ма? Жақсы.
Dialogue: 0,3:55:01.75,3:55:05.09,Default,,0,0,0,,《Рикка: Мен қосылдым》
Dialogue: 0,3:55:05.09,3:55:09.76,Default,,0,0,0,,Уау! Эй!
Dialogue: 0,3:55:09.76,3:55:13.93,Default,,0,0,0,,Уау! Өте қорқынышты!
Dialogue: 0,3:55:13.93,3:55:16.77,Default,,0,0,0,,<Үмітсіз жандану>
Dialogue: 0,3:55:16.77,3:55:18.93,Default,,0,0,0,,《Рикка: Неге сонша таң қалдың?
Dialogue: 0,3:55:18.93,3:55:21.43,Default,,0,0,0,,<Жіберілмеді...>
Dialogue: 0,3:55:23.44,3:55:27.11,Default,,0,0,0,,Иә? Кенет салқын жел
Dialogue: 0,3:55:27.11,3:55:31.11,Default,,0,0,0,,《Мм, бұл белгі...》
Dialogue: 0,3:55:31.11,3:55:35.62,Default,,0,0,0,,《Иә? Мұндағы түсінік – аурухана үлгісіндегі қирандылар.
Dialogue: 0,3:55:35.62,3:55:37.95,Default,,0,0,0,,Неліктен қаза тапқан жауынгерлер?
Dialogue: 0,3:55:37.95,3:55:41.29,Default,,0,0,0,,Ойлап қарасам, бұл аймақ бұрын соғыс алаңы болған.
Dialogue: 0,3:55:41.29,3:55:44.29,Default,,0,0,0,,Тіпті ойын-сауық саябағы салынып жатқанда да көптеген апаттар болды...》
Dialogue: 0,3:55:44.29,3:55:46.30,Default,,0,0,0,,<Шынайы>
Dialogue: 0,3:55:46.30,3:55:48.46,Default,,0,0,0,,Ха!
Dialogue: 0,3:55:48.46,3:55:51.97,Default,,0,0,0,,《Ешқандай зат болмаса да, мен энергияны сезінемін.
Dialogue: 0,3:55:51.97,3:55:54.97,Default,,0,0,0,,Мынау болса ше!
Dialogue: 0,3:55:54.97,3:55:58.47,Default,,0,0,0,,Поопопопопопиопу бөтен адам сирек кездеседі!?》
Dialogue: 0,3:55:58.47,3:56:00.48,Default,,0,0,0,,Ко Фу
Dialogue: 0,3:56:00.48,3:56:02.48,Default,,0,0,0,,Міне! Ол шықты!
Dialogue: 0,3:56:02.48,3:56:04.48,Default,,0,0,0,,Ко Фу
Dialogue: 0,3:56:04.48,3:56:06.65,Default,,0,0,0,,А, аа! Жүгіріп кету!
Dialogue: 0,3:56:06.65,3:56:10.15,Default,,0,0,0,,Ха ха ха... міне сен, қаза тапқан жауынгер едің.
Dialogue: 0,3:56:10.15,3:56:14.59,Default,,0,0,0,,Міне болды! Өте сирек кездесетін бөтен попиопиопиопиопуп!
Dialogue: 0,3:56:14.59,3:56:17.09,Default,,0,0,0,,Поппиопиопиопиопиопуп бөтен?
Dialogue: 0,3:56:17.09,3:56:19.43,Default,,0,0,0,,Мен мұндай жерде болады деп ешқашан ойламадым.
Dialogue: 0,3:56:19.43,3:56:22.10,Default,,0,0,0,,Поупопопопопиопапиоп Мен шетелдіктер бар екенін білмедім!
Dialogue: 0,3:56:22.10,3:56:25.94,Default,,0,0,0,,Жоқ, мен таң қалдым. иә?
Dialogue: 0,3:56:25.94,3:56:27.94,Default,,0,0,0,,《Рикка: Қуанышты
Dialogue: 0,3:56:27.94,3:56:30.11,Default,,0,0,0,,Көңілім көтеріліп, тым көп сөйледім! 》
Dialogue: 0,3:56:30.11,3:56:32.27,Default,,0,0,0,,Бұл ештеңе емес.
Dialogue: 0,3:56:32.27,3:56:34.97,Default,,0,0,0,,Құлаған жауынгер бөтен планеталық шығар!
Dialogue: 0,3:56:40.62,3:56:42.79,Default,,0,0,0,,Әдемі. О~
Dialogue: 0,3:56:42.79,3:56:46.96,Default,,0,0,0,,Эй Рикка, мен ойын-сауық саябағында бірінші рет болып тұрмын.
Dialogue: 0,3:56:46.96,3:56:50.29,Default,,0,0,0,,Эй... бірінші рет!?
Dialogue: 0,3:56:50.29,3:56:52.80,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,3:56:52.80,3:56:57.13,Default,,0,0,0,,Менімен бірге болғандарыңызға рахмет.
Dialogue: 0,3:56:57.13,3:57:01.97,Default,,0,0,0,,А, иә. Мен көмектесе алатыныма қуаныштымын.
Dialogue: 0,3:57:01.97,3:57:04.97,Default,,0,0,0,,Қараңдар, Цубаса саған қарыздар.
Dialogue: 0,3:57:04.97,3:57:07.31,Default,,0,0,0,,Міне!
Dialogue: 0,3:57:07.31,3:57:09.81,Default,,0,0,0,,Цубаса-чан салқын және сенімді.
Dialogue: 0,3:57:09.81,3:57:13.25,Default,,0,0,0,,Бұл маған көп көмектесті.
Dialogue: 0,3:57:13.25,3:57:16.59,Default,,0,0,0,,《Мен туралы осылай ойладың》
Dialogue: 0,3:57:16.59,3:57:19.26,Default,,0,0,0,,Цубаса да осылай деді.
Dialogue: 0,3:57:19.26,3:57:22.76,Default,,0,0,0,,Рикка еңбекқор, еңбекқор.
Dialogue: 0,3:57:22.76,3:57:25.43,Default,,0,0,0,,Ол достарына шын көңіл бөлетін қыз.
Dialogue: 0,3:57:25.43,3:57:27.43,Default,,0,0,0,,Ах...
Dialogue: 0,3:57:30.43,3:57:33.60,Default,,0,0,0,,Рахмет
Dialogue: 0,3:57:33.60,3:57:35.94,Default,,0,0,0,,《Сыртқы түрі керемет! 》
Dialogue: 0,3:57:35.94,3:57:39.28,Default,,0,0,0,,<Полковник Риккадан әсер алған>
Dialogue: 0,3:57:39.28,3:57:43.61,Default,,0,0,0,,Рикка-чан! Мен өте өкінемін!
Dialogue: 0,3:57:43.61,3:57:47.45,Default,,0,0,0,,Жарайды. Цубасаның інісі Цуёси
Dialogue: 0,3:57:47.45,3:57:50.12,Default,,0,0,0,,Ол менімен ойнады. (Чиё/Секине) Иә?
Dialogue: 0,3:57:50.12,3:57:54.62,Default,,0,0,0,,Аа, менің бір ісім бар еді, Цуйошиден сұрадым.
Dialogue: 0,3:57:54.62,3:57:56.79,Default,,0,0,0,,Жақсы болды ма?
Dialogue: 0,3:57:56.79,3:58:00.30,Default,,0,0,0,,Жамандықтың қолы сүйкімді Рикка-чанға жақындайды...
Dialogue: 0,3:58:00.30,3:58:02.63,Default,,0,0,0,,Құлаған жауынгер жақындап келеді
Dialogue: 0,3:58:02.63,3:58:06.47,Default,,0,0,0,,Құлаған жауынгер!? Цуйоши-кун қандай бала?
Dialogue: 0,3:58:06.47,3:58:08.64,Default,,0,0,0,,Ол өте жақсы қыз.
Dialogue: 0,3:58:08.64,3:58:10.81,Default,,0,0,0,,Бірақ...Не?
Dialogue: 0,3:58:10.81,3:58:17.25,Default,,0,0,0,,Интеллект Динамикалық көру өткірлігі Қозғалыс жүйкелері Күтпеген жағдайлардан қалай күресуге болады...
Dialogue: 0,3:58:17.25,3:58:19.58,Default,,0,0,0,,Олардың барлығы нашар бағалар!
Dialogue: 0,3:58:19.58,3:58:23.59,Default,,0,0,0,,Ақыл мен денені көбірек жаттықтыру керек! Ммм
Dialogue: 0,3:58:23.59,3:58:27.09,Default,,0,0,0,,<Полковниктің кадрлық бағасы қолайлы болмады>
Dialogue: 0,3:58:33.43,3:58:35.43,Default,,0,0,0,,Демалыс – үш күндік мереке.
Dialogue: 0,3:58:35.43,3:58:38.10,Default,,0,0,0,,Мен бір жерге барып ойнағым келеді.
Dialogue: 0,3:58:38.10,3:58:41.27,Default,,0,0,0,,Жаса, менің атамның вилласы
Dialogue: 0,3:58:41.27,3:58:44.61,Default,,0,0,0,,Бәріміз барып түнейміз бе? Вилла?
Dialogue: 0,3:58:44.61,3:58:46.94,Default,,0,0,0,,Сіз сенімдісіз бе? Иә
Dialogue: 0,3:58:46.94,3:58:49.95,Default,,0,0,0,,Атамиде. (Секине және т.б.) Атами!
Dialogue: 0,3:58:49.95,3:58:52.78,Default,,0,0,0,,Нфуфу. Офуро~!
Dialogue: 0,3:58:52.78,3:58:56.62,Default,,0,0,0,,《Барлығы шомылып жатқанда мен не істеуім керек?》
Dialogue: 0,3:58:56.62,3:58:59.29,Default,,0,0,0,,Бұл менің виллаға бірінші рет келуім!
Dialogue: 0,3:58:59.29,3:59:02.79,Default,,0,0,0,,Мен оны асыға күтемін!
Dialogue: 0,3:59:02.79,3:59:07.13,Default,,0,0,0,,Кешіріңіз, мен виллаға бара алмаймын.
Dialogue: 0,3:59:07.13,3:59:10.80,Default,,0,0,0,,Негізі вилланы атам сатты.
Dialogue: 0,3:59:10.80,3:59:12.74,Default,,0,0,0,,Ол көптен бері сатылымда
Dialogue: 0,3:59:12.74,3:59:16.57,Default,,0,0,0,,Мен бұл уақытта сатылады деп ойламадым.
Dialogue: 0,3:59:16.57,3:59:19.74,Default,,0,0,0,,Уайымдамаңыз.
Dialogue: 0,3:59:19.74,3:59:21.74,Default,,0,0,0,,<Саяхат бетбелгі>
Dialogue: 0,3:59:21.74,3:59:23.75,Default,,0,0,0,,Мен оның сатылғанына қуаныштымын.
Dialogue: 0,3:59:23.75,3:59:26.25,Default,,0,0,0,,<Тенугуи
Dialogue: 0,3:59:26.25,3:59:28.25,Default,,0,0,0,,Пампан рюкзактары＞
Dialogue: 0,3:59:28.25,3:59:32.59,Default,,0,0,0,,Кешіріңіз. Вилла емес, санаторий болса...
Dialogue: 0,3:59:32.59,3:59:35.26,Default,,0,0,0,,Не? Мен білетін жер бар
Dialogue: 0,3:59:35.26,3:59:37.93,Default,,0,0,0,,Бір адамға 1500 иен тұрады.
Dialogue: 0,3:59:37.93,3:59:41.60,Default,,0,0,0,,Мен мұны істей аламын! Цифрлар саны үшке көбейсе де, жарайды!
Dialogue: 0,3:59:41.60,3:59:44.60,Default,,0,0,0,,《Жоқ, оны пайдалана алмайсыз.》
Dialogue: 0,3:59:44.60,3:59:46.60,Default,,0,0,0,,Рахмет!
Dialogue: 0,3:59:46.60,3:59:50.80,Default,,0,0,0,,《Жақсы, мен барлығының көңілін қалдырдым》
Dialogue: 0,3:59:53.44,3:59:57.11,Default,,0,0,0,,Атами келу!
Dialogue: 0,3:59:57.11,3:59:59.11,Default,,0,0,0,,Керемет!
Dialogue: 0,3:59:59.11,4:00:02.12,Default,,0,0,0,,Ақыры мен армандаған мекенім Атамиге келдім!
Dialogue: 0,4:00:02.12,4:00:04.45,Default,,0,0,0,,Шығыстағы Монако!
Dialogue: 0,4:00:04.45,4:00:08.29,Default,,0,0,0,,Менімен бірге келе жатқан ересек адам не істеу керектігін айтып жатты.
Dialogue: 0,4:00:08.29,4:00:11.56,Default,,0,0,0,,Көмегің үшін рахмет. Мәселе жоқ
Dialogue: 0,4:00:11.56,4:00:14.06,Default,,0,0,0,,Сүйкімді оқушылармен
Dialogue: 0,4:00:14.06,4:00:17.07,Default,,0,0,0,,Менің әйелім де қош келдіңіз!
Dialogue: 0,4:00:17.07,4:00:19.23,Default,,0,0,0,,Иә? Ал сіздің әйеліңіз ше?
Dialogue: 0,4:00:19.23,4:00:23.57,Default,,0,0,0,,Әйелім таңертең ерте, сондықтан ол қазірдің өзінде көрікті жерлерді аралап жүр.
Dialogue: 0,4:00:23.57,4:00:26.91,Default,,0,0,0,,Біз қонақ үйде кездесеміз.
Dialogue: 0,4:00:26.91,4:00:30.41,Default,,0,0,0,,Кеттік!
Dialogue: 0,4:00:30.41,4:00:33.25,Default,,0,0,0,,Бұл санаторий~
Dialogue: 0,4:00:33.25,4:00:35.58,Default,,0,0,0,,《Секине: Бұл ұйымның шегінуі》
Dialogue: 0,4:00:35.58,4:00:38.42,Default,,0,0,0,,<Әлеуметтік жәрдемақылар берік>
Dialogue: 0,4:00:38.42,4:00:43.93,Default,,0,0,0,,Кешіріңіз. Мен Секинеге тапсырыс бердім.
Dialogue: 0,4:00:43.93,4:00:47.26,Default,,0,0,0,,Бала ұл, солай ма? иә?
Dialogue: 0,4:00:47.26,4:00:51.27,Default,,0,0,0,,Мен сіздің шаш үлгісіңізді көріп тұрмын. иә?
Dialogue: 0,4:00:51.27,4:00:54.27,Default,,0,0,0,,Сіз сондай ер мінезді көрінесіз бе?
Dialogue: 0,4:00:54.27,4:00:56.77,Default,,0,0,0,,Жоқ, уф.
Dialogue: 0,4:00:56.77,4:00:59.27,Default,,0,0,0,,《Мен түсіндім деп ойлаймын.
Dialogue: 0,4:00:59.27,4:01:01.28,Default,,0,0,0,,Екеуі де еркек》
Dialogue: 0,4:01:01.28,4:01:05.78,Default,,0,0,0,,Жоқ, жоқ, бұл қыз нағыз қыз!
Dialogue: 0,4:01:05.78,4:01:09.12,Default,,0,0,0,,Гусса! Мен қыздар арасындағы қызбын!
Dialogue: 0,4:01:09.12,4:01:11.39,Default,,0,0,0,,Гусса! сондай сүйкімді қыз
Dialogue: 0,4:01:11.39,4:01:14.22,Default,,0,0,0,,Ол жоқ! Гусса!
Dialogue: 0,4:01:14.22,4:01:16.73,Default,,0,0,0,,Шынын айтсам, мен әлі де «Арнайы сынып» дегеннің не екенін түсінбеймін.
Dialogue: 0,4:01:16.73,4:01:20.06,Default,,0,0,0,,Резервке сәйкес 4 әйел...
Dialogue: 0,4:01:20.06,4:01:22.06,Default,,0,0,0,,Студенттік билетіңіз ше?
Dialogue: 0,4:01:22.06,4:01:25.23,Default,,0,0,0,,Менде қазір жоқ.
Dialogue: 0,4:01:25.23,4:01:28.90,Default,,0,0,0,,Әлеуметтік жәрдемақы жұмысшылардың құқығы, солай ма?
Dialogue: 0,4:01:28.90,4:01:31.91,Default,,0,0,0,,《Кочитора 14 жылдан бері ұйымда тұрады!
Dialogue: 0,4:01:31.91,4:01:34.74,Default,,0,0,0,,Ыстық бұлақтарға барсын! 》
Dialogue: 0,4:01:34.74,4:01:36.91,Default,,0,0,0,,Секине мырза!?
Dialogue: 0,4:01:36.91,4:01:40.75,Default,,0,0,0,,Дұрыс! Мұғалім...
Dialogue: 0,4:01:40.75,4:01:42.75,Default,,0,0,0,,Керемет!
Dialogue: 0,4:01:42.75,4:01:45.25,Default,,0,0,0,,<Оқушылардан көкеші қуыршақтары>
Dialogue: 0,4:01:45.25,4:01:50.26,Default,,0,0,0,,Бүгін маған көрсете алатын іш киім осы ма? <Сандықтар>
Dialogue: 0,4:01:50.26,4:01:52.26,Default,,0,0,0,,Күтілгендей...
Dialogue: 0,4:01:52.26,4:01:54.76,Default,,0,0,0,,Ку Гугу Гууу...
Dialogue: 0,4:01:54.76,4:01:57.60,Default,,0,0,0,,Кешіріңіз! Негізі бұл менмін
Dialogue: 0,4:01:57.60,4:02:01.50,Default,,0,0,0,,Бұл Цубаса емес, оның егіз інісі Цюёси!
Dialogue: 0,4:02:06.28,4:02:08.44,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,4:02:08.44,4:02:10.61,Default,,0,0,0,,Бұл Цюоши-кун болды ма?
Dialogue: 0,4:02:10.61,4:02:15.22,Default,,0,0,0,,Ум, Цуйоши мырза, сіздің нағыз қанаттарыңыз қазір қайда?
Dialogue: 0,4:02:15.22,4:02:17.22,Default,,0,0,0,,Сіз оны қалағаныңызша атай аласыз.
Dialogue: 0,4:02:17.22,4:02:20.89,Default,,0,0,0,,Менің әпкем сол кумирдің концертіне барады.
Dialogue: 0,4:02:20.89,4:02:24.39,Default,,0,0,0,,Иә? Сізге айдолдар ұнайды ма? Мен оны бірінші рет естідім
Dialogue: 0,4:02:24.39,4:02:27.40,Default,,0,0,0,,Сіз кенеттен билеттер алдыңыз ба?
Dialogue: 0,4:02:27.40,4:02:30.57,Default,,0,0,0,,Мен өзімді алмастырушы ретінде қызмет етуге мәжбүрлеудің қажеті жоқ.
Dialogue: 0,4:02:30.57,4:02:32.73,Default,,0,0,0,,Д-Дұрыс, сен дұрыс айтасың.
Dialogue: 0,4:02:32.73,4:02:35.90,Default,,0,0,0,,Ол қорқынышты адам. Ол мазасыз.
Dialogue: 0,4:02:35.90,4:02:37.91,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,4:02:37.91,4:02:41.24,Default,,0,0,0,,Цубаса-санның кенеттен бас тартуы үлкен мәселе.
Dialogue: 0,4:02:41.24,4:02:43.25,Default,,0,0,0,,(Панда) Ол екі мектептің аралығындағы бір жерде босап шыққан болар, деп ойлаймын—
Dialogue: 0,4:02:43.25,4:02:45.75,Default,,0,0,0,,《Иә? Барлығың ашулы емессіңдер ме? 》
Dialogue: 0,4:02:45.75,4:02:48.25,Default,,0,0,0,,Менің таңдауым жоқ. Үйге барайын ба?
Dialogue: 0,4:02:48.25,4:02:50.75,Default,,0,0,0,,А-а, жоқ, егер үшеуміз қонақ үйде тұрсақ...
Dialogue: 0,4:02:50.75,4:02:53.26,Default,,0,0,0,,Бұл опция емес.
Dialogue: 0,4:02:53.26,4:02:56.93,Default,,0,0,0,,Иә, мен Цубаса-санның жоқтығына қынжыламын.
Dialogue: 0,4:02:56.93,4:02:59.60,Default,,0,0,0,,Иә, иә, төрт адам жақсы!
Dialogue: 0,4:02:59.60,4:03:01.76,Default,,0,0,0,,Күтуден шаршадым!
Dialogue: 0,4:03:01.76,4:03:05.60,Default,,0,0,0,,Сонымен, сіз Атамидің көрікті жерлерін аралап, сосын кері қайтқыңыз келе ме?
Dialogue: 0,4:03:05.60,4:03:08.60,Default,,0,0,0,,Дұрыс!
Dialogue: 0,4:03:08.60,4:03:12.04,Default,,0,0,0,,Онда мен осында боламын...
Dialogue: 0,4:03:12.04,4:03:15.71,Default,,0,0,0,,Цюоши-кун, біз де бірге айналып шығайық. иә?
Dialogue: 0,4:03:15.71,4:03:19.38,Default,,0,0,0,,《Балам, мен саған сол күні қарызмын...》
Dialogue: 0,4:03:19.38,4:03:25.22,Default,,0,0,0,,Маған жақсы болса, менімен бірге айналайын ба?
Dialogue: 0,4:03:25.22,4:03:27.89,Default,,0,0,0,,《Ұмытатын мен емес》
Dialogue: 0,4:03:27.89,4:03:30.89,Default,,0,0,0,,<Полковник Рикканың жақсылығын қайтаруы>
Dialogue: 0,4:03:43.41,4:03:48.74,Default,,0,0,0,,Бұл сөзсіз сүйкімдірек.
Dialogue: 0,4:03:48.74,4:03:52.75,Default,,0,0,0,,《Жоқ! Мен енді ғана сенімен әдеттегідей араластым.
Dialogue: 0,4:03:52.75,4:03:56.08,Default,,0,0,0,,Сонымен, мен мұны таңдауым керек пе?
Dialogue: 0,4:03:56.08,4:03:58.75,Default,,0,0,0,,《Ал, Секине жақсы ма?
Dialogue: 0,4:03:58.75,4:04:01.76,Default,,0,0,0,,Менің ойымша, олар бұл туралы ойламайды.
Dialogue: 0,4:04:01.76,4:04:03.76,Default,,0,0,0,,《Чара...》
Dialogue: 0,4:04:03.76,4:04:05.76,Default,,0,0,0,,Чио-сан, мынаны қара.
Dialogue: 0,4:04:05.76,4:04:07.76,Default,,0,0,0,,Жақсы, сүйкімді!
Dialogue: 0,4:04:07.76,4:04:11.27,Default,,0,0,0,,《Чиё-сан оның ұлдарға жақсы емес екенін айтты.
Dialogue: 0,4:04:11.27,4:04:14.87,Default,,0,0,0,,Сіз маған қалыпты түрде қарайсыз. қуаныштымын》
Dialogue: 0,4:04:14.87,4:04:17.21,Default,,0,0,0,,《Жақын қалды!
Dialogue: 0,4:04:17.21,4:04:21.38,Default,,0,0,0,,Маған сәттілік! Бейбіт және тыныш ...
Dialogue: 0,4:04:21.38,4:04:23.38,Default,,0,0,0,,Өлтіру командасы! 》
Dialogue: 0,4:04:23.38,4:04:26.21,Default,,0,0,0,,<Өлтіру пәрмені дегеніміз не? Тірі заттар, әсіресе
Dialogue: 0,4:04:26.21,4:04:29.72,Default,,0,0,0,,Адамдарды өлтіруге тыйым салатын өсиет>
Dialogue: 0,4:04:29.72,4:04:32.05,Default,,0,0,0,,Чио-сан, жақсысың ба?
Dialogue: 0,4:04:32.05,4:04:34.06,Default,,0,0,0,,Танысымды айтайын ба?
Dialogue: 0,4:04:34.06,4:04:37.56,Default,,0,0,0,,Иә, бұл сөзсіз өлтіру өсиеті.
Dialogue: 0,4:04:37.56,4:04:39.56,Default,,0,0,0,,《Чиё: Өйткені бұл адам
Dialogue: 0,4:04:39.56,4:04:42.96,Default,,0,0,0,,Цубаса-санның асыл отбасы》
Dialogue: 0,4:04:44.90,4:04:49.40,Default,,0,0,0,,Десе де, Цубасадан алған әсерім басқаша.
Dialogue: 0,4:04:49.40,4:04:52.41,Default,,0,0,0,,Не? Цубаса не деді?
Dialogue: 0,4:04:52.41,4:04:54.74,Default,,0,0,0,,Танымал емес немесе шағын ойлы
Dialogue: 0,4:04:54.74,4:04:56.75,Default,,0,0,0,,Мен осылай дедім. иә?
Dialogue: 0,4:04:56.75,4:04:59.25,Default,,0,0,0,,《Мен туралы бәріне жаман сөз айтасың ба? 》
Dialogue: 0,4:05:01.42,4:05:05.75,Default,,0,0,0,,Тіпті ол мені түн ортасында балмұздақ сатып алуға мәжбүрлейді.
Dialogue: 0,4:05:05.75,4:05:08.26,Default,,0,0,0,,Мен таңертең жуынатын бөлмеде боламын.
Dialogue: 0,4:05:08.26,4:05:10.76,Default,,0,0,0,,Мен тек спаржа өскіндерін жеймін.
Dialogue: 0,4:05:10.76,4:05:12.93,Default,,0,0,0,,Адам ретінде...
Dialogue: 0,4:05:12.93,4:05:18.77,Default,,0,0,0,,Өтінемін, Цубаса-санға олай айтпа!
Dialogue: 0,4:05:18.77,4:05:22.27,Default,,0,0,0,,Ниндзя жаттығуларына бар күшіңізді салу
Dialogue: 0,4:05:22.27,4:05:26.94,Default,,0,0,0,,Ол менің туған күніме бетперде киген саптыаяқ сыйлады.
Dialogue: 0,4:05:26.94,4:05:30.78,Default,,0,0,0,,Қызға тән мейірімділікке толы!
Dialogue: 0,4:05:30.78,4:05:32.95,Default,,0,0,0,,《Қыз сияқты...》
Dialogue: 0,4:05:32.95,4:05:35.78,Default,,0,0,0,,Иә.
Dialogue: 0,4:05:35.78,4:05:40.12,Default,,0,0,0,,Сіз такояки гриль жасауды жақсы білесіз.
Dialogue: 0,4:05:40.12,4:05:44.79,Default,,0,0,0,,Сондай-ақ, әм, ә... Мен оның әйелдік қасиеті жоғары дер едім.
Dialogue: 0,4:05:44.79,4:05:46.96,Default,,0,0,0,,《Әйелдік күш…》
Dialogue: 0,4:05:46.96,4:05:49.30,Default,,0,0,0,,Дұрыс. Танабата кезінде
Dialogue: 0,4:05:49.30,4:05:51.97,Default,,0,0,0,,Сіз тіпті Риккаға тілек айттыңыз.
Dialogue: 0,4:05:51.97,4:05:53.97,Default,,0,0,0,,Бұл сүйкімді болды~
Dialogue: 0,4:05:53.97,4:05:55.97,Default,,0,0,0,,《Сүйкімді…》
Dialogue: 0,4:05:55.97,4:05:59.98,Default,,0,0,0,,Цубасаны бәрі жақсы көреді!
Dialogue: 0,4:05:59.98,4:06:02.98,Default,,0,0,0,,《Цуйоши: Мен бақыттымын, бірақ...》
Dialogue: 0,4:06:02.98,4:06:05.31,Default,,0,0,0,,<Ірі зиян>
Dialogue: 0,4:06:05.31,4:06:09.32,Default,,0,0,0,,Сәлем бәріңе! Мен сені күттім!
Dialogue: 0,4:06:09.32,4:06:11.32,Default,,0,0,0,,Мұғалім Брайан!
Dialogue: 0,4:06:11.32,4:06:15.42,Default,,0,0,0,,Қонақ үйдегі жағдайды сұрадым. Бейшара жігіт.
Dialogue: 0,4:06:15.42,4:06:17.76,Default,,0,0,0,,Иә, бұл кәдесый.
Dialogue: 0,4:06:17.76,4:06:19.93,Default,,0,0,0,,Рахмет!
Dialogue: 0,4:06:19.93,4:06:21.93,Default,,0,0,0,,Сіздің отбасыңыз ше?
Dialogue: 0,4:06:21.93,4:06:27.27,Default,,0,0,0,,Мәселе жоқ. Әйелім бүгін жалғыз қалатын сияқты.
Dialogue: 0,4:06:27.27,4:06:33.11,Default,,0,0,0,,Мен мұғаліммін. Барлығыңызды үйге жеткізу менің міндетім.
Dialogue: 0,4:06:33.11,4:06:35.61,Default,,0,0,0,,Токиоға оралу!
Dialogue: 0,4:06:35.61,4:06:39.28,Default,,0,0,0,,<Мұғалімнің де жауапкершілігі. ＞
Dialogue: 0,4:06:39.28,4:06:41.95,Default,,0,0,0,,Цубаса-чан, саған қайсысы ұнайды?
Dialogue: 0,4:06:41.95,4:06:45.12,Default,,0,0,0,,Мүмкін бұл. (Секине) Мүмкін бұл.
Dialogue: 0,4:06:45.12,4:06:47.46,Default,,0,0,0,,Бұл туралы не деуге болады? Міне бітті!
Dialogue: 0,4:06:47.46,4:06:49.79,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,4:06:49.79,4:06:53.96,Default,,0,0,0,,《Мен осындамын.
Dialogue: 0,4:06:53.96,4:06:57.46,Default,,0,0,0,,Оны осылай қалдыру дұрыс па? 》
Dialogue: 0,4:10:18.43,4:10:22.27,Default,,0,0,0,,Рикка-чан Жерде қанша уақыт қалады?
Dialogue: 0,4:10:22.27,4:10:24.47,Default,,0,0,0,,Иә?
Dialogue: 0,4:12:11.41,4:12:14.08,Default,,0,0,0,,Бұл...
Dialogue: 0,4:12:14.08,4:12:17.08,Default,,0,0,0,,Жақын жерде ғарыш кемесі бар ма?
Dialogue: 0,4:12:28.93,4:12:30.93,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,4:12:33.27,4:12:35.27,Default,,0,0,0,,Бұл Галактикалық революциялық альянс.
Dialogue: 0,4:12:35.27,4:12:38.61,Default,,0,0,0,,1098-ші батальон полковнигі Папипополо Дурликка.
Dialogue: 0,4:12:38.61,4:12:42.81,Default,,0,0,0,,Мен қазір күн жүйесіндегі үшінші планетадамын. Жауап күтемін!
Dialogue: 0,4:12:47.95,4:12:49.95,Default,,0,0,0,,《Барлық функциялар толығымен тоқтатылады.
Dialogue: 0,4:12:49.95,4:12:52.95,Default,,0,0,0,,Максималды шығу кезінде құтқару сигналын жіберуден басқа амал жоқ па?
Dialogue: 0,4:12:52.95,4:12:57.25,Default,,0,0,0,,Бірақ ол үшін біз әркімнің миын жууды жоюымыз керек! 》
Dialogue: 0,4:13:00.13,4:13:02.46,Default,,0,0,0,,Жақында жоғарылау емтиханы келеді.
Dialogue: 0,4:13:02.46,4:13:06.13,Default,,0,0,0,,Дұрыс. Жарайды, Секине оңай өтеді.
Dialogue: 0,4:13:06.13,4:13:08.97,Default,,0,0,0,,Қанаттарда орын жеткіліксіз бе?
Dialogue: 0,4:13:08.97,4:13:11.74,Default,,0,0,0,,Ха, мен ұйықтамаймын.
Dialogue: 0,4:13:11.74,4:13:13.74,Default,,0,0,0,,《Жақсы》
Dialogue: 0,4:13:13.74,4:13:15.91,Default,,0,0,0,,《Чиё-сан, сен емтиханға қатты дайындалып жатырсың.》
Dialogue: 0,4:13:15.91,4:13:19.08,Default,,0,0,0,,Негізі мен соңғы кездері кесте тігуге әуестеніп кеттім.
Dialogue: 0,4:13:19.08,4:13:22.42,Default,,0,0,0,,Оқу, Чио-сан! Бұл шынымен жаман болады!
Dialogue: 0,4:13:22.42,4:13:26.09,Default,,0,0,0,,Жарайды, Чио-сан. Рика сенде!
Dialogue: 0,4:13:26.09,4:13:28.09,Default,,0,0,0,,Рикка-чанға рахмет!
Dialogue: 0,4:13:28.09,4:13:30.59,Default,,0,0,0,,《Не болды? 》
Dialogue: 0,4:13:30.59,4:13:33.09,Default,,0,0,0,,Иә. Барлығымыз бірге зерттеу сабағын өткізуіміз керек.
Dialogue: 0,4:13:33.09,4:13:35.10,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,4:13:35.10,4:13:38.43,Default,,0,0,0,,Иә, дұрыс. Барымызды салайық, Чио-сан!
Dialogue: 0,4:13:38.43,4:13:42.10,Default,,0,0,0,,Бар күшімізді салып, бірге алға басайық! Мен түссіндім!
Dialogue: 0,4:13:42.10,4:13:44.11,Default,,0,0,0,,<Жауап беру жақсы>
Dialogue: 0,4:13:44.11,4:13:47.28,Default,,0,0,0,,Жарайды! Сіз міндетті түрде өтесіз!
Dialogue: 0,4:13:47.28,4:13:50.95,Default,,0,0,0,,Ей Эй О!
Dialogue: 0,4:13:50.95,4:13:52.95,Default,,0,0,0,,Олай болса, 7-қадам!
Dialogue: 0,4:13:52.95,4:13:57.29,Default,,0,0,0,,Иә! Шичи Ичига Шичи Шичи Ниджууши Шичи-сан…
Dialogue: 0,4:13:57.29,4:13:59.29,Default,,0,0,0,,Неге ол бізді өзінен алыстатқысы келеді?
Dialogue: 0,4:13:59.29,4:14:03.12,Default,,0,0,0,,Ура Чио-сан! Ура Чио-сан!
Dialogue: 0,4:14:03.12,4:14:05.46,Default,,0,0,0,,《Мен тым кеш сияқтымын》
Dialogue: 0,4:14:05.46,4:14:09.80,Default,,0,0,0,,Бұл Шичи-сан Нижуичи болды ма?
Dialogue: 0,4:14:09.80,4:14:12.40,Default,,0,0,0,,Дұрыс, солай!
Dialogue: 0,4:14:12.40,4:14:14.40,Default,,0,0,0,,Ммммммм
Dialogue: 0,4:14:14.40,4:14:17.24,Default,,0,0,0,,Амансың ба? Иә
Dialogue: 0,4:14:17.24,4:14:21.58,Default,,0,0,0,,Қазірдің өзінде бас тартқан дұрыс... Жоқ, мен ешқашан берілмеймін.
Dialogue: 0,4:14:21.58,4:14:24.08,Default,,0,0,0,,Қалған уақытта
Dialogue: 0,4:14:24.08,4:14:26.58,Default,,0,0,0,,Мен қолымнан келгеннің бәрін істегім келеді.
Dialogue: 0,4:14:26.58,4:14:28.58,Default,,0,0,0,,Иә?
Dialogue: 0,4:14:28.58,4:14:30.59,Default,,0,0,0,,Енді тағы да!
Dialogue: 0,4:14:30.59,4:14:33.09,Default,,0,0,0,,Иә! Шичичигашичи Шичинижууши
Dialogue: 0,4:14:33.09,4:14:36.93,Default,,0,0,0,,Шичи-сан нижуичи Шичиши… Шичиши…
Dialogue: 0,4:14:36.93,4:14:39.93,Default,,0,0,0,,Фюр Фюр Чио-сан!
Dialogue: 0,4:14:39.93,4:14:43.60,Default,,0,0,0,,《Дұрыс. Уақыт жоқ.》
Dialogue: 0,4:14:43.60,4:14:46.43,Default,,0,0,0,,Цуйоши: Ммммм~
Dialogue: 0,4:14:46.43,4:14:50.27,Default,,0,0,0,,Иә? Ах~ Ах~ Ах~...
Dialogue: 0,4:14:50.27,4:14:53.44,Default,,0,0,0,,Цуйоши: Даусыңыз біртүрлі емес пе?
Dialogue: 0,4:14:53.44,4:14:55.44,Default,,0,0,0,,Сіз шынымен солай ойлайсыз ба?
Dialogue: 0,4:14:55.44,4:14:58.95,Default,,0,0,0,,Егер суық тиіп қалса, оны таратпа. Бұл суық емес.
Dialogue: 0,4:14:58.95,4:15:02.28,Default,,0,0,0,,Сонымен не? Ащы тағамды көп жедіңіз бе?
Dialogue: 0,4:15:02.28,4:15:06.96,Default,,0,0,0,,Жоқ Бұл дауыстың өзгеруі.
Dialogue: 0,4:15:06.96,4:15:11.56,Default,,0,0,0,,《Даусым мүлде өзгергенде, басқалардан еш айырмашылығым болмады...》
Dialogue: 0,4:15:11.56,4:15:16.40,Default,,0,0,0,,Шичиха Годзюроку Шичикурокуджу…
Dialogue: 0,4:15:16.40,4:15:18.40,Default,,0,0,0,,! Міне бітті!
Dialogue: 0,4:15:18.40,4:15:21.40,Default,,0,0,0,,Бұл керемет. Бұл керемет. (Қанат) Иә, келесі қадам 8!
Dialogue: 0,4:15:21.40,4:15:24.41,Default,,0,0,0,,Ум, Хачиитигахачи
Dialogue: 0,4:15:24.41,4:15:28.41,Default,,0,0,0,,《Олардың болашақ үшін күресіп жатқанын көру керемет.
Dialogue: 0,4:15:28.41,4:15:31.58,Default,,0,0,0,,Дос ретінде мен де саған көмектесуім керек.
Dialogue: 0,4:15:31.58,4:15:33.58,Default,,0,0,0,,Иә?
Dialogue: 0,4:15:33.58,4:15:37.28,Default,,0,0,0,,《Чио-санның IQ деңгейін сәл көтеруім керек пе?》
Dialogue: 0,4:15:44.26,4:15:46.76,Default,,0,0,0,,Чио-сан, не болды?
Dialogue: 0,4:15:50.26,4:15:52.77,Default,,0,0,0,,Мен оны дерлік түсіндім.
Dialogue: 0,4:15:52.77,4:15:54.94,Default,,0,0,0,,Енді не!? Иә.
Dialogue: 0,4:15:54.94,4:15:57.61,Default,,0,0,0,,Негіздерді түсінгеннен кейін, қалғаны қолданба болып табылады
Dialogue: 0,4:15:57.61,4:15:59.94,Default,,0,0,0,,Мен бұны ешқашан күтпеген едім...
Dialogue: 0,4:15:59.94,4:16:03.44,Default,,0,0,0,,Олай болса, 99 есе 99 нешеге тең?
Dialogue: 0,4:16:03.44,4:16:05.45,Default,,0,0,0,,9, 801.
Dialogue: 0,4:16:05.45,4:16:07.45,Default,,0,0,0,,<Тез жауап>
Dialogue: 0,4:16:07.45,4:16:10.79,Default,,0,0,0,,Қараңыз, мәселе 100 бағанды және 100 бағанды қосатын торды қабылдау болып табылады.
Dialogue: 0,4:16:10.79,4:16:12.89,Default,,0,0,0,,Әрбір соңғы баған өшірілді делік
Dialogue: 0,4:16:12.89,4:16:15.22,Default,,0,0,0,,Бұл жағдайда қабаттасатын шаршыларды қоссаңыз,
Dialogue: 0,4:16:15.22,4:16:17.73,Default,,0,0,0,,Сіз оны әп-сәтте шеше аласыз, солай ма?
Dialogue: 0,4:16:17.73,4:16:21.56,Default,,0,0,0,,Ах, а... а
Dialogue: 0,4:16:21.56,4:16:24.90,Default,,0,0,0,,《Полковниктің допингінің арқасында Чиё жоғары көтерілді.
Dialogue: 0,4:16:24.90,4:16:27.24,Default,,0,0,0,,Жақсы сияқты》 (Цубаса) Уф!
Dialogue: 0,4:16:27.24,4:16:31.07,Default,,0,0,0,,Неліктен оқу сабағын тоқтатып, оның орнына ұйықтауға болмайды?
Dialogue: 0,4:16:31.07,4:16:33.07,Default,,0,0,0,,Кино немесе бір нәрсе көрейік.
Dialogue: 0,4:16:33.07,4:16:35.74,Default,,0,0,0,,Бұл тамаша ұсыныс!
Dialogue: 0,4:16:35.74,4:16:39.25,Default,,0,0,0,,Егер мұндай жағдай орын алса, менде пижамалар дайын.
Dialogue: 0,4:16:39.25,4:16:42.08,Default,,0,0,0,,Жоқ, мен жай ғана түнеймін...
Dialogue: 0,4:16:42.08,4:16:44.09,Default,,0,0,0,,Не? Бұл қандай өрнек!?
Dialogue: 0,4:16:44.09,4:16:47.42,Default,,0,0,0,,Олай болса, шешілді. (Цубаса) Ағын енді шешілді!?
Dialogue: 0,4:16:47.42,4:16:49.76,Default,,0,0,0,,Кәмпит сатып алуға барамыз ба?
Dialogue: 0,4:16:49.76,4:16:52.26,Default,,0,0,0,,Адамдардың айтқанын тыңдап тұрсың ба!? Керемет, мұны істейік.
Dialogue: 0,4:16:52.26,4:16:54.76,Default,,0,0,0,,Дәріханада шырын т.б. арзанырақ.
Dialogue: 0,4:16:54.76,4:16:57.77,Default,,0,0,0,,Екі топқа бөлінейік. (Чиё және т.б.) Иә.
Dialogue: 0,4:16:57.77,4:17:03.44,Default,,0,0,0,,Секине шоколад деді, солай ма? - деді Рикка.
Dialogue: 0,4:17:03.44,4:17:06.44,Default,,0,0,0,,Ммм... Тамақтың кәмпитін алайық.
Dialogue: 0,4:17:06.44,4:17:08.78,Default,,0,0,0,,Тамақтың кәмпиттері тамақты басады.
Dialogue: 0,4:17:08.78,4:17:12.21,Default,,0,0,0,,Бұл ауырсынуды және жөтелді басатын белсенді ингредиент.
Dialogue: 0,4:17:12.21,4:17:15.38,Default,,0,0,0,,Цубаса-санның тамағындағы кәмпитті жұтып қойса да тамағы ауырмайды.
Dialogue: 0,4:17:15.38,4:17:18.55,Default,,0,0,0,,Емдемейді деп ойлаймын. иә?
Dialogue: 0,4:17:18.55,4:17:22.45,Default,,0,0,0,,А... жоқ, бұл ештеңе емес.
Dialogue: 0,4:17:29.06,4:17:33.76,Default,,0,0,0,,《Мүмкін Чиё-сан дауыстың өзгергенін білетін шығар? 》
Dialogue: 0,4:17:37.91,4:17:39.91,Default,,0,0,0,,Ум...
Dialogue: 0,4:17:44.41,4:17:47.42,Default,,0,0,0,,Ах, у...
Dialogue: 0,4:17:47.42,4:17:50.08,Default,,0,0,0,,Цубаса-сан жалғыз емес.
Dialogue: 0,4:17:50.08,4:17:52.75,Default,,0,0,0,,Иә?
Dialogue: 0,4:17:52.75,4:17:56.59,Default,,0,0,0,,Екеуің~!
Dialogue: 0,4:17:56.59,4:17:58.76,Default,,0,0,0,,Мен көп нәрсені сатып алдым.
Dialogue: 0,4:17:58.76,4:18:02.10,Default,,0,0,0,,Қарашы, қарашы, Чио-сан!
Dialogue: 0,4:18:02.10,4:18:06.77,Default,,0,0,0,,Мен өзімді жақсы сезінбеймін. Не болды?
Dialogue: 0,4:18:06.77,4:18:08.77,Default,,0,0,0,,Жоқ, ой...
Dialogue: 0,4:18:08.77,4:18:10.77,Default,,0,0,0,,Иә?
Dialogue: 0,4:18:18.38,4:18:21.88,Default,,0,0,0,,Рикка-чан Жерде қанша уақыт болады?
Dialogue: 0,4:18:21.88,4:18:24.55,Default,,0,0,0,,Иә? Осы уақытқа дейін болған көптеген нәрселер
Dialogue: 0,4:18:24.55,4:18:27.05,Default,,0,0,0,,Жұмбақ құбылыстарды қалай түсіндіреміз
Dialogue: 0,4:18:27.05,4:18:30.06,Default,,0,0,0,,Технологиялық жүйесі Жерден өзгеше болмыс.
Dialogue: 0,4:18:30.06,4:18:32.23,Default,,0,0,0,,Біз тек болжауға болады
Dialogue: 0,4:18:32.23,4:18:38.40,Default,,0,0,0,,Рикка-чан... ол бөтен планеталық па?
Dialogue: 0,4:18:38.40,4:18:40.74,Default,,0,0,0,,Неге екені белгісіз, Рикка-чан
Dialogue: 0,4:18:40.74,4:18:43.74,Default,,0,0,0,,Мен жақында жұлдыздарға оралуым керек.
Dialogue: 0,4:18:43.74,4:18:46.74,Default,,0,0,0,,Менің үйге барғым келмейді. Үйге барғың келмей ме?
Dialogue: 0,4:18:46.74,4:18:49.91,Default,,0,0,0,,Бірақ егер солай болса, онда біз
Dialogue: 0,4:18:49.91,4:18:53.08,Default,,0,0,0,,Осылай қанша уақыт бірге боламыз деп ойлаймын.
Dialogue: 0,4:18:53.08,4:18:55.75,Default,,0,0,0,,Шынын айтсам, мен әлі де «Арнайы сынып» дегеннің не екенін түсінбеймін.
Dialogue: 0,4:18:55.75,4:18:58.25,Default,,0,0,0,,Ал...
Dialogue: 0,4:18:58.25,4:19:03.45,Default,,0,0,0,,Секине мырза бәрін біледі, солай ма?
Dialogue: 0,4:19:07.60,4:19:10.50,Default,,0,0,0,,Ит!? Әрине, мүмкін емес—осы ит!?
Dialogue: 0,4:19:13.53,4:19:18.71,Default,,0,0,0,,Сіз нені меңзеп тұрғаныңызға таң қалдым! Не деген ~ хахаха...
Dialogue: 0,4:19:18.71,4:19:21.88,Default,,0,0,0,,Чио-сан
Dialogue: 0,4:19:21.88,4:19:24.21,Default,,0,0,0,,Уау!
Dialogue: 0,4:19:24.21,4:19:26.38,Default,,0,0,0,,О, ә?
Dialogue: 0,4:19:26.38,4:19:30.55,Default,,0,0,0,,Не... туралы айтып тұрсыз ба?
Dialogue: 0,4:19:30.55,4:19:34.72,Default,,0,0,0,,Үйге кететін уақыт келді.
Dialogue: 0,4:19:34.72,4:19:36.72,Default,,0,0,0,,Солай болды ма?
Dialogue: 0,4:19:36.72,4:19:39.73,Default,,0,0,0,,Менің есте сақтау қабілетім бұлыңғыр.
Dialogue: 0,4:19:39.73,4:19:41.93,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,4:19:55.08,4:19:59.08,Default,,0,0,0,,Әй, екеуіңе не болды?
Dialogue: 0,4:19:59.08,4:20:01.25,Default,,0,0,0,,Ештеңе. Ештеңе етпейді.
Dialogue: 0,4:20:01.25,4:20:03.25,Default,,0,0,0,,《Секине: Ең жаман ауа
Dialogue: 0,4:20:03.25,4:20:07.42,Default,,0,0,0,,Чио-сан, оның IQ-ы күрт көтерілгеннен кейін не болғанын есіне түсірмейтін сияқты.
Dialogue: 0,4:20:07.42,4:20:11.26,Default,,0,0,0,,Жеке тұлғаңыздың ашылуына алаңдаудың қажеті жоқ деп ойлаймын...
Dialogue: 0,4:20:11.26,4:20:13.43,Default,,0,0,0,,Қанаттарға не болды деймін? 》
Dialogue: 0,4:20:13.43,4:20:16.76,Default,,0,0,0,,《Мм. Мен ақыры шешім қабылдадым.
Dialogue: 0,4:20:16.76,4:20:19.77,Default,,0,0,0,,Мазасызданудың қажеті жоқ! 》
Dialogue: 0,4:20:19.77,4:20:24.27,Default,,0,0,0,,Бәріңе сәлем! Кино көрейік. Иә, мұны істейік!
Dialogue: 0,4:20:24.27,4:20:26.77,Default,,0,0,0,,Ал, бейнемагнитофонды шығарайық.
Dialogue: 0,4:20:26.77,4:20:28.78,Default,,0,0,0,,Б-бірақ… енді Хигучи Кира екенін білгеннен кейін,
Dialogue: 0,4:20:28.78,4:20:30.78,Default,,0,0,0,,<Мен бұл туралы ешқашан естімеппін>
Dialogue: 0,4:20:30.78,4:20:33.28,Default,,0,0,0,,Blu-ray немесе DVD туралы не деуге болады?
Dialogue: 0,4:20:33.28,4:20:36.28,Default,,0,0,0,,Сондықтан тек VHS қол жетімді.
Dialogue: 0,4:20:36.28,4:20:39.12,Default,,0,0,0,,VHS? Оның бейнемагнитофоннан айырмашылығы бар ма?
Dialogue: 0,4:20:39.12,4:20:41.82,Default,,0,0,0,,Аа, сол жерден...
Dialogue: 0,4:20:48.96,4:20:51.80,Default,,0,0,0,,《Ха, енді не істеуім керек?
Dialogue: 0,4:20:51.80,4:20:54.97,Default,,0,0,0,,Мен бәріне айтуым керек пе? 》
Dialogue: 0,4:20:54.97,4:20:58.14,Default,,0,0,0,,Чио: Цубаса-сан жалғыз емес.
Dialogue: 0,4:20:58.14,4:21:00.64,Default,,0,0,0,,《Бұл нені білдіреді?》
Dialogue: 0,4:21:00.64,4:21:03.64,Default,,0,0,0,,Иә? Мен ояндым
Dialogue: 0,4:21:03.64,4:21:06.48,Default,,0,0,0,,Цубаса-сан, сен де ұйықтай алмайсың ба?
Dialogue: 0,4:21:06.48,4:21:09.58,Default,,0,0,0,,А, иә. Біраз ғана.
Dialogue: 0,4:21:12.42,4:21:14.42,Default,,0,0,0,,Сәлем Чио-сан
Dialogue: 0,4:21:14.42,4:21:17.43,Default,,0,0,0,,Біз бұл туралы дүкеннен үйге қайтып келе жатқанда сөйлескен едік...
Dialogue: 0,4:21:17.43,4:21:22.43,Default,,0,0,0,,Бұл не? сурет? О, жоқ...
Dialogue: 0,4:21:22.43,4:21:26.10,Default,,0,0,0,,Цубаса-санның маған көбейту кестесін үйреткені есімде.
Dialogue: 0,4:21:26.10,4:21:29.44,Default,,0,0,0,,Одан кейін не болғаны көп есімде жоқ.
Dialogue: 0,4:21:29.44,4:21:31.77,Default,,0,0,0,,Мен әдетте сабақ оқымаймын.
Dialogue: 0,4:21:31.77,4:21:35.11,Default,,0,0,0,,Мүмкін кенеттен басымды пайдаланғандықтан болар.
Dialogue: 0,4:21:35.11,4:21:37.61,Default,,0,0,0,,《Әдеттегі Чио-санға оралу》
Dialogue: 0,4:21:37.61,4:21:40.45,Default,,0,0,0,,Цубаса-сан, бүгінгі күн үшін көп рахмет.
Dialogue: 0,4:21:40.45,4:21:42.62,Default,,0,0,0,,Менімен бірге оқығаныңыз үшін рахмет.
Dialogue: 0,4:21:42.62,4:21:45.29,Default,,0,0,0,,А, жоқ, бізге қыдырудың қажеті жоқ еді.
Dialogue: 0,4:21:45.29,4:21:48.12,Default,,0,0,0,,Чио-сан, мен келесі сыныпқа оңай өте аламын деп ойлаймын.
Dialogue: 0,4:21:48.12,4:21:51.63,Default,,0,0,0,,Өйткені Цубаса мырза мені мұқият оқытты.
Dialogue: 0,4:21:51.63,4:21:58.30,Default,,0,0,0,,Шичичига Шичи Шичи Ниджуши Шичи-сан... Ниджууши?
Dialogue: 0,4:21:58.30,4:22:00.30,Default,,0,0,0,,Иә!?
Dialogue: 0,4:22:00.30,4:22:03.14,Default,,0,0,0,,Секине, оян. Мен түні бойы тұруым керек!
Dialogue: 0,4:22:03.14,4:22:06.04,Default,,0,0,0,,А, мен ұйықтап жатырмын...
Dialogue: 0,4:22:09.31,4:22:11.91,Default,,0,0,0,,Сонымен... мен қолымнан келгенін жасадым.
Dialogue: 0,4:22:11.91,4:22:15.42,Default,,0,0,0,,Емтиханға сәттілік. Чио-сан
Dialogue: 0,4:22:15.42,4:22:19.42,Default,,0,0,0,,Өйткені ғажайыптар болуы мүмкін
Dialogue: 0,4:22:19.42,4:22:23.92,Default,,0,0,0,,Екеуің де көп уайымдама.
Dialogue: 0,4:22:23.92,4:22:26.59,Default,,0,0,0,,《Егер сіз өзіңіздің дағдыларыңызды ниндзя ретінде пайдалансаңыз...
Dialogue: 0,4:22:26.59,4:22:29.93,Default,,0,0,0,,Жауап парағын ұрлау сияқты қарапайым нәрсе》
Dialogue: 0,4:22:29.93,4:22:32.60,Default,,0,0,0,,《Түсініп тұрмын, бұл маған еркіндік береді...》
Dialogue: 0,4:22:32.60,4:22:35.27,Default,,0,0,0,,《Сондықтан мен сені міндетті түрде жоғарылатамын.
Dialogue: 0,4:22:35.27,4:22:37.77,Default,,0,0,0,,Алдамаңыз! 》 《Алдау》
Dialogue: 0,4:22:37.77,4:22:40.27,Default,,0,0,0,,《Қабілетіңізбен! 》 《Жоқ, сізде қабілет бар! 》
Dialogue: 0,4:22:40.27,4:22:44.28,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасаймын! Іске сәт!
Dialogue: 0,4:22:44.28,4:22:47.95,Default,,0,0,0,,《Қош бол Чио-сан》
Dialogue: 0,4:22:47.95,4:22:49.95,Default,,0,0,0,,Мен өттім! (Секине және т.б.) Неге?
Dialogue: 0,4:22:49.95,4:22:52.95,Default,,0,0,0,,Керемет Керемет Керемет Керемет
Dialogue: 0,4:23:00.96,4:23:02.96,Default,,0,0,0,,Иә!
Dialogue: 0,4:23:06.47,4:23:08.47,Default,,0,0,0,,Иә, аты болды.
Dialogue: 0,4:23:08.47,4:23:11.14,Default,,0,0,0,,Мен сенімен қайтадан мектепке бара аламын.
Dialogue: 0,4:23:11.14,4:23:14.08,Default,,0,0,0,,Сіз мұны қалай жасадыңыз? Яғни...
Dialogue: 0,4:23:14.08,4:23:18.75,Default,,0,0,0,,Мұғалімдер маған бірінен соң бірі сынақ берді.
Dialogue: 0,4:23:18.75,4:23:22.08,Default,,0,0,0,,Оның үстіне мен өзімнің ынта-жігерімді білдіретін эссе тапсырдым!
Dialogue: 0,4:23:22.08,4:23:24.59,Default,,0,0,0,,<Қайырымдылық шаралары>
Dialogue: 0,4:23:24.59,4:23:28.42,Default,,0,0,0,,Солай ма? Сосын түні бойы ұйқысыз отырудың мәні жоқ еді.
Dialogue: 0,4:23:28.42,4:23:30.42,Default,,0,0,0,,Бірақ...｡ Иә.
Dialogue: 0,4:23:30.42,4:23:33.09,Default,,0,0,0,,Рикканың аты... Барлығы!
Dialogue: 0,4:23:33.09,4:23:35.79,Default,,0,0,0,,Сізді жоғарылатуыңызбен құттықтаймыз!
Dialogue: 0,4:23:38.60,4:23:41.60,Default,,0,0,0,,Эй Рикка, сіз жоғарылату емтиханының нәтижелерін көрдіңіз бе?
Dialogue: 0,4:23:41.60,4:23:43.94,Default,,0,0,0,,Рикканың аты ғана жетіспеді.
Dialogue: 0,4:23:43.94,4:23:46.54,Default,,0,0,0,,Иә, мен білемін.
Dialogue: 0,4:23:49.61,4:23:53.11,Default,,0,0,0,,Рикканың бітіру рәсімі бұдан былай өтеді.
Dialogue: 0,4:23:53.11,4:23:55.12,Default,,0,0,0,,Мектеп бітіру рәсімі?
Dialogue: 0,4:23:55.12,4:23:58.62,Default,,0,0,0,,Жауап: Мен Риккамын, бітіруші сыныптың өкілімін.
Dialogue: 0,4:23:58.62,4:24:00.96,Default,,0,0,0,,Қазір қалжыңдайтын уақыт емес.
Dialogue: 0,4:24:00.96,4:24:04.13,Default,,0,0,0,,Бұл қате деп ойлаймын, сондықтан мұғалімдерге айтуым керек.
Dialogue: 0,4:24:04.13,4:24:06.13,Default,,0,0,0,,Ах...
Dialogue: 0,4:24:06.13,4:24:08.96,Default,,0,0,0,,Естеріңізде болса, мен бәрімен кездескеннен кейін
Dialogue: 0,4:24:08.96,4:24:10.97,Default,,0,0,0,,Көп нәрсе болды.
Dialogue: 0,4:24:10.97,4:24:13.57,Default,,0,0,0,,Көңілді мәдени фестиваль
Dialogue: 0,4:24:13.57,4:24:15.74,Default,,0,0,0,,Ыңғайсыз шоппинг
Dialogue: 0,4:24:15.74,4:24:17.91,Default,,0,0,0,,Тілек білдірген бассейн
Dialogue: 0,4:24:17.91,4:24:20.07,Default,,0,0,0,,Сәжде теңізі
Dialogue: 0,4:24:20.07,4:24:23.41,Default,,0,0,0,,Тілімді күйдіріп, аузымды ағызып жібере жаздаған Такопа.
Dialogue: 0,4:24:23.41,4:24:25.75,Default,,0,0,0,,Түнде бәріміз ұйықтадық
Dialogue: 0,4:24:25.75,4:24:30.92,Default,,0,0,0,,Әрбір естелік Рикканың асыл қазынасы.
Dialogue: 0,4:24:30.92,4:24:34.92,Default,,0,0,0,,Мен сенімен бірге өткен күндерді ешқашан ұмытпаймын.
Dialogue: 0,4:24:34.92,4:24:37.59,Default,,0,0,0,,Рикка-чан, кенеттен не болды?
Dialogue: 0,4:24:37.59,4:24:41.09,Default,,0,0,0,,Дұрыс. Осымен қоштасу сияқты бірдеңе айттым.
Dialogue: 0,4:24:54.61,4:24:57.61,Default,,0,0,0,,А, бұл не!? НЛО!? Бұл шын ба?
Dialogue: 0,4:24:57.61,4:25:01.81,Default,,0,0,0,,Сен мұнда не үшін келдің? Апыр-ай! Керемет!
Dialogue: 0,4:25:03.95,4:25:05.95,Default,,0,0,0,,Не!
Dialogue: 0,4:25:08.46,4:25:11.29,Default,,0,0,0,,《Полковниктің миын жуу жойылды ма? 》
Dialogue: 0,4:25:11.29,4:25:14.23,Default,,0,0,0,,Бұдан былай барлығының естеліктері өшеді.
Dialogue: 0,4:25:14.23,4:25:17.06,Default,,0,0,0,,НЛО-ның болуы және менің бар болуым
Dialogue: 0,4:25:17.06,4:25:19.07,Default,,0,0,0,,Мен сені ұмыттыруым керек.
Dialogue: 0,4:25:19.07,4:25:21.74,Default,,0,0,0,,Есте сақтауды өшіру деген нені білдіреді?
Dialogue: 0,4:25:21.74,4:25:26.91,Default,,0,0,0,,Чио-сан, мисс Секине, Мисс Цубаса. Осы уақытқа дейін көрсеткен көмегіңіз үшін рахмет.
Dialogue: 0,4:25:26.91,4:25:31.25,Default,,0,0,0,,Бұл өмірде айырылысуды ойлау азап болар, бірақ мен жыламаймын.
Dialogue: 0,4:25:31.25,4:25:34.08,Default,,0,0,0,,Қанша уақыт өтсе де, И
Dialogue: 0,4:25:34.08,4:25:36.78,Default,,0,0,0,,Досыма бақыт тілеймін!
Dialogue: 0,4:25:39.75,4:25:42.42,Default,,0,0,0,,Рикка Неліктен НЛО?
Dialogue: 0,4:25:42.42,4:25:44.43,Default,,0,0,0,,Бұл менің кінәм
Dialogue: 0,4:25:44.43,4:25:48.26,Default,,0,0,0,,Рикка-чанның ғарышқа қайта оралуына мен кінәлімін!
Dialogue: 0,4:25:48.26,4:25:50.60,Default,,0,0,0,,Сіз жадыңызды жоғалттым дедіңіз.
Dialogue: 0,4:25:50.60,4:25:52.60,Default,,0,0,0,,Бұл өтірік болды ма?
Dialogue: 0,4:25:52.60,4:25:55.60,Default,,0,0,0,,Иә. Сол күні менің басым кенет анық болды.
Dialogue: 0,4:25:55.60,4:25:57.94,Default,,0,0,0,,Мен көп нәрсені түсіндім...
Dialogue: 0,4:25:57.94,4:26:03.61,Default,,0,0,0,,Мен бірдеңені айттым, мені бұрышқа түсірді... Уф...
Dialogue: 0,4:26:03.61,4:26:06.45,Default,,0,0,0,,Бұл Чио-санның кінәсі емес.
Dialogue: 0,4:26:06.45,4:26:08.95,Default,,0,0,0,,Біз кездескеннен бері
Dialogue: 0,4:26:08.95,4:26:12.55,Default,,0,0,0,,Рикка ғарышқа қашан оралу керектігін ойлады.
Dialogue: 0,4:26:12.55,4:26:15.89,Default,,0,0,0,,Ғарышқа қайта оралуға тура келетін жағдайлар бар.
Dialogue: 0,4:26:15.89,4:26:18.89,Default,,0,0,0,,Иә, солай. Мен шынымен түсінбеймін.
Dialogue: 0,4:26:18.89,4:26:22.23,Default,,0,0,0,,Кенеттен өзімді осылай сезіндім... Мен өзімді осылай жалғыз сезінемін.
Dialogue: 0,4:26:22.23,4:26:24.57,Default,,0,0,0,,Мен де...
Dialogue: 0,4:26:24.57,4:26:26.73,Default,,0,0,0,,Бірақ бұл Рикканың шешімі болды.
Dialogue: 0,4:26:26.73,4:26:29.90,Default,,0,0,0,,Мен адамның еркін құрметтеуіміз керек деп ойлаймын.
Dialogue: 0,4:26:29.90,4:26:33.24,Default,,0,0,0,,Рикка-чан. Бұл шынымен оның ниеті ме?
Dialogue: 0,4:26:33.24,4:26:36.08,Default,,0,0,0,,Не? Рика жылап отырды
Dialogue: 0,4:26:36.08,4:26:38.91,Default,,0,0,0,,Мен мұнда болмауым керек екенін білемін, бірақ
Dialogue: 0,4:26:38.91,4:26:40.91,Default,,0,0,0,,Мен әркімнен бөлінгім келмейді
Dialogue: 0,4:26:40.91,4:26:43.75,Default,,0,0,0,,Мүмкін сіз солай ойлайсыз.
Dialogue: 0,4:26:43.75,4:26:45.92,Default,,0,0,0,,Неліктен бұлай етер едіңіз? Цубаса...
Dialogue: 0,4:26:45.92,4:26:49.02,Default,,0,0,0,,Мен түсіндім. Мен де солаймын.
Dialogue: 0,4:26:51.26,4:26:55.93,Default,,0,0,0,,Мен қанат емеспін! Ол қатты! Аа!?
Dialogue: 0,4:26:55.93,4:26:58.60,Default,,0,0,0,,Алғашында мен мектепке құлықсыз бардым, бірақ
Dialogue: 0,4:26:58.60,4:27:01.77,Default,,0,0,0,,Барлығымен кездесу күн сайын өте қызықты болды.
Dialogue: 0,4:27:01.77,4:27:06.11,Default,,0,0,0,,Мен мұны білмей тұрып, мектепке баруды асыға күттім.
Dialogue: 0,4:27:06.11,4:27:09.44,Default,,0,0,0,,Мен сізге шындықты айтуым керек деп ойладым.
Dialogue: 0,4:27:09.44,4:27:14.88,Default,,0,0,0,,Бірақ мен оны айта алмаймын. Мен сияқты...
Dialogue: 0,4:27:14.88,4:27:18.22,Default,,0,0,0,,Кейде ауырады...
Dialogue: 0,4:27:18.22,4:27:22.92,Default,,0,0,0,,Кешіріңіз. Мен бәріне өтірік айттым.
Dialogue: 0,4:27:25.39,4:27:29.73,Default,,0,0,0,,Мен көремін. Осы уақытқа дейін бәрі байланысты.
Dialogue: 0,4:27:29.73,4:27:33.07,Default,,0,0,0,,Шынымды айтсам, мен таң қалмадым.
Dialogue: 0,4:27:33.07,4:27:35.74,Default,,0,0,0,,Барлығы бірдей өтірік айтады.
Dialogue: 0,4:27:35.74,4:27:39.07,Default,,0,0,0,,Дұрыс. Мен сені кінәлай алмаймын.
Dialogue: 0,4:27:39.07,4:27:41.08,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,4:27:41.08,4:27:43.08,Default,,0,0,0,,Барлығы қандай өтірік айтады?
Dialogue: 0,4:27:43.08,4:27:45.41,Default,,0,0,0,,Енді бұл Рикка-чан!
Dialogue: 0,4:27:45.41,4:27:47.92,Default,,0,0,0,,Солай ма?
Dialogue: 0,4:27:47.92,4:27:50.08,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,4:27:50.08,4:27:53.59,Default,,0,0,0,,Мен жай ғана оның ниеті ме деп сұрауым керек пе?
Dialogue: 0,4:27:53.59,4:27:57.76,Default,,0,0,0,,Бірақ ол жерге қалай жеттіңіз?
Dialogue: 0,4:27:57.76,4:28:00.76,Default,,0,0,0,,Мен барлық әңгімелерді естідім! (Чиё) Ханзо!?
Dialogue: 0,4:28:00.76,4:28:03.43,Default,,0,0,0,,Сіз жылап көрдіңіз бе? Болмады ма!?
Dialogue: 0,4:28:03.43,4:28:07.77,Default,,0,0,0,,Уақытша бітім болды, апа! Бұл!
Dialogue: 0,4:28:07.77,4:28:10.60,Default,,0,0,0,,♬~
Dialogue: 0,4:28:10.60,4:28:13.21,Default,,0,0,0,,О!
Dialogue: 0,4:28:13.21,4:28:17.71,Default,,0,0,0,,Ох… Уф~ Мен қатты ашпын.
Dialogue: 0,4:28:17.71,4:28:20.05,Default,,0,0,0,,Цезарь жастығын да, болашағын да босқа өткізді
Dialogue: 0,4:28:20.05,4:28:22.22,Default,,0,0,0,,Жай ғана секіру!
Dialogue: 0,4:28:22.22,4:28:25.05,Default,,0,0,0,,Кем дегенде шатырдан!
Dialogue: 0,4:28:25.05,4:28:27.05,Default,,0,0,0,,Иә? Ах.
Dialogue: 0,4:28:27.05,4:28:29.56,Default,,0,0,0,,Уау! Ханым уақыты!
Dialogue: 0,4:28:29.56,4:28:31.56,Default,,0,0,0,,О, менің...
Dialogue: 0,4:28:31.56,4:28:33.56,Default,,0,0,0,,Уф. (Цубаса) Қазір жер бетінде не болып жатыр...
Dialogue: 0,4:28:33.56,4:28:36.90,Default,,0,0,0,,Мен мұны басқа жолы түсіндіремін. (Цубаса) Иә.
Dialogue: 0,4:28:36.90,4:28:40.57,Default,,0,0,0,,Бұл жақсы. Енді мен Чио-санның көтерілуін көрдім.
Dialogue: 0,4:28:40.57,4:28:43.07,Default,,0,0,0,,Есте сақтайтын ештеңе қалмады
Dialogue: 0,4:28:43.07,4:28:45.07,Default,,0,0,0,,Попоперо Пеппопепо
Dialogue: 0,4:28:45.07,4:28:48.08,Default,,0,0,0,,Жоспар бойынша күн жүйесінен шығу
Dialogue: 0,4:28:48.08,4:28:51.08,Default,,0,0,0,,Содан кейін өмірді қамтамасыз ету жүйесінен басқа барлық функциялар тоқтатылады.
Dialogue: 0,4:28:51.08,4:28:53.75,Default,,0,0,0,,Рельефтік сигнал жіберу. Попопепо
Dialogue: 0,4:28:53.75,4:28:56.25,Default,,0,0,0,,Сіздің достарыңыз сигналды қабылдай ма, жоқ па
Dialogue: 0,4:28:56.25,4:28:58.59,Default,,0,0,0,,Мен білмеймін, бірақ мен тырысуым керек.
Dialogue: 0,4:28:58.59,4:29:00.59,Default,,0,0,0,,Кеттік! Пепо
Dialogue: 0,4:29:02.76,4:29:07.56,Default,,0,0,0,,Жарайды. Мен оны мәңгі есте сақтай аламын.
Dialogue: 0,4:29:12.87,4:29:15.37,Default,,0,0,0,,Оряоря Оряоря...
Dialogue: 0,4:29:15.37,4:29:17.37,Default,,0,0,0,,Ах!
Dialogue: 0,4:29:19.37,4:29:21.37,Default,,0,0,0,,…қашып кету…
Dialogue: 0,4:29:30.72,4:29:34.05,Default,,0,0,0,,Мен саған айтар сөзім болғандықтан келдім.
Dialogue: 0,4:29:34.05,4:29:37.39,Default,,0,0,0,,Мен Рикка-чанмен бітіргім келеді!
Dialogue: 0,4:29:37.39,4:29:40.06,Default,,0,0,0,,Чионың өзімшілдігі Өтінемін, мені тыңда!
Dialogue: 0,4:29:40.06,4:29:43.73,Default,,0,0,0,,Чио-сан. Мен де Риккадан бөлінгім келмейді.
Dialogue: 0,4:29:43.73,4:29:47.57,Default,,0,0,0,,Мен мән-жайлар бар деп ойлаймын, бірақ сіз қайта қарастыра аласыз ба?
Dialogue: 0,4:29:47.57,4:29:50.24,Default,,0,0,0,,Секине ханым
Dialogue: 0,4:29:50.24,4:29:53.41,Default,,0,0,0,,Кенеттен қоштасудың өзі қорқынышты, Рикка.
Dialogue: 0,4:29:53.41,4:29:59.25,Default,,0,0,0,,Бәріміз өтірік айттық, бірақ дос екеніміз рас, солай ма?
Dialogue: 0,4:29:59.25,4:30:01.42,Default,,0,0,0,,Мен айтқым келген нәрсені айттым.
Dialogue: 0,4:30:01.42,4:30:04.75,Default,,0,0,0,,Менің ойымша, маңыздысы Рикканың не істегісі келетіні.
Dialogue: 0,4:30:04.75,4:30:08.09,Default,,0,0,0,,Рикка...
Dialogue: 0,4:30:08.09,4:30:11.93,Default,,0,0,0,,Рикка да барлығымен бірге оқуды бітіргісі келеді!
Dialogue: 0,4:30:11.93,4:30:13.93,Default,,0,0,0,,Олай болса, солай істейік.
Dialogue: 0,4:30:13.93,4:30:16.43,Default,,0,0,0,,Көңілді естеліктер жасауды жалғастырайық
Dialogue: 0,4:30:16.43,4:30:19.27,Default,,0,0,0,,Ух... иә
Dialogue: 0,4:30:19.27,4:30:21.44,Default,,0,0,0,,Жарайсың, Секине
Dialogue: 0,4:30:21.44,4:30:23.94,Default,,0,0,0,,Бұл өте жақсы болды.
Dialogue: 0,4:30:23.94,4:30:28.11,Default,,0,0,0,,Пипопоро Поппо Пепопо Попопо Попоро Попоро
Dialogue: 0,4:30:28.11,4:30:34.45,Default,,0,0,0,,Пеппопопо Попоропапепи Папопепипепипопоп Попопо Пепипупоп
Dialogue: 0,4:30:34.45,4:30:37.12,Default,,0,0,0,,Ең алдымен! (Цубаса) Не!?
Dialogue: 0,4:30:37.12,4:30:40.12,Default,,0,0,0,,Ах!
Dialogue: 0,4:30:40.12,4:30:43.52,Default,,0,0,0,,Қарғыс атсын, мен оны басқара алмаймын!? Басқа таңдау жоқ!
Dialogue: 0,4:30:47.79,4:30:50.80,Default,,0,0,0,,Уау! Осындай нәрсе болуы мүмкін бе деп ойлаймын!
Dialogue: 0,4:30:50.80,4:30:53.13,Default,,0,0,0,,Суық ұйықтауға арналған киім!
Dialogue: 0,4:30:53.13,4:30:56.47,Default,,0,0,0,,Мұны қазір жасаңыз!? (Чиё) Мен жақсы ұйықтай аламын деп ойлаймын.
Dialogue: 0,4:30:56.47,4:30:58.47,Default,,0,0,0,,Попепопо Лопурпупо
Dialogue: 0,4:31:01.14,4:31:03.64,Default,,0,0,0,,НЛО! Бұл қымбат!
Dialogue: 0,4:31:03.64,4:31:07.98,Default,,0,0,0,,Шығу құрылғысы тым күрделі емес пе? Жарайды, дәл солай.
Dialogue: 0,4:31:07.98,4:31:10.15,Default,,0,0,0,,Бұл өтірік!
Dialogue: 0,4:31:10.15,4:31:14.76,Default,,0,0,0,,Ал енді ойлап қарасам, мен әлдеқашан аман қалдым...
Dialogue: 0,4:31:14.76,4:31:18.09,Default,,0,0,0,,Бұл рас. Цубаса мырза - Цубаса мырза!
Dialogue: 0,4:31:18.09,4:31:20.59,Default,,0,0,0,,Рахмет, Чио-сан! Мен күштімін бірақ!
Dialogue: 0,4:31:20.59,4:31:24.43,Default,,0,0,0,,《Кешіріңіз, бәріңіз. Барлығын қалыпты жағдайға келтіру үшін.
Dialogue: 0,4:31:24.43,4:31:26.43,Default,,0,0,0,,Менде осы ғана қалды...》《Полковник? 》
Dialogue: 0,4:31:26.43,4:31:28.43,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,4:33:05.47,4:33:08.14,Default,,0,0,0,,Жақында жоғарылату емтиханы келеді.
Dialogue: 0,4:33:08.14,4:33:11.57,Default,,0,0,0,,Дұрыс. Жарайды, Секине оңай өтеді.
Dialogue: 0,4:33:11.57,4:33:14.41,Default,,0,0,0,,Қанаттарда орын жеткіліксіз бе?
Dialogue: 0,4:33:14.41,4:33:18.58,Default,,0,0,0,,Менің ойымша, біз бұрын осындай әңгіме болған сияқты...
Dialogue: 0,4:33:18.58,4:33:21.25,Default,,0,0,0,,Мен бір нәрсені ұмытып бара жатқандай сезінемін...
Dialogue: 0,4:33:21.25,4:33:23.25,Default,,0,0,0,,Ұйқым жетпей жатыр.
Dialogue: 0,4:33:23.25,4:33:25.75,Default,,0,0,0,,Негізі мен соңғы кездері кесте тігумен айналысып жүрмін.
Dialogue: 0,4:33:25.75,4:33:27.75,Default,,0,0,0,,Оқу, Чио-сан!
Dialogue: 0,4:33:27.75,4:33:30.92,Default,,0,0,0,,Бұл өте нашар болады!
Dialogue: 0,4:33:30.92,4:33:34.09,Default,,0,0,0,,＜ Кіші орта мектептің қарапайым қыздары
Dialogue: 0,4:33:34.09,4:33:39.27,Default,,0,0,0,,Бұл кәдімгі таңғы көрініс сияқты...
Dialogue: 0,4:33:39.27,4:33:42.47,Default,,0,0,0,,Негізі бұл төрт адамның себебі бар＞
Dialogue: 0,4:33:43.97,4:33:49.97,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory