Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.66,0:00:03.33,Default,,0,0,0,,Биылғы Рождестволық сыйлық...
Dialogue: 0,0:00:03.42,0:00:04.96,Default,,0,0,0,,Рождество…
Dialogue: 0,0:00:05.04,0:00:07.04,Default,,0,0,0,,Иә, міндетті түрде барыңыз!
Dialogue: 0,0:00:08.63,0:00:09.96,Default,,0,0,0,,1 апта...
Dialogue: 0,0:00:12.55,0:00:13.72,Default,,0,0,0,,Әлі ерте
Dialogue: 0,0:00:15.59,0:00:18.85,Default,,0,0,0,,Кешіріңіз Такахаши...
Dialogue: 0,0:00:21.68,0:00:22.93,Default,,0,0,0,,Анаммен…
Dialogue: 0,0:00:25.27,0:00:26.56,Default,,0,0,0,,Токиоға барыңыз
Dialogue: 0,0:00:27.19,0:00:32.19,Default,,0,0,0,,♪～
Dialogue: 0,0:01:53.11,0:01:57.99,Default,,0,0,0,,～♪
Dialogue: 0,0:01:59.74,0:02:00.57,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:02:00.66,0:02:03.12,Default,,0,0,0,,Бұл Токио тінтуірінің жері емес.
Dialogue: 0,0:02:03.62,0:02:07.87,Default,,0,0,0,,Рождествода біз Асахикава хайуанаттар бағында ойнадық, содан кейін ыстық бұлаққа бардық...
Dialogue: 0,0:02:07.96,0:02:09.46,Default,,0,0,0,,Ыстық бұлақ?
Dialogue: 0,0:02:09.54,0:02:11.75,Default,,0,0,0,,Мен қалған күнді Такахашимен бірге өткіземін.
Dialogue: 0,0:02:12.25,0:02:14.17,Default,,0,0,0,,Біз барлық уақытымызды бірге өткіземіз ...
Dialogue: 0,0:02:14.25,0:02:16.51,Default,,0,0,0,,Бұл дегеніміз...
Dialogue: 0,0:02:17.01,0:02:19.88,Default,,0,0,0,,Эхехе Ұйқы
Dialogue: 0,0:02:23.10,0:02:25.18,Default,,0,0,0,,Қол ұстасып ұйықтау дұрыс
Dialogue: 0,0:02:25.68,0:02:29.14,Default,,0,0,0,,Егер Такахаши мұны істегісі келетінін айтса, мен ештеңе істемеймін деп уәде беремін.
Dialogue: 0,0:02:29.73,0:02:30.56,Default,,0,0,0,,Тротуар тым кеңейіп кетті
Dialogue: 0,0:02:31.44,0:02:35.15,Default,,0,0,0,,Қандай жағдай болмасын... мүмкін емес. Менде ондай ақша жоқ.
Dialogue: 0,0:02:35.23,0:02:37.24,Default,,0,0,0,,Ақшаның қолынан бәрі келеді.
Dialogue: 0,0:02:37.32,0:02:39.28,Default,,0,0,0,,Не болды?
Dialogue: 0,0:02:39.36,0:02:42.57,Default,,0,0,0,,Мама, мен алдын ала қалталы ақша алғым келеді.
Dialogue: 0,0:02:43.70,0:02:45.45,Default,,0,0,0,,Ол не үшін қолданылады?
Dialogue: 0,0:02:45.54,0:02:47.66,Default,,0,0,0,,Себебі мен онымен Рождествоны өткізгім келеді
Dialogue: 0,0:02:48.54,0:02:49.96,Default,,0,0,0,,Сізге қанша қажет?
Dialogue: 0,0:02:50.46,0:02:51.29,Default,,0,0,0,,20 000
Dialogue: 0,0:02:54.42,0:02:57.67,Default,,0,0,0,,Бұл мектеп оқушысының бір күнде жұмсайтын сомасы емес.
Dialogue: 0,0:02:58.17,0:02:59.80,Default,,0,0,0,,Мен шынымен назар аударғым келеді
Dialogue: 0,0:02:59.88,0:03:01.26,Default,,0,0,0,,Һм? Не болды?
Dialogue: 0,0:03:01.89,0:03:02.80,Default,,0,0,0,,Мен сені кешіремін
Dialogue: 0,0:03:07.60,0:03:09.56,Default,,0,0,0,,Өйткені алмасу шарттары бар
Dialogue: 0,0:03:13.27,0:03:16.65,Default,,0,0,0,,Мен... мен сенің соңынан Токиоға барамын.
Dialogue: 0,0:03:18.90,0:03:20.07,Default,,0,0,0,,Бұл дегеніміз…
Dialogue: 0,0:03:20.15,0:03:22.78,Default,,0,0,0,,Яноның өтеуі?
Dialogue: 0,0:03:22.86,0:03:25.49,Default,,0,0,0,,Олай болса, өзіңізді бұлай зорлағаныңызды қаламаймын.
Dialogue: 0,0:03:25.58,0:03:27.20,Default,,0,0,0,,Адал болыңыз.
Dialogue: 0,0:03:27.91,0:03:29.08,Default,,0,0,0,,Такахаши
Dialogue: 0,0:03:29.16,0:03:31.75,Default,,0,0,0,,Мен Такахаши Рождество мерекесімен құттықтағым келеді.
Dialogue: 0,0:03:34.29,0:03:36.04,Default,,0,0,0,,Менің қалағаным осы
Dialogue: 0,0:03:36.13,0:03:37.63,Default,,0,0,0,,Бір жылдан кейін де
Dialogue: 0,0:03:37.71,0:03:41.80,Default,,0,0,0,,Сол күнді есіңе түсірсең, ол сені бар күшіңді салатын Рождество болады... Ниса
Dialogue: 0,0:03:45.09,0:03:47.81,Default,,0,0,0,,Естеліктерге сенбеймін десең де
Dialogue: 0,0:03:48.64,0:03:49.64,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:52.19,0:03:53.06,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:03:53.14,0:03:56.81,Default,,0,0,0,,Мен шыншыл емеспін.
Dialogue: 0,0:03:57.65,0:03:59.07,Default,,0,0,0,,Хехе...
Dialogue: 0,0:04:06.37,0:04:07.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:07.62,0:04:08.70,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:04:08.79,0:04:11.75,Default,,0,0,0,,Иә, сондықтан, ыстық бұлақтар жоқ.
Dialogue: 0,0:04:11.83,0:04:14.50,Default,,0,0,0,,Не? Мен бұл нені білдіретінін білмеймін.
Dialogue: 0,0:04:15.29,0:04:17.21,Default,,0,0,0,,Яноның сезімі өте жақсы жеткізілді.
Dialogue: 0,0:04:17.79,0:04:19.55,Default,,0,0,0,,Мен өте қуаныштымын
Dialogue: 0,0:04:20.13,0:04:21.34,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:04:21.42,0:04:22.47,Default,,0,0,0,,Бірақ?
Dialogue: 0,0:04:23.55,0:04:26.64,Default,,0,0,0,,Мен ерекше қорқамын...
Dialogue: 0,0:04:27.60,0:04:28.47,Default,,0,0,0,,Әй?
Dialogue: 0,0:04:28.55,0:04:29.47,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:04:29.56,0:04:30.93,Default,,0,0,0,,Яномен бірге өткізген уақыт
Dialogue: 0,0:04:31.02,0:04:33.77,Default,,0,0,0,,Мен бұл сәл артық екенін білемін.
Dialogue: 0,0:04:33.85,0:04:36.69,Default,,0,0,0,,Сондықтан мен оның бұрынғыдай болғанын қалаймын
Dialogue: 0,0:04:38.31,0:04:39.86,Default,,0,0,0,,Әдеттегідей...
Dialogue: 0,0:04:43.28,0:04:46.82,Default,,0,0,0,,Бұл ерекше де, соңы да емес.
Dialogue: 0,0:04:48.53,0:04:49.87,Default,,0,0,0,,Мен сенгім келеді
Dialogue: 0,0:04:57.08,0:04:58.17,Default,,0,0,0,,Ах Яно
Dialogue: 0,0:04:59.42,0:05:00.92,Default,,0,0,0,,Яно!
Dialogue: 0,0:05:01.00,0:05:02.01,Default,,0,0,0,,Уау...
Dialogue: 0,0:05:03.97,0:05:05.97,Default,,0,0,0,,Өте сүйкімді
Dialogue: 0,0:05:06.05,0:05:07.30,Default,,0,0,0,,Гуа!
Dialogue: 0,0:05:07.39,0:05:10.51,Default,,0,0,0,,Ыстық бұлақ сапарында әкелуім керек еді, амалсыз болса да.
Dialogue: 0,0:05:10.60,0:05:12.72,Default,,0,0,0,,Яно, бұл өте жаман.
Dialogue: 0,0:05:12.81,0:05:15.98,Default,,0,0,0,,Бүгін де басқа күндер сияқты болады деп уәде бердің.
Dialogue: 0,0:05:16.06,0:05:18.31,Default,,0,0,0,,Сіз әдеттегіден басқашасыз.
Dialogue: 0,0:05:18.40,0:05:19.77,Default,,0,0,0,,Бітімсіз
Dialogue: 0,0:05:19.86,0:05:21.19,Default,,0,0,0,,Өте сүйкімді
Dialogue: 0,0:05:21.82,0:05:23.69,Default,,0,0,0,,Хи хи хи... кеттік
Dialogue: 0,0:05:35.66,0:05:37.83,Default,,0,0,0,,Шығыс аспанға қараңыз
Dialogue: 0,0:05:38.83,0:05:39.96,Default,,0,0,0,,Желтоқсанда
Dialogue: 0,0:05:40.59,0:05:44.55,Default,,0,0,0,,Шығыс аспан қысқы шоқжұлдыздарға толы.
Dialogue: 0,0:05:52.81,0:05:53.77,Default,,0,0,0,,Иә
Dialogue: 0,0:05:56.02,0:05:58.44,Default,,0,0,0,,Иә, мен сенімдімін
Dialogue: 0,0:06:20.42,0:06:21.83,Default,,0,0,0,,Иә (Нами) Рахмет.
Dialogue: 0,0:06:21.92,0:06:24.13,Default,,0,0,0,,Уау, өте ыстық
Dialogue: 0,0:06:24.21,0:06:25.88,Default,,0,0,0,,Жүрек? (Нами) Иә.
Dialogue: 0,0:06:56.87,0:06:57.70,Default,,0,0,0,,Яно
Dialogue: 0,0:06:57.79,0:07:00.54,Default,,0,0,0,,Мен суретке түсемін. Қараңыз, күліңіз, күліңіз.
Dialogue: 0,0:07:00.62,0:07:04.38,Default,,0,0,0,,Әдетте, оны драманың соңғы эпизоды сияқты жағдайларда алуға болады.
Dialogue: 0,0:07:04.46,0:07:07.55,Default,,0,0,0,,Қабыл ал, оның жүзінен күлкі кетпейді, бұл бақытты аяқталады, солай ма?
Dialogue: 0,0:07:07.63,0:07:09.84,Default,,0,0,0,,Бұл енді драма немесе аниме емес.
Dialogue: 0,0:07:09.92,0:07:11.43,Default,,0,0,0,,Ашуланба
Dialogue: 0,0:07:11.51,0:07:12.89,Default,,0,0,0,,Иә, OK түймесін басыңыз
Dialogue: 0,0:07:12.97,0:07:13.80,Default,,0,0,0,,(Батырма басылған дыбысы)
Dialogue: 0,0:07:13.89,0:07:14.72,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:07:16.60,0:07:19.85,Default,,0,0,0,,Әй, мынау қандай оғаш бет?
Dialogue: 0,0:07:20.81,0:07:22.94,Default,,0,0,0,,Не? Бұл сүйкімді
Dialogue: 0,0:07:23.02,0:07:25.27,Default,,0,0,0,,Мұндағы пурикура Яноға жағымпаздық танытады.
Dialogue: 0,0:07:25.36,0:07:27.48,Default,,0,0,0,,Мен әрқашан қобалжуларды суретке түсіре аламын.
Dialogue: 0,0:07:27.57,0:07:28.73,Default,,0,0,0,,Ашуланба
Dialogue: 0,0:07:41.62,0:07:43.21,Default,,0,0,0,,Менің дос қызым...
Dialogue: 0,0:07:44.04,0:07:45.46,Default,,0,0,0,,Әйел
Dialogue: 0,0:07:47.88,0:07:49.26,Default,,0,0,0,,Сіз, ол кезде...
Dialogue: 0,0:07:50.63,0:07:53.18,Default,,0,0,0,,Мен өткен жараларымды мойындағанда...
Dialogue: 0,0:07:53.26,0:07:55.51,Default,,0,0,0,,Бірге фотостендке түскіңіз келе ме?
Dialogue: 0,0:07:56.10,0:07:57.14,Default,,0,0,0,,Бұл ақымақ па?
Dialogue: 0,0:07:57.22,0:07:59.93,Default,,0,0,0,,Иә, мен де солай ойладым.
Dialogue: 0,0:08:00.60,0:08:01.60,Default,,0,0,0,,Идиот
Dialogue: 0,0:08:02.23,0:08:03.56,Default,,0,0,0,,Мен ақымақпын
Dialogue: 0,0:08:05.77,0:08:08.15,Default,,0,0,0,,Мен қатты жек көретін адам
Dialogue: 0,0:08:09.15,0:08:11.11,Default,,0,0,0,,Мен саған қатты ғашық болдым
Dialogue: 0,0:08:12.57,0:08:14.45,Default,,0,0,0,,Нанами - ақымақ
Dialogue: 0,0:08:15.49,0:08:17.74,Default,,0,0,0,,Жарайды, мен ақымақ шығармын.
Dialogue: 0,0:08:18.24,0:08:19.45,Default,,0,0,0,,Mu…
Dialogue: 0,0:08:20.24,0:08:21.37,Default,,0,0,0,,Оның қолына қара!
Dialogue: 0,0:08:31.92,0:08:34.76,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:08:56.20,0:08:57.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:01.66,0:09:03.16,Default,,0,0,0,,Ф-Фатирлеу ештеңе әкелмейді.
Dialogue: 0,0:09:03.66,0:09:05.37,Default,,0,0,0,,Бұл сүйкімді
Dialogue: 0,0:09:06.25,0:09:09.38,Default,,0,0,0,,Және... бұл да
Dialogue: 0,0:09:10.88,0:09:11.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:15.42,0:09:16.63,Default,,0,0,0,,Ах
Dialogue: 0,0:09:18.68,0:09:22.81,Default,,0,0,0,,Екі адам түсірген алғашқы пурикура суреті
Dialogue: 0,0:09:23.81,0:09:25.39,Default,,0,0,0,,Уф!
Dialogue: 0,0:09:26.27,0:09:29.94,Default,,0,0,0,,Сонда да... ыңғайсыз.
Dialogue: 0,0:09:31.19,0:09:34.40,Default,,0,0,0,,Екеуі де жас
Dialogue: 0,0:09:37.11,0:09:38.32,Default,,0,0,0,,Бұл
Dialogue: 0,0:09:38.41,0:09:41.33,Default,,0,0,0,,Бүгін әкеліп әуре болдың ба?
Dialogue: 0,0:09:42.03,0:09:43.87,Default,,0,0,0,,Сіз қалай ойлайсыз? мыс?
Dialogue: 0,0:09:45.58,0:09:46.79,Default,,0,0,0,,Яно
Dialogue: 0,0:09:47.96,0:09:51.79,Default,,0,0,0,,Токиоға баратын болсаңыз, маған ол жақтан көптеген фотолар жіберіңіз.
Dialogue: 0,0:09:51.88,0:09:52.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:54.46,0:09:58.80,Default,,0,0,0,,Форма киген көп адамдар және т.б.
Dialogue: 0,0:10:01.18,0:10:02.18,Default,,0,0,0,,Иә
Dialogue: 0,0:10:04.68,0:10:08.19,Default,,0,0,0,,Бір-бірімізден алшақ болсақ та, байланыс лезде болады.
Dialogue: 0,0:10:08.27,0:10:09.27,Default,,0,0,0,,Иә
Dialogue: 0,0:10:09.98,0:10:13.86,Default,,0,0,0,,Сіз дауыстарды ести аласыз, беттерді көре аласыз және электрондық хаттарды жібере аласыз.
Dialogue: 0,0:10:13.94,0:10:14.94,Default,,0,0,0,,Иә
Dialogue: 0,0:10:17.11,0:10:18.28,Default,,0,0,0,,Бірақ мен...
Dialogue: 0,0:10:20.53,0:10:22.28,Default,,0,0,0,,Мен телефон соғу мүмкін емес шығар.
Dialogue: 0,0:10:22.37,0:10:23.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:24.54,0:10:26.79,Default,,0,0,0,,Біздің үй шаруашылығының бюджеті біршама тар сияқты.
Dialogue: 0,0:10:31.00,0:10:32.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:10:33.38,0:10:35.34,Default,,0,0,0,,Бірақ мен аптасына бір рет жасаймын.
Dialogue: 0,0:10:39.43,0:10:41.14,Default,,0,0,0,,Эй-эй, эй-эй
Dialogue: 0,0:10:43.35,0:10:45.56,Default,,0,0,0,,Себебі менде бәрі жақсы
Dialogue: 0,0:10:46.89,0:10:48.43,Default,,0,0,0,,Өзіңді тым қинатпа
Dialogue: 0,0:10:49.73,0:10:52.02,Default,,0,0,0,,Анашым, маған қамқор болыңыз.
Dialogue: 0,0:10:57.99,0:10:59.49,Default,,0,0,0,,Мен толық емес жұмыс күнін іздеймін.
Dialogue: 0,0:10:59.57,0:11:02.87,Default,,0,0,0,,Толық емес жұмыс күні? Емтихан тапсыру дұрыс па?
Dialogue: 0,0:11:02.95,0:11:05.58,Default,,0,0,0,,Тек аналарға ыңғайсыздық туғызбайды
Dialogue: 0,0:11:10.50,0:11:11.50,Default,,0,0,0,,Иә
Dialogue: 0,0:11:20.80,0:11:23.76,Default,,0,0,0,,А... не?
Dialogue: 0,0:11:29.60,0:11:32.69,Default,,0,0,0,,Не? Тіркелген бірдеңе бар ма?
Dialogue: 0,0:11:34.23,0:11:35.65,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:12:08.72,0:12:10.10,Default,,0,0,0,,Уәде…
Dialogue: 0,0:12:11.81,0:12:12.81,Default,,0,0,0,,Байқап көрейік
Dialogue: 0,0:12:15.94,0:12:19.78,Default,,0,0,0,,Бір жылдан кейін Токиода міндетті түрде кездесеміз.
Dialogue: 0,0:12:28.83,0:12:30.91,Default,,0,0,0,,Оған дейін Янодан басқалардың бәрі...
Dialogue: 0,0:12:34.12,0:12:36.08,Default,,0,0,0,,Мені ешкім ұнатпайды
Dialogue: 0,0:12:42.26,0:12:43.38,Default,,0,0,0,,Ант етемін
Dialogue: 0,0:12:51.85,0:12:53.06,Default,,0,0,0,,Және…
Dialogue: 0,0:12:58.56,0:13:01.32,Default,,0,0,0,,Біз мұны білмей тұрып, біз...
Dialogue: 0,0:13:04.11,0:13:07.32,Default,,0,0,0,,Мен Нананың жасын басып оздым.
Dialogue: 0,0:13:18.33,0:13:19.75,Default,,0,0,0,,Күтпеңіз
Dialogue: 0,0:13:19.84,0:13:22.88,Default,,0,0,0,,Такеучи-кун өзін өте бақытты сезінеді.
Dialogue: 0,0:13:22.96,0:13:28.43,Default,,0,0,0,,Бірақ егер Такеучи-кун күтсе, бұл уақытты босқа өткізеді.
Dialogue: 0,0:13:32.52,0:13:34.85,Default,,0,0,0,,Жасыру...
Dialogue: 0,0:13:35.48,0:13:37.85,Default,,0,0,0,,Мен әлі жауап қажет емес дедім.
Dialogue: 0,0:13:37.94,0:13:39.69,Default,,0,0,0,,Сиқыр формуласын ашу
Dialogue: 0,0:13:40.52,0:13:43.44,Default,,0,0,0,,Енді мен одан басқа біреуге ғашық болуым керек пе?
Dialogue: 0,0:13:43.94,0:13:44.94,Default,,0,0,0,,Иә
Dialogue: 0,0:13:45.74,0:13:46.95,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:13:47.03,0:13:49.95,Default,,0,0,0,,Бір жылдан кейін де? Тіпті 5 жылдан кейін бе?
Dialogue: 0,0:13:51.49,0:13:54.08,Default,,0,0,0,,Неліктен сіз алда не күтіп тұрғанын біле аласыз деп ойлайсыз?
Dialogue: 0,0:13:54.75,0:13:56.96,Default,,0,0,0,,Өйткені мен уәде бердім
Dialogue: 0,0:13:58.04,0:13:58.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:59.92,0:14:01.17,Default,,0,0,0,,Мен...
Dialogue: 0,0:14:02.34,0:14:04.63,Default,,0,0,0,,Мен бір рет уәдемді бұздым.
Dialogue: 0,0:14:05.21,0:14:07.01,Default,,0,0,0,,Мен Яноны итеріп жібердім
Dialogue: 0,0:14:08.30,0:14:10.05,Default,,0,0,0,,Өйткені мен Яноға опасыздық жасадым
Dialogue: 0,0:14:13.68,0:14:16.93,Default,,0,0,0,,Такеучи-кун мені қорғағысы келетінін айтты.
Dialogue: 0,0:14:17.52,0:14:18.98,Default,,0,0,0,,Бірақ мен...
Dialogue: 0,0:14:20.48,0:14:23.11,Default,,0,0,0,,Менің ойымша, бұл жолы мен Яноны қорғағым келеді.
Dialogue: 0,0:14:29.49,0:14:30.36,Default,,0,0,0,,Сол жігіт мүлде есінен танып кетті – адамдар оны ұстап тұруға мәжбүр болды.
Dialogue: 0,0:14:31.16,0:14:33.62,Default,,0,0,0,,Мен Токиодағы университетке барамын.
Dialogue: 0,0:14:35.95,0:14:37.16,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:14:37.25,0:14:39.62,Default,,0,0,0,,Сіз жергілікті мемлекеттік мектепке баратыныңызды айттыңыз.
Dialogue: 0,0:14:40.21,0:14:41.92,Default,,0,0,0,,Маған бұл ауыл ұнамайды.
Dialogue: 0,0:14:42.42,0:14:44.59,Default,,0,0,0,,Мені жалғыз қалдырыңыз
Dialogue: 0,0:14:46.42,0:14:48.30,Default,,0,0,0,,Себебі мен Токиоға барамын...
Dialogue: 0,0:14:48.80,0:14:50.84,Default,,0,0,0,,Бұл «Барсам болады ма?» емес.
Dialogue: 0,0:14:52.05,0:14:55.85,Default,,0,0,0,,Токиода маған бір нәрсе керек...
Dialogue: 0,0:14:56.43,0:14:57.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:57.43,0:15:01.06,Default,,0,0,0,,Мен қатты қалайтын нәрсе...
Dialogue: 0,0:15:07.19,0:15:09.45,Default,,0,0,0,,Уау, қандай жүз!
Dialogue: 0,0:15:09.53,0:15:11.36,Default,,0,0,0,,Нана, сен сондай ұсқынсызсың.
Dialogue: 0,0:15:11.45,0:15:13.74,Default,,0,0,0,,Мен қатты жыладым...
Dialogue: 0,0:15:13.82,0:15:16.04,Default,,0,0,0,,Таңертең оянғанда осындай жағдай болды
Dialogue: 0,0:15:16.12,0:15:17.24,Default,,0,0,0,,Бұл бет қауіпті
Dialogue: 0,0:15:17.33,0:15:18.87,Default,,0,0,0,,Мен салқын лаваш сатып аламын.
Dialogue: 0,0:15:21.12,0:15:22.17,Default,,0,0,0,,Лалами ше?
Dialogue: 0,0:15:22.25,0:15:24.84,Default,,0,0,0,,Әзірше мен оны ата-анамның үйіне әжемнің қолына қалдырамын.
Dialogue: 0,0:15:24.92,0:15:25.88,Default,,0,0,0,,Күте тұрыңыз және қараңыз
Dialogue: 0,0:15:25.96,0:15:28.26,Default,,0,0,0,,Егер мен сені Токиодағы пәтерге апаратын болсам, болар едім.
Dialogue: 0,0:15:28.34,0:15:29.26,Default,,0,0,0,,Хмм.
Dialogue: 0,0:15:29.34,0:15:30.38,Default,,0,0,0,,Ah Мекенжай
Dialogue: 0,0:15:33.55,0:15:36.85,Default,,0,0,0,,Кавасаки? Бұл Токио емес.
Dialogue: 0,0:15:37.43,0:15:40.68,Default,,0,0,0,,Мектеп Токиода. Шибуя 30 минуттық жерде.
Dialogue: 0,0:15:40.77,0:15:41.89,Default,,0,0,0,,Иә
Dialogue: 0,0:15:41.98,0:15:44.19,Default,,0,0,0,,Ах, Мизугучи, Такахаши ше?
Dialogue: 0,0:15:44.27,0:15:46.36,Default,,0,0,0,,Жарайды... енді ваннада, сәл күте тұрыңыз.
Dialogue: 0,0:15:46.44,0:15:47.32,Default,,0,0,0,,Әй, әуре?
Dialogue: 0,0:15:47.40,0:15:48.90,Default,,0,0,0,,Тегі ұзақ. Бұл керемет
Dialogue: 0,0:15:50.40,0:15:51.95,Default,,0,0,0,,Ол не жеді?
Dialogue: 0,0:15:52.03,0:15:53.91,Default,,0,0,0,,Сіз шынымен мүлде қайтып келмейсіз бе?
Dialogue: 0,0:15:55.99,0:15:57.45,Default,,0,0,0,,Біз мұны көтере алмаймыз.
Dialogue: 0,0:15:57.53,0:15:59.79,Default,,0,0,0,,Жазғы демалыс және көктемгі демалыс?
Dialogue: 0,0:16:00.29,0:16:01.16,Default,,0,0,0,,Иә
Dialogue: 0,0:16:01.25,0:16:03.87,Default,,0,0,0,,Ең нашар~ Осындай күнде
Dialogue: 0,0:16:03.96,0:16:05.42,Default,,0,0,0,,Қызық, ісік төмендей ме?
Dialogue: 0,0:16:05.50,0:16:07.21,Default,,0,0,0,,Яно, сен оны іздемедің бе?
Dialogue: 0,0:16:07.29,0:16:09.42,Default,,0,0,0,,Жарайды, мен дұрыс алдадым.
Dialogue: 0,0:16:09.51,0:16:11.09,Default,,0,0,0,,Мизучинге рахмет
Dialogue: 0,0:16:11.17,0:16:12.68,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:16:14.05,0:16:18.18,Default,,0,0,0,,Сонымен, біз университетке қабылданғаннан кейін ғана бір-бірімізді шынымен кездестіре аламыз.
Dialogue: 0,0:16:18.68,0:16:21.64,Default,,0,0,0,,Қарашы, енді бәрі жақсы, жүр.
Dialogue: 0,0:16:23.14,0:16:26.11,Default,,0,0,0,,Негізі сіз дұрыс шешім қабылдадыңыз деп ойлаймын.
Dialogue: 0,0:16:30.57,0:16:33.07,Default,,0,0,0,,Жоқ, мен бәрібір жылаймын (Мизучин/Така-чан) Ах...
Dialogue: 0,0:16:33.15,0:16:38.08,Default,,0,0,0,,(Намидің жылағаны)
Dialogue: 0,0:16:39.45,0:16:41.58,Default,,0,0,0,,Сіз қаншалықты өкінесіз?
Dialogue: 0,0:16:41.66,0:16:46.08,Default,,0,0,0,,Мен бір нәрсені қайталауға тырысамын ба?
Dialogue: 0,0:16:47.46,0:16:50.59,Default,,0,0,0,,Барғың келе ме деп сұрағанда, әрине жоқ.
Dialogue: 0,0:16:51.21,0:16:54.17,Default,,0,0,0,,«Сіздің кетуіңіз жақсы ма?» Оның жақсы болуы мүмкін емес.
Dialogue: 0,0:16:55.72,0:16:59.22,Default,,0,0,0,,Мен әрқашан әйелімнің жанымда болуын талап еттім.
Dialogue: 0,0:16:59.72,0:17:03.14,Default,,0,0,0,,Ал мен сенен енді ешқашан көзімді алмаймын деп өзіме уәде бердім.
Dialogue: 0,0:17:05.85,0:17:06.98,Default,,0,0,0,,Сол күннен бастап
Dialogue: 0,0:17:15.07,0:17:16.41,Default,,0,0,0,,(Ино Хацусе) Қош келдіңіздер, Элькия патшасы, Лорд Сора, Лорд Широ.
Dialogue: 0,0:17:16.49,0:17:19.49,Default,,0,0,0,,Сен жоқта мен ешбір қимыл жасамаймын.
Dialogue: 0,0:17:19.58,0:17:22.49,Default,,0,0,0,,Ах! Мен неге сонша тәттімін!
Dialogue: 0,0:17:22.58,0:17:24.04,Default,,0,0,0,,Мен ақымақпын ба? Мен ақымақпын ба?
Dialogue: 0,0:17:24.79,0:17:28.00,Default,,0,0,0,,Бірақ иә, әділетсіздік сергітпейді.
Dialogue: 0,0:17:28.08,0:17:30.50,Default,,0,0,0,,Сізде баруға себеп бар.
Dialogue: 0,0:17:31.63,0:17:33.59,Default,,0,0,0,,Бірақ сіз сақтығыңызды түсірдіңіз.
Dialogue: 0,0:17:33.67,0:17:35.84,Default,,0,0,0,,Такахашиден шынымен көзіңді алсаң
Dialogue: 0,0:17:35.92,0:17:37.22,Default,,0,0,0,,Сол кезде...
Dialogue: 0,0:17:38.01,0:17:40.76,Default,,0,0,0,,Есіңде болсын, мен бәріңді бірден ұрлап кетемін.
Dialogue: 0,0:17:43.02,0:17:45.52,Default,,0,0,0,,Нағыз шайқас сол жаққа барғаннан кейін басталады.
Dialogue: 0,0:17:45.60,0:17:47.73,Default,,0,0,0,,Бір жылдан кейін күтіңіз
Dialogue: 0,0:17:53.15,0:17:54.49,Default,,0,0,0,,Иә
Dialogue: 0,0:17:54.57,0:17:56.65,Default,,0,0,0,,Неге сонша жеңілдедің?
Dialogue: 0,0:17:56.74,0:17:58.07,Default,,0,0,0,,Өйткені сен
Dialogue: 0,0:17:58.16,0:18:00.37,Default,,0,0,0,,Сіз бірге оқығыңыз келе ме, әлде кітапханаға барғыңыз келе ме?
Dialogue: 0,0:18:00.45,0:18:01.91,Default,,0,0,0,,Мен бұған шыдай алмаймын
Dialogue: 0,0:18:01.99,0:18:03.70,Default,,0,0,0,,Не? Ал, кеттік.
Dialogue: 0,0:18:03.79,0:18:04.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:04.70,0:18:06.96,Default,,0,0,0,,Сонымен, сіз жазғы фестивальге барасыз ба?
Dialogue: 0,0:18:07.71,0:18:10.54,Default,,0,0,0,,Жоқ, мен жеткілікті жасадым.
Dialogue: 0,0:18:10.63,0:18:12.59,Default,,0,0,0,,Жоқ, дос ретінде.
Dialogue: 0,0:18:12.67,0:18:14.09,Default,,0,0,0,,Жоқ, сіз білесіз...
Dialogue: 0,0:18:25.81,0:18:27.10,Default,,0,0,0,,Жақсы болайық
Dialogue: 0,0:18:27.18,0:18:28.56,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:18:37.11,0:18:38.57,Default,,0,0,0,,Қайда болсаңыз да
Dialogue: 0,0:18:40.74,0:18:43.91,Default,,0,0,0,,Қаншалықты жалғыздық, ауыртпалық болса да
Dialogue: 0,0:18:45.04,0:18:46.16,Default,,0,0,0,,Қайда...
Dialogue: 0,0:18:47.41,0:18:50.17,Default,,0,0,0,,Нанами не ойлап жатқанын ұмытпа.
Dialogue: 0,0:18:51.33,0:18:53.59,Default,,0,0,0,,Яно жалғыз емес.
Dialogue: 0,0:18:57.80,0:18:59.26,Default,,0,0,0,,...
Dialogue: 0,0:18:59.93,0:19:01.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:03.89,0:19:07.43,Default,,0,0,0,,Яноға шынымен ұнайтын адам енді болмауы мүмкін.
Dialogue: 0,0:19:07.52,0:19:09.48,Default,,0,0,0,,Мүмкін бұл жалғыз нәрсе шығар, бірақ
Dialogue: 0,0:19:09.56,0:19:10.89,Default,,0,0,0,,Бірақ Яно туралы
Dialogue: 0,0:19:10.98,0:19:13.61,Default,,0,0,0,,Ооо, саған қатты ұнайтын адам бар
Dialogue: 0,0:19:13.69,0:19:15.69,Default,,0,0,0,,Бұл Prama Zero емес пе?
Dialogue: 0,0:19:17.40,0:19:20.24,Default,,0,0,0,,Сондықтан өзіңізді жалғызбын деп ойламаңыз.
Dialogue: 0,0:19:27.62,0:19:28.91,Default,,0,0,0,,Бұл болмады.
Dialogue: 0,0:19:38.21,0:19:39.17,Default,,0,0,0,,Нөл емес
Dialogue: 0,0:19:40.76,0:19:43.22,Default,,0,0,0,,Pramy Plus… Бұл
Dialogue: 0,0:19:45.18,0:19:46.18,Default,,0,0,0,,болды
Dialogue: 0,0:19:49.52,0:19:54.40,Default,,0,0,0,,(Шығу қоңырауы)
Dialogue: 0,0:19:57.23,0:19:58.44,Default,,0,0,0,,Такахашимен
Dialogue: 0,0:20:00.03,0:20:01.24,Default,,0,0,0,,Біз кездескеннен кейін
Dialogue: 0,0:20:04.70,0:20:08.24,Default,,0,0,0,,Такахашимен кездесу үшін
Dialogue: 0,0:20:15.17,0:20:16.29,Default,,0,0,0,,Өмір сүрген
Dialogue: 0,0:21:50.43,0:21:55.02,Default,,0,0,0,,♪～
Dialogue: 0,0:22:20.29,0:22:21.92,Default,,0,0,0,,Біз, әрине
Dialogue: 0,0:22:22.88,0:22:23.84,Default,,0,0,0,,Осы жерде болды
Dialogue: 0,0:22:27.51,0:22:28.34,Default,,0,0,0,,Мұнда тұру...
Dialogue: 0,0:22:32.55,0:22:34.35,Default,,0,0,0,,Оған ғашық бол...
Dialogue: 0,0:22:38.19,0:22:39.69,Default,,0,0,0,,Мен сені жақсы көремін...
Dialogue: 0,0:22:43.90,0:22:46.07,Default,,0,0,0,,Көптеген алғашқылар
Dialogue: 0,0:22:49.20,0:22:51.36,Default,,0,0,0,,Мен сансыз сезімдерді алдым...
Dialogue: 0,0:22:55.91,0:22:57.33,Default,,0,0,0,,Күш
Dialogue: 0,0:22:58.21,0:22:59.71,Default,,0,0,0,,Өзіңіздің әлсіз жақтарыңызды біліңіз...
Dialogue: 0,0:23:11.13,0:23:14.81,Default,,0,0,0,,Шынымен... Шынымен...
Dialogue: 0,0:23:17.06,0:23:18.56,Default,,0,0,0,,Барлық оқтарыңды жауға беріңдер!!
Dialogue: 0,0:23:21.27,0:23:22.40,Default,,0,0,0,,Мұнда
Dialogue: 0,0:23:24.06,0:23:25.44,Default,,0,0,0,,болды
Dialogue: 0,0:25:00.95,0:25:05.96,Default,,0,0,0,,～♪
