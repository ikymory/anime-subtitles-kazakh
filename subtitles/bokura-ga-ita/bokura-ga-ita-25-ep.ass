Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.67,0:00:05.25,Default,,0,0,0,,өзімшілдікпен
Dialogue: 0,0:00:06.04,0:00:08.29,Default,,0,0,0,,Яноның адасып кеткенін байқамадым.
Dialogue: 0,0:00:08.38,0:00:10.30,Default,,0,0,0,,Өзіңізді жоғалтқаныңызды сезінбеңіз.
Dialogue: 0,0:00:11.26,0:00:13.30,Default,,0,0,0,,Менің Такахашиден кететін ойым жоқ.
Dialogue: 0,0:00:16.89,0:00:20.31,Default,,0,0,0,,Мен үшін алаңдама, жақсылап ойла
Dialogue: 0,0:00:22.98,0:00:26.69,Default,,0,0,0,,Яно үшін қазір не маңызды болуы керек?
Dialogue: 0,0:00:26.77,0:00:28.57,Default,,0,0,0,,Сіз шынымен не істегіңіз келеді?
Dialogue: 0,0:00:29.61,0:00:31.57,Default,,0,0,0,,Менде бәрі жақсы
Dialogue: 0,0:00:34.74,0:00:37.57,Default,,0,0,0,,Яно қандай таңдау жасаса да мен күтемін.
Dialogue: 0,0:00:38.16,0:00:40.49,Default,,0,0,0,,Себебі мен сені енді оңайлықпен тастамаймын
Dialogue: 0,0:00:42.16,0:00:47.17,Default,,0,0,0,,♪～
Dialogue: 0,0:02:08.04,0:02:12.92,Default,,0,0,0,,～♪
Dialogue: 0,0:02:15.21,0:02:17.17,Default,,0,0,0,,Қызыл кітапқа әлі ерте ме?
Dialogue: 0,0:02:17.26,0:02:19.68,Default,,0,0,0,,Өткен сұрақтар Кәне, қысқаша шолып көрейік.
Dialogue: 0,0:02:19.76,0:02:22.43,Default,,0,0,0,,J үлкен J үлкен
Dialogue: 0,0:02:22.51,0:02:24.60,Default,,0,0,0,,Әлі шешкен жоқсыз ба?
Dialogue: 0,0:02:25.56,0:02:27.31,Default,,0,0,0,,Сіз адасып қалдыңыз ба?
Dialogue: 0,0:02:28.06,0:02:30.06,Default,,0,0,0,,Иә (Нами) Рахмет.
Dialogue: 0,0:02:30.15,0:02:32.65,Default,,0,0,0,,Сіз маған әлі жауап берген жоқсыз
Dialogue: 0,0:02:32.73,0:02:35.69,Default,,0,0,0,,Менің ойымша, Яноның өзінше ойлайтыны бар.
Dialogue: 0,0:02:35.78,0:02:38.57,Default,,0,0,0,,Ағылшын тілі өте қиын деп естідім.
Dialogue: 0,0:02:38.65,0:02:41.78,Default,,0,0,0,,Тым көп болды ма деп біраз уайымдап тұрмын.
Dialogue: 0,0:02:41.87,0:02:42.82,Default,,0,0,0,,Аха, қайсысы?
Dialogue: 0,0:02:42.91,0:02:44.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:50.00,0:02:53.63,Default,,0,0,0,,Takahashi J University Егер оқуға қабылдансаңыз, мен сізді құрметтеймін.
Dialogue: 0,0:02:54.34,0:02:56.92,Default,,0,0,0,,Біраз құрмет көрсетейік, солай ма?
Dialogue: 0,0:02:57.01,0:02:59.51,Default,,0,0,0,,X күні - Рождество
Dialogue: 0,0:02:59.59,0:03:02.43,Default,,0,0,0,,Не? Егер Яно көшетін болса, ол 24-те болар еді, солай емес пе?
Dialogue: 0,0:03:02.51,0:03:04.43,Default,,0,0,0,,Әлі де жауап бермедіңіз бе?
Dialogue: 0,0:03:04.51,0:03:05.60,Default,,0,0,0,,Иә...
Dialogue: 0,0:03:05.68,0:03:08.43,Default,,0,0,0,,Желтоқсан айы. Жарайды ма?
Dialogue: 0,0:03:08.93,0:03:09.77,Default,,0,0,0,,Бірақ
Dialogue: 0,0:03:09.85,0:03:12.69,Default,,0,0,0,,Яноға баруын айтқан мен болдым.
Dialogue: 0,0:03:12.77,0:03:14.73,Default,,0,0,0,,Өйткені сенуден басқа амалым жоқ
Dialogue: 0,0:03:14.81,0:03:16.40,Default,,0,0,0,,Және төтенше жағдайда
Dialogue: 0,0:03:16.48,0:03:19.36,Default,,0,0,0,,Мен бір жыл ғана боламын, сондықтан мен дайынмын.
Dialogue: 0,0:03:19.99,0:03:22.36,Default,,0,0,0,,Иә, бар болғаны бір жыл
Dialogue: 0,0:03:22.45,0:03:23.28,Default,,0,0,0,,Бірақ Яноның ауысатыны әлі шешілген жоқ.
Dialogue: 0,0:03:23.28,0:03:24.45,Default,,0,0,0,,Бірақ Яноның ауысатыны әлі шешілген жоқ.
Dialogue: 0,0:03:23.28,0:03:24.45,Default,,0,0,0,,Қалай болғанда да
Dialogue: 0,0:03:24.45,0:03:24.53,Default,,0,0,0,,Бірақ Яноның ауысатыны әлі шешілген жоқ.
Dialogue: 0,0:03:24.53,0:03:26.24,Default,,0,0,0,,Бірақ Яноның ауысатыны әлі шешілген жоқ.
Dialogue: 0,0:03:24.53,0:03:26.24,Default,,0,0,0,,Ағылшын тілі ұзақ сөйлемдерді нашар оқудан басталады.
Dialogue: 0,0:03:26.24,0:03:26.33,Default,,0,0,0,,Бірақ Яноның ауысатыны әлі шешілген жоқ.
Dialogue: 0,0:03:26.33,0:03:26.78,Default,,0,0,0,,Бірақ Яноның ауысатыны әлі шешілген жоқ.
Dialogue: 0,0:03:26.33,0:03:26.78,Default,,0,0,0,,Оны киген дұрыс емес пе?
Dialogue: 0,0:03:26.78,0:03:27.66,Default,,0,0,0,,Оны киген дұрыс емес пе?
Dialogue: 0,0:03:27.74,0:03:28.58,Default,,0,0,0,,Иә
Dialogue: 0,0:03:30.71,0:03:32.62,Default,,0,0,0,,Яно (Яно) Иә?
Dialogue: 0,0:03:32.71,0:03:35.63,Default,,0,0,0,,Сізге H университетін (Яно) қабылдаудың қажеті жоқ па?
Dialogue: 0,0:03:37.00,0:03:39.84,Default,,0,0,0,,Кешіріңіз, мен сауалнама формасын көрдім.
Dialogue: 0,0:03:39.92,0:03:42.26,Default,,0,0,0,,Ұлттық және мемлекеттік мектептерге түсу туралы не деуге болады?
Dialogue: 0,0:03:42.34,0:03:44.39,Default,,0,0,0,,Олай жасасаңыз, қуып жете алмайсыз⸺
Dialogue: 0,0:03:44.47,0:03:46.05,Default,,0,0,0,,Екеуміз де құлаймыз (Яно) Жарайды.
Dialogue: 0,0:03:46.14,0:03:51.31,Default,,0,0,0,,Такахаши, тек өзің туралы ойла және қазір қолыңнан келгенін істе.
Dialogue: 0,0:03:52.89,0:03:55.02,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:03:59.61,0:04:02.95,Default,,0,0,0,,Алдау! Яно алдау, алдау!
Dialogue: 0,0:04:03.03,0:04:03.86,Default,,0,0,0,,Не?
Dialogue: 0,0:04:03.95,0:04:05.24,Default,,0,0,0,,Әрқашан
Dialogue: 0,0:04:06.20,0:04:08.08,Default,,0,0,0,,Мықтап ұстаңыз
Dialogue: 0,0:04:09.20,0:04:10.95,Default,,0,0,0,,Себебі бұл көңілсіз
Dialogue: 0,0:04:11.04,0:04:13.83,Default,,0,0,0,,Мен міндетті түрде университетте аянбай еңбек етемін.
Dialogue: 0,0:04:15.08,0:04:16.08,Default,,0,0,0,,(тұру дыбысы)
Dialogue: 0,0:04:16.17,0:04:17.25,Default,,0,0,0,,Йоцуба тобы, Токио қаласындағы бас кеңсе
Dialogue: 0,0:04:17.34,0:04:18.34,Default,,0,0,0,,Иә
Dialogue: 0,0:04:19.21,0:04:21.46,Default,,0,0,0,,(мырылдаған дауыс)
Dialogue: 0,0:04:21.55,0:04:23.17,Default,,0,0,0,,Хмм…
Dialogue: 0,0:04:42.44,0:04:43.32,Default,,0,0,0,,Такахаши
Dialogue: 0,0:04:43.40,0:04:45.32,Default,,0,0,0,,Ах (Яно) Жалқау болмаңыз.
Dialogue: 0,0:04:45.41,0:04:47.87,Default,,0,0,0,,Эй... Мен дұрыс істеп жатырмын.
Dialogue: 0,0:04:49.20,0:04:50.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:50.95,0:04:55.87,Default,,0,0,0,,Бір жыл аралығы қанша уақыт?
Dialogue: 0,0:04:57.54,0:04:59.88,Default,,0,0,0,,Кенет салқындап кетті.
Dialogue: 0,0:04:59.96,0:05:02.63,Default,,0,0,0,,Иә? Бұл әдеттегідей емес пе?
Dialogue: 0,0:05:04.17,0:05:05.59,Default,,0,0,0,,Мүмкін...
Dialogue: 0,0:05:05.68,0:05:08.80,Default,,0,0,0,,Неліктен Яноның қолдары әрқашан жылы?
Dialogue: 0,0:05:08.89,0:05:10.85,Default,,0,0,0,,Оның жүрегі бар ма еді...
Dialogue: 0,0:05:10.93,0:05:12.60,Default,,0,0,0,,Иә? (Нами) Кері
Dialogue: 0,0:05:12.68,0:05:14.60,Default,,0,0,0,,Ха... Сонда Такахашидің қолдары ше?
Dialogue: 0,0:05:15.39,0:05:16.85,Default,,0,0,0,,Неліктен үнемі суық?
Dialogue: 0,0:05:16.94,0:05:18.60,Default,,0,0,0,,Себебі менің жүрегім жылы
Dialogue: 0,0:05:18.69,0:05:21.11,Default,,0,0,0,,Бухаха (Нанами) Неге күлесің?
Dialogue: 0,0:05:26.57,0:05:28.61,Default,,0,0,0,,Эй, мен сені жақсы жерге апарамын.
Dialogue: 0,0:05:28.70,0:05:29.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:29.95,0:05:32.49,Default,,0,0,0,,Күні кеше мен Такахашиге ұқсайтын нәрсені таптым.
Dialogue: 0,0:05:32.58,0:05:34.62,Default,,0,0,0,,Әйтеуір тағы да солай.
Dialogue: 0,0:05:37.04,0:05:38.29,Default,,0,0,0,,Бұл ит.
Dialogue: 0,0:05:38.37,0:05:40.21,Default,,0,0,0,,Көздің арасы ғажап.
Dialogue: 0,0:05:41.38,0:05:42.96,Default,,0,0,0,,Сүйкімді
Dialogue: 0,0:05:43.55,0:05:44.67,Default,,0,0,0,,Біз оны аламыз ба?
Dialogue: 0,0:05:50.18,0:05:53.06,Default,,0,0,0,,Ешқандай проблема жоқ, бұл ақшаны босқа шашу болар еді.
Dialogue: 0,0:05:53.14,0:05:54.68,Default,,0,0,0,,Мен оны бір рет түсіремін бе?
Dialogue: 0,0:05:55.18,0:05:56.06,Default,,0,0,0,,Қызық
Dialogue: 0,0:05:57.39,0:05:58.60,Default,,0,0,0,,уәде берді
Dialogue: 0,0:06:01.44,0:06:04.86,Default,,0,0,0,,Жауап қандай болса да, Яноға сенемін.
Dialogue: 0,0:06:05.90,0:06:07.86,Default,,0,0,0,,Мен өзіме ант бердім
Dialogue: 0,0:06:08.57,0:06:10.45,Default,,0,0,0,,Яноны қолдау
Dialogue: 0,0:06:12.33,0:06:13.62,Default,,0,0,0,,Бірақ қазір
Dialogue: 0,0:06:14.70,0:06:19.21,Default,,0,0,0,,Яноның алақанының жылуы мені адастыра бастайды.
Dialogue: 0,0:06:20.54,0:06:22.17,Default,,0,0,0,,Бұл сізге ұқсамайды.
Dialogue: 0,0:06:23.42,0:06:25.46,Default,,0,0,0,,Еш ойланбаңыз және шешім қабылдай алмайсыз.
Dialogue: 0,0:06:26.51,0:06:28.97,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:06:29.68,0:06:33.47,Default,,0,0,0,,Қандай таңдау жасасаңыз да, өкінесіз.
Dialogue: 0,0:06:33.55,0:06:35.43,Default,,0,0,0,,(Лаламидің айқайы)
Dialogue: 0,0:06:36.02,0:06:38.68,Default,,0,0,0,,Сонда қайсысын таңдасаң да бәрібір, солай емес пе?
Dialogue: 0,0:06:39.69,0:06:40.69,Default,,0,0,0,,Эй
Dialogue: 0,0:06:42.02,0:06:46.15,Default,,0,0,0,,Егер сен мені тым көп мазақ етсең, Такахаши, бұл шаршатады.
Dialogue: 0,0:06:46.23,0:06:48.99,Default,,0,0,0,,Бұл қатыгез, бірақ баратын болсаң, кет де.
Dialogue: 0,0:06:49.07,0:06:50.99,Default,,0,0,0,,(Лаламидің үрген дауысы)
Dialogue: 0,0:06:52.82,0:06:53.99,Default,,0,0,0,,Сол жігіт
Dialogue: 0,0:06:54.58,0:06:57.12,Default,,0,0,0,,Сіз әдетте жылай бермейсіз, солай ма?
Dialogue: 0,0:06:57.83,0:06:59.33,Default,,0,0,0,,Сонымен қайсысы?
Dialogue: 0,0:06:59.41,0:07:01.71,Default,,0,0,0,,Жағдай үшін ең жақсысын жасаңыз, солай ма?
Dialogue: 0,0:07:02.96,0:07:04.67,Default,,0,0,0,,Себебі мен толық емес отбасымын
Dialogue: 0,0:07:06.17,0:07:07.26,Default,,0,0,0,,Такахаши өзін ұстанды
Dialogue: 0,0:07:10.01,0:07:12.76,Default,,0,0,0,,Бұл біртүрлі оқиға.
Dialogue: 0,0:07:12.84,0:07:16.18,Default,,0,0,0,,Ол ересек адам былай тұрсын, бала да емес, 42 жастағы әйел ғой, солай ма?
Dialogue: 0,0:07:16.26,0:07:17.93,Default,,0,0,0,,Мен сені жалғыз қалдыра алмаймын
Dialogue: 0,0:07:18.43,0:07:20.23,Default,,0,0,0,,Бір жыл ғана болды.
Dialogue: 0,0:07:20.31,0:07:24.44,Default,,0,0,0,,Рұқсатсыз үйленіп, рұқсатсыз ажырасып, қуана жұмысқа орналасады.
Dialogue: 0,0:07:25.11,0:07:27.65,Default,,0,0,0,,Ұлымның тестілеуші ​​болып кетуі мені қызықтырмайды.
Dialogue: 0,0:07:27.73,0:07:29.28,Default,,0,0,0,,Сол бір жыл...
Dialogue: 0,0:07:29.36,0:07:30.19,Default,,0,0,0,,(Лаламидің үрген дауысы)
Dialogue: 0,0:07:30.82,0:07:32.66,Default,,0,0,0,,Неліктен мен ажырасуды күте алмадым?
Dialogue: 0,0:07:32.74,0:07:36.37,Default,,0,0,0,,Сенің анаң сенімен бірге келуіңді өтінген жоқ, солай ма?
Dialogue: 0,0:07:39.58,0:07:41.87,Default,,0,0,0,,Анам: «Менімен бірге келгеніңді қалаймын» деді.
Dialogue: 0,0:07:41.96,0:07:43.50,Default,,0,0,0,,Үнсіз үндеу тыңдаңыз
Dialogue: 0,0:07:44.75,0:07:47.46,Default,,0,0,0,,Такахашидің «Мен сенің кеткеніңді қаламаймын».
Dialogue: 0,0:07:47.55,0:07:49.01,Default,,0,0,0,,Мен естімегендей болып тұрмын ба?
Dialogue: 0,0:07:54.09,0:07:55.43,Default,,0,0,0,,Бұл сұмдық
Dialogue: 0,0:07:56.60,0:08:01.10,Default,,0,0,0,,Әлде Такахаши шынымен мықты жігіт пе?
Dialogue: 0,0:08:02.14,0:08:06.27,Default,,0,0,0,,Кез келген жағдайда, сіз Такахашимен уақыт өткізесіз бе?
Dialogue: 0,0:08:06.36,0:08:09.78,Default,,0,0,0,,Мен сіз Такахаши өкіне бастайтынын білмеймін деп ойламадым.
Dialogue: 0,0:08:09.86,0:08:11.82,Default,,0,0,0,,Шешімді кейінге қалдыру...
Dialogue: 0,0:08:15.32,0:08:18.37,Default,,0,0,0,,Егер Такахаши «барма» десе
Dialogue: 0,0:08:19.66,0:08:21.54,Default,,0,0,0,,Мен бара алмайтын шығармын.
Dialogue: 0,0:08:27.75,0:08:29.38,Default,,0,0,0,,Такахаши (Нами) Иә.
Dialogue: 0,0:08:29.46,0:08:31.09,Default,,0,0,0,,Бүгін кітапханаға барасың ба?
Dialogue: 0,0:08:31.17,0:08:32.97,Default,,0,0,0,,А, м.
Dialogue: 0,0:08:33.05,0:08:36.01,Default,,0,0,0,,Менің комитет отырысым бар, сондықтан алдымен үйге баруым керек, сондықтан уақыт керек.
Dialogue: 0,0:08:36.97,0:08:37.80,Default,,0,0,0,,Жоқ. Сенің мақсатың не екенін білмеймін, бірақ бұл күмәнді.
Dialogue: 0,0:08:37.89,0:08:39.89,Default,,0,0,0,,Хмм... кешіріңіз.
Dialogue: 0,0:08:42.14,0:08:46.65,Default,,0,0,0,,Сыйлықты тезірек дайындауым керек пе?
Dialogue: 0,0:08:48.40,0:08:49.27,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:49.36,0:08:51.78,Default,,0,0,0,,Олай болса ата-анаңмен дұрыс сөйлесу керек.
Dialogue: 0,0:08:52.86,0:08:53.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:59.78,0:09:01.79,Default,,0,0,0,,Мұғалімнің күнделігі
Dialogue: 0,0:09:01.87,0:09:03.20,Default,,0,0,0,,О, бұл қиын жұмыс.
Dialogue: 0,0:09:04.83,0:09:07.38,Default,,0,0,0,,Сол жабылу салтанаты...
Dialogue: 0,0:09:07.88,0:09:11.13,Default,,0,0,0,,Әдеттегідей 24 желтоқсан.
Dialogue: 0,0:09:11.21,0:09:13.97,Default,,0,0,0,,Жарайды... дұрыс.
Dialogue: 0,0:09:18.09,0:09:21.35,Default,,0,0,0,,Қазіргі уақытта ешкім тасымалдау туралы хабарлама жіберген жоқ.
Dialogue: 0,0:09:25.60,0:09:28.69,Default,,0,0,0,,Неліктен... өзіңді жеңілдеп қалдың ба?
Dialogue: 0,0:09:28.77,0:09:30.86,Default,,0,0,0,,Сіз дайын болдыңыз, солай емес пе?
Dialogue: 0,0:09:31.94,0:09:32.94,Default,,0,0,0,,Бірақ
Dialogue: 0,0:09:33.44,0:09:35.65,Default,,0,0,0,,Бір жыл ұзақ уақыт
Dialogue: 0,0:09:36.36,0:09:39.16,Default,,0,0,0,,Көп, мен күткеннен әлдеқайда ұзағырақ
Dialogue: 0,0:09:39.24,0:09:40.37,Default,,0,0,0,,Бұл ұзақ
Dialogue: 0,0:09:45.96,0:09:46.58,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:09:46.58,0:09:47.42,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:09:46.58,0:09:47.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:47.50,0:09:50.96,Default,,0,0,0,,Нанаға не болды, оны осындай уақытта көру ерекше?
Dialogue: 0,0:09:51.54,0:09:53.71,Default,,0,0,0,,Хе... сәл ғана...
Dialogue: 0,0:09:53.80,0:09:54.92,Default,,0,0,0,,Кіріңіз, кіріңіз
Dialogue: 0,0:09:55.51,0:09:57.47,Default,,0,0,0,,Какао жақсы ма? (Нами) мен сені жақсы көремін
Dialogue: 0,0:09:57.55,0:10:00.55,Default,,0,0,0,,Бүгін мен бірнеше сыйлық идеяларын таптым.
Dialogue: 0,0:10:00.64,0:10:01.72,Default,,0,0,0,,Көрсет, көрсет
Dialogue: 0,0:10:02.31,0:10:05.14,Default,,0,0,0,,Ах, бұл аксессуар Яноға ұқсайды.
Dialogue: 0,0:10:05.22,0:10:06.93,Default,,0,0,0,,Шынымен бе? Бұл жақсы деп ойлайсыз ба?
Dialogue: 0,0:10:07.02,0:10:09.77,Default,,0,0,0,,Білесің бе, қыздарға арналған жұп та бар.
Dialogue: 0,0:10:09.85,0:10:12.15,Default,,0,0,0,,Мен осы уақытқа дейін сәйкестікке қызықпадым.
Dialogue: 0,0:10:12.23,0:10:13.69,Default,,0,0,0,,Қызық, бұл бірдеңе ме?
Dialogue: 0,0:10:13.77,0:10:15.99,Default,,0,0,0,,Күнделікті киюге болады
Dialogue: 0,0:10:16.07,0:10:18.70,Default,,0,0,0,,Біз бірге болмасақ та есіңе түсіресің, солай ма?
Dialogue: 0,0:10:20.99,0:10:23.66,Default,,0,0,0,,Ах... мысалы!
Dialogue: 0,0:10:23.74,0:10:28.25,Default,,0,0,0,,Үйде 24 сағат бірге болу жақсы емес пе?
Dialogue: 0,0:10:28.33,0:10:29.17,Default,,0,0,0,,Иә
Dialogue: 0,0:10:37.63,0:10:39.05,Default,,0,0,0,,Мизучин
Dialogue: 0,0:10:39.13,0:10:42.05,Default,,0,0,0,,Мен өкінемін...
Dialogue: 0,0:10:42.14,0:10:43.26,Default,,0,0,0,,Нана…
Dialogue: 0,0:10:43.35,0:10:45.06,Default,,0,0,0,,Мен саған кет дедім.
Dialogue: 0,0:10:45.81,0:10:47.39,Default,,0,0,0,,Мен өкінемін
Dialogue: 0,0:10:47.93,0:10:50.06,Default,,0,0,0,,Не істеуім керек...
Dialogue: 0,0:10:50.90,0:10:53.77,Default,,0,0,0,,Мен мүлде ештеңе түсінбедім.
Dialogue: 0,0:10:53.86,0:10:56.44,Default,,0,0,0,,Бұл Яноның жоқ болатынын білдіреді.
Dialogue: 0,0:11:01.45,0:11:03.57,Default,,0,0,0,,Яномен кездесе алмау
Dialogue: 0,0:11:04.58,0:11:09.91,Default,,0,0,0,,Мен Яносыз әлемді елестете алмаймын.
Dialogue: 0,0:11:15.63,0:11:19.51,Default,,0,0,0,,Бұл Яноның жоқ болатынын білдіреді. Бұл Яномен кездесе алмайтынымды білдіреді.
Dialogue: 0,0:11:19.59,0:11:21.47,Default,,0,0,0,,Мен білмедім
Dialogue: 0,0:11:22.68,0:11:25.43,Default,,0,0,0,,Мен Яносыз әлемді елестете алмаймын.
Dialogue: 0,0:11:25.93,0:11:30.85,Default,,0,0,0,,Бірақ қазір түсінсең де, кеш...
Dialogue: 0,0:11:32.77,0:11:33.85,Default,,0,0,0,,Уау...
Dialogue: 0,0:11:33.94,0:11:35.40,Default,,0,0,0,,Такеучи мырза
Dialogue: 0,0:11:35.48,0:11:36.98,Default,,0,0,0,,Осындай жерде оқисың ба?
Dialogue: 0,0:11:37.07,0:11:38.57,Default,,0,0,0,,Яно, мен күтіп тұрғанда.
Dialogue: 0,0:11:38.65,0:11:40.11,Default,,0,0,0,,Уау сөз тіркесі?
Dialogue: 0,0:11:40.19,0:11:42.11,Default,,0,0,0,,Бұл өте жақсы.
Dialogue: 0,0:11:42.20,0:11:44.20,Default,,0,0,0,,Ахаха керемет
Dialogue: 0,0:11:48.12,0:11:48.95,Default,,0,0,0,,Қалайсың?
Dialogue: 0,0:11:50.16,0:11:51.29,Default,,0,0,0,,Иә
Dialogue: 0,0:11:51.37,0:11:53.37,Default,,0,0,0,,Дұрысы, отыр, отыр.
Dialogue: 0,0:11:53.46,0:11:54.29,Default,,0,0,0,,Бір ай бойы бірдей нәрсені естіп жүрсең, ештеңе сезбей қаласың.
Dialogue: 0,0:12:11.18,0:12:12.77,Default,,0,0,0,,(ағылшынша)
Dialogue: 0,0:12:12.85,0:12:13.94,Default,,0,0,0,,Орындалды.
Dialogue: 0,0:12:14.02,0:12:15.86,Default,,0,0,0,,Бірақ бұл әлі 2-бөлім.
Dialogue: 0,0:12:16.44,0:12:17.98,Default,,0,0,0,,Бірден осындай нәрсе
Dialogue: 0,0:12:25.07,0:12:27.28,Default,,0,0,0,,Иә? Не... не?
Dialogue: 0,0:12:27.37,0:12:31.41,Default,,0,0,0,,Қалаған мектеп Сіздің үлкен үмітіңіз таң қалды ма? Менің ойымша, бұл тамаша емес ...
Dialogue: 0,0:12:31.50,0:12:34.75,Default,,0,0,0,,Менің ойымша, бұрынғы мәлімдемеңізден бас тарту өте жақсы.
Dialogue: 0,0:12:36.58,0:12:39.92,Default,,0,0,0,,Алдыңғы мәлімдеме... кері қайтарылды ма?
Dialogue: 0,0:12:43.80,0:12:46.22,Default,,0,0,0,,Ах, Яно, кешігіп қалдың.
Dialogue: 0,0:12:46.30,0:12:47.39,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:12:47.47,0:12:50.64,Default,,0,0,0,,Эй, мен 2-бөлімді аяқтауға жақын қалдым.
Dialogue: 0,0:12:50.72,0:12:52.10,Default,,0,0,0,,А, жуынатын бөлмеге бар.
Dialogue: 0,0:12:55.64,0:12:57.40,Default,,0,0,0,,Мен жай ғана сұрақтар қойдым.
Dialogue: 0,0:12:58.44,0:12:59.65,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:12:59.73,0:13:02.03,Default,,0,0,0,,Ал, сен кеткенде
Dialogue: 0,0:13:02.11,0:13:03.86,Default,,0,0,0,,Күнделікті өмір осылай болады.
Dialogue: 0,0:13:16.46,0:13:17.33,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:20.38,0:13:23.96,Default,,0,0,0,,Менің ойымша, бұрынғы мәлімдемеңізді қайтарып алу өте жақсы.
Dialogue: 0,0:13:24.05,0:13:27.13,Default,,0,0,0,,Жоқ, жоқ, қажетсіз нәрселер туралы ойламаңыз!
Dialogue: 0,0:13:29.22,0:13:33.10,Default,,0,0,0,,Мүмкін мен оны уақытында жасай аламын...
Dialogue: 0,0:13:34.73,0:13:35.64,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:13:35.64,0:13:36.52,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:13:35.64,0:13:36.52,Default,,0,0,0,,Ха…
Dialogue: 0,0:13:36.52,0:13:38.02,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:13:38.10,0:13:40.06,Default,,0,0,0,,Би... Мен таң қалдым.
Dialogue: 0,0:13:40.15,0:13:41.11,Default,,0,0,0,,Yahoo
Dialogue: 0,0:13:41.19,0:13:43.94,Default,,0,0,0,,Иә я... yahoo
Dialogue: 0,0:13:44.03,0:13:44.99,Default,,0,0,0,,Сіз дәл қазір не істеп жатырсыз?
Dialogue: 0,0:13:45.07,0:13:45.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:45.99,0:13:49.45,Default,,0,0,0,,Мен бір нәрсені ақымақ деп ойладым Мен бір нәрсені ақымақ деп ойладым
Dialogue: 0,0:13:49.53,0:13:50.87,Default,,0,0,0,,Эй, сыртқа қарашы.
Dialogue: 0,0:13:50.95,0:13:51.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:53.91,0:13:55.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:57.12,0:13:57.96,Default,,0,0,0,,Сәлем
Dialogue: 0,0:13:58.04,0:13:59.79,Default,,0,0,0,,Әй, қалай ойлайсың, сағат неше?
Dialogue: 0,0:14:00.46,0:14:02.55,Default,,0,0,0,,Аналарың білсе, саған ашуланады.
Dialogue: 0,0:14:02.63,0:14:04.17,Default,,0,0,0,,Тезірек саябаққа барайық.
Dialogue: 0,0:14:04.26,0:14:06.01,Default,,0,0,0,,Қайда? (Нами) Тынш! қатты дауыс
Dialogue: 0,0:14:06.09,0:14:07.63,Default,,0,0,0,,Неге келдің?
Dialogue: 0,0:14:07.72,0:14:10.26,Default,,0,0,0,,Автобус! (Нами) Автобус? Бұл соңы емес
Dialogue: 0,0:14:10.34,0:14:11.47,Default,,0,0,0,,(Батырма басылған дыбысы)
Dialogue: 0,0:14:12.85,0:14:15.18,Default,,0,0,0,,Неліктен осы сағатта кенеттен...
Dialogue: 0,0:14:16.35,0:14:20.77,Default,,0,0,0,,Жауабын тапқан шығармын...
Dialogue: 0,0:14:25.53,0:14:26.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:37.71,0:14:38.71,Default,,0,0,0,,(шу)
Dialogue: 0,0:14:39.21,0:14:40.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:49.68,0:14:51.72,Default,,0,0,0,,Жоқ, менде кофе бар...
Dialogue: 0,0:14:51.80,0:14:52.93,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:14:53.60,0:14:54.64,Default,,0,0,0,,Кешіріңіз Такахаши
Dialogue: 0,0:14:54.72,0:14:57.35,Default,,0,0,0,,Басқа адамдардың сезімін білмеу
Dialogue: 0,0:14:57.98,0:14:59.52,Default,,0,0,0,,Такахаши (Нанами)...
Dialogue: 0,0:14:59.60,0:15:02.23,Default,,0,0,0,,Егер мен...
Dialogue: 0,0:15:11.53,0:15:13.45,Default,,0,0,0,,Егер мен
Dialogue: 0,0:15:14.07,0:15:17.12,Default,,0,0,0,,Мен өскенде менде ештеңе жоқ.
Dialogue: 0,0:15:17.20,0:15:20.04,Default,,0,0,0,,Мен сені менімен бір ғана сөмкемен баруыңды сұрағанымда.
Dialogue: 0,0:15:20.12,0:15:21.46,Default,,0,0,0,,Келесің бе?
Dialogue: 0,0:15:25.29,0:15:28.26,Default,,0,0,0,,Бұл неке туралы ұсыныс.
Dialogue: 0,0:15:28.34,0:15:29.17,Default,,0,0,0,,Хаха…
Dialogue: 0,0:15:31.18,0:15:32.18,Default,,0,0,0,,(Барлығы төрт адам) Һмм? (JoJo) Дерби?
Dialogue: 0,0:15:34.35,0:15:35.76,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:15:36.26,0:15:38.72,Default,,0,0,0,,Есімнен адасып қалдым, ақымақ.
Dialogue: 0,0:15:38.81,0:15:41.52,Default,,0,0,0,,Ересек адам неше жаста? Жиырма жаста?
Dialogue: 0,0:15:41.60,0:15:43.06,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:15:43.15,0:15:47.19,Default,,0,0,0,,Ата-анаңның қамқорлығынсыз өмір сүре алсаң ше?
Dialogue: 0,0:15:49.15,0:15:51.45,Default,,0,0,0,,Тез ересек адам болыңыз
Dialogue: 0,0:15:55.20,0:15:56.95,Default,,0,0,0,,Тез өсу
Dialogue: 0,0:15:57.45,0:16:00.87,Default,,0,0,0,,Қорғаушы болудың орнына мен оны қорғайтын боламын.
Dialogue: 0,0:16:00.96,0:16:02.92,Default,,0,0,0,,Ешкімнің шағымдануына жол бермеңіз
Dialogue: 0,0:16:03.67,0:16:05.50,Default,,0,0,0,,Ешкім мені мұңайтпайды
Dialogue: 0,0:16:05.58,0:16:10.13,Default,,0,0,0,,Аналар, отбасылар және әйелдер абсолютті
Dialogue: 0,0:16:10.92,0:16:14.05,Default,,0,0,0,,Өзіңізді толығымен қорғай алатын адам болыңыз
Dialogue: 0,0:16:25.56,0:16:26.56,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:28.36,0:16:30.03,Default,,0,0,0,,Менің сүйіктім
Dialogue: 0,0:16:30.94,0:16:35.11,Default,,0,0,0,,Ай сәулесінің астында ернім сәл дірілдеп кетті.
Dialogue: 0,0:16:36.70,0:16:38.33,Default,,0,0,0,,Кешіріңіз Яно
Dialogue: 0,0:16:38.83,0:16:39.87,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:41.50,0:16:46.58,Default,,0,0,0,,Бір сәтке болса да дірілдеп қалғаныма ұялдым.
Dialogue: 0,0:16:49.04,0:16:53.80,Default,,0,0,0,,Жарқыраған қыс аспаны жүрегімді сынағандай
Dialogue: 0,0:16:54.55,0:16:58.93,Default,,0,0,0,,Бұл пайда болған ой құрметсіздік пе?
Dialogue: 0,0:17:00.51,0:17:03.27,Default,,0,0,0,,Мен ол үшін өмір сүргім келеді
Dialogue: 0,0:17:09.11,0:17:09.94,Default,,0,0,0,,(Гета қорапшасының есігінің жабылу дыбысы)
Dialogue: 0,0:17:10.77,0:17:11.61,Default,,0,0,0,,Юбе?
Dialogue: 0,0:17:11.69,0:17:12.82,Default,,0,0,0,,Иә
Dialogue: 0,0:17:18.78,0:17:21.24,Default,,0,0,0,,Түс көргенім есімде (Нами) Түс пе?
Dialogue: 0,0:17:21.33,0:17:23.58,Default,,0,0,0,,Қане бәріміз бамбук өсінділеріне шулайық
Dialogue: 0,0:17:23.66,0:17:26.92,Default,,0,0,0,,Біраз ұйықтап қалсам, түсімде Такахаши көрінді.
Dialogue: 0,0:17:27.67,0:17:31.30,Default,,0,0,0,,Есептер жинағы жасап жатқанда мен ашуланып, бұл дұрыс емес дедім.
Dialogue: 0,0:17:31.38,0:17:33.26,Default,,0,0,0,,Неге екені белгісіз, мені шапалақпен ұрды.
Dialogue: 0,0:17:33.76,0:17:35.67,Default,,0,0,0,,Қандай қызық түс.
Dialogue: 0,0:17:36.59,0:17:37.76,Default,,0,0,0,,Иә
Dialogue: 0,0:17:37.84,0:17:39.68,Default,,0,0,0,,Такахаши жылап отырды
Dialogue: 0,0:17:41.89,0:17:44.02,Default,,0,0,0,,«Мен өкінемін»
Dialogue: 0,0:17:44.68,0:17:47.10,Default,,0,0,0,,«Шындығында мен түсінбедім.»
Dialogue: 0,0:17:49.15,0:17:50.81,Default,,0,0,0,,Сіз не үшін өкіндіңіз?
Dialogue: 0,0:18:00.95,0:18:01.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:03.91,0:18:05.25,Default,,0,0,0,,Қазір...
Dialogue: 0,0:18:07.58,0:18:08.83,Default,,0,0,0,,Уақыт бойынша
Dialogue: 0,0:18:14.92,0:18:16.17,Default,,0,0,0,,Қазір
Dialogue: 0,0:18:17.38,0:18:18.38,Default,,0,0,0,,Жарайды, операцияны басынан бастауға тура келеді.
Dialogue: 0,0:18:28.52,0:18:31.31,Default,,0,0,0,,Демек, бұл арман
Dialogue: 0,0:18:31.40,0:18:33.86,Default,,0,0,0,,Мен ештеңеге өкінбеймін
Dialogue: 0,0:18:33.94,0:18:37.57,Default,,0,0,0,,Біртүрлі Яно, армандарыңды қалай шындап қабылдауға болады?
Dialogue: 0,0:18:41.78,0:18:42.87,Default,,0,0,0,,Хмм (Нанами) Уау.
Dialogue: 0,0:18:42.95,0:18:44.20,Default,,0,0,0,,Яно Мен адамдарды көремін.
Dialogue: 0,0:18:49.79,0:18:51.58,Default,,0,0,0,,Бұл анық болды
Dialogue: 0,0:18:52.29,0:18:55.71,Default,,0,0,0,,Біздің бір-бірімізге деген сезімдеріміз көз алдында.
Dialogue: 0,0:18:56.38,0:18:58.47,Default,,0,0,0,,Сіз өкініп қалуыңыз мүмкін
Dialogue: 0,0:18:58.55,0:19:02.72,Default,,0,0,0,,Мен не істеу керектігін ешқашан білмеуі мүмкін.
Dialogue: 0,0:19:03.30,0:19:07.52,Default,,0,0,0,,Тағдыр айдап бара жатыр ма, әлде қарсы шықтым ба, білмеймін.
Dialogue: 0,0:19:07.60,0:19:10.64,Default,,0,0,0,,Бірақ менің бір тілегім болса...
Dialogue: 0,0:19:12.02,0:19:13.65,Default,,0,0,0,,Эй, бұл Нанами.
Dialogue: 0,0:19:13.73,0:19:15.27,Default,,0,0,0,,Әлі де біразы қалды.
Dialogue: 0,0:19:15.36,0:19:16.19,Default,,0,0,0,,Қазірдің өзінде...
Dialogue: 0,0:19:16.28,0:19:17.65,Default,,0,0,0,,Нана-чан
Dialogue: 0,0:19:17.73,0:19:18.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:19.74,0:19:22.11,Default,,0,0,0,,Кеуде... бірақ...
Dialogue: 0,0:19:24.74,0:19:26.62,Default,,0,0,0,,Ал... алыңыз.
Dialogue: 0,0:19:34.46,0:19:35.29,Default,,0,0,0,,Жарайды
Dialogue: 0,0:19:35.38,0:19:39.26,Default,,0,0,0,,Менің тілегім Яноның тілегі орындалса екен.
Dialogue: 0,0:19:39.76,0:19:43.09,Default,,0,0,0,,Иә, менің тілегім Яноның тілегі болды.
Dialogue: 0,0:19:43.18,0:19:46.81,Default,,0,0,0,,Яноның тілегі менің тілегіме айналады
Dialogue: 0,0:19:46.89,0:19:50.27,Default,,0,0,0,,Біз сізді осылай қолдаймыз, солай ма?
Dialogue: 0,0:19:54.69,0:19:58.07,Default,,0,0,0,,Болашақты болашаққа қалдырайық
Dialogue: 0,0:20:01.86,0:20:02.99,Default,,0,0,0,,Бұл жақсы болмады.
Dialogue: 0,0:20:03.07,0:20:07.03,Default,,0,0,0,,Ақшаның бәрін жұмсадың, Яно, сен жақсы болсаң да.
Dialogue: 0,0:20:07.12,0:20:08.79,Default,,0,0,0,,Мен тым қатты итеріп жібердім.
Dialogue: 0,0:20:08.87,0:20:09.79,Default,,0,0,0,,Рем – Рем
Dialogue: 0,0:20:09.87,0:20:12.25,Default,,0,0,0,,Иә? Не болды?
Dialogue: 0,0:20:12.33,0:20:16.79,Default,,0,0,0,,Жоқ, бүгін күн суық, сондықтан жүрегім қысылып тұр.
Dialogue: 0,0:20:17.79,0:20:18.80,Default,,0,0,0,,Ах
Dialogue: 0,0:20:19.80,0:20:22.17,Default,,0,0,0,,Биыл қар көп жауды.
Dialogue: 0,0:20:25.80,0:20:27.72,Default,,0,0,0,,Қараңызшы...
Dialogue: 0,0:20:29.51,0:20:32.89,Default,,0,0,0,,Менің кеудем қайтадан тарылды...
Dialogue: 0,0:20:34.85,0:20:39.57,Default,,0,0,0,,Уақыт өтіп бара жатқандай тығыз
Dialogue: 0,0:20:41.03,0:20:43.24,Default,,0,0,0,,Қарды басқан дыбыс сияқты
Dialogue: 0,0:20:44.36,0:20:47.95,Default,,0,0,0,,Мен саған деген сезімімді өлшеймін
Dialogue: 0,0:20:53.50,0:20:54.12,Default,,0,0,0,,(орындық тартылып жатқан дыбыс)
Dialogue: 0,0:20:54.12,0:20:54.96,Default,,0,0,0,,(орындық тартылып жатқан дыбыс)
Dialogue: 0,0:20:54.12,0:20:54.96,Default,,0,0,0,,Ах... иә?
Dialogue: 0,0:20:54.96,0:20:55.87,Default,,0,0,0,,Ах... иә?
Dialogue: 0,0:20:59.00,0:21:01.46,Default,,0,0,0,,Бүгін кешке сіздің сүйікті бұқтырыңыз.
Dialogue: 0,0:21:04.51,0:21:07.72,Default,,0,0,0,,Мама, мен алдын ала қалталы ақша алғым келеді.
Dialogue: 0,0:21:08.80,0:21:10.47,Default,,0,0,0,,Ол не үшін қолданылады?
Dialogue: 0,0:21:10.56,0:21:12.22,Default,,0,0,0,,Өйткені мен онымен Рождествоны өткізгім келеді
Dialogue: 0,0:21:14.39,0:21:15.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:16.73,0:21:17.69,Default,,0,0,0,,Ум...
Dialogue: 0,0:21:35.46,0:21:37.25,Default,,0,0,0,,Биылғы Рождестволық сыйлық...
Dialogue: 0,0:21:37.83,0:21:38.96,Default,,0,0,0,,Джажан!
Dialogue: 0,0:21:39.04,0:21:41.25,Default,,0,0,0,,Бір күндік тур, соның ішінде жануарлар паркі!
Dialogue: 0,0:21:41.34,0:21:43.09,Default,,0,0,0,,Өтірік Өтірік
Dialogue: 0,0:21:43.17,0:21:45.51,Default,,0,0,0,,Бұл Маусленд емес, бірақ... барсам болады ма?
Dialogue: 0,0:21:46.47,0:21:47.97,Default,,0,0,0,,U… Сонымен…
Dialogue: 0,0:21:48.59,0:21:51.01,Default,,0,0,0,,Не? Бұл
Dialogue: 0,0:21:51.10,0:21:52.72,Default,,0,0,0,,Рождество…
Dialogue: 0,0:21:52.81,0:21:54.73,Default,,0,0,0,,Иә, міндетті түрде барыңыз!
Dialogue: 0,0:21:54.81,0:21:56.69,Default,,0,0,0,,Шынайы ма? Мен жасадым
Dialogue: 0,0:21:56.77,0:21:59.69,Default,,0,0,0,,Біз бірге уақыт өткізе аламыз
Dialogue: 0,0:21:59.77,0:22:01.57,Default,,0,0,0,,Яно, қалуыңызды өтінемін...
Dialogue: 0,0:22:05.57,0:22:09.57,Default,,0,0,0,,♪～
Dialogue: 0,0:22:09.66,0:22:10.99,Default,,0,0,0,,1 апта...
Dialogue: 0,0:22:13.62,0:22:14.75,Default,,0,0,0,,Әлі ерте
Dialogue: 0,0:22:20.75,0:22:22.63,Default,,0,0,0,,Жүрек үні
Dialogue: 0,0:22:23.71,0:22:25.30,Default,,0,0,0,,Мен оны естідім
Dialogue: 0,0:22:28.01,0:22:31.26,Default,,0,0,0,,Кешіріңіз, Такахаши...
Dialogue: 0,0:22:38.14,0:22:39.39,Default,,0,0,0,,Анаммен...
Dialogue: 0,0:22:41.73,0:22:42.98,Default,,0,0,0,,Токиоға барыңыз
Dialogue: 0,0:22:50.53,0:22:51.53,Default,,0,0,0,,Иә...
Dialogue: 0,0:22:53.08,0:22:54.53,Default,,0,0,0,,Жарайды
Dialogue: 0,0:22:56.75,0:22:58.04,Default,,0,0,0,,Жарайды
Dialogue: 0,0:23:12.05,0:23:16.26,Default,,0,0,0,,Өкінетін нәрсеге өкінбе
Dialogue: 0,0:23:19.02,0:23:21.31,Default,,0,0,0,,Менде осындай қайшылық болды⸺
Dialogue: 0,0:23:22.35,0:23:27.19,Default,,0,0,0,,Менің 17 жылдық қыс мезгілі аяқталуға жақын.
Dialogue: 0,0:25:06.92,0:25:09.79,Default,,0,0,0,,Біз осында болдық.
Dialogue: 0,0:25:10.75,0:25:11.88,Default,,0,0,0,,Мұнда тұру...
Dialogue: 0,0:25:11.96,0:25:14.63,Default,,0,0,0,,Оған ғашық бол...
Dialogue: 0,0:25:14.72,0:25:16.18,Default,,0,0,0,,Мен сені жақсы көремін...
Dialogue: 0,0:25:16.68,0:25:19.35,Default,,0,0,0,,Көптеген алғашқылар
Dialogue: 0,0:25:19.43,0:25:21.47,Default,,0,0,0,,Сансыз сезімдерді алдым...
Dialogue: 0,0:25:22.22,0:25:24.31,Default,,0,0,0,,Өзіңіздің күшті және әлсіз жақтарыңызды біліңіз...
Dialogue: 0,0:25:26.10,0:25:27.56,Default,,0,0,0,,Шынында да…
Dialogue: 0,0:25:28.52,0:25:29.94,Default,,0,0,0,,Барлық оқтарыңды жауға беріңдер!!
Dialogue: 0,0:25:30.02,0:25:32.86,Default,,0,0,0,,Мен осында болдым.
Dialogue: 0,0:25:32.94,0:25:35.90,Default,,0,0,0,,～♪
Dialogue: 0,0:25:37.40,0:25:43.40,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
