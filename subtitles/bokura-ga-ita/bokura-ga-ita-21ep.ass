Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.29,0:00:05.42,Default,,0,0,0,,Бұл!
Dialogue: 0,0:00:06.13,0:00:07.34,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,0:00:07.84,0:00:10.30,Default,,0,0,0,,Барлық рөлді осы екеуі орындады.
Dialogue: 0,0:00:10.88,0:00:13.55,Default,,0,0,0,,Мен сені қайта көргім келді.
Dialogue: 0,0:00:14.05,0:00:17.05,Default,,0,0,0,,Өткен күні сөйлесуге мүмкіндік болмады.
Dialogue: 0,0:00:18.10,0:00:21.27,Default,,0,0,0,,Мен Такеучидің мұндай нәрсеге жақсы емес екенін көріп тұрмын.
Dialogue: 0,0:00:21.77,0:00:25.60,Default,,0,0,0,,Бірақ тағы да кездесе аламыз ба?
Dialogue: 0,0:00:27.27,0:00:31.53,Default,,0,0,0,,Маған бір ай ғана мүмкіндік бере аласыз ба?
Dialogue: 0,0:00:34.57,0:00:36.16,Default,,0,0,0,,Неге ашуландың?
Dialogue: 0,0:00:37.24,0:00:38.32,Default,,0,0,0,,Хахан
Dialogue: 0,0:00:39.41,0:00:41.04,Default,,0,0,0,,Бір ай бойы танысып көріңіз
Dialogue: 0,0:00:41.66,0:00:43.25,Default,,0,0,0,,«Иә, бұл жақсы болмады».
Dialogue: 0,0:00:43.33,0:00:46.04,Default,,0,0,0,,«Кешіріңіз, мен сізді ұнатпадым».
Dialogue: 0,0:00:46.79,0:00:49.25,Default,,0,0,0,,Басынан бастап жоқ десең жақсы болар еді.
Dialogue: 0,0:00:50.34,0:00:51.76,Default,,0,0,0,,Сонымен не істеуіміз керек?
Dialogue: 0,0:00:51.84,0:00:54.17,Default,,0,0,0,,Өзіңізге ұнамайтын әйелмен кездеспеңіз
Dialogue: 0,0:00:54.26,0:00:55.09,Default,,0,0,0,,Уақытты босқа кетіру
Dialogue: 0,0:00:57.18,0:01:02.18,Default,,0,0,0,,♪～
Dialogue: 0,0:02:23.05,0:02:27.93,Default,,0,0,0,,～♪
Dialogue: 0,0:02:32.06,0:02:35.19,Default,,0,0,0,,Сенбі күні түнде менің үйіме қонаққа келгің келе ме?
Dialogue: 0,0:02:40.03,0:02:42.20,Default,,0,0,0,,Эй... бірдеңе айтшы.
Dialogue: 0,0:02:43.20,0:02:46.12,Default,,0,0,0,,Қандай да бір әзіл? Еркелік пе?
Dialogue: 0,0:02:46.20,0:02:48.45,Default,,0,0,0,,Менің ата-анам Саппороға тойға бара жатыр.
Dialogue: 0,0:02:50.04,0:02:51.83,Default,,0,0,0,,Яно келесі күні
Dialogue: 0,0:02:51.92,0:02:54.46,Default,,0,0,0,,Сіз бір жерге бірге барғыңыз келетінін айттыңыз.
Dialogue: 0,0:02:55.92,0:03:00.80,Default,,0,0,0,,Бұл сапар емес, бірақ мен біз бүкіл күнді бірге өткіземіз деп ойладым.
Dialogue: 0,0:03:10.48,0:03:11.98,Default,,0,0,0,,Күндізгі фильмдер
Dialogue: 0,0:03:12.06,0:03:14.27,Default,,0,0,0,,Кешке екеуміз қуанып үйге қайттық.
Dialogue: 0,0:03:14.36,0:03:16.73,Default,,0,0,0,,Кешкі асқа спагетти карбонарасы
Dialogue: 0,0:03:16.82,0:03:19.07,Default,,0,0,0,,Мен оны өткен аптада жасадым, сондықтан ол сәтсіздікке ұшырайды.
Dialogue: 0,0:03:19.15,0:03:20.95,Default,,0,0,0,,Түнде анам маған телефон соғады.
Dialogue: 0,0:03:21.03,0:03:23.36,Default,,0,0,0,,Егер сіз оны әдеттегідей қабылдасаңыз, проблема жоқ.
Dialogue: 0,0:03:23.45,0:03:26.03,Default,,0,0,0,,Мен жуынатын бөлмені жылтыраттым.
Dialogue: 0,0:03:26.12,0:03:29.04,Default,,0,0,0,,Демалыс күндерінің қызықты жоспарларының соңы
Dialogue: 0,0:03:34.21,0:03:35.04,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:03:35.84,0:03:40.17,Default,,0,0,0,,Түн батқанша жұлдызды аспанға қарап, шексіз сөйлесуден ләззат алыңыз
Dialogue: 0,0:03:42.13,0:03:46.80,Default,,0,0,0,,Ондай оқиға болуы мүмкін емес, 17 жастағы ұл мен қыз
Dialogue: 0,0:03:46.89,0:03:49.81,Default,,0,0,0,,Бірақ мен шешіп қойдым.
Dialogue: 0,0:03:55.56,0:03:57.52,Default,,0,0,0,,Иә? Яно
Dialogue: 0,0:03:57.61,0:04:01.03,Default,,0,0,0,,Бұл дүкенге келуіңіз әдеттен тыс.
Dialogue: 0,0:04:01.11,0:04:03.91,Default,,0,0,0,,Яно: Не сатып алуға келдің? (Яно) ақымақ
Dialogue: 0,0:04:06.16,0:04:07.16,Default,,0,0,0,,Ах... уау...
Dialogue: 0,0:04:09.08,0:04:10.20,Default,,0,0,0,,(Отокоцудың дауысы)
Dialogue: 0,0:04:11.12,0:04:13.33,Default,,0,0,0,,Маған бұл маңызды емес.
Dialogue: 0,0:04:13.41,0:04:15.50,Default,,0,0,0,,(Лала сұлудың иіскеген дыбысы)
Dialogue: 0,0:04:15.58,0:04:16.63,Default,,0,0,0,,Өтірік емес, солай ма?
Dialogue: 0,0:04:16.71,0:04:17.54,Default,,0,0,0,,(Лаламидің айқайы)
Dialogue: 0,0:04:18.88,0:04:22.55,Default,,0,0,0,,Такахашиді таңға дейін мықтап ұстаңыз.
Dialogue: 0,0:04:22.63,0:04:26.55,Default,,0,0,0,,Мені қатты құшақтап, сүйіп, қайта құшақта
Dialogue: 0,0:04:27.05,0:04:28.51,Default,,0,0,0,,Таңертеңге дейін
Dialogue: 0,0:04:32.85,0:04:36.52,Default,,0,0,0,,Қызық, Такахашидің түнгі киімі қандай? Мүмкін пижамалар?
Dialogue: 0,0:04:37.73,0:04:40.82,Default,,0,0,0,,Осындай иықтары болса жақсы болар еді хаха...
Dialogue: 0,0:04:52.70,0:04:56.46,Default,,0,0,0,,Ертең...
Dialogue: 0,0:05:00.80,0:05:02.01,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:05:03.38,0:05:04.72,Default,,0,0,0,,Мен енді жылап жібергім келеді!
Dialogue: 0,0:05:05.38,0:05:06.59,Default,,0,0,0,,Хаха...
Dialogue: 0,0:05:07.39,0:05:08.97,Default,,0,0,0,,Хе хехе
Dialogue: 0,0:05:12.47,0:05:13.60,Default,,0,0,0,,Сіз өткізіп жібересіз бе?
Dialogue: 0,0:05:15.69,0:05:17.06,Default,,0,0,0,,Тағы да...
Dialogue: 0,0:05:17.85,0:05:20.36,Default,,0,0,0,,Пойызбен вокзалға барасыз ба? Кездесу?
Dialogue: 0,0:05:20.86,0:05:22.94,Default,,0,0,0,,Ал, сен де?
Dialogue: 0,0:05:23.44,0:05:24.61,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:05:24.69,0:05:27.16,Default,,0,0,0,,Тек қолыңнан келгеннің бәрін істе.
Dialogue: 0,0:05:27.24,0:05:28.36,Default,,0,0,0,,(Шукуна) Бұл жалықтырады. Егер менің орнымды алмақ болсаң, іске кіріс.
Dialogue: 0,0:05:28.45,0:05:29.37,Default,,0,0,0,,Әй?
Dialogue: 0,0:05:29.45,0:05:31.83,Default,,0,0,0,,Юбе Белгілі бір дүкенде бір көрініс болды.
Dialogue: 0,0:05:32.54,0:05:35.91,Default,,0,0,0,,Оның үстіне мен көрші қалаға дейін бардым, оны бір танысым тауып алды.
Dialogue: 0,0:05:36.00,0:05:36.83,Default,,0,0,0,,Бұл ақымақтық
Dialogue: 0,0:05:36.91,0:05:38.37,Default,,0,0,0,,Ақпарат өте жылдам
Dialogue: 0,0:05:43.13,0:05:45.09,Default,,0,0,0,,Тек сізге зиян тигізетін ештеңе жасамаңыз.
Dialogue: 0,0:05:47.68,0:05:48.63,Default,,0,0,0,,Иә
Dialogue: 0,0:05:48.72,0:05:50.22,Default,,0,0,0,,Ол әдеттен тыс шыншыл.
Dialogue: 0,0:05:50.30,0:05:53.89,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:05:53.97,0:05:54.81,Default,,0,0,0,,Шық!
Dialogue: 0,0:05:55.43,0:05:59.56,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:06:02.57,0:06:03.48,Default,,0,0,0,,Иә
Dialogue: 0,0:06:06.03,0:06:08.20,Default,,0,0,0,,Не? Ол не үшін?
Dialogue: 0,0:06:08.28,0:06:09.74,Default,,0,0,0,,Мен жаңа ғана автобусқа отырмын.
Dialogue: 0,0:06:09.82,0:06:10.66,Default,,0,0,0,,(Автобустың жүру дыбысы)
Dialogue: 0,0:06:12.74,0:06:14.99,Default,,0,0,0,,Эй, автобус осында.
Dialogue: 0,0:06:15.54,0:06:17.46,Default,,0,0,0,,Кешіріңіз, егер сіз оны қолданбасаңыз, мен оны кесіп аламын.
Dialogue: 0,0:06:19.33,0:06:20.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:21.04,0:06:21.88,Default,,0,0,0,,Бұрынғы?
Dialogue: 0,0:06:25.30,0:06:26.13,Default,,0,0,0,,Қазір қайдасың?
Dialogue: 0,0:06:26.88,0:06:27.51,Default,,0,0,0,,Эй, мен мінуім керек пе?
Dialogue: 0,0:06:27.51,0:06:28.72,Default,,0,0,0,,Эй, мен мінуім керек пе?
Dialogue: 0,0:06:27.51,0:06:28.72,Default,,0,0,0,,(Изуку) Мен үшін ұпайлар аса маңызды емес. (Оқушы) Жоғары ондықтағы біреу…
Dialogue: 0,0:06:28.80,0:06:29.63,Default,,0,0,0,,13-ші мұғалімнің жаттығу тесті соңына дейін созылып кетті…
Dialogue: 0,0:06:43.56,0:06:45.27,Default,,0,0,0,,Есікті мықтап бекітіңіз.
Dialogue: 0,0:06:45.36,0:06:48.65,Default,,0,0,0,,Мен саған түнде хабарласамын, кілттеріңді ұмытпа.
Dialogue: 0,0:06:48.74,0:06:50.20,Default,,0,0,0,,Иә, келіңіз.
Dialogue: 0,0:06:50.28,0:06:51.11,Default,,0,0,0,,Иә (Намидің әкесі) Иә.
Dialogue: 0,0:06:52.41,0:06:54.12,Default,,0,0,0,,Кешіріңіз анашым
Dialogue: 0,0:06:57.95,0:07:00.46,Default,,0,0,0,,Тезірек, мені де жібер.
Dialogue: 0,0:07:02.96,0:07:06.05,Default,,0,0,0,,Сізде ерекше күн болады деп үміттенемін
Dialogue: 0,0:07:10.17,0:07:12.64,Default,,0,0,0,,(Такси тежегішінің дыбысы)
Dialogue: 0,0:07:14.80,0:07:18.10,Default,,0,0,0,,Анам мені оятса да мен оянбадым.
Dialogue: 0,0:07:19.06,0:07:21.35,Default,,0,0,0,,Қанша шайқасам да оянбайды.
Dialogue: 0,0:07:21.94,0:07:23.35,Default,,0,0,0,,Жедел жәрдем шақырыңыз
Dialogue: 0,0:07:24.94,0:07:26.86,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:07:37.20,0:07:39.62,Default,,0,0,0,,Қазір жансақтау бөлімінде...
Dialogue: 0,0:07:46.21,0:07:47.34,Default,,0,0,0,,Жарайды
Dialogue: 0,0:07:53.26,0:07:54.51,Default,,0,0,0,,Не ойнап жүрсің осылайша кішкентай баланы таптап!
Dialogue: 0,0:08:12.57,0:08:13.78,Default,,0,0,0,,Кеш болды.
Dialogue: 0,0:08:13.86,0:08:16.99,Default,,0,0,0,,Яно Уақыт әрқашан дәл болса да
Dialogue: 0,0:08:24.33,0:08:26.92,Default,,0,0,0,,Кешіріңіз, мен сізге бір секундқа қоңырау шала аламын ба?
Dialogue: 0,0:08:27.50,0:08:29.13,Default,,0,0,0,,Ұлы соғыс аяқталғаннан бері—
Dialogue: 0,0:08:30.42,0:08:32.88,Default,,0,0,0,,Мүмкін сіз біреуге уәде берген боларсыз?
Dialogue: 0,0:08:32.97,0:08:36.18,Default,,0,0,0,,А, иә, сәл ғана.
Dialogue: 0,0:08:36.26,0:08:37.68,Default,,0,0,0,,Мен бірден қайтамын.
Dialogue: 0,0:08:43.06,0:08:46.44,Default,,0,0,0,,Яно? Сіз 30 минутқа кешігіп қалдыңыз.
Dialogue: 0,0:08:46.52,0:08:47.36,Default,,0,0,0,,Не болды?
Dialogue: 0,0:08:47.44,0:08:49.90,Default,,0,0,0,,Менің ұялы телефоным мүлдем жұмыс істемейді.
Dialogue: 0,0:08:49.98,0:08:52.44,Default,,0,0,0,,Кешіріңіз, мен сізді осы жағдайда бөлуге тура келді.
Dialogue: 0,0:08:52.53,0:08:53.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:53.44,0:08:56.70,Default,,0,0,0,,Білесіз бе, біз әлі сәл кешігіп қалатын сияқтымыз.
Dialogue: 0,0:08:56.78,0:08:58.66,Default,,0,0,0,,Такахаши, неге үйге бармайсың?
Dialogue: 0,0:08:58.74,0:08:59.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:59.66,0:09:02.33,Default,,0,0,0,,Өйткені... фильмдер ше?
Dialogue: 0,0:09:02.41,0:09:03.25,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:09:03.33,0:09:05.33,Default,,0,0,0,,Үйге сағат нешеде келуге болады?
Dialogue: 0,0:09:05.83,0:09:06.71,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:09:06.79,0:09:10.21,Default,,0,0,0,,Білмесеңіз, мұнда не істеп жүрсіз?
Dialogue: 0,0:09:15.42,0:09:19.72,Default,,0,0,0,,Ямамотоның анасы құлап қалды, қазір онымен бірге ауруханада жатыр.
Dialogue: 0,0:09:25.81,0:09:27.73,Default,,0,0,0,,Сонымен... иә...
Dialogue: 0,0:09:32.28,0:09:33.90,Default,,0,0,0,,Не болды?
Dialogue: 0,0:09:34.44,0:09:38.36,Default,,0,0,0,,Білмеймін... инсульт шығар.
Dialogue: 0,0:09:38.86,0:09:40.66,Default,,0,0,0,,Ол әлі емдеу бөлмесінен шыққан жоқ.
Dialogue: 0,0:09:41.78,0:09:44.83,Default,,0,0,0,,Иә... бұл қиын.
Dialogue: 0,0:09:45.33,0:09:46.16,Default,,0,0,0,,Иә
Dialogue: 0,0:09:46.25,0:09:48.62,Default,,0,0,0,,Шарт анық болғанша...
Dialogue: 0,0:09:48.71,0:09:51.42,Default,,0,0,0,,Бірақ Яно неге бару керек?
Dialogue: 0,0:09:58.47,0:09:59.80,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:09:59.89,0:10:02.31,Default,,0,0,0,,Такахаши дұрыс, бірақ...
Dialogue: 0,0:10:02.39,0:10:04.14,Default,,0,0,0,,Олай болса дәл қазір осында кел.
Dialogue: 0,0:10:05.18,0:10:06.39,Default,,0,0,0,,Сіз мені жалғыз қалдыра алмайсыз.
Dialogue: 0,0:10:11.40,0:10:13.23,Default,,0,0,0,,Мені жалғыз қалдыра алмайсың ба?
Dialogue: 0,0:10:13.32,0:10:15.23,Default,,0,0,0,,Үйге барып, мені күт.
Dialogue: 0,0:10:15.32,0:10:17.28,Default,,0,0,0,,Такахаши, өтінемін.
Dialogue: 0,0:10:17.36,0:10:18.20,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:10:19.57,0:10:20.57,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:10:22.24,0:10:25.58,Default,,0,0,0,,Мен үйге бармаймын, қазір кел!
Dialogue: 0,0:10:25.66,0:10:27.66,Default,,0,0,0,,Яно келгенше үйге бармаймын.
Dialogue: 0,0:10:27.75,0:10:29.17,Default,,0,0,0,,Такахаши…
Dialogue: 0,0:10:27.75,0:10:29.17,Default,,0,0,0,,(Қоңырау ажыратылған дыбыс)
Dialogue: 0,0:10:36.38,0:10:37.63,Default,,0,0,0,,Жарайды, алдымен осыны оқимын, бітірген соң екіншісін де оқимыз ба?
Dialogue: 0,0:10:39.38,0:10:41.22,Default,,0,0,0,,Неге мұндай күнде...
Dialogue: 0,0:10:42.64,0:10:44.68,Default,,0,0,0,,Ямамото мырзаны таңдай аламын ба?
Dialogue: 0,0:10:56.11,0:10:59.78,Default,,0,0,0,,Хехе... Менімен сөйлесіп жүргеніңізге біраз болды.
Dialogue: 0,0:10:59.86,0:11:00.70,Default,,0,0,0,,Қызықсыз ба?
Dialogue: 0,0:11:00.78,0:11:02.37,Default,,0,0,0,,Мен жүгері дорбаларын жүк көліктеріне тиеп, қоймаға апаратынмын.
Dialogue: 0,0:11:03.37,0:11:05.20,Default,,0,0,0,,Ойланып қарасам, бауырларың бар ма?
Dialogue: 0,0:11:06.54,0:11:08.16,Default,,0,0,0,,Бір інісі
Dialogue: 0,0:11:08.25,0:11:11.71,Default,,0,0,0,,Бірақ біз бұл туралы бұрын айттық... дұрыс па?
Dialogue: 0,0:11:13.29,0:11:14.54,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:11:15.92,0:11:16.63,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:11:16.63,0:11:17.46,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:11:16.63,0:11:17.46,Default,,0,0,0,,Ах
Dialogue: 0,0:11:17.46,0:11:18.05,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:11:18.05,0:11:19.38,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:11:18.05,0:11:19.38,Default,,0,0,0,,Бір сәт шыға аламын ба?
Dialogue: 0,0:11:19.38,0:11:21.01,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:11:21.09,0:11:21.93,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:11:23.26,0:11:24.55,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:11:25.05,0:11:26.06,Default,,0,0,0,,Әй?
Dialogue: 0,0:11:30.02,0:11:31.98,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:11:34.31,0:11:38.48,Default,,0,0,0,,Әлгі жігіт қатты ашуланып, қоңырауларға жауап беруден бас тартады.
Dialogue: 0,0:11:39.11,0:11:41.40,Default,,0,0,0,,Бірақ мен ішке кіруім керек.
Dialogue: 0,0:11:42.41,0:11:44.70,Default,,0,0,0,,Кешіріңіз, бірақ мені сендіре аласыз ба?
Dialogue: 0,0:11:44.78,0:11:46.45,Default,,0,0,0,,Қоңырауыңызды қабылдаймын деп ойлаймын.
Dialogue: 0,0:11:46.53,0:11:47.70,Default,,0,0,0,,Сен ақымақсың ба?
Dialogue: 0,0:11:47.79,0:11:50.96,Default,,0,0,0,,Дәл қазір Такахашиге барсаңыз, ешқандай проблема болмайды.
Dialogue: 0,0:11:51.46,0:11:53.71,Default,,0,0,0,,Сіз не істеп жатқаныңызды білесіз бе?
Dialogue: 0,0:11:54.71,0:11:56.42,Default,,0,0,0,,Ол жалғыз.
Dialogue: 0,0:11:57.25,0:11:58.38,Default,,0,0,0,,Менің әкем жоқ.
Dialogue: 0,0:11:58.88,0:12:00.80,Default,,0,0,0,,Жоқ, мен.
Dialogue: 0,0:12:00.88,0:12:03.68,Default,,0,0,0,,Қыздармен бірге жүреді, сирек қайтады.
Dialogue: 0,0:12:04.22,0:12:08.06,Default,,0,0,0,,Менің туыстарым алыста тұрады, сондықтан арқа сүйер адамым жоқ.
Dialogue: 0,0:12:08.14,0:12:09.93,Default,,0,0,0,,Қазір отбасы бір ғана анадан тұрады.
Dialogue: 0,0:12:11.81,0:12:15.31,Default,,0,0,0,,Мен мұндай ыңғайсыз сезімді түсінемін.
Dialogue: 0,0:12:15.40,0:12:18.65,Default,,0,0,0,,Сондықтан сен маған қамқор болуың керек.
Dialogue: 0,0:12:21.57,0:12:23.07,Default,,0,0,0,,тіпті ол өзі де білмейтін Титантарға қатысты бір құпия жатыр дейді.
Dialogue: 0,0:12:23.15,0:12:25.99,Default,,0,0,0,,Адамның жанашырлық танытпағаны жақсы.
Dialogue: 0,0:12:27.12,0:12:28.49,Default,,0,0,0,,Тіпті сіз үшін
Dialogue: 0,0:12:30.29,0:12:31.58,Default,,0,0,0,,Адамдар туралы айтуға болмайды.
Dialogue: 0,0:12:31.66,0:12:32.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:32.58,0:12:35.08,Default,,0,0,0,,Сіз дәл қазір де солай істеп жатырсыз.
Dialogue: 0,0:12:39.13,0:12:40.88,Default,,0,0,0,,Ал, мен қайтамын.
Dialogue: 0,0:12:40.96,0:12:41.96,Default,,0,0,0,,Байланыс сұрауы
Dialogue: 0,0:12:42.05,0:12:43.05,Default,,0,0,0,,(Қоңырау ажыратылған дыбыс)
Dialogue: 0,0:12:46.14,0:12:47.34,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:12:47.89,0:12:49.85,Default,,0,0,0,,Ақаулық немесе басқа нәрсе?
Dialogue: 0,0:12:50.35,0:12:51.64,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:12:51.72,0:12:53.81,Default,,0,0,0,,Кешіріңіз, бірақ мен тағы бір қоңырау шала аламын ба?
Dialogue: 0,0:12:54.98,0:12:55.81,Default,,0,0,0,,Иә
Dialogue: 0,0:12:55.90,0:13:00.57,Default,,0,0,0,,(Қоңырау үні)
Dialogue: 0,0:13:07.20,0:13:08.91,Default,,0,0,0,,Менің үйге барғым келмейді.
Dialogue: 0,0:13:08.99,0:13:11.83,Default,,0,0,0,,Бірақ сіз онда мәңгі қала алмайсыз.
Dialogue: 0,0:13:11.91,0:13:13.04,Default,,0,0,0,,Сыртта суық
Dialogue: 0,0:13:13.12,0:13:15.16,Default,,0,0,0,,Жарайды, үйге барғым келмейді.
Dialogue: 0,0:13:15.16,0:13:15.46,Default,,0,0,0,,Жарайды, үйге барғым келмейді.
Dialogue: 0,0:13:15.16,0:13:15.46,Default,,0,0,0,,Такаха...
Dialogue: 0,0:13:15.46,0:13:15.54,Default,,0,0,0,,Такаха...
Dialogue: 0,0:13:15.54,0:13:16.29,Default,,0,0,0,,Такаха...
Dialogue: 0,0:13:15.54,0:13:16.29,Default,,0,0,0,,Мені жалғыз қалдырыңыз! Такеучи-кун, ақымақ!
Dialogue: 0,0:13:16.29,0:13:17.96,Default,,0,0,0,,Мені жалғыз қалдырыңыз! Такеучи-кун, ақымақ!
Dialogue: 0,0:13:26.93,0:13:27.93,Default,,0,0,0,,Барша адамның ішінен… сен бе
Dialogue: 0,0:13:28.93,0:13:31.22,Default,,0,0,0,,Бұл Такеучи-кунның кінәсі емес.
Dialogue: 0,0:13:31.76,0:13:34.35,Default,,0,0,0,,Бірақ өтінемін, мені жалғыз қалдырыңыз.
Dialogue: 0,0:13:35.02,0:13:36.19,Default,,0,0,0,,Неліктен Яно?
Dialogue: 0,0:13:37.23,0:13:39.90,Default,,0,0,0,,Менің сезімімді түсінбейсің бе?
Dialogue: 0,0:13:44.94,0:13:48.70,Default,,0,0,0,,Өтінемін, Яно сұраса да маған қайта қоңырау шалма.
Dialogue: 0,0:13:48.78,0:13:49.99,Default,,0,0,0,,(Қоңырау ажыратылған дыбыс)
Dialogue: 0,0:14:03.80,0:14:06.09,Default,,0,0,0,,Сіз мағынасыз әрекет етесіз.
Dialogue: 0,0:14:06.92,0:14:11.14,Default,,0,0,0,,Мен жақсы сезімдерге ие бола алмайтынымды білемін.
Dialogue: 0,0:14:14.27,0:14:18.02,Default,,0,0,0,,Егер басқа адам Ямамото мырза болмаса
Dialogue: 0,0:14:18.52,0:14:21.77,Default,,0,0,0,,Мүмкін мен бұлай қыңыр болмауым керек еді.
Dialogue: 0,0:14:22.40,0:14:26.69,Default,,0,0,0,,Бірақ не болса да, мен сенің бүгін келгеніңді қаладым.
Dialogue: 0,0:14:27.36,0:14:32.70,Default,,0,0,0,,Яно: Мен тіпті мұндай уақытта жалғыз қалғым келмейді.
Dialogue: 0,0:14:37.91,0:14:39.25,Default,,0,0,0,,...сонымен
Dialogue: 0,0:14:39.33,0:14:40.25,Default,,0,0,0,,бұл бұлыңғыр кадрлардан оны анықтау қиын болар еді.
Dialogue: 0,0:14:40.33,0:14:41.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:41.75,0:14:46.51,Default,,0,0,0,,Такеучи-кун, сіз біраз уақыттан бері сыртқы әлемге назар аудардыңыз.
Dialogue: 0,0:15:02.52,0:15:03.36,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:15:04.94,0:15:07.86,Default,,0,0,0,,Отбасы мүшелері, кіріңіз.
Dialogue: 0,0:15:11.57,0:15:14.07,Default,,0,0,0,,Ми толқындары Басқа ауытқулар жоқ
Dialogue: 0,0:15:14.16,0:15:17.95,Default,,0,0,0,,Менің қан қысымым қазір дәрі-дәрмекпен қалыпты қалпына келді.
Dialogue: 0,0:15:18.45,0:15:20.58,Default,,0,0,0,,Ерте ашылды деп ойлаймын.
Dialogue: 0,0:15:20.66,0:15:23.67,Default,,0,0,0,,Күйзеліс пен шамадан тыс жұмыстан шығар.
Dialogue: 0,0:15:24.71,0:15:27.25,Default,,0,0,0,,Менің ойымша, сіз жақында оянасыз.
Dialogue: 0,0:15:38.89,0:15:41.10,Default,,0,0,0,,Ауруханаға жатқызу процедуралары аяқталуы керек.
Dialogue: 0,0:15:41.19,0:15:42.73,Default,,0,0,0,,Бүгін осында тұрасыз ба?
Dialogue: 0,0:15:43.77,0:15:47.57,Default,,0,0,0,,Иә, шешім қабылдамас бұрын ояныңыз және оның қалай өтетінін көріңіз.
Dialogue: 0,0:15:48.23,0:15:49.99,Default,,0,0,0,,Әй, қарның аш емес пе?
Dialogue: 0,0:15:50.07,0:15:52.70,Default,,0,0,0,,Түскі асты өткізіп алдың, солай ма?
Dialogue: 0,0:15:52.78,0:15:56.08,Default,,0,0,0,,Біз тойға барғалы жатырмыз, сонда кафеден бірдеңе жемейсің бе?
Dialogue: 0,0:15:56.16,0:15:56.99,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:15:57.08,0:16:01.21,Default,,0,0,0,,Бүгін үйге бара аламын ба? Мен мұнда баруым керек.
Dialogue: 0,0:16:04.29,0:16:08.00,Default,,0,0,0,,Дұрыс... Сізді ұстағаным үшін кешіріңіз.
Dialogue: 0,0:16:08.50,0:16:10.30,Default,,0,0,0,,Керемет демалыс болса да
Dialogue: 0,0:16:10.38,0:16:11.42,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:11.51,0:16:14.47,Default,,0,0,0,,Негізі мен сенің анаң оянғанша жаныңда болғым келеді.
Dialogue: 0,0:16:15.05,0:16:17.39,Default,,0,0,0,,Бірақ сізге бірдеңе керек болса, тартынбаңыз.
Dialogue: 0,0:16:19.31,0:16:22.56,Default,,0,0,0,,Мен ештеңе істей алмаймын, бірақ мен сізге ең болмаса қолдау көрсете аламын.
Dialogue: 0,0:16:25.19,0:16:26.56,Default,,0,0,0,,Ал, (Юрий) А...
Dialogue: 0,0:16:27.65,0:16:30.57,Default,,0,0,0,,Бүгінгі күн үшін көп рахмет.
Dialogue: 0,0:16:30.65,0:16:32.86,Default,,0,0,0,,Анаңа сәлем айт.
Dialogue: 0,0:16:32.95,0:16:35.24,Default,,0,0,0,,Ге...мен сені есікке жіберемін.
Dialogue: 0,0:16:35.32,0:16:36.87,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:16:36.95,0:16:39.33,Default,,0,0,0,,Жарайды, асықпасаң, асхана жабылады.
Dialogue: 0,0:16:39.41,0:16:41.08,Default,,0,0,0,,Ах, такси ақысы
Dialogue: 0,0:16:41.16,0:16:42.08,Default,,0,0,0,,Мен кеттім...
Dialogue: 0,0:16:42.83,0:16:44.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:48.46,0:16:49.59,Default,,0,0,0,,Оны маған бір сәтке бересіз бе?
Dialogue: 0,0:17:01.35,0:17:02.18,Default,,0,0,0,,Ұнады
Dialogue: 0,0:17:06.27,0:17:08.06,Default,,0,0,0,,Мен сені әрқашан жақсы көрдім
Dialogue: 0,0:17:33.76,0:17:34.76,Default,,0,0,0,,Яно…
Dialogue: 0,0:17:48.56,0:17:50.23,Default,,0,0,0,,Мен сені әрқашан жақсы көрдім
Dialogue: 0,0:18:01.95,0:18:03.37,Default,,0,0,0,,Станция алаңына дейін
Dialogue: 0,0:18:03.45,0:18:04.41,Default,,0,0,0,,Кешіріңіз, мен өте асығып тұрмын.
Dialogue: 0,0:18:04.50,0:18:05.33,Default,,0,0,0,,Иә
Dialogue: 0,0:18:18.38,0:18:23.06,Default,,0,0,0,,Бұл бірінші қар. Мен бүгін салқын деп ойладым.
Dialogue: 0,0:18:26.31,0:18:28.81,Default,,0,0,0,,Uso Бұл өте суық
Dialogue: 0,0:18:29.31,0:18:31.73,Default,,0,0,0,,Мен қолғап әкелуім керек еді.
Dialogue: 0,0:18:31.81,0:18:33.07,Default,,0,0,0,,Уф
Dialogue: 0,0:18:33.15,0:18:34.82,Default,,0,0,0,,Қарашы, сенің тынысың таза аппақ.
Dialogue: 0,0:18:40.16,0:18:41.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:41.41,0:18:42.91,Default,,0,0,0,,Маған қолғап беріңіз
Dialogue: 0,0:18:43.41,0:18:44.28,Default,,0,0,0,,Мұны жасамаңыз
Dialogue: 0,0:18:45.45,0:18:48.29,Default,,0,0,0,,Маған бере аласыз ба? ол
Dialogue: 0,0:18:51.58,0:18:52.54,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:19:06.27,0:19:08.35,Default,,0,0,0,,Мен бір жерге баруым керек.
Dialogue: 0,0:19:10.69,0:19:12.06,Default,,0,0,0,,Қайда?
Dialogue: 0,0:19:15.36,0:19:17.32,Default,,0,0,0,,Өйткені ол менің досымның қызы, солай ма?
Dialogue: 0,0:19:19.90,0:19:24.91,Default,,0,0,0,,Бір сөзді қайта-қайта айтсаң бәрібір. Мұндай нәрселер уақытты алады.
Dialogue: 0,0:19:27.83,0:19:30.58,Default,,0,0,0,,Ең жаман адамдарды да қарғауға болады.
Dialogue: 0,0:19:38.09,0:19:40.51,Default,,0,0,0,,Ол дұрыс айтты.
Dialogue: 0,0:19:50.77,0:19:51.73,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:19:57.36,0:20:00.44,Default,,0,0,0,,Мен тоқтай алмаймын... Сезім бар
Dialogue: 0,0:20:02.40,0:20:04.57,Default,,0,0,0,,Кіре берісте кептеліс бар.
Dialogue: 0,0:20:04.66,0:20:07.12,Default,,0,0,0,,Олай болса, дәл сол бағдаршамның алдында.
Dialogue: 0,0:20:14.25,0:20:15.58,Default,,0,0,0,,(Киришима) Сенпай Амагири жақсы жүр ме екен?
Dialogue: 0,0:20:39.36,0:20:41.36,Default,,0,0,0,,(Такси тежегішінің дыбысы)
Dialogue: 0,0:20:46.45,0:20:48.16,Default,,0,0,0,,Ол сені жақсы көреді
Dialogue: 0,0:20:50.74,0:20:52.37,Default,,0,0,0,,Ол сізге ұнайды.
Dialogue: 0,0:20:54.75,0:20:58.71,Default,,0,0,0,,Бұл тамаша және мен жай ғана мазасызданамын
Dialogue: 0,0:20:59.21,0:21:01.30,Default,,0,0,0,,Күте тұрыңыз... өтуге рұқсат бере аласыз ба?
Dialogue: 0,0:21:01.38,0:21:03.22,Default,,0,0,0,,Мен талай рет бас тарттым
Dialogue: 0,0:21:03.84,0:21:05.05,Default,,0,0,0,,Өйткені бұл
Dialogue: 0,0:21:05.80,0:21:08.55,Default,,0,0,0,,Өйткені бұл Такахаши үшін ең жақсысы деп ойладым.
Dialogue: 0,0:21:10.26,0:21:11.26,Default,,0,0,0,,Басқа амал жоқ па?!
Dialogue: 0,0:21:11.85,0:21:12.98,Default,,0,0,0,,Жылау
Dialogue: 0,0:21:13.89,0:21:15.19,Default,,0,0,0,,Мен қазір жылап отырмын
Dialogue: 0,0:21:18.86,0:21:23.24,Default,,0,0,0,,Екі сезім де? заңсыз махаббат? достық?
Dialogue: 0,0:21:25.61,0:21:27.41,Default,,0,0,0,,Мұның бәрі
Dialogue: 0,0:21:27.49,0:21:28.99,Default,,0,0,0,,Жеңдер!
Dialogue: 0,0:21:51.26,0:21:55.06,Default,,0,0,0,,Үйде күт дедім, неге сонша қыңырсың?
Dialogue: 0,0:21:57.98,0:21:58.81,Default,,0,0,0,,Та-да!
Dialogue: 0,0:21:59.44,0:22:01.52,Default,,0,0,0,,Осылай қашанға дейін тұрасың?
Dialogue: 0,0:22:02.02,0:22:03.15,Default,,0,0,0,,Мен суық тигіземін
Dialogue: 0,0:22:12.58,0:22:13.58,Default,,0,0,0,,Бірақ мұндағы олардың ойып жазғандары ұзақ уақыттан бері ұмыт қалды, және мұнда енді дұғалар айтылмайды.
Dialogue: 0,0:22:15.08,0:22:20.08,Default,,0,0,0,,♪～
Dialogue: 0,0:22:23.09,0:22:24.80,Default,,0,0,0,,Ол сізге ұнайды.
Dialogue: 0,0:22:26.63,0:22:28.34,Default,,0,0,0,,Ол сені жақсы көреді
Dialogue: 0,0:22:30.34,0:22:32.26,Default,,0,0,0,,Бұл тамаша
Dialogue: 0,0:22:35.60,0:22:36.60,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:22:40.40,0:22:42.23,Default,,0,0,0,,Мен сізге бір ғана уәде бере аламын.
Dialogue: 0,0:23:00.00,0:23:01.21,Default,,0,0,0,,Бірақ мұндағы олардың ойып жазғандары ұзақ уақыттан бері ұмыт қалды, және мұнда енді дұғалар айтылмайды.
Dialogue: 0,0:23:04.25,0:23:06.00,Default,,0,0,0,,Мен міндетті түрде Такахашиді таңдар едім
Dialogue: 0,0:23:08.17,0:23:09.59,Default,,0,0,0,,Мені жылатпа
Dialogue: 0,0:25:08.13,0:25:10.50,Default,,0,0,0,,Алыңыз, мен мүлде түсінбеймін
Dialogue: 0,0:25:11.76,0:25:14.17,Default,,0,0,0,,Такахашиді ренжітпей қалай әрекет ету керек
Dialogue: 0,0:25:15.38,0:25:16.47,Default,,0,0,0,,Бірақ мен
Dialogue: 0,0:25:16.55,0:25:17.84,Default,,0,0,0,,Сізден артық
Dialogue: 0,0:25:17.93,0:25:20.47,Default,,0,0,0,,Мен оны әрқашан түсіне аламын!
Dialogue: 0,0:25:21.97,0:25:22.97,Default,,0,0,0,,Сенім?
Dialogue: 0,0:25:24.39,0:25:26.65,Default,,0,0,0,,Маған үнемі жетіспейтін нәрсе
Dialogue: 0,0:25:28.02,0:25:29.86,Default,,0,0,0,,Мен Такахашиді қорғағым келеді
Dialogue: 0,0:25:31.40,0:25:35.95,Default,,0,0,0,,～♪
Dialogue: 0,0:25:37.45,0:25:43.45,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
