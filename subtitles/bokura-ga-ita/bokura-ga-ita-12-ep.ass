Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.66,0:00:03.12,Default,,0,0,0,,Хмм…
Dialogue: 0,0:00:06.38,0:00:09.42,Default,,0,0,0,,Үшіншісі ең оғаш болуы мүмкін.
Dialogue: 0,0:00:09.50,0:00:11.51,Default,,0,0,0,,Бұл жеткілікті
Dialogue: 0,0:00:12.05,0:00:14.43,Default,,0,0,0,,3 Мен және Ямамото жыныстық қатынасқа түсті
Dialogue: 0,0:00:22.60,0:00:23.60,Default,,0,0,0,,Фу…
Dialogue: 0,0:00:25.10,0:00:28.44,Default,,0,0,0,,Шынымен... біртүрлі.
Dialogue: 0,0:00:28.52,0:00:29.86,Default,,0,0,0,,Біртүрлі емес пе?
Dialogue: 0,0:00:30.82,0:00:32.44,Default,,0,0,0,,Ақылсыз көрінеді
Dialogue: 0,0:00:32.53,0:00:35.20,Default,,0,0,0,,Мен әрқашан осындай қорқынышты нәрселер туралы ойладым.
Dialogue: 0,0:00:37.32,0:00:38.16,Default,,0,0,0,,Иә
Dialogue: 0,0:00:44.33,0:00:48.29,Default,,0,0,0,,Әсіресе үшіншісі әзіл ретінде ең нашар.
Dialogue: 0,0:00:51.34,0:00:54.17,Default,,0,0,0,,Иә, кем дегенде...
Dialogue: 0,0:00:57.30,0:00:59.26,Default,,0,0,0,,Не болса да
Dialogue: 0,0:01:00.35,0:01:02.14,Default,,0,0,0,,Мен оны қабылдаймын.
Dialogue: 0,0:01:23.70,0:01:25.79,Default,,0,0,0,,(Намидің жылағаны)
Dialogue: 0,0:01:37.18,0:01:42.18,Default,,0,0,0,,♪～
Dialogue: 0,0:03:02.89,0:03:07.89,Default,,0,0,0,,～♪
Dialogue: 0,0:03:07.97,0:03:12.35,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:03:19.57,0:03:23.16,Default,,0,0,0,,Мен Яномен үш күннен бері сөйлеспедім.
Dialogue: 0,0:03:24.32,0:03:26.03,Default,,0,0,0,,Мен Ямамотомен жыныстық қатынасқа түстім
Dialogue: 0,0:03:28.45,0:03:30.96,Default,,0,0,0,,Бұл жасырын Яноның алдауы емес еді.
Dialogue: 0,0:03:31.04,0:03:33.08,Default,,0,0,0,,Мен мұны мейірімділік деп білемін.
Dialogue: 0,0:03:33.88,0:03:36.96,Default,,0,0,0,,Бірақ... ол Нананың әпкесі.
Dialogue: 0,0:03:38.67,0:03:41.26,Default,,0,0,0,,Яно жалғыз болды ма?
Dialogue: 0,0:03:41.34,0:03:44.76,Default,,0,0,0,,Әлде бұл Нанаға қарсы болжам ба?
Dialogue: 0,0:03:49.27,0:03:50.85,Default,,0,0,0,,Кез келген жағдайда
Dialogue: 0,0:03:51.77,0:03:54.94,Default,,0,0,0,,Яноға опасыздық жасаған сол адам
Dialogue: 0,0:03:59.61,0:04:02.36,Default,,0,0,0,,Ах, Яно, бірде-бір оқ ішке кірмеді.
Dialogue: 0,0:04:02.45,0:04:03.99,Default,,0,0,0,,Ерекше өтірік
Dialogue: 0,0:04:04.07,0:04:06.74,Default,,0,0,0,,А, балам, мен емтихан тапсырып жатырмын.
Dialogue: 0,0:04:06.82,0:04:08.66,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:04:09.20,0:04:11.33,Default,,0,0,0,,Менде 4-сыныптан бастап PE 5 рекорды бар.
Dialogue: 0,0:04:11.41,0:04:12.50,Default,,0,0,0,,Иә
Dialogue: 0,0:04:13.25,0:04:15.46,Default,,0,0,0,,Сіз психикалық ауруға бейімсіз
Dialogue: 0,0:04:16.42,0:04:18.67,Default,,0,0,0,,Мен спортшы болмағаныма қуаныштымын.
Dialogue: 0,0:04:18.75,0:04:22.47,Default,,0,0,0,,Жарайды, мен романтикалық романист боламын.
Dialogue: 0,0:04:22.55,0:04:26.68,Default,,0,0,0,,күшік эссе В минус? Бұл мүмкін емес
Dialogue: 0,0:04:26.76,0:04:29.22,Default,,0,0,0,,Өзім туралы көп әңгімелер бар.
Dialogue: 0,0:04:29.31,0:04:30.22,Default,,0,0,0,,Хахаха
Dialogue: 0,0:04:34.94,0:04:36.56,Default,,0,0,0,,Мен ақымақпын ба?
Dialogue: 0,0:04:36.65,0:04:39.73,Default,,0,0,0,,Бәлкім, мен таңқаларлықтай ебедейсіз шығармын.
Dialogue: 0,0:04:42.03,0:04:45.03,Default,,0,0,0,,Ер адамның ебедейсіздігі – кездейсоқ мақтау.
Dialogue: 0,0:04:45.11,0:04:47.49,Default,,0,0,0,,Ол епті болудан 100 есе жақсы сезінеді.
Dialogue: 0,0:04:48.28,0:04:51.20,Default,,0,0,0,,Бірақ сен одан бас тарттың, сен жай ғана ақымақсың.
Dialogue: 0,0:04:57.54,0:04:59.75,Default,,0,0,0,,Ұялы телефоныма қанша шырылдасам да жауап бермейді.
Dialogue: 0,0:04:59.84,0:05:01.75,Default,,0,0,0,,Көз тиюге де болмайды
Dialogue: 0,0:05:01.84,0:05:04.13,Default,,0,0,0,,Оған көп рет қоңырау шалыңыз
Dialogue: 0,0:05:04.22,0:05:05.51,Default,,0,0,0,,50 есе көбейтілді
Dialogue: 0,0:05:06.43,0:05:08.09,Default,,0,0,0,,Содан кейін оны 100 есе көбейтіңіз.
Dialogue: 0,0:05:12.60,0:05:14.02,Default,,0,0,0,,Иә
Dialogue: 0,0:05:18.10,0:05:19.48,Default,,0,0,0,,О.
Dialogue: 0,0:05:19.56,0:05:22.03,Default,,0,0,0,,О, тәңірім.
Dialogue: 0,0:05:22.69,0:05:23.99,Default,,0,0,0,,«Мен ұйықтап жатырмын» деңіз
Dialogue: 0,0:05:24.07,0:05:26.99,Default,,0,0,0,,Жол бойы келгеніңмен.
Dialogue: 0,0:05:27.07,0:05:29.24,Default,,0,0,0,,Жарайды, мен сені көргім келмейді.
Dialogue: 0,0:05:30.99,0:05:34.75,Default,,0,0,0,,Кешіріңіз, Нанами қазір ваннада.
Dialogue: 0,0:05:34.83,0:05:37.25,Default,,0,0,0,,«ванна» деме, «ұйықтап жатыр» де.
Dialogue: 0,0:05:38.83,0:05:40.17,Default,,0,0,0,,Ha
Dialogue: 0,0:05:41.79,0:05:44.67,Default,,0,0,0,,Мен сені жаңа кездестірсем де, қорқынышты сөздерден басқа ештеңе айта алмаймын.
Dialogue: 0,0:05:50.01,0:05:51.10,Default,,0,0,0,,Күтіңіз
Dialogue: 0,0:05:51.97,0:05:54.77,Default,,0,0,0,,Білесің бе, мен сенің сезіміңді түсінемін.
Dialogue: 0,0:05:54.85,0:05:57.89,Default,,0,0,0,,Менің ойымша, әзірге оны жалғыз қалдырған дұрыс.
Dialogue: 0,0:05:57.98,0:06:02.11,Default,,0,0,0,,Кейде тынышталғаннан кейін бәрі оңайырақ болады.
Dialogue: 0,0:06:02.77,0:06:03.94,Default,,0,0,0,,Ертең Нанами де...
Dialogue: 0,0:06:04.03,0:06:05.61,Default,,0,0,0,,Ертең болатынына кепілдік бар ма?
Dialogue: 0,0:06:05.69,0:06:07.61,Default,,0,0,0,,(Сузуя) Ал сен неге Гульге айналдың?
Dialogue: 0,0:06:11.70,0:06:14.62,Default,,0,0,0,,Жарайды, онда бұл.
Dialogue: 0,0:06:15.87,0:06:17.37,Default,,0,0,0,,О, тәңірім.
Dialogue: 0,0:06:17.46,0:06:20.37,Default,,0,0,0,,Қандай әдемі гүл
Dialogue: 0,0:06:20.46,0:06:23.59,Default,,0,0,0,,Маған «Ертең мектепте» деп айтыңызшы.
Dialogue: 0,0:06:23.67,0:06:26.09,Default,,0,0,0,,Әй, үйге бара жатқанда абай бол.
Dialogue: 0,0:06:32.43,0:06:34.81,Default,,0,0,0,,Қандай әдемі гүл
Dialogue: 0,0:06:35.68,0:06:38.10,Default,,0,0,0,,Сонда да Нанами...
Dialogue: 0,0:06:38.18,0:06:40.31,Default,,0,0,0,,Ол жын сияқты
Dialogue: 0,0:06:41.27,0:06:42.11,Default,,0,0,0,,Ол ұзақ фильм сияқты көрінді, сондықтан мен оны көруге үлгермедім.
Dialogue: 0,0:06:42.19,0:06:46.11,Default,,0,0,0,,Қалай ойлайсың, осындай гүлдерді ұстай аласың ба?
Dialogue: 0,0:06:46.19,0:06:48.32,Default,,0,0,0,,Сен кіммен алдап жүрсің?
Dialogue: 0,0:06:49.11,0:06:51.07,Default,,0,0,0,,Бұл құрметсіздік емес.
Dialogue: 0,0:06:51.16,0:06:55.91,Default,,0,0,0,,Әлгі тентек бала өзінің бұрынғы қызының әпкесімен жыныстық қатынасқа түскен.
Dialogue: 0,0:06:55.99,0:06:58.45,Default,,0,0,0,,Бұл өте жақсы гүл.
Dialogue: 0,0:06:58.54,0:07:01.37,Default,,0,0,0,,Анаң сені үлкен қамқорлықпен өсірді ме деп ойлаймын.
Dialogue: 0,0:07:01.46,0:07:04.09,Default,,0,0,0,,Қараңдаршы, раушан гүлдері өте көп
Dialogue: 0,0:07:04.84,0:07:05.96,Default,,0,0,0,,Иә…♡
Dialogue: 0,0:07:06.84,0:07:10.09,Default,,0,0,0,,Ақымақ ақымақ ақымақ
Dialogue: 0,0:07:12.64,0:07:14.10,Default,,0,0,0,,5 йен
Dialogue: 0,0:07:14.18,0:07:16.64,Default,,0,0,0,,Бақшадан асығыс теріп алғанына сенімдімін.
Dialogue: 0,0:07:16.76,0:07:18.93,Default,,0,0,0,,Ол газетке абайсызда оралған...
Dialogue: 0,0:07:20.31,0:07:24.61,Default,,0,0,0,,Ол шынымен де осындай үлкен гүл шоғымен автобусқа отырды ма деп ойлаймын...
Dialogue: 0,0:07:30.65,0:07:32.74,Default,,0,0,0,,Мен де өткенді қайта жазғым келеді
Dialogue: 0,0:07:33.45,0:07:36.87,Default,,0,0,0,,Сен жыламасаң, мен не керек болса, соны істеймін
Dialogue: 0,0:07:43.04,0:07:44.71,Default,,0,0,0,,Асылған
Dialogue: 0,0:07:44.79,0:07:46.92,Default,,0,0,0,,Мен біраз уақытқа шығамын.
Dialogue: 0,0:07:47.00,0:07:49.09,Default,,0,0,0,,Осы сағатта? қайда барасың
Dialogue: 0,0:07:49.17,0:07:51.72,Default,,0,0,0,,Аялдамаға дейін (есіктің ашылу/жабылу дыбысы)
Dialogue: 0,0:07:51.80,0:07:52.72,Default,,0,0,0,,Уф
Dialogue: 0,0:07:52.80,0:07:54.26,Default,,0,0,0,,Бұл алдау.
Dialogue: 0,0:07:55.51,0:07:56.93,Default,,0,0,0,,Шынымен алдау
Dialogue: 0,0:07:58.22,0:07:59.43,Default,,0,0,0,,Басқа амал жоқ па?!
Dialogue: 0,0:07:59.52,0:08:01.23,Default,,0,0,0,,Бірақ Яно да...
Dialogue: 0,0:08:02.06,0:08:03.56,Default,,0,0,0,,Мүмкін бұл қиын болды...
Dialogue: 0,0:08:10.90,0:08:11.74,Default,,0,0,0,,Яно
Dialogue: 0,0:08:21.79,0:08:23.83,Default,,0,0,0,,Мен сені қатты мазақ еткім келді, бірақ
Dialogue: 0,0:08:25.00,0:08:27.50,Default,,0,0,0,,Мына сөздер ғана шығады
Dialogue: 0,0:08:33.51,0:08:35.09,Default,,0,0,0,,Мен сені сүйемін, ақымақ!
Dialogue: 0,0:08:48.19,0:08:50.65,Default,,0,0,0,,А, мен тәттімін
Dialogue: 0,0:08:52.82,0:08:55.45,Default,,0,0,0,,Мүмкін мен сені шынымен кешіре алмайтын шығармын.
Dialogue: 0,0:08:55.53,0:08:59.58,Default,,0,0,0,,Бірақ мен сенің жүзіңді көргенде: «Менде басқа амал жоқ» деп ойлаймын.
Dialogue: 0,0:08:59.66,0:09:02.16,Default,,0,0,0,,Бұл көңілсіз, бірақ мен сенімен бірге болғым келеді.
Dialogue: 0,0:09:02.87,0:09:04.91,Default,,0,0,0,,«Ғашық болсаң, ұтыласың»?
Dialogue: 0,0:09:05.00,0:09:05.87,Default,,0,0,0,,Иә
Dialogue: 0,0:09:05.96,0:09:09.92,Default,,0,0,0,,Мизучин бірде: ''Сен өлген адаммен бәсекеге түсе алмайсың'' деді.
Dialogue: 0,0:09:11.50,0:09:13.34,Default,,0,0,0,,Бірақ өткенді өзгерте алмайсың
Dialogue: 0,0:09:13.42,0:09:17.18,Default,,0,0,0,,Онда тек қазір бақытты болуды ойлау керек.
Dialogue: 0,0:09:18.59,0:09:20.26,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:09:20.35,0:09:21.43,Default,,0,0,0,,Иә
Dialogue: 0,0:09:22.77,0:09:25.02,Default,,0,0,0,,Яно Нана-санды жек көреді
Dialogue: 0,0:09:26.60,0:09:28.90,Default,,0,0,0,,Мен Нананы жек көремін.
Dialogue: 0,0:09:30.86,0:09:33.65,Default,,0,0,0,,Мен өлгендер туралы жаман сөз айтқым келмейді, бірақ
Dialogue: 0,0:09:34.36,0:09:37.07,Default,,0,0,0,,Мен сені ешқашан кездестірмедім, бірақ...
Dialogue: 0,0:09:37.86,0:09:39.37,Default,,0,0,0,,Нана алдап жатыр
Dialogue: 0,0:09:40.24,0:09:42.66,Default,,0,0,0,,Сондықтан мен Яноны қуантамын.
Dialogue: 0,0:09:43.49,0:09:44.87,Default,,0,0,0,,Хмм.
Dialogue: 0,0:09:44.95,0:09:47.00,Default,,0,0,0,,Аа, сен ақымақ сияқтысың ба?
Dialogue: 0,0:09:47.08,0:09:49.25,Default,,0,0,0,,Жоқ, бұл тамаша хаха
Dialogue: 0,0:09:49.33,0:09:50.75,Default,,0,0,0,,Хехехе
Dialogue: 0,0:09:50.84,0:09:53.50,Default,,0,0,0,,Бірақ мен сізге кеңес бере аламын ба?
Dialogue: 0,0:09:53.59,0:09:54.71,Default,,0,0,0,,Иә
Dialogue: 0,0:09:56.30,0:09:58.51,Default,,0,0,0,,Бұл жай ғана махаббат болса
Dialogue: 0,0:09:59.59,0:10:00.93,Default,,0,0,0,,Жоқ
Dialogue: 0,0:10:08.48,0:10:09.60,Default,,0,0,0,,Неліктен...?
Dialogue: 0,0:10:15.07,0:10:17.15,Default,,0,0,0,,Бақытты бол
Dialogue: 0,0:10:22.91,0:10:25.49,Default,,0,0,0,,Жексенбіде қайда барасыз? Ой, хайуанаттар бағына барайық.
Dialogue: 0,0:10:25.58,0:10:27.87,Default,,0,0,0,,Бұрын мен: «Хайуанаттар бағына барайық» дегенімде.
Dialogue: 0,0:10:27.96,0:10:29.37,Default,,0,0,0,,Мазақтасам да
Dialogue: 0,0:10:29.46,0:10:32.00,Default,,0,0,0,,Жарайды, маймыл, маймылды көрейік.
Dialogue: 0,0:10:32.79,0:10:34.63,Default,,0,0,0,,Мен өзімді маймыл сияқты сезінбеймін
Dialogue: 0,0:10:35.13,0:10:36.46,Default,,0,0,0,,Сонымен, өзіңізді қалай сезінесіз?
Dialogue: 0,0:10:36.55,0:10:38.30,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:38.38,0:10:39.22,Default,,0,0,0,,Теңіз!
Dialogue: 0,0:10:42.64,0:10:44.47,Default,,0,0,0,,Жоқ? (Яно) Иә.
Dialogue: 0,0:10:47.73,0:10:49.69,Default,,0,0,0,,Әйелдер теңізді жақсы көреді, солай ма?
Dialogue: 0,0:10:54.82,0:10:58.07,Default,,0,0,0,,Мына жердегі теңіз фотода көріп тұрған теңіздей емес, жарай ма?
Dialogue: 0,0:10:59.36,0:11:00.57,Default,,0,0,0,,Иә
Dialogue: 0,0:11:00.65,0:11:02.66,Default,,0,0,0,,Олай болса теңізге барайық
Dialogue: 0,0:11:05.28,0:11:06.62,Default,,0,0,0,,Хахаха
Dialogue: 0,0:11:06.70,0:11:10.33,Default,,0,0,0,,Егер адамдар басынан бастаса,
Dialogue: 0,0:11:11.92,0:11:14.50,Default,,0,0,0,,Мен басқа өмірді таңдар ма едім?
Dialogue: 0,0:11:16.00,0:11:16.96,Default,,0,0,0,,Егер менің шарттарыма келіссең, мен жүрегіңді жазып, қайта тірілтамын.
Dialogue: 0,0:11:17.05,0:11:18.51,Default,,0,0,0,,Гах, тоқтат.
Dialogue: 0,0:11:18.59,0:11:19.92,Default,,0,0,0,,Қараңдар, қараңдар, ахаха
Dialogue: 0,0:11:20.80,0:11:22.89,Default,,0,0,0,,Кімді кездестіретініңізді таңдаңыз...
Dialogue: 0,0:11:22.97,0:11:25.64,Default,,0,0,0,,(шағала дыбысы)
Dialogue: 0,0:11:25.72,0:11:28.43,Default,,0,0,0,,Сізді бақытты ететін нәрсені ғана таңдаңыз
Dialogue: 0,0:11:28.52,0:11:30.73,Default,,0,0,0,,Жылтыр және әдемі
Dialogue: 0,0:11:30.81,0:11:31.77,Default,,0,0,0,,Сізге жақсы.
Dialogue: 0,0:11:31.85,0:11:33.23,Default,,0,0,0,,Әрине! Отелло ойнайық.
Dialogue: 0,0:11:33.31,0:11:35.44,Default,,0,0,0,,Иә, иә, жақсы, жақсы.
Dialogue: 0,0:11:35.52,0:11:36.44,Default,,0,0,0,,Қазірдің өзінде...
Dialogue: 0,0:11:38.90,0:11:40.19,Default,,0,0,0,,Онда ешкім жоқ.
Dialogue: 0,0:11:40.28,0:11:43.45,Default,,0,0,0,,Мен сонда төсек жасай алатындай сезінемін.
Dialogue: 0,0:11:43.53,0:11:44.74,Default,,0,0,0,,Бұл
Dialogue: 0,0:11:44.82,0:11:46.78,Default,,0,0,0,,Хе-хе-хе…
Dialogue: 0,0:11:46.87,0:11:48.79,Default,,0,0,0,,Тек бақытты нәрселер
Dialogue: 0,0:11:49.54,0:11:52.67,Default,,0,0,0,,Олай болса, бұл қаншалықты жақсы болар еді?
Dialogue: 0,0:11:55.29,0:11:57.63,Default,,0,0,0,,Теңіз раковиналарын жинайық Мен бөтелке әкелдім
Dialogue: 0,0:11:57.71,0:11:59.00,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:11:59.09,0:12:01.09,Default,,0,0,0,,Ол әдемі пішінді болуы керек.
Dialogue: 0,0:12:01.17,0:12:02.63,Default,,0,0,0,,Жоқ емес.
Dialogue: 0,0:12:02.72,0:12:04.93,Default,,0,0,0,,Осы заттардың барлығымен не істеуім керек?
Dialogue: 0,0:12:05.01,0:12:06.30,Default,,0,0,0,,Есіңізде ме?
Dialogue: 0,0:12:07.56,0:12:09.35,Default,,0,0,0,,Такахаши, мен мұны айта аламын ба?
Dialogue: 0,0:12:09.43,0:12:10.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:10.93,0:12:12.06,Default,,0,0,0,,Трусиктер көрінеді
Dialogue: 0,0:12:13.69,0:12:15.52,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:21.36,0:12:23.61,Default,,0,0,0,,Шие гүлінің ұлусы жоқ.
Dialogue: 0,0:12:23.70,0:12:24.66,Default,,0,0,0,,Сакургай?
Dialogue: 0,0:12:24.74,0:12:26.87,Default,,0,0,0,,қызғылт
Dialogue: 0,0:12:26.95,0:12:30.16,Default,,0,0,0,,Менің ойымша, бұлай әзіл айту үшін оңтүстікке қарай жүру керек.
Dialogue: 0,0:12:30.70,0:12:31.87,Default,,0,0,0,,О, бұл не?
Dialogue: 0,0:12:45.38,0:12:46.39,Default,,0,0,0,,Иә
Dialogue: 0,0:12:46.47,0:12:47.55,Default,,0,0,0,,Не?
Dialogue: 0,0:12:47.64,0:12:49.51,Default,,0,0,0,,Яно қытықтайды
Dialogue: 0,0:12:50.06,0:12:51.14,Default,,0,0,0,,Не?
Dialogue: 0,0:12:51.22,0:12:52.68,Default,,0,0,0,,Не...
Dialogue: 0,0:12:54.27,0:12:55.77,Default,,0,0,0,,Не дедің, жауыз бала! (Киришима & Серо) Қайтып келдік.
Dialogue: 0,0:12:55.85,0:12:57.77,Default,,0,0,0,,Такахаши Бұл фунамуши Фунамуши (Нанами) жылы! Мен оны ұнатпаймын!
Dialogue: 0,0:12:57.86,0:13:00.02,Default,,0,0,0,,Жоқ, жоқ, жоқ!
Dialogue: 0,0:13:00.11,0:13:01.78,Default,,0,0,0,,Ха, мен сені пышақтамаймын, олай болса...
Dialogue: 0,0:13:03.49,0:13:07.82,Default,,0,0,0,,Ахх, қателер! Мұнда да! Жоқ, жоқ, үйге бар, үйге бар!
Dialogue: 0,0:13:19.54,0:13:20.63,Default,,0,0,0,,Яно?
Dialogue: 0,0:13:21.96,0:13:24.59,Default,,0,0,0,,Кешіріңіз, мен тым көп шу шығарып жатырмын...
Dialogue: 0,0:13:25.97,0:13:26.80,Default,,0,0,0,,Бірақ мұндағы олардың ойып жазғандары ұзақ уақыттан бері ұмыт қалды, және мұнда енді дұғалар айтылмайды.
Dialogue: 0,0:13:26.88,0:13:29.22,Default,,0,0,0,,Не? Сіз жаңа ғана келдіңіз
Dialogue: 0,0:13:29.30,0:13:31.43,Default,,0,0,0,,Сіз жәндіктерді жек көресіз, солай ма?
Dialogue: 0,0:13:31.51,0:13:33.97,Default,,0,0,0,,Маған ұнамайды...
Dialogue: 0,0:13:34.48,0:13:36.52,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:13:39.06,0:13:42.15,Default,,0,0,0,,Сен мені кіммен шатастырасың?
Dialogue: 0,0:13:44.86,0:13:45.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:48.45,0:13:49.99,Default,,0,0,0,,Нана-сан туралы
Dialogue: 0,0:13:50.87,0:13:52.33,Default,,0,0,0,,Оны ұмытайық
Dialogue: 0,0:13:59.04,0:14:01.09,Default,,0,0,0,,Нана алдап жатыр
Dialogue: 0,0:14:01.17,0:14:04.80,Default,,0,0,0,,Ол өтірік айтты, сатқындық жасады және Яноны жалғыз қалдырды.
Dialogue: 0,0:14:07.88,0:14:11.85,Default,,0,0,0,,Яноның ашулануы табиғи нәрсе, оның кек сақтауы да табиғи нәрсе.
Dialogue: 0,0:14:11.93,0:14:13.89,Default,,0,0,0,,Мен ең болмағанда бір нәрсеге шағымданғым келеді.
Dialogue: 0,0:14:13.97,0:14:15.06,Default,,0,0,0,,Бірақ мен оны айта алмаймын.
Dialogue: 0,0:14:15.14,0:14:17.94,Default,,0,0,0,,Өйткені Нана-сан өлген жоқ.
Dialogue: 0,0:14:20.15,0:14:22.57,Default,,0,0,0,,Енді айтайық, Яно.
Dialogue: 0,0:14:22.65,0:14:24.69,Default,,0,0,0,,Иә? Не?
Dialogue: 0,0:14:24.78,0:14:27.82,Default,,0,0,0,,Менің айтқым келгені, жек көретін сөздер немесе басқалары.
Dialogue: 0,0:14:28.57,0:14:30.28,Default,,0,0,0,,Енді істейтін ештеңе жоқ.
Dialogue: 0,0:14:30.36,0:14:33.91,Default,,0,0,0,,Жоқ, сіз айтқыңыз келген нәрсе болуы керек.
Dialogue: 0,0:14:33.99,0:14:36.41,Default,,0,0,0,,Шулы.
Dialogue: 0,0:14:42.88,0:14:46.01,Default,,0,0,0,,«Жеркенішті ақымақ, өл.»
Dialogue: 0,0:14:46.09,0:14:48.42,Default,,0,0,0,,Нанами мұқият тыңдайды.
Dialogue: 0,0:14:50.09,0:14:53.80,Default,,0,0,0,,Нана осында болса, сен не айтар едің?
Dialogue: 0,0:14:56.60,0:14:58.56,Default,,0,0,0,,Егер осында болса
Dialogue: 0,0:15:02.31,0:15:03.94,Default,,0,0,0,,Егер Нана сонда болса
Dialogue: 0,0:15:16.16,0:15:17.49,Default,,0,0,0,,Тек қарап тұр.
Dialogue: 0,0:15:26.46,0:15:27.38,Default,,0,0,0,,Сәлем, балалар.
Dialogue: 0,0:15:27.46,0:15:29.42,Default,,0,0,0,,Ол Юриймен бір сыныпта оқиды, солай ма?
Dialogue: 0,0:15:30.05,0:15:32.30,Default,,0,0,0,,Кешіріңіз, бірақ сіз маған қарызға ақша бере аласыз ба?
Dialogue: 0,0:15:32.38,0:15:34.76,Default,,0,0,0,,Ол төлемей кетіп қалды...
Dialogue: 0,0:15:34.85,0:15:37.51,Default,,0,0,0,,Міне, мен «соқыр» деп атаймын.
Dialogue: 0,0:15:37.60,0:15:40.35,Default,,0,0,0,,Мен ешкімді шынымен жақсы көрмесем де
Dialogue: 0,0:15:40.43,0:15:42.98,Default,,0,0,0,,Мұндайды «көк есек» деп атайды.
Dialogue: 0,0:15:43.56,0:15:45.48,Default,,0,0,0,,Сен де жақын арада ғашық боласың деп үміттенемін
Dialogue: 0,0:15:51.03,0:15:52.36,Default,,0,0,0,,Сіз әлі ол келеді деп ойлайсыз ба?
Dialogue: 0,0:15:53.16,0:15:54.11,Default,,0,0,0,,Ол келмейді.
Dialogue: 0,0:15:54.20,0:15:55.70,Default,,0,0,0,,Онда неге күтіп отырсың?
Dialogue: 0,0:15:55.78,0:15:57.41,Default,,0,0,0,,Ашуды жинақтау
Dialogue: 0,0:15:59.50,0:16:02.71,Default,,0,0,0,,Апа, бұл жылытқыш емес, бұл сусын.
Dialogue: 0,0:16:02.79,0:16:05.79,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:16:11.88,0:16:14.68,Default,,0,0,0,,Эй, мен не істеуім керек деп ойлайсың?
Dialogue: 0,0:16:14.76,0:16:17.93,Default,,0,0,0,,Иә? өзің туралы ойла
Dialogue: 0,0:16:18.01,0:16:20.47,Default,,0,0,0,,Өйткені сен ақымақсың, түсінбейсің.
Dialogue: 0,0:16:22.35,0:16:23.98,Default,,0,0,0,,Мен сізге айта аламын.
Dialogue: 0,0:16:24.81,0:16:28.07,Default,,0,0,0,,Оның орнына сіз өз айтқаныңызды орындайсыз ба?
Dialogue: 0,0:16:29.44,0:16:32.90,Default,,0,0,0,,Бұл... мені бақытты ете ме?
Dialogue: 0,0:16:33.86,0:16:36.41,Default,,0,0,0,,Бақыт деген не?
Dialogue: 0,0:16:37.78,0:16:38.95,Default,,0,0,0,,Мен білмеймін...
Dialogue: 0,0:16:39.95,0:16:40.91,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:16:41.79,0:16:44.16,Default,,0,0,0,,Ешкім жыламайды, ашуланбайды.
Dialogue: 0,0:16:44.25,0:16:49.00,Default,,0,0,0,,Заттарды соғуға немесе лақтыруға болмайды. Бұл дұрыс емес пе?
Dialogue: 0,0:16:49.59,0:16:50.59,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:16:50.67,0:16:52.05,Default,,0,0,0,,Не?
Dialogue: 0,0:16:53.55,0:16:54.47,Default,,0,0,0,,(Изуку) Ка… Качан! Бұл емтиханда мұғалім жаман кейіпкер рөлін сомдап отыр,
Dialogue: 0,0:16:55.76,0:16:58.35,Default,,0,0,0,,Бақытты бірге табамыз ба?
Dialogue: 0,0:17:03.56,0:17:05.98,Default,,0,0,0,,Менімен қазір кездессең не дер едің?
Dialogue: 0,0:17:07.02,0:17:08.90,Default,,0,0,0,,Өз ойларыңызды айтыңыз
Dialogue: 0,0:17:12.36,0:17:13.19,Default,,0,0,0,,Сіз...
Dialogue: 0,0:17:13.28,0:17:15.03,Default,,0,0,0,,Сіз өтірікшісіз
Dialogue: 0,0:17:15.11,0:17:17.78,Default,,0,0,0,,Сіздің айтқаныңыз бен істегеніңіз қарама-қайшылыққа толы.
Dialogue: 0,0:17:19.28,0:17:21.49,Default,,0,0,0,,Мен саған опасыздық жасамаймын деп уәде беремін бе?
Dialogue: 0,0:17:22.12,0:17:24.41,Default,,0,0,0,,Сен маған ешқашан опасыздық жасамайсың...
Dialogue: 0,0:17:26.62,0:17:27.75,Default,,0,0,0,,Иә
Dialogue: 0,0:17:27.83,0:17:29.75,Default,,0,0,0,,Ешқашан екінші рет болмайды.
Dialogue: 0,0:17:30.50,0:17:31.84,Default,,0,0,0,,Тек қарап тұр.
Dialogue: 0,0:17:53.78,0:17:54.82,Default,,0,0,0,,Яно
Dialogue: 0,0:18:04.41,0:18:06.46,Default,,0,0,0,,Мен қатты ғашық болған әйел...
Dialogue: 0,0:18:08.71,0:18:10.46,Default,,0,0,0,,Сіз мені жек көре алмайсыз, солай ма?
Dialogue: 0,0:18:11.50,0:18:12.42,Default,,0,0,0,,Көрсеткі…
Dialogue: 0,0:18:18.30,0:18:19.47,Default,,0,0,0,,Барлығы
Dialogue: 0,0:18:22.01,0:18:23.14,Default,,0,0,0,,Мен сені кешіремін
Dialogue: 0,0:18:29.31,0:18:32.27,Default,,0,0,0,,Сондықтан мен сенің тірі оралуыңды қалаймын.
Dialogue: 0,0:18:36.86,0:18:38.49,Default,,0,0,0,,Тірі қайт...
Dialogue: 0,0:18:56.84,0:18:59.59,Default,,0,0,0,,Сондықтан мен Яноны қуантамын.
Dialogue: 0,0:19:01.01,0:19:04.01,Default,,0,0,0,,«Өткенге» жеңілмейтін «қазірді» жасайық.
Dialogue: 0,0:19:04.85,0:19:06.93,Default,,0,0,0,,Жұлдыздарға ант етемін
Dialogue: 0,0:19:07.02,0:19:08.27,Default,,0,0,0,,Аққан жұлдыз түскенде
Dialogue: 0,0:19:08.35,0:19:11.60,Default,,0,0,0,,Нана екеуің мәңгі бірге боласыңдар деп үміттенемін.
Dialogue: 0,0:19:18.28,0:19:19.11,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:19:19.19,0:19:20.61,Default,,0,0,0,,Өтірікші
Dialogue: 0,0:19:22.61,0:19:24.07,Default,,0,0,0,,Өтірікші
Dialogue: 0,0:19:26.29,0:19:27.91,Default,,0,0,0,,Өтірікші
Dialogue: 0,0:19:29.41,0:19:30.75,Default,,0,0,0,,Өтірікші
Dialogue: 0,0:19:47.35,0:19:48.47,Default,,0,0,0,,Яно
Dialogue: 0,0:19:49.47,0:19:52.10,Default,,0,0,0,,Мен мұны енді істей алмаймын.
Dialogue: 0,0:19:59.44,0:20:02.32,Default,,0,0,0,,Мен Яноны бақытты ете алмаймын
Dialogue: 0,0:20:09.95,0:20:12.75,Default,,0,0,0,,Уәдеде тұра алмағаным үшін кешіріңіз.
Dialogue: 0,0:20:25.47,0:20:27.01,Default,,0,0,0,,Яноның тілегі
Dialogue: 0,0:20:27.80,0:20:29.93,Default,,0,0,0,,Бұл әлдеқашан шешілді...
Dialogue: 0,0:20:40.36,0:20:41.61,Default,,0,0,0,,Такахаши
Dialogue: 0,0:20:45.78,0:20:47.03,Default,,0,0,0,,Нана-чан
Dialogue: 0,0:20:50.74,0:20:51.70,Default,,0,0,0,,Нана
Dialogue: 0,0:20:58.42,0:20:59.80,Default,,0,0,0,,Нана…
Dialogue: 0,0:21:00.50,0:21:02.05,Default,,0,0,0,,Мен сені жек көруім керек
Dialogue: 0,0:21:02.13,0:21:05.09,Default,,0,0,0,,Себебі мен қайғыдан басымды сезінемін
Dialogue: 0,0:21:05.18,0:21:07.64,Default,,0,0,0,,Бұл Яноның өзін-өзі қорғауы
Dialogue: 0,0:21:09.30,0:21:10.81,Default,,0,0,0,,Уәде алынды
Dialogue: 0,0:21:12.60,0:21:15.23,Default,,0,0,0,,Сіз мені ешқашан тастамайсыз
Dialogue: 0,0:21:18.31,0:21:22.28,Default,,0,0,0,,Неліктен адамдар орындай алмайтын уәде береді?
Dialogue: 0,0:21:29.95,0:21:31.79,Default,,0,0,0,,Саған кім опасыздық жасады?
Dialogue: 0,0:21:54.77,0:21:56.06,Default,,0,0,0,,Юри-чан
Dialogue: 0,0:21:59.69,0:22:01.77,Default,,0,0,0,,Мені тастап кетті
Dialogue: 0,0:22:03.73,0:22:04.82,Default,,0,0,0,,Қанағаттанды ма?
Dialogue: 0,0:22:08.53,0:22:10.74,Default,,0,0,0,,Сол кезде де «Қараңдар» деп айтпадың ба?
Dialogue: 0,0:22:12.95,0:22:14.04,Default,,0,0,0,,Хмм.
Dialogue: 0,0:22:15.37,0:22:18.00,Default,,0,0,0,,Такахаши мырзаның да жігері жоқ екені таң қалдырады.
Dialogue: 0,0:22:22.59,0:22:25.01,Default,,0,0,0,,Сені тағы жұбатуымды қалайсың ба?
Dialogue: 0,0:22:30.09,0:22:31.01,Default,,0,0,0,,Иә
Dialogue: 0,0:22:31.09,0:22:33.51,Default,,0,0,0,,Мен енді ешқашан сенің қолыңа баспаймын.
Dialogue: 0,0:22:55.45,0:22:57.83,Default,,0,0,0,,Барлығы түс көрді
Dialogue: 0,0:23:00.29,0:23:02.38,Default,,0,0,0,,Бақытты армандар
Dialogue: 0,0:23:02.46,0:23:07.46,Default,,0,0,0,,♪～
Dialogue: 0,0:24:48.40,0:24:53.40,Default,,0,0,0,,～♪
Dialogue: 0,0:25:07.50,0:25:09.38,Default,,0,0,0,,Мен қазір өлгенше өкінемін.
Dialogue: 0,0:25:09.46,0:25:12.63,Default,,0,0,0,,Сол кезде, сол көріністе мен таңдаған әрекет
Dialogue: 0,0:25:12.71,0:25:15.38,Default,,0,0,0,,Мен таңдаған сөздер әрқашан қателерге толы.
Dialogue: 0,0:25:16.01,0:25:17.26,Default,,0,0,0,,Бірақ мені тыңдағаныңызды қалаймын.
Dialogue: 0,0:25:17.72,0:25:18.55,Default,,0,0,0,,Такахаши
Dialogue: 0,0:25:18.64,0:25:20.47,Default,,0,0,0,,Мен сенмін...
Dialogue: 0,0:25:21.64,0:25:24.27,Default,,0,0,0,,Сол күні таңертең ультиматум болды.
Dialogue: 0,0:25:25.39,0:25:26.27,Default,,0,0,0,,«Мен өкінемін»
Dialogue: 0,0:25:26.35,0:25:27.69,Default,,0,0,0,,Мен саған айттым ба?
Dialogue: 0,0:25:28.40,0:25:29.44,Default,,0,0,0,,Оны сыныптар бойынша айналмалы турнир деп атайды.
Dialogue: 0,0:25:30.69,0:25:32.19,Default,,0,0,0,,Артық емес
Dialogue: 0,0:25:32.28,0:25:33.44,Default,,0,0,0,,Сурет салу мүмкін емес
Dialogue: 0,0:25:34.94,0:25:40.94,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
