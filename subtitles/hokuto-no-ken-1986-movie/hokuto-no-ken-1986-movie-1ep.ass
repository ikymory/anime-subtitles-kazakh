Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:27.19,0:00:29.98,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:00:37.49,0:00:41.49,Default,,0,0,0,,Аспанда екі полярлық жұлдыз бар
Dialogue: 0,0:00:42.08,0:00:46.08,Default,,0,0,0,,Яғни, Хокуто және Нанто
Dialogue: 0,0:00:47.58,0:00:51.13,Default,,0,0,0,,Әлем екі полюстен тұратын жұп.
Dialogue: 0,0:00:51.25,0:00:54.92,Default,,0,0,0,,Ер мен әйел, Инь мен Ян
Dialogue: 0,0:00:55.93,0:00:58.22,Default,,0,0,0,,Шикариге қастандық
Dialogue: 0,0:00:59.18,0:01:03.60,Default,,0,0,0,,Хокуто Шинкен және Нанто Сейкен
Dialogue: 0,0:01:06.02,0:01:07.98,Default,,0,0,0,,Ұрысуға болмайды
Dialogue: 0,0:01:08.10,0:01:10.98,Default,,0,0,0,,Біз соғыссақ, бұл дүние жойылады.
Dialogue: 0,0:01:11.44,0:01:14.53,Default,,0,0,0,,Солтүстік пен Оңтүстік бір болған кезде
Dialogue: 0,0:01:14.90,0:01:17.66,Default,,0,0,0,,Мәсіхтің пайда болуы
Dialogue: 0,0:01:20.87,0:01:26.87,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:03:32.33,0:03:38.34,Default,,0,0,0,,~♪
Dialogue: 0,0:03:57.52,0:03:59.40,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:04:30.72,0:04:34.31,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:06:11.20,0:06:13.03,Default,,0,0,0,,Бұл жер бұрын теңіз болған
Dialogue: 0,0:06:13.53,0:06:17.04,Default,,0,0,0,,Бірақ қазір өмірдің бір сынығы да қалмады.
Dialogue: 0,0:06:17.54,0:06:18.96,Default,,0,0,0,,Менің көргім келеді
Dialogue: 0,0:06:20.12,0:06:24.30,Default,,0,0,0,,Жер көгеріп, теңіз балыққа қайтатын күнге сенемін.
Dialogue: 0,0:06:29.68,0:06:30.68,Default,,0,0,0,,Юлия…
Dialogue: 0,0:06:41.23,0:06:42.15,Default,,0,0,0,,Шин
Dialogue: 0,0:06:48.15,0:06:48.99,Default,,0,0,0,,Шин!
Dialogue: 0,0:06:49.36,0:06:53.57,Default,,0,0,0,,Билік – әділдік. Бұл жақсы уақыттар.
Dialogue: 0,0:07:01.17,0:07:05.50,Default,,0,0,0,,Мықтылар ойланбастан қалағанын алады.
Dialogue: 0,0:07:05.96,0:07:07.96,Default,,0,0,0,,Ах... Шин! Алыста!
Dialogue: 0,0:07:08.09,0:07:09.51,Default,,0,0,0,,Жолдан кет! Апыр-ай!
Dialogue: 0,0:07:09.63,0:07:10.84,Default,,0,0,0,,Кенширо
Dialogue: 0,0:07:10.93,0:07:14.39,Default,,0,0,0,,Хокуто Шинкеннің мұрагері болғаныңызды естідім.
Dialogue: 0,0:07:14.51,0:07:16.89,Default,,0,0,0,,Бірақ ол Нанто Сейкеннің жауы емес!
Dialogue: 0,0:07:17.52,0:07:21.77,Default,,0,0,0,,Шин «Солтүстік пен Оңтүстік соғыспауы керек». Бұл заң екенін ұмыттыңыз ба?
Dialogue: 0,0:07:22.15,0:07:25.69,Default,,0,0,0,,Мен бұл бос сөзді баяғыда ұмытып кетіппін!
Dialogue: 0,0:07:27.19,0:07:28.86,Default,,0,0,0,,Күрсін!
Dialogue: 0,0:07:31.86,0:07:33.24,Default,,0,0,0,,Ей, не істеп жатырсың?
Dialogue: 0,0:07:41.04,0:07:41.96,Default,,0,0,0,,Хехехе
Dialogue: 0,0:07:44.04,0:07:44.96,Default,,0,0,0,,Ха...
Dialogue: 0,0:07:45.25,0:07:48.13,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:07:48.50,0:07:50.97,Default,,0,0,0,,Уау...
Dialogue: 0,0:07:51.63,0:07:54.51,Default,,0,0,0,,Уау...
Dialogue: 0,0:07:54.80,0:07:56.60,Default,,0,0,0,,Нанто Гоку Сацукен
Dialogue: 0,0:07:57.97,0:08:01.27,Default,,0,0,0,,Ах... Кенширо!
Dialogue: 0,0:08:02.44,0:08:05.27,Default,,0,0,0,,Кенширо... Кенширо!
Dialogue: 0,0:08:15.45,0:08:16.95,Default,,0,0,0,,Титанның денесіне киінген адам
Dialogue: 0,0:08:17.07,0:08:20.08,Default,,0,0,0,,Бұл Хокуто Шинкеннің мұрагері ме? Бауырым!
Dialogue: 0,0:08:22.46,0:08:24.25,Default,,0,0,0,,Ке… Кенширо
Dialogue: 0,0:08:24.75,0:08:26.75,Default,,0,0,0,,Мен саған ешқашан осы туралы сұрастырамын деп айтқан жоқпын
Dialogue: 0,0:08:29.09,0:08:33.34,Default,,0,0,0,,Кенширо, сен мені жеңе алмайсың.
Dialogue: 0,0:08:33.67,0:08:37.26,Default,,0,0,0,,Сіз бен менің арамызда өлімге әкелетін айырмашылық бар.
Dialogue: 0,0:08:37.39,0:08:40.31,Default,,0,0,0,,Бұл тілек
Dialogue: 0,0:08:40.43,0:08:41.27,Default,,0,0,0,,Және…
Dialogue: 0,0:08:42.14,0:08:43.68,Default,,0,0,0,,Ойлану!
Dialogue: 0,0:08:45.52,0:08:46.73,Default,,0,0,0,,Кен Шин
Dialogue: 0,0:08:46.85,0:08:49.86,Default,,0,0,0,,Балалар, кішкентай кезіңнен аға-інідей болып өстіңдер.
Dialogue: 0,0:08:49.98,0:08:51.90,Default,,0,0,0,,Сіздің шеберіңізден де.
Dialogue: 0,0:08:52.03,0:08:54.28,Default,,0,0,0,,«Солтүстік пен Оңтүстік ешқашан соғыспауы керек»
Dialogue: 0,0:08:54.40,0:08:56.28,Default,,0,0,0,,сөгіс алу керек еді
Dialogue: 0,0:08:56.99,0:09:01.04,Default,,0,0,0,,Юрия, сен Нанто Сейкен қаны бар әйелсің.
Dialogue: 0,0:09:02.58,0:09:04.21,Default,,0,0,0,,Түсінбейсің бе, Юлия?
Dialogue: 0,0:09:04.33,0:09:07.00,Default,,0,0,0,,Мен сені көптен бері жақсы көремін
Dialogue: 0,0:09:08.00,0:09:11.05,Default,,0,0,0,,Бауырлар Біз Хокуто Шинкен бір баладан тұқым қуалайды.
Dialogue: 0,0:09:11.17,0:09:13.80,Default,,0,0,0,,Менің орнымды бір адам ғана баса алады.
Dialogue: 0,0:09:13.92,0:09:17.09,Default,,0,0,0,,Бірақ мұрагер Кенширо әлі де солай.
Dialogue: 0,0:09:17.47,0:09:21.39,Default,,0,0,0,,Сіз Кеншироға дәстүрді жалғастырып, үндемей қалуға рұқсат бересіз бе?
Dialogue: 0,0:09:24.02,0:09:26.14,Default,,0,0,0,,Мен оны білемін.
Dialogue: 0,0:09:26.27,0:09:29.61,Default,,0,0,0,,Хокуто Шинкеннің мұрагері үшін шайқаста жеңілген адам
Dialogue: 0,0:09:29.73,0:09:31.77,Default,,0,0,0,,Қандай тағдырыңыз болды?
Dialogue: 0,0:09:32.32,0:09:34.24,Default,,0,0,0,,Кейбіреулердің жұдырығы қысылып қалады.
Dialogue: 0,0:09:34.69,0:09:37.24,Default,,0,0,0,,Кейбіреулердің естеліктері де алынып тасталды.
Dialogue: 0,0:09:37.45,0:09:39.74,Default,,0,0,0,,Сен әлі үндемейсің бе, Раох?
Dialogue: 0,0:09:44.95,0:09:48.17,Default,,0,0,0,,Кенширо Десир – күшке жетелейді
Dialogue: 0,0:09:48.29,0:09:50.25,Default,,0,0,0,,Сізде ондай жоқ.
Dialogue: 0,0:09:50.67,0:09:51.59,Default,,0,0,0,,Кен!
Dialogue: 0,0:09:52.21,0:09:56.63,Default,,0,0,0,,Кенширо, сен тәтті мінезіңмен бұл дәуірде өмір сүре алмайсың.
Dialogue: 0,0:09:56.76,0:10:00.18,Default,,0,0,0,,Юлияны бақытты ете алатын жалғыз мен ғана.
Dialogue: 0,0:10:00.30,0:10:01.89,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:10:02.60,0:10:06.81,Default,,0,0,0,,Юлия, мені жақсы көретініңді айт.
Dialogue: 0,0:10:07.18,0:10:09.77,Default,,0,0,0,,Мен Кеншироны жақсы көремін
Dialogue: 0,0:10:09.90,0:10:12.02,Default,,0,0,0,,Кенді өлтірсең, мен де өлемін!
Dialogue: 0,0:10:12.15,0:10:14.69,Default,,0,0,0,,Әй, сен мұны шынымен айтқың келмейді ме?
Dialogue: 0,0:10:15.36,0:10:16.24,Default,,0,0,0,,Әй!
Dialogue: 0,0:10:26.12,0:10:27.58,Default,,0,0,0,,Хмф! Апыр-ай!
Dialogue: 0,0:10:27.71,0:10:28.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:34.00,0:10:36.63,Default,,0,0,0,,Иә! Уф, уау!
Dialogue: 0,0:10:38.67,0:10:41.30,Default,,0,0,0,,Хехе, мен неше рет өлемін?
Dialogue: 0,0:10:46.02,0:10:46.89,Default,,0,0,0,,Хмф!
Dialogue: 0,0:10:47.39,0:10:48.93,Default,,0,0,0,,Ке... Кенширо!
Dialogue: 0,0:10:50.19,0:10:52.61,Default,,0,0,0,,Мені тек сен ғана тоқтата аласың
Dialogue: 0,0:10:52.77,0:10:55.86,Default,,0,0,0,,Сіздің бір ауыз сөзіңіз жеткілікті
Dialogue: 0,0:10:56.11,0:10:58.74,Default,,0,0,0,,Мәжбүр емес, өз еркіңмен айт
Dialogue: 0,0:11:00.03,0:11:04.12,Default,,0,0,0,,Ши... Шин Өлтіргің келсе тез өлтір.
Dialogue: 0,0:11:04.95,0:11:10.16,Default,,0,0,0,,Юлия, өлме, мен үшін өмір сүре бер.
Dialogue: 0,0:11:10.29,0:11:11.79,Default,,0,0,0,,Жақсы, мен сені өлтіремін.
Dialogue: 0,0:11:11.92,0:11:14.46,Default,,0,0,0,,Өл! Апыр-ай!
Dialogue: 0,0:11:14.59,0:11:18.51,Default,,0,0,0,,Мен сенің бар болғаныңды бұрын кешіре алмадым.
Dialogue: 0,0:11:18.84,0:11:21.63,Default,,0,0,0,,Өл! Апыр-ай!
Dialogue: 0,0:11:26.64,0:11:28.31,Default,,0,0,0,,Бұл – Спидвагон қорының тікұшағы. Қонуға орын іздеп жүр.
Dialogue: 0,0:11:28.43,0:11:30.77,Default,,0,0,0,,Хмм... хмм?
Dialogue: 0,0:11:31.39,0:11:33.06,Default,,0,0,0,,Кел, Юлия!
Dialogue: 0,0:11:35.06,0:11:36.11,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:11:36.40,0:11:38.90,Default,,0,0,0,,Не? Мен сені ести алмаймын
Dialogue: 0,0:11:39.03,0:11:43.95,Default,,0,0,0,,Менің жүрегім осылай қозғалады деп ойлайсың ба, Юрия?
Dialogue: 0,0:11:44.32,0:11:47.83,Default,,0,0,0,,Махаббатымды қаласаң, анық айт!
Dialogue: 0,0:11:51.25,0:11:52.42,Default,,0,0,0,,Мен сені жақсы көремін!
Dialogue: 0,0:11:52.75,0:11:55.04,Default,,0,0,0,,Қайда жүрсең де, өмір бойы соңынан еремін.
Dialogue: 0,0:11:55.58,0:12:00.67,Default,,0,0,0,,Сондықтан Кенді өлтірме!
Dialogue: 0,0:12:02.38,0:12:06.05,Default,,0,0,0,,Хехе... Хахахаха!
Dialogue: 0,0:12:07.01,0:12:09.01,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:12:10.52,0:12:11.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:13.98,0:12:17.48,Default,,0,0,0,,Хехехе, естідің бе? Кенширо
Dialogue: 0,0:12:17.94,0:12:20.36,Default,,0,0,0,,Мені өлгенше жек көремін деген әйел
Dialogue: 0,0:12:20.48,0:12:23.90,Default,,0,0,0,,Мен өмір бойы сенің соңынан еремін.
Dialogue: 0,0:12:24.03,0:12:27.41,Default,,0,0,0,,Әйелдің жүрегін өзгерту қорқынышты нәрсе.
Dialogue: 0,0:12:27.58,0:12:31.50,Default,,0,0,0,,Хехе... хахахаха
Dialogue: 0,0:12:31.62,0:12:34.50,Default,,0,0,0,,Юлия Бұл адам әлдеқашан мәйіт.
Dialogue: 0,0:12:34.62,0:12:36.79,Default,,0,0,0,,Қалай болғанда да, біз бұл дәуірде өмір сүре алмаймыз.
Dialogue: 0,0:12:36.92,0:12:39.21,Default,,0,0,0,,Уайымдамаңыз, соңғы соққы болмайды.
Dialogue: 0,0:12:40.05,0:12:42.42,Default,,0,0,0,,Кен... Кенширо!
Dialogue: 0,0:12:43.09,0:12:46.43,Default,,0,0,0,,О, түсіндім. Демек, Иура – ағасы екен.
Dialogue: 0,0:12:46.93,0:12:50.39,Default,,0,0,0,,Кен... Кен!
Dialogue: 0,0:12:53.56,0:12:57.81,Default,,0,0,0,,Кен Кен... Кен!
Dialogue: 0,0:13:02.69,0:13:04.28,Default,,0,0,0,,Юлия, кеттік.
Dialogue: 0,0:13:05.32,0:13:06.16,Default,,0,0,0,,Ах Кен
Dialogue: 0,0:13:06.78,0:13:09.28,Default,,0,0,0,,А... Юлия
Dialogue: 0,0:13:10.16,0:13:12.16,Default,,0,0,0,,Юрия~!
Dialogue: 0,0:13:12.29,0:13:15.25,Default,,0,0,0,,Кен! Болады!
Dialogue: 0,0:13:15.54,0:13:17.50,Default,,0,0,0,,Ke~n!
Dialogue: 0,0:13:19.25,0:13:21.05,Default,,0,0,0,,Құдай-ау, ағайын.
Dialogue: 0,0:13:22.76,0:13:24.67,Default,,0,0,0,,Мұның бәрі Кенширо үшін.
Dialogue: 0,0:13:25.05,0:13:28.84,Default,,0,0,0,,Хокутоны ала аласыз, мен беремін.
Dialogue: 0,0:13:29.47,0:13:31.76,Default,,0,0,0,,Не? Жарайды ма, Раох?
Dialogue: 0,0:13:31.89,0:13:33.52,Default,,0,0,0,,А... ағайын
Dialogue: 0,0:13:36.77,0:13:38.77,Default,,0,0,0,,Бұл шынымен жақсы ма? Раох
Dialogue: 0,0:13:39.15,0:13:42.44,Default,,0,0,0,,Ют Юрия... Ах.
Dialogue: 0,0:13:45.95,0:13:47.03,Default,,0,0,0,,Юлия…
Dialogue: 0,0:13:53.37,0:13:55.83,Default,,0,0,0,,Кен I
Dialogue: 0,0:13:56.08,0:13:59.12,Default,,0,0,0,,Бұл жер бетінде гүлдер қайтадан ашылады
Dialogue: 0,0:14:18.44,0:14:21.31,Default,,0,0,0,,Біз студенттерміз, көріп тұрсың ғой—
Dialogue: 0,0:14:23.52,0:14:26.28,Default,,0,0,0,,(Джагидің күлкісі)
Dialogue: 0,0:14:27.24,0:14:29.74,Default,,0,0,0,,Хе хе хе хе хе...
Dialogue: 0,0:14:38.29,0:14:41.50,Default,,0,0,0,,А~хахахаха!
Dialogue: 0,0:14:44.00,0:14:46.76,Default,,0,0,0,,Ешқандай қиындық жоқ, Кенширо.
Dialogue: 0,0:14:46.96,0:14:50.80,Default,,0,0,0,,Бүгіннен бастап мен Хокуто Шинкеннің мұрагері боламын.
Dialogue: 0,0:14:51.89,0:14:56.27,Default,,0,0,0,,Ағадан артық іні бар ма?
Dialogue: 0,0:14:57.93,0:14:58.93,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:15:14.53,0:15:16.62,Default,,0,0,0,,Фухахаха...
Dialogue: 0,0:15:16.74,0:15:19.62,Default,,0,0,0,,(Джагидің күлкісі)
Dialogue: 0,0:15:20.25,0:15:23.67,Default,,0,0,0,,Тозаққа кет!
Dialogue: 0,0:15:34.64,0:15:39.18,Default,,0,0,0,,Хахаха... хахахаха!
Dialogue: 0,0:15:41.64,0:15:44.48,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:16:13.68,0:16:15.14,Default,,0,0,0,,Раох?
Dialogue: 0,0:16:15.34,0:16:18.85,Default,,0,0,0,,Әке, сен менің жұдырығымды тастай аласың ба?
Dialogue: 0,0:16:18.97,0:16:22.69,Default,,0,0,0,,Жойта алсаң, құртып көр!
Dialogue: 0,0:16:24.77,0:16:28.52,Default,,0,0,0,,Мені әкем де жеңе алмайды.
Dialogue: 0,0:16:29.36,0:16:32.44,Default,,0,0,0,,Раох, дайын бол.
Dialogue: 0,0:16:32.95,0:16:38.24,Default,,0,0,0,,Хокуто Шинкеннің мұрагері болуды мақсат еткен, бірақ мақсатына жете алмағандар
Dialogue: 0,0:16:38.37,0:16:40.04,Default,,0,0,0,,Аузыңды жап және кет
Dialogue: 0,0:16:47.33,0:16:52.51,Default,,0,0,0,,Әке, сіз Хокуто Шинкеннің мұрагерін қателесіп қалдыңыз.
Dialogue: 0,0:16:53.55,0:16:55.55,Default,,0,0,0,,Кенширо қайтыс болды
Dialogue: 0,0:16:55.93,0:16:57.05,Default,,0,0,0,,Не?
Dialogue: 0,0:16:57.18,0:17:00.06,Default,,0,0,0,,Хокуто Шинкен енді жоқ
Dialogue: 0,0:17:05.19,0:17:10.15,Default,,0,0,0,,Күрсін!
Dialogue: 0,0:17:22.83,0:17:24.50,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:17:37.84,0:17:39.01,Default,,0,0,0,,Бұл 5 миллион йенге арналған ақшалай ваучер
Dialogue: 0,0:17:55.65,0:17:59.28,Default,,0,0,0,,Бұл дүниеде менің жұдырығыма мөр басатын ешкім жоқ.
Dialogue: 0,0:17:59.57,0:18:03.37,Default,,0,0,0,,Раох, сен не ойлап отырсың?
Dialogue: 0,0:18:03.62,0:18:06.41,Default,,0,0,0,,Хокуто Шинкен енді ешқашан пайдаланылмауы керек.
Dialogue: 0,0:18:07.54,0:18:10.00,Default,,0,0,0,,Мен ешкімнен бұйрық алмаймын.
Dialogue: 0,0:18:17.05,0:18:20.59,Default,,0,0,0,,Менің үмітім - аспан!
Dialogue: 0,0:18:24.39,0:18:26.60,Default,,0,0,0,,Аспанды ұстау үшін
Dialogue: 0,0:18:27.10,0:18:31.77,Default,,0,0,0,,Хокуто Шинкеннің мұрагері кім екені маңызды емес.
Dialogue: 0,0:18:33.98,0:18:35.98,Default,,0,0,0,,Бұл да жақсы болар еді.
Dialogue: 0,0:18:36.32,0:18:37.74,Default,,0,0,0,,Бірақ Раох
Dialogue: 0,0:18:38.11,0:18:42.74,Default,,0,0,0,,Жұдырығыңа өзім мөр басудан басқа амалым жоқ.
Dialogue: 0,0:18:42.87,0:18:43.78,Default,,0,0,0,,Не?
Dialogue: 0,0:18:43.91,0:18:46.54,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:18:52.54,0:18:54.04,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:19:34.38,0:19:38.30,Default,,0,0,0,,Аспан, маған жауап бер!
Dialogue: 0,0:19:56.44,0:19:58.86,Default,,0,0,0,,Мен аспанға ұмтыламын
Dialogue: 0,0:20:01.70,0:20:05.66,Default,,0,0,0,,Оның алдын алғың келсе, Құдаймен де, шайтанмен де соғыс.
Dialogue: 0,0:20:09.41,0:20:14.17,Default,,0,0,0,,Ғасырдың соңындағы чемпион боламын!
Dialogue: 0,0:20:38.69,0:20:43.11,Default,,0,0,0,,Теңіз кеуіп, жер жыртылып қалды, уақыт өтті.
Dialogue: 0,0:20:44.36,0:20:49.70,Default,,0,0,0,,Әлем тағы да зорлық-зомбылық билеген дәуірде болды.
Dialogue: 0,0:20:58.96,0:20:59.80,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:00.46,0:21:02.01,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:21:02.26,0:21:03.51,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:03.88,0:21:04.80,Default,,0,0,0,,Біз бұған қарап тұра алмаймыз.
Dialogue: 0,0:21:05.84,0:21:06.84,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:08.47,0:21:10.10,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:21:10.43,0:21:12.47,Default,,0,0,0,,Ах~ (әйел) Ах...
Dialogue: 0,0:21:18.77,0:21:19.94,Default,,0,0,0,,Хехе
Dialogue: 0,0:21:54.27,0:21:56.39,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:22:14.62,0:22:17.87,Default,,0,0,0,,Ухехехе... Эй!
Dialogue: 0,0:22:19.33,0:22:20.83,Default,,0,0,0,,Ора, орра, ора!
Dialogue: 0,0:22:38.10,0:22:39.35,Default,,0,0,0,,Мен шынымен де мықты энергияны сезіп тұрмын!
Dialogue: 0,0:22:39.60,0:22:43.90,Default,,0,0,0,,(жарғанақтың айқайы)
Dialogue: 0,0:22:48.15,0:22:50.45,Default,,0,0,0,,Уау!
Dialogue: 0,0:22:56.08,0:22:57.87,Default,,0,0,0,,О! (мүше) Yotto!
Dialogue: 0,0:23:02.21,0:23:03.75,Default,,0,0,0,,Хехехе
Dialogue: 0,0:23:05.09,0:23:06.96,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:23:14.14,0:23:15.14,Default,,0,0,0,,тіпті «костюмнің ашықтығын реттейтін заң жобасы» дайындалған болатын—
Dialogue: 0,0:23:23.52,0:23:25.19,Default,,0,0,0,,Бұл жақтастық! Бұл жақтастық~!
Dialogue: 0,0:23:39.08,0:23:40.46,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:23:53.59,0:23:57.47,Default,,0,0,0,,Хехехе, бұл жігіттер тамақ тасуға бара жатқан.
Dialogue: 0,0:23:57.81,0:24:00.73,Default,,0,0,0,,Жүр, ол сынған, қозғалмайды.
Dialogue: 0,0:24:00.85,0:24:02.94,Default,,0,0,0,,Әйтеуір, бұрынғы балалардың ауылы.
Dialogue: 0,0:24:03.06,0:24:05.36,Default,,0,0,0,,Ұнтақтауға тұрарлық сияқты.
Dialogue: 0,0:24:05.56,0:24:08.73,Default,,0,0,0,,Мен Г-д ағасына тез айтуым керек.
Dialogue: 0,0:24:08.86,0:24:10.86,Default,,0,0,0,,Қарғыс атсын, бейбақ!
Dialogue: 0,0:24:10.99,0:24:12.20,Default,,0,0,0,,Хахаха
Dialogue: 0,0:24:12.82,0:24:16.74,Default,,0,0,0,,Уф... А, міне, менің көлігім!
Dialogue: 0,0:24:17.45,0:24:19.49,Default,,0,0,0,,Әй, сен аман қалдың ба?
Dialogue: 0,0:24:19.62,0:24:22.12,Default,,0,0,0,,Жүр, менің көлігіме тиіспе!
Dialogue: 0,0:24:22.79,0:24:25.92,Default,,0,0,0,,Ей, менде тамақ жақсы, машинаны артта қалдыр!
Dialogue: 0,0:24:26.21,0:24:27.79,Default,,0,0,0,,Ол көңілді бала.
Dialogue: 0,0:24:27.92,0:24:30.34,Default,,0,0,0,,Иә? Бұл не, тұқымдар?
Dialogue: 0,0:24:30.76,0:24:34.18,Default,,0,0,0,,Енді мұндай жерде күріш өсіре алмаймыз.
Dialogue: 0,0:24:34.30,0:24:35.14,Default,,0,0,0,,Бұл!
Dialogue: 0,0:24:36.34,0:24:39.26,Default,,0,0,0,,Керемет емес пе, кішкентай бала? бұл!
Dialogue: 0,0:24:40.10,0:24:42.98,Default,,0,0,0,,Әй, бұл жігіттердің ауылын хабарлау қиын болар еді.
Dialogue: 0,0:24:43.10,0:24:43.98,Default,,0,0,0,,Мені өлтіріңіз
Dialogue: 0,0:24:44.44,0:24:47.98,Default,,0,0,0,,О! Ораора, орора…
Dialogue: 0,0:24:48.23,0:24:51.07,Default,,0,0,0,,Хехе, өл, кішкентайым.
Dialogue: 0,0:24:53.11,0:24:56.36,Default,,0,0,0,,О? Мына жігіт, мына жігіт... Эй!
Dialogue: 0,0:24:57.37,0:24:58.20,Default,,0,0,0,,Неге?! Неге?!
Dialogue: 0,0:25:28.77,0:25:31.65,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:25:33.15,0:25:34.03,Default,,0,0,0,,Әй?
Dialogue: 0,0:25:37.91,0:25:39.16,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:25:51.29,0:25:52.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:26:02.14,0:26:03.01,Default,,0,0,0,,Хмм...
Dialogue: 0,0:26:05.85,0:26:06.98,Default,,0,0,0,,Хехе...
Dialogue: 0,0:26:16.03,0:26:17.11,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:27:10.29,0:27:12.83,Default,,0,0,0,,Сәлем! Ия... бейбақ!
Dialogue: 0,0:27:32.06,0:27:33.56,Default,,0,0,0,,Те... Теме! (ату дыбысы)
Dialogue: 0,0:27:43.82,0:27:45.66,Default,,0,0,0,,Ах... Уау!
Dialogue: 0,0:27:50.21,0:27:51.79,Default,,0,0,0,,Мемем... соншалықты
Dialogue: 0,0:27:52.29,0:27:53.50,Default,,0,0,0,,Көпіршік...
Dialogue: 0,0:28:02.43,0:28:04.51,Default,,0,0,0,,…өйткені ол ит алғысы келетінін айта бастады
Dialogue: 0,0:28:17.07,0:28:18.27,Default,,0,0,0,,(ДжоДжо) Шынында да, ол адам болса жақсы болар еді.
Dialogue: 0,0:28:19.07,0:28:20.03,Default,,0,0,0,,Практикалық емтихан: Дайын бол, баста!
Dialogue: 0,0:28:20.15,0:28:22.36,Default,,0,0,0,,Қарғыс атсын... Гебу!
Dialogue: 0,0:28:28.70,0:28:29.70,Default,,0,0,0,,Беча...
Dialogue: 0,0:28:32.58,0:28:33.42,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:28:33.54,0:28:36.04,Default,,0,0,0,,(Жарқанаттың қорқынышты дауысы)
Dialogue: 0,0:28:37.29,0:28:40.13,Default,,0,0,0,,Уау... Уау!
Dialogue: 0,0:29:07.32,0:29:09.28,Default,,0,0,0,,Сәлем отаку
Dialogue: 0,0:29:09.58,0:29:12.50,Default,,0,0,0,,Сен бізге неге көмектестің?
Dialogue: 0,0:29:13.83,0:29:15.92,Default,,0,0,0,,Маған сол қыз телефон соқты
Dialogue: 0,0:29:16.04,0:29:18.25,Default,,0,0,0,,Соған қарамастан, бұл түтін неге осынша көп?
Dialogue: 0,0:29:18.59,0:29:24.26,Default,,0,0,0,,Менің айтайын дегенім, бұл біртүрлі емес пе? Рин сөйлей алмайды.
Dialogue: 0,0:29:26.59,0:29:30.97,Default,,0,0,0,,Өткен соғыста бүкіл отбасым көз алдымда өртеніп өлді.
Dialogue: 0,0:29:31.85,0:29:34.85,Default,,0,0,0,,Шамасы, есеңгіреп сөйлей алмай қалды.
Dialogue: 0,0:29:35.10,0:29:38.19,Default,,0,0,0,,Мен де солаймын.
Dialogue: 0,0:29:38.81,0:29:42.32,Default,,0,0,0,,Бірақ, неге ол жалғыз құтқарылды?
Dialogue: 0,0:29:55.50,0:29:58.46,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:30:02.38,0:30:03.67,Default,,0,0,0,,О!
Dialogue: 0,0:30:03.84,0:30:06.13,Default,,0,0,0,,(мүшелердің айқайы)
Dialogue: 0,0:30:12.26,0:30:17.06,Default,,0,0,0,,(шу)
Dialogue: 0,0:31:05.23,0:31:08.95,Default,,0,0,0,,Лорд Гидке мүмкіндігінше көп су мен тамақ беріңіз.
Dialogue: 0,0:31:09.53,0:31:13.58,Default,,0,0,0,,Әйтпесе мына қыздың басын жұлып аламын.
Dialogue: 0,0:31:13.83,0:31:17.08,Default,,0,0,0,,Ақсақал, уайымдамаңыз, айтысайық.
Dialogue: 0,0:31:17.20,0:31:19.71,Default,,0,0,0,,Фухахаха! Мен көремін
Dialogue: 0,0:31:19.83,0:31:23.42,Default,,0,0,0,,Сіз оны шынымен үзіп алмасаңыз, түсінбейтін сияқтысыз.
Dialogue: 0,0:31:26.25,0:31:27.09,Default,,0,0,0,,Фугу
Dialogue: 0,0:31:28.84,0:31:30.34,Default,,0,0,0,,Ng…
Dialogue: 0,0:31:37.39,0:31:38.22,Default,,0,0,0,,Пех!
Dialogue: 0,0:31:38.98,0:31:42.85,Default,,0,0,0,,Бұл кім? Мені тас жеуге мәжбүрлеген жігіт
Dialogue: 0,0:31:51.11,0:31:52.53,Default,,0,0,0,,Практикалық емтихан: Дайын бол, баста!
Dialogue: 0,0:31:53.28,0:31:56.74,Default,,0,0,0,,Сіз нені айтасыз? Ол арам пиғыл.
Dialogue: 0,0:31:59.00,0:32:00.12,Default,,0,0,0,,Оған жоғары баға қояды!
Dialogue: 0,0:32:04.08,0:32:05.75,Default,,0,0,0,,Сізде батылдық бар!
Dialogue: 0,0:32:06.88,0:32:08.17,Default,,0,0,0,,Уау!
Dialogue: 0,0:32:11.34,0:32:12.55,Default,,0,0,0,,О, бесши!
Dialogue: 0,0:32:17.06,0:32:19.10,Default,,0,0,0,,Уф!
Dialogue: 0,0:32:20.77,0:32:22.44,Default,,0,0,0,,Уау!
Dialogue: 0,0:32:23.31,0:32:24.15,Default,,0,0,0,,О...
Dialogue: 0,0:32:24.90,0:32:26.48,Default,,0,0,0,,Ей, не істеп жатырсың?
Dialogue: 0,0:32:31.78,0:32:33.15,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:32:42.91,0:32:45.63,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:32:45.75,0:32:48.04,Default,,0,0,0,,Ей, жіберші анау баланы.
Dialogue: 0,0:32:48.34,0:32:52.51,Default,,0,0,0,,Ей, мен мына баланы жаншып аламын.
Dialogue: 0,0:32:53.63,0:32:57.01,Default,,0,0,0,,Ахх!
Dialogue: 0,0:33:02.98,0:33:05.35,Default,,0,0,0,,Атататата...
Dialogue: 0,0:33:08.98,0:33:11.44,Default,,0,0,0,,Вататтат…
Dialogue: 0,0:33:11.57,0:33:12.94,Default,,0,0,0,,Ей, не істеп жатырсың?
Dialogue: 0,0:33:13.44,0:33:16.99,Default,,0,0,0,,Ууууууу~
Dialogue: 0,0:33:24.91,0:33:26.83,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:33:30.04,0:33:32.38,Default,,0,0,0,,А...
Dialogue: 0,0:33:35.13,0:33:39.64,Default,,0,0,0,,Жұдырығың маса сияқты тиімді.
Dialogue: 0,0:33:39.80,0:33:44.48,Default,,0,0,0,,Хехехехе... Мен сені өлтіремін~
Dialogue: 0,0:33:45.64,0:33:48.02,Default,,0,0,0,,Сіз әлдеқашан өлдіңіз
Dialogue: 0,0:33:48.15,0:33:50.57,Default,,0,0,0,,Не? О...
Dialogue: 0,0:33:52.44,0:33:53.53,Default,,0,0,0,,Эй!
Dialogue: 0,0:33:54.24,0:33:57.70,Default,,0,0,0,,Соңында... Уау!
Dialogue: 0,0:34:00.99,0:34:02.45,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:34:08.12,0:34:10.67,Default,,0,0,0,,
Dialogue: 0,0:34:11.13,0:34:12.75,Default,,0,0,0,,Хокуто Шинкен
Dialogue: 0,0:34:15.26,0:34:16.84,Default,,0,0,0,,Хокуто Шинкен
Dialogue: 0,0:34:17.51,0:34:22.01,Default,,0,0,0,,Баяғыда Қытайдан әкелінген қорқынышты қастандық болды.
Dialogue: 0,0:34:22.22,0:34:25.35,Default,,0,0,0,,Оның аты Хокуто Шинкен
Dialogue: 0,0:34:26.31,0:34:28.73,Default,,0,0,0,,Барлық күш-қуатыңызды бір жұдырыққа жинаңыз
Dialogue: 0,0:34:28.85,0:34:31.94,Default,,0,0,0,,Дененің меридиандық тесіктерін соғу
Dialogue: 0,0:34:32.15,0:34:34.78,Default,,0,0,0,,Беттік жойылудан гөрі
Dialogue: 0,0:34:34.90,0:34:39.95,Default,,0,0,0,,Бұл бір соққы, өлімге әкелетін жекпе-жек әдісі, оның мақсаты ішкі дүниені жою.
Dialogue: 0,0:34:52.04,0:34:54.25,Default,,0,0,0,,Мен Кенширомын.
Dialogue: 0,0:34:54.75,0:34:56.92,Default,,0,0,0,,Рин деп айтқаныңызға сенімдімін.
Dialogue: 0,0:34:58.22,0:35:00.76,Default,,0,0,0,,Сіз бе? мені кім шақырды
Dialogue: 0,0:35:05.47,0:35:07.52,Default,,0,0,0,,Рин, жұмбақ бала.
Dialogue: 0,0:35:08.39,0:35:10.77,Default,,0,0,0,,Жарайды, қозғалма.
Dialogue: 0,0:35:23.32,0:35:24.83,Default,,0,0,0,,Не?
Dialogue: 0,0:35:26.20,0:35:28.75,Default,,0,0,0,,Мен сөздерімді қайтаратын құпия тесікке соқтым.
Dialogue: 0,0:35:29.33,0:35:32.79,Default,,0,0,0,,Сіз сөйлей аласыз ба? Не, ақымақ
Dialogue: 0,0:35:34.84,0:35:37.76,Default,,0,0,0,,Бұл қапшықта гүл тұқымдары бар.
Dialogue: 0,0:35:38.71,0:35:42.05,Default,,0,0,0,,Осындай кезде, егер сен болсаң
Dialogue: 0,0:35:42.18,0:35:44.72,Default,,0,0,0,,Гүлдерді гүлдету мүмкін болуы мүмкін
Dialogue: 0,0:35:58.19,0:36:00.15,Default,,0,0,0,,Ол адам бара ма?
Dialogue: 0,0:36:00.28,0:36:03.95,Default,,0,0,0,,Аа, мен мұндай ғажайып жігітті көрген емеспін.
Dialogue: 0,0:36:05.78,0:36:06.78,Default,,0,0,0,,Рин, сен!
Dialogue: 0,0:36:06.91,0:36:08.12,Default,,0,0,0,,Кен… Кен
Dialogue: 0,0:36:08.66,0:36:11.75,Default,,0,0,0,,Ke~n!
Dialogue: 0,0:36:36.40,0:36:38.02,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:36:49.08,0:36:50.70,Default,,0,0,0,,Ах!
Dialogue: 0,0:36:51.25,0:36:52.12,Default,,0,0,0,,Хехехе
Dialogue: 0,0:37:06.93,0:37:10.26,Default,,0,0,0,,Әй... еркек пе еді? Бұл не?
Dialogue: 0,0:37:11.31,0:37:13.77,Default,,0,0,0,,Мен? Мен Рэймін
Dialogue: 0,0:37:14.81,0:37:16.85,Default,,0,0,0,,Бұл Нанто Суйчоукеннен келген Рей.
Dialogue: 0,0:37:18.06,0:37:19.77,Default,,0,0,0,,Әйел сияқты киінсең
Dialogue: 0,0:37:19.90,0:37:24.07,Default,,0,0,0,,Сен сияқты құрттар бізге тез секіреді.
Dialogue: 0,0:37:24.74,0:37:29.37,Default,,0,0,0,,Сіз өте ақымақ болсаңыз да пайдалы болатын бір ғана нәрсе бар.
Dialogue: 0,0:37:30.49,0:37:33.66,Default,,0,0,0,,Үндемесең де тамақ әкел.
Dialogue: 0,0:37:33.87,0:37:35.16,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:37:35.79,0:37:37.67,Default,,0,0,0,,Күрсін!
Dialogue: 0,0:37:38.29,0:37:39.79,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:37:40.88,0:37:42.26,Default,,0,0,0,,Практикалық емтихан: Дайын бол, баста!
Dialogue: 0,0:37:42.76,0:37:45.09,Default,,0,0,0,,Эй, мен бір нәрсені ұмытып қалдым.
Dialogue: 0,0:37:48.22,0:37:49.05,Default,,0,0,0,,Әй?
Dialogue: 0,0:37:49.39,0:37:50.60,Default,,0,0,0,,Не? Ой...
Dialogue: 0,0:37:52.68,0:37:55.56,Default,,0,0,0,,Ах... Уау!
Dialogue: 0,0:37:55.85,0:37:59.73,Default,,0,0,0,,Хахахаха... менің, қолым
Dialogue: 0,0:38:00.27,0:38:01.82,Default,,0,0,0,,Незуко, жақсысың ба?
Dialogue: 0,0:38:02.65,0:38:07.91,Default,,0,0,0,,Әй, сен жеті тыртығы бар адамды білесің бе?
Dialogue: 0,0:38:14.54,0:38:17.46,Default,,0,0,0,,А~хахахаха!
Dialogue: 0,0:38:17.58,0:38:21.25,Default,,0,0,0,,Жоқ, бұл қызық. Мен бұған жауап бере алмаймын. Хахаха.
Dialogue: 0,0:38:21.67,0:38:24.26,Default,,0,0,0,,Жарайды, келесі жолы, келесі жолы мені әкел.
Dialogue: 0,0:38:24.38,0:38:26.34,Default,,0,0,0,,Уау, жоқ, білмеймін.
Dialogue: 0,0:38:26.47,0:38:29.05,Default,,0,0,0,,Жарайды, сен ақылды көрінесің.
Dialogue: 0,0:38:29.18,0:38:31.01,Default,,0,0,0,,Сіз түсінесіз.
Dialogue: 0,0:38:31.14,0:38:33.56,Default,,0,0,0,,Енді осы адамның атын айт.
Dialogue: 0,0:38:33.93,0:38:36.73,Default,,0,0,0,,Уау, бұл мүмкін емес. Мен білмеймін.
Dialogue: 0,0:38:37.06,0:38:41.56,Default,,0,0,0,,Не? Мына кеудеден жеті тыртық көрсең де
Dialogue: 0,0:38:41.69,0:38:43.73,Default,,0,0,0,,Оның кім екенін білмейсің бе?
Dialogue: 0,0:38:43.90,0:38:47.95,Default,,0,0,0,,Бұл адам Хокуто Шинкеннің мұрагері Кенширо.
Dialogue: 0,0:38:48.07,0:38:49.20,Default,,0,0,0,,Кел, айт.
Dialogue: 0,0:38:49.32,0:38:50.99,Default,,0,0,0,,Ке...Кенширо-сама
Dialogue: 0,0:38:51.12,0:38:54.87,Default,,0,0,0,,Иә, бұл Кенширо-сама. Жақсы айтты.
Dialogue: 0,0:38:54.99,0:39:00.00,Default,,0,0,0,,Жарайды, сыйлық ретінде мына жігіттің басын арамен кесуге рұқсат етемін.
Dialogue: 0,0:39:00.33,0:39:02.71,Default,,0,0,0,,Енді жасаңыз! ара бар
Dialogue: 0,0:39:04.80,0:39:05.71,Default,,0,0,0,,Сәлем! (Бағыныңқы) Жорық!
Dialogue: 0,0:39:06.05,0:39:07.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:39:08.09,0:39:09.47,Default,,0,0,0,,Һм. Менің немерем сәл қатал сыншы екен, иә?
Dialogue: 0,0:39:09.80,0:39:10.68,Default,,0,0,0,,Мен шынымен де мықты энергияны сезіп тұрмын!
Dialogue: 0,0:39:10.80,0:39:12.18,Default,,0,0,0,,Уау!
Dialogue: 0,0:39:12.30,0:39:14.18,Default,,0,0,0,,Ой... Менің қолымнан келмейді, маған үзіліс беріңізші.
Dialogue: 0,0:39:14.47,0:39:16.52,Default,,0,0,0,,Сіз не істей алмайсыз?
Dialogue: 0,0:39:16.64,0:39:19.10,Default,,0,0,0,,Кенширо-сама мұндай нәрсеге жол бере ме?
Dialogue: 0,0:39:20.10,0:39:24.36,Default,,0,0,0,,(Тұрғындардың үрейлі дауыстары)
Dialogue: 0,0:39:24.48,0:39:27.36,Default,,0,0,0,,Жеті шрамы бар адам Г-д-ді жойған дейді.
Dialogue: 0,0:39:27.49,0:39:29.53,Default,,0,0,0,,Ол сондай арамза болды ма?
Dialogue: 0,0:39:29.90,0:39:32.24,Default,,0,0,0,,Бұл дүниеде құтқарушы жоқ па...
Dialogue: 0,0:39:32.37,0:39:35.37,Default,,0,0,0,,Не! Қария, тағы бір рет...
Dialogue: 0,0:39:35.49,0:39:37.45,Default,,0,0,0,,Мен шынымен де мықты энергияны сезіп тұрмын!
Dialogue: 0,0:39:38.08,0:39:38.95,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:39:39.21,0:39:40.75,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:39:40.87,0:39:45.96,Default,,0,0,0,,Жеті шрамы бар адам Хокуто Шинкеннің Кенширо есімді адамы ма?
Dialogue: 0,0:39:49.09,0:39:50.09,Default,,0,0,0,,Бейбақ! (Бағыныңқы) Күте тұрыңыз
Dialogue: 0,0:39:50.76,0:39:52.64,Default,,0,0,0,,Жүр, бейбақ.
Dialogue: 0,0:39:53.68,0:39:55.22,Default,,0,0,0,,Сізде батылдық бар емес пе?
Dialogue: 0,0:39:55.35,0:39:58.72,Default,,0,0,0,,Шыққаныңыз үшін сыйлық ретінде мен сізге арамен жүгіруге рұқсат етемін.
Dialogue: 0,0:39:58.85,0:40:01.10,Default,,0,0,0,,Сіз оны тартып ала аласыз.
Dialogue: 0,0:40:01.77,0:40:03.69,Default,,0,0,0,,Арамен тарту жақсы сезіне ме?
Dialogue: 0,0:40:03.81,0:40:06.73,Default,,0,0,0,,Иә, мен өзімді сергек сезінемін.
Dialogue: 0,0:40:06.86,0:40:08.11,Default,,0,0,0,,Тез орындаңыз!
Dialogue: 0,0:40:10.90,0:40:12.95,Default,,0,0,0,,А... Иә?
Dialogue: 0,0:40:14.41,0:40:16.12,Default,,0,0,0,,Ағамның ойы қандай—
Dialogue: 0,0:40:16.66,0:40:18.58,Default,,0,0,0,,Өзіңізді қалай сезінесіз? Өзіңізді сергек сезіндіңіз бе?
Dialogue: 0,0:40:18.70,0:40:22.96,Default,,0,0,0,,Ақымақ, бұл мен емес.
Dialogue: 0,0:40:23.83,0:40:24.96,Default,,0,0,0,,Практикалық емтихан: Дайын бол, баста!
Dialogue: 0,0:40:25.17,0:40:26.00,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:40:28.30,0:40:31.63,Default,,0,0,0,,Чоу чоу чоу!
Dialogue: 0,0:40:34.05,0:40:36.43,Default,,0,0,0,,Күрсін!
Dialogue: 0,0:40:36.55,0:40:37.43,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:40:41.77,0:40:46.40,Default,,0,0,0,,Ей, манты, мені жеті тыртығы бар адамға жетеле.
Dialogue: 0,0:40:46.90,0:40:50.23,Default,,0,0,0,,Бейбақты өлтір... А, бұл кім?
Dialogue: 0,0:40:50.86,0:40:51.90,Default,,0,0,0,,Практикалық емтихан: Дайын бол, баста!
Dialogue: 0,0:40:53.40,0:40:57.49,Default,,0,0,0,,Балалар, кеудедегі адамның шын аты кім?
Dialogue: 0,0:40:57.62,0:40:59.62,Default,,0,0,0,,Білгіңіз келмейді ме?
Dialogue: 0,0:40:59.79,0:41:02.37,Default,,0,0,0,,Шулы, бейбақ...
Dialogue: 0,0:41:03.25,0:41:04.62,Default,,0,0,0,,Мен шынымен де мықты энергияны сезіп тұрмын!
Dialogue: 0,0:41:07.71,0:41:08.96,Default,,0,0,0,,Хокуто Шинкен
Dialogue: 0,0:41:09.59,0:41:13.34,Default,,0,0,0,,Айтайын, бұл жігіттің аты кім...
Dialogue: 0,0:41:14.09,0:41:14.93,Default,,0,0,0,,Жаги!
Dialogue: 0,0:41:18.26,0:41:20.93,Default,,0,0,0,,Бұл мен бір кездері аға деп атаған адам.
Dialogue: 0,0:41:31.65,0:41:35.36,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:41:38.45,0:41:40.49,Default,,0,0,0,,Айри, мұқият жылтыратыңыз
Dialogue: 0,0:41:40.62,0:41:42.62,Default,,0,0,0,,Иә, сэр.
Dialogue: 0,0:41:43.33,0:41:46.21,Default,,0,0,0,,Жалап тұрғандай поляк...
Dialogue: 0,0:41:47.04,0:41:48.79,Default,,0,0,0,,Менің аяқ киімім лас па?
Dialogue: 0,0:41:49.75,0:41:50.59,Default,,0,0,0,,Ах!
Dialogue: 0,0:41:50.71,0:41:52.00,Default,,0,0,0,,Жоқ, ұстаз.
Dialogue: 0,0:41:52.13,0:41:55.17,Default,,0,0,0,,Құл болсам да сыйламайсың ба?
Dialogue: 0,0:42:01.93,0:42:06.06,Default,,0,0,0,,Неге мені қуып барасың... жоқ, жеті тыртығы бар адам?
Dialogue: 0,0:42:06.48,0:42:10.65,Default,,0,0,0,,Мен саған әлі сенбеймін.
Dialogue: 0,0:42:11.02,0:42:12.82,Default,,0,0,0,,Рэй, айтшы.
Dialogue: 0,0:42:12.94,0:42:17.82,Default,,0,0,0,,Өзім үшін қайын ағамды жеңуім керек... Жаги.
Dialogue: 0,0:42:18.20,0:42:23.16,Default,,0,0,0,,Жақсы, мен онымен кездескеннен кейін де сені жеңуге әлі кеш емес.
Dialogue: 0,0:42:24.37,0:42:28.87,Default,,0,0,0,,Бұл шапанды менің әпкем Айри тойында киетін болды.
Dialogue: 0,0:42:30.08,0:42:33.71,Default,,0,0,0,,Бұл уақыт. Әйел неғұрлым жас болса, соғұрлым ол қымбатырақ болады.
Dialogue: 0,0:42:34.63,0:42:36.84,Default,,0,0,0,,Мен ауылдан жырақта жүргенімде ол...
Dialogue: 0,0:42:37.63,0:42:41.05,Default,,0,0,0,,Ауыл тұрғындарының бәрін өлтіріп, әке-шешемді өлтірді.
Dialogue: 0,0:42:41.18,0:42:42.35,Default,,0,0,0,,Айриді алып кетті
Dialogue: 0,0:42:42.72,0:42:45.35,Default,,0,0,0,,Бұл жеті тыртығы бар адам
Dialogue: 0,0:43:03.20,0:43:05.54,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:43:14.00,0:43:17.38,Default,,0,0,0,,Ей, мен інімнің мұрагер болғанын құптамаймын.
Dialogue: 0,0:43:17.51,0:43:19.55,Default,,0,0,0,,Әкеңе барып, бас тарт!
Dialogue: 0,0:43:20.88,0:43:23.10,Default,,0,0,0,,Бауырым, сен неге мылтыққа сенесің?
Dialogue: 0,0:43:23.22,0:43:24.93,Default,,0,0,0,,Неге жұдырықпен ұрыспайсың?
Dialogue: 0,0:43:25.06,0:43:27.60,Default,,0,0,0,,Мен Кенпоның бәрі деп ойламаймын.
Dialogue: 0,0:43:27.73,0:43:29.98,Default,,0,0,0,,Қандай әдісті қолдансаңыз да, сіз жеңсеңіз жақсы.
Dialogue: 0,0:43:31.31,0:43:32.31,Default,,0,0,0,,Гаха!
Dialogue: 0,0:43:32.44,0:43:34.40,Default,,0,0,0,,Сен, уайымдама.
Dialogue: 0,0:43:36.32,0:43:38.65,Default,,0,0,0,,Уа... ау!
Dialogue: 0,0:43:39.40,0:43:42.45,Default,,0,0,0,,Ол іні болса да, ағаңа қол көтермексің бе?
Dialogue: 0,0:43:42.57,0:43:44.16,Default,,0,0,0,,(Тодороки) Мен сол жігіттен барынша көп нәрсе үйренгім келеді
Dialogue: 0,0:43:44.28,0:43:47.20,Default,,0,0,0,,Кук кук… Фугу!
Dialogue: 0,0:43:47.58,0:43:49.33,Default,,0,0,0,,Атататата...
Dialogue: 0,0:43:49.46,0:43:50.62,Default,,0,0,0,,Ей, не істеп жатырсың?
Dialogue: 0,0:43:52.08,0:43:53.17,Default,,0,0,0,,Күрсін!
Dialogue: 0,0:43:53.29,0:43:56.00,Default,,0,0,0,,Ой... шіркін.
Dialogue: 0,0:43:56.13,0:43:57.30,Default,,0,0,0,,Біраз шаншып қалды~
Dialogue: 0,0:43:58.76,0:44:00.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:44:00.30,0:44:01.63,Default,,0,0,0,,Гуаа!
Dialogue: 0,0:44:05.14,0:44:08.85,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:44:09.52,0:44:10.98,Default,,0,0,0,,Мұнда? Бұл жолмен?
Dialogue: 0,0:44:11.19,0:44:12.69,Default,,0,0,0,,Міне... ka...
Dialogue: 0,0:44:16.94,0:44:17.90,Default,,0,0,0,,Уф...
Dialogue: 0,0:44:18.94,0:44:21.82,Default,,0,0,0,,Сіздің мұрагер болуға құқығыңыз жоқ.
Dialogue: 0,0:44:22.28,0:44:23.32,Default,,0,0,0,,Ой~!
Dialogue: 0,0:44:27.91,0:44:31.37,Default,,0,0,0,,Бейбақ... Кенширо әлі тірі еді.
Dialogue: 0,0:44:32.58,0:44:34.75,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:44:47.60,0:44:49.93,Default,,0,0,0,,Жаги-сама, мен сенің жүрегіңді шақырдым.
Dialogue: 0,0:44:51.56,0:44:52.85,Default,,0,0,0,,Иә? Лорд Джаги?
Dialogue: 0,0:44:53.89,0:44:57.56,Default,,0,0,0,,(Джаги ұйқысы)
Dialogue: 0,0:45:00.11,0:45:00.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:45:07.16,0:45:09.08,Default,,0,0,0,,Бірақ бұл демондарға да қатысты.
Dialogue: 0,0:45:09.20,0:45:11.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:45:15.87,0:45:17.54,Default,,0,0,0,,Ах... Уау! Эй!
Dialogue: 0,0:45:19.25,0:45:20.96,Default,,0,0,0,,Мен... Мен оны көрген жоқпын.
Dialogue: 0,0:45:21.17,0:45:24.13,Default,,0,0,0,,…өйткені ол ит алғысы келетінін айта бастады
Dialogue: 0,0:45:24.26,0:45:27.80,Default,,0,0,0,,Сіз неден қорқасыз? Сіз бұл бетті соншалықты жек көресіз бе?
Dialogue: 0,0:45:27.93,0:45:30.06,Default,,0,0,0,,А... Жақын келме. Жақын келме.
Dialogue: 0,0:45:30.35,0:45:33.60,Default,,0,0,0,,Сен мені менсінбейсің.
Dialogue: 0,0:45:33.73,0:45:36.40,Default,,0,0,0,,Менің бетімді мазақ қыл
Dialogue: 0,0:45:36.52,0:45:38.31,Default,,0,0,0,,Жоқ... бұл дұрыс емес!
Dialogue: 0,0:45:39.23,0:45:40.07,Default,,0,0,0,,Біз бұған қарап тұра алмаймыз.
Dialogue: 0,0:45:40.19,0:45:41.86,Default,,0,0,0,,Бірақ бұл демондарға да қатысты.
Dialogue: 0,0:45:45.15,0:45:49.70,Default,,0,0,0,,Маған ағамнан кем қарайтын адамды тірі қалдыра алмаймын.
Dialogue: 0,0:46:00.67,0:46:02.63,Default,,0,0,0,,Сонда сіздің алаяқ
Dialogue: 0,0:46:02.75,0:46:05.67,Default,,0,0,0,,Сіз Айриді түрмеге қамауға келдіңіз бе?
Dialogue: 0,0:46:06.34,0:46:07.72,Default,,0,0,0,,Мүмкін солай шығар.
Dialogue: 0,0:46:10.05,0:46:13.77,Default,,0,0,0,,Хехе, бейбақ, ақыры келдің бе?
Dialogue: 0,0:46:13.97,0:46:16.69,Default,,0,0,0,,Айри, мұнда кел.
Dialogue: 0,0:46:16.89,0:46:18.94,Default,,0,0,0,,Сізде бірнеше қызықты қолдану бар.
Dialogue: 0,0:46:19.52,0:46:20.73,Default,,0,0,0,,Иә, сэр.
Dialogue: 0,0:46:24.36,0:46:26.24,Default,,0,0,0,,Күрсін!
Dialogue: 0,0:46:26.36,0:46:27.24,Default,,0,0,0,,Ей, не істеп жатырсың?
Dialogue: 0,0:46:31.45,0:46:32.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:46:45.59,0:46:48.38,Default,,0,0,0,,Хехе, сен Кенширосың ба?
Dialogue: 0,0:46:48.51,0:46:49.93,Default,,0,0,0,,Мен жүрекпін
Dialogue: 0,0:46:50.05,0:46:54.47,Default,,0,0,0,,Лорд Джаги маған сіздің өміріңізді алуды бұйырды.
Dialogue: 0,0:46:54.60,0:46:56.81,Default,,0,0,0,,Шошқалар шошқа қорасында ұйықтау керек.
Dialogue: 0,0:46:57.43,0:47:01.81,Default,,0,0,0,,Әй, сенде адамдарға шошқадай қарауға жүйкең жетеді.
Dialogue: 0,0:47:01.94,0:47:04.27,Default,,0,0,0,,Қайда болсаңыз да, келіңіз.
Dialogue: 0,0:47:04.53,0:47:06.28,Default,,0,0,0,,Ей, не істеп жатырсың?
Dialogue: 0,0:47:07.49,0:47:08.53,Default,,0,0,0,,Уау?
Dialogue: 0,0:47:09.24,0:47:13.28,Default,,0,0,0,,Хехехе менің етім резеңкедей.
Dialogue: 0,0:47:13.41,0:47:16.45,Default,,0,0,0,,Сондықтан жұдырығың меридианның құпия тесігіне жеткенше,
Dialogue: 0,0:47:16.58,0:47:20.29,Default,,0,0,0,,Оның бәрі ет қабырғасына сіңіп кеткен.
Dialogue: 0,0:47:20.42,0:47:22.29,Default,,0,0,0,,Мен жекпе-жек өнерінің барлық түрімен айналысамын.
Dialogue: 0,0:47:22.42,0:47:25.59,Default,,0,0,0,,Мен осы денемен өлтірдім.
Dialogue: 0,0:47:26.63,0:47:27.46,Default,,0,0,0,,Уау!
Dialogue: 0,0:47:28.51,0:47:33.05,Default,,0,0,0,,Хехе, не болды? Әлі бітті ме?
Dialogue: 0,0:47:33.30,0:47:35.18,Default,,0,0,0,,Күрсін!
Dialogue: 0,0:47:35.72,0:47:38.23,Default,,0,0,0,,Әй, не болды? Мен мұны істеймін бе?
Dialogue: 0,0:47:38.64,0:47:42.40,Default,,0,0,0,,Бұл пайдасыз. Хокуто Шинкен жеңілмейді!
Dialogue: 0,0:47:42.73,0:47:45.61,Default,,0,0,0,,Ухаха мен түсінемін. Сосын өл!
Dialogue: 0,0:47:46.02,0:47:47.57,Default,,0,0,0,,Атта! (Жүрек) Ақымақ
Dialogue: 0,0:47:47.90,0:47:50.57,Default,,0,0,0,,Ататата...
Dialogue: 0,0:47:52.11,0:47:53.07,Default,,0,0,0,,Уау
Dialogue: 0,0:47:53.53,0:47:55.70,Default,,0,0,0,,Ататата...
Dialogue: 0,0:47:58.29,0:48:00.75,Default,,0,0,0,,Оаа!
Dialogue: 0,0:48:00.87,0:48:03.67,Default,,0,0,0,,Ет... менің тәнім!
Dialogue: 0,0:48:05.21,0:48:08.38,Default,,0,0,0,,Сіз бір кесек майсыз.
Dialogue: 0,0:48:08.51,0:48:09.34,Default,,0,0,0,,Толық кауль!
Dialogue: 0,0:48:12.97,0:48:14.55,Default,,0,0,0,,Бұл не? Қазір не болды?
Dialogue: 0,0:48:14.68,0:48:18.77,Default,,0,0,0,,Нува, Нува, Нува! Hidebu...
Dialogue: 0,0:48:23.69,0:48:26.06,Default,,0,0,0,,Күрсін!
Dialogue: 0,0:48:49.17,0:48:53.43,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:48:55.59,0:48:56.64,Default,,0,0,0,,Жаги
Dialogue: 0,0:48:57.64,0:49:02.02,Default,,0,0,0,,Хехехе, сен осындасың ба? Кенширо
Dialogue: 0,0:49:05.27,0:49:06.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:49:07.02,0:49:11.57,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:49:12.24,0:49:13.32,Default,,0,0,0,,Ендеше, мен де саған сенемін
Dialogue: 0,0:49:13.65,0:49:16.74,Default,,0,0,0,,Иә, мен сенің ата-анаңды өлтірдім.
Dialogue: 0,0:49:16.87,0:49:19.87,Default,,0,0,0,,Айриді ұрлаған жеті тыртығы бар адам.
Dialogue: 0,0:49:20.49,0:49:21.37,Default,,0,0,0,,Хахаха
Dialogue: 0,0:49:21.50,0:49:24.75,Default,,0,0,0,,Сол ауылда Нанто Суйчукен деген кісі бар деп естідім.
Dialogue: 0,0:49:24.87,0:49:26.17,Default,,0,0,0,,Сіз болдыңыз ба?
Dialogue: 0,0:49:26.29,0:49:27.13,Default,,0,0,0,,Эй!
Dialogue: 0,0:49:28.63,0:49:30.88,Default,,0,0,0,,Уа, ұстаз.
Dialogue: 0,0:49:31.30,0:49:33.97,Default,,0,0,0,,Мұнда не істеуіміз керек?
Dialogue: 0,0:49:34.38,0:49:36.26,Default,,0,0,0,,Мен бәрін істеймін
Dialogue: 0,0:49:36.64,0:49:40.26,Default,,0,0,0,,Айри... Айри!
Dialogue: 0,0:49:40.56,0:49:43.06,Default,,0,0,0,,Ха... түсіндім.
Dialogue: 0,0:49:43.27,0:49:46.77,Default,,0,0,0,,Мені жаңа шебер сатып алып жатыр.
Dialogue: 0,0:49:47.98,0:49:49.82,Default,,0,0,0,,Мені еркелетіңізші.
Dialogue: 0,0:49:49.98,0:49:51.78,Default,,0,0,0,,Мен бәрін істеймін
Dialogue: 0,0:49:52.03,0:49:54.28,Default,,0,0,0,,Айри, сенің көзің бар ма?
Dialogue: 0,0:49:54.40,0:49:58.28,Default,,0,0,0,,Мына әйел менің бетімді көріп шошып кетті.
Dialogue: 0,0:49:58.62,0:50:00.58,Default,,0,0,0,,Сондықтан мен жарықты ұрладым
Dialogue: 0,0:50:01.16,0:50:02.91,Default,,0,0,0,,Мен сені кешіре алмаймын!
Dialogue: 0,0:50:04.04,0:50:05.04,Default,,0,0,0,,Ах
Dialogue: 0,0:50:07.58,0:50:09.50,Default,,0,0,0,,Нанто адамымен не болды?
Dialogue: 0,0:50:09.63,0:50:12.80,Default,,0,0,0,,Түсіндім, менің қарындасым сондай сүйкімді ме?
Dialogue: 0,0:50:12.92,0:50:15.26,Default,,0,0,0,,Көмек бергіңіз келсе, өлтіріңіз.
Dialogue: 0,0:50:15.38,0:50:17.63,Default,,0,0,0,,Рэй Оның қолына түспе
Dialogue: 0,0:50:18.30,0:50:21.35,Default,,0,0,0,,Не болды? Менің әпкем сүйкімді емес пе?
Dialogue: 0,0:50:22.01,0:50:22.85,Default,,0,0,0,,Уау!
Dialogue: 0,0:50:24.60,0:50:27.06,Default,,0,0,0,,Хмф! Рэй тынышталсын
Dialogue: 0,0:50:27.19,0:50:30.15,Default,,0,0,0,,Ол уәдесінде тұратын адам емес.
Dialogue: 0,0:50:30.27,0:50:31.61,Default,,0,0,0,,Бірақ менің әпкем...
Dialogue: 0,0:50:33.15,0:50:37.40,Default,,0,0,0,,Иә, бауырлар бір-біріне көмектесуі керек.
Dialogue: 0,0:50:37.53,0:50:40.53,Default,,0,0,0,,Бұл əйел əрқашан сені, ағасын сүйетін.
Dialogue: 0,0:50:40.82,0:50:45.54,Default,,0,0,0,,Иә, інілері мен інілері үлкен ағаларды құрметтейтіні заңдылық.
Dialogue: 0,0:50:45.79,0:50:49.54,Default,,0,0,0,,Иә, есіме түсті, тағы да есіме түсті!
Dialogue: 0,0:50:49.67,0:50:51.54,Default,,0,0,0,,Сен мені үнемі мазақ ететінсің
Dialogue: 0,0:50:52.88,0:50:56.51,Default,,0,0,0,,Джаги Сіз өзіңіз сияқты адамды қабылдай аласыз ба?
Dialogue: 0,0:50:58.26,0:51:01.47,Default,,0,0,0,,Мылтыққа сүйеніп, енді тағы да кепілге арқа сүйеді
Dialogue: 0,0:51:01.60,0:51:04.56,Default,,0,0,0,,Мизучокеннің мына жігітіне арқа сүйеу
Dialogue: 0,0:51:04.68,0:51:07.39,Default,,0,0,0,,Сен мені жалғыз жеңе алмайсың ба?
Dialogue: 0,0:51:07.60,0:51:10.98,Default,,0,0,0,,Ағаңа осылай дедің бе?
Dialogue: 0,0:51:11.10,0:51:12.86,Default,,0,0,0,,Сен, мені құрметте!
Dialogue: 0,0:51:13.11,0:51:15.32,Default,,0,0,0,,Уф Жа... Джаги-сама
Dialogue: 0,0:51:15.90,0:51:21.03,Default,,0,0,0,,Жарайды, мен сенімен жеке-жеке шешемін.
Dialogue: 0,0:51:21.57,0:51:26.41,Default,,0,0,0,,Ой, балалар, мына нанто адамды өлтіріңдер!
Dialogue: 0,0:51:28.29,0:51:30.29,Default,,0,0,0,,Тез өлетін жерді таңда
Dialogue: 0,0:51:30.46,0:51:33.13,Default,,0,0,0,,Өлуің керек
Dialogue: 0,0:51:42.93,0:51:46.14,Default,,0,0,0,,Мен сені жек көрумен ғана өмір сүрдім.
Dialogue: 0,0:51:46.52,0:51:50.14,Default,,0,0,0,,Сол үшін менің атымды алып, теріс қылықтарың үшін мені кінәладың.
Dialogue: 0,0:51:50.35,0:51:54.48,Default,,0,0,0,,Хмф, мені сыйламағандардың бәрін өлтірдім.
Dialogue: 0,0:51:54.61,0:51:56.90,Default,,0,0,0,,Сондай ақымақтардың өмірі.
Dialogue: 0,0:51:57.03,0:52:00.53,Default,,0,0,0,,Бұл жараның азабымен салыстырғанда бұл ештеңе емес!
Dialogue: 0,0:52:01.36,0:52:03.16,Default,,0,0,0,,Бұл жара ауырған сайын мен
Dialogue: 0,0:52:03.28,0:52:05.53,Default,,0,0,0,,Мен саған деген өшпенділікпен өмір сүрдім.
Dialogue: 0,0:52:06.20,0:52:09.54,Default,,0,0,0,,Джаги, сол кезде неге мені аяқтамадың?
Dialogue: 0,0:52:09.66,0:52:11.00,Default,,0,0,0,,Алқапқа құлады?
Dialogue: 0,0:52:11.33,0:52:15.25,Default,,0,0,0,,Хмф, үлкен ағамыз Раох бізге мұны істеуді айтты.
Dialogue: 0,0:52:15.59,0:52:16.67,Default,,0,0,0,,Раох?
Dialogue: 0,0:52:17.71,0:52:19.21,Default,,0,0,0,,Мен қараңғы алқаптың түбіндемін
Dialogue: 0,0:52:19.34,0:52:22.09,Default,,0,0,0,,Мен сенің өлгеніңді көру қызық деп ойладым.
Dialogue: 0,0:52:22.22,0:52:26.14,Default,,0,0,0,,Жарайды, мен саған тозақ дәмін тағы да татамын.
Dialogue: 0,0:52:26.26,0:52:29.14,Default,,0,0,0,,Мен бұрынғы Джаги емеспін.
Dialogue: 0,0:52:29.43,0:52:35.48,Default,,0,0,0,,Ахх!
Dialogue: 0,0:52:36.02,0:52:36.90,Default,,0,0,0,,Сонымен бірге Rohan деген жігіт те—
Dialogue: 0,0:52:37.02,0:52:38.90,Default,,0,0,0,,Хокуто Архат шабуылы!
Dialogue: 0,0:52:39.03,0:52:42.40,Default,,0,0,0,,Бұл жылдам соққы оны айналып өте алады ма?
Dialogue: 0,0:52:43.53,0:52:45.12,Default,,0,0,0,,Уау! О, менің!
Dialogue: 0,0:52:45.45,0:52:47.70,Default,,0,0,0,,Уау!
Dialogue: 0,0:52:50.62,0:52:54.33,Default,,0,0,0,,Уф, сен ақымақсың... Сен сондай ақымақсың.
Dialogue: 0,0:52:55.58,0:52:56.84,Default,,0,0,0,,Уф...
Dialogue: 0,0:52:57.92,0:52:59.84,Default,,0,0,0,,Қолдан, артық етпе
Dialogue: 0,0:53:00.34,0:53:02.09,Default,,0,0,0,,Сіз мені мылтықпен өлтірсеңіз
Dialogue: 0,0:53:02.22,0:53:05.39,Default,,0,0,0,,Ақымақ, нені пайдалансаң да, жеңесің... Аа.
Dialogue: 0,0:53:05.80,0:53:07.72,Default,,0,0,0,,Жасырын тесік
Dialogue: 0,0:53:07.85,0:53:11.02,Default,,0,0,0,,Егер сіз оны жылдам жіберсеңіз, саусағыңыз триггерді тартады.
Dialogue: 0,0:53:11.14,0:53:12.77,Default,,0,0,0,,Ой... уау
Dialogue: 0,0:53:16.65,0:53:20.23,Default,,0,0,0,,Сен бұрынғы Кенширо емессің.
Dialogue: 0,0:53:20.36,0:53:22.49,Default,,0,0,0,,Сұмдық, мейірімсіздік
Dialogue: 0,0:53:22.69,0:53:26.11,Default,,0,0,0,,Бірақ оны оқу өте оңай, Кенширо.
Dialogue: 0,0:53:31.08,0:53:35.29,Default,,0,0,0,,Хахахаха, менде козир болды: бензин.
Dialogue: 0,0:53:35.46,0:53:37.88,Default,,0,0,0,,Мына ғимарат саған қарай еңкейіп тұр.
Dialogue: 0,0:53:38.00,0:53:40.75,Default,,0,0,0,,Кім менен артық күйік, ұсқынсыз?
Dialogue: 0,0:53:41.05,0:53:44.01,Default,,0,0,0,,Әлі түсінбедіңіз бе? Сіз өлетін адамсыз
Dialogue: 0,0:53:44.17,0:53:48.26,Default,,0,0,0,,Мен сенің баяу күйіп, қара болып кеткеніңді көремін.
Dialogue: 0,0:53:48.55,0:53:52.02,Default,,0,0,0,,Жарайды, мен сендерге марқұмның кәдесыйы туралы айтып беремін.
Dialogue: 0,0:53:52.14,0:53:55.69,Default,,0,0,0,,Нанто Сейкеннің Шині Юрияны сенен тартып алды.
Dialogue: 0,0:53:56.06,0:53:58.77,Default,,0,0,0,,Оны жындыға айналдырған мен едім.
Dialogue: 0,0:53:59.11,0:53:59.94,Default,,0,0,0,,Не?
Dialogue: 0,0:54:00.07,0:54:01.61,Default,,0,0,0,,Мен сені жек көрдім
Dialogue: 0,0:54:01.73,0:54:03.49,Default,,0,0,0,,Хокуто Шинкеннің мұрагері бол
Dialogue: 0,0:54:03.61,0:54:06.91,Default,,0,0,0,,Одан да сен Юлияны алдың.
Dialogue: 0,0:54:07.53,0:54:10.70,Default,,0,0,0,,Сондықтан мен Юрияны жақсы көретін Шинге көзім жетті.
Dialogue: 0,0:54:10.83,0:54:13.62,Default,,0,0,0,,Ол Шинді сілкіп жіберді.
Dialogue: 0,0:54:14.66,0:54:16.58,Default,,0,0,0,,Шин Неге бас тарту керек?
Dialogue: 0,0:54:16.71,0:54:19.88,Default,,0,0,0,,Кеншироның тәтті мінезін сіз де білесіз.
Dialogue: 0,0:54:20.42,0:54:23.05,Default,,0,0,0,,Мына заманда Юрияны қорғай алмайды.
Dialogue: 0,0:54:23.17,0:54:25.26,Default,,0,0,0,,Әрқашан басқа адам ұрлайды
Dialogue: 0,0:54:25.38,0:54:27.63,Default,,0,0,0,,Бұл әлі де жақсы ма? Шин
Dialogue: 0,0:54:27.80,0:54:31.35,Default,,0,0,0,,Иә, сен ғана Юлияны бақытты ете аласың.
Dialogue: 0,0:54:31.64,0:54:33.85,Default,,0,0,0,,Юрия бастапқыда Нантодан келген әйел болған.
Dialogue: 0,0:54:33.97,0:54:35.43,Default,,0,0,0,,Мені не туралы шатастыруға болады?
Dialogue: 0,0:54:35.56,0:54:37.64,Default,,0,0,0,,Алып кетіңіз, алыңыз!
Dialogue: 0,0:54:37.77,0:54:40.65,Default,,0,0,0,,Оны алып кетіңіз!
Dialogue: 0,0:54:41.48,0:54:43.15,Default,,0,0,0,,Сіз Шинсіз бе?
Dialogue: 0,0:54:43.53,0:54:44.82,Default,,0,0,0,,Хахаха иә
Dialogue: 0,0:54:44.94,0:54:46.78,Default,,0,0,0,,Сіз менің жоспарыма түсіп қалдыңыз.
Dialogue: 0,0:54:46.90,0:54:50.16,Default,,0,0,0,,Иә, бұл дүниеде ағасынан ақылды іні бар ма?
Dialogue: 0,0:54:50.28,0:54:52.16,Default,,0,0,0,,Хахахаха Бұл көңілсіз бе?
Dialogue: 0,0:54:52.28,0:54:55.08,Default,,0,0,0,,Сіз ренжідіңіз бе? Хахахаха!
Dialogue: 0,0:54:55.50,0:54:56.66,Default,,0,0,0,,Маған да біреуін оқып бер
Dialogue: 0,0:54:57.04,0:55:01.17,Default,,0,0,0,,Кішкентайынан бауырындай өскен Шин жынды болды.
Dialogue: 0,0:55:01.33,0:55:03.67,Default,,0,0,0,,Менен Юлияны тартып алған...
Dialogue: 0,0:55:03.80,0:55:07.67,Default,,0,0,0,,Фухахаха, мен кіммін? Маған атыңды айт
Dialogue: 0,0:55:07.80,0:55:11.18,Default,,0,0,0,,Мен Хокуто Шинкеннің мұрагері Джаги-самамын.
Dialogue: 0,0:55:11.43,0:55:15.39,Default,,0,0,0,,Нуааах~
Dialogue: 0,0:55:20.65,0:55:24.27,Default,,0,0,0,,Ахх!
Dialogue: 0,0:55:25.90,0:55:27.57,Default,,0,0,0,,Ей, не істеп жатырсың?
Dialogue: 0,0:55:29.57,0:55:31.28,Default,,0,0,0,,Нана... Не?
Dialogue: 0,0:55:31.66,0:55:35.37,Default,,0,0,0,,Ааааааааааааааааааааааааааааааа!
Dialogue: 0,0:55:36.66,0:55:38.00,Default,,0,0,0,,(жығылған дыбыс)
Dialogue: 0,0:55:47.21,0:55:48.92,Default,,0,0,0,,бірақ ол да маған күдікпен қарады…
Dialogue: 0,0:55:50.80,0:55:53.76,Default,,0,0,0,,Қандай жігіт...
Dialogue: 0,0:55:57.10,0:55:59.31,Default,,0,0,0,,Куу…
Dialogue: 0,0:56:00.27,0:56:01.64,Default,,0,0,0,,Мына жігітті же!
Dialogue: 0,0:56:03.90,0:56:05.07,Default,,0,0,0,,Ой
Dialogue: 0,0:56:06.15,0:56:07.78,Default,,0,0,0,,Жеңдер!
Dialogue: 0,0:56:10.57,0:56:12.57,Default,,0,0,0,,Уф... міне кеттік!
Dialogue: 0,0:56:15.12,0:56:18.66,Default,,0,0,0,,Хокуто Шинкеннің мәнін ұмыттыңыз ба?
Dialogue: 0,0:56:18.79,0:56:21.21,Default,,0,0,0,,Атта! Жылы, жылы…
Dialogue: 0,0:56:23.46,0:56:24.46,Default,,0,0,0,,Ей, не істеп жатырсың?
Dialogue: 0,0:56:24.58,0:56:26.13,Default,,0,0,0,,Бірақ бұл демондарға да қатысты.
Dialogue: 0,0:56:26.54,0:56:28.38,Default,,0,0,0,,...
Dialogue: 0,0:56:28.67,0:56:30.84,Default,,0,0,0,,Күрсін!
Dialogue: 0,0:56:31.38,0:56:34.01,Default,,0,0,0,,Ой... а
Dialogue: 0,0:56:34.76,0:56:35.93,Default,,0,0,0,,бірақ ол да маған күдікпен қарады…
Dialogue: 0,0:56:37.35,0:56:39.97,Default,,0,0,0,,Уау!
Dialogue: 0,0:56:40.10,0:56:41.98,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:56:42.77,0:56:45.19,Default,,0,0,0,,Менің өлгім келмейді!
Dialogue: 0,0:56:45.31,0:56:47.44,Default,,0,0,0,,Мен қашан өлетінімді білмеймін!
Dialogue: 0,0:56:48.27,0:56:49.94,Default,,0,0,0,,Юлия қайда?
Dialogue: 0,0:56:50.36,0:56:53.86,Default,,0,0,0,,Мен Шинмен оңтүстіктегі Оңтүстік Крест қаласында тұрамын.
Dialogue: 0,0:56:53.99,0:56:54.95,Default,,0,0,0,,Бұл мүмкін емес қой?
Dialogue: 0,0:56:55.12,0:56:56.07,Default,,0,0,0,,Сіз Титантардың бір-бірімен шайқасып жатқанын айтасыз ба?
Dialogue: 0,0:56:56.20,0:57:00.95,Default,,0,0,0,,Сіздің денеңіз 10 секундта жер бетінен жоғалады.
Dialogue: 0,0:57:01.54,0:57:04.46,Default,,0,0,0,,Юрияның жүрегі Шиндікі.
Dialogue: 0,0:57:04.58,0:57:07.34,Default,,0,0,0,,Барғанның пайдасы жоқ хахаха
Dialogue: 0,0:57:07.46,0:57:08.88,Default,,0,0,0,,Көңіліңіз қалды ма, Кенширо?
Dialogue: 0,0:57:09.00,0:57:11.59,Default,,0,0,0,,Иә? Хокутоны маған ағам сыйлады.
Dialogue: 0,0:57:11.71,0:57:13.09,Default,,0,0,0,,Демек, бұл менікі
Dialogue: 0,0:57:13.22,0:57:14.93,Default,,0,0,0,,Сіз қалай ойлайсыз? Ахахха
Dialogue: 0,0:57:15.05,0:57:16.64,Default,,0,0,0,,Кенширо, менің атымды айт.
Dialogue: 0,0:57:16.76,0:57:19.60,Default,,0,0,0,,Мен Хокуто Джажигиджидің мұрагерімін...
Dialogue: 0,0:57:22.56,0:57:24.77,Default,,0,0,0,,Юлия Шин…
Dialogue: 0,0:57:25.77,0:57:27.40,Default,,0,0,0,,Және Раох
Dialogue: 0,0:57:29.52,0:57:31.69,Default,,0,0,0,,Сәлем! (Бағыныңқы) Уау!
Dialogue: 0,0:57:38.62,0:57:40.03,Default,,0,0,0,,Бірақ бұл демондарға да қатысты.
Dialogue: 0,0:57:41.16,0:57:42.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:57:42.75,0:57:44.33,Default,,0,0,0,,Сәлем! (Бағыныңқы) Ах!
Dialogue: 0,0:57:45.54,0:57:48.33,Default,,0,0,0,,Айри, бұл мен, сенің ағаң Рей.
Dialogue: 0,0:57:48.63,0:57:50.09,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:57:50.21,0:57:53.76,Default,,0,0,0,,Жаңа қожайын, маған кез келген нәрсені сұраңыз.
Dialogue: 0,0:57:54.17,0:57:56.05,Default,,0,0,0,,Мен бәрін істеймін
Dialogue: 0,0:57:56.34,0:57:57.64,Default,,0,0,0,,Мені еркелетіңізші.
Dialogue: 0,0:57:58.05,0:58:00.93,Default,,0,0,0,,Ах... Айри
Dialogue: 0,0:58:12.03,0:58:12.90,Default,,0,0,0,,Мм! Ах!
Dialogue: 0,0:58:14.86,0:58:16.65,Default,,0,0,0,,Айри Айри
Dialogue: 0,0:58:17.16,0:58:19.91,Default,,0,0,0,,Кенширо: Менің әпкем шынымен қалпына келе ме?
Dialogue: 0,0:58:20.70,0:58:25.04,Default,,0,0,0,,Қиын күндер апаңның жадын, нұрын тартып алды.
Dialogue: 0,0:58:25.37,0:58:27.92,Default,,0,0,0,,Біраз уақыттан кейін есін жинайсың.
Dialogue: 0,0:58:39.09,0:58:40.72,Default,,0,0,0,,Оңтүстік крест
Dialogue: 0,0:58:42.81,0:58:43.81,Default,,0,0,0,,Юлия
Dialogue: 0,0:58:48.10,0:58:50.36,Default,,0,0,0,,Хехехе, қалайсың?
Dialogue: 0,0:58:50.48,0:58:51.73,Default,,0,0,0,,Мен оны қажетсіз өлуіне жол бермеймін!
Dialogue: 0,0:58:52.52,0:58:53.78,Default,,0,0,0,,Кен бұл
Dialogue: 0,0:58:54.36,0:58:55.19,Default,,0,0,0,,Га
Dialogue: 0,0:58:57.32,0:58:58.66,Default,,0,0,0,,Джулия гүлі
Dialogue: 0,0:58:58.95,0:59:01.32,Default,,0,0,0,,Рин, бұл сен бе?
Dialogue: 0,0:59:01.78,0:59:02.66,Default,,0,0,0,,Иә
Dialogue: 0,0:59:04.99,0:59:08.00,Default,,0,0,0,,Бұл мен тойдамын...
Dialogue: 0,0:59:08.16,0:59:11.04,Default,,0,0,0,,Дұрыс, Айри, сен оны киюің керек еді.
Dialogue: 0,0:59:11.17,0:59:14.05,Default,,0,0,0,,Аа, хён... сен шынымен хёнсың ба?
Dialogue: 0,0:59:14.34,0:59:15.76,Default,,0,0,0,,Иә, бұл менмін.
Dialogue: 0,0:59:15.88,0:59:18.05,Default,,0,0,0,,Енді көздеріңді ашып маған қараңдар.
Dialogue: 0,0:59:19.05,0:59:21.05,Default,,0,0,0,,Жоқ! маған қарама
Dialogue: 0,0:59:21.18,0:59:24.89,Default,,0,0,0,,Мен бұрынғыдай Айри емеспін.
Dialogue: 0,0:59:25.56,0:59:26.56,Default,,0,0,0,,Айри…
Dialogue: 0,0:59:29.73,0:59:30.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:59:30.69,0:59:32.40,Default,,0,0,0,,Кенширо, №.
Dialogue: 0,0:59:32.77,0:59:35.11,Default,,0,0,0,,Айри көзін ашуға қорқады
Dialogue: 0,0:59:35.23,0:59:38.49,Default,,0,0,0,,Мен мұнымен жақсымын, енді ештеңе көргім келмейді!
Dialogue: 0,0:59:38.99,0:59:40.45,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:59:40.61,0:59:43.45,Default,,0,0,0,,Осындай әлемде сіз осылай бақытты болуыңыз мүмкін.
Dialogue: 0,0:59:43.74,0:59:47.37,Default,,0,0,0,,Иә, мені алып кеткендей өмір сүруден басқа амалым жоқ.
Dialogue: 0,0:59:47.50,0:59:49.00,Default,,0,0,0,,Олай айтпа!
Dialogue: 0,0:59:49.12,0:59:51.54,Default,,0,0,0,,Барлығымыз қайтадан жайлы өмір сүретін жер жасайық.
Dialogue: 0,0:59:52.63,0:59:53.54,Default,,0,0,0,,Лин
Dialogue: 0,0:59:54.04,0:59:58.46,Default,,0,0,0,,Бәріміз еңбектенсек, гүл, ағаш, қызанақ, қияр т.б.
Dialogue: 0,0:59:58.59,1:00:00.80,Default,,0,0,0,,Алма, ерм... арпа
Dialogue: 0,1:00:00.93,1:00:03.26,Default,,0,0,0,,Әр түрлі заттарды жасауға болады.
Dialogue: 0,1:00:04.30,1:00:05.26,Default,,0,0,0,,Уваааах! Ашылмай жатыр!
Dialogue: 0,1:00:07.02,1:00:07.93,Default,,0,0,0,,Ах
Dialogue: 0,1:00:09.14,1:00:11.44,Default,,0,0,0,,Бұл гүл.
Dialogue: 0,1:00:11.64,1:00:13.10,Default,,0,0,0,,Гүл бүршігі
Dialogue: 0,1:00:14.36,1:00:16.77,Default,,0,0,0,,Гүлдер енді гүлдемейді деп ойладым.
Dialogue: 0,1:00:17.94,1:00:20.78,Default,,0,0,0,,Иә, көзіңді дұрыс ашпасаң көре алмайсың.
Dialogue: 0,1:00:21.86,1:00:22.78,Default,,0,0,0,,Ах...
Dialogue: 0,1:00:28.54,1:00:29.91,Default,,0,0,0,,Бұл шынымен де гүл
Dialogue: 0,1:00:30.16,1:00:31.79,Default,,0,0,0,,Сен оны гүлдендірдің.
Dialogue: 0,1:00:33.67,1:00:37.09,Default,,0,0,0,,Сіз шынымен гүлдерді қайтадан гүлдей аласыз ба?
Dialogue: 0,1:00:37.80,1:00:40.51,Default,,0,0,0,,Қуанамын...Тірі болғаныма қуаныштымын.
Dialogue: 0,1:00:41.05,1:00:43.01,Default,,0,0,0,,Тірі... Уф...
Dialogue: 0,1:00:45.14,1:00:46.47,Default,,0,0,0,,Бұл қыз кім?
Dialogue: 0,1:00:46.85,1:00:48.47,Default,,0,0,0,,Ал мына адам...
Dialogue: 0,1:00:48.89,1:00:52.39,Default,,0,0,0,,Бұл жігіттер осы тақыр жерде болуы мүмкін...
Dialogue: 0,1:02:10.39,1:02:13.77,Default,,0,0,0,,Хехе Юрия, сен әдеттегідей әдемісің.
Dialogue: 0,1:02:17.85,1:02:18.73,Default,,0,0,0,,Иә?
Dialogue: 0,1:02:20.36,1:02:21.19,Default,,0,0,0,,Матака?
Dialogue: 0,1:02:21.32,1:02:24.65,Default,,0,0,0,,Юлия Саған мен берген әшекейлер ұнамай ма?
Dialogue: 0,1:02:24.94,1:02:26.82,Default,,0,0,0,,Бұл өмір саған ұнамай ма?
Dialogue: 0,1:02:28.87,1:02:32.24,Default,,0,0,0,,Қалағаным – теңіздей мейірімділік
Dialogue: 0,1:02:32.54,1:02:34.25,Default,,0,0,0,,Шөптің жарықтығы
Dialogue: 0,1:02:34.66,1:02:37.25,Default,,0,0,0,,Күн сияқты жылы жарық
Dialogue: 0,1:02:37.58,1:02:41.00,Default,,0,0,0,,Ал мені қоршап тұрған жер иісі
Dialogue: 0,1:02:41.13,1:02:44.30,Default,,0,0,0,,Жер иісі? Сіз Кенширо туралы айтып отырсыз ба?
Dialogue: 0,1:02:44.63,1:02:45.88,Default,,0,0,0,,Ол әлдеқашан өлді.
Dialogue: 0,1:02:46.55,1:02:49.22,Default,,0,0,0,,Юлия, сен осы жастасың.
Dialogue: 0,1:02:49.64,1:02:53.22,Default,,0,0,0,,Ол әлемдегі ең сәнді өмірге ие әйел.
Dialogue: 0,1:02:53.35,1:02:55.35,Default,,0,0,0,,Тағы не қалайсыз?
Dialogue: 0,1:02:56.64,1:03:01.69,Default,,0,0,0,,Менің үмітім - бұл жер тағы да жемісті болады.
Dialogue: 0,1:03:01.81,1:03:02.90,Default,,0,0,0,,Бұл жемісті ме?
Dialogue: 0,1:03:03.11,1:03:04.32,Default,,0,0,0,,Сен не айтасың, Юлия?
Dialogue: 0,1:03:04.44,1:03:07.90,Default,,0,0,0,,Қазіргі заманда табиғаттың жемісін беретін топырақ жоқ.
Dialogue: 0,1:03:08.03,1:03:10.45,Default,,0,0,0,,Қараңдаршы, қазір біздегі топырақ өлі топырақ.
Dialogue: 0,1:03:11.28,1:03:13.66,Default,,0,0,0,,Мына шөлді қарашы
Dialogue: 0,1:03:14.12,1:03:16.25,Default,,0,0,0,,Бір жағы: Өлім әлемі.
Dialogue: 0,1:03:16.50,1:03:18.50,Default,,0,0,0,,Бірде-бір шөп өспейді
Dialogue: 0,1:03:19.96,1:03:23.13,Default,,0,0,0,,Бірақ мына Оңтүстік Крест қаласына қараңыз
Dialogue: 0,1:03:23.75,1:03:27.92,Default,,0,0,0,,Мен оны тек сіз бен өзім үшін салдым.
Dialogue: 0,1:03:28.22,1:03:30.76,Default,,0,0,0,,Бұл қаланың ішінде басқа әлем бар.
Dialogue: 0,1:03:32.18,1:03:36.89,Default,,0,0,0,,Менің баламды туып, осы қалада тыныш өмір сүресің.
Dialogue: 0,1:03:37.98,1:03:39.60,Default,,0,0,0,,Біздің ұрпақта
Dialogue: 0,1:03:39.81,1:03:43.52,Default,,0,0,0,,Ол топырақтың қайта тірілуі, көгеруі екіталай.
Dialogue: 0,1:03:44.69,1:03:48.78,Default,,0,0,0,,Бұл дәуірде зорлық-зомбылықтан басқа не аман қалу керек?
Dialogue: 0,1:03:49.49,1:03:52.37,Default,,0,0,0,,Сені бақытты ете алатын жалғыз мен ғана.
Dialogue: 0,1:03:52.74,1:03:54.45,Default,,0,0,0,,Юрия Кенширо
Dialogue: 0,1:03:54.58,1:03:58.29,Default,,0,0,0,,Мен болмасам да, Тағдырымды біреу өлтірді.
Dialogue: 0,1:03:59.37,1:04:01.96,Default,,0,0,0,,Юлия, маған жүрегіңді аш.
Dialogue: 0,1:04:02.08,1:04:04.50,Default,,0,0,0,,Кенширо сол топырақпен бірге қайтыс болды.
Dialogue: 0,1:04:08.46,1:04:10.93,Default,,0,0,0,,Юлия, бұл әдемі есім.
Dialogue: 0,1:04:11.84,1:04:15.14,Default,,0,0,0,,Юрияда сіз сияқты нанто қаны бар.
Dialogue: 0,1:04:15.26,1:04:18.89,Default,,0,0,0,,Менің әкем Рюкен Хокуто Шинкеннің мұрагері.
Dialogue: 0,1:04:19.14,1:04:21.98,Default,,0,0,0,,Ол Юлияға әйелі болуға кеңес берді.
Dialogue: 0,1:04:22.94,1:04:26.19,Default,,0,0,0,,Сіздің әкеңіз Солтүстік пен Оңтүстіктің қосылуынан туған.
Dialogue: 0,1:04:26.32,1:04:28.78,Default,,0,0,0,,Менің ойымша, олар бұл дәуірде бір нәрсеге үміттенді.
Dialogue: 0,1:04:29.44,1:04:32.57,Default,,0,0,0,,Кенширо, сен біртүрлі адамсың.
Dialogue: 0,1:04:32.91,1:04:35.49,Default,,0,0,0,,Мен сол күндердің сағыныш жерінің иісін сеземін.
Dialogue: 0,1:04:36.49,1:04:39.70,Default,,0,0,0,,Кез келген жағдайда сіз зорлық-зомбылық дәуірінен аман қалған шығарсыз.
Dialogue: 0,1:04:39.83,1:04:43.08,Default,,0,0,0,,Тыныштандырылуы керек болмыс болуы мүмкін.
Dialogue: 0,1:04:44.25,1:04:46.46,Default,,0,0,0,,Менің ондай амбицияларым жоқ.
Dialogue: 0,1:04:46.59,1:04:49.17,Default,,0,0,0,,Юрияны қайтадан қолыма аламын.
Dialogue: 0,1:04:49.71,1:04:53.18,Default,,0,0,0,,Мен Хокутоның өсиетін берік мұраға алғым келеді.
Dialogue: 0,1:04:58.31,1:05:00.77,Default,,0,0,0,,Кенширо Сізді не қозғайды?
Dialogue: 0,1:05:00.89,1:05:02.69,Default,,0,0,0,,Бұл ғана емес шығар.
Dialogue: 0,1:05:05.98,1:05:09.40,Default,,0,0,0,,Бұл Кенох! Кено осында!
Dialogue: 0,1:05:09.53,1:05:12.49,Default,,0,0,0,,Кенох - ғасырдың соңындағы чемпион!
Dialogue: 0,1:05:12.61,1:05:18.12,Default,,0,0,0,,Кенох әскері өткеннен кейін қирау мен қырғын, мәйіттердің үйіндісі бар.
Dialogue: 0,1:05:33.63,1:05:37.55,Default,,0,0,0,,Эй Кенох, бұл менің елім.
Dialogue: 0,1:05:37.68,1:05:39.81,Default,,0,0,0,,Біздің азу клан
Dialogue: 0,1:05:39.93,1:05:43.94,Default,,0,0,0,,Мен бұл елде тек көңілді өмір сүргім келеді.
Dialogue: 0,1:05:44.23,1:05:46.02,Default,,0,0,0,,Неге әуре?
Dialogue: 0,1:05:46.48,1:05:49.11,Default,,0,0,0,,Мен мұндай жер алсам да, ештеңе болмайды.
Dialogue: 0,1:05:49.77,1:05:51.03,Default,,0,0,0,,Дереу бас тарту
Dialogue: 0,1:05:51.69,1:05:55.03,Default,,0,0,0,,Әйтпесе, бәріңді өлтіремін!
Dialogue: 0,1:05:56.70,1:05:58.53,Default,,0,0,0,,Ха, алға!
Dialogue: 0,1:06:02.50,1:06:05.54,Default,,0,0,0,,Өзіңіз зарядтаңыз!
Dialogue: 0,1:06:28.44,1:06:30.27,Default,,0,0,0,,Хмм... Олар қандай?
Dialogue: 0,1:06:30.40,1:06:32.78,Default,,0,0,0,,Сіз қорқыныштың не екенін білмейсіз бе?
Dialogue: 0,1:06:38.99,1:06:41.62,Default,,0,0,0,,Күрсін!
Dialogue: 0,1:06:47.67,1:06:49.46,Default,,0,0,0,,Қазан болат сауыттарын шақыру әдісі
Dialogue: 0,1:06:49.58,1:06:52.75,Default,,0,0,0,,Кел, менің денем қазірдің өзінде болат сауыт.
Dialogue: 0,1:06:52.88,1:06:55.92,Default,,0,0,0,,Маған кез келген жерден қоңырау шалыңыз!
Dialogue: 0,1:06:59.18,1:07:00.01,Default,,0,0,0,,Эй!
Dialogue: 0,1:07:01.72,1:07:02.93,Default,,0,0,0,,Жылдам дайындалыңдар!
Dialogue: 0,1:07:03.06,1:07:06.77,Default,,0,0,0,,Сіз маған мұндай нәрсе менің денеме әсер етпейтінін айтатыныңызға сенімдімін.
Dialogue: 0,1:07:06.93,1:07:10.15,Default,,0,0,0,,Хэхе!
Dialogue: 0,1:07:11.61,1:07:16.24,Default,,0,0,0,,Хахахаха мен бәріңді жалғыз өзім өлтіремін.
Dialogue: 0,1:07:16.53,1:07:17.65,Default,,0,0,0,,Келіңіздер! Иә!
Dialogue: 0,1:07:22.37,1:07:23.83,Default,,0,0,0,,Уау!
Dialogue: 0,1:07:28.96,1:07:31.08,Default,,0,0,0,,Фухахаха!
Dialogue: 0,1:07:31.71,1:07:32.54,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,1:07:34.00,1:07:36.30,Default,,0,0,0,,Сәлем! (Солдат) Уау!
Dialogue: 0,1:07:38.05,1:07:40.26,Default,,0,0,0,,(Ұлы Король Азудың күлкісі)
Dialogue: 0,1:07:48.31,1:07:50.14,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,1:07:50.90,1:07:52.69,Default,,0,0,0,,Сәлем, Кено?
Dialogue: 0,1:07:52.81,1:07:55.94,Default,,0,0,0,,Сіз де басқа бағыныштыларды жоғалтқыңыз келмейді.
Dialogue: 0,1:07:56.11,1:07:58.24,Default,,0,0,0,,Бұл мен екеуміздің арамыздағы жарыс.
Dialogue: 0,1:07:58.69,1:08:01.28,Default,,0,0,0,,Бүгін қылыш айналдыру жаттығуын жасадым
Dialogue: 0,1:08:01.41,1:08:05.58,Default,,0,0,0,,Сен, Кен патшамен ойнауға әлі 100 жыл ерте.
Dialogue: 0,1:08:05.70,1:08:06.79,Default,,0,0,0,,Жылдам дайындалыңдар!
Dialogue: 0,1:08:07.87,1:08:11.17,Default,,0,0,0,,Мен ол атты өлтіремін!
Dialogue: 0,1:08:12.37,1:08:16.63,Default,,0,0,0,,Иә? Бейбақ, сен біртүрлі сиқырлы амалдарды қолданасың.
Dialogue: 0,1:08:16.75,1:08:18.76,Default,,0,0,0,,Мен сені талқандаймын ба?
Dialogue: 0,1:08:23.84,1:08:24.93,Default,,0,0,0,,Хмм?
Dialogue: 0,1:08:25.22,1:08:30.60,Default,,0,0,0,,Хехе, неге ұрғаныңды білмеймін, бірақ ха!
Dialogue: 0,1:08:32.27,1:08:36.61,Default,,0,0,0,,Менің денем сізге не істесеңіз де, ол жұмыс істемейтінін айтады.
Dialogue: 0,1:08:38.90,1:08:41.99,Default,,0,0,0,,Иә? Қолыммен не істеуім керек?
Dialogue: 0,1:08:42.11,1:08:44.91,Default,,0,0,0,,Жарайды, қайда болсаңыз да маған қоңырау шалыңыз.
Dialogue: 0,1:08:45.03,1:08:45.87,Default,,0,0,0,,Хмф!
Dialogue: 0,1:08:46.20,1:08:48.66,Default,,0,0,0,,Уф...
Dialogue: 0,1:08:54.75,1:08:55.63,Default,,0,0,0,,Уф!
Dialogue: 0,1:08:58.13,1:09:00.21,Default,,0,0,0,,Менің денем болат
Dialogue: 0,1:09:00.34,1:09:03.13,Default,,0,0,0,,Мен бұл жұмыс істемейді дедім... Ах!
Dialogue: 0,1:09:05.26,1:09:06.76,Default,,0,0,0,,Ой…
Dialogue: 0,1:09:07.35,1:09:09.22,Default,,0,0,0,,Уф!
Dialogue: 0,1:09:10.39,1:09:13.94,Default,,0,0,0,,Мұндағы адамдардың заманға пайдасы жоқ.
Dialogue: 0,1:09:14.15,1:09:15.73,Default,,0,0,0,,Жою
Dialogue: 0,1:09:16.56,1:09:20.48,Default,,0,0,0,,Юрия Мен тағы да шайқасқа шығуым керек.
Dialogue: 0,1:09:21.28,1:09:24.57,Default,,0,0,0,,Өзін Кенох деп атаған адам жер сыпырып жатыр.
Dialogue: 0,1:09:24.82,1:09:27.49,Default,,0,0,0,,Бұл Оңтүстік Крестке жақындап қалды.
Dialogue: 0,1:09:27.74,1:09:29.87,Default,,0,0,0,,Сәттілік тілеймін.
Dialogue: 0,1:09:30.41,1:09:31.95,Default,,0,0,0,,Осыны ғана айту керек пе?
Dialogue: 0,1:09:32.08,1:09:35.04,Default,,0,0,0,,Мен өмір-өлім шайқасына барамын.
Dialogue: 0,1:09:36.21,1:09:37.17,Default,,0,0,0,,Біз хабарлаймыз
Dialogue: 0,1:09:37.29,1:09:39.59,Default,,0,0,0,,Кенохтың әскері G нүктесінен асып түсті.
Dialogue: 0,1:09:39.71,1:09:42.46,Default,,0,0,0,,Не? Кено?
Dialogue: 0,1:09:42.59,1:09:44.80,Default,,0,0,0,,Бұл дәуірде ол нені жоспарлап отыр?
Dialogue: 0,1:09:45.05,1:09:46.39,Default,,0,0,0,,Және тағы бір нәрсе
Dialogue: 0,1:09:46.51,1:09:49.64,Default,,0,0,0,,Хокуто Шинкеннің мұрагері боламын деген Джаги құлады.
Dialogue: 0,1:09:49.76,1:09:50.64,Default,,0,0,0,,Иә?
Dialogue: 0,1:09:50.93,1:09:51.89,Default,,0,0,0,,Оны кім жеңді?
Dialogue: 0,1:09:52.06,1:09:54.98,Default,,0,0,0,,Бұл Кенширо, кеудесінде жеті тыртық бар адам.
Dialogue: 0,1:09:55.94,1:09:57.02,Default,,0,0,0,,Кенширо?
Dialogue: 0,1:10:00.61,1:10:04.28,Default,,0,0,0,,Кенширо тірі, мен оны тезірек көргім келеді.
Dialogue: 0,1:10:05.82,1:10:08.66,Default,,0,0,0,,Осы уақытқа дейін мен тірі өлік едім.
Dialogue: 0,1:10:09.49,1:10:11.24,Default,,0,0,0,,Бірақ бүгіннен бастап мен өмір сүремін.
Dialogue: 0,1:10:11.37,1:10:15.96,Default,,0,0,0,,Мен Кенширо үшін өмір сүремін!
Dialogue: 0,1:10:33.35,1:10:34.27,Default,,0,0,0,,Уф...
Dialogue: 0,1:11:02.88,1:11:04.55,Default,,0,0,0,,Юлия қайда? Юлияны табыңыз!
Dialogue: 0,1:11:04.96,1:11:06.67,Default,,0,0,0,,Жарайды, сергек болыңыз.
Dialogue: 0,1:11:06.80,1:11:08.22,Default,,0,0,0,,Эй, Юлия сонда болды ма?
Dialogue: 0,1:11:08.43,1:11:10.34,Default,,0,0,0,,Сіз айтқандай, бұл бәрі емес.
Dialogue: 0,1:11:10.47,1:11:12.30,Default,,0,0,0,,Кенохтың әскері өте жақын
Dialogue: 0,1:11:12.47,1:11:14.56,Default,,0,0,0,,Бұл да емес пе?
Dialogue: 0,1:11:14.97,1:11:16.06,Default,,0,0,0,,Иә... өтінемін, мені кешіріңіз.
Dialogue: 0,1:11:16.18,1:11:17.35,Default,,0,0,0,,Тек... Ах!
Dialogue: 0,1:11:17.48,1:11:21.36,Default,,0,0,0,,Бұл ел сенің арқаңда бар, Юлия.
Dialogue: 0,1:11:22.23,1:11:24.36,Default,,0,0,0,,Юлия мен үшін бәрі!
Dialogue: 0,1:11:27.44,1:11:28.86,Default,,0,0,0,,Хаа ха...
Dialogue: 0,1:11:40.87,1:11:41.71,Default,,0,0,0,,Ах
Dialogue: 0,1:12:13.74,1:12:16.87,Default,,0,0,0,,А, бұл сыртта.
Dialogue: 0,1:12:20.16,1:12:21.00,Default,,0,0,0,,Уф...
Dialogue: 0,1:12:29.63,1:12:30.67,Default,,0,0,0,,Ах...
Dialogue: 0,1:12:36.18,1:12:37.85,Default,,0,0,0,,Келдің бе, Кенох әскері?
Dialogue: 0,1:12:38.47,1:12:42.27,Default,,0,0,0,,Бірақ Юрия, мен тек сен үшін күрестім.
Dialogue: 0,1:12:42.98,1:12:45.69,Default,,0,0,0,,Менің әуестігім тек сені алу
Dialogue: 0,1:12:45.81,1:12:47.27,Default,,0,0,0,,Мен жұмсадым
Dialogue: 0,1:12:48.11,1:12:51.20,Default,,0,0,0,,Енді сен кеткен соң, мен...
Dialogue: 0,1:12:52.24,1:12:54.37,Default,,0,0,0,,Иә?
Dialogue: 0,1:13:00.75,1:13:02.12,Default,,0,0,0,,Ки... Сіз Кен-осыз ба?
Dialogue: 0,1:13:03.04,1:13:05.88,Default,,0,0,0,,Мен сенің әйеліңді ұстадым.
Dialogue: 0,1:13:06.00,1:13:06.96,Default,,0,0,0,,Не?
Dialogue: 0,1:13:07.96,1:13:11.01,Default,,0,0,0,,Хехе... Хахахахаха!
Dialogue: 0,1:13:11.92,1:13:14.51,Default,,0,0,0,,Соны айту үшін өлтіру үшін келдің бе?
Dialogue: 0,1:13:14.93,1:13:17.85,Default,,0,0,0,,Мен бақыттымын. Сіздің арқаңызда менің жауынгерлік рухым қайта жаңғырды.
Dialogue: 0,1:13:17.97,1:13:20.89,Default,,0,0,0,,Мен сені өлтіріп, Юлияны қайтарамын.
Dialogue: 0,1:13:21.02,1:13:23.98,Default,,0,0,0,,Иә, әйтпесе ол сен болмас едің.
Dialogue: 0,1:13:24.10,1:13:26.48,Default,,0,0,0,,Кел, Шин.
Dialogue: 0,1:13:26.90,1:13:27.90,Default,,0,0,0,,Не?
Dialogue: 0,1:14:07.44,1:14:08.27,Default,,0,0,0,,Иә?
Dialogue: 0,1:14:11.53,1:14:14.24,Default,,0,0,0,,Бұл Оңтүстік Крест қаласы ма? мочевина!
Dialogue: 0,1:14:59.49,1:15:00.32,Default,,0,0,0,,Шин
Dialogue: 0,1:15:00.53,1:15:01.91,Default,,0,0,0,,Кенширо
Dialogue: 0,1:15:02.37,1:15:05.29,Default,,0,0,0,,Жарайсың, осы уақытқа дейін келдің, мақтайын.
Dialogue: 0,1:15:05.45,1:15:08.92,Default,,0,0,0,,Мен сені жеңу үшін тозақтың түбінен оралдым.
Dialogue: 0,1:15:09.42,1:15:11.88,Default,,0,0,0,,Сізді не өзгертті?
Dialogue: 0,1:15:12.00,1:15:13.21,Default,,0,0,0,,Оңбау…
Dialogue: 0,1:15:13.42,1:15:16.80,Default,,0,0,0,,Мені өзгерткен нәрсе - маған үйреткеніңіз...
Dialogue: 0,1:15:17.13,1:15:18.26,Default,,0,0,0,,Оңбау!
Dialogue: 0,1:15:18.38,1:15:24.26,Default,,0,0,0,,Хехехе, сонда сенің қайсарлығың қаншалықты күшті екенін көрейік.
Dialogue: 0,1:15:24.64,1:15:25.89,Default,,0,0,0,,Юлия қайда?
Dialogue: 0,1:15:26.02,1:15:28.73,Default,,0,0,0,,Ғұн Қаласаң, өз қолыңмен ал.
Dialogue: 0,1:15:28.85,1:15:30.56,Default,,0,0,0,,Өл, Кенширо!
Dialogue: 0,1:15:33.86,1:15:34.73,Default,,0,0,0,,О
Dialogue: 0,1:15:37.78,1:15:41.49,Default,,0,0,0,,Ой... сен бұрынғы Кенширо емессің.
Dialogue: 0,1:15:41.70,1:15:44.87,Default,,0,0,0,,Шин Мен сенің барлық техникаңнан бас тарттым.
Dialogue: 0,1:15:44.99,1:15:45.83,Default,,0,0,0,,Ей, не істеп жатырсың?
Dialogue: 0,1:15:46.25,1:15:48.87,Default,,0,0,0,,Уф... Уау!
Dialogue: 0,1:15:49.29,1:15:50.12,Default,,0,0,0,,Аһ!
Dialogue: 0,1:15:50.62,1:15:54.13,Default,,0,0,0,,Кенширо, сен мықтысың...
Dialogue: 0,1:15:54.29,1:15:55.63,Default,,0,0,0,,Күрсін!
Dialogue: 0,1:15:56.17,1:15:58.51,Default,,0,0,0,,Хмм... Уау!
Dialogue: 0,1:16:01.05,1:16:05.43,Default,,0,0,0,,Шин Бұл тыртық Хокуто Шинкен!
Dialogue: 0,1:16:05.76,1:16:08.06,Default,,0,0,0,,Кенширо, сен кешігіп қалдың.
Dialogue: 0,1:16:09.98,1:16:12.94,Default,,0,0,0,,Юрия мені кешірсе... Арх!
Dialogue: 0,1:16:13.06,1:16:15.48,Default,,0,0,0,,Маған бұл қамал да, бұл күш те керек емес.
Dialogue: 0,1:16:15.94,1:16:20.99,Default,,0,0,0,,Бірақ сен әрқашан Юлияның жүрегінде болдың.
Dialogue: 0,1:16:22.03,1:16:23.78,Default,,0,0,0,,Сіздің иллюзияңыз
Dialogue: 0,1:16:23.99,1:16:25.70,Default,,0,0,0,,Шин Юрия қайда?
Dialogue: 0,1:16:26.12,1:16:27.12,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:16:36.00,1:16:40.72,Default,,0,0,0,,Бұл Юлия маған киюі тиіс қалыңдық костюмі.
Dialogue: 0,1:16:40.97,1:16:43.22,Default,,0,0,0,,Бірақ Юлия жоқ.
Dialogue: 0,1:16:43.34,1:16:44.18,Default,,0,0,0,,Не?
Dialogue: 0,1:16:44.30,1:16:45.30,Default,,0,0,0,,Юлия...
Dialogue: 0,1:16:46.26,1:16:48.97,Default,,0,0,0,,Раонның қолына түсті
Dialogue: 0,1:16:49.10,1:16:49.98,Default,,0,0,0,,Не!
Dialogue: 0,1:16:50.31,1:16:55.52,Default,,0,0,0,,Ғасырдың соңындағы чемпион Кенох - сіздің ағаңыз Раохтың өзгеруі.
Dialogue: 0,1:16:55.73,1:16:57.02,Default,,0,0,0,,Бұл Раох!
Dialogue: 0,1:16:57.32,1:17:00.11,Default,,0,0,0,,Ол саған хабар бар деді.
Dialogue: 0,1:17:00.53,1:17:05.53,Default,,0,0,0,,Бұл Солтүстік жұлдыздың жұдырығы менің денемде қалды...
Dialogue: 0,1:17:05.82,1:17:07.78,Default,,0,0,0,,Маған арналған хабарлама...
Dialogue: 0,1:17:08.16,1:17:12.54,Default,,0,0,0,,Кенширо Раох жындар жылайтын Кассандра қаласында.
Dialogue: 0,1:17:12.66,1:17:15.54,Default,,0,0,0,,Кассандра Демонның жылаған қаласы
Dialogue: 0,1:17:15.96,1:17:18.09,Default,,0,0,0,,Мен Юлияны жақсы көретінмін
Dialogue: 0,1:17:18.67,1:17:22.51,Default,,0,0,0,,Өлетін болсам, қолыңнан өлгім келді.
Dialogue: 0,1:17:23.01,1:17:26.18,Default,,0,0,0,,Өйткені біз бір әйелді жақсы көрген еркекпіз
Dialogue: 0,1:17:26.68,1:17:27.97,Default,,0,0,0,,Уау! Шин!
Dialogue: 0,1:17:28.14,1:17:29.81,Default,,0,0,0,,Уау... Уау!
Dialogue: 0,1:17:38.02,1:17:42.61,Default,,0,0,0,,Кеншироны Кассандраға барыңыз
Dialogue: 0,1:18:01.67,1:18:05.26,Default,,0,0,0,,Бір әйелді жақсы көрген адам
Dialogue: 0,1:18:26.53,1:18:29.78,Default,,0,0,0,,Кенох! Кен-о!
Dialogue: 0,1:18:30.41,1:18:34.41,Default,,0,0,0,,Кенох! Кен-о!
Dialogue: 0,1:18:34.54,1:18:35.66,Default,,0,0,0,,Жарайды, дұрыс.
Dialogue: 0,1:18:35.79,1:18:39.25,Default,,0,0,0,,Қатты сөйлеп, Кен патшаны қарсы алыңыз.
Dialogue: 0,1:18:39.38,1:18:41.59,Default,,0,0,0,,Кекке~ Кенох~
Dialogue: 0,1:18:41.71,1:18:45.09,Default,,0,0,0,,Құрметті, қарқын өшірілді.
Dialogue: 0,1:18:45.22,1:18:47.63,Default,,0,0,0,,(аудитория айқайлауы)
Dialogue: 0,1:18:48.09,1:18:52.64,Default,,0,0,0,,Келіңдер, балалар! Қатты сөйле! бұл~!
Dialogue: 0,1:18:52.76,1:18:58.02,Default,,0,0,0,,Кенох! Кен-о! Кен-о!
Dialogue: 0,1:19:04.03,1:19:08.99,Default,,0,0,0,,(айқайлайтын аты)
Dialogue: 0,1:19:12.58,1:19:16.20,Default,,0,0,0,,Кенох! Кен-о!
Dialogue: 0,1:19:19.75,1:19:22.50,Default,,0,0,0,,Ғасырдың соңындағы чемпиондар, Кенох әскері.
Dialogue: 0,1:19:22.71,1:19:26.17,Default,,0,0,0,,Керемет! Мен қарап көрейін
Dialogue: 0,1:19:26.67,1:19:27.92,Default,,0,0,0,,Мен де!
Dialogue: 0,1:19:28.05,1:19:30.47,Default,,0,0,0,,Жүр, тапталып кетесің.
Dialogue: 0,1:19:34.26,1:19:35.60,Default,,0,0,0,,Бұл әйелдің Қанды Пері Шығармасы ма?
Dialogue: 0,1:19:36.85,1:19:40.23,Default,,0,0,0,,Кено! Кен-о!
Dialogue: 0,1:19:45.73,1:19:46.90,Default,,0,0,0,,Ах!
Dialogue: 0,1:19:51.45,1:19:53.91,Default,,0,0,0,,Уау! Ах...
Dialogue: 0,1:20:08.63,1:20:10.68,Default,,0,0,0,,Не болды? қара патша
Dialogue: 0,1:20:11.26,1:20:12.14,Default,,0,0,0,,Иә?
Dialogue: 0,1:20:30.74,1:20:31.70,Default,,0,0,0,,Уф...
Dialogue: 0,1:20:34.53,1:20:37.87,Default,,0,0,0,,
Dialogue: 0,1:20:40.75,1:20:44.25,Default,,0,0,0,,Кенох! Кен-о!
Dialogue: 0,1:20:44.67,1:20:48.21,Default,,0,0,0,,Кенох! Кен-о!
Dialogue: 0,1:20:50.84,1:20:52.68,Default,,0,0,0,,А, бұл қорқынышты болды.
Dialogue: 0,1:20:53.01,1:20:54.26,Default,,0,0,0,,Бол!
Dialogue: 0,1:20:54.68,1:20:55.51,Default,,0,0,0,,Ах
Dialogue: 0,1:20:57.18,1:20:58.01,Default,,0,0,0,,Ах
Dialogue: 0,1:21:04.48,1:21:08.32,Default,,0,0,0,,Юлия-сан... Бұл Юлия-сан екеніне күмәнім жоқ.
Dialogue: 0,1:21:29.09,1:21:32.67,Default,,0,0,0,,Мен өз күшіммен бәрін басқардым.
Dialogue: 0,1:21:33.05,1:21:35.26,Default,,0,0,0,,Маған қарсы шыққандар жойылды.
Dialogue: 0,1:21:35.72,1:21:39.76,Default,,0,0,0,,Менің алдымда Хокуто да, Нанто да маңызды емес.
Dialogue: 0,1:21:39.97,1:21:44.60,Default,,0,0,0,,Аспанды ұстап, Кең-Коу деп атадым.
Dialogue: 0,1:21:46.56,1:21:49.94,Default,,0,0,0,,Бірақ бірдеңе болып жатыр.
Dialogue: 0,1:21:50.07,1:21:53.61,Default,,0,0,0,,Бірақ әлі ерте... тым ерте
Dialogue: 0,1:21:56.36,1:22:00.12,Default,,0,0,0,,Не? Бұл әйел Юлия.
Dialogue: 0,1:22:00.37,1:22:03.96,Default,,0,0,0,,Түсіндім, бұл сөзсіз Юлия.
Dialogue: 0,1:22:04.08,1:22:07.71,Default,,0,0,0,,Өйткені, Юлия Оңтүстік Крестте болуы керек.
Dialogue: 0,1:22:09.75,1:22:10.59,Default,,0,0,0,,Сонымен Кен...
Dialogue: 0,1:22:10.71,1:22:13.38,Default,,0,0,0,,Сөз жоқ, бұл Юлия.
Dialogue: 0,1:22:13.63,1:22:17.18,Default,,0,0,0,,Мен мұнда... қандай да бір себептермен келдім.
Dialogue: 0,1:22:17.30,1:22:21.31,Default,,0,0,0,,Егер Бат Лин солай айтса, бұл Юлия болуы керек.
Dialogue: 0,1:22:21.43,1:22:24.77,Default,,0,0,0,,Иә, бұл жігіттің бір ерекшелігі бар.
Dialogue: 0,1:22:24.89,1:22:27.90,Default,,0,0,0,,Ой, егер солай болса, неге оны зерттеп көрмеске!
Dialogue: 0,1:22:28.06,1:22:30.57,Default,,0,0,0,,Мен жарғанатты тауып көрейін...
Dialogue: 0,1:22:30.82,1:22:32.61,Default,,0,0,0,,Кассандра сарайында зындан бар.
Dialogue: 0,1:22:32.90,1:22:34.74,Default,,0,0,0,,Юлияның сонда болатынына сенімдімін.
Dialogue: 0,1:22:34.86,1:22:36.07,Default,,0,0,0,,Бат
Dialogue: 0,1:22:36.24,1:22:38.91,Default,,0,0,0,,Хехехе, аман қалу үшін тіпті балшық та жасадым.
Dialogue: 0,1:22:39.03,1:22:41.16,Default,,0,0,0,,Мыналарды маған қалдырыңыз.
Dialogue: 0,1:22:41.28,1:22:42.12,Default,,0,0,0,,Не?
Dialogue: 0,1:22:44.41,1:22:48.50,Default,,0,0,0,,Сондықтан сізге тек жер асты кәріз жүйесіне кіретін жолды табу керек.
Dialogue: 0,1:22:48.63,1:22:51.92,Default,,0,0,0,,Мм, ескі су көзі оңтүстікте болатын.
Dialogue: 0,1:22:52.05,1:22:54.26,Default,,0,0,0,,Өзеннен еңісті 3,5 градус деп есептесек
Dialogue: 0,1:22:54.38,1:22:56.93,Default,,0,0,0,,Хмм, зауыттан шығатын сұйықтықтың жолы...
Dialogue: 0,1:23:00.01,1:23:02.51,Default,,0,0,0,,Рин, саған ештеңе жетпейді.
Dialogue: 0,1:23:02.64,1:23:05.14,Default,,0,0,0,,Мен тек Юлия-сан ба деп тексеріп жатырмын.
Dialogue: 0,1:23:05.27,1:23:07.98,Default,,0,0,0,,Жоқ, мен Юлиямен танысқым келеді.
Dialogue: 0,1:23:08.14,1:23:11.31,Default,,0,0,0,,Мен сендерге мына гүлді көрсетіп, көңілдеріңді көтергім келеді.
Dialogue: 0,1:23:11.44,1:23:12.86,Default,,0,0,0,,Ммм
Dialogue: 0,1:23:20.49,1:23:23.45,Default,,0,0,0,,Иә! Атта!
Dialogue: 0,1:23:23.99,1:23:26.00,Default,,0,0,0,,Уф, жоқ.
Dialogue: 0,1:23:26.12,1:23:28.46,Default,,0,0,0,,Тот басқан, қозғалмайды.
Dialogue: 0,1:23:29.04,1:23:30.29,Default,,0,0,0,,Бат па?
Dialogue: 0,1:23:30.42,1:23:32.88,Default,,0,0,0,,Ей, эй, қашып құтыла аламын деп ойлайсың ба?
Dialogue: 0,1:23:48.23,1:23:50.23,Default,,0,0,0,,Ах, Юлия-сан.
Dialogue: 0,1:23:50.35,1:23:51.31,Default,,0,0,0,,Иә?
Dialogue: 0,1:23:57.74,1:23:58.99,Default,,0,0,0,,Ах...
Dialogue: 0,1:24:00.16,1:24:01.24,Default,,0,0,0,,Гүлдер!
Dialogue: 0,1:24:02.41,1:24:04.49,Default,,0,0,0,,Бұл гүл... Юлияның гүлі.
Dialogue: 0,1:24:04.62,1:24:05.45,Default,,0,0,0,,Иә?
Dialogue: 0,1:24:05.58,1:24:09.04,Default,,0,0,0,,Джулия бұл гүлдің тұқымын Кенге берді, ал Кен маған берді.
Dialogue: 0,1:24:09.16,1:24:10.00,Default,,0,0,0,,Джотаро Куджо мен оның достары
Dialogue: 0,1:24:10.75,1:24:14.09,Default,,0,0,0,,Ах Кенширо Кенширо...
Dialogue: 0,1:24:14.21,1:24:16.13,Default,,0,0,0,,Батыл бол, Юлия.
Dialogue: 0,1:24:16.34,1:24:19.92,Default,,0,0,0,,Иә, Кен міндетті түрде сізге көмекке келеді.
Dialogue: 0,1:24:20.43,1:24:22.72,Default,,0,0,0,,Кеншираға келмесін айт.
Dialogue: 0,1:24:22.84,1:24:23.68,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,1:24:24.01,1:24:25.85,Default,,0,0,0,,Жан түршігерлік нәрсе болады
Dialogue: 0,1:24:26.35,1:24:29.56,Default,,0,0,0,,Бұл дүниеде біз бір-бірімізге байланысты емеспіз.
Dialogue: 0,1:24:30.02,1:24:33.19,Default,,0,0,0,,Мен мұнда тұзаққа түсуге дайындалдым.
Dialogue: 0,1:24:33.31,1:24:35.98,Default,,0,0,0,,Міне... Кеннің жалғыз мақсаты - Юрияға көмектесу...
Dialogue: 0,1:24:36.11,1:24:37.19,Default,,0,0,0,,Ах
Dialogue: 0,1:24:37.65,1:24:39.32,Default,,0,0,0,,Тез жүр!
Dialogue: 0,1:24:39.44,1:24:41.82,Default,,0,0,0,,Өзіңді күт, Юлия.
Dialogue: 0,1:24:44.57,1:24:45.83,Default,,0,0,0,,Кенширо...
Dialogue: 0,1:24:56.71,1:24:57.96,Default,,0,0,0,,Хмм?
Dialogue: 0,1:25:03.18,1:25:04.97,Default,,0,0,0,,Мына гүлге не болды?
Dialogue: 0,1:25:06.22,1:25:10.35,Default,,0,0,0,,Бұл зұлмат заман, Гүл жаймас.
Dialogue: 0,1:25:10.48,1:25:13.81,Default,,0,0,0,,Жас әлі гүлдің гүлдегенін қаламайды.
Dialogue: 0,1:25:20.11,1:25:22.99,Default,,0,0,0,,Орындау! Кенох әскерінің өлімі басталады!
Dialogue: 0,1:25:28.91,1:25:31.45,Default,,0,0,0,,Мына гүлге қараңдар!
Dialogue: 0,1:25:31.66,1:25:33.16,Default,,0,0,0,,Бұл – чай. Дәмі керемет.
Dialogue: 0,1:25:33.29,1:25:34.50,Default,,0,0,0,,Бұл рас.
Dialogue: 0,1:25:35.58,1:25:38.46,Default,,0,0,0,,Гүлдер (адам) Гүлдер гүлдейді.
Dialogue: 0,1:25:38.59,1:25:41.63,Default,,0,0,0,,Әй, гүлдерді қайта көру үшін
Dialogue: 0,1:25:41.88,1:25:45.14,Default,,0,0,0,,Топырақ... топырақ әлі тірі еді.
Dialogue: 0,1:25:45.64,1:25:50.14,Default,,0,0,0,,Кен патша бұл гүлді көргенде ашуланады.
Dialogue: 0,1:25:50.89,1:25:53.64,Default,,0,0,0,,Оның гүлденуіне себепші болған сендердің араларыңда.
Dialogue: 0,1:25:54.02,1:25:56.15,Default,,0,0,0,,Ол адам алға шығуы керек!
Dialogue: 0,1:25:56.27,1:25:58.90,Default,,0,0,0,,Әйтпесе мен бұл әйелді өлтіремін.
Dialogue: 0,1:25:59.73,1:26:01.11,Default,,0,0,0,,Юлия өлтірілді
Dialogue: 0,1:26:01.23,1:26:02.49,Default,,0,0,0,,Рин... Рин
Dialogue: 0,1:26:03.15,1:26:03.99,Default,,0,0,0,,Рей
Dialogue: 0,1:26:04.86,1:26:06.74,Default,,0,0,0,,Мен Юлияға көмектесемін.
Dialogue: 0,1:26:12.29,1:26:14.79,Default,,0,0,0,,Мен Нанто Суйчукеннен келген Реймін
Dialogue: 0,1:26:16.88,1:26:17.71,Default,,0,0,0,,Иә?
Dialogue: 0,1:26:18.04,1:26:19.25,Default,,0,0,0,,Кеноға айт
Dialogue: 0,1:26:19.38,1:26:24.17,Default,,0,0,0,,Бұл гүлді Хокуто Шинкеннің мұрагері Кенширо гүлдендірді.
Dialogue: 0,1:26:24.88,1:26:26.93,Default,,0,0,0,,Кенширо ше?
Dialogue: 0,1:26:27.39,1:26:29.89,Default,,0,0,0,,Гүлдер - Кенширо мен Юрия
Dialogue: 0,1:26:30.39,1:26:33.27,Default,,0,0,0,,Ал Риннің махаббаты оны гүлдендірді.
Dialogue: 0,1:26:34.68,1:26:35.69,Default,,0,0,0,,Махаббат?
Dialogue: 0,1:26:36.14,1:26:39.77,Default,,0,0,0,,Бұл қараңғы дүниеде махаббат түкке тұрғысыз
Dialogue: 0,1:26:39.90,1:26:40.73,Default,,0,0,0,,ұйғыр
Dialogue: 0,1:26:41.15,1:26:42.65,Default,,0,0,0,,Хаха~
Dialogue: 0,1:26:45.32,1:26:46.15,Default,,0,0,0,,Ах...
Dialogue: 0,1:26:46.45,1:26:49.57,Default,,0,0,0,,Рэй мен мына ұйғыр-сама қамшы.
Dialogue: 0,1:26:49.70,1:26:52.16,Default,,0,0,0,,Толық дәмін татып көр
Dialogue: 0,1:26:52.45,1:26:55.54,Default,,0,0,0,,Мен Кенохты жеңу үшін келдім
Dialogue: 0,1:26:56.08,1:26:59.13,Default,,0,0,0,,Менің сен сияқты ұсақ-түйек адамдарға алаңдайтын уақытым жоқ.
Dialogue: 0,1:26:59.25,1:27:04.09,Default,,0,0,0,,Бала, жүр!
Dialogue: 0,1:27:05.17,1:27:06.01,Default,,0,0,0,,Әй!
Dialogue: 0,1:27:07.63,1:27:08.51,Default,,0,0,0,,Сәлем! Эй!
Dialogue: 0,1:27:08.64,1:27:11.76,Default,,0,0,0,,Уау! Не?
Dialogue: 0,1:27:12.39,1:27:16.18,Default,,0,0,0,,Не болды? Мен баяу қозғалып жатқаным сонша, есінеймін
Dialogue: 0,1:27:16.73,1:27:19.90,Default,,0,0,0,,Аузыңды жап!
Dialogue: 0,1:27:25.28,1:27:28.03,Default,,0,0,0,,Хмф, мен оны бұл жолы байлай алмаймын деп ойлаймын.
Dialogue: 0,1:27:29.74,1:27:33.03,Default,,0,0,0,,Тайзан үлгісіндегі мың жо қамшы!
Dialogue: 0,1:27:33.58,1:27:34.83,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:27:36.96,1:27:38.04,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,1:27:41.63,1:27:44.63,Default,,0,0,0,,Кенох, келесі кезегің.
Dialogue: 0,1:27:44.80,1:27:45.67,Default,,0,0,0,,Эй...
Dialogue: 0,1:27:48.26,1:27:52.64,Default,,0,0,0,,Нанто Суйчоукеннің Рейінен күткендей, бұл керемет.
Dialogue: 0,1:27:52.85,1:27:55.64,Default,,0,0,0,,О, Рэй, тоқтат!
Dialogue: 0,1:27:55.77,1:27:59.35,Default,,0,0,0,,Ол адаммен ұрыспа!
Dialogue: 0,1:28:13.16,1:28:15.99,Default,,0,0,0,,Рин... Уайымдама.
Dialogue: 0,1:28:16.66,1:28:21.17,Default,,0,0,0,,Мен Кен екеуіңнің алдындағы қарызымды тек соғысу арқылы өтейтін адаммын.
Dialogue: 0,1:28:21.50,1:28:24.54,Default,,0,0,0,,Сізді келесі дәуір күтіп тұр.
Dialogue: 0,1:28:25.04,1:28:29.26,Default,,0,0,0,,Ой, аздап түсінген сияқтысың.
Dialogue: 0,1:28:29.72,1:28:33.47,Default,,0,0,0,,Бірақ менің дәуірім әлі де созылуы керек.
Dialogue: 0,1:28:33.59,1:28:35.39,Default,,0,0,0,,Олай ойламайсың ба, Рэй?
Dialogue: 0,1:28:35.76,1:28:37.31,Default,,0,0,0,,Уақыт асығыс
Dialogue: 0,1:28:37.43,1:28:39.39,Default,,0,0,0,,Осы жерде өл, Кенох
Dialogue: 0,1:28:39.64,1:28:43.94,Default,,0,0,0,,Жарайды, маған сенімен төбелесу жазылған сияқты.
Dialogue: 0,1:28:44.06,1:28:45.86,Default,,0,0,0,,Кез келген жерден келіңіз
Dialogue: 0,1:28:46.11,1:28:47.94,Default,,0,0,0,,Атыңнан түс, Кенох
Dialogue: 0,1:28:48.07,1:28:51.45,Default,,0,0,0,,Хехехе... Өзіңдікіндей қолдармен
Dialogue: 0,1:28:51.57,1:28:54.91,Default,,0,0,0,,Сіз мені жерге түсіруді ойладыңыз ба?
Dialogue: 0,1:28:55.16,1:28:59.54,Default,,0,0,0,,Бұл дүниеде мені тең дәрежеде қоятын адам жоқ.
Dialogue: 0,1:28:59.87,1:29:02.54,Default,,0,0,0,,Атқа мінудің жағымсыз жақтарын біл!
Dialogue: 0,1:29:59.60,1:30:01.47,Default,,0,0,0,,(үнсіздік)
Dialogue: 0,1:30:05.56,1:30:08.06,Default,,0,0,0,,(үнсіздік)
Dialogue: 0,1:31:31.98,1:31:35.32,Default,,0,0,0,,Болады!
Dialogue: 0,1:31:38.82,1:31:43.03,Default,,0,0,0,,Тез кел!
Dialogue: 0,1:31:48.62,1:31:49.67,Default,,0,0,0,,Уау
Dialogue: 0,1:31:50.25,1:31:54.05,Default,,0,0,0,,Рэй тарих үшін өледі!
Dialogue: 0,1:31:54.67,1:31:56.26,Default,,0,0,0,,Рэй! Ах
Dialogue: 0,1:31:56.38,1:31:57.22,Default,,0,0,0,,Ах...
Dialogue: 0,1:31:59.13,1:32:00.68,Default,,0,0,0,,Аһ!
Dialogue: 0,1:32:14.61,1:32:15.78,Default,,0,0,0,,Кен!
Dialogue: 0,1:32:16.07,1:32:17.99,Default,,0,0,0,,Ха... Юлия!
Dialogue: 0,1:32:18.53,1:32:20.49,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,1:32:21.78,1:32:24.16,Default,,0,0,0,,Сіз осындасыз ба? Кенширо
Dialogue: 0,1:32:24.41,1:32:26.20,Default,,0,0,0,,Рао сен!
Dialogue: 0,1:32:36.75,1:32:37.59,Default,,0,0,0,,Рей
Dialogue: 0,1:32:38.67,1:32:40.09,Default,,0,0,0,,Раох!
Dialogue: 0,1:32:40.38,1:32:42.09,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,1:32:42.22,1:32:46.01,Default,,0,0,0,,Мен Раох сияқты есімдерден баяғыда бас тарттым.
Dialogue: 0,1:32:46.22,1:32:48.31,Default,,0,0,0,,Мен ғасырдың соңындағы чемпионмын
Dialogue: 0,1:32:48.81,1:32:52.65,Default,,0,0,0,,Кен-О қазір аңызға айналған адам.
Dialogue: 0,1:32:53.15,1:32:56.77,Default,,0,0,0,,Кенширо Юрияны қаласаң, мені жең.
Dialogue: 0,1:33:13.62,1:33:15.00,Default,,0,0,0,,Күте тұрыңыз, Кенширо
Dialogue: 0,1:33:15.54,1:33:16.38,Default,,0,0,0,,Рей
Dialogue: 0,1:33:16.79,1:33:20.13,Default,,0,0,0,,Кен, қазір төбелессең, өлесің.
Dialogue: 0,1:33:21.17,1:33:23.38,Default,,0,0,0,,Екі жұдырық бірдей
Dialogue: 0,1:33:24.84,1:33:29.85,Default,,0,0,0,,Біз соқтығыссақ, басқа адамды жеңсек те, біз де талқандаймыз.
Dialogue: 0,1:33:31.35,1:33:36.02,Default,,0,0,0,,Уф... Мен мұнымен жақсымын.
Dialogue: 0,1:33:36.36,1:33:38.98,Default,,0,0,0,,Бұл менің тағдырым
Dialogue: 0,1:33:39.65,1:33:43.07,Default,,0,0,0,,Бірақ өмір сүру керек.
Dialogue: 0,1:33:43.61,1:33:46.99,Default,,0,0,0,,Сауда жасасаңыз да, ұтылғанмен бірдей.
Dialogue: 0,1:33:47.24,1:33:51.12,Default,,0,0,0,,Сіз келесі дәуірге керек адамсыз.
Dialogue: 0,1:33:51.95,1:33:55.00,Default,,0,0,0,,Лин мен Бат Юлия
Dialogue: 0,1:33:55.79,1:33:57.75,Default,,0,0,0,,Барлығы үшін -
Dialogue: 0,1:33:58.17,1:34:00.38,Default,,0,0,0,,Біз өмір сүруді жалғастыруымыз керек.
Dialogue: 0,1:34:01.46,1:34:04.51,Default,,0,0,0,,Өлме, Кенширо
Dialogue: 0,1:34:05.59,1:34:06.51,Default,,0,0,0,,Уф...
Dialogue: 0,1:34:07.55,1:34:08.39,Default,,0,0,0,,Рэй!
Dialogue: 0,1:34:16.44,1:34:18.52,Default,,0,0,0,,Раох өлуі керек!
Dialogue: 0,1:34:18.86,1:34:21.73,Default,,0,0,0,,Хокуто 2000 ережелері
Dialogue: 0,1:34:23.32,1:34:25.32,Default,,0,0,0,,Әзілдеме!
Dialogue: 0,1:34:26.49,1:34:29.83,Default,,0,0,0,,Иә, ашулан! Ашулан, Кенширо!
Dialogue: 0,1:34:30.12,1:34:32.83,Default,,0,0,0,,Күрсін!
Dialogue: 0,1:34:32.95,1:34:33.79,Default,,0,0,0,,Хмф!
Dialogue: 0,1:34:34.62,1:34:35.66,Default,,0,0,0,,Уф… Мұнда не болып жатыр өзі?
Dialogue: 0,1:34:44.17,1:34:48.01,Default,,0,0,0,,Хахаха... Не болды, Кенширо?
Dialogue: 0,1:34:48.22,1:34:51.81,Default,,0,0,0,,Көргеніңіз – менің жауынгерлік рухым, менің аурам.
Dialogue: 0,1:34:52.35,1:34:55.64,Default,,0,0,0,,Өлімнен естелік ретінде тағы бір айта кетейін.
Dialogue: 0,1:34:55.89,1:34:59.31,Default,,0,0,0,,Әкеміз Рюкенді өлтірген менмін.
Dialogue: 0,1:34:59.81,1:35:00.77,Default,,0,0,0,,Ах...
Dialogue: 0,1:35:06.90,1:35:11.08,Default,,0,0,0,,Күрсін!
Dialogue: 0,1:35:11.20,1:35:14.08,Default,,0,0,0,,Ашуыңызды аураға айналдырыңыз
Dialogue: 0,1:35:14.29,1:35:19.00,Default,,0,0,0,,Ахх!
Dialogue: 0,1:35:21.17,1:35:22.71,Default,,0,0,0,,
Dialogue: 0,1:35:22.88,1:35:25.38,Default,,0,0,0,,Сабыр ет, Қара патша
Dialogue: 0,1:35:25.51,1:35:28.93,Default,,0,0,0,,Сіз Қара патшаны сонша қорқытқан бірінші адамсыз.
Dialogue: 0,1:35:29.05,1:35:29.89,Default,,0,0,0,,Тынышталыңыз
Dialogue: 0,1:35:35.06,1:35:36.77,Default,,0,0,0,,О, мен оны көріп тұрмын.
Dialogue: 0,1:35:36.93,1:35:38.77,Default,,0,0,0,,Мен сіздің аураңызды көремін
Dialogue: 0,1:35:39.52,1:35:41.11,Default,,0,0,0,,Кел, Кенширо
Dialogue: 0,1:35:41.23,1:35:44.44,Default,,0,0,0,,Мен сенің өсуіңді көрсетейін.
Dialogue: 0,1:35:45.15,1:35:48.40,Default,,0,0,0,,Өлім өз орнында болсын
Dialogue: 0,1:35:49.91,1:35:53.91,Default,,0,0,0,,Күрсін!
Dialogue: 0,1:35:54.33,1:35:57.71,Default,,0,0,0,,Күрсін!
Dialogue: 0,1:36:01.33,1:36:02.71,Default,,0,0,0,,
Dialogue: 0,1:36:08.59,1:36:11.26,Default,,0,0,0,,Ах... Ах!
Dialogue: 0,1:36:12.30,1:36:14.31,Default,,0,0,0,,Мұнда кел!
Dialogue: 0,1:36:15.97,1:36:17.60,Default,,0,0,0,,Уау!
Dialogue: 0,1:36:20.81,1:36:21.90,Default,,0,0,0,,Кен!
Dialogue: 0,1:36:24.15,1:36:24.98,Default,,0,0,0,,Ах
Dialogue: 0,1:36:25.27,1:36:27.94,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,1:36:29.74,1:36:30.91,Default,,0,0,0,,Юлия
Dialogue: 0,1:36:32.36,1:36:33.74,Default,,0,0,0,,Уау!
Dialogue: 0,1:36:36.99,1:36:38.04,Default,,0,0,0,,Ке~н!
Dialogue: 0,1:36:41.21,1:36:42.79,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:36:51.01,1:36:53.68,Default,,0,0,0,,Атататата...
Dialogue: 0,1:36:53.80,1:36:54.64,Default,,0,0,0,,Ал әйелім ше? Әйелім мен ұлым? Екеуі де аман ба?
Dialogue: 0,1:36:56.89,1:36:57.85,Default,,0,0,0,,Уау!
Dialogue: 0,1:37:01.31,1:37:02.27,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,1:37:06.15,1:37:07.73,Default,,0,0,0,,Атта! (Кенох) Торя!
Dialogue: 0,1:37:09.82,1:37:11.70,Default,,0,0,0,,(Айқай)
Dialogue: 0,1:37:15.16,1:37:16.08,Default,,0,0,0,,Ах...
Dialogue: 0,1:37:17.16,1:37:19.12,Default,,0,0,0,,Мен шынымен де мықты энергияны сезіп тұрмын!
Dialogue: 0,1:37:25.42,1:37:27.00,Default,,0,0,0,,О, ау!
Dialogue: 0,1:37:31.34,1:37:32.51,Default,,0,0,0,,Күрсін!
Dialogue: 0,1:37:32.63,1:37:34.01,Default,,0,0,0,,Хмм...
Dialogue: 0,1:37:36.14,1:37:40.72,Default,,0,0,0,,Жарайды, енді менің денемді жарақаттап алдың.
Dialogue: 0,1:37:40.85,1:37:44.14,Default,,0,0,0,,Мен сізбен бір жерде тұруым керек.
Dialogue: 0,1:37:47.27,1:37:52.44,Default,,0,0,0,,Сенің тәнің де, жаның да менің қиялымнан асып түседі.
Dialogue: 0,1:37:52.57,1:37:56.78,Default,,0,0,0,,Өйткені, сенің өмірің осы жерде аяқталуы керек.
Dialogue: 0,1:37:56.91,1:37:58.53,Default,,0,0,0,,Хмф!
Dialogue: 0,1:38:03.37,1:38:04.54,Default,,0,0,0,,Аттах!
Dialogue: 0,1:38:05.21,1:38:09.30,Default,,0,0,0,,Атататата...
Dialogue: 0,1:38:13.01,1:38:13.84,Default,,0,0,0,,Уау!
Dialogue: 0,1:38:13.97,1:38:15.68,Default,,0,0,0,,Хаа ха...
Dialogue: 0,1:38:17.80,1:38:21.06,Default,,0,0,0,,Хехехе, сүйек сынды ма?
Dialogue: 0,1:38:21.18,1:38:23.35,Default,,0,0,0,,Аяқтау... Уау.
Dialogue: 0,1:38:24.69,1:38:25.73,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,1:38:29.06,1:38:32.23,Default,,0,0,0,,Уф...
Dialogue: 0,1:38:40.28,1:38:44.54,Default,,0,0,0,,Хаа ха... Атта!
Dialogue: 0,1:38:45.66,1:38:48.79,Default,,0,0,0,,Уау... Әй!
Dialogue: 0,1:38:52.55,1:38:55.22,Default,,0,0,0,,Ах, а...
Dialogue: 0,1:39:15.74,1:39:17.15,Default,,0,0,0,,Уау
Dialogue: 0,1:39:18.57,1:39:20.20,Default,,0,0,0,,Күрсін!
Dialogue: 0,1:39:21.83,1:39:23.58,Default,,0,0,0,,Кенширо
Dialogue: 0,1:39:26.29,1:39:27.12,Default,,0,0,0,,Бұл тек алдын алу тексерісі ғана
Dialogue: 0,1:39:31.50,1:39:34.38,Default,,0,0,0,,(қақтығыс дыбысы)
Dialogue: 0,1:39:37.42,1:39:41.14,Default,,0,0,0,,(Найзағай)
Dialogue: 0,1:39:54.27,1:39:57.90,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,1:40:02.28,1:40:03.70,Default,,0,0,0,,Уау...
Dialogue: 0,1:40:04.49,1:40:06.83,Default,,0,0,0,,Уф… Мұнда не болып жатыр өзі?
Dialogue: 0,1:40:08.12,1:40:09.25,Default,,0,0,0,,Уф...
Dialogue: 0,1:40:09.46,1:40:10.71,Default,,0,0,0,,Уау!
Dialogue: 0,1:40:17.21,1:40:21.30,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,1:40:21.89,1:40:24.93,Default,,0,0,0,,Хмф! Мінеки біз!
Dialogue: 0,1:40:25.14,1:40:25.97,Default,,0,0,0,,Ой…
Dialogue: 0,1:40:29.35,1:40:31.69,Default,,0,0,0,,Хаа ха...
Dialogue: 0,1:40:45.45,1:40:47.79,Default,,0,0,0,,Хаа ха...
Dialogue: 0,1:40:48.41,1:40:51.37,Default,,0,0,0,,Хаа ха...
Dialogue: 0,1:41:15.77,1:41:17.15,Default,,0,0,0,,Кенширо...
Dialogue: 0,1:41:18.82,1:41:20.53,Default,,0,0,0,,Сіз күштірек болдыңыз.
Dialogue: 0,1:41:21.74,1:41:23.70,Default,,0,0,0,,Ра... Раох
Dialogue: 0,1:41:24.78,1:41:27.70,Default,,0,0,0,,Менің жұдырығым жеңілмейтін, жеңілмейтін
Dialogue: 0,1:41:28.74,1:41:30.87,Default,,0,0,0,,Осы соңғы соққымен
Dialogue: 0,1:41:31.00,1:41:34.50,Default,,0,0,0,,Хокутоның 2000 жылдық тарихын аяқтау
Dialogue: 0,1:41:34.63,1:41:36.63,Default,,0,0,0,,Мен сені өлтіремін
Dialogue: 0,1:41:36.96,1:41:40.76,Default,,0,0,0,,Менің жұдырығым Солтүстік жұлдыздан асып түседі
Dialogue: 0,1:41:41.59,1:41:44.84,Default,,0,0,0,,Хокуто Кенширомен бірге өліңіз
Dialogue: 0,1:41:44.97,1:41:46.51,Default,,0,0,0,,Дея!
Dialogue: 0,1:41:47.22,1:41:50.14,Default,,0,0,0,,Күрсін!
Dialogue: 0,1:41:50.97,1:41:51.81,Default,,0,0,0,,Ол – Лорд Широ.
Dialogue: 0,1:41:55.85,1:41:58.36,Default,,0,0,0,,Сенің арқасында тіпті трусигім де суға малып кетті. О, Құдай-ай…
Dialogue: 0,1:42:09.70,1:42:12.75,Default,,0,0,0,,Оны қазірдің өзінде тоқтатыңыз.
Dialogue: 0,1:42:14.12,1:42:16.75,Default,,0,0,0,,Бұл сенсің ғой.
Dialogue: 0,1:42:18.79,1:42:22.26,Default,,0,0,0,,Енді бір-біріңді өлтірмеңдер
Dialogue: 0,1:42:22.84,1:42:26.93,Default,,0,0,0,,Осы Кеноның артынан қуған сен бе?
Dialogue: 0,1:42:27.85,1:42:31.64,Default,,0,0,0,,...
Dialogue: 0,1:42:31.85,1:42:36.48,Default,,0,0,0,,Ал менің де құлауға шамасы жоқ.
Dialogue: 0,1:42:36.94,1:42:41.11,Default,,0,0,0,,...
Dialogue: 0,1:42:48.03,1:42:52.87,Default,,0,0,0,,...
Dialogue: 0,1:42:54.00,1:42:57.29,Default,,0,0,0,,...
Dialogue: 0,1:43:06.01,1:43:07.18,Default,,0,0,0,,...
Dialogue: 0,1:43:08.59,1:43:10.89,Default,,0,0,0,,...
Dialogue: 0,1:43:11.26,1:43:15.10,Default,,0,0,0,,Бұл Раох бір сәтте өлімге дайындалды.
Dialogue: 0,1:43:15.85,1:43:21.11,Default,,0,0,0,,Егер Рин шықпаса, бұл Раох құлап қалуы мүмкін еді.
Dialogue: 0,1:43:21.32,1:43:26.24,Default,,0,0,0,,…
Dialogue: 0,1:43:26.65,1:43:28.82,Default,,0,0,0,,...
Dialogue: 0,1:43:29.16,1:43:34.49,Default,,0,0,0,,Бүгін сіз бен біздің арамыздағы шайқас басталды.
Dialogue: 0,1:44:04.73,1:44:06.90,Default,,0,0,0,,...
Dialogue: 0,1:44:07.19,1:44:09.11,Default,,0,0,0,,…
Dialogue: 0,1:44:09.28,1:44:10.53,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:44:11.07,1:44:13.16,Default,,0,0,0,,Өйткені бәрі желге ұшып кетті.
Dialogue: 0,1:44:14.91,1:44:17.08,Default,,0,0,0,,２
Dialogue: 0,1:44:17.20,1:44:19.71,Default,,0,0,0,,Ол бізге тағы да қонаққа келеді.
Dialogue: 0,1:44:20.67,1:44:21.63,Default,,0,0,0,,…
Dialogue: 0,1:44:32.14,1:44:33.18,Default,,0,0,0,,Ах...
Dialogue: 0,1:44:34.51,1:44:38.43,Default,,0,0,0,,...
Dialogue: 0,1:44:39.31,1:44:42.73,Default,,0,0,0,,Әй, өлі топырақ ұшып кетті.
Dialogue: 0,1:44:43.52,1:44:44.73,Default,,0,0,0,,〜 〜
Dialogue: 0,1:44:45.07,1:44:48.19,Default,,0,0,0,,（２）
Dialogue: 0,1:44:48.61,1:44:50.61,Default,,0,0,0,,〜 〜
Dialogue: 0,1:44:56.24,1:44:58.29,Default,,0,0,0,,Иә! Хахаха…
Dialogue: 0,1:44:58.87,1:45:02.21,Default,,0,0,0,,… 〜
Dialogue: 0,1:45:42.25,1:45:48.25,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,1:46:04.39,1:46:05.52,Default,,0,0,0,,...
Dialogue: 0,1:49:40.15,1:49:46.16,Default,,0,0,0,,~♪
Dialogue: 0,1:49:47.66,1:49:53.66,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory