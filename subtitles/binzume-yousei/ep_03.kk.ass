Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.40,0:00:16.10,Default,,0,0,0,,Сиқырлы елдегі қыз
Dialogue: 0,0:00:17.13,0:00:21.43,Default,,0,0,0,,Өте кішкентай ертегі
Dialogue: 0,0:00:22.36,0:00:31.23,Default,,0,0,0,,Дүниеде не істегіңіз келеді?
Dialogue: 0,0:00:31.30,0:00:36.93,Default,,0,0,0,,Сұлу қыз Буки Буки Пайо
Dialogue: 0,0:00:37.03,0:00:41.56,Default,,0,0,0,,Аа, айтыңызшы, ұстаз.
Dialogue: 0,0:00:41.93,0:00:48.00,Default,,0,0,0,,Мен бұл туралы көбірек білгім келеді.
Dialogue: 0,0:00:48.23,0:00:52.96,Default,,0,0,0,,Ах Сенсей-сан
Dialogue: 0,0:00:53.06,0:01:02.20,Default,,0,0,0,,Ғажайып сырлар, айта алмайтын нәрселердің бәрі
Dialogue: 0,0:01:10.96,0:01:12.66,Default,,0,0,0,,«маусым»
Dialogue: 0,0:01:30.43,0:01:31.66,Default,,0,0,0,,Жаңбыр тоқтамайды...
Dialogue: 0,0:01:32.63,0:01:35.03,Default,,0,0,0,,Мүмкін мен ойланбай жүрген шығармын...
Dialogue: 0,0:01:35.96,0:01:38.30,Default,,0,0,0,,Ууууууууууууу...
Dialogue: 0,0:01:38.36,0:01:42.36,Default,,0,0,0,,Жаңбырлы күндер де~ Желді күндер де~
Dialogue: 0,0:01:43.06,0:01:43.70,Default,,0,0,0,,Бұл әйелдің Қанды Пері Шығармасы ма?
Dialogue: 0,0:01:45.30,0:01:45.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:47.40,0:01:47.90,Default,,0,0,0,,Хмм
Dialogue: 0,0:01:48.50,0:01:49.03,Default,,0,0,0,,Ei...
Dialogue: 0,0:01:49.10,0:01:50.16,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:01:50.70,0:01:52.76,Default,,0,0,0,,Бұл Сенсей мырзаға жазылған хат...
Dialogue: 0,0:01:53.50,0:01:54.33,Default,,0,0,0,,Орындау хаты ма?
Dialogue: 0,0:01:57.36,0:02:02.10,Default,,0,0,0,,Иә, иә! Шынымды айтсам, бұл ағама жазған махаббат хаты.
Dialogue: 0,0:02:02.83,0:02:05.83,Default,,0,0,0,,Қазіргі кезде Қойбуми көне қыз.
Dialogue: 0,0:02:06.36,0:02:07.33,Default,,0,0,0,,Мен мұны істеймін~
Dialogue: 0,0:02:08.03,0:02:08.96,Default,,0,0,0,,Махаббат хаты?
Dialogue: 0,0:02:09.63,0:02:13.80,Default,,0,0,0,,Иә! Бұл ең жақсы көретін адамға беретін ерекше хат.
Dialogue: 0,0:02:14.53,0:02:15.50,Default,,0,0,0,,О!
Dialogue: 0,0:02:15.60,0:02:17.03,Default,,0,0,0,,Онда мен де жазамын!
Dialogue: 0,0:02:17.46,0:02:18.93,Default,,0,0,0,,Жақсы жаз
Dialogue: 0,0:02:19.23,0:02:20.60,Default,,0,0,0,,Хмм, жаман емес.
Dialogue: 0,0:02:20.90,0:02:21.66,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:02:21.96,0:02:22.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:22.80,0:02:23.33,Default,,0,0,0,,Құрметті...
Dialogue: 0,0:02:24.56,0:02:28.33,Default,,0,0,0,,Маған ұнайды, бірақ бұл «лайктың» ерекше түрі.
Dialogue: 0,0:02:28.70,0:02:31.10,Default,,0,0,0,,Қызық, лайк пен махаббат басқа ма?
Dialogue: 0,0:02:31.56,0:02:32.63,Default,,0,0,0,,Уау~
Dialogue: 0,0:02:32.80,0:02:35.76,Default,,0,0,0,,Бұл махаббатты мойындау!
Dialogue: 0,0:02:36.36,0:02:39.96,Default,,0,0,0,,Мен өлуге дайынмын! Бұл Кя!
Dialogue: 0,0:02:40.36,0:02:41.10,Default,,0,0,0,,Иә!
Dialogue: 0,0:02:41.66,0:02:43.80,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:02:50.16,0:02:55.03,Default,,0,0,0,,Хахаха...сенпай!
Dialogue: 0,0:02:59.83,0:03:05.03,Default,,0,0,0,,Ха ха ха ха... Сіздің хатыңыз оқылды.
Dialogue: 0,0:03:08.73,0:03:10.46,Default,,0,0,0,,Сәттілік Куруру-чан!
Dialogue: 0,0:03:11.33,0:03:13.16,Default,,0,0,0,,Бар, бұл итермелеу.
Dialogue: 0,0:03:13.53,0:03:17.80,Default,,0,0,0,,Бұл жақсы, өйткені мен сен келмесең не істеймін деп ойладым.
Dialogue: 0,0:03:21.36,0:03:24.80,Default,,0,0,0,,Не болды? Аға, бірдеңе айтыңызшы
Dialogue: 0,0:03:27.23,0:03:28.96,Default,,0,0,0,,Көңілге тоймайтын адам...
Dialogue: 0,0:03:29.20,0:03:30.76,Default,,0,0,0,,Сіз ұятсыз...
Dialogue: 0,0:03:32.46,0:03:36.90,Default,,0,0,0,,Мм... мен ағам туралы ойладым... және...
Dialogue: 0,0:03:37.56,0:03:38.06,Default,,0,0,0,,Қорқынышты!
Dialogue: 0,0:03:38.53,0:03:39.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:39.50,0:03:40.23,Default,,0,0,0,,Хорорин!
Dialogue: 0,0:03:40.73,0:03:44.26,Default,,0,0,0,,Бұл қорқынышты~ Мен бар болсам да...
Dialogue: 0,0:03:45.00,0:03:47.46,Default,,0,0,0,,Мүмкін Хорорин де шығар? Сол сияқты...
Dialogue: 0,0:03:48.10,0:03:49.06,Default,,0,0,0,,Бұл батпақ!
Dialogue: 0,0:03:49.36,0:03:53.16,Default,,0,0,0,,Бұл өте тәтті!
Dialogue: 0,0:03:54.40,0:03:55.73,Default,,0,0,0,,Йосунда Хороро!
Dialogue: 0,0:03:56.03,0:03:57.63,Default,,0,0,0,,Бұл басқа әңгіме.
Dialogue: 0,0:03:57.90,0:03:59.50,Default,,0,0,0,,Жоқ, Хорори~н!
Dialogue: 0,0:04:01.76,0:04:02.30,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:06.26,0:04:06.76,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:07.03,0:04:07.53,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:11.33,0:04:11.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:12.83,0:04:13.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:14.90,0:04:19.56,Default,,0,0,0,,Жүрегімдегі бұл толқудан бас тартпаймын
Dialogue: 0,0:04:19.66,0:04:23.80,Default,,0,0,0,,Пуки~! Жоқ! Бұл біртүрлі~
Dialogue: 0,0:04:23.86,0:04:27.06,Default,,0,0,0,,А... Мен қателік жібердім бе? Эххе~
Dialogue: 0,0:04:27.30,0:04:28.53,Default,,0,0,0,,Хехе...
Dialogue: 0,0:04:29.90,0:04:30.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:30.83,0:04:35.63,Default,,0,0,0,,Кя, Сенпай! аға! аға! Ол қозғалмайды!
Dialogue: 0,0:04:36.16,0:04:36.66,Default,,0,0,0,,Фу…
Dialogue: 0,0:04:38.03,0:04:39.13,Default,,0,0,0,,Тыныс алмау!
Dialogue: 0,0:04:39.23,0:04:41.03,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:41.10,0:04:44.96,Default,,0,0,0,,Ах~ Бұл алманың кінәсі емес~ Аму~
Dialogue: 0,0:04:45.40,0:04:48.30,Default,,0,0,0,,Бұл... махаббат ауруы.
Dialogue: 0,0:04:49.16,0:04:51.96,Default,,0,0,0,,Мен бұл туралы махаббат ауруы деп естідім!
Dialogue: 0,0:04:57.40,0:05:00.26,Default,,0,0,0,,Махаббат ауруы – жазылмайтын дерттің бірі.
Dialogue: 0,0:05:00.63,0:05:05.33,Default,,0,0,0,,Мойныма көк пиязды орап, қазанға шеге салсам да, бақшаға жұмыртқаның қабығын ексем де...
Dialogue: 0,0:05:05.56,0:05:07.56,Default,,0,0,0,,Бұл сізді емдемейді.
Dialogue: 0,0:05:08.80,0:05:09.50,Default,,0,0,0,,Тек...
Dialogue: 0,0:05:11.30,0:05:11.96,Default,,0,0,0,,Мен, Ишикава және…
Dialogue: 0,0:05:13.26,0:05:15.46,Default,,0,0,0,,Махаббат кереметі орын алса...
Dialogue: 0,0:05:24.46,0:05:28.20,Default,,0,0,0,,Сенпай, түсіндім! Бұл махаббаттың кереметі!
Dialogue: 0,0:05:30.63,0:05:33.26,Default,,0,0,0,,Ғажайыптар - бұл өз қолыңызбен жасай алатын нәрсе...
Dialogue: 0,0:05:34.06,0:05:36.80,Default,,0,0,0,,Күтсең де ол басталмайды...
Dialogue: 0,0:05:37.30,0:05:40.26,Default,,0,0,0,,Сіз мені оята аласыз ба? Мені оята алмайсың ба?
Dialogue: 0,0:05:40.86,0:05:41.43,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:06:10.96,0:06:13.03,Default,,0,0,0,,Махаббат дертіңізді емдеңіз!
Dialogue: 0,0:06:18.70,0:06:23.43,Default,,0,0,0,,А... Мен өзімді дәл осы сәтте бақытты сезінемін.
Dialogue: 0,0:06:23.70,0:06:27.03,Default,,0,0,0,,Ха ха ха ха хмм хмм
Dialogue: 0,0:06:27.10,0:06:29.73,Default,,0,0,0,,Сарарин неліктен үйленді?
Dialogue: 0,0:06:30.10,0:06:33.60,Default,,0,0,0,,Мен жетекші рөлді монополиялау дұрыс емес деп ойладым.
Dialogue: 0,0:06:39.93,0:06:43.53,Default,,0,0,0,,Әке ана Хороро сізге үйленбекші.
Dialogue: 0,0:06:44.53,0:06:45.80,Default,,0,0,0,,Артында қалуым керек пе? Менің де, Жосукенің де?
Dialogue: 0,0:06:46.00,0:06:50.26,Default,,0,0,0,,Ал, бәріміз бақытты боламыз!
Dialogue: 0,0:06:51.20,0:06:53.43,Default,,0,0,0,,Мен сіздің ағаңыздың ауруынан айыққанына қуаныштымын.
Dialogue: 0,0:06:54.40,0:06:56.10,Default,,0,0,0,,Мм, бұл махаббаттың кереметі.
Dialogue: 0,0:06:56.73,0:07:00.40,Default,,0,0,0,,Ах~ Маусымдағы тойлар берекелі~
Dialogue: 0,0:07:00.66,0:07:01.40,Default,,0,0,0,,Маған келесі сұраққа жауап бер.
Dialogue: 0,0:07:02.30,0:07:04.40,Default,,0,0,0,,Құттықтаймыз Маусым қалыңдық!
Dialogue: 0,0:07:04.90,0:07:08.26,Default,,0,0,0,,Сонымен, біз Маусым қалыңдықтармыз ба?
Dialogue: 0,0:07:08.46,0:07:09.23,Default,,0,0,0,,Керемет!
Dialogue: 0,0:07:10.43,0:07:13.60,Default,,0,0,0,,Маусым қалыңдық - ең жақсы!
Dialogue: 0,0:07:15.03,0:07:17.10,Default,,0,0,0,,Иә? Ааа!
Dialogue: 0,0:07:17.56,0:07:22.66,Default,,0,0,0,,Сенпай! аға! Өтінемін, бізді жесір етпе!
Dialogue: 0,0:07:23.00,0:07:25.00,Default,,0,0,0,,Әлде... қос әйелдік деп айту керек пе?
Dialogue: 0,0:07:33.16,0:07:33.66,Default,,0,0,0,,Хмф!
Dialogue: 0,0:07:34.63,0:07:35.73,Default,,0,0,0,,Наританың ажырасуы…
Dialogue: 0,0:07:36.40,0:07:37.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:38.76,0:07:40.06,Default,,0,0,0,,Кансай халықаралық ажырасуы ма?
Dialogue: 0,0:07:45.93,0:07:48.10,Default,,0,0,0,,Сіз~ Қош келдіңіз~
Dialogue: 0,0:07:48.60,0:07:52.63,Default,,0,0,0,,Шаршадыңыз ба? Сіз тамақтанғыңыз келе ме? Әлде... офуро?
Dialogue: 0,0:07:53.80,0:07:55.80,Default,,0,0,0,,Уау! Мен сонша шаршадым!
Dialogue: 0,0:07:57.50,0:07:59.50,Default,,0,0,0,,Ммм, түсіндім, түсіндім!
Dialogue: 0,0:07:59.83,0:08:03.76,Default,,0,0,0,,Иә, мен түсінемін, жаңағы әйелдің күйзелісі жоғары, шаршатады.
Dialogue: 0,0:08:05.40,0:08:10.50,Default,,0,0,0,,Сіз де күйеуіңіздің рөліне құлшыныспен қарауыңыз керек!
Dialogue: 0,0:08:12.60,0:08:16.03,Default,,0,0,0,,Уау, ол өте тыныш адам.
Dialogue: 0,0:08:16.40,0:08:20.10,Default,,0,0,0,,Маған ұнайды! Ішейік! Бүгін мүмкіндігінше көп ішейік!
Dialogue: 0,0:08:24.06,0:08:28.43,Default,,0,0,0,,Сіз мұны істей алмайсыз. Сенің сүйкімді әйелің бар...
Dialogue: 0,0:08:30.36,0:08:30.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:33.43,0:08:34.60,Default,,0,0,0,,Сіз!
Dialogue: 0,0:08:35.16,0:08:36.00,Default,,0,0,0,,Куруру-чан!
Dialogue: 0,0:08:36.93,0:08:37.93,Default,,0,0,0,,Сіз!
Dialogue: 0,0:08:40.46,0:08:43.03,Default,,0,0,0,,Ал, бұдан кейін не істейміз?
Dialogue: 0,0:08:43.33,0:08:48.46,Default,,0,0,0,,Мм... Көрермендер шым-шытырық болып кетсе, үй шаруасындағы әйелдердің рейтингі көтеріледі деп естідім.
Dialogue: 0,0:08:49.03,0:08:50.63,Default,,0,0,0,,Аудитория рейтингі дегеніміз не?
Dialogue: 0,0:08:51.56,0:08:52.10,Default,,0,0,0,,Сол уақыттан бері жағдай өзгерді ғой, иә?
Dialogue: 0,0:08:52.70,0:08:53.53,Default,,0,0,0,,Бұл қиын!
Dialogue: 0,0:08:53.90,0:08:54.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:54.86,0:08:56.83,Default,,0,0,0,,Компания маған жұмыс ұсынысын берді!
Dialogue: 0,0:09:06.40,0:09:09.36,Default,,0,0,0,,Сенпай, міндетті түрде қайтып келші~
Dialogue: 0,0:09:09.80,0:09:11.86,Default,,0,0,0,,Мен...
Dialogue: 0,0:09:12.76,0:09:16.66,Default,,0,0,0,,Мен сені мәңгі күтемін~
Dialogue: 0,0:09:17.06,0:09:21.20,Default,,0,0,0,,А-а-а... Осыншама қиыншылықтан кейін бақытты болуым мүмкін еді!
Dialogue: 0,0:09:21.83,0:09:26.83,Default,,0,0,0,,Сол той маусымдық келін еді... тым қатыгез болды.
Dialogue: 0,0:09:27.23,0:09:32.36,Default,,0,0,0,,Жылама. Осындай сәттерде бір-бірімізді күліп шығарып салуымыз керек.
Dialogue: 0,0:09:33.06,0:09:34.73,Default,,0,0,0,,-Бірақ... бірақ... -Уау...
Dialogue: 0,0:09:36.03,0:09:41.46,Default,,0,0,0,,Сенпай~! Мен бұл баланың үлкен бала болатынына сенімдімін!
Dialogue: 0,0:09:42.03,0:09:44.20,Default,,0,0,0,,Иә! Ол қашан болып қалды?
Dialogue: 0,0:09:45.40,0:09:45.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:47.70,0:09:48.20,Default,,0,0,0,,Мияу
Dialogue: 0,0:09:48.50,0:09:49.03,Default,,0,0,0,,Уау...
Dialogue: 0,0:10:04.66,0:10:06.23,Default,,0,0,0,,Эй, мен үйдемін.
Dialogue: 0,0:10:09.60,0:10:10.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:13.70,0:10:18.03,Default,,0,0,0,,Сенсэй-сан Сенсэй-сан, сен білесің бе, маусым қалыңдық?
Dialogue: 0,0:10:18.30,0:10:20.33,Default,,0,0,0,,Куруру-чан, сабыр етіңіз.
Dialogue: 0,0:10:20.53,0:10:21.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:21.96,0:10:23.53,Default,,0,0,0,,Сіз не туралы айтып отырсыз...?
Dialogue: 0,0:10:24.40,0:10:26.03,Default,,0,0,0,,Басқаша айтқанда, Сенсей мырза...
Dialogue: 0,0:10:26.70,0:10:28.43,Default,,0,0,0,,Сіз үйленесіз бе?
Dialogue: 0,0:10:28.90,0:10:29.80,Default,,0,0,0,,Жоқ! Ә?
Dialogue: 0,0:10:30.43,0:10:31.80,Default,,0,0,0,,Маусым қалыңдық!
Dialogue: 0,0:10:36.53,0:10:37.20,Default,,0,0,0,,күрсіну
Dialogue: 0,0:10:38.03,0:10:38.70,Default,,0,0,0,,Фу~
Dialogue: 0,0:10:39.63,0:10:40.16,Default,,0,0,0,,Су~
Dialogue: 0,0:10:40.83,0:10:41.86,Default,,0,0,0,,〜
Dialogue: 0,0:10:46.46,0:10:51.76,Default,,0,0,0,,Ұстаз махаббат хатын жіберген қыздан сыпайы түрде бас тартқан сияқты.
Dialogue: 0,0:10:52.63,0:10:56.33,Default,,0,0,0,,Тама-чан сүйіспеншілік бақыт деп айтты, бірақ...
Dialogue: 0,0:10:57.00,0:10:59.26,Default,,0,0,0,,Адамдар қиын.
Dialogue: 0,0:11:00.16,0:11:03.20,Default,,0,0,0,,Уммм Куруру-чан...?
Dialogue: 0,0:11:04.16,0:11:08.26,Default,,0,0,0,,Махаббат хатындағы қыздың «лайк» белгісі қайда кетеді?
Dialogue: 0,0:11:08.43,0:11:08.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:12.66,0:11:13.93,Default,,0,0,0,,Бұл ай ма?
Dialogue: 0,0:11:28.23,0:11:40.20,Default,,0,0,0,,Көктемгі сезім – менің жүрегімде орнаған кездесу мен үміт.
Dialogue: 0,0:11:41.30,0:11:51.40,Default,,0,0,0,,Шатасып, маған жақындайсың.
Dialogue: 0,0:11:54.30,0:12:00.70,Default,,0,0,0,,Жүрегім лүпілдеп, Жүрегім дүрсілдеп
Dialogue: 0,0:12:00.80,0:12:01.70,Default,,0,0,0,,Бірақ
Dialogue: 0,0:12:04.03,0:12:10.90,Default,,0,0,0,,Ах, шие гүлдері, шие гүлдері, шие гүлі ағаштары
Dialogue: 0,0:12:11.63,0:12:17.33,Default,,0,0,0,,Ойлан, соған үміт ет
Dialogue: 0,0:12:18.06,0:12:20.90,Default,,0,0,0,,Сакура Сакура
Dialogue: 0,0:12:21.43,0:12:31.43,Default,,0,0,0,,Жаңа достар тап Қызғылт бол
Dialogue: 0,0:12:32.93,0:12:38.93,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
