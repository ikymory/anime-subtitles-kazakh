Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.40,0:00:16.10,Default,,0,0,0,,Сиқырлы елдегі қыз
Dialogue: 0,0:00:17.13,0:00:21.43,Default,,0,0,0,,Өте кішкентай ертегі
Dialogue: 0,0:00:22.36,0:00:31.23,Default,,0,0,0,,Дүниеде не істегіңіз келеді?
Dialogue: 0,0:00:31.30,0:00:36.93,Default,,0,0,0,,Керемет қыз Пукипукипайо
Dialogue: 0,0:00:37.03,0:00:41.56,Default,,0,0,0,,Аа, айтыңызшы, ұстаз.
Dialogue: 0,0:00:41.93,0:00:48.00,Default,,0,0,0,,Мен бұл туралы көбірек білгім келеді.
Dialogue: 0,0:00:48.23,0:00:52.96,Default,,0,0,0,,Ах Сенсей-сан
Dialogue: 0,0:00:53.06,0:01:02.20,Default,,0,0,0,,Ғажайып сырлар, айта алмайтын нәрселердің бәрі
Dialogue: 0,0:01:11.46,0:01:12.53,Default,,0,0,0,,«Сәуір»
Dialogue: 0,0:01:22.16,0:01:24.50,Default,,0,0,0,,Онда мен барамын.
Dialogue: 0,0:01:29.40,0:01:29.96,Default,,0,0,0,,Әй
Dialogue: 0,0:01:30.23,0:01:30.96,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:01:32.40,0:01:34.36,Default,,0,0,0,,Ммммммммммммммммммммммммммммммм...
Dialogue: 0,0:01:34.43,0:01:35.26,Default,,0,0,0,,Куруру
Dialogue: 0,0:01:35.63,0:01:36.96,Default,,0,0,0,,Иә!
Dialogue: 0,0:01:37.73,0:01:38.40,Default,,0,0,0,,Чирири
Dialogue: 0,0:01:38.70,0:01:39.30,Default,,0,0,0,,Иә!
Dialogue: 0,0:01:40.86,0:01:41.63,Default,,0,0,0,,Сара
Dialogue: 0,0:01:41.90,0:01:42.60,Default,,0,0,0,,Хмм
Dialogue: 0,0:01:45.43,0:01:46.03,Default,,0,0,0,,Хороро
Dialogue: 0,0:01:46.73,0:01:48.36,Default,,0,0,0,,Иә
Dialogue: 0,0:01:49.50,0:01:51.53,Default,,0,0,0,,Мен кешке қайтамын.
Dialogue: 0,0:01:51.70,0:01:54.23,Default,,0,0,0,,Мұғалім, сен бүгін қайда барасың?
Dialogue: 0,0:01:54.53,0:01:56.36,Default,,0,0,0,,Бұл мектепке кіру салтанаты.
Dialogue: 0,0:01:57.16,0:01:57.93,Default,,0,0,0,,Хмм?
Dialogue: 0,0:01:58.33,0:02:00.73,Default,,0,0,0,,Кіру рәсімі қандай?
Dialogue: 0,0:02:00.93,0:02:02.36,Default,,0,0,0,,Сол жігіт… Көзіне латкі таққан Какужа ма?
Dialogue: 0,0:02:03.13,0:02:05.30,Default,,0,0,0,,Мен не айтарымды білмеймін...
Dialogue: 0,0:02:05.53,0:02:08.56,Default,,0,0,0,,Бұл мектеп табалдырығын аттағалы тұрған ырым сияқты.
Dialogue: 0,0:02:09.13,0:02:09.90,Default,,0,0,0,,Әй
Dialogue: 0,0:02:11.23,0:02:12.10,Default,,0,0,0,,Рәсім...?
Dialogue: 0,0:02:15.53,0:02:17.26,Default,,0,0,0,,Хо Хокекё
Dialogue: 0,0:02:18.93,0:02:22.93,Default,,0,0,0,,Басқаша айтқанда, кіру рәсімін өткізсек,
Dialogue: 0,0:02:23.23,0:02:26.03,Default,,0,0,0,,Біз де мектепке баратын сияқтымыз.
Dialogue: 0,0:02:26.20,0:02:28.60,Default,,0,0,0,,Керемет! Гакко Гакко!
Dialogue: 0,0:02:28.66,0:02:30.83,Default,,0,0,0,,- Адам болғандай - Керемет! Гакко!
Dialogue: 0,0:02:30.90,0:02:31.40,Default,,0,0,0,,Гакко!
Dialogue: 0,0:02:31.46,0:02:34.40,Default,,0,0,0,,-Бірақ бұл қандай ырым? -Уау керемет! Уау керемет! Керемет
Dialogue: 0,0:02:34.80,0:02:36.03,Default,,0,0,0,,Әрине!
Dialogue: 0,0:02:36.43,0:02:37.10,Default,,0,0,0,,Жарылыс!
Dialogue: 0,0:02:37.30,0:02:37.93,Default,,0,0,0,,Бабан!
Dialogue: 0,0:02:38.30,0:02:39.33,Default,,0,0,0,,Баба!
Dialogue: 0,0:02:40.63,0:02:41.50,Default,,0,0,0,,О...
Dialogue: 0,0:02:42.23,0:02:44.43,Default,,0,0,0,,Рәсім қазір басталады.
Dialogue: 0,0:02:44.66,0:02:46.56,Default,,0,0,0,,Хорорин, дайынсың ба?
Dialogue: 0,0:02:46.63,0:02:47.63,Default,,0,0,0,,Иә
Dialogue: 0,0:02:49.66,0:02:50.46,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:52.00,0:02:54.30,Default,,0,0,0,,Ханняка Хонняка
Dialogue: 0,0:02:54.36,0:02:56.86,Default,,0,0,0,,Ханняка Хонняка
Dialogue: 0,0:02:57.23,0:03:00.03,Default,,0,0,0,,Ханняка, шынымен...!
Dialogue: 0,0:03:00.50,0:03:03.16,Default,,0,0,0,,Хонняка Хонняка
Dialogue: 0,0:03:03.30,0:03:03.90,Default,,0,0,0,,Ах
Dialogue: 0,0:03:04.03,0:03:07.46,Default,,0,0,0,,Хоннякат пен Конняку ұқсас...
Dialogue: 0,0:03:09.46,0:03:10.43,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:03:10.73,0:03:11.76,Default,,0,0,0,,-Ханнякаа -Эхехехе...
Dialogue: 0,0:03:11.83,0:03:13.13,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:03:13.30,0:03:15.16,Default,,0,0,0,,-Ханняка а? -Хехе
Dialogue: 0,0:03:15.26,0:03:15.93,Default,,0,0,0,,Хорорин?
Dialogue: 0,0:03:16.00,0:03:17.93,Default,,0,0,0,,Иә...
Dialogue: 0,0:03:18.96,0:03:20.60,Default,,0,0,0,,Уфуфуфуфу…
Dialogue: 0,0:03:22.66,0:03:24.43,Default,,0,0,0,,Эхе хи хи хи...
Dialogue: 0,0:03:24.63,0:03:27.36,Default,,0,0,0,,Ахахаха ахахха...
Dialogue: 0,0:03:27.43,0:03:30.13,Default,,0,0,0,,Мен бірдеңе дұрыс емес сияқты...
Dialogue: 0,0:03:30.73,0:03:32.93,Default,,0,0,0,,Өйткені бұл қабылдау рәсімі.
Dialogue: 0,0:03:33.10,0:03:35.10,Default,,0,0,0,,Бұл қатаңырақ емес пе?
Dialogue: 0,0:03:35.40,0:03:36.73,Default,,0,0,0,,Қатаң?
Dialogue: 0,0:03:38.56,0:03:39.26,Default,,0,0,0,,Хмм
Dialogue: 0,0:03:48.16,0:03:52.23,Default,,0,0,0,,Осыншама жетсең, мектепке түсе аласың!
Dialogue: 0,0:03:52.93,0:03:55.60,Default,,0,0,0,,Әй, бірақ жау көп.
Dialogue: 0,0:03:57.46,0:03:59.16,Default,,0,0,0,,Бұл рәсім...
Dialogue: 0,0:04:00.30,0:04:01.13,Default,,0,0,0,,Әлі де...
Dialogue: 0,0:04:02.13,0:04:04.06,Default,,0,0,0,,Тек амалсыз серпіліс бар!
Dialogue: 0,0:04:04.20,0:04:04.70,Default,,0,0,0,,Хмм
Dialogue: 0,0:04:05.03,0:04:07.06,Default,,0,0,0,,Да-да-да-да-да…
Dialogue: 0,0:04:07.13,0:04:09.00,Default,,0,0,0,,Да-да-да-да-да…
Dialogue: 0,0:04:09.06,0:04:10.23,Default,,0,0,0,,Қ-қарай берсең де, мен жылап тұрғаным жоқ
Dialogue: 0,0:04:10.56,0:04:11.16,Default,,0,0,0,,Жылы...
Dialogue: 0,0:04:11.53,0:04:12.86,Default,,0,0,0,,Ах! Чирири!
Dialogue: 0,0:04:13.86,0:04:15.83,Default,,0,0,0,,Чирири Мықты болыңыз!
Dialogue: 0,0:04:16.36,0:04:19.66,Default,,0,0,0,,Сара-чан, мен үшін уайымдама.
Dialogue: 0,0:04:20.06,0:04:23.26,Default,,0,0,0,,Мектепке барыңыз...
Dialogue: 0,0:04:25.63,0:04:28.73,Default,,0,0,0,,Чи... чирири!
Dialogue: 0,0:04:29.20,0:04:30.90,Default,,0,0,0,,Чирири! Чирири!
Dialogue: 0,0:04:31.03,0:04:33.33,Default,,0,0,0,,Сәлем Сарарин Чиририн
Dialogue: 0,0:04:34.26,0:04:34.76,Default,,0,0,0,,Әй?
Dialogue: 0,0:04:35.83,0:04:37.06,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:04:41.03,0:04:42.53,Default,,0,0,0,,Ми~у...
Dialogue: 0,0:04:46.46,0:04:47.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:48.63,0:04:49.26,Default,,0,0,0,,Ай...
Dialogue: 0,0:04:50.16,0:04:53.43,Default,,0,0,0,,Оборо-чан анасының жауын іздейді.
Dialogue: 0,0:04:53.80,0:04:57.23,Default,,0,0,0,,Шексіз сапарға шыққан қанатты мысық...
Dialogue: 0,0:04:57.30,0:04:57.70,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:04:58.36,0:04:59.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:59.60,0:05:03.80,Default,,0,0,0,,Оборо-чанға көмектесіңізші...
Dialogue: 0,0:05:04.53,0:05:05.33,Default,,0,0,0,,Өйткені...!
Dialogue: 0,0:05:05.73,0:05:07.83,Default,,0,0,0,,Бейшара Оборо-чан...
Dialogue: 0,0:05:08.53,0:05:10.70,Default,,0,0,0,,Қандай керемет самурай рухы!
Dialogue: 0,0:05:11.03,0:05:13.43,Default,,0,0,0,,Ах~ Ах...
Dialogue: 0,0:05:13.96,0:05:14.70,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:15.93,0:05:17.66,Default,,0,0,0,,Оборо-чанның күші...!
Dialogue: 0,0:05:18.20,0:05:19.03,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:19.50,0:05:20.60,Default,,0,0,0,,Иә, иә!
Dialogue: 0,0:05:51.33,0:05:53.33,Default,,0,0,0,,Оян! Оборо-чан!
Dialogue: 0,0:06:02.70,0:06:05.96,Default,,0,0,0,,Уау! Ах...
Dialogue: 0,0:06:06.80,0:06:08.66,Default,,0,0,0,,Сәттілік! Оборо-чан
Dialogue: 0,0:06:08.76,0:06:11.46,Default,,0,0,0,,Анаңның өшін алуың керек!
Dialogue: 0,0:06:11.56,0:06:13.60,Default,,0,0,0,,Маған анда-санда хат жазыңыз.
Dialogue: 0,0:06:13.76,0:06:15.60,Default,,0,0,0,,Шынайы сезімдеріңізді орындаңыз!
Dialogue: 0,0:06:15.83,0:06:17.63,Default,,0,0,0,,Мм... аа...
Dialogue: 0,0:06:18.20,0:06:20.10,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:06:21.33,0:06:22.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:22.66,0:06:24.46,Default,,0,0,0,,Барғың келмейтін сияқты.
Dialogue: 0,0:06:24.56,0:06:25.63,Default,,0,0,0,,Солай көрінеді.
Dialogue: 0,0:06:29.13,0:06:30.96,Default,,0,0,0,,Мен осындамын!
Dialogue: 0,0:06:33.80,0:06:35.43,Default,,0,0,0,,Хамуууууууууууууу...
Dialogue: 0,0:06:36.23,0:06:37.03,Default,,0,0,0,,Құлақ…
Dialogue: 0,0:06:40.30,0:06:41.20,Default,,0,0,0,,Құлақ…
Dialogue: 0,0:06:42.03,0:06:44.53,Default,,0,0,0,,Аммммммммммммм...
Dialogue: 0,0:06:44.66,0:06:45.56,Default,,0,0,0,,Хаму!
Dialogue: 0,0:06:45.70,0:06:46.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:46.93,0:06:49.56,Default,,0,0,0,,Ха! Ммммммммм...
Dialogue: 0,0:06:49.63,0:06:52.63,Default,,0,0,0,,Томат! Хехе салат~ хехе...
Dialogue: 0,0:06:52.73,0:06:54.13,Default,,0,0,0,,Мақсат!
Dialogue: 0,0:06:55.40,0:06:55.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:55.76,0:06:57.46,Default,,0,0,0,,Ахх!
Dialogue: 0,0:06:58.23,0:06:59.13,Default,,0,0,0,,А...?
Dialogue: 0,0:06:59.26,0:07:01.60,Default,,0,0,0,,Ах... пууууу...
Dialogue: 0,0:07:01.66,0:07:04.63,Default,,0,0,0,,Пуки~~!
Dialogue: 0,0:07:09.73,0:07:12.03,Default,,0,0,0,,Қош келдіңіз!
Dialogue: 0,0:07:12.63,0:07:16.96,Default,,0,0,0,,Білгіңіз келсе, бізге қалдырыңыз! Жапониядағы ең пайдалы бастауыш мектеп оқушысы!
Dialogue: 0,0:07:17.06,0:07:18.96,Default,,0,0,0,,Тама-чан осында!
Dialogue: 0,0:07:20.33,0:07:22.76,Default,,0,0,0,,туралы не білгіңіз келеді?
Dialogue: 0,0:07:22.86,0:07:25.96,Default,,0,0,0,,Иә, нақты ырым дегеніміз не?
Dialogue: 0,0:07:26.26,0:07:28.30,Default,,0,0,0,,Мен Тама-чаннан сұрағым келеді.
Dialogue: 0,0:07:29.33,0:07:30.03,Default,,0,0,0,,Gi…
Dialogue: 0,0:07:30.33,0:07:31.76,Default,,0,0,0,,Рәсім...?
Dialogue: 0,0:07:32.76,0:07:34.40,Default,,0,0,0,,Иә, дұрыс...
Dialogue: 0,0:07:34.66,0:07:37.33,Default,,0,0,0,,Бұл өте қиын сұрақ.
Dialogue: 0,0:07:37.73,0:07:42.86,Default,,0,0,0,,Бұл ұлы ғұламалар жылдар бойы зерттеп келе жатқан нәрсе...
Dialogue: 0,0:07:43.63,0:07:44.26,Default,,0,0,0,,Ха...
Dialogue: 0,0:07:45.70,0:07:47.16,Default,,0,0,0,,Елестер болады...
Dialogue: 0,0:07:47.70,0:07:48.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:49.03,0:07:53.93,Default,,0,0,0,,Рәсімді тергесең, аруақ шығады... деген аңыз бар.
Dialogue: 0,0:07:54.83,0:07:56.96,Default,,0,0,0,,Сіз әлі де... білгіңіз келе ме?
Dialogue: 0,0:07:57.40,0:08:00.50,Default,,0,0,0,,Уф... Ууууу... Ах...
Dialogue: 0,0:08:00.56,0:08:01.46,Default,,0,0,0,,Пён хехе
Dialogue: 0,0:08:01.53,0:08:03.96,Default,,0,0,0,,Міне, солай!
Dialogue: 0,0:08:04.50,0:08:07.53,Default,,0,0,0,,Енді шие гүлін тамашалаудың уақыты келді!
Dialogue: 0,0:08:07.63,0:08:08.46,Default,,0,0,0,,Хехе...
Dialogue: 0,0:08:08.53,0:08:08.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:08.96,0:08:09.90,Default,,0,0,0,,Хмм?
Dialogue: 0,0:08:10.96,0:08:12.03,Default,,0,0,0,,Қайырлы таң...?
Dialogue: 0,0:08:18.63,0:08:19.50,Default,,0,0,0,,Чиририн…
Dialogue: 0,0:08:20.93,0:08:22.03,Default,,0,0,0,,Куруру-чан...
Dialogue: 0,0:08:27.46,0:08:28.16,Default,,0,0,0,,Фумин!
Dialogue: 0,0:08:28.33,0:08:30.03,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:30.70,0:08:31.96,Default,,0,0,0,,Тама-чан!
Dialogue: 0,0:08:32.03,0:08:35.43,Default,,0,0,0,,Мұрынға қарау өте қызық емес, солай ма?
Dialogue: 0,0:08:35.83,0:08:38.76,Default,,0,0,0,,Балалар сендер тым ақымақсыңдар...
Dialogue: 0,0:08:43.46,0:08:44.30,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,0:08:44.36,0:08:47.40,Default,,0,0,0,,Түсіндім, бұл шие гүлін көру.
Dialogue: 0,0:08:47.60,0:08:48.20,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:48.56,0:08:52.40,Default,,0,0,0,,Мен Тама-чанмен теледидарда оқыдым, сондықтан өте жақсы болды!
Dialogue: 0,0:08:53.86,0:08:56.30,Default,,0,0,0,,Шие гүлін көру туралы айтатын болсақ... бәрі орынды қамтамасыз етуде!
Dialogue: 0,0:08:59.96,0:09:00.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:04.06,0:09:04.76,Default,,0,0,0,,(Ватару) Не болып жатыр? Бұл әңгіме… (Ер оқушы) Ол ұялы телефонымен дауласып жатыр.
Dialogue: 0,0:09:08.00,0:09:08.83,Default,,0,0,0,,Немесе...
Dialogue: 0,0:09:11.53,0:09:13.73,Default,,0,0,0,,Қызық емес...
Dialogue: 0,0:09:13.83,0:09:14.76,Default,,0,0,0,,Менің ойымша...
Dialogue: 0,0:09:15.70,0:09:18.03,Default,,0,0,0,,Шие гүлін көру туралы айтатын болсақ, бұл караоке.
Dialogue: 0,0:09:18.20,0:09:19.53,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:22.10,0:09:23.53,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:25.20,0:09:26.63,Default,,0,0,0,,Музыка жоқ па?
Dialogue: 0,0:09:26.70,0:09:27.66,Default,,0,0,0,,№.
Dialogue: 0,0:09:28.20,0:09:31.46,Default,,0,0,0,,Хм... Шие гүлін көру туралы айтсақ...
Dialogue: 0,0:09:31.60,0:09:32.20,Default,,0,0,0,,Hiii...
Dialogue: 0,0:09:32.43,0:09:33.73,Default,,0,0,0,,Ахх...
Dialogue: 0,0:09:33.80,0:09:36.90,Default,,0,0,0,,Шие гүлін көру туралы айтатын болсақ, мұның бәрі мас адамдар туралы!
Dialogue: 0,0:09:37.30,0:09:40.53,Default,,0,0,0,,Менеджер қандай? Менеджер қандай?
Dialogue: 0,0:09:40.60,0:09:43.03,Default,,0,0,0,,Монширочо дегеніміз не!?
Dialogue: 0,0:09:43.40,0:09:44.10,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:09:45.33,0:09:46.20,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:09:46.33,0:09:47.16,Default,,0,0,0,,Иә...
Dialogue: 0,0:09:47.63,0:09:49.76,Default,,0,0,0,,Сіздің мас болғаныңызда шындық жоқ.
Dialogue: 0,0:09:50.06,0:09:52.10,Default,,0,0,0,,Мен ішімдік іше алмаймын.
Dialogue: 0,0:09:53.10,0:09:54.20,Default,,0,0,0,,Сооо...
Dialogue: 0,0:09:56.06,0:09:57.06,Default,,0,0,0,,Иә...
Dialogue: 0,0:09:57.80,0:09:59.03,Default,,0,0,0,,Осы кітапқа сәйкес...
Dialogue: 0,0:09:59.33,0:10:03.96,Default,,0,0,0,,Ұлы маскүнемнің үйін иемденгісі келмейтін сияқты, өйткені үй айналып-толғанып тұрады.
Dialogue: 0,0:10:04.13,0:10:04.36,Default,,0,0,0,,Уау
Dialogue: 0,0:10:04.40,0:10:05.93,Default,,0,0,0,,Сарарин керемет!
Dialogue: 0,0:10:06.20,0:10:08.16,Default,,0,0,0,,Саған жақсы, Куруру-чан
Dialogue: 0,0:10:16.10,0:10:17.56,Default,,0,0,0,,Күтіңіз... күтіңіз!
Dialogue: 0,0:10:17.83,0:10:20.46,Default,,0,0,0,,Вахахахахахахахаха!
Dialogue: 0,0:10:20.60,0:10:25.26,Default,,0,0,0,,Әй... Қош келдіңіз, ұстаз! Ха...
Dialogue: 0,0:10:25.36,0:10:26.33,Default,,0,0,0,,Уау...
Dialogue: 0,0:10:26.36,0:10:30.26,Default,,0,0,0,,Құттықтаймыз! Шие гүлін көру өте жақсы!
Dialogue: 0,0:10:30.60,0:10:31.20,Default,,0,0,0,,Аха…
Dialogue: 0,0:10:32.96,0:10:34.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:34.63,0:10:35.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:35.96,0:10:36.73,Default,,0,0,0,,Ол оны қайта-қайта тыңдауды сұрай береді, сондықтан мен оны жаттап алдым.
Dialogue: 0,0:10:38.96,0:10:42.03,Default,,0,0,0,,Осыдан кейін Оборо-чан менің досым болды.
Dialogue: 0,0:10:42.13,0:10:44.06,Default,,0,0,0,,Мұғаліммен сөйлессеңіз
Dialogue: 0,0:10:44.33,0:10:46.46,Default,,0,0,0,,Мен біраз таң қалдым.
Dialogue: 0,0:10:52.63,0:10:53.76,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:53.86,0:10:56.00,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:10:56.70,0:10:57.86,Default,,0,0,0,,бұл... иә...
Dialogue: 0,0:10:57.96,0:10:59.10,Default,,0,0,0,,Немесе...
Dialogue: 0,0:10:59.53,0:11:02.03,Default,,0,0,0,,Фухи...ха...
Dialogue: 0,0:11:02.66,0:11:04.10,Default,,0,0,0,,Аа... иіі...
Dialogue: 0,0:11:06.56,0:11:07.23,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:28.23,0:11:40.16,Default,,0,0,0,,Көктемгі сезім – менің жүрегімде орнаған кездесу мен үміт.
Dialogue: 0,0:11:41.26,0:11:51.66,Default,,0,0,0,,Шатасып, маған жақындайсың.
Dialogue: 0,0:11:54.26,0:12:00.66,Default,,0,0,0,,Жүрегім дүрсілдеп, Жүрегім соғып тұр
Dialogue: 0,0:12:00.76,0:12:01.83,Default,,0,0,0,,Бірақ
Dialogue: 0,0:12:04.06,0:12:10.93,Default,,0,0,0,,Ах, шие гүлдері, шие гүлдері, шие гүлі ағаштары
Dialogue: 0,0:12:11.63,0:12:17.46,Default,,0,0,0,,Ойлан, соған үміт ет
Dialogue: 0,0:12:18.06,0:12:20.96,Default,,0,0,0,,Сакура Сакура
Dialogue: 0,0:12:21.43,0:12:31.73,Default,,0,0,0,,Жаңа достар тап Қызғылт бол
Dialogue: 0,0:12:33.23,0:12:39.23,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
