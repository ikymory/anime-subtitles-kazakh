Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.40,0:00:16.10,Default,,0,0,0,,Сиқырлы елдегі қыз
Dialogue: 0,0:00:17.13,0:00:21.43,Default,,0,0,0,,Өте кішкентай ертегі
Dialogue: 0,0:00:22.36,0:00:31.23,Default,,0,0,0,,Дүниеде не істегіңіз келеді?
Dialogue: 0,0:00:31.30,0:00:36.93,Default,,0,0,0,,Керемет қыз Пукипукипайо
Dialogue: 0,0:00:37.03,0:00:41.56,Default,,0,0,0,,Аа, айтыңызшы, ұстаз.
Dialogue: 0,0:00:41.93,0:00:48.00,Default,,0,0,0,,Мен бұл туралы көбірек білгім келеді.
Dialogue: 0,0:00:48.23,0:00:52.96,Default,,0,0,0,,Ах Сенсей-сан
Dialogue: 0,0:00:53.06,0:01:02.20,Default,,0,0,0,,Ғажайып сырлар, айта алмайтын нәрселердің бәрі
Dialogue: 0,0:01:10.60,0:01:14.33,Default,,0,0,0,,７！ ６！ ５！ ４！
Dialogue: 0,0:01:14.66,0:01:15.43,Default,,0,0,0,,３！
Dialogue: 0,0:01:15.83,0:01:16.46,Default,,0,0,0,,２！
Dialogue: 0,0:01:16.86,0:01:17.86,Default,,0,0,0,,１！
Dialogue: 0,0:01:18.10,0:01:19.13,Default,,0,0,0,,０！
Dialogue: 0,0:01:27.66,0:01:28.76,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:01:29.10,0:01:31.20,Default,,0,0,0,,Құттықтаймыз!
Dialogue: 0,0:01:31.80,0:01:34.43,Default,,0,0,0,,Шуш, шум, шум!
Dialogue: 0,0:01:34.53,0:01:36.16,Default,,0,0,0,,Ол өсті
Dialogue: 0,0:01:37.33,0:01:38.46,Default,,0,0,0,,«Қаңтар»
Dialogue: 0,0:01:45.43,0:01:46.90,Default,,0,0,0,,Жаңа жылдық карта?
Dialogue: 0,0:01:47.03,0:01:49.90,Default,,0,0,0,,Иә, қарапайым тілмен айтқанда.
Dialogue: 0,0:01:50.13,0:01:54.00,Default,,0,0,0,,Жақын адамдарға жаңа жылдық құттықтау хат па?
Dialogue: 0,0:01:54.70,0:01:55.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:55.56,0:01:58.53,Default,,0,0,0,,Қараңдар, барлығы Тама-чаннан келе жатыр.
Dialogue: 0,0:01:59.03,0:01:59.76,Default,,0,0,0,,Хмм?
Dialogue: 0,0:02:00.50,0:02:03.66,Default,,0,0,0,,Ичиненнің Гантанда екені рас па?
Dialogue: 0,0:02:03.96,0:02:06.33,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:02:06.40,0:02:09.76,Default,,0,0,0,,Білмеймін... мүмкін бұл код немесе бірдеңе...?
Dialogue: 0,0:02:09.93,0:02:13.83,Default,,0,0,0,,Сонымен, мұнда қандай да бір үлкен құпия бар ма?
Dialogue: 0,0:02:13.93,0:02:15.90,Default,,0,0,0,,Күндік хабарлама...
Dialogue: 0,0:02:16.23,0:02:18.96,Default,,0,0,0,,Жоқ, бәрі, бұл...
Dialogue: 0,0:02:19.10,0:02:21.16,Default,,0,0,0,,«Жылдың жалпы саны Жаңа жыл күні».
Dialogue: 0,0:02:21.53,0:02:25.00,Default,,0,0,0,,Тағы бір аты – «Жылдың жоспары Жаңа жыл күні»!
Dialogue: 0,0:02:25.63,0:02:26.73,Default,,0,0,0,,Джан!
Dialogue: 0,0:02:26.90,0:02:28.03,Default,,0,0,0,,Тама-чан!
Dialogue: 0,0:02:28.36,0:02:32.03,Default,,0,0,0,,Баршаңызға Жаңа жыл құтты болсын!
Dialogue: 0,0:02:32.66,0:02:34.86,Default,,0,0,0,,Құттықтаймыз!
Dialogue: 0,0:02:35.20,0:02:37.83,Default,,0,0,0,,Біз сізді осы жылы тағы көреміз деп үміттенеміз!
Dialogue: 0,0:02:38.06,0:02:40.20,Default,,0,0,0,,Мен Изуку Мидориямын!
Dialogue: 0,0:02:40.50,0:02:42.46,Default,,0,0,0,,Сонымен Тама-чан
Dialogue: 0,0:02:42.60,0:02:45.30,Default,,0,0,0,,Бір жыл… Бір жыл…
Dialogue: 0,0:02:45.46,0:02:47.63,Default,,0,0,0,,Жылдық жоспар Жаңа жыл күні.
Dialogue: 0,0:02:48.43,0:02:49.53,Default,,0,0,0,,нені білдіреді?
Dialogue: 0,0:02:49.63,0:02:51.03,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:02:51.23,0:02:54.23,Default,,0,0,0,,Осы жылды жақсы өткізу үшін...!
Dialogue: 0,0:02:54.46,0:02:58.53,Default,,0,0,0,,үшін осы Жаңа жыл күніне байланысты!
Dialogue: 0,0:02:59.20,0:03:00.53,Default,,0,0,0,,Гах!
Dialogue: 0,0:03:01.03,0:03:03.96,Default,,0,0,0,,Олай болса, адам болу үшін...
Dialogue: 0,0:03:04.13,0:03:08.30,Default,,0,0,0,,Мен бүгінгі күнді тиімді пайдалануым керек деп ойлаймын...
Dialogue: 0,0:03:08.90,0:03:10.60,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:03:10.76,0:03:14.86,Default,,0,0,0,,Бірақ уақытты дұрыс өткізудің жолы қандай?
Dialogue: 0,0:03:14.93,0:03:16.26,Default,,0,0,0,,Бізде...
Dialogue: 0,0:03:16.36,0:03:18.20,Default,,0,0,0,,Уайымдамаңыз!
Dialogue: 0,0:03:18.30,0:03:18.80,Default,,0,0,0,,Әй?
Dialogue: 0,0:03:19.20,0:03:22.13,Default,,0,0,0,,Сіз үшін бұл Тама-чан
Dialogue: 0,0:03:22.50,0:03:25.96,Default,,0,0,0,,Жаңа жылды аман-есен өткізу үшін Сугорокуды алып келдім!
Dialogue: 0,0:03:27.00,0:03:28.13,Default,,0,0,0,,Уау~
Dialogue: 0,0:03:28.20,0:03:29.70,Default,,0,0,0,,Керемет Тама-чан!
Dialogue: 0,0:03:29.90,0:03:31.66,Default,,0,0,0,,Жақсы естіледі ме? үшін
Dialogue: 0,0:03:31.76,0:03:35.20,Default,,0,0,0,,Егер сіз тоқтаған алаңда жазылғанды орындасаңыз,
Dialogue: 0,0:03:35.36,0:03:38.40,Default,,0,0,0,,Жаңа жылды жақсы қарсы алуға болады
Dialogue: 0,0:03:38.53,0:03:39.73,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:03:40.00,0:03:41.13,Default,,0,0,0,,Иә!
Dialogue: 0,0:03:42.93,0:03:45.30,Default,,0,0,0,,Енді Сугорокудан бастайық!
Dialogue: 0,0:03:45.36,0:03:46.36,Default,,0,0,0,,Дыбыстық сигнал!
Dialogue: 0,0:03:46.60,0:03:47.73,Default,,0,0,0,,О!
Dialogue: 0,0:03:47.83,0:03:49.70,Default,,0,0,0,,...
Dialogue: 0,0:03:50.13,0:03:52.06,Default,,0,0,0,,Е... мінекей!
Dialogue: 0,0:03:54.43,0:03:57.06,Default,,0,0,0,,Эй, міне, солай!
Dialogue: 0,0:03:57.60,0:03:58.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:58.66,0:04:00.30,Default,,0,0,0,,Басына оралу?
Dialogue: 0,0:04:02.43,0:04:04.10,Default,,0,0,0,,Сол Куруру-чан?
Dialogue: 0,0:04:04.23,0:04:06.66,Default,,0,0,0,,Бұл тек бастамасы...
Dialogue: 0,0:04:07.73,0:04:09.10,Default,,0,0,0,,Менің кезегім, солай ма?
Dialogue: 0,0:04:09.50,0:04:10.26,Default,,0,0,0,,Міне.
Dialogue: 0,0:04:12.33,0:04:14.10,Default,,0,0,0,,Аяқ киім
Dialogue: 0,0:04:14.93,0:04:15.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:16.26,0:04:17.93,Default,,0,0,0,,Төбені айналдыру...
Dialogue: 0,0:04:18.80,0:04:20.06,Default,,0,0,0,,-дағы шыңдар туралы не деуге болады?
Dialogue: 0,0:04:20.23,0:04:21.83,Default,,0,0,0,,Жақында шешіледі.
Dialogue: 0,0:04:22.20,0:04:24.03,Default,,0,0,0,,Бұл жолы мен бе?
Dialogue: 0,0:04:24.53,0:04:25.20,Default,,0,0,0,,Ei
Dialogue: 0,0:04:27.36,0:04:28.76,Default,,0,0,0,,Пурин
Dialogue: 0,0:04:29.50,0:04:30.06,Default,,0,0,0,,А...?
Dialogue: 0,0:04:30.80,0:04:31.96,Default,,0,0,0,,Айналмалы топ боласыз ба?
Dialogue: 0,0:04:32.50,0:04:33.10,Default,,0,0,0,,...?
Dialogue: 0,0:04:33.63,0:04:35.40,Default,,0,0,0,,Иә? иә? иә?
Dialogue: 0,0:04:35.96,0:04:36.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:38.16,0:04:38.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:38.76,0:04:39.70,Default,,0,0,0,,Кеттік! Хмф
Dialogue: 0,0:04:39.76,0:04:43.10,Default,,0,0,0,,Ааа... ааа...
Dialogue: 0,0:04:43.86,0:04:45.70,Default,,0,0,0,,Менің көзім айналып кетті...
Dialogue: 0,0:04:45.80,0:04:47.83,Default,,0,0,0,,Неге екені белгісіз, қаным қайнайды.
Dialogue: 0,0:04:47.93,0:04:50.50,Default,,0,0,0,,Жақсы жұмыс! Сара-чан!
Dialogue: 0,0:04:50.76,0:04:52.90,Default,,0,0,0,,Хороро лақтыру
Dialogue: 0,0:04:53.33,0:04:53.83,Default,,0,0,0,,Хорья
Dialogue: 0,0:04:55.90,0:04:58.13,Default,,0,0,0,,Машию Маро!
Dialogue: 0,0:04:59.03,0:04:59.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:59.96,0:05:01.46,Default,,0,0,0,,Ұйқыдағы Жаңа жыл…
Dialogue: 0,0:05:01.96,0:05:03.96,Default,,0,0,0,,Дүрбелеңге салынба
Dialogue: 0,0:05:04.10,0:05:05.96,Default,,0,0,0,,Үзіліс алыңыз Үзіліс жасаңыз
Dialogue: 0,0:05:06.53,0:05:08.60,Default,,0,0,0,,Күрсін... Күрсін...
Dialogue: 0,0:05:08.70,0:05:10.00,Default,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:05:10.16,0:05:14.90,Default,,0,0,0,,Иә! Бұл ересектердің Жаңа жыл мерекесін дұрыс өткізу тәсілі.
Dialogue: 0,0:05:15.16,0:05:16.86,Default,,0,0,0,,Керемет, Хорорин
Dialogue: 0,0:05:16.93,0:05:17.70,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:05:17.83,0:05:20.33,Default,,0,0,0,,Бұл жолы! Пуки!
Dialogue: 0,0:05:21.33,0:05:22.56,Default,,0,0,0,,Карута ойыншысы?
Dialogue: 0,0:05:23.46,0:05:24.66,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:05:24.96,0:05:26.30,Default,,0,0,0,,Қолдарыңызбен жұмсақ болыңыз
Dialogue: 0,0:05:26.96,0:05:28.86,Default,,0,0,0,,Иттер де ~ жүрсең ~
Dialogue: 0,0:05:28.96,0:05:30.60,Default,,0,0,0,,- Таяқшаны соғыңыз ~ - Мм...
Dialogue: 0,0:05:30.63,0:05:32.20,Default,,0,0,0,,Жақсы...
Dialogue: 0,0:05:32.26,0:05:33.20,Default,,0,0,0,,Ах! Иә!
Dialogue: 0,0:05:33.26,0:05:33.76,Default,,0,0,0,,Пу!
Dialogue: 0,0:05:35.16,0:05:36.23,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:36.66,0:05:38.56,Default,,0,0,0,,Күлкі ~ қақпада ~
Dialogue: 0,0:05:38.66,0:05:39.20,Default,,0,0,0,,Ол ісініп, қан ағып тұр
Dialogue: 0,0:05:39.63,0:05:40.63,Default,,0,0,0,,Маймыл да~
Dialogue: 0,0:05:40.70,0:05:41.33,Default,,0,0,0,,Ол ісініп, қан ағып тұр
Dialogue: 0,0:05:42.36,0:05:45.26,Default,,0,0,0,,Карута патшайымы дүниеге келді!
Dialogue: 0,0:05:45.46,0:05:45.80,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:45.83,0:05:47.10,Default,,0,0,0,,Жылдамдық көрсетілсе, тере аласың ба?
Dialogue: 0,0:05:47.16,0:05:48.93,Default,,0,0,0,,Ууу...
Dialogue: 0,0:05:49.03,0:05:51.93,Default,,0,0,0,,Бұл айналдыру тоқтаған шаршы.
Dialogue: 0,0:05:52.03,0:05:53.73,Default,,0,0,0,,Ну~таа!
Dialogue: 0,0:05:54.66,0:05:57.36,Default,,0,0,0,,Хмм? Маған тако беріңіз!
Dialogue: 0,0:05:58.13,0:05:59.90,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:05:59.96,0:06:04.13,Default,,0,0,0,,Ұлы ұры Сарара Исикава Гоемон келді!
Dialogue: 0,0:06:04.90,0:06:05.50,Default,,0,0,0,,Ха...
Dialogue: 0,0:06:05.73,0:06:06.60,Default,,0,0,0,,Ол кім?
Dialogue: 0,0:06:07.20,0:06:08.73,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:06:09.16,0:06:13.20,Default,,0,0,0,,Сен бұзықсың! Қолдарыңызды алыңыз, жоқ, аяғыңызды алыңыз!
Dialogue: 0,0:06:13.66,0:06:14.26,Default,,0,0,0,,Ха...
Dialogue: 0,0:06:15.16,0:06:17.00,Default,,0,0,0,,Фуню~!
Dialogue: 0,0:06:17.60,0:06:19.03,Default,,0,0,0,,Қайнатайық!
Dialogue: 0,0:06:21.50,0:06:25.36,Default,,0,0,0,,О! Бұл шынымен Гоемон Ишикаваның соңғы сәті!
Dialogue: 0,0:06:26.33,0:06:27.00,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:06:27.83,0:06:29.16,Default,,0,0,0,,Жаңа жылдық сапар?
Dialogue: 0,0:06:33.60,0:06:36.46,Default,,0,0,0,,Сенің адам бола алатыныңа сенемін!
Dialogue: 0,0:06:36.83,0:06:40.63,Default,,0,0,0,,Тамаго Дофудан тойып жей аласыз деп үміттенемін!
Dialogue: 0,0:06:40.93,0:06:42.13,Default,,0,0,0,,Хороро-чан!
Dialogue: 0,0:06:42.30,0:06:44.10,Default,,0,0,0,,Әй, Кастелла да!
Dialogue: 0,0:06:46.80,0:06:47.93,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:06:48.86,0:06:51.20,Default,,0,0,0,,Ия, бұл Дайкичи!
Dialogue: 0,0:06:51.40,0:06:53.00,Default,,0,0,0,,Менің де жолым бар
Dialogue: 0,0:06:53.26,0:06:54.53,Default,,0,0,0,,Мен де~
Dialogue: 0,0:06:54.70,0:06:57.30,Default,,0,0,0,,Бұл көктемнен сәттілік әкеледі.
Dialogue: 0,0:06:57.36,0:07:00.56,Default,,0,0,0,,Тілек міндетті түрде орындалады
Dialogue: 0,0:07:00.76,0:07:01.83,Default,,0,0,0,,Ааааа...
Dialogue: 0,0:07:01.93,0:07:03.83,Default,,0,0,0,,Ааа... Ууууу...
Dialogue: 0,0:07:04.06,0:07:04.96,Default,,0,0,0,,Хмм?
Dialogue: 0,0:07:05.33,0:07:05.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:05.96,0:07:06.80,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:07:07.40,0:07:08.93,Default,,0,0,0,,(Изуку) Қарсыластың өз күшін пайдаланып, дәл қорғанына сондай етіп сүңгу...
Dialogue: 0,0:07:09.66,0:07:11.46,Default,,0,0,0,,Уау...
Dialogue: 0,0:07:12.66,0:07:13.23,Default,,0,0,0,,Хмм…
Dialogue: 0,0:07:13.43,0:07:15.83,Default,,0,0,0,,Кеттік! Фанья!
Dialogue: 0,0:07:16.76,0:07:18.10,Default,,0,0,0,,Ыстық көктемге саяхат?
Dialogue: 0,0:07:19.50,0:07:20.63,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:20.70,0:07:22.10,Default,,0,0,0,,Жақсы ыстық су
Dialogue: 0,0:07:22.20,0:07:25.03,Default,,0,0,0,,Бұл сізді өзегіне дейін жылытады ...
Dialogue: 0,0:07:25.30,0:07:27.56,Default,,0,0,0,,Бірақ неге ыстық бұлақ саяхаты?
Dialogue: 0,0:07:27.66,0:07:29.73,Default,,0,0,0,,Жаңа жыл күнінен ыстық суға шомылу
Dialogue: 0,0:07:29.83,0:07:32.80,Default,,0,0,0,,Бұл ваби мен хордың жапондық стилі.
Dialogue: 0,0:07:32.90,0:07:34.40,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:07:35.16,0:07:35.93,Default,,0,0,0,,<Қабылдау хатын алғаннан кейінгі кеш>
Dialogue: 0,0:07:36.76,0:07:38.63,Default,,0,0,0,,Суық жүзу...
Dialogue: 0,0:07:39.73,0:07:40.76,Default,,0,0,0,,Пхуха~!
Dialogue: 0,0:07:41.40,0:07:43.60,Default,,0,0,0,,Мм! Бұл мені шиеленісті сезінеді
Dialogue: 0,0:07:44.20,0:07:46.40,Default,,0,0,0,,Уау... суық...
Dialogue: 0,0:07:46.46,0:07:47.53,Default,,0,0,0,,-Уау... -Суық...
Dialogue: 0,0:07:47.76,0:07:50.26,Default,,0,0,0,,Ах! Хорорин Зуруи~!
Dialogue: 0,0:07:50.60,0:07:51.83,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе~
Dialogue: 0,0:07:51.93,0:07:52.93,Default,,0,0,0,,Хекш!
Dialogue: 0,0:07:53.66,0:07:54.36,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,0:07:55.36,0:07:56.56,Default,,0,0,0,,Оборо-чан?
Dialogue: 0,0:07:57.20,0:08:00.63,Default,,0,0,0,,Уау! Саған жарасады Чирин
Dialogue: 0,0:08:00.76,0:08:03.33,Default,,0,0,0,,Хмм, сен тамаша Оборо-чансың.
Dialogue: 0,0:08:03.53,0:08:04.83,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:08:04.96,0:08:05.63,Default,,0,0,0,,Хмм
Dialogue: 0,0:08:06.10,0:08:07.16,Default,,0,0,0,,Сіз ұша аласыз ба?
Dialogue: 0,0:08:07.43,0:08:08.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:08.73,0:08:09.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:10.73,0:08:11.33,Default,,0,0,0,,Хмм.
Dialogue: 0,0:08:11.53,0:08:14.26,Default,,0,0,0,,хм/сағ хм/сағ...
Dialogue: 0,0:08:14.33,0:08:15.90,Default,,0,0,0,,Сәттілік Чирин!
Dialogue: 0,0:08:16.13,0:08:17.26,Default,,0,0,0,,Бар!
Dialogue: 0,0:08:17.33,0:08:18.56,Default,,0,0,0,,Фу хо хо хо...
Dialogue: 0,0:08:18.63,0:08:19.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:19.26,0:08:23.23,Default,,0,0,0,,Фу Фу Хо Хо Хо Хо Хо Хо…
Dialogue: 0,0:08:23.30,0:08:23.90,Default,,0,0,0,,Ура!
Dialogue: 0,0:08:24.63,0:08:26.33,Default,,0,0,0,,Аэробика
Dialogue: 0,0:08:28.06,0:08:32.93,Default,,0,0,0,,Бір екі бір екі бір екі...
Dialogue: 0,0:08:33.03,0:08:35.80,Default,,0,0,0,,Фу~хо фу~хо
Dialogue: 0,0:08:35.86,0:08:38.30,Default,,0,0,0,,Хаа...
Dialogue: 0,0:08:38.70,0:08:40.30,Default,,0,0,0,,Пуа~
Dialogue: 0,0:08:40.60,0:08:44.03,Default,,0,0,0,,Жаңа жылдан бастап мен өзімді жақсартқандай сезінемін!
Dialogue: 0,0:08:44.63,0:08:45.16,Default,,0,0,0,,Хоро?
Dialogue: 0,0:08:45.83,0:08:48.96,Default,,0,0,0,,Аэробика... Оқиға...?
Dialogue: 0,0:08:51.20,0:08:52.96,Default,,0,0,0,,Жәбірленуші – Оборо-чан
Dialogue: 0,0:08:53.10,0:08:56.36,Default,,0,0,0,,Алғашқы ашушы Куруру болды.
Dialogue: 0,0:08:56.73,0:08:59.83,Default,,0,0,0,,Түсіндім... кінәлі...
Dialogue: 0,0:09:00.50,0:09:01.36,Default,,0,0,0,,Солай дегің келе ме? Кешір мені.
Dialogue: 0,0:09:01.43,0:09:02.96,Default,,0,0,0,,Ээээх!
Dialogue: 0,0:09:03.80,0:09:07.30,Default,,0,0,0,,Тамақ ал, өйткені бүгін жаңа жыл...
Dialogue: 0,0:09:07.73,0:09:09.60,Default,,0,0,0,,Ах, рахмет...
Dialogue: 0,0:09:09.73,0:09:13.83,Default,,0,0,0,,...
Dialogue: 0,0:09:15.13,0:09:18.10,Default,,0,0,0,,Іс қазір шешілді...
Dialogue: 0,0:09:18.43,0:09:21.53,Default,,0,0,0,,Өзіңізді күтіңіз! О иә!
Dialogue: 0,0:09:22.50,0:09:23.50,Default,,0,0,0,,Қамау?
Dialogue: 0,0:09:24.53,0:09:26.16,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:09:26.36,0:09:28.26,Default,,0,0,0,,Неліктен бұлай болды...
Dialogue: 0,0:09:28.33,0:09:30.53,Default,,0,0,0,,Куу...
Dialogue: 0,0:09:36.56,0:09:37.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:37.66,0:09:39.56,Default,,0,0,0,,Баршаңызға еңбектеріңіз үшін рахмет!
Dialogue: 0,0:09:39.66,0:09:40.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:40.66,0:09:42.13,Default,,0,0,0,,Аяғыңызға қараңыз
Dialogue: 0,0:09:42.23,0:09:43.20,Default,,0,0,0,,А...?
Dialogue: 0,0:09:43.96,0:09:45.93,Default,,0,0,0,,Уау! Болды!
Dialogue: 0,0:09:46.30,0:09:49.00,Default,,0,0,0,,Уау! Алақай! Алақай!
Dialogue: 0,0:09:49.06,0:09:51.83,Default,,0,0,0,,-Еңбектің бәрі өз жемісін берді -Яй!
Dialogue: 0,0:09:52.06,0:09:54.96,Default,,0,0,0,,Бұл биылғы жыл үшін өте қолайлы.
Dialogue: 0,0:09:57.53,0:09:58.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:59.50,0:10:01.06,Default,,0,0,0,,Неге… неге мен
Dialogue: 0,0:10:01.56,0:10:06.13,Default,,0,0,0,,Сыйлық ретінде барлығыңыз адам мырзаға айналасыз.
Dialogue: 0,0:10:06.43,0:10:08.23,Default,,0,0,0,,Иә, шынымен бе?
Dialogue: 0,0:10:13.23,0:10:13.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:14.03,0:10:14.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:14.73,0:10:15.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:15.43,0:10:16.00,Default,,0,0,0,,Хонё?
Dialogue: 0,0:10:19.70,0:10:20.33,Default,,0,0,0,,Әй?
Dialogue: 0,0:10:21.06,0:10:21.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:22.56,0:10:23.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:24.50,0:10:27.63,Default,,0,0,0,,Иә! Мен адам болдым!
Dialogue: 0,0:10:28.00,0:10:30.36,Default,,0,0,0,,Мен жасадым мен жасадым!
Dialogue: 0,0:10:30.53,0:10:33.26,Default,,0,0,0,,Уау... Мен қатты әсер алдым! Өте әсерлі!
Dialogue: 0,0:10:33.33,0:10:36.16,Default,,0,0,0,,Қандай керемет махаббат пен тыныштық...
Dialogue: 0,0:10:37.36,0:10:38.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:40.30,0:10:42.60,Default,,0,0,0,,Баршаңызды құттықтаймын
Dialogue: 0,0:10:43.13,0:10:44.33,Default,,0,0,0,,Тама-чан!
Dialogue: 0,0:10:44.63,0:10:45.43,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:10:45.53,0:10:46.60,Default,,0,0,0,,Ахаха!
Dialogue: 0,0:10:46.86,0:10:48.10,Default,,0,0,0,,Мен жасадым!
Dialogue: 0,0:10:48.20,0:10:50.66,Default,,0,0,0,,Мен адам болдым!
Dialogue: 0,0:10:50.73,0:10:52.56,Default,,0,0,0,,Ах, рахмет!
Dialogue: 0,0:10:52.70,0:10:54.06,Default,,0,0,0,,Тамачан...
Dialogue: 0,0:10:58.80,0:11:00.46,Default,,0,0,0,,Мен жасадым...
Dialogue: 0,0:11:00.73,0:11:04.50,Default,,0,0,0,,Ху~ Хяхьяхья... Ха~ Фуу...
Dialogue: 0,0:11:04.80,0:11:07.23,Default,,0,0,0,,Ойыннан шаршағандықтан ұйықтап қалдыңыз ба?
Dialogue: 0,0:11:11.93,0:11:14.60,Default,,0,0,0,,Бірінші арманыңыз қандай?
Dialogue: 0,0:11:15.23,0:11:16.60,Default,,0,0,0,,Пуки...
Dialogue: 0,0:11:16.93,0:11:19.10,Default,,0,0,0,,А... иә...
Dialogue: 0,0:11:19.60,0:11:20.66,Default,,0,0,0,,Иә...
Dialogue: 0,0:11:20.76,0:11:21.90,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:28.26,0:11:40.50,Default,,0,0,0,,Менің барлық қысқы сезімдерім ақ боялған
Dialogue: 0,0:11:41.23,0:11:51.96,Default,,0,0,0,,Тіпті сол адамның көлеңкесін де көруді қиындату
Dialogue: 0,0:11:54.26,0:12:00.73,Default,,0,0,0,,Із, із, артта қалды
Dialogue: 0,0:12:00.80,0:12:02.36,Default,,0,0,0,,Бірақ
Dialogue: 0,0:12:04.00,0:12:11.06,Default,,0,0,0,,Ах, қар, қар, бәрін өшіреді
Dialogue: 0,0:12:11.56,0:12:17.70,Default,,0,0,0,,Жолда жазылған «ұнайды» сөзі
Dialogue: 0,0:12:18.16,0:12:20.93,Default,,0,0,0,,Бірақ, бірақ.
Dialogue: 0,0:12:21.43,0:12:32.63,Default,,0,0,0,,Өшіре алмаған – жүрегің, Жүрегіңде жасырылған сезім
Dialogue: 0,0:12:34.13,0:12:40.13,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
