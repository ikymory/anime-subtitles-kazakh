Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.40,0:00:16.10,Default,,0,0,0,,Сиқырлы елдегі қыз
Dialogue: 0,0:00:17.13,0:00:21.43,Default,,0,0,0,,Өте кішкентай ертегі
Dialogue: 0,0:00:22.36,0:00:31.23,Default,,0,0,0,,Дүниеде не істегіңіз келеді?
Dialogue: 0,0:00:31.40,0:00:36.93,Default,,0,0,0,,Сүйкімді ханым, Пукипукипайо
Dialogue: 0,0:00:37.03,0:00:41.56,Default,,0,0,0,,Аа, айтыңызшы, ұстаз.
Dialogue: 0,0:00:41.93,0:00:48.03,Default,,0,0,0,,Мен бұл туралы көбірек білгім келеді.
Dialogue: 0,0:00:48.23,0:00:52.96,Default,,0,0,0,,Ах Сенсей-сан
Dialogue: 0,0:00:53.10,0:01:02.20,Default,,0,0,0,,Ғажайып сырлар, айта алмайтын нәрселердің бәрі
Dialogue: 0,0:01:11.53,0:01:12.80,Default,,0,0,0,,«Қараша»
Dialogue: 0,0:01:22.93,0:01:24.30,Default,,0,0,0,,Бұл әдемі...
Dialogue: 0,0:01:24.66,0:01:25.66,Default,,0,0,0,,Уау~
Dialogue: 0,0:01:25.73,0:01:26.60,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:26.66,0:01:27.86,Default,,0,0,0,,Ах~
Dialogue: 0,0:01:27.93,0:01:28.43,Default,,0,0,0,,А?
Dialogue: 0,0:01:29.00,0:01:31.56,Default,,0,0,0,,Неліктен бұл гүл гүлдемейді?
Dialogue: 0,0:01:32.03,0:01:33.36,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:01:33.83,0:01:36.30,Default,,0,0,0,,Бұл менің гүлденгім келмейтінім емес.
Dialogue: 0,0:01:36.43,0:01:38.20,Default,,0,0,0,,Қызық, неге?
Dialogue: 0,0:01:38.50,0:01:40.73,Default,,0,0,0,,Орындалмайтын нәрсе бар ма...
Dialogue: 0,0:01:41.80,0:01:42.30,Default,,0,0,0,,Ha
Dialogue: 0,0:01:42.60,0:01:43.86,Default,,0,0,0,,Чирин! Міне бітті!
Dialogue: 0,0:01:44.03,0:01:46.26,Default,,0,0,0,,Құрурумен және басқалармен бірге гүлдей берейік!
Dialogue: 0,0:01:46.66,0:01:48.26,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:01:48.56,0:01:49.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:49.60,0:01:51.73,Default,,0,0,0,,Хмм.
Dialogue: 0,0:01:52.56,0:01:54.76,Default,,0,0,0,,Гүлдеріңізді күтуге келгенде, бізге қалдырыңыз!
Dialogue: 0,0:01:55.50,0:01:58.86,Default,,0,0,0,,Мектепте қызғалдақ та, күнбағыс та тамаша гүлдеген!
Dialogue: 0,0:01:59.03,0:02:01.13,Default,,0,0,0,,Тама-чан күткендей, сен сенімдісің.
Dialogue: 0,0:02:01.60,0:02:05.06,Default,,0,0,0,,Енді бәріміздің күш-қуатымызбен гүлдерді ашайық!
Dialogue: 0,0:02:05.13,0:02:06.50,Default,,0,0,0,,Иә
Dialogue: 0,0:02:06.96,0:02:08.36,Default,,0,0,0,,Ең алдымен, су!
Dialogue: 0,0:02:08.86,0:02:12.23,Default,,0,0,0,,Оммизу Охмизу Оммизу
Dialogue: 0,0:02:12.93,0:02:14.36,Default,,0,0,0,,Бұл даналық дорба!
Dialogue: 0,0:02:17.13,0:02:17.63,Default,,0,0,0,,Хой
Dialogue: 0,0:02:17.70,0:02:20.70,Default,,0,0,0,,Е-хо-э-э-э-о-о-о
Dialogue: 0,0:02:22.10,0:02:22.70,Default,,0,0,0,,Эфф
Dialogue: 0,0:02:23.13,0:02:26.13,Default,,0,0,0,,Күнделікті су мен баршаның махаббаты ғана қалды!
Dialogue: 0,0:02:26.23,0:02:27.80,Default,,0,0,0,,Бұл махаббат деп аталады.
Dialogue: 0,0:02:28.43,0:02:29.30,Default,,0,0,0,,Махаббат...
Dialogue: 0,0:02:29.50,0:02:30.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:32.10,0:02:33.96,Default,,0,0,0,,Махаббат Махаббат Махаббат
Dialogue: 0,0:02:34.13,0:02:37.03,Default,,0,0,0,,Бүгін де, ертең де, махаббат, махаббат.
Dialogue: 0,0:02:38.10,0:02:40.23,Default,,0,0,0,,Барлығы аянбай еңбек етуде.
Dialogue: 0,0:02:40.60,0:02:42.46,Default,,0,0,0,,Мен тіпті ат қойдым.
Dialogue: 0,0:02:42.83,0:02:44.03,Default,,0,0,0,,Бұл сіздің атыңыз ба?
Dialogue: 0,0:02:44.20,0:02:44.70,Default,,0,0,0,,Иә
Dialogue: 0,0:02:45.90,0:02:47.63,Default,,0,0,0,,Ол Хананан деп аталады.
Dialogue: 0,0:02:47.86,0:02:49.10,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:02:49.56,0:02:52.30,Default,,0,0,0,,Әй, бұл сүйкімді есім.
Dialogue: 0,0:02:52.83,0:02:53.93,Default,,0,0,0,,Хананан...
Dialogue: 0,0:02:56.53,0:02:57.23,Default,,0,0,0,,А... иә?
Dialogue: 0,0:02:57.73,0:03:01.43,Default,,0,0,0,,Хананан, күн сәулесін көп алайық.
Dialogue: 0,0:03:02.86,0:03:05.00,Default,,0,0,0,,Өзіңізді жақсы сезінесіз бе?
Dialogue: 0,0:03:06.10,0:03:08.23,Default,,0,0,0,,Судың дәмі жақсы, солай ма?
Dialogue: 0,0:03:10.43,0:03:13.30,Default,,0,0,0,,Бүршіктері кешегіден үлкен.
Dialogue: 0,0:03:14.20,0:03:16.30,Default,,0,0,0,,Тезірек гүлдейміз Хананан
Dialogue: 0,0:03:22.46,0:03:23.43,Default,,0,0,0,,Сол сияқты, бір күні, бір жерде кездесесіздер.
Dialogue: 0,0:03:23.70,0:03:24.20,Default,,0,0,0,,Уау...
Dialogue: 0,0:03:24.26,0:03:24.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:25.06,0:03:26.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:33.43,0:03:34.40,Default,,0,0,0,,Хмм.
Dialogue: 0,0:03:36.40,0:03:37.30,Default,,0,0,0,,А...
Dialogue: 0,0:03:39.00,0:03:39.96,Default,,0,0,0,,Уау...
Dialogue: 0,0:03:42.16,0:03:42.66,Default,,0,0,0,,О
Dialogue: 0,0:03:49.66,0:03:51.50,Default,,0,0,0,,Иә!
Dialogue: 0,0:03:53.46,0:03:57.93,Default,,0,0,0,,Ой-ой, әй, әй, әй!
Dialogue: 0,0:03:59.46,0:04:00.40,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:04:00.73,0:04:01.33,Default,,0,0,0,,Бұл — сүт, жұмыртқа сарысы, банан және нан —
Dialogue: 0,0:04:01.83,0:04:02.40,Default,,0,0,0,,Ахх!
Dialogue: 0,0:04:03.06,0:04:03.96,Default,,0,0,0,,Уфуфуфу…
Dialogue: 0,0:04:04.83,0:04:08.16,Default,,0,0,0,,Пикапика Пикапика
Dialogue: 0,0:04:08.50,0:04:10.13,Default,,0,0,0,,Пикка Пикка
Dialogue: 0,0:04:10.33,0:04:11.93,Default,,0,0,0,,Әдемі болайық
Dialogue: 0,0:04:12.76,0:04:13.83,Default,,0,0,0,,Рахмет
Dialogue: 0,0:04:14.13,0:04:14.66,Default,,0,0,0,,Дұрыс, болды!
Dialogue: 0,0:04:15.03,0:04:16.70,Default,,0,0,0,,Хананан сөйледі
Dialogue: 0,0:04:17.10,0:04:17.83,Default,,0,0,0,,Ахаха
Dialogue: 0,0:04:19.10,0:04:20.80,Default,,0,0,0,,Бір жері қышиды ма?
Dialogue: 0,0:04:21.16,0:04:23.56,Default,,0,0,0,,Хмм, мүмкін артқы жағы?
Dialogue: 0,0:04:23.83,0:04:24.83,Default,,0,0,0,,Артқа?
Dialogue: 0,0:04:25.06,0:04:25.56,Default,,0,0,0,,Ах
Dialogue: 0,0:04:27.20,0:04:28.53,Default,,0,0,0,,Эхехехе...
Dialogue: 0,0:04:29.00,0:04:31.73,Default,,0,0,0,,-Ахаха... -Хехе...
Dialogue: 0,0:04:32.96,0:04:34.36,Default,,0,0,0,,Міне, болды, болды
Dialogue: 0,0:04:34.63,0:04:37.60,Default,,0,0,0,,Хананан арқаңды сүрт дейді.
Dialogue: 0,0:04:37.96,0:04:38.70,Default,,0,0,0,,Артқа?
Dialogue: 0,0:04:39.16,0:04:39.66,Default,,0,0,0,,Иә
Dialogue: 0,0:04:40.03,0:04:41.93,Default,,0,0,0,,Менің арқам қышиды
Dialogue: 0,0:04:42.10,0:04:43.40,Default,,0,0,0,,Ех хе хе...
Dialogue: 0,0:04:43.46,0:04:44.80,Default,,0,0,0,,Хананан сөйледі ме?
Dialogue: 0,0:04:45.26,0:04:46.66,Default,,0,0,0,,№.
Dialogue: 0,0:04:46.93,0:04:48.83,Default,,0,0,0,,Мұғалім де алданып қалды.
Dialogue: 0,0:04:48.96,0:04:50.53,Default,,0,0,0,,Хорорин соған еліктеді.
Dialogue: 0,0:04:50.60,0:04:51.96,Default,,0,0,0,,-Хехехе... -Ахахаха...
Dialogue: 0,0:04:52.03,0:04:52.53,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:04:52.96,0:04:54.40,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:04:55.00,0:04:56.83,Default,,0,0,0,,Міне, ұйықтайтын уақыт келді.
Dialogue: 0,0:04:57.03,0:04:58.40,Default,,0,0,0,,Иә
Dialogue: 0,0:05:01.63,0:05:02.76,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:03.06,0:05:04.46,Default,,0,0,0,,Не болды?
Dialogue: 0,0:05:04.63,0:05:06.20,Default,,0,0,0,,Гүлдер солып жатыр.
Dialogue: 0,0:05:06.43,0:05:07.20,Default,,0,0,0,,Чайнатаун болса да, ол Йокогамада ғой!
Dialogue: 0,0:05:07.43,0:05:08.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:08.26,0:05:08.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:08.83,0:05:09.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:15.46,0:05:16.60,Default,,0,0,0,,Ханананха! ?
Dialogue: 0,0:05:22.03,0:05:24.36,Default,,0,0,0,,Хананаан!
Dialogue: 0,0:05:25.30,0:05:26.53,Default,,0,0,0,,Хананаан!
Dialogue: 0,0:05:26.96,0:05:28.60,Default,,0,0,0,,Жоқ, қурап қалма!
Dialogue: 0,0:05:29.06,0:05:30.53,Default,,0,0,0,,Құрып кетпесін.
Dialogue: 0,0:05:31.13,0:05:32.16,Default,,0,0,0,,Хананаан
Dialogue: 0,0:05:32.76,0:05:34.16,Default,,0,0,0,,Хананаан!
Dialogue: 0,0:05:34.23,0:05:35.00,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:05:35.06,0:05:35.70,Default,,0,0,0,,Құрып қалма
Dialogue: 0,0:05:35.76,0:05:37.83,Default,,0,0,0,,Сәттілік Хананан
Dialogue: 0,0:05:38.16,0:05:38.93,Default,,0,0,0,,Хананан!
Dialogue: 0,0:05:44.40,0:05:45.06,Default,,0,0,0,,Ахаха
Dialogue: 0,0:05:45.33,0:05:46.50,Default,,0,0,0,,Құрып қалма!
Dialogue: 0,0:05:46.96,0:05:47.90,Default,,0,0,0,,Хананан!
Dialogue: 0,0:05:57.30,0:05:58.66,Default,,0,0,0,,Енді сіз сенімді бола аласыз.
Dialogue: 0,0:05:59.16,0:06:02.90,Default,,0,0,0,,Сиқырдың құдіретімен Наннан ешқашан солмайтын гүлге айналды.
Dialogue: 0,0:06:03.00,0:06:04.20,Default,,0,0,0,,Аня нәжіске батты.
Dialogue: 0,0:06:04.93,0:06:09.03,Default,,0,0,0,,Бірақ гүлдер неге тез солып қалады?
Dialogue: 0,0:06:09.36,0:06:10.73,Default,,0,0,0,,Тұқым жасауға арналған.
Dialogue: 0,0:06:10.83,0:06:11.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:11.63,0:06:12.46,Default,,0,0,0,,Тұқым?
Dialogue: 0,0:06:12.70,0:06:13.70,Default,,0,0,0,,Өте мейірімді...
Dialogue: 0,0:06:14.23,0:06:17.86,Default,,0,0,0,,Тұқым жасап, жаңа гүлдер гүлдендір...
Dialogue: 0,0:06:18.46,0:06:19.76,Default,,0,0,0,,Жаңа гүлдер…
Dialogue: 0,0:06:20.13,0:06:20.83,Default,,0,0,0,,(Кёко) Ш-шын ба…? Сенің мен Шиндô-кунның араларыңда солай ма…
Dialogue: 0,0:06:34.20,0:06:35.73,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:06:36.90,0:06:39.50,Default,,0,0,0,,Гүлдер түсіп қалады ма?
Dialogue: 0,0:06:39.90,0:06:43.03,Default,,0,0,0,,Менің ойымша, бұл жақсы, өйткені мен сиқырды қолданамын, бірақ...
Dialogue: 0,0:06:43.46,0:06:46.16,Default,,0,0,0,,Жалқау болмаңыз. Мен саған қамқор болуым керек.
Dialogue: 0,0:06:46.40,0:06:47.53,Default,,0,0,0,,Ум...
Dialogue: 0,0:06:48.56,0:06:50.33,Default,,0,0,0,,Гүлдер енді солмайды
Dialogue: 0,0:06:50.86,0:06:53.40,Default,,0,0,0,,Саған қамқорлық жасаудың қажеті жоқ деп ойлаймын...
Dialogue: 0,0:06:53.70,0:06:55.13,Default,,0,0,0,,Бұл дұрыс емес!
Dialogue: 0,0:06:55.23,0:06:58.90,Default,,0,0,0,,Хананан менің досым, сондықтан оған қамқорлық жасауым табиғи нәрсе.
Dialogue: 0,0:07:01.60,0:07:02.50,Default,,0,0,0,,Куруру…
Dialogue: 0,0:07:13.06,0:07:16.16,Default,,0,0,0,,Эсшо Усшо Уншо...
Dialogue: 0,0:07:16.76,0:07:19.23,Default,,0,0,0,,Хананан Сіз қурап қалғыңыз келмейді, солай ма?
Dialogue: 0,0:07:19.60,0:07:21.70,Default,,0,0,0,,Оның қурап қалғанын қаламайсыз ба?
Dialogue: 0,0:07:24.36,0:07:25.70,Default,,0,0,0,,Иә, дұрыс!
Dialogue: 0,0:07:26.36,0:07:29.63,Default,,0,0,0,,Эсшо Усшо Усшо…
Dialogue: 0,0:07:31.20,0:07:33.20,Default,,0,0,0,,Екеуміз көбірек бірге болғанымызды қалаймын.
Dialogue: 0,0:07:34.36,0:07:36.80,Default,,0,0,0,,Келуге келгенде мен де солай сезінемін...
Dialogue: 0,0:07:37.96,0:07:41.40,Default,,0,0,0,,Мен де гүлдердің солғанын қаламаймын...
Dialogue: 0,0:07:42.83,0:07:47.13,Default,,0,0,0,,Бірақ егер Хананан тұқым жасағысы келсе...
Dialogue: 0,0:07:55.26,0:07:57.33,Default,,0,0,0,,Бұл дұрыс емес...
Dialogue: 0,0:07:58.46,0:07:59.73,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:08:00.26,0:08:02.06,Default,,0,0,0,,Қазір қызық, солай емес пе?
Dialogue: 0,0:08:02.50,0:08:04.73,Default,,0,0,0,,Тұқым болғаннан да қызық.
Dialogue: 0,0:08:06.03,0:08:09.66,Default,,0,0,0,,Әдемі гүл, солғанын қаламаймын.
Dialogue: 0,0:08:10.43,0:08:13.50,Default,,0,0,0,,Мен де Ханананмен бірге болғым келеді.
Dialogue: 0,0:08:13.93,0:08:15.86,Default,,0,0,0,,Мен сенімен мәңгі бірге болғым келеді
Dialogue: 0,0:08:16.56,0:08:18.33,Default,,0,0,0,,Ханананға да солай, солай ма?
Dialogue: 0,0:08:18.76,0:08:20.36,Default,,0,0,0,,Бұл жақсы!
Dialogue: 0,0:08:23.50,0:08:24.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:24.33,0:08:27.46,Default,,0,0,0,,Иә! Мен саған ертең көп су беремін.
Dialogue: 0,0:08:27.66,0:08:30.06,Default,,0,0,0,,Көп көп!
Dialogue: 0,0:08:36.53,0:08:38.60,Default,,0,0,0,,Исшо Исшо Исшо?
Dialogue: 0,0:08:38.90,0:08:39.46,Default,,0,0,0,,Егер ұсталып қалсам, ең болмағанда сені өлтіремін, Польнарефф》
Dialogue: 0,0:08:41.96,0:08:43.86,Default,,0,0,0,,Сарарин? Не болды?
Dialogue: 0,0:08:44.26,0:08:45.40,Default,,0,0,0,,Қарашы, Куруру
Dialogue: 0,0:08:45.46,0:08:45.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:46.66,0:08:47.96,Default,,0,0,0,,Уау
Dialogue: 0,0:08:48.26,0:08:49.36,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:08:50.06,0:08:52.20,Default,,0,0,0,,Гүлден тұқым пайда болды...
Dialogue: 0,0:08:52.93,0:08:53.63,Default,,0,0,0,,Тұқым…
Dialogue: 0,0:08:54.10,0:08:57.03,Default,,0,0,0,,Жаңа гүлдердің гүлденуіне арналған тұқымдар
Dialogue: 0,0:08:58.56,0:09:03.00,Default,,0,0,0,,Осылай қарасам, Хана топтан тыс қалған сияқты...
Dialogue: 0,0:09:06.30,0:09:07.23,Default,,0,0,0,,Сәлем Куруру
Dialogue: 0,0:09:07.30,0:09:07.93,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:09:08.46,0:09:09.06,Default,,0,0,0,,Kururu?
Dialogue: 0,0:09:09.13,0:09:10.26,Default,,0,0,0,,Қайта оралуыңызбен
Dialogue: 0,0:09:10.50,0:09:12.83,Default,,0,0,0,,Сиқыр бұзылса, бәрі қурап қалады.
Dialogue: 0,0:09:14.00,0:09:16.13,Default,,0,0,0,,Сонда біз бірге бола алмаймыз
Dialogue: 0,0:09:16.46,0:09:18.16,Default,,0,0,0,,Хана енді қала алмайды!
Dialogue: 0,0:09:19.60,0:09:21.80,Default,,0,0,0,,Хахахахаха
Dialogue: 0,0:09:21.96,0:09:24.80,Default,,0,0,0,,Хааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:09:25.36,0:09:27.46,Default,,0,0,0,,Хананан да солай ойлайды! ?
Dialogue: 0,0:09:27.70,0:09:29.96,Default,,0,0,0,,Мүлдем, мүлде, иә!
Dialogue: 0,0:09:30.23,0:09:31.93,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:09:32.33,0:09:35.40,Default,,0,0,0,,Ууууууууууууууу...
Dialogue: 0,0:09:35.76,0:09:39.70,Default,,0,0,0,,Ууууууууууууууу...
Dialogue: 0,0:09:39.93,0:09:41.53,Default,,0,0,0,,Ой...
Dialogue: 0,0:09:43.26,0:09:44.23,Default,,0,0,0,,Ха ха...
Dialogue: 0,0:09:44.86,0:09:45.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:45.80,0:09:46.43,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:46.76,0:09:47.43,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:47.80,0:09:48.36,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:50.30,0:09:51.00,Default,,0,0,0,,Ах ха!
Dialogue: 0,0:09:54.13,0:09:55.10,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,0:10:09.96,0:10:10.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:11.13,0:10:11.63,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:10:27.76,0:10:28.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:34.26,0:10:34.83,Default,,0,0,0,,Иә
Dialogue: 0,0:10:35.73,0:10:36.23,Default,,0,0,0,,Иә
Dialogue: 0,0:10:37.46,0:10:38.10,Default,,0,0,0,,Хехе
Dialogue: 0,0:10:38.63,0:10:39.30,Default,,0,0,0,,...
Dialogue: 0,0:10:57.43,0:11:01.50,Default,,0,0,0,,Қош бол!
Dialogue: 0,0:11:01.90,0:11:03.83,Default,,0,0,0,,Қош бол
Dialogue: 0,0:11:04.06,0:11:05.43,Default,,0,0,0,,Нара ла ла~
Dialogue: 0,0:11:09.10,0:11:12.03,Default,,0,0,0,,Жоқ... бұл қоштасу емес.
Dialogue: 0,0:11:14.26,0:11:14.76,Default,,0,0,0,,Ах
Dialogue: 0,0:11:14.83,0:11:15.43,Default,,0,0,0,,Егер ұсталып қалсам, ең болмағанда сені өлтіремін, Польнарефф》
Dialogue: 0,0:11:15.86,0:11:16.76,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:18.26,0:11:20.46,Default,,0,0,0,,Бұл кездесу...
Dialogue: 0,0:11:28.30,0:11:40.20,Default,,0,0,0,,Күздің сезімі оқу, сурет салу, тыныш күндер.
Dialogue: 0,0:11:41.30,0:11:51.70,Default,,0,0,0,,Желдің үні де аспанға ериді
Dialogue: 0,0:11:54.33,0:12:00.76,Default,,0,0,0,,Байқау Байқамау
Dialogue: 0,0:12:00.83,0:12:01.86,Default,,0,0,0,,Бірақ
Dialogue: 0,0:12:04.10,0:12:11.10,Default,,0,0,0,,Әй, құлаған жапырақтар, құлаған жапырақтар, ағаштар тізілген даңғыл
Dialogue: 0,0:12:11.70,0:12:17.63,Default,,0,0,0,,Қызылға боясам да
Dialogue: 0,0:12:18.26,0:12:21.03,Default,,0,0,0,,Жел, жел
Dialogue: 0,0:12:21.50,0:12:31.56,Default,,0,0,0,,Сол адамға оны жақсы көретініңізді сыбырлаңыз.
Dialogue: 0,0:12:33.06,0:12:39.06,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
