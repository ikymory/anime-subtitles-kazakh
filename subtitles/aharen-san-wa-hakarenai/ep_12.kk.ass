Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.38,0:00:14.01,Default,,0,0,0,,Ах... иә?
Dialogue: 0,0:00:16.05,0:00:18.68,Default,,0,0,0,,Иә?сурет?
Dialogue: 0,0:00:18.76,0:00:20.43,Default,,0,0,0,,Не? Қорқынышты Ахарен-сан
Dialogue: 0,0:00:21.06,0:00:24.31,Default,,0,0,0,,Мен кенет бос жерге қарап қалдым...
Dialogue: 0,0:00:26.02,0:00:30.03,Default,,0,0,0,,Рейна-чан, сен қайдан білесің?
Dialogue: 0,0:00:30.98,0:00:33.57,Default,,0,0,0,,Бұрынғыдан да мұқият тығылып жатсам да.
Dialogue: 0,0:00:34.07,0:00:38.91,Default,,0,0,0,,Бірақ мен сол уақыттан бері біраз өзгерген сияқтымын.
Dialogue: 0,0:00:38.99,0:00:40.66,Default,,0,0,0,,Өйткені, екеуі...
Dialogue: 0,0:00:41.58,0:00:43.54,Default,,0,0,0,,А, мен оны қайтадан таптым.
Dialogue: 0,0:00:43.62,0:00:45.42,Default,,0,0,0,,Қалай болғанда да...
Dialogue: 0,0:00:49.13,0:00:53.80,Default,,0,0,0,,Неліктен сонша сергексің?
Dialogue: 0,0:00:54.38,0:00:58.30,Default,,0,0,0,,Ахарен мырза, сіз күні бойы менің арқама қарап тұрған жоқсыз ба?
Dialogue: 0,0:00:58.39,0:01:00.43,Default,,0,0,0,,Менің артымда бірдеңе бар ма?
Dialogue: 0,0:01:00.93,0:01:01.60,Default,,0,0,0,,Ммм
Dialogue: 0,0:01:02.18,0:01:03.60,Default,,0,0,0,,Мен салқындап тұрмын.
Dialogue: 0,0:01:04.43,0:01:06.35,Default,,0,0,0,,Мен бүгін үйге бірінші барамын.
Dialogue: 0,0:01:06.90,0:01:07.85,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:01:09.15,0:01:09.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:14.19,0:01:15.24,Default,,0,0,0,,Оширо мырза
Dialogue: 0,0:01:15.32,0:01:16.53,Default,,0,0,0,,Иә!
Dialogue: 0,0:01:16.61,0:01:18.95,Default,,0,0,0,,Сіз менімен кенеттен сөйлестіңіз. Неліктен? Неліктен?
Dialogue: 0,0:01:19.99,0:01:22.91,Default,,0,0,0,,Ақыры жалғыз қалдық.
Dialogue: 0,0:01:22.99,0:01:24.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:24.75,0:01:28.29,Default,,0,0,0,,Өйткені Райду-кун қамқорлық танытып, оны екеумізге айналдырды.
Dialogue: 0,0:01:28.79,0:01:30.63,Default,,0,0,0,,Мен... солай деп ойлаймын.
Dialogue: 0,0:01:32.84,0:01:37.13,Default,,0,0,0,,Мен ол уақыт туралы әлі сөйлеспеген сияқтымын.
Dialogue: 0,0:01:37.63,0:01:39.97,Default,,0,0,0,,Мен... сұрай аламын ба?
Dialogue: 0,0:01:40.47,0:01:41.05,Default,,0,0,0,,Иә
Dialogue: 0,0:01:41.81,0:01:44.93,Default,,0,0,0,,Рейна-чан...
Dialogue: 0,0:01:45.43,0:01:49.90,Default,,0,0,0,,Сіз Райду-кунмен кездесіп тұрсыз, солай ма?
Dialogue: 0,0:01:51.52,0:01:52.36,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:55.19,0:01:56.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:57.15,0:01:58.32,Default,,0,0,0,,Оширо мырза
Dialogue: 0,0:02:01.49,0:02:03.16,Default,,0,0,0,,Рейна-чан
Dialogue: 0,0:02:04.24,0:02:06.29,Default,,0,0,0,,Батылдық болса да
Dialogue: 0,0:02:07.33,0:02:09.58,Default,,0,0,0,,Райду-кун...
Dialogue: 0,0:02:12.00,0:02:14.00,Default,,0,0,0,,♪~
Dialogue: 0,0:03:38.63,0:03:40.63,Default,,0,0,0,,~♪
Dialogue: 0,0:03:46.30,0:03:46.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:50.18,0:03:51.60,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:55.36,0:03:56.73,Default,,0,0,0,,Орындау хаты
Dialogue: 0,0:03:57.36,0:03:59.48,Default,,0,0,0,,Демек, бұл дуэль...
Dialogue: 0,0:03:59.57,0:04:00.99,Default,,0,0,0,,Ол маған айтты
Dialogue: 0,0:04:01.07,0:04:02.78,Default,,0,0,0,,Қандай да бір қателік болуы керек.
Dialogue: 0,0:04:03.28,0:04:05.82,Default,,0,0,0,,Қызық, Оширо мырза өз миссиясын орындады ма?
Dialogue: 0,0:04:06.62,0:04:09.16,Default,,0,0,0,,Райду-кун, сәлем Оширо...
Dialogue: 0,0:04:09.24,0:04:12.62,Default,,0,0,0,,(Мицукидің ауыр тыныс алуы)
Dialogue: 0,0:04:13.29,0:04:15.08,Default,,0,0,0,,Әрине?
Dialogue: 0,0:04:15.17,0:04:18.96,Default,,0,0,0,,Рейна-чан уәде еткендей келмеді, солай ма?
Dialogue: 0,0:04:19.05,0:04:20.96,Default,,0,0,0,,А, мен жалғыз келдім.
Dialogue: 0,0:04:21.46,0:04:22.55,Default,,0,0,0,,Жақсы
Dialogue: 0,0:04:22.63,0:04:26.34,Default,,0,0,0,,Себебі мен Рейна-чанның мені бұлай көргенін қаламадым.
Dialogue: 0,0:04:28.18,0:04:30.97,Default,,0,0,0,,Енді менімен жарыссаңдар деймін.
Dialogue: 0,0:04:31.60,0:04:33.73,Default,,0,0,0,,Мен өлдім бе?
Dialogue: 0,0:04:34.69,0:04:35.77,Default,,0,0,0,,Жеңіске жету жақсы
Dialogue: 0,0:04:35.85,0:04:38.61,Default,,0,0,0,,Әр адамның айтқанын тыңдау арқылы
Dialogue: 0,0:04:39.44,0:04:41.94,Default,,0,0,0,,Бұл реверси ойын.
Dialogue: 0,0:04:42.53,0:04:43.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:43.74,0:04:48.99,Default,,0,0,0,,Райду-кунның жекпе-жек өнерінде тәжірибесі жоқ, сондықтан сіз бұл сайысқа қатыса аласыз, солай ма?
Dialogue: 0,0:04:49.49,0:04:52.25,Default,,0,0,0,,А, иә, мен жеңілдеп қалдым.
Dialogue: 0,0:04:52.33,0:04:53.50,Default,,0,0,0,,Жарайды, мен аламын.
Dialogue: 0,0:04:54.00,0:04:55.92,Default,,0,0,0,,Алдыңғы Қара түсті киіңіз
Dialogue: 0,0:04:59.84,0:05:00.96,Default,,0,0,0,,Және
Dialogue: 0,0:05:01.67,0:05:03.76,Default,,0,0,0,,Мен сізге кейінірек сұрақтар қоямын.
Dialogue: 0,0:05:04.26,0:05:06.09,Default,,0,0,0,,Жауапқа байланысты
Dialogue: 0,0:05:07.51,0:05:11.01,Default,,0,0,0,,Мен жеңген кезде, дайын болыңыз.
Dialogue: 0,0:05:11.64,0:05:13.98,Default,,0,0,0,,Бұл өлім ғой, солай ма?
Dialogue: 0,0:05:14.56,0:05:17.06,Default,,0,0,0,,(реверси дыбысы)
Dialogue: 0,0:05:18.27,0:05:21.11,Default,,0,0,0,,Жоқ, мен жеңілмегенім жақсы.
Dialogue: 0,0:05:21.61,0:05:23.28,Default,,0,0,0,,Себебі болуы керек
Dialogue: 0,0:05:23.78,0:05:25.82,Default,,0,0,0,,Жеңіп, бәрін айт
Dialogue: 0,0:05:26.40,0:05:26.90,Default,,0,0,0,,Хмм
Dialogue: 0,0:05:27.49,0:05:29.91,Default,,0,0,0,,Бір сәтте төрт бұрыш алынды
Dialogue: 0,0:05:29.99,0:05:31.78,Default,,0,0,0,,Мен... а
Dialogue: 0,0:05:32.29,0:05:35.62,Default,,0,0,0,,Реверси ешқашан, тіпті Рейна-чанға да жеңілген емес.
Dialogue: 0,0:05:38.17,0:05:40.34,Default,,0,0,0,,
Dialogue: 0,0:05:40.42,0:05:41.92,Default,,0,0,0,,Иә, бәрі.
Dialogue: 0,0:05:42.00,0:05:43.84,Default,,0,0,0,,Семестрдің басында орын ауыстыру
Dialogue: 0,0:05:44.46,0:05:47.05,Default,,0,0,0,,Лотерея бойынша тағайындалған орынға көшу.
Dialogue: 0,0:05:47.13,0:05:50.43,Default,,0,0,0,,Қасыңдағы адаммен жақсы тіл табыса аласың ба?
Dialogue: 0,0:05:52.01,0:05:52.51,Default,,0,0,0,,Ах
Dialogue: 0,0:05:52.60,0:05:54.89,Default,,0,0,0,,Йо... Танысқаныма қуаныштымын.
Dialogue: 0,0:05:54.97,0:05:58.14,Default,,0,0,0,,Ахарен... Рейна-чан
Dialogue: 0,0:05:59.10,0:06:00.69,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:06:00.77,0:06:03.61,Default,,0,0,0,,С… Сүйкімді
Dialogue: 0,0:06:04.11,0:06:08.36,Default,,0,0,0,,Мен оны бірінші рет жақыннан көргенімде, ол кішкентай және қуыршақ сияқты болды.
Dialogue: 0,0:06:10.11,0:06:14.20,Default,,0,0,0,,Бұл үлкен маған мүлдем қарама-қайшы.
Dialogue: 0,0:06:16.12,0:06:18.79,Default,,0,0,0,,Келесі сабақ дене шынықтыру.
Dialogue: 0,0:06:20.08,0:06:21.29,Default,,0,0,0,,Ах (Ахарен)...
Dialogue: 0,0:06:21.38,0:06:23.42,Default,,0,0,0,,Не... не?
Dialogue: 0,0:06:23.92,0:06:24.88,Default,,0,0,0,,...
Dialogue: 0,0:06:24.96,0:06:25.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:27.05,0:06:27.80,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:28.42,0:06:31.93,Default,,0,0,0,,Кешіріңіз, менің жейдесі үлкен
Dialogue: 0,0:06:32.01,0:06:34.06,Default,,0,0,0,,Жоқ рахмет
Dialogue: 0,0:06:34.56,0:06:36.56,Default,,0,0,0,,Мен жаттығу залындағы киімімді ұмытып қалдым
Dialogue: 0,0:06:37.06,0:06:37.85,Default,,0,0,0,,Уф
Dialogue: 0,0:06:38.94,0:06:40.27,Default,,0,0,0,,Рейна-чан
Dialogue: 0,0:06:40.77,0:06:44.73,Default,,0,0,0,,Кішкентай, сүйкімді және сәл ебедейсіз
Dialogue: 0,0:06:45.23,0:06:49.36,Default,,0,0,0,,Даусыңыз кішкентай, сондықтан мен сөйлеген сайын маған өте жақын келесіз.
Dialogue: 0,0:06:49.45,0:06:52.45,Default,,0,0,0,,Мен кішкентаймын, сондықтан мен әр кезде таң қаламын.
Dialogue: 0,0:06:52.95,0:06:55.20,Default,,0,0,0,,Ахарен мырзаның қасына келген соң
Dialogue: 0,0:06:55.28,0:06:58.37,Default,,0,0,0,,Мен әдеттегіден де таңғалған сияқтымын.
Dialogue: 0,0:06:58.87,0:06:59.71,Default,,0,0,0,,Ах
Dialogue: 0,0:07:01.54,0:07:03.29,Default,,0,0,0,,Сізге Reversi ұнай ма?
Dialogue: 0,0:07:03.88,0:07:06.50,Default,,0,0,0,,Иә, Оширо мырза?
Dialogue: 0,0:07:06.59,0:07:09.05,Default,,0,0,0,,Иә, мен де.
Dialogue: 0,0:07:15.68,0:07:20.14,Default,,0,0,0,,Жарайды, тек мінберді орнына қою керек, жұмыс бітті.
Dialogue: 0,0:07:20.64,0:07:21.44,Default,,0,0,0,,Иә
Dialogue: 0,0:07:23.86,0:07:25.61,Default,,0,0,0,,А, мен мұны істеймін.
Dialogue: 0,0:07:26.11,0:07:27.15,Default,,0,0,0,,Жарайды
Dialogue: 0,0:07:29.49,0:07:30.36,Default,,0,0,0,,Ахх!
Dialogue: 0,0:07:31.24,0:07:32.91,Default,,0,0,0,,Бұл... Жақсысың ба?
Dialogue: 0,0:07:33.41,0:07:34.53,Default,,0,0,0,,Қауіпсіз
Dialogue: 0,0:07:35.28,0:07:37.66,Default,,0,0,0,,Бетіңіз шаңға толып тұр.
Dialogue: 0,0:07:37.74,0:07:38.83,Default,,0,0,0,,Рахмет
Dialogue: 0,0:07:38.91,0:07:41.50,Default,,0,0,0,,Жолыңнан шықсаң жақсы емес.
Dialogue: 0,0:07:42.00,0:07:45.75,Default,,0,0,0,,Сен маған ұқсамай сүйкімдісің, сондықтан мен сені тазалауым керек.
Dialogue: 0,0:07:46.71,0:07:47.55,Default,,0,0,0,,Иә
Dialogue: 0,0:07:50.38,0:07:51.17,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:53.38,0:07:54.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:55.97,0:07:57.60,Default,,0,0,0,,Иә? сурет?
Dialogue: 0,0:07:58.47,0:08:02.02,Default,,0,0,0,,Менің ойымша, Оширо-сан да сүйкімді.
Dialogue: 0,0:08:02.85,0:08:03.94,Default,,0,0,0,,Мен антидотты қолға түсірдім.
Dialogue: 0,0:08:10.11,0:08:11.11,Default,,0,0,0,,Райду?
Dialogue: 0,0:08:11.19,0:08:13.15,Default,,0,0,0,,Мен асығыс кетіп қалдым.
Dialogue: 0,0:08:14.03,0:08:15.28,Default,,0,0,0,,Рахмет
Dialogue: 0,0:08:20.04,0:08:22.66,Default,,0,0,0,,Үйге бірге бармайтынымыз сирек.
Dialogue: 0,0:08:23.16,0:08:24.79,Default,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,0:08:27.50,0:08:28.00,Default,,0,0,0,,Ах
Dialogue: 0,0:08:33.01,0:08:33.55,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:39.76,0:08:43.14,Default,,0,0,0,,Жеңіске жеткеннен кейін мені бірдеңе жасауға итермелеп жатырсың ба?
Dialogue: 0,0:08:43.64,0:08:44.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:44.44,0:08:45.98,Default,,0,0,0,,Бұл...
Dialogue: 0,0:08:47.19,0:08:49.82,Default,,0,0,0,,Райду-кунның ондай ниеті болмаса.
Dialogue: 0,0:08:51.15,0:08:54.36,Default,,0,0,0,,Рейна-чаннан қашықтықты сақтаңыз.
Dialogue: 0,0:08:56.70,0:08:58.41,Default,,0,0,0,,Сонда оған көмектесу мүмкін емес
Dialogue: 0,0:08:59.16,0:09:03.08,Default,,0,0,0,,Мен қазір жеңілуге шамасы жоқ. Мен оған барымды беремін.
Dialogue: 0,0:09:03.16,0:09:04.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:04.62,0:09:05.79,Default,,0,0,0,,Хмм
Dialogue: 0,0:09:10.17,0:09:11.25,Default,,0,0,0,,Басылды
Dialogue: 0,0:09:11.34,0:09:13.21,Default,,0,0,0,,Парақтар санындағы айырмашылыққа байланысты...
Dialogue: 0,0:09:13.80,0:09:17.01,Default,,0,0,0,,Соңғы қадам кестелерді айналдырды...
Dialogue: 0,0:09:17.51,0:09:19.89,Default,,0,0,0,,Не... неге?
Dialogue: 0,0:09:19.97,0:09:22.97,Default,,0,0,0,,Рейнаны ұнатпасаңыз...
Dialogue: 0,0:09:23.68,0:09:25.60,Default,,0,0,0,,Жеңілуге болмайды
Dialogue: 0,0:09:28.23,0:09:30.19,Default,,0,0,0,,Сіз бір нәрсені дұрыс түсінбеген сияқтысыз.
Dialogue: 0,0:09:30.69,0:09:31.61,Default,,0,0,0,,Мен...
Dialogue: 0,0:09:33.65,0:09:37.36,Default,,0,0,0,,Мен туралы, Райду-кун...
Dialogue: 0,0:09:37.86,0:09:38.91,Default,,0,0,0,,Мен бар күшімді салып, сол екі команданың ұпайларын жұлып аламын!
Dialogue: 0,0:09:42.41,0:09:45.16,Default,,0,0,0,,Кешіріңіз, бұл ештеңе емес.
Dialogue: 0,0:09:48.71,0:09:50.75,Default,,0,0,0,,Ахарен мырза (Ахарен) Иә?
Dialogue: 0,0:09:51.63,0:09:53.42,Default,,0,0,0,,Менен бір нәрсе сұрағым келеді.
Dialogue: 0,0:09:54.21,0:09:55.84,Default,,0,0,0,,Бұл менің сезімдерім туралы.
Dialogue: 0,0:09:55.92,0:09:57.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:58.01,0:09:58.93,Default,,0,0,0,,Мен...
Dialogue: 0,0:10:00.64,0:10:02.22,Default,,0,0,0,,Мен Ахаренді жақсы көремін!
Dialogue: 0,0:10:04.35,0:10:05.93,Default,,0,0,0,,Ах... (Ахарен) Уау...
Dialogue: 0,0:10:06.89,0:10:09.77,Default,,0,0,0,,Иә? А... Рейна-чан?
Dialogue: 0,0:10:09.85,0:10:11.27,Default,,0,0,0,,Ол қай уақыттан бері болды?
Dialogue: 0,0:10:11.77,0:10:13.69,Default,,0,0,0,,Дәл қазір
Dialogue: 0,0:10:13.77,0:10:19.16,Default,,0,0,0,,Оширо-санның шаш қыстырғышы түсіп қалған, сондықтан мен оны іздедім.
Dialogue: 0,0:10:19.24,0:10:20.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:24.08,0:10:25.62,Default,,0,0,0,,Э? Не? Мен тыңдамаппын.
Dialogue: 0,0:10:28.33,0:10:30.33,Default,,0,0,0,,Ах... рахмет
Dialogue: 0,0:10:30.42,0:10:31.88,Default,,0,0,0,,Және…
Dialogue: 0,0:10:32.38,0:10:35.05,Default,,0,0,0,,Кешіріңіз, Оширо мырза.
Dialogue: 0,0:10:35.55,0:10:39.84,Default,,0,0,0,,Мен дұрыс айтпадым, сондықтан қате түсіндім.
Dialogue: 0,0:10:41.09,0:10:44.26,Default,,0,0,0,,Ол кезде мен ештеңе айта алмадым.
Dialogue: 0,0:10:45.35,0:10:49.23,Default,,0,0,0,,Бірақ Райду-кун маған сезімін айтты.
Dialogue: 0,0:10:49.73,0:10:55.44,Default,,0,0,0,,Қуанғаным сонша, бірақ сөз таппадым...
Dialogue: 0,0:10:56.28,0:11:00.15,Default,,0,0,0,,Бірақ мен Райду-кунның таңданған түрін көргенде,
Dialogue: 0,0:11:00.66,0:11:03.49,Default,,0,0,0,,Мен мұны қайтадан жасадым деп ойладым.
Dialogue: 0,0:11:03.99,0:11:06.70,Default,,0,0,0,,Ештеңе айтпастан қашып кет
Dialogue: 0,0:11:07.45,0:11:12.58,Default,,0,0,0,,Мен тағы да адамдармен арақашықтықты сақтай алмайтындай болдым.
Dialogue: 0,0:11:14.09,0:11:16.30,Default,,0,0,0,,Сонымен... солай болды ма?
Dialogue: 0,0:11:17.13,0:11:19.38,Default,,0,0,0,,Мен... Кешіріңіз, Райду-кун.
Dialogue: 0,0:11:19.47,0:11:20.84,Default,,0,0,0,,Біз оның жайлы өте аз білеміз… Бұл не, мырза Ринатаки?
Dialogue: 0,0:11:20.93,0:11:24.55,Default,,0,0,0,,Жарайды, барлығында түсініспеушілік бар.
Dialogue: 0,0:11:25.43,0:11:29.27,Default,,0,0,0,,Ахарен мырза, бұл мені таң қалдырды.
Dialogue: 0,0:11:29.85,0:11:32.06,Default,,0,0,0,,Ахарен мырзаның да қашықтық сезімі.
Dialogue: 0,0:11:32.85,0:11:34.06,Default,,0,0,0,,Маған ұнайды
Dialogue: 0,0:11:34.56,0:11:36.52,Default,,0,0,0,,Ах… Ух…
Dialogue: 0,0:11:36.61,0:11:40.53,Default,,0,0,0,,Ра… Райду-кун, И
Dialogue: 0,0:11:41.11,0:11:44.12,Default,,0,0,0,,（）
Dialogue: 0,0:11:48.29,0:11:51.50,Default,,0,0,0,,Мен де сені жақсы көремін Райду-кун
Dialogue: 0,0:11:54.71,0:11:56.29,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:56.38,0:11:59.51,Default,,0,0,0,,(Сато мен Ишикаваның күлкісі)
Dialogue: 0,0:11:59.59,0:12:01.72,Default,,0,0,0,,Ол қай уақыттан бері болды?
Dialogue: 0,0:12:01.80,0:12:04.09,Default,,0,0,0,,Ахарен мырза Райдуды іздеп жүрді.
Dialogue: 0,0:12:04.18,0:12:05.97,Default,,0,0,0,,Мен бір нәрсеге қызықпын.
Dialogue: 0,0:12:06.05,0:12:08.64,Default,,0,0,0,,Ол мені қуды, сосын...
Dialogue: 0,0:12:08.72,0:12:09.81,Default,,0,0,0,,Эй (Сато) Эй
Dialogue: 0,0:12:09.89,0:12:12.02,Default,,0,0,0,,Бірақ бұл өте жақсы болды.
Dialogue: 0,0:12:12.10,0:12:14.02,Default,,0,0,0,,Менің жүрегім дүрсілдеп кетті
Dialogue: 0,0:12:14.10,0:12:16.44,Default,,0,0,0,,Иә, мен де
Dialogue: 0,0:12:17.82,0:12:20.44,Default,,0,0,0,,Егер мен жақынырақ болсам...
Dialogue: 0,0:12:22.19,0:12:26.20,Default,,0,0,0,,Рейна-чан менің жүрегімнің дүрсілін естиді
Dialogue: 0,0:12:26.82,0:12:28.87,Default,,0,0,0,,Содан бері мен ұятқа қалдым.
Dialogue: 0,0:12:28.95,0:12:32.16,Default,,0,0,0,,Мен жай ғана алыстан бақылап отырдым
Dialogue: 0,0:12:32.96,0:12:37.79,Default,,0,0,0,,Содан бері мен Рейнамен қайта сөйлесе бастадым.
Dialogue: 0,0:12:38.29,0:12:42.76,Default,,0,0,0,,Дұрыс, Райду-кун мені тапты.
Dialogue: 0,0:12:42.84,0:12:44.80,Default,,0,0,0,,Енді, мен...
Dialogue: 0,0:12:44.88,0:12:47.01,Default,,0,0,0,,Мен өзімдікі сияқты бақыттымын.
Dialogue: 0,0:12:47.09,0:12:48.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:52.18,0:12:53.60,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:12:58.40,0:13:00.27,Default,,0,0,0,,(Ишикава мен Сатоның күлкісі)
Dialogue: 0,0:13:13.45,0:13:15.92,Default,,0,0,0,,Менің қасымда отырған Ахарен мырза
Dialogue: 0,0:13:16.00,0:13:19.08,Default,,0,0,0,,Адамдардан қашықтығымды өлшей алмаймын.
Dialogue: 0,0:13:20.04,0:13:22.05,Default,,0,0,0,,Сонымен, Ахарен мырза екеуміз...
Dialogue: 0,0:13:22.13,0:13:23.05,Default,,0,0,0,,
Dialogue: 0,0:13:23.13,0:13:24.55,Default,,0,0,0,,Иә, бәрі осы
Dialogue: 0,0:13:24.63,0:13:27.05,Default,,0,0,0,,Қараңдаршы, балалар, көктемгі демалыс жақындап қалды.
Dialogue: 0,0:13:27.64,0:13:28.89,Default,,0,0,0,,Алданбаңыз.
Dialogue: 0,0:13:28.97,0:13:30.30,Default,,0,0,0,,Иә
Dialogue: 0,0:13:32.26,0:13:34.77,Default,,0,0,0,,Жарайды, Ахарен-сан, үйге қайтайық.
Dialogue: 0,0:13:35.73,0:13:38.65,Default,,0,0,0,,Кешіріңіз, менің бір ісім бар.
Dialogue: 0,0:13:42.65,0:13:46.65,Default,,0,0,0,,Ахарен мырза, мен бұл қауесеттің бір бөлігі болады деп ойламадым...
Dialogue: 0,0:13:47.53,0:13:48.82,Default,,0,0,0,,Жалқау кезең
Dialogue: 0,0:13:48.91,0:13:52.83,Default,,0,0,0,,Ұзақ жылдар бірге болған жұптарға арналған Рут кезеңі
Dialogue: 0,0:13:53.33,0:13:56.21,Default,,0,0,0,,Оны бұзу үшін ынталандыру қажет
Dialogue: 0,0:13:57.21,0:13:57.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:59.50,0:14:01.59,Default,,0,0,0,,Сол жапырақтың пішіні...
Dialogue: 0,0:14:02.21,0:14:03.67,Default,,0,0,0,,Маниок
Dialogue: 0,0:14:03.92,0:14:06.26,Default,,0,0,0,,Тропиктік аймақта өсетін түйнек түрі.
Dialogue: 0,0:14:06.34,0:14:10.43,Default,,0,0,0,,Шикі маниоктың терісінде және өзегінде улы бар.
Dialogue: 0,0:14:10.93,0:14:14.27,Default,,0,0,0,,Ахарен мырза, қанша ынталандыруды қаласаңыз да...
Dialogue: 0,0:14:14.64,0:14:15.89,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:14:16.81,0:14:18.94,Default,,0,0,0,,Тапиоканың шикізаты - маниок.
Dialogue: 0,0:14:19.44,0:14:20.86,Default,,0,0,0,,Ахарен мырза
Dialogue: 0,0:14:20.94,0:14:23.32,Default,,0,0,0,,Мен тапиока сүті бар шай дүкенін ашпақшымын.
Dialogue: 0,0:14:23.98,0:14:26.69,Default,,0,0,0,,Бірақ тек осымен бәсекелесу қауіпті.
Dialogue: 0,0:14:27.19,0:14:29.61,Default,,0,0,0,,Ол жаңа қозғалыс туралы ойласа керек.
Dialogue: 0,0:14:30.70,0:14:31.70,Default,,0,0,0,,Юрукяра
Dialogue: 0,0:14:32.20,0:14:33.83,Default,,0,0,0,,Тапиоканы сүйкімді кейіпкерге айналдыр
Dialogue: 0,0:14:33.91,0:14:37.71,Default,,0,0,0,,Мен кейіпкерді танымал етуді және жаңа тұтынушыларды тартуды жоспарлап отырмын.
Dialogue: 0,0:14:38.29,0:14:39.21,Default,,0,0,0,,Ахарен мырза
Dialogue: 0,0:14:39.29,0:14:42.00,Default,,0,0,0,,Мен сонша ынталандыруды іздедім.
Dialogue: 0,0:14:42.08,0:14:45.59,Default,,0,0,0,,Сәтсіздікке ұшырау қаупін ескеріп, ешкімді шақырмай, жалғыз істеуді жөн көрдім.
Dialogue: 0,0:14:45.67,0:14:46.88,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:14:48.67,0:14:49.59,Default,,0,0,0,,Хмм (Ахарен) А...
Dialogue: 0,0:14:49.68,0:14:51.34,Default,,0,0,0,,Мен оны көтере алмаймын.
Dialogue: 0,0:14:51.84,0:14:54.05,Default,,0,0,0,,Сенің мұны менен жасырын істеп жатқаныңа сене алар емеспін.
Dialogue: 0,0:14:54.64,0:14:56.06,Default,,0,0,0,,Мен көріндім
Dialogue: 0,0:14:56.64,0:14:58.27,Default,,0,0,0,,Жасырғаным үшін кешіріңіз.
Dialogue: 0,0:14:58.35,0:15:01.19,Default,,0,0,0,,Мен Райдоудың таң қалғанын қалаймын.
Dialogue: 0,0:15:01.69,0:15:05.73,Default,,0,0,0,,Сондай-ақ, бұл менің бірінші рет, сондықтан мен сәтсіздікке ұшыраудан қорқамын.
Dialogue: 0,0:15:05.82,0:15:07.48,Default,,0,0,0,,Тұщы су (Ахарен) Ах...
Dialogue: 0,0:15:07.57,0:15:10.95,Default,,0,0,0,,Сондықтан мен сізге көмектесе аламын
Dialogue: 0,0:15:11.66,0:15:14.16,Default,,0,0,0,,Қонақ үй иесінің әйелі екі күн бұрын қайтыс болды ғой, иә?
Dialogue: 0,0:15:14.24,0:15:17.20,Default,,0,0,0,,Олай болса, қазірден бастап бірге көтерейік.
Dialogue: 0,0:15:24.29,0:15:26.42,Default,,0,0,0,,Ол әдемі гүлдеді.
Dialogue: 0,0:15:26.50,0:15:28.05,Default,,0,0,0,,Үлкен табыс!
Dialogue: 0,0:15:28.84,0:15:30.67,Default,,0,0,0,,Мен оны әрең түсіндім.
Dialogue: 0,0:15:30.76,0:15:32.47,Default,,0,0,0,,Бұл маниок емес пе?
Dialogue: 0,0:15:33.01,0:15:33.89,Default,,0,0,0,,Бұл…
Dialogue: 0,0:15:34.47,0:15:36.64,Default,,0,0,0,,Бұл люпин деп аталатын гүл.
Dialogue: 0,0:15:37.14,0:15:39.14,Default,,0,0,0,,Ах, люпиндер.
Dialogue: 0,0:15:39.22,0:15:40.85,Default,,0,0,0,,Иә, әдемі.
Dialogue: 0,0:15:41.48,0:15:44.31,Default,,0,0,0,,Гүлдердің тілі мінсіз деп ойлаймын.
Dialogue: 0,0:15:44.40,0:15:47.02,Default,,0,0,0,,Люпиннің гүл тілі...
Dialogue: 0,0:15:47.78,0:15:48.98,Default,,0,0,0,,«Қиял»
Dialogue: 0,0:15:49.49,0:15:50.32,Default,,0,0,0,,Иә
Dialogue: 0,0:15:51.36,0:15:53.24,Default,,0,0,0,,Бұл, әрине, жақсы сәйкес келеді.
Dialogue: 0,0:15:53.91,0:15:57.16,Default,,0,0,0,,Жоқ, күте тұрыңыз, басқа мағына да болды.
Dialogue: 0,0:15:57.24,0:15:57.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:58.04,0:16:00.41,Default,,0,0,0,,Мен сенімдімін...
Dialogue: 0,0:16:01.54,0:16:03.42,Default,,0,0,0,,Бұл «ашкөз» болды (Ахарен) иә?
Dialogue: 0,0:16:03.50,0:16:05.42,Default,,0,0,0,,Хмм, түсіндім.
Dialogue: 0,0:16:05.50,0:16:06.88,Default,,0,0,0,,Хмм... хмм?
Dialogue: 0,0:16:06.96,0:16:09.80,Default,,0,0,0,,Не болды? кенет ісіп кетті
Dialogue: 0,0:16:10.30,0:16:12.59,Default,,0,0,0,,Райду-кун сезімсіз
Dialogue: 0,0:16:12.68,0:16:14.89,Default,,0,0,0,,Не, жақсысың ба?
Dialogue: 0,0:16:15.59,0:16:16.30,Default,,0,0,0,,Хмм.
Dialogue: 0,0:16:17.47,0:16:19.81,Default,,0,0,0,,Ал, енді үйге қайтайық.
Dialogue: 0,0:16:21.39,0:16:22.14,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:22.89,0:16:23.64,Default,,0,0,0,,Иә
Dialogue: 0,0:16:29.40,0:16:32.15,Default,,0,0,0,,Сізді сезімсіз деп атағаным үшін кешіріңіз.
Dialogue: 0,0:16:38.66,0:16:42.20,Default,,0,0,0,,Кеше Ахарен мырза неге сонша ашуланды деп ойлаймын.
Dialogue: 0,0:16:42.71,0:16:45.62,Default,,0,0,0,,Қазірдің өзінде кейде мен шынымен түсінбеймін.
Dialogue: 0,0:16:46.13,0:16:49.00,Default,,0,0,0,,Иә, бүгінгі күннің бәрі осы.
Dialogue: 0,0:16:49.63,0:16:52.21,Default,,0,0,0,,Жарайды, бүгін аяқталды.
Dialogue: 0,0:16:54.59,0:16:56.26,Default,,0,0,0,,Бұрынғыдай жақын.
Dialogue: 0,0:16:56.76,0:16:58.22,Default,,0,0,0,,Хмм... Иә?
Dialogue: 0,0:17:00.47,0:17:02.89,Default,,0,0,0,,Кейінірек оралыңыз, мен күтемін.
Dialogue: 0,0:17:07.44,0:17:11.98,Default,,0,0,0,,Шақыру орны қазіргі уақытта пайдаланылмайтын шай бөлмесі болып табылады.
Dialogue: 0,0:17:12.48,0:17:14.40,Default,,0,0,0,,Айналасында ешкім жоқ жерде жалғыз
Dialogue: 0,0:17:14.49,0:17:18.24,Default,,0,0,0,,Бұл да зерігу кезеңінде ынталандыруды іздеу ме?
Dialogue: 0,0:17:18.99,0:17:19.74,Default,,0,0,0,,Ах
Dialogue: 0,0:17:21.87,0:17:23.12,Default,,0,0,0,,Ммммммм
Dialogue: 0,0:17:28.17,0:17:30.88,Default,,0,0,0,,Әдеттегідей шай жасай бастады.
Dialogue: 0,0:17:31.38,0:17:34.42,Default,,0,0,0,,Ахарен мырза, мен сізге сене алмаймын.
Dialogue: 0,0:17:35.42,0:17:36.59,Default,,0,0,0,,Сен жоқ Рикю
Dialogue: 0,0:17:37.09,0:17:41.26,Default,,0,0,0,,Сенгоку кезеңінен Азучи-Момояма кезеңіне дейін шай рәсімін танымал еткен шай шебері.
Dialogue: 0,0:17:41.76,0:17:46.23,Default,,0,0,0,,Дегенмен, бір теорияда Рикю шай рәсімінде алған ақпаратты пайдаланғанын айтады.
Dialogue: 0,0:17:46.31,0:17:48.94,Default,,0,0,0,,Жапонияны сахнаның артында айла-шарғы жасап жатқаны айтылады.
Dialogue: 0,0:17:49.02,0:17:52.98,Default,,0,0,0,,Басқаша айтқанда, оларда сіздің ақпаратыңыз бар екенін көрсететін хабарлама.
Dialogue: 0,0:17:53.48,0:17:56.07,Default,,0,0,0,,Ахарен мырза, сіз мені бопсалағыңыз келе ме?
Dialogue: 0,0:17:56.57,0:17:58.78,Default,,0,0,0,,Ахарен мырза, сіз жасыл бұрыш жегіңіз келе ме?
Dialogue: 0,0:17:59.45,0:18:02.49,Default,,0,0,0,,Мен жасыл бұрышты ұнатпаймын. Маған оларды жеуге рұқсат етіңіз.
Dialogue: 0,0:18:03.37,0:18:06.00,Default,,0,0,0,,Байқамай шалбарымды алға-артқа киіп алдым.
Dialogue: 0,0:18:06.08,0:18:08.21,Default,,0,0,0,,Ешкім білмейтіндей етіп жасыру керек
Dialogue: 0,0:18:09.37,0:18:11.46,Default,,0,0,0,,Мен лотереядан 300 иен ұтып алдым.
Dialogue: 0,0:18:11.96,0:18:13.42,Default,,0,0,0,,Құпия болсын
Dialogue: 0,0:18:14.38,0:18:18.43,Default,,0,0,0,,Ахарен мырза, сіз мен туралы не білесіз?
Dialogue: 0,0:18:19.43,0:18:22.18,Default,,0,0,0,,Дегенмен, ол шай ішу рәсімі этикетінің негіздерін де қамтиды.
Dialogue: 0,0:18:22.68,0:18:24.68,Default,,0,0,0,,Мені оңайлықпен бопсаламайды.
Dialogue: 0,0:18:25.27,0:18:26.35,Default,,0,0,0,,Келіңіздер.
Dialogue: 0,0:18:29.48,0:18:30.65,Default,,0,0,0,,Шай, солай ма?
Dialogue: 0,0:18:31.94,0:18:33.32,Default,,0,0,0,,Батыс тәттілері, солай ма?
Dialogue: 0,0:18:34.11,0:18:35.69,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:18:36.28,0:18:37.15,Default,,0,0,0,,Хмм
Dialogue: 0,0:18:38.74,0:18:42.07,Default,,0,0,0,,Е, маған қанша ынталандыру керек болса да
Dialogue: 0,0:18:42.16,0:18:44.08,Default,,0,0,0,,Күтілгендей, дуэль...
Dialogue: 0,0:18:46.66,0:18:49.21,Default,,0,0,0,,Менің әлі басы айналып жүр.
Dialogue: 0,0:18:50.67,0:18:54.29,Default,,0,0,0,,Мен Ахаренді жақсы көремін!
Dialogue: 0,0:18:55.71,0:18:58.47,Default,,0,0,0,,Мен де сені сүйемін Райду-кун
Dialogue: 0,0:18:58.55,0:18:59.59,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:01.01,0:19:02.76,Default,,0,0,0,,Керемет!
Dialogue: 0,0:19:02.85,0:19:05.68,Default,,0,0,0,,Кяах! мұғалім! Не болды?
Dialogue: 0,0:19:06.18,0:19:09.43,Default,,0,0,0,,Сол кездегі Ұлы атқылаудың әсерінен.
Dialogue: 0,0:19:09.52,0:19:11.65,Default,,0,0,0,,Әлі де жақсы емеспін
Dialogue: 0,0:19:12.19,0:19:13.36,Default,,0,0,0,,Момо-чан (Момохара) Иә?
Dialogue: 0,0:19:15.94,0:19:17.73,Default,,0,0,0,,Уфуфуфуфу (Момохара) Бұл не?
Dialogue: 0,0:19:18.86,0:19:20.65,Default,,0,0,0,,Күте тұрыңыз, Ахарен мырза.
Dialogue: 0,0:19:21.95,0:19:22.45,Default,,0,0,0,,Әй
Dialogue: 0,0:19:25.66,0:19:26.33,Default,,0,0,0,,Хмм
Dialogue: 0,0:19:27.45,0:19:29.45,Default,,0,0,0,,Қош келдіңіз Оширо мырза
Dialogue: 0,0:19:29.54,0:19:31.54,Default,,0,0,0,,Сәлеметсіз бе...
Dialogue: 0,0:19:31.62,0:19:33.08,Default,,0,0,0,,Мен Оширо мырзаға қоңырау шалдым.
Dialogue: 0,0:19:33.58,0:19:35.59,Default,,0,0,0,,Бұл куә
Dialogue: 0,0:19:35.67,0:19:37.38,Default,,0,0,0,,Әлі де дуэль
Dialogue: 0,0:19:37.46,0:19:38.88,Default,,0,0,0,,Кешіріңіз, кешігіп қалдым
Dialogue: 0,0:19:38.96,0:19:40.97,Default,,0,0,0,,Өйткені мен тазалық қызметінде болдым.
Dialogue: 0,0:19:41.55,0:19:42.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:42.76,0:19:45.68,Default,,0,0,0,,Ахарен мырза, мені шақырғаныңызға рахмет.
Dialogue: 0,0:19:45.76,0:19:47.51,Default,,0,0,0,,Ол да маған шай берді.
Dialogue: 0,0:19:48.02,0:19:51.77,Default,,0,0,0,,Бөлме мен құралдарға рұқсат алғаныңыз үшін рахмет.
Dialogue: 0,0:19:51.85,0:19:53.85,Default,,0,0,0,,Жарайды (Момохара) Иә.
Dialogue: 0,0:19:53.94,0:19:57.02,Default,,0,0,0,,Райду-кун, сен ерте келдің.
Dialogue: 0,0:19:57.11,0:19:59.94,Default,,0,0,0,,Мен дайындаған тәттілерден дәм татуды өтіндім.
Dialogue: 0,0:20:00.44,0:20:02.32,Default,,0,0,0,,Дуэль туралы не деуге болады? (Ахарен) Иә?
Dialogue: 0,0:20:02.40,0:20:03.91,Default,,0,0,0,,Эй, не болды, Армин? Өзіңді қолыңнан ал, иә? Эй!
Dialogue: 0,0:20:04.74,0:20:09.79,Default,,0,0,0,,Мен бірінші рет болғандықтан қобалжыдым, бірақ барлығының келгеніне қуаныштымын.
Dialogue: 0,0:20:12.66,0:20:15.13,Default,,0,0,0,,Мен оны сенімен бірге жегім келді.
Dialogue: 0,0:20:15.88,0:20:16.75,Default,,0,0,0,,Барлығы
Dialogue: 0,0:20:17.25,0:20:20.80,Default,,0,0,0,,Иә, бірге тамақтанған қызық.
Dialogue: 0,0:20:21.30,0:20:23.22,Default,,0,0,0,,Олай болса, шәй ішіп алайық.
Dialogue: 0,0:20:23.72,0:20:24.47,Default,,0,0,0,,Иә
Dialogue: 0,0:20:41.65,0:20:44.53,Default,,0,0,0,,Шие гүлдері көп!
Dialogue: 0,0:20:44.61,0:20:48.49,Default,,0,0,0,,Қарасам, барлығы жақында екінші курста болады.
Dialogue: 0,0:20:48.58,0:20:49.45,Default,,0,0,0,,Ах
Dialogue: 0,0:20:52.04,0:20:52.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:02.30,0:21:04.01,Default,,0,0,0,,Не болды? кенеттен
Dialogue: 0,0:21:04.51,0:21:10.47,Default,,0,0,0,,Мен жоғары сынып оқушысы атанғанымда әлі де көп қателіктер жібердім.
Dialogue: 0,0:21:10.97,0:21:14.60,Default,,0,0,0,,Жалғыз қалдым ба деп ойлайтынмын.
Dialogue: 0,0:21:15.64,0:21:17.35,Default,,0,0,0,,Бірақ олай емес.
Dialogue: 0,0:21:17.90,0:21:19.69,Default,,0,0,0,,Әр күн қызық
Dialogue: 0,0:21:20.32,0:21:23.32,Default,,0,0,0,,Бүгін келгендердің барлығына рахмет.
Dialogue: 0,0:21:24.28,0:21:25.36,Default,,0,0,0,,Сонымен
Dialogue: 0,0:21:25.45,0:21:29.28,Default,,0,0,0,,Мен сізге бір нәрсе үшін алғыс айтқым келді.
Dialogue: 0,0:21:29.91,0:21:33.08,Default,,0,0,0,,Түсіндім, шай ішейік.
Dialogue: 0,0:21:33.87,0:21:35.46,Default,,0,0,0,,Мм... Ахарен мырза?
Dialogue: 0,0:21:35.96,0:21:38.79,Default,,0,0,0,,Мен қорқамын
Dialogue: 0,0:21:39.38,0:21:43.76,Default,,0,0,0,,Райду-кун екеуміз басқалардан бөлек сыныпта боламыз.
Dialogue: 0,0:21:44.34,0:21:48.51,Default,,0,0,0,,Мен басқа адамдармен жақсы достасатыныма сенімді емеспін.
Dialogue: 0,0:21:49.39,0:21:51.93,Default,,0,0,0,,Жарайды (Ахарен) А...
Dialogue: 0,0:21:52.72,0:21:54.73,Default,,0,0,0,,Сынып бөлінген болса да
Dialogue: 0,0:21:54.81,0:21:56.89,Default,,0,0,0,,Бірдеңе болса, мен әрқашан ұшып кетемін.
Dialogue: 0,0:21:59.15,0:21:59.94,Default,,0,0,0,,Иә
Dialogue: 0,0:22:01.06,0:22:03.32,Default,,0,0,0,,Люпин гүлінің тілі
Dialogue: 0,0:22:04.03,0:22:07.40,Default,,0,0,0,,Райду айтқаннан басқа екі нәрсе бар.
Dialogue: 0,0:22:07.49,0:22:09.78,Default,,0,0,0,,Не? Солай ма?
Dialogue: 0,0:22:11.16,0:22:14.04,Default,,0,0,0,,«Сен менің тыныштығымсың»
Dialogue: 0,0:22:14.12,0:22:15.91,Default,,0,0,0,,«Әрқашан бақытты»
Dialogue: 0,0:22:17.29,0:22:18.54,Default,,0,0,0,,Рахмет
Dialogue: 0,0:22:18.62,0:22:19.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:21.42,0:22:23.09,Default,,0,0,0,,Ал Ахарен мырза (Ахарен) Ах...
Dialogue: 0,0:22:23.17,0:22:26.05,Default,,0,0,0,,Бұл жалғыз мен емес, басқалар да.
Dialogue: 0,0:22:26.13,0:22:27.72,Default,,0,0,0,,А, мен шынымен де болдым.
Dialogue: 0,0:22:27.80,0:22:28.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:28.47,0:22:29.76,Default,,0,0,0,,Мияхира мырза
Dialogue: 0,0:22:29.89,0:22:33.18,Default,,0,0,0,,Ахарен мырза, менің ойымша, сіз шие гүлін тамашалағыңыз келуі мүмкін.
Dialogue: 0,0:22:33.26,0:22:35.35,Default,,0,0,0,,Мен айтқандай болды, солай ма?
Dialogue: 0,0:22:41.61,0:22:44.40,Default,,0,0,0,,Сынып әртүрлі болса да...
Dialogue: 0,0:22:44.48,0:22:46.49,Default,,0,0,0,,♪~
Dialogue: 0,0:22:48.07,0:22:49.57,Default,,0,0,0,,Тек мектеп емес
Dialogue: 0,0:22:54.03,0:22:56.33,Default,,0,0,0,,Дүниеде неше түрлі адамдар бар.
Dialogue: 0,0:23:02.96,0:23:04.34,Default,,0,0,0,,Жақсы адамдар
Dialogue: 0,0:23:09.63,0:23:12.51,Default,,0,0,0,,Мен болашақта дос болатын кейбір адамдар
Dialogue: 0,0:23:14.14,0:23:15.85,Default,,0,0,0,,Мен көп екеніне сенімдімін.
Dialogue: 0,0:23:18.60,0:23:19.31,Default,,0,0,0,,Иә
Dialogue: 0,0:23:20.81,0:23:21.85,Default,,0,0,0,,Рахмет
Dialogue: 0,0:23:22.35,0:23:25.27,Default,,0,0,0,,Екі адам қуана құшақтасып тұр
Dialogue: 0,0:23:26.07,0:23:28.11,Default,,0,0,0,,Қандай таңғаларлық данышпан!
Dialogue: 0,0:23:28.61,0:23:32.24,Default,,0,0,0,,Мен осы уақытқа дейін шыдауға тырыстым, бірақ қазір...
Dialogue: 0,0:23:32.32,0:23:33.53,Default,,0,0,0,,Момо-чан?
Dialogue: 0,0:23:33.62,0:23:34.95,Default,,0,0,0,,Момохара мырза?
Dialogue: 0,0:23:35.53,0:23:37.99,Default,,0,0,0,,Мен... Менде ұлпалар бар.
Dialogue: 0,0:23:38.08,0:23:40.04,Default,,0,0,0,,Мен жеңдім.
Dialogue: 0,0:24:08.15,0:24:10.15,Default,,0,0,0,,~♪
Dialogue: 0,0:24:11.65,0:24:17.65,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory