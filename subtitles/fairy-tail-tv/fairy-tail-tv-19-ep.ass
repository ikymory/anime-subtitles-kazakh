Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.04,0:00:03.43,Default,,0,0,0,,Барлығы теледидар алдында
Dialogue: 0,0:00:03.78,0:00:05.21,Default,,0,0,0,,«Fairy Tail» фильмін көргенде
Dialogue: 0,0:00:05.39,0:00:06.60,Default,,0,0,0,,Бөлмені жарықтандырыңыз
Dialogue: 0,0:00:07.00,0:00:08.91,Default,,0,0,0,,Теледидардан алыстап, оны қараңыз.
Dialogue: 0,0:00:15.47,0:00:17.99,Default,,0,0,0,,Фуиор патшалығы
Dialogue: 0,0:00:18.26,0:00:22.25,Default,,0,0,0,,Адамдар өмірінде сиқырдың тамыры бар әлем
Dialogue: 0,0:00:22.39,0:00:23.86,Default,,0,0,0,,Ах. Күндізгі бөлімде оқитындар туралы айтсақ, балаларды ұрлау да жиі кездесетін жайт сияқты.
Dialogue: 0,0:00:24.30,0:00:28.47,Default,,0,0,0,,Менің сендерге көрсететін нәрсем өте қорқынышты сиқыр.
Dialogue: 0,0:00:28.73,0:00:33.99,Default,,0,0,0,,Келесі отыз минут ішінде сіздің санаңыз денеңізді тастап кетеді.
Dialogue: 0,0:00:34.00,0:00:38.82,Default,,0,0,0,,Сол сиқырға қадам бас.
Dialogue: 0,0:02:21.13,0:02:22.65,Default,,0,0,0,,Шебер бар ма?
Dialogue: 0,0:02:23.30,0:02:25.69,Default,,0,0,0,,Қайтадан қош келдіңіз. Арал қалай болды?
Dialogue: 0,0:02:26.00,0:02:27.60,Default,,0,0,0,,Мен тіпті теңізде аздап жүздім.
Dialogue: 0,0:02:28.34,0:02:30.12,Default,,0,0,0,,Бұл одан алыс болды.
Dialogue: 0,0:02:30.52,0:02:33.69,Default,,0,0,0,,Эй Мира-сан, атмосфераны оқы.
Dialogue: 0,0:02:34.04,0:02:34.86,Default,,0,0,0,,Мастер
Dialogue: 0,0:02:35.13,0:02:38.69,Default,,0,0,0,,Кеңес мәжілістері немесе басқалары бар.
Dialogue: 0,0:02:39.04,0:02:40.52,Default,,0,0,0,,Мен кешеден бері даладамын.
Dialogue: 0,0:02:42.13,0:02:43.86,Default,,0,0,0,,Әзірге қауіпсіз
Dialogue: 0,0:02:43.95,0:02:47.17,Default,,0,0,0,,Жарайды, қарт қайтып келгенше олай болмайды.
Dialogue: 0,0:02:47.26,0:02:51.78,Default,,0,0,0,,Бір жақсысы, бізге тозақты әлі біраз уақыт көрудің қажеті жоқ.
Dialogue: 0,0:02:51.91,0:02:54.04,Default,,0,0,0,,Сонымен мен қандаймын?
Dialogue: 0,0:02:54.13,0:02:55.91,Default,,0,0,0,,А, мен қызықпын. А, мен қорқамын.
Dialogue: 0,0:02:55.95,0:02:58.43,Default,,0,0,0,,Бұл одан да қорқынышты, өйткені біз оның шын мәнінде не екенін білмейміз.
Dialogue: 0,0:02:58.69,0:03:00.34,Default,,0,0,0,,Тыныш болыңыз
Dialogue: 0,0:03:00.47,0:03:03.17,Default,,0,0,0,,Мақтар қашан оралады?
Dialogue: 0,0:03:03.65,0:03:06.52,Default,,0,0,0,,Иә, менің ойымша, уақыт келді.
Dialogue: 0,0:03:07.13,0:03:09.95,Default,,0,0,0,,Қожайын қайтып келе салысымен, мен дереу үкім шығарамын.
Dialogue: 0,0:03:10.21,0:03:13.17,Default,,0,0,0,,S класындағы квестке рұқсатсыз араласу қылмыс болып табылады.
Dialogue: 0,0:03:13.69,0:03:15.39,Default,,0,0,0,,Дайын болыңыз
Dialogue: 0,0:03:16.21,0:03:19.73,Default,,0,0,0,,Сондықтан ашулануға дайын болу керек.
Dialogue: 0,0:03:19.78,0:03:21.95,Default,,0,0,0,,Жарайды деп ойлаймын.
Dialogue: 0,0:03:22.34,0:03:25.69,Default,,0,0,0,,Әйтеуір, Нацу мен Грей шетке.
Dialogue: 0,0:03:25.82,0:03:31.30,Default,,0,0,0,,Люси-чанды аяймын.
Dialogue: 0,0:03:31.52,0:03:32.56,Default,,0,0,0,,Мен сені аяймын.
Dialogue: 0,0:03:32.73,0:03:33.39,Default,,0,0,0,,Жұмысшының мұқабасы
Dialogue: 0,0:03:33.52,0:03:35.52,Default,,0,0,0,,Сіз нені білдіреді?
Dialogue: 0,0:03:35.65,0:03:38.21,Default,,0,0,0,,Дұрыс, сен Нацумен бірге тұрмағаның жөн.
Dialogue: 0,0:03:38.30,0:03:39.86,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:03:39.86,0:03:41.26,Default,,0,0,0,,Мен айтқанымды айтып отырмын.
Dialogue: 0,0:03:41.78,0:03:43.95,Default,,0,0,0,,Атмосфераны қаншалықты жақсы оқи аласыз?
Dialogue: 0,0:03:44.56,0:03:47.26,Default,,0,0,0,,Ерлердің де жауапкершілікті алу тәсілі бар.
Dialogue: 0,0:03:47.65,0:03:50.65,Default,,0,0,0,,Еркек жаныңды көрсетейін.
Dialogue: 0,0:03:50.73,0:03:54.86,Default,,0,0,0,,Бұл жасырын. Неге бәрібір кірмейсің?
Dialogue: 0,0:03:55.08,0:03:57.95,Default,,0,0,0,,Сонда бұл көздер қандай?
Dialogue: 0,0:04:04.13,0:04:06.52,Default,,0,0,0,,Аа, менің біртүрлі өтінішім бар.
Dialogue: 0,0:04:06.69,0:04:08.08,Default,,0,0,0,,Не?
Dialogue: 0,0:04:08.08,0:04:09.60,Default,,0,0,0,,О, Нацу, үйге қош келдіңіз.
Dialogue: 0,0:04:09.73,0:04:13.26,Default,,0,0,0,,Аа, Локи, бұл хат.
Dialogue: 0,0:04:13.47,0:04:14.21,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:04:14.47,0:04:16.65,Default,,0,0,0,,Люси де оралды ма?
Dialogue: 0,0:04:16.69,0:04:19.12,Default,,0,0,0,,Бұл табиғи нәрсе, өйткені мен Нацу және оның достарымен бірге жүрдім.
Dialogue: 0,0:04:19.39,0:04:21.12,Default,,0,0,0,,Неге сонша қорқасың?
Dialogue: 0,0:04:21.21,0:04:22.56,Default,,0,0,0,,Жоқ
Dialogue: 0,0:04:22.95,0:04:26.69,Default,,0,0,0,,Балалар, қазір олай емес.
Dialogue: 0,0:04:27.08,0:04:27.95,Default,,0,0,0,,Тым әлсіз
Dialogue: 0,0:04:28.00,0:04:29.65,Default,,0,0,0,,Шулы ғой, солай емес пе?
Dialogue: 0,0:04:29.73,0:04:31.99,Default,,0,0,0,,Сиқырлы топырақ бәрібір ғажап.
Dialogue: 0,0:04:32.34,0:04:33.21,Default,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,0:04:33.60,0:04:36.04,Default,,0,0,0,,Осы кейіпкердің мағынасын түсіндіріңіз.
Dialogue: 0,0:04:36.08,0:04:38.52,Default,,0,0,0,,Егер сіз оны шешсеңіз, мен сізге 500 000 Дж беремін.
Dialogue: 0,0:04:38.69,0:04:40.91,Default,,0,0,0,,Уау, бұл керемет, 500 000.
Dialogue: 0,0:04:41.00,0:04:41.73,Default,,0,0,0,,Ай
Dialogue: 0,0:04:42.04,0:04:44.08,Default,,0,0,0,,Әріптердің мағынасын таба аласыз ба?
Dialogue: 0,0:04:44.08,0:04:45.82,Default,,0,0,0,,Бұл әдеттен тыс сұрау.
Dialogue: 0,0:04:45.82,0:04:48.12,Default,,0,0,0,,Бұл көне жазу емес пе?
Dialogue: 0,0:04:48.13,0:04:50.12,Default,,0,0,0,,Мұны кім оқи алады?
Dialogue: 0,0:04:50.13,0:04:52.21,Default,,0,0,0,,Бірақ оның жанында заманауи аудармасы бар.
Dialogue: 0,0:04:52.26,0:04:54.08,Default,,0,0,0,,Сондықтан мен саған тоқтауыңды айтып тұрмын.
Dialogue: 0,0:04:54.13,0:04:56.04,Default,,0,0,0,,О, мен оны оқи аламын.
Dialogue: 0,0:04:56.17,0:04:57.17,Default,,0,0,0,,Не?
Dialogue: 0,0:04:57.69,0:05:00.30,Default,,0,0,0,,Ugo ter rasti borokaniya
Dialogue: 0,0:05:01.56,0:05:03.52,Default,,0,0,0,,Мен мүлде түсінбеймін
Dialogue: 0,0:05:09.82,0:05:10.39,Default,,0,0,0,,Бұл не, Аля?
Dialogue: 0,0:05:10.39,0:05:14.30,Default,,0,0,0,,Ей, адам жазасынан қорқып шыдай алмай жүргенде.
Dialogue: 0,0:05:14.47,0:05:16.04,Default,,0,0,0,,Кемпірқосақ бола ма?
Dialogue: 0,0:05:16.08,0:05:17.39,Default,,0,0,0,,Бірдеңе дұрыс емес.
Dialogue: 0,0:05:23.82,0:05:24.91,Default,,0,0,0,,Барлығы дүрбелеңде.
Dialogue: 0,0:05:25.13,0:05:27.86,Default,,0,0,0,,А, мұз пайдаланушылар неге сонша суық?
Dialogue: 0,0:05:29.00,0:05:32.65,Default,,0,0,0,,Бұл не? Менің денемнің ортасы өте суық.
Dialogue: 0,0:05:34.52,0:05:39.52,Default,,0,0,0,,Ауыр бірдеңе Кеудемді бірдеңе ауыр сезініп тұр
Dialogue: 0,0:05:39.52,0:05:41.82,Default,,0,0,0,,Белге келу
Dialogue: 0,0:05:41.95,0:05:42.86,Default,,0,0,0,,Люси не болды?
Dialogue: 0,0:05:43.00,0:05:45.04,Default,,0,0,0,,Дауысыңыз өте төмен.
Dialogue: 0,0:05:45.13,0:05:46.47,Default,,0,0,0,,Нацу осындай нәрсе
Dialogue: 0,0:05:49.17,0:05:51.56,Default,,0,0,0,,Мен неге құладым?
Dialogue: 0,0:05:53.69,0:05:57.08,Default,,0,0,0,,Мен мұнда қалай тұрмын?
Dialogue: 0,0:06:00.95,0:06:03.43,Default,,0,0,0,,Эй Нацу сен менің бетімді көріп неге қаштың?
Dialogue: 0,0:06:03.65,0:06:05.47,Default,,0,0,0,,О, бұл қандай дауыс?
Dialogue: 0,0:06:05.82,0:06:08.82,Default,,0,0,0,,Әдеттегі үлгіде басқа нәрсе бар.
Dialogue: 0,0:06:09.00,0:06:11.34,Default,,0,0,0,,Жер бетінде нені ұстап тұрсың?
Dialogue: 0,0:06:13.21,0:06:16.82,Default,,0,0,0,,Уау, Нацу, мынаны қара, Нацу.
Dialogue: 0,0:06:16.82,0:06:17.99,Default,,0,0,0,,Не?
Dialogue: 0,0:06:18.30,0:06:19.82,Default,,0,0,0,,Цука Мен ештеңе көрмеймін.
Dialogue: 0,0:06:19.82,0:06:23.04,Default,,0,0,0,,Оның кеудесінде екі әдемі кеудесі бар.
Dialogue: 0,0:06:23.39,0:06:24.34,Default,,0,0,0,,Қара, қара!
Dialogue: 0,0:06:27.00,0:06:28.39,Default,,0,0,0,,Тоқтатылды
Dialogue: 0,0:06:29.52,0:06:31.43,Default,,0,0,0,,Бұл соншалықты ауыртпайды.
Dialogue: 0,0:06:32.60,0:06:34.99,Default,,0,0,0,,Бұл мысық тәрізді дене пішіні қандай?
Dialogue: 0,0:06:35.04,0:06:37.43,Default,,0,0,0,,Дәлірек айтқанда, бұл мысықтың өзі.
Dialogue: 0,0:06:37.56,0:06:39.78,Default,,0,0,0,,Менің оны ауыстыратын ойым жоқ.
Dialogue: 0,0:06:40.04,0:06:42.52,Default,,0,0,0,,Такку тынышталып, ішуді доғар
Dialogue: 0,0:06:42.60,0:06:44.56,Default,,0,0,0,,Сиқыр өте керемет.
Dialogue: 0,0:06:44.60,0:06:45.43,Default,,0,0,0,,Мұнда және мұнда
Dialogue: 0,0:06:45.60,0:06:48.78,Default,,0,0,0,,Бұл не болды? Сондай суық.
Dialogue: 0,0:06:48.78,0:06:51.95,Default,,0,0,0,,Неліктен мұнда дәл мен сияқты адам бар?
Dialogue: 0,0:06:51.95,0:06:53.26,Default,,0,0,0,,Әй, сен не айтып тұрсың?
Dialogue: 0,0:06:53.39,0:06:54.86,Default,,0,0,0,,Сіз әлі байқамадыңыз ба?
Dialogue: 0,0:06:55.08,0:06:59.04,Default,,0,0,0,,Біздің ойымыз бен денеміз ауыстырылды
Dialogue: 0,0:07:01.60,0:07:03.30,Default,,0,0,0,,Бақытты дегенің не?
Dialogue: 0,0:07:03.34,0:07:04.91,Default,,0,0,0,,Мен Эльзамын
Dialogue: 0,0:07:05.56,0:07:07.39,Default,,0,0,0,,Бақытты - ақымақ
Dialogue: 0,0:07:07.43,0:07:08.39,Default,,0,0,0,,Локи қорқынышты
Dialogue: 0,0:07:08.52,0:07:09.78,Default,,0,0,0,,Жарайды, осы ғана. Абай бол.
Dialogue: 0,0:07:09.91,0:07:10.39,Default,,0,0,0,,онда Әйел Титанның ішіндегі адам қазір
Dialogue: 0,0:07:11.56,0:07:13.21,Default,,0,0,0,,Нацу мен Локи Грей және Люси
Dialogue: 0,0:07:13.60,0:07:17.47,Default,,0,0,0,,Және күткендей, Бақыт екеуміз орын ауыстырдық.
Dialogue: 0,0:07:19.30,0:07:21.47,Default,,0,0,0,,Не болды?
Dialogue: 0,0:07:21.60,0:07:27.12,Default,,0,0,0,,Ежелгі Umpellan сиқырлы Changelink сөзі іске қосылды.
Dialogue: 0,0:07:27.17,0:07:27.99,Default,,0,0,0,,Ах! Джибрил, қайдан шығып қалдың?
Dialogue: 0,0:07:28.34,0:07:29.21,Default,,0,0,0,,Қария
Dialogue: 0,0:07:29.65,0:07:32.04,Default,,0,0,0,,Бұл сұрау формасы себеп болып табылады.
Dialogue: 0,0:07:32.04,0:07:33.91,Default,,0,0,0,,Белгілі бір емлені дауыстап оқығанда
Dialogue: 0,0:07:33.95,0:07:37.99,Default,,0,0,0,,Айналадағы адамдардың мінездері өзгереді.
Dialogue: 0,0:07:40.21,0:07:40.60,Default,,0,0,0,,Бұл өзгертуші.
Dialogue: 0,0:07:40.65,0:07:41.86,Default,,0,0,0,,Өзгерту?
Dialogue: 0,0:07:41.86,0:07:43.73,Default,,0,0,0,,Сен кімсің, Нацу?
Dialogue: 0,0:07:43.82,0:07:44.56,Default,,0,0,0,,О
Dialogue: 0,0:07:44.73,0:07:47.17,Default,,0,0,0,,Эй, сен не істедің?
Dialogue: 0,0:07:47.17,0:07:50.47,Default,,0,0,0,,Сіз білесіз бе? Сіз жаңа ғана сұрау формасын оқыдыңыз ба?
Dialogue: 0,0:07:50.56,0:07:52.95,Default,,0,0,0,,Екі, дәл менің алдымда кел.
Dialogue: 0,0:07:53.13,0:07:55.30,Default,,0,0,0,,Неге тоқтамайсың, Люси? Жоқ, Грей.
Dialogue: 0,0:07:55.39,0:07:57.86,Default,,0,0,0,,Бұл заклинание тек тұлға ғана емес.
Dialogue: 0,0:07:57.86,0:07:58.65,Default,,0,0,0,,Иә
Dialogue: 0,0:07:59.00,0:08:00.82,Default,,0,0,0,,Жын шығару да ауыстырылады.
Dialogue: 0,0:08:05.21,0:08:08.91,Default,,0,0,0,,Ыстық Ішіңде магма бар сияқты
Dialogue: 0,0:08:09.69,0:08:12.95,Default,,0,0,0,,Эй, менімен кешкі ас ішуді қалайсың ба?
Dialogue: 0,0:08:15.08,0:08:19.43,Default,,0,0,0,,Ой, бұл не?
Dialogue: 0,0:08:19.69,0:08:22.04,Default,,0,0,0,,Соңында...
Dialogue: 0,0:08:22.82,0:08:28.12,Default,,0,0,0,,Заклинание өзгертуші оны жасағаннан кейін 30 минут ішінде жойылуы керек.
Dialogue: 0,0:08:28.26,0:08:34.04,Default,,0,0,0,,Заттар ешқашан бұрынғы қалпына келмейді деген аңыз бар.
Dialogue: 0,0:08:36.00,0:08:38.39,Default,,0,0,0,,Содан бері неше минут өтті?
Dialogue: 0,0:08:38.39,0:08:40.47,Default,,0,0,0,,Он алты минут, он төрт минут қалды.
Dialogue: 0,0:08:43.60,0:08:46.52,Default,,0,0,0,,Ата, сиқырды жою
Dialogue: 0,0:08:46.56,0:08:49.26,Default,,0,0,0,,Иә, өйткені бұл ежелгі сиқыр.
Dialogue: 0,0:08:49.78,0:08:52.26,Default,,0,0,0,,Мен бұл туралы бұрыннан білмеймін.
Dialogue: 0,0:08:52.82,0:08:53.86,Default,,0,0,0,,1-A сыныбы 1-B сыныбына қарсы—
Dialogue: 0,0:08:54.91,0:08:58.99,Default,,0,0,0,,Менің ойымша, ол S-класты Куэфтті жеңуді асыға күтті.
Dialogue: 0,0:08:59.34,0:09:02.04,Default,,0,0,0,,Мен бұл туралы ештеңе істей алмаймын.
Dialogue: 0,0:09:02.17,0:09:04.95,Default,,0,0,0,,Жарайды, бар күшіңді салу керек.
Dialogue: 0,0:09:05.26,0:09:08.12,Default,,0,0,0,,Неліктен? Иә, егер бұл орын алса.
Dialogue: 0,0:09:09.08,0:09:11.86,Default,,0,0,0,,Эй, мұны тоқтат.
Dialogue: 0,0:09:11.91,0:09:14.30,Default,,0,0,0,,Көрдім, іші сұр.
Dialogue: 0,0:09:14.39,0:09:16.39,Default,,0,0,0,,Киімді шешу әдеті бұрынғысынша.
Dialogue: 0,0:09:16.69,0:09:17.39,Default,,0,0,0,,Демек, шынымен де мұнда жартылай жұмыс істеуді бастапсың ғой.
Dialogue: 0,0:09:17.52,0:09:19.12,Default,,0,0,0,,Сізді не бақытты етеді?
Dialogue: 0,0:09:19.30,0:09:21.82,Default,,0,0,0,,Қызық көрінеді, мен байқап көрейін.
Dialogue: 0,0:09:22.56,0:09:23.12,Default,,0,0,0,,Айтпақшы, Венецияға жеткеннен кейін нұсқауларың аяқталады.»
Dialogue: 0,0:09:23.39,0:09:26.99,Default,,0,0,0,,Ауыстырылатын ауыстыру майлағышы да ауыстырылды
Dialogue: 0,0:09:34.73,0:09:35.86,Default,,0,0,0,,Жоғары
Dialogue: 0,0:09:40.30,0:09:42.56,Default,,0,0,0,,О, бұл да тамаша
Dialogue: 0,0:09:42.87,0:09:44.34,Default,,0,0,0,,Оларды мына жерге ыстық шоколадпен қойып кетейін, жарай ма?
Dialogue: 0,0:09:47.21,0:09:51.69,Default,,0,0,0,,Сіз нені айтасыз? Менің мақтанышым S сыныпты сиқыршы...
Dialogue: 0,0:09:51.91,0:09:55.69,Default,,0,0,0,,Бұл біртүрлі, мен оны керемет сауыт жасауды жоспарладым.
Dialogue: 0,0:09:55.82,0:09:58.47,Default,,0,0,0,,Жарайды, бірақ сиқыр өзгереді.
Dialogue: 0,0:09:58.65,0:10:00.73,Default,,0,0,0,,Бұл жарымжан болады.
Dialogue: 0,0:10:00.82,0:10:03.47,Default,,0,0,0,,Эй, бұл Локи емес, ішіндегі жігіт.
Dialogue: 0,0:10:03.56,0:10:05.78,Default,,0,0,0,,Мені іштегі жігіт деп айтпа. Бұл не?
Dialogue: 0,0:10:05.87,0:10:08.04,Default,,0,0,0,,Сіздің сиқырыңыз қалай жасалады?
Dialogue: 0,0:10:08.08,0:10:11.99,Default,,0,0,0,,Дұрыс. Оның қалай болатынын көрейік.
Dialogue: 0,0:10:12.73,0:10:16.04,Default,,0,0,0,,Мен білмеймін. Мен ештеңе сезбеймін. Ештеңе болмайды.
Dialogue: 0,0:10:16.26,0:10:18.12,Default,,0,0,0,,Екі, мен бірдеңеден шатасып кеттім.
Dialogue: 0,0:10:18.21,0:10:19.21,Default,,0,0,0,,О
Dialogue: 0,0:10:19.34,0:10:21.69,Default,,0,0,0,,Бұл қандай ауыр сезім?
Dialogue: 0,0:10:21.78,0:10:23.73,Default,,0,0,0,,Біреу бірдеңе істеуін өтінемін
Dialogue: 0,0:10:25.43,0:10:27.69,Default,,0,0,0,,Бұл жалында не бар? Бұл көбірек ағып жатыр.
Dialogue: 0,0:10:27.82,0:10:29.91,Default,,0,0,0,,Шынында да, бұл өте жарымжан.
Dialogue: 0,0:10:30.43,0:10:34.43,Default,,0,0,0,,О, түсіндім. Аспанда ұшқанда осындай сезім бар ма?
Dialogue: 0,0:10:34.43,0:10:37.82,Default,,0,0,0,,This is not the time to be convinced. Уақыт жоқ.
Dialogue: 0,0:10:38.56,0:10:41.26,Default,,0,0,0,,What on earth should I do?
Dialogue: 0,0:10:41.91,0:10:44.26,Default,,0,0,0,,Грей емес, Люси
Dialogue: 0,0:10:44.26,0:10:45.17,Default,,0,0,0,,Ауыздан шыққан мұз
Dialogue: 0,0:10:46.08,0:10:48.17,Default,,0,0,0,,I don't like it anymore
Dialogue: 0,0:10:48.17,0:10:50.26,Default,,0,0,0,,Lu-chan, leave it to me.
Dialogue: 0,0:10:53.52,0:10:54.69,Default,,0,0,0,,Леви-чан
Dialogue: 0,0:11:02.60,0:11:03.47,Default,,0,0,0,,Леви
Dialogue: 0,0:11:04.21,0:11:06.86,Default,,0,0,0,,Now that we have Team Shadow Gear,
Dialogue: 0,0:11:06.95,0:11:08.82,Default,,0,0,0,,I'll definitely put it back together.
Dialogue: 0,0:11:08.95,0:11:10.99,Default,,0,0,0,,О, уайымдама.
Dialogue: 0,0:11:11.13,0:11:13.47,Default,,0,0,0,,Өтінемін, Леви.
Dialogue: 0,0:11:13.65,0:11:17.13,Default,,0,0,0,,Басқаша айтқанда, леуіліктермен бірдеңе жасаңыз.
Dialogue: 0,0:11:17.91,0:11:19.69,Default,,0,0,0,,Thank you, Levy-chan
Dialogue: 0,0:11:19.87,0:11:21.30,Default,,0,0,0,,It's for Lou-chan.
Dialogue: 0,0:11:21.39,0:11:22.26,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе
Dialogue: 0,0:11:22.60,0:11:26.34,Default,,0,0,0,,Себебі мен Лу-чанның романдарының бірінші оқырманы болғым келеді.
Dialogue: 0,0:11:27.26,0:11:28.47,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:11:30.08,0:11:32.69,Default,,0,0,0,,Баяғыда мен көне жазу туралы аз білдім.
Dialogue: 0,0:11:32.78,0:11:35.91,Default,,0,0,0,,Алдымен сұрау пішініндегі мәтінді тексеріңіз.
Dialogue: 0,0:11:36.04,0:11:37.82,Default,,0,0,0,,There's no time, I'll make it in time
Dialogue: 0,0:11:38.43,0:11:39.39,Default,,0,0,0,,Қалай болғанда да
Dialogue: 0,0:11:39.87,0:11:41.86,Default,,0,0,0,,Leave this to Levy.
Dialogue: 0,0:11:43.21,0:11:45.86,Default,,0,0,0,,Why should I fish?
Dialogue: 0,0:11:46.04,0:11:47.21,Default,,0,0,0,,Жолсыз жерлерге арналған көлік қолайлырақ болар еді, білесің бе?
Dialogue: 0,0:11:53.02,0:11:55.60,Default,,0,0,0,,Ugo del
Dialogue: 0,0:11:55.91,0:11:57.91,Default,,0,0,0,,There's only about ten minutes left.
Dialogue: 0,0:12:00.17,0:12:03.52,Default,,0,0,0,,Менің ойымша, Леви мәтінді оқып шығуға жарай ма?
Dialogue: 0,0:12:03.60,0:12:07.86,Default,,0,0,0,,Егер сіз осы көне сиқырларды дауыстап оқымасаңыз, жақсы.
Dialogue: 0,0:12:07.91,0:12:09.78,Default,,0,0,0,,Well, I guess it's time.
Dialogue: 0,0:12:09.87,0:12:11.56,Default,,0,0,0,,Бұлыңғыр сезім
Dialogue: 0,0:12:11.73,0:12:14.73,Default,,0,0,0,,Мәңгі осылай қалса, жаман болады.
Dialogue: 0,0:12:14.95,0:12:16.65,Default,,0,0,0,,Маған ұнады.
Dialogue: 0,0:12:16.65,0:12:17.65,Default,,0,0,0,,Чиу уақыты
Dialogue: 0,0:12:17.78,0:12:19.78,Default,,0,0,0,,Неліктен тоқтамайсыз, себебі бұл бір өзгеріс?
Dialogue: 0,0:12:23.26,0:12:24.52,Default,,0,0,0,,What do you think, Levy-chan?
Dialogue: 0,0:12:25.21,0:12:26.47,Default,,0,0,0,,Did you understand anything?
Dialogue: 0,0:12:27.95,0:12:29.17,Default,,0,0,0,,Маған сән журналының түсірілімінде қолданылған осы киімді берді
Dialogue: 0,0:12:30.65,0:12:35.73,Default,,0,0,0,,Ендеше, бұдан былай мен біртүрлі қанатты мысық болып өмір сүретін боламын.
Dialogue: 0,0:12:35.91,0:12:37.78,Default,,0,0,0,,We're not strange.
Dialogue: 0,0:12:40.82,0:12:42.17,Default,,0,0,0,,Сондықтан тоқтатыңыз.
Dialogue: 0,0:12:42.78,0:12:43.99,Default,,0,0,0,,Моямоя
Dialogue: 0,0:12:44.04,0:12:46.26,Default,,0,0,0,,Can I never date again?
Dialogue: 0,0:12:46.43,0:12:48.08,Default,,0,0,0,,I want to switch places too.
Dialogue: 0,0:12:48.30,0:12:50.95,Default,,0,0,0,,Иә, иә, сен Макаоның ұлысың ғой.
Dialogue: 0,0:12:51.52,0:12:54.95,Default,,0,0,0,,Ал, бәрі тынышталсын, мен бұл туралы көбірек ойланамын.
Dialogue: 0,0:12:55.13,0:12:56.73,Default,,0,0,0,,Макао Сағат нешеде?
Dialogue: 0,0:12:56.73,0:12:57.78,Default,,0,0,0,,Бар болғаны 8 минут
Dialogue: 0,0:12:58.13,0:13:00.78,Default,,0,0,0,,It's about time for the belly to swell.
Dialogue: 0,0:13:01.39,0:13:02.86,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:13:05.73,0:13:08.91,Default,,0,0,0,,Ле Ле Леви
Dialogue: 0,0:13:09.30,0:13:11.86,Default,,0,0,0,,Олар тек көмекші қызметкерлер ме?
Dialogue: 0,0:13:12.08,0:13:16.39,Default,,0,0,0,,Шыға, сыртқа, ау, міне, солай.
Dialogue: 0,0:13:19.39,0:13:22.21,Default,,0,0,0,,Мәңгі осылай қалса не болады?
Dialogue: 0,0:13:22.95,0:13:24.13,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:13:24.30,0:13:27.47,Default,,0,0,0,,Сіз бұдан былай осылай жұмыс істеуді жоспарлап отырсыз ба?
Dialogue: 0,0:13:27.82,0:13:31.52,Default,,0,0,0,,Мұның жалғыз жолы – артқа қайтпай жалқаулықпен істеу.
Dialogue: 0,0:13:31.56,0:13:33.60,Default,,0,0,0,,Менің ойымша, бұл жақсы.
Dialogue: 0,0:13:33.69,0:13:37.08,Default,,0,0,0,,Өйткені үндемесең, қарап қана түсінбейсің.
Dialogue: 0,0:13:37.34,0:13:38.17,Default,,0,0,0,,Эй
Dialogue: 0,0:13:38.60,0:13:40.99,Default,,0,0,0,,That's not the problem.
Dialogue: 0,0:13:41.00,0:13:42.43,Default,,0,0,0,,Бұл суттака мысық
Dialogue: 0,0:13:42.43,0:13:46.47,Default,,0,0,0,,Мен мұны ешқашан жасамас едім
Dialogue: 0,0:13:46.60,0:13:50.13,Default,,0,0,0,,Сұр Уайымдама, Люси, бұл өте керемет.
Dialogue: 0,0:13:50.17,0:13:53.86,Default,,0,0,0,,Бірақ мен сені жақсы көретіндіктен, аузымнан мұндай бірдеңе шығуына жол жоқ.
Dialogue: 0,0:13:55.00,0:13:58.08,Default,,0,0,0,,What's wrong, it's not Gray but Lucy?
Dialogue: 0,0:13:58.21,0:14:04.04,Default,,0,0,0,,Бұл үлкен мәселе, өйткені қазір бәріміз бұған жартылай күйіп қалдық.
Dialogue: 0,0:14:04.04,0:14:07.30,Default,,0,0,0,,Бұлай болса, жұмысқа барсаң да жақсы болмайды.
Dialogue: 0,0:14:08.04,0:14:14.30,Default,,0,0,0,,Бұл біз қазір Fairy Tail ойынындағы ең әлсіз топ екенімізді білдіреді.
Dialogue: 0,0:14:14.60,0:14:16.17,Default,,0,0,0,,Кеттік, Бақытты
Dialogue: 0,0:14:16.21,0:14:18.43,Default,,0,0,0,,Мұз жасау
Dialogue: 0,0:14:18.60,0:14:21.08,Default,,0,0,0,,Open some kind of door
Dialogue: 0,0:14:21.43,0:14:24.26,Default,,0,0,0,,Аспанда ұшу да қызық.
Dialogue: 0,0:14:26.73,0:14:30.47,Default,,0,0,0,,Бұл қауіпті. Олай десеңіз, бұл өте қауіпті.
Dialogue: 0,0:14:30.56,0:14:34.65,Default,,0,0,0,,Неліктен осы уақытқа дейін қарапайым нәрсені түсінбедім?
Dialogue: 0,0:14:34.87,0:14:37.65,Default,,0,0,0,,Бәлкім, мысыққа айналғанымнан ба?
Dialogue: 0,0:14:37.82,0:14:42.60,Default,,0,0,0,,Бұл қорқынышты. Ол ауыстырылғаннан бері Эльза әрқашан тікен болды.
Dialogue: 0,0:14:47.00,0:14:50.47,Default,,0,0,0,,Енді не істемекші едің, Эльза, Бақыт?
Dialogue: 0,0:14:50.65,0:14:52.65,Default,,0,0,0,,Өйткені маған қорқынышты сөздер айтылды
Dialogue: 0,0:14:52.69,0:14:56.56,Default,,0,0,0,,Әй, мұнда шық! Мен ұшып кетуге тырыстым.
Dialogue: 0,0:14:56.60,0:15:00.86,Default,,0,0,0,,Одан соң қауырсын ұшты, қанат ұшты, мен құладым.
Dialogue: 0,0:15:01.04,0:15:05.34,Default,,0,0,0,,It was my fault, please step back.
Dialogue: 0,0:15:06.17,0:15:06.91,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:15:07.65,0:15:09.91,Default,,0,0,0,,Жарайды, сиқыр бұзылды.
Dialogue: 0,0:15:10.69,0:15:11.52,Default,,0,0,0,,Алым
Dialogue: 0,0:15:11.82,0:15:13.13,Default,,0,0,0,,Бұл көне жазу
Dialogue: 0,0:15:13.43,0:15:18.39,Default,,0,0,0,,«Бұл жерде мәңгілік орын алып, бақыт әкел» дегенді білдіре ме?
Dialogue: 0,0:15:18.43,0:15:20.30,Default,,0,0,0,,Ия, Леви-чан керемет
Dialogue: 0,0:15:20.34,0:15:24.21,Default,,0,0,0,,Осы жерде мәңгілік алмасу болып, бақытқа кенелейік
Dialogue: 0,0:15:26.04,0:15:26.91,Default,,0,0,0,,Міне
Dialogue: 0,0:15:27.00,0:15:29.65,Default,,0,0,0,,Басқаша айтқанда, сиқыры ауыстырылған бұл адамдар
Dialogue: 0,0:15:29.65,0:15:32.47,Default,,0,0,0,,Бұл сіз бақытты өмір сүре аласыз дегенді білдіре ме?
Dialogue: 0,0:15:32.47,0:15:34.52,Default,,0,0,0,,Күрсін, мен оны шешкеніме қуаныштымын.
Dialogue: 0,0:15:35.91,0:15:39.60,Default,,0,0,0,,Бір секунд күтіңіз, бұл біз осылай қаламыз дегенді білдірмей ме?
Dialogue: 0,0:15:39.82,0:15:42.60,Default,,0,0,0,,Мен Леви, өтініш хаттың мағынасын енді ғана түсіндім.
Dialogue: 0,0:15:42.91,0:15:45.26,Default,,0,0,0,,Бұл рас. Не істеуім керек?
Dialogue: 0,0:15:45.26,0:15:47.78,Default,,0,0,0,,Леви-чан, сиқырды бұзу керек.
Dialogue: 0,0:15:47.82,0:15:51.86,Default,,0,0,0,,Қандай да бір жол, қандай да бір жасырын мағына немесе соған ұқсас нәрсе болуы керек.
Dialogue: 0,0:15:51.95,0:15:54.04,Default,,0,0,0,,Осыған назар аударыңыз.
Dialogue: 0,0:15:54.30,0:15:55.86,Default,,0,0,0,,Қатты жүгіру
Dialogue: 0,0:15:57.08,0:15:59.86,Default,,0,0,0,,Лех алым
Dialogue: 0,0:16:01.04,0:16:03.91,Default,,0,0,0,,Көңіл көтеру тобы өте шулы емес пе?
Dialogue: 0,0:16:03.91,0:16:06.34,Default,,0,0,0,,No, I think it's good to have a presence.
Dialogue: 0,0:16:06.47,0:16:08.30,Default,,0,0,0,,Мен де қатыстым.
Dialogue: 0,0:16:08.34,0:16:09.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:12.74,0:16:15.65,Default,,0,0,0,,Жоқ, мұның мағынасы жоқ.
Dialogue: 0,0:16:15.69,0:16:17.60,Default,,0,0,0,,Дәлірек айтсақ, бұл сөзбен айтылмаған.
Dialogue: 0,0:16:18.78,0:16:20.08,Default,,0,0,0,,3 минут қалды
Dialogue: 0,0:16:20.13,0:16:21.26,Default,,0,0,0,,Жоқ, бір
Dialogue: 0,0:16:22.34,0:16:24.73,Default,,0,0,0,,Бұл балық па? Бүгіннен бастап күн сайын
Dialogue: 0,0:16:24.87,0:16:29.34,Default,,0,0,0,,Таңертеңгі түскі түн Бұл балық па?
Dialogue: 0,0:16:29.82,0:16:33.52,Default,,0,0,0,,Мысықтың ойнағанын көргенде өзіңізді бақытты сезінесіз бе?
Dialogue: 0,0:16:33.56,0:16:35.95,Default,,0,0,0,,Сабыр ет, қуанба, Эльза.
Dialogue: 0,0:16:36.43,0:16:39.73,Default,,0,0,0,,Эльза, бұл үшін кешірім сұраймын. Бұл менің кінәм болды.
Dialogue: 0,0:16:40.34,0:16:41.99,Default,,0,0,0,,Күйеу
Dialogue: 0,0:16:42.17,0:16:46.47,Default,,0,0,0,,Бұл ұрысатын уақыт емес. Жасалайық.
Dialogue: 0,0:16:46.52,0:16:49.21,Default,,0,0,0,,Иә, мен де жаман болдым.
Dialogue: 0,0:16:50.34,0:16:53.39,Default,,0,0,0,,Иә, бұл татуласудың белгісі.
Dialogue: 0,0:16:54.34,0:16:56.32,Default,,0,0,0,,Балық дегеніміз не?
Dialogue: 0,0:16:57.69,0:16:59.30,Default,,0,0,0,,Атмосфераны оқы
Dialogue: 0,0:16:59.65,0:17:00.82,Default,,0,0,0,,Төлем әлі бар ма?
Dialogue: 0,0:17:01.00,0:17:03.56,Default,,0,0,0,,Бұл өте жаман. Мен оны бір минутқа кесіп тастадым.
Dialogue: 0,0:17:03.78,0:17:07.43,Default,,0,0,0,,Неге алдымен өзіңнен ләззат алуды бастамайсың?
Dialogue: 0,0:17:07.69,0:17:08.30,Default,,0,0,0,,Ал... бұл дұрыс емес.
Dialogue: 0,0:17:09.69,0:17:13.47,Default,,0,0,0,,Маған сәл түсінікті болған сияқты.
Dialogue: 0,0:17:15.04,0:17:17.26,Default,,0,0,0,,Қолыңнан келгенін істе, қолыңнан келгенін істе, Леви
Dialogue: 0,0:17:17.47,0:17:18.82,Default,,0,0,0,,Жану!
Dialogue: 0,0:17:19.04,0:17:20.65,Default,,0,0,0,,Ол жігіт саған тым жақсы көрінеді
Dialogue: 0,0:17:20.65,0:17:22.78,Default,,0,0,0,,Эй, сен әлі істеп жатырсың ба?
Dialogue: 0,0:17:23.04,0:17:25.26,Default,,0,0,0,,Ата, есіңде бірдеңе жоқ па?
Dialogue: 0,0:17:25.30,0:17:26.86,Default,,0,0,0,,Дәл солай, біз...
Dialogue: 0,0:17:28.52,0:17:29.21,Default,,0,0,0,,Ах! Джибрил, қайдан шығып қалдың?
Dialogue: 0,0:17:30.52,0:17:33.13,Default,,0,0,0,,Жарайды...олай айтсаң да.
Dialogue: 0,0:17:33.91,0:17:36.30,Default,,0,0,0,,А... Мен уақытында үлгере алмаймын.
Dialogue: 0,0:17:36.95,0:17:40.04,Default,,0,0,0,,Сондықтан мен саған бұлай істеуді доғар деп айтып отырмын.
Dialogue: 0,0:17:40.08,0:17:41.13,Default,,0,0,0,,Беріңіз
Dialogue: 0,0:17:41.52,0:17:45.47,Default,,0,0,0,,Бұл дұрыс па білмеймін, бірақ 40 секунд қалды.
Dialogue: 0,0:17:45.60,0:17:47.60,Default,,0,0,0,,Мүмкін неге?
Dialogue: 0,0:17:47.65,0:17:50.08,Default,,0,0,0,,Эй, мен бірдеңені есіме түсірдім.
Dialogue: 0,0:17:50.08,0:17:50.95,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:17:51.30,0:17:55.69,Default,,0,0,0,,Біз бұл сиқырды бұзған кезде, мен оны бір уақытта тек бір топты бұза алатынымызға сенімдімін.
Dialogue: 0,0:17:55.82,0:17:58.82,Default,,0,0,0,,Барлығын бір минутта қайтару мүмкін емес еді.
Dialogue: 0,0:17:59.21,0:17:59.73,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:17:59.95,0:18:01.78,Default,,0,0,0,,Шамамен 30 секунд қалды
Dialogue: 0,0:18:02.21,0:18:02.73,Default,,0,0,0,,Қай жұп бірінші?
Dialogue: 0,0:18:03.78,0:18:06.30,Default,,0,0,0,,Әрине бұл мен және Локи. Сәлем Локи.
Dialogue: 0,0:18:06.34,0:18:07.04,Default,,0,0,0,,Иә.
Dialogue: 0,0:18:07.13,0:18:09.95,Default,,0,0,0,,Бұл жұмыс істемейді. Бірінші біз.
Dialogue: 0,0:18:10.17,0:18:13.99,Default,,0,0,0,,Тоқтай тұрыңыз, мен осылай мәңгі қалсам, Фейри Дейл не болады?
Dialogue: 0,0:18:14.04,0:18:16.08,Default,,0,0,0,,Алғашында сен маған риза болдың.
Dialogue: 0,0:18:16.17,0:18:17.78,Default,,0,0,0,,Маған бәрібір.
Dialogue: 0,0:18:17.87,0:18:18.52,Default,,0,0,0,,Бұл біз.
Dialogue: 0,0:18:19.30,0:18:20.13,Default,,0,0,0,,Ұсқынсыз
Dialogue: 0,0:18:20.21,0:18:22.60,Default,,0,0,0,,Адамдардың бұрышта қалуы қорқынышты.
Dialogue: 0,0:18:23.26,0:18:24.95,Default,,0,0,0,,Оған 15 секундтан аз уақыт кетті.
Dialogue: 0,0:18:24.95,0:18:26.69,Default,,0,0,0,,А, мен түсіндім.
Dialogue: 0,0:18:29.30,0:18:30.17,Default,,0,0,0,,Леви-чан
Dialogue: 0,0:18:30.43,0:18:33.26,Default,,0,0,0,,Бұл мағынаны білдіреді, сондықтан түсіндірейін.
Dialogue: 0,0:18:36.26,0:18:39.04,Default,,0,0,0,,Леви Мен кейінірек түсіндіремін. Асығыңыз.
Dialogue: 0,0:18:39.21,0:18:40.69,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,0:18:41.60,0:18:50.86,Default,,0,0,0,,Альборо Тесла Луги Го
Dialogue: 0,0:19:16.13,0:19:18.21,Default,,0,0,0,,A Бұл қалыпты жағдайға оралды.
Dialogue: 0,0:19:18.39,0:19:19.04,Default,,0,0,0,,Ха-ха-ха-ха! Бұл дәл сен сияқты, Лабраба.
Dialogue: 0,0:19:19.43,0:19:20.86,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:19:20.91,0:19:23.73,Default,,0,0,0,,Иә, қайтуға болады?
Dialogue: 0,0:19:23.87,0:19:25.65,Default,,0,0,0,,Леви-чанға рахмет
Dialogue: 0,0:19:25.65,0:19:26.43,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:26.69,0:19:29.30,Default,,0,0,0,,Ей, сені қолдауға тұрарлық болды.
Dialogue: 0,0:19:29.34,0:19:31.17,Default,,0,0,0,,Мұны қалай жасадыңыз? айтшы
Dialogue: 0,0:19:31.69,0:19:34.26,Default,,0,0,0,,Сөздердің өзі мағынасы жоқ.
Dialogue: 0,0:19:34.52,0:19:36.34,Default,,0,0,0,,Мен кері оқуға тырыстым.
Dialogue: 0,0:19:37.65,0:19:39.47,Default,,0,0,0,,Өйткені ерте заманда жазба сөздер аз болған.
Dialogue: 0,0:19:39.56,0:19:41.39,Default,,0,0,0,,Түрлі мағынаны жеткізгіңіз келгенде
Dialogue: 0,0:19:41.43,0:19:44.65,Default,,0,0,0,,Қарама-қарсы жақтан оқығанда басқаша әсер етеді.
Dialogue: 0,0:19:44.82,0:19:49.73,Default,,0,0,0,,Сонымен мен заклинанияны төңкеріп оқыдым, ал заклинание бұзылды.
Dialogue: 0,0:19:49.95,0:19:52.30,Default,,0,0,0,,Түсіндім, көп рахмет.
Dialogue: 0,0:19:52.43,0:19:54.04,Default,,0,0,0,,Көмегің үшін рахмет, Леви.
Dialogue: 0,0:19:54.52,0:19:56.00,Default,,0,0,0,,Бұл Лу-чанға арналған.
Dialogue: 0,0:19:57.47,0:19:58.95,Default,,0,0,0,,және шешілмеген
Dialogue: 0,0:20:00.74,0:20:02.86,Default,,0,0,0,,Мен де, мен әлі мысықпын.
Dialogue: 0,0:20:02.95,0:20:05.04,Default,,0,0,0,,Маған бәрібір.
Dialogue: 0,0:20:06.91,0:20:08.30,Default,,0,0,0,,Бұл кішкене айырмашылық.
Dialogue: 0,0:20:08.47,0:20:12.13,Default,,0,0,0,,Қалған екі топ уақыт шегін орындай алмады.
Dialogue: 0,0:20:12.13,0:20:15.21,Default,,0,0,0,,Бұл туралы не істеуім керек?
Dialogue: 0,0:20:15.21,0:20:17.08,Default,,0,0,0,,Леви, өтінемін, мұны да бір рет жасаңыз.
Dialogue: 0,0:20:17.43,0:20:20.95,Default,,0,0,0,,Мен шамалы қателік жібердім деп ойлаймын.
Dialogue: 0,0:20:22.78,0:20:25.30,Default,,0,0,0,,Сонымен, біз мәңгі осылай қаламыз ба?
Dialogue: 0,0:20:25.34,0:20:28.78,Default,,0,0,0,,Сіз осылай жалын жағасыз ба? Қандай жиіркенішті
Dialogue: 0,0:20:28.82,0:20:32.47,Default,,0,0,0,,Бұл қорқынышты түс. Бұл қорқынышты түстен басқа ештеңе емес.
Dialogue: 0,0:20:32.74,0:20:35.69,Default,,0,0,0,,Маған бәрібір.
Dialogue: 0,0:20:37.26,0:20:41.34,Default,,0,0,0,,Ал, басқа жолы бар шығар.
Dialogue: 0,0:20:42.39,0:20:47.04,Default,,0,0,0,,Не, мен қысқарған жоқпын ба?
Dialogue: 0,0:20:47.04,0:20:49.30,Default,,0,0,0,,А...жоқ, Мира-сан
Dialogue: 0,0:20:49.39,0:20:51.82,Default,,0,0,0,,Ата мен Мира ауыстырылды.
Dialogue: 0,0:20:52.26,0:20:54.26,Default,,0,0,0,,Әй, бұл әдемі дене.
Dialogue: 0,0:20:57.00,0:20:57.39,Default,,0,0,0,,Жоқ, бәрі осы.
Dialogue: 0,0:20:58.17,0:20:59.26,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:20:59.60,0:21:02.17,Default,,0,0,0,,Ер адам үшін маңызды нәрсе - бас тарту, Нацу.
Dialogue: 0,0:21:03.04,0:21:05.21,Default,,0,0,0,,Неліктен бұл қалыптан тыс дененің иісі спирт сияқты?
Dialogue: 0,0:21:05.91,0:21:08.95,Default,,0,0,0,,Не? Мен неге Эльфманмын?
Dialogue: 0,0:21:09.60,0:21:12.08,Default,,0,0,0,,Мен кенеттен есін жидым.
Dialogue: 0,0:21:13.56,0:21:14.69,Default,,0,0,0,,Сәлем Дрой
Dialogue: 0,0:21:15.43,0:21:16.52,Default,,0,0,0,,А, неге ұшады?
Dialogue: 0,0:21:17.13,0:21:19.47,Default,,0,0,0,,Бізді ауыстырды.
Dialogue: 0,0:21:19.82,0:21:22.65,Default,,0,0,0,,Балалар, сендерді ауыстырса, көп қиындық болмас еді.
Dialogue: 0,0:21:23.21,0:21:28.00,Default,,0,0,0,,Сонда да бұл пышақ денесі арман сияқты.
Dialogue: 0,0:21:28.21,0:21:30.13,Default,,0,0,0,,Жоқ, Леви, мен бірдеңе істеймін.
Dialogue: 0,0:21:38.17,0:21:41.13,Default,,0,0,0,,Бұл менің қолымнан келмейді.
Dialogue: 0,0:21:41.26,0:21:44.69,Default,,0,0,0,,Иә, барлығы ауыстырылды. Қызық.
Dialogue: 0,0:21:44.69,0:21:46.56,Default,,0,0,0,,Мен бұған риза емеспін.
Dialogue: 0,0:21:49.52,0:21:53.17,Default,,0,0,0,,Бұл фантастикалық сиқыр емес
Dialogue: 0,0:21:53.39,0:21:56.30,Default,,0,0,0,,Олар күнделікті өмірінің дәл қасында тұрады.
Dialogue: 0,0:21:56.39,0:21:59.73,Default,,0,0,0,,Сәл теңгерілмеген сиқыр
Dialogue: 0,0:21:59.87,0:22:02.43,Default,,0,0,0,,Келесі кездескенше
Dialogue: 0,0:22:03.26,0:22:05.21,Default,,0,0,0,,Болдырмау
Dialogue: 0,0:22:05.21,0:22:06.78,Default,,0,0,0,,Оны токтан ажырату жеткілікті ме?
Dialogue: 0,0:22:07.34,0:22:07.78,Default,,0,0,0,,Ай
Dialogue: 0,0:23:40.13,0:23:43.47,Default,,0,0,0,,Happy Sensei's Fefreetail курсы
Dialogue: 0,0:23:45.00,0:23:49.21,Default,,0,0,0,,Бүгін біз Fairy Tail 2 бөлімнің достарымен таныстырамыз
Dialogue: 0,0:23:49.47,0:23:53.34,Default,,0,0,0,,Гильдияның сиқырлы топырағы үшін сұраныс тақтасынан сүйікті жұмысыңызды таңдаңыз.
Dialogue: 0,0:23:53.34,0:23:54.69,Default,,0,0,0,,Мен жұмысқа барамын
Dialogue: 0,0:23:54.82,0:23:57.00,Default,,0,0,0,,Ки-Айра достарыңызбен топтасыңыз
Dialogue: 0,0:23:57.04,0:23:59.30,Default,,0,0,0,,Бірге шытырман оқиғаға барайық
Dialogue: 0,0:23:59.39,0:24:00.30,Default,,0,0,0,,Жоғары
Dialogue: 0,0:24:00.56,0:24:04.04,Default,,0,0,0,,Келесі кездескенше.
Dialogue: 0,0:24:06.69,0:24:09.65,Default,,0,0,0,,Эльзаның қуанғаны сонша, ол қатты толқыды
Dialogue: 0,0:24:09.87,0:24:13.08,Default,,0,0,0,,Иә, оның ұшу жолы да қауіпті болды.
Dialogue: 0,0:24:13.87,0:24:16.65,Default,,0,0,0,,Бұл маған Бақыттың туған кезін еске түсіреді.
Dialogue: 0,0:24:16.78,0:24:17.47,Default,,0,0,0,,Ай
Dialogue: 0,0:24:17.56,0:24:19.17,Default,,0,0,0,,Бірақ бұл іштей Эльза.
Dialogue: 0,0:24:19.21,0:24:23.26,Default,,0,0,0,,Мен 90% сүйкімділігімді көрсете алмадым.
Dialogue: 0,0:24:26.78,0:24:30.26,Default,,0,0,0,,Жоқ, туылғанда бақытты болу аздап қорқынышты болды.
Dialogue: 0,0:24:30.34,0:24:32.04,Default,,0,0,0,,Иә, бұл сүйкімді болуы керек еді.
Dialogue: 0,0:24:32.08,0:24:34.04,Default,,0,0,0,,Иә, бұл да сүйкімді киім.
Dialogue: 0,0:24:35.54,0:24:41.54,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory