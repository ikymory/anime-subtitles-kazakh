Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.85,0:00:06.71,Default,,0000,0000,0000,,<Фиор патшалығы.
Dialogue: 0,0:00:06.71,0:00:11.59,Default,,0000,0000,0000,,17 миллион халқы бар тұрақты бейтарап ел.
Dialogue: 0,0:00:11.59,0:00:13.29,Default,,0000,0000,0000,,Бұл сиқырлы әлем.
Dialogue: 0,0:00:13.29,0:00:20.68,Default,,0000,0000,0000,,Сиқыр әдетте сатып алынады және сатылды және адамдардың өмірінде терең тамыр жайды.
Dialogue: 0,0:00:20.68,0:00:24.73,Default,,0000,0000,0000,,Ал сол сиқырды толық пайдаланып күн көріп жатқандар бар.
Dialogue: 0,0:00:24.73,0:00:28.10,Default,,0000,0000,0000,,Адамдар оларды сиқыршылар деп атады.
Dialogue: 0,0:00:28.10,0:00:32.47,Default,,0000,0000,0000,,Сиқыршылар әртүрлі гильдияларға жатады→
Dialogue: 0,0:00:32.47,0:00:35.17,Default,,0000,0000,0000,,Сұраныс бойынша жұмысты орындау.
Dialogue: 0,0:00:35.17,0:00:38.54,Default,,0000,0000,0000,,Елде көптеген гильдиялар бар.
Dialogue: 0,0:00:38.54,0:00:43.09,Default,,0000,0000,0000,,Белгілі бір қалада сиқыршылар гильдиясы бар.
Dialogue: 0,0:00:43.09,0:00:51.33,Default,,0000,0000,0000,,Өткенде немесе тіпті болашақта көптеген аңыздарды жасаған гильдия.
Dialogue: 0,0:00:51.33,0:00:55.33,Default,,0000,0000,0000,,Оның аты... «Ертегі»>
Dialogue: 0,0:03:37.32,0:03:39.67,Default,,0000,0000,0000,,<Нацу: соңғы ретке дейін «ЕРтегі»>
Dialogue: 0,0:03:39.67,0:03:42.20,Default,,0000,0000,0000,,Неге Темимен біргесің! Онда келме!
Dialogue: 0,0:03:42.20,0:03:44.22,Default,,0000,0000,0000,,Екеуің маған күш-қуат беріңдер деп едім.
Dialogue: 0,0:03:44.22,0:03:46.58,Default,,0000,0000,0000,,Эйзенвальд?
Dialogue: 0,0:03:46.58,0:03:48.76,Default,,0000,0000,0000,,Олардың жоспарларын тоқтатыңыз.
Dialogue: 0,0:03:48.76,0:03:52.13,Default,,0000,0000,0000,,Нацу~! Апыр-ай!
Dialogue: 0,0:03:52.13,0:03:54.82,Default,,0000,0000,0000,,Қарғыс атқан сыбызғы... Бесік жыры!
Dialogue: 0,0:03:54.82,0:03:56.82,Default,,0000,0000,0000,,Ұстазға қауіп төніп тұр!
Dialogue: 0,0:03:58.37,0:04:01.23,Default,,0000,0000,0000,,Бесік жырының шынайы тұлғасы осы! ?
Dialogue: 0,0:04:01.23,0:04:03.59,Default,,0000,0000,0000,,Уау! Апыр-ай!
Dialogue: 0,0:04:03.59,0:04:05.27,Default,,0000,0000,0000,,Гяаах!
Dialogue: 0,0:04:05.27,0:04:08.13,Default,,0000,0000,0000,,Сіз тым көп істеп жатырсыз!
Dialogue: 0,0:04:08.13,0:04:12.50,Default,,0000,0000,0000,,Бұл белгі... бұған еш күмән жоқ.
Dialogue: 0,0:04:12.50,0:04:15.87,Default,,0000,0000,0000,,Бұл жолдан өткеніме екі күн болды.
Dialogue: 0,0:04:15.87,0:04:19.24,Default,,0000,0000,0000,,Магнолияға көптен келген жақсы уақыт.
Dialogue: 0,0:04:19.24,0:04:21.09,Default,,0000,0000,0000,,Бірдеңе болды ма?
Dialogue: 0,0:04:21.09,0:04:24.62,Default,,0000,0000,0000,,Әзірше есеп беруге қайта оралайық.
Dialogue: 0,0:04:24.62,0:04:26.62,Default,,0000,0000,0000,,Менің артымнан ермейсің бе?
Dialogue: 0,0:04:28.33,0:04:31.19,Default,,0000,0000,0000,,< Бұл әйел, Биска Мулан.
Dialogue: 0,0:04:31.19,0:04:34.39,Default,,0000,0000,0000,,Бұл адам - ​​Алзак Коннелл.
Dialogue: 0,0:04:34.39,0:04:38.77,Default,,0000,0000,0000,,Екеуі де ертегілер сиқыршылары>
Dialogue: 0,0:04:38.77,0:04:41.13,Default,,0000,0000,0000,,Иә... бұл мәселе.
Dialogue: 0,0:04:41.13,0:04:43.49,Default,,0000,0000,0000,,Мен кеңестен хабарлама алдым.
Dialogue: 0,0:04:43.49,0:04:46.34,Default,,0000,0000,0000,,Мен сізге еремін деп жоспарлап едім.
Dialogue: 0,0:04:46.34,0:04:51.39,Default,,0000,0000,0000,,Жоқ, жоқ. Үлкен Кловерден тыс→
Dialogue: 0,0:04:51.39,0:04:55.77,Default,,0000,0000,0000,,Тіпті ең тәжірибелі Аңшылар Гильдиясының аңшылары адасып қалса, шыға алмайды.
Dialogue: 0,0:04:55.77,0:05:00.15,Default,,0000,0000,0000,,Табиғат лабиринті... Ондай жерге неге бардың?
Dialogue: 0,0:05:00.15,0:05:02.84,Default,,0000,0000,0000,,Қандай да бір себеп болуы керек.
Dialogue: 0,0:05:02.84,0:05:05.84,Default,,0000,0000,0000,,Менің ойымша, бұл маңызды емес, өйткені бізде бір қожайын бар.
Dialogue: 0,0:05:18.17,0:05:21.69,Default,,0000,0000,0000,,Сәл бақытты! Сіз қайтадан адасып қалдыңыз! ?
Dialogue: 0,0:05:21.69,0:05:25.90,Default,,0000,0000,0000,,Қанша жүрсем де Магнолия қаласына жете алмаймын!
Dialogue: 0,0:05:25.90,0:05:27.59,Default,,0000,0000,0000,,Бұл мысықта бағытты сезінбейді!
Dialogue: 0,0:05:27.59,0:05:32.31,Default,,0000,0000,0000,,＜ Ежелгі жер сілкіністеріне байланысты мұнда сансыз жарықтық сызықтар өтеді →
Dialogue: 0,0:05:32.31,0:05:35.67,Default,,0000,0000,0000,,Жалпы атауы: Өрмекші ұя алқабы.
Dialogue: 0,0:05:35.67,0:05:37.52,Default,,0000,0000,0000,,Бұрын айтылғандай →
Dialogue: 0,0:05:37.52,0:05:41.72,Default,,0000,0000,0000,,Осы жерде қаңғып, қайтып оралмаған адам→
Dialogue: 0,0:05:41.72,0:05:44.42,Default,,0000,0000,0000,,Көп > бар дейді
Dialogue: 0,0:05:44.42,0:05:47.95,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:05:47.95,0:05:50.32,Default,,0000,0000,0000,,Осы уақыт ішінде мен адаспадым. Бұл менің бірінші рет.
Dialogue: 0,0:05:50.32,0:05:54.69,Default,,0000,0000,0000,,Бұл бірінші рет болса да, адасып кеткен болуыңыз керек.
Dialogue: 0,0:05:54.69,0:05:56.04,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:05:56.04,0:05:58.90,Default,,0000,0000,0000,,Менің қарным ашты.
Dialogue: 0,0:05:58.90,0:06:01.43,Default,,0000,0000,0000,,Айтпа. Мен одан да ашар едім.
Dialogue: 0,0:06:01.43,0:06:03.11,Default,,0000,0000,0000,,Азайған нәрсе азайды!
Dialogue: 0,0:06:03.11,0:06:05.97,Default,,0000,0000,0000,,Сондықтан төмендеді деп айтпаңыз!
Dialogue: 0,0:06:05.97,0:06:08.00,Default,,0000,0000,0000,,Әрине төмендеді.
Dialogue: 0,0:06:08.00,0:06:10.85,Default,,0000,0000,0000,,Сол себепті!
Dialogue: 0,0:06:10.85,0:06:12.04,Default,,0000,0000,0000,,Алыста.
Dialogue: 0,0:06:12.04,0:06:16.75,Default,,0000,0000,0000,,Мен қатты дыбыс естідім.
Dialogue: 0,0:06:16.75,0:06:18.43,Default,,0000,0000,0000,,Ол шырылдамайды. Бұл бос құлақ.
Dialogue: 0,0:06:18.43,0:06:20.79,Default,,0000,0000,0000,,Бұл керемет сылтау. Эй.
Dialogue: 0,0:06:20.79,0:06:23.98,Default,,0000,0000,0000,,Уау! Ах~!
Dialogue: 0,0:06:23.98,0:06:26.35,Default,,0000,0000,0000,,Нені шулатып жатырсың? Нацу Мынаны қара!
Dialogue: 0,0:06:26.35,0:06:28.35,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:06:32.23,0:06:35.60,Default,,0000,0000,0000,,Мифтік нәзіктік, қауырсынды балық!
Dialogue: 0,0:06:35.60,0:06:37.12,Default,,0000,0000,0000,,Бұл өте дәмді.
Dialogue: 0,0:06:37.12,0:06:39.48,Default,,0000,0000,0000,,Ммммммммм….
Dialogue: 0,0:06:39.48,0:06:42.34,Default,,0000,0000,0000,,Фантастикалық деликатес…. Қанатты балық....
Dialogue: 0,0:06:42.34,0:06:45.70,Default,,0000,0000,0000,,Дәмді көрінеді.
Dialogue: 0,0:06:45.70,0:06:48.73,Default,,0000,0000,0000,,Үлкен бақытты Жақсы табу.
Dialogue: 0,0:06:48.73,0:06:51.73,Default,,0000,0000,0000,,Барлығының қарны тым ашты.
Dialogue: 0,0:06:53.61,0:06:55.47,Default,,0000,0000,0000,,Сіз де. иә.
Dialogue: 0,0:06:55.47,0:06:57.47,Default,,0000,0000,0000,,Жарайды, балық аулауға барайық.
Dialogue: 0,0:06:59.51,0:07:02.20,Default,,0000,0000,0000,,Боқ. Мен бұл жігіттерді ұстай алатын сияқтымын, бірақ қолымнан келмейді.
Dialogue: 0,0:07:02.20,0:07:05.23,Default,,0000,0000,0000,,Ей, мен қолымнан келгеннің бәрін жасаймын!
Dialogue: 0,0:07:05.23,0:07:08.93,Default,,0000,0000,0000,,Бұл өте тәбетті емес көрінеді.
Dialogue: 0,0:07:08.93,0:07:11.63,Default,,0000,0000,0000,,Аузыңды жап, балық аула. Егер сіз оны осы уақытта жей алсаңыз, жақсы.
Dialogue: 0,0:07:11.63,0:07:16.84,Default,,0000,0000,0000,,Сіз соншалықты ашсыз ба? Мен қанатты балық жегім келеді. Бұл дәмді!
Dialogue: 0,0:07:16.84,0:07:19.84,Default,,0000,0000,0000,,Бұл керемет нәзіктік!
Dialogue: 0,0:07:21.06,0:07:24.59,Default,,0000,0000,0000,,Мен жалығып барамын. Менің еркім әлсіз!
Dialogue: 0,0:07:24.59,0:07:27.62,Default,,0000,0000,0000,,Өйткені мен мүлде балық ұстай алмаймын.
Dialogue: 0,0:07:27.62,0:07:30.65,Default,,0000,0000,0000,,Сіз аштыңыз ба? Олай болса, барымызды салайық.
Dialogue: 0,0:07:30.65,0:07:33.01,Default,,0000,0000,0000,,Берілмеңіз.
Dialogue: 0,0:07:33.01,0:07:39.24,Default,,0000,0000,0000,,Люсидің ақымақтығы! Жақсы, мен сені жігерлендірдім!
Dialogue: 0,0:07:39.24,0:07:43.12,Default,,0000,0000,0000,,Бұл қиын. Соңында бір ғана.
Dialogue: 0,0:07:43.12,0:07:47.49,Default,,0000,0000,0000,,Қуанып тамақтаныңыз. Бірақ бір ғана жігіт бар.
Dialogue: 0,0:07:47.49,0:07:51.36,Default,,0000,0000,0000,,Одан аздап жесем, одан да аш боламын.
Dialogue: 0,0:07:51.36,0:07:54.39,Default,,0000,0000,0000,,Ұстамаңыз. Же, же.
Dialogue: 0,0:07:54.39,0:07:57.39,Default,,0000,0000,0000,,Иә? Мен оны аламын.
Dialogue: 0,0:08:01.46,0:08:04.15,Default,,0000,0000,0000,,Мен мұндай дәмді балықты жей алатыныма сене алар емеспін→
Dialogue: 0,0:08:04.15,0:08:07.35,Default,,0000,0000,0000,,Сіз шынымен бақыттысыз.
Dialogue: 0,0:08:07.35,0:08:10.88,Default,,0000,0000,0000,,Ең алдымен! Жаман ба?
Dialogue: 0,0:08:10.88,0:08:14.88,Default,,0000,0000,0000,,Әлі де... Менің ішім... Азайып кетті.
Dialogue: 0,0:08:17.28,0:08:20.81,Default,,0000,0000,0000,,Бұл ауыл. Үй. Сонда мүмкін...
Dialogue: 0,0:08:20.81,0:08:22.81,Default,,0000,0000,0000,,Жеңдер!
Dialogue: 0,0:08:25.03,0:08:29.07,Default,,0000,0000,0000,,Мұнда ешкім жоқ. Бұл тыныш ауыл.
Dialogue: 0,0:08:29.07,0:08:32.10,Default,,0000,0000,0000,,Ол ұйықтап жатыр ма деп ойлаймын.
Dialogue: 0,0:08:32.10,0:08:35.80,Default,,0000,0000,0000,,Эй, мұнда біреу бар ма?
Dialogue: 0,0:08:35.80,0:08:41.19,Default,,0000,0000,0000,,Мен аштан өліп жатырмын. Біреу маған тамақ беріңізші.
Dialogue: 0,0:08:41.19,0:08:44.19,Default,,0000,0000,0000,,Әлгі аш мысық. Өйткені бұл тым айқын.
Dialogue: 0,0:08:47.25,0:08:49.77,Default,,0000,0000,0000,,Бұл шынымен ұйықтау ма?
Dialogue: 0,0:08:49.77,0:08:52.47,Default,,0000,0000,0000,,Әйтпесе, Мұранака, мен мас болып ұйықтап қалатын шығармын.
Dialogue: 0,0:08:52.47,0:08:56.47,Default,,0000,0000,0000,,Өйткені бұл Fairy Tail. Хаха. Мен солай айтар едім.
Dialogue: 0,0:09:00.21,0:09:03.41,Default,,0000,0000,0000,,Иә, бұл өте қиын. Мен сені бірдеңе жеуге мәжбүрлеймін.
Dialogue: 0,0:09:03.41,0:09:06.27,Default,,0000,0000,0000,,Ей, бұл біраз тонау.
Dialogue: 0,0:09:06.27,0:09:09.97,Default,,0000,0000,0000,,Сіз де солай ойлайтыныңызға сенімдімін!
Dialogue: 0,0:09:09.97,0:09:12.50,Default,,0000,0000,0000,,Эй, мұнда біреу бар ма?
Dialogue: 0,0:09:12.50,0:09:16.50,Default,,0000,0000,0000,,Маған жейтін нәрсе беріңіз. сұраңыз.
Dialogue: 0,0:09:18.73,0:09:23.77,Default,,0000,0000,0000,,Күтілгендей, мұнда ешкім жоқ. Мен оны бәрібір жеймін.
Dialogue: 0,0:09:23.77,0:09:25.80,Default,,0000,0000,0000,,Жарайды, мен әлі де жей аламын.
Dialogue: 0,0:09:25.80,0:09:28.66,Default,,0000,0000,0000,,Мен аламын... Күте тұрыңыз. Бұл не?
Dialogue: 0,0:09:28.66,0:09:31.19,Default,,0000,0000,0000,,Бірдеңе дұрыс емес. Әй, біраз уақыт бұрын→
Dialogue: 0,0:09:31.19,0:09:37.08,Default,,0000,0000,0000,,Тамақтанып жатқан сияқты. Бұл үйдегі адамдардың бәрі қайда кетті?
Dialogue: 0,0:09:37.08,0:09:41.80,Default,,0000,0000,0000,,Сіз білесіз бе? Әзірше, махаббат. Тамақ ішейік, Бақытты.
Dialogue: 0,0:09:41.80,0:09:44.82,Default,,0000,0000,0000,,Күтіңіз. иә.
Dialogue: 0,0:09:44.82,0:09:46.51,Default,,0000,0000,0000,,Алдымен ауылдағы жағдайды зерттеуіміз керек.
Dialogue: 0,0:09:46.51,0:09:50.89,Default,,0000,0000,0000,,Мен осы уақытқа дейін ұстап келдім. Сәл күте тұрыңыз...
Dialogue: 0,0:09:50.89,0:09:53.25,Default,,0000,0000,0000,,Эльза Менің ішім қатты дірілдеп жатыр.
Dialogue: 0,0:09:53.25,0:09:56.44,Default,,0000,0000,0000,,Ум. Оның сендіру күші нөлдік.
Dialogue: 0,0:09:56.44,0:10:01.33,Default,,0000,0000,0000,,Нацу мен басқалары саңырауқұлақ немесе бірдеңе іздесін. Ауылдың тамағына қол тигізбе.
Dialogue: 0,0:10:01.33,0:10:05.03,Default,,0000,0000,0000,,Осы арада қожайын екеуміз ауылды зерттейміз.
Dialogue: 0,0:10:05.03,0:10:09.91,Default,,0000,0000,0000,,А, мен түсіндім. Кеттік, Бақытты. махаббат.
Dialogue: 0,0:10:09.91,0:10:12.91,Default,,0000,0000,0000,,Неліктен саңырауқұлақтар?
Dialogue: 0,0:10:15.13,0:10:18.33,Default,,0000,0000,0000,,Мен дәмді тағам тауып алдым.
Dialogue: 0,0:10:18.33,0:10:22.36,Default,,0000,0000,0000,,Саңырауқұлақтар сізді аштырмайды.
Dialogue: 0,0:10:22.36,0:10:24.22,Default,,0000,0000,0000,,Саңырауқұлақтар. сонда болды. Дәмді көрінеді!
Dialogue: 0,0:10:24.22,0:10:28.09,Default,,0000,0000,0000,,Неліктен саңырауқұлақтар? О, мен білемін.
Dialogue: 0,0:10:28.09,0:10:30.12,Default,,0000,0000,0000,,Не? Нацу күліп тұрған сияқты →
Dialogue: 0,0:10:30.12,0:10:34.32,Default,,0000,0000,0000,,Мен саңырауқұлақ жеймін. Бұл уәде.
Dialogue: 0,0:10:34.32,0:10:40.32,Default,,0000,0000,0000,,Не айтып тұрсың, Бақытты? Күткендей, мұндай ақымақтық жасамаңыз.
Dialogue: 0,0:10:59.91,0:11:03.95,Default,,0000,0000,0000,,Мастер…. Жоқ, олай емес! Мен... жай ғана білуге ​​тырыстым.
Dialogue: 0,0:11:03.95,0:11:08.83,Default,,0000,0000,0000,,Саңырауқұлақ болса да, осыншама жесең, ішің ісіп кетеді.
Dialogue: 0,0:11:08.83,0:11:10.01,Default,,0000,0000,0000,,Бұл жай ғана жасандылық.
Dialogue: 0,0:11:10.01,0:11:14.88,Default,,0000,0000,0000,,Тездетіп алыңыз. Ахаха….
Dialogue: 0,0:11:14.88,0:11:16.58,Default,,0000,0000,0000,,Жоқ! ? Хмм!
Dialogue: 0,0:11:16.58,0:11:19.58,Default,,0000,0000,0000,,Нацу, жақсысың ба? Қараңызшы, міне!
Dialogue: 0,0:11:21.79,0:11:24.82,Default,,0000,0000,0000,,Мен таң қалдым! Мен де таң қалдым!
Dialogue: 0,0:11:24.82,0:11:28.36,Default,,0000,0000,0000,,Бұл күлкілі емес пе? Бұл жерде сіз депрессияға ұшырайсыз ба?
Dialogue: 0,0:11:28.36,0:11:31.56,Default,,0000,0000,0000,,Сіз қандай шу шығарып жатырсыз?
Dialogue: 0,0:11:31.56,0:11:35.56,Default,,0000,0000,0000,,Екеуі де басшы... (2 адам) Әй?
Dialogue: 0,0:11:37.45,0:11:40.48,Default,,0000,0000,0000,,Ахахха! Бұл қандай саңырауқұлақ?
Dialogue: 0,0:11:40.48,0:11:42.50,Default,,0000,0000,0000,,Теми - ақымақ саңырауқұлақ бар!
Dialogue: 0,0:11:42.50,0:11:47.55,Default,,0000,0000,0000,,Неге өзіңді уайымдамайсың? Сонымен...
Dialogue: 0,0:11:47.55,0:11:50.25,Default,,0000,0000,0000,,Ей, салбыраған көз, күлдің.
Dialogue: 0,0:11:50.25,0:11:53.25,Default,,0000,0000,0000,,Темидің де күліп тұрғанына сенімдімін.
Dialogue: 0,0:11:55.79,0:11:57.65,Default,,0000,0000,0000,,Саңырауқұлақпен басыңа төбелеспе!
Dialogue: 0,0:11:57.65,0:12:00.85,Default,,0000,0000,0000,,Қалай болды? Күткендей ол жерде ешкім болмады.
Dialogue: 0,0:12:00.85,0:12:03.54,Default,,0000,0000,0000,,Бұл ауыл қараусыз қалған ауыл.
Dialogue: 0,0:12:03.54,0:12:05.90,Default,,0000,0000,0000,,Дәлірек айтқанда, соңғы кезге дейін→
Dialogue: 0,0:12:05.90,0:12:08.10,Default,,0000,0000,0000,,Адамның мекендегенінің дәлелі.
Dialogue: 0,0:12:08.10,0:12:11.10,Default,,0000,0000,0000,,Бұл қандай сызық?
Dialogue: 0,0:12:16.67,0:12:19.70,Default,,0000,0000,0000,,Бұл жай ғана тастардың арасы емес.
Dialogue: 0,0:12:19.70,0:12:22.70,Default,,0000,0000,0000,,Әдейі жойылғаны анық.
Dialogue: 0,0:12:24.59,0:12:28.29,Default,,0000,0000,0000,,Сәлем! Бұл тым ақымақ.
Dialogue: 0,0:12:28.29,0:12:32.16,Default,,0000,0000,0000,,Люси Мен өте үлкенін көрдім. Расында ма!
Dialogue: 0,0:12:32.16,0:12:34.02,Default,,0000,0000,0000,,Бірақ бұл күдікті емес пе?
Dialogue: 0,0:12:34.02,0:12:36.71,Default,,0000,0000,0000,,Қайсысы? О, бұл үлкен!
Dialogue: 0,0:12:36.71,0:12:39.73,Default,,0000,0000,0000,,Бұлардың біреуі маған екі күнге жетеді.
Dialogue: 0,0:12:39.73,0:12:43.27,Default,,0000,0000,0000,,Саңырауқұлақтың басымен не істеу керек?
Dialogue: 0,0:12:43.27,0:12:46.47,Default,,0000,0000,0000,,Сәл бақытты Жаман емес! Бұл улы болуы мүмкін!
Dialogue: 0,0:12:46.47,0:12:49.47,Default,,0000,0000,0000,,Пи! Пи! Бірақ бұл дәмді.
Dialogue: 0,0:12:53.04,0:12:55.22,Default,,0000,0000,0000,,Құдай-ай!
Dialogue: 0,0:12:55.22,0:12:57.92,Default,,0000,0000,0000,,Ақырында, не жесең де, солай болады емес пе?
Dialogue: 0,0:12:57.92,0:13:00.45,Default,,0000,0000,0000,,Ауыл тұрғындары қалай тамақтанды?
Dialogue: 0,0:13:00.45,0:13:03.30,Default,,0000,0000,0000,,Менің ойымша, барлығы осындай.
Dialogue: 0,0:13:03.30,0:13:05.00,Default,,0000,0000,0000,,Ауылдың аты Саңырауқұлақ ауылы болуы керек.
Dialogue: 0,0:13:05.00,0:13:07.52,Default,,0000,0000,0000,,Ой… Бұл сәл ағаттық болды.
Dialogue: 0,0:13:07.52,0:13:12.73,Default,,0000,0000,0000,,Екінші рет суық! Мәселе бұл емес!
Dialogue: 0,0:13:12.73,0:13:15.93,Default,,0000,0000,0000,,Бір минут күте тұрыңыз, саңырауқұлақтарыңыз өспей жатыр ма?
Dialogue: 0,0:13:15.93,0:13:18.29,Default,,0000,0000,0000,,Уф! ? Бұл соншалықты жасырын!
Dialogue: 0,0:13:18.29,0:13:20.29,Default,,0000,0000,0000,,Барлық жаңғақтар дәмді.
Dialogue: 0,0:13:24.69,0:13:27.69,Default,,0000,0000,0000,,Мұнда тағы бір жол бар...
Dialogue: 0,0:13:34.79,0:13:37.79,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:15:16.47,0:15:19.47,Default,,0000,0000,0000,,Не? Не... не?
Dialogue: 0,0:15:21.02,0:15:23.38,Default,,0000,0000,0000,,Ах! Саңырауқұлақтар жоғалып кетті!
Dialogue: 0,0:15:23.38,0:15:27.58,Default,,0000,0000,0000,,Бақытты Сен менімен жалғызсың. Эх!
Dialogue: 0,0:15:27.58,0:15:29.10,Default,,0000,0000,0000,,Эльза! Ата!
Dialogue: 0,0:15:29.10,0:15:32.10,Default,,0000,0000,0000,,Бұл дәмді, бірақ маған бұл ұнамайды!
Dialogue: 0,0:15:34.32,0:15:38.36,Default,,0000,0000,0000,,Иә? Эльза!
Dialogue: 0,0:15:38.36,0:15:41.36,Default,,0000,0000,0000,,Сау болыңыз Бақытты. махаббат.
Dialogue: 0,0:15:42.73,0:15:44.75,Default,,0000,0000,0000,,Эх! ?
Dialogue: 0,0:15:44.75,0:15:46.94,Default,,0000,0000,0000,,Уф... бұл не деген! ?
Dialogue: 0,0:15:46.94,0:15:49.46,Default,,0000,0000,0000,,Дододо... Не айтып тұрсың! ?
Dialogue: 0,0:15:49.46,0:15:51.83,Default,,0000,0000,0000,,Әй, мен үй көшкенін бірінші рет көріп тұрмын.
Dialogue: 0,0:15:51.83,0:15:53.18,Default,,0000,0000,0000,,Неліктен бұл қысым нүктесі?
Dialogue: 0,0:15:53.18,0:15:58.72,Default,,0000,0000,0000,,Мынау... Жасай бер, қария.
Dialogue: 0,0:15:58.72,0:16:00.91,Default,,0000,0000,0000,,Күте тұрыңыз! Неге! ?
Dialogue: 0,0:16:00.91,0:16:04.79,Default,,0000,0000,0000,,Биік жерге көтерілу. Мен растағым келетін нәрсе бар.
Dialogue: 0,0:16:04.79,0:16:07.79,Default,,0000,0000,0000,,Келіңіздер. Кетпе!
Dialogue: 0,0:16:14.39,0:16:19.27,Default,,0000,0000,0000,,Сәлем! Бұл неге екенін түсінбеймін.
Dialogue: 0,0:16:19.27,0:16:23.80,Default,,0000,0000,0000,,Шебер Бұл сиқырлы шеңбер ме? сурет?
Dialogue: 0,0:16:23.80,0:16:27.34,Default,,0000,0000,0000,,А, сіз тапқан жолдар →
Dialogue: 0,0:16:27.34,0:16:30.55,Default,,0000,0000,0000,,Бұл сиқырлы шеңбердің бөлігі. Ал мына сиқырлы шеңбер →
Dialogue: 0,0:16:30.55,0:16:37.78,Default,,0000,0000,0000,,Бұл бір рет тыйым салынған Alive тығыздау сиқырын белсендіруге арналған.
Dialogue: 0,0:16:37.78,0:16:40.81,Default,,0000,0000,0000,,Тірі ме? Мынаны қара.
Dialogue: 0,0:16:40.81,0:16:46.20,Default,,0000,0000,0000,,Өздігінен түсінікті, жансызды жанды затқа айналдырып, қозғалысқа келтіретін сиқыр.
Dialogue: 0,0:16:46.20,0:16:49.74,Default,,0000,0000,0000,,Ауыл тұрғындары тыйым салынған сиқырды іске қосты→
Dialogue: 0,0:16:49.74,0:16:53.94,Default,,0000,0000,0000,,Керісінше, құбыжықтарға жем болдым.
Dialogue: 0,0:16:53.94,0:16:56.64,Default,,0000,0000,0000,,Бірақ неге мұндай қауіпті нәрсе?
Dialogue: 0,0:16:56.64,0:16:59.00,Default,,0000,0000,0000,,Бұл... қараңғы гильдияның ауылы.
Dialogue: 0,0:16:59.00,0:17:01.52,Default,,0000,0000,0000,,Не! ?
Dialogue: 0,0:17:01.52,0:17:04.21,Default,,0000,0000,0000,,Бұрын мен белгілі бір үйдің қорасын тергеп жүргенімде→
Dialogue: 0,0:17:04.21,0:17:07.08,Default,,0000,0000,0000,,Сиқырға қолданылатын көптеген құралдарды таптым.
Dialogue: 0,0:17:07.08,0:17:10.11,Default,,0000,0000,0000,,Олардың ешқайсысы... дұрыс сиқыр болған жоқ.
Dialogue: 0,0:17:10.11,0:17:14.48,Default,,0000,0000,0000,,Қараңғы гильдияға келгенде, олар жаман нәрсені жоспарлайды.
Dialogue: 0,0:17:14.48,0:17:16.34,Default,,0000,0000,0000,,Сондықтан да болар, өзін-өзі жойды.
Dialogue: 0,0:17:16.34,0:17:19.86,Default,,0000,0000,0000,,Картоп!
Dialogue: 0,0:17:19.86,0:17:21.05,Default,,0000,0000,0000,,Бұл – жасырын бата.
Dialogue: 0,0:17:21.05,0:17:23.07,Default,,0000,0000,0000,,Ата, бұл не?
Dialogue: 0,0:17:23.07,0:17:26.94,Default,,0000,0000,0000,,Мен оларды тірі заттар деп айттыңыз деп ойладым.
Dialogue: 0,0:17:26.94,0:17:30.94,Default,,0000,0000,0000,,Тірі ағзалардың көпшілігі жеуге жарамды!
Dialogue: 0,0:17:32.49,0:17:35.36,Default,,0000,0000,0000,,Сіз бұл қорқынышты күлімсіреумен не алып жатырсыз?
Dialogue: 0,0:17:35.36,0:17:37.54,Default,,0000,0000,0000,,Егер ұсталып қалсам, ең болмағанда сені өлтіремін, Польнарефф》
Dialogue: 0,0:17:37.54,0:17:39.40,Default,,0000,0000,0000,,Сәлем! Сіз оны жейсіз бе? !
Dialogue: 0,0:17:39.40,0:17:42.59,Default,,0000,0000,0000,,Иә! Тамақтану уақыты келді! !
Dialogue: 0,0:17:42.59,0:17:45.63,Default,,0000,0000,0000,,Осы кезде мен оның дәмін айта алмаймын!
Dialogue: 0,0:17:45.63,0:17:49.50,Default,,0000,0000,0000,,Ех! Эльза менің қарным ашты! ?
Dialogue: 0,0:17:49.50,0:17:52.53,Default,,0000,0000,0000,,Меши Меши Меши Меши! Эй... сәл күте тұрыңыз!
Dialogue: 0,0:17:52.53,0:17:54.22,Default,,0000,0000,0000,,Мен де өзіме тапсырыс бердім!
Dialogue: 0,0:17:54.22,0:17:59.60,Default,,0000,0000,0000,,Эй, балалар, менің кім екенімді білесіңдер ме? ?
Dialogue: 0,0:17:59.60,0:18:04.48,Default,,0000,0000,0000,,Fairy Tail нөмірі бірінші... жалын аспаз!
Dialogue: 0,0:18:04.48,0:18:07.48,Default,,0000,0000,0000,,От айдаһарының темір жұдырығы!
Dialogue: 0,0:18:10.38,0:18:13.41,Default,,0000,0000,0000,,Алдымен мұқият пісіріңіз!
Dialogue: 0,0:18:13.41,0:18:17.27,Default,,0000,0000,0000,,От айдаһарының темір жұдырығы! Эй! !
Dialogue: 0,0:18:17.27,0:18:21.27,Default,,0000,0000,0000,,Және! О иә! !
Dialogue: 0,0:18:24.52,0:18:27.52,Default,,0000,0000,0000,,Қақпақ және бу. Біраз күте тұрыңыз.
Dialogue: 0,0:18:29.73,0:18:34.73,Default,,0000,0000,0000,,Кенеттен десерт деген нәрсе жоқ, бірақ мен онымен ештеңе істей алмаймын.
Dialogue: 0,0:18:42.37,0:18:47.08,Default,,0000,0000,0000,,Мұзды макияжға арналған тор!
Dialogue: 0,0:18:47.08,0:18:50.61,Default,,0000,0000,0000,,Шербет аяқталды! Мен мұны ұнатамын.
Dialogue: 0,0:18:50.61,0:18:55.32,Default,,0000,0000,0000,,Ей! сәуле! Қайсысы нашар екенін білмеймін, қанатты балық па, орындық па →
Dialogue: 0,0:18:55.32,0:18:57.68,Default,,0000,0000,0000,,Ей! сәуле!
Dialogue: 0,0:18:57.68,0:18:59.20,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:18:59.20,0:19:02.20,Default,,0000,0000,0000,,Иә? Міне бітті!
Dialogue: 0,0:19:05.43,0:19:07.61,Default,,0000,0000,0000,,Эльза!
Dialogue: 0,0:19:07.61,0:19:10.98,Default,,0000,0000,0000,,Артында болыңыз! Пісіру уақыты келді.
Dialogue: 0,0:19:10.98,0:19:12.50,Default,,0000,0000,0000,,Пісіру...
Dialogue: 0,0:19:12.50,0:19:14.50,Default,,0000,0000,0000,,Ауыстыру!
Dialogue: 0,0:19:36.24,0:19:38.24,Default,,0000,0000,0000,,Ии!
Dialogue: 0,0:19:42.96,0:19:48.02,Default,,0000,0000,0000,,Әрбір ұзындығы шамамен 5 см. Ең бастысы - ені 4 мм квадраттарға кесу.
Dialogue: 0,0:19:48.02,0:19:51.22,Default,,0000,0000,0000,,Мұндай міндеттеме? Дәлірек айтсақ, Эльза солай көрінеді...
Dialogue: 0,0:19:51.22,0:19:55.09,Default,,0000,0000,0000,,От айдаһарының темір жұдырығы! Мұзды макияждың түйіндері!
Dialogue: 0,0:19:55.09,0:19:57.94,Default,,0000,0000,0000,,О! Ха!
Dialogue: 0,0:19:57.94,0:20:00.94,Default,,0000,0000,0000,,Мен әлі ашпын.
Dialogue: 0,0:20:03.00,0:20:05.02,Default,,0000,0000,0000,,Ол Аня-чанның әкесі бола ма?
Dialogue: 0,0:20:05.02,0:20:10.91,Default,,0000,0000,0000,,Ол не істеп жатыр? Қандай жағдай болмасын орындықты жеуге болмайды.
Dialogue: 0,0:20:10.91,0:20:13.11,Default,,0000,0000,0000,,Люси. Алдымен оны жеп көріңіз.
Dialogue: 0,0:20:13.11,0:20:16.13,Default,,0000,0000,0000,,Маған ұнамайды! Менің таңдауым жоқ.
Dialogue: 0,0:20:16.13,0:20:20.35,Default,,0000,0000,0000,,Бұл дұрыс емес! Неге бірінші мені тамақтандыруға тырысып жатырсың? ?
Dialogue: 0,0:20:20.35,0:20:25.73,Default,,0000,0000,0000,,Не... не істеп жатырсың? Мен оны өзім анықтаймын.
Dialogue: 0,0:20:25.73,0:20:27.73,Default,,0000,0000,0000,,Сонымен.
Dialogue: 0,0:20:29.43,0:20:32.46,Default,,0000,0000,0000,,Не... дәмі қандай?
Dialogue: 0,0:20:32.46,0:20:35.46,Default,,0000,0000,0000,,Уф! Ал... сонда...
Dialogue: 0,0:20:38.68,0:20:41.68,Default,,0000,0000,0000,,Ал... Мен оны жеп көрейін деп ойлаймын.
Dialogue: 0,0:20:46.60,0:20:48.12,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:20:48.12,0:20:50.31,Default,,0000,0000,0000,,Ең алдымен!
Dialogue: 0,0:20:50.31,0:20:53.67,Default,,0000,0000,0000,,Бұл не? Ата, сіз оны жей алмайсыз!
Dialogue: 0,0:20:53.67,0:20:55.36,Default,,0000,0000,0000,,Оның қаншалықты жаман екенінде шек бар!
Dialogue: 0,0:20:55.36,0:20:57.22,Default,,0000,0000,0000,,А, ол жеген жоқ.
Dialogue: 0,0:20:57.22,0:21:00.41,Default,,0000,0000,0000,,Мені тамақтандырғаннан кейін айтпа!
Dialogue: 0,0:21:00.41,0:21:03.41,Default,,0000,0000,0000,,Уау! тістері?
Dialogue: 0,0:21:06.30,0:21:08.82,Default,,0000,0000,0000,,Сен саңырауқұлақ ұстадың.
Dialogue: 0,0:21:08.82,0:21:12.36,Default,,0000,0000,0000,,Оның үстіне мені неге ешкім тоқтатпады?
Dialogue: 0,0:21:12.36,0:21:14.72,Default,,0000,0000,0000,,Бұл қорқынышты, Нацу! Неге! ?
Dialogue: 0,0:21:14.72,0:21:18.59,Default,,0000,0000,0000,,ше? Сіз ойнаған жоқсыз ба?
Dialogue: 0,0:21:18.59,0:21:20.11,Default,,0000,0000,0000,,Бірақ ол жоғалып кетті.
Dialogue: 0,0:21:20.11,0:21:23.30,Default,,0000,0000,0000,,Қаншалықты аш болғаныңыз маңызды емес...
Dialogue: 0,0:21:23.30,0:21:25.66,Default,,0000,0000,0000,,Бастапқыда бұл құбыжықтарды жеу туралы болды.
Dialogue: 0,0:21:25.66,0:21:27.35,Default,,0000,0000,0000,,О, сұмдық!
Dialogue: 0,0:21:27.35,0:21:30.54,Default,,0000,0000,0000,,Мен тамақ іше алмайтынымды білгенде, қатты аштым.
Dialogue: 0,0:21:30.54,0:21:32.40,Default,,0000,0000,0000,,《Аа... бұл ең жаманы...
Dialogue: 0,0:21:32.40,0:21:38.46,Default,,0000,0000,0000,,Достық пен жолдастық ештеңе емес.
Dialogue: 0,0:21:38.46,0:21:41.46,Default,,0000,0000,0000,,Уау! қауіпті! Нацу!
Dialogue: 0,0:21:44.85,0:21:47.85,Default,,0000,0000,0000,,Жаман балалар... Мен ашуландым.
Dialogue: 0,0:21:49.06,0:21:51.25,Default,,0000,0000,0000,,Мен сені бірден ұшырып жіберемін!
Dialogue: 0,0:21:51.25,0:21:56.46,Default,,0000,0000,0000,,От айдаһарының қанатты шабуылы!
Dialogue: 0,0:21:56.46,0:21:58.32,Default,,0000,0000,0000,,Мұз қабырғасы! Хаха!
Dialogue: 0,0:21:58.32,0:22:03.54,Default,,0000,0000,0000,,Мен де! Алтын өгіз сарайының есігін аш!
Dialogue: 0,0:22:03.54,0:22:05.54,Default,,0000,0000,0000,,Телец!
Dialogue: 0,0:22:07.75,0:22:12.79,Default,,0000,0000,0000,,Мо~!
Dialogue: 0,0:22:12.79,0:22:16.67,Default,,0000,0000,0000,,Әдеттегідей жақсы дос. Иә, көп рахмет.
Dialogue: 0,0:22:16.67,0:22:18.69,Default,,0000,0000,0000,,Біраз уақыт өтті...
Dialogue: 0,0:22:18.69,0:22:22.69,Default,,0000,0000,0000,,Мо~рецу!
Dialogue: 0,0:22:28.29,0:22:32.16,Default,,0000,0000,0000,,Цк... Шектеу жоқ!
Dialogue: 0,0:22:32.16,0:22:35.02,Default,,0000,0000,0000,,Бұл... Бұл уақыт қандай? ?
Dialogue: 0,0:22:35.02,0:22:37.02,Default,,0000,0000,0000,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:22:39.23,0:22:42.23,Default,,0000,0000,0000,,Сиқырлы шеңбер! ? Бұл не!
Dialogue: 0,0:22:45.95,0:22:48.65,Default,,0000,0000,0000,,Уау, өте әдемі! Солай емес пе!
Dialogue: 0,0:22:48.65,0:22:51.68,Default,,0000,0000,0000,,Біраз уақыттан бері қысым нүктелерімен не болып жатыр?
Dialogue: 0,0:22:51.68,0:22:53.68,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,0:23:03.80,0:23:05.49,Default,,0000,0000,0000,,Қаш!
Dialogue: 0,0:23:05.49,0:23:09.49,Default,,0000,0000,0000,,Ой~!
Dialogue: 0,0:23:14.08,0:23:18.78,Default,,0000,0000,0000,,А... Мен қатты аштым...
Dialogue: 0,0:23:18.78,0:23:20.48,Default,,0000,0000,0000,,Эй, мен енді жүре алмаймын.
Dialogue: 0,0:23:20.48,0:23:24.01,Default,,0000,0000,0000,,Сондықтан мақтану үшін қауырсыныңды пайдаланба! Қауырсындар!
Dialogue: 0,0:23:24.01,0:23:27.71,Default,,0000,0000,0000,,Мен бір нәрсені түсінбеймін.
Dialogue: 0,0:23:27.71,0:23:30.57,Default,,0000,0000,0000,,Мастер. О?
Dialogue: 0,0:23:30.57,0:23:33.10,Default,,0000,0000,0000,,Мен бұрын берген түсініктемеге қанағаттанбаймын.
Dialogue: 0,0:23:33.10,0:23:35.10,Default,,0000,0000,0000,,Егер ұсталып қалсам, ең болмағанда сені өлтіремін, Польнарефф》
Dialogue: 0,0:23:38.15,0:23:41.01,Default,,0000,0000,0000,,((Балалар, сендер не істедіңдер!
Dialogue: 0,0:23:41.01,0:23:44.55,Default,,0000,0000,0000,,Сиқырлы шеңбер жасағанда құбыжық → пайда болады
Dialogue: 0,0:23:44.55,0:23:47.08,Default,,0000,0000,0000,,Барлығын сол жігіттер басып алды...
Dialogue: 0,0:23:47.08,0:23:50.61,Default,,0000,0000,0000,,Ендеше, сендер сол құбыжықтың ішінде екенсіңдер...
Dialogue: 0,0:23:50.61,0:23:54.81,Default,,0000,0000,0000,,Уа! Мен аздап жедім.
Dialogue: 0,0:23:54.81,0:23:56.84,Default,,0000,0000,0000,,Ауылға бейтаныс адамдар кірдің→
Dialogue: 0,0:23:56.84,0:23:59.53,Default,,0000,0000,0000,,Сиқырлы шеңбер қозғалып, қозғалды.
Dialogue: 0,0:23:59.53,0:24:02.39,Default,,0000,0000,0000,,Сол сиқырлы шеңбер енді ешқашан қозғалмайды!
Dialogue: 0,0:24:02.39,0:24:05.42,Default,,0000,0000,0000,,Не? Неге, ата?
Dialogue: 0,0:24:05.42,0:24:08.95,Default,,0000,0000,0000,,Мен егжей-тегжейге мән бермеймін!
Dialogue: 0,0:24:08.95,0:24:11.81,Default,,0000,0000,0000,,Қалай болғанда да, егер Объектіні алу мәселесі шешілсе де →
Dialogue: 0,0:24:11.81,0:24:13.50,Default,,0000,0000,0000,,Бұл мен үшін ризамын.
Dialogue: 0,0:24:13.50,0:24:17.87,Default,,0000,0000,0000,,Егер сіз осыдан сабақ алып, енді ешқашан оғаш ештеңе жасамауға ант етсеңіз →
Dialogue: 0,0:24:17.87,0:24:21.25,Default,,0000,0000,0000,,Кеңеске есеп бермей істеймін! Ал ше!
Dialogue: 0,0:24:21.25,0:24:24.45,Default,,0000,0000,0000,,Осындай қорқынышты жағдайға тап болғаныма өкінемін.
Dialogue: 0,0:24:24.45,0:24:27.14,Default,,0000,0000,0000,,Кешіріңіз... Мен мұны қайталамаймын.
Dialogue: 0,0:24:27.14,0:24:30.67,Default,,0000,0000,0000,,Ni! ))
Dialogue: 0,0:24:30.67,0:24:33.53,Default,,0000,0000,0000,,Құбыжық шабуылға ұшырағандықтан→
Dialogue: 0,0:24:33.53,0:24:37.91,Default,,0000,0000,0000,,Сиқырлы шеңбер қосылып, бәрін өшіруге тырысты.
Dialogue: 0,0:24:37.91,0:24:39.76,Default,,0000,0000,0000,,Бірақ шебер...
Dialogue: 0,0:24:39.76,0:24:42.79,Default,,0000,0000,0000,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:24:42.79,0:24:44.14,Default,,0000,0000,0000,,Сол сәтте бізге көмектес →
Dialogue: 0,0:24:44.14,0:24:46.67,Default,,0000,0000,0000,,Қараңғы гильдияларды басып алуды шешу→
Dialogue: 0,0:24:46.67,0:24:51.88,Default,,0000,0000,0000,,Содан кейін сиқырлы шеңбердің өзі жоғалып кетті.
Dialogue: 0,0:24:51.88,0:24:55.09,Default,,0000,0000,0000,,Солай ма? Хатену….
Dialogue: 0,0:24:55.09,0:24:58.12,Default,,0000,0000,0000,,Әй, бәрібір...
Dialogue: 0,0:24:58.12,0:25:03.12,Default,,0000,0000,0000,,Менің қарным ашты!
Dialogue: 0,0:25:04.62,0:25:10.62,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory