Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.12,0:00:03.60,Default,,0,0,0,,Ио, бәрі теледидар алдында.
Dialogue: 0,0:00:03.83,0:00:05.53,Default,,0,0,0,,«Fairy Tail» фильмін көргенде
Dialogue: 0,0:00:05.53,0:00:06.69,Default,,0,0,0,,Бөлмені жарықтандырыңыз
Dialogue: 0,0:00:07.00,0:00:08.95,Default,,0,0,0,,Теледидардан алыстаңыз.
Dialogue: 0,0:00:10.78,0:00:12.82,Default,,0,0,0,,«Ертегі» Соңғы уақытқа дейін
Dialogue: 0,0:00:13.04,0:00:15.04,Default,,0,0,0,,«Фантом Лордпен» толық ауқымды қақтығыста
Dialogue: 0,0:00:15.39,0:00:17.30,Default,,0,0,0,,Мастер мен Эльза құлады
Dialogue: 0,0:00:17.56,0:00:20.00,Default,,0,0,0,,Біз Сиқырлы Титанды тоқтату үшін келдік.
Dialogue: 0,0:00:20.00,0:00:22.21,Default,,0,0,0,,Мен 4-элементті жеңуім керек.
Dialogue: 0,0:00:22.43,0:00:25.13,Default,,0,0,0,,Айтпақшы, Люсиді «Фантом» нысанаға алады.
Dialogue: 0,0:00:25.30,0:00:27.69,Default,,0,0,0,,Мен жасырынған жерде тығылып тұрмын.
Dialogue: 0,0:00:27.73,0:00:28.82,Default,,0,0,0,,Менде жағымсыз сезім бар
Dialogue: 0,0:02:18.91,0:02:20.52,Default,,0,0,0,,О, бұл рас.
Dialogue: 0,0:02:20.69,0:02:23.91,Default,,0,0,0,,Сиқырлы шеңберлерді салу жылдамдығы біршама баяулады.
Dialogue: 0,0:02:24.13,0:02:25.65,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:02:25.73,0:02:28.39,Default,,0,0,0,,От пен су, жел мен жер
Dialogue: 0,0:02:28.87,0:02:32.95,Default,,0,0,0,,Төрт элементтің сиқырынан қуат алатын сиқырлы алып?
Dialogue: 0,0:02:33.43,0:02:37.39,Default,,0,0,0,,4-элемент сол сиқырлы күштің қайнар көзі
Dialogue: 0,0:02:37.95,0:02:40.91,Default,,0,0,0,,Юпитердегі Ұлы өрттің Усатомару
Dialogue: 0,0:02:41.30,0:02:43.82,Default,,0,0,0,,Жер Сол Эльфманнан жеңілді
Dialogue: 0,0:02:44.52,0:02:48.87,Default,,0,0,0,,Ал Грей жеңген мұхиттың Джувиасы
Dialogue: 0,0:02:49.04,0:02:50.78,Default,,0,0,0,,Бір ғана адам қалды ма?
Dialogue: 0,0:02:50.95,0:02:54.00,Default,,0,0,0,,Сол төртінші адамды жеңсең, дәу тоқтайды.
Dialogue: 0,0:02:54.13,0:02:56.95,Default,,0,0,0,,Бұл оның «Тазалық бұзу толқынын» тоқтата алатынын білдіреді.
Dialogue: 0,0:02:57.34,0:03:00.47,Default,,0,0,0,,Аспандағы соңғы адам ариясы
Dialogue: 0,0:03:01.17,0:03:04.08,Default,,0,0,0,,4-элемент Ең күшті сиқыршы
Dialogue: 0,0:03:04.65,0:03:09.65,Default,,0,0,0,,Ал шебердің сиқырлы күшін ұрлаған қорқынышты қарсылас.
Dialogue: 0,0:03:17.82,0:03:19.39,Default,,0,0,0,,Бұл тек менің қиялым ба?
Dialogue: 0,0:03:31.82,0:03:35.30,Default,,0,0,0,,Жақсы ұстап тұр, Саламандер.
Dialogue: 0,0:03:35.56,0:03:38.26,Default,,0,0,0,,Әлгі бейбақ жанып жатыр.
Dialogue: 0,0:03:38.91,0:03:39.78,Default,,0,0,0,,Нацу
Dialogue: 0,0:03:40.08,0:03:42.34,Default,,0,0,0,,«Әуе кеңістігі абсолютті»
Dialogue: 0,0:03:47.26,0:03:52.34,Default,,0,0,0,,Тым күшті Бұл 4-элементтегі ең күшті адам
Dialogue: 0,0:03:52.60,0:03:53.60,Default,,0,0,0,,Кира мен Жапон тергеу басқармасы арасындағы сөйлесулерге қарағанда,
Dialogue: 0,0:03:53.87,0:03:57.34,Default,,0,0,0,,Үстіңде біреу тұр, жас айдаһар.
Dialogue: 0,0:03:57.39,0:04:01.26,Default,,0,0,0,,Осы «Отты айдаһардың арылдауы» туралы не айтасыз?
Dialogue: 0,0:04:04.13,0:04:05.21,Default,,0,0,0,,Оқ жаудырыңдар! Бүйіріне нысана ал!
Dialogue: 0,0:04:06.04,0:04:07.00,Default,,0,0,0,,Кираны қолдайтындардың бар екеніне таңғалмаймын.
Dialogue: 0,0:04:08.08,0:04:10.04,Default,,0,0,0,,Бітті, Сәлемендер
Dialogue: 0,0:04:10.39,0:04:15.04,Default,,0,0,0,,Мен саған Макаров сияқты азапты беремін.
Dialogue: 0,0:04:16.91,0:04:19.04,Default,,0,0,0,,«Әуе кеңістігін жою»
Dialogue: 0,0:04:21.21,0:04:25.21,Default,,0,0,0,,Қайғылы Бұл әуе кеңістігінде ешбір сиқыршы табылмайды.
Dialogue: 0,0:04:25.60,0:04:28.52,Default,,0,0,0,,Сиқырлы күш бос болады.
Dialogue: 0,0:04:31.39,0:04:34.30,Default,,0,0,0,,Күшті жоғалту
Dialogue: 0,0:04:34.78,0:04:36.30,Default,,0,0,0,,Нату
Dialogue: 0,0:04:39.87,0:04:41.73,Default,,0,0,0,,Кира мен Жапон тергеу басқармасы арасындағы сөйлесулерге қарағанда,
Dialogue: 0,0:04:45.73,0:04:46.69,Default,,0,0,0,,Эльза
Dialogue: 0,0:04:47.21,0:04:49.91,Default,,0,0,0,,Эй, сен қозғаласың ба?
Dialogue: 0,0:04:49.95,0:04:51.08,Default,,0,0,0,,Жарақат
Dialogue: 0,0:04:54.43,0:04:55.69,Default,,0,0,0,,Эльза ашуланды
Dialogue: 0,0:04:56.04,0:04:57.34,Default,,0,0,0,,Бұл жігіт қожайын
Dialogue: 0,0:04:57.78,0:04:59.73,Default,,0,0,0,,Эрза Скарлет?
Dialogue: 0,0:04:59.82,0:05:02.95,Default,,0,0,0,,Өкінішке орай, саламандр ғана емес
Dialogue: 0,0:05:03.17,0:05:06.30,Default,,0,0,0,,Сіз маған тіпті «Ертегі ханшайымының» басын бердіңіз
Dialogue: 0,0:05:06.60,0:05:10.13,Default,,0,0,0,,Әке-шешемізді шатастырған сен едің.
Dialogue: 0,0:05:10.30,0:05:11.04,Default,,0,0,0,,Эльза
Dialogue: 0,0:05:13.39,0:05:16.13,Default,,0,0,0,,Күтілгендей, қарсылас ретінде Эльзаға келгенде.
Dialogue: 0,0:05:16.52,0:05:20.08,Default,,0,0,0,,Мен де байсалды болуым керек.
Dialogue: 0,0:05:21.87,0:05:22.65,Default,,0,0,0,,Көздер?
Dialogue: 0,0:05:23.78,0:05:25.47,Default,,0,0,0,,Көз алмасы не болды?
Dialogue: 0,0:05:25.52,0:05:27.78,Default,,0,0,0,,Ария әдетте көзін жұмады.
Dialogue: 0,0:05:28.13,0:05:29.30,Default,,0,0,0,,Көзді жұмып
Dialogue: 0,0:05:29.52,0:05:32.78,Default,,0,0,0,,Ол өзінің сиқырлы күшін басып жатқан сияқты, ол тым күшті.
Dialogue: 0,0:05:33.39,0:05:34.73,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:05:34.87,0:05:37.04,Default,,0,0,0,,Әйтеуір, Арияны тапсаңыз
Dialogue: 0,0:05:37.04,0:05:39.04,Default,,0,0,0,,Оны көзін ашпай тұрып өлтіріңіз.
Dialogue: 0,0:05:39.47,0:05:42.78,Default,,0,0,0,,Егер сіз көзіңізді ашсаңыз, жеңу мүмкіндігінен айырылып қалуыңыз мүмкін.
Dialogue: 0,0:05:45.60,0:05:46.34,Default,,0,0,0,,Не?
Dialogue: 0,0:05:46.34,0:05:48.17,Default,,0,0,0,,Сиқырлы шеңбер жарқырай бастады.
Dialogue: 0,0:05:48.43,0:05:49.47,Default,,0,0,0,,Ол аяқталды ма?
Dialogue: 0,0:05:50.30,0:05:53.43,Default,,0,0,0,,Қарғыс атқыр, мұның бәрі осы ма?
Dialogue: 0,0:05:56.82,0:06:00.69,Default,,0,0,0,,Нацу Барлығы сұрады.
Dialogue: 0,0:06:08.78,0:06:11.13,Default,,0,0,0,,«Ертегі ханшайымы» келіңіз
Dialogue: 0,0:06:13.21,0:06:16.39,Default,,0,0,0,,«Өлім әуе кеңістігі нөлі» іске қосылды
Dialogue: 0,0:06:16.39,0:06:19.39,Default,,0,0,0,,Бұл әуе кеңістігі барлық өмірге жақсы қызмет етеді
Dialogue: 0,0:06:22.39,0:06:24.30,Default,,0,0,0,,Бұл ақылсыз
Dialogue: 0,0:06:25.04,0:06:27.21,Default,,0,0,0,,Өмірді жейтін сиқыр.
Dialogue: 0,0:06:28.30,0:06:33.87,Default,,0,0,0,,Неліктен? Неге біреудің өмірін оңай ала аламын дейсіз?
Dialogue: 0,0:06:34.13,0:06:35.26,Default,,0,0,0,,Балалар
Dialogue: 0,0:06:35.60,0:06:37.87,Default,,0,0,0,,Жүр, көңіл көтерейік
Dialogue: 0,0:06:38.39,0:06:39.00,Default,,0,0,0,,Эльза
Dialogue: 0,0:06:40.69,0:06:43.73,Default,,0,0,0,,Сіз бұл әуе кеңістігіне шыдай аласыз ба?
Dialogue: 0,0:06:50.26,0:06:53.26,Default,,0,0,0,,Әуе кеңістігін ақымақ кесу және т.б.
Dialogue: 0,0:06:54.08,0:06:54.82,Default,,0,0,0,,Жер
Dialogue: 0,0:06:56.69,0:07:03.00,Default,,0,0,0,,«Тенрин Рьюранның қылышы»
Dialogue: 0,0:07:08.60,0:07:10.60,Default,,0,0,0,,Мен оны бір оқпен өлтірдім.
Dialogue: 0,0:07:10.60,0:07:12.30,Default,,0,0,0,,Өйткені, Эльза Абуне
Dialogue: 0,0:07:12.56,0:07:16.08,Default,,0,0,0,,Қожайынды сіз сияқты біреу жеңуі мүмкін емес.
Dialogue: 0,0:07:17.13,0:07:20.91,Default,,0,0,0,,Батырлық туралы аңызыңызды дереу өшіріңіз.
Dialogue: 0,0:07:21.34,0:07:23.95,Default,,0,0,0,,Немесе қайғылы
Dialogue: 0,0:07:24.65,0:07:25.52,Default,,0,0,0,,Мен жатуым керек пе?
Dialogue: 0,0:07:25.65,0:07:27.34,Default,,0,0,0,,Жай жатып алып құтыла алмайсың.
Dialogue: 0,0:07:27.78,0:07:29.43,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:07:33.39,0:07:34.08,Default,,0,0,0,,Иә
Dialogue: 0,0:07:34.60,0:07:35.34,Default,,0,0,0,,О
Dialogue: 0,0:07:35.65,0:07:37.00,Default,,0,0,0,,Жарық сөнді
Dialogue: 0,0:07:54.30,0:07:56.91,Default,,0,0,0,,Сәлем Эльза
Dialogue: 0,0:07:57.47,0:07:58.26,Default,,0,0,0,,Не?
Dialogue: 0,0:07:58.47,0:08:00.26,Default,,0,0,0,,Мұны Нацу жасады ма?
Dialogue: 0,0:08:00.47,0:08:02.00,Default,,0,0,0,,Ол тоқтады.
Dialogue: 0,0:08:02.21,0:08:04.65,Default,,0,0,0,,«Тұңғиық сынуы» жоғалып кетті.
Dialogue: 0,0:08:06.17,0:08:07.30,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:08:07.78,0:08:10.13,Default,,0,0,0,,Биліктің төрт элементі жойылды
Dialogue: 0,0:08:11.30,0:08:14.91,Default,,0,0,0,,Алып тоқтады.
Dialogue: 0,0:08:16.91,0:08:20.73,Default,,0,0,0,,4-элементті қалай жеңгеніңіз таңқаларлық.
Dialogue: 0,0:08:24.82,0:08:26.39,Default,,0,0,0,,Ридус жарайды
Dialogue: 0,0:08:26.73,0:08:29.26,Default,,0,0,0,,Қандай қыңыр бейбақ.
Dialogue: 0,0:08:29.34,0:08:30.30,Default,,0,0,0,,...
Dialogue: 0,0:08:30.39,0:08:33.43,Default,,0,0,0,,Қызды беріп, тапсыратын кез келді.
Dialogue: 0,0:08:33.73,0:08:36.04,Default,,0,0,0,,Ұстаз сізді күтуде.
Dialogue: 0,0:08:38.13,0:08:40.17,Default,,0,0,0,,Люси, тез қаш!
Dialogue: 0,0:08:40.21,0:08:42.34,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Мен де күресемін.
Dialogue: 0,0:08:42.52,0:08:45.52,Default,,0,0,0,,Барлығына пайдалы деп сұраңыз.
Dialogue: 0,0:08:45.60,0:08:46.43,Default,,0,0,0,,Бірақ
Dialogue: 0,0:08:46.56,0:08:48.30,Default,,0,0,0,,О, мені жылатады
Dialogue: 0,0:08:48.34,0:08:49.78,Default,,0,0,0,,Бұл әсерлі.
Dialogue: 0,0:08:49.82,0:08:51.39,Default,,0,0,0,,Маған қатты ұнайды
Dialogue: 0,0:08:51.47,0:08:55.87,Default,,0,0,0,,«Викто Сиқырлы» Күміс күркіреуі
Dialogue: 0,0:08:55.91,0:08:59.04,Default,,0,0,0,,Бұл Вулкан. Мен оны Чиквид тауында көрдім.
Dialogue: 0,0:08:59.08,0:09:01.91,Default,,0,0,0,,«Айна сиқыры» толық метражды айна
Dialogue: 0,0:09:05.17,0:09:08.47,Default,,0,0,0,,Барлық дұшпандық осы айнадан көрінеді.
Dialogue: 0,0:09:11.30,0:09:14.43,Default,,0,0,0,,Кешіріңіз, Ридус
Dialogue: 0,0:09:16.47,0:09:20.39,Default,,0,0,0,,Неге достарыңды тастап қашпайсың, ханшайым?
Dialogue: 0,0:09:20.95,0:09:23.56,Default,,0,0,0,,Перінің құлағы да үлкен мәселе емес.
Dialogue: 0,0:09:23.65,0:09:25.21,Default,,0,0,0,,Сіз осындай нәрсені қоршап жүрсіз бе?
Dialogue: 0,0:09:25.65,0:09:26.52,Default,,0,0,0,,Олар әжептәуір алысқа қашып кеткен болар...
Dialogue: 0,0:09:26.60,0:09:27.91,Default,,0,0,0,,Сіз мұны істейсіз бе?
Dialogue: 0,0:09:28.21,0:09:30.82,Default,,0,0,0,,«Дыбыс бомбасы» айқайлайды
Dialogue: 0,0:09:35.73,0:09:36.52,Default,,0,0,0,,Ридус
Dialogue: 0,0:09:36.73,0:09:38.17,Default,,0,0,0,,Оянба
Dialogue: 0,0:09:38.30,0:09:41.87,Default,,0,0,0,,Осылай араласу қызық емес пе, ханшайым?
Dialogue: 0,0:09:42.04,0:09:42.69,Default,,0,0,0,,Олар әжептәуір алысқа қашып кеткен болар...
Dialogue: 0,0:09:43.00,0:09:43.95,Default,,0,0,0,,Сіз?
Dialogue: 0,0:09:45.52,0:09:46.52,Default,,0,0,0,,Сіз?
Dialogue: 0,0:09:53.26,0:09:54.60,Default,,0,0,0,,Содан кейін кезекте тұрғандарды жақсылап ұрып, ақшаларын тартып алады
Dialogue: 0,0:09:54.73,0:09:56.52,Default,,0,0,0,,Алып тоқтады, солай емес пе?
Dialogue: 0,0:10:02.34,0:10:04.26,Default,,0,0,0,,Қандай күлкілі сәлемдесу.
Dialogue: 0,0:10:04.30,0:10:05.73,Default,,0,0,0,,Люсиге не істедің?
Dialogue: 0,0:10:06.39,0:10:10.43,Default,,0,0,0,,Оны қазір босатыңыз немесе
Dialogue: 0,0:10:11.26,0:10:13.78,Default,,0,0,0,,Мен сені бұл дүниеден өшіремін.
Dialogue: 0,0:10:14.13,0:10:17.52,Default,,0,0,0,,Дұрыс, көңілді көтере алмадым.
Dialogue: 0,0:10:18.04,0:10:20.00,Default,,0,0,0,,Менің қарсыласым бол
Dialogue: 0,0:10:27.17,0:10:27.91,Default,,0,0,0,,Локи
Dialogue: 0,0:10:28.60,0:10:32.56,Default,,0,0,0,,Мына жігіт, бұл қандай біртүрлі сезім?
Dialogue: 0,0:10:32.82,0:10:35.56,Default,,0,0,0,,Ол жай ғана Холдер типіндегі сиқыршы емес.
Dialogue: 0,0:10:36.60,0:10:38.08,Default,,0,0,0,,Эй, не болып жатыр?
Dialogue: 0,0:10:38.65,0:10:40.60,Default,,0,0,0,,Біртүрлі иіс шығады.
Dialogue: 0,0:10:40.60,0:10:44.08,Default,,0,0,0,,Иіскеуге болмайды. Еркектер иіскейтін хоббиім жоқ.
Dialogue: 0,0:10:46.39,0:10:47.43,Default,,0,0,0,,Осы уақытта
Dialogue: 0,0:10:51.30,0:10:54.95,Default,,0,0,0,,Бұл жай ғана менің қиялым болды ма? Бұл мүлдем оғаш емес.
Dialogue: 0,0:10:55.17,0:10:59.34,Default,,0,0,0,,Боз Сью, қайтып оралып, мына қызды тазалайық.
Dialogue: 0,0:10:59.52,0:11:00.69,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:11:00.82,0:11:01.69,Default,,0,0,0,,Мен сені жіберейін бе?
Dialogue: 0,0:11:02.00,0:11:04.95,Default,,0,0,0,,«Дыбыс бомбасы» Мазалады
Dialogue: 0,0:11:06.04,0:11:09.17,Default,,0,0,0,,Келесі мақсатым —
Dialogue: 0,0:11:10.65,0:11:11.95,Default,,0,0,0,,«Айна сиқыры»
Dialogue: 0,0:11:12.56,0:11:12.95,Default,,0,0,0,,О
Dialogue: 0,0:11:13.00,0:11:13.34,Default,,0,0,0,,О
Dialogue: 0,0:11:13.65,0:11:14.87,Default,,0,0,0,,Толық айна
Dialogue: 0,0:11:16.56,0:11:19.26,Default,,0,0,0,,Біраз уақытқа кету мүмкін емес
Dialogue: 0,0:11:19.26,0:11:21.65,Default,,0,0,0,,Өзіңнің аянышты жүзіңе қара
Dialogue: 0,0:11:26.69,0:11:27.82,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:11:28.39,0:11:29.69,Default,,0,0,0,,Бұл элемент 4
Dialogue: 0,0:11:29.73,0:11:34.21,Default,,0,0,0,,Оны «Ертегінің» қоқысы жойды ма?
Dialogue: 0,0:11:34.56,0:11:37.69,Default,,0,0,0,,Қоқыстан жеңілгендер де қоқыс.
Dialogue: 0,0:11:37.73,0:11:40.95,Default,,0,0,0,,Эй, қайтып келдің, Гаджил-сан?
Dialogue: 0,0:11:40.95,0:11:43.30,Default,,0,0,0,,Бұл кәдесый, ұстаз.
Dialogue: 0,0:11:45.47,0:11:48.34,Default,,0,0,0,,Уау, бұл тез болды.
Dialogue: 0,0:11:48.43,0:11:51.69,Default,,0,0,0,,Бірақ сіз жақсы таптыңыз, Қажир мырза.
Dialogue: 0,0:11:51.91,0:11:55.78,Default,,0,0,0,,Айдаһар өлтірушінің мұрнын бағалама.
Dialogue: 0,0:11:56.00,0:11:57.87,Default,,0,0,0,,Сен тірісің бе?
Dialogue: 0,0:11:58.00,0:12:00.43,Default,,0,0,0,,Әйтпесе мағынасы жоқ
Dialogue: 0,0:12:01.69,0:12:03.73,Default,,0,0,0,,Мен қатты соққыға жығылдым.
Dialogue: 0,0:12:04.17,0:12:05.08,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:12:11.65,0:12:13.56,Default,,0,0,0,,Тірі сияқты
Dialogue: 0,0:12:13.60,0:12:18.00,Default,,0,0,0,,Менің гильдиямнан күткендей, ең күшті сиқыршы
Dialogue: 0,0:12:21.65,0:12:27.34,Default,,0,0,0,,Барлық ертегілер, осы дауысты мұқият тыңдаңыздар.
Dialogue: 0,0:12:27.39,0:12:28.00,Default,,0,0,0,,Не?
Dialogue: 0,0:12:28.17,0:12:29.43,Default,,0,0,0,,Мастер Хосе.
Dialogue: 0,0:12:29.56,0:12:30.87,Default,,0,0,0,,Гуо
Dialogue: 0,0:12:31.04,0:12:31.95,Default,,0,0,0,,Бұл дауыс
Dialogue: 0,0:12:32.26,0:12:33.13,Default,,0,0,0,,Люси
Dialogue: 0,0:12:33.73,0:12:34.91,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:12:35.04,0:12:38.43,Default,,0,0,0,,Біз Люсиді ұстап алдық
Dialogue: 0,0:12:38.47,0:12:42.65,Default,,0,0,0,,Иә, бірінші мақсат орындалды.
Dialogue: 0,0:12:43.00,0:12:47.78,Default,,0,0,0,,Бізге бір ғана мақсат қалды.
Dialogue: 0,0:12:48.47,0:12:53.26,Default,,0,0,0,,Бұл сіздің жойылуыңыз, бейбақтар.
Dialogue: 0,0:12:53.69,0:12:54.91,Default,,0,0,0,,Рух толқындарын қолдануды да ұмытып кеткенмін
Dialogue: 0,0:13:06.65,0:13:08.82,Default,,0,0,0,,Кешіріңіз Люси
Dialogue: 0,0:13:09.13,0:13:12.04,Default,,0,0,0,,Мен сені қорғай алмадым
Dialogue: 0,0:13:12.47,0:13:16.39,Default,,0,0,0,,Кешіріңіз, кешіріңіз
Dialogue: 0,0:13:19.82,0:13:22.17,Default,,0,0,0,,Менде жағымсыз сезім болды.
Dialogue: 0,0:13:23.17,0:13:26.73,Default,,0,0,0,,Бірақ мен ертерек келгенімді қалаймын.
Dialogue: 0,0:13:28.30,0:13:31.60,Default,,0,0,0,,Жоқ, мен қорықтым.
Dialogue: 0,0:13:32.91,0:13:36.56,Default,,0,0,0,,Люси, мен саған жақындаймын.
Dialogue: 0,0:13:40.43,0:13:42.04,Default,,0,0,0,,Жаман
Dialogue: 0,0:13:44.43,0:13:48.82,Default,,0,0,0,,Неткен аянышты жүз.
Dialogue: 0,0:13:51.00,0:13:53.78,Default,,0,0,0,,Менің ойымша, Карен.
Dialogue: 0,0:14:01.56,0:14:02.87,Default,,0,0,0,,Не болды?
Dialogue: 0,0:14:02.91,0:14:05.95,Default,,0,0,0,,«Көлеңкелер» көбейіп жатқан жоқ па?
Dialogue: 0,0:14:08.00,0:14:11.91,Default,,0,0,0,,Маған үзіліс беріңізші, сіз әлі осылай істеп жатырсыз ба?
Dialogue: 0,0:14:18.34,0:14:20.43,Default,,0,0,0,,Люсиді бақылаңыз
Dialogue: 0,0:14:21.65,0:14:25.34,Default,,0,0,0,,Гильдияда қателер бар.
Dialogue: 0,0:14:25.60,0:14:27.13,Default,,0,0,0,,Саламандер Мокай
Dialogue: 0,0:14:27.17,0:14:28.21,Default,,0,0,0,,Иә.
Dialogue: 0,0:14:29.13,0:14:35.26,Default,,0,0,0,,Дегенмен, бұдан былай ғажайыптар болмайтынын еске саламын.
Dialogue: 0,0:14:36.04,0:14:39.00,Default,,0,0,0,,Мен оны өзім тазалаймын.
Dialogue: 0,0:14:40.34,0:14:42.91,Default,,0,0,0,,Боқ Люси
Dialogue: 0,0:14:46.95,0:14:48.26,Default,,0,0,0,,Нацу
Dialogue: 0,0:14:48.43,0:14:49.00,Default,,0,0,0,,Эльза
Dialogue: 0,0:14:50.47,0:14:55.60,Default,,0,0,0,,Қуатыңызды босатыңыз
Dialogue: 0,0:14:58.00,0:15:03.69,Default,,0,0,0,,Сізде әлі де әрекетсіз күш бар
Dialogue: 0,0:15:04.82,0:15:11.26,Default,,0,0,0,,Өзіңізге сеніңіз және шақырыңыз
Dialogue: 0,0:15:13.00,0:15:14.91,Default,,0,0,0,,Қазір уақыт
Dialogue: 0,0:15:16.17,0:15:20.21,Default,,0,0,0,,Люси мен гильдияны қорғаңыз.
Dialogue: 0,0:15:21.30,0:15:23.26,Default,,0,0,0,,Нацуға барыңыз
Dialogue: 0,0:15:23.95,0:15:27.78,Default,,0,0,0,,Менен асып түсетін адам сенсің.
Dialogue: 0,0:15:51.60,0:15:53.13,Default,,0,0,0,,Нацу?
Dialogue: 0,0:15:54.73,0:15:55.87,Default,,0,0,0,,Макаров
Dialogue: 0,0:15:57.52,0:15:58.78,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:16:01.00,0:16:03.04,Default,,0,0,0,,Сіз әлі демалуыңыз керек.
Dialogue: 0,0:16:05.39,0:16:07.56,Default,,0,0,0,,Мені тыңдасаң да
Dialogue: 0,0:16:09.04,0:16:10.39,Default,,0,0,0,,Жас ерекшелігін ескере отырып
Dialogue: 0,0:16:10.95,0:16:13.69,Default,,0,0,0,,Сіз тез қалпына келесіз, солай емес пе?
Dialogue: 0,0:16:14.30,0:16:17.73,Default,,0,0,0,,Айтуға тым көп
Dialogue: 0,0:16:19.78,0:16:21.82,Default,,0,0,0,,Сен өлесің бе?
Dialogue: 0,0:16:22.26,0:16:25.47,Default,,0,0,0,,Тек ата-аналық парызыңызды орындаңыз.
Dialogue: 0,0:16:30.04,0:16:31.95,Default,,0,0,0,,Thank you for your help
Dialogue: 0,0:16:38.56,0:16:39.73,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:16:40.56,0:16:42.34,Default,,0,0,0,,Ештеңе өзгермейді
Dialogue: 0,0:16:46.73,0:16:47.39,Default,,0,0,0,,Эльза
Dialogue: 0,0:16:48.91,0:16:49.65,Default,,0,0,0,,Эльза
Dialogue: 0,0:16:50.04,0:16:52.13,Default,,0,0,0,,Бұл да тамаша нәрсе болуы керек.
Dialogue: 0,0:16:52.73,0:16:54.00,Default,,0,0,0,,Мен оны қажетсіз өлуіне жол бермеймін!
Dialogue: 0,0:16:54.17,0:16:55.95,Default,,0,0,0,,Сіз бортқа нешеде отырдыңыз?
Dialogue: 0,0:16:56.00,0:16:57.60,Default,,0,0,0,,Мен жатуым керек
Dialogue: 0,0:16:57.95,0:16:59.00,Default,,0,0,0,,Ой
Dialogue: 0,0:17:01.39,0:17:02.13,Default,,0,0,0,,Ария
Dialogue: 0,0:17:02.82,0:17:05.52,Default,,0,0,0,,Сіз бұл жарақатпен шынымен күрестіңіз бе?
Dialogue: 0,0:17:05.65,0:17:07.04,Default,,0,0,0,,Сіз не ойлап отырсыз?
Dialogue: 0,0:17:07.47,0:17:09.60,Default,,0,0,0,,Арияны сіз жаздыңыз ба деп ойлаймын.
Dialogue: 0,0:17:10.17,0:17:14.43,Default,,0,0,0,,Мен сендерден мені мұндай аянышты күйде көретіндеріңді күтпедім.
Dialogue: 0,0:17:14.91,0:17:17.00,Default,,0,0,0,,Менің әлі алда көп жолым бар.
Dialogue: 0,0:17:19.13,0:17:20.00,Default,,0,0,0,,Не?
Dialogue: 0,0:17:21.13,0:17:22.17,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:17:22.73,0:17:24.17,Default,,0,0,0,,Өлім белгісі
Dialogue: 0,0:17:25.43,0:17:27.43,Default,,0,0,0,,Бұл қандай сезім?
Dialogue: 0,0:17:28.56,0:17:30.69,Default,,0,0,0,,Ханьда болғандай салқындау
Dialogue: 0,0:17:30.73,0:17:32.30,Default,,0,0,0,,Жамандық ауада
Dialogue: 0,0:17:36.13,0:17:38.73,Default,,0,0,0,,Жоқ, бұл керемет болды.
Dialogue: 0,0:17:39.60,0:17:42.60,Default,,0,0,0,,«Ертегінің» барлық сиқыршыларына
Dialogue: 0,0:17:43.52,0:17:44.47,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:17:44.60,0:17:46.39,Default,,0,0,0,,Бұл мені бұлай қызықтырады деп ешқашан ойламаппын.
Dialogue: 0,0:17:46.56,0:17:48.78,Default,,0,0,0,,Шынымды айтсам, олай ойламадым.
Dialogue: 0,0:17:50.08,0:17:52.00,Default,,0,0,0,,Жевитарды жойыңыз
Dialogue: 0,0:17:52.00,0:17:54.39,Default,,0,0,0,,Эдеменді жеңу 4
Dialogue: 0,0:17:55.26,0:17:59.26,Default,,0,0,0,,«Сиқырлы алыпты» тізе бүктіремін.
Dialogue: 0,0:17:59.78,0:18:00.82,Default,,0,0,0,,Мастер Хосе
Dialogue: 0,0:18:01.00,0:18:01.73,Default,,0,0,0,,Осы уақытта Джозеф пен басқалар—
Dialogue: 0,0:18:01.78,0:18:03.26,Default,,0,0,0,,«Фантом» магистрі?
Dialogue: 0,0:18:03.52,0:18:05.26,Default,,0,0,0,,Қандай жаман сиқыр!
Dialogue: 0,0:18:05.91,0:18:08.00,Default,,0,0,0,,Бір-біріне қарама-қарсы тұрғаннан жүрегім айныды.
Dialogue: 0,0:18:08.73,0:18:13.13,Default,,0,0,0,,Маған ләззат алғаныңызға рахмет айтқым келеді.
Dialogue: 0,0:18:13.65,0:18:14.43,Default,,0,0,0,,Эльфман
Dialogue: 0,0:18:14.56,0:18:15.34,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:18:15.69,0:18:17.82,Default,,0,0,0,,Көп.
Dialogue: 0,0:18:20.78,0:18:22.39,Default,,0,0,0,,«Мұздағы макияж»
Dialogue: 0,0:18:22.52,0:18:23.95,Default,,0,0,0,,«Аң қолы»
Dialogue: 0,0:18:24.21,0:18:26.17,Default,,0,0,0,,Күте тұрыңыз, асықпаңыз.
Dialogue: 0,0:18:26.47,0:18:27.73,Default,,0,0,0,,«Темір өгіз» «Табақша»
Dialogue: 0,0:18:28.52,0:18:30.30,Default,,0,0,0,,Күлуді тоқтатыңыз
Dialogue: 0,0:18:34.69,0:18:36.26,Default,,0,0,0,,Эльфман Грей
Dialogue: 0,0:19:06.08,0:19:10.04,Default,,0,0,0,,Ювитерді жеңгеніңізге сенімдімін.
Dialogue: 0,0:19:10.82,0:19:12.56,Default,,0,0,0,,Сен неге тұра аласың?
Dialogue: 0,0:19:13.21,0:19:17.08,Default,,0,0,0,,Достар жүрегімді нығайтады
Dialogue: 0,0:19:18.52,0:19:21.08,Default,,0,0,0,,Мен жақсы көретіндер үшін
Dialogue: 0,0:19:21.52,0:19:23.56,Default,,0,0,0,,Маған бұл дене керек емес.
Dialogue: 0,0:19:23.82,0:19:27.08,Default,,0,0,0,,Күшті, батыл және әдемі
Dialogue: 0,0:19:27.60,0:19:31.39,Default,,0,0,0,,Не деген бүлдіргіш қыз!
Dialogue: 0,0:19:34.52,0:19:38.04,Default,,0,0,0,,Хмм, бұл керемет дыбыс.
Dialogue: 0,0:19:40.87,0:19:43.69,Default,,0,0,0,,Мен жауап ала алмайтын сияқтымын.
Dialogue: 0,0:19:43.91,0:19:46.78,Default,,0,0,0,,Гаджил, тоқтат.
Dialogue: 0,0:19:46.95,0:19:49.43,Default,,0,0,0,,Бұдан артық жасамаңыз.
Dialogue: 0,0:19:50.26,0:19:52.43,Default,,0,0,0,,Себебі менің бос уақытым бар.
Dialogue: 0,0:19:53.30,0:19:55.08,Default,,0,0,0,,Мастер де тамаша
Dialogue: 0,0:19:55.56,0:19:58.04,Default,,0,0,0,,Кішкентай қызды қорғауға рұқсат етіңіз.
Dialogue: 0,0:19:58.60,0:20:01.08,Default,,0,0,0,,Мен Хаетмонды өлтіретін адаммын.
Dialogue: 0,0:20:02.34,0:20:05.82,Default,,0,0,0,,Жалқаулықты осылай жеңу жақсы болар еді.
Dialogue: 0,0:20:05.87,0:20:08.43,Default,,0,0,0,,Шебер білсе
Dialogue: 0,0:20:08.47,0:20:10.26,Default,,0,0,0,,Сіз мұны жай ғана жасай алмайсыз.
Dialogue: 0,0:20:12.04,0:20:13.08,Default,,0,0,0,,Шабуыл шаңы!
Dialogue: 0,0:20:13.34,0:20:15.43,Default,,0,0,0,,Маған бұл әйелдің қайдан келгені бәрібір.
Dialogue: 0,0:20:15.69,0:20:17.60,Default,,0,0,0,,Мен үшін бұл қоқыс
Dialogue: 0,0:20:18.60,0:20:21.47,Default,,0,0,0,,Ал ол әйел болса да, ол бәрібір сиқыршы.
Dialogue: 0,0:20:22.08,0:20:25.65,Default,,0,0,0,,Гильдияға кірген кезде дайындалу керек.
Dialogue: 0,0:20:25.82,0:20:27.60,Default,,0,0,0,,Сондықтан да тым көп
Dialogue: 0,0:20:27.78,0:20:28.73,Default,,0,0,0,,Мен жеңдім.
Dialogue: 0,0:20:28.87,0:20:31.43,Default,,0,0,0,,Қожа сізге ұрысады!
Dialogue: 0,0:20:31.65,0:20:34.17,Default,,0,0,0,,Егер бұлай болса, мен сендерді кінәлаймын.
Dialogue: 0,0:20:35.47,0:20:36.21,Default,,0,0,0,,Мен бұрыннан…
Dialogue: 0,0:20:36.69,0:20:38.73,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:20:38.91,0:20:40.82,Default,,0,0,0,,Мен бұл әйелдің бай екенін білгенде
Dialogue: 0,0:20:40.95,0:20:43.17,Default,,0,0,0,,«Есек» жігіттер де шарасыз.
Dialogue: 0,0:20:45.82,0:20:49.04,Default,,0,0,0,,Балалар сендер шынымен ақымақсыңдар.
Dialogue: 0,0:20:49.34,0:20:52.82,Default,,0,0,0,,Сені аяп, көзіме жас келеді.
Dialogue: 0,0:20:53.69,0:20:56.08,Default,,0,0,0,,Сіз не ойлап отырсыз?
Dialogue: 0,0:20:56.30,0:20:58.34,Default,,0,0,0,,Гаджилді арандату
Dialogue: 0,0:20:58.69,0:21:01.73,Default,,0,0,0,,«Елес лорд» Аруақтардың Иесі
Dialogue: 0,0:21:02.17,0:21:04.78,Default,,0,0,0,,Бұл ақымақ. Мен мүлде қорықпаймын.
Dialogue: 0,0:21:05.13,0:21:06.69,Default,,0,0,0,,Бұл дұрыс, дұрыс
Dialogue: 0,0:21:09.43,0:21:13.34,Default,,0,0,0,,Бұл жағдайда менмен болу қиын.
Dialogue: 0,0:21:13.87,0:21:16.47,Default,,0,0,0,,Мен мұндай нәрсені жек көрмеймін.
Dialogue: 0,0:21:18.04,0:21:21.43,Default,,0,0,0,,Бірақ менің қалағаным - шлюха емес.
Dialogue: 0,0:21:21.78,0:21:23.43,Default,,0,0,0,,Бұл айқай
Dialogue: 0,0:21:23.52,0:21:26.56,Default,,0,0,0,,Неге көбірек айқайламайсың?
Dialogue: 0,0:21:27.00,0:21:29.87,Default,,0,0,0,,Олай болса мені тоқтатуға тырыс.
Dialogue: 0,0:21:30.52,0:21:34.87,Default,,0,0,0,,Олай жасасаң, одан бетер қиыншылыққа тап боласың.
Dialogue: 0,0:21:36.47,0:21:38.00,Default,,0,0,0,,Қызықты көрінеді
Dialogue: 0,0:21:38.30,0:21:39.26,Default,,0,0,0,,Маған тыңдауға рұқсат етіңіз.
Dialogue: 0,0:21:40.04,0:21:43.78,Default,,0,0,0,,«Ертегі» сізді ешқашан кешірмейді.
Dialogue: 0,0:21:43.95,0:21:46.13,Default,,0,0,0,,Өйткені бұл гильдия түрі.
Dialogue: 0,0:21:47.52,0:21:51.47,Default,,0,0,0,,Сіз әлемдегі ең қорқынышты гильдияның көлеңкесінде тұрсыз.
Dialogue: 0,0:21:51.65,0:21:53.69,Default,,0,0,0,,Мен күнде қорқатын боламын
Dialogue: 0,0:21:54.52,0:21:55.78,Default,,0,0,0,,Өмірімнің соңына дейін
Dialogue: 0,0:21:56.04,0:21:58.21,Default,,0,0,0,,Бұл қызықты көрінеді.
Dialogue: 0,0:21:58.34,0:22:00.47,Default,,0,0,0,,Көріп көрейік
Dialogue: 0,0:22:01.47,0:22:02.52,Default,,0,0,0,,Гаджил
Dialogue: 0,0:22:02.52,0:22:03.03,Default,,0,0,0,,Тоқта
Dialogue: 0,0:22:19.73,0:22:21.00,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:22:21.47,0:22:23.30,Default,,0,0,0,,Мен оны иісінен байқадым.
Dialogue: 0,0:22:24.00,0:22:25.43,Default,,0,0,0,,Саламандр
Dialogue: 0,0:22:25.95,0:22:27.87,Default,,0,0,0,,Гаджил
Dialogue: 0,0:24:06.91,0:24:08.21,Default,,0,0,0,,«Темір айдаһар өлтіруші»
Dialogue: 0,0:24:08.26,0:24:09.82,Default,,0,0,0,,Менің ойымша, бұл темірді жейді.
Dialogue: 0,0:24:09.87,0:24:10.73,Default,,0,0,0,,Мүмкін.
Dialogue: 0,0:24:10.78,0:24:13.00,Default,,0,0,0,,Дәл Нацудың жалын жеп жатқаны сияқты.
Dialogue: 0,0:24:13.00,0:24:15.56,Default,,0,0,0,,Ол бірдей қасиеттері бар заттарды жеуі керек.
Dialogue: 0,0:24:15.60,0:24:19.47,Default,,0,0,0,,Сонда Хаппи да «Балық айдаһар өлтіруші» бола алады, солай ма?
Dialogue: 0,0:24:19.47,0:24:23.43,Default,,0,0,0,,Айдаһар балық сәл салқын болуы мүмкін
Dialogue: 0,0:24:27.00,0:24:30.00,Default,,0,0,0,,Бірақ «айдаһардың айқайы» балықпен қалай естіледі?
Dialogue: 0,0:24:30.00,0:24:32.08,Default,,0,0,0,,Ал, балық тесіктен секіреді.
Dialogue: 0,0:24:32.30,0:24:34.38,Default,,0,0,0,,Ол көзге көрінбейді.
Dialogue: 0,0:24:35.88,0:24:41.88,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory