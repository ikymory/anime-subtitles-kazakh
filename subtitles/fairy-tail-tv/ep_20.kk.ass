Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.86,0:00:03.30,Default,,0,0,0,,Барлығы теледидар алдында
Dialogue: 0,0:00:03.78,0:00:05.34,Default,,0,0,0,,«Fairy Tail» фильмін көргенде
Dialogue: 0,0:00:05.34,0:00:06.65,Default,,0,0,0,,Бөлмені жарықтандырыңыз
Dialogue: 0,0:00:07.08,0:00:08.99,Default,,0,0,0,,Теледидардан алыстап, оны қараңыз.
Dialogue: 0,0:00:11.82,0:00:15.56,Default,,0,0,0,,Бұл Магонорияның шығыс орманы.
Dialogue: 0,0:00:15.82,0:00:19.91,Default,,0,0,0,,Бұл сиқырлы күш мекендеген жұмбақ орман деп те айтылады.
Dialogue: 0,0:00:22.39,0:00:24.82,Default,,0,0,0,,Мен роман жазумен айналысамын.
Dialogue: 0,0:00:25.13,0:00:27.73,Default,,0,0,0,,Неліктен бізге балық аулауға бару керек?
Dialogue: 0,0:00:28.04,0:00:32.39,Default,,0,0,0,,Жақсы идеяны таба алмасаңыз, ол шірік деп ойлаймын.
Dialogue: 0,0:00:32.60,0:00:36.43,Default,,0,0,0,,Жақсы Мұндай кезде сізге қарқынды өзгерту қажет.
Dialogue: 0,0:00:36.52,0:00:38.32,Default,,0,0,0,,Неліктен балық аулап жүрсің?
Dialogue: 0,0:00:38.39,0:00:41.43,Default,,0,0,0,,Өйткені балық Ойраның сүйікті тағамы.
Dialogue: 0,0:00:41.43,0:00:43.08,Default,,0,0,0,,Сонымен
Dialogue: 0,0:00:43.13,0:00:46.65,Default,,0,0,0,,Неліктен мен сенің сүйікті балықтарыңды ұстауым керек?
Dialogue: 0,0:00:47.21,0:00:48.43,Default,,0,0,0,,келді
Dialogue: 0,0:00:48.47,0:00:49.78,Default,,0,0,0,,Абайлаңыз.
Dialogue: 0,0:00:49.82,0:00:51.12,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,0:00:53.39,0:00:55.04,Default,,0,0,0,,Жоғары
Dialogue: 0,0:00:55.32,0:00:57.30,Default,,0,0,0,,Сонымен, Упа деген не?
Dialogue: 0,0:00:57.78,0:01:00.47,Default,,0,0,0,,Олар әлі де көңілді жүрген сияқты.
Dialogue: 0,0:02:42.43,0:02:46.04,Default,,0,0,0,,Бұл балық. Бұл балық. Мен бақыттымын.
Dialogue: 0,0:02:46.23,0:02:47.86,Default,,0,0,0,,Ума Ума Упа
Dialogue: 0,0:02:47.86,0:02:50.63,Default,,0,0,0,,Білесің бе, мен бала емеспін.
Dialogue: 0,0:02:50.71,0:02:51.60,Default,,0,0,0,,Жауап беріңіз…
Dialogue: 0,0:02:52.47,0:02:53.47,Default,,0,0,0,,Олай айтсаң, тіпті Дайкоку аға да қарсылық білдіре алмайды.
Dialogue: 0,0:02:53.97,0:02:54.91,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:02:54.95,0:02:57.17,Default,,0,0,0,,Балықтың дәмі шикі.
Dialogue: 0,0:02:57.23,0:02:58.10,Default,,0,0,0,,Хмм, жарай…
Dialogue: 0,0:02:58.21,0:02:59.65,Default,,0,0,0,,Сіз мұны жасағаныңыз өте жақсы.
Dialogue: 0,0:02:59.65,0:03:02.21,Default,,0,0,0,,Маған ұнамайды Маған ұнамайды Мен оны шикі түрде жегім келді
Dialogue: 0,0:03:02.26,0:03:04.30,Default,,0,0,0,,Бұл мен ұстаған балық шығар.
Dialogue: 0,0:03:04.47,0:03:06.26,Default,,0,0,0,,Сіз де мұны істей аласыз, тек балық аулау арқылы.
Dialogue: 0,0:03:06.47,0:03:07.52,Default,,0,0,0,,Балық
Dialogue: 0,0:03:08.21,0:03:09.86,Default,,0,0,0,,Сүйектер мен қабықтар
Dialogue: 0,0:03:10.17,0:03:13.21,Default,,0,0,0,,Бұл дәмді болды
Dialogue: 0,0:03:14.17,0:03:15.17,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:03:15.82,0:03:19.12,Default,,0,0,0,,Біздің достығымыз аяқталды.
Dialogue: 0,0:03:19.15,0:03:20.76,Default,,0,0,0,,Бұл споркон драмасы емес.
Dialogue: 0,0:03:22.60,0:03:23.99,Default,,0,0,0,,Мені қума
Dialogue: 0,0:03:24.13,0:03:24.99,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:03:25.00,0:03:27.69,Default,,0,0,0,,Мен тым қыңыр болып, солай айтсам ғой.
Dialogue: 0,0:03:27.78,0:03:29.39,Default,,0,0,0,,Қыздар сені жек көреді
Dialogue: 0,0:03:34.52,0:03:35.99,Default,,0,0,0,,Суық жүрек Суық жүрек
Dialogue: 0,0:03:36.08,0:03:37.39,Default,,0,0,0,,Тез кешірім сұра.
Dialogue: 0,0:03:37.43,0:03:39.95,Default,,0,0,0,,Урусендайо Такку
Dialogue: 0,0:03:40.86,0:03:43.34,Default,,0,0,0,,Қандай жағдай болмасын, жаман сезіледі.
Dialogue: 0,0:03:54.13,0:03:57.86,Default,,0,0,0,,Бұл «Ертегі» мұрағаты
Dialogue: 0,0:03:58.04,0:04:00.73,Default,,0,0,0,,Мира-сан, сен не істеп жатырсың?
Dialogue: 0,0:04:01.13,0:04:03.17,Default,,0,0,0,,Ескі материалдарды жүйелеу
Dialogue: 0,0:04:03.34,0:04:05.08,Default,,0,0,0,,Мен де көмектесемін
Dialogue: 0,0:04:05.39,0:04:06.99,Default,,0,0,0,,Мен сізге бір жақсылық сұрасам болады ма?
Dialogue: 0,0:04:07.00,0:04:09.26,Default,,0,0,0,,Иә, бұл арзан.
Dialogue: 0,0:04:12.26,0:04:14.99,Default,,0,0,0,,Эй, мен Нацуды қорқынышты деп ойламаймын.
Dialogue: 0,0:04:15.69,0:04:18.43,Default,,0,0,0,,Бірақ мұның несі сүйкімді?
Dialogue: 0,0:04:18.56,0:04:19.60,Default,,0,0,0,,Менің ойымша, солай
Dialogue: 0,0:04:19.69,0:04:24.08,Default,,0,0,0,,Бірақ Люсиге Нацудың балаша қыры да ұнайды.
Dialogue: 0,0:04:27.39,0:04:31.52,Default,,0,0,0,,О, жақсысың ба?
Dialogue: 0,0:04:31.65,0:04:35.04,Default,,0,0,0,,Кешіріңіз, мен мұндай нәрсеге үйренбегенмін.
Dialogue: 0,0:04:36.82,0:04:38.34,Default,,0,0,0,,Бұл ненің суреті?
Dialogue: 0,0:04:38.47,0:04:39.82,Default,,0,0,0,,Уф!
Dialogue: 0,0:04:40.52,0:04:42.60,Default,,0,0,0,,Бала кезінен бәрі?
Dialogue: 0,0:04:42.63,0:04:43.28,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:04:43.78,0:04:47.73,Default,,0,0,0,,Сонда мынау сұр, ал оның жанындағы кана?
Dialogue: 0,0:04:48.65,0:04:52.21,Default,,0,0,0,,Макао және Вакаба Вака
Dialogue: 0,0:04:52.91,0:04:57.60,Default,,0,0,0,,Мынау өткір жігіт Нацу, ол мүлде өзгерген жоқ.
Dialogue: 0,0:04:58.30,0:05:01.43,Default,,0,0,0,,Міне, бұл кішкентай айдаһар
Dialogue: 0,0:05:01.43,0:05:02.47,Default,,0,0,0,,Бақытты
Dialogue: 0,0:05:02.63,0:05:03.93,Default,,0,0,0,,Иә
Dialogue: 0,0:05:04.21,0:05:08.08,Default,,0,0,0,,Нацу мен Хаппи бірінші кезекте қалай кездесті?
Dialogue: 0,0:05:08.47,0:05:09.47,Default,,0,0,0,,Иә.
Dialogue: 0,0:05:10.08,0:05:13.99,Default,,0,0,0,,Бұл мен «Ертегі» болғаннан кейін болды.
Dialogue: 0,0:05:14.52,0:05:16.65,Default,,0,0,0,,Осыдан алты жыл бұрын.
Dialogue: 0,0:05:17.32,0:05:18.73,Default,,0,0,0,,Сәлем Нацу
Dialogue: 0,0:05:19.26,0:05:21.82,Default,,0,0,0,,Егер бұл Нацу болса, бұл дуэль немесе жоқ.
Dialogue: 0,0:05:22.13,0:05:23.04,Default,,0,0,0,,Салбыраған көздер
Dialogue: 0,0:05:23.08,0:05:24.21,Default,,0,0,0,,Балық аулайтын көздер
Dialogue: 0,0:05:24.30,0:05:25.82,Default,,0,0,0,,Урусенноо
Dialogue: 0,0:05:26.34,0:05:30.99,Default,,0,0,0,,Ол кезде Нацу Греймен кездескен сайын қорқатын.
Dialogue: 0,0:05:31.52,0:05:33.73,Default,,0,0,0,,Мен дәл қазіргідей сезінемін
Dialogue: 0,0:05:34.17,0:05:35.60,Default,,0,0,0,,Жанып тұрған манжетті жігіт
Dialogue: 0,0:05:35.60,0:05:36.73,Default,,0,0,0,,Бачикайдзин
Dialogue: 0,0:05:37.17,0:05:38.82,Default,,0,0,0,,Екеуің доғарыңдар.
Dialogue: 0,0:05:39.82,0:05:42.56,Default,,0,0,0,,Және екеуінің арасындағы тартысты тоқтату
Dialogue: 0,0:05:42.73,0:05:43.69,Default,,0,0,0,,Өйткені, Эльза
Dialogue: 0,0:05:44.21,0:05:47.82,Default,,0,0,0,,Бұл Ұрусен, сондықтан онымен айналысатын адам боласыз.
Dialogue: 0,0:05:47.95,0:05:48.82,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:05:51.91,0:05:55.39,Default,,0,0,0,,Жақсы, енді қызықсыз төбелеске түспе.
Dialogue: 0,0:05:56.21,0:05:56.86,Default,,0,0,0,,Noisei
Dialogue: 0,0:05:57.30,0:05:58.39,Default,,0,0,0,,Келесі жолы мен жеңемін
Dialogue: 0,0:06:03.65,0:06:05.73,Default,,0,0,0,,Нацу да солай болды
Dialogue: 0,0:06:05.86,0:06:08.56,Default,,0,0,0,,Ұрысудан басқа ештеңе жоқ.
Dialogue: 0,0:06:09.73,0:06:12.60,Default,,0,0,0,,Кейде жалғыз көрінетін.
Dialogue: 0,0:06:13.30,0:06:14.58,Default,,0,0,0,,Және бір күні
Dialogue: 0,0:06:19.65,0:06:22.73,Default,,0,0,0,,Мен Грейді де, Эрзаны да бір күні жеңемін.
Dialogue: 0,0:06:29.32,0:06:32.52,Default,,0,0,0,,Жоқ, ауырмайды.
Dialogue: 0,0:06:33.43,0:06:35.12,Default,,0,0,0,,Қ-қандай?
Dialogue: 0,0:06:37.86,0:06:41.04,Default,,0,0,0,,Бұл жұмыртқа. Мен жұмыртқа алдым.
Dialogue: 0,0:06:41.60,0:06:43.82,Default,,0,0,0,,Мынау қайда?
Dialogue: 0,0:06:43.91,0:06:45.52,Default,,0,0,0,,Мен оны шығыс орманнан алдым.
Dialogue: 0,0:06:45.65,0:06:46.86,Default,,0,0,0,,Шығыс орманы
Dialogue: 0,0:06:47.04,0:06:50.21,Default,,0,0,0,,Эй, сен Чихоға соншалықты қамқор емессің бе?
Dialogue: 0,0:06:50.21,0:06:51.65,Default,,0,0,0,,Бәріміз бірге тамақтанайық?
Dialogue: 0,0:06:51.76,0:06:52.80,Default,,0,0,0,,Сұр түсті киім
Dialogue: 0,0:06:53.91,0:06:57.17,Default,,0,0,0,,Қалжың емес, бұл айдаһар жұмыртқасы.
Dialogue: 0,0:06:57.17,0:06:58.12,Default,,0,0,0,,Мен қайтып барамын
Dialogue: 0,0:06:58.17,0:06:59.04,Default,,0,0,0,,Трагон
Dialogue: 0,0:06:59.13,0:07:02.69,Default,,0,0,0,,Қараңдаршы, мұндағы өрнектер айдаһардың тырнағына ұқсайды.
Dialogue: 0,0:07:03.00,0:07:03.91,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:07:04.00,0:07:07.56,Default,,0,0,0,,Айтпақшы, ата, маған айдаһар тууға рұқсат етіңіз.
Dialogue: 0,0:07:07.56,0:07:09.12,Default,,0,0,0,,Не айтып тұрсың, ақымақ?
Dialogue: 0,0:07:10.04,0:07:13.91,Default,,0,0,0,,Бұл дүниеде өмірді қорлайтын сиқыр жоқ.
Dialogue: 0,0:07:14.04,0:07:16.34,Default,,0,0,0,,Өмір махаббаттан туады
Dialogue: 0,0:07:16.47,0:07:18.99,Default,,0,0,0,,Оған ешқандай сиқыр тие алмайды.
Dialogue: 0,0:07:22.60,0:07:24.78,Default,,0,0,0,,Не айтып тұрғаныңызды түсінбеймін.
Dialogue: 0,0:07:25.52,0:07:27.47,Default,,0,0,0,,Брат болу ерте болды ма?
Dialogue: 0,0:07:27.69,0:07:29.04,Default,,0,0,0,,Басқаша айтқанда, егер сіз оны жай ғана шығарсаңыз
Dialogue: 0,0:07:29.13,0:07:32.56,Default,,0,0,0,,Мен саған бар күшіңді салып, бар күшіңді сынап көр деп жатырмын.
Dialogue: 0,0:07:32.82,0:07:35.56,Default,,0,0,0,,Өйткені мен әдетте заттарды жоюмен айналысамын.
Dialogue: 0,0:07:35.73,0:07:38.39,Default,,0,0,0,,Тіршіліктің пайда болуы туралы білуге жақсы мүмкіндік
Dialogue: 0,0:07:38.91,0:07:39.30,Default,,0,0,0,,Эльза
Dialogue: 0,0:07:39.69,0:07:40.56,Default,,0,0,0,,Онда болды ма?
Dialogue: 0,0:07:40.80,0:07:43.02,Default,,0,0,0,,Эльза қайтып келді
Dialogue: 0,0:07:44.08,0:07:47.39,Default,,0,0,0,,Өткен жолды жалғастыра отырып, келіңіздер.
Dialogue: 0,0:07:47.78,0:07:49.12,Default,,0,0,0,,Әлі де қорқасыз ба?
Dialogue: 0,0:07:49.78,0:07:52.97,Default,,0,0,0,,Ойланып қарасам, әлі шешілген жоқ.
Dialogue: 0,0:07:53.30,0:07:54.17,Default,,0,0,0,,Мира
Dialogue: 0,0:07:57.78,0:08:00.47,Default,,0,0,0,,Бұл Мира бұл Мира ма?
Dialogue: 0,0:08:00.52,0:08:01.56,Default,,0,0,0,,Иә, бірақ
Dialogue: 0,0:08:01.69,0:08:03.56,Default,,0,0,0,,-дан басқаның бәрі мүлдем басқа.
Dialogue: 0,0:08:03.69,0:08:06.95,Default,,0,0,0,,Сондай-ақ Мира-сан Эльзамен ұйықтап қалады.
Dialogue: 0,0:08:08.47,0:08:10.47,Default,,0,0,0,,Гудабаре Эльза
Dialogue: 0,0:08:10.47,0:08:11.95,Default,,0,0,0,,Жүрейік, Мирадже
Dialogue: 0,0:08:13.95,0:08:14.91,Default,,0,0,0,,Ол қаншық.
Dialogue: 0,0:08:15.00,0:08:16.82,Default,,0,0,0,,Ол құпия әйел.
Dialogue: 0,0:08:16.82,0:08:18.04,Default,,0,0,0,,Кеудемді әйел
Dialogue: 0,0:08:18.04,0:08:18.86,Default,,0,0,0,,Гаригари әйел
Dialogue: 0,0:08:19.52,0:08:20.30,Default,,0,0,0,,май
Dialogue: 0,0:08:20.43,0:08:21.30,Default,,0,0,0,,Көзілдірік
Dialogue: 0,0:08:21.30,0:08:22.21,Default,,0,0,0,,Төмен деңгей
Dialogue: 0,0:08:22.34,0:08:25.69,Default,,0,0,0,,Эльза мұнымен бізді қорқытпа деді.
Dialogue: 0,0:08:25.69,0:08:26.95,Default,,0,0,0,,Бұл ақылсыз.
Dialogue: 0,0:08:27.21,0:08:31.86,Default,,0,0,0,,Қарғыс атсын, мен Эрзаны да, Мираны да бір уақытта жеңемін.
Dialogue: 0,0:08:32.02,0:08:33.21,Default,,0,0,0,,толығымен
Dialogue: 0,0:08:33.82,0:08:37.47,Default,,0,0,0,,Егер сіз тым күшті әрекет етсеңіз, қыздар сізді жек көреді.
Dialogue: 0,0:08:37.82,0:08:39.82,Default,,0,0,0,,Бұл тітіркендіргіш, Лисанна.
Dialogue: 0,0:08:39.87,0:08:43.86,Default,,0,0,0,,Эй Нацу, мен сенімен жұмыртқаны көтере аламын ба?
Dialogue: 0,0:08:43.91,0:08:46.08,Default,,0,0,0,,О, сен маған көмектесе аласың ба?
Dialogue: 0,0:08:46.08,0:08:50.39,Default,,0,0,0,,Иә, қызық көрінеді, жұмыртқа өсірейік.
Dialogue: 0,0:08:50.69,0:08:52.82,Default,,0,0,0,,Оларды көтерудің айырмашылығы жоқ.
Dialogue: 0,0:08:52.82,0:08:54.43,Default,,0,0,0,,Мен штрихты қалай шығарамын?
Dialogue: 0,0:08:54.47,0:08:56.21,Default,,0,0,0,,Тек оны қыздырыңыз.
Dialogue: 0,0:08:56.21,0:08:59.91,Default,,0,0,0,,Жылыту Бұл менің мамандығым емес пе?
Dialogue: 0,0:09:02.21,0:09:03.56,Default,,0,0,0,,Одан басқа, сіз
Dialogue: 0,0:09:04.26,0:09:06.17,Default,,0,0,0,,Бұл енді жақсы емес.
Dialogue: 0,0:09:06.26,0:09:08.34,Default,,0,0,0,,Оны қатты итерсең, күйіп қалады.
Dialogue: 0,0:09:08.73,0:09:09.26,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:09.78,0:09:11.99,Default,,0,0,0,,Бұны Адашидің сиқырына қалдыр.
Dialogue: 0,0:09:13.39,0:09:17.82,Default,,0,0,0,,Жануарлардың табаны
Dialogue: 0,0:09:19.02,0:09:20.58,Default,,0,0,0,,О, бұл құс.
Dialogue: 0,0:09:20.78,0:09:21.91,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:22.69,0:09:24.17,Default,,0,0,0,,Осымен жылыну азғындық емес пе?
Dialogue: 0,0:09:24.32,0:09:24.34,Default,,0,0,0,,Сен ақылдысың, Лисанна.
Dialogue: 0,0:09:24.34,0:09:25.47,Default,,0,0,0,,Че, сен ақылдысың, Лисанна.
Dialogue: 0,0:09:25.47,0:09:25.84,Default,,0,0,0,,Сен ақылдысың, Лисанна. Не болды, Эльфман?
Dialogue: 0,0:09:25.84,0:09:27.56,Default,,0,0,0,,Не болып жатыр, Эльфман?
Dialogue: 0,0:09:27.56,0:09:30.56,Default,,0,0,0,,Тіпті Лисанна толық денелі Тейтаверді пайдалана алады.
Dialogue: 0,0:09:30.91,0:09:32.47,Default,,0,0,0,,Мен оны пайдалана алмаймын.
Dialogue: 0,0:09:32.80,0:09:34.41,Default,,0,0,0,,Біз бір командада болсақ та
Dialogue: 0,0:09:34.47,0:09:37.04,Default,,0,0,0,,Аа, екеуің бір сиқырды қолданасыңдар.
Dialogue: 0,0:09:37.08,0:09:38.60,Default,,0,0,0,,Егер мен де қолдана алсам
Dialogue: 0,0:09:38.73,0:09:41.30,Default,,0,0,0,,Мен құсқа айналып, паракелерді іздей аламын.
Dialogue: 0,0:09:41.43,0:09:42.12,Default,,0,0,0,,Паракет
Dialogue: 0,0:09:42.65,0:09:46.17,Default,,0,0,0,,Мен оны қадірледім, бірақ ол жоғалып кетті.
Dialogue: 0,0:09:46.43,0:09:47.60,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:48.87,0:09:51.65,Default,,0,0,0,,Мен де осылай жұмыртқа алғым келеді.
Dialogue: 0,0:09:51.78,0:09:56.34,Default,,0,0,0,,Иә, бұл Эльфман ма? Бұл сүйкімді болды
Dialogue: 0,0:09:56.34,0:09:58.82,Default,,0,0,0,,О, ол басқаша емес.
Dialogue: 0,0:10:00.21,0:10:03.45,Default,,0,0,0,,Магонорияның оңтүстік шығыс саябағы
Dialogue: 0,0:10:05.91,0:10:07.69,Default,,0,0,0,,Мен өз көзқарасыма алаңдаймын
Dialogue: 0,0:10:08.00,0:10:10.08,Default,,0,0,0,,Мен осылай күтуім керек пе?
Dialogue: 0,0:10:10.08,0:10:12.86,Default,,0,0,0,,Иә, бірақ бұл біраз қызықсыз.
Dialogue: 0,0:10:12.87,0:10:14.73,Default,,0,0,0,,Жұмыртқа қозғалды
Dialogue: 0,0:10:18.17,0:10:19.08,Default,,0,0,0,,Не?
Dialogue: 0,0:10:19.47,0:10:23.91,Default,,0,0,0,,Аа, бұл тыныш.
Dialogue: 0,0:10:23.95,0:10:27.95,Default,,0,0,0,,Эй, сен Нацудың мына жұмыртқаны қыздырғанын қаларсың.
Dialogue: 0,0:10:28.15,0:10:29.56,Default,,0,0,0,,Иә, маған.
Dialogue: 0,0:10:29.82,0:10:32.56,Default,,0,0,0,,Иә, сізді не бақытты етеді?
Dialogue: 0,0:10:32.60,0:10:34.65,Default,,0,0,0,,Мені қалайсың ба?
Dialogue: 0,0:10:35.47,0:10:36.47,Default,,0,0,0,,Дыбыс шықты
Dialogue: 0,0:10:36.52,0:10:37.95,Default,,0,0,0,,That's the way it is after all.
Dialogue: 0,0:10:38.00,0:10:40.47,Default,,0,0,0,,Сәлем мына жігіт
Dialogue: 0,0:10:40.56,0:10:43.99,Default,,0,0,0,,Ей, мүмкіндікті пайдаланып мына жұмыртқадан үй жасайық.
Dialogue: 0,0:10:44.00,0:10:45.43,Default,,0,0,0,,Құпия негіз?
Dialogue: 0,0:10:48.34,0:10:51.56,Default,,0,0,0,,Completion What do you think? Керемет үй екен.
Dialogue: 0,0:10:51.65,0:10:53.47,Default,,0,0,0,,Is it necessary to be cool?
Dialogue: 0,0:10:53.69,0:10:54.99,Default,,0,0,0,,Қауіпті
Dialogue: 0,0:10:55.52,0:10:57.95,Default,,0,0,0,,Building a house is difficult.
Dialogue: 0,0:10:58.08,0:10:59.52,Default,,0,0,0,,Player substitution
Dialogue: 0,0:11:00.65,0:11:01.91,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,0:11:04.19,0:11:05.36,Default,,0,0,0,,Үлкен
Dialogue: 0,0:11:06.21,0:11:06.78,Default,,0,0,0,,Қоян, қоян
Dialogue: 0,0:11:06.95,0:11:08.30,Default,,0,0,0,,Бір минут күтіңіз.
Dialogue: 0,0:11:08.43,0:11:11.91,Default,,0,0,0,,Wow, all I did was destroy it.
Dialogue: 0,0:11:11.95,0:11:14.65,Default,,0,0,0,,Чан аяқталды
Dialogue: 0,0:11:14.65,0:11:16.73,Default,,0,0,0,,Oh, that's amazing.
Dialogue: 0,0:11:16.89,0:11:18.93,Default,,0,0,0,,Кіріңіз, кіріңіз.
Dialogue: 0,0:11:18.95,0:11:20.73,Default,,0,0,0,,Transform before that.
Dialogue: 0,0:11:22.39,0:11:26.28,Default,,0,0,0,,Huh, it's quite spacious inside.
Dialogue: 0,0:11:26.28,0:11:27.63,Default,,0,0,0,,Бұл болады
Dialogue: 0,0:11:27.63,0:11:29.02,Default,,0,0,0,,Ал, қазір орнымызға отырайық.
Dialogue: 0,0:11:29.78,0:11:30.60,Default,,0,0,0,,Иә
Dialogue: 0,0:11:33.60,0:11:35.86,Default,,0,0,0,,It feels like a family.
Dialogue: 0,0:11:36.13,0:11:37.08,Default,,0,0,0,,Міне.
Dialogue: 0,0:11:37.21,0:11:40.39,Default,,0,0,0,,Бірақ көрдің бе, әкем бар, анам бар.
Dialogue: 0,0:11:40.43,0:11:42.34,Default,,0,0,0,,Сіздің балаларыңыз жоқ сияқты.
Dialogue: 0,0:11:43.08,0:11:45.67,Default,,0,0,0,,Well, that's not bad either.
Dialogue: 0,0:11:48.87,0:11:51.34,Default,,0,0,0,,Let's warm up the eggs together.
Dialogue: 0,0:11:51.36,0:11:52.36,Default,,0,0,0,,Иә
Dialogue: 0,0:11:55.21,0:11:56.65,Default,,0,0,0,,Жылы.
Dialogue: 0,0:11:57.08,0:11:58.04,Default,,0,0,0,,О
Dialogue: 0,0:11:58.21,0:12:00.17,Default,,0,0,0,,Ah, it moved again.
Dialogue: 0,0:12:00.52,0:12:02.17,Default,,0,0,0,,I wonder if I was born early?
Dialogue: 0,0:12:09.73,0:12:12.34,Default,,0,0,0,,Хаа айдаһар жұмыртқасы
Dialogue: 0,0:12:12.78,0:12:14.69,Default,,0,0,0,,Бұл жерде қаншама адам бар, солай ма?
Dialogue: 0,0:12:15.04,0:12:18.60,Default,,0,0,0,,Аңғал жігіт өзін айдаһар өсіргенін айтты.
Dialogue: 0,0:12:18.60,0:12:20.08,Default,,0,0,0,,Жоқ, солай емес пе?
Dialogue: 0,0:12:20.21,0:12:21.95,Default,,0,0,0,,Жұлдыздан шыққан, жарылған
Dialogue: 0,0:12:22.13,0:12:25.30,Default,,0,0,0,,Құпия негіз салып, жұмыртқамен ойнадым.
Dialogue: 0,0:12:25.30,0:12:25.73,Default,,0,0,0,,Шынымен бе? Ол неге мұнда?
Dialogue: 0,0:12:25.95,0:12:26.78,Default,,0,0,0,,Жақсы бала.
Dialogue: 0,0:12:26.91,0:12:27.78,Default,,0,0,0,,Күн ыстық.
Dialogue: 0,0:12:32.34,0:12:34.13,Default,,0,0,0,,Не істеп жатырсың, Мираджан?
Dialogue: 0,0:12:34.26,0:12:35.95,Default,,0,0,0,,Ол бұрынғысынша қауіпті.
Dialogue: 0,0:12:36.69,0:12:39.99,Default,,0,0,0,,Соңғы уақытта үйде болмаған болсаңыз
Dialogue: 0,0:12:40.04,0:12:42.21,Default,,0,0,0,,Мен Нацудың қасында болғанда
Dialogue: 0,0:12:42.95,0:12:46.21,Default,,0,0,0,,Ол Эльзаның фракциясының адамдарымен жақсы қарым-қатынаста болды.
Dialogue: 0,0:12:46.30,0:12:47.65,Default,,0,0,0,,I don't know that.
Dialogue: 0,0:12:47.69,0:12:49.43,Default,,0,0,0,,Бұл не, Эльза фракциясы?
Dialogue: 0,0:12:50.78,0:12:53.65,Default,,0,0,0,,Эй, мен мына жерден жұмыртқа алдым.
Dialogue: 0,0:12:53.69,0:12:56.43,Default,,0,0,0,,Аа, мына ағаштың басынан құлады.
Dialogue: 0,0:12:56.50,0:12:57.36,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:12:59.95,0:13:01.17,Default,,0,0,0,,Huge
Dialogue: 0,0:13:01.78,0:13:06.43,Default,,0,0,0,,Қатал Монфутаргориан... Мори Балган деген атпен де белгілі
Dialogue: 0,0:13:06.52,0:13:08.26,Default,,0,0,0,,Айтпақшы, менің сүйікті тағамым...
Dialogue: 0,0:13:08.34,0:13:11.08,Default,,0,0,0,,Жұмыртқаны маған бер, мен оны жеймін.
Dialogue: 0,0:13:11.08,0:13:14.52,Default,,0,0,0,,Жүр, менің қобушымды же.
Dialogue: 0,0:13:14.60,0:13:16.91,Default,,0,0,0,,Whoa, it's itchy
Dialogue: 0,0:13:17.04,0:13:18.04,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:13:19.84,0:13:22.39,Default,,0,0,0,,Нацу, күте тұр, мен де.
Dialogue: 0,0:13:22.65,0:13:24.04,Default,,0,0,0,,Лисанна, артта қал.
Dialogue: 0,0:13:24.04,0:13:25.17,Default,,0,0,0,,Бірақ
Dialogue: 0,0:13:26.04,0:13:29.43,Default,,0,0,0,,Мен сенің әкең болсам, сені қорғауым керек еді.
Dialogue: 0,0:13:29.78,0:13:30.34,Default,,0,0,0,,Natsu
Dialogue: 0,0:13:30.87,0:13:33.26,Default,,0,0,0,,Оның үстіне мен айдаһардың баласымын.
Dialogue: 0,0:13:33.30,0:13:36.86,Default,,0,0,0,,Маймылдан жеңілуге ​​шамам жетпейді.
Dialogue: 0,0:13:40.34,0:13:42.69,Default,,0,0,0,,Natsu using magic
Dialogue: 0,0:13:42.91,0:13:47.60,Default,,0,0,0,,Мына маймыл арқанның сабымен ұрысады, мен де оны жалаң қолыммен ұрамын.
Dialogue: 0,0:13:48.43,0:13:50.39,Default,,0,0,0,,How to defeat
Dialogue: 0,0:13:52.00,0:13:55.65,Default,,0,0,0,,Маған келіңдер, тау маймылдары, мен сендерді ақ бояумен жауып, балапан тауының үстіне лақтырамын.
Dialogue: 0,0:13:55.65,0:13:57.04,Default,,0,0,0,,Маған келіңдер, тау маймылдары, мен сендерді ақ бояумен жауып, балапан тауының үстіне лақтырамын.
Dialogue: 0,0:13:57.30,0:13:59.47,Default,,0,0,0,,Мукер!
Dialogue: 0,0:14:00.13,0:14:02.30,Default,,0,0,0,,Менің ойымнан адасып қалған шығармын
Dialogue: 0,0:14:03.91,0:14:05.04,Default,,0,0,0,,Natsu
Dialogue: 0,0:14:15.26,0:14:19.08,Default,,0,0,0,,Ятаятаята... Ятаята
Dialogue: 0,0:14:19.10,0:14:20.93,Default,,0,0,0,,Хехе оңай жеңіс.
Dialogue: 0,0:14:20.93,0:14:22.02,Default,,0,0,0,,It's in tatters.
Dialogue: 0,0:14:26.21,0:14:27.52,Default,,0,0,0,,Жұмыртқалар салқындап қалды.
Dialogue: 0,0:14:27.52,0:14:28.43,Default,,0,0,0,,Тездетіңіз
Dialogue: 0,0:14:29.34,0:14:31.08,Default,,0,0,0,,Hmm, wait, wait.
Dialogue: 0,0:14:31.56,0:14:32.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:33.52,0:14:34.26,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:14:34.56,0:14:35.43,Default,,0,0,0,,Міне.
Dialogue: 0,0:14:37.00,0:14:37.91,Default,,0,0,0,,Қайта оралдын.
Dialogue: 0,0:14:37.91,0:14:39.95,Default,,0,0,0,,Не? Oh...oh one
Dialogue: 0,0:14:40.45,0:14:42.80,Default,,0,0,0,,Return
Dialogue: 0,0:14:43.73,0:14:45.30,Default,,0,0,0,,I'm home
Dialogue: 0,0:14:52.30,0:14:55.04,Default,,0,0,0,,Жаңбыр тоқтамайды.
Dialogue: 0,0:14:56.54,0:14:58.19,Default,,0,0,0,,Уау
Dialogue: 0,0:14:59.91,0:15:02.60,Default,,0,0,0,,Енді ойлап қарасам, туған жердің тірлігі шығар.
Dialogue: 0,0:15:02.71,0:15:03.45,Default,,0,0,0,,Иә
Dialogue: 0,0:15:03.60,0:15:05.39,Default,,0,0,0,,What about food?
Dialogue: 0,0:15:05.47,0:15:06.91,Default,,0,0,0,,Гильдияда тамақ ішу
Dialogue: 0,0:15:07.04,0:15:08.52,Default,,0,0,0,,Pay?
Dialogue: 0,0:15:08.56,0:15:10.47,Default,,0,0,0,,Сол үшін жұмыс істейсің, солай ма?
Dialogue: 0,0:15:11.00,0:15:12.04,Default,,0,0,0,,Мен сені аяймын
Dialogue: 0,0:15:12.32,0:15:13.15,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:15:13.69,0:15:16.43,Default,,0,0,0,,Next time I'll make you something.
Dialogue: 0,0:15:16.73,0:15:18.30,Default,,0,0,0,,Сіз тамақ жасай аласыз ба?
Dialogue: 0,0:15:18.43,0:15:20.69,Default,,0,0,0,,I'll lose to Mira-nee though.
Dialogue: 0,0:15:20.73,0:15:23.82,Default,,0,0,0,,Wait a minute, does that Mira cook?
Dialogue: 0,0:15:23.82,0:15:24.95,Default,,0,0,0,,Мен елестете алмаймын
Dialogue: 0,0:15:25.17,0:15:26.58,Default,,0,0,0,,Бұл қауіпті.
Dialogue: 0,0:15:27.26,0:15:29.04,Default,,0,0,0,,Ал, Эльфман да?
Dialogue: 0,0:15:29.17,0:15:30.43,Default,,0,0,0,,Жаса, істе
Dialogue: 0,0:15:32.04,0:15:33.39,Default,,0,0,0,,It's going to be delicious.
Dialogue: 0,0:15:34.00,0:15:37.34,Default,,0,0,0,,Иә, неге екенін елестете аламын, бұл сізге тым жарасады.
Dialogue: 0,0:15:37.34,0:15:38.99,Default,,0,0,0,,I won't give this egg away.
Dialogue: 0,0:15:39.00,0:15:40.99,Default,,0,0,0,,I won't give this egg away.
Dialogue: 0,0:15:41.00,0:15:43.56,Default,,0,0,0,,A dragon is born, a child of Iknir.
Dialogue: 0,0:15:43.56,0:15:45.82,Default,,0,0,0,,Don't use the egg as a prelude.
Dialogue: 0,0:15:45.95,0:15:47.43,Default,,0,0,0,,Өте жылдам шаң
Dialogue: 0,0:15:47.60,0:15:51.60,Default,,0,0,0,,Білесің бе, мен де жаңа өмірімді асыға күтемін.
Dialogue: 0,0:15:51.87,0:15:53.56,Default,,0,0,0,,That's why we cooperate.
Dialogue: 0,0:15:53.78,0:15:55.86,Default,,0,0,0,,Why are you freaking out?
Dialogue: 0,0:15:56.00,0:15:59.52,Default,,0,0,0,,Ah, I wonder if I was born early?
Dialogue: 0,0:15:59.69,0:16:01.52,Default,,0,0,0,,Natsu is usually violent though.
Dialogue: 0,0:16:01.60,0:16:05.78,Default,,0,0,0,,Мира-ниді көргім келеді, ол кейде мейірімді, кейде сүйкімді.
Dialogue: 0,0:16:06.78,0:16:12.52,Default,,0,0,0,,When I grow up...I'll be Natsu's wife.
Dialogue: 0,0:16:12.67,0:16:15.89,Default,,0,0,0,,What are you saying all of a sudden?
Dialogue: 0,0:16:16.13,0:16:21.13,Default,,0,0,0,,Өйткені Нацу мен оның балалары біз үшін маңызды, сондықтан біз оларға сене аламыз.
Dialogue: 0,0:16:21.17,0:16:22.69,Default,,0,0,0,,А, бір
Dialogue: 0,0:16:23.78,0:16:26.91,Default,,0,0,0,,Why are you blushing? Бұл әзіл болуы керек.
Dialogue: 0,0:16:26.91,0:16:30.08,Default,,0,0,0,,Oh, that's you, right? That's what grandpa said.
Dialogue: 0,0:16:30.08,0:16:31.60,Default,,0,0,0,,Қоқыс?
Dialogue: 0,0:16:31.69,0:16:34.95,Default,,0,0,0,,Қоқыс? Нацу аңғал емес пе?
Dialogue: 0,0:16:34.97,0:16:38.28,Default,,0,0,0,,Kii, you can't beat this guy in a fight.
Dialogue: 0,0:16:41.02,0:16:46.43,Default,,0,0,0,,Әдемі екен.
Dialogue: 0,0:16:46.58,0:16:47.80,Default,,0,0,0,,Иә
Dialogue: 0,0:16:48.91,0:16:52.86,Default,,0,0,0,,I wish this moment was forever
Dialogue: 0,0:16:57.52,0:16:58.91,Default,,0,0,0,,Тағы да жылады.
Dialogue: 0,0:16:58.95,0:16:59.56,Default,,0,0,0,,Иә
Dialogue: 0,0:17:09.87,0:17:12.91,Default,,0,0,0,,Hey, I don't have any eggs.
Dialogue: 0,0:17:13.47,0:17:13.91,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:17:14.04,0:17:16.47,Default,,0,0,0,,Оны кім ұрлады?
Dialogue: 0,0:17:16.52,0:17:17.99,Default,,0,0,0,,Жұмыртқа жоғалып кетті
Dialogue: 0,0:17:18.00,0:17:19.43,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:17:19.52,0:17:20.69,Default,,0,0,0,,Киім
Dialogue: 0,0:17:20.69,0:17:21.65,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:17:21.74,0:17:23.26,Default,,0,0,0,,Сізді раксавыз ба?
Dialogue: 0,0:17:23.34,0:17:24.39,Default,,0,0,0,,I'm not interested.
Dialogue: 0,0:17:24.43,0:17:26.26,Default,,0,0,0,,Spit it out, Elsa.
Dialogue: 0,0:17:26.43,0:17:29.60,Default,,0,0,0,,Әй, бұл біраз тақырыптан тыс емес пе?
Dialogue: 0,0:17:29.91,0:17:31.95,Default,,0,0,0,,Мира-ни, сен жұмыртқаны білмейсің бе?
Dialogue: 0,0:17:31.95,0:17:36.13,Default,,0,0,0,,Білмеймін, Нацу, сен оны өзің жедің.
Dialogue: 0,0:17:36.41,0:17:37.06,Default,,0,0,0,,Эй
Dialogue: 0,0:17:37.08,0:17:40.04,Default,,0,0,0,,Мұны істейік! Ұшып кетіңіз
Dialogue: 0,0:17:40.39,0:17:43.21,Default,,0,0,0,,Сіз мұны істейсіз бе? Мен ұстамаймын.
Dialogue: 0,0:17:43.26,0:17:44.65,Default,,0,0,0,,Сәлем Нацу...
Dialogue: 0,0:17:44.65,0:17:45.34,Default,,0,0,0,,Сен
Dialogue: 0,0:17:46.00,0:17:46.82,Default,,0,0,0,,Балалар, тоқтамайсыңдар ма?
Dialogue: 0,0:17:46.95,0:17:47.95,Default,,0,0,0,,Күтіңіз.
Dialogue: 0,0:17:47.95,0:17:48.34,Default,,0,0,0,,Мені де араластырмаңыз
Dialogue: 0,0:17:48.60,0:17:53.26,Default,,0,0,0,,Бұл шынымен қорқынышты ұрпақ. Мен гильдия бірнеше жылдан кейін қандай болатынын елестеткім келмейді.
Dialogue: 0,0:17:53.52,0:17:57.21,Default,,0,0,0,,Бір-бірімізге қарсы шығу үшін біз бір-бірімізді қабылдауымыз керек.
Dialogue: 0,0:17:57.21,0:18:01.08,Default,,0,0,0,,Бір-бірінің бетін анық көре алады.
Dialogue: 0,0:18:01.13,0:18:04.13,Default,,0,0,0,,Уайымдайтын ештеңе жоқ.
Dialogue: 0,0:18:04.13,0:18:05.13,Default,,0,0,0,,Бұл қоқыс
Dialogue: 0,0:18:05.56,0:18:08.60,Default,,0,0,0,,Менің жұмыртқаларым қайда кетті?
Dialogue: 0,0:18:08.60,0:18:11.34,Default,,0,0,0,,Тацу Жылама, Нацу сен сүйкімдісің
Dialogue: 0,0:18:11.39,0:18:12.82,Default,,0,0,0,,Жылама
Dialogue: 0,0:18:12.82,0:18:14.39,Default,,0,0,0,,Мира, сен неге олай істемейсің?
Dialogue: 0,0:18:14.56,0:18:16.52,Default,,0,0,0,,Қарашы, Нацу да жыламауы керек.
Dialogue: 0,0:18:16.52,0:18:17.73,Default,,0,0,0,,Жылама
Dialogue: 0,0:18:18.13,0:18:20.13,Default,,0,0,0,,Неге оны қайтармайсың?
Dialogue: 0,0:18:20.13,0:18:21.69,Default,,0,0,0,,Мен емеспін, солай ма?
Dialogue: 0,0:18:21.74,0:18:23.56,Default,,0,0,0,,Менің ойымша, сіз оны жеп қойдыңыз.
Dialogue: 0,0:18:23.91,0:18:25.56,Default,,0,0,0,,Нанд және сіз
Dialogue: 0,0:18:25.65,0:18:28.47,Default,,0,0,0,,Жұмыртқа
Dialogue: 0,0:18:28.47,0:18:31.86,Default,,0,0,0,,Ойлап қарасам, Эльфман осылай жұмыртқа алғысы келетінін айтты.
Dialogue: 0,0:18:32.91,0:18:34.47,Default,,0,0,0,,Ол оны жеді ме?
Dialogue: 0,0:18:34.60,0:18:36.43,Default,,0,0,0,,Мен бұған сене алмаймын.
Dialogue: 0,0:18:36.65,0:18:39.04,Default,,0,0,0,,Нацу Лисанна кешіріңіз
Dialogue: 0,0:18:39.08,0:18:41.04,Default,,0,0,0,,Бұл не болды, Эльфман?
Dialogue: 0,0:18:41.04,0:18:41.82,Default,,0,0,0,,Жұмыртқа
Dialogue: 0,0:18:42.43,0:18:45.91,Default,,0,0,0,,Ұрлаған жоқсың, түнде суық болады.
Dialogue: 0,0:18:45.95,0:18:49.26,Default,,0,0,0,,Нацу жақсы ұйықтамайды, жұмыртқаларды жалғыз қалдырады.
Dialogue: 0,0:18:49.34,0:18:50.30,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:18:50.34,0:18:51.04,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:18:51.26,0:18:54.00,Default,,0,0,0,,Иә, мен сиқырды жақсы қолдана алмаймын.
Dialogue: 0,0:18:54.00,0:18:56.65,Default,,0,0,0,,Мен жасырын жұмыртқаны өзім жылытып жүрдім.
Dialogue: 0,0:18:56.65,0:18:57.52,Default,,0,0,0,,О~. Құдай-ай!
Dialogue: 0,0:18:57.52,0:19:00.78,Default,,0,0,0,,Рахмет Эльфман, сен ер адамсың.
Dialogue: 0,0:19:01.60,0:19:04.13,Default,,0,0,0,,Сіз маған шындап күмәндандыңыз.
Dialogue: 0,0:19:04.30,0:19:06.26,Default,,0,0,0,,Бұл өзара емес пе?
Dialogue: 0,0:19:07.34,0:19:08.52,Default,,0,0,0,,Ооо
Dialogue: 0,0:19:09.34,0:19:10.13,Default,,0,0,0,,О
Dialogue: 0,0:19:10.78,0:19:11.65,Default,,0,0,0,,Туған
Dialogue: 0,0:19:17.30,0:19:18.56,Default,,0,0,0,,Мысық па?
Dialogue: 0,0:19:21.04,0:19:22.34,Default,,0,0,0,,Қанаттары өсіп тұр.
Dialogue: 0,0:19:22.43,0:19:23.13,Default,,0,0,0,,...
Dialogue: 0,0:19:23.21,0:19:25.13,Default,,0,0,0,,Бұл мысық емес, көк мысық
Dialogue: 0,0:19:30.47,0:19:31.26,Default,,0,0,0,,Көз
Dialogue: 0,0:19:31.65,0:19:33.08,Default,,0,0,0,,Ай Цукаса
Dialogue: 0,0:19:33.21,0:19:34.69,Default,,0,0,0,,Сүйкімді
Dialogue: 0,0:19:37.43,0:19:41.43,Default,,0,0,0,,Ах, паракет. Менің паракетім қайтып келді.
Dialogue: 0,0:19:42.95,0:19:45.69,Default,,0,0,0,,Бұл қызыл паракет екеніне сенімдімін.
Dialogue: 0,0:19:45.91,0:19:49.47,Default,,0,0,0,,Қарашы, Нацу, дәл қазір бәрі қытырлақ болды.
Dialogue: 0,0:19:50.47,0:19:52.21,Default,,0,0,0,,Өте бақытты көрінеді
Dialogue: 0,0:19:52.65,0:19:55.34,Default,,0,0,0,,Бақыт әкелген көк қарғадай
Dialogue: 0,0:19:55.47,0:19:59.95,Default,,0,0,0,,Сіз бақыттысыз ба? Сонда оның есімі Бақытты.
Dialogue: 0,0:20:00.78,0:20:01.52,Default,,0,0,0,,Көз
Dialogue: 0,0:20:01.95,0:20:03.73,Default,,0,0,0,,Айдаһар бақытты
Dialogue: 0,0:20:03.74,0:20:04.52,Default,,0,0,0,,Көз
Dialogue: 0,0:20:04.87,0:20:06.08,Default,,0,0,0,,Бұл айдаһар емес.
Dialogue: 0,0:20:06.21,0:20:08.47,Default,,0,0,0,,Хехехе, айдаһардың суретін жаса.
Dialogue: 0,0:20:10.00,0:20:11.13,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:20:12.17,0:20:14.73,Default,,0,0,0,,Бірақ бұл жақсы әңгіме.
Dialogue: 0,0:20:14.82,0:20:16.26,Default,,0,0,0,,Бірақ бұл екеуі...
Dialogue: 0,0:20:16.34,0:20:18.86,Default,,0,0,0,,Біз қаншалықты жақсы аралассақ, соғұрлым жақсы жұмыс істейміз.
Dialogue: 0,0:20:19.47,0:20:22.82,Default,,0,0,0,,Эй Мира, маған да осында көмектесші.
Dialogue: 0,0:20:24.13,0:20:29.34,Default,,0,0,0,,Бұл Эрза, ал мынау Лаксус...
Dialogue: 0,0:20:29.65,0:20:31.52,Default,,0,0,0,,Сонда бұл қыз Лисанна.
Dialogue: 0,0:20:32.43,0:20:33.73,Default,,0,0,0,,Екеуін біз қараймыз.
Dialogue: 0,0:20:33.78,0:20:39.86,Default,,0,0,0,,Біріншіден, Лизанна кім және ол қазір неге жоқ?
Dialogue: 0,0:20:40.78,0:20:43.60,Default,,0,0,0,,Бізде тағы бір ұрыс болды, Нацу.
Dialogue: 0,0:20:46.39,0:20:49.69,Default,,0,0,0,,О, Лисанна, қайтып келдің бе?
Dialogue: 0,0:20:51.26,0:20:54.30,Default,,0,0,0,,Нацу менің барлық балықтарымды жеп қойды.
Dialogue: 0,0:20:54.43,0:20:56.47,Default,,0,0,0,,Сараң сөз айтпа.
Dialogue: 0,0:20:56.56,0:20:58.78,Default,,0,0,0,,Нацу енді менің әкем болуы керек.
Dialogue: 0,0:20:58.91,0:20:59.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:59.95,0:21:02.17,Default,,0,0,0,,Сіз ана мен баланы қорғайсыз, солай ма?
Dialogue: 0,0:21:02.21,0:21:03.69,Default,,0,0,0,,Сіз қашан туралы айтып отырсыз?
Dialogue: 0,0:21:03.78,0:21:05.69,Default,,0,0,0,,Нейчи Нейчи не туралы айтып отыр?
Dialogue: 0,0:21:05.71,0:21:06.71,Default,,0,0,0,,Өтінемін, менен сөйлеспеңіз.
Dialogue: 0,0:21:06.95,0:21:10.13,Default,,0,0,0,,Біз отбасымыз, сондықтан кейде бір-бірімізбен кездесіп қалатын шығармыз.
Dialogue: 0,0:21:10.13,0:21:12.08,Default,,0,0,0,,Өйткені, мен төбелескенді ұнатпаймын.
Dialogue: 0,0:21:12.34,0:21:14.91,Default,,0,0,0,,Өйткені Хатсупи біздің баламыз.
Dialogue: 0,0:21:14.91,0:21:17.04,Default,,0,0,0,,Кездейсоқ таңғажайып нәрсе айтыңыз.
Dialogue: 0,0:21:17.04,0:21:18.82,Default,,0,0,0,,Біртүрлі етіп айтпа
Dialogue: 0,0:21:18.82,0:21:20.08,Default,,0,0,0,,#¥＠%……＆＊
Dialogue: 0,0:21:20.08,0:21:22.04,Default,,0,0,0,,Тікелей айтпа
Dialogue: 0,0:21:22.04,0:21:23.69,Default,,0,0,0,,Әлі бірінші рет
Dialogue: 0,0:21:23.69,0:21:25.69,Default,,0,0,0,,Аңғал болма, ақымақ.
Dialogue: 0,0:21:29.87,0:21:32.00,Default,,0,0,0,,Тацуку, олай етпе.
Dialogue: 0,0:21:33.30,0:21:36.86,Default,,0,0,0,,Мен енді Нацумен сөйлеспеймін деп шештім.
Dialogue: 0,0:21:37.17,0:21:38.00,Default,,0,0,0,,Эй
Dialogue: 0,0:21:38.00,0:21:39.17,Default,,0,0,0,,Мен сұрамаймын.
Dialogue: 0,0:21:39.17,0:21:40.86,Default,,0,0,0,,Шана, мен қиналдым.
Dialogue: 0,0:21:40.87,0:21:42.52,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:21:42.52,0:21:44.95,Default,,0,0,0,,Ооооооооо
Dialogue: 0,0:21:46.30,0:21:47.86,Default,,0,0,0,,Сіз бақыттысыз ба?
Dialogue: 0,0:21:49.84,0:21:52.36,Default,,0,0,0,,Мен бақыттымын
Dialogue: 0,0:21:52.56,0:21:54.21,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:21:54.21,0:21:57.43,Default,,0,0,0,,Менің ойымша, олар түзете алды ма.
Dialogue: 0,0:21:57.87,0:22:01.17,Default,,0,0,0,,Оған көмектесу мүмкін емес, мен қараймын.
Dialogue: 0,0:23:40.21,0:23:43.65,Default,,0,0,0,,Яцуби Сенсейдің Фефритейл курсы
Dialogue: 0,0:23:43.95,0:23:46.47,Default,,0,0,0,,Бүгін мен сендерге Сиқыршылар гильдиясының құпиясын айтамын.
Dialogue: 0,0:23:46.69,0:23:49.39,Default,,0,0,0,,Бұл әлемде тұрақты гильдиялар мен қараңғы гильдиялар бар...
Dialogue: 0,0:23:49.43,0:23:51.78,Default,,0,0,0,,Әртүрлі сиқыршылар гильдиялары бар.
Dialogue: 0,0:23:51.91,0:23:54.91,Default,,0,0,0,,Сиқыршылар - гильдиясының мақтанышы
Dialogue: 0,0:23:54.95,0:23:58.73,Default,,0,0,0,,Гильдия белгісі оның денесінің бір жерінде қашалған, сондықтан оны іздеңіз.
Dialogue: 0,0:23:59.00,0:24:01.26,Default,,0,0,0,,Осымен курс аяқталды.
Dialogue: 0,0:24:01.26,0:24:04.34,Default,,0,0,0,,Үстіңгі тұрған садақ Ai
Dialogue: 0,0:24:08.91,0:24:09.86,Default,,0,0,0,,Бұл Эльза болуы керек.
Dialogue: 0,0:24:10.34,0:24:13.52,Default,,0,0,0,,Қарным ашты ма, әлде бірдеңе деп жынды болдым.
Dialogue: 0,0:24:13.52,0:24:15.95,Default,,0,0,0,,О, бұл мүмкін сияқты.
Dialogue: 0,0:24:16.04,0:24:19.86,Default,,0,0,0,,Тіпті I Гильдия пішінінің де сақталғаны ғажап.
Dialogue: 0,0:24:19.91,0:24:22.91,Default,,0,0,0,,Енді қайтып оралсақ қауіпті емес пе?
Dialogue: 0,0:24:26.47,0:24:29.56,Default,,0,0,0,,Ол, сөзсіз, Fairy Tail-дағы көлеңкелердің билеушісі.
Dialogue: 0,0:24:29.56,0:24:32.73,Default,,0,0,0,,Бірақ, егер Эльза шебер болса...
Dialogue: 0,0:24:32.82,0:24:34.21,Default,,0,0,0,,Қорқынышты
Dialogue: 0,0:24:35.71,0:24:41.71,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory