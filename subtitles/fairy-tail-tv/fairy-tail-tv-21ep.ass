Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.13,0:00:03.60,Default,,0,0,0,,Ио, бәрі теледидар алдында.
Dialogue: 0,0:00:03.78,0:00:05.39,Default,,0,0,0,,Fairy Tail көргенде
Dialogue: 0,0:00:05.56,0:00:06.73,Default,,0,0,0,,Бөлмені жарықтандырыңыз
Dialogue: 0,0:00:07.04,0:00:09.08,Default,,0,0,0,,Теледидардан алыстаңыз.
Dialogue: 0,0:00:11.10,0:00:14.47,Default,,0,0,0,,Хахаха бұл жақсы жұмыс болды
Dialogue: 0,0:00:14.47,0:00:16.82,Default,,0,0,0,,Клиент те жомарт болды.
Dialogue: 0,0:00:16.87,0:00:20.69,Default,,0,0,0,,Жарайды, менің арқасында заттар тез жиналды.
Dialogue: 0,0:00:20.78,0:00:24.08,Default,,0,0,0,,Ой, сен не айтып тұрсың?
Dialogue: 0,0:00:24.34,0:00:27.56,Default,,0,0,0,,Балалар сендер мұны ауыр жұмыс деп ойладыңдар.
Dialogue: 0,0:00:28.26,0:00:30.91,Default,,0,0,0,,Жүктің ауыр екенін айтайын ба?
Dialogue: 0,0:00:30.95,0:00:32.60,Default,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,0:00:33.00,0:00:34.08,Default,,0,0,0,,Ойнамаңыз
Dialogue: 0,0:00:34.55,0:00:35.39,Default,,0,0,0,,Киініңіз
Dialogue: 0,0:00:35.52,0:00:36.60,Default,,0,0,0,,Вупер
Dialogue: 0,0:00:37.24,0:00:39.87,Default,,0,0,0,,Бұл жасырын. Бұл ақымақтық реакция.
Dialogue: 0,0:02:20.43,0:02:23.78,Default,,0,0,0,,Ум, мен оны асыға күтемін. Кешіріңіз.
Dialogue: 0,0:02:24.65,0:02:28.56,Default,,0,0,0,,Мен бастапқыда бұл өтінішті өзім шешуді жоспарладым.
Dialogue: 0,0:02:29.13,0:02:30.87,Default,,0,0,0,,Барлығы не үшін келеді?
Dialogue: 0,0:02:32.69,0:02:34.08,Default,,0,0,0,,Менің ойымша, бұл шешілді.
Dialogue: 0,0:02:34.78,0:02:35.91,Default,,0,0,0,,Шешілді
Dialogue: 0,0:02:36.87,0:02:40.34,Default,,0,0,0,,Өйткені біз Fairy Tail ойынындағы ең күшті командамыз.
Dialogue: 0,0:02:40.43,0:02:41.00,Default,,0,0,0,,Ай
Dialogue: 0,0:02:41.65,0:02:42.91,Default,,0,0,0,,Ах~ Ол тірі!
Dialogue: 0,0:02:45.34,0:02:46.65,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:02:47.08,0:02:49.91,Default,,0,0,0,,Мен және Бақыт, Эльза және шалбар
Dialogue: 0,0:02:49.95,0:02:51.82,Default,,0,0,0,,Сіз кез келген жұмысты орындай алатын сияқтысыз.
Dialogue: 0,0:02:52.17,0:02:53.30,Default,,0,0,0,,Шалбар деп айтпа
Dialogue: 0,0:02:53.61,0:02:55.30,Default,,0,0,0,,Иә, бұл сендіреді.
Dialogue: 0,0:02:55.56,0:02:56.30,Default,,0,0,0,,Ай
Dialogue: 0,0:02:56.34,0:02:57.56,Default,,0,0,0,,Мен де!
Dialogue: 0,0:02:59.00,0:03:01.00,Default,,0,0,0,,Жылама, бұл жай әзіл Вуби
Dialogue: 0,0:03:01.10,0:03:03.04,Default,,0,0,0,,Мен жыламаймын, мен Вуби емеспін.
Dialogue: 0,0:03:04.43,0:03:07.08,Default,,0,0,0,,Кешіріңіз, мен де қызып кеттім.
Dialogue: 0,0:03:07.26,0:03:10.91,Default,,0,0,0,,Достарымды осылай ренжітуге шыдай алмаймын.
Dialogue: 0,0:03:11.08,0:03:13.17,Default,,0,0,0,,Әзірше мені жұдырықтай аласыз ба?
Dialogue: 0,0:03:13.56,0:03:16.42,Default,,0,0,0,,Бұл үңілуге ​​тұрарлық нәрсе ме?
Dialogue: 0,0:03:16.58,0:03:17.51,Default,,0,0,0,,Тоқта.
Dialogue: 0,0:03:17.51,0:03:18.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:18.25,0:03:20.04,Default,,0,0,0,,Ол Fairy Tail сиқыршысы.
Dialogue: 0,0:03:20.04,0:03:22.00,Default,,0,0,0,,Әлі білмейтін сені аяймын.
Dialogue: 0,0:03:22.30,0:03:24.43,Default,,0,0,0,,Біртүрлі назар аудартады.
Dialogue: 0,0:03:24.56,0:03:26.43,Default,,0,0,0,,Не жиіркенішті?
Dialogue: 0,0:03:27.04,0:03:28.30,Default,,0,0,0,,қорқып кетті
Dialogue: 0,0:03:28.78,0:03:33.69,Default,,0,0,0,,О, гильдияда не болды?
Dialogue: 0,0:03:36.39,0:03:37.56,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:03:38.04,0:03:39.21,Default,,0,0,0,,Ұф… сен, кішкентай сорлы.
Dialogue: 0,0:03:39.65,0:03:40.26,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:03:55.08,0:04:01.08,Default,,0,0,0,,Біздің гильдия
Dialogue: 0,0:04:03.87,0:04:06.04,Default,,0,0,0,,Не болды?
Dialogue: 0,0:04:06.73,0:04:07.82,Default,,0,0,0,,«Елес»
Dialogue: 0,0:04:08.95,0:04:10.13,Default,,0,0,0,,Қазір қанша?
Dialogue: 0,0:04:11.17,0:04:13.39,Default,,0,0,0,,Сіз «фантом» дедіңіз бе?
Dialogue: 0,0:04:14.17,0:04:17.65,Default,,0,0,0,,Өкінемін, бірақ жеңілдім.
Dialogue: 0,0:04:23.30,0:04:27.34,Default,,0,0,0,,Бұл «Ертегінің» бірінші жертөле қабаты
Dialogue: 0,0:04:27.43,0:04:31.66,Default,,0,0,0,,Бұл әдетте қойма, бірақ қазір бұл уақытша бар.
Dialogue: 0,0:04:32.60,0:04:35.47,Default,,0,0,0,,«Фантом» екеуміз ұзақ уақыт бойы жаман қарым-қатынаста болдық.
Dialogue: 0,0:04:35.78,0:04:37.52,Default,,0,0,0,,Сіз оны жоймақсыз ба?
Dialogue: 0,0:04:37.73,0:04:41.50,Default,,0,0,0,,Тоқта, басқа адам сол «Фантом»
Dialogue: 0,0:04:43.45,0:04:45.57,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:04:45.92,0:04:46.74,Default,,0,0,0,,Бұл
Dialogue: 0,0:04:47.17,0:04:48.70,Default,,0,0,0,,Мен жаңа ғана оралдым.
Dialogue: 0,0:04:48.82,0:04:51.63,Default,,0,0,0,,Ата, не істеп жатырсыз?
Dialogue: 0,0:04:51.63,0:04:55.87,Default,,0,0,0,,Қалай болды, Люси? Жұмыс жақсы өтті ме?
Dialogue: 0,0:04:57.60,0:05:01.17,Default,,0,0,0,,Ұстаз, сіз қазір жағдайдың қандай екенін білесіз бе?
Dialogue: 0,0:05:01.39,0:05:03.34,Default,,0,0,0,,Гильдия жойылды.
Dialogue: 0,0:05:03.34,0:05:06.33,Default,,0,0,0,,Хаха, жақсы, тынышталыңыз.
Dialogue: 0,0:05:06.47,0:05:09.04,Default,,0,0,0,,Бәлкім, әбігерге салудың қажеті жоқ.
Dialogue: 0,0:05:09.26,0:05:09.78,Default,,0,0,0,,Не?
Dialogue: 0,0:05:11.26,0:05:16.23,Default,,0,0,0,,Мұндай ақымақтардың шегі осы.
Dialogue: 0,0:05:16.82,0:05:20.73,Default,,0,0,0,,Айналасында ешкім жоқ гильдияны нысанаға алудың мәні неде?
Dialogue: 0,0:05:20.82,0:05:21.91,Default,,0,0,0,,Ешкім
Dialogue: 0,0:05:22.17,0:05:25.08,Default,,0,0,0,,Шабуыл түнде болған сияқты.
Dialogue: 0,0:05:25.30,0:05:28.01,Default,,0,0,0,,Ешкім зардап шеккен жоқ па?
Dialogue: 0,0:05:28.26,0:05:30.21,Default,,0,0,0,,Құт-береке.
Dialogue: 0,0:05:30.30,0:05:35.00,Default,,0,0,0,,Сізге тек күтпеген жерден шабуыл жасай алатын адамдарға қарсы тұрмаңыз.
Dialogue: 0,0:05:35.04,0:05:36.30,Default,,0,0,0,,Оны жай қалдырыңыз
Dialogue: 0,0:05:37.39,0:05:42.99,Default,,0,0,0,,Мен түсінбеймін. Мен ол жігітті құртуым керек. Кешіріңіз.
Dialogue: 0,0:05:43.19,0:05:45.26,Default,,0,0,0,,Бұл әңгіме аяқталды.
Dialogue: 0,0:05:45.54,0:05:48.97,Default,,0,0,0,,Жоғарғы денем сауығып кеткенше осында жұмысқа тапсырыс қабылдаймын.
Dialogue: 0,0:05:49.17,0:05:51.04,Default,,0,0,0,,Бұл жұмыс істейтін уақыт емес.
Dialogue: 0,0:05:51.08,0:05:53.47,Default,,0,0,0,,Нацу, неге жеңілдетпейсің?
Dialogue: 0,0:05:55.08,0:05:57.04,Default,,0,0,0,,Неге менің бөксем?
Dialogue: 0,0:05:57.21,0:05:58.87,Default,,0,0,0,,Ұстаз, мен ашуланамын.
Dialogue: 0,0:06:00.34,0:06:01.43,Default,,0,0,0,,Ата
Dialogue: 0,0:06:01.56,0:06:04.69,Default,,0,0,0,,Бір минут күтіңіз, ол ағып кете жаздады.
Dialogue: 0,0:06:06.60,0:06:09.13,Default,,0,0,0,,Неге жақсысың, ата?
Dialogue: 0,0:06:09.52,0:06:13.34,Default,,0,0,0,,Нацу: Мастер де көңілсіз.
Dialogue: 0,0:06:14.17,0:06:18.73,Default,,0,0,0,,Алайда, гильдиялар арасындағы қарулы қақтығыстарға кеңес тыйым салады.
Dialogue: 0,0:06:18.73,0:06:21.00,Default,,0,0,0,,Бірінші істеу керек емес пе?
Dialogue: 0,0:06:21.13,0:06:22.91,Default,,0,0,0,,Мәселе бұл емес.
Dialogue: 0,0:06:24.00,0:06:30.56,Default,,0,0,0,,Ұстаз осылай ойласа, мен оған көмектесе алмаймын.
Dialogue: 0,0:06:34.73,0:06:37.73,Default,,0,0,0,,Бір қорқынышты нәрсе болды.
Dialogue: 0,0:06:39.19,0:06:43.13,Default,,0,0,0,,Әй, қыз, құласаң білмеймін.
Dialogue: 0,0:06:43.13,0:06:44.26,Default,,0,0,0,,«Фантом» туралы айту
Dialogue: 0,0:06:44.36,0:06:47.65,Default,,0,0,0,,«Ертегімен» тіл табыса алмауымен атақты.
Dialogue: 0,0:06:49.76,0:06:52.78,Default,,0,0,0,,Негізі қайсысына қосылатынымды білмедім.
Dialogue: 0,0:06:54.28,0:06:57.65,Default,,0,0,0,,Өйткені бұл да дәл осы сияқты жынды сияқты.
Dialogue: 0,0:06:58.00,0:07:01.21,Default,,0,0,0,,Бірақ қазір мен мұнда келгеніме қуаныштымын.
Dialogue: 0,0:07:02.91,0:07:04.73,Default,,0,0,0,,Өйткені «Ертегі»
Dialogue: 0,0:07:05.00,0:07:05.69,Default,,0,0,0,,Қайта оралдын.
Dialogue: 0,0:07:05.69,0:07:06.09,Default,,0,0,0,,Жақсы бөлме, үйге қош келдіңіз.
Dialogue: 0,0:07:06.09,0:07:06.63,Default,,0,0,0,,Бұл жақсы бөлме.
Dialogue: 0,0:07:06.63,0:07:08.47,Default,,0,0,0,,онда Цуки-кунге қатысты күдік мүлде сейіледі.
Dialogue: 0,0:07:08.65,0:07:10.78,Default,,0,0,0,,Неліктен көп?
Dialogue: 0,0:07:11.47,0:07:15.87,Default,,0,0,0,,«Фантом» мәселесіне келсек, олардың осы қалаға келгені...
Dialogue: 0,0:07:15.91,0:07:18.73,Default,,0,0,0,,Олар да барлығының мекенжайларын іздеп жатқан шығар.
Dialogue: 0,0:07:19.95,0:07:24.30,Default,,0,0,0,,Сондықтан Мира-чан бәріміз біраз уақыт бірге тұрсақ, қауіпсіз болады дейді.
Dialogue: 0,0:07:24.30,0:07:25.21,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:07:25.82,0:07:29.08,Default,,0,0,0,,Бүгін бәрі мұнда және мұнда ұйықтау кештерін өткізіп жатыр.
Dialogue: 0,0:07:29.39,0:07:31.87,Default,,0,0,0,,Сіз де жас қызсыз.
Dialogue: 0,0:07:32.17,0:07:36.52,Default,,0,0,0,,Мен тек Нацу мен Грейдің осында қалуына ренжідім.
Dialogue: 0,0:07:36.78,0:07:39.59,Default,,0,0,0,,Сондықтан біз бірге отыруды жөн көрдік.
Dialogue: 0,0:07:39.73,0:07:41.07,Default,,0,0,0,,Бұл жеңілдік
Dialogue: 0,0:07:41.21,0:07:43.95,Default,,0,0,0,,Нацу мен Грейдің түнде болатыны расталды.
Dialogue: 0,0:07:44.52,0:07:46.47,Default,,0,0,0,,Неліктен біз?
Dialogue: 0,0:07:47.30,0:07:48.87,Default,,0,0,0,,Кір жуу
Dialogue: 0,0:07:49.13,0:07:51.47,Default,,0,0,0,,Мына мысықтар не істеп жатыр?
Dialogue: 0,0:07:51.47,0:07:53.47,Default,,0,0,0,,Сіз де Көкпен не істеп жатырсыз?
Dialogue: 0,0:07:53.56,0:07:56.73,Default,,0,0,0,,О, Грей, маған да берші.
Dialogue: 0,0:07:57.69,0:08:00.95,Default,,0,0,0,,Эльзаға қарашы, мен сексуалды іш киім таптым.
Dialogue: 0,0:08:01.08,0:08:04.04,Default,,0,0,0,,Бұл таңқаларлық. Сіз осындай нәрсе киіп жүрсіз бе?
Dialogue: 0,0:08:04.17,0:08:06.78,Default,,0,0,0,,Мен қазір ұйықтаймын, шулама.
Dialogue: 0,0:08:07.47,0:08:10.91,Default,,0,0,0,,Мен қаншалықты таза болсам, соғұрлым халықтан рахат аламын.
Dialogue: 0,0:08:11.34,0:08:15.00,Default,,0,0,0,,Сонда да балалар, тердің иісі шығып тұр.
Dialogue: 0,0:08:15.08,0:08:17.91,Default,,0,0,0,,Бір бөлмеде ұйықтап, ваннаға түсу.
Dialogue: 0,0:08:17.95,0:08:19.83,Default,,0,0,0,,Жоқ, бұл азап.
Dialogue: 0,0:08:19.83,0:08:21.68,Default,,0,0,0,,Мен ұйықтап жатырмын
Dialogue: 0,0:08:22.30,0:08:26.95,Default,,0,0,0,,Оған көмектесу мүмкін емес. Сіз бізге қосылып, біз бұрынғыдай жасай аласыз.
Dialogue: 0,0:08:27.13,0:08:29.13,Default,,0,0,0,,Сіз қандай қарым-қатынастасыз?
Dialogue: 0,0:08:29.65,0:08:31.44,Default,,0,0,0,,Бұл ең күшті команда.
Dialogue: 0,0:08:31.44,0:08:33.34,Default,,0,0,0,,Басқа мағынада ең күшті
Dialogue: 0,0:08:36.78,0:08:38.04,Default,,0,0,0,,Жақсысың ба, Леви?
Dialogue: 0,0:08:38.04,0:08:40.77,Default,,0,0,0,,Раджи және басқалармен бірге қыздар жатақханасына бару керек шығар.
Dialogue: 0,0:08:40.78,0:08:43.56,Default,,0,0,0,,Жарайды, жарайды, біз командамыз.
Dialogue: 0,0:08:43.69,0:08:49.17,Default,,0,0,0,,Леви: Егер мен үшеу болсам, сен қауіпсіз боласың.
Dialogue: 0,0:08:49.21,0:08:50.91,Default,,0,0,0,,Иә, мен Левиді қорғаймын.
Dialogue: 0,0:08:51.00,0:08:51.89,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:09:00.21,0:09:03.17,Default,,0,0,0,,Иә Нацу келесі жолы кіргенде.
Dialogue: 0,0:09:05.52,0:09:06.34,Default,,0,0,0,,Грей ше?
Dialogue: 0,0:09:09.87,0:09:11.30,Default,,0,0,0,,Бұл жақсы ыстық бұлақ еді.
Dialogue: 0,0:09:11.56,0:09:14.82,Default,,0,0,0,,Эльза Барлығы өте еркін.
Dialogue: 0,0:09:15.13,0:09:16.60,Default,,0,0,0,,О, бұл дөрекі.
Dialogue: 0,0:09:20.43,0:09:22.65,Default,,0,0,0,,Бұл ұят емес пе?
Dialogue: 0,0:09:23.04,0:09:24.91,Default,,0,0,0,,Киімді ауыстыру да киім ауыстыру болып табылады.
Dialogue: 0,0:09:28.73,0:09:30.30,Default,,0,0,0,,Мысалы, «Фантом»
Dialogue: 0,0:09:30.34,0:09:32.30,Default,,0,0,0,,Маған неге кенет шабуыл жасады деп ойлаймын.
Dialogue: 0,0:09:32.47,0:09:33.39,Default,,0,0,0,,Сана
Dialogue: 0,0:09:33.82,0:09:39.21,Default,,0,0,0,,Бұрынғы кезде көптеген қақтығыстар болған, бірақ мұндай тікелей шабуыл бірінші рет болып отыр.
Dialogue: 0,0:09:39.52,0:09:43.17,Default,,0,0,0,,Ата, қорықпаңыз, тек шешімділікпен істеңіз.
Dialogue: 0,0:09:43.34,0:09:44.47,Default,,0,0,0,,Мен ояу едім.
Dialogue: 0,0:09:44.69,0:09:47.21,Default,,0,0,0,,Қарттың қорықпайтынына сенімдімін.
Dialogue: 0,0:09:47.52,0:09:50.47,Default,,0,0,0,,Солай болса да, ол «Қасиетті он ұлы сиқыршының» бірі.
Dialogue: 0,0:09:50.52,0:09:53.21,Default,,0,0,0,,Сізді табиғи түрде оқуға не мәжбүр етеді? Қазірдің өзінде
Dialogue: 0,0:09:53.52,0:09:56.30,Default,,0,0,0,,I'm curious about what happens next.
Dialogue: 0,0:09:56.87,0:10:01.30,Default,,0,0,0,,Жоқ, өйткені бірінші оқырман Леви Чан деп шешілді.
Dialogue: 0,0:10:02.13,0:10:02.91,Default,,0,0,0,,Иә
Dialogue: 0,0:10:03.69,0:10:05.00,Default,,0,0,0,,Бұл қандай қол?
Dialogue: 0,0:10:05.83,0:10:07.94,Default,,0,0,0,,Айтпақшы, «Қасиетті он ұлы сиқырлы жол» дегеніміз не?
Dialogue: 0,0:10:07.95,0:10:10.21,Default,,0,0,0,,Сиқырлар кеңесінің төрағасы құрған
Dialogue: 0,0:10:10.43,0:10:14.73,Default,,0,0,0,,Құрлықтағы ең көрнекті он сиқыршыға берілген атақ.
Dialogue: 0,0:10:16.18,0:10:17.36,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:10:17.36,0:10:20.69,Default,,0,0,0,,«Елестің» шебері Хосе солардың бірі.
Dialogue: 0,0:10:21.34,0:10:24.82,Default,,0,0,0,,Сол жігіт те.
Dialogue: 0,0:10:26.30,0:10:27.73,Default,,0,0,0,,Мен қорқамын.
Dialogue: 0,0:10:27.82,0:10:30.56,Default,,0,0,0,,«Елес» жігіттері көп.
Dialogue: 0,0:10:31.04,0:10:32.65,Default,,0,0,0,,Тынышталыңыз.
Dialogue: 0,0:10:33.21,0:10:34.87,Default,,0,0,0,,Сондықтан бұл өте нашар.
Dialogue: 0,0:10:35.77,0:10:37.31,Default,,0,0,0,,Мастер де, Мира-чан да
Dialogue: 0,0:10:37.31,0:10:40.30,Default,,0,0,0,,Екі гильдия соғысса не болатынын білген соң
Dialogue: 0,0:10:40.39,0:10:41.60,Default,,0,0,0,,Төбелеске жол бермеу
Dialogue: 0,0:10:42.17,0:10:44.87,Default,,0,0,0,,Бүкіл сиқырлы әлемде тәртіп үшін.
Dialogue: 0,0:10:45.47,0:10:48.65,Default,,0,0,0,,«Фантомның» несі таңқаларлық?
Dialogue: 0,0:10:48.91,0:10:52.27,Default,,0,0,0,,Бұл маңызды емес, әлгі балалар.
Dialogue: 0,0:10:52.52,0:10:56.52,Default,,0,0,0,,Жоқ, егер біз шынымен соғыссақ, біз бір-бірімізді жаншамыз.
Dialogue: 0,0:10:56.82,0:10:58.52,Default,,0,0,0,,Күштер теңестірілген
Dialogue: 0,0:10:59.69,0:11:03.26,Default,,0,0,0,,Мастер Макаровтың күшімен тең деп айтылады.
Dialogue: 0,0:11:03.30,0:11:05.87,Default,,0,0,0,,«Қасиетті он ұлы сиқыршының» шебері Хосе
Dialogue: 0,0:11:06.30,0:11:10.95,Default,,0,0,0,,Және 4-элемент, ол сол жерде S класындағы сиқыршыға тиеді.
Dialogue: 0,0:11:11.52,0:11:15.39,Default,,0,0,0,,«Курогане» темір айдаһары Гаджил ең қиын деп айтылады.
Dialogue: 0,0:11:15.69,0:11:19.08,Default,,0,0,0,,Бұл гильдия шабуылына адам кінәлі деп есептелді
Dialogue: 0,0:11:19.65,0:11:21.52,Default,,0,0,0,,Iron Dragon Slayer Threa
Dialogue: 0,0:11:21.95,0:11:26.26,Default,,0,0,0,,Айдаһар өлтіруші Треа! ? Мен Нацудан басқа жерлерге бардым.
Dialogue: 0,0:11:27.04,0:11:31.30,Default,,0,0,0,,Сонда әлгі жігіт темір жейді.
Dialogue: 0,0:11:32.87,0:11:37.87,Default,,0,0,0,,Мен Гаджилдің Fairy Tail-ге шабуыл жасағанын естідім.
Dialogue: 0,0:11:38.04,0:11:39.25,Default,,0,0,0,,Керемет
Dialogue: 0,0:11:39.25,0:11:42.47,Default,,0,0,0,,Ол жігіттер қазір сондай көкшіл.
Dialogue: 0,0:11:42.65,0:11:45.13,Default,,0,0,0,,Look at me, sir.
Dialogue: 0,0:11:49.78,0:11:54.78,Default,,0,0,0,,Ол маған тамақ ішіп жатқанда онымен сөйлеспеу керектігін үнемі айтып отырса керек.
Dialogue: 0,0:11:55.44,0:11:56.32,Default,,0,0,0,,Scraps
Dialogue: 0,0:11:57.60,0:12:00.21,Default,,0,0,0,,Перінің бөксесінде не бар?
Dialogue: 0,0:12:00.56,0:12:03.73,Default,,0,0,0,,Біз жауаптымыз.
Dialogue: 0,0:12:04.17,0:12:06.78,Default,,0,0,0,,Ұшқын себілді
Dialogue: 0,0:12:06.95,0:12:09.39,Default,,0,0,0,,Өте жақсы, Гагил-сан.
Dialogue: 0,0:12:09.60,0:12:11.69,Default,,0,0,0,,Маған мейірімді болыңыз, ұстаз.
Dialogue: 0,0:12:12.13,0:12:14.73,Default,,0,0,0,,Қоқысты жылжыту үшін бұл жеткіліксіз.
Dialogue: 0,0:12:15.65,0:12:20.56,Default,,0,0,0,,Бірақ мен саған басқа сыйлық әкелдім.
Dialogue: 0,0:12:20.69,0:12:24.39,Default,,0,0,0,,Міне, солай, бірақ солай.
Dialogue: 0,0:12:24.39,0:12:27.30,Default,,0,0,0,,Өтінемін, оларды тірі қалдырыңыз.
Dialogue: 0,0:12:32.69,0:12:35.69,Default,,0,0,0,,Магнолия Нанро саябағы
Dialogue: 0,0:12:36.69,0:12:40.17,Default,,0,0,0,,Кешіріңіз, мен гильдияданмын.
Dialogue: 0,0:12:46.47,0:12:50.13,Default,,0,0,0,,Біреу мені жерге қоюды өтінемін.
Dialogue: 0,0:12:50.13,0:12:53.54,Default,,0,0,0,,Бірақ мен бұл белгіні көріп, араластым.
Dialogue: 0,0:12:53.95,0:12:54.96,Default,,0,0,0,,Levy-chan
Dialogue: 0,0:12:54.96,0:12:56.58,Default,,0,0,0,,Jet Dry
Dialogue: 0,0:12:58.39,0:12:59.47,Default,,0,0,0,,«Елес»?
Dialogue: 0,0:13:05.91,0:13:06.82,Default,,0,0,0,,Ах! Джибрил, қайдан шығып қалдың?
Dialogue: 0,0:13:13.04,0:13:16.95,Default,,0,0,0,,Сіз шүберектерге дейін шыдасаңыз болады.
Dialogue: 0,0:13:17.41,0:13:21.65,Default,,0,0,0,,Ешбір ата-ана баласының қанын көргенде үндемейді.
Dialogue: 0,0:13:24.87,0:13:27.39,Default,,0,0,0,,War
Dialogue: 0,0:13:35.17,0:13:36.47,Default,,0,0,0,,Magnolia Hospital
Dialogue: 0,0:13:37.04,0:13:42.52,Default,,0,0,0,,Мұнда тек сиқыршыларға арналған аурухана да бар.
Dialogue: 0,0:13:43.73,0:13:44.52,Default,,0,0,0,,Droy
Dialogue: 0,0:13:45.69,0:13:46.87,Default,,0,0,0,,Ағын
Dialogue: 0,0:13:48.26,0:13:49.78,Default,,0,0,0,,Levy-chan
Dialogue: 0,0:13:52.69,0:13:54.73,Default,,0,0,0,,Сіз қорқынышты нәрсе жасайсыз.
Dialogue: 0,0:13:55.30,0:13:56.34,Default,,0,0,0,,“Phantom”
Dialogue: 0,0:13:59.91,0:14:03.26,Default,,0,0,0,,Лу-чанның роман жазып жатқанын естідім.
Dialogue: 0,0:14:03.60,0:14:06.21,Default,,0,0,0,,Хмм, ол қазірдің өзінде кең тараған ба?
Dialogue: 0,0:14:06.86,0:14:07.56,Default,,0,0,0,,Ай
Dialogue: 0,0:14:07.89,0:14:11.17,Default,,0,0,0,,Мен оны біреу таратып жіберсе ғана елестете аламын.
Dialogue: 0,0:14:12.34,0:14:14.95,Default,,0,0,0,,Ойланып қарасам, мен сені дұрыстап амандаспадым.
Dialogue: 0,0:14:15.21,0:14:16.52,Default,,0,0,0,,Мен Леви Леви Мэг Гарденмін
Dialogue: 0,0:14:18.65,0:14:20.26,Default,,0,0,0,,This is Jet.
Dialogue: 0,0:14:20.78,0:14:21.56,Default,,0,0,0,,Сәлем
Dialogue: 0,0:14:21.87,0:14:22.69,Default,,0,0,0,,Droy
Dialogue: 0,0:14:23.00,0:14:24.13,Default,,0,0,0,,Possible cute
Dialogue: 0,0:14:24.65,0:14:28.39,Default,,0,0,0,,Біз, Shogear командасы
Dialogue: 0,0:14:28.47,0:14:29.83,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:14:30.21,0:14:34.39,Default,,0,0,0,,Мен, мүлде жазбаймын, бірақ кітап оқығанды жақсы көремін.
Dialogue: 0,0:14:34.52,0:14:36.87,Default,,0,0,0,,Қарсы болмасаңыз, келесі жолы оқуға рұқсат етпеймін.
Dialogue: 0,0:14:37.08,0:14:41.26,Default,,0,0,0,,Аа, бұл әлі адамдарға көрсетілмейтін нәрсе емес.
Dialogue: 0,0:14:41.30,0:14:42.60,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:14:42.76,0:14:45.52,Default,,0,0,0,,What's the point of being a writer?
Dialogue: 0,0:14:45.69,0:14:46.73,Default,,0,0,0,,Жақсы айтылған
Dialogue: 0,0:14:46.82,0:14:50.39,Default,,0,0,0,,Жазушы болу жергілікті халыққа бөксесін көрсеткенмен бірдей.
Dialogue: 0,0:14:51.60,0:14:53.78,Default,,0,0,0,,Ұялшақ болсаң, бастамайсың.
Dialogue: 0,0:14:53.91,0:14:56.43,Default,,0,0,0,,Маған көрсетіңізші, өтінемін көрсетіңізші
Dialogue: 0,0:14:56.56,0:14:58.73,Default,,0,0,0,,Of course not the butt.
Dialogue: 0,0:14:58.87,0:15:00.95,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:15:01.00,0:15:03.00,Default,,0,0,0,,Әлі жолда
Dialogue: 0,0:15:03.32,0:15:07.13,Default,,0,0,0,,Ол аяқталғаннан кейін сіз біздің бірінші оқырманымыз бола аласыз.
Dialogue: 0,0:15:07.82,0:15:10.00,Default,,0,0,0,,Иә, уәде беремін
Dialogue: 0,0:15:23.56,0:15:24.87,Default,,0,0,0,,Мен сені кешіре алмаймын
Dialogue: 0,0:15:28.73,0:15:29.91,Default,,0,0,0,,Сол жігіттер т.б.
Dialogue: 0,0:15:34.04,0:15:37.56,Default,,0,0,0,,Фиор патшалығының солтүстік-шығысында Орк қалашығы
Dialogue: 0,0:15:37.78,0:15:41.95,Default,,0,0,0,,Бұл тарихи қамал қаласының орталығындағы мұнара
Dialogue: 0,0:15:42.04,0:15:46.52,Default,,0,0,0,,«Фантом Лорд» сиқыршылар гильдиясының тармағы
Dialogue: 0,0:15:47.43,0:15:53.43,Default,,0,0,0,,Тамаша, перінің бөксесі жыртық.
Dialogue: 0,0:15:53.60,0:15:56.47,Default,,0,0,0,,Мұны Гаджил және тағы үш адам жасаған сияқты.
Dialogue: 0,0:16:03.78,0:16:05.91,Default,,0,0,0,,Now, shall I go to work?
Dialogue: 0,0:16:05.95,0:16:09.52,Default,,0,0,0,,Үйге келе жатқанда ертегі қанаттарын тақайық.
Dialogue: 0,0:16:13.34,0:16:14.34,Default,,0,0,0,,Не?
Dialogue: 0,0:16:21.04,0:16:23.52,Default,,0,0,0,,«Ертегі»
Dialogue: 0,0:16:23.65,0:16:24.73,Default,,0,0,0,,О
Dialogue: 0,0:16:31.69,0:16:36.00,Default,,0,0,0,,Маған кез келген адам хабарласа алады.
Dialogue: 0,0:16:37.73,0:16:39.30,Default,,0,0,0,,Катанджае
Dialogue: 0,0:16:43.87,0:16:45.78,Default,,0,0,0,,«Күлгін тор»
Dialogue: 0,0:16:48.17,0:16:49.30,Default,,0,0,0,,Вакаба
Dialogue: 0,0:16:49.69,0:16:50.26,Default,,0,0,0,,Иә.
Dialogue: 0,0:16:50.52,0:16:52.60,Default,,0,0,0,,«Түтіннің шапшаңдығы»
Dialogue: 0,0:16:57.69,0:16:59.43,Default,,0,0,0,,Оқпен сиқырлы жуу
Dialogue: 0,0:17:02.69,0:17:04.60,Default,,0,0,0,,«Ұшқынды ату»
Dialogue: 0,0:17:05.82,0:17:06.87,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:17:07.56,0:17:09.21,Default,,0,0,0,,Керемет соққы Биска
Dialogue: 0,0:17:09.43,0:17:11.49,Default,,0,0,0,,Your nails are sweet Al
Dialogue: 0,0:17:12.00,0:17:16.78,Default,,0,0,0,,Target lock-on “foming shot”
Dialogue: 0,0:17:28.87,0:17:30.52,Default,,0,0,0,,Канжу Нагаре
Dialogue: 0,0:17:31.08,0:17:35.21,Default,,0,0,0,,You guys messed with that monster kid.
Dialogue: 0,0:17:35.26,0:17:39.55,Default,,0,0,0,,Don't think human laws can protect you.
Dialogue: 0,0:17:39.95,0:17:43.29,Default,,0,0,0,,Күшті Күшті Әскери жолсерік те керемет.
Dialogue: 0,0:17:43.34,0:17:44.88,Default,,0,0,0,,These guys are a mess.
Dialogue: 0,0:17:44.88,0:17:46.91,Default,,0,0,0,,Бұл «Ертегідегі» сиқыршы ма?
Dialogue: 0,0:17:48.21,0:17:49.52,Default,,0,0,0,,“Painting magic”
Dialogue: 0,0:17:49.82,0:17:51.30,Default,,0,0,0,,«Жабайы шабуыл»
Dialogue: 0,0:17:51.87,0:17:53.30,Default,,0,0,0,,«Ағашты модельдеу сиқыры»
Dialogue: 0,0:17:54.08,0:17:55.69,Default,,0,0,0,,«Бағаналы махаббат бөгеті»
Dialogue: 0,0:17:55.78,0:17:57.43,Default,,0,0,0,,Мағынасы жоқ
Dialogue: 0,0:17:57.78,0:17:59.71,Default,,0,0,0,,Мысық табылды, жеңіл жеңіс
Dialogue: 0,0:18:00.23,0:18:04.34,Default,,0,0,0,,Ай, мен де сиқыршымын.
Dialogue: 0,0:18:04.69,0:18:06.56,Default,,0,0,0,,Мысық ше?
Dialogue: 0,0:18:06.73,0:18:07.93,Default,,0,0,0,,Ештеңе болмайды
Dialogue: 0,0:18:08.04,0:18:11.47,Default,,0,0,0,,Хосе, шықшы.
Dialogue: 0,0:18:13.95,0:18:17.52,Default,,0,0,0,,Гаджил және 4-элемент қайда орналасқан?
Dialogue: 0,0:18:19.65,0:18:22.30,Default,,0,0,0,,Бұл Эльза, «пері ханшайымы»
Dialogue: 0,0:18:22.65,0:18:26.13,Default,,0,0,0,,Лаксус пен Мистоган соғысқа қатыспаса да,
Dialogue: 0,0:18:26.47,0:18:27.78,Default,,0,0,0,,Оны жағыңыз
Dialogue: 0,0:18:27.95,0:18:29.87,Default,,0,0,0,,Бірақ осы уақытқа дейін
Dialogue: 0,0:18:29.91,0:18:33.26,Default,,0,0,0,,Іс Хосе шебердің жоспары бойынша болмады.
Dialogue: 0,0:18:33.47,0:18:37.78,Default,,0,0,0,,Ең дұрысы, қалдықтар өршіп тұр
Dialogue: 0,0:18:41.26,0:18:43.91,Default,,0,0,0,,Барлығы мені тастап кетті.
Dialogue: 0,0:18:44.34,0:18:47.04,Default,,0,0,0,,Ал, мен де Левиге және басқаларға қамқорлық жасауым керек.
Dialogue: 0,0:18:47.08,0:18:48.52,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:18:48.91,0:18:51.43,Default,,0,0,0,,Маған ауа райы мен жаңбыр ұнамайды.
Dialogue: 0,0:18:53.17,0:18:53.69,Default,,0,0,0,,Аристократтар академиясына сұхбат
Dialogue: 0,0:18:55.78,0:19:03.47,Default,,0,0,0,,Шиншинто Иә, Джувиа - жаңбыр қызы Шиншинто
Dialogue: 0,0:19:05.13,0:19:06.82,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:19:07.04,0:19:08.56,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:19:08.91,0:19:10.47,Default,,0,0,0,,Шиншинто
Dialogue: 0,0:19:10.95,0:19:11.82,Default,,0,0,0,,Әй, не?
Dialogue: 0,0:19:13.26,0:19:15.69,Default,,0,0,0,,Көңілді болды. Жақсы көңіл-күй.
Dialogue: 0,0:19:15.73,0:19:16.78,Default,,0,0,0,,Сонда не?
Dialogue: 0,0:19:17.47,0:19:20.13,Default,,0,0,0,,ЖОҚ ЖОҚ ЖОҚ
Dialogue: 0,0:19:20.47,0:19:23.43,Default,,0,0,0,,ЖОҚ ЖОҚ ЖОҚ ЖОҚ ЖОҚ ЖОҚ
Dialogue: 0,0:19:24.21,0:19:27.30,Default,,0,0,0,,Бонжур 337 NO
Dialogue: 0,0:19:27.69,0:19:29.39,Default,,0,0,0,,Тағы бір оғаш нәрсе болды.
Dialogue: 0,0:19:29.43,0:19:33.65,Default,,0,0,0,,Ювия-сама, сен жұмыстан бас тарта алмайсың.
Dialogue: 0,0:19:33.95,0:19:35.26,Default,,0,0,0,,Мырза Ле
Dialogue: 0,0:19:35.52,0:19:38.39,Default,,0,0,0,,Көзілдірігім маған сыбырлап тұр.
Dialogue: 0,0:19:38.43,0:19:42.26,Default,,0,0,0,,Сол мадемуазель менің қымбатты Сипл.
Dialogue: 0,0:19:42.56,0:19:45.43,Default,,0,0,0,,Ой, бұл бала еді.
Dialogue: 0,0:19:45.47,0:19:48.13,Default,,0,0,0,,Қарапайым нысана
Dialogue: 0,0:19:48.30,0:19:52.21,Default,,0,0,0,,Кешіріңіз, кешігіп қалдым. Менің атым Сол.
Dialogue: 0,0:19:52.30,0:19:56.78,Default,,0,0,0,,4-элементтің бірі, біреуді Жердің Нру деп атаңыз
Dialogue: 0,0:19:56.82,0:19:59.47,Default,,0,0,0,,Маған Ле мырза деп қоңырау шалыңыз.
Dialogue: 0,0:19:59.78,0:20:02.34,Default,,0,0,0,,4-элемент «Елес»
Dialogue: 0,0:20:02.60,0:20:06.69,Default,,0,0,0,,Құрметті Ран, біздің екі ұлы «Елес лордтардан»
Dialogue: 0,0:20:06.73,0:20:08.56,Default,,0,0,0,,Мен сені алып кетуге келдім.
Dialogue: 0,0:20:09.56,0:20:13.34,Default,,0,0,0,,Бұл, 4-элементтің бірі, Жаңбыр әйел
Dialogue: 0,0:20:13.60,0:20:16.34,Default,,0,0,0,,Мені мұхиттың Джувиасы деп атаңыз
Dialogue: 0,0:20:19.17,0:20:22.21,Default,,0,0,0,,Балалар сендер Леви-чанға жақсы қарадыңдар.
Dialogue: 0,0:20:23.82,0:20:25.82,Default,,0,0,0,,ЖОҚ ЖОҚ ЖОҚ
Dialogue: 0,0:20:26.08,0:20:29.17,Default,,0,0,0,,Мен үш ЖОҚ белгісімен түсініспеушілікті жойғым келеді.
Dialogue: 0,0:20:29.30,0:20:31.56,Default,,0,0,0,,Гильдияны жойған және Леви-самаға шабуыл жасаған адам
Dialogue: 0,0:20:31.60,0:20:33.56,Default,,0,0,0,,Барлығы Гаджил-сама
Dialogue: 0,0:20:33.91,0:20:35.60,Default,,0,0,0,,Біздің гильдияның ортақ пікірі
Dialogue: 0,0:20:35.65,0:20:37.91,Default,,0,0,0,,Бір нәрсе өзгермейді.
Dialogue: 0,0:20:38.56,0:20:41.21,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:20:42.13,0:20:44.65,Default,,0,0,0,,Ювияның «суға арналған шкафы».
Dialogue: 0,0:20:45.00,0:20:47.08,Default,,0,0,0,,Ешқашан сынбаған
Dialogue: 0,0:20:50.73,0:20:52.26,Default,,0,0,0,,Джотаро, араласудың қажеті жоқ
Dialogue: 0,0:20:52.73,0:20:56.52,Default,,0,0,0,,Жарайды, Ювия сені өлтірмейді.
Dialogue: 0,0:20:56.78,0:21:00.91,Default,,0,0,0,,Өйткені сені үйге апару Ювияның міндеті.
Dialogue: 0,0:21:01.08,0:21:03.47,Default,,0,0,0,,Люси Хартфилия
Dialogue: 0,0:21:04.82,0:21:06.34,Default,,0,0,0,,Бекитвар
Dialogue: 0,0:21:06.47,0:21:10.17,Default,,0,0,0,,Толық, үнсіз түсіру
Dialogue: 0,0:21:14.91,0:21:16.21,Default,,0,0,0,,Мынаны да жеп ал
Dialogue: 0,0:21:22.82,0:21:25.43,Default,,0,0,0,,Тамақ ішкеннен кейін күш жинадым.
Dialogue: 0,0:21:26.00,0:21:26.78,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:21:27.26,0:21:30.17,Default,,0,0,0,,Мен от жедім. Мен бұл жігіт болады деп күтпедім.
Dialogue: 0,0:21:30.91,0:21:34.34,Default,,0,0,0,,Барлығын бірден үрлеп тастаңыз «От айдаһарының арылдауы»
Dialogue: 0,0:21:35.69,0:21:38.34,Default,,0,0,0,,«Мұздан жасалған найза»
Dialogue: 0,0:21:40.65,0:21:44.17,Default,,0,0,0,,«Ағашты үлгілеу сиқыры» «Арамыздағы қашықтық – абырой»
Dialogue: 0,0:21:44.56,0:21:46.73,Default,,0,0,0,,Жоқ, мен түсінбеймін.
Dialogue: 0,0:21:47.26,0:21:48.52,Default,,0,0,0,,Оқ сиқыры
Dialogue: 0,0:21:48.73,0:21:49.87,Default,,0,0,0,,«Ақылсыз ату»
Dialogue: 0,0:21:50.43,0:21:52.56,Default,,0,0,0,,Сиқырлы шашырауды алмастыру
Dialogue: 0,0:21:52.82,0:21:54.52,Default,,0,0,0,,«Кең кадр»
Dialogue: 0,0:21:57.78,0:21:59.65,Default,,0,0,0,,Жасай беруің керек, көзі салбыраған жігіт.
Dialogue: 0,0:22:00.00,0:22:02.08,Default,,0,0,0,,Теме мона, балық көзді жігіт
Dialogue: 0,0:22:02.60,0:22:05.69,Default,,0,0,0,,Тек итерейік. Барайық.
Dialogue: 0,0:22:06.08,0:22:09.43,Default,,0,0,0,,Эльза, мен мұны сендерге қалдырамын.
Dialogue: 0,0:22:09.58,0:22:10.44,Default,,0,0,0,,Ах! Джибрил, қайдан шығып қалдың?
Dialogue: 0,0:22:11.00,0:22:13.69,Default,,0,0,0,,Жозе жоғарғы қабатта болса керек
Dialogue: 0,0:22:13.93,0:22:16.69,Default,,0,0,0,,Мен тыныс алуды тоқтатамын
Dialogue: 0,0:22:18.22,0:22:19.19,Default,,0,0,0,,Ал енді, Арнайы сынып… жарайды—
Dialogue: 0,0:22:22.26,0:22:27.26,Default,,0,0,0,,Енді ең қиын нәрсе жоғалып кетті, енді жабайы болайық.
Dialogue: 0,0:24:06.13,0:24:09.17,Default,,0,0,0,,Ия, мен Люсиді әкелуді ұмытып кетіппін.
Dialogue: 0,0:24:09.21,0:24:13.30,Default,,0,0,0,,Осы уақытқа дейін сіз назардан тыс қалғаныңызға ашулануыңыз мүмкін.
Dialogue: 0,0:24:13.34,0:24:15.91,Default,,0,0,0,,А, ол ашуланғанда мен қорқамын.
Dialogue: 0,0:24:16.26,0:24:18.04,Default,,0,0,0,,Үйге бара жатқанда өзіммен бірге кәдесый ала аламын ба?
Dialogue: 0,0:24:18.08,0:24:18.78,Default,,0,0,0,,Ай
Dialogue: 0,0:24:19.17,0:24:23.08,Default,,0,0,0,,Бірақ мені ең бақытты ететіні – пәтерақыны төлеу.
Dialogue: 0,0:24:26.60,0:24:28.56,Default,,0,0,0,,Бұл дәл қазір Люсидің дауысы.
Dialogue: 0,0:24:28.56,0:24:32.13,Default,,0,0,0,,Мүмкін мен жалдау сұрауым керек шығар. Бұл қорқынышты, Нацу.
Dialogue: 0,0:24:32.47,0:24:33.78,Default,,0,0,0,,Бұл шындық болуы мүмкін емес.
Dialogue: 0,0:24:35.28,0:24:41.28,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory