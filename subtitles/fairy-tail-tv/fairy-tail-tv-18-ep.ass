Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.11,0:00:03.52,Default,,0,0,0,,Барлығы теледидар алдында
Dialogue: 0,0:00:03.86,0:00:05.34,Default,,0,0,0,,«Fairy Tail» фильмін көргенде
Dialogue: 0,0:00:05.47,0:00:06.69,Default,,0,0,0,,Бөлмені жарықтандырыңыз
Dialogue: 0,0:00:07.08,0:00:09.04,Default,,0,0,0,,Теледидардан алыстап, оны қараңыз.
Dialogue: 0,0:00:10.69,0:00:12.52,Default,,0,0,0,,Осы уақытқа дейін «Ертегі» болды
Dialogue: 0,0:00:12.86,0:00:15.39,Default,,0,0,0,,S класындағы квестке барайық, Люси.
Dialogue: 0,0:00:15.60,0:00:19.43,Default,,0,0,0,,Біз Гарна аралына гильдиядан рұқсатсыз келдік.
Dialogue: 0,0:00:19.73,0:00:21.56,Default,,0,0,0,,Клей мен Эльзаны да қатыстырыңыз
Dialogue: 0,0:00:21.60,0:00:25.65,Default,,0,0,0,,Біз Делиораны қайта тірілтуді жоспарлап отырған Арыстан-Аджимен шайқаста да қорытындыға келдік.
Dialogue: 0,0:00:26.04,0:00:29.34,Default,,0,0,0,,Айды жою
Dialogue: 0,0:02:19.73,0:02:22.04,Default,,0,0,0,,Бұдан былай мен ол айды құртамын.
Dialogue: 0,0:02:25.30,0:02:28.47,Default,,0,0,0,,Айды жойып, барлығын бұрынғы қалпына келтірейік.
Dialogue: 0,0:02:30.39,0:02:33.56,Default,,0,0,0,,Көз алдыңда айдың жарылғанын көресің бе?
Dialogue: 0,0:02:33.65,0:02:36.82,Default,,0,0,0,,О, мен ақыры қалыпты жағдайға орала аламын.
Dialogue: 0,0:02:37.04,0:02:40.47,Default,,0,0,0,,Айды құртатын болсаң, сол қирандыларды пайдаланғаның дұрыс емес пе?
Dialogue: 0,0:02:40.73,0:02:41.73,Default,,0,0,0,,Бұл жерден жоғары.
Dialogue: 0,0:02:41.73,0:02:43.17,Default,,0,0,0,,Жоқ, жеткілікті.
Dialogue: 0,0:02:43.60,0:02:46.60,Default,,0,0,0,,Оның үстіне ауыл тұрғындары қирандыларға жақындай алмайды.
Dialogue: 0,0:02:47.00,0:02:48.73,Default,,0,0,0,,Айды жою
Dialogue: 0,0:02:48.78,0:02:51.26,Default,,0,0,0,,Тіпті Эльза да мұны істей алмайды.
Dialogue: 0,0:02:51.52,0:02:53.99,Default,,0,0,0,,Сіз не істеуді жоспарлап отырсыз?
Dialogue: 0,0:02:54.43,0:02:55.82,Default,,0,0,0,,Менің жүрегім дүрсілдеп тұр
Dialogue: 0,0:02:55.82,0:02:57.39,Default,,0,0,0,,Көптеген жолдармен.
Dialogue: 0,0:03:00.08,0:03:02.21,Default,,0,0,0,,Бұл сауыт «алыптың сауыты»
Dialogue: 0,0:03:02.47,0:03:04.69,Default,,0,0,0,,лақтыру күшін арттыру әсері бар
Dialogue: 0,0:03:05.21,0:03:05.95,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:03:12.47,0:03:15.17,Default,,0,0,0,,Қараңғылықты тойтару үшін «Зұлымдық найзасы».
Dialogue: 0,0:03:16.78,0:03:18.65,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:03:18.95,0:03:21.12,Default,,0,0,0,,Сен оны лақтырып, айды жоймақсың ба?
Dialogue: 0,0:03:21.82,0:03:24.04,Default,,0,0,0,,Жоқ, жоқ, мүмкін емес.
Dialogue: 0,0:03:24.43,0:03:27.56,Default,,0,0,0,,Бірақ мұның өзі сізді айға жеткізе алмайды.
Dialogue: 0,0:03:28.21,0:03:31.82,Default,,0,0,0,,Сондықтан мен сенің ату күшіңді оны күшейту үшін пайдаланғым келеді.
Dialogue: 0,0:03:32.73,0:03:34.52,Default,,0,0,0,,Мен найзаны лақтырғанда
Dialogue: 0,0:03:35.00,0:03:37.99,Default,,0,0,0,,Тас бөлігін барынша қатты соғыңыз.
Dialogue: 0,0:03:39.69,0:03:44.86,Default,,0,0,0,,Алыптың сауытының лақтыру күшін атыс күшімен біріктіріп, айды жойыңыз.
Dialogue: 0,0:03:45.00,0:03:46.30,Default,,0,0,0,,Жарайды, түсіндім.
Dialogue: 0,0:03:46.56,0:03:47.30,Default,,0,0,0,,Кеттік
Dialogue: 0,0:03:48.08,0:03:50.91,Default,,0,0,0,,Екеуің неге сонша толқыдыңдар?
Dialogue: 0,0:03:50.95,0:03:53.91,Default,,0,0,0,,Ай шынымен де жойылмайды деп ойлаймын.
Dialogue: 0,0:04:18.52,0:04:18.86,Default,,0,0,0,,Нацу
Dialogue: 0,0:04:18.95,0:04:20.26,Default,,0,0,0,,О
Dialogue: 0,0:04:25.39,0:04:26.47,Default,,0,0,0,,Керемет
Dialogue: 0,0:04:26.69,0:04:27.56,Default,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,0:04:27.69,0:04:29.39,Default,,0,0,0,,Сіз оны қайтадан бұзасыз ба?
Dialogue: 0,0:04:36.47,0:04:38.99,Default,,0,0,0,,Жеткізу
Dialogue: 0,0:04:53.39,0:04:55.12,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,0:05:01.13,0:05:01.86,Default,,0,0,0,,Ай
Dialogue: 0,0:05:02.21,0:05:03.17,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:05:07.47,0:05:09.43,Default,,0,0,0,,Жарылған ай емес.
Dialogue: 0,0:05:10.60,0:05:12.30,Default,,0,0,0,,Аспан жарылды
Dialogue: 0,0:05:14.39,0:05:16.08,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:05:16.65,0:05:20.08,Default,,0,0,0,,Бұл арал зұлымдық фильмімен жабылған.
Dialogue: 0,0:05:20.08,0:05:20.73,Default,,0,0,0,,Мембрана
Dialogue: 0,0:05:20.95,0:05:24.52,Default,,0,0,0,,Бұл «Айдың тамшысынан» туындаған гафф тәрізді нәрсе
Dialogue: 0,0:05:25.00,0:05:28.17,Default,,0,0,0,,Ол кристалданып, аспан үстінде пленка түзді.
Dialogue: 0,0:05:28.86,0:05:32.69,Default,,0,0,0,,Сондықтан ай күлгін болып көрінеді.
Dialogue: 0,0:05:39.60,0:05:44.47,Default,,0,0,0,,Зұлымдықтың қабығы жыртылып, бұл арал өзінің алғашқы жарқырауына ие болады.
Dialogue: 0,0:05:45.69,0:05:46.52,Default,,0,0,0,,Бұл
Dialogue: 0,0:05:47.21,0:05:49.73,Default,,0,0,0,,Қайта оралуы мүмкін емес пе?
Dialogue: 0,0:05:49.91,0:05:50.86,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:05:51.17,0:05:53.60,Default,,0,0,0,,Жоқ, ол қалыпты жағдайға оралды.
Dialogue: 0,0:05:54.08,0:05:56.56,Default,,0,0,0,,Жамандықтың қабығы олардың сыртқы түрі емес.
Dialogue: 0,0:05:56.78,0:05:59.04,Default,,0,0,0,,Мен олардың естеліктерін бұздым.
Dialogue: 0,0:05:59.17,0:05:59.78,Default,,0,0,0,,Жад
Dialogue: 0,0:06:00.21,0:06:02.78,Default,,0,0,0,,«Түнде мен шайтанға айналамын».
Dialogue: 0,0:06:02.78,0:06:04.91,Default,,0,0,0,,Бұл жалған естелік.
Dialogue: 0,0:06:06.30,0:06:09.95,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:06:09.95,0:06:10.91,Default,,0,0,0,,Бұл туралы.
Dialogue: 0,0:06:12.30,0:06:14.34,Default,,0,0,0,,Олар бастапқыда жындар болған
Dialogue: 0,0:06:18.43,0:06:20.08,Default,,0,0,0,,Шынайы
Dialogue: 0,0:06:20.08,0:06:25.30,Default,,0,0,0,,Жарайды, сұрасаң, мен әлі абдырап тұрмын.
Dialogue: 0,0:06:25.86,0:06:29.08,Default,,0,0,0,,Олар адамға айналатын күшке ие болды.
Dialogue: 0,0:06:29.95,0:06:31.91,Default,,0,0,0,,Өзіңізді адамға айналдырыңыз
Dialogue: 0,0:06:32.30,0:06:35.26,Default,,0,0,0,,Мен солай болуы керек деп ойладым.
Dialogue: 0,0:06:35.78,0:06:38.95,Default,,0,0,0,,Бұл «ай тамшысынан» туындаған есте сақтау қабілетінің жоғалуы
Dialogue: 0,0:06:39.91,0:06:42.78,Default,,0,0,0,,Бірақ неге Леон және басқалары жақсы болды?
Dialogue: 0,0:06:43.21,0:06:45.12,Default,,0,0,0,,Өйткені олар адам.
Dialogue: 0,0:06:45.60,0:06:49.26,Default,,0,0,0,,Жадтың жоғалуы тек жындарға ғана әсер етеді.
Dialogue: 0,0:06:50.78,0:06:53.26,Default,,0,0,0,,Сол қирандыларға тек ауыл адамдары жақындай алмайды.
Dialogue: 0,0:06:53.52,0:06:55.26,Default,,0,0,0,,Өйткені олар шайтандар
Dialogue: 0,0:06:55.95,0:06:58.34,Default,,0,0,0,,Қасиетті нұр сақтаған сол қирандыларда
Dialogue: 0,0:06:58.86,0:07:00.69,Default,,0,0,0,,Қараңғы жақын келе алмайды.
Dialogue: 0,0:07:02.52,0:07:06.56,Default,,0,0,0,,Балалар, сендерге қалдырғаныма қуаныштымын.
Dialogue: 0,0:07:08.39,0:07:10.99,Default,,0,0,0,,Рахмет саған, Сиқырлы Жер.
Dialogue: 0,0:07:11.00,0:07:12.56,Default,,0,0,0,,Елес
Dialogue: 0,0:07:12.56,0:07:14.04,Default,,0,0,0,,Қарт теңізші?
Dialogue: 0,0:07:16.69,0:07:18.34,Default,,0,0,0,,Бо бобо
Dialogue: 0,0:07:18.73,0:07:21.39,Default,,0,0,0,,Иә, себебі дұрыс айтасыз.
Dialogue: 0,0:07:21.73,0:07:26.08,Default,,0,0,0,,Кеудемізге пышақ сұғып өлмес едік.
Dialogue: 0,0:07:27.73,0:07:30.69,Default,,0,0,0,,О, сен кемеден жоғалып кеттің.
Dialogue: 0,0:07:32.13,0:07:35.39,Default,,0,0,0,,Кешіріңіз, мен сізге сол кезде шындықты айта алмадым.
Dialogue: 0,0:07:36.56,0:07:41.21,Default,,0,0,0,,Бұл аралдан жалғыз мен ғана есте қалдым.
Dialogue: 0,0:07:41.86,0:07:46.56,Default,,0,0,0,,Ауылда өзін адам санайтындардың бәрінен қорқамын.
Dialogue: 0,0:07:49.86,0:07:56.30,Default,,0,0,0,,Бобо Бобо
Dialogue: 0,0:07:58.78,0:08:01.56,Default,,0,0,0,,Ақыры есін жидың, әке.
Dialogue: 0,0:08:06.82,0:08:07.82,Default,,0,0,0,,Мен тірі едім
Dialogue: 0,0:08:07.82,0:08:08.91,Default,,0,0,0,,Бобо тірі!
Dialogue: 0,0:08:09.13,0:08:09.82,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:08:10.08,0:08:10.91,Default,,0,0,0,,Құттықтаймыз!
Dialogue: 0,0:08:13.26,0:08:14.99,Default,,0,0,0,,Ібіліс аралы?
Dialogue: 0,0:08:15.21,0:08:17.69,Default,,0,0,0,,Бірақ барлығының жүзіне қараңыз.
Dialogue: 0,0:08:19.21,0:08:24.82,Default,,0,0,0,,Шайтаннан гөрі періштеге көбірек ұқса.
Dialogue: 0,0:08:32.91,0:08:38.34,Default,,0,0,0,,Бүгін түн мейрам, шайтанның тойы
Dialogue: 0,0:08:39.65,0:08:42.52,Default,,0,0,0,,Ібіліс тойы керемет естіледі.
Dialogue: 0,0:08:42.78,0:08:43.56,Default,,0,0,0,,Ай
Dialogue: 0,0:08:58.39,0:09:00.82,Default,,0,0,0,,Сіздің жарақатыңыз жақсы ма?
Dialogue: 0,0:09:01.13,0:09:02.08,Default,,0,0,0,,Сіз
Dialogue: 0,0:09:02.73,0:09:04.17,Default,,0,0,0,,Ұмытып қалдыңыз ба?
Dialogue: 0,0:09:09.17,0:09:10.26,Default,,0,0,0,,At that time
Dialogue: 0,0:09:10.39,0:09:12.26,Default,,0,0,0,,Еске салғаныңызға рахмет.
Dialogue: 0,0:09:13.78,0:09:14.69,Default,,0,0,0,,Иә
Dialogue: 0,0:09:15.78,0:09:18.04,Default,,0,0,0,,Ауылға келгеннен бері
Dialogue: 0,0:09:18.26,0:09:21.65,Default,,0,0,0,,Мен Мистер Грейдің қандай жақсы адам екендігі туралы қауесеттер естідім.
Dialogue: 0,0:09:22.00,0:09:22.69,Default,,0,0,0,,Сосора
Dialogue: 0,0:09:22.95,0:09:25.21,Default,,0,0,0,,Салқын салқын дегенді білдіреді.
Dialogue: 0,0:09:25.30,0:09:28.26,Default,,0,0,0,,Бірақ сіз әлі де адам бейнесін ұнатасыз ба?
Dialogue: 0,0:09:28.78,0:09:32.08,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:09:32.17,0:09:34.21,Default,,0,0,0,,Бұл болып жатқан жоқ па?
Dialogue: 0,0:09:34.56,0:09:35.65,Default,,0,0,0,,Сәлем
Dialogue: 0,0:09:35.91,0:09:38.04,Default,,0,0,0,,Грей мырза күткендей мейірімді.
Dialogue: 0,0:09:38.13,0:09:40.12,Default,,0,0,0,,Біз сенімдіміз.
Dialogue: 0,0:09:40.26,0:09:43.52,Default,,0,0,0,,Кел, бірге билейік Шайтанның бұйра данфы
Dialogue: 0,0:09:44.17,0:09:45.95,Default,,0,0,0,,Мистер Грей Грэй мырза
Dialogue: 0,0:09:47.13,0:09:50.39,Default,,0,0,0,,Сұр бұл жігіттердің түрі болатын.
Dialogue: 0,0:09:50.56,0:09:52.26,Default,,0,0,0,,Өте қызық сияқты
Dialogue: 0,0:09:52.78,0:09:55.30,Default,,0,0,0,,Грэй мырза дұрыс айтады.
Dialogue: 0,0:09:56.56,0:09:59.73,Default,,0,0,0,,Біз өзімізді бұл көрсеткіштен төмен сезінеміз.
Dialogue: 0,0:10:00.21,0:10:03.99,Default,,0,0,0,,Олар басқа аралдармен араласуға келді.
Dialogue: 0,0:10:04.17,0:10:09.39,Default,,0,0,0,,Осыған байланысты Гарна аралы қарғысқа ұшырады деген қауесет тарады.
Dialogue: 0,0:10:09.65,0:10:13.99,Default,,0,0,0,,Сондықтан болар, порттағылар бұл аралдан қорқады.
Dialogue: 0,0:10:14.87,0:10:21.69,Default,,0,0,0,,Бірақ қазірден бастап мен басқа елдердің адамдарымен жақынырақ араласқым келеді.
Dialogue: 0,0:10:22.39,0:10:24.91,Default,,0,0,0,,Бір-бірімізге көмектесу үшін
Dialogue: 0,0:10:25.17,0:10:25.82,Default,,0,0,0,,Иә
Dialogue: 0,0:10:26.43,0:10:28.43,Default,,0,0,0,,Егер мұқият талқылайтын болсақ
Dialogue: 0,0:10:28.52,0:10:31.60,Default,,0,0,0,,Өйткені біз сыртқы келбетімізге қарамастан бір-бірімізді түсіне аламыз.
Dialogue: 0,0:10:42.30,0:10:43.91,Default,,0,0,0,,Сіз шынымен барасыз ба?
Dialogue: 0,0:10:44.00,0:10:48.08,Default,,0,0,0,,Әй, бұлай жалғаса берсе, тынышталмаймыз.
Dialogue: 0,0:10:48.21,0:10:50.73,Default,,0,0,0,,Сіз Нөлдік император Рионның соңынан келесіз.
Dialogue: 0,0:10:52.34,0:10:55.34,Default,,0,0,0,,Барлығы «махаббат» үшін
Dialogue: 0,0:11:18.87,0:11:19.21,Default,,0,0,0,,Эй
Dialogue: 0,0:11:19.39,0:11:20.17,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:11:22.34,0:11:23.26,Default,,0,0,0,,Яғни
Dialogue: 0,0:11:24.26,0:11:25.69,Default,,0,0,0,,Нөл Тейдің досы.
Dialogue: 0,0:11:28.26,0:11:29.17,Default,,0,0,0,,Мистер Грей
Dialogue: 0,0:11:29.43,0:11:31.30,Default,,0,0,0,,Маған қалдырыңыз, уайымдамаңыз
Dialogue: 0,0:11:38.00,0:11:39.65,Default,,0,0,0,,Бұл не үшін?
Dialogue: 0,0:11:39.87,0:11:44.56,Default,,0,0,0,,Мен Нөл император Аэон сенімен жүре алмайды деп ойлаймын.
Dialogue: 0,0:11:44.65,0:11:47.56,Default,,0,0,0,,Біз қарызымызды өтеуге келдік.
Dialogue: 0,0:11:47.82,0:11:50.26,Default,,0,0,0,,Сәл ғана, мен тыңдамаймын.
Dialogue: 0,0:11:50.34,0:11:51.91,Default,,0,0,0,,Арыстан екеуміз енді бірге емеспіз.
Dialogue: 0,0:11:52.00,0:11:53.56,Default,,0,0,0,,Мынау мен бұл басқа.
Dialogue: 0,0:11:54.13,0:11:56.47,Default,,0,0,0,,Біз ажыратамыз.
Dialogue: 0,0:11:58.52,0:12:01.39,Default,,0,0,0,,Бұл қызық, қалағаныңды істе.
Dialogue: 0,0:12:01.95,0:12:03.08,Default,,0,0,0,,Жоқ, өмірден бас тартпа
Dialogue: 0,0:12:04.21,0:12:07.95,Default,,0,0,0,,Мен енді саған арқа сүйей алмаймын.
Dialogue: 0,0:12:08.43,0:12:09.69,Default,,0,0,0,,Грекияда жүрген Вамуу—
Dialogue: 0,0:12:09.82,0:12:12.43,Default,,0,0,0,,Ауылымызды қорғамасақ,
Dialogue: 0,0:12:12.60,0:12:14.69,Default,,0,0,0,,Бұл көзқарас әсерлі.
Dialogue: 0,0:12:14.73,0:12:17.82,Default,,0,0,0,,Бірақ мұны маған қалдырыңыз.
Dialogue: 0,0:12:21.13,0:12:23.43,Default,,0,0,0,,«Fairy Till» Титаниясы
Dialogue: 0,0:12:23.73,0:12:26.21,Default,,0,0,0,,Жағалауда көрсеткен көмегіңіз үшін рахмет.
Dialogue: 0,0:12:26.34,0:12:28.26,Default,,0,0,0,,Екінші тарап үшін кемшілік жоқ
Dialogue: 0,0:12:29.56,0:12:30.86,Default,,0,0,0,,Сау бол, Эльза
Dialogue: 0,0:12:31.00,0:12:33.82,Default,,0,0,0,,Бұл әйел тастар мен ағаштарды басқара алады.
Dialogue: 0,0:12:33.95,0:12:37.17,Default,,0,0,0,,Сол біртүрлі қастар сиқырмен бейтараптандырылады.
Dialogue: 0,0:12:37.43,0:12:38.26,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:12:38.78,0:12:42.08,Default,,0,0,0,,Олай болса техниканы қолданар алдында тазалау керек.
Dialogue: 0,0:12:50.87,0:12:52.30,Default,,0,0,0,,Керемет~
Dialogue: 0,0:12:52.30,0:12:53.99,Default,,0,0,0,,Қарусыз да мықтысың.
Dialogue: 0,0:12:54.21,0:12:56.08,Default,,0,0,0,,Бұл Эльза.
Dialogue: 0,0:12:56.60,0:12:57.21,Default,,0,0,0,,мырза.
Dialogue: 0,0:12:59.82,0:13:01.52,Default,,0,0,0,,Керемет жұмыс!
Dialogue: 0,0:13:03.56,0:13:06.56,Default,,0,0,0,,Күтілгендей, бұл өте жақсы
Dialogue: 0,0:13:09.08,0:13:11.13,Default,,0,0,0,,Мүмкін сіз
Dialogue: 0,0:13:11.95,0:13:15.39,Default,,0,0,0,,Менің ойымша, мұндай нәрсе оның орнын толтырмайды.
Dialogue: 0,0:13:15.95,0:13:18.43,Default,,0,0,0,,Кем дегенде мен кемсітушілік танытуға тырысамын.
Dialogue: 0,0:13:18.60,0:13:21.69,Default,,0,0,0,,«қарызды өтеу» дегенді білдіреді.
Dialogue: 0,0:13:22.04,0:13:25.08,Default,,0,0,0,,Мен император Нөлден естідім.
Dialogue: 0,0:13:25.39,0:13:26.73,Default,,0,0,0,,Барлығына рахмет
Dialogue: 0,0:13:26.95,0:13:30.86,Default,,0,0,0,,Біз де Делиораға деген өшпенділіктен құтылдық.
Dialogue: 0,0:13:30.95,0:13:33.60,Default,,0,0,0,,Міне, сен де Делиора.
Dialogue: 0,0:13:34.17,0:13:36.95,Default,,0,0,0,,Жас кезімізде қала қирады.
Dialogue: 0,0:13:37.08,0:13:39.82,Default,,0,0,0,,Отбасы мен достары өртеніп кетті
Dialogue: 0,0:13:40.82,0:13:46.08,Default,,0,0,0,,Сондықтан мен бұл жолы Делиораны жеңу үшін император Нөлге ердім.
Dialogue: 0,0:13:46.91,0:13:49.13,Default,,0,0,0,,Бірақ бұл дегенді білдірмейді
Dialogue: 0,0:13:49.34,0:13:53.91,Default,,0,0,0,,Оған қатысы жоқ адамдарға қиындық тудыруға негіз болмады.
Dialogue: 0,0:13:54.08,0:13:56.13,Default,,0,0,0,,Мен Делиораны қатты жек көремін
Dialogue: 0,0:13:56.30,0:13:59.86,Default,,0,0,0,,Біз «Делиора» сияқты болудың алдында тұрдық.
Dialogue: 0,0:14:00.00,0:14:04.21,Default,,0,0,0,,Біз «махаббатты» ұмыттық
Dialogue: 0,0:14:04.47,0:14:04.95,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:14:07.69,0:14:10.17,Default,,0,0,0,,Біз де бірге тамақтанайық.
Dialogue: 0,0:14:10.52,0:14:12.21,Default,,0,0,0,,Қалай болса да, біз жаумыз
Dialogue: 0,0:14:12.47,0:14:16.13,Default,,0,0,0,,Мен калориясы жоғары тағамдарды жеген кезде салмақ қосамын.
Dialogue: 0,0:14:16.17,0:14:18.91,Default,,0,0,0,,Бұл тәртіпсіз. Көңілді болайық.
Dialogue: 0,0:14:21.26,0:14:23.73,Default,,0,0,0,,Бұл қызықты болады ма?
Dialogue: 0,0:14:34.73,0:14:36.86,Default,,0,0,0,,Сіз оны көрдіңіз.
Dialogue: 0,0:14:36.87,0:14:37.60,Default,,0,0,0,,О
Dialogue: 0,0:14:38.00,0:14:39.95,Default,,0,0,0,,Ауылды не үшін қалпына келтіру керек?
Dialogue: 0,0:14:40.08,0:14:41.26,Default,,0,0,0,,Қызмет
Dialogue: 0,0:14:41.78,0:14:42.65,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:14:43.47,0:14:45.86,Default,,0,0,0,,Бірақ сіз мен күткеннен де көп нәрсені істеп жатқан сияқтысыз.
Dialogue: 0,0:14:46.60,0:14:47.95,Default,,0,0,0,,«Ертегі»
Dialogue: 0,0:14:48.78,0:14:51.65,Default,,0,0,0,,Сіз біздің жолымызға түспейсіз деп үміттенемін.
Dialogue: 0,0:14:59.47,0:15:01.43,Default,,0,0,0,,Иә.
Dialogue: 0,0:15:10.30,0:15:11.99,Default,,0,0,0,,Қасқа не болды?
Dialogue: 0,0:15:12.08,0:15:15.26,Default,,0,0,0,,Әсіресе, тамақ іше алмаймын деп үйге барғанда.
Dialogue: 0,0:15:18.47,0:15:21.08,Default,,0,0,0,,Менің ойымша, кейбір тыртықтар болады.
Dialogue: 0,0:15:21.13,0:15:23.73,Default,,0,0,0,,А, маған бәрібір.
Dialogue: 0,0:15:23.87,0:15:24.39,Default,,0,0,0,,Бет
Dialogue: 0,0:15:24.91,0:15:27.91,Default,,0,0,0,,Маған тыртық қай жерде өсетіні бәрібір.
Dialogue: 0,0:15:28.30,0:15:30.08,Default,,0,0,0,,Көзге көрінетін нәрсе
Dialogue: 0,0:15:30.26,0:15:32.56,Default,,0,0,0,,Әй, жақсы нәрсе айтасың.
Dialogue: 0,0:15:33.08,0:15:34.08,Default,,0,0,0,,Ха, көрінбейтін тыртықтар дегеніміз не?
Dialogue: 0,0:15:34.08,0:15:35.95,Default,,0,0,0,,Ха, көрінбейтін жара дегеніміз не?
Dialogue: 0,0:15:36.17,0:15:39.82,Default,,0,0,0,,Уайымдама, сен жақсы нәрсе айттың, оны жайына қалдыр.
Dialogue: 0,0:15:39.87,0:15:40.69,Default,,0,0,0,,Енді?
Dialogue: 0,0:15:44.30,0:15:48.99,Default,,0,0,0,,Не, мен өтемақы ала алмаймын ба?
Dialogue: 0,0:15:49.39,0:15:51.95,Default,,0,0,0,,Әй, сезімдерің жақсы.
Dialogue: 0,0:15:52.00,0:15:54.60,Default,,0,0,0,,Вегетариандық деген нәрсе бар емес пе?
Dialogue: 0,0:15:54.65,0:15:58.39,Default,,0,0,0,,Бұл іс гильдия ресми түрде қабылдаған өтініш емес.
Dialogue: 0,0:15:58.52,0:16:01.82,Default,,0,0,0,,Кейбір ақымақтардың асыққан жұмысы.
Dialogue: 0,0:16:03.08,0:16:07.34,Default,,0,0,0,,Бұл біздің құтқарылғанымызды өзгертпейді.
Dialogue: 0,0:16:07.43,0:16:15.47,Default,,0,0,0,,Бұл гильдияға сыйлық емес, досқа алғыс.
Dialogue: 0,0:16:20.04,0:16:22.78,Default,,0,0,0,,Бұлай айтқанда бас тарту қиын.
Dialogue: 0,0:16:24.26,0:16:25.65,Default,,0,0,0,,70 миллион Дж
Dialogue: 0,0:16:25.78,0:16:26.43,Default,,0,0,0,,Ура!
Dialogue: 0,0:16:26.69,0:16:31.43,Default,,0,0,0,,Алайда мұны қабылдау гильдия идеалдарына қайшы келеді.
Dialogue: 0,0:16:31.60,0:16:35.65,Default,,0,0,0,,Мен қосымша сыйлық кілті үшін ризамын.
Dialogue: 0,0:16:35.65,0:16:36.69,Default,,0,0,0,,Маған керек емес
Dialogue: 0,0:16:36.69,0:16:37.91,Default,,0,0,0,,...
Dialogue: 0,0:16:38.56,0:16:41.52,Default,,0,0,0,,Жарайды, мен сені тым болмаса Хальционға апарайын.
Dialogue: 0,0:16:41.69,0:16:44.21,Default,,0,0,0,,Жоқ, кеме дайын.
Dialogue: 0,0:16:50.52,0:16:51.99,Default,,0,0,0,,Қарақшы кемесі
Dialogue: 0,0:16:52.04,0:16:54.26,Default,,0,0,0,,Мен оны тонайды деп ойламадым.
Dialogue: 0,0:16:54.30,0:16:55.13,Default,,0,0,0,,Бұл Агент Твайлайт басқаратын академия ма?
Dialogue: 0,0:16:55.78,0:16:59.78,Default,,0,0,0,,Әне-сан
Dialogue: 0,0:17:00.69,0:17:02.21,Default,,0,0,0,,Мені бір нәрсе мазалайды.
Dialogue: 0,0:17:02.21,0:17:03.78,Default,,0,0,0,,Эльза-самадан күткендей
Dialogue: 0,0:17:03.82,0:17:05.08,Default,,0,0,0,,Сондықтан «сама»
Dialogue: 0,0:17:05.87,0:17:08.30,Default,,0,0,0,,Менің барлық шәкірттерім, бортқа мініңдер.
Dialogue: 0,0:17:08.52,0:17:09.52,Default,,0,0,0,,Аға
Dialogue: 0,0:17:09.95,0:17:10.73,Default,,0,0,0,,«Адам өлі ме?»
Dialogue: 0,0:17:10.82,0:17:12.26,Default,,0,0,0,,I don't want to ride like this.
Dialogue: 0,0:17:12.69,0:17:13.99,Default,,0,0,0,,If you go swimming, I'll go with you.
Dialogue: 0,0:17:14.13,0:17:15.26,Default,,0,0,0,,Дұрыс~, оны баяу төмен түсір. Не істегің келетінін білемін.
Dialogue: 0,0:17:22.17,0:17:26.21,Default,,0,0,0,,Барлығыңызға рахмет
Dialogue: 0,0:17:26.56,0:17:29.43,Default,,0,0,0,,Жоқ… Оларды Эрен өлтірді!!
Dialogue: 0,0:17:31.04,0:17:34.69,Default,,0,0,0,,Let's dance the devil's frillidanne again
Dialogue: 0,0:17:34.78,0:17:36.78,Default,,0,0,0,,Жұмысыңызға сәттілік
Dialogue: 0,0:17:36.95,0:17:38.43,Default,,0,0,0,,“Fairy Tail” is the best
Dialogue: 0,0:17:38.65,0:17:41.08,Default,,0,0,0,,Бізге кез келген уақытта келіңіз.
Dialogue: 0,0:17:47.87,0:17:50.04,Default,,0,0,0,,Бәрі бітті
Dialogue: 0,0:17:51.04,0:17:54.04,Default,,0,0,0,,Сіз жылап жатырсыз ба? Мен жыламаймын.
Dialogue: 0,0:17:54.17,0:17:55.73,Default,,0,0,0,,I mean, why are you crying?
Dialogue: 0,0:17:57.21,0:18:01.26,Default,,0,0,0,,Жарайды, бір-бірін түсінуге қиналған кіші шәкіртім.
Dialogue: 0,0:18:01.43,0:18:03.17,Default,,0,0,0,,яғни махаббат
Dialogue: 0,0:18:03.65,0:18:04.73,Default,,0,0,0,,Өкінішті, бірақ…
Dialogue: 0,0:18:09.60,0:18:13.99,Default,,0,0,0,,Эй, гильдиялар қызық па?
Dialogue: 0,0:18:23.08,0:18:25.91,Default,,0,0,0,,Делиорамен болған оқиға өкінішті болды.
Dialogue: 0,0:18:26.21,0:18:28.43,Default,,0,0,0,,Well, I can't help it.
Dialogue: 0,0:18:28.91,0:18:32.34,Default,,0,0,0,,Мен оның өлгенін білмедім.
Dialogue: 0,0:18:32.69,0:18:37.52,Default,,0,0,0,,Делиораны алсам, арманыма бір табан жақындар едім деп ойладым.
Dialogue: 0,0:18:37.74,0:18:39.95,Default,,0,0,0,,I'm sorry, Sicklein.
Dialogue: 0,0:18:40.30,0:18:43.82,Default,,0,0,0,,Мен бұл әйелдің сиқырлы күші соншалықты күшті болады деп күтпедім.
Dialogue: 0,0:18:43.87,0:18:46.21,Default,,0,0,0,,You shouldn't say it like that.
Dialogue: 0,0:18:46.52,0:18:48.82,Default,,0,0,0,,Tears of Ur, Ultia
Dialogue: 0,0:18:49.60,0:18:52.43,Default,,0,0,0,,I respect your mother
Dialogue: 0,0:18:52.52,0:18:55.00,Default,,0,0,0,,Definitely if alive
Dialogue: 0,0:18:55.08,0:18:57.65,Default,,0,0,0,,Ол он ұлы сиқыршының бірі болар еді.
Dialogue: 0,0:18:57.69,0:18:59.21,Default,,0,0,0,,Бұл тым көп
Dialogue: 0,0:18:59.47,0:19:05.13,Default,,0,0,0,,Менің анам жын-шайтандық жолға тым құмар болғандықтан әкем тастап кеткен бейшара әйел болатын.
Dialogue: 0,0:19:05.34,0:19:08.04,Default,,0,0,0,,The more you have to lose, the more
Dialogue: 0,0:19:08.34,0:19:11.34,Default,,0,0,0,,The power you gain will be great.
Dialogue: 0,0:19:11.52,0:19:14.69,Default,,0,0,0,,I am a small person among my mother.
Dialogue: 0,0:19:15.56,0:19:16.69,Default,,0,0,0,,Дора?
Dialogue: 0,0:19:16.91,0:19:20.86,Default,,0,0,0,,Саған деген өкінішім үшін жас шәкіртімді өсірдім.
Dialogue: 0,0:19:20.95,0:19:23.26,Default,,0,0,0,,That's the end of the story.
Dialogue: 0,0:19:23.60,0:19:26.34,Default,,0,0,0,,Let's move on to the next step.
Dialogue: 0,0:19:26.47,0:19:29.04,Default,,0,0,0,,Hey, you have that face.
Dialogue: 0,0:19:29.82,0:19:31.78,Default,,0,0,0,,Қандай Корея
Dialogue: 0,0:19:31.82,0:19:35.39,Default,,0,0,0,,Hahahaha, it's swollen by now.
Dialogue: 0,0:19:36.39,0:19:39.43,Default,,0,0,0,,Ойланып қарасаңыз, Нацумен жекпе-жектен кейін қандай сезімде болдыңыз?
Dialogue: 0,0:19:39.56,0:19:42.13,Default,,0,0,0,,Күшімнің жартысын жұмсамасам да.
Dialogue: 0,0:19:42.47,0:19:43.86,Default,,0,0,0,,It was brilliant.
Dialogue: 0,0:19:44.08,0:19:46.78,Default,,0,0,0,,Сол бала одан да күшті болады.
Dialogue: 0,0:19:47.91,0:19:49.47,Default,,0,0,0,,Келесі, мына жігіт
Dialogue: 0,0:19:50.26,0:19:52.60,Default,,0,0,0,,Игнеилдің сол баласы.
Dialogue: 0,0:19:52.74,0:19:56.43,Default,,0,0,0,,Арманым үшін жанып жүре бер
Dialogue: 0,0:20:01.95,0:20:03.34,Default,,0,0,0,,Мен қайтып келдім.
Dialogue: 0,0:20:03.56,0:20:04.60,Default,,0,0,0,,Міне!
Dialogue: 0,0:20:04.95,0:20:08.86,Default,,0,0,0,,Қаншама еңбектен кейін марапат бір кілт.
Dialogue: 0,0:20:08.95,0:20:11.34,Default,,0,0,0,,Бұл s-класс Kueft болса да.
Dialogue: 0,0:20:11.60,0:20:15.52,Default,,0,0,0,,Бұл ресми жұмыс емес еді, сондықтан бұл дұрыс.
Dialogue: 0,0:20:15.52,0:20:17.86,Default,,0,0,0,,Анда-санда шағымданба
Dialogue: 0,0:20:18.26,0:20:20.73,Default,,0,0,0,,Люси ғана пайда көрген жоқ па?
Dialogue: 0,0:20:20.87,0:20:22.17,Default,,0,0,0,,Оны сатайық.
Dialogue: 0,0:20:22.30,0:20:23.69,Default,,0,0,0,,Сіз не айтасыз, Дранеко?
Dialogue: 0,0:20:24.17,0:20:25.78,Default,,0,0,0,,Мен бұл туралы бұрын айттым.
Dialogue: 0,0:20:25.82,0:20:31.08,Default,,0,0,0,,Алтын кілт Дүние жүзінде зодиак белгілерінің бар болғаны 12 кілті бар.
Dialogue: 0,0:20:31.34,0:20:33.43,Default,,0,0,0,,Бұл өте сирек.
Dialogue: 0,0:20:33.95,0:20:35.73,Default,,0,0,0,,Сол сиырлар мен қызметшілер
Dialogue: 0,0:20:35.74,0:20:37.26,Default,,0,0,0,,Егер мен көбірек жаттығатын болсам
Dialogue: 0,0:20:37.39,0:20:40.26,Default,,0,0,0,,Аспан рухтары сенен күштірек.
Dialogue: 0,0:20:40.43,0:20:43.60,Default,,0,0,0,,Бұл жолы қандай кілт алдыңыз?
Dialogue: 0,0:20:43.74,0:20:45.65,Default,,0,0,0,,Цзиньма сарайының Sagittariunu
Dialogue: 0,0:20:45.82,0:20:46.91,Default,,0,0,0,,Адам мен жылқыға келгенде
Dialogue: 0,0:20:47.78,0:20:49.78,Default,,0,0,0,,Жоқ, олай емес
Dialogue: 0,0:20:51.52,0:20:53.82,Default,,0,0,0,,Бұл жылқы да, адам да емес.
Dialogue: 0,0:20:54.04,0:20:55.78,Default,,0,0,0,,Бұл соншалықты алаңсыз.
Dialogue: 0,0:20:55.95,0:20:59.82,Default,,0,0,0,,Қайтқанда жазаланатынымды ұмытып кеткендей емеспін.
Dialogue: 0,0:21:00.39,0:21:01.47,Default,,0,0,0,,Жою
Dialogue: 0,0:21:01.69,0:21:05.47,Default,,0,0,0,,Бір минут күте тұрыңыз, бірақ сіз мені кінәламадыңыз.
Dialogue: 0,0:21:05.47,0:21:06.60,Default,,0,0,0,,Ақымақ болма
Dialogue: 0,0:21:06.78,0:21:11.39,Default,,0,0,0,,Сіздің іс-әрекеттеріңізді сол жерде менің шешімім мақұлдады.
Dialogue: 0,0:21:11.60,0:21:14.08,Default,,0,0,0,,Жазаны жаза ретінде қабылдау керек.
Dialogue: 0,0:21:15.00,0:21:16.56,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:21:16.91,0:21:22.21,Default,,0,0,0,,Менің ойымша, бұл жолы ¥0 істердің көпшілігін өңдеу дұрыс.
Dialogue: 0,0:21:22.39,0:21:25.26,Default,,0,0,0,,Бірақ шешімді шебер қабылдайды.
Dialogue: 0,0:21:25.26,0:21:27.43,Default,,0,0,0,,Менің қорғауға ниетім жоқ
Dialogue: 0,0:21:27.69,0:21:29.86,Default,,0,0,0,,Біраз жазаға дайын болыңыз.
Dialogue: 0,0:21:29.95,0:21:33.34,Default,,0,0,0,,Мен мұны мәжбүрлеймін деп ешқашан ойламадым.
Dialogue: 0,0:21:33.43,0:21:36.69,Default,,0,0,0,,Бір минут күте тұрыңыз, мен мұны қайталағым келмейді.
Dialogue: 0,0:21:36.87,0:21:38.26,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:21:38.39,0:21:43.65,Default,,0,0,0,,Бұл туралы алаңдамаңыз. Жақсы орындаған жұмыс үшін атаң мақтайды.
Dialogue: 0,0:21:43.65,0:21:45.34,Default,,0,0,0,,Өте оң.
Dialogue: 0,0:21:45.34,0:21:48.34,Default,,0,0,0,,Жоқ, бұл дерлік шешілді.
Dialogue: 0,0:21:48.39,0:21:50.00,Default,,0,0,0,,Қолдарым шырылдап тұр
Dialogue: 0,0:21:53.30,0:21:55.91,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:21:56.00,0:21:59.60,Default,,0,0,0,,Маған бұл ұнамайды.
Dialogue: 0,0:21:59.65,0:22:01.82,Default,,0,0,0,,Сонда бұл не?
Dialogue: 0,0:22:02.34,0:22:05.30,Default,,0,0,0,,Олай болса, бәлкім
Dialogue: 0,0:23:40.08,0:23:43.73,Default,,0,0,0,,Бақытты Сенсейдің ертегі дәрісі
Dialogue: 0,0:23:44.65,0:23:48.13,Default,,0,0,0,,Бүгін біз Fairy Tail фильміндегі достарымызды таныстырамыз.
Dialogue: 0,0:23:48.34,0:23:49.91,Default,,0,0,0,,Сіздің гильдияңызда
Dialogue: 0,0:23:50.00,0:23:51.82,Default,,0,0,0,,Мақтар Макаровтан бастап
Dialogue: 0,0:23:51.95,0:23:55.17,Default,,0,0,0,,Бірге жиналған түрлі сиқырларды қолданатын сиқыршылар бар.
Dialogue: 0,0:23:55.34,0:23:56.04,Default,,0,0,0,,Жоғары
Dialogue: 0,0:23:56.43,0:23:58.13,Default,,0,0,0,,Біз әрқашан ұрысамыз
Dialogue: 0,0:23:58.17,0:24:00.13,Default,,0,0,0,,Біз шынымен жақсы достармыз.
Dialogue: 0,0:24:00.34,0:24:04.13,Default,,0,0,0,,Келесі кездескенше.
Dialogue: 0,0:24:05.69,0:24:09.17,Default,,0,0,0,,Аспанда Бақыт сияқты ұшып кетсем ыңғайлы болар еді.
Dialogue: 0,0:24:09.30,0:24:10.13,Default,,0,0,0,,Ай
Dialogue: 0,0:24:10.21,0:24:12.30,Default,,0,0,0,,Сіз мұны үнемі жасай алмайсыз.
Dialogue: 0,0:24:12.34,0:24:16.00,Default,,0,0,0,,Нацу екеуміз сиқырды ауыстырмайынша.
Dialogue: 0,0:24:16.26,0:24:17.21,Default,,0,0,0,,Бұл жерде тақды шарлатанға тапсыратын орын да емес қой, иә?
Dialogue: 0,0:24:17.65,0:24:20.17,Default,,0,0,0,,Мен мұндай сиқыр жай ғана болды ма деп ойлаймын.
Dialogue: 0,0:24:20.30,0:24:23.30,Default,,0,0,0,,Нацу Сиқырдың құлап кетуі мүмкін емес.
Dialogue: 0,0:24:25.87,0:24:29.65,Default,,0,0,0,,Бірақ мен мұндай сиқырдың бар екенін бір жерден естіген сияқтымын.
Dialogue: 0,0:24:29.65,0:24:31.26,Default,,0,0,0,,Охохо, күткендей, бақытты
Dialogue: 0,0:24:32.39,0:24:33.82,Default,,0,0,0,,Мен ұмытып қалдым
Dialogue: 0,0:24:35.32,0:24:41.32,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory