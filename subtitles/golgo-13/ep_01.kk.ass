Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.12,0:00:05.25,Default,,0,0,0,,(ұшақтың дыбысы)
Dialogue: 0,0:00:14.76,0:00:16.59,Default,,0,0,0,,(Пинг дабыл дыбысы)
Dialogue: 0,0:00:18.18,0:00:19.56,Default,,0,0,0,,Бұл машина жақында келеді⸺
Dialogue: 0,0:00:19.64,0:00:22.60,Default,,0,0,0,,Эль Пасо әуежайына соңғы қону дайындықтарын жасау
Dialogue: 0,0:00:22.68,0:00:25.60,Default,,0,0,0,,Рахмет. (Жолаушы)
Dialogue: 0,0:00:25.69,0:00:28.23,Default,,0,0,0,,…Қауіпсіздік белдігін байлаңыз.
Dialogue: 0,0:00:28.31,0:00:29.61,Default,,0,0,0,,«Барлық American Airlines»
Dialogue: 0,0:00:29.69,0:00:32.74,Default,,0,0,0,,Бұдан былай дәретхананы пайдаланбаңыз.
Dialogue: 0,0:00:35.03,0:00:37.82,Default,,0,0,0,,Тұтынушылар, орындарыңызға оралыңыз...
Dialogue: 0,0:00:37.91,0:00:39.33,Default,,0,0,0,,Ах! Тұтынушы
Dialogue: 0,0:00:41.04,0:00:42.37,Default,,0,0,0,,Орыныңызға отырыңыз.
Dialogue: 0,0:00:42.45,0:00:45.29,Default,,0,0,0,,Мен ваннаға барамын. (Офицер) 15 минут ұстаңыз.
Dialogue: 0,0:00:49.92,0:00:54.13,Default,,0,0,0,,Эль Пасодағы үлкен ванна бөлмесіне кіріңіз, ковбой.
Dialogue: 0,0:00:58.14,0:01:00.76,Default,,0,0,0,,(Айналадағы жолаушылардың шуы)
Dialogue: 0,0:01:00.85,0:01:02.14,Default,,0,0,0,,(Қорқытатын дыбыс)
Dialogue: 0,0:01:03.52,0:01:04.43,Default,,0,0,0,,(тыныс алу)
Dialogue: 0,0:01:05.39,0:01:09.61,Default,,0,0,0,,(Жолаушылар айқайы)
Dialogue: 0,0:01:14.57,0:01:16.24,Default,,0,0,0,,Ақымақ болуды доғар!
Dialogue: 0,0:01:17.41,0:01:21.99,Default,,0,0,0,,Егер сіз бұған қарсы болсаңыз, кешкі газеттің бірінші бетінде осы ұшақтың құлауы туралы болады!
Dialogue: 0,0:01:23.87,0:01:26.29,Default,,0,0,0,,Бұл C4 пластикалық бомба.
Dialogue: 0,0:01:27.21,0:01:28.17,Default,,0,0,0,,(тыныс алу)
Dialogue: 0,0:01:29.67,0:01:32.67,Default,,0,0,0,,Түсінсек, баратын жерімізді Колумбияға ауыстырамыз, капитан!
Dialogue: 0,0:01:33.42,0:01:36.17,Default,,0,0,0,,Бұл ішкі рейс. Ол үшін жанармай жеткіліксіз.
Dialogue: 0,0:01:36.88,0:01:39.68,Default,,0,0,0,,Сондықтан мен Эль Пасода жанармай құямын.
Dialogue: 0,0:01:39.76,0:01:41.14,Default,,0,0,0,,(Қорқытатын дыбыс)
Dialogue: 0,0:01:41.22,0:01:42.72,Default,,0,0,0,,(дыбыстық дыбыс)
Dialogue: 0,0:02:00.41,0:02:01.87,Default,,0,0,0,,Мына жаққа кел
Dialogue: 0,0:02:04.74,0:02:08.83,Default,,0,0,0,,Жолың болды, барда соққан жігіт
Dialogue: 0,0:02:08.92,0:02:11.17,Default,,0,0,0,,Мен залал туралы актіні қайтарып алдым.
Dialogue: 0,0:02:13.88,0:02:15.67,Default,,0,0,0,,Аты... айтыңыз.
Dialogue: 0,0:02:18.68,0:02:20.76,Default,,0,0,0,,Герцог Того
Dialogue: 0,0:02:20.84,0:02:21.93,Default,,0,0,0,,(соқтығыс дыбысы)
Dialogue: 0,0:02:27.02,0:02:31.56,Default,,0,0,0,,(♪~Ашық ән)
Dialogue: 0,0:03:55.40,0:03:56.94,Default,,0,0,0,,(Ашық ән~♪)
Dialogue: 0,0:03:57.57,0:03:59.23,Default,,0,0,0,,(Шыншыл музыка)
Dialogue: 0,0:04:05.03,0:04:06.95,Default,,0,0,0,,«Полиция»
Dialogue: 0,0:04:07.03,0:04:11.45,Default,,0,0,0,,Полицияны дереу жіберіңіз Жолаушыларға не болады?
Dialogue: 0,0:04:11.54,0:04:14.04,Default,,0,0,0,,Түсіндім, мен сені бірден жіберемін.
Dialogue: 0,0:04:14.12,0:04:15.46,Default,,0,0,0,,Жанармайды тез құйыңыз!
Dialogue: 0,0:04:16.04,0:04:19.84,Default,,0,0,0,,Нашар орындасаң, ұшақты жарып жіберемін.
Dialogue: 0,0:04:20.42,0:04:23.55,Default,,0,0,0,,Мен қазір келісім жасап жатырмын. Тағы біраз күтіңіз.
Dialogue: 0,0:04:23.63,0:04:26.34,Default,,0,0,0,,SWAT Біз қылмыскерді қандай да бір жолмен ұрып тастай аламыз ба?
Dialogue: 0,0:04:26.43,0:04:30.06,Default,,0,0,0,,Жоқ, бұл жерден тым алыс.
Dialogue: 0,0:04:31.81,0:04:33.14,Default,,0,0,0,,Біраз уақыт өтті.
Dialogue: 0,0:04:33.23,0:04:35.10,Default,,0,0,0,,Того мырза
Dialogue: 0,0:04:40.19,0:04:43.11,Default,,0,0,0,,Есіңе түсіп, маған берген сияқтысың.
Dialogue: 0,0:04:50.70,0:04:55.04,Default,,0,0,0,,(Мазасыздықты арттыратын музыка)
Dialogue: 0,0:04:56.62,0:04:58.42,Default,,0,0,0,,(демілеу)
Dialogue: 0,0:04:58.50,0:05:04.13,Default,,0,0,0,,Кешіріңіз, ол ФБР агенті Ховард.
Dialogue: 0,0:05:04.84,0:05:07.34,Default,,0,0,0,,Менің атым Майкл Ховард. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:05:08.72,0:05:12.35,Default,,0,0,0,,ЦРУ мен ФБР қашан дос болды?
Dialogue: 0,0:05:12.43,0:05:14.14,Default,,0,0,0,,(Сөз таппай)
Dialogue: 0,0:05:14.23,0:05:17.35,Default,,0,0,0,,Оны жайлап түсіндірейік.
Dialogue: 0,0:05:19.94,0:05:22.90,Default,,0,0,0,,О, бұл дөрекі.
Dialogue: 0,0:05:24.03,0:05:28.57,Default,,0,0,0,,Артымды көрсетіп, бірінші кіргенді ұнатпаймын.
Dialogue: 0,0:05:28.66,0:05:31.49,Default,,0,0,0,,Бұл жағдайда ол сіздің қалауыңызға сәйкес болуы керек.
Dialogue: 0,0:05:36.58,0:05:38.46,Default,,0,0,0,,Рахмет. Кешіріңіз.
Dialogue: 0,0:05:43.71,0:05:45.55,Default,,0,0,0,,Сізді нысанаға алған сияқты.
Dialogue: 0,0:05:46.13,0:05:48.05,Default,,0,0,0,,(Жұмбақ музыка)
Dialogue: 0,0:05:48.13,0:05:48.97,Default,,0,0,0,,«Мафия басшысы атып өлтірілді»
Dialogue: 0,0:05:49.05,0:05:52.56,Default,,0,0,0,,Техастағы ең үлкен мафия дон өлтірілді.
Dialogue: 0,0:05:52.64,0:05:55.35,Default,,0,0,0,,Қол астындағылар үндемеу керек.
Dialogue: 0,0:05:55.43,0:05:57.31,Default,,0,0,0,,Сіз өзіңіз қамауға алындыңыз.
Dialogue: 0,0:05:57.39,0:06:00.06,Default,,0,0,0,,Мен Далластан қашу мүмкіндігін күттім.
Dialogue: 0,0:06:00.65,0:06:02.52,Default,,0,0,0,,Мұны істеудің қажеті жоқ
Dialogue: 0,0:06:02.61,0:06:05.69,Default,,0,0,0,,Сіз бізді Далластан абыроймен кету үшін пайдалана аласыз.
Dialogue: 0,0:06:05.78,0:06:09.07,Default,,0,0,0,,Сыйақы – 3 миллион доллар ақшалай
Dialogue: 0,0:06:09.16,0:06:14.20,Default,,0,0,0,,Біз қалаған ғажайып мергендікті тамаша орындай алатын адам
Dialogue: 0,0:06:14.29,0:06:17.29,Default,,0,0,0,,Менің ойыма сенен басқа ештеңе келмейді.
Dialogue: 0,0:06:17.37,0:06:19.58,Default,,0,0,0,,Того мырза... жоқ...
Dialogue: 0,0:06:20.83,0:06:22.59,Default,,0,0,0,,Голго 13
Dialogue: 0,0:06:23.46,0:06:25.34,Default,,0,0,0,,Жанармай құюға қанша уақыт кетеді?
Dialogue: 0,0:06:26.01,0:06:27.67,Default,,0,0,0,,30 минуттай
Dialogue: 0,0:06:27.76,0:06:28.84,Default,,0,0,0,,Уақыт қажет болса
Dialogue: 0,0:06:28.93,0:06:31.76,Default,,0,0,0,,Қажетсіз нәрселер туралы ойлайтын адамдар әрқашан болады.
Dialogue: 0,0:06:31.84,0:06:32.76,Default,,0,0,0,,(Сөз таппай)
Dialogue: 0,0:06:33.51,0:06:34.81,Default,,0,0,0,,Джейк Куад
Dialogue: 0,0:06:34.89,0:06:37.10,Default,,0,0,0,,Жарты жылды белгіледік
Dialogue: 0,0:06:37.18,0:06:40.27,Default,,0,0,0,,Бұл мен жақында ұстағалы тұрған адам.
Dialogue: 0,0:06:40.35,0:06:45.27,Default,,0,0,0,,Кокаин сатушысы және Пентагонның жоғары лауазымды қызметкері
Dialogue: 0,0:06:45.36,0:06:48.57,Default,,0,0,0,,Ең жоғары сапалы кокаинмен қамтамасыз ету үшін
Dialogue: 0,0:06:48.65,0:06:51.78,Default,,0,0,0,,Негізгі әскери құпияларға қол жеткізу
Dialogue: 0,0:06:51.86,0:06:55.16,Default,,0,0,0,,Барлау органдарына қымбат бағамен сату
Dialogue: 0,0:06:55.24,0:06:59.41,Default,,0,0,0,,Ол біздің қимыл-қозғалысымызды сезіп, қашу жоспарын жасады.
Dialogue: 0,0:07:00.87,0:07:04.59,Default,,0,0,0,,Халықаралық рейстерде төлқұжаттарды тексеру қатаң
Dialogue: 0,0:07:04.67,0:07:07.80,Default,,0,0,0,,Сондықтан болар отандық лайнерді басып алған.
Dialogue: 0,0:07:08.42,0:07:13.85,Default,,0,0,0,,Бірақ мен оның осы жолы тапқан ақпаратын елден алып кеткенін қаламаймын⸺
Dialogue: 0,0:07:13.93,0:07:16.31,Default,,0,0,0,,Зымыранға қарсы қорғаныстың соңғы жүйесі.
Dialogue: 0,0:07:17.77,0:07:19.31,Default,,0,0,0,,Сіз мұны мен үшін жасай аласыз ба?
Dialogue: 0,0:07:21.10,0:07:22.81,Default,,0,0,0,,Неге мен?
Dialogue: 0,0:07:23.56,0:07:24.94,Default,,0,0,0,,Ірі әуежайларда
Dialogue: 0,0:07:25.02,0:07:29.32,Default,,0,0,0,,Қылмыскер байқамай ұшаққа жақындау оңай емес.
Dialogue: 0,0:07:29.40,0:07:31.90,Default,,0,0,0,,Егер сіз оны нашар қоздырсаңыз
Dialogue: 0,0:07:31.99,0:07:34.57,Default,,0,0,0,,Жолаушылар жолда жарылуы мүмкін
Dialogue: 0,0:07:35.28,0:07:37.58,Default,,0,0,0,,Бұл бір оқпен өлтіру болуы керек.
Dialogue: 0,0:07:37.66,0:07:40.58,Default,,0,0,0,,Мергендіктен басқа уақытымыз аз.
Dialogue: 0,0:07:40.66,0:07:44.08,Default,,0,0,0,,Мүмкіндігінше кейінге қалдыруға тырысыңыз
Dialogue: 0,0:07:44.17,0:07:45.96,Default,,0,0,0,,Біздің еліміз үшін
Dialogue: 0,0:07:46.04,0:07:49.42,Default,,0,0,0,,160 жолаушыға арналған деп айтпаймын.
Dialogue: 0,0:07:49.51,0:07:54.84,Default,,0,0,0,,Мен сіздің кәсіби қабілетіңізді сатып аламын. Мені қабыл алыңыз.
Dialogue: 0,0:07:58.64,0:08:01.85,Default,,0,0,0,,Мен дайын болғаннан кейін... Әуежайға бет алыңыз
Dialogue: 0,0:08:01.93,0:08:03.35,Default,,0,0,0,,(Жеңілдету)
Dialogue: 0,0:08:04.15,0:08:06.36,Default,,0,0,0,,Біз оны уақытында орындасақ.
Dialogue: 0,0:08:07.11,0:08:09.36,Default,,0,0,0,,Рахмет сізге Голго13
Dialogue: 0,0:08:25.63,0:08:29.09,Default,,0,0,0,,Сыйлықтар мен қажетті деректер көлікте
Dialogue: 0,0:08:29.17,0:08:31.67,Default,,0,0,0,,Оны қанша уақытқа кейінге қалдыруым керек?
Dialogue: 0,0:08:32.34,0:08:33.67,Default,,0,0,0,,Төрт сағат.
Dialogue: 0,0:08:36.30,0:08:37.68,Default,,0,0,0,,4 сағат...
Dialogue: 0,0:08:44.48,0:08:48.40,Default,,0,0,0,,(Дыбысты қосу)
Dialogue: 0,0:08:57.95,0:08:59.83,Default,,0,0,0,,Карталар таратылды
Dialogue: 0,0:09:03.96,0:09:05.54,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:09:07.79,0:09:12.38,Default,,0,0,0,,Егер ФБР мен ЦРУ болса, сіз қашып кетер ме едіңіз?
Dialogue: 0,0:09:12.46,0:09:14.80,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:09:15.63,0:09:18.80,Default,,0,0,0,,Менің әкемді сол азиат өлтірді!
Dialogue: 0,0:09:18.89,0:09:22.52,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:09:24.60,0:09:28.02,Default,,0,0,0,,Балалар, тым жалқау болсаңдар, мен сендерді өлтіремін.
Dialogue: 0,0:09:29.02,0:09:32.02,Default,,0,0,0,,(саксофонмен джаз)
Dialogue: 0,0:09:38.11,0:09:41.03,Default,,0,0,0,,«Биллидің дүкені»
Dialogue: 0,0:09:47.33,0:09:48.58,Default,,0,0,0,,(Кенеттен түсінген дауыс)
Dialogue: 0,0:09:55.76,0:09:57.80,Default,,0,0,0,,(Саксофон кенет тоқтайды)
Dialogue: 0,0:10:00.93,0:10:01.97,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:10:02.68,0:10:05.43,Default,,0,0,0,,Ах! Аа, дұрыс
Dialogue: 0,0:10:22.16,0:10:25.70,Default,,0,0,0,,Біздің өнеркәсіп те құлдырауда.
Dialogue: 0,0:10:25.79,0:10:28.50,Default,,0,0,0,,Мен жер астына түсіп, ұсақ-түйек істермен айналысамын.
Dialogue: 0,0:10:28.58,0:10:30.08,Default,,0,0,0,,(қатты күлу)
Dialogue: 0,0:10:31.54,0:10:33.79,Default,,0,0,0,,Тұтынушы әкелді
Dialogue: 0,0:10:36.21,0:10:39.63,Default,,0,0,0,,(Музыка)
Dialogue: 0,0:10:43.18,0:10:44.39,Default,,0,0,0,,Ｄ！
Dialogue: 0,0:10:45.68,0:10:48.10,Default,,0,0,0,,Голго мырза 13.
Dialogue: 0,0:10:48.18,0:10:49.64,Default,,0,0,0,,Иә
Dialogue: 0,0:10:49.73,0:10:51.23,Default,,0,0,0,,Біріншіден, аяқтарыңыздың астындағы қорапқа қараңыздар
Dialogue: 0,0:10:51.81,0:10:54.40,Default,,0,0,0,,Керемет! Мен әсер алдым
Dialogue: 0,0:10:54.48,0:10:57.74,Default,,0,0,0,,Мен нағыз Голго 13-пен кездесуді шыдамаймын.
Dialogue: 0,0:10:58.44,0:11:00.15,Default,,0,0,0,,Көрдіңіз бе?
Dialogue: 0,0:11:00.24,0:11:02.91,Default,,0,0,0,,Бұл бизнес сенім туралы.
Dialogue: 0,0:11:02.99,0:11:03.95,Default,,0,0,0,,Маған басқаларын көрсетіңіз
Dialogue: 0,0:11:04.03,0:11:05.08,Default,,0,0,0,,Ах
Dialogue: 0,0:11:05.16,0:11:08.62,Default,,0,0,0,,Сіз Хеммелге ұнамайды дейсіз бе?
Dialogue: 0,0:11:08.70,0:11:11.33,Default,,0,0,0,,Бұл әлемге әйгілі швейцариялық қару.
Dialogue: 0,0:11:11.42,0:11:13.46,Default,,0,0,0,,Калибр 308Win
Dialogue: 0,0:11:13.54,0:11:15.92,Default,,0,0,0,,Максималды атыс қашықтығы 1400 метр
Dialogue: 0,0:11:16.00,0:11:18.51,Default,,0,0,0,,Көрнекі тиімді диапазон 500-ден
Dialogue: 0,0:11:18.59,0:11:22.34,Default,,0,0,0,,580 метр бастапқы жылдамдық 1 секунд 2700 фут
Dialogue: 0,0:11:22.43,0:11:24.10,Default,,0,0,0,,Жарайды, жақсы. (D) Иә.
Dialogue: 0,0:11:24.72,0:11:27.10,Default,,0,0,0,,Бірақ біраз өзгерістер енгізіңіз.
Dialogue: 0,0:11:27.72,0:11:29.85,Default,,0,0,0,,Бөшкені 32 дюймге дейін созыңыз
Dialogue: 0,0:11:29.93,0:11:33.35,Default,,0,0,0,,Бір өлшемді үлкенірек картриджді пайдалануға рұқсат етіңіз.
Dialogue: 0,0:11:33.44,0:11:35.61,Default,,0,0,0,,Көбірек ұнтақ қосуды ұмытпаңыз
Dialogue: 0,0:11:35.69,0:11:38.11,Default,,0,0,0,,Жер бетіндегі нысана не?
Dialogue: 0,0:11:38.19,0:11:39.07,Default,,0,0,0,,(Елеулі дыбыс әсері)
Dialogue: 0,0:11:39.15,0:11:42.11,Default,,0,0,0,,Екі шақырым жерде... футбол бар.
Dialogue: 0,0:11:42.20,0:11:43.95,Default,,0,0,0,,(Оқиғаны жандандыратын музыка)
Dialogue: 0,0:11:44.53,0:11:46.66,Default,,0,0,0,,3 сағат ішінде орындаңыз.
Dialogue: 0,0:11:46.74,0:11:48.16,Default,,0,0,0,,Бұл өте абайсызда
Dialogue: 0,0:11:49.54,0:11:50.91,Default,,0,0,0,,300 000 доллар төлеңіз
Dialogue: 0,0:11:51.00,0:11:52.46,Default,,0,0,0,,(тыныс дыбысы)
Dialogue: 0,0:11:54.54,0:11:55.96,Default,,0,0,0,,мылтық үшін 100 000
Dialogue: 0,0:11:56.75,0:11:59.96,Default,,0,0,0,,сағатына 200 000 доллар.
Dialogue: 0,0:12:00.05,0:12:03.43,Default,,0,0,0,,(♪Тақырыптық ән)
Dialogue: 0,0:12:13.69,0:12:15.48,Default,,0,0,0,,Полиция көлігін алып тастаңыз
Dialogue: 0,0:12:15.56,0:12:18.23,Default,,0,0,0,,Жанармай құю аяқталды.
Dialogue: 0,0:12:18.32,0:12:19.73,Default,,0,0,0,,Дүрбелеңге салынбаңыз
Dialogue: 0,0:12:19.82,0:12:21.49,Default,,0,0,0,,Оңтүстік Америкаға барсаңыз да
Dialogue: 0,0:12:21.57,0:12:23.99,Default,,0,0,0,,Сізге қабылдаушы хосттан рұқсат алу керек.
Dialogue: 0,0:12:24.07,0:12:28.20,Default,,0,0,0,,Ақымақ болма. Егер кеткің келмесе, мен өзім барамын.
Dialogue: 0,0:12:28.28,0:12:30.49,Default,,0,0,0,,Күте тұрыңыз, мен жақын арада жауап аламын...
Dialogue: 0,0:12:30.58,0:12:32.91,Default,,0,0,0,,Эй!
Dialogue: 0,0:12:34.50,0:12:37.04,Default,,0,0,0,,Шектеу бар. Амал жоқ, атуға тырысамын.
Dialogue: 0,0:12:37.13,0:12:38.84,Default,,0,0,0,,Снайпер мүмкін емес
Dialogue: 0,0:12:38.92,0:12:39.75,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:12:45.13,0:12:48.22,Default,,0,0,0,,Ағымдағы снайпер нүктесі кабинаның алдында.
Dialogue: 0,0:12:49.10,0:12:53.23,Default,,0,0,0,,Жабық болмағандықтан, әскерді орналастыру мүмкін емес.
Dialogue: 0,0:12:53.31,0:12:56.48,Default,,0,0,0,,Біз қазір ұшақтан 1 км қашықтықтамыз⸺
Dialogue: 0,0:12:56.56,0:12:58.94,Default,,0,0,0,,Ол шөптің арасына қойылған.
Dialogue: 0,0:12:59.02,0:13:02.28,Default,,0,0,0,,Сол жерден қылмыскерге кабинада оқ ату ғана қалады.
Dialogue: 0,0:13:02.86,0:13:04.78,Default,,0,0,0,,Мүлде мүмкін емес
Dialogue: 0,0:13:05.36,0:13:08.32,Default,,0,0,0,,Егер сіз бірнеше оқ атсаңыз, кем дегенде бір соққы алуыңыз мүмкін.
Dialogue: 0,0:13:08.41,0:13:11.70,Default,,0,0,0,,Бұл мүмкін, бірақ мен түсіріп жатқанда.
Dialogue: 0,0:13:11.79,0:13:13.79,Default,,0,0,0,,Қылмыскер ұшақты жарып жібереді.
Dialogue: 0,0:13:14.50,0:13:16.17,Default,,0,0,0,,1 км қашықтықтағы адам
Dialogue: 0,0:13:16.25,0:13:19.67,Default,,0,0,0,,Мен бір оқпен өлтіретін мергенді білмеймін.
Dialogue: 0,0:13:19.75,0:13:22.76,Default,,0,0,0,,Мен қазір ол адамды реттеп жатырмын.
Dialogue: 0,0:13:23.42,0:13:24.80,Default,,0,0,0,,Директор Фланаган
Dialogue: 0,0:13:24.88,0:13:26.76,Default,,0,0,0,,Біраз уақытты сатып алыңыз
Dialogue: 0,0:13:27.47,0:13:28.59,Default,,0,0,0,,(Аа... дауыс)
Dialogue: 0,0:13:28.68,0:13:32.60,Default,,0,0,0,,Бұл істі сол кісі шешеді.
Dialogue: 0,0:13:32.68,0:13:36.60,Default,,0,0,0,,(Жұмбақ музыка)
Dialogue: 0,0:13:40.86,0:13:43.36,Default,,0,0,0,,(Тыңдаған дауыс)
Dialogue: 0,0:13:47.78,0:13:48.82,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:13:52.16,0:13:57.25,Default,,0,0,0,,(Тыңдаған дауыс)
Dialogue: 0,0:14:06.51,0:14:09.80,Default,,0,0,0,,Ұшу жолағында көліктерді баяу жылжытыңыз.
Dialogue: 0,0:14:10.59,0:14:13.81,Default,,0,0,0,,Белгіленген уақытқа бір жарым сағат қалды
Dialogue: 0,0:14:13.89,0:14:16.35,Default,,0,0,0,,Мен не істеуім керек, директор Реган?
Dialogue: 0,0:14:16.43,0:14:17.89,Default,,0,0,0,,(Үру)
Dialogue: 0,0:14:25.40,0:14:26.82,Default,,0,0,0,,(Уууу... арылдаған дауыс)
Dialogue: 0,0:14:33.41,0:14:36.08,Default,,0,0,0,,Бұл шина. Маған доңғалақты ұрып берейін.
Dialogue: 0,0:14:36.16,0:14:37.33,Default,,0,0,0,,Ха!
Dialogue: 0,0:14:37.41,0:14:40.62,Default,,0,0,0,,Штаб-пәтерден Альфаға дейін жолаушылар ұшағы шиналары үшін
Dialogue: 0,0:14:40.71,0:14:42.92,Default,,0,0,0,,Дөңгелегіңіз жарылғандай етіп көрсетіңіз
Dialogue: 0,0:14:49.72,0:14:51.68,Default,,0,0,0,,«Қонақ үй»
Dialogue: 0,0:15:06.19,0:15:08.19,Default,,0,0,0,,Әлі жақсы емес.
Dialogue: 0,0:15:12.53,0:15:14.78,Default,,0,0,0,,Бұл менің бірінші рет
Dialogue: 0,0:15:14.87,0:15:18.04,Default,,0,0,0,,Мен келесі тұтынушылардан бас тартамын, өтінемін.
Dialogue: 0,0:15:18.12,0:15:19.20,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:15:22.29,0:15:24.29,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:15:24.38,0:15:27.50,Default,,0,0,0,,(Шыншыл музыка)
Dialogue: 0,0:15:35.10,0:15:36.10,Default,,0,0,0,,(Ах! дауыс)
Dialogue: 0,0:15:39.81,0:15:41.98,Default,,0,0,0,,Біріншіден, аяқтарыңыздың астындағы қорапқа қараңыздар
Dialogue: 0,0:15:52.03,0:15:55.41,Default,,0,0,0,,(Шыншыл музыка)
Dialogue: 0,0:16:05.75,0:16:06.88,Default,,0,0,0,,Уау
Dialogue: 0,0:16:08.34,0:16:10.88,Default,,0,0,0,,Уф... (Еркек) Қорықпа.
Dialogue: 0,0:16:18.26,0:16:21.18,Default,,0,0,0,,Уваа
Dialogue: 0,0:16:21.98,0:16:23.85,Default,,0,0,0,,Цк
Dialogue: 0,0:16:26.06,0:16:27.48,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:16:33.53,0:16:36.49,Default,,0,0,0,,(қоңыр музыка)
Dialogue: 0,0:16:39.58,0:16:42.00,Default,,0,0,0,,(Ах... дірілдеген дауыс)
Dialogue: 0,0:16:47.04,0:16:52.01,Default,,0,0,0,,«Сіз түсінетін боларсыз, бұл бейбітшілік келісіміне қол қою рәсімі —»
Dialogue: 0,0:17:03.60,0:17:05.02,Default,,0,0,0,,Әрине, оны есінен тандырып тастаған дұрыс қой?
Dialogue: 0,0:17:09.15,0:17:10.57,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:17:10.65,0:17:13.57,Default,,0,0,0,,(Жолаушылар айқайы)
Dialogue: 0,0:17:24.62,0:17:26.04,Default,,0,0,0,,(дыбыс)
Dialogue: 0,0:17:26.12,0:17:27.75,Default,,0,0,0,,Сіз не істедіңіз?
Dialogue: 0,0:17:27.83,0:17:29.59,Default,,0,0,0,,Па... Бұл панк. (Қылмыскер) Не?
Dialogue: 0,0:17:30.38,0:17:32.25,Default,,0,0,0,,Менің дөңгелегім жарылып, жарылып кетті.
Dialogue: 0,0:17:32.34,0:17:34.59,Default,,0,0,0,,Өтірікші! (Капитан) Бұл рас.
Dialogue: 0,0:17:35.34,0:17:36.68,Default,,0,0,0,,(Уф... арылдаған дауыс)
Dialogue: 0,0:17:37.76,0:17:39.85,Default,,0,0,0,,Шиналарды дереу ауыстырыңыз
Dialogue: 0,0:17:39.93,0:17:42.10,Default,,0,0,0,,Түсіндім, мен оны бірден реттеймін.
Dialogue: 0,0:17:44.73,0:17:46.44,Default,,0,0,0,,Бұл сізге уақытты сатып алады
Dialogue: 0,0:17:46.52,0:17:49.61,Default,,0,0,0,,Жоқ, бірдеңе болды.
Dialogue: 0,0:17:50.27,0:17:52.48,Default,,0,0,0,,Әуе лайнерінің орналасқан жері Гольгоға хабарлады.
Dialogue: 0,0:17:52.57,0:17:54.19,Default,,0,0,0,,Көп нәрсе өзгерді
Dialogue: 0,0:17:54.28,0:17:58.57,Default,,0,0,0,,Голго алдыңғы деректерге сүйене отырып, снайпердің атуын есептеу керек еді.
Dialogue: 0,0:17:58.66,0:17:59.62,Default,,0,0,0,,Хе-хе, хе-хе-хе…
Dialogue: 0,0:17:59.70,0:18:03.83,Default,,0,0,0,,Гольго ойлаған мергендік әдісін қолдануға болмайды.
Dialogue: 0,0:18:03.91,0:18:05.62,Default,,0,0,0,,(Үрілген дауыс)
Dialogue: 0,0:18:07.21,0:18:10.38,Default,,0,0,0,,(тыныш көтеретін музыка)
Dialogue: 0,0:18:13.59,0:18:17.38,Default,,0,0,0,,Бұл тура 3 сағат 1 минут, солай ма?
Dialogue: 0,0:18:19.47,0:18:22.39,Default,,0,0,0,,Бөшке ұзын болғандықтан қорды ауырлаттым.
Dialogue: 0,0:18:22.47,0:18:23.89,Default,,0,0,0,,Баланс жақсы болар еді.
Dialogue: 0,0:18:24.47,0:18:26.60,Default,,0,0,0,,Салмағы 8,6 кг
Dialogue: 0,0:18:26.68,0:18:31.90,Default,,0,0,0,,Әдетте, оны қолданатын адамның салмағының 6-7% салмағы бар мылтық жақсы деп айтылады.
Dialogue: 0,0:18:31.98,0:18:35.40,Default,,0,0,0,,Сіз бұл ауыр мылтықпен жақсы болуыңыз керек.
Dialogue: 0,0:18:36.57,0:18:40.41,Default,,0,0,0,,Сіз қалай ойлайсыз? Жұмыс (Голго 13) тамаша.
Dialogue: 0,0:18:40.49,0:18:42.07,Default,,0,0,0,,(күледі)
Dialogue: 0,0:18:42.16,0:18:43.95,Default,,0,0,0,,2 километр қашықтықтағы нүктеден
Dialogue: 0,0:18:44.03,0:18:46.62,Default,,0,0,0,,Кабина ішіндегі нысананы көздеу?
Dialogue: 0,0:18:46.70,0:18:49.50,Default,,0,0,0,,Бұл тек сенің қолыңнан келетін қулық.
Dialogue: 0,0:18:49.58,0:18:51.08,Default,,0,0,0,,(Ой, мені алаңдатқан дауыс)
Dialogue: 0,0:18:54.21,0:18:56.13,Default,,0,0,0,,А... бұл мүмкін емес (дыбыстық дыбыс)
Dialogue: 0,0:18:56.21,0:18:59.09,Default,,0,0,0,,Енді кабинаны көздеу
Dialogue: 0,0:18:59.17,0:19:02.64,Default,,0,0,0,,Тек өте алыстағы шағын ұшақтардың ұшу-қону жолағынан.
Dialogue: 0,0:19:03.35,0:19:05.64,Default,,0,0,0,,Не істейсің... Ахх
Dialogue: 0,0:19:07.68,0:19:09.77,Default,,0,0,0,,(қанағаттанған дауыс)
Dialogue: 0,0:19:09.85,0:19:13.65,Default,,0,0,0,,Ертеңгі таңғы газетті асыға күтуге болады.
Dialogue: 0,0:19:20.24,0:19:23.62,Default,,0,0,0,,Голго пайда бола ма?
Dialogue: 0,0:19:23.70,0:19:25.58,Default,,0,0,0,,Қандай жағдай болмасын
Dialogue: 0,0:19:25.66,0:19:30.16,Default,,0,0,0,,Ол жұмысқа қабылданғаннан кейін бас тартатын жігіт емес.
Dialogue: 0,0:19:31.21,0:19:34.08,Default,,0,0,0,,(Шұғыл музыка)
Dialogue: 0,0:19:35.38,0:19:38.26,Default,,0,0,0,,Адамдардың өз шегі бар.
Dialogue: 0,0:19:39.51,0:19:40.63,Default,,0,0,0,,(Ауру дауыс)
Dialogue: 0,0:19:41.22,0:19:42.97,Default,,0,0,0,,Мен қазір сондаймын.
Dialogue: 0,0:19:43.97,0:19:46.47,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:19:47.31,0:19:49.18,Default,,0,0,0,,(дауыс)
Dialogue: 0,0:19:49.27,0:19:52.94,Default,,0,0,0,,Бұл әрі қарай жалғаса берсе, мен сені өкіндіремін.
Dialogue: 0,0:19:53.02,0:19:56.48,Default,,0,0,0,,Күте тұрыңыз! тыныш бол
Dialogue: 0,0:20:04.66,0:20:05.49,Default,,0,0,0,,Келді...
Dialogue: 0,0:20:19.59,0:20:22.01,Default,,0,0,0,,Бұл Голго (Реган) Ах.
Dialogue: 0,0:20:22.09,0:20:24.09,Default,,0,0,0,,Голго? ...Ааа
Dialogue: 0,0:20:24.72,0:20:26.51,Default,,0,0,0,,Голго 13?
Dialogue: 0,0:20:26.60,0:20:30.06,Default,,0,0,0,,(Шыншыл музыка)
Dialogue: 0,0:20:47.45,0:20:48.95,Default,,0,0,0,,(механикалық дыбыс)
Dialogue: 0,0:20:50.37,0:20:51.87,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:21:02.51,0:21:04.51,Default,,0,0,0,,(нақты дыбыс әсері)
Dialogue: 0,0:21:21.53,0:21:22.69,Default,,0,0,0,,Альфадан штабқа дейін
Dialogue: 0,0:21:22.78,0:21:26.07,Default,,0,0,0,,Қылмыскер жаңа ғана атылды.
Dialogue: 0,0:21:26.15,0:21:27.53,Default,,0,0,0,,Қайталау Қылмыскер атылды
Dialogue: 0,0:21:27.53,0:21:29.45,Default,,0,0,0,,Қайталау Қылмыскер атылды.
Dialogue: 0,0:21:27.53,0:21:29.45,Default,,0,0,0,,Мен… біраз ойланып алайын.
Dialogue: 0,0:21:29.53,0:21:31.74,Default,,0,0,0,,1 км қашықтықтағы адам
Dialogue: 0,0:21:31.83,0:21:35.54,Default,,0,0,0,,Сізді бір оқпен өлтіретін мергенді білмеймін дедіңіз.
Dialogue: 0,0:21:36.54,0:21:41.04,Default,,0,0,0,,Әлгі жігіт мұны екі шақырым жерден жасады.
Dialogue: 0,0:21:41.13,0:21:42.96,Default,,0,0,0,,(Шырылдаған дыбыс)
Dialogue: 0,0:21:43.05,0:21:45.09,Default,,0,0,0,,Ол қорқынышты адам.
Dialogue: 0,0:21:45.17,0:21:47.93,Default,,0,0,0,,Мен сені жау еткім келмейді.
Dialogue: 0,0:21:48.01,0:21:52.47,Default,,0,0,0,,(♪Тақырыптық ән)
Dialogue: 0,0:21:58.52,0:22:02.77,Default,,0,0,0,,(сабырлы және көңілді ән)
Dialogue: 0,0:22:11.37,0:22:16.29,Default,,0,0,0,,«Ұрлаушыны SWAT атып өлтірді»
Dialogue: 0,0:22:16.87,0:22:18.92,Default,,0,0,0,,(күледі)
Dialogue: 0,0:22:31.09,0:22:34.51,Default,,0,0,0,,(♪~Соңындағы ән)
Dialogue: 0,0:23:58.31,0:24:00.14,Default,,0,0,0,,(Соңғы ән~♪)
Dialogue: 0,0:24:01.52,0:24:02.89,Default,,0,0,0,,(♪~Тақырыптық ән)
Dialogue: 0,0:24:02.98,0:24:04.73,Default,,0,0,0,,500 метр қашықтықтағы нысана
Dialogue: 0,0:24:05.44,0:24:09.19,Default,,0,0,0,,Қараңғыда жарық түскенде триггер тартылды
Dialogue: 0,0:24:09.28,0:24:11.07,Default,,0,0,0,,Көшеге құлаған снарядтар
Dialogue: 0,0:24:11.15,0:24:14.28,Default,,0,0,0,,Мергенді кім көрді?
Dialogue: 0,0:24:15.20,0:24:17.28,Default,,0,0,0,,Детективтің қыңыр намысшылдығы
Dialogue: 0,0:24:17.37,0:24:19.49,Default,,0,0,0,,Гольгоны қуу
Dialogue: 0,0:24:20.12,0:24:22.04,Default,,0,0,0,,Келесі жолы «Голго 13»
Dialogue: 0,0:24:24.83,0:24:27.88,Default,,0,0,0,,Артында тұрма, өміріңді қатерге тіксең.
Dialogue: 0,0:24:27.96,0:24:30.92,Default,,0,0,0,,(тақырыптық ән~♪)
