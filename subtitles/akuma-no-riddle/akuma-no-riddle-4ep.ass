Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:35.01,0:01:38.28,Default,,0,0,0,,♬～
Dialogue: 0,0:01:38.28,0:01:40.91,Default,,0,0,0,,Уф~ Мен шаршадым~. Бос орындарды толтырыңыз➡
Dialogue: 0,0:01:40.91,0:01:44.31,Default,,0,0,0,,Мен бір қателік жібердім. О, мен де~
Dialogue: 0,0:01:46.17,0:01:49.52,Default,,0,0,0,,Кезекті сынақ 1-ші күн сәтті аяқталды!
Dialogue: 0,0:01:49.52,0:01:53.34,Default,,0,0,0,,Хару ертең де барын салып, 100 ұпайды көздейді!
Dialogue: 0,0:01:53.34,0:02:04.52,Default,,0,0,0,,♬～
Dialogue: 0,0:02:04.52,0:02:07.11,Default,,0,0,0,,Бармын! (Тото Каку) Не болды?
Dialogue: 0,0:02:07.11,0:02:11.61,Default,,0,0,0,,Мен бірден қиын мәселеге тап болдым. Мен түсінемін.
Dialogue: 0,0:02:11.61,0:02:14.01,Default,,0,0,0,,Токаку-сан, сен мұны түсінесің бе?
Dialogue: 0,0:02:16.83,0:02:20.02,Default,,0,0,0,,Бұл есеп осы формуланы пайдаланады...
Dialogue: 0,0:02:20.02,0:02:26.34,Default,,0,0,0,,♬～
Dialogue: 0,0:02:26.34,0:02:30.78,Default,,0,0,0,,А, түсіндім! Рахмет, Каминаға-сан
Dialogue: 0,0:02:30.78,0:02:33.57,Default,,0,0,0,,Бұл рахмет айтуды талап ететін нәрсе емес.
Dialogue: 0,0:02:33.57,0:02:38.77,Default,,0,0,0,,♬～
Dialogue: 0,0:02:38.77,0:02:41.36,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:41.36,0:02:46.00,Default,,0,0,0,,Хару міндетті түрде оқуды бітіргісі келеді, сондықтан мен қызыл баға алмау үшін барымды саламын!
Dialogue: 0,0:02:46.00,0:02:48.00,Default,,0,0,0,,≫Мм!
Dialogue: 0,0:02:50.92,0:02:54.30,Default,,0,0,0,,♬～
Dialogue: 0,0:02:54.30,0:02:56.30,Default,,0,0,0,,≪Мен...≫
Dialogue: 0,0:02:58.91,0:03:02.81,Default,,0,0,0,,<<Мен сәтсіздікке жол бере алмаймын>>
Dialogue: 0,0:03:05.30,0:03:07.52,Default,,0,0,0,,♬ Кері санауға дайынсыз ба
Dialogue: 0,0:03:07.52,0:03:09.74,Default,,0,0,0,,♬ Жүгіруге жол жоқ
Dialogue: 0,0:03:09.74,0:03:19.01,Default,,0,0,0,,♬～
Dialogue: 0,0:03:19.01,0:03:23.60,Default,,0,0,0,,♬ Оңай диапазонға түспеңіз.
Dialogue: 0,0:03:23.60,0:03:28.54,Default,,0,0,0,,♬ Бұл суық соғыс аймағы. Қазіргі жағдай жалықтырады.
Dialogue: 0,0:03:28.54,0:03:33.19,Default,,0,0,0,,♬ Ей, балалар, сондықтан сен ерекше екенсің.
Dialogue: 0,0:03:33.19,0:03:35.26,Default,,0,0,0,,♬ Баяғыда сыйымдылық асып кеткен
Dialogue: 0,0:03:35.26,0:03:37.51,Default,,0,0,0,,♬ Өзін-өзі мазақ ету түбі жоқ сезім
Dialogue: 0,0:03:37.51,0:03:39.53,Default,,0,0,0,,♬ Өте сүйкімді
Dialogue: 0,0:03:39.53,0:03:42.50,Default,,0,0,0,,♬ Мен саған ақымақтығымды көрсете алмаймын.
Dialogue: 0,0:03:42.50,0:03:44.54,Default,,0,0,0,,♬ Бекер толқу
Dialogue: 0,0:03:44.54,0:03:46.54,Default,,0,0,0,,♬ Тек ынталандыру үшін
Dialogue: 0,0:03:47.96,0:03:50.58,Default,,0,0,0,,♬ Қабылдау/бүлік Екі ғана таңдау бар ма?
Dialogue: 0,0:03:50.58,0:03:54.23,Default,,0,0,0,,♬ ah Эстетика «Мен ешкімге тиіспеймін»
Dialogue: 0,0:03:54.23,0:03:56.30,Default,,0,0,0,,♬ Жараның кінәсіздігі
Dialogue: 0,0:03:56.30,0:03:58.93,Default,,0,0,0,,♬ Мен де сол топқа кіремін.
Dialogue: 0,0:03:58.93,0:04:00.97,Default,,0,0,0,,♬ орылатын болады
Dialogue: 0,0:04:00.97,0:04:03.49,Default,,0,0,0,,♬ Ешбір жағдайда әрқашан жалғасуда
Dialogue: 0,0:04:03.49,0:04:07.58,Default,,0,0,0,,♬ Белдемшенің етегі туралы шындық
Dialogue: 0,0:04:07.58,0:04:12.60,Default,,0,0,0,,♬ Тек ақымақ сияқты сеніңіз
Dialogue: 0,0:04:12.60,0:04:16.85,Default,,0,0,0,,♬ Маған қатты әсер етті
Dialogue: 0,0:04:16.85,0:04:23.51,Default,,0,0,0,,♬ Оны твиттер арқылы жіберіңіз.
Dialogue: 0,0:04:23.51,0:04:33.01,Default,,0,0,0,,♬～
Dialogue: 0,0:04:46.06,0:04:56.09,Default,,0,0,0,,♬～
Dialogue: 0,0:04:56.09,0:04:58.93,Default,,0,0,0,,Како-чан, монша ше?
Dialogue: 0,0:04:58.93,0:05:01.48,Default,,0,0,0,,Алдымен барыңыз.
Dialogue: 0,0:05:01.48,0:05:06.64,Default,,0,0,0,,Олай болса солай істейік. Бүгінгі ваннаға арналған тұздар Ноборибецу...➡
Dialogue: 0,0:05:06.64,0:05:09.72,Default,,0,0,0,,Жоқ, Дого Онсенді де лақтырып тастау қиын.
Dialogue: 0,0:05:09.72,0:05:14.32,Default,,0,0,0,,♬～
Dialogue: 0,0:05:15.68,0:05:27.37,Default,,0,0,0,,♬～
Dialogue: 0,0:05:27.37,0:05:30.46,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:05:30.46,0:05:33.46,Default,,0,0,0,,((Рахмет, Ирена-сенпай))
Dialogue: 0,0:05:33.46,0:05:36.15,Default,,0,0,0,,)
Dialogue: 0,0:05:36.15,0:05:38.62,Default,,0,0,0,,)
Dialogue: 0,0:05:38.62,0:05:41.17,Default,,0,0,0,,((Кезінде сіз жалған жарылыс жасадыңыз.➡
Dialogue: 0,0:05:41.17,0:05:43.97,Default,,0,0,0,,≫Бұл қауіпті! )) ((≫!))
Dialogue: 0,0:05:43.97,0:05:46.04,Default,,0,0,0,,Ахахха! ))
Dialogue: 0,0:05:46.04,0:05:50.38,Default,,0,0,0,,((Мен шынымен де өлтіруге жарамсыз болуым керек))
Dialogue: 0,0:05:50.38,0:05:52.40,Default,,0,0,0,,)
Dialogue: 0,0:05:52.40,0:05:57.02,Default,,0,0,0,,♬～
Dialogue: 0,0:05:57.02,0:06:00.54,Default,,0,0,0,,Жарайды. Бұл тамаша.
Dialogue: 0,0:06:00.54,0:06:16.00,Default,,0,0,0,,♬～
Dialogue: 0,0:06:16.00,0:06:18.11,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:18.11,0:06:20.84,Default,,0,0,0,,[Баяндамашы] Кин Хон Хан...(Шима)
Dialogue: 0,0:06:20.84,0:06:26.52,Default,,0,0,0,,Иә, жауап парағын төңкеріп, артыңыздағы адамнан алдыңғы жағына беріңіз.
Dialogue: 0,0:06:26.52,0:06:28.88,Default,,0,0,0,,Тесттер ақымақ
Dialogue: 0,0:06:28.88,0:06:32.34,Default,,0,0,0,,Мен жай ғана шаршадым. Жақында аяқталады деп үміттенемін.
Dialogue: 0,0:06:32.34,0:06:34.71,Default,,0,0,0,,Исуке мырза, сіз барлық уақытта ұйықтадыңыз.
Dialogue: 0,0:06:34.71,0:06:39.18,Default,,0,0,0,,Менің иығым қатып қалды. Менің де көзім шаршады.
Dialogue: 0,0:06:39.18,0:06:42.83,Default,,0,0,0,,Басымды пайдаланғандықтан қарным ашты.
Dialogue: 0,0:06:42.83,0:06:47.69,Default,,0,0,0,,Ал, ертең кезекті сынақтың үшінші және соңғы күні.➡
Dialogue: 0,0:06:47.69,0:06:52.27,Default,,0,0,0,,Барлығыңыз, өкінбеу үшін бүгін кешке бәрін қарап шығыңыз.
Dialogue: 0,0:06:52.27,0:06:54.27,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:59.00,0:07:02.05,Default,,0,0,0,,Токаку-сан, бүгінгі сынақ қалай өтті?
Dialogue: 0,0:07:02.05,0:07:05.80,Default,,0,0,0,,Жақсы болды ма? Жаман болды ма? Мәселе жоқ
Dialogue: 0,0:07:05.80,0:07:08.60,Default,,0,0,0,,Бұл керемет, Токаку-сан. Ах.
Dialogue: 0,0:07:10.24,0:07:14.01,Default,,0,0,0,,Наматаме мырза, Киригая мырза, сынақ қалай өтті?
Dialogue: 0,0:07:14.01,0:07:17.40,Default,,0,0,0,,жеткілікті. Киригая қалай болды?
Dialogue: 0,0:07:17.40,0:07:21.35,Default,,0,0,0,,Мен де. Сонымен... түсінемін.
Dialogue: 0,0:07:21.35,0:07:24.19,Default,,0,0,0,,Мм... (2 адам) Иә?
Dialogue: 0,0:07:24.19,0:07:26.78,Default,,0,0,0,,Неге үнемі қол ұстасып жүрсің?
Dialogue: 0,0:07:26.78,0:07:29.88,Default,,0,0,0,,Доғағұзан! Өйткені сен➡
Dialogue: 0,0:07:29.88,0:07:32.13,Default,,0,0,0,,Сізді уайымдағаны осы емес пе?
Dialogue: 0,0:07:32.13,0:07:34.17,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:07:34.17,0:07:38.10,Default,,0,0,0,,А... міне, Киригая адаспайды.
Dialogue: 0,0:07:38.10,0:07:42.24,Default,,0,0,0,,Сенсоку-сан, әдеттегідей рахмет.
Dialogue: 0,0:07:42.24,0:07:44.38,Default,,0,0,0,,Мен осындай жердемін➡
Dialogue: 0,0:07:44.38,0:07:48.41,Default,,0,0,0,,Мен Киригая мен Ичиноза сияқты балалар үшін алаңдаймын.
Dialogue: 0,0:07:48.41,0:07:50.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:50.47,0:07:53.05,Default,,0,0,0,,Менің мақсатым Ичиноза емес.➡
Dialogue: 0,0:07:53.05,0:07:56.51,Default,,0,0,0,,Қара топқа басқа себеппен ауыстым.
Dialogue: 0,0:07:56.51,0:07:59.86,Default,,0,0,0,,Сенесіз бе...?
Dialogue: 0,0:07:59.86,0:08:03.45,Default,,0,0,0,,Сенсеңіз де, сенбесеңіз де, өз еркіңізде.
Dialogue: 0,0:08:03.45,0:08:06.18,Default,,0,0,0,,Кеттік, Киригая. (Табыт)... Иә.
Dialogue: 0,0:08:06.18,0:08:13.76,Default,,0,0,0,,♬～
Dialogue: 0,0:08:13.76,0:08:18.21,Default,,0,0,0,,Наматаме мырзаның маған айту үшін барын салған мейірімді адамы.
Dialogue: 0,0:08:18.21,0:08:21.65,Default,,0,0,0,,Ихиноза, аздап үйрен.
Dialogue: 0,0:08:21.65,0:08:31.41,Default,,0,0,0,,♬～
Dialogue: 0,0:08:31.41,0:08:33.91,Default,,0,0,0,,Ойланып қарашы, білесің бе?
Dialogue: 0,0:08:33.91,0:08:37.21,Default,,0,0,0,,Не? сен неге мұндасың
Dialogue: 0,0:08:37.21,0:08:39.25,Default,,0,0,0,,Осы Миоджо академиясында➡
Dialogue: 0,0:08:39.25,0:08:41.93,Default,,0,0,0,,Мектептің жеті кереметі деп аталатындар бар.
Dialogue: 0,0:08:41.93,0:08:45.94,Default,,0,0,0,,Жеті керемет? адамдарды тыңда
Dialogue: 0,0:08:45.94,0:08:48.51,Default,,0,0,0,,Бетховен музыка бөлмесінде➡
Dialogue: 0,0:08:48.51,0:08:50.61,Default,,0,0,0,,Түн ортасында кенет шашыңды сілкіп жібересің➡
Dialogue: 0,0:08:50.61,0:08:52.84,Default,,0,0,0,,Жүргізуді бастау
Dialogue: 0,0:08:52.84,0:08:55.43,Default,,0,0,0,,Сәлем! Бұл қалыпты жағдай➡
Dialogue: 0,0:08:55.43,0:08:58.60,Default,,0,0,0,,Көздерің жарқырап тұрған жоқ па?
Dialogue: 0,0:08:58.60,0:09:01.39,Default,,0,0,0,,Ғылым кабинетіндегі адам денесінің моделі➡
Dialogue: 0,0:09:01.39,0:09:04.24,Default,,0,0,0,,Күлгенімнен құлап қалдым, жүрегім мен өкпем шығып кетті➡
Dialogue: 0,0:09:04.24,0:09:06.59,Default,,0,0,0,,Заттарды асығыс жинау
Dialogue: 0,0:09:06.59,0:09:10.20,Default,,0,0,0,,Адамдардың кенеттен жүгіре бастауы қалыпты жағдай емес пе?
Dialogue: 0,0:09:10.20,0:09:13.88,Default,,0,0,0,,Енді, Токаку-сан, үндемеші.➡
Dialogue: 0,0:09:13.88,0:09:15.90,Default,,0,0,0,,Ах, онда➡
Dialogue: 0,0:09:15.90,0:09:19.04,Default,,0,0,0,,Кітапханада тыйым салынған кітап деген нәрсе бар.
Dialogue: 0,0:09:19.04,0:09:21.04,Default,,0,0,0,,Уау, мен оны естігім келеді! Мен оны естігім келеді!
Dialogue: 0,0:09:23.23,0:09:26.31,Default,,0,0,0,,Осы кітапханадағы кітап сөресінің артында бір жерде➡
Dialogue: 0,0:09:26.31,0:09:28.66,Default,,0,0,0,,Мұнда жасырын бөлме бар.➡
Dialogue: 0,0:09:28.66,0:09:32.55,Default,,0,0,0,,Тыйым салынған кітап бар, оны ашуға болмайды...
Dialogue: 0,0:09:32.55,0:09:34.69,Default,,0,0,0,,Иә, иә! (Тай) Бірақ➡
Dialogue: 0,0:09:34.69,0:09:37.67,Default,,0,0,0,,Кітаптың несие картасына өз атыңызды жазыңыз➡
Dialogue: 0,0:09:37.67,0:09:40.79,Default,,0,0,0,,Бұл сізді бақытты ету үшін айтылады.
Dialogue: 0,0:09:40.79,0:09:44.75,Default,,0,0,0,,Сіз бақытты бола аласыз ба? Шамасы
Dialogue: 0,0:09:44.75,0:09:47.37,Default,,0,0,0,,Бұл бос сөз. Мен оны ашпауым керек еді➡
Dialogue: 0,0:09:47.37,0:09:50.95,Default,,0,0,0,,Оны ашу керек деген қайшылық.
Dialogue: 0,0:09:50.95,0:09:55.34,Default,,0,0,0,,Сондықтан қорықпай есігін ашқан адамдар бақытты болады деп ойлаймын.
Dialogue: 0,0:09:55.34,0:09:57.38,Default,,0,0,0,,Мен сенімдімін
Dialogue: 0,0:09:57.38,0:10:02.33,Default,,0,0,0,,Бірақ кітапты іздемес бұрын, алдымен жасырын бөлмені табу керек.
Dialogue: 0,0:10:02.33,0:10:04.93,Default,,0,0,0,,Сіздің оқуыңыз не болды? Ах...
Dialogue: 0,0:10:08.00,0:10:10.00,Default,,0,0,0,,Иә
Dialogue: 0,0:10:12.06,0:10:15.14,Default,,0,0,0,,Фу~ Менің ішім тоқ~
Dialogue: 0,0:10:15.14,0:10:17.60,Default,,0,0,0,,Кешкі ас Мен аздап көп жедім.
Dialogue: 0,0:10:17.60,0:10:20.65,Default,,0,0,0,,Сондықтан мен саған десертті өткізіп жібер дедім.
Dialogue: 0,0:10:20.65,0:10:23.75,Default,,0,0,0,,Өйткені құлпынай дәмді көрінді.
Dialogue: 0,0:10:27.17,0:10:29.91,Default,,0,0,0,,Егер мен мұнда үлкен мәселе етіп көтермесем, қашан көтеремін?
Dialogue: 0,0:10:29.91,0:10:40.42,Default,,0,0,0,,♬～
Dialogue: 0,0:10:40.42,0:10:45.06,Default,,0,0,0,,Лютердің айтқаны? Ол нені білдіреді?
Dialogue: 0,0:10:45.06,0:10:47.94,Default,,0,0,0,,Уақыт шегі - 48 сағат
Dialogue: 0,0:10:47.94,0:10:50.71,Default,,0,0,0,,Ертең осы уақытқа дейін➡
Dialogue: 0,0:10:50.71,0:10:52.73,Default,,0,0,0,,Бұл оның бірдеңе орнататынын білдіре ме?
Dialogue: 0,0:10:52.73,0:10:55.08,Default,,0,0,0,,Кача (тоңазытқыштың ашылған дыбысы) Токаку-сан
Dialogue: 0,0:10:55.08,0:11:00.24,Default,,0,0,0,,♬～
Dialogue: 0,0:11:00.24,0:11:02.31,Default,,0,0,0,,Бомба?
Dialogue: 0,0:11:02.31,0:11:15.34,Default,,0,0,0,,♬～
Dialogue: 0,0:11:15.34,0:11:18.79,Default,,0,0,0,,Аа...｡ Рахмет, Токаку-сан.
Dialogue: 0,0:11:18.79,0:11:20.84,Default,,0,0,0,,Қ-Қандай?
Dialogue: 0,0:11:20.84,0:11:29.10,Default,,0,0,0,,♬～
Dialogue: 0,0:11:29.10,0:11:32.07,Default,,0,0,0,,Бұл сүйікті ме?
Dialogue: 0,0:11:32.07,0:11:34.11,Default,,0,0,0,,≪Нақты кім? ≫
Dialogue: 0,0:11:34.11,0:11:43.11,Default,,0,0,0,,♬～
Dialogue: 0,0:11:46.62,0:11:48.75,Default,,0,0,0,,≪Гача (есік дыбысы)
Dialogue: 0,0:11:48.75,0:11:51.81,Default,,0,0,0,,Ванна Бірінші оны пайдалануға рұқсат етілді.
Dialogue: 0,0:11:51.81,0:11:54.68,Default,,0,0,0,,Ыстық су жақсы болды.
Dialogue: 0,0:11:54.68,0:11:58.93,Default,,0,0,0,,Ыстық суды үнемдеу керек пе? Мен сізге ваннаға арналған тұздарды да беремін.
Dialogue: 0,0:11:58.93,0:12:01.37,Default,,0,0,0,,Киносаки немесе Беппу ше?
Dialogue: 0,0:12:01.37,0:12:03.70,Default,,0,0,0,,Жоқ, душ қабылдауға болады.
Dialogue: 0,0:12:03.70,0:12:13.90,Default,,0,0,0,,♬～
Dialogue: 0,0:12:15.31,0:12:25.46,Default,,0,0,0,,♬～
Dialogue: 0,0:12:25.46,0:12:29.43,Default,,0,0,0,,) (Коко)((Не?))
Dialogue: 0,0:12:29.43,0:12:34.53,Default,,0,0,0,,)
Dialogue: 0,0:12:36.32,0:12:38.77,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:12:38.77,0:12:41.29,Default,,0,0,0,,() (Ирена)((мен түсінемін.➡
Dialogue: 0,0:12:41.29,0:12:45.53,Default,,0,0,0,,Жоқ, әйтеуір ойымда қалып қойды))
Dialogue: 0,0:12:45.53,0:12:48.71,Default,,0,0,0,,((Сен өлгенде, бұл аяқталу немесе аяқталу.➡
Dialogue: 0,0:12:48.71,0:12:51.32,Default,,0,0,0,,Ойланатын уақытым бар ма екен))
Dialogue: 0,0:12:51.32,0:12:56.34,Default,,0,0,0,,♬～
Dialogue: 0,0:12:56.34,0:12:58.34,Default,,0,0,0,,)
Dialogue: 0,0:13:00.01,0:13:02.11,Default,,0,0,0,,((Нысанаға жақындау 5 минут бұрын.➡
Dialogue: 0,0:13:02.11,0:13:05.15,Default,,0,0,0,,Мен оны қадағалаймын, сондықтан сіз бірінші оралыңыз))
Dialogue: 0,0:13:05.15,0:13:07.18,Default,,0,0,0,,()
Dialogue: 0,0:13:07.18,0:13:11.00,Default,,0,0,0,,♬～
Dialogue: 0,0:13:11.00,0:13:13.00,Default,,0,0,0,,)
Dialogue: 0,0:13:18.24,0:13:23.70,Default,,0,0,0,,♬～
Dialogue: 0,0:13:23.70,0:13:25.75,Default,,0,0,0,,)
Dialogue: 0,0:13:25.75,0:13:29.67,Default,,0,0,0,,♬～
Dialogue: 0,0:13:29.67,0:13:31.72,Default,,0,0,0,,)
Dialogue: 0,0:13:31.72,0:13:43.15,Default,,0,0,0,,♬～
Dialogue: 0,0:13:43.15,0:13:48.11,Default,,0,0,0,,((Біздің тіршілігіміз жарыққа шыға жаздады.➡
Dialogue: 0,0:13:48.11,0:13:50.64,Default,,0,0,0,,Егер сәтсіздікке ұшырамасаңыз...))
Dialogue: 0,0:13:50.64,0:13:53.91,Default,,0,0,0,,)
Dialogue: 0,0:13:53.91,0:13:57.08,Default,,0,0,0,,)
Dialogue: 0,0:13:57.08,0:14:00.59,Default,,0,0,0,,((Сіз сияқты мен өте қабілетті бала едім➡
Dialogue: 0,0:14:00.59,0:14:02.60,Default,,0,0,0,,Өте жаман))
Dialogue: 0,0:14:02.60,0:14:06.34,Default,,0,0,0,,♬～
Dialogue: 0,0:14:06.34,0:14:10.78,Default,,0,0,0,,((Егер сіз шынымен өлтіруге жарамсыз болсаңыз жақсы.➡
Dialogue: 0,0:14:10.78,0:14:14.17,Default,,0,0,0,,Сен өлгенде, бұл ақырғы немесе аяқталу➡
Dialogue: 0,0:14:14.17,0:14:16.67,Default,,0,0,0,,Ойланатын уақытым бар ма екен))
Dialogue: 0,0:14:16.67,0:14:19.90,Default,,0,0,0,,♬～
Dialogue: 0,0:14:19.90,0:14:22.20,Default,,0,0,0,,)
Dialogue: 0,0:14:23.61,0:14:25.63,Default,,0,0,0,,)
Dialogue: 0,0:14:25.63,0:14:29.53,Default,,0,0,0,,♬～
Dialogue: 0,0:14:30.95,0:14:35.07,Default,,0,0,0,,Мен сәтсіздікке жол бере алмаймын.
Dialogue: 0,0:14:35.07,0:14:43.18,Default,,0,0,0,,♬～
Dialogue: 0,0:14:43.18,0:14:45.96,Default,,0,0,0,,Хехехе. Каминаға мырза➡
Dialogue: 0,0:14:45.96,0:14:47.96,Default,,0,0,0,,Сен қатты толқыдың.
Dialogue: 0,0:16:54.24,0:16:57.25,Default,,0,0,0,,Иә, жауап парағын жинаймын.
Dialogue: 0,0:16:57.25,0:16:59.65,Default,,0,0,0,,Күрсіну~ Ақыры бітті~
Dialogue: 0,0:16:59.65,0:17:02.50,Default,,0,0,0,,Исуке мырза енді ғана ұйықтап жатыр еді.
Dialogue: 0,0:17:02.50,0:17:05.94,Default,,0,0,0,,Қалай болды? (Хицуги) Мен өте сенімді емеспін.
Dialogue: 0,0:17:05.94,0:17:09.52,Default,,0,0,0,,Негізі, Хару да... Тағы кездескенше!
Dialogue: 0,0:17:09.52,0:17:12.24,Default,,0,0,0,,Қатты иықтар
Dialogue: 0,0:17:12.24,0:17:15.16,Default,,0,0,0,,Ақырында... бітті...
Dialogue: 0,0:17:15.16,0:17:20.36,Default,,0,0,0,,♬～
Dialogue: 0,0:17:22.65,0:17:25.45,Default,,0,0,0,,Тест нәтижелері қызықты.
Dialogue: 0,0:17:27.08,0:17:31.81,Default,,0,0,0,,Токаку-сан, бүгін кешке жоспарың бар ма? Атап айтқанда, ештеңе
Dialogue: 0,0:17:31.81,0:17:35.77,Default,,0,0,0,,Умм, кітапханада...
Dialogue: 0,0:17:35.77,0:17:39.50,Default,,0,0,0,,Не? Айтар сөзіңіз болса, анық айтыңыз
Dialogue: 0,0:17:39.50,0:17:43.70,Default,,0,0,0,,Мен кітапханаға жасырын кіргім келеді.
Dialogue: 0,0:17:45.08,0:17:48.68,Default,,0,0,0,,Тыйым салынған кітап? Мен оны іздегім келеді
Dialogue: 0,0:17:48.68,0:17:52.33,Default,,0,0,0,,Бірақ бұлай айтатын уақыт емес.
Dialogue: 0,0:17:52.33,0:17:55.02,Default,,0,0,0,,Әрине. Уақыт шегіне дейін➡
Dialogue: 0,0:17:55.02,0:17:57.72,Default,,0,0,0,,24 сағаттан астам уақыт қалды.
Dialogue: 0,0:17:57.72,0:18:01.74,Default,,0,0,0,,♬～
Dialogue: 0,0:18:01.74,0:18:04.71,Default,,0,0,0,,Иә? Токаку-сан?
Dialogue: 0,0:18:04.71,0:18:08.08,Default,,0,0,0,,Барған соң өзіңізді жақсы сезінесіз, солай ма?
Dialogue: 0,0:18:08.08,0:18:11.10,Default,,0,0,0,,Иә! Олай болса, түн ортасында барайық➡
Dialogue: 0,0:18:11.10,0:18:14.24,Default,,0,0,0,,Жасырын барайық! Мен түсінемін, сондықтан маған жабыспа
Dialogue: 0,0:18:14.24,0:18:27.25,Default,,0,0,0,,♬～
Dialogue: 0,0:18:27.25,0:18:29.85,Default,,0,0,0,,Хехе. иә?
Dialogue: 0,0:18:32.44,0:18:35.04,Default,,0,0,0,,А, артқа тұрыңыз.
Dialogue: 0,0:18:37.08,0:18:41.98,Default,,0,0,0,,Басу... (таңдау дыбысы)
Dialogue: 0,0:18:43.74,0:18:46.10,Default,,0,0,0,,Токаку мырза керемет!
Dialogue: 0,0:18:46.10,0:18:49.81,Default,,0,0,0,,Сіз не істеуді жоспарладыңыз? Эхехе
Dialogue: 0,0:18:49.81,0:18:52.73,Default,,0,0,0,,Хэхехе. Мен оны тез бітіремін.
Dialogue: 0,0:18:52.73,0:18:54.76,Default,,0,0,0,,≪Сырылдау...(есік дыбысы)
Dialogue: 0,0:18:54.76,0:18:58.33,Default,,0,0,0,,♬～
Dialogue: 0,0:18:58.33,0:19:01.20,Default,,0,0,0,,Сонда ол қайда? Жасырын бөлме
Dialogue: 0,0:19:01.20,0:19:04.74,Default,,0,0,0,,Жарайды, мен оны қазір іздеймін.
Dialogue: 0,0:19:04.74,0:19:06.76,Default,,0,0,0,,Тым кездейсоқ...
Dialogue: 0,0:19:06.76,0:19:09.84,Default,,0,0,0,,Иә~. Бірақ, «Жасырын бөлме қайда?» ➡
Dialogue: 0,0:19:09.84,0:19:13.06,Default,,0,0,0,,Толқумен іздену қызық емес пе?
Dialogue: 0,0:19:13.06,0:19:15.06,Default,,0,0,0,,Бөлек
Dialogue: 0,0:19:16.48,0:19:18.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:18.52,0:19:22.14,Default,,0,0,0,,♬～
Dialogue: 0,0:19:22.14,0:19:25.78,Default,,0,0,0,,Сол жерде. иә? Иә, Токаку мырза?
Dialogue: 0,0:19:25.78,0:19:37.57,Default,,0,0,0,,♬～
Dialogue: 0,0:19:37.57,0:19:39.51,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:19:39.51,0:19:46.55,Default,,0,0,0,,♬～
Dialogue: 0,0:19:46.55,0:19:48.58,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:48.58,0:19:52.24,Default,,0,0,0,,Шынында да тыйым салынған есік болды!
Dialogue: 0,0:19:52.24,0:19:54.91,Default,,0,0,0,,...
Dialogue: 0,0:19:54.91,0:19:57.08,Default,,0,0,0,,Бұл иіс. Иіс?
Dialogue: 0,0:19:57.08,0:20:08.18,Default,,0,0,0,,♬～
Dialogue: 0,0:20:09.75,0:20:12.87,Default,,0,0,0,,Кехо Кехо... Оның иісі көгерген сияқты.
Dialogue: 0,0:20:12.87,0:20:16.04,Default,,0,0,0,,Бұл жабық сөредегі кітаптарға арналған кітапхана болса керек.
Dialogue: 0,0:20:16.04,0:20:20.08,Default,,0,0,0,,Мен бұл бөлменің бір жерінде ме деп ойлаймын. Хехе
Dialogue: 0,0:20:20.08,0:20:24.40,Default,,0,0,0,,Тыйым салынған кітап Тыйым салынған кітап... Қайсысы?
Dialogue: 0,0:20:24.40,0:20:36.68,Default,,0,0,0,,♬～
Dialogue: 0,0:20:36.68,0:20:38.70,Default,,0,0,0,,Ах
Dialogue: 0,0:20:38.70,0:20:44.07,Default,,0,0,0,,♬～
Dialogue: 0,0:20:44.07,0:20:47.27,Default,,0,0,0,,Иә? Неге мұндасың?
Dialogue: 0,0:20:50.01,0:20:52.05,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:20:52.05,0:20:55.65,Default,,0,0,0,,Дыбыстық сигнал!!
Dialogue: 0,0:21:05.18,0:21:08.28,Default,,0,0,0,,Уф… Ууу…
Dialogue: 0,0:21:08.28,0:21:12.15,Default,,0,0,0,,Ах! Токаку-сан! Токаку-сан!
Dialogue: 0,0:21:12.15,0:21:14.72,Default,,0,0,0,,Токаку-сан! Уф...
Dialogue: 0,0:21:14.72,0:21:17.72,Default,,0,0,0,,Кеен... (құлақ сыңғыр)
Dialogue: 0,0:21:20.07,0:21:25.67,Default,,0,0,0,,Киин...
Dialogue: 0,0:21:27.33,0:21:30.18,Default,,0,0,0,,Банг! Жарылыс! Жарылыс! Жарылыс!
Dialogue: 0,0:21:30.18,0:21:32.18,Default,,0,0,0,,Басу түймесін басыңыз
Dialogue: 0,0:21:33.89,0:21:35.91,Default,,0,0,0,,Жасыру керек.
Dialogue: 0,0:21:35.91,0:21:45.13,Default,,0,0,0,,♬～
Dialogue: 0,0:21:45.13,0:21:47.19,Default,,0,0,0,,Қайырлы күн!
Dialogue: 0,0:21:47.19,0:21:56.83,Default,,0,0,0,,♬～
Dialogue: 0,0:21:56.83,0:21:59.75,Default,,0,0,0,,Бұл сіз болдыңыз ба, бастық?
Dialogue: 0,0:21:59.75,0:22:03.08,Default,,0,0,0,,Жеті керемет туралы естідің.
Dialogue: 0,0:22:03.08,0:22:05.98,Default,,0,0,0,,Мен сонда болдым.
Dialogue: 0,0:22:08.04,0:22:11.51,Default,,0,0,0,,Мен бұл жерде тоқтай алмаймын!
Dialogue: 0,0:22:11.51,0:22:15.95,Default,,0,0,0,,♬～
Dialogue: 0,0:22:15.95,0:22:17.98,Default,,0,0,0,,Әлі уақыт бар!
Dialogue: 0,0:22:17.98,0:22:24.91,Default,,0,0,0,,♬～
Dialogue: 0,0:22:24.91,0:22:29.01,Default,,0,0,0,,Шығыс қаны бар сен менің сезімімді түсінбейсің!
Dialogue: 0,0:22:31.90,0:22:34.00,Default,,0,0,0,,Он көлеңке техникасы
Dialogue: 0,0:22:35.58,0:22:38.68,Default,,0,0,0,,Мен енді сені өлтіргім келмейді!
Dialogue: 0,0:22:40.84,0:22:42.92,Default,,0,0,0,,Қастандықты тоқтатыңыз...➡
Dialogue: 0,0:22:42.92,0:22:47.45,Default,,0,0,0,,Бұл сіз қалайтын сыйлық па? (Коко) О, дұрыс.
Dialogue: 0,0:22:47.45,0:22:51.55,Default,,0,0,0,,Біреуді өлтіріп, аяғын жуу қайшылық емес пе?
Dialogue: 0,0:22:51.55,0:22:53.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:53.58,0:23:03.38,Default,,0,0,0,,♬～
Dialogue: 0,0:23:05.01,0:23:08.08,Default,,0,0,0,,Соңында, мен…➡
Dialogue: 0,0:23:08.08,0:23:11.59,Default,,0,0,0,,Ол сәтсіз өлтіруші болып қала береді...
Dialogue: 0,0:23:11.59,0:23:15.64,Default,,0,0,0,,♬～
Dialogue: 0,0:23:15.64,0:23:17.71,Default,,0,0,0,,Шинчо мырза...
Dialogue: 0,0:23:17.71,0:23:25.11,Default,,0,0,0,,♬～
Dialogue: 0,0:23:28.24,0:23:32.66,Default,,0,0,0,,Исуке Инукай. Хаширино. Харуки Сагае
Dialogue: 0,0:23:32.66,0:23:35.74,Default,,0,0,0,,Ең нашар! Әдетте оны төменнен қайтару керек пе?
Dialogue: 0,0:23:35.74,0:23:39.71,Default,,0,0,0,,Хаха. Исуке мырза, сіз тек атыңызды жаздыңыз.
Dialogue: 0,0:23:39.71,0:23:42.85,Default,,0,0,0,,Нәтижелерді көргім келмейді.
Dialogue: 0,0:23:42.85,0:23:46.79,Default,,0,0,0,,Рио Шуто. Эна Кенмочи
Dialogue: 0,0:23:46.79,0:23:49.16,Default,,0,0,0,,Көрінгендей, осы аптада да Качан мен басқалардың уақытша лицензиясына қосымша сабақтар болмайды.
Dialogue: 0,0:23:49.16,0:23:53.24,Default,,0,0,0,,Биологиялық сынақтар өте терең болды.
Dialogue: 0,0:23:53.24,0:23:56.23,Default,,0,0,0,,Тотокаку. Махиру Бамба
Dialogue: 0,0:23:56.23,0:24:00.23,Default,,0,0,0,,♬～
Dialogue: 0,0:24:00.23,0:24:03.47,Default,,0,0,0,,Қайтармасам жақсы...
Dialogue: 0,0:24:03.47,0:24:06.37,Default,,0,0,0,,Әркім, өлетін кез жаман.
Dialogue: 0,0:24:06.37,0:24:09.46,Default,,0,0,0,,Эйзуми Койко. О!
Dialogue: 0,0:24:09.46,0:24:12.56,Default,,0,0,0,,Сенсоку Наматаме. Киригая табыт.➡
Dialogue: 0,0:24:12.56,0:24:14.73,Default,,0,0,0,,Ей, сен қолыңнан келгеннің бәрін жасадың.
Dialogue: 0,0:24:14.73,0:24:18.47,Default,,0,0,0,,91 ұпай. Сізге жақсы, Киригая.
Dialogue: 0,0:24:18.47,0:24:21.44,Default,,0,0,0,,Иә. Рахмет, Сенсоку-сан.
Dialogue: 0,0:24:21.44,0:24:24.08,Default,,0,0,0,,Сенімсізмін дейтіндер ғана➡
Dialogue: 0,0:24:24.08,0:24:27.04,Default,,0,0,0,,Көбінесе жақсы баға аласың, солай ма?
Dialogue: 0,0:24:27.04,0:24:29.53,Default,,0,0,0,,Өзін нашар сезінеді
Dialogue: 0,0:24:29.53,0:24:33.15,Default,,0,0,0,,Ал даңқты қара топтың төбесі ➡
Dialogue: 0,0:24:33.15,0:24:37.00,Default,,0,0,0,,Хару Ичиноза! жоғарғы
Dialogue: 0,0:24:37.00,0:24:40.89,Default,,0,0,0,,Сонымен... сіз өз сыныбыңызда бірінші орындасыз!?
Dialogue: 0,0:24:40.89,0:24:44.68,Default,,0,0,0,,Эй, мен мұны істеймін. (Түс) Бұл керемет...
Dialogue: 0,0:24:44.68,0:24:47.13,Default,,0,0,0,,Хару-чан, сен қолыңнан келгеннің бәрін істедің.
Dialogue: 0,0:24:47.13,0:24:50.23,Default,,0,0,0,,Ах~ Барлығы тыныш болыңдар. Сабақты бастайық~
Dialogue: 0,0:24:52.75,0:24:55.66,Default,,0,0,0,,Сізге келесі мектебіңізге сәттілік тілеймін.
Dialogue: 0,0:24:55.66,0:25:02.91,Default,,0,0,0,,♬～
Dialogue: 0,0:25:02.91,0:25:05.05,Default,,0,0,0,,Како-чан➡
Dialogue: 0,0:25:05.05,0:25:08.34,Default,,0,0,0,,Менің ойымша, ол бірінші кезекте қара топқа сәйкес келмеді.
Dialogue: 0,0:25:08.34,0:25:12.84,Default,,0,0,0,,♬～
Dialogue: 0,0:25:14.63,0:25:17.46,Default,,0,0,0,,Бұл... мырза. Қаминаға➡
Dialogue: 0,0:25:17.46,0:25:20.08,Default,,0,0,0,,Бақытты болады деп үміттенемін
Dialogue: 0,0:25:20.08,0:25:23.58,Default,,0,0,0,,Адам өзі жазбаса, мағынасы жоқ емес пе?
Dialogue: 0,0:25:23.58,0:25:26.55,Default,,0,0,0,,Жарайды. Заклинание➡
Dialogue: 0,0:25:26.55,0:25:28.94,Default,,0,0,0,,Орындау маңызды.
Dialogue: 0,0:25:28.94,0:25:31.34,Default,,0,0,0,,Солай ма? иә!
Dialogue: 0,0:25:33.29,0:25:35.23,Default,,0,0,0,,Ах… «C» рейтингі
Dialogue: 0,0:25:35.23,0:25:39.03,Default,,0,0,0,,♬～
Dialogue: 0,0:25:40.47,0:25:50.53,Default,,0,0,0,,♬～
Dialogue: 0,0:25:50.53,0:25:54.75,Default,,0,0,0,,♬～
Dialogue: 0,0:25:54.75,0:25:58.20,Default,,0,0,0,,♬ Тыныш су беті
Dialogue: 0,0:25:58.20,0:26:00.81,Default,,0,0,0,,♬ Айдың үстіне қойылған
Dialogue: 0,0:26:00.81,0:26:07.91,Default,,0,0,0,,♬ Оның профилі
Dialogue: 0,0:26:09.28,0:26:12.37,Default,,0,0,0,,♬ Жүрегімнің тереңінде
Dialogue: 0,0:26:12.37,0:26:15.80,Default,,0,0,0,,♬ Басылған құмарлықтың ішінде
Dialogue: 0,0:26:15.80,0:26:23.11,Default,,0,0,0,,♬ Жүріңіз, жаныңыз.
Dialogue: 0,0:26:23.11,0:26:26.38,Default,,0,0,0,,♬ Сол көздер
Dialogue: 0,0:26:26.38,0:26:30.07,Default,,0,0,0,,♬ Мен шағылысамын
Dialogue: 0,0:26:30.07,0:26:33.07,Default,,0,0,0,,♬ Қазір қалайсың?
Dialogue: 0,0:26:33.07,0:26:37.26,Default,,0,0,0,,♬ Сіз мақтанасыз ба?
Dialogue: 0,0:26:37.26,0:26:40.58,Default,,0,0,0,,♬ Құдай бұл дүниеде болса
Dialogue: 0,0:26:40.58,0:26:44.40,Default,,0,0,0,,♬ Егер ол шынымен бар болса
Dialogue: 0,0:26:44.40,0:26:47.90,Default,,0,0,0,,♬ Мәңгілік мұң
Dialogue: 0,0:26:47.90,0:26:51.59,Default,,0,0,0,,♬ Аяқтаңыз.
Dialogue: 0,0:26:51.59,0:26:55.06,Default,,0,0,0,,♬ айқышты алып жүрді
Dialogue: 0,0:26:55.06,0:26:58.56,Default,,0,0,0,,♬ Мен күнәһармын
Dialogue: 0,0:26:58.56,0:27:05.20,Default,,0,0,0,,♬ Бағалаңыз
Dialogue: 0,0:27:05.20,0:27:09.10,Default,,0,0,0,,♬～
Dialogue: 0,0:28:41.08,0:28:44.64,Default,,0,0,0,,Бала қызғылт, сүтті қызғылт, түтін қызғылт, ашық қызғылт.➡
Dialogue: 0,0:28:44.64,0:28:48.42,Default,,0,0,0,,Олардың бәрі бірдей қызғылт емес пе? Әйелдер қиын.➡
Dialogue: 0,0:28:48.42,0:28:50.57,Default,,0,0,0,,Кім екенін айтпаймын, бірақ орамалымды ұмытып кетіппін➡
Dialogue: 0,0:28:50.57,0:28:53.37,Default,,0,0,0,,Қолыңды етегіңе сүртіп тұрғандай көрінсең жақсы емес.
Dialogue: 0,0:28:55.56,0:28:58.17,Default,,0,0,0,,«Куругуми үй бөлмесі»! Токаку-сан!
Dialogue: 0,0:28:58.17,0:29:00.28,Default,,0,0,0,,Не? Бүгін бізде арнайы хабарландыру бар➡
Dialogue: 0,0:29:00.28,0:29:02.90,Default,,0,0,0,,Иә. Blu-ray және DVD шығару туралы айтып отырсыз ба?
Dialogue: 0,0:29:02.90,0:29:06.54,Default,,0,0,0,,Ах! Мен Хару осылай айтады деп ойладым. Алғашқы бонус ретінде➡
Dialogue: 0,0:29:06.54,0:29:09.08,Default,,0,0,0,,Джун Минаката ➡ салған аяқталу картасы
Dialogue: 0,0:29:09.08,0:29:12.46,Default,,0,0,0,,Арнайы кітапшамен бірге келеді Бейне бонусы Аудио бонус ➡
Dialogue: 0,0:29:12.46,0:29:14.83,Default,,0,0,0,,Бұл мол және сәнді, солай емес пе? Ах~!
Dialogue: 0,0:29:14.83,0:29:17.75,Default,,0,0,0,,Токаку-сан, бұл әдейі, солай ма? сізді нысанаға алып жатырсыз
Dialogue: 0,0:29:17.75,0:29:20.37,Default,,0,0,0,,Мұны жасамаңыз. Бөлмеңе қайт.
Dialogue: 0,0:29:20.37,0:29:22.81,Default,,0,0,0,,Соңында бір нәрсені айта кетейін.
Dialogue: 0,0:29:22.81,0:29:25.74,Default,,0,0,0,,1-том 18 маусымда шығады!
Dialogue: 0,0:29:25.74,0:29:28.60,Default,,0,0,0,,Күлсін, мен сергіп қалдым. Енді, Токаку-сан, бөлмеңе қайт.
Dialogue: 0,0:29:28.60,0:29:30.60,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:29:32.10,0:29:38.10,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory