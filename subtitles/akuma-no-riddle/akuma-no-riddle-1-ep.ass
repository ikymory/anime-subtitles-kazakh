Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:35.17,0:01:48.98,Default,,0,0,0,,♬～
Dialogue: 0,0:01:48.98,0:01:51.17,Default,,0,0,0,,Уф... Уф! Қарғыс атсын!
Dialogue: 0,0:01:51.17,0:01:56.67,Default,,0,0,0,,♬～
Dialogue: 0,0:01:56.67,0:02:00.13,Default,,0,0,0,,Тамырыңды осылай өсірсең, үйге тірі орала алмайсың! ➡
Dialogue: 0,0:02:00.13,0:02:02.16,Default,,0,0,0,,Өлтіру ниетімен кел! ➡
Dialogue: 0,0:02:02.16,0:02:05.83,Default,,0,0,0,,Үнсіз өлтірілетін нысана жоқ! ➡
Dialogue: 0,0:02:05.83,0:02:09.00,Default,,0,0,0,,Олар аман қалуға тырысып, соңына дейін қарсы тұрады! ➡
Dialogue: 0,0:02:09.00,0:02:12.81,Default,,0,0,0,,Ол пломбаланып, толығымен тоқтағанша➡
Dialogue: 0,0:02:12.81,0:02:14.82,Default,,0,0,0,,Бұл сіздің жұмысыңыз.
Dialogue: 0,0:02:14.82,0:02:24.17,Default,,0,0,0,,♬～
Dialogue: 0,0:02:24.17,0:02:36.05,Default,,0,0,0,,♬～
Dialogue: 0,0:02:36.05,0:02:38.06,Default,,0,0,0,,Уф!
Dialogue: 0,0:02:38.06,0:02:48.54,Default,,0,0,0,,♬～
Dialogue: 0,0:02:48.54,0:02:50.58,Default,,0,0,0,,Қараңдар! (ысқырық)
Dialogue: 0,0:02:50.58,0:02:53.40,Default,,0,0,0,,Жаттығу аяқталды! 1 сәтті үміткер➡
Dialogue: 0,0:02:53.40,0:02:55.43,Default,,0,0,0,,Шығыс Токаку!
Dialogue: 0,0:02:55.43,0:02:59.93,Default,,0,0,0,,♬～
Dialogue: 0,0:03:01.75,0:03:04.84,Default,,0,0,0,,Хигаши Токаку бір таңдау
Dialogue: 0,0:03:04.84,0:03:13.73,Default,,0,0,0,,♬～
Dialogue: 0,0:03:13.73,0:03:15.73,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:03:17.12,0:03:19.62,Default,,0,0,0,,((Егер сіз де өзіңізді осы дүниеге қоятын адам болсаңыз➡
Dialogue: 0,0:03:19.62,0:03:22.16,Default,,0,0,0,,Сіз бұл туралы естідіңіз бе? ))
Dialogue: 0,0:03:22.16,0:03:24.53,Default,,0,0,0,,((Сіз мектептерді ауыстырғалы жатырсыз➡
Dialogue: 0,0:03:24.53,0:03:28.85,Default,,0,0,0,,Қара топтағы нысананы басқаларға қарағанда тезірек өлтіріңіз.➡
Dialogue: 0,0:03:28.85,0:03:33.00,Default,,0,0,0,,Мақсаты белгілі бір жағдайлары бар орта мектеп оқушысы.➡
Dialogue: 0,0:03:33.00,0:03:36.17,Default,,0,0,0,,Қалған барлық сыныптастар➡
Dialogue: 0,0:03:36.17,0:03:38.99,Default,,0,0,0,,Ол кісі өлтіруші.➡
Dialogue: 0,0:03:38.99,0:03:43.06,Default,,0,0,0,,Олардың білімі сіз сияқты білікті мамандардан шыққан➡
Dialogue: 0,0:03:43.06,0:03:45.68,Default,,0,0,0,,Ләззат өлтірушілердің алуан түрлілігі))
Dialogue: 0,0:03:45.68,0:03:50.19,Default,,0,0,0,,)
Dialogue: 0,0:03:50.19,0:03:53.76,Default,,0,0,0,,)
Dialogue: 0,0:03:53.76,0:03:57.46,Default,,0,0,0,,)
Dialogue: 0,0:03:58.88,0:04:00.88,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:04:02.42,0:04:04.52,Default,,0,0,0,,)
Dialogue: 0,0:04:09.07,0:04:12.66,Default,,0,0,0,,)
Dialogue: 0,0:04:12.66,0:04:25.16,Default,,0,0,0,,♬～
Dialogue: 0,0:04:30.84,0:04:33.13,Default,,0,0,0,,[ТЕЛ]
Dialogue: 0,0:04:33.13,0:04:36.77,Default,,0,0,0,,Иә. [TEL] (Кайба) Электрондық поштаңызды тексердіңіз бе?
Dialogue: 0,0:04:36.77,0:04:39.24,Default,,0,0,0,,«Қарғыс»? [TEL] (Қайба) Бу~! Бұл басқаша! ➡
Dialogue: 0,0:04:39.24,0:04:41.87,Default,,0,0,0,,Қарғыс? Сіз жиіркеніштісіз
Dialogue: 0,0:04:41.87,0:04:44.94,Default,,0,0,0,,Оқиғаның бәрі осы ма? [TEL] (Қайба) Жоқ.
Dialogue: 0,0:04:44.94,0:04:48.34,Default,,0,0,0,,Ең дарынды студенттерді шетелде оқуға жіберу➡
Dialogue: 0,0:04:48.34,0:04:51.33,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,0:04:51.33,0:04:54.00,Default,,0,0,0,,Менің ойымша, кім ең қате адам➡
Dialogue: 0,0:04:54.00,0:04:56.87,Default,,0,0,0,,Мен ~｡ Токаку➡ таңдадым
Dialogue: 0,0:04:56.87,0:04:59.57,Default,,0,0,0,,Сенің өмірің нашар.
Dialogue: 0,0:04:59.57,0:05:02.46,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:05:02.46,0:05:05.33,Default,,0,0,0,,Өлтір, тірі қалдыр немесе тірі қал және өл ➡
Dialogue: 0,0:05:05.33,0:05:07.43,Default,,0,0,0,,Өзіңізге ұнағанын таңдаңыз
Dialogue: 0,0:05:08.97,0:05:12.60,Default,,0,0,0,,[ТЕЛ] Әлде мен аман қалуым керек пе?
Dialogue: 0,0:05:12.60,0:05:16.00,Default,,0,0,0,,Цк... Мен мұның не екенін түсінбеймін, ақымақ.
Dialogue: 0,0:05:17.67,0:05:19.94,Default,,0,0,0,,♬ Кері санауға дайынсыз ба
Dialogue: 0,0:05:19.94,0:05:22.06,Default,,0,0,0,,♬ Жүгіруге жол жоқ
Dialogue: 0,0:05:22.06,0:05:31.12,Default,,0,0,0,,♬～
Dialogue: 0,0:05:31.12,0:05:35.91,Default,,0,0,0,,♬ Оңай диапазонға түспеңіз.
Dialogue: 0,0:05:35.91,0:05:40.80,Default,,0,0,0,,♬ Бұл қырғи-қабақ соғыс аймағы. Қазіргі жағдай жалықтырады.
Dialogue: 0,0:05:40.80,0:05:45.37,Default,,0,0,0,,♬ Ей, балалар, сондықтан ерекше екенсіңдер.
Dialogue: 0,0:05:45.37,0:05:47.39,Default,,0,0,0,,♬ Баяғыда сыйымдылық асып кеткен
Dialogue: 0,0:05:47.39,0:05:49.71,Default,,0,0,0,,♬ Өзін-өзі мазақ ету түбі жоқ
Dialogue: 0,0:05:49.71,0:05:51.72,Default,,0,0,0,,♬ Өте сүйкімді
Dialogue: 0,0:05:51.72,0:05:54.69,Default,,0,0,0,,♬ Мен саған ақымақтығымды көрсете алмаймын.
Dialogue: 0,0:05:54.69,0:05:56.73,Default,,0,0,0,,♬ Бекер толқу
Dialogue: 0,0:05:56.73,0:05:58.73,Default,,0,0,0,,♬ Тек ынталандыру үшін
Dialogue: 0,0:06:00.13,0:06:02.90,Default,,0,0,0,,♬ Қабылдау/бүлік Екі ғана таңдау бар ма?
Dialogue: 0,0:06:02.90,0:06:05.51,Default,,0,0,0,,♬ ah Эстетика «Мен ешкімге тиіспеймін»
Dialogue: 0,0:06:05.51,0:06:08.46,Default,,0,0,0,,♬ Жараның кінәсіздігі
Dialogue: 0,0:06:08.46,0:06:11.14,Default,,0,0,0,,♬ Мен де сол топқа кіремін.
Dialogue: 0,0:06:11.14,0:06:13.23,Default,,0,0,0,,♬ орылатын болады
Dialogue: 0,0:06:13.23,0:06:15.72,Default,,0,0,0,,♬ Ешбір жағдайда әрқашан жалғасуда
Dialogue: 0,0:06:15.72,0:06:19.80,Default,,0,0,0,,♬ Белдемшенің етегі туралы шындық
Dialogue: 0,0:06:19.80,0:06:24.72,Default,,0,0,0,,♬ Тек ақымақ сияқты сеніңіз
Dialogue: 0,0:06:24.72,0:06:29.21,Default,,0,0,0,,♬ Маған қатты әсер етті
Dialogue: 0,0:06:29.21,0:06:35.80,Default,,0,0,0,,♬ Оны твиттер арқылы жіберіңіз.
Dialogue: 0,0:06:35.80,0:06:45.20,Default,,0,0,0,,♬～
Dialogue: 0,0:06:58.16,0:07:01.08,Default,,0,0,0,,♬～
Dialogue: 0,0:07:01.08,0:07:04.66,Default,,0,0,0,,((Мйоджо Гакуэн – бастауыш, орта мектеп, орта мектеп және үлкен➡
Dialogue: 0,0:07:04.66,0:07:07.13,Default,,0,0,0,,Біріктірілген білім беретін интернат жүйесі.➡
Dialogue: 0,0:07:07.13,0:07:09.84,Default,,0,0,0,,Саясаткерлер мен байлардың көп балалары➡
Dialogue: 0,0:07:09.84,0:07:12.44,Default,,0,0,0,,Биліктегілермен терең байланыс))
Dialogue: 0,0:07:15.32,0:07:19.26,Default,,0,0,0,,((Барлық Қара тобы жиналғанша бірнеше күн қажет болады.➡
Dialogue: 0,0:07:19.26,0:07:21.68,Default,,0,0,0,,Қосымша мәліметтер алу үшін сайтқа кіріңіз➡
Dialogue: 0,0:07:21.68,0:07:24.83,Default,,0,0,0,,Клиенттің байланысын күтіңіз))
Dialogue: 0,0:07:24.83,0:07:26.90,Default,,0,0,0,,)
Dialogue: 0,0:07:26.90,0:07:30.32,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:07:30.32,0:07:40.17,Default,,0,0,0,,♬～
Dialogue: 0,0:07:40.17,0:07:50.83,Default,,0,0,0,,♬～
Dialogue: 0,0:07:50.83,0:07:54.63,Default,,0,0,0,,≪(Хару Ичиноза) Қатысу саны 1 Хигаши Тото Каку-кун
Dialogue: 0,0:07:54.63,0:07:57.80,Default,,0,0,0,,≪Жоқ. 2 Исуке Инукай
Dialogue: 0,0:07:57.80,0:08:00.74,Default,,0,0,0,,≪Жоқ. 3 Како Каминага
Dialogue: 0,0:08:00.74,0:08:03.61,Default,,0,0,0,,≪Жоқ. 4 Киригая Хицуги-кун
Dialogue: 0,0:08:03.61,0:08:06.51,Default,,0,0,0,,№ 5 Кенмочи Эна-сан
Dialogue: 0,0:08:08.41,0:08:11.15,Default,,0,0,0,,№ 6 Харуки Сагаэ
Dialogue: 0,0:08:11.15,0:08:13.65,Default,,0,0,0,,№ 7 Рио Шуто...
Dialogue: 0,0:08:16.02,0:08:18.64,Default,,0,0,0,,№ 10 Хашири-но-кун
Dialogue: 0,0:08:18.64,0:08:21.61,Default,,0,0,0,,№11 Койко Эйзуми
Dialogue: 0,0:08:21.61,0:08:24.21,Default,,0,0,0,,№ 12 Бамба Махиру-сан
Dialogue: 0,0:08:25.56,0:08:28.76,Default,,0,0,0,,№13 Хару Ичиноза
Dialogue: 0,0:08:31.13,0:08:35.22,Default,,0,0,0,,Хару міндетті түрде бітіреді.
Dialogue: 0,0:08:35.22,0:08:39.81,Default,,0,0,0,,♬～
Dialogue: 0,0:08:39.81,0:08:43.81,Default,,0,0,0,,Сіз де Қара тобының мүшесісіз бе?
Dialogue: 0,0:08:43.81,0:08:46.68,Default,,0,0,0,,Мен...
Dialogue: 0,0:08:46.68,0:08:49.54,Default,,0,0,0,,Уау! Не... ол не?
Dialogue: 0,0:08:49.54,0:08:51.54,Default,,0,0,0,,Үй бөлмесі басталады
Dialogue: 0,0:08:54.41,0:08:56.84,Default,,0,0,0,,Қош келдіңіздер, 10-сынып қара сынып оқушылары! ➡
Dialogue: 0,0:08:56.84,0:08:59.03,Default,,0,0,0,,Мен Мизоро Кибе, менің сынып мұғалімім.➡
Dialogue: 0,0:08:59.03,0:09:02.45,Default,,0,0,0,,Мұғалім болғаныма үшінші жыл. Мен биологияға жауаптымын.
Dialogue: 0,0:09:02.45,0:09:06.20,Default,,0,0,0,,Мен бірінші рет сынып мұғалімі болып отырмын. Сізбен танысқаныма қуаныштымын!
Dialogue: 0,0:09:06.20,0:09:08.44,Default,,0,0,0,,<<Қалай қарасаң да, қарапайым адам>>
Dialogue: 0,0:09:08.44,0:09:10.64,Default,,0,0,0,,≪Неге байқамадың? ≫
Dialogue: 0,0:09:10.64,0:09:14.41,Default,,0,0,0,,Бүгіннен бастап бәріңіз бір қара топтың мүшелерісіздер.
Dialogue: 0,0:09:14.41,0:09:17.83,Default,,0,0,0,,Мені үлкен ағаң деп ойлап, маған арқа сүйе.
Dialogue: 0,0:09:17.83,0:09:20.30,Default,,0,0,0,,Хэхе! Хехехехе
Dialogue: 0,0:09:20.30,0:09:25.29,Default,,0,0,0,,Мұғалім, бұл қызық. Исуке жек көретін түрі.
Dialogue: 0,0:09:25.29,0:09:29.48,Default,,0,0,0,,Ех... мм...｡ (Исуке) Олай болса, өзіңізді таныстырыңыз.➡
Dialogue: 0,0:09:29.48,0:09:33.13,Default,,0,0,0,,Қатысу саны 2 Исуке Инукай
Dialogue: 0,0:09:33.13,0:09:36.92,Default,,0,0,0,,Үш “i”. Мұғалім тым жас.
Dialogue: 0,0:09:36.92,0:09:41.44,Default,,0,0,0,,Менің ойымша, ер адам 40-тан асқан болуы керек.
Dialogue: 0,0:09:41.44,0:09:45.14,Default,,0,0,0,,Иә~ 40 - қарт болу үшін жақсы жер...
Dialogue: 0,0:09:45.14,0:09:49.88,Default,,0,0,0,,40 қарт адам емес. Мен оны өлтіруім керек пе?
Dialogue: 0,0:09:49.88,0:09:53.28,Default,,0,0,0,,Жоқ, өтінемін, ашуланбаңыз.
Dialogue: 0,0:09:53.28,0:09:58.49,Default,,0,0,0,,Қатысу саны 10, Хашириносу. Құрметпен.
Dialogue: 0,0:09:58.49,0:10:02.49,Default,,0,0,0,,Хахахаха, мұғалім туралы ұрыспаңдар~
Dialogue: 0,0:10:02.49,0:10:05.29,Default,,0,0,0,,Олай болса, №1 қатысу!
Dialogue: 0,0:10:07.56,0:10:11.06,Default,,0,0,0,,Қатысу саны 1 Тотокаку
Dialogue: 0,0:10:12.50,0:10:15.89,Default,,0,0,0,,Шығыс... иә? Шынайы ма?
Dialogue: 0,0:10:15.89,0:10:19.66,Default,,0,0,0,,«Токаку» «мүмкін емес» дегенді білдіреді
Dialogue: 0,0:10:19.66,0:10:23.11,Default,,0,0,0,,Мен мұны көп сұрайды, сондықтан алдымен айтайын.
Dialogue: 0,0:10:23.11,0:10:26.25,Default,,0,0,0,,Ал, келесі кезек № 12!
Dialogue: 0,0:10:26.25,0:10:30.10,Default,,0,0,0,,♬～
Dialogue: 0,0:10:30.10,0:10:32.81,Default,,0,0,0,,12 саны?
Dialogue: 0,0:10:32.81,0:10:36.34,Default,,0,0,0,,Күн батқанда істеймін... А?
Dialogue: 0,0:10:36.34,0:10:40.66,Default,,0,0,0,,Бәрі... Күн батқанда жасаймын.➡
Dialogue: 0,0:10:40.66,0:10:42.92,Default,,0,0,0,,Мені екі рет айтуға мәжбүрлеме...
Dialogue: 0,0:10:42.92,0:10:46.35,Default,,0,0,0,,Сонымен... сосын, ақырында...
Dialogue: 0,0:10:46.35,0:10:51.24,Default,,0,0,0,,Иә! Қатысу саны 13 - Хару Ичиноза.
Dialogue: 0,0:10:51.24,0:10:53.66,Default,,0,0,0,,Жақсы болыңыз!
Dialogue: 0,0:10:53.66,0:10:56.40,Default,,0,0,0,,≪Хару Ичиноза≫
Dialogue: 0,0:10:56.40,0:11:00.68,Default,,0,0,0,,Расында, күннің ашық болуы сіздің жақындап келе жатқаныңызды білдіреді➡
Dialogue: 0,0:11:00.68,0:11:02.89,Default,,0,0,0,,Мен бау жасадым
Dialogue: 0,0:11:02.89,0:11:05.32,Default,,0,0,0,,Оны алыңыз!
Dialogue: 0,0:11:05.32,0:11:09.12,Default,,0,0,0,,А... рахмет. Маған керек емес. Ақсақ.
Dialogue: 0,0:11:10.49,0:11:13.15,Default,,0,0,0,,Иә~ Бүгіннен бастап бәрі өмір сүретін болады➡
Dialogue: 0,0:11:13.15,0:11:16.40,Default,,0,0,0,,Жатақханаға келетін болсақ, әзірге ол шартты➡
Dialogue: 0,0:11:16.40,0:11:20.25,Default,,0,0,0,,№1 сабаққа қатысқан Хигашиден жатақхана директоры болуын сұрай аламын ба?
Dialogue: 0,0:11:20.25,0:11:23.39,Default,,0,0,0,,<<Бұл маған қажет емес. Мен оны кейінірек тастауым керек пе>>
Dialogue: 0,0:11:23.39,0:11:29.13,Default,,0,0,0,,♬～
Dialogue: 0,0:11:29.13,0:11:31.11,Default,,0,0,0,,Дыбыстық сигнал...
Dialogue: 0,0:11:31.11,0:11:36.10,Default,,0,0,0,,♬～
Dialogue: 0,0:11:36.10,0:11:38.10,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:39.94,0:11:41.94,Default,,0,0,0,,[TEL] (Пошта қоңырау үні)
Dialogue: 0,0:11:45.33,0:11:47.50,Default,,0,0,0,,≫(Нидзи) Керемет көрініс емес пе? ➡
Dialogue: 0,0:11:47.50,0:11:50.35,Default,,0,0,0,,Көптеген қызықты оқиғалар бар.
Dialogue: 0,0:11:50.35,0:11:54.97,Default,,0,0,0,,Сол мектеп ғимаратының құрылысы кезінде жұмысшылар бірінен соң бірі апатқа ұшырады➡
Dialogue: 0,0:11:54.97,0:11:58.97,Default,,0,0,0,,Жер астында ескі зират бар еді, бірақ оны жай ғана жерледі.
Dialogue: 0,0:12:00.51,0:12:03.83,Default,,0,0,0,,Мен мұнда студентпін, сондықтан көп нәрсені білемін.
Dialogue: 0,0:12:03.83,0:12:08.17,Default,,0,0,0,,Қол ұстасайық па? Мен сенің бағыныштың боламын, солай ма?
Dialogue: 0,0:12:08.17,0:12:10.39,Default,,0,0,0,,Мақсат анықталды ма?
Dialogue: 0,0:12:10.39,0:12:13.24,Default,,0,0,0,,Мен сенің менің әпкем емес екеніңді білемін.
Dialogue: 0,0:12:13.24,0:12:16.98,Default,,0,0,0,,Оның жағымсыз иісі бар. Мен келісемін.
Dialogue: 0,0:12:16.98,0:12:19.95,Default,,0,0,0,,Мақсат Хару Ичиноза болуы мүмкін
Dialogue: 0,0:12:19.95,0:12:22.45,Default,,0,0,0,,Иісі бізге ұқсамайды
Dialogue: 0,0:12:22.45,0:12:25.40,Default,,0,0,0,,Әлгі жігіттің өзі сақтығын түсіре алмайды.➡
Dialogue: 0,0:12:25.40,0:12:29.17,Default,,0,0,0,,GPS немесе тыңдау құрылғысы?➡
Dialogue: 0,0:12:29.17,0:12:31.17,Default,,0,0,0,,Қажет емес
Dialogue: 0,0:12:35.61,0:12:39.92,Default,,0,0,0,,Мен оны тастауым керек пе? Бұл ештеңеге ұқсамайды
Dialogue: 0,0:12:39.92,0:12:41.92,Default,,0,0,0,,≪Иә? Бұл біртүрлі≫
Dialogue: 0,0:12:43.77,0:12:46.09,Default,,0,0,0,,Себебі мен лақтырғанымды жинадым➡
Dialogue: 0,0:12:46.09,0:12:49.63,Default,,0,0,0,,Бұл менікі, солай ма?
Dialogue: 0,0:12:49.63,0:12:53.05,Default,,0,0,0,,<<Керек емес деп ойладым>>
Dialogue: 0,0:12:53.05,0:12:57.55,Default,,0,0,0,,♬～
Dialogue: 0,0:12:57.55,0:12:59.85,Default,,0,0,0,,Маған бұл да керек емес.
Dialogue: 0,0:13:01.24,0:13:05.32,Default,,0,0,0,,Ни-сан, сенің түрің қорқынышты.
Dialogue: 0,0:13:05.32,0:13:09.90,Default,,0,0,0,,Исуке мұны жасыруға ниеті жоқ. Ол мұны басқалардан бұрын жасайды.
Dialogue: 0,0:13:09.90,0:13:12.53,Default,,0,0,0,,Бұл бәрібір 13 саны шығар.
Dialogue: 0,0:13:12.53,0:13:15.40,Default,,0,0,0,,Хмм, сіз қалай ойлайсыз?
Dialogue: 0,0:13:15.40,0:13:18.84,Default,,0,0,0,,♬～
Dialogue: 0,0:13:18.84,0:13:20.94,Default,,0,0,0,,Ах... ой...
Dialogue: 0,0:13:20.94,0:13:26.03,Default,,0,0,0,,Рахмет...｡ Бұл мені қатты қуантады...
Dialogue: 0,0:13:26.03,0:13:28.88,Default,,0,0,0,,Шынымен!? Хару да бақытты!
Dialogue: 0,0:13:28.88,0:13:33.18,Default,,0,0,0,,Киелі жәдігерге айналады. «Сейибуцу»?
Dialogue: 0,0:13:35.84,0:13:39.04,Default,,0,0,0,,≪Бұл қайтыс болған қымбат адамның заттарына қатысты≫
Dialogue: 0,0:13:39.04,0:13:41.04,Default,,0,0,0,,Хехе
Dialogue: 0,0:15:52.01,0:15:56.28,Default,,0,0,0,,Шығыс! Бұл бір бөлмедегі Хару Ичиноза!
Dialogue: 0,0:15:56.28,0:16:00.27,Default,,0,0,0,,Хахаха...｡ Мен сенімен жатақханаға барсам болады ма?
Dialogue: 0,0:16:00.27,0:16:03.59,Default,,0,0,0,,♬～
Dialogue: 0,0:16:03.59,0:16:07.42,Default,,0,0,0,,Мен қарсы емеспін. Шынымен бе? Жақсы
Dialogue: 0,0:16:07.42,0:16:10.71,Default,,0,0,0,,Бұл жер шынымен де кең және үлкен.
Dialogue: 0,0:16:10.71,0:16:14.56,Default,,0,0,0,,Азума-сан, сен жылдамсың. Хехе.
Dialogue: 0,0:16:14.56,0:16:18.20,Default,,0,0,0,,♬～
Dialogue: 0,0:16:18.20,0:16:22.60,Default,,0,0,0,,Азума-сан, сен бүгін кештен бастап жатақхана басшысы боласың. Керемет.
Dialogue: 0,0:16:25.51,0:16:29.88,Default,,0,0,0,,Хару барлығымен бірге оқыды, дос болды, жақсы араласты➡
Dialogue: 0,0:16:29.88,0:16:31.98,Default,,0,0,0,,Өмірден ләззат алыңыз
Dialogue: 0,0:16:31.98,0:16:35.08,Default,,0,0,0,,Ал мен міндетті түрде бітіремін!
Dialogue: 0,0:16:36.74,0:16:38.95,Default,,0,0,0,,Осыны қалайсыз ба?
Dialogue: 0,0:16:38.95,0:16:41.74,Default,,0,0,0,,Не? Иә әрине
Dialogue: 0,0:16:41.74,0:16:46.36,Default,,0,0,0,,♬～
Dialogue: 0,0:16:46.36,0:16:48.45,Default,,0,0,0,,Харудың кейбір жағдайлары бар➡
Dialogue: 0,0:16:48.45,0:16:50.98,Default,,0,0,0,,Себебі мен мектепке көп бармадым➡
Dialogue: 0,0:16:50.98,0:16:53.88,Default,,0,0,0,,Мен мұнда болғаныма өте қуаныштымын.
Dialogue: 0,0:16:56.52,0:16:59.07,Default,,0,0,0,,≪Бұл не? Бұл иіс≫
Dialogue: 0,0:16:59.07,0:17:08.40,Default,,0,0,0,,♬～
Dialogue: 0,0:17:08.40,0:17:11.80,Default,,0,0,0,,Күн шуақты~! Токаку~!
Dialogue: 0,0:17:14.07,0:17:16.74,Default,,0,0,0,,Ниндзя-чан. Ниндзя жақсы.
Dialogue: 0,0:17:16.74,0:17:21.15,Default,,0,0,0,,Токаку: Бұл жақсы. Мен Харумен бір бөлмеде тұрғаным да ұнады.
Dialogue: 0,0:17:21.15,0:17:23.60,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:17:23.60,0:17:26.25,Default,,0,0,0,,Маған ешнәрсе шақыруға ешқандай себеп жоқ.
Dialogue: 0,0:17:26.25,0:17:29.87,Default,,0,0,0,,Мені Азума-сан деп атаңыз. (Нихон) Иә~ Керемет емес пе?
Dialogue: 0,0:17:29.87,0:17:31.94,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:17:31.94,0:17:34.18,Default,,0,0,0,,≪Бұл не жігіт?➡
Dialogue: 0,0:17:34.18,0:17:37.01,Default,,0,0,0,,Шіріген теңіздің иісі≫
Dialogue: 0,0:17:37.01,0:17:39.75,Default,,0,0,0,,Токаку-сан!
Dialogue: 0,0:17:39.75,0:17:43.15,Default,,0,0,0,,А... Бір сәтке, Токаку-сан, қалай ойлайсың?
Dialogue: 0,0:17:44.59,0:17:47.01,Default,,0,0,0,,мұнда тұтқындарды пайдаланып көмір қазылады
Dialogue: 0,0:17:47.01,0:17:49.69,Default,,0,0,0,,А, аа... күте тұрыңыз~
Dialogue: 0,0:17:49.69,0:17:51.69,Default,,0,0,0,,Хехе
Dialogue: 0,0:17:53.51,0:17:56.06,Default,,0,0,0,,Уау! Керемет! Керемет!
Dialogue: 0,0:17:56.06,0:17:59.57,Default,,0,0,0,,Бұл кең! Қонақ үй сияқты! Хахахаха
Dialogue: 0,0:17:59.57,0:18:06.57,Default,,0,0,0,,♬～
Dialogue: 0,0:18:09.13,0:18:12.20,Default,,0,0,0,,Токаку мырза, қай төсек? Қайсысы?
Dialogue: 0,0:18:12.20,0:18:14.83,Default,,0,0,0,,А, кешіріңіз. Рұқсатсыз ұйықтап қалдым.
Dialogue: 0,0:18:14.83,0:18:16.87,Default,,0,0,0,,Мен қарсы емеспін.
Dialogue: 0,0:18:16.87,0:18:18.89,Default,,0,0,0,,Иә? Ах...
Dialogue: 0,0:18:18.89,0:18:22.84,Default,,0,0,0,,♬～
Dialogue: 0,0:18:22.84,0:18:26.35,Default,,0,0,0,,Бұл пышақ жарақаты ма? Маған көрсет
Dialogue: 0,0:18:26.35,0:18:29.62,Default,,0,0,0,,Жоқ, бұл... жиіркенішті.
Dialogue: 0,0:18:29.62,0:18:33.77,Default,,0,0,0,,Юбкаңызды ораңыз. Е!? Жақсы!
Dialogue: 0,0:18:33.77,0:18:37.07,Default,,0,0,0,,Жол апатына байланысты ауруханада ұзақ жаттым.
Dialogue: 0,0:18:40.19,0:18:42.66,Default,,0,0,0,,Түсіндім. Ах...
Dialogue: 0,0:18:42.66,0:18:44.66,Default,,0,0,0,,Хяааа!!
Dialogue: 0,0:18:47.23,0:18:49.93,Default,,0,0,0,,Токаку-сан, сен жамансың.
Dialogue: 0,0:18:52.35,0:18:54.91,Default,,0,0,0,,О, біз қазірдің өзінде бармыз.
Dialogue: 0,0:18:54.91,0:18:58.19,Default,,0,0,0,,Бұл Харуки Сагаэ. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:18:58.19,0:19:00.31,Default,,0,0,0,,Бұл дұрыс болды, сіз...
Dialogue: 0,0:19:00.31,0:19:04.80,Default,,0,0,0,,Исуке Инукай. Кешіріңіз, кешіріңіз. Исуке Инукай➡
Dialogue: 0,0:19:04.80,0:19:09.19,Default,,0,0,0,,Сізде кетіргіш бар ма? Мен ұмыттым
Dialogue: 0,0:19:09.19,0:19:12.26,Default,,0,0,0,,А, мен не істеуім керек? Мен ренжідім.
Dialogue: 0,0:19:12.26,0:19:14.43,Default,,0,0,0,,Мені Исуке-сама деп атаңыз.
Dialogue: 0,0:19:14.43,0:19:17.30,Default,,0,0,0,,Эй, Исуке мырза, маған кетіргішті беріңіз.➡
Dialogue: 0,0:19:17.30,0:19:21.37,Default,,0,0,0,,Тырнағым жарты жолда түсіп қалды. (Исуке) Өте жаман.
Dialogue: 0,0:19:21.37,0:19:23.90,Default,,0,0,0,,Неліктен менің тырнақтарым гель болып табылады?
Dialogue: 0,0:19:23.90,0:19:27.46,Default,,0,0,0,,Иә, гель туралы не айтасыз?
Dialogue: 0,0:19:27.46,0:19:29.49,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:29.49,0:19:33.75,Default,,0,0,0,,Тырнақтар жұқа болады. Мен келіспеймін.➡
Dialogue: 0,0:19:33.75,0:19:37.62,Default,,0,0,0,,Хмм... бірақ әдемі.
Dialogue: 0,0:19:37.62,0:19:40.72,Default,,0,0,0,,Эй, Исукенің аты біртүрлі екен ғой?
Dialogue: 0,0:19:40.72,0:19:43.54,Default,,0,0,0,,Бұл таңқаларлық емес. Бұл салқын.
Dialogue: 0,0:19:43.54,0:19:48.54,Default,,0,0,0,,♬～
Dialogue: 0,0:19:48.54,0:19:50.84,Default,,0,0,0,,≪Басқа бөлмелерді тексеру керек пе?≫
Dialogue: 0,0:19:53.43,0:19:55.97,Default,,0,0,0,,Мен бірінші ваннаны алдым!
Dialogue: 0,0:19:55.97,0:19:59.77,Default,,0,0,0,,Ах. Не? Шақыру? Күн де ашық
Dialogue: 0,0:19:59.77,0:20:03.79,Default,,0,0,0,,Қажет емес. Бөлмедегілер бір-біріне көмектесуге арналған.
Dialogue: 0,0:20:03.79,0:20:05.84,Default,,0,0,0,,Мұндағы Окаринді
Dialogue: 0,0:20:05.84,0:20:08.21,Default,,0,0,0,,♬ Фуфуфу~ Фуфуфу~ (мырылдап)
Dialogue: 0,0:20:08.21,0:20:12.31,Default,,0,0,0,,Құрметті Қара тобының мүшелері, қоңырау шалу уақыты келді!
Dialogue: 0,0:20:13.82,0:20:17.54,Default,,0,0,0,,Қайырлы түн. Қайырлы түн~. Ах.
Dialogue: 0,0:20:17.54,0:20:20.39,Default,,0,0,0,,Сіз бастауыш сынып оқушысысыз ба? Неге мұндасың?
Dialogue: 0,0:20:20.39,0:20:22.46,Default,,0,0,0,,О!? Жоқ...
Dialogue: 0,0:20:22.46,0:20:26.55,Default,,0,0,0,,Бұл бала біз сияқты 10-сыныптың қара сыныбының ауыспалы оқушысы.
Dialogue: 0,0:20:26.55,0:20:30.49,Default,,0,0,0,,Сен сыныптассың ба? рақмет сізге!
Dialogue: 0,0:20:30.49,0:20:35.06,Default,,0,0,0,,Мен №9 қатысушымын, Сенсоку Наматаме.
Dialogue: 0,0:20:35.06,0:20:39.75,Default,,0,0,0,,Мен 4-ші Киригая Хицугимін. Рақмет сізге.
Dialogue: 0,0:20:39.75,0:20:42.96,Default,,0,0,0,,♬～
Dialogue: 0,0:20:42.96,0:20:47.14,Default,,0,0,0,,Қайырлы кеш, қоңырау шалыңыз.
Dialogue: 0,0:20:47.14,0:20:50.17,Default,,0,0,0,,Мылтық! иә?
Dialogue: 0,0:20:50.17,0:20:52.44,Default,,0,0,0,,♬~
Dialogue: 0,0:20:52.44,0:20:54.48,Default,,0,0,0,,Ия, кешіріңіз, кешіріңіз.
Dialogue: 0,0:20:54.48,0:20:57.30,Default,,0,0,0,,Харуки Сагаэ келді ме?
Dialogue: 0,0:20:57.30,0:21:00.08,Default,,0,0,0,,Иә? сіз мені танисыз ба?
Dialogue: 0,0:21:00.08,0:21:02.90,Default,,0,0,0,,Бұл жою процесі. Сіз ит өсіруші емессіз.
Dialogue: 0,0:21:02.90,0:21:06.69,Default,,0,0,0,,көремін. Исуке мырза қазір душ қабылдап жатыр.
Dialogue: 0,0:21:06.69,0:21:09.86,Default,,0,0,0,,♬～
Dialogue: 0,0:21:09.86,0:21:14.13,Default,,0,0,0,,Бұл жұмыс істемейтін сияқты жаман идея.
Dialogue: 0,0:21:14.13,0:21:17.05,Default,,0,0,0,,Хару жаман ештеңе жасамайды, солай ма?
Dialogue: 0,0:21:17.05,0:21:20.97,Default,,0,0,0,,Оны жегің келе ме? Сен де. Маған керек емес.
Dialogue: 0,0:21:20.97,0:21:23.51,Default,,0,0,0,,Айтпа, қабыл ал!
Dialogue: 0,0:21:23.51,0:21:28.43,Default,,0,0,0,,♬～
Dialogue: 0,0:21:28.43,0:21:30.70,Default,,0,0,0,,Сау! Жақсы реакция!
Dialogue: 0,0:21:30.70,0:21:34.13,Default,,0,0,0,,... Харуки-сан, тамақты неге лақтырып жатырсың?
Dialogue: 0,0:21:34.13,0:21:36.90,Default,,0,0,0,,Ахаха кешіріңіз кешіріңіз
Dialogue: 0,0:21:36.90,0:21:39.54,Default,,0,0,0,,Сіз оң қолсыз ба? Енді?
Dialogue: 0,0:21:39.54,0:21:42.54,Default,,0,0,0,,Солақай болуы мүмкін. Мүмкін екіжақты.
Dialogue: 0,0:21:44.01,0:21:47.20,Default,,0,0,0,,Токаку-сан, сен неге сонша ұрыссың?
Dialogue: 0,0:21:47.20,0:21:51.20,Default,,0,0,0,,Сұлу әйелдер күледі, Токаку-сан. Қараңдар!
Dialogue: 0,0:21:54.54,0:21:56.94,Default,,0,0,0,,Иісіңіз...
Dialogue: 0,0:21:56.94,0:22:01.88,Default,,0,0,0,,Бұл... иіс!? Не істеуім керек? Хару Сасық па!?
Dialogue: 0,0:22:01.88,0:22:05.63,Default,,0,0,0,,Жоқ, олай емес, шаң басқан➡
Dialogue: 0,0:22:05.63,0:22:08.48,Default,,0,0,0,,Мен түшкірейін деп тұрмын. иә!
Dialogue: 0,0:22:08.48,0:22:11.34,Default,,0,0,0,,Сіз білмейсіз бе? ➡
Dialogue: 0,0:22:11.34,0:22:15.91,Default,,0,0,0,,Күннің иісі осылай аталады.
Dialogue: 0,0:22:15.91,0:22:19.49,Default,,0,0,0,,Міне, күн батып бара жатыр еді, мен мұны істеуге келдім.
Dialogue: 0,0:22:19.49,0:22:23.30,Default,,0,0,0,,Не... не? (Майя) Өзімді таныстырамын.
Dialogue: 0,0:22:23.30,0:22:28.67,Default,,0,0,0,,Менің атым Майя Бамба. Бұл күннің әйелі - Махиру. Сізбен танысқаныма қуаныштымын!
Dialogue: 0,0:22:28.67,0:22:30.67,Default,,0,0,0,,Маған ұнамайды. Ах...
Dialogue: 0,0:22:34.28,0:22:47.41,Default,,0,0,0,,♬～
Dialogue: 0,0:22:47.41,0:22:51.71,Default,,0,0,0,,Хехехехехе...
Dialogue: 0,0:22:54.93,0:22:58.33,Default,,0,0,0,,Иә, Чак. Сөйлесуге тыйым салынады.
Dialogue: 0,0:22:59.73,0:23:03.91,Default,,0,0,0,,Әр түрлі қызметтегі адамдар бір-бірін түсінбейді.
Dialogue: 0,0:23:03.91,0:23:08.21,Default,,0,0,0,,Жарайсың ба? Сондықтан сөйлеме. Бұл мағынасыз.➡
Dialogue: 0,0:23:08.21,0:23:11.63,Default,,0,0,0,,Балалар, енді қоштасыңдар. Адамның ішінде не бар екенін біліңіз➡
Dialogue: 0,0:23:11.63,0:23:13.67,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:23:13.67,0:23:17.30,Default,,0,0,0,,Бұл дүниеде білмеген жақсы нәрселер бар.
Dialogue: 0,0:23:17.30,0:23:19.32,Default,,0,0,0,,Ха!
Dialogue: 0,0:23:19.32,0:23:38.01,Default,,0,0,0,,♬～
Dialogue: 0,0:23:38.01,0:23:42.06,Default,,0,0,0,,Токаку-сан балаға ұқсайды.
Dialogue: 0,0:23:42.06,0:23:45.60,Default,,0,0,0,,♬～
Dialogue: 0,0:23:45.60,0:23:50.74,Default,,0,0,0,,Токаку-сан, тіпті Хару туралы білсең де, мені жек көрме.
Dialogue: 0,0:23:50.74,0:24:01.20,Default,,0,0,0,,♬～
Dialogue: 0,0:24:01.20,0:24:04.20,Default,,0,0,0,,Ихиноза. Ах. Ха... Иә.
Dialogue: 0,0:24:06.53,0:24:09.07,Default,,0,0,0,,Сіз мұны болжай аласыз ба?
Dialogue: 0,0:24:09.07,0:24:12.37,Default,,0,0,0,,Мм, жұмбақ па? Кез келген кеңестер?
Dialogue: 0,0:24:12.37,0:24:15.07,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:24:16.54,0:24:18.74,Default,,0,0,0,,Кешіріңіз. Ұмыт.
Dialogue: 0,0:24:20.18,0:24:23.34,Default,,0,0,0,,Бірақ егер Харуға шешім қабылдауға рұқсат етілсе➡
Dialogue: 0,0:24:23.34,0:24:25.64,Default,,0,0,0,,«Кешірімділік» жақсы.
Dialogue: 0,0:24:27.67,0:24:31.04,Default,,0,0,0,,«Дүние кешірімге толы» дегенді қалай түсінесіңдер?
Dialogue: 0,0:24:31.04,0:24:39.05,Default,,0,0,0,,♬～
Dialogue: 0,0:24:39.05,0:24:42.55,Default,,0,0,0,,Ал... бұлай жауап беруге болмайды.
Dialogue: 0,0:24:44.71,0:24:50.70,Default,,0,0,0,,Иә, егер Хару шешсе.
Dialogue: 0,0:24:50.70,0:24:54.33,Default,,0,0,0,,≪Жоқ. Бұл жігіт басқаша≫
Dialogue: 0,0:24:54.33,0:24:57.20,Default,,0,0,0,,≪Хару Ичиноза бұл...≫
Dialogue: 0,0:24:57.20,0:24:59.20,Default,,0,0,0,,Гей
Dialogue: 0,0:25:01.87,0:25:05.33,Default,,0,0,0,,Қызық, сіз қаншалықты тырысасыз? ➡
Dialogue: 0,0:25:05.33,0:25:09.56,Default,,0,0,0,,12 адамға қарсы, Хару-чан.➡
Dialogue: 0,0:25:09.56,0:25:12.00,Default,,0,0,0,,Мен оны асыға күтемін➡
Dialogue: 0,0:25:12.00,0:25:14.22,Default,,0,0,0,,Бұл жолғы қара топ
Dialogue: 0,0:25:14.22,0:25:17.57,Default,,0,0,0,,♬～
Dialogue: 0,0:25:17.57,0:25:20.88,Default,,0,0,0,,Міне, ақыры келді.
Dialogue: 0,0:25:20.88,0:25:33.54,Default,,0,0,0,,♬～
Dialogue: 0,0:25:33.54,0:25:36.68,Default,,0,0,0,,<<Бәрі бүгіннен басталады➡
Dialogue: 0,0:25:36.68,0:25:40.03,Default,,0,0,0,,Мен әлі білмедім≫
Dialogue: 0,0:25:40.03,0:25:47.32,Default,,0,0,0,,♬～
Dialogue: 0,0:25:47.32,0:25:52.76,Default,,0,0,0,,♬～
Dialogue: 0,0:25:52.76,0:25:57.90,Default,,0,0,0,,♬ Осы денеде қызу айналатын қан
Dialogue: 0,0:25:57.90,0:26:03.37,Default,,0,0,0,,♬ Бұл нені білдіреді?
Dialogue: 0,0:26:03.37,0:26:06.04,Default,,0,0,0,,♬ Әрине қашып құтыла алмайсың
Dialogue: 0,0:26:06.04,0:26:08.64,Default,,0,0,0,,♬ Үнемі өзіңе жабысып
Dialogue: 0,0:26:08.64,0:26:10.93,Default,,0,0,0,,♬ Кейде жеңілдеп қалады
Dialogue: 0,0:26:10.93,0:26:13.03,Default,,0,0,0,,♬ кісенге айналады
Dialogue: 0,0:26:14.48,0:26:16.50,Default,,0,0,0,,♬ Сүйіспеншілік немесе сүйіспеншілік?
Dialogue: 0,0:26:16.50,0:26:18.50,Default,,0,0,0,,♬ Иранай
Dialogue: 0,0:26:19.87,0:26:23.14,Default,,0,0,0,,♬ Бұл дүниеде әрқашан өмір сүру немесе өлу туралы.
Dialogue: 0,0:26:23.14,0:26:27.26,Default,,0,0,0,,♬ Жынды болып бара жатқан ақыл парадокс
Dialogue: 0,0:26:27.26,0:26:29.81,Default,,0,0,0,,♬ Өз күшіңізбен
Dialogue: 0,0:26:29.81,0:26:32.06,Default,,0,0,0,,♬ Секіріңіз де, оны кесіңіз.
Dialogue: 0,0:26:32.06,0:26:34.42,Default,,0,0,0,,♬ Жалғыздықта
Dialogue: 0,0:26:34.42,0:26:36.72,Default,,0,0,0,,♬ Ешкім қол ұшын созбайды
Dialogue: 0,0:26:38.10,0:26:40.54,Default,,0,0,0,,♬ Ұйықтау мүмкіндігі
Dialogue: 0,0:26:40.54,0:26:43.48,Default,,0,0,0,,♬ Оны тауып, оятыңыз.
Dialogue: 0,0:26:43.48,0:26:45.58,Default,,0,0,0,,♬ Бұл қирату болса да
Dialogue: 0,0:26:46.91,0:27:02.53,Default,,0,0,0,,♬～
Dialogue: 0,0:27:02.53,0:27:07.13,Default,,0,0,0,,♬～
Dialogue: 0,0:28:41.23,0:28:44.90,Default,,0,0,0,,Менің атым Қайба Сенсей. Менің мамандығым 17 жекеменшік мектепте мұғалім.➡
Dialogue: 0,0:28:44.90,0:28:48.60,Default,,0,0,0,,Сіз маған қалағаныңызша қоңырау шала аласыз, ол мистер Дайс немесе мистер Дайс болсын.➡
Dialogue: 0,0:28:48.60,0:28:51.12,Default,,0,0,0,,Ұстазға лақап ат бермеу тағдыры.➡
Dialogue: 0,0:28:51.12,0:28:54.12,Default,,0,0,0,,Токакуда мұндай сезімталдық жоқ сияқты.
Dialogue: 0,0:28:55.47,0:28:57.49,Default,,0,0,0,,«Куругуми үй бөлмесі»!
Dialogue: 0,0:28:57.49,0:28:59.89,Default,,0,0,0,,Токаку-сан теле аниме «Шайтанның жұмбағы»➡
Dialogue: 0,0:28:59.89,0:29:02.63,Default,,0,0,0,,Бұл ақыры басталды. Мен түсінемін. Бұл жақсы.
Dialogue: 0,0:29:02.63,0:29:05.63,Default,,0,0,0,,Токаку-сан, суық~｡ Жарайды➡
Dialogue: 0,0:29:05.63,0:29:09.07,Default,,0,0,0,,«Ай сайынғы жаңа типте» серияланған «Ібіліс жұмбағы» түпнұсқа туындысы ➡
Dialogue: 0,0:29:09.07,0:29:11.44,Default,,0,0,0,,Сіз комикстердің қазір сатылымда екенін білесіз бе?
Dialogue: 0,0:29:11.44,0:29:15.03,Default,,0,0,0,,Түпнұсқа оқиға: Юн Такагава Суретте: Джун Минаката дуэті➡
Dialogue: 0,0:29:15.03,0:29:17.51,Default,,0,0,0,,Ассасин қыздардың жарқын бейнесі➡
Dialogue: 0,0:29:17.51,0:29:20.85,Default,,0,0,0,,Бұл мектептегі жауынгерлік корольдік экшн ойыны. Токаку-сан күткендей!
Dialogue: 0,0:29:20.85,0:29:23.20,Default,,0,0,0,,2 томда сол адам және сол адам➡
Dialogue: 0,0:29:23.20,0:29:25.27,Default,,0,0,0,,Харуға шабуыл жасау!
Dialogue: 0,0:29:25.27,0:29:28.44,Default,,0,0,0,,«Ібілістің жұмбақтары» Түпнұсқа комикстердің 1 және 2 томдары ➡
Dialogue: 0,0:29:28.44,0:29:30.44,Default,,0,0,0,,Мен Изуку Мидориямын!
Dialogue: 0,0:29:31.94,0:29:37.94,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory