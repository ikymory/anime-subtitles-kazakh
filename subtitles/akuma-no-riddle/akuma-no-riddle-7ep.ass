Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:34.22,0:01:38.81,Default,,0,0,0,,♬～
Dialogue: 0,0:01:38.81,0:01:40.84,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:40.84,0:01:46.95,Default,,0,0,0,,♬～
Dialogue: 0,0:01:46.95,0:01:49.15,Default,,0,0,0,,Ммм... Мм...
Dialogue: 0,0:01:49.15,0:01:53.62,Default,,0,0,0,,♬～
Dialogue: 0,0:01:53.62,0:01:56.21,Default,,0,0,0,,Бұл күн тағы да келген сияқты
Dialogue: 0,0:01:56.21,0:02:00.65,Default,,0,0,0,,♬～
Dialogue: 0,0:02:00.65,0:02:03.15,Default,,0,0,0,,Қанша рет...
Dialogue: 0,0:02:04.58,0:02:06.85,Default,,0,0,0,,♬ Кері санауға дайынсыз ба
Dialogue: 0,0:02:06.85,0:02:09.04,Default,,0,0,0,,♬ Жүгіруге жол жоқ
Dialogue: 0,0:02:09.04,0:02:18.15,Default,,0,0,0,,♬～
Dialogue: 0,0:02:18.15,0:02:22.80,Default,,0,0,0,,♬ Оңай диапазонға түспеңіз.
Dialogue: 0,0:02:22.80,0:02:27.71,Default,,0,0,0,,♬ Бұл қырғи-қабақ соғыс аймағы. Қазіргі жағдай жалықтырады.
Dialogue: 0,0:02:27.71,0:02:32.33,Default,,0,0,0,,♬ Ей, балалар, сондықтан сен ерекше екенсің.
Dialogue: 0,0:02:32.33,0:02:34.35,Default,,0,0,0,,♬ Баяғыда сыйымдылық асып кеткен
Dialogue: 0,0:02:34.35,0:02:36.68,Default,,0,0,0,,♬ Өзін-өзі мазақ ету түбі жоқ сезім
Dialogue: 0,0:02:36.68,0:02:38.72,Default,,0,0,0,,♬ Өте сүйкімді
Dialogue: 0,0:02:38.72,0:02:41.64,Default,,0,0,0,,♬ Мен саған ақымақтығымды көрсете алмаймын.
Dialogue: 0,0:02:41.64,0:02:43.67,Default,,0,0,0,,♬ Бекер толқу
Dialogue: 0,0:02:43.67,0:02:45.67,Default,,0,0,0,,♬ Тек ынталандыру үшін
Dialogue: 0,0:02:47.09,0:02:49.71,Default,,0,0,0,,♬ Қабылдау/Көтеріліс Тек екі таңдау бар ма?
Dialogue: 0,0:02:49.71,0:02:53.38,Default,,0,0,0,,♬ ah Эстетика «Мен ешкімге тиіспеймін»
Dialogue: 0,0:02:53.38,0:02:55.48,Default,,0,0,0,,♬ Жараның кінәсіздігі
Dialogue: 0,0:02:55.48,0:02:58.09,Default,,0,0,0,,♬ Мен де сол топқа кіремін.
Dialogue: 0,0:02:58.09,0:03:00.12,Default,,0,0,0,,♬ орылатын болады
Dialogue: 0,0:03:00.12,0:03:02.69,Default,,0,0,0,,♬ Ешбір жағдайда әрқашан жалғасуда
Dialogue: 0,0:03:02.69,0:03:06.68,Default,,0,0,0,,♬ Белдемшенің етегі туралы шындық
Dialogue: 0,0:03:06.68,0:03:11.72,Default,,0,0,0,,♬ Тек ақымақ сияқты сеніңіз
Dialogue: 0,0:03:11.72,0:03:16.14,Default,,0,0,0,,♬ Маған қатты әсер етті
Dialogue: 0,0:03:16.14,0:03:22.74,Default,,0,0,0,,♬ Оны твиттер арқылы жазыңыз.
Dialogue: 0,0:03:22.74,0:03:32.24,Default,,0,0,0,,♬～
Dialogue: 0,0:03:45.15,0:03:49.34,Default,,0,0,0,,Иә~ Мерейтойлық фестиваль сәтті аяқталды! ➡
Dialogue: 0,0:03:49.34,0:03:52.39,Default,,0,0,0,,Біздің қара топтың ойыны да үлкен жетістік болды! ➡
Dialogue: 0,0:03:52.39,0:03:55.58,Default,,0,0,0,,Соңында мұғалім де жылады.➡
Dialogue: 0,0:03:55.58,0:03:58.38,Default,,0,0,0,,Бірақ бірақ! Киригая табыт➡
Dialogue: 0,0:03:58.38,0:04:01.15,Default,,0,0,0,,Сенсоку Наматаме Кенмочиена…｡➡
Dialogue: 0,0:04:01.15,0:04:04.34,Default,,0,0,0,,Үшеуі кенеттен мектептерді де ауыстырды.➡
Dialogue: 0,0:04:04.34,0:04:06.70,Default,,0,0,0,,Бірақ бәріңіздің көңіл-күйіңізді көтеріңіз.
Dialogue: 0,0:04:06.70,0:04:09.37,Default,,0,0,0,,Мен де ұстазымды сағындым.
Dialogue: 0,0:04:09.37,0:04:13.09,Default,,0,0,0,,Қалған жеті адаммен барымызды салайық!
Dialogue: 0,0:04:13.09,0:04:16.21,Default,,0,0,0,,[ｽﾋﾟｰｶ] ｷｰﾝ ｺｰﾝ ｶｰﾝ ｺｰﾝ(ﾁｬｲﾑ)
Dialogue: 0,0:04:16.21,0:04:20.57,Default,,0,0,0,,Доктор Мизороки, сіздің жағдайыңыз әдеттегідей жақсы деп үміттенемін.
Dialogue: 0,0:04:20.57,0:04:24.49,Default,,0,0,0,,Жалқаулық деген жиіркенішті.
Dialogue: 0,0:04:24.49,0:04:26.74,Default,,0,0,0,,Жарайды, өйткені оның мінезі сондай➡
Dialogue: 0,0:04:26.74,0:04:29.74,Default,,0,0,0,,Сонымен, сіз Қара сыныптың мұғалімі болып сайландыңыз.
Dialogue: 0,0:04:31.11,0:04:33.21,Default,,0,0,0,,Жарайды, Токаку-сан.
Dialogue: 0,0:04:33.21,0:04:37.04,Default,,0,0,0,,Ұстаз айтқандай, ерінбей еңбек етсең, болашағың жолың ашылады!
Dialogue: 0,0:04:37.04,0:04:39.27,Default,,0,0,0,,Босқа позитивті болмаңыз.➡
Dialogue: 0,0:04:39.27,0:04:42.27,Default,,0,0,0,,Мен сенің мұрныңды сындырдым.
Dialogue: 0,0:04:43.64,0:04:47.70,Default,,0,0,0,,Жоқ, бұл қорқынышты. (Рё) Жарайсыңдар, балалар➡
Dialogue: 0,0:04:47.70,0:04:52.25,Default,,0,0,0,,Босқа ұрыспас. Оның орнына осында қалыңыз➡
Dialogue: 0,0:04:52.25,0:04:55.15,Default,,0,0,0,,Демалыс сәті ше?
Dialogue: 0,0:04:55.15,0:04:57.17,Default,,0,0,0,,Демалу?
Dialogue: 0,0:04:57.17,0:05:00.49,Default,,0,0,0,,Дұрыс. Мен қызықты нәрсе таптым.➡
Dialogue: 0,0:05:00.49,0:05:04.53,Default,,0,0,0,,Барлығымыз сабақтан кейін барып тамашалайық па?
Dialogue: 0,0:05:04.53,0:05:08.28,Default,,0,0,0,,[Спикер] Keen Corn Keen Corn
Dialogue: 0,0:05:08.28,0:05:10.37,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,0:05:10.37,0:05:14.72,Default,,0,0,0,,Миоджо Гакуен күткендей, осындай нәрсе...
Dialogue: 0,0:05:14.72,0:05:18.43,Default,,0,0,0,,Сабақтар үшін пайдаланылатын бөлек пул бар.
Dialogue: 0,0:05:18.43,0:05:22.48,Default,,0,0,0,,Мен мұғалімнен Қара тобын маған қалдыруын өтіндім.➡
Dialogue: 0,0:05:22.48,0:05:25.62,Default,,0,0,0,,Барлығымыз өзімізден ләззат алайық
Dialogue: 0,0:05:25.62,0:05:28.42,Default,,0,0,0,,Суға шомылу костюмдері де бар.
Dialogue: 0,0:05:28.42,0:05:30.62,Default,,0,0,0,,Рахмет, Шуто-сан.
Dialogue: 0,0:05:30.62,0:05:33.14,Default,,0,0,0,,Токаку-сан, тез киімімізді ауыстырып, суға түсейік.
Dialogue: 0,0:05:33.14,0:05:37.06,Default,,0,0,0,,А, сәл күте тұрыңыз. Ихиноза!
Dialogue: 0,0:05:37.06,0:05:40.10,Default,,0,0,0,,Сонымен, біз де киім ауыстырамыз делік.
Dialogue: 0,0:05:40.10,0:05:44.17,Default,,0,0,0,,♬～
Dialogue: 0,0:05:44.17,0:05:46.44,Default,,0,0,0,,Мектеп суы…
Dialogue: 0,0:05:46.44,0:05:49.32,Default,,0,0,0,,Бұл сіз дайындаған купальник пе?
Dialogue: 0,0:05:49.32,0:05:53.18,Default,,0,0,0,,Мүмкін емес. Сіз қартайған кезде осындай киім кие аласыз ба?
Dialogue: 0,0:05:53.18,0:05:55.68,Default,,0,0,0,,Мектеп ұсынған купальник ұнамаса➡
Dialogue: 0,0:05:55.68,0:05:58.08,Default,,0,0,0,,Бізде басқа да көптеген заттар бар➡
Dialogue: 0,0:05:58.08,0:06:00.15,Default,,0,0,0,,Сіз өзіңізге ұнайтын нәрсені таңдай аласыз.
Dialogue: 0,0:06:00.15,0:06:03.09,Default,,0,0,0,,Сіз суға түсуді жоспарлап отырсыз ба?
Dialogue: 0,0:06:03.09,0:06:06.42,Default,,0,0,0,,Мен құлдық стилін шештім!
Dialogue: 0,0:06:06.42,0:06:09.04,Default,,0,0,0,,Содан кейін мен осы жерді басыңыз.
Dialogue: 0,0:06:09.04,0:06:12.68,Default,,0,0,0,,Хару осындай кәдімгі нәрсе киіп көргісі келді~
Dialogue: 0,0:06:12.68,0:06:14.95,Default,,0,0,0,,Токаку-сан ше?
Dialogue: 0,0:06:14.95,0:06:18.50,Default,,0,0,0,,Иә? О, бұл сондай батыл.
Dialogue: 0,0:06:18.50,0:06:20.56,Default,,0,0,0,,Кейбіреулері де болуы мүмкін!
Dialogue: 0,0:06:20.56,0:06:23.96,Default,,0,0,0,,Азума-сан соншалықты сүйкімді ме?
Dialogue: 0,0:06:23.96,0:06:26.04,Default,,0,0,0,,Теріні тым көп ашу
Dialogue: 0,0:06:26.04,0:06:28.84,Default,,0,0,0,,Төтенше жағдайда денені қорғай алмау
Dialogue: 0,0:06:31.05,0:06:33.77,Default,,0,0,0,,Жылжытуға оңай спорттық купальниктердің маңызы зор
Dialogue: 0,0:06:33.77,0:06:36.62,Default,,0,0,0,,Ах. иә?
Dialogue: 0,0:06:36.62,0:06:38.89,Default,,0,0,0,,Ойын ба?
Dialogue: 0,0:06:38.89,0:06:42.18,Default,,0,0,0,,Ха! Не істеу керек!?
Dialogue: 0,0:06:42.18,0:06:45.05,Default,,0,0,0,,Дүрбелеңге салынбаңыз. Егер сіз оны күшпен алып тастағыңыз келсе➡
Dialogue: 0,0:06:45.05,0:06:47.53,Default,,0,0,0,,Ол жарылып кетеді. Бомба!?
Dialogue: 0,0:06:47.53,0:06:50.42,Default,,0,0,0,,Дұрыс. Атыс күші әлсіз болса да ➡
Dialogue: 0,0:06:50.42,0:06:55.44,Default,,0,0,0,,Мойынға жабысып жарылып кетсе, лезде өлімге әкелетіні анық.➡
Dialogue: 0,0:06:55.44,0:06:58.24,Default,,0,0,0,,Мен өз күшіме сенімді емеспін➡
Dialogue: 0,0:06:58.24,0:07:01.01,Default,,0,0,0,,Барлығы ойын ойнау туралы.➡
Dialogue: 0,0:07:01.01,0:07:04.18,Default,,0,0,0,,Бомбаның уақыты - бүгін түн ортасы.➡
Dialogue: 0,0:07:04.18,0:07:07.12,Default,,0,0,0,,Егер одан кейін бас тарту мүмкін болмаса➡
Dialogue: 0,0:07:07.12,0:07:10.15,Default,,0,0,0,,Мен жеңдім. Өзіңізді мазақ етпеңіз!
Dialogue: 0,0:07:10.15,0:07:13.51,Default,,0,0,0,,Мені өлтірсең де, жарылыстан құтыла алмайсың, солай ма? ➡
Dialogue: 0,0:07:13.51,0:07:16.98,Default,,0,0,0,,Детонаторды босатудың бір ғана жолы бар.➡
Dialogue: 0,0:07:16.98,0:07:20.85,Default,,0,0,0,,Жай ғана 4 таңбалы құпия сөзді енгізіңіз.➡
Dialogue: 0,0:07:20.85,0:07:24.62,Default,,0,0,0,,Дегенмен, сіз тек 3 рет әрекет жасай аласыз.➡
Dialogue: 0,0:07:24.62,0:07:28.36,Default,,0,0,0,,3 рет қателессеңіз, бум.
Dialogue: 0,0:07:28.36,0:07:30.42,Default,,0,0,0,,Маған құпия сөзді айт!
Dialogue: 0,0:07:30.42,0:07:33.81,Default,,0,0,0,,Хохо, оны табу ойын.➡
Dialogue: 0,0:07:33.81,0:07:36.88,Default,,0,0,0,,Құпия сөз нөмірлеріне сәйкес келетін төрт карта ➡
Dialogue: 0,0:07:36.88,0:07:39.48,Default,,0,0,0,,Бұл бассейнде жасырылған.➡
Dialogue: 0,0:07:39.48,0:07:42.37,Default,,0,0,0,,Оны тапсаң, төрт санды білесің.➡
Dialogue: 0,0:07:42.37,0:07:46.89,Default,,0,0,0,,Жасыратын жер туралы анықтама хабарлама қағазына қоса берілген.
Dialogue: 0,0:07:46.89,0:07:55.60,Default,,0,0,0,,♬～
Dialogue: 0,0:07:55.60,0:07:59.39,Default,,0,0,0,,Хехехе, сен сол жұмбақты шеше аласың ба? ➡
Dialogue: 0,0:07:59.39,0:08:03.09,Default,,0,0,0,,Кәне, бәріміз ойыннан ләззат алайық!
Dialogue: 0,0:08:04.73,0:08:07.08,Default,,0,0,0,,Жарайды, уайымдама.
Dialogue: 0,0:08:07.08,0:08:09.58,Default,,0,0,0,,Детонаторды өшіру керек.
Dialogue: 0,0:08:09.58,0:08:14.05,Default,,0,0,0,,Токаку-сан… «Бір сурет орманда».
Dialogue: 0,0:08:14.05,0:08:16.75,Default,,0,0,0,,Бұл орман ма? Сіз оны осылай атай аласыз деп ойлаймын➡
Dialogue: 0,0:08:16.75,0:08:20.58,Default,,0,0,0,,Тек сонда. Біреуі суда...
Dialogue: 0,0:08:20.58,0:08:23.16,Default,,0,0,0,,Бұл оның бассейнде екенін білдіре ме?
Dialogue: 0,0:08:23.16,0:08:28.18,Default,,0,0,0,,Жағасы су өткізбейтін. Суға секіру жақсы.
Dialogue: 0,0:08:28.18,0:08:32.32,Default,,0,0,0,,Алайда ол жарылғанда суда ма бәрібір➡
Dialogue: 0,0:08:32.32,0:08:35.12,Default,,0,0,0,,Ол жарылып кетеді. Хохохохо!
Dialogue: 0,0:08:36.56,0:08:39.14,Default,,0,0,0,,Тіпті жай ғана ескерту билеті➡
Dialogue: 0,0:08:39.14,0:08:41.91,Default,,0,0,0,,Қастандық жасау ережелері ойын сияқты➡
Dialogue: 0,0:08:41.91,0:08:44.62,Default,,0,0,0,,Бұл шынымен де бұл жолы жай ойын ба?
Dialogue: 0,0:08:44.62,0:08:48.05,Default,,0,0,0,,Жарайды, қанды шайқастардан жалықтым➡
Dialogue: 0,0:08:48.05,0:08:50.62,Default,,0,0,0,,Анда-санда осындай нәрсені жасау жақсы.
Dialogue: 0,0:08:50.62,0:08:55.24,Default,,0,0,0,,Эй, қара топтың ұйымдастырушысы Харуды шынымен өлтіргісі келе ме?
Dialogue: 0,0:08:55.24,0:08:57.70,Default,,0,0,0,,Сіз бірдеңе білесіз, солай ма?
Dialogue: 0,0:08:57.70,0:09:01.08,Default,,0,0,0,,Келіңіздер ме? Бұл туралы не ойлайсыз?
Dialogue: 0,0:09:01.08,0:09:04.55,Default,,0,0,0,,Ол шынымен де бірдеңені сынап жатқан жоқ па?
Dialogue: 0,0:09:04.55,0:09:07.57,Default,,0,0,0,,Сіздің нақты мақсатыңыз қандай?
Dialogue: 0,0:09:07.57,0:09:11.14,Default,,0,0,0,,Үнін жауып, қарап тұрған дұрыс па? ➡
Dialogue: 0,0:09:11.14,0:09:13.31,Default,,0,0,0,,Егер Хару-чан осылай өлсе➡
Dialogue: 0,0:09:13.31,0:09:15.68,Default,,0,0,0,,Ойын осымен аяқталады, солай ма?
Dialogue: 0,0:09:15.68,0:09:17.78,Default,,0,0,0,,Егер мұның соңы болса, онда ➡
Dialogue: 0,0:09:17.78,0:09:21.67,Default,,0,0,0,,Сонымен, бұл жай ғана осындай ойын болды.
Dialogue: 0,0:09:21.67,0:09:25.99,Default,,0,0,0,,Келіңіздер, осында қарап көрейік.
Dialogue: 0,0:09:25.99,0:09:28.99,Default,,0,0,0,,Бамба мырза, егер қаласаңыз.
Dialogue: 0,0:09:28.99,0:09:31.06,Default,,0,0,0,,Иә... Гато...
Dialogue: 0,0:09:31.06,0:09:34.25,Default,,0,0,0,,Бұл жақсы. Бұл курорт сияқты.
Dialogue: 0,0:09:34.25,0:09:37.54,Default,,0,0,0,,Біз де аздап қарбызды бөліп алайық па?
Dialogue: 0,0:09:37.54,0:09:41.44,Default,,0,0,0,,Дәл осы жерде жақсы қарбыз бар.
Dialogue: 0,0:09:41.44,0:09:45.33,Default,,0,0,0,,О, бұл тамаша. Қарбыз өлтірушілерге қарсы жарылады ма?
Dialogue: 0,0:09:45.33,0:09:48.93,Default,,0,0,0,,Кез келген қаруды қолдануға болады деп айтуға бола ма?
Dialogue: 0,0:09:51.00,0:09:53.05,Default,,0,0,0,,Жоқ, бұл қауіпті.
Dialogue: 0,0:09:53.05,0:09:55.95,Default,,0,0,0,,Сіз мені көзін байлап атып өлтіруді жоспарлап отырсыз ба?
Dialogue: 0,0:09:55.95,0:09:58.06,Default,,0,0,0,,Башан!
Dialogue: 0,0:09:58.06,0:10:02.24,Default,,0,0,0,,♬～
Dialogue: 0,0:10:02.24,0:10:04.30,Default,,0,0,0,,Уайымдаудың қажеті жоқ.➡
Dialogue: 0,0:10:04.30,0:10:07.28,Default,,0,0,0,,"Оңға көбірек. Аа, сіз тым алыс кетіп қалдыңыз. Солға біраз" ➡\NСіз маған
Dialogue: 0,0:10:07.28,0:10:10.79,Default,,0,0,0,,сияқты нәрселерді айтпасаңыз да, бұл 100-100, солай емес пе?
Dialogue: 0,0:10:10.79,0:10:13.24,Default,,0,0,0,,Бұл қарбызды жару деп аталмайды! ➡
Dialogue: 0,0:10:13.24,0:10:15.94,Default,,0,0,0,,Қарбыз Бұл ағаш кесінді! Ах
Dialogue: 0,0:10:17.61,0:10:19.86,Default,,0,0,0,,Не болды? Токаку-сан
Dialogue: 0,0:10:19.86,0:10:23.91,Default,,0,0,0,,«Қараңғыда дауыс жол көрсетеді» ➡ дегенді білдіреді
Dialogue: 0,0:10:23.91,0:10:27.15,Default,,0,0,0,,Қарбыздың бөлінуі туралы айтасыз ба? иә?
Dialogue: 0,0:10:27.15,0:10:29.27,Default,,0,0,0,,♬～
Dialogue: 0,0:10:29.27,0:10:31.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:31.37,0:10:36.19,Default,,0,0,0,,♬～
Dialogue: 0,0:10:36.19,0:10:39.08,Default,,0,0,0,,Мен біреуін таптым. Ах...
Dialogue: 0,0:10:39.08,0:10:42.05,Default,,0,0,0,,Гауһар тастың жетілігі
Dialogue: 0,0:10:42.05,0:10:46.75,Default,,0,0,0,,Уау, бұл керемет! таңқаларлық! Токаку-сан күткендей!
Dialogue: 0,0:10:46.75,0:10:51.04,Default,,0,0,0,,Хехехе. Бірақ мен болсам оңай болар еді➡
Dialogue: 0,0:10:51.04,0:10:54.06,Default,,0,0,0,,Мен төртеуін қатар таптым.
Dialogue: 0,0:10:54.06,0:10:56.65,Default,,0,0,0,,Қалған үшеуін таптың ба?
Dialogue: 0,0:10:56.65,0:11:00.72,Default,,0,0,0,,Әрине. Бұл тым қарапайым сұрақ.
Dialogue: 0,0:11:00.72,0:11:03.75,Default,,0,0,0,,Карта ойнау… қалғаны…｡ О ➡
Dialogue: 0,0:11:03.75,0:11:07.48,Default,,0,0,0,,Бамба мырза да түсінді. Күткендей.
Dialogue: 0,0:11:07.48,0:11:10.11,Default,,0,0,0,,Трамп? демалыс?
Dialogue: 0,0:11:10.11,0:11:13.98,Default,,0,0,0,,Ах. Эй, байқадың ба?
Dialogue: 0,0:11:13.98,0:11:16.98,Default,,0,0,0,,Осы жерден төрт карта шығарылса➡
Dialogue: 0,0:11:16.98,0:11:19.20,Default,,0,0,0,,Жасырылған төрт бөлікті таппасаңыз да➡
Dialogue: 0,0:11:19.20,0:11:21.26,Default,,0,0,0,,Қай карталар жоқ екенін қараңыз➡
Dialogue: 0,0:11:21.26,0:11:25.31,Default,,0,0,0,,Мен төрт санды түсінемін. (Тайвань) Түсіндім! Мүлдем басқа идея!
Dialogue: 0,0:11:25.31,0:11:28.65,Default,,0,0,0,,♬～
Dialogue: 0,0:11:28.65,0:11:30.68,Default,,0,0,0,,Төрт 7с
Dialogue: 0,0:11:30.68,0:11:33.40,Default,,0,0,0,,Құпия сөз 7777 ма?
Dialogue: 0,0:11:33.40,0:11:36.24,Default,,0,0,0,,Бұл құпия сөздерде қолдануға болмайтын сандар➡
Dialogue: 0,0:11:36.24,0:11:39.24,Default,,0,0,0,,Бұл үштікке кіретін комбинация емес пе?
Dialogue: 0,0:11:39.24,0:11:42.64,Default,,0,0,0,,♬～
Dialogue: 0,0:11:42.64,0:11:45.65,Default,,0,0,0,,Енді не істейміз?
Dialogue: 0,0:11:45.65,0:11:48.45,Default,,0,0,0,,Хару, кел. Ах...
Dialogue: 0,0:11:50.32,0:11:52.35,Default,,0,0,0,,Иә
Dialogue: 0,0:11:52.35,0:11:56.32,Default,,0,0,0,,♬～
Dialogue: 0,0:11:56.32,0:11:58.32,Default,,0,0,0,,(Изуку) U.A. орта мектебі, 1-курс A және B сыныптары—
Dialogue: 0,0:12:00.48,0:12:02.88,Default,,0,0,0,,Дыбыстық сигнал сигналы
Dialogue: 0,0:12:04.85,0:12:07.22,Default,,0,0,0,,<Қабылдау хатын алғаннан кейінгі кеш>
Dialogue: 0,0:12:07.22,0:12:09.25,Default,,0,0,0,,Ха!
Dialogue: 0,0:12:09.25,0:12:11.77,Default,,0,0,0,,Қандай ұят! ➡
Dialogue: 0,0:12:11.77,0:12:15.91,Default,,0,0,0,,Бұл ойын картасы әу бастан муляж ретінде дайындалған.
Dialogue: 0,0:12:15.91,0:12:18.36,Default,,0,0,0,,Сіз бір құнды уақытты босқа өткіздіңіз.
Dialogue: 0,0:12:18.36,0:12:21.75,Default,,0,0,0,,Енді сізде тек екі әрекет бар.
Dialogue: 0,0:12:21.75,0:12:24.30,Default,,0,0,0,,Уф... Қарғыс атсын!
Dialogue: 0,0:12:24.30,0:12:29.09,Default,,0,0,0,,♬～
Dialogue: 0,0:12:29.09,0:12:31.73,Default,,0,0,0,,≪Енді ауысатын студенттерді енгізбей-ақ қояйық➡
Dialogue: 0,0:12:31.73,0:12:34.63,Default,,0,0,0,,Біз оқушыларымызға қамқорлық жасауымыз керек≫
Dialogue: 0,0:12:34.63,0:12:37.41,Default,,0,0,0,,≪Ах...｡ Ихиноза және Азума➡
Dialogue: 0,0:12:37.41,0:12:39.82,Default,,0,0,0,,Сіздің отбасыңыз жоқ па≫
Dialogue: 0,0:12:39.82,0:12:42.90,Default,,0,0,0,,≪Олардың алдында жылы отбасының әңгімесі➡
Dialogue: 0,0:12:42.90,0:12:45.49,Default,,0,0,0,,Оны тыйымға айналдырған дұрыс≫
Dialogue: 0,0:12:45.49,0:12:47.98,Default,,0,0,0,,А, бұл...
Dialogue: 0,0:12:47.98,0:12:55.08,Default,,0,0,0,,♬～
Dialogue: 0,0:15:01.63,0:15:03.74,Default,,0,0,0,,Күн батып бара жатыр
Dialogue: 0,0:15:03.74,0:15:07.92,Default,,0,0,0,,Бұл менің кезегім жақындап қалды дегенді білдіре ме?
Dialogue: 0,0:15:07.92,0:15:10.58,Default,,0,0,0,,Сыртқа шықсаң да, іс жоқ.
Dialogue: 0,0:15:10.58,0:15:14.76,Default,,0,0,0,,Дәлірек айтсақ, мектептегі купальник бейнесі сол кейіпкерге толық сәйкес келмейді ме?
Dialogue: 0,0:15:14.76,0:15:17.59,Default,,0,0,0,,Аузыңды жап! Мектеп суында жүзу➡
Dialogue: 0,0:15:17.59,0:15:20.96,Default,,0,0,0,,Бұл түскі түс болатын. Барайық! ➡
Dialogue: 0,0:15:20.96,0:15:23.26,Default,,0,0,0,,Киеееее! Хехе!
Dialogue: 0,0:15:24.77,0:15:28.32,Default,,0,0,0,,Мен оны дайындауға бар күшімді салдым. Сен жақсы жүрсің.
Dialogue: 0,0:15:28.32,0:15:32.76,Default,,0,0,0,,0:00 уақыт шегіне дейін әлі көп уақыт бар.➡
Dialogue: 0,0:15:32.76,0:15:35.19,Default,,0,0,0,,Әркім одан көбірек ләззат алуы керек.
Dialogue: 0,0:15:35.19,0:15:37.89,Default,,0,0,0,,Түнгі ойынға арналған жарықтандыру да бар!
Dialogue: 0,0:15:40.91,0:15:44.41,Default,,0,0,0,,«Жарықта, ол көру үшін тым жарық болмай тұрып»…
Dialogue: 0,0:15:46.05,0:15:48.71,Default,,0,0,0,,Бір жерде ме?
Dialogue: 0,0:15:48.71,0:15:50.76,Default,,0,0,0,,Токаку-сан, солай!
Dialogue: 0,0:15:50.76,0:15:53.81,Default,,0,0,0,,♬～
Dialogue: 0,0:15:53.81,0:15:55.81,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:57.65,0:15:59.65,Default,,0,0,0,,Парин!
Dialogue: 0,0:16:01.99,0:16:04.02,Default,,0,0,0,,Екінші бет
Dialogue: 0,0:16:04.02,0:16:06.19,Default,,0,0,0,,Ах. Джокер?
Dialogue: 0,0:16:06.19,0:16:10.69,Default,,0,0,0,,Мен айтуды ұмытып кетіппін. Джокер - 0 санының орнына.
Dialogue: 0,0:16:13.41,0:16:15.68,Default,,0,0,0,,7 және 0
Dialogue: 0,0:16:15.68,0:16:20.18,Default,,0,0,0,,Іс жақсы жүріп жатыр. Тек екі бөлік қалды.
Dialogue: 0,0:16:22.49,0:16:26.34,Default,,0,0,0,,Қадам...(аяқ дыбысы)
Dialogue: 0,0:16:26.34,0:16:38.81,Default,,0,0,0,,♬～
Dialogue: 0,0:16:38.81,0:16:43.14,Default,,0,0,0,,«Біреуі орманда, жасырынуға тамаша орын».
Dialogue: 0,0:16:43.14,0:16:48.02,Default,,0,0,0,,«Бір бөлік маңызды нәрсенің орнына суда».
Dialogue: 0,0:16:48.02,0:16:52.29,Default,,0,0,0,,Қалғаны орманда және суда ма?
Dialogue: 0,0:16:52.29,0:16:55.84,Default,,0,0,0,,Оңтайлы деген не? Аа, егер сіз жапырақтарды жасырғыңыз келсе➡
Dialogue: 0,0:16:55.84,0:16:59.09,Default,,0,0,0,,«Орманда» жиі аталады, солай емес пе? О
Dialogue: 0,0:16:59.09,0:17:01.95,Default,,0,0,0,,Бірақ мен қазір іздеп жүргенім ойын картасы.
Dialogue: 0,0:17:01.95,0:17:03.95,Default,,0,0,0,,Коноха...
Dialogue: 0,0:17:03.95,0:17:06.15,Default,,0,0,0,,А... Токаку-сан?
Dialogue: 0,0:17:08.04,0:17:11.61,Default,,0,0,0,,Не болды? Сіз бұл картаны бұрын көрдіңіз бе?
Dialogue: 0,0:17:11.61,0:17:13.66,Default,,0,0,0,,Мен бұл манекен деп айттым.
Dialogue: 0,0:17:13.66,0:17:17.03,Default,,0,0,0,,♬～
Dialogue: 0,0:17:17.03,0:17:19.53,Default,,0,0,0,,Міне! Хехехе
Dialogue: 0,0:17:21.47,0:17:24.94,Default,,0,0,0,,Бір күрек. (Рё) Бұл тамаша.
Dialogue: 0,0:17:24.94,0:17:27.87,Default,,0,0,0,,Қалған бөлік суда
Dialogue: 0,0:17:27.87,0:17:30.76,Default,,0,0,0,,Маңызды нәрсеге айырбастау
Dialogue: 0,0:17:30.76,0:17:33.29,Default,,0,0,0,,Қалғандар да дәл қазір барын салып еңбек етіп жатқан болар.
Dialogue: 0,0:17:33.29,0:17:35.31,Default,,0,0,0,,Пан!
Dialogue: 0,0:17:35.31,0:17:38.91,Default,,0,0,0,,Ах, Ичиноза! Әй, жарылып кете ме?
Dialogue: 0,0:17:40.35,0:17:43.09,Default,,0,0,0,,Туған күнің құтты болсын Шуто!
Dialogue: 0,0:17:43.09,0:17:46.41,Default,,0,0,0,,Туған күн? (Мизороги) Неге үндемедің?➡
Dialogue: 0,0:17:46.41,0:17:49.49,Default,,0,0,0,,Маған айтсаң, мен бірдеңе дайындаған болар едім.
Dialogue: 0,0:17:49.49,0:17:52.71,Default,,0,0,0,,Әзірге менің қолымнан келетіні –➡
Dialogue: 0,0:17:52.71,0:17:54.75,Default,,0,0,0,,Бұл мен істей алатын ең жақсы нәрсе
Dialogue: 0,0:17:54.75,0:17:58.72,Default,,0,0,0,,Мұғалім: Бұл жерде ер адамдарға рұқсат етілмейді. Апыр-ай!
Dialogue: 0,0:17:58.72,0:18:02.42,Default,,0,0,0,,Жоқ, сенің туған күнің болғандықтан қарауға келдің ғой, солай ма?
Dialogue: 0,0:18:02.42,0:18:04.46,Default,,0,0,0,,Сіз жассыз, сэр.
Dialogue: 0,0:18:04.46,0:18:07.51,Default,,0,0,0,,Ба... ақымақ! Балалар сендер не туралы айтып тұрсыңдар?
Dialogue: 0,0:18:07.51,0:18:11.62,Default,,0,0,0,,Жарайды, жоғалып кет. Сіз эротикалық мұғалім!
Dialogue: 0,0:18:11.62,0:18:15.52,Default,,0,0,0,,Ба... Банба? Не болды? Бұл дөрекі тіл.➡
Dialogue: 0,0:18:15.52,0:18:18.27,Default,,0,0,0,,Уау! Бір минут күтіңіз! Ұстаз – барлығы да➡
Dialogue: 0,0:18:18.27,0:18:22.23,Default,,0,0,0,,Шудоның туған күнін тойлау...Бүгін оның туған күні еді, солай емес пе?
Dialogue: 0,0:18:22.23,0:18:25.01,Default,,0,0,0,,Құттықтаймыз.
Dialogue: 0,0:18:25.01,0:18:28.38,Default,,0,0,0,,Ах, егер қастандық сәтті болса, сауабы➡
Dialogue: 0,0:18:28.38,0:18:30.83,Default,,0,0,0,,Бұл жай ғана сыйлық.
Dialogue: 0,0:18:30.83,0:18:32.97,Default,,0,0,0,,Мен солай тілеймін.
Dialogue: 0,0:18:32.97,0:18:37.26,Default,,0,0,0,,Шуто мырзаның сыйақысы қандай? Мен оны әлі тексерген жоқпын
Dialogue: 0,0:18:37.26,0:18:39.93,Default,,0,0,0,,Менің қалағаным➡
Dialogue: 0,0:18:39.93,0:18:43.51,Default,,0,0,0,,Тек қартайып, қалыпты өл.
Dialogue: 0,0:18:43.51,0:18:46.12,Default,,0,0,0,,А... не айтып тұрсың?
Dialogue: 0,0:18:46.12,0:18:49.44,Default,,0,0,0,,Денем дертке шалдыққан.➡
Dialogue: 0,0:18:49.44,0:18:51.96,Default,,0,0,0,,Бұл физикалық қартаюды тудырмайтын ауру.
Dialogue: 0,0:18:51.96,0:18:56.49,Default,,0,0,0,,Мен бұл туралы естідім. Бұл Хайлендер синдромы екеніне сенімдімін.➡
Dialogue: 0,0:18:56.49,0:18:58.68,Default,,0,0,0,,Мен мәңгілікке соншалықты тығыз қала алатыныма сене алар емеспін➡
Dialogue: 0,0:18:58.68,0:19:02.62,Default,,0,0,0,,Ең жақсысы емес пе! (Рё) Сіз шынымен солай ойлайсыз ба?
Dialogue: 0,0:19:02.62,0:19:04.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:04.65,0:19:09.37,Default,,0,0,0,,Қартаймайтын жалғыз мен, Артымда мені бәрі тастап кетеді.➡
Dialogue: 0,0:19:09.37,0:19:12.91,Default,,0,0,0,,Бірде мен үшін маңызды адам болды.➡
Dialogue: 0,0:19:12.91,0:19:17.05,Default,,0,0,0,,Ол кісі менен бір жас кіші болатын.➡
Dialogue: 0,0:19:17.05,0:19:20.13,Default,,0,0,0,,Оның үстіне туған күндерінің айырмашылығы бір күн.➡
Dialogue: 0,0:19:20.13,0:19:22.52,Default,,0,0,0,,Жасыма жеткенше➡
Dialogue: 0,0:19:22.52,0:19:25.96,Default,,0,0,0,,Мен алдымен бір жас үлкен боламын.➡
Dialogue: 0,0:19:25.96,0:19:29.31,Default,,0,0,0,,Ол ешқашан бір жыл мәңгі болмайды, т.б.➡
Dialogue: 0,0:19:29.31,0:19:32.11,Default,,0,0,0,,Екеуміз бірге күлдік.➡
Dialogue: 0,0:19:32.11,0:19:37.48,Default,,0,0,0,,Қанша жаста болсам да, мен бұрынғыдай боламын.➡
Dialogue: 0,0:19:37.48,0:19:42.32,Default,,0,0,0,,Тек сол адам ғана менен асып, есейіп кетті.➡
Dialogue: 0,0:19:42.32,0:19:46.73,Default,,0,0,0,,Сосын менің алдымда кетіп қалды.
Dialogue: 0,0:19:46.73,0:19:49.81,Default,,0,0,0,,♬～
Dialogue: 0,0:19:49.81,0:19:52.65,Default,,0,0,0,,Сонымен, мен қалаймын➡
Dialogue: 0,0:19:52.65,0:19:56.15,Default,,0,0,0,,Қартайып өлу қалыпты жағдай.
Dialogue: 0,0:19:56.15,0:19:58.24,Default,,0,0,0,,Түсінді. Әлемнің түкпір-түкпірінен➡
Dialogue: 0,0:19:58.24,0:20:01.29,Default,,0,0,0,,Ең жақсы медициналық қызметкерлерден тұратын топ құрыңыз➡
Dialogue: 0,0:20:01.29,0:20:05.48,Default,,0,0,0,,Мен онымен айналысамын. (Рё) Танысқаныма қуаныштымын.
Dialogue: 0,0:20:05.48,0:20:07.51,Default,,0,0,0,,≪Mr. Шуто...≫
Dialogue: 0,0:20:07.51,0:20:10.97,Default,,0,0,0,,♬～
Dialogue: 0,0:20:10.97,0:20:14.77,Default,,0,0,0,,Аз ғана қалды. Сіз не күтіп тұрсыз? ➡
Dialogue: 0,0:20:14.77,0:20:17.74,Default,,0,0,0,,Тотокаку｡➡
Dialogue: 0,0:20:17.74,0:20:19.78,Default,,0,0,0,,Келесі жұмбақ.➡
Dialogue: 0,0:20:19.78,0:20:24.08,Default,,0,0,0,,Тез жауап бермесең, біреу сенен озып кетеді, солай ма?
Dialogue: 0,0:20:25.98,0:20:30.14,Default,,0,0,0,,[TEL] (Кіріс электрондық пошта/Үнсіз режим)
Dialogue: 0,0:20:30.14,0:20:35.09,Default,,0,0,0,,♬～
Dialogue: 0,0:20:35.09,0:20:37.29,Default,,0,0,0,,≪Бір бөлік суда...≫
Dialogue: 0,0:20:38.68,0:20:41.38,Default,,0,0,0,,≪Қайда? ≫
Dialogue: 0,0:20:41.38,0:20:44.35,Default,,0,0,0,,≪Суда...≫
Dialogue: 0,0:20:44.35,0:20:46.77,Default,,0,0,0,,≪Суда...≫
Dialogue: 0,0:20:46.77,0:20:49.39,Default,,0,0,0,,Бұл да суда ма?
Dialogue: 0,0:20:49.39,0:20:51.71,Default,,0,0,0,,Бұл су емес!
Dialogue: 0,0:20:51.71,0:20:54.19,Default,,0,0,0,,Уақыт шегі аяқталуға жақын!
Dialogue: 0,0:20:54.19,0:20:57.71,Default,,0,0,0,,Хару-чан, сенің алдыңда жарылып кете ме? Апыр-ай!
Dialogue: 0,0:20:57.71,0:21:01.32,Default,,0,0,0,,≪«Суда, маңызды нәрсенің орнына» не бар➡
Dialogue: 0,0:21:01.32,0:21:03.35,Default,,0,0,0,,Бұл нені білдіреді? ≫
Dialogue: 0,0:21:03.35,0:21:07.21,Default,,0,0,0,,♬～
Dialogue: 0,0:21:07.21,0:21:10.06,Default,,0,0,0,,≪Бұл соқыр жер болды! Сол түтіктің ішінде➡
Dialogue: 0,0:21:10.06,0:21:12.15,Default,,0,0,0,,Су ағып жатыр! ≫
Dialogue: 0,0:21:12.15,0:21:21.39,Default,,0,0,0,,♬～
Dialogue: 0,0:21:21.39,0:21:23.41,Default,,0,0,0,,Не!?
Dialogue: 0,0:21:23.41,0:21:31.32,Default,,0,0,0,,♬～
Dialogue: 0,0:21:31.32,0:21:33.35,Default,,0,0,0,,Токаку-сан!?
Dialogue: 0,0:21:33.35,0:21:35.39,Default,,0,0,0,,≪ Қарғыс атсын! ≫
Dialogue: 0,0:21:35.39,0:21:42.16,Default,,0,0,0,,♬～
Dialogue: 0,0:21:42.16,0:21:45.26,Default,,0,0,0,,≪Бұл карта кілті≫
Dialogue: 0,0:21:45.26,0:21:47.78,Default,,0,0,0,,<<Бұл ашылады ма? ≫
Dialogue: 0,0:21:47.78,0:21:49.78,Default,,0,0,0,,≪Төртінші карта? ≫
Dialogue: 0,0:21:51.75,0:21:53.75,Default,,0,0,0,,≪Ах...≫
Dialogue: 0,0:21:58.29,0:22:00.34,Default,,0,0,0,,≪Осыны қолдансаңыз көмектеседі➡
Dialogue: 0,0:22:00.34,0:22:02.93,Default,,0,0,0,,Оның орнына карта жоғалды≫
Dialogue: 0,0:22:02.93,0:22:06.18,Default,,0,0,0,,≪Бұл мен Ихиноза үшін өлетінімді білдіре ме? ≫
Dialogue: 0,0:22:06.18,0:22:09.52,Default,,0,0,0,,♬～
Dialogue: 0,0:22:09.52,0:22:13.12,Default,,0,0,0,,≪Ичиноза... Бұл төртінші карта! ≫
Dialogue: 0,0:22:13.12,0:22:31.01,Default,,0,0,0,,♬～
Dialogue: 0,0:22:31.01,0:22:33.59,Default,,0,0,0,,≪Жоқ... ихиноз жоқ≫
Dialogue: 0,0:22:33.59,0:22:44.29,Default,,0,0,0,,♬～
Dialogue: 0,0:22:48.96,0:22:50.98,Default,,0,0,0,,(Ақ) Адамнан тыс қабілеттері бар данышпан қыз
Dialogue: 0,0:22:50.98,0:22:53.93,Default,,0,0,0,,Токаку-сан, жақсысың ба!? Жарайды.
Dialogue: 0,0:22:53.93,0:22:57.33,Default,,0,0,0,,Бірақ соңғы карта жоғалып кетті. Уақытымыз таусылып жатыр.
Dialogue: 0,0:23:00.15,0:23:04.76,Default,,0,0,0,,Біз білетін үш сан бар. 7 0 1
Dialogue: 0,0:23:04.76,0:23:07.74,Default,,0,0,0,,Екіншісін тек болжауға болады.
Dialogue: 0,0:23:07.74,0:23:10.40,Default,,0,0,0,,Егер сіз тапсаңыз, қай комбинация➡
Dialogue: 0,0:23:10.40,0:23:13.37,Default,,0,0,0,,Сіз не енгізу керектігін білесіз бе?
Dialogue: 0,0:23:13.37,0:23:15.42,Default,,0,0,0,,Оны Исукеге қалдырыңыз! ➡
Dialogue: 0,0:23:15.42,0:23:18.82,Default,,0,0,0,,Исукенің бүгінгі бақытты саны - 9!
Dialogue: 0,0:23:20.22,0:23:22.22,Default,,0,0,0,,бірақ мен міндетті түрде Незуконы қайтадан адамға айналдырамын.
Dialogue: 0,0:23:24.23,0:23:27.88,Default,,0,0,0,,Бір ғана мүмкіндік қалды. Таңдануға уақыт жоқ.
Dialogue: 0,0:23:27.88,0:23:31.55,Default,,0,0,0,,0 7 1... Қалған сандар қандай?
Dialogue: 0,0:23:31.55,0:23:36.96,Default,,0,0,0,,♬～
Dialogue: 0,0:23:36.96,0:23:39.71,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:23:39.71,0:23:41.75,Default,,0,0,0,,Туған күн…
Dialogue: 0,0:23:41.75,0:23:43.75,Default,,0,0,0,,Бүгін 14 шілде
Dialogue: 0,0:23:45.58,0:23:48.29,Default,,0,0,0,,Құпия сөз 0 7 1 4 па?
Dialogue: 0,0:23:48.29,0:23:50.89,Default,,0,0,0,,Сіздің туған күніңіз сіздің құпия сөзіңіз➡
Dialogue: 0,0:23:50.89,0:23:53.54,Default,,0,0,0,,Қолданбау керек сандар: 1 саны
Dialogue: 0,0:23:53.54,0:23:57.21,Default,,0,0,0,,Басқа таңдау жоқ. Құмар ойнаудан басқа амалың жоқ.
Dialogue: 0,0:23:57.21,0:24:03.13,Default,,0,0,0,,♬～
Dialogue: 0,0:24:03.13,0:24:05.13,Default,,0,0,0,,Күте тұрыңыз, Токаку-сан!
Dialogue: 0,0:24:07.42,0:24:11.09,Default,,0,0,0,,((Бір кездері мен үшін маңызды біреу болды.➡
Dialogue: 0,0:24:11.09,0:24:13.89,Default,,0,0,0,,Туған күндер арасындағы айырмашылық бір күн))
Dialogue: 0,0:24:13.89,0:24:17.16,Default,,0,0,0,,Шуто мырзаның маңызды тұлғасының туған күні➡
Dialogue: 0,0:24:17.16,0:24:20.02,Default,,0,0,0,,15 күн, Шуто мырзадан 1 күн ерекше
Dialogue: 0,0:24:20.02,0:24:22.67,Default,,0,0,0,,Соңғы сан сөзсіз 4 емес...
Dialogue: 0,0:24:22.67,0:24:40.77,Default,,0,0,0,,♬～
Dialogue: 0,0:24:43.54,0:24:46.04,Default,,0,0,0,,♬～ (детонатордан шыққан музыка)
Dialogue: 0,0:24:47.41,0:24:50.23,Default,,0,0,0,,Уф...｡ Ах!
Dialogue: 0,0:24:50.23,0:24:52.23,Default,,0,0,0,,Токаку-сан!
Dialogue: 0,0:24:54.68,0:24:56.72,Default,,0,0,0,,Ихиноза…
Dialogue: 0,0:24:56.72,0:25:05.10,Default,,0,0,0,,♬～
Dialogue: 0,0:25:05.10,0:25:07.60,Default,,0,0,0,,Бұл адамның туған күні.
Dialogue: 0,0:25:09.85,0:25:13.25,Default,,0,0,0,,Хару Ичиноза Мен оны жақсы байқадым.
Dialogue: 0,0:25:13.25,0:25:15.25,Default,,0,0,0,,Шуто мырза...
Dialogue: 0,0:25:17.06,0:25:19.06,Default,,0,0,0,,Бұл менің жоғалтуым
Dialogue: 0,0:25:20.44,0:25:22.68,Default,,0,0,0,,Шуто-сан. (Рё) Иә?
Dialogue: 0,0:25:22.68,0:25:26.15,Default,,0,0,0,,Сіз шынымен нешедесіз?
Dialogue: 0,0:25:26.15,0:25:29.35,Default,,0,0,0,,Енді... ұмытып кетіппін.
Dialogue: 0,0:25:29.35,0:25:37.75,Default,,0,0,0,,♬～
Dialogue: 0,0:25:39.20,0:25:43.82,Default,,0,0,0,,♬～
Dialogue: 0,0:25:43.82,0:25:54.48,Default,,0,0,0,,♬～
Dialogue: 0,0:25:54.48,0:25:58.98,Default,,0,0,0,,♬ Ах, мыңдаған айлар мен күндер болса да
Dialogue: 0,0:26:00.35,0:26:03.45,Default,,0,0,0,,♬ Бізді ажыратса да
Dialogue: 0,0:26:04.85,0:26:09.49,Default,,0,0,0,,♬ Әй, тек мұңды жүрек
Dialogue: 0,0:26:09.49,0:26:14.01,Default,,0,0,0,,♬ Кешегідей ауырады
Dialogue: 0,0:26:14.01,0:26:19.60,Default,,0,0,0,,♬ Екі бетімнен сипап тұрған салқын самал
Dialogue: 0,0:26:19.60,0:26:22.56,Default,,0,0,0,,♬ Әлі де солай
Dialogue: 0,0:26:22.56,0:26:24.79,Default,,0,0,0,,♬ Түр
Dialogue: 0,0:26:24.79,0:26:28.59,Default,,0,0,0,,♬ Көзімді жұмсам, арман жалғасады
Dialogue: 0,0:26:29.96,0:26:35.49,Default,,0,0,0,,♬ Мен сүйген адамымды кездестіретін сияқтымын
Dialogue: 0,0:26:35.49,0:26:38.92,Default,,0,0,0,,♬ Қазір де, бұл дүниеде
Dialogue: 0,0:26:38.92,0:26:41.31,Default,,0,0,0,,♬ Бір жерде біреу
Dialogue: 0,0:26:41.31,0:26:46.05,Default,,0,0,0,,♬ Махаббатқа жолықсаң
Dialogue: 0,0:26:46.05,0:26:48.98,Default,,0,0,0,,♬ Тіпті өткен нәрселер
Dialogue: 0,0:26:48.98,0:26:52.92,Default,,0,0,0,,♬ тағы бір рет
Dialogue: 0,0:26:52.92,0:26:58.66,Default,,0,0,0,,♬ Көргім келеді сені көргім келеді
Dialogue: 0,0:26:58.66,0:27:03.46,Default,,0,0,0,,♬～
Dialogue: 0,0:28:40.23,0:28:42.26,Default,,0,0,0,,Жәннәт және тозақ есіктері. Олардың алдында➡
Dialogue: 0,0:28:42.26,0:28:45.58,Default,,0,0,0,,Екі қақпашы тұрады. Тек шындықты айтады➡
Dialogue: 0,0:28:45.58,0:28:49.19,Default,,0,0,0,,Басқа адам тек өтірік айтады. Сізге бір ғана мүмкіндік беріледі.➡
Dialogue: 0,0:28:49.19,0:28:52.79,Default,,0,0,0,,Енді жәннат қақпасын таңдау үшін қандай сұрақ қоюым керек?
Dialogue: 0,0:28:54.22,0:28:56.24,Default,,0,0,0,,«Куругуми үй бөлмесі»!
Dialogue: 0,0:28:56.24,0:28:58.85,Default,,0,0,0,,Қызық екен хехе. Ичиноза: не істеп жатырсың?
Dialogue: 0,0:28:58.85,0:29:00.88,Default,,0,0,0,,«Шайтанның жұмбақ радиосы ~Куругуми коммуникациясы~» ➡
Dialogue: 0,0:29:00.88,0:29:02.93,Default,,0,0,0,,Мен тыңдаймын. Қызық па?
Dialogue: 0,0:29:02.93,0:29:06.09,Default,,0,0,0,,MC Аяка Суваның баяндамасы ең жақсы!
Dialogue: 0,0:29:06.09,0:29:09.69,Default,,0,0,0,,Бұл атау таныс естіледі. Қоғамдық жазу да шешілді.
Dialogue: 0,0:29:09.69,0:29:12.51,Default,,0,0,0,,көремін. Қоғамдық жазбаға қалай өтініш беруге болады➡
Dialogue: 0,0:29:12.51,0:29:14.91,Default,,0,0,0,,Оны ресми веб-сайттан қараңыз!
Dialogue: 0,0:29:16.41,0:29:22.41,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory