Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:34.48,0:01:47.91,Default,,0,0,0,,♬～
Dialogue: 0,0:01:47.91,0:01:50.69,Default,,0,0,0,,[TEL] (Пошта қоңырау үні) (Тотокаку) Ммм...
Dialogue: 0,0:01:50.69,0:02:00.77,Default,,0,0,0,,♬～
Dialogue: 0,0:02:00.77,0:02:04.37,Default,,0,0,0,,Қандай жағдай болмасын, мен балалармен жұмыс істегенде шаршаймын.
Dialogue: 0,0:02:04.37,0:02:07.71,Default,,0,0,0,,♬～
Dialogue: 0,0:02:07.71,0:02:11.30,Default,,0,0,0,,Мұндай сұраққа жауап беру мүмкін емес.➡
Dialogue: 0,0:02:11.30,0:02:14.82,Default,,0,0,0,,Дұрыс жауап болса, ол біреудің сөзі.➡
Dialogue: 0,0:02:14.82,0:02:18.52,Default,,0,0,0,,Бұл сізден ешқашан шықпайтын сөздер.➡
Dialogue: 0,0:02:18.52,0:02:23.13,Default,,0,0,0,,Токаку, сен бөлмеңе біреуді кіргіздің бе?
Dialogue: 0,0:02:23.13,0:02:27.80,Default,,0,0,0,,♬～
Dialogue: 0,0:02:27.80,0:02:30.17,Default,,0,0,0,,Сіз қанша уақыт ұйықтадыңыз?➡
Dialogue: 0,0:02:30.17,0:02:32.84,Default,,0,0,0,,Оянатын уақыт келді.➡
Dialogue: 0,0:02:32.84,0:02:37.44,Default,,0,0,0,,Мұғалімнің айтқанының бәрі өтірік екенін тез түсін.
Dialogue: 0,0:02:38.79,0:02:41.23,Default,,0,0,0,,♬ Кері санауға дайынсыз ба
Dialogue: 0,0:02:41.23,0:02:43.31,Default,,0,0,0,,♬ Жүгіруге жол жоқ
Dialogue: 0,0:02:43.31,0:02:52.40,Default,,0,0,0,,♬～
Dialogue: 0,0:02:52.40,0:02:57.03,Default,,0,0,0,,♬ Оңай диапазонға түспеңіз.
Dialogue: 0,0:02:57.03,0:03:02.05,Default,,0,0,0,,♬ Бұл суық соғыс аймағы. Қазіргі жағдай жалықтырады.
Dialogue: 0,0:03:02.05,0:03:06.65,Default,,0,0,0,,♬ Ей, балалар, сондықтан сен ерекше екенсің.
Dialogue: 0,0:03:06.65,0:03:08.69,Default,,0,0,0,,♬ Баяғыда сыйымдылық асып кеткен
Dialogue: 0,0:03:08.69,0:03:10.94,Default,,0,0,0,,♬ Өзін-өзі мазақ ету түбі жоқ
Dialogue: 0,0:03:10.94,0:03:12.98,Default,,0,0,0,,♬ Өте сүйкімді
Dialogue: 0,0:03:12.98,0:03:15.90,Default,,0,0,0,,♬ Мен саған ақымақтығымды көрсете алмаймын.
Dialogue: 0,0:03:15.90,0:03:17.93,Default,,0,0,0,,♬ Бекер толқу
Dialogue: 0,0:03:17.93,0:03:19.93,Default,,0,0,0,,♬ Тек ынталандыру үшін
Dialogue: 0,0:03:21.35,0:03:23.97,Default,,0,0,0,,♬ Қабылдау/бүлік Екі ғана таңдау бар ма?
Dialogue: 0,0:03:23.97,0:03:27.64,Default,,0,0,0,,♬ ah Эстетика «Мен ешкімге тиіспеймін»
Dialogue: 0,0:03:27.64,0:03:29.66,Default,,0,0,0,,♬ Жараның кінәсіздігі
Dialogue: 0,0:03:29.66,0:03:32.51,Default,,0,0,0,,♬ Мен де сол топқа кіремін.
Dialogue: 0,0:03:32.51,0:03:34.55,Default,,0,0,0,,♬ орылатын болады
Dialogue: 0,0:03:34.55,0:03:36.97,Default,,0,0,0,,♬ Ешбір жағдайда әрқашан жалғасуда
Dialogue: 0,0:03:36.97,0:03:41.04,Default,,0,0,0,,♬ Белдемшенің етегі туралы шындық
Dialogue: 0,0:03:41.04,0:03:46.23,Default,,0,0,0,,♬ Тек ақымақ сияқты сеніңіз
Dialogue: 0,0:03:46.23,0:03:50.36,Default,,0,0,0,,♬ Маған қатты әсер етті
Dialogue: 0,0:03:50.36,0:03:56.97,Default,,0,0,0,,♬ Оны твиттер арқылы жіберіңіз.
Dialogue: 0,0:03:56.97,0:04:06.47,Default,,0,0,0,,♬～
Dialogue: 0,0:04:19.54,0:04:23.20,Default,,0,0,0,,Сіз білесіз бе? Қазір қара топ ұсталып жатқан көрінеді.
Dialogue: 0,0:04:23.20,0:04:25.23,Default,,0,0,0,,Ах~ Мен мұны естідім.➡
Dialogue: 0,0:04:25.23,0:04:28.68,Default,,0,0,0,,Бұл элиталық халықаралық студенттердің жиналысы сияқты.
Dialogue: 0,0:04:28.68,0:04:30.90,Default,,0,0,0,,Иә~ Менің естігенім➡
Dialogue: 0,0:04:30.90,0:04:34.89,Default,,0,0,0,,Пұттарға арналған құпия арнайы сынып... (Оқушылар) Шынымен!?
Dialogue: 0,0:04:34.89,0:04:36.94,Default,,0,0,0,,Баршаңызға қайырлы таң! ➡
Dialogue: 0,0:04:36.94,0:04:41.26,Default,,0,0,0,,Көп ұзамай, бүгін жаңа дос келді!
Dialogue: 0,0:04:41.26,0:04:44.93,Default,,0,0,0,,№ 5 Кенмочи Энада. Рақмет сізге.
Dialogue: 0,0:04:44.93,0:04:49.82,Default,,0,0,0,,Бұл Отоя Такечи, №8 қатысушы. Көңілді болайық!
Dialogue: 0,0:04:49.82,0:04:52.52,Default,,0,0,0,,Рио Шуто. № 7
Dialogue: 0,0:04:52.52,0:04:55.19,Default,,0,0,0,,Менің хоббиім – денемді қозғалту.
Dialogue: 0,0:04:55.19,0:04:58.63,Default,,0,0,0,,Како Каминага. Қатысу саны 3
Dialogue: 0,0:04:58.63,0:05:00.93,Default,,0,0,0,,Бүгіннен бастап мен бастық боламын, сондықтан маған қамқорлық жасаңыз.
Dialogue: 0,0:05:02.60,0:05:04.67,Default,,0,0,0,,Ұзын? Бұл не?
Dialogue: 0,0:05:04.67,0:05:07.12,Default,,0,0,0,,Бастық туралы айтқанда, мен барлық бастықты айтып отырмын.➡
Dialogue: 0,0:05:07.12,0:05:10.48,Default,,0,0,0,,Әзірге Қара тобының төрағасынан бастайық.
Dialogue: 0,0:05:10.48,0:05:12.83,Default,,0,0,0,,Шағымдарыңыз болса айтыңыздаршы.
Dialogue: 0,0:05:12.83,0:05:16.47,Default,,0,0,0,,Жоқ, егер солай болса, мен де жатақхана директорынан сұрадым.
Dialogue: 0,0:05:16.47,0:05:18.82,Default,,0,0,0,,Жақсы, жақсы. Олай болса, барлығына➡
Dialogue: 0,0:05:18.82,0:05:20.82,Default,,0,0,0,,Жақсы араласайық!
Dialogue: 0,0:05:22.20,0:05:24.61,Default,,0,0,0,,Кәдімгі алты қырлы матрицаны домалатқанда➡
Dialogue: 0,0:05:24.61,0:05:28.26,Default,,0,0,0,,Бұл «сынау» деп аталады, бірақ сол уақытта болуы мүмкін оқиғалар ➡
Dialogue: 0,0:05:28.26,0:05:31.16,Default,,0,0,0,,1-ден 6-ға дейін сандардың бірі айналады➡
Dialogue: 0,0:05:31.16,0:05:34.03,Default,,0,0,0,,Барлығы 6 үлгі бар.➡
Dialogue: 0,0:05:34.03,0:05:37.44,Default,,0,0,0,,Осы оқиғалардың әрқайсысының пайда болу жылдамдығына қарап...
Dialogue: 0,0:05:37.44,0:05:40.39,Default,,0,0,0,,≪Бәріміз студент болып көрінейік... иә?≫
Dialogue: 0,0:05:40.39,0:05:42.93,Default,,0,0,0,,≪Бұл фарс сияқты≫
Dialogue: 0,0:05:42.93,0:05:45.43,Default,,0,0,0,,1... домалау оқиғасы
Dialogue: 0,0:05:46.83,0:05:48.86,Default,,0,0,0,,Ах
Dialogue: 0,0:05:48.86,0:05:58.37,Default,,0,0,0,,♬～
Dialogue: 0,0:05:58.37,0:06:00.39,Default,,0,0,0,,(Пошта қоңырау үні)
Dialogue: 0,0:06:00.39,0:06:19.04,Default,,0,0,0,,♬～
Dialogue: 0,0:06:19.04,0:06:21.58,Default,,0,0,0,,≪Әзірше дос болып көрінеміз бе? ≫
Dialogue: 0,0:06:21.58,0:06:23.77,Default,,0,0,0,,≪Бұл жағдайда≫
Dialogue: 0,0:06:23.77,0:06:25.77,Default,,0,0,0,,≪Бұл жиіркенішті≫
Dialogue: 0,0:06:27.17,0:06:29.20,Default,,0,0,0,,Уа... ау.➡
Dialogue: 0,0:06:29.20,0:06:31.20,Default,,0,0,0,,Хехе
Dialogue: 0,0:06:34.06,0:06:36.86,Default,,0,0,0,,Сізде сүйкімді адам бар, солай емес пе?
Dialogue: 0,0:06:38.55,0:06:41.47,Default,,0,0,0,,Токаку-сан, сенің орамалың болған жоқ деп ойлаймын.➡
Dialogue: 0,0:06:41.47,0:06:43.59,Default,,0,0,0,,Юбэ Хару келді.
Dialogue: 0,0:06:43.59,0:06:46.17,Default,,0,0,0,,Ху~｡ Күн ашық болса, жақсы~
Dialogue: 0,0:06:46.17,0:06:48.17,Default,,0,0,0,,Хехехе
Dialogue: 0,0:06:50.79,0:06:54.61,Default,,0,0,0,,Ах! О, Токаку мырза, бұл. Орамал!
Dialogue: 0,0:06:54.61,0:07:00.84,Default,,0,0,0,,♬～
Dialogue: 0,0:07:00.84,0:07:03.02,Default,,0,0,0,,Әй
Dialogue: 0,0:07:03.02,0:07:06.07,Default,,0,0,0,,Процедура енді аяқталды.
Dialogue: 0,0:07:06.07,0:07:10.40,Default,,0,0,0,,Рахмет. Сонда мен де қара топқа қосыла аламын.
Dialogue: 0,0:07:10.40,0:07:13.20,Default,,0,0,0,,Эйджи мырза соңғы болып келді.
Dialogue: 0,0:07:13.20,0:07:17.67,Default,,0,0,0,,Жарайды, мені Эй-сан деп атаңыз.➡
Dialogue: 0,0:07:17.67,0:07:21.97,Default,,0,0,0,,Бүгіннен бастап мен де осы Миоджо академиясының мүшесімін.
Dialogue: 0,0:07:23.86,0:07:28.18,Default,,0,0,0,,Құрметті 10 курс қара сынып, іскерлік байланыс.➡
Dialogue: 0,0:07:28.18,0:07:32.10,Default,,0,0,0,,Қазір барлық ер адамдар келді, сағат 0 болды➡
Dialogue: 0,0:07:32.10,0:07:35.40,Default,,0,0,0,,Бас ғимарат мұнарасындағы 1908 сыныпта➡
Dialogue: 0,0:07:35.40,0:07:38.96,Default,,0,0,0,,Біз сахна артына бағдарлау жүргіземіз
Dialogue: 0,0:07:38.96,0:07:43.53,Default,,0,0,0,,Миссия туралы білгісі келетіндер қатысуы керек.
Dialogue: 0,0:07:43.53,0:07:47.33,Default,,0,0,0,,Ей, сен ол жақтансың ғой.
Dialogue: 0,0:07:47.33,0:07:50.33,Default,,0,0,0,,Біз осы мектептің оқушыларымыз.
Dialogue: 0,0:07:52.37,0:07:55.47,Default,,0,0,0,,Мақсат расталды...?
Dialogue: 0,0:07:55.47,0:07:58.59,Default,,0,0,0,,♬～
Dialogue: 0,0:07:58.59,0:08:00.63,Default,,0,0,0,,(Ватару) Не болып жатыр? Бұл әңгіме… (Ер оқушы) Ол ұялы телефонымен дауласып жатыр.
Dialogue: 0,0:08:00.63,0:08:05.13,Default,,0,0,0,,♬～
Dialogue: 0,0:08:05.13,0:08:09.02,Default,,0,0,0,,≪Бәрін ұшырып жіберсек жақсы емес пе? ≫
Dialogue: 0,0:08:09.02,0:08:11.66,Default,,0,0,0,,≪Сыйақы бәрібір маңызды емес≫
Dialogue: 0,0:08:11.66,0:08:14.46,Default,,0,0,0,,≪Қайбаның бағасы қандай болатынын білдіңіз бе?≫
Dialogue: 0,0:08:17.43,0:08:19.48,Default,,0,0,0,,Аа, Токаку мырза?
Dialogue: 0,0:08:19.48,0:08:23.48,Default,,0,0,0,,♬～
Dialogue: 0,0:08:26.94,0:08:29.42,Default,,0,0,0,,Бұл жерді кеше Харумо да тапты➡
Dialogue: 0,0:08:29.42,0:08:32.54,Default,,0,0,0,,Уау, мен бұл жерге көзім түсті.
Dialogue: 0,0:08:32.54,0:08:37.30,Default,,0,0,0,,А, Токаку-сан, сенің де жегің келе ме? Мені түлкі оқытты
Dialogue: 0,0:08:37.30,0:08:40.24,Default,,0,0,0,,Миоджо Гакуэн мамандандырылған ұсақ қауын наны
Dialogue: 0,0:08:40.24,0:08:44.14,Default,,0,0,0,,Қажет емес. Сыныптастар саны бірден көбейді.
Dialogue: 0,0:08:44.14,0:08:46.54,Default,,0,0,0,,Мен оны барлығына дұрыс бере аламын ба?
Dialogue: 0,0:08:50.46,0:08:52.50,Default,,0,0,0,,Дәмді
Dialogue: 0,0:08:52.50,0:08:56.50,Default,,0,0,0,,♬～
Dialogue: 0,0:08:56.50,0:08:59.59,Default,,0,0,0,,Сіз шынымен...
Dialogue: 0,0:08:59.59,0:09:01.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:01.62,0:09:13.62,Default,,0,0,0,,♬～
Dialogue: 0,0:09:14.97,0:09:18.99,Default,,0,0,0,,Күлмесең, ашуланасың.
Dialogue: 0,0:09:18.99,0:09:23.53,Default,,0,0,0,,Бүгінгі кештің артында не болатынын көру үшін күтуіміз керек пе? Исуке мырза
Dialogue: 0,0:09:23.53,0:09:26.35,Default,,0,0,0,,Исуке үйге ерте қайтқысы келеді, солай ма?
Dialogue: 0,0:09:26.35,0:09:29.30,Default,,0,0,0,,Егер сіз асығыс болсаңыз, қиындыққа тап болуыңыз мүмкін емес пе?
Dialogue: 0,0:09:29.30,0:09:32.20,Default,,0,0,0,,Ештен кеш жақсы, солай ма?
Dialogue: 0,0:09:35.42,0:09:39.29,Default,,0,0,0,,Исук 1 Кеттік!
Dialogue: 0,0:09:39.29,0:09:41.61,Default,,0,0,0,,Инукай? Иә
Dialogue: 0,0:09:41.61,0:09:46.20,Default,,0,0,0,,Мен олардың дәмді шай ішкенін естідім. Токаку-санның бізге қосылғанын қалайсыз ба?
Dialogue: 0,0:09:46.20,0:09:50.66,Default,,0,0,0,,Сіз осы бөлмеге келесіз бе? Кешіріңіз, мен өзім шештім.
Dialogue: 0,0:09:50.66,0:09:53.14,Default,,0,0,0,,Бірақ Токаку-сан ол жерде болмады.
Dialogue: 0,0:09:53.14,0:09:55.16,Default,,0,0,0,,Мен оны шешіп аламын. Ха!
Dialogue: 0,0:09:55.16,0:09:57.78,Default,,0,0,0,,Барлығымен жақсы араласайық, Токаку-сан да.
Dialogue: 0,0:09:57.78,0:10:01.17,Default,,0,0,0,,Бұл сенің досың және сенің бөлмең. Өзіңізге ұнайтын нәрсені жасаңыз.
Dialogue: 0,0:10:01.17,0:10:04.12,Default,,0,0,0,,No 1 бөлме екі адамға арналған бөлме.
Dialogue: 0,0:10:04.12,0:10:06.17,Default,,0,0,0,,Бұл Хару мен Токакудың бөлмесі.
Dialogue: 0,0:10:06.17,0:10:08.22,Default,,0,0,0,,Ах. Исуке-сан.
Dialogue: 0,0:10:08.22,0:10:11.24,Default,,0,0,0,,Әй, Азума-сан, шай ішкің келмей ме?
Dialogue: 0,0:10:11.24,0:10:13.24,Default,,0,0,0,,Сасықсың.
Dialogue: 0,0:10:16.42,0:10:19.89,Default,,0,0,0,,Токаку-сан! (Исуке) Әй, мен қызғанамын ба деп.
Dialogue: 0,0:10:19.89,0:10:21.95,Default,,0,0,0,,Хехе
Dialogue: 0,0:10:21.95,0:10:40.65,Default,,0,0,0,,♬～
Dialogue: 0,0:10:46.56,0:10:49.70,Default,,0,0,0,,Мм... сенің атың неге Исуке?
Dialogue: 0,0:10:49.70,0:10:52.12,Default,,0,0,0,,Ер адамның аты сияқты...
Dialogue: 0,0:10:52.12,0:10:55.17,Default,,0,0,0,,Шай одан да суық болады.
Dialogue: 0,0:10:55.17,0:10:57.17,Default,,0,0,0,,Барлығын ескерсек, біз үшеу болып өмір сүруге үйрене бастадық.
Dialogue: 0,0:10:59.57,0:11:01.58,Default,,0,0,0,,Бірақ мұндағы олардың ойып жазғандары ұзақ уақыттан бері ұмыт қалды, және мұнда енді дұғалар айтылмайды.
Dialogue: 0,0:11:01.58,0:11:05.33,Default,,0,0,0,,♬～
Dialogue: 0,0:11:05.33,0:11:07.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:07.38,0:11:10.54,Default,,0,0,0,,Не? Бұл дәмді
Dialogue: 0,0:11:10.54,0:11:14.01,Default,,0,0,0,,Мен бұл есімді анамнан алғанмын.
Dialogue: 0,0:11:14.01,0:11:16.79,Default,,0,0,0,,Керемет, солай емес пе? Керемет!
Dialogue: 0,0:11:16.79,0:11:21.48,Default,,0,0,0,,Бірақ мен сенің анаңның атын елестете алмаймын. Исуко ма?
Dialogue: 0,0:11:21.48,0:11:23.50,Default,,0,0,0,,Эйсуке. иә?
Dialogue: 0,0:11:23.50,0:11:27.27,Default,,0,0,0,,Ер адамның есіміне ұқсайды, солай ма? Хаха.
Dialogue: 0,0:11:27.27,0:11:31.79,Default,,0,0,0,,Менің анам ер адам. Менің әкем де ер адам.
Dialogue: 0,0:11:31.79,0:11:34.93,Default,,0,0,0,,Хе... хе...
Dialogue: 0,0:11:34.93,0:11:37.46,Default,,0,0,0,,Исуке – әрі ана, әрі әке➡
Dialogue: 0,0:11:37.46,0:11:40.02,Default,,0,0,0,,Бір тамшы қан да қосылмайды
Dialogue: 0,0:11:40.02,0:11:42.62,Default,,0,0,0,,Бірақ су қаннан да қою.
Dialogue: 0,0:11:43.97,0:11:46.97,Default,,0,0,0,,Сондықтан мен Исуке үшін өлдім.
Dialogue: 0,0:11:48.42,0:11:50.48,Default,,0,0,0,,Қол шапалақтаңыз!
Dialogue: 0,0:11:50.48,0:11:58.98,Default,,0,0,0,,♬～
Dialogue: 0,0:12:00.67,0:12:03.89,Default,,0,0,0,,1-бөлмеде шай болған жоқ па?
Dialogue: 0,0:12:03.89,0:12:06.56,Default,,0,0,0,,Менің оған еш қатысым жоқ. (Харуки) Олай болса, қазір➡
Dialogue: 0,0:12:06.56,0:12:08.98,Default,,0,0,0,,Хару-чан мен Исуке-сама, екеуміз ғана ма?
Dialogue: 0,0:12:08.98,0:12:12.25,Default,,0,0,0,,Жарайды, мен өзімнен оздым деп ойлаймын.
Dialogue: 0,0:12:12.25,0:12:16.32,Default,,0,0,0,,Бұл нені білдіреді? (Харуки) Иә? Оториден естіген жоқсың ба?
Dialogue: 0,0:12:16.32,0:12:19.29,Default,,0,0,0,,Бүгін түннен бастап қара команда әрекет етеді.
Dialogue: 0,0:12:19.29,0:12:23.64,Default,,0,0,0,,Исуке-сама Хару-Чаннан бір қадам алға шықты...
Dialogue: 0,0:12:23.64,0:12:29.05,Default,,0,0,0,,♬～
Dialogue: 0,0:12:29.05,0:12:31.38,Default,,0,0,0,,Әй. Фу~
Dialogue: 0,0:12:31.38,0:12:35.29,Default,,0,0,0,,≪(Нидзи) Харуки-санның да стратег екені таңқаларлық.
Dialogue: 0,0:12:35.29,0:12:38.07,Default,,0,0,0,,Мені Исуке-сама алса қиын болар еді➡
Dialogue: 0,0:12:38.07,0:12:42.23,Default,,0,0,0,,Бір бөлмеде отырған адаммен ренжісу қиын.
Dialogue: 0,0:12:42.23,0:12:44.91,Default,,0,0,0,,Бұл тым кеш болуы мүмкін
Dialogue: 0,0:12:44.91,0:12:47.57,Default,,0,0,0,,Міндетті емес.
Dialogue: 0,0:12:47.57,0:12:51.82,Default,,0,0,0,,Хару Ичиноза Ол бірнеше адамды өлтірді.
Dialogue: 0,0:12:51.82,0:12:55.02,Default,,0,0,0,,Барлық бауырларға Әке Ана
Dialogue: 0,0:12:57.36,0:13:00.18,Default,,0,0,0,,Отбасы қалыпты.
Dialogue: 0,0:13:00.18,0:13:03.47,Default,,0,0,0,,Жоқ, жоқ, бұл ұят.➡
Dialogue: 0,0:13:03.47,0:13:05.57,Default,,0,0,0,,Бұл жігіт шектен шыққан.
Dialogue: 0,0:13:05.57,0:13:09.65,Default,,0,0,0,,Айтпақшы, Харуки отбасында да көп ағайынды бар.
Dialogue: 0,0:13:09.65,0:13:11.66,Default,,0,0,0,,Ах... уау!
Dialogue: 0,0:13:11.66,0:13:14.24,Default,,0,0,0,,Үйді жалғыз қалдыр!
Dialogue: 0,0:13:14.24,0:13:16.24,Default,,0,0,0,,Түсінікті...
Dialogue: 0,0:13:18.38,0:13:21.88,Default,,0,0,0,,Бар болғаны ыстық суға салып қойсаңыз болғаны.
Dialogue: 0,0:13:23.80,0:13:26.02,Default,,0,0,0,,Хару өлмейді.
Dialogue: 0,0:13:26.02,0:13:29.91,Default,,0,0,0,,Ах... Харудың сиқыры бар.
Dialogue: 0,0:13:29.91,0:13:33.56,Default,,0,0,0,,Ешқашан өлмейтін сиқыр...
Dialogue: 0,0:13:33.56,0:13:37.07,Default,,0,0,0,,♬～
Dialogue: 0,0:13:37.07,0:13:39.07,Default,,0,0,0,,Ұйықтама
Dialogue: 0,0:13:40.47,0:13:44.42,Default,,0,0,0,,Токаку, сен қанша ұйықтайсың? ➡
Dialogue: 0,0:13:44.42,0:13:48.12,Default,,0,0,0,,Асығыңыз да, ішіңіздегі жабайылықты оятыңыз.
Dialogue: 0,0:13:49.86,0:13:52.45,Default,,0,0,0,,Жабайы нәрселерге мұрның жақсы.
Dialogue: 0,0:13:52.45,0:13:54.45,Default,,0,0,0,,Хахаха
Dialogue: 0,0:16:00.51,0:16:03.56,Default,,0,0,0,,♬～
Dialogue: 0,0:16:03.56,0:16:06.55,Default,,0,0,0,,Ха! (Исуке) Ой, бұл ақылсыз.
Dialogue: 0,0:16:06.55,0:16:12.07,Default,,0,0,0,,♬～
Dialogue: 0,0:16:12.07,0:16:14.51,Default,,0,0,0,,Эй, мен таң қалдым.➡
Dialogue: 0,0:16:14.51,0:16:16.74,Default,,0,0,0,,Бұл бала ауыр жарақат алды.
Dialogue: 0,0:16:16.74,0:16:19.13,Default,,0,0,0,,Исуке Бұл сәл мое~
Dialogue: 0,0:16:19.13,0:16:21.31,Default,,0,0,0,,Мына жігіт оны жасырып тұрған.
Dialogue: 0,0:16:21.31,0:16:24.18,Default,,0,0,0,,Неге ашуланасың? Мақсатты білгеннен кейін ➡
Dialogue: 0,0:16:24.18,0:16:26.18,Default,,0,0,0,,Бірінші келген бірінші қызмет етеді!
Dialogue: 0,0:16:28.25,0:16:30.27,Default,,0,0,0,,Сіз жай ғана ұйықтап жатырсыз ба?
Dialogue: 0,0:16:30.27,0:16:41.22,Default,,0,0,0,,♬～
Dialogue: 0,0:16:41.22,0:16:44.52,Default,,0,0,0,,≪Бұл да қалыпты емес пе?≫
Dialogue: 0,0:16:44.52,0:16:51.41,Default,,0,0,0,,♬～
Dialogue: 0,0:16:51.41,0:16:53.46,Default,,0,0,0,,Сіз оны ұрлауды жоспарлап отырсыз ба!?
Dialogue: 0,0:16:53.46,0:16:55.86,Default,,0,0,0,,♬～
Dialogue: 0,0:16:55.86,0:16:59.02,Default,,0,0,0,,Неліктен оны жауып жатырсыз?
Dialogue: 0,0:16:59.02,0:17:01.87,Default,,0,0,0,,Бармын! Бұл қатты ауырады
Dialogue: 0,0:17:01.87,0:17:13.31,Default,,0,0,0,,♬～
Dialogue: 0,0:17:13.31,0:17:15.55,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:17:15.55,0:17:17.85,Default,,0,0,0,,Иә? Хамф!
Dialogue: 0,0:17:20.59,0:17:23.44,Default,,0,0,0,,Сіз пәксіз, солай ма? Ах.
Dialogue: 0,0:17:23.44,0:17:25.44,Default,,0,0,0,,Дока! Арх!
Dialogue: 0,0:17:27.46,0:17:30.86,Default,,0,0,0,,Әлі ешкімді өлтірмеген қаскүнем қыз
Dialogue: 0,0:17:32.37,0:17:34.42,Default,,0,0,0,,Аха! Баки!
Dialogue: 0,0:17:34.42,0:17:37.32,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:17:37.32,0:17:40.73,Default,,0,0,0,,Иә~ Сол шығыс?
Dialogue: 0,0:17:40.73,0:17:43.83,Default,,0,0,0,,Бұл не? Исуке мені күлдіреді. Қарғыс атқыр...
Dialogue: 0,0:17:45.23,0:17:47.28,Default,,0,0,0,,Құпия сақтаймын.➡
Dialogue: 0,0:17:47.28,0:17:50.40,Default,,0,0,0,,Ахаха, мен керемет әңгіме таптым.
Dialogue: 0,0:17:50.40,0:17:52.50,Default,,0,0,0,,Күте тұрыңыз...
Dialogue: 0,0:17:53.81,0:18:00.40,Default,,0,0,0,,♬～
Dialogue: 0,0:18:00.40,0:18:02.41,Default,,0,0,0,,((Токаку-чан, мұнда кел. Тезірек!➡
Dialogue: 0,0:18:02.41,0:18:04.45,Default,,0,0,0,,Менің уақытым жоқ! ➡
Dialogue: 0,0:18:04.45,0:18:07.00,Default,,0,0,0,,Егер сіз қазірден бастап біреуді өлтіруді ойласаңыз➡
Dialogue: 0,0:18:07.00,0:18:10.66,Default,,0,0,0,,Осы қасиетті есіңе түсір)) ((Не болады?))
Dialogue: 0,0:18:10.66,0:18:13.36,Default,,0,0,0,,((Сен оны өлтіре алмайсың. Сол ғибадатхананың ішінде...))
Dialogue: 0,0:18:14.76,0:18:16.76,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:18:19.31,0:18:22.45,Default,,0,0,0,,≪Бұл қарғыс... сол кезде≫
Dialogue: 0,0:18:22.45,0:18:26.22,Default,,0,0,0,,♬～
Dialogue: 0,0:18:26.22,0:18:28.37,Default,,0,0,0,,Бармын! О, ауырады~
Dialogue: 0,0:18:28.37,0:18:31.29,Default,,0,0,0,,Ичиноза, не істеп жатырсың!?
Dialogue: 0,0:18:31.29,0:18:34.93,Default,,0,0,0,,Кешіріңіз. Мен қатты терлеп кеттім.
Dialogue: 0,0:18:34.93,0:18:37.98,Default,,0,0,0,,Дәл қазір басыңды ұрсам да, сен көзіңді жұмымас едің!
Dialogue: 0,0:18:37.98,0:18:41.02,Default,,0,0,0,,Маған дәрі берсең де неге ояусың?
Dialogue: 0,0:18:41.02,0:18:46.07,Default,,0,0,0,,Сіздің бүкіл денеңіздегі тыртықтар қандай? Сен қандайсың!?
Dialogue: 0,0:18:46.07,0:18:50.20,Default,,0,0,0,,Токаку-сан... Оны Харудың да естігісі келеді.
Dialogue: 0,0:18:50.20,0:18:53.70,Default,,0,0,0,,Неліктен Токаку-сан Харуға көмектесті?
Dialogue: 0,0:18:56.07,0:19:00.44,Default,,0,0,0,,Харудың төзімділігі бар болғандықтан, дәрі жақсы әсер етпейді.
Dialogue: 0,0:19:00.44,0:19:03.51,Default,,0,0,0,,Негізі мен ортада ояндым.
Dialogue: 0,0:19:03.51,0:19:08.66,Default,,0,0,0,,Қара топтағылардың барлығы Харуды өлтіру үшін мектепке ауысты, солай ма?
Dialogue: 0,0:19:08.66,0:19:10.73,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:19:10.73,0:19:13.42,Default,,0,0,0,,Токаку-сан неге маған көмектесті?
Dialogue: 0,0:19:13.42,0:19:15.45,Default,,0,0,0,,Қызықты ма? Стратегия?
Dialogue: 0,0:19:15.45,0:19:18.46,Default,,0,0,0,,Немесе оның басқа мағынасы бар ма?
Dialogue: 0,0:19:18.46,0:19:22.79,Default,,0,0,0,,Токаку-сан Харухан ешқашан өлмейді
Dialogue: 0,0:19:22.79,0:19:26.35,Default,,0,0,0,,Қара труппаны өлтірмей бітіремін.
Dialogue: 0,0:19:26.35,0:19:29.77,Default,,0,0,0,,Мүмкін емес! Сен сияқты қарапайым жігіт!
Dialogue: 0,0:19:29.77,0:19:33.12,Default,,0,0,0,,Токаку-сан, Харудың үйі➡
Dialogue: 0,0:19:33.12,0:19:37.41,Default,,0,0,0,,Өте үлкен, үлкен отбасының бөлігі➡
Dialogue: 0,0:19:37.41,0:19:40.33,Default,,0,0,0,,Харудың тірі болғаны үшін қиналатын адамдар бар➡
Dialogue: 0,0:19:40.33,0:19:42.43,Default,,0,0,0,,Олар өте көп.
Dialogue: 0,0:19:42.43,0:19:47.17,Default,,0,0,0,,Менің отбасымдағылардың бәрі Харуды бүгінгі күнге дейін тірі қалдыру үшін өлді.
Dialogue: 0,0:19:47.17,0:19:49.72,Default,,0,0,0,,Әкесі де, анасы да➡
Dialogue: 0,0:19:49.72,0:19:52.69,Default,,0,0,0,,Үлкен аға, іні және ата➡
Dialogue: 0,0:19:52.69,0:19:54.73,Default,,0,0,0,,…қашып кету…
Dialogue: 0,0:19:54.73,0:19:58.10,Default,,0,0,0,,Харудың өмірі тек Харуға ғана тиесілі емес.
Dialogue: 0,0:19:58.10,0:20:00.73,Default,,0,0,0,,Бұл әр адам құтқарған өмір.
Dialogue: 0,0:20:00.73,0:20:03.87,Default,,0,0,0,,Анам Харуды қорғап қайтыс болғанда➡
Dialogue: 0,0:20:03.87,0:20:06.47,Default,,0,0,0,,Хару тіпті қоштаса да алмады
Dialogue: 0,0:20:08.01,0:20:10.17,Default,,0,0,0,,)
Dialogue: 0,0:20:10.17,0:20:13.44,Default,,0,0,0,,Бірақ анам әрқашан осында➡
Dialogue: 0,0:20:13.44,0:20:16.03,Default,,0,0,0,,Маған дұрыс нәрсені айтады
Dialogue: 0,0:20:16.03,0:20:18.07,Default,,0,0,0,,<<Бұл қарғыс>>
Dialogue: 0,0:20:18.07,0:20:21.77,Default,,0,0,0,,Барлығы Харудың күлімдеген жүзін жақсы көретінін айтады➡
Dialogue: 0,0:20:21.77,0:20:23.81,Default,,0,0,0,,Хару жыламайды
Dialogue: 0,0:20:23.81,0:20:26.14,Default,,0,0,0,,≪Бұл қарғыс≫
Dialogue: 0,0:20:26.14,0:20:30.40,Default,,0,0,0,,Хару күлу үшін дүниеге келген.
Dialogue: 0,0:20:30.40,0:20:34.00,Default,,0,0,0,,≪Өлгендердің артында қалған тым күшті сезімдер≫
Dialogue: 0,0:20:37.32,0:20:41.12,Default,,0,0,0,,)
Dialogue: 0,0:20:42.49,0:20:44.66,Default,,0,0,0,,Бұл соңғы сынақ
Dialogue: 0,0:20:44.66,0:20:48.80,Default,,0,0,0,,Хару ешқашан жеңілмейді. Ол міндетті түрде қара топтан аман қалады...
Dialogue: 0,0:20:48.80,0:20:51.57,Default,,0,0,0,,Бұл мүмкін емес. Хару дәлелдейді.
Dialogue: 0,0:20:51.57,0:20:54.17,Default,,0,0,0,,Барлығының өлімі бекер болған жоқ.
Dialogue: 0,0:20:54.17,0:20:58.17,Default,,0,0,0,,Бұл мүмкін емес! 12 адаммен араласып жүргенде саған не болды?
Dialogue: 0,0:20:58.17,0:21:01.27,Default,,0,0,0,,Харуды қорғап қаза тапқандар көп!
Dialogue: 0,0:21:04.91,0:21:08.57,Default,,0,0,0,,Мен де сенің өміріңді мақсат тұтамын.
Dialogue: 0,0:21:08.57,0:21:11.47,Default,,0,0,0,,Иә, мен білемін.
Dialogue: 0,0:21:11.47,0:21:14.92,Default,,0,0,0,,Сіз қорықпайсыз ба? Неге қашпайсың?
Dialogue: 0,0:21:14.92,0:21:17.51,Default,,0,0,0,,Сен неге...
Dialogue: 0,0:21:17.51,0:21:21.83,Default,,0,0,0,,Токаку-сан, Хару өлтіру үшін туылған жоқ.
Dialogue: 0,0:21:21.83,0:21:23.93,Default,,0,0,0,,Өмір сүру үшін туған
Dialogue: 0,0:21:25.63,0:21:27.65,Default,,0,0,0,,<<Жарық болса да>>
Dialogue: 0,0:21:27.65,0:21:30.49,Default,,0,0,0,,≪Сен бәрібір жақын арада өлтіресің≫
Dialogue: 0,0:21:30.49,0:21:33.56,Default,,0,0,0,,<<Сенің көзің қалайша осындай болады>>
Dialogue: 0,0:21:33.56,0:21:37.50,Default,,0,0,0,,Хару сөйледі. Токаку-санның кезегі
Dialogue: 0,0:21:37.50,0:21:40.90,Default,,0,0,0,,Неліктен Токаку-сан Харуға көмектесті?
Dialogue: 0,0:21:40.90,0:21:42.93,Default,,0,0,0,,А...
Dialogue: 0,0:21:42.93,0:21:48.77,Default,,0,0,0,,♬～
Dialogue: 0,0:21:48.77,0:21:52.16,Default,,0,0,0,,Мен саған көмектестім...
Dialogue: 0,0:21:52.16,0:21:54.16,Default,,0,0,0,,≪Concon (тоқылдату)
Dialogue: 0,0:21:58.40,0:22:00.42,Default,,0,0,0,,Ууух!
Dialogue: 0,0:22:00.42,0:22:04.84,Default,,0,0,0,,♬～
Dialogue: 0,0:22:04.84,0:22:08.39,Default,,0,0,0,,♬～
Dialogue: 0,0:22:08.39,0:22:12.66,Default,,0,0,0,,Қош келдіңіздер, өлтірушілер, Myojo академиясына.➡
Dialogue: 0,0:22:12.66,0:22:16.48,Default,,0,0,0,,Учиха Хаширихито. Қара тобының төрешісі.➡
Dialogue: 0,0:22:16.48,0:22:19.09,Default,,0,0,0,,Бұдан былай, артқа бағдарлау…➡
Dialogue: 0,0:22:19.09,0:22:21.67,Default,,0,0,0,,дейін
Dialogue: 0,0:22:21.67,0:22:26.24,Default,,0,0,0,,Қатысу саны 11 - Койко Эйзуми.➡
Dialogue: 0,0:22:26.24,0:22:28.86,Default,,0,0,0,,Менің денем әлсіз➡
Dialogue: 0,0:22:28.86,0:22:31.45,Default,,0,0,0,,Жиһазды өзіңіз жасамасаңыз, ол сыймайды.
Dialogue: 0,0:22:31.45,0:22:33.74,Default,,0,0,0,,Хмм... жарайды.
Dialogue: 0,0:22:33.74,0:22:37.29,Default,,0,0,0,,Баршаңызға, алдын ала уәде еткендей➡
Dialogue: 0,0:22:37.29,0:22:39.84,Default,,0,0,0,,Барлығы келгенше шыдамды болыңыз➡
Dialogue: 0,0:22:39.84,0:22:41.94,Default,,0,0,0,,Мен қатты толқып тұрмын.
Dialogue: 0,0:22:43.39,0:22:47.39,Default,,0,0,0,,Бірақ бұдан былай ережелерді қатаң сақтауларыңызды сұраймыз!
Dialogue: 0,0:22:49.32,0:22:52.50,Default,,0,0,0,,Келіңіздер! Олардың ішінде кім жылдам➡
Dialogue: 0,0:22:52.50,0:22:54.54,Default,,0,0,0,,Сіз Хару-чанды жеңесіз бе? ➡
Dialogue: 0,0:22:54.54,0:22:59.13,Default,,0,0,0,,Әлде Хару-чан аман қалып, Куро-гумиді аман-есен бітіре ме? ➡
Dialogue: 0,0:22:59.13,0:23:02.43,Default,,0,0,0,,Барлығы, сіз мұны бұрыннан білетініңізге сенімдімін, бірақ➡
Dialogue: 0,0:23:02.43,0:23:04.97,Default,,0,0,0,,Қайтадан қарап көрейік!
Dialogue: 0,0:23:04.97,0:23:10.07,Default,,0,0,0,,♬～
Dialogue: 0,0:23:10.07,0:23:12.46,Default,,0,0,0,,«Кез келген нәрсе» шынымен бе?
Dialogue: 0,0:23:12.46,0:23:15.74,Default,,0,0,0,,Шынымен, шынымен! Myojo Gakuen директорлар кеңесі болып табылады➡
Dialogue: 0,0:23:15.74,0:23:18.06,Default,,0,0,0,,Кез келген тілек орындалады.➡
Dialogue: 0,0:23:18.06,0:23:20.16,Default,,0,0,0,,Тек бір сәтті адам үшін
Dialogue: 0,0:23:20.16,0:23:33.80,Default,,0,0,0,,♬～
Dialogue: 0,0:23:33.80,0:23:37.47,Default,,0,0,0,,Басқаша айтқанда, неге Мизороги-чанды тартпасқа?
Dialogue: 0,0:23:37.47,0:23:39.48,Default,,0,0,0,,Дұрыс.➡
Dialogue: 0,0:23:39.48,0:23:41.97,Default,,0,0,0,,Мизороги мырза ештеңе білмейді➡
Dialogue: 0,0:23:41.97,0:23:44.37,Default,,0,0,0,,Ол нағыз қарапайым адам.
Dialogue: 0,0:23:45.82,0:23:49.73,Default,,0,0,0,,Бұл қара сыныптың оқушыларын қатыстыруға болады дегенді білдіре ме?
Dialogue: 0,0:23:49.73,0:23:56.42,Default,,0,0,0,,♬～
Dialogue: 0,0:23:56.42,0:23:58.77,Default,,0,0,0,,Қастандық туралы ескерту қағазы
Dialogue: 0,0:23:58.77,0:24:02.54,Default,,0,0,0,,Осы жігітпен мен қазірден бастап мұны істеймін деп жариялаймын.
Dialogue: 0,0:24:02.54,0:24:05.93,Default,,0,0,0,,Хабарландыру билетін беру құқығы тек бір адамға ғана беріледі.➡
Dialogue: 0,0:24:05.93,0:24:08.20,Default,,0,0,0,,Жіберілгеннен кейін оны жою мүмкін емес.➡
Dialogue: 0,0:24:08.20,0:24:11.23,Default,,0,0,0,,Уақытты абайлаңыз.➡
Dialogue: 0,0:24:11.23,0:24:14.02,Default,,0,0,0,,Хабарландыру қағазы Хару-чанның қолында болған соң➡
Dialogue: 0,0:24:14.02,0:24:16.67,Default,,0,0,0,,48 сағат ішінде сені өлтіре алмасам➡
Dialogue: 0,0:24:16.67,0:24:19.76,Default,,0,0,0,,Миссия орындалмады! Бірден шығарылды! ➡
Dialogue: 0,0:24:19.76,0:24:23.16,Default,,0,0,0,,Алдын ала хабарламалар тәулігіне 24 сағат қабылданады➡
Dialogue: 0,0:24:23.16,0:24:26.60,Default,,0,0,0,,Басқа адамдармен қабаттасуға болмайды. Өтінемін өзімшіл бол!
Dialogue: 0,0:24:26.60,0:24:28.62,Default,,0,0,0,,Гача (есік дыбысы)
Dialogue: 0,0:24:28.62,0:24:35.32,Default,,0,0,0,,♬～
Dialogue: 0,0:24:35.32,0:24:38.51,Default,,0,0,0,,О, Токаку-сан, кешігіп қалдың! ➡
Dialogue: 0,0:24:38.51,0:24:40.51,Default,,0,0,0,,Бұл Токаку-санның үлесі.
Dialogue: 0,0:24:45.10,0:24:50.07,Default,,0,0,0,,Bilibili biri…(үзіліс)
Dialogue: 0,0:24:50.07,0:24:52.07,Default,,0,0,0,,Не!
Dialogue: 0,0:24:55.24,0:24:58.84,Default,,0,0,0,,Мен ешкімге Хару Ичинозаға тиіспеймін.
Dialogue: 0,0:25:00.57,0:25:02.77,Default,,0,0,0,,((12 өлтіруші емес➡
Dialogue: 0,0:25:02.77,0:25:06.67,Default,,0,0,0,,Бұл 11 өлтіруші және 1 қамқоршы))
Dialogue: 0,0:25:06.67,0:25:14.43,Default,,0,0,0,,♬～
Dialogue: 0,0:25:14.43,0:25:16.73,Default,,0,0,0,,((мен сізге көмектестім➡
Dialogue: 0,0:25:18.50,0:25:22.19,Default,,0,0,0,,Себебі мен сізге тапсыруды шештім))
Dialogue: 0,0:25:22.19,0:25:28.54,Default,,0,0,0,,♬～
Dialogue: 0,0:25:28.54,0:25:31.65,Default,,0,0,0,,≪Ал бүгін бәрі басталды≫
Dialogue: 0,0:25:31.65,0:25:35.62,Default,,0,0,0,,♬～
Dialogue: 0,0:25:35.62,0:25:38.22,Default,,0,0,0,,≪Мен және Хару туралы бәрі≫
Dialogue: 0,0:25:39.54,0:25:47.56,Default,,0,0,0,,♬～
Dialogue: 0,0:25:47.56,0:25:57.02,Default,,0,0,0,,♬～
Dialogue: 0,0:25:57.02,0:26:01.13,Default,,0,0,0,,♬ Барлығында бар.
Dialogue: 0,0:26:01.13,0:26:04.51,Default,,0,0,0,,♬ Сен жасырып жүрген жараны
Dialogue: 0,0:26:04.51,0:26:09.85,Default,,0,0,0,,♬ Ал мен мейірімділікті үйрендім.
Dialogue: 0,0:26:09.85,0:26:13.19,Default,,0,0,0,,♬ Мен қорғауды үйрендім
Dialogue: 0,0:26:13.19,0:26:15.59,Default,,0,0,0,,♬ Иә
Dialogue: 0,0:26:16.99,0:26:21.60,Default,,0,0,0,,♬ Адамдар ертеңге қарай жүреді
Dialogue: 0,0:26:21.60,0:26:26.12,Default,,0,0,0,,♬ Кейде мұңды...
Dialogue: 0,0:26:26.12,0:26:30.07,Default,,0,0,0,,♬ Бірақ сіз жалғыз емессіз
Dialogue: 0,0:26:30.07,0:26:34.41,Default,,0,0,0,,♬ Әрқашан жарық
Dialogue: 0,0:26:34.41,0:26:38.70,Default,,0,0,0,,♬ Күннің ортасында
Dialogue: 0,0:26:38.70,0:26:44.22,Default,,0,0,0,,♬ Мен күлімдей алатындай сезінемін.
Dialogue: 0,0:26:44.22,0:26:50.73,Default,,0,0,0,,♬ Сол күндер жалғаса ма?
Dialogue: 0,0:26:50.73,0:26:53.23,Default,,0,0,0,,♬ мәңгілік
Dialogue: 0,0:26:55.18,0:26:57.88,Default,,0,0,0,,♬ мәңгілік
Dialogue: 0,0:26:59.37,0:27:01.95,Default,,0,0,0,,♬ мәңгілік
Dialogue: 0,0:27:01.95,0:27:05.25,Default,,0,0,0,,♬～
Dialogue: 0,0:28:40.53,0:28:43.44,Default,,0,0,0,,Мен Кайба Сенсеймін. Мен жеке академияның 17 мұғалімімін.➡
Dialogue: 0,0:28:43.44,0:28:46.52,Default,,0,0,0,,Мен үшін бұл өзін-өзі таныстыру өте оңай түсіну.➡
Dialogue: 0,0:28:46.52,0:28:49.58,Default,,0,0,0,,Енді, Токаку, сен өзің туралы қалай жауап берер едің? ➡
Dialogue: 0,0:28:49.58,0:28:53.08,Default,,0,0,0,,Мүмкін басқа адамдар сізге дұрыс жауапты берер.
Dialogue: 0,0:28:54.90,0:28:57.77,Default,,0,0,0,,«Куругуми үй бөлмесі»! Сәлем Токаку-сан➡
Dialogue: 0,0:28:57.77,0:29:01.32,Default,,0,0,0,,Маая Учиданы білесіз бе? Ол қара тобына жаңадан ауысқан студент пе?
Dialogue: 0,0:29:01.32,0:29:04.39,Default,,0,0,0,,Жоқ! Ол осы әнді айтатын
Dialogue: 0,0:29:04.39,0:29:07.70,Default,,0,0,0,,♬ Жаралы бейкүнә Мен де осыны айтамын
Dialogue: 0,0:29:07.70,0:29:10.88,Default,,0,0,0,,Керемет ән екен, солай емес пе? «Жараланған кінәсіздік»!
Dialogue: 0,0:29:10.88,0:29:12.90,Default,,0,0,0,,Мен оны күнде тыңдаймын. Ихиноза бұл➡
Dialogue: 0,0:29:12.90,0:29:16.04,Default,,0,0,0,,Сізге бұл жігіт ұнай ма? Сіз жау емессіз деп сенімді түрде айта аласыз ба?
Dialogue: 0,0:29:16.04,0:29:18.11,Default,,0,0,0,,Токаку-сан қатты уайымдап тұр!
Dialogue: 0,0:29:18.11,0:29:21.21,Default,,0,0,0,,Бұл CD 23 сәуірде шығады.
Dialogue: 0,0:29:21.21,0:29:23.84,Default,,0,0,0,,Егер сіз оны бір жерден естідім деп ойласаңыз, бұл бағдарлама➡
Dialogue: 0,0:29:23.84,0:29:26.73,Default,,0,0,0,,Тақырыпты ашу? Токаку-сан, дұрыс айтасың!
Dialogue: 0,0:29:26.73,0:29:29.53,Default,,0,0,0,,«Кінәсіздік жарасы» Рахмет!
Dialogue: 0,0:29:31.03,0:29:37.03,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory