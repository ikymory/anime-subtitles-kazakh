Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:34.52,0:01:38.50,Default,,0,0,0,,♬～
Dialogue: 0,0:01:38.50,0:01:42.64,Default,,0,0,0,,Жетілдірілген қоғамды құрайтын және топтасып өмір сүретін өкіл тіршілік иелері ➡
Dialogue: 0,0:01:42.64,0:01:44.93,Default,,0,0,0,,Аралар тұқымдасының мүшесі.➡
Dialogue: 0,0:01:44.93,0:01:48.26,Default,,0,0,0,,Аралар патшайымы праймер феромоны➡ деп аталады
Dialogue: 0,0:01:48.26,0:01:50.70,Default,,0,0,0,,Феромонды тек аналық аралар үшін қолдану➡
Dialogue: 0,0:01:50.70,0:01:53.30,Default,,0,0,0,,Үйірдің жұмысшы араларына жетекшілік ету
Dialogue: 0,0:01:55.20,0:01:57.24,Default,,0,0,0,,Тығыздардың ұрпақты болу функциясы➡
Dialogue: 0,0:01:57.24,0:02:00.84,Default,,0,0,0,,Олар ұяны басқаруға және қорғауға жауапты.➡
Dialogue: 0,0:02:00.84,0:02:04.68,Default,,0,0,0,,Бал арасы жұмысшы аралар ұяны табиғи жаулардан қорғайды➡
Dialogue: 0,0:02:04.68,0:02:08.53,Default,,0,0,0,,Кейде өмірге қауіп төндіретін шабуылдар жасайды.➡
Dialogue: 0,0:02:08.53,0:02:11.67,Default,,0,0,0,,Әрине, олар да зардап шегеді➡
Dialogue: 0,0:02:11.67,0:02:14.77,Default,,0,0,0,,Бұл да табынды қорғау инстинкті.
Dialogue: 0,0:02:19.28,0:02:21.45,Default,,0,0,0,,Мұғалім? Ах...｡➡
Dialogue: 0,0:02:21.45,0:02:24.97,Default,,0,0,0,,Кешіріңіз. Мен бұл туралы біраз уақыт ойлауым керек.➡
Dialogue: 0,0:02:24.97,0:02:28.40,Default,,0,0,0,,Иә... Не болса да істеймін➡
Dialogue: 0,0:02:28.40,0:02:30.74,Default,,0,0,0,,Сабақты соңына дейін жалғастыру.➡
Dialogue: 0,0:02:30.74,0:02:34.06,Default,,0,0,0,,Менің қолымнан келетіні енді Қара сыныпқа жауапты болғандықтан➡
Dialogue: 0,0:02:34.06,0:02:36.39,Default,,0,0,0,,Өйткені бұл менің жалғыз жұмысым.
Dialogue: 0,0:02:36.39,0:02:43.30,Default,,0,0,0,,♬～
Dialogue: 0,0:02:43.30,0:02:47.92,Default,,0,0,0,,Мен Мизороки мырзаға қатты жамандық жасадым.➡
Dialogue: 0,0:02:47.92,0:02:51.42,Default,,0,0,0,,Келесі жолы лайықты сыныпқа түсесің деп үміттенемін.
Dialogue: 0,0:02:55.35,0:02:57.45,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:02:59.90,0:03:01.95,Default,,0,0,0,,Іскерлік қарым-қатынас
Dialogue: 0,0:03:01.95,0:03:06.41,Default,,0,0,0,,Осыдан кейін негізгі мектеп ғимаратының мұнарасының 1908 сынып бөлмесінде сағат 0 ➡
Dialogue: 0,0:03:06.41,0:03:09.08,Default,,0,0,0,,Шынайы бағдар бар
Dialogue: 0,0:03:09.08,0:03:13.48,Default,,0,0,0,,Қара труппа туралы шындықты білгісі келетін кез келген адам қатысуы керек.
Dialogue: 0,0:03:15.73,0:03:19.93,Default,,0,0,0,,Хару-сан мұны бұрыннан біледі, солай ма?
Dialogue: 0,0:03:22.29,0:03:25.79,Default,,0,0,0,,Жоғарыда Хасанитоның іскерлік қоңырауы болды.
Dialogue: 0,0:03:28.91,0:03:31.23,Default,,0,0,0,,♬ Кері санауға дайынсыз ба
Dialogue: 0,0:03:31.23,0:03:33.52,Default,,0,0,0,,♬ Жүгіруге жол жоқ
Dialogue: 0,0:03:33.52,0:03:42.49,Default,,0,0,0,,♬～
Dialogue: 0,0:03:42.49,0:03:47.35,Default,,0,0,0,,♬ Оңай диапазонға түспеңіз.
Dialogue: 0,0:03:47.35,0:03:52.07,Default,,0,0,0,,♬ Бұл қырғи-қабақ соғыс аймағы. Қазіргі жағдай жалықтырады.
Dialogue: 0,0:03:52.07,0:03:56.62,Default,,0,0,0,,♬ Ей, балалар, сондықтан сен ерекше екенсің.
Dialogue: 0,0:03:56.62,0:03:58.68,Default,,0,0,0,,♬ Баяғыда сыйымдылық асып кеткен
Dialogue: 0,0:03:58.68,0:04:01.03,Default,,0,0,0,,♬ Өзін-өзі мазақ ету түбі жоқ сезім
Dialogue: 0,0:04:01.03,0:04:03.06,Default,,0,0,0,,♬ Өте сүйкімді
Dialogue: 0,0:04:03.06,0:04:06.10,Default,,0,0,0,,♬ Мен саған ақымақтығымды көрсете алмаймын.
Dialogue: 0,0:04:06.10,0:04:08.14,Default,,0,0,0,,♬ Бекер толқу
Dialogue: 0,0:04:08.14,0:04:10.14,Default,,0,0,0,,♬ Тек ынталандыру үшін
Dialogue: 0,0:04:11.44,0:04:13.99,Default,,0,0,0,,♬ Қабылдау/бүлік Екі ғана таңдау бар ма?
Dialogue: 0,0:04:13.99,0:04:17.83,Default,,0,0,0,,♬ ah Эстетика «Мен ешкімге тиіспеймін»
Dialogue: 0,0:04:17.83,0:04:19.88,Default,,0,0,0,,♬ Жараның кінәсіздігі
Dialogue: 0,0:04:19.88,0:04:22.48,Default,,0,0,0,,♬ Мен де сол топқа кіремін.
Dialogue: 0,0:04:22.48,0:04:24.50,Default,,0,0,0,,♬ орылатын болады
Dialogue: 0,0:04:24.50,0:04:27.04,Default,,0,0,0,,♬ Ешбір жағдайда әрқашан жалғасуда
Dialogue: 0,0:04:27.04,0:04:31.13,Default,,0,0,0,,♬ Белдемшенің етегі туралы шындық
Dialogue: 0,0:04:31.13,0:04:36.26,Default,,0,0,0,,♬ Тек ақымақ сияқты сеніңіз
Dialogue: 0,0:04:36.26,0:04:40.37,Default,,0,0,0,,♬ Маған қатты әсер етті
Dialogue: 0,0:04:40.37,0:04:47.08,Default,,0,0,0,,♬ Жай ғана твиттер қалдырыңыз.
Dialogue: 0,0:04:47.08,0:04:56.48,Default,,0,0,0,,♬～
Dialogue: 0,0:05:09.50,0:05:20.71,Default,,0,0,0,,♬～
Dialogue: 0,0:05:20.71,0:05:23.51,Default,,0,0,0,,Мм... Токаку мырза. (Токаку) Бұл не?
Dialogue: 0,0:05:25.51,0:05:29.67,Default,,0,0,0,,Ал... Мен өткен күнді айтып отырмын.
Dialogue: 0,0:05:29.67,0:05:31.87,Default,,0,0,0,,Эй мырза айтты...
Dialogue: 0,0:05:33.84,0:05:36.21,Default,,0,0,0,,((Эй айтқан сөздер...➡
Dialogue: 0,0:05:36.21,0:05:39.01,Default,,0,0,0,,Аналық ара болу деген нені білдіреді? ))
Dialogue: 0,0:05:39.01,0:05:43.10,Default,,0,0,0,,♬～
Dialogue: 0,0:05:43.10,0:05:46.40,Default,,0,0,0,,Бұл жерде не туралы сөйлескіңіз келеді?
Dialogue: 0,0:05:48.17,0:05:51.14,Default,,0,0,0,,Бүгін кешке бәрін түсіндіремін➡
Dialogue: 0,0:05:51.14,0:05:53.76,Default,,0,0,0,,Дайын тұрыңыз.
Dialogue: 0,0:05:53.76,0:05:57.73,Default,,0,0,0,,Екеуің жеңдіңдер.
Dialogue: 0,0:05:57.73,0:06:00.90,Default,,0,0,0,,♬～
Dialogue: 0,0:06:00.90,0:06:02.93,Default,,0,0,0,,Сіз жеңдіңіз бе?
Dialogue: 0,0:06:02.93,0:06:07.33,Default,,0,0,0,,Біз олардың бәрін жеңдік, Токаку-сан, басын қатерге тігіп.
Dialogue: 0,0:06:08.74,0:06:10.78,Default,,0,0,0,,Алға
Dialogue: 0,0:06:10.78,0:06:12.81,Default,,0,0,0,,Баяу тамақтаныңыз. Ах...
Dialogue: 0,0:06:12.81,0:06:15.16,Default,,0,0,0,,Өйткені енді саған ешкім шабуыл жасамайды.
Dialogue: 0,0:06:15.16,0:06:34.50,Default,,0,0,0,,♬～
Dialogue: 0,0:06:34.50,0:06:41.17,Default,,0,0,0,,♬～
Dialogue: 0,0:06:41.17,0:06:45.14,Default,,0,0,0,,((Уфуфу, аянышты. Міне ана араның құдіреті➡)
Dialogue: 0,0:06:45.14,0:06:47.93,Default,,0,0,0,,Байқамай)) ((Ара патшайымы?))
Dialogue: 0,0:06:47.93,0:06:50.95,Default,,0,0,0,,((Жұмысшы аралар мен қояндар ұқсас➡
Dialogue: 0,0:06:50.95,0:06:54.95,Default,,0,0,0,,Екеуі де араның арасы үшін жанын қиды))
Dialogue: 0,0:06:58.07,0:07:00.11,Default,,0,0,0,,≪Бұл жай ғана блеф емес пе?≫
Dialogue: 0,0:07:00.11,0:07:03.04,Default,,0,0,0,,≪Маған не керек?≫
Dialogue: 0,0:07:03.04,0:07:07.06,Default,,0,0,0,,Ал, төраға қорытындылау жұмысын жақсы орындайды.
Dialogue: 0,0:07:07.06,0:07:09.85,Default,,0,0,0,,Сіз Харудың туысысыз ба? Сол адам
Dialogue: 0,0:07:09.85,0:07:12.14,Default,,0,0,0,,Біз бұрын-соңды кездескен емеспіз➡
Dialogue: 0,0:07:12.14,0:07:16.52,Default,,0,0,0,,Харудың отбасы мүшелерімен онша байланысы жоқ...➡
Dialogue: 0,0:07:16.52,0:07:19.36,Default,,0,0,0,,Мен жай ғана қалыпты өмір сүрдім.
Dialogue: 0,0:07:19.36,0:07:22.48,Default,,0,0,0,,Тағы да! Өміріңізге қауіп төніп тұр➡
Dialogue: 0,0:07:22.48,0:07:24.48,Default,,0,0,0,,Бұл қалыпты емес.
Dialogue: 0,0:07:27.10,0:07:29.67,Default,,0,0,0,,Кешіріңіз, мен тым көп айттым.
Dialogue: 0,0:07:29.67,0:07:33.88,Default,,0,0,0,,Жоқ, бұл дұрыс.
Dialogue: 0,0:07:33.88,0:07:35.98,Default,,0,0,0,,Жақсы ауа-райы...
Dialogue: 0,0:07:35.98,0:07:39.61,Default,,0,0,0,,Жақсы, Хару. иә?
Dialogue: 0,0:07:39.61,0:07:44.55,Default,,0,0,0,,Хару Хината әлемінен, ол біздікінен бөлек.
Dialogue: 0,0:07:44.55,0:07:52.56,Default,,0,0,0,,♬～
Dialogue: 0,0:07:52.56,0:07:54.61,Default,,0,0,0,,≪Mr. Токаку! ≪Tattatatta… (аяқ дыбысы)
Dialogue: 0,0:07:54.61,0:07:57.23,Default,,0,0,0,,Кешіріңіз, кешігіп қалдым. Барайық.
Dialogue: 0,0:07:57.23,0:08:16.50,Default,,0,0,0,,♬～
Dialogue: 0,0:08:16.50,0:08:19.30,Default,,0,0,0,,♬～
Dialogue: 0,0:08:21.14,0:08:25.51,Default,,0,0,0,,Бұдан былай біз шынайы бағдарды өткізетін боламыз.
Dialogue: 0,0:08:25.51,0:08:30.46,Default,,0,0,0,,Алдымен, Блэк тобының ұйымдастырушысы, мектебіміздің президенті Хаджиме Юримеден➡
Dialogue: 0,0:08:30.46,0:08:32.96,Default,,0,0,0,,Сәлемдесу.
Dialogue: 0,0:08:35.30,0:08:38.31,Default,,0,0,0,,[Теледидар] (Юри) Азума-сан және Ичиноза-сан, танысқаныма қуаныштымын➡
Dialogue: 0,0:08:38.31,0:08:42.38,Default,,0,0,0,,Мен Юрий, төрағамын.➡
Dialogue: 0,0:08:42.38,0:08:45.65,Default,,0,0,0,,Қара топты сәтті жеңіп шыққандарыңызға➡
Dialogue: 0,0:08:45.65,0:08:49.20,Default,,0,0,0,,Алдымен сізді құттықтауға рұқсат етіңіз.
Dialogue: 0,0:08:49.20,0:08:52.30,Default,,0,0,0,,Құттықтаймыз. Пачи пачи…
Dialogue: 0,0:08:52.30,0:08:54.90,Default,,0,0,0,,Рахмет...
Dialogue: 0,0:08:56.86,0:09:01.16,Default,,0,0,0,,Маған түсіндіресіз бе? Бұл қара топ қандай болды?
Dialogue: 0,0:09:02.61,0:09:07.99,Default,,0,0,0,,Бізді осы мектепке жинағанда не істедік?
Dialogue: 0,0:09:07.99,0:09:10.09,Default,,0,0,0,,Балалар сендер кімсіңдер?
Dialogue: 0,0:09:12.62,0:09:15.51,Default,,0,0,0,,[Теледидар] Сіз бастаманың не екенін білесіз бе? ➡
Dialogue: 0,0:09:15.51,0:09:18.06,Default,,0,0,0,,Белгілі бір жасқа жеткендер➡
Dialogue: 0,0:09:18.06,0:09:22.07,Default,,0,0,0,,Қоғам мүшесі ретінде тану үшін қойылатын сынақтар.➡
Dialogue: 0,0:09:22.07,0:09:25.75,Default,,0,0,0,,Біздің отбасының қыздары 15-ке толғанда➡
Dialogue: 0,0:09:25.75,0:09:29.59,Default,,0,0,0,,Сіз міндетті түрде сынақтан өтесіз.➡
Dialogue: 0,0:09:29.59,0:09:34.20,Default,,0,0,0,,Бұл дәл сен ойлағандай, Хигаши Токаку-сан.➡
Dialogue: 0,0:09:34.20,0:09:38.90,Default,,0,0,0,,Қара труппа Харуды өлтіруге келмеді.➡
Dialogue: 0,0:09:38.90,0:09:43.89,Default,,0,0,0,,Хару 12 өлтірушіден аман қала ма?➡
Dialogue: 0,0:09:43.89,0:09:47.28,Default,,0,0,0,,Көретін нәрсе. Ах...
Dialogue: 0,0:09:47.28,0:09:52.78,Default,,0,0,0,,Харуто, сіздің отбасыңыздың болашағын қамтамасыз ету үшін не қажет екенін білу үшін.
Dialogue: 0,0:09:52.78,0:09:55.17,Default,,0,0,0,,Отбасы? (Юри) Иә.➡
Dialogue: 0,0:09:55.17,0:10:00.10,Default,,0,0,0,,Бір қаннан бөлінген сансыз үйлердің үлкен тізбегі.
Dialogue: 0,0:10:00.10,0:10:03.46,Default,,0,0,0,,♬～
Dialogue: 0,0:10:03.46,0:10:06.16,Default,,0,0,0,,Біз әлемнің кез келген жеріндеміз➡
Dialogue: 0,0:10:06.16,0:10:08.86,Default,,0,0,0,,Дүниедегі барлық нәрсені қозғалысқа келтіреді.➡
Dialogue: 0,0:10:08.86,0:10:11.67,Default,,0,0,0,,Саяси-экономикалық әскери➡
Dialogue: 0,0:10:11.67,0:10:14.77,Default,,0,0,0,,Білім, мәдениет және өнер үшін.➡
Dialogue: 0,0:10:14.77,0:10:20.47,Default,,0,0,0,,Адамның барлық әрекеттеріне қатысады және капитал мен билікке ие.➡
Dialogue: 0,0:10:20.47,0:10:23.58,Default,,0,0,0,,Праймер топты басқарады.➡
Dialogue: 0,0:10:23.58,0:10:28.18,Default,,0,0,0,,Отбасының тек әйел мүшелерінде сирек кездесетін ерекше харизма.➡
Dialogue: 0,0:10:29.83,0:10:32.77,Default,,0,0,0,,Олар қалағанын жасайды➡
Dialogue: 0,0:10:32.77,0:10:35.42,Default,,0,0,0,,Немесе байқаусызда және бейсаналық➡
Dialogue: 0,0:10:35.42,0:10:40.14,Default,,0,0,0,,Адамдарды тартыңыз, тартыңыз, басқарыңыз және манипуляциялаңыз
Dialogue: 0,0:10:40.14,0:10:42.85,Default,,0,0,0,,Праймердің өміріне қауіп төніп тұр➡
Dialogue: 0,0:10:42.85,0:10:46.70,Default,,0,0,0,,Көрсетілген және нақтыланған.➡
Dialogue: 0,0:10:46.70,0:10:49.64,Default,,0,0,0,,Демек, әйел отбасы дүниеге келген кезден➡
Dialogue: 0,0:10:49.64,0:10:52.04,Default,,0,0,0,,Менің өмірім мақсатты түрде жалғасуда
Dialogue: 0,0:10:53.71,0:10:56.78,Default,,0,0,0,,Харудың күші өте күшті.➡
Dialogue: 0,0:10:56.78,0:11:00.08,Default,,0,0,0,,Қара топтың сынақтары сәтті өтті.➡
Dialogue: 0,0:11:00.08,0:11:02.90,Default,,0,0,0,,Мен бұл тамаша праймер болатынына сенімдімін
Dialogue: 0,0:11:02.90,0:11:05.50,Default,,0,0,0,,Ах... Адамдарды манипуляциялау?
Dialogue: 0,0:11:05.50,0:11:07.54,Default,,0,0,0,,Иә. Адамның өзі➡
Dialogue: 0,0:11:07.54,0:11:11.88,Default,,0,0,0,,Бұл ниет болды ма, білмеймін.➡
Dialogue: 0,0:11:11.88,0:11:14.98,Default,,0,0,0,,Сонымен, ашық аспанның сақшысы болсаң➡
Dialogue: 0,0:11:14.98,0:11:17.38,Default,,0,0,0,,Мен не айта бастадым➡
Dialogue: 0,0:11:17.38,0:11:21.19,Default,,0,0,0,,Біздің көзқарасымыз бойынша, бәрі күткендей.
Dialogue: 0,0:11:21.19,0:11:23.59,Default,,0,0,0,,Ах! басқа!
Dialogue: 0,0:11:25.04,0:11:27.31,Default,,0,0,0,,Харутода мұндай күш жоқ!
Dialogue: 0,0:11:27.31,0:11:31.90,Default,,0,0,0,,Хару бұл сынақты ғана тапсырса, бәрі бітеді дейді!
Dialogue: 0,0:11:31.90,0:11:34.30,Default,,0,0,0,,Сіз қалыпты өмір сүре аласыз!
Dialogue: 0,0:11:34.30,0:11:39.79,Default,,0,0,0,,Демек, манипуляция немесе бақылау деген жоқ!
Dialogue: 0,0:11:39.79,0:11:42.82,Default,,0,0,0,,Олай болса күші жоқ сен➡
Dialogue: 0,0:11:42.82,0:11:45.68,Default,,0,0,0,,Неліктен 12 өлтірушімен күресуге тура келді➡
Dialogue: 0,0:11:45.68,0:11:47.98,Default,,0,0,0,,Сіз аман қалдыңыз ба?
Dialogue: 0,0:11:50.16,0:11:52.83,Default,,0,0,0,,Сені бүгінге дейін тірі қалдыру үшін➡
Dialogue: 0,0:11:52.83,0:11:56.59,Default,,0,0,0,,Көптеген құрбандықтар шалынды.➡
Dialogue: 0,0:11:56.59,0:11:59.57,Default,,0,0,0,,Сізді тәрбиелеген мекемедегі адамдар➡
Dialogue: 0,0:11:59.57,0:12:04.56,Default,,0,0,0,,Аурухана қызметкерлері Көршілер Туыстары Отбасы мүшелері
Dialogue: 0,0:12:04.56,0:12:10.33,Default,,0,0,0,,♬～
Dialogue: 0,0:12:10.33,0:12:13.75,Default,,0,0,0,,Ха! Олар бақытты болуы керек еді➡
Dialogue: 0,0:12:13.75,0:12:16.74,Default,,0,0,0,,Мен сен үшін өле аламын
Dialogue: 0,0:12:16.74,0:12:19.44,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:12:19.44,0:12:23.05,Default,,0,0,0,,Бүгінгі күнге дейін аман қалғаныңыздың өзі➡
Dialogue: 0,0:12:23.05,0:12:25.97,Default,,0,0,0,,Сіздің ерекше екеніңізді дәлелдеу
Dialogue: 0,0:12:25.97,0:12:30.27,Default,,0,0,0,,Тоқта! Күн шуақты... Күн басқа!
Dialogue: 0,0:12:32.59,0:12:35.14,Default,,0,0,0,,Эй... Күн шуақты! [ТД] (Юри) Жақсы➡
Dialogue: 0,0:12:35.14,0:12:37.80,Default,,0,0,0,,Мені біраз уақытқа қалдыршы.➡
Dialogue: 0,0:12:37.80,0:12:41.85,Default,,0,0,0,,Күннің ашық екенін білу керек.➡
Dialogue: 0,0:12:41.85,0:12:44.39,Default,,0,0,0,,Азума Токаку мырза➡
Dialogue: 0,0:12:44.39,0:12:46.95,Default,,0,0,0,,Сізге не керек?
Dialogue: 0,0:12:46.95,0:12:49.14,Default,,0,0,0,,Үміт?
Dialogue: 0,0:12:49.14,0:12:51.98,Default,,0,0,0,,[Телевизия] (Юри) Сіз де Харуды жеңіске жетеледіңіз➡
Dialogue: 0,0:12:51.98,0:12:55.16,Default,,0,0,0,,Мен қара топты жеңімпаз деп танимын.➡
Dialogue: 0,0:12:55.16,0:12:59.26,Default,,0,0,0,,Мен сіз қалаған сыйлықты дайындаймын. Құттықтаймыз.
Dialogue: 0,0:13:01.24,0:13:06.57,Default,,0,0,0,,[ТД] Қазір жауап берудің қажеті жоқ. Ойлан. Уақытыңыз бар.
Dialogue: 0,0:13:06.57,0:13:11.46,Default,,0,0,0,,♬～
Dialogue: 0,0:13:11.46,0:13:13.56,Default,,0,0,0,,Дыбыстық сигнал, мінекей➡
Dialogue: 0,0:13:13.56,0:13:16.86,Default,,0,0,0,,Шынайы бағдарлау аяқталды.
Dialogue: 0,0:15:24.48,0:15:37.74,Default,,0,0,0,,♬～
Dialogue: 0,0:15:37.74,0:15:39.81,Default,,0,0,0,,Хару руына➡
Dialogue: 0,0:15:39.81,0:15:43.26,Default,,0,0,0,,Мен мұндай ерекше адамдардың бар екенін білдім.
Dialogue: 0,0:15:43.26,0:15:47.13,Default,,0,0,0,,Бірақ мен оның маған еш қатысы жоқ деп ойладым.
Dialogue: 0,0:15:47.13,0:15:52.74,Default,,0,0,0,,Харудың үйі отбасының ең соңында...
Dialogue: 0,0:15:52.74,0:15:55.71,Default,,0,0,0,,Харуда мұндай күш болуы мүмкін емес➡
Dialogue: 0,0:15:55.71,0:15:57.76,Default,,0,0,0,,Бұл ешқашан болмайды➡
Dialogue: 0,0:15:57.76,0:15:59.76,Default,,0,0,0,,Жақсы ауа-райы...
Dialogue: 0,0:16:01.07,0:16:03.10,Default,,0,0,0,,Төраға –➡
Dialogue: 0,0:16:03.10,0:16:07.00,Default,,0,0,0,,Праймер өзінің де санасыз жұмыс істейтінін айтты.
Dialogue: 0,0:16:09.22,0:16:13.23,Default,,0,0,0,,Дағдарысқа ұшыраған сайын күштірек көрсетіледі дейді.
Dialogue: 0,0:16:13.23,0:16:18.13,Default,,0,0,0,,Сіз Хару қара топтағылардың барлығын оларға жеңіл жүру үшін айла-шарғы жасады деп айтасыз ба?
Dialogue: 0,0:16:18.13,0:16:21.97,Default,,0,0,0,,Жоқ! Барлығын манипуляциялаудың қажеті жоқ
Dialogue: 0,0:16:21.97,0:16:26.07,Default,,0,0,0,,Мені өзіңе одақтас етіп, қорғасаң болғаны.
Dialogue: 0,0:16:27.62,0:16:32.26,Default,,0,0,0,,Сіз басқаша дәлелдей аласыз ба?
Dialogue: 0,0:16:32.26,0:16:35.72,Default,,0,0,0,,Күн шуақты... Жай ғана➡
Dialogue: 0,0:16:35.72,0:16:39.82,Default,,0,0,0,,Мен Токаку-санмен жау болғым келмейді...
Dialogue: 0,0:16:41.62,0:16:44.21,Default,,0,0,0,,Бұл оны дәлелдеу мүмкін емес дегенді білдіреді.
Dialogue: 0,0:16:44.21,0:16:50.53,Default,,0,0,0,,♬～
Dialogue: 0,0:16:50.53,0:16:52.53,Default,,0,0,0,,Токаку!
Dialogue: 0,0:16:54.07,0:16:56.37,Default,,0,0,0,,Гача соққысы (есік дыбысы)
Dialogue: 0,0:16:56.37,0:17:01.08,Default,,0,0,0,,♬～
Dialogue: 0,0:17:01.08,0:17:04.11,Default,,0,0,0,,[ДК] (Қайба) Жалпы мәліметтерді естідім.➡
Dialogue: 0,0:17:04.11,0:17:06.35,Default,,0,0,0,,(Виолет) Енді біз майордан бұйрық алмаймыз ба?
Dialogue: 0,0:17:06.35,0:17:08.52,Default,,0,0,0,,Әзірше тойлайық.➡
Dialogue: 0,0:17:08.52,0:17:11.02,Default,,0,0,0,,Қара тобын жеңісімен құттықтаймыз
Dialogue: 0,0:17:12.37,0:17:14.62,Default,,0,0,0,,Сіз білесіз бе? [ДК] (Қайба) Иә?
Dialogue: 0,0:17:14.62,0:17:17.17,Default,,0,0,0,,Курогумидің шынайы мағынасы
Dialogue: 0,0:17:17.17,0:17:20.17,Default,,0,0,0,,Отбасы және Primer туралы
Dialogue: 0,0:17:22.30,0:17:24.50,Default,,0,0,0,,[ДК] Хахахахаха.➡
Dialogue: 0,0:17:24.50,0:17:27.80,Default,,0,0,0,,Токаку, мұны естігеннен кейін не істеу керек?
Dialogue: 0,0:17:29.37,0:17:33.17,Default,,0,0,0,,«Иә, дұрыс» деп жауап берсем, осында➡
Dialogue: 0,0:17:33.17,0:17:36.07,Default,,0,0,0,,Сіздің ішіңізде бірдеңе өзгере ме?
Dialogue: 0,0:17:38.33,0:17:41.72,Default,,0,0,0,,Аа~а~ Міне, бала
Dialogue: 0,0:17:41.72,0:17:44.13,Default,,0,0,0,,Сақ болыңыз.
Dialogue: 0,0:17:44.13,0:17:46.94,Default,,0,0,0,,Бұл мен сізге беретін мәселе➡
Dialogue: 0,0:17:46.94,0:17:49.87,Default,,0,0,0,,Дұрыс жауап жоқ, солай ма?
Dialogue: 0,0:17:49.87,0:17:52.94,Default,,0,0,0,,Жоқ! Жауабы болса➡
Dialogue: 0,0:17:52.94,0:17:56.58,Default,,0,0,0,,Токаку Бұл тек сіздің ішіңізде
Dialogue: 0,0:17:56.58,0:17:59.10,Default,,0,0,0,,Бар күшіңмен қазып ал.➡
Dialogue: 0,0:17:59.10,0:18:02.00,Default,,0,0,0,,[ДК] Барлық миыңызбен ойланыңыз.
Dialogue: 0,0:18:04.00,0:18:07.27,Default,,0,0,0,,[ДК] (Қайба) Мен жай ғана баға қоямын.➡
Dialogue: 0,0:18:07.27,0:18:11.21,Default,,0,0,0,,Себебі мен сенің мұғаліміңмін.
Dialogue: 0,0:18:11.21,0:18:13.21,Default,,0,0,0,,Конкон (қағу)
Dialogue: 0,0:18:17.23,0:18:20.94,Default,,0,0,0,,Бұл не? Осындай уақытта
Dialogue: 0,0:18:20.94,0:18:23.91,Default,,0,0,0,,Мені Юрий-санға апарыңыз
Dialogue: 0,0:18:23.91,0:18:33.48,Default,,0,0,0,,♬～
Dialogue: 0,0:18:33.48,0:18:45.78,Default,,0,0,0,,♬～
Dialogue: 0,0:18:49.15,0:18:53.44,Default,,0,0,0,,((Мен енді ешкімді өлтіргім келмейді!))
Dialogue: 0,0:18:53.44,0:18:56.47,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:18:56.47,0:18:58.89,Default,,0,0,0,,((Мен сен туралы ойлаймын➡
Dialogue: 0,0:18:58.89,0:19:01.46,Default,,0,0,0,,Мен ештеңе білмедім))
Dialogue: 0,0:19:01.46,0:19:06.13,Default,,0,0,0,,((Бұл барлық облигациялардан құтылудың жалғыз жолы))
Dialogue: 0,0:19:06.13,0:19:09.47,Default,,0,0,0,,((Егер сен мені өлтіре алсаң➡
Dialogue: 0,0:19:09.47,0:19:12.67,Default,,0,0,0,,Бұлай болмауы керек еді))
Dialogue: 0,0:19:12.67,0:19:16.59,Default,,0,0,0,,)
Dialogue: 0,0:19:16.59,0:19:19.05,Default,,0,0,0,,<<Тіпті мен білмеймін>>
Dialogue: 0,0:19:19.05,0:19:23.27,Default,,0,0,0,,≪Неге мен Харуды қорғағым келді?≫
Dialogue: 0,0:19:23.27,0:19:25.70,Default,,0,0,0,,≪Оны қалай дәлелдей аламын? ≫
Dialogue: 0,0:19:25.70,0:19:27.74,Default,,0,0,0,,≪Соңында бұл да➡
Dialogue: 0,0:19:27.74,0:19:30.59,Default,,0,0,0,,Ешкім жауап бере алмайтын жұмбақ≫
Dialogue: 0,0:19:30.59,0:19:33.93,Default,,0,0,0,,♬～
Dialogue: 0,0:19:33.93,0:19:35.96,Default,,0,0,0,,Қарғыс атсын! мылтық!
Dialogue: 0,0:19:35.96,0:19:55.85,Default,,0,0,0,,♬～
Dialogue: 0,0:19:55.85,0:19:59.85,Default,,0,0,0,,♬～
Dialogue: 0,0:20:01.22,0:20:04.11,Default,,0,0,0,,Мен кланға қосылмаймын.
Dialogue: 0,0:20:04.11,0:20:07.66,Default,,0,0,0,,Менің адамдарды басқаруға күшім жетпейді.
Dialogue: 0,0:20:07.66,0:20:10.83,Default,,0,0,0,,Мен жай ғана отбасымның қалағанын жасадым➡
Dialogue: 0,0:20:10.83,0:20:14.20,Default,,0,0,0,,Мен жай ғана қалыпты өмір сүргім келеді.
Dialogue: 0,0:20:14.20,0:20:17.00,Default,,0,0,0,,Бұл сіздің жауабыңыз ба?
Dialogue: 0,0:20:17.00,0:20:19.06,Default,,0,0,0,,Иә
Dialogue: 0,0:20:19.06,0:20:22.38,Default,,0,0,0,,Сонымен сен үшін жанын қиғандар➡
Dialogue: 0,0:20:22.38,0:20:25.08,Default,,0,0,0,,Бұл қолайлы деп ойлайсыз ба?
Dialogue: 0,0:20:25.08,0:20:28.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:28.17,0:20:30.17,Default,,0,0,0,,Мен...
Dialogue: 0,0:20:31.64,0:20:35.21,Default,,0,0,0,,Хару, мен сенің қарағаныңды қалаймын.
Dialogue: 0,0:20:35.21,0:20:39.09,Default,,0,0,0,,Ах... (Юри) Неджи мырза, сол жаққа өтіңіз➡
Dialogue: 0,0:20:39.09,0:20:41.21,Default,,0,0,0,,Маған айналаны көрсет
Dialogue: 0,0:20:41.21,0:20:50.85,Default,,0,0,0,,♬～
Dialogue: 0,0:20:50.85,0:20:52.91,Default,,0,0,0,,Бұл өте терең, солай емес пе?
Dialogue: 0,0:20:52.91,0:20:57.66,Default,,0,0,0,,Бұдан былай тек клан мүшелері кіре алады.
Dialogue: 0,0:20:57.66,0:21:01.23,Default,,0,0,0,,♬～
Dialogue: 0,0:21:01.23,0:21:03.28,Default,,0,0,0,,Чиен (лифт дыбысы)
Dialogue: 0,0:21:03.28,0:21:23.00,Default,,0,0,0,,♬～
Dialogue: 0,0:21:23.00,0:21:26.14,Default,,0,0,0,,Бұл зират
Dialogue: 0,0:21:26.14,0:21:30.66,Default,,0,0,0,,Отбасы үшін қаза тапқандардың барлығына арналған дұға орны.
Dialogue: 0,0:21:30.66,0:21:33.70,Default,,0,0,0,,Бұл жерде жерленген сүйектер мен мәйіттер жоқ сияқты.
Dialogue: 0,0:21:33.70,0:21:36.33,Default,,0,0,0,,Мұнда тек аты бар
Dialogue: 0,0:21:36.33,0:21:40.17,Default,,0,0,0,,Барлық өлгендердің есімін ешқашан ұмытпайық➡
Dialogue: 0,0:21:40.17,0:21:42.57,Default,,0,0,0,,Ол ойып жазылған. Ах...
Dialogue: 0,0:21:44.09,0:21:47.39,Default,,0,0,0,,Бастапқыда бұл қаралы жер болған.
Dialogue: 0,0:21:47.39,0:21:50.76,Default,,0,0,0,,Myoujo академиясы кейінірек құрылды.
Dialogue: 0,0:21:50.76,0:21:53.10,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:21:53.10,0:21:57.10,Default,,0,0,0,,Мектеп күлкіге толы, солай ма? ➡
Dialogue: 0,0:21:57.10,0:21:59.17,Default,,0,0,0,,Өлгендердің жаны➡
Dialogue: 0,0:21:59.17,0:22:03.49,Default,,0,0,0,,Болашақта өмір сүретін балалардың дауысымен жұбату үшін➡
Dialogue: 0,0:22:03.49,0:22:06.53,Default,,0,0,0,,«Біз ешқашан жыламаймыз.➡
Dialogue: 0,0:22:06.53,0:22:09.42,Default,,0,0,0,,Мәңгі кездескенше➡
Dialogue: 0,0:22:09.42,0:22:12.19,Default,,0,0,0,,Біз әлемді қалай жеңеміз».
Dialogue: 0,0:22:12.19,0:22:20.76,Default,,0,0,0,,♬～
Dialogue: 0,0:22:20.76,0:22:22.81,Default,,0,0,0,,Жалғыздық, солай емес пе?
Dialogue: 0,0:22:22.81,0:22:25.38,Default,,0,0,0,,Ерекше күшпен туылғандар➡
Dialogue: 0,0:22:25.38,0:22:27.88,Default,,0,0,0,,Бұл өмір сүрудің жалғыз жолы
Dialogue: 0,0:22:29.60,0:22:34.21,Default,,0,0,0,,Хару Учихане Мен өмір бойы жалғыз болдым.
Dialogue: 0,0:22:34.21,0:22:38.40,Default,,0,0,0,,Бізді құтқарған төраға болды.
Dialogue: 0,0:22:38.40,0:22:40.85,Default,,0,0,0,,Юрий-сан?
Dialogue: 0,0:22:40.85,0:22:44.47,Default,,0,0,0,,Кейбір адамдарды өз руының күшімен құтқаруға болатындығы➡
Dialogue: 0,0:22:44.47,0:22:46.47,Default,,0,0,0,,Есте сақтағаныңызды қалаймын
Dialogue: 0,0:22:48.09,0:23:00.45,Default,,0,0,0,,♬～
Dialogue: 0,0:23:00.45,0:23:03.27,Default,,0,0,0,,((Бұл туралы біраз уақыт өз бетіңізше ойлану жақсы.➡
Dialogue: 0,0:23:03.27,0:23:05.71,Default,,0,0,0,,Мен сені кейін алып кетемін))
Dialogue: 0,0:23:05.71,0:23:16.50,Default,,0,0,0,,♬～
Dialogue: 0,0:23:16.50,0:23:18.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:18.54,0:23:23.64,Default,,0,0,0,,♬～
Dialogue: 0,0:23:23.64,0:23:26.31,Default,,0,0,0,,Әке Ана➡
Dialogue: 0,0:23:26.31,0:23:28.46,Default,,0,0,0,,Үлкен ағасы Ватару...
Dialogue: 0,0:23:28.46,0:23:31.75,Default,,0,0,0,,♬～
Dialogue: 0,0:23:31.75,0:23:34.37,Default,,0,0,0,,((Хахаха!➡
Dialogue: 0,0:23:34.37,0:23:36.54,Default,,0,0,0,,Туған күніңмен))
Dialogue: 0,0:23:36.54,0:23:38.56,Default,,0,0,0,,()
Dialogue: 0,0:23:38.56,0:23:41.01,Default,,0,0,0,,((Туғаныңыз үшін рахмет.
Dialogue: 0,0:23:41.01,0:23:45.10,Default,,0,0,0,,Хару, сенімен бірге болғаныма өте қуаныштымын))
Dialogue: 0,0:23:45.10,0:23:48.17,Default,,0,0,0,,)
Dialogue: 0,0:23:48.17,0:23:52.82,Default,,0,0,0,,♬～
Dialogue: 0,0:23:52.82,0:23:55.54,Default,,0,0,0,,Анам… Анам бұл➡
Dialogue: 0,0:23:55.54,0:23:58.99,Default,,0,0,0,,Сен Харуды сүйгендіктен оны қорғадың ба?
Dialogue: 0,0:23:58.99,0:24:01.29,Default,,0,0,0,,Немесе мүмкін Хару...
Dialogue: 0,0:24:03.83,0:24:05.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:07.23,0:24:25.80,Default,,0,0,0,,♬～
Dialogue: 0,0:24:25.80,0:24:27.84,Default,,0,0,0,,Токаку мырза
Dialogue: 0,0:24:27.84,0:24:30.07,Default,,0,0,0,,Мен бұл туралы ойладым
Dialogue: 0,0:24:30.07,0:24:35.45,Default,,0,0,0,,Маған қызық, сіз екеуміз кездескен кезде не керек еді.
Dialogue: 0,0:24:35.45,0:24:38.78,Default,,0,0,0,,Осы уақытқа дейін тек айтқанын орындадым➡
Dialogue: 0,0:24:38.78,0:24:42.90,Default,,0,0,0,,Бұл тек сынақтан өткен қуыршақ сияқты болды.
Dialogue: 0,0:24:42.90,0:24:47.87,Default,,0,0,0,,Қорғағым келетін ештеңе, өмір сүру мақсатым болмады.
Dialogue: 0,0:24:47.87,0:24:51.07,Default,,0,0,0,,Мен оның жоқ екенін де түсінбедім.
Dialogue: 0,0:24:53.01,0:24:56.88,Default,,0,0,0,,Мен мұны сені кездескен кезде ғана түсіндім.
Dialogue: 0,0:24:56.88,0:24:59.67,Default,,0,0,0,,Сен маған бәрін үйреттің
Dialogue: 0,0:24:59.67,0:25:02.56,Default,,0,0,0,,Менің бүгінгі күнге дейін өмір сүргенім –➡
Dialogue: 0,0:25:02.56,0:25:07.48,Default,,0,0,0,,Сіздің алдыңызда осылай тұру керек шығар.
Dialogue: 0,0:25:07.48,0:25:09.58,Default,,0,0,0,,Токаку мырза...
Dialogue: 0,0:25:09.58,0:25:11.68,Default,,0,0,0,,Рахмет саған Хару
Dialogue: 0,0:25:11.68,0:25:15.64,Default,,0,0,0,,Мен сені кездестіргеніме өте қуаныштымын.
Dialogue: 0,0:25:15.64,0:25:19.11,Default,,0,0,0,,♬～
Dialogue: 0,0:25:19.11,0:25:21.69,Default,,0,0,0,,Міне, мен➡
Dialogue: 0,0:25:21.69,0:25:23.78,Default,,0,0,0,,Мұны істеу керек
Dialogue: 0,0:25:23.78,0:25:27.40,Default,,0,0,0,,♬～
Dialogue: 0,0:25:27.40,0:25:29.43,Default,,0,0,0,,Ха!
Dialogue: 0,0:25:29.43,0:25:38.03,Default,,0,0,0,,♬～
Dialogue: 0,0:25:39.39,0:25:48.39,Default,,0,0,0,,♬～
Dialogue: 0,0:25:48.39,0:25:52.72,Default,,0,0,0,,♬ Мен тек жетіспейтін заттарды жинауға тырыстым
Dialogue: 0,0:25:52.72,0:25:57.13,Default,,0,0,0,,♬ Жүрегімдегі алшақтық ұлғайып барады
Dialogue: 0,0:25:57.13,0:26:01.50,Default,,0,0,0,,♬ Дүниеде жарық болса да
Dialogue: 0,0:26:01.50,0:26:05.90,Default,,0,0,0,,♬ Оның маған еш қатысы жоқ екеніне сенімдімін.
Dialogue: 0,0:26:05.90,0:26:08.99,Default,,0,0,0,,♬ Ұсқынсыз немесе ебедейсіз болса да
Dialogue: 0,0:26:08.99,0:26:12.33,Default,,0,0,0,,♬ Мен бұл жерден бір күні ұшып кетемін
Dialogue: 0,0:26:12.33,0:26:15.35,Default,,0,0,0,,♬ Қызыл жұлдызды бағыттаушы тірек ретінде пайдаланыңыз
Dialogue: 0,0:26:15.35,0:26:19.90,Default,,0,0,0,,♬ Бұрын ешкім көрмеген жерге
Dialogue: 0,0:26:19.90,0:26:24.17,Default,,0,0,0,,♬ Қалағаныңыз болса
Dialogue: 0,0:26:24.17,0:26:28.71,Default,,0,0,0,,♬ Кез келген жолмен
Dialogue: 0,0:26:28.71,0:26:32.98,Default,,0,0,0,,♬ Бұл ереже
Dialogue: 0,0:26:32.98,0:26:36.35,Default,,0,0,0,,♬ Мен осылай өмір сүрдім
Dialogue: 0,0:26:36.35,0:26:39.00,Default,,0,0,0,,♬ Шындық
Dialogue: 0,0:26:39.00,0:26:41.29,Default,,0,0,0,,♬ Барлығы
Dialogue: 0,0:26:41.29,0:26:45.16,Default,,0,0,0,,♬ Сен маған айтпадың.
Dialogue: 0,0:26:45.16,0:26:47.93,Default,,0,0,0,,♬ Адамдардың жылуы үшін
Dialogue: 0,0:26:47.93,0:26:50.13,Default,,0,0,0,,♬ Ешқандай үмітім жоқ.
Dialogue: 0,0:26:50.13,0:26:53.13,Default,,0,0,0,,♬ Соңында не қалады
Dialogue: 0,0:26:53.13,0:26:56.74,Default,,0,0,0,,♬ Жалғыз
Dialogue: 0,0:26:56.74,0:27:06.44,Default,,0,0,0,,♬～
Dialogue: 0,0:28:40.57,0:28:42.63,Default,,0,0,0,,Сіз білесіз бе? Менің айтайын дегенім➡
Dialogue: 0,0:28:42.63,0:28:46.05,Default,,0,0,0,,Мұның бәрі бос сөз және еш жерде дұрыс жауап жоқ.➡
Dialogue: 0,0:28:46.05,0:28:49.02,Default,,0,0,0,,Бұл жүзді қалауыңызша ұстаңыз.➡
Dialogue: 0,0:28:49.02,0:28:53.12,Default,,0,0,0,,Бұл қара топта сіз берген жалғыз жауап.
Dialogue: 0,0:28:54.55,0:28:56.57,Default,,0,0,0,,«Куругуми үй бөлмесі»!
Dialogue: 0,0:28:56.57,0:29:00.21,Default,,0,0,0,,«Куро Сюита Ха» да 11 маусымда шығарылды.
Dialogue: 0,0:29:00.21,0:29:02.28,Default,,0,0,0,,Сіз де Токаку сатып алдыңыз ба? Әрине
Dialogue: 0,0:29:02.28,0:29:05.48,Default,,0,0,0,,Токаку-сан күткендей! Мен де шығарылым шарасына барғым келеді.
Dialogue: 0,0:29:05.48,0:29:07.95,Default,,0,0,0,,Жалғыз жүру қауіпті. Мен де сенің соңынан еремін.
Dialogue: 0,0:29:07.95,0:29:10.14,Default,,0,0,0,,Менімен барасың ба!? Алақай!
Dialogue: 0,0:29:10.14,0:29:12.17,Default,,0,0,0,,Қазір өтініш беріңіз! Оқиға ➡
Dialogue: 0,0:29:12.17,0:29:14.87,Default,,0,0,0,,Толық ақпаратты ресми веб-сайттан қараңыз.
Dialogue: 0,0:29:16.37,0:29:22.37,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory