Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:36.12,0:01:38.42,Default,,0,0,0,,Мизороки мырза күткендей➡
Dialogue: 0,0:01:38.42,0:01:42.09,Default,,0,0,0,,Біраз қисайып кеткен сияқты.➡
Dialogue: 0,0:01:42.09,0:01:44.11,Default,,0,0,0,,Хехе
Dialogue: 0,0:01:44.11,0:01:48.67,Default,,0,0,0,,♬～
Dialogue: 0,0:01:48.67,0:01:50.72,Default,,0,0,0,,≪Бір ғана адам қалды≫
Dialogue: 0,0:01:50.72,0:01:54.89,Default,,0,0,0,,♬～
Dialogue: 0,0:01:54.89,0:01:56.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:59.28,0:02:02.15,Default,,0,0,0,,Ичиноза мырза, мынау
Dialogue: 0,0:02:02.15,0:02:04.65,Default,,0,0,0,,О, бұл ескерту қағазы ма?
Dialogue: 0,0:02:06.97,0:02:09.09,Default,,0,0,0,,Өтініш жазылған конверт жоғалып кетті.
Dialogue: 0,0:02:09.09,0:02:11.19,Default,,0,0,0,,<<Адам-қадам (қадам)
Dialogue: 0,0:02:11.19,0:02:13.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:13.22,0:02:19.70,Default,,0,0,0,,♬～
Dialogue: 0,0:02:19.70,0:02:23.83,Default,,0,0,0,,Уайымдамаңыз. Бұл ескерту қағазы емес.➡
Dialogue: 0,0:02:23.83,0:02:27.79,Default,,0,0,0,,Бұл бүгінгі кешкі шайға шақыру.
Dialogue: 0,0:02:27.79,0:02:29.79,Default,,0,0,0,,Шай ішу?
Dialogue: 0,0:02:31.19,0:02:33.53,Default,,0,0,0,,♬ Кері санауға дайынсыз ба
Dialogue: 0,0:02:33.53,0:02:35.70,Default,,0,0,0,,♬ Жүгіруге жол жоқ
Dialogue: 0,0:02:35.70,0:02:44.76,Default,,0,0,0,,♬～
Dialogue: 0,0:02:44.76,0:02:49.39,Default,,0,0,0,,♬ Оңай шеңберге түспеңіз.
Dialogue: 0,0:02:49.39,0:02:54.40,Default,,0,0,0,,♬ Бұл қырғи-қабақ соғыс аймағы. Қазіргі жағдай жалықтырады.
Dialogue: 0,0:02:54.40,0:02:58.92,Default,,0,0,0,,♬ Ей, балалар, сондықтан сендер ерекше екенсіңдер.
Dialogue: 0,0:02:58.92,0:03:00.97,Default,,0,0,0,,♬ Баяғыда сыйымдылық асып кеткен
Dialogue: 0,0:03:00.97,0:03:03.22,Default,,0,0,0,,♬ Өзін-өзі мазақ ету түбі жоқ сезім
Dialogue: 0,0:03:03.22,0:03:05.26,Default,,0,0,0,,♬ Өте сүйкімді
Dialogue: 0,0:03:05.26,0:03:08.21,Default,,0,0,0,,♬ Мен саған ақымақтығымды көрсете алмаймын.
Dialogue: 0,0:03:08.21,0:03:10.26,Default,,0,0,0,,♬ Бекер толқу
Dialogue: 0,0:03:10.26,0:03:12.26,Default,,0,0,0,,♬ Тек ынталандыру үшін
Dialogue: 0,0:03:13.65,0:03:16.22,Default,,0,0,0,,♬ Қабылдау/Көтеріліс Тек екі таңдау бар ма?
Dialogue: 0,0:03:16.22,0:03:19.92,Default,,0,0,0,,♬ ah Эстетика «Мен ешкімге тиіспеймін»
Dialogue: 0,0:03:19.92,0:03:22.11,Default,,0,0,0,,♬ Жараның кінәсіздігі
Dialogue: 0,0:03:22.11,0:03:24.66,Default,,0,0,0,,♬ Мен де сол топқа кіремін.
Dialogue: 0,0:03:24.66,0:03:26.70,Default,,0,0,0,,♬ орылатын болады
Dialogue: 0,0:03:26.70,0:03:29.27,Default,,0,0,0,,♬ Ешбір жағдайда әрқашан жалғасуда
Dialogue: 0,0:03:29.27,0:03:33.25,Default,,0,0,0,,♬ Белдемшенің етегі туралы шындық
Dialogue: 0,0:03:33.25,0:03:38.43,Default,,0,0,0,,♬ Тек ақымақ сияқты сеніңіз
Dialogue: 0,0:03:38.43,0:03:42.60,Default,,0,0,0,,♬ Маған қатты әсер етті
Dialogue: 0,0:03:42.60,0:03:49.27,Default,,0,0,0,,♬ Оны твиттер арқылы жіберіңіз.
Dialogue: 0,0:03:49.27,0:03:58.67,Default,,0,0,0,,♬～
Dialogue: 0,0:04:11.76,0:04:15.35,Default,,0,0,0,,[Спикер] Ууууууу (дабыл)
Dialogue: 0,0:04:15.35,0:04:17.38,Default,,0,0,0,,≪(Түрме қызметкері) Мен оны жоғалтып алдым! ≪(Түрме қызметкері) Абайлаңыз! ➡
Dialogue: 0,0:04:17.38,0:04:19.43,Default,,0,0,0,,≪Оның өлімге әкелетін қаруы бар!
Dialogue: 0,0:04:19.43,0:04:23.19,Default,,0,0,0,,♬～
Dialogue: 0,0:04:23.19,0:04:25.69,Default,,0,0,0,,≪Күн ашық, күтіңіз≫
Dialogue: 0,0:04:28.16,0:04:31.53,Default,,0,0,0,,Ең жоғары сапалы Dimbla апельсин қабығы➡
Dialogue: 0,0:04:31.53,0:04:36.27,Default,,0,0,0,,Лимонграс Гибискус Эрика гүлі➡
Dialogue: 0,0:04:36.27,0:04:39.82,Default,,0,0,0,,Ерекше түн үшін хош иісті раушан шөптері де бар➡
Dialogue: 0,0:04:39.82,0:04:41.84,Default,,0,0,0,,Араластырайық
Dialogue: 0,0:04:41.84,0:04:56.72,Default,,0,0,0,,♬～
Dialogue: 0,0:04:56.72,0:05:00.87,Default,,0,0,0,,Шай үстінде Эй мырзамен дұрыс сөйлессеңіз➡
Dialogue: 0,0:05:00.87,0:05:03.67,Default,,0,0,0,,Сіз Харудан бас тартасыз ба?
Dialogue: 0,0:05:05.10,0:05:08.12,Default,,0,0,0,,Сіз Англиямен келіссөздер жүргізуге ниеттісіз бе?
Dialogue: 0,0:05:08.12,0:05:11.62,Default,,0,0,0,,Мен істемесем де, Эй Сан да шығар➡
Dialogue: 0,0:05:11.62,0:05:14.92,Default,,0,0,0,,Мүмкін мені шақырған да шығар.
Dialogue: 0,0:05:14.92,0:05:18.28,Default,,0,0,0,,Не айтып тұрсың! Бұл жай ғана шай кеші болуы мүмкін емес!
Dialogue: 0,0:05:18.28,0:05:22.40,Default,,0,0,0,,Эйдзи ғана қалды. Қауіпсіздікті төмендетпеңіз.
Dialogue: 0,0:05:22.40,0:05:24.45,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:05:24.45,0:05:27.33,Default,,0,0,0,,Бірақ, сынап көріңіз.
Dialogue: 0,0:05:27.33,0:05:30.33,Default,,0,0,0,,Қандай жағдай болмасын, мен сені әрқашан қорғаймын.
Dialogue: 0,0:05:32.21,0:05:34.21,Default,,0,0,0,,Рахмет
Dialogue: 0,0:05:36.84,0:05:39.41,Default,,0,0,0,,Хехе
Dialogue: 0,0:05:39.41,0:05:43.51,Default,,0,0,0,,[Телевизия] (Мизороги) Кешіріңіз! Төраға, сіз осындасыз ба?
Dialogue: 0,0:05:45.07,0:05:48.29,Default,,0,0,0,,Төраға, мен сізбен сөйлескім келеді.
Dialogue: 0,0:05:48.29,0:05:52.79,Default,,0,0,0,,Сіз сенімдісіз бе? ≫(Юри) Кіріңізші.
Dialogue: 0,0:05:52.79,0:05:54.73,Default,,0,0,0,,Сиқыршы культішілер.
Dialogue: 0,0:05:54.73,0:05:58.82,Default,,0,0,0,,♬～
Dialogue: 0,0:05:58.82,0:06:01.69,Default,,0,0,0,,Иә? Төраға?
Dialogue: 0,0:06:01.69,0:06:05.01,Default,,0,0,0,,[Сөйлеуші] (Юри) Не болды? Кез келген нәрсені айтып көріңіз
Dialogue: 0,0:06:05.01,0:06:07.47,Default,,0,0,0,,Бұл... иә. Мм~➡
Dialogue: 0,0:06:07.47,0:06:12.20,Default,,0,0,0,,Қара топқа келетін болсақ, тек төрт мүше қалды.➡
Dialogue: 0,0:06:12.20,0:06:14.21,Default,,0,0,0,,Менің кінәм бар ма? ➡
Dialogue: 0,0:06:14.21,0:06:18.80,Default,,0,0,0,,Менің жағдайым жоқ деп бәрі бірінен соң бірі басқа мектепке ауысты ма?
Dialogue: 0,0:06:18.80,0:06:22.26,Default,,0,0,0,,Жоқ, бұл сіздің кінәңіз емес.
Dialogue: 0,0:06:22.26,0:06:26.89,Default,,0,0,0,,Сіз кереметсіз... иә, ең жақсы мұғалімсіз.➡
Dialogue: 0,0:06:26.89,0:06:29.63,Default,,0,0,0,,[Спикер] Өзіңізге сенімдірек болыңыз.➡
Dialogue: 0,0:06:29.63,0:06:31.75,Default,,0,0,0,,Сіз болмасаңыз, қара командаға барыңыз➡
Dialogue: 0,0:06:31.75,0:06:35.29,Default,,0,0,0,,Өйткені сіз оны басқаларға қалдыра алмайсыз.
Dialogue: 0,0:06:35.29,0:06:38.82,Default,,0,0,0,,Төраға...｡ Уф... Куу~
Dialogue: 0,0:06:38.82,0:06:48.10,Default,,0,0,0,,♬～
Dialogue: 0,0:06:48.10,0:06:50.78,Default,,0,0,0,,Мен олардың мұндай нәрсе дайындап жатқанына сене алар емеспін...
Dialogue: 0,0:06:50.78,0:06:54.20,Default,,0,0,0,,Ағылшын жігіті, сен не жоспарлап отырсың?
Dialogue: 0,0:06:54.20,0:06:57.79,Default,,0,0,0,,Бұл дресс-код деп аталады, солай ма?
Dialogue: 0,0:06:57.79,0:07:00.68,Default,,0,0,0,,Күтіңіз. Мен бірдеңе отырғызылғанын тексеремін.
Dialogue: 0,0:07:00.68,0:07:05.07,Default,,0,0,0,,♬～
Dialogue: 0,0:07:05.07,0:07:07.07,Default,,0,0,0,,Хехе
Dialogue: 0,0:07:08.84,0:07:11.64,Default,,0,0,0,,≪(Джункейко) Ой, бұл Такечи мырза емес пе?
Dialogue: 0,0:07:14.16,0:07:18.15,Default,,0,0,0,,Маған ұнамайды. Жеңілгендердің күресіп жатқанын көру жағымсыз.
Dialogue: 0,0:07:18.15,0:07:20.95,Default,,0,0,0,,Аузыңды жап! Күнді жарқырататын менмін!
Dialogue: 0,0:07:22.68,0:07:24.80,Default,,0,0,0,,Гакин! Ха!
Dialogue: 0,0:07:24.80,0:07:30.10,Default,,0,0,0,,♬～
Dialogue: 0,0:07:31.49,0:07:35.20,Default,,0,0,0,,Бірақ сіз барлық жолмен келгеннен бері➡
Dialogue: 0,0:07:35.20,0:07:39.63,Default,,0,0,0,,Шайға Такечи мырзаны да арнайы шақырамын.➡
Dialogue: 0,0:07:39.63,0:07:41.55,Default,,0,0,0,,Хехехе
Dialogue: 0,0:07:41.55,0:07:51.75,Default,,0,0,0,,♬～
Dialogue: 0,0:07:51.75,0:07:55.75,Default,,0,0,0,,Жоғарғы қабатта шай ішетін бөлме бар еді.
Dialogue: 0,0:07:57.28,0:07:59.57,Default,,0,0,0,,Ах...｡ Әзірге➡
Dialogue: 0,0:07:59.57,0:08:02.42,Default,,0,0,0,,Сізді шай ішуге шақырды ма?
Dialogue: 0,0:08:02.42,0:08:06.01,Default,,0,0,0,,Харудың бірінші рет келуі. Токаку мырза ше?
Dialogue: 0,0:08:06.01,0:08:08.06,Default,,0,0,0,,Мұндай нәрсе болуы мүмкін емес.
Dialogue: 0,0:08:08.06,0:08:14.82,Default,,0,0,0,,♬～
Dialogue: 0,0:08:14.82,0:08:16.85,Default,,0,0,0,,Пешка (лифт дыбысы)
Dialogue: 0,0:08:16.85,0:08:19.92,Default,,0,0,0,,♬～
Dialogue: 0,0:08:19.92,0:08:23.23,Default,,0,0,0,,Уау! Бұл қай жер?
Dialogue: 0,0:08:23.23,0:08:27.41,Default,,0,0,0,,Керемет. Мектеп ішінде мұндай бөлме болғанына сене алар емеспін.
Dialogue: 0,0:08:27.41,0:08:29.45,Default,,0,0,0,,Бүгін, осы күн үшін➡
Dialogue: 0,0:08:29.45,0:08:33.29,Default,,0,0,0,,Британдық конгломерат Миоджо Гакуэннен жоғарғы қабаттың бір бұрышын басып алды➡
Dialogue: 0,0:08:33.29,0:08:36.34,Default,,0,0,0,,Мен оны сізден алып, жаңарттым.
Dialogue: 0,0:08:36.34,0:08:40.41,Default,,0,0,0,,Мистер Эй. Қош келдіңіз, Ичиноза мырза.
Dialogue: 0,0:08:40.41,0:08:42.46,Default,,0,0,0,,Мен сені күттім.➡
Dialogue: 0,0:08:42.46,0:08:45.17,Default,,0,0,0,,Азума-сан да сенімен бірге болды.
Dialogue: 0,0:08:45.17,0:08:48.15,Default,,0,0,0,,Әрине. Мен Харуды қорғаймын.
Dialogue: 0,0:08:48.15,0:08:53.02,Default,,0,0,0,,Сізді шақырмаса да, бұл өте құрметсіздік.
Dialogue: 0,0:08:53.02,0:08:56.72,Default,,0,0,0,,Токаку-сан қасында болмаса, Хару шайға бармайды.
Dialogue: 0,0:08:58.08,0:09:02.78,Default,,0,0,0,,Біздің таңдауымыз жоқ. Олай болса, екеуің де осында келіңдер.
Dialogue: 0,0:09:02.78,0:09:06.32,Default,,0,0,0,,♬～
Dialogue: 0,0:09:06.32,0:09:09.29,Default,,0,0,0,,Бұл бүгінгі кешкі шайдың орны.➡
Dialogue: 0,0:09:09.29,0:09:11.71,Default,,0,0,0,,Барлығы күтіп отыр.
Dialogue: 0,0:09:11.71,0:09:17.85,Default,,0,0,0,,♬～
Dialogue: 0,0:09:17.85,0:09:20.18,Default,,0,0,0,,Барлығына! (Джункико) Тек Хашири-сан➡
Dialogue: 0,0:09:20.18,0:09:22.39,Default,,0,0,0,,Сіз ол жерде болмаған сияқтысыз.➡
Dialogue: 0,0:09:22.39,0:09:25.26,Default,,0,0,0,,Мен сізді шақыруға қиналсам да.
Dialogue: 0,0:09:25.26,0:09:27.66,Default,,0,0,0,,Ух... у~ уф~
Dialogue: 0,0:09:30.16,0:09:32.55,Default,,0,0,0,,≫Гача (құлыптау дыбысы) Ха!
Dialogue: 0,0:09:32.55,0:09:35.07,Default,,0,0,0,,Цк... Дон!
Dialogue: 0,0:09:35.07,0:09:38.49,Default,,0,0,0,,Мен айттым ғой, солай ма? Бұл бөлме британдық конгломераттарға тиесілі➡
Dialogue: 0,0:09:38.49,0:09:41.82,Default,,0,0,0,,Оны маған Миоджо Гакуэн берді.➡
Dialogue: 0,0:09:41.82,0:09:45.09,Default,,0,0,0,,Қанша қатты немесе қатты айқайласаңыз да➡
Dialogue: 0,0:09:45.09,0:09:47.79,Default,,0,0,0,,Оны жоюдың еш қиындығы жоқ.
Dialogue: 0,0:09:47.79,0:09:53.22,Default,,0,0,0,,Әй, әлгі жабайы көздеріңмен маған қадалғаныңды жек көремін.
Dialogue: 0,0:09:53.22,0:09:56.80,Default,,0,0,0,,Кәне, балалар, тез орныңдарыңа отырыңдар.➡
Dialogue: 0,0:09:56.80,0:10:01.07,Default,,0,0,0,,Біз ең жоғары сапалы Hanabusa қоспасы мен шай тәттілерін дайындадық.
Dialogue: 0,0:10:01.07,0:10:07.05,Default,,0,0,0,,♬～
Dialogue: 0,0:10:07.05,0:10:09.45,Default,,0,0,0,,Ах! қуыршақ?
Dialogue: 0,0:10:11.03,0:10:13.05,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:13.05,0:10:15.39,Default,,0,0,0,,Ара Оишии
Dialogue: 0,0:10:15.39,0:10:17.96,Default,,0,0,0,,Нант хош иісі
Dialogue: 0,0:10:17.96,0:10:21.18,Default,,0,0,0,,Сасугадесван. (Исукенің қуыршағы) Сасугадесван
Dialogue: 0,0:10:21.18,0:10:23.63,Default,,0,0,0,,Куммо керемет. (Коконың қуыршағы) Керемет
Dialogue: 0,0:10:23.63,0:10:25.67,Default,,0,0,0,,Шай тәттілері
Dialogue: 0,0:10:25.67,0:10:27.82,Default,,0,0,0,,Торокесу. (Исукенің қуыршағы) Сасуга➡
Dialogue: 0,0:10:27.82,0:10:30.77,Default,,0,0,0,,Патшайым шайының тәттілері. (Мың аяқты қуыршақ) Сасугадесван
Dialogue: 0,0:10:30.77,0:10:34.12,Default,,0,0,0,,Уфуфу. Олай болса, Азума мырза➡
Dialogue: 0,0:10:34.12,0:10:38.58,Default,,0,0,0,,Шай дастарханында көңіл көтеру үшін жұмбақ айтайын ба?
Dialogue: 0,0:10:38.58,0:10:41.95,Default,,0,0,0,,Жұмысшы аралар мен қояндар неге ұқсас?
Dialogue: 0,0:10:41.95,0:10:45.27,Default,,0,0,0,,Ах. Не айтқың келеді?
Dialogue: 0,0:10:45.27,0:10:48.19,Default,,0,0,0,,Бұл туралы ойлаудың өзі жұмбақ емес пе?
Dialogue: 0,0:10:48.19,0:10:51.27,Default,,0,0,0,,Иә? Ичиноза мырза
Dialogue: 0,0:10:51.27,0:10:54.48,Default,,0,0,0,,Эй мырза, сізге айтар сөзім бар.
Dialogue: 0,0:10:54.48,0:10:57.05,Default,,0,0,0,,О, не болып жатыр?
Dialogue: 0,0:10:57.05,0:11:00.80,Default,,0,0,0,,Бүгін Қара тобының ойынын аяқтағыңыз келе ме?
Dialogue: 0,0:11:00.80,0:11:04.65,Default,,0,0,0,,Харудың бұдан былай төгілген қанды көргісі келмейді.
Dialogue: 0,0:11:04.65,0:11:07.67,Default,,0,0,0,,Эй мырза қандай сыйлық алғысы келеді?
Dialogue: 0,0:11:07.67,0:11:11.70,Default,,0,0,0,,Егер ол орындалса, шуақты ауа райы оны жүзеге асырады.
Dialogue: 0,0:11:11.70,0:11:14.20,Default,,0,0,0,,Сыйақы? Хехе
Dialogue: 0,0:11:14.20,0:11:17.90,Default,,0,0,0,,Бұл тек Ичиноза-санның қолынан келетін нәрсе болуы мүмкін.
Dialogue: 0,0:11:17.90,0:11:21.76,Default,,0,0,0,,Менің отбасым сенікімен бірдей.
Dialogue: 0,0:11:21.76,0:11:24.52,Default,,0,0,0,,Иә, жұмбақ секілді➡
Dialogue: 0,0:11:24.52,0:11:27.98,Default,,0,0,0,,Менің ойымша, бұл ара мен өрмекші сияқты нәрсе.
Dialogue: 0,0:11:27.98,0:11:30.96,Default,,0,0,0,,Уфуфу, сенің көздерің жақсы.
Dialogue: 0,0:11:30.96,0:11:35.32,Default,,0,0,0,,Талай тозақтан аман өткен патшайымның көзі
Dialogue: 0,0:11:35.32,0:11:39.01,Default,,0,0,0,,Менің өміріме де жас кезімнен қауіп төнді➡
Dialogue: 0,0:11:39.01,0:11:41.81,Default,,0,0,0,,Мен талай рет өлтіріліп кете жаздадым.
Dialogue: 0,0:11:41.81,0:11:45.71,Default,,0,0,0,,Осы уақытқа дейін екеуіміз де аман қалдық, солай емес пе?
Dialogue: 0,0:11:47.88,0:11:51.30,Default,,0,0,0,,Бірақ мен ең күшті ханшайыммын.➡
Dialogue: 0,0:11:51.30,0:11:54.29,Default,,0,0,0,,Сіз емес. Сізді жеңіңіз➡
Dialogue: 0,0:11:54.29,0:11:57.89,Default,,0,0,0,,Менің ең күшті екенімді барлығына түсіндіріңіз
Dialogue: 0,0:11:57.89,0:11:59.89,Default,,0,0,0,,Менің қалағаным осы
Dialogue: 0,0:12:01.71,0:12:04.30,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:04.30,0:12:07.25,Default,,0,0,0,,Уайымдаудың қажеті жоқ.
Dialogue: 0,0:12:07.25,0:12:10.19,Default,,0,0,0,,Әділ, әділ болайық.➡
Dialogue: 0,0:12:10.19,0:12:13.29,Default,,0,0,0,,Мұнда әртүрлі қарулар бар.
Dialogue: 0,0:12:13.29,0:12:18.99,Default,,0,0,0,,♬～
Dialogue: 0,0:12:21.36,0:12:24.52,Default,,0,0,0,,♬～
Dialogue: 0,0:12:24.52,0:12:27.94,Default,,0,0,0,,Бастайық, солай ма?
Dialogue: 0,0:12:27.94,0:12:31.52,Default,,0,0,0,,♬～
Dialogue: 0,0:12:31.52,0:12:34.58,Default,,0,0,0,,Жарылыс!
Dialogue: 0,0:12:34.58,0:12:36.63,Default,,0,0,0,,Хару артта қал!
Dialogue: 0,0:12:36.63,0:12:40.75,Default,,0,0,0,,♬～
Dialogue: 0,0:12:40.75,0:12:44.37,Default,,0,0,0,,Да-да-да-да-да! Да-да-да-да-да!
Dialogue: 0,0:12:44.37,0:12:50.09,Default,,0,0,0,,♬～
Dialogue: 0,0:12:50.09,0:12:53.29,Default,,0,0,0,,Соңғы шайқас басталған сияқты.
Dialogue: 0,0:15:02.93,0:15:06.76,Default,,0,0,0,,Бәріңіз, бүгін сіздерді өз бетіңізше оқуға мәжбүрлегенім үшін кешіріңіздер.
Dialogue: 0,0:15:06.76,0:15:10.38,Default,,0,0,0,,«Курогуми Цушиннің» соңғы санын әкелдім.
Dialogue: 0,0:15:10.38,0:15:13.29,Default,,0,0,0,,Осыны оқып, ертең бастаңыз...｡➡
Dialogue: 0,0:15:13.29,0:15:15.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:15.32,0:15:17.42,Default,,0,0,0,,Да-да-да-да-да!
Dialogue: 0,0:15:19.38,0:15:21.59,Default,,0,0,0,,Да-да-да-да-да!
Dialogue: 0,0:15:21.59,0:15:24.35,Default,,0,0,0,,Сол балалармен айналысу керек.
Dialogue: 0,0:15:24.35,0:15:28.55,Default,,0,0,0,,♬～
Dialogue: 0,0:15:28.55,0:15:32.49,Default,,0,0,0,,Да-да-да-да! Да-да-да-да!
Dialogue: 0,0:15:32.49,0:15:34.52,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:34.52,0:15:38.16,Default,,0,0,0,,♬～
Dialogue: 0,0:15:38.16,0:15:40.65,Default,,0,0,0,,Күн шуақты!
Dialogue: 0,0:15:40.65,0:15:43.02,Default,,0,0,0,,Уфуфу. Ах...
Dialogue: 0,0:15:43.02,0:15:54.19,Default,,0,0,0,,♬～
Dialogue: 0,0:15:54.19,0:15:56.23,Default,,0,0,0,,Сондай-ақ сиқыр сенің ерніңе де әсер етсін…
Dialogue: 0,0:15:56.23,0:15:58.63,Default,,0,0,0,,♬～
Dialogue: 0,0:16:00.03,0:16:02.03,Default,,0,0,0,,Токаку!
Dialogue: 0,0:16:03.87,0:16:07.36,Default,,0,0,0,,Оған көмектесу мүмкін емес. Ешкімнің жолыңызға түсуіне жол бермеңіз➡
Dialogue: 0,0:16:07.36,0:16:10.69,Default,,0,0,0,,Мен Ичиноза-санмен күресуді ойладым.
Dialogue: 0,0:16:10.69,0:16:13.01,Default,,0,0,0,,Мен саған мұны істеуге рұқсат бермеймін.
Dialogue: 0,0:16:13.01,0:16:15.33,Default,,0,0,0,,Ичиноза мырза, күте тұрыңыз.
Dialogue: 0,0:16:15.33,0:16:18.73,Default,,0,0,0,,Шайқас - Азума-санды жеңу, содан кейін асықпау.
Dialogue: 0,0:16:20.02,0:16:22.52,Default,,0,0,0,,Мен өзімді ұстамаймын!
Dialogue: 0,0:16:22.52,0:16:24.46,Default,,0,0,0,,Банг! Bang! Канг! Канг!
Dialogue: 0,0:16:24.46,0:16:26.93,Default,,0,0,0,,Сен ақымақсың ба!? Гах!
Dialogue: 0,0:16:26.93,0:16:28.95,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:28.95,0:16:36.37,Default,,0,0,0,,♬～
Dialogue: 0,0:16:36.37,0:16:38.39,Default,,0,0,0,,Бакин!
Dialogue: 0,0:16:38.39,0:16:42.28,Default,,0,0,0,,♬～
Dialogue: 0,0:16:42.28,0:16:44.36,Default,,0,0,0,,Догон! Токаку!
Dialogue: 0,0:16:44.36,0:16:48.06,Default,,0,0,0,,♬～
Dialogue: 0,0:16:48.06,0:16:52.54,Default,,0,0,0,,Оның қабырғалары кез келген соққыға төтеп бере алатын тапсырыс бойынша оқ өткізбейтін шыныдан жасалған.
Dialogue: 0,0:16:52.54,0:16:57.04,Default,,0,0,0,,Бұл бөлме жарылып кетсе де, ол жойылмайды.
Dialogue: 0,0:16:59.23,0:17:02.05,Default,,0,0,0,,Түйіспе
Dialogue: 0,0:17:02.05,0:17:04.08,Default,,0,0,0,,Ха!
Dialogue: 0,0:17:04.08,0:17:07.95,Default,,0,0,0,,Маған өзімнің кім екенімді көрсетейін.
Dialogue: 0,0:17:07.95,0:17:11.25,Default,,0,0,0,,♬～
Dialogue: 0,0:17:17.71,0:17:24.62,Default,,0,0,0,,♬～
Dialogue: 0,0:17:24.62,0:17:26.62,Default,,0,0,0,,Хехехе
Dialogue: 0,0:17:28.12,0:17:30.14,Default,,0,0,0,,Догон!
Dialogue: 0,0:17:30.14,0:17:36.88,Default,,0,0,0,,♬～
Dialogue: 0,0:17:36.88,0:17:38.92,Default,,0,0,0,,Догон!
Dialogue: 0,0:17:38.92,0:17:41.73,Default,,0,0,0,,♬～
Dialogue: 0,0:17:41.73,0:17:44.85,Default,,0,0,0,,Мен жеңілмейтінмін.➡
Dialogue: 0,0:17:44.85,0:17:48.39,Default,,0,0,0,,Мен ханшайыммын.➡
Dialogue: 0,0:17:48.39,0:17:51.46,Default,,0,0,0,,Мен ең күштімін
Dialogue: 0,0:17:51.46,0:17:54.36,Default,,0,0,0,,Мұны мойындауға рұқсат етіңіз!
Dialogue: 0,0:17:54.36,0:17:56.50,Default,,0,0,0,,♬～
Dialogue: 0,0:17:56.50,0:17:58.52,Default,,0,0,0,,Дока!
Dialogue: 0,0:17:58.52,0:18:05.12,Default,,0,0,0,,♬～
Dialogue: 0,0:18:05.12,0:18:07.16,Default,,0,0,0,,Тарту (белдік үзілген дыбыс)
Dialogue: 0,0:18:07.16,0:18:12.46,Default,,0,0,0,,♬～
Dialogue: 0,0:18:13.87,0:18:17.22,Default,,0,0,0,,Күн шуақты ауа-райы жақсы, бірақ Хиде-сан да жақсы.
Dialogue: 0,0:18:17.22,0:18:20.34,Default,,0,0,0,,Мен бұл аяқ-қолдарды сындырамын!
Dialogue: 0,0:18:20.34,0:18:23.53,Default,,0,0,0,,♬～
Dialogue: 0,0:18:23.53,0:18:25.56,Default,,0,0,0,,Дока!
Dialogue: 0,0:18:25.56,0:18:29.58,Default,,0,0,0,,♬～
Dialogue: 0,0:18:29.58,0:18:31.63,Default,,0,0,0,,Гаки!
Dialogue: 0,0:18:31.63,0:18:35.67,Default,,0,0,0,,♬～
Dialogue: 0,0:18:35.67,0:18:37.69,Default,,0,0,0,,Догон! Таң!
Dialogue: 0,0:18:37.69,0:18:41.51,Default,,0,0,0,,♬～
Dialogue: 0,0:18:41.51,0:18:44.51,Default,,0,0,0,,Шаңқылдады!
Dialogue: 0,0:18:45.95,0:18:48.65,Default,,0,0,0,,Сіз мұны жасадыңыз. Бум!
Dialogue: 0,0:18:48.65,0:18:54.69,Default,,0,0,0,,♬～
Dialogue: 0,0:18:54.69,0:18:59.88,Default,,0,0,0,,Өтінемін, тапсырыңыз. Одан әрі ұрысудың қажеті жоқ.
Dialogue: 0,0:18:59.88,0:19:03.97,Default,,0,0,0,,Бұл бекер емес... Мен Харуды қорғаймын...
Dialogue: 0,0:19:03.97,0:19:07.57,Default,,0,0,0,,Ақымақ. Неге сонша алысқа бардың?
Dialogue: 0,0:19:07.57,0:19:11.69,Default,,0,0,0,,Мен... мен үшін маңызды нәрсе үшін күресемін
Dialogue: 0,0:19:11.69,0:19:14.39,Default,,0,0,0,,Міне. Уф...
Dialogue: 0,0:19:14.39,0:19:18.93,Default,,0,0,0,,Маңызды нәрсе бар ма? Бұл Хару Ичиноза ма?
Dialogue: 0,0:19:18.93,0:19:23.00,Default,,0,0,0,,Дұрыс. Мен сені қандай жағдай болса да қорғауға ант еттім.
Dialogue: 0,0:19:23.00,0:19:27.64,Default,,0,0,0,,Мен өмірімді құрбан етсем де, Харуды қорғауды шештім!
Dialogue: 0,0:19:27.64,0:19:30.34,Default,,0,0,0,,Ой, аянышты.
Dialogue: 0,0:19:30.34,0:19:33.85,Default,,0,0,0,,Бұл араның арасының күші екенін түсінбей
Dialogue: 0,0:19:33.85,0:19:35.85,Default,,0,0,0,,Патшайым ара?
Dialogue: 0,0:19:37.78,0:19:40.65,Default,,0,0,0,,Жұмысшы аралар мен қояндар ұқсас➡
Dialogue: 0,0:19:40.65,0:19:44.79,Default,,0,0,0,,Екеуі де араны ара үшін құрбан етеді.
Dialogue: 0,0:19:44.79,0:19:50.50,Default,,0,0,0,,Бірақ жұмысшы аралар өздерінің жұмысшы екенін түсінбейді.
Dialogue: 0,0:19:50.50,0:19:54.37,Default,,0,0,0,,Бұл нені білдіреді? Сіз Харуды ара патшайымы деп айтасыз ба?
Dialogue: 0,0:19:54.37,0:19:59.12,Default,,0,0,0,,♬～
Dialogue: 0,0:19:59.12,0:20:02.83,Default,,0,0,0,,А... Әй, шынымен кеш.
Dialogue: 0,0:20:02.83,0:20:05.33,Default,,0,0,0,,Сіз мұны керемет түрде жасайсыз.
Dialogue: 0,0:20:05.33,0:20:09.32,Default,,0,0,0,,Иә? Такечи-сан, сен неге мұндасың?
Dialogue: 0,0:20:09.32,0:20:12.90,Default,,0,0,0,,Бұл жақсы емес пе? Эй! Уф...
Dialogue: 0,0:20:12.90,0:20:17.00,Default,,0,0,0,,Мұны Эй Санға қалдырып, үйге қайтайық па?
Dialogue: 0,0:20:18.51,0:20:21.81,Default,,0,0,0,,Қашып кетсең мені жеңе алмайсың.
Dialogue: 0,0:20:21.81,0:20:24.86,Default,,0,0,0,,Бұл сізді жұмысшы ара болу құқығынан айырады.
Dialogue: 0,0:20:24.86,0:20:29.87,Default,,0,0,0,,♬～
Dialogue: 0,0:20:29.87,0:20:33.07,Default,,0,0,0,,Да-да-да-да-да! Bang bang bang!
Dialogue: 0,0:20:35.02,0:20:37.02,Default,,0,0,0,,Гашан!
Dialogue: 0,0:20:45.33,0:20:57.55,Default,,0,0,0,,♬～
Dialogue: 0,0:20:57.55,0:20:59.55,Default,,0,0,0,,♬~
Dialogue: 0,0:21:02.39,0:21:05.19,Default,,0,0,0,,Енді мұны аяқтаймыз ба?
Dialogue: 0,0:21:07.52,0:21:09.54,Default,,0,0,0,,Токаку~!
Dialogue: 0,0:21:09.54,0:21:17.75,Default,,0,0,0,,♬～
Dialogue: 0,0:21:17.75,0:21:22.12,Default,,0,0,0,,Не істесең де ол қабырғаны бұза алмайсың деп айтпадың ба?
Dialogue: 0,0:21:22.12,0:21:27.01,Default,,0,0,0,,♬～
Dialogue: 0,0:21:27.01,0:21:29.15,Default,,0,0,0,,Бас! Бум!
Dialogue: 0,0:21:29.15,0:21:33.22,Default,,0,0,0,,♬～
Dialogue: 0,0:21:33.22,0:21:37.52,Default,,0,0,0,,Әй, патшайым құйрығын бұрып қаша ма?
Dialogue: 0,0:21:37.52,0:21:39.52,Default,,0,0,0,,Мен саған бұлай істеуге рұқсат бермеймін.
Dialogue: 0,0:21:41.89,0:21:44.51,Default,,0,0,0,,Хару... Күте тұрыңыз...
Dialogue: 0,0:21:44.51,0:22:03.68,Default,,0,0,0,,♬～
Dialogue: 0,0:22:03.68,0:22:12.26,Default,,0,0,0,,♬～
Dialogue: 0,0:22:12.26,0:22:14.42,Default,,0,0,0,,Да-да-да-да-да!
Dialogue: 0,0:22:14.42,0:22:16.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:16.46,0:22:25.77,Default,,0,0,0,,♬～
Dialogue: 0,0:22:25.77,0:22:27.77,Default,,0,0,0,,БУМ‼
Dialogue: 0,0:22:31.62,0:22:33.71,Default,,0,0,0,,Ха!
Dialogue: 0,0:22:33.71,0:22:48.77,Default,,0,0,0,,♬～
Dialogue: 0,0:22:48.77,0:22:50.79,Default,,0,0,0,,Догон!
Dialogue: 0,0:22:50.79,0:22:58.15,Default,,0,0,0,,♬～
Dialogue: 0,0:22:58.15,0:23:01.12,Default,,0,0,0,,Маған осыншама зиян келтіргені➡
Dialogue: 0,0:23:01.12,0:23:04.86,Default,,0,0,0,,Бұл бірінші рет. Мен сені мақтаймын.
Dialogue: 0,0:23:04.86,0:23:07.54,Default,,0,0,0,,Бірақ бұл соңы.➡
Dialogue: 0,0:23:07.54,0:23:09.63,Default,,0,0,0,,Менің жеңісім.➡
Dialogue: 0,0:23:09.63,0:23:11.75,Default,,0,0,0,,Жұмысшы аралар болмаса да➡
Dialogue: 0,0:23:11.75,0:23:15.27,Default,,0,0,0,,Мен осы уақытқа дейін өз күшіммен ғана аман қалдым.➡
Dialogue: 0,0:23:15.27,0:23:17.65,Default,,0,0,0,,Мен сенен басқашамын.➡
Dialogue: 0,0:23:17.65,0:23:21.36,Default,,0,0,0,,Мен нағыз ханшайыммын. Мен ең күштімін
Dialogue: 0,0:23:21.36,0:23:26.05,Default,,0,0,0,,♬～
Dialogue: 0,0:23:26.05,0:23:28.56,Default,,0,0,0,,Қош бол Хару Ичиноза
Dialogue: 0,0:23:28.56,0:23:48.00,Default,,0,0,0,,♬～
Dialogue: 0,0:23:48.00,0:23:50.17,Default,,0,0,0,,Сіз! кешіріңіз
Dialogue: 0,0:23:50.17,0:23:52.84,Default,,0,0,0,,Бірақ Харудың жеңілуге шамасы жоқ.
Dialogue: 0,0:23:52.84,0:23:57.43,Default,,0,0,0,,♬～
Dialogue: 0,0:23:57.43,0:24:00.03,Default,,0,0,0,,Мылтық мылтық...
Dialogue: 0,0:24:00.03,0:24:02.08,Default,,0,0,0,,Әй, не!
Dialogue: 0,0:24:02.08,0:24:06.35,Default,,0,0,0,,♬～
Dialogue: 0,0:24:06.35,0:24:08.45,Default,,0,0,0,,Маған ұнамайды…｡➡
Dialogue: 0,0:24:08.45,0:24:11.36,Default,,0,0,0,,Кяаа!!
Dialogue: 0,0:24:11.36,0:24:14.88,Default,,0,0,0,,♬～
Dialogue: 0,0:24:14.88,0:24:16.93,Default,,0,0,0,,Бум!
Dialogue: 0,0:24:16.93,0:24:19.73,Default,,0,0,0,,♬～
Dialogue: 0,0:24:22.15,0:24:25.30,Default,,0,0,0,,Оянатын уақыт келді, Токаку.➡
Dialogue: 0,0:24:25.30,0:24:28.12,Default,,0,0,0,,Бұл ояту қоңырауының орнындағы мәселе.
Dialogue: 0,0:24:28.12,0:24:36.50,Default,,0,0,0,,♬～
Dialogue: 0,0:24:36.50,0:24:39.74,Default,,0,0,0,,[TEL] (Алынған электрондық пошта/Үнсіз режим) А...
Dialogue: 0,0:24:39.74,0:24:48.36,Default,,0,0,0,,♬～
Dialogue: 0,0:24:48.36,0:24:50.88,Default,,0,0,0,,≪Tattatattatta (аяқ дыбысы)
Dialogue: 0,0:24:50.88,0:24:53.70,Default,,0,0,0,,Токаку. Хару
Dialogue: 0,0:24:53.70,0:24:57.55,Default,,0,0,0,,♬～
Dialogue: 0,0:24:57.55,0:25:03.23,Default,,0,0,0,,Рахмет. Хару мен жасадым...
Dialogue: 0,0:25:03.23,0:25:05.23,Default,,0,0,0,,Уф...
Dialogue: 0,0:25:07.61,0:25:10.15,Default,,0,0,0,,Таза
Dialogue: 0,0:25:10.15,0:25:13.02,Default,,0,0,0,,Эйдің айтқан сөздері...➡
Dialogue: 0,0:25:13.02,0:25:15.86,Default,,0,0,0,,Аналық ара болу деген нені білдіреді?
Dialogue: 0,0:25:15.86,0:25:18.86,Default,,0,0,0,,♬～
Dialogue: 0,0:25:18.86,0:25:23.56,Default,,0,0,0,,Күн шуақты ма? Кешіріңіз, әлі жоқ...
Dialogue: 0,0:25:23.56,0:25:26.18,Default,,0,0,0,,Уақыты келгенде сөйле
Dialogue: 0,0:25:26.18,0:25:35.09,Default,,0,0,0,,♬～
Dialogue: 0,0:25:35.09,0:25:38.39,Default,,0,0,0,,Ол патшайым бола алмаған сияқты.
Dialogue: 0,0:25:39.76,0:25:52.69,Default,,0,0,0,,♬～
Dialogue: 0,0:25:52.69,0:25:55.53,Default,,0,0,0,,♬ Гүлдің өмірі өткінші
Dialogue: 0,0:25:55.53,0:25:58.75,Default,,0,0,0,,♬ Бүгін түнде шашырап кетеді
Dialogue: 0,0:25:58.75,0:26:01.52,Default,,0,0,0,,♬ Уақытты бояу
Dialogue: 0,0:26:01.52,0:26:04.95,Default,,0,0,0,,♬ Денсаулығында жоғалатын тағдыр
Dialogue: 0,0:26:04.95,0:26:07.69,Default,,0,0,0,,♬ Қайталауға рұқсат етілмейді
Dialogue: 0,0:26:07.69,0:26:10.61,Default,,0,0,0,,♬ Ganjyarame ойыншысы
Dialogue: 0,0:26:10.61,0:26:13.70,Default,,0,0,0,,♬ Келесі қадамыңыз қандай?
Dialogue: 0,0:26:13.70,0:26:16.00,Default,,0,0,0,,♬ Неғұрлым күрессең, болашақ соғұрлым бұрмаланады.
Dialogue: 0,0:26:17.38,0:26:19.64,Default,,0,0,0,,♬ Соңғы сәт туралы
Dialogue: 0,0:26:19.64,0:26:23.21,Default,,0,0,0,,♬ Ол міндетті түрде жарқырайды
Dialogue: 0,0:26:23.21,0:26:28.76,Default,,0,0,0,,♬ Иночинокаракури шығар
Dialogue: 0,0:26:28.76,0:26:31.76,Default,,0,0,0,,♬ Мен әшекей емеспін Бұл ойын емес
Dialogue: 0,0:26:31.76,0:26:35.38,Default,,0,0,0,,♬ Жеңілістен арты тек жойылу бар
Dialogue: 0,0:26:35.38,0:26:38.42,Default,,0,0,0,,♬ Көз жасы бір күні кебеді
Dialogue: 0,0:26:38.42,0:26:41.16,Default,,0,0,0,,♬ құрбандық шалу
Dialogue: 0,0:26:41.16,0:26:44.08,Default,,0,0,0,,♬ Ал тар сахнада ойнаңыз
Dialogue: 0,0:26:44.08,0:26:47.70,Default,,0,0,0,,♬ Манипуляция кезінде жақсы билеңіз
Dialogue: 0,0:26:47.70,0:26:50.52,Default,,0,0,0,,♬ Бір күні мен бұл дилемманы шешемін
Dialogue: 0,0:26:50.52,0:26:52.85,Default,,0,0,0,,♬ Шығуды шешті
Dialogue: 0,0:26:52.85,0:26:55.92,Default,,0,0,0,,♬ Жасырын қозыр
Dialogue: 0,0:26:55.92,0:27:00.89,Default,,0,0,0,,♬～
Dialogue: 0,0:27:00.89,0:27:05.49,Default,,0,0,0,,♬～
Dialogue: 0,0:28:40.73,0:28:42.76,Default,,0,0,0,,Барлығы шындықты білгісі келетінін айтады.➡
Dialogue: 0,0:28:42.76,0:28:44.85,Default,,0,0,0,,Бірақ сіз білгеннен кейін не болатынын ойлайсыз ба? ➡
Dialogue: 0,0:28:44.85,0:28:48.32,Default,,0,0,0,,Сіз ең бірінші шындықты білгіңіз келді ме? ➡
Dialogue: 0,0:28:48.32,0:28:50.92,Default,,0,0,0,,Бірақ сіз сүйекті лақтырып тастадыңыз.➡
Dialogue: 0,0:28:50.92,0:28:53.32,Default,,0,0,0,,Сіз шығыңқы көздерге қарауға дайынсыз ба?
Dialogue: 0,0:28:54.72,0:28:56.76,Default,,0,0,0,,«Куругуми үй бөлмесі»!
Dialogue: 0,0:28:56.76,0:28:59.06,Default,,0,0,0,,Сіз не оқып жатырсыз? Жақында шығады➡
Dialogue: 0,0:28:59.06,0:29:01.10,Default,,0,0,0,,«Шайтанның жұмбағы» Ресми нұсқаулық
Dialogue: 0,0:29:01.10,0:29:04.17,Default,,0,0,0,,Бұл не туралы? Тек қызметкерлер мен актер сұхбаттары ғана емес➡
Dialogue: 0,0:29:04.17,0:29:06.35,Default,,0,0,0,,Джун Минакатаның әдемі түсті иллюстрациялары➡
Dialogue: 0,0:29:06.35,0:29:08.39,Default,,0,0,0,,20-дан астам фотосуреттер жарияланды.
Dialogue: 0,0:29:08.39,0:29:11.82,Default,,0,0,0,,Бұл тамаша мазмұн. Токаку-сан екеуміз мұқабадамыз.
Dialogue: 0,0:29:11.82,0:29:13.89,Default,,0,0,0,,Қосымша ақпаратты «Шайтанның жұмбағы» ресми сайтынан қараңыз ➡
Dialogue: 0,0:29:13.89,0:29:15.89,Default,,0,0,0,,Тексеріңіз
Dialogue: 0,0:29:17.39,0:29:23.39,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory