Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:34.43,0:01:38.20,Default,,0,0,0,,Bilibili biri…(үзіліс дыбысы)
Dialogue: 0,0:01:38.20,0:01:41.67,Default,,0,0,0,,Мен ешкімге Хару Ичинозаға тиіспеймін.
Dialogue: 0,0:01:41.67,0:01:46.34,Default,,0,0,0,,♬～
Dialogue: 0,0:01:46.34,0:01:49.98,Default,,0,0,0,,Міне! Хару-чанның Human Shield соңғы нұсқасы!
Dialogue: 0,0:01:49.98,0:01:52.78,Default,,0,0,0,,Сіз Хару Ичинозаны қорғауды шындап жоспарлап жатырсыз ба?
Dialogue: 0,0:01:52.78,0:01:55.45,Default,,0,0,0,,Бұл ереже ме?
Dialogue: 0,0:01:55.45,0:01:58.37,Default,,0,0,0,,Әрине, ережелерде анық көрсетілмеген.
Dialogue: 0,0:01:58.37,0:02:03.19,Default,,0,0,0,,Бірақ қастандықтың өзінен бас тартуға болады ма?
Dialogue: 0,0:02:03.19,0:02:05.19,Default,,0,0,0,,Мен оны тексеремін.
Dialogue: 0,0:02:08.10,0:02:12.59,Default,,0,0,0,,Бұл біраз күтпеген жағдай, бірақ шын мәнінде...
Dialogue: 0,0:02:12.59,0:02:15.44,Default,,0,0,0,,Бұл жақсы. Мұны күтуге болады.➡
Dialogue: 0,0:02:15.44,0:02:19.44,Default,,0,0,0,,Хигаши Токаку Хару Ичинозаның қамқоршысы болатынына келісемін.
Dialogue: 0,0:02:20.88,0:02:23.81,Default,,0,0,0,,Оны оңай таныған сияқты.
Dialogue: 0,0:02:23.81,0:02:25.85,Default,,0,0,0,,Міне.
Dialogue: 0,0:02:25.85,0:02:29.75,Default,,0,0,0,,Жарайды. 11 өлтіруші және 1 қамқоршы.➡
Dialogue: 0,0:02:31.07,0:02:33.37,Default,,0,0,0,,Артқа бағдарлау аяқталды!
Dialogue: 0,0:02:34.78,0:02:37.04,Default,,0,0,0,,♬ Кері санауға дайынсыз ба
Dialogue: 0,0:02:37.04,0:02:39.23,Default,,0,0,0,,♬ Жүгіруге жол жоқ
Dialogue: 0,0:02:39.23,0:02:48.42,Default,,0,0,0,,♬～
Dialogue: 0,0:02:48.42,0:02:53.03,Default,,0,0,0,,♬ Оңай диапазонға түспеңіз.
Dialogue: 0,0:02:53.03,0:02:57.93,Default,,0,0,0,,♬ Бұл суық соғыс аймағы. Қазіргі жағдай жалықтырады.
Dialogue: 0,0:02:57.93,0:03:02.60,Default,,0,0,0,,♬ Ей, балалар, сондықтан сен ерекше екенсің.
Dialogue: 0,0:03:02.60,0:03:04.64,Default,,0,0,0,,♬ Баяғыда сыйымдылық асып кеткен
Dialogue: 0,0:03:04.64,0:03:06.99,Default,,0,0,0,,♬ Өзін-өзі мазақ ету түбі жоқ сезім
Dialogue: 0,0:03:06.99,0:03:09.03,Default,,0,0,0,,♬ Өте сүйкімді
Dialogue: 0,0:03:09.03,0:03:11.86,Default,,0,0,0,,♬ Мен саған ақымақтығымды көрсете алмаймын.
Dialogue: 0,0:03:11.86,0:03:13.91,Default,,0,0,0,,♬ Бекер толқу
Dialogue: 0,0:03:13.91,0:03:15.91,Default,,0,0,0,,♬ Тек ынталандыру үшін
Dialogue: 0,0:03:17.30,0:03:19.94,Default,,0,0,0,,♬ Қабылдау/бүлік Екі ғана таңдау бар ма?
Dialogue: 0,0:03:19.94,0:03:23.59,Default,,0,0,0,,♬ ah Эстетика «Мен ешкімге тиіспеймін»
Dialogue: 0,0:03:23.59,0:03:25.71,Default,,0,0,0,,♬ Жараның кінәсіздігі
Dialogue: 0,0:03:25.71,0:03:28.48,Default,,0,0,0,,♬ Мен де сол топқа кіремін.
Dialogue: 0,0:03:28.48,0:03:30.51,Default,,0,0,0,,♬ орылатын болады
Dialogue: 0,0:03:30.51,0:03:33.05,Default,,0,0,0,,♬ Ешбір жағдайда әрқашан жалғасуда
Dialogue: 0,0:03:33.05,0:03:36.94,Default,,0,0,0,,♬ Белдемшенің етегі туралы шындық
Dialogue: 0,0:03:36.94,0:03:41.98,Default,,0,0,0,,♬ Тек ақымақ сияқты сеніңіз
Dialogue: 0,0:03:41.98,0:03:46.31,Default,,0,0,0,,♬ Маған қатты әсер етті
Dialogue: 0,0:03:46.31,0:03:52.92,Default,,0,0,0,,♬ Оны твиттер арқылы жіберіңіз.
Dialogue: 0,0:03:52.92,0:04:02.42,Default,,0,0,0,,♬～
Dialogue: 0,0:04:15.44,0:04:19.93,Default,,0,0,0,,Дыбыстық сигнал… (оятар дабылы)
Dialogue: 0,0:04:19.93,0:04:23.43,Default,,0,0,0,,Уф, шулы... Иә.➡
Dialogue: 0,0:04:23.43,0:04:26.47,Default,,0,0,0,,Ау, ауырып тұр! Апыр-ай! ➡
Dialogue: 0,0:04:26.47,0:04:28.96,Default,,0,0,0,,Қалыпты бөлу?
Dialogue: 0,0:04:28.96,0:04:33.01,Default,,0,0,0,,Кешіріңіз Шиена Чан. Менде бағыт-бағдар жоқ.
Dialogue: 0,0:04:33.01,0:04:35.70,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:04:35.70,0:04:38.67,Default,,0,0,0,,Жарайды. Осындай нәрсе болуы мүмкін бе деп ойлаймын➡
Dialogue: 0,0:04:38.67,0:04:41.14,Default,,0,0,0,,Қосалқы бар болса, дайын екеніне көз жеткізіңіз...➡
Dialogue: 0,0:04:41.14,0:04:44.19,Default,,0,0,0,,Иә? Ол бос.
Dialogue: 0,0:04:44.19,0:04:46.91,Default,,0,0,0,,Жарайды! Бос орын бар екеніне көз жеткізіңіз...➡
Dialogue: 0,0:04:46.91,0:04:49.78,Default,,0,0,0,,А, бұл!? Жоқ!
Dialogue: 0,0:04:49.78,0:04:53.33,Default,,0,0,0,,Олай болса, Шиена-чан, бұл мүмкін емес.
Dialogue: 0,0:04:53.33,0:05:03.17,Default,,0,0,0,,♬～
Dialogue: 0,0:05:03.17,0:05:05.19,Default,,0,0,0,,Ескерту қағазы!?
Dialogue: 0,0:05:05.19,0:05:08.70,Default,,0,0,0,,Такечи Отоя 1-орын Кеттік!
Dialogue: 0,0:05:08.70,0:05:11.00,Default,,0,0,0,,Хехе, асыға күтемін!
Dialogue: 0,0:05:13.63,0:05:15.95,Default,,0,0,0,,≪YouTube➡-де осылай дедім
Dialogue: 0,0:05:15.95,0:05:18.57,Default,,0,0,0,,Сіз не істемексіз? мен≫
Dialogue: 0,0:05:18.57,0:05:20.61,Default,,0,0,0,,≪Осы жігітті сағынасың ба? ≫
Dialogue: 0,0:05:20.61,0:05:23.44,Default,,0,0,0,,≪Бірақ бұл миссия болмас еді≫
Dialogue: 0,0:05:23.44,0:05:27.95,Default,,0,0,0,,≪Немесе, басқалардан бұрын, менің ойымша...≫
Dialogue: 0,0:05:27.95,0:05:29.95,Default,,0,0,0,,Анам…
Dialogue: 0,0:05:31.37,0:05:34.16,Default,,0,0,0,,≪Түсіңізде де анаңызды шақырасыз ба?≫
Dialogue: 0,0:05:34.16,0:05:36.66,Default,,0,0,0,,Анам…
Dialogue: 0,0:05:37.96,0:05:41.26,Default,,0,0,0,,Мен енді тамақ жей алмаймын~
Dialogue: 0,0:05:41.26,0:05:45.10,Default,,0,0,0,,Бұл... ауырады. Бірақ мен бар күшімді саламын.
Dialogue: 0,0:05:45.10,0:05:47.12,Default,,0,0,0,,Донут ең жақсы~
Dialogue: 0,0:05:47.12,0:05:49.67,Default,,0,0,0,,Хехе, қауын нан да~
Dialogue: 0,0:05:49.67,0:05:52.96,Default,,0,0,0,,Хэхе... Ичинозаны оят
Dialogue: 0,0:05:52.96,0:05:55.28,Default,,0,0,0,,Бұл арман! Эй!
Dialogue: 0,0:05:55.28,0:05:57.39,Default,,0,0,0,,Ал... Токаку мырза!
Dialogue: 0,0:05:57.39,0:05:59.39,Default,,0,0,0,,Қайырлы таң!
Dialogue: 0,0:06:00.90,0:06:02.95,Default,,0,0,0,,Бірақ мен таң қалдым.
Dialogue: 0,0:06:02.95,0:06:05.60,Default,,0,0,0,,Мен ұйықтап жатқанда біреудің шайнап жатқанын бірінші рет көрдім.
Dialogue: 0,0:06:05.60,0:06:08.42,Default,,0,0,0,,Иә! Бұл сирек емес
Dialogue: 0,0:06:08.42,0:06:11.93,Default,,0,0,0,,Тамақ жеуді армандасаң, аузың қозғалады, солай ма?
Dialogue: 0,0:06:11.93,0:06:15.00,Default,,0,0,0,,Жоқ, мұндай түс көрген емеспін.
Dialogue: 0,0:06:15.00,0:06:18.53,Default,,0,0,0,,Қайырлы таң~ 1-бөлме. Қайырлы таң, шуақты!
Dialogue: 0,0:06:18.53,0:06:21.87,Default,,0,0,0,,Күн ашық па? (табыт) Қайырлы таң
Dialogue: 0,0:06:21.87,0:06:24.41,Default,,0,0,0,,Қайырлы таң. (Отойя) Харучи➡
Dialogue: 0,0:06:24.41,0:06:26.67,Default,,0,0,0,,Бірге барайық. Иә.
Dialogue: 0,0:06:26.67,0:06:29.78,Default,,0,0,0,,Иә! «Харерачи» «Қоян» дегенді білдіреді ме?
Dialogue: 0,0:06:29.78,0:06:33.65,Default,,0,0,0,,Қайырлы таң, сыныптастар.
Dialogue: 0,0:06:33.65,0:06:37.10,Default,,0,0,0,,Эй-кун, мұнда да парта мен орындық бар ма?
Dialogue: 0,0:06:37.10,0:06:40.64,Default,,0,0,0,,Мен директордан рұқсат алдым.➡
Dialogue: 0,0:06:40.64,0:06:43.54,Default,,0,0,0,,Баршаңызды мазалағаным үшін кешіріңіз➡
Dialogue: 0,0:06:43.54,0:06:45.58,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:06:45.58,0:06:50.25,Default,,0,0,0,,«Ағылшын тілі» туралы айтатын болсақ, мен бұл атаумен конгломерат болғанына сенімдімін.
Dialogue: 0,0:06:50.25,0:06:54.20,Default,,0,0,0,,Сіз байсыз ба? (Нихон) Мен сенің досың болғым келеді!
Dialogue: 0,0:06:54.20,0:06:56.94,Default,,0,0,0,,Қандай керемет жас ханым.
Dialogue: 0,0:06:56.94,0:07:01.19,Default,,0,0,0,,♬～
Dialogue: 0,0:07:01.19,0:07:04.14,Default,,0,0,0,,Ум~ 1-кезең... Ах.
Dialogue: 0,0:07:04.14,0:07:12.44,Default,,0,0,0,,♬～
Dialogue: 0,0:07:12.44,0:07:15.22,Default,,0,0,0,,Не болды? Ихиноза. Ах.
Dialogue: 0,0:07:15.22,0:07:17.92,Default,,0,0,0,,Мм... бұл ештеңе емес.
Dialogue: 0,0:07:20.51,0:07:22.55,Default,,0,0,0,,Баршаңызға қайырлы таң! ➡
Dialogue: 0,0:07:22.55,0:07:25.37,Default,,0,0,0,,Олай болса, бүгін де жақсылық жасайық!
Dialogue: 0,0:07:25.37,0:07:27.70,Default,,0,0,0,,Эй, Эйджи де осында.
Dialogue: 0,0:07:27.70,0:07:32.11,Default,,0,0,0,,Енді қара топтың барлық 13 мүшесі осында.
Dialogue: 0,0:07:32.11,0:07:34.58,Default,,0,0,0,,Кенмочи мұғалім жоқ.
Dialogue: 0,0:07:34.58,0:07:36.89,Default,,0,0,0,,Иә? Кенмочиге не болды?
Dialogue: 0,0:07:36.89,0:07:38.96,Default,,0,0,0,,Сіз кешігіп қалған сияқтысыз.➡
Dialogue: 0,0:07:38.96,0:07:42.27,Default,,0,0,0,,Менің көзілдірігім сынған, сондықтан мен оларды жөндеуге жіберемін.
Dialogue: 0,0:07:42.27,0:07:45.37,Default,,0,0,0,,Бұл не? Ұстаз, тыңдап тұрған жоқсыз ба?
Dialogue: 0,0:07:47.49,0:07:50.12,Default,,0,0,0,,Сіз кеше драманы көрдіңіз бе? Мен көрдім
Dialogue: 0,0:07:50.12,0:07:54.19,Default,,0,0,0,,≪Мен ешкімнің күн сәулесі үшін өлгенін қаламаймын≫
Dialogue: 0,0:07:54.19,0:07:57.39,Default,,0,0,0,,≪Хару өз күшімен өмір сүреді≫
Dialogue: 0,0:08:00.13,0:08:03.23,Default,,0,0,0,,Кеш болды. [TEL] (Кіріс электрондық пошта/Үнсіз режим)
Dialogue: 0,0:08:05.09,0:08:07.16,Default,,0,0,0,,≪Қайтадан≫
Dialogue: 0,0:08:07.16,0:08:10.29,Default,,0,0,0,,Қызыл, бірақ қызыл емес нәрсе дегеніміз не? ➡
Dialogue: 0,0:08:10.29,0:08:14.77,Default,,0,0,0,,Жауабын білсеңіз, маған электрондық хат жіберіңіз.
Dialogue: 0,0:08:14.77,0:08:16.80,Default,,0,0,0,,Қане, қара топтың бәрі бірге➡
Dialogue: 0,0:08:16.80,0:08:20.37,Default,,0,0,0,,Менің бірінші биология сабағым сыныптан тыс сабақ болды!
Dialogue: 0,0:08:20.37,0:08:24.22,Default,,0,0,0,,Осындай ботаникалық бақ. (Харуки) Қанша ақшаң бар?
Dialogue: 0,0:08:24.22,0:08:27.06,Default,,0,0,0,,Кенмочи: Көзілдіріксіз жақсысың ба?
Dialogue: 0,0:08:27.06,0:08:29.30,Default,,0,0,0,,Бұл аздап бұлыңғыр, бірақ бәрібір.
Dialogue: 0,0:08:29.30,0:08:33.57,Default,,0,0,0,,Жөндеу ертеңге дейін созыла ма? Мен шынымен кешірім сұраймын!
Dialogue: 0,0:08:33.57,0:08:36.60,Default,,0,0,0,,Олай болса, бірден сабақты бастайық.➡
Dialogue: 0,0:08:36.60,0:08:40.72,Default,,0,0,0,,Бұл ботаникалық бақта өсімдіктердің шамамен 2500 түрі бар.➡
Dialogue: 0,0:08:40.72,0:08:43.43,Default,,0,0,0,,Олардың кейбіреулері дүние жүзіндегі сирек өсімдіктер➡
Dialogue: 0,0:08:43.43,0:08:47.11,Default,,0,0,0,,Мұғалімнің ұсынысы - Conteliklamago мүк!
Dialogue: 0,0:08:47.11,0:08:50.13,Default,,0,0,0,,Хуааа. Жалықты.
Dialogue: 0,0:08:50.13,0:08:53.20,Default,,0,0,0,,Эй Ни, қол кремін алғың келе ме?
Dialogue: 0,0:08:53.20,0:08:55.46,Default,,0,0,0,,Менің қолым құрғақ.
Dialogue: 0,0:08:55.46,0:08:57.99,Default,,0,0,0,,Кешіріңіз, мұндай нәрсе жоқ.
Dialogue: 0,0:08:57.99,0:09:00.44,Default,,0,0,0,,Жоқ, мен оны пайдалана алмаймын.
Dialogue: 0,0:09:00.44,0:09:03.26,Default,,0,0,0,,Исуке мырза, қол кремі бар.
Dialogue: 0,0:09:03.26,0:09:07.15,Default,,0,0,0,,Жарайды, мен сабақтамын. (Харуки) Иә.
Dialogue: 0,0:09:07.15,0:09:09.85,Default,,0,0,0,,≪Қызыл, бірақ қызыл емес заттар≫
Dialogue: 0,0:09:09.85,0:09:13.02,Default,,0,0,0,,≪Балақай... Әлгі бейтаныс...≫
Dialogue: 0,0:09:13.02,0:09:16.06,Default,,0,0,0,,Иә? Бәріңе, тыныш болыңдар! ➡
Dialogue: 0,0:09:16.06,0:09:18.51,Default,,0,0,0,,Папоротниктер туралы әңгіме қызықсыз ба? ➡
Dialogue: 0,0:09:18.51,0:09:22.13,Default,,0,0,0,,Бірақ мұнда тек өсімдіктер ғана емес, түрлі жәндіктер де бар➡
Dialogue: 0,0:09:22.13,0:09:24.47,Default,,0,0,0,,Онда тіпті құстар мекендейді.
Dialogue: 0,0:09:24.47,0:09:27.27,Default,,0,0,0,,Дыбыстық сигнал (құстардың сайрауы) Ха! Бұл өтірік!
Dialogue: 0,0:09:28.71,0:09:32.21,Default,,0,0,0,,А, «Усо» - құстың аты.➡
Dialogue: 0,0:09:32.21,0:09:35.16,Default,,0,0,0,,Бұл өтірік, бірақ шын. Бұл дәмді! ➡
Dialogue: 0,0:09:35.16,0:09:37.40,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:09:37.40,0:09:39.57,Default,,0,0,0,,Толық өтірік пе?
Dialogue: 0,0:09:39.57,0:09:41.72,Default,,0,0,0,,Ах~ Бұл өтірік➡
Dialogue: 0,0:09:41.72,0:09:44.56,Default,,0,0,0,,Өткізгіштер қатарына жатқызылған құс және атридалар тұқымдасының мүшесі➡
Dialogue: 0,0:09:44.56,0:09:47.16,Default,,0,0,0,,Өйткені дыбыс ысқырық дыбысына ұқсайды➡
Dialogue: 0,0:09:47.16,0:09:49.71,Default,,0,0,0,,``Усо'' атауы көне тілде ``ысқыру'' дегенді білдіреді...
Dialogue: 0,0:09:49.71,0:09:51.78,Default,,0,0,0,,(Пошта қоңырау үні)
Dialogue: 0,0:09:51.78,0:09:59.52,Default,,0,0,0,,♬～
Dialogue: 0,0:09:59.52,0:10:01.47,Default,,0,0,0,,(Пошта қоңырау үні)
Dialogue: 0,0:10:01.47,0:10:04.48,Default,,0,0,0,,♬～
Dialogue: 0,0:10:04.48,0:10:06.48,Default,,0,0,0,,(Пошта қоңырау үні)
Dialogue: 0,0:10:09.10,0:10:12.20,Default,,0,0,0,,≪Мына жігіттер не істеп жатыр? ≫
Dialogue: 0,0:10:12.20,0:10:14.50,Default,,0,0,0,,Күрсіну~ Менің қарным ашты.➡
Dialogue: 0,0:10:14.50,0:10:17.07,Default,,0,0,0,,Бүгінгі күнделікті ас мәзірі қандай?
Dialogue: 0,0:10:17.07,0:10:19.41,Default,,0,0,0,,Бүгін кешке біз дәмді қытай тағамын ішеміз.
Dialogue: 0,0:10:19.41,0:10:21.78,Default,,0,0,0,,О! (Отойя) Қытай тағамы?｡➡
Dialogue: 0,0:10:21.78,0:10:24.34,Default,,0,0,0,,Мен біраз уақыттан кейін бірінші рет тәтті және қышқыл шошқа етін жегім келеді.
Dialogue: 0,0:10:24.34,0:10:28.18,Default,,0,0,0,,Хару тәтті және қышқыл шошқа етіндегі ананасты ұнатпайды.
Dialogue: 0,0:10:28.18,0:10:31.62,Default,,0,0,0,,Бұл мен де! Мен ананасты жақсы көремін➡
Dialogue: 0,0:10:31.62,0:10:34.46,Default,,0,0,0,,Тәтті және қышқыл шошқа етінде болса, мен кешіре алмаймын.
Dialogue: 0,0:10:34.46,0:10:37.07,Default,,0,0,0,,Иә! Эй, эй, шуақ➡
Dialogue: 0,0:10:37.07,0:10:39.39,Default,,0,0,0,,Сізге қайсысы ұнайды: нан немесе күріш?
Dialogue: 0,0:10:39.39,0:10:41.43,Default,,0,0,0,,Хару күрішті жақсы көреді
Dialogue: 0,0:10:41.43,0:10:44.45,Default,,0,0,0,,Шынымен!? Мен де күріштің жанкүйерімін!
Dialogue: 0,0:10:44.45,0:10:46.70,Default,,0,0,0,,Керемет! тағамдық артықшылықтарға
Dialogue: 0,0:10:46.70,0:10:49.70,Default,,0,0,0,,Такечи Ичинозамен араласпа.
Dialogue: 0,0:10:49.70,0:10:54.14,Default,,0,0,0,,Токаку-сан... Неге? Мен жай сөйлеп тұрмын.
Dialogue: 0,0:10:54.14,0:10:57.38,Default,,0,0,0,,Хару екеуміз жақсы араласамыз. Эй?
Dialogue: 0,0:10:57.38,0:10:59.81,Default,,0,0,0,,«Хару және мен» туралы не деуге болады?
Dialogue: 0,0:10:59.81,0:11:02.40,Default,,0,0,0,,Дұрыс. Хару және Такечи-сан➡
Dialogue: 0,0:11:02.40,0:11:05.74,Default,,0,0,0,,Біздің туған күндеріміз де бір күн айырмашылығы бар. Бұл таңқаларлық емес пе?
Dialogue: 0,0:11:05.74,0:11:08.74,Default,,0,0,0,,Мен мұндай тамаша нәрсені бірінші рет көріп тұрмын.
Dialogue: 0,0:11:10.92,0:11:13.21,Default,,0,0,0,,Бұл ұқсастық заңы.
Dialogue: 0,0:11:13.21,0:11:17.43,Default,,0,0,0,,Адамдар өздеріне көп ұқсастықтары бар адамдарға жақынырақ сезінеді.
Dialogue: 0,0:11:17.43,0:11:20.57,Default,,0,0,0,,Киригая да Такечи өтірік айтады деп ойлай ма?
Dialogue: 0,0:11:20.57,0:11:23.17,Default,,0,0,0,,Иә. Такечидің көзіне қарап➡
Dialogue: 0,0:11:23.17,0:11:25.59,Default,,0,0,0,,Менің ойымша, бұл қулық.
Dialogue: 0,0:11:25.59,0:11:29.21,Default,,0,0,0,,Ах, бірақ мен ақ күрішті де жақсы көремін.
Dialogue: 0,0:11:29.21,0:11:31.45,Default,,0,0,0,,Мен де
Dialogue: 0,0:11:31.45,0:11:33.86,Default,,0,0,0,,Олардың туған күндерінің айырмашылығы бір күн➡
Dialogue: 0,0:11:33.86,0:11:36.23,Default,,0,0,0,,Мұның бәрі өтірік болуы керек!
Dialogue: 0,0:11:36.23,0:11:38.34,Default,,0,0,0,,Бұл қорқынышты, Токаку-сан.
Dialogue: 0,0:11:38.34,0:11:40.90,Default,,0,0,0,,Өйткені олай өтірік айтудың қажеті жоқ.
Dialogue: 0,0:11:40.90,0:11:45.36,Default,,0,0,0,,Иә! Мен саған жақындап, сені дос ретінде жеңуге тырысамын.
Dialogue: 0,0:11:45.36,0:11:49.96,Default,,0,0,0,,Бірақ Такечи-сан шынымен Харумен дос болғысы келетін шығар.
Dialogue: 0,0:11:51.37,0:11:54.20,Default,,0,0,0,,Менен басқаның бәрі өлтіруші екенін білу➡
Dialogue: 0,0:11:54.20,0:11:57.90,Default,,0,0,0,,Неге сонша бейкүнә ойлайсың!? Сіздің өміріңіз нысанаға алынған!?
Dialogue: 0,0:11:59.46,0:12:03.16,Default,,0,0,0,,Тыңда, қара топтың ережесін айтамын.
Dialogue: 0,0:12:03.16,0:12:05.35,Default,,0,0,0,,Қастандыққа қол жеткізгендер үшін➡
Dialogue: 0,0:12:05.35,0:12:08.43,Default,,0,0,0,,Сыйлық ретінде сізге қалаған нәрсеңіз беріледі.
Dialogue: 0,0:12:08.43,0:12:13.53,Default,,0,0,0,,Өлтіруші хабарлама береді және оны 48 сағат ішінде орындайды.
Dialogue: 0,0:12:16.47,0:12:20.78,Default,,0,0,0,,Бірақ Токаку-сан да Харуды қорғайтынын айтты.
Dialogue: 0,0:12:20.78,0:12:23.78,Default,,0,0,0,,Сондықтан Такечи...
Dialogue: 0,0:12:26.08,0:12:28.39,Default,,0,0,0,,Такечи жалғыз емес
Dialogue: 0,0:12:28.39,0:12:33.32,Default,,0,0,0,,Сонымен, басқалардың бәрі де Харумен дос болса...➡
Dialogue: 0,0:12:33.32,0:12:36.34,Default,,0,0,0,,Сонда ешкім өлмейді➡
Dialogue: 0,0:12:36.34,0:12:39.54,Default,,0,0,0,,Мүмкін бәріміз Қара труппаны бітірерміз, солай ма?
Dialogue: 0,0:12:43.90,0:13:00.10,Default,,0,0,0,,♬～
Dialogue: 0,0:13:00.10,0:13:03.64,Default,,0,0,0,,Сіз ескерту қағазын жібердіңіз. Ах.
Dialogue: 0,0:13:03.64,0:13:07.77,Default,,0,0,0,,Мен Отоя мырзадан қалаған сыйы туралы сұрауым керек.
Dialogue: 0,0:13:07.77,0:13:10.46,Default,,0,0,0,,Мен сериялық өлтіруші сақтандыруды қалаймын.
Dialogue: 0,0:13:10.46,0:13:12.55,Default,,0,0,0,,Пху... Бұл не?
Dialogue: 0,0:13:12.55,0:13:15.27,Default,,0,0,0,,Мен түсінбеймін, сондықтан толығырақ мәлімет сұрағым келеді.
Dialogue: 0,0:13:15.27,0:13:19.17,Default,,0,0,0,,Сондықтан мен өмірімнің соңына дейін сенімді бола аламын➡
Dialogue: 0,0:13:19.17,0:13:23.34,Default,,0,0,0,,Мен сериялық өлтіруші бола алатыныма кепілдік алғым келеді.
Dialogue: 0,0:13:23.34,0:13:26.18,Default,,0,0,0,,Мен қазір қиналып тұрмын.
Dialogue: 0,0:13:26.18,0:13:29.23,Default,,0,0,0,,Мен мұнда жартылай қашып кеткен сияқтымын.
Dialogue: 0,0:13:29.23,0:13:31.77,Default,,0,0,0,,Мені қарт тергеуші байқап қалды.
Dialogue: 0,0:13:31.77,0:13:35.42,Default,,0,0,0,,Басқаша айтқанда, бұл детектив туралы бірдеңе жасаңыз.
Dialogue: 0,0:13:35.42,0:13:37.47,Default,,0,0,0,,Бұл жеткіліксіз.➡
Dialogue: 0,0:13:37.47,0:13:40.36,Default,,0,0,0,,Сондықтан бұл сақтандыру. иә?
Dialogue: 0,0:13:40.36,0:13:44.44,Default,,0,0,0,,Кез келген тілек орындалады дедім.
Dialogue: 0,0:13:44.44,0:13:48.62,Default,,0,0,0,,Мен тек біреу мені олардан үнемі қорғайтындай жан тыныштығын қалаймын.
Dialogue: 0,0:13:48.62,0:13:53.19,Default,,0,0,0,,Хаха~ Иссей Отоя мырзаның бөксесін өмір бойы сүртетін жүйе бар ма?
Dialogue: 0,0:13:53.19,0:13:56.82,Default,,0,0,0,,Дұрыс. Мұндай абсолютті уәде.
Dialogue: 0,0:13:56.82,0:13:59.52,Default,,0,0,0,,Менің қалағаным осы
Dialogue: 0,0:16:10.62,0:16:12.88,Default,,0,0,0,,Мм...｡ Не?
Dialogue: 0,0:16:12.88,0:16:16.00,Default,,0,0,0,,Сіз әлі ашулысыз ба? Мен ашулы емеспін
Dialogue: 0,0:16:16.00,0:16:18.00,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:16:25.07,0:16:28.18,Default,,0,0,0,,Ах! Бұл Хару Чанның бауы!
Dialogue: 0,0:16:28.18,0:16:31.01,Default,,0,0,0,,Бұл тамаша. Мен де алдым.
Dialogue: 0,0:16:31.01,0:16:33.53,Default,,0,0,0,,Иә... жақсы...
Dialogue: 0,0:16:33.53,0:16:37.33,Default,,0,0,0,,Дегенмен, бірінші сағаттық сынақ керемет болды.➡
Dialogue: 0,0:16:37.33,0:16:40.67,Default,,0,0,0,,Мен өз қабілетімді шынымен көрсеттім. Ахахаха
Dialogue: 0,0:16:40.67,0:16:42.74,Default,,0,0,0,,басыңыз. иә?
Dialogue: 0,0:16:42.74,0:16:45.43,Default,,0,0,0,,Қандай дыбыс? Сен не істеп жатырсың?
Dialogue: 0,0:16:45.43,0:16:47.53,Default,,0,0,0,,Мен есікті құлыптап алдым...
Dialogue: 0,0:16:49.10,0:16:52.10,Default,,0,0,0,,Ахаха. Кешіріңіз, мен түсінбеймін.
Dialogue: 0,0:16:52.10,0:16:54.99,Default,,0,0,0,,Түнде Бамба-чанмен сөйлесу оңайырақ сияқты.
Dialogue: 0,0:16:54.99,0:16:57.05,Default,,0,0,0,,Бірақ менің хоббиім...➡
Dialogue: 0,0:16:57.05,0:16:59.15,Default,,0,0,0,,Күндізгі уақытпен жақсы жүретін сияқты.
Dialogue: 0,0:17:00.51,0:17:03.59,Default,,0,0,0,,Бұл бау үлкен қазына➡
Dialogue: 0,0:17:03.59,0:17:06.56,Default,,0,0,0,,Түсінбейтін адамдар бар.
Dialogue: 0,0:17:06.56,0:17:10.57,Default,,0,0,0,,Мұның қадірін білеміз, бірақ
Dialogue: 0,0:17:10.57,0:17:12.59,Default,,0,0,0,,≪Не болды? (2 адам) А
Dialogue: 0,0:17:12.59,0:17:15.94,Default,,0,0,0,,А, шуақ! Бұл ештеңе ~
Dialogue: 0,0:17:15.94,0:17:18.33,Default,,0,0,0,,Қараңдаршы, мен Харекичиден алған бау➡
Dialogue: 0,0:17:18.33,0:17:20.88,Default,,0,0,0,,Өте сүйкімді.➡
Dialogue: 0,0:17:20.88,0:17:23.40,Default,,0,0,0,,Мен бір нәрсені қайтаруым керек.
Dialogue: 0,0:17:23.40,0:17:26.70,Default,,0,0,0,,Солай... Жарайды.
Dialogue: 0,0:17:30.44,0:17:33.21,Default,,0,0,0,,≪Егер біреумен төбелесу керек болса➡
Dialogue: 0,0:17:33.21,0:17:35.78,Default,,0,0,0,,Мен не хабарлауым керек? ≫
Dialogue: 0,0:17:35.78,0:17:37.93,Default,,0,0,0,,≪Әзірше ешкімнен естіген жоқпын➡
Dialogue: 0,0:17:37.93,0:17:40.43,Default,,0,0,0,,Мен алдын ала хабарлама алған жоқпын, бұл жақсы≫
Dialogue: 0,0:17:42.00,0:17:46.44,Default,,0,0,0,,≪Күтіңіз. Ешкім шынымен алдын ала ескерту алған жоқ па? ≫
Dialogue: 0,0:17:46.44,0:17:51.59,Default,,0,0,0,,♬～
Dialogue: 0,0:17:51.59,0:17:53.66,Default,,0,0,0,,Әдетте, сақ болу үшін, су астында олардың бірнешеуін күзетте ұстауымыз керек еді.
Dialogue: 0,0:17:53.66,0:17:57.23,Default,,0,0,0,,Уау~ Харучи Бұл керемет. Хехехе
Dialogue: 0,0:17:57.23,0:18:00.28,Default,,0,0,0,,Аа, дұрыс. Иә!
Dialogue: 0,0:18:00.28,0:18:04.37,Default,,0,0,0,,Қараңдаршы, мынау әдемі емес пе? Иә, белдік үшін рахмет.
Dialogue: 0,0:18:04.37,0:18:09.44,Default,,0,0,0,,Уау, рахмет! Хехе, ұнағанына қуаныштымын.
Dialogue: 0,0:18:09.44,0:18:11.51,Default,,0,0,0,,Мұны Токаку-сан да көрді➡
Dialogue: 0,0:18:11.51,0:18:14.51,Default,,0,0,0,,Сенің Такечи-санға ғашық болатыныңа сенімдімін.
Dialogue: 0,0:18:14.51,0:18:16.77,Default,,0,0,0,,Хехе, одан да көп➡
Dialogue: 0,0:18:16.77,0:18:19.97,Default,,0,0,0,,Әй, тағы біраз сөйлесейік.
Dialogue: 0,0:18:19.97,0:18:22.52,Default,,0,0,0,,Не? А... Такечи-сан?
Dialogue: 0,0:18:22.52,0:18:25.99,Default,,0,0,0,,Немесе ол сізді өлтірушілерден қорғайды➡
Dialogue: 0,0:18:25.99,0:18:27.99,Default,,0,0,0,,Сіз онсыз уайымдайсыз ба?
Dialogue: 0,0:18:31.15,0:18:35.50,Default,,0,0,0,,Хехе, жарайды, мен сені қорғаймын.
Dialogue: 0,0:18:35.50,0:18:39.84,Default,,0,0,0,,Хабарландыру қағазын кеше алдыңыз, солай ма? Неге олай болды...
Dialogue: 0,0:18:39.84,0:18:43.24,Default,,0,0,0,,Бұл хабарлама Шиена Чандікі. иә?
Dialogue: 0,0:18:43.24,0:18:45.86,Default,,0,0,0,,Екеуміз бір бөлмеде болдық, сондықтан мен оны кездейсоқ көрдім.
Dialogue: 0,0:18:45.86,0:18:50.32,Default,,0,0,0,,Мен бірден Шиенаның көзілдірігін сындырдым.
Dialogue: 0,0:18:50.32,0:18:52.64,Default,,0,0,0,,Сізді қорғау үшін
Dialogue: 0,0:18:52.64,0:18:55.66,Default,,0,0,0,,Такечи мырза…｡ Хэхе➡
Dialogue: 0,0:18:55.66,0:18:59.36,Default,,0,0,0,,Көзілдіріксіз көзі анық емес адамға шабуыл жасай алмайсыз, солай ма? ➡
Dialogue: 0,0:18:59.36,0:19:03.03,Default,,0,0,0,,Олар сізге шабуыл жасаса да, оларды тойтару оңай
Dialogue: 0,0:19:03.03,0:19:07.13,Default,,0,0,0,,Уф! Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу...
Dialogue: 0,0:19:07.13,0:19:11.10,Default,,0,0,0,,Хехе, бұл гүлде күшті нейротоксин бар.➡
Dialogue: 0,0:19:11.10,0:19:14.40,Default,,0,0,0,,Gelsemium elegans деп аталатын гүлдердің түрлері
Dialogue: 0,0:19:16.11,0:19:18.71,Default,,0,0,0,,Тіпті Мизороки мырза да білмеуі мүмкін.
Dialogue: 0,0:19:20.08,0:19:22.77,Default,,0,0,0,,Ихиноза!
Dialogue: 0,0:19:22.77,0:19:24.80,Default,,0,0,0,,Сонымен, мен Кираны қоса алғанда сегіз адаммен бірге сусын іштім.
Dialogue: 0,0:19:24.80,0:19:28.37,Default,,0,0,0,,♬～
Dialogue: 0,0:19:28.37,0:19:31.27,Default,,0,0,0,,Күтілгендей. ≪Соққы (есік дыбысы)
Dialogue: 0,0:19:31.27,0:19:35.56,Default,,0,0,0,,Такечи, бұл сен бе? Ичинозамен не істедің?
Dialogue: 0,0:19:35.56,0:19:38.37,Default,,0,0,0,,Сіз нені айтасыз? Күн ашық болса➡
Dialogue: 0,0:19:38.37,0:19:41.40,Default,,0,0,0,,Дәл қазір Шиена-чан екеуміз жертөлеге түстік.
Dialogue: 0,0:19:41.40,0:19:43.44,Default,,0,0,0,,А...
Dialogue: 0,0:19:43.44,0:19:49.06,Default,,0,0,0,,♬～
Dialogue: 0,0:19:49.06,0:19:51.06,Default,,0,0,0,,Ихиноза!
Dialogue: 0,0:19:53.65,0:19:56.10,Default,,0,0,0,,≫ Жарылыс
Dialogue: 0,0:19:56.10,0:19:58.30,Default,,0,0,0,,Цк... Қарғыс атсын!
Dialogue: 0,0:20:02.47,0:20:05.64,Default,,0,0,0,,Эй Кенмочи, көзілдірікті жөндедің бе?
Dialogue: 0,0:20:05.64,0:20:09.53,Default,,0,0,0,,Әй, ол жаңа ғана келді. Мен оны қазір анық көремін.
Dialogue: 0,0:20:09.53,0:20:12.45,Default,,0,0,0,,Бірақ неге ваннада көзілдірік киесің?
Dialogue: 0,0:20:12.45,0:20:15.24,Default,,0,0,0,,Жоқ, сіз нені анық көргіңіз келеді?
Dialogue: 0,0:20:15.24,0:20:17.79,Default,,0,0,0,,Бол... Мұның астарында біртүрлі мағына жоқ.
Dialogue: 0,0:20:17.79,0:20:21.94,Default,,0,0,0,,Бұл керемет емес пе? Мен Такечи Отоямен бір бөлмедемін➡
Dialogue: 0,0:20:21.94,0:20:26.28,Default,,0,0,0,,Көзілдіріксіз өзімді еркін сезінбеймін. Бұл нені білдіреді?
Dialogue: 0,0:20:26.28,0:20:29.90,Default,,0,0,0,,О, Раббым, сен білмейсің. Не?
Dialogue: 0,0:20:29.90,0:20:32.00,Default,,0,0,0,,Білмесеңіз жақсы.➡
Dialogue: 0,0:20:32.00,0:20:34.87,Default,,0,0,0,,Білмеймін, бірақ Будда деген сөз де бар.
Dialogue: 0,0:20:34.87,0:20:37.32,Default,,0,0,0,,Не? (Харуки) Такечиге не болды?
Dialogue: 0,0:20:37.32,0:20:40.88,Default,,0,0,0,,Маған қызық~ Білсеңіздер тез айтыңыздаршы.➡
Dialogue: 0,0:20:40.88,0:20:44.83,Default,,0,0,0,,Бұл жиіркенішті. Неге ешкім білмейді?➡
Dialogue: 0,0:20:44.83,0:20:46.83,Default,,0,0,0,,Әлгі жігіт...
Dialogue: 0,0:20:48.23,0:20:53.46,Default,,0,0,0,,Хехе, ешкім кедергі жасамайтын жерде асықпа...
Dialogue: 0,0:20:53.46,0:20:56.36,Default,,0,0,0,,≪Дон! Дон! (Дене соқтығысқан дыбыс)
Dialogue: 0,0:20:56.36,0:21:00.26,Default,,0,0,0,,Қарғыс атсын! Хахахахаха...
Dialogue: 0,0:21:03.47,0:21:05.54,Default,,0,0,0,,Мен білмедім. Мен➡
Dialogue: 0,0:21:05.54,0:21:08.71,Default,,0,0,0,,Сонымен сіз сериялық өлтірушімен бір бөлмеде ұйықтадыңыз ба?
Dialogue: 0,0:21:08.71,0:21:11.46,Default,,0,0,0,,Сериялық өлтірушілердің көптеген түрлері бар.➡
Dialogue: 0,0:21:11.46,0:21:14.03,Default,,0,0,0,,Такечи жағдайында ол ләззат өлтіруші болып табылады.➡
Dialogue: 0,0:21:14.03,0:21:19.00,Default,,0,0,0,,Сондықтан сіз біреуді өлтіру арқылы ғана жыныстық ләззат ала аласыз.
Dialogue: 0,0:21:19.00,0:21:22.20,Default,,0,0,0,,Мен оны аздап аяймын.
Dialogue: 0,0:21:22.20,0:21:25.04,Default,,0,0,0,,Мен сені аяймын! Менің бөлме құрбым ол➡
Dialogue: 0,0:21:25.04,0:21:27.91,Default,,0,0,0,,Мен сені қатты аяймын! (Исуке) Мені ұрып-соғуға жол бермеңіз➡
Dialogue: 0,0:21:27.91,0:21:30.19,Default,,0,0,0,,Бұл жақсы. Уф.
Dialogue: 0,0:21:30.19,0:21:32.28,Default,,0,0,0,,Қол шапалақтаңыз!
Dialogue: 0,0:21:32.28,0:21:36.20,Default,,0,0,0,,Шығыс!? Кенмочи! Ичинозаны қайда апардыңыз?
Dialogue: 0,0:21:36.20,0:21:38.57,Default,,0,0,0,,Эй... күте тұр! Мен емес! ➡
Dialogue: 0,0:21:38.57,0:21:41.30,Default,,0,0,0,,Хабарландыру қағазын берген Такечи болды! Ах!
Dialogue: 0,0:21:41.30,0:21:45.01,Default,,0,0,0,,♬～
Dialogue: 0,0:21:45.01,0:21:47.31,Default,,0,0,0,,Хмм…｡ Ах.
Dialogue: 0,0:21:47.31,0:21:49.83,Default,,0,0,0,,О, ояусың ба? ➡
Dialogue: 0,0:21:49.83,0:21:54.70,Default,,0,0,0,,Хехе, уайымдама, мен сені бірден өлтірмеймін.
Dialogue: 0,0:21:54.70,0:21:57.87,Default,,0,0,0,,Уақыт шегіне дейін әлі уақыт бар
Dialogue: 0,0:21:57.87,0:22:00.66,Default,,0,0,0,,Кәне көңіл көтерейік
Dialogue: 0,0:22:00.66,0:22:10.93,Default,,0,0,0,,♬～
Dialogue: 0,0:22:10.93,0:22:14.00,Default,,0,0,0,,Эй, сен білесің бе? Мені өрмекші деп атаңыз➡
Dialogue: 0,0:22:14.00,0:22:16.99,Default,,0,0,0,,Ұсталған олжаға улы инені енгізу➡
Dialogue: 0,0:22:16.99,0:22:20.56,Default,,0,0,0,,Оны ішінен ерітіп, дене сұйықтықтарын сорып алыңыз.➡
Dialogue: 0,0:22:20.56,0:22:24.13,Default,,0,0,0,,Жыртқыш аз-аздан ➡ тірі қалады
Dialogue: 0,0:22:24.13,0:22:28.20,Default,,0,0,0,,Өлтіру. Елестетіп көріңізші.
Dialogue: 0,0:22:28.20,0:22:31.37,Default,,0,0,0,,Хехе, бұл мені тоңазытады.
Dialogue: 0,0:22:31.37,0:22:35.44,Default,,0,0,0,,Менде ондай улы ине жоқ, сондықтан мен оны қолданамын.
Dialogue: 0,0:22:35.44,0:22:39.54,Default,,0,0,0,,Тірі тұрғанда аз-аздап ұсақтап ал.➡
Dialogue: 0,0:22:41.10,0:22:43.70,Default,,0,0,0,,Жақсы тыртық
Dialogue: 0,0:22:43.70,0:22:47.37,Default,,0,0,0,,Мен бәрін қайта жазамын.
Dialogue: 0,0:22:47.37,0:22:50.94,Default,,0,0,0,,Гусса! Уф! Хмм! Уф...
Dialogue: 0,0:22:50.94,0:22:53.34,Default,,0,0,0,,А... жоқ➡
Dialogue: 0,0:22:53.34,0:22:56.18,Default,,0,0,0,,Мен суланып бара жатырмын. [TEL] (Әдіс режимі)
Dialogue: 0,0:22:56.18,0:23:00.62,Default,,0,0,0,,Қайдасың!? Такечи! Жақсы жер болса да
Dialogue: 0,0:23:00.62,0:23:04.44,Default,,0,0,0,,Бірақ бұл дұрыс. Сіздің қымбат шуақты күндеріңіз➡
Dialogue: 0,0:23:04.44,0:23:08.63,Default,,0,0,0,,Өліп бара жатқан дауысты естіртейін
Dialogue: 0,0:23:08.63,0:23:12.13,Default,,0,0,0,,[ТЕЛ] Мм! Ихиноза! Тоқта!
Dialogue: 0,0:23:12.13,0:23:14.90,Default,,0,0,0,,Келесі тыртықты қалайсыз?
Dialogue: 0,0:23:14.90,0:23:19.82,Default,,0,0,0,,♬～
Dialogue: 0,0:23:19.82,0:23:21.87,Default,,0,0,0,,Мен қашып кетуге жол бермеймін!
Dialogue: 0,0:23:21.87,0:23:24.04,Default,,0,0,0,,Ичиноза қайда!? Сен қайдасың!?
Dialogue: 0,0:23:24.04,0:23:26.49,Default,,0,0,0,,[ТЕЛ] Пи Ли?
Dialogue: 0,0:23:26.49,0:23:33.70,Default,,0,0,0,,♬～
Dialogue: 0,0:23:33.70,0:23:36.90,Default,,0,0,0,,Га. Мен таптым.
Dialogue: 0,0:23:38.25,0:23:40.25,Default,,0,0,0,,Банг! Bang! (мылтық)
Dialogue: 0,0:23:42.93,0:23:44.98,Default,,0,0,0,,Маған кедергі жасама!
Dialogue: 0,0:23:44.98,0:23:49.30,Default,,0,0,0,,♬～
Dialogue: 0,0:23:49.30,0:23:51.33,Default,,0,0,0,,Ей, сен! Маған әзілдедің ғой, иә!?➡
Dialogue: 0,0:23:51.33,0:24:00.51,Default,,0,0,0,,♬～
Dialogue: 0,0:24:00.51,0:24:03.30,Default,,0,0,0,,Хехе хехе хехе
Dialogue: 0,0:24:03.30,0:24:08.37,Default,,0,0,0,,♬～
Dialogue: 0,0:24:08.37,0:24:11.00,Default,,0,0,0,,Ей, сен! Маған әзілдедің ғой, иә!?➡
Dialogue: 0,0:24:11.00,0:24:14.00,Default,,0,0,0,,Такечи мырза, кешіріңіз.
Dialogue: 0,0:24:18.21,0:24:21.03,Default,,0,0,0,,Қарғыс атсын...｡ Ах.
Dialogue: 0,0:24:21.03,0:24:25.10,Default,,0,0,0,,♬～
Dialogue: 0,0:24:25.10,0:24:27.85,Default,,0,0,0,,Ах... Кешіріңіз.
Dialogue: 0,0:24:27.85,0:24:30.34,Default,,0,0,0,,Токаку-санға рахмет
Dialogue: 0,0:24:30.34,0:24:34.39,Default,,0,0,0,,♬～
Dialogue: 0,0:24:34.39,0:24:36.89,Default,,0,0,0,,Чи-чи-чи-чи…(құстар әні)
Dialogue: 0,0:24:39.95,0:24:42.47,Default,,0,0,0,,Сәтсіз қалған сияқтысыз.➡
Dialogue: 0,0:24:42.47,0:24:45.96,Default,,0,0,0,,Дәл 48 сағат. Уақыт аяқталды.
Dialogue: 0,0:24:45.96,0:24:49.74,Default,,0,0,0,,Мен оны жек көремін! өтінемін! Маған сыйлық керек емес, сондықтан оны Қара тобына қалдырыңыз!
Dialogue: 0,0:24:49.74,0:24:53.33,Default,,0,0,0,,Мен ол баланы өлтіргім келеді! Мен сені өлтіргім келеді!
Dialogue: 0,0:24:53.33,0:24:56.00,Default,,0,0,0,,Бұл жақсы емес. Бұл ереже.
Dialogue: 0,0:24:56.00,0:25:04.14,Default,,0,0,0,,♬～
Dialogue: 0,0:25:04.14,0:25:07.44,Default,,0,0,0,,Ха! Ааа...
Dialogue: 0,0:25:11.26,0:25:15.47,Default,,0,0,0,,Иә~ Бүгін менде барлығына қайғылы жаңалық бар.➡
Dialogue: 0,0:25:15.47,0:25:18.60,Default,,0,0,0,,Тосын оқиғаға мұғалімнің өзі таң қалды➡
Dialogue: 0,0:25:18.60,0:25:22.61,Default,,0,0,0,,Такечидің ауысуы бүгін таңертең кенеттен шешілді.
Dialogue: 0,0:25:22.61,0:25:24.73,Default,,0,0,0,,А... Иә? ➡
Dialogue: 0,0:25:24.73,0:25:28.03,Default,,0,0,0,,Хашири, Хигаши және Ичиноза да сонда емес пе? ➡
Dialogue: 0,0:25:28.03,0:25:30.07,Default,,0,0,0,,Тағы да кешігіп қалдыңыз ба?
Dialogue: 0,0:25:30.07,0:25:35.34,Default,,0,0,0,,♬～
Dialogue: 0,0:25:35.34,0:25:37.64,Default,,0,0,0,,Дегенмен, алдын ала ескертемін —
Dialogue: 0,0:25:39.33,0:25:48.97,Default,,0,0,0,,♬～
Dialogue: 0,0:25:48.97,0:25:54.51,Default,,0,0,0,,♬～
Dialogue: 0,0:25:54.51,0:25:59.16,Default,,0,0,0,,♬～
Dialogue: 0,0:25:59.16,0:26:01.76,Default,,0,0,0,,♬ Ұнатады және ұнатпайды
Dialogue: 0,0:26:01.76,0:26:04.07,Default,,0,0,0,,♬ Қайшылықтарды ұштау
Dialogue: 0,0:26:04.07,0:26:08.87,Default,,0,0,0,,♬ Тор бүгін де тамаша.
Dialogue: 0,0:26:08.87,0:26:11.97,Default,,0,0,0,,♬ Менен бұрын ешкім жоқ
Dialogue: 0,0:26:11.97,0:26:14.01,Default,,0,0,0,,♬ Тұрмаңыз
Dialogue: 0,0:26:14.01,0:26:18.13,Default,,0,0,0,,♬ Қызық енді басталады
Dialogue: 0,0:26:18.13,0:26:23.60,Default,,0,0,0,,♬ Гүлдей солып
Dialogue: 0,0:26:23.60,0:26:28.67,Default,,0,0,0,,♬ Инеліктей өткінші өмір
Dialogue: 0,0:26:28.67,0:26:32.91,Default,,0,0,0,,♬ Ләззат білгің келсе
Dialogue: 0,0:26:32.91,0:26:37.35,Default,,0,0,0,,♬ Құрбан болма
Dialogue: 0,0:26:37.35,0:26:41.67,Default,,0,0,0,,♬ Бір күні шіріп кетсе
Dialogue: 0,0:26:41.67,0:26:46.03,Default,,0,0,0,,♬ Мен сені дәл қазір жақсы көремін
Dialogue: 0,0:26:46.03,0:26:49.25,Default,,0,0,0,,♬ Мәңгі осылай қал
Dialogue: 0,0:26:49.25,0:26:52.78,Default,,0,0,0,,♬ Ұмытқың келмесе
Dialogue: 0,0:26:52.78,0:26:57.40,Default,,0,0,0,,♬ Мен оны тыртық етіп күйдіремін
Dialogue: 0,0:26:57.40,0:27:02.06,Default,,0,0,0,,♬ Көбірек көз жасымен
Dialogue: 0,0:27:02.06,0:27:04.86,Default,,0,0,0,,♬～
Dialogue: 0,0:27:04.86,0:27:08.36,Default,,0,0,0,,♬～
Dialogue: 0,0:28:40.56,0:28:42.86,Default,,0,0,0,,Расында, ұстазға намысты оқушыдан сүйкімді нәрсе➡
Dialogue: 0,0:28:42.86,0:28:46.25,Default,,0,0,0,,Кейбіреулер қиын оқушымын дейді, бірақ шын мәнінде➡
Dialogue: 0,0:28:46.25,0:28:49.38,Default,,0,0,0,,Мұны істеуден жақсы ештеңе жоқ. Токаку➡
Dialogue: 0,0:28:49.38,0:28:52.88,Default,,0,0,0,,Сізді қара топқа не үшін қойғаныңызды шынымен түсінесіз бе?
Dialogue: 0,0:28:54.80,0:28:57.16,Default,,0,0,0,,«Куругуми үй бөлмесі»! Қаң!
Dialogue: 0,0:28:57.16,0:28:59.34,Default,,0,0,0,,Кенеттен не болды? Мынаны қараңыз. Токаку-санмен➡
Dialogue: 0,0:28:59.34,0:29:02.86,Default,,0,0,0,,Мен жатақханада тұра бастағаннан кейін маған ойнайтын бірдеңе керек деп ойладым.
Dialogue: 0,0:29:02.86,0:29:05.10,Default,,0,0,0,,Бұл не? Фуфуфуфу~!
Dialogue: 0,0:29:05.10,0:29:08.32,Default,,0,0,0,,Бұл «Sieg Krone» деп аталатын сауда картасы.
Dialogue: 0,0:29:08.32,0:29:11.52,Default,,0,0,0,,Сіз жинағыңыз келетін картада жаңадан салынған иллюстрациялар да қолданылады ➡
Dialogue: 0,0:29:11.52,0:29:15.26,Default,,0,0,0,,Бұл картаны жаңадан бастаушылардан бастап озық ойыншыларға дейін пайдалана алады!
Dialogue: 0,0:29:15.26,0:29:18.61,Default,,0,0,0,,Сіз өзіңізді мақтан тұтасыз. Бұл жай ғана мұндай нәрсе емес.
Dialogue: 0,0:29:18.61,0:29:22.16,Default,,0,0,0,,Бір қызығы, Токаку-сан мен Хару да осы картамен аяқталады!
Dialogue: 0,0:29:22.16,0:29:24.65,Default,,0,0,0,,«Ібіліс жұмбағы» «Сиг Кроне» қатысады!
Dialogue: 0,0:29:24.65,0:29:27.47,Default,,0,0,0,,Бұл шайқасқа әртүрлі дайындық жасауымыз керек дегенді білдіреді.
Dialogue: 0,0:29:27.47,0:29:30.57,Default,,0,0,0,,Қосымша ақпарат алу үшін «Шайтанның жұмбағы» ресми сайтына кіріңіз.
