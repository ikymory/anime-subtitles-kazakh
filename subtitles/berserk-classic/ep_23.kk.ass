Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:07.57,Default,,0,0,0,,Бұл дүниеде Адамдардың тағдырын басқару
Dialogue: 0,0:00:07.57,0:00:11.09,Default,,0,0,0,,Кейбір трансценденттік заң
Dialogue: 0,0:00:11.09,0:00:15.06,Default,,0,0,0,,Құдайдың қолы
Dialogue: 0,0:00:15.06,0:00:17.56,Default,,0,0,0,,Кем дегенде адамдар
Dialogue: 0,0:00:17.56,0:00:21.07,Default,,0,0,0,,Тіпті өз еркімен
Dialogue: 0,0:00:33.40,0:00:35.33,Default,,0,0,0,,Сіз оны тағы да ұшуға мәжбүрлей алмайсыз ба?
Dialogue: 0,0:00:35.33,0:00:38.34,Default,,0,0,0,,Миссия аяқталған соң маған үйлен.
Dialogue: 0,0:00:40.91,0:00:42.91,Default,,0,0,0,,Ол әлі келді ме?
Dialogue: 0,0:02:03.71,0:02:05.64,Default,,0,0,0,,1-бөлімді жалғастыру.
Dialogue: 0,0:02:05.64,0:02:08.25,Default,,0,0,0,,Менің артымнан екінші корпус келе жатыр.
Dialogue: 0,0:02:19.98,0:02:21.91,Default,,0,0,0,,Осы жылдамдықпен біз қуып жетеміз
Dialogue: 0,0:02:21.91,0:02:24.28,Default,,0,0,0,,Мен бұған көмектесе алмаймын
Dialogue: 0,0:02:24.28,0:02:27.55,Default,,0,0,0,,Жоқ
Dialogue: 0,0:02:27.55,0:02:30.46,Default,,0,0,0,,Го Го
Dialogue: 0,0:02:35.94,0:02:38.82,Default,,0,0,0,,Хаха, сәлемдесу деген осы.
Dialogue: 0,0:02:38.82,0:02:40.85,Default,,0,0,0,,Мен Гриффитті сұрадым.
Dialogue: 0,0:02:40.85,0:02:44.42,Default,,0,0,0,,Маған қалдырыңыз.
Dialogue: 0,0:02:44.42,0:02:46.92,Default,,0,0,0,,Мұнда бірден барлық қуғыншыларды жойыңыз.
Dialogue: 0,0:02:48.97,0:02:52.17,Default,,0,0,0,,Бейбақтар
Dialogue: 0,0:02:52.17,0:02:54.94,Default,,0,0,0,,Ги
Dialogue: 0,0:02:54.94,0:02:57.58,Default,,0,0,0,,Гуо
Dialogue: 0,0:02:57.58,0:03:00.29,Default,,0,0,0,,Нуаааааааааааааааааа
Dialogue: 0,0:03:05.96,0:03:08.88,Default,,0,0,0,,Не болды?
Dialogue: 0,0:03:08.88,0:03:11.65,Default,,0,0,0,,Гуах
Dialogue: 0,0:03:11.65,0:03:17.32,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:03:17.32,0:03:20.27,Default,,0,0,0,,Осымен
Dialogue: 0,0:03:20.27,0:03:22.37,Default,,0,0,0,,Ах
Dialogue: 0,0:03:26.47,0:03:28.42,Default,,0,0,0,,Қозғалмаңыз.
Dialogue: 0,0:03:28.42,0:03:30.35,Default,,0,0,0,,Уф
Dialogue: 0,0:03:30.35,0:03:33.05,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:03:35.19,0:03:38.87,Default,,0,0,0,,Хахахаха балалар
Dialogue: 0,0:03:38.87,0:03:43.04,Default,,0,0,0,,Сондай-ақ
Dialogue: 0,0:03:43.04,0:03:45.04,Default,,0,0,0,,Тоқта! Қараңыз
Dialogue: 0,0:03:48.86,0:03:51.76,Default,,0,0,0,,Бұл адамға
Dialogue: 0,0:03:51.76,0:03:55.13,Default,,0,0,0,,Атқа міну
Dialogue: 0,0:03:55.13,0:04:00.61,Default,,0,0,0,,Жоқ
Dialogue: 0,0:04:00.61,0:04:03.65,Default,,0,0,0,,Хахахаха, сіз дұрыс емес жерде болдыңыз.
Dialogue: 0,0:04:03.65,0:04:07.49,Default,,0,0,0,,Сізге
Dialogue: 0,0:04:07.49,0:04:09.70,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:09.70,0:04:11.90,Default,,0,0,0,,Бұл – Огимотоя.
Dialogue: 0,0:04:25.19,0:04:27.66,Default,,0,0,0,,Иә
Dialogue: 0,0:04:27.66,0:04:29.60,Default,,0,0,0,,Уау...
Dialogue: 0,0:04:29.60,0:04:31.90,Default,,0,0,0,,Таа! Гррр...
Dialogue: 0,0:05:12.85,0:05:15.29,Default,,0,0,0,,Эй
Dialogue: 0,0:05:15.29,0:05:17.23,Default,,0,0,0,,Бұл ақымақтық.
Dialogue: 0,0:05:17.23,0:05:19.24,Default,,0,0,0,,Әлгі бейбақ не деді
Dialogue: 0,0:05:22.87,0:05:25.41,Default,,0,0,0,,Әдетте, сақ болу үшін, су астында олардың бірнешеуін күзетте ұстауымыз керек еді.
Dialogue: 0,0:05:25.41,0:05:28.36,Default,,0,0,0,,Бұл мүмкін емес, мүмкін емес
Dialogue: 0,0:05:28.36,0:05:30.96,Default,,0,0,0,,Мен Гриффитке жауап бере алмаймын.
Dialogue: 0,0:05:30.96,0:05:33.29,Default,,0,0,0,,Ха
Dialogue: 0,0:05:33.29,0:05:35.23,Default,,0,0,0,,Сіз қалжыңдап тұрсыз ба?
Dialogue: 0,0:05:35.23,0:05:38.71,Default,,0,0,0,,Түрмеде тұру
Dialogue: 0,0:05:38.71,0:05:40.71,Default,,0,0,0,,Сондай-ақ «Twilight» код атымен де белгілі
Dialogue: 0,0:05:45.22,0:05:52.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:52.00,0:05:56.30,Default,,0,0,0,,Не?
Dialogue: 0,0:05:56.30,0:05:58.35,Default,,0,0,0,,Болғалы тұрған жоқ па?
Dialogue: 0,0:05:58.35,0:06:02.89,Default,,0,0,0,,Гриффит қайтып келді, олай болмай ма?
Dialogue: 0,0:06:02.89,0:06:05.59,Default,,0,0,0,,1 жыл
Dialogue: 0,0:06:05.59,0:06:08.04,Default,,0,0,0,,Менің серіктерімнің жартысынан астамы да қаза тапты.
Dialogue: 0,0:06:08.04,0:06:10.64,Default,,0,0,0,,Сонда да Гриффит қайтып келді.
Dialogue: 0,0:06:10.64,0:06:15.84,Default,,0,0,0,,Мен сенген сөз тіркесі.
Dialogue: 0,0:06:19.66,0:06:21.59,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:06:21.59,0:06:25.16,Default,,0,0,0,,Мен де осылай ойладым.
Dialogue: 0,0:06:25.16,0:06:27.83,Default,,0,0,0,,Міне
Dialogue: 0,0:06:27.83,0:06:29.84,Default,,0,0,0,,Қазір
Dialogue: 0,0:06:44.27,0:06:47.17,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:06:47.17,0:06:50.18,Default,,0,0,0,,Бұдан былай біз
Dialogue: 0,0:06:53.82,0:06:56.26,Default,,0,0,0,,Бұл «Сұңқарлар тобы» жойылған сияқты емес.
Dialogue: 0,0:06:56.26,0:06:58.20,Default,,0,0,0,,Дәл солай, капитан Каска...
Dialogue: 0,0:06:58.20,0:07:00.81,Default,,0,0,0,,Сұңқар тобы Гриффитпен
Dialogue: 0,0:07:00.81,0:07:03.11,Default,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:07:03.11,0:07:05.04,Default,,0,0,0,,ал екіншісі – «бар күшіңді салу»!
Dialogue: 0,0:07:05.04,0:07:08.49,Default,,0,0,0,,Осы өткен жылы
Dialogue: 0,0:07:08.49,0:07:10.49,Default,,0,0,0,,Артық айтпа.
Dialogue: 0,0:07:10.49,0:07:13.09,Default,,0,0,0,,Құпия полицияға қарсы жасырын операция
Dialogue: 0,0:07:15.96,0:07:20.28,Default,,0,0,0,,Маған біраз уақыт бере аласыз ба?
Dialogue: 0,0:07:20.28,0:07:24.01,Default,,0,0,0,,Бөлінген жасақтың бізге қосылуына әлі біраз уақыт бар.
Dialogue: 0,0:07:24.01,0:07:26.31,Default,,0,0,0,,Оған дейін ойланып көрейін.
Dialogue: 0,0:07:37.71,0:07:39.92,Default,,0,0,0,,Эй
Dialogue: 0,0:07:39.92,0:07:42.82,Default,,0,0,0,,Ойлау
Dialogue: 0,0:07:42.82,0:07:44.79,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:07:44.79,0:07:49.07,Default,,0,0,0,,Алып тасташы, өтінемін...?
Dialogue: 0,0:07:49.07,0:07:51.97,Default,,0,0,0,,Мен өзім күрескен болатынмын.
Dialogue: 0,0:07:51.97,0:07:54.48,Default,,0,0,0,,Өзіңе кигіз дедім.
Dialogue: 0,0:07:54.48,0:07:56.48,Default,,0,0,0,,Бұл бүкіл оқиға әуесқойларға да тамаша әңгіме болады.
Dialogue: 0,0:07:58.42,0:08:00.66,Default,,0,0,0,,Бұл шайқас болғандықтан, мен өзім күрескенмін
Dialogue: 0,0:08:00.66,0:08:02.86,Default,,0,0,0,,Кейбір нәрселерді өз бетіңізше тоқтата алмауыңыз мүмкін.
Dialogue: 0,0:08:05.03,0:08:08.64,Default,,0,0,0,,Осы жолды бүгін Гриффитке айта аласыз ба?
Dialogue: 0,0:08:08.64,0:08:10.64,Default,,0,0,0,,Га
Dialogue: 0,0:08:12.51,0:08:15.05,Default,,0,0,0,,Барлығы әлсіз
Dialogue: 0,0:08:15.05,0:08:18.76,Default,,0,0,0,,Өйткені ол әлсіз
Dialogue: 0,0:08:18.76,0:08:21.43,Default,,0,0,0,,Жылы сөздерді де айтуға болады
Dialogue: 0,0:08:21.43,0:08:23.53,Default,,0,0,0,,Қатаң
Dialogue: 0,0:08:27.14,0:08:31.05,Default,,0,0,0,,Мен біреумін
Dialogue: 0,0:08:44.07,0:08:46.37,Default,,0,0,0,,Гриффитке барыңыз
Dialogue: 0,0:08:55.36,0:08:58.91,Default,,0,0,0,,Гриффит
Dialogue: 0,0:08:58.91,0:09:01.55,Default,,0,0,0,,Тәтті армандар да
Dialogue: 0,0:09:01.55,0:09:05.32,Default,,0,0,0,,Түстің ортасында ояну қиын.
Dialogue: 0,0:09:05.32,0:09:08.13,Default,,0,0,0,,Алып тасташы, өтінемін...?
Dialogue: 0,0:09:08.13,0:09:10.36,Default,,0,0,0,,Муша тағы да жаттығу?
Dialogue: 0,0:09:10.36,0:09:13.63,Default,,0,0,0,,Иә
Dialogue: 0,0:09:13.63,0:09:15.67,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:09:15.67,0:09:19.82,Default,,0,0,0,,Қалғандарды шақырып, бандит бастаймыз ба?
Dialogue: 0,0:09:19.82,0:09:23.22,Default,,0,0,0,,Егер солай болса
Dialogue: 0,0:09:23.22,0:09:25.16,Default,,0,0,0,,Сосын мен де
Dialogue: 0,0:09:25.16,0:09:27.52,Default,,0,0,0,,Яғни… өз санаңды біреудің санасымен алмастыру—
Dialogue: 0,0:09:27.52,0:09:30.10,Default,,0,0,0,,Алысқа баруға еш себеп жоқ.
Dialogue: 0,0:09:30.10,0:09:34.71,Default,,0,0,0,,Сізге
Dialogue: 0,0:09:34.71,0:09:37.68,Default,,0,0,0,,Ариса
Dialogue: 0,0:09:37.68,0:09:39.69,Default,,0,0,0,,Бірақ сіз басқасыз.
Dialogue: 0,0:09:39.69,0:09:43.86,Default,,0,0,0,,Яғни… өз санаңды біреудің санасымен алмастыру—
Dialogue: 0,0:09:43.86,0:09:46.40,Default,,0,0,0,,Тұра алмайтындарды лақтыр.
Dialogue: 0,0:09:46.40,0:09:49.31,Default,,0,0,0,,Бұл ұрыс даласының алтын ережесі.
Dialogue: 0,0:09:49.31,0:09:52.08,Default,,0,0,0,,Бірақ
Dialogue: 0,0:09:52.08,0:09:56.55,Default,,0,0,0,,Алып тасташы, өтінемін...?
Dialogue: 0,0:09:56.55,0:10:00.53,Default,,0,0,0,,Ол бандиттердің көшбасшысы болу үшін тым байсалды.
Dialogue: 0,0:10:00.53,0:10:04.13,Default,,0,0,0,,Мен қатты ұры болғанды ​​жек көремін.
Dialogue: 0,0:10:04.13,0:10:07.64,Default,,0,0,0,,Бұл жолы зорлықпен болса да, мені өзіңізбен бірге алып кетіңіз.
Dialogue: 0,0:10:07.64,0:10:12.39,Default,,0,0,0,,Адамзат тағы да Титанның шапқыншылығына жол берді
Dialogue: 0,0:10:12.39,0:10:15.12,Default,,0,0,0,,Жалғыз
Dialogue: 0,0:10:15.12,0:10:18.50,Default,,0,0,0,,Сол кезде
Dialogue: 0,0:10:18.50,0:10:20.54,Default,,0,0,0,,Кесу тобы
Dialogue: 0,0:10:20.54,0:10:23.84,Default,,0,0,0,,Оған ешкім қарсы емес.
Dialogue: 0,0:10:23.84,0:10:26.21,Default,,0,0,0,,Балалар... тіпті капитан да.
Dialogue: 0,0:10:26.21,0:10:28.16,Default,,0,0,0,,Бірдеңе болады.
Dialogue: 0,0:10:28.16,0:10:30.69,Default,,0,0,0,,Капитан, өтінемін.
Dialogue: 0,0:10:30.69,0:10:32.63,Default,,0,0,0,,Капитан капитан
Dialogue: 0,0:10:32.63,0:10:34.63,Default,,0,0,0,,Капитан, өтінемін.
Dialogue: 0,0:10:34.63,0:10:36.63,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:10:38.98,0:10:42.48,Default,,0,0,0,,Мүмкін менің орным бар шығар.
Dialogue: 0,0:10:45.28,0:10:49.26,Default,,0,0,0,,Мен оны осы уақытқа дейін байқамадым
Dialogue: 0,0:10:49.26,0:10:52.16,Default,,0,0,0,,Мен сол кездегі ең қатты қалағаным болды
Dialogue: 0,0:10:54.40,0:10:56.34,Default,,0,0,0,,Неге...
Dialogue: 0,0:10:56.34,0:10:58.55,Default,,0,0,0,,Неліктен мен оны жоғалтқаннан кейін үнемі байқаймын?
Dialogue: 0,0:11:16.23,0:11:19.11,Default,,0,0,0,,Гриффиттің қолы
Dialogue: 0,0:11:19.11,0:11:22.11,Default,,0,0,0,,Ол өте кішкентай болды
Dialogue: 0,0:11:22.11,0:11:25.21,Default,,0,0,0,,Осы қолдармен барлығын ұстауға тырысу
Dialogue: 0,0:11:27.38,0:11:29.86,Default,,0,0,0,,Осы қолды иығыма қою арқылы
Dialogue: 0,0:11:29.86,0:11:33.10,Default,,0,0,0,,Менің қалтырауым үнемі тоқтады.
Dialogue: 0,0:11:33.10,0:11:36.00,Default,,0,0,0,,Мені қайта-қайта құтқарды
Dialogue: 0,0:11:39.25,0:11:42.25,Default,,0,0,0,,Енді мен мұны істеуім керек
Dialogue: 0,0:11:45.75,0:11:53.14,Default,,0,0,0,,Бұл
Dialogue: 0,0:11:53.14,0:11:57.74,Default,,0,0,0,,А, кешіріңіз.
Dialogue: 0,0:11:57.74,0:12:01.75,Default,,0,0,0,,Ах
Dialogue: 0,0:12:07.73,0:12:10.24,Default,,0,0,0,,Уф
Dialogue: 0,0:12:28.11,0:12:31.58,Default,,0,0,0,,Эй
Dialogue: 0,0:12:31.58,0:12:35.22,Default,,0,0,0,,Гриффит ше? қазір
Dialogue: 0,0:12:35.22,0:12:38.23,Default,,0,0,0,,Иә? Не болды?
Dialogue: 0,0:12:38.23,0:12:41.77,Default,,0,0,0,,Атап айтқанда, кез келген нәрсе
Dialogue: 0,0:12:41.77,0:12:44.31,Default,,0,0,0,,Эй
Dialogue: 0,0:12:44.31,0:12:46.31,Default,,0,0,0,,Ол сөзсіз осында—
Dialogue: 0,0:12:46.31,0:12:48.75,Default,,0,0,0,,Сіз ештеңеге жылап отырсыз ба?
Dialogue: 0,0:12:48.75,0:12:51.66,Default,,0,0,0,,Гриффитке не болды? Тоқта!
Dialogue: 0,0:12:51.66,0:12:53.66,Default,,0,0,0,,Ол сөзсіз осында—
Dialogue: 0,0:12:53.66,0:12:57.09,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:12:57.09,0:12:59.14,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:12:59.14,0:13:02.28,Default,,0,0,0,,Мен бара алмаймын, иә?
Dialogue: 0,0:13:02.28,0:13:04.78,Default,,0,0,0,,Мен
Dialogue: 0,0:13:06.85,0:13:10.73,Default,,0,0,0,,Гриффит соншалықты кішкентай болды.
Dialogue: 0,0:13:10.73,0:13:12.96,Default,,0,0,0,,Осылай қалтырап
Dialogue: 0,0:13:12.96,0:13:17.30,Default,,0,0,0,,Сол мақтаншақ Гриффит...
Dialogue: 0,0:13:17.30,0:13:19.25,Default,,0,0,0,,Оны артта қалдыруға болмайды
Dialogue: 0,0:13:19.25,0:13:21.75,Default,,0,0,0,,Біз қазіргі Гриффитті артта қалдыра алмаймыз.
Dialogue: 0,0:13:24.15,0:13:26.15,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:13:26.15,0:13:28.96,Default,,0,0,0,,Жоспар
Dialogue: 0,0:13:31.20,0:13:34.11,Default,,0,0,0,,Біреудің арманына сенбе
Dialogue: 0,0:13:34.11,0:13:36.71,Default,,0,0,0,,Сіз өз шайқастарыңызбен күресесіз
Dialogue: 0,0:13:38.95,0:13:41.92,Default,,0,0,0,,Сізге бару керек
Dialogue: 0,0:13:41.92,0:13:44.76,Default,,0,0,0,,Егер сіз Гриффиттің шынайы досы болсаңыз.
Dialogue: 0,0:13:44.76,0:13:48.11,Default,,0,0,0,,Менің кетуім керек
Dialogue: 0,0:13:48.11,0:13:50.11,Default,,0,0,0,,Тіпті жалғыз
Dialogue: 0,0:14:03.50,0:14:07.80,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:14:15.45,0:14:18.16,Default,,0,0,0,,Осындай жерде
Dialogue: 0,0:14:23.94,0:14:25.94,Default,,0,0,0,,Га
Dialogue: 0,0:14:32.09,0:14:34.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:34.99,0:14:37.09,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:14:43.71,0:14:46.55,Default,,0,0,0,,Кеттік
Dialogue: 0,0:14:46.55,0:14:48.49,Default,,0,0,0,,Га
Dialogue: 0,0:14:48.49,0:14:51.46,Default,,0,0,0,,Мен әлі жеткілікті ойнаған жоқпын
Dialogue: 0,0:14:51.46,0:14:54.60,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:54.60,0:14:56.90,Default,,0,0,0,,Күн әлі батқан жоқ
Dialogue: 0,0:14:59.58,0:15:01.98,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:07.19,0:15:10.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:10.77,0:15:13.87,Default,,0,0,0,,Ахх!
Dialogue: 0,0:15:15.94,0:15:17.89,Default,,0,0,0,,Уф
Dialogue: 0,0:15:17.89,0:15:20.32,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:15:20.32,0:15:24.23,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:15:24.23,0:15:26.76,Default,,0,0,0,,Яғни… өз санаңды біреудің санасымен алмастыру—
Dialogue: 0,0:15:26.76,0:15:28.77,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:15:35.45,0:15:37.45,Default,,0,0,0,,Уф
Dialogue: 0,0:15:42.23,0:15:45.90,Default,,0,0,0,,Иә
Dialogue: 0,0:15:45.90,0:15:47.84,Default,,0,0,0,,Менің қазір кетуім керек
Dialogue: 0,0:15:47.84,0:15:51.25,Default,,0,0,0,,Әлі біткен жоқ
Dialogue: 0,0:15:51.25,0:15:53.85,Default,,0,0,0,,Артқы аллеядағы тастар
Dialogue: 0,0:15:53.85,0:15:55.85,Default,,0,0,0,,Бұл әлі жалғасуда.
Dialogue: 0,0:16:04.41,0:16:07.41,Default,,0,0,0,,Гриффит
Dialogue: 0,0:16:10.12,0:16:13.09,Default,,0,0,0,,Тамақ!
Dialogue: 0,0:16:13.09,0:16:17.63,Default,,0,0,0,,Кешіріңіз, бірақ маған желдету керек.
Dialogue: 0,0:16:17.63,0:16:22.58,Default,,0,0,0,,Бұл қайда? Не? Менің бетімде бірдеңе бар ма?
Dialogue: 0,0:16:22.58,0:16:26.98,Default,,0,0,0,,Бұрынғы түсімде тағы да болған шығар.
Dialogue: 0,0:16:26.98,0:16:29.29,Default,,0,0,0,,Сіз жақсысыз ба?
Dialogue: 0,0:16:29.29,0:16:31.23,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:31.23,0:16:35.10,Default,,0,0,0,,Соңғы кездері ескі достарым да бетін көрсетпейді.
Dialogue: 0,0:16:35.10,0:16:37.10,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:16:38.98,0:16:43.92,Default,,0,0,0,,Сол адам
Dialogue: 0,0:16:43.92,0:16:46.05,Default,,0,0,0,,Көп емес екен, иә?
Dialogue: 0,0:16:46.05,0:16:49.36,Default,,0,0,0,,Сол күндер туралы
Dialogue: 0,0:16:51.44,0:16:54.34,Default,,0,0,0,,Мұнда
Dialogue: 0,0:16:54.34,0:16:57.34,Default,,0,0,0,,Қолыңызды жуыңыз Иә
Dialogue: 0,0:16:59.82,0:17:04.46,Default,,0,0,0,,Көп нәрсе болды, бірақ қазір
Dialogue: 0,0:17:04.46,0:17:07.76,Default,,0,0,0,,Маған
Dialogue: 0,0:17:07.76,0:17:10.97,Default,,0,0,0,,Сіздермен бірге
Dialogue: 0,0:17:15.48,0:17:19.79,Default,,0,0,0,,Дұрыс, мұндай тыныштық жаман емес...
Dialogue: 0,0:17:25.10,0:17:27.10,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:32.82,0:17:35.32,Default,,0,0,0,,Уф
Dialogue: 0,0:17:38.67,0:17:42.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:42.34,0:17:44.27,Default,,0,0,0,,Ох…
Dialogue: 0,0:17:44.27,0:17:46.94,Default,,0,0,0,,Хехехе
Dialogue: 0,0:17:46.94,0:17:50.25,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:17:50.25,0:17:56.35,Default,,0,0,0,,Аха
Dialogue: 0,0:18:07.68,0:18:09.69,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:17.70,0:18:20.01,Default,,0,0,0,,Уф
Dialogue: 0,0:18:29.33,0:18:31.53,Default,,0,0,0,,Га
Dialogue: 0,0:18:45.73,0:18:50.57,Default,,0,0,0,,Behelit бүркеншік аты
Dialogue: 0,0:18:50.57,0:18:53.38,Default,,0,0,0,,Қолында барлар өз қаны мен етіне айырбастайды.
Dialogue: 0,0:18:53.38,0:18:57.75,Default,,0,0,0,,Дүниені иелену туралы бұйрық
Dialogue: 0,0:18:57.75,0:19:00.76,Default,,0,0,0,,Менің қаным мен етімнің орнына
Dialogue: 0,0:19:04.20,0:19:08.08,Default,,0,0,0,,Гриффит, сізді әкелген адам
Dialogue: 0,0:19:08.08,0:19:11.92,Default,,0,0,0,,Сіз
Dialogue: 0,0:19:11.92,0:19:14.82,Default,,0,0,0,,Жарайды, Рюк.
Dialogue: 0,0:19:14.82,0:19:16.82,Default,,0,0,0,,Мен не істей аламын?
Dialogue: 0,0:19:19.17,0:19:21.44,Default,,0,0,0,,Ха, бұл не?
Dialogue: 0,0:19:21.44,0:19:23.94,Default,,0,0,0,,О.
Dialogue: 0,0:19:27.24,0:19:29.25,Default,,0,0,0,,Күннің тұтылуы?
Dialogue: 0,0:19:41.14,0:19:43.71,Default,,0,0,0,,Гриффит!
Dialogue: 0,0:19:43.71,0:19:45.71,Default,,0,0,0,,Ах
Dialogue: 0,0:19:47.68,0:19:49.69,Default,,0,0,0,,Ах
Dialogue: 0,0:19:51.90,0:19:55.20,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:55.20,0:19:57.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:57.23,0:19:59.24,Default,,0,0,0,,Неге ешкім қабырғаға өрмелеп шығуға тырыспайды?
Dialogue: 0,0:20:01.38,0:20:04.15,Default,,0,0,0,,Ішек
Dialogue: 0,0:20:04.15,0:20:06.15,Default,,0,0,0,,Га
Dialogue: 0,0:20:23.29,0:20:26.03,Default,,0,0,0,,Бұл не? Қуғыншы?
Dialogue: 0,0:20:26.03,0:20:28.61,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:20:28.61,0:20:30.61,Default,,0,0,0,,Білмеймін.
Dialogue: 0,0:20:30.61,0:20:34.01,Default,,0,0,0,,Мен білмеймін, бірақ бұл қорқынышты.
Dialogue: 0,0:20:36.95,0:20:39.26,Default,,0,0,0,,Гриффит!
Dialogue: 0,0:20:39.26,0:20:42.26,Default,,0,0,0,,Келме, Гриффит!
Dialogue: 0,0:20:42.26,0:20:44.46,Default,,0,0,0,,Неге ешкім қабырғаға өрмелеп шығуға тырыспайды?
Dialogue: 0,0:20:44.46,0:20:51.85,Default,,0,0,0,,Көп емес екен, иә?
Dialogue: 0,0:20:51.85,0:20:54.89,Default,,0,0,0,,Мен ешқашан...
Dialogue: 0,0:20:54.89,0:20:57.09,Default,,0,0,0,,Енді ешқашан сен
Dialogue: 0,0:21:04.44,0:21:07.27,Default,,0,0,0,,Гриффит
Dialogue: 0,0:21:07.27,0:21:09.85,Default,,0,0,0,,Уау...
Dialogue: 0,0:21:09.85,0:21:14.56,Default,,0,0,0,,Бүгін «Роллинг фестивалі»
Dialogue: 0,0:21:14.56,0:21:20.17,Default,,0,0,0,,Ууууу...
Dialogue: 0,0:21:22.31,0:21:27.21,Default,,0,0,0,,Гррр...
Dialogue: 0,0:21:35.70,0:21:38.31,Default,,0,0,0,,Ах
Dialogue: 0,0:23:11.93,0:23:14.36,Default,,0,0,0,,Біздің жеткен жеріміз – қараңғылық
Dialogue: 0,0:23:14.36,0:23:16.97,Default,,0,0,0,,Үмітсіздік күтіп тұрды
Dialogue: 0,0:23:16.97,0:23:21.21,Default,,0,0,0,,көтерілу
Dialogue: 0,0:23:25.52,0:23:29.77,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:23:29.77,0:23:31.77,Default,,0,0,0,,Таза арман
Dialogue: 0,0:23:33.27,0:23:38.27,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
