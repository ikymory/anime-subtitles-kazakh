Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:07.48,Default,,0,0,0,,Бұл дүниеде Адамдардың тағдырын басқару
Dialogue: 0,0:00:07.48,0:00:11.17,Default,,0,0,0,,Кейбір трансценденттік заң
Dialogue: 0,0:00:11.17,0:00:15.17,Default,,0,0,0,,Құдайдың қолы бар ма?
Dialogue: 0,0:00:15.17,0:00:17.50,Default,,0,0,0,,Кем дегенде адамдар
Dialogue: 0,0:00:17.50,0:00:21.41,Default,,0,0,0,,Тіпті өз еркі де еркін емес
Dialogue: 0,0:00:25.06,0:00:29.76,Default,,0,0,0,,Мен оның түсінде осылай көміліп қала алмаймын.
Dialogue: 0,0:00:33.57,0:00:36.31,Default,,0,0,0,,Гриффитпен... Иә?
Dialogue: 0,0:00:36.31,0:00:41.02,Default,,0,0,0,,Гриффит екеуіңіздің істеріңіз жақсы болады деп үміттенемін.
Dialogue: 0,0:00:43.19,0:00:46.86,Default,,0,0,0,,Эй
Dialogue: 0,0:00:46.86,0:00:49.26,Default,,0,0,0,,Яһудея Коркас
Dialogue: 0,0:00:54.21,0:00:56.21,Default,,0,0,0,,Біраз уақыт қыдырайық
Dialogue: 0,0:01:05.84,0:01:09.84,Default,,0,0,0,,Мүмкін Гриффит оны тоқтата алатын шығар.
Dialogue: 0,0:02:31.85,0:02:34.42,Default,,0,0,0,,Кенеттен не болды?
Dialogue: 0,0:02:34.42,0:02:36.35,Default,,0,0,0,,Бұл кенеттен емес.
Dialogue: 0,0:02:36.35,0:02:39.65,Default,,0,0,0,,Мен бұл туралы осы жөнелтілімге дейін ойладым.
Dialogue: 0,0:02:39.65,0:02:42.57,Default,,0,0,0,,Сіз де көңіліңізден шықпайсыз ба? Амал жоқ
Dialogue: 0,0:02:42.57,0:02:45.00,Default,,0,0,0,,Осымен
Dialogue: 0,0:02:45.00,0:02:48.87,Default,,0,0,0,,Соңғы үш жыл өте қызықты болды.
Dialogue: 0,0:02:48.87,0:02:53.52,Default,,0,0,0,,Мен бұрыннан фестивальде болған сияқтымын, сондықтан мен шағымдана алмаймын.
Dialogue: 0,0:02:53.52,0:02:55.86,Default,,0,0,0,,Онда неге жер бетінде... Есіміңді әлі естіген жоқпын.
Dialogue: 0,0:02:55.86,0:02:58.76,Default,,0,0,0,,Коркас, сен өте шулысың.
Dialogue: 0,0:02:58.76,0:03:01.67,Default,,0,0,0,,Мен Коркаспын, сұңқар тобының сеннинімін.
Dialogue: 0,0:03:01.67,0:03:07.44,Default,,0,0,0,,Барда бір-екі әпкеңді еркелетудің несі айып?
Dialogue: 0,0:03:07.44,0:03:09.88,Default,,0,0,0,,Енді Уиндхэмдегі кез келген дүкен.
Dialogue: 0,0:03:09.88,0:03:13.56,Default,,0,0,0,,Ол сұңқарлар тобының сеннинчосы. Ол келіп-кетуге еркін.
Dialogue: 0,0:03:13.56,0:03:17.06,Default,,0,0,0,,Көшеде жүрсең, саған балалар мен қыздар ағылады.
Dialogue: 0,0:03:17.06,0:03:21.31,Default,,0,0,0,,Елді сақтайтын батырларымыз анық.
Dialogue: 0,0:03:21.31,0:03:24.21,Default,,0,0,0,,Оның үстіне сен көп ұзамай ақсүйектер қатарына қосыласың.
Dialogue: 0,0:03:24.21,0:03:26.62,Default,,0,0,0,,Егер бұл орын алса, сотта тұру жақсы болады.
Dialogue: 0,0:03:26.62,0:03:29.45,Default,,0,0,0,,Егер бәрі ойдағыдай болса, сіз құлыптың қожасы боласыз.
Dialogue: 0,0:03:29.45,0:03:32.40,Default,,0,0,0,,Әдетте мұндай нәрсені ешқашан ала алмайсыз.
Dialogue: 0,0:03:32.40,0:03:37.17,Default,,0,0,0,,Дұрыс? бірақ біз алдық
Dialogue: 0,0:03:37.17,0:03:39.94,Default,,0,0,0,,Мені қансыратқаны да осы
Dialogue: 0,0:03:39.94,0:03:43.95,Default,,0,0,0,,Сіз оны лақтырмақшысыз.
Dialogue: 0,0:03:45.82,0:03:47.83,Default,,0,0,0,,Қалай болғанда да.
Dialogue: 0,0:03:47.83,0:03:50.26,Default,,0,0,0,,Адамдарды кесіп тастау ғана.
Dialogue: 0,0:03:50.26,0:03:54.78,Default,,0,0,0,,Түнгі кеште ханымдармен билеу мүмкін емес сияқты.
Dialogue: 0,0:03:54.78,0:03:57.21,Default,,0,0,0,,Дұрыс айтасыз, иә?
Dialogue: 0,0:03:57.21,0:04:03.03,Default,,0,0,0,,Мен қылыш сермеу ғана болатын адаммын.
Dialogue: 0,0:04:03.03,0:04:06.36,Default,,0,0,0,,Пә!
Dialogue: 0,0:04:06.36,0:04:08.70,Default,,0,0,0,,Мен бірінші рет біреуді өлтірдім
Dialogue: 0,0:04:08.70,0:04:12.25,Default,,0,0,0,,Оң мен солды әлі танымайтын баланың уақыты келді.
Dialogue: 0,0:04:12.25,0:04:15.78,Default,,0,0,0,,Содан бері мен майдан даласынан басқа ештеңе білмедім.
Dialogue: 0,0:04:15.78,0:04:18.19,Default,,0,0,0,,Білуге де тырыспады
Dialogue: 0,0:04:18.19,0:04:21.93,Default,,0,0,0,,Өлтір, аман қал, бар болғаны.
Dialogue: 0,0:04:21.93,0:04:25.50,Default,,0,0,0,,Бірақ бұл жақсы.
Dialogue: 0,0:04:25.50,0:04:31.01,Default,,0,0,0,,Тек бір адам, маған қарап тұрғанда бәрі жақсы
Dialogue: 0,0:04:34.12,0:04:36.06,Default,,0,0,0,,Бірақ
Dialogue: 0,0:04:36.06,0:04:39.33,Default,,0,0,0,,Ұрыс даласынан өтіп бара жатып, мен мұны түсіндім.
Dialogue: 0,0:04:39.33,0:04:44.17,Default,,0,0,0,,Бұл тек бас үшін күрес, одан пайда жоқ.
Dialogue: 0,0:04:44.17,0:04:47.14,Default,,0,0,0,,Бұл жай ғана баланың ыңылдауы.
Dialogue: 0,0:04:47.14,0:04:51.46,Default,,0,0,0,,Бірақ бәрібір біз кездестік.
Dialogue: 0,0:04:51.46,0:04:54.06,Default,,0,0,0,,Сіз шынымен таң қалдырғыңыз келетін адаммен
Dialogue: 0,0:04:58.23,0:05:01.61,Default,,0,0,0,,Оның ештеңесі жоқ еді.
Dialogue: 0,0:05:01.61,0:05:04.31,Default,,0,0,0,,Мен бәрін алуға тырыстым.
Dialogue: 0,0:05:06.45,0:05:10.39,Default,,0,0,0,,Бірақ мен тым жоғары мақсат қойғандықтан
Dialogue: 0,0:05:10.39,0:05:12.40,Default,,0,0,0,,Әрқашан өзіңізді шегіне жеткізіңіз
Dialogue: 0,0:05:12.40,0:05:15.17,Default,,0,0,0,,Өткір болу керек.
Dialogue: 0,0:05:15.17,0:05:18.01,Default,,0,0,0,,Сондықтан оның қасында мені бар.
Dialogue: 0,0:05:18.01,0:05:21.62,Default,,0,0,0,,Бізде әлсіздерді сапқа тұрғызатын сән-салтанат жоқ.
Dialogue: 0,0:05:21.62,0:05:25.06,Default,,0,0,0,,Бірақ бір қызығы, соғұрлым көп
Dialogue: 0,0:05:25.06,0:05:28.16,Default,,0,0,0,,Ол менің көзіме жарқырап көрінеді.
Dialogue: 0,0:05:30.39,0:05:32.97,Default,,0,0,0,,Мен қазір кешірім сұраймын
Dialogue: 0,0:05:32.97,0:05:38.48,Default,,0,0,0,,Түсінде мен оған қараймын
Dialogue: 0,0:05:38.48,0:05:43.73,Default,,0,0,0,,Қолыма бірдеңе алып қасында тұрғым келеді.
Dialogue: 0,0:05:43.73,0:05:48.63,Default,,0,0,0,,Мен оны жай ғана қорлай алмаймын.
Dialogue: 0,0:05:48.63,0:05:53.21,Default,,0,0,0,,Гриффиттің қасына тұрасыз ба?
Dialogue: 0,0:05:53.21,0:05:56.92,Default,,0,0,0,,Ақымақ болма, бұл жай ғана балалардың ақымақтығы.
Dialogue: 0,0:05:56.92,0:06:00.15,Default,,0,0,0,,Ол ерекше, ол бізден бөлек.
Dialogue: 0,0:06:00.15,0:06:02.63,Default,,0,0,0,,Сіз жасай алатын жалғыз нәрсе - адамдарды кесу.
Dialogue: 0,0:06:02.63,0:06:05.90,Default,,0,0,0,,Көшбасшы болу үшін тым жақсы жағдайда болуы мүмкін.
Dialogue: 0,0:06:05.90,0:06:08.61,Default,,0,0,0,,Мұның бәрін Гриффит жасағанда жақсы болар еді.
Dialogue: 0,0:06:08.61,0:06:11.82,Default,,0,0,0,,Маған мәртебе немесе сынып қызық емес.
Dialogue: 0,0:06:11.82,0:06:14.52,Default,,0,0,0,,Менің қалағаным басқа нәрсе
Dialogue: 0,0:06:14.52,0:06:17.06,Default,,0,0,0,,Бұл сіз өзіңіз үшін жеңетін нәрсе.
Dialogue: 0,0:06:17.06,0:06:19.63,Default,,0,0,0,,Бұл баланың бос әңгімесі
Dialogue: 0,0:06:19.63,0:06:22.34,Default,,0,0,0,,«Өзіңіз үшін жеңетін нәрсе»?
Dialogue: 0,0:06:22.34,0:06:25.61,Default,,0,0,0,,Егер мұндай заттарды табу оңай болса, ешкім қиналмас еді.
Dialogue: 0,0:06:25.61,0:06:27.54,Default,,0,0,0,,Тыңдаңыздар, адамдар
Dialogue: 0,0:06:27.54,0:06:30.92,Default,,0,0,0,,Сіздің жеке қабілеттеріңіз бен ресурстарыңызға және сіз орналасқан шындыққа қатысты.
Dialogue: 0,0:06:30.92,0:06:33.93,Default,,0,0,0,,Біз онымен келісімге келуіміз керек.
Dialogue: 0,0:06:33.93,0:06:38.37,Default,,0,0,0,,«Саған арман болса болғаны» деген сөздерді айтатындар ренжіп қалады.
Dialogue: 0,0:06:38.37,0:06:40.81,Default,,0,0,0,,Ондай адамдар шындыққа назар аудара алмайды.
Dialogue: 0,0:06:40.81,0:06:43.25,Default,,0,0,0,,Бұл әлсіз адамның қашу айласы.
Dialogue: 0,0:06:43.25,0:06:45.78,Default,,0,0,0,,Коркус
Dialogue: 0,0:06:45.78,0:06:50.59,Default,,0,0,0,,Сізге... сізде ондай нәрсе жоқ па?
Dialogue: 0,0:06:50.59,0:06:52.97,Default,,0,0,0,,Е... цк
Dialogue: 0,0:06:52.97,0:06:56.44,Default,,0,0,0,,Сіз мұны істей аласыз ба? Мен үйге барып ұйықтаймын.
Dialogue: 0,0:06:56.44,0:06:59.54,Default,,0,0,0,,Мен бұл тәтті қызбен енді төзе алмаймын.
Dialogue: 0,0:07:01.35,0:07:05.56,Default,,0,0,0,,Ол жігіт баяғыда, мен көріп тұрсам да.
Dialogue: 0,0:07:05.56,0:07:09.03,Default,,0,0,0,,Ол ұрылар тобының басшысы болған.
Dialogue: 0,0:07:09.03,0:07:13.61,Default,,0,0,0,,Кішкентай болса да, ол жігіттің өзі үшін жеңетін нәрсе бар.
Dialogue: 0,0:07:13.61,0:07:15.61,Default,,0,0,0,,Мүмкін ол болған шығар.
Dialogue: 0,0:07:17.48,0:07:22.19,Default,,0,0,0,,Мен әрқашан кез келген нәрсені оңай жасай алатын адам болдым.
Dialogue: 0,0:07:24.86,0:07:31.48,Default,,0,0,0,,Оның қылыштары мен пышақтары орташадан жақсы, көру қабілеті де жақсы болды.
Dialogue: 0,0:07:31.48,0:07:35.22,Default,,0,0,0,,Бірақ мен олардың ешқайсысында үздік бола алмадым.
Dialogue: 0,0:07:35.22,0:07:38.49,Default,,0,0,0,,Сондықтан мен өзім жақсы бола алмасам деп шештім
Dialogue: 0,0:07:38.49,0:07:42.67,Default,,0,0,0,,Мен оған үздік бола алатын адамның қол астында жұмыс істеуді айттым.
Dialogue: 0,0:07:42.67,0:07:45.77,Default,,0,0,0,,Әу бастан қаламайтын адам жоқ.
Dialogue: 0,0:07:48.87,0:07:51.12,Default,,0,0,0,,Мен оны сонда жіберемін.
Dialogue: 0,0:07:51.12,0:07:55.12,Default,,0,0,0,,Сіз өзіңіздің бір нәрсені табасыз деп үміттенемін
Dialogue: 0,0:08:01.17,0:08:03.11,Default,,0,0,0,,Эй, ішек-қарын, а?
Dialogue: 0,0:08:03.11,0:08:05.68,Default,,0,0,0,,Неге Касканы шақырмайсың?
Dialogue: 0,0:08:05.68,0:08:08.48,Default,,0,0,0,,О? Кенеттен не болды?
Dialogue: 0,0:08:08.48,0:08:12.46,Default,,0,0,0,,Бәрі біледі Гриффит...
Dialogue: 0,0:08:12.46,0:08:15.86,Default,,0,0,0,,Менің ойымша, Каска Гриффитпен бірге бола алмайды.
Dialogue: 0,0:08:15.86,0:08:18.50,Default,,0,0,0,,Не? Гриффит нені қалайды
Dialogue: 0,0:08:18.50,0:08:21.18,Default,,0,0,0,,Өйткені бір ғана
Dialogue: 0,0:08:21.18,0:08:26.02,Default,,0,0,0,,Мұны істеудің ең қысқа жолы - Шарлотты алу.
Dialogue: 0,0:08:26.02,0:08:29.22,Default,,0,0,0,,Және жалғыз жол
Dialogue: 0,0:08:29.22,0:08:34.07,Default,,0,0,0,,Сонымен, сіз Каска туралы не ойлайсыз?
Dialogue: 0,0:08:34.07,0:08:37.54,Default,,0,0,0,,Каска - жақсы әйел.
Dialogue: 0,0:08:37.54,0:08:42.39,Default,,0,0,0,,Майдан даласында арқа сүйер әйелдер көп емес.
Dialogue: 0,0:08:42.39,0:08:45.06,Default,,0,0,0,,Бірақ ол мен үшін
Dialogue: 0,0:08:45.06,0:08:48.29,Default,,0,0,0,,Мен әйелден гөрі жолдаспын.
Dialogue: 0,0:08:48.29,0:08:50.29,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:08:55.54,0:08:59.21,Default,,0,0,0,,Өйткені мен тірі жеп қойылудан шын мәнінде қорқамын
Dialogue: 0,0:08:59.21,0:09:03.09,Default,,0,0,0,,Ол Гриффитке қарап тұр.
Dialogue: 0,0:09:03.09,0:09:06.59,Default,,0,0,0,,Сондықтан мен қазіргідей бола алмаймын.
Dialogue: 0,0:09:08.67,0:09:10.60,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:10.60,0:09:14.31,Default,,0,0,0,,Мен сіздің тамыр соғуыңыз бар деп ойладым.
Dialogue: 0,0:09:19.35,0:09:21.96,Default,,0,0,0,,Өкінішті, мен мұнымен жақсымын.
Dialogue: 0,0:09:27.04,0:09:30.37,Default,,0,0,0,,Ах! Жігіттер сендерге
Dialogue: 0,0:09:30.37,0:09:33.75,Default,,0,0,0,,Қорқынышты, Ішек, үндеместен шығып кету.
Dialogue: 0,0:09:33.75,0:09:36.79,Default,,0,0,0,,Неліктен «Сұңқарлар тобын» жек көресіз?
Dialogue: 0,0:09:36.79,0:09:38.79,Default,,0,0,0,,Рикерт
Dialogue: 0,0:09:49.91,0:09:53.19,Default,,0,0,0,,Сіз кетесіз бе?
Dialogue: 0,0:09:53.19,0:09:56.66,Default,,0,0,0,,Сіз Hawk тобынан кетуді жоспарлап отырсыз ба?
Dialogue: 0,0:09:56.66,0:09:59.30,Default,,0,0,0,,олардың әрекеттерін күшейту қаупі бар.
Dialogue: 0,0:09:59.30,0:10:02.71,Default,,0,0,0,,«Кешіріңіз» оны түсіндірмейді. Дұрыстап түсіндіріп беріңізші.
Dialogue: 0,0:10:02.71,0:10:06.48,Default,,0,0,0,,Сұңқар тобы Guts үшін отбасы сияқты емес пе?
Dialogue: 0,0:10:06.48,0:10:08.89,Default,,0,0,0,,Тоқта, Рикерт, өйткені...
Dialogue: 0,0:10:08.89,0:10:12.80,Default,,0,0,0,,Бұл ер адамның шешімі. Үнімізді жауып, оны жіберейік.
Dialogue: 0,0:10:12.80,0:10:15.74,Default,,0,0,0,,Бірақ Гутс кесу капитаны.
Dialogue: 0,0:10:15.74,0:10:18.10,Default,,0,0,0,,Ол Сұңқар тобының ірге тасы емес пе?
Dialogue: 0,0:10:18.10,0:10:21.99,Default,,0,0,0,,Ке! Бұл жігіт келгенге дейін біз жеңілмейтін едік.
Dialogue: 0,0:10:21.99,0:10:23.99,Default,,0,0,0,,Бірақ... үндеме!
Dialogue: 0,0:10:25.99,0:10:28.76,Default,,0,0,0,,Жарайды, жағдай осылай болған соң мен айтайын.
Dialogue: 0,0:10:28.76,0:10:31.40,Default,,0,0,0,,Мен Темиді жек көретінмін.
Dialogue: 0,0:10:31.40,0:10:36.04,Default,,0,0,0,,Мен оны мойындамаймын. Сіз ерекше емессіз.
Dialogue: 0,0:10:36.04,0:10:38.84,Default,,0,0,0,,Сіз Гриффит бола алмайсыз
Dialogue: 0,0:10:41.46,0:10:43.89,Default,,0,0,0,,Келесі жолы біз бір жерде ұрыс даласында кездесеміз,
Dialogue: 0,0:10:43.89,0:10:46.19,Default,,0,0,0,,Арқаңызды бақылаңыз.
Dialogue: 0,0:10:50.50,0:10:54.15,Default,,0,0,0,,Ішек
Dialogue: 0,0:10:54.15,0:10:56.15,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,0:11:11.52,0:11:13.52,Default,,0,0,0,,Га
Dialogue: 0,0:11:20.87,0:11:23.31,Default,,0,0,0,,Мен мұны сол кезде айтуым керек еді.
Dialogue: 0,0:11:23.31,0:11:25.91,Default,,0,0,0,,Сен менікісің
Dialogue: 0,0:11:35.53,0:11:38.77,Default,,0,0,0,,Мен сені осымен жеңдім.
Dialogue: 0,0:11:38.77,0:11:41.31,Default,,0,0,0,,Сіздің ұрыс алаңыңыз және сіздің өліміңіз
Dialogue: 0,0:11:41.31,0:11:43.61,Default,,0,0,0,,Мұның бәрі менікі
Dialogue: 0,0:11:43.61,0:11:46.52,Default,,0,0,0,,Менің қолымнан кеткің келсе
Dialogue: 0,0:11:46.52,0:11:48.45,Default,,0,0,0,,Кім бар?
Dialogue: 0,0:11:48.45,0:11:52.27,Default,,0,0,0,,Өзіңді қылышпен жұлып ал, Гриффит
Dialogue: 0,0:11:52.27,0:11:55.67,Default,,0,0,0,,«Кездескенше» деп күле алмайсың ба?
Dialogue: 0,0:11:59.04,0:12:01.15,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:12:07.56,0:12:11.37,Default,,0,0,0,,Тоқта, екеуің де байсалдысыңдар ма?
Dialogue: 0,0:12:11.37,0:12:13.77,Default,,0,0,0,,Сіз бір-біріңізбен соғысуды жоспарлап отырсыз ба?
Dialogue: 0,0:12:17.24,0:12:21.56,Default,,0,0,0,,Кет, Каска, жолыма түспе.
Dialogue: 0,0:12:21.56,0:12:24.46,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Неге біз бір-бірімізбен шындап ұрыспаймыз?
Dialogue: 0,0:12:24.46,0:12:27.36,Default,,0,0,0,,Екеуі де тегін...
Dialogue: 0,0:12:27.36,0:12:29.30,Default,,0,0,0,,Сіз не істеп жатырсыз? Жіберу.
Dialogue: 0,0:12:29.30,0:12:33.51,Default,,0,0,0,,Менің мұны істеуден басқа амалым жоқ.
Dialogue: 0,0:12:33.51,0:12:37.05,Default,,0,0,0,,Барлығы, не болып жатыр? Біз бір-бірімізбен ұрысып жатырмыз. Біз оны тоқтатуымыз керек.
Dialogue: 0,0:12:37.05,0:12:42.27,Default,,0,0,0,,Екеуміздің арамыздағы мәселе, бізге араласу емес.
Dialogue: 0,0:12:42.27,0:12:45.04,Default,,0,0,0,,Бірақ бәрі осылай жалғаса берсе... талғампаз өмір жалғаса береді.
Dialogue: 0,0:12:45.04,0:12:47.00,Default,,0,0,0,,Сіз ұмыттыңыз ба?
Dialogue: 0,0:12:47.00,0:12:49.67,Default,,0,0,0,,Қылышпен алынса, қылышпен қайтар
Dialogue: 0,0:12:49.67,0:12:52.59,Default,,0,0,0,,Біз жалдамалылар осылай істейміз.
Dialogue: 0,0:12:52.59,0:12:54.99,Default,,0,0,0,,Бірақ…
Dialogue: 0,0:12:54.99,0:12:59.46,Default,,0,0,0,,Бұрын достарыңызды ренжітсеңіз де, сіз өзгердіңіз.
Dialogue: 0,0:12:59.46,0:13:02.81,Default,,0,0,0,,Егер бұл Гриффиттің ниеті болса, ол тартынбады.
Dialogue: 0,0:13:02.81,0:13:07.01,Default,,0,0,0,,Сіз өзгере бастағаныңызды байқадыңыз ба?
Dialogue: 0,0:13:12.29,0:13:15.86,Default,,0,0,0,,Жаудың көзіндей.
Dialogue: 0,0:13:15.86,0:13:19.20,Default,,0,0,0,,Бірақ мені жек көрсең де
Dialogue: 0,0:13:19.20,0:13:23.18,Default,,0,0,0,,Маған сатқын ретінде қараса да
Dialogue: 0,0:13:23.18,0:13:25.38,Default,,0,0,0,,Кеттік, И
Dialogue: 0,0:13:28.95,0:13:31.90,Default,,0,0,0,,Осыдан үш жыл бұрын да солай болған.
Dialogue: 0,0:13:31.90,0:13:35.67,Default,,0,0,0,,Қимастан басталып, қиюмен аяқталады
Dialogue: 0,0:13:35.67,0:13:38.57,Default,,0,0,0,,Маған жарайсың
Dialogue: 0,0:13:38.57,0:13:40.54,Default,,0,0,0,,Мен саған
Dialogue: 0,0:13:40.54,0:13:46.19,Default,,0,0,0,,Қан төгуге тұрарлық.
Dialogue: 0,0:13:46.19,0:13:49.46,Default,,0,0,0,,Ол өлшеусіз күшейді.
Dialogue: 0,0:13:49.46,0:13:54.61,Default,,0,0,0,,Бірақ мен Гриффиттің оны тоқтата алатынына сенімдімін.
Dialogue: 0,0:13:54.61,0:13:59.48,Default,,0,0,0,,Иә, бәрі бұрынғыдай...
Dialogue: 0,0:13:59.48,0:14:03.13,Default,,0,0,0,,Ха... Солай деп үміттенемін.
Dialogue: 0,0:14:03.13,0:14:06.53,Default,,0,0,0,,Мен қалаймын
Dialogue: 0,0:14:06.53,0:14:09.13,Default,,0,0,0,,Мен сенің Гуцта болғаныңды қалаймын
Dialogue: 0,0:14:14.85,0:14:18.22,Default,,0,0,0,,Мен ешқандай шикі жауынгерлік рухты сезінбеймін.
Dialogue: 0,0:14:18.22,0:14:21.23,Default,,0,0,0,,Дегенмен мүмкіндік жоқ
Dialogue: 0,0:14:21.23,0:14:23.23,Default,,0,0,0,,Еш ойланбастан көздер
Dialogue: 0,0:14:25.97,0:14:28.87,Default,,0,0,0,,Сіз шынымен де сыртқа шыққыңыз келе ме?
Dialogue: 0,0:14:28.87,0:14:30.88,Default,,0,0,0,,Менің қолымнан
Dialogue: 0,0:14:30.88,0:14:34.15,Default,,0,0,0,,Жоқ, мен рұқсат бермеймін.
Dialogue: 0,0:14:34.15,0:14:36.39,Default,,0,0,0,,Жеңіске жету мүмкіндігі бірінші соққыда
Dialogue: 0,0:14:36.39,0:14:39.16,Default,,0,0,0,,Ол қылышын төмен түсірген сәт
Dialogue: 0,0:14:39.16,0:14:41.67,Default,,0,0,0,,Оны тікелей иыққа соғыңыз.
Dialogue: 0,0:14:41.67,0:14:46.38,Default,,0,0,0,,Егер қылыштың траекториясы тіпті аздап ауытқып кетсе, ол сізді шынымен өлтіруі мүмкін.
Dialogue: 0,0:14:46.38,0:14:49.68,Default,,0,0,0,,Бірақ егер сіз оны ала алмасаңыз
Dialogue: 0,0:14:49.68,0:14:52.39,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:15:07.68,0:15:09.68,Default,,0,0,0,,Жарайды
Dialogue: 0,0:15:38.75,0:15:40.76,Default,,0,0,0,,Гриффит
Dialogue: 0,0:15:51.31,0:15:53.31,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:15:59.95,0:16:02.06,Default,,0,0,0,,Гриффит
Dialogue: 0,0:16:10.01,0:16:12.02,Default,,0,0,0,,G…
Dialogue: 0,0:16:23.34,0:16:25.94,Default,,0,0,0,,Ішім!
Dialogue: 0,0:16:37.86,0:16:41.81,Default,,0,0,0,,Мен кеттім, Ішек, артыңа қарама.
Dialogue: 0,0:16:41.81,0:16:44.61,Default,,0,0,0,,Бұл кездейсоқтық. Бұл сөзсіз кездейсоқтық.
Dialogue: 0,0:16:44.61,0:16:46.61,Default,,0,0,0,,Мен мақұлдамаймын
Dialogue: 0,0:16:51.36,0:16:53.30,Default,,0,0,0,,Шынайы үйленген жұп екендеріңді дәлелдеңдер.
Dialogue: 0,0:16:53.30,0:16:57.07,Default,,0,0,0,,Бұл жол жиегіндегі тасқа сүрінгендей.
Dialogue: 0,0:16:57.07,0:16:59.07,Default,,0,0,0,,Бұл кішкентай нәрсе.
Dialogue: 0,0:17:00.95,0:17:05.32,Default,,0,0,0,,Барғың келетін жер алысырақ шығар.
Dialogue: 0,0:17:05.32,0:17:08.32,Default,,0,0,0,,Жарайды, мен тұрамын.
Dialogue: 0,0:17:08.32,0:17:10.64,Default,,0,0,0,,Мен қайтадан жүре бастаймын
Dialogue: 0,0:17:10.64,0:17:12.64,Default,,0,0,0,,Бірден
Dialogue: 0,0:17:26.60,0:17:28.87,Default,,0,0,0,,Қар ериді
Dialogue: 0,0:17:28.87,0:17:33.38,Default,,0,0,0,,Ханшайым, мен суық тиіп қалдым. Өтінемін тез төсекке кет.
Dialogue: 0,0:17:33.38,0:17:36.38,Default,,0,0,0,,Жарайды, мен бүгін түсе аламын.
Dialogue: 0,0:17:36.38,0:17:38.78,Default,,0,0,0,,Енді кешіріңіз.
Dialogue: 0,0:17:47.00,0:17:49.00,Default,,0,0,0,,Ха!
Dialogue: 0,0:17:55.39,0:17:58.29,Default,,0,0,0,,Гриффит мырза
Dialogue: 0,0:17:58.29,0:18:01.20,Default,,0,0,0,,Гриффит мырза, не болды?
Dialogue: 0,0:18:01.20,0:18:03.21,Default,,0,0,0,,Жаңбырда, бұл түнде
Dialogue: 0,0:18:03.21,0:18:06.08,Default,,0,0,0,,Қайырлы кеш, Шарлотта.
Dialogue: 0,0:18:06.08,0:18:09.38,Default,,0,0,0,,Қарсы болмасаң, мені бөлмеңе апара аласың ба?
Dialogue: 0,0:18:09.38,0:18:12.19,Default,,0,0,0,,Не? Енді біреу мені көрсе
Dialogue: 0,0:18:12.19,0:18:14.96,Default,,0,0,0,,Ханшайымның ар-намысы да бұзылады.
Dialogue: 0,0:18:14.96,0:18:17.80,Default,,0,0,0,,А... иә
Dialogue: 0,0:18:17.80,0:18:21.04,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:18:21.04,0:18:25.01,Default,,0,0,0,,Ханымның жатын бөлмесін суландырғаным үшін кешіріңіз.
Dialogue: 0,0:18:25.01,0:18:27.71,Default,,0,0,0,,Осындай уақытта маған қонаққа келгеніңіз қандай өрескел...
Dialogue: 0,0:18:31.10,0:18:33.67,Default,,0,0,0,,Мен сенімен танысқым келді.
Dialogue: 0,0:18:33.67,0:18:35.74,Default,,0,0,0,,Гриффитс мырза кеткеннен кейін
Dialogue: 0,0:18:35.74,0:18:39.81,Default,,0,0,0,,Мен бір күні сенің өлімің туралы хабар аламын ба деп қорқатынмын.
Dialogue: 0,0:18:39.81,0:18:44.45,Default,,0,0,0,,Майданнан оралғаннан кейін де тек қорқынышты және қайғылы жайттар бар.
Dialogue: 0,0:18:44.45,0:18:46.82,Default,,0,0,0,,Неліктен... неге ертерек?
Dialogue: 0,0:18:46.82,0:18:49.62,Default,,0,0,0,,Ол мені көруге келген жоқ.
Dialogue: 0,0:19:00.38,0:19:02.49,Default,,0,0,0,,Бұл көп уақытты алады
Dialogue: 0,0:19:12.38,0:19:14.31,Default,,0,0,0,,Гриффит мырза
Dialogue: 0,0:19:14.31,0:19:18.75,Default,,0,0,0,,Ах! Гриффит мырза!
Dialogue: 0,0:19:18.75,0:19:20.76,Default,,0,0,0,,Сіз қорқасыз ба?
Dialogue: 0,0:19:23.60,0:19:27.17,Default,,0,0,0,,Жоқ... бұл қорқынышты болуы мүмкін
Dialogue: 0,0:19:27.17,0:19:29.67,Default,,0,0,0,,Қайғылы нәрселер де
Dialogue: 0,0:19:29.67,0:19:31.98,Default,,0,0,0,,Оны тек отқа тастаңыз
Dialogue: 0,0:19:31.98,0:19:33.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:16.64,0:20:18.64,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:20:41.46,0:20:43.46,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:21:00.66,0:21:02.66,Default,,0,0,0,,Гриффит мырза?
Dialogue: 0,0:21:08.40,0:21:10.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:19.43,0:21:21.94,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:21:21.94,0:21:24.94,Default,,0,0,0,,Бұл келесі генерал Хакухо емес пе?
Dialogue: 0,0:21:24.94,0:21:30.66,Default,,0,0,0,,Жоғары мәртебелі, сіз осындай уақытта неге келдіңіз?
Dialogue: 0,0:21:30.66,0:21:33.26,Default,,0,0,0,,Түсіндім, қылыш...
Dialogue: 0,0:21:33.26,0:21:36.93,Default,,0,0,0,,Әңгімені кейінірек айтып беріңізші.
Dialogue: 0,0:21:36.93,0:21:38.93,Default,,0,0,0,,Оны қайтарыңыз!
Dialogue: 0,0:23:10.69,0:23:12.99,Default,,0,0,0,,Жолы бөлек болуы керек досқа
Dialogue: 0,0:23:12.99,0:23:14.96,Default,,0,0,0,,Қай жерде жоғалуы керек еді
Dialogue: 0,0:23:14.96,0:23:17.36,Default,,0,0,0,,Қоқысқа тастау керек ойлар
Dialogue: 0,0:23:17.36,0:23:20.78,Default,,0,0,0,,Шақыратын тағдыр бар.
Dialogue: 0,0:23:20.78,0:23:25.51,Default,,0,0,0,,Қуаныштың артында қиналғандар
Dialogue: 0,0:23:25.51,0:23:27.45,Default,,0,0,0,,Бақытты уақыт
Dialogue: 0,0:23:27.45,0:23:31.46,Default,,0,0,0,,Неліктен көзді ашып-жұмғанша өтеді?
Dialogue: 0,0:23:32.96,0:23:37.96,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
