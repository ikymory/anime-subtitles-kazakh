Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.62,0:00:04.46,Default,,0,0,0,,Өткен бөлімдердің дөрекі конспектісі
Dialogue: 0,0:00:05.00,0:00:08.96,Default,,0,0,0,,Нагумо Никураның кулонын қуып келеді...
Dialogue: 0,0:00:09.88,0:00:11.80,Default,,0,0,0,,Оны ұрлап әкетті.
Dialogue: 0,0:00:16.30,0:00:17.68,Default,,0,0,0,,Біз жеңілдік.
Dialogue: 0,0:00:17.89,0:00:18.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:21.06,0:00:24.94,Default,,0,0,0,,Біз жеңілдік.
Dialogue: 0,0:00:30.28,0:00:31.49,Default,,0,0,0,,Ооо
Dialogue: 0,0:00:32.03,0:00:34.49,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:00:36.62,0:00:38.83,Default,,0,0,0,,Сәлем Корра! Бұл қайда?
Dialogue: 0,0:00:39.70,0:00:41.87,Default,,0,0,0,,Бұл Танабе отбасы. (Нагумо) Уф, у, а?
Dialogue: 0,0:00:42.25,0:00:44.29,Default,,0,0,0,,Нуо! Бұл не!
Dialogue: 0,0:00:44.37,0:00:47.21,Default,,0,0,0,,Танабе отбасылық қонақжайлылық мұнарасы
Dialogue: 0,0:00:48.17,0:00:50.59,Default,,0,0,0,,Біз жас ханым қайтып келе салысымен бастаймыз...
Dialogue: 0,0:00:50.67,0:00:51.34,Default,,0,0,0,,Уау!
Dialogue: 0,0:00:51.63,0:00:53.55,Default,,0,0,0,,Біраз күтіңіз.
Dialogue: 0,0:00:53.63,0:00:55.47,Default,,0,0,0,,Күте тұрыңыз... басы неден басталады?
Dialogue: 0,0:00:55.68,0:00:58.22,Default,,0,0,0,,Бұл марапат. (Нагумо) Марапат па?
Dialogue: 0,0:00:58.30,0:00:59.60,Default,,0,0,0,,Награда осындай марапат па?
Dialogue: 0,0:00:59.72,0:01:01.35,Default,,0,0,0,,Пинг-понг (Нагумо) жеңді!
Dialogue: 0,0:01:01.43,0:01:02.48,Default,,0,0,0,,келді
Dialogue: 0,0:01:02.89,0:01:06.35,Default,,0,0,0,,Бұл 12-қабаттағы күту залы, жоғарғы қабат (Нагумо) Ха!
Dialogue: 0,0:01:06.48,0:01:08.27,Default,,0,0,0,,Күту залы жоғарғы қабатта ма?
Dialogue: 0,0:01:08.48,0:01:10.19,Default,,0,0,0,,Бұл шарап жертөлесі
Dialogue: 0,0:01:10.27,0:01:11.15,Default,,0,0,0,,Иә
Dialogue: 0,0:01:11.48,0:01:13.24,Default,,0,0,0,,Ал ашық аспан астындағы ванна
Dialogue: 0,0:01:13.36,0:01:14.57,Default,,0,0,0,,Тоңазытқыштың іші
Dialogue: 0,0:01:14.65,0:01:16.03,Default,,0,0,0,,Тәтті тағамдар
Dialogue: 0,0:01:16.11,0:01:17.53,Default,,0,0,0,,Массаж орындығы
Dialogue: 0,0:01:19.74,0:01:22.04,Default,,0,0,0,,Оны пайдалануыңызға болады.
Dialogue: 0,0:01:22.45,0:01:24.29,Default,,0,0,0,,Мамонт Раппи!
Dialogue: 0,0:01:24.87,0:01:26.37,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:01:26.46,0:01:27.79,Default,,0,0,0,,Ашық ваннаны орнату үшін―
Dialogue: 0,0:01:27.88,0:01:31.38,Default,,0,0,0,,Сөйтіп, олар төбеде күту бөлмесін орнату үшін барын салды.
Dialogue: 0,0:01:31.67,0:01:32.92,Default,,0,0,0,,Өте стильді
Dialogue: 0,0:01:33.05,0:01:35.88,Default,,0,0,0,,Жоқ, бұл қашу мүмкін емес ету.
Dialogue: 0,0:01:36.01,0:01:37.64,Default,,0,0,0,,(сыра көбігінің дыбысы)
Dialogue: 0,0:01:38.05,0:01:40.85,Default,,0,0,0,,Тағы біраз күтіңіз.
Dialogue: 0,0:01:41.89,0:01:44.52,Default,,0,0,0,,Бұл қашып кетпеу үшін.
Dialogue: 0,0:01:44.85,0:01:48.69,Default,,0,0,0,,Бұл қашып кетпеу үшін жасалған.
Dialogue: 0,0:01:49.77,0:01:52.57,Default,,0,0,0,,Жоқ, жоқ, жоқ, жоқ! Сіз бұл лифтпен қайта аласыз!
Dialogue: 0,0:01:52.65,0:01:53.61,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:53.78,0:01:54.61,Default,,0,0,0,,Эй!
Dialogue: 0,0:01:55.07,0:01:56.11,Default,,0,0,0,,Түйме жоқ
Dialogue: 0,0:01:56.45,0:01:57.61,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:01:57.78,0:01:58.61,Default,,0,0,0,,Бір жерде емес пе?
Dialogue: 0,0:01:59.07,0:01:59.95,Default,,0,0,0,,Төмен түсетін баспалдақ
Dialogue: 0,0:02:00.24,0:02:01.41,Default,,0,0,0,,Апаттық шығу!
Dialogue: 0,0:02:01.53,0:02:02.79,Default,,0,0,0,,Терезеден...
Dialogue: 0,0:02:06.66,0:02:08.08,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:02:22.30,0:02:24.39,Default,,0,0,0,,Жоқ, бұл қымбат.
Dialogue: 0,0:02:24.97,0:02:27.31,Default,,0,0,0,,Уф!
Dialogue: 0,0:02:27.85,0:02:31.19,Default,,0,0,0,,Ваннаға түс... Іш...
Dialogue: 0,0:02:31.48,0:02:32.61,Default,,0,0,0,,Содан кейін қайтадан ойланыңыз
Dialogue: 0,0:02:32.90,0:02:33.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:33.73,0:02:37.49,Default,,0,0,0,,Нгяааааааа! (Жақсы адам) Уау!
Dialogue: 0,0:02:37.57,0:02:39.95,Default,,0,0,0,,Жоқ, жоқ, жоқ, жоқ! (Жақсы адам) Ааааааааааааааааааа!
Dialogue: 0,0:02:40.41,0:02:42.16,Default,,0,0,0,,♪～
Dialogue: 0,0:02:42.28,0:02:45.29,Default,,0,0,0,,Сәлеметсіздер ме, қымбатты достарым
Dialogue: 0,0:02:45.58,0:02:48.16,Default,,0,0,0,,Маған армандарың туралы айтып бер
Dialogue: 0,0:02:48.33,0:02:53.25,Default,,0,0,0,,Сол күндер есіңізде ме?
Dialogue: 0,0:02:54.63,0:03:00.55,Default,,0,0,0,,Ересек болу қиын, солай емес пе?
Dialogue: 0,0:03:00.68,0:03:07.31,Default,,0,0,0,,Жасырғаныңды тауып алайық.
Dialogue: 0,0:03:08.68,0:03:09.69,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:03:18.40,0:03:24.37,Default,,0,0,0,,Өзіңіздің беймаза ойыңызды тастаңыз
Dialogue: 0,0:03:24.53,0:03:27.37,Default,,0,0,0,,Бұлттар жүзіп келеді
Dialogue: 0,0:03:27.49,0:03:31.42,Default,,0,0,0,,Жоғары қарап, секір!
Dialogue: 0,0:03:32.37,0:03:35.25,Default,,0,0,0,,Жаңбыр тоқтады
Dialogue: 0,0:03:35.46,0:03:38.42,Default,,0,0,0,,Ән айту
Dialogue: 0,0:03:38.63,0:03:42.01,Default,,0,0,0,,Қол ұстасу
Dialogue: 0,0:03:44.80,0:03:47.72,Default,,0,0,0,,Мен күлдім
Dialogue: 0,0:03:47.85,0:03:50.89,Default,,0,0,0,,Сен де күлесің
Dialogue: 0,0:03:51.02,0:03:54.27,Default,,0,0,0,,Әрине ұнайды
Dialogue: 0,0:03:54.40,0:04:00.24,Default,,0,0,0,,Тағы кездесейік
Dialogue: 0,0:04:06.78,0:04:09.16,Default,,0,0,0,,～♪
Dialogue: 0,0:04:17.09,0:04:21.13,Default,,0,0,0,,Танабе отбасынан шыққан қонақжайлылық егіз мұнараларымен таныстыру.
Dialogue: 0,0:04:21.84,0:04:27.10,Default,,0,0,0,,Шығыс мұнарасының жоғарғы қабатындағы күту залындағы алғашқы қонақжайлық
Dialogue: 0,0:04:27.35,0:04:29.52,Default,,0,0,0,,Осы жерде демалып жатқанда...
Dialogue: 0,0:04:29.60,0:04:33.10,Default,,0,0,0,,Көпір күту залынан батыс мұнараға дейін созылады.
Dialogue: 0,0:04:33.39,0:04:37.44,Default,,0,0,0,,Сіз қиылысу кезінде ҚАЛАның керемет көрінісін тамашалай аласыз.
Dialogue: 0,0:04:38.07,0:04:39.86,Default,,0,0,0,,Сіз өтетін батыс мұнарасы...
Dialogue: 0,0:04:39.98,0:04:44.41,Default,,0,0,0,,Сізді әр қабатта таңғажайып қонақжайлық күтеді.
Dialogue: 0,0:04:44.49,0:04:46.41,Default,,0,0,0,,Керек еместерге...
Dialogue: 0,0:04:46.49,0:04:49.58,Default,,0,0,0,,Сондай-ақ күту залынан жасырын өтетін жол бар...
Dialogue: 0,0:04:49.74,0:04:52.58,Default,,0,0,0,,Тауып алсаң, үйге қайт.
Dialogue: 0,0:04:52.83,0:04:57.46,Default,,0,0,0,,Бірақ әр қабаттағы күзетшілер сізді қонақжайлылыққа мәжбүрлеп айдауға тырысады...
Dialogue: 0,0:04:57.54,0:04:59.42,Default,,0,0,0,,Мен келе жатырмын
Dialogue: 0,0:05:00.00,0:05:04.13,Default,,0,0,0,,Егер сіз олардың бәрін жеңе алсаңыз, мұнарадан шыға аласыз.
Dialogue: 0,0:05:05.18,0:05:06.30,Default,,0,0,0,,Түсіндірудің соңы
Dialogue: 0,0:05:08.01,0:05:08.85,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:05:09.30,0:05:10.14,Default,,0,0,0,,Нагумо-сан да
Dialogue: 0,0:05:10.64,0:05:11.47,Default,,0,0,0,,Жақсы адамдар да
Dialogue: 0,0:05:13.64,0:05:15.52,Default,,0,0,0,,Ол қамауға алынды ма?
Dialogue: 0,0:05:15.89,0:05:19.94,Default,,0,0,0,,Мен қазір қашып кетемін, бірақ Нагумо-сан не істейді?
Dialogue: 0,0:05:20.02,0:05:21.90,Default,,0,0,0,,Не? иә? Сіз шыға алмайсыз ба?
Dialogue: 0,0:05:21.98,0:05:23.11,Default,,0,0,0,,Сіз кете аласыз
Dialogue: 0,0:05:23.19,0:05:26.03,Default,,0,0,0,,Нагумо-сан қасымда болса, мен сендірер едім.
Dialogue: 0,0:05:26.11,0:05:29.20,Default,,0,0,0,,Жүр, қолымнан келсе ынтымақтасамын.
Dialogue: 0,0:05:31.29,0:05:32.33,Default,,0,0,0,,Рахмет
Dialogue: 0,0:05:33.16,0:05:36.96,Default,,0,0,0,,Егер сіз осында қалсаңыз, сізге ең жақсы қонақжайлық көрсетіледі.
Dialogue: 0,0:05:37.33,0:05:38.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:38.29,0:05:41.63,Default,,0,0,0,,Тезірек, тез арада қашайық.
Dialogue: 0,0:05:41.71,0:05:43.63,Default,,0,0,0,,Ең жақсы қонақжайлылық?
Dialogue: 0,0:05:43.71,0:05:46.55,Default,,0,0,0,,Нагумо мырза, сәл артқа шегініңіз.
Dialogue: 0,0:05:46.63,0:05:47.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:49.64,0:05:50.64,Default,,0,0,0,,Не?
Dialogue: 0,0:05:51.01,0:05:51.93,Default,,0,0,0,,Әй!
Dialogue: 0,0:05:52.10,0:05:53.18,Default,,0,0,0,,Ой!
Dialogue: 0,0:05:55.10,0:05:57.60,Default,,0,0,0,,Бұл қашу жолы. Барайық.
Dialogue: 0,0:05:57.69,0:05:59.81,Default,,0,0,0,,Эй, эй, эй... Біреуін қалайсың ба?
Dialogue: 0,0:05:59.90,0:06:00.73,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:06:01.48,0:06:03.32,Default,,0,0,0,,Осының бәрін қайдан білесің?
Dialogue: 0,0:06:03.48,0:06:04.69,Default,,0,0,0,,Мен...
Dialogue: 0,0:06:05.19,0:06:07.11,Default,,0,0,0,,Мен қайталаушымын.
Dialogue: 0,0:06:07.65,0:06:10.87,Default,,0,0,0,,Хехехе, әлгі қария тағы келді.
Dialogue: 0,0:06:11.24,0:06:13.66,Default,,0,0,0,,Оның үстіне бұл жолы мен достарымды ертіп келдім.
Dialogue: 0,0:06:13.87,0:06:17.87,Default,,0,0,0,,Сіз қашып құтыла аласыз ба? бірінші әрекет
Dialogue: 0,0:06:18.25,0:06:20.96,Default,,0,0,0,,Кукукукукукукукуку…
Dialogue: 0,0:06:21.38,0:06:24.76,Default,,0,0,0,,Қайталағыш сіздің бұрын ұсталғаныңызды білдіре ме?
Dialogue: 0,0:06:25.05,0:06:27.67,Default,,0,0,0,,Иә, мен екі рет қамауға алындым.
Dialogue: 0,0:06:28.18,0:06:31.05,Default,,0,0,0,,Бірінші рет мен полицияға жоғалған зат туралы хабарлаған болатынмын.
Dialogue: 0,0:06:31.43,0:06:34.47,Default,,0,0,0,,Олар менен жеке сыйлық беруімді өтінді.
Dialogue: 0,0:06:34.60,0:06:38.02,Default,,0,0,0,,Мағынасын түсінбедім, сондықтан бас тарттым...
Dialogue: 0,0:06:38.64,0:06:41.36,Default,,0,0,0,,Мен білмей тұрып, мені көлікке отырғызды.
Dialogue: 0,0:06:41.90,0:06:43.57,Default,,0,0,0,,Мұнда әкелінді
Dialogue: 0,0:06:43.86,0:06:48.36,Default,,0,0,0,,Мен ең жақсы қонақжайлылық пен түсінбеген марапатты алдым.
Dialogue: 0,0:06:48.49,0:06:49.78,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:06:50.20,0:06:51.70,Default,,0,0,0,,Мазарлардағы барлық ескі суреттер
Dialogue: 0,0:06:52.95,0:06:54.54,Default,,0,0,0,,Ең жақсысы емес пе!
Dialogue: 0,0:06:55.16,0:06:58.04,Default,,0,0,0,,Сауапты іс жасасаңыз, сауапқа кенелесіз.
Dialogue: 0,0:06:58.29,0:07:01.08,Default,,0,0,0,,Бұл пакеттің мақсаты емес.
Dialogue: 0,0:07:01.50,0:07:02.54,Default,,0,0,0,,Стоик.
Dialogue: 0,0:07:03.00,0:07:07.76,Default,,0,0,0,,Шаршағанымды сезіп, сол түні жалғыз жастығымды суладым.
Dialogue: 0,0:07:07.84,0:07:09.34,Default,,0,0,0,,Менің ойымша, бұл сізге толық ұнады.
Dialogue: 0,0:07:10.05,0:07:12.93,Default,,0,0,0,,Екінші рет не істегенімді білмей, қамауға алындым.
Dialogue: 0,0:07:13.22,0:07:15.35,Default,,0,0,0,,Шынымды айтсам, бұл мен де.
Dialogue: 0,0:07:15.76,0:07:18.06,Default,,0,0,0,,Еш нәрсеге қарамастан қашып кеткім келді...
Dialogue: 0,0:07:18.31,0:07:20.77,Default,,0,0,0,,Мен бұл жасырын баспалдақты таптым.
Dialogue: 0,0:07:20.89,0:07:21.90,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:07:22.69,0:07:25.52,Default,,0,0,0,,Бірақ ақырында ол төменге түсіп тез ұсталды...
Dialogue: 0,0:07:25.61,0:07:27.44,Default,,0,0,0,,Мен марапатқа ие болдым.
Dialogue: 0,0:07:27.90,0:07:31.32,Default,,0,0,0,,Сіз бірден қамауға алындым дедіңіз... Төменде еденде не бар?
Dialogue: 0,0:07:31.82,0:07:33.32,Default,,0,0,0,,11-қабат (Нагумо) Ммм?
Dialogue: 0,0:07:34.87,0:07:36.41,Default,,0,0,0,,Бұл сынақ бөлмесі.
Dialogue: 0,0:07:36.49,0:07:40.08,Default,,0,0,0,,Нагумо мырзаның орнына екі адам, бізге көмек беруіңізді өтінемін.
Dialogue: 0,0:07:40.21,0:07:41.08,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:07:41.17,0:07:42.58,Default,,0,0,0,,Олай болса, өз қолыңнан келгеннің бәрін жаса!
Dialogue: 0,0:07:42.88,0:07:43.83,Default,,0,0,0,,Фуга
Dialogue: 0,0:07:44.17,0:07:46.71,Default,,0,0,0,,Өйткені сіз бұл туралы әдеттегідей ойлайсыз, солай емес пе?
Dialogue: 0,0:07:46.84,0:07:50.76,Default,,0,0,0,,Біз ваннаға түсіп, жоғарыда спирттік ішімдік ішеміз, сосын той жасаймыз.
Dialogue: 0,0:07:51.13,0:07:54.47,Default,,0,0,0,,Ал, монша қашып кетпей тұрып, мен осында боламын.
Dialogue: 0,0:07:54.76,0:07:56.18,Default,,0,0,0,,Нагумо-сан!
Dialogue: 0,0:07:56.26,0:07:58.18,Default,,0,0,0,,Сіз өз қалаңызды білетін боласыз!
Dialogue: 0,0:07:58.35,0:07:59.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:59.27,0:08:02.77,Default,,0,0,0,,Олар өздерін жақсы сезініп, туған жерін білгісі келетінін айтады.
Dialogue: 0,0:08:03.06,0:08:05.73,Default,,0,0,0,,Бұл не? Егер сіз жақсы адам болсаңыз, оны жіберіп алмаңыз!
Dialogue: 0,0:08:05.81,0:08:08.65,Default,,0,0,0,,Хмм... Моральдық құндылықтардың айырмашылығынан ба...
Dialogue: 0,0:08:08.78,0:08:09.78,Default,,0,0,0,,Осымен
Dialogue: 0,0:08:10.03,0:08:10.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:11.32,0:08:12.70,Default,,0,0,0,,Wa wa ko!
Dialogue: 0,0:08:13.28,0:08:15.45,Default,,0,0,0,,Не? Вако да қамауға алынды ма?
Dialogue: 0,0:08:15.70,0:08:16.58,Default,,0,0,0,,Мен көптен бері өлі болсам да
Dialogue: 0,0:08:17.12,0:08:19.95,Default,,0,0,0,,Мен Нагумо-санның артынан әдеттегідей ғимаратқа көтерілгенімде...
Dialogue: 0,0:08:20.12,0:08:22.29,Default,,0,0,0,,Мен әдеттегідей осы уақытқа дейін жеттім.
Dialogue: 0,0:08:22.37,0:08:23.96,Default,,0,0,0,,Қауіпсіздік Мұнда не болып жатыр?
Dialogue: 0,0:08:24.75,0:08:27.29,Default,,0,0,0,,Сонымен, сіз соңғы бірнеше минутта ыстық суға шомылдыңыз ба?
Dialogue: 0,0:08:27.38,0:08:29.59,Default,,0,0,0,,Иә, менің денем суық.
Dialogue: 0,0:08:29.71,0:08:32.22,Default,,0,0,0,,Тики шоу! Қазір қайттып келемін! (Жақсы адам) Ах!
Dialogue: 0,0:08:32.34,0:08:34.09,Default,,0,0,0,,Ууууууууу!
Dialogue: 0,0:08:34.18,0:08:34.84,Default,,0,0,0,,дегеніміз не?
Dialogue: 0,0:08:35.18,0:08:36.72,Default,,0,0,0,,Сәлем! Оны ашыңыз!
Dialogue: 0,0:08:37.14,0:08:40.31,Default,,0,0,0,,Жоқ, жақсылық жасауға тырысу керек.
Dialogue: 0,0:08:37.14,0:08:40.31,Default,,0,0,0,,Гу Нанана Гууу
Dialogue: 0,0:08:40.60,0:08:43.77,Default,,0,0,0,,Бұл да «Гокутсукун-кун 2» қолжазбасының соңымен сәйкес келеді...
Dialogue: 0,0:08:40.60,0:08:43.77,Default,,0,0,0,,Хмм хмм хмм...
Dialogue: 0,0:08:43.98,0:08:45.35,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:08:45.65,0:08:47.98,Default,,0,0,0,,Ахахха
Dialogue: 0,0:08:48.11,0:08:49.48,Default,,0,0,0,,Чи чикусо!
Dialogue: 0,0:08:49.61,0:08:51.15,Default,,0,0,0,,Хаха (жақсы адам) Нагумо-сан
Dialogue: 0,0:08:51.24,0:08:52.90,Default,,0,0,0,,Беріліп, әрі қарай жүріңіз.
Dialogue: 0,0:08:52.99,0:08:54.49,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:08:56.11,0:08:56.95,Default,,0,0,0,,Мен өзгешемін!
Dialogue: 0,0:08:58.16,0:09:01.58,Default,,0,0,0,,Няро~ Мен сені міндетті түрде ұстаймын.
Dialogue: 0,0:09:02.20,0:09:06.08,Default,,0,0,0,,Хе хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи
Dialogue: 0,0:09:06.83,0:09:08.21,Default,,0,0,0,,Хи хи хи хи хи хи хи хи
Dialogue: 0,0:09:08.88,0:09:14.22,Default,,0,0,0,,Төмен түскің келсе, менің сиқырымның дәнін ашасың.
Dialogue: 0,0:09:14.93,0:09:19.72,Default,,0,0,0,,Түсінбесеңіз, қонақжайлылық сұраңыз.
Dialogue: 0,0:09:19.89,0:09:24.18,Default,,0,0,0,,Хи хи хи хи хи хи...
Dialogue: 0,0:09:24.27,0:09:25.60,Default,,0,0,0,,Гехогехогехогехогехо!
Dialogue: 0,0:09:29.11,0:09:30.94,Default,,0,0,0,,О!
Dialogue: 0,0:09:31.19,0:09:32.15,Default,,0,0,0,,Ата!
Dialogue: 0,0:09:33.32,0:09:34.15,Default,,0,0,0,,Цезарь Цеппели
Dialogue: 0,0:09:34.32,0:09:36.20,Default,,0,0,0,,Жақсы! Тоқта!
Dialogue: 0,0:09:36.28,0:09:38.53,Default,,0,0,0,,Ой! Адададада! (Нагумо, Вако, жақсы адам) Ах...
Dialogue: 0,0:09:38.62,0:09:39.62,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:09:39.70,0:09:39.99,Default,,0,0,0,,Хато кора! Тоқта! аздап! Кола!
Dialogue: 0,0:09:39.99,0:09:42.04,Default,,0,0,0,,Хато кора! Тоқта! аздап! Кола!
Dialogue: 0,0:09:39.99,0:09:42.04,Default,,0,0,0,,Менің ақымақ, сүйкімді кішкентай бауырым
Dialogue: 0,0:09:42.16,0:09:44.79,Default,,0,0,0,,Тоқта! Тоқта! Хато кола! Тоқта! Хато кола!
Dialogue: 0,0:09:45.04,0:09:46.08,Default,,0,0,0,,Ах, о!
Dialogue: 0,0:09:47.62,0:09:48.71,Default,,0,0,0,,О, жоқ болып кетті.
Dialogue: 0,0:09:49.25,0:09:50.96,Default,,0,0,0,,Ең жоғары баға...
Dialogue: 0,0:09:51.42,0:09:55.26,Default,,0,0,0,,Мына үш ақымақ! Қарғыс атсын, тозақ осында!
Dialogue: 0,0:09:55.34,0:09:57.88,Default,,0,0,0,,Мен сені аузынан от шығаратын нәрсемен аяқтаймын.
Dialogue: 0,0:09:57.97,0:09:58.80,Default,,0,0,0,,Бір минут күтіңіз.
Dialogue: 0,0:09:59.09,0:10:01.72,Default,,0,0,0,,Күт, күт, күт, күт! Жапон тілін түсінбейсіз бе?
Dialogue: 0,0:10:01.81,0:10:03.60,Default,,0,0,0,,Тоқта! тоқта! тоқта! тоқта! тоқта!
Dialogue: 0,0:10:03.81,0:10:05.60,Default,,0,0,0,,Менің ақымақ, сүйкімді кішкентай бауырым
Dialogue: 0,0:10:06.02,0:10:07.64,Default,,0,0,0,,Гаа, Калла!
Dialogue: 0,0:10:08.23,0:10:09.15,Default,,0,0,0,,Хато!
Dialogue: 0,0:10:09.40,0:10:10.73,Default,,0,0,0,,О...
Dialogue: 0,0:10:11.65,0:10:13.44,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:13.57,0:10:15.65,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:16.78,0:10:17.61,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:18.24,0:10:19.07,Default,,0,0,0,,Ах
Dialogue: 0,0:10:19.53,0:10:21.16,Default,,0,0,0,,О~
Dialogue: 0,0:10:23.58,0:10:24.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:25.91,0:10:26.87,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:27.71,0:10:31.79,Default,,0,0,0,,Жоқ, жоқ, бұл Иса емес! Бұл не деген фарс?
Dialogue: 0,0:10:31.88,0:10:33.17,Default,,0,0,0,,Тш, тыныш бол!
Dialogue: 0,0:10:33.71,0:10:36.63,Default,,0,0,0,,Мен білмей тұрып, бүркіт құрал болды...
Dialogue: 0,0:10:36.72,0:10:38.97,Default,,0,0,0,,Мүмкін ол пайдаланып жүрген болар
Dialogue: 0,0:10:39.26,0:10:43.89,Default,,0,0,0,,Екеуміз ұзақ уақыт бірге жүрсек те.
Dialogue: 0,0:10:46.06,0:10:51.23,Default,,0,0,0,,Мүмкін мен кешірім сұрауым керек болған шығар.
Dialogue: 0,0:10:51.81,0:10:55.57,Default,,0,0,0,,Куу Тонкичи! Чинпей! Оңай!
Dialogue: 0,0:10:55.78,0:10:58.65,Default,,0,0,0,,Сіз мені кешіресіз бе? Мынадай қыран...
Dialogue: 0,0:10:58.82,0:11:00.57,Default,,0,0,0,,Круппо~
Dialogue: 0,0:11:00.66,0:11:03.28,Default,,0,0,0,,Мақсатты тұлғаның қатысуы тиіс қоғамдық жиынға бару үшін
Dialogue: 0,0:11:03.78,0:11:05.33,Default,,0,0,0,,Бұл емес
Dialogue: 0,0:11:05.41,0:11:10.25,Default,,0,0,0,,Менің барлық сиқырым көрінді және әлі де бұзылған.
Dialogue: 0,0:11:10.42,0:11:15.46,Default,,0,0,0,,Құттықтаймыз, сіз төмен түсе аласыз.
Dialogue: 0,0:11:16.38,0:11:19.67,Default,,0,0,0,,Эй, эй, бұл не?
Dialogue: 0,0:11:20.09,0:11:23.55,Default,,0,0,0,,Сиқыршы Мен өзімді-өзім құртамын деп ешқашан ойламаппын...
Dialogue: 0,0:11:23.85,0:11:27.52,Default,,0,0,0,,Бірақ келесі жолы олай болмайды.
Dialogue: 0,0:11:27.68,0:11:31.69,Default,,0,0,0,,Хэхехехехе хахахаха
Dialogue: 0,0:11:35.65,0:11:39.82,Default,,0,0,0,,Сенің осында болуың сиқыршының жеңілгенін білдіреді.
Dialogue: 0,0:11:40.74,0:11:43.82,Default,,0,0,0,,Құттықтаймыз және Сангоку но Маға қош келдіңіз
Dialogue: 0,0:11:44.41,0:11:48.41,Default,,0,0,0,,Төмен түскің келсе, мені жең.
Dialogue: 0,0:11:48.62,0:11:52.62,Default,,0,0,0,,Әуесқой мені ұрса ғана.
Dialogue: 0,0:11:53.38,0:11:54.58,Default,,0,0,0,,Сен тәжірибелер жүргізіп, пулемётпен оқ жаудырып жүрсің — нағыз ақымақсың.
Dialogue: 0,0:11:55.34,0:11:56.38,Default,,0,0,0,,Ахххх...
Dialogue: 0,0:11:56.50,0:11:57.21,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:11:57.50,0:11:58.38,Default,,0,0,0,,Ха! (Жақсы адам) О
Dialogue: 0,0:11:59.09,0:12:01.68,Default,,0,0,0,,Арх! Бұл тұман соробан ба?
Dialogue: 0,0:12:02.26,0:12:03.72,Default,,0,0,0,,Соробан!
Dialogue: 0,0:12:04.01,0:12:04.97,Default,,0,0,0,,Бұл кішкентай вакуумдық торнадоның соңғы әсері!
Dialogue: 0,0:12:05.22,0:12:08.22,Default,,0,0,0,,Бұл дәстүрлі емес ай прессі.
Dialogue: 0,0:12:08.31,0:12:09.14,Default,,0,0,0,,Не!
Dialogue: 0,0:12:09.27,0:12:10.98,Default,,0,0,0,,Өрімдер~!
Dialogue: 0,0:12:11.35,0:12:12.85,Default,,0,0,0,,Соробан!
Dialogue: 0,0:12:20.03,0:12:21.57,Default,,0,0,0,,Ха! абакус!
Dialogue: 0,0:12:23.28,0:12:27.08,Default,,0,0,0,,Кешіріңіз, Соробан, мен байқаусызда бас сүйегіңізді жарып алдым.
Dialogue: 0,0:12:27.24,0:12:28.83,Default,,0,0,0,,Кешіріңіз! сурет?
Dialogue: 0,0:12:29.91,0:12:33.83,Default,,0,0,0,,Бұл өтірік, солай ма? Эй! абакус! Жауап берізші, өтінемін!
Dialogue: 0,0:12:34.62,0:12:35.54,Default,,0,0,0,,Соробан!
Dialogue: 0,0:12:35.83,0:12:40.71,Default,,0,0,0,,Уу~ Соробан~н! (Жақсы адам) Ууууууу
Dialogue: 0,0:12:41.17,0:12:44.09,Default,,0,0,0,,Ууууууууу... иә? барса
Dialogue: 0,0:12:44.63,0:12:47.05,Default,,0,0,0,,Өрімді бұзбаңыз
Dialogue: 0,0:12:48.14,0:12:48.97,Default,,0,0,0,,Соробан!
Dialogue: 0,0:12:49.10,0:12:50.89,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:51.39,0:12:53.73,Default,,0,0,0,,Жоқ, жоқ! Иса емес!
Dialogue: 0,0:12:53.94,0:12:54.98,Default,,0,0,0,,Мүмкін бұл ағын...
Dialogue: 0,0:12:55.06,0:12:56.98,Default,,0,0,0,,Ол бірдеңе айтып тұр (Нагумо) Ха!
Dialogue: 0,0:12:57.69,0:13:00.32,Default,,0,0,0,,Менің өрімдерім күшейді.
Dialogue: 0,0:13:02.03,0:13:06.78,Default,,0,0,0,,Кішкентай кезімде жеке топсыз ештеңе істей алмайтынмын.
Dialogue: 0,0:13:09.20,0:13:10.79,Default,,0,0,0,,Бұл менің жоғалтуым.
Dialogue: 0,0:13:11.41,0:13:13.71,Default,,0,0,0,,10-қабат енді сенікі.
Dialogue: 0,0:13:14.25,0:13:15.67,Default,,0,0,0,,Бұл менмін...
Dialogue: 0,0:13:15.87,0:13:19.88,Default,,0,0,0,,Кешіріңіз, мен рұқсатсыз 10-қабатқа келдім. Бұл менің кінәм болды, сен жеңілдің.
Dialogue: 0,0:13:21.25,0:13:25.22,Default,,0,0,0,,Екеуміз де жеңілеміз. Үш ұл.
Dialogue: 0,0:13:25.30,0:13:27.43,Default,,0,0,0,,Хэхехе... Иә.
Dialogue: 0,0:13:27.89,0:13:29.35,Default,,0,0,0,,Сондықтан (Нагумо) Хмм.
Dialogue: 0,0:13:29.60,0:13:32.52,Default,,0,0,0,,Құттықтаймын, төмен түсе бер.
Dialogue: 0,0:13:32.97,0:13:36.52,Default,,0,0,0,,Құлып ашылған, тек 9-қабаттан өтіңіз.
Dialogue: 0,0:13:39.15,0:13:41.69,Default,,0,0,0,,Жеңілуге ​​қалай дәтің бар! Кейінірек есте сақта!
Dialogue: 0,0:13:41.78,0:13:42.86,Default,,0,0,0,,Соробан өрімі!
Dialogue: 0,0:13:42.94,0:13:44.24,Default,,0,0,0,,Хмм (тоқылған) Ии
Dialogue: 0,0:13:50.74,0:13:51.20,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:13:51.20,0:13:55.33,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:13:51.20,0:13:55.33,Default,,0,0,0,,Осылай соқыр жүгірсем, табылар ма?
Dialogue: 0,0:13:55.83,0:13:58.12,Default,,0,0,0,,Бақытымызға орай, Нагумо-санды алып кетті, сондықтан оны іздеуге біраз уақыт аламыз деп ойлаймын.
Dialogue: 0,0:13:58.12,0:14:01.46,Default,,0,0,0,,Бақытымызға орай, Нагумо-санды алып кетті, сондықтан біз оны іздеуге біраз уақыт аламыз деп ойлаймын.
Dialogue: 0,0:13:58.12,0:14:01.46,Default,,0,0,0,,Оны көру...
Dialogue: 0,0:14:02.17,0:14:05.22,Default,,0,0,0,,Тек сол... Анау кулон...
Dialogue: 0,0:14:02.17,0:14:05.22,Default,,0,0,0,,Seeherseeher…
Dialogue: 0,0:14:05.22,0:14:05.42,Default,,0,0,0,,Seeherseeher…
Dialogue: 0,0:14:05.42,0:14:07.76,Default,,0,0,0,,Seeherseeher…
Dialogue: 0,0:14:05.42,0:14:07.76,Default,,0,0,0,,Оны ешкімнен бұрын табу керек
Dialogue: 0,0:14:08.68,0:14:10.01,Default,,0,0,0,,Онда...
Dialogue: 0,0:14:10.51,0:14:12.10,Default,,0,0,0,,Бұл кішкентай шытырман оқиға болды.
Dialogue: 0,0:14:12.18,0:14:15.27,Default,,0,0,0,,Сіз менің құмарлығыма қалай қарайсыз?
Dialogue: 0,0:14:15.35,0:14:16.77,Default,,0,0,0,,Кешіріңіз! (Эри/Мацури) Иә?
Dialogue: 0,0:14:17.23,0:14:18.85,Default,,0,0,0,,Бір сәтке бола аламын ба?
Dialogue: 0,0:14:18.98,0:14:20.77,Default,,0,0,0,,Ах Никура-санда (Никура) Ах
Dialogue: 0,0:14:20.86,0:14:21.90,Default,,0,0,0,,Сәлем
Dialogue: 0,0:14:22.27,0:14:23.40,Default,,0,0,0,,Мацури Сіз бір-біріңізді танисыз ба?
Dialogue: 0,0:14:23.82,0:14:24.65,Default,,0,0,0,,Иә
Dialogue: 0,0:14:25.15,0:14:29.03,Default,,0,0,0,,Ах! Нагумо-санның орнында толық емес жұмыс істейтін адам!
Dialogue: 0,0:14:29.16,0:14:33.54,Default,,0,0,0,,Нашар! Ішіндегіні көрсең Хиджоға жаман болар еді!
Dialogue: 0,0:14:33.66,0:14:37.04,Default,,0,0,0,,Ойлан, ойла, қандай да бір идеяны ойлап тап!
Dialogue: 0,0:14:37.21,0:14:40.46,Default,,0,0,0,,Бір сәт Никура Компьютер қозғала бастады.
Dialogue: 0,0:14:41.21,0:14:42.04,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:14:42.42,0:14:44.30,Default,,0,0,0,,Мен енді темперамент дегенді түсінбеймін.
Dialogue: 0,0:14:44.38,0:14:47.59,Default,,0,0,0,,Мен бұл жағдайдан қалай шыға аламын?
Dialogue: 0,0:14:48.01,0:14:49.80,Default,,0,0,0,,Оны жұлып ал.
Dialogue: 0,0:14:49.88,0:14:50.80,Default,,0,0,0,,Шайтан!
Dialogue: 0,0:14:51.05,0:14:52.76,Default,,0,0,0,,Мұны істеу мүмкін емес!
Dialogue: 0,0:14:52.85,0:14:54.14,Default,,0,0,0,,Сен ақымақсың ба?
Dialogue: 0,0:14:54.22,0:14:56.56,Default,,0,0,0,,Өз құбыжықты тартып алудың несі айып?
Dialogue: 0,0:14:56.68,0:14:57.93,Default,,0,0,0,,Өйткені... уау!
Dialogue: 0,0:14:59.23,0:15:01.35,Default,,0,0,0,,Мен де онымен келісемін.
Dialogue: 0,0:15:01.44,0:15:02.40,Default,,0,0,0,,Есік сөйледі!
Dialogue: 0,0:15:03.27,0:15:06.69,Default,,0,0,0,,Бақытымызға орай, сіз оларды шынымен білмейсіз...
Dialogue: 0,0:15:07.03,0:15:10.24,Default,,0,0,0,,Олар кулонның ішінде не бар екенін көрсе де...
Dialogue: 0,0:15:10.36,0:15:13.62,Default,,0,0,0,,Егер сіз оны алып кетсеңіз, ешқандай проблема болмайды.
Dialogue: 0,0:15:13.74,0:15:14.91,Default,,0,0,0,,Мен де келісемін.
Dialogue: 0,0:15:15.62,0:15:18.37,Default,,0,0,0,,Ал... дұрыс.
Dialogue: 0,0:15:18.62,0:15:20.83,Default,,0,0,0,,Иә... бәрі жақсы, солай ма?
Dialogue: 0,0:15:21.04,0:15:23.92,Default,,0,0,0,,Мен сорпасы туралы ешкімді білмеймін.
Dialogue: 0,0:15:24.38,0:15:27.17,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:15:27.80,0:15:31.47,Default,,0,0,0,,Вуоооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооо(Мацури/Эри) Ия?
Dialogue: 0,0:15:32.51,0:15:33.68,Default,,0,0,0,,Идиот!
Dialogue: 0,0:15:33.76,0:15:35.39,Default,,0,0,0,,Неліктен іркіліс жоқ?
Dialogue: 0,0:15:35.47,0:15:38.39,Default,,0,0,0,,Әйтеуір, Кёрецудың ар-ұжданы оған әрекет етеді.
Dialogue: 0,0:15:38.81,0:15:42.69,Default,,0,0,0,,Күні бойы мені іздеп жүгірдің ғой, солай емес пе? сол кулон
Dialogue: 0,0:15:43.10,0:15:45.19,Default,,0,0,0,,Қазір жұлып алсам да, «мас».
Dialogue: 0,0:15:45.27,0:15:46.69,Default,,0,0,0,,Біз бәрін шешеміз.
Dialogue: 0,0:15:46.90,0:15:48.23,Default,,0,0,0,,Нарухоро! (Шайтан) Кет!
Dialogue: 0,0:15:48.61,0:15:50.74,Default,,0,0,0,,Ууууууууууууууу! (Эри/Мацури) Иә?
Dialogue: 0,0:15:51.15,0:15:52.49,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:15:52.70,0:15:56.12,Default,,0,0,0,,Мен адамдар үшін маңызды нәрсе жоғалып бара жатқандай сезінемін ...
Dialogue: 0,0:15:56.33,0:15:58.83,Default,,0,0,0,,Оған көмектесу мүмкін емес. Мен басқа жоспармен барамын.
Dialogue: 0,0:15:58.91,0:16:01.87,Default,,0,0,0,,Стратегия жай ғана жағдайды түсіндіріп, оны қайтарып алу болып табылады.
Dialogue: 0,0:16:02.21,0:16:03.17,Default,,0,0,0,,Бұл қол болды!
Dialogue: 0,0:16:03.25,0:16:04.25,Default,,0,0,0,,Келіңіздер! (никкура) иә
Dialogue: 0,0:16:04.63,0:16:06.13,Default,,0,0,0,,Уа, ау!
Dialogue: 0,0:16:06.21,0:16:07.05,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:16:07.84,0:16:11.42,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:16:14.05,0:16:15.35,Default,,0,0,0,,А, мысық екен, мысық екен.
Dialogue: 0,0:16:15.43,0:16:17.81,Default,,0,0,0,,Өтірік! Маған да көрсет~
Dialogue: 0,0:16:18.18,0:16:19.81,Default,,0,0,0,,Бұл қауіпті! Тыныш тұрыңыз!
Dialogue: 0,0:16:19.93,0:16:22.44,Default,,0,0,0,,Күте тұрыңыз! (Эри/Мацури) Иә?
Dialogue: 0,0:16:25.19,0:16:27.11,Default,,0,0,0,,Жоғалған көлік
Dialogue: 0,0:16:27.23,0:16:30.94,Default,,0,0,0,,Дәл солай Нагумо-сан кулонды тауып алады.
Dialogue: 0,0:16:31.24,0:16:34.16,Default,,0,0,0,,Мен мәңгілік шақпақпын
Dialogue: 0,0:16:34.78,0:16:37.03,Default,,0,0,0,,Иә? Бұл дегеніміз-
Dialogue: 0,0:16:37.12,0:16:41.16,Default,,0,0,0,,Нагумо-сан мені таппаса, бұл менде бәрі жақсы болады дегенді білдіре ме?
Dialogue: 0,0:16:41.29,0:16:43.50,Default,,0,0,0,,Егер бұл орын алса...
Dialogue: 0,0:16:43.83,0:16:48.46,Default,,0,0,0,,Нагумо-санға жүгіріп барып, оны іздегенше, оның жанында болған қауіпсіз.
Dialogue: 0,0:16:49.34,0:16:52.67,Default,,0,0,0,,Әй, дәлірек айтсақ, ол кісі ұрланған жоқ па?
Dialogue: 0,0:16:53.97,0:16:54.84,Default,,0,0,0,,Шығар ма екен...
Dialogue: 0,0:16:56.18,0:16:57.64,Default,,0,0,0,,(Қоңырау үні)
Dialogue: 0,0:16:58.93,0:17:01.39,Default,,0,0,0,,Иә, Нагумо-сан, қазір қайдасың?
Dialogue: 0,0:17:01.47,0:17:04.31,Default,,0,0,0,,Никура? Дұрыс, маған көмектес!
Dialogue: 0,0:17:04.39,0:17:06.02,Default,,0,0,0,,Бұл мұнара! Бұл мұнарада!
Dialogue: 0,0:17:06.10,0:17:08.36,Default,,0,0,0,,Мұнара дегеніміз не? Не, көмектесу дегенді қалай түсінесің?
Dialogue: 0,0:17:08.44,0:17:10.65,Default,,0,0,0,,Мен түсінбеймін, бірақ тез келіңізші!
Dialogue: 0,0:17:10.73,0:17:13.15,Default,,0,0,0,,А, мен түсіндім! Мен бірден барамын!
Dialogue: 0,0:17:13.49,0:17:15.41,Default,,0,0,0,,Мұнара қайда орналасқан?
Dialogue: 0,0:17:15.61,0:17:18.32,Default,,0,0,0,,Ах! Бұл не?
Dialogue: 0,0:17:18.45,0:17:20.24,Default,,0,0,0,,Ей, бұл үлкен мәселе!
Dialogue: 0,0:17:20.33,0:17:21.95,Default,,0,0,0,,Бізге асығу керек! (Нагумо) Ха!
Dialogue: 0,0:17:22.29,0:17:23.91,Default,,0,0,0,,Хехехехе
Dialogue: 0,0:17:24.04,0:17:25.50,Default,,0,0,0,,Сіз не істедіңіз?
Dialogue: 0,0:17:25.58,0:17:29.50,Default,,0,0,0,,Хехехе, кешіріңіз, мен жай ғана жақсы нәрсе ойладым.
Dialogue: 0,0:17:29.59,0:17:32.76,Default,,0,0,0,,Жоқ, дұрыс. Иә, иә, иә.
Dialogue: 0,0:17:33.67,0:17:35.47,Default,,0,0,0,,Міне келдік!
Dialogue: 0,0:17:39.60,0:17:40.51,Default,,0,0,0,,ＧＩＶＥ ＵＰ！
Dialogue: 0,0:17:40.76,0:17:42.18,Default,,0,0,0,,Мен жапон тілін түсінбеймін!
Dialogue: 0,0:17:43.77,0:17:45.19,Default,,0,0,0,,Мина қаласы~
Dialogue: 0,0:17:45.56,0:17:47.69,Default,,0,0,0,,Фи! Фай! … (мүшелер) О! О! …
Dialogue: 0,0:17:47.81,0:17:50.23,Default,,0,0,0,,(айқайлауды жалғастырады)
Dialogue: 0,0:17:50.36,0:17:51.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:52.32,0:17:53.49,Default,,0,0,0,,Бір минут күте тұрыңыз!
Dialogue: 0,0:17:53.57,0:17:56.70,Default,,0,0,0,,Бұл не, Мақабе? Сіз капитанның жүгіруіне шағымданып жатырсыз ба?
Dialogue: 0,0:17:56.82,0:17:58.70,Default,,0,0,0,,Жоқ, менің айтқым келгені бұл емес.
Dialogue: 0,0:17:59.12,0:18:02.20,Default,,0,0,0,,Сонда ше? Жүгірудің жақсы жолы бар ма?
Dialogue: 0,0:18:02.29,0:18:04.50,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:18:04.87,0:18:07.46,Default,,0,0,0,,Сіз капитанның жүгіруін тоқтатқыңыз келді ме?
Dialogue: 0,0:18:07.58,0:18:08.21,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:08.50,0:18:10.13,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:18:10.21,0:18:11.46,Default,,0,0,0,,Айт! Макабе!
Dialogue: 0,0:18:11.84,0:18:14.34,Default,,0,0,0,,Иә! Міне, Цучиноко
Dialogue: 0,0:18:14.84,0:18:16.47,Default,,0,0,0,,Пууоооооооооооооооооооооооооооооооооооооо
Dialogue: 0,0:18:16.55,0:18:17.63,Default,,0,0,0,,Не болды, ағайын?
Dialogue: 0,0:18:18.34,0:18:22.60,Default,,0,0,0,,Куәгерлер көп, бірақ оны ешкім ұстаған жоқ.
Dialogue: 0,0:18:23.22,0:18:27.81,Default,,0,0,0,,Куәгердің оның өте жылдам екенін, жоқ, уы бар, т.б.
Dialogue: 0,0:18:28.73,0:18:32.82,Default,,0,0,0,,Жыланмен салыстырғанда денесінің ісінгендігімен сипатталады.
Dialogue: 0,0:18:33.32,0:18:36.32,Default,,0,0,0,,Оян, бұл жай ғана жылан.
Dialogue: 0,0:18:36.90,0:18:41.03,Default,,0,0,0,,Бұл денеге сіз жеген нәрсе толтырылған болуы керек.
Dialogue: 0,0:18:41.12,0:18:42.16,Default,,0,0,0,,Наха!
Dialogue: 0,0:18:42.37,0:18:44.74,Default,,0,0,0,,А... бұл Цучиноко.
Dialogue: 0,0:18:45.12,0:18:47.96,Default,,0,0,0,,Мен шошып кеттім... Қорықтым, Мақабе.
Dialogue: 0,0:18:48.58,0:18:51.33,Default,,0,0,0,,Мен сияқты әуелден күдіктенетіндерге...
Dialogue: 0,0:18:51.63,0:18:54.50,Default,,0,0,0,,Мүмкін сіз бір жерде маңызды нәрсені жоғалтқан шығарсыз.
Dialogue: 0,0:18:55.00,0:18:59.01,Default,,0,0,0,,Цучинокоға қарасаң, оның Цучиноко екенін білуге ​​болады. Мақабенің тазалығы –...
Dialogue: 0,0:18:59.18,0:19:00.84,Default,,0,0,0,,Мен Цучиноконы таптым
Dialogue: 0,0:19:01.22,0:19:02.35,Default,,0,0,0,,Йоку-сенпай!
Dialogue: 0,0:19:02.85,0:19:06.18,Default,,0,0,0,,Құтты болсын Мақабе, тазалығыңды бағала.
Dialogue: 0,0:19:06.27,0:19:06.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:06.98,0:19:09.81,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:19:12.69,0:19:15.28,Default,,0,0,0,,Енді оны ұстау уақыты келді!
Dialogue: 0,0:19:15.48,0:19:17.49,Default,,0,0,0,,Макабе тапқан осы UMA
Dialogue: 0,0:19:17.65,0:19:19.53,Default,,0,0,0,,Біз мұны елемеуге болмайды
Dialogue: 0,0:19:19.61,0:19:21.36,Default,,0,0,0,,Сен жасамасаң, кім жасайды?
Dialogue: 0,0:19:21.99,0:19:22.95,Default,,0,0,0,,…қашып кету…
Dialogue: 0,0:19:23.66,0:19:26.91,Default,,0,0,0,,Олай болса, лайықсыз Макабе Татеваку, мені жіберіңіз...
Dialogue: 0,0:19:27.00,0:19:29.12,Default,,0,0,0,,Бір минут күтіңіз! (Татеваку) Арири!
Dialogue: 0,0:19:29.91,0:19:30.87,Default,,0,0,0,,Йоку Сенпай
Dialogue: 0,0:19:31.50,0:19:33.38,Default,,0,0,0,,Әуесқойлардың қолынан келмейтіні сондықтан.
Dialogue: 0,0:19:34.17,0:19:37.51,Default,,0,0,0,,Оның кісі өлтіру ниеті болмағандықтан, ол мойынсұнып маған ертерек тиісуге рұқсат берді, бірақ...
Dialogue: 0,0:19:37.63,0:19:39.42,Default,,0,0,0,,Әрі қарай не болады?
Dialogue: 0,0:19:40.01,0:19:43.18,Default,,0,0,0,,Осыны ескере отырып, мені ұстай аласыз ба?
Dialogue: 0,0:19:43.51,0:19:44.39,Default,,0,0,0,,Макабе-кун!
Dialogue: 0,0:19:45.68,0:19:46.51,Default,,0,0,0,,Ha
Dialogue: 0,0:19:51.60,0:19:53.98,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:19:54.36,0:19:57.48,Default,,0,0,0,,Жарайды, енді Цучиноко Макабеге тиесілі!
Dialogue: 0,0:19:57.65,0:19:58.48,Default,,0,0,0,,Бәрі жақсы ма?
Dialogue: 0,0:19:58.82,0:20:00.45,Default,,0,0,0,,Бұл Мочи Рон!
Dialogue: 0,0:20:00.61,0:20:02.66,Default,,0,0,0,,Барлығыңызға рахмет
Dialogue: 0,0:20:03.28,0:20:05.99,Default,,0,0,0,,Кешіріңіз (барлық мүшелер) Иә?
Dialogue: 0,0:20:06.62,0:20:08.45,Default,,0,0,0,,Мен оны сол күйінде полиция жәшігіне жеткіземін.
Dialogue: 0,0:20:08.54,0:20:10.00,Default,,0,0,0,,Макабе!
Dialogue: 0,0:20:10.16,0:20:14.25,Default,,0,0,0,,Бұл жігіт тек мені жақсы сезінгісі келеді деп ойлау маған ауыр жүк.
Dialogue: 0,0:20:14.42,0:20:16.09,Default,,0,0,0,,Онда мен аламын... (Обина) Күл!
Dialogue: 0,0:20:17.34,0:20:19.13,Default,,0,0,0,,Бұл Мақабе таңдаған жол.
Dialogue: 0,0:20:19.59,0:20:21.22,Default,,0,0,0,,Макабе өзіңізге ұнайтын нәрсені жасаңыз
Dialogue: 0,0:20:21.30,0:20:22.13,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:25.05,0:20:25.89,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:20:26.51,0:20:28.26,Default,,0,0,0,,Бұл соңғысы!
Dialogue: 0,0:20:28.77,0:20:31.98,Default,,0,0,0,,Қараңдар! Міне, мен бар күшімді салып, жеңілемін!
Dialogue: 0,0:20:32.14,0:20:34.35,Default,,0,0,0,,Жоқ, жоқ, біз соңында жеңеміз.
Dialogue: 0,0:20:34.56,0:20:35.81,Default,,0,0,0,,Оу!
Dialogue: 0,0:20:35.90,0:20:37.82,Default,,0,0,0,,Ахахаха (Нагумо) Фью
Dialogue: 0,0:20:37.90,0:20:40.11,Default,,0,0,0,,Жарайды, мен сендерден көп нәрсе күтпеймін.
Dialogue: 0,0:20:40.90,0:20:41.82,Default,,0,0,0,,Фу
Dialogue: 0,0:20:41.90,0:20:42.82,Default,,0,0,0,,Бұл кішкентай вакуумдық торнадоның соңғы әсері!
Dialogue: 0,0:20:42.99,0:20:43.95,Default,,0,0,0,,Сәлеметсіз бе...
Dialogue: 0,0:20:44.74,0:20:45.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:46.66,0:20:48.41,Default,,0,0,0,,Баба баа!
Dialogue: 0,0:20:48.70,0:20:50.50,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:20:51.12,0:20:52.33,Default,,0,0,0,,Нагумо
Dialogue: 0,0:20:54.17,0:20:57.79,Default,,0,0,0,,Менен жеңіліп, қонақжайлық танытқыңыз келеді, солай ма?
Dialogue: 0,0:20:58.59,0:21:00.00,Default,,0,0,0,,Неліктен бұл?
Dialogue: 0,0:21:00.09,0:21:01.30,Default,,0,0,0,,Бұл! а!
Dialogue: 0,0:21:01.59,0:21:02.72,Default,,0,0,0,,Басқалардың араласуы немесе олардың арасындағы шектеулер соншалықты қарапайым емес.
Dialogue: 0,0:21:03.30,0:21:04.59,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:21:05.43,0:21:06.80,Default,,0,0,0,,Маған тыңдауға рұқсат етіңіз.
Dialogue: 0,0:21:06.93,0:21:07.76,Default,,0,0,0,,Соққы
Dialogue: 0,0:21:07.85,0:21:09.76,Default,,0,0,0,,Қараңызшы, мен соны айтайын деп едім, солай ма?
Dialogue: 0,0:21:09.85,0:21:12.56,Default,,0,0,0,,Міне кеттік... Иә? Енді не болады? О?
Dialogue: 0,0:21:13.14,0:21:16.81,Default,,0,0,0,,Айтшы, тездетіп, соңына жет.
Dialogue: 0,0:21:17.19,0:21:19.23,Default,,0,0,0,,Иә? Не болды? Қараңдар, қараңдар
Dialogue: 0,0:21:19.32,0:21:21.78,Default,,0,0,0,,Өзіңіздің аянышты дауысыңызға көніңіз
Dialogue: 0,0:21:21.86,0:21:24.36,Default,,0,0,0,,Не болды? иә?
Dialogue: 0,0:21:24.45,0:21:28.20,Default,,0,0,0,,Ба ба баа... Тоқта, күт, сабырмен ойла.
Dialogue: 0,0:21:28.37,0:21:32.16,Default,,0,0,0,,Кемпірмен жарысып, жеңсең де, күйзелісің азаяды.
Dialogue: 0,0:21:32.25,0:21:37.38,Default,,0,0,0,,Олай болса, шыдап, берілуден басқа амалым қалмады, тегін тамақ пен тегін алкогольді аламын.
Dialogue: 0,0:21:37.46,0:21:39.00,Default,,0,0,0,,Бірақ бұл ашу-ыза.
Dialogue: 0,0:21:39.09,0:21:41.59,Default,,0,0,0,,Мен жеңгім келеді, бірақ мен де берілгім келеді.
Dialogue: 0,0:21:42.46,0:21:44.42,Default,,0,0,0,,Осы кезде маған бір ой келді (Нагумо) Ха!
Dialogue: 0,0:21:45.72,0:21:46.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:46.88,0:21:48.55,Default,,0,0,0,,Жеңісті қосу...
Dialogue: 0,0:21:49.14,0:21:51.22,Default,,0,0,0,,Ең жоғарғы ақ жалау
Dialogue: 0,0:21:51.56,0:21:52.93,Default,,0,0,0,,Міне келдік!
Dialogue: 0,0:21:53.18,0:21:53.85,Default,,0,0,0,,Ta!
Dialogue: 0,0:21:53.93,0:21:54.89,Default,,0,0,0,,Ta!
Dialogue: 0,0:21:55.18,0:21:57.19,Default,,0,0,0,,Эй, сәлем
Dialogue: 0,0:21:57.44,0:22:01.32,Default,,0,0,0,,А-а-а-а-а-а, сәлем, қонақжайлылық орнын өзгерту туралы, а.
Dialogue: 0,0:22:01.48,0:22:03.94,Default,,0,0,0,,Сіз мұны істеп жатырсыз ба? Бұл пайдалы болды
Dialogue: 0,0:22:04.74,0:22:08.32,Default,,0,0,0,,Нагумоны Хотаканың қарт адамы қалай ұстап алғанын қараңыз.
Dialogue: 0,0:22:09.20,0:22:14.08,Default,,0,0,0,,Күткендей, мұнда келсеңіз, достарыңызды ертіп, соғыс жариялайсыз.
Dialogue: 0,0:22:14.41,0:22:16.33,Default,,0,0,0,,Бұл өкінішті болды, Нагумо.
Dialogue: 0,0:22:16.46,0:22:19.79,Default,,0,0,0,,Жаңа ғана берілу ұғымы жойылды.
Dialogue: 0,0:22:20.00,0:22:21.63,Default,,0,0,0,,Джигокуға түсу
Dialogue: 0,0:22:21.71,0:22:22.55,Default,,0,0,0,,Кемпір!
Dialogue: 0,0:22:22.67,0:22:23.80,Default,,0,0,0,,Баба!
Dialogue: 0,0:22:24.30,0:22:25.30,Default,,0,0,0,,Ханым!
Dialogue: 0,0:22:25.55,0:22:26.55,Default,,0,0,0,,Ой~!
Dialogue: 0,0:22:26.76,0:22:27.88,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:22:28.22,0:22:30.05,Default,,0,0,0,,(Қол Перісі) Құтқарып болмайды… Соңғы көргенім – демон өлтірушінің жүзі болар деп кім ойлаған…
Dialogue: 0,0:22:30.76,0:22:34.06,Default,,0,0,0,,Өзіңізді жеңдім деп ойламаңыз! Есіңізде болсын, Чикушо!
Dialogue: 0,0:22:34.60,0:22:35.52,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:22:35.60,0:22:37.98,Default,,0,0,0,,Келіңіздер ме? (Жақсы адам) Қызық, бұл кім?
Dialogue: 0,0:22:38.19,0:22:40.06,Default,,0,0,0,,Ол Танабе отбасынан шыққан Дораның ұлы.
Dialogue: 0,0:22:40.73,0:22:42.61,Default,,0,0,0,,Баба, жақсысың ба?
Dialogue: 0,0:22:42.69,0:22:44.03,Default,,0,0,0,,Мен сондай сараңмын
Dialogue: 0,0:22:44.11,0:22:46.82,Default,,0,0,0,,Бұл толық жеңісті білдіре ме?
Dialogue: 0,0:22:46.94,0:22:50.57,Default,,0,0,0,,Жоқ, қонақжайлылық жоқ.
Dialogue: 0,0:22:52.78,0:22:53.62,Default,,0,0,0,,Уау!
Dialogue: 0,0:22:54.04,0:22:55.20,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:22:55.66,0:22:56.70,Default,,0,0,0,,Арба болды!
Dialogue: 0,0:22:56.79,0:22:58.08,Default,,0,0,0,,Арбаға мінбеңіз!
Dialogue: 0,0:22:58.25,0:23:00.67,Default,,0,0,0,,Оны маған әкелдің, сен сондай қамқорсың.
Dialogue: 0,0:23:00.75,0:23:01.75,Default,,0,0,0,,Жақсы ағадан күткендей!
Dialogue: 0,0:23:01.83,0:23:03.00,Default,,0,0,0,,Сіз ше, Цучиноко?
Dialogue: 0,0:23:03.09,0:23:04.55,Default,,0,0,0,,Ха! иә?
Dialogue: 0,0:23:04.63,0:23:05.51,Default,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,0:23:06.05,0:23:06.88,Default,,0,0,0,,Уау! (Обина) Аба!
Dialogue: 0,0:23:06.96,0:23:07.92,Default,,0,0,0,,Шынымен! (Мурон) О, жоқ!
Dialogue: 0,0:23:08.17,0:23:09.76,Default,,0,0,0,,Қолжазбаға не болды?
Dialogue: 0,0:23:10.01,0:23:10.97,Default,,0,0,0,,Керемет
Dialogue: 0,0:23:11.05,0:23:12.10,Default,,0,0,0,,«Алдау?» Оны алдау үшін не істемексің?
Dialogue: 0,0:23:12.18,0:23:13.35,Default,,0,0,0,,Жақсы
Dialogue: 0,0:23:13.43,0:23:14.97,Default,,0,0,0,,Шағала сол жаққа қарай бет алды.
Dialogue: 0,0:23:15.06,0:23:15.89,Default,,0,0,0,,Иә
Dialogue: 0,0:23:15.97,0:23:17.56,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:23:17.64,0:23:21.48,Default,,0,0,0,,Біз ҚАЛАдағы жақсы адамдарға беру үшін кесе дайындадық.
Dialogue: 0,0:23:21.69,0:23:23.15,Default,,0,0,0,,Рахмет сізге Ходака
Dialogue: 0,0:23:23.23,0:23:24.94,Default,,0,0,0,,Сіз мені жай ғана көңіл көтеруге тырысасыз ба?
Dialogue: 0,0:23:25.02,0:23:26.36,Default,,0,0,0,,Қант ұнтағы
Dialogue: 0,0:23:27.11,0:23:28.28,Default,,0,0,0,,Иә.
Dialogue: 0,0:23:28.36,0:23:29.20,Default,,0,0,0,,Уау!
Dialogue: 0,0:23:29.28,0:23:30.45,Default,,0,0,0,,Бұл бәрін жеу стратегиясы.
Dialogue: 0,0:23:30.53,0:23:31.66,Default,,0,0,0,,Басқалардың араласуы немесе олардың арасындағы шектеулер соншалықты қарапайым емес.
Dialogue: 0,0:23:31.74,0:23:33.20,Default,,0,0,0,,Бұл марапаттау орны болады.
Dialogue: 0,0:23:33.45,0:23:34.91,Default,,0,0,0,,Маған сусын беріңізші.
Dialogue: 0,0:23:35.20,0:23:36.04,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:23:36.12,0:23:36.95,Default,,0,0,0,,Зуко
Dialogue: 0,0:23:37.04,0:23:38.25,Default,,0,0,0,,, үзінді
Dialogue: 0,0:23:38.33,0:23:39.16,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:23:39.25,0:23:40.54,Default,,0,0,0,,Әке мен ата.
Dialogue: 0,0:23:40.62,0:23:42.42,Default,,0,0,0,,О (Цурубиши) Кешіріңіз.
Dialogue: 0,0:23:42.50,0:23:44.09,Default,,0,0,0,,Жақсы, кейіпкерлер!
Dialogue: 0,0:23:44.17,0:23:45.71,Default,,0,0,0,,Менің артымда сен болсаң, ақымақ!
Dialogue: 0,0:23:45.84,0:23:46.88,Default,,0,0,0,,Мен мұны жеуге бола ма?
Dialogue: 0,0:23:46.96,0:23:48.71,Default,,0,0,0,,Өтінемін (Аспаз C) Айо
Dialogue: 0,0:23:48.88,0:23:50.22,Default,,0,0,0,,Әй, Цучиноко?
Dialogue: 0,0:23:50.30,0:23:51.13,Default,,0,0,0,,Шуш!
Dialogue: 0,0:23:51.22,0:23:53.55,Default,,0,0,0,,Сәтті шығу - өткізу орны (Сагоро) Уау!
Dialogue: 0,0:23:53.64,0:23:54.89,Default,,0,0,0,,Бұл тегін ме? (Аспаз C) Иә.
Dialogue: 0,0:23:54.97,0:23:55.93,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:23:56.01,0:23:58.14,Default,,0,0,0,,Алкоголь керек пе?
Dialogue: 0,0:23:58.31,0:23:59.18,Default,,0,0,0,,Рақмет, директор.
Dialogue: 0,0:23:59.27,0:24:00.10,Default,,0,0,0,,Ах Шиада
Dialogue: 0,0:24:00.18,0:24:01.27,Default,,0,0,0,,Дәмді және дәмді
Dialogue: 0,0:24:01.35,0:24:02.69,Default,,0,0,0,,Кешіріңіз, мен өтемін.
Dialogue: 0,0:24:02.77,0:24:03.86,Default,,0,0,0,,Бұл да тегін ме?
Dialogue: 0,0:24:16.08,0:24:17.74,Default,,0,0,0,,Ах! Кешіріңіз
Dialogue: 0,0:24:17.83,0:24:18.91,Default,,0,0,0,,Нагумо-сан!
Dialogue: 0,0:24:19.00,0:24:20.79,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:24:21.12,0:24:24.21,Default,,0,0,0,,Ей, саған кел деп Нагумо-сан айтты.
Dialogue: 0,0:24:24.38,0:24:27.09,Default,,0,0,0,,Иә? Хмм
Dialogue: 0,0:24:27.25,0:24:30.84,Default,,0,0,0,,Ойланбай, тек тегін тамақ же.
Dialogue: 0,0:24:30.92,0:24:32.01,Default,,0,0,0,,Басқалардың араласуы немесе олардың арасындағы шектеулер соншалықты қарапайым емес.
Dialogue: 0,0:24:32.26,0:24:34.93,Default,,0,0,0,,Иә? Бұл не? Бұл не?
Dialogue: 0,0:24:35.34,0:24:37.39,Default,,0,0,0,,Оны мүлде кесіп тастамайды...
Dialogue: 0,0:24:37.76,0:24:38.76,Default,,0,0,0,,Міне, солай!
Dialogue: 0,0:24:38.85,0:24:40.35,Default,,0,0,0,,Бұл кулон болды ма?
Dialogue: 0,0:24:40.43,0:24:42.48,Default,,0,0,0,,А, жоқ.
Dialogue: 0,0:24:42.60,0:24:44.98,Default,,0,0,0,,Мен оны таппадым.
Dialogue: 0,0:24:45.52,0:24:47.90,Default,,0,0,0,,Сіз оған біраз ақша салған шығарсыз, солай ма?
Dialogue: 0,0:24:47.98,0:24:48.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:48.94,0:24:50.07,Default,,0,0,0,,Көңіл айтуыңызға рахмет
Dialogue: 0,0:24:50.86,0:24:54.74,Default,,0,0,0,,Егер солай болса, оны маған беруің керек еді.
Dialogue: 0,0:24:54.82,0:24:55.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:24:55.82,0:24:57.45,Default,,0,0,0,,Ал, көңілдеріңді көтеріңдер.
Dialogue: 0,0:24:57.91,0:25:00.45,Default,,0,0,0,,Қараңдар, жеп қойыңдар, бұл менің рахатым.
Dialogue: 0,0:25:00.54,0:25:02.66,Default,,0,0,0,,Ах, рақмет.
Dialogue: 0,0:25:03.16,0:25:04.46,Default,,0,0,0,,Ахахахахаха…
Dialogue: 0,0:25:04.46,0:25:07.13,Default,,0,0,0,,Ахахахахаха…
Dialogue: 0,0:25:04.46,0:25:07.13,Default,,0,0,0,,Бұлай шықпаңдар~
Dialogue: 0,0:25:39.41,0:25:42.41,Default,,0,0,0,,♪～
Dialogue: 0,0:27:48.00,0:27:51.37,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:27:51.62,0:27:55.63,Default,,0,0,0,,Хотака Мен ол адамды мақтаймын.
Dialogue: 0,0:27:56.00,0:27:57.76,Default,,0,0,0,,Иә, жас ханым.
Dialogue: 0,0:27:57.84,0:27:58.84,Default,,0,0,0,,～♪
Dialogue: 0,0:27:59.17,0:28:01.26,Default,,0,0,0,,Иә (Нагумо) Хи хи!
Dialogue: 0,0:28:01.34,0:28:03.01,Default,,0,0,0,,Ах Чивасу
Dialogue: 0,0:28:04.30,0:28:06.01,Default,,0,0,0,,Ол өте әдемі көрінді.
Dialogue: 0,0:28:06.10,0:28:07.39,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:28:07.77,0:28:08.60,Default,,0,0,0,,（･）
Dialogue: 0,0:28:08.68,0:28:09.52,Default,,0,0,0,,Ха!
Dialogue: 0,0:28:11.02,0:28:17.02,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory