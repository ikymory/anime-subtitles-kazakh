Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.46,0:00:02.58,Default,,0,0,0,,(теледидар қолдауы)
Dialogue: 0,0:00:02.71,0:00:05.46,Default,,0,0,0,,Мен кіремін! CITY Минами орта мектебі!
Dialogue: 0,0:00:05.63,0:00:06.46,Default,,0,0,0,,Күтпеген жерден жеңіс!
Dialogue: 0,0:00:06.46,0:00:07.92,Default,,0,0,0,,Күтпеген жерден келген жеңіс!
Dialogue: 0,0:00:06.46,0:00:07.92,Default,,0,0,0,,Мен жазғы демалысты қалаймын
Dialogue: 0,0:00:07.92,0:00:08.17,Default,,0,0,0,,Мен жазғы демалысты қалаймын
Dialogue: 0,0:00:09.84,0:00:11.30,Default,,0,0,0,,Дәлірек айтсақ--
Dialogue: 0,0:00:11.47,0:00:14.43,Default,,0,0,0,,Сол күндердің жазғы демалысын қалаймын...
Dialogue: 0,0:00:15.30,0:00:20.14,Default,,0,0,0,,Таудың ар жағындағы беймәлім дүние мен жарқыраған суару арнасы
Dialogue: 0,0:00:20.56,0:00:25.23,Default,,0,0,0,,Жазғы фестивальде юката киген әлгі қызға сыйлаған тәтті алғашқы махаббатым
Dialogue: 0,0:00:25.56,0:00:30.19,Default,,0,0,0,,Инелік қарындаш Мен ата-анамнан сол сәтті сақтап қалуды өтіндім
Dialogue: 0,0:00:30.57,0:00:36.07,Default,,0,0,0,,Дүние үлкен еді, тек бүгіні мен болашағы бар еді, ол кезде жазғы демалыста...
Dialogue: 0,0:00:37.07,0:00:38.41,Default,,0,0,0,,Бас редактор! (Цурубиши Макабе) Уууу...
Dialogue: 0,0:00:38.53,0:00:39.83,Default,,0,0,0,,Түсіндім~ (Бас редактор) Әй...
Dialogue: 0,0:00:43.54,0:00:47.92,Default,,0,0,0,,Біз ешқашан артқа орала алмаймыз ба? Ол кезде жазғы демалыста
Dialogue: 0,0:00:48.67,0:00:50.88,Default,,0,0,0,,Оны барлығымен талқылау үшін-
Dialogue: 0,0:00:50.96,0:00:54.01,Default,,0,0,0,,Бүгін менің шұғыл жиналысым болды.
Dialogue: 0,0:00:54.09,0:00:55.59,Default,,0,0,0,,Хе... хех хе (Бас редактор) Иә?
Dialogue: 0,0:00:55.89,0:00:56.01,Default,,0,0,0,,Fufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufu
Dialogue: 0,0:00:56.01,0:00:58.18,Default,,0,0,0,,Fufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufu
Dialogue: 0,0:00:56.01,0:00:58.18,Default,,0,0,0,,Цуру мырза? (Әке) Ой... не болды?
Dialogue: 0,0:01:00.06,0:01:02.35,Default,,0,0,0,,Сол күндерге қайта оралудың орнына...
Dialogue: 0,0:01:02.77,0:01:07.31,Default,,0,0,0,,Ол күндердің жазғы демалысынан асып түсу ғана емес пе?
Dialogue: 0,0:01:07.61,0:01:09.52,Default,,0,0,0,,Бұдан былай? (Цурубиши) Қазірден бастап!
Dialogue: 0,0:01:09.61,0:01:11.53,Default,,0,0,0,,Қазірден бастап!? (Бас редактор) Сіздің жұмысыңыз қандай?
Dialogue: 0,0:01:11.82,0:01:12.99,Default,,0,0,0,,Барлық жаз-
Dialogue: 0,0:01:13.07,0:01:14.74,Default,,0,0,0,,Демалыңыз! Жұмыс! (Әке) О!
Dialogue: 0,0:01:15.70,0:01:16.78,Default,,0,0,0,,Мен келдім!
Dialogue: 0,0:01:17.24,0:01:18.28,Default,,0,0,0,,Сәлем~
Dialogue: 0,0:01:18.57,0:01:20.37,Default,,0,0,0,,Әкелерің не істеп жатыр?
Dialogue: 0,0:01:20.66,0:01:22.20,Default,,0,0,0,,Мувахахаха!
Dialogue: 0,0:01:22.33,0:01:24.83,Default,,0,0,0,,Жазғы демалысыңызда біз...
Dialogue: 0,0:01:25.04,0:01:26.17,Default,,0,0,0,,Жоғалтпа!
Dialogue: 0,0:01:26.25,0:01:27.08,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:27.33,0:01:29.42,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:01:29.50,0:01:30.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:31.38,0:01:33.13,Default,,0,0,0,,♪～
Dialogue: 0,0:01:33.26,0:01:36.26,Default,,0,0,0,,Сәлеметсіздер ме, қымбатты достарым
Dialogue: 0,0:01:36.55,0:01:39.14,Default,,0,0,0,,Маған армандарың туралы айтып бер
Dialogue: 0,0:01:39.30,0:01:44.23,Default,,0,0,0,,Сол күндер есіңізде ме?
Dialogue: 0,0:01:45.60,0:01:51.52,Default,,0,0,0,,Ересек болу қиын, солай емес пе?
Dialogue: 0,0:01:51.65,0:01:58.28,Default,,0,0,0,,Жасырылған нәрсені табайық.
Dialogue: 0,0:01:59.66,0:02:00.66,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:02:09.38,0:02:15.34,Default,,0,0,0,,Өзіңіздің беймаза ойыңызды тастаңыз
Dialogue: 0,0:02:15.51,0:02:18.34,Default,,0,0,0,,Бұлттар жүзіп келеді
Dialogue: 0,0:02:18.47,0:02:22.39,Default,,0,0,0,,Жоғары қарап, секір!
Dialogue: 0,0:02:23.35,0:02:26.23,Default,,0,0,0,,Жаңбыр тоқтады
Dialogue: 0,0:02:26.43,0:02:29.40,Default,,0,0,0,,Ән айту
Dialogue: 0,0:02:29.60,0:02:32.98,Default,,0,0,0,,Қол ұстасу
Dialogue: 0,0:02:35.78,0:02:38.70,Default,,0,0,0,,Мен күлдім
Dialogue: 0,0:02:38.82,0:02:41.87,Default,,0,0,0,,Сен де күлесің
Dialogue: 0,0:02:41.99,0:02:45.24,Default,,0,0,0,,Әрине ұнайды
Dialogue: 0,0:02:45.37,0:02:51.21,Default,,0,0,0,,Тағы кездесейік
Dialogue: 0,0:02:57.76,0:03:00.13,Default,,0,0,0,,～♪
Dialogue: 0,0:03:02.60,0:03:05.51,Default,,0,0,0,,Бейне түсіріп, тез бай болыңыз!
Dialogue: 0,0:03:05.68,0:03:06.52,Default,,0,0,0,,Хмм
Dialogue: 0,0:03:07.39,0:03:08.93,Default,,0,0,0,,Енді Маккаби демалыста-
Dialogue: 0,0:03:09.02,0:03:12.81,Default,,0,0,0,,Сіздің жалғыз табысыңыз - Текаридаке Гекиданның күріш билеттері!
Dialogue: 0,0:03:12.90,0:03:14.32,Default,,0,0,0,,Менің мұны істеуден басқа амалым жоқ!
Dialogue: 0,0:03:14.40,0:03:15.23,Default,,0,0,0,,Хмм
Dialogue: 0,0:03:15.36,0:03:17.90,Default,,0,0,0,,Осындай ақша табудың арман сияқты жолы бар ма?
Dialogue: 0,0:03:17.99,0:03:20.11,Default,,0,0,0,,Нагумо-санда мұндай қасиет бар!
Dialogue: 0,0:03:20.32,0:03:21.16,Default,,0,0,0,,Хмм
Dialogue: 0,0:03:21.24,0:03:22.36,Default,,0,0,0,,Мм!
Dialogue: 0,0:03:23.49,0:03:25.91,Default,,0,0,0,,Бұл бұрын жарияланған 1-том сценарий!
Dialogue: 0,0:03:25.99,0:03:27.24,Default,,0,0,0,,Сынақ түсірілімін жасайық!
Dialogue: 0,0:03:27.37,0:03:28.00,Default,,0,0,0,,Хмм
Dialogue: 0,0:03:28.25,0:03:29.20,Default,,0,0,0,,Хмм~!?
Dialogue: 0,0:03:29.54,0:03:30.37,Default,,0,0,0,,Хмм?
Dialogue: 0,0:03:30.79,0:03:31.79,Default,,0,0,0,,Хмм?
Dialogue: 0,0:03:32.08,0:03:34.84,Default,,0,0,0,,Ммммммммммм...
Dialogue: 0,0:03:35.00,0:03:37.21,Default,,0,0,0,,Нунунунун…
Dialogue: 0,0:03:37.30,0:03:38.59,Default,,0,0,0,,Нунунуну!
Dialogue: 0,0:03:38.88,0:03:41.43,Default,,0,0,0,,Уау! Қараңдар, мен жеңдім!
Dialogue: 0,0:03:41.51,0:03:44.35,Default,,0,0,0,,Неліктен сіз бәс тікпегенде ғана ұзақ соққы жасайсыз?
Dialogue: 0,0:03:44.85,0:03:45.68,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:03:45.76,0:03:46.85,Default,,0,0,0,,Не?
Dialogue: 0,0:03:47.22,0:03:49.10,Default,,0,0,0,,Бейне түсіру арқылы тез бай болыңыз
Dialogue: 0,0:03:49.64,0:03:51.94,Default,,0,0,0,,Жарайды! Мен мұны қазір істеуім керек!
Dialogue: 0,0:03:57.44,0:03:59.28,Default,,0,0,0,,Сәлем, бұл Нагумо.
Dialogue: 0,0:03:59.40,0:04:00.53,Default,,0,0,0,,Көңіл көтер!
Dialogue: 0,0:04:01.20,0:04:04.24,Default,,0,0,0,,Бүгін мен оң және сол қолыммен тас, қағаз, қайшы ойнадым...
Dialogue: 0,0:04:04.32,0:04:07.45,Default,,0,0,0,,Қайсысы күшті екенін көрейік!
Dialogue: 0,0:04:07.53,0:04:09.45,Default,,0,0,0,,Тас, қағаз, қайшы!
Dialogue: 0,0:04:09.79,0:04:10.75,Default,,0,0,0,,Вача!
Dialogue: 0,0:04:10.83,0:04:13.71,Default,,0,0,0,,Оң жағы жеңілді, сол жағы жеңді!
Dialogue: 0,0:04:13.79,0:04:16.04,Default,,0,0,0,,Тороку арнасы! Өтінемін!
Dialogue: 0,0:04:17.09,0:04:18.30,Default,,0,0,0,,Никурайо...
Dialogue: 0,0:04:18.55,0:04:20.59,Default,,0,0,0,,Хаха... Никура-сан...
Dialogue: 0,0:04:21.22,0:04:24.72,Default,,0,0,0,,Сіз бұл бейне арқылы шынымен ақша таба аласыз ба?
Dialogue: 0,0:04:25.09,0:04:27.35,Default,,0,0,0,,Шынайы жауап беріңіз.
Dialogue: 0,0:04:27.64,0:04:30.52,Default,,0,0,0,,Мм, мұндай масқара видеолармен ақша таба алмайсың.
Dialogue: 0,0:04:30.77,0:04:33.48,Default,,0,0,0,,Сен пневматикалық көзілдірік жігіт! Сен мені алдадың!
Dialogue: 0,0:04:33.69,0:04:36.65,Default,,0,0,0,,Нагумо-сан! Ашу 6 секундта шарықтайды!
Dialogue: 0,0:04:36.90,0:04:38.23,Default,,0,0,0,,Ашуыңды бассаң!
Dialogue: 0,0:04:38.36,0:04:41.11,Default,,0,0,0,,Ха! Жылдық табысыңызды екі есе!
Dialogue: 0,0:04:41.44,0:04:44.36,Default,,0,0,0,,Бұл ашуды басқару!
Dialogue: 0,0:04:44.82,0:04:46.53,Default,,0,0,0,,Ух... ха... ха... (Никкура) ха... ха...
Dialogue: 0,0:04:46.78,0:04:49.16,Default,,0,0,0,,Бұл не? Жеңіске жетудің сенімді жолы...
Dialogue: 0,0:04:49.24,0:04:51.66,Default,,0,0,0,,А, бар... Мен жасаймын...
Dialogue: 0,0:04:51.83,0:04:53.50,Default,,0,0,0,,Бұрын көрмеген-
Dialogue: 0,0:04:54.04,0:04:55.87,Default,,0,0,0,,Жаңа кейіпкер!
Dialogue: 0,0:04:56.17,0:04:57.84,Default,,0,0,0,,Және оны ұстаңыз! Клиенттер және үлкен ақша!
Dialogue: 0,0:04:57.84,0:04:59.63,Default,,0,0,0,,Және оны ұстаңыз! Клиенттер және үлкен ақша!
Dialogue: 0,0:04:57.84,0:04:59.63,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:00.34,0:05:01.59,Default,,0,0,0,,Біз не істеуіміз керек!?
Dialogue: 0,0:05:01.67,0:05:03.88,Default,,0,0,0,,Иә! Бухгалтерлік магистратқа қалдырыңыз!
Dialogue: 0,0:05:04.47,0:05:06.34,Default,,0,0,0,,Сәлем, бұл Нагумо.
Dialogue: 0,0:05:06.89,0:05:10.35,Default,,0,0,0,,Мұны «Коняньячи - Нагумон!» деп өзгертіңіз.
Dialogue: 0,0:05:10.76,0:05:11.77,Default,,0,0,0,,Жұмсақ!
Dialogue: 0,0:05:12.27,0:05:14.27,Default,,0,0,0,,Ал мынаны киіңіз.
Dialogue: 0,0:05:15.14,0:05:17.94,Default,,0,0,0,,А... иә... иә...
Dialogue: 0,0:05:18.19,0:05:20.94,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:21.32,0:05:22.61,Default,,0,0,0,,Дегенмен, бұл қалыпты жағдай.
Dialogue: 0,0:05:22.74,0:05:23.57,Default,,0,0,0,,Фува!?
Dialogue: 0,0:05:23.65,0:05:26.32,Default,,0,0,0,,Сөз соңына «гонсу» сөзін қосып, бос орын қалдыр.
Dialogue: 0,0:05:26.61,0:05:27.45,Default,,0,0,0,,Гонс!?
Dialogue: 0,0:05:27.74,0:05:29.91,Default,,0,0,0,,Жоқ, оны «Гонсу Гонсу» деп атайық
Dialogue: 0,0:05:29.99,0:05:30.87,Default,,0,0,0,,Гонсу Гонсу!?
Dialogue: 0,0:05:31.45,0:05:33.37,Default,,0,0,0,,Бұл күрт өзгереді!
Dialogue: 0,0:05:33.87,0:05:36.71,Default,,0,0,0,,Үлкен ұтыс алу мүмкіндігін жіберіп алмаңыз!
Dialogue: 0,0:05:37.21,0:05:38.42,Default,,0,0,0,,Иә нұсқау!
Dialogue: 0,0:05:38.67,0:05:41.55,Default,,0,0,0,,Коньяньячи... Нагумодағы Гонсу Гонсу...
Dialogue: 0,0:05:41.63,0:05:43.67,Default,,0,0,0,,Толығырақ! Көбірек шашыңыз!
Dialogue: 0,0:05:43.92,0:05:47.30,Default,,0,0,0,,Бүгін! Оң және сол қолдарыңызбен тас-қағаз-қайшы ойнаңыз...
Dialogue: 0,0:05:47.38,0:05:48.93,Default,,0,0,0,,Көбірек Гонсу түсі күштірек!
Dialogue: 0,0:05:50.30,0:05:55.31,Default,,0,0,0,,Бүгін біз Гонсу Гонсуды оң жақтағы Гонсумен және сол жақтағы Гонсумен жасаймыз!
Dialogue: 0,0:05:55.81,0:05:57.39,Default,,0,0,0,,Жақсы! Мен жүктеп салдым
Dialogue: 0,0:05:57.73,0:06:00.94,Default,,0,0,0,,Енді көрерменнің сізді қызықтыруын күту ғана қалды.
Dialogue: 0,0:06:01.23,0:06:02.11,Default,,0,0,0,,Никура…
Dialogue: 0,0:06:02.44,0:06:03.48,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:06:04.23,0:06:06.15,Default,,0,0,0,,Бұл өте ұят.
Dialogue: 0,0:06:07.15,0:06:10.78,Default,,0,0,0,,Соны жеңгеннен кейін бұл көп ақша, Нагумон.
Dialogue: 0,0:06:11.12,0:06:12.37,Default,,0,0,0,,Гонс Гонс…
Dialogue: 0,0:06:15.58,0:06:18.87,Default,,0,0,0,,Хмм... Менің ойымша, бұл Гонсу емес пе?
Dialogue: 0,0:06:19.54,0:06:22.67,Default,,0,0,0,,Күлкілі жылдам адам бар ма?
Dialogue: 0,0:06:23.13,0:06:27.30,Default,,0,0,0,,Велосипедімнің дөңгелегі жарылып қалды, соба кеспесін жеткізе алмадым!
Dialogue: 0,0:06:27.63,0:06:29.01,Default,,0,0,0,,Біреу өте зерікті
Dialogue: 0,0:06:29.30,0:06:31.43,Default,,0,0,0,,Толық емес жұмыс ақысына жұмыс істей алатындар
Dialogue: 0,0:06:31.80,0:06:33.35,Default,,0,0,0,,Сіз осындасыз ба?
Dialogue: 0,0:06:33.68,0:06:34.77,Default,,0,0,0,,Міне болды! (Нагумо) Ой!
Dialogue: 0,0:06:35.27,0:06:36.77,Default,,0,0,0,,Кеттік! (Нагумо) Никура!?
Dialogue: 0,0:06:37.06,0:06:39.44,Default,,0,0,0,,Иә! иә! Иә, орындалды!
Dialogue: 0,0:06:39.77,0:06:41.61,Default,,0,0,0,,Иә! Соба және мекенжай!
Dialogue: 0,0:06:41.69,0:06:43.23,Default,,0,0,0,,Уау! О... ой...
Dialogue: 0,0:06:43.36,0:06:46.86,Default,,0,0,0,,Кеттік! Бұл видео міндетті түрде вирусқа айналады!
Dialogue: 0,0:06:47.28,0:06:49.74,Default,,0,0,0,,Бейнеңіз интернетте таралса, сіз көп ақша табасыз!
Dialogue: 0,0:06:50.16,0:06:50.99,Default,,0,0,0,,Егер ол жылдамдықты арттырса, тіпті модель ұшақ болса да—
Dialogue: 0,0:06:51.32,0:06:53.49,Default,,0,0,0,,Бұл долларлық қораптың нақты қызба уақыты!
Dialogue: 0,0:06:53.58,0:06:55.70,Default,,0,0,0,,Уау! Мен мотивация сезінемін!
Dialogue: 0,0:06:56.16,0:06:59.41,Default,,0,0,0,,Ум, Темпура Собадан темпураны жеуге болады!
Dialogue: 0,0:06:59.50,0:07:01.21,Default,,0,0,0,,Не! Ах!
Dialogue: 0,0:07:01.92,0:07:03.09,Default,,0,0,0,,Күте тұрыңыз, Корра!
Dialogue: 0,0:07:04.00,0:07:05.25,Default,,0,0,0,,Не істеймін… не істеймін!
Dialogue: 0,0:07:05.92,0:07:07.09,Default,,0,0,0,,Темпура қайтадан жасалуда...
Dialogue: 0,0:07:08.59,0:07:09.76,Default,,0,0,0,,Онисоку...
Dialogue: 0,0:07:10.84,0:07:12.89,Default,,0,0,0,,Нуу~! Наро!
Dialogue: 0,0:07:13.55,0:07:16.10,Default,,0,0,0,,Мына қарғыс атқан мысық қайда кетті?
Dialogue: 0,0:07:16.39,0:07:18.56,Default,,0,0,0,,Не... Нагумо-сан, мынау...
Dialogue: 0,0:07:18.68,0:07:19.52,Default,,0,0,0,,Онда болды ма!?
Dialogue: 0,0:07:20.06,0:07:21.02,Default,,0,0,0,,Рахмет ақша…
Dialogue: 0,0:07:21.48,0:07:22.56,Default,,0,0,0,,50 000 иен!?
Dialogue: 0,0:07:22.86,0:07:24.15,Default,,0,0,0,,Ууууууу!
Dialogue: 0,0:07:24.27,0:07:26.23,Default,,0,0,0,,Бұл тіпті соба туралы емес!
Dialogue: 0,0:07:26.44,0:07:28.57,Default,,0,0,0,,Нагумо-сан! Соба кеспесін жеткізіңіз!
Dialogue: 0,0:07:28.78,0:07:29.61,Default,,0,0,0,,Басынан бастап осы тапаншамен атып тастауым керек еді! ➡
Dialogue: 0,0:07:29.95,0:07:32.36,Default,,0,0,0,,Сен ақымақсың ба? Бұл собадан гөрі мысық!
Dialogue: 0,0:07:32.45,0:07:33.74,Default,,0,0,0,,Үш қоянды қуу!
Dialogue: 0,0:07:34.07,0:07:35.70,Default,,0,0,0,,Ойлан!
Dialogue: 0,0:07:35.78,0:07:38.87,Default,,0,0,0,,Мысықты алсаңыз, темпура алуға да болады.
Dialogue: 0,0:07:39.08,0:07:41.75,Default,,0,0,0,,Мысықтар мен соба кеспесін жеткізуге келгенде, бейне де жарқырайды!
Dialogue: 0,0:07:42.42,0:07:44.63,Default,,0,0,0,,Басқаша айтқанда, сіз бәрін ала аласыз!
Dialogue: 0,0:07:44.96,0:07:46.00,Default,,0,0,0,,Дааааааааааааа!
Dialogue: 0,0:07:46.46,0:07:48.76,Default,,0,0,0,,Жүр, сен маған жұдырықтай алмайсың!
Dialogue: 0,0:07:48.84,0:07:50.88,Default,,0,0,0,,Темпура Оның бәрін жеуге болады!
Dialogue: 0,0:07:51.47,0:07:52.68,Default,,0,0,0,,Хмм... Ммм...
Dialogue: 0,0:07:52.80,0:07:55.80,Default,,0,0,0,,Әй... Эй Никура... Бұл...
Dialogue: 0,0:07:56.51,0:07:59.02,Default,,0,0,0,,Нагумо-сан... Бұл сөзсіз.
Dialogue: 0,0:07:59.64,0:08:00.85,Default,,0,0,0,,Ұры
Dialogue: 0,0:08:01.81,0:08:02.64,Default,,0,0,0,,Хмм…
Dialogue: 0,0:08:02.73,0:08:04.56,Default,,0,0,0,,Осының бәрін ала алсам...
Dialogue: 0,0:08:04.65,0:08:07.73,Default,,0,0,0,,Статус, абырой, ақша, бәрін аласың, солай ма?
Dialogue: 0,0:08:07.94,0:08:11.65,Default,,0,0,0,,Нақты айта алмаймын, бірақ мынаны айтайын.
Dialogue: 0,0:08:12.91,0:08:16.24,Default,,0,0,0,,Біздің заманымыздың есігі ашылады!
Dialogue: 0,0:08:16.91,0:08:18.41,Default,,0,0,0,,Егер өзіңді жақсы ұстасаң, мен саған зиян тигізбеймін.
Dialogue: 0,0:08:18.54,0:08:19.91,Default,,0,0,0,,Міне кеттік! Жаңа дәуірге қарай!
Dialogue: 0,0:08:20.41,0:08:21.25,Default,,0,0,0,,Сәлем! (Цукан) Уау!
Dialogue: 0,0:08:21.75,0:08:23.29,Default,,0,0,0,,Не болды, мэр?
Dialogue: 0,0:08:23.71,0:08:24.58,Default,,0,0,0,,Әкім!?
Dialogue: 0,0:08:24.79,0:08:26.29,Default,,0,0,0,,Бұл әкім ме?
Dialogue: 0,0:08:26.71,0:08:27.59,Default,,0,0,0,,Ах! Жоғалған мысық!
Dialogue: 0,0:08:28.09,0:08:29.09,Default,,0,0,0,,Уф! Не!
Dialogue: 0,0:08:29.42,0:08:30.84,Default,,0,0,0,,Гяаааааааааааааа!
Dialogue: 0,0:08:31.34,0:08:32.17,Default,,0,0,0,,Гррр…
Dialogue: 0,0:08:34.43,0:08:36.01,Default,,0,0,0,,Хмм…
Dialogue: 0,0:08:39.60,0:08:40.52,Default,,0,0,0,,Жеткізу
Dialogue: 0,0:08:45.60,0:08:48.23,Default,,0,0,0,,Ха ха… ха ха ха… ха ха… ха ха ха…
Dialogue: 0,0:08:48.32,0:08:49.90,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:08:50.19,0:08:52.74,Default,,0,0,0,,Хахахаха... хахаха...
Dialogue: 0,0:08:53.45,0:08:57.28,Default,,0,0,0,,А... а... а... а!
Dialogue: 0,0:09:01.16,0:09:04.54,Default,,0,0,0,,Бүгін келгендеріңізге көп рахмет.
Dialogue: 0,0:09:04.83,0:09:05.42,Default,,0,0,0,,Олай болса... (В аудиториясы) Эй!
Dialogue: 0,0:09:05.42,0:09:05.92,Default,,0,0,0,,Олай болса... (В аудиториясы) Эй!
Dialogue: 0,0:09:05.42,0:09:05.92,Default,,0,0,0,,Олай болса, Текаридаке Гекидан
Dialogue: 0,0:09:05.92,0:09:06.00,Default,,0,0,0,,Олай болса, Текаридаке Гекидан
Dialogue: 0,0:09:06.00,0:09:07.08,Default,,0,0,0,,Олай болса, Текаридаке Гекидан
Dialogue: 0,0:09:06.00,0:09:07.08,Default,,0,0,0,,Мен күттім!
Dialogue: 0,0:09:07.08,0:09:07.33,Default,,0,0,0,,Олай болса, Текаридаке Гекидан
Dialogue: 0,0:09:07.42,0:09:09.50,Default,,0,0,0,,«Құрмет» арнайы қойылымы
Dialogue: 0,0:09:09.88,0:09:11.88,Default,,0,0,0,,Қойылым басталады.
Dialogue: 0,0:09:12.17,0:09:17.05,Default,,0,0,0,,(Сырлы сигналды бастау)
Dialogue: 0,0:09:24.10,0:09:26.23,Default,,0,0,0,,Уақыт қашан болатынын білмеймін
Dialogue: 0,0:09:26.52,0:09:28.81,Default,,0,0,0,,Күндіз бе, түн бе, ауа райы ма, білмеймін.
Dialogue: 0,0:09:28.98,0:09:31.23,Default,,0,0,0,,Бір ғана
Dialogue: 0,0:09:31.48,0:09:33.74,Default,,0,0,0,,Мен жіліншікті жіліншікке қойдым~
Dialogue: 0,0:09:33.82,0:09:36.74,Default,,0,0,0,,Ине меңі болды~
Dialogue: 0,0:09:37.32,0:09:39.12,Default,,0,0,0,,Тек осы иненің меңі
Dialogue: 0,0:09:39.53,0:09:42.74,Default,,0,0,0,,Маған қызық, бәрі не туралы?
Dialogue: 0,0:09:42.83,0:09:43.79,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:09:43.87,0:09:46.29,Default,,0,0,0,,1, 2, 3 және 4-ші
Dialogue: 0,0:09:46.37,0:09:48.54,Default,,0,0,0,,Жіліншіктері бар ине меңі
Dialogue: 0,0:09:48.83,0:09:51.25,Default,,0,0,0,,Аптаның ауыспалы күндерінде өсек тарады
Dialogue: 0,0:09:51.38,0:09:53.63,Default,,0,0,0,,Мұғалім, оқушы, жалпы жұртшылық
Dialogue: 0,0:09:53.71,0:09:56.30,Default,,0,0,0,,Сіз білмей тұрып, қызыл белгі тез көтеріледі.
Dialogue: 0,0:09:56.51,0:09:58.80,Default,,0,0,0,,Бұл туралы білмейтін адамдар қалмады.
Dialogue: 0,0:09:58.89,0:10:01.26,Default,,0,0,0,,Мольдің танымалдығы аспандап барады!
Dialogue: 0,0:10:01.56,0:10:03.93,Default,,0,0,0,,Жұлдыздыққа жүгір!
Dialogue: 0,0:10:04.27,0:10:06.35,Default,,0,0,0,,Мені жібермейтіндер бар
Dialogue: 0,0:10:06.44,0:10:08.69,Default,,0,0,0,,Ол Кусаре қаласының холлының қызметкері!
Dialogue: 0,0:10:09.06,0:10:11.48,Default,,0,0,0,,Яре қаласын жандандыру жүргізілді
Dialogue: 0,0:10:11.57,0:10:13.69,Default,,0,0,0,,Жай ғана шаншып тұрған ине меңі!
Dialogue: 0,0:10:14.03,0:10:16.07,Default,,0,0,0,,Манжу орамал және кілттер!
Dialogue: 0,0:10:16.45,0:10:18.82,Default,,0,0,0,,Вокзалдағы үлкен ескерткіш!
Dialogue: 0,0:10:19.03,0:10:21.16,Default,,0,0,0,,Материктегі барлық жастағы ерлер мен әйелдер
Dialogue: 0,0:10:21.24,0:10:23.33,Default,,0,0,0,,Тенка Гомен кернеуі
Dialogue: 0,0:10:23.62,0:10:26.00,Default,,0,0,0,,Станция атауы Қала атауы Әуежай
Dialogue: 0,0:10:26.08,0:10:28.29,Default,,0,0,0,,Журналдар, ракон иттер және кір жуғыш машиналар
Dialogue: 0,0:10:28.54,0:10:30.75,Default,,0,0,0,,Барлық атауларды қайта бояңыз!
Dialogue: 0,0:10:30.83,0:10:32.67,Default,,0,0,0,,Бұл жылтыр иненің меңі
Dialogue: 0,0:10:33.00,0:10:35.92,Default,,0,0,0,,А, боя!
Dialogue: 0,0:10:36.05,0:10:38.38,Default,,0,0,0,,Үлкен байлық төмендейді
Dialogue: 0,0:10:38.47,0:10:40.84,Default,,0,0,0,,Менің сүйегімдегі ауырсыну аздап азайды деп ойлаймын.
Dialogue: 0,0:10:40.93,0:10:43.47,Default,,0,0,0,,Үйіңізге жасырын көз салсаңыз
Dialogue: 0,0:10:43.60,0:10:45.56,Default,,0,0,0,,Сол күн, сол уақыт, сол жер
Dialogue: 0,0:10:45.85,0:10:47.98,Default,,0,0,0,,Сағалы иненің меңі!
Dialogue: 0,0:10:48.39,0:10:50.56,Default,,0,0,0,,Әй, неге Тұзақтың ине меңі!
Dialogue: 0,0:10:50.65,0:10:52.90,Default,,0,0,0,,Ақшаң болса, бірақ бақытсыз болсаң
Dialogue: 0,0:10:52.98,0:10:55.19,Default,,0,0,0,,Мен бұл туралы ештеңе істей алмаймын!
Dialogue: 0,0:10:55.32,0:10:57.82,Default,,0,0,0,,Сол кезде детектив орнынан тұрды!
Dialogue: 0,0:10:57.90,0:11:00.28,Default,,0,0,0,,Аяқ алынды, аяқ қосылды, жақындады
Dialogue: 0,0:11:00.36,0:11:02.87,Default,,0,0,0,,Инелі меңге жақындау!
Dialogue: 0,0:11:03.16,0:11:05.08,Default,,0,0,0,,О, құдай!
Dialogue: 0,0:11:05.37,0:11:07.62,Default,,0,0,0,,Бұл детектив те қиыншылықта!
Dialogue: 0,0:11:07.83,0:11:10.08,Default,,0,0,0,,Жұмыс істемейтін жылан детектив!
Dialogue: 0,0:11:10.17,0:11:12.75,Default,,0,0,0,,Детектив Сун неге пайда болды?
Dialogue: 0,0:11:12.88,0:11:15.00,Default,,0,0,0,,Бұл бет ше?
Dialogue: 0,0:11:15.17,0:11:17.59,Default,,0,0,0,,Өкінбей екінші!
Dialogue: 0,0:11:17.67,0:11:20.18,Default,,0,0,0,,Ол лошаны көздеп тұрған сияқты!
Dialogue: 0,0:11:20.30,0:11:22.64,Default,,0,0,0,,Екі адам иық тіресіп тұрады
Dialogue: 0,0:11:22.72,0:11:25.06,Default,,0,0,0,,Бір-біріне қатысты қозғалмайтын шатырдың астында
Dialogue: 0,0:11:25.14,0:11:27.39,Default,,0,0,0,,Тончинканде Миочикирин
Dialogue: 0,0:11:27.47,0:11:30.06,Default,,0,0,0,,Бұл жағдай біртүрлі!
Dialogue: 0,0:11:30.19,0:11:34.56,Default,,0,0,0,,Мұнда бірінші болып көшкен – мына ине меңі!
Dialogue: 0,0:11:35.11,0:11:37.40,Default,,0,0,0,,Бұл Ойраның қамал мұнарасы
Dialogue: 0,0:11:37.53,0:11:40.11,Default,,0,0,0,,Өз жағыңды белгіле және маған сол жаққа баруымды айт.
Dialogue: 0,0:11:40.20,0:11:42.41,Default,,0,0,0,,Бұл ине шаншу!
Dialogue: 0,0:11:44.03,0:11:44.87,Default,,0,0,0,,Шу
Dialogue: 0,0:11:44.99,0:11:47.37,Default,,0,0,0,,Белгілі бір себептермен шұңқыры шығып тұрған инелі мең!
Dialogue: 0,0:11:47.45,0:11:49.83,Default,,0,0,0,,Барлығы қалаған ұлы финал!
Dialogue: 0,0:11:49.91,0:11:52.50,Default,,0,0,0,,Кенеттен бақытты аяқталу!
Dialogue: 0,0:11:52.62,0:11:54.00,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:11:54.33,0:11:56.88,Default,,0,0,0,,Бұл детектив қызық емес!
Dialogue: 0,0:11:57.05,0:11:59.38,Default,,0,0,0,,Ол ұшқанда ғана түшкірдім!
Dialogue: 0,0:11:59.46,0:12:01.97,Default,,0,0,0,,Ұлттық деңгейдегі орасан байлық!
Dialogue: 0,0:12:02.26,0:12:03.43,Default,,0,0,0,,Катая!
Dialogue: 0,0:12:04.14,0:12:06.35,Default,,0,0,0,,Ештеңені білмейтін аңғал ненне
Dialogue: 0,0:12:06.43,0:12:08.47,Default,,0,0,0,,Мен жай ғана мейірбан жүрекпен жіліншігімді тырнап алдым.
Dialogue: 0,0:12:08.97,0:12:11.39,Default,,0,0,0,,Мен жіліншігімді тырнап алсам, жәннат болар еді.
Dialogue: 0,0:12:11.48,0:12:13.27,Default,,0,0,0,,Бұған қызғаныш қосылды!
Dialogue: 0,0:12:14.02,0:12:16.23,Default,,0,0,0,,Беліңіздегі самурай қылыш
Dialogue: 0,0:12:16.31,0:12:18.28,Default,,0,0,0,,Қатты күш Дотануки!
Dialogue: 0,0:12:18.90,0:12:21.19,Default,,0,0,0,,Қызғаныш және Дотануки
Dialogue: 0,0:12:21.28,0:12:23.49,Default,,0,0,0,,Егер сіз екеуін біріктірсеңіз, сізде бір ғана нәрсе бар!
Dialogue: 0,0:12:23.57,0:12:25.74,Default,,0,0,0,,Сызықты шұңқырдан алшақ ұстаңыз.
Dialogue: 0,0:12:25.87,0:12:27.58,Default,,0,0,0,,Ақша меңіне айнал!
Dialogue: 0,0:12:28.33,0:12:30.25,Default,,0,0,0,,А, мен сені кесіп тастаймын!
Dialogue: 0,0:12:30.95,0:12:33.17,Default,,0,0,0,,Сен осылай қиылып кетесің бе?
Dialogue: 0,0:12:33.33,0:12:36.63,Default,,0,0,0,,Сен бізге тағы бір ғажайып көрсетпексің бе?
Dialogue: 0,0:12:36.75,0:12:39.21,Default,,0,0,0,,Әй, уақыт келді!
Dialogue: 0,0:12:39.50,0:12:42.88,Default,,0,0,0,,Текаридаке Гекидан «Құрмет» арнайы қойылымы!
Dialogue: 0,0:12:42.97,0:12:44.34,Default,,0,0,0,,1-бөлім «Сне»!
Dialogue: 0,0:12:44.63,0:12:48.43,Default,,0,0,0,,Әзірше шымылдықты тартайын!
Dialogue: 0,0:12:48.60,0:12:50.35,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:53.39,0:12:56.19,Default,,0,0,0,,2-бөлімде 10 минуттық үзіліс болады.
Dialogue: 0,0:12:56.27,0:12:58.90,Default,,0,0,0,,«Өзін-өзі құрметтеу» ақырында пайда болады.
Dialogue: 0,0:12:59.44,0:13:01.57,Default,,0,0,0,,Біраз күтіңіз.
Dialogue: 0,0:13:01.86,0:13:03.86,Default,,0,0,0,,«Өзін-өзі сыйлау» Сіздің атыңыз кім?
Dialogue: 0,0:13:10.12,0:13:13.96,Default,,0,0,0,,Рунларанлалаан Рунларанлалаан
Dialogue: 0,0:13:14.16,0:13:16.50,Default,,0,0,0,,Ранраранраранраран
Dialogue: 0,0:13:16.58,0:13:19.00,Default,,0,0,0,,Laran laran lalaan laran la…
Dialogue: 0,0:13:19.59,0:13:20.50,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:20.59,0:13:21.67,Default,,0,0,0,,Не!? ДДСҰ!?
Dialogue: 0,0:13:22.13,0:13:24.26,Default,,0,0,0,,Кейде тірі халық қазынасы...
Dialogue: 0,0:13:24.51,0:13:27.43,Default,,0,0,0,,Бірде мен 8-дан шогиге таң қалдым...
Dialogue: 0,0:13:27.72,0:13:31.31,Default,,0,0,0,,Рико Изуми ФК мүшесі №2 (Екінші нөмір)
Dialogue: 0,0:13:32.10,0:13:34.56,Default,,0,0,0,,Арашима Соун! Міне келдік!
Dialogue: 0,0:13:39.61,0:13:42.23,Default,,0,0,0,,Ошо Арашима!? Сен не істеп жатырсың!?
Dialogue: 0,0:13:42.32,0:13:43.99,Default,,0,0,0,,Эй, өтінемін, түс!
Dialogue: 0,0:13:44.07,0:13:44.90,Default,,0,0,0,,Кему
Dialogue: 0,0:13:45.20,0:13:46.53,Default,,0,0,0,,Түсіңіз! (Арашима) Жаңбыр
Dialogue: 0,0:13:46.61,0:13:48.53,Default,,0,0,0,,Түсіңіз! (Арашима) Жаңбыр жауып тұр
Dialogue: 0,0:13:48.95,0:13:50.66,Default,,0,0,0,,Гунунуну... Нунунуну...
Dialogue: 0,0:13:50.74,0:13:51.83,Default,,0,0,0,,Куну... Ах!
Dialogue: 0,0:13:52.33,0:13:54.87,Default,,0,0,0,,Құрметті мырза! Өтінемін маған көмектесіңіз!
Dialogue: 0,0:13:55.41,0:13:58.21,Default,,0,0,0,,Кенеттен бір монах келді...
Dialogue: 0,0:13:58.33,0:13:59.96,Default,,0,0,0,,Мынаны алып кетіңізші!
Dialogue: 0,0:14:00.34,0:14:01.42,Default,,0,0,0,,Не...?
Dialogue: 0,0:14:01.63,0:14:03.63,Default,,0,0,0,,Иә? Мырза мырза?
Dialogue: 0,0:14:04.13,0:14:07.30,Default,,0,0,0,,Рико Изуми ФК мүшесі №3 (Үшінші нөмір)
Dialogue: 0,0:14:07.59,0:14:08.89,Default,,0,0,0,,Құрметті.
Dialogue: 0,0:14:09.34,0:14:12.22,Default,,0,0,0,,Бұдан былай қанша адам болса да...
Dialogue: 0,0:14:13.14,0:14:14.64,Default,,0,0,0,,Оның өтуіне жол бермеңіз!
Dialogue: 0,0:14:16.31,0:14:18.56,Default,,0,0,0,,Мемлекеттік қызметшілер не істеп жатыр!?
Dialogue: 0,0:14:18.81,0:14:19.65,Default,,0,0,0,,Құрметті...
Dialogue: 0,0:14:20.27,0:14:21.11,Default,,0,0,0,,Құрметті...
Dialogue: 0,0:14:21.52,0:14:23.44,Default,,0,0,0,,Біз жеке полиция күшіміз!
Dialogue: 0,0:14:23.53,0:14:24.36,Default,,0,0,0,,Бұл не!?
Dialogue: 0,0:14:24.69,0:14:27.86,Default,,0,0,0,,Бұл жеке компания, сондықтан сіз не істесеңіз де, бұл бей-берекет!
Dialogue: 0,0:14:28.20,0:14:29.36,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:14:29.78,0:14:31.78,Default,,0,0,0,,Мен кешігіп барамын!
Dialogue: 0,0:14:31.87,0:14:33.49,Default,,0,0,0,,Қозғалмаңыз!
Dialogue: 0,0:14:33.58,0:14:36.58,Default,,0,0,0,,Бір қадам болса да қозғалсаң, мен сені бояймын.
Dialogue: 0,0:14:37.12,0:14:40.46,Default,,0,0,0,,Рико Изуми ФК мүшесі №4 (төртінші нөмір)
Dialogue: 0,0:14:40.63,0:14:43.09,Default,,0,0,0,,Бояу цехының... Исидзучи
Dialogue: 0,0:14:44.84,0:14:47.01,Default,,0,0,0,,Не... не болып жатыр?
Dialogue: 0,0:14:47.09,0:14:48.38,Default,,0,0,0,,Каха… аа…
Dialogue: 0,0:14:49.05,0:14:50.39,Default,,0,0,0,,Жоқ... қабырға!
Dialogue: 0,0:14:51.47,0:14:53.81,Default,,0,0,0,,Мен туралы жаман ойлама (Тачиваку) Уау.
Dialogue: 0,0:14:54.35,0:14:57.81,Default,,0,0,0,,Мен FC жаңадан келгендермен скрам құрдым.
Dialogue: 0,0:14:58.44,0:14:59.60,Default,,0,0,0,,Бұл дауыс...
Dialogue: 0,0:15:00.15,0:15:03.15,Default,,0,0,0,,Рико Изуми сіздің Рико Изуми емес
Dialogue: 0,0:15:04.23,0:15:05.98,Default,,0,0,0,,Барлығы Изуми Рико
Dialogue: 0,0:15:07.36,0:15:10.36,Default,,0,0,0,,Рико Изуми ФК мүшесі №1 (Бірінші нөмір)
Dialogue: 0,0:15:10.78,0:15:12.16,Default,,0,0,0,,Обина орман жолы
Dialogue: 0,0:15:12.74,0:15:15.74,Default,,0,0,0,,Мен сені ұнатпаймын... Ой!
Dialogue: 0,0:15:17.41,0:15:19.00,Default,,0,0,0,,Кя... Капитан!
Dialogue: 0,0:15:19.25,0:15:23.59,Default,,0,0,0,,Мен сенің сезіміңді білемін, мұндағылардың бәрі бірдей сезінеді...
Dialogue: 0,0:15:24.38,0:15:28.80,Default,,0,0,0,,Жоқ, Рико Изумиді ұнататын ФК-дан басқа адамдар көп.
Dialogue: 0,0:15:29.17,0:15:35.06,Default,,0,0,0,,Сондықтан бұл ФК тыныштықты сақтау және тәртіпсіздіктердің алдын алу үшін құрылған.
Dialogue: 0,0:15:37.35,0:15:39.81,Default,,0,0,0,,Бір нәрсені түсініңіз...
Dialogue: 0,0:15:40.10,0:15:41.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:41.19,0:15:43.69,Default,,0,0,0,,Жоқ... Капитан, тоқтатыңыз!
Dialogue: 0,0:15:43.77,0:15:44.73,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:15:44.98,0:15:49.61,Default,,0,0,0,,Менің сәждеге тоқтайтын уақытым – Мақабенің жағдайды қабылдаған кезі!
Dialogue: 0,0:15:50.20,0:15:52.36,Default,,0,0,0,,Себебі оған көмектесу мүмкін емес, солай ма?
Dialogue: 0,0:15:52.61,0:15:53.78,Default,,0,0,0,,Келісім жасасамыз ба?
Dialogue: 0,0:15:54.70,0:15:58.37,Default,,0,0,0,,Өйткені мен оларды жақсы көремін, сондықтан оған көмектесу мүмкін емес!
Dialogue: 0,0:15:58.62,0:15:59.58,Default,,0,0,0,,Не!
Dialogue: 0,0:15:59.91,0:16:01.04,Default,,0,0,0,,Иә...
Dialogue: 0,0:16:01.92,0:16:02.75,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:06.13,0:16:07.42,Default,,0,0,0,,Хмм... мм...
Dialogue: 0,0:16:10.05,0:16:12.76,Default,,0,0,0,,Дұрыс! Изуми мырза!
Dialogue: 0,0:16:15.05,0:16:16.39,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:16:16.64,0:16:17.97,Default,,0,0,0,,Зуко!
Dialogue: 0,0:16:18.06,0:16:19.35,Default,,0,0,0,,Агабуку буку буку…
Dialogue: 0,0:16:52.72,0:16:55.76,Default,,0,0,0,,Біздің сыныпқа арналған қосымша емтихан бүгін аяқталады.
Dialogue: 0,0:16:55.89,0:16:57.60,Default,,0,0,0,,Тергеуіміз қажет нәрселер бар… біртіндеп шешеміз
Dialogue: 0,0:16:57.68,0:16:58.51,Default,,0,0,0,,Және-
Dialogue: 0,0:16:58.97,0:17:00.97,Default,,0,0,0,,Жазғы демалыс аяқталуға жақын
Dialogue: 0,0:17:02.23,0:17:05.15,Default,,0,0,0,,Сіздің жазыңыз осындай ма!?
Dialogue: 0,0:17:05.56,0:17:06.65,Default,,0,0,0,,Кем дегенде бірдеңе-
Dialogue: 0,0:17:07.06,0:17:10.90,Default,,0,0,0,,Тарихта қалатын жаз естеліктерін жасағыңыз келмейді ме?
Dialogue: 0,0:17:11.74,0:17:12.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:13.19,0:17:14.86,Default,,0,0,0,,Тачиваку Айтшы.
Dialogue: 0,0:17:17.74,0:17:18.83,Default,,0,0,0,,Осы жазда...
Dialogue: 0,0:17:19.28,0:17:21.16,Default,,0,0,0,,Мені Рико Изуми тастап кетті
Dialogue: 0,0:17:21.45,0:17:23.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:24.79,0:17:27.63,Default,,0,0,0,,Бұл Гиннеске кіре ме?!
Dialogue: 0,0:17:28.13,0:17:30.50,Default,,0,0,0,,Тачиваку Сен... не істеп жатырсың...
Dialogue: 0,0:17:30.80,0:17:34.13,Default,,0,0,0,,Хуларе Гиннеске кіре ме... Уф...?!
Dialogue: 0,0:17:37.51,0:17:40.81,Default,,0,0,0,,А... Тачиваку... Сен...
Dialogue: 0,0:17:42.14,0:17:46.52,Default,,0,0,0,,«Банандарды тағамдарға қосуға бола ма?» Бұл… күрсіну…
Dialogue: 0,0:17:47.35,0:17:50.23,Default,,0,0,0,,Фрэр Гиннестің рекордтар кітабына енбейді
Dialogue: 0,0:17:50.73,0:17:51.98,Default,,0,0,0,,Иә!? (Могура) Ах!
Dialogue: 0,0:17:52.07,0:17:52.90,Default,,0,0,0,,Бұл қандай дауыс?
Dialogue: 0,0:17:53.36,0:17:57.32,Default,,0,0,0,,Бірақ... Тачиваку-кунның батылдығы мен мұғалімнің жауабы...
Dialogue: 0,0:17:57.49,0:17:59.66,Default,,0,0,0,,Шешімі енді көрініп тұр
Dialogue: 0,0:18:00.49,0:18:03.70,Default,,0,0,0,,Мен тек Гиннестің рекордтар кітабына енуді қалаймын.
Dialogue: 0,0:18:03.79,0:18:06.21,Default,,0,0,0,,Тарихта атыңды жазу емес.
Dialogue: 0,0:18:06.87,0:18:08.08,Default,,0,0,0,,Бұл жерде ше?
Dialogue: 0,0:18:08.33,0:18:11.71,Default,,0,0,0,,Жаңа сөздерді бірге құрастырайық...
Dialogue: 0,0:18:12.21,0:18:16.34,Default,,0,0,0,,Ал егер бұл сөз сөздік жүлдені жеңіп алса ше?
Dialogue: 0,0:18:16.59,0:18:18.47,Default,,0,0,0,,Тара Адачи күткендей...
Dialogue: 0,0:18:18.68,0:18:22.51,Default,,0,0,0,,Сонда тарихта өз атымызды қалдырамыз.
Dialogue: 0,0:18:22.72,0:18:25.81,Default,,0,0,0,,Бірақ сол жаңа сөз ше?
Dialogue: 0,0:18:25.93,0:18:26.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:26.85,0:18:29.02,Default,,0,0,0,,Бұл сөз туралы не айтасыз?
Dialogue: 0,0:18:30.27,0:18:33.02,Default,,0,0,0,,«Гиннесс тағамдар ма?»
Dialogue: 0,0:18:33.78,0:18:35.28,Default,,0,0,0,,(Оқушылар айқайлайды)
Dialogue: 0,0:18:35.57,0:18:39.11,Default,,0,0,0,,«Гиннесті тағамдарға қосуға бола ма?»
Dialogue: 0,0:18:39.28,0:18:40.11,Default,,0,0,0,,Жыл!
Dialogue: 0,0:18:40.20,0:18:42.37,Default,,0,0,0,,Сува мырза!? (Б оқушы) Жақсысың ба!?
Dialogue: 0,0:18:42.66,0:18:46.91,Default,,0,0,0,,Гехоккей... Кешіріңіз, мен сәл таң қалдым... Эххх
Dialogue: 0,0:18:47.50,0:18:51.13,Default,,0,0,0,,Тара Адачи Мұны мұғалімнің көзқарасы бойынша айтайын.
Dialogue: 0,0:18:51.92,0:18:55.76,Default,,0,0,0,,Гиннестің рекордтар кітабына жеңіл тағамдар кірмейді!
Dialogue: 0,0:18:56.38,0:18:59.01,Default,,0,0,0,,Хм... Сонымен ше?
Dialogue: 0,0:18:59.93,0:19:02.68,Default,,0,0,0,,«Гиннес бананға кіреді ме?»
Dialogue: 0,0:19:03.10,0:19:04.51,Default,,0,0,0,,Көпіршікті, көпіршікті...
Dialogue: 0,0:19:04.93,0:19:07.27,Default,,0,0,0,,Мокура-кун құлап қалды! (D оқушысы) Тара Адачи!
Dialogue: 0,0:19:07.77,0:19:11.81,Default,,0,0,0,,Сіз өзіңіздің сыныптастарыңызды өлтіруді жоспарлап отырсыз ба!? (Ф оқушы) Бұлай жалғаса берсе, бүкіл сынып жойылады!
Dialogue: 0,0:19:12.36,0:19:13.98,Default,,0,0,0,,Сонда соңғысы
Dialogue: 0,0:19:14.44,0:19:16.28,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:19:18.15,0:19:20.78,Default,,0,0,0,,«Мен Гиннес пен банан ала аламын ба?»
Dialogue: 0,0:19:20.91,0:19:22.41,Default,,0,0,0,,Қайда!? (Рёта) Иә?
Dialogue: 0,0:19:24.24,0:19:25.12,Default,,0,0,0,,Сөмкеде
Dialogue: 0,0:19:26.16,0:19:28.16,Default,,0,0,0,,Сонда мен кіруім мүмкін! (Студент Н) Міне осында!?
Dialogue: 0,0:19:28.25,0:19:30.42,Default,,0,0,0,,Иә! (Дж. оқушы) Міндетті түрде кіріңіз!
Dialogue: 0,0:19:30.71,0:19:33.67,Default,,0,0,0,,Мұғалім! Тез арада сөздік кеңсесіне қоңырау шалыңыз!
Dialogue: 0,0:19:33.67,0:19:34.50,Default,,0,0,0,,Мұғалім! Тез арада сөздік кеңсесіне қоңырау шалыңыз!
Dialogue: 0,0:19:33.67,0:19:34.50,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:19:34.59,0:19:38.46,Default,,0,0,0,,Дүрбелеңге салынба, Дүрбелеңге салынба.
Dialogue: 0,0:19:38.88,0:19:42.18,Default,,0,0,0,,Тара Адачи деген кім? (Сува) Бүгін дұрыс болды!
Dialogue: 0,0:19:42.26,0:19:44.68,Default,,0,0,0,,Ия, көңілім көтеріліп барады!
Dialogue: 0,0:19:45.22,0:19:47.06,Default,,0,0,0,,Адреналин сорғыш!
Dialogue: 0,0:19:47.18,0:19:47.93,Default,,0,0,0,,Иә
Dialogue: 0,0:19:50.10,0:19:53.98,Default,,0,0,0,,А-а... Қалың сөздер туралы айту дұрыс па?
Dialogue: 0,0:19:54.48,0:19:59.07,Default,,0,0,0,,Менің атым Амаги, мен CITY Минами орта мектебінің 2 және 3 сыныптарының мұғалімімін.
Dialogue: 0,0:19:59.57,0:20:03.53,Default,,0,0,0,,Бұл жаңа сөз. Бұл сөзге айналғанын қалаймын.
Dialogue: 0,0:20:04.49,0:20:05.58,Default,,0,0,0,,Иә
Dialogue: 0,0:20:06.83,0:20:07.70,Default,,0,0,0,,Иә
Dialogue: 0,0:20:08.29,0:20:09.16,Default,,0,0,0,,А... иә
Dialogue: 0,0:20:10.25,0:20:11.12,Default,,0,0,0,,Ал...
Dialogue: 0,0:20:11.96,0:20:12.79,Default,,0,0,0,,Иә
Dialogue: 0,0:20:13.25,0:20:16.54,Default,,0,0,0,,«Мен Гиннес пен банан ала аламын ба?» деген сөйлем.
Dialogue: 0,0:20:17.55,0:20:18.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:18.50,0:20:19.84,Default,,0,0,0,,Аа, бұл сөмкеде.
Dialogue: 0,0:20:21.22,0:20:22.38,Default,,0,0,0,,Иә
Dialogue: 0,0:20:23.43,0:20:27.26,Default,,0,0,0,,О, түсіндім! Мен түссіндім!
Dialogue: 0,0:20:27.56,0:20:29.72,Default,,0,0,0,,Иә! Кешіріңіз!
Dialogue: 0,0:20:30.93,0:20:32.94,Default,,0,0,0,,Қалай болды!? Мұғалім!
Dialogue: 0,0:20:37.07,0:20:38.32,Default,,0,0,0,,Оны еш күш жұмсамай шашыраңқы етіп көрсету үшін
Dialogue: 0,0:20:39.15,0:20:42.45,Default,,0,0,0,,Өмір – қиындықтар тізбегі
Dialogue: 0,0:20:43.49,0:20:47.37,Default,,0,0,0,,2 және 3 сыныптар үшін жаз аяқталады.
Dialogue: 0,0:20:55.75,0:20:56.79,Default,,0,0,0,,Йотто!
Dialogue: 0,0:20:57.00,0:20:57.88,Default,,0,0,0,,Жылдам, жылдам!
Dialogue: 0,0:20:58.75,0:21:00.21,Default,,0,0,0,,Соге!
Dialogue: 0,0:21:00.55,0:21:01.38,Default,,0,0,0,,(камера ысырмасының дыбысы)
Dialogue: 0,0:21:06.51,0:21:08.97,Default,,0,0,0,,Ахахахахаха
Dialogue: 0,0:21:09.14,0:21:13.52,Default,,0,0,0,,Бір айдан бері алоха деп жүргеніме қатты толқыдым.
Dialogue: 0,0:21:13.60,0:21:17.40,Default,,0,0,0,,Соңғы бірнеше жылда үшеуміздің бір мезгілде мерекелер болған жоқ.
Dialogue: 0,0:21:17.48,0:21:20.94,Default,,0,0,0,,Не? Мүмкін сіз одан асып кеткен шығарсыз?
Dialogue: 0,0:21:21.03,0:21:22.86,Default,,0,0,0,,Ол кездегі жазғы демалыс
Dialogue: 0,0:21:22.94,0:21:25.32,Default,,0,0,0,,Бұл мүмкін емес! Бұл одан тыс! (Цурубиши) Хехехехе
Dialogue: 0,0:21:25.45,0:21:27.66,Default,,0,0,0,,Көліктің ішінде жалғыз менмін.
Dialogue: 0,0:21:28.03,0:21:30.28,Default,,0,0,0,,Ендеше бірден ішіп алайық!
Dialogue: 0,0:21:30.54,0:21:33.71,Default,,0,0,0,,Шинкодан аттанатын жалдамалы банкет автобусы!
Dialogue: 0,0:21:33.79,0:21:35.67,Default,,0,0,0,,Не! Нахаха! (Әкесі/Бас редакторы) Хэхехехе
Dialogue: 0,0:21:36.04,0:21:38.08,Default,,0,0,0,,Ах, тұтынушы, тұтынушы
Dialogue: 0,0:21:38.38,0:21:39.21,Default,,0,0,0,,(Кондуктор) Сабыр сақтап, батырды күтіңіздер…
Dialogue: 0,0:21:40.25,0:21:41.46,Default,,0,0,0,,Мереке...
Dialogue: 0,0:21:41.84,0:21:44.55,Default,,0,0,0,,Мен де қатыса аламын ба?
Dialogue: 0,0:21:45.05,0:21:46.01,Default,,0,0,0,,Довахахаха
Dialogue: 0,0:21:46.09,0:21:48.26,Default,,0,0,0,,Жақсы себеп бар!
Dialogue: 0,0:21:48.34,0:21:52.35,Default,,0,0,0,,Ех~ Келесіде Тозақтың 1-ші көшесі ~ Не?!
Dialogue: 0,0:21:52.43,0:21:53.85,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:21:53.93,0:21:55.81,Default,,0,0,0,,Келер алдында дайындалайын ба?
Dialogue: 0,0:21:55.89,0:21:57.90,Default,,0,0,0,,О, бұл тамаша! (Әкесі/Бас редакторы) Ахахаха
Dialogue: 0,0:22:01.07,0:22:03.32,Default,,0,0,0,,Уф...
Dialogue: 0,0:22:06.90,0:22:07.99,Default,,0,0,0,,Бұл…
Dialogue: 0,0:22:08.61,0:22:12.08,Default,,0,0,0,,Келіңіздер! Осы туннельден өткенде, теңіз сізді күтеді!
Dialogue: 0,0:22:12.29,0:22:14.41,Default,,0,0,0,,Мм... Макабе мырза (Бас редактор) Цуру мырза
Dialogue: 0,0:22:17.92,0:22:18.96,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:22:19.04,0:22:21.34,Default,,0,0,0,,Уф... Асықсам да бастай алмаймын!
Dialogue: 0,0:22:21.59,0:22:23.88,Default,,0,0,0,,ТҮНДЕ рахаттаныңыз!
Dialogue: 0,0:22:24.21,0:22:25.34,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:22:25.47,0:22:26.88,Default,,0,0,0,,Ах! (Әке) Әй, бас редактор!
Dialogue: 0,0:22:27.55,0:22:29.97,Default,,0,0,0,,Күте тұр десе, ешкім күтпейді!
Dialogue: 0,0:22:30.05,0:22:32.51,Default,,0,0,0,,Ах! Маған әлі ешкім күте тұр деп айтып жатқан жоқ!
Dialogue: 0,0:22:32.60,0:22:34.60,Default,,0,0,0,,Ақырында, күте тұрыңыз!
Dialogue: 0,0:22:34.72,0:22:36.35,Default,,0,0,0,,Кел, кел, кел, кел!
Dialogue: 0,0:22:36.52,0:22:38.39,Default,,0,0,0,,Бірінші кезекте!
Dialogue: 0,0:22:38.98,0:22:39.81,Default,,0,0,0,,Құдай
Dialogue: 0,0:22:40.06,0:22:41.77,Default,,0,0,0,,Бас редактор!
Dialogue: 0,0:22:41.94,0:22:45.36,Default,,0,0,0,,Менің саяхатым осы жерде аяқталған сияқты.
Dialogue: 0,0:22:45.44,0:22:48.20,Default,,0,0,0,,Мен үшін алаңдамай ләззат алыңыз.
Dialogue: 0,0:22:48.32,0:22:50.03,Default,,0,0,0,,Сіз мұны істей аласыз ба!
Dialogue: 0,0:22:50.24,0:22:53.20,Default,,0,0,0,,Үшеуміз де үш қарғамыз!
Dialogue: 0,0:22:53.41,0:22:54.66,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:22:54.83,0:22:59.17,Default,,0,0,0,,Балалар, осыны асыға күттіңдер ме?
Dialogue: 0,0:22:59.92,0:23:02.17,Default,,0,0,0,,Егер сіз оны асыға күтпеймін десеңіз...
Dialogue: 0,0:23:02.59,0:23:04.00,Default,,0,0,0,,Өтірік бол!
Dialogue: 0,0:23:05.21,0:23:06.38,Default,,0,0,0,,Макабе мырза...
Dialogue: 0,0:23:07.05,0:23:07.97,Default,,0,0,0,,Мен де!
Dialogue: 0,0:23:09.18,0:23:11.64,Default,,0,0,0,,Жарайды! Бас редактор үшін –
Dialogue: 0,0:23:12.30,0:23:14.60,Default,,0,0,0,,Жаздан рахат алыңыз!
Dialogue: 0,0:23:15.47,0:23:16.97,Default,,0,0,0,,Тара Адачи!?
Dialogue: 0,0:23:17.10,0:23:18.73,Default,,0,0,0,,Тара Адачи!
Dialogue: 0,0:23:19.06,0:23:20.14,Default,,0,0,0,,Ах!
Dialogue: 0,0:23:32.78,0:23:34.08,Default,,0,0,0,,♪～
Dialogue: 0,0:23:34.20,0:23:37.62,Default,,0,0,0,,Мен таң қалдым! Маусым
Dialogue: 0,0:23:37.95,0:23:41.67,Default,,0,0,0,,Еш ойланбастан ерітіңіз
Dialogue: 0,0:23:42.21,0:23:46.13,Default,,0,0,0,,Қайнап жатқан көшемен Гойнонға бару
Dialogue: 0,0:23:46.25,0:23:50.13,Default,,0,0,0,,Түс пе, әлде бірдеңе ме, білмеймін
Dialogue: 0,0:23:50.26,0:23:53.80,Default,,0,0,0,,Шамадан тыс ұйықтаудан туындаған шымшу
Dialogue: 0,0:23:54.39,0:23:57.97,Default,,0,0,0,,Таң қалдыратын сараңдық та солай.
Dialogue: 0,0:23:58.52,0:24:02.44,Default,,0,0,0,,Бұл ұят және тітіркендіргіш.
Dialogue: 0,0:24:02.56,0:24:05.82,Default,,0,0,0,,Қазір оны жеуге ең жақсы уақыт сияқты.
Dialogue: 0,0:24:06.23,0:24:13.20,Default,,0,0,0,,Кәдімгідей болып көріну
Dialogue: 0,0:24:14.41,0:24:21.37,Default,,0,0,0,,Өткен жылғыдан басқа жаз.
Dialogue: 0,0:24:22.46,0:24:27.09,Default,,0,0,0,,Мәселе! Бірақ қызық
Dialogue: 0,0:24:30.72,0:24:35.18,Default,,0,0,0,,Сіз өзіңізсіз
Dialogue: 0,0:24:38.10,0:24:42.48,Default,,0,0,0,,Бұл қалада мысықтар да, шөміштер де жүгіреді
Dialogue: 0,0:24:42.85,0:24:45.65,Default,,0,0,0,,Мен де бүгін сенімен бірге болғым келеді
Dialogue: 0,0:24:45.86,0:24:52.82,Default,,0,0,0,,Шатырдың артына тығылған күн
Dialogue: 0,0:24:53.36,0:24:55.82,Default,,0,0,0,,Әй, жаз келе жатыр
Dialogue: 0,0:24:58.53,0:25:01.37,Default,,0,0,0,,～♪
Dialogue: 0,0:25:02.62,0:25:04.87,Default,,0,0,0,,Мен Татеваку Макабе 16 жаста
Dialogue: 0,0:25:05.00,0:25:08.04,Default,,0,0,0,,Жоғары мақтау 2 курс орта мектеп оқушысы Маған рұқсат.
Dialogue: 0,0:25:08.42,0:25:12.01,Default,,0,0,0,,Бұл кенет болды, бірақ маған ұнаған адам кенеттен мені тастап кетті...
Dialogue: 0,0:25:12.51,0:25:15.26,Default,,0,0,0,,Бірақ әйтеуір, білмеймін, бірақ олай емес сияқты.
Dialogue: 0,0:25:15.97,0:25:17.51,Default,,0,0,0,,Менің тағы да шабуыл жасағанымды қалайсың ба?
Dialogue: 0,0:25:17.60,0:25:19.56,Default,,0,0,0,,Міне, солай болады деп ойлаймын...
Dialogue: 0,0:25:20.43,0:25:22.06,Default,,0,0,0,,«ҚАЛА» жаңа бағдарламасы
Dialogue: 0,0:25:22.18,0:25:25.31,Default,,0,0,0,,Мен өзімді керемет шытырман оқиғаға тап болғандай сезінемін!
Dialogue: 0,0:25:28.23,0:25:29.07,Default,,0,0,0,,Жартылай ұйықтап жатқанда
Dialogue: 0,0:25:29.32,0:25:31.94,Default,,0,0,0,,Өзі ойлап тапқан сөмкесін алып ұшып бара жатқан Изуми мырзаны қуып бара жатып...
Dialogue: 0,0:25:32.19,0:25:34.15,Default,,0,0,0,,Сонымен біз елсіз аралға келдік...
Dialogue: 0,0:25:34.24,0:25:35.70,Default,,0,0,0,,Онда екі адам ғана
Dialogue: 0,0:25:36.07,0:25:38.41,Default,,0,0,0,,Бұл дегеніміз... Яғни~!
Dialogue: 0,0:25:38.57,0:25:40.16,Default,,0,0,0,,Уау!
Dialogue: 0,0:25:40.53,0:25:42.95,Default,,0,0,0,,Мен қазір жастық шағымдамын.
Dialogue: 0,0:25:43.45,0:25:47.46,Default,,0,0,0,,Келесі жолы «ҚАЛА» abc Жазғы тәжірибе қаншалықты алыс болады?
Dialogue: 0,0:25:47.79,0:25:50.25,Default,,0,0,0,,Сиқырлы арал - тропиктік арал
Dialogue: 0,0:25:50.42,0:25:53.59,Default,,0,0,0,,Мен дәл осындай нәрселерді елестетіп тұрғанымда, құтқару кемесі келді!
Dialogue: 0,0:25:53.80,0:25:55.42,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:25:57.59,0:25:58.89,Default,,0,0,0,,Енді мәселеге.
Dialogue: 0,0:25:58.97,0:26:01.81,Default,,0,0,0,,Көмекке келген кеме «қарақшылар кемесі» болды ма?
Dialogue: 0,0:26:02.22,0:26:03.93,Default,,0,0,0,,Не айтып тұрсың!
Dialogue: 0,0:26:04.10,0:26:07.10,Default,,0,0,0,,Байқасам, Изуми-сан кетіп қалды!
Dialogue: 0,0:26:07.48,0:26:10.27,Default,,0,0,0,,Мұрын шамдары әр жерде түсіп жатыр
Dialogue: 0,0:26:10.52,0:26:11.90,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:26:12.53,0:26:14.15,Default,,0,0,0,,Келесі жолы «ҚАЛА»
Dialogue: 0,0:26:14.49,0:26:18.32,Default,,0,0,0,,Осыны орындасаң, Изуми-санды табасың!
Dialogue: 0,0:26:21.62,0:26:25.54,Default,,0,0,0,,Мұрын фонарының артынан барсам, жат планеталықтар әскері тұр екен!
Dialogue: 0,0:26:25.75,0:26:28.17,Default,,0,0,0,,Рико Изуми сол жерде қамалған
Dialogue: 0,0:26:28.87,0:26:30.04,Default,,0,0,0,,Бізді де қамауға алды!
Dialogue: 0,0:26:30.25,0:26:34.01,Default,,0,0,0,,Не?! Бұл арал құлайды!?
Dialogue: 0,0:26:34.38,0:26:35.42,Default,,0,0,0,,Бұған қоса, осы батпақтың қараңғылығы денеңе жабысып, салмақ салып тұр.
Dialogue: 0,0:26:35.72,0:26:37.47,Default,,0,0,0,,Біз ғана құтқарыламыз ба?
Dialogue: 0,0:26:37.80,0:26:42.01,Default,,0,0,0,,Иә! Ішінде Изуми бар еді, бұл ғарыш кемесімен үйге қайтуға болатынын айтты!
Dialogue: 0,0:26:42.18,0:26:43.10,Default,,0,0,0,,Келесі жолы «ҚАЛА»
Dialogue: 0,0:26:43.18,0:26:47.31,Default,,0,0,0,,Сөмке! Изуми-санды қайда апарып жатырсың?
Dialogue: 0,0:26:50.27,0:26:52.82,Default,,0,0,0,,Қандай да бір себептермен мен ақыры материкке оралдым...
Dialogue: 0,0:26:52.90,0:26:55.44,Default,,0,0,0,,Мен Изуми-санға деген сезімімді сөмкеге сеніп тапсырдым!
Dialogue: 0,0:26:55.53,0:26:57.86,Default,,0,0,0,,Жақсы! Қайта айт, сөмке!
Dialogue: 0,0:26:57.95,0:27:00.82,Default,,0,0,0,,Оның бір жақсы жағы бар.
Dialogue: 0,0:27:00.91,0:27:04.95,Default,,0,0,0,,Таңқаларлық? Сізге жараспайды ма? Не?
Dialogue: 0,0:27:05.49,0:27:06.50,Default,,0,0,0,,Керемет!
Dialogue: 0,0:27:06.66,0:27:08.66,Default,,0,0,0,,Маған қалдырыңыз!
Dialogue: 0,0:27:09.04,0:27:10.83,Default,,0,0,0,,Келесі жолы соңғысы... Ах!
Dialogue: 0,0:27:11.17,0:27:12.00,Default,,0,0,0,,Иә!?
Dialogue: 0,0:27:12.34,0:27:14.25,Default,,0,0,0,,Қате жазылған
Dialogue: 0,0:27:14.42,0:27:15.84,Default,,0,0,0,,Зуко!
Dialogue: 0,0:27:16.51,0:27:17.76,Default,,0,0,0,,(Нәрсенің құлаған дыбысы)
Dialogue: 0,0:27:25.60,0:27:28.39,Default,,0,0,0,,Тачиваку Оме, сен не істеп жүрсің?
Dialogue: 0,0:27:30.35,0:27:32.15,Default,,0,0,0,,Хмм...хехехе...
Dialogue: 0,0:27:32.61,0:27:34.44,Default,,0,0,0,,Бұл тамаша шытырман оқиға
Dialogue: 0,0:27:35.94,0:27:41.94,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory