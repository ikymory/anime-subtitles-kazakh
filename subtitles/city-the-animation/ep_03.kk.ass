Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.54,0:00:06.79,Default,,0,0,0,,(қол соғу дыбысы)
Dialogue: 0,0:00:06.88,0:00:10.05,Default,,0,0,0,,(Оқушылар сөйлейді)
Dialogue: 0,0:00:10.13,0:00:12.43,Default,,0,0,0,,Ммммммммммм Уау! Уф
Dialogue: 0,0:00:12.63,0:00:14.89,Default,,0,0,0,,Ячин
Dialogue: 0,0:00:15.59,0:00:17.64,Default,,0,0,0,,Бұл пьесаны жазуда...
Dialogue: 0,0:00:17.93,0:00:19.89,Default,,0,0,0,,Менің жолымнан көптеген қиындықтар өтті
Dialogue: 0,0:00:20.35,0:00:23.73,Default,,0,0,0,,Ұйқылық, азғыру, шаршау және толық емес жұмыс күні...
Dialogue: 0,0:00:23.98,0:00:26.15,Default,,0,0,0,,Тек тақырып шешілсе де, ол жапсырылады.
Dialogue: 0,0:00:26.23,0:00:28.15,Default,,0,0,0,,Плакаттардың қысымы
Dialogue: 0,0:00:29.73,0:00:31.49,Default,,0,0,0,,Мұның бәрін жеңу ...
Dialogue: 0,0:00:31.57,0:00:32.61,Default,,0,0,0,,(қол соғу дыбысы)
Dialogue: 0,0:00:32.70,0:00:36.03,Default,,0,0,0,,Текаридаке Гекидан 7-ші спектакль «Нодо»
Dialogue: 0,0:00:36.95,0:00:38.95,Default,,0,0,0,,Соңында аяқталды
Dialogue: 0,0:00:39.79,0:00:44.21,Default,,0,0,0,,А, енді... біз бірден жаттығуға барамыз!
Dialogue: 0,0:00:46.25,0:00:47.79,Default,,0,0,0,,Алдымен кешірім сұрауыма рұқсат етіңіз.
Dialogue: 0,0:00:48.59,0:00:49.75,Default,,0,0,0,,Уақыты келген жоқ па?
Dialogue: 0,0:00:50.92,0:00:54.34,Default,,0,0,0,,Бұл жолы сценарий жазғандықтан...
Dialogue: 0,0:00:54.68,0:00:58.14,Default,,0,0,0,,Мен екі нәрсе үшін барлығынан кешірім сұрауым керек.
Dialogue: 0,0:00:58.76,0:01:00.22,Default,,0,0,0,,Jah baba shuba
Dialogue: 0,0:01:00.60,0:01:01.60,Default,,0,0,0,,Әуелі бір нәрсе!
Dialogue: 0,0:01:01.72,0:01:02.60,Default,,0,0,0,,(Зенitsu) Ата енді ғана пайда болып, «Таласуды қойма» деді…
Dialogue: 0,0:01:02.73,0:01:04.98,Default,,0,0,0,,Белгіленген мерзімге кешігіп келу
Dialogue: 0,0:01:05.56,0:01:07.02,Default,,0,0,0,,Тағы бір нәрсе!
Dialogue: 0,0:01:07.65,0:01:09.73,Default,,0,0,0,,Барлығыңыз есіңізде ме?
Dialogue: 0,0:01:09.82,0:01:12.99,Default,,0,0,0,,Соңғы 6-шы қойылымда айтқаным
Dialogue: 0,0:01:13.44,0:01:16.49,Default,,0,0,0,,Ха, мен шедеврімді жаздым.
Dialogue: 0,0:01:17.16,0:01:20.79,Default,,0,0,0,,Болашақта басқа шығарма жаза алмаймын.
Dialogue: 0,0:01:20.87,0:01:21.79,Default,,0,0,0,,№
Dialogue: 0,0:01:21.87,0:01:23.54,Default,,0,0,0,,Жоқ
Dialogue: 0,0:01:23.62,0:01:24.50,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:01:24.62,0:01:28.92,Default,,0,0,0,,Бұл жолы бұдан да үлкен шедевр дүниеге келді!
Dialogue: 0,0:01:29.17,0:01:31.46,Default,,0,0,0,,Өкінішке орай, бұл кітап...
Dialogue: 0,0:01:31.55,0:01:33.67,Default,,0,0,0,,Бұл әлі де сценарий.
Dialogue: 0,0:01:33.96,0:01:38.59,Default,,0,0,0,,Әркімнің күші қосылса, жарқыраған сәуле шығады.
Dialogue: 0,0:01:39.35,0:01:43.64,Default,,0,0,0,,Ал енді бірге аңыз құрастырайық!
Dialogue: 0,0:01:46.10,0:01:46.94,Default,,0,0,0,,Менімен-
Dialogue: 0,0:01:47.65,0:01:48.69,Default,,0,0,0,,Сізден
Dialogue: 0,0:01:51.40,0:01:53.15,Default,,0,0,0,,♪～
Dialogue: 0,0:01:53.28,0:01:56.28,Default,,0,0,0,,Сәлеметсіздер ме, қымбатты достарым
Dialogue: 0,0:01:56.57,0:01:59.16,Default,,0,0,0,,Маған армандарың туралы айтып бер
Dialogue: 0,0:01:59.32,0:02:04.25,Default,,0,0,0,,Сол күндер есіңізде ме?
Dialogue: 0,0:02:05.62,0:02:11.54,Default,,0,0,0,,Ересек болу қиын, солай емес пе?
Dialogue: 0,0:02:11.67,0:02:18.30,Default,,0,0,0,,Жасырылған нәрсені табайық.
Dialogue: 0,0:02:19.68,0:02:20.68,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:02:29.40,0:02:35.36,Default,,0,0,0,,Өзіңіздің беймаза ойыңызды тастаңыз
Dialogue: 0,0:02:35.53,0:02:38.36,Default,,0,0,0,,Бұлттар жүзіп келеді
Dialogue: 0,0:02:38.49,0:02:42.41,Default,,0,0,0,,Жоғары қарап, секір!
Dialogue: 0,0:02:43.37,0:02:46.25,Default,,0,0,0,,Жаңбыр тоқтады
Dialogue: 0,0:02:46.45,0:02:49.42,Default,,0,0,0,,Ән айту
Dialogue: 0,0:02:49.62,0:02:53.00,Default,,0,0,0,,Қол ұстасу
Dialogue: 0,0:02:55.80,0:02:58.72,Default,,0,0,0,,Мен күлдім
Dialogue: 0,0:02:58.84,0:03:01.89,Default,,0,0,0,,Сен де күлесің
Dialogue: 0,0:03:02.01,0:03:05.26,Default,,0,0,0,,Әрине ұнайды
Dialogue: 0,0:03:05.39,0:03:11.23,Default,,0,0,0,,Тағы кездесейік
Dialogue: 0,0:03:17.78,0:03:20.15,Default,,0,0,0,,～♪
Dialogue: 0,0:03:24.24,0:03:26.79,Default,,0,0,0,,Әй, әй, бәріңе не болды?
Dialogue: 0,0:03:27.04,0:03:30.12,Default,,0,0,0,,Жоқ, кешіккенім үшін кешірім сұраймын.
Dialogue: 0,0:03:30.21,0:03:31.21,Default,,0,0,0,,Мынадай қарашы
Dialogue: 0,0:03:31.58,0:03:35.25,Default,,0,0,0,,Мен жарты күн жұмыс істейтін наннан бәрінің құлағын аламын.
Dialogue: 0,0:03:36.13,0:03:39.34,Default,,0,0,0,,Түсіндім, керемет толқу! Барлығына арналған сөмке кеспесі!
Dialogue: 0,0:03:39.59,0:03:41.30,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:03:44.80,0:03:48.31,Default,,0,0,0,,Ахахахахахаха бәрі қолма-қол ақша.
Dialogue: 0,0:03:48.43,0:03:50.89,Default,,0,0,0,,Мен түсіндім. Мен түссіндім.
Dialogue: 0,0:03:50.98,0:03:53.02,Default,,0,0,0,,Қош бол хахахаха
Dialogue: 0,0:03:53.31,0:03:54.94,Default,,0,0,0,,Күте тұрыңыз ба?
Dialogue: 0,0:03:55.27,0:03:58.15,Default,,0,0,0,,Не? Тозақ құсын мен бұрыннан білемін!
Dialogue: 0,0:03:58.61,0:03:59.65,Default,,0,0,0,,Гарсуке, шайнауды доғар!
Dialogue: 0,0:04:00.07,0:04:02.45,Default,,0,0,0,,Харибо Бұл мені пышақтап жатыр Ол мені пышақтап жатыр!
Dialogue: 0,0:04:03.24,0:04:05.16,Default,,0,0,0,,Чу мырза, бәрін тоқтатыңыз!
Dialogue: 0,0:04:05.66,0:04:06.91,Default,,0,0,0,,Қалай болғанда да...
Dialogue: 0,0:04:07.12,0:04:09.95,Default,,0,0,0,,Маймылмен күресудің күші...
Dialogue: 0,0:04:10.12,0:04:12.04,Default,,0,0,0,,Бұл кенеттен өсіп жатыр!
Dialogue: 0,0:04:12.21,0:04:14.46,Default,,0,0,0,,Жарайды, түсіндім. Мен крокеттерді де қосамын!
Dialogue: 0,0:04:14.54,0:04:15.92,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:04:16.00,0:04:18.00,Default,,0,0,0,,А... Жарайды, түсіндім. Мен фарш жасаймын!
Dialogue: 0,0:04:18.38,0:04:21.17,Default,,0,0,0,,Бұл туралы не деуге болады! Ах хмм
Dialogue: 0,0:04:21.26,0:04:26.22,Default,,0,0,0,,Ақшаңыз болмаса, мейрамханадан рамен жеуге болады ма?
Dialogue: 0,0:04:27.76,0:04:29.52,Default,,0,0,0,,Ха, жақсы.
Dialogue: 0,0:04:29.72,0:04:32.18,Default,,0,0,0,,Барлығымыз бір кесе бөлісейік.
Dialogue: 0,0:04:32.27,0:04:33.27,Default,,0,0,0,,Хмм.
Dialogue: 0,0:04:33.44,0:04:35.23,Default,,0,0,0,,Хмм! Гофуууу
Dialogue: 0,0:04:35.60,0:04:38.19,Default,,0,0,0,,Неліктен? Маймылмен күресуді неге тоқтатпайсың
Dialogue: 0,0:04:38.57,0:04:40.23,Default,,0,0,0,,Атчер!
Dialogue: 0,0:04:40.32,0:04:46.28,Default,,0,0,0,,(қол соғу дыбысы)
Dialogue: 0,0:04:49.33,0:04:53.00,Default,,0,0,0,,Тыңда, тыңда, мен оны кеше таптым.
Dialogue: 0,0:04:53.08,0:04:55.12,Default,,0,0,0,,Анемоннан жасалған сүйкімді салпыншақ
Dialogue: 0,0:04:55.21,0:04:56.21,Default,,0,0,0,,Байыппен (1-оқушы қыз) Иә.
Dialogue: 0,0:04:56.29,0:04:57.21,Default,,0,0,0,,Көрсет, көрсет
Dialogue: 0,0:04:57.29,0:04:59.17,Default,,0,0,0,,Ал, менде үйде бар.
Dialogue: 0,0:05:00.63,0:05:03.55,Default,,0,0,0,,бұл... уау...
Dialogue: 0,0:05:05.55,0:05:06.59,Default,,0,0,0,,Ха!
Dialogue: 0,0:05:47.43,0:05:48.68,Default,,0,0,0,,(жебенің тесу дыбысы)
Dialogue: 0,0:06:47.65,0:06:49.11,Default,,0,0,0,,(жебенің тесу дыбысы)
Dialogue: 0,0:07:47.21,0:07:48.30,Default,,0,0,0,,(Түздіксіз жебелердің пышақталған дыбысы)
Dialogue: 0,0:07:50.38,0:07:51.59,Default,,0,0,0,,(Нәрсенің құлаған дыбысы)
Dialogue: 0,0:07:58.47,0:08:00.18,Default,,0,0,0,,Ніл өзенінің батыс жағалауындағы қиын өткелі бар шатқалдың тереңінде —
Dialogue: 0,0:08:01.44,0:08:04.35,Default,,0,0,0,,Бұл... біртүрлі атмосфера...
Dialogue: 0,0:08:06.48,0:08:08.28,Default,,0,0,0,,Ха... Нагумо-сан!
Dialogue: 0,0:08:08.78,0:08:09.69,Default,,0,0,0,,Не?
Dialogue: 0,0:08:10.11,0:08:10.94,Default,,0,0,0,,Нан...
Dialogue: 0,0:08:11.82,0:08:13.41,Default,,0,0,0,,Бір ғана
Dialogue: 0,0:08:13.99,0:08:16.70,Default,,0,0,0,,Наубайханада тек бір бөлке нан бар...
Dialogue: 0,0:08:17.03,0:08:18.99,Default,,0,0,0,,Бірақ бұл шындықты айтайық.
Dialogue: 0,0:08:19.37,0:08:21.46,Default,,0,0,0,,Шіріп кетсе де наубайхана дейміз бе?
Dialogue: 0,0:08:21.54,0:08:22.37,Default,,0,0,0,,Не?
Dialogue: 0,0:08:22.79,0:08:25.00,Default,,0,0,0,,Мына нанға мұқият қараңдар.
Dialogue: 0,0:08:25.46,0:08:28.30,Default,,0,0,0,,Бұл шынымен... жылы.
Dialogue: 0,0:08:28.88,0:08:31.26,Default,,0,0,0,,Сот?
Dialogue: 0,0:08:31.34,0:08:32.59,Default,,0,0,0,,Күте тұрыңыз (Нагумо) Иә?
Dialogue: 0,0:08:32.93,0:08:34.26,Default,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,0:08:34.38,0:08:37.05,Default,,0,0,0,,Тас, қағаз, қайшыдан жеңілу қымбатырақ екенін айтты емес пе?
Dialogue: 0,0:08:37.14,0:08:37.97,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:08:38.43,0:08:39.85,Default,,0,0,0,,Айырмашылығы неде?
Dialogue: 0,0:08:39.93,0:08:41.60,Default,,0,0,0,,Мына нанға мұқият қараңдар.
Dialogue: 0,0:08:42.31,0:08:43.52,Default,,0,0,0,,Бұл нарықтық баға.
Dialogue: 0,0:08:43.64,0:08:47.81,Default,,0,0,0,,Басқаша айтқанда, бұл жиіркенішті қымбат және шексіз қанағаттандырады!
Dialogue: 0,0:08:47.94,0:08:48.94,Default,,0,0,0,,Иә
Dialogue: 0,0:08:49.11,0:08:52.03,Default,,0,0,0,,Мен оның иісі керемет деп ойладым.
Dialogue: 0,0:08:52.24,0:08:54.70,Default,,0,0,0,,Жаман болудан тартынба...
Dialogue: 0,0:08:55.11,0:08:56.32,Default,,0,0,0,,Itadaki...
Dialogue: 0,0:08:56.45,0:08:57.70,Default,,0,0,0,,О?
Dialogue: 0,0:08:57.78,0:09:00.66,Default,,0,0,0,,Егер сатып алғыңыз келсе, тез арада сатып алыңыз.
Dialogue: 0,0:09:01.29,0:09:02.33,Default,,0,0,0,,Қысқыштар жоқ
Dialogue: 0,0:09:03.04,0:09:05.67,Default,,0,0,0,,Кассада тапсырыс беретін түрі емес пе?
Dialogue: 0,0:09:05.83,0:09:08.50,Default,,0,0,0,,Сонымен, науадағы мына үйінді не?
Dialogue: 0,0:09:09.00,0:09:10.13,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:09:10.38,0:09:11.71,Default,,0,0,0,,Мүмкін...
Dialogue: 0,0:09:13.09,0:09:14.34,Default,,0,0,0,,Осылай!
Dialogue: 0,0:09:15.68,0:09:17.51,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:09:17.84,0:09:18.80,Default,,0,0,0,,Бірақ қазіргі тепе-теңдік қашан бұзылатынын біз білмейміз
Dialogue: 0,0:09:19.01,0:09:21.89,Default,,0,0,0,,Соңғы бөлік орнына түскен сияқты.
Dialogue: 0,0:09:22.64,0:09:24.18,Default,,0,0,0,,Неге… неге мен
Dialogue: 0,0:09:24.31,0:09:27.90,Default,,0,0,0,,Жауабы иә, оны жалаң қолыңызбен ұстаңыз. Бұл дұрыс.
Dialogue: 0,0:09:28.44,0:09:32.32,Default,,0,0,0,,Кешіріңіз, кешігіп қалдым. Мен дүкеншінің шай ерітіндісін.
Dialogue: 0,0:09:33.03,0:09:36.66,Default,,0,0,0,,Енді Якисоба нанының 1.2 нұсқасы пісірілді.
Dialogue: 0,0:09:36.95,0:09:38.66,Default,,0,0,0,,Бұл да ше?
Dialogue: 0,0:09:39.12,0:09:40.78,Default,,0,0,0,,Якисоба наны…
Dialogue: 0,0:09:41.03,0:09:42.12,Default,,0,0,0,,Гүлп
Dialogue: 0,0:09:42.70,0:09:43.54,Default,,0,0,0,,Сұрақ
Dialogue: 0,0:09:43.70,0:09:44.91,Default,,0,0,0,,Иә, бұл не?
Dialogue: 0,0:09:45.46,0:09:50.00,Default,,0,0,0,,Мен мұны жалаңаш қолыммен ұстадым, бірақ оны орнына қоюға бола ма?
Dialogue: 0,0:09:50.13,0:09:53.09,Default,,0,0,0,,Мен оны жалаңаш қолыммен ұстадым, сондықтан мен әрине шықтым.
Dialogue: 0,0:09:53.26,0:09:54.46,Default,,0,0,0,,Қысқышты қойыңыз!
Dialogue: 0,0:09:54.97,0:09:56.13,Default,,0,0,0,,Осы жиналыстан шығып кетпек болғандарға не болады?
Dialogue: 0,0:09:56.68,0:10:00.22,Default,,0,0,0,,Нан таңдау – өмір таңдау.
Dialogue: 0,0:10:00.60,0:10:03.22,Default,,0,0,0,,Нан таңдау – нан таңдау!
Dialogue: 0,0:10:03.68,0:10:06.44,Default,,0,0,0,,Айтпақшы, нарықтық құны қандай?
Dialogue: 0,0:10:06.69,0:10:08.94,Default,,0,0,0,,Иә, содан кейін 10 иен.
Dialogue: 0,0:10:09.02,0:10:09.65,Default,,0,0,0,,Не!
Dialogue: 0,0:10:09.73,0:10:11.52,Default,,0,0,0,,Неліктен арзан?
Dialogue: 0,0:10:12.40,0:10:15.07,Default,,0,0,0,,Мен кешегі нанды қарызға бердім. Бұл кәдімгі нан.
Dialogue: 0,0:10:15.15,0:10:16.65,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:10:16.74,0:10:19.20,Default,,0,0,0,,Оны өзгертіңіз! Якисоба нанына ауысыңыз!
Dialogue: 0,0:10:19.32,0:10:20.24,Default,,0,0,0,,Га
Dialogue: 0,0:10:20.91,0:10:22.87,Default,,0,0,0,,Жарайсың ба, Нагумо-сан?
Dialogue: 0,0:10:23.24,0:10:25.91,Default,,0,0,0,,«Нан таңдау – өмір таңдау»
Dialogue: 0,0:10:26.04,0:10:27.62,Default,,0,0,0,,Мені 3 секундта жылат!
Dialogue: 0,0:10:28.00,0:10:31.75,Default,,0,0,0,,«Вентин нанының хош иісі бар» Бұл әйгілі сөз.
Dialogue: 0,0:10:32.13,0:10:33.50,Default,,0,0,0,,Мачта мені жылат!
Dialogue: 0,0:10:33.59,0:10:34.55,Default,,0,0,0,,Вача!
Dialogue: 0,0:10:36.80,0:10:37.47,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:37.55,0:10:40.43,Default,,0,0,0,,Мұқият іріктелген қара трюфельдер мен Отавара сиыр еті
Dialogue: 0,0:10:40.97,0:10:42.89,Default,,0,0,0,,Якисоба наны
Dialogue: 0,0:10:43.10,0:10:45.93,Default,,0,0,0,,Ха ха ха (шай ерітіндісі) бүгінгі базар бағасы...
Dialogue: 0,0:10:46.35,0:10:48.10,Default,,0,0,0,,Ол 1200 иен болады
Dialogue: 0,0:10:49.31,0:10:52.69,Default,,0,0,0,,Өмір...
Dialogue: 0,0:10:57.86,0:11:01.32,Default,,0,0,0,,Маған жақсылық жасасаң, маған ғашық боласың, солай ма?
Dialogue: 0,0:11:01.45,0:11:02.57,Default,,0,0,0,,Нарунару
Dialogue: 0,0:11:02.66,0:11:06.04,Default,,0,0,0,,Егер сен маған жақсы болсаң, мен де саған жақсы боламын, солай ма?
Dialogue: 0,0:11:06.12,0:11:07.00,Default,,0,0,0,,Суру Суру
Dialogue: 0,0:11:07.62,0:11:10.79,Default,,0,0,0,,Егер бұл бүкіл әлемге таралса, не болады деп ойлайсыз?
Dialogue: 0,0:11:11.21,0:11:12.71,Default,,0,0,0,,Хмм.
Dialogue: 0,0:11:13.13,0:11:13.84,Default,,0,0,0,,Ха!
Dialogue: 0,0:11:14.59,0:11:16.84,Default,,0,0,0,,Дүниеде соғыс жойылады
Dialogue: 0,0:11:17.09,0:11:17.92,Default,,0,0,0,,Бірақ соғыс жыртқыштары сиқыр қолдана алмайды ғой, иә?
Dialogue: 0,0:11:18.63,0:11:20.84,Default,,0,0,0,,Дұрыс жауапқа сағыз қонжық беріңіз
Dialogue: 0,0:11:20.93,0:11:21.93,Default,,0,0,0,,Тағдырымыз тоғысса екен.
Dialogue: 0,0:11:23.80,0:11:25.97,Default,,0,0,0,,Шындығында, егер сіз мұны жасасаңыз -
Dialogue: 0,0:11:26.43,0:11:28.93,Default,,0,0,0,,Біз Нобель Бейбітшілік сыйлығымыз
Dialogue: 0,0:11:29.23,0:11:30.23,Default,,0,0,0,,Сен басқа әлемнен келгеніңді айтасың ба?
Dialogue: 0,0:11:30.35,0:11:32.81,Default,,0,0,0,,Бірақ егер біреу бұл идеяны ұрласа...
Dialogue: 0,0:11:32.90,0:11:35.27,Default,,0,0,0,,Ха, Нобель сыйлығы жалған болады.
Dialogue: 0,0:11:35.36,0:11:36.73,Default,,0,0,0,,Бұл жаман!
Dialogue: 0,0:11:37.19,0:11:41.41,Default,,0,0,0,,Мұның алдын алу үшін не істейміз...
Dialogue: 0,0:11:42.24,0:11:43.32,Default,,0,0,0,,Патенттік өтінім?
Dialogue: 0,0:11:44.20,0:11:45.20,Default,,0,0,0,,Керемет жауап
Dialogue: 0,0:11:45.70,0:11:48.37,Default,,0,0,0,,Дұрыс айтасың, мен саған екі сағыз қонжық беремін.
Dialogue: 0,0:11:48.66,0:11:49.58,Default,,0,0,0,,Сен басқа әлемнен келгеніңді айтасың ба?
Dialogue: 0,0:11:49.87,0:11:52.67,Default,,0,0,0,,Е-чанға да кішкене мочи беріңізші.
Dialogue: 0,0:11:52.87,0:11:53.83,Default,,0,0,0,,Сен басқа әлемнен келгеніңді айтасың ба?
Dialogue: 0,0:11:54.13,0:11:55.54,Default,,0,0,0,,Куникуни
Dialogue: 0,0:11:56.17,0:11:59.34,Default,,0,0,0,,Мен де сағыз жеп, патентті қалай алуға болатынын қарастырдым.
Dialogue: 0,0:11:59.42,0:12:00.55,Default,,0,0,0,,Керемет фестиваль
Dialogue: 0,0:12:01.09,0:12:02.63,Default,,0,0,0,,Капитан Экчан
Dialogue: 0,0:12:02.88,0:12:03.93,Default,,0,0,0,,Фестивальге не болды?
Dialogue: 0,0:12:04.47,0:12:07.39,Default,,0,0,0,,Тек өтініш беру үшін көп ақша қажет.
Dialogue: 0,0:12:08.18,0:12:09.77,Default,,0,0,0,,Оған жоғары баға қояды!
Dialogue: 0,0:12:10.31,0:12:11.39,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:12:11.48,0:12:15.69,Default,,0,0,0,,Патенттер мейірімді болмағандықтан, Экчан соғысы басталды.
Dialogue: 0,0:12:15.90,0:12:16.73,Default,,0,0,0,,Иә.
Dialogue: 0,0:12:16.82,0:12:21.78,Default,,0,0,0,,Сонымен, біз сізге патенттерді бізге ғашық етудің мейірімділігін көрсетеміз!
Dialogue: 0,0:12:22.40,0:12:24.24,Default,,0,0,0,,Патенттер өздеріне ұнайтын нәрсені жасайық!
Dialogue: 0,0:12:24.32,0:12:25.62,Default,,0,0,0,,Патенттерге мейірімді болыңыз!
Dialogue: 0,0:12:25.74,0:12:26.78,Default,,0,0,0,,...
Dialogue: 0,0:12:27.58,0:12:28.41,Default,,0,0,0,,Эккан
Dialogue: 0,0:12:28.54,0:12:29.62,Default,,0,0,0,,Сұрақ қою
Dialogue: 0,0:12:30.50,0:12:32.83,Default,,0,0,0,,Патенттерге қандай мейірімділік көрсетіледі?
Dialogue: 0,0:12:33.12,0:12:34.12,Default,,0,0,0,,Га
Dialogue: 0,0:12:34.46,0:12:35.83,Default,,0,0,0,,Хмм.
Dialogue: 0,0:12:36.88,0:12:40.80,Default,,0,0,0,,Бір жақты мейірім ренжітуі мүмкін
Dialogue: 0,0:12:41.80,0:12:43.13,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:12:43.84,0:12:46.60,Default,,0,0,0,,Сені маған ғашық ету үшін не істеуім керек?
Dialogue: 0,0:12:47.47,0:12:49.76,Default,,0,0,0,,Жарайды, фестивальде сынап көрейік.
Dialogue: 0,0:12:50.18,0:12:52.68,Default,,0,0,0,,Мен оны Экчанмен де тексеремін.
Dialogue: 0,0:12:53.19,0:12:54.73,Default,,0,0,0,,Иә Poppin Eye
Dialogue: 0,0:12:54.81,0:12:55.65,Default,,0,0,0,,«Түстен кейінге дейін тікелей эфир»
Dialogue: 0,0:12:56.31,0:12:57.36,Default,,0,0,0,,Экчан өтінемін
Dialogue: 0,0:12:57.44,0:12:58.27,Default,,0,0,0,,Зұлым орыннан қозғалмайды!
Dialogue: 0,0:12:58.90,0:12:59.73,Default,,0,0,0,,Иә фестиваль
Dialogue: 0,0:12:59.82,0:13:01.74,Default,,0,0,0,,Көгершін көлігі бақытты
Dialogue: 0,0:13:02.40,0:13:04.11,Default,,0,0,0,,Иә, бұл менікі.
Dialogue: 0,0:13:04.36,0:13:06.45,Default,,0,0,0,,Көздері бар Макаби Яй!
Dialogue: 0,0:13:08.33,0:13:09.16,Default,,0,0,0,,Эккан
Dialogue: 0,0:13:09.24,0:13:10.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:10.54,0:13:12.66,Default,,0,0,0,,Мен маңызды нәрсені түсіндім.
Dialogue: 0,0:13:12.87,0:13:13.75,Default,,0,0,0,,Не?
Dialogue: 0,0:13:14.33,0:13:17.29,Default,,0,0,0,,Маған Экчан басынан ұнады.
Dialogue: 0,0:13:18.17,0:13:19.29,Default,,0,0,0,,Мен де
Dialogue: 0,0:13:20.75,0:13:21.71,Default,,0,0,0,,Те…
Dialogue: 0,0:13:22.01,0:13:24.72,Default,,0,0,0,,Бұл сынақ емес...
Dialogue: 0,0:13:25.97,0:13:29.43,Default,,0,0,0,,Мейірімділіктің жалпы түрі бар ма?
Dialogue: 0,0:13:29.60,0:13:30.76,Default,,0,0,0,,Хмм.
Dialogue: 0,0:13:30.89,0:13:34.18,Default,,0,0,0,,Қиын кезде маған көмектесе алатыныңа қуаныштымын.
Dialogue: 0,0:13:34.64,0:13:37.40,Default,,0,0,0,,Адамдардың мәселесі әр түрлі.
Dialogue: 0,0:13:37.94,0:13:40.52,Default,,0,0,0,,Сәлемдесу жақсы ғой.
Dialogue: 0,0:13:40.77,0:13:43.49,Default,,0,0,0,,Бейтаныс адамдарға келгенде қорғанамын.
Dialogue: 0,0:13:43.90,0:13:45.03,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:13:45.57,0:13:46.40,Default,,0,0,0,,Шын мәнінде емес.
Dialogue: 0,0:13:46.61,0:13:47.45,Default,,0,0,0,,Осыншама ма?
Dialogue: 0,0:13:48.32,0:13:51.41,Default,,0,0,0,,Бейбітшілік бойынша Нобель сыйлығын жеңіп алуға біраз жақындадым.
Dialogue: 0,0:13:51.54,0:13:52.99,Default,,0,0,0,,Тағы да ойланайық
Dialogue: 0,0:13:54.50,0:13:58.08,Default,,0,0,0,,Дүние жүзінде бейбітшілікке жету үшін алдымен әлемді түсіну керек.
Dialogue: 0,0:13:58.46,0:14:01.88,Default,,0,0,0,,Мен әлі құдықтағы бақамын.
Dialogue: 0,0:14:02.63,0:14:05.97,Default,,0,0,0,,Бірақ құдықта бақа болмайтын адам бар ма?
Dialogue: 0,0:14:06.80,0:14:10.22,Default,,0,0,0,,Басқаша айтқанда, дүниенің бәрін білетін адам...
Dialogue: 0,0:14:10.39,0:14:13.18,Default,,0,0,0,,Сонымен, сіз де біз туралы білесіз бе?
Dialogue: 0,0:14:14.27,0:14:15.10,Default,,0,0,0,,Онда жоқ.
Dialogue: 0,0:14:15.43,0:14:16.31,Default,,0,0,0,,Онда жоқ.
Dialogue: 0,0:14:16.89,0:14:19.98,Default,,0,0,0,,Олай болса, бізді жеңу керек...
Dialogue: 0,0:14:20.06,0:14:22.77,Default,,0,0,0,,Олардың барлығы құдықтағы бақалар.
Dialogue: 0,0:14:22.94,0:14:25.11,Default,,0,0,0,,Жарайды, стратегияны өзгерту.
Dialogue: 0,0:14:25.24,0:14:27.95,Default,,0,0,0,,Мен құдық ішіндегі тыныштықты қорғауды шештім.
Dialogue: 0,0:14:28.20,0:14:28.78,Default,,0,0,0,,Иә
Dialogue: 0,0:14:29.20,0:14:31.91,Default,,0,0,0,,Құдықтағы тыныштық бүгін де сақталды.
Dialogue: 0,0:14:32.28,0:14:33.45,Default,,0,0,0,,Бұл Гокуро-сама.
Dialogue: 0,0:14:33.99,0:14:35.25,Default,,0,0,0,,Ертең кездескенше
Dialogue: 0,0:14:35.66,0:14:36.50,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:14:37.04,0:14:38.29,Default,,0,0,0,,А... сәл күте тұрыңыз.
Dialogue: 0,0:14:38.37,0:14:39.37,Default,,0,0,0,,Не?
Dialogue: 0,0:14:40.00,0:14:41.00,Default,,0,0,0,,Иә
Dialogue: 0,0:14:41.63,0:14:43.00,Default,,0,0,0,,Себебі біз тыныштықты сақтадық...
Dialogue: 0,0:14:43.50,0:14:45.30,Default,,0,0,0,,Нобель фестивалінің сыйлығы
Dialogue: 0,0:14:48.09,0:14:48.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:52.55,0:14:54.26,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:14:54.97,0:14:58.10,Default,,0,0,0,,Содан кейін мен бұл құдықтың ішін Экчан сияқты патенттеймін.
Dialogue: 0,0:14:58.18,0:14:59.48,Default,,0,0,0,,Сен басқа әлемнен келгеніңді айтасың ба?
Dialogue: 0,0:15:06.86,0:15:08.19,Default,,0,0,0,,Никура~
Dialogue: 0,0:15:09.28,0:15:10.74,Default,,0,0,0,,Тоңазытқышта...
Dialogue: 0,0:15:11.82,0:15:14.28,Default,,0,0,0,,Бұл ештеңе емес.
Dialogue: 0,0:15:14.41,0:15:16.66,Default,,0,0,0,,О, сәл күте тұрыңыз.
Dialogue: 0,0:15:17.29,0:15:18.75,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:15:19.12,0:15:21.54,Default,,0,0,0,,А... мынау ма?
Dialogue: 0,0:15:22.71,0:15:24.21,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:15:24.67,0:15:26.76,Default,,0,0,0,,Ах... Қайырлы таң.
Dialogue: 0,0:15:27.09,0:15:28.47,Default,,0,0,0,,Менің қарным ашты
Dialogue: 0,0:15:31.47,0:15:35.06,Default,,0,0,0,,Жарайды, дайын. Олай болса, Нагумо-сан, мен сенен бастайын ба?
Dialogue: 0,0:15:35.18,0:15:36.01,Default,,0,0,0,,Не?
Dialogue: 0,0:15:36.68,0:15:39.81,Default,,0,0,0,,Нагумо-сан қазір не киіп жүр?
Dialogue: 0,0:15:40.77,0:15:41.90,Default,,0,0,0,,Пижамалар.
Dialogue: 0,0:15:42.35,0:15:45.02,Default,,0,0,0,,Мен не кимеймін?
Dialogue: 0,0:15:45.77,0:15:46.82,Default,,0,0,0,,Пижама, солай ма?
Dialogue: 0,0:15:47.15,0:15:50.15,Default,,0,0,0,,Менде неге пижама жоқ екенін білесіз бе?
Dialogue: 0,0:15:50.78,0:15:52.41,Default,,0,0,0,,Түсіндім! Бұл ма?
Dialogue: 0,0:15:52.70,0:15:55.45,Default,,0,0,0,,Бұл дұрыс жауап (Нагумо) Бейн Бэйн...
Dialogue: 0,0:15:55.58,0:15:58.16,Default,,0,0,0,,Сол... Дыбысты ескерсек зияны жоқ.
Dialogue: 0,0:15:58.33,0:16:01.54,Default,,0,0,0,,Сен неге менің киімімді төмен түсіріп киіп жүрсің?
Dialogue: 0,0:16:01.62,0:16:03.50,Default,,0,0,0,,Бұл жаман идея емес, солай ма?
Dialogue: 0,0:16:03.58,0:16:07.00,Default,,0,0,0,,Ал, Никура-сан, алдымен сабыр ет.
Dialogue: 0,0:16:07.09,0:16:09.51,Default,,0,0,0,,Мен қандай шкафта тұрамын?
Dialogue: 0,0:16:09.59,0:16:11.26,Default,,0,0,0,,Bing Bing…
Dialogue: 0,0:16:11.47,0:16:14.30,Default,,0,0,0,,Иә, шынымен де мүлде ауырмайды.
Dialogue: 0,0:16:14.84,0:16:16.68,Default,,0,0,0,,Қызық, бұл не?
Dialogue: 0,0:16:17.01,0:16:20.73,Default,,0,0,0,,Енді ойлап отырсам, баяғыда арғы атамнан сұрап едім.
Dialogue: 0,0:16:20.85,0:16:22.56,Default,,0,0,0,,Сәлем! Әлі біткен жоқ!
Dialogue: 0,0:16:23.31,0:16:27.86,Default,,0,0,0,,Тиісті сильфондағы қатпарлардың тиісті мөлшерін сақтау арқылы
Dialogue: 0,0:16:28.07,0:16:31.36,Default,,0,0,0,,Харисенді дыбысқа қарамастан ауыртпай жасауға болады дейді.
Dialogue: 0,0:16:31.74,0:16:32.78,Default,,0,0,0,,Хмм.
Dialogue: 0,0:16:33.41,0:16:35.28,Default,,0,0,0,,Өте үлкен емес
Dialogue: 0,0:16:35.41,0:16:38.45,Default,,0,0,0,,Қағаз сапасы біршама... және тым қатты емес.
Dialogue: 0,0:16:38.95,0:16:42.29,Default,,0,0,0,,Ең бастысы, бұл әдіс ауыртпалықсыз соғу.
Dialogue: 0,0:16:42.37,0:16:43.79,Default,,0,0,0,,Жоқ... (Нагумо) О
Dialogue: 0,0:16:44.21,0:16:45.88,Default,,0,0,0,,Егер сіз шынымен ашулансаңыз...
Dialogue: 0,0:16:46.00,0:16:49.88,Default,,0,0,0,,Олар ауыр харисен жасап, бізді ұруы мүмкін еді.
Dialogue: 0,0:16:50.00,0:16:51.01,Default,,0,0,0,,Хмм
Dialogue: 0,0:16:51.59,0:16:54.84,Default,,0,0,0,,Бірақ Никура олай етпеді.
Dialogue: 0,0:16:54.97,0:16:56.80,Default,,0,0,0,,Сонымен, бұл...
Dialogue: 0,0:16:56.97,0:16:58.93,Default,,0,0,0,,Бұл бірге тұруға рұқсат етілгенін білдіре ме?
Dialogue: 0,0:16:59.01,0:17:00.31,Default,,0,0,0,,Бұл мейірімділік!
Dialogue: 0,0:17:00.72,0:17:02.93,Default,,0,0,0,,Қандай түсініксіз жауап.
Dialogue: 0,0:17:03.02,0:17:04.23,Default,,0,0,0,,Шокчуно!
Dialogue: 0,0:17:04.73,0:17:06.10,Default,,0,0,0,,Нагумо-сан бұл
Dialogue: 0,0:17:06.27,0:17:08.98,Default,,0,0,0,,Мұнда жүлде ақшасын ұсынатын турнирлер тізімі берілген.
Dialogue: 0,0:17:09.11,0:17:10.19,Default,,0,0,0,,Рахмет
Dialogue: 0,0:17:10.28,0:17:11.82,Default,,0,0,0,,Әрі қарай жүрме!
Dialogue: 0,0:17:12.24,0:17:14.24,Default,,0,0,0,,Бұл шынымен де ауырмайды.
Dialogue: 0,0:17:14.32,0:17:15.70,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:17:16.20,0:17:18.20,Default,,0,0,0,,Әр түрткенде мейірімділік беріледі.
Dialogue: 0,0:17:18.58,0:17:19.87,Default,,0,0,0,,Бұл ұят!
Dialogue: 0,0:17:20.49,0:17:21.33,Default,,0,0,0,,Ах
Dialogue: 0,0:17:21.91,0:17:23.29,Default,,0,0,0,,Бір сәтке бола аламын ба?
Dialogue: 0,0:17:23.66,0:17:25.67,Default,,0,0,0,,Қалағаныңызды жасаңыз...
Dialogue: 0,0:17:26.08,0:17:29.50,Default,,0,0,0,,Иә? Ой... эй, эй
Dialogue: 0,0:17:29.71,0:17:30.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:32.01,0:17:33.92,Default,,0,0,0,,Бұл...
Dialogue: 0,0:17:34.38,0:17:35.84,Default,,0,0,0,,Қазына картасы?
Dialogue: 0,0:17:37.09,0:17:41.43,Default,,0,0,0,,А, бұл карта жақын жердегі ғибадатханада ілінген.
Dialogue: 0,0:17:41.72,0:17:45.14,Default,,0,0,0,,Бұл еркелікті кім жасады?
Dialogue: 0,0:17:45.23,0:17:47.10,Default,,0,0,0,,Бұл Вако-сан емес пе?
Dialogue: 0,0:17:47.31,0:17:50.02,Default,,0,0,0,,Жоқ, бірақ неге барып қарап көрмеске?
Dialogue: 0,0:17:50.11,0:17:51.32,Default,,0,0,0,,Қызықты көрінеді
Dialogue: 0,0:17:51.48,0:17:53.86,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:17:55.11,0:17:56.95,Default,,0,0,0,,Сіз маған қиындық туғызып жатырсыз.
Dialogue: 0,0:17:57.86,0:18:00.12,Default,,0,0,0,,Жарайсыңдар! Мен оны лақтырып тастаймын ...
Dialogue: 0,0:18:01.66,0:18:02.66,Default,,0,0,0,,Қай жолмен?
Dialogue: 0,0:18:02.74,0:18:05.83,Default,,0,0,0,,Куу... Мм...
Dialogue: 0,0:18:05.91,0:18:08.00,Default,,0,0,0,,Уау! Бірге барайық!
Dialogue: 0,0:18:08.12,0:18:10.71,Default,,0,0,0,,Мен сенімен бірге барамын, бірақ осыны түсіндіруге рұқсат етіңіз!
Dialogue: 0,0:18:11.63,0:18:13.92,Default,,0,0,0,,Мен барлық қазынаны қалаймын!
Dialogue: 0,0:18:14.17,0:18:16.72,Default,,0,0,0,,Бұл таза елес...
Dialogue: 0,0:18:17.38,0:18:20.14,Default,,0,0,0,,Иә! Сонда мен олардың барлығын қалаймын!
Dialogue: 0,0:18:20.64,0:18:23.52,Default,,0,0,0,,Олай десеңіз, мен де соны қалаймын!
Dialogue: 0,0:18:23.97,0:18:25.35,Default,,0,0,0,,Жарайды, жарайды!
Dialogue: 0,0:18:25.85,0:18:27.85,Default,,0,0,0,,Сонда менің мұны істеуден басқа амалым жоқ деп ойлаймын.
Dialogue: 0,0:18:28.27,0:18:30.81,Default,,0,0,0,,Жарайсың ба? Бұл ғибадатхана.
Dialogue: 0,0:18:31.36,0:18:36.03,Default,,0,0,0,,Ереже: кез келген қулықты қолдануға болады, оны тапқан адам жеңеді.
Dialogue: 0,0:18:37.45,0:18:40.82,Default,,0,0,0,,Егер мен қазірден бастап бесті санасам, бастаған дұрыс па?
Dialogue: 0,0:18:40.95,0:18:41.78,Default,,0,0,0,,Иә
Dialogue: 0,0:18:41.87,0:18:42.70,Default,,0,0,0,,５！
Dialogue: 0,0:18:42.78,0:18:44.45,Default,,0,0,0,,Қолымнан келсе өлтіремін
Dialogue: 0,0:18:45.20,0:18:46.04,Default,,0,0,0,,４！
Dialogue: 0,0:18:46.12,0:18:48.21,Default,,0,0,0,,Егер сізде қандай да бір көлік болса...
Dialogue: 0,0:18:48.54,0:18:49.37,Default,,0,0,0,,３！
Dialogue: 0,0:18:49.46,0:18:50.96,Default,,0,0,0,,Оны алған менмін!
Dialogue: 0,0:18:51.29,0:18:52.13,Default,,0,0,0,,２！
Dialogue: 0,0:18:53.13,0:18:53.96,Default,,0,0,0,,１！
Dialogue: 0,0:18:55.09,0:18:57.01,Default,,0,0,0,,Жоқ! Нахахахаха
Dialogue: 0,0:18:57.47,0:18:59.13,Default,,0,0,0,,Енді әрі қарай жүрейік.
Dialogue: 0,0:18:59.30,0:19:01.47,Default,,0,0,0,,Бір минут күтіңіз! Бұл ақылсыз!
Dialogue: 0,0:19:01.55,0:19:02.55,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:19:02.64,0:19:05.14,Default,,0,0,0,,Сіз бәрі мүмкін десеңіз де, бұл дұрыс емес!
Dialogue: 0,0:19:05.93,0:19:07.48,Default,,0,0,0,,Иә? Солай ма?
Dialogue: 0,0:19:07.56,0:19:10.56,Default,,0,0,0,,Дұрыс! Қол кісен... Әй, болды ғой!
Dialogue: 0,0:19:10.69,0:19:12.44,Default,,0,0,0,,Бұл аздап қорқынышты! (Никкура) Дұрыс! Бұл дұрыс!
Dialogue: 0,0:19:12.86,0:19:14.90,Default,,0,0,0,,Мен мұны білмедім, кешіріңіз.
Dialogue: 0,0:19:15.36,0:19:16.99,Default,,0,0,0,,Ақымақ, кептеліп қал.
Dialogue: 0,0:19:17.07,0:19:19.11,Default,,0,0,0,,Кешіріңіз, Вако-сан, мен бірінші барамын.
Dialogue: 0,0:19:20.74,0:19:21.91,Default,,0,0,0,,Бұл өте ерекше!
Dialogue: 0,0:19:21.99,0:19:25.20,Default,,0,0,0,,Уау, бәрі алда.
Dialogue: 0,0:19:29.96,0:19:32.92,Default,,0,0,0,,Мен бірінші келдім. Уақытты өлтірейік.
Dialogue: 0,0:19:36.71,0:19:38.97,Default,,0,0,0,,Мизугумо жоқ джутсу~!
Dialogue: 0,0:19:47.14,0:19:50.73,Default,,0,0,0,,Уууууууууууууууоооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооо.
Dialogue: 0,0:19:50.81,0:19:51.98,Default,,0,0,0,,Керісінше, қанша адам қарғысқа ұшырап өлетінін болжау мүмкін емес.
Dialogue: 0,0:19:52.06,0:19:54.48,Default,,0,0,0,,Ооооооооо! О!
Dialogue: 0,0:19:54.56,0:19:58.11,Default,,0,0,0,,Ораораораораораораора...
Dialogue: 0,0:19:58.19,0:20:00.45,Default,,0,0,0,,Ораораораора... (Никкура) Охххх...
Dialogue: 0,0:20:00.53,0:20:02.07,Default,,0,0,0,,Оххх! (Нагумо) Ораораораора...
Dialogue: 0,0:20:02.16,0:20:04.53,Default,,0,0,0,,Ораораораораораораора…
Dialogue: 0,0:20:04.99,0:20:06.70,Default,,0,0,0,,Ораораораорара... (Никкура) Ах...
Dialogue: 0,0:20:06.78,0:20:11.96,Default,,0,0,0,,Уау! Ораораора Уау! (Никкура) Ууууууууу!
Dialogue: 0,0:20:12.04,0:20:13.46,Default,,0,0,0,,О!
Dialogue: 0,0:20:18.71,0:20:20.72,Default,,0,0,0,,Олар қосымша күш әкелді.
Dialogue: 0,0:20:20.80,0:20:21.88,Default,,0,0,0,,Охххх!
Dialogue: 0,0:20:21.97,0:20:23.05,Default,,0,0,0,,Ууууууу!
Dialogue: 0,0:20:23.13,0:20:24.51,Default,,0,0,0,,Уау! (Нагумо) Жоқ, жоқ, жоқ, жоқ
Dialogue: 0,0:20:24.64,0:20:27.14,Default,,0,0,0,,Ууууууу!
Dialogue: 0,0:20:28.64,0:20:30.35,Default,,0,0,0,,Адамдар өмір бойы жүрек тереңдерін өзгелерден жасырып өтеді.
Dialogue: 0,0:21:01.46,0:21:03.63,Default,,0,0,0,,Уа! Ооооооо!
Dialogue: 0,0:21:03.72,0:21:04.76,Default,,0,0,0,,Үй иесі!
Dialogue: 0,0:21:05.05,0:21:08.72,Default,,0,0,0,,Мен оны картада бұлай әдемі түсіреді деп күтпедім.
Dialogue: 0,0:21:08.85,0:21:09.64,Default,,0,0,0,,Жоқ
Dialogue: 0,0:21:09.93,0:21:12.77,Default,,0,0,0,,Баршаңызға еңбектеріңіз үшін рахмет.
Dialogue: 0,0:21:12.85,0:21:15.27,Default,,0,0,0,,Енді сізде қоқыс сақтайтын орын бар.
Dialogue: 0,0:21:15.35,0:21:16.77,Default,,0,0,0,,Қоқыс тесігі?
Dialogue: 0,0:21:16.90,0:21:17.77,Default,,0,0,0,,Хе-хе-хе.
Dialogue: 0,0:21:18.82,0:21:19.77,Default,,0,0,0,,Жалға алу
Dialogue: 0,0:21:20.40,0:21:21.73,Default,,0,0,0,,Аспаз Аспаз аспаз
Dialogue: 0,0:21:22.15,0:21:23.28,Default,,0,0,0,,Мен қатты қорқамын!
Dialogue: 0,0:21:25.45,0:21:26.57,Default,,0,0,0,,Ха~
Dialogue: 0,0:21:27.28,0:21:31.37,Default,,0,0,0,,Ұзақ атуды ұрып, маған өмір бойы жалға берілетін ақшаны беріңіз.
Dialogue: 0,0:21:31.45,0:21:33.62,Default,,0,0,0,,Мен көпіршіктерді үрлей алсам ғой.
Dialogue: 0,0:21:33.79,0:21:35.79,Default,,0,0,0,,Мен сізбен келісемін.
Dialogue: 0,0:21:35.92,0:21:38.33,Default,,0,0,0,,Мен сіздің әңгімеңізді естідім (Никкура) А...
Dialogue: 0,0:21:38.79,0:21:39.88,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:39.96,0:21:42.09,Default,,0,0,0,,Тағы да суға батты!
Dialogue: 0,0:21:43.05,0:21:46.59,Default,,0,0,0,,Енді екеуің көпіршіктерді үрлеуге жиналдыңдар.
Dialogue: 0,0:21:47.14,0:21:51.01,Default,,0,0,0,,Бір нәрсені бір-бірімен бөлісу өте жақсы.
Dialogue: 0,0:21:52.18,0:21:54.02,Default,,0,0,0,,Сіз оны таптыңыз, солай ма?
Dialogue: 0,0:21:54.60,0:21:56.94,Default,,0,0,0,,Өте жақсы қазына
Dialogue: 0,0:21:57.56,0:22:00.94,Default,,0,0,0,,Тоқта... қандай сұмдық жол дейсің?
Dialogue: 0,0:22:01.02,0:22:02.53,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:22:02.61,0:22:05.86,Default,,0,0,0,,Дұрыс. Сәлем Нагумо-сан.
Dialogue: 0,0:22:06.20,0:22:07.45,Default,,0,0,0,,Керемет емес пе?
Dialogue: 0,0:22:07.66,0:22:08.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:08.95,0:22:11.58,Default,,0,0,0,,Жақсы нәрсе айт, Изумивако.
Dialogue: 0,0:22:11.83,0:22:14.41,Default,,0,0,0,,Қазына көзге көрінетін нәрселерден де керемет
Dialogue: 0,0:22:14.79,0:22:15.62,Default,,0,0,0,,Иә
Dialogue: 0,0:22:15.71,0:22:18.92,Default,,0,0,0,,Бұны жаман жол деп айта алмайсың.
Dialogue: 0,0:22:19.00,0:22:20.79,Default,,0,0,0,,Рух толқыны ма?
Dialogue: 0,0:22:20.96,0:22:24.42,Default,,0,0,0,,Мен мұны жақсы әңгіме деп ойладым.
Dialogue: 0,0:22:24.84,0:22:25.88,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:22:26.34,0:22:31.10,Default,,0,0,0,,Олай болса, кемпір көпіршікті үрлей берсін!
Dialogue: 0,0:22:31.18,0:22:32.60,Default,,0,0,0,,О!
Dialogue: 0,0:22:32.68,0:22:37.94,Default,,0,0,0,,Алдымен... Үйіміздің осы айлық жалдау ақысын бәріміз төлейік!
Dialogue: 0,0:22:38.02,0:22:39.52,Default,,0,0,0,,О!
Dialogue: 0,0:22:39.73,0:22:41.73,Default,,0,0,0,,Жоқ! О, жоқ!
Dialogue: 0,0:22:47.70,0:22:48.99,Default,,0,0,0,,♪～
Dialogue: 0,0:22:49.11,0:22:52.53,Default,,0,0,0,,Мен таң қалдым! Маусым
Dialogue: 0,0:22:52.87,0:22:56.58,Default,,0,0,0,,Еш ойланбастан ерітіңіз
Dialogue: 0,0:22:57.12,0:23:01.04,Default,,0,0,0,,Қайнап жатқан көшемен жаяу Гойнон
Dialogue: 0,0:23:01.17,0:23:05.05,Default,,0,0,0,,Түс пе, әлде бір нәрсе ме, білмеймін
Dialogue: 0,0:23:05.17,0:23:08.72,Default,,0,0,0,,Шамадан тыс ұйықтаудан туындаған шымшу
Dialogue: 0,0:23:09.30,0:23:12.89,Default,,0,0,0,,Таң қалдыратын сараңдық та солай.
Dialogue: 0,0:23:13.43,0:23:17.35,Default,,0,0,0,,Бұл ұят және тітіркендіргіш.
Dialogue: 0,0:23:17.48,0:23:20.73,Default,,0,0,0,,Қазір оны жеудің ең жақсы уақыты сияқты.
Dialogue: 0,0:23:21.15,0:23:28.11,Default,,0,0,0,,Кәдімгідей болып көріну
Dialogue: 0,0:23:29.32,0:23:36.29,Default,,0,0,0,,Өткен жылғыдан басқа жаз.
Dialogue: 0,0:23:37.37,0:23:42.00,Default,,0,0,0,,Мәселе! Бірақ қызық
Dialogue: 0,0:23:45.63,0:23:50.09,Default,,0,0,0,,Сіз өзіңізсіз
Dialogue: 0,0:23:53.01,0:23:57.39,Default,,0,0,0,,Бұл қалада мысықтар да, шөміштер де жүгіреді
Dialogue: 0,0:23:57.77,0:24:00.56,Default,,0,0,0,,Мен де бүгін сенімен бірге болғым келеді
Dialogue: 0,0:24:00.77,0:24:07.73,Default,,0,0,0,,Шатырдың артына тығылған күн
Dialogue: 0,0:24:08.28,0:24:10.74,Default,,0,0,0,,Әй, жаз келе жатыр
Dialogue: 0,0:24:13.45,0:24:16.28,Default,,0,0,0,,～♪
Dialogue: 0,0:24:19.29,0:24:25.08,Default,,0,0,0,,Осаму Кидо қағып, күрес әдістерін кімнен үйренді?
Dialogue: 0,0:24:25.75,0:24:29.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:24:39.10,0:24:40.22,Default,,0,0,0,,Рико Изуми
Dialogue: 0,0:24:40.47,0:24:41.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:24:42.10,0:24:43.73,Default,,0,0,0,,Изуми мырза, Изуми мырза
Dialogue: 0,0:24:44.31,0:24:48.36,Default,,0,0,0,,Карл Готч Жауап Карл Готч
Dialogue: 0,0:24:48.82,0:24:49.65,Default,,0,0,0,,Уф
Dialogue: 0,0:24:50.11,0:24:51.86,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:24:52.40,0:24:56.28,Default,,0,0,0,,Ууууууууу...
Dialogue: 0,0:24:58.37,0:25:01.33,Default,,0,0,0,,Ха ха ха ха…
Dialogue: 0,0:25:02.62,0:25:03.58,Default,,0,0,0,,Шпион
Dialogue: 0,0:25:03.96,0:25:04.87,Default,,0,0,0,,Spi?
Dialogue: 0,0:25:05.12,0:25:06.46,Default,,0,0,0,,Жылдамдық
Dialogue: 0,0:25:07.75,0:25:08.79,Default,,0,0,0,,Ха! (Оқушылар) Ха!
Dialogue: 0,0:25:11.76,0:25:12.92,Default,,0,0,0,,Тара Адачи күткендей!
Dialogue: 0,0:25:13.01,0:25:14.93,Default,,0,0,0,,Нысанаға жынды болмай ұш
Dialogue: 0,0:25:15.01,0:25:16.30,Default,,0,0,0,,Дәл солай көрінеді
Dialogue: 0,0:25:16.39,0:25:18.14,Default,,0,0,0,,Қазіргі Уильям Тел
Dialogue: 0,0:25:18.47,0:25:21.22,Default,,0,0,0,,Қуануға әлі ерте! Изуми-сан...
Dialogue: 0,0:25:21.56,0:25:23.23,Default,,0,0,0,,Уау, уа, уа...
Dialogue: 0,0:25:23.31,0:25:26.31,Default,,0,0,0,,Ооооооо... ооо қалай? Та Та Та
Dialogue: 0,0:25:26.40,0:25:27.65,Default,,0,0,0,,Тұр!
Dialogue: 0,0:25:27.73,0:25:28.98,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:25:29.07,0:25:30.82,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:25:30.90,0:25:32.53,Default,,0,0,0,,Изуми! (Оқушылар) Ха!
Dialogue: 0,0:25:32.61,0:25:34.57,Default,,0,0,0,,Изуми! (Оқушылар) Ха!
Dialogue: 0,0:25:36.24,0:25:37.53,Default,,0,0,0,,Тара Адачи күткендей!
Dialogue: 0,0:25:37.62,0:25:40.37,Default,,0,0,0,,Қолдау сізге өте қажет кезде келеді.
Dialogue: 0,0:25:40.45,0:25:42.87,Default,,0,0,0,,Жүректі дәл соғу әрекеті
Dialogue: 0,0:25:42.95,0:25:45.29,Default,,0,0,0,,Бұл көрініс дәл...
Dialogue: 0,0:25:45.54,0:25:48.67,Default,,0,0,0,,Қазіргі заман Уильям Тел
Dialogue: 0,0:25:49.17,0:25:51.63,Default,,0,0,0,,А...эй (Наруко) Иә?
Dialogue: 0,0:25:51.71,0:25:53.63,Default,,0,0,0,,Бір минут күтіңіз (Могура) Не?
Dialogue: 0,0:25:54.01,0:25:55.13,Default,,0,0,0,,Жер бетінде кім...
Dialogue: 0,0:25:55.22,0:25:56.63,Default,,0,0,0,,Не? (Жидео) Не ​​болды?
Dialogue: 0,0:25:56.97,0:26:00.39,Default,,0,0,0,,Изуми-санның үстелінде! Бұл кім?
Dialogue: 0,0:26:03.43,0:26:07.23,Default,,0,0,0,,Будың көтерілуіне қарағанда, бұл кофе жаңадан қайнатылған.
Dialogue: 0,0:26:08.27,0:26:09.44,Default,,0,0,0,,Және бұл иіс
Dialogue: 0,0:26:09.65,0:26:11.32,Default,,0,0,0,,Гоку Гоку
Dialogue: 0,0:26:11.90,0:26:13.65,Default,,0,0,0,,Ал осы байлыққа келгенде...
Dialogue: 0,0:26:14.65,0:26:17.24,Default,,0,0,0,,Бұл тек бір адамда бар
Dialogue: 0,0:26:17.91,0:26:19.28,Default,,0,0,0,,Эй, дұрыс айтасың!
Dialogue: 0,0:26:19.78,0:26:21.58,Default,,0,0,0,,Кофе Тара Адачи!
Dialogue: 0,0:26:21.74,0:26:23.08,Default,,0,0,0,,Уильям Тел күткендей!
Dialogue: 0,0:26:23.49,0:26:26.00,Default,,0,0,0,,Кофені дәл өзіңіз қалаған жерде дайындау әрекеті.
Dialogue: 0,0:26:26.12,0:26:27.96,Default,,0,0,0,,Қазіргі заманғы Уильям Тел
Dialogue: 0,0:26:28.04,0:26:28.62,Default,,0,0,0,,♬~
Dialogue: 0,0:26:28.92,0:26:31.67,Default,,0,0,0,,Дегенмен, бұл кофе сөзсіз заң бұзушылық болып табылады!
Dialogue: 0,0:26:31.84,0:26:33.00,Default,,0,0,0,,Сіз өте көп ақша беріп жатырсыз!
Dialogue: 0,0:26:33.42,0:26:34.51,Default,,0,0,0,,Ұстаз!
Dialogue: 0,0:26:35.05,0:26:38.26,Default,,0,0,0,,Фу Ұйқысы қашқан бір оқушыны қорғау үшін...
Dialogue: 0,0:26:38.47,0:26:41.47,Default,,0,0,0,,Бүкіл сынып шуылдап жатыр
Dialogue: 0,0:26:42.01,0:26:43.22,Default,,0,0,0,,Уф...
Dialogue: 0,0:26:44.27,0:26:45.18,Default,,0,0,0,,Иә
Dialogue: 0,0:26:46.39,0:26:49.48,Default,,0,0,0,,Келесі сынақ сәл қатаңырақ болады.
Dialogue: 0,0:26:50.02,0:26:51.31,Default,,0,0,0,,Оның жағдайын бақылап отыру үшін толықтай орнығып қалғанша ауруханада жатқаны дұрыс болар еді.
Dialogue: 0,0:26:52.52,0:26:54.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:26:54.78,0:26:56.99,Default,,0,0,0,,Уау!
Dialogue: 0,0:26:57.07,0:26:57.65,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:26:57.65,0:27:01.41,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:26:57.65,0:27:01.41,Default,,0,0,0,,Қуаныштан соңғы қоңырау соғылды.
Dialogue: 0,0:27:01.41,0:27:02.45,Default,,0,0,0,,Қуаныштан соңғы қоңырау соғылды.
Dialogue: 0,0:27:02.53,0:27:06.87,Default,,0,0,0,,Уау! Апыр-ай! Апыр-ай!
Dialogue: 0,0:27:06.95,0:27:10.00,Default,,0,0,0,,Уау!
Dialogue: 0,0:27:11.50,0:27:17.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory