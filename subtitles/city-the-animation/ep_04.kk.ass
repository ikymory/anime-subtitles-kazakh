Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.33,0:00:05.29,Default,,0,0,0,,Бұрын... қонудағы сол күлкі.
Dialogue: 0,0:00:05.84,0:00:09.00,Default,,0,0,0,,Изуми мырза мен туралы ойлайтын шығар...
Dialogue: 0,0:00:18.47,0:00:19.47,Default,,0,0,0,,Әй
Dialogue: 0,0:00:20.77,0:00:21.60,Default,,0,0,0,,Хмм
Dialogue: 0,0:00:22.81,0:00:26.73,Default,,0,0,0,,Иә? Изуми-сан, үйге осында бара жатырсың ба?
Dialogue: 0,0:00:28.15,0:00:30.36,Default,,0,0,0,,Бұл кездейсоқтық, мен де осындамын!
Dialogue: 0,0:00:30.74,0:00:31.86,Default,,0,0,0,,Ахаха
Dialogue: 0,0:00:31.99,0:00:34.07,Default,,0,0,0,,(Тачиваку жүрек соғу дыбысы)
Dialogue: 0,0:00:34.07,0:00:35.53,Default,,0,0,0,,(Тачиваку жүрек соғу дыбысы)
Dialogue: 0,0:00:34.07,0:00:35.53,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:35.53,0:00:35.66,Default,,0,0,0,,(Тачиваку жүрек соғу дыбысы)
Dialogue: 0,0:00:35.66,0:00:37.62,Default,,0,0,0,,(Тачиваку жүрек соғу дыбысы)
Dialogue: 0,0:00:35.66,0:00:37.62,Default,,0,0,0,,А... білесің.
Dialogue: 0,0:00:37.74,0:00:38.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:39.24,0:00:40.83,Default,,0,0,0,,А... жоқ...
Dialogue: 0,0:00:41.33,0:00:42.50,Default,,0,0,0,,Ештеңе
Dialogue: 0,0:00:43.71,0:00:46.71,Default,,0,0,0,,Мен бұған ешқашан жол бермеймін, иә?
Dialogue: 0,0:00:46.83,0:00:51.46,Default,,0,0,0,,(Тачиваку жүрек соғу дыбысы)
Dialogue: 0,0:00:52.17,0:00:53.09,Default,,0,0,0,,Ммм аа
Dialogue: 0,0:00:53.51,0:00:57.14,Default,,0,0,0,,Ах... Ах
Dialogue: 0,0:00:57.60,0:00:58.72,Default,,0,0,0,,Угю... Уф
Dialogue: 0,0:00:59.97,0:01:01.68,Default,,0,0,0,,А... білесің.
Dialogue: 0,0:01:03.27,0:01:04.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:04.48,0:01:05.48,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:05.73,0:01:07.27,Default,,0,0,0,,Ах! Ештеңе етпейді!
Dialogue: 0,0:01:08.02,0:01:11.90,Default,,0,0,0,,Бұл күлімсіреу... бұл сөзсіз...
Dialogue: 0,0:01:12.44,0:01:15.61,Default,,0,0,0,,Мен сені жақсы көремін!
Dialogue: 0,0:01:16.36,0:01:18.12,Default,,0,0,0,,♪～
Dialogue: 0,0:01:18.24,0:01:21.24,Default,,0,0,0,,Сәлеметсіздер ме, қымбатты достарым
Dialogue: 0,0:01:21.54,0:01:24.12,Default,,0,0,0,,Маған армандарың туралы айтып бер
Dialogue: 0,0:01:24.29,0:01:29.21,Default,,0,0,0,,Сол күндер есіңізде ме?
Dialogue: 0,0:01:30.59,0:01:36.51,Default,,0,0,0,,Ересек болу қиын, солай емес пе?
Dialogue: 0,0:01:36.63,0:01:43.27,Default,,0,0,0,,Жасырылған нәрсені табайық.
Dialogue: 0,0:01:44.64,0:01:45.64,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:01:54.36,0:02:00.32,Default,,0,0,0,,Өзіңіздің беймаза ойыңызды тастаңыз
Dialogue: 0,0:02:00.49,0:02:03.33,Default,,0,0,0,,Бұлттар жүзіп келеді
Dialogue: 0,0:02:03.45,0:02:07.37,Default,,0,0,0,,Жоғары қарап, секір!
Dialogue: 0,0:02:08.33,0:02:11.21,Default,,0,0,0,,Жаңбыр басылды
Dialogue: 0,0:02:11.42,0:02:14.38,Default,,0,0,0,,Ән айту
Dialogue: 0,0:02:14.59,0:02:17.97,Default,,0,0,0,,Қол ұстасу
Dialogue: 0,0:02:20.76,0:02:23.68,Default,,0,0,0,,Мен күлдім
Dialogue: 0,0:02:23.81,0:02:26.85,Default,,0,0,0,,Сен де күлесің
Dialogue: 0,0:02:26.98,0:02:30.23,Default,,0,0,0,,Әрине ұнайды
Dialogue: 0,0:02:30.35,0:02:36.19,Default,,0,0,0,,Тағы кездесейік
Dialogue: 0,0:02:42.74,0:02:45.12,Default,,0,0,0,,～♪
Dialogue: 0,0:02:47.54,0:02:48.96,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:02:49.37,0:02:50.71,Default,,0,0,0,,Жеткізу
Dialogue: 0,0:02:51.08,0:02:51.92,Default,,0,0,0,,Ах
Dialogue: 0,0:02:52.84,0:02:54.38,Default,,0,0,0,,Ой ой ой
Dialogue: 0,0:02:57.34,0:02:59.05,Default,,0,0,0,,Тағы да әуеніңді бұздың! Қанша рет айтуым керек саған түсіну үшін!—
Dialogue: 0,0:02:59.43,0:03:02.60,Default,,0,0,0,,Бұл адам өте жақсы болды, солай емес пе?
Dialogue: 0,0:03:02.85,0:03:07.27,Default,,0,0,0,,Ха! Бастық та алаңдап, өзінен бұрынғы Танабе мырзаны шақырды.
Dialogue: 0,0:03:07.39,0:03:09.18,Default,,0,0,0,,«Ол өте жақсы»
Dialogue: 0,0:03:09.85,0:03:13.52,Default,,0,0,0,,Иә, мен сізге жеке сыйлық беремін деп ойлаймын.
Dialogue: 0,0:03:14.19,0:03:17.86,Default,,0,0,0,,Иә, дұрыс, бұл мен жасаған постер.
Dialogue: 0,0:03:18.32,0:03:19.15,Default,,0,0,0,,Ол солай деді.
Dialogue: 0,0:03:19.24,0:03:20.86,Default,,0,0,0,,Керемет Танабе мырза
Dialogue: 0,0:03:21.53,0:03:23.41,Default,,0,0,0,,Айтпақшы, мен оны ұстап алсам, жүлдесі қандай?
Dialogue: 0,0:03:23.62,0:03:25.24,Default,,0,0,0,,Ха! Ешқайсысы жоқ
Dialogue: 0,0:03:25.87,0:03:27.08,Default,,0,0,0,,Жалықтырғыш
Dialogue: 0,0:03:29.04,0:03:30.00,Default,,0,0,0,,Цучиноко ше?
Dialogue: 0,0:03:30.08,0:03:32.96,Default,,0,0,0,,Ха! Бас офицер де алаңдап, маған айтты...
Dialogue: 0,0:03:33.42,0:03:35.13,Default,,0,0,0,,Әдетте олар болмады.
Dialogue: 0,0:03:35.34,0:03:36.30,Default,,0,0,0,,Хмм.
Dialogue: 0,0:03:36.71,0:03:37.55,Default,,0,0,0,,Ах
Dialogue: 0,0:03:38.26,0:03:39.13,Default,,0,0,0,,Фуфу
Dialogue: 0,0:03:39.88,0:03:40.76,Default,,0,0,0,,Мен қайтып келдім!
Dialogue: 0,0:03:40.93,0:03:41.93,Default,,0,0,0,,Зузу!
Dialogue: 0,0:03:42.30,0:03:44.97,Default,,0,0,0,,Ооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооо(жақсы жігіт) Зузузуу
Dialogue: 0,0:03:45.51,0:03:48.31,Default,,0,0,0,,Батыс мейрамханасында тіпті соба кеспесі болады деп ойламаппын.
Dialogue: 0,0:03:48.43,0:03:49.68,Default,,0,0,0,,Бұл өте дәмді!
Dialogue: 0,0:03:49.93,0:03:51.35,Default,,0,0,0,,Міне!
Dialogue: 0,0:03:51.44,0:03:53.94,Default,,0,0,0,,Мен тамақтың барлық түріне жаттықтым.
Dialogue: 0,0:03:54.44,0:03:56.69,Default,,0,0,0,,Айтсаңыз, мен бәрін жасаймын!
Dialogue: 0,0:03:56.82,0:03:58.90,Default,,0,0,0,,Гахахахаха (жақсы адам) Каккаккакка
Dialogue: 0,0:03:59.07,0:04:01.90,Default,,0,0,0,,Адам мақтауға лайықты...
Dialogue: 0,0:04:04.99,0:04:06.37,Default,,0,0,0,,О... (Нагумо) Ооо!
Dialogue: 0,0:04:06.45,0:04:07.87,Default,,0,0,0,,Бұл тұзақ па?
Dialogue: 0,0:04:07.99,0:04:11.21,Default,,0,0,0,,Ах... ахах... жоқ... нахахаха
Dialogue: 0,0:04:11.33,0:04:13.08,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:04:13.17,0:04:16.17,Default,,0,0,0,,Ах! Бұл дұрыс! Мен сыйлық бергім келеді.
Dialogue: 0,0:04:16.25,0:04:19.55,Default,,0,0,0,,Өйткені ол жақсы адам, деді шенеунік.
Dialogue: 0,0:04:19.96,0:04:22.05,Default,,0,0,0,,Танабе мырза... солай ма?
Dialogue: 0,0:04:22.51,0:04:23.38,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:24.09,0:04:26.18,Default,,0,0,0,,Ммм (жақсы адам) Мен...
Dialogue: 0,0:04:26.64,0:04:30.39,Default,,0,0,0,,Мен мойындауға лайық ештеңе істеген жоқпын.
Dialogue: 0,0:04:30.93,0:04:34.35,Default,,0,0,0,,Сондықтан мен Танабе мырзадан қашып жүрмін.
Dialogue: 0,0:04:34.94,0:04:39.27,Default,,0,0,0,,Ештеңе істемегені үшін марапат алу біртүрлі емес пе?
Dialogue: 0,0:04:39.78,0:04:43.28,Default,,0,0,0,,Бірақ мен бұл сезімге өте қуаныштымын.
Dialogue: 0,0:04:43.36,0:04:47.03,Default,,0,0,0,,Мен Танабе мырзамен кездескенде жақсылығымды қайтаруды ойлап жүрмін.
Dialogue: 0,0:04:48.74,0:04:51.95,Default,,0,0,0,,«Мен бұл сезімге ризамын, сондықтан мен жүлдені жеңіп алдым».
Dialogue: 0,0:04:52.20,0:04:56.58,Default,,0,0,0,,Күрсін... Ештеңе істемесем де беріп жатырмын.
Dialogue: 0,0:04:57.33,0:05:01.17,Default,,0,0,0,,Сіз «дәмді тағам үшін сыйлық» аласыз
Dialogue: 0,0:05:01.30,0:05:02.92,Default,,0,0,0,,Дарынды
Dialogue: 0,0:05:03.72,0:05:05.55,Default,,0,0,0,,Сізге... (Нагумо) Ха!
Dialogue: 0,0:05:06.34,0:05:07.55,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:05:07.72,0:05:08.68,Default,,0,0,0,,Буф! Күшік
Dialogue: 0,0:05:08.76,0:05:11.72,Default,,0,0,0,,Сәлем! Жақсы адам болса, бірдеңе болар еді!
Dialogue: 0,0:05:12.10,0:05:14.81,Default,,0,0,0,,Хахаха кешіріңіз, мен шұбармын
Dialogue: 0,0:05:15.77,0:05:19.52,Default,,0,0,0,,Мен жақсы адам сияқты әрекет етуге тырыспаймын.
Dialogue: 0,0:05:19.69,0:05:21.11,Default,,0,0,0,,Каккаккака
Dialogue: 0,0:05:21.23,0:05:22.69,Default,,0,0,0,,Кюби Кюби Кюкю
Dialogue: 0,0:05:22.82,0:05:24.19,Default,,0,0,0,,Тонг Чарин
Dialogue: 0,0:05:24.70,0:05:27.66,Default,,0,0,0,,Мен қайтамын...
Dialogue: 0,0:05:33.83,0:05:40.84,Default,,0,0,0,,Аа, бұл Толератор~ шығар
Dialogue: 0,0:05:40.96,0:05:41.96,Default,,0,0,0,,Хаха
Dialogue: 0,0:05:43.38,0:05:45.47,Default,,0,0,0,,Өте жақсы адам!
Dialogue: 0,0:05:45.76,0:05:47.93,Default,,0,0,0,,Жарайсың!
Dialogue: 0,0:05:57.56,0:05:59.77,Default,,0,0,0,,Иә? дүкен қараңғы
Dialogue: 0,0:06:01.90,0:06:03.40,Default,,0,0,0,,Әке
Dialogue: 0,0:06:03.73,0:06:05.24,Default,,0,0,0,,Фестиваль
Dialogue: 0,0:06:06.74,0:06:08.36,Default,,0,0,0,,Ешкім жоқ па?
Dialogue: 0,0:06:08.61,0:06:10.49,Default,,0,0,0,,(шу)
Dialogue: 0,0:06:11.41,0:06:12.70,Default,,0,0,0,,А... а...
Dialogue: 0,0:06:13.24,0:06:15.66,Default,,0,0,0,,Уф... иә... иә...
Dialogue: 0,0:06:16.08,0:06:17.66,Default,,0,0,0,,Онда біреу бар ма?
Dialogue: 0,0:06:20.25,0:06:21.17,Default,,0,0,0,,Ой, иә...
Dialogue: 0,0:06:21.17,0:06:22.50,Default,,0,0,0,,Ой, иә...
Dialogue: 0,0:06:21.17,0:06:22.50,Default,,0,0,0,,(Тачиваку жүрек соғу дыбысы)
Dialogue: 0,0:06:22.50,0:06:22.63,Default,,0,0,0,,(Тачиваку жүрек соғу дыбысы)
Dialogue: 0,0:06:22.63,0:06:23.50,Default,,0,0,0,,(Тачиваку жүрек соғу дыбысы)
Dialogue: 0,0:06:22.63,0:06:23.50,Default,,0,0,0,,Ішек
Dialogue: 0,0:06:23.50,0:06:23.80,Default,,0,0,0,,(Тачиваку жүрек соғу дыбысы)
Dialogue: 0,0:06:23.80,0:06:25.30,Default,,0,0,0,,(Тачиваку жүрек соғу дыбысы)
Dialogue: 0,0:06:23.80,0:06:25.30,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:06:25.30,0:06:26.22,Default,,0,0,0,,(Тачиваку жүрек соғу дыбысы)
Dialogue: 0,0:06:26.59,0:06:28.63,Default,,0,0,0,,Өтінемін... (Тачивата) Уау! Ха!
Dialogue: 0,0:06:28.76,0:06:31.14,Default,,0,0,0,,Таң қалмай тыңдауларыңызды қалаймын.
Dialogue: 0,0:06:31.26,0:06:32.30,Default,,0,0,0,,А... а...
Dialogue: 0,0:06:32.39,0:06:35.77,Default,,0,0,0,,Мен... Мен болашақтан келген сенмін.
Dialogue: 0,0:06:36.02,0:06:37.14,Default,,0,0,0,,Иә!?
Dialogue: 0,0:06:37.77,0:06:38.94,Default,,0,0,0,,Тоқта... қандай дәлел!?
Dialogue: 0,0:06:39.02,0:06:41.52,Default,,0,0,0,,16 жас А типті Козерог
Dialogue: 0,0:06:41.61,0:06:43.86,Default,,0,0,0,,Менің оң иығымда екі мең бар.
Dialogue: 0,0:06:43.94,0:06:45.07,Default,,0,0,0,,Бар болғаны...
Dialogue: 0,0:06:45.15,0:06:48.45,Default,,0,0,0,,Менің де ішкі жамбасымда Орион шоқжұлдызындағы мең бар.
Dialogue: 0,0:06:48.53,0:06:51.82,Default,,0,0,0,,Жоқ! Сонымен, сіздің сүйікті тағамыңыз қандай?
Dialogue: 0,0:06:56.04,0:06:57.70,Default,,0,0,0,,Ибуригакко
Dialogue: 0,0:06:58.54,0:06:59.96,Default,,0,0,0,,Мен бе?
Dialogue: 0,0:07:00.37,0:07:01.29,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:07:01.38,0:07:02.50,Default,,0,0,0,,Бұл шынымен мен бе?
Dialogue: 0,0:07:02.63,0:07:03.71,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:07:04.42,0:07:08.42,Default,,0,0,0,,Бұл сіздің болашақ тұлғаңыз кез келген сұраққа жауап бере алады дегенді білдіре ме?
Dialogue: 0,0:07:08.63,0:07:10.01,Default,,0,0,0,,Әрине.
Dialogue: 0,0:07:10.34,0:07:12.22,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:12.64,0:07:13.47,Default,,0,0,0,,Әй!
Dialogue: 0,0:07:13.72,0:07:15.64,Default,,0,0,0,,Мен қашан қыз аламын?
Dialogue: 0,0:07:16.60,0:07:18.93,Default,,0,0,0,,Қашан екенін анықтау мүмкін емес
Dialogue: 0,0:07:19.02,0:07:22.19,Default,,0,0,0,,Қараңдар! Алданбаңыз! Сен кімсің!?
Dialogue: 0,0:07:22.56,0:07:24.19,Default,,0,0,0,,Бірақ мен сізді сендіруге рұқсат етіңіз
Dialogue: 0,0:07:24.69,0:07:26.36,Default,,0,0,0,,Ол алады
Dialogue: 0,0:07:26.65,0:07:28.74,Default,,0,0,0,,Ах... е...
Dialogue: 0,0:07:29.70,0:07:30.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:30.82,0:07:32.78,Default,,0,0,0,,Ол алады
Dialogue: 0,0:07:33.45,0:07:35.83,Default,,0,0,0,,Олай болса, келесі сұраққа көшейік.
Dialogue: 0,0:07:36.03,0:07:36.95,Default,,0,0,0,,Жоқ, өмірден бас тартпа
Dialogue: 0,0:07:37.08,0:07:40.41,Default,,0,0,0,,Күте тұрыңыз... Менің ойымша, сіз шынымен қиыншылықтасыз...
Dialogue: 0,0:07:40.54,0:07:42.96,Default,,0,0,0,,Екі сұрақ қалды.
Dialogue: 0,0:07:44.08,0:07:48.21,Default,,0,0,0,,Егер сіз әрі қарай жауап берсеңіз, сізді ғарыш-уақыт туралы бұйрық ұстайды.
Dialogue: 0,0:07:48.46,0:07:50.84,Default,,0,0,0,,Ал... бұл рас сияқты.
Dialogue: 0,0:07:51.43,0:07:55.18,Default,,0,0,0,,Бірақ тас көпірден аса сақтықсыз өтуге болады.
Dialogue: 0,0:07:56.01,0:07:58.14,Default,,0,0,0,,Жарайды, келесі сұрақ.
Dialogue: 0,0:07:59.43,0:08:01.89,Default,,0,0,0,,А... Оның аты кім?
Dialogue: 0,0:08:03.27,0:08:04.19,Default,,0,0,0,,Сіз Рико Изумисіз бе?
Dialogue: 0,0:08:04.19,0:08:05.98,Default,,0,0,0,,Сіз Рико Изумисіз бе?
Dialogue: 0,0:08:04.19,0:08:05.98,Default,,0,0,0,,(Тачиваку жүрек соғу дыбысы)
Dialogue: 0,0:08:05.98,0:08:06.44,Default,,0,0,0,,(Тачиваку жүрек соғу дыбысы)
Dialogue: 0,0:08:06.44,0:08:07.27,Default,,0,0,0,,(Тачиваку жүрек соғу дыбысы)
Dialogue: 0,0:08:06.44,0:08:07.27,Default,,0,0,0,,Хмм
Dialogue: 0,0:08:07.27,0:08:07.77,Default,,0,0,0,,(Тачиваку жүрек соғу дыбысы)
Dialogue: 0,0:08:07.77,0:08:09.86,Default,,0,0,0,,(Тачиваку жүрек соғу дыбысы)
Dialogue: 0,0:08:07.77,0:08:09.86,Default,,0,0,0,,Оның аты...
Dialogue: 0,0:08:09.86,0:08:09.99,Default,,0,0,0,,(Тачиваку жүрек соғу дыбысы)
Dialogue: 0,0:08:09.99,0:08:11.20,Default,,0,0,0,,(Тачиваку жүрек соғу дыбысы)
Dialogue: 0,0:08:09.99,0:08:11.20,Default,,0,0,0,,А... уф
Dialogue: 0,0:08:11.20,0:08:11.49,Default,,0,0,0,,Иа... хмм.
Dialogue: 0,0:08:12.03,0:08:14.11,Default,,0,0,0,,Рикода Изуми
Dialogue: 0,0:08:14.36,0:08:16.03,Default,,0,0,0,,Бұл шын!
Dialogue: 0,0:08:16.78,0:08:18.37,Default,,0,0,0,,Ку… кукуку… га…
Dialogue: 0,0:08:19.16,0:08:21.37,Default,,0,0,0,,Сонымен... соңғы сұрақ.
Dialogue: 0,0:08:21.46,0:08:24.00,Default,,0,0,0,,О, мен кез келген нәрсеге жауап беремін.
Dialogue: 0,0:08:24.75,0:08:28.13,Default,,0,0,0,,Мен футболшы ретінде болашақта не боламын?
Dialogue: 0,0:08:29.30,0:08:30.76,Default,,0,0,0,,Жапония... (Тачиваку) Иә?
Dialogue: 0,0:08:32.47,0:08:33.47,Default,,0,0,0,,Өкіл
Dialogue: 0,0:08:34.22,0:08:36.89,Default,,0,0,0,,Рахмет... менің болашақ өзім
Dialogue: 0,0:08:40.22,0:08:42.98,Default,,0,0,0,,Не... Құдай-ау...
Dialogue: 0,0:08:44.48,0:08:46.10,Default,,0,0,0,,Әжеміздің бір ескі танысы шығар. Ах, дұрыс.
Dialogue: 0,0:08:46.31,0:08:49.23,Default,,0,0,0,,Болашақ өзін
Dialogue: 0,0:08:49.61,0:08:51.15,Default,,0,0,0,,Бұл менің әкем.
Dialogue: 0,0:08:55.91,0:08:57.20,Default,,0,0,0,,Хотака
Dialogue: 0,0:08:57.62,0:09:00.33,Default,,0,0,0,,Менің аяғым қашан жазылады?
Dialogue: 0,0:09:00.45,0:09:02.04,Default,,0,0,0,,Ха, жас ханым.
Dialogue: 0,0:09:02.62,0:09:07.83,Default,,0,0,0,,Мен мұны күнде жүздеген рет айттым, бірақ бір ай ғана қалды.
Dialogue: 0,0:09:08.79,0:09:09.84,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:10.84,0:09:14.34,Default,,0,0,0,,Хотака, қызықты нәрсе бар ма?
Dialogue: 0,0:09:17.34,0:09:18.35,Default,,0,0,0,,Бірдеңе?
Dialogue: 0,0:09:18.47,0:09:19.85,Default,,0,0,0,,Бұл сегізаяқ.
Dialogue: 0,0:09:20.39,0:09:22.98,Default,,0,0,0,,Рахмет, мен біраз тынышталдым.
Dialogue: 0,0:09:23.18,0:09:24.02,Default,,0,0,0,,Га
Dialogue: 0,0:09:24.69,0:09:30.36,Default,,0,0,0,,Әй... Бірақ көңілім толмайды, күрсінбеске амалым жоқ.
Dialogue: 0,0:09:31.02,0:09:35.82,Default,,0,0,0,,Сіз қалай ойлайсыз? Неліктен «тым жақсы адам» іздеуді қайта бастауға болмайды?
Dialogue: 0,0:09:35.95,0:09:40.03,Default,,0,0,0,,Иә, дұрыс, бұл бір нұсқа.
Dialogue: 0,0:09:40.62,0:09:43.54,Default,,0,0,0,,Хотака Менің аяғым қашан жазылады...
Dialogue: 0,0:09:43.66,0:09:45.62,Default,,0,0,0,,(Желдің екпіні)
Dialogue: 0,0:09:48.63,0:09:49.46,Default,,0,0,0,,Әй!
Dialogue: 0,0:10:01.10,0:10:01.93,Default,,0,0,0,,Уф
Dialogue: 0,0:10:03.22,0:10:06.69,Default,,0,0,0,,Жеткізу сапарынан оралғаныма қуаныштымын! Мен оны осында қалдырамын!
Dialogue: 0,0:10:09.15,0:10:12.07,Default,,0,0,0,,Хотака Біз ол адамды марапаттаймыз!
Dialogue: 0,0:10:12.23,0:10:13.07,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:14.40,0:10:17.53,Default,,0,0,0,,Хотаканы басып алу тізбегі!
Dialogue: 0,0:10:19.11,0:10:19.95,Default,,0,0,0,,На
Dialogue: 0,0:10:20.28,0:10:21.12,Default,,0,0,0,,Уау
Dialogue: 0,0:10:22.62,0:10:23.49,Default,,0,0,0,,Абуне!
Dialogue: 0,0:10:27.33,0:10:27.96,Default,,0,0,0,,Әй
Dialogue: 0,0:10:28.17,0:10:30.67,Default,,0,0,0,,А~е~! (Нагумо) Уау
Dialogue: 0,0:10:30.79,0:10:33.21,Default,,0,0,0,,Сасако~! ! (Нагумо) Ха!
Dialogue: 0,0:10:34.17,0:10:35.01,Default,,0,0,0,,Ах… «C» рейтингі
Dialogue: 0,0:10:35.96,0:10:37.38,Default,,0,0,0,,Ху (Сасако) дөңгелек және дөңгелек дөңгелек және дөңгелек
Dialogue: 0,0:10:37.63,0:10:38.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:38.80,0:10:41.97,Default,,0,0,0,,Бұл не болып жатыр!?
Dialogue: 0,0:10:45.27,0:10:46.48,Default,,0,0,0,,Мм...
Dialogue: 0,0:10:48.81,0:10:51.27,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:10:51.36,0:10:54.32,Default,,0,0,0,,Мен кешірім сұраймын.
Dialogue: 0,0:10:57.40,0:10:58.40,Default,,0,0,0,,Чаассу
Dialogue: 0,0:10:59.24,0:11:01.78,Default,,0,0,0,,Мен табақты алуға келдім. иә?
Dialogue: 0,0:11:02.37,0:11:03.91,Default,,0,0,0,,Ой ой ой
Dialogue: 0,0:11:05.04,0:11:06.33,Default,,0,0,0,,Коля деген не?
Dialogue: 0,0:11:13.79,0:11:15.21,Default,,0,0,0,,Мен келдім!
Dialogue: 0,0:11:15.80,0:11:17.38,Default,,0,0,0,,Еңбектеріңіз үшін рахмет.
Dialogue: 0,0:11:17.51,0:11:18.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:19.47,0:11:23.35,Default,,0,0,0,,Не деген ұят! Мақсат дерлік шешілді.
Dialogue: 0,0:11:23.80,0:11:25.56,Default,,0,0,0,,А... Мен соны көруге келдім.
Dialogue: 0,0:11:26.10,0:11:29.27,Default,,0,0,0,,Жарайды, өмір осылай қайта-қайта.
Dialogue: 0,0:11:29.68,0:11:31.98,Default,,0,0,0,,Тірі болу мені кішкентай сезінеді...
Dialogue: 0,0:11:32.56,0:11:33.86,Default,,0,0,0,,Уайымдамаңыз!
Dialogue: 0,0:11:39.78,0:11:40.65,Default,,0,0,0,,Хмм
Dialogue: 0,0:11:44.41,0:11:45.53,Default,,0,0,0,,Қош келдіңіз.
Dialogue: 0,0:11:45.66,0:11:48.87,Default,,0,0,0,,Хм... Негізгі есептегіші бар дүкен ішінде.
Dialogue: 0,0:11:49.25,0:11:50.58,Default,,0,0,0,,Кешіріңіз, бұл өте кішкентай
Dialogue: 0,0:11:50.91,0:11:53.79,Default,,0,0,0,,Сырт келбеті сүйкімді дүкенші
Dialogue: 0,0:11:54.00,0:11:56.80,Default,,0,0,0,,Ашылғаннан кейін тұтынушылардың болмағаны жақсы.
Dialogue: 0,0:11:57.25,0:12:00.92,Default,,0,0,0,,Бұл мен сияқты мигрант үшін тамаша дүкен емес пе?
Dialogue: 0,0:12:02.80,0:12:04.47,Default,,0,0,0,,Бұл мәзір
Dialogue: 0,0:12:04.68,0:12:06.14,Default,,0,0,0,,Сәлем
Dialogue: 0,0:12:08.06,0:12:09.02,Default,,0,0,0,,Муо!
Dialogue: 0,0:12:09.18,0:12:11.48,Default,,0,0,0,,А... а... (Дүкенші) Не істейміз?
Dialogue: 0,0:12:12.44,0:12:15.23,Default,,0,0,0,,Ал... әзірге? Сыра? Ұнады ма?
Dialogue: 0,0:12:15.48,0:12:17.02,Default,,0,0,0,,Иә! сыра
Dialogue: 0,0:12:17.40,0:12:18.86,Default,,0,0,0,,О, және...
Dialogue: 0,0:12:19.11,0:12:21.24,Default,,0,0,0,,Не ұсынылады?
Dialogue: 0,0:12:21.36,0:12:22.57,Default,,0,0,0,,Моцуни гратині
Dialogue: 0,0:12:22.86,0:12:24.45,Default,,0,0,0,,Моцуни гратин?
Dialogue: 0,0:12:24.66,0:12:26.95,Default,,0,0,0,,Моцуни гратин!?
Dialogue: 0,0:12:27.24,0:12:32.00,Default,,0,0,0,,Неге... Жоқ, бірақ... Соны сұраудан басқа амалым жоқ...
Dialogue: 0,0:12:32.25,0:12:34.12,Default,,0,0,0,,Моцу... Бұл бір нәрсе.
Dialogue: 0,0:12:34.37,0:12:36.63,Default,,0,0,0,,Иә! Менде бір құмалақ бар
Dialogue: 0,0:12:37.25,0:12:39.25,Default,,0,0,0,,Сырада қайнатылған моцу гратин…
Dialogue: 0,0:12:39.42,0:12:41.59,Default,,0,0,0,,Жоқ... жоқ, жоқ, жоқ!
Dialogue: 0,0:12:41.76,0:12:43.38,Default,,0,0,0,,Бұл ыңғайлы!
Dialogue: 0,0:12:43.72,0:12:46.72,Default,,0,0,0,,Мен моцуни гратин деп аталатын ерекше тағамды сұраймын.
Dialogue: 0,0:12:46.85,0:12:48.39,Default,,0,0,0,,Бір Моцу Гура Бір Моцу Гура (Дүкенші) Айё! Айо!
Dialogue: 0,0:12:48.47,0:12:49.76,Default,,0,0,0,,Бір Моцугура (Дүкенші) Аййо!
Dialogue: 0,0:12:49.89,0:12:53.39,Default,,0,0,0,,Егер дүкен иесі сізді бірден «Моцуни Гратин жігіті» деп еске алса...
Dialogue: 0,0:12:54.10,0:12:57.19,Default,,0,0,0,,Ол мақсатқа тез жетуге болады
Dialogue: 0,0:12:59.44,0:13:01.65,Default,,0,0,0,,Жалпы! Әдеттегі!
Dialogue: 0,0:13:01.78,0:13:02.82,Default,,0,0,0,,Иә, күте тұрыңыз!
Dialogue: 0,0:13:03.45,0:13:06.28,Default,,0,0,0,,Бірақ мен бірінші рет бірдеңе жеп отырмын.
Dialogue: 0,0:13:07.16,0:13:09.20,Default,,0,0,0,,Бұл шынымен жақсы ма, жоқ па?
Dialogue: 0,0:13:09.33,0:13:10.74,Default,,0,0,0,,Ммм...
Dialogue: 0,0:13:12.66,0:13:14.29,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:13:14.75,0:13:16.37,Default,,0,0,0,,Дәмді... Дәмді!
Dialogue: 0,0:13:16.50,0:13:20.25,Default,,0,0,0,,Мүмкін қарным ашты, бірақ жоқ! Неге екенін білмеймін
Dialogue: 0,0:13:20.84,0:13:23.05,Default,,0,0,0,,Мен бәрін бірден жедім
Dialogue: 0,0:13:23.76,0:13:26.05,Default,,0,0,0,,Гочисусан (Дүкенші) Азашита
Dialogue: 0,0:13:27.30,0:13:30.26,Default,,0,0,0,,Біраз уақыт мен моцуни гратинге тең болдым.
Dialogue: 0,0:13:30.35,0:13:32.72,Default,,0,0,0,,Мен басып шығару стратегиясымен жүремін.
Dialogue: 0,0:13:35.02,0:13:36.81,Default,,0,0,0,,Мен жалыққанмын...
Dialogue: 0,0:13:37.40,0:13:40.40,Default,,0,0,0,,Мен неге Моцуграны таңдадым?
Dialogue: 0,0:13:40.48,0:13:44.74,Default,,0,0,0,,Себебі мен мәзірді оқи алмадым, бірақ ішіме тым ауыр болды.
Dialogue: 0,0:13:44.86,0:13:48.41,Default,,0,0,0,,Мен оның бар-жоғын білмеймін, бірақ сіз Moro Q жеуге болады.
Dialogue: 0,0:13:50.28,0:13:52.74,Default,,0,0,0,,Бұл жолды айтатын кез келді емес пе?
Dialogue: 0,0:13:52.87,0:13:53.62,Default,,0,0,0,,Ооо
Dialogue: 0,0:13:53.75,0:13:55.66,Default,,0,0,0,,Мен дүкен қызметкерлерімен таныстым.
Dialogue: 0,0:13:55.75,0:13:56.62,Default,,0,0,0,,Ооо
Dialogue: 0,0:13:56.71,0:13:59.00,Default,,0,0,0,,Бірақ сенімді болу үшін сақ болу керек пе?
Dialogue: 0,0:13:59.08,0:13:59.92,Default,,0,0,0,,О
Dialogue: 0,0:14:01.55,0:14:03.00,Default,,0,0,0,,Моро К тамақтанып жатыр...
Dialogue: 0,0:14:03.00,0:14:03.17,Default,,0,0,0,,Моро К тамақтанып жатыр...
Dialogue: 0,0:14:03.00,0:14:03.17,Default,,0,0,0,,Өздерін биік әрі мықты санайтын адамдардың сезімдері мен жүректері —
Dialogue: 0,0:14:03.17,0:14:03.63,Default,,0,0,0,,Өздерін биік әрі мықты санайтын адамдардың сезімдері мен жүректері —
Dialogue: 0,0:14:03.63,0:14:03.88,Default,,0,0,0,,Өздерін биік әрі мықты санайтын адамдардың сезімдері мен жүректері —
Dialogue: 0,0:14:03.63,0:14:03.88,Default,,0,0,0,,Моро... Q... жейді...
Dialogue: 0,0:14:03.88,0:14:04.17,Default,,0,0,0,,Моро... Q... жейді...
Dialogue: 0,0:14:04.17,0:14:05.59,Default,,0,0,0,,Моро... Q... жейді...
Dialogue: 0,0:14:04.17,0:14:05.59,Default,,0,0,0,,Ооо... Ооо...
Dialogue: 0,0:14:05.59,0:14:06.30,Default,,0,0,0,,Ооо... Ооо...
Dialogue: 0,0:14:06.38,0:14:07.84,Default,,0,0,0,,Бұл сергітетін... жасыл...
Dialogue: 0,0:14:07.84,0:14:08.93,Default,,0,0,0,,Бұл сергітетін... жасыл...
Dialogue: 0,0:14:07.84,0:14:08.93,Default,,0,0,0,,Ооо... Ооо...
Dialogue: 0,0:14:08.93,0:14:09.09,Default,,0,0,0,,Ооо... Ооо...
Dialogue: 0,0:14:11.56,0:14:11.97,Default,,0,0,0,,(Цурубишидің жүрек соғу дыбысы)
Dialogue: 0,0:14:11.97,0:14:16.77,Default,,0,0,0,,(Цурубишидің жүрек соғу дыбысы)
Dialogue: 0,0:14:11.97,0:14:16.77,Default,,0,0,0,,Дүкен жақындаған сайын жүрегім жиі соғады.
Dialogue: 0,0:14:16.77,0:14:17.06,Default,,0,0,0,,(Цурубишидің жүрек соғу дыбысы)
Dialogue: 0,0:14:17.27,0:14:18.90,Default,,0,0,0,,Уақыт дұрыс.
Dialogue: 0,0:14:19.48,0:14:20.36,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:14:20.69,0:14:23.36,Default,,0,0,0,,Батылдық - жігерлі! Макабе Цурубиши!
Dialogue: 0,0:14:25.19,0:14:28.11,Default,,0,0,0,,Бала күнімнен сүйсінген осы сөздер...
Dialogue: 0,0:14:28.91,0:14:31.07,Default,,0,0,0,,Жалпы Әдеттегі!
Dialogue: 0,0:14:37.37,0:14:38.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:39.54,0:14:40.38,Default,,0,0,0,,Га
Dialogue: 0,0:14:40.75,0:14:44.09,Default,,0,0,0,,Ахахахахахахаха
Dialogue: 0,0:14:44.21,0:14:47.01,Default,,0,0,0,,Хаха... хаха... а...
Dialogue: 0,0:14:47.72,0:14:49.05,Default,,0,0,0,,күрсіну
Dialogue: 0,0:14:50.18,0:14:52.64,Default,,0,0,0,,Менің бір болжамым бар еді.
Dialogue: 0,0:14:52.89,0:14:57.31,Default,,0,0,0,,Бұл ұзақ уақыт бойы жасалса керек, бірақ кенеттен безендірілген гүлдер пайда болды.
Dialogue: 0,0:14:57.68,0:15:00.44,Default,,0,0,0,,Мен онда бір аптадан астам уақыт әртүрлі уақытта барсам да...
Dialogue: 0,0:15:01.02,0:15:03.65,Default,,0,0,0,,Мен жалғыз тұтынушы болдым!
Dialogue: 0,0:15:08.53,0:15:12.32,Default,,0,0,0,,Ха... ха... ха... ха...
Dialogue: 0,0:15:12.82,0:15:13.95,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:15:14.37,0:15:15.79,Default,,0,0,0,,күрсіну... Ах.
Dialogue: 0,0:15:30.55,0:15:32.39,Default,,0,0,0,,Мен жалғыз емеспін...
Dialogue: 0,0:15:33.55,0:15:35.47,Default,,0,0,0,,Мен бұл кітапты таптым...
Dialogue: 0,0:15:35.64,0:15:37.60,Default,,0,0,0,,Эрен сияқты, бронясымен және Коллоссал Титанмен
Dialogue: 0,0:15:38.93,0:15:39.98,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:15:52.28,0:15:54.82,Default,,0,0,0,,Иә? Нагумо мырза? Вако мырза?
Dialogue: 0,0:15:55.20,0:15:56.28,Default,,0,0,0,,Бар емес пе?
Dialogue: 0,0:15:56.79,0:15:58.91,Default,,0,0,0,,Фуааааааааааа
Dialogue: 0,0:15:59.33,0:16:00.16,Default,,0,0,0,,Ах
Dialogue: 0,0:16:00.96,0:16:03.25,Default,,0,0,0,,У… у… Құдай-ай!
Dialogue: 0,0:16:03.79,0:16:05.21,Default,,0,0,0,,О, Никура
Dialogue: 0,0:16:05.34,0:16:07.46,Default,,0,0,0,,Мен Сентукиді қарызға алдым.
Dialogue: 0,0:16:07.67,0:16:09.51,Default,,0,0,0,,Мен бұл туралы түсініксіз болдым ...
Dialogue: 0,0:16:09.88,0:16:12.76,Default,,0,0,0,,Нагумоның барлық жазғы киімдері солай ма?
Dialogue: 0,0:16:12.93,0:16:16.35,Default,,0,0,0,,Бұл тітіркендіргіш. Бұл дұрыс. Менің барлық киімдерім осындай.
Dialogue: 0,0:16:16.47,0:16:17.93,Default,,0,0,0,,Сіз Oba Qсыз ба?
Dialogue: 0,0:16:18.35,0:16:19.56,Default,,0,0,0,,Көрдіңіз бе? (Никкура) А!?
Dialogue: 0,0:16:20.81,0:16:24.10,Default,,0,0,0,,Чичичичи кішірейіп барады!
Dialogue: 0,0:16:25.23,0:16:29.53,Default,,0,0,0,,Маған бұл қатты ұнады... аздап киіп алсам да...
Dialogue: 0,0:16:29.65,0:16:31.82,Default,,0,0,0,,Қымбат болса да...
Dialogue: 0,0:16:32.40,0:16:33.74,Default,,0,0,0,,Уму~~!
Dialogue: 0,0:16:35.45,0:16:39.95,Default,,0,0,0,,Баоооооооооо!!
Dialogue: 0,0:16:40.50,0:16:41.50,Default,,0,0,0,,Урия
Dialogue: 0,0:16:42.33,0:16:44.12,Default,,0,0,0,,Мен оны қайтарамын! (Нагумо) Никура!?
Dialogue: 0,0:16:44.42,0:16:46.00,Default,,0,0,0,,Фуну~! (Нагумо) Никура!?
Dialogue: 0,0:16:46.46,0:16:50.30,Default,,0,0,0,,Кешіріңіз! Жуғаннан кейін сонша кішірейеді деп ойламаппын!
Dialogue: 0,0:16:50.59,0:16:54.09,Default,,0,0,0,,Аа... Жоқ... Никура асықпа!
Dialogue: 0,0:16:54.43,0:16:56.55,Default,,0,0,0,,Ахахаха! (Нагумо/Никура) Нуо!!
Dialogue: 0,0:16:58.26,0:17:00.01,Default,,0,0,0,,Иә Dozo
Dialogue: 0,0:17:00.35,0:17:01.43,Default,,0,0,0,,Бұл...
Dialogue: 0,0:17:01.56,0:17:03.60,Default,,0,0,0,,Бұл Никура-сандікі (Никура) иә?
Dialogue: 0,0:17:04.02,0:17:05.19,Default,,0,0,0,,Сонымен бұл не?
Dialogue: 0,0:17:05.65,0:17:09.02,Default,,0,0,0,,Бұл мен ұйықтап жатқанда жасаған шағын нұсқасы.
Dialogue: 0,0:17:09.15,0:17:10.65,Default,,0,0,0,,Зуко!
Dialogue: 0,0:17:11.19,0:17:12.74,Default,,0,0,0,,Бірақ бұл жақсы болды~
Dialogue: 0,0:17:12.86,0:17:15.70,Default,,0,0,0,,Жоқ, мен бұл өтемақы деп ойладым.
Dialogue: 0,0:17:16.24,0:17:18.07,Default,,0,0,0,,Үлкен жетістік!
Dialogue: 0,0:17:18.78,0:17:20.66,Default,,0,0,0,,Мен айтқым келеді...
Dialogue: 0,0:17:21.54,0:17:22.91,Default,,0,0,0,,Нагумо-сан, бұл...
Dialogue: 0,0:17:23.16,0:17:25.96,Default,,0,0,0,,Ол кір жуғыш машинаның жанына құлады~
Dialogue: 0,0:17:26.37,0:17:27.71,Default,,0,0,0,,Зуко!
Dialogue: 0,0:17:28.29,0:17:29.17,Default,,0,0,0,,Сондықтан
Dialogue: 0,0:17:29.50,0:17:32.21,Default,,0,0,0,,Мен сізге де нақты нәрсені беремін.
Dialogue: 0,0:17:34.05,0:17:36.63,Default,,0,0,0,,Иә?Не?
Dialogue: 0,0:17:36.76,0:17:43.73,Default,,0,0,0,,Бұл~
Dialogue: 0,0:17:47.27,0:17:48.90,Default,,0,0,0,,Андайо Никура!
Dialogue: 0,0:17:49.48,0:17:52.36,Default,,0,0,0,,Сонымен, о, жоқ... Нахахахаха
Dialogue: 0,0:17:52.44,0:17:53.61,Default,,0,0,0,,Хохо... Міне, мінекей!
Dialogue: 0,0:17:53.69,0:17:57.86,Default,,0,0,0,,Жаңа ғана теуіп жібердім, қоқыс болып шықты, әйтеуір... хехехе...
Dialogue: 0,0:17:58.07,0:17:59.20,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:17:59.37,0:18:00.58,Default,,0,0,0,,Мен мүлде түсінбеймін
Dialogue: 0,0:18:00.70,0:18:01.53,Default,,0,0,0,,Ах (Никура/Нагумо) Иә?
Dialogue: 0,0:18:03.62,0:18:04.70,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:18:05.08,0:18:05.91,Default,,0,0,0,,Аха
Dialogue: 0,0:18:09.79,0:18:10.63,Default,,0,0,0,,Аха
Dialogue: 0,0:18:12.42,0:18:14.21,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:18:14.88,0:18:16.80,Default,,0,0,0,,Ол не істеп жатыр?
Dialogue: 0,0:18:16.93,0:18:19.18,Default,,0,0,0,,Бұл кулон.
Dialogue: 0,0:18:19.30,0:18:21.18,Default,,0,0,0,,Ішінде маңызды құпия бар.
Dialogue: 0,0:18:21.30,0:18:24.35,Default,,0,0,0,,Бұл сізге ұнайтын адамның суреті салынған кулон.
Dialogue: 0,0:18:24.52,0:18:25.60,Default,,0,0,0,,Хмм.
Dialogue: 0,0:18:27.39,0:18:28.23,Default,,0,0,0,,Сәнді дизайнерлік аяқ киім алу үшін жинап жүрген 20 000 йенім...
Dialogue: 0,0:18:28.44,0:18:32.27,Default,,0,0,0,,Сен мені қуып барасың ба, ниндзя пингвин? Пейн!
Dialogue: 0,0:18:40.03,0:18:42.49,Default,,0,0,0,,Күрсін... Күрсін... Күрсін... Күрсін...
Dialogue: 0,0:18:42.83,0:18:44.33,Default,,0,0,0,,Фестиваль Мен соңғы уақытта нан жеп жүрмін.
Dialogue: 0,0:18:44.99,0:18:45.87,Default,,0,0,0,,Иә
Dialogue: 0,0:18:46.33,0:18:49.54,Default,,0,0,0,,Қараңдаршы, мама, қазылған екен.
Dialogue: 0,0:18:50.50,0:18:52.88,Default,,0,0,0,,Экчан бүгін түскі асқа не жеп отыр?
Dialogue: 0,0:18:53.29,0:18:55.13,Default,,0,0,0,,Жақсы сұрақ, Мацури-кун.
Dialogue: 0,0:18:55.88,0:18:58.26,Default,,0,0,0,,Жақсы сұрақ, сондықтан мен сізге 6 ұпай беремін.
Dialogue: 0,0:18:58.63,0:19:03.01,Default,,0,0,0,,Бұл шықты! 10 ұпай жинағаннан кейін ол 0 ұпайға оралады.Ecchan ұпайлары
Dialogue: 0,0:19:03.47,0:19:05.93,Default,,0,0,0,,Менің бүгінгі түскі асым ~
Dialogue: 0,0:19:06.06,0:19:06.98,Default,,0,0,0,,Лайлы көже...
Dialogue: 0,0:19:07.18,0:19:09.73,Default,,0,0,0,,Лазды көже...
Dialogue: 0,0:19:10.02,0:19:10.90,Default,,0,0,0,,Қандай лас көрініс…
Dialogue: 0,0:19:11.35,0:19:12.77,Default,,0,0,0,,Чизбургер!
Dialogue: 0,0:19:16.28,0:19:17.74,Default,,0,0,0,,Сырлы Боеж...
Dialogue: 0,0:19:18.24,0:19:19.65,Default,,0,0,0,,Чизбургер!
Dialogue: 0,0:19:19.99,0:19:21.57,Default,,0,0,0,,Хмм, хе.
Dialogue: 0,0:19:21.70,0:19:22.74,Default,,0,0,0,,Сонда бұл не?
Dialogue: 0,0:19:22.95,0:19:25.58,Default,,0,0,0,,Ммм... Қарбыз
Dialogue: 0,0:19:25.99,0:19:27.29,Default,,0,0,0,,Worda Run!
Dialogue: 0,0:19:28.79,0:19:30.96,Default,,0,0,0,,Айтпақшы, бұл мускуска
Dialogue: 0,0:19:31.08,0:19:32.42,Default,,0,0,0,,Meskumeran!
Dialogue: 0,0:19:32.54,0:19:34.59,Default,,0,0,0,,Горилла!
Dialogue: 0,0:19:35.13,0:19:36.13,Default,,0,0,0,,Жоқ
Dialogue: 0,0:19:36.59,0:19:39.34,Default,,0,0,0,,Экчан нағыз Экчанға айналады
Dialogue: 0,0:19:39.63,0:19:40.47,Default,,0,0,0,,Фестиваль
Dialogue: 0,0:19:40.59,0:19:41.59,Default,,0,0,0,,Бұл...
Dialogue: 0,0:19:41.93,0:19:44.64,Default,,0,0,0,,Жүгері? Бұл Экчан ба?
Dialogue: 0,0:19:44.97,0:19:46.26,Default,,0,0,0,,Конкорн
Dialogue: 0,0:19:46.43,0:19:48.60,Default,,0,0,0,,Не? Бұл Экчанның шынайы ісі.
Dialogue: 0,0:19:49.23,0:19:52.40,Default,,0,0,0,,Бұл нағыз экчан ба? Сіз нағыз экчансыз ба?
Dialogue: 0,0:19:52.81,0:19:53.81,Default,,0,0,0,,Хехехе
Dialogue: 0,0:19:53.98,0:19:55.15,Default,,0,0,0,,Оның шынайы тұлғасы...
Dialogue: 0,0:19:57.03,0:20:00.11,Default,,0,0,0,,Бұл нағыз нәрсені жұтып қойған нағыз секс-чан болды!
Dialogue: 0,0:20:00.24,0:20:01.57,Default,,0,0,0,,Қайтадан қош келдіңіз Экчан!
Dialogue: 0,0:20:01.82,0:20:05.87,Default,,0,0,0,,Қош келдіңіз десеңіз, бұл менің бір жерге барғанымды білдіре ме?
Dialogue: 0,0:20:06.37,0:20:07.95,Default,,0,0,0,,Міне солай болады!
Dialogue: 0,0:20:08.12,0:20:10.58,Default,,0,0,0,,Сонда сен қайда бардың?
Dialogue: 0,0:20:10.71,0:20:12.08,Default,,0,0,0,,Ха! Мен тырысамын!
Dialogue: 0,0:20:12.54,0:20:14.33,Default,,0,0,0,,American Requa
Dialogue: 0,0:20:15.71,0:20:18.05,Default,,0,0,0,,Менің Экчан еліме қош келдіңіз
Dialogue: 0,0:20:18.34,0:20:19.17,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:19.30,0:20:20.30,Default,,0,0,0,,Хехе
Dialogue: 0,0:20:21.05,0:20:22.38,Default,,0,0,0,,Биндоки! дұрыс жауап!
Dialogue: 0,0:20:22.72,0:20:24.26,Default,,0,0,0,,Цумпас! Тамаша жауап!
Dialogue: 0,0:20:24.64,0:20:27.72,Default,,0,0,0,,Енді біз Цунпас клубын бастаймыз.
Dialogue: 0,0:20:27.85,0:20:28.72,Default,,0,0,0,,Мен қосылғым келеді!
Dialogue: 0,0:20:29.22,0:20:32.27,Default,,0,0,0,,Мен капитан болғандықтан, қосылуға рұқсат етілген.
Dialogue: 0,0:20:32.52,0:20:33.35,Default,,0,0,0,,Бәрі сол қарттың кінәсі!
Dialogue: 0,0:20:33.85,0:20:34.81,Default,,0,0,0,,Хата!
Dialogue: 0,0:20:34.94,0:20:36.27,Default,,0,0,0,,Бұл...
Dialogue: 0,0:20:36.61,0:20:38.52,Default,,0,0,0,,Капитан Экчанға не болды?
Dialogue: 0,0:20:38.65,0:20:39.78,Default,,0,0,0,,Капитан емес...
Dialogue: 0,0:20:40.49,0:20:41.32,Default,,0,0,0,,Капитан
Dialogue: 0,0:20:41.40,0:20:42.24,Default,,0,0,0,,Кэттин!
Dialogue: 0,0:20:42.74,0:20:45.16,Default,,0,0,0,,Егер бұл орын алса, Цунпас клубы жойылады!
Dialogue: 0,0:20:45.28,0:20:46.28,Default,,0,0,0,,Момент…
Dialogue: 0,0:20:46.62,0:20:49.16,Default,,0,0,0,,Клуб жоғалып кеткен соң, түскі ас ішейік.
Dialogue: 0,0:20:49.37,0:20:50.75,Default,,0,0,0,,Керемет идея!
Dialogue: 0,0:20:51.12,0:20:53.04,Default,,0,0,0,,Хайуанаттар бағы… ngng…
Dialogue: 0,0:20:57.09,0:20:58.96,Default,,0,0,0,,I фестиваль
Dialogue: 0,0:20:59.96,0:21:01.21,Default,,0,0,0,,Не? Экчан
Dialogue: 0,0:21:01.67,0:21:02.59,Default,,0,0,0,,Хикко…
Dialogue: 0,0:21:09.64,0:21:10.60,Default,,0,0,0,,Иә
Dialogue: 0,0:21:10.93,0:21:13.85,Default,,0,0,0,,Бұл ештеңе емес! Уау, хаха, бұл не?
Dialogue: 0,0:21:13.98,0:21:15.90,Default,,0,0,0,,Хехе... Тоқта, тоқта.
Dialogue: 0,0:21:15.98,0:21:18.98,Default,,0,0,0,,Бер демейінше тоқтамаймын! Бұл жерде! Бұл жерде!
Dialogue: 0,0:21:19.27,0:21:22.07,Default,,0,0,0,,Иә? Мен әлі бер деп айтқан жоқпын.
Dialogue: 0,0:21:22.78,0:21:25.28,Default,,0,0,0,,Мацури, мынаны қарашы?
Dialogue: 0,0:21:25.95,0:21:27.41,Default,,0,0,0,,А, бұл құлақ мысық.
Dialogue: 0,0:21:28.03,0:21:30.24,Default,,0,0,0,,Бұл не? кулон?
Dialogue: 0,0:21:32.45,0:21:33.33,Default,,0,0,0,,Мацури мырза
Dialogue: 0,0:21:33.58,0:21:34.96,Default,,0,0,0,,Не, Экчан мырза?
Dialogue: 0,0:21:35.54,0:21:38.75,Default,,0,0,0,,«Ауып алу және кулондар клубы» қазір іске қосылады!
Dialogue: 0,0:21:38.96,0:21:40.04,Default,,0,0,0,,Олар жай ғана кішігірім адамдар.
Dialogue: 0,0:21:40.55,0:21:43.21,Default,,0,0,0,,Бірақ сіздің түскі үзілісіңіз жақында бітеді, солай ма?
Dialogue: 0,0:21:43.63,0:21:48.09,Default,,0,0,0,,Хмм... «Мектептен ұйықтап, кулонды ал» ше?
Dialogue: 0,0:21:48.26,0:21:49.68,Default,,0,0,0,,Мен Раджа Кэттинмін!
Dialogue: 0,0:21:49.97,0:21:53.22,Default,,0,0,0,,Ұлы шытырман оқиға басталады! Менің жүрегім дүрсілдеп тұр!
Dialogue: 0,0:21:59.31,0:22:00.73,Default,,0,0,0,,Жарыс қаншада басталады?
Dialogue: 0,0:22:00.86,0:22:03.78,Default,,0,0,0,,Міне, бір минут қана қалды.
Dialogue: 0,0:22:04.15,0:22:06.95,Default,,0,0,0,,Наэба-кун түсіруге барады!
Dialogue: 0,0:22:07.66,0:22:08.16,Default,,0,0,0,,Уф! Хааа...
Dialogue: 0,0:22:08.16,0:22:10.12,Default,,0,0,0,,Уф! Хааа...
Dialogue: 0,0:22:08.16,0:22:10.12,Default,,0,0,0,,Бірақ! Мен өзімнің одақтасым Макабе-кунды ұрдым!
Dialogue: 0,0:22:10.12,0:22:10.74,Default,,0,0,0,,Бірақ! Мен өзімнің одақтасым Макабе-кунды ұрдым!
Dialogue: 0,0:22:10.87,0:22:13.83,Default,,0,0,0,,Тек! Мақсатқа тікелей барыңыз!
Dialogue: 0,0:22:14.33,0:22:14.45,Default,,0,0,0,,Ка…хаха…
Dialogue: 0,0:22:14.45,0:22:15.96,Default,,0,0,0,,Ка…хаха…
Dialogue: 0,0:22:14.45,0:22:15.96,Default,,0,0,0,,Бұл менің бірінші мақсатым екеніне қатты қуанып, ұялдым! Макабе-кун қуаныштан жарылды!
Dialogue: 0,0:22:15.96,0:22:19.75,Default,,0,0,0,,Бірінші голымды соққаныма қуаныштымын және ұялдым! Макабе-кун қуаныштан жарылды!
Dialogue: 0,0:22:19.88,0:22:23.25,Default,,0,0,0,,Өз бетіңізше ләззат алуды шешкен сияқтысыз!
Dialogue: 0,0:22:23.84,0:22:24.92,Default,,0,0,0,,Ахаха!
Dialogue: 0,0:22:25.63,0:22:29.09,Default,,0,0,0,,Эй... сәл күте тұрыңыз, бұл поза!
Dialogue: 0,0:22:29.76,0:22:32.89,Default,,0,0,0,,шықты! Аспанды сүйетін адам!
Dialogue: 0,0:22:33.43,0:22:36.06,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:22:38.31,0:22:39.52,Default,,0,0,0,,Хахахаха...
Dialogue: 0,0:22:39.90,0:22:41.94,Default,,0,0,0,,Олай болса... Хм...
Dialogue: 0,0:22:42.02,0:22:42.73,Default,,0,0,0,,Міне! Ха!
Dialogue: 0,0:22:43.02,0:22:43.86,Default,,0,0,0,,Хохохохохо
Dialogue: 0,0:22:44.07,0:22:45.69,Default,,0,0,0,,Хахахаха... Аххх
Dialogue: 0,0:22:45.78,0:22:47.74,Default,,0,0,0,,Қарғыс атсын... аа... хаха
Dialogue: 0,0:22:48.03,0:22:48.91,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:22:50.41,0:22:53.91,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:22:54.29,0:22:55.45,Default,,0,0,0,,Оны қолданыңыз!
Dialogue: 0,0:23:12.85,0:23:14.22,Default,,0,0,0,,Дүрбі
Dialogue: 0,0:23:14.89,0:23:16.56,Default,,0,0,0,,Ал, қалғаны...
Dialogue: 0,0:23:16.97,0:23:17.93,Default,,0,0,0,,Ах!
Dialogue: 0,0:23:20.94,0:23:23.19,Default,,0,0,0,,Хмм… ммм…
Dialogue: 0,0:23:25.19,0:23:26.07,Default,,0,0,0,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,0:23:27.78,0:23:30.61,Default,,0,0,0,,Нагумо-сан, күткеніңізге рахмет!
Dialogue: 0,0:23:32.74,0:23:34.16,Default,,0,0,0,,Ах!
Dialogue: 0,0:23:34.78,0:23:37.58,Default,,0,0,0,,Бұл менмін! Мен бұдан былай күте алмаймын!
Dialogue: 0,0:23:37.87,0:23:41.00,Default,,0,0,0,,Әйтеуір, алдымен соны ал, мен сенің әлсіздігіңді ұстауға рұқсат етемін!
Dialogue: 0,0:23:41.50,0:23:42.71,Default,,0,0,0,,Никрайо!
Dialogue: 0,0:23:42.79,0:23:44.46,Default,,0,0,0,,Уау!
Dialogue: 0,0:23:51.09,0:23:53.76,Default,,0,0,0,,KEEEEEEE!
Dialogue: 0,0:23:54.22,0:23:57.60,Default,,0,0,0,,Кя... ха... у... уф! Ууууууууууууууууууууу
Dialogue: 0,0:23:58.93,0:24:01.06,Default,,0,0,0,,Қырылдау... Хик... Таа!?
Dialogue: 0,0:24:01.31,0:24:03.06,Default,,0,0,0,,Ахахха (Они Камабоко) Ахахха... Уау
Dialogue: 0,0:24:03.27,0:24:04.65,Default,,0,0,0,,(Ақ тұмсық үйректердің дыбысы)
Dialogue: 0,0:24:04.77,0:24:06.40,Default,,0,0,0,,Жоқ! (Тодороки) А... иә!
Dialogue: 0,0:24:06.52,0:24:07.57,Default,,0,0,0,,Нуватт
Dialogue: 0,0:24:08.11,0:24:10.07,Default,,0,0,0,,Ах... у... (Нагумо) Е, ехо, иә? тістері?
Dialogue: 0,0:24:10.19,0:24:11.61,Default,,0,0,0,,Ахаха хехехе
Dialogue: 0,0:24:11.74,0:24:12.99,Default,,0,0,0,,Чива (Тодороки) Яй
Dialogue: 0,0:24:13.11,0:24:15.45,Default,,0,0,0,,Хахаха... Ах~!
Dialogue: 0,0:24:15.58,0:24:17.37,Default,,0,0,0,,Хахахаха (Бас редактор) Жоқ, жоқ, жоқ...
Dialogue: 0,0:24:17.37,0:24:17.99,Default,,0,0,0,,Хахахаха (Бас редактор) Жоқ, жоқ, жоқ...
Dialogue: 0,0:24:17.37,0:24:17.99,Default,,0,0,0,,Ммм! (Нагумо) Не! не!
Dialogue: 0,0:24:17.99,0:24:18.87,Default,,0,0,0,,Ммм! (Нагумо) Не! не!
Dialogue: 0,0:24:18.87,0:24:20.12,Default,,0,0,0,,Ммм! (Нагумо) Не! не!
Dialogue: 0,0:24:18.87,0:24:20.12,Default,,0,0,0,,Олар жай ғана кішігірім адамдар.
Dialogue: 0,0:24:20.12,0:24:21.04,Default,,0,0,0,,Олар жай ғана кішігірім адамдар.
Dialogue: 0,0:24:21.37,0:24:22.37,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:24:22.37,0:24:23.25,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:24:22.37,0:24:23.25,Default,,0,0,0,,Ааааааааа!
Dialogue: 0,0:24:23.25,0:24:23.83,Default,,0,0,0,,Ааааа!
Dialogue: 0,0:24:23.96,0:24:25.04,Default,,0,0,0,,Е (Тодороки) Е!?
Dialogue: 0,0:24:26.00,0:24:26.88,Default,,0,0,0,,Ах!
Dialogue: 0,0:24:28.09,0:24:32.63,Default,,0,0,0,,Nu! Жай ғана тастаңыз!
Dialogue: 0,0:24:33.18,0:24:34.14,Default,,0,0,0,,Ах (Нагумо) О!
Dialogue: 0,0:24:34.51,0:24:35.97,Default,,0,0,0,,Ахххх (Нагумо) Охххх
Dialogue: 0,0:24:36.30,0:24:39.18,Default,,0,0,0,,Бақытты! Мен оны түсіндім!
Dialogue: 0,0:24:39.72,0:24:42.48,Default,,0,0,0,,Жоқ, жоқ!
Dialogue: 0,0:24:46.65,0:24:48.11,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:24:49.48,0:24:50.94,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:24:51.07,0:24:53.65,Default,,0,0,0,,Ааааааааааааааааааааааа
Dialogue: 0,0:24:56.16,0:24:57.12,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:25:00.29,0:25:02.71,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймын.
Dialogue: 0,0:25:08.75,0:25:10.09,Default,,0,0,0,,Нихи
Dialogue: 0,0:25:11.67,0:25:12.97,Default,,0,0,0,,♪～
Dialogue: 0,0:25:13.09,0:25:16.51,Default,,0,0,0,,Мен таң қалдым! Маусым
Dialogue: 0,0:25:16.84,0:25:20.56,Default,,0,0,0,,Еш ойланбастан ерітіңіз
Dialogue: 0,0:25:21.10,0:25:25.02,Default,,0,0,0,,Қайнап жатқан көшемен Гойнонға бару
Dialogue: 0,0:25:25.14,0:25:29.02,Default,,0,0,0,,Түс пе, білмеймін
Dialogue: 0,0:25:29.15,0:25:32.69,Default,,0,0,0,,Шамадан тыс ұйықтаудан туындаған шымшу
Dialogue: 0,0:25:33.28,0:25:36.86,Default,,0,0,0,,Таң қалдыратын сараңдық та солай.
Dialogue: 0,0:25:37.41,0:25:41.33,Default,,0,0,0,,Бұл ұят және көңілсіз.
Dialogue: 0,0:25:41.45,0:25:44.71,Default,,0,0,0,,Қазір оны жеудің ең жақсы уақыты сияқты.
Dialogue: 0,0:25:45.12,0:25:52.09,Default,,0,0,0,,Кәдімгідей болып көріну
Dialogue: 0,0:25:53.30,0:26:00.26,Default,,0,0,0,,Өткен жылғыдан басқа жаз.
Dialogue: 0,0:26:01.35,0:26:05.98,Default,,0,0,0,,Мәселе! Бірақ қызық
Dialogue: 0,0:26:09.61,0:26:14.07,Default,,0,0,0,,Сіз өзіңізсіз
Dialogue: 0,0:26:16.99,0:26:21.37,Default,,0,0,0,,Бұл қалада мысықтар да, шөміштер де жүгіреді
Dialogue: 0,0:26:21.74,0:26:24.54,Default,,0,0,0,,Мен де бүгін сенімен бірге болғым келеді
Dialogue: 0,0:26:24.75,0:26:31.71,Default,,0,0,0,,Шатырдың артына тығылған күн
Dialogue: 0,0:26:32.25,0:26:34.71,Default,,0,0,0,,Әй, жаз келе жатыр
Dialogue: 0,0:26:37.43,0:26:40.26,Default,,0,0,0,,～♪
Dialogue: 0,0:26:41.76,0:26:47.76,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory