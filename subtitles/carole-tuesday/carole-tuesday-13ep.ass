Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.04,0:00:06.00,Default,,0,0,0,,Бұл ғажайып сияқты болды
Dialogue: 0,0:00:06.29,0:00:10.71,Default,,0,0,0,,Иә, ол Марс тарихына жазылды.
Dialogue: 0,0:00:10.84,0:00:12.92,Default,,0,0,0,,«Жеті минут ғажайып»
Dialogue: 0,0:00:13.59,0:00:19.89,Default,,0,0,0,,Бұл оның қозғаушы күшіне айналған екі қыздың оқиғасы.
Dialogue: 0,0:00:21.43,0:00:27.44,Default,,0,0,0,,♪～
Dialogue: 0,0:01:43.64,0:01:49.65,Default,,0,0,0,,～♪
Dialogue: 0,0:01:51.98,0:01:54.73,Default,,0,0,0,,«Ең жарқын Марс» тыңдау бағдарламасында
Dialogue: 0,0:01:54.86,0:01:58.91,Default,,0,0,0,,Кэрол мен Сейсенбі дебютке билет алды
Dialogue: 0,0:01:59.41,0:02:01.99,Default,,0,0,0,,Бірақ бұл дүниеде бұл оңай емес...
Dialogue: 0,0:02:02.49,0:02:06.29,Default,,0,0,0,,Алда әлі ұзақ және бұралаң жол бар.
Dialogue: 0,0:02:06.41,0:02:08.08,Default,,0,0,0,,Иә... Солай ма?
Dialogue: 0,0:02:08.21,0:02:09.75,Default,,0,0,0,,Жоқ, солай.
Dialogue: 0,0:02:09.87,0:02:13.34,Default,,0,0,0,,Мені дірілдетпе, мен бастайын.
Dialogue: 0,0:02:19.59,0:02:21.85,Default,,0,0,0,,Жоқ, бұл балалар қауіпті.
Dialogue: 0,0:02:22.22,0:02:24.01,Default,,0,0,0,,Сүйкімді (Әйел В) Жоғары көтерілу~
Dialogue: 0,0:02:24.51,0:02:27.14,Default,,0,0,0,,Маған екі дауыстың қабаттасуы ұнайды, солай емес пе?
Dialogue: 0,0:02:27.35,0:02:28.18,Default,,0,0,0,,Мен оны жақсы көремін!
Dialogue: 0,0:02:28.39,0:02:30.98,Default,,0,0,0,,Мен мұндай нәрсені естігеніме біраз болды.
Dialogue: 0,0:02:31.10,0:02:33.44,Default,,0,0,0,,Джинге бірдеңе дұрыс емес.
Dialogue: 0,0:02:38.32,0:02:38.70,Default,,0,0,0,,Бұл күтпеген оқиға!
Dialogue: 0,0:02:38.70,0:02:40.70,Default,,0,0,0,,Бұл күтпеген оқиға!
Dialogue: 0,0:02:38.70,0:02:40.70,Default,,0,0,0,,«Аллен бөлмесіне» қош келдіңіз!
Dialogue: 0,0:02:40.70,0:02:40.82,Default,,0,0,0,,Бұл күтпеген оқиға!
Dialogue: 0,0:02:40.82,0:02:42.87,Default,,0,0,0,,Бұл күтпеген оқиға!
Dialogue: 0,0:02:40.82,0:02:42.87,Default,,0,0,0,,Осы аптада біз танымал жұлдыздарды шақырамыз.
Dialogue: 0,0:02:42.99,0:02:45.12,Default,,0,0,0,,Ерекше уақыт өткізейік
Dialogue: 0,0:02:45.37,0:02:48.25,Default,,0,0,0,,Бүгінгі қонақ – көрнекті суретші
Dialogue: 0,0:02:48.37,0:02:49.58,Default,,0,0,0,,Ең жарқын Марста -
Dialogue: 0,0:02:49.71,0:02:53.38,Default,,0,0,0,,Анджеламен болған драмалық шайқас бәрінің есінде, солай ма?
Dialogue: 0,0:02:53.50,0:02:55.46,Default,,0,0,0,,Кэрол және сейсенбі
Dialogue: 0,0:02:55.59,0:02:58.51,Default,,0,0,0,,Бұл күтпеген оқиға!
Dialogue: 0,0:03:00.01,0:03:02.09,Default,,0,0,0,,Жеңімпаз Анжела болды...
Dialogue: 0,0:03:02.64,0:03:03.47,Default,,0,0,0,,Назар аударған нәрсе...
Dialogue: 0,0:03:03.60,0:03:05.18,Default,,0,0,0,,Мүмкін бұл сендер шығарсыңдар?
Dialogue: 0,0:03:05.51,0:03:06.56,Default,,0,0,0,,Иә, Юта Отокоцу
Dialogue: 0,0:03:06.68,0:03:08.06,Default,,0,0,0,,Рахмет
Dialogue: 0,0:03:08.18,0:03:10.18,Default,,0,0,0,,Атақты болу қандай сезімде?
Dialogue: 0,0:03:10.31,0:03:13.06,Default,,0,0,0,,Мм, бұл әйгілі шығар?
Dialogue: 0,0:03:13.23,0:03:15.73,Default,,0,0,0,,Егер сіз қарапайым адам болсаңыз, мен сізді бағдарламаға шақырмаймын.
Dialogue: 0,0:03:15.86,0:03:17.07,Default,,0,0,0,,(аудитория күлкі)
Dialogue: 0,0:03:17.48,0:03:18.78,Default,,0,0,0,,Сейсенбі Сіз ше?
Dialogue: 0,0:03:18.90,0:03:19.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:19.78,0:03:21.49,Default,,0,0,0,,Сіз оны шынымен сезбейтін сияқтысыз ба?
Dialogue: 0,0:03:21.61,0:03:22.95,Default,,0,0,0,,меніңше, бұл – нағыз ақымақтық шыңы… Яғни—
Dialogue: 0,0:03:23.20,0:03:25.78,Default,,0,0,0,,Мм... үлпілдек.
Dialogue: 0,0:03:25.91,0:03:27.70,Default,,0,0,0,,Хаха, жарайды, тынышталыңыз.
Dialogue: 0,0:03:27.83,0:03:28.66,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:29.08,0:03:30.33,Default,,0,0,0,,Құрылуына не себеп болды?
Dialogue: 0,0:03:30.46,0:03:32.83,Default,,0,0,0,,Бірінші рет көпірде кездестік, солай ма?
Dialogue: 0,0:03:32.96,0:03:36.04,Default,,0,0,0,,Мм... мен Альба қаласына келген соң.
Dialogue: 0,0:03:36.38,0:03:39.21,Default,,0,0,0,,Мені үнемі тыңдайтын ешкім жоқ
Dialogue: 0,0:03:39.34,0:03:41.88,Default,,0,0,0,,Чуу ғана тоқтады.
Dialogue: 0,0:03:42.18,0:03:45.93,Default,,0,0,0,,Бұл Кэрол мен сейсенбінің алғашқы байланысы болды.
Dialogue: 0,0:03:46.05,0:03:47.81,Default,,0,0,0,,Екеуі соқты
Dialogue: 0,0:03:48.18,0:03:50.06,Default,,0,0,0,,Сонымен мен де Instagram-ды бастадым.
Dialogue: 0,0:03:50.18,0:03:52.06,Default,,0,0,0,,Әрине, мен де сенің соңынан еремін.
Dialogue: 0,0:03:52.19,0:03:54.06,Default,,0,0,0,,Ах... Рахмет.
Dialogue: 0,0:03:54.35,0:03:56.69,Default,,0,0,0,,Және ең жарқын Марс.
Dialogue: 0,0:03:56.94,0:03:59.90,Default,,0,0,0,,Анджеланы алғаш көргенде қандай әсер алғанын сұрасам бола ма?
Dialogue: 0,0:04:00.15,0:04:02.40,Default,,0,0,0,,Мынау... сүйкімді.
Dialogue: 0,0:04:02.53,0:04:05.07,Default,,0,0,0,,Иә, менің ойымша, бұл аура деп аталады.
Dialogue: 0,0:04:05.20,0:04:09.08,Default,,0,0,0,,Ол сүйкімді ғана емес, сонымен қатар жақсы әнші. Оған бірдеңе дұрыс емес сияқты.
Dialogue: 0,0:04:09.41,0:04:13.41,Default,,0,0,0,,Түсінемін, бірақ сіз онымен бірдей күрестіңіз.
Dialogue: 0,0:04:13.71,0:04:17.00,Default,,0,0,0,,Қалай ойлайсыңдар, Анджела сендерге жақсы қарсылас бола ма?
Dialogue: 0,0:04:17.13,0:04:17.92,Default,,0,0,0,,Қарсылас?
Dialogue: 0,0:04:18.04,0:04:19.96,Default,,0,0,0,,Мен бұл туралы ешқашан ойлаған емеспін.
Dialogue: 0,0:04:20.09,0:04:21.01,Default,,0,0,0,,Сіздің көзіңізде емес пе?
Dialogue: 0,0:04:21.13,0:04:22.55,Default,,0,0,0,,Е... жоқ...
Dialogue: 0,0:04:22.97,0:04:26.26,Default,,0,0,0,,Ал, енді Анджеланы артқа тастап, сендерге қайта оралайық.
Dialogue: 0,0:04:26.39,0:04:27.97,Default,,0,0,0,,Бір минут күтіңіз!
Dialogue: 0,0:04:28.10,0:04:30.52,Default,,0,0,0,,А... жоқ... у...
Dialogue: 0,0:04:31.52,0:04:34.23,Default,,0,0,0,,Ха... мен жасадым.
Dialogue: 0,0:04:34.35,0:04:37.19,Default,,0,0,0,,Жоғарыда айтқанымды қысқарта аласыз ба?
Dialogue: 0,0:04:37.56,0:04:39.90,Default,,0,0,0,,Бұл жайбарақат сөйлесетін уақыт емес.
Dialogue: 0,0:04:40.02,0:04:42.19,Default,,0,0,0,,Келесі кезекте Rolling Stone-ге берген сұхбат.
Dialogue: 0,0:04:42.53,0:04:43.95,Default,,0,0,0,,Сондай-ақ «Guardian» және «Pitchfork»
Dialogue: 0,0:04:44.07,0:04:45.03,Default,,0,0,0,,Әңгіме келе жатыр.
Dialogue: 0,0:04:45.45,0:04:46.99,Default,,0,0,0,,Өтірік Бұл керемет
Dialogue: 0,0:04:47.12,0:04:48.78,Default,,0,0,0,,...
Dialogue: 0,0:04:48.91,0:04:50.79,Default,,0,0,0,,Кэрол және сейсенбі!
Dialogue: 0,0:04:52.20,0:04:53.16,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:04:56.46,0:04:58.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:03.88,0:05:05.05,Default,,0,0,0,,Тао келмей ме?
Dialogue: 0,0:05:05.68,0:05:08.59,Default,,0,0,0,,Сен де бүгін бос емес сияқтысың...
Dialogue: 0,0:05:13.68,0:05:14.93,Default,,0,0,0,,Абсолютті өтірік
Dialogue: 0,0:05:15.06,0:05:16.39,Default,,0,0,0,,Мен оны естимін.
Dialogue: 0,0:05:17.56,0:05:20.02,Default,,0,0,0,,бастайық.
Dialogue: 0,0:05:20.52,0:05:23.61,Default,,0,0,0,,Жаңа дәуірдің дивасы, тарихта қалатын эстрада жұлдызы.
Dialogue: 0,0:05:23.74,0:05:26.32,Default,,0,0,0,,Ақырында жамылғыны шешетін кез келді.
Dialogue: 0,0:05:26.70,0:05:28.16,Default,,0,0,0,,Ең жарқын жазбалар -
Dialogue: 0,0:05:28.28,0:05:31.87,Default,,0,0,0,,Әнші Анджеланы шын жүректен құттықтаймыз және қарсы аламыз.
Dialogue: 0,0:05:31.99,0:05:33.08,Default,,0,0,0,,(Репортерлердің шапалақтауы және ысырма дыбысы)
Dialogue: 0,0:05:33.45,0:05:34.95,Default,,0,0,0,,Ой, басталды ма?
Dialogue: 0,0:05:35.08,0:05:36.33,Default,,0,0,0,,Ең жарқын жазбалар -
Dialogue: 0,0:05:36.46,0:05:39.25,Default,,0,0,0,,Келісімшартқа 20 миллион иен дайындалған деген қауесет бар...
Dialogue: 0,0:05:39.38,0:05:40.33,Default,,0,0,0,,Не!
Dialogue: 0,0:05:40.63,0:05:43.92,Default,,0,0,0,,Мен оған тұрарлық екеніне сенімдімін.
Dialogue: 0,0:05:44.05,0:05:48.22,Default,,0,0,0,,Ол жаңа дәуірді ашатын өнерпаздардың бірі болары сөзсіз.
Dialogue: 0,0:05:48.55,0:05:50.51,Default,,0,0,0,,Бірақ бұл бәрі емес.
Dialogue: 0,0:05:50.80,0:05:53.26,Default,,0,0,0,,Анджеланың дебюттік әні келесі айда шығады.
Dialogue: 0,0:05:53.39,0:05:54.93,Default,,0,0,0,,Ақырында шығарылды
Dialogue: 0,0:05:55.06,0:05:57.48,Default,,0,0,0,,(Тілшілер айқайлайды)
Dialogue: 0,0:05:57.94,0:06:02.07,Default,,0,0,0,,Бұл менің бірінші рет жазуым еді, түсінбеген жерлерім көп болды...
Dialogue: 0,0:06:02.19,0:06:04.19,Default,,0,0,0,,Жақсы ән шығарғаныма сенімдімін.
Dialogue: 0,0:06:04.32,0:06:05.44,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:06:05.57,0:06:07.99,Default,,0,0,0,,Ал, бүгін біз оны бірінші рет көрсетеміз.
Dialogue: 0,0:06:08.36,0:06:11.74,Default,,0,0,0,,Бәріміз Анджеланың дебюттік әнін тыңдайық.
Dialogue: 0,0:06:11.87,0:06:13.87,Default,,0,0,0,,«Қайтадан дем ал»
Dialogue: 0,0:06:14.37,0:06:20.29,Default,,0,0,0,,(Сахналық музыка)
Dialogue: 0,0:06:26.30,0:06:32.01,Default,,0,0,0,,♪ Бүгін мен жақсы білетін дүниенің байланысынан құтылатын күн.
Dialogue: 0,0:06:32.22,0:06:35.10,Default,,0,0,0,,♪ Жаңа нәрсені іздеп, алға ұмтылыңыз
Dialogue: 0,0:06:35.35,0:06:37.98,Default,,0,0,0,,♪ Мен әрі қарай жүруім керек
Dialogue: 0,0:06:38.23,0:06:39.64,Default,,0,0,0,,♪ Өзімшілірек болыңыз
Dialogue: 0,0:06:39.81,0:06:44.02,Default,,0,0,0,,♪ Бастаманы қолға алу жаман емес.
Dialogue: 0,0:06:44.19,0:06:46.48,Default,,0,0,0,,♪ Жаңа күн басталады
Dialogue: 0,0:06:46.61,0:06:49.82,Default,,0,0,0,,♪ Бұл ғажайып сияқты
Dialogue: 0,0:06:49.95,0:06:51.24,Default,,0,0,0,,♪ Жаңа өмір
Dialogue: 0,0:06:51.45,0:06:52.74,Default,,0,0,0,,♪ Мен сондай биікпін
Dialogue: 0,0:06:52.95,0:06:55.79,Default,,0,0,0,,♪ Балам, жақсы, мен қазір өзімді тамаша сезінемін
Dialogue: 0,0:06:55.91,0:06:57.16,Default,,0,0,0,,♪ Жаңа өмір
Dialogue: 0,0:06:57.41,0:06:58.66,Default,,0,0,0,,♪ Мен сондай биікпін
Dialogue: 0,0:06:58.96,0:07:01.67,Default,,0,0,0,,♪ Балам, бәрі жақсы, мен қазір өзімді тамаша сезінемін
Dialogue: 0,0:07:01.96,0:07:03.29,Default,,0,0,0,,♪ Жаңа өмір
Dialogue: 0,0:07:03.46,0:07:04.84,Default,,0,0,0,,♪ Мен сондай биікпін
Dialogue: 0,0:07:04.96,0:07:07.84,Default,,0,0,0,,♪ Балам, қазір бәрі жақсы
Dialogue: 0,0:07:07.96,0:07:09.34,Default,,0,0,0,,♪ Жаңа өмір
Dialogue: 0,0:07:09.47,0:07:10.76,Default,,0,0,0,,♪ Мен сондай биікпін
Dialogue: 0,0:07:10.97,0:07:13.59,Default,,0,0,0,,♪ Балам, жақсы, мен қазір өзімді тамаша сезінемін
Dialogue: 0,0:07:13.97,0:07:19.52,Default,,0,0,0,,♪ Қайтадан дем алыңыз
Dialogue: 0,0:07:19.98,0:07:25.82,Default,,0,0,0,,♪ Мен жұмақ тапқым келеді
Dialogue: 0,0:07:25.98,0:07:31.74,Default,,0,0,0,,♪ Қайтадан дем алыңыз
Dialogue: 0,0:07:31.95,0:07:37.54,Default,,0,0,0,,♪ Мен жұмақ тапқым келеді
Dialogue: 0,0:07:41.08,0:07:42.00,Default,,0,0,0,,О...
Dialogue: 0,0:07:42.12,0:07:47.00,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:07:47.80,0:07:49.21,Default,,0,0,0,,Рахмет Анджела
Dialogue: 0,0:07:49.63,0:07:50.76,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:07:50.88,0:07:52.34,Default,,0,0,0,,Керемет болды
Dialogue: 0,0:07:52.68,0:07:55.55,Default,,0,0,0,,Қазірдің өзінде 2 миллионнан астам жазылушы бар ма?
Dialogue: 0,0:07:55.76,0:07:58.51,Default,,0,0,0,,Сіз кенеттен артта қалғандай сезінесіз бе?
Dialogue: 0,0:07:58.64,0:08:00.64,Default,,0,0,0,,Не? Келесі менің кезегім.
Dialogue: 0,0:08:00.77,0:08:02.69,Default,,0,0,0,,Келісім-шарттың күні шешілді ме?
Dialogue: 0,0:08:02.81,0:08:06.31,Default,,0,0,0,,Аа, кестең де бос, менімен бірге жүр.
Dialogue: 0,0:08:06.56,0:08:10.99,Default,,0,0,0,,Қараңдар, мен саған үлкен келісім-шарт беремін.
Dialogue: 0,0:08:11.28,0:08:15.95,Default,,0,0,0,,Не десем де, жоқшылықта өмір сүремін.
Dialogue: 0,0:08:16.24,0:08:19.37,Default,,0,0,0,,Біз қашан дебют жасай аламыз?
Dialogue: 0,0:08:19.49,0:08:20.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:23.87,0:08:25.75,Default,,0,0,0,,Міне, ағай.
Dialogue: 0,0:08:25.88,0:08:27.88,Default,,0,0,0,,Осы екеуінің қайсысы екенін сұрап тұрмын. Сен бе?
Dialogue: 0,0:08:29.67,0:08:31.30,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:08:31.88,0:08:34.01,Default,,0,0,0,,Кешіріңіз, мен оған үйренбегенмін.
Dialogue: 0,0:08:34.13,0:08:36.34,Default,,0,0,0,,Ағай, сіз осы жақтан емессіз бе?
Dialogue: 0,0:08:36.47,0:08:37.80,Default,,0,0,0,,Саяхат кезінде
Dialogue: 0,0:08:38.18,0:08:40.31,Default,,0,0,0,,Мен іскерлікпен келдім...
Dialogue: 0,0:08:40.64,0:08:42.10,Default,,0,0,0,,Хмм…
Dialogue: 0,0:08:42.23,0:08:43.60,Default,,0,0,0,,Шынайы ма? Шынайы ма?
Dialogue: 0,0:08:44.02,0:08:46.56,Default,,0,0,0,,Яббе – Марбрада пайда болған атақты адам.
Dialogue: 0,0:08:46.98,0:08:48.31,Default,,0,0,0,,Бір нәрсені айт
Dialogue: 0,0:08:48.44,0:08:50.07,Default,,0,0,0,,Иә, осылай қараңыз (ысырма дыбысы)
Dialogue: 0,0:08:50.27,0:08:50.94,Default,,0,0,0,,Иә...
Dialogue: 0,0:08:51.07,0:08:53.69,Default,,0,0,0,,Сіз киіміңізді осындай жерде жуасыз ба? Қандай бейшара?
Dialogue: 0,0:08:53.90,0:08:56.07,Default,,0,0,0,,Сәлем! Бұл ыңғайсыздық болса да
Dialogue: 0,0:08:56.49,0:08:59.99,Default,,0,0,0,,Әй, ән айт. Ол шу шығарады.
Dialogue: 0,0:09:00.12,0:09:01.41,Default,,0,0,0,,Сені махаббат сиқырымен баурап алатын боламын.
Dialogue: 0,0:09:02.04,0:09:05.33,Default,,0,0,0,,А? Дұрыс, ақсақал, мені мазалама.
Dialogue: 0,0:09:05.75,0:09:07.29,Default,,0,0,0,,Ух... уау
Dialogue: 0,0:09:07.42,0:09:08.33,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:09:08.83,0:09:10.25,Default,,0,0,0,,Не... бұл не?
Dialogue: 0,0:09:10.63,0:09:11.30,Default,,0,0,0,,Сен
Dialogue: 0,0:09:11.42,0:09:12.96,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:09:13.09,0:09:15.13,Default,,0,0,0,,Мазасыздық деп айтасыз.
Dialogue: 0,0:09:15.47,0:09:16.26,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:16.47,0:09:20.47,Default,,0,0,0,,Мен... түсіндім! Мен түсіндім, сондықтан мені жіберіңіз
Dialogue: 0,0:09:20.97,0:09:23.68,Default,,0,0,0,,Бұл қарт кім?
Dialogue: 0,0:09:24.06,0:09:25.10,Default,,0,0,0,,Аа...
Dialogue: 0,0:09:25.23,0:09:27.19,Default,,0,0,0,,Рахмет, бұл пайдалы болды.
Dialogue: 0,0:09:27.31,0:09:28.69,Default,,0,0,0,,Егер мен оны сол күйінде қалдырсам...
Dialogue: 0,0:09:28.81,0:09:31.27,Default,,0,0,0,,Сен оларды жұдырықтап жібере жаздадың.
Dialogue: 0,0:09:31.40,0:09:33.19,Default,,0,0,0,,Сіз білдіңіз бе?
Dialogue: 0,0:09:35.03,0:09:36.65,Default,,0,0,0,,Ағай, атыңыз кім?
Dialogue: 0,0:09:37.57,0:09:38.61,Default,,0,0,0,,Дан
Dialogue: 0,0:09:39.12,0:09:40.91,Default,,0,0,0,,Дан... Мен...
Dialogue: 0,0:09:41.03,0:09:42.91,Default,,0,0,0,,Кэрол мен Сейсенбі, солай ма?
Dialogue: 0,0:09:43.04,0:09:44.79,Default,,0,0,0,,Ах... (сейсенбі) Сіз білесіз бе?
Dialogue: 0,0:09:44.91,0:09:46.25,Default,,0,0,0,,Себебі мен оны теледидардан көрдім.
Dialogue: 0,0:09:47.83,0:09:49.13,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:49.58,0:09:51.84,Default,,0,0,0,,Әй, бұрын қолыңнан ұстап алған не болды?
Dialogue: 0,0:09:51.96,0:09:52.80,Default,,0,0,0,,Айкидо
Dialogue: 0,0:09:52.92,0:09:53.63,Default,,0,0,0,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,0:09:53.75,0:09:56.47,Default,,0,0,0,,Қалайсың? айт маған айт
Dialogue: 0,0:09:58.34,0:10:01.80,Default,,0,0,0,,Тыңдаңыз, әрбір келіссөзде сезім маңызды.
Dialogue: 0,0:10:01.93,0:10:03.47,Default,,0,0,0,,Қобалжымаңыз және сенімді жүріңіз
Dialogue: 0,0:10:03.60,0:10:04.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:07.14,0:10:07.77,Default,,0,0,0,,Хмм?
Dialogue: 0,0:10:07.89,0:10:09.06,Default,,0,0,0,,А... Анжела
Dialogue: 0,0:10:10.86,0:10:13.32,Default,,0,0,0,,О? Көп уақыт өтті.
Dialogue: 0,0:10:13.86,0:10:17.65,Default,,0,0,0,,Сәлем Дария, осы теорияға көмектескеніңіз үшін рахмет.
Dialogue: 0,0:10:17.78,0:10:18.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:18.65,0:10:21.78,Default,,0,0,0,,Мен Алленнің бөлмесін кездейсоқ көрдім.
Dialogue: 0,0:10:21.91,0:10:23.87,Default,,0,0,0,,Екеуің кездесіп қалдыңдар.
Dialogue: 0,0:10:24.12,0:10:26.95,Default,,0,0,0,,Кейбіреулер мұны әуесқойлық деп айтуы мүмкін, бірақ...
Dialogue: 0,0:10:27.08,0:10:29.21,Default,,0,0,0,,Бұл сізге жаңалық болғанына қуаныштымын.
Dialogue: 0,0:10:29.33,0:10:30.21,Default,,0,0,0,,Гррр…
Dialogue: 0,0:10:30.33,0:10:32.29,Default,,0,0,0,,Мен жеңуден құр қалдым...
Dialogue: 0,0:10:32.42,0:10:34.88,Default,,0,0,0,,Жеңімпаздан гөрі көзге түскенімді айтты.
Dialogue: 0,0:10:35.00,0:10:36.92,Default,,0,0,0,,Бұл ұят.
Dialogue: 0,0:10:37.26,0:10:38.59,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:10:38.72,0:10:41.84,Default,,0,0,0,,Мен шынымен түсінбеймін, бірақ еш қиындық туғызбауыңызды өтінемін.
Dialogue: 0,0:10:41.97,0:10:43.51,Default,,0,0,0,,Балалар (сейсенбі және Кэрол) А...
Dialogue: 0,0:10:43.72,0:10:45.64,Default,,0,0,0,,Мен аздап назар аударғандықтан...
Dialogue: 0,0:10:45.77,0:10:47.77,Default,,0,0,0,,Көңіл-күйіңіз жоқ деп ойлаймын.
Dialogue: 0,0:10:48.10,0:10:51.44,Default,,0,0,0,,Мен жаңадан келген Марс Грэмми сыйлығын ұтып аламын.
Dialogue: 0,0:10:51.56,0:10:52.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:52.31,0:10:54.77,Default,,0,0,0,,Әрине, сендер де бізді нысанаға алып отырсыңдар, солай ма?
Dialogue: 0,0:10:54.90,0:10:55.52,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:55.65,0:10:57.69,Default,,0,0,0,,Тезірек дебют жаса.
Dialogue: 0,0:10:59.11,0:11:02.28,Default,,0,0,0,,Бәсекелестік болмаған кезде қызықсыз.
Dialogue: 0,0:11:03.49,0:11:06.99,Default,,0,0,0,,Мен сені бұл жолы әбден талқандаймын.
Dialogue: 0,0:11:08.41,0:11:10.87,Default,,0,0,0,,Сіз мені қарсылас деп ойлайсыз ба?
Dialogue: 0,0:11:11.00,0:11:12.83,Default,,0,0,0,,Бәлкім, бұл оның да бір түрі шығар
Dialogue: 0,0:11:13.08,0:11:14.34,Default,,0,0,0,,Мен жеңіле алмаймын
Dialogue: 0,0:11:14.46,0:11:15.67,Default,,0,0,0,,Иә
Dialogue: 0,0:11:25.55,0:11:29.23,Default,,0,0,0,,Тыңдаңыз, келіссөздер алдында бір нәрсені растағым келеді.
Dialogue: 0,0:11:29.73,0:11:32.98,Default,,0,0,0,,Қарапайым тілмен айтқанда, сіз ақшаның немесе еркіндіктің қайсысын таңдар едіңіз?
Dialogue: 0,0:11:33.10,0:11:34.86,Default,,0,0,0,,Иә? Сен не туралы айтып тұрсың?
Dialogue: 0,0:11:34.98,0:11:36.02,Default,,0,0,0,,Осымен.
Dialogue: 0,0:11:36.27,0:11:39.49,Default,,0,0,0,,Аздап ымыраға келу керек болса да, сатып, ақша тапқыңыз келе ме?
Dialogue: 0,0:11:39.61,0:11:42.82,Default,,0,0,0,,Егер ол жақсы сатылмаса да, біз мұны өз жолымызбен жасағымыз келе ме?
Dialogue: 0,0:11:43.03,0:11:43.95,Default,,0,0,0,,Оны тек негізгі денені жойған кезде ғана қолдана аласың. Сынап көр.
Dialogue: 0,0:11:44.07,0:11:44.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:45.03,0:11:46.87,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:47.37,0:11:48.91,Default,,0,0,0,,Екеуі де!
Dialogue: 0,0:11:49.04,0:11:51.54,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:11:52.92,0:11:53.92,Default,,0,0,0,,Сізге рахмет...
Dialogue: 0,0:11:54.04,0:11:57.34,Default,,0,0,0,,Биылғы хабар әсіресе тамаша болды.
Dialogue: 0,0:11:57.46,0:11:59.76,Default,,0,0,0,,Көрермендердің пікірлері де жақсы деп үміттенемін.
Dialogue: 0,0:11:59.92,0:12:01.26,Default,,0,0,0,,Кете барсам, қоштасу сүйісін бересің бе?
Dialogue: 0,0:12:01.38,0:12:02.63,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:12:02.76,0:12:05.51,Default,,0,0,0,,Біз күтпеген сұраулар алып жатырмыз.
Dialogue: 0,0:12:05.64,0:12:07.05,Default,,0,0,0,,Кэрол иә?
Dialogue: 0,0:12:07.56,0:12:09.43,Default,,0,0,0,,Өзін отбасы мүшесімін деп мәлімдеген біреуден -
Dialogue: 0,0:12:09.56,0:12:12.81,Default,,0,0,0,,Көптеген адамдар сізбен кездескісі келеді.
Dialogue: 0,0:12:13.19,0:12:14.19,Default,,0,0,0,,Көп пе?
Dialogue: 0,0:12:14.35,0:12:19.32,Default,,0,0,0,,Бұл дүниеде атақ-даңққа бөленсең, ағайын-туыс көбейеді.
Dialogue: 0,0:12:19.44,0:12:20.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:20.61,0:12:24.53,Default,,0,0,0,,Әрине, мен сізді таныстыра алар едім, бірақ сіз қалай ойлайсыз?
Dialogue: 0,0:12:24.66,0:12:27.87,Default,,0,0,0,,Хмм, кешіріңіз.
Dialogue: 0,0:12:28.16,0:12:29.95,Default,,0,0,0,,Эй, мен не істеуім керек...
Dialogue: 0,0:12:30.37,0:12:33.37,Default,,0,0,0,,Иә, кенет болғаным үшін кешіріңіз.
Dialogue: 0,0:12:33.50,0:12:36.17,Default,,0,0,0,,Алдымен келісімшарт туралы айтамыз ба?
Dialogue: 0,0:12:38.09,0:12:40.25,Default,,0,0,0,,Brightest Records ресми түрде...
Dialogue: 0,0:12:40.67,0:12:44.97,Default,,0,0,0,,Мен Carole & Tuesday компаниясымен келісім жасағым келеді.
Dialogue: 0,0:12:45.30,0:12:48.05,Default,,0,0,0,,Сізбен жұмыс істеудің қандай пайдасы бар?
Dialogue: 0,0:12:48.18,0:12:52.85,Default,,0,0,0,,Қазіргі заманда әртістер әндерін өз бетінше сата алады.
Dialogue: 0,0:12:52.98,0:12:56.40,Default,,0,0,0,,Әрине, мұны өз бетінше жасаған дұрыс.
Dialogue: 0,0:12:56.52,0:12:58.48,Default,,0,0,0,,Шығармашылық бақылау қолжетімді
Dialogue: 0,0:12:58.98,0:13:02.19,Default,,0,0,0,,Бірақ біз жасай алатын нәрселер бар, өйткені біз ірі компаниямыз.
Dialogue: 0,0:13:02.53,0:13:04.61,Default,,0,0,0,,БАҚ-пен де тығыз байланыстамыз.
Dialogue: 0,0:13:04.74,0:13:07.32,Default,,0,0,0,,Сондай-ақ ауқымды акцияларды өткізуге болады.
Dialogue: 0,0:13:07.66,0:13:09.62,Default,,0,0,0,,Және, әрине, суретшінің ниеті ...
Dialogue: 0,0:13:09.74,0:13:12.16,Default,,0,0,0,,Мен оны барынша құрметтеуге ниеттемін.
Dialogue: 0,0:13:12.58,0:13:17.00,Default,,0,0,0,,Бізде сіздің сеніміңізді ақтайтын дәлелденген тәжірибеміз бар.
Dialogue: 0,0:13:17.29,0:13:18.83,Default,,0,0,0,,Аа...
Dialogue: 0,0:13:18.96,0:13:21.75,Default,,0,0,0,,Алдымен мен сізден жобаны көрсетуіңізді сұрауым керек.
Dialogue: 0,0:13:22.05,0:13:26.59,Default,,0,0,0,,Бұдан былай шарттар туралы айтатын боламыз. Балалар, сыртта күтіңдер.
Dialogue: 0,0:13:26.72,0:13:28.14,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:13:29.64,0:13:31.39,Default,,0,0,0,,Хаа…
Dialogue: 0,0:13:31.89,0:13:33.93,Default,,0,0,0,,Жақсы әңгіме сияқты естіледі, солай емес пе?
Dialogue: 0,0:13:34.06,0:13:37.19,Default,,0,0,0,,Бұл үлкен компания сияқты.
Dialogue: 0,0:13:38.56,0:13:41.11,Default,,0,0,0,,Ата-анаңды табасың деп үміттенемін.
Dialogue: 0,0:13:41.52,0:13:44.36,Default,,0,0,0,,Не? А... жақсы
Dialogue: 0,0:13:44.49,0:13:46.32,Default,,0,0,0,,Енді сізбен кездесудің қажеті жоқ.
Dialogue: 0,0:13:46.61,0:13:49.11,Default,,0,0,0,,Бірақ маған көп қоңыраулар түсіп жатыр.
Dialogue: 0,0:13:49.41,0:13:51.41,Default,,0,0,0,,Оның шын ба, жоқ па, білмеймін.
Dialogue: 0,0:13:51.53,0:13:53.37,Default,,0,0,0,,Ол бірінші кезекте тасталды.
Dialogue: 0,0:13:53.70,0:13:56.04,Default,,0,0,0,,Қазір мені ата-ана десең де.
Dialogue: 0,0:13:56.16,0:13:58.62,Default,,0,0,0,,Мүмкін себебі бар шығар
Dialogue: 0,0:13:58.75,0:14:02.04,Default,,0,0,0,,Неге екенін білмесем, бақыттырақпын
Dialogue: 0,0:14:03.50,0:14:07.30,Default,,0,0,0,,Көрдіңіз бе, балалар ата-анасын таңдай алмайды.
Dialogue: 0,0:14:09.22,0:14:11.72,Default,,0,0,0,,(қолдаушылардың қошеметі)
Dialogue: 0,0:14:11.85,0:14:15.52,Default,,0,0,0,,Қазір! айтуымыз керек
Dialogue: 0,0:14:15.64,0:14:18.27,Default,,0,0,0,,Ал мен уәде берейін
Dialogue: 0,0:14:18.39,0:14:21.15,Default,,0,0,0,,Марстан заңсыз иммигранттарды алып тастаңыз!
Dialogue: 0,0:14:21.40,0:14:23.90,Default,,0,0,0,,Марстың бір болатын уақыты келді!
Dialogue: 0,0:14:24.02,0:14:25.15,Default,,0,0,0,,(қолдаушылардың қошеметі)
Dialogue: 0,0:14:25.53,0:14:27.28,Default,,0,0,0,,Енді президенттік сайлау
Dialogue: 0,0:14:27.40,0:14:28.36,Default,,0,0,0,,Валери Симмонс-
Dialogue: 0,0:14:28.49,0:14:30.45,Default,,0,0,0,,Баяндама беріледі
Dialogue: 0,0:14:31.12,0:14:34.79,Default,,0,0,0,,Мұнда оны қолдайтындар көп.
Dialogue: 0,0:14:35.45,0:14:38.58,Default,,0,0,0,,Аа, қазір сахнада тағы бір адам бар.
Dialogue: 0,0:14:42.21,0:14:45.34,Default,,0,0,0,,Бүгін маған бір күшті одақтас келді.
Dialogue: 0,0:14:45.46,0:14:48.59,Default,,0,0,0,,Бұл менің қымбатты ұлым Спенсер.
Dialogue: 0,0:14:48.72,0:14:54.39,Default,,0,0,0,,(Қолдаушылардың қошеметі мен қошеметі)
Dialogue: 0,0:14:56.31,0:15:01.48,Default,,0,0,0,,Анам апам екеумізді жалғыз өсірді.
Dialogue: 0,0:15:01.60,0:15:05.77,Default,,0,0,0,,Біз үшін үнемі ойланып, әрекет еткен.
Dialogue: 0,0:15:06.15,0:15:09.74,Default,,0,0,0,,Сонымен қатар, мен Марстағы адамдар туралы ойлаймын ...
Dialogue: 0,0:15:09.86,0:15:11.57,Default,,0,0,0,,Біз шара қолдандық.
Dialogue: 0,0:15:12.07,0:15:15.24,Default,,0,0,0,,Ана – Марста өмір сүретін барлық адамдардың анасы.
Dialogue: 0,0:15:15.37,0:15:17.83,Default,,0,0,0,,Әке болғысы келетін адам.
Dialogue: 0,0:15:17.95,0:15:22.71,Default,,0,0,0,,Сондықтан оның айтқанын тыңдаңыз.
Dialogue: 0,0:15:23.33,0:15:27.30,Default,,0,0,0,,Ал анамды менімен бірге қолдауыңызды сұраймын.
Dialogue: 0,0:15:27.67,0:15:33.01,Default,,0,0,0,,Ол болашақта Марсты басқаратын заманауи Марсқа айналуы керек.
Dialogue: 0,0:15:33.14,0:15:38.35,Default,,0,0,0,,(Қолдаушылардың қошеметі мен қошеметі)
Dialogue: 0,0:15:48.15,0:15:49.03,Default,,0,0,0,,Қандай сандар?
Dialogue: 0,0:15:49.15,0:15:50.65,Default,,0,0,0,,Ол созылмайды.
Dialogue: 0,0:15:50.99,0:15:55.20,Default,,0,0,0,,Ах... қосымша шаралар қажет.
Dialogue: 0,0:15:58.41,0:16:00.37,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:16:08.63,0:16:10.26,Default,,0,0,0,,Мен сізге деректерді жібердім.
Dialogue: 0,0:16:10.38,0:16:13.88,Default,,0,0,0,,Мен тексердім. Жұмыс әдеттегідей жылдам.
Dialogue: 0,0:16:14.01,0:16:15.89,Default,,0,0,0,,Менің бәрібір бос уақытым бар.
Dialogue: 0,0:16:16.26,0:16:18.43,Default,,0,0,0,,Бейбіт уақыт көмектеседі
Dialogue: 0,0:16:18.56,0:16:20.52,Default,,0,0,0,,Сіздей білікті тілші...
Dialogue: 0,0:16:20.72,0:16:23.48,Default,,0,0,0,,Өйткені олар мұндай жұмысты қабылдайды.
Dialogue: 0,0:16:23.60,0:16:25.52,Default,,0,0,0,,Бейбітшілік...
Dialogue: 0,0:16:25.85,0:16:28.69,Default,,0,0,0,,Күдікті қарым-қатынасы бар президенттікке кандидатқа...
Dialogue: 0,0:16:28.82,0:16:30.90,Default,,0,0,0,,Сайлау агенті Джерри
Dialogue: 0,0:16:31.19,0:16:34.82,Default,,0,0,0,,Бұл сайлау бейбіт аяқталады деп ойламаймын.
Dialogue: 0,0:16:35.11,0:16:37.07,Default,,0,0,0,,Сіз тіпті қауіпті оқиғаны ұстадыңыз ба?
Dialogue: 0,0:16:39.16,0:16:43.58,Default,,0,0,0,,Ең алдымен соққан желдің дыбысын тыңдау керек шығар.
Dialogue: 0,0:16:46.67,0:16:48.92,Default,,0,0,0,,А... бұл жоба
Dialogue: 0,0:16:49.17,0:16:52.59,Default,,0,0,0,,Бір қарағанда, қалағаныңды істей алатындай жазылған сияқты, бірақ...
Dialogue: 0,0:16:52.72,0:16:55.22,Default,,0,0,0,,Менің ойымша, тым көп шектеулер бар.
Dialogue: 0,0:16:55.59,0:16:57.51,Default,,0,0,0,,Бұл ерікті емес.
Dialogue: 0,0:16:57.64,0:17:00.60,Default,,0,0,0,,Егер сіз бұл дүниеде жеткілікті ұзақ болсаңыз, сіз түсінесіз.
Dialogue: 0,0:17:01.43,0:17:04.06,Default,,0,0,0,,Мен қайда барсам да, олардан жақсы жағдайда...
Dialogue: 0,0:17:04.18,0:17:07.06,Default,,0,0,0,,Мен сізге келісім-шарт беретін жер жоқ деп ойлаймын?
Dialogue: 0,0:17:07.19,0:17:08.98,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:10.23,0:17:11.23,Default,,0,0,0,,Газ!
Dialogue: 0,0:17:11.44,0:17:12.78,Default,,0,0,0,,Сіз қалай ойлайсыз? Сіз шештіңіз бе?
Dialogue: 0,0:17:12.90,0:17:14.45,Default,,0,0,0,,О, әрине.
Dialogue: 0,0:17:14.90,0:17:16.61,Default,,0,0,0,,Мен үзілді-кесілді бас тарттым.
Dialogue: 0,0:17:16.95,0:17:18.16,Default,,0,0,0,,Е...
Dialogue: 0,0:17:18.28,0:17:20.70,Default,,0,0,0,,және келісім-шарт аяқталады
Dialogue: 0,0:17:21.16,0:17:24.16,Default,,0,0,0,,Жоқ, жоқ, балалар өз ниеттеріңізді растадыңыздар.
Dialogue: 0,0:17:24.41,0:17:26.62,Default,,0,0,0,,Сондықтан ешқандай кеңессіз
Dialogue: 0,0:17:26.75,0:17:28.79,Default,,0,0,0,,Бұл әлі де қорқынышты.
Dialogue: 0,0:17:29.04,0:17:30.67,Default,,0,0,0,,Енді не істейсіз?
Dialogue: 0,0:17:30.79,0:17:34.51,Default,,0,0,0,,Балалар, ең жарқын Марсқа назар аудардыңдар.
Dialogue: 0,0:17:34.63,0:17:37.34,Default,,0,0,0,,Енді сіз өз бетіңізше сата аласыз.
Dialogue: 0,0:17:37.51,0:17:39.26,Default,,0,0,0,,Тәуелсіз өндірісті айтасыз ба?
Dialogue: 0,0:17:39.39,0:17:41.64,Default,,0,0,0,,Әндерді құрастыру және тарату
Dialogue: 0,0:17:41.76,0:17:43.52,Default,,0,0,0,,Егер ол сатса, оны мәміле ретінде пайдаланыңыз.
Dialogue: 0,0:17:43.64,0:17:46.81,Default,,0,0,0,,Сіз тіпті қазіргіден жақсырақ шарттармен келісімшарт жасай аласыз.
Dialogue: 0,0:17:47.14,0:17:51.48,Default,,0,0,0,,Басқаша айтқанда, біз өз тәжірибемізді жасауға және өнімдеріміздің құнын арттыруға тырысамыз.
Dialogue: 0,0:17:51.90,0:17:54.23,Default,,0,0,0,,Ол үшін бізге продюсер керек.
Dialogue: 0,0:17:54.36,0:17:55.36,Default,,0,0,0,,Тіпті Эпштейнмен...
Dialogue: 0,0:17:55.49,0:17:57.03,Default,,0,0,0,,Джордж Мартин мұнда болмаса...
Dialogue: 0,0:17:57.15,0:17:58.49,Default,,0,0,0,,Бұл ештеңені білдірмейді.
Dialogue: 0,0:17:58.86,0:18:00.41,Default,,0,0,0,,Кім? (сейсенбі) Келіңіздер ме?
Dialogue: 0,0:18:00.70,0:18:03.12,Default,,0,0,0,,Әрбір ұлы суретшінің сахна артында...
Dialogue: 0,0:18:03.24,0:18:06.33,Default,,0,0,0,,Бұл бізде жоғары деңгейлі продюсер және менеджер бар дегенді білдіреді.
Dialogue: 0,0:18:06.58,0:18:09.54,Default,,0,0,0,,А, мен де өзімді байқамай қойдым.
Dialogue: 0,0:18:09.67,0:18:12.00,Default,,0,0,0,,Бірақ мұндай адамды жұмысқа ала аласыз ба?
Dialogue: 0,0:18:12.13,0:18:14.09,Default,,0,0,0,,Бізде мүлде ақша жоқ.
Dialogue: 0,0:18:14.55,0:18:16.67,Default,,0,0,0,,Әдетте бұл мүмкін емес.
Dialogue: 0,0:18:16.80,0:18:20.84,Default,,0,0,0,,Онда менде әдеттен тыс қозғалысты қолданудан басқа амалым жоқ.
Dialogue: 0,0:18:27.35,0:18:28.69,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,0:18:29.19,0:18:30.15,Default,,0,0,0,,Ал, кеттік.
Dialogue: 0,0:18:30.27,0:18:32.69,Default,,0,0,0,,Не? Күтіңіз... күтіңіз
Dialogue: 0,0:18:34.15,0:18:36.49,Default,,0,0,0,,Сіз шынымен де осындасыз ба?
Dialogue: 0,0:18:36.61,0:18:37.36,Default,,0,0,0,,О
Dialogue: 0,0:18:37.49,0:18:39.57,Default,,0,0,0,,Бір кездері көптеген атақты әндерді жасады.
Dialogue: 0,0:18:39.91,0:18:41.70,Default,,0,0,0,,Аты аңызға айналған продюсер
Dialogue: 0,0:18:41.82,0:18:43.53,Default,,0,0,0,,Аңыз дегеніміз не?
Dialogue: 0,0:18:44.03,0:18:44.66,Default,,0,0,0,,Тұтқындарға арналған екінші жатақхана.
Dialogue: 0,0:18:44.87,0:18:46.75,Default,,0,0,0,,Эй... Эй, сен не істеп жатырсың?
Dialogue: 0,0:18:46.87,0:18:47.75,Default,,0,0,0,,Жібер
Dialogue: 0,0:18:48.37,0:18:50.25,Default,,0,0,0,,Кола! Балалар, кетіңдер!
Dialogue: 0,0:18:50.37,0:18:51.25,Default,,0,0,0,,Тынш
Dialogue: 0,0:18:52.46,0:18:54.25,Default,,0,0,0,,Хаа…
Dialogue: 0,0:18:54.88,0:18:57.05,Default,,0,0,0,,Әрқашан музыканттармен күрес
Dialogue: 0,0:18:57.42,0:18:59.51,Default,,0,0,0,,Ұнамаса, бірінші ашуланамын.
Dialogue: 0,0:18:59.63,0:19:01.68,Default,,0,0,0,,Маған ұнаса да, неге екені белгісіз ашуланамын
Dialogue: 0,0:19:01.80,0:19:04.64,Default,,0,0,0,,Ал оның қайда екені соңғы он жылда белгісіз.
Dialogue: 0,0:19:04.76,0:19:07.43,Default,,0,0,0,,Жаңа ғана кептіріліп жатыр...
Dialogue: 0,0:19:07.56,0:19:09.64,Default,,0,0,0,,Қалыпты адамдар бар ма?
Dialogue: 0,0:19:10.02,0:19:12.52,Default,,0,0,0,,Олар осы жерде жүр деген қауесет бар...
Dialogue: 0,0:19:12.65,0:19:14.86,Default,,0,0,0,,Бұл жерде мекенжай деген сөз жоқ.
Dialogue: 0,0:19:14.98,0:19:16.23,Default,,0,0,0,,Іздесем де бәрібір.
Dialogue: 0,0:19:16.48,0:19:17.90,Default,,0,0,0,,Сонда қалай?
Dialogue: 0,0:19:18.03,0:19:19.15,Default,,0,0,0,,Яғни...
Dialogue: 0,0:19:19.53,0:19:22.24,Default,,0,0,0,,Бұл біздің оларды тартып алудан басқа амалымыз жоқ дегенді білдіреді.
Dialogue: 0,0:19:28.62,0:19:30.41,Default,,0,0,0,,(сейсенбінің қорқынышты дауысы)
Dialogue: 0,0:19:31.62,0:19:32.75,Default,,0,0,0,,Ей!
Dialogue: 0,0:19:33.08,0:19:34.13,Default,,0,0,0,,Кеттік, Чу!
Dialogue: 0,0:19:34.25,0:19:35.59,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:19:35.71,0:19:40.59,Default,,0,0,0,,♪ Күнді айналып өту
Dialogue: 0,0:19:40.88,0:19:43.80,Default,,0,0,0,,♪ Бір-бірімізді қолдап тозақтан қайттық.
Dialogue: 0,0:19:43.93,0:19:48.89,Default,,0,0,0,,♪ Жаңа таңға қарай
Dialogue: 0,0:19:49.31,0:19:53.15,Default,,0,0,0,,♪ Өткенмен үзілу
Dialogue: 0,0:19:53.27,0:19:56.82,Default,,0,0,0,,♪ Қазір біз күткен сәт келді
Dialogue: 0,0:19:57.40,0:20:04.32,Default,,0,0,0,,♪ Бүгін біз қанат жайып, ұшамыз.
Dialogue: 0,0:20:08.04,0:20:11.54,Default,,0,0,0,,♪ Екі әскерді ештеңе жеңе алмайды.
Dialogue: 0,0:20:12.00,0:20:20.26,Default,,0,0,0,,♪ Ештеңе сізді және мені тоқтата алмайды
Dialogue: 0,0:20:23.22,0:20:31.10,Default,,0,0,0,,♪ Екі адамнан тұратын армия
Dialogue: 0,0:20:31.60,0:20:35.10,Default,,0,0,0,,♪ Екі адамнан тұратын армия
Dialogue: 0,0:20:35.77,0:20:40.03,Default,,0,0,0,,♪ Екі әскер
Dialogue: 0,0:20:40.15,0:20:46.99,Default,,0,0,0,,(Адамдар қол соғып, қол шапалақтайды)
Dialogue: 0,0:20:48.99,0:20:50.45,Default,,0,0,0,,(Қарт әйел) Құдайым-ай, сіз қандай құмар әрі жігерлі талапкерсіз.
Dialogue: 0,0:20:50.83,0:20:52.25,Default,,0,0,0,,Уау?
Dialogue: 0,0:20:52.75,0:20:53.37,Default,,0,0,0,,(біртүрлі дауыс)
Dialogue: 0,0:20:53.83,0:20:54.54,Default,,0,0,0,,Уау
Dialogue: 0,0:20:57.58,0:21:04.09,Default,,0,0,0,,(біртүрлі дауыс)
Dialogue: 0,0:21:04.38,0:21:05.84,Default,,0,0,0,,Қауіпті адам келді!
Dialogue: 0,0:21:05.97,0:21:07.43,Default,,0,0,0,,Мен өлтіремін!
Dialogue: 0,0:21:07.55,0:21:08.47,Default,,0,0,0,,Э? Менің бетім…
Dialogue: 0,0:21:08.89,0:21:12.43,Default,,0,0,0,,Бұл аты аңызға айналған продюсер Тоби.
Dialogue: 0,0:21:12.56,0:21:14.94,Default,,0,0,0,,(Тобидің біртүрлі дауысы)
Dialogue: 0,0:21:15.06,0:21:17.44,Default,,0,0,0,,және келісім-шарт аяқталады
Dialogue: 0,0:21:21.53,0:21:26.11,Default,,0,0,0,,♪～
Dialogue: 0,0:22:43.40,0:22:49.40,Default,,0,0,0,,～♪
Dialogue: 0,0:22:50.90,0:22:56.90,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory