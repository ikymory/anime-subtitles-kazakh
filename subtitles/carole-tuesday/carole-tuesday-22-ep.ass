Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.04,0:00:06.00,Default,,0,0,0,,Бұл ғажайып сияқты болды
Dialogue: 0,0:00:06.29,0:00:10.71,Default,,0,0,0,,Иә, ол Марс тарихына жазылды.
Dialogue: 0,0:00:10.84,0:00:12.92,Default,,0,0,0,,«Жеті минут ғажайып»
Dialogue: 0,0:00:13.59,0:00:19.89,Default,,0,0,0,,Бұл оның қозғаушы күшіне айналған екі қыздың оқиғасы.
Dialogue: 0,0:00:21.43,0:00:27.44,Default,,0,0,0,,♪～
Dialogue: 0,0:01:43.64,0:01:49.65,Default,,0,0,0,,～♪
Dialogue: 0,0:01:51.44,0:01:52.69,Default,,0,0,0,,Қарсы болмасаңыз...
Dialogue: 0,0:01:53.15,0:01:56.03,Default,,0,0,0,,«Марс Грэммиде» бірге өнер көрсете аламыз ба?
Dialogue: 0,0:01:56.36,0:02:00.07,Default,,0,0,0,,Анджела Марс Грэммидегі сәтсіздікке байланысты тоқтату туралы хабарландыру
Dialogue: 0,0:02:00.20,0:02:00.99,Default,,0,0,0,,Ха!
Dialogue: 0,0:02:01.28,0:02:05.12,Default,,0,0,0,,Шварц Ұзақ түн көр
Dialogue: 0,0:02:09.96,0:02:10.92,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:02:11.42,0:02:13.50,Default,,0,0,0,,Марс Грэммидің сахналық режиссері
Dialogue: 0,0:02:13.63,0:02:14.50,Default,,0,0,0,,Бұл Оливия.
Dialogue: 0,0:02:14.63,0:02:16.26,Default,,0,0,0,,Бұл менің көмекшім Дэвид.
Dialogue: 0,0:02:16.46,0:02:17.76,Default,,0,0,0,,Йо... Танысқаныма қуаныштымын.
Dialogue: 0,0:02:17.88,0:02:19.30,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:02:19.43,0:02:21.72,Default,,0,0,0,,Бүгінгі күн бетпе-бет кездесу сияқты.
Dialogue: 0,0:02:21.85,0:02:23.05,Default,,0,0,0,,Демалу.
Dialogue: 0,0:02:23.18,0:02:23.89,Default,,0,0,0,,Иә
Dialogue: 0,0:02:24.22,0:02:27.27,Default,,0,0,0,,Кристал екеуміз бір-бірімізді бұрыннан танимыз.
Dialogue: 0,0:02:27.39,0:02:30.60,Default,,0,0,0,,Бірақ соңғы кездері маған көп ұсыныстар түспей жүр.
Dialogue: 0,0:02:30.73,0:02:31.35,Default,,0,0,0,,(Изуна) Ә? (Сора) Қашан?
Dialogue: 0,0:02:31.48,0:02:32.48,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:02:32.61,0:02:37.07,Default,,0,0,0,,Соңғы рет мен басқа әртіспен өнер көрсетуім керек еді, бірақ...
Dialogue: 0,0:02:37.19,0:02:39.28,Default,,0,0,0,,Ол орта жолда жойылды.
Dialogue: 0,0:02:39.49,0:02:42.37,Default,,0,0,0,,Ол кезде ән тартымды емес еді.
Dialogue: 0,0:02:42.49,0:02:43.45,Default,,0,0,0,,Міне
Dialogue: 0,0:02:43.58,0:02:44.37,Default,,0,0,0,,Е...
Dialogue: 0,0:02:44.70,0:02:47.91,Default,,0,0,0,,Бұл жолы олар кенеттен шоуға қатысуды шешті...
Dialogue: 0,0:02:48.04,0:02:49.16,Default,,0,0,0,,Сіз таң қалдыңыз
Dialogue: 0,0:02:49.46,0:02:52.08,Default,,0,0,0,,Алдымен мына жігіттер жаңа ән шығарады...
Dialogue: 0,0:02:52.21,0:02:55.59,Default,,0,0,0,,Кристалдан сұрауды ұйымдастыру дұрыс па?
Dialogue: 0,0:02:55.71,0:02:56.46,Default,,0,0,0,,Мен істеймін
Dialogue: 0,0:02:56.59,0:02:57.71,Default,,0,0,0,,Хигучиді ұстамас бұрын, оның неге адам өлтіріп жатқанын білуіміз керек.
Dialogue: 0,0:02:57.96,0:02:59.42,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:02:59.55,0:03:01.93,Default,,0,0,0,,Сонымен ән қандай тақырыпта болады?
Dialogue: 0,0:03:02.47,0:03:03.85,Default,,0,0,0,,Осы мақсатқа жету үшін бәрін қолданамыз — Титан күшін де, сенің қаруларыңды да. ➡
Dialogue: 0,0:03:03.97,0:03:07.52,Default,,0,0,0,,Қазір әлем түбегейлі өзгергелі тұр.
Dialogue: 0,0:03:07.64,0:03:10.60,Default,,0,0,0,,Менің ойымша, бұл жақсы бағыт емес.
Dialogue: 0,0:03:11.19,0:03:14.86,Default,,0,0,0,,Қараңғыда тынысымызды басып өмір сүріп жатқан мына заманда...
Dialogue: 0,0:03:14.98,0:03:17.11,Default,,0,0,0,,Мен өзімді жолда келе жатқандай сезінемін
Dialogue: 0,0:03:17.53,0:03:18.94,Default,,0,0,0,,Мұндай дәуір-
Dialogue: 0,0:03:19.07,0:03:21.99,Default,,0,0,0,,Кейбір музыканттар заттарды сол күйінде көшіріп алады.
Dialogue: 0,0:03:22.32,0:03:25.07,Default,,0,0,0,,Бірақ мұндай қараңғыда да...
Dialogue: 0,0:03:25.20,0:03:29.20,Default,,0,0,0,,Жарық нұрына айналған әнді айтқым келетін сияқты.
Dialogue: 0,0:03:29.33,0:03:30.12,Default,,0,0,0,,Жарық…
Dialogue: 0,0:03:30.71,0:03:31.58,Default,,0,0,0,,Иә
Dialogue: 0,0:03:31.71,0:03:33.63,Default,,0,0,0,,Кэрол Сейсенбі
Dialogue: 0,0:03:33.75,0:03:36.88,Default,,0,0,0,,Екеуің орындай алуларың керек.
Dialogue: 0,0:03:37.00,0:03:37.88,Default,,0,0,0,,Ха…
Dialogue: 0,0:03:38.13,0:03:41.34,Default,,0,0,0,,Түсіндім, сондықтан сіз ұсынысты қабылдадыңыз.
Dialogue: 0,0:03:42.43,0:03:43.26,Default,,0,0,0,,Чип… Чип, чип!
Dialogue: 0,0:03:43.38,0:03:45.89,Default,,0,0,0,,Иә, бұл әлі анық емес, бірақ...
Dialogue: 0,0:03:46.01,0:03:47.35,Default,,0,0,0,,Ойлан
Dialogue: 0,0:03:47.81,0:03:51.89,Default,,0,0,0,,Ал, әннің демонстрациясы болған соң, тағы кездесейік.
Dialogue: 0,0:03:52.02,0:03:53.98,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:03:56.52,0:03:59.82,Default,,0,0,0,,Ах... Ойланып қарасам, Анджела да оның ішінде болады ғой, солай ма?
Dialogue: 0,0:03:59.94,0:04:00.61,Default,,0,0,0,,Иә
Dialogue: 0,0:04:00.74,0:04:01.99,Default,,0,0,0,,Қарсыластарыңыз үшін алаңдайсыз ба?
Dialogue: 0,0:04:02.28,0:04:05.87,Default,,0,0,0,,Бұл дұрыс, бірақ қиын сияқты.
Dialogue: 0,0:04:05.99,0:04:07.74,Default,,0,0,0,,Менің ойымша, бұл дұрыс па?
Dialogue: 0,0:04:07.91,0:04:11.25,Default,,0,0,0,,Негізі Анджеланы әлі кездестірген жоқпын.
Dialogue: 0,0:04:11.37,0:04:15.96,Default,,0,0,0,,Қараңызшы, мен қиналып жүрмін, байланысқа шығу қиын.
Dialogue: 0,0:04:16.08,0:04:17.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:20.84,0:04:21.84,Default,,0,0,0,,Қалай?
Dialogue: 0,0:04:22.26,0:04:24.01,Default,,0,0,0,,«Анджела, сен қатты қиналып жүрсің бе?»
Dialogue: 0,0:04:24.13,0:04:26.43,Default,,0,0,0,,«Тао босатылғаннан кейін жоғалады»
Dialogue: 0,0:04:26.55,0:04:29.22,Default,,0,0,0,,«Менің анам да құлап, жұмысым тоқтатылды».
Dialogue: 0,0:04:29.60,0:04:32.52,Default,,0,0,0,,«Бірінші альбомның шығарылымы да кейінге қалдырылады»
Dialogue: 0,0:04:32.85,0:04:34.52,Default,,0,0,0,,Иә? (сейсенбі) Шынымен бе?
Dialogue: 0,0:04:34.64,0:04:39.27,Default,,0,0,0,,Жақсы, бұл өсек сайтынан алынғандықтан, оның қаншалықты шындыққа жанасатынын білмеймін.
Dialogue: 0,0:04:39.48,0:04:42.24,Default,,0,0,0,,Айтпақшы, біздің альбомға не болды?
Dialogue: 0,0:04:42.36,0:04:45.49,Default,,0,0,0,,Біз қазір игеріп жатырмыз, сәл күте тұрыңыз.
Dialogue: 0,0:04:45.61,0:04:46.57,Default,,0,0,0,,О~
Dialogue: 0,0:04:46.99,0:04:50.45,Default,,0,0,0,,Жалпы айтқанда, қазір балалар, басқа адамдар үшін алаңдайтын уақыт емес.
Dialogue: 0,0:04:51.24,0:04:52.83,Default,,0,0,0,,Кристалл шығармашылық-
Dialogue: 0,0:04:52.95,0:04:54.58,Default,,0,0,0,,Бұл өте қиын.
Dialogue: 0,0:04:54.71,0:04:55.75,Default,,0,0,0,,Маған ән ұнамайды...
Dialogue: 0,0:04:55.87,0:04:58.13,Default,,0,0,0,,Бірге ойнау тоқтатылуы мүмкін.
Dialogue: 0,0:04:58.25,0:04:58.88,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:59.00,0:05:01.63,Default,,0,0,0,,Егер бұл орын алса, сіз қалпына келтіре алмайсыз.
Dialogue: 0,0:05:02.13,0:05:04.67,Default,,0,0,0,,Мен бүгін ән жазуды бастаймын.
Dialogue: 0,0:05:06.05,0:05:09.51,Default,,0,0,0,,Галактикааралық штаб-пәтерге сәтті кірді
Dialogue: 0,0:05:09.80,0:05:11.64,Default,,0,0,0,,Тек көрсетілген ақпаратты тастаңыз
Dialogue: 0,0:05:11.76,0:05:13.47,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:05:32.62,0:05:35.41,Default,,0,0,0,,«Қараңғыдағы жарық»?
Dialogue: 0,0:05:35.79,0:05:38.00,Default,,0,0,0,,Бұл қиын тақырып, солай емес пе?
Dialogue: 0,0:05:38.12,0:05:42.25,Default,,0,0,0,,Көңілің мұң болса, бұл үміт сияқты.
Dialogue: 0,0:05:42.59,0:05:46.47,Default,,0,0,0,,Көңіл-күйім түскенде Синдидің әнін тыңдадым...
Dialogue: 0,0:05:46.59,0:05:48.89,Default,,0,0,0,,Мен біраз үміт алған сияқтымын.
Dialogue: 0,0:05:49.22,0:05:52.47,Default,,0,0,0,,Мен Флораның әнін алғаш естігенде...
Dialogue: 0,0:05:52.60,0:05:54.10,Default,,0,0,0,,Мен солай ойладым.
Dialogue: 0,0:05:54.81,0:05:58.39,Default,,0,0,0,,Осылай ән шығарсақ...
Dialogue: 0,0:05:58.64,0:06:00.40,Default,,0,0,0,,Сіз мұны істей аласыз ба?
Dialogue: 0,0:06:00.73,0:06:02.69,Default,,0,0,0,,Тек орындаңыз.
Dialogue: 0,0:06:02.82,0:06:03.82,Default,,0,0,0,,Иә
Dialogue: 0,0:06:04.32,0:06:11.32,Default,,0,0,0,,♪～
Dialogue: 0,0:07:25.57,0:07:32.57,Default,,0,0,0,,～♪
Dialogue: 0,0:07:33.82,0:07:36.53,Default,,0,0,0,,Ақырында танысқаныма қуаныштымын, Анджела.
Dialogue: 0,0:07:36.66,0:07:39.87,Default,,0,0,0,,Осындай қиын жағдайда жолдан шығып кеткенім үшін кешірім сұраймын.
Dialogue: 0,0:07:40.29,0:07:42.29,Default,,0,0,0,,Басқарушы болған анаң...
Dialogue: 0,0:07:42.42,0:07:44.00,Default,,0,0,0,,Мистер Дао-
Dialogue: 0,0:07:44.21,0:07:46.25,Default,,0,0,0,,Біз де сізге еруді жоспарлап отырмыз.
Dialogue: 0,0:07:46.38,0:07:48.13,Default,,0,0,0,,Дәл ойлағанымдай
Dialogue: 0,0:07:49.84,0:07:52.01,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:07:53.22,0:07:56.14,Default,,0,0,0,,Ой, кешіріңіз, бәрі жақсы.
Dialogue: 0,0:07:56.93,0:07:59.81,Default,,0,0,0,,Мен Грэммиде дұрыс ән айтамын.
Dialogue: 0,0:07:59.93,0:08:01.68,Default,,0,0,0,,Өйткені мен ән айта аламын
Dialogue: 0,0:08:03.44,0:08:04.40,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:04.81,0:08:06.36,Default,,0,0,0,,Ол шырылдамайды.
Dialogue: 0,0:08:06.48,0:08:09.94,Default,,0,0,0,,Кристал-сан, көңілің қалған шығар?
Dialogue: 0,0:08:10.07,0:08:13.28,Default,,0,0,0,,Маған ынтымақтастығы болмайтынын айтты...
Dialogue: 0,0:08:13.40,0:08:14.82,Default,,0,0,0,,Хаа... (сейсенбі) Ух...
Dialogue: 0,0:08:14.95,0:08:15.99,Default,,0,0,0,,Уау
Dialogue: 0,0:08:16.45,0:08:18.16,Default,,0,0,0,,Мо… Сәлеметсіз бе?
Dialogue: 0,0:08:18.28,0:08:20.62,Default,,0,0,0,,Балалар, Кристалдың Instagram желісін көрдіңіздер ме?
Dialogue: 0,0:08:20.75,0:08:22.71,Default,,0,0,0,,Instagram? (сейсенбі) А
Dialogue: 0,0:08:24.29,0:08:27.88,Default,,0,0,0,,``Мен ең жақсы әнді тезірек айтқым келеді''
Dialogue: 0,0:08:28.09,0:08:29.59,Default,,0,0,0,,Бұл...
Dialogue: 0,0:08:29.71,0:08:30.88,Default,,0,0,0,,Уау...
Dialogue: 0,0:08:31.01,0:08:32.88,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:36.76,0:08:37.68,Default,,0,0,0,,Джерри
Dialogue: 0,0:08:37.80,0:08:38.85,Default,,0,0,0,,Хигучи расталды.
Dialogue: 0,0:08:39.35,0:08:41.72,Default,,0,0,0,,Сіз басқаратын кейбір компаниялар...
Dialogue: 0,0:08:41.85,0:08:44.02,Default,,0,0,0,,Айналада иіскеп жүргендер бар.
Dialogue: 0,0:08:44.14,0:08:46.06,Default,,0,0,0,,Федералдық тергеу бюросы?
Dialogue: 0,0:08:46.19,0:08:48.65,Default,,0,0,0,,Әлде Гамильтонның лагерінен біреу ме?
Dialogue: 0,0:08:48.77,0:08:50.36,Default,,0,0,0,,Журналистке ұқсайды
Dialogue: 0,0:08:50.65,0:08:53.44,Default,,0,0,0,,Және ол Спенсермен байланыста болған сияқты.
Dialogue: 0,0:08:53.57,0:08:57.07,Default,,0,0,0,,Спенсермен? Бұл біртүрлі
Dialogue: 0,0:08:57.62,0:09:00.62,Default,,0,0,0,,Спенсерді тәулігіне 24 сағат бақылаңыз.
Dialogue: 0,0:09:00.74,0:09:04.00,Default,,0,0,0,,Қандай да бір ауытқушылық болса, хабарлаңыз.
Dialogue: 0,0:09:04.91,0:09:09.00,Default,,0,0,0,,(гитара тартқан дыбыс)
Dialogue: 0,0:09:09.42,0:09:11.80,Default,,0,0,0,,Ал, нағыз шоу ертең.
Dialogue: 0,0:09:11.92,0:09:13.67,Default,,0,0,0,,Бұл өте тез өтті.
Dialogue: 0,0:09:13.80,0:09:16.26,Default,,0,0,0,,Аа, мен қатты қобалжыдым.
Dialogue: 0,0:09:16.38,0:09:17.30,Default,,0,0,0,,Иә
Dialogue: 0,0:09:17.84,0:09:20.01,Default,,0,0,0,,Чу жақсысың ба? (сейсенбі) Иә?
Dialogue: 0,0:09:20.14,0:09:23.22,Default,,0,0,0,,Жоқ, мен біраз уақыттан бері бір нәрсеге алаңдап жүрмін.
Dialogue: 0,0:09:23.35,0:09:25.43,Default,,0,0,0,,А... иә
Dialogue: 0,0:09:26.44,0:09:27.44,Default,,0,0,0,,Хохо!
Dialogue: 0,0:09:28.65,0:09:32.23,Default,,0,0,0,,♪ Туған күнің құтты болсын
Dialogue: 0,0:09:32.48,0:09:35.82,Default,,0,0,0,,♪ Туған күнің құтты болсын
Dialogue: 0,0:09:36.32,0:09:40.95,Default,,0,0,0,,♪ Туған күніңмен Құрметті Кэрол
Dialogue: 0,0:09:42.33,0:09:48.25,Default,,0,0,0,,♪ Туған күнің құтты болсын
Dialogue: 0,0:09:48.37,0:09:50.71,Default,,0,0,0,,♪ Хо хо~
Dialogue: 0,0:09:54.05,0:09:56.09,Default,,0,0,0,,Мұны ашыңыз.
Dialogue: 0,0:09:56.67,0:09:57.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:00.47,0:10:01.47,Default,,0,0,0,,(қорапты ашу дыбысы)
Dialogue: 0,0:10:04.64,0:10:06.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:08.14,0:10:10.86,Default,,0,0,0,,Иә? Сізге бұл ұнамайды ма?
Dialogue: 0,0:10:11.69,0:10:14.36,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:10:15.15,0:10:17.11,Default,,0,0,0,,(Изуку) Ах. (Тодороки) «Құдіретті» құбылыстар басталғалы бері—
Dialogue: 0,0:10:19.99,0:10:20.82,Default,,0,0,0,,Кешіріңізші!
Dialogue: 0,0:10:20.95,0:10:22.12,Default,,0,0,0,,Хехе
Dialogue: 0,0:10:33.04,0:10:34.71,Default,,0,0,0,,(Өлшеу құралдарының электронды дыбысы)
Dialogue: 0,0:10:34.84,0:10:39.51,Default,,0,0,0,,Оян, ана, бүгін Марс Грэмми марапаттау рәсімі.
Dialogue: 0,0:10:40.30,0:10:42.60,Default,,0,0,0,,Бұл ұйықтайтын уақыт емес.
Dialogue: 0,0:10:42.72,0:10:46.52,Default,,0,0,0,,Грэммиде болу әрқашан сіздің арманыңыз болған емес пе?
Dialogue: 0,0:10:47.22,0:10:51.15,Default,,0,0,0,,Бәрі жақсы, тіпті жалған немесе қуыршақ.
Dialogue: 0,0:10:51.44,0:10:54.48,Default,,0,0,0,,Оян, мені көр
Dialogue: 0,0:10:55.48,0:10:58.53,Default,,0,0,0,,Әйтпесе, мен...
Dialogue: 0,0:10:59.74,0:11:00.36,Default,,0,0,0,,Ха!
Dialogue: 0,0:11:01.82,0:11:02.82,Default,,0,0,0,,Анджи…
Dialogue: 0,0:11:03.70,0:11:04.70,Default,,0,0,0,,Ана?
Dialogue: 0,0:11:04.83,0:11:08.50,Default,,0,0,0,,Кешіріңіз, өтірік айта берем.
Dialogue: 0,0:11:09.54,0:11:13.29,Default,,0,0,0,,Расында да сен менің балам емессің.
Dialogue: 0,0:11:13.42,0:11:20.17,Default,,0,0,0,,Мен балалы бола алмадым, сондықтан оны доктор Зееманнан мұра еттім.
Dialogue: 0,0:11:21.01,0:11:22.89,Default,,0,0,0,,Не? (Есіктің ашылуы мен аяқ дыбысы)
Dialogue: 0,0:11:25.01,0:11:26.51,Default,,0,0,0,,Дарья-сан, сен мені естисің бе?
Dialogue: 0,0:11:28.60,0:11:30.02,Default,,0,0,0,,Штаб оның шамамен төрт айда сегіз «Стелла» жинайтынын болжайды, бірақ
Dialogue: 0,0:11:30.14,0:11:34.69,Default,,0,0,0,,Бірақ сені сүйгенім өтірік емес
Dialogue: 0,0:11:35.61,0:11:37.40,Default,,0,0,0,,Анджи
Dialogue: 0,0:11:37.61,0:11:40.69,Default,,0,0,0,,(Өлшеу құралдарының электронды дыбысы)
Dialogue: 0,0:11:40.82,0:11:43.91,Default,,0,0,0,,Ана... Анашым!
Dialogue: 0,0:11:44.03,0:11:46.53,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:11:46.66,0:11:49.41,Default,,0,0,0,,23-ші Марс Грэмми марапаттары
Dialogue: 0,0:11:50.12,0:11:52.42,Default,,0,0,0,,Биыл да көптеген атақты адамдар жиналды.
Dialogue: 0,0:11:52.54,0:11:55.67,Default,,0,0,0,,Өткізілетін орын қазірдің өзінде толқуға толы.
Dialogue: 0,0:11:55.79,0:12:00.05,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:12:02.88,0:12:04.72,Default,,0,0,0,,Міне, мұнда
Dialogue: 0,0:12:05.09,0:12:06.60,Default,,0,0,0,,Уа (сейсенбі) Родди
Dialogue: 0,0:12:07.26,0:12:09.89,Default,,0,0,0,,Марс Грэмми шынымен шығады.
Dialogue: 0,0:12:10.02,0:12:12.85,Default,,0,0,0,,Жарайды, мен де әлі сене алар емеспін.
Dialogue: 0,0:12:12.98,0:12:14.15,Default,,0,0,0,,Ой…
Dialogue: 0,0:12:14.27,0:12:16.81,Default,,0,0,0,,Ей, енді не айтып тұрсың?
Dialogue: 0,0:12:17.40,0:12:21.24,Default,,0,0,0,,Балалар, ең жақсы ұрып-соғушылар болғандықтан, біз бірден күту бөлмесіне көшеміз.
Dialogue: 0,0:12:21.40,0:12:22.86,Default,,0,0,0,,Иә, иә~
Dialogue: 0,0:12:22.99,0:12:24.70,Default,,0,0,0,,Ах... анау көйлек.
Dialogue: 0,0:12:24.99,0:12:26.45,Default,,0,0,0,,Иә?не?
Dialogue: 0,0:12:26.57,0:12:27.53,Default,,0,0,0,,Сізге сәйкес емес пе?
Dialogue: 0,0:12:27.66,0:12:29.87,Default,,0,0,0,,Ах... у... шынымен емес.
Dialogue: 0,0:12:30.04,0:12:31.25,Default,,0,0,0,,Аа...
Dialogue: 0,0:12:32.12,0:12:33.62,Default,,0,0,0,,Бұл өте керемет
Dialogue: 0,0:12:33.96,0:12:35.21,Default,,0,0,0,,Хехе
Dialogue: 0,0:12:37.21,0:12:38.96,Default,,0,0,0,,Ханымдар мен мырзалар
Dialogue: 0,0:12:39.09,0:12:43.92,Default,,0,0,0,,23-ші Марс Грэмми сыйлығын табыстау рәсімі басталды.
Dialogue: 0,0:12:44.30,0:12:47.39,Default,,0,0,0,,Баршаңызға, Грэмми марапаттары жер бетінде басталды...
Dialogue: 0,0:12:47.51,0:12:50.93,Default,,0,0,0,,Марста орындалғанына 23 жыл болды.
Dialogue: 0,0:12:51.27,0:12:56.23,Default,,0,0,0,,Иә, 23-ші Марс Грэммиіне қош келдіңіз
Dialogue: 0,0:12:56.35,0:12:57.86,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:12:58.19,0:13:01.44,Default,,0,0,0,,Мм, менің көзімше атақты адамдар бар.
Dialogue: 0,0:13:01.57,0:13:06.20,Default,,0,0,0,,Олардың кейбіреулері жақын достар, ал кейбіреулеріне мен тек иіліп тағзым еттім.
Dialogue: 0,0:13:06.32,0:13:07.74,Default,,0,0,0,,Сәлем Стив
Dialogue: 0,0:13:07.87,0:13:09.24,Default,,0,0,0,,(аудитория күлкі)
Dialogue: 0,0:13:09.62,0:13:13.20,Default,,0,0,0,,Бүгін таңертең қырынуды ұмытып кеткен сияқты.
Dialogue: 0,0:13:13.33,0:13:17.17,Default,,0,0,0,,Дегенмен, мен соңғы 10 жыл бойы шана тебуді ұмытып кеткен сияқтымын.
Dialogue: 0,0:13:17.29,0:13:18.75,Default,,0,0,0,,(аудитория күлкі)
Dialogue: 0,0:13:19.21,0:13:21.13,Default,,0,0,0,,Жоқ... бұл рас па?
Dialogue: 0,0:13:21.25,0:13:22.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:22.84,0:13:24.26,Default,,0,0,0,,Сонымен, Анджела ше?
Dialogue: 0,0:13:24.72,0:13:26.97,Default,,0,0,0,,Иә?what up?
Dialogue: 0,0:13:28.14,0:13:30.97,Default,,0,0,0,,Мен қатты қобалжыдым.
Dialogue: 0,0:13:31.10,0:13:32.47,Default,,0,0,0,,Мен де
Dialogue: 0,0:13:32.72,0:13:33.68,Default,,0,0,0,,Бұл ақылсыз.
Dialogue: 0,0:13:33.81,0:13:35.27,Default,,0,0,0,,Иә, бұл қауіпті.
Dialogue: 0,0:13:35.39,0:13:39.06,Default,,0,0,0,,Өйткені бір жыл бұрын біз көпірде ойнайтынбыз.
Dialogue: 0,0:13:39.31,0:13:43.65,Default,,0,0,0,,Мен де бір жыл бұрын үйде қалып қойдым.
Dialogue: 0,0:13:44.07,0:13:46.53,Default,,0,0,0,,Ал, сен осы уақытқа дейін жеттің.
Dialogue: 0,0:13:46.78,0:13:47.91,Default,,0,0,0,,Иә
Dialogue: 0,0:13:49.45,0:13:51.45,Default,,0,0,0,,Енді міне,
Dialogue: 0,0:13:51.58,0:13:54.70,Default,,0,0,0,,Биылғы жылы назар аударған Марстағы барлық ыстық адамдар
Dialogue: 0,0:13:55.16,0:13:57.75,Default,,0,0,0,,Алайда, президенттікке үміткер Валери...
Dialogue: 0,0:13:57.87,0:14:01.29,Default,,0,0,0,,Менің ойымша, сіз маған қоңырау шалу үшін тым ыстық болдыңыз.
Dialogue: 0,0:14:01.88,0:14:05.84,Default,,0,0,0,,Ол: "Бұл не музыка? Бұл тыйым салынған!"
Dialogue: 0,0:14:05.97,0:14:09.13,Default,,0,0,0,,Сенің қабағыңды көтергеніңді көргім келді.
Dialogue: 0,0:14:09.84,0:14:12.72,Default,,0,0,0,,Бірақ оның қызы бүгін келеді.
Dialogue: 0,0:14:12.85,0:14:15.31,Default,,0,0,0,,Шындығында, Кэрол мен Сейсенбінің жартысы.
Dialogue: 0,0:14:15.52,0:14:18.73,Default,,0,0,0,,Сейсенбі шын мәнінде Валеридің қызы.
Dialogue: 0,0:14:18.85,0:14:20.06,Default,,0,0,0,,(Көрермендердің таңқаларлық дыбыстары)
Dialogue: 0,0:14:20.77,0:14:23.94,Default,,0,0,0,,Далия бүгін өмірден өткен сияқты.
Dialogue: 0,0:14:24.07,0:14:25.19,Default,,0,0,0,,Ха!
Dialogue: 0,0:14:25.32,0:14:26.82,Default,,0,0,0,,Сонымен, Анджела ше?
Dialogue: 0,0:14:26.94,0:14:30.28,Default,,0,0,0,,Мен сізден әлі хабар алған жоқпын...
Dialogue: 0,0:14:30.78,0:14:33.33,Default,,0,0,0,,Әзірше кезеңді өзгертуге дайындалыңыз.
Dialogue: 0,0:14:33.45,0:14:34.33,Default,,0,0,0,,Иә
Dialogue: 0,0:14:34.99,0:14:36.66,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:14:39.96,0:14:41.79,Default,,0,0,0,,Жарайсың ба? Екеуміз де
Dialogue: 0,0:14:42.25,0:14:43.88,Default,,0,0,0,,Мен оны жарып жіберемін
Dialogue: 0,0:14:45.25,0:14:46.55,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:46.96,0:14:50.80,Default,,0,0,0,,Сонымен, бұл Грэммидің алғашқы қойылымы...
Dialogue: 0,0:14:51.22,0:14:53.10,Default,,0,0,0,,Кэрол және сейсенбі!
Dialogue: 0,0:14:53.22,0:14:55.35,Default,,0,0,0,,Сіз оны тек Грэммиде көре аласыз.
Dialogue: 0,0:14:55.76,0:14:58.43,Default,,0,0,0,,Арнайы суретшімен ынтымақтастық!
Dialogue: 0,0:14:58.43,0:14:58.73,Default,,0,0,0,,Арнайы суретшімен ынтымақтастық!
Dialogue: 0,0:14:58.43,0:14:58.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:58.73,0:14:58.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:58.85,0:14:59.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:58.85,0:14:59.60,Default,,0,0,0,,Ән «Өрттен кейін»
Dialogue: 0,0:14:59.60,0:15:01.27,Default,,0,0,0,,Ән «Өрттен кейін»
Dialogue: 0,0:15:01.40,0:15:06.57,Default,,0,0,0,,(Сахналық музыка)
Dialogue: 0,0:15:12.03,0:15:15.78,Default,,0,0,0,,♪ Сақтандырғыш жанып тұр
Dialogue: 0,0:15:17.04,0:15:22.04,Default,,0,0,0,,♪ Сенің ұшқының ұшады
Dialogue: 0,0:15:22.63,0:15:26.84,Default,,0,0,0,,♪ Бақылаудан тыс
Dialogue: 0,0:15:27.76,0:15:31.88,Default,,0,0,0,,♪ Мені өртеп жіберді
Dialogue: 0,0:15:33.01,0:15:35.35,Default,,0,0,0,,♪ Бүкіл әлем жанып тұрғанда
Dialogue: 0,0:15:35.68,0:15:38.06,Default,,0,0,0,,♪ Қайда бара жатырсыз?
Dialogue: 0,0:15:38.47,0:15:40.94,Default,,0,0,0,,♪ Бұл тек бастамасы ғана
Dialogue: 0,0:15:41.06,0:15:42.44,Default,,0,0,0,,♪ Берілмеңіз
Dialogue: 0,0:15:42.56,0:15:47.57,Default,,0,0,0,,♪ Бәрі жанып кетсе де, жаңа карта сызылады
Dialogue: 0,0:15:48.03,0:15:50.44,Default,,0,0,0,,♪ Мен қайғырмаймын
Dialogue: 0,0:15:50.69,0:15:53.16,Default,,0,0,0,,♪ Жаңа арман туады
Dialogue: 0,0:15:53.36,0:15:58.49,Default,,0,0,0,,♪ Өртенген алқаптан да гүлдер гүлдейді
Dialogue: 0,0:15:58.70,0:16:01.21,Default,,0,0,0,,♪ Адамдар қайтадан салады
Dialogue: 0,0:16:01.33,0:16:03.92,Default,,0,0,0,,♪ Бірінен соң бірі
Dialogue: 0,0:16:04.04,0:16:09.21,Default,,0,0,0,,♪ Ол жанып кеткеннен кейін
Dialogue: 0,0:16:09.34,0:16:14.68,Default,,0,0,0,,♪ Ол жанып кеткеннен кейін
Dialogue: 0,0:16:15.76,0:16:25.27,Default,,0,0,0,,♪ Аспан шөл далаға жайылады
Dialogue: 0,0:16:26.44,0:16:30.86,Default,,0,0,0,,♪ Қабырға құлады
Dialogue: 0,0:16:31.69,0:16:38.53,Default,,0,0,0,,♪ Жаңа бастама
Dialogue: 0,0:16:38.66,0:16:43.71,Default,,0,0,0,,♪ Бәрі жанып кетсе де, жаңа карта сызылады
Dialogue: 0,0:16:44.04,0:16:46.46,Default,,0,0,0,,♪ Мен жоқтамаймын
Dialogue: 0,0:16:46.71,0:16:49.04,Default,,0,0,0,,♪ Жаңа арман туады
Dialogue: 0,0:16:49.38,0:16:54.43,Default,,0,0,0,,♪ Өртенген алқаптан да гүлдер гүлдейді
Dialogue: 0,0:16:54.68,0:16:57.14,Default,,0,0,0,,♪ Адамдар қайтадан салады
Dialogue: 0,0:16:57.34,0:16:59.89,Default,,0,0,0,,♪ Бірінен соң бірі
Dialogue: 0,0:17:00.01,0:17:05.23,Default,,0,0,0,,♪ Бәрі жанып кетсе де, жаңа карта сызылады
Dialogue: 0,0:17:05.35,0:17:07.94,Default,,0,0,0,,♪ Мен жоқтамаймын
Dialogue: 0,0:17:08.06,0:17:10.36,Default,,0,0,0,,♪ Жаңа арман туады
Dialogue: 0,0:17:10.73,0:17:15.70,Default,,0,0,0,,♪ Өртенген алқаптан да гүлдер гүлдейді
Dialogue: 0,0:17:16.03,0:17:17.99,Default,,0,0,0,,♪ Адамдар қайтадан салады
Dialogue: 0,0:17:18.53,0:17:21.24,Default,,0,0,0,,♪ Бірінен соң бірі
Dialogue: 0,0:17:21.37,0:17:26.58,Default,,0,0,0,,♪ Ол жанып кеткеннен кейін
Dialogue: 0,0:17:26.71,0:17:32.63,Default,,0,0,0,,♪ Ол жанып кеткеннен кейін
Dialogue: 0,0:17:33.55,0:17:35.26,Default,,0,0,0,,Охохо!
Dialogue: 0,0:17:35.38,0:17:37.97,Default,,0,0,0,,Рахмет! Кэрол және сейсенбі
Dialogue: 0,0:17:38.47,0:17:41.51,Default,,0,0,0,,Рахмет! кристал
Dialogue: 0,0:17:44.02,0:17:48.60,Default,,0,0,0,,Енді «Үздік жаңадан келген» номинацияларымен таныстырып өтейік.
Dialogue: 0,0:17:48.85,0:17:51.27,Default,,0,0,0,,Кэрол және сейсенбі!
Dialogue: 0,0:17:51.40,0:17:52.73,Default,,0,0,0,,Даша!
Dialogue: 0,0:17:52.86,0:17:54.49,Default,,0,0,0,,Езекиел!
Dialogue: 0,0:17:54.61,0:17:56.53,Default,,0,0,0,,Жалғыз Кларенс!
Dialogue: 0,0:17:56.65,0:17:58.36,Default,,0,0,0,,Ангела!
Dialogue: 0,0:17:58.70,0:18:01.78,Default,,0,0,0,,Ал «Жаңадан келген» сыйлығының иесі – осы адам.
Dialogue: 0,0:18:02.08,0:18:06.58,Default,,0,0,0,,Марс нөмірі бірінші диджейді таныстыру қажет емес.
Dialogue: 0,0:18:06.71,0:18:07.62,Default,,0,0,0,,Бұл Ертегін!
Dialogue: 0,0:18:07.75,0:18:10.25,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:18:11.13,0:18:12.21,Default,,0,0,0,,А (Оливия) Иә?
Dialogue: 0,0:18:13.09,0:18:14.63,Default,,0,0,0,,Ангела
Dialogue: 0,0:18:16.01,0:18:18.05,Default,,0,0,0,,Газ қалай болды?
Dialogue: 0,0:18:18.18,0:18:19.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:19.55,0:18:20.72,Default,,0,0,0,,(Кугисаки) Демек, бұрын олар үшеуі бір уақытта қарғысқа ұшыраған—
Dialogue: 0,0:18:21.85,0:18:23.35,Default,,0,0,0,,Қарашы, пойыздар тоқтап қалды…
Dialogue: 0,0:18:24.10,0:18:28.19,Default,,0,0,0,,Жаңадан келгендер сыйлығын жарияламас бұрын, бір нәрсені айтайын.
Dialogue: 0,0:18:28.31,0:18:31.94,Default,,0,0,0,,Шынымды айтсам, бұл менің мінезім емес.
Dialogue: 0,0:18:32.06,0:18:35.19,Default,,0,0,0,,Менің айтқым келетіні осы.
Dialogue: 0,0:18:35.48,0:18:39.66,Default,,0,0,0,,Музыка ерте заманнан адам баласымен бірге.
Dialogue: 0,0:18:40.03,0:18:42.78,Default,,0,0,0,,Бұл нәрсе әрқашан маңызды болды.
Dialogue: 0,0:18:43.12,0:18:47.83,Default,,0,0,0,,Ең жақсы музыка әрқашан адам санасына қажет болған.
Dialogue: 0,0:18:48.33,0:18:52.46,Default,,0,0,0,,Бұл біреудің өз бетінше шешкен заңы немесе мораль ба?
Dialogue: 0,0:18:52.79,0:18:56.05,Default,,0,0,0,,Ондай ұсақ нәрсеге байланбау керек.
Dialogue: 0,0:18:56.80,0:18:57.76,Default,,0,0,0,,Өтірік…
Dialogue: 0,0:18:57.88,0:19:00.26,Default,,0,0,0,,Осындай күнде...
Dialogue: 0,0:19:03.01,0:19:04.81,Default,,0,0,0,,Сіз шынымен ән айта аласыз ба?
Dialogue: 0,0:19:04.93,0:19:06.14,Default,,0,0,0,,Иә
Dialogue: 0,0:19:06.27,0:19:11.35,Default,,0,0,0,,Өйткені Грэмми менің анамның арманы болатын.
Dialogue: 0,0:19:12.06,0:19:15.02,Default,,0,0,0,,Ал, жақында хабарландыру жасайық.
Dialogue: 0,0:19:15.98,0:19:17.82,Default,,0,0,0,,...бұған дейін
Dialogue: 0,0:19:18.40,0:19:21.91,Default,,0,0,0,,Шынымен қиналған кезде көмектесетін адам - саған көмектесетін адам.
Dialogue: 0,0:19:22.03,0:19:24.37,Default,,0,0,0,,Ол өзінің нағыз дос екенін айтады.
Dialogue: 0,0:19:24.83,0:19:29.12,Default,,0,0,0,,Менің досым Тао дәл қазір мұнда келе алмайды.
Dialogue: 0,0:19:29.37,0:19:32.71,Default,,0,0,0,,Осы уақытта Тао шығарған бұл суретші...
Dialogue: 0,0:19:32.83,0:19:37.67,Default,,0,0,0,,Грэммиге осы марапатты берудегі батылдықтары үшін шынайы құрметімді білдіргім келеді.
Dialogue: 0,0:19:37.92,0:19:42.93,Default,,0,0,0,,Иә, биылғы Марс Грэмми үздік жаңа суретші сыйлығы...
Dialogue: 0,0:19:43.55,0:19:44.34,Default,,0,0,0,,Ангела!
Dialogue: 0,0:19:44.47,0:19:48.89,Default,,0,0,0,,Охохо!
Dialogue: 0,0:19:49.02,0:19:50.06,Default,,0,0,0,,(Сахналық музыка)
Dialogue: 0,0:19:50.18,0:19:54.44,Default,,0,0,0,,♪ Дүние баяу ыдырап жатыр
Dialogue: 0,0:19:54.56,0:20:01.49,Default,,0,0,0,,♪ Мен дем ала алмаймын
Dialogue: 0,0:20:02.53,0:20:06.62,Default,,0,0,0,,♪ Тізерлеп жығылғанымда да сен мені тастадың
Dialogue: 0,0:20:06.74,0:20:08.87,Default,,0,0,0,,♪ Мен дем ала алмаймын
Dialogue: 0,0:20:08.99,0:20:12.71,Default,,0,0,0,,♪ Оттегі қайда кетті?
Dialogue: 0,0:20:15.04,0:20:20.80,Default,,0,0,0,,♪ Жарайды деп бетіме айттым.
Dialogue: 0,0:20:20.92,0:20:23.63,Default,,0,0,0,,♪ Маған айтқан сөздеріңіз рас па?
Dialogue: 0,0:20:23.76,0:20:26.60,Default,,0,0,0,,♪ Мұның бәрі өзімшіл өтірік пе?
Dialogue: 0,0:20:27.05,0:20:29.68,Default,,0,0,0,,♪ Сен үшін
Dialogue: 0,0:20:30.06,0:20:32.73,Default,,0,0,0,,♪ Мен енді кім екенімді де білмеймін
Dialogue: 0,0:20:33.19,0:20:39.73,Default,,0,0,0,,♪ Сіз кім екеніңізді білдіңіз бе?
Dialogue: 0,0:20:41.28,0:20:42.65,Default,,0,0,0,,♪ Бәрі бұзылған
Dialogue: 0,0:20:42.78,0:20:46.03,Default,,0,0,0,,♪ Неліктен? Менің кінәм бар ма?
Dialogue: 0,0:20:47.24,0:20:48.87,Default,,0,0,0,,♪ Мен бәрін берсем де
Dialogue: 0,0:20:48.99,0:20:53.04,Default,,0,0,0,,♪ Мен сені күлдіруге, бақытты етуге тырыстым, бірақ
Dialogue: 0,0:20:53.54,0:20:55.04,Default,,0,0,0,,♪ Өткенге жабысуға тырыстым, бірақ
Dialogue: 0,0:20:55.17,0:20:56.67,Default,,0,0,0,,♪ Бұл мүмкін емес еді.
Dialogue: 0,0:20:56.79,0:20:59.42,Default,,0,0,0,,♪ Бар білгенім, қайтып орала алмаймын.
Dialogue: 0,0:20:59.80,0:21:05.01,Default,,0,0,0,,♪ Бар білгенім, қайтып орала алмаймын.
Dialogue: 0,0:21:05.84,0:21:08.47,Default,,0,0,0,,♪ Ал мен жалғыз қалдым
Dialogue: 0,0:21:19.56,0:21:22.65,Default,,0,0,0,,♪ Таң ешқашан келмейді
Dialogue: 0,0:21:22.78,0:21:25.65,Default,,0,0,0,,♪ Мойнымды қараңғылық тұншықтырды
Dialogue: 0,0:21:26.57,0:21:30.16,Default,,0,0,0,,♪ Күнді көргім келеді
Dialogue: 0,0:21:30.28,0:21:34.79,Default,,0,0,0,,♪ Мен құлап бара жатқандай сезінемін.
Dialogue: 0,0:21:34.91,0:21:37.58,Default,,0,0,0,,♪ Таң ешқашан келмейді
Dialogue: 0,0:21:37.71,0:21:39.96,Default,,0,0,0,,♪ Қараңғылық құрсауында
Dialogue: 0,0:21:40.09,0:21:41.25,Default,,0,0,0,,♪ Себебі сен мені тастап кеттің
Dialogue: 0,0:21:41.38,0:21:42.63,Default,,0,0,0,,♪ Өйткені сен мені ренжіттің
Dialogue: 0,0:21:42.75,0:21:46.76,Default,,0,0,0,,♪ Мәңгілік туралы армандағым келеді
Dialogue: 0,0:21:49.76,0:21:58.81,Default,,0,0,0,,♪ Дұрыс жауап қандай?
Dialogue: 0,0:21:59.31,0:22:02.27,Default,,0,0,0,,♪ Енді бәрі жойылды
Dialogue: 0,0:22:02.40,0:22:09.66,Default,,0,0,0,,♪ Дұрыс жауап қандай?
Dialogue: 0,0:22:11.16,0:22:17.16,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory