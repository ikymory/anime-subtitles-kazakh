Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.41,0:00:07.42,Default,,0,0,0,,♪～
Dialogue: 0,0:01:23.62,0:01:29.63,Default,,0,0,0,,～♪
Dialogue: 0,0:01:32.34,0:01:34.63,Default,,0,0,0,,Марстың түкпір-түкпірінен музыканттар жиналса...
Dialogue: 0,0:01:34.76,0:01:36.26,Default,,0,0,0,,Бір ән айтсаң
Dialogue: 0,0:01:36.59,0:01:41.18,Default,,0,0,0,,Осы үрдіске мойынсұнбай бәріміз еркін ән айта алсақ.
Dialogue: 0,0:01:41.76,0:01:43.06,Default,,0,0,0,,Өтірік…
Dialogue: 0,0:01:43.60,0:01:45.31,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:01:46.56,0:01:47.98,Default,,0,0,0,,Дао…
Dialogue: 0,0:01:53.44,0:01:55.94,Default,,0,0,0,,Шварцтың заңсыз транзакцияларын жария етті
Dialogue: 0,0:01:56.07,0:01:57.70,Default,,0,0,0,,Ол жақын арада қамауға алынады
Dialogue: 0,0:01:58.61,0:01:59.45,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:01:59.57,0:02:00.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:00.45,0:02:02.41,Default,,0,0,0,,Менің мұны істеуден басқа амалым қалмады.
Dialogue: 0,0:02:02.87,0:02:05.87,Default,,0,0,0,,Мен оның қуғыншылары келгенше жоғалып кетемін.
Dialogue: 0,0:02:06.16,0:02:06.96,Default,,0,0,0,,Ха…
Dialogue: 0,0:02:07.75,0:02:09.92,Default,,0,0,0,,Менің мұны істеуден басқа амалым қалмады.
Dialogue: 0,0:02:11.38,0:02:12.88,Default,,0,0,0,,Сіз барасыз ба?
Dialogue: 0,0:02:13.88,0:02:15.96,Default,,0,0,0,,Жол бойы келсем де
Dialogue: 0,0:02:16.88,0:02:18.55,Default,,0,0,0,,Ақыры осында
Dialogue: 0,0:02:20.55,0:02:23.35,Default,,0,0,0,,Мен әрқашан жалғыз болдым
Dialogue: 0,0:02:23.97,0:02:26.81,Default,,0,0,0,,Анам менің нағыз ата-анам емес еді
Dialogue: 0,0:02:27.27,0:02:32.02,Default,,0,0,0,,Сіз оны біреуге бердім дедіңіз, бірақ оның кім екенін білмеймін.
Dialogue: 0,0:02:32.61,0:02:35.86,Default,,0,0,0,,Анам мені жақсы көретінін айтты.
Dialogue: 0,0:02:35.98,0:02:37.82,Default,,0,0,0,,Ол әлдеқашан өлді
Dialogue: 0,0:02:38.40,0:02:41.28,Default,,0,0,0,,Менде енді ешкім жоқ
Dialogue: 0,0:02:41.61,0:02:44.16,Default,,0,0,0,,Маған ешкім қарап тұрған жоқ
Dialogue: 0,0:02:45.99,0:02:46.74,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:02:47.12,0:02:48.45,Default,,0,0,0,,Сіз жалғыз емессіз
Dialogue: 0,0:02:48.75,0:02:49.75,Default,,0,0,0,,Ха…
Dialogue: 0,0:02:50.96,0:02:55.59,Default,,0,0,0,,Жиырма бес жыл бұрын доктор Зееман заңсыз генетикалық манипуляциядан өтті.
Dialogue: 0,0:02:55.71,0:02:59.13,Default,,0,0,0,,Дизайнер бала құрып, қамауға алынды
Dialogue: 0,0:02:59.72,0:03:02.30,Default,,0,0,0,,Ол сегіз жылдан кейін босатылды, бірақ...
Dialogue: 0,0:03:02.43,0:03:05.05,Default,,0,0,0,,Қайтадан дизайнер баласын жасаңыз.
Dialogue: 0,0:03:05.18,0:03:08.27,Default,,0,0,0,,Ол қайтадан қамауға алынды және түрмеде қалды.
Dialogue: 0,0:03:08.39,0:03:09.52,Default,,0,0,0,,Ха…
Dialogue: 0,0:03:10.39,0:03:13.81,Default,,0,0,0,,Бірінші – мен, екіншісі...
Dialogue: 0,0:03:14.65,0:03:15.32,Default,,0,0,0,,Бұл сенсің
Dialogue: 0,0:03:15.44,0:03:16.11,Default,,0,0,0,,Ха!
Dialogue: 0,0:03:16.65,0:03:18.32,Default,,0,0,0,,Артық уақыт жоқ
Dialogue: 0,0:03:18.44,0:03:20.82,Default,,0,0,0,,Бүгін мен қоштасуға келдім.
Dialogue: 0,0:03:21.15,0:03:22.70,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:03:23.95,0:03:25.95,Default,,0,0,0,,Мені өзіңізбен бірге алыңыз
Dialogue: 0,0:03:27.95,0:03:29.20,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:03:29.45,0:03:30.54,Default,,0,0,0,,Ха…
Dialogue: 0,0:03:30.66,0:03:34.71,Default,,0,0,0,,Дүниеден жасырынып өмір сүремін
Dialogue: 0,0:03:35.42,0:03:36.21,Default,,0,0,0,,Және...
Dialogue: 0,0:03:37.17,0:03:41.26,Default,,0,0,0,,Енді өз әніңді айту керек
Dialogue: 0,0:03:41.76,0:03:43.38,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:44.26,0:03:49.43,Default,,0,0,0,,Сен жоғалып кетсең де, мен сені алыстан бақылап отырамын.
Dialogue: 0,0:03:50.31,0:03:53.06,Default,,0,0,0,,Бір күні тағы кездесейік
Dialogue: 0,0:03:54.35,0:03:57.77,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:03:59.82,0:04:02.65,Default,,0,0,0,,Тао мырза, тәуекелге...
Dialogue: 0,0:04:02.78,0:04:05.91,Default,,0,0,0,,Сіз Анджеланы көруге жол бойы келдіңіз.
Dialogue: 0,0:04:07.03,0:04:08.91,Default,,0,0,0,,Анджеланы сұраңыз
Dialogue: 0,0:04:11.37,0:04:13.16,Default,,0,0,0,,Бірақ бұл ең нашар
Dialogue: 0,0:04:13.50,0:04:16.17,Default,,0,0,0,,Бұл ең нашар, бұл ең нашар, бұл ең нашар
Dialogue: 0,0:04:17.25,0:04:18.96,Default,,0,0,0,,850 жылы адамзат алғаш рет Титаннан өз жерін қайтарып алды
Dialogue: 0,0:04:19.50,0:04:20.80,Default,,0,0,0,,Кейбір шарттармен ше?
Dialogue: 0,0:04:21.13,0:04:21.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:22.26,0:04:24.22,Default,,0,0,0,,Сол ән эфирге шығар алдында
Dialogue: 0,0:04:24.34,0:04:28.30,Default,,0,0,0,,Спенсер, сен Валериге ақпаратты көрсетесің.
Dialogue: 0,0:04:28.81,0:04:31.31,Default,,0,0,0,,Ал егер ол өзіне жауапкершілік алса...
Dialogue: 0,0:04:31.43,0:04:33.02,Default,,0,0,0,,Маған хабарласыңыз
Dialogue: 0,0:04:33.14,0:04:34.94,Default,,0,0,0,,Менен хабар болмаса...
Dialogue: 0,0:04:35.06,0:04:37.48,Default,,0,0,0,,Біз ақпаратты сол күйінде жібереміз.
Dialogue: 0,0:04:37.86,0:04:39.19,Default,,0,0,0,,Сонымен, сіз қалай ойлайсыз?
Dialogue: 0,0:04:41.03,0:04:42.99,Default,,0,0,0,,Олар кездескісі келеді.
Dialogue: 0,0:04:43.28,0:04:44.82,Default,,0,0,0,,Күміс шашты жарты эльф
Dialogue: 0,0:04:44.95,0:04:47.74,Default,,0,0,0,,Аналар ең жаман.
Dialogue: 0,0:04:50.08,0:04:51.83,Default,,0,0,0,,Иә? Ах...
Dialogue: 0,0:04:53.12,0:04:53.96,Default,,0,0,0,,Не болды?
Dialogue: 0,0:04:56.25,0:04:58.79,Default,,0,0,0,,Ол Джерридің досы сияқты.
Dialogue: 0,0:05:00.34,0:05:01.34,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:05:01.46,0:05:02.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:02.38,0:05:03.13,Default,,0,0,0,,Қаш
Dialogue: 0,0:05:03.26,0:05:05.05,Default,,0,0,0,,Сен қайда қашасың?
Dialogue: 0,0:05:06.22,0:05:07.01,Default,,0,0,0,,Секіру
Dialogue: 0,0:05:07.30,0:05:10.35,Default,,0,0,0,,Эй, эй, бұл осындай фильм сияқты немесе бір нәрсе сияқты ...
Dialogue: 0,0:05:10.51,0:05:11.64,Default,,0,0,0,,О... Эй! Қарғыс атсын
Dialogue: 0,0:05:12.64,0:05:15.18,Default,,0,0,0,,Егер ол 30 минут күтуді айтса, басқа амалым жоқ шығар
Dialogue: 0,0:05:15.39,0:05:17.52,Default,,0,0,0,,Ааах…
Dialogue: 0,0:05:22.78,0:05:26.45,Default,,0,0,0,,(Пернетақта өнімділігі)
Dialogue: 0,0:05:27.57,0:05:28.24,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:05:28.66,0:05:30.91,Default,,0,0,0,,Мен мұны істей алатындай сезінемін.
Dialogue: 0,0:05:31.37,0:05:33.04,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:05:33.79,0:05:35.25,Default,,0,0,0,,Дайын!
Dialogue: 0,0:05:35.37,0:05:36.91,Default,,0,0,0,,О (сейсенбі) Иә!
Dialogue: 0,0:05:37.46,0:05:38.92,Default,,0,0,0,,(Екі қуанышты дауыс)
Dialogue: 0,0:05:39.42,0:05:41.38,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:41.54,0:05:43.46,Default,,0,0,0,,Иә! (сейсенбі) Иә!
Dialogue: 0,0:05:43.59,0:05:44.38,Default,,0,0,0,,Уф!
Dialogue: 0,0:05:44.76,0:05:45.59,Default,,0,0,0,,Менің математика бағаларым шынымен де өте жақсы, білесің бе
Dialogue: 0,0:05:45.72,0:05:48.34,Default,,0,0,0,,Эй, кешіріңіз.
Dialogue: 0,0:05:48.97,0:05:50.22,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:05:50.34,0:05:51.64,Default,,0,0,0,,Үй иесі
Dialogue: 0,0:05:52.10,0:05:53.10,Default,,0,0,0,,Тыңда, тыңда
Dialogue: 0,0:05:53.22,0:05:54.31,Default,,0,0,0,,Ән дайын.
Dialogue: 0,0:05:54.43,0:05:56.31,Default,,0,0,0,,Иә, біз мұны үлкен сахнада жасаймыз...
Dialogue: 0,0:05:56.43,0:05:58.44,Default,,0,0,0,,Мен айтпауым керек еді...
Dialogue: 0,0:05:58.56,0:05:59.94,Default,,0,0,0,,Мен мұны бәрібір істей алдым.
Dialogue: 0,0:06:00.19,0:06:02.19,Default,,0,0,0,,Мен тым қатты толқып кеттім...
Dialogue: 0,0:06:02.32,0:06:04.23,Default,,0,0,0,,Мен бірге жүгіру керек деп ойладым.
Dialogue: 0,0:06:04.36,0:06:06.44,Default,,0,0,0,,Кешіріңіз, бұл өте шулы
Dialogue: 0,0:06:06.57,0:06:07.32,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:06:08.20,0:06:09.03,Default,,0,0,0,,Кэрол
Dialogue: 0,0:06:09.32,0:06:10.45,Default,,0,0,0,,А...
Dialogue: 0,0:06:11.78,0:06:13.20,Default,,0,0,0,,Сіз керемет болдыңыз.
Dialogue: 0,0:06:14.58,0:06:15.62,Default,,0,0,0,,Хехе
Dialogue: 0,0:06:16.00,0:06:19.79,Default,,0,0,0,,Енді мұндай қоймада тұрудың қажеті жоқ.
Dialogue: 0,0:06:19.92,0:06:23.88,Default,,0,0,0,,Менен сұраудан тартынбаңыз, қалаған уақытта қозғала аласыз.
Dialogue: 0,0:06:25.55,0:06:26.46,Default,,0,0,0,,Жоқ
Dialogue: 0,0:06:26.92,0:06:29.30,Default,,0,0,0,,Менің туыстарым да, ақшам да жоқ еді...
Dialogue: 0,0:06:29.43,0:06:33.10,Default,,0,0,0,,Мені арзан өмір сүруге рұқсат еткен үй иесі болмаса...
Dialogue: 0,0:06:33.22,0:06:36.39,Default,,0,0,0,,Мен қазір жабайы табиғатта өлетін едім.
Dialogue: 0,0:06:37.06,0:06:39.60,Default,,0,0,0,,Үй иесі – менің жанашырым
Dialogue: 0,0:06:39.73,0:06:42.02,Default,,0,0,0,,Қарсы болмасаңыз, тағы да...
Dialogue: 0,0:06:42.36,0:06:44.77,Default,,0,0,0,,Мен осында қалсам болады ма?
Dialogue: 0,0:06:45.32,0:06:47.69,Default,,0,0,0,,О, әрине.
Dialogue: 0,0:06:47.99,0:06:48.65,Default,,0,0,0,,Хехе
Dialogue: 0,0:06:48.78,0:06:49.78,Default,,0,0,0,,Сейсенбі
Dialogue: 0,0:06:49.90,0:06:51.28,Default,,0,0,0,,Иә
Dialogue: 0,0:06:51.70,0:06:54.70,Default,,0,0,0,,Менімен бірге болғаныңыз үшін рахмет Кэрол.
Dialogue: 0,0:06:56.04,0:06:57.29,Default,,0,0,0,,Хехе
Dialogue: 0,0:06:57.41,0:06:58.96,Default,,0,0,0,,Иә
Dialogue: 0,0:07:00.04,0:07:01.58,Default,,0,0,0,,Шварц мырза
Dialogue: 0,0:07:02.04,0:07:03.71,Default,,0,0,0,,Федералдық прокуратура
Dialogue: 0,0:07:03.84,0:07:08.59,Default,,0,0,0,,Сенімге ерекше қиянат жасағаны үшін қамауға алу және 47 айыптау
Dialogue: 0,0:07:09.22,0:07:12.97,Default,,0,0,0,,Ақымақ, мені ұстайсың ба?
Dialogue: 0,0:07:13.09,0:07:18.06,Default,,0,0,0,,Мұнда кімнің бұйрығымен келдің? Мемлекеттік айыптаулар директоры менің досым.
Dialogue: 0,0:07:18.39,0:07:20.98,Default,,0,0,0,,Intergalactic Inc. заңсыз операцияларына қатысты.
Dialogue: 0,0:07:21.10,0:07:25.11,Default,,0,0,0,,Қазіргі уақытта желіде ондаған мың дәлелдер таралып жатыр
Dialogue: 0,0:07:25.23,0:07:28.23,Default,,0,0,0,,Қарғыс атсын... Тао...
Dialogue: 0,0:07:29.40,0:07:31.11,Default,,0,0,0,,(Ертегін мен Тоби сөйлейді)
Dialogue: 0,0:07:31.24,0:07:34.03,Default,,0,0,0,,Мен қандай да бір жолмен кері бақылауды аяқтай алатын сияқтымын.
Dialogue: 0,0:07:34.16,0:07:37.20,Default,,0,0,0,,Реле және қауіпсіздік шаралары аяқталған сияқты.
Dialogue: 0,0:07:37.58,0:07:39.79,Default,,0,0,0,,Барлық қатысушылар еріктілер.
Dialogue: 0,0:07:39.91,0:07:42.79,Default,,0,0,0,,Мен де қолымнан келгенше музыканттармен сөйлестім.
Dialogue: 0,0:07:43.12,0:07:45.71,Default,,0,0,0,,Қанша адам келетіні ғана.
Dialogue: 0,0:07:45.84,0:07:48.25,Default,,0,0,0,,Солай болса да, осындай ауқымдағы нәрсе...
Dialogue: 0,0:07:48.38,0:07:50.63,Default,,0,0,0,,Құпия түрде істердің жүруі мүмкін емес.
Dialogue: 0,0:07:50.92,0:07:52.97,Default,,0,0,0,,Ах, дұрыс.
Dialogue: 0,0:07:53.09,0:07:56.85,Default,,0,0,0,,Иә? А, сен үлгердің бе? Бірінші альбом
Dialogue: 0,0:07:56.97,0:08:01.98,Default,,0,0,0,,Ах, бірақ олар кейінірек өздері туралы ғана ойлайды.
Dialogue: 0,0:08:02.69,0:08:05.44,Default,,0,0,0,,Шығарылым біраз уақытқа кейінге қалдырылады.
Dialogue: 0,0:08:14.03,0:08:19.58,Default,,0,0,0,,Нәтижесі алдын ала шешіліп қойған.
Dialogue: 0,0:08:19.99,0:08:22.79,Default,,0,0,0,,Жаңа жыл кеші де келіп жетті.
Dialogue: 0,0:08:22.96,0:08:25.00,Default,,0,0,0,,Мен ештеңе сезбеймін.
Dialogue: 0,0:08:25.12,0:08:27.63,Default,,0,0,0,,Ешкім бұлай келген жоқ.
Dialogue: 0,0:08:27.75,0:08:30.09,Default,,0,0,0,,Хаха, мұндай нәрсе болуы мүмкін ...
Dialogue: 0,0:08:32.30,0:08:34.22,Default,,0,0,0,,Егер бұл орын алса, мен не істеуім керек?
Dialogue: 0,0:08:34.34,0:08:35.22,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:08:35.34,0:08:36.64,Default,,0,0,0,,Бұл сеппуку.
Dialogue: 0,0:08:37.09,0:08:38.60,Default,,0,0,0,,Біреу келе ме?
Dialogue: 0,0:08:38.72,0:08:41.77,Default,,0,0,0,,Кез келген адам келе алады.
Dialogue: 0,0:08:44.64,0:08:46.44,Default,,0,0,0,,Осы күнге дейін жұмыс істейсіз бе?
Dialogue: 0,0:08:46.56,0:08:50.27,Default,,0,0,0,,Иә, президенттікке үміткерлердің мереке күндері жоқ.
Dialogue: 0,0:08:50.61,0:08:52.90,Default,,0,0,0,,Алайда, егер сіз президент болсаңыз...
Dialogue: 0,0:08:53.03,0:08:55.66,Default,,0,0,0,,Сізде көптеген мерекелер болады.
Dialogue: 0,0:08:55.78,0:08:57.78,Default,,0,0,0,,(Спенсердің түшкіруі)
Dialogue: 0,0:08:58.07,0:08:59.95,Default,,0,0,0,,Не болды? суық?
Dialogue: 0,0:09:00.08,0:09:02.29,Default,,0,0,0,,(Шоко) Есікті ашамын. Киініп жатқанда да апат болуы мүмкін, білесің бе.
Dialogue: 0,0:09:02.95,0:09:05.67,Default,,0,0,0,,Шындығында, мен сенің бір нәрсені көргім келеді.
Dialogue: 0,0:09:14.26,0:09:16.13,Default,,0,0,0,,Әй, біреу келді.
Dialogue: 0,0:09:16.34,0:09:17.09,Default,,0,0,0,,Сәлем
Dialogue: 0,0:09:17.22,0:09:18.14,Default,,0,0,0,,Мари
Dialogue: 0,0:09:18.26,0:09:19.10,Default,,0,0,0,,Анна
Dialogue: 0,0:09:19.43,0:09:22.72,Default,,0,0,0,,Бүгін мен шаштарыңызға және макияжыңызға көмектесемін.
Dialogue: 0,0:09:25.77,0:09:27.60,Default,,0,0,0,,Екеуің де жақсысыңдар ма?
Dialogue: 0,0:09:27.85,0:09:29.56,Default,,0,0,0,,Вау (сейсенбі) Кристалл
Dialogue: 0,0:09:29.98,0:09:32.32,Default,,0,0,0,,Мен бұл туралы Грэммиде ойладым.
Dialogue: 0,0:09:33.07,0:09:36.82,Default,,0,0,0,,Босқын Кэрол мен Валеридің қызы Сейсенбі
Dialogue: 0,0:09:37.41,0:09:41.74,Default,,0,0,0,,Бұл екеуі шынымен араласып, музыка жасайды.
Dialogue: 0,0:09:41.87,0:09:43.70,Default,,0,0,0,,Мен көргенде солай болды
Dialogue: 0,0:09:43.95,0:09:48.17,Default,,0,0,0,,Сен қараңғылықтағы жарықсың
Dialogue: 0,0:09:48.29,0:09:49.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:49.67,0:09:53.17,Default,,0,0,0,,Сол жарық көбірек адамдарды жарықтандыруы керек.
Dialogue: 0,0:09:53.55,0:09:54.88,Default,,0,0,0,,меніңше, бұл – нағыз ақымақтық шыңы… Яғни—
Dialogue: 0,0:09:55.01,0:09:56.34,Default,,0,0,0,,Рахмет
Dialogue: 0,0:09:56.59,0:10:01.68,Default,,0,0,0,,Мен оны түрмеде Скипке арнап айтамын.
Dialogue: 0,0:10:01.97,0:10:03.72,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:10:04.14,0:10:06.56,Default,,0,0,0,,Қиналған жігіттің орнына...
Dialogue: 0,0:10:06.68,0:10:08.77,Default,,0,0,0,,Енді қатысуға рұқсат етемін.
Dialogue: 0,0:10:08.98,0:10:10.40,Default,,0,0,0,,(гитара дыбысы)
Dialogue: 0,0:10:10.69,0:10:12.69,Default,,0,0,0,,Жалғыз Кларенс
Dialogue: 0,0:10:12.82,0:10:17.65,Default,,0,0,0,,Екеуіңіз сияқты мен де Грэммиде «Жаңа суретші» жүлдесін жеңе алмадым.
Dialogue: 0,0:10:17.95,0:10:21.57,Default,,0,0,0,,Ендеше, жасы аз болса да, оны жаңадан шақырайық.
Dialogue: 0,0:10:21.70,0:10:22.37,Default,,0,0,0,,Иә
Dialogue: 0,0:10:22.58,0:10:24.99,Default,,0,0,0,,Сәлем Кэрол және сейсенбі
Dialogue: 0,0:10:25.12,0:10:26.04,Default,,0,0,0,,Пау
Dialogue: 0,0:10:26.29,0:10:27.08,Default,,0,0,0,,Петр
Dialogue: 0,0:10:27.20,0:10:28.12,Default,,0,0,0,,ＧＧＫ
Dialogue: 0,0:10:28.25,0:10:31.75,Default,,0,0,0,,Біз де бірлік ретінде дебют жасадық хаха
Dialogue: 0,0:10:32.04,0:10:35.71,Default,,0,0,0,,...Менің айтайын дегенім, бұл қызықты оқиға сияқты естіледі, сондықтан мен оны міндетті түрде мінемін.
Dialogue: 0,0:10:36.05,0:10:37.34,Default,,0,0,0,,Ғаламның еркінен
Dialogue: 0,0:10:37.47,0:10:40.72,Default,,0,0,0,,Сіз маған қатысуды сұрадыңыз, иә?
Dialogue: 0,0:10:40.84,0:10:42.85,Default,,0,0,0,,Танысқаныма қуаныштымын~ Пау
Dialogue: 0,0:10:44.51,0:10:45.35,Default,,0,0,0,,Флора-сан
Dialogue: 0,0:10:45.68,0:10:47.93,Default,,0,0,0,,Сен... келдің.
Dialogue: 0,0:10:48.06,0:10:50.14,Default,,0,0,0,,Өте жақсы жоба.
Dialogue: 0,0:10:50.27,0:10:51.81,Default,,0,0,0,,Мен... Кешіріңіз.
Dialogue: 0,0:10:52.10,0:10:55.73,Default,,0,0,0,,Мен қанша ән айта алатынымды білмеймін.
Dialogue: 0,0:10:55.86,0:10:59.03,Default,,0,0,0,,Мен бәріне қиындық тудыруы мүмкін, бірақ
Dialogue: 0,0:10:59.36,0:11:02.41,Default,,0,0,0,,Сіз аз болса да ән айта аласыз ба?
Dialogue: 0,0:11:02.53,0:11:03.53,Default,,0,0,0,,Бірлесіп күресу
Dialogue: 0,0:11:03.66,0:11:04.83,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:11:05.37,0:11:06.45,Default,,0,0,0,,Флора
Dialogue: 0,0:11:06.58,0:11:07.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:09.25,0:11:10.79,Default,,0,0,0,,Кристалл
Dialogue: 0,0:11:10.92,0:11:14.13,Default,,0,0,0,,Әніңіз маған қатты әсер етті.
Dialogue: 0,0:11:14.25,0:11:16.71,Default,,0,0,0,,Сізбен бірге ән айту құрметті.
Dialogue: 0,0:11:18.67,0:11:20.22,Default,,0,0,0,,Мен де солай.
Dialogue: 0,0:11:20.84,0:11:22.34,Default,,0,0,0,,Эй, не... (сейсенбі мен Кэрол) Иә?
Dialogue: 0,0:11:23.01,0:11:24.22,Default,,0,0,0,,Бұл Десмонд мырза емес пе?
Dialogue: 0,0:11:24.35,0:11:25.14,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:11:25.39,0:11:26.43,Default,,0,0,0,,Де… Деде…
Dialogue: 0,0:11:26.56,0:11:28.39,Default,,0,0,0,,Десмонд мырза?
Dialogue: 0,0:11:30.68,0:11:31.89,Default,,0,0,0,,Иә, Юта Отокоцу
Dialogue: 0,0:11:32.02,0:11:33.73,Default,,0,0,0,,Денеге келетін болсақ...
Dialogue: 0,0:11:33.85,0:11:38.19,Default,,0,0,0,,Ұйықтауға әлі ерте сияқты.
Dialogue: 0,0:11:38.53,0:11:41.78,Default,,0,0,0,,Мен бұл әнді айтқанша өлмеймін
Dialogue: 0,0:11:42.78,0:11:45.99,Default,,0,0,0,,Музыка сиқырлы әңгіме сияқты
Dialogue: 0,0:11:46.12,0:11:50.66,Default,,0,0,0,,Осы әнді тыңдап отырып, мен көп нәрсені сезіндім.
Dialogue: 0,0:11:51.08,0:11:56.50,Default,,0,0,0,,Өлеңдеріңізге салған сезімдер мәңгілік қалары сөзсіз.
Dialogue: 0,0:11:56.63,0:11:58.30,Default,,0,0,0,,Ха…
Dialogue: 0,0:11:58.46,0:11:59.96,Default,,0,0,0,,Бұл таңқаларлық.
Dialogue: 0,0:12:00.09,0:12:03.01,Default,,0,0,0,,Екеуі барлығын шақырса керек.
Dialogue: 0,0:12:03.13,0:12:04.05,Default,,0,0,0,,О
Dialogue: 0,0:12:04.18,0:12:06.68,Default,,0,0,0,,Сол далада қалған жігіттер...
Dialogue: 0,0:12:07.14,0:12:09.56,Default,,0,0,0,,Білмей тұрып, есейесің
Dialogue: 0,0:12:11.48,0:12:13.44,Default,,0,0,0,,Енді шақырған музыкант...
Dialogue: 0,0:12:13.56,0:12:14.81,Default,,0,0,0,,Барлығы осында.
Dialogue: 0,0:12:15.19,0:12:17.48,Default,,0,0,0,,Жоқ, тағы бір адам.
Dialogue: 0,0:12:17.61,0:12:19.82,Default,,0,0,0,,Мен де Анджеланы шақырдым.
Dialogue: 0,0:12:20.15,0:12:21.90,Default,,0,0,0,,Ах... бұл...
Dialogue: 0,0:12:22.03,0:12:24.95,Default,,0,0,0,,Бұл сәл қиын болуы мүмкін.
Dialogue: 0,0:12:25.74,0:12:27.74,Default,,0,0,0,,Көріп отырғаныңыздай, сол теракт...
Dialogue: 0,0:12:27.87,0:12:30.33,Default,,0,0,0,,Мен бұл Джерридің өз туындысы екеніне сенімдімін.
Dialogue: 0,0:12:30.70,0:12:31.75,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:31.87,0:12:33.83,Default,,0,0,0,,Шешім қабылдаңыз.
Dialogue: 0,0:12:34.21,0:12:37.33,Default,,0,0,0,,Мен анама сенемін.
Dialogue: 0,0:12:41.21,0:12:42.67,Default,,0,0,0,,Иә? Ах...
Dialogue: 0,0:12:44.59,0:12:46.22,Default,,0,0,0,,Ангела…
Dialogue: 0,0:12:48.47,0:12:52.85,Default,,0,0,0,,Мен сенің әндеріңді неге сонша жек көретінімді енді түсіндім.
Dialogue: 0,0:12:53.18,0:12:54.81,Default,,0,0,0,,Менің есімде.
Dialogue: 0,0:12:55.19,0:12:58.65,Default,,0,0,0,,Ән айту мені көңілді болған кезге қайтарады.
Dialogue: 0,0:12:59.65,0:13:01.98,Default,,0,0,0,,Мен мұны мойындағым келмеді.
Dialogue: 0,0:13:02.40,0:13:06.03,Default,,0,0,0,,Мен оны жоғалтып алдым
Dialogue: 0,0:13:07.20,0:13:08.70,Default,,0,0,0,,Ангела
Dialogue: 0,0:13:09.37,0:13:13.04,Default,,0,0,0,,Бірақ қазір бәрі басқаша.
Dialogue: 0,0:13:15.87,0:13:18.21,Default,,0,0,0,,Мен бірге ән айтқым келеді
Dialogue: 0,0:13:18.50,0:13:20.25,Default,,0,0,0,,Әй, жанымнан кетпе!
Dialogue: 0,0:13:21.42,0:13:22.92,Default,,0,0,0,,Барлығың тыңдаңдар.
Dialogue: 0,0:13:23.05,0:13:24.63,Default,,0,0,0,,Бұл ән дәл 0:00-де ойналды.
Dialogue: 0,0:13:24.97,0:13:28.55,Default,,0,0,0,,Бір уақытта бүкіл әлем бойынша тек бір рет таратылады
Dialogue: 0,0:13:28.68,0:13:31.56,Default,,0,0,0,,Бұл әннің авторы - Carol & Tuesday
Dialogue: 0,0:13:31.68,0:13:34.98,Default,,0,0,0,,Продюсері: Тоби мен Ертегін.
Dialogue: 0,0:13:35.52,0:13:38.27,Default,,0,0,0,,Ән айтпас бұрын екеуің бірдеңе айтқың келеді ме?
Dialogue: 0,0:13:38.69,0:13:39.98,Default,,0,0,0,,О
Dialogue: 0,0:13:40.56,0:13:42.61,Default,,0,0,0,,Басқалар берген еркіндік
Dialogue: 0,0:13:42.73,0:13:44.57,Default,,0,0,0,,...Бұл ақымақтық.
Dialogue: 0,0:13:44.69,0:13:49.16,Default,,0,0,0,,Бостандық, егер сіз оны жеңіп алсаңыз ғана шынайы болады.
Dialogue: 0,0:13:50.32,0:13:51.66,Default,,0,0,0,,Ертегін ше?
Dialogue: 0,0:13:51.78,0:13:53.24,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:13:53.58,0:13:57.71,Default,,0,0,0,,Мұнда жиналғандардың бәрі – ең жақсы әншілер.
Dialogue: 0,0:13:57.83,0:14:01.34,Default,,0,0,0,,Сондықтан ән айт
Dialogue: 0,0:14:02.25,0:14:03.75,Default,,0,0,0,,(Смартфон жұмысының дыбысы)
Dialogue: 0,0:14:03.88,0:14:09.22,Default,,0,0,0,,(Қоңырау үні)
Dialogue: 0,0:14:09.34,0:14:10.01,Default,,0,0,0,,(Жауап дыбысы)
Dialogue: 0,0:14:10.14,0:14:10.93,Default,,0,0,0,,Джерри?
Dialogue: 0,0:14:11.05,0:14:14.64,Default,,0,0,0,,Әй, мына сағатта не істеп жүрсің?
Dialogue: 0,0:14:14.97,0:14:16.93,Default,,0,0,0,,Енді келудің қажеті жоқ.
Dialogue: 0,0:14:17.06,0:14:21.36,Default,,0,0,0,,Ахахахха Бұл жыл санаулы сағатта аяқталады.
Dialogue: 0,0:14:21.48,0:14:25.90,Default,,0,0,0,,Жоқ, келесі жылы және одан кейін келудің қажеті жоқ.
Dialogue: 0,0:14:26.49,0:14:27.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:27.70,0:14:29.49,Default,,0,0,0,,Сіз жұмыстан босатылдыңыз, Джерри.
Dialogue: 0,0:14:29.61,0:14:31.57,Default,,0,0,0,,Себебін өзіңіз білесіз, солай ма?
Dialogue: 0,0:14:31.70,0:14:32.74,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:32.95,0:14:35.49,Default,,0,0,0,,Терроризм сіздің жеке туындыңыз болды.
Dialogue: 0,0:14:35.62,0:14:38.21,Default,,0,0,0,,Спенсер дәлелді тапты.
Dialogue: 0,0:14:38.83,0:14:41.21,Default,,0,0,0,,Жақсы нәрсе, мен президент болғанға дейін...
Dialogue: 0,0:14:41.33,0:14:43.59,Default,,0,0,0,,Мұны біліңіз
Dialogue: 0,0:14:44.71,0:14:46.76,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:14:47.05,0:14:50.22,Default,,0,0,0,,Менің сөзімді кесіп, құтыла аламын деп ойлайсың ба?
Dialogue: 0,0:14:50.34,0:14:52.47,Default,,0,0,0,,Біз бір лотос оқушымыз.
Dialogue: 0,0:14:52.60,0:14:55.39,Default,,0,0,0,,Сіз кінәлісіз.
Dialogue: 0,0:14:55.51,0:14:58.10,Default,,0,0,0,,Иә, әрине білемін.
Dialogue: 0,0:14:58.68,0:15:01.27,Default,,0,0,0,,Мен президенттікке кандидатурадан бас тарту туралы шешім қабылдадым.
Dialogue: 0,0:15:01.56,0:15:02.35,Default,,0,0,0,,На... (мысықтың мияулауы)
Dialogue: 0,0:15:02.48,0:15:03.36,Default,,0,0,0,,Сондай-ақ нөлден...
Dialogue: 0,0:15:03.61,0:15:05.77,Default,,0,0,0,,Ха! (Валериа) Мен басынан бастайын.
Dialogue: 0,0:15:06.11,0:15:08.11,Default,,0,0,0,,Шындығында, кешіріңіз.
Dialogue: 0,0:15:08.24,0:15:12.62,Default,,0,0,0,,Жасалғыңыз келмейтін саясаттарды орындаудың қажеті жоқ және...
Dialogue: 0,0:15:12.87,0:15:14.24,Default,,0,0,0,,А... иә?
Dialogue: 0,0:15:14.70,0:15:18.58,Default,,0,0,0,,Сенің жиіркенішті дауысыңды енді естудің қажеті жоқ деп сене алар емеспін.
Dialogue: 0,0:15:18.79,0:15:19.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:19.58,0:15:21.92,Default,,0,0,0,,Адиос Джерри
Dialogue: 0,0:15:22.04,0:15:23.46,Default,,0,0,0,,(Қоңырауды ажырату дыбысы және ажырату дыбысы)
Dialogue: 0,0:15:23.46,0:15:24.50,Default,,0,0,0,,(Қоңырауды ажырату дыбысы және ажырату дыбысы)
Dialogue: 0,0:15:23.46,0:15:24.50,Default,,0,0,0,,Иә
Dialogue: 0,0:15:24.50,0:15:24.96,Default,,0,0,0,,(Қоңырауды ажырату дыбысы және ажырату дыбысы)
Dialogue: 0,0:15:25.25,0:15:26.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:27.92,0:15:31.80,Default,,0,0,0,,Жарайды, не болғанына қарамастан, камераны айналдыра беріңіз.
Dialogue: 0,0:15:32.09,0:15:34.76,Default,,0,0,0,,Осы ән біткенше ешкімді өткізбе
Dialogue: 0,0:15:35.05,0:15:37.85,Default,,0,0,0,,Сіз президент болсаңыз да.
Dialogue: 0,0:15:41.14,0:15:44.44,Default,,0,0,0,,Жарайды, қазір бастайық.
Dialogue: 0,0:15:45.31,0:15:51.90,Default,,0,0,0,,(Залдағы музыка)
Dialogue: 0,0:16:11.80,0:16:17.10,Default,,0,0,0,,♪ Әр адам кейде ұшудан қорқады.
