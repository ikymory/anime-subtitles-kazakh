Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.00,0:00:05.96,Default,,0,0,0,,Бұл ғажайып сияқты болды
Dialogue: 0,0:00:06.29,0:00:10.71,Default,,0,0,0,,Иә, ол Марс тарихына жазылды.
Dialogue: 0,0:00:10.84,0:00:12.88,Default,,0,0,0,,«Жеті минут ғажайып»
Dialogue: 0,0:00:13.51,0:00:19.97,Default,,0,0,0,,Бұл оның қозғаушы күшіне айналған екі қыздың оқиғасы.
Dialogue: 0,0:00:34.07,0:00:35.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:41.54,0:00:48.54,Default,,0,0,0,,(чемоданның жүгіру дыбысы)
Dialogue: 0,0:00:51.92,0:00:52.88,Default,,0,0,0,,(аутентификация дыбысы)
Dialogue: 0,0:01:00.56,0:01:02.14,Default,,0,0,0,,Үйден қашқанда не істейсің?
Dialogue: 0,0:01:02.77,0:01:06.02,Default,,0,0,0,,Менен мұны сұрайтын ешкім жоқ.
Dialogue: 0,0:01:06.14,0:01:08.15,Default,,0,0,0,,Мен әртүрлі нәрселерді іздеуге тырыстым, бірақ...
Dialogue: 0,0:01:08.27,0:01:11.07,Default,,0,0,0,,Мен оны қолданып көргенде таңқаларлық оңай болды.
Dialogue: 0,0:01:16.53,0:01:17.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:17.95,0:01:19.07,Default,,0,0,0,,Хехе
Dialogue: 0,0:01:19.74,0:01:21.28,Default,,0,0,0,,Уау
Dialogue: 0,0:01:21.66,0:01:23.83,Default,,0,0,0,,(әлсіз жүгіру дыбысы)
Dialogue: 0,0:01:23.95,0:01:25.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:26.25,0:01:27.79,Default,,0,0,0,,Төлеңіз
Dialogue: 0,0:01:27.92,0:01:29.46,Default,,0,0,0,,және келісім-шарт аяқталады
Dialogue: 0,0:01:27.92,0:01:29.46,Default,,0,0,0,,Төлеңіз
Dialogue: 0,0:01:30.08,0:01:32.55,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:34.38,0:01:36.84,Default,,0,0,0,,Альба қаласына баратын соңғы пойыз -
Dialogue: 0,0:01:36.97,0:01:38.26,Default,,0,0,0,,Пойыз жақында жолға шығады.
Dialogue: 0,0:01:38.26,0:01:38.97,Default,,0,0,0,,Пойыз жақында жолға шығады.
Dialogue: 0,0:01:38.26,0:01:38.97,Default,,0,0,0,,Ах~ Ах!
Dialogue: 0,0:01:38.97,0:01:39.76,Default,,0,0,0,,Ах~ Ах!
Dialogue: 0,0:01:39.76,0:01:40.89,Default,,0,0,0,,Ах~ Ах!
Dialogue: 0,0:01:39.76,0:01:40.89,Default,,0,0,0,,Пайдаланушылар
Dialogue: 0,0:01:40.89,0:01:41.55,Default,,0,0,0,,Пайдаланушылар
Dialogue: 0,0:01:41.68,0:01:42.72,Default,,0,0,0,,Көлікте күтіңіз.
Dialogue: 0,0:01:42.72,0:01:44.10,Default,,0,0,0,,Көлікте күтіңіз.
Dialogue: 0,0:01:42.72,0:01:44.10,Default,,0,0,0,,Күтіңіз, күтіңіз!
Dialogue: 0,0:01:44.39,0:01:45.98,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:01:48.10,0:01:48.98,Default,,0,0,0,,Уф!
Dialogue: 0,0:01:49.19,0:01:50.36,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:01:50.61,0:01:53.02,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:01:54.82,0:01:58.74,Default,,0,0,0,,Ойланып қарасам, бірінші рет пойызға міндім...
Dialogue: 0,0:01:59.66,0:02:00.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:00.62,0:02:03.54,Default,,0,0,0,,Мен қателескен шығармын
Dialogue: 0,0:02:00.62,0:02:03.54,Default,,0,0,0,,(Ешкі дыбысы)
Dialogue: 0,0:02:05.25,0:02:07.58,Default,,0,0,0,,Синди Лаупер бұрын болған-
Dialogue: 0,0:02:07.71,0:02:10.79,Default,,0,0,0,,«Грейпфрут шырыны» кітабын ұстау-
Dialogue: 0,0:02:10.92,0:02:14.84,Default,,0,0,0,,17 жасында музыкамен айналысу үшін үйден қашып кеткен.
Dialogue: 0,0:02:15.92,0:02:17.13,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:21.85,0:02:23.51,Default,,0,0,0,,Мен де 17 жастамын...
Dialogue: 0,0:02:23.97,0:02:26.85,Default,,0,0,0,,Мен уайымдамадым десем, өтірік айтқан болар едім.
Dialogue: 0,0:02:26.98,0:02:29.02,Default,,0,0,0,,Бос Хершел қаласынан шығу...
Dialogue: 0,0:02:29.39,0:02:32.40,Default,,0,0,0,,Музыкант болу үшін жас
Dialogue: 0,0:02:32.52,0:02:35.02,Default,,0,0,0,,Дұрыс, Синди.
Dialogue: 0,0:02:40.20,0:02:40.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:48.41,0:02:50.29,Default,,0,0,0,,Хмм... Уф!
Dialogue: 0,0:02:55.25,0:02:56.00,Default,,0,0,0,,Әй, жанымнан кетпе!
Dialogue: 0,0:03:00.51,0:03:02.76,Default,,0,0,0,,Ухммм… ммм…
Dialogue: 0,0:03:07.18,0:03:09.89,Default,,0,0,0,,Хоухоу Хоухоу Хоухоу
Dialogue: 0,0:03:10.81,0:03:13.65,Default,,0,0,0,,Хоухоу Хоухоу Хоухоу
Dialogue: 0,0:03:18.57,0:03:19.53,Default,,0,0,0,,Хоу! Уау
Dialogue: 0,0:03:19.65,0:03:21.40,Default,,0,0,0,,Мен... Цу...
Dialogue: 0,0:03:23.24,0:03:26.12,Default,,0,0,0,,А... иә? Қарғыс атсын!
Dialogue: 0,0:03:39.46,0:03:40.72,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:04:02.70,0:04:07.08,Default,,0,0,0,,Аруба қаласына Марстың түкпір-түкпірінен адамдар келеді.
Dialogue: 0,0:04:08.12,0:04:12.62,Default,,0,0,0,,Ешкім емес адамдар біреу болуға тырысады.
Dialogue: 0,0:04:12.75,0:04:13.92,Default,,0,0,0,,Уау (құлап жатқан дыбыс)
Dialogue: 0,0:04:14.29,0:04:16.67,Default,,0,0,0,,Ақша тауып, сатып ал, балам!
Dialogue: 0,0:04:17.09,0:04:18.00,Default,,0,0,0,,Уайымдамаңыз!
Dialogue: 0,0:04:19.59,0:04:24.34,Default,,0,0,0,,Мұнда барлығы бәсекелес, сондықтан оған жету үшін сізге қиын болуы керек.
Dialogue: 0,0:04:24.47,0:04:27.01,Default,,0,0,0,,Тоқтасаң өмір сүре алмайсың.
Dialogue: 0,0:04:28.72,0:04:29.89,Default,,0,0,0,,Уау...
Dialogue: 0,0:04:30.27,0:04:32.35,Default,,0,0,0,,Қала сияқты...
Dialogue: 0,0:04:33.60,0:04:34.77,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:04:37.69,0:04:38.65,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:04:39.48,0:04:41.07,Default,,0,0,0,,Секіру жиынтығы
Dialogue: 0,0:04:41.19,0:04:45.41,Default,,0,0,0,,Сондай-ақ, мен бұрын тапсырыс берген мына кофе ащы.
Dialogue: 0,0:04:45.66,0:04:48.62,Default,,0,0,0,,Күрсін... кофе әдетте ащы...
Dialogue: 0,0:04:48.74,0:04:51.33,Default,,0,0,0,,Не? Сонда клиент ретінде менің кінәм бар ма?
Dialogue: 0,0:04:51.79,0:04:54.79,Default,,0,0,0,,Ей, мен қатты ауырдым.
Dialogue: 0,0:04:54.91,0:04:56.50,Default,,0,0,0,,Менің кінәм бар ма? бұл әйел
Dialogue: 0,0:04:56.62,0:04:57.88,Default,,0,0,0,,(Қоңырау үні)
Dialogue: 0,0:04:58.00,0:04:59.67,Default,,0,0,0,,А, сәл күте тұрыңыз.
Dialogue: 0,0:05:01.00,0:05:02.59,Default,,0,0,0,,Иә Тапсырысыңыз туралы не айтасыз?
Dialogue: 0,0:05:02.71,0:05:05.93,Default,,0,0,0,,1 артқа секіру
Dialogue: 0,0:05:06.59,0:05:07.47,Default,,0,0,0,,Үлкен апа
Dialogue: 0,0:05:07.84,0:05:08.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:09.43,0:05:12.56,Default,,0,0,0,,Бұл ондай дүкен емес...
Dialogue: 0,0:05:12.68,0:05:14.81,Default,,0,0,0,,Бұл не? Сен ұсқынсызсың.
Dialogue: 0,0:05:19.94,0:05:22.73,Default,,0,0,0,,Қала... тым көп адам
Dialogue: 0,0:05:30.12,0:05:31.08,Default,,0,0,0,,(1-ші тұтынушы мен 2-клиенттің тамақ ішкен дыбыстары)
Dialogue: 0,0:05:31.20,0:05:33.37,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:05:36.62,0:05:37.79,Default,,0,0,0,,Ха…
Dialogue: 0,0:05:41.13,0:05:42.13,Default,,0,0,0,,Иә
Dialogue: 0,0:05:43.84,0:05:44.51,Default,,0,0,0,,Не!
Dialogue: 0,0:05:44.88,0:05:46.30,Default,,0,0,0,,Ах… Ах… Ааах…
Dialogue: 0,0:05:46.42,0:05:48.13,Default,,0,0,0,,Не... ұры!
Dialogue: 0,0:05:51.64,0:05:54.06,Default,,0,0,0,,А... бұл өтірік, солай ма?
Dialogue: 0,0:05:55.60,0:05:57.64,Default,,0,0,0,,Мені қаттырақ ұстаңыз
Dialogue: 0,0:05:58.06,0:05:59.56,Default,,0,0,0,,Оны қатты қысыңыз
Dialogue: 0,0:05:59.98,0:06:02.36,Default,,0,0,0,,Жасыл шырын дуриан да бар!
Dialogue: 0,0:06:02.90,0:06:05.53,Default,,0,0,0,,Қарлығаш! Ухухуху
Dialogue: 0,0:06:06.99,0:06:09.57,Default,,0,0,0,,Иә Кесінді Жарайды Жақсы жұмыс
Dialogue: 0,0:06:10.16,0:06:11.87,Default,,0,0,0,,(Дос) Шынымен бе? Осы сериядағы «7» қатты әсерлі болар сияқты.
Dialogue: 0,0:06:12.41,0:06:12.95,Default,,0,0,0,,Саған жақсылық, Анджела.
Dialogue: 0,0:06:12.95,0:06:14.37,Default,,0,0,0,,Саған жақсылық, Анджела.
Dialogue: 0,0:06:12.95,0:06:14.37,Default,,0,0,0,,Маюри үшін сол сәт келгенде қасында болғым келеді… яғни…
Dialogue: 0,0:06:14.66,0:06:15.50,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:06:16.29,0:06:18.12,Default,,0,0,0,,Анджела, у...
Dialogue: 0,0:06:18.25,0:06:19.46,Default,,0,0,0,,Бұл... Уау!
Dialogue: 0,0:06:20.33,0:06:22.79,Default,,0,0,0,,Бұл не сұмдық жарнама?
Dialogue: 0,0:06:22.92,0:06:25.34,Default,,0,0,0,,Мен мұндай жұмысқа алғым келмеді.
Dialogue: 0,0:06:25.51,0:06:27.88,Default,,0,0,0,,Неліктен екінші бөлімді түсіріп жатырсыз?
Dialogue: 0,0:06:28.01,0:06:31.30,Default,,0,0,0,,Мм...шынымен үшінші бөлім осыдан кейін түсіріледі.
Dialogue: 0,0:06:32.43,0:06:35.18,Default,,0,0,0,,Енді келудің қажеті жоқ.
Dialogue: 0,0:06:35.39,0:06:36.27,Default,,0,0,0,,Иә? мм...
Dialogue: 0,0:06:36.68,0:06:39.52,Default,,0,0,0,,Жұмыстан шығарылды! Жұмыстан шығарылды! Жұмыстан шығарылды!
Dialogue: 0,0:06:41.06,0:06:43.48,Default,,0,0,0,,Мен тағы да толық емес жұмыс күнімнен босатылдым.
Dialogue: 0,0:06:44.40,0:06:48.99,Default,,0,0,0,,Бұл өмір сүру мүлде қиын дүние, бірақ мен бас тарта алмаймын.
Dialogue: 0,0:06:50.07,0:06:55.33,Default,,0,0,0,,Өйткені бұл қалада мен бірдеңе істегім келеді.
Dialogue: 0,0:06:56.91,0:06:59.04,Default,,0,0,0,,Ух... (іш шымырлайды)
Dialogue: 0,0:07:01.42,0:07:04.42,Default,,0,0,0,,Мен қазір үйге баруым керек деп ойлаймын...
Dialogue: 0,0:07:08.59,0:07:10.63,Default,,0,0,0,,Жоқ... Жоқ, жоқ!
Dialogue: 0,0:07:11.43,0:07:13.64,Default,,0,0,0,,Сейсенбі сәтті өтсін
Dialogue: 0,0:07:16.26,0:07:17.39,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:07:17.77,0:07:21.94,Default,,0,0,0,,Мұндай жерде мені ешкім тыңдамайды.
Dialogue: 0,0:07:24.81,0:07:31.82,Default,,0,0,0,,(Пернетақта өнімділігі)
Dialogue: 0,0:07:34.49,0:07:35.58,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:07:35.91,0:07:39.29,Default,,0,0,0,,Адамдар мені қызықтырмайды.
Dialogue: 0,0:07:40.33,0:07:45.33,Default,,0,0,0,,Бірақ мен ән айтқым келеді, сол сезім...
Dialogue: 0,0:07:45.92,0:07:52.93,Default,,0,0,0,,(Пернетақта ойнау және гуілдеу)
Dialogue: 0,0:08:17.33,0:08:18.49,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:20.04,0:08:22.46,Default,,0,0,0,,Ах... бұл мен...
Dialogue: 0,0:08:22.58,0:08:23.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:25.21,0:08:26.04,Default,,0,0,0,,Рахмет
Dialogue: 0,0:08:26.63,0:08:27.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:28.09,0:08:32.38,Default,,0,0,0,,Аа... Не айтып тұрғаныңызды түсінбедім.
Dialogue: 0,0:08:32.51,0:08:34.30,Default,,0,0,0,,Хаха... Ах...
Dialogue: 0,0:08:35.30,0:08:39.56,Default,,0,0,0,,«Мен жалғызбын, бірақ мен жалғыз емес екенімді айтқым келеді».
Dialogue: 0,0:08:39.68,0:08:43.56,Default,,0,0,0,,«Мен жалғызбын, бірақ мен жалғыз емес екенімді айтқым келеді».
Dialogue: 0,0:08:44.27,0:08:46.19,Default,,0,0,0,,Мен солай ойладым
Dialogue: 0,0:08:47.56,0:08:50.23,Default,,0,0,0,,Иә! Бұл дұрыс
Dialogue: 0,0:08:50.78,0:08:52.82,Default,,0,0,0,,Эй, сен онда не істеп жүрсің?
Dialogue: 0,0:08:53.07,0:08:54.86,Default,,0,0,0,,Мұнда көшеде спектакль қоюға тыйым салынады.
Dialogue: 0,0:08:55.82,0:08:57.28,Default,,0,0,0,,Қашып кету (сейсенбі) Иә?
Dialogue: 0,0:08:57.78,0:08:59.03,Default,,0,0,0,,Балалар! (сейсенбі) А
Dialogue: 0,0:08:59.33,0:09:00.58,Default,,0,0,0,,Мені жайбарақаттармен бірге қоспа
Dialogue: 0,0:09:02.37,0:09:04.04,Default,,0,0,0,,А... а?
Dialogue: 0,0:09:04.83,0:09:06.83,Default,,0,0,0,,Мен сейсенбіде!
Dialogue: 0,0:09:06.96,0:09:08.21,Default,,0,0,0,,Сейсенбі күні туылған ба?
Dialogue: 0,0:09:08.33,0:09:09.13,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:09:09.63,0:09:10.96,Default,,0,0,0,,Мен Кэролмын
Dialogue: 0,0:09:11.09,0:09:12.38,Default,,0,0,0,,Рождествода туылған ба?
Dialogue: 0,0:09:12.51,0:09:13.67,Default,,0,0,0,,Мүмкін!
Dialogue: 0,0:09:13.80,0:09:15.51,Default,,0,0,0,,Уху-у-у-у-у
Dialogue: 0,0:09:15.63,0:09:18.89,Default,,0,0,0,,(Кэрол мен сейсенбінің күлкісі)
Dialogue: 0,0:09:28.15,0:09:29.40,Default,,0,0,0,,Иә, Анджела?
Dialogue: 0,0:09:29.56,0:09:31.11,Default,,0,0,0,,Шынайы өтірік пе?
Dialogue: 0,0:09:31.48,0:09:34.15,Default,,0,0,0,,(Адамдар қолдайды)
Dialogue: 0,0:09:34.28,0:09:36.28,Default,,0,0,0,,Ангела! (4-желдеткіш) Күте тұрыңыз!
Dialogue: 0,0:09:39.57,0:09:42.12,Default,,0,0,0,,...және? Не айтқың келеді?
Dialogue: 0,0:09:42.62,0:09:44.37,Default,,0,0,0,,Бұл... оның кінәсі...
Dialogue: 0,0:09:44.50,0:09:45.91,Default,,0,0,0,,Егер келесі жолы орындасаңыз...
Dialogue: 0,0:09:47.16,0:09:49.92,Default,,0,0,0,,Барлық менеджерлер AI болады
Dialogue: 0,0:09:50.08,0:09:53.84,Default,,0,0,0,,Мұны істеуді тоқтатыңыз, енді қорқытумен күресудің қажеті жоқ.
Dialogue: 0,0:09:55.09,0:09:59.09,Default,,0,0,0,,Жарайсың ба? менің тәтті ренжім
Dialogue: 0,0:09:59.26,0:10:03.39,Default,,0,0,0,,Мен сен үшін бәрін істеп жатырмын.
Dialogue: 0,0:10:03.76,0:10:04.93,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:10:06.23,0:10:07.35,Default,,0,0,0,,О, өтінемін, мені өлтірме
Dialogue: 0,0:10:19.49,0:10:20.45,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:10:20.91,0:10:25.58,Default,,0,0,0,,"Бұдан былай мен жалғыз тұрамын. Маған уайымдаудың немесе іздеудің қажеті жоқ."
Dialogue: 0,0:10:25.70,0:10:29.12,Default,,0,0,0,,«Тыныштанған бойда хабарласамын, кездескенше».
Dialogue: 0,0:10:29.25,0:10:30.46,Default,,0,0,0,,...өйткені
Dialogue: 0,0:10:30.58,0:10:31.79,Default,,0,0,0,,GPS туралы не деуге болады?
Dialogue: 0,0:10:31.92,0:10:32.79,Default,,0,0,0,,Кесу
Dialogue: 0,0:10:32.92,0:10:38.17,Default,,0,0,0,,Алайда, IC картасының тарихын қарастыратын болсақ, оның Альба қаласына бару мүмкіндігі жоғары.
Dialogue: 0,0:10:38.30,0:10:39.34,Default,,0,0,0,,Ха...
Dialogue: 0,0:10:39.47,0:10:41.14,Default,,0,0,0,,Не нәрсеге көңіліңіз толмайды?
Dialogue: 0,0:10:41.30,0:10:45.60,Default,,0,0,0,,Ешқандай ыңғайсыздықсыз өмір сүріңіз және қалағаныңызды беріңіз...
Dialogue: 0,0:10:45.72,0:10:48.14,Default,,0,0,0,,Тағы не қалайсыз?
Dialogue: 0,0:10:48.81,0:10:50.27,Default,,0,0,0,,Гитара жоқ
Dialogue: 0,0:10:50.39,0:10:51.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:51.81,0:10:54.19,Default,,0,0,0,,Ол...
Dialogue: 0,0:10:54.69,0:10:55.94,Default,,0,0,0,,Ха…
Dialogue: 0,0:10:56.53,0:11:00.53,Default,,0,0,0,,Мен жұмысқа қайта барамын. Мен сені сол қызға қарауға қалдырамын.
Dialogue: 0,0:11:00.66,0:11:01.99,Default,,0,0,0,,Сіз мұны істей аласыз, солай ма? Спенсер
Dialogue: 0,0:11:01.99,0:11:02.74,Default,,0,0,0,,Сіз мұны істей аласыз, солай ма? Спенсер
Dialogue: 0,0:11:01.99,0:11:02.74,Default,,0,0,0,,Сізде басқа туыстарыңыз жоқ па?
Dialogue: 0,0:11:02.74,0:11:03.24,Default,,0,0,0,,Сізде басқа туыстарыңыз жоқ па?
Dialogue: 0,0:11:03.24,0:11:05.49,Default,,0,0,0,,Сізде басқа туыстарыңыз жоқ па?
Dialogue: 0,0:11:03.24,0:11:05.49,Default,,0,0,0,,Түсіндім, мама.
Dialogue: 0,0:11:11.21,0:11:12.63,Default,,0,0,0,,(аутентификация дыбысы)
Dialogue: 0,0:11:12.83,0:11:14.21,Default,,0,0,0,,Сертификатталған
Dialogue: 0,0:11:14.54,0:11:16.71,Default,,0,0,0,,Artiens зертханасына қош келдіңіз
Dialogue: 0,0:11:21.84,0:11:25.76,Default,,0,0,0,,Тао мырза, сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:11:25.89,0:11:28.68,Default,,0,0,0,,Мен Дарья Анджеланың агентімін.
Dialogue: 0,0:11:28.81,0:11:32.19,Default,,0,0,0,,Мен Тао мырза шынымен маған хабарласады деп ойламадым.
Dialogue: 0,0:11:32.31,0:11:33.27,Default,,0,0,0,,Ум...
Dialogue: 0,0:11:33.40,0:11:34.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:35.82,0:11:38.07,Default,,0,0,0,,Мен саналы адаммын
Dialogue: 0,0:11:38.19,0:11:41.57,Default,,0,0,0,,Жағымпаздықсыз, әлеуметтік түсініктемелерсіз, т.б.
Dialogue: 0,0:11:42.03,0:11:44.78,Default,,0,0,0,,А, бірақ менің Анджела туралы...
Dialogue: 0,0:11:44.91,0:11:47.33,Default,,0,0,0,,Мен ол туралы бәрін түсінемін.
Dialogue: 0,0:11:48.04,0:11:51.33,Default,,0,0,0,,Бұл сіздің үлгі ретінде қаншалықты мәртебеңізге де байланысты.
Dialogue: 0,0:11:52.08,0:11:54.83,Default,,0,0,0,,Ол да әнші болуды жоспарлап отыр.
Dialogue: 0,0:11:55.21,0:12:00.59,Default,,0,0,0,,Бала актерлерден ауысу көбінесе сәтсіздікпен аяқталады
Dialogue: 0,0:12:02.13,0:12:06.18,Default,,0,0,0,,Біздің барлық хиттеріміз AI әншілері болды.
Dialogue: 0,0:12:06.30,0:12:08.60,Default,,0,0,0,,Мен ешқашан адамдармен жұмыс істеген емеспін.
Dialogue: 0,0:12:08.76,0:12:11.18,Default,,0,0,0,,Мен көптеген тексеру нәтижелерін алғым келеді
Dialogue: 0,0:12:11.52,0:12:13.94,Default,,0,0,0,,Демек, бұл мәміле.
Dialogue: 0,0:12:14.35,0:12:18.15,Default,,0,0,0,,Ең жақсы әндер мен жобаларды дайындаймыз
Dialogue: 0,0:12:18.61,0:12:19.48,Default,,0,0,0,,Оның орнына-
Dialogue: 0,0:12:20.36,0:12:22.86,Default,,0,0,0,,Сіз марионетка болуға дайынсыз ба?
Dialogue: 0,0:12:25.16,0:12:25.91,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:12:26.66,0:12:28.08,Default,,0,0,0,,Қалай болғанда да, ең алдымен мен Мими-уэге жақындауым керек, бірақ
Dialogue: 0,0:12:28.41,0:12:31.12,Default,,0,0,0,,Мен бұл салада 3 жасымнан бастап келемін...
Dialogue: 0,0:12:31.66,0:12:35.58,Default,,0,0,0,,Жалықтырғаным сонша, жалықтырып өлейін деп тұрмын.
Dialogue: 0,0:12:35.71,0:12:37.88,Default,,0,0,0,,Дүниені төңкеру
Dialogue: 0,0:12:38.00,0:12:41.80,Default,,0,0,0,,Ең жақсы марионетка болыңыз
Dialogue: 0,0:12:44.72,0:12:46.34,Default,,0,0,0,,Бұл адам үй иесі.
Dialogue: 0,0:12:46.47,0:12:48.60,Default,,0,0,0,,Танысқаныма қуаныштымын...
Dialogue: 0,0:12:48.72,0:12:49.89,Default,,0,0,0,,Маюшиі енді ғана айтылған сөздердің бір ауызын да түсінбеді.
Dialogue: 0,0:12:51.22,0:12:52.39,Default,,0,0,0,,Өтінемін, өтінемін.
Dialogue: 0,0:12:53.10,0:12:55.85,Default,,0,0,0,,Уау... бұл таңқаларлық кең.
Dialogue: 0,0:12:55.98,0:12:59.65,Default,,0,0,0,,Негізінде бұл үй иесінің қоймасы болатын.
Dialogue: 0,0:12:59.77,0:13:01.03,Default,,0,0,0,,А...
Dialogue: 0,0:13:01.98,0:13:03.53,Default,,0,0,0,,Сол ата-аналар...
Dialogue: 0,0:13:03.86,0:13:05.36,Default,,0,0,0,,Жоқ (сейсенбі) Иә...
Dialogue: 0,0:13:05.49,0:13:06.78,Default,,0,0,0,,Өйткені мен әрқашан жалғызбын
Dialogue: 0,0:13:08.62,0:13:09.70,Default,,0,0,0,,Ум...
Dialogue: 0,0:13:10.53,0:13:11.54,Default,,0,0,0,,Хи... ах
Dialogue: 0,0:13:14.04,0:13:16.75,Default,,0,0,0,,Бұл Зигги, менің үй жануарым және менің оятқышым.
Dialogue: 0,0:13:17.54,0:13:19.21,Default,,0,0,0,,Ах... (Зигги) Хоу?
Dialogue: 0,0:13:20.21,0:13:21.42,Default,,0,0,0,,Сүйкімді
Dialogue: 0,0:13:23.51,0:13:26.26,Default,,0,0,0,,Ендеше, үйден неге қашып кеттің?
Dialogue: 0,0:13:26.38,0:13:28.55,Default,,0,0,0,,Оның үйден қашып кеткенін қайдан білесің?
Dialogue: 0,0:13:28.68,0:13:30.97,Default,,0,0,0,,Бұл жай ғана сияқты.
Dialogue: 0,0:13:34.35,0:13:36.48,Default,,0,0,0,,Мен мұны көре аламын ба?
Dialogue: 0,0:13:39.86,0:13:42.90,Default,,0,0,0,,Уф! Бұл Гибсон! Шынайы ма?
Dialogue: 0,0:13:43.03,0:13:44.99,Default,,0,0,0,,(жолды дыбыс)
Dialogue: 0,0:13:46.03,0:13:47.45,Default,,0,0,0,,Ойнау мүмкін емес
Dialogue: 0,0:13:48.53,0:13:50.20,Default,,0,0,0,,Ойнаңыз (сейсенбі) Иә...
Dialogue: 0,0:13:51.91,0:13:55.29,Default,,0,0,0,,Оны ашыңыз... бірақ бұл мүмкін
Dialogue: 0,0:13:55.41,0:13:57.33,Default,,0,0,0,,Менің айтқым келгені бұл емес...
Dialogue: 0,0:13:58.29,0:14:01.42,Default,,0,0,0,,Мен оны ешқашан көпшілік алдында ойнаған емеспін...
Dialogue: 0,0:14:01.54,0:14:02.84,Default,,0,0,0,,Тіпті бір рет пе?
Dialogue: 0,0:14:04.80,0:14:07.30,Default,,0,0,0,,Оның үйден қашуға қатысы бар ма?
Dialogue: 0,0:14:12.68,0:14:14.35,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:15.43,0:14:17.43,Default,,0,0,0,,А...
Dialogue: 0,0:14:24.48,0:14:25.78,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:14:26.61,0:14:28.24,Default,,0,0,0,,Иә! газ
Dialogue: 0,0:14:28.36,0:14:31.41,Default,,0,0,0,,Не болды? Сіз шіріген зәйтүнге ұқсайсыз
Dialogue: 0,0:14:32.28,0:14:34.41,Default,,0,0,0,,Мына жігітті тоқтатыңыз
Dialogue: 0,0:14:34.54,0:14:35.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:35.83,0:14:40.17,Default,,0,0,0,,Мына қарғыс атқан музыканы тоқтатыңыз.
Dialogue: 0,0:14:40.96,0:14:46.38,Default,,0,0,0,,Гус, сіз музыка индустриясында бұрыннан барсыз, солай емес пе?
Dialogue: 0,0:14:46.51,0:14:49.30,Default,,0,0,0,,Мұндай нәрсе «кәрілік» деп аталады.
Dialogue: 0,0:14:49.43,0:14:50.80,Default,,0,0,0,,Не!
Dialogue: 0,0:14:50.93,0:14:52.80,Default,,0,0,0,,Оттотто
Dialogue: 0,0:14:54.01,0:14:54.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:54.81,0:14:55.51,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:14:55.64,0:14:56.81,Default,,0,0,0,,А...
Dialogue: 0,0:14:57.22,0:14:58.43,Default,,0,0,0,,(Газ тынысы)
Dialogue: 0,0:14:58.56,0:14:59.81,Default,,0,0,0,,Аа...
Dialogue: 0,0:15:01.27,0:15:02.94,Default,,0,0,0,,Бесік жырының қажеті жоқ деп ойлаймын.
Dialogue: 0,0:15:02.94,0:15:04.27,Default,,0,0,0,,Бесік жырының қажеті жоқ деп ойлаймын.
Dialogue: 0,0:15:06.48,0:15:10.49,Default,,0,0,0,,Мм... Мектепке сыймаймын.
Dialogue: 0,0:15:10.61,0:15:13.78,Default,,0,0,0,,Үнемі үйде болу
Dialogue: 0,0:15:14.45,0:15:17.45,Default,,0,0,0,,Күн сайын ауырады
Dialogue: 0,0:15:18.87,0:15:24.63,Default,,0,0,0,,Дәл осы кезде радиодан ескі хит ән естілді.
Dialogue: 0,0:15:24.75,0:15:29.72,Default,,0,0,0,,«Сенің шынайы түстерің кемпірқосақтай әдемі» деп ән айтады.
Dialogue: 0,0:15:30.05,0:15:34.68,Default,,0,0,0,,Сосын... көз жасы шықты.
Dialogue: 0,0:15:34.89,0:15:37.68,Default,,0,0,0,,Менің де музыка ойнағым келеді
Dialogue: 0,0:15:38.68,0:15:42.90,Default,,0,0,0,,Бірақ мұны ешкім түсінбейді.
Dialogue: 0,0:15:45.02,0:15:48.07,Default,,0,0,0,,Әртүрлі себептер бар.
Dialogue: 0,0:15:48.19,0:15:49.15,Default,,0,0,0,,Кэрол ше?
Dialogue: 0,0:15:49.28,0:15:52.99,Default,,0,0,0,,Мен? Хмм, білмеймін
Dialogue: 0,0:15:54.45,0:15:57.16,Default,,0,0,0,,Мен босқындар лагерінде болған кезім
Dialogue: 0,0:15:58.08,0:16:01.54,Default,,0,0,0,,Бізге қонаққа әнші Флора келді.
Dialogue: 0,0:16:01.79,0:16:04.17,Default,,0,0,0,,Бұл өте керемет
Dialogue: 0,0:16:04.29,0:16:08.09,Default,,0,0,0,,«Менің де ән айтқым келеді» деп ойладыңыз ба?
Dialogue: 0,0:16:10.01,0:16:11.42,Default,,0,0,0,,Сол ән
Dialogue: 0,0:16:11.76,0:16:12.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:12.76,0:16:16.80,Default,,0,0,0,,Мен көпірде айтқан әннің сөзі неге жоқ?
Dialogue: 0,0:16:16.93,0:16:19.52,Default,,0,0,0,,Хм, бүгілген шығар?
Dialogue: 0,0:16:19.77,0:16:24.65,Default,,0,0,0,,Бұл жай ғана әуен, дыбыстар тізбегі.
Dialogue: 0,0:16:24.77,0:16:27.61,Default,,0,0,0,,Егер солай болса, мен қалағанымша жасай алар едім.
Dialogue: 0,0:16:27.73,0:16:28.69,Default,,0,0,0,,Иә
Dialogue: 0,0:16:29.07,0:16:32.82,Default,,0,0,0,,Бірақ, бірдеңе жетіспейді, солай емес пе?
Dialogue: 0,0:16:32.95,0:16:35.82,Default,,0,0,0,,«Менің өміріме әрқашан бір нәрсе жетіспейді!»
Dialogue: 0,0:16:35.95,0:16:36.99,Default,,0,0,0,,...қандай нәрсе
Dialogue: 0,0:16:37.12,0:16:39.54,Default,,0,0,0,,(Кэрол мен сейсенбінің күлкісі)
Dialogue: 0,0:16:41.16,0:16:43.00,Default,,0,0,0,,Бұл...
Dialogue: 0,0:16:45.79,0:16:46.67,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:47.42,0:16:50.05,Default,,0,0,0,,Осы кезде мына сөздер ойға оралды...
Dialogue: 0,0:16:50.59,0:16:51.76,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:16:52.30,0:16:53.55,Default,,0,0,0,,Жасайық
Dialogue: 0,0:16:53.67,0:16:54.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:54.47,0:16:56.47,Default,,0,0,0,,Барайық, не жетіспейді
Dialogue: 0,0:17:00.85,0:17:07.86,Default,,0,0,0,,(Пернетақта өнімділігі)
Dialogue: 0,0:17:13.11,0:17:16.24,Default,,0,0,0,,(гитараны баптау)
Dialogue: 0,0:17:16.86,0:17:23.87,Default,,0,0,0,,(Пернетақта өнімділігі)
Dialogue: 0,0:17:24.75,0:17:31.75,Default,,0,0,0,,(Пернетақта ойнау және гуілдеу)
Dialogue: 0,0:17:36.72,0:17:39.43,Default,,0,0,0,,(Гитараны уақыт бойынша орындау)
Dialogue: 0,0:17:39.55,0:17:46.56,Default,,0,0,0,,(Спектакль және екі адам шуылдауда)
Dialogue: 0,0:18:20.14,0:18:25.97,Default,,0,0,0,,(Екі адам ойнап, ызылдайды)
Dialogue: 0,0:18:34.11,0:18:37.69,Default,,0,0,0,,♪ Сен мені сезіне аласың ба сен менің...
Dialogue: 0,0:18:49.16,0:18:55.00,Default,,0,0,0,,(Аяқталған ән)
Dialogue: 0,0:19:06.31,0:19:09.56,Default,,0,0,0,,♪ …ең жалғыз қыз
Dialogue: 0,0:19:13.86,0:19:15.52,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:21.99,0:19:22.61,Default,,0,0,0,,О
Dialogue: 0,0:19:26.58,0:19:27.58,Default,,0,0,0,,Уау, о
Dialogue: 0,0:19:32.29,0:19:34.04,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,0:19:34.75,0:19:37.09,Default,,0,0,0,,Сіз қалай ойлайсыз? Жақсы емес пе?
Dialogue: 0,0:19:40.05,0:19:46.18,Default,,0,0,0,,Ал... Бірінші әніміз аяқталды Ия!
Dialogue: 0,0:19:46.35,0:19:47.81,Default,,0,0,0,,Ия
Dialogue: 0,0:19:47.93,0:19:48.85,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:19:49.77,0:19:52.81,Default,,0,0,0,,Мен Instagram тіркелгісін жасағандықтан, оны жүктеп салуым керек пе?
Dialogue: 0,0:19:52.94,0:19:53.85,Default,,0,0,0,,Орындаңыз
Dialogue: 0,0:19:55.65,0:19:57.11,Default,,0,0,0,,Жарайды...!
Dialogue: 0,0:19:59.32,0:20:01.49,Default,,0,0,0,,Білесің бе, мен...
Dialogue: 0,0:20:02.24,0:20:03.32,Default,,0,0,0,,Не?
Dialogue: 0,0:20:03.86,0:20:07.66,Default,,0,0,0,,Мұны айтқаным үшін сіз маған күлетін шығарсыз, бірақ...
Dialogue: 0,0:20:07.78,0:20:09.75,Default,,0,0,0,,Мен ешқашан күлмеймін
Dialogue: 0,0:20:10.91,0:20:14.67,Default,,0,0,0,,Мен Кэролмен музыка айтқым келеді.
Dialogue: 0,0:20:14.79,0:20:17.17,Default,,0,0,0,,Қарғыс атсын! Ууууууууу…
Dialogue: 0,0:20:17.29,0:20:18.80,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:18.92,0:20:20.38,Default,,0,0,0,,Олардың әсерлері тым ауыр сияқты, иә?
Dialogue: 0,0:20:21.84,0:20:23.88,Default,,0,0,0,,Мен де солай ойладым.
Dialogue: 0,0:20:34.31,0:20:36.98,Default,,0,0,0,,Мен бірге көбірек әндер шығарғым келеді!
Dialogue: 0,0:20:37.11,0:20:38.11,Default,,0,0,0,,Зұлым орыннан қозғалмайды!
Dialogue: 0,0:20:38.23,0:20:42.36,Default,,0,0,0,,Сондықтан мен көбірек хит жасап, әлемді таң қалдырғым келеді!
Dialogue: 0,0:20:42.49,0:20:43.61,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:20:43.74,0:20:44.78,Default,,0,0,0,,Несие дегеніміз...
Dialogue: 0,0:20:44.91,0:20:46.78,Default,,0,0,0,,«Кэрол және сейсенбі»
Dialogue: 0,0:20:46.91,0:20:48.66,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:52.04,0:20:56.04,Default,,0,0,0,,Бұл кезде екеуі әлі ештеңе емес еді...
Dialogue: 0,0:20:56.42,0:21:00.34,Default,,0,0,0,,Олар туралы дүниеде ешкім білмеген.
Dialogue: 0,0:21:01.71,0:21:05.34,Default,,0,0,0,,Сіз осылай айтасыз, бірақ мен де білмедім, әрине.
Dialogue: 0,0:21:06.68,0:21:13.68,Default,,0,0,0,,Ал кейінірек бұл екі адам туралы бүкіл әлем таңырқаумен білді.
Dialogue: 0,0:21:15.81,0:21:17.85,Default,,0,0,0,,... сіз байсалдысыз ба?
Dialogue: 0,0:21:21.44,0:21:27.45,Default,,0,0,0,,♪～
Dialogue: 0,0:22:39.10,0:22:45.11,Default,,0,0,0,,～♪
Dialogue: 0,0:22:46.61,0:22:52.61,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory