Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.04,0:00:06.00,Default,,0,0,0,,Бұл ғажайып сияқты болды
Dialogue: 0,0:00:06.29,0:00:10.71,Default,,0,0,0,,Иә, ол Марс тарихына жазылды.
Dialogue: 0,0:00:10.84,0:00:12.92,Default,,0,0,0,,«Жеті минут ғажайып»
Dialogue: 0,0:00:13.59,0:00:19.89,Default,,0,0,0,,Бұл оның қозғаушы күшіне айналған екі қыздың оқиғасы.
Dialogue: 0,0:00:21.43,0:00:27.44,Default,,0,0,0,,♪～
Dialogue: 0,0:01:43.64,0:01:49.65,Default,,0,0,0,,～♪
Dialogue: 0,0:01:51.52,0:01:53.65,Default,,0,0,0,,Кэрол мен сейсенбі -
Dialogue: 0,0:01:53.78,0:01:57.36,Default,,0,0,0,,Мен аты аңызға айналған продюсер Тобимен жұмыс істедім...
Dialogue: 0,0:01:57.49,0:01:59.32,Default,,0,0,0,,Ол күдікті қария.
Dialogue: 0,0:01:59.45,0:02:02.28,Default,,0,0,0,,Мен бірінші синглімді жаздым.
Dialogue: 0,0:02:02.62,0:02:04.24,Default,,0,0,0,,Бұл ескірген студия болды.
Dialogue: 0,0:02:04.54,0:02:06.54,Default,,0,0,0,,«Екі әскер» дегеніміз не?
Dialogue: 0,0:02:06.66,0:02:09.12,Default,,0,0,0,,Дүние жүзіне тарады ма?
Dialogue: 0,0:02:11.46,0:02:18.13,Default,,0,0,0,,(құлаққаптан ойнайтын музыка)
Dialogue: 0,0:02:18.26,0:02:24.60,Default,,0,0,0,,(бейне аудио)
Dialogue: 0,0:02:26.81,0:02:30.06,Default,,0,0,0,,(Труба ойнау)
Dialogue: 0,0:02:30.19,0:02:36.44,Default,,0,0,0,,(сарайда музыка ойналады)
Dialogue: 0,0:02:41.95,0:02:47.37,Default,,0,0,0,,(Кэрол ызылдайды)
Dialogue: 0,0:02:54.88,0:02:56.30,Default,,0,0,0,,Уау (құлаған дыбыс)
Dialogue: 0,0:02:56.80,0:02:57.42,Default,,0,0,0,,Хоу…
Dialogue: 0,0:02:57.42,0:02:57.84,Default,,0,0,0,,Хоу…
Dialogue: 0,0:02:57.42,0:02:57.84,Default,,0,0,0,,Қазір, оның орнына…
Dialogue: 0,0:02:57.84,0:02:57.96,Default,,0,0,0,,Қазір, оның орнына…
Dialogue: 0,0:02:57.96,0:02:58.97,Default,,0,0,0,,Қазір, оның орнына…
Dialogue: 0,0:02:57.96,0:02:58.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:58.97,0:02:59.84,Default,,0,0,0,,Қазір, оның орнына…
Dialogue: 0,0:02:59.84,0:03:01.05,Default,,0,0,0,,Қазір, оның орнына…
Dialogue: 0,0:02:59.84,0:03:01.05,Default,,0,0,0,,Ах! (Зигги) Хоо!
Dialogue: 0,0:03:03.26,0:03:03.97,Default,,0,0,0,,Осымен
Dialogue: 0,0:03:04.35,0:03:06.85,Default,,0,0,0,,Мен бұл туралы Тобимен жазғаннан кейін ойладым.
Dialogue: 0,0:03:06.97,0:03:07.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:07.72,0:03:10.39,Default,,0,0,0,,Өйткені, қалай дұрыс кәсіби музыкант болу керек...
Dialogue: 0,0:03:10.52,0:03:12.02,Default,,0,0,0,,Дене күші маңызды, солай ма?
Dialogue: 0,0:03:12.15,0:03:14.19,Default,,0,0,0,,А, мен де солай ойладым.
Dialogue: 0,0:03:14.52,0:03:17.19,Default,,0,0,0,,Тікелей орындау кезінде де сіздің денеңіз сіздің капиталыңыз болып табылады.
Dialogue: 0,0:03:17.61,0:03:18.78,Default,,0,0,0,,Кристалл да-
Dialogue: 0,0:03:18.90,0:03:21.61,Default,,0,0,0,,Инстаграмға жаттығу кезіндегі суреттерін жиі салып тұрады.
Dialogue: 0,0:03:21.99,0:03:25.41,Default,,0,0,0,,Жарайды, Crystal сияқты қытырлақ қарынға ие болғыңыз келе ме?
Dialogue: 0,0:03:25.53,0:03:28.24,Default,,0,0,0,,Мен қалаймын! Эй Эй
Dialogue: 0,0:03:30.00,0:03:32.87,Default,,0,0,0,,Жоқ, не болса да, бұл дұрыс емес.
Dialogue: 0,0:03:33.00,0:03:34.17,Default,,0,0,0,,Бәс тіккіңіз келе ме?
Dialogue: 0,0:03:34.29,0:03:37.96,Default,,0,0,0,,Бұл саладан бейхабар екені рас.
Dialogue: 0,0:03:38.09,0:03:41.34,Default,,0,0,0,,Хахаха, оны танымауың мүмкін емес.
Dialogue: 0,0:03:41.47,0:03:43.05,Default,,0,0,0,,Бұл Десмонд.
Dialogue: 0,0:03:43.55,0:03:46.14,Default,,0,0,0,,Олай болса, білмегенге 20 оолонг беремін.
Dialogue: 0,0:03:46.47,0:03:49.35,Default,,0,0,0,,Хм... онда мен білетін адаммын...
Dialogue: 0,0:03:49.47,0:03:50.39,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:03:50.60,0:03:53.94,Default,,0,0,0,,(Кэрол мен сейсенбідегі ауыр тыныс)
Dialogue: 0,0:03:54.06,0:03:54.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:54.90,0:03:56.06,Default,,0,0,0,,Келесі шайқас!
Dialogue: 0,0:03:56.36,0:03:58.15,Default,,0,0,0,,Иә? Сен не істеп жатырсың?
Dialogue: 0,0:03:58.27,0:03:59.86,Default,,0,0,0,,Мен қазір баратын жерім.
Dialogue: 0,0:04:00.15,0:04:02.24,Default,,0,0,0,,Мен кейінірек жүгіремін.
Dialogue: 0,0:04:02.57,0:04:05.03,Default,,0,0,0,,Күте тұрыңыз, менде үлкен жаңалық бар.
Dialogue: 0,0:04:05.16,0:04:05.95,Default,,0,0,0,,Келісімді пайдаланбай-ақ мені одақтасың қыла аласың деп ойладың ғой?
Dialogue: 0,0:04:06.24,0:04:08.20,Default,,0,0,0,,Мені бір керемет адам шақырды.
Dialogue: 0,0:04:08.33,0:04:09.87,Default,,0,0,0,,Айтпа! деймін
Dialogue: 0,0:04:10.50,0:04:14.04,Default,,0,0,0,,Ол адам тірі аңыз деп аталады.
Dialogue: 0,0:04:14.92,0:04:17.34,Default,,0,0,0,,Барлық өнер адамдары құрметтейді.
Dialogue: 0,0:04:17.46,0:04:20.67,Default,,0,0,0,,Оны шынымен де музыкант музыканты деп атайды.
Dialogue: 0,0:04:20.80,0:04:24.72,Default,,0,0,0,,Көпшілік алдына сирек шығатын жалғыз суретші
Dialogue: 0,0:04:25.09,0:04:28.93,Default,,0,0,0,,Мм... Дес... Десмонд
Dialogue: 0,0:04:29.06,0:04:30.27,Default,,0,0,0,,Хаа…
Dialogue: 0,0:04:30.93,0:04:34.48,Default,,0,0,0,,Ммммммммммм
Dialogue: 0,0:04:35.35,0:04:37.94,Default,,0,0,0,,Газбен де айналысқан дұрыс емес пе?
Dialogue: 0,0:04:38.06,0:04:39.69,Default,,0,0,0,,Сіз салмақ жоғалтуыңыз мүмкін.
Dialogue: 0,0:04:40.36,0:04:44.65,Default,,0,0,0,,Хаа... балалар мені тыңдадыңдар ма?
Dialogue: 0,0:04:44.95,0:04:45.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:46.07,0:04:47.49,Default,,0,0,0,,Тыңдаңыз және таң қалдырыңыз
Dialogue: 0,0:04:47.62,0:04:49.33,Default,,0,0,0,,Бұл монофондар арасындағы монофон.
Dialogue: 0,0:04:49.95,0:04:52.45,Default,,0,0,0,,Бұл Десмонд мырзаның шақыруы.
Dialogue: 0,0:04:52.75,0:04:54.16,Default,,0,0,0,,Десмонд?
Dialogue: 0,0:04:54.29,0:04:55.71,Default,,0,0,0,,Көргенім, нато мен үшін емес екен
Dialogue: 0,0:04:56.04,0:04:59.67,Default,,0,0,0,,Фу… иә 20 оолонг
Dialogue: 0,0:05:06.30,0:05:07.55,Default,,0,0,0,,Тыңдаңыз
Dialogue: 0,0:05:07.68,0:05:08.80,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:08.93,0:05:11.01,Default,,0,0,0,,Джерри қауіпті адам
Dialogue: 0,0:05:11.14,0:05:16.39,Default,,0,0,0,,Егер біз оның стратегиясын ұстануды жалғастыратын болсақ, бізді алда болатын сценарий күтіп тұр.
Dialogue: 0,0:05:17.77,0:05:20.40,Default,,0,0,0,,Бұл ел мен анам
Dialogue: 0,0:05:21.52,0:05:23.32,Default,,0,0,0,,Анам шаршады.
Dialogue: 0,0:05:23.48,0:05:26.36,Default,,0,0,0,,Маған тағы біраз демалуға рұқсат етіңіз.
Dialogue: 0,0:05:27.11,0:05:30.07,Default,,0,0,0,,Қорқақ болу маңызды
Dialogue: 0,0:05:30.20,0:05:33.04,Default,,0,0,0,,AI мұны істей алмайды.
Dialogue: 0,0:05:33.83,0:05:36.12,Default,,0,0,0,,Бұрыннан мынадай сөз бар
Dialogue: 0,0:05:36.54,0:05:40.92,Default,,0,0,0,,«Тығызды ашқаннан кейін, шарап ішу керек».
Dialogue: 0,0:05:41.25,0:05:44.59,Default,,0,0,0,,Жерде соғыс бастауды жоспарлап отырсыз ба?
Dialogue: 0,0:05:44.71,0:05:48.63,Default,,0,0,0,,Жоқ, мен шешім қабылдайтын адам емеспін.
Dialogue: 0,0:05:48.97,0:05:50.60,Default,,0,0,0,,Мен тағы біраз демаламын.
Dialogue: 0,0:05:50.72,0:05:52.72,Default,,0,0,0,,Анасы (Валери) Спенсер
Dialogue: 0,0:05:53.10,0:05:54.47,Default,,0,0,0,,Тышқан сияқты жасырынып...
Dialogue: 0,0:05:54.60,0:05:57.44,Default,,0,0,0,,Маған кеңес беруді доғарыңыз.
Dialogue: 0,0:05:58.31,0:05:59.98,Default,,0,0,0,,Бұл жағымсыз
Dialogue: 0,0:06:02.27,0:06:05.69,Default,,0,0,0,,(құлаққаптан ойналатын музыка)
Dialogue: 0,0:06:05.82,0:06:07.99,Default,,0,0,0,,Шу
Dialogue: 0,0:06:08.49,0:06:10.53,Default,,0,0,0,,Жер бүгін жақсы көрінеді.
Dialogue: 0,0:06:10.66,0:06:13.74,Default,,0,0,0,,Ей, бұл Жер.
Dialogue: 0,0:06:15.41,0:06:17.83,Default,,0,0,0,,Әй, бұл Роди маған бұрын жіберген.
Dialogue: 0,0:06:17.96,0:06:19.79,Default,,0,0,0,,Десмондтың әні
Dialogue: 0,0:06:23.34,0:06:26.84,Default,,0,0,0,,Хмм, сағыныш сезімін тудырады.
Dialogue: 0,0:06:26.96,0:06:28.09,Default,,0,0,0,,Ностальгиялық?
Dialogue: 0,0:06:28.97,0:06:33.51,Default,,0,0,0,,Кішкентай кезімде шатырдан ескі пластинка тауып алдым.
Dialogue: 0,0:06:33.64,0:06:34.60,Default,,0,0,0,,Жазу?
Dialogue: 0,0:06:35.35,0:06:38.77,Default,,0,0,0,,Мен бұл Десмондтікі екеніне сенімдімін.
Dialogue: 0,0:06:39.48,0:06:43.27,Default,,0,0,0,,Бұл сіздің әкеңіздің жазбасы болды ма?
Dialogue: 0,0:06:45.86,0:06:48.28,Default,,0,0,0,,Сіздің әкеңіз қазір не істеп жатыр?
Dialogue: 0,0:06:48.40,0:06:49.45,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:06:49.57,0:06:52.28,Default,,0,0,0,,Мен жер бетінде адамдар тұрады деп естідім.
Dialogue: 0,0:06:52.41,0:06:54.41,Default,,0,0,0,,Бұл да рас па?
Dialogue: 0,0:06:56.24,0:06:59.75,Default,,0,0,0,,Білесің бе, жер бетінде тілек тілесең, ол орындалады.
Dialogue: 0,0:07:00.00,0:07:01.08,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:07:01.21,0:07:02.42,Default,,0,0,0,,Сіз не тілейсіз?
Dialogue: 0,0:07:02.54,0:07:07.63,Default,,0,0,0,,Хмм... Менің тілегім – «сол қалпында қалу»
Dialogue: 0,0:07:07.76,0:07:09.47,Default,,0,0,0,,«Қазір» бұл қазір қандай?
Dialogue: 0,0:07:09.59,0:07:12.93,Default,,0,0,0,,Иә, осы сәт мәңгілік болса екен деп тілеймін.
Dialogue: 0,0:07:13.05,0:07:14.97,Default,,0,0,0,,Арзан пәтерде кедейлікте өмір сүру?
Dialogue: 0,0:07:15.30,0:07:17.22,Default,,0,0,0,,Иә, Кэрол ше?
Dialogue: 0,0:07:17.35,0:07:19.27,Default,,0,0,0,,Мен «бірінші боламын»
Dialogue: 0,0:07:19.39,0:07:20.31,Default,,0,0,0,,№1?
Dialogue: 0,0:07:20.69,0:07:22.35,Default,,0,0,0,,Марста бірінші болу...
Dialogue: 0,0:07:22.48,0:07:25.69,Default,,0,0,0,,Армандар үлкен. Жердегі тікелей тур туралы не деуге болады?
Dialogue: 0,0:07:25.82,0:07:28.61,Default,,0,0,0,,Хехе, міндетті түрде тікелей турға барайық
Dialogue: 0,0:07:28.73,0:07:30.28,Default,,0,0,0,,Әзірше үміттенейік.
Dialogue: 0,0:07:30.40,0:07:31.70,Default,,0,0,0,,Иә
Dialogue: 0,0:07:33.41,0:07:37.58,Default,,0,0,0,,Бүгін бірінші президенттік пікірсайыс өтеді.
Dialogue: 0,0:07:38.16,0:07:40.16,Default,,0,0,0,,Қазіргі әкімшіліктің Гамильтон кандидаты--
Dialogue: 0,0:07:40.29,0:07:42.42,Default,,0,0,0,,Адамдар қолдауға жиналуда...
Dialogue: 0,0:07:43.04,0:07:45.79,Default,,0,0,0,,Екінші жағынан, кандидат Симмонсты қолдайтындар...
Dialogue: 0,0:07:45.92,0:07:49.09,Default,,0,0,0,,Олар Марс мүсінінің айналасына жиналған сияқты.
Dialogue: 0,0:07:53.05,0:07:56.51,Default,,0,0,0,,Тыңдаңыз, мистер Десмондпен кездесу әдепті талап етеді.
Dialogue: 0,0:07:57.10,0:07:59.64,Default,,0,0,0,,Балалар, сендер ешқашан дөрекі болмаңдар.
Dialogue: 0,0:08:00.10,0:08:03.06,Default,,0,0,0,,Біріншіден, оның алдында жүрме.
Dialogue: 0,0:08:03.19,0:08:05.35,Default,,0,0,0,,Оның көлеңкесін баспа
Dialogue: 0,0:08:05.56,0:08:07.82,Default,,0,0,0,,Ешқашан қол алысуды сұрамаңыз
Dialogue: 0,0:08:08.15,0:08:10.32,Default,,0,0,0,,Күн сәулесі түссе, өлесің.
Dialogue: 0,0:08:10.74,0:08:12.95,Default,,0,0,0,,Бұл қала аңызына ұқсайды.
Dialogue: 0,0:08:13.07,0:08:16.07,Default,,0,0,0,,Ол шынымен бар ма?
Dialogue: 0,0:08:23.58,0:08:26.25,Default,,0,0,0,,Шақыру билетін ұстаңыз
Dialogue: 0,0:08:33.09,0:08:34.51,Default,,0,0,0,,(аутентификация дыбысы)
Dialogue: 0,0:08:34.63,0:08:38.35,Default,,0,0,0,,Құрметті Кэрол, Сейсенбі, Родди...
Dialogue: 0,0:08:38.55,0:08:41.10,Default,,0,0,0,,Хмм... Ммм?
Dialogue: 0,0:08:42.64,0:08:45.90,Default,,0,0,0,,Мистер Гус, қош келдіңіз.
Dialogue: 0,0:08:46.02,0:08:47.23,Default,,0,0,0,,Аа...
Dialogue: 0,0:08:47.52,0:08:51.53,Default,,0,0,0,,Біз сізді күтеміз. Жалғастырыңыз.
Dialogue: 0,0:08:51.86,0:08:54.24,Default,,0,0,0,,Керемет, бәріміз ішке кірейік.
Dialogue: 0,0:08:54.36,0:08:55.82,Default,,0,0,0,,Әрине
Dialogue: 0,0:08:56.86,0:09:03.29,Default,,0,0,0,,Ватару!
Dialogue: 0,0:09:10.67,0:09:12.30,Default,,0,0,0,,♪ Жою
Dialogue: 0,0:09:12.42,0:09:16.38,Default,,0,0,0,,♪ Ішімдегі қараңғылықты құрт
Dialogue: 0,0:09:19.47,0:09:23.98,Default,,0,0,0,,♪ Жаңғырған әнді естігім келеді
Dialogue: 0,0:09:26.52,0:09:30.15,Default,,0,0,0,,♪ мәңгілік
Dialogue: 0,0:09:31.86,0:09:34.40,Default,,0,0,0,,♪ Мен адасқан жанмын
Dialogue: 0,0:09:34.53,0:09:37.53,Default,,0,0,0,,♪ Дрейф
Dialogue: 0,0:09:38.91,0:09:46.33,Default,,0,0,0,,♪ Маған себеп айтыңыз
Dialogue: 0,0:09:47.16,0:09:52.84,Default,,0,0,0,,♪ Бұлай өмір сүрудің себебі
Dialogue: 0,0:09:53.05,0:09:59.72,Default,,0,0,0,,♪ Бұл сөздер болмаса, ол жоғалады
Dialogue: 0,0:09:59.97,0:10:07.64,Default,,0,0,0,,♪ Маған жауап беріңіз
Dialogue: 0,0:10:08.44,0:10:14.03,Default,,0,0,0,,♪ Желді кесіп өтетін жауап
Dialogue: 0,0:10:14.15,0:10:22.20,Default,,0,0,0,,♪ Мені үмітсіздігімнен құтқар
Dialogue: 0,0:10:28.41,0:10:29.83,Default,,0,0,0,,Мәселе онда емес еді.
Dialogue: 0,0:10:32.71,0:10:34.71,Default,,0,0,0,,Ең жалғыз қыздар
Dialogue: 0,0:10:43.80,0:10:48.10,Default,,0,0,0,,Мм, бұл жолы неге маған тағы қоңырау шалдың?
Dialogue: 0,0:10:48.23,0:10:49.19,Default,,0,0,0,,Қызық, неге?
Dialogue: 0,0:10:49.69,0:10:54.65,Default,,0,0,0,,Ах~ Бұл жігіттердің әндері адамдарға ұнайтын шығар...
Dialogue: 0,0:10:55.73,0:10:56.94,Default,,0,0,0,,Ақымақ сияқты...
Dialogue: 0,0:10:57.07,0:10:57.78,Default,,0,0,0,,Е...
Dialogue: 0,0:10:57.90,0:11:01.36,Default,,0,0,0,,Бөріксіз адалдық Адалдық
Dialogue: 0,0:11:01.99,0:11:03.78,Default,,0,0,0,,Бұл өте жақсы
Dialogue: 0,0:11:03.95,0:11:05.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:06.41,0:11:08.50,Default,,0,0,0,,Менен сұрағыңыз келетін нәрсе бар ма?
Dialogue: 0,0:11:08.62,0:11:11.92,Default,,0,0,0,,Мм... мм... бұл не?
Dialogue: 0,0:11:12.04,0:11:15.13,Default,,0,0,0,,Сол әртүрлі аңыздар рас па?
Dialogue: 0,0:11:15.25,0:11:18.09,Default,,0,0,0,,Мысалы, күн сәулесі түссе, сіз өлесіз.
Dialogue: 0,0:11:18.21,0:11:19.55,Default,,0,0,0,,Андрогендік және т.б.
Dialogue: 0,0:11:19.67,0:11:20.34,Default,,0,0,0,,Эй
Dialogue: 0,0:11:20.59,0:11:24.47,Default,,0,0,0,,Хехехе, бұның көбі бос сөз.
Dialogue: 0,0:11:24.60,0:11:27.43,Default,,0,0,0,,Бірақ олардың андрогендік екені рас.
Dialogue: 0,0:11:27.56,0:11:28.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:28.85,0:11:32.44,Default,,0,0,0,,Марсқа түсетін радиация гормондарға әсер етеді...
Dialogue: 0,0:11:32.56,0:11:34.90,Default,,0,0,0,,Сіздің денеңіз бірте-бірте өзгереді.
Dialogue: 0,0:11:35.36,0:11:39.78,Default,,0,0,0,,Мен бастапқыда ер адаммын, бірақ мен бірте-бірте әйел болып келемін.
Dialogue: 0,0:11:39.99,0:11:42.41,Default,,0,0,0,,Сезімдерім өзгермейді деп ойладым, бірақ...
Dialogue: 0,0:11:42.99,0:11:44.53,Default,,0,0,0,,Енді бізде екеуі де бар.
Dialogue: 0,0:11:44.66,0:11:45.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:46.08,0:11:49.95,Default,,0,0,0,,Сіз білесіз бе? Ерте ұрықтардың жынысы жоқ
Dialogue: 0,0:11:50.29,0:11:54.13,Default,,0,0,0,,Енді мен өзімді шынайы тұлғаға айналғандай сезінемін.
Dialogue: 0,0:11:54.58,0:11:56.29,Default,,0,0,0,,Бастапқы пішін?
Dialogue: 0,0:11:56.42,0:12:00.09,Default,,0,0,0,,Иә, мен іздеген денемнің жартысын таптым деп ойлаймын.
Dialogue: 0,0:12:00.42,0:12:01.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:03.51,0:12:07.47,Default,,0,0,0,,Ал, осы уақытқа дейін мұнда қандай адамдар келді?
Dialogue: 0,0:12:07.60,0:12:10.56,Default,,0,0,0,,Келген адамдар қолтаңба қойған жер бар.
Dialogue: 0,0:12:10.68,0:12:12.14,Default,,0,0,0,,Мен саған кейінірек көрсетемін.
Dialogue: 0,0:12:12.64,0:12:14.98,Default,,0,0,0,,Маған да сіздің қолтаңбаларыңыз керек.
Dialogue: 0,0:12:15.10,0:12:15.77,Default,,0,0,0,,Иә
Dialogue: 0,0:12:16.19,0:12:18.90,Default,,0,0,0,,Бірге суретке түссек те...
Dialogue: 0,0:12:19.48,0:12:20.23,Default,,0,0,0,,Әрине
Dialogue: 0,0:12:20.36,0:12:21.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:22.61,0:12:24.07,Default,,0,0,0,,Маған суретке түсуге рұқсат етіңіз.
Dialogue: 0,0:12:26.12,0:12:26.74,Default,,0,0,0,,(аутентификация дыбысы)
Dialogue: 0,0:12:27.53,0:12:29.66,Default,,0,0,0,,Иә Музыка
Dialogue: 0,0:12:29.79,0:12:31.25,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:12:34.33,0:12:38.34,Default,,0,0,0,,Сіз үнемі өсімдіктер арасында өмір сүресіз бе?
Dialogue: 0,0:12:38.46,0:12:43.97,Default,,0,0,0,,Иә, осында оянамын, ән айтамын, осында ұйықтаймын.
Dialogue: 0,0:12:44.51,0:12:47.22,Default,,0,0,0,,Гүлдер дыбыстарды ажырата алады
Dialogue: 0,0:12:47.51,0:12:49.97,Default,,0,0,0,,Тірі заттарға тек физикалық қоректену ғана емес...
Dialogue: 0,0:12:50.10,0:12:52.22,Default,,0,0,0,,Жаныңызға азық керек, солай ма?
Dialogue: 0,0:12:52.93,0:12:55.98,Default,,0,0,0,,Әдемі заттар Әдемі өрнектер
Dialogue: 0,0:12:56.31,0:12:59.19,Default,,0,0,0,,Бұл ақылға қажет
Dialogue: 0,0:12:59.90,0:13:04.11,Default,,0,0,0,,Онсыз жүрек мұңаяды.
Dialogue: 0,0:13:08.24,0:13:09.16,Default,,0,0,0,,Иә
Dialogue: 0,0:13:09.28,0:13:10.33,Default,,0,0,0,,Фу…
Dialogue: 0,0:13:11.54,0:13:14.96,Default,,0,0,0,,Музыка – жан үшін аса маңызды азық.
Dialogue: 0,0:13:15.54,0:13:17.17,Default,,0,0,0,,Соңғы музыкаға келетін болсақ...
Dialogue: 0,0:13:17.63,0:13:20.67,Default,,0,0,0,,Тек улы болуы мүмкін көптеген заттар бар.
Dialogue: 0,0:13:25.80,0:13:27.93,Default,,0,0,0,,(Қол шапалақтау)
Dialogue: 0,0:13:28.34,0:13:29.93,Default,,0,0,0,,Танысқаныма қуаныштымын Адам
Dialogue: 0,0:13:30.18,0:13:32.18,Default,,0,0,0,,Сәлем, Валери
Dialogue: 0,0:13:38.35,0:13:44.94,Default,,0,0,0,,(Топтың шуы)
Dialogue: 0,0:13:50.78,0:13:51.87,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:13:51.99,0:13:54.50,Default,,0,0,0,,Мұнда бұрын біреу болды ма?
Dialogue: 0,0:13:55.91,0:13:59.50,Default,,0,0,0,,Адамдар неге ән айтады деп ойлап көрдіңіз бе?
Dialogue: 0,0:14:00.29,0:14:03.17,Default,,0,0,0,,Менің әнімді ешкім тыңдағанын қаламаймын
Dialogue: 0,0:14:03.67,0:14:06.47,Default,,0,0,0,,Бұл шынымен де біртүрлі емес пе?
Dialogue: 0,0:14:07.05,0:14:11.35,Default,,0,0,0,,Хмм...олай десеңіз біртүрлі болуы мүмкін.
Dialogue: 0,0:14:11.47,0:14:15.22,Default,,0,0,0,,Бірақ оны жеткізудің басқа жолы жоқ...
Dialogue: 0,0:14:15.35,0:14:16.31,Default,,0,0,0,,Айтыңызшы?
Dialogue: 0,0:14:16.60,0:14:20.73,Default,,0,0,0,,Оны қалай атауға болады, «ойлар» сияқты...
Dialogue: 0,0:14:20.86,0:14:21.94,Default,,0,0,0,,Иә
Dialogue: 0,0:14:23.94,0:14:28.20,Default,,0,0,0,,Мен шын сүйген бір ғана адам болды.
Dialogue: 0,0:14:29.24,0:14:33.41,Default,,0,0,0,,Ол жас қайтыс болды, мен енді ән айта алмаймын.
Dialogue: 0,0:14:34.08,0:14:38.29,Default,,0,0,0,,Өйткені барлық әндер соған арналып жазылған.
Dialogue: 0,0:14:39.16,0:14:42.59,Default,,0,0,0,,Мен әлеммен байланысымды үздім...
Dialogue: 0,0:14:42.71,0:14:47.05,Default,,0,0,0,,Мен тек өсімдіктермен және АИ-мен өмір сүріп, осы жерде тығылып қалдым.
Dialogue: 0,0:14:48.01,0:14:53.80,Default,,0,0,0,,Бірақ оны ойлаған әндерді естіген достары бірінен соң бірі жиналды...
Dialogue: 0,0:14:54.22,0:14:57.56,Default,,0,0,0,,Мен ән айтуды жалғастырдым
Dialogue: 0,0:15:02.69,0:15:05.98,Default,,0,0,0,,Барлығына айтуды ойлаудың қажеті жоқ
Dialogue: 0,0:15:06.61,0:15:10.99,Default,,0,0,0,,Егер сіз өз сезіміңізді шынымен жеткізгіңіз келсе, сізге бір ғана адам керек.
Dialogue: 0,0:15:12.03,0:15:14.24,Default,,0,0,0,,Келмесе де бәрібір.
Dialogue: 0,0:15:14.87,0:15:18.25,Default,,0,0,0,,Егер бұл сезім шын болса...
Dialogue: 0,0:15:18.37,0:15:21.96,Default,,0,0,0,,Көп адамдар сізге жанашырлық танытатыны сөзсіз.
Dialogue: 0,0:15:23.21,0:15:26.38,Default,,0,0,0,,Қазір жер босқындарға толып жатыр.
Dialogue: 0,0:15:26.71,0:15:28.01,Default,,0,0,0,,Гамильтон сен бе?
Dialogue: 0,0:15:28.13,0:15:31.59,Default,,0,0,0,,Біз бұл босқындарды қабылдау туралы заң жобасын мақұлдадық.
Dialogue: 0,0:15:32.01,0:15:34.64,Default,,0,0,0,,Мен сыйлықтың не екенін білмеймін.
Dialogue: 0,0:15:34.76,0:15:38.68,Default,,0,0,0,,Бұл заң жобасы Марстағы жұмыс орындары мен қауіпсіздікке қауіп төндіреді.
Dialogue: 0,0:15:38.81,0:15:40.48,Default,,0,0,0,,Ібіліс заңы
Dialogue: 0,0:15:40.73,0:15:43.06,Default,,0,0,0,,Сөзіңді қайтарып жатқан сияқтымын.
Dialogue: 0,0:15:43.19,0:15:47.15,Default,,0,0,0,,Босқындарды қабылдаудан бас тарту – адамзатқа қарсы әрекет.
Dialogue: 0,0:15:47.27,0:15:50.53,Default,,0,0,0,,Еңбек нарығын жандандыруға да ықпал етеді.
Dialogue: 0,0:15:50.78,0:15:54.66,Default,,0,0,0,,Экономиканың дамуына үлкен септігін тигізеді деп ойлаймыз.
Dialogue: 0,0:15:57.74,0:15:59.91,Default,,0,0,0,,Мен сені бақыламасам жақсы ма?
Dialogue: 0,0:16:00.41,0:16:02.41,Default,,0,0,0,,Бұл сенің анаңның үлкен сахнасы.
Dialogue: 0,0:16:04.75,0:16:09.13,Default,,0,0,0,,Кешіріңіз, мен Кайлмын, штаттан тыс журналистмін.
Dialogue: 0,0:16:09.30,0:16:10.76,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:16:11.63,0:16:13.84,Default,,0,0,0,,Әпкеңнің де жағдайы жақсы.
Dialogue: 0,0:16:15.26,0:16:16.72,Default,,0,0,0,,Сіз не іздеп жүрсіз?
Dialogue: 0,0:16:17.10,0:16:19.14,Default,,0,0,0,,Симмондар отбасының жарығы мен көлеңкесі
Dialogue: 0,0:16:21.39,0:16:24.44,Default,,0,0,0,,Әзіл, мен сайлауды бақылап отырмын.
Dialogue: 0,0:16:24.56,0:16:26.98,Default,,0,0,0,,Онда мені қуғанның пайдасы жоқ.
Dialogue: 0,0:16:27.11,0:16:31.61,Default,,0,0,0,,Сайлау жөніндегі агент Джерри Иганның тарихын білуіңіз керек.
Dialogue: 0,0:16:31.94,0:16:34.32,Default,,0,0,0,,Менің сізбен пікірталасатын ойым жоқ.
Dialogue: 0,0:16:34.45,0:16:37.53,Default,,0,0,0,,Ал менің апама жақындама.
Dialogue: 0,0:16:43.91,0:16:46.00,Default,,0,0,0,,Сіз мұнда тым ұзақ қалдыңыз ба?
Dialogue: 0,0:16:46.13,0:16:49.42,Default,,0,0,0,,Мен Десмондта 20 жыл жұмыс істеймін.
Dialogue: 0,0:16:49.55,0:16:53.13,Default,,0,0,0,,Ол басқа АИ-лерге қарағанда адамға ұқсайды.
Dialogue: 0,0:16:53.38,0:16:54.88,Default,,0,0,0,,Егер сіз ұзақ уақыт қызмет еткен болсаңыз...
Dialogue: 0,0:16:55.01,0:16:58.89,Default,,0,0,0,,Мен Десмонд-саманың сезімін бірте-бірте түсіне бастағандай болдым.
Dialogue: 0,0:16:59.01,0:17:00.43,Default,,0,0,0,,Я~
Dialogue: 0,0:17:00.56,0:17:03.27,Default,,0,0,0,,Мен сәл артық кеттім дедім.
Dialogue: 0,0:17:03.85,0:17:06.02,Default,,0,0,0,,Бірақ мен де белгіні көргім келді.
Dialogue: 0,0:17:06.15,0:17:08.48,Default,,0,0,0,,Ой, мен қайттым.
Dialogue: 0,0:17:11.40,0:17:12.90,Default,,0,0,0,,Дәрі-дәрмектің уақыты келді.
Dialogue: 0,0:17:13.57,0:17:14.40,Default,,0,0,0,,Қажет емес
Dialogue: 0,0:17:14.86,0:17:15.70,Default,,0,0,0,,№
Dialogue: 0,0:17:15.99,0:17:18.32,Default,,0,0,0,,Ішсең жақсы болар еді...
Dialogue: 0,0:17:18.45,0:17:20.70,Default,,0,0,0,,Жарайды, мен өзімді жақсы сезінемін.
Dialogue: 0,0:17:21.83,0:17:25.00,Default,,0,0,0,,Мен жақында бұл органнан босатыламын.
Dialogue: 0,0:17:25.12,0:17:25.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:26.46,0:17:30.13,Default,,0,0,0,,Өкінішті, бірақ қызық.
Dialogue: 0,0:17:30.25,0:17:31.38,Default,,0,0,0,,Оны асыға күтесіз бе?
Dialogue: 0,0:17:31.92,0:17:36.22,Default,,0,0,0,,Адамдар өзгереді, ал өмір мәңгілік емес, бірақ...
Dialogue: 0,0:17:37.22,0:17:40.80,Default,,0,0,0,,Бұл кездесу... бұл сәт шағын шеңбер
Dialogue: 0,0:17:41.51,0:17:43.47,Default,,0,0,0,,Ол жалғасуда...
Dialogue: 0,0:17:43.60,0:17:47.35,Default,,0,0,0,,Ұзын тізбек сияқты мәңгілікке жалғасады
Dialogue: 0,0:17:47.48,0:17:50.90,Default,,0,0,0,,Мәңгілік міндетті түрде солай деп ойлаймын.
Dialogue: 0,0:17:53.78,0:17:56.45,Default,,0,0,0,,Көп ұзамай мен мұны істей алмаймын.
Dialogue: 0,0:17:56.57,0:17:59.74,Default,,0,0,0,,Мен оны қосуыңызды қалаймын.
Dialogue: 0,0:18:01.99,0:18:03.66,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:18:04.50,0:18:06.25,Default,,0,0,0,,Бұл дүние
Dialogue: 0,0:18:07.96,0:18:09.04,Default,,0,0,0,,Ватару!
Dialogue: 0,0:18:09.37,0:18:14.30,Default,,0,0,0,,♪ Мен туралы не айтқаның есіңізде ме?
Dialogue: 0,0:18:16.59,0:18:19.68,Default,,0,0,0,,♪ «Маған бет сүйектері ұнайды»
Dialogue: 0,0:18:25.43,0:18:31.36,Default,,0,0,0,,♪ Бір күні ол да менімен бірге ыдырайды.
Dialogue: 0,0:18:32.86,0:18:39.74,Default,,0,0,0,,♪ Оның қалай сынғанын қалайсыз?
Dialogue: 0,0:18:41.28,0:18:44.03,Default,,0,0,0,,♪ Мұқият қараңыз
Dialogue: 0,0:18:45.24,0:18:49.00,Default,,0,0,0,,♪ Сен бұл дүниеде жалғызсың
Dialogue: 0,0:18:49.58,0:18:54.59,Default,,0,0,0,,♪ Түннің мұңын күткендей
Dialogue: 0,0:18:57.34,0:19:03.39,Default,,0,0,0,,♪ Ниетіміз әрқашан сәл алға жүру
Dialogue: 0,0:19:05.10,0:19:08.64,Default,,0,0,0,,♪ Жүрегім әрқашан артта қалады
Dialogue: 0,0:19:13.36,0:19:17.73,Default,,0,0,0,,♪ Бұл дауысты әлі естисіз бе?
Dialogue: 0,0:19:17.86,0:19:21.28,Default,,0,0,0,,♪ Барлық тірі жан айқайлайды
Dialogue: 0,0:19:21.41,0:19:26.54,Default,,0,0,0,,♪ «Мен сенің жалғыз қалғаныңды қаламаймын».
Dialogue: 0,0:19:27.41,0:19:30.08,Default,,0,0,0,,♪ Сенің өткінші өмірің
Dialogue: 0,0:19:30.21,0:19:34.29,Default,,0,0,0,,♪ Бұл әдемі әлемде аяқталады
Dialogue: 0,0:19:34.42,0:19:38.13,Default,,0,0,0,,♪ Осы көзбен көруге болатынның бәрі
Dialogue: 0,0:19:38.76,0:19:43.05,Default,,0,0,0,,♪ Әрқашан бір сәтке әдемі
Dialogue: 0,0:19:43.18,0:19:45.18,Default,,0,0,0,,♪ Сондықтан осында қалыңыз
Dialogue: 0,0:19:45.18,0:19:46.93,Default,,0,0,0,,♪ Сондықтан осында қалыңыз
Dialogue: 0,0:19:45.18,0:19:46.93,Default,,0,0,0,,Жер жойылу мен құлдырау алдында тұр.
Dialogue: 0,0:19:46.93,0:19:47.60,Default,,0,0,0,,Жер жойылу мен құлдырау алдында тұр.
Dialogue: 0,0:19:47.60,0:19:49.10,Default,,0,0,0,,Жер жойылу мен құлдырау алдында тұр.
Dialogue: 0,0:19:47.60,0:19:49.10,Default,,0,0,0,,♪ Мен сенің осында болғаныңды қалаймын
Dialogue: 0,0:19:49.10,0:19:49.22,Default,,0,0,0,,♪ Мен сенің осында болғаныңды қалаймын
Dialogue: 0,0:19:49.22,0:19:50.14,Default,,0,0,0,,♪ Мен сенің осында болғаныңды қалаймын
Dialogue: 0,0:19:49.22,0:19:50.14,Default,,0,0,0,,Марс – адамзаттың жаңа арманы
Dialogue: 0,0:19:50.14,0:19:51.23,Default,,0,0,0,,Марс – адамзаттың жаңа арманы
Dialogue: 0,0:19:51.23,0:19:52.64,Default,,0,0,0,,Марс – адамзаттың жаңа арманы
Dialogue: 0,0:19:51.23,0:19:52.64,Default,,0,0,0,,♪ Мен сенің осында болғаныңды қалаймын
Dialogue: 0,0:19:52.64,0:19:52.81,Default,,0,0,0,,♪ Мен сенің осында болғаныңды қалаймын
Dialogue: 0,0:19:52.81,0:19:55.15,Default,,0,0,0,,♪ Мен сенің осында болғаныңды қалаймын.
Dialogue: 0,0:19:52.81,0:19:55.15,Default,,0,0,0,,Біз Марстамыз
Dialogue: 0,0:19:55.27,0:19:59.28,Default,,0,0,0,,♪ Мен сенің осында болғаныңды қалаймын.
Dialogue: 0,0:19:55.27,0:19:59.28,Default,,0,0,0,,Жер енді қауіптен басқа ештеңе емес.
Dialogue: 0,0:19:59.40,0:20:02.70,Default,,0,0,0,,♪ Мен сенің осында болғаныңды қалаймын
Dialogue: 0,0:20:03.24,0:20:09.12,Default,,0,0,0,,Тұрақты түрде Марс Жердің колониясы және Жердің құлына айналады.
Dialogue: 0,0:20:09.24,0:20:12.04,Default,,0,0,0,,Жермен сауда келісімін бұзбасақ...
Dialogue: 0,0:20:12.25,0:20:14.83,Default,,0,0,0,,Бұл планетаның болашағы жоқ.
Dialogue: 0,0:20:31.48,0:20:32.18,Default,,0,0,0,,Ха!
Dialogue: 0,0:20:32.56,0:20:36.02,Default,,0,0,0,,Эй... Эй, жақсысың ба? Бұрын қабылдаған дәріңіз ше?
Dialogue: 0,0:20:36.40,0:20:38.90,Default,,0,0,0,,Сөйлеуді қиындататын жанама әсері бар.
Dialogue: 0,0:20:39.02,0:20:40.69,Default,,0,0,0,,Сіз ішкен жоқсыз ба?
Dialogue: 0,0:20:40.82,0:20:42.86,Default,,0,0,0,,А... бұл...
Dialogue: 0,0:20:43.28,0:20:44.70,Default,,0,0,0,,Соңғы ән айтқан дауыс-
Dialogue: 0,0:20:44.82,0:20:48.53,Default,,0,0,0,,Саған бірдеңе айтайын деп тұрған сияқты.
Dialogue: 0,0:20:48.66,0:20:50.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:51.45,0:20:54.41,Default,,0,0,0,,Мистер Десмонд жұмсақ өрнекті...
Dialogue: 0,0:20:55.25,0:20:58.67,Default,,0,0,0,,Ұйықтап жат, ұйықтай бер
Dialogue: 0,0:21:00.05,0:21:04.51,Default,,0,0,0,,Өсімдіктермен қоршалған патшалығында
Dialogue: 0,0:21:05.47,0:21:09.64,Default,,0,0,0,,Ол кезде біз әлі білмедік
Dialogue: 0,0:21:10.18,0:21:15.56,Default,,0,0,0,,Әннің қуанышы және әннің шынайы мәні
Dialogue: 0,0:21:21.53,0:21:26.07,Default,,0,0,0,,♪～
Dialogue: 0,0:22:43.36,0:22:49.36,Default,,0,0,0,,～♪
