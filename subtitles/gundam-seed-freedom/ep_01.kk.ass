Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:40.49,0:00:43.79,Default,,0,0,0,,(Су асты дыбыстары)
Dialogue: 0,0:00:43.87,0:00:45.79,Default,,0,0,0,,Еш ойланбаңыз
Dialogue: 0,0:00:45.87,0:00:48.42,Default,,0,0,0,,Егер сіз мұны қаласаңыз
Dialogue: 0,0:00:49.84,0:00:53.84,Default,,0,0,0,,Қалау үшін туған Дүние қалаған...
Dialogue: 0,0:00:57.84,0:00:59.80,Default,,0,0,0,,(Зымыран ұшыру дыбысы)
Dialogue: 0,0:01:06.69,0:01:10.61,Default,,0,0,0,,(Ұялы костюмнің іске қосылу дыбысы)
Dialogue: 0,0:01:25.16,0:01:29.67,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:01:29.75,0:01:32.09,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:01:34.51,0:01:36.30,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:01:37.68,0:01:39.05,Default,,0,0,0,,Шарт Қызыл түсті шығарылды
Dialogue: 0,0:01:39.43,0:01:40.89,Default,,0,0,0,,Шарт Қызыл
Dialogue: 0,0:01:40.97,0:01:43.68,Default,,0,0,0,,Африка Республикасы, Олдрин автономиялық аймағының аумағына
Dialogue: 0,0:01:43.77,0:01:44.97,Default,,0,0,0,,Мүмкін көк ғарыш —
Dialogue: 0,0:01:45.06,0:01:46.23,Default,,0,0,0,,Шабуыл күші басып кіреді
Dialogue: 0,0:01:46.31,0:01:47.39,Default,,0,0,0,,Ха…
Dialogue: 0,0:01:47.48,0:01:49.02,Default,,0,0,0,,Қазірдің өзінде!?
Dialogue: 0,0:01:49.65,0:01:51.31,Default,,0,0,0,,Ұшқышты ұшаққа отырғызу
Dialogue: 0,0:01:51.40,0:01:53.98,Default,,0,0,0,,Әрбір қызметкер өзінің тағайындалған жұмысын дереу бастауы керек.
Dialogue: 0,0:01:54.07,0:01:54.90,Default,,0,0,0,,Мінез-құлықты зерттеуге сәйкес—
Dialogue: 0,0:01:54.98,0:01:56.24,Default,,0,0,0,,Басқыншы күш Канаж қаласынан келеді —
Dialogue: 0,0:01:56.32,0:01:57.40,Default,,0,0,0,,Ұшты деп болжанады
Dialogue: 0,0:01:57.49,0:02:00.32,Default,,0,0,0,,Қарсыластың күтілетін уақыты Келесі 05
Dialogue: 0,0:02:00.41,0:02:02.03,Default,,0,0,0,,Компас штабы
Dialogue: 0,0:02:02.12,0:02:05.20,Default,,0,0,0,,және Олдрин автономиялық үкіметімен тіркелген желі
Dialogue: 0,0:02:05.29,0:02:08.12,Default,,0,0,0,,Тоғызыншы 022 (нөл екі екі) операциясы орындалуда
Dialogue: 0,0:02:08.62,0:02:10.79,Default,,0,0,0,,Ямато отряды ұшыруға дайын
Dialogue: 0,0:02:10.88,0:02:13.71,Default,,0,0,0,,Катапульта альфа командасының индуктивтілігі 20...
Dialogue: 0,0:02:13.80,0:02:18.01,Default,,0,0,0,,Қарсыластың күші рота көлемінде. Бұл жергілікті бөлімшенің есебі.
Dialogue: 0,0:02:18.09,0:02:21.09,Default,,0,0,0,,Артық бағалау ешқашан жақсы емес.
Dialogue: 0,0:02:21.18,0:02:23.30,Default,,0,0,0,,Жағдай ауыр сияқты.
Dialogue: 0,0:02:24.01,0:02:28.23,Default,,0,0,0,,Түсінді. Бостандыққа кіргеннен кейін Шин мемлекеттік нысандарды қорғайды.
Dialogue: 0,0:02:28.31,0:02:29.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:29.23,0:02:31.65,Default,,0,0,0,,Лунамария мен Агнес азаматтарды эвакуациялауға басшылық етеді...
Dialogue: 0,0:02:32.23,0:02:33.57,Default,,0,0,0,,Олдрин гарнизонын қолдау
Dialogue: 0,0:02:33.65,0:02:34.65,Default,,0,0,0,,Мен де, әпкем де осы жерде күтеміз.
Dialogue: 0,0:02:34.73,0:02:37.74,Default,,0,0,0,,Капитан, мен алдыңғы шепте жауға шабуыл жасаймын.
Dialogue: 0,0:02:37.82,0:02:38.82,Default,,0,0,0,,Бізге қосылыңыз!
Dialogue: 0,0:02:38.90,0:02:40.57,Default,,0,0,0,,Капитан мен де барамын!
Dialogue: 0,0:02:40.66,0:02:43.45,Default,,0,0,0,,Жоқ, мен ұрыс алаңын кеңейткім келмейді.
Dialogue: 0,0:02:44.16,0:02:46.91,Default,,0,0,0,,Харкен отряды Мыңжылдықты сұрайды
Dialogue: 0,0:02:47.00,0:02:49.66,Default,,0,0,0,,Хмм... Маған қалдырыңыз, капитан!
Dialogue: 0,0:02:49.75,0:02:52.71,Default,,0,0,0,,Катапульт қосылымы Барлық жүйелер онлайн
Dialogue: 0,0:02:52.79,0:02:55.59,Default,,0,0,0,,ҰҚЖ бос Жолда ешқандай кедергі жоқ
Dialogue: 0,0:02:55.67,0:03:00.51,Default,,0,0,0,,Әуе шабуылына қарсы бақылау тобы D2 арнасында әуе кеңістігін бақылау деректерімен бөлісуде.
Dialogue: 0,0:03:00.59,0:03:02.43,Default,,0,0,0,,Қызыл топ эвакуация аяқталды
Dialogue: 0,0:03:02.51,0:03:04.10,Default,,0,0,0,,Гельгуг, бастаңыз.
Dialogue: 0,0:03:04.18,0:03:07.27,Default,,0,0,0,,Lunamaria Hawk Gelgoog Кеттік!
Dialogue: 0,0:03:09.77,0:03:11.60,Default,,0,0,0,,Гян, бастаңыз.
Dialogue: 0,0:03:11.69,0:03:13.40,Default,,0,0,0,,Агнес Гибенрат
Dialogue: 0,0:03:13.48,0:03:14.77,Default,,0,0,0,,Гян шығады!
Dialogue: 0,0:03:16.94,0:03:18.82,Default,,0,0,0,,Әділет, бастаңыз.
Dialogue: 0,0:03:18.90,0:03:21.36,Default,,0,0,0,,Шин Асука Әділет Кеттік!
Dialogue: 0,0:03:24.28,0:03:26.87,Default,,0,0,0,,Келесі, Бостандық, ұшыңыз.
Dialogue: 0,0:03:29.79,0:03:32.37,Default,,0,0,0,,Кира Ямато Бостандық Кеттік!
Dialogue: 0,0:03:32.46,0:03:38.46,Default,,0,0,0,,♪~
Dialogue: 0,0:04:20.76,0:04:22.22,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:04:22.30,0:04:27.18,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:04:27.26,0:04:28.10,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:04:39.86,0:04:41.40,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:04:42.44,0:04:44.78,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:04:44.86,0:04:47.78,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:04:48.99,0:04:50.45,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:04:51.04,0:04:55.42,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:04:55.50,0:04:57.08,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:05:08.59,0:05:10.43,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:05:14.43,0:05:17.48,Default,,0,0,0,,Бұл Дүниежүзілік Бейбітшілік обсерваториясының компасы
Dialogue: 0,0:05:17.56,0:05:19.02,Default,,0,0,0,,Шабуыл жасайтын күшті айтыңыз
Dialogue: 0,0:05:19.11,0:05:20.94,Default,,0,0,0,,Ұрысты дереу тоқтатыңыз
Dialogue: 0,0:05:22.86,0:05:24.40,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:05:24.49,0:05:25.95,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:05:29.07,0:05:30.78,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:05:31.53,0:05:33.37,Default,,0,0,0,,Тағы да осындай нәрсе...
Dialogue: 0,0:05:33.45,0:05:34.70,Default,,0,0,0,,Шетелге, қалағанымша кез келген жерге бара алар едім—
Dialogue: 0,0:05:37.54,0:05:39.42,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:05:47.09,0:05:48.97,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:05:49.39,0:05:50.43,Default,,0,0,0,,73 адам із-түссіз жоғалып кетті
Dialogue: 0,0:05:50.51,0:05:52.39,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:05:52.47,0:05:55.27,Default,,0,0,0,,Агнес, мені қолда! Жақсы...
Dialogue: 0,0:05:55.35,0:05:56.35,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:05:57.52,0:05:58.98,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:05:59.06,0:06:02.27,Default,,0,0,0,,Менің ұшағым жақын шайқасқа арналған, ал сен мені қолда!
Dialogue: 0,0:06:06.78,0:06:08.15,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:06:08.24,0:06:10.20,Default,,0,0,0,,Ха…
Dialogue: 0,0:06:17.04,0:06:18.50,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:06:18.58,0:06:19.75,Default,,0,0,0,,(Қызық дыбыс)
Dialogue: 0,0:06:23.09,0:06:24.71,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:06:24.80,0:06:26.55,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:06:26.63,0:06:28.13,Default,,0,0,0,,(Қызық дыбыс)
Dialogue: 0,0:06:28.22,0:06:34.31,Default,,0,0,0,,~♪
Dialogue: 0,0:06:34.39,0:06:37.14,Default,,0,0,0,,Шүкір... көрінуге мүмкіндік жоқ.
Dialogue: 0,0:06:41.15,0:06:42.27,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:42.36,0:06:43.27,Default,,0,0,0,,Шегіну
Dialogue: 0,0:06:43.36,0:06:46.36,Default,,0,0,0,,Канадж қаласындағы алдыңғы шепті төмендетіп, қалыпты қалпына келтіріңіз
Dialogue: 0,0:06:50.49,0:06:52.74,Default,,0,0,0,,Олдрин қорғаныс қолбасшылығынан жеткізілді
Dialogue: 0,0:06:52.82,0:06:55.58,Default,,0,0,0,,Бұл шайқастың артында Мишель тұр.
Dialogue: 0,0:06:56.12,0:06:59.66,Default,,0,0,0,,Каназиді бағындырыңыз және Мишельді сүйреп шығарыңыз.
Dialogue: 0,0:07:00.62,0:07:01.75,Default,,0,0,0,,Не! ?
Dialogue: 0,0:07:01.83,0:07:02.71,Default,,0,0,0,,Шынымен! ?
Dialogue: 0,0:07:05.21,0:07:08.55,Default,,0,0,0,,Мен сізге ескертемін, алға басуды доғарыңыз.
Dialogue: 0,0:07:08.63,0:07:10.93,Default,,0,0,0,,Полковник Мишель мұнда жоқ!
Dialogue: 0,0:07:11.01,0:07:14.64,Default,,0,0,0,,Ұрысты одан әрі жалғастыру бейбіт тұрғындарға зиян келтіреді.
Dialogue: 0,0:07:15.72,0:07:18.31,Default,,0,0,0,,Жағдай өзгерсе, бұл...
Dialogue: 0,0:07:18.85,0:07:20.94,Default,,0,0,0,,Бірақ ешкім таңдамайды
Dialogue: 0,0:07:21.02,0:07:25.02,Default,,0,0,0,,Адамдар ұмытып, қайталайды
Dialogue: 0,0:07:25.11,0:07:26.44,Default,,0,0,0,,Нгх... Қат!
Dialogue: 0,0:07:28.78,0:07:30.11,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:07:31.95,0:07:33.82,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:07:33.91,0:07:36.24,Default,,0,0,0,,Артында болыңыз! Олар Миланның жаулары!
Dialogue: 0,0:07:36.33,0:07:37.74,Default,,0,0,0,,Неге білмейсің! ?
Dialogue: 0,0:07:37.83,0:07:39.12,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:07:44.92,0:07:46.46,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:07:52.13,0:07:54.09,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:07:54.18,0:07:57.51,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:07:58.81,0:08:00.18,Default,,0,0,0,,Капитан...
Dialogue: 0,0:08:00.64,0:08:03.23,Default,,0,0,0,,Өйткені, ол Шинге қарағанда басқа деңгейде.
Dialogue: 0,0:08:12.90,0:08:16.74,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:08:17.78,0:08:20.58,Default,,0,0,0,,734 CP бастап қаланың солтүстік тұрғын алабында —
Dialogue: 0,0:08:20.66,0:08:23.58,Default,,0,0,0,,Құтқаруды қажет ететін адамдар көп. Азаматтық ауруханаға жатқызу.
Dialogue: 0,0:08:23.66,0:08:27.67,Default,,0,0,0,,CP 734-тен Қалалық аурухана зақымдануына байланысты науқастарды қабылдай алмайды
Dialogue: 0,0:08:27.75,0:08:29.21,Default,,0,0,0,,Уақытша көмек көрсету пунктінің ашылуын күтіңіз
Dialogue: 0,0:08:29.30,0:08:30.50,Default,,0,0,0,,мұнда312
Dialogue: 0,0:08:30.59,0:08:33.93,Default,,0,0,0,,The fire is so severe that it cannot be controlled. Өрт сөндіру тобын сұраңыз.\NCP
Dialogue: 0,0:08:34.01,0:08:35.34,Default,,0,0,0,,165-тен
Dialogue: 0,0:08:35.43,0:08:38.22,Default,,0,0,0,,Көпірдің құлауына байланысты өрт сөндіру машиналары өте алмайды
Dialogue: 0,0:08:40.01,0:08:43.02,Default,,0,0,0,,Кира Ямато бригадир генералы және тағы 4 адам
Dialogue: 0,0:08:43.10,0:08:44.60,Default,,0,0,0,,Мен кемеге отыруға рұқсат сұраймын.
Dialogue: 0,0:08:45.14,0:08:47.44,Default,,0,0,0,,Рұқсат етілген Еңбектеріңіз үшін рахмет.
Dialogue: 0,0:08:47.52,0:08:51.73,Default,,0,0,0,,Барлық машиналарда ерекше мәселе жоқ сияқты.
Dialogue: 0,0:08:51.82,0:08:54.28,Default,,0,0,0,,Сіз қалай ойлайсыз? Жаңа үлгіге үйреніп қалдыңыз ба?
Dialogue: 0,0:08:54.36,0:08:56.66,Default,,0,0,0,,-Иә -Иә Жақсы
Dialogue: 0,0:08:58.57,0:09:00.03,Default,,0,0,0,,Зақымдану жағдайы қандай?
Dialogue: 0,0:09:00.62,0:09:03.33,Default,,0,0,0,,Осы уақытқа дейін 257 адам қайтыс болды.
Dialogue: 0,0:09:03.41,0:09:05.71,Default,,0,0,0,,Оның 68-і бейбіт тұрғындар.
Dialogue: 0,0:09:06.37,0:09:08.25,Default,,0,0,0,,Мүмкін одан да көп.
Dialogue: 0,0:09:08.33,0:09:09.21,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:09.29,0:09:11.13,Default,,0,0,0,,Бұл жолы да аналық жоқ
Dialogue: 0,0:09:11.21,0:09:14.30,Default,,0,0,0,,Тек жылжымалы костюм әскерлерімен тосын шабуыл
Dialogue: 0,0:09:14.38,0:09:16.72,Default,,0,0,0,,Мишель желісі.
Dialogue: 0,0:09:17.51,0:09:20.22,Default,,0,0,0,,Бірақ оның соғысқа қатысуы жалған.
Dialogue: 0,0:09:20.30,0:09:23.35,Default,,0,0,0,,Мақсат - ZAFT шекараны бұзу.
Dialogue: 0,0:09:23.98,0:09:28.81,Default,,0,0,0,,Егер сіз өз атыңызды жем ретінде қолдансаңыз, оны ұстай алатыныңызға сенімді болуыңыз керек.
Dialogue: 0,0:09:28.90,0:09:32.23,Default,,0,0,0,,Бұл Дома Эрон Райхамен болған сайын бірдей.
Dialogue: 0,0:09:32.32,0:09:33.28,Default,,0,0,0,,Иә...
Dialogue: 0,0:09:33.36,0:09:36.74,Default,,0,0,0,,Олар мұны қанша уақытқа дейін жалғастырады? ?
Dialogue: 0,0:09:36.82,0:09:37.66,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:37.74,0:09:40.66,Default,,0,0,0,,Басынан қайтаруды болжамайтын стратегия...
Dialogue: 0,0:09:40.74,0:09:43.08,Default,,0,0,0,,Ұшқыш та, ұшақ та шыдамайды.
Dialogue: 0,0:09:44.00,0:09:45.25,Default,,0,0,0,,Бірақ ол жалғасуда
Dialogue: 0,0:09:45.33,0:09:46.66,Default,,0,0,0,,Ха…
Dialogue: 0,0:09:46.75,0:09:48.58,Default,,0,0,0,,Сондықтан бұл мәселе.
Dialogue: 0,0:09:49.71,0:09:53.13,Default,,0,0,0,,Бұл тереңде жатқан мәселе, шын мәнінде...
Dialogue: 0,0:09:56.01,0:09:57.68,Default,,0,0,0,,Ғарыштық Ира 73
Dialogue: 0,0:09:58.51,0:10:03.89,Default,,0,0,0,,«Әлемді бұзудан» басталған жердегі өсімдіктер арасындағы жаңа шайқас
Dialogue: 0,0:10:03.97,0:10:09.19,Default,,0,0,0,,Түрлі түрдегі өзгерістерден кейін ақыры ақыры келді.
Dialogue: 0,0:10:09.90,0:10:14.23,Default,,0,0,0,,Тағдыр жоспары жаңа әлемдік жүйе ретінде ұсынылған
Dialogue: 0,0:10:14.32,0:10:17.53,Default,,0,0,0,,Оның қорғаушысы, Дурандал Кеңесінің төрағасы -
Dialogue: 0,0:10:17.61,0:10:20.87,Default,,0,0,0,,Өліммен бірге бәрі жерленген
Dialogue: 0,0:10:20.95,0:10:22.16,Default,,0,0,0,,Кейінірек тағы да—
Dialogue: 0,0:10:22.24,0:10:25.45,Default,,0,0,0,,Артында терең мұң мен абдырап қалды
Dialogue: 0,0:10:25.54,0:10:27.08,Default,,0,0,0,,Біздің әскерлерге келтірілген залал -
Dialogue: 0,0:10:27.16,0:10:29.87,Default,,0,0,0,,Сіз президент Клейнді білмейсіз бе?
Dialogue: 0,0:10:29.96,0:10:32.54,Default,,0,0,0,,Көк ғарышқа біржақты басып кіру —
Dialogue: 0,0:10:32.63,0:10:35.05,Default,,0,0,0,,Оны алған адам осы!
Dialogue: 0,0:10:35.13,0:10:36.88,Default,,0,0,0,,Егер сіз өзіңіздің сарбаздарыңыздың сезімін ойласаңыз —
Dialogue: 0,0:10:36.96,0:10:40.05,Default,,0,0,0,,Капитан Яматоның әрекеті тым аяусыз!
Dialogue: 0,0:10:41.80,0:10:44.10,Default,,0,0,0,,Табиғи координаторлар арасындағы алшақтық:
Dialogue: 0,0:10:44.18,0:10:45.97,Default,,0,0,0,,Әлі толтырылмаған
Dialogue: 0,0:10:46.47,0:10:49.56,Default,,0,0,0,,Әртүрлі жерлерде болған тәуелсіздік қозғалыстарынан басқа,
Dialogue: 0,0:10:49.64,0:10:52.36,Default,,0,0,0,,Полковник Мишель басқаратын Көк ғарыш...
Dialogue: 0,0:10:52.44,0:10:55.23,Default,,0,0,0,,Қайталанған партизандық шайқастар
Dialogue: 0,0:10:55.32,0:11:00.20,Default,,0,0,0,,Дау-дамай мен өшпенділік әр жерде әлі де лаулап тұрды.
Dialogue: 0,0:11:08.91,0:11:14.46,Default,,0,0,0,,Атлантика федерациясының Plant Orb басшылары жағдайға алаңдады.
Dialogue: 0,0:11:14.54,0:11:18.76,Default,,0,0,0,,Дүниежүзілік Бейбітшілікті бақылау ұйымының компас құрылуы
Dialogue: 0,0:11:18.84,0:11:23.14,Default,,0,0,0,,Лакус Клайнды өзінің бірінші президенті болуға шақырды.
Dialogue: 0,0:11:24.72,0:11:28.06,Default,,0,0,0,,Төраға Жоқтау, алаңдатқанымыз үшін кешірім сұраймыз.
Dialogue: 0,0:11:28.14,0:11:29.18,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:11:29.27,0:11:31.19,Default,,0,0,0,,Дегенмен, Jagannath et al.
Dialogue: 0,0:11:31.27,0:11:33.85,Default,,0,0,0,,Мен ауыр сөз айтуым керек.
Dialogue: 0,0:11:33.94,0:11:37.48,Default,,0,0,0,,Әскер ішінде реніш көбейіп барады деп естідім.
Dialogue: 0,0:11:37.57,0:11:38.73,Default,,0,0,0,,Иә...
Dialogue: 0,0:11:38.82,0:11:41.57,Default,,0,0,0,,Компас әлі де жауапты болған кезде...
Dialogue: 0,0:11:41.65,0:11:44.28,Default,,0,0,0,,Ешқандай жарылыс болмайды деп ойлаймын.
Dialogue: 0,0:11:44.37,0:11:47.16,Default,,0,0,0,,-Оның да шегі бар -Хмм...
Dialogue: 0,0:11:47.24,0:11:51.46,Default,,0,0,0,,Жек көруді ұмыта алмайтын ақымақ екенін түсінсем де...
Dialogue: 0,0:11:51.54,0:11:54.46,Default,,0,0,0,,Өйткені, бізді де сезім билейді.
Dialogue: 0,0:11:54.54,0:11:57.96,Default,,0,0,0,,Менің жоғалтқаным тым керемет болды.
Dialogue: 0,0:11:58.05,0:11:59.13,Default,,0,0,0,,Иә...
Dialogue: 0,0:11:59.21,0:12:01.38,Default,,0,0,0,,Соңында Каназидегі Мишель туралы не деуге болады?
Dialogue: 0,0:12:02.63,0:12:07.72,Default,,0,0,0,,Ол Еуразияның әскери буферлік аймағында жасырынып жүр ме?
Dialogue: 0,0:12:07.81,0:12:10.06,Default,,0,0,0,,Егер бұл мүмкіндік жоғары болса...
Dialogue: 0,0:12:10.14,0:12:12.44,Default,,0,0,0,,Хмм... Мен соншалықты көп білсем де...
Dialogue: 0,0:12:12.52,0:12:15.86,Default,,0,0,0,,Біздің қазіргі жағдайымыз оған көмектесе алмаймыз.
Dialogue: 0,0:12:15.94,0:12:16.98,Default,,0,0,0,,Иә...
Dialogue: 0,0:12:18.36,0:12:22.45,Default,,0,0,0,,Мыңжылдықтың қайтып келгеніне бір ай болды ма?
Dialogue: 0,0:12:22.53,0:12:26.41,Default,,0,0,0,,Бригадир бұл жолы біраз демала ала ма?
Dialogue: 0,0:12:26.95,0:12:29.37,Default,,0,0,0,,Иә, кесте бойынша
Dialogue: 0,0:12:29.45,0:12:31.83,Default,,0,0,0,,Бұл жақсы болды
Dialogue: 0,0:12:31.91,0:12:32.87,Default,,0,0,0,,Көк
Dialogue: 0,0:12:34.33,0:12:37.92,Default,,0,0,0,,Дегенмен мен сізбен бірнеше рет кездестім.
Dialogue: 0,0:12:38.00,0:12:41.84,Default,,0,0,0,,Капитан Ямато - біртүрлі адам.
Dialogue: 0,0:12:42.38,0:12:47.30,Default,,0,0,0,,Ұрыс даласына жарамайтын тыныш әсер қалдырады.
Dialogue: 0,0:12:47.39,0:12:52.02,Default,,0,0,0,,Дәл қазір бұл соғыстың қайшылықтарын жалғыз өзі жеңуге тырысатын сияқты.
Dialogue: 0,0:12:52.64,0:12:54.94,Default,,0,0,0,,Ол мейірімді. Ол...
Dialogue: 0,0:12:55.02,0:12:56.52,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:13:00.11,0:13:03.90,Default,,0,0,0,,Сондықтан біз оны мүмкіндігінше тезірек босатуымыз керек.
Dialogue: 0,0:13:03.99,0:13:06.95,Default,,0,0,0,,Мейірімділік оны жоймас бұрын...
Dialogue: 0,0:13:08.95,0:13:10.41,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:13:10.49,0:13:12.16,Default,,0,0,0,,Мәртебелі Тао?
Dialogue: 0,0:13:14.08,0:13:16.42,Default,,0,0,0,,Құрметпен, Ұлттық қорғаныс комитетінің төрағасы
Dialogue: 0,0:13:16.50,0:13:18.46,Default,,0,0,0,,осында
Dialogue: 0,0:13:20.54,0:13:22.46,Default,,0,0,0,,Жоғарыда айтылғандар негіз болып табылады.
Dialogue: 0,0:13:22.55,0:13:24.88,Default,,0,0,0,,Бұл Императрица Аураның ұсынысы.
Dialogue: 0,0:13:24.97,0:13:27.80,Default,,0,0,0,,Менің ойымша, дәл осындай нәрсе зауытқа келді.
Dialogue: 0,0:13:27.89,0:13:29.97,Default,,0,0,0,,Бұл ел Мишельдің қайда екенін біледі.
Dialogue: 0,0:13:30.05,0:13:31.97,Default,,0,0,0,,Сіз оны дәл түсініп жатқан сияқтысыз.
Dialogue: 0,0:13:32.72,0:13:33.64,Default,,0,0,0,,Ынтымақтастықтың мәні —
Dialogue: 0,0:13:33.72,0:13:35.39,Default,,0,0,0,,Менің ойымша, бар.
Dialogue: 0,0:13:36.31,0:13:37.85,Default,,0,0,0,,That's right.
Dialogue: 0,0:13:37.94,0:13:42.11,Default,,0,0,0,,Бірақ Тоя, екі жағы бар.
Dialogue: 0,0:13:42.19,0:13:44.28,Default,,0,0,0,,Сыйақы дегеніміз не?
Dialogue: 0,0:13:44.36,0:13:47.20,Default,,0,0,0,,Компасқа қатысу...
Dialogue: 0,0:13:47.28,0:13:48.78,Default,,0,0,0,,Осыны ескере отырып,
Dialogue: 0,0:13:48.86,0:13:52.45,Default,,0,0,0,,Сіз халықаралық қоғамдастыққа тәуелсіз ел ретінде танылғаныңызды қалайсыз ба?
Dialogue: 0,0:13:52.54,0:13:54.16,Default,,0,0,0,,(Изуку) Урарака ханым. (Урарака) Иә!
Dialogue: 0,0:13:54.25,0:13:56.00,Default,,0,0,0,,Тәуелсіздік алғаннан кейінгі іргетасы
Dialogue: 0,0:13:56.08,0:13:59.79,Default,,0,0,0,,Технология да, экономика да керемет жетістіктерге жетуде.
Dialogue: 0,0:13:59.88,0:14:02.38,Default,,0,0,0,,Еуразиямен қарым-қатынас жақсы емес
Dialogue: 0,0:14:02.46,0:14:07.55,Default,,0,0,0,,Өйткені, Еуразияның барлық аймақтары тәуелсіздік дауылының толқынында болды.
Dialogue: 0,0:14:07.63,0:14:09.72,Default,,0,0,0,,«Іргетастың соққысы»
Dialogue: 0,0:14:09.80,0:14:10.64,Default,,0,0,0,,Иә
Dialogue: 0,0:14:10.72,0:14:12.35,Default,,0,0,0,,Неге сонша
Dialogue: 0,0:14:12.43,0:14:14.85,Default,,0,0,0,,Керемет қалпына келтіру мүмкін болды ма?
Dialogue: 0,0:14:14.93,0:14:17.89,Default,,0,0,0,,Бұл премьер-министр Орфей Лам Таоның шеберлігі деп естідім.
Dialogue: 0,0:14:18.48,0:14:22.06,Default,,0,0,0,,Бұрынғы төраға Дурандал оның талантын мойындады...
Dialogue: 0,0:14:22.15,0:14:23.02,Default,,0,0,0,,Ха…
Dialogue: 0,0:14:23.11,0:14:26.24,Default,,0,0,0,,Губернатордың «Тағдыр жоспарына» күмәні бар ма? ?
Dialogue: 0,0:14:26.32,0:14:27.90,Default,,0,0,0,,Жоқ, олай емес...
Dialogue: 0,0:14:31.12,0:14:32.32,Default,,0,0,0,,Біз—
Dialogue: 0,0:14:32.41,0:14:35.95,Default,,0,0,0,,Төраға Дурандал көрсеткен болашақты жоққа шығардым.
Dialogue: 0,0:14:36.04,0:14:39.87,Default,,0,0,0,,Дегенмен, бұл мүмкіндік көптеген адамдарды қызықтыратынына сенімдімін.
Dialogue: 0,0:14:39.96,0:14:43.04,Default,,0,0,0,,Тіпті ол адамдарды жоққа шығаруға болмайды.
Dialogue: 0,0:14:43.54,0:14:44.67,Default,,0,0,0,,"Дегенмен ол жүгірді."
Dialogue: 0,0:14:44.75,0:14:48.22,Default,,0,0,0,,Енді мен Compass-ке қосылуға рұқсат алдым...
Dialogue: 0,0:14:48.30,0:14:50.84,Default,,0,0,0,,Компас кеңесі мүшелері мен Еуразия арасындағы қарым-қатынас...
Dialogue: 0,0:14:50.93,0:14:52.85,Default,,0,0,0,,Бұдан әрі асқыну мүмкіндігі де бар...
Dialogue: 0,0:14:52.93,0:14:54.47,Default,,0,0,0,,That's right.
Dialogue: 0,0:14:54.56,0:14:57.73,Default,,0,0,0,,Бірақ алты ай бұрын Freedom Heist оқиғасында...
Dialogue: 0,0:14:57.81,0:15:00.02,Default,,0,0,0,,Орб да оларға қарыздар.
Dialogue: 0,0:15:00.10,0:15:01.15,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:01.23,0:15:02.77,Default,,0,0,0,,Лакус бұған қарсы ма?
Dialogue: 0,0:15:02.86,0:15:03.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:06.61,0:15:09.49,Default,,0,0,0,,Бір сәт ойланып алайын.
Dialogue: 0,0:15:11.20,0:15:12.41,Default,,0,0,0,,Иә!?
Dialogue: 0,0:15:12.49,0:15:14.78,Default,,0,0,0,,Бірақ Лакус...
Dialogue: 0,0:15:14.87,0:15:16.33,Default,,0,0,0,,Кира жоқ
Dialogue: 0,0:15:16.41,0:15:18.50,Default,,0,0,0,,Мен қалағандықтан емес.
Dialogue: 0,0:15:18.58,0:15:19.91,Default,,0,0,0,,Ха…
Dialogue: 0,0:15:20.00,0:15:21.83,Default,,0,0,0,,Мен де соны қалаймын.
Dialogue: 0,0:15:21.92,0:15:22.75,Default,,0,0,0,,А...
Dialogue: 0,0:15:22.83,0:15:25.67,Default,,0,0,0,,Сізбен күресу үшін
Dialogue: 0,0:15:25.75,0:15:27.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:29.88,0:15:30.92,Default,,0,0,0,,Люкс…
Dialogue: 0,0:15:32.93,0:15:34.30,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:43.06,0:15:46.27,Default,,0,0,0,,Маған сенбейтін шығармын?
Dialogue: 0,0:15:46.36,0:15:47.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:47.36,0:15:51.61,Default,,0,0,0,,Жоқ, капитан, мен әрқашан жалғыз күресемін.
Dialogue: 0,0:15:51.70,0:15:55.20,Default,,0,0,0,,Бірақ бұл да зиянды шектейді.
Dialogue: 0,0:15:55.28,0:16:00.00,Default,,0,0,0,,Бұл дұрыс, бірақ біз кімбіз?
Dialogue: 0,0:16:00.08,0:16:01.41,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:01.50,0:16:04.46,Default,,0,0,0,,Капитан, сіз маған айттыңыз, солай ма?
Dialogue: 0,0:16:04.54,0:16:08.09,Default,,0,0,0,,Сол кезде маған «Бірге күресейік» дедің...
Dialogue: 0,0:16:10.26,0:16:11.47,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,0:16:11.55,0:16:16.01,Default,,0,0,0,,Мен бұл сөздерді естіп, Компасқа қосылдым...
Dialogue: 0,0:16:16.10,0:16:19.18,Default,,0,0,0,,...және? Сіз тағы да құрттар туралы ойлайсыз ба?
Dialogue: 0,0:16:19.26,0:16:21.64,Default,,0,0,0,,Бұлай емес!
Dialogue: 0,0:16:21.73,0:16:23.35,Default,,0,0,0,,Сонда мен не айтуым керек?
Dialogue: 0,0:16:23.44,0:16:26.11,Default,,0,0,0,,Мен көбірек көмектескім келеді, Кира-сан...
Dialogue: 0,0:16:26.86,0:16:29.69,Default,,0,0,0,,Шынға әділдік сеніп тапсырылған жоқ па?
Dialogue: 0,0:16:29.78,0:16:31.57,Default,,0,0,0,,Сен маған сенбейсің... (Есіктің ашылған дыбысы)
Dialogue: 0,0:16:31.65,0:16:34.53,Default,,0,0,0,,Сенім деген ұғым жоқ.
Dialogue: 0,0:16:34.61,0:16:37.70,Default,,0,0,0,,Сізді «Бостандық өлтіруші» деп атады.
Dialogue: 0,0:16:37.78,0:16:39.37,Default,,0,0,0,,Бостандық өлтіруші ме?
Dialogue: 0,0:16:39.45,0:16:41.54,Default,,0,0,0,,О, сен білмедің бе?
Dialogue: 0,0:16:41.62,0:16:43.33,Default,,0,0,0,,Құттықтаймыз.
Dialogue: 0,0:16:43.41,0:16:45.92,Default,,0,0,0,,Кез келген уақытта арқаңыздан атқан адам
Dialogue: 0,0:16:46.00,0:16:48.54,Default,,0,0,0,,Мен сенің орнында болсам, қасымда болғаныңды қаламас едім.
Dialogue: 0,0:16:48.63,0:16:49.96,Default,,0,0,0,,Агнес
Dialogue: 0,0:16:50.05,0:16:53.13,Default,,0,0,0,,Әй, маған берші, Әділет.
Dialogue: 0,0:16:53.22,0:16:56.51,Default,,0,0,0,,Бар болса да, қазынадай сақта.
Dialogue: 0,0:16:56.59,0:16:59.81,Default,,0,0,0,,Академияда мен техникада да, бағалауда да жақсы болдым.
Dialogue: 0,0:16:59.89,0:17:00.93,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,0:17:01.01,0:17:02.18,Default,,0,0,0,,Сәлем, Агнес!
Dialogue: 0,0:17:02.27,0:17:04.77,Default,,0,0,0,,Соғыс кезінде де біртүрлі деп ойладың.
Dialogue: 0,0:17:04.85,0:17:06.90,Default,,0,0,0,,Сен Сенімсің
Dialogue: 0,0:17:06.98,0:17:09.98,Default,,0,0,0,,Бірақ, сайып келгенде, Төраға Дурандал үшін...
Dialogue: 0,0:17:10.07,0:17:12.32,Default,,0,0,0,,Бұл дұрыс шығарма болды, солай ма?
Dialogue: 0,0:17:12.40,0:17:13.49,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:17:13.57,0:17:15.65,Default,,0,0,0,,Уайымдамаңыз!
Dialogue: 0,0:17:17.24,0:17:18.28,Default,,0,0,0,,Олдрин ауданында
Dialogue: 0,0:17:18.37,0:17:20.83,Default,,0,0,0,,Келтірілген шығын 428 адам қайтыс болды.
Dialogue: 0,0:17:21.49,0:17:23.75,Default,,0,0,0,,Енді қалған күштер бойынша Көк Ғарыш —
Dialogue: 0,0:17:23.83,0:17:26.42,Default,,0,0,0,,Террористтердің шығыны 5000-нан асты.
Dialogue: 0,0:17:26.50,0:17:28.88,Default,,0,0,0,,Әр елдің үкіметтері жағдайды байыппен қабылдады —
Dialogue: 0,0:17:28.96,0:17:32.67,Default,,0,0,0,,Ұйымның жетекшісі полковник Мишель халықаралық іздеуде.
Dialogue: 0,0:17:32.76,0:17:37.38,Default,,0,0,0,,Біз ұйымды таратқымыз келеді, бірақ оның қайда екенін әлі растай алмаймыз...
Dialogue: 0,0:17:37.93,0:17:38.93,Default,,0,0,0,,Оңтүстік Италиядағы Неаполис қаласы.
Dialogue: 0,0:17:39.01,0:17:40.10,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:40.18,0:17:41.35,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:17:41.43,0:17:44.02,Default,,0,0,0,,Оңтүстік Италиядағы Неаполис қаласы.
Dialogue: 0,0:17:44.10,0:17:45.56,Default,,0,0,0,,Кира?
Dialogue: 0,0:17:46.64,0:17:48.44,Default,,0,0,0,,Ақанде!
Dialogue: 0,0:17:55.03,0:17:58.53,Default,,0,0,0,,Мен көремін. Өтінемін, өзіңізді қатты итермеңіз.
Dialogue: 0,0:17:58.61,0:18:00.28,Default,,0,0,0,,Митомета Кунай!
Dialogue: 0,0:18:00.37,0:18:01.28,Default,,0,0,0,,Фермионды индукциялау әдісі —
Dialogue: 0,0:18:01.37,0:18:02.62,Default,,0,0,0,,Әлі де пайдасыз
Dialogue: 0,0:18:02.70,0:18:04.12,Default,,0,0,0,,Микрометрлік кедергілермен —
Dialogue: 0,0:18:04.20,0:18:06.21,Default,,0,0,0,,Қондыру сенсорында қате болуы мүмкін емес.
Dialogue: 0,0:18:06.29,0:18:09.42,Default,,0,0,0,,Оны шешуге болады деп ойлайсың ба? Капитан Хайнлейн
Dialogue: 0,0:18:09.50,0:18:12.42,Default,,0,0,0,,А... Мен, дизайнер, мұны істеуден басқа амалым жоқ.
Dialogue: 0,0:18:12.50,0:18:14.63,Default,,0,0,0,,Даму бөлімінің біліксіздігі таң қалдырады.
Dialogue: 0,0:18:14.71,0:18:17.05,Default,,0,0,0,,Бостандықты орнату және реттеу үшін уақыт қажет болса да.
Dialogue: 0,0:18:17.13,0:18:19.30,Default,,0,0,0,,Автономды басқару бағдарламасындағы қателер де бас ауруы.
Dialogue: 0,0:18:19.38,0:18:22.14,Default,,0,0,0,,Мен бағдарламаға жауапты боламын, сондықтан...
Dialogue: 0,0:18:22.22,0:18:24.72,Default,,0,0,0,,Капитан Хайнлейн, маған сенсор беріңізші.
Dialogue: 0,0:18:24.81,0:18:26.68,Default,,0,0,0,,Кешіріңіз, бригадир...
Dialogue: 0,0:18:28.94,0:18:31.90,Default,,0,0,0,,Сіз сенімдісіз бе? Мен үйге келмеймін
Dialogue: 0,0:18:31.98,0:18:33.02,Default,,0,0,0,,Иә...
Dialogue: 0,0:18:33.11,0:18:35.78,Default,,0,0,0,,Президент Клейн сізді күтіп отыр ма?
Dialogue: 0,0:18:36.15,0:18:39.74,Default,,0,0,0,,Бірақ мен мұны жақын арада пайдалана алуым керек...
Dialogue: 0,0:18:40.45,0:18:44.33,Default,,0,0,0,,Жауды жеңу күші - жағдайды шешудің ең жылдам жолы
Dialogue: 0,0:18:44.41,0:18:46.04,Default,,0,0,0,,Сіз... дейсіз бе?
Dialogue: 0,0:18:46.12,0:18:48.08,Default,,0,0,0,,Бұл емес.
Dialogue: 0,0:18:48.96,0:18:52.38,Default,,0,0,0,,Бірақ біз ештеңені қорғай алмаймыз...
Dialogue: 0,0:18:55.38,0:18:58.72,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:19:04.47,0:19:06.14,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,0:19:06.22,0:19:07.81,Default,,0,0,0,,Ха... Кира?
Dialogue: 0,0:19:10.60,0:19:11.65,Default,,0,0,0,,Кира?
Dialogue: 0,0:19:12.65,0:19:14.27,Default,,0,0,0,,Не болды?
Dialogue: 0,0:19:15.44,0:19:16.78,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:19:16.86,0:19:18.32,Default,,0,0,0,,Кира!
Dialogue: 0,0:19:22.74,0:19:24.16,Default,,0,0,0,,(жану шамдарының дыбысы)
Dialogue: 0,0:19:24.24,0:19:29.00,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:19:32.50,0:19:33.50,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:19:33.58,0:19:36.84,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:19:56.44,0:19:59.11,Default,,0,0,0,,Мен мұндай нәрсені енді ешқашан жасамауым керек.
Dialogue: 0,0:19:59.19,0:20:01.70,Default,,0,0,0,,Біз әлемді осылай етуіміз керек...
Dialogue: 0,0:20:01.78,0:20:04.11,Default,,0,0,0,,Кім айта алады?
Dialogue: 0,0:20:05.70,0:20:08.79,Default,,0,0,0,,Сен айтқан дүние мен мен көрсететін дүние
Dialogue: 0,0:20:08.87,0:20:11.21,Default,,0,0,0,,Барлығы қайсысын қалайды?
Dialogue: 0,0:20:11.75,0:20:13.12,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:20:13.21,0:20:17.54,Default,,0,0,0,,Жазылған тарихтың басынан адамзат тарихына дейін соғыс ешқашан тоқтаған емес.
Dialogue: 0,0:20:18.71,0:20:21.72,Default,,0,0,0,,Біздің ең үлкен жауымыз әрқашан бар
Dialogue: 0,0:20:22.30,0:20:24.13,Default,,0,0,0,,Қашан болса да...
Dialogue: 0,0:20:24.22,0:20:29.43,Default,,0,0,0,,Біз өзіміздің надандық пен сараңдықты жеңе алмаймыз!
Dialogue: 0,0:20:33.14,0:20:36.19,Default,,0,0,0,,Nnnnnnn…
Dialogue: 0,0:20:39.07,0:20:41.24,Default,,0,0,0,,Я...
Dialogue: 0,0:20:41.99,0:20:43.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:51.25,0:20:52.50,Default,,0,0,0,,Ха…
Dialogue: 0,0:21:17.77,0:21:19.23,Default,,0,0,0,,Полковник Мишель —
Dialogue: 0,0:21:19.31,0:21:23.03,Default,,0,0,0,,Ол Еуразия шекарасына жақын Эльдорда жасырынып жүрген сияқты.
Dialogue: 0,0:21:23.11,0:21:23.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:24.03,0:21:25.95,Default,,0,0,0,,Мен қамауға алумен ынтымақтасқым келеді.
Dialogue: 0,0:21:26.03,0:21:29.53,Default,,0,0,0,,Қордың Мәртебелі Аурасынан жеке хат келді.
Dialogue: 0,0:21:30.49,0:21:33.12,Default,,0,0,0,,Лакус не істеуді жоспарлап отыр?
Dialogue: 0,0:21:33.20,0:21:35.71,Default,,0,0,0,,Шынымды айтсам, мен абдырап қалдым.
Dialogue: 0,0:21:36.54,0:21:38.75,Default,,0,0,0,,Кира туралы не ойлайсың?
Dialogue: 0,0:21:39.92,0:21:41.17,Default,,0,0,0,,Неліктен сұрайсыз?
Dialogue: 0,0:21:41.96,0:21:43.46,Default,,0,0,0,,Бұл...
Dialogue: 0,0:21:48.51,0:21:53.10,Default,,0,0,0,,Егер мұның соңы болса, қарсылық білдіруге еш себеп жоқ.
Dialogue: 0,0:21:53.18,0:21:54.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:54.60,0:21:57.31,Default,,0,0,0,,Бұл шайқастың соңы көрінбейді.
Dialogue: 0,0:21:57.39,0:21:59.77,Default,,0,0,0,,Адамдар оңайлықпен өзгермейді
Dialogue: 0,0:22:00.11,0:22:01.52,Default,,0,0,0,,Омаэмонер
Dialogue: 0,0:22:01.61,0:22:05.90,Default,,0,0,0,,Мен не істей алатынымды және не істей алмайтынымды білмеймін.
Dialogue: 0,0:22:05.99,0:22:07.70,Default,,0,0,0,,Мен не істей аламын...
Dialogue: 0,0:22:09.45,0:22:10.78,Default,,0,0,0,,Өз киімдері —
Dialogue: 0,0:22:11.37,0:22:13.20,Default,,0,0,0,,Мұны біреу істеу керек
Dialogue: 0,0:22:15.70,0:22:17.62,Default,,0,0,0,,Егер біреу мұны істемесе...
Dialogue: 0,0:22:21.63,0:22:25.46,Default,,0,0,0,,Бірақ Еуразия компастарды құптамайды, солай ма?
Dialogue: 0,0:22:25.55,0:22:26.92,Default,,0,0,0,,Сондықтан губернатордың өзі—
Dialogue: 0,0:22:27.01,0:22:28.72,Default,,0,0,0,,Сіз мені ертіп барасыз ба?
Dialogue: 0,0:22:28.80,0:22:32.43,Default,,0,0,0,,Мүмкін қандай да бір саяси келіссөздер жүріп жатқан шығар.
Dialogue: 0,0:22:32.51,0:22:33.93,Default,,0,0,0,,Уа, монахтар
Dialogue: 0,0:22:34.01,0:22:35.85,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:22:35.93,0:22:37.35,Default,,0,0,0,,Мен ол жақта елестер бола ма деп ойлаймын.
Dialogue: 0,0:22:37.43,0:22:38.85,Default,,0,0,0,,Ах... иә?
Dialogue: 0,0:22:38.94,0:22:40.73,Default,,0,0,0,,Негізі
Dialogue: 0,0:22:40.81,0:22:45.23,Default,,0,0,0,,Оны сол жақтағы тәуелсіздік қозғалысы кезінде Еуразиядан келгендер көрген дейді.
Dialogue: 0,0:22:45.32,0:22:47.03,Default,,0,0,0,,Келпи
Dialogue: 0,0:22:47.11,0:22:48.57,Default,,0,0,0,,Келпи дегеніміз не?
Dialogue: 0,0:22:48.70,0:22:51.45,Default,,0,0,0,,Суда тіршілік ететін құбыжықтар туралы.
Dialogue: 0,0:22:51.53,0:22:55.62,Default,,0,0,0,,Міне, ел қандай жұмбақ.
Dialogue: 0,0:22:55.70,0:22:57.50,Default,,0,0,0,,-Күте тұр... -Бакемоно...
Dialogue: 0,0:22:57.58,0:23:00.87,Default,,0,0,0,,Капитан Харкен Жыныстық қудалау жақсы емес!
Dialogue: 0,0:23:06.09,0:23:07.84,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:23:09.05,0:23:11.13,Default,,0,0,0,,20 атмосфераға түскенге дейін
Dialogue: 0,0:23:11.22,0:23:14.05,Default,,0,0,0,,Көпірді экрандау Толық қалқаны жабу
Dialogue: 0,0:23:14.97,0:23:17.81,Default,,0,0,0,,Кеме енді атмосфераға түседі.
Dialogue: 0,0:23:17.89,0:23:20.39,Default,,0,0,0,,Көпірді брондалған бөлікке ауыстыру
Dialogue: 0,0:23:20.48,0:23:24.82,Default,,0,0,0,,R2 хаттамасы шығарылды: Барлық кемелер атмосфераға кіруге дайындалуда.
Dialogue: 0,0:23:24.90,0:23:28.40,Default,,0,0,0,,Салқындату жүйесінің онлайн абляциялық қалқанды белсендіру
Dialogue: 0,0:23:46.55,0:23:49.46,Default,,0,0,0,,Қайта құру мен күткеннен тезірек жүріп жатқан сияқты.
Dialogue: 0,0:23:49.55,0:23:53.01,Default,,0,0,0,,Бұл бізде өте жақсы адамдар немесе үкімет бар екенін білдіреді.
Dialogue: 0,0:23:53.09,0:23:55.35,Default,,0,0,0,,Мыңжылдық оң жақтан қосылады
Dialogue: 0,0:23:55.43,0:23:58.31,Default,,0,0,0,,Әуе шабуылына қарсы жерге қарсы ескерту жалғасты
Dialogue: 0,0:23:58.39,0:24:00.14,Default,,0,0,0,,Төмен сенсоры желіде
Dialogue: 0,0:24:00.23,0:24:03.23,Default,,0,0,0,,Түсу бағыты және тереңдігі туралы деректер Кедергілер жоқ
Dialogue: 0,0:24:03.31,0:24:06.15,Default,,0,0,0,,Левитатор шығысы 20 ұстау
Dialogue: 0,0:24:06.77,0:24:10.53,Default,,0,0,0,,D қызметкері су өткізбейтін жағдайды тексеріп, хабарлауы керек.
Dialogue: 0,0:24:36.34,0:24:37.89,Default,,0,0,0,,Қош келдіңіз ханшайым
Dialogue: 0,0:24:37.97,0:24:41.39,Default,,0,0,0,,Қор канцлері Орфей Лам Тао.
Dialogue: 0,0:24:41.48,0:24:43.56,Default,,0,0,0,,Біз сізді шын жүректен қарсы аламыз.
Dialogue: 0,0:24:43.64,0:24:46.61,Default,,0,0,0,,Бұл Лакус Клайн, Compass бас директоры.
Dialogue: 0,0:24:46.69,0:24:49.48,Default,,0,0,0,,Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:24:51.23,0:24:52.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:24:55.41,0:24:57.03,Default,,0,0,0,,Ха…
Dialogue: 0,0:24:57.82,0:24:59.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:25:00.12,0:25:01.37,Default,,0,0,0,,Хмм...
Dialogue: 0,0:25:03.29,0:25:05.58,Default,,0,0,0,,Ақыры мен сені кездестірдім.
Dialogue: 0,0:25:05.67,0:25:07.17,Default,,0,0,0,,Лакус Клайн
Dialogue: 0,0:25:07.25,0:25:08.59,Default,,0,0,0,,Ха…
Dialogue: 0,0:25:08.67,0:25:10.55,Default,,0,0,0,,Мен тастап кеткен құралдар—
Dialogue: 0,0:25:10.63,0:25:12.80,Default,,0,0,0,,Мен сенің тағдырыңмын
Dialogue: 0,0:25:14.13,0:25:16.59,Default,,0,0,0,,Дүниені бірге басқаратындар
Dialogue: 0,0:25:16.68,0:25:17.93,Default,,0,0,0,,Ха…
Dialogue: 0,0:25:19.22,0:25:21.56,Default,,0,0,0,,-Лакус -Ах...
Dialogue: 0,0:25:22.35,0:25:23.56,Default,,0,0,0,,Фу…
Dialogue: 0,0:25:23.64,0:25:25.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:25:31.94,0:25:32.98,Default,,0,0,0,,Ха…
Dialogue: 0,0:25:33.07,0:25:34.99,Default,,0,0,0,,Жолда жүргендер...
Dialogue: 0,0:25:35.07,0:25:36.57,Default,,0,0,0,,Не?
Dialogue: 0,0:25:40.16,0:25:42.99,Default,,0,0,0,,Ах, ах…
Dialogue: 0,0:25:46.71,0:25:51.50,Default,,0,0,0,,Терең! Өте сау-саламат көрінесің! Бір жақсы жаңалық болды ма?
Dialogue: 0,0:25:51.59,0:25:54.42,Default,,0,0,0,,Хм... Эй, жүгір!
Dialogue: 0,0:25:54.51,0:25:55.59,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:25:55.67,0:25:57.76,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:26:04.10,0:26:06.64,Default,,0,0,0,,Қорға қош келдіңіз
Dialogue: 0,0:26:06.73,0:26:08.90,Default,,0,0,0,,Бұл Аула Маха Хайбар.
Dialogue: 0,0:26:09.02,0:26:11.52,Default,,0,0,0,,Бұл жолы Компастан жылдам жауап
Dialogue: 0,0:26:11.61,0:26:12.69,Default,,0,0,0,,Ауырады
Dialogue: 0,0:26:14.07,0:26:19.11,Default,,0,0,0,,Мәртебелі Аура, сізбен бірге аудитория болу құрметіне ие болғанымды мақтан тұтамын.
Dialogue: 0,0:26:19.20,0:26:21.32,Default,,0,0,0,,Мишельдің партизандарына -
Dialogue: 0,0:26:21.41,0:26:23.54,Default,,0,0,0,,Еліміз де көп қиындық көріп жатыр.
Dialogue: 0,0:26:24.08,0:26:27.33,Default,,0,0,0,,Мен Еуразияға бірнеше ұсыныс жасадым.
Dialogue: 0,0:26:27.41,0:26:30.79,Default,,0,0,0,,Жауап беру үшін біраз уақыт қажет сияқты.
Dialogue: 0,0:26:30.88,0:26:32.50,Default,,0,0,0,,Бұл туралы ештеңе істей алмаймыз.
Dialogue: 0,0:26:32.59,0:26:36.38,Default,,0,0,0,,Оларда ел ішінде көптеген өрт көздері бар.
Dialogue: 0,0:26:36.84,0:26:38.80,Default,,0,0,0,,Мен мырзаларға ризамын.
Dialogue: 0,0:26:38.88,0:26:41.72,Default,,0,0,0,,Халқымызды қорғай гөр.
Dialogue: 0,0:26:42.30,0:26:44.39,Default,,0,0,0,,Сенің сөздерің мен үшін тым көп.
Dialogue: 0,0:26:45.02,0:26:47.14,Default,,0,0,0,,Біз бар күшімізді саламыз
Dialogue: 0,0:26:47.23,0:26:51.40,Default,,0,0,0,,Мен шағын сөйлесу үшін үстел дайындадым.
Dialogue: 0,0:26:52.27,0:26:56.40,Default,,0,0,0,,Сондықтан уақытыңызды бөліп, өз оқиғаңызды айтып беріңізші.
Dialogue: 0,0:26:59.03,0:27:00.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:27:07.16,0:27:08.91,Default,,0,0,0,,(Қылыштардың соқтығысуы)
Dialogue: 0,0:27:09.87,0:27:11.96,Default,,0,0,0,,Иә! Хмм!
Dialogue: 0,0:27:13.84,0:27:16.38,Default,,0,0,0,,Олар біздің гвардиялық дивизиямыз.
Dialogue: 0,0:27:16.46,0:27:20.72,Default,,0,0,0,,Сыбыс тараған Қара рыцарьлар...
Dialogue: 0,0:27:20.80,0:27:23.09,Default,,0,0,0,,Иә! Хмм...
Dialogue: 0,0:27:23.93,0:27:26.39,Default,,0,0,0,,Иә! Хмм!
Dialogue: 0,0:27:26.47,0:27:27.81,Default,,0,0,0,,Ннн!
Dialogue: 0,0:27:27.89,0:27:29.48,Default,,0,0,0,,Ах…
Dialogue: 0,0:27:31.23,0:27:34.27,Default,,0,0,0,,Аға, Шураны жеңе алмайсың.
Dialogue: 0,0:27:34.36,0:27:36.57,Default,,0,0,0,,Маған нұсқау бере аласыз ба?
Dialogue: 0,0:27:36.65,0:27:37.61,Default,,0,0,0,,Капитан Ямато
Dialogue: 0,0:27:37.69,0:27:40.49,Default,,0,0,0,,- (Шин Лунамария) Иә! ? -Жоқ, мен...
Dialogue: 0,0:27:40.57,0:27:44.12,Default,,0,0,0,,Әй, қылыш ұстай алмайтын капитан ше?
Dialogue: 0,0:27:44.20,0:27:48.04,Default,,0,0,0,,Компас соншалықты үлкен мәміле емес пе?
Dialogue: 0,0:27:48.12,0:27:50.66,Default,,0,0,0,,Мен мұны өткен күні көрсеттім.
Dialogue: 0,0:27:50.75,0:27:53.00,Default,,0,0,0,,Қонақтарды кешіріңіз!
Dialogue: 0,0:27:53.08,0:27:56.50,Default,,0,0,0,,Қарғыс атсын... Капитан, мен келдім!
Dialogue: 0,0:27:56.59,0:27:57.88,Default,,0,0,0,,Шин!
Dialogue: 0,0:27:57.96,0:28:00.30,Default,,0,0,0,,-Мен жасап көрейін -Иә?
Dialogue: 0,0:28:01.22,0:28:04.55,Default,,0,0,0,,Қарауыл дивизиясының командирі Шура Серпентин
Dialogue: 0,0:28:04.64,0:28:06.30,Default,,0,0,0,,Ямато отрядынан Шин Асука!
Dialogue: 0,0:28:06.39,0:28:08.97,Default,,0,0,0,,- Ха! -Нх!
Dialogue: 0,0:28:09.89,0:28:12.52,Default,,0,0,0,,(Шиннің күш дауысы)
Dialogue: 0,0:28:12.60,0:28:14.19,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:28:14.27,0:28:15.98,Default,,0,0,0,,(Шиннің күш дауысы)
Dialogue: 0,0:28:18.07,0:28:19.57,Default,,0,0,0,,Шин…
Dialogue: 0,0:28:19.65,0:28:21.90,Default,,0,0,0,,Ха! Хмм!
Dialogue: 0,0:28:23.28,0:28:24.32,Default,,0,0,0,,Ха…
Dialogue: 0,0:28:25.74,0:28:27.74,Default,,0,0,0,,- Ха! -Аа...
Dialogue: 0,0:28:27.83,0:28:28.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:28:28.99,0:28:30.08,Default,,0,0,0,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:28:30.16,0:28:31.50,Default,,0,0,0,,-(Ридерард) Хью~ -(Рю) Фу...
Dialogue: 0,0:28:33.16,0:28:35.00,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:28:35.63,0:28:36.67,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:28:36.75,0:28:38.59,Default,,0,0,0,,Бостандық өлтірушісі де маңызды емес.
Dialogue: 0,0:28:38.67,0:28:42.51,Default,,0,0,0,,Оның болғаны жақсы емес пе? Ахахха!
Dialogue: 0,0:28:42.59,0:28:45.01,Default,,0,0,0,,Атрун Зара ең мықты ма?
Dialogue: 0,0:28:45.09,0:28:46.68,Default,,0,0,0,,Ха! ? Кім ондай...
Dialogue: 0,0:28:46.76,0:28:48.68,Default,,0,0,0,,Тоқта, Шин!
Dialogue: 0,0:28:48.76,0:28:50.35,Default,,0,0,0,,Хмм...
Dialogue: 0,0:28:50.43,0:28:51.81,Default,,0,0,0,,Серпентин командирі
Dialogue: 0,0:28:51.89,0:28:53.02,Default,,0,0,0,,Сақ болыңыз!
Dialogue: 0,0:28:53.48,0:28:57.02,Default,,0,0,0,,Әлемді тек күштілер билей алады.
Dialogue: 0,0:28:57.11,0:28:58.82,Default,,0,0,0,,Сізде мұндай күш бар ма?
Dialogue: 0,0:28:58.90,0:29:00.40,Default,,0,0,0,,Ха…
Dialogue: 0,0:29:00.48,0:29:03.19,Default,,0,0,0,,Мұндай дүниені ешкім қаламайды!
Dialogue: 0,0:29:03.28,0:29:05.36,Default,,0,0,0,,Иә... Менің ойымша?
Dialogue: 0,0:29:06.41,0:29:08.91,Default,,0,0,0,,Мен сенің қолбасшылығыңмен соғысуды асыға күтемін.
Dialogue: 0,0:29:09.78,0:29:12.33,Default,,0,0,0,,Сіз шынымен аяныштысыз.
Dialogue: 0,0:29:12.41,0:29:14.54,Default,,0,0,0,,Егер осындай жағдай болса, мен шығуым керек еді.
Dialogue: 0,0:29:14.62,0:29:16.62,Default,,0,0,0,,Тоқта, Агнес.
Dialogue: 0,0:29:16.71,0:29:18.67,Default,,0,0,0,,Агнес Гибенрат?
Dialogue: 0,0:29:19.25,0:29:20.96,Default,,0,0,0,,«Ай сәулесі Валькирия»?
Dialogue: 0,0:29:21.05,0:29:22.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:22.21,0:29:23.59,Default,,0,0,0,,Иә...
Dialogue: 0,0:29:25.72,0:29:28.22,Default,,0,0,0,,Күштілер әдемі
Dialogue: 0,0:29:28.30,0:29:30.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:29:32.39,0:29:38.73,Default,,0,0,0,,♪
Dialogue: 0,0:29:39.65,0:29:43.74,Default,,0,0,0,,Мен сіздің еліңіздің гүлденгенін біраздан бері естідім.
Dialogue: 0,0:29:44.24,0:29:47.11,Default,,0,0,0,,Біздің елде жасына және шыққан тегіне қарамастан,
Dialogue: 0,0:29:47.20,0:29:49.91,Default,,0,0,0,,Үздік қызметкерлерді жалдау
Dialogue: 0,0:29:49.99,0:29:53.29,Default,,0,0,0,,Табиғи координаторлармен араласпау
Dialogue: 0,0:29:53.37,0:29:55.66,Default,,0,0,0,,Барлығын Орфей ұйымдастырған.
Dialogue: 0,0:29:57.12,0:29:59.33,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:29:59.42,0:30:02.80,Default,,0,0,0,,Маған бір ән беріңізші, ханшайым?
Dialogue: 0,0:30:04.80,0:30:06.09,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,0:30:06.63,0:30:07.97,Default,,0,0,0,,Қуанышпен
Dialogue: 0,0:30:43.75,0:30:44.84,Default,,0,0,0,,Шикаши —
Dialogue: 0,0:30:44.92,0:30:48.22,Default,,0,0,0,,Бұл кішкентай бала мен қыз сол Қара рыцарлармен бірдей.
Dialogue: 0,0:30:48.30,0:30:50.13,Default,,0,0,0,,Бұл не? Сол жігіттер
Dialogue: 0,0:30:50.22,0:30:52.51,Default,,0,0,0,,Сіз үйлестіруші емессіз бе?
Dialogue: 0,0:30:52.60,0:30:54.60,Default,,0,0,0,,Менің ойымша, бірақ...
Dialogue: 0,0:30:54.68,0:30:56.52,Default,,0,0,0,,Иә? бірдеңе?
Dialogue: 0,0:30:57.10,0:30:59.94,Default,,0,0,0,,Бұл дұрыс әскерге ұқсамайды.
Dialogue: 0,0:31:01.60,0:31:03.65,Default,,0,0,0,,Би билегің келе ме? капитан
Dialogue: 0,0:31:04.23,0:31:06.99,Default,,0,0,0,,Біз мұнда ойнау үшін келген жоқпыз.
Dialogue: 0,0:31:07.07,0:31:08.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:31:08.19,0:31:09.82,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:31:10.74,0:31:14.70,Default,,0,0,0,,Жарайды, мен капитанмен араласып кетейін.
Dialogue: 0,0:31:14.78,0:31:16.74,Default,,0,0,0,,Неліктен? Бірдеңе дұрыс емес пе?
Dialogue: 0,0:31:17.16,0:31:20.42,Default,,0,0,0,,Мені шынымен ұнатасың ба? Сол адам
Dialogue: 0,0:31:21.00,0:31:24.46,Default,,0,0,0,,Мен орынды жерде ымыраға келуге дайын емеспін.
Dialogue: 0,0:31:24.88,0:31:26.50,Default,,0,0,0,,Сізге ұқсамайды
Dialogue: 0,0:31:26.59,0:31:27.76,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:31:27.84,0:31:30.43,Default,,0,0,0,,Ештеңе! Жүр, кеттік.
Dialogue: 0,0:31:30.51,0:31:31.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:31:39.98,0:31:41.35,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:31:41.73,0:31:42.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:31:51.15,0:31:53.41,Default,,0,0,0,,Сондай әдемі гүлдер...
Dialogue: 0,0:31:53.49,0:31:56.16,Default,,0,0,0,,Сенің көзіңе көрінбейтін сияқты.
Dialogue: 0,0:31:56.24,0:31:57.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:31:57.66,0:31:58.70,Default,,0,0,0,,Ха…
Dialogue: 0,0:31:58.79,0:32:02.12,Default,,0,0,0,,Өтінемін, сіз үшін гүлдеді.
Dialogue: 0,0:32:02.21,0:32:05.29,Default,,0,0,0,,Хехе... Рахмет
Dialogue: 0,0:32:05.38,0:32:07.05,Default,,0,0,0,,Бұл өте әдемі.
Dialogue: 0,0:32:07.13,0:32:10.38,Default,,0,0,0,,Жақсы, ұнамаса...
Dialogue: 0,0:32:10.47,0:32:13.47,Default,,0,0,0,,Раушан гүлдердің бәрі түңіліп, қурап қала жаздады.
Dialogue: 0,0:32:13.55,0:32:14.93,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:32:15.85,0:32:16.89,Default,,0,0,0,,Бірақ мұндағы олардың ойып жазғандары ұзақ уақыттан бері ұмыт қалды, және мұнда енді дұғалар айтылмайды.
Dialogue: 0,0:32:18.72,0:32:20.81,Default,,0,0,0,,Сізге күлімсіреу жарасады ғой
Dialogue: 0,0:32:20.89,0:32:22.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:32:22.31,0:32:25.06,Default,,0,0,0,,Мен сіздің уайымыңызды түсінемін.
Dialogue: 0,0:32:25.15,0:32:26.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:32:26.27,0:32:28.07,Default,,0,0,0,,Бұл бәріне бірдей емес пе?
Dialogue: 0,0:32:28.15,0:32:32.40,Default,,0,0,0,,Қазіргі уақытта өмір сүретіндер және болашаққа жол іздейтіндер
Dialogue: 0,0:32:32.49,0:32:33.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:32:33.66,0:32:36.12,Default,,0,0,0,,Адамдар ұрысқысы келмейді
Dialogue: 0,0:32:36.20,0:32:37.74,Default,,0,0,0,,Бірақ екінші жағынан -
Dialogue: 0,0:32:37.83,0:32:39.41,Default,,0,0,0,,Қақтығыстар жойылмайды
Dialogue: 0,0:32:39.49,0:32:41.20,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,0:32:41.29,0:32:43.00,Default,,0,0,0,,Үйлестіруші және табиғи —
Dialogue: 0,0:32:43.08,0:32:45.00,Default,,0,0,0,,Біз бірдей адамдармыз.
Dialogue: 0,0:32:45.08,0:32:47.42,Default,,0,0,0,,-Ха... -Өкінішті.
Dialogue: 0,0:32:47.50,0:32:50.92,Default,,0,0,0,,Адамдар мұндай ұсақ-түйек нәрселерді ұрысуға себеп ретінде пайдаланады.
Dialogue: 0,0:32:51.42,0:32:52.59,Default,,0,0,0,,Иә...
Dialogue: 0,0:32:52.67,0:32:54.34,Default,,0,0,0,,Бірақ менің ойымша, бұл.
Dialogue: 0,0:32:54.80,0:32:57.30,Default,,0,0,0,,Маңыздысы болмашы айырмашылықтар емес —
Dialogue: 0,0:32:57.39,0:33:00.06,Default,,0,0,0,,Мәселе шын мәнінде әділ емес қоғам емес пе?
Dialogue: 0,0:33:00.60,0:33:01.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:33:01.72,0:33:04.94,Default,,0,0,0,,Қазір бәрі соғыстың көлеңкесін көтеріп жүр.
Dialogue: 0,0:33:05.02,0:33:08.11,Default,,0,0,0,,Шағымдар мен наразылықтар мұндай кезде ұсқынсыз формада болады.
Dialogue: 0,0:33:08.19,0:33:09.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:33:09.61,0:33:11.90,Default,,0,0,0,,Өйткені байлықты бөлу әділетсіз
Dialogue: 0,0:33:11.99,0:33:14.03,Default,,0,0,0,,Өйткені өмірдің салмағы бөлек
Dialogue: 0,0:33:14.11,0:33:16.57,Default,,0,0,0,,Өйткені біз адамдарды лайықты бағалайтын қоғам емеспіз.
Dialogue: 0,0:33:16.66,0:33:18.99,Default,,0,0,0,,Сондықтан да адамдар ұрысады.
Dialogue: 0,0:33:19.08,0:33:21.87,Default,,0,0,0,,Барлығы біреуге керек қоғам
Dialogue: 0,0:33:21.95,0:33:24.66,Default,,0,0,0,,Егер біз әділ және тең қоғамды ұсына алсақ —
Dialogue: 0,0:33:24.75,0:33:27.04,Default,,0,0,0,,Координаторлар мен натуралдар арасындағы айырмашылықтарды жою—
Dialogue: 0,0:33:27.13,0:33:30.13,Default,,0,0,0,,Әлем сөзсіз жақсырақ бағытта келе жатыр...
Dialogue: 0,0:33:30.21,0:33:31.59,Default,,0,0,0,,Менің ойымша
Dialogue: 0,0:33:32.46,0:33:34.72,Default,,0,0,0,,Керемет идея!
Dialogue: 0,0:33:35.01,0:33:37.26,Default,,0,0,0,,Бұл шынымен де болуы мүмкін.
Dialogue: 0,0:33:37.34,0:33:39.55,Default,,0,0,0,,Ханшайымға осылай айта алсаң...
Dialogue: 0,0:33:39.64,0:33:42.52,Default,,0,0,0,,Мен әкімшілікке жауапты адам ретінде өзімді сенімдірек сезінемін.
Dialogue: 0,0:33:43.27,0:33:44.60,Default,,0,0,0,,Ха…
Dialogue: 0,0:33:44.68,0:33:48.40,Default,,0,0,0,,Мен кедейлік пен кемсітушіліксіз әлем құрғым келеді.
Dialogue: 0,0:33:49.15,0:33:51.19,Default,,0,0,0,,Сондықтан мен дүниеге келдім
Dialogue: 0,0:33:52.73,0:33:54.36,Default,,0,0,0,,Ал сен...
Dialogue: 0,0:33:55.61,0:33:57.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:33:59.53,0:34:00.99,Default,,0,0,0,,Ха…
Dialogue: 0,0:34:01.66,0:34:03.87,Default,,0,0,0,,Кешіріңіз, Орфей мырза.
Dialogue: 0,0:34:03.95,0:34:06.96,Default,,0,0,0,,Сапардан біраз шаршаған сияқтымын.
Dialogue: 0,0:34:07.04,0:34:09.50,Default,,0,0,0,,Бұл үшін кешірім сұраймын.
Dialogue: 0,0:34:09.58,0:34:13.34,Default,,0,0,0,,Бүгінгі қонақжайлылықтарыңыз үшін көп рахмет.
Dialogue: 0,0:34:15.67,0:34:16.97,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:34:19.64,0:34:21.89,Default,,0,0,0,,Мен саған түскі ас әкелдім.
Dialogue: 0,0:34:21.97,0:34:24.31,Default,,0,0,0,,Рахмет, сол жерде қалдырыңыз.
Dialogue: 0,0:34:26.81,0:34:29.15,Default,,0,0,0,,Ннн…
Dialogue: 0,0:34:29.23,0:34:30.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:34:30.65,0:34:32.69,Default,,0,0,0,,Иә?не?
Dialogue: 0,0:34:32.77,0:34:35.57,Default,,0,0,0,,Мен капитанды аяймын...
Dialogue: 0,0:34:36.03,0:34:39.74,Default,,0,0,0,,Ол кісі жұрттың көзінше басқа жігіттермен билеп жүрді.
Dialogue: 0,0:34:39.82,0:34:43.16,Default,,0,0,0,,Капитан қауіпті ұрыс алаңына бет алмақшы...
Dialogue: 0,0:34:43.24,0:34:46.54,Default,,0,0,0,,Бұл екеуінің жұмысы.
Dialogue: 0,0:34:46.62,0:34:48.54,Default,,0,0,0,,Неге ашуланбайсың? ?
Dialogue: 0,0:34:48.62,0:34:52.04,Default,,0,0,0,,Ол адам капитанның мейірімділігін пайдаланып отыр.
Dialogue: 0,0:34:52.13,0:34:53.17,Default,,0,0,0,,Хмм...
Dialogue: 0,0:34:54.42,0:34:58.13,Default,,0,0,0,,Маған қара! Сіз ол адамды қайтып көргіңіз келеді, солай ма?
Dialogue: 0,0:34:58.22,0:34:59.55,Default,,0,0,0,,Не айтпақсың…
Dialogue: 0,0:35:00.05,0:35:03.01,Default,,0,0,0,,Сіз нені айтасыз? ? сен
Dialogue: 0,0:35:03.89,0:35:06.31,Default,,0,0,0,,Неліктен саған мұндай адам ұнайды?
Dialogue: 0,0:35:06.39,0:35:10.23,Default,,0,0,0,,Мен жақсы көретін адамды шайқасқа жібермес едім...
Dialogue: 0,0:35:10.31,0:35:12.81,Default,,0,0,0,,Мен қауіпсіз жердемін және жай ғана қарап тұрмын
Dialogue: 0,0:35:12.90,0:35:14.15,Default,,0,0,0,,Менің айтқым келгені бұл емес!
Dialogue: 0,0:35:14.23,0:35:15.32,Default,,0,0,0,,Ха…
Dialogue: 0,0:35:15.40,0:35:17.07,Default,,0,0,0,,Сіз ештеңе түсінбейсіз!
Dialogue: 0,0:35:17.15,0:35:19.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:35:19.24,0:35:20.49,Default,,0,0,0,,Иә!
Dialogue: 0,0:35:20.57,0:35:22.91,Default,,0,0,0,,Хмм... Иә?
Dialogue: 0,0:35:25.16,0:35:27.08,Default,,0,0,0,,Ах, ах…
Dialogue: 0,0:35:35.92,0:35:37.63,Default,,0,0,0,,Дао... Жоғары мәртебелі
Dialogue: 0,0:35:37.71,0:35:39.59,Default,,0,0,0,,Бұл жақсы ай
Dialogue: 0,0:35:39.67,0:35:43.55,Default,,0,0,0,,Қараңғыда да тыныштық әкелетін ең жоғарғы нұр
Dialogue: 0,0:35:44.55,0:35:45.97,Default,,0,0,0,,Сіз олай ойламайсыз ба?
Dialogue: 0,0:35:46.06,0:35:48.14,Default,,0,0,0,,Кешіріңіз, кездескенше...
Dialogue: 0,0:35:48.22,0:35:50.94,Default,,0,0,0,,Сіз оны қудалай аласыз ба?
Dialogue: 0,0:35:51.02,0:35:52.06,Default,,0,0,0,,А...
Dialogue: 0,0:35:52.15,0:35:55.11,Default,,0,0,0,,Кешіріңіз, бірақ сіз оған лайық емессіз.
Dialogue: 0,0:35:55.19,0:35:56.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:35:56.19,0:35:59.03,Default,,0,0,0,,Жою, жек көрушілік және өлім
Dialogue: 0,0:35:59.11,0:36:02.70,Default,,0,0,0,,Бұл сіз шығаратын нәрсе емес пе?
Dialogue: 0,0:36:02.78,0:36:04.12,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:36:07.45,0:36:11.29,Default,,0,0,0,,Төраға Дурандалды жеңіп, дүниеден не алдың?
Dialogue: 0,0:36:12.08,0:36:15.21,Default,,0,0,0,,Дау-дамайсыз Бейбітшілік қоғамына тапсырыс беріңіз
Dialogue: 0,0:36:15.29,0:36:20.13,Default,,0,0,0,,Сіздің еңбегіңіз адамдардың жоғалтқанына тұрарлық деп айта аласыз ба?
Dialogue: 0,0:36:20.21,0:36:21.67,Default,,0,0,0,,(Присцилла) Сол тәрбиесіз шлюхаға—
Dialogue: 0,0:36:21.76,0:36:23.80,Default,,0,0,0,,Тағдыр жоспарымен ұсынылған әлем -
Dialogue: 0,0:36:23.89,0:36:25.97,Default,,0,0,0,,Артқа жол жоқ
Dialogue: 0,0:36:26.05,0:36:27.60,Default,,0,0,0,,Сіз де мұны білесіз, солай ма?
Dialogue: 0,0:36:28.01,0:36:29.89,Default,,0,0,0,,Мен әркім шешкенін қалаймын.
Dialogue: 0,0:36:29.97,0:36:32.94,Default,,0,0,0,,Сіз не істей аласыз Қалағаныңызды
Dialogue: 0,0:36:33.02,0:36:35.98,Default,,0,0,0,,Ол сондай әлемге жол сілтейтін нұр.
Dialogue: 0,0:36:36.06,0:36:40.28,Default,,0,0,0,,Оның қасында да әлемді басқаратын адам тұр.
Dialogue: 0,0:36:40.36,0:36:41.36,Default,,0,0,0,,Хмм...
Dialogue: 0,0:36:41.44,0:36:43.03,Default,,0,0,0,,Мен мұны істей аламын
Dialogue: 0,0:36:43.11,0:36:43.99,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:36:44.07,0:36:47.49,Default,,0,0,0,,Ол қалаған әлем, ұрыс тізбегі жоқ
Dialogue: 0,0:36:47.58,0:36:51.04,Default,,0,0,0,,Мен тұрақтылық пен келісім әлемін жасай аламын!
Dialogue: 0,0:36:51.79,0:36:52.87,Default,,0,0,0,,Осындай бірдеңе...
Dialogue: 0,0:36:52.96,0:36:57.42,Default,,0,0,0,,Сіз мұны істей алмайсыз. Сіздің қолыңыздан келгеннің бәрі күресу.
Dialogue: 0,0:36:57.50,0:36:59.46,Default,,0,0,0,,Өзі ешқашан Ал Майтты басып оза алмайтынын түсінген әкем—
Dialogue: 0,0:36:59.55,0:37:03.88,Default,,0,0,0,,Олай болса, тыныштық келгенде не істейсің?
Dialogue: 0,0:37:03.97,0:37:07.26,Default,,0,0,0,,Қанды қолыңызбен оның қолын алуға ниетіңіз бар ма?
Dialogue: 0,0:37:07.35,0:37:08.18,Default,,0,0,0,,Ха…
Dialogue: 0,0:37:17.02,0:37:19.32,Default,,0,0,0,,Ха... бұл кім! ?
Dialogue: 0,0:37:19.40,0:37:21.65,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:37:21.73,0:37:26.82,Default,,0,0,0,,Сәлем! Мен әдемі емеспін бе? Тартымды емес пе?
Dialogue: 0,0:37:26.91,0:37:29.28,Default,,0,0,0,,Неліктен бұл мен болуы мүмкін емес?
Dialogue: 0,0:37:30.08,0:37:34.41,Default,,0,0,0,,Сіз әдемі Ай сәулесі Валькирисіз
Dialogue: 0,0:37:35.75,0:37:39.50,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:37:43.42,0:37:44.59,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:37:48.01,0:37:50.18,Default,,0,0,0,,Шиннің ақымақ жігіті...
Dialogue: 0,0:37:57.19,0:37:58.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:38:00.77,0:38:02.73,Default,,0,0,0,,Ұйықтай алмайсыз ба?
Dialogue: 0,0:38:02.82,0:38:03.86,Default,,0,0,0,,Мәртебелі Орфей
Dialogue: 0,0:38:03.94,0:38:09.20,Default,,0,0,0,,Мені айдың көлеңкесіндей елестетіп көріңізші.
Dialogue: 0,0:38:12.79,0:38:16.62,Default,,0,0,0,,Мұның бәрі қалай аяқталуы мүмкін?
Dialogue: 0,0:38:16.71,0:38:17.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:38:17.87,0:38:21.54,Default,,0,0,0,,Ешкімнің бір-бірімен төбелесіп, тату-тәтті өмір сүруі мүмкін.
Dialogue: 0,0:38:21.63,0:38:24.42,Default,,0,0,0,,Неліктен қиын?
Dialogue: 0,0:38:25.55,0:38:27.38,Default,,0,0,0,,Ха…
Dialogue: 0,0:38:27.47,0:38:30.55,Default,,0,0,0,,Біз оны аяқтай аламыз.
Dialogue: 0,0:38:33.56,0:38:34.89,Default,,0,0,0,,Ха…
Dialogue: 0,0:38:35.31,0:38:38.48,Default,,0,0,0,,Мен сізге көмектесу үшін келдім
Dialogue: 0,0:38:38.56,0:38:40.40,Default,,0,0,0,,Дәл осы мақсат үшін
Dialogue: 0,0:38:41.15,0:38:44.23,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:38:44.32,0:38:46.69,Default,,0,0,0,,Мен Орфей Лам Таомын.
Dialogue: 0,0:38:46.78,0:38:51.28,Default,,0,0,0,,Сізбен серіктес болып, осы әлемге тыныштық орната алатын адам.
Dialogue: 0,0:38:51.37,0:38:52.95,Default,,0,0,0,,Ха…
Dialogue: 0,0:38:57.29,0:38:59.87,Default,,0,0,0,,Солай ма? Бірақ...
Dialogue: 0,0:38:59.96,0:39:03.25,Default,,0,0,0,,Мен сол үшін дүниеге келдім
Dialogue: 0,0:39:03.34,0:39:05.55,Default,,0,0,0,,Берілген тапсырманы орындау
Dialogue: 0,0:39:05.63,0:39:08.47,Default,,0,0,0,,Сіз де
Dialogue: 0,0:39:12.64,0:39:13.80,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,0:39:16.27,0:39:18.23,Default,,0,0,0,,Майро балалары
Dialogue: 0,0:39:19.27,0:39:20.64,Default,,0,0,0,,Жаңа болашаққа
Dialogue: 0,0:39:21.40,0:39:23.56,Default,,0,0,0,,Сіздің тағдырыңыз бойынша
Dialogue: 0,0:39:24.27,0:39:27.44,Default,,0,0,0,,Бәрі басынан шешілді.
Dialogue: 0,0:39:28.44,0:39:31.16,Default,,0,0,0,,Әлем сізді күтуде.
Dialogue: 0,0:39:31.66,0:39:33.12,Default,,0,0,0,,Біздің еліміз түсінеді
Dialogue: 0,0:39:33.20,0:39:35.83,Default,,0,0,0,,Көк ғарыш партизанының мәліметтері
Dialogue: 0,0:39:35.91,0:39:38.83,Default,,0,0,0,,Майкл Эльдор бекінісінің қирандыларын басып жатыр.
Dialogue: 0,0:39:38.91,0:39:40.25,Default,,0,0,0,,Жер асты туннелі арқылы —
Dialogue: 0,0:39:40.33,0:39:43.50,Default,,0,0,0,,Еуразия аумағына кіру және одан шығу расталды.
Dialogue: 0,0:39:43.58,0:39:47.67,Default,,0,0,0,,Мүмкін Қорда да бар шығар?
Dialogue: 0,0:39:47.76,0:39:49.38,Default,,0,0,0,,Солай көрінеді.
Dialogue: 0,0:39:50.17,0:39:52.89,Default,,0,0,0,,Хмм... Сонымен, Құрылтай армиясы ше?
Dialogue: 0,0:39:52.97,0:39:57.64,Default,,0,0,0,,Азаматтарды эвакуациялау бойынша басшылыққа басымдық беру кезінде жау топтарын ұстау
Dialogue: 0,0:39:57.72,0:40:01.94,Default,,0,0,0,,Мақсат - полковник Мишельді тұтқындау және ұстау.
Dialogue: 0,0:40:02.02,0:40:04.73,Default,,0,0,0,,Көк Космос жауынгерлері берілуге ​​шақырылады.
Dialogue: 0,0:40:04.81,0:40:07.07,Default,,0,0,0,,Адам өмірінің ең аз шығыны
Dialogue: 0,0:40:07.15,0:40:09.99,Default,,0,0,0,,Алдыңғы қатардағы команданы Архангел береді.
Dialogue: 0,0:40:10.07,0:40:11.49,Default,,0,0,0,,Көк ғарыш –
Dialogue: 0,0:40:11.57,0:40:13.49,Default,,0,0,0,,Елімізге бір қадам да баспа.
Dialogue: 0,0:40:13.57,0:40:16.20,Default,,0,0,0,,...Бірақ бұл компасқа да қатысты.
Dialogue: 0,0:40:16.28,0:40:17.91,Default,,0,0,0,,Кіру тек Эльдор аймағымен шектеледі.
Dialogue: 0,0:40:17.99,0:40:19.66,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:40:20.16,0:40:25.50,Default,,0,0,0,,Әскери шекара сызығын кесіп өту басып кіру актісі болып саналады және дереу шабуылға ұшырайды.
Dialogue: 0,0:40:25.58,0:40:29.26,Default,,0,0,0,,Бұл компас болсын, іргетас болсын.
Dialogue: 0,0:40:31.76,0:40:34.30,Default,,0,0,0,,Жылу көзіне жақындау 30-дан жоғары!
Dialogue: 0,0:40:34.39,0:40:38.01,Default,,0,0,0,,Хелдарт Вомбат Эгельстернді ұстап алу басталды!
Dialogue: 0,0:40:38.10,0:40:39.93,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:40:40.02,0:40:42.85,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:40:42.94,0:40:45.19,Default,,0,0,0,,Шин Агнес Хильда —
Dialogue: 0,0:40:45.27,0:40:47.27,Default,,0,0,0,,Қарсыластың мобильді костюмдерін залалсыздандыру
Dialogue: 0,0:40:47.36,0:40:49.61,Default,,0,0,0,,Бұл Мишельдің командалық пунктіне бара жатыр.
Dialogue: 0,0:40:49.69,0:40:50.82,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:41:03.96,0:41:06.79,Default,,0,0,0,,Шикишима тобы әділет Гьянды қолдайды.
Dialogue: 0,0:41:06.88,0:41:08.46,Default,,0,0,0,,Махороба отряды, менің артымнан жүр!
Dialogue: 0,0:41:12.01,0:41:13.38,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:41:19.01,0:41:21.27,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:41:23.68,0:41:25.69,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:41:28.94,0:41:30.44,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:41:31.86,0:41:33.19,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:41:39.99,0:41:41.04,Default,,0,0,0,,Артқа шегін!
Dialogue: 0,0:41:42.16,0:41:44.21,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:41:47.21,0:41:48.96,Default,,0,0,0,,Әлі де солай!
Dialogue: 0,0:41:50.46,0:41:52.05,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:41:52.13,0:41:54.97,Default,,0,0,0,,（）
Dialogue: 0,0:41:55.05,0:41:57.89,Default,,0,0,0,,Маған көмектес! Апыр-ай!
Dialogue: 0,0:41:57.97,0:41:59.80,Default,,0,0,0,,(Тұрғындардың шуы)
Dialogue: 0,0:42:00.72,0:42:01.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:42:04.06,0:42:06.35,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:42:06.44,0:42:07.69,Default,,0,0,0,,Дұрыс, болды!
Dialogue: 0,0:42:07.77,0:42:10.61,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:42:11.48,0:42:12.53,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:42:12.61,0:42:14.69,Default,,0,0,0,,Қандай жексұрын!
Dialogue: 0,0:42:16.70,0:42:19.11,Default,,0,0,0,,Машиналар мен жаяу әскерлер, артқа шығыңыз!
Dialogue: 0,0:42:19.20,0:42:21.03,Default,,0,0,0,,Сіз қалай батылсыз
Dialogue: 0,0:42:21.12,0:42:22.20,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:42:23.62,0:42:25.00,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:42:28.54,0:42:30.71,Default,,0,0,0,,Бұл!
Dialogue: 0,0:42:42.43,0:42:43.97,Default,,0,0,0,,Ааах…
Dialogue: 0,0:42:44.64,0:42:47.73,Default,,0,0,0,,Эльдоа қаласының аймағында зардап шеккендерді мүмкіндігінше тезірек құтқарыңыз!
Dialogue: 0,0:42:47.81,0:42:49.27,Default,,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,0:42:50.35,0:42:51.98,Default,,0,0,0,,Yamuwoen
Dialogue: 0,0:42:52.06,0:42:55.73,Default,,0,0,0,,Құтқару жұмыстарына тек Eldoor аймағында ғана рұқсат етіледі.
Dialogue: 0,0:42:55.82,0:42:56.86,Default,,0,0,0,,Фу…
Dialogue: 0,0:42:57.49,0:42:58.53,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:43:05.45,0:43:07.91,Default,,0,0,0,,Операция іске қосылды
Dialogue: 0,0:43:08.00,0:43:09.71,Default,,0,0,0,,Әй, мұны маған қалдырыңыз.
Dialogue: 0,0:43:09.79,0:43:10.83,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:43:10.92,0:43:12.71,Default,,0,0,0,,Олардың бәрін өлтіріңіз!
Dialogue: 0,0:43:20.84,0:43:23.55,Default,,0,0,0,,Қараңғылыққа түсу Кира Ямато
Dialogue: 0,0:43:24.43,0:43:25.47,Default,,0,0,0,,Уф…
Dialogue: 0,0:43:25.97,0:43:27.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:43:29.98,0:43:31.73,Default,,0,0,0,,Ннн…
Dialogue: 0,0:43:35.23,0:43:36.69,Default,,0,0,0,,Ха…
Dialogue: 0,0:43:46.54,0:43:48.37,Default,,0,0,0,,-Капитан? -Иә?
Dialogue: 0,0:43:57.71,0:43:59.05,Default,,0,0,0,,Мишель?
Dialogue: 0,0:44:01.55,0:44:02.38,Default,,0,0,0,,Фу…
Dialogue: 0,0:44:02.47,0:44:03.80,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:44:08.35,0:44:09.39,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:44:09.48,0:44:10.89,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:44:12.35,0:44:13.44,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:44:13.52,0:44:15.86,Default,,0,0,0,,Капитан, не болды?
Dialogue: 0,0:44:15.94,0:44:18.53,Default,,0,0,0,,Мишель Шин қолдауын қамтамасыз етіңіз!
Dialogue: 0,0:44:18.61,0:44:20.69,Default,,0,0,0,,Иә? Өйткені...
Dialogue: 0,0:44:20.78,0:44:22.11,Default,,0,0,0,,Ол қашып кетті!
Dialogue: 0,0:44:23.86,0:44:27.37,Default,,0,0,0,,Не болды! ? Кира, сен шекараға жақындап қалдың. Сен не істеп жатырсың?
Dialogue: 0,0:44:27.45,0:44:30.29,Default,,0,0,0,,Капитан Ямато ұшағы 105 Чарлиге ауыстырылды
Dialogue: 0,0:44:30.37,0:44:32.75,Default,,0,0,0,,Еуразия аумағына бару
Dialogue: 0,0:44:32.83,0:44:34.21,Default,,0,0,0,,Бұл не? ?
Dialogue: 0,0:44:35.29,0:44:37.42,Default,,0,0,0,,Не болды... Капитан Ямато!
Dialogue: 0,0:44:37.50,0:44:39.71,Default,,0,0,0,,Мишельді тауып алыңыз!
Dialogue: 0,0:44:39.80,0:44:41.59,Default,,0,0,0,,Иә! ? (операция дыбысы)
Dialogue: 0,0:44:42.22,0:44:44.43,Default,,0,0,0,,Полковник Фрага, жағдайды хабарлаңыз!
Dialogue: 0,0:44:47.55,0:44:49.93,Default,,0,0,0,,Әскери демаркация сызығына жақындаған бостандық!
Dialogue: 0,0:44:50.02,0:44:53.48,Default,,0,0,0,,Сіз нені айтып тұрсыз! ? Ол алдын ала кеңес беруді білмейді ме?
Dialogue: 0,0:44:53.56,0:44:54.77,Default,,0,0,0,,Ескерту бостандығы
Dialogue: 0,0:44:54.85,0:44:57.69,Default,,0,0,0,,Сіздің ұшақ Еуразиялық федерация аумағына жақындап келеді.
Dialogue: 0,0:44:57.77,0:44:59.61,Default,,0,0,0,,Курсты дереу өзгертіңіз!
Dialogue: 0,0:44:59.69,0:45:01.65,Default,,0,0,0,,Неліктен Еуразия...
Dialogue: 0,0:45:01.74,0:45:03.36,Default,,0,0,0,,Сіз нені айтып тұрсыз! ? Президент
Dialogue: 0,0:45:03.45,0:45:05.95,Default,,0,0,0,,Бостандық Дереу оралыңыз.
Dialogue: 0,0:45:06.03,0:45:06.87,Default,,0,0,0,,Кира!
Dialogue: 0,0:45:06.95,0:45:08.28,Default,,0,0,0,,Ескерту атыстары басталады!
Dialogue: 0,0:45:08.37,0:45:09.45,Default,,0,0,0,,(Night Eye) Мен ойлағандай, «Барлығы Бір» шын мәнінде Миллиоға берілуі керек еді.
Dialogue: 0,0:45:09.54,0:45:10.87,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:45:10.95,0:45:13.46,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:45:16.67,0:45:18.25,Default,,0,0,0,,Сіз әлі де қарсы тұрасыз ба?
Dialogue: 0,0:45:18.34,0:45:19.21,Default,,0,0,0,,Қайдан бастарын білмеймін.
Dialogue: 0,0:45:19.29,0:45:21.17,Default,,0,0,0,,-Кира Тоқта! -(Мари) Жоқ, Кира-кун!
Dialogue: 0,0:45:21.26,0:45:23.09,Default,,0,0,0,,Осы жерден аяқтаңыз!
Dialogue: 0,0:45:24.84,0:45:26.39,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:45:26.47,0:45:28.80,Default,,0,0,0,,Бұл агрессияның айқын әрекеті!
Dialogue: 0,0:45:28.89,0:45:31.89,Default,,0,0,0,,Кира! Кира! Мені естімей тұрсың ба? ?
Dialogue: 0,0:45:31.97,0:45:33.31,Default,,0,0,0,,Бұл Мишель!
Dialogue: 0,0:45:33.39,0:45:35.64,Default,,0,0,0,,Біз оның мұнда қашып кетуіне жол бере алмаймыз!
Dialogue: 0,0:45:35.73,0:45:36.81,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:45:36.90,0:45:38.77,Default,,0,0,0,,Бұл біздің ниетіміз емес
Dialogue: 0,0:45:38.86,0:45:40.23,Default,,0,0,0,,Капитан Яматоның таңдауы!
Dialogue: 0,0:45:40.32,0:45:43.40,Default,,0,0,0,,Менің ойымша, ол басынан-ақ осы ниетпен компасты тартты!
Dialogue: 0,0:45:43.49,0:45:45.90,Default,,0,0,0,,Олай болса, біз де қарсы шара қолданамыз!
Dialogue: 0,0:45:45.99,0:45:47.45,Default,,0,0,0,,Бұл ханшайым!
Dialogue: 0,0:45:47.53,0:45:49.99,Default,,0,0,0,,Күте тұрыңыз! Себебі болуы керек
Dialogue: 0,0:45:50.08,0:45:51.12,Default,,0,0,0,,Капитан Ямато...
Dialogue: 0,0:45:51.62,0:45:54.79,Default,,0,0,0,,Шамасы сандырақ немесе бүлік күйінде
Dialogue: 0,0:45:54.87,0:45:55.96,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:45:56.04,0:45:58.38,Default,,0,0,0,,Өкінішке орай, қазіргі жағдай осыны көрсетеді
Dialogue: 0,0:45:59.00,0:46:03.17,Default,,0,0,0,,Егер Компас жағдайды бақылауға ала алмаса, оны бізге қалдырыңыз.
Dialogue: 0,0:46:03.92,0:46:06.76,Default,,0,0,0,,Осы уақытқа дейін барлық дипломатиялық күш-жігер нәтижесіз болады!
Dialogue: 0,0:46:06.84,0:46:09.68,Default,,0,0,0,,Адам зияны болса, арбаны аттың алдына қойған болар еді.
Dialogue: 0,0:46:09.76,0:46:11.35,Default,,0,0,0,,Бір ғана адам жабайы жүгіреді!
Dialogue: 0,0:46:12.31,0:46:13.68,Default,,0,0,0,,Лакус-сама...
Dialogue: 0,0:46:14.60,0:46:16.19,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:46:17.77,0:46:19.94,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:46:20.02,0:46:22.11,Default,,0,0,0,,Кираны тоқтатыңыз...
Dialogue: 0,0:46:22.86,0:46:24.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:46:24.19,0:46:28.41,Default,,0,0,0,,Бұл сіздің бригадалық генерал Яматого шабуыл жасауға рұқсат беріп жатқаныңызды білдіре ме?
Dialogue: 0,0:46:28.49,0:46:29.53,Default,,0,0,0,,Иә...
Dialogue: 0,0:46:29.62,0:46:30.66,Default,,0,0,0,,Люкс! ?
Dialogue: 0,0:46:30.74,0:46:31.95,Default,,0,0,0,,Күте тұрыңыз, президент Клейн!
Dialogue: 0,0:46:32.03,0:46:33.37,Default,,0,0,0,,
Dialogue: 0,0:46:33.45,0:46:36.71,Default,,0,0,0,,Күшті радио кедергі. Барлық байланыс үзілген.
Dialogue: 0,0:46:36.79,0:46:38.62,Default,,0,0,0,,NJ Dazzler жазған кептеліс
Dialogue: 0,0:46:38.71,0:46:40.13,Default,,0,0,0,,Бұл әлі практикалық қолданысқа енгізілген жоқ.
Dialogue: 0,0:46:40.21,0:46:42.04,Default,,0,0,0,,Кванттық шашырауды басқару мәселесін қалай шештіңіз? ?
Dialogue: 0,0:46:42.13,0:46:43.92,Default,,0,0,0,,Бұл Еуразия да, Көк ғарыш та емес...
Dialogue: 0,0:46:44.00,0:46:45.46,Default,,0,0,0,,Луна Мария ұшағын шұғыл ұшыру!
Dialogue: 0,0:46:46.05,0:46:48.38,Default,,0,0,0,,Снайпер мылтығы мен байланыс жіпі де!
Dialogue: 0,0:46:48.47,0:46:51.60,Default,,0,0,0,,Жарайсың, Шура, сен өзіңе тапсырма бер.
Dialogue: 0,0:46:51.68,0:46:52.72,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:46:52.80,0:46:53.97,Default,,0,0,0,,2 минутта тазалаңыз
Dialogue: 0,0:46:54.06,0:46:56.48,Default,,0,0,0,,Ахахха! Өлме!
Dialogue: 0,0:47:02.06,0:47:05.15,Default,,0,0,0,,Ха... Қара рыцарьлар! ?
Dialogue: 0,0:47:08.86,0:47:10.28,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:47:10.36,0:47:11.57,Default,,0,0,0,,Уууу…
Dialogue: 0,0:47:16.83,0:47:18.16,Default,,0,0,0,,Тоқта! неге! ?
Dialogue: 0,0:47:18.25,0:47:21.54,Default,,0,0,0,,Неліктен? айналаңызға қараңыз
Dialogue: 0,0:47:26.13,0:47:28.47,Default,,0,0,0,,Жол бер, Иджичи-сан.
Dialogue: 0,0:47:29.42,0:47:31.47,Default,,0,0,0,,«Егер ол рас болса, біз жасырын кіре алар едік» деп сен айтқан едің ғой?
Dialogue: 0,0:47:32.30,0:47:33.68,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:47:33.76,0:47:36.81,Default,,0,0,0,,Лакус ханшайымға енді сенің керегің жоқ!
Dialogue: 0,0:47:37.56,0:47:39.14,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:47:45.15,0:47:46.94,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:47:50.99,0:47:52.41,Default,,0,0,0,,Шура…
Dialogue: 0,0:47:53.07,0:47:54.66,Default,,0,0,0,,Хмм...
Dialogue: 0,0:47:57.54,0:47:59.37,Default,,0,0,0,,А... Капитан?
Dialogue: 0,0:48:02.29,0:48:03.83,Default,,0,0,0,,Шин Не болды! ?
Dialogue: 0,0:48:06.84,0:48:09.46,Default,,0,0,0,,Кедергі жасамаңыз!
Dialogue: 0,0:48:09.55,0:48:12.09,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:48:12.18,0:48:14.26,Default,,0,0,0,,Оқу қабілеті.
Dialogue: 0,0:48:14.34,0:48:18.06,Default,,0,0,0,,...
Dialogue: 0,0:48:18.14,0:48:19.73,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:48:24.35,0:48:26.11,Default,,0,0,0,,Шин! Уф...
Dialogue: 0,0:48:30.44,0:48:32.24,Default,,0,0,0,,Бұл жігіттер!
Dialogue: 0,0:48:32.32,0:48:34.82,Default,,0,0,0,,Бұл тұзақ! Архангелдің алға жылжуы
Dialogue: 0,0:48:34.91,0:48:38.16,Default,,0,0,0,,...
Dialogue: 0,0:48:38.24,0:48:41.79,Default,,0,0,0,,Сигнал бомбасын көтеріңіз Біз Кира-кунды құтқаруға бара жатырмыз!
Dialogue: 0,0:48:46.59,0:48:49.76,Default,,0,0,0,,Рұқсат коды...және
Dialogue: 0,0:48:50.17,0:48:52.26,Default,,0,0,0,,Фу…
Dialogue: 0,0:48:57.18,0:48:58.72,Default,,0,0,0,,Жылжымалы костюмге ұқсайтын жылу көзі
Dialogue: 0,0:48:58.81,0:49:00.02,Default,,0,0,0,,Қашықтық 17 000
Dialogue: 0,0:49:03.14,0:49:04.60,Default,,0,0,0,,Қара рыцарьлар?
Dialogue: 0,0:49:04.69,0:49:07.23,Default,,0,0,0,,Еуразия әскерінен әлдеқайда артта қалды.
Dialogue: 0,0:49:07.31,0:49:09.27,Default,,0,0,0,,Неге мұндай жерде...
Dialogue: 0,0:49:09.36,0:49:11.19,Default,,0,0,0,,А, көрдің бе?
Dialogue: 0,0:49:11.28,0:49:15.36,Default,,0,0,0,,Мәселе жоқ, оны да өңдеңіз.
Dialogue: 0,0:49:17.87,0:49:19.28,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:49:20.95,0:49:23.62,Default,,0,0,0,,...
Dialogue: 0,0:49:23.71,0:49:25.08,Default,,0,0,0,,Оптикалық бейне шығады!
Dialogue: 0,0:49:26.79,0:49:27.75,Default,,0,0,0,,Міне! ?
Dialogue: 0,0:49:27.83,0:49:31.67,Default,,0,0,0,,ＧＬＣＭ 72
Dialogue: 0,0:49:31.76,0:49:33.38,Default,,0,0,0,,Еуразия армиясынан!
Dialogue: 0,0:49:33.67,0:49:35.26,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:49:35.34,0:49:37.84,Default,,0,0,0,,２
Dialogue: 0,0:49:39.64,0:49:41.26,Default,,0,0,0,,-Жоқ! -Міне бітті! ?
Dialogue: 0,0:49:43.18,0:49:45.31,Default,,0,0,0,,Өз еліңізден
Dialogue: 0,0:49:45.39,0:49:49.36,Default,,0,0,0,,...
Dialogue: 0,0:49:49.44,0:49:50.27,Default,,0,0,0,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:49:50.36,0:49:51.44,Default,,0,0,0,,Мақсат қандай? ?
Dialogue: 0,0:49:51.53,0:49:52.73,Default,,0,0,0,,Міне, осы жерде.
Dialogue: 0,0:49:52.82,0:49:55.11,Default,,0,0,0,,Мыңжылдыққа төтенше хабарлама!
Dialogue: 0,0:49:55.20,0:49:57.32,Default,,0,0,0,,...
Dialogue: 0,0:49:57.41,0:49:58.41,Default,,0,0,0,,(Дабыл дыбысы)
Dialogue: 0,0:49:58.49,0:50:00.16,Default,,0,0,0,,Кеме құлыптаулы!
Dialogue: 0,0:50:02.04,0:50:03.58,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:50:03.66,0:50:05.79,Default,,0,0,0,,１ ２
Dialogue: 0,0:50:05.87,0:50:07.00,Default,,0,0,0,,Әуе шабуылына қарсы күрес
Dialogue: 0,0:50:07.08,0:50:09.71,Default,,0,0,0,,...
Dialogue: 0,0:50:09.79,0:50:11.29,Default,,0,0,0,,Зақымдануды бақылау басталады!
Dialogue: 0,0:50:11.96,0:50:14.67,Default,,0,0,0,,Кешіріңіз, мен сізді суға батыруға рұқсат етемін.
Dialogue: 0,0:50:14.76,0:50:17.59,Default,,0,0,0,,Бұл бәрібір. Бұл ауыртпалық.
Dialogue: 0,0:50:17.68,0:50:19.01,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:50:19.09,0:50:20.43,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:50:22.35,0:50:23.85,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:50:23.93,0:50:25.43,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:50:25.52,0:50:27.27,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:50:28.52,0:50:31.11,Default,,0,0,0,,...
Dialogue: 0,0:50:31.19,0:50:34.28,Default,,0,0,0,,Жылдам жақындап келе жатқан зымырандар деп есептелген көптеген жылу көздері!
Dialogue: 0,0:50:34.36,0:50:37.07,Default,,0,0,0,,Алау оқтарының шашырауы! Руль толық жылдамдықпен!
Dialogue: 0,0:50:38.41,0:50:39.74,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:50:44.54,0:50:46.08,Default,,0,0,0,,Сәуле жұмыс істемейді! ?
Dialogue: 0,0:50:46.16,0:50:48.83,Default,,0,0,0,,Бұл фемтех туралы қауесет пе?
Dialogue: 0,0:50:48.92,0:50:51.50,Default,,0,0,0,,Дұрыс. Көрсең өлесің!
Dialogue: 0,0:50:51.59,0:50:53.92,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:50:57.34,0:50:59.01,Default,,0,0,0,,Театр координаттары 020 Виски
Dialogue: 0,0:50:59.09,0:51:00.51,Default,,0,0,0,,138 қараша
Dialogue: 0,0:51:00.59,0:51:01.43,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:51:03.68,0:51:05.77,Default,,0,0,0,,Не болып жатыр, Шин...
Dialogue: 0,0:51:05.85,0:51:09.35,Default,,0,0,0,,Қате ме? Бұл қателік бола ма? Бұл ядролық қару!
Dialogue: 0,0:51:09.44,0:51:11.35,Default,,0,0,0,,Мынау қандай ақымақ...
Dialogue: 0,0:51:11.44,0:51:14.27,Default,,0,0,0,,Жоқ, бұл бақылау қабылданбайды!
Dialogue: 0,0:51:14.36,0:51:15.44,Default,,0,0,0,,Генерал-майор
Dialogue: 0,0:51:15.53,0:51:17.82,Default,,0,0,0,,Корольдік сарай қорының тікелей байланысы!
Dialogue: 0,0:51:17.90,0:51:18.95,Default,,0,0,0,,Қосылыңыз!
Dialogue: 0,0:51:20.28,0:51:21.53,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:51:22.45,0:51:24.33,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:51:26.08,0:51:29.41,Default,,0,0,0,,Барлық мүшелерді эвакуациялау Бүкіл қала бойынша шұғыл эвакуация туралы бұйрық!
Dialogue: 0,0:51:29.50,0:51:32.33,Default,,0,0,0,,Мүмкіндігінше тұрғындарды жер астына көшіру керек!
Dialogue: 0,0:51:33.79,0:51:35.00,Default,,0,0,0,,Мен сен демалыс үйін сатып аламыз дедің деп анық естідім.
Dialogue: 0,0:51:35.09,0:51:37.17,Default,,0,0,0,,-Бірақ... -Тезірек.
Dialogue: 0,0:51:46.47,0:51:48.68,Default,,0,0,0,,Көпір қақпағы Жылдам сүңгу!
Dialogue: 0,0:51:48.77,0:51:51.85,Default,,0,0,0,,Ха! Millennium Rapid вентиляциясын ашыңыз!
Dialogue: 0,0:52:04.24,0:52:05.58,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:52:13.79,0:52:15.09,Default,,0,0,0,,Хмм...
Dialogue: 0,0:52:17.05,0:52:18.38,Default,,0,0,0,,Фу…
Dialogue: 0,0:52:18.46,0:52:20.30,Default,,0,0,0,,Иә! (Экипаж шаттанады)
Dialogue: 0,0:52:23.30,0:52:24.89,Default,,0,0,0,,Екінші ату бағытын өзгертті! ?
Dialogue: 0,0:52:24.97,0:52:26.56,Default,,0,0,0,,Иә! ?
Dialogue: 0,0:52:26.64,0:52:27.72,Default,,0,0,0,,Эвакуация, Лунамария.
Dialogue: 0,0:52:27.81,0:52:29.18,Default,,0,0,0,,Сіз бұл жігітті ұра алмайсыз!
Dialogue: 0,0:52:29.93,0:52:32.14,Default,,0,0,0,,Мен мұны істеуім керек!
Dialogue: 0,0:52:32.23,0:52:34.56,Default,,0,0,0,,(Endeavour) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,0:52:34.65,0:52:36.98,Default,,0,0,0,,Дайын болған кезде тезірек кетіңіз!
Dialogue: 0,0:52:41.57,0:52:43.32,Default,,0,0,0,,(Инъекция дыбысы)
Dialogue: 0,0:52:53.37,0:52:54.71,Default,,0,0,0,,Ах, қандай жалықтырарлық.
Dialogue: 0,0:52:55.21,0:52:58.04,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:52:58.13,0:52:59.59,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:53:05.05,0:53:07.72,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:53:10.64,0:53:13.23,Default,,0,0,0,,Ааах, жаным-ай!
Dialogue: 0,0:53:15.48,0:53:17.06,Default,,0,0,0,,Уууу…
Dialogue: 0,0:53:23.65,0:53:24.74,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:53:28.49,0:53:29.78,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:53:30.24,0:53:31.33,Default,,0,0,0,,- Қарғыс атсын! -Аа...
Dialogue: 0,0:53:34.66,0:53:36.12,Default,,0,0,0,,Бұл не деген жігіттер...
Dialogue: 0,0:53:36.50,0:53:37.54,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:53:37.63,0:53:39.17,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:53:39.25,0:53:40.46,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:53:41.09,0:53:43.63,Default,,0,0,0,,Іргетас станокта... Шүкір!
Dialogue: 0,0:53:45.88,0:53:48.30,Default,,0,0,0,,Готфрид Эгельстерн жойылды!
Dialogue: 0,0:53:48.39,0:53:50.97,Default,,0,0,0,,Қозғалтқыш тоқтады Жалын оқ-дәрі қоймасына жақындап қалды!
Dialogue: 0,0:53:51.06,0:53:55.27,Default,,0,0,0,,Қозғалтқышты бөліңіз! Кемені тастаңыз. Барлық мүшелер кемені тастап кетеді!
Dialogue: 0,0:53:55.35,0:53:57.40,Default,,0,0,0,,Барлық мүшелер эвакуациялансын!
Dialogue: 0,0:53:57.48,0:53:58.86,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:54:02.44,0:54:03.94,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:54:04.03,0:54:05.61,Default,,0,0,0,,Соққыға дайын болыңыз!
Dialogue: 0,0:54:12.49,0:54:15.46,Default,,0,0,0,,Әпкем жоқта қалағанымды істей аламын!
Dialogue: 0,0:54:18.21,0:54:19.42,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:54:19.50,0:54:21.42,Default,,0,0,0,,Tsk! Бұл құбыжық...
Dialogue: 0,0:54:21.50,0:54:23.46,Default,,0,0,0,,Кешіріңіз, әпке!
Dialogue: 0,0:54:23.55,0:54:25.38,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:54:26.76,0:54:28.43,Default,,0,0,0,,Марс! Герберт!
Dialogue: 0,0:54:30.80,0:54:32.76,Default,,0,0,0,,(Зымыран ұшыру дыбысы)
Dialogue: 0,0:54:32.85,0:54:33.89,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:54:43.48,0:54:44.32,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:54:45.57,0:54:46.95,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:54:48.15,0:54:49.49,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:54:51.49,0:54:56.83,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:54:58.33,0:54:59.67,Default,,0,0,0,,Балалар!
Dialogue: 0,0:55:05.01,0:55:06.34,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:55:06.42,0:55:07.76,Default,,0,0,0,,Вертолёт қонды.
Dialogue: 0,0:55:08.59,0:55:10.05,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:55:14.14,0:55:16.10,Default,,0,0,0,,Бұл уақыт шегі сияқты.
Dialogue: 0,0:55:16.18,0:55:18.02,Default,,0,0,0,,Ақырында...
Dialogue: 0,0:55:20.31,0:55:21.77,Default,,0,0,0,,Архангел! ?
Dialogue: 0,0:55:21.86,0:55:24.27,Default,,0,0,0,,Қарамаңдар!
Dialogue: 0,0:55:25.07,0:55:26.74,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:55:27.82,0:55:29.20,Default,,0,0,0,,Уау!
Dialogue: 0,0:55:38.46,0:55:41.96,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:55:42.04,0:55:43.96,Default,,0,0,0,,Мені ұста, балам!
Dialogue: 0,0:55:49.09,0:55:50.26,Default,,0,0,0,,Чи…
Dialogue: 0,0:55:56.89,0:55:58.98,Default,,0,0,0,,(Дабыл дыбысы)
Dialogue: 0,0:55:59.06,0:56:00.77,Default,,0,0,0,,Сіз жеңе алмайсыз
Dialogue: 0,0:56:00.85,0:56:01.90,Default,,0,0,0,,Не! ?
Dialogue: 0,0:56:03.23,0:56:04.52,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:56:04.61,0:56:06.90,Default,,0,0,0,,Өйткені бұл сіздің тағдырыңыз!
Dialogue: 0,0:56:06.98,0:56:08.03,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:56:09.24,0:56:12.28,Default,,0,0,0,,(Жылдам дыбыс)
Dialogue: 0,0:56:12.36,0:56:13.70,Default,,0,0,0,,Уууу…
Dialogue: 0,0:56:17.91,0:56:19.50,Default,,0,0,0,,Мен оны аламын!
Dialogue: 0,0:56:20.00,0:56:22.42,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:56:25.92,0:56:27.50,Default,,0,0,0,,Ха... Агнес! ?
Dialogue: 0,0:56:30.09,0:56:30.92,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:56:31.01,0:56:32.59,Default,,0,0,0,,Не! ?
Dialogue: 0,0:56:40.85,0:56:43.31,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:56:45.23,0:56:46.61,Default,,0,0,0,,Қызықты
Dialogue: 0,0:56:50.03,0:56:51.15,Default,,0,0,0,,- Жасай бер! - мүмкін!
Dialogue: 0,0:56:59.70,0:57:01.33,Default,,0,0,0,,- Кира! -Аслан?
Dialogue: 0,0:57:01.41,0:57:04.50,Default,,0,0,0,,(мобильді костюмнің ұшу дыбысы)
Dialogue: 0,0:57:04.58,0:57:06.38,Default,,0,0,0,,(қону дыбысы)
Dialogue: 0,0:57:07.38,0:57:08.42,Default,,0,0,0,,Фу…
Dialogue: 0,0:57:10.09,0:57:11.34,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз.
Dialogue: 0,0:57:12.80,0:57:14.01,Default,,0,0,0,,Кеш болды...
Dialogue: 0,0:57:24.60,0:57:26.19,Default,,0,0,0,,Атрун Зала?
Dialogue: 0,0:57:26.27,0:57:28.11,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:57:28.19,0:57:30.23,Default,,0,0,0,,Шура Уақыт келді!
Dialogue: 0,0:57:32.69,0:57:33.95,Default,,0,0,0,,Келесің бе?
Dialogue: 0,0:57:35.61,0:57:37.70,Default,,0,0,0,,Мен сенімен барамын...
Dialogue: 0,0:57:41.54,0:57:43.58,Default,,0,0,0,,Агнес Неге...
Dialogue: 0,0:57:43.66,0:57:45.08,Default,,0,0,0,,Қаш, Кира!
Dialogue: 0,0:57:45.17,0:57:47.29,Default,,0,0,0,,Архангел адамдар да бізбен бірге!
Dialogue: 0,0:57:49.79,0:57:52.38,Default,,0,0,0,,(Зымыранның ұшу дыбысы)
Dialogue: 0,0:57:53.21,0:57:55.80,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:58:03.64,0:58:05.23,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:58:17.78,0:58:19.70,Default,,0,0,0,,-Аа... -Солай...
Dialogue: 0,0:58:19.78,0:58:20.62,Default,,0,0,0,,Әй?
Dialogue: 0,0:58:23.62,0:58:24.91,Default,,0,0,0,,Фу…
Dialogue: 0,0:58:28.46,0:58:32.09,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:58:33.76,0:58:34.80,Default,,0,0,0,,Өз киімдері —
Dialogue: 0,0:58:35.22,0:58:37.47,Default,,0,0,0,,Эльдор трагедиясынан 4 күннен кейін
Dialogue: 0,0:58:37.55,0:58:39.64,Default,,0,0,0,,Жергілікті радиация деңгейі әлі де жоғары
Dialogue: 0,0:58:39.72,0:58:42.06,Default,,0,0,0,,Қатысушы негізгі елдердің көмек көрсету шаралары:
Dialogue: 0,0:58:42.14,0:58:44.47,Default,,0,0,0,,күткендей дамымайды
Dialogue: 0,0:58:44.56,0:58:46.89,Default,,0,0,0,,NJC нысандарының қайта іске қосылуымен —
Dialogue: 0,0:58:46.98,0:58:49.06,Default,,0,0,0,,Бұл жер бетінде тағы да қорқынышты түс пайда болды.
Dialogue: 0,0:58:49.15,0:58:51.48,Default,,0,0,0,,Дүние қорқады, наразылық дауыстары...
Dialogue: 0,0:58:51.56,0:58:53.90,Default,,0,0,0,,Күннен күнге көлемі артып келеді.
Dialogue: 0,0:58:54.40,0:58:56.78,Default,,0,0,0,,екінші нөлден шығысқа қарай 1,5 км—
Dialogue: 0,0:58:56.86,0:58:59.66,Default,,0,0,0,,Біз Архангел сияқты көрінетін нәрсенің қалдықтарын растадық.
Dialogue: 0,0:58:59.74,0:59:03.33,Default,,0,0,0,,Freedom Justice Басқалар Жұмыс істеп тұрған мобильді костюмдер тобы:
Dialogue: 0,0:59:03.41,0:59:05.33,Default,,0,0,0,,Әлі ашылған жоқ
Dialogue: 0,0:59:05.41,0:59:08.00,Default,,0,0,0,,Қоңырауларыма жауап жоқ.
Dialogue: 0,0:59:08.08,0:59:10.92,Default,,0,0,0,,Жарылыста қалғандардың барлығы...
Dialogue: 0,0:59:11.00,0:59:12.54,Default,,0,0,0,,Губернатор Кляйн
Dialogue: 0,0:59:12.63,0:59:14.55,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:59:14.63,0:59:15.55,Default,,0,0,0,,Иә
Dialogue: 0,0:59:15.63,0:59:17.42,Default,,0,0,0,,Мыңжылдық туралы есеп—
Dialogue: 0,0:59:17.51,0:59:19.26,Default,,0,0,0,,Құрметті адамдармен қор –
Dialogue: 0,0:59:19.34,0:59:20.84,Default,,0,0,0,,Егер сіз қашып кетсеңіз...
Dialogue: 0,0:59:21.22,0:59:22.55,Default,,0,0,0,,Зауытпен қалай байланысуға болады?
Dialogue: 0,0:59:22.64,0:59:23.68,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:59:23.76,0:59:25.64,Default,,0,0,0,,Мен үшін не істейсің!
Dialogue: 0,0:59:25.72,0:59:28.60,Default,,0,0,0,,Еуразиядан қатты наразылықтар келіп жатыр.
Dialogue: 0,0:59:28.69,0:59:30.85,Default,,0,0,0,,Мұның бәрі капитан Ямато келісімді бұзғандықтан болды.
Dialogue: 0,0:59:30.94,0:59:33.52,Default,,0,0,0,,Өйткені олар әскери межелеу сызығын кесіп өтті.
Dialogue: 0,0:59:33.61,0:59:36.94,Default,,0,0,0,,Бұл ядролық қаруды атуға жақсы себеп емес.
Dialogue: 0,0:59:37.03,0:59:40.24,Default,,0,0,0,,Бұл бүкіл адамзатқа опасыздық.
Dialogue: 0,0:59:40.32,0:59:43.16,Default,,0,0,0,,Мен де капитан Яматоның ісімен келіспеймін.
Dialogue: 0,0:59:43.24,0:59:46.45,Default,,0,0,0,,Есепті оқыған кезде түсініксіз нәрселер тым көп.
Dialogue: 0,0:59:46.54,0:59:48.58,Default,,0,0,0,,Мен не болғанын білмеймін!
Dialogue: 0,0:59:48.66,0:59:50.75,Default,,0,0,0,,Шындық қараңғыда
Dialogue: 0,0:59:50.83,0:59:55.13,Default,,0,0,0,,Капитан Ямато, егер Мишель және басқалары тірі болса және сөйлеспейді.
Dialogue: 0,0:59:55.21,0:59:57.30,Default,,0,0,0,,Бұл ыңғайлы.
Dialogue: 0,0:59:57.38,1:00:00.09,Default,,0,0,0,,Ешкімді жауапкершілікке тартудың жолы жоқ
Dialogue: 0,1:00:00.17,1:00:02.18,Default,,0,0,0,,Сіз не айтқыңыз келеді?
Dialogue: 0,1:00:02.26,1:00:04.18,Default,,0,0,0,,Капитан Яматоның әрекеті шынымен...
Dialogue: 0,1:00:04.26,1:00:07.43,Default,,0,0,0,,Бұл оның өз шешімі болды ма?
Dialogue: 0,1:00:07.52,1:00:11.27,Default,,0,0,0,,Бұл жағдай зауыттың Еуразиялық аумаққа араласуы үшін тамаша мүмкіндік...
Dialogue: 0,1:00:11.35,1:00:13.10,Default,,0,0,0,,Айыптауды доғарыңыз!
Dialogue: 0,1:00:13.19,1:00:15.02,Default,,0,0,0,,Кира осылай істейтін еді!
Dialogue: 0,1:00:16.44,1:00:18.11,Default,,0,0,0,,Кагари-ни-сама...
Dialogue: 0,1:00:18.19,1:00:19.49,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:00:19.57,1:00:21.70,Default,,0,0,0,,Сонымен, біздің ел енді компасты емес —
Dialogue: 0,1:00:21.78,1:00:23.87,Default,,0,0,0,,Менің араласатын ойым жоқ.
Dialogue: 0,1:00:23.95,1:00:25.28,Default,,0,0,0,,Біз де
Dialogue: 0,1:00:25.37,1:00:28.95,Default,,0,0,0,,Қызық, ауырмайтын ішім осылай зерттеле ме?
Dialogue: 0,1:00:29.45,1:00:30.71,Default,,0,0,0,,Жоқ…
Dialogue: 0,1:00:31.41,1:00:32.92,Default,,0,0,0,,(күрсіну)
Dialogue: 0,1:00:40.59,1:00:42.22,Default,,0,0,0,,Митомета Кунай
Dialogue: 0,1:00:45.26,1:00:47.22,Default,,0,0,0,,(күрсіну)
Dialogue: 0,1:00:48.14,1:00:50.39,Default,,0,0,0,,Сен неге қайтып келмейсің?
Dialogue: 0,1:00:50.77,1:00:52.31,Default,,0,0,0,,Шиннің ақымақ...
Dialogue: 0,1:00:52.39,1:00:55.65,Default,,0,0,0,,Түсіндім, негізі...
Dialogue: 0,1:00:55.73,1:00:56.81,Default,,0,0,0,,Кептелудің уақыты мен уақыты
Dialogue: 0,1:00:56.90,1:00:58.73,Default,,0,0,0,,92% қара түсті болу мүмкіндігі
Dialogue: 0,1:00:58.82,1:01:00.53,Default,,0,0,0,,Бұл Қара рыцарьлардың жұмысы.
Dialogue: 0,1:01:00.61,1:01:03.40,Default,,0,0,0,,А, қара түсті тек Қара рыцарьлар үшін...
Dialogue: 0,1:01:03.49,1:01:06.91,Default,,0,0,0,,...Иә! ? Осылайша, ядролық шабуыл ...
Dialogue: 0,1:01:06.99,1:01:08.87,Default,,0,0,0,,Сіз іргетас деп айтасыз ба? ?
Dialogue: 0,1:01:08.95,1:01:09.99,Default,,0,0,0,,Nggg…
Dialogue: 0,1:01:10.08,1:01:13.33,Default,,0,0,0,,Бірақ бізде оны дәлелдеуге мүмкіндік жоқ.
Dialogue: 0,1:01:13.41,1:01:14.67,Default,,0,0,0,,Мыңжылдық үйге қайтуға бұйырылды
Dialogue: 0,1:01:14.75,1:01:16.04,Default,,0,0,0,,Менде нөлдік мобильді костюмдер бар.
Dialogue: 0,1:01:16.13,1:01:19.13,Default,,0,0,0,,Архангел де құлады, ал экипаждың аман қалуы үмітсіз.
Dialogue: 0,1:01:19.55,1:01:21.30,Default,,0,0,0,,Мен таң қалдым ...
Dialogue: 0,1:01:21.76,1:01:24.97,Default,,0,0,0,,Мен оңай өлемін бе? Сол жігіттер
Dialogue: 0,1:01:25.39,1:01:26.43,Default,,0,0,0,,Негізі
Dialogue: 0,1:01:26.51,1:01:29.14,Default,,0,0,0,,Елдоа аймағын қосқанда 50 000 өлім
Dialogue: 0,1:01:29.22,1:01:32.77,Default,,0,0,0,,Зардап шеккендер мен хабар-ошарсыз кеткендердің саны 100 000-нан асады.
Dialogue: 0,1:01:32.85,1:01:35.98,Default,,0,0,0,,Барлық Еуразиялық күштер жауап қайтаруға дайындалуда...
Dialogue: 0,1:01:36.06,1:01:37.11,Default,,0,0,0,,(Теледидарды өшіру дыбысы)
Dialogue: 0,1:01:37.19,1:01:39.15,Default,,0,0,0,,Екеуің де жақсысыңдар ма?
Dialogue: 0,1:01:39.23,1:01:41.44,Default,,0,0,0,,Иә
Dialogue: 0,1:01:43.15,1:01:44.99,Default,,0,0,0,,Мама!
Dialogue: 0,1:01:45.07,1:01:46.91,Default,,0,0,0,,Қазірдің өзінде компастың әрекеттері:
Dialogue: 0,1:01:46.99,1:01:49.08,Default,,0,0,0,,Әзірше ол қатып қалады...
Dialogue: 0,1:01:49.16,1:01:50.58,Default,,0,0,0,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,1:01:51.45,1:01:54.29,Default,,0,0,0,,Бұл рас па? Компас қатып қалды
Dialogue: 0,1:01:54.37,1:01:57.17,Default,,0,0,0,,Иә, Кагалли барын салған сияқты.
Dialogue: 0,1:01:57.25,1:02:00.88,Default,,0,0,0,,Дәл қазір әлемнің түкпір-түкпірінен сындар шоғырланған.
Dialogue: 0,1:02:00.96,1:02:03.09,Default,,0,0,0,,Анау жігіттер... шіркін!
Dialogue: 0,1:02:03.76,1:02:05.30,Default,,0,0,0,,Қалған жалғыз мыңжылдық —
Dialogue: 0,1:02:05.38,1:02:07.76,Default,,0,0,0,,Қазіргі уақытта Орб портында
Dialogue: 0,1:02:07.84,1:02:10.01,Default,,0,0,0,,Бұл жағдай хабарланбаған.
Dialogue: 0,1:02:11.18,1:02:12.43,Default,,0,0,0,,Лакус ше?
Dialogue: 0,1:02:12.52,1:02:16.02,Default,,0,0,0,,Ол Foundation шаттлында қашып кеткен сияқты...
Dialogue: 0,1:02:16.89,1:02:20.11,Default,,0,0,0,,Ол... бізге опасыздық жасады.
Dialogue: 0,1:02:26.20,1:02:29.41,Default,,0,0,0,,Терминалды тергеу кезінде осындай нәрсе ұсталды.
Dialogue: 0,1:02:30.41,1:02:33.12,Default,,0,0,0,,Бұл... Императрица Аура ма?
Dialogue: 0,1:02:33.20,1:02:37.79,Default,,0,0,0,,Мендельдің генетикалық зертханасында 19 жыл бұрын ол менің дос қызым болды.
Dialogue: 0,1:02:37.87,1:02:39.46,Default,,0,0,0,,19 жыл бұрын?
Dialogue: 0,1:02:40.88,1:02:42.63,Default,,0,0,0,,Оның зерттеу тақырыбы –
Dialogue: 0,1:02:42.71,1:02:45.38,Default,,0,0,0,,Координатордан асатын түр жасау
Dialogue: 0,1:02:45.47,1:02:46.30,Default,,0,0,0,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,1:02:47.76,1:02:51.10,Default,,0,0,0,,Делекциялық сақина No 1 No 3 No 6
Dialogue: 0,1:02:51.18,1:02:53.10,Default,,0,0,0,,Жоспарланған орында орналастыру аяқталды
Dialogue: 0,1:02:53.18,1:02:55.64,Default,,0,0,0,,Мақсатты түзету плюс 2.3
Dialogue: 0,1:02:55.73,1:02:59.23,Default,,0,0,0,,Реквиемнің ұшыру сынилігі Т минус 60
Dialogue: 0,1:02:59.31,1:03:01.40,Default,,0,0,0,,Жүйе қалыпты жұмыс істейді
Dialogue: 0,1:03:01.90,1:03:04.69,Default,,0,0,0,,Аураның бәрі...
Dialogue: 0,1:03:04.78,1:03:06.61,Default,,0,0,0,,Бұл олардың жоспары болды.
Dialogue: 0,1:03:11.20,1:03:13.20,Default,,0,0,0,,- (Мари) Ядролық шабуыл да... - Иә?
Dialogue: 0,1:03:13.28,1:03:16.87,Default,,0,0,0,,Кем дегенде, оларда ядролық бомбаны атуға сылтау бар.
Dialogue: 0,1:03:16.95,1:03:19.54,Default,,0,0,0,,Реквием іске қосуға дайын
Dialogue: 0,1:03:19.62,1:03:21.46,Default,,0,0,0,,Алла разы болсын
Dialogue: 0,1:03:21.96,1:03:23.54,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,1:03:23.63,1:03:25.92,Default,,0,0,0,,Олардың Еуразияға шабуыл жасауының сылтауы...
Dialogue: 0,1:03:26.01,1:03:27.59,Default,,0,0,0,,Ха…
Dialogue: 0,1:03:27.67,1:03:31.43,Default,,0,0,0,,(сағат қоңырау дыбысы)
Dialogue: 0,1:03:37.43,1:03:40.60,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:03:43.27,1:03:44.69,Default,,0,0,0,,Кагари-ни-сама!
Dialogue: 0,1:03:44.77,1:03:45.61,Default,,0,0,0,,Иә?
Dialogue: 0,1:03:45.69,1:03:48.28,Default,,0,0,0,,Командир Зара, дереу басқару бөлмесіне келіңіз!
Dialogue: 0,1:03:48.36,1:03:49.82,Default,,0,0,0,,Ақпарат жинаңыз!
Dialogue: 0,1:03:49.90,1:03:53.12,Default,,0,0,0,,Компас командасы мен Orb үкіметімен сызық түзетілді!
Dialogue: 0,1:03:54.08,1:03:55.28,Default,,0,0,0,,Мәскеу...
Dialogue: 0,1:03:55.37,1:03:58.45,Default,,0,0,0,,Бұл Қордың кек алуы...
Dialogue: 0,1:03:58.54,1:04:00.04,Default,,0,0,0,,Қазірдің өзінде?
Dialogue: 0,1:04:00.12,1:04:02.12,Default,,0,0,0,,Ядролық... шабуыл?
Dialogue: 0,1:04:02.21,1:04:04.04,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,1:04:07.21,1:04:08.59,Default,,0,0,0,,Бұл реквием...
Dialogue: 0,1:04:09.01,1:04:10.22,Default,,0,0,0,,Реквием –
Dialogue: 0,1:04:10.30,1:04:12.01,Default,,0,0,0,,Бұзылған жоқ па!?
Dialogue: 0,1:04:12.09,1:04:15.43,Default,,0,0,0,,Бұл зауыттың атысты тоқтату туралы келісімін анық бұзу!
Dialogue: 0,1:04:15.51,1:04:18.81,Default,,0,0,0,,Мұндай кек қайтаруға ешқашан жол берілмейді!
Dialogue: 0,1:04:18.89,1:04:20.18,Default,,0,0,0,,Президент…
Dialogue: 0,1:04:20.64,1:04:22.85,Default,,0,0,0,,Бұл не? Қазір қосылыңыз!
Dialogue: 0,1:04:24.31,1:04:26.90,Default,,0,0,0,,Бізді жерден қуып жіберді
Dialogue: 0,1:04:26.98,1:04:29.74,Default,,0,0,0,,Табиғаттан шыққан өшпенділік өзегі бойынша
Dialogue: 0,1:04:30.61,1:04:33.82,Default,,0,0,0,,Біз тек бейбітшілік пен тұрақтылықты қалаймыз.
Dialogue: 0,1:04:33.91,1:04:37.54,Default,,0,0,0,,Табиғи қыңырлар тағы да таптады
Dialogue: 0,1:04:37.62,1:04:39.29,Default,,0,0,0,,Неге!
Dialogue: 0,1:04:39.37,1:04:43.58,Default,,0,0,0,,Ұлттық саясат ретінде еліміз
Dialogue: 0,1:04:43.67,1:04:44.75,Default,,0,0,0,,Гилберт Дюрендал мырзаның
Dialogue: 0,1:04:44.83,1:04:48.00,Default,,0,0,0,,Ұсынылған Тағдыр жоспарын қабылдады
Dialogue: 0,1:04:48.46,1:04:49.59,Default,,0,0,0,,Гендер бойынша—
Dialogue: 0,1:04:49.67,1:04:52.01,Default,,0,0,0,,Толық әділ және тең қоғам
Dialogue: 0,1:04:52.47,1:04:54.47,Default,,0,0,0,,Адамның генінде жазылған
Dialogue: 0,1:04:54.55,1:04:57.26,Default,,0,0,0,,Біздің рөлді қабылдау арқылы—
Dialogue: 0,1:04:57.35,1:04:59.47,Default,,0,0,0,,Кедейлікті жеңеміз
Dialogue: 0,1:04:59.56,1:05:02.35,Default,,0,0,0,,Өткен соғыста тәуелсіздік алды
Dialogue: 0,1:05:02.44,1:05:04.52,Default,,0,0,0,,Ол ғажайып қалпына келді.
Dialogue: 0,1:05:04.60,1:05:08.69,Default,,0,0,0,,Бірақ бұл жалқауларға ұнамайды!
Dialogue: 0,1:05:09.61,1:05:13.95,Default,,0,0,0,,Олар эволюцияны жоққа шығарады, басқаларға қызғанышпен қарайды және бұрынғы кектерін ұмытпайды.
Dialogue: 0,1:05:14.03,1:05:17.24,Default,,0,0,0,,Бір-бірімізді шіркін сезімдерімізбен өлтірейік
Dialogue: 0,1:05:17.33,1:05:19.16,Default,,0,0,0,,Жер бетінде тыныш өмір сүріп жатқанда...
Dialogue: 0,1:05:19.24,1:05:23.08,Default,,0,0,0,,Өз пайдасын ашкөздікпен жейтін паразит сияқты.
Dialogue: 0,1:05:23.16,1:05:25.04,Default,,0,0,0,,- (Ысқақ) Не! ? -Сұрағымыз келеді!
Dialogue: 0,1:05:25.12,1:05:27.42,Default,,0,0,0,,Осындай надан адаммен...
Dialogue: 0,1:05:27.50,1:05:30.34,Default,,0,0,0,,Неліктен біз бірге жүруіміз керек?
Dialogue: 0,1:05:31.63,1:05:34.26,Default,,0,0,0,,Зауытта тұратын координаторлар
Dialogue: 0,1:05:34.34,1:05:36.68,Default,,0,0,0,,Біз сенің ағаларыңбыз
Dialogue: 0,1:05:36.76,1:05:42.18,Default,,0,0,0,,Олар да біз сияқты адамзаттың болашаққа эволюциясын жалғастыратындар.
Dialogue: 0,1:05:42.27,1:05:46.60,Default,,0,0,0,,Біз де генетикалық манипуляция арқылы жасалған соңғы үйлестірушілерміз.
Dialogue: 0,1:05:46.69,1:05:48.02,Default,,0,0,0,,«Келісім»!
Dialogue: 0,1:05:48.11,1:05:54.57,Default,,0,0,0,,Оның генінде жазылған рөлі - адамзаттың төрешісі және әлемді бағыттау.
Dialogue: 0,1:05:54.65,1:05:57.28,Default,,0,0,0,,Міне, сондықтан біз дүниеге келдік
Dialogue: 0,1:05:57.37,1:06:00.20,Default,,0,0,0,,Сіздің көшбасшыларыңыздың бірі—
Dialogue: 0,1:06:00.28,1:06:03.12,Default,,0,0,0,,Канцлер Лакус Кляйн да біздің жерлестеріміздің бірі!
Dialogue: 0,1:06:03.20,1:06:07.46,Default,,0,0,0,,Ол да қазір адамзатқа жол көрсетуші ретінде бізбен бірге.
Dialogue: 0,1:06:08.58,1:06:11.05,Default,,0,0,0,,Біздің еркіміз - оның еркі -
Dialogue: 0,1:06:11.13,1:06:14.22,Default,,0,0,0,,Біздің тілегіміз де оның тілегі!
Dialogue: 0,1:06:14.30,1:06:16.88,Default,,0,0,0,,Бірге барайық, үйлестіруші ағайындар!
Dialogue: 0,1:06:17.89,1:06:21.72,Default,,0,0,0,,Қарт адамдардың қайшылық пен озбырлық дәуірі аяқталды.
Dialogue: 0,1:06:21.81,1:06:22.89,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:06:22.97,1:06:25.81,Default,,0,0,0,,Жер бетіндегі барлық халықтарға хабарлау
Dialogue: 0,1:06:25.89,1:06:27.52,Default,,0,0,0,,Дереу қарусыздандырыңыз—
Dialogue: 0,1:06:27.60,1:06:30.73,Default,,0,0,0,,Тағдыр жоспарын бекітіп, орындаңыз!
Dialogue: 0,1:06:30.82,1:06:32.65,Default,,0,0,0,,Жеңілдік кезеңі 5 күн
Dialogue: 0,1:06:32.73,1:06:34.61,Default,,0,0,0,,Сонымен қатар, біз—
Dialogue: 0,1:06:34.69,1:06:37.24,Default,,0,0,0,,Оны қабылдай алмаймын деген күштерге...
Dialogue: 0,1:06:37.32,1:06:41.41,Default,,0,0,0,,Лакус Клайн атына санкция реквиемі
Dialogue: 0,1:06:42.62,1:06:45.33,Default,,0,0,0,,Олардың басына Мегидоның оты түседі.
Dialogue: 0,1:06:46.29,1:06:48.00,Default,,0,0,0,,О, құдайым...
Dialogue: 0,1:06:49.13,1:06:50.17,Default,,0,0,0,,Кира!
Dialogue: 0,1:06:51.88,1:06:53.34,Default,,0,0,0,,Көпірдегі төраға!
Dialogue: 0,1:06:53.84,1:06:55.05,Default,,0,0,0,,Жюль ханым
Dialogue: 0,1:06:55.13,1:06:58.22,Default,,0,0,0,,Канабастың бұрынғы өкілі, көмегіңіз үшін рахмет.
Dialogue: 0,1:06:58.30,1:07:00.05,Default,,0,0,0,,Бірақ тұрмыстық тәртіпсіздіктер
Dialogue: 0,1:07:00.14,1:07:03.01,Default,,0,0,0,,Біраз күтуден басқа амалым жоқ.
Dialogue: 0,1:07:03.10,1:07:05.35,Default,,0,0,0,,Түсіндім, төраға мырза.
Dialogue: 0,1:07:05.43,1:07:09.94,Default,,0,0,0,,Ең нашар жағдайда, Реквиемнің назары қайтадан зауытқа түседі.
Dialogue: 0,1:07:10.02,1:07:13.82,Default,,0,0,0,,Енді біз жағдайды бағалап, жасырынуымыз керек.
Dialogue: 0,1:07:13.90,1:07:15.86,Default,,0,0,0,,Ол үшін қандай шаралар бар?
Dialogue: 0,1:07:15.94,1:07:18.61,Default,,0,0,0,,Оны тамаша деп айту қиын, бірақ...
Dialogue: 0,1:07:18.70,1:07:20.41,Default,,0,0,0,,Боғаз жойылды
Dialogue: 0,1:07:20.49,1:07:24.29,Default,,0,0,0,,Лакус бізге сеніп тапсырған Қарсылықпен қамтамасыз ету қондырғысы бар.
Dialogue: 0,1:07:24.37,1:07:26.95,Default,,0,0,0,,-Біз бармыз... -Жарайды.
Dialogue: 0,1:07:27.71,1:07:31.38,Default,,0,0,0,,Сізді жалғыз күткенім үшін кешіріңіз, ханшайым.
Dialogue: 0,1:07:31.46,1:07:35.09,Default,,0,0,0,,Кешірім сұрағыңыз келсе, маған тезірек жіберіңіз.
Dialogue: 0,1:07:35.17,1:07:38.30,Default,,0,0,0,,Маған үйге баруға рұқсат етіңізші.
Dialogue: 0,1:07:38.38,1:07:40.13,Default,,0,0,0,,Going home?
Dialogue: 0,1:07:40.22,1:07:42.72,Default,,0,0,0,,Бұл жерде болуыңыз керек.
Dialogue: 0,1:07:43.43,1:07:46.93,Default,,0,0,0,,Бұл да сенің анаңның өсиеті.
Dialogue: 0,1:07:47.02,1:07:48.85,Default,,0,0,0,,Не? Анасының?
Dialogue: 0,1:07:51.52,1:07:52.35,Default,,0,0,0,,Ах...
Dialogue: 0,1:07:52.44,1:07:55.86,Default,,0,0,0,,Адамдарды гендеріне қарай таңдау және олардың бейімділігіне қарай рөлдерін анықтау —
Dialogue: 0,1:07:55.94,1:07:57.94,Default,,0,0,0,,Тағдыр жоспары
Dialogue: 0,1:07:58.03,1:08:00.49,Default,,0,0,0,,Дурандал мен Аура жүйені басқарады.
Dialogue: 0,1:08:00.57,1:08:03.53,Default,,0,0,0,,Халықты басқаратындарды жаратты.
Dialogue: 0,1:08:03.62,1:08:05.45,Default,,0,0,0,,Бұл келісім
Dialogue: 0,1:08:05.53,1:08:06.37,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,1:08:08.79,1:08:11.54,Default,,0,0,0,,Халық үшін тудың
Dialogue: 0,1:08:11.62,1:08:15.46,Default,,0,0,0,,Барлық халықтардың сүйіспеншілігіне бөленіп, оларға жол көрсету
Dialogue: 0,1:08:15.54,1:08:16.38,Default,,0,0,0,,Иә?
Dialogue: 0,1:08:16.46,1:08:19.05,Default,,0,0,0,,Мен оны осылай жасадым
Dialogue: 0,1:08:19.97,1:08:23.01,Default,,0,0,0,,Сіз... мені жараттыңыз ба?
Dialogue: 0,1:08:23.09,1:08:26.31,Default,,0,0,0,,Олардың келісіміндегі ең маңызды нәрсе -
Dialogue: 0,1:08:26.39,1:08:28.22,Default,,0,0,0,,Орфей Лам Тао
Dialogue: 0,1:08:28.31,1:08:30.35,Default,,0,0,0,,Және Лакус.
Dialogue: 0,1:08:30.43,1:08:31.52,Default,,0,0,0,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,1:08:32.14,1:08:33.60,Default,,0,0,0,,Люкс! ?
Dialogue: 0,1:08:34.36,1:08:39.24,Default,,0,0,0,,Екеуің бүкіл адамзаттың басында тұруларың керек.
Dialogue: 0,1:08:39.32,1:08:43.11,Default,,0,0,0,,Соңында қосылатын жұп бөліктер.
Dialogue: 0,1:08:43.95,1:08:48.04,Default,,0,0,0,,Сен екеуміз бұл дүниені бірге билейміз.
Dialogue: 0,1:08:49.04,1:08:50.70,Default,,0,0,0,,Сіз оны сезе аласыз, солай ма? (резонанстық дыбыс)
Dialogue: 0,1:08:51.62,1:08:54.38,Default,,0,0,0,,Бірге... сенімен?
Dialogue: 0,1:08:54.96,1:08:59.38,Default,,0,0,0,,Бізді бір-бірімізге тартып, тағдыр байлағанбыз.
Dialogue: 0,1:09:00.55,1:09:03.38,Default,,0,0,0,,Осылайша олар Лакусты ұрлап кетті.
Dialogue: 0,1:09:03.47,1:09:06.01,Default,,0,0,0,,Өйткені бұл олардың жоспарына қажет болды.
Dialogue: 0,1:09:08.10,1:09:09.10,Default,,0,0,0,,Люкс!
Dialogue: 0,1:09:10.06,1:09:12.31,Default,,0,0,0,,Ха! ? Керемет...
Dialogue: 0,1:09:14.19,1:09:17.40,Default,,0,0,0,,Мен жақсы көретін адам сен емессің!
Dialogue: 0,1:09:17.48,1:09:19.57,Default,,0,0,0,,Қарғыс атсын! Ха...
Dialogue: 0,1:09:20.15,1:09:22.99,Default,,0,0,0,,Сіз Кира Ямато үшін алаңдайсыз ба?
Dialogue: 0,1:09:23.07,1:09:25.99,Default,,0,0,0,,Өкінішке орай, ол енді бұл дүниеде жоқ.
Dialogue: 0,1:09:26.07,1:09:26.91,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,1:09:26.99,1:09:29.58,Default,,0,0,0,,Оны өлтіруге болатынын айтпадың ба?
Dialogue: 0,1:09:29.66,1:09:33.08,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:09:33.16,1:09:34.33,Default,,0,0,0,,Өз киімдері —
Dialogue: 0,1:09:34.42,1:09:36.67,Default,,0,0,0,,Маған бәрібір ол енді керек емес.
Dialogue: 0,1:09:36.75,1:09:38.79,Default,,0,0,0,,Болашақ әлемде...
Dialogue: 0,1:09:39.63,1:09:41.09,Default,,0,0,0,,Бұл қажет болғандықтан...
Dialogue: 0,1:09:41.71,1:09:44.76,Default,,0,0,0,,Біз сүймейміз, өйткені ол бізге керек.
Dialogue: 0,1:09:44.84,1:09:47.18,Default,,0,0,0,,Маған керек, өйткені мен оны жақсы көремін!
Dialogue: 0,1:09:47.26,1:09:48.10,Default,,0,0,0,,Иә?
Dialogue: 0,1:09:48.18,1:09:51.02,Default,,0,0,0,,«Табиғи» сияқты мағынасыз сөздерді қолдануды доғар!
Dialogue: 0,1:09:51.10,1:09:52.39,Default,,0,0,0,,Ха…
Dialogue: 0,1:09:52.47,1:09:53.89,Default,,0,0,0,,Сұрыптау
Dialogue: 0,1:09:53.98,1:09:57.61,Default,,0,0,0,,Шура Ингрид Мен анам мен ханшайымды сұрадым.
Dialogue: 0,1:09:59.15,1:10:00.86,Default,,0,0,0,,Зауыттағы ақпаратқа сәйкес—
Dialogue: 0,1:10:00.94,1:10:03.78,Default,,0,0,0,,Қазіргі уақытта әскери төңкеріс болып жатыр.
Dialogue: 0,1:10:03.86,1:10:05.32,Default,,0,0,0,,Мен егжей-тегжейлі білмеймін, бірақ
Dialogue: 0,1:10:05.40,1:10:08.20,Default,,0,0,0,,Төраға және одан төмен Кеңес мүшелерімен байланысу мүмкін емес
Dialogue: 0,1:10:08.28,1:10:09.28,Default,,0,0,0,,Иә! ?
Dialogue: 0,1:10:09.37,1:10:12.20,Default,,0,0,0,,Бірақ біз қазір қозғала алмаймыз.
Dialogue: 0,1:10:12.29,1:10:14.62,Default,,0,0,0,,Жылжымалы костюмдер немесе кемелер жоқ.
Dialogue: 0,1:10:14.71,1:10:19.46,Default,,0,0,0,,Басқаша айтқанда, бұл жерде бәріміз өлгендей жақсымыз...
Dialogue: 0,1:10:19.54,1:10:21.55,Default,,0,0,0,,Бұл жай ғана болжам.
Dialogue: 0,1:10:21.63,1:10:24.26,Default,,0,0,0,,Келісімдер біздің ойымызды оқи алады.
Dialogue: 0,1:10:24.34,1:10:25.67,Default,,0,0,0,,-Ех! ? -мүмкін...
Dialogue: 0,1:10:25.76,1:10:29.18,Default,,0,0,0,,Менің ойымша, бұл тіпті адамдардың санасына әсер етуі мүмкін.
Dialogue: 0,1:10:29.26,1:10:31.35,Default,,0,0,0,,Сонымен капитан! ?
Dialogue: 0,1:10:32.85,1:10:34.48,Default,,0,0,0,,Негізі
Dialogue: 0,1:10:34.56,1:10:38.10,Default,,0,0,0,,Жер бетіндегі халықтарға толық берілгеннен кейін
Dialogue: 0,1:10:38.19,1:10:41.90,Default,,0,0,0,,Қарусыздануды және Тағдыр жоспарын орындауды ұсынады.
Dialogue: 0,1:10:41.98,1:10:43.86,Default,,0,0,0,,«Егер сіз бұл ұсынысты орындамасаңыз—»
Dialogue: 0,1:10:43.94,1:10:46.61,Default,,0,0,0,,«Реквиемді дереу іске қосыңыз»
Dialogue: 0,1:10:46.70,1:10:48.20,Default,,0,0,0,,«Бұл жағдайда бейбіт тұрғындарды да эвакуациялау».
Dialogue: 0,1:10:48.28,1:10:51.12,Default,,0,0,0,,Қосымша мәлімдеме: «Ештеңеге жол берілмейді»…
Dialogue: 0,1:10:55.41,1:10:57.54,Default,,0,0,0,,Лакусты құтқарайық
Dialogue: 0,1:10:57.96,1:11:00.00,Default,,0,0,0,,Бұл жалғыз жол
Dialogue: 0,1:11:00.08,1:11:02.46,Default,,0,0,0,,Бұл жағдайдан қалай шығуға және зауытты тоқтатуға болады—
Dialogue: 0,1:11:03.00,1:11:04.80,Default,,0,0,0,,Маған оның сөздері керек
Dialogue: 0,1:11:06.17,1:11:07.22,Default,,0,0,0,,Пәтуа жоқ
Dialogue: 0,1:11:07.30,1:11:09.13,Default,,0,0,0,,- (барлығы) Иә? -(Мари) Кира-кун?
Dialogue: 0,1:11:09.22,1:11:13.31,Default,,0,0,0,,Не істесек те солай...
Dialogue: 0,1:11:13.39,1:11:14.89,Default,,0,0,0,,ZAFT флотын басып алу
Dialogue: 0,1:11:14.97,1:11:17.73,Default,,0,0,0,,Біздің флоттың оң және сол қанаты алға бағытталған.
Dialogue: 0,1:11:17.81,1:11:20.27,Default,,0,0,0,,Флоттың сол қанаты атылды!
Dialogue: 0,1:11:20.35,1:11:23.44,Default,,0,0,0,,Әрбір кеменің оң жақ қашу қозғалысы Оң қанаттағы бомбалау!
Dialogue: 0,1:11:26.44,1:11:29.78,Default,,0,0,0,,Бірге жиналмау. Сіз Реквиемнен тікелей хит аласыз!
Dialogue: 0,1:11:32.16,1:11:37.58,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:11:42.00,1:11:44.17,Default,,0,0,0,,Соңында бәрі қайталанады.
Dialogue: 0,1:11:44.25,1:11:47.88,Default,,0,0,0,,Қаншама азап шегіп, адасып, төбелескен соң...
Dialogue: 0,1:11:47.97,1:11:50.05,Default,,0,0,0,,Соғыс, күрес!
Dialogue: 0,1:11:50.68,1:11:52.97,Default,,0,0,0,,Бірақ ештеңе өзгермейді...
Dialogue: 0,1:11:53.85,1:11:57.31,Default,,0,0,0,,Мен қателескендіктен бе? ?
Dialogue: 0,1:11:57.39,1:11:58.60,Default,,0,0,0,,Өз киімдері —
Dialogue: 0,1:11:58.68,1:12:00.02,Default,,0,0,0,,Сонымен, Лакус —
Dialogue: 0,1:12:00.10,1:12:02.06,Default,,0,0,0,,Сен мені тастап, оны таңдадың!
Dialogue: 0,1:12:03.11,1:12:04.73,Default,,0,0,0,,Менің қолымнан келмейді!
Dialogue: 0,1:12:05.23,1:12:08.53,Default,,0,0,0,,Мен Лакусқа оның қалағанын бере алмаймын!
Dialogue: 0,1:12:09.03,1:12:12.36,Default,,0,0,0,,Тыныштық былай тұрсын, мен оны күлдіре де алмаймын!
Dialogue: 0,1:12:13.24,1:12:15.28,Default,,0,0,0,,Мен сені бақытты ете алмаймын!
Dialogue: 0,1:12:15.37,1:12:17.70,Default,,0,0,0,,Сол үшін ол маған опасыздық жасады!
Dialogue: 0,1:12:17.79,1:12:18.83,Default,,0,0,0,,Ннн…
Dialogue: 0,1:12:18.91,1:12:20.66,Default,,0,0,0,,Сен бұны істей аласың ба?
Dialogue: 0,1:12:21.25,1:12:23.29,Default,,0,0,0,,Құнсыз қыңырлығыңызды тоқтатыңыз!
Dialogue: 0,1:12:23.67,1:12:26.46,Default,,0,0,0,,«Мен өзіммін» және оның сезімдері мені қызықтырмайды.
Dialogue: 0,1:12:26.55,1:12:29.38,Default,,0,0,0,,Сіз бұл туралы ойлаған да жоқсыз!
Dialogue: 0,1:12:29.84,1:12:32.55,Default,,0,0,0,,Жетер, сонша ұрысқың келмесе...
Dialogue: 0,1:12:32.63,1:12:34.35,Default,,0,0,0,,Мына жерде шіріп кет!
Dialogue: 0,1:12:34.72,1:12:37.43,Default,,0,0,0,,Мен ештеңе түсінбесем де...
Dialogue: 0,1:12:37.51,1:12:41.14,Default,,0,0,0,,Мен сенің бұлай айтқаныңды қаламаймын!
Dialogue: 0,1:12:41.98,1:12:43.19,Default,,0,0,0,,Уф…
Dialogue: 0,1:12:44.23,1:12:46.61,Default,,0,0,0,,Сен жалғыз өзің ұрысамын деп ойлайсың ба? ?
Dialogue: 0,1:12:46.69,1:12:50.03,Default,,0,0,0,,Оған көмектесу мүмкін емес, өйткені сендер әлсізсіңдер!
Dialogue: 0,1:12:50.11,1:12:51.57,Default,,0,0,0,,бірақ мен міндетті түрде Незуконы қайтадан адамға айналдырамын.
Dialogue: 0,1:12:51.65,1:12:53.95,Default,,0,0,0,,Сонымен мен өзімді дүниені иығыма көтеріп жүргендей сезіндім...
Dialogue: 0,1:12:54.62,1:12:56.62,Default,,0,0,0,,Егер ол сіздің жолыңыздан шықпаса, оны лақтырып жібересіз бе? ?
Dialogue: 0,1:12:57.12,1:12:58.54,Default,,0,0,0,,Қандай ұлы батыр!
Dialogue: 0,1:12:58.62,1:13:00.54,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:13:00.62,1:13:02.58,Default,,0,0,0,,Уау! Ах...
Dialogue: 0,1:13:05.42,1:13:07.46,Default,,0,0,0,,Тоқта, Аслан! Капитан...
Dialogue: 0,1:13:07.54,1:13:08.88,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,1:13:08.96,1:13:11.30,Default,,0,0,0,,Гуааааа... шіркін!
Dialogue: 0,1:13:11.38,1:13:13.72,Default,,0,0,0,,-Жасай берейік -nnn...
Dialogue: 0,1:13:13.80,1:13:17.51,Default,,0,0,0,,Шалқыған бейбақты түзеу достың ісі.
Dialogue: 0,1:13:17.60,1:13:19.01,Default,,0,0,0,,Жақсы...
Dialogue: 0,1:13:19.10,1:13:21.98,Default,,0,0,0,,Мен... Мен мұны істеуім керек!
Dialogue: 0,1:13:22.73,1:13:24.90,Default,,0,0,0,,Маған ұнамайды, бірақ мен шарасызмын!
Dialogue: 0,1:13:24.98,1:13:26.81,Default,,0,0,0,,Маған неге айтпайсың!
Dialogue: 0,1:13:26.90,1:13:29.23,Default,,0,0,0,,Ешкімнен сұрамаңыз!
Dialogue: 0,1:13:29.32,1:13:31.90,Default,,0,0,0,,Өз бетіңізше не істей аласыз?
Dialogue: 0,1:13:31.99,1:13:33.53,Default,,0,0,0,,Уау!
Dialogue: 0,1:13:34.32,1:13:35.74,Default,,0,0,0,,Ахх...
Dialogue: 0,1:13:36.74,1:13:38.83,Default,,0,0,0,,Кук… nnnn…
Dialogue: 0,1:13:39.79,1:13:42.00,Default,,0,0,0,,Мен Лакуспен кездескім келеді...
Dialogue: 0,1:13:42.08,1:13:43.16,Default,,0,0,0,,Иә?
Dialogue: 0,1:13:43.79,1:13:45.33,Default,,0,0,0,,Люкс…
Dialogue: 0,1:13:45.42,1:13:49.04,Default,,0,0,0,,Мен сенің қасымда күлгеніңді қалаймын...
Dialogue: 0,1:13:49.13,1:13:53.05,Default,,0,0,0,,Мен енді не істерімді білмеймін!
Dialogue: 0,1:13:53.13,1:13:54.84,Default,,0,0,0,,Ах...
Dialogue: 0,1:13:54.93,1:13:56.80,Default,,0,0,0,,Біраз уақыт көрмеген соң—
Dialogue: 0,1:13:56.89,1:13:58.80,Default,,0,0,0,,Лакус қатты өзгерді.
Dialogue: 0,1:13:58.89,1:13:59.93,Default,,0,0,0,,Иә?
Dialogue: 0,1:14:00.35,1:14:03.39,Default,,0,0,0,,Бұны жасамасаң, бақытты болмайсың.
Dialogue: 0,1:14:03.48,1:14:05.35,Default,,0,0,0,,Қолыңнан келмесе жақсы емес.
Dialogue: 0,1:14:05.44,1:14:06.35,Default,,0,0,0,,Ха…
Dialogue: 0,1:14:06.44,1:14:09.31,Default,,0,0,0,,Мен білетін Лакус ешқашан мұндай нәрсені айтпас еді.
Dialogue: 0,1:14:09.40,1:14:11.69,Default,,0,0,0,,Иә! ? Ах...
Dialogue: 0,1:14:13.11,1:14:17.03,Default,,0,0,0,,Лакус әлемде бейбітшілік болғанын қалады.
Dialogue: 0,1:14:17.45,1:14:19.87,Default,,0,0,0,,Бірақ біреуге тыныштық беріңіз -
Dialogue: 0,1:14:19.95,1:14:22.70,Default,,0,0,0,,Сіз бірден сыйлық алуды ойлаған жоқсыз, солай ма?
Dialogue: 0,1:14:23.16,1:14:27.62,Default,,0,0,0,,Біреудің сізбен бірге сол мақсатқа жетуін қаламадыңыз ба?
Dialogue: 0,1:14:28.04,1:14:31.04,Default,,0,0,0,,Кішкентай болса да бір қадам...
Dialogue: 0,1:14:31.96,1:14:35.72,Default,,0,0,0,,Сіз әлі де солай ойлайсыз ба? Лакус - бұл...
Dialogue: 0,1:14:35.80,1:14:38.39,Default,,0,0,0,,Егер уайымдасаңыз, менімен кездесіп сұраңыз.
Dialogue: 0,1:14:38.47,1:14:39.30,Default,,0,0,0,,Иә?
Dialogue: 0,1:14:39.76,1:14:41.47,Default,,0,0,0,,Кеттік Кира
Dialogue: 0,1:14:42.43,1:14:43.89,Default,,0,0,0,,Лакусқа көмектесейік
Dialogue: 0,1:14:44.31,1:14:45.56,Default,,0,0,0,,Бізден
Dialogue: 0,1:14:46.10,1:14:49.23,Default,,0,0,0,,Кейде бір нәрсені сөзбен жеткізбейінше жеткізу мүмкін емес.
Dialogue: 0,1:14:50.65,1:14:51.82,Default,,0,0,0,,Әй!
Dialogue: 0,1:14:56.32,1:14:58.07,Default,,0,0,0,,Оянуды талдау—
Dialogue: 0,1:14:58.16,1:14:59.70,Default,,0,0,0,,Қордың шелегі келе жатыр —
Dialogue: 0,1:14:59.78,1:15:01.74,Default,,0,0,0,,Кеңістікті қысқартты
Dialogue: 0,1:15:01.83,1:15:05.50,Default,,0,0,0,,Шар туралы ақпаратпен біріктірілген Лакус, бәлкім...
Dialogue: 0,1:15:05.58,1:15:08.79,Default,,0,0,0,,Артемида бекінісі... Бұл қиыншылық.
Dialogue: 0,1:15:08.87,1:15:11.29,Default,,0,0,0,,Егер сіз Tory және Blue кванттық желісін пайдалансаңыз—
Dialogue: 0,1:15:11.38,1:15:13.09,Default,,0,0,0,,Лакустың орналасқан жерін анықтауға болады
Dialogue: 0,1:15:13.17,1:15:16.51,Default,,0,0,0,,Жақындағанша менің қайда екенімді білесің, солай ма?
Dialogue: 0,1:15:16.59,1:15:20.68,Default,,0,0,0,,Егер Лакус әлі де болса...
Dialogue: 0,1:15:20.76,1:15:22.47,Default,,0,0,0,,Кемемен не істейміз?
Dialogue: 0,1:15:22.55,1:15:25.52,Default,,0,0,0,,Бізде бұл жерде дұрыс күресетін мобильді костюмдер жоқ.
Dialogue: 0,1:15:25.60,1:15:28.56,Default,,0,0,0,,Мүмкін біз кеме сатып алармыз.
Dialogue: 0,1:15:28.64,1:15:31.36,Default,,0,0,0,,Бұл біршама өрескел әдіс.
Dialogue: 0,1:15:31.44,1:15:34.69,Default,,0,0,0,,Мен мобильді костюм туралы бірдеңе істей алатын шығармын.
Dialogue: 0,1:15:37.03,1:15:39.03,Default,,0,0,0,,Сізге Өкіл Атха сеніп тапсырды
Dialogue: 0,1:15:39.11,1:15:43.66,Default,,0,0,0,,Ол жаңа термоядролық реактордың және жаңа жабдықтың өнімділігін бағалау эксперименттері үшін пайдаланылды.
Dialogue: 0,1:15:43.74,1:15:46.87,Default,,0,0,0,,Мен мұндай жағдайды күтпедім.
Dialogue: 0,1:15:47.41,1:15:48.54,Default,,0,0,0,,Тағдыр!
Dialogue: 0,1:15:48.62,1:15:49.96,Default,,0,0,0,,Бостандық…
Dialogue: 0,1:15:50.04,1:15:52.83,Default,,0,0,0,,Қозғалыс жүйесі мен қару-жарақ бұрынғыдай.
Dialogue: 0,1:15:52.92,1:15:56.00,Default,,0,0,0,,Басқару жүйесі соңғы нұсқаға жаңартылды.
Dialogue: 0,1:15:56.09,1:16:00.43,Default,,0,0,0,,Қара рыцарьларға қарсы тұра алмаймын деп ойлаймын.
Dialogue: 0,1:16:00.51,1:16:04.14,Default,,0,0,0,,Жоқ, егер менде бұл болса, мен ол жігіттермен күресе алар едім!
Dialogue: 0,1:16:26.91,1:16:28.50,Default,,0,0,0,,Спорт күні керемет өтті, иә?
Dialogue: 0,1:16:30.75,1:16:31.92,Default,,0,0,0,,(Дабыл дыбысы)
Dialogue: 0,1:16:32.00,1:16:34.13,Default,,0,0,0,,Капитанның инъекциялық шабуылы.
Dialogue: 0,1:16:34.88,1:16:36.63,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,1:16:36.71,1:16:39.30,Default,,0,0,0,,Экипаж мүшелері кемені дереу тастап кетуі керек.
Dialogue: 0,1:16:39.38,1:16:42.59,Default,,0,0,0,,Төтенше жағдай туралы ескертуді қайталаңыз
Dialogue: 0,1:16:42.68,1:16:45.14,Default,,0,0,0,,Кеменің В палубасында түзілетін улы газ!
Dialogue: 0,1:16:45.22,1:16:46.22,Default,,0,0,0,,Не! ?
Dialogue: 0,1:16:48.14,1:16:49.47,Default,,0,0,0,,- (Артур) Иә? -(Мари) Қозғалма!
Dialogue: 0,1:16:49.56,1:16:50.89,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,1:16:52.14,1:16:54.98,Default,,0,0,0,,Бұл менің есебімнен екі минутқа баяу болды, капитан Ямато.
Dialogue: 0,1:16:56.48,1:16:58.19,Default,,0,0,0,,Капитан Коно?
Dialogue: 0,1:16:58.28,1:17:02.07,Default,,0,0,0,,Ұшу дайындығы аяқталды, полковник Рамиус.
Dialogue: 0,1:17:02.15,1:17:05.28,Default,,0,0,0,,Бізге бұл алаңдататын нәрсе керек емес.
Dialogue: 0,1:17:05.37,1:17:07.20,Default,,0,0,0,,Ннн…
Dialogue: 0,1:17:08.04,1:17:10.04,Default,,0,0,0,,Ммм...
Dialogue: 0,1:17:10.12,1:17:12.37,Default,,0,0,0,,-Қозғалма -Ха...
Dialogue: 0,1:17:12.46,1:17:14.79,Default,,0,0,0,,Қолдарыңызды көтеріп, мылтықты тастаңыз.
Dialogue: 0,1:17:18.46,1:17:20.55,Default,,0,0,0,,Хмм... Иә!
Dialogue: 0,1:17:20.63,1:17:22.05,Default,,0,0,0,,Уау...
Dialogue: 0,1:17:22.13,1:17:23.47,Default,,0,0,0,,Ах!
Dialogue: 0,1:17:23.55,1:17:24.68,Default,,0,0,0,,Уууу…
Dialogue: 0,1:17:24.76,1:17:27.14,Default,,0,0,0,,Ха... Луна! Мен мен!
Dialogue: 0,1:17:27.22,1:17:29.06,Default,,0,0,0,,Ха... Шин! ?
Dialogue: 0,1:17:29.14,1:17:32.23,Default,,0,0,0,,Ите... Иә?
Dialogue: 0,1:17:32.31,1:17:34.64,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:17:34.73,1:17:36.19,Default,,0,0,0,,- Шин! -Уау...
Dialogue: 0,1:17:38.86,1:17:41.28,Default,,0,0,0,,Идиот! Қазірдің өзінде ақымақ!
Dialogue: 0,1:17:41.36,1:17:44.11,Default,,0,0,0,,Мен сені өлді деп ойладым!
Dialogue: 0,1:17:44.20,1:17:45.53,Default,,0,0,0,,Уууу…
Dialogue: 0,1:17:45.99,1:17:49.62,Default,,0,0,0,,Итте~ Мен өлемін... Мен шынымен өлемін...
Dialogue: 0,1:17:49.70,1:17:51.66,Default,,0,0,0,,(Луна Марияның айқайы)
Dialogue: 0,1:17:51.75,1:17:52.79,Default,,0,0,0,,Фу…
Dialogue: 0,1:17:53.29,1:17:55.71,Default,,0,0,0,,Мыңжылдық ұрланды ма?
Dialogue: 0,1:17:55.79,1:17:56.75,Default,,0,0,0,,Ха!
Dialogue: 0,1:17:56.83,1:18:00.17,Default,,0,0,0,,Өсімдіктер және Атлантика федерациясы хабардар етілді -
Dialogue: 0,1:18:00.25,1:18:02.34,Default,,0,0,0,,Тіпті док айналасындағы спутниктік суреттерде —
Dialogue: 0,1:18:02.42,1:18:05.47,Default,,0,0,0,,Адамдар мен тауарлардың қозғалысы кенеттен күшейе түседі.
Dialogue: 0,1:18:05.55,1:18:08.97,Default,,0,0,0,,Хмф... Орб, күткендей.
Dialogue: 0,1:18:10.35,1:18:11.39,Default,,0,0,0,,Біз Артемида қамалындамыз...
Dialogue: 0,1:18:11.47,1:18:13.81,Default,,0,0,0,,Лакусты инфильтрациялау және құтқару
Dialogue: 0,1:18:13.89,1:18:17.44,Default,,0,0,0,,Қарсыластың табылуы мен жақындауын болдырмау үшін Мираж Коллоидты пайдаланыңыз.
Dialogue: 0,1:18:17.52,1:18:19.36,Default,,0,0,0,,Бұл Никольдің тактикасы...
Dialogue: 0,1:18:19.44,1:18:22.03,Default,,0,0,0,,Біз негізгі флотты бұзып өтіп, Айға бет аламыз.
Dialogue: 0,1:18:22.53,1:18:24.57,Default,,0,0,0,,Бұл алдау үшін...
Dialogue: 0,1:18:24.65,1:18:25.90,Default,,0,0,0,,Егер мен өзімнің жеке басын білсем—
Dialogue: 0,1:18:25.99,1:18:27.24,Default,,0,0,0,,Олар шарға бірден шабуыл жасайды.
Dialogue: 0,1:18:27.32,1:18:29.41,Default,,0,0,0,,Бұған дейін реквиемді бейтараптандырыңыз.
Dialogue: 0,1:18:29.49,1:18:32.79,Default,,0,0,0,,Реквиемнің корпусы қалқанмен жабылған және оны қалыпты атыс күшімен жою мүмкін емес.
Dialogue: 0,1:18:32.87,1:18:33.83,Default,,0,0,0,,Сәулелі реле нүктесі –
Dialogue: 0,1:18:33.91,1:18:35.83,Default,,0,0,0,,Мираж коллоидімен жасырылған
Dialogue: 0,1:18:35.91,1:18:39.17,Default,,0,0,0,,Біз оны іске қоспайынша оның қайда болатынын болжай алмаймыз.
Dialogue: 0,1:18:39.25,1:18:41.25,Default,,0,0,0,,Бір жерден басқа...
Dialogue: 0,1:18:42.05,1:18:43.34,Default,,0,0,0,,Тек бірінші реле нүктесі —
Dialogue: 0,1:18:43.42,1:18:45.92,Default,,0,0,0,,Реквиемнің үстінде, көзге көрінетін жерде болуы керек.
Dialogue: 0,1:18:46.01,1:18:48.26,Default,,0,0,0,,Егер ол іске қосу алдында болса, сөзсіз!
Dialogue: 0,1:18:53.01,1:18:55.35,Default,,0,0,0,,Капитан Рамиус
Dialogue: 0,1:18:55.43,1:18:58.27,Default,,0,0,0,,Не? Жоқ, бұл себеп емес...
Dialogue: 0,1:18:58.35,1:19:01.82,Default,,0,0,0,,Бұл кеме қазір Компас та, ZAFT да емес.
Dialogue: 0,1:19:01.90,1:19:04.73,Default,,0,0,0,,Бүлікші Қарақшы, былайша айтқанда.
Dialogue: 0,1:19:05.24,1:19:10.32,Default,,0,0,0,,Осы орындыққа дұрыс күресуді білетін адам отыруы керек.
Dialogue: 0,1:19:10.41,1:19:12.20,Default,,0,0,0,,Түсінікті
Dialogue: 0,1:19:12.28,1:19:15.00,Default,,0,0,0,,Енді мен сізге полковник Коноенің орынбасар болғанын қалаймын.
Dialogue: 0,1:19:15.08,1:19:16.08,Default,,0,0,0,,Қуаныштымын!
Dialogue: 0,1:19:16.16,1:19:17.41,Default,,0,0,0,,Не? иә! ?
Dialogue: 0,1:19:17.50,1:19:20.83,Default,,0,0,0,,Барлық бөлшектер тексерілді. Негізгі қозғалтқыштың өнімділігі артады
Dialogue: 0,1:19:21.75,1:19:24.76,Default,,0,0,0,,Рейтингке 30 секунд Жүзуге дайын аяқталды
Dialogue: 0,1:19:24.84,1:19:28.05,Default,,0,0,0,,- Тұманды шешу - Су ағынының қосылымы
Dialogue: 0,1:19:28.13,1:19:30.47,Default,,0,0,0,,(Инъекция дыбысы)
Dialogue: 0,1:19:35.89,1:19:39.35,Default,,0,0,0,,Millennium Advance Бірінші ұрыс жылдамдығы портынан шығыңыз
Dialogue: 0,1:19:50.36,1:19:51.70,Default,,0,0,0,,Тоқта!
Dialogue: 0,1:19:51.78,1:19:53.95,Default,,0,0,0,,Мыңжылдықты дереу тоқтатыңыз!
Dialogue: 0,1:19:54.66,1:19:56.87,Default,,0,0,0,,Егер сіз орындамасаңыз, біз сіздің кемеңізге шабуыл жасаймыз.
Dialogue: 0,1:19:56.95,1:19:59.79,Default,,0,0,0,,Жолда болыңыз! Екі жақ соғыстың екінші жылдамдығы
Dialogue: 0,1:19:59.87,1:20:01.83,Default,,0,0,0,,Е... иә! ? бірақ!
Dialogue: 0,1:20:03.00,1:20:05.25,Default,,0,0,0,,Атуға мүмкіндік береді!
Dialogue: 0,1:20:05.34,1:20:06.88,Default,,0,0,0,,Түсіндің бе? капитан
Dialogue: 0,1:20:06.96,1:20:10.68,Default,,0,0,0,,Ха! 100 соққы және 100 жіберіп алу - Тодака адмиралының дайындығы!
Dialogue: 0,1:20:10.76,1:20:12.59,Default,,0,0,0,,Қалай түсіруге болады Start!
Dialogue: 0,1:20:12.68,1:20:14.76,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,1:20:15.76,1:20:17.10,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:20:17.18,1:20:19.52,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:20:22.02,1:20:24.36,Default,,0,0,0,,Аа... Бұл фарс.
Dialogue: 0,1:20:25.23,1:20:26.27,Default,,0,0,0,,Біздің ескерту
Dialogue: 0,1:20:26.36,1:20:29.44,Default,,0,0,0,,Сіз шарды елемеген сияқтысыз.
Dialogue: 0,1:20:29.53,1:20:34.03,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Жауапқа әлі уақыт бар!
Dialogue: 0,1:20:34.12,1:20:37.62,Default,,0,0,0,,Мен қазір сіздің еліңіздің талаптарын Конгресске алып барамын.
Dialogue: 0,1:20:37.70,1:20:39.79,Default,,0,0,0,,Бұл анық қулық.
Dialogue: 0,1:20:39.87,1:20:42.17,Default,,0,0,0,,Мұнда да мыңжылдықтың қозғалысы түсініледі.
Dialogue: 0,1:20:42.25,1:20:43.08,Default,,0,0,0,,Жоқ…
Dialogue: 0,1:20:43.17,1:20:46.09,Default,,0,0,0,,10 минуттан кейін еліңізге қарай Реквиемді іске қосыңыз.
Dialogue: 0,1:20:46.17,1:20:50.01,Default,,0,0,0,,Күте тұрыңыз! Мыңжылдықты біреу басып алған.
Dialogue: 0,1:20:50.09,1:20:51.13,Default,,0,0,0,,Бұрынғы зауытқа келсек...
Dialogue: 0,1:20:51.22,1:20:54.68,Default,,0,0,0,,Айттым ғой, азғантай қимыл болса, атып жіберемін.
Dialogue: 0,1:20:54.76,1:20:57.47,Default,,0,0,0,,Түсінбеушілік! Бұл мәселемен не істеп жатырмыз?
Dialogue: 0,1:20:57.93,1:21:01.52,Default,,0,0,0,,Бұл ел ерте ме, кеш пе шабуылға ұшырауы керек.
Dialogue: 0,1:21:01.60,1:21:02.64,Default,,0,0,0,,Фу…
Dialogue: 0,1:21:02.73,1:21:04.98,Default,,0,0,0,,Барлық азаматтарды шұғыл эвакуациялау
Dialogue: 0,1:21:05.06,1:21:07.73,Default,,0,0,0,,Орб әскері мұны бар күшімен қолдауы керек!
Dialogue: 0,1:21:07.82,1:21:11.15,Default,,0,0,0,,Үкімет функциялары Оногоро аралының әуе қорғанысы нысанына көшірілді
Dialogue: 0,1:21:11.24,1:21:12.57,Default,,0,0,0,,Кагари-ни-сама...
Dialogue: 0,1:21:12.65,1:21:14.53,Default,,0,0,0,,Асығыңыз, бар болғаны 10 минутыңыз бар!
Dialogue: 0,1:21:18.54,1:21:20.50,Default,,0,0,0,,Қозғалтқыштың максималды көтерілуі
Dialogue: 0,1:21:20.58,1:21:22.54,Default,,0,0,0,,Негізгі қозғалтқыштың қосылуы
Dialogue: 0,1:21:22.62,1:21:24.21,Default,,0,0,0,,(Инъекция дыбысы)
Dialogue: 0,1:21:24.29,1:21:25.83,Default,,0,0,0,,Millennium Launch!
Dialogue: 0,1:21:36.26,1:21:37.93,Default,,0,0,0,,А... Капитан!
Dialogue: 0,1:21:38.01,1:21:39.97,Default,,0,0,0,,Ах... Негіз!
Dialogue: 0,1:21:40.06,1:21:42.27,Default,,0,0,0,,Реквием Іске қосуға дайын!
Dialogue: 0,1:21:42.35,1:21:44.94,Default,,0,0,0,,Мақсат - Orb Capital Orophat.
Dialogue: 0,1:21:45.02,1:21:47.36,Default,,0,0,0,,Азаматтар, нұсқауларды орындаңыз -
Dialogue: 0,1:21:47.44,1:21:49.69,Default,,0,0,0,,Тез арада эвакуациялаңыз
Dialogue: 0,1:21:51.57,1:21:53.74,Default,,0,0,0,,Мен саған кейінірек барамын, Тоя.
Dialogue: 0,1:21:53.82,1:21:56.24,Default,,0,0,0,,Кагалли-ни-сама... сақ болыңыз.
Dialogue: 0,1:21:56.32,1:21:57.78,Default,,0,0,0,,Мен сен демалыс үйін сатып аламыз дедің деп анық естідім.
Dialogue: 0,1:21:57.87,1:21:59.41,Default,,0,0,0,,Мәртебелі Машиманың отырғызуын растау.
Dialogue: 0,1:21:59.49,1:22:00.95,Default,,0,0,0,,Өкіл Асуха!
Dialogue: 0,1:22:01.04,1:22:03.41,Default,,0,0,0,,Strike Rouge Cavalier Aifrid 2
Dialogue: 0,1:22:03.50,1:22:05.08,Default,,0,0,0,,Дайын! Асығыңыз!
Dialogue: 0,1:22:05.17,1:22:06.63,Default,,0,0,0,,Түсіндім
Dialogue: 0,1:22:09.13,1:22:11.21,Default,,0,0,0,,Сізді алдауыма жол бермейсіз деп үміттенемін!
Dialogue: 0,1:22:11.30,1:22:12.84,Default,,0,0,0,,Екінші жағы басынан -
Dialogue: 0,1:22:12.92,1:22:15.76,Default,,0,0,0,,Сылтауым болса ғой, шарды атайын деп едім!
Dialogue: 0,1:22:22.35,1:22:26.31,Default,,0,0,0,,Әке, халықты қорғай көр...
Dialogue: 0,1:22:26.39,1:22:27.44,Default,,0,0,0,,Кира!
Dialogue: 0,1:22:29.19,1:22:31.02,Default,,0,0,0,,Қоштасу шары
Dialogue: 0,1:22:31.11,1:22:33.28,Default,,0,0,0,,Foundation Сіз мені ести аласыз ба?
Dialogue: 0,1:22:33.36,1:22:35.86,Default,,0,0,0,,Бұл Мыңжылдық Кира Ямато
Dialogue: 0,1:22:35.95,1:22:38.57,Default,,0,0,0,,Халықаралық құтқару арнасында хабарларды қабылдаңыз
Dialogue: 0,1:22:38.66,1:22:39.74,Default,,0,0,0,,Не! ?
Dialogue: 0,1:22:39.82,1:22:43.37,Default,,0,0,0,,Өкініштісі, мен әлі тірімін
Dialogue: 0,1:22:43.45,1:22:46.87,Default,,0,0,0,,Өзін өлтірмекші болып, тіпті өз халқын да құрбандыққа шалды.
Dialogue: 0,1:22:46.96,1:22:48.71,Default,,0,0,0,,Не деп тұрсың, Шура!
Dialogue: 0,1:22:48.79,1:22:50.92,Default,,0,0,0,,Ақымақ... ондай жағдайда! ?
Dialogue: 0,1:22:51.00,1:22:54.34,Default,,0,0,0,,Адамзатқа жетекшілік ететін сен емессің.
Dialogue: 0,1:22:54.42,1:22:56.01,Default,,0,0,0,,Жай ғана кісі өлтіруші!
Dialogue: 0,1:22:56.09,1:22:59.68,Default,,0,0,0,,Біз шындықты білеміз, дәлел бар
Dialogue: 0,1:22:59.76,1:23:02.35,Default,,0,0,0,,Бұл туралы әлемге айтыңыз
Dialogue: 0,1:23:02.43,1:23:04.14,Default,,0,0,0,,Сіздер жеңілдіңдер!
Dialogue: 0,1:23:04.22,1:23:06.14,Default,,0,0,0,,Бұл аккорд па, әлде бір нәрсе ме, білмеймін.
Dialogue: 0,1:23:06.23,1:23:08.94,Default,,0,0,0,,Біз қырғыншылардың қастандықтарын мүлде жоямыз!
Dialogue: 0,1:23:09.02,1:23:10.56,Default,,0,0,0,,Мен сізге айтайын ...
Dialogue: 0,1:23:10.65,1:23:11.77,Default,,0,0,0,,Анашым!
Dialogue: 0,1:23:11.86,1:23:13.86,Default,,0,0,0,,Мына бейбақты өлтір!
Dialogue: 0,1:23:13.94,1:23:16.24,Default,,0,0,0,,Реквием Мақсат – мыңжылдық!
Dialogue: 0,1:23:16.74,1:23:18.15,Default,,0,0,0,,Әрине, оны есінен тандырып тастаған дұрыс қой?
Dialogue: 0,1:23:18.24,1:23:19.70,Default,,0,0,0,,Саманның өмірі ғой!
Dialogue: 0,1:23:19.78,1:23:21.74,Default,,0,0,0,,Айдың арғы жағындағы жоғары энергиялық реакция!
Dialogue: 0,1:23:21.83,1:23:24.33,Default,,0,0,0,,Танхаузерді іске қосу Төтенше тежеу!
Dialogue: 0,1:23:27.46,1:23:29.33,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,1:23:38.68,1:23:40.09,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:23:42.60,1:23:44.01,Default,,0,0,0,,Ти!
Dialogue: 0,1:23:44.68,1:23:46.02,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,1:23:46.10,1:23:47.43,Default,,0,0,0,,(Инъекция дыбысы)
Dialogue: 0,1:23:50.44,1:23:53.02,Default,,0,0,0,,Мыңжылдық электромагниттік импульстің әсерінен жоғалады
Dialogue: 0,1:23:53.11,1:23:55.61,Default,,0,0,0,,Қат! Керемет...
Dialogue: 0,1:23:55.69,1:23:58.45,Default,,0,0,0,,Барлық әскерлерге қазірден бастап біз...
Dialogue: 0,1:23:58.53,1:24:01.95,Default,,0,0,0,,Отаныңды қорғауға күшіңді жұмса!
Dialogue: 0,1:24:02.03,1:24:03.87,Default,,0,0,0,,Отанды қорғау директивасы шығарылды!
Dialogue: 0,1:24:04.41,1:24:06.91,Default,,0,0,0,,Компас кеңесінің мүшесі Millennium Eternal және—
Dialogue: 0,1:24:07.00,1:24:08.71,Default,,0,0,0,,Тактикалық байланыстарды құрастыру
Dialogue: 0,1:24:08.79,1:24:13.13,Default,,0,0,0,,Әскерилер бейбіт тұрғындардың қауіпсіздігін бірінші орынға қойып, дереу эвакуациялау бойынша басшылықты жалғастыруы керек!
Dialogue: 0,1:24:18.92,1:24:21.34,Default,,0,0,0,,Ол ядролық энергияға айналдырылғанымен...
Dialogue: 0,1:24:21.43,1:24:24.64,Default,,0,0,0,,Жарайды, мен бұл ескі ұшақты ұстадым.
Dialogue: 0,1:24:24.72,1:24:26.64,Default,,0,0,0,,Маған ұнайды.
Dialogue: 0,1:24:26.72,1:24:28.81,Default,,0,0,0,,Заку басқару жүйесін пайдалану оңай
Dialogue: 0,1:24:28.89,1:24:31.35,Default,,0,0,0,,Исаак Жюль дуэлі іске қосылды!
Dialogue: 0,1:24:31.44,1:24:34.02,Default,,0,0,0,,Құрметті Элсман Бастер ұшыру!
Dialogue: 0,1:24:37.86,1:24:40.65,Default,,0,0,0,,Жарайды, Мари, мен барамын.
Dialogue: 0,1:24:40.74,1:24:43.20,Default,,0,0,0,,Иә, сөзсіз Лакус-сан...
Dialogue: 0,1:24:43.28,1:24:44.12,Default,,0,0,0,,Иә
Dialogue: 0,1:24:45.74,1:24:46.79,Default,,0,0,0,,Шин
Dialogue: 0,1:24:46.87,1:24:48.20,Default,,0,0,0,,Ха…
Dialogue: 0,1:24:48.29,1:24:50.33,Default,,0,0,0,,Мен мыңжылдықты сұраймын.
Dialogue: 0,1:24:50.41,1:24:51.75,Default,,0,0,0,,Иә?
Dialogue: 0,1:24:52.96,1:24:53.79,Default,,0,0,0,,Иә!
Dialogue: 0,1:24:54.25,1:24:55.84,Default,,0,0,0,,Сізге жақсы, монах.
Dialogue: 0,1:24:55.92,1:24:58.38,Default,,0,0,0,,Бұл өте қарапайым.
Dialogue: 0,1:24:58.46,1:24:59.46,Default,,0,0,0,,Хэхе...
Dialogue: 0,1:24:59.55,1:25:00.80,Default,,0,0,0,,Біртүрлі болды ма?
Dialogue: 0,1:25:00.88,1:25:01.97,Default,,0,0,0,,Жоқ
Dialogue: 0,1:25:02.05,1:25:03.84,Default,,0,0,0,,Жақсы емес пе?
Dialogue: 0,1:25:03.93,1:25:04.97,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,1:25:09.72,1:25:11.81,Default,,0,0,0,,-Неге... -Иә?
Dialogue: 0,1:25:11.89,1:25:13.23,Default,,0,0,0,,Неліктен ханшайым?
Dialogue: 0,1:25:13.31,1:25:15.90,Default,,0,0,0,,Тағдырыңа көнбейсің бе?
Dialogue: 0,1:25:15.98,1:25:17.02,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,1:25:17.11,1:25:19.23,Default,,0,0,0,,Бізге өкілеттік берілген
Dialogue: 0,1:25:19.32,1:25:22.82,Default,,0,0,0,,Мен не істеу керектігін біліп дүниеге келдім.
Dialogue: 0,1:25:22.90,1:25:26.53,Default,,0,0,0,,Осыған сәйкес өмір сүру және басқаларға қажет болу...
Dialogue: 0,1:25:26.62,1:25:28.87,Default,,0,0,0,,Бұл біздің бақытымыз емес пе?
Dialogue: 0,1:25:29.54,1:25:34.75,Default,,0,0,0,,Әрбір өмір өз өмір сүру жолын таңдауға құқылы деп есептеймін.
Dialogue: 0,1:25:34.83,1:25:37.54,Default,,0,0,0,,Бұл мен қалаған тағдыр емес
Dialogue: 0,1:25:37.63,1:25:39.92,Default,,0,0,0,,Бұл күрес мәңгілікке жалғасады.
Dialogue: 0,1:25:40.00,1:25:43.05,Default,,0,0,0,,Барлығы уайымдайды, адасып, қиналады...
Dialogue: 0,1:25:43.13,1:25:45.22,Default,,0,0,0,,Ханшайымның қалауы осы ма?
Dialogue: 0,1:25:45.30,1:25:46.18,Default,,0,0,0,,Ах...
Dialogue: 0,1:25:46.26,1:25:49.47,Default,,0,0,0,,Ханшайым өзінің бақытын түсінбейді!
Dialogue: 0,1:25:49.56,1:25:50.39,Default,,0,0,0,,Иә?
Dialogue: 0,1:25:50.77,1:25:53.14,Default,,0,0,0,,Мен әлемді билей алсам да,
Dialogue: 0,1:25:53.23,1:25:55.94,Default,,0,0,0,,Орфейді неге қабылдамайсың?
Dialogue: 0,1:25:56.65,1:25:58.48,Default,,0,0,0,,Сен мұнымен жақсысың ба?
Dialogue: 0,1:25:58.57,1:26:00.15,Default,,0,0,0,,Не? (есіктің ашылған дыбысы)
Dialogue: 0,1:26:01.78,1:26:03.90,Default,,0,0,0,,Басыңыз суық болды ма?
Dialogue: 0,1:26:03.99,1:26:07.24,Default,,0,0,0,,Сіз де өз миссияңызды білуіңіз керек.
Dialogue: 0,1:26:07.32,1:26:09.28,Default,,0,0,0,,Менің қолымды алғың келе ме?
Dialogue: 0,1:26:09.70,1:26:12.41,Default,,0,0,0,,Қанша сұрақ қойсаң да, жауабы бір.
Dialogue: 0,1:26:12.50,1:26:15.08,Default,,0,0,0,,Мен жақсы көретін сен емессің
Dialogue: 0,1:26:15.17,1:26:16.00,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,1:26:16.08,1:26:17.92,Default,,0,0,0,,Кира Ямато қайтыс болды!
Dialogue: 0,1:26:18.00,1:26:19.84,Default,,0,0,0,,Жоқ, өлген жоқ.
Dialogue: 0,1:26:19.92,1:26:22.26,Default,,0,0,0,,Неге фактілерді қабылдамайсың! ?
Dialogue: 0,1:26:22.34,1:26:24.55,Default,,0,0,0,,Себебі мен оған сенемін
Dialogue: 0,1:26:24.63,1:26:25.47,Default,,0,0,0,,Хмм...
Dialogue: 0,1:26:25.55,1:26:27.89,Default,,0,0,0,,(Бөлме ішінен естілетін дыбыстар)
Dialogue: 0,1:26:27.97,1:26:29.05,Default,,0,0,0,,Неге! ?
Dialogue: 0,1:26:29.14,1:26:32.72,Default,,0,0,0,,Неге ондай жігіт... Аккорд бола алмаған сәтсіздік!
Dialogue: 0,1:26:32.81,1:26:35.52,Default,,0,0,0,,Өйткені ол мен сүйемін деп таңдаған адам.
Dialogue: 0,1:26:35.60,1:26:38.98,Default,,0,0,0,,Ол сіз қалаған нәрсені жасай алмады.
Dialogue: 0,1:26:39.06,1:26:40.40,Default,,0,0,0,,Бейбіт әлем!
Dialogue: 0,1:26:40.48,1:26:43.32,Default,,0,0,0,,Ол адам сенің жаныңда болуға лайық па?
Dialogue: 0,1:26:43.40,1:26:47.74,Default,,0,0,0,,Махаббаттың қасиеті жоқ, соны түсінбейсің бе?
Dialogue: 0,1:26:49.95,1:26:52.04,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,1:26:53.24,1:26:55.33,Default,,0,0,0,,Адамдарды күшпен бағындыра алсаңыз да—
Dialogue: 0,1:26:55.41,1:26:58.29,Default,,0,0,0,,Ақыл-ойды ешқашан бағындыру мүмкін емес
Dialogue: 0,1:26:58.37,1:26:59.96,Default,,0,0,0,,Не істесеңіз де—
Dialogue: 0,1:27:00.04,1:27:03.13,Default,,0,0,0,,Мен ішімдегі ұшқынды өшіре алмаймын.
Dialogue: 0,1:27:04.21,1:27:05.76,Default,,0,0,0,,Неліктен?
Dialogue: 0,1:27:05.84,1:27:08.97,Default,,0,0,0,,Сен менімен бірге әлемді билеу үшін тудың.
Dialogue: 0,1:27:09.05,1:27:11.30,Default,,0,0,0,,Бірақ неге мені қабылдамайсың? ?
Dialogue: 0,1:27:11.39,1:27:12.85,Default,,0,0,0,,Менің махаббатым!
Dialogue: 0,1:27:12.93,1:27:15.27,Default,,0,0,0,,Сіздің сүйікті «Лакус Клайн» -
Dialogue: 0,1:27:15.35,1:27:16.64,Default,,0,0,0,,Мен емес
Dialogue: 0,1:27:16.73,1:27:18.44,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,1:27:18.52,1:27:20.27,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,1:27:20.36,1:27:21.56,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,1:27:21.65,1:27:23.73,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,1:27:23.82,1:27:25.78,Default,,0,0,0,,Мен айға бара жатырмын
Dialogue: 0,1:27:26.24,1:27:29.07,Default,,0,0,0,,Мен мұнда қорғауды Шура екеуіңе қалдырамын.
Dialogue: 0,1:27:29.16,1:27:30.20,Default,,0,0,0,,Иә
Dialogue: 0,1:27:30.28,1:27:32.62,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,1:27:33.08,1:27:35.20,Default,,0,0,0,,Жоғары мәртебелі Премьер-Министр көпірде
Dialogue: 0,1:27:35.29,1:27:38.67,Default,,0,0,0,,Мыңжылдық және басқа жау флоттарының қозғалысы туралы не деуге болады?
Dialogue: 0,1:27:38.75,1:27:41.83,Default,,0,0,0,,Орб Ай флоты және Жердің қалған флоты:
Dialogue: 0,1:27:41.92,1:27:43.34,Default,,0,0,0,,Реквиемге бағыт
Dialogue: 0,1:27:43.42,1:27:47.09,Default,,0,0,0,,Алдыңғы жағында орналасқан ZAFT флотымен шайқас күтілуде.
Dialogue: 0,1:27:47.17,1:27:49.97,Default,,0,0,0,,Мыңжылдық Мен мұнда ең қысқа курспен келе жатырмын.
Dialogue: 0,1:27:50.05,1:27:52.26,Default,,0,0,0,,Қарсыластың күтілетін уақытына шамамен 4 минут қалды
Dialogue: 0,1:27:52.35,1:27:55.06,Default,,0,0,0,,Бүкіл флоттың CW (Krone Wing) қалыптасуы
Dialogue: 0,1:27:55.14,1:27:57.39,Default,,0,0,0,,Кері салыстырмалы жылдамдықты реттеу
Dialogue: 0,1:27:57.48,1:28:00.77,Default,,0,0,0,,Он екі оң электронды мылтық Жау кемесі Болжалды бағытты көздеңіз!
Dialogue: 0,1:28:00.85,1:28:03.82,Default,,0,0,0,,Көпірді қамту Бірінші жауынгерлік орналастыру
Dialogue: 0,1:28:03.90,1:28:08.65,Default,,0,0,0,,Бұл позитронды зеңбіректі бұл құрамда қолдануға болмайды.
Dialogue: 0,1:28:08.74,1:28:10.82,Default,,0,0,0,,Жарайды, менде жаңа қару бар.
Dialogue: 0,1:28:10.91,1:28:13.07,Default,,0,0,0,,Ыстыққа төзімді және соққыға төзімді кристалды құрыш орналастырылған!
Dialogue: 0,1:28:19.54,1:28:21.37,Default,,0,0,0,,Тактика Базирулді орындайды
Dialogue: 0,1:28:21.46,1:28:23.96,Default,,0,0,0,,Зымыран уақытын енгізу аяқталды
Dialogue: 0,1:28:25.25,1:28:26.80,Default,,0,0,0,,Сәулелік тереңдікке қарсы зарядты іске қосу
Dialogue: 0,1:28:28.30,1:28:30.17,Default,,0,0,0,,Tristan CIWS белсендіру
Dialogue: 0,1:28:30.26,1:28:33.43,Default,,0,0,0,,Зымыран ұшыру түтігі Neidhardt Dispar тиеу
Dialogue: 0,1:28:33.51,1:28:36.14,Default,,0,0,0,,Ортасын максималды ұрыс жылдамдығымен бұзыңыз!
Dialogue: 0,1:28:36.22,1:28:37.06,Default,,0,0,0,,Фейер!
Dialogue: 0,1:28:37.14,1:28:38.22,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,1:28:39.48,1:28:41.73,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,1:28:44.90,1:28:46.36,Default,,0,0,0,,Егер сіз одан жалтармасаңыз! ?
Dialogue: 0,1:28:46.44,1:28:48.53,Default,,0,0,0,,Dispar CIWS
Dialogue: 0,1:28:48.61,1:28:50.07,Default,,0,0,0,,Қалай түсіру керек Start!
Dialogue: 0,1:28:51.24,1:28:52.49,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:28:52.57,1:28:53.66,Default,,0,0,0,,Сен шыдай аласың ба?
Dialogue: 0,1:28:53.74,1:28:54.70,Default,,0,0,0,,Әрине!
Dialogue: 0,1:28:57.70,1:28:58.79,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,1:29:00.75,1:29:02.21,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:29:02.29,1:29:04.17,Default,,0,0,0,,Бұлай етпеңдер, ұрылар...
Dialogue: 0,1:29:04.58,1:29:08.21,Default,,0,0,0,,Қарсыластың күткен жолы бойынша өте жоғары жылдамдықтағы кемеге қарсы басқарылатын зымырандарды таратыңыз.
Dialogue: 0,1:29:08.30,1:29:10.76,Default,,0,0,0,,Барлық кемелер бұрылады Қарсыласты бар жылдамдықпен қуыңыз!
Dialogue: 0,1:29:10.84,1:29:12.38,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,1:29:12.47,1:29:15.30,Default,,0,0,0,,Ультра жоғары жылдамдықты зымыранмен жақындау Pursuit!
Dialogue: 0,1:29:15.39,1:29:17.18,Default,,0,0,0,,Жау флотының бұрылуы!
Dialogue: 0,1:29:17.26,1:29:18.10,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,1:29:18.18,1:29:21.85,Default,,0,0,0,,Диспарды ат! Кеме 180 градусқа бұрылады
Dialogue: 0,1:29:21.93,1:29:25.02,Default,,0,0,0,,Сол жақ дрейфтің салыстырмалы жылдамдығын сәйкестендіру!
Dialogue: 0,1:29:25.10,1:29:26.77,Default,,0,0,0,,Барлық мобильді костюмдер шығады!
Dialogue: 0,1:29:29.53,1:29:32.86,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:29:35.87,1:29:38.20,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:29:38.28,1:29:41.12,Default,,0,0,0,,Катапульт қосылымы Барлық жүйелер онлайн
Dialogue: 0,1:29:41.20,1:29:44.29,Default,,0,0,0,,1-ден 10-ға дейінгі супер электрлік конденсаторлар критикалық деңгейге жетеді
Dialogue: 0,1:29:44.92,1:29:47.71,Default,,0,0,0,,Нұсқау жүйесінің ауытқуы жоқ Курс анық
Dialogue: 0,1:29:48.46,1:29:50.55,Default,,0,0,0,,Тағдыр, ұшыңыз.
Dialogue: 0,1:29:50.63,1:29:53.22,Default,,0,0,0,,Шинн Асука Destiny Go!
Dialogue: 0,1:29:54.22,1:29:56.14,Default,,0,0,0,,Импульс, ұшыңыз.
Dialogue: 0,1:29:56.22,1:29:59.72,Default,,0,0,0,,Lunamaria Hawk Impulse Кеттік!
Dialogue: 0,1:29:59.81,1:30:02.14,Default,,0,0,0,,Гельгуг, бастаңыз.
Dialogue: 0,1:30:02.23,1:30:04.64,Default,,0,0,0,,Хилда Хакен Гельгуг Кеттік!
Dialogue: 0,1:30:06.15,1:30:09.98,Default,,0,0,0,,Мен әскери кеменің көпіріне барамын. Рақмет сізге.
Dialogue: 0,1:30:10.07,1:30:11.44,Default,,0,0,0,,Шыгандшинаға баратын жолды іздеуге аттанған Зерттеу корпусы,
Dialogue: 0,1:30:11.53,1:30:14.40,Default,,0,0,0,,Негізгі көпір шайқас режиміне ауысу
Dialogue: 0,1:30:14.49,1:30:18.07,Default,,0,0,0,,Нұсқаулық жүйе онлайн Барлық силуэттерді шығару!
Dialogue: 0,1:30:34.17,1:30:36.76,Default,,0,0,0,,Жау кемесі №3 мобильді костюмді ұшырды
Dialogue: 0,1:30:36.84,1:30:38.55,Default,,0,0,0,,ұстап алу! Жоқ, күте тұрыңыз...
Dialogue: 0,1:30:39.64,1:30:41.22,Default,,0,0,0,,Кира Ямато қайда?
Dialogue: 0,1:30:43.22,1:30:45.81,Default,,0,0,0,,Жылжымалы костюм келе жатыр. №1
Dialogue: 0,1:30:45.89,1:30:46.94,Default,,0,0,0,,Бостандық!
Dialogue: 0,1:30:47.02,1:30:49.36,Default,,0,0,0,,- (Аура Ингрид) Иә! ? -Мұны қайдан білдің?
Dialogue: 0,1:30:50.11,1:30:53.69,Default,,0,0,0,,Бірақ мен ханшайымды құтқару үшін ол мені бір ғана машинамен шақырады деп күтпедім...
Dialogue: 0,1:30:53.78,1:30:56.20,Default,,0,0,0,,Жылатпайсың ба, Шура?
Dialogue: 0,1:30:56.28,1:31:00.62,Default,,0,0,0,,Олай болса, топ болып күресу ақымақтық болар, сондықтан мен келемін.
Dialogue: 0,1:31:00.70,1:31:02.08,Default,,0,0,0,,Ақылсыз үміттер
Dialogue: 0,1:31:02.16,1:31:04.91,Default,,0,0,0,,Оны бөлшектеңіз.
Dialogue: 0,1:31:05.00,1:31:06.08,Default,,0,0,0,,Ерік!
Dialogue: 0,1:31:07.96,1:31:09.00,Default,,0,0,0,,Лакус
Dialogue: 0,1:31:09.46,1:31:10.67,Default,,0,0,0,,Кира! ?
Dialogue: 0,1:31:10.75,1:31:14.01,Default,,0,0,0,,Не? Бұл ызылдаған сезім...
Dialogue: 0,1:31:14.09,1:31:17.34,Default,,0,0,0,,Бірақ күштерді соқыр түрде тарату үшін...
Dialogue: 0,1:31:17.43,1:31:20.76,Default,,0,0,0,,Мобильді костюм отряды ұшырылды, жауды жойыңыз!
Dialogue: 0,1:31:22.26,1:31:25.73,Default,,0,0,0,,Тағдыр? Олар бір топ ақымақ.
Dialogue: 0,1:31:25.81,1:31:28.19,Default,,0,0,0,,Бұл аздап өлтіруге тұрарлық емес пе?
Dialogue: 0,1:31:28.27,1:31:31.44,Default,,0,0,0,,Сарбаздарды оқытуға өте ыңғайлы.
Dialogue: 0,1:31:31.86,1:31:34.23,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,1:31:34.94,1:31:36.78,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:31:37.99,1:31:39.91,Default,,0,0,0,,Оны атамаңыз!
Dialogue: 0,1:31:39.99,1:31:41.12,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,1:31:41.20,1:31:43.03,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:31:43.12,1:31:45.04,Default,,0,0,0,,Мен де!
Dialogue: 0,1:31:45.87,1:31:46.91,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,1:31:47.00,1:31:48.96,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:31:57.92,1:31:59.22,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,1:31:59.30,1:32:03.14,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:32:13.73,1:32:15.32,Default,,0,0,0,,Бұл жолы жіберіп алмаңыз!
Dialogue: 0,1:32:19.99,1:32:21.20,Default,,0,0,0,,Тс!
Dialogue: 0,1:32:25.49,1:32:26.54,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,1:32:26.62,1:32:29.71,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:32:29.79,1:32:32.50,Default,,0,0,0,,Ху... Қорғаныс сызығының ішінде кенет дыбыс шықты.
Dialogue: 0,1:32:32.58,1:32:35.42,Default,,0,0,0,,- Ха! ? - Мен онымен айналысамын.
Dialogue: 0,1:32:35.50,1:32:37.51,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:32:38.42,1:32:42.76,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:32:50.02,1:32:51.60,Default,,0,0,0,,Тез, тез, тез...
Dialogue: 0,1:32:52.23,1:32:54.15,Default,,0,0,0,,Барлық қалқандар жабылуға мәжбүр!
Dialogue: 0,1:33:01.49,1:33:03.95,Default,,0,0,0,,Мен білмеймін... неге?
Dialogue: 0,1:33:05.95,1:33:08.79,Default,,0,0,0,,- Митомета Кунай! - (Қызыл гало) Міне кеттік!
Dialogue: 0,1:33:08.87,1:33:11.16,Default,,0,0,0,,- Полковник Кисака - Кеттік!
Dialogue: 0,1:33:11.79,1:33:14.13,Default,,0,0,0,,Гало-гало Гало-гало
Dialogue: 0,1:33:14.21,1:33:16.29,Default,,0,0,0,,Ақанде!
Dialogue: 0,1:33:17.13,1:33:18.71,Default,,0,0,0,,Зеккочо!
Dialogue: 0,1:33:20.63,1:33:22.68,Default,,0,0,0,,Жоқ, бақылау алынып тасталды!
Dialogue: 0,1:33:22.76,1:33:24.22,Default,,0,0,0,,Жүйе өшірілді!
Dialogue: 0,1:33:24.30,1:33:27.01,Default,,0,0,0,,Не істеп жатырсың! ? Шураны қайтар!
Dialogue: 0,1:33:27.10,1:33:28.93,Default,,0,0,0,,Хабарласу мүмкін емес!
Dialogue: 0,1:33:29.02,1:33:30.27,Default,,0,0,0,,Ха…
Dialogue: 0,1:33:30.35,1:33:32.18,Default,,0,0,0,,Ах, ах…
Dialogue: 0,1:33:36.19,1:33:37.48,Default,,0,0,0,,Ха…
Dialogue: 0,1:33:39.82,1:33:41.53,Default,,0,0,0,,...
Dialogue: 0,1:33:41.61,1:33:42.45,Default,,0,0,0,,Ха…
Dialogue: 0,1:33:42.53,1:33:43.86,Default,,0,0,0,,Тори
Dialogue: 0,1:33:52.87,1:33:53.91,Default,,0,0,0,,Құрметті сізге...
Dialogue: 0,1:33:56.67,1:33:58.29,Default,,0,0,0,,Атрун Зара, солай ма?
Dialogue: 0,1:33:58.38,1:34:01.26,Default,,0,0,0,,Сіз ойларды оқи алмадыңыз ба?
Dialogue: 0,1:34:01.34,1:34:03.30,Default,,0,0,0,,Мен оны пайдалана алмаймын.
Dialogue: 0,1:34:03.38,1:34:04.47,Default,,0,0,0,,Һм? Ә… Не? Неге?
Dialogue: 0,1:34:10.93,1:34:12.31,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:34:14.06,1:34:16.10,Default,,0,0,0,,Мен сені бере алмаймын
Dialogue: 0,1:34:17.06,1:34:18.98,Default,,0,0,0,,Кира келді, солай ма?
Dialogue: 0,1:34:19.61,1:34:21.03,Default,,0,0,0,,Сізді не бақытты етеді! ?
Dialogue: 0,1:34:21.11,1:34:22.15,Default,,0,0,0,,Ха…
Dialogue: 0,1:34:22.23,1:34:25.15,Default,,0,0,0,,Егер сіз осында болсаңыз, олар шайқаста артықшылыққа ие болады.
Dialogue: 0,1:34:25.24,1:34:28.07,Default,,0,0,0,,Сондықтан мен тәуекелге бел буып, сені ұрлауға келдім.
Dialogue: 0,1:34:28.16,1:34:29.83,Default,,0,0,0,,Міне!
Dialogue: 0,1:34:29.91,1:34:31.24,Default,,0,0,0,,Бұл дәл өткен жолымен бірдей, кішкентай сорлы!
Dialogue: 0,1:34:31.33,1:34:33.91,Default,,0,0,0,,Орфей, өйткені сен өте жақсысың...
Dialogue: 0,1:34:34.46,1:34:36.46,Default,,0,0,0,,Сондықтан мен сені жақсы көремін!
Dialogue: 0,1:34:36.54,1:34:38.29,Default,,0,0,0,,Барлығы жасайды, солай ма?
Dialogue: 0,1:34:38.38,1:34:41.38,Default,,0,0,0,,Маған керемет нәрсе керек, мен оны жанымда қалаймын.
Dialogue: 0,1:34:41.46,1:34:45.68,Default,,0,0,0,,Сіз лайықтысыз, өйткені сізге қажет және сүйікті болады!
Dialogue: 0,1:34:46.13,1:34:48.22,Default,,0,0,0,,Бұл шынымен махаббат па?
Dialogue: 0,1:34:48.30,1:34:50.26,Default,,0,0,0,,Не? (есіктің ашылған дыбысы)
Dialogue: 0,1:34:50.35,1:34:51.39,Default,,0,0,0,,Люкс!
Dialogue: 0,1:34:51.47,1:34:52.43,Default,,0,0,0,,Кира!
Dialogue: 0,1:34:53.18,1:34:54.27,Default,,0,0,0,,Ах…
Dialogue: 0,1:34:54.35,1:34:55.56,Default,,0,0,0,,Келме!
Dialogue: 0,1:34:56.06,1:34:58.77,Default,,0,0,0,,Сәл қимылдасаң, мына кісінің көзін шығарамын!
Dialogue: 0,1:34:58.85,1:34:59.86,Default,,0,0,0,,Ха…
Dialogue: 0,1:34:59.94,1:35:03.65,Default,,0,0,0,,Ән айта алмайтын бұл кісінің тамағын кесіп тастайсың.
Dialogue: 0,1:35:03.73,1:35:06.07,Default,,0,0,0,,Мен сені сүйемін деп әлі айта аласың! ?
Dialogue: 0,1:35:06.15,1:35:08.74,Default,,0,0,0,,Әй, бұл көздер көрмесе де...
Dialogue: 0,1:35:08.82,1:35:11.49,Default,,0,0,0,,Даусыңыз жоғалса да, Лакус - Лакус.
Dialogue: 0,1:35:12.08,1:35:14.08,Default,,0,0,0,,Мен олардың барлығын жақсы көремін!
Dialogue: 0,1:35:14.16,1:35:15.37,Default,,0,0,0,,Өз киімдері —
Dialogue: 0,1:35:15.45,1:35:16.50,Default,,0,0,0,,Ха…
Dialogue: 0,1:35:16.58,1:35:19.63,Default,,0,0,0,,Біз сүймейміз, өйткені ол бізге керек.
Dialogue: 0,1:35:19.71,1:35:22.46,Default,,0,0,0,,Маған керек, өйткені мен оны жақсы көремін!
Dialogue: 0,1:35:23.30,1:35:24.34,Default,,0,0,0,,Көк
Dialogue: 0,1:35:29.97,1:35:31.68,Default,,0,0,0,,-Ннн! -Аа...
Dialogue: 0,1:35:31.76,1:35:33.26,Default,,0,0,0,,Ах!
Dialogue: 0,1:35:34.14,1:35:35.39,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:35:36.77,1:35:37.81,Default,,0,0,0,,Уф!
Dialogue: 0,1:35:39.81,1:35:41.90,Default,,0,0,0,,-Керемет... -Кира!
Dialogue: 0,1:35:42.31,1:35:43.86,Default,,0,0,0,,Люкс!
Dialogue: 0,1:35:44.23,1:35:45.32,Default,,0,0,0,,Қандай ұят...
Dialogue: 0,1:35:45.40,1:35:48.99,Default,,0,0,0,,Мен сені жақсы көремін, мені де...
Dialogue: 0,1:35:53.03,1:35:54.49,Default,,0,0,0,,Эренді тоқтату үшін. Көпшілік кісі өлтіру – қате.
Dialogue: 0,1:35:54.58,1:35:55.95,Default,,0,0,0,,Жүр!
Dialogue: 0,1:35:56.41,1:36:01.17,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:36:01.25,1:36:04.59,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:36:10.13,1:36:11.18,Default,,0,0,0,,Ха…
Dialogue: 0,1:36:13.93,1:36:15.22,Default,,0,0,0,,Тс!
Dialogue: 0,1:36:19.56,1:36:22.40,Default,,0,0,0,,Лакусты сұраңыз Мен Реквиемге барамын
Dialogue: 0,1:36:22.48,1:36:24.82,Default,,0,0,0,,Олар күшті, сақ болыңыз.
Dialogue: 0,1:36:24.90,1:36:29.11,Default,,0,0,0,,Иә, мен бұл жолы жеңілмеймін, өйткені мен жалғыз емеспін
Dialogue: 0,1:36:29.20,1:36:31.78,Default,,0,0,0,,Кира, абай болыңыз.
Dialogue: 0,1:36:31.86,1:36:32.95,Default,,0,0,0,,Иә!
Dialogue: 0,1:36:39.46,1:36:42.92,Default,,0,0,0,,№11 ауытқу сақинасы бірінші нүктеге көшуді аяқтады
Dialogue: 0,1:36:43.00,1:36:45.71,Default,,0,0,0,,...
Dialogue: 0,1:36:45.80,1:36:49.72,Default,,0,0,0,,...
Dialogue: 0,1:36:49.80,1:36:53.55,Default,,0,0,0,,･
Dialogue: 0,1:36:53.64,1:36:55.97,Default,,0,0,0,,Реквиемді іске қосудан 10 секунд бұрын
Dialogue: 0,1:36:56.06,1:37:00.39,Default,,0,0,0,,9 8 7 6 5…
Dialogue: 0,1:37:06.90,1:37:10.15,Default,,0,0,0,,...
Dialogue: 0,1:37:10.24,1:37:13.07,Default,,0,0,0,,...
Dialogue: 0,1:37:13.16,1:37:14.45,Default,,0,0,0,,Не! ?
Dialogue: 0,1:37:15.82,1:37:18.74,Default,,0,0,0,,（）
Dialogue: 0,1:37:20.70,1:37:23.33,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:37:23.79,1:37:25.38,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,1:37:28.84,1:37:29.71,Default,,0,0,0,,Жақсы!
Dialogue: 0,1:37:40.14,1:37:41.35,Default,,0,0,0,,...
Dialogue: 0,1:37:42.43,1:37:44.44,Default,,0,0,0,,Уф... О, құдайым.
Dialogue: 0,1:37:44.52,1:37:47.02,Default,,0,0,0,,...
Dialogue: 0,1:37:47.11,1:37:49.19,Default,,0,0,0,,(Экипаж қошемет көрсету)
Dialogue: 0,1:37:50.15,1:37:51.61,Default,,0,0,0,,Я...
Dialogue: 0,1:37:51.69,1:37:53.95,Default,,0,0,0,,Бастапқы релелік нүкте шабуылдады және жоғалды!
Dialogue: 0,1:37:54.03,1:37:56.37,Default,,0,0,0,,Дефлекторлық сақина орнатылған кеме Навигация мүмкін емес!
Dialogue: 0,1:37:56.45,1:37:59.45,Default,,0,0,0,,Requiem Сыртқы қабықтың зақымдануы! Сәулелік фокустау жүйесі зақымдалған!
Dialogue: 0,1:37:59.99,1:38:01.79,Default,,0,0,0,,...
Dialogue: 0,1:38:01.87,1:38:03.12,Default,,0,0,0,,Қалпына келтіруді дереу бастаңыз!
Dialogue: 0,1:38:03.96,1:38:06.04,Default,,0,0,0,,Мен, қарт адамдар...
Dialogue: 0,1:38:06.88,1:38:09.46,Default,,0,0,0,,Бетперделерді жою Мақсаты:
Dialogue: 0,1:38:09.55,1:38:12.88,Default,,0,0,0,,...
Dialogue: 0,1:38:12.97,1:38:15.22,Default,,0,0,0,,Барлық ұшақтар қаруды еркін пайдалана алады!
Dialogue: 0,1:38:15.30,1:38:18.72,Default,,0,0,0,,Өлім жүзін шарға сілтеген адамды ешқашан кешірме!
Dialogue: 0,1:38:25.81,1:38:26.85,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:38:26.94,1:38:29.52,Default,,0,0,0,,...
Dialogue: 0,1:38:30.02,1:38:32.69,Default,,0,0,0,,Лохенгрин Сәлем!
Dialogue: 0,1:38:32.78,1:38:34.86,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,1:38:37.91,1:38:39.58,Default,,0,0,0,,...
Dialogue: 0,1:38:39.66,1:38:42.95,Default,,0,0,0,,１ ２
Dialogue: 0,1:38:43.04,1:38:45.12,Default,,0,0,0,,Қарсыластың жауынгерлік кемесі
Dialogue: 0,1:38:45.87,1:38:47.25,Default,,0,0,0,,Ти!
Dialogue: 0,1:38:48.00,1:38:49.29,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,1:38:56.97,1:38:59.43,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,1:39:01.68,1:39:03.56,Default,,0,0,0,,Қара рыцарьлар келе жатыр
Dialogue: 0,1:39:03.64,1:39:05.56,Default,,0,0,0,,...
Dialogue: 0,1:39:08.31,1:39:10.52,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,1:39:12.27,1:39:15.24,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:39:15.32,1:39:18.11,Default,,0,0,0,,...
Dialogue: 0,1:39:27.79,1:39:30.33,Default,,0,0,0,,Сен шынымен де үйренбейсің, ақымақ.
Dialogue: 0,1:39:30.42,1:39:32.63,Default,,0,0,0,,...
Dialogue: 0,1:39:32.71,1:39:35.51,Default,,0,0,0,,...
Dialogue: 0,1:39:44.26,1:39:46.02,Default,,0,0,0,,...
Dialogue: 0,1:39:48.60,1:39:49.85,Default,,0,0,0,,Сол жылжымалы костюм...
Dialogue: 0,1:39:52.31,1:39:53.82,Default,,0,0,0,,...
Dialogue: 0,1:39:53.90,1:39:55.32,Default,,0,0,0,,Импульс... Луна Мария! ?
Dialogue: 0,1:39:56.15,1:39:58.03,Default,,0,0,0,,Агнес Сіз тірісіз!
Dialogue: 0,1:39:58.49,1:40:01.66,Default,,0,0,0,,...
Dialogue: 0,1:40:06.95,1:40:09.67,Default,,0,0,0,,Сізді жай ғана пайдаланып жатырсыз, түсінбейсіз! ?
Dialogue: 0,1:40:09.75,1:40:11.92,Default,,0,0,0,,Сіз де үйлестіруші шығарсыз.
Dialogue: 0,1:40:12.00,1:40:14.04,Default,,0,0,0,,Сен неге олардың жағындасың?
Dialogue: 0,1:40:14.13,1:40:17.09,Default,,0,0,0,,Ақымақ адамның әсерінен миым қайнап жатыр! ?
Dialogue: 0,1:40:17.17,1:40:19.76,Default,,0,0,0,,Иә? Шинге бәрібір
Dialogue: 0,1:40:19.84,1:40:22.51,Default,,0,0,0,,Өйткені сіз капитанмен айналыспайсыз!
Dialogue: 0,1:40:22.59,1:40:25.10,Default,,0,0,0,,Аузыңды жап!
Dialogue: 0,1:40:36.57,1:40:37.90,Default,,0,0,0,,Мынау кім?
Dialogue: 0,1:40:37.99,1:40:40.78,Default,,0,0,0,,Өткен күні мен жеңілдім, өйткені бұл Әділет болды.
Dialogue: 0,1:40:40.86,1:40:43.57,Default,,0,0,0,,Тағдыр болса, балалар!
Dialogue: 0,1:40:54.67,1:40:55.84,Default,,0,0,0,,Мен сіздің ойларыңызды көре алмаймын! ?
Dialogue: 0,1:40:55.92,1:40:57.55,Default,,0,0,0,,Бұл жігіт ойланбайды! ?
Dialogue: 0,1:40:58.76,1:41:00.22,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:41:02.09,1:41:05.68,Default,,0,0,0,,Бір кеме де өтпесін! Өйткені, бұл табиғи заттардың жиынтығы.
Dialogue: 0,1:41:05.76,1:41:08.35,Default,,0,0,0,,Гамильтон Шектер батып кетті!
Dialogue: 0,1:41:08.43,1:41:09.68,Default,,0,0,0,,Жаудың жылжымалы костюмі жақындап қалды!
Dialogue: 0,1:41:09.77,1:41:10.77,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,1:41:16.19,1:41:18.53,Default,,0,0,0,,Подполковник Джаганнат Зауыттан!
Dialogue: 0,1:41:18.61,1:41:19.57,Default,,0,0,0,,Иә?
Dialogue: 0,1:41:20.15,1:41:21.40,Default,,0,0,0,,Әскери бөлімнің төрағасы -
Dialogue: 0,1:41:21.49,1:41:24.49,Default,,0,0,0,,Барлық әскери күштерді тоқтатуға және мемлекеттік төңкерістің жолын кесуге шақырады.
Dialogue: 0,1:41:24.57,1:41:25.66,Default,,0,0,0,,Не! ?
Dialogue: 0,1:41:25.74,1:41:27.33,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:41:27.41,1:41:31.25,Default,,0,0,0,,CP 506-дан Субъект тапсырылды және қарусыздандырылды
Dialogue: 0,1:41:31.33,1:41:35.17,Default,,0,0,0,,CP түсінікті ЖҚҚ-дан сақ болыңыз.
Dialogue: 0,1:41:35.25,1:41:37.42,Default,,0,0,0,,Шабуылды жалғастырыңыз
Dialogue: 0,1:41:37.50,1:41:40.13,Default,,0,0,0,,Егер Реквием шарды атса, уақыт өзгереді!
Dialogue: 0,1:41:45.09,1:41:46.93,Default,,0,0,0,,Зақымдануды бақылау!
Dialogue: 0,1:41:49.93,1:41:52.27,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,1:41:52.35,1:41:53.94,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:41:58.27,1:42:00.19,Default,,0,0,0,,Бұл ЗАФТ армиясының ақпарат министрлігі
Dialogue: 0,1:42:00.28,1:42:03.86,Default,,0,0,0,,Бұл подполковник Исаак Джоуль. Ол әскери штабтан бұйрық алды!
Dialogue: 0,1:42:04.40,1:42:06.78,Default,,0,0,0,,Подполковник Джаганнаттың басқаруындағы ZAFT сарбаздары:
Dialogue: 0,1:42:06.87,1:42:09.49,Default,,0,0,0,,Ұрысты дереу тоқтатып, бастапқы жасаққа оралыңыз!
Dialogue: 0,1:42:09.58,1:42:10.62,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,1:42:14.67,1:42:15.87,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:42:15.96,1:42:17.38,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,1:42:19.55,1:42:21.13,Default,,0,0,0,,-Капитан Рамиус! -(Мари) А?
Dialogue: 0,1:42:21.80,1:42:25.30,Default,,0,0,0,,Мыңжылдық, бұл менмін, дереу хабар таратуға дайындал.
Dialogue: 0,1:42:27.18,1:42:29.10,Default,,0,0,0,,Құрметті Лакус, қош келдіңіз!
Dialogue: 0,1:42:31.89,1:42:34.52,Default,,0,0,0,,Подполковник Джаганнат Сізді мемлекетке опасыздық жасады деген айып таққыңыз келе ме?
Dialogue: 0,1:42:34.60,1:42:39.23,Default,,0,0,0,,Сатқындық емес! Біз өсімдіктердің болашағына жауаптымыз!
Dialogue: 0,1:42:39.31,1:42:41.82,Default,,0,0,0,,Менің атым Лакус Клайн.
Dialogue: 0,1:42:41.90,1:42:43.15,Default,,0,0,0,,Дәл қазір
Dialogue: 0,1:42:43.24,1:42:45.53,Default,,0,0,0,,Қордың қамауынан қашу —
Dialogue: 0,1:42:45.61,1:42:47.24,Default,,0,0,0,,Мен бәріңмен сөйлесіп тұрмын.
Dialogue: 0,1:42:48.12,1:42:49.53,Default,,0,0,0,,Біріншіден, мен—
Dialogue: 0,1:42:49.62,1:42:50.99,Default,,0,0,0,,Қордың пікірінде былай делінген:
Dialogue: 0,1:42:51.08,1:42:52.91,Default,,0,0,0,,Мен мұнымен мүлдем келіспеймін.
Dialogue: 0,1:42:53.62,1:42:56.58,Default,,0,0,0,,Олар қандай әділ және тең қоғамды ұсынады?
Dialogue: 0,1:42:57.12,1:42:59.50,Default,,0,0,0,,Тағдыр жоспарымен басқарылады
Dialogue: 0,1:42:59.59,1:43:01.67,Default,,0,0,0,,Мен бұрын айтқанымдай
Dialogue: 0,1:43:01.75,1:43:04.09,Default,,0,0,0,,Мен оны қабылдамаймын.
Dialogue: 0,1:43:05.30,1:43:09.09,Default,,0,0,0,,Сәтсіздіктер, өзгерістер, армандар...
Dialogue: 0,1:43:09.18,1:43:11.76,Default,,0,0,0,,Ештеңеге рұқсат етілмеген әлем
Dialogue: 0,1:43:11.85,1:43:14.68,Default,,0,0,0,,Адамдардың құндылығы олардың гендерімен анықталатын қоғам
Dialogue: 0,1:43:14.77,1:43:19.31,Default,,0,0,0,,Мен өз құндылығымды басқаларға сенбеймін.
Dialogue: 0,1:43:19.40,1:43:23.69,Default,,0,0,0,,Біреуді зорлық-зомбылық немесе қорқыныш арқылы мұны істеуге мәжбүрлеу былай тұрсын.
Dialogue: 0,1:43:23.78,1:43:26.53,Default,,0,0,0,,Бұл ешқашан қабылданбайды!
Dialogue: 0,1:43:27.28,1:43:31.91,Default,,0,0,0,,Әрбір өмір өз тағдырын шешуге еркіндік алады.
Dialogue: 0,1:43:32.28,1:43:34.95,Default,,0,0,0,,Мен де сол үшін күресемін.
Dialogue: 0,1:43:35.95,1:43:38.37,Default,,0,0,0,,Тіпті сені сүймейтіндерге —
Dialogue: 0,1:43:38.46,1:43:41.71,Default,,0,0,0,,Өз құндылығыңызды анықтауға ешқашан жол бермеңіз.
Dialogue: 0,1:43:41.79,1:43:42.63,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,1:43:46.80,1:43:48.76,Default,,0,0,0,,-Мен сені ары қарай жібермеймін! -Аспаз...
Dialogue: 0,1:43:52.26,1:43:55.35,Default,,0,0,0,,Өз рөлімізді орындай алмасақ, өмір сүрудің мәні жоқ!
Dialogue: 0,1:43:55.43,1:43:59.77,Default,,0,0,0,,Жау флоты M1A1 Шура реквиеміне жақындап келеді.
Dialogue: 0,1:43:59.85,1:44:02.40,Default,,0,0,0,,Флагмандық флот Реквиемге бет алды!
Dialogue: 0,1:44:02.48,1:44:03.90,Default,,0,0,0,,Мыңжылдық үшін—
Dialogue: 0,1:44:03.98,1:44:06.69,Default,,0,0,0,,Флоттың қорғаныс шебіне тартылып, оны жойыңыз!
Dialogue: 0,1:44:07.24,1:44:09.66,Default,,0,0,0,,Анашым, артымнан еріңіз.
Dialogue: 0,1:44:09.74,1:44:12.66,Default,,0,0,0,,Бостандықпен Шура екеуміз айналысамыз.
Dialogue: 0,1:44:12.74,1:44:14.66,Default,,0,0,0,,Кеттік, Ингрид!
Dialogue: 0,1:44:14.74,1:44:18.58,Default,,0,0,0,,Бұл кеме жау флотын бұзып өтіп, жау флагманына шабуыл жасайды.
Dialogue: 0,1:44:18.66,1:44:19.96,Default,,0,0,0,,Шешуші шайқас!
Dialogue: 0,1:44:20.04,1:44:21.50,Default,,0,0,0,,Капитан
Dialogue: 0,1:44:21.92,1:44:22.92,Default,,0,0,0,,Лакус мырза?
Dialogue: 0,1:44:23.67,1:44:26.13,Default,,0,0,0,,Мен де шығамын. Рұқсат.
Dialogue: 0,1:44:26.21,1:44:27.38,Default,,0,0,0,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,1:44:27.46,1:44:29.76,Default,,0,0,0,,Мен мұны Кираға жеткізбесем...
Dialogue: 0,1:44:29.84,1:44:31.43,Default,,0,0,0,,Мен осылай істеуім керек
Dialogue: 0,1:44:32.68,1:44:34.01,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:44:34.10,1:44:35.26,Default,,0,0,0,,Өтінемін
Dialogue: 0,1:44:35.35,1:44:37.14,Default,,0,0,0,,Өтінемін, мені осы жолы жіберіңізші!
Dialogue: 0,1:44:37.22,1:44:39.18,Default,,0,0,0,,Бұл Альберт шебері.
Dialogue: 0,1:44:39.27,1:44:41.23,Default,,0,0,0,,Ұшақ 100 пайыз өнімділікпен жұмыс істей алады, бірақ
Dialogue: 0,1:44:41.31,1:44:43.36,Default,,0,0,0,,Қондыру қолмен дәл реттеуді қажет етеді
Dialogue: 0,1:44:43.44,1:44:45.52,Default,,0,0,0,,Мен сізге жақсы жол көрсетемін, сондықтан...
Dialogue: 0,1:44:45.61,1:44:46.86,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,1:44:46.94,1:44:49.70,Default,,0,0,0,,Түсіндім, кетуге рұқсат.
Dialogue: 0,1:44:49.78,1:44:50.70,Default,,0,0,0,,Рахмет
Dialogue: 0,1:44:51.99,1:44:53.16,Default,,0,0,0,,…Таку
Dialogue: 0,1:44:53.24,1:44:54.78,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,1:44:54.87,1:44:58.12,Default,,0,0,0,,Кейде қарап тұру одан да ауыр болады.
Dialogue: 0,1:44:59.62,1:45:01.21,Default,,0,0,0,,Кавалердің ұшуы
Dialogue: 0,1:45:01.29,1:45:03.96,Default,,0,0,0,,Атрун Зара З'Гок пайда болды!
Dialogue: 0,1:45:07.63,1:45:09.21,Default,,0,0,0,,Қорғаушы, ұшыңыз.
Dialogue: 0,1:45:09.30,1:45:11.63,Default,,0,0,0,,Лакус Клайн Кеттік!
Dialogue: 0,1:45:21.14,1:45:23.23,Default,,0,0,0,,Өз құндылығыңызды дәлелдеңіз!
Dialogue: 0,1:45:24.48,1:45:26.15,Default,,0,0,0,,-Жарайды... -Мен кетемін!
Dialogue: 0,1:45:28.40,1:45:31.90,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,1:45:33.41,1:45:35.49,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:45:36.20,1:45:39.58,Default,,0,0,0,,Беріңіз, подполковник! Елдегі төңкеріс те сәтсіз аяқталды.
Dialogue: 0,1:45:39.66,1:45:41.25,Default,,0,0,0,,Солдаттарды қажетсіз өлтірме!
Dialogue: 0,1:45:41.66,1:45:44.46,Default,,0,0,0,,Неге ескі дүниенің адамдарымен сөйлесесің?
Dialogue: 0,1:45:44.54,1:45:46.92,Default,,0,0,0,,Бұлай жалғаса берсе, ештеңе өзгермейді!
Dialogue: 0,1:45:47.00,1:45:48.59,Default,,0,0,0,,Кейбіреулер бай -
Dialogue: 0,1:45:48.67,1:45:51.59,Default,,0,0,0,,Ақылға қонымсыз және ашу-ыза үстемдік ететін әлем!
Dialogue: 0,1:45:51.67,1:45:54.01,Default,,0,0,0,,Анахронистік ақымақтар!
Dialogue: 0,1:45:57.30,1:45:59.72,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,1:46:01.27,1:46:02.98,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:46:03.06,1:46:04.69,Default,,0,0,0,,Бұл енді мүмкін емес, Ысқақ.
Dialogue: 0,1:46:04.77,1:46:07.86,Default,,0,0,0,,Мен сендіруді қабылдау керек болса, мен мұны істемес едім!
Dialogue: 0,1:46:07.94,1:46:08.77,Default,,0,0,0,,Сонда бәрі бір сәтте бітеді.
Dialogue: 0,1:46:12.78,1:46:13.61,Default,,0,0,0,,Ти!
Dialogue: 0,1:46:13.70,1:46:15.28,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,1:46:16.57,1:46:18.20,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:46:32.59,1:46:34.67,Default,,0,0,0,,- Бейшара жігіт! -Не! ?
Dialogue: 0,1:46:36.18,1:46:39.01,Default,,0,0,0,,Мен сізді ескі мобильді костюммен сынайсыз деп ойламаппын!
Dialogue: 0,1:46:43.10,1:46:44.43,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:46:45.98,1:46:49.69,Default,,0,0,0,,Күш мобильді костюмнің өнімділігімен анықталмайды!
Dialogue: 0,1:46:51.94,1:46:53.32,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,1:46:53.40,1:46:54.65,Default,,0,0,0,,Сол жалған жылы жүзді жігіт! Ол шынымен де мұны салқын жүзбен айтты!
Dialogue: 0,1:46:54.74,1:46:57.03,Default,,0,0,0,,Сондықтан бізден төмен сен ешқашан жеңе алмайсың!
Dialogue: 0,1:47:01.45,1:47:03.79,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,1:47:05.29,1:47:07.46,Default,,0,0,0,,Бірақ менде де қару бар!
Dialogue: 0,1:47:07.54,1:47:09.38,Default,,0,0,0,,- Не? Бұл - ха...
Dialogue: 0,1:47:11.67,1:47:12.88,Default,,0,0,0,,Лакустың махаббаты!
Dialogue: 0,1:47:14.46,1:47:15.47,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,1:47:15.55,1:47:17.22,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:47:17.30,1:47:18.76,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,1:47:21.56,1:47:23.35,Default,,0,0,0,,- Жақсы... - Лас!
Dialogue: 0,1:47:23.43,1:47:27.02,Default,,0,0,0,,Сіз сияқты қоқыс үшін Лакустың атын айту...
Dialogue: 0,1:47:27.10,1:47:29.81,Default,,0,0,0,,Егер сіз миллион рет өлтірсеңіз де, қылмыс ешқашан жойылмайды!
Dialogue: 0,1:47:41.95,1:47:43.54,Default,,0,0,0,,Жақсы...
Dialogue: 0,1:47:45.91,1:47:47.33,Default,,0,0,0,,Ха... Шин!
Dialogue: 0,1:47:49.29,1:47:50.33,Default,,0,0,0,,Луна!
Dialogue: 0,1:48:02.97,1:48:03.85,Default,,0,0,0,,Луна!
Dialogue: 0,1:48:03.93,1:48:04.81,Default,,0,0,0,,Шин!
Dialogue: 0,1:48:05.97,1:48:07.98,Default,,0,0,0,,Дейтериялық сәуленің сәулеленуі!
Dialogue: 0,1:48:08.06,1:48:10.40,Default,,0,0,0,,(сәулелену дыбысы)
Dialogue: 0,1:48:14.15,1:48:16.74,Default,,0,0,0,,Қыңыр... Лю Даниэль!
Dialogue: 0,1:48:16.82,1:48:19.78,Default,,0,0,0,,- (Лю) Ах! -Ол аяқтады! Белдік әмиян!
Dialogue: 0,1:48:28.08,1:48:31.67,Default,,0,0,0,,Сіз көптен бері басқа біреудің жігіттерімен сырласып жүрсіз ғой, солай емес пе?
Dialogue: 0,1:48:31.75,1:48:36.21,Default,,0,0,0,,Не болды? Мен барлық еркектерге ұнауы керек
Dialogue: 0,1:48:36.30,1:48:37.34,Default,,0,0,0,,Еш ойланбаңыз!
Dialogue: 0,1:48:43.26,1:48:45.22,Default,,0,0,0,,Неге араласып жатырсың?
Dialogue: 0,1:48:45.31,1:48:47.85,Default,,0,0,0,,Сіз ештеңе істей алмайтын сәтсіздікке ұшырайсыз!
Dialogue: 0,1:48:48.85,1:48:50.02,Default,,0,0,0,,73 адам із-түссіз жоғалып кетті
Dialogue: 0,1:48:51.35,1:48:53.94,Default,,0,0,0,,Ол тумауы керек еді!
Dialogue: 0,1:48:54.02,1:48:56.36,Default,,0,0,0,,Дегенмен мен жайлы өмір сүріп жатырмын және мені жақсы көреді.
Dialogue: 0,1:48:57.61,1:48:59.44,Default,,0,0,0,,Сізде мұндай біліктілік болмаса да!
Dialogue: 0,1:49:01.53,1:49:04.37,Default,,0,0,0,,Сүйікті болу үшін ешқандай біліктілік қажет емес!
Dialogue: 0,1:49:04.45,1:49:05.28,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,1:49:05.37,1:49:07.66,Default,,0,0,0,,Олай болса маған сол махаббатты бер!
Dialogue: 0,1:49:07.74,1:49:10.21,Default,,0,0,0,,Ол менікі болуы керек еді.
Dialogue: 0,1:49:10.29,1:49:12.29,Default,,0,0,0,,Сен солай істейсің!
Dialogue: 0,1:49:18.67,1:49:19.88,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:49:19.97,1:49:21.30,Default,,0,0,0,,73 адам із-түссіз жоғалып кетті
Dialogue: 0,1:49:21.38,1:49:22.47,Default,,0,0,0,,(Дабыл дыбысы)
Dialogue: 0,1:49:26.47,1:49:28.18,Default,,0,0,0,,Бітті, Бостандық!
Dialogue: 0,1:49:29.68,1:49:30.98,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,1:49:31.94,1:49:33.31,Default,,0,0,0,,Өлтір!
Dialogue: 0,1:49:33.40,1:49:37.86,Default,,0,0,0,,(Жылдам дыбыс)
Dialogue: 0,1:49:37.94,1:49:39.32,Default,,0,0,0,,- Аслан! -Аспаз...
Dialogue: 0,1:49:42.49,1:49:43.66,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:49:55.08,1:49:56.59,Default,,0,0,0,,-Не! ? -(Ингрид Шула) Бақыт...
Dialogue: 0,1:49:56.67,1:49:58.17,Default,,0,0,0,,Амансың ба? ? Кира
Dialogue: 0,1:49:58.25,1:49:59.75,Default,,0,0,0,,- Аслан! -Кира!
Dialogue: 0,1:49:59.84,1:50:00.80,Default,,0,0,0,,Люкс!
Dialogue: 0,1:50:02.55,1:50:03.38,Default,,0,0,0,,Қондыру!
Dialogue: 0,1:50:05.14,1:50:09.01,Default,,0,0,0,,Соңғы соққыны беріңіз Бостандыққа барлық күшіңізді жеткізіңіз!
Dialogue: 0,1:50:12.43,1:50:15.52,Default,,0,0,0,,Салыстырмалы жылдамдық плюс 1 үтір 2 осьті түзету плюс 3 қосылым
Dialogue: 0,1:50:15.60,1:50:16.90,Default,,0,0,0,,Қатысу!
Dialogue: 0,1:50:25.66,1:50:27.28,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,1:50:29.78,1:50:33.29,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:50:33.37,1:50:34.37,Default,,0,0,0,,Фу…
Dialogue: 0,1:50:34.46,1:50:36.29,Default,,0,0,0,,Аа... Не! ?
Dialogue: 0,1:50:54.14,1:50:55.60,Default,,0,0,0,,Қызықты
Dialogue: 0,1:50:57.73,1:50:59.81,Default,,0,0,0,,Лакус Неге...
Dialogue: 0,1:50:59.90,1:51:03.44,Default,,0,0,0,,Менің еркім сенімен бірге
Dialogue: 0,1:51:03.53,1:51:05.99,Default,,0,0,0,,Үздіксіз қолдау көрсеткеніңіз үшін рахмет.
Dialogue: 0,1:51:06.61,1:51:07.66,Default,,0,0,0,,Маюшиі енді ғана айтылған сөздердің бір ауызын да түсінбеді.
Dialogue: 0,1:51:07.74,1:51:08.82,Default,,0,0,0,,Иә!
Dialogue: 0,1:51:10.66,1:51:12.99,Default,,0,0,0,,Менен бас тартуға дейін бардың ба?
Dialogue: 0,1:51:15.00,1:51:17.08,Default,,0,0,0,,Сонда сол ақымақ махаббатпен—
Dialogue: 0,1:51:17.62,1:51:19.42,Default,,0,0,0,,Өлсін!
Dialogue: 0,1:51:26.68,1:51:28.26,Default,,0,0,0,,Бұл менмін
Dialogue: 0,1:51:39.73,1:51:41.90,Default,,0,0,0,,(разряд дыбысы)
Dialogue: 0,1:51:41.98,1:51:45.74,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:51:49.24,1:51:50.82,Default,,0,0,0,,Не! ? Бұл қару
Dialogue: 0,1:51:50.91,1:51:52.53,Default,,0,0,0,,Бұзғыштарды қолданыңыз
Dialogue: 0,1:51:52.62,1:51:55.79,Default,,0,0,0,,Бригадир генерал Кира Ямато бұзушыны қолдануға өтініш береді
Dialogue: 0,1:51:55.87,1:51:59.50,Default,,0,0,0,,Президент Лакус Клайн I Disruptor пайдалануды мақұлдаймын.
Dialogue: 0,1:51:59.58,1:52:02.17,Default,,0,0,0,,Бұзғышты іске қосу 80% шығыс
Dialogue: 0,1:52:02.25,1:52:06.34,Default,,0,0,0,,Менің санамды байланыстырып, Мәсіхтің артында жау.
Dialogue: 0,1:52:09.76,1:52:10.89,Default,,0,0,0,,(сәулелену дыбысы)
Dialogue: 0,1:52:10.97,1:52:13.72,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,1:52:15.22,1:52:17.64,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:52:17.73,1:52:20.06,Default,,0,0,0,,Реквиемді жөндеу аяқталды
Dialogue: 0,1:52:20.15,1:52:22.73,Default,,0,0,0,,Ауыстыру сақинасы Бастапқы реле нүктесіне жылжу
Dialogue: 0,1:52:22.81,1:52:25.57,Default,,0,0,0,,Дайын болған кезде шарды атыңыз.
Dialogue: 0,1:52:25.65,1:52:27.40,Default,,0,0,0,,Жау флоты кіреді!
Dialogue: 0,1:52:28.32,1:52:30.82,Default,,0,0,0,,Синхронды шабуыл, мінекей!
Dialogue: 0,1:52:30.91,1:52:31.95,Default,,0,0,0,,Польнарефф?
Dialogue: 0,1:52:32.03,1:52:33.49,Default,,0,0,0,,Қараңғылыққа түс!
Dialogue: 0,1:52:33.58,1:52:34.91,Default,,0,0,0,,Уф…
Dialogue: 0,1:52:37.87,1:52:40.58,Default,,0,0,0,,Мен Шинді қорғаймын!
Dialogue: 0,1:52:41.42,1:52:45.13,Default,,0,0,0,,Шыу!
Dialogue: 0,1:52:45.21,1:52:46.67,Default,,0,0,0,,Бұл жігіттің қараңғылығы...
Dialogue: 0,1:52:46.76,1:52:48.26,Default,,0,0,0,,Тым терең!
Dialogue: 0,1:52:48.34,1:52:51.84,Default,,0,0,0,,Уау!
Dialogue: 0,1:52:54.05,1:52:56.60,Default,,0,0,0,,Ол жоғалып кетті ме? Мүмкін емес!
Dialogue: 0,1:52:58.06,1:53:00.10,Default,,0,0,0,,Сол жартылай ұйықтап жатқан қос...
Dialogue: 0,1:53:00.19,1:53:01.77,Default,,0,0,0,,Бұл жұмыс істей ме?
Dialogue: 0,1:53:03.81,1:53:05.57,Default,,0,0,0,,Мен мұндай қаруды білмеймін!
Dialogue: 0,1:53:06.73,1:53:10.65,Default,,0,0,0,,Клон осылай жасайды!
Dialogue: 0,1:53:13.03,1:53:14.41,Default,,0,0,0,,Не! ?
Dialogue: 0,1:53:16.70,1:53:19.50,Default,,0,0,0,,Олардың жауы!
Dialogue: 0,1:53:20.62,1:53:22.37,Default,,0,0,0,,(Айқай)
Dialogue: 0,1:53:22.46,1:53:23.50,Default,,0,0,0,,Риддер!
Dialogue: 0,1:53:23.58,1:53:25.21,Default,,0,0,0,,-Ааа! -Мен оны ұнатпаймын!
Dialogue: 0,1:53:25.29,1:53:28.05,Default,,0,0,0,,Уау!
Dialogue: 0,1:53:28.13,1:53:29.76,Default,,0,0,0,,Ааах…
Dialogue: 0,1:53:42.06,1:53:43.60,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:53:43.69,1:53:45.98,Default,,0,0,0,,Балаларым!
Dialogue: 0,1:53:46.06,1:53:47.52,Default,,0,0,0,,Ах...
Dialogue: 0,1:53:47.61,1:53:50.44,Default,,0,0,0,,Шар мен өсімдікті өртеп жіберемін!
Dialogue: 0,1:53:51.74,1:53:55.78,Default,,0,0,0,,Бұл әрқашан мен ғана, неге жақсы жүрмейді? ?
Dialogue: 0,1:53:56.57,1:53:58.41,Default,,0,0,0,,Мен бұған шындап қараймын! ?
Dialogue: 0,1:53:58.49,1:53:59.54,Default,,0,0,0,,Сіз...
Dialogue: 0,1:53:59.62,1:54:02.08,Default,,0,0,0,,Мен ондай жігітпен кездесіп жүрмін, ол маған тіпті ұнамайды...
Dialogue: 0,1:54:02.16,1:54:04.00,Default,,0,0,0,,Сенің көздерің өте жақсы!
Dialogue: 0,1:54:05.63,1:54:08.38,Default,,0,0,0,,Иә? Маған ұнайды, дегенмен! жаман! ?
Dialogue: 0,1:54:09.09,1:54:11.92,Default,,0,0,0,,Жақсы! ол саған ұнайды ма? Сондай тау маймыл! ?
Dialogue: 0,1:54:13.17,1:54:16.64,Default,,0,0,0,,Керемет көмек! Мен сені ұнатпаймын, неге менімен кездесіп жүрсің?
Dialogue: 0,1:54:16.72,1:54:20.18,Default,,0,0,0,,Қарғыс атсын... Мен ғашық болуға лайықпын!
Dialogue: 0,1:54:20.27,1:54:21.10,Default,,0,0,0,,Сонымен не! ?
Dialogue: 0,1:54:21.18,1:54:23.02,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,1:54:23.69,1:54:25.48,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:54:25.56,1:54:27.44,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:54:28.44,1:54:30.78,Default,,0,0,0,,Мен де сені жақсы көремін...
Dialogue: 0,1:54:31.40,1:54:33.53,Default,,0,0,0,,Кешіріңіз, Агнес...
Dialogue: 0,1:54:34.53,1:54:36.36,Default,,0,0,0,,Танхаузер Ти!
Dialogue: 0,1:54:38.12,1:54:40.08,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,1:54:40.16,1:54:42.50,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:54:42.58,1:54:44.41,Default,,0,0,0,,Қазір! Екі жақта да толық жылдамдық!
Dialogue: 0,1:54:44.50,1:54:47.08,Default,,0,0,0,,Жау кемесінің негізгі зеңбірегі Браво Марк 31-ден 65-ке дейін!
Dialogue: 0,1:54:47.17,1:54:50.63,Default,,0,0,0,,Жаудың флагманы нысанаға алыңыз! Соқсаң да құлап қалады!
Dialogue: 0,1:54:52.63,1:54:57.34,Default,,0,0,0,,Өлгендер төккен қанды ұмытпаймын... Кек сақтаймын!
Dialogue: 0,1:54:57.43,1:54:59.76,Default,,0,0,0,,Ұмыту!
Dialogue: 0,1:54:59.85,1:55:00.81,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,1:55:00.89,1:55:02.47,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,1:55:02.56,1:55:03.89,Default,,0,0,0,,Ұмытпа...
Dialogue: 0,1:55:05.39,1:55:06.89,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,1:55:06.98,1:55:07.98,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:55:09.36,1:55:10.65,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,1:55:12.73,1:55:15.32,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:55:17.36,1:55:20.91,Default,,0,0,0,,Сондықтан біз мұны тоқтатуымыз керек...
Dialogue: 0,1:55:22.33,1:55:23.83,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:55:27.25,1:55:29.75,Default,,0,0,0,,Сен мықтысың, Атрун Зала.
Dialogue: 0,1:55:29.83,1:55:31.17,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,1:55:32.34,1:55:34.88,Default,,0,0,0,,Бірақ ол менің жауым емес.
Dialogue: 0,1:55:34.96,1:55:37.59,Default,,0,0,0,,Маған берілген рөл – жеңіске жету.
Dialogue: 0,1:55:37.68,1:55:39.68,Default,,0,0,0,,Менің бар болуымның мәні осында!
Dialogue: 0,1:55:41.18,1:55:43.85,Default,,0,0,0,,Бұл пайдасыз. Сіз өз ойыңызды жауып тастай алмайсыз.
Dialogue: 0,1:55:43.93,1:55:44.77,Default,,0,0,0,,Жоқ…
Dialogue: 0,1:55:45.56,1:55:47.14,Default,,0,0,0,,Кагари…
Dialogue: 0,1:55:48.77,1:55:50.73,Default,,0,0,0,,Уау!
Dialogue: 0,1:55:51.65,1:55:53.44,Default,,0,0,0,,Құрметті сізге...
Dialogue: 0,1:55:53.52,1:55:57.20,Default,,0,0,0,,Қасиетті майдан даласында ұятсыз адасушылық!
Dialogue: 0,1:55:59.74,1:56:00.78,Default,,0,0,0,,Мен оны көрдім!
Dialogue: 0,1:56:03.03,1:56:04.70,Default,,0,0,0,,Не! ? (ату дыбысы)
Dialogue: 0,1:56:07.21,1:56:08.79,Default,,0,0,0,,Неге ақымақ! ?
Dialogue: 0,1:56:08.87,1:56:10.71,Default,,0,0,0,,Мен оны шынымен пайдалана алмаймын.
Dialogue: 0,1:56:17.55,1:56:19.05,Default,,0,0,0,,Қашықтан басқару! ?
Dialogue: 0,1:56:19.93,1:56:21.97,Default,,0,0,0,,Ұятсыз адасу?
Dialogue: 0,1:56:22.51,1:56:23.64,Default,,0,0,0,,Аслан!
Dialogue: 0,1:56:23.72,1:56:25.31,Default,,0,0,0,,Қорқақ!
Dialogue: 0,1:56:29.52,1:56:31.23,Default,,0,0,0,,Мен күткендей жақсымын!
Dialogue: 0,1:56:31.31,1:56:33.15,Default,,0,0,0,,Күш күш емес
Dialogue: 0,1:56:33.23,1:56:34.82,Default,,0,0,0,,Өмір сүруге деген ерік-жігер!
Dialogue: 0,1:56:37.53,1:56:38.95,Default,,0,0,0,,(Қызық дыбыс)
Dialogue: 0,1:56:39.03,1:56:40.61,Default,,0,0,0,,Мен жеңілдім! ?
Dialogue: 0,1:56:41.16,1:56:43.28,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:56:46.70,1:56:47.91,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,1:56:48.00,1:56:49.41,Default,,0,0,0,,Орфей Шура!
Dialogue: 0,1:56:49.50,1:56:50.54,Default,,0,0,0,,Шура…
Dialogue: 0,1:56:50.62,1:56:53.21,Default,,0,0,0,,Қателер...
Dialogue: 0,1:56:53.29,1:56:56.38,Default,,0,0,0,,Орфей Ингрид, енді тоқтайық.
Dialogue: 0,1:56:56.46,1:57:00.55,Default,,0,0,0,,Ол кісіні өзіңнен төмен деп таңдадың.
Dialogue: 0,1:57:00.63,1:57:03.09,Default,,0,0,0,,Төменгілер қоршап, табынатын...
Dialogue: 0,1:57:03.18,1:57:04.55,Default,,0,0,0,,Бұл шынымен де ыңғайлы ма?
Dialogue: 0,1:57:04.64,1:57:05.47,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,1:57:05.56,1:57:07.47,Default,,0,0,0,,Қандай өзімшіл және суық әйел!
Dialogue: 0,1:57:07.56,1:57:11.27,Default,,0,0,0,,Мына тентектердің соғысып, қырылып жатқанына бәрібір дейсің бе? ?
Dialogue: 0,1:57:11.35,1:57:12.44,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,1:57:21.90,1:57:22.95,Default,,0,0,0,,Шин!
Dialogue: 0,1:57:23.03,1:57:24.49,Default,,0,0,0,,Реквиемді жойыңыз!
Dialogue: 0,1:57:24.57,1:57:26.45,Default,,0,0,0,,-Бозу! -Қария!
Dialogue: 0,1:57:26.53,1:57:29.12,Default,,0,0,0,,Қарт адам емес! Жабдықтарыңызды алыңыз!
Dialogue: 0,1:57:29.20,1:57:30.25,Default,,0,0,0,,Иә!
Dialogue: 0,1:57:30.33,1:57:32.29,Default,,0,0,0,,Lunamaria Оны қолданыңыз!
Dialogue: 0,1:57:35.33,1:57:36.46,Default,,0,0,0,,Кеттік, Луна!
Dialogue: 0,1:57:37.84,1:57:38.88,Default,,0,0,0,,Кез келген уақытта!
Dialogue: 0,1:57:42.47,1:57:43.97,Default,,0,0,0,,Мыңжылдық жақындап келеді!
Dialogue: 0,1:57:44.05,1:57:47.97,Default,,0,0,0,,Иә, атып тастаңыз! Әлі реквием жоқ! ?
Dialogue: 0,1:57:48.06,1:57:49.64,Default,,0,0,0,,Іске қосуға 300 секунд қалды!
Dialogue: 0,1:57:49.72,1:57:51.23,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,1:57:51.31,1:57:54.77,Default,,0,0,0,,«Готен» зарядтау доғасы іске қосылды!
Dialogue: 0,1:57:54.85,1:57:57.19,Default,,0,0,0,,Барлық зеңбіректер жақын оқтауда!
Dialogue: 0,1:57:57.27,1:57:59.61,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,1:57:59.69,1:58:01.90,Default,,0,0,0,,Барлық мүшелер, соққыға дайындалыңыз!
Dialogue: 0,1:58:03.40,1:58:04.99,Default,,0,0,0,,Уау! Ааа!
Dialogue: 0,1:58:06.74,1:58:07.95,Default,,0,0,0,,Дио, жүрегім ауыр.
Dialogue: 0,1:58:11.45,1:58:14.54,Default,,0,0,0,,Өмірде жақсы да, жаман да жоқ.
Dialogue: 0,1:58:14.62,1:58:17.46,Default,,0,0,0,,Біреу үшін әр адам қымбат
Dialogue: 0,1:58:18.42,1:58:20.51,Default,,0,0,0,,Неліктен мені жақсы көрмеді? ?
Dialogue: 0,1:58:20.59,1:58:24.68,Default,,0,0,0,,Жоқ, сені үнемі біреу бақылап отырады.
Dialogue: 0,1:58:24.76,1:58:27.93,Default,,0,0,0,,Қазір болмаса, болашақта біреу
Dialogue: 0,1:58:28.01,1:58:30.93,Default,,0,0,0,,Байқауға тым жақын адам
Dialogue: 0,1:58:31.02,1:58:31.85,Default,,0,0,0,,Ха…
Dialogue: 0,1:58:35.85,1:58:37.73,Default,,0,0,0,,Болашақ жақсы.
Dialogue: 0,1:58:37.81,1:58:39.69,Default,,0,0,0,,Мен сені қазір қалаймын!
Dialogue: 0,1:58:40.53,1:58:43.19,Default,,0,0,0,,Адамның ақымақтығынан тудық.
Dialogue: 0,1:58:43.28,1:58:47.32,Default,,0,0,0,,Олар бейбітшілік пен теңдік туралы айтады, бірақ басқалардың өзгеруін талап етеді.
Dialogue: 0,1:58:47.41,1:58:49.70,Default,,0,0,0,,Ешқашан өзіңізді өзгертуге тырыспаңыз!
Dialogue: 0,1:58:50.16,1:58:51.37,Default,,0,0,0,,Шаааах!
Dialogue: 0,1:58:52.08,1:58:54.41,Default,,0,0,0,,Сондықтан қайшылық әрқашан болады!
Dialogue: 0,1:58:54.91,1:58:58.08,Default,,0,0,0,,Жоюдың алдында тұрсаң да, кекіңді ұмытпа —
Dialogue: 0,1:58:58.17,1:59:02.38,Default,,0,0,0,,Бір-бірін ұстап тұрған бірден пайдалар мен шығындарға және алдын ала түсініктерге бейім
Dialogue: 0,1:59:02.46,1:59:04.34,Default,,0,0,0,,Барлығы ақымақ!
Dialogue: 0,1:59:04.42,1:59:05.76,Default,,0,0,0,,Орфей!
Dialogue: 0,1:59:05.84,1:59:08.59,Default,,0,0,0,,Бізге жол көрсететін біреу керек!
Dialogue: 0,1:59:08.68,1:59:11.60,Default,,0,0,0,,Бұл бөліну мен қантөгіс тарихын аяқтаңыз...
Dialogue: 0,1:59:11.68,1:59:13.85,Default,,0,0,0,,Біздің дүниеге келуіміздің мәні осы!
Dialogue: 0,1:59:13.93,1:59:16.77,Default,,0,0,0,,Адамдар қажеттіліктен тумайды.
Dialogue: 0,1:59:18.52,1:59:19.98,Default,,0,0,0,,Махаббаттан туған!
Dialogue: 0,1:59:21.98,1:59:24.69,Default,,0,0,0,,Мен өз болашағымды өз қолыммен таңдаймын!
Dialogue: 0,1:59:29.70,1:59:30.95,Default,,0,0,0,,Ааах…
Dialogue: 0,1:59:31.03,1:59:32.12,Default,,0,0,0,,Уау!
Dialogue: 0,1:59:37.62,1:59:38.88,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,1:59:40.17,1:59:42.71,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:59:45.72,1:59:46.80,Default,,0,0,0,,Ти!
Dialogue: 0,1:59:46.88,1:59:49.64,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:59:49.72,1:59:54.06,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:59:55.56,1:59:59.65,Default,,0,0,0,,Ақымақ... Мен... миссиям бар...
Dialogue: 0,2:00:00.19,2:00:03.19,Default,,0,0,0,,Жетеді, Орфей...
Dialogue: 0,2:00:03.27,2:00:04.32,Default,,0,0,0,,Ингрид?
Dialogue: 0,2:00:05.03,2:00:07.28,Default,,0,0,0,,Өйткені мен білемін...
Dialogue: 0,2:00:07.74,2:00:09.24,Default,,0,0,0,,Ннн…
Dialogue: 0,2:00:10.16,2:00:11.66,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,2:00:11.74,2:00:17.75,Default,,0,0,0,,♪~
Dialogue: 0,2:00:42.61,2:00:45.40,Default,,0,0,0,,Махаббаттың қарама-қарсы жағы жек көру емес.
Dialogue: 0,2:00:45.98,2:00:48.40,Default,,0,0,0,,Сүйіспеншілікке қарама-қарсы нәрсе - немқұрайлылық
Dialogue: 0,2:00:49.61,2:00:52.91,Default,,0,0,0,,Сен менің ішімдесің
Dialogue: 0,2:00:54.03,2:00:56.87,Default,,0,0,0,,Мен сенің ішіңдемін бе?
Dialogue: 0,2:00:58.66,2:01:03.21,Default,,0,0,0,,Сенің менің ішімде болғанның қуанышы
Dialogue: 0,2:01:03.29,2:01:07.84,Default,,0,0,0,,Мен сенің ішіңде тұрған күш
Dialogue: 0,2:01:09.17,2:01:12.47,Default,,0,0,0,,Жарық па, қараңғы ма, білмеймін.
Dialogue: 0,2:01:13.47,2:01:15.85,Default,,0,0,0,,Болашақта ештеңе көрінбейді
Dialogue: 0,2:01:16.39,2:01:20.06,Default,,0,0,0,,Бірақ қосылатын қолың болса
Dialogue: 0,2:01:20.81,2:01:23.56,Default,,0,0,0,,Бір-біріңді қолдайтын жүректерің болса
Dialogue: 0,2:01:24.56,2:01:26.98,Default,,0,0,0,,Екі көрінбейтін адам да алға жылжиды.
Dialogue: 0,2:01:28.78,2:01:31.36,Default,,0,0,0,,Қосылатын екі қолға
Dialogue: 0,2:01:31.86,2:01:34.74,Default,,0,0,0,,Қолды күшейту
Dialogue: 0,2:01:34.82,2:01:37.28,Default,,0,0,0,,Бір-бірімізбен танысайық
Dialogue: 0,2:01:39.58,2:01:41.00,Default,,0,0,0,,Сөйлеу
Dialogue: 0,2:01:41.66,2:01:45.58,Default,,0,0,0,,Менің жүрегімде көп нәрсе бар
Dialogue: 0,2:01:46.09,2:01:47.75,Default,,0,0,0,,Ұсақ заттар
Dialogue: 0,2:01:48.88,2:01:52.59,Default,,0,0,0,,Маған да айтыңызшы.
Dialogue: 0,2:01:53.88,2:01:58.51,Default,,0,0,0,,Жүрегіңде көп нәрсе бар...
Dialogue: 0,2:01:58.60,2:02:00.43,Default,,0,0,0,,Ұсақ заттар...
Dialogue: 0,2:04:38.42,2:04:44.43,Default,,0,0,0,,~♪
Dialogue: 0,2:04:45.93,2:04:51.93,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory