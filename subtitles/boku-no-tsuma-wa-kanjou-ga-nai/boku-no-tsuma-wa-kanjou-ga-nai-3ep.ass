Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.25,0:00:07.04,Default,,0,0,0,,(телефонның қоңырау үні)
Dialogue: 0,0:00:10.63,0:00:12.17,Default,,0,0,0,,Иә, бұл Косуги.
Dialogue: 0,0:00:12.26,0:00:15.22,Default,,0,0,0,,Хм!? Сәлем... Иә?
Dialogue: 0,0:00:15.80,0:00:17.72,Default,,0,0,0,,Бұл Такума Косугидің ұялы телефоны ма?
Dialogue: 0,0:00:17.80,0:00:21.27,Default,,0,0,0,,Иә, күйеуім қазір дүкенде.
Dialogue: 0,0:00:21.35,0:00:22.98,Default,,0,0,0,,Ха! Шуджи... Иә?
Dialogue: 0,0:00:23.06,0:00:25.98,Default,,0,0,0,,А... сен қайсысысың?
Dialogue: 0,0:00:26.06,0:00:28.19,Default,,0,0,0,,Менің атым Мина
Dialogue: 0,0:00:28.27,0:00:29.90,Default,,0,0,0,,Миина-сан...
Dialogue: 0,0:00:29.98,0:00:31.15,Default,,0,0,0,,Такума-сама деген не...
Dialogue: 0,0:00:31.23,0:00:32.40,Default,,0,0,0,,Құрметті!?
Dialogue: 0,0:00:32.49,0:00:34.36,Default,,0,0,0,,Ресми болмаса да
Dialogue: 0,0:00:34.95,0:00:36.82,Default,,0,0,0,,Қарым-қатынас ерлі-зайыптылар сияқты.
Dialogue: 0,0:00:38.62,0:00:40.33,Default,,0,0,0,,Уф...
Dialogue: 0,0:00:41.41,0:00:44.54,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:00:44.62,0:00:45.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:46.54,0:00:49.75,Default,,0,0,0,,Мен әйел ретінде күйеуімнің телефон қоңырауларына жауап бергенім дұрыс деп ойладым.
Dialogue: 0,0:00:49.84,0:00:51.09,Default,,0,0,0,,Біз шештік
Dialogue: 0,0:00:51.17,0:00:53.84,Default,,0,0,0,,Иә, дұрыс... Менің ойымша, бұл жақсы.
Dialogue: 0,0:00:54.42,0:00:57.34,Default,,0,0,0,,Мен Акаримін, Такума Косугидің сіңлісі.
Dialogue: 0,0:00:57.43,0:01:00.60,Default,,0,0,0,,Әй... Келесі жолы барып сәлем берсем болады ма?
Dialogue: 0,0:01:00.68,0:01:02.18,Default,,0,0,0,,Мәселе жоқ
Dialogue: 0,0:01:02.27,0:01:04.64,Default,,0,0,0,,Саған сұрақтар қоюыма болады ма?
Dialogue: 0,0:01:04.73,0:01:08.35,Default,,0,0,0,,А... ерекше ештеңе жоқ! Ал... сонда
Dialogue: 0,0:01:09.27,0:01:11.11,Default,,0,0,0,,Я...
Dialogue: 0,0:01:15.99,0:01:17.61,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:01:17.70,0:01:18.87,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:01:19.95,0:01:22.87,Default,,0,0,0,,Иә? Смартфон... Бірдеңе болды ма?
Dialogue: 0,0:01:24.79,0:01:26.33,Default,,0,0,0,,Атап айтқанда, ештеңе болмаған сияқты.
Dialogue: 0,0:01:27.62,0:01:28.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:29.04,0:01:34.71,Default,,0,0,0,,♪～
Dialogue: 0,0:02:52.58,0:02:57.59,Default,,0,0,0,,～♪
Dialogue: 0,0:03:00.84,0:03:03.26,Default,,0,0,0,,Бұл бәрібір.
Dialogue: 0,0:03:04.01,0:03:06.89,Default,,0,0,0,,(Такуманың гуілдеуі)
Dialogue: 0,0:03:10.27,0:03:11.77,Default,,0,0,0,,(Смартфон қоңырау үні)
Dialogue: 0,0:03:13.06,0:03:14.65,Default,,0,0,0,,Акарида
Dialogue: 0,0:03:14.73,0:03:16.15,Default,,0,0,0,,Сәлеметсіз бе?
Dialogue: 0,0:03:16.23,0:03:18.03,Default,,0,0,0,,Мен бүгін барамын.
Dialogue: 0,0:03:18.11,0:03:19.49,Default,,0,0,0,,Не болды, кенет не болды?
Dialogue: 0,0:03:19.57,0:03:21.78,Default,,0,0,0,,Мен бұл туралы ештеңе істей алмаймын.
Dialogue: 0,0:03:21.86,0:03:24.12,Default,,0,0,0,,Маған айтар сөзің жоқ па?
Dialogue: 0,0:03:24.20,0:03:26.20,Default,,0,0,0,,Мм... бірдеңе болды ма?
Dialogue: 0,0:03:26.28,0:03:28.70,Default,,0,0,0,,Жетеді! Мен бәрібір барамын!
Dialogue: 0,0:03:29.29,0:03:31.71,Default,,0,0,0,,О... ашуландың ба?
Dialogue: 0,0:03:31.79,0:03:34.79,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:03:34.88,0:03:36.54,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:03:40.97,0:03:44.39,Default,,0,0,0,,Қайтадан қош келдіңіз. Үйге ерте келдің.
Dialogue: 0,0:03:44.47,0:03:45.60,Default,,0,0,0,,Иә
Dialogue: 0,0:03:45.68,0:03:47.60,Default,,0,0,0,,Мен әлі кешкі ас дайындаған жоқпын.
Dialogue: 0,0:03:47.68,0:03:48.68,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:03:48.77,0:03:50.89,Default,,0,0,0,,А, бүгін...
Dialogue: 0,0:03:52.69,0:03:53.90,Default,,0,0,0,,Іс жүзінде...
Dialogue: 0,0:03:53.98,0:03:56.90,Default,,0,0,0,,Қонақтар қазір келе жатқан сияқты.
Dialogue: 0,0:03:59.32,0:04:00.40,Default,,0,0,0,,Мина-чан
Dialogue: 0,0:04:01.07,0:04:04.57,Default,,0,0,0,,Кешіріңіз, бірақ бір сәт осында кіре аласыз ба?
Dialogue: 0,0:04:08.99,0:04:10.62,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:04:15.79,0:04:16.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:21.34,0:04:23.22,Default,,0,0,0,,Жақында үйге келесіз деп ойлаймын.
Dialogue: 0,0:04:23.30,0:04:24.84,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:04:29.18,0:04:31.39,Default,,0,0,0,,У… Уу…
Dialogue: 0,0:04:31.47,0:04:32.81,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:33.89,0:04:35.65,Default,,0,0,0,,Хаха Мина-чан!
Dialogue: 0,0:04:36.19,0:04:38.40,Default,,0,0,0,,Мина-чан! Уф, бұл...
Dialogue: 0,0:04:39.02,0:04:41.40,Default,,0,0,0,,Кешіріңіз! Ақыры шық
Dialogue: 0,0:04:41.48,0:04:43.32,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:04:45.61,0:04:48.28,Default,,0,0,0,,Негізі қазір апам келеді.
Dialogue: 0,0:04:48.37,0:04:50.08,Default,,0,0,0,,Сізбен кездесе аламын ба?
Dialogue: 0,0:04:50.16,0:04:51.66,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:04:51.74,0:04:54.12,Default,,0,0,0,,Интернеттегі ақпарат бойынша
Dialogue: 0,0:04:54.21,0:04:57.08,Default,,0,0,0,,Күйеуімнің әпкесі де менің әпкем сияқты.
Dialogue: 0,0:04:57.17,0:04:58.17,Default,,0,0,0,,Иә
Dialogue: 0,0:04:58.25,0:04:59.54,Default,,0,0,0,,Әпкеме
Dialogue: 0,0:04:59.63,0:05:02.17,Default,,0,0,0,,Сіз әдетте қалай жауап берер едіңіз?
Dialogue: 0,0:05:02.88,0:05:05.17,Default,,0,0,0,,Сіз маған не ойласаңыз, айта аласыз.
Dialogue: 0,0:05:05.84,0:05:08.18,Default,,0,0,0,,Қандай жағдай болмасын, мен сонда боламын.
Dialogue: 0,0:05:08.26,0:05:09.85,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:05:10.39,0:05:13.22,Default,,0,0,0,,(есік қоңырауының дыбысы)
Dialogue: 0,0:05:13.31,0:05:17.56,Default,,0,0,0,,(Есік қоңырауының қайта-қайта соғуы)
Dialogue: 0,0:05:17.65,0:05:20.15,Default,,0,0,0,,А, иә... сәлем
Dialogue: 0,0:05:20.23,0:05:21.90,Default,,0,0,0,,Акари-чан, сен бүгін не істеп жүрсің?
Dialogue: 0,0:05:21.98,0:05:24.24,Default,,0,0,0,,Үлкен аға... ақымақ!
Dialogue: 0,0:05:24.32,0:05:25.90,Default,,0,0,0,,Уф! Ах...
Dialogue: 0,0:05:25.99,0:05:27.99,Default,,0,0,0,,Неге қызың бар деп үндемейсің?
Dialogue: 0,0:05:28.07,0:05:30.62,Default,,0,0,0,,Оның үстіне ол кәдімгі әйелі ғой, солай ма?
Dialogue: 0,0:05:30.70,0:05:32.37,Default,,0,0,0,,Не!? Сіз қалай білесіз?
Dialogue: 0,0:05:32.45,0:05:34.08,Default,,0,0,0,,Жаса!
Dialogue: 0,0:05:34.16,0:05:36.79,Default,,0,0,0,,Тым азғын! Ол адам қайда...
Dialogue: 0,0:05:36.87,0:05:38.88,Default,,0,0,0,,- (Мина) Такума-сама... - Иә?
Dialogue: 0,0:05:39.46,0:05:41.21,Default,,0,0,0,,Сіз азғынсыз ба?
Dialogue: 0,0:05:42.21,0:05:43.21,Default,,0,0,0,,Е...
Dialogue: 0,0:05:43.30,0:05:45.05,Default,,0,0,0,,Такума-сама қарсы жынысқа қатысты
Dialogue: 0,0:05:45.13,0:05:47.09,Default,,0,0,0,,...
Dialogue: 0,0:05:47.18,0:05:49.64,Default,,0,0,0,,Интернетте сөздердің мағынасын іздемеңіз
Dialogue: 0,0:05:50.22,0:05:51.97,Default,,0,0,0,,B… Робот?
Dialogue: 0,0:05:52.06,0:05:54.14,Default,,0,0,0,,...
Dialogue: 0,0:05:54.22,0:05:56.35,Default,,0,0,0,,Мына бала сондай.
Dialogue: 0,0:05:56.43,0:05:59.65,Default,,0,0,0,,Бұл Мина, менің кәдімгі әйелім. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:06:00.31,0:06:04.11,Default,,0,0,0,,Сонымен... өте сүйкімді!
Dialogue: 0,0:06:06.19,0:06:07.57,Default,,0,0,0,,Жоқ... жоқ!
Dialogue: 0,0:06:08.20,0:06:11.45,Default,,0,0,0,,… …  !?
Dialogue: 0,0:06:12.66,0:06:14.16,Default,,0,0,0,,Тіпті тәтті, бал иісі бар дене жылуы
Dialogue: 0,0:06:14.24,0:06:17.83,Default,,0,0,0,,Маған бұл қыз ұнайды... Не?
Dialogue: 0,0:06:19.58,0:06:21.08,Default,,0,0,0,,Я… Ба…
Dialogue: 0,0:06:21.71,0:06:23.21,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:06:23.29,0:06:24.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:25.21,0:06:28.34,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:06:28.42,0:06:31.76,Default,,0,0,0,,Сіз роботпен шындап кездесесіз бе?
Dialogue: 0,0:06:31.84,0:06:34.47,Default,,0,0,0,,Міне... болды...
Dialogue: 0,0:06:34.56,0:06:36.93,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:06:40.02,0:06:42.52,Default,,0,0,0,,Адам-робот жұбы?
Dialogue: 0,0:06:42.61,0:06:45.90,Default,,0,0,0,,Керемет!
Dialogue: 0,0:06:46.48,0:06:48.65,Default,,0,0,0,,Сізде қиындықтар болды ма?
Dialogue: 0,0:06:48.74,0:06:50.91,Default,,0,0,0,,Жоқ... бұл жақсы.
Dialogue: 0,0:06:51.82,0:06:54.58,Default,,0,0,0,,...
Dialogue: 0,0:06:54.66,0:06:57.25,Default,,0,0,0,,...
Dialogue: 0,0:06:57.33,0:06:58.66,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:06:59.79,0:07:01.00,Default,,0,0,0,,Уау
Dialogue: 0,0:07:01.71,0:07:03.92,Default,,0,0,0,,Кешіріңіз... Менің көңілім қалды.
Dialogue: 0,0:07:05.92,0:07:09.09,Default,,0,0,0,,Роботқа ғашық болуға болмайды деген ереже жоқ.
Dialogue: 0,0:07:09.17,0:07:11.59,Default,,0,0,0,,Бұл өз алдына жақсы деп ойлаймын.
Dialogue: 0,0:07:11.68,0:07:14.35,Default,,0,0,0,,Дегенмен! Үлкен ағамен романтикалық қарым-қатынас
Dialogue: 0,0:07:14.43,0:07:16.35,Default,,0,0,0,,Әсіресе, ерлі-зайыптылар болсақ.
Dialogue: 0,0:07:16.43,0:07:20.56,Default,,0,0,0,,Алдымен мен жеңуім керек, сіңілім!
Dialogue: 0,0:07:20.64,0:07:24.06,Default,,0,0,0,,Түсінді. Қарсыласын ренжітпей қабілетсіз ету.
Dialogue: 0,0:07:24.15,0:07:26.15,Default,,0,0,0,,Эскорт режиміне ауысу үшін
Dialogue: 0,0:07:26.23,0:07:28.86,Default,,0,0,0,,Такума-самаға шабуыл жасай аласыз ба?
Dialogue: 0,0:07:28.94,0:07:31.82,Default,,0,0,0,,Жоқ... Мина-чан бұл жай ғана сөздің айласы.
Dialogue: 0,0:07:31.90,0:07:33.61,Default,,0,0,0,,Мені сендіруіңізді өтінемін
Dialogue: 0,0:07:33.70,0:07:36.03,Default,,0,0,0,,Мен Мина-сан туралы көбірек білгім келеді.
Dialogue: 0,0:07:36.12,0:07:39.70,Default,,0,0,0,,Мен біраз әңгіме естігім келеді, жақсы ма?
Dialogue: 0,0:07:39.79,0:07:41.46,Default,,0,0,0,,Мәселе жоқ
Dialogue: 0,0:07:42.12,0:07:44.00,Default,,0,0,0,,Ал, аға, бір жаққа барыңыз.
Dialogue: 0,0:07:44.08,0:07:45.63,Default,,0,0,0,,Мен сізге кейінірек қоңырау шаламын.
Dialogue: 0,0:07:45.71,0:07:47.00,Default,,0,0,0,,Иә? неге?
Dialogue: 0,0:07:47.09,0:07:50.63,Default,,0,0,0,,Қыздардың ғана қолынан келетін әңгіме бар!
Dialogue: 0,0:07:54.59,0:07:59.93,Default,,0,0,0,,(Сағаттың секунд тілі дыбысы)
Dialogue: 0,0:08:00.81,0:08:03.77,Default,,0,0,0,,Сабырлан... Акари тыныштал
Dialogue: 0,0:08:03.85,0:08:06.61,Default,,0,0,0,,Адамдардың қарым-қатынасын толқумен тыңдау.
Dialogue: 0,0:08:06.69,0:08:08.19,Default,,0,0,0,,Дөрекіліктің шыңы
Dialogue: 0,0:08:08.77,0:08:11.82,Default,,0,0,0,,Өзімді сабырлы кейіп танытып, қарындасым естігенше айту.
Dialogue: 0,0:08:11.90,0:08:15.07,Default,,0,0,0,,Робот пен адам арасындағы достық қарым-қатынас сияқты нәрсе.
Dialogue: 0,0:08:15.16,0:08:17.20,Default,,0,0,0,,Түбір қазуды тыңдау...
Dialogue: 0,0:08:17.28,0:08:22.46,Default,,0,0,0,,Үйге келген соң, оны мұқият шайнау керек, Акари!
Dialogue: 0,0:08:23.08,0:08:25.21,Default,,0,0,0,,Сонда бұл тек тамақ дайындауға арналған ба?
Dialogue: 0,0:08:25.29,0:08:26.58,Default,,0,0,0,,Тұрмыстық роботтар
Dialogue: 0,0:08:26.67,0:08:29.17,Default,,0,0,0,,Бұл Supermina-ның шектеулі нұсқасы болады.
Dialogue: 0,0:08:29.25,0:08:32.42,Default,,0,0,0,,Керемет~ Сенің де менің үйіме келгеніңді қалаймын~
Dialogue: 0,0:08:32.51,0:08:34.51,Default,,0,0,0,,Мен бара алмаймын, өйткені жұмысым бар.
Dialogue: 0,0:08:34.59,0:08:38.18,Default,,0,0,0,,Ең алдымен, жазықсыз оқиғалармен атмосфераны жылытуға назар аударыңыз...
Dialogue: 0,0:08:39.76,0:08:44.35,Default,,0,0,0,,Мина-сан ағасын ұнатады...осы ма?
Dialogue: 0,0:08:44.44,0:08:47.44,Default,,0,0,0,,Уау! Мен ойлаған нәрсе аузымнан шығып кетті! Бұл ақылсыз!
Dialogue: 0,0:08:48.02,0:08:50.65,Default,,0,0,0,,Мен «ұнату» дегенді түсінбеймін.
Dialogue: 0,0:08:50.73,0:08:55.03,Default,,0,0,0,,Хм, мен біреуді ұнатамын десем, бұл оның ерекше екенін білдіреді деп ойлаймын.
Dialogue: 0,0:08:55.11,0:08:57.32,Default,,0,0,0,,Мысалы, мен шебер болсам
Dialogue: 0,0:08:57.41,0:09:00.08,Default,,0,0,0,,Егер мен саған тұрмысқа шығуымды өтінсең, солай етер ме едің деп ойлайсың ба?
Dialogue: 0,0:09:00.16,0:09:03.58,Default,,0,0,0,,Иә, мен қожайынымның бұйрығына қолымнан келгенше жауап беремін.
Dialogue: 0,0:09:03.66,0:09:06.00,Default,,0,0,0,,А, олай емес...
Dialogue: 0,0:09:06.50,0:09:09.17,Default,,0,0,0,,Маған үйленсең, өмірің қалай болады?
Dialogue: 0,0:09:09.25,0:09:12.51,Default,,0,0,0,,Ағаңызбен отбасылық өміріңізді елестетіңіз.
Dialogue: 0,0:09:13.05,0:09:14.67,Default,,0,0,0,,Мен сенің осындай сөздер айтқаныңды ұнатпаймын, Маюши.
Dialogue: 0,0:09:15.80,0:09:17.97,Default,,0,0,0,,Такума-самамен өмір
Dialogue: 0,0:09:18.05,0:09:21.72,Default,,0,0,0,,Уф!
Dialogue: 0,0:09:22.47,0:09:24.02,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:09:24.10,0:09:25.48,Default,,0,0,0,,Дада... Дайжобу
Dialogue: 0,0:09:26.52,0:09:27.90,Default,,0,0,0,,Сонымен... бұл неге?
Dialogue: 0,0:09:27.98,0:09:29.48,Default,,0,0,0,,Неліктен аға аға жақсырақ?
Dialogue: 0,0:09:30.15,0:09:32.53,Default,,0,0,0,,Акари-сама туралы мәліметтер өте аз.
Dialogue: 0,0:09:32.61,0:09:34.61,Default,,0,0,0,,Модельдеу орындалмады
Dialogue: 0,0:09:34.69,0:09:37.36,Default,,0,0,0,,Хмм... Сол себепті ме?
Dialogue: 0,0:09:37.95,0:09:41.62,Default,,0,0,0,,Сонда басқарудан тыс арба жоғары жылдамдықпен жүріп жатыр.
Dialogue: 0,0:09:41.70,0:09:44.12,Default,,0,0,0,,Осы қарқынмен мен жолдың соңында жатқан болар едім.
Dialogue: 0,0:09:44.20,0:09:46.96,Default,,0,0,0,,Үлкен ағаны басып кетіп, өлтірілді! Мен мұны істеймін
Dialogue: 0,0:09:47.04,0:09:49.75,Default,,0,0,0,,Ондай жерде неге қобалжыдың?
Dialogue: 0,0:09:49.83,0:09:51.88,Default,,0,0,0,,Мм... және... бәрібір.
Dialogue: 0,0:09:51.96,0:09:53.96,Default,,0,0,0,,Мина сайлаушылардың дәл қасында болды.
Dialogue: 0,0:09:54.05,0:09:55.72,Default,,0,0,0,,Сіз үлкен ағаға көмектесе аласыз!
Dialogue: 0,0:09:55.80,0:10:00.05,Default,,0,0,0,,Бірақ айырдың соңында мен танымайтын бір қария тұр екен.
Dialogue: 0,0:10:00.14,0:10:02.89,Default,,0,0,0,,Келіңіздер! Мина, сен дауыс беруді ауыстырасың ба?
Dialogue: 0,0:10:02.97,0:10:05.18,Default,,0,0,0,,Біреуге қауіпті әрекеттер
Dialogue: 0,0:10:05.27,0:10:08.89,Default,,0,0,0,,Бағдарламалық түрде жасай алмағандықтан, мен сайлаушылардың қатысуына тиіспейтін шығармын.
Dialogue: 0,0:10:08.98,0:10:11.52,Default,,0,0,0,,Минакарта жақындап қалды! Мина осылай қалады.
Dialogue: 0,0:10:11.61,0:10:13.90,Default,,0,0,0,,Ағамды басып қалып өлтірсе, жарай ма?
Dialogue: 0,0:10:13.98,0:10:17.49,Default,,0,0,0,,Өйткені Такума мырзаның тұратын аймағында арбалар жоқ.
Dialogue: 0,0:10:17.57,0:10:19.91,Default,,0,0,0,,Мұндай жағдайды болжауға болмайды
Dialogue: 0,0:10:19.99,0:10:21.41,Default,,0,0,0,,Такума-сама...
Dialogue: 0,0:10:22.74,0:10:23.83,Default,,0,0,0,,Мен қауіпсізмін.
Dialogue: 0,0:10:25.24,0:10:26.29,Default,,0,0,0,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,0:10:26.37,0:10:29.79,Default,,0,0,0,,Роботтың сезімін тексеру қиын...
Dialogue: 0,0:10:29.87,0:10:31.46,Default,,0,0,0,,Акари-сама
Dialogue: 0,0:10:31.54,0:10:33.54,Default,,0,0,0,,Мен де сізге сұрақ қоя аламын ба?
Dialogue: 0,0:10:33.63,0:10:35.88,Default,,0,0,0,,- Не? -(Мина) Такума-сама бұрын болған
Dialogue: 0,0:10:35.96,0:10:38.51,Default,,0,0,0,,Сен мені ұнататынын айттың.
Dialogue: 0,0:10:38.59,0:10:41.89,Default,,0,0,0,,Бұл жеке адам ретінде мен ғана ерекшемін дегенді білдіре ме?
Dialogue: 0,0:10:41.97,0:10:43.68,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:10:43.76,0:10:45.51,Default,,0,0,0,,Мысалы, Такума-сама
Dialogue: 0,0:10:45.60,0:10:48.18,Default,,0,0,0,,Супермина екеуміздің бағамыз бірдей болса да.
Dialogue: 0,0:10:48.27,0:10:49.94,Default,,0,0,0,,Сіз мені сатып алғыңыз келе ме?
Dialogue: 0,0:10:50.02,0:10:51.15,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:51.23,0:10:53.86,Default,,0,0,0,,Ух... иә! Мен оны міндетті түрде таңдаймын!
Dialogue: 0,0:10:53.94,0:10:54.94,Default,,0,0,0,,Бұл...
Dialogue: 0,0:10:55.02,0:10:58.78,Default,,0,0,0,,Солай ма? Сонда Такума-сама шығынға ұшырайды.
Dialogue: 0,0:10:58.86,0:11:00.82,Default,,0,0,0,,Жоқ! Бұл шығын емес!
Dialogue: 0,0:11:00.91,0:11:03.95,Default,,0,0,0,,Мина-санның еш нәрсемен салыстыруға келмейтін құндылығы бар!
Dialogue: 0,0:11:04.03,0:11:06.29,Default,,0,0,0,,Міне! Міне бітті!
Dialogue: 0,0:11:07.66,0:11:08.95,Default,,0,0,0,,Маған ұнайды!
Dialogue: 0,0:11:09.96,0:11:11.50,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:11:11.58,0:11:13.96,Default,,0,0,0,,Жоқ... жоқ... мүмкін емес.
Dialogue: 0,0:11:21.47,0:11:23.47,Default,,0,0,0,,Сәнге қызығушылық және т.б.
Dialogue: 0,0:11:21.47,0:11:23.47,Default,,0,0,0,,Әңгімелескенде мен ағамды ұната бастадым.
Dialogue: 0,0:11:23.47,0:11:23.55,Default,,0,0,0,,Әңгімелескенде мен ағамды ұната бастадым.
Dialogue: 0,0:11:23.55,0:11:24.47,Default,,0,0,0,,Әңгімелескенде мен ағамды ұната бастадым.
Dialogue: 0,0:11:23.55,0:11:24.47,Default,,0,0,0,,Сән деген не?
Dialogue: 0,0:11:24.47,0:11:24.55,Default,,0,0,0,,Сән деген не?
Dialogue: 0,0:11:24.55,0:11:25.97,Default,,0,0,0,,Сән деген не?
Dialogue: 0,0:11:24.55,0:11:25.97,Default,,0,0,0,,Мен түсінгендей болдым.
Dialogue: 0,0:11:26.06,0:11:28.72,Default,,0,0,0,,Мен Минаны дүкеннен сатып алғанымды білдім.
Dialogue: 0,0:11:26.06,0:11:28.72,Default,,0,0,0,,Өзіңізді әдемі жылтырату
Dialogue: 0,0:11:29.27,0:11:31.14,Default,,0,0,0,,Сорады, бірақ жүрегімді елжіретеді
Dialogue: 0,0:11:29.27,0:11:31.14,Default,,0,0,0,,Мен оны техникалық қызмет көрсету үшін жасадым.
Dialogue: 0,0:11:31.23,0:11:32.23,Default,,0,0,0,,Хаха…
Dialogue: 0,0:11:32.31,0:11:35.36,Default,,0,0,0,,Мен білгім келетін нәрселер көп, бірақ
Dialogue: 0,0:11:32.31,0:11:35.36,Default,,0,0,0,,Мен де ерекше ештеңе істеген жоқпын.
Dialogue: 0,0:11:35.44,0:11:37.86,Default,,0,0,0,,Мен сұрамауым керек сияқты...
Dialogue: 0,0:11:35.44,0:11:37.86,Default,,0,0,0,,Мен мұны істеуім керек деп ойладым.
Dialogue: 0,0:11:37.94,0:11:42.11,Default,,0,0,0,,А... Айтпақшы, бұрынғы иесі қандай адам болған?
Dialogue: 0,0:11:42.20,0:11:44.49,Default,,0,0,0,,Мен бұл туралы ойладым, бірақ кейін мен оны естідім ...
Dialogue: 0,0:11:44.57,0:11:46.99,Default,,0,0,0,,Мен әрең есімде қалдым
Dialogue: 0,0:11:47.08,0:11:50.04,Default,,0,0,0,,Иесі туралы ақпараттың көпшілігі шифрланған.
Dialogue: 0,0:11:50.12,0:11:51.50,Default,,0,0,0,,Анықтама үшін енді қолжетімсіз
Dialogue: 0,0:11:51.58,0:11:52.83,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:11:52.92,0:11:55.00,Default,,0,0,0,,Деректер фрагменттерінен қорытынды жасау
Dialogue: 0,0:11:55.08,0:11:57.75,Default,,0,0,0,,Алдыңғы иесі мені сатып алғанымен
Dialogue: 0,0:11:57.84,0:12:01.38,Default,,0,0,0,,Денесі машина сияқты, мимикасы жоқ
Dialogue: 0,0:12:01.47,0:12:03.63,Default,,0,0,0,,Өзін адамдай ұстай алмау
Dialogue: 0,0:12:03.72,0:12:05.01,Default,,0,0,0,,Біраз наразылық бар сияқты.
Dialogue: 0,0:12:06.60,0:12:09.10,Default,,0,0,0,,Мені дүкенге сат
Dialogue: 0,0:12:09.18,0:12:12.02,Default,,0,0,0,,Мен Суперминаны қосымша ақшаға сатып алдым.
Dialogue: 0,0:12:12.64,0:12:14.56,Default,,0,0,0,,Ю... Мен сені кешіре алмаймын.
Dialogue: 0,0:12:15.10,0:12:16.65,Default,,0,0,0,,Осылай ойлану
Dialogue: 0,0:12:16.73,0:12:20.32,Default,,0,0,0,,Мен арзан нұсқасына риза болдым деген қорытындыға келдім...
Dialogue: 0,0:12:20.40,0:12:21.78,Default,,0,0,0,,(Джозеф Джоэстар) Бақытына орай, Авдолдың мойнындағы жара маңызды нүктеден тыс қалған, сондықтан—
Dialogue: 0,0:12:21.86,0:12:23.82,Default,,0,0,0,,Егер мен кемелсіз болмасам
Dialogue: 0,0:12:23.90,0:12:26.07,Default,,0,0,0,,Бұрынғы иесімен бірге
Dialogue: 0,0:12:26.66,0:12:29.24,Default,,0,0,0,,Мен Такума мырзамен кездесе алмас едім.
Dialogue: 0,0:12:31.16,0:12:34.33,Default,,0,0,0,,Сен жау емес екеніңе қуаныштымын. Мен сені жеңе алмас едім.
Dialogue: 0,0:12:36.42,0:12:39.34,Default,,0,0,0,,Олай болса, бұл алмас сақина да.
Dialogue: 0,0:12:39.42,0:12:40.84,Default,,0,0,0,,Мен оны түсінбедім.
Dialogue: 0,0:12:40.92,0:12:42.34,Default,,0,0,0,,Гауһар!?
Dialogue: 0,0:12:42.42,0:12:45.22,Default,,0,0,0,,Мен де Такума-саманың кәдімгі әйелі болмаймын.
Dialogue: 0,0:12:45.30,0:12:47.09,Default,,0,0,0,,Мен тіпті пикникке де бара алмадым.
Dialogue: 0,0:12:48.05,0:12:51.60,Default,,0,0,0,,Мен...арзан нұсқасын алғаныма қуаныштымын.
Dialogue: 0,0:12:52.81,0:12:53.85,Default,,0,0,0,,Иә
Dialogue: 0,0:12:53.93,0:12:56.02,Default,,0,0,0,,Қазір сізді бір нәрсе мазалайды ма?
Dialogue: 0,0:12:56.10,0:12:57.86,Default,,0,0,0,,Егер менің қолымнан келетін нәрсе болса, мен оны істеймін.
Dialogue: 0,0:12:57.94,0:12:59.19,Default,,0,0,0,,Мина қатары
Dialogue: 0,0:12:59.27,0:13:01.28,Default,,0,0,0,,Мен люкс опциясын орнатуды қалаймын
Dialogue: 0,0:13:01.36,0:13:02.36,Default,,0,0,0,,Қанша?
Dialogue: 0,0:13:02.44,0:13:04.32,Default,,0,0,0,,7,5 миллион иен
Dialogue: 0,0:13:05.53,0:13:07.49,Default,,0,0,0,,Кешіріңіз, мен қымбат нәрсені ала алмаймын...
Dialogue: 0,0:13:07.57,0:13:10.03,Default,,0,0,0,,Енді мен жад картасын алғым келеді
Dialogue: 0,0:13:10.12,0:13:12.54,Default,,0,0,0,,Егер сізде сандық фотоаппарат болса, ол бар.
Dialogue: 0,0:13:12.62,0:13:13.70,Default,,0,0,0,,Иә
Dialogue: 0,0:13:13.79,0:13:16.33,Default,,0,0,0,,Сіз мұны қалайтыныңызға сенімдісіз бе?
Dialogue: 0,0:13:17.08,0:13:18.54,Default,,0,0,0,,Рахмет
Dialogue: 0,0:13:18.63,0:13:20.71,Default,,0,0,0,,Қош келдіңіз, бірақ не...
Dialogue: 0,0:13:20.79,0:13:21.71,Default,,0,0,0,,Ах!?
Dialogue: 0,0:13:23.26,0:13:25.47,Default,,0,0,0,,Сақтық көшірме жасау
Dialogue: 0,0:13:25.55,0:13:27.47,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:13:27.55,0:13:28.97,Default,,0,0,0,,Ум...
Dialogue: 0,0:13:29.05,0:13:32.52,Default,,0,0,0,,Онии-чан мен Мина-сан жұп, солай ма?
Dialogue: 0,0:13:32.60,0:13:35.94,Default,,0,0,0,,Бұл ресми емес, бірақ біз жұппыз.
Dialogue: 0,0:13:36.02,0:13:37.48,Default,,0,0,0,,Аа... жұптық
Dialogue: 0,0:13:37.56,0:13:40.94,Default,,0,0,0,,Терісі деген бар ма?
Dialogue: 0,0:13:41.73,0:13:43.98,Default,,0,0,0,,Мен не істеуім керек? Мен жыныстық құмарлықты тоқтата алмаймын ...
Dialogue: 0,0:13:44.07,0:13:45.28,Default,,0,0,0,,Акари-сама
Dialogue: 0,0:13:45.36,0:13:48.03,Default,,0,0,0,,Ой... Кешіріңіз, мен сізден біртүрлі нәрсе сұрадым.
Dialogue: 0,0:13:48.11,0:13:50.74,Default,,0,0,0,,Біз жұп болғандықтан, Такума-сама ұйықтағанда
Dialogue: 0,0:13:50.83,0:13:52.87,Default,,0,0,0,,Мен де сол футонда ұйықтаймын.
Dialogue: 0,0:13:53.66,0:13:57.62,Default,,0,0,0,,Сол кезде сіз Такума-самамен физикалық байланыста болуыңыз мүмкін.
Dialogue: 0,0:13:58.33,0:14:00.54,Default,,0,0,0,,Бұл тері жамылғысына тең бола ма?
Dialogue: 0,0:14:00.63,0:14:01.88,Default,,0,0,0,,На… на…
Dialogue: 0,0:14:01.96,0:14:04.88,Default,,0,0,0,,Бұл болады!
Dialogue: 0,0:14:10.26,0:14:13.64,Default,,0,0,0,,Екеуің не туралы айтып тұрсыңдар?
Dialogue: 0,0:14:15.27,0:14:18.64,Default,,0,0,0,,Ху~ Менің жүрегім толып кетті
Dialogue: 0,0:14:22.77,0:14:24.57,Default,,0,0,0,,Менің тағы бір өтінішім бар ма?
Dialogue: 0,0:14:24.65,0:14:25.65,Default,,0,0,0,,Әрине
Dialogue: 0,0:14:26.32,0:14:27.78,Default,,0,0,0,,Бірдеңе болған жағдайда
Dialogue: 0,0:14:27.86,0:14:30.78,Default,,0,0,0,,Мен бұл деректер Акари-самада болғанын қалаймын.
Dialogue: 0,0:14:30.87,0:14:31.91,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:14:32.49,0:14:35.66,Default,,0,0,0,,Бірақ бұл деңгейде барлығының сақтық көшірмесін жасай алмайсыз.
Dialogue: 0,0:14:35.74,0:14:37.50,Default,,0,0,0,,Қалпына келтіру үшін қажетті деректер
Dialogue: 0,0:14:37.58,0:14:41.25,Default,,0,0,0,,Мәселе жоқ, себебі ол серверде автоматты түрде сақталады
Dialogue: 0,0:14:41.33,0:14:42.42,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:14:43.13,0:14:46.17,Default,,0,0,0,,Сонымен... бұл...
Dialogue: 0,0:14:48.05,0:14:51.05,Default,,0,0,0,,Жарайды, мен оны сақтаймын.
Dialogue: 0,0:14:51.14,0:14:52.43,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:14:53.72,0:14:56.81,Default,,0,0,0,,Ах... алғаныма өкінемін...
Dialogue: 0,0:14:58.14,0:14:59.44,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:59.52,0:15:03.81,Default,,0,0,0,,Иленген иіссудың әртүрлі иісі бар.
Dialogue: 0,0:15:03.90,0:15:07.44,Default,,0,0,0,,Аздап алып, білегіңізге жағыңыз...
Dialogue: 0,0:15:09.53,0:15:12.36,Default,,0,0,0,,Жағымды иісі бар қыздың дүниеге келуі!
Dialogue: 0,0:15:12.45,0:15:14.45,Default,,0,0,0,,Жағымды иісі бар қыз...
Dialogue: 0,0:15:14.53,0:15:16.70,Default,,0,0,0,,-Оны қолданып көргің келе ме? -(Мина) Мен қолданамын.
Dialogue: 0,0:15:17.33,0:15:19.12,Default,,0,0,0,,Біраз алыңыз...
Dialogue: 0,0:15:19.20,0:15:20.71,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:15:20.79,0:15:22.21,Default,,0,0,0,,Уау!?
Dialogue: 0,0:15:22.88,0:15:25.04,Default,,0,0,0,,Саусағыңызда бөгде зат бар.
Dialogue: 0,0:15:25.13,0:15:27.21,Default,,0,0,0,,Дереу алып тастаңыз
Dialogue: 0,0:15:27.30,0:15:28.51,Default,,0,0,0,,Бұл не!?
Dialogue: 0,0:15:28.59,0:15:30.59,Default,,0,0,0,,Гигиена туралы ескерту
Dialogue: 0,0:15:31.22,0:15:34.60,Default,,0,0,0,,Білекке жаққанда шырылдап тұрады.
Dialogue: 0,0:15:34.68,0:15:37.60,Default,,0,0,0,,Бол... Басқа жерде сурет салайық!
Dialogue: 0,0:15:42.69,0:15:45.77,Default,,0,0,0,,Бір күні жоғалып кетуі мүмкін құнды естеліктер
Dialogue: 0,0:15:45.86,0:15:47.94,Default,,0,0,0,,Мен ағама айта алмаймын.
Dialogue: 0,0:15:48.03,0:15:49.11,Default,,0,0,0,,Мен мазмұнына сенімдімін...
Dialogue: 0,0:15:50.40,0:15:51.86,Default,,0,0,0,,(Қоңырау үні)
Dialogue: 0,0:15:51.95,0:15:55.66,Default,,0,0,0,,Сәлеметсіз бе, Онии-чан, тезірек оралыңыз.
Dialogue: 0,0:15:55.74,0:15:56.74,Default,,0,0,0,,Иә
Dialogue: 0,0:16:01.71,0:16:03.17,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:16:03.25,0:16:05.63,Default,,0,0,0,,Қош келдіңіз, Такума-сама
Dialogue: 0,0:16:05.71,0:16:08.05,Default,,0,0,0,,- Акари қайтып келді ме? -(Мина) Иә.
Dialogue: 0,0:16:08.13,0:16:11.38,Default,,0,0,0,,Мина-чанның тамағын жесем ғой.
Dialogue: 0,0:16:12.05,0:16:13.88,Default,,0,0,0,,Акаримен не туралы сөйлестіңіз?
Dialogue: 0,0:16:15.22,0:16:16.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:16.72,0:16:19.77,Default,,0,0,0,,Қыздардың не айтатыны құпия.
Dialogue: 0,0:16:19.85,0:16:20.89,Default,,0,0,0,,Тыныш
Dialogue: 0,0:16:24.73,0:16:27.48,Default,,0,0,0,,Мүмкін... солай шығар?
Dialogue: 0,0:16:28.44,0:16:30.73,Default,,0,0,0,,Бұл құпия.
Dialogue: 0,0:16:32.15,0:16:35.24,Default,,0,0,0,,H... Құпия болса, көмектеспейді.
Dialogue: 0,0:16:35.32,0:16:37.24,Default,,0,0,0,,Азық-түлік жақында дайын болады.
Dialogue: 0,0:16:37.32,0:16:39.24,Default,,0,0,0,,- (Мина) Күте тұрыңыз - Иә.
Dialogue: 0,0:16:41.16,0:16:42.16,Default,,0,0,0,,Е...
Dialogue: 0,0:16:45.08,0:16:47.33,Default,,0,0,0,,Кункун… Кункун…
Dialogue: 0,0:16:47.42,0:16:49.34,Default,,0,0,0,,Такума-сама
Dialogue: 0,0:16:49.42,0:16:51.55,Default,,0,0,0,,Пісіру кезінде жақындау қауіпті
Dialogue: 0,0:16:52.30,0:16:53.63,Default,,0,0,0,,Мазалағаным үшін кешіріңіз.
Dialogue: 0,0:16:53.72,0:16:56.64,Default,,0,0,0,,Маған бірінші айтсаңыз, еш қиындық жоқ.
Dialogue: 0,0:16:57.64,0:17:00.97,Default,,0,0,0,,Аздан кейін тамақтансақ болады ма?
Dialogue: 0,0:17:01.06,0:17:02.81,Default,,0,0,0,,Мәселе жоқ
Dialogue: 0,0:17:08.65,0:17:10.11,Default,,0,0,0,,(Қабылданған дыбыс)
Dialogue: 0,0:17:10.19,0:17:11.57,Default,,0,0,0,,Қазір қандай дыбыс?
Dialogue: 0,0:17:11.65,0:17:14.45,Default,,0,0,0,,Мен Акари-самадан хабар алдым.
Dialogue: 0,0:17:14.53,0:17:17.16,Default,,0,0,0,,А... сіз жеке куәліктермен алмастыңыз ба?
Dialogue: 0,0:17:17.24,0:17:18.62,Default,,0,0,0,,Иә Әртүрлі
Dialogue: 0,0:17:18.70,0:17:19.83,Default,,0,0,0,,Біз кеңес сұраймыз.
Dialogue: 0,0:17:20.99,0:17:22.75,Default,,0,0,0,,Хмм…
Dialogue: 0,0:17:22.83,0:17:24.12,Default,,0,0,0,,Не туралы айттыңыз...
Dialogue: 0,0:17:24.20,0:17:25.71,Default,,0,0,0,,Такума-сама
Dialogue: 0,0:17:25.79,0:17:29.67,Default,,0,0,0,,Такума-саманың туған күні 21 мамырда ма?
Dialogue: 0,0:17:29.75,0:17:31.04,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:17:32.55,0:17:33.76,Default,,0,0,0,,Не болды?
Dialogue: 0,0:17:33.84,0:17:35.22,Default,,0,0,0,,-(Мина) Тосын... -Иә?
Dialogue: 0,0:17:36.38,0:17:38.22,Default,,0,0,0,,Мен мұны құпия сақтағым келеді...
Dialogue: 0,0:17:38.30,0:17:39.68,Default,,0,0,0,,Хмм…
Dialogue: 0,0:17:39.76,0:17:41.47,Default,,0,0,0,,Мен мұны тосын сый жасауды жоспарлап отырмын.
Dialogue: 0,0:17:42.56,0:17:45.43,Default,,0,0,0,,Айтпақшы, Мина-чанның туған күні бар ма?
Dialogue: 0,0:17:45.52,0:17:47.64,Default,,0,0,0,,Көрсетілмеген
Dialogue: 0,0:17:47.73,0:17:50.86,Default,,0,0,0,,Түсіндім... онда шешеміз.
Dialogue: 0,0:17:50.94,0:17:53.15,Default,,0,0,0,,Сіз жаратылған күніңізді білесіз бе?
Dialogue: 0,0:17:53.23,0:17:56.57,Default,,0,0,0,,4 жыл бұрын 12 желтоқсанда шығарылған
Dialogue: 0,0:17:56.65,0:17:59.24,Default,,0,0,0,,Ал, ол күн сенің туған күнің.
Dialogue: 0,0:17:59.32,0:18:01.53,Default,,0,0,0,,- (Мина) Солай ма? -Иә
Dialogue: 0,0:18:01.62,0:18:02.62,Default,,0,0,0,,(Қабылданған дыбыс)
Dialogue: 0,0:18:02.70,0:18:04.37,Default,,0,0,0,,- Электрондық пошта? -(Мина) Иә.
Dialogue: 0,0:18:04.45,0:18:05.62,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:18:05.70,0:18:08.46,Default,,0,0,0,,Қыздар арасындағы әңгіме – құпия
Dialogue: 0,0:18:08.54,0:18:10.21,Default,,0,0,0,,Маған бәрібір.
Dialogue: 0,0:18:10.71,0:18:11.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:11.67,0:18:15.05,Default,,0,0,0,,Мен де Такумадан біраз кеңес алдым.
Dialogue: 0,0:18:15.13,0:18:16.13,Default,,0,0,0,,Не? Не?
Dialogue: 0,0:18:16.80,0:18:19.34,Default,,0,0,0,,Шашты 21 минут иіскеу
Dialogue: 0,0:18:19.43,0:18:21.64,Default,,0,0,0,,Ол бұл шынымен жиіркенішті екенін айтты.
Dialogue: 0,0:18:22.30,0:18:25.14,Default,,0,0,0,,Бұл кеңес емес, бұл жай ғана түсініктеме.
Dialogue: 0,0:18:25.22,0:18:27.02,Default,,0,0,0,,Алған әсерлерің қандай?
Dialogue: 0,0:18:27.10,0:18:30.02,Default,,0,0,0,,Менде жіберуші және қабылдаушы дыбыс өшірілді.
Dialogue: 0,0:18:34.90,0:18:35.90,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:18:36.53,0:18:38.40,Default,,0,0,0,,Қолымды ұсташы, өтінемін. Әрқашан істейтіндей.
Dialogue: 0,0:18:39.03,0:18:41.16,Default,,0,0,0,,Бүгін кешкі асқа не бар...
Dialogue: 0,0:18:47.25,0:18:48.66,Default,,0,0,0,,Иә!?
Dialogue: 0,0:18:48.75,0:18:50.92,Default,,0,0,0,,-Итта... -(Мина) Жақсысың ба?
Dialogue: 0,0:18:51.00,0:18:53.46,Default,,0,0,0,,Не... ол киімдерге не болды?
Dialogue: 0,0:18:53.54,0:18:55.84,Default,,0,0,0,,Оны маған Акари-сама сатып алды.
Dialogue: 0,0:18:55.92,0:18:58.17,Default,,0,0,0,,Ойланып қарасам, бірдеңе дедіңіз...
Dialogue: 0,0:19:03.76,0:19:05.81,Default,,0,0,0,,Әйтеуір, ол жақында ғана қорқынышты сынақтан өтті
Dialogue: 0,0:19:06.31,0:19:07.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:10.44,0:19:12.44,Default,,0,0,0,,Ха! Бұл… бұл…
Dialogue: 0,0:19:12.52,0:19:14.31,Default,,0,0,0,,Бұл сізге өте жарасады!
Dialogue: 0,0:19:14.40,0:19:15.77,Default,,0,0,0,,Сізге ұнады ма?
Dialogue: 0,0:19:15.86,0:19:16.86,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:16.94,0:19:18.61,Default,,0,0,0,,Бұл бәрінен бұрын
Dialogue: 0,0:19:19.15,0:19:21.70,Default,,0,0,0,,Менде әлі көп киім бар.
Dialogue: 0,0:19:21.78,0:19:22.99,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:23.53,0:19:26.95,Default,,0,0,0,,Өзіңіздің сүйікті киіміңіз туралы айтып бере аласыз ба?
Dialogue: 0,0:19:27.91,0:19:31.75,Default,,0,0,0,,(Қоңырау үні)
Dialogue: 0,0:19:31.83,0:19:33.13,Default,,0,0,0,,Сәлеметсіз бе, Акари?
Dialogue: 0,0:19:33.21,0:19:34.25,Default,,0,0,0,,Иә?не?
Dialogue: 0,0:19:34.33,0:19:37.34,Default,,0,0,0,,Көп сатып алуды сұрағаным үшін кешіріңіз... Ақшасын төлеймін.
Dialogue: 0,0:19:37.42,0:19:38.63,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:19:38.71,0:19:41.72,Default,,0,0,0,,Минамен сауда жасау өте қызық болды.
Dialogue: 0,0:19:42.34,0:19:45.55,Default,,0,0,0,,Мина мен оның ағасының қарым-қатынасы сүйкімді.
Dialogue: 0,0:19:45.64,0:19:48.14,Default,,0,0,0,,Жеке істеріңізге араласқаным үшін кешіріңіз.
Dialogue: 0,0:19:48.22,0:19:49.77,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:19:49.85,0:19:50.98,Default,,0,0,0,,Маған ұнамайды, бірақ
Dialogue: 0,0:19:51.94,0:19:54.23,Default,,0,0,0,,Маған көп нәрсені үйретуді жалғастыра беріңіз.
Dialogue: 0,0:19:54.31,0:19:58.03,Default,,0,0,0,,Мина-чан мен елестете алмайтын нәрсені істеп жатыр...
Dialogue: 0,0:19:58.61,0:19:59.74,Default,,0,0,0,,Мен бақыттымын
Dialogue: 0,0:20:00.36,0:20:03.16,Default,,0,0,0,,Шындық, әлем туралы көп білгеннен кейін,
Dialogue: 0,0:20:03.24,0:20:07.33,Default,,0,0,0,,Сонда да сен мені ең жақсымын деп ойласаң, үйленесің.
Dialogue: 0,0:20:08.08,0:20:10.75,Default,,0,0,0,,Сіз солай ойлайсыз деп үміттенемін...
Dialogue: 0,0:20:12.21,0:20:13.62,Default,,0,0,0,,Не!
Dialogue: 0,0:20:13.71,0:20:16.00,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:16.08,0:20:17.38,Default,,0,0,0,,Не... не болды!?
Dialogue: 0,0:20:17.46,0:20:18.80,Default,,0,0,0,,Басқа киімдер...
Dialogue: 0,0:20:18.88,0:20:20.67,Default,,0,0,0,,Бір минут күтіңіз!
Dialogue: 0,0:20:20.76,0:20:23.63,Default,,0,0,0,,Мұндай жерде киімдеріңізді шешпеңіз!
Dialogue: 0,0:20:26.76,0:20:28.01,Default,,0,0,0,,Үйлесімділіктің сыры
Dialogue: 0,0:20:28.10,0:20:30.64,Default,,0,0,0,,Бірге шомылу
Dialogue: 0,0:20:30.72,0:20:34.14,Default,,0,0,0,,Жұптар, бірге шомылайық!
Dialogue: 0,0:20:34.73,0:20:36.77,Default,,0,0,0,,Керемет~ Бірге шомылайық~
Dialogue: 0,0:20:36.86,0:20:39.15,Default,,0,0,0,,Ха~ Мен сені қатты сағындым~
Dialogue: 0,0:20:39.23,0:20:41.07,Default,,0,0,0,,Сіз бірге шомылғыңыз келе ме?
Dialogue: 0,0:20:41.15,0:20:42.53,Default,,0,0,0,,Қуа келе жатқандар кетті.
Dialogue: 0,0:20:42.61,0:20:44.15,Default,,0,0,0,,Сонымен... жақсысың ба?
Dialogue: 0,0:20:44.24,0:20:48.91,Default,,0,0,0,,Менің моделімде -57 градустан плюс 98 градусқа дейінгі температура диапазоны бар.
Dialogue: 0,0:20:48.99,0:20:51.87,Default,,0,0,0,,Ыстық пен суыққа төзімділік сынағынан өтті.
Dialogue: 0,0:20:51.95,0:20:54.67,Default,,0,0,0,,Ваннаның қызуынан қалтырап қалмайды.
Dialogue: 0,0:20:55.62,0:20:58.42,Default,,0,0,0,,Мина сериясы суға төзімділікке де ерекше.
Dialogue: 0,0:20:58.50,0:21:01.00,Default,,0,0,0,,«Супермина» жоғарғы моделі
Dialogue: 0,0:21:01.09,0:21:05.84,Default,,0,0,0,,Төзімділік сынағы кезінде жаяу Акаши бұғазының түбінен сәтті өтті
Dialogue: 0,0:21:05.93,0:21:07.18,Default,,0,0,0,,Сіз тым талғампазсыз ба?
Dialogue: 0,0:21:07.26,0:21:09.39,Default,,0,0,0,,Ваннаға түсуге қатысты
Dialogue: 0,0:21:09.47,0:21:12.68,Default,,0,0,0,,Әйел адамға қарағанда әлдеқайда қолайлы.
Dialogue: 0,0:21:13.39,0:21:16.65,Default,,0,0,0,,Олай болса... ішке кірейік.
Dialogue: 0,0:21:16.73,0:21:17.94,Default,,0,0,0,,Иә
Dialogue: 0,0:21:19.31,0:21:20.73,Default,,0,0,0,,Бұрынғы теледидарда
Dialogue: 0,0:21:20.82,0:21:22.78,Default,,0,0,0,,Мен саған жуынып кел дедім...
Dialogue: 0,0:21:22.86,0:21:25.70,Default,,0,0,0,,Сонымен... кезең-кезеңімен жасайық.
Dialogue: 0,0:21:26.32,0:21:27.95,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:21:29.32,0:21:31.20,Default,,0,0,0,,А, бұл қауіпті.
Dialogue: 0,0:21:31.28,0:21:33.62,Default,,0,0,0,,Такума-сама, не болды?
Dialogue: 0,0:21:33.70,0:21:35.21,Default,,0,0,0,,А... жоқ...
Dialogue: 0,0:21:36.00,0:21:37.21,Default,,0,0,0,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,0:21:37.79,0:21:39.46,Default,,0,0,0,,Мен 2 минутта қызып кеттім
Dialogue: 0,0:21:39.54,0:21:41.46,Default,,0,0,0,,- (Мина) Такума-сама - А?
Dialogue: 0,0:21:41.55,0:21:45.47,Default,,0,0,0,,Мынау... мынау! Үлпілдек бөлме киімі!
Dialogue: 0,0:21:46.55,0:21:49.01,Default,,0,0,0,,-Не болды? -(Мина) Менің ішім...
Dialogue: 0,0:21:49.09,0:21:50.60,Default,,0,0,0,,Не!? Сенімен бәрі жақсы ма?
Dialogue: 0,0:21:50.68,0:21:51.72,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:52.43,0:21:56.06,Default,,0,0,0,,Кешіріңіз, тоңазытқыш сәл ашылған сияқты.
Dialogue: 0,0:21:56.14,0:21:57.52,Default,,0,0,0,,Денеңіз жақсы ма?
Dialogue: 0,0:21:57.60,0:21:59.35,Default,,0,0,0,,Мәселе жоқ
Dialogue: 0,0:21:59.44,0:22:02.23,Default,,0,0,0,,Аа, жақсы.
Dialogue: 0,0:22:02.32,0:22:03.53,Default,,0,0,0,,Иә
