Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.41,0:00:04.33,Default,,0,0,0,,Дүкен сатушысын сомдаған комедиант өте крутой—
Dialogue: 0,0:00:04.42,0:00:06.71,Default,,0,0,0,,Шебер, тамақ әзірлеу және тазалау
Dialogue: 0,0:00:06.79,0:00:08.38,Default,,0,0,0,,Жуу аяқталды
Dialogue: 0,0:00:08.46,0:00:11.51,Default,,0,0,0,,...
Dialogue: 0,0:00:11.59,0:00:13.13,Default,,0,0,0,,Сіз кез келген нәрсені жасай аласыз
Dialogue: 0,0:00:13.22,0:00:16.85,Default,,0,0,0,,...
Dialogue: 0,0:00:16.93,0:00:20.89,Default,,0,0,0,,Онымен салыстырғанда сен... қабілетсізсің.
Dialogue: 0,0:00:22.48,0:00:24.89,Default,,0,0,0,,Мен оны сатып алмауым керек еді.
Dialogue: 0,0:00:24.98,0:00:26.52,Default,,0,0,0,,Уау!
Dialogue: 0,0:00:28.98,0:00:31.61,Default,,0,0,0,,...
Dialogue: 0,0:00:31.69,0:00:33.65,Default,,0,0,0,,Мен түс көргендей болдым...
Dialogue: 0,0:00:33.74,0:00:36.20,Default,,0,0,0,,Ішкі, ауқымды жады
Dialogue: 0,0:00:36.28,0:00:38.16,Default,,0,0,0,,Сонымен сұрыптау жұмысы болды.
Dialogue: 0,0:00:38.24,0:00:39.83,Default,,0,0,0,,Жад?
Dialogue: 0,0:00:39.91,0:00:42.83,Default,,0,0,0,,Өйткені Supermina ақпараттың үлкен көлемін өңдейді
Dialogue: 0,0:00:42.91,0:00:46.67,Default,,0,0,0,,...
Dialogue: 0,0:00:46.75,0:00:51.25,Default,,0,0,0,,Бұл процесс барысында сіздің санаңызда армандар пайда болуы мүмкін.
Dialogue: 0,0:00:51.34,0:00:55.68,Default,,0,0,0,,Сонда сол арман менің жадым ба?
Dialogue: 0,0:00:56.72,0:00:59.93,Default,,0,0,0,,Мен ондай шымыр адамды білмеймін.
Dialogue: 0,0:01:00.01,0:01:02.93,Default,,0,0,0,,Сквиш? Жеке ақпаратты қорғау үшін
Dialogue: 0,0:01:03.02,0:01:05.69,Default,,0,0,0,,...
Dialogue: 0,0:01:07.52,0:01:10.02,Default,,0,0,0,,Ол мені Ұстаз деп атады.
Dialogue: 0,0:01:10.11,0:01:14.44,Default,,0,0,0,,Бірақ бұл Лихт мырза емес деп ойлаймын.
Dialogue: 0,0:01:14.53,0:01:16.24,Default,,0,0,0,,Ол өзінің жеке заттарына және жазған жазбаларына от қойып, өзін-өзі өртеді
Dialogue: 0,0:01:16.32,0:01:19.45,Default,,0,0,0,,Сіз зарядтау және техникалық қызмет көрсету үшін менімен бірге боласыз.
Dialogue: 0,0:01:19.53,0:01:23.20,Default,,0,0,0,,...
Dialogue: 0,0:01:24.04,0:01:27.21,Default,,0,0,0,,Лихт мырзаның бұрынғы шебері болмауы керек.
Dialogue: 0,0:01:27.29,0:01:31.21,Default,,0,0,0,,Алдыңғы шебер… Алдыңғы…
Dialogue: 0,0:01:33.30,0:01:34.34,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:38.05,0:01:39.84,Default,,0,0,0,,...
Dialogue: 0,0:01:41.01,0:01:46.68,Default,,0,0,0,,♪～
Dialogue: 0,0:03:04.55,0:03:09.56,Default,,0,0,0,,～♪
Dialogue: 0,0:03:13.27,0:03:15.94,Default,,0,0,0,,Сіздің естеліктеріңіз араласып кетті ме?
Dialogue: 0,0:03:16.02,0:03:19.40,Default,,0,0,0,,...
Dialogue: 0,0:03:19.49,0:03:21.65,Default,,0,0,0,,Иә менің есімде
Dialogue: 0,0:03:21.74,0:03:25.70,Default,,0,0,0,,...
Dialogue: 0,0:03:25.78,0:03:27.45,Default,,0,0,0,,Бұл қалай болуы мүмкін...
Dialogue: 0,0:03:27.54,0:03:30.04,Default,,0,0,0,,...
Dialogue: 0,0:03:30.12,0:03:34.29,Default,,0,0,0,,…
Dialogue: 0,0:03:34.38,0:03:36.29,Default,,0,0,0,,...
Dialogue: 0,0:03:36.38,0:03:37.42,Default,,0,0,0,,Иә
Dialogue: 0,0:03:37.50,0:03:39.84,Default,,0,0,0,,...
Dialogue: 0,0:03:39.92,0:03:43.34,Default,,0,0,0,,!?
Dialogue: 0,0:03:43.43,0:03:45.51,Default,,0,0,0,,...
Dialogue: 0,0:03:45.60,0:03:48.64,Default,,0,0,0,,Бұл болмайды...
Dialogue: 0,0:03:51.35,0:03:54.98,Default,,0,0,0,,…
Dialogue: 0,0:03:55.06,0:03:56.98,Default,,0,0,0,,Мүмкін сол кезде...
Dialogue: 0,0:03:57.07,0:03:59.78,Default,,0,0,0,,...
Dialogue: 0,0:03:59.86,0:04:03.03,Default,,0,0,0,,Бұл маған көбірек көмектесті. Мәселе жоқ.
Dialogue: 0,0:04:03.11,0:04:04.11,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:04:04.20,0:04:05.78,Default,,0,0,0,,Мина Косуги
Dialogue: 0,0:04:05.87,0:04:09.62,Default,,0,0,0,,Естеліктерді араластырудан туындаған проблемалар бар ма?
Dialogue: 0,0:04:09.70,0:04:12.08,Default,,0,0,0,,Менің естеліктерім аралас емес.
Dialogue: 0,0:04:12.16,0:04:13.62,Default,,0,0,0,,Жарайды
Dialogue: 0,0:04:13.71,0:04:16.58,Default,,0,0,0,,Меніңше, біз білмейтін жағдайлар бар.
Dialogue: 0,0:04:16.67,0:04:18.63,Default,,0,0,0,,Маған растауға рұқсат етіңіз.
Dialogue: 0,0:04:18.71,0:04:20.17,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:04:20.88,0:04:23.01,Default,,0,0,0,,Сіздің иесінің аты кім?
Dialogue: 0,0:04:23.09,0:04:25.01,Default,,0,0,0,,Бұл Такухито Нишизоно Суги.
Dialogue: 0,0:04:25.09,0:04:27.68,Default,,0,0,0,,Араласады Араласады
Dialogue: 0,0:04:27.76,0:04:30.68,Default,,0,0,0,,Такума мырза, не араласады?
Dialogue: 0,0:04:30.77,0:04:34.02,Default,,0,0,0,,Хо... Қараңызшы, сіз жаңа ғана Такума дедіңіз.
Dialogue: 0,0:04:34.64,0:04:38.06,Default,,0,0,0,,Иесінің аты мен жады сәйкес емес, солай ма?
Dialogue: 0,0:04:40.15,0:04:42.90,Default,,0,0,0,,- (Мина) Бұл рас - Мина сынды ма?
Dialogue: 0,0:04:42.99,0:04:44.61,Default,,0,0,0,,Естеліктер аралас
Dialogue: 0,0:04:44.70,0:04:47.49,Default,,0,0,0,,Кімнің естеліктері бір-бірімен араласады?
Dialogue: 0,0:04:47.57,0:04:49.12,Default,,0,0,0,,Маған растау керек.
Dialogue: 0,0:04:49.20,0:04:51.12,Default,,0,0,0,,Келіңіздер, келісімдер жасайық
Dialogue: 0,0:04:51.20,0:04:52.54,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:04:52.62,0:04:54.50,Default,,0,0,0,,Өзіміз білмесек
Dialogue: 0,0:04:54.58,0:04:56.25,Default,,0,0,0,,Такума-саннан сұрайық
Dialogue: 0,0:04:56.33,0:04:57.75,Default,,0,0,0,,Иә, оны маған қалдырыңыз.
Dialogue: 0,0:04:58.33,0:04:59.88,Default,,0,0,0,,Олай болса, Такума мырза.
Dialogue: 0,0:04:59.96,0:05:02.01,Default,,0,0,0,,Ортаға отырыңыз
Dialogue: 0,0:05:02.09,0:05:03.13,Default,,0,0,0,,Иә
Dialogue: 0,0:05:03.21,0:05:04.76,Default,,0,0,0,,Бірден...
Dialogue: 0,0:05:04.84,0:05:05.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:06.01,0:05:09.18,Default,,0,0,0,,Такума-санның әйелі кім...
Dialogue: 0,0:05:09.26,0:05:11.68,Default,,0,0,0,,- Бұл (Супермина) болды ма? -Аа!?
Dialogue: 0,0:05:11.76,0:05:14.06,Default,,0,0,0,,Сайонжи мырзаның тегі басқа.
Dialogue: 0,0:05:14.14,0:05:15.73,Default,,0,0,0,,Бірге тұрмау
Dialogue: 0,0:05:15.81,0:05:16.81,Default,,0,0,0,,Иә
Dialogue: 0,0:05:17.52,0:05:19.81,Default,,0,0,0,,Олар тек жанама дәлелдер
Dialogue: 0,0:05:19.90,0:05:22.98,Default,,0,0,0,,Менің сенің әйелің болу мүмкіндігім нөлге тең емес пе?
Dialogue: 0,0:05:23.07,0:05:24.15,Default,,0,0,0,,Өте жақын!
Dialogue: 0,0:05:24.24,0:05:26.70,Default,,0,0,0,,Косуги! Менің әйелім Косугиден!
Dialogue: 0,0:05:32.29,0:05:33.58,Default,,0,0,0,,Қандай әдемі бауырлық байланыс! Қалай әсерлі.
Dialogue: 0,0:05:34.62,0:05:36.58,Default,,0,0,0,,Уау...
Dialogue: 0,0:05:36.66,0:05:38.42,Default,,0,0,0,,Осылайша олар бір-біріне жабысады
Dialogue: 0,0:05:38.50,0:05:40.79,Default,,0,0,0,,Бұл Мина Косуги ме?
Dialogue: 0,0:05:40.88,0:05:42.00,Default,,0,0,0,,Ей!
Dialogue: 0,0:05:43.55,0:05:45.51,Default,,0,0,0,,- (Мина) Сайонджи-сан - Ай...
Dialogue: 0,0:05:45.59,0:05:47.84,Default,,0,0,0,,Иелерінен басқа адамдармен жабысатын роботтар
Dialogue: 0,0:05:47.93,0:05:49.93,Default,,0,0,0,,Көп емес сияқты
Dialogue: 0,0:05:50.01,0:05:51.64,Default,,0,0,0,,Маюри үшін сол сәт келгенде қасында болғым келеді… яғни…
Dialogue: 0,0:05:53.93,0:05:55.73,Default,,0,0,0,,Терісі адамдарға арналған
Dialogue: 0,0:05:55.81,0:05:57.56,Default,,0,0,0,,Бұл сезімтал әрекет.
Dialogue: 0,0:05:57.64,0:06:00.65,Default,,0,0,0,,Түсінікті болғанша орындамау керек
Dialogue: 0,0:06:00.73,0:06:02.69,Default,,0,0,0,,Мен мұны түсінемін, бірақ...
Dialogue: 0,0:06:03.57,0:06:04.69,Default,,0,0,0,,Мен жай ғана...
Dialogue: 0,0:06:04.78,0:06:06.74,Default,,0,0,0,,Мен бірге болғым келеді!
Dialogue: 0,0:06:06.82,0:06:08.45,Default,,0,0,0,,Толық қуат!
Dialogue: 0,0:06:09.16,0:06:11.45,Default,,0,0,0,,Сайонжи мырза, сабыр етіңіз...
Dialogue: 0,0:06:11.53,0:06:14.45,Default,,0,0,0,,Бұл керемет күш. мен өлемін...
Dialogue: 0,0:06:14.54,0:06:19.00,Default,,0,0,0,,Ух... уф... хаха...
Dialogue: 0,0:06:20.50,0:06:21.58,Default,,0,0,0,,Гухаа
Dialogue: 0,0:06:21.67,0:06:23.59,Default,,0,0,0,,Ai~
Dialogue: 0,0:06:24.42,0:06:27.09,Default,,0,0,0,,Мина...чан? Уау
Dialogue: 0,0:06:29.93,0:06:32.22,Default,,0,0,0,,Гуаааааааааааааааааааааааааааааааааа...
Dialogue: 0,0:06:33.43,0:06:34.72,Default,,0,0,0,,Сайонжи мырза
Dialogue: 0,0:06:35.47,0:06:37.68,Default,,0,0,0,,Бар күшіммен жабысып қалуға ұмтылу
Dialogue: 0,0:06:37.77,0:06:40.56,Default,,0,0,0,,Өз қалауларыңызға тереңірек қараңыз
Dialogue: 0,0:06:40.65,0:06:41.85,Default,,0,0,0,,Артқа?
Dialogue: 0,0:06:42.86,0:06:45.48,Default,,0,0,0,,Такума-самамен не істегіңіз келеді?
Dialogue: 0,0:06:51.82,0:06:53.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:53.95,0:06:57.62,Default,,0,0,0,,Басқаларды жақсы көріңіз және сүйікті болыңыз.
Dialogue: 0,0:06:58.20,0:07:01.12,Default,,0,0,0,,Жарайды... Ах.
Dialogue: 0,0:07:05.00,0:07:09.51,Default,,0,0,0,,Ha~ Gehogehogehogehogeho...
Dialogue: 0,0:07:09.59,0:07:12.51,Default,,0,0,0,,Жақсысың ба, Такума-сама?
Dialogue: 0,0:07:12.59,0:07:15.10,Default,,0,0,0,,- Гехо ха ха... - Такума жақсысың ба?
Dialogue: 0,0:07:15.18,0:07:18.89,Default,,0,0,0,,Ух... Иә, бәрібір...
Dialogue: 0,0:07:18.98,0:07:21.44,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:07:21.52,0:07:24.15,Default,,0,0,0,,Сайонжи мырзаның жағдайы жақсы ма?
Dialogue: 0,0:07:26.23,0:07:29.15,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:07:35.49,0:07:37.91,Default,,0,0,0,,Мен шынымен кешірім сұраймын
Dialogue: 0,0:07:37.99,0:07:41.33,Default,,0,0,0,,Жарайды, мен сәл таң қалдым.
Dialogue: 0,0:07:41.41,0:07:44.04,Default,,0,0,0,,Әдеттегідей проблема жоқ.
Dialogue: 0,0:07:44.13,0:07:45.42,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:07:45.50,0:07:49.17,Default,,0,0,0,,Мина-сан мені тоқтатпаса, бәрі қорқынышты болар еді...
Dialogue: 0,0:07:49.26,0:07:50.76,Default,,0,0,0,,Қазір бәрі жақсы.
Dialogue: 0,0:07:50.84,0:07:54.51,Default,,0,0,0,,Ей, бірге болуды қалайтын терең тілек деген не?
Dialogue: 0,0:07:54.59,0:07:56.80,Default,,0,0,0,,- (Супермина) А... - Иә?
Dialogue: 0,0:07:58.26,0:08:00.68,Default,,0,0,0,,Естеліктерді екі адам татуласады.
Dialogue: 0,0:08:00.77,0:08:04.23,Default,,0,0,0,,Такума-сама, алдымен Маморумен үйге қайт.
Dialogue: 0,0:08:04.31,0:08:06.31,Default,,0,0,0,,Иә?Бірақ...
Dialogue: 0,0:08:06.40,0:08:09.19,Default,,0,0,0,,Түсінбегенімді кейін тексеремін.
Dialogue: 0,0:08:09.28,0:08:10.99,Default,,0,0,0,,Алдымен үйге қайтыңыз.
Dialogue: 0,0:08:11.07,0:08:12.07,Default,,0,0,0,,Иә...
Dialogue: 0,0:08:12.99,0:08:15.82,Default,,0,0,0,,Мамору-кун, кітап дүкеніне барғың келе ме?
Dialogue: 0,0:08:15.91,0:08:17.83,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:08:23.83,0:08:24.83,Default,,0,0,0,,Мина?
Dialogue: 0,0:08:28.63,0:08:31.84,Default,,0,0,0,,Мина, сен білесің...
Dialogue: 0,0:08:32.67,0:08:35.59,Default,,0,0,0,,Неліктен... олар бір-біріне жабысады?
Dialogue: 0,0:08:36.30,0:08:38.60,Default,,0,0,0,,- (Супермина) Мастер - Не?
Dialogue: 0,0:08:38.68,0:08:40.60,Default,,0,0,0,,Ауырмайды ма?
Dialogue: 0,0:08:40.68,0:08:42.48,Default,,0,0,0,,- Иә - (Супермина) Мүлде емес пе?
Dialogue: 0,0:08:42.56,0:08:44.35,Default,,0,0,0,,Ауырмайды ма?
Dialogue: 0,0:08:44.94,0:08:46.35,Default,,0,0,0,,Ах
Dialogue: 0,0:08:47.19,0:08:48.56,Default,,0,0,0,,Эхехе…
Dialogue: 0,0:08:49.44,0:08:50.86,Default,,0,0,0,,(Мысықтың есінеу)
Dialogue: 0,0:08:54.03,0:08:56.70,Default,,0,0,0,,О, мен көгеріп кеттім.
Dialogue: 0,0:08:56.78,0:08:58.24,Default,,0,0,0,,Көгеру ~
Dialogue: 0,0:08:58.91,0:09:02.41,Default,,0,0,0,,Супер Минаның күші менікінен үш еседей.
Dialogue: 0,0:09:02.50,0:09:03.58,Default,,0,0,0,,Соншама!?
Dialogue: 0,0:09:03.66,0:09:05.25,Default,,0,0,0,,Егер мен байыпты болсам...
Dialogue: 0,0:09:07.12,0:09:09.75,Default,,0,0,0,,Такума-саманы жыртып тастауға болады.
Dialogue: 0,0:09:09.84,0:09:12.13,Default,,0,0,0,,Мина сериясы Тым күшті емес пе?
Dialogue: 0,0:09:12.21,0:09:13.38,Default,,0,0,0,,Бұл таңқаларлық па?
Dialogue: 0,0:09:13.46,0:09:14.88,Default,,0,0,0,,Ғажайып таңғажайып
Dialogue: 0,0:09:15.59,0:09:17.13,Default,,0,0,0,,Оның сонша күші болса да
Dialogue: 0,0:09:17.22,0:09:19.55,Default,,0,0,0,,Бір қызығы, оны жұлып алудың қажеті жоқ.
Dialogue: 0,0:09:19.64,0:09:21.76,Default,,0,0,0,,-(Мина) Дұрыс -Хаха...
Dialogue: 0,0:09:25.60,0:09:27.27,Default,,0,0,0,,Fe~
Dialogue: 0,0:09:29.27,0:09:31.15,Default,,0,0,0,,Мен де тұрамын.
Dialogue: 0,0:09:31.23,0:09:32.82,Default,,0,0,0,,Мәселе жоқ
Dialogue: 0,0:09:32.90,0:09:34.78,Default,,0,0,0,,- Такума! -иә?
Dialogue: 0,0:09:34.86,0:09:37.74,Default,,0,0,0,,Мина, бұзба, абай бол!
Dialogue: 0,0:09:37.82,0:09:40.03,Default,,0,0,0,,Хехе... Жарайды.
Dialogue: 0,0:09:40.12,0:09:43.29,Default,,0,0,0,,Адамдардың роботтарды сындыруға күші жетпейді.
Dialogue: 0,0:09:44.50,0:09:46.04,Default,,0,0,0,,Адамдар ұлы емес
Dialogue: 0,0:09:46.62,0:09:47.79,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:09:47.87,0:09:50.04,Default,,0,0,0,,-Такума -Бұл не?
Dialogue: 0,0:09:50.13,0:09:52.42,Default,,0,0,0,,Неліктен бір-біріне жабысу сізді жақсы сезінеді?
Dialogue: 0,0:09:52.50,0:09:55.76,Default,,0,0,0,,Не? Бұл... аа~
Dialogue: 0,0:09:55.84,0:09:58.47,Default,,0,0,0,,Адамдар өзіне жақын болғысы келетін адаммен бірге болғанда,
Dialogue: 0,0:09:58.55,0:10:01.55,Default,,0,0,0,,Окситоцин деп аталатын гормон бөледі
Dialogue: 0,0:10:01.64,0:10:02.85,Default,,0,0,0,,Окишии…?
Dialogue: 0,0:10:02.93,0:10:06.77,Default,,0,0,0,,Окситоцин бөлінсе, бақыт сезімі артады.
Dialogue: 0,0:10:06.85,0:10:09.31,Default,,0,0,0,,Бұл сізді стресске төзімді етеді.
Dialogue: 0,0:10:09.40,0:10:11.81,Default,,0,0,0,,Такума күшейе түсті
Dialogue: 0,0:10:11.90,0:10:15.11,Default,,0,0,0,,Менде Такума-самаға қуат беретін қабілетім бар.
Dialogue: 0,0:10:15.19,0:10:17.24,Default,,0,0,0,,Бұл санаулы ұшақтардың бірі деуге болады.
Dialogue: 0,0:10:18.57,0:10:20.45,Default,,0,0,0,,Тек Мина Чан
Dialogue: 0,0:10:20.53,0:10:23.49,Default,,0,0,0,,Иә, дүниеде жалғыз мен едім
Dialogue: 0,0:10:23.58,0:10:24.87,Default,,0,0,0,,Бұл таңқаларлық па?
Dialogue: 0,0:10:24.95,0:10:26.33,Default,,0,0,0,,Иә, бұл таңқаларлық.
Dialogue: 0,0:10:27.25,0:10:30.25,Default,,0,0,0,,- (Мина) Мен сауаттымын ба? -Иә
Dialogue: 0,0:10:30.33,0:10:32.08,Default,,0,0,0,,Мені сатып алғаныңызға қуаныштысыз ба?
Dialogue: 0,0:10:33.00,0:10:34.09,Default,,0,0,0,,Жарайды, бірде бірге шай ішуге баруымыз керек қой?
Dialogue: 0,0:10:38.17,0:10:42.09,Default,,0,0,0,,Мина Чанмен танысқаныма өте қуанышты болдым.
Dialogue: 0,0:10:46.14,0:10:48.43,Default,,0,0,0,,Бұл бәрінен бұрын
Dialogue: 0,0:10:54.57,0:10:58.15,Default,,0,0,0,,(Смартфон қоңырау үні)
Dialogue: 0,0:10:58.24,0:11:02.62,Default,,0,0,0,,Сәлем... иә? Супер Мина?
Dialogue: 0,0:11:06.54,0:11:08.08,Default,,0,0,0,,Мен кенеттен кешірім сұраймын.
Dialogue: 0,0:11:08.16,0:11:09.46,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:11:09.96,0:11:12.00,Default,,0,0,0,,Мина Косугиді еске алу
Dialogue: 0,0:11:12.08,0:11:14.59,Default,,0,0,0,,Менде Такума мырзаның ұялы нөмірі бар еді.
Dialogue: 0,0:11:14.67,0:11:16.17,Default,,0,0,0,,Тікелей шақырылады
Dialogue: 0,0:11:16.25,0:11:20.63,Default,,0,0,0,,Қарсы емеспін, бірақ... тек менімен сөйлескіңіз келетін нәрсе бар ма?
Dialogue: 0,0:11:20.72,0:11:22.64,Default,,0,0,0,,Мина Косугидің...
Dialogue: 0,0:11:22.72,0:11:25.10,Default,,0,0,0,,Алдыңғы иесі
Dialogue: 0,0:11:25.18,0:11:27.35,Default,,0,0,0,,Не? Мина Чанның...
Dialogue: 0,0:11:27.43,0:11:30.10,Default,,0,0,0,,Негізі естеліктер араласқанда
Dialogue: 0,0:11:30.18,0:11:33.19,Default,,0,0,0,,Мина Косугидің бұрынғы иесімен естеліктері
Dialogue: 0,0:11:33.27,0:11:35.02,Default,,0,0,0,,Ол арман болып қайта жасалды.
Dialogue: 0,0:11:35.11,0:11:36.11,Default,,0,0,0,,Қуа келе жатқандар кетті.
Dialogue: 0,0:11:37.07,0:11:39.36,Default,,0,0,0,,Мазмұны тым көп...
Dialogue: 0,0:11:39.44,0:11:41.90,Default,,0,0,0,,Мен енді шыдай алмаймын...
Dialogue: 0,0:11:41.99,0:11:45.12,Default,,0,0,0,,Көп емес пе? Сізге қорқынышты нәрсе жасалды ма?
Dialogue: 0,0:11:45.20,0:11:48.12,Default,,0,0,0,,Бір сөз: мен шағымданайын деп ойладым.
Dialogue: 0,0:11:48.20,0:11:52.96,Default,,0,0,0,,Қалған естеліктерді жинақтап, сол адамға бардым.
Dialogue: 0,0:11:53.04,0:11:55.08,Default,,0,0,0,,Қырағы шошқа, бұл сенің тамағың ғой…
Dialogue: 0,0:11:55.84,0:11:57.63,Default,,0,0,0,,Бұл жақсы емес, солай ма?
Dialogue: 0,0:11:57.71,0:12:00.97,Default,,0,0,0,,О, жоқ... меншік құқығынан бас тартқан адамға қатысты.
Dialogue: 0,0:12:01.05,0:12:04.64,Default,,0,0,0,,Жеке ақпарат... қорғалған.
Dialogue: 0,0:12:04.72,0:12:08.43,Default,,0,0,0,,Мүмкін мен Мина Косуги емеспін.
Dialogue: 0,0:12:08.51,0:12:10.98,Default,,0,0,0,,Менің ойымша, қорғаныс күшейді.
Dialogue: 0,0:12:11.06,0:12:12.85,Default,,0,0,0,,Түсіндім... сонда?
Dialogue: 0,0:12:13.56,0:12:16.81,Default,,0,0,0,,Бұрынғы иесінің аты Томиказу Отани.
Dialogue: 0,0:12:16.90,0:12:18.77,Default,,0,0,0,,Меншікке ие болған кезде 21 жаста
Dialogue: 0,0:12:18.86,0:12:20.69,Default,,0,0,0,,Мамандығы – бағдарламашы
Dialogue: 0,0:12:20.78,0:12:23.49,Default,,0,0,0,,Ол пәтерде жалғыз тұратын.
Dialogue: 0,0:12:23.57,0:12:26.87,Default,,0,0,0,,Сонымен... біз кездескен кездегі жағдай қалай болды?
Dialogue: 0,0:12:30.16,0:12:32.12,Default,,0,0,0,,Ол болған жоқ.
Dialogue: 0,0:12:33.08,0:12:35.00,Default,,0,0,0,,- дейін? -(Супермина) Ондай адамдар...
Dialogue: 0,0:12:35.75,0:12:37.71,Default,,0,0,0,,Ол болған жоқ.
Dialogue: 0,0:12:40.38,0:12:41.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:47.47,0:12:50.01,Default,,0,0,0,,-A~I~I... -Ой
Dialogue: 0,0:12:50.10,0:12:51.89,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:51.97,0:12:53.81,Default,,0,0,0,,О, күшті, күшті
Dialogue: 0,0:12:53.89,0:12:55.14,Default,,0,0,0,,Керемет?
Dialogue: 0,0:12:55.23,0:12:56.65,Default,,0,0,0,,Ғажайып таңғажайып
Dialogue: 0,0:12:56.73,0:12:58.23,Default,,0,0,0,,Aii~!
Dialogue: 0,0:12:58.31,0:13:00.65,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:13:00.73,0:13:02.99,Default,,0,0,0,,(пышақ ою дыбысы)
Dialogue: 0,0:13:03.07,0:13:06.24,Default,,0,0,0,,Уау... керемет...
Dialogue: 0,0:13:06.32,0:13:10.24,Default,,0,0,0,,Мина-чанның бұрынғы иесі Отани...
Dialogue: 0,0:13:11.24,0:13:14.83,Default,,0,0,0,,Ондай адам болған жоқ.
Dialogue: 0,0:13:17.00,0:13:19.67,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:13:19.75,0:13:23.76,Default,,0,0,0,,Болмаған адам туралы естелік болуы мүмкін емес.
Dialogue: 0,0:13:23.84,0:13:26.43,Default,,0,0,0,,Минаның қиялдағы адамы?
Dialogue: 0,0:13:26.51,0:13:29.01,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:13:29.09,0:13:31.43,Default,,0,0,0,,Есім жалған болды ма?
Dialogue: 0,0:13:31.51,0:13:33.02,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:33.10,0:13:34.93,Default,,0,0,0,,Ай!
Dialogue: 0,0:13:37.65,0:13:39.56,Default,,0,0,0,,Такума Такума!
Dialogue: 0,0:13:39.65,0:13:41.02,Default,,0,0,0,,О...
Dialogue: 0,0:13:41.11,0:13:43.48,Default,,0,0,0,,«WashiWashi» WashiWashi жасаңыз!
Dialogue: 0,0:13:43.57,0:13:45.65,Default,,0,0,0,,Иә, түсінемін.
Dialogue: 0,0:13:46.32,0:13:48.70,Default,,0,0,0,,Қараңызшы, мен...
Dialogue: 0,0:13:48.78,0:13:49.91,Default,,0,0,0,,Мен...
Dialogue: 0,0:13:49.99,0:13:52.08,Default,,0,0,0,,Ихихи~
Dialogue: 0,0:13:57.87,0:14:00.58,Default,,0,0,0,,Әйеліңнің өткеніне үңілу жақсы емес.
Dialogue: 0,0:14:00.67,0:14:03.13,Default,,0,0,0,,Мамору-кун да қазір осында.
Dialogue: 0,0:14:03.21,0:14:05.59,Default,,0,0,0,,Такума көбірек~
Dialogue: 0,0:14:07.30,0:14:08.97,Default,,0,0,0,,Мина Жоқ!
Dialogue: 0,0:14:09.05,0:14:11.47,Default,,0,0,0,,Қызуыңыз көтеріліп тұр, жатыңыз!
Dialogue: 0,0:14:11.55,0:14:13.72,Default,,0,0,0,,Бірақ менің денсаулығымда ешқандай проблема жоқ.
Dialogue: 0,0:14:13.81,0:14:15.85,Default,,0,0,0,,Тек мені тыңда!
Dialogue: 0,0:14:15.93,0:14:16.98,Default,,0,0,0,,Иә
Dialogue: 0,0:14:17.06,0:14:19.40,Default,,0,0,0,,Мен мысықтарға қамқор боламын.
Dialogue: 0,0:14:19.48,0:14:22.02,Default,,0,0,0,,Егер мәселе туындаса, маған дереу хабарлаңыз.
Dialogue: 0,0:14:22.11,0:14:23.32,Default,,0,0,0,,Иә
Dialogue: 0,0:14:23.98,0:14:27.03,Default,,0,0,0,,Фондағы Мина Косуги туралы естеліктер мәңгі
Dialogue: 0,0:14:27.11,0:14:31.53,Default,,0,0,0,,Талдау процесі жылуды тудырады.
Dialogue: 0,0:14:31.62,0:14:34.03,Default,,0,0,0,,Олай етпеген дұрыс.
Dialogue: 0,0:14:34.12,0:14:36.70,Default,,0,0,0,,Маған қызық.
Dialogue: 0,0:14:34.12,0:14:36.70,Default,,0,0,0,,(мысықтар мияулау)
Dialogue: 0,0:14:38.00,0:14:40.29,Default,,0,0,0,,-Ваши ВашиВаши... -Ихихи Ихихи...
Dialogue: 0,0:14:40.37,0:14:42.75,Default,,0,0,0,,-Ваши Ваши Washi... -Толығырақ!
Dialogue: 0,0:14:42.84,0:14:44.00,Default,,0,0,0,,Егер ішіне әдемі қызбен бірге мінгенімде ғой.
Dialogue: 0,0:14:44.09,0:14:45.34,Default,,0,0,0,,Мина Косуги
Dialogue: 0,0:14:45.42,0:14:47.59,Default,,0,0,0,,Сәлеметсіз бе Сайонжи мырза
Dialogue: 0,0:14:47.67,0:14:49.01,Default,,0,0,0,,Кенеттен кешіріңіз
Dialogue: 0,0:14:49.09,0:14:51.76,Default,,0,0,0,,Мәселе жоқ. Сізге бірдеңе керек пе?
Dialogue: 0,0:14:51.84,0:14:54.14,Default,,0,0,0,,Негізі мен бір нәрсе туралы ойланғым келеді.
Dialogue: 0,0:14:54.22,0:14:56.43,Default,,0,0,0,,Мен Косуги мырзаның миын алғым келеді.
Dialogue: 0,0:14:56.52,0:14:58.64,Default,,0,0,0,,Менің миым Сайонджи мырза сияқты үлкен.
Dialogue: 0,0:14:58.73,0:15:01.90,Default,,0,0,0,,Менде өңдеу күші жоқ, бірақ бұл жақсы болса.
Dialogue: 0,0:15:01.98,0:15:03.69,Default,,0,0,0,,Рахмет
Dialogue: 0,0:15:05.02,0:15:07.11,Default,,0,0,0,,Тура Минаның басына бару
Dialogue: 0,0:15:07.19,0:15:08.94,Default,,0,0,0,,Естеліктерімізге көз жүгіртейік
Dialogue: 0,0:15:09.03,0:15:10.82,Default,,0,0,0,,Мен үшінші тарап болсам
Dialogue: 0,0:15:10.90,0:15:13.45,Default,,0,0,0,,Жадты қорғауды айналып өту мүмкіндігі болуы керек
Dialogue: 0,0:15:14.07,0:15:16.95,Default,,0,0,0,,(Мысық есінейді)
Dialogue: 0,0:15:18.00,0:15:20.54,Default,,0,0,0,,Такума-сама біраз ұйықтайды.
Dialogue: 0,0:15:20.62,0:15:22.46,Default,,0,0,0,,Жарайды, қайырлы түн.
Dialogue: 0,0:15:22.54,0:15:24.50,Default,,0,0,0,,Қайырлы түн
Dialogue: 0,0:15:24.59,0:15:27.46,Default,,0,0,0,,Сайонджи мырза 10 секундтан кейін ұйықтайды.
Dialogue: 0,0:15:27.55,0:15:28.92,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:15:39.02,0:15:40.18,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:41.60,0:15:45.27,Default,,0,0,0,,Бұл сақтау орны ... дегенді білдіреді.
Dialogue: 0,0:15:45.77,0:15:47.32,Default,,0,0,0,,кең
Dialogue: 0,0:15:50.40,0:15:53.57,Default,,0,0,0,,Ол Mina сериясында орнатылмауы керек еді.
Dialogue: 0,0:15:53.66,0:15:57.16,Default,,0,0,0,,Сақтаудың өте үлкен стандарты қолданылып жатқан сияқты.
Dialogue: 0,0:15:58.04,0:16:00.62,Default,,0,0,0,,Жаңарту арқылы таңдауға болатын сыйымдылықтан
Dialogue: 0,0:16:00.70,0:16:02.41,Default,,0,0,0,,әлдеқайда үлкен
Dialogue: 0,0:16:02.50,0:16:05.92,Default,,0,0,0,,Мүмкін Мина өзгертілген өнім шығар?
Dialogue: 0,0:16:06.59,0:16:10.84,Default,,0,0,0,,Менің ең ескі естелігім...
Dialogue: 0,0:16:13.01,0:16:15.93,Default,,0,0,0,,Одан асқан естелік жоқ сияқты.
Dialogue: 0,0:16:21.85,0:16:25.10,Default,,0,0,0,,Отани мырза, сіз осындай арзан нұсқаға жарайсыз ба?
Dialogue: 0,0:16:25.19,0:16:26.90,Default,,0,0,0,,Тез арада суперминаны дайындаңыз...
Dialogue: 0,0:16:26.98,0:16:28.15,Default,,0,0,0,,Жарайды
Dialogue: 0,0:16:28.23,0:16:30.94,Default,,0,0,0,,Негізгі бағдарламаларды әзірлеуге толық мүмкіндігім бар.
Dialogue: 0,0:16:31.03,0:16:33.65,Default,,0,0,0,,Сонымен қатар, мен роботтарды жақсы көремін.
Dialogue: 0,0:16:33.74,0:16:35.45,Default,,0,0,0,,Егер байыпты болсаң жаман болар еді.
Dialogue: 0,0:16:35.53,0:16:37.53,Default,,0,0,0,,- (Айкава) Ахахха... - (Отани) Ах!
Dialogue: 0,0:16:39.66,0:16:40.87,Default,,0,0,0,,Сіз ояндыңыз ба?
Dialogue: 0,0:16:41.66,0:16:43.29,Default,,0,0,0,,Сәлем
Dialogue: 0,0:16:43.37,0:16:46.92,Default,,0,0,0,,Танысқаныма қуаныштымын. Сіз менің қожайынымсыз ба?
Dialogue: 0,0:16:47.00,0:16:48.46,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:16:54.47,0:16:56.30,Default,,0,0,0,,Роботқа ұқсайды
Dialogue: 0,0:16:56.39,0:16:58.39,Default,,0,0,0,,Тек оң қол механикалық.
Dialogue: 0,0:16:58.47,0:17:01.81,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:17:01.89,0:17:04.23,Default,,0,0,0,,Сіз әлі... аяқталмағансыз.
Dialogue: 0,0:17:05.02,0:17:08.27,Default,,0,0,0,,Бұдан былай мен сені керемет робот жасаймын.
Dialogue: 0,0:17:08.36,0:17:10.11,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:17:11.02,0:17:13.90,Default,,0,0,0,,Бұл адам робот жасаушы...
Dialogue: 0,0:17:14.53,0:17:17.20,Default,,0,0,0,,Мина прототипі болды.
Dialogue: 0,0:17:19.49,0:17:22.29,Default,,0,0,0,,Алдағы естеліктерге...
Dialogue: 0,0:17:25.25,0:17:28.46,Default,,0,0,0,,Минаның барлық түрлерінің ортақ негізгі бағдарламасы бар
Dialogue: 0,0:17:28.54,0:17:32.38,Default,,0,0,0,,Мен бұлай егжей-тегжейлі жасаудың қажеті жоқ деп ойлаймын.
Dialogue: 0,0:17:32.46,0:17:35.13,Default,,0,0,0,,Бұл аспаздық ыдыс, солай ма?
Dialogue: 0,0:17:35.22,0:17:38.55,Default,,0,0,0,,Қолданыстағы Мина сериясын адамға ұқсатсаңыз да
Dialogue: 0,0:17:38.64,0:17:41.14,Default,,0,0,0,,Бұл қымбатырақ емес пе?
Dialogue: 0,0:17:41.22,0:17:44.39,Default,,0,0,0,,Құрал құралға ұқсайды...
Dialogue: 0,0:17:45.31,0:17:48.77,Default,,0,0,0,,Бұл тамақ пісірудің өзі жеткіліксіз дегенді білдіре ме?
Dialogue: 0,0:17:51.15,0:17:53.73,Default,,0,0,0,,Динамикті іске қосыңыз
Dialogue: 0,0:17:54.49,0:17:56.65,Default,,0,0,0,,Сізге сұрақ қоюға рұқсат етіңіз.
Dialogue: 0,0:18:00.20,0:18:03.16,Default,,0,0,0,,Айкава Адам пішінді робот
Dialogue: 0,0:18:03.91,0:18:06.66,Default,,0,0,0,,Оның құрал ретіндегі рөлі туралы ойлануларыңызды қалаймын.
Dialogue: 0,0:18:06.75,0:18:09.29,Default,,0,0,0,,Құрал ретіндегі рөл?
Dialogue: 0,0:18:09.37,0:18:13.42,Default,,0,0,0,,Бұл бала иесі үшін роботтан артық нәрсеге айналғанда.
Dialogue: 0,0:18:13.50,0:18:16.13,Default,,0,0,0,,Бұл роботтан артық нәрсе сияқты
Dialogue: 0,0:18:16.22,0:18:18.18,Default,,0,0,0,,Өзін ұстай білу маңызды
Dialogue: 0,0:18:19.05,0:18:22.39,Default,,0,0,0,,Махаббатты алған кезде, махаббат сияқты нәрсені қайтарыңыз
Dialogue: 0,0:18:22.47,0:18:23.93,Default,,0,0,0,,Сөйтіп жүргенде мына бала
Dialogue: 0,0:18:24.01,0:18:27.18,Default,,0,0,0,,Сіз бұрынғыдан да таптырмас боласыз.
Dialogue: 0,0:18:27.27,0:18:29.14,Default,,0,0,0,,Осындай бірдеңе...
Dialogue: 0,0:18:29.23,0:18:31.86,Default,,0,0,0,,Бір тамаша оқиға орын алса, бірге бақытты болайық.
Dialogue: 0,0:18:31.94,0:18:33.90,Default,,0,0,0,,Жалғыз болып, жылап жатсам, құшақтап ал...
Dialogue: 0,0:18:33.98,0:18:36.90,Default,,0,0,0,,Егер сіз бірдеңе жасауға тырыссаңыз, оны тоқтатыңыз.
Dialogue: 0,0:18:38.07,0:18:40.78,Default,,0,0,0,,Үй жұмысын орындауға арналған құрал ретінде
Dialogue: 0,0:18:40.86,0:18:44.95,Default,,0,0,0,,Сондай-ақ бұл шеберді қоғамшыл тұлға болуға бағыттайтын құрал.
Dialogue: 0,0:18:46.91,0:18:48.91,Default,,0,0,0,,Құралдардың міндеті бар
Dialogue: 0,0:18:49.00,0:18:52.71,Default,,0,0,0,,Бұл туралы қалай ойлайтыныңызға байланысты, ол адамдардан әлдеқайда қымбат.
Dialogue: 0,0:18:52.79,0:18:53.84,Default,,0,0,0,,Сонымен
Dialogue: 0,0:18:53.92,0:18:57.42,Default,,0,0,0,,Сіз ұқыпсыз бағдарламаны құра алмайсыз.
Dialogue: 0,0:18:58.63,0:19:00.43,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:19:00.51,0:19:03.39,Default,,0,0,0,,Мұны қалай жасау керектігін айтыңызшы.
Dialogue: 0,0:19:03.47,0:19:05.43,Default,,0,0,0,,Мен тырысатыныма сенімдімін.
Dialogue: 0,0:19:05.51,0:19:07.18,Default,,0,0,0,,Лорд Охтани осылай айтса...
Dialogue: 0,0:19:08.14,0:19:10.85,Default,,0,0,0,,Менде мұндай қабілет бар екеніне сенімдімін.
Dialogue: 0,0:19:19.19,0:19:22.99,Default,,0,0,0,,Отани-сама физикалық тұрғыдан дұрыс жұмыс істемейді ме?
Dialogue: 0,0:19:23.07,0:19:26.12,Default,,0,0,0,,Иә... Мен ұзақ өмір сүре алмаймын.
Dialogue: 0,0:19:26.20,0:19:28.75,Default,,0,0,0,,Ақаулы бөлшектерді ауыстыруды ұсыну
Dialogue: 0,0:19:28.83,0:19:32.58,Default,,0,0,0,,Егер менің денем қолдана алатын нәрсе болса, оны қолданыңыз.
Dialogue: 0,0:19:32.67,0:19:33.96,Default,,0,0,0,,Рахмет
Dialogue: 0,0:19:34.04,0:19:36.92,Default,,0,0,0,,Адамдар роботтарға қарағанда әлдеқайда нәзік.
Dialogue: 0,0:19:37.00,0:19:39.84,Default,,0,0,0,,Ауыстыруға болмайтын бөлшектер көп.
Dialogue: 0,0:19:39.92,0:19:40.97,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:19:41.05,0:19:43.72,Default,,0,0,0,,Мен сынық болсам, сен
Dialogue: 0,0:19:44.30,0:19:46.81,Default,,0,0,0,,Ол басқа біреуге беріледі
Dialogue: 0,0:19:46.89,0:19:50.48,Default,,0,0,0,,Мүмкін менің қол астындағы Айкава немесе менің ата-анам.
Dialogue: 0,0:19:50.56,0:19:52.06,Default,,0,0,0,,Сен қайсысысың...
Dialogue: 0,0:19:52.14,0:19:53.31,Default,,0,0,0,,Сол жігіт… айнада
Dialogue: 0,0:19:54.06,0:19:55.73,Default,,0,0,0,,Егер ол сынықтарға айналса...
Dialogue: 0,0:19:56.61,0:19:57.65,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:20:02.32,0:20:03.61,Default,,0,0,0,,(Еденге құлаған дыбыс)
Dialogue: 0,0:20:03.70,0:20:04.91,Default,,0,0,0,,Мина!
Dialogue: 0,0:20:04.99,0:20:07.87,Default,,0,0,0,,Суасты кемесі ме?
Dialogue: 0,0:20:08.95,0:20:10.16,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:20:10.25,0:20:13.17,Default,,0,0,0,,Мен қазір жад деректерін қайта жазамын.
Dialogue: 0,0:20:16.71,0:20:18.13,Default,,0,0,0,,Жарайды, бірде бірге шай ішуге баруымыз керек қой?
Dialogue: 0,0:20:18.21,0:20:21.67,Default,,0,0,0,,Сізді тастап кеткен күйеуіңіз сұмдық адам.
Dialogue: 0,0:20:21.76,0:20:25.43,Default,,0,0,0,,Сонымен... бұл туралы ұмытуға болады.
Dialogue: 0,0:20:26.14,0:20:27.26,Default,,0,0,0,,Келісесің бе?
Dialogue: 0,0:20:27.35,0:20:28.43,Default,,0,0,0,,Құрметті Отани
Dialogue: 0,0:20:28.51,0:20:31.06,Default,,0,0,0,,Мүмкін болса, менің орныма
Dialogue: 0,0:20:31.14,0:20:35.44,Default,,0,0,0,,Бұдан кейінгі дүниеге қараңыз...
Dialogue: 0,0:20:37.94,0:20:39.65,Default,,0,0,0,,Адамдарды жақсы көр...
Dialogue: 0,0:20:41.19,0:20:42.82,Default,,0,0,0,,Сүйікті бол
Dialogue: 0,0:20:42.90,0:20:46.41,Default,,0,0,0,,Охтани-сама, күте тұрыңыз Охтани-сама...
Dialogue: 0,0:20:47.37,0:20:48.91,Default,,0,0,0,,Ха!
Dialogue: 0,0:20:50.83,0:20:54.41,Default,,0,0,0,,Уф, у, ха...
Dialogue: 0,0:20:55.50,0:20:58.96,Default,,0,0,0,,Бұрынғы иесі Мина...
Dialogue: 0,0:20:59.04,0:21:02.42,Default,,0,0,0,,Ол бізді жаратқан.
Dialogue: 0,0:21:02.51,0:21:06.09,Default,,0,0,0,,Олар өзгертілсе немесе өшірілсе де таңқаларлық болмайтын естеліктер
Dialogue: 0,0:21:06.18,0:21:07.93,Default,,0,0,0,,бұрынғы күйінде қалды
Dialogue: 0,0:21:08.68,0:21:11.72,Default,,0,0,0,,Менің жадымда жасырылған...
Dialogue: 0,0:21:12.39,0:21:14.56,Default,,0,0,0,,Сіз оны қорғадыңыз.
Dialogue: 0,0:21:19.11,0:21:21.07,Default,,0,0,0,,-Жарайды, жарайды, жарайды! -Ай~
Dialogue: 0,0:21:21.86,0:21:24.19,Default,,0,0,0,,Дәл солай... Дәл солай!
Dialogue: 0,0:21:24.28,0:21:25.95,Default,,0,0,0,,-Жақсы... -Иә!
Dialogue: 0,0:21:26.03,0:21:29.07,Default,,0,0,0,,Жақсы! Жақсы! Баяу...
Dialogue: 0,0:21:29.74,0:21:31.24,Default,,0,0,0,,Дәл солай...
Dialogue: 0,0:21:31.33,0:21:34.25,Default,,0,0,0,,Иә, тамаша! Алақай!
Dialogue: 0,0:21:34.33,0:21:35.75,Default,,0,0,0,,Құлып дайын!
Dialogue: 0,0:21:35.83,0:21:37.46,Default,,0,0,0,,Ай Ятта!
Dialogue: 0,0:21:37.54,0:21:39.04,Default,,0,0,0,,- Дайын! -Ахаха...
Dialogue: 0,0:21:39.13,0:21:43.21,Default,,0,0,0,,Мина-чанды көрдіңіз бе? Мен жалғыз өзім сарай салдым!
Dialogue: 0,0:21:43.88,0:21:46.47,Default,,0,0,0,,Қамал... Жалғыз Қамал...
Dialogue: 0,0:21:46.55,0:21:48.05,Default,,0,0,0,,- Ятта - Ахаха...
Dialogue: 0,0:21:48.14,0:21:51.05,Default,,0,0,0,,Бұл не үшін пайдалы?
Dialogue: 0,0:21:53.22,0:21:55.10,Default,,0,0,0,,Есіңізде болмаса да
Dialogue: 0,0:21:55.18,0:21:57.35,Default,,0,0,0,,Өйткені олар құнды естеліктер
Dialogue: 0,0:21:57.44,0:21:59.44,Default,,0,0,0,,-Уау! -Ай~!
Dialogue: 0,0:21:59.52,0:22:01.73,Default,,0,0,0,,- Иә! -Ятта ятта!
Dialogue: 0,0:22:01.82,0:22:02.82,Default,,0,0,0,,Мен жасадым!
Dialogue: 0,0:22:02.90,0:22:05.07,Default,,0,0,0,,Ятазо
Dialogue: 0,0:22:06.86,0:22:11.87,Default,,0,0,0,,♪～
Dialogue: 0,0:23:29.40,0:23:35.41,Default,,0,0,0,,～♪
Dialogue: 0,0:23:37.12,0:23:38.33,Default,,0,0,0,,Келесі жолы…
Dialogue: 0,0:23:39.83,0:23:45.83,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
