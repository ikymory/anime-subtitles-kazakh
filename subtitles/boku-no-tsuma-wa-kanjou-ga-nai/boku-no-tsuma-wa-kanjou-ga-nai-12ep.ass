Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.00,0:00:06.29,Default,,0,0,0,,(Ағып жатқан судың дыбысы)
Dialogue: 0,0:00:10.26,0:00:12.17,Default,,0,0,0,,Уау?
Dialogue: 0,0:00:17.30,0:00:20.06,Default,,0,0,0,,Бұл... бұл бала Мамору-кун.
Dialogue: 0,0:00:20.14,0:00:22.68,Default,,0,0,0,,Бастапқыда қарттарды қарау үшін қолданылған.
Dialogue: 0,0:00:22.77,0:00:25.94,Default,,0,0,0,,Мимаморий III – робот.
Dialogue: 0,0:00:26.02,0:00:27.19,Default,,0,0,0,,Иә
Dialogue: 0,0:00:27.27,0:00:29.82,Default,,0,0,0,,Мина-чанның табиғаты қандай болса да
Dialogue: 0,0:00:29.90,0:00:31.69,Default,,0,0,0,,Мен мұрагер бала болдым.
Dialogue: 0,0:00:31.78,0:00:33.45,Default,,0,0,0,,А...
Dialogue: 0,0:00:33.53,0:00:34.70,Default,,0,0,0,,Охайо
Dialogue: 0,0:00:37.37,0:00:40.62,Default,,0,0,0,,Сонда Минаның баласы сияқты.
Dialogue: 0,0:00:41.41,0:00:45.46,Default,,0,0,0,,А... а... иә
Dialogue: 0,0:00:45.54,0:00:47.33,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:00:48.04,0:00:53.72,Default,,0,0,0,,♪～
Dialogue: 0,0:02:11.58,0:02:16.59,Default,,0,0,0,,～♪
Dialogue: 0,0:02:19.68,0:02:23.93,Default,,0,0,0,,Негізі... мен де солай ойладым.
Dialogue: 0,0:02:24.01,0:02:25.97,Default,,0,0,0,,Сәлем Мамору-чан
Dialogue: 0,0:02:26.06,0:02:28.31,Default,,0,0,0,,«Сәлеметсіз бе» дегенді түсіндіңіз бе?
Dialogue: 0,0:02:28.39,0:02:30.23,Default,,0,0,0,,- Конничиха? -(Эми) Иә.
Dialogue: 0,0:02:30.31,0:02:33.48,Default,,0,0,0,,Конничиха – біреумен кездескенде сәлемдесу
Dialogue: 0,0:02:33.57,0:02:35.40,Default,,0,0,0,,Бұл керемет.
Dialogue: 0,0:02:35.48,0:02:38.03,Default,,0,0,0,,-Сен оянсаң, Охайо - (Эми) Дұрыс.
Dialogue: 0,0:02:38.11,0:02:39.82,Default,,0,0,0,,Оясуми ұйықтап жатқанда
Dialogue: 0,0:02:39.90,0:02:41.99,Default,,0,0,0,,- (Эми) Дұрыс! -(Дайсуке) Аа...
Dialogue: 0,0:02:42.07,0:02:45.29,Default,,0,0,0,,Итадакимасу мен Гочисо-сама деп те айта аласыз!
Dialogue: 0,0:02:45.37,0:02:48.50,Default,,0,0,0,,О, Мамору-чан керемет.
Dialogue: 0,0:02:48.58,0:02:51.50,Default,,0,0,0,,Ахаха
Dialogue: 0,0:02:51.58,0:02:54.71,Default,,0,0,0,,Қазіргі роботтар өте жақсы жасалған.
Dialogue: 0,0:02:54.79,0:02:56.00,Default,,0,0,0,,Сонымен... солай ма?
Dialogue: 0,0:02:57.17,0:02:59.01,Default,,0,0,0,,-Ихи - (Эми) Иә?
Dialogue: 0,0:02:59.09,0:03:02.68,Default,,0,0,0,,...
Dialogue: 0,0:03:02.76,0:03:05.43,Default,,0,0,0,,...
Dialogue: 0,0:03:05.51,0:03:08.02,Default,,0,0,0,,- (Эми) Ех... - (Дайсуке) Ой... Эй
Dialogue: 0,0:03:08.10,0:03:09.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:09.60,0:03:11.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:11.56,0:03:14.52,Default,,0,0,0,,- (Эми) О, жоқ, хехехе... - (Дайсуке) Ахаха...
Dialogue: 0,0:03:14.61,0:03:16.73,Default,,0,0,0,,Такума сияқты күледі
Dialogue: 0,0:03:16.82,0:03:18.03,Default,,0,0,0,,Бұл рас
Dialogue: 0,0:03:18.11,0:03:22.11,Default,,0,0,0,,Әй, олар бір-біріне ұқсамайды! Мен бұлай күлмеймін
Dialogue: 0,0:03:22.20,0:03:24.53,Default,,0,0,0,,Жоқ, мен кішкентай кезімде.
Dialogue: 0,0:03:24.62,0:03:28.16,Default,,0,0,0,,Бірдеңе мені қуантқанда, сіз де осылай сезінесіз.
Dialogue: 0,0:03:24.62,0:03:28.16,Default,,0,0,0,,Kehiihihihi…
Dialogue: 0,0:03:28.24,0:03:31.04,Default,,0,0,0,,Мен «и хи хи» деп күлдім
Dialogue: 0,0:03:31.12,0:03:32.50,Default,,0,0,0,,А...
Dialogue: 0,0:03:32.58,0:03:34.33,Default,,0,0,0,,Менің ойымша, бұл роботтарға ұқсас па?
Dialogue: 0,0:03:34.42,0:03:36.04,Default,,0,0,0,,Бұл шындық болуы мүмкін емес.
Dialogue: 0,0:03:36.13,0:03:37.71,Default,,0,0,0,,Такума сияқты ма?
Dialogue: 0,0:03:37.80,0:03:40.30,Default,,0,0,0,,Иә, дәл менің кішкентай кезімдегідей.
Dialogue: 0,0:03:40.38,0:03:44.30,Default,,0,0,0,,Иә! а? Такума: Бұл робот па?
Dialogue: 0,0:03:44.39,0:03:47.31,Default,,0,0,0,,- дейін? -(Эми) Хехе... Жоқ, жоқ.
Dialogue: 0,0:03:47.39,0:03:49.93,Default,,0,0,0,,Сіздің күлгеніңіз дәл солай болды.
Dialogue: 0,0:03:50.02,0:03:51.89,Default,,0,0,0,,Ихихихи Ихихихи…
Dialogue: 0,0:03:51.98,0:03:56.31,Default,,0,0,0,,Ааа
Dialogue: 0,0:03:56.40,0:03:58.82,Default,,0,0,0,,Хаха сүйкімді
Dialogue: 0,0:03:58.90,0:04:01.32,Default,,0,0,0,,Бұл өте сүйкімді
Dialogue: 0,0:04:01.40,0:04:05.41,Default,,0,0,0,,Эй Такума, бұл қыз қанша тұрады?
Dialogue: 0,0:04:05.49,0:04:08.74,Default,,0,0,0,,Аа, мен оны сыйлық ретінде алғандықтан білмеймін.
Dialogue: 0,0:04:08.83,0:04:10.58,Default,,0,0,0,,- (Эми) Ой... - Қарап көрейін бе?
Dialogue: 0,0:04:10.66,0:04:14.08,Default,,0,0,0,,Мими... Мимамориус... Міне, осы.
Dialogue: 0,0:04:14.17,0:04:17.25,Default,,0,0,0,,Мен сіздің анаңыздың смартфонына URL мекенжайын жіберемін.
Dialogue: 0,0:04:18.04,0:04:21.30,Default,,0,0,0,,Шынында, мен сізден тағы бір сұрайын дегенім бар.
Dialogue: 0,0:04:21.38,0:04:22.92,Default,,0,0,0,,Не?
Dialogue: 0,0:04:23.01,0:04:26.14,Default,,0,0,0,,Сіз Минаның иесісіз, солай ма?
Dialogue: 0,0:04:26.22,0:04:28.81,Default,,0,0,0,,Аа, мен бірінші тіркелдім.
Dialogue: 0,0:04:28.89,0:04:32.60,Default,,0,0,0,,Бұл... Мен оны өзгерте алмаймын ба?
Dialogue: 0,0:04:33.23,0:04:35.52,Default,,0,0,0,,Иә?неге?
Dialogue: 0,0:04:35.60,0:04:38.36,Default,,0,0,0,,Бұл менің жеке сезімім ғана.
Dialogue: 0,0:04:38.44,0:04:42.69,Default,,0,0,0,,Әйелім деп атаған бала сізде.
Dialogue: 0,0:04:42.78,0:04:46.86,Default,,0,0,0,,Бұл жай ғана... өрескел сияқты, солай емес пе?
Dialogue: 0,0:04:46.95,0:04:48.28,Default,,0,0,0,,Ха…
Dialogue: 0,0:04:49.45,0:04:53.50,Default,,0,0,0,,Ол менің нағыз әйелім болмаған соң жақсы емес пе?
Dialogue: 0,0:04:53.58,0:04:55.87,Default,,0,0,0,,Такума үшін бұл шынайы, солай ма?
Dialogue: 0,0:04:55.96,0:04:57.88,Default,,0,0,0,,Ха!
Dialogue: 0,0:04:59.96,0:05:01.25,Default,,0,0,0,,Такума?
Dialogue: 0,0:05:03.46,0:05:06.13,Default,,0,0,0,,- (Эми) Солай емес пе? -Иә
Dialogue: 0,0:05:06.22,0:05:08.80,Default,,0,0,0,,Олай болса, оны өзгертуімді қалайсыз.
Dialogue: 0,0:05:08.89,0:05:10.64,Default,,0,0,0,,- (Эми) Сен менің әкем бола аласың - (Дайсуке) Кімге?
Dialogue: 0,0:05:12.35,0:05:15.39,Default,,0,0,0,,Сіздің отбасыңыз сізге тиесілі емес.
Dialogue: 0,0:05:15.48,0:05:17.27,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:05:17.35,0:05:20.27,Default,,0,0,0,,Отбасы? Иә...
Dialogue: 0,0:05:20.36,0:05:23.28,Default,,0,0,0,,Бұл біздің өніміміз емес
Dialogue: 0,0:05:23.36,0:05:26.36,Default,,0,0,0,,Біз тұтынушының қымбат отбасымыз.
Dialogue: 0,0:05:27.70,0:05:29.74,Default,,0,0,0,,Егер сіз бұл роботты әйеліңіз деп атасаңыз,
Dialogue: 0,0:05:29.82,0:05:32.58,Default,,0,0,0,,Мұны да ескеріңіз.
Dialogue: 0,0:05:37.58,0:05:40.96,Default,,0,0,0,,Мина-чанға меншік құқығын өзгерту процедурасын айтыңыз
Dialogue: 0,0:05:41.54,0:05:42.96,Default,,0,0,0,,Менің қолымнан келеді деп ойлаймын
Dialogue: 0,0:05:46.42,0:05:48.97,Default,,0,0,0,,Меншік құқығын беру ұсынылмайды
Dialogue: 0,0:05:49.05,0:05:50.97,Default,,0,0,0,,- Иә? -(Эми) Неге?
Dialogue: 0,0:05:51.05,0:05:53.26,Default,,0,0,0,,Біздің робот не істейді?
Dialogue: 0,0:05:53.35,0:05:57.69,Default,,0,0,0,,құқықтарды меншік иесі атынан жүзеге асыратындай етіп жүзеге асырылады
Dialogue: 0,0:05:57.77,0:05:59.94,Default,,0,0,0,,Егер иесі жоқ болса
Dialogue: 0,0:06:00.02,0:06:03.90,Default,,0,0,0,,Сол адамнан рұқсат алмайынша, алманың қабығын аршуға болмайды.
Dialogue: 0,0:06:03.98,0:06:08.11,Default,,0,0,0,,Хмм... Мысалы, «Сізге менің рұқсатым қажет емес».
Dialogue: 0,0:06:08.20,0:06:11.49,Default,,0,0,0,,«Орындауда Такуманың еркін орындау» сияқты нәрсе
Dialogue: 0,0:06:11.57,0:06:13.70,Default,,0,0,0,,Оны орнату мүмкін емес пе?
Dialogue: 0,0:06:13.79,0:06:14.99,Default,,0,0,0,,Астанада ханым Куруш оларды қор ретінде жинап жатқанын естідім.
Dialogue: 0,0:06:15.08,0:06:16.29,Default,,0,0,0,,Егер солай болса...
Dialogue: 0,0:06:16.37,0:06:18.58,Default,,0,0,0,,Алайда, күтпеген жағдайда
Dialogue: 0,0:06:18.66,0:06:22.13,Default,,0,0,0,,Бірден жауап беру мүмкін болмауы мүмкін
Dialogue: 0,0:06:22.21,0:06:26.21,Default,,0,0,0,,Олай болса... «Күтпеген жағдай туындағанда не істеу керек?»
Dialogue: 0,0:06:26.30,0:06:29.84,Default,,0,0,0,,«Такумаға қалдыру» мүмкін емес пе?
Dialogue: 0,0:06:30.59,0:06:31.80,Default,,0,0,0,,Хмм…
Dialogue: 0,0:06:35.39,0:06:36.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:39.35,0:06:40.65,Default,,0,0,0,,Астанада ханым Куруш оларды қор ретінде жинап жатқанын естідім.
Dialogue: 0,0:06:41.40,0:06:45.78,Default,,0,0,0,,Аа, кездейсоқ... жек көресің бе?
Dialogue: 0,0:06:47.24,0:06:50.70,Default,,0,0,0,,(Дыбыс фокусы)
Dialogue: 0,0:06:50.78,0:06:52.45,Default,,0,0,0,,Жоқ...?
Dialogue: 0,0:06:53.87,0:06:55.79,Default,,0,0,0,,Неліктен бұл сізге ұнамайды?
Dialogue: 0,0:06:55.87,0:06:58.16,Default,,0,0,0,,Ақылға қонымды негіздер жоқ
Dialogue: 0,0:06:58.25,0:07:01.29,Default,,0,0,0,,Бәрі жақсы, айтыңыз.
Dialogue: 0,0:07:01.37,0:07:02.58,Default,,0,0,0,,Иә
Dialogue: 0,0:07:04.25,0:07:08.51,Default,,0,0,0,,Роботтар барлық адамдардың өмірін қорғау үшін әрекет етеді.
Dialogue: 0,0:07:08.59,0:07:11.68,Default,,0,0,0,,Ең бастысы, иесінің өмірі - біздің басты міндетіміз.
Dialogue: 0,0:07:12.51,0:07:16.43,Default,,0,0,0,,Меншік құқығы Эмидің қанағаттандырылуына ауысқанда
Dialogue: 0,0:07:16.51,0:07:20.81,Default,,0,0,0,,Такума-сама мен Эми-саманың өміріне бірдей қауіп төнген кезде
Dialogue: 0,0:07:20.89,0:07:24.40,Default,,0,0,0,,Мен Эми-самаға көмектесуім керек.
Dialogue: 0,0:07:25.36,0:07:28.57,Default,,0,0,0,,Бұл менің ең маңызды бөлігім
Dialogue: 0,0:07:29.28,0:07:31.86,Default,,0,0,0,,Оны толық орындау мүмкін болмайды.
Dialogue: 0,0:07:35.41,0:07:39.79,Default,,0,0,0,,Құрметті Эми, менің жұмысымды тартып алмашы.
Dialogue: 0,0:07:43.92,0:07:45.21,Default,,0,0,0,,Құт
Dialogue: 0,0:07:47.04,0:07:49.30,Default,,0,0,0,,Мен...мен де...
Dialogue: 0,0:07:49.38,0:07:51.72,Default,,0,0,0,,Мина-чанды ешкімге бергім келмейді!
Dialogue: 0,0:07:51.80,0:07:53.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:53.38,0:07:55.09,Default,,0,0,0,,Маған сенің не ойлайтының бәрібір!
Dialogue: 0,0:08:05.77,0:08:08.98,Default,,0,0,0,,Бұл жақсы, иә.
Dialogue: 0,0:08:10.82,0:08:11.86,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:08:12.65,0:08:16.74,Default,,0,0,0,,Хмм, мен бірінші иесі болып қала беремін.
Dialogue: 0,0:08:16.82,0:08:18.62,Default,,0,0,0,,Екінші иесі – менің анам...
Dialogue: 0,0:08:19.79,0:08:22.46,Default,,0,0,0,,Мен мұны істесем, менде қандай да бір қиындық болады.
Dialogue: 0,0:08:22.54,0:08:24.62,Default,,0,0,0,,Меншік құқығын жоғалтуды білдірсе де
Dialogue: 0,0:08:24.71,0:08:28.04,Default,,0,0,0,,Минаның естеліктері шифрланбаған.
Dialogue: 0,0:08:28.13,0:08:31.46,Default,,0,0,0,,Оның үстіне Мина бірінші иесімен қатынасқа түсті.
Dialogue: 0,0:08:31.55,0:08:34.30,Default,,0,0,0,,Мәселе бар екені анықталса
Dialogue: 0,0:08:34.38,0:08:38.89,Default,,0,0,0,,Өз қалауыңыз бойынша екінші иесіне эвакуациялауға болатын сияқты.
Dialogue: 0,0:08:38.97,0:08:40.14,Default,,0,0,0,,- (Дайсуке) Ой... - (Эми) Ммм...
Dialogue: 0,0:08:40.22,0:08:43.10,Default,,0,0,0,,Әзірше оны осы күйде қалдырсақ қалай болады?
Dialogue: 0,0:08:43.18,0:08:45.60,Default,,0,0,0,,- (Эми) Менің ойымша, бұл жақсы - (Дайсуке) Иә, иә.
Dialogue: 0,0:08:45.69,0:08:48.11,Default,,0,0,0,,Мина-чан, сен қалай ойлайсың?
Dialogue: 0,0:08:48.19,0:08:49.61,Default,,0,0,0,,Мәселе жоқ
Dialogue: 0,0:08:51.65,0:08:53.24,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:55.03,0:08:59.24,Default,,0,0,0,,Ой, қандай қызық робот.
Dialogue: 0,0:08:59.33,0:09:03.58,Default,,0,0,0,,Ауылда тұрсаң, көп нәрсені көрмейсің.
Dialogue: 0,0:09:04.21,0:09:06.37,Default,,0,0,0,,-Әке-(Дайсуке) А?
Dialogue: 0,0:09:06.46,0:09:09.04,Default,,0,0,0,,-Аа... -(Дайсуке) Не болды?
Dialogue: 0,0:09:09.13,0:09:12.00,Default,,0,0,0,,-Мм... Кешіріңіз. -(Дайсуке) А?
Dialogue: 0,0:09:12.09,0:09:15.51,Default,,0,0,0,,Мен адамдық әйелімді әкеле алмадым.
Dialogue: 0,0:09:16.97,0:09:18.51,Default,,0,0,0,,Көресіңдер әлі
Dialogue: 0,0:09:18.59,0:09:21.01,Default,,0,0,0,,-Е... -(Дайсуке) Көңілім жайланып қалды.
Dialogue: 0,0:09:21.10,0:09:23.02,Default,,0,0,0,,Сіз жалғыз емессіз
Dialogue: 0,0:09:23.10,0:09:27.02,Default,,0,0,0,,Менің ойымша, адамның әйелі болғаны жақсы идея емес.
Dialogue: 0,0:09:27.10,0:09:28.40,Default,,0,0,0,,Бұл өтірік болар еді.
Dialogue: 0,0:09:29.06,0:09:32.65,Default,,0,0,0,,Жарайды... Немеремнің бетін көрсете алмаймын...
Dialogue: 0,0:09:32.73,0:09:34.03,Default,,0,0,0,,Жарайды, ақымақ.
Dialogue: 0,0:09:34.11,0:09:36.78,Default,,0,0,0,,Адам деген... міне, солай.
Dialogue: 0,0:09:36.86,0:09:39.20,Default,,0,0,0,,Ата-ананың қалауы бойынша туған
Dialogue: 0,0:09:39.28,0:09:42.54,Default,,0,0,0,,Ғашық болған адамыңның баласын қолыңа алғың келе ме, әлде таусылғансың.
Dialogue: 0,0:09:42.62,0:09:44.83,Default,,0,0,0,,Себептер мен логика бар болса да
Dialogue: 0,0:09:44.91,0:09:47.54,Default,,0,0,0,,Ал, мен өзімшілдік нәтиже аламын.
Dialogue: 0,0:09:47.62,0:09:51.50,Default,,0,0,0,,Егер сіз жағдайды жақсартуға және өзіңізді тазартуға дайындалсаңыз да,
Dialogue: 0,0:09:51.59,0:09:54.42,Default,,0,0,0,,Бұл ерікті болуды тоқтатпайды, солай ма?
Dialogue: 0,0:09:55.92,0:09:59.55,Default,,0,0,0,,Менің ойымша, бұл жақсы.
Dialogue: 0,0:10:01.01,0:10:03.06,Default,,0,0,0,,Біз өзімізді жақсы сезінеміз
Dialogue: 0,0:10:03.14,0:10:06.81,Default,,0,0,0,,Адамдардың бетіне тым көп қарайсың.
Dialogue: 0,0:10:07.69,0:10:09.44,Default,,0,0,0,,Тез кешірім сұрамаңыз
Dialogue: 0,0:10:12.65,0:10:14.07,Default,,0,0,0,,Иә
Dialogue: 0,0:10:14.15,0:10:15.94,Default,,0,0,0,,...
Dialogue: 0,0:10:16.03,0:10:18.11,Default,,0,0,0,,Уу... аа
Dialogue: 0,0:10:19.32,0:10:23.74,Default,,0,0,0,,Эй Мамору, сен шоги фигураларымен ойнайсың ба?
Dialogue: 0,0:10:23.83,0:10:26.37,Default,,0,0,0,,Шоги? Шоги дегеніміз не?
Dialogue: 0,0:10:26.45,0:10:29.00,Default,,0,0,0,,Жарайды, жарайды, мен саған айтамын.
Dialogue: 0,0:10:29.08,0:10:30.71,Default,,0,0,0,,Ахх
Dialogue: 0,0:10:30.79,0:10:31.88,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:10:31.96,0:10:34.71,Default,,0,0,0,,-Мен үйдемін -Қош келдіңіз
Dialogue: 0,0:10:34.80,0:10:36.71,Default,,0,0,0,,Иә? Бұл!
Dialogue: 0,0:10:36.80,0:10:39.05,Default,,0,0,0,,- Онии-чан! -Қайырлы кеш
Dialogue: 0,0:10:39.13,0:10:40.84,Default,,0,0,0,,Қайырлы кеш Акари-сама
Dialogue: 0,0:10:40.93,0:10:42.80,Default,,0,0,0,,Мина да! не болды?
Dialogue: 0,0:10:42.89,0:10:44.97,Default,,0,0,0,,Хехе... жай ғана сәлемдесу үшін.
Dialogue: 0,0:10:45.60,0:10:47.98,Default,,0,0,0,,Сәлем... Ха!
Dialogue: 0,0:10:48.06,0:10:51.40,Default,,0,0,0,,Минаны ата-анамның үйіне әйелім деп таныстыру!?
Dialogue: 0,0:10:51.48,0:10:54.23,Default,,0,0,0,,А... мен де...
Dialogue: 0,0:10:54.32,0:10:56.73,Default,,0,0,0,,Мен де сонда болғым келді!
Dialogue: 0,0:10:56.82,0:10:58.24,Default,,0,0,0,,Акариге не болды?
Dialogue: 0,0:10:58.32,0:11:00.45,Default,,0,0,0,,Акари Доши?
Dialogue: 0,0:11:00.53,0:11:02.74,Default,,0,0,0,,Ха! Ех!
Dialogue: 0,0:11:02.82,0:11:05.16,Default,,0,0,0,,Мүмкін бұл Мина айтқан бала шығар.
Dialogue: 0,0:11:05.24,0:11:06.45,Default,,0,0,0,,Мамору-кун!?
Dialogue: 0,0:11:06.54,0:11:09.21,Default,,0,0,0,,Мен қатты толқып тұрмын!
Dialogue: 0,0:11:09.29,0:11:13.71,Default,,0,0,0,,Иә? Теледидардан көргенімнен басқаша...
Dialogue: 0,0:11:13.79,0:11:15.25,Default,,0,0,0,,Ай
Dialogue: 0,0:11:15.34,0:11:17.63,Default,,0,0,0,,Шын мәнінде...
Dialogue: 0,0:11:19.51,0:11:20.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:21.47,0:11:23.89,Default,,0,0,0,,Негізгі бағдарлама жұмыс істемейді
Dialogue: 0,0:11:23.97,0:11:26.81,Default,,0,0,0,,Үйренді... Тұрақты емес
Dialogue: 0,0:11:26.89,0:11:29.31,Default,,0,0,0,,Минаның бағдарламасына негізделген
Dialogue: 0,0:11:29.39,0:11:31.19,Default,,0,0,0,,Өздігінен қозғалады...
Dialogue: 0,0:11:31.27,0:11:34.19,Default,,0,0,0,,Иә?осу?
Dialogue: 0,0:11:35.61,0:11:37.90,Default,,0,0,0,,Күннің соңына сай ән
Dialogue: 0,0:11:38.53,0:11:40.70,Default,,0,0,0,,Ae~?
Dialogue: 0,0:11:41.40,0:11:45.07,Default,,0,0,0,,Негізгі бағдарлама… Оқу… Тұрақты емес…
Dialogue: 0,0:11:45.16,0:11:49.58,Default,,0,0,0,,Мина-сан... қозғалады... өз бетімен...
Dialogue: 0,0:11:49.66,0:11:51.83,Default,,0,0,0,,А... Акари?
Dialogue: 0,0:11:57.17,0:11:58.84,Default,,0,0,0,,Жедел жәрдем шақыруым керек пе?
Dialogue: 0,0:11:58.92,0:12:00.42,Default,,0,0,0,,Маған қоңырау шалмаңыз
Dialogue: 0,0:12:00.51,0:12:02.93,Default,,0,0,0,,Эй, Акари, өзіңді ұста!
Dialogue: 0,0:12:03.01,0:12:04.84,Default,,0,0,0,,Күтіңіз, күтіңіз, күтіңіз
Dialogue: 0,0:12:04.93,0:12:08.10,Default,,0,0,0,,Тығыз ақпаратты кенеттен құймаңыз
Dialogue: 0,0:12:08.93,0:12:10.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:10.27,0:12:12.35,Default,,0,0,0,,Жынды болу
Dialogue: 0,0:12:12.44,0:12:14.02,Default,,0,0,0,,Куку…
Dialogue: 0,0:12:14.10,0:12:18.27,Default,,0,0,0,,Жоқ. Басқа адамдардың ақпаратына түс қосудан аулақ бола аласыз ба?
Dialogue: 0,0:12:19.65,0:12:20.86,Default,,0,0,0,,Я...
Dialogue: 0,0:12:20.94,0:12:23.36,Default,,0,0,0,,Қош келдіңіз, бізде карри бар.
Dialogue: 0,0:12:23.45,0:12:25.16,Default,,0,0,0,,Мина-чан орындады.
Dialogue: 0,0:12:25.24,0:12:29.37,Default,,0,0,0,,Дәл қазір жүрегім толып кетті... дәлірек айтсам, ішім күйіп тұр...
Dialogue: 0,0:12:29.45,0:12:31.37,Default,,0,0,0,,Жедел жәрдем шақыруым керек пе?
Dialogue: 0,0:12:29.45,0:12:31.37,Default,,0,0,0,,(сирена дыбысы)
Dialogue: 0,0:12:31.45,0:12:33.33,Default,,0,0,0,,Қоңырау шалмаңыз
Dialogue: 0,0:12:40.63,0:12:43.47,Default,,0,0,0,,(көлік терезесінің ашылған дыбысы)
Dialogue: 0,0:12:43.55,0:12:47.09,Default,,0,0,0,,Мина-чан, карри дәмді болды. Жуықта көріскенше.
Dialogue: 0,0:12:47.18,0:12:50.22,Default,,0,0,0,,Мен сізге тағы хабарласамын, олай болса бірге дүкен аралайық.
Dialogue: 0,0:12:50.31,0:12:51.97,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:12:52.06,0:12:54.48,Default,,0,0,0,,- (Дайсуке) Мамору Матана - Сайонара
Dialogue: 0,0:12:54.56,0:12:56.81,Default,,0,0,0,,Мен қайтадан келемін.
Dialogue: 0,0:12:56.90,0:12:58.56,Default,,0,0,0,,О, қолыңнан келгеннің бәрін жаса.
Dialogue: 0,0:12:58.65,0:12:59.86,Default,,0,0,0,,Иә
Dialogue: 0,0:13:04.20,0:13:07.70,Default,,0,0,0,,Абайлаңыз! Күте тұрыңыз!
Dialogue: 0,0:13:07.78,0:13:12.16,Default,,0,0,0,,Акари, сен Мина-чанның жеке байланыс ақпаратын білесің бе?
Dialogue: 0,0:13:12.24,0:13:13.33,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:13:13.41,0:13:15.58,Default,,0,0,0,,Анаңа айт.
Dialogue: 0,0:13:15.66,0:13:17.50,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:17.58,0:13:20.59,Default,,0,0,0,,Маған ақпарат ақысын беріңізші.
Dialogue: 0,0:13:20.67,0:13:23.13,Default,,0,0,0,,Ата-анаңмен мәміле жасағың келе ме?
Dialogue: 0,0:13:23.21,0:13:24.51,Default,,0,0,0,,-(Дайсуке) Хахаха... -Ихихи...
Dialogue: 0,0:13:25.38,0:13:26.68,Default,,0,0,0,,Жарайды, бірде бірге шай ішуге баруымыз керек қой?
Dialogue: 0,0:13:26.76,0:13:28.51,Default,,0,0,0,,- (Мина) Такума-сама - А?
Dialogue: 0,0:13:28.59,0:13:31.51,Default,,0,0,0,,Сен онымен дұрыс амандаса алдың ба?
Dialogue: 0,0:13:34.35,0:13:36.14,Default,,0,0,0,,Өте жақсы болды.
Dialogue: 0,0:13:37.14,0:13:38.90,Default,,0,0,0,,Бұл жақсы болды.
Dialogue: 0,0:13:46.95,0:13:50.78,Default,,0,0,0,,А... бұл дәм сондай сағыныш.
Dialogue: 0,0:13:50.87,0:13:53.49,Default,,0,0,0,,Мен Эмиден үйрендім және жасадым.
Dialogue: 0,0:13:53.58,0:13:56.16,Default,,0,0,0,,Мен ностальгия сезінемін, бірақ...
Dialogue: 0,0:13:58.50,0:14:02.29,Default,,0,0,0,,Мүмкін маған енді Минаның дәмі ұнайтын шығар.
Dialogue: 0,0:14:03.59,0:14:05.30,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:14:05.38,0:14:07.42,Default,,0,0,0,,Ай
Dialogue: 0,0:14:07.51,0:14:09.01,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:14:09.09,0:14:11.43,Default,,0,0,0,,-(Курьер) Бұл жеткізу.-(Эми) Иә.
Dialogue: 0,0:14:11.51,0:14:13.68,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:14:13.76,0:14:16.14,Default,,0,0,0,,Хехе...
Dialogue: 0,0:14:16.23,0:14:19.56,Default,,0,0,0,,Ахаха, мен оны сатып алдым!
Dialogue: 0,0:14:20.27,0:14:23.69,Default,,0,0,0,,Бастау үшін алдымен басты басыңыз.
Dialogue: 0,0:14:26.11,0:14:27.32,Default,,0,0,0,,Ой
Dialogue: 0,0:14:30.28,0:14:31.70,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:14:31.78,0:14:32.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:32.99,0:14:36.79,Default,,0,0,0,,Мен Мимамориус IIIмін, бақылаушы роботпын.
Dialogue: 0,0:14:36.87,0:14:38.75,Default,,0,0,0,,Дауыссыз
Dialogue: 0,0:14:38.83,0:14:42.71,Default,,0,0,0,,Сонымен... «Оны іске қосқаннан кейін, әңгімеден ләззат алайық»
Dialogue: 0,0:14:42.79,0:14:47.97,Default,,0,0,0,,«Мимамориус III тіпті қарт адамдарға да естілетін төмен дауысты.»
Dialogue: 0,0:14:48.05,0:14:50.22,Default,,0,0,0,,«Сіз жан тыныштығымен сөйлесе аласыз»
Dialogue: 0,0:14:50.30,0:14:53.72,Default,,0,0,0,,Алдымен маған ат беріңізші.
Dialogue: 0,0:14:53.80,0:14:57.18,Default,,0,0,0,,Мм... сонда, Джон.
Dialogue: 0,0:14:57.27,0:14:58.60,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:14:58.68,0:15:01.35,Default,,0,0,0,,Мен... Джон
Dialogue: 0,0:15:01.44,0:15:04.86,Default,,0,0,0,,Даусыңыз сондай ащы екен ғой...
Dialogue: 0,0:15:09.70,0:15:12.82,Default,,0,0,0,,Тұз бен май аздап көп.
Dialogue: 0,0:15:12.91,0:15:17.24,Default,,0,0,0,,Екеуіңіздің жасыңызды ескере отырып, оны төмен деңгейде ұстағаныңыз жөн сияқты.
Dialogue: 0,0:15:17.33,0:15:18.58,Default,,0,0,0,,Хаха…
Dialogue: 0,0:15:18.66,0:15:21.08,Default,,0,0,0,,- (Дэйсуке) Не! -(Эми) Хехе... Ахах...
Dialogue: 0,0:15:21.17,0:15:23.75,Default,,0,0,0,,Жоқ, әке!
Dialogue: 0,0:15:23.83,0:15:25.59,Default,,0,0,0,,Өтінемін, қазір ұйықтаңыз.
Dialogue: 0,0:15:25.67,0:15:26.80,Default,,0,0,0,,Е...
Dialogue: 0,0:15:26.88,0:15:28.96,Default,,0,0,0,,Дене және психикалық денсаулықты сақтау
Dialogue: 0,0:15:29.05,0:15:31.51,Default,,0,0,0,,Ұйқы уақыты өте маңызды
Dialogue: 0,0:15:35.39,0:15:37.43,Default,,0,0,0,,(Дайсукенің қорылдауы)
Dialogue: 0,0:15:37.51,0:15:39.93,Default,,0,0,0,,Қайырлы түн Эми-сама
Dialogue: 0,0:15:40.85,0:15:43.60,Default,,0,0,0,,Бұл мен ойлағаннан басқаша...
Dialogue: 0,0:15:44.27,0:15:46.65,Default,,0,0,0,,Сәлемдеме...
Dialogue: 0,0:15:52.66,0:15:55.95,Default,,0,0,0,,Түсіндім... Сонда сізге үй керек пе?
Dialogue: 0,0:15:56.03,0:15:58.41,Default,,0,0,0,,Иә... менің отбасым өсті.
Dialogue: 0,0:15:58.49,0:16:00.87,Default,,0,0,0,,Менің қазіргі бөлмем тым тар болып қалды, сондықтан
Dialogue: 0,0:16:00.96,0:16:03.87,Default,,0,0,0,,Бұл ғимарат ескі, бірақ
Dialogue: 0,0:16:03.96,0:16:06.88,Default,,0,0,0,,Менің ойымша, бұл жеткілікті кең ...
Dialogue: 0,0:16:08.09,0:16:10.38,Default,,0,0,0,,Ух... у... жақсы...
Dialogue: 0,0:16:11.34,0:16:12.59,Default,,0,0,0,,Жарайды, бірде бірге шай ішуге баруымыз керек қой?
Dialogue: 0,0:16:12.68,0:16:15.14,Default,,0,0,0,,Мен шынымен көмектесуім керек пе?
Dialogue: 0,0:16:15.22,0:16:16.64,Default,,0,0,0,,Иә, бәрібір
Dialogue: 0,0:16:17.72,0:16:19.39,Default,,0,0,0,,Тамақ пісіруден басқа нәрсе істеуді сұрағанда
Dialogue: 0,0:16:19.47,0:16:23.52,Default,,0,0,0,,Сондай-ақ, қосымша бағдарламалар туралы хабарландырулар шулы сияқты...
Dialogue: 0,0:16:24.19,0:16:27.48,Default,,0,0,0,,Ас үйдегі жиһаздың орналасуын қарастыра аласыз ба?
Dialogue: 0,0:16:27.56,0:16:28.82,Default,,0,0,0,,Мен қарап көрейін
Dialogue: 0,0:16:30.48,0:16:32.53,Default,,0,0,0,,Такума!
Dialogue: 0,0:16:32.61,0:16:34.53,Default,,0,0,0,,Жақсы...
Dialogue: 0,0:16:35.45,0:16:37.53,Default,,0,0,0,,- Дайын! -а?
Dialogue: 0,0:16:38.20,0:16:41.33,Default,,0,0,0,,Дайын, Мамору-кун, картон лабиринт!
Dialogue: 0,0:16:41.41,0:16:43.79,Default,,0,0,0,,Ой!
Dialogue: 0,0:16:43.87,0:16:45.75,Default,,0,0,0,,Бұл көрсеткі басталады
Dialogue: 0,0:16:45.83,0:16:48.46,Default,,0,0,0,,Ал жоғарғы жағындағы сүйек жастықшасын алыңыз.
Dialogue: 0,0:16:48.54,0:16:50.96,Default,,0,0,0,,Егер сіз басына оралсаңыз, бұл түсінікті.
Dialogue: 0,0:16:51.05,0:16:52.55,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:16:52.63,0:16:53.63,Default,,0,0,0,,Сіз мұны істейсіз бе?
Dialogue: 0,0:16:53.72,0:16:56.05,Default,,0,0,0,,Ялл! Яр ял ялл
Dialogue: 0,0:16:56.14,0:16:59.81,Default,,0,0,0,,Жарайды, мен оны тазалауға кететін уақытты өлшеймін.
Dialogue: 0,0:17:00.39,0:17:01.97,Default,,0,0,0,,Бастапқыда күту
Dialogue: 0,0:17:02.06,0:17:03.06,Default,,0,0,0,,О-о-о~! Жамылғыға ұқсайды.
Dialogue: 0,0:17:03.64,0:17:04.69,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:17:04.77,0:17:06.44,Default,,0,0,0,,Жақсы…
Dialogue: 0,0:17:07.27,0:17:08.52,Default,,0,0,0,,Қазір мен сөйлесіп тұрған адам – басқа емес,
Dialogue: 0,0:17:08.61,0:17:11.15,Default,,0,0,0,,Киеее~
Dialogue: 0,0:17:11.23,0:17:13.69,Default,,0,0,0,,Ха ха ха ха…
Dialogue: 0,0:17:13.78,0:17:16.45,Default,,0,0,0,,Сіз сәл үлкенірек жерге көшіп жатқаныңызды айтқан кезде.
Dialogue: 0,0:17:16.53,0:17:19.95,Default,,0,0,0,,Ата-анаңның үйінде қалдырған кітаптарың мен ойындарыңды маған жіберші.
Dialogue: 0,0:17:20.83,0:17:22.87,Default,,0,0,0,,Мен не істеймін деп ойладым...
Dialogue: 0,0:17:24.46,0:17:26.96,Default,,0,0,0,,Ах... иә?
Dialogue: 0,0:17:28.58,0:17:30.21,Default,,0,0,0,,Ууууу...
Dialogue: 0,0:17:30.29,0:17:31.71,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:32.50,0:17:33.71,Default,,0,0,0,,Ihi
Dialogue: 0,0:17:33.80,0:17:35.51,Default,,0,0,0,,Иә, иә…
Dialogue: 0,0:17:35.59,0:17:38.26,Default,,0,0,0,,Жоқ, жоқ... күт, күт, Мамору-кун
Dialogue: 0,0:17:38.34,0:17:39.80,Default,,0,0,0,,A?
Dialogue: 0,0:17:39.89,0:17:42.72,Default,,0,0,0,,Егер солай болса, лабиринт жасаудың қажеті жоқ, солай ма?
Dialogue: 0,0:17:43.52,0:17:44.73,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:17:44.81,0:17:48.23,Default,,0,0,0,,Иә... ғажап, бірақ көтерілмейік.
Dialogue: 0,0:17:48.31,0:17:49.73,Default,,0,0,0,,Ааааа…
Dialogue: 0,0:17:56.15,0:17:57.74,Default,,0,0,0,,Сен қалай ойлайсың, Мина-чан?
Dialogue: 0,0:17:58.82,0:18:00.78,Default,,0,0,0,,Бұл кең және әдемі.
Dialogue: 0,0:18:00.87,0:18:03.74,Default,,0,0,0,,Ас үй жаңа ғана жөндеуден өткен сияқты.
Dialogue: 0,0:18:03.83,0:18:08.25,Default,,0,0,0,,Мен Мина-чан бақытты болады деп ойладым да, осылай шештім.
Dialogue: 0,0:18:09.04,0:18:11.50,Default,,0,0,0,,Бақытты адам – Такума-сама.
Dialogue: 0,0:18:11.59,0:18:14.25,Default,,0,0,0,,бастап дәмді тағамды жеуге болады
Dialogue: 0,0:18:14.34,0:18:16.30,Default,,0,0,0,,Хаха... Әрине.
Dialogue: 0,0:18:16.38,0:18:19.18,Default,,0,0,0,,Қараңдаршы, төрт пеш бар.
Dialogue: 0,0:18:19.26,0:18:20.26,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:18:22.68,0:18:24.14,Default,,0,0,0,,Қуа келе жатқандар кетті.
Dialogue: 0,0:18:25.64,0:18:29.77,Default,,0,0,0,,Дарлинг көшкеннің бірінші күні не жегісі келеді?
Dialogue: 0,0:18:29.85,0:18:31.61,Default,,0,0,0,,ше? Қымбаттым?
Dialogue: 0,0:18:31.69,0:18:35.32,Default,,0,0,0,,Так-кун, қозғалатын соба жегің келе ме?
Dialogue: 0,0:18:35.40,0:18:37.65,Default,,0,0,0,,Тоқта, күт, кенет не болды?
Dialogue: 0,0:18:37.74,0:18:40.07,Default,,0,0,0,,Эми-сама Дайсуке-сама туралы айтты.
Dialogue: 0,0:18:40.16,0:18:42.87,Default,,0,0,0,,Себебі мен сені «Анта» немесе «Сен» деп атайтынмын.
Dialogue: 0,0:18:42.95,0:18:44.91,Default,,0,0,0,,Мен оны интернеттен қарадым.
Dialogue: 0,0:18:45.54,0:18:48.29,Default,,0,0,0,,Жарды шақырудың көптеген жолдары бар сияқты.
Dialogue: 0,0:18:48.37,0:18:50.42,Default,,0,0,0,,А... жарайды, солай.
Dialogue: 0,0:18:50.50,0:18:54.59,Default,,0,0,0,,Мен Таку-чанға ұнайтын есімді табуға тырысамын.
Dialogue: 0,0:18:54.67,0:18:56.67,Default,,0,0,0,,Таку-чан... Мм...
Dialogue: 0,0:18:56.76,0:18:59.80,Default,,0,0,0,,Неліктен маған қай есім ұнайтынын сұрамайсыз?
Dialogue: 0,0:18:59.88,0:19:01.51,Default,,0,0,0,,Бұйрық болса, орындаймын.
Dialogue: 0,0:19:01.59,0:19:05.72,Default,,0,0,0,,А... жоқ, бұл бұйрық емес, бірақ бұл әрекеттен гөрі жылдамырақ емес пе?
Dialogue: 0,0:19:05.81,0:19:09.23,Default,,0,0,0,,Такупённың ұнатуы мен ұнатпауын анықтау алгоритмі
Dialogue: 0,0:19:09.31,0:19:12.23,Default,,0,0,0,,Жарайды, өйткені оны өзіміз жасадық.
Dialogue: 0,0:19:12.31,0:19:13.56,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:19:13.65,0:19:16.86,Default,,0,0,0,,Мен Такума-кунның сөзіне сене алмаймын.
Dialogue: 0,0:19:16.94,0:19:19.57,Default,,0,0,0,,Әрбір тағам «дәмді» деп айтылады.
Dialogue: 0,0:19:19.65,0:19:23.24,Default,,0,0,0,,Сондай-ақ терчин, папа, әке...
Dialogue: 0,0:19:23.32,0:19:25.83,Default,,0,0,0,,Шешуге біраз уақыт керек сияқты.
Dialogue: 0,0:19:25.91,0:19:28.87,Default,,0,0,0,,Олардың барлығын қолдануға тырысу да таңдау болып табылады.
Dialogue: 0,0:19:28.95,0:19:33.71,Default,,0,0,0,,Дарлинг, сен, сен, Так-кун, Таку-чан, Таку-пён...
Dialogue: 0,0:19:34.33,0:19:37.34,Default,,0,0,0,,Өмір шексіз Өмір шексіз өмір... Солай сияқты.
Dialogue: 0,0:19:40.17,0:19:41.84,Default,,0,0,0,,(Сағаттың секунд тілі дыбысы)
Dialogue: 0,0:19:42.51,0:19:44.64,Default,,0,0,0,,Мамору да шаршаған сияқты.
Dialogue: 0,0:19:44.72,0:19:46.85,Default,,0,0,0,,Бүгін көңілді күн болды
Dialogue: 0,0:19:46.93,0:19:49.77,Default,,0,0,0,,Сіз де шаршаған жоқсыз ба?
Dialogue: 0,0:19:49.85,0:19:51.60,Default,,0,0,0,,Хаха... Жарайды.
Dialogue: 0,0:19:52.39,0:19:54.69,Default,,0,0,0,,-Ұйықтаймыз. -(Мина) Иә.
Dialogue: 0,0:19:54.77,0:19:57.27,Default,,0,0,0,,-Қайырлы түн - (Мина) Қайырлы түн
Dialogue: 0,0:20:03.41,0:20:04.62,Default,,0,0,0,,(шу)
Dialogue: 0,0:20:07.87,0:20:10.79,Default,,0,0,0,,Жаңа өмір басталады
Dialogue: 0,0:20:13.29,0:20:16.38,Default,,0,0,0,,Ууу~
Dialogue: 0,0:20:46.99,0:20:48.78,Default,,0,0,0,,Ня~
Dialogue: 0,0:21:22.94,0:21:26.28,Default,,0,0,0,,Такума Таң атты. Оян, Такума.
Dialogue: 0,0:21:26.36,0:21:27.95,Default,,0,0,0,,Оян!
Dialogue: 0,0:21:28.03,0:21:32.45,Default,,0,0,0,,Хмм... мм...
Dialogue: 0,0:21:33.50,0:21:37.29,Default,,0,0,0,,Ммм~ Ахх
Dialogue: 0,0:21:40.25,0:21:43.55,Default,,0,0,0,,Соңында менің атым...
Dialogue: 0,0:21:47.30,0:21:48.47,Default,,0,0,0,,Мина-чан
Dialogue: 0,0:21:49.47,0:21:50.60,Default,,0,0,0,,Мамору-кун
Dialogue: 0,0:21:50.68,0:21:52.60,Default,,0,0,0,,Охайо Такума
Dialogue: 0,0:21:57.02,0:22:00.19,Default,,0,0,0,,Қайырлы таң Такума-сама
Dialogue: 0,0:22:03.32,0:22:04.53,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:22:06.07,0:22:11.07,Default,,0,0,0,,♪～
Dialogue: 0,0:23:34.45,0:23:39.45,Default,,0,0,0,,～♪
