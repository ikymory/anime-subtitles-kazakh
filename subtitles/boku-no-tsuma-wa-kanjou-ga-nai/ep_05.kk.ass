Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.00,0:00:09.21,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:00:09.30,0:00:11.05,Default,,0,0,0,,37 градус 5 минут
Dialogue: 0,0:00:11.13,0:00:12.84,Default,,0,0,0,,Сіздің қызуыңыз аздап көтерілген сияқты.
Dialogue: 0,0:00:12.92,0:00:13.93,Default,,0,0,0,,Хмм
Dialogue: 0,0:00:14.55,0:00:16.05,Default,,0,0,0,,Ауыр болмас бұрын
Dialogue: 0,0:00:16.14,0:00:18.76,Default,,0,0,0,,...
Dialogue: 0,0:00:18.85,0:00:21.43,Default,,0,0,0,,...
Dialogue: 0,0:00:22.39,0:00:24.31,Default,,0,0,0,,Мен аламын
Dialogue: 0,0:00:24.39,0:00:26.81,Default,,0,0,0,,О... Иә?
Dialogue: 0,0:00:27.40,0:00:30.03,Default,,0,0,0,,Е... а... күте тұрыңыз...
Dialogue: 0,0:00:30.11,0:00:31.57,Default,,0,0,0,,Саңырау?
Dialogue: 0,0:00:31.65,0:00:34.45,Default,,0,0,0,,...
Dialogue: 0,0:00:34.53,0:00:37.78,Default,,0,0,0,,...
Dialogue: 0,0:00:37.87,0:00:41.16,Default,,0,0,0,,Бұл жер қытырлақ
Dialogue: 0,0:00:42.12,0:00:44.37,Default,,0,0,0,,Ол маған ботқа дайындады.
Dialogue: 0,0:00:44.46,0:00:46.12,Default,,0,0,0,,Рахмет
Dialogue: 0,0:00:47.38,0:00:49.25,Default,,0,0,0,,Мен оны аламын...
Dialogue: 0,0:00:50.21,0:00:52.76,Default,,0,0,0,,Ми... Мина-чан?
Dialogue: 0,0:00:56.09,0:00:58.05,Default,,0,0,0,,Мен өзімді жақсы сезінбеймін...
Dialogue: 0,0:01:00.47,0:01:02.14,Default,,0,0,0,,Қайтадан табылды
Dialogue: 0,0:01:02.22,0:01:04.85,Default,,0,0,0,,Бұл жерде де қытырлақ.
Dialogue: 0,0:01:04.93,0:01:06.77,Default,,0,0,0,,Минахян...
Dialogue: 0,0:01:10.86,0:01:12.03,Default,,0,0,0,,Мина-чан
Dialogue: 0,0:01:12.65,0:01:13.65,Default,,0,0,0,,Иә
Dialogue: 0,0:01:13.74,0:01:16.91,Default,,0,0,0,,Өтінемін, менің бөксесіме қол тигізуді тоқтата аласыз ба?
Dialogue: 0,0:01:18.82,0:01:20.37,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:01:20.99,0:01:26.66,Default,,0,0,0,,♪～
Dialogue: 0,0:02:44.53,0:02:49.54,Default,,0,0,0,,～♪
Dialogue: 0,0:02:52.42,0:02:53.42,Default,,0,0,0,,Дәл...
Dialogue: 0,0:02:53.50,0:02:55.75,Default,,0,0,0,,Ұзақ өмір сүрудің сыры неде?
Dialogue: 0,0:02:55.84,0:02:58.17,Default,,0,0,0,,Әр таң сайын қайырлы таңмен әйеліңізді сүйіңіз
Dialogue: 0,0:02:58.26,0:03:00.09,Default,,0,0,0,,Мен сені оятуыңды сұраймын.
Dialogue: 0,0:03:00.18,0:03:02.01,Default,,0,0,0,,Мен өзімді жігерлі сезінемін.
Dialogue: 0,0:03:02.09,0:03:04.26,Default,,0,0,0,,Уау, бұл тамаша.
Dialogue: 0,0:03:04.35,0:03:06.18,Default,,0,0,0,,Сізге қандай сүйіспеншілік келеді?
Dialogue: 0,0:03:06.26,0:03:08.81,Default,,0,0,0,,Маңдайдан қаққандай...
Dialogue: 0,0:03:09.39,0:03:10.44,Default,,0,0,0,,Ах, мен аштан қарип кеттім.
Dialogue: 0,0:03:11.19,0:03:13.23,Default,,0,0,0,,Бүгінгі жақсы жұптар бұрышы
Dialogue: 0,0:03:13.23,0:03:13.65,Default,,0,0,0,,...
Dialogue: 0,0:03:13.23,0:03:13.65,Default,,0,0,0,,Тағы бір Қан Құбыжық Өнері ме?
Dialogue: 0,0:03:13.65,0:03:13.73,Default,,0,0,0,,Тағы бір Қан Құбыжық Өнері ме?
Dialogue: 0,0:03:13.73,0:03:15.57,Default,,0,0,0,,Тағы бір Қан Құбыжық Өнері ме?
Dialogue: 0,0:03:13.73,0:03:15.57,Default,,0,0,0,,Олар тамаша жұп болды.
Dialogue: 0,0:03:15.65,0:03:17.32,Default,,0,0,0,,Ештеңе
Dialogue: 0,0:03:18.11,0:03:19.32,Default,,0,0,0,,Нгю!
Dialogue: 0,0:03:20.57,0:03:23.20,Default,,0,0,0,,О, о...
Dialogue: 0,0:03:23.28,0:03:25.16,Default,,0,0,0,,Әйтеуір, ол жақында ғана қорқынышты сынақтан өтті
Dialogue: 0,0:03:25.24,0:03:26.99,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:03:27.08,0:03:28.70,Default,,0,0,0,,Қайырлы таң...
Dialogue: 0,0:03:30.00,0:03:32.21,Default,,0,0,0,,Бұл – жеңіске арналған тұрып қошемет!
Dialogue: 0,0:03:32.29,0:03:34.21,Default,,0,0,0,,Таңғы ас дайында
Dialogue: 0,0:03:34.75,0:03:35.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:38.00,0:03:39.55,Default,,0,0,0,,Ха! Мүмкін...
Dialogue: 0,0:03:40.72,0:03:42.55,Default,,0,0,0,,Менің сиқырлы күшім артып келеді…
Dialogue: 0,0:03:43.26,0:03:44.68,Default,,0,0,0,,Қорқынышты...
Dialogue: 0,0:03:45.26,0:03:46.93,Default,,0,0,0,,Үшеуі де дәл бірдей жағдайда қаза тапты.
Dialogue: 0,0:03:47.68,0:03:50.18,Default,,0,0,0,,Мен ашуланатын бірдеңе жасадым ба...
Dialogue: 0,0:03:50.27,0:03:52.64,Default,,0,0,0,,Такума-сама, мен оған қамқор боламын.
Dialogue: 0,0:03:52.73,0:03:54.19,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:54.27,0:03:57.19,Default,,0,0,0,,...
Dialogue: 0,0:03:57.27,0:03:58.82,Default,,0,0,0,,Таяқ жегенге не жетсін...
Dialogue: 0,0:04:05.07,0:04:07.03,Default,,0,0,0,,Менің жаным… Ұйықтар алдында әр түн сайын➡
Dialogue: 0,0:04:07.12,0:04:09.08,Default,,0,0,0,,Itte Itte…
Dialogue: 0,0:04:09.16,0:04:10.95,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:04:11.04,0:04:13.04,Default,,0,0,0,,Мен істей алатын бірдеңе бар ма?
Dialogue: 0,0:04:13.12,0:04:16.79,Default,,0,0,0,,Ух... аа... мм...
Dialogue: 0,0:04:16.88,0:04:19.63,Default,,0,0,0,,Бетімнен сүйсең
Dialogue: 0,0:04:19.71,0:04:21.84,Default,,0,0,0,,Жақын арада жағдай жақсаратын шығар...
Dialogue: 0,0:04:21.92,0:04:23.55,Default,,0,0,0,,Не… хаха…
Dialogue: 0,0:04:24.51,0:04:26.05,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:04:26.68,0:04:28.05,Default,,0,0,0,,Қуа келе жатқандар кетті.
Dialogue: 0,0:04:29.06,0:04:31.81,Default,,0,0,0,,Сіз мұны мен үшін жасайсыз ба?
Dialogue: 0,0:04:32.64,0:04:35.10,Default,,0,0,0,,Ах! Хэхе~
Dialogue: 0,0:04:35.19,0:04:36.31,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:04:36.40,0:04:37.56,Default,,0,0,0,,Дәл…
Dialogue: 0,0:04:37.65,0:04:38.82,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:04:38.90,0:04:40.32,Default,,0,0,0,,Ах~
Dialogue: 0,0:04:41.57,0:04:43.61,Default,,0,0,0,,меніңше, бұл – нағыз ақымақтық шыңы… Яғни—
Dialogue: 0,0:04:44.40,0:04:47.62,Default,,0,0,0,,...
Dialogue: 0,0:04:48.20,0:04:49.91,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:04:49.99,0:04:52.12,Default,,0,0,0,,Ах... Ха!
Dialogue: 0,0:04:52.20,0:04:54.04,Default,,0,0,0,,Мүмкін поцелу!?
Dialogue: 0,0:04:54.12,0:04:55.83,Default,,0,0,0,,Таңертең мені сүйдің бе?
Dialogue: 0,0:04:55.92,0:04:57.13,Default,,0,0,0,,Мен жасадым
Dialogue: 0,0:04:57.21,0:05:00.88,Default,,0,0,0,,Рұқсатсыз сүйгенім үшін кешір.
Dialogue: 0,0:05:01.67,0:05:03.46,Default,,0,0,0,,Таңертең әйелім мені сүйгенде
Dialogue: 0,0:05:03.55,0:05:06.01,Default,,0,0,0,,...
Dialogue: 0,0:05:06.09,0:05:08.89,Default,,0,0,0,,Түсіндім.
Dialogue: 0,0:05:08.97,0:05:11.72,Default,,0,0,0,,...
Dialogue: 0,0:05:11.81,0:05:13.64,Default,,0,0,0,,Мен сенің маған мейірімді болғаныңды қалаймын.
Dialogue: 0,0:05:14.23,0:05:17.23,Default,,0,0,0,,Осылай... Чоң сезім.
Dialogue: 0,0:05:17.31,0:05:20.40,Default,,0,0,0,,...
Dialogue: 0,0:05:20.48,0:05:24.49,Default,,0,0,0,,Негізінде бұл маңызды емес. Қысым
Dialogue: 0,0:05:24.57,0:05:25.90,Default,,0,0,0,,Байланысты болмаса да
Dialogue: 0,0:05:25.99,0:05:29.53,Default,,0,0,0,,...
Dialogue: 0,0:05:30.74,0:05:33.75,Default,,0,0,0,,...
Dialogue: 0,0:05:33.83,0:05:36.04,Default,,0,0,0,,“”
Dialogue: 0,0:05:36.12,0:05:39.04,Default,,0,0,0,,Ах, мм...
Dialogue: 0,0:05:39.13,0:05:41.67,Default,,0,0,0,,Мм... мм...
Dialogue: 0,0:05:41.75,0:05:43.34,Default,,0,0,0,,Бұл қиын ба?
Dialogue: 0,0:05:43.42,0:05:45.80,Default,,0,0,0,,Ол қанша Ньютонға соғуы керек?
Dialogue: 0,0:05:45.88,0:05:49.43,Default,,0,0,0,,Мен шынымен де тырысамын ...
Dialogue: 0,0:05:50.05,0:05:51.30,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:05:53.43,0:05:55.52,Default,,0,0,0,,Бұл өте жақсы идея.
Dialogue: 0,0:05:55.60,0:05:56.85,Default,,0,0,0,,Қандай әдемі бауырлық байланыс! Қалай әсерлі.
Dialogue: 0,0:05:57.89,0:05:59.77,Default,,0,0,0,,Қазір орындаңыз
Dialogue: 0,0:05:59.85,0:06:02.44,Default,,0,0,0,,Жоқ... жоқ! Бірақ менің алғашқы сүйісім
Dialogue: 0,0:06:02.52,0:06:04.07,Default,,0,0,0,,Бұл дұрыс па?
Dialogue: 0,0:06:04.15,0:06:06.03,Default,,0,0,0,,Бұл қалай сезінеді?
Dialogue: 0,0:06:06.65,0:06:08.53,Default,,0,0,0,,Ах... ммм...
Dialogue: 0,0:06:09.20,0:06:10.95,Default,,0,0,0,,Қаламайсыз ба?
Dialogue: 0,0:06:11.03,0:06:12.78,Default,,0,0,0,,Мен ақылсыз нәрсе жасағым келеді
Dialogue: 0,0:06:12.87,0:06:16.04,Default,,0,0,0,,Егер мұны істеу мүмкін емес себебі болса, маған хабарлаңыз.
Dialogue: 0,0:06:16.12,0:06:17.54,Default,,0,0,0,,Себеп…
Dialogue: 0,0:06:17.62,0:06:19.67,Default,,0,0,0,,Хмм... шынымен емес...
Dialogue: 0,0:06:19.75,0:06:22.04,Default,,0,0,0,,Олай болмаса, тез орындаңыз.
Dialogue: 0,0:06:22.13,0:06:23.42,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:06:24.13,0:06:26.92,Default,,0,0,0,,Ал... кеттік.
Dialogue: 0,0:06:30.51,0:06:33.43,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:06:36.22,0:06:38.98,Default,,0,0,0,,Қуат беретін маңдайың емес пе?
Dialogue: 0,0:06:39.06,0:06:41.31,Default,,0,0,0,,Ах! Кешіріңіз...
Dialogue: 0,0:06:41.40,0:06:43.44,Default,,0,0,0,,Мен мұны қалаған жерде жасадым.
Dialogue: 0,0:06:43.52,0:06:44.94,Default,,0,0,0,,Бірақ... Бірақ...
Dialogue: 0,0:06:45.02,0:06:47.44,Default,,0,0,0,,Сіз қай жерде сүйсеңіз де, өзіңізді жақсы сезінесіз
Dialogue: 0,0:06:48.07,0:06:51.20,Default,,0,0,0,,Ерніңізді ұрып-соғу арқылы...
Dialogue: 0,0:06:52.12,0:06:56.41,Default,,0,0,0,,Мен сені ұнататын сияқтымын және бұл маған қуат береді...
Dialogue: 0,0:06:57.87,0:07:00.71,Default,,0,0,0,,Нәзік шырышты қабаттармен жанасу арқылы
Dialogue: 0,0:07:00.79,0:07:03.29,Default,,0,0,0,,Жақындықты білдіретін қарым-қатынас…
Dialogue: 0,0:07:03.38,0:07:05.17,Default,,0,0,0,,Дәл осыны айтқың келе ме?
Dialogue: 0,0:07:05.25,0:07:06.34,Default,,0,0,0,,(жөтел жөтел)
Dialogue: 0,0:07:06.42,0:07:08.55,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:07:08.63,0:07:10.88,Default,,0,0,0,,! Мина қалай болды?
Dialogue: 0,0:07:10.97,0:07:12.89,Default,,0,0,0,,Сүйген кезде қандай сезім болады?
Dialogue: 0,0:07:12.97,0:07:14.64,Default,,0,0,0,,Сізге ұнамады ма?
Dialogue: 0,0:07:15.22,0:07:16.64,Default,,0,0,0,,Маған ұнамайды, бірақ
Dialogue: 0,0:07:16.72,0:07:19.14,Default,,0,0,0,,Мен өзімді энергиямен сезіну дегенді түсінбеймін.
Dialogue: 0,0:07:19.89,0:07:23.86,Default,,0,0,0,,Менің қабақтарымнан басқа бетім шайырдан жасалған.
Dialogue: 0,0:07:23.94,0:07:27.15,Default,,0,0,0,,Маңдайыңызда немесе ерніңізде сенсорлар жоқ.
Dialogue: 0,0:07:27.86,0:07:29.69,Default,,0,0,0,,Такума-сама мені сүйсе де
Dialogue: 0,0:07:29.78,0:07:32.95,Default,,0,0,0,,Тек буын бөліктеріне қысымды сезіну
Dialogue: 0,0:07:35.03,0:07:36.28,Default,,0,0,0,,Менің істегенім болды
Dialogue: 0,0:07:36.99,0:07:39.33,Default,,0,0,0,,Тек қатты шайырлы пластинаны соғу арқылы
Dialogue: 0,0:07:39.41,0:07:41.29,Default,,0,0,0,,Бұл сүйісу емес пе?
Dialogue: 0,0:07:42.08,0:07:45.04,Default,,0,0,0,,Кешіріңіз, менде шырышты қабық жоқ.
Dialogue: 0,0:07:46.42,0:07:48.09,Default,,0,0,0,,Бұл кешірім сұрау туралы емес.
Dialogue: 0,0:07:48.63,0:07:51.30,Default,,0,0,0,,Мүмкін бұл жай ғана ауырған шығар?
Dialogue: 0,0:07:51.84,0:07:53.97,Default,,0,0,0,,Ех! Жоқ, бұл... мм...
Dialogue: 0,0:07:54.05,0:07:56.30,Default,,0,0,0,,Ауырды, бірақ...
Dialogue: 0,0:07:57.14,0:07:59.06,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:59.72,0:08:00.93,Default,,0,0,0,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,0:08:05.23,0:08:07.19,Default,,0,0,0,,Сенің мені сүйгеніңді білгенде
Dialogue: 0,0:08:07.27,0:08:08.94,Default,,0,0,0,,Мен сондай бақытты болдым.
Dialogue: 0,0:08:09.65,0:08:10.90,Default,,0,0,0,,Бұл жаман емес.
Dialogue: 0,0:08:11.49,0:08:14.20,Default,,0,0,0,,Себебі менің сүйгім келетін жалғыз адам - ​​Мина Чан.
Dialogue: 0,0:08:15.66,0:08:18.45,Default,,0,0,0,,Қиын болса да, Ештеңені сезбесе де
Dialogue: 0,0:08:19.20,0:08:21.20,Default,,0,0,0,,Мен үшін Мина Чан дәл солай...
Dialogue: 0,0:08:22.12,0:08:24.33,Default,,0,0,0,,Дүниедегі ең жақсы
Dialogue: 0,0:08:27.67,0:08:30.46,Default,,0,0,0,,Мен көремін. Мен түссіндім.
Dialogue: 0,0:08:31.84,0:08:33.97,Default,,0,0,0,,Такума-сама сені қайтадан сүйгісі келгенде
Dialogue: 0,0:08:34.05,0:08:35.22,Default,,0,0,0,,Мұны кез келген уақытта орындаңыз
Dialogue: 0,0:08:35.30,0:08:36.51,Default,,0,0,0,,Иә
Dialogue: 0,0:08:36.59,0:08:39.39,Default,,0,0,0,,Мен де сені қайырлы таң сүйсем бе?
Dialogue: 0,0:08:39.47,0:08:40.47,Default,,0,0,0,,Мүмкін болса...
Dialogue: 0,0:08:41.31,0:08:42.98,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:08:43.06,0:08:45.23,Default,,0,0,0,,Ах! Мен сенімдімін...
Dialogue: 0,0:08:45.31,0:08:47.73,Default,,0,0,0,,Мұнда өнімділігі жоғары сенсор бар, солай ма?
Dialogue: 0,0:08:50.02,0:08:51.61,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:52.40,0:08:53.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:55.03,0:08:56.49,Default,,0,0,0,,Ештеңе
Dialogue: 0,0:08:57.11,0:08:58.24,Default,,0,0,0,,«Ах» деген не?
Dialogue: 0,0:08:58.87,0:08:59.99,Default,,0,0,0,,(Тсубаки) Дегенмен, Косэйдің аяғына зақым келгеніне қуаныштымын—
Dialogue: 0,0:09:00.08,0:09:02.12,Default,,0,0,0,,Дәл қазір қолыңды сүйсем, "Ах" дейсің...
Dialogue: 0,0:09:02.20,0:09:03.37,Default,,0,0,0,,(есік қоңырауының дыбысы)
Dialogue: 0,0:09:03.45,0:09:04.50,Default,,0,0,0,,Е...
Dialogue: 0,0:09:04.58,0:09:05.87,Default,,0,0,0,,Мен келушімін.
Dialogue: 0,0:09:06.83,0:09:08.83,Default,,0,0,0,,Қайырлы таң!
Dialogue: 0,0:09:08.92,0:09:11.09,Default,,0,0,0,,Мен Лихт Сайонджиден тапсырмамен келдім.
Dialogue: 0,0:09:11.17,0:09:12.88,Default,,0,0,0,,Бұл Супер Мина!
Dialogue: 0,0:09:17.47,0:09:20.14,Default,,0,0,0,,Теңізде Рахмет!
Dialogue: 0,0:09:20.76,0:09:22.93,Default,,0,0,0,,Не? Супер Мина Чан!?
Dialogue: 0,0:09:23.02,0:09:25.39,Default,,0,0,0,,Қайырлы таң, Такума-сама.
Dialogue: 0,0:09:25.48,0:09:26.64,Default,,0,0,0,,Қайырлы таң...
Dialogue: 0,0:09:26.73,0:09:27.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:27.98,0:09:30.61,Default,,0,0,0,,Дұрысы, менің мекен-жайымды қайдан білесің?
Dialogue: 0,0:09:30.69,0:09:34.61,Default,,0,0,0,,Хехехе... Тамаша сұрадыңыз!
Dialogue: 0,0:09:34.69,0:09:38.45,Default,,0,0,0,,Не! Mina сериясы үшін сізге тек жеке куәлігіңізбен алмасу жеткілікті.
Dialogue: 0,0:09:38.53,0:09:41.12,Default,,0,0,0,,Интернет арқылы байланысуға болады!
Dialogue: 0,0:09:41.74,0:09:43.74,Default,,0,0,0,,Біз теңізде кездескеннен кейін
Dialogue: 0,0:09:43.83,0:09:47.08,Default,,0,0,0,,Үзіліс кезінде жылдамдық қалыпты сөйлесуден бірнеше жүз есе жоғары.
Dialogue: 0,0:09:47.16,0:09:49.71,Default,,0,0,0,,Біз күнде сөйлесеміз!
Dialogue: 0,0:09:50.21,0:09:51.25,Default,,0,0,0,,Хехе…
Dialogue: 0,0:09:51.34,0:09:54.76,Default,,0,0,0,,Кез келген жағдайда сен Минамен менен артық сөйлесіп тұрған жоқсың ба?
Dialogue: 0,0:09:54.84,0:09:57.55,Default,,0,0,0,,Келетініңді хабарлап жіберсеңші.
Dialogue: 0,0:09:57.63,0:09:59.89,Default,,0,0,0,,Қыздар арасындағы әңгіме – құпия
Dialogue: 0,0:09:59.97,0:10:00.97,Default,,0,0,0,,Тыныш
Dialogue: 0,0:10:01.05,0:10:02.64,Default,,0,0,0,,Уг! Гү! Гү!
Dialogue: 0,0:10:03.26,0:10:05.22,Default,,0,0,0,,Осы уақытқа дейін абдырап қалған жоқсыз ба?
Dialogue: 0,0:10:05.31,0:10:06.77,Default,,0,0,0,,Мен қойған сұрақтарға ғана жауап бер.
Dialogue: 0,0:10:06.85,0:10:11.40,Default,,0,0,0,,Құпиялылықты қорғау функциясы мекенжайыңызды тікелей растауға мүмкіндік бермейді.
Dialogue: 0,0:10:11.48,0:10:14.11,Default,,0,0,0,,Оны анықтау біршама қиын болды
Dialogue: 0,0:10:29.50,0:10:31.67,Default,,0,0,0,,Өте қызық сияқты
Dialogue: 0,0:10:33.21,0:10:36.13,Default,,0,0,0,,Сонымен... бүгін сіздің қандай кәсіппен айналысасыз?
Dialogue: 0,0:10:36.21,0:10:37.76,Default,,0,0,0,,Эхехе…
Dialogue: 0,0:10:37.84,0:10:40.05,Default,,0,0,0,,Негізі мен де өткен күні рахмет айтқым келді.
Dialogue: 0,0:10:40.13,0:10:42.93,Default,,0,0,0,,Мен сендерге жазғы құттықтаулар әкелдім.
Dialogue: 0,0:10:43.89,0:10:45.35,Default,,0,0,0,,Бұл екеуіңе де.
Dialogue: 0,0:10:45.43,0:10:46.43,Default,,0,0,0,,Бір ай бойы бірдей нәрсені естіп жүрсең, ештеңе сезбей қаласың.
Dialogue: 0,0:10:46.52,0:10:47.77,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:10:49.52,0:10:51.44,Default,,0,0,0,,Эй, бұл...
Dialogue: 0,0:10:51.52,0:10:54.48,Default,,0,0,0,,Тойларда алынған каталог сыйлықтары т.б.
Dialogue: 0,0:10:54.57,0:10:56.19,Default,,0,0,0,,Мина сериясының нұсқасы
Dialogue: 0,0:10:56.28,0:10:57.90,Default,,0,0,0,,А...
Dialogue: 0,0:10:59.70,0:11:02.70,Default,,0,0,0,,Иә? Супер мина…
Dialogue: 0,0:11:02.78,0:11:06.16,Default,,0,0,0,,Сіз тек бір шанағы бар қымбат көлікті немесе басқа нәрсені оңай сатып алатыныңызға сенімдімін...
Dialogue: 0,0:11:06.24,0:11:08.04,Default,,0,0,0,,100 ұпай...
Dialogue: 0,0:11:08.83,0:11:11.21,Default,,0,0,0,,Бір ұпай қанша тұрады?
Dialogue: 0,0:11:14.54,0:11:15.88,Default,,0,0,0,,- Мина-сан - (Супер Мина Мина) Иә.
Dialogue: 0,0:11:15.96,0:11:18.17,Default,,0,0,0,,Ах, а... жоқ, жоқ...
Dialogue: 0,0:11:19.72,0:11:21.18,Default,,0,0,0,,Мина Сайонжи!
Dialogue: 0,0:11:22.13,0:11:23.14,Default,,0,0,0,,Иә
Dialogue: 0,0:11:23.76,0:11:25.47,Default,,0,0,0,,Бұны қабылдауға болмайды.
Dialogue: 0,0:11:25.55,0:11:28.52,Default,,0,0,0,,Менің басқа Мина-чанды қарсы алу ойым жоқ.
Dialogue: 0,0:11:28.60,0:11:31.27,Default,,0,0,0,,Бұл баланың болуы жеткілікті
Dialogue: 0,0:11:31.35,0:11:32.85,Default,,0,0,0,,Е...
Dialogue: 0,0:11:32.94,0:11:37.27,Default,,0,0,0,,Каталогтың екінші жартысын қарап шыға аласыз ба?
Dialogue: 0,0:11:37.36,0:11:39.53,Default,,0,0,0,,-Екінші тайм? -(Супермина) Иә!
Dialogue: 0,0:11:39.61,0:11:42.28,Default,,0,0,0,,Mina сериялы бағдарламалық құрал жаңартулары және
Dialogue: 0,0:11:42.36,0:11:45.74,Default,,0,0,0,,Көптеген жаңарту бөліктері бар!
Dialogue: 0,0:11:46.62,0:11:49.12,Default,,0,0,0,,Иә, бұл керемет.
Dialogue: 0,0:11:49.20,0:11:50.79,Default,,0,0,0,,Көп нәрсе бар.
Dialogue: 0,0:11:53.37,0:11:55.79,Default,,0,0,0,,Иә? Сіз қалаған нәрсе болды ма?
Dialogue: 0,0:11:56.79,0:11:57.80,Default,,0,0,0,,Бұл?
Dialogue: 0,0:11:58.34,0:12:02.01,Default,,0,0,0,,Бет әлпеті бар толық дене жоғары сапалы силикон...
Dialogue: 0,0:12:02.72,0:12:06.64,Default,,0,0,0,,Менің Мина Чан Супер Мина Чан сияқты бола ала ма?
Dialogue: 0,0:12:06.72,0:12:09.39,Default,,0,0,0,,Иә? Ооооо...
Dialogue: 0,0:12:09.97,0:12:13.27,Default,,0,0,0,,Ішкі өнімділікті де айтарлықтай жақсартуға болады
Dialogue: 0,0:12:13.35,0:12:16.23,Default,,0,0,0,,Сондай-ақ 100 метр тереңдікке сүңгуге болады.
Dialogue: 0,0:12:16.31,0:12:18.32,Default,,0,0,0,,Иә... суға түспе.
Dialogue: 0,0:12:19.02,0:12:22.15,Default,,0,0,0,,Мм... Мина-чанның жүзінде бір өрнек бар.
Dialogue: 0,0:12:22.24,0:12:24.28,Default,,0,0,0,,Ол қатты бола ма?
Dialogue: 0,0:12:24.36,0:12:27.87,Default,,0,0,0,,Мен өзімді бақытты сезінемін, өзімді жалғыз сезінемін ...
Dialogue: 0,0:12:29.16,0:12:31.16,Default,,0,0,0,,Ха! Жоқ, жоқ!
Dialogue: 0,0:12:32.25,0:12:35.54,Default,,0,0,0,,Кешіріңіз! Мен мұны әлі қабылдай алмаймын
Dialogue: 0,0:12:35.62,0:12:37.04,Default,,0,0,0,,Бұл жаман емес.
Dialogue: 0,0:12:37.13,0:12:40.30,Default,,0,0,0,,Е... бұл өте қымбат және оны алуға ешқандай себеп жоқ.
Dialogue: 0,0:12:40.88,0:12:44.01,Default,,0,0,0,,Заң ешқандай себепсіз қымбат заттарды алуға тыйым салады.
Dialogue: 0,0:12:44.09,0:12:45.30,Default,,0,0,0,,Болуы керек емес пе?
Dialogue: 0,0:12:45.38,0:12:47.30,Default,,0,0,0,,Жарайды... дұрыс, бірақ
Dialogue: 0,0:12:47.39,0:12:50.31,Default,,0,0,0,,Мен оны эмоционалды түрде қабылдай алмаймын.
Dialogue: 0,0:12:54.31,0:12:55.81,Default,,0,0,0,,Тору, менімен бірге жүр. (Ишикава) Ээ…
Dialogue: 0,0:12:55.90,0:12:57.40,Default,,0,0,0,,Бұл себеп.
Dialogue: 0,0:12:57.48,0:12:58.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:58.65,0:13:00.27,Default,,0,0,0,,Лихт мырза...
Dialogue: 0,0:13:00.36,0:13:03.57,Default,,0,0,0,,Менің қожайыным мүлде емес...
Dialogue: 0,0:13:03.65,0:13:07.07,Default,,0,0,0,,Менің достарым жоқ!
Dialogue: 0,0:13:07.16,0:13:09.07,Default,,0,0,0,,Ә? Шынында ма?
Dialogue: 0,0:13:09.16,0:13:11.54,Default,,0,0,0,,Иә! Тек роботтар мен мысықтар
Dialogue: 0,0:13:11.62,0:13:13.50,Default,,0,0,0,,Айтайын дегенім, мені қызықтырмайды...
Dialogue: 0,0:13:13.58,0:13:16.00,Default,,0,0,0,,Мен мысықтарды жақсы көремін
Dialogue: 0,0:13:16.08,0:13:20.42,Default,,0,0,0,,Біз қаңғыбас мысықтарды құтқарамыз және оларға жаңа иелерін табамыз.
Dialogue: 0,0:13:20.50,0:13:22.63,Default,,0,0,0,,Өзімнің қалталы ақшама салынған үйде
Dialogue: 0,0:13:22.71,0:13:26.43,Default,,0,0,0,,Сіз маған күнде қамқорлық жасайсыз, бұл шынымен де таңданарлық...
Dialogue: 0,0:13:26.51,0:13:28.05,Default,,0,0,0,,Ах! Бірақ...
Dialogue: 0,0:13:28.14,0:13:30.51,Default,,0,0,0,,Мен өз жасымдағы балалармен мүлде ойнамаймын.
Dialogue: 0,0:13:30.51,0:13:31.26,Default,,0,0,0,,Мен өз жасымдағы балалармен мүлде ойнамаймын.
Dialogue: 0,0:13:30.51,0:13:31.26,Default,,0,0,0,,Ах... у... иә...
Dialogue: 0,0:13:31.26,0:13:31.35,Default,,0,0,0,,Ах... у... иә...
Dialogue: 0,0:13:31.35,0:13:33.68,Default,,0,0,0,,Ах... у... иә...
Dialogue: 0,0:13:31.35,0:13:33.68,Default,,0,0,0,,Олар үйдегі қызметшілерді мүлде елемейді.
Dialogue: 0,0:13:33.68,0:13:34.18,Default,,0,0,0,,Олар үйдегі қызметшілерді мүлде елемейді.
Dialogue: 0,0:13:34.18,0:13:34.52,Default,,0,0,0,,Олар үйдегі қызметшілерді мүлде елемейді.
Dialogue: 0,0:13:34.18,0:13:34.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:34.52,0:13:34.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:34.60,0:13:36.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:34.60,0:13:36.10,Default,,0,0,0,,Бұл қорқынышты, солай емес пе?
Dialogue: 0,0:13:36.19,0:13:38.81,Default,,0,0,0,,Маған ата-анам ұнайды.
Dialogue: 0,0:13:38.90,0:13:43.11,Default,,0,0,0,,Екеуің де жұмыстасыңдар, үйге жиі келмейсіңдер.
Dialogue: 0,0:13:43.19,0:13:48.28,Default,,0,0,0,,Сондықтан мен және мысықтан басқа сөйлесетін ешкім жоқтың қасы.
Dialogue: 0,0:13:48.36,0:13:51.33,Default,,0,0,0,,А, мен адам емеспін, бірақ...
Dialogue: 0,0:13:51.41,0:13:53.41,Default,,0,0,0,,А, мысықтар да адам емес.
Dialogue: 0,0:13:53.49,0:13:57.41,Default,,0,0,0,,Бірақ мысықтар сіздің сезімдеріңізді шынымен түсіне алады.
Dialogue: 0,0:13:57.50,0:13:59.75,Default,,0,0,0,,Сонымен... неге?
Dialogue: 0,0:14:00.29,0:14:02.84,Default,,0,0,0,,Ах! Ал...
Dialogue: 0,0:14:04.21,0:14:07.26,Default,,0,0,0,,Адамдардың жағажайда барлығымен тіл табысуы туралы фильм.
Dialogue: 0,0:14:07.34,0:14:11.35,Default,,0,0,0,,Анама көрсеткенімде, ол қатты қуанды...
Dialogue: 0,0:14:11.43,0:14:14.10,Default,,0,0,0,,-Ол үшін рахмет? -(Супермина) Иә!
Dialogue: 0,0:14:14.93,0:14:18.85,Default,,0,0,0,,Бірақ... бәрібір қымбат...
Dialogue: 0,0:14:18.94,0:14:22.36,Default,,0,0,0,,Бұл да... проблема емес.
Dialogue: 0,0:14:22.44,0:14:24.36,Default,,0,0,0,,Лихт-саманың үйі
Dialogue: 0,0:14:24.44,0:14:27.36,Default,,0,0,0,,Өйткені мен өте баймын!
Dialogue: 0,0:14:27.95,0:14:31.99,Default,,0,0,0,,Бұл мизу йоканның ассортименті сияқты сыйлық сияқты.
Dialogue: 0,0:14:32.07,0:14:33.62,Default,,0,0,0,,Бір нәрсе
Dialogue: 0,0:14:33.70,0:14:34.87,Default,,0,0,0,,Су йокан?
Dialogue: 0,0:14:34.95,0:14:38.46,Default,,0,0,0,,Сондықтан оны қабылдасаңыз жақсы.
Dialogue: 0,0:14:38.54,0:14:40.92,Default,,0,0,0,,Жоқ... бұл дұрыс емес.
Dialogue: 0,0:14:41.00,0:14:42.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:42.59,0:14:44.34,Default,,0,0,0,,Бай болсаң да
Dialogue: 0,0:14:44.42,0:14:46.51,Default,,0,0,0,,Мен көп жылдар бойы қатты еңбек еттім.
Dialogue: 0,0:14:46.59,0:14:49.88,Default,,0,0,0,,Ештеңе сатып алуға ақшам да жоқ.
Dialogue: 0,0:14:51.43,0:14:53.76,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:14:54.47,0:14:57.52,Default,,0,0,0,,Кешіріңіз, бірақ Мина түсіне ме?
Dialogue: 0,0:15:01.44,0:15:03.77,Default,,0,0,0,,-(Мина) Түсіндім -(Супермина) А...
Dialogue: 0,0:15:07.48,0:15:08.61,Default,,0,0,0,,Қуа келе жатқандар кетті.
Dialogue: 0,0:15:08.69,0:15:10.40,Default,,0,0,0,,Не болды, Мина Чан?
Dialogue: 0,0:15:10.49,0:15:12.41,Default,,0,0,0,,Интернеттегі ақпарат
Dialogue: 0,0:15:12.49,0:15:18.41,Default,,0,0,0,,Ерлі-зайыптылардың неке кезінде алған мүлкі екіге бөлінеді.
Dialogue: 0,0:15:18.50,0:15:20.08,Default,,0,0,0,,Э? Не? Мен тыңдамаппын.
Dialogue: 0,0:15:20.16,0:15:22.50,Default,,0,0,0,,Сондықтан, Такума мырза үшін,
Dialogue: 0,0:15:22.58,0:15:24.59,Default,,0,0,0,,Біз сізге бірінші жартысын береміз.
Dialogue: 0,0:15:24.67,0:15:25.92,Default,,0,0,0,,Камадо!
Dialogue: 0,0:15:27.21,0:15:28.92,Default,,0,0,0,,Бірінші жарты...
Dialogue: 0,0:15:29.76,0:15:31.97,Default,,0,0,0,,Қалған жартысы менікі.
Dialogue: 0,0:15:32.05,0:15:34.18,Default,,0,0,0,,Жоқ... жоқ, бірақ...
Dialogue: 0,0:15:34.85,0:15:38.56,Default,,0,0,0,,Мен нағыз әйел болмағандықтан құқығым жоқ па?
Dialogue: 0,0:15:38.64,0:15:40.81,Default,,0,0,0,,Уф! мен...
Dialogue: 0,0:15:41.85,0:15:43.19,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:15:43.77,0:15:45.81,Default,,0,0,0,,Сіз өзіңізге ұнайтын нәрсені жасай аласыз.
Dialogue: 0,0:15:46.48,0:15:48.82,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:48.90,0:15:51.24,Default,,0,0,0,,Саған жақсы, Мина-сан.
Dialogue: 0,0:15:51.32,0:15:52.32,Default,,0,0,0,,Иә
Dialogue: 0,0:15:53.70,0:15:56.58,Default,,0,0,0,,А... а... мен оны басып қалдым.
Dialogue: 0,0:15:56.66,0:15:58.45,Default,,0,0,0,,Тағы кім болуы мүмкін?
Dialogue: 0,0:15:58.54,0:16:01.16,Default,,0,0,0,,Негізі бұл да сыйлық.
Dialogue: 0,0:16:01.91,0:16:04.00,Default,,0,0,0,,Ішінде не бар?
Dialogue: 0,0:16:04.08,0:16:06.84,Default,,0,0,0,,Эхехе... мінекей...
Dialogue: 0,0:16:07.46,0:16:09.55,Default,,0,0,0,,Такума-саманың туған күніне тосынсый
Dialogue: 0,0:16:09.63,0:16:12.09,Default,,0,0,0,,Өте жақсы болмады деп естідім.
Dialogue: 0,0:16:13.26,0:16:15.59,Default,,0,0,0,,Мен бұл туралы өзінше ойладым.
Dialogue: 0,0:16:16.18,0:16:17.60,Default,,0,0,0,,Тосын сый да жақсы
Dialogue: 0,0:16:17.68,0:16:21.48,Default,,0,0,0,,Осындай әшекейлермен қызықты мереке өткізуге не жетсін!
Dialogue: 0,0:16:22.39,0:16:24.48,Default,,0,0,0,,Тосын...
Dialogue: 0,0:16:26.19,0:16:27.23,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:16:28.36,0:16:30.86,Default,,0,0,0,,Мина-чан? қайда?
Dialogue: 0,0:16:32.36,0:16:33.36,Default,,0,0,0,,Ах
Dialogue: 0,0:16:36.45,0:16:40.37,Default,,0,0,0,,(Ит айқайлайды)
Dialogue: 0,0:16:43.79,0:16:44.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:44.79,0:16:47.75,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:48.71,0:16:50.63,Default,,0,0,0,,Сіз таң қалдыңыз ба?
Dialogue: 0,0:16:50.71,0:16:51.80,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:16:51.88,0:16:53.97,Default,,0,0,0,,Сіздің сүйікті адамыңыздың туған күнінде
Dialogue: 0,0:16:54.05,0:16:57.34,Default,,0,0,0,,Мен интернеттен тосын сыйлардың жақсы екенін оқыдым.
Dialogue: 0,0:16:57.43,0:16:59.60,Default,,0,0,0,,Не? Таңқаларлық па?
Dialogue: 0,0:17:00.43,0:17:03.35,Default,,0,0,0,,Бұл мені таң қалдырды...
Dialogue: 0,0:17:05.69,0:17:06.73,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:17:06.81,0:17:08.44,Default,,0,0,0,,Крекерлер
Dialogue: 0,0:17:08.52,0:17:10.86,Default,,0,0,0,,Бөксеге жіпті тартқанда...
Dialogue: 0,0:17:11.69,0:17:14.49,Default,,0,0,0,,(Крекердің жарылған дыбысы)
Dialogue: 0,0:17:21.70,0:17:22.91,Default,,0,0,0,,Қуа келе жатқандар кетті.
Dialogue: 0,0:17:24.20,0:17:26.37,Default,,0,0,0,,Ми... Мина-сан!
Dialogue: 0,0:17:26.46,0:17:28.38,Default,,0,0,0,,Мина? Мина-чан!
Dialogue: 0,0:17:28.46,0:17:29.88,Default,,0,0,0,,Эмма! Рэй!
Dialogue: 0,0:17:29.96,0:17:33.38,Default,,0,0,0,,Не істеуім керек... Қоңырау шалсам да жауап бермейді
Dialogue: 0,0:17:34.05,0:17:38.72,Default,,0,0,0,,Мені таң қалдырған күйзеліс оның жұмысын уақытша тоқтатты.
Dialogue: 0,0:17:38.80,0:17:40.35,Default,,0,0,0,,Бірақ бәрібір!
Dialogue: 0,0:17:40.43,0:17:42.64,Default,,0,0,0,,Ол шамамен 60 секундтан кейін оралады.
Dialogue: 0,0:17:43.35,0:17:45.89,Default,,0,0,0,,Ішкі зақым мүлде жоқ
Dialogue: 0,0:17:45.98,0:17:48.52,Default,,0,0,0,,Ха... Жақсы.
Dialogue: 0,0:17:48.60,0:17:50.40,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:17:50.48,0:17:51.65,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:17:52.32,0:17:54.69,Default,,0,0,0,,Сен аман болсаң... жақсы.
Dialogue: 0,0:18:01.78,0:18:04.45,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:18:04.54,0:18:06.83,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:18:10.67,0:18:11.84,Default,,0,0,0,,Мина-чан
Dialogue: 0,0:18:11.92,0:18:16.26,Default,,0,0,0,,Екеуміз жақсылап ойланып, қайсысын таңдағанымызды қалаймын.
Dialogue: 0,0:18:16.34,0:18:17.34,Default,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:18:18.09,0:18:20.05,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:18:20.14,0:18:21.97,Default,,0,0,0,,Сіз өзіңізге ұнайтын нәрсені қолдануға болады дедіңіз.
Dialogue: 0,0:18:22.05,0:18:25.06,Default,,0,0,0,,Мен оған онлайн тапсырыс бердім.
Dialogue: 0,0:18:25.14,0:18:26.23,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:18:28.23,0:18:29.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:31.31,0:18:33.15,Default,,0,0,0,,Лихт мырза!
Dialogue: 0,0:18:33.23,0:18:34.48,Default,,0,0,0,,Хмм... Былай деуге болады
Dialogue: 0,0:18:34.57,0:18:37.65,Default,,0,0,0,,Сен мені алып кетуге келдің бе?
Dialogue: 0,0:18:37.74,0:18:40.20,Default,,0,0,0,,Жарайды, өйткені оның навигация функциясы бар.
Dialogue: 0,0:18:40.28,0:18:42.49,Default,,0,0,0,,Мен саған айттым.
Dialogue: 0,0:18:42.57,0:18:44.12,Default,,0,0,0,,Шулы!
Dialogue: 0,0:18:44.20,0:18:46.50,Default,,0,0,0,,Мен серуендегім келді.
Dialogue: 0,0:18:47.20,0:18:49.62,Default,,0,0,0,,Қайда баратыным өзіме байланысты.
Dialogue: 0,0:18:59.34,0:19:01.93,Default,,0,0,0,,Айтпақшы, сіз қай каталогты таңдадыңыз?
Dialogue: 0,0:19:03.51,0:19:05.72,Default,,0,0,0,,Deluxe опциялар жинағы?
Dialogue: 0,0:19:06.22,0:19:08.98,Default,,0,0,0,,Себебі мен туған күнімде сәтсіздікке ұшырадым.
Dialogue: 0,0:19:09.06,0:19:12.15,Default,,0,0,0,,Мен тосын сыйды қайта көргім келеді.
Dialogue: 0,0:19:12.23,0:19:15.90,Default,,0,0,0,,Бұйырғанымды құпия сақтай аламын ба?
Dialogue: 0,0:19:16.48,0:19:18.78,Default,,0,0,0,,А... Түсіндім...
Dialogue: 0,0:19:19.36,0:19:21.03,Default,,0,0,0,,Маған картоп алуға бола ма?
Dialogue: 0,0:19:21.11,0:19:22.41,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:19:25.66,0:19:27.41,Default,,0,0,0,,CL-чан және Такума-сама
Dialogue: 0,0:19:27.49,0:19:29.87,Default,,0,0,0,,Біз өте жақсы доспыз.
Dialogue: 0,0:19:29.96,0:19:31.67,Default,,0,0,0,,Нағыз жұп сияқты
Dialogue: 0,0:19:31.75,0:19:35.46,Default,,0,0,0,,Мұндай нәрсе роботтар мен адамдар арасында да болады.
Dialogue: 0,0:19:35.54,0:19:37.17,Default,,0,0,0,,Сіз қызғанасыз ба?
Dialogue: 0,0:19:37.25,0:19:39.38,Default,,0,0,0,,Хмм, дұрыс.
Dialogue: 0,0:19:39.46,0:19:41.18,Default,,0,0,0,,Отбасы болу...
Dialogue: 0,0:19:41.26,0:19:43.93,Default,,0,0,0,,Менің ойымша, бұл жақсы.
Dialogue: 0,0:19:44.01,0:19:45.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:49.14,0:19:50.35,Default,,0,0,0,,Ах
Dialogue: 0,0:19:50.43,0:19:53.44,Default,,0,0,0,,Білесіз бе! Тіпті жұп болып кетпесек те
Dialogue: 0,0:19:53.52,0:19:57.23,Default,,0,0,0,,Мина менікі... маңызды...
Dialogue: 0,0:19:57.77,0:20:01.40,Default,,0,0,0,,Немесе… Немесе… Немесе… Немесе…
Dialogue: 0,0:20:01.49,0:20:03.20,Default,,0,0,0,,Үйге қайтайық!
Dialogue: 0,0:20:05.41,0:20:06.83,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,0:20:15.46,0:20:17.09,Default,,0,0,0,,Такума-сама
Dialogue: 0,0:20:17.71,0:20:20.30,Default,,0,0,0,,Мен өндірушіден электрондық хат алдым.
Dialogue: 0,0:20:20.38,0:20:23.51,Default,,0,0,0,,Ол келесі аптада мені алып кетуге келетінін айтады.
Dialogue: 0,0:20:23.59,0:20:25.59,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:20:26.26,0:20:28.85,Default,,0,0,0,,Жаңарту және техникалық қызмет көрсету аяқталғаннан кейін
Dialogue: 0,0:20:28.93,0:20:30.68,Default,,0,0,0,,Осы жерге оралды
Dialogue: 0,0:20:30.77,0:20:33.64,Default,,0,0,0,,Екі аптаға жуық уақыт кететін сияқты.
Dialogue: 0,0:20:33.73,0:20:34.85,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:20:35.85,0:20:38.23,Default,,0,0,0,,Сізге кешкі ас ұнамай ма?
Dialogue: 0,0:20:38.94,0:20:41.11,Default,,0,0,0,,Жоқ, дәмді, дәмді
Dialogue: 0,0:20:44.24,0:20:46.24,Default,,0,0,0,,Мен дәмін білмеймін
Dialogue: 0,0:20:48.28,0:20:51.20,Default,,0,0,0,,(Сағаттың секунд тілі дыбысы)
Dialogue: 0,0:20:52.29,0:20:54.21,Default,,0,0,0,,Мен мүлдем ұйықтай алмаймын
Dialogue: 0,0:20:54.29,0:20:56.75,Default,,0,0,0,,Мен ұйықтап жатқанда Минаның күліп тұрғанын көремін.
Dialogue: 0,0:20:54.29,0:20:56.75,Default,,0,0,0,,Бұл жәндік емес.
Dialogue: 0,0:20:56.83,0:20:59.21,Default,,0,0,0,,Мен тек шымыр болуды армандаймын.
Dialogue: 0,0:21:01.46,0:21:03.97,Default,,0,0,0,,Оянсам, жылап отырмын.
Dialogue: 0,0:21:04.05,0:21:05.72,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:21:07.55,0:21:09.97,Default,,0,0,0,,Мен қорқынышты түс көрдім
Dialogue: 0,0:21:11.47,0:21:14.52,Default,,0,0,0,,Мен Минаның шымыр болғанын қалаймын ба?
Dialogue: 0,0:21:14.60,0:21:16.85,Default,,0,0,0,,Менің сыпайы болғанымды қаламайсың ба?
Dialogue: 0,0:21:16.94,0:21:17.98,Default,,0,0,0,,Қайсысы?
Dialogue: 0,0:21:18.06,0:21:21.69,Default,,0,0,0,,Жоқ! Менің сезімім маңызды емес!
Dialogue: 0,0:21:21.78,0:21:24.70,Default,,0,0,0,,Мина-чанның суланғысы келе ме, жоқ па білмеймін.
Dialogue: 0,0:21:25.28,0:21:29.70,Default,,0,0,0,,Жұмсақ болғың келсе, мен сені жылы қарауым керек.
Dialogue: 0,0:21:30.62,0:21:33.83,Default,,0,0,0,,Такума-сама, жүзің не болды?
Dialogue: 0,0:21:33.91,0:21:36.33,Default,,0,0,0,,А... жоқ, кенеттен...
Dialogue: 0,0:21:36.42,0:21:38.92,Default,,0,0,0,,Кешіріңіз... бірақ...
Dialogue: 0,0:21:39.00,0:21:40.84,Default,,0,0,0,,Мәселе жоқ
Dialogue: 0,0:21:56.89,0:21:57.89,Default,,0,0,0,,Мина-чан
Dialogue: 0,0:21:59.06,0:22:01.52,Default,,0,0,0,,Бұл аздап... ауырады.
Dialogue: 0,0:22:02.90,0:22:04.57,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:22:06.90,0:22:11.91,Default,,0,0,0,,♪～
Dialogue: 0,0:23:29.44,0:23:35.45,Default,,0,0,0,,～♪
Dialogue: 0,0:23:36.58,0:23:37.79,Default,,0,0,0,,Келесі жолы…
Dialogue: 0,0:23:39.29,0:23:45.29,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
