Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:03.75,0:01:17.85,Default,,0,0,0,,♪♪～
Dialogue: 0,0:01:17.85,0:01:20.27,Default,,0,0,0,,Цзянси Сатору…
Dialogue: 0,0:01:20.27,0:01:24.14,Default,,0,0,0,,Төреші олардың арасындағы өзара байланыс арқылы анықталады.
Dialogue: 0,0:01:24.14,0:01:27.81,Default,,0,0,0,,Мен сені осында келеді деп ешқашан күтпедім.
Dialogue: 0,0:01:27.81,0:01:31.81,Default,,0,0,0,,Мен саған Луна мен Амуды қорғайтынымды айттым.
Dialogue: 0,0:04:45.77,0:05:01.74,Default,,0,0,0,,♪♪～
Dialogue: 0,0:05:01.74,0:05:03.78,Default,,0,0,0,,ﾙｰﾅ！
Dialogue: 0,0:05:03.78,0:05:09.18,Default,,0,0,0,,Боу?
Dialogue: 0,0:05:09.18,0:05:21.84,Default,,0,0,0,,♪♪～
Dialogue: 0,0:05:21.84,0:05:24.14,Default,,0,0,0,,ﾙｰﾅ…
Dialogue: 0,0:05:27.27,0:05:29.27,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:05:29.27,0:05:32.62,Default,,0,0,0,,Мен Луна Юдзукимін, бұл...
Dialogue: 0,0:05:32.62,0:05:35.76,Default,,0,0,0,,Мен Амның тілегін орындаймын.
Dialogue: 0,0:05:35.76,0:05:39.29,Default,,0,0,0,,Незуко-чаан!
Dialogue: 0,0:05:39.29,0:05:41.25,Default,,0,0,0,,ﾙｰﾅ…
Dialogue: 0,0:05:41.25,0:05:45.25,Default,,0,0,0,,♪♪～
Dialogue: 0,0:05:45.25,0:05:47.29,Default,,0,0,0,,Бұл жекпе-жекті жеңіңіз➡
Dialogue: 0,0:05:47.29,0:05:49.90,Default,,0,0,0,,Кемелді болашаққа сенімді болыңыз
Dialogue: 0,0:05:49.90,0:05:54.61,Default,,0,0,0,,Біз өзіміздің шынайы болашағымызды міндетті түрде қайтарамыз.
Dialogue: 0,0:05:54.61,0:05:57.58,Default,,0,0,0,,ｽﾀﾝﾄﾞｱｯﾌﾟ ｳﾞｧﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:05:57.58,0:06:02.47,Default,,0,0,0,,♪♪～
Dialogue: 0,0:06:02.47,0:06:04.84,Default,,0,0,0,,Таоюань қыз Эльми!
Dialogue: 0,0:06:04.84,0:06:06.84,Default,,0,0,0,,ｴﾆｸﾞﾏﾃｨｯｸ･ｱｻｼﾝ
Dialogue: 0,0:06:14.53,0:06:16.41,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:06:16.41,0:06:21.32,Default,,0,0,0,,♪♪～
Dialogue: 0,0:06:21.32,0:06:23.32,Default,,0,0,0,,ｴﾙﾐ！
Dialogue: 0,0:06:23.32,0:06:25.32,Default,,0,0,0,,ｶﾞｰﾄﾞ
Dialogue: 0,0:06:29.08,0:06:32.61,Default,,0,0,0,,ﾗｲﾄﾞ ｼｬﾙﾊﾛｰﾄ･ｳﾞｧﾝﾋﾟｰｱ
Dialogue: 0,0:06:32.61,0:06:39.94,Default,,0,0,0,,♪♪～
Dialogue: 0,0:06:39.94,0:06:42.32,Default,,0,0,0,,Енді барлық адамдар➡
Dialogue: 0,0:06:42.32,0:06:45.11,Default,,0,0,0,,Бейбіт бақытқа жетуге тырысу
Dialogue: 0,0:06:45.11,0:06:51.60,Default,,0,0,0,,♪♪～
Dialogue: 0,0:06:51.60,0:06:58.19,Default,,0,0,0,,Көптеген шығындарды төлеп, осында келдік.
Dialogue: 0,0:06:58.19,0:07:00.41,Default,,0,0,0,,Мен саған енді жол бермеймін.
Dialogue: 0,0:07:00.41,0:07:04.93,Default,,0,0,0,,Қандай жағдай болмасын, мен бұл кемел келешекті өзімдікі етемін.
Dialogue: 0,0:07:04.93,0:07:09.95,Default,,0,0,0,,ｺｰﾙ ｸﾞﾚﾝﾂｪﾝﾄ･ｳﾞｧﾝﾋﾟｰｱ
Dialogue: 0,0:07:09.95,0:07:11.97,Default,,0,0,0,,Дағдыны белсендіру
Dialogue: 0,0:07:11.97,0:07:16.29,Default,,0,0,0,,Палубаның ең жоғарғы бес картасын қараңыз және «Тұңғиық» шеберлігі бар картаны жанға салыңыз.
Dialogue: 0,0:07:16.29,0:07:18.74,Default,,0,0,0,,ﾊﾟﾜｰﾌﾟﾗｽ1000
Dialogue: 0,0:07:18.74,0:07:22.30,Default,,0,0,0,,ｺｰﾙ ｴｯｼﾞ･ｲﾝ･ｻﾞ･ﾀﾞｰｸﾈｽ
Dialogue: 0,0:07:22.30,0:07:24.78,Default,,0,0,0,,Гренчентпен шабуыл
Dialogue: 0,0:07:24.78,0:07:26.80,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:07:26.80,0:07:31.62,Default,,0,0,0,,Ақырында кім саған кедергі болса, оны жең!
Dialogue: 0,0:07:31.62,0:07:33.59,Default,,0,0,0,,ｷｬｰ！
Dialogue: 0,0:07:33.59,0:07:48.49,Default,,0,0,0,,♪♪～
Dialogue: 0,0:07:48.49,0:07:50.49,Default,,0,0,0,,ｱﾀｯｸ！
Dialogue: 0,0:07:52.43,0:07:54.45,Default,,0,0,0,,ｶﾞｰﾄﾞ
Dialogue: 0,0:07:54.45,0:08:01.30,Default,,0,0,0,,♪♪～
Dialogue: 0,0:08:01.30,0:08:03.91,Default,,0,0,0,,Мен Амды қорғаймын
Dialogue: 0,0:08:03.91,0:08:05.96,Default,,0,0,0,,ﾙｰﾅ…
Dialogue: 0,0:08:05.96,0:08:08.79,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:08:08.79,0:08:12.96,Default,,0,0,0,,ｶｰﾆﾊﾞﾚｽ･ﾒｶﾞﾄﾘｯｸﾌﾟﾗｰﾅ
Dialogue: 0,0:08:12.96,0:08:18.49,Default,,0,0,0,,Карнибалдардың магиясы Мегатрик Плана Қолыңыздан жаныңызға бір карта жіберіңіз
Dialogue: 0,0:08:18.49,0:08:23.24,Default,,0,0,0,,2 Soul Superior Call-тың артқы күзетшілері
Dialogue: 0,0:08:23.24,0:08:25.44,Default,,0,0,0,,ﾌﾟﾚｲｽﾞﾄﾞ･ｲｰﾋﾞﾙﾃｲﾏｰﾐﾚｲﾕ
Dialogue: 0,0:08:25.44,0:08:28.41,Default,,0,0,0,,ｷｭｰﾃｨ･ﾊﾟﾗﾄﾙｰﾊﾟｰ
Dialogue: 0,0:08:28.41,0:08:30.85,Default,,0,0,0,,Сүйкімді десантшы Магия
Dialogue: 0,0:08:30.85,0:08:33.97,Default,,0,0,0,,Миреяға қоңырау шалыңыз
Dialogue: 0,0:08:33.97,0:08:36.27,Default,,0,0,0,,Дағдыға байланысты қуат плюс 9000
Dialogue: 0,0:08:38.51,0:08:41.08,Default,,0,0,0,,Мен Амның тілегін орындаймын.
Dialogue: 0,0:08:41.08,0:08:46.70,Default,,0,0,0,,Мен не істесем де, мен сені ешқашан жолыма түсірмеймін.
Dialogue: 0,0:08:46.70,0:08:49.30,Default,,0,0,0,,Ам болса да
Dialogue: 0,0:08:51.25,0:08:53.29,Default,,0,0,0,,ｱﾀｯｸ
Dialogue: 0,0:08:53.29,0:08:55.36,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:08:55.36,0:08:58.16,Default,,0,0,0,,Карнибалес Мегатрик Планамен шабуыл
Dialogue: 0,0:09:00.51,0:09:02.51,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:09:04.80,0:09:08.25,Default,,0,0,0,,Луна осылай ойлайды...
Dialogue: 0,0:09:08.25,0:09:10.25,Default,,0,0,0,,Мен үшін осылай...
Dialogue: 0,0:09:13.76,0:09:15.79,Default,,0,0,0,,ﾙｰﾅ
Dialogue: 0,0:09:15.79,0:09:18.13,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:09:18.13,0:09:22.08,Default,,0,0,0,,Арманды айналдыратын Ранункул Ашер
Dialogue: 0,0:09:22.08,0:09:26.65,Default,,0,0,0,,Мен филиалдағылардың барлығын және Авангардты жақсы көретіндерді құптамаймын➡
Dialogue: 0,0:09:26.65,0:09:30.25,Default,,0,0,0,,Ал Клейде барлығының есебінен келген бақыт...
Dialogue: 0,0:09:32.74,0:09:36.13,Default,,0,0,0,,Мұндай әрекетпен алатын болашағың түкке тұрғысыз!
Dialogue: 0,0:09:36.13,0:09:38.07,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｽｷﾙ！
Dialogue: 0,0:09:38.07,0:09:40.07,Default,,0,0,0,,Lilga Superior қоңырауы!
Dialogue: 0,0:09:40.07,0:09:44.62,Default,,0,0,0,,Лилга Блум! Қолыңызға 2 лига салыңыз
Dialogue: 0,0:09:44.62,0:09:48.64,Default,,0,0,0,,《Толық күзетіңді шеберлікпен арттырып, қолыңа қостың ба...》
Dialogue: 0,0:09:48.64,0:09:53.08,Default,,0,0,0,,Элмидің шеберлігі Гриншот эльфті шақыру!
Dialogue: 0,0:09:53.08,0:09:55.30,Default,,0,0,0,,Жасыл гүлдену
Dialogue: 0,0:09:55.30,0:09:58.27,Default,,0,0,0,,2 жасыл түсірілім үшін қуат плюс 2000
Dialogue: 0,0:09:58.27,0:10:00.27,Default,,0,0,0,,Ашаның арман тоқыма өнері!
Dialogue: 0,0:10:00.27,0:10:03.41,Default,,0,0,0,,Алдыңғы қатардағы барлық блоктар үшін қуат плюс 5000
Dialogue: 0,0:10:03.41,0:10:05.46,Default,,0,0,0,,Катринаға қоңырау шалыңыз
Dialogue: 0,0:10:05.46,0:10:08.80,Default,,0,0,0,,Авангардқа жасыл оқпен шабуыл жасаңыз!
Dialogue: 0,0:10:08.80,0:10:11.92,Default,,0,0,0,,Армандайтын Ранункулус Жершамен шабуыл жасаңыз!
Dialogue: 0,0:10:11.92,0:10:13.95,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ
Dialogue: 0,0:10:13.95,0:10:16.92,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ｡ ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ！
Dialogue: 0,0:10:16.92,0:10:18.99,Default,,0,0,0,,Жасыл суретке арналған қуат
Dialogue: 0,0:10:18.99,0:10:20.99,Default,,0,0,0,,Сындарлы армандарды жасайтын Аашаға
Dialogue: 0,0:10:23.98,0:10:26.05,Default,,0,0,0,,Бұл болашақ қандай тамаша?➡
Dialogue: 0,0:10:26.05,0:10:29.47,Default,,0,0,0,,Сіз мұны шынымен мақтанышпен айта аласыз!
Dialogue: 0,0:10:29.47,0:10:32.59,Default,,0,0,0,,((Мамору: Мен сондай лас қолмен ұстаған болашақ➡
Dialogue: 0,0:10:32.59,0:10:38.79,Default,,0,0,0,,Сіз шынымен де қорғауға тиіс адамдарға өзіңізді мақтан ете аламын деп ойлайсыз ба? ))
Dialogue: 0,0:10:38.79,0:10:40.75,Default,,0,0,0,,Ха~!!
Dialogue: 0,0:10:40.75,0:10:49.82,Default,,0,0,0,,♪♪～
Dialogue: 0,0:10:49.82,0:10:55.26,Default,,0,0,0,,Хмм... түсіндім. Соның ішінде Мамору Анджомен байланыс ➡
Dialogue: 0,0:10:55.26,0:10:58.25,Default,,0,0,0,,Сіз төреші...
Dialogue: 0,0:10:58.25,0:11:00.46,Default,,0,0,0,,Зақым 5 Міне!
Dialogue: 0,0:11:00.46,0:11:02.40,Default,,0,0,0,,Жасыл оқпен шабуыл!
Dialogue: 0,0:11:02.40,0:11:08.12,Default,,0,0,0,,♪♪～
Dialogue: 0,0:11:08.12,0:11:10.09,Default,,0,0,0,,ｼﾞｪﾈﾚｰｼｮﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:11:10.09,0:11:13.19,Default,,0,0,0,,Жалған қара қанаттар Аграт Бат Марат
Dialogue: 0,0:11:15.61,0:11:20.79,Default,,0,0,0,,Мені кім сынаса да, шешімім өзгермейді.
Dialogue: 0,0:11:20.79,0:11:24.92,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:11:24.92,0:11:28.46,Default,,0,0,0,,Эричтің жын маскасы!
Dialogue: 0,0:11:28.46,0:11:31.58,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｽｷﾙ ｿｳﾙﾁｬｰｼﾞ
Dialogue: 0,0:11:31.58,0:11:35.00,Default,,0,0,0,,Өлшем Creeper Skill Soul Charge
Dialogue: 0,0:11:35.00,0:11:37.95,Default,,0,0,0,,Қайтадан жан заряды
Dialogue: 0,0:11:37.95,0:11:41.31,Default,,0,0,0,,Енді барлығы 11 дана
Dialogue: 0,0:11:41.31,0:11:47.96,Default,,0,0,0,,Ашкөз суккубустың қараңғылығын қараңғылықтағы жанның жиегінен шегіндіріңіз
Dialogue: 0,0:11:47.96,0:11:50.48,Default,,0,0,0,,Ашкөздік суккубы
Dialogue: 0,0:11:50.48,0:11:55.14,Default,,0,0,0,,Демонстрацияланған қараңғылық күші Plus 5000 шабуылы!
Dialogue: 0,0:11:55.14,0:11:57.10,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:11:57.10,0:11:59.84,Default,,0,0,0,,Эричтің жын маскасымен шабуыл!
Dialogue: 0,0:11:59.84,0:12:04.14,Default,,0,0,0,,Қадаммен жүру дағдысы Бір қарсыластың артқы қорғаушысын шегіндіріңіз
Dialogue: 0,0:12:06.28,0:12:09.33,Default,,0,0,0,,ｶﾄﾘｰﾅ…
Dialogue: 0,0:12:09.33,0:12:13.12,Default,,0,0,0,,Эрихтің қараңғылық жан заряды
Dialogue: 0,0:12:13.12,0:12:17.26,Default,,0,0,0,,Барлығы бақытты бола алатын болашақ... және ➡
Dialogue: 0,0:12:17.26,0:12:21.83,Default,,0,0,0,,Луна Юдзуки өзін ертеңгі күнді түсінуге арнайды➡
Dialogue: 0,0:12:21.83,0:12:25.43,Default,,0,0,0,,Мен оны міндетті түрде қорғаймын!
Dialogue: 0,0:14:09.12,0:14:14.14,Default,,0,0,0,,♪♪～
Dialogue: 0,0:14:14.14,0:14:18.63,Default,,0,0,0,,Толық күзет! Үштік жетек
Dialogue: 0,0:14:18.63,0:14:23.28,Default,,0,0,0,,Триггер. Барлық әсерлер көрсетілді.
Dialogue: 0,0:14:23.28,0:14:26.79,Default,,0,0,0,,Емдеу триггері. 1 зақымдарды қалпына келтіреді
Dialogue: 0,0:14:26.79,0:14:29.62,Default,,0,0,0,,Қуат Демонтқа түседі
Dialogue: 0,0:14:29.62,0:14:34.78,Default,,0,0,0,,Луна Аму Чоно құтқарылатын болашақты тіледі...
Dialogue: 0,0:14:34.78,0:14:39.40,Default,,0,0,0,,Және ол үшін өзіңізді құрбан етіңіз.
Dialogue: 0,0:14:39.40,0:14:44.12,Default,,0,0,0,,Мен сол асыл істі қорғаймын...
Dialogue: 0,0:14:44.12,0:14:47.99,Default,,0,0,0,,Шабуыл! Ах!
Dialogue: 0,0:14:47.99,0:14:52.46,Default,,0,0,0,,Жұмбақ шеберліктің жоғары қоңырауы
Dialogue: 0,0:14:52.46,0:14:57.87,Default,,0,0,0,,Пауэр Plus 5000. Лунаның тілегі, Амудың бақыты➡
Dialogue: 0,0:14:57.87,0:15:00.75,Default,,0,0,0,,Мен сені алып кетуге рұқсат бермеймін!
Dialogue: 0,0:15:00.75,0:15:05.16,Default,,0,0,0,,♪♪～
Dialogue: 0,0:15:05.16,0:15:07.08,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:07.08,0:15:15.95,Default,,0,0,0,,♪♪～
Dialogue: 0,0:15:15.95,0:15:19.44,Default,,0,0,0,,Сіз ештеңе түсінбейсіз...
Dialogue: 0,0:15:19.44,0:15:23.34,Default,,0,0,0,,Мен ештеңе түсінбеймін!
Dialogue: 0,0:15:23.34,0:15:25.84,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:15:29.80,0:15:33.14,Default,,0,0,0,,Жел желдің гүл қызы, Ильматар!
Dialogue: 0,0:15:33.14,0:15:37.68,Default,,0,0,0,,Қадаммен жүру дағдысы! Жасыл атуды шақырыңыз. Пауэр Plus 2000
Dialogue: 0,0:15:37.68,0:15:41.76,Default,,0,0,0,,Жасыл гүлдену Пауэр Plus 2000
Dialogue: 0,0:15:41.76,0:15:47.12,Default,,0,0,0,,Жасыл атуды шақырыңыз! Жасыл бүршік қайтадан гүлдейді! Қуат плюс 2000
Dialogue: 0,0:15:47.12,0:15:50.00,Default,,0,0,0,,Пауэр Plus 2000 қайтадан!
Dialogue: 0,0:15:50.00,0:15:53.91,Default,,0,0,0,,Желдің гүл қызы Ильматардың өнері!
Dialogue: 0,0:15:53.91,0:15:56.63,Default,,0,0,0,,Жасыл суретті таңдаңыз
Dialogue: 0,0:15:56.63,0:16:00.26,Default,,0,0,0,,1 картаны сал. Жасыл оқпен шабуыл Vanguard➡ тиген кезде
Dialogue: 0,0:16:00.26,0:16:04.30,Default,,0,0,0,,Сіз бір картаны тарта аласыз. Сонымен қатар, гүлдену ➡ бар бірлік бар
Dialogue: 0,0:16:04.30,0:16:08.96,Default,,0,0,0,,3 немесе одан да көп карта үшін Критикалық плюс 1. Катринаға қоңырау шалыңыз!
Dialogue: 0,0:16:08.96,0:16:14.75,Default,,0,0,0,,♪♪～
Dialogue: 0,0:16:14.75,0:16:17.43,Default,,0,0,0,,Мен көрдім...
Dialogue: 0,0:16:17.43,0:16:21.97,Default,,0,0,0,,Мен ғана емес, Айтқаныңыз да бар➡
Dialogue: 0,0:16:21.97,0:16:27.12,Default,,0,0,0,,Кемелді болашақ... бұл жай өтірік
Dialogue: 0,0:16:27.12,0:16:31.60,Default,,0,0,0,,Әке-шешесі қанша аман қалса да, Ам құтқара алмайды.
Dialogue: 0,0:16:31.60,0:16:35.92,Default,,0,0,0,,♪♪～
Dialogue: 0,0:16:35.92,0:16:38.97,Default,,0,0,0,,Амның күлкісі қайтып келмейді!
Dialogue: 0,0:16:38.97,0:16:41.81,Default,,0,0,0,,Сіз қорғауға тырысып жатқан тамаша болашақ –➡
Dialogue: 0,0:16:41.81,0:16:44.96,Default,,0,0,0,,Бұл адамдарды қуантатын нәрсе емес!
Dialogue: 0,0:16:44.96,0:16:48.63,Default,,0,0,0,,Соқыр адамдарды және оларды шынымен маңызды нәрседен есінен шығарыңыз➡
Dialogue: 0,0:16:48.63,0:16:51.73,Default,,0,0,0,,Бұл жай ғана сіздің назарыңызды аударатын айла!
Dialogue: 0,0:16:51.73,0:16:57.79,Default,,0,0,0,,Аму Стрид Гейт көрген арманын жоққа шығарды. Мен де солай істедім.
Dialogue: 0,0:16:57.79,0:17:01.63,Default,,0,0,0,,Бұл Мен немесе мен қалаған болашақ емес!
Dialogue: 0,0:17:01.63,0:17:07.78,Default,,0,0,0,,♪♪～
Dialogue: 0,0:17:07.78,0:17:10.93,Default,,0,0,0,,Мен Лунаның... дәл солай екеніне сенімдімін!
Dialogue: 0,0:17:10.93,0:17:17.57,Default,,0,0,0,,♪♪～
Dialogue: 0,0:17:17.57,0:17:20.13,Default,,0,0,0,,Толық күзет…
Dialogue: 0,0:17:20.13,0:17:24.65,Default,,0,0,0,,♪♪～
Dialogue: 0,0:17:24.65,0:17:27.75,Default,,0,0,0,,Ам тілегін орында
Dialogue: 0,0:17:34.79,0:17:37.59,Default,,0,0,0,,Эй Луна, тыңда!
Dialogue: 0,0:17:37.59,0:17:40.09,Default,,0,0,0,,Мен Амды қорғаймын
Dialogue: 0,0:17:46.12,0:17:48.62,Default,,0,0,0,,ｼﾞｪﾈﾚｰｼｮﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:17:48.62,0:17:52.72,Default,,0,0,0,,Түнгі кештің ұлы сиқыршысы, Негролили!
Dialogue: 0,0:17:55.75,0:18:00.45,Default,,0,0,0,,Жетеді! Мен күтуді шештім.
Dialogue: 0,0:18:00.45,0:18:03.79,Default,,0,0,0,,Анам мен әкем қайтып келеді деп үміттенемін!
Dialogue: 0,0:18:03.79,0:18:06.91,Default,,0,0,0,,Ешқашан қайтып келмейтін екі адам➡
Dialogue: 0,0:18:06.91,0:18:11.91,Default,,0,0,0,,Тек сонша уақыт күтудің өзі азапты, азапты➡
Dialogue: 0,0:18:11.91,0:18:14.45,Default,,0,0,0,,Оған қарсы тұру мүмкін емес
Dialogue: 0,0:18:14.45,0:18:18.29,Default,,0,0,0,,Бірақ соған қарамастан мен берілмеймін және өмір сүремін!
Dialogue: 0,0:18:18.29,0:18:20.79,Default,,0,0,0,,Мен осылай шештім!!
Dialogue: 0,0:18:20.79,0:18:26.24,Default,,0,0,0,,Міне, мен қалаймын болашақ... Жалған әрі мейірімді болашақ➡
Dialogue: 0,0:18:26.24,0:18:28.50,Default,,0,0,0,,Қажет емес!
Dialogue: 0,0:18:28.50,0:18:30.50,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:18:34.45,0:18:37.82,Default,,0,0,0,,Дауыл шақыратын қарақшы патша Гаш!
Dialogue: 0,0:18:37.82,0:18:41.12,Default,,0,0,0,,Қадаммен жүру дағдысы! Gast Dragon-ға қоңырау шалыңыз!
Dialogue: 0,0:18:43.08,0:18:47.45,Default,,0,0,0,,ﾊﾟﾜｰﾌﾟﾗｽ2000！ ﾎﾛｳ！
Dialogue: 0,0:18:47.45,0:18:49.77,Default,,0,0,0,,Гаш шеберлігі іске қосылды!
Dialogue: 0,0:18:49.77,0:18:52.40,Default,,0,0,0,,Екі жанды құлау аймағына жіберіңіз
Dialogue: 0,0:18:52.40,0:18:57.11,Default,,0,0,0,,Құлау аймағынан 2 артқы қорғаушыны шақырыңыз
Dialogue: 0,0:18:57.11,0:18:59.09,Default,,0,0,0,,ﾊﾟﾜｰﾌﾟﾗｽ4000！
Dialogue: 0,0:18:59.09,0:19:03.01,Default,,0,0,0,,Мен Лунамен тағы да сахнаға шыққым келеді!
Dialogue: 0,0:19:03.01,0:19:05.95,Default,,0,0,0,,Бірге ән айт, бірге биле...
Dialogue: 0,0:19:05.95,0:19:10.42,Default,,0,0,0,,Бұл бәрі емес! Мен одан да көп нәрсе жасағым келеді
Dialogue: 0,0:19:10.42,0:19:16.79,Default,,0,0,0,,Кино көру, тамақ ішу, бірге ойнау, бірге күлу...
Dialogue: 0,0:19:16.79,0:19:22.45,Default,,0,0,0,,Қиналғанда, жалғыздықта, қолыңнан ештеңе келмегенде...Луна!
Dialogue: 0,0:19:22.45,0:19:25.50,Default,,0,0,0,,Мен сенің қасымда болғаныңды қалаймын!
Dialogue: 0,0:19:25.50,0:19:27.60,Default,,0,0,0,,ﾙｰﾅ!!
Dialogue: 0,0:19:32.09,0:19:35.75,Default,,0,0,0,,ｱﾑ…
Dialogue: 0,0:19:35.75,0:19:39.78,Default,,0,0,0,,Ам... Мен де Аммен бірге болғым келеді.
Dialogue: 0,0:19:39.78,0:19:42.92,Default,,0,0,0,,Маған көмектесіңізші!
Dialogue: 0,0:19:42.92,0:19:44.92,Default,,0,0,0,,ﾙｰﾅ！
Dialogue: 0,0:19:51.13,0:19:53.08,Default,,0,0,0,,Лунаны түсіндім
Dialogue: 0,0:19:53.08,0:19:56.28,Default,,0,0,0,,Қазір көмектесіңіз!
Dialogue: 0,0:19:56.28,0:20:02.41,Default,,0,0,0,,Әлі де... Өтірік болсын, өтірік болсын➡
Dialogue: 0,0:20:02.41,0:20:05.91,Default,,0,0,0,,Онда қалсаң, саған зиян тимейді.
Dialogue: 0,0:20:05.91,0:20:08.81,Default,,0,0,0,,Сіз құтқарыласыз.
Dialogue: 0,0:20:08.81,0:20:10.73,Default,,0,0,0,,Демонтпен шабуыл
Dialogue: 0,0:20:10.73,0:20:12.78,Default,,0,0,0,,ｲﾝﾀｰｾﾌﾟﾄ！
Dialogue: 0,0:20:12.78,0:20:16.40,Default,,0,0,0,,Біз тек тәтті және мейірімді болашақты қаламаймыз.
Dialogue: 0,0:20:16.40,0:20:20.46,Default,,0,0,0,,Мен мұндай нәрсеге алданып қалғым келмейді.
Dialogue: 0,0:20:20.46,0:20:22.83,Default,,0,0,0,,Қиын болса да, ауырса да➡
Dialogue: 0,0:20:22.83,0:20:25.91,Default,,0,0,0,,Біз оны дұрыс қабылдаймыз!
Dialogue: 0,0:20:25.91,0:20:29.73,Default,,0,0,0,,Күлейік!
Dialogue: 0,0:20:29.73,0:20:31.99,Default,,0,0,0,,Гренченттегі шабуыл!
Dialogue: 0,0:20:31.99,0:20:34.29,Default,,0,0,0,,ｸﾞﾘｰﾝｼｮｯﾄ！ ﾄｩｰﾘｱ！
Dialogue: 0,0:20:40.13,0:20:44.93,Default,,0,0,0,,Сонда да мен...
Dialogue: 0,0:20:44.93,0:20:48.47,Default,,0,0,0,,Күнәкар Шалхаротпен Авангардқа шабуыл жасаңыз
Dialogue: 0,0:20:48.47,0:20:53.61,Default,,0,0,0,,Сеулге барлық қараңғылықтың тыл сақшылары
Dialogue: 0,0:20:53.61,0:20:55.74,Default,,0,0,0,,ﾊﾟﾜｰﾌﾟﾗｽ10000
Dialogue: 0,0:20:55.74,0:20:58.83,Default,,0,0,0,,Жандардың жалпы саны 15 немесе одан да көп болса➡
Dialogue: 0,0:20:58.83,0:21:01.43,Default,,0,0,0,,Қарсыластың барлық сақшыларын шегіндіріңіз
Dialogue: 0,0:21:04.08,0:21:08.82,Default,,0,0,0,,Бұл шабуылды Сентинел қорғай алмайды!
Dialogue: 0,0:21:08.82,0:21:10.82,Default,,0,0,0,,ﾂｯｹﾝ ﾊﾟﾄﾞﾐﾆ！
Dialogue: 0,0:21:13.59,0:21:18.12,Default,,0,0,0,,Қарғыс атқыр...кейде ұрысып, қатты ашуланады➡
Dialogue: 0,0:21:18.12,0:21:21.57,Default,,0,0,0,,Бұл бейбақ сөйлеп қалуы мүмкін.
Dialogue: 0,0:21:21.57,0:21:25.46,Default,,0,0,0,,Бірақ көп ұзамай сіз тағы бір ақымақ нәрсеге шағымданатын боласыз➡
Dialogue: 0,0:21:25.46,0:21:28.61,Default,,0,0,0,,Шынымен бірге күлейік!
Dialogue: 0,0:21:28.61,0:21:31.98,Default,,0,0,0,,Ха~!!
Dialogue: 0,0:21:31.98,0:21:34.08,Default,,0,0,0,,ｼﾞｪﾈﾚｰｼｮﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:21:36.93,0:21:39.97,Default,,0,0,0,,ﾚｲﾝﾌﾞﾚｽ･ﾄﾞﾗｺﾞﾝ！
Dialogue: 0,0:21:39.97,0:21:43.96,Default,,0,0,0,,Гүл қыз Ашерге керемет шақыру!
Dialogue: 0,0:21:43.96,0:21:47.44,Default,,0,0,0,,ﾚｼﾞｽﾄ！ ｼｰﾙﾄﾞﾌﾟﾗｽ5000！
Dialogue: 0,0:21:47.44,0:21:49.55,Default,,0,0,0,,ｸｯ…
Dialogue: 0,0:21:49.55,0:22:00.85,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:03.08,0:22:06.98,Default,,0,0,0,,Бұрын достар уақытша эмоционалды байланыстар➡
Dialogue: 0,0:22:06.98,0:22:09.27,Default,,0,0,0,,Сіз айттыңыз
Dialogue: 0,0:22:09.27,0:22:12.30,Default,,0,0,0,,Бірақ сізбен достарыңыз болса➡
Dialogue: 0,0:22:12.30,0:22:14.71,Default,,0,0,0,,Қандай жағдай болса да, мен орнынан қозғалмаймын.
Dialogue: 0,0:22:14.71,0:22:17.31,Default,,0,0,0,,Бұл біз
Dialogue: 0,0:22:19.81,0:22:23.88,Default,,0,0,0,,Сізге не болып жатыр және сіздің ойыңыз қандай?➡
Dialogue: 0,0:22:23.88,0:22:25.78,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:22:25.78,0:22:29.29,Default,,0,0,0,,Бірақ сен қорғайын деп жатқан болашақ маған керек емес!
Dialogue: 0,0:22:29.29,0:22:31.44,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:22:31.44,0:22:35.46,Default,,0,0,0,,Ранункулус құлан гүлдеді!
Dialogue: 0,0:22:35.46,0:22:37.44,Default,,0,0,0,,Дағдыны белсендіру
Dialogue: 0,0:22:37.44,0:22:39.43,Default,,0,0,0,,Гүл қыз Ашерді шақырыңыз!
Dialogue: 0,0:22:39.43,0:22:43.28,Default,,0,0,0,,Аша атты қондырғыға қуат плюс 15000
Dialogue: 0,0:22:43.28,0:22:47.17,Default,,0,0,0,,Гүлденген Азия үшін сыни плюс 1
Dialogue: 0,0:22:47.17,0:22:50.44,Default,,0,0,0,,Лилга мен Катринаға қоңырау шалыңыз!
Dialogue: 0,0:22:50.44,0:22:54.24,Default,,0,0,0,,Сіз шынымен де осындай болашақты қалайсыз ба?
Dialogue: 0,0:22:57.80,0:22:59.95,Default,,0,0,0,,Иә... Мен мұны білдім.
Dialogue: 0,0:22:59.95,0:23:04.91,Default,,0,0,0,,Бұл болашақ шынайы құтқарылу емес
Dialogue: 0,0:23:04.91,0:23:07.91,Default,,0,0,0,,Гүлденген Ранункулус Ашиямен шабуыл!
Dialogue: 0,0:23:10.11,0:23:13.91,Default,,0,0,0,,《Бірақ менде ілуде тұрудан басқа амал қалмады.》
Dialogue: 0,0:23:19.77,0:23:23.57,Default,,0,0,0,,《Үлкен бақытқа жете алатыныңызға сену➡
Dialogue: 0,0:23:23.57,0:23:27.61,Default,,0,0,0,,Өмірінің құнына аман қалғанынан➡
Dialogue: 0,0:23:27.61,0:23:30.50,Default,,0,0,0,,Мен қашып кеткім келді》
Dialogue: 0,0:23:30.50,0:23:32.50,Default,,0,0,0,,Ха~!!
Dialogue: 0,0:23:35.12,0:23:38.74,Default,,0,0,0,,《Мен басқаша шыдай алмадым.
Dialogue: 0,0:23:38.74,0:23:45.23,Default,,0,0,0,,Оның құрбандығы өте дұрыс болғанына сенуден басқа...》
Dialogue: 0,0:23:45.23,0:23:47.23,Default,,0,0,0,,ｱﾀｯｸ！
Dialogue: 0,0:23:49.82,0:23:53.40,Default,,0,0,0,,《Сондықтан мен өзімді Миджин кланының идеалдарына тастадым➡
Dialogue: 0,0:23:53.40,0:23:57.62,Default,,0,0,0,,Осы мақсатқа жету үшін көптеген құрбандықтар жасалды.
Dialogue: 0,0:23:57.62,0:24:02.25,Default,,0,0,0,,Күнәдан құтылу үшін мен көбірек күнә жасадым.
Dialogue: 0,0:24:02.25,0:24:06.28,Default,,0,0,0,,Біз қалаған болашаққа барамыз!
Dialogue: 0,0:24:06.28,0:24:09.95,Default,,0,0,0,,《Олар дұрыс.
Dialogue: 0,0:24:09.95,0:24:13.34,Default,,0,0,0,,Дұрыс және күшті
Dialogue: 0,0:24:13.34,0:24:19.16,Default,,0,0,0,,Мен не істеуім керек еді...》
Dialogue: 0,0:24:19.16,0:24:22.46,Default,,0,0,0,,Гүл қыз Ашиямен Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:24:25.82,0:24:27.82,Default,,0,0,0,,《Сол кезде...》
Dialogue: 0,0:24:34.01,0:24:36.81,Default,,0,0,0,,《Оған не уәде беруім керек...》
Dialogue: 0,0:24:40.82,0:24:43.42,Default,,0,0,0,,《Жақсы нәрсе...》
Dialogue: 0,0:24:57.43,0:25:00.52,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:25:00.52,0:25:03.46,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:25:03.46,0:25:07.26,Default,,0,0,0,,Бұл субтитрлер JOJO's Bizarre Adventure форумы, Yuhari Subtitles және Gods Subtitles Group бірлесіп дайындады
Dialogue: 0,0:25:21.46,0:25:24.51,Default,,0,0,0,,Nightrose көмегімен Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:25:24.51,0:25:26.61,Default,,0,0,0,,Лунаны оят!
Dialogue: 0,0:25:35.29,0:25:39.28,Default,,0,0,0,,ﾙｰﾅ！
Dialogue: 0,0:25:39.28,0:25:41.78,Default,,0,0,0,,ﾙｰﾅ！
Dialogue: 0,0:25:44.81,0:25:47.93,Default,,0,0,0,,ｱﾑ！
Dialogue: 0,0:25:47.93,0:25:52.17,Default,,0,0,0,,ｱﾑ！ ﾙｰﾅ！ ﾙｰﾅ！
Dialogue: 0,0:25:52.17,0:25:57.17,Default,,0,0,0,,Рахмет, мен сені жақсы көремін.
Dialogue: 0,0:26:00.50,0:26:04.80,Default,,0,0,0,,Жүр, үйге бірге барайық. Иә.
Dialogue: 0,0:27:40.80,0:27:45.75,Default,,0,0,0,,Төрт ой быт-шыт болды ма?
Dialogue: 0,0:27:45.75,0:27:47.95,Default,,0,0,0,,А... Маған бәрібір.
Dialogue: 0,0:27:47.95,0:27:50.81,Default,,0,0,0,,Осы қолдармен мен оны бекітемін.
Dialogue: 0,0:27:50.81,0:27:53.99,Default,,0,0,0,,Мен шынымен қалайтын әлем
Dialogue: 0,0:27:53.99,0:27:59.79,Default,,0,0,0,,Тез кел, Синдо Куроно!
Dialogue: 0,0:30:38.74,0:30:42.78,Default,,0,0,0,,< Бұл Жапонияның әлем мақтан тұтатын көркем жері.
Dialogue: 0,0:30:42.78,0:30:45.87,Default,,0,0,0,,Керемет Риа жағалауы →
Dialogue: 0,0:30:45.87,0:30:50.42,Default,,0,0,0,,Бұл қалаға түрлі игілік пен қазына әкелді.
Dialogue: 0,0:30:50.42,0:30:54.51,Default,,0,0,0,,Туристер ағылып келетін бұл жерді айтсақ →
Dialogue: 0,0:30:54.51,0:30:58.41,Default,,0,0,0,,Осы жылдың мамыр айында өткен саммит
Dialogue: 0,0:30:59.91,0:31:05.91,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory