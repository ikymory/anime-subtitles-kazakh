Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:03.86,0:01:06.87,Default,,0,0,0,,Менімен күрес, Луиза
Dialogue: 0,0:01:06.87,0:01:09.37,Default,,0,0,0,,Неліктен Драен бұтағын жойдың?
Dialogue: 0,0:01:09.37,0:01:11.82,Default,,0,0,0,,Неге бәрін ренжіттің!
Dialogue: 0,0:01:11.82,0:01:15.21,Default,,0,0,0,,Бұл сіз қалайтын болашақ па?
Dialogue: 0,0:01:15.21,0:01:20.48,Default,,0,0,0,,Жеңіспен күресу әділірек болатынын айтты.
Dialogue: 0,0:01:20.48,0:01:23.92,Default,,0,0,0,,А... Жарайды.
Dialogue: 0,0:01:23.92,0:01:30.22,Default,,0,0,0,,Дүние сіз бен менің арамызда қандай үкім шығаратынын қарастырайық.
Dialogue: 0,0:04:42.87,0:04:47.67,Default,,0,0,0,,Әлемді басқаратын шындықтың өзі Авангардта тұрады.
Dialogue: 0,0:04:47.67,0:04:51.68,Default,,0,0,0,,Біздің күресіміз дүниенің еркіне қарсы.
Dialogue: 0,0:04:51.68,0:04:54.08,Default,,0,0,0,,Онда мен саған көрсетемін.
Dialogue: 0,0:04:54.08,0:04:56.38,Default,,0,0,0,,Сіз қателесесіз!
Dialogue: 0,0:05:02.07,0:05:05.67,Default,,0,0,0,,Бірақ бұл жерде аздап шулы.
Dialogue: 0,0:05:08.93,0:05:11.43,Default,,0,0,0,,Әлі көрінбеген тағдыр
Dialogue: 0,0:05:17.53,0:05:19.54,Default,,0,0,0,,Барлығы ішке асығады!
Dialogue: 0,0:05:19.54,0:05:21.84,Default,,0,0,0,,[Радио] (Шион) Не болды!? Жауап!
Dialogue: 0,0:05:21.84,0:05:25.28,Default,,0,0,0,,Егер сіз мәселені шешкіңіз келсе, маған еріңіз.
Dialogue: 0,0:05:25.28,0:05:29.28,Default,,0,0,0,,Бүгін сағынсам, енді сені көрмеймін.
Dialogue: 0,0:05:31.87,0:05:33.97,Default,,0,0,0,,Сіз қорқасыз ба?
Dialogue: 0,0:05:37.45,0:05:40.25,Default,,0,0,0,,Куроноға мінбе!
Dialogue: 0,0:05:59.49,0:06:02.91,Default,,0,0,0,,Енді...
Dialogue: 0,0:06:02.91,0:06:05.02,Default,,0,0,0,,Ол бір жақсырақ болды.
Dialogue: 0,0:06:05.02,0:06:08.20,Default,,0,0,0,,Мен дайындаған адамдардың бәрі өлтірілді...
Dialogue: 0,0:06:08.20,0:06:13.66,Default,,0,0,0,,Сен... неге бірден тоқтамадың?
Dialogue: 0,0:06:13.66,0:06:19.38,Default,,0,0,0,,Неге! Сіз мұны көрмедіңіз!
Dialogue: 0,0:06:19.38,0:06:23.05,Default,,0,0,0,,Миоджин Льюз қалыпты емес
Dialogue: 0,0:06:23.05,0:06:29.32,Default,,0,0,0,,Келесі жолы, Куроно... Куроноға бірдеңе болса, мен...
Dialogue: 0,0:06:29.32,0:06:32.53,Default,,0,0,0,,Мен кінәлімін
Dialogue: 0,0:06:32.53,0:06:37.66,Default,,0,0,0,,Барлық сын Синдо Куроно сауыққаннан кейін қабылданады.
Dialogue: 0,0:06:37.66,0:06:41.12,Default,,0,0,0,,Сізді алып кеткен жағдайларды айтып беріңізші.
Dialogue: 0,0:06:41.12,0:06:45.62,Default,,0,0,0,,Иә. Мен Курононы да жіберген жоқпын.
Dialogue: 0,0:06:49.21,0:06:51.35,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:06:51.35,0:06:53.35,Default,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:06:55.52,0:06:59.20,Default,,0,0,0,,Егер ұтылып қалсаңыз, енді бірліктеріңізді мұндай нәрсе үшін пайдаланбаңыз.
Dialogue: 0,0:06:59.20,0:07:04.16,Default,,0,0,0,,Олай болса, жеңілсең, менің дұрыс айтқанымды мойындайсың ба?
Dialogue: 0,0:07:04.16,0:07:06.58,Default,,0,0,0,,Жоғалтпа
Dialogue: 0,0:07:06.58,0:07:09.88,Default,,0,0,0,,Менің Gear Chronicle-тен достарым бар.
Dialogue: 0,0:07:12.05,0:07:14.67,Default,,0,0,0,,ｽﾀﾝﾄﾞｱｯﾌﾟ ｳﾞｧﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:07:14.67,0:07:17.86,Default,,0,0,0,,ｸﾛﾉﾄﾞﾗﾝ！ ｶﾞﾝﾅｰｷﾞｱ･ﾄﾞﾗｺｷｯﾄﾞ
Dialogue: 0,0:07:17.86,0:07:21.49,Default,,0,0,0,,ﾗｲﾄﾞ ﾒｰｻﾞｰｷﾞｱ･ﾄﾞﾗｺﾞﾝ
Dialogue: 0,0:07:21.49,0:07:24.55,Default,,0,0,0,,ﾗｲﾄﾞ！ ﾀｲﾑﾌﾞﾚｲｸ･ﾄﾞﾗｺﾞﾝ
Dialogue: 0,0:07:24.55,0:07:27.55,Default,,0,0,0,,Сіз саз бірлігісіз➡
Dialogue: 0,0:07:27.55,0:07:30.40,Default,,0,0,0,,Ол оны өз амбицияларының құралы ретінде пайдалануға тырысады➡
Dialogue: 0,0:07:30.40,0:07:33.40,Default,,0,0,0,,Шынымды айтсам, мен басында түсінбедім.
Dialogue: 0,0:07:36.41,0:07:39.21,Default,,0,0,0,,Менің ойымша, бұл мұны білдіреді.
Dialogue: 0,0:07:41.96,0:07:45.82,Default,,0,0,0,,Мен бұл жігіттерге ешқашан жол бермеймін!
Dialogue: 0,0:07:45.82,0:07:47.82,Default,,0,0,0,,ｶﾞｰﾄﾞ
Dialogue: 0,0:07:47.82,0:07:50.54,Default,,0,0,0,,ﾗｲﾄﾞ ｽﾓｰｸｷﾞｱ･ﾄﾞﾗｺﾞﾝ
Dialogue: 0,0:07:50.54,0:07:55.71,Default,,0,0,0,,Авангардқа шабуыл жасау үшін Steam Knight-қа қоңырау шалыңыз
Dialogue: 0,0:07:55.71,0:07:57.71,Default,,0,0,0,,Бу демімен күзет!
Dialogue: 0,0:07:59.86,0:08:02.00,Default,,0,0,0,,бірліктерді айтамын➡
Dialogue: 0,0:08:02.00,0:08:04.75,Default,,0,0,0,,Мен адамдарға қирату әрекеттеріне жол бермеймін, өйткені олар маған ұнайды.
Dialogue: 0,0:08:04.75,0:08:08.55,Default,,0,0,0,,Сіз мұны қажет болғандықтан орындамайынша
Dialogue: 0,0:08:16.00,0:08:18.55,Default,,0,0,0,,Теме...
Dialogue: 0,0:08:18.55,0:08:20.53,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:08:20.53,0:08:23.50,Default,,0,0,0,,ﾗｲﾄﾞ！ ﾋｽﾄﾘｰﾒｰｶｰ･ﾄﾞﾗｺﾞﾝ
Dialogue: 0,0:08:23.50,0:08:25.54,Default,,0,0,0,,ｺｰﾙ
Dialogue: 0,0:08:25.54,0:08:28.54,Default,,0,0,0,,Авангард өте қызықты!
Dialogue: 0,0:08:28.54,0:08:30.88,Default,,0,0,0,,ｶﾞｰﾄﾞ
Dialogue: 0,0:08:30.88,0:08:33.76,Default,,0,0,0,,Драен тармағының адамдары➡
Dialogue: 0,0:08:33.76,0:08:36.17,Default,,0,0,0,,Осы уақытқа дейін кездестіргендердің барлығы➡
Dialogue: 0,0:08:36.17,0:08:40.05,Default,,0,0,0,,Авангардты жақсы көретін адамдар ғана болды.
Dialogue: 0,0:08:40.05,0:08:42.07,Default,,0,0,0,,Бұл жігіттер де➡
Dialogue: 0,0:08:42.07,0:08:46.19,Default,,0,0,0,,Біздің сезімдерімізге бейнелер арқылы жауап береді
Dialogue: 0,0:08:46.19,0:08:48.53,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ
Dialogue: 0,0:08:48.53,0:08:51.63,Default,,0,0,0,,Сіз оны шатастырдыңыз!
Dialogue: 0,0:08:54.20,0:08:56.69,Default,,0,0,0,,Барлығы нені бағалайды➡
Dialogue: 0,0:08:56.69,0:08:59.79,Default,,0,0,0,,Мен оны таптадым!
Dialogue: 0,0:09:01.89,0:09:04.03,Default,,0,0,0,,((Ха ха…
Dialogue: 0,0:09:04.03,0:09:07.00,Default,,0,0,0,,Әке, асығыңыз, асығыңыз!
Dialogue: 0,0:09:07.00,0:09:10.57,Default,,0,0,0,,Күте тұрыңыз, Куроно, сонша дүрбелеңге түсудің қажеті жоқ.
Dialogue: 0,0:09:10.57,0:09:14.17,Default,,0,0,0,,Бірлік! Бірлік, бүгін келесің бе? Сіз келесіз, солай ма? ))
Dialogue: 0,0:09:17.34,0:09:19.73,Default,,0,0,0,,Бұрылу және аяқтау дұрыс па?
Dialogue: 0,0:09:19.73,0:09:22.33,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:09:22.33,0:09:25.22,Default,,0,0,0,,ﾗｲﾄﾞ ｸﾛﾉﾌｧﾝｸﾞ･ﾀｲｶﾞｰ
Dialogue: 0,0:09:25.22,0:09:27.38,Default,,0,0,0,,ｺｰﾙ
Dialogue: 0,0:09:27.38,0:09:29.84,Default,,0,0,0,,Мен сіздің ашуыңызды түсінемін.
Dialogue: 0,0:09:29.84,0:09:33.66,Default,,0,0,0,,Бірақ қазір шегінсек не болады?
Dialogue: 0,0:09:33.66,0:09:36.03,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:09:36.03,0:09:41.03,Default,,0,0,0,,Дүниеде ештеңе өзгермейді...егер біз әрекет етпесек.
Dialogue: 0,0:09:41.03,0:09:44.00,Default,,0,0,0,,Мұның бәрі тек арман
Dialogue: 0,0:09:44.00,0:09:48.01,Default,,0,0,0,,Бір нәрсені өзгерткің келсе, алға ұмтылудан басқа амалың жоқ.
Dialogue: 0,0:09:48.01,0:09:50.02,Default,,0,0,0,,Мудалмен тұру
Dialogue: 0,0:09:50.02,0:09:53.12,Default,,0,0,0,,Мені кім сынаса да...
Dialogue: 0,0:09:58.92,0:10:03.52,Default,,0,0,0,,Мен осы жолмен жүремін
Dialogue: 0,0:10:06.22,0:10:08.56,Default,,0,0,0,,ﾀﾞﾒｰｼﾞﾁｪｯｸ…
Dialogue: 0,0:10:08.56,0:10:12.38,Default,,0,0,0,,((Тікелей эфир: Олай болса, біздің әлем сияқты➡
Dialogue: 0,0:10:12.38,0:10:15.00,Default,,0,0,0,,Бұл сазды құрбандыққа шалғандай!
Dialogue: 0,0:10:15.00,0:10:17.50,Default,,0,0,0,,Кемелді болашақ үшін))
Dialogue: 0,0:10:19.54,0:10:21.84,Default,,0,0,0,,Не болды?
Dialogue: 0,0:10:21.84,0:10:24.16,Default,,0,0,0,,Өтінемін, менен сөйлеспеңіз.
Dialogue: 0,0:10:24.16,0:10:27.86,Default,,0,0,0,,《Бұл не? Бұрынғыдан...
Dialogue: 0,0:10:27.86,0:10:30.51,Default,,0,0,0,,Қазір әкеммен...》
Dialogue: 0,0:10:30.51,0:10:33.03,Default,,0,0,0,,Мударумен шабуыл
Dialogue: 0,0:10:33.03,0:10:35.02,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:10:35.02,0:10:37.85,Default,,0,0,0,,ﾀｰﾝｴﾝﾄﾞ
Dialogue: 0,0:10:37.85,0:10:40.82,Default,,0,0,0,,ｽ… ｽﾀﾝﾄﾞｱﾝﾄﾞﾄﾞﾛｰ
Dialogue: 0,0:10:40.82,0:10:44.26,Default,,0,0,0,,ﾗｲﾄﾞ！ ｸﾛﾉｼﾞｪｯﾄ･ﾄﾞﾗｺﾞﾝ…
Dialogue: 0,0:10:44.26,0:10:48.55,Default,,0,0,0,,((Бүгін тарихта қалатын күн болады.
Dialogue: 0,0:10:48.55,0:10:54.02,Default,,0,0,0,,Крей планетасы мен біздің әлем алғаш рет физикалық байланыста болады.
Dialogue: 0,0:10:54.02,0:10:58.32,Default,,0,0,0,,Сіз тым жылдамсыз. Бұл әлі алдын ала эксперимент.))
Dialogue: 0,0:11:02.05,0:11:04.50,Default,,0,0,0,,Генерация аймағы шығарылды!
Dialogue: 0,0:11:04.50,0:11:06.72,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ
Dialogue: 0,0:11:06.72,0:11:08.70,Default,,0,0,0,,ﾜｰﾌﾟﾄﾞﾗｲﾌﾞ･ﾄﾞﾗｺﾞﾝ！
Dialogue: 0,0:11:08.70,0:11:11.49,Default,,0,0,0,,Авангард шабуылы...
Dialogue: 0,0:11:11.49,0:11:14.24,Default,,0,0,0,,((Тікелей эфир: Chrono мұқият қараңыз
Dialogue: 0,0:11:14.24,0:11:17.84,Default,,0,0,0,,Біздің жаңа болашағымыз осы жерден басталады))
Dialogue: 0,0:11:20.33,0:11:22.75,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ
Dialogue: 0,0:11:22.75,0:11:25.99,Default,,0,0,0,,Үш жетек… 2-сурет➡
Dialogue: 0,0:11:25.99,0:11:34.91,Default,,0,0,0,,Критикалық триггер. Қуат тепе-теңдікте, маңыздысы - дискіні бұрмалау...
Dialogue: 0,0:11:34.91,0:11:39.41,Default,,0,0,0,,)
Dialogue: 0,0:11:43.52,0:11:46.91,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:11:46.91,0:11:51.91,Default,,0,0,0,,Балифте... Авангардқа шабуыл...
Dialogue: 0,0:11:54.05,0:11:58.55,Default,,0,0,0,,)
Dialogue: 0,0:12:00.57,0:12:04.34,Default,,0,0,0,,Иә, мен білемін...
Dialogue: 0,0:12:04.34,0:12:08.44,Default,,0,0,0,,Бұл... Мен сол күні...
Dialogue: 0,0:12:12.37,0:12:16.00,Default,,0,0,0,,((Әке! Асығыңыз, асығыңыз!!
Dialogue: 0,0:12:16.00,0:12:19.21,Default,,0,0,0,,Күте тұрыңыз, Куроно. Сізге соншалықты дүрбелең қажет емес.
Dialogue: 0,0:12:19.21,0:12:21.88,Default,,0,0,0,,Бірлік… Бірлік бүгін келеді!?
Dialogue: 0,0:12:21.88,0:12:24.23,Default,,0,0,0,,Сіз келе жатырсыз, солай ма? Эй!?
Dialogue: 0,0:12:24.23,0:12:28.17,Default,,0,0,0,,Хмм... Бүгін әлі де алдын ала эксперимент.
Dialogue: 0,0:12:28.17,0:12:30.47,Default,,0,0,0,,Ах, эй, эй...
Dialogue: 0,0:12:33.07,0:12:35.54,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:12:35.54,0:12:38.39,Default,,0,0,0,,Кел, Пирс Мейкер
Dialogue: 0,0:12:38.39,0:12:42.91,Default,,0,0,0,,Льюс! Мені олай атама, ұят.
Dialogue: 0,0:12:42.91,0:12:48.91,Default,,0,0,0,,Әлемге шынайы бейбітшілік әкел. Менің ойымша, бұл дұрыс атау.
Dialogue: 0,0:12:52.16,0:12:56.71,Default,,0,0,0,,Сәлеметсіз бе, Льюес мырза
Dialogue: 0,0:12:56.71,0:13:02.70,Default,,0,0,0,,Сізді осында көргеніме қуаныштымын, Куроно. Өтінемін, бүгін маған жақсылап қараңызшы.
Dialogue: 0,0:13:02.70,0:13:07.50,Default,,0,0,0,,Біз үшін жаңа болашақ
Dialogue: 0,0:14:49.87,0:14:56.00,Default,,0,0,0,,Бүгін біз бұл әлемді Крей планетасымен байланыстыру үшін эксперимент жүргіземіз.
Dialogue: 0,0:14:56.00,0:14:59.53,Default,,0,0,0,,Әкеңнің бейнелеу қабілеті күшті.
Dialogue: 0,0:14:59.53,0:15:04.02,Default,,0,0,0,,Бұл күшті қарызға алып, уақыт пен кеңістіктен асып кетіңіз.
Dialogue: 0,0:15:04.02,0:15:07.52,Default,,0,0,0,,Бірлік Сіз қашан келесіз? Ол ұшып кете ме?
Dialogue: 0,0:15:07.52,0:15:13.48,Default,,0,0,0,,Мм, суретке түсірейік. Сурет?
Dialogue: 0,0:15:13.48,0:15:15.67,Default,,0,0,0,,Оны өз ойыңда елестет
Dialogue: 0,0:15:15.67,0:15:20.70,Default,,0,0,0,,Екі дүниенің арасында туннель құрылып, ол арқылы бірліктер өтеді.
Dialogue: 0,0:15:20.70,0:15:23.49,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:23.49,0:15:27.19,Default,,0,0,0,,Бұл ұзын, ұзын туннель.
Dialogue: 0,0:15:27.19,0:15:32.12,Default,,0,0,0,,Жарық өшетін жерлер бар... Қайсысы?
Dialogue: 0,0:15:32.12,0:15:37.57,Default,,0,0,0,,Эй, мынау! Хоора
Dialogue: 0,0:15:37.57,0:15:39.57,Default,,0,0,0,,Спорт күні керемет өтті, иә?
Dialogue: 0,0:15:41.68,0:15:46.10,Default,,0,0,0,,Керемет! Келе жатыр, бірлік. Эй, келе жатыр!
Dialogue: 0,0:15:46.10,0:15:47.98,Default,,0,0,0,,Бірақ келесі жолы
Dialogue: 0,0:15:47.98,0:15:51.35,Default,,0,0,0,,Синдо мырза, уақыт келді... Ах.
Dialogue: 0,0:15:51.35,0:15:55.15,Default,,0,0,0,,Олай болса, әке, мен сізге бір жұмыс істеп берейін.
Dialogue: 0,0:15:57.86,0:16:00.78,Default,,0,0,0,,≪Қадам күшін күшейту
Dialogue: 0,0:16:00.78,0:16:04.40,Default,,0,0,0,,≪Деңгейді көтеру кері кері санауды бастау
Dialogue: 0,0:16:04.40,0:16:07.00,Default,,0,0,0,,≪Стрид материясының пайда болуын растау
Dialogue: 0,0:16:09.84,0:16:13.36,Default,,0,0,0,,Сигнал жалғасуда. Саны тұрақты.
Dialogue: 0,0:16:13.36,0:16:16.51,Default,,0,0,0,,≪Аумақты кеңейту Виртуалды қақпаны кеңейту
Dialogue: 0,0:16:16.51,0:17:05.53,Default,,0,0,0,,♪♪～
Dialogue: 0,0:17:05.53,0:17:07.99,Default,,0,0,0,,≪ｺ… ｺﾝﾀｸﾄ
Dialogue: 0,0:17:07.99,0:17:11.08,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:17:11.08,0:17:14.18,Default,,0,0,0,,Мен мұны жасадым ... мен жасадым!
Dialogue: 0,0:17:16.59,0:17:18.69,Default,,0,0,0,,Уф~
Dialogue: 0,0:17:20.86,0:17:24.36,Default,,0,0,0,,Бұл Крей планетасы...
Dialogue: 0,0:17:24.36,0:17:29.72,Default,,0,0,0,,Біз қосылдық. Сол жұлдыздың тағдырлы күші ғана қалды➡
Dialogue: 0,0:17:29.72,0:17:32.87,Default,,0,0,0,,Біздің әлемге құйсаңыз➡
Dialogue: 0,0:17:32.87,0:17:37.26,Default,,0,0,0,,Кемел болашаққа жетелеу
Dialogue: 0,0:17:37.26,0:17:40.53,Default,,0,0,0,,Келісім жасасамыз ба?
Dialogue: 0,0:17:40.53,0:17:43.40,Default,,0,0,0,,Мен мұндайды естіген жоқпын!
Dialogue: 0,0:17:43.40,0:17:46.48,Default,,0,0,0,,Олай болса, біздің әлем сияқты➡
Dialogue: 0,0:17:46.48,0:17:49.04,Default,,0,0,0,,Бұл сазды құрбандыққа шалғандай емес пе?
Dialogue: 0,0:17:49.04,0:17:51.67,Default,,0,0,0,,Кемелді болашақ үшін
Dialogue: 0,0:17:51.67,0:17:55.88,Default,,0,0,0,,Құрбандық қажет екенін білмедің бе?
Dialogue: 0,0:17:55.88,0:17:57.83,Default,,0,0,0,,Шкаласы тым басқа!
Dialogue: 0,0:17:57.83,0:18:01.65,Default,,0,0,0,,Мен басып алғым келген болашақ бұл емес еді!
Dialogue: 0,0:18:01.65,0:18:04.70,Default,,0,0,0,,Сабыр ет, өмір сүр, мені тыңда.
Dialogue: 0,0:18:04.70,0:18:09.32,Default,,0,0,0,,Крей планетасы жүздеген миллион тіршілік формаларының қарғысына ұшырайды➡
Dialogue: 0,0:18:09.32,0:18:14.86,Default,,0,0,0,,Мен осы жолды таңдауды шештім. (Тікелей эфир) Мен өзімшіл нәрсе жасадым ...
Dialogue: 0,0:18:14.86,0:18:16.86,Default,,0,0,0,,≪Қайда?
Dialogue: 0,0:18:16.86,0:18:20.20,Default,,0,0,0,,Менің арманым орындалып жатыр!? Бірақ...
Dialogue: 0,0:18:20.20,0:18:23.64,Default,,0,0,0,,≪Қайда?
Dialogue: 0,0:18:23.64,0:18:27.51,Default,,0,0,0,,≪Анықтама... Мен қайдамын?
Dialogue: 0,0:18:27.51,0:18:31.53,Default,,0,0,0,,≪Шыға алмаймын... Біреу!
Dialogue: 0,0:18:31.53,0:18:33.68,Default,,0,0,0,,Оны бейнелеп көріңіз
Dialogue: 0,0:18:33.68,0:18:35.68,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:40.87,0:18:43.21,Default,,0,0,0,,《Біреу... бар ма? 》
Dialogue: 0,0:18:43.21,0:18:46.69,Default,,0,0,0,,Міне!
Dialogue: 0,0:18:46.69,0:18:50.10,Default,,0,0,0,,《Не істеп жатырсың? 》
Dialogue: 0,0:18:50.10,0:18:54.00,Default,,0,0,0,,Мен бұрмаланып қалдым... Көмектесіңізші!
Dialogue: 0,0:18:54.00,0:18:57.44,Default,,0,0,0,,Қай жолмен жүруім керек?
Dialogue: 0,0:18:57.44,0:19:00.74,Default,,0,0,0,,《Кел, мен осындамын》
Dialogue: 0,0:19:04.54,0:19:07.04,Default,,0,0,0,,Сіз ше?
Dialogue: 0,0:19:09.07,0:19:13.17,Default,,0,0,0,,Куроно...Синдо Куроно
Dialogue: 0,0:19:13.17,0:19:17.91,Default,,0,0,0,,Түсіндім... Сізді Куроно деп те атайды.
Dialogue: 0,0:19:17.91,0:19:20.51,Default,,0,0,0,,Өзі ешқашан Ал Майтты басып оза алмайтынын түсінген әкем—
Dialogue: 0,0:19:28.82,0:19:31.52,Default,,0,0,0,,(Ескерту)
Dialogue: 0,0:19:31.52,0:19:33.92,Default,,0,0,0,,≪Стрид материясы Жылдам өсуде!
Dialogue: 0,0:19:33.92,0:19:37.92,Default,,0,0,0,,≪Масса виртуалды қақпада жасалады! ≪Сіз аударыласыз!
Dialogue: 0,0:20:04.82,0:20:09.33,Default,,0,0,0,,Бұл керемет
Dialogue: 0,0:20:09.33,0:20:13.66,Default,,0,0,0,,Бұл үлкен өмір. Біздің бейбітшілік орнатушымыз
Dialogue: 0,0:20:13.66,0:20:15.87,Default,,0,0,0,,Сіз жай ғана Клей мен кеңістік-уақытты қостыңыз ба➡
Dialogue: 0,0:20:15.87,0:20:21.65,Default,,0,0,0,,Бірлікке дейін. Сіз құтқарушы боласыз.
Dialogue: 0,0:20:21.65,0:20:27.36,Default,,0,0,0,,Оның аты - Куроно Доран. Оның есімі менімен бірдей.
Dialogue: 0,0:20:27.36,0:20:31.33,Default,,0,0,0,,Куроно сен...
Dialogue: 0,0:20:31.33,0:20:34.13,Default,,0,0,0,,Эххе
Dialogue: 0,0:20:36.35,0:20:39.91,Default,,0,0,0,,Сіз не істеп жатырсыз? Тәуелді картаны дайындаңыз.
Dialogue: 0,0:20:39.91,0:20:43.04,Default,,0,0,0,,Оны ұстаңыз және оны мұқият тергеңіз.
Dialogue: 0,0:20:43.04,0:20:50.00,Default,,0,0,0,,Біз басқа зодиак аңдарын да ұстауымыз керек.
Dialogue: 0,0:20:50.00,0:20:53.85,Default,,0,0,0,,Тікелей эфир! Сол бірлікті ұстаңыз
Dialogue: 0,0:20:53.85,0:20:57.52,Default,,0,0,0,,Дұрыс, ол адамды қалай шақырдыңыз?➡
Dialogue: 0,0:20:57.52,0:21:00.49,Default,,0,0,0,,Механизмді түсіндіру керек
Dialogue: 0,0:21:00.49,0:21:03.58,Default,,0,0,0,,Кешіріңіз, бірақ Fighter толығымен жабылады.
Dialogue: 0,0:21:03.58,0:21:06.07,Default,,0,0,0,,Сәлем Куроно Доран
Dialogue: 0,0:21:06.07,0:21:08.87,Default,,0,0,0,,Сіздің тәуелді картаңыз бар ма?
Dialogue: 0,0:21:16.71,0:21:19.11,Default,,0,0,0,,Не істеп жатырсың, Синдо-сан?
Dialogue: 0,0:21:19.11,0:21:21.66,Default,,0,0,0,,Live Не істеу керек!
Dialogue: 0,0:21:21.66,0:21:30.04,Default,,0,0,0,,♪♪～
Dialogue: 0,0:21:30.04,0:21:34.49,Default,,0,0,0,,Қадамдық күшті жылдам күшейту! Мен тоқтай алмаймын реакция!
Dialogue: 0,0:21:34.49,0:21:38.36,Default,,0,0,0,,≪Виртуалды қақпада шу пайда болады!
Dialogue: 0,0:21:38.36,0:21:42.37,Default,,0,0,0,,≪Жоқ, мен оны басқара алмаймын!
Dialogue: 0,0:21:42.37,0:21:45.84,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:45.84,0:21:52.86,Default,,0,0,0,,♪♪～
Dialogue: 0,0:21:52.86,0:21:55.52,Default,,0,0,0,,Тікелей эфир! Сіз...
Dialogue: 0,0:21:55.52,0:22:11.02,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:32.70,0:22:37.32,Default,,0,0,0,,♬~
Dialogue: 0,0:22:37.32,0:22:39.39,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:22:39.39,0:22:42.90,Default,,0,0,0,,Сіз бұл блокпен не істеуді жоспарлайсыз?
Dialogue: 0,0:22:42.90,0:22:46.20,Default,,0,0,0,,Тоқта! Тірі!!
Dialogue: 0,0:22:48.20,0:22:51.89,Default,,0,0,0,,Неге... неге маған опасыздық жасайсың!?
Dialogue: 0,0:22:51.89,0:22:55.19,Default,,0,0,0,,Тікелей күтіңіз! Тірі!!
Dialogue: 0,0:22:58.69,0:23:01.05,Default,,0,0,0,,Менің... кінәм бар ма?
Dialogue: 0,0:23:01.05,0:23:06.34,Default,,0,0,0,,Оны ұмыт, Куроно. Мұнда ештеңе болған жоқ.
Dialogue: 0,0:23:06.34,0:23:11.54,Default,,0,0,0,,Себебі мен... ол қызды шақырдым...
Dialogue: 0,0:23:11.54,0:23:15.21,Default,,0,0,0,,Сен ештеңе істеген жоқсың, ұмыт.
Dialogue: 0,0:23:15.21,0:23:19.81,Default,,0,0,0,,Бірлік пен Авангард туралы бәрі...))
Dialogue: 0,0:23:26.76,0:23:29.69,Default,,0,0,0,,Тіке менімен ғана қашты
Dialogue: 0,0:23:29.69,0:23:33.88,Default,,0,0,0,,Маған қоңырау шалғаныңызды жұртқа білдірмеңіз
Dialogue: 0,0:23:33.88,0:23:37.55,Default,,0,0,0,,Бірақ мен бұл дүниеге кенеттен келдім➡
Dialogue: 0,0:23:37.55,0:23:40.00,Default,,0,0,0,,Өте тұрақсыз...
Dialogue: 0,0:23:40.00,0:23:44.54,Default,,0,0,0,,Live мені қолдауды жалғастыру үшін өмірін құрбан етті.
Dialogue: 0,0:23:44.54,0:23:49.08,Default,,0,0,0,,Осыған байланысты Live енді қозғала алмайды.
Dialogue: 0,0:23:49.08,0:23:54.03,Default,,0,0,0,,Мен тікелей эфирде өз күшіммен күресуді мақсат еттім.
Dialogue: 0,0:23:54.03,0:23:58.55,Default,,0,0,0,,Бірақ бір-бірімізді шақырған уақыт пен кеңістіктің өтуі➡ туды
Dialogue: 0,0:23:58.55,0:24:03.68,Default,,0,0,0,,Сізге ғана ашылады
Dialogue: 0,0:24:03.68,0:24:08.36,Default,,0,0,0,,Куроно Сізде сәл күштірек сурет бар➡
Dialogue: 0,0:24:08.36,0:24:11.85,Default,,0,0,0,,Олар барлық жерде адам баласы.
Dialogue: 0,0:24:11.85,0:24:17.21,Default,,0,0,0,,Біздің кездесу сізді ерекше етті.
Dialogue: 0,0:24:17.21,0:24:22.53,Default,,0,0,0,,Сол күні салынған көпір әлі күнге дейін екі дүниені байланыстырып тұр.
Dialogue: 0,0:24:22.53,0:24:26.90,Default,,0,0,0,,Льюес оны күшпен ашу үшін жиналған адым күшін пайдаланады➡
Dialogue: 0,0:24:26.90,0:24:32.04,Default,,0,0,0,,Бірлікті шақырды
Dialogue: 0,0:24:32.04,0:24:35.66,Default,,0,0,0,,Сіздің тәуелді картаңыз дұрыс жұмыс істеген жалғыз карта болды➡
Dialogue: 0,0:24:35.66,0:24:40.55,Default,,0,0,0,,Бұл біз бұрыннан кездескендіктен.
Dialogue: 0,0:24:40.55,0:24:45.87,Default,,0,0,0,,Сен оны ояттың, мен әлі де осында бола аламын.
Dialogue: 0,0:24:45.87,0:24:48.99,Default,,0,0,0,,Мен мұны мәңгі жасаймын➡
Dialogue: 0,0:24:48.99,0:24:52.19,Default,,0,0,0,,Мен оны қалай қолдану керектігін білмедім.
Dialogue: 0,0:24:52.19,0:24:56.33,Default,,0,0,0,,Тікелей эфирде берілген кеңестер сізді қорғады.
Dialogue: 0,0:24:56.33,0:25:02.39,Default,,0,0,0,,Бірақ алға ұмтылу өз еркіңіз➡
Dialogue: 0,0:25:02.39,0:25:06.86,Default,,0,0,0,,Мен бұғауларды бұздым.
Dialogue: 0,0:25:06.86,0:25:12.41,Default,,0,0,0,,Егер сіз қоңырау шалсаңыз, мен және менің достарым уақыт пен кеңістікте асығамыз.
Dialogue: 0,0:25:12.41,0:25:15.51,Default,,0,0,0,,Міндетті түрде.
Dialogue: 0,0:25:17.55,0:25:20.15,Default,,0,0,0,,Біздің әлем үшін➡
Dialogue: 0,0:25:20.15,0:25:23.21,Default,,0,0,0,,Крэй планетасындағы барлық нәрсені құрбан ету➡
Dialogue: 0,0:25:23.21,0:25:28.49,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:25:28.49,0:25:32.20,Default,,0,0,0,,Екі дүниені байланыстыратын тағдырдың құдіреті
Dialogue: 0,0:25:32.20,0:25:37.89,Default,,0,0,0,,Льюес тепе-теңдікті еңкейтуге тырысады.
Dialogue: 0,0:25:37.89,0:25:41.91,Default,,0,0,0,,Дүниенің бар жақсылығы
Dialogue: 0,0:25:41.91,0:25:47.51,Default,,0,0,0,,Және барлық зұлымдықтар...
Dialogue: 0,0:25:52.82,0:25:58.32,Default,,0,0,0,,Сіз Сіз...
Dialogue: 0,0:25:58.32,0:26:05.25,Default,,0,0,0,,Бұл дүние үшін құрбандық...
Dialogue: 0,0:26:05.25,0:26:11.55,Default,,0,0,0,,Бірлік қана емес, Крей планетасының өзі...
Dialogue: 0,0:26:13.71,0:26:17.41,Default,,0,0,0,,Ақымақ болма! Мен мұндай еліктеуді кешіре алмаймын!
Dialogue: 0,0:26:17.41,0:26:35.91,Default,,0,0,0,,♪♪～
Dialogue: 0,0:30:38.85,0:30:41.97,Default,,0,0,0,,<1995 жылы басталды➡
Dialogue: 0,0:30:41.97,0:30:46.35,Default,,0,0,0,,Бұл бағдарлама биыл сәуірде өзінің 22-ші жылын атап өтті.
Dialogue: 0,0:30:46.35,0:30:49.92,Default,,0,0,0,,Ол алғаш пайда болған қала Даканьяма болды.
Dialogue: 0,0:30:49.92,0:30:53.49,Default,,0,0,0,,Содан бері уақыт өтті, 2016 ж
Dialogue: 0,0:30:53.49,0:30:58.32,Default,,0,0,0,,Бұл жолы біз сізді соңғы Дайканямаға апарамыз
Dialogue: 0,0:30:59.82,0:31:05.82,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory