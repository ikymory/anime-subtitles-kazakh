Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:08.12,0:01:12.16,Default,,0,0,0,,Филиал менеджерлері мен Мамору-сан, жақсысыңдар ма?
Dialogue: 0,0:01:12.16,0:01:14.11,Default,,0,0,0,,Уайымдау…
Dialogue: 0,0:01:14.11,0:01:17.48,Default,,0,0,0,,Бұдан былай Драен тармағымен не болады?
Dialogue: 0,0:01:17.48,0:01:19.47,Default,,0,0,0,,(шу)
Dialogue: 0,0:01:19.47,0:01:21.47,Default,,0,0,0,,Мю~!
Dialogue: 0,0:01:21.47,0:01:23.77,Default,,0,0,0,,Уау!!
Dialogue: 0,0:01:27.14,0:01:29.29,Default,,0,0,0,,ｻｰﾔ！
Dialogue: 0,0:01:29.29,0:01:33.79,Default,,0,0,0,,Мю!!
Dialogue: 0,0:01:36.33,0:01:39.47,Default,,0,0,0,,ﾊｰｲ ｴﾌﾞﾘﾊﾞﾃﾞｨｰ！
Dialogue: 0,0:01:39.47,0:01:41.97,Default,,0,0,0,,Бұл Лиза Феррис пе!?
Dialogue: 0,0:01:45.99,0:01:49.63,Default,,0,0,0,,Уфуфу Қайырлы күн баршаңызға
Dialogue: 0,0:01:49.63,0:01:51.93,Default,,0,0,0,,Бұл Реми Альтена!
Dialogue: 0,0:01:56.54,0:02:00.84,Default,,0,0,0,,Дүние жүзінде белсенді жұмыс істейтін үш Авангард кумирі бар!
Dialogue: 0,0:02:04.26,0:02:06.30,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:02:06.30,0:02:09.17,Default,,0,0,0,,Иә, жүрегім ауырады.
Dialogue: 0,0:02:09.17,0:02:15.47,Default,,0,0,0,,Сараның және басқалардың күшімен біз міндетті түрде барлығын бақытты етеміз!
Dialogue: 0,0:05:27.45,0:05:32.15,Default,,0,0,0,,Керемет, сахна жақындап қалды...
Dialogue: 0,0:05:32.15,0:05:34.49,Default,,0,0,0,,Бірақ Саая мырза. Myu?
Dialogue: 0,0:05:34.49,0:05:39.63,Default,,0,0,0,,Егер есімде дұрыс болса, мен Дүниежүзілік тур кезінде Сингапурда болдым...
Dialogue: 0,0:05:39.63,0:05:41.98,Default,,0,0,0,,Барлығын жақсы сезіну үшін➡
Dialogue: 0,0:05:41.98,0:05:44.85,Default,,0,0,0,,Саая, маған әрқашан асық!
Dialogue: 0,0:05:44.85,0:05:49.49,Default,,0,0,0,,Сонымен қатар, Драен мырза филиалының бастығы маған жақын арада бірдеңе істеуімді өтінді.
Dialogue: 0,0:05:49.49,0:05:52.49,Default,,0,0,0,,Бағдарлама кезеңінің барысы➡
Dialogue: 0,0:05:52.49,0:05:55.56,Default,,0,0,0,,Мұның бәрі Сааяның идеясы.
Dialogue: 0,0:05:55.56,0:06:00.48,Default,,0,0,0,,Егер біз мұны жасайтын болсақ, біз оны әрбір адамның жүрегінде қалатын ең жақсы оқиғаға айналдырамыз!
Dialogue: 0,0:06:00.48,0:06:02.82,Default,,0,0,0,,ｻｰﾔ…
Dialogue: 0,0:06:02.82,0:06:06.65,Default,,0,0,0,,Бұрын Мен мұнда оқиға болған кезде➡
Dialogue: 0,0:06:06.65,0:06:10.81,Default,,0,0,0,,Әр адамнан көп жылы лебіздер алдым.
Dialogue: 0,0:06:10.81,0:06:16.61,Default,,0,0,0,,Сол кездегі сезімдерім әлі күнге дейін асыл қазынам.
Dialogue: 0,0:06:19.65,0:06:22.62,Default,,0,0,0,,Сондықтан мен жақсылықты қайтарғым келеді.
Dialogue: 0,0:06:22.62,0:06:25.66,Default,,0,0,0,,Барлығы бақытты бола алатын көңілді Драен тармағы➡
Dialogue: 0,0:06:25.66,0:06:28.14,Default,,0,0,0,,Мен оны мүмкіндігінше тезірек қайтарғым келеді!
Dialogue: 0,0:06:28.14,0:06:30.18,Default,,0,0,0,,Құдай-ай!! Одан құтыла алмай жатырмын!!
Dialogue: 0,0:06:30.18,0:06:32.83,Default,,0,0,0,,Барлық Авангард әуесқойларының көңілін көтеру үшін➡
Dialogue: 0,0:06:32.83,0:06:34.95,Default,,0,0,0,,Бұл біздің міндетіміз.
Dialogue: 0,0:06:34.95,0:06:40.37,Default,,0,0,0,,Біз барлықтарыңызды Авангард махаббатымызбен күлдіреміз.
Dialogue: 0,0:06:40.37,0:06:42.82,Default,,0,0,0,,ﾘｻ ﾚﾐｰ
Dialogue: 0,0:06:42.82,0:06:45.53,Default,,0,0,0,,Рахмет Дамю~!!
Dialogue: 0,0:06:45.53,0:06:47.53,Default,,0,0,0,,Хехехе ахахха
Dialogue: 0,0:06:55.15,0:06:58.44,Default,,0,0,0,,Драен филиалы Қашан қалыпты жағдайға оралады?
Dialogue: 0,0:06:58.44,0:07:00.66,Default,,0,0,0,,Бұл газ жарылысы ма?
Dialogue: 0,0:07:00.66,0:07:03.51,Default,,0,0,0,,Егер ол осылай бұзылса, мен ештеңе істей алмаймын.
Dialogue: 0,0:07:03.51,0:07:05.43,Default,,0,0,0,,Міне➡
Dialogue: 0,0:07:05.43,0:07:09.87,Default,,0,0,0,,Әйтеуір, нағыз бөлімше шығып, ғимаратты бүлдірді.
Dialogue: 0,0:07:09.87,0:07:11.95,Default,,0,0,0,,Бұл дұрыс болуы мүмкін емес.
Dialogue: 0,0:07:11.95,0:07:14.95,Default,,0,0,0,,Ондай қауесеттерге сенбеңіз. Иә...
Dialogue: 0,0:07:17.16,0:07:19.53,Default,,0,0,0,,Мю~ Барлығы!
Dialogue: 0,0:07:19.53,0:07:24.18,Default,,0,0,0,,Айдаһар империясының филиалы төтенше жағдай туралы хабарландыру!
Dialogue: 0,0:07:24.18,0:07:26.78,Default,,0,0,0,,Саая!? [Монитор] (Саая) Аты...
Dialogue: 0,0:07:30.45,0:07:33.66,Default,,0,0,0,,Бұл екі адам Сараны қолдайды
Dialogue: 0,0:07:33.66,0:07:35.79,Default,,0,0,0,,Сәлем Лиза Феррис
Dialogue: 0,0:07:35.79,0:07:38.31,Default,,0,0,0,,Қазір Калифорниядан келеді
Dialogue: 0,0:07:38.31,0:07:41.20,Default,,0,0,0,,Әрине, барлығымен кездесу үшін.
Dialogue: 0,0:07:41.20,0:07:43.23,Default,,0,0,0,,Бұл Реми Альтена.
Dialogue: 0,0:07:43.23,0:07:45.49,Default,,0,0,0,,Мен Бельгиядан ұшып келдім.
Dialogue: 0,0:07:45.49,0:07:48.86,Default,,0,0,0,,Мен барлығымен тезірек кездескім келеді.
Dialogue: 0,0:07:48.86,0:07:54.13,Default,,0,0,0,,Бұл оқиға әртүрлі жобаларға толы, соның ішінде Vanguard.
Dialogue: 0,0:07:54.13,0:07:58.55,Default,,0,0,0,,Ал басты оқиға Сара және басқалар үшін үлкен жетістік болады➡
Dialogue: 0,0:07:58.55,0:08:00.43,Default,,0,0,0,,Дамюдың ерекше кезеңі!
Dialogue: 0,0:08:00.43,0:08:02.65,Default,,0,0,0,,[Монитор] (Сая) Саяның жүрегі әрқашан➡
Dialogue: 0,0:08:02.65,0:08:05.62,Default,,0,0,0,,Біз Авангардты жақсы көретіндердің барлығымен біргеміз.
Dialogue: 0,0:08:05.62,0:08:08.31,Default,,0,0,0,,Біз сізді қолдаймыз.
Dialogue: 0,0:08:08.31,0:08:11.48,Default,,0,0,0,,Келіңіздер, Авангардпен бірге сау болыңыздар! Денің сау болсын!
Dialogue: 0,0:08:11.48,0:08:14.35,Default,,0,0,0,,Сіздің күлімсіреуіңіз жылуды тудырады
Dialogue: 0,0:08:14.35,0:08:17.40,Default,,0,0,0,,[Монитор] (Риса) Кез келген зақым дереу қалпына келтіріледі.
Dialogue: 0,0:08:17.40,0:08:20.29,Default,,0,0,0,,Сарамен және басқалармен бірге жаңа болашақты құрайық!
Dialogue: 0,0:08:20.29,0:08:23.47,Default,,0,0,0,,Барлығымыз Vanguard ойынын қызықты етейік!
Dialogue: 0,0:08:23.47,0:08:27.99,Default,,0,0,0,,Мен сізді Бақытты Ван күзетшілері фестивалінде күтемін.
Dialogue: 0,0:08:27.99,0:08:31.59,Default,,0,0,0,,Қызық көрінеді! кеттік
Dialogue: 0,0:08:36.55,0:08:43.18,Default,,0,0,0,,♪♪～
Dialogue: 0,0:08:43.18,0:08:47.11,Default,,0,0,0,,Шабуыл! рақмет сізге!
Dialogue: 0,0:08:47.11,0:08:50.15,Default,,0,0,0,,Celebrate Voice Rollis көмегімен шабуыл!
Dialogue: 0,0:08:50.15,0:08:52.27,Default,,0,0,0,,Мю!!
Dialogue: 0,0:08:52.27,0:08:56.49,Default,,0,0,0,,Prism Image Sunshine Vale көмегімен динамикалық шабуыл!
Dialogue: 0,0:08:56.49,0:08:58.98,Default,,0,0,0,,ﾀﾞｲﾅﾏｲﾂ!!
Dialogue: 0,0:08:58.98,0:09:02.61,Default,,0,0,0,,Этвалл Оливия мектебіне шабуыл
Dialogue: 0,0:09:02.61,0:09:05.15,Default,,0,0,0,,ｵﾘﾋﾞｰｱ！
Dialogue: 0,0:09:05.15,0:09:09.55,Default,,0,0,0,,Рахмет! Мю~
Dialogue: 0,0:09:09.55,0:09:20.65,Default,,0,0,0,,♪♪～
Dialogue: 0,0:09:22.65,0:09:24.98,Default,,0,0,0,,Бұл жарнамаға тұрарлық болды.
Dialogue: 0,0:09:24.98,0:09:27.27,Default,,0,0,0,,Ауа райы жақсы болатын сияқты ➡
Dialogue: 0,0:09:27.27,0:09:30.99,Default,,0,0,0,,Сахнада тікелей эфирде өнер көрсету ғана қалды.
Dialogue: 0,0:09:30.99,0:09:34.48,Default,,0,0,0,,Иә, оқиға әлі алда!
Dialogue: 0,0:09:34.48,0:09:39.08,Default,,0,0,0,,《Маған қарашы, аға, әпке》
Dialogue: 0,0:11:29.48,0:11:33.15,Default,,0,0,0,,Мен кеудемдегі ауырсынуды тоқтата алмаймын!
Dialogue: 0,0:11:33.15,0:11:35.15,Default,,0,0,0,,Әй?
Dialogue: 0,0:11:35.15,0:11:38.15,Default,,0,0,0,,≪Да~ Гахахахаха!
Dialogue: 0,0:11:40.32,0:11:43.79,Default,,0,0,0,,Қара Бангаро келді!
Dialogue: 0,0:11:43.79,0:11:48.16,Default,,0,0,0,,Эх!! Қандай көңілді Авангард.
Dialogue: 0,0:11:48.16,0:11:51.01,Default,,0,0,0,,Арман? байланыс? болашақ?
Dialogue: 0,0:11:51.01,0:11:54.62,Default,,0,0,0,,Мұның бәрі өтірік!
Dialogue: 0,0:11:54.62,0:11:57.15,Default,,0,0,0,,Авангардты жою➡
Dialogue: 0,0:11:57.15,0:12:01.74,Default,,0,0,0,,Мен барлығын үмітсіздіктің тереңіне итеремін!
Dialogue: 0,0:12:01.74,0:12:03.74,Default,,0,0,0,,Мен саған бұлай істеуге рұқсат бермеймін! иә?
Dialogue: 0,0:12:07.01,0:12:09.01,Default,,0,0,0,,О, Омяара!?
Dialogue: 0,0:12:10.93,0:12:14.65,Default,,0,0,0,,Бұл Мегаланикадан келген әзіл...
Dialogue: 0,0:12:14.65,0:12:17.29,Default,,0,0,0,,ﾏｰﾒｲﾄﾞﾌﾟﾘﾝｾｽ！
Dialogue: 0,0:12:17.29,0:12:22.31,Default,,0,0,0,,Мен ғаламдағы барлық адамдарды Сахианың түсіне бояймын.
Dialogue: 0,0:12:22.31,0:12:24.65,Default,,0,0,0,,ﾎｯﾌﾟ ｽﾃｯﾌﾟ…
Dialogue: 0,0:12:24.65,0:12:27.52,Default,,0,0,0,,Әлемді жаулап ал!
Dialogue: 0,0:12:27.52,0:12:29.80,Default,,0,0,0,,ﾊｰｲ ｴﾌﾞﾘﾊﾞﾃﾞｨｰ！
Dialogue: 0,0:12:29.80,0:12:34.69,Default,,0,0,0,,Сексуалдық динамика Мегаланикадан туған, Лиза Фелис
Dialogue: 0,0:12:34.69,0:12:36.99,Default,,0,0,0,,Сенің жүрегің...
Dialogue: 0,0:12:36.99,0:12:39.85,Default,,0,0,0,,ｲｰｸﾞﾙｷｬｯﾁ！
Dialogue: 0,0:12:39.85,0:12:45.48,Default,,0,0,0,,Сәлеметсіз бе, мен вафлиді жақсы көремін. Мегаланиканың тыныштандыратын періштесі➡
Dialogue: 0,0:12:45.48,0:12:49.31,Default,,0,0,0,,Бұл Реми Альтена. Барлығына жеткізу ...
Dialogue: 0,0:12:49.31,0:12:52.29,Default,,0,0,0,,ﾜｯﾌﾙｽﾏｲﾙ！
Dialogue: 0,0:12:52.29,0:12:57.81,Default,,0,0,0,,Бүгінгі теңізшілер – барлығының күлкісін қорғайтын Авангардтар және әділет күрескерлері.
Dialogue: 0,0:12:57.81,0:13:01.15,Default,,0,0,0,,ﾗﾌﾞﾘｰﾄﾗｲｱﾝｸﾞﾙ！
Dialogue: 0,0:13:01.15,0:13:03.27,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:13:03.27,0:13:06.99,Default,,0,0,0,,Қара Вангаро Мен саған қалағаныңды істеуге рұқсат бермеймін!
Dialogue: 0,0:13:06.99,0:13:08.94,Default,,0,0,0,,Дайын болыңыз!
Dialogue: 0,0:13:08.94,0:13:11.78,Default,,0,0,0,,Біз Авангардты қорғаймыз!
Dialogue: 0,0:13:11.78,0:13:15.82,Default,,0,0,0,,Да~ Гахахахаха! Бұл ақылсыз!
Dialogue: 0,0:13:15.82,0:13:18.72,Default,,0,0,0,,Кәне, минондар!
Dialogue: 0,0:13:18.72,0:13:21.62,Default,,0,0,0,,Ха! Хехе!
Dialogue: 0,0:13:21.62,0:13:23.62,Default,,0,0,0,,Қарғыс атсын, бұл қорқақ...
Dialogue: 0,0:13:23.62,0:13:25.67,Default,,0,0,0,,Мен жеңілдеп қалдым!
Dialogue: 0,0:13:25.67,0:13:29.77,Default,,0,0,0,,Бізде бақытты гүл бар!
Dialogue: 0,0:13:33.63,0:13:38.77,Default,,0,0,0,,Әй, бұл Авангард жауынгерлерінің армандары мен үміттерінің жемісі!
Dialogue: 0,0:13:38.77,0:13:43.64,Default,,0,0,0,,Осындай нәрсе гүлдегенде, көңілді сезім есіме түседі➡
Dialogue: 0,0:13:43.64,0:13:46.01,Default,,0,0,0,,Ол жоғалады!
Dialogue: 0,0:13:46.01,0:13:48.31,Default,,0,0,0,,Жарқын болашаққа үміт пен...
Dialogue: 0,0:13:48.31,0:13:52.22,Default,,0,0,0,,Егер сіз көңілді Авангардқа деген сезімдеріңізді қатты елестетсеңіз...
Dialogue: 0,0:13:52.22,0:13:55.02,Default,,0,0,0,,Бақытты гүл жайнап тұр!
Dialogue: 0,0:13:57.49,0:14:00.63,Default,,0,0,0,,Жарайды, төбелесіп көрейік...
Dialogue: 0,0:14:00.63,0:14:03.15,Default,,0,0,0,,Гүлдер ашылды!
Dialogue: 0,0:14:03.15,0:14:06.82,Default,,0,0,0,,Сондықтан бәріңіз Сараны және басқаларды қолдаңыздар!
Dialogue: 0,0:14:06.82,0:14:08.93,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:14:08.93,0:14:11.34,Default,,0,0,0,,Хмф! Қанша тырыссаңыздар да➡
Dialogue: 0,0:14:11.34,0:14:14.87,Default,,0,0,0,,Бақытты гүлдің ашылуы мүмкін емес!
Dialogue: 0,0:14:14.87,0:14:19.31,Default,,0,0,0,,Олай болса, мен саған өзімді көрсетемін! Біз және барлығымыз Vanguard-ды жақсы көреміз!
Dialogue: 0,0:14:19.31,0:14:23.48,Default,,0,0,0,,Тұр! Авангард!
Dialogue: 0,0:14:23.48,0:14:26.14,Default,,0,0,0,,Арнайы Юме Мел!
Dialogue: 0,0:14:26.14,0:14:28.50,Default,,0,0,0,,ﾌﾞﾗﾝﾆｭｰ･ﾌﾟﾘｽﾞﾑｻﾌｧｲｱ！
Dialogue: 0,0:14:28.50,0:14:32.56,Default,,0,0,0,,Айнадамю гүл шоғырына мініңіз!
Dialogue: 0,0:14:32.56,0:14:34.44,Default,,0,0,0,,Менің!
Dialogue: 0,0:14:34.44,0:14:39.33,Default,,0,0,0,,Жаңа Изумруд призмасына мініңіз!
Dialogue: 0,0:14:39.33,0:14:43.45,Default,,0,0,0,,Авангардқа динамикалық шабуыл!
Dialogue: 0,0:14:43.45,0:14:45.45,Default,,0,0,0,,Мю~!
Dialogue: 0,0:14:45.45,0:14:48.51,Default,,0,0,0,,Мелкилмен шабуыл!
Dialogue: 0,0:14:48.51,0:14:53.96,Default,,0,0,0,,Мю~! Сетия Эмилия Икудамю!
Dialogue: 0,0:14:53.96,0:14:56.37,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:56.37,0:14:59.97,Default,,0,0,0,,Күн сәулесі Роза призма суретіне мініңіз!
Dialogue: 0,0:15:02.79,0:15:07.18,Default,,0,0,0,,Sunshine Rosa Drive тексеруімен шабуыл
Dialogue: 0,0:15:07.18,0:15:11.28,Default,,0,0,0,,Иә! Критикалық!
Dialogue: 0,0:15:11.28,0:15:16.10,Default,,0,0,0,,Зақым 2-ден 4-ке дейін. Бұл әлі ұзақ жол.
Dialogue: 0,0:15:16.10,0:15:18.27,Default,,0,0,0,,Бұдан былай!
Dialogue: 0,0:15:18.27,0:15:21.66,Default,,0,0,0,,Керемет Бойс Роллиске мініңіз!
Dialogue: 0,0:15:21.66,0:15:23.81,Default,,0,0,0,,Менің!
Dialogue: 0,0:15:23.81,0:15:25.81,Default,,0,0,0,,Лолиспен шабуыл!
Dialogue: 0,0:15:25.81,0:15:29.48,Default,,0,0,0,,ﾂｲﾝﾄﾞﾗｲﾌﾞ ﾋｰﾙﾄﾘｶﾞｰ！
Dialogue: 0,0:15:29.48,0:15:32.84,Default,,0,0,0,,Сетияға қуат
Dialogue: 0,0:15:32.84,0:15:35.94,Default,,0,0,0,,Мию мию мию мию! Кяах!
Dialogue: 0,0:15:35.94,0:15:40.99,Default,,0,0,0,,Ятамию! (Қара Вангаро) Да~ Гахахахаха!
Dialogue: 0,0:15:40.99,0:15:43.55,Default,,0,0,0,,Саған не болды!?
Dialogue: 0,0:15:43.55,0:15:46.62,Default,,0,0,0,,Мен бақытты гүлге қараймын.
Dialogue: 0,0:15:46.62,0:15:49.94,Default,,0,0,0,,Ол сәл ғана ашық.
Dialogue: 0,0:15:49.94,0:15:54.16,Default,,0,0,0,,Сіздің Авангардқа деген махаббатыңыз ондай емес.
Dialogue: 0,0:15:54.16,0:15:56.61,Default,,0,0,0,,Бұл дұрыс емес!
Dialogue: 0,0:15:56.61,0:16:00.66,Default,,0,0,0,,Сізге қайсысы ұнайды, авангард па, әлде вафли ме?
Dialogue: 0,0:16:00.66,0:16:03.15,Default,,0,0,0,,Ух...｡ (Қара Вангаро) Ура➡
Dialogue: 0,0:16:03.15,0:16:05.72,Default,,0,0,0,,Мен бір сәт жауап бере алмай қалдым, бірақ
Dialogue: 0,0:16:05.72,0:16:07.95,Default,,0,0,0,,Мен Авангардты жақсы көремін!
Dialogue: 0,0:16:07.95,0:16:11.81,Default,,0,0,0,,Осы қарқынмен біз... Не істеуіміз керек...
Dialogue: 0,0:16:11.81,0:16:13.99,Default,,0,0,0,,Мені есте сақта!
Dialogue: 0,0:16:13.99,0:16:17.00,Default,,0,0,0,,Теңізшілер не үшін күреседі?
Dialogue: 0,0:16:17.00,0:16:20.65,Default,,0,0,0,,Дұрыс, Авангардты қорғаңыз...
Dialogue: 0,0:16:20.65,0:16:23.62,Default,,0,0,0,,Барлығын бақытты ету.
Dialogue: 0,0:16:23.62,0:16:26.49,Default,,0,0,0,,Содамю! Ал ең бастысы➡
Dialogue: 0,0:16:26.49,0:16:30.14,Default,,0,0,0,,Мұндағылардың барлығы Vanguard-да біртұтас болады деп үміттенеміз!
Dialogue: 0,0:16:30.14,0:16:34.53,Default,,0,0,0,,Ол үшін бізге сізден көбірек имидждік күш қажет!
Dialogue: 0,0:16:34.53,0:16:37.15,Default,,0,0,0,,Барлығыңыз өтінемін.
Dialogue: 0,0:16:37.15,0:16:39.95,Default,,0,0,0,,Бізге көбірек қолдау көрсетіңіз!
Dialogue: 0,0:16:39.95,0:16:41.97,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:16:41.97,0:16:45.36,Default,,0,0,0,,Әлі жоқ! Қаттырақ және қаттырақ!
Dialogue: 0,0:16:45.36,0:16:47.39,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:16:47.39,0:16:53.78,Default,,0,0,0,,Ikumyu~ Prestage Setia көмегімен шабуыл!
Dialogue: 0,0:16:53.78,0:16:55.82,Default,,0,0,0,,Кя!
Dialogue: 0,0:16:55.82,0:16:59.44,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:16:59.44,0:17:02.98,Default,,0,0,0,,Не?! Гүлдер ашыла бастады...
Dialogue: 0,0:17:02.98,0:17:05.38,Default,,0,0,0,,Бұл ақымақтық
Dialogue: 0,0:17:05.38,0:17:08.63,Default,,0,0,0,,Бізбен... Әркімнің имидждік күшімен!
Dialogue: 0,0:17:08.63,0:17:11.77,Default,,0,0,0,,Мен міндетті түрде Авангардты қорғаймын!
Dialogue: 0,0:17:11.77,0:17:14.02,Default,,0,0,0,,Мю?
Dialogue: 0,0:17:14.02,0:17:16.32,Default,,0,0,0,,Жаңбыр жауып тұр
Dialogue: 0,0:17:18.47,0:17:20.81,Default,,0,0,0,,Жаңбырдан жеңілмеймін!
Dialogue: 0,0:17:20.81,0:17:22.96,Default,,0,0,0,,Жаңбыр жауатын болса, көбірек жаусын!
Dialogue: 0,0:17:22.96,0:17:27.85,Default,,0,0,0,,Бермуд үшбұрышы суда жарқырайды!
Dialogue: 0,0:17:27.85,0:17:32.32,Default,,0,0,0,,Бірдеңе болса, су тамшылаған сұлу әйел туады.
Dialogue: 0,0:17:32.32,0:17:37.28,Default,,0,0,0,,Күш-қуатымызбен міндетті түрде бақытты гүлдер гүлдей берейік!
Dialogue: 0,0:17:37.28,0:17:40.65,Default,,0,0,0,,Осыншама жаңбырмен, Сараның және басқалардың құмарлығы➡
Dialogue: 0,0:17:40.65,0:17:43.80,Default,,0,0,0,,Мен оны өшіре алмаймын! (қуаныш)
Dialogue: 0,0:17:43.80,0:17:51.44,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:17:51.44,0:17:54.29,Default,,0,0,0,,Призма кескінінің ұясына мініңіз!
Dialogue: 0,0:17:54.29,0:17:58.38,Default,,0,0,0,,Генерация аймағын босатыңыз
Dialogue: 0,0:17:58.38,0:18:00.68,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:18:04.49,0:18:08.04,Default,,0,0,0,,ﾌﾟﾘｽﾞﾑ･ｲﾒｰｼﾞｻﾝｼｬｲﾝ･ｳﾞｪｰﾙ！
Dialogue: 0,0:18:08.04,0:18:13.14,Default,,0,0,0,,Жаңа призма гранат қоңырау призмасы Романс Мелкул!
Dialogue: 0,0:18:15.18,0:18:17.70,Default,,0,0,0,,Гранатпен шабуыл! Күзетші!
Dialogue: 0,0:18:17.70,0:18:19.77,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:18:19.77,0:18:24.47,Default,,0,0,0,,Sunshine Vale-дегі динамикалық шабуыл үш еселік диск!
Dialogue: 0,0:18:24.47,0:18:26.44,Default,,0,0,0,,ｲｴｽ！
Dialogue: 0,0:18:26.44,0:18:29.51,Default,,0,0,0,,Sunshine Vale үшін сыни
Dialogue: 0,0:18:29.51,0:18:32.11,Default,,0,0,0,,Күн сәулесі Розаға арналған қуат
Dialogue: 0,0:18:35.27,0:18:38.62,Default,,0,0,0,,Менің! Мю~!
Dialogue: 0,0:18:38.62,0:18:40.97,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:18:40.97,0:18:42.98,Default,,0,0,0,,Әлі алда!
Dialogue: 0,0:18:42.98,0:18:46.48,Default,,0,0,0,,Мен сендерге Күншуақ Вейлдің өнерін көрсетемін!
Dialogue: 0,0:18:46.48,0:18:48.98,Default,,0,0,0,,Құштарлық шегін бұзу!
Dialogue: 0,0:18:48.98,0:18:53.55,Default,,0,0,0,,Құнды төлеңіз және қолыңызда гранат пен Мелкюр болсын.
Dialogue: 0,0:18:53.55,0:19:00.19,Default,,0,0,0,,Sunshine Val-ды G аймағына қайтарыңыз.
Dialogue: 0,0:19:00.19,0:19:02.44,Default,,0,0,0,,Шеберлікпен 1 картаны сал
Dialogue: 0,0:19:02.44,0:19:04.98,Default,,0,0,0,,Мелкул мен Сафияны қолыңызға қайтарыңыз➡
Dialogue: 0,0:19:04.98,0:19:07.87,Default,,0,0,0,,Гранат үшін қуат плюс 10000!
Dialogue: 0,0:19:07.87,0:19:10.27,Default,,0,0,0,,Гранат шеберлігі іске қосылды!
Dialogue: 0,0:19:10.27,0:19:14.31,Default,,0,0,0,,Гранат пен Күн сәулесі Роза үшін қуат плюс 5000!
Dialogue: 0,0:19:14.31,0:19:16.69,Default,,0,0,0,,Жарайды, жүр, кел!
Dialogue: 0,0:19:16.69,0:19:19.65,Default,,0,0,0,,Гранатпен динамикалық шабуыл!
Dialogue: 0,0:19:19.65,0:19:21.65,Default,,0,0,0,,Дағды іске қосылды
Dialogue: 0,0:19:21.65,0:19:25.03,Default,,0,0,0,,3 Melkyuls Superior Call!
Dialogue: 0,0:19:25.03,0:19:27.29,Default,,0,0,0,,ﾀﾞﾒｰｼﾞ５
Dialogue: 0,0:19:27.29,0:19:33.78,Default,,0,0,0,,Енді, кеттік, армандар мен үміттердің түпкілікті үзілуі!
Dialogue: 0,0:19:33.78,0:19:39.13,Default,,0,0,0,,Drive Plus 1 Қос жетек үштік жетекке айналады.
Dialogue: 0,0:19:39.13,0:19:42.82,Default,,0,0,0,,Міне!
Dialogue: 0,0:19:42.82,0:19:47.72,Default,,0,0,0,,Ұрпақ қорғаушысы. Болашақтан кел, Сааяды қорға!
Dialogue: 0,0:19:47.72,0:19:51.64,Default,,0,0,0,,ﾊﾝﾄﾞ･ｲﾝ･ﾊﾝﾄﾞﾚｵﾅ！
Dialogue: 0,0:19:51.64,0:19:55.15,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ
Dialogue: 0,0:19:55.15,0:20:00.14,Default,,0,0,0,,Критикалық триггер Критикалық және Күн сәулесі раушанының қуаты
Dialogue: 0,0:20:00.14,0:20:04.84,Default,,0,0,0,,Мелкилмен супер гипердинамикалық шабуыл!
Dialogue: 0,0:20:04.84,0:20:07.78,Default,,0,0,0,,ｳﾙﾄﾗﾐﾗｸﾙ ﾗﾌﾞﾘｰｶﾞｰﾄﾞ！
Dialogue: 0,0:20:07.78,0:20:10.50,Default,,0,0,0,,Гугу... Көңілді сияқты
Dialogue: 0,0:20:10.50,0:20:13.95,Default,,0,0,0,,Жоқ, бұл қызық емес!
Dialogue: 0,0:20:13.95,0:20:17.80,Default,,0,0,0,,Тыныс алыңыз
Dialogue: 0,0:20:17.80,0:20:19.79,Default,,0,0,0,,Жаңбыр басылды
Dialogue: 0,0:20:19.79,0:20:22.99,Default,,0,0,0,,Біздің ойларымыз орындалды ма?
Dialogue: 0,0:20:22.99,0:20:28.65,Default,,0,0,0,,Ол да Бақытты гүлге жеткен болуы керек!
Dialogue: 0,0:20:28.65,0:20:31.55,Default,,0,0,0,,Иә? Ашық емес!?
Dialogue: 0,0:20:31.55,0:20:37.35,Default,,0,0,0,,Бұл қиын! Жаңбыр жауып кеткен сияқты!
Dialogue: 0,0:20:42.98,0:20:45.33,Default,,0,0,0,,Мю... Мюхаха...
Dialogue: 0,0:20:45.33,0:20:50.29,Default,,0,0,0,,Myuhahahaha! Жекпе-жек әлі алда!
Dialogue: 0,0:20:50.29,0:20:53.29,Default,,0,0,0,,Саая мен жеңілмеймін!
Dialogue: 0,0:20:53.29,0:20:55.99,Default,,0,0,0,,Сая мырза
Dialogue: 0,0:20:55.99,0:20:58.46,Default,,0,0,0,,《Қызық болғанымен➡
Dialogue: 0,0:20:58.46,0:21:01.13,Default,,0,0,0,,Мен не істеуім керек...》
Dialogue: 0,0:21:01.13,0:21:03.63,Default,,0,0,0,,Сәттілік, сэр!
Dialogue: 0,0:21:07.65,0:21:09.97,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:21:09.97,0:21:11.97,Default,,0,0,0,,Кім?
Dialogue: 0,0:21:11.97,0:21:15.64,Default,,0,0,0,,Біз барлық авангардтарды қорғаймыз...
Dialogue: 0,0:21:15.64,0:21:19.53,Default,,0,0,0,,Карта жауынгері Бангаман!
Dialogue: 0,0:21:19.53,0:21:21.93,Default,,0,0,0,,Мүмкін бұл дауыс...
Dialogue: 0,0:21:21.93,0:21:25.84,Default,,0,0,0,,Сая мен Сая Авангардты ➡ жандандыру үшін барын салуда
Dialogue: 0,0:21:25.84,0:21:29.89,Default,,0,0,0,,Дауыстап дауыстап жатқан адамдар мені еліктірді!
Dialogue: 0,0:21:29.89,0:21:32.44,Default,,0,0,0,,Сондықтан мен мұнда жүгірдім.
Dialogue: 0,0:21:32.44,0:21:37.65,Default,,0,0,0,,《Куроно аға, Шион аға, Токоха апа》
Dialogue: 0,0:21:37.65,0:21:39.80,Default,,0,0,0,,Егер сіз осындай қызықты іспен айналыссаңыз➡
Dialogue: 0,0:21:39.80,0:21:41.82,Default,,0,0,0,,Тез айтшы, Сара.
Dialogue: 0,0:21:41.82,0:21:44.69,Default,,0,0,0,,Бұл қызықты соққы емес.
Dialogue: 0,0:21:44.69,0:21:47.48,Default,,0,0,0,,Бұл...
Dialogue: 0,0:21:47.48,0:21:50.45,Default,,0,0,0,,Қара Вангаро мырза баяулайды➡
Dialogue: 0,0:21:50.45,0:21:54.15,Default,,0,0,0,,Біз сені жеңеміз. Дайын болыңыз!
Dialogue: 0,0:21:54.15,0:21:58.60,Default,,0,0,0,,Мен мұндай жерде жеңілетін тип емеспін.
Dialogue: 0,0:21:58.60,0:22:01.70,Default,,0,0,0,,Балалар, шабуыл жасаңдар!
Dialogue: 0,0:22:07.26,0:22:10.36,Default,,0,0,0,,ｸﾘﾃｨｶﾙﾌｧｲﾔｰ！
Dialogue: 0,0:22:12.60,0:22:15.45,Default,,0,0,0,,Уау! Мен жеңілдім!
Dialogue: 0,0:22:15.45,0:22:19.76,Default,,0,0,0,,Дәл сіз сияқты біз де күшті жаумен соғысып жатырмыз.
Dialogue: 0,0:22:19.76,0:22:22.96,Default,,0,0,0,,Ұрыс бұдан да қыза түсетіні сөзсіз.
Dialogue: 0,0:22:22.96,0:22:25.61,Default,,0,0,0,,ﾚｷﾞｵﾝﾎﾞﾝﾊﾞｰ！
Dialogue: 0,0:22:25.61,0:22:27.60,Default,,0,0,0,,Уау!
Dialogue: 0,0:22:27.60,0:22:30.27,Default,,0,0,0,,Бірақ біз берілмейміз
Dialogue: 0,0:22:30.27,0:22:34.49,Default,,0,0,0,,Қол ұстасып, мәңгілік алға ұмтылайық!
Dialogue: 0,0:22:34.49,0:22:38.89,Default,,0,0,0,,Сондықтан жолымызға бөгет болған жауларға осыны мәлімдейміз!
Dialogue: 0,0:22:38.89,0:22:42.83,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｽﾗｯｼｭ！
Dialogue: 0,0:22:42.83,0:22:45.32,Default,,0,0,0,,Уау!
Dialogue: 0,0:22:45.32,0:22:47.77,Default,,0,0,0,,Біз елестетуді ешқашан тоқтатпаймыз
Dialogue: 0,0:22:47.77,0:22:52.11,Default,,0,0,0,,Біз болашақты қолымызбен ұстаймыз
Dialogue: 0,0:22:52.11,0:22:58.81,Default,,0,0,0,,《Дұрыс, Мю, мен ешқашан берілмеймін! 》
Dialogue: 0,0:22:58.81,0:23:03.99,Default,,0,0,0,,Ғажайып үндестік – болашаққа көпір
Dialogue: 0,0:23:03.99,0:23:10.63,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:23:10.63,0:23:14.81,Default,,0,0,0,,ｾﾚﾌﾞﾚｲﾄ･ﾎﾞｲｽﾛｰﾘｽ！
Dialogue: 0,0:23:14.81,0:23:17.68,Default,,0,0,0,,Көрнекті жаңа студентті шақырыңыз
Dialogue: 0,0:23:17.68,0:23:20.10,Default,,0,0,0,,Сетия және Гармония Дамю
Dialogue: 0,0:23:20.10,0:23:23.12,Default,,0,0,0,,Бермуд үшбұрышының арнайы дағдылары
Dialogue: 0,0:23:23.12,0:23:25.99,Default,,0,0,0,,Бір бағанадағы екі адам бірге ән айтқан кезде➡
Dialogue: 0,0:23:25.99,0:23:28.64,Default,,0,0,0,,Керемет нәрсе болады
Dialogue: 0,0:23:28.64,0:23:31.61,Default,,0,0,0,,Гугугу…｡ Шидзуку шеберлігі!
Dialogue: 0,0:23:31.61,0:23:36.70,Default,,0,0,0,,Палубаның жоғарғы 5 картасына қарап, қолыңызға 3-сынып картасын салыңыз.
Dialogue: 0,0:23:36.70,0:23:40.27,Default,,0,0,0,,Керемет дауыс Лолиске қоңырау шалыңыз
Dialogue: 0,0:23:40.27,0:23:44.03,Default,,0,0,0,,Лолис пен Гармония Дамю дауысын тойлаңыз
Dialogue: 0,0:23:44.03,0:23:49.33,Default,,0,0,0,,Эмилия мен Айнаға қоңырау шалыңыз. Қазір барлығында Harmony Damyu бар.
Dialogue: 0,0:23:51.37,0:23:54.17,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:23:58.47,0:24:01.89,Default,,0,0,0,,Барлығыңыз, сүйікті картаңызды ұстаңыз!
Dialogue: 0,0:24:01.89,0:24:03.85,Default,,0,0,0,,Барынша жоғары көтеріліңіз!
Dialogue: 0,0:24:03.85,0:24:07.85,Default,,0,0,0,,Баршаның құдіретімен бақытты гүлдер жайқала берсін!
Dialogue: 0,0:24:15.37,0:24:17.64,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:24:17.64,0:24:20.51,Default,,0,0,0,,Бұл әдемі. (Ысқыру)
Dialogue: 0,0:24:20.51,0:24:23.03,Default,,0,0,0,,Үлкен гүлдер гүлдей алмаса да➡
Dialogue: 0,0:24:23.03,0:24:26.47,Default,,0,0,0,,Әркімнің жүрегі бірінен соң бірі гүлденсе➡
Dialogue: 0,0:24:26.47,0:24:29.64,Default,,0,0,0,,Бұл әлдеқайда күшті.
Dialogue: 0,0:24:29.64,0:24:34.31,Default,,0,0,0,,Шара өтетін жерде барлығымыз, Гармонияны бірге тамашалайық!
Dialogue: 0,0:24:34.31,0:24:36.65,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:24:36.65,0:24:39.33,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:24:39.33,0:24:46.64,Default,,0,0,0,,Бұл орын болашаққа деген үміт бейнелеріне толы!
Dialogue: 0,0:24:46.64,0:24:49.49,Default,,0,0,0,,Celebrate Voice Rollis көмегімен шабуыл!
Dialogue: 0,0:24:49.49,0:24:52.28,Default,,0,0,0,,Барлық 6 адам тату болғанда➡
Dialogue: 0,0:24:52.28,0:24:58.00,Default,,0,0,0,,Setia, Эмилия және Celebrate Voice Lolis үшін Пауэр Plus 5000
Dialogue: 0,0:24:58.00,0:25:00.60,Default,,0,0,0,,Критикалық плюс 1!
Dialogue: 0,0:25:00.60,0:25:04.97,Default,,0,0,0,,Мен бұған тосқауыл қоя алмаймын. Бұл күзетші емес.
Dialogue: 0,0:25:04.97,0:25:18.60,Default,,0,0,0,,♪♪～
Dialogue: 0,0:25:18.60,0:25:21.66,Default,,0,0,0,,Иә! Мю жеңді!
Dialogue: 0,0:25:21.66,0:25:23.61,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:25:23.61,0:25:26.53,Default,,0,0,0,,Дұрыс, есіме түсті.
Dialogue: 0,0:25:26.53,0:25:32.80,Default,,0,0,0,,Бұл Авангардтың қызығы. Бұл болашаққа апаратын көпір!
Dialogue: 0,0:25:32.80,0:25:36.49,Default,,0,0,0,,Бірақ?
Dialogue: 0,0:25:36.49,0:25:40.44,Default,,0,0,0,,Вангаро қалыпты жағдайға оралды. Яямию!
Dialogue: 0,0:25:40.44,0:25:44.28,Default,,0,0,0,,Мені қайтарғаныңызға рахмет.
Dialogue: 0,0:25:44.28,0:25:46.93,Default,,0,0,0,,Сізге жақсы, Вангаро мырза.
Dialogue: 0,0:25:46.93,0:25:50.47,Default,,0,0,0,,Барлығының құштарлығымен және күшті имиджімен➡
Dialogue: 0,0:25:50.47,0:25:52.85,Default,,0,0,0,,Бейбітшілік орнады!
Dialogue: 0,0:25:52.85,0:25:57.14,Default,,0,0,0,,Рахмет, Бангаман. Барлығыңызға рахмет!
Dialogue: 0,0:25:57.14,0:26:01.81,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:26:01.81,0:26:04.68,Default,,0,0,0,,Біз де маңызды нәрсе алдық.
Dialogue: 0,0:26:04.68,0:26:08.47,Default,,0,0,0,,Ешқандай жағдайға қарамастан ешқашан берілмеуге деген күшті ұмтылыс
Dialogue: 0,0:26:08.47,0:26:11.61,Default,,0,0,0,,Барлығының біртұтас болуының кереметі
Dialogue: 0,0:26:11.61,0:26:16.53,Default,,0,0,0,,Өйткені, Авангард бұл... (2 адам) Ең жақсысы!
Dialogue: 0,0:26:16.53,0:26:19.61,Default,,0,0,0,,ﾘｻ ﾚﾐｰ
Dialogue: 0,0:26:19.61,0:26:22.75,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:26:22.75,0:26:35.55,Default,,0,0,0,,♪♪～
Dialogue: 0,0:30:43.75,0:30:46.40,Default,,0,0,0,,＜ Сіз қайда барарыңызды ойлап тұрсыз.
Dialogue: 0,0:30:46.40,0:30:49.30,Default,,0,0,0,,Қала орталығынан оңай жетуге болатын орын➡
Dialogue: 0,0:30:49.30,0:30:53.37,Default,,0,0,0,,Мұнда сізді қызықтыратын ыстық қалашық бар.
Dialogue: 0,0:30:53.37,0:30:57.47,Default,,0,0,0,,Ол жақында ғана қосылды→
Dialogue: 0,0:30:58.97,0:31:04.97,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory