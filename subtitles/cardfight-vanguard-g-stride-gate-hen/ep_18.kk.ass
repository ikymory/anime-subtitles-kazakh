Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:04.06,0:01:07.56,Default,,0,0,0,,Қазір көрсетіңіз! Мен шынымен қалайтын әлем!
Dialogue: 0,0:01:14.10,0:01:18.40,Default,,0,0,0,,ｽﾄﾗｲﾄﾞ ｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:01:23.31,0:01:25.85,Default,,0,0,0,,Судьялар
Dialogue: 0,0:01:25.85,0:01:29.50,Default,,0,0,0,,Соттау уақыты келді
Dialogue: 0,0:01:29.50,0:01:33.02,Default,,0,0,0,,Өзара байланысы мен тағдыры бойынша→
Dialogue: 0,0:01:33.02,0:01:36.48,Default,,0,0,0,,Сіз → суреттің сиқырын бұзасыз
Dialogue: 0,0:01:36.48,0:01:40.58,Default,,0,0,0,,Болашақтың тасымалдаушысы ретінде таңдалды
Dialogue: 0,0:01:40.58,0:01:43.82,Default,,0,0,0,,Тағдырыңды басқаратын бес тартыс
Dialogue: 0,0:01:43.82,0:01:47.05,Default,,0,0,0,,Барлығы шешілгенде →
Dialogue: 0,0:01:47.05,0:01:52.05,Default,,0,0,0,,Ғаламның ақиқаты болашақты анықтайды
Dialogue: 0,0:05:15.35,0:05:17.71,Default,,0,0,0,,Кенеттен пайда болған жұмбақ нұр→
Dialogue: 0,0:05:17.71,0:05:20.02,Default,,0,0,0,,Біртіндеп қолданылу аясын кеңейту
Dialogue: 0,0:05:20.02,0:05:25.47,Default,,0,0,0,,Артында қалғандардың қауіпсіздігі белгісіз, бірақ...
Dialogue: 0,0:05:25.47,0:05:27.47,Default,,0,0,0,,Я~
Dialogue: 0,0:05:35.00,0:05:37.05,Default,,0,0,0,,Біз...
Dialogue: 0,0:05:37.05,0:05:40.15,Default,,0,0,0,,ﾄﾘﾆﾃｨ ﾄﾞﾗｺﾞﾝ…
Dialogue: 0,0:05:51.67,0:05:53.67,Default,,0,0,0,,Күтілгендей, олар →
Dialogue: 0,0:05:53.67,0:05:57.80,Default,,0,0,0,,Менің бейнемді бұзып, ояндың ба?
Dialogue: 0,0:05:57.80,0:06:01.12,Default,,0,0,0,,Қақпа әлдеқашан ашылды
Dialogue: 0,0:06:01.12,0:06:03.14,Default,,0,0,0,,Бұл жарық мұнарасы →
Dialogue: 0,0:06:03.14,0:06:06.35,Default,,0,0,0,,Ғаламның ақиқатына апаратын кеңістік
Dialogue: 0,0:06:06.35,0:06:08.72,Default,,0,0,0,,Біздің ойымыз сізге бір рет болса да жетсе →
Dialogue: 0,0:06:08.72,0:06:11.55,Default,,0,0,0,,Қадам қақпасы шындықпен танылады →
Dialogue: 0,0:06:11.55,0:06:14.15,Default,,0,0,0,,Кемелді болашақ аяқталады
Dialogue: 0,0:06:16.16,0:06:20.09,Default,,0,0,0,,Кел, тағдырымызды шешейік→
Dialogue: 0,0:06:20.09,0:06:23.19,Default,,0,0,0,,Болашақты осы қолдарыңызбен бекітіңіз!
Dialogue: 0,0:06:29.00,0:06:30.99,Default,,0,0,0,,Мен көремін...
Dialogue: 0,0:06:30.99,0:06:35.18,Default,,0,0,0,,Миоджин Льюестің көздегені осы ма еді?
Dialogue: 0,0:06:35.18,0:06:37.84,Default,,0,0,0,,[ТЕЛ] (Крис) Қадам қақпасының жарығына қол тиген адамдар →
Dialogue: 0,0:06:37.84,0:06:41.25,Default,,0,0,0,,Мүмкін мен қалаған болашақ орындалған шығар →
Dialogue: 0,0:06:41.25,0:06:44.32,Default,,0,0,0,,Бейнелер әлеміне ілестім.
Dialogue: 0,0:06:44.32,0:06:46.37,Default,,0,0,0,,Дерек көзі →
Dialogue: 0,0:06:46.37,0:06:49.49,Default,,0,0,0,,Крей планетасының болашақ мүмкіндіктері
Dialogue: 0,0:06:49.49,0:06:53.63,Default,,0,0,0,,Басқаша айтқанда, Клейде тұратындар, барлық өмірлік күш.
Dialogue: 0,0:06:53.63,0:06:56.18,Default,,0,0,0,,Жұлдыз өмірін тамырымен жұлып алу →
Dialogue: 0,0:06:56.18,0:06:59.30,Default,,0,0,0,,Үлкен кескін әлемін қолдау→
Dialogue: 0,0:06:59.30,0:07:02.79,Default,,0,0,0,,Қадамдық қақпаға түрлендіру
Dialogue: 0,0:07:02.79,0:07:04.82,Default,,0,0,0,,Осы қарқынмен, сайып келгенде →
Dialogue: 0,0:07:04.82,0:07:07.97,Default,,0,0,0,,Қадамдық қақпа бүкіл әлемді қамтиды
Dialogue: 0,0:07:07.97,0:07:10.88,Default,,0,0,0,,Льюес елестеткен идеалды бейнеге →
Dialogue: 0,0:07:10.88,0:07:14.15,Default,,0,0,0,,Сонда дүние жұтылады ма?
Dialogue: 0,0:07:14.15,0:07:16.78,Default,,0,0,0,,Ол зорлықты жек көретін
Dialogue: 0,0:07:16.78,0:07:18.82,Default,,0,0,0,,Сіздің қалауыңызға сәйкес келмейтін элементтер→
Dialogue: 0,0:07:18.82,0:07:23.47,Default,,0,0,0,,Әрине, ол бейнелер әлемінен мүлдем алынып тасталады.
Dialogue: 0,0:07:23.47,0:07:30.18,Default,,0,0,0,,Тарихтағы ең үнсіз дүниежүзілік жаулап алу.
Dialogue: 0,0:07:30.18,0:07:32.15,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:07:32.15,0:07:35.57,Default,,0,0,0,,Сіз Крэй планетасының өмірін қатерге тігуге дайынсыз ба?
Dialogue: 0,0:07:35.57,0:07:37.47,Default,,0,0,0,,Өз шешіміңізді жасаңыз →
Dialogue: 0,0:07:37.47,0:07:41.86,Default,,0,0,0,,Тіпті басқа дүниелерді құрту... Мен оны кешіре алмаймын.
Dialogue: 0,0:07:41.86,0:07:44.14,Default,,0,0,0,,Мен қайтарғым келетін нәрсе → болды
Dialogue: 0,0:07:44.14,0:07:48.00,Default,,0,0,0,,Бұл жалған емес...
Dialogue: 0,0:07:48.00,0:07:51.97,Default,,0,0,0,,Сол жарық мұнарасының ішінде Крей планетасы және біздің әлем
Dialogue: 0,0:07:51.97,0:07:56.52,Default,,0,0,0,,Екі кеңістік-уақыт бір-бірімен қадам күшімен тоғысқан
Dialogue: 0,0:07:56.52,0:07:58.84,Default,,0,0,0,,[ТЕЛ] (Крис) Сіздің суретіңіз сонда→
Dialogue: 0,0:07:58.84,0:08:03.28,Default,,0,0,0,,Ол шындыққа өте жақын түрде көрініс табады.
Dialogue: 0,0:08:03.28,0:08:06.38,Default,,0,0,0,,[ТЕЛ] (Крис) Қандай жағдай болмасын, бұл таңқаларлық емес.
Dialogue: 0,0:08:08.50,0:08:10.70,Default,,0,0,0,,Мен нені қолдай аламын→
Dialogue: 0,0:08:10.70,0:08:16.00,Default,,0,0,0,,Барлығы осы сияқты...
Dialogue: 0,0:08:24.17,0:08:26.20,Default,,0,0,0,,Ибуки-сан әлі →
Dialogue: 0,0:08:26.20,0:08:28.70,Default,,0,0,0,,Бірінші өзіңіз бардыңыз ба?
Dialogue: 0,0:08:30.84,0:08:33.71,Default,,0,0,0,,《Оны маған қалдырмауың керек еді!
Dialogue: 0,0:08:33.71,0:08:39.00,Default,,0,0,0,,Соңында ол қайтадан өз бетімен қозғала бастады! 》
Dialogue: 0,0:08:39.00,0:08:57.97,Default,,0,0,0,,♪♪～
Dialogue: 0,0:08:57.97,0:09:00.80,Default,,0,0,0,,Сәлем! Мықты болыңыз!
Dialogue: 0,0:09:00.80,0:09:20.71,Default,,0,0,0,,♪♪～
Dialogue: 0,0:09:20.71,0:09:23.38,Default,,0,0,0,,Мен қалаған ауытқу үшін
Dialogue: 0,0:09:23.38,0:09:28.88,Default,,0,0,0,,Ибуки-сан. Армандай алмайтын жалғыз сенсің. Мен саған қарғыс айттым.
Dialogue: 0,0:09:34.47,0:09:38.12,Default,,0,0,0,,Тым болмаса күресуге тырысыңыз.
Dialogue: 0,0:09:38.12,0:09:43.01,Default,,0,0,0,,Бірақ сіз триггерді тарта алмайсыз
Dialogue: 0,0:09:43.01,0:09:55.59,Default,,0,0,0,,♪♪～
Dialogue: 0,0:09:55.59,0:09:58.33,Default,,0,0,0,,Иә, Шинономе?
Dialogue: 0,0:09:58.33,0:10:01.83,Default,,0,0,0,,Бұл мүлдем үмітсіз.
Dialogue: 0,0:10:01.83,0:10:04.33,Default,,0,0,0,,Миоджин Льюз…
Dialogue: 0,0:10:06.34,0:10:09.67,Default,,0,0,0,,Біліктілігі жоқ адам мені дауласа ма?
Dialogue: 0,0:10:09.67,0:10:13.06,Default,,0,0,0,,Сен жай ғана күнәкарсың
Dialogue: 0,0:10:13.06,0:10:16.81,Default,,0,0,0,,Ракуиннен қашу үшін ғана көшкендерге→
Dialogue: 0,0:10:16.81,0:10:20.18,Default,,0,0,0,,Әлемнің шындығын бізге сеніп тапсыруға болмайды.
Dialogue: 0,0:10:20.18,0:10:23.34,Default,,0,0,0,,Сенім жақсы! Мен шешемін!
Dialogue: 0,0:10:23.34,0:10:27.14,Default,,0,0,0,,Сіздің амбицияңыз осы жерде және қазір аяқталады.
Dialogue: 0,0:10:27.14,0:10:29.54,Default,,0,0,0,,Әлде қашасың ба?
Dialogue: 0,0:10:29.54,0:10:32.54,Default,,0,0,0,,Әлемді құтқарғысы келетін адам
Dialogue: 0,0:10:35.22,0:10:38.32,Default,,0,0,0,,Уайымдама... жас жігіт
Dialogue: 0,0:10:40.35,0:10:43.65,Default,,0,0,0,,Төреші келгенше отырыс.
Dialogue: 0,0:10:46.01,0:10:48.68,Default,,0,0,0,,Төреші болып таңдалмаған адам→
Dialogue: 0,0:10:48.68,0:10:52.23,Default,,0,0,0,,Мен сені мына жер бетінде тұрғаның үшін жазалаймын.
Dialogue: 0,0:10:52.23,0:10:55.73,Default,,0,0,0,,Сен жазаланатын адамсың. Миджин Роуз
Dialogue: 0,0:10:58.00,0:11:02.00,Default,,0,0,0,,ｽﾀﾝﾄﾞｱｯﾌﾟ ｳﾞｧﾝｶﾞｰﾄﾞ！ ｽﾀﾝﾄﾞｱｯﾌﾟ ｻﾞ ｳﾞｧﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:12:48.03,0:12:50.03,Default,,0,0,0,,Бұл...
Dialogue: 0,0:12:50.03,0:12:53.17,Default,,0,0,0,,ﾈｵﾝﾒｻｲｱ
Dialogue: 0,0:12:53.17,0:12:55.17,Default,,0,0,0,,ﾗｲﾄﾞ
Dialogue: 0,0:12:55.17,0:12:57.51,Default,,0,0,0,,ﾎﾞﾙﾀｰﾛｲﾃﾞｱﾄﾞﾛｰﾝ
Dialogue: 0,0:12:57.51,0:12:59.51,Default,,0,0,0,,ﾗｲﾄﾞ
Dialogue: 0,0:12:59.51,0:13:02.18,Default,,0,0,0,,ｱｽﾘｰﾌﾟﾒｻｲｱ｡ ｺｰﾙ
Dialogue: 0,0:13:02.18,0:13:04.13,Default,,0,0,0,,ﾃﾞｽﾃｨﾆｰ ﾃﾞｨｰﾗｰ
Dialogue: 0,0:13:04.13,0:13:06.72,Default,,0,0,0,,ｱﾀｯｸ！
Dialogue: 0,0:13:06.72,0:13:08.82,Default,,0,0,0,,ｶﾞｰﾄﾞ
Dialogue: 0,0:13:11.17,0:13:15.14,Default,,0,0,0,,Ибуки мырзаның және Льюдің...
Dialogue: 0,0:13:15.14,0:13:17.29,Default,,0,0,0,,Ішінде ұрыс басталып жатыр.
Dialogue: 0,0:13:17.29,0:13:19.73,Default,,0,0,0,,Бұл сурет пайда болады
Dialogue: 0,0:13:19.73,0:13:21.73,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:13:24.00,0:13:27.89,Default,,0,0,0,,Бұл... Қадам қақпасы...
Dialogue: 0,0:13:27.89,0:13:30.46,Default,,0,0,0,,Артында Луна бар...
Dialogue: 0,0:13:30.46,0:13:32.68,Default,,0,0,0,,Компания жігіттері де.
Dialogue: 0,0:13:32.68,0:13:35.81,Default,,0,0,0,,Осы уақытқа дейін болған нәрселердің барлығына нүкте қоямын.
Dialogue: 0,0:13:35.81,0:13:38.52,Default,,0,0,0,,Бар күшіммен жасаймын!
Dialogue: 0,0:13:38.52,0:13:43.17,Default,,0,0,0,,Бұл жерге міндетті түрде бірге оралайық.
Dialogue: 0,0:13:43.17,0:13:47.12,Default,,0,0,0,,Луна мен Ибуки барлығы бірге →
Dialogue: 0,0:13:47.12,0:13:50.84,Default,,0,0,0,,Vanguard ойынын қалыпты түрде ойнауға болатын уақытты қайтарыңыз!
Dialogue: 0,0:13:50.84,0:13:52.85,Default,,0,0,0,,Иә
Dialogue: 0,0:13:52.85,0:13:54.83,Default,,0,0,0,,Сенімді бол... Уәде бер!
Dialogue: 0,0:13:54.83,0:13:57.00,Default,,0,0,0,,Иә
Dialogue: 0,0:13:57.00,0:13:58.97,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:13:58.97,0:14:37.12,Default,,0,0,0,,♪♪～
Dialogue: 0,0:14:37.12,0:14:39.84,Default,,0,0,0,,Цзянси Сатору…
Dialogue: 0,0:14:39.84,0:14:44.98,Default,,0,0,0,,Боу?
Dialogue: 0,0:14:44.98,0:14:58.18,Default,,0,0,0,,♪♪～
Dialogue: 0,0:14:58.18,0:15:00.20,Default,,0,0,0,,ﾙｰﾅ！
Dialogue: 0,0:15:00.20,0:15:06.50,Default,,0,0,0,,Боу?
Dialogue: 0,0:15:06.50,0:15:08.66,Default,,0,0,0,,Жаман болғанымен→
Dialogue: 0,0:15:08.66,0:15:12.53,Default,,0,0,0,,Мен сені қашып емес, кіргеніңді мақтаймын.
Dialogue: 0,0:15:12.53,0:15:14.59,Default,,0,0,0,,Хироки-кун…
Dialogue: 0,0:15:14.59,0:15:16.50,Default,,0,0,0,,Осы жерде ұтылып қалсаңыз →
Dialogue: 0,0:15:16.50,0:15:20.60,Default,,0,0,0,,Әлемнің ақиқаты адым қақпалардың бар екенін мойындайды!
Dialogue: 0,0:15:24.00,0:15:28.58,Default,,0,0,0,,Льюес мырза жасаған ең жақсы әлем жақында аяқталады!
Dialogue: 0,0:15:28.58,0:15:33.38,Default,,0,0,0,,Жолыма бөгет болған жауыздарды жеңемін!
Dialogue: 0,0:15:36.37,0:15:39.80,Default,,0,0,0,,ｽﾀﾝﾄﾞｱｯﾌﾟ ｳﾞｧﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:15:39.80,0:16:34.49,Default,,0,0,0,,♪♪～
Dialogue: 0,0:16:34.49,0:16:37.64,Default,,0,0,0,,Эй, сен осындасың.
Dialogue: 0,0:16:37.64,0:16:41.73,Default,,0,0,0,,♪♪～
Dialogue: 0,0:16:41.73,0:16:48.53,Default,,0,0,0,,Боу?
Dialogue: 0,0:16:58.13,0:17:00.35,Default,,0,0,0,,және басқа да байланыс құралдарын—өшіріп, сол үстелге қойыңыз.
Dialogue: 0,0:17:00.35,0:17:04.24,Default,,0,0,0,,Барлығы сот процесін бастады ма?
Dialogue: 0,0:17:04.24,0:17:07.16,Default,,0,0,0,,ｽﾄﾗｲﾄﾞ ｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:17:07.16,0:17:11.26,Default,,0,0,0,,Қыздырылған алтын рыцарь Эбро!
Dialogue: 0,0:17:14.46,0:17:18.50,Default,,0,0,0,,Эбро шеберлігі. Палубаның жоғарғы екі картасын қараңыз→
Dialogue: 0,0:17:18.50,0:17:21.84,Default,,0,0,0,,Berry Mall Superior алкоголь
Dialogue: 0,0:17:21.84,0:17:23.84,Default,,0,0,0,,Берри моль дағдылары
Dialogue: 0,0:17:23.84,0:17:26.81,Default,,0,0,0,,Палубаның жоғарғы үш картасына қарап, оларды бір бағанға салыңыз →
Dialogue: 0,0:17:26.81,0:17:30.33,Default,,0,0,0,,Жапонияның рыцары Джеффриге керемет қоңырау!
Dialogue: 0,0:17:30.33,0:17:33.33,Default,,0,0,0,,Гулгвинттің қадам жасау шеберлігі
Dialogue: 0,0:17:33.33,0:17:35.67,Default,,0,0,0,,Палубаның жоғарғы төрт картасын қараңыз→
Dialogue: 0,0:17:35.67,0:17:39.02,Default,,0,0,0,,Қасиетті құбыр ойнатқышы Хеллиге керемет қоңырау!
Dialogue: 0,0:17:39.02,0:17:41.17,Default,,0,0,0,,ﾊﾟﾜｰﾌﾟﾗｽ2000
Dialogue: 0,0:17:41.17,0:17:43.21,Default,,0,0,0,,Герридің бірігуі
Dialogue: 0,0:17:43.21,0:17:45.71,Default,,0,0,0,,Harley үшін қосымша қуат плюс 3000!
Dialogue: 0,0:17:47.73,0:17:49.77,Default,,0,0,0,,Узе~ Узе~ Узе~
Dialogue: 0,0:17:49.77,0:17:53.22,Default,,0,0,0,,Үлкен Дрифтерге шабуыл жасаңыз!
Dialogue: 0,0:17:53.22,0:17:55.22,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ
Dialogue: 0,0:17:58.81,0:18:00.79,Default,,0,0,0,,Мені жазалаңыз!
Dialogue: 0,0:18:00.79,0:18:03.21,Default,,0,0,0,,Әлем қазірдің өзінде барлығы бақытты болатын болашақта→
Dialogue: 0,0:18:03.21,0:18:05.23,Default,,0,0,0,,Шешілді!
Dialogue: 0,0:18:05.23,0:18:09.80,Default,,0,0,0,,Мен сенетін болашақ онша жалған емес!
Dialogue: 0,0:18:09.80,0:18:12.67,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ
Dialogue: 0,0:18:12.67,0:18:15.04,Default,,0,0,0,,ｸﾘﾃｨｶﾙ ﾄﾘｶﾞｰ
Dialogue: 0,0:18:15.04,0:18:17.38,Default,,0,0,0,,Берри сауда орталығына қуат беріледі
Dialogue: 0,0:18:17.38,0:18:19.98,Default,,0,0,0,,Эбраға сын
Dialogue: 0,0:18:23.13,0:18:25.17,Default,,0,0,0,,Хироки-кун шынымен →
Dialogue: 0,0:18:25.17,0:18:28.62,Default,,0,0,0,,Қалай ойлайсың, мұндай болашақ дұрыс па?
Dialogue: 0,0:18:28.62,0:18:30.72,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:18:32.66,0:18:34.98,Default,,0,0,0,,Әрине, солай ма?
Dialogue: 0,0:18:34.98,0:18:38.51,Default,,0,0,0,,Мен де компанияның мүшесімін.
Dialogue: 0,0:18:38.51,0:18:41.38,Default,,0,0,0,,ｽﾄﾗｲﾄﾞ ｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:18:41.38,0:18:45.79,Default,,0,0,0,,Ғарыштың супер қаһарманы Экс Галлоп!
Dialogue: 0,0:18:45.79,0:18:48.01,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｽｷﾙ
Dialogue: 0,0:18:48.01,0:18:51.39,Default,,0,0,0,,Ex Gallop үшін Пауэр Plus 4000!
Dialogue: 0,0:18:51.39,0:18:55.03,Default,,0,0,0,,Бейнелер әлемі. Ең жақсысы емес пе?
Dialogue: 0,0:18:55.03,0:18:58.83,Default,,0,0,0,,Барлық тілектеріңіз орындалады!
Dialogue: 0,0:19:01.30,0:19:04.66,Default,,0,0,0,,Алаяқтар
Dialogue: 0,0:19:04.66,0:19:08.98,Default,,0,0,0,,Кішкентай шабақтар жай ғана жиналып жатыр
Dialogue: 0,0:19:08.98,0:19:14.50,Default,,0,0,0,,Барлығы... бәрі жоғалады!
Dialogue: 0,0:19:14.50,0:19:17.50,Default,,0,0,0,,ｺｰﾙ！ ｸﾞﾗﾝﾄﾞﾘﾌﾀｰ
Dialogue: 0,0:19:17.50,0:19:21.14,Default,,0,0,0,,Өзіңізге және Авангардқа қуат плюс 4000!
Dialogue: 0,0:19:21.14,0:19:23.68,Default,,0,0,0,,ｺｰﾙ！ ｸﾞﾗﾝｳﾞｨｰｸﾙ！
Dialogue: 0,0:19:23.68,0:19:26.66,Default,,0,0,0,,ﾊﾞｰｽﾄ！ ﾊﾟﾜｰﾌﾟﾗｽ4000！
Dialogue: 0,0:19:26.66,0:19:28.98,Default,,0,0,0,,ｺｰﾙ！ ｸﾞﾗﾝﾏﾝﾄﾙ！
Dialogue: 0,0:19:28.98,0:19:32.00,Default,,0,0,0,,ﾊﾞｰｽﾄ ﾊﾟﾜｰﾌﾟﾗｽ4000！
Dialogue: 0,0:19:32.00,0:19:35.17,Default,,0,0,0,,Үлкен ханымға демалыңыз және шеберлікті белсендіріңіз!
Dialogue: 0,0:19:35.17,0:19:39.88,Default,,0,0,0,,Авангард пен Гранд Мантия үшін қуат плюс 4000!
Dialogue: 0,0:19:39.88,0:19:41.98,Default,,0,0,0,,Тағы да сол шеберлік!
Dialogue: 0,0:19:45.67,0:19:47.67,Default,,0,0,0,,Қараңдар!
Dialogue: 0,0:19:47.67,0:19:50.55,Default,,0,0,0,,Енді Авангардтың күші 50 000!
Dialogue: 0,0:19:50.55,0:19:54.47,Default,,0,0,0,,Мен сенен басқа деңгейдемін!
Dialogue: 0,0:19:54.47,0:19:57.18,Default,,0,0,0,,Ex Gallop ойынында Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:19:57.18,0:19:59.30,Default,,0,0,0,,ﾄﾞﾗｲﾌﾞ ﾌﾟﾗｽ１！
Dialogue: 0,0:19:59.30,0:20:02.06,Default,,0,0,0,,Мен дұрыс...
Dialogue: 0,0:20:02.06,0:20:05.36,Default,,0,0,0,,Сондықтан біз дұрыс дүниені ала аламыз!
Dialogue: 0,0:20:10.39,0:20:14.69,Default,,0,0,0,,Бұл менің әділетті болашағым!
Dialogue: 0,0:20:19.52,0:20:21.52,Default,,0,0,0,,Толық күзет
Dialogue: 0,0:20:23.52,0:20:28.67,Default,,0,0,0,,Мен баяғыда дәл осылай ойладым.
Dialogue: 0,0:20:28.67,0:20:31.13,Default,,0,0,0,,Мықты болсаң, таныласың.
Dialogue: 0,0:20:31.13,0:20:36.02,Default,,0,0,0,,Қонатын жеріңіз болады. Сіз ештеңеден қорықпайсыз ...
Dialogue: 0,0:20:36.02,0:20:39.14,Default,,0,0,0,,Бірақ... бұл басқаша болды.
Dialogue: 0,0:20:39.14,0:20:43.81,Default,,0,0,0,,Мен өз әлсіздігімнен қашқым келді
Dialogue: 0,0:20:43.81,0:20:46.73,Default,,0,0,0,,Қолымнан ештеңе келмейтіндіктен өзімнен бас тартқым келеді→
Dialogue: 0,0:20:46.73,0:20:49.83,Default,,0,0,0,,Мен жаңа ғана күшті күшке жабыстым
Dialogue: 0,0:20:52.13,0:20:55.33,Default,,0,0,0,,Эй Хироки-кун
Dialogue: 0,0:20:55.33,0:20:58.99,Default,,0,0,0,,Бұл шынымен жақсы ма? Не!
Dialogue: 0,0:20:58.99,0:21:02.99,Default,,0,0,0,,Бұл шынымен Хироки-кун қалаған дүние ме?
Dialogue: 0,0:21:05.01,0:21:07.01,Default,,0,0,0,,Хироки-кун…
Dialogue: 0,0:21:08.98,0:21:12.34,Default,,0,0,0,,Бұл жеткілікті! Маған бәрі бір!
Dialogue: 0,0:21:12.34,0:21:15.81,Default,,0,0,0,,ｸｱﾄﾞﾗﾌﾟﾙﾄﾞﾗｲﾌﾞ！
Dialogue: 0,0:21:15.81,0:21:19.86,Default,,0,0,0,,Триггерді тартыңыз! Қуат жер мантиясына түседі
Dialogue: 0,0:21:19.86,0:21:22.33,Default,,0,0,0,,ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ！
Dialogue: 0,0:21:22.33,0:21:25.63,Default,,0,0,0,,Барлық әсерлер Grand Lifter үшін!
Dialogue: 0,0:21:25.63,0:21:28.35,Default,,0,0,0,,Ұйқы сізді бақытты етеді!
Dialogue: 0,0:21:28.35,0:21:35.12,Default,,0,0,0,,Бірақ неге... барлық азапты басынан өткеру...
Dialogue: 0,0:21:35.12,0:21:37.53,Default,,0,0,0,,Бұл жақсы, енді!!
Dialogue: 0,0:21:37.53,0:21:39.53,Default,,0,0,0,,ｸﾞﾗﾝﾏﾝﾄﾙ！
Dialogue: 0,0:21:42.60,0:21:44.82,Default,,0,0,0,,Glug Hunt дағдысы іске қосылды!
Dialogue: 0,0:21:44.82,0:21:47.22,Default,,0,0,0,,Палубаның жоғарғы төрт картасына қараңыз →
Dialogue: 0,0:21:47.22,0:21:50.32,Default,,0,0,0,,Голддог үшін Guardian Circle-ге қоңырау шалыңыз!
Dialogue: 0,0:21:52.38,0:21:55.38,Default,,0,0,0,,Одан да күзетші. Кесу!
Dialogue: 0,0:22:01.82,0:22:03.82,Default,,0,0,0,,ｸﾞﾗﾝﾄﾞﾘﾌﾀｰ！
Dialogue: 0,0:22:07.22,0:22:11.34,Default,,0,0,0,,Бәріміз тыныш ұйықтасақ, бәрі орындалады!
Dialogue: 0,0:22:11.34,0:22:14.00,Default,,0,0,0,,ｼﾞｪﾈﾚｰｼｮﾝ ｶﾞｰﾄﾞ！
Dialogue: 0,0:22:14.00,0:22:16.47,Default,,0,0,0,,«Алтын құбыжық» шырышты алауы!
Dialogue: 0,0:22:16.47,0:22:20.80,Default,,0,0,0,,Дағдыны белсендіру. Голддогты палубаның төменгі жағына қойыңыз.
