Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:10.90,0:01:15.63,Default,,0,0,0,,Әлемнің шындығы сізді таңдай ма?
Dialogue: 0,0:01:15.63,0:01:17.74,Default,,0,0,0,,Неліктен!?
Dialogue: 0,0:01:17.74,0:01:21.23,Default,,0,0,0,,((Куроно: Сіз суретте ең күшті күшке ие адамсыз➡
Dialogue: 0,0:01:21.23,0:01:23.33,Default,,0,0,0,,Сенбейсің, солай ма? ))
Dialogue: 0,0:01:27.40,0:01:30.62,Default,,0,0,0,,((Тікелей эфир: Айтпақшы, өзіңіз Leuse➡
Dialogue: 0,0:01:30.62,0:01:33.22,Default,,0,0,0,,Қандай дүниені қалайсыз? ))
Dialogue: 0,0:05:13.26,0:05:18.57,Default,,0,0,0,,Крей планетасынан энергия ағыны тоқтады.
Dialogue: 0,0:05:18.57,0:05:23.12,Default,,0,0,0,,Қадамдық қақпа жүйесі өздігінен жойыла бастады...
Dialogue: 0,0:05:23.12,0:05:28.72,Default,,0,0,0,,Крей планетасынан құйылған қуат қайтарылғалы жатыр ма?
Dialogue: 0,0:05:36.40,0:05:42.41,Default,,0,0,0,,Хе, дұрыс айтасың, Куроно.
Dialogue: 0,0:05:42.41,0:05:48.06,Default,,0,0,0,,Олар қашан басталды деп ойлаймын. Олар әлемді бейнелердің күшімен құтқарамыз деді.
Dialogue: 0,0:05:48.06,0:05:54.10,Default,,0,0,0,,Азапсыз, зорлық-зомбылықсыз әлемді армандау
Dialogue: 0,0:05:54.10,0:05:59.09,Default,,0,0,0,,Шындығында мен зорлық-зомбылықты құрал ретінде қолдануға дайын болдым.
Dialogue: 0,0:05:59.09,0:06:04.90,Default,,0,0,0,,Бұл ештеңе емес. Мен өзім сенбедім.
Dialogue: 0,0:06:04.90,0:06:07.45,Default,,0,0,0,,ﾘｭｰｽﾞ
Dialogue: 0,0:06:07.45,0:06:09.95,Default,,0,0,0,,Сіз жеңдіңіз, Хроно.
Dialogue: 0,0:06:14.11,0:06:17.61,Default,,0,0,0,,Zodiac Time Beast шығарылды...
Dialogue: 0,0:06:22.60,0:06:25.68,Default,,0,0,0,,Бұл кеңістік те жақын арада жоғалады.
Dialogue: 0,0:06:25.68,0:06:27.98,Default,,0,0,0,,ﾘｭｰｽﾞ！
Dialogue: 0,0:06:30.64,0:06:35.41,Default,,0,0,0,,Тағдырымды мына қақпа қақпасымен бөлісемін.
Dialogue: 0,0:06:35.41,0:06:39.28,Default,,0,0,0,,Осы уақытқа жету үшін біз көптеген құрбандықтарды жасадық.
Dialogue: 0,0:06:39.28,0:06:42.92,Default,,0,0,0,,Қайтуға рұқсат етілмейді
Dialogue: 0,0:06:42.92,0:06:47.97,Default,,0,0,0,,Ақымақ болма!!
Dialogue: 0,0:06:47.97,0:06:51.34,Default,,0,0,0,,Мен сенің бұлай қашуыңа жол бермеймін!
Dialogue: 0,0:06:51.34,0:06:56.34,Default,,0,0,0,,Сіздің болашағыңыз әлі аяқталған жоқ!
Dialogue: 0,0:07:01.40,0:07:07.01,Default,,0,0,0,,Куроно Егер мен шынымен осылай көрінсем➡
Dialogue: 0,0:07:07.01,0:07:10.01,Default,,0,0,0,,Егер мен сені кездестірсем...
Dialogue: 0,0:07:10.01,0:07:14.80,Default,,0,0,0,,Льюс! Мен күресіп, жеңілдім
Dialogue: 0,0:07:14.80,0:07:17.17,Default,,0,0,0,,Аха!
Dialogue: 0,0:07:17.17,0:07:21.51,Default,,0,0,0,,Менің болашағым мен қалағанның бәрімен!
Dialogue: 0,0:07:21.51,0:08:09.01,Default,,0,0,0,,♪♪～
Dialogue: 0,0:08:10.91,0:08:16.65,Default,,0,0,0,,Үкім шығарылды.
Dialogue: 0,0:08:16.65,0:08:20.25,Default,,0,0,0,,Әлемнің ақиқаты оған болашақты бұйырды.
Dialogue: 0,0:08:20.25,0:08:25.32,Default,,0,0,0,,Адамдармен бірге жүру, қиналып, адасу➡
Dialogue: 0,0:08:25.32,0:08:29.32,Default,,0,0,0,,Тағы да болашақта өз жолыңызды табыңыз
Dialogue: 0,0:08:35.08,0:08:37.63,Default,,0,0,0,,Куроно рахмет
Dialogue: 0,0:08:37.63,0:08:40.24,Default,,0,0,0,,Рахмет сізге, біз де➡
Dialogue: 0,0:08:40.24,0:08:45.74,Default,,0,0,0,,Дүниеге қалай болса солай оралуға болады.
Dialogue: 0,0:08:45.74,0:08:49.41,Default,,0,0,0,,Сіз Крэй планетасына қайтасыз ба? Иә
Dialogue: 0,0:08:49.41,0:08:53.08,Default,,0,0,0,,Бұл жолы да бізге үлкен жауапкершілік жүктейді.
Dialogue: 0,0:08:53.08,0:08:56.57,Default,,0,0,0,,Мен барлығымен жақсы пікірталасқа барамын.
Dialogue: 0,0:08:56.57,0:09:00.57,Default,,0,0,0,,Біз болашағымызбен не істегіміз келеді?
Dialogue: 0,0:09:00.57,0:09:03.83,Default,,0,0,0,,Ол үшін не істеуіміз керек?
Dialogue: 0,0:09:03.83,0:09:06.63,Default,,0,0,0,,Тағы да?
Dialogue: 0,0:09:08.90,0:09:10.95,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:10.95,0:09:14.40,Default,,0,0,0,,Жақында жол қақпасы жабылады
Dialogue: 0,0:09:14.40,0:09:20.13,Default,,0,0,0,,Екі ғаламшарды байланыстыратын тағдырдың құдіреті қалпына келеді.
Dialogue: 0,0:09:20.13,0:09:25.73,Default,,0,0,0,,Сен екеуміздің арамызда дүниеге келген кеңістік-уақыт өткелі көп ұзамай жоғалады.
Dialogue: 0,0:09:32.24,0:09:34.92,Default,,0,0,0,,Сіз барасыз ба? Иә
Dialogue: 0,0:09:34.92,0:09:41.31,Default,,0,0,0,,Барлығы қазір Cray планетасында, мен...
Dialogue: 0,0:09:41.31,0:09:44.68,Default,,0,0,0,,Осыдан 10 жыл бұрын сол күні...
Dialogue: 0,0:09:44.68,0:09:47.79,Default,,0,0,0,,Бұл дүниеге келу арқылы➡
Dialogue: 0,0:09:47.79,0:09:52.57,Default,,0,0,0,,Мен қайта оралып, қолымнан келмеген 10 жыл бойы қайталап көремін.
Dialogue: 0,0:09:52.57,0:09:57.98,Default,,0,0,0,,Ал егер мен өскенде мен болу керек болсам...
Dialogue: 0,0:09:57.98,0:10:04.64,Default,,0,0,0,,Оның сенен бұрын келетініне сенімдімін.
Dialogue: 0,0:10:04.64,0:10:06.74,Default,,0,0,0,,Иә
Dialogue: 0,0:10:09.31,0:10:12.95,Default,,0,0,0,,О
Dialogue: 0,0:10:12.95,0:10:15.25,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:10:18.62,0:10:22.99,Default,,0,0,0,,Бейнелер әлемінде тағы кездескенше!
Dialogue: 0,0:10:22.99,0:10:38.27,Default,,0,0,0,,♪♪～
Dialogue: 0,0:10:38.27,0:10:43.93,Default,,0,0,0,,Сіз! сен ол жігіт болдың ба?
Dialogue: 0,0:10:43.93,0:10:50.53,Default,,0,0,0,,Ол 10 жыл Клейде өсіп, маған келді...
Dialogue: 0,0:10:58.27,0:11:02.24,Default,,0,0,0,,Сіз маған осы уақыт бойы басшылық еттіңіз бе?
Dialogue: 0,0:11:02.24,0:11:07.75,Default,,0,0,0,,Осы уақытқа дейін жетуім үшін
Dialogue: 0,0:11:07.75,0:11:10.70,Default,,0,0,0,,Сізге дұрыс қайтару➡
Dialogue: 0,0:11:10.70,0:11:16.00,Default,,0,0,0,,Барлығы дұрыс жұмыс істеп тұрғанына көз жеткізу үшін...
Dialogue: 0,0:13:03.63,0:13:07.09,Default,,0,0,0,,Авангардты алға жылжыту қауымдастығының жаңа құрылымына қатысты➡
Dialogue: 0,0:13:07.09,0:13:10.91,Default,,0,0,0,,Бұл қауымдастықтың басшысы болып тағайындалған Коджи Ибуки.
Dialogue: 0,0:13:10.91,0:13:13.06,Default,,0,0,0,,Жас болсам да➡
Dialogue: 0,0:13:13.06,0:13:17.00,Default,,0,0,0,,Бүгінгі күнге жеткізген жағдайға жауаптылардың бірі ретінде➡
Dialogue: 0,0:13:17.00,0:13:20.00,Default,,0,0,0,,Маған осы маңызды рөлді қабылдау ұсынылды.
Dialogue: 0,0:13:20.00,0:13:23.14,Default,,0,0,0,,Авангардтың қызықтарын әлемге тарату➡
Dialogue: 0,0:13:23.14,0:13:29.78,Default,,0,0,0,,Біз қауымдастықтың бастауларына ораламыз және ұйымды қайта құру үшін бар күшімізді саламыз.
Dialogue: 0,0:13:29.78,0:13:37.28,Default,,0,0,0,,Маған күш-қуатыңызды беріңізші! (қуаныш)
Dialogue: 0,0:13:45.62,0:13:48.41,Default,,0,0,0,,Мейірімді шаралар қолдануыңызды өтінемін➡
Dialogue: 0,0:13:48.41,0:13:50.76,Default,,0,0,0,,(Сүйек сынуының дыбысы)
Dialogue: 0,0:13:50.76,0:13:54.08,Default,,0,0,0,,Бұл ымыра іздеудің нәтижесі.
Dialogue: 0,0:13:54.08,0:13:58.24,Default,,0,0,0,,Сырттай қарағанда, әр бұтақтың жойылуы жай ғана апат еді➡
Dialogue: 0,0:13:58.24,0:14:02.67,Default,,0,0,0,,Қылмыс жасады деп айыпталатын адам жоқ.
Dialogue: 0,0:14:02.67,0:14:07.23,Default,,0,0,0,,Бұл мен жасаған фактіні өзгертпейді.
Dialogue: 0,0:14:07.23,0:14:12.95,Default,,0,0,0,,Енді не істейсіз?
Dialogue: 0,0:14:12.95,0:14:15.07,Default,,0,0,0,,Оны іздеңіз
Dialogue: 0,0:14:15.07,0:14:20.61,Default,,0,0,0,,Мен не істей алатынымды ойланғым келеді.
Dialogue: 0,0:14:20.61,0:14:26.23,Default,,0,0,0,,Иә, бірақ ол жол қатал және жалғыз.
Dialogue: 0,0:14:26.23,0:14:30.57,Default,,0,0,0,,Иә
Dialogue: 0,0:14:30.57,0:14:35.36,Default,,0,0,0,,Қалай болғанда да, бүгіннен кейін уақытыңыз бар ма?
Dialogue: 0,0:14:35.36,0:14:37.86,Default,,0,0,0,,Бүгін?
Dialogue: 0,0:14:39.95,0:14:44.85,Default,,0,0,0,,(Айзава) Сондықтан мен қабылдау емтиханы логикаға жат дедім
Dialogue: 0,0:14:44.85,0:14:47.40,Default,,0,0,0,,Біз осы уақытқа дейін жеттік.
Dialogue: 0,0:14:47.40,0:14:50.52,Default,,0,0,0,,Жазғы демалысқа дейін уақытында үлгердің.
Dialogue: 0,0:14:50.52,0:14:53.91,Default,,0,0,0,,Маған көмектескендері үшін Токоха-чанға және басқаларға рахмет.
Dialogue: 0,0:14:53.91,0:14:57.13,Default,,0,0,0,,ﾄｺﾊ
Dialogue: 0,0:14:57.13,0:14:59.23,Default,,0,0,0,,Аға
Dialogue: 0,0:14:59.23,0:15:04.14,Default,,0,0,0,,Уақыт таяп қалды. Иә.
Dialogue: 0,0:15:04.14,0:15:10.08,Default,,0,0,0,,Мен мұндай нәрсе болады деп ешқашан күткен емеспін.
Dialogue: 0,0:15:10.08,0:15:12.74,Default,,0,0,0,,Ол тарату қауымдастығын құрды➡
Dialogue: 0,0:15:12.74,0:15:16.26,Default,,0,0,0,,Туыстары жоқ балаларға жағдай жасалған.
Dialogue: 0,0:15:16.26,0:15:21.57,Default,,0,0,0,,Бұл оны қолдайтын соңғы нәрсе болды.
Dialogue: 0,0:15:21.57,0:15:24.42,Default,,0,0,0,,Бірақ түптеп келгенде, мұнда болу маңыздырақ➡
Dialogue: 0,0:15:24.42,0:15:26.74,Default,,0,0,0,,Бұл көп емес пе? бұл бала
Dialogue: 0,0:15:26.74,0:15:29.74,Default,,0,0,0,,Ол, сөзсіз, Айдаһар империясының тармағының кумирі.
Dialogue: 0,0:15:29.74,0:15:32.91,Default,,0,0,0,,Токоханың кішкентай кезі есімде.
Dialogue: 0,0:15:32.91,0:15:35.50,Default,,0,0,0,,Бұл менің ағам.
Dialogue: 0,0:15:35.50,0:15:39.92,Default,,0,0,0,,Оған болашақты қолға алуға тағы бір мүмкіндік берілді.
Dialogue: 0,0:15:39.92,0:15:44.83,Default,,0,0,0,,Олай болса, қолымыздан келгенше қолдау көрсеткіміз келеді.
Dialogue: 0,0:15:44.83,0:15:48.73,Default,,0,0,0,,Драен филиалының көңілді Авангардынан ләззат алыңыз.
Dialogue: 0,0:15:48.73,0:15:52.95,Default,,0,0,0,,Ах. (Ояма) Мамору-кюн Токоха-чан!
Dialogue: 0,0:15:52.95,0:15:55.90,Default,,0,0,0,,Күткеніңізге рахмет!
Dialogue: 0,0:15:55.90,0:16:08.97,Default,,0,0,0,,♪♪～
Dialogue: 0,0:16:08.97,0:16:12.92,Default,,0,0,0,,《Шион: Сіздің амбицияңыз Киба кланы қалғанша ғана➡
Dialogue: 0,0:16:12.92,0:16:15.42,Default,,0,0,0,,Мен оны тапсырамын》
Dialogue: 0,0:16:20.53,0:16:24.73,Default,,0,0,0,,Бұл ұзақ жол болды, Шион-сама.
Dialogue: 0,0:16:24.73,0:16:27.97,Default,,0,0,0,,Мен бұған әлі үйрене алмай жүрмін.
Dialogue: 0,0:16:27.97,0:16:30.92,Default,,0,0,0,,Енді шебер емес ➡
Dialogue: 0,0:16:30.92,0:16:34.68,Default,,0,0,0,,Ол Кибаның нағыз мұрагері.
Dialogue: 0,0:16:34.68,0:16:38.48,Default,,0,0,0,,Жоқ, бәрі осы жерден басталады.
Dialogue: 0,0:16:40.40,0:16:42.97,Default,,0,0,0,,Уақыт таяп қалды. Тезірек алайық.
Dialogue: 0,0:16:42.97,0:16:46.07,Default,,0,0,0,,Барлығы күтеді. Ах.
Dialogue: 0,0:16:55.91,0:16:58.10,Default,,0,0,0,,Ивакура. (Ивакура) Иә.
Dialogue: 0,0:16:58.10,0:17:02.24,Default,,0,0,0,,Сіз себеп таба алмаған әрекетті жасадыңыз ба?
Dialogue: 0,0:17:02.24,0:17:14.97,Default,,0,0,0,,♪♪～
Dialogue: 0,0:17:14.97,0:17:19.75,Default,,0,0,0,,Хе, мен сенен жеңіліп қалдым.
Dialogue: 0,0:17:19.75,0:17:23.85,Default,,0,0,0,,Енді қайда баруымыз керек?
Dialogue: 0,0:17:27.23,0:17:31.92,Default,,0,0,0,,Менің тестілеу нәтижелерім бұрынғыға қарағанда жақсырақ болды, сәл ғана.
Dialogue: 0,0:17:31.92,0:17:36.29,Default,,0,0,0,,Киба Зайбатсу бізге жаңа медициналық технология берді.
Dialogue: 0,0:17:36.29,0:17:39.16,Default,,0,0,0,,Шион-сан?
Dialogue: 0,0:17:39.16,0:17:42.91,Default,,0,0,0,,Бүкіл өмірімді өткізсем де оның орнын толтыра алмайтын шығармын
Dialogue: 0,0:17:42.91,0:17:47.13,Default,,0,0,0,,Бірақ мен ешқашан берілмеймін және берілмеймін!
Dialogue: 0,0:17:47.13,0:17:51.23,Default,,0,0,0,,Мен қолымнан келгеннің бәрін орындап өмір сүремін!
Dialogue: 0,0:17:59.46,0:18:02.33,Default,,0,0,0,,Мен де сенімен бірге алып кетемін. Луна!
Dialogue: 0,0:18:02.33,0:18:05.07,Default,,0,0,0,,Мен де сол қателікті жібердім.
Dialogue: 0,0:18:05.07,0:18:11.54,Default,,0,0,0,,Бірге құшақтасудың орнына, бірге алға қарай жол табуымыз керек еді.
Dialogue: 0,0:18:11.54,0:18:17.65,Default,,0,0,0,,Ұрысса да, жек көрсең де, доспыз.
Dialogue: 0,0:18:17.65,0:18:22.45,Default,,0,0,0,,Осы жолы бірге барайық, ә!
Dialogue: 0,0:18:22.45,0:18:24.45,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:35.75,0:18:39.82,Default,,0,0,0,,Жұмыс аяқталуға жақын. Мен келесі аптада Сингапурға қайтамын.
Dialogue: 0,0:18:39.82,0:18:43.92,Default,,0,0,0,,Не? Әли тағы келді!? Мен бұл туралы ештеңе істей алмаймын.
Dialogue: 0,0:18:43.92,0:18:47.79,Default,,0,0,0,,Иә, бұл бөлімді саған қалдырамын, Ли.
Dialogue: 0,0:18:47.79,0:18:54.57,Default,,0,0,0,,О, мұнда білгеніміз технологиямызды қайтарады.
Dialogue: 0,0:18:54.57,0:18:59.24,Default,,0,0,0,,Біз сондай-ақ жаңа талантты қызметкерлерді қамтамасыз ете алдық.
Dialogue: 0,0:18:59.24,0:19:01.24,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:19:01.24,0:19:03.89,Default,,0,0,0,,Токоха-чан!
Dialogue: 0,0:19:03.89,0:19:05.93,Default,,0,0,0,,ｲｴｲ！
Dialogue: 0,0:19:05.93,0:19:09.30,Default,,0,0,0,,Қарбалас кестеңізге қарамастан келгеніңіз үшін рахмет➡
Dialogue: 0,0:19:09.30,0:19:11.83,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:19:11.83,0:19:14.95,Default,,0,0,0,,А, ресми әңгіме жоқ!
Dialogue: 0,0:19:14.95,0:19:18.26,Default,,0,0,0,,Бүгін біз бәріміз де жауынгерміз!
Dialogue: 0,0:19:18.26,0:19:20.51,Default,,0,0,0,,Мен көңілді боламын!
Dialogue: 0,0:19:20.51,0:19:22.61,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:30.07,0:19:32.97,Default,,0,0,0,,Әр бөлім бастығына: Мамору-шан мен Ибуки-шанға!
Dialogue: 0,0:19:32.97,0:19:36.89,Default,,0,0,0,,Промоутер қауымдастығынан көптеген жауынгерлер бар!
Dialogue: 0,0:19:36.89,0:19:39.13,Default,,0,0,0,,Екінші жағынан, мен сүйкімді жігітпін!
Dialogue: 0,0:19:39.13,0:19:42.26,Default,,0,0,0,,Тіпті әлемге әйгілі аты аңызға айналған жауынгерлер!
Dialogue: 0,0:19:42.26,0:19:44.56,Default,,0,0,0,,Мен қалтырап тұрмын!
Dialogue: 0,0:19:47.79,0:19:49.75,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:19:49.75,0:19:54.83,Default,,0,0,0,,Ақыр аяғында мен әлі де осындай жерде бетімді көрсететін күйдемін...
Dialogue: 0,0:19:54.83,0:19:56.86,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:56.86,0:20:00.78,Default,,0,0,0,,Цзянси мырза! Эниши мырза да қатысады!
Dialogue: 0,0:20:00.78,0:20:02.92,Default,,0,0,0,,А, жоқ, мен...
Dialogue: 0,0:20:02.92,0:20:05.64,Default,,0,0,0,,Эй, кел! Апыр-ай!
Dialogue: 0,0:20:05.64,0:20:09.14,Default,,0,0,0,,Қош келдіңіз! Карточкалық капитал дүкенінің турниріне барайық!
Dialogue: 0,0:20:11.56,0:20:14.73,Default,,0,0,0,,Айтпақшы, негізгі ұйымдастырушы кім?
Dialogue: 0,0:20:14.73,0:20:17.60,Default,,0,0,0,,Ол әлі келген жоқ!
Dialogue: 0,0:20:17.60,0:20:21.20,Default,,0,0,0,,Сіз мұны айтқанда не істеп жатырсыз?
Dialogue: 0,0:20:41.07,0:20:44.29,Default,,0,0,0,,Жоқ! Бұл қазірдің өзінде ұзақ!
Dialogue: 0,0:20:44.29,0:20:46.74,Default,,0,0,0,,Микуру мырза, кеттік!
Dialogue: 0,0:20:46.74,0:20:48.84,Default,,0,0,0,,Қош келдіңіз!
Dialogue: 0,0:20:51.90,0:20:54.32,Default,,0,0,0,,Сонда сіз әлі орала алмайсыз ба?
Dialogue: 0,0:20:54.32,0:20:57.91,Default,,0,0,0,,[ТЕЛ] (Микуру) Сіздің денеңіз енді аздап қозғала алады, солай ма?
Dialogue: 0,0:20:57.91,0:21:02.08,Default,,0,0,0,,Енді мен сізді қарсы алу үшін қанша төмен баруым керек деп ойлаймын.
Dialogue: 0,0:21:02.08,0:21:07.77,Default,,0,0,0,,[TEL] (Тікелей эфир) Ақырында мен Куроно үшін ештеңе істей алмадым.
Dialogue: 0,0:21:07.77,0:21:11.92,Default,,0,0,0,,[ТЕЛ] Маған барлығын мәжбүрлеп, мені қорғаудың орнына, мен мұны істеп жатырмын➡
Dialogue: 0,0:21:11.92,0:21:14.62,Default,,0,0,0,,Мен сені жаман сезіндім
Dialogue: 0,0:21:14.62,0:21:20.43,Default,,0,0,0,,Кешіріңіз. Куроно мен сізге, мен шынымен кешірім сұраймын.
Dialogue: 0,0:21:20.43,0:21:24.73,Default,,0,0,0,,Олай ойласаң, кездесіп, айт!
Dialogue: 0,0:21:27.59,0:21:31.97,Default,,0,0,0,,Негізінде, Куроно бұдан әлдеқайда жетілген.
Dialogue: 0,0:21:31.97,0:21:36.74,Default,,0,0,0,,Ол мен туралы бірдеңе деді ме?
Dialogue: 0,0:21:36.74,0:21:39.13,Default,,0,0,0,,[ТЕЛ] (Микуру) Мен түсінбеймін➡
Dialogue: 0,0:21:39.13,0:21:42.63,Default,,0,0,0,,Егер кездессек, онда мен ойланамын.
Dialogue: 0,0:21:45.24,0:21:47.27,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:21:47.27,0:21:49.57,Default,,0,0,0,,Мен жай ғана жағдайды біраз бақылап тұрамын.
Dialogue: 0,0:21:49.57,0:21:52.11,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:21:52.11,0:21:54.73,Default,,0,0,0,,Барлығы бұрыннан бар!
Dialogue: 0,0:21:54.73,0:21:57.57,Default,,0,0,0,,Не? Өйткені әлі уақыт...
Dialogue: 0,0:21:57.57,0:22:01.25,Default,,0,0,0,,Міне, бізде шопинг турнирін өткізгенімізге біраз болды.
Dialogue: 0,0:22:01.25,0:22:03.74,Default,,0,0,0,,Сіз тым ерте келдіңіз!
Dialogue: 0,0:22:03.74,0:22:06.14,Default,,0,0,0,,Жай күту деген болмайды➡
Dialogue: 0,0:22:06.14,0:22:08.06,Default,,0,0,0,,Мен көп нәрсеге көмектестім.
Dialogue: 0,0:22:08.06,0:22:10.61,Default,,0,0,0,,Барлық дайындық жұмыстары аяқталды.
Dialogue: 0,0:22:10.61,0:22:13.08,Default,,0,0,0,,Мен мұны саған беремін.
Dialogue: 0,0:22:13.08,0:22:15.65,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:22:15.65,0:22:18.05,Default,,0,0,0,,Кеш келу арқылы қалай көңіл көтеруге болады➡
Dialogue: 0,0:22:18.05,0:22:21.59,Default,,0,0,0,,Бұл Миямото Мусаши ма? Дұрыс емес!
Dialogue: 0,0:22:21.59,0:22:24.24,Default,,0,0,0,,Өйткені, Куроно дүкен турнирін өткізіп жатыр➡
Dialogue: 0,0:22:24.24,0:22:28.25,Default,,0,0,0,,1 миллион жарық жылы! Дұрыс!
Dialogue: 0,0:22:28.25,0:22:31.20,Default,,0,0,0,,Уақытында келсем де
Dialogue: 0,0:22:31.20,0:22:33.57,Default,,0,0,0,,Қазір бастай аламыз ба?
Dialogue: 0,0:22:33.57,0:22:35.92,Default,,0,0,0,,ｸﾞﾙｸﾞﾙｶｯﾌﾟ！
Dialogue: 0,0:22:35.92,0:22:37.92,Default,,0,0,0,,Бұл Гүлгүл кесе емес!
Dialogue: 0,0:22:37.92,0:22:39.99,Default,,0,0,0,,Жақсы, жақсы
Dialogue: 0,0:22:39.99,0:22:43.09,Default,,0,0,0,,Бұл сенің де бірінші рет, Куроно-кун.
Dialogue: 0,0:22:43.09,0:22:47.23,Default,,0,0,0,,Енді, Куроно-кун, мұнда кел. Кешіріңіз.
Dialogue: 0,0:22:47.23,0:22:59.94,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:59.94,0:23:01.94,Default,,0,0,0,,Куроно мырза, міне осы!
Dialogue: 0,0:23:05.58,0:23:08.42,Default,,0,0,0,,Ал... ақыры, барлығы➡
Dialogue: 0,0:23:08.42,0:23:12.41,Default,,0,0,0,,«Авангард» осылай құрылды.
Dialogue: 0,0:23:12.41,0:23:17.13,Default,,0,0,0,,Бүгінге күш-қуат берген әрбір адамға➡
Dialogue: 0,0:23:17.13,0:23:22.07,Default,,0,0,0,,Шын жүректен рахмет!
Dialogue: 0,0:23:22.07,0:23:25.65,Default,,0,0,0,,Олай болса, бүгін көңілді өтейік!
Dialogue: 0,0:23:25.65,0:23:27.67,Default,,0,0,0,,ｽﾀﾝﾄﾞｱｯﾌﾟ…！
Dialogue: 0,0:23:27.67,0:23:29.67,Default,,0,0,0,,ｳﾞｧﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:23:32.34,0:23:34.34,Default,,0,0,0,,Оны кесіңіз!
Dialogue: 0,0:23:36.30,0:23:42.12,Default,,0,0,0,,Жүрекке Китар!
Dialogue: 0,0:23:42.12,0:23:44.09,Default,,0,0,0,,Гяаах!
Dialogue: 0,0:23:44.09,0:23:46.79,Default,,0,0,0,,Біз Үшбірлік Айдаһармыз!
Dialogue: 0,0:23:46.79,0:23:50.45,Default,,0,0,0,,Бұл біз! Ең мықты команда!
Dialogue: 0,0:23:50.45,0:23:53.55,Default,,0,0,0,,Мен саған көрсетемін!
Dialogue: 0,0:23:55.58,0:23:59.47,Default,,0,0,0,,Маған қоңырау шалыңыз!
Dialogue: 0,0:23:59.47,0:24:02.07,Default,,0,0,0,,Мен қайтамын!
Dialogue: 0,0:24:05.96,0:24:08.58,Default,,0,0,0,,ﾗｲﾄﾞ！
Dialogue: 0,0:24:08.58,0:24:15.29,Default,,0,0,0,,♪♪～
Dialogue: 0,0:24:15.29,0:24:17.39,Default,,0,0,0,,Уау!
Dialogue: 0,0:24:17.39,0:24:20.24,Default,,0,0,0,,Уау...!
Dialogue: 0,0:24:20.24,0:24:22.26,Default,,0,0,0,,Сақ болмасаң, жаусың, Хироки-кун.
Dialogue: 0,0:24:22.26,0:24:24.33,Default,,0,0,0,,Жарайсың!
Dialogue: 0,0:24:24.33,0:24:31.99,Default,,0,0,0,,♪♪～
Dialogue: 0,0:24:31.99,0:24:34.01,Default,,0,0,0,,Мен саған рұқсат бермеймін!
Dialogue: 0,0:24:34.01,0:24:39.66,Default,,0,0,0,,♪♪～
Dialogue: 0,0:24:39.66,0:24:42.66,Default,,0,0,0,,Маған бар күшіңмен кел!
Dialogue: 0,0:24:42.66,0:24:45.93,Default,,0,0,0,,Әй!
Dialogue: 0,0:24:45.93,0:24:49.82,Default,,0,0,0,,Патшалық! Менің жаңа қылышым!
Dialogue: 0,0:24:49.82,0:24:52.42,Default,,0,0,0,,Тағдырдың рыцарь Альто-Мэйл!
Dialogue: 0,0:24:52.42,0:24:59.06,Default,,0,0,0,,♪♪～
Dialogue: 0,0:24:59.06,0:25:01.25,Default,,0,0,0,,Гяаах!
Dialogue: 0,0:25:01.25,0:25:03.47,Default,,0,0,0,,Жаңа болашаққа гүлден!
Dialogue: 0,0:25:03.47,0:25:05.90,Default,,0,0,0,,Жүрек күйген гүл қыз Аша!
Dialogue: 0,0:25:05.90,0:25:12.63,Default,,0,0,0,,♪♪～
Dialogue: 0,0:25:12.63,0:25:15.25,Default,,0,0,0,,Кесіңіз! Жаңа әлем!
Dialogue: 0,0:25:15.25,0:25:17.80,Default,,0,0,0,,ｸﾛﾉｼﾞｪｯﾄ･ﾄﾞﾗｺﾞﾝＧ！
Dialogue: 0,0:25:17.80,0:25:20.23,Default,,0,0,0,,Кеттік, Ибуки!
Dialogue: 0,0:25:20.23,0:25:23.72,Default,,0,0,0,,Кел, Куроно!
Dialogue: 0,0:25:23.72,0:25:26.12,Default,,0,0,0,,Гяаах!
Dialogue: 0,0:25:26.12,0:25:28.92,Default,,0,0,0,,(Дарио) Қ… Қандай қорқынышты маска. Маған бұл керек емес.
Dialogue: 0,0:27:04.94,0:27:07.07,Default,,0,0,0,,Сізді ұзақ күттіргенім үшін кешіріңіз➡
Dialogue: 0,0:27:07.07,0:27:11.75,Default,,0,0,0,,G Quest➡ ойынында ұрпақ шебері атағын жеңіп алғандардың барлығына
Dialogue: 0,0:27:11.75,0:27:17.24,Default,,0,0,0,,Бүгін тағы да Тәжі көшбасшысы болуға тырысасыз деп үміттенемін.
Dialogue: 0,0:27:17.24,0:27:20.76,Default,,0,0,0,,Барлығы бізге Vanguard➡ тобына қосылды
Dialogue: 0,0:27:20.76,0:27:23.67,Default,,0,0,0,,Бұл қызықты болады деп үміттенемін.
Dialogue: 0,0:27:23.67,0:27:25.67,Default,,0,0,0,,Бастайық!
Dialogue: 0,0:27:29.91,0:27:34.14,Default,,0,0,0,,((Дәл қазір мен Кибаны қалпына келтіру үшін бар күшімді салғым келеді.
Dialogue: 0,0:27:34.14,0:27:37.64,Default,,0,0,0,,Мен Vanguard-қа басқа жолдармен үлес қосқым келеді))
Dialogue: 0,0:27:40.59,0:27:43.78,Default,,0,0,0,,((мен де келесі жылы шетелге оқуға барамын, сондықтан өтіңіз!
Dialogue: 0,0:27:43.78,0:27:46.88,Default,,0,0,0,,Куроно сынаққа түседі, солай ма? Сәттілік! ))
Dialogue: 0,0:27:53.49,0:27:57.49,Default,,0,0,0,,《Оны қазір көрсет! Мен шынымен қалайтын жауап! 》
Dialogue: 0,0:28:01.00,0:28:03.31,Default,,0,0,0,,Ха!
Dialogue: 0,0:28:03.31,0:28:05.91,Default,,0,0,0,,《Екі адам: Олар құлады》
Dialogue: 0,0:30:38.97,0:30:42.47,Default,,0,0,0,,< Ыстық күндер әлі де жалғасуда
Dialogue: 0,0:30:42.47,0:30:46.88,Default,,0,0,0,,Мен салқын жерге барғым келеді, сондықтан...
Dialogue: 0,0:30:46.88,0:30:50.88,Default,,0,0,0,,Бұл жолы кондиционер жұмыс істеді →
Dialogue: 0,0:30:52.93,0:30:56.10,Default,,0,0,0,,<Көркем галереялар мен мұражайлар жиналады →
Dialogue: 0,0:30:56.10,0:30:59.77,Default,,0,0,0,,Сезіміңізді салқындататын мәдени астана
Dialogue: 0,0:31:01.27,0:31:07.27,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory