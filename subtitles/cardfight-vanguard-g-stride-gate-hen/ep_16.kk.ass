Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:03.81,0:01:07.44,Default,,0,0,0,,Stride Force жинау сәтті аяқталды.
Dialogue: 0,0:01:07.44,0:01:10.28,Default,,0,0,0,,Берілістер жарамсыз болып қалады➡
Dialogue: 0,0:01:10.28,0:01:13.10,Default,,0,0,0,,Қажетті соманы қамтамасыз ету туралы алаңдаушылық болды➡
Dialogue: 0,0:01:13.10,0:01:19.62,Default,,0,0,0,,Біз бірден жаңа жүйені құрдық және бұл мәселені шештік.
Dialogue: 0,0:01:19.62,0:01:24.31,Default,,0,0,0,,Біз енді Зодиак уақытының соңғы бірлігін шақыруды бастаймыз.
Dialogue: 0,0:01:24.31,0:01:28.97,Default,,0,0,0,,Аа, мен саған көмектессем жақсы, бірақ бұл көбірек кедергі.
Dialogue: 0,0:01:28.97,0:01:31.35,Default,,0,0,0,,Бір Вакамизу жеткілікті
Dialogue: 0,0:01:31.35,0:01:36.47,Default,,0,0,0,,Қажет болса, бітімгерді тексеріңіз.
Dialogue: 0,0:01:36.47,0:01:41.14,Default,,0,0,0,,Конфигурацияны Wakamizu➡ әзірлеген бағдарлама басқарады
Dialogue: 0,0:01:41.14,0:01:45.18,Default,,0,0,0,,Мәселе жоқ.
Dialogue: 0,0:01:45.18,0:01:49.78,Default,,0,0,0,,Иә, Вакамизудың істегені тамаша.
Dialogue: 0,0:05:01.83,0:05:03.78,Default,,0,0,0,,Сіз толығымен жеңілдіңіз.
Dialogue: 0,0:05:03.78,0:05:07.32,Default,,0,0,0,,Біз не істеуіміз керек? Сіз үндемей қарап отыра бересіз бе?
Dialogue: 0,0:05:07.32,0:05:13.01,Default,,0,0,0,,Жақын арада бәрін реттейтін уақыт келеді.
Dialogue: 0,0:05:13.01,0:05:16.31,Default,,0,0,0,,[ТЕЛ]
Dialogue: 0,0:05:19.50,0:05:23.43,Default,,0,0,0,,Іс жақсы жүріп жатыр. Әрине.
Dialogue: 0,0:05:23.43,0:05:26.49,Default,,0,0,0,,Бірде-бір қате орын алған жоқ
Dialogue: 0,0:05:26.49,0:05:29.89,Default,,0,0,0,,Бәрі жақсы, басқа ештеңе жоқ.
Dialogue: 0,0:05:29.89,0:05:35.28,Default,,0,0,0,,Түсіндім, бұл қызықсыз.
Dialogue: 0,0:05:35.28,0:05:39.47,Default,,0,0,0,,Тәуелді карталар бар және бітімгершілік қамтамасыз етілді.
Dialogue: 0,0:05:39.47,0:05:44.89,Default,,0,0,0,,Қадам қақпасын ашуға қажетті соңғы құрылғы да жақын арада қолжетімді болады.
Dialogue: 0,0:05:44.89,0:05:49.81,Default,,0,0,0,,Осы қарқынмен біздің жеңісімізбен оңай аяқталады.
Dialogue: 0,0:05:49.81,0:05:53.98,Default,,0,0,0,,Мен бұл жағдайдан біраз ләззат алғым келеді.
Dialogue: 0,0:05:53.98,0:05:57.43,Default,,0,0,0,,Хм... Сонымен не істейміз?
Dialogue: 0,0:05:57.43,0:06:02.52,Default,,0,0,0,,Мен саған аздап қулық жасауға рұқсат етемін деп ойладым.
Dialogue: 0,0:06:02.52,0:06:04.82,Default,,0,0,0,,Жүйеңіз үшін
Dialogue: 0,0:06:07.03,0:06:13.17,Default,,0,0,0,,Пфф... хахаха...
Dialogue: 0,0:06:13.17,0:06:18.44,Default,,0,0,0,,Жоқ, рұқсат етілмейді.
Dialogue: 0,0:06:18.44,0:06:22.39,Default,,0,0,0,,Мен сені ешқашан кешірмеймін.
Dialogue: 0,0:06:22.39,0:06:25.03,Default,,0,0,0,,Бұл жағдайда біз сот шешімін іздейміз бе?
Dialogue: 0,0:06:25.03,0:06:29.13,Default,,0,0,0,,Бұл дүниенің шындығы
Dialogue: 0,0:06:40.11,0:06:42.18,Default,,0,0,0,,ｼｵﾝ
Dialogue: 0,0:06:42.18,0:06:44.28,Default,,0,0,0,,Неліктен екі адам?
Dialogue: 0,0:06:55.64,0:07:00.15,Default,,0,0,0,,Нақты оқиға: Реус мырза қолдайтын соңғы болашақ➡
Dialogue: 0,0:07:00.15,0:07:02.47,Default,,0,0,0,,Маған қызық емес.
Dialogue: 0,0:07:02.47,0:07:06.94,Default,,0,0,0,,Әй, бұл таңқаларлық... солай емес пе?
Dialogue: 0,0:07:06.94,0:07:11.51,Default,,0,0,0,,Алайда тамаша экспериментке кедергі болатын жалғыз нәрсе ➡
Dialogue: 0,0:07:11.51,0:07:14.01,Default,,0,0,0,,Мен сені кешірмеймін!
Dialogue: 0,0:07:16.15,0:07:19.28,Default,,0,0,0,,Қауіпсіздік туралы ескерту
Dialogue: 0,0:07:19.28,0:07:22.88,Default,,0,0,0,,Авангардқа қоңырау шалу
Dialogue: 0,0:07:28.19,0:07:33.49,Default,,0,0,0,,Қорқынышты монстрдың қара бет шабуылына мініңіз!
Dialogue: 0,0:07:35.65,0:07:38.52,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ｡ ﾂｲﾝﾄﾞﾗｲﾌﾞ
Dialogue: 0,0:07:38.52,0:07:42.62,Default,,0,0,0,,Heal Trigger Arist өлшемі қуат плюс 5000!
Dialogue: 0,0:07:46.11,0:07:50.63,Default,,0,0,0,,Орындалатын тақырыпқа гипотеза қойыңыз➡
Dialogue: 0,0:07:50.63,0:07:53.27,Default,,0,0,0,,Тәжірибе жасау
Dialogue: 0,0:07:53.27,0:07:56.29,Default,,0,0,0,,Тек сол нәрсеге өзіңізді батырыңыз
Dialogue: 0,0:07:56.29,0:08:00.09,Default,,0,0,0,,Вакамизу үшін бұл ең үлкен қуаныш!
Dialogue: 0,0:08:00.09,0:08:03.81,Default,,0,0,0,,Бұл бір ғанибет.
Dialogue: 0,0:08:03.81,0:08:08.31,Default,,0,0,0,,Сіздердің бәріңіз көңіл көтеріп жатқан сияқтысыздар, бұл әділетсіздік.
Dialogue: 0,0:08:08.31,0:08:13.14,Default,,0,0,0,,Құдайдың құбыжық Фенрирге мініңіз
Dialogue: 0,0:08:13.14,0:08:15.99,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ
Dialogue: 0,0:08:15.99,0:08:19.64,Default,,0,0,0,,Архангелдің күмбезі
Dialogue: 0,0:08:19.64,0:08:23.45,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｽｷﾙ ｿｳﾙﾁｬｰｼﾞ
Dialogue: 0,0:08:23.45,0:08:27.88,Default,,0,0,0,,Авангард жанды жарған кезде, сол бөлімшеге қоңырау шалуға болады.
Dialogue: 0,0:08:27.88,0:08:29.77,Default,,0,0,0,,Күмбезді тіреу дағдысы
Dialogue: 0,0:08:29.77,0:08:34.99,Default,,0,0,0,,Ыстық пен рапенил үшін қуат плюс 5000. Және жан заряды
Dialogue: 0,0:08:34.99,0:08:38.48,Default,,0,0,0,,Сонымен қатар, дағдыны белсендіріңіз. Ұпайға қоңырау шалыңыз
Dialogue: 0,0:08:38.48,0:08:41.78,Default,,0,0,0,,Хэтти шеберлігімен қуат плюс 3000
Dialogue: 0,0:08:41.78,0:08:47.20,Default,,0,0,0,,Soul Charge және Soul Blast біріктіріп, ➡ құрамды дайындаңыз
Dialogue: 0,0:08:47.20,0:08:52.59,Default,,0,0,0,,Құрылғыны қуаттандырыңыз... Бұл сіздің стандартыңыз.
Dialogue: 0,0:08:52.59,0:08:57.15,Default,,0,0,0,,Хэтти қоңырауын жылжыту. Котоноханың ашылуы
Dialogue: 0,0:08:57.15,0:09:02.60,Default,,0,0,0,,Палубаның жоғарғы картасына қарап, оны қайда қою керектігін шешіңіз. Жанға барыңыз.
Dialogue: 0,0:09:02.60,0:09:04.82,Default,,0,0,0,,Демалыс 1 артқы қорғаушы
Dialogue: 0,0:09:04.82,0:09:07.71,Default,,0,0,0,,Аян...?
Dialogue: 0,0:09:07.71,0:09:12.14,Default,,0,0,0,,Палубаны манипуляциялаңыз және болашақты өзгертіңіз...
Dialogue: 0,0:09:12.14,0:09:15.80,Default,,0,0,0,,Kotonoha шеберлігін белсендіру Пауэр plus 2000
Dialogue: 0,0:09:15.80,0:09:19.30,Default,,0,0,0,,Сонымен қатар, Ванның шеберлігімен, қуат плюс 2000
Dialogue: 0,0:09:19.30,0:09:23.27,Default,,0,0,0,,Skol's Burst Gray Punil көмегімен шабуыл!
Dialogue: 0,0:09:23.27,0:09:27.48,Default,,0,0,0,,Дағдыны белсендіру Soul заряды 1 карта ұтысы
Dialogue: 0,0:09:27.48,0:09:34.48,Default,,0,0,0,,Карточка жанға салынғандықтан, Котоноха 3000 плюс қуат алды.
Dialogue: 0,0:09:34.48,0:09:38.48,Default,,0,0,0,,Күмбезді тіреуішпен шабуыл. Бұл Ногард.
Dialogue: 0,0:09:40.64,0:09:42.78,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ
Dialogue: 0,0:09:42.78,0:09:47.23,Default,,0,0,0,,Heal Trigger 1 зақымдануды қалпына келтіру
Dialogue: 0,0:09:47.23,0:09:49.83,Default,,0,0,0,,Күш Котонохаға шабуыл жасайды!
Dialogue: 0,0:09:54.85,0:10:00.01,Default,,0,0,0,,Мен кері әрекет жасамаймын...бірақ Шинономе-кун➡
Dialogue: 0,0:10:00.01,0:10:04.61,Default,,0,0,0,,Сізбен жекпе-жек расталды.
Dialogue: 0,0:10:07.78,0:10:10.67,Default,,0,0,0,,Шион, сен де мүшесің бе?
Dialogue: 0,0:10:10.67,0:10:13.86,Default,,0,0,0,,Жоқ, мені шақырған сол еді➡
Dialogue: 0,0:10:13.86,0:10:16.16,Default,,0,0,0,,Эйс
Dialogue: 0,0:10:19.46,0:10:24.77,Default,,0,0,0,,Менің сенен бір жақсылығым бар. Жақсылық па?
Dialogue: 0,0:10:24.77,0:10:29.82,Default,,0,0,0,,Мен сіздің Лунаға көмектесуіңізді қалаймын.
Dialogue: 0,0:10:29.82,0:10:34.12,Default,,0,0,0,,Луна қазір не істеп жатыр? Сенімен бәрі жақсы ма? Қалдарыңыз қалай!?
Dialogue: 0,0:10:36.31,0:10:42.27,Default,,0,0,0,,Луна Қадам қақпасын ашу үшін құрбандыққа шалынғалы тұр.
Dialogue: 0,0:10:42.27,0:10:46.82,Default,,0,0,0,,Тек ұйықтап, құрылғыны басқарыңыз➡
Dialogue: 0,0:10:46.82,0:10:50.14,Default,,0,0,0,,Құралға ұқсайды
Dialogue: 0,0:10:50.14,0:10:55.65,Default,,0,0,0,,)
Dialogue: 0,0:10:55.65,0:10:59.20,Default,,0,0,0,,Неге... олай...
Dialogue: 0,0:10:59.20,0:11:04.82,Default,,0,0,0,,Луна мен үшін сол жолды таңдады...
Dialogue: 0,0:11:04.82,0:11:09.98,Default,,0,0,0,,Менде ондай құндылық жоқ...
Dialogue: 0,0:11:09.98,0:11:12.35,Default,,0,0,0,,Маған күш-қуатыңызды беріңізші!
Dialogue: 0,0:11:12.35,0:11:16.65,Default,,0,0,0,,Саған арқа сүйеуден басқа амалым жоқ...
Dialogue: 0,0:11:21.86,0:11:28.10,Default,,0,0,0,,Сіз бәріне не істегеніңізді білесіз.
Dialogue: 0,0:11:28.10,0:11:30.78,Default,,0,0,0,,Әрине мен білемін...
Dialogue: 0,0:11:30.78,0:11:36.34,Default,,0,0,0,,Бірақ бұл Лунаны құтқарудың жалғыз жолы...
Dialogue: 0,0:11:36.34,0:11:39.34,Default,,0,0,0,,Өйткені менде енді ештеңе жоқ...
Dialogue: 0,0:11:43.95,0:11:47.43,Default,,0,0,0,,Мен Лунаны құтқару үшін бәрін жасаймын!
Dialogue: 0,0:11:47.43,0:11:51.14,Default,,0,0,0,,Кез келген сыйлық алыңыз! Маған не болатыны маңызды емес!!
Dialogue: 0,0:11:51.14,0:11:54.31,Default,,0,0,0,,Өтінемін! Лунаға көмектесетін күш...
Dialogue: 0,0:11:54.31,0:11:56.94,Default,,0,0,0,,Жетер, тоқтат!
Dialogue: 0,0:11:56.94,0:11:59.80,Default,,0,0,0,,ｼｵﾝ…
Dialogue: 0,0:11:59.80,0:12:04.80,Default,,0,0,0,,Менің... сені кешіретін ойым жоқ.
Dialogue: 0,0:13:53.16,0:13:58.76,Default,,0,0,0,,Хехехе... Бірлікті шақыру да еш қиындықсыз жүріп жатыр.
Dialogue: 0,0:13:58.76,0:14:01.43,Default,,0,0,0,,Әрине
Dialogue: 0,0:14:01.43,0:14:05.91,Default,,0,0,0,,Шинономе-кун, арам ойларыңмен➡
Dialogue: 0,0:14:05.91,0:14:08.77,Default,,0,0,0,,Бұл Wakamizu жүйесі сәтсіз болады➡
Dialogue: 0,0:14:08.77,0:14:11.11,Default,,0,0,0,,Ешқашан
Dialogue: 0,0:14:11.11,0:14:13.46,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:14:13.46,0:14:16.85,Default,,0,0,0,,Қаһарлы құбыжық Қара бет!
Dialogue: 0,0:14:16.85,0:14:22.14,Default,,0,0,0,,Екі артқы қорғаушыны күшейту үшін қадам жасау дағдыңызды пайдаланыңыз!
Dialogue: 0,0:14:22.14,0:14:24.14,Default,,0,0,0,,Ванишке қоңырау шалыңыз!
Dialogue: 0,0:14:24.14,0:14:27.13,Default,,0,0,0,,Бір қатардағы барлық жау бөлімшелері демалып жатқандықтан➡
Dialogue: 0,0:14:27.13,0:14:29.14,Default,,0,0,0,,Құпия маневр іске қосылды!
Dialogue: 0,0:14:29.14,0:14:31.13,Default,,0,0,0,,ﾊﾟﾜｰﾌﾟﾗｽ2000！
Dialogue: 0,0:14:31.13,0:14:34.82,Default,,0,0,0,,Бір тыл сақшысын сал!
Dialogue: 0,0:14:34.82,0:14:38.77,Default,,0,0,0,,Қаһарлы құбыжық Қара беттің құпия маневрлері
Dialogue: 0,0:14:38.77,0:14:43.14,Default,,0,0,0,,Розенбергтің Глейпнирдің құпия айласы
Dialogue: 0,0:14:43.14,0:14:46.55,Default,,0,0,0,,Бұл екі денемен әрекеттесу мүмкін емес.
Dialogue: 0,0:14:46.55,0:14:49.78,Default,,0,0,0,,Сіздің бөлімшеңіз менің қолымда.
Dialogue: 0,0:14:49.78,0:14:55.17,Default,,0,0,0,,Бұл менің эксперименттік тақырыбым. Хехе...
Dialogue: 0,0:14:55.17,0:14:58.44,Default,,0,0,0,,Ваниш тегімен шабуыл
Dialogue: 0,0:14:58.44,0:15:00.44,Default,,0,0,0,,ｶﾞｰﾄﾞ
Dialogue: 0,0:15:00.44,0:15:02.83,Default,,0,0,0,,Қараңғы бетпен Авангардқа шабуыл
Dialogue: 0,0:15:02.83,0:15:05.76,Default,,0,0,0,,Толық күзет
Dialogue: 0,0:15:05.76,0:15:08.52,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ！
Dialogue: 0,0:15:08.52,0:15:12.12,Default,,0,0,0,,Heal Trigger 1 зақымдануды қалпына келтіру
Dialogue: 0,0:15:15.77,0:15:19.11,Default,,0,0,0,,Енді ол қайтадан кері айналды.
Dialogue: 0,0:15:19.11,0:15:23.20,Default,,0,0,0,,ｽﾀﾝﾄﾞｱﾝﾄﾞﾄﾞﾛｰ
Dialogue: 0,0:15:23.20,0:15:25.80,Default,,0,0,0,,Хихи, көріп тұрғаныңыздай➡
Dialogue: 0,0:15:25.80,0:15:29.10,Default,,0,0,0,,Салданған бөлімшелер тұра алмайды
Dialogue: 0,0:15:29.10,0:15:32.78,Default,,0,0,0,,Сіздің бөлімше менің бақылауымда.
Dialogue: 0,0:15:32.78,0:15:36.16,Default,,0,0,0,,Әзірге.
Dialogue: 0,0:15:36.16,0:15:38.76,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ
Dialogue: 0,0:15:38.76,0:15:42.12,Default,,0,0,0,,Құдайдың жойылу жануары Ваналгундо
Dialogue: 0,0:15:42.12,0:15:45.44,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｽｷﾙ ｿｳﾙﾁｬｰｼﾞ
Dialogue: 0,0:15:45.44,0:15:48.77,Default,,0,0,0,,Kotonoha Skill Пауэр Plus 3000
Dialogue: 0,0:15:48.77,0:15:51.14,Default,,0,0,0,,Котоноханы және Хэттиді жылжытыңыз
Dialogue: 0,0:15:51.14,0:15:53.15,Default,,0,0,0,,Гельга дағдылары
Dialogue: 0,0:15:53.15,0:15:57.43,Default,,0,0,0,,Жанның Гелгасын палубаның түбіне қойыңыз. Хэтти тұр.
Dialogue: 0,0:15:57.43,0:15:59.52,Default,,0,0,0,,ﾊﾟﾜｰﾌﾟﾗｽ3000
Dialogue: 0,0:15:59.52,0:16:03.52,Default,,0,0,0,,Ал жан заряды мен қуат плюс 3000
Dialogue: 0,0:16:05.44,0:16:09.50,Default,,0,0,0,,Мен мұны істеймін. Бұл әлі де жүргізіліп жатқан жұмыс.
Dialogue: 0,0:16:09.50,0:16:12.77,Default,,0,0,0,,Хэттимен шабуыл
Dialogue: 0,0:16:12.77,0:16:16.19,Default,,0,0,0,,Вангвардқа Ваналгундомен шабуыл жасаңыз
Dialogue: 0,0:16:16.19,0:16:19.22,Default,,0,0,0,,Дағдыны белсендіру Soul Blast
Dialogue: 0,0:16:19.22,0:16:22.42,Default,,0,0,0,,Хэттидің Пауэр Plus 6000 шеберлігі
Dialogue: 0,0:16:22.42,0:16:25.14,Default,,0,0,0,,Таро палубаның түбіне түсіріңіз
Dialogue: 0,0:16:25.14,0:16:27.50,Default,,0,0,0,,Хэтти стенді
Dialogue: 0,0:16:27.50,0:16:29.55,Default,,0,0,0,,Ванал Гунд дағдылары
Dialogue: 0,0:16:29.55,0:16:31.77,Default,,0,0,0,,Жарылған жанды гул деп атаңыз
Dialogue: 0,0:16:31.77,0:16:34.44,Default,,0,0,0,,Гульдің ашылуы
Dialogue: 0,0:16:34.44,0:16:37.16,Default,,0,0,0,,Қуат плюс 4000 шеберлікпен
Dialogue: 0,0:16:37.16,0:16:39.76,Default,,0,0,0,,Шабуыл жасағанда 1 картаны сал
Dialogue: 0,0:16:39.76,0:16:42.48,Default,,0,0,0,,Сіз күткендей, Шинономе-кун.
Dialogue: 0,0:16:42.48,0:16:46.12,Default,,0,0,0,,Бірақ мен сенен де жақсымын!
Dialogue: 0,0:16:46.12,0:16:49.12,Default,,0,0,0,,Күңгірт бетті құру үзіліс!
Dialogue: 0,0:16:49.12,0:16:53.47,Default,,0,0,0,,Жаңа ғана шақырылған аруақтар тынышталсын!
Dialogue: 0,0:16:53.47,0:16:57.43,Default,,0,0,0,,Авангард Вакамизу үшін де рахат
Dialogue: 0,0:16:57.43,0:17:01.48,Default,,0,0,0,,Палуба жасаңыз, шайқасыңыз және деректер жинаңыз➡
Dialogue: 0,0:17:01.48,0:17:05.10,Default,,0,0,0,,Палубаны жақсартыңыз және көбірек шайқасыңыз➡
Dialogue: 0,0:17:05.10,0:17:08.15,Default,,0,0,0,,Ал жеңістен кейін жеңіске жету
Dialogue: 0,0:17:08.15,0:17:11.49,Default,,0,0,0,,Ұрпақ сақшысы! Дағды іске қосылды!
Dialogue: 0,0:17:11.49,0:17:15.44,Default,,0,0,0,,Қарсыласыңыздың барлық артқы қатардағы бөлімшелері тыныштықта.
Dialogue: 0,0:17:15.44,0:17:18.53,Default,,0,0,0,,Плюс 10000 қалқан!
Dialogue: 0,0:17:18.53,0:17:21.13,Default,,0,0,0,,Банишпен тоқтау!
Dialogue: 0,0:17:23.57,0:17:27.57,Default,,0,0,0,,Сіздің бөлімше әлі де менің бақылауымда.
Dialogue: 0,0:17:29.49,0:17:31.83,Default,,0,0,0,,Ванал Гунд шеберлігін белсендіру
Dialogue: 0,0:17:31.83,0:17:34.13,Default,,0,0,0,,Палубаның жоғарғы 4 картасын қараңыз➡
Dialogue: 0,0:17:34.13,0:17:38.80,Default,,0,0,0,,Палубаның үстіне 2 картаны, палубаның төменгі жағына 2 картаны қойыңыз
Dialogue: 0,0:17:38.80,0:17:41.14,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ
Dialogue: 0,0:17:41.14,0:17:44.82,Default,,0,0,0,,Критикалық триггердің барлық әсерлері Хэттиге өтеді
Dialogue: 0,0:17:44.82,0:17:47.09,Default,,0,0,0,,ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ
Dialogue: 0,0:17:47.09,0:17:51.13,Default,,0,0,0,,Тағы да барлық әсерлер Хэттиге өтеді.
Dialogue: 0,0:17:51.13,0:17:54.55,Default,,0,0,0,,Авангардқа Хэттимен бірге шабуыл жасаңыз!
Dialogue: 0,0:17:54.55,0:17:57.47,Default,,0,0,0,,Сізбен жекпе-жек расталды
Dialogue: 0,0:17:57.47,0:18:01.14,Default,,0,0,0,,Бұл палуба сол деректер негізінде құрастырылған.
Dialogue: 0,0:18:01.14,0:18:03.78,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:18:03.78,0:18:08.81,Default,,0,0,0,,Палубаны қанша манипуляциялауға тырыссаңыз да, бәрі бекер.
Dialogue: 0,0:18:08.81,0:18:11.45,Default,,0,0,0,,ﾀｰﾝｴﾝﾄﾞ
Dialogue: 0,0:18:11.45,0:18:14.84,Default,,0,0,0,,8-ші айналымның соңы Зақым 4 қарсы 5
Dialogue: 0,0:18:14.84,0:18:17.12,Default,,0,0,0,,Және бұл жағдай
Dialogue: 0,0:18:17.12,0:18:21.62,Default,,0,0,0,,Жекпе-жек менің келесі бұрылысымда аяқталады.
Dialogue: 0,0:18:24.98,0:18:29.40,Default,,0,0,0,,Мен кешірмеймін... Әрине.
Dialogue: 0,0:18:29.40,0:18:32.99,Default,,0,0,0,,Мен солай істедім
Dialogue: 0,0:18:32.99,0:18:39.49,Default,,0,0,0,,Бұлай біреуге сүйенуім ақымақтық болар...
Dialogue: 0,0:18:42.70,0:18:47.50,Default,,0,0,0,,Не? Денің сау ма? (Миямура) Иә.
Dialogue: 0,0:19:08.31,0:19:10.76,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:19:10.76,0:19:15.76,Default,,0,0,0,,Аммен кездескенде, мен оны құшақтап алуды ойладым.
Dialogue: 0,0:19:15.76,0:19:19.15,Default,,0,0,0,,Мен әрқашан солай ойладым!
Dialogue: 0,0:19:19.15,0:19:24.09,Default,,0,0,0,,Бірақ жеткілікті
Dialogue: 0,0:19:24.09,0:19:29.31,Default,,0,0,0,,Ол кезде мен сені тоқтата алмадым.
Dialogue: 0,0:19:29.31,0:19:33.62,Default,,0,0,0,,(Иида) Мен ағамның атын иемдендім. Мен мұны істеуім керек…
Dialogue: 0,0:19:33.62,0:19:36.22,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:19:38.30,0:19:44.44,Default,,0,0,0,,Ам Кел, бірге Лунаға көмектесейік.
Dialogue: 0,0:19:44.44,0:19:46.74,Default,,0,0,0,,Бірге барайық.
Dialogue: 0,0:19:49.65,0:19:59.31,Default,,0,0,0,,Кешіріңіз, мен... мен...
Dialogue: 0,0:19:59.31,0:20:03.51,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:03.51,0:20:09.31,Default,,0,0,0,,Юта Отокоцу
Dialogue: 0,0:20:13.66,0:20:17.28,Default,,0,0,0,,Эренді тоқтату үшін. Көпшілік кісі өлтіру – қате.
Dialogue: 0,0:20:17.28,0:20:22.70,Default,,0,0,0,,Міне! Қаһарлы құбыжық құдайдың қара бет
Dialogue: 0,0:20:22.70,0:20:27.65,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｽｷﾙ ｷﾞｶﾞﾊﾟﾗﾗｲｽﾞ
Dialogue: 0,0:20:27.65,0:20:33.78,Default,,0,0,0,,Зорлықшыл құбыжық Darkface құпия маневрлері Superior Mantis шақырады
Dialogue: 0,0:20:33.78,0:20:37.48,Default,,0,0,0,,ﾊﾟﾗﾗｲｽﾞ！
Dialogue: 0,0:20:37.48,0:20:40.85,Default,,0,0,0,,Дайын
Dialogue: 0,0:20:40.85,0:20:44.80,Default,,0,0,0,,Вакамизу мырза, сіз флуктуация туралы білесіз бе?
Dialogue: 0,0:20:44.80,0:20:49.93,Default,,0,0,0,,Тербелістер – болжанбайтын кеңістіктік және уақыттық өзгерістер➡
Dialogue: 0,0:20:49.93,0:20:53.83,Default,,0,0,0,,Міне, қозғалыс. Бұл дүниеде ауытқу бар➡
Dialogue: 0,0:20:53.83,0:20:56.15,Default,,0,0,0,,Барлығында пайда болады
Dialogue: 0,0:20:56.15,0:21:00.64,Default,,0,0,0,,Нәзік жел, ағаштар арқылы сүзілген күн сәулесі, ағыстың шуы
Dialogue: 0,0:21:00.64,0:21:04.16,Default,,0,0,0,,Күн мен жұлдыздардың орбиталарында да ауытқулар болады.
Dialogue: 0,0:21:04.16,0:21:06.31,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:21:06.31,0:21:09.48,Default,,0,0,0,,Бұл дүниедегі барлық нәрседе болатын ауытқулар
Dialogue: 0,0:21:09.48,0:21:14.90,Default,,0,0,0,,Маған мұндай ауытқу ұнайды.
Dialogue: 0,0:21:14.90,0:21:19.10,Default,,0,0,0,,Тіпті Vanguard ішінде де ауытқу бар.
Dialogue: 0,0:21:19.10,0:21:22.54,Default,,0,0,0,,Қараңғы бетпен шабуыл!
Dialogue: 0,0:21:22.54,0:21:27.43,Default,,0,0,0,,Ұрпақ қорғаушысы. Шатырдың жауынгер қызы Ханасацуки
Dialogue: 0,0:21:27.43,0:21:30.78,Default,,0,0,0,,Одан да көбірек күзет. Қанша қорғансаңыз да➡
Dialogue: 0,0:21:30.78,0:21:36.64,Default,,0,0,0,,Менің жеңісімде ешқандай айырмашылық жоқ. Үштік жетек!
Dialogue: 0,0:21:36.64,0:21:38.97,Default,,0,0,0,,ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ！
Dialogue: 0,0:21:38.97,0:21:43.66,Default,,0,0,0,,Барлық әсерлер Балкан Рафелтке жіберіледі. Шабуыл!
Dialogue: 0,0:21:43.66,0:21:47.30,Default,,0,0,0,,ｶﾞｰﾄﾞ
Dialogue: 0,0:21:47.30,0:21:52.30,Default,,0,0,0,,Барлық мүмкін жағдайларды қабылдау және тексеру және палубаны құру
Dialogue: 0,0:21:52.30,0:21:55.61,Default,,0,0,0,,Дәл жекпе-жекті дамыту
Dialogue: 0,0:21:55.61,0:21:59.49,Default,,0,0,0,,Болжауға болмайтын ауытқуларды және қайталанатын бұрылыстарды жою
Dialogue: 0,0:21:59.49,0:22:04.50,Default,,0,0,0,,Бұл мәре! Superior Mantis көмегімен шабуыл жасаңыз!
Dialogue: 0,0:22:04.50,0:22:07.87,Default,,0,0,0,,Дегенмен, ауытқулар болады
Dialogue: 0,0:22:07.87,0:22:10.47,Default,,0,0,0,,ｶﾞｰﾄﾞ
Dialogue: 0,0:22:10.47,0:22:15.01,Default,,0,0,0,,Күзетші дегеніміз не? Амал жоқ, бұл мүмкін емес
Dialogue: 0,0:22:15.01,0:22:18.45,Default,,0,0,0,,Тексеру бойынша жекпе-жек ағымдағы шабуылмен аяқталуы керек.
Dialogue: 0,0:22:18.45,0:22:22.85,Default,,0,0,0,,Неғұрлым нәзік тербелсе, соғұрлым жүрегім дірілдейді.
Dialogue: 0,0:22:22.85,0:22:27.44,Default,,0,0,0,,Мінсіз нәрседегі әлсіз дақ сияқты
Dialogue: 0,0:22:27.44,0:22:31.11,Default,,0,0,0,,Сондықтан мен сіздің экспериментіңізді өзгерткім келеді.
Dialogue: 0,0:22:31.11,0:22:36.93,Default,,0,0,0,,Қалай айтсаң, қуанышым сол
Dialogue: 0,0:22:36.93,0:22:40.62,Default,,0,0,0,,Мүмкін емес! Мүмкін емес!
Dialogue: 0,0:22:40.62,0:22:45.52,Default,,0,0,0,,《Мен мұны білдім, бірақ ол әлі де жақсы ма?》
Dialogue: 0,0:22:45.52,0:22:48.64,Default,,0,0,0,,Құрылғы әлі де менің бақылауымда!
Dialogue: 0,0:22:48.64,0:22:51.81,Default,,0,0,0,,Қате орын алса, оны түзетіңіз!
Dialogue: 0,0:22:51.81,0:22:56.02,Default,,0,0,0,,Бұл ақымақ... бітті!
Dialogue: 0,0:22:56.02,0:22:58.12,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:23:00.27,0:23:03.29,Default,,0,0,0,,Жұмақ пен Тозақ Құдайдың хайуан Фенрир!
Dialogue: 0,0:23:03.29,0:23:06.48,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｽｷﾙ ｿｳﾙﾁｬｰｼﾞ
Dialogue: 0,0:23:06.48,0:23:09.85,Default,,0,0,0,,Суваваға қоңырау шалыңыз және Хэттиге шегініңіз
Dialogue: 0,0:23:09.85,0:23:11.88,Default,,0,0,0,,Суваваның ашылуы
Dialogue: 0,0:23:11.88,0:23:15.60,Default,,0,0,0,,Әсерді жұмақ пен тозақ божественный хайуан Фенрир өзгертті
Dialogue: 0,0:23:15.60,0:23:19.01,Default,,0,0,0,,Палубаның жоғарғы жағындағы екі картаны қайда қою керектігін шешіңіз.
Dialogue: 0,0:23:19.01,0:23:21.29,Default,,0,0,0,,Екі карта да палубаға түседі
Dialogue: 0,0:23:21.29,0:23:25.48,Default,,0,0,0,,Жұмақ пен Тозақ Құдайлық аң Фенрирдің шеберлігі 1 картаны сал
Dialogue: 0,0:23:25.48,0:23:28.85,Default,,0,0,0,,Сонымен қатар, дағдыны іске қосып, Гельгаға қоңырау шалыңыз
Dialogue: 0,0:23:28.85,0:23:32.65,Default,,0,0,0,,Герудьяның ашылу эффектісін Фенрир өзгертті
Dialogue: 0,0:23:34.64,0:23:37.51,Default,,0,0,0,,1 карта палубаға 1 карта жанға
Dialogue: 0,0:23:37.51,0:23:39.54,Default,,0,0,0,,Гөлді шақырыңыз
Dialogue: 0,0:23:39.54,0:23:41.81,Default,,0,0,0,,Аян
Dialogue: 0,0:23:41.81,0:23:43.77,Default,,0,0,0,,Екі картаны да палубаның үстіне қойыңыз
Dialogue: 0,0:23:43.77,0:23:47.85,Default,,0,0,0,,Жұмақ пен Тозақ Құдайдың құбыжық Фенрирдің шеберлігі 1 картаны салыңыз
Dialogue: 0,0:23:47.85,0:23:51.15,Default,,0,0,0,,Сурваның шеберлік күші плюс 5000!
Dialogue: 0,0:23:53.86,0:23:55.96,Default,,0,0,0,,Аруақтармен шабуыл!
Dialogue: 0,0:23:55.96,0:23:58.83,Default,,0,0,0,,《Келесі сын айту керек, сонда...! 》
Dialogue: 0,0:23:58.83,0:24:00.83,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ！
Dialogue: 0,0:24:06.47,0:24:08.47,Default,,0,0,0,,Бұрылыспен шабуыл!
Dialogue: 0,0:24:08.47,0:24:10.51,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:24:10.51,0:24:13.81,Default,,0,0,0,,Көктегі тозаққа қарсы құдайлық аң Фенрирмен шабуыл!
Dialogue: 0,0:24:17.78,0:24:19.78,Default,,0,0,0,,ｼﾞｪﾈﾚｰｼｮﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:24:25.99,0:24:29.64,Default,,0,0,0,,Қалқан плюс шеберлікпен 10 000! Одан да күзетші!
Dialogue: 0,0:24:29.64,0:24:33.01,Default,,0,0,0,,Норгардтан алынған қарсы жарылысты пайдалану➡
Dialogue: 0,0:24:33.01,0:24:37.64,Default,,0,0,0,,G Guardian және 5000 қалқанымен берік қорғаныс
Dialogue: 0,0:24:37.64,0:24:40.94,Default,,0,0,0,,Тіпті қос триггермен де өту мүмкін емес!
Dialogue: 0,0:24:40.94,0:24:43.33,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ
Dialogue: 0,0:24:43.33,0:24:46.49,Default,,0,0,0,,Тірек триггері
Dialogue: 0,0:24:46.49,0:24:49.43,Default,,0,0,0,,ﾊﾟﾜｰﾌﾟﾗｽ5000！
Dialogue: 0,0:24:49.43,0:24:52.60,Default,,0,0,0,,Бұл не!? Триггер тұр!?
Dialogue: 0,0:24:52.60,0:24:56.81,Default,,0,0,0,,ｾｶﾝﾄﾞﾁｪｯｸ ｻｰﾄﾞﾁｪｯｸ
Dialogue: 0,0:24:56.81,0:25:02.23,Default,,0,0,0,,Heal Trigger 1 зақымдарды қалпына келтіреді. Қуат Swerve-ге түседі
Dialogue: 0,0:25:02.23,0:25:04.48,Default,,0,0,0,,Жоқ! Бұл...!
Dialogue: 0,0:25:04.48,0:25:08.35,Default,,0,0,0,,ｱﾀｯｸ
Dialogue: 0,0:25:08.35,0:25:23.15,Default,,0,0,0,,♪♪～
Dialogue: 0,0:25:23.15,0:25:26.45,Default,,0,0,0,,Мен бұны ешқашан күтпеген едім...
Dialogue: 0,0:25:26.45,0:25:29.96,Default,,0,0,0,,Бұл флуктуация.
Dialogue: 0,0:25:29.96,0:25:32.76,Default,,0,0,0,,Дүние шындығы маған күледі
Dialogue: 0,0:25:34.93,0:25:40.53,Default,,0,0,0,,Төрешінің ойынша, алаңнан қуылады.
Dialogue: 0,0:25:40.53,0:25:44.44,Default,,0,0,0,,Жүйе менсіз жұмыс істей береді!
Dialogue: 0,0:25:44.44,0:25:47.49,Default,,0,0,0,,Оны енді ешкім тоқтата алмайды!
Dialogue: 0,0:25:47.49,0:25:50.49,Default,,0,0,0,,Вакамизу тамаша!
Dialogue: 0,0:25:53.48,0:25:56.48,Default,,0,0,0,,Түсіндім, айтар сөзім бар.
Dialogue: 0,0:25:56.48,0:26:20.64,Default,,0,0,0,,♪♪～
Dialogue: 0,0:26:20.64,0:26:25.83,Default,,0,0,0,,Бірақ мен сенің кемелдігіңді жойғым келмейді.
Dialogue: 0,0:26:25.83,0:26:29.13,Default,,0,0,0,,Мен шамалы ауытқуды қалаймын
Dialogue: 0,0:30:41.22,0:30:43.48,Default,,0,0,0,,＜
Dialogue: 0,0:30:43.48,0:30:48.16,Default,,0,0,0,,Ол Сенгоку кезеңінің ұшқынын тудырды және бүкіл Канто аймағында тарады→
Dialogue: 0,0:30:48.16,0:30:51.14,Default,,0,0,0,,Ходжо Соун
Dialogue: 0,0:30:51.14,0:30:54.76,Default,,0,0,0,,Оның негізі алынбас қамал →
Dialogue: 0,0:30:54.76,0:30:58.15,Default,,0,0,0,,Атын шығарды
Dialogue: 0,0:30:59.65,0:31:05.65,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory