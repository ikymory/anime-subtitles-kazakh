Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:03.52,0:01:07.41,Default,,0,0,0,,Күрес серіктесі өзара байланыс пен тағдыр арқылы анықталады.
Dialogue: 0,0:01:07.41,0:01:12.16,Default,,0,0,0,,Мені осында әкелген сен едің ғой...
Dialogue: 0,0:01:12.16,0:01:15.46,Default,,0,0,0,,Киба Шионға қош келдіңіз
Dialogue: 0,0:04:29.49,0:04:33.21,Default,,0,0,0,,Талай қиындықты жеңіп, мойымай осы күнге жету ➡
Dialogue: 0,0:04:33.21,0:04:37.21,Default,,0,0,0,,Ол жоғары көтерілді. Бұл оның сыйы.
Dialogue: 0,0:04:39.80,0:04:43.89,Default,,0,0,0,,Жарқыраған қылыш Фидес...
Dialogue: 0,0:04:43.89,0:04:49.49,Default,,0,0,0,,Дегенмен, оны қолыңызбен ұстасаңыз да, ол әлі жарқырамайтын сияқты.
Dialogue: 0,0:04:51.48,0:04:56.02,Default,,0,0,0,,Тағдырыңды бағдарлайтын бес жекпе-жек... Нәтижеге қарай➡
Dialogue: 0,0:04:56.02,0:04:59.66,Default,,0,0,0,,Ғаламның ақиқаты болашақты анықтайды
Dialogue: 0,0:04:59.66,0:05:04.31,Default,,0,0,0,,Қазір, Стридегейт... Миджин Роузды қолдап жүр➡
Dialogue: 0,0:05:04.31,0:05:09.52,Default,,0,0,0,,Бұл әлемді кемел болашақ қамтығалы тұр.
Dialogue: 0,0:05:09.52,0:05:11.89,Default,,0,0,0,,Егер сіз оны тоқтатқыңыз келсе➡
Dialogue: 0,0:05:11.89,0:05:15.02,Default,,0,0,0,,Менімен күресте жеңесің.
Dialogue: 0,0:05:15.02,0:05:18.68,Default,,0,0,0,,Басқа жол жоқ
Dialogue: 0,0:05:18.68,0:05:28.48,Default,,0,0,0,,Боу?
Dialogue: 0,0:05:31.56,0:05:35.66,Default,,0,0,0,,Бәрін реттейік Шинономе Шоума
Dialogue: 0,0:05:39.56,0:05:43.16,Default,,0,0,0,,ｽﾀﾝﾄﾞｱｯﾌﾟ ｻﾞ ｳﾞｧﾝｶﾞｰﾄﾞ！ ｽﾀﾝﾄﾞｱｯﾌﾟ ｳﾞｧﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:05:46.37,0:05:50.87,Default,,0,0,0,,Найт Стиус қайта оралды! (Шинономе) Өсиеттерді жасаушы, Ван!
Dialogue: 0,0:05:57.90,0:06:00.57,Default,,0,0,0,,Артқы күзетшіге шабуыл жасаңыз!
Dialogue: 0,0:06:00.57,0:06:03.37,Default,,0,0,0,,Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:06:05.62,0:06:07.62,Default,,0,0,0,,ｱﾀｯｸ！
Dialogue: 0,0:06:15.00,0:06:19.15,Default,,0,0,0,,Жүр! Қарсы шабуылдаушы рыцарь Сүлеймен!
Dialogue: 0,0:06:19.15,0:06:21.84,Default,,0,0,0,,Сол күн➡
Dialogue: 0,0:06:21.84,0:06:27.01,Default,,0,0,0,,Мен бәрінен айырылдым
Dialogue: 0,0:06:27.01,0:06:33.32,Default,,0,0,0,,Мен сіздің бос сөзіңізге қосылып, сіздің стратегияңызға құладым.
Dialogue: 0,0:06:33.32,0:06:38.74,Default,,0,0,0,,Қиба мәртебесі мен намысын жоғалтып, намысы жерге түсті➡
Dialogue: 0,0:06:38.74,0:06:41.64,Default,,0,0,0,,Балшықпен жабылған!
Dialogue: 0,0:06:41.64,0:06:44.19,Default,,0,0,0,,Ал мен➡
Dialogue: 0,0:06:44.19,0:06:46.90,Default,,0,0,0,,Әдемі жерді қайтару үшін➡
Dialogue: 0,0:06:46.90,0:06:49.00,Default,,0,0,0,,Тастанды Киба!
Dialogue: 0,0:06:51.15,0:06:56.07,Default,,0,0,0,,Хехехе... Бұл кескілескен айқас
Dialogue: 0,0:06:56.07,0:07:01.03,Default,,0,0,0,,Иә, Шион, бұл қазір сенсің.
Dialogue: 0,0:07:01.03,0:07:05.98,Default,,0,0,0,,Жоюды білдіретін қасқырдың құйрығын босат.
Dialogue: 0,0:07:05.98,0:07:11.14,Default,,0,0,0,,Жүр! Тәңірлік әлем хайуан Фенрир. Котонохаға қоңырау шалыңыз
Dialogue: 0,0:07:11.14,0:07:17.19,Default,,0,0,0,,Аян. Палубаның жоғарғы жағындағы бір картаға қарап, оны қайда орналастыру керектігін шешіңіз.
Dialogue: 0,0:07:17.19,0:07:20.31,Default,,0,0,0,,Жанға өтіңіз. Демалыс 1 Артқы күзетші
Dialogue: 0,0:07:20.31,0:07:24.53,Default,,0,0,0,,Хатиді жылжыту. Свитиге қоңырау шалыңыз.
Dialogue: 0,0:07:24.53,0:07:28.49,Default,,0,0,0,,Қайсар ерік, жалаң жауынгерлік рух...
Dialogue: 0,0:07:28.49,0:07:31.48,Default,,0,0,0,,Мейірімді қорғалған әлемнен лақтырылды➡
Dialogue: 0,0:07:31.48,0:07:35.85,Default,,0,0,0,,Ішіңізде жасырылған жабайылық оянды.
Dialogue: 0,0:07:35.85,0:07:38.32,Default,,0,0,0,,Күзетші! Және ➡
Dialogue: 0,0:07:38.32,0:07:44.35,Default,,0,0,0,,G Quest-те жеңіске жеткен кезде әдемі жерді ұрлаған шындықты анықтау барысында ➡
Dialogue: 0,0:07:44.35,0:07:48.89,Default,,0,0,0,,Жабайы табиғат жарқырай түсті!
Dialogue: 0,0:07:48.89,0:07:53.48,Default,,0,0,0,,Фенрир құдайы аңымен шабуыл! Субтілік дағдыларды белсендіру
Dialogue: 0,0:07:53.48,0:07:57.07,Default,,0,0,0,,Сувити Сеулге жіберіңіз 1 карта ұтысы
Dialogue: 0,0:07:57.07,0:07:59.65,Default,,0,0,0,,Fenrir үшін қуат плюс 5000
Dialogue: 0,0:07:59.65,0:08:04.21,Default,,0,0,0,,Котоноханың шеберлігі Пауэр плюс өзіңізге 1000
Dialogue: 0,0:08:04.21,0:08:07.23,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ｡ ﾂｲﾝﾄﾞﾗｲﾌﾞ
Dialogue: 0,0:08:07.23,0:08:10.58,Default,,0,0,0,,ｹﾞｯﾄ ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ
Dialogue: 0,0:08:10.58,0:08:14.68,Default,,0,0,0,,Котоноханың күші Фенрир үшін сыни
Dialogue: 0,0:08:18.84,0:08:20.94,Default,,0,0,0,,ｱﾀｯｸ！
Dialogue: 0,0:08:25.25,0:08:27.65,Default,,0,0,0,,ﾀﾞﾒｰｼﾞ５…
Dialogue: 0,0:08:27.65,0:08:31.50,Default,,0,0,0,,Хехехе... Егер солай десеңіз➡
Dialogue: 0,0:08:31.50,0:08:36.11,Default,,0,0,0,,Бүгінгі адамды өсірген менмін.
Dialogue: 0,0:08:36.11,0:08:39.19,Default,,0,0,0,,Мұнда қараңғы екен, иә?
Dialogue: 0,0:08:39.19,0:08:42.53,Default,,0,0,0,,Логикаңмен мен туралы айтпа!
Dialogue: 0,0:08:42.53,0:08:46.92,Default,,0,0,0,,Жүр! Көк аспан рыцарь altomail!
Dialogue: 0,0:08:46.92,0:08:50.64,Default,,0,0,0,,ｽﾄﾗｲﾄﾞ･ｻﾞ･ｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:08:50.64,0:08:54.57,Default,,0,0,0,,Ұшатын көктегі қасиетті рыцарь Альтомайл!
Dialogue: 0,0:08:54.57,0:08:59.03,Default,,0,0,0,,Қадаммен жүру дағдысы! Беренос пен эскорт үшін қуат плюс 5000
Dialogue: 0,0:08:59.03,0:09:02.40,Default,,0,0,0,,Хитен Қасиетті Рыцарь Альтомильдің дағдылары
Dialogue: 0,0:09:02.40,0:09:05.32,Default,,0,0,0,,Барлық алдыңғы қатарлар үшін қуат плюс 3000
Dialogue: 0,0:09:05.32,0:09:09.47,Default,,0,0,0,,Селиумға қоңырау шалыңыз! Батыл! Қуат плюс 3000
Dialogue: 0,0:09:09.47,0:09:14.53,Default,,0,0,0,,Стиус пен Беленусты жылжытыңыз. Авангардқа Беленуспен шабуыл жасаңыз!
Dialogue: 0,0:09:14.53,0:09:16.53,Default,,0,0,0,,ｶﾞｰﾄﾞ
Dialogue: 0,0:09:18.97,0:09:23.85,Default,,0,0,0,,Қаншалықты жоққа шығарсаң да, бұл ащы шындық.
Dialogue: 0,0:09:23.85,0:09:29.31,Default,,0,0,0,,Хитен Қасиетті Рыцарь альтомайымен шабуыл! Беренос шеберлігі Сеулге барыңыз
Dialogue: 0,0:09:29.31,0:09:34.53,Default,,0,0,0,,1 дана салыңыз. Hiten no Holy Knight Altomile үшін Пауэр Plus 5000
Dialogue: 0,0:09:34.53,0:09:38.42,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ｡ ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ
Dialogue: 0,0:09:38.42,0:09:43.04,Default,,0,0,0,,Алыңыз! Триггерді емдеу!! Зақым 1 қалпына келтіру
Dialogue: 0,0:09:43.04,0:09:45.86,Default,,0,0,0,,Қуат Escort Eagle-ге түседі
Dialogue: 0,0:09:45.86,0:09:48.16,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:50.51,0:09:54.40,Default,,0,0,0,,ﾀﾞﾒｰｼﾞﾁｪｯｸ｡ ｹﾞｯﾄ ｽﾀﾝﾄﾞﾄﾘｶﾞｰ
Dialogue: 0,0:09:54.40,0:09:57.52,Default,,0,0,0,,Фенрир үшін қуат плюс 5000
Dialogue: 0,0:09:57.52,0:10:01.06,Default,,0,0,0,,ｴｽｺｰﾄ･ｲｰｸﾞﾙ！ ｼﾞｪﾈﾚｰｼｮﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:10:01.06,0:10:05.56,Default,,0,0,0,,Жеті түсті құдай Айрис. Қалқан плюс шеберлігі бар 5000
Dialogue: 0,0:10:09.30,0:10:14.86,Default,,0,0,0,,Шион Киба… Сіз мен елестеткен болашақтасыз➡
Dialogue: 0,0:10:14.86,0:10:17.99,Default,,0,0,0,,тұрып
Dialogue: 0,0:10:17.99,0:10:20.94,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:10:20.94,0:10:23.68,Default,,0,0,0,,Ваналгундо жойылатын құдайдың аңы!
Dialogue: 0,0:10:23.68,0:10:26.80,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｽｷﾙ ｿｳﾙﾁｬｰｼﾞ
Dialogue: 0,0:10:26.80,0:10:30.35,Default,,0,0,0,,Kotonoha Skill Пауэр Plus 3000
Dialogue: 0,0:10:30.35,0:10:33.74,Default,,0,0,0,,Әдемі жерді қайтарып аламын деп бұрын айттыңыз.
Dialogue: 0,0:10:33.74,0:10:37.19,Default,,0,0,0,,Сіз айтып отырған әдемі жер қандай?
Dialogue: 0,0:10:37.19,0:10:42.23,Default,,0,0,0,,Өзің туып өскен үйіңді айтасың ба? Әлде Кибаны басқару құқығы бар ма?
Dialogue: 0,0:10:42.23,0:10:44.33,Default,,0,0,0,,Бас директордың төрағасы?
Dialogue: 0,0:10:46.67,0:10:51.34,Default,,0,0,0,,Котонохада Вангардқа шабуыл. Ногард
Dialogue: 0,0:10:51.34,0:10:53.31,Default,,0,0,0,,ﾀﾞﾒｰｼﾞﾁｪｯｸ
Dialogue: 0,0:10:53.31,0:10:56.01,Default,,0,0,0,,ｹﾞｯﾄ ﾋｰﾙﾄﾘｶﾞｰ！
Dialogue: 0,0:10:56.01,0:11:00.32,Default,,0,0,0,,1-зиянды қалпына келтіру. Altomail-ге қуат!
Dialogue: 0,0:11:00.32,0:11:04.02,Default,,0,0,0,,Қазір бәрі менің қолымда.
Dialogue: 0,0:11:04.02,0:11:07.67,Default,,0,0,0,,Қаласаң, бірден беремін.
Dialogue: 0,0:11:07.67,0:11:12.35,Default,,0,0,0,,Ванал Гундомен шабуыл! Дағдыларды белсендіру
Dialogue: 0,0:11:12.35,0:11:15.85,Default,,0,0,0,,Soul Blast. Грейпуллға қоңырау шалыңыз!
Dialogue: 0,0:11:15.85,0:11:20.82,Default,,0,0,0,,Хэттидің Пауэр Plus 6000 шеберлігі
Dialogue: 0,0:11:20.82,0:11:23.02,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:11:23.02,0:11:25.68,Default,,0,0,0,,Ванал Гунд шеберлігі іске қосылды!
Dialogue: 0,0:11:25.68,0:11:31.85,Default,,0,0,0,,Палубаның үстіне 2 картаны, ал қалған 2 картаны палубаның төменгі жағына қойыңыз.
Dialogue: 0,0:11:31.85,0:11:35.85,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ｡ ｹﾞｯﾄ ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ
Dialogue: 0,0:11:35.85,0:11:38.64,Default,,0,0,0,,Барлық әсерлер Грайпунилге өтеді
Dialogue: 0,0:11:38.64,0:11:41.64,Default,,0,0,0,,Тағы бір сын
Dialogue: 0,0:11:41.64,0:11:45.08,Default,,0,0,0,,Бұл сонымен қатар Грейпунилге барлық әсер етеді.
Dialogue: 0,0:11:45.08,0:11:49.32,Default,,0,0,0,,ﾀﾞﾌﾞﾙｸﾘﾃｨｶﾙ…｡ ｻｰﾄﾞﾁｪｯｸ
Dialogue: 0,0:11:49.32,0:11:53.54,Default,,0,0,0,,Өте өкінішті, бұл Нотриггер. Бірақ➡
Dialogue: 0,0:11:53.54,0:11:57.99,Default,,0,0,0,,Қалыпты құрылғы жетекті тексерумен бірге шыққанда, Ванның шеберлігі іске қосылады
Dialogue: 0,0:11:57.99,0:12:01.36,Default,,0,0,0,,Ванды Сеулге жіберіңіз. 1 картаны салыңыз
Dialogue: 0,0:12:01.36,0:12:05.02,Default,,0,0,0,,Грейпунилмен шабуыл! Дағдыларды белсендіру
Dialogue: 0,0:12:05.02,0:12:08.19,Default,,0,0,0,,Жан заряды! 1 дана ұтыс
Dialogue: 0,0:12:08.19,0:12:11.69,Default,,0,0,0,,Жетер, Шион.
Dialogue: 0,0:12:11.69,0:12:14.32,Default,,0,0,0,,Сіз жақсы күрестіңіз.
Dialogue: 0,0:12:14.32,0:12:19.75,Default,,0,0,0,,Енді... Өзіңді тапсыр. Миоджин Роуз сізге береді➡
Dialogue: 0,0:12:19.75,0:12:24.05,Default,,0,0,0,,Барлығы бақытты әлемде... және ➡
Dialogue: 0,0:12:24.05,0:12:27.55,Default,,0,0,0,,Мен саған беретін болашақ
Dialogue: 0,0:14:12.51,0:14:17.60,Default,,0,0,0,,Ұрпақ сақшысы! Қасиетті айдаһар ұстара күзетші айдаһар!
Dialogue: 0,0:14:17.60,0:14:20.05,Default,,0,0,0,,Әй... Мен мұны бұрын айттым деп ойладым!
Dialogue: 0,0:14:20.05,0:14:23.55,Default,,0,0,0,,Маған беріп жатқан болашаққа қарғыс атсын!
Dialogue: 0,0:14:26.19,0:14:32.53,Default,,0,0,0,,Өйткені, сен ең жақсы бейнесің, Шион.
Dialogue: 0,0:14:32.53,0:14:35.38,Default,,0,0,0,,ｽﾄﾗｲﾄﾞ･ｻﾞ･ｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:14:35.38,0:14:38.30,Default,,0,0,0,,Теңген Альтомильді жеңу!
Dialogue: 0,0:14:38.30,0:14:43.24,Default,,0,0,0,,Қадаммен жүру дағдысы! Бұқтырылған және сарысуға арналған Пауэр Plus 5000
Dialogue: 0,0:14:43.24,0:14:45.31,Default,,0,0,0,,Hopesong Angel-ге қоңырау шалыңыз!
Dialogue: 0,0:14:45.31,0:14:48.23,Default,,0,0,0,,Теңген Альтомильдік дағдыларды жеңу!
Dialogue: 0,0:14:48.23,0:14:51.03,Default,,0,0,0,,Алдыңғы қатардағы блок үшін Пауэр Plus 6000
Dialogue: 0,0:14:53.15,0:14:57.35,Default,,0,0,0,,Мен болашақты көре аламын. Мен көріп тұрғандай➡
Dialogue: 0,0:14:57.35,0:15:00.14,Default,,0,0,0,,Дүние айналады... Шабуыл!
Dialogue: 0,0:15:00.14,0:15:02.14,Default,,0,0,0,,ｶﾞｰﾄﾞ
Dialogue: 0,0:15:02.14,0:15:06.85,Default,,0,0,0,,Алайда бұл дүниедегі барлық құбылыстарда ауытқулар болады.
Dialogue: 0,0:15:06.85,0:15:10.73,Default,,0,0,0,,Мен көретін болашақ ерекшелік емес.
Dialogue: 0,0:15:10.73,0:15:13.85,Default,,0,0,0,,Теңген супер альтомильімен шабуыл жасаңыз!
Dialogue: 0,0:15:13.85,0:15:17.47,Default,,0,0,0,,Дағдыны белсендіру. Escort Eagle шақырыңыз!
Dialogue: 0,0:15:17.47,0:15:19.86,Default,,0,0,0,,ﾊﾟﾜｰﾌﾟﾗｽ5000
Dialogue: 0,0:15:19.86,0:15:22.16,Default,,0,0,0,,Аа!!
Dialogue: 0,0:15:22.16,0:15:26.30,Default,,0,0,0,,Толық күзет. Үштік жетек
Dialogue: 0,0:15:26.30,0:15:29.04,Default,,0,0,0,,ｹﾞｯﾄ ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ！
Dialogue: 0,0:15:29.04,0:15:31.81,Default,,0,0,0,,Барлық әсерлер оң жақ эскортта
Dialogue: 0,0:15:31.81,0:15:34.49,Default,,0,0,0,,ｾｶﾝﾄﾞﾁｪｯｸ！ ｻｰﾄﾞﾁｪｯｸ！
Dialogue: 0,0:15:34.49,0:15:39.20,Default,,0,0,0,,Критикалық триггер! Барлық әсерлер сол жақ эскортқа өтеді
Dialogue: 0,0:15:39.20,0:15:42.07,Default,,0,0,0,,ｱﾀｯｸ！
Dialogue: 0,0:15:42.07,0:15:46.69,Default,,0,0,0,,Сіз көрген болашақты шындыққа айналдыру қуанышы... және ➡
Dialogue: 0,0:15:46.69,0:15:50.52,Default,,0,0,0,,Тербелістер арқылы болашақты ашудың қуанышы...
Dialogue: 0,0:15:50.52,0:15:53.14,Default,,0,0,0,,Әлі жоқ! Бар!
Dialogue: 0,0:15:53.14,0:15:58.35,Default,,0,0,0,,Жүрегімді қатты қоздыратын екі қарама-қайшы ләззат.
Dialogue: 0,0:15:58.35,0:16:03.50,Default,,0,0,0,,Сіз бұл екі қарама-қайшы нәрсе мен үшін бәрі деп айта аласыз.
Dialogue: 0,0:16:03.50,0:16:06.89,Default,,0,0,0,,ｼﾞｪﾈﾚｰｼｮﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:16:06.89,0:16:11.83,Default,,0,0,0,,Ал менің қарама-қайшы екі қуанышымды бейнелейтін болмыс.
Dialogue: 0,0:16:11.83,0:16:14.63,Default,,0,0,0,,Бұл сенсің, Киба Шион!
Dialogue: 0,0:16:16.87,0:16:19.65,Default,,0,0,0,,Тіпті бір зиян да берілмейді...
Dialogue: 0,0:16:19.65,0:16:22.01,Default,,0,0,0,,Авангард аудандық турнирі
Dialogue: 0,0:16:22.01,0:16:26.33,Default,,0,0,0,,Менен қанаты сынған сен мен ойлағанымды істе➡
Dialogue: 0,0:16:26.33,0:16:28.68,Default,,0,0,0,,Сәтсіздікті жеңді
Dialogue: 0,0:16:28.68,0:16:34.48,Default,,0,0,0,,Ал Юна-сан тармағының шайқасы мен ойлаған болашақты жойды➡
Dialogue: 0,0:16:34.48,0:16:38.48,Default,,0,0,0,,Менен жеңдіңіз, қанат қаққаныңыз.
Dialogue: 0,0:16:40.49,0:16:43.49,Default,,0,0,0,,Дірілдедім, жүрегім дүрсілдеп
Dialogue: 0,0:16:45.83,0:16:47.81,Default,,0,0,0,,Барлық эмоциялардан асып түсу➡
Dialogue: 0,0:16:47.81,0:16:51.97,Default,,0,0,0,,Бұл денені тек қарама-қайшы ләззат биледі.
Dialogue: 0,0:16:51.97,0:16:57.51,Default,,0,0,0,,Талай қиындықты жеңіп, мен ойлаған болашаққа қадам басасың.
Dialogue: 0,0:16:57.51,0:17:02.18,Default,,0,0,0,,Ал мен тербелістер туғызып, сызған болашақты ашамын
Dialogue: 0,0:17:02.18,0:17:07.67,Default,,0,0,0,,Мені Миоджин Льюестің идеалды әлемі қызықтырмайды!
Dialogue: 0,0:17:07.67,0:17:12.52,Default,,0,0,0,,Ах... Мен тек ләззат алғым келеді.
Dialogue: 0,0:17:12.52,0:17:15.91,Default,,0,0,0,,Кел, Шион!
Dialogue: 0,0:17:15.91,0:17:18.83,Default,,0,0,0,,Әлемнің болашағына әсер ететін бұл күресте➡
Dialogue: 0,0:17:18.83,0:17:22.43,Default,,0,0,0,,Маған ләззаттың ең жоғарғы деңгейін беріңіз!
Dialogue: 0,0:17:25.37,0:17:28.86,Default,,0,0,0,,Оян, болашақты жейтін құдайлық аң.
Dialogue: 0,0:17:28.86,0:17:31.42,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ
Dialogue: 0,0:17:31.42,0:17:34.51,Default,,0,0,0,,Жұмақ пен Тозақ Божественный хайуан Фенрир
Dialogue: 0,0:17:34.51,0:17:37.80,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｽｷﾙ｡ ｿｳﾙﾁｬｰｼﾞ
Dialogue: 0,0:17:37.80,0:17:40.97,Default,,0,0,0,,Kotonoha Skill Пауэр Plus 3000
Dialogue: 0,0:17:40.97,0:17:44.35,Default,,0,0,0,,Жұмақ пен Тозақтың тұрақты шеберлігінің арқасында Fenrir құдайлық аңы➡
Dialogue: 0,0:17:44.35,0:17:47.06,Default,,0,0,0,,Тыл сақшысының ашылған әсері➡
Dialogue: 0,0:17:47.06,0:17:50.56,Default,,0,0,0,,Палубаның жоғарғы жағындағы екі картаны қайда қою керектігін шешу үшін өзгертілді
Dialogue: 0,0:17:52.71,0:17:55.32,Default,,0,0,0,,Жұмақ пен Тозақтың дағдылары Құдайдың аңы Фенрир
Dialogue: 0,0:17:55.32,0:17:58.15,Default,,0,0,0,,Soul Blast 1 карта ұтысы
Dialogue: 0,0:17:58.15,0:18:01.22,Default,,0,0,0,,Хэттидің Пауэр Plus 3000 шеберлігі
Dialogue: 0,0:18:01.22,0:18:05.34,Default,,0,0,0,,Фенрирдің құдайлық аңы берген қабілетінің арқасында➡
Dialogue: 0,0:18:05.34,0:18:07.36,Default,,0,0,0,,Хэттиге қоңырау шалыңыз
Dialogue: 0,0:18:07.36,0:18:11.01,Default,,0,0,0,,Тағы да жұмақ пен тозақ Құдайдың аңы Фенрирдің шеберлігі
Dialogue: 0,0:18:11.01,0:18:13.82,Default,,0,0,0,,Soul Blast 1 карта ұтысы
Dialogue: 0,0:18:13.82,0:18:18.20,Default,,0,0,0,,Екі Hatties Пауэр плюс 3000 дағдыларын белсендіру
Dialogue: 0,0:18:18.20,0:18:20.26,Default,,0,0,0,,Гельга дағдылары
Dialogue: 0,0:18:20.26,0:18:23.48,Default,,0,0,0,,Котонохаға қуат плюс 3000. Жан заряды
Dialogue: 0,0:18:23.48,0:18:26.86,Default,,0,0,0,,Жұмақ пен Тозаққа қуат плюс 3000 құдайдың құбыжық Фенрир
Dialogue: 0,0:18:26.86,0:18:30.50,Default,,0,0,0,,Kotonoha Skill Пауэр Plus 2000
Dialogue: 0,0:18:30.50,0:18:33.80,Default,,0,0,0,,Және аян арқылы болашаққа бағыт-бағдар бер
Dialogue: 0,0:18:33.80,0:18:35.81,Default,,0,0,0,,Суваваға қоңырау шалыңыз
Dialogue: 0,0:18:35.81,0:18:37.84,Default,,0,0,0,,Аян
Dialogue: 0,0:18:37.84,0:18:41.76,Default,,0,0,0,,Жанға бір карта сал. Бір картаны палубаның үстіне қойыңыз.
Dialogue: 0,0:18:41.76,0:18:44.65,Default,,0,0,0,,Kotonoha's Skill Пауэр Plus 2000
Dialogue: 0,0:18:44.65,0:18:47.68,Default,,0,0,0,,Гельга Аянға қоңырау шалыңыз
Dialogue: 0,0:18:47.68,0:18:52.64,Default,,0,0,0,,Жанға бір карта сал. Бір картаны палубаның үстіне қойыңыз.
Dialogue: 0,0:18:52.64,0:18:55.53,Default,,0,0,0,,Kotonoha's Skill Пауэр Plus 2000
Dialogue: 0,0:18:55.53,0:18:59.15,Default,,0,0,0,,Свава шеберлігі Пауэр Plus 5000
Dialogue: 0,0:18:59.15,0:19:03.57,Default,,0,0,0,,Екі Hatties Пауэр плюс 3000 дағдыларын белсендіру
Dialogue: 0,0:19:03.57,0:19:05.85,Default,,0,0,0,,Бұл сынақты жеңіңіз➡
Dialogue: 0,0:19:05.85,0:19:09.54,Default,,0,0,0,,Алға, мен ойлаған болашақты көрсетші, Шион.
Dialogue: 0,0:19:09.54,0:19:13.84,Default,,0,0,0,,Авангардқа Көктегі Тозақ құдайы құбыжық Фенрирмен шабуыл жасаңыз
Dialogue: 0,0:19:18.21,0:19:21.31,Default,,0,0,0,,Шион Норгард не болды?
Dialogue: 0,0:19:23.34,0:19:27.49,Default,,0,0,0,,Маған сіздің түсу аймағыңыз бен жан картаңызды тексеруге рұқсат етіңіз.
Dialogue: 0,0:19:27.49,0:19:29.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:32.20,0:19:34.56,Default,,0,0,0,,Аа... өтінемін
Dialogue: 0,0:19:34.56,0:19:50.86,Default,,0,0,0,,♪♪～
Dialogue: 0,0:19:50.86,0:19:56.19,Default,,0,0,0,,《Қалған триггерлер 1 сыни немесе стенд және 1 сауықтыру➡
Dialogue: 0,0:19:56.19,0:19:59.19,Default,,0,0,0,,Авангард бірінші шабуыл жасады➡
Dialogue: 0,0:19:59.19,0:20:01.32,Default,,0,0,0,,Тірек триггері жоқ
Dialogue: 0,0:20:01.32,0:20:05.03,Default,,0,0,0,,Егер сіз сыни балл алмасаңыз, оны Норгаард ➡ арқылы алуға болады
Dialogue: 0,0:20:05.03,0:20:08.13,Default,,0,0,0,,Қалған екі шабуылға төтеп бере алады
Dialogue: 0,0:20:08.13,0:20:13.69,Default,,0,0,0,,Палубада 9 карта қалды, ал критикалық баға алу ықтималдығы шамамен 40% құрайды.
Dialogue: 0,0:20:13.69,0:20:19.18,Default,,0,0,0,,Бұл палубаны Shinonome екі ашуда басқарды...》
Dialogue: 0,0:20:19.18,0:20:24.03,Default,,0,0,0,,♪♪～
Dialogue: 0,0:20:24.03,0:20:26.40,Default,,0,0,0,,Күзетші жоқ!
Dialogue: 0,0:20:26.40,0:20:28.63,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ
Dialogue: 0,0:20:28.63,0:20:31.55,Default,,0,0,0,,《Болашақты қанша манипуляцияласаң да➡
Dialogue: 0,0:20:31.55,0:20:33.86,Default,,0,0,0,,Менің болашағым менікі! 》
Dialogue: 0,0:20:33.86,0:20:36.99,Default,,0,0,0,,Бірінші тексеру. Бұл Нотригер.
Dialogue: 0,0:20:36.99,0:20:39.70,Default,,0,0,0,,《Сын салуға болмайды.
Dialogue: 0,0:20:39.70,0:20:41.65,Default,,0,0,0,,Жоқ, мен оны тартуға рұқсат бермеймін.
Dialogue: 0,0:20:41.65,0:20:44.73,Default,,0,0,0,,ｾｶﾝﾄﾞﾁｪｯｸ
Dialogue: 0,0:20:44.73,0:20:47.03,Default,,0,0,0,,ﾉｰﾄﾘｶﾞｰ
Dialogue: 0,0:20:49.47,0:20:51.51,Default,,0,0,0,,ｻｰﾄﾞﾁｪｯｸ
Dialogue: 0,0:20:51.51,0:20:59.18,Default,,0,0,0,,♪♪～
Dialogue: 0,0:20:59.18,0:21:02.09,Default,,0,0,0,,ﾉｰﾄﾘｶﾞｰ
Dialogue: 0,0:21:02.09,0:21:03.97,Default,,0,0,0,,ﾀﾞﾒｰｼﾞﾁｪｯｸ！
Dialogue: 0,0:21:03.97,0:21:06.51,Default,,0,0,0,,ｹﾞｯﾄ ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ
Dialogue: 0,0:21:06.51,0:21:10.51,Default,,0,0,0,,Альт миль үшін қуат плюс 5000
Dialogue: 0,0:21:10.51,0:21:14.15,Default,,0,0,0,,Зиян 5 Сот әлі аяқталған жоқ
Dialogue: 0,0:21:14.15,0:21:16.17,Default,,0,0,0,,Ауыстыру арқылы шабуыл!
Dialogue: 0,0:21:16.17,0:21:18.13,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:21:18.13,0:21:20.14,Default,,0,0,0,,Котонохаға шабуыл жасаңыз!
Dialogue: 0,0:21:20.14,0:21:22.87,Default,,0,0,0,,ｲﾝﾀｰｾﾌﾟﾄ ﾌﾞﾚｲﾌﾞ ｼｰﾙﾄﾞﾌﾟﾗｽ5000
Dialogue: 0,0:21:22.87,0:21:24.84,Default,,0,0,0,,ﾀｰﾝｴﾝﾄﾞ
Dialogue: 0,0:21:24.84,0:21:28.44,Default,,0,0,0,,Керемет, сіз бұл сынақты жақсы жеңдіңіз.
Dialogue: 0,0:21:32.93,0:21:35.23,Default,,0,0,0,,Мен сені аяймын
Dialogue: 0,0:21:37.15,0:21:39.19,Default,,0,0,0,,Болашақты көре алатын кезде➡
Dialogue: 0,0:21:39.19,0:21:41.19,Default,,0,0,0,,Барлығына жоғарыдан қарау➡
Dialogue: 0,0:21:41.19,0:21:43.84,Default,,0,0,0,,Сіз оны көре аламын деп ойлайсыз➡
Dialogue: 0,0:21:43.84,0:21:48.25,Default,,0,0,0,,Мен әр нәрсеге бақылаушымын.
Dialogue: 0,0:21:48.25,0:21:51.85,Default,,0,0,0,,Осы уақытқа дейін көрген қуаныш пен азап➡
Dialogue: 0,0:21:51.85,0:21:55.19,Default,,0,0,0,,Үмітсіздік, эмоция және құмарлық➡
Dialogue: 0,0:21:55.19,0:22:01.31,Default,,0,0,0,,Сіз оны өзіңіз ұстамайсыз
Dialogue: 0,0:22:01.31,0:22:03.90,Default,,0,0,0,,Басқалардың өмірін манипуляциялай алсаңыз да➡
Dialogue: 0,0:22:03.90,0:22:06.70,Default,,0,0,0,,Сіз өз өміріңізбен өмір сүре алмайсыз
Dialogue: 0,0:22:08.80,0:22:11.67,Default,,0,0,0,,Маған берілген болашақ маған керек емес
Dialogue: 0,0:22:11.67,0:22:16.58,Default,,0,0,0,,Қажет болса, өз еркіңізбен, күшіңізбен ұстаңыз!
Dialogue: 0,0:22:16.58,0:22:19.08,Default,,0,0,0,,Бұл Киба Шион!
Dialogue: 0,0:22:21.36,0:22:23.33,Default,,0,0,0,,Не...
Dialogue: 0,0:22:23.33,0:22:36.33,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:41.18,0:22:45.81,Default,,0,0,0,,Әділ, нұрыңмен бәрін жең!
Dialogue: 0,0:22:45.81,0:22:48.74,Default,,0,0,0,,ｽﾄﾗｲﾄﾞ･ｻﾞ･ｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:22:48.74,0:22:51.84,Default,,0,0,0,,Жарқыраған қылыш Фидес!
Dialogue: 0,0:22:54.68,0:22:59.67,Default,,0,0,0,,Мен сезінемін...Мен бұл берілген болашақтан бас тартамын➡
Dialogue: 0,0:22:59.67,0:23:02.87,Default,,0,0,0,,Әркімнің өз еркі
Dialogue: 0,0:23:02.87,0:23:04.82,Default,,0,0,0,,Әркімнің еркін жүзеге асыру
Dialogue: 0,0:23:04.82,0:23:06.84,Default,,0,0,0,,Міне!
Dialogue: 0,0:23:06.84,0:23:11.01,Default,,0,0,0,,Жарқыраған қылыш Фидес!
Dialogue: 0,0:23:11.01,0:23:13.02,Default,,0,0,0,,Шеберлік белсендіріледі!
Dialogue: 0,0:23:13.02,0:23:15.03,Default,,0,0,0,,Сүлейменді шақыр!
Dialogue: 0,0:23:15.03,0:23:18.30,Default,,0,0,0,,1 картаны салыңыз және Фулгенийді шақырыңыз!
Dialogue: 0,0:23:18.30,0:23:20.86,Default,,0,0,0,,Жарқыраған қылышпен шабуыл жасаңыз Фидес!
Dialogue: 0,0:23:20.86,0:23:24.83,Default,,0,0,0,,Батыл! Қарсыласыңыздың артқы қорғаушыларының бірін шегіндіріңіз!
Dialogue: 0,0:23:24.83,0:23:27.83,Default,,0,0,0,,Фульгениус пен Сүлейманға қуат плюс 5000
Dialogue: 0,0:23:31.53,0:23:33.47,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ
Dialogue: 0,0:23:33.47,0:23:35.47,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ！
Dialogue: 0,0:23:35.47,0:23:37.52,Default,,0,0,0,,Бұл Нотриггер
Dialogue: 0,0:23:37.52,0:23:39.49,Default,,0,0,0,,ｾｶﾝﾄﾞﾁｪｯｸ！
Dialogue: 0,0:23:39.49,0:23:42.56,Default,,0,0,0,,ﾉｰﾄﾘｶﾞｰ｡ ｻｰﾄﾞﾁｪｯｸ！
Dialogue: 0,0:23:42.56,0:23:45.70,Default,,0,0,0,,ｹﾞｯﾄ！ ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ！
Dialogue: 0,0:23:45.70,0:23:47.82,Default,,0,0,0,,Қуат – Фульгений➡
Dialogue: 0,0:23:47.82,0:23:50.52,Default,,0,0,0,,Фидес үшін сыни
Dialogue: 0,0:23:50.52,0:23:52.52,Default,,0,0,0,,Біз барамыз!
Dialogue: 0,0:23:52.52,0:23:55.42,Default,,0,0,0,,Өтірікті жарып, жарқын болашаққа қадам бас!
Dialogue: 0,0:23:55.42,0:23:58.03,Default,,0,0,0,,Ал мен оны қолыммен ұстаймын!
Dialogue: 0,0:23:58.03,0:24:02.55,Default,,0,0,0,,Мен қалаған болашақты өз күшіммен жасаңыз!
Dialogue: 0,0:24:02.55,0:24:10.87,Default,,0,0,0,,♪♪～
Dialogue: 0,0:24:10.87,0:24:12.84,Default,,0,0,0,,ｾ･ﾌｨﾆ
Dialogue: 0,0:24:12.84,0:24:14.94,Default,,0,0,0,,Жеңіс біздің қылышымызда
Dialogue: 0,0:24:17.36,0:24:20.90,Default,,0,0,0,,Мен бұл тот басқан семсерді ешқашан күтпедім ...
Dialogue: 0,0:24:20.90,0:24:23.02,Default,,0,0,0,,ﾌﾌﾌｯ
Dialogue: 0,0:24:23.02,0:24:25.04,Default,,0,0,0,,Керемет, Шион.
Dialogue: 0,0:24:25.04,0:24:27.31,Default,,0,0,0,,Ең жақсы ауытқу!
Dialogue: 0,0:24:27.31,0:24:29.64,Default,,0,0,0,,Сіз нағыз батырсыз.
Dialogue: 0,0:24:29.64,0:24:33.51,Default,,0,0,0,,Балалық өмірден қашып, саяхатқа шығыңыз➡
Dialogue: 0,0:24:33.51,0:24:38.42,Default,,0,0,0,,Әдет-ғұрыптан өткеннен кейін ол өзінің бастапқы әлеміне оралды.
Dialogue: 0,0:24:38.42,0:24:40.64,Default,,0,0,0,,Және бұл ➡
Dialogue: 0,0:24:40.64,0:24:43.41,Default,,0,0,0,,Мен көрген болашақ сияқты
Dialogue: 0,0:24:43.41,0:24:49.51,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:24:57.90,0:24:59.90,Default,,0,0,0,,Уф...
Dialogue: 0,0:25:11.52,0:25:13.57,Default,,0,0,0,,Сіз көмектестіңіз бе...
Dialogue: 0,0:25:13.57,0:25:15.57,Default,,0,0,0,,барлығы дерлік өлімге ұшырауға жақын қалды, бұл менің кінәм.
Dialogue: 0,0:25:17.97,0:25:19.98,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:25:19.98,0:25:22.51,Default,,0,0,0,,Бұл керемет Шион
Dialogue: 0,0:25:22.51,0:25:24.58,Default,,0,0,0,,Сіз шынайысыз
Dialogue: 0,0:25:24.58,0:25:28.08,Default,,0,0,0,,Бұл ең жақсы, бұл ең жақсы, Шион!
Dialogue: 0,0:25:34.59,0:25:38.89,Default,,0,0,0,,Әй, сен қанша ұйықтайсың? Ерте тұр.
Dialogue: 0,0:25:38.89,0:25:43.19,Default,,0,0,0,,Өтінемін, мені одан да көбірек қуантыңыз.
Dialogue: 0,0:25:58.08,0:26:02.18,Default,,0,0,0,,(құсу дауысы)
Dialogue: 0,0:26:02.18,0:26:04.19,Default,,0,0,0,,(жөтел дауысы)
Dialogue: 0,0:26:04.19,0:26:09.01,Default,,0,0,0,,Ха... ха... Мен өзімді керемет сезінемін➡
Dialogue: 0,0:26:09.01,0:26:11.01,Default,,0,0,0,,Неге...
Dialogue: 0,0:26:11.01,0:26:14.51,Default,,0,0,0,,Шион, сен кінәлісің.
Dialogue: 0,0:26:14.51,0:26:18.18,Default,,0,0,0,,Өйткені сен мәңгі ұйықтап жатырсың...
Dialogue: 0,0:26:18.18,0:26:23.34,Default,,0,0,0,,♪♪～
Dialogue: 0,0:26:23.34,0:26:25.84,Default,,0,0,0,,Тұр, Киба Шион...
Dialogue: 0,0:26:28.76,0:26:31.26,Default,,0,0,0,,Өзі соққыны қабылдауға дайын қарсы шабуыл!
Dialogue: 0,0:30:39.55,0:30:42.21,Default,,0,0,0,,<Tobu Skytree желісіндегі Адачи ауданына
Dialogue: 0,0:30:42.21,0:30:44.20,Default,,0,0,0,,Кантоның үш ұлы шеберінің бірі →
Dialogue: 0,0:30:44.20,0:30:46.24,Default,,0,0,0,,Нишиарай Дайшы жанындағы қалашықта→
Dialogue: 0,0:30:46.24,0:30:48.17,Default,,0,0,0,,Мен барған кезде...
Dialogue: 0,0:30:48.17,0:30:53.24,Default,,0,0,0,,Қалада тұрғын үй кешендері, тұрғын үй кешендері, тұрғын үй кешендері бар.
Dialogue: 0,0:30:53.24,0:30:55.29,Default,,0,0,0,,Керемет
Dialogue: 0,0:30:55.29,0:31:00.70,Default,,0,0,0,,Вокзал алдында да сауда ғимараттары жоқ, тек тұрғын үй кешендері ғана бар.
Dialogue: 0,0:31:00.70,0:31:04.20,Default,,0,0,0,,Бұл қандай қала? ＞
Dialogue: 0,0:31:05.70,0:31:11.70,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory