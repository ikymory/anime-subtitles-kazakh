Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:03.39,0:01:26.26,Default,,0,0,0,,♪♪～
Dialogue: 0,0:01:26.26,0:01:28.56,Default,,0,0,0,,((Chrono: Ah...
Dialogue: 0,0:01:34.19,0:01:36.50,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:01:36.50,0:01:39.69,Default,,0,0,0,,Сіз бұл блокпен не істеуді жоспарлайсыз?
Dialogue: 0,0:01:39.69,0:01:42.61,Default,,0,0,0,,Тоқта! Тірі!!
Dialogue: 0,0:01:42.61,0:01:48.55,Default,,0,0,0,,♪♪～
Dialogue: 0,0:01:48.55,0:01:52.69,Default,,0,0,0,,Неге... неге маған опасыздық жасайсың!?
Dialogue: 0,0:01:52.69,0:01:55.67,Default,,0,0,0,,Тікелей күтіңіз! Тірі!!
Dialogue: 0,0:01:55.67,0:02:01.03,Default,,0,0,0,,♪♪～
Dialogue: 0,0:02:01.03,0:02:03.55,Default,,0,0,0,,Менің... кінәм бар ма?
Dialogue: 0,0:02:03.55,0:02:08.45,Default,,0,0,0,,Оны ұмыт, Куроно. Мұнда ештеңе болған жоқ.
Dialogue: 0,0:02:08.45,0:02:13.34,Default,,0,0,0,,Себебі мен... ол қызды шақырдым...
Dialogue: 0,0:02:13.34,0:02:17.78,Default,,0,0,0,,Сен ештеңе істеген жоқсың, ұмыт.
Dialogue: 0,0:02:17.78,0:02:21.78,Default,,0,0,0,,Бірлік пен Авангард туралы бәрі...))
Dialogue: 0,0:02:23.93,0:02:26.43,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:36.26,0:02:38.26,Default,,0,0,0,,Уф!
Dialogue: 0,0:02:47.17,0:02:50.38,Default,,0,0,0,,((ﾊｧ… ﾊｧ…
Dialogue: 0,0:02:50.38,0:02:53.55,Default,,0,0,0,,Микл де білген... Барлығы білетін➡
Dialogue: 0,0:02:53.55,0:02:56.35,Default,,0,0,0,,Сен оны менен жасырдың! ))
Dialogue: 0,0:03:06.39,0:03:08.78,Default,,0,0,0,,Сіз әлі ояндыңыз ба?
Dialogue: 0,0:03:11.70,0:03:16.70,Default,,0,0,0,,Ұзақ ұйықтау мені мазалайды...
Dialogue: 0,0:06:30.45,0:06:34.70,Default,,0,0,0,,Бұл да кеңейту қауымдастығының қызметінің бірі болып табылады.
Dialogue: 0,0:06:34.70,0:06:38.19,Default,,0,0,0,,Түрлі себептермен үйіне қайта алмайтын балалар➡
Dialogue: 0,0:06:38.19,0:06:41.16,Default,,0,0,0,,Қорғалған
Dialogue: 0,0:06:41.16,0:06:46.16,Default,,0,0,0,,Балаларымыздың болашағын қорғау менің міндетім.
Dialogue: 0,0:06:48.35,0:06:52.19,Default,,0,0,0,,Сіз одан толық бас тартқан сияқтысыз. Сіз одан бас тарттыңыз ба?
Dialogue: 0,0:06:52.19,0:06:55.67,Default,,0,0,0,,Сізден кейінгі бақылау.
Dialogue: 0,0:06:55.67,0:06:59.89,Default,,0,0,0,,Кодзи Ибуки үшін сен оның жалғыз қаруысың.
Dialogue: 0,0:06:59.89,0:07:04.33,Default,,0,0,0,,Әлгі жігіт... Жасы онша емес.
Dialogue: 0,0:07:04.33,0:07:09.13,Default,,0,0,0,,Сіз Ибукиге барған соң менімен кездестіңіз бе?
Dialogue: 0,0:07:12.01,0:07:15.11,Default,,0,0,0,,Сіз көп нәрсені білесіз, солай емес пе?
Dialogue: 0,0:07:15.11,0:07:18.71,Default,,0,0,0,,Мен де сені қалаймын
Dialogue: 0,0:07:20.75,0:07:26.55,Default,,0,0,0,,Сен менің жалғыз досым болған адамның баласысың.
Dialogue: 0,0:07:29.06,0:07:33.49,Default,,0,0,0,,Мен сенімен шынайы болашақты түсінгім келеді.
Dialogue: 0,0:07:33.49,0:07:37.79,Default,,0,0,0,,Авангард шынымен әлемді өзгертеді.
Dialogue: 0,0:07:45.57,0:07:49.86,Default,,0,0,0,,Синдо Куроно қайда? [TEL] Кешіріңіз...
Dialogue: 0,0:07:49.86,0:07:52.06,Default,,0,0,0,,Мен… (Дамиан) Хм. Тек балалар ойыны ғой.
Dialogue: 0,0:07:52.06,0:07:55.45,Default,,0,0,0,,Оны кез келген шығынмен табыңыз
Dialogue: 0,0:07:55.45,0:07:59.55,Default,,0,0,0,,Шынымды айтсам, мен әлі де Амбли Барбомын! Бұл дұрыс
Dialogue: 0,0:07:59.55,0:08:05.23,Default,,0,0,0,,Құрметті төраға Миджиннің өзі қастандық жасады деп ешқашан ойламаппын...
Dialogue: 0,0:08:05.23,0:08:08.40,Default,,0,0,0,,Бірақ сіз берілген деректерді тексергеніңізше➡
Dialogue: 0,0:08:08.40,0:08:10.53,Default,,0,0,0,,Мен мойындауым керек
Dialogue: 0,0:08:10.53,0:08:14.40,Default,,0,0,0,,Бұтағымның сүйкімді балаларын таптайтындар ғана➡
Dialogue: 0,0:08:14.40,0:08:16.70,Default,,0,0,0,,Мен сені ешқашан кешірмеймін!
Dialogue: 0,0:08:16.70,0:08:20.39,Default,,0,0,0,,Филиал басшысы Юна Сан деген кім? (Тетсу) Осы мәселеге қатысты тергеуде➡
Dialogue: 0,0:08:20.39,0:08:25.85,Default,,0,0,0,,Мен шетелде жүрмін. Мен бүгін сіздің өкіл ретінде әрекет етемін.
Dialogue: 0,0:08:25.85,0:08:28.38,Default,,0,0,0,,Даркзон бөлімшесінің басшысы кім?
Dialogue: 0,0:08:28.38,0:08:31.92,Default,,0,0,0,,Оның қайда екені әлі белгісіз.
Dialogue: 0,0:08:31.92,0:08:33.95,Default,,0,0,0,,Мен… (Дамиан) Хм. Тек балалар ойыны ғой.
Dialogue: 0,0:08:33.95,0:08:39.43,Default,,0,0,0,,Біз филиалдың кезектен тыс жиналысын өткіземіз.
Dialogue: 0,0:08:39.43,0:08:44.43,Default,,0,0,0,,Авангардқа шабуыл жасаңыз! (Қай) Күзет! Кесу
Dialogue: 0,0:08:46.53,0:08:49.95,Default,,0,0,0,,Токоха-чан? Бұл кезек және аяқталу.
Dialogue: 0,0:08:49.95,0:08:52.02,Default,,0,0,0,,Ах, кешіріңіз...
Dialogue: 0,0:08:52.02,0:08:54.12,Default,,0,0,0,,ｽﾀﾝﾄﾞ ｱﾝﾄﾞ ﾄﾞﾛｰ
Dialogue: 0,0:08:57.06,0:08:59.15,Default,,0,0,0,,Фойеде➡ (есіктің ашылған дыбысы)
Dialogue: 0,0:08:59.15,0:09:02.25,Default,,0,0,0,,Даркзон бөлімшесінің басшысы Эниши мырза жоғалып кетті!
Dialogue: 0,0:09:07.40,0:09:11.69,Default,,0,0,0,,Шынайы болашақ қандай?
Dialogue: 0,0:09:11.69,0:09:15.58,Default,,0,0,0,,Ақыр соңында, сіздің мақсатыңыз қандай?
Dialogue: 0,0:09:15.58,0:09:19.87,Default,,0,0,0,,Қадам - ​​бұл Авангардтың болашақ мүмкіндіктерін түсінетін адам.
Dialogue: 0,0:09:19.87,0:09:24.05,Default,,0,0,0,,Менің істегісі келетін нәрсем де солай.
Dialogue: 0,0:09:24.05,0:09:27.51,Default,,0,0,0,,Бұл дүниедегі көптеген мүмкіндіктердің ішінен➡
Dialogue: 0,0:09:27.51,0:09:32.40,Default,,0,0,0,,Ең жақсысын түсініп, оны жүзеге асыр
Dialogue: 0,0:09:32.40,0:09:38.19,Default,,0,0,0,,Неліктен ата-бабаларымыз теңізді тастап, құрлыққа бет алды?
Dialogue: 0,0:09:38.19,0:09:41.89,Default,,0,0,0,,Дем ала алмайтын сол дүниенің арғы жағында ➡
Dialogue: 0,0:09:41.89,0:09:45.88,Default,,0,0,0,,Біз не таптық?
Dialogue: 0,0:09:45.88,0:09:49.90,Default,,0,0,0,,Қазіргі әлем олар армандаған шекарадан➡
Dialogue: 0,0:09:49.90,0:09:54.43,Default,,0,0,0,,Біз тым алыс кеттік деп ойламайсыз ба?
Dialogue: 0,0:09:54.43,0:10:00.69,Default,,0,0,0,,Коудзи Ибуки, Мамору Анджо... және филиал жетекшілері
Dialogue: 0,0:10:00.69,0:10:04.13,Default,,0,0,0,,Енді бірігіп қорытынды шығарамыз.
Dialogue: 0,0:10:04.13,0:10:07.90,Default,,0,0,0,,Бұл Даркзон филиалының басшысы Эниши мырза!
Dialogue: 0,0:10:07.90,0:10:11.80,Default,,0,0,0,,Мүмкін біз де сыртқа шығуымыз керек...
Dialogue: 0,0:10:11.80,0:10:17.91,Default,,0,0,0,,Сіз промоушн қауымдастығының мүшесі болсаңыз да, оған қарсы шыққаныңыз қаншалықты ақымақтық➡
Dialogue: 0,0:10:17.91,0:10:21.20,Default,,0,0,0,,Естеріңізге сала кетейін
Dialogue: 0,0:10:21.20,0:10:24.57,Default,,0,0,0,,Тарату қауымдастығына қарсы шығасыз ба?
Dialogue: 0,0:10:24.57,0:10:30.74,Default,,0,0,0,,Авангардтың қызықтарын тарату... Қайсысы сол философияға қарсы шықты?
Dialogue: 0,0:10:30.74,0:10:33.56,Default,,0,0,0,,Анжо…｡ Бұл үкім➡
Dialogue: 0,0:10:33.56,0:10:37.44,Default,,0,0,0,,Мен оны алуға рұқсат етіңіз.
Dialogue: 0,0:10:37.44,0:10:40.55,Default,,0,0,0,,Олардың үкіміне дейін➡
Dialogue: 0,0:10:40.55,0:10:43.65,Default,,0,0,0,,Бүгінгі жекпе-жек маған қалдырылады.
Dialogue: 0,0:10:46.39,0:10:48.56,Default,,0,0,0,,Сіз оның басталғанын көре аласыз.
Dialogue: 0,0:10:48.56,0:10:51.36,Default,,0,0,0,,ｽﾀﾝﾄﾞｱｯﾌﾟ ｳﾞｧﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:12:33.69,0:12:35.71,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:12:35.71,0:12:37.88,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:12:37.88,0:12:40.38,Default,,0,0,0,,Шенрон Найт Мустафа!
Dialogue: 0,0:12:40.38,0:12:43.77,Default,,0,0,0,,Қадамдық дағдылар Ордонанттарды шегіндіріңіз!
Dialogue: 0,0:12:43.77,0:12:46.36,Default,,0,0,0,,Ал қоңырау шалыңыз!
Dialogue: 0,0:12:46.36,0:12:48.34,Default,,0,0,0,,Мұстафердің шеберлігі іске қосылды!
Dialogue: 0,0:12:48.34,0:12:50.56,Default,,0,0,0,,Сары болт шегінеді!
Dialogue: 0,0:12:50.56,0:12:53.06,Default,,0,0,0,,Мұстафамен бірге Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:12:53.06,0:12:55.85,Default,,0,0,0,,Айдаһар рыцарь Надельдің шеберлігі іске қосылды!
Dialogue: 0,0:12:55.85,0:13:00.07,Default,,0,0,0,,Мустаферді жалын күйіне айналдырыңыз және қарсы зарядтаңыз!
Dialogue: 0,0:13:00.07,0:13:03.72,Default,,0,0,0,,《Ибуки: шабуыл кезінде қарсыласқа қарағанда артқы күзетшілер көп болса іске қосылады➡
Dialogue: 0,0:13:03.72,0:13:05.71,Default,,0,0,0,,Кагерудың оты
Dialogue: 0,0:13:05.71,0:13:10.73,Default,,0,0,0,,Оны шегіну дағдысымен біріктіре отырып, Анджо жағдай жасады.
Dialogue: 0,0:13:10.73,0:13:12.68,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ
Dialogue: 0,0:13:12.68,0:13:15.02,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ！
Dialogue: 0,0:13:15.02,0:13:17.22,Default,,0,0,0,,ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ！
Dialogue: 0,0:13:17.22,0:13:21.61,Default,,0,0,0,,Мұстафаға сын, Ымыртқа күш!
Dialogue: 0,0:13:21.61,0:13:24.01,Default,,0,0,0,,Цзянси-кун!
Dialogue: 0,0:13:24.01,0:13:26.68,Default,,0,0,0,,Промоутер Ассоциациясында жұмыс істеген кезде➡
Dialogue: 0,0:13:26.68,0:13:30.18,Default,,0,0,0,,Неліктен Миджинге қосылдың!?
Dialogue: 0,0:13:30.18,0:13:33.52,Default,,0,0,0,,Біздің жұмысымыз Vanguard➡ арқылы
Dialogue: 0,0:13:33.52,0:13:35.82,Default,,0,0,0,,Барлығының күлкісін қорғаңыз!
Dialogue: 0,0:13:39.41,0:13:41.51,Default,,0,0,0,,ｶﾞｰﾄﾞ
Dialogue: 0,0:13:41.51,0:13:44.87,Default,,0,0,0,,Қараңғыны же, қараңғылықты биле
Dialogue: 0,0:13:44.87,0:13:47.70,Default,,0,0,0,,Әлемді түсіну үшін
Dialogue: 0,0:13:47.70,0:13:50.02,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ
Dialogue: 0,0:13:50.02,0:13:53.41,Default,,0,0,0,,Жын Эрихтің маскасы
Dialogue: 0,0:13:53.41,0:13:57.51,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｽｷﾙ ｺｰﾙ ｽｺｰﾙﾒｲｶｰ➡
Dialogue: 0,0:13:57.51,0:14:01.05,Default,,0,0,0,,Doppel Vampire Wampting Succubus
Dialogue: 0,0:14:01.05,0:14:03.27,Default,,0,0,0,,Дағдыны белсендіру
Dialogue: 0,0:14:03.27,0:14:05.37,Default,,0,0,0,,ｿｳﾙﾁｬｰｼﾞ
Dialogue: 0,0:14:09.37,0:14:12.34,Default,,0,0,0,,Бұл қараңғы діннің әдеттегі жолы.
Dialogue: 0,0:14:12.34,0:14:15.55,Default,,0,0,0,,11 дана
Dialogue: 0,0:14:15.55,0:14:19.18,Default,,0,0,0,,Миджин мырзаның философиясы Промоутер Ассоциациясын құрған кезден бері бар➡
Dialogue: 0,0:14:19.18,0:14:21.38,Default,,0,0,0,,Ештеңе өзгерген жоқ
Dialogue: 0,0:14:21.38,0:14:26.04,Default,,0,0,0,,Авангардтың күшімен бүкіл әлемге бақыт таратыңыз
Dialogue: 0,0:14:26.04,0:14:30.18,Default,,0,0,0,,Мен де басқа ештеңе жоқ деп ойладым.
Dialogue: 0,0:14:30.18,0:14:35.60,Default,,0,0,0,,Бұл мөлдір дүниенің болашағына қалай дұрыс нұр шашуға болады!
Dialogue: 0,0:14:35.60,0:14:38.94,Default,,0,0,0,,Дағдыны белсендіру Жан заряды
Dialogue: 0,0:14:38.94,0:14:41.44,Default,,0,0,0,,Және Пауэр Plus 5000!
Dialogue: 0,0:14:45.09,0:14:47.09,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:51.18,0:14:54.05,Default,,0,0,0,,Бұл дүние тым жетілмеген➡
Dialogue: 0,0:14:54.05,0:14:59.06,Default,,0,0,0,,Қайғылы және азап пен жанжалға толы
Dialogue: 0,0:14:59.06,0:15:06.86,Default,,0,0,0,,Сіз, достарыңыз және мен➡
Dialogue: 0,0:15:06.86,0:15:10.16,Default,,0,0,0,,Ешкім ауырмай өмір сүрмейді.
Dialogue: 0,0:15:13.07,0:15:17.56,Default,,0,0,0,,Біз бәріміз бірдейміз, бірақ қандай да бір себептермен бір бола алмаймыз.
Dialogue: 0,0:15:17.56,0:15:21.75,Default,,0,0,0,,Бұл өте оңай болуы керек.
Dialogue: 0,0:15:21.75,0:15:27.05,Default,,0,0,0,,Мен барлығының күлгенін қалаймын.
Dialogue: 0,0:15:30.50,0:15:33.17,Default,,0,0,0,,Қадам қақпасынан әкелген болашақпен➡
Dialogue: 0,0:15:33.17,0:15:37.58,Default,,0,0,0,,Адамдар жек көрушілікті ерітіп, жанжалды ұмытады➡
Dialogue: 0,0:15:37.58,0:15:40.71,Default,,0,0,0,,Бай ақыл мен жұмсақ диалог арқылы➡
Dialogue: 0,0:15:40.71,0:15:44.02,Default,,0,0,0,,Бәрі шешілетін уақыт келеді
Dialogue: 0,0:15:44.02,0:15:48.22,Default,,0,0,0,,Эричтің жын маскасымен Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:15:48.22,0:15:50.56,Default,,0,0,0,,Қараңғылық іске қосылды!
Dialogue: 0,0:15:50.56,0:15:54.93,Default,,0,0,0,,Осы айналым кезінде жанға карта салынған кезде іске қосылады.
Dialogue: 0,0:15:54.93,0:15:59.73,Default,,0,0,0,,Қараңғылықты жеу және қараңғылықты кию, Қараңғы реттеушілердің мәні
Dialogue: 0,0:16:01.85,0:16:06.01,Default,,0,0,0,,Сонымен қатар, жан заряды енді барлығы 15 дана
Dialogue: 0,0:16:06.01,0:16:09.86,Default,,0,0,0,,Қуат пен жанға 1000
Dialogue: 0,0:16:09.86,0:16:13.73,Default,,0,0,0,,Басқаша айтқанда, қуат плюс 15000!
Dialogue: 0,0:16:13.73,0:16:15.78,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｽｷﾙ
Dialogue: 0,0:16:15.78,0:16:18.28,Default,,0,0,0,,Шегіну үшін бір артқы қорғаушыны таңдаңыз.
Dialogue: 0,0:16:21.72,0:16:24.72,Default,,0,0,0,,Барлығына бейбіт болашақ
Dialogue: 0,0:16:24.72,0:16:29.03,Default,,0,0,0,,Бұл ешкімнің емес, менің тілегім.
Dialogue: 0,0:16:29.03,0:16:31.10,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:16:31.10,0:16:33.10,Default,,0,0,0,,ﾄﾞﾗｲﾌﾞﾁｪｯｸ
Dialogue: 0,0:16:36.05,0:16:39.89,Default,,0,0,0,,Мұны шынымен жасауға бола ма? Мұндай нәрсе
Dialogue: 0,0:16:39.89,0:16:43.43,Default,,0,0,0,,Бейнелердің күші шексіз
Dialogue: 0,0:16:43.43,0:16:46.03,Default,,0,0,0,,Сіз мұны білесіз бе?
Dialogue: 0,0:16:48.21,0:16:51.72,Default,,0,0,0,,Doppel Vampire көмегімен Авангардқа шабуыл жасаңыз
Dialogue: 0,0:16:51.72,0:16:53.72,Default,,0,0,0,,Дағдыны белсендіру
Dialogue: 0,0:16:53.72,0:16:56.56,Default,,0,0,0,,6 немесе одан да көп жандармен қуат плюс 5000!
Dialogue: 0,0:16:56.56,0:16:58.94,Default,,0,0,0,,Және 15 немесе одан да көп жандармен➡
Dialogue: 0,0:16:58.94,0:17:03.21,Default,,0,0,0,,Бұл шабуылды 0 дәрежелі бөлімше қорғай алмайды.
Dialogue: 0,0:17:03.21,0:17:06.20,Default,,0,0,0,,Мен қазір кез келген жала жабуды қабылдаймын.
Dialogue: 0,0:17:06.20,0:17:08.40,Default,,0,0,0,,Жаңа дәуір келгенде➡
Dialogue: 0,0:17:08.40,0:17:11.39,Default,,0,0,0,,Бұл түсінікті.
Dialogue: 0,0:17:11.39,0:17:15.19,Default,,0,0,0,,Болашақтан кел, мені қорға!
Dialogue: 0,0:17:15.19,0:17:17.23,Default,,0,0,0,,ｼﾞｪﾈﾚｰｼｮﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:17:17.23,0:17:20.36,Default,,0,0,0,,Жалын қанатты аң Гриффинді жоққа шығарады!
Dialogue: 0,0:17:20.36,0:17:22.60,Default,,0,0,0,,Дағды іске қосылды!
Dialogue: 0,0:17:22.60,0:17:25.70,Default,,0,0,0,,Шабуылдаушы тыл сақшысын шегіндіріңіз!
Dialogue: 0,0:17:27.87,0:17:33.17,Default,,0,0,0,,Бұл промоутерлік қауымдастықтың идеалдарына қарсы шығу үшін сылтау ма?
Dialogue: 0,0:17:36.71,0:17:40.58,Default,,0,0,0,,Бірақ сен Шионның үйін бүлдіріп алдың!
Dialogue: 0,0:17:40.58,0:17:43.69,Default,,0,0,0,,Ламирабидің екі мүшесі де қатысты...
Dialogue: 0,0:17:43.69,0:17:45.69,Default,,0,0,0,,Бұл менің әкем туралы.
Dialogue: 0,0:17:48.06,0:17:52.46,Default,,0,0,0,,Микуру әкесі кеткеннен бері қанша өзгерді...
Dialogue: 0,0:17:52.46,0:17:54.71,Default,,0,0,0,,Мен де...
Dialogue: 0,0:17:54.71,0:17:58.07,Default,,0,0,0,,Бұл біртүрлі! Барлығын бақытты ету үшін болса да➡
Dialogue: 0,0:17:58.07,0:18:01.40,Default,,0,0,0,,Неліктен бәрін азапқа түсіресің?
Dialogue: 0,0:18:01.40,0:18:05.38,Default,,0,0,0,,Мен әлі түсінбеймін.
Dialogue: 0,0:18:05.38,0:18:08.56,Default,,0,0,0,,Неліктен өмір мені алдады?
Dialogue: 0,0:18:08.56,0:18:13.00,Default,,0,0,0,,Балалық шағыңыз бақытсыз өткеніне мен кінәлімін➡
Dialogue: 0,0:18:13.00,0:18:17.80,Default,,0,0,0,,Қалағанымша кешірім сұраймын, бірақ өкінбеймін.
Dialogue: 0,0:18:19.69,0:18:22.14,Default,,0,0,0,,Құрбан шалу керек
Dialogue: 0,0:18:22.14,0:18:28.26,Default,,0,0,0,,Сол үшін мен құнын өміріммен төледім.
Dialogue: 0,0:18:28.26,0:18:31.50,Default,,0,0,0,,Менің қанаттарым болашаққа, біз қорғауымыз керек!
Dialogue: 0,0:18:31.50,0:18:34.05,Default,,0,0,0,,Ашулы отты шабу!
Dialogue: 0,0:18:34.05,0:18:38.48,Default,,0,0,0,,Жоғарғы император Айдаһар Айдаһар жүзінің шебері тәж киді!
Dialogue: 0,0:18:38.48,0:18:42.06,Default,,0,0,0,,Қосымша қоңыраулар! Radiend Dragon дағдылары!
Dialogue: 0,0:18:42.06,0:18:44.71,Default,,0,0,0,,Суккубусты шегіндіріңіз
Dialogue: 0,0:18:44.71,0:18:47.01,Default,,0,0,0,,Көктегі шеберлік шегініс!
Dialogue: 0,0:18:50.05,0:18:54.52,Default,,0,0,0,,Егер сіз оның дұрыс екеніне шынымен сенсеңіз, оны әділ орындауыңыз керек!
Dialogue: 0,0:18:54.52,0:18:57.51,Default,,0,0,0,,Балалар, «Боксшылар» ➡ промоушн қауымдастығына жиналдыңдар
Dialogue: 0,0:18:57.51,0:19:02.08,Default,,0,0,0,,Сен сол билікті шындықты ашпай пайдаландың!
Dialogue: 0,0:19:02.08,0:19:06.85,Default,,0,0,0,,Промоутер қауымдастығының идеясын оның негізін қалаушының өзі бұзған!
Dialogue: 0,0:19:06.85,0:19:10.39,Default,,0,0,0,,Radiend Dragon көмегімен Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:19:10.39,0:19:14.53,Default,,0,0,0,,Blaze іске қосылды! Қуат плюс 8000!
Dialogue: 0,0:19:14.53,0:19:17.40,Default,,0,0,0,,Егер Авангард әділ және дұрыс болса➡
Dialogue: 0,0:19:17.40,0:19:22.22,Default,,0,0,0,,Бізге оны сахнаның артында пайдалануға рұқсат жоқ!
Dialogue: 0,0:19:22.22,0:19:25.39,Default,,0,0,0,,ｶﾞｰﾄﾞ
Dialogue: 0,0:19:25.39,0:19:27.74,Default,,0,0,0,,Норкоста орындалатын үміт жоқ.
Dialogue: 0,0:19:27.74,0:19:29.78,Default,,0,0,0,,Не!?
Dialogue: 0,0:19:29.78,0:19:36.45,Default,,0,0,0,,Кемел келешек келіп, мәңгілікке жалғасатын кемел дәуір жүзеге асса➡
Dialogue: 0,0:19:36.45,0:19:40.45,Default,,0,0,0,,Барлық құрбандықтардың лайықты болғанын дәлелде
Dialogue: 0,0:19:43.37,0:19:45.73,Default,,0,0,0,,бірақ мен міндетті түрде Незуконы қайтадан адамға айналдырамын.
Dialogue: 0,0:19:45.73,0:19:50.01,Default,,0,0,0,,Шинду Куроно Кими әкесінен өзгеше
Dialogue: 0,0:19:50.01,0:19:55.70,Default,,0,0,0,,Мен әрқашан жанды орындауда ерекше күш бар деп ойладым.
Dialogue: 0,0:19:55.70,0:19:58.69,Default,,0,0,0,,Бірақ бұл басқаша болды
Dialogue: 0,0:19:58.69,0:20:03.13,Default,,0,0,0,,Юна Сан филиалындағы алдын ала эксперименттен кейін менде күмән пайда болды➡
Dialogue: 0,0:20:03.13,0:20:06.85,Default,,0,0,0,,G Quest арқылы сендірді
Dialogue: 0,0:20:06.85,0:20:10.37,Default,,0,0,0,,Куроно Сіз ерекшеліксіз
Dialogue: 0,0:20:10.37,0:20:12.55,Default,,0,0,0,,Ерекшелік?
Dialogue: 0,0:20:12.55,0:20:18.26,Default,,0,0,0,,Крей планетасы мен осы әлемді байланыстыратын жолды алғаш жасаған адам➡ болды
Dialogue: 0,0:20:18.26,0:20:20.86,Default,,0,0,0,,Бұл сенсің
Dialogue: 0,0:20:22.85,0:20:26.05,Default,,0,0,0,,Авангардқа тәжмен шабуыл жасаңыз!
Dialogue: 0,0:20:26.05,0:20:29.40,Default,,0,0,0,,Блэйзден Critical plus 1!
Dialogue: 0,0:20:29.40,0:20:34.22,Default,,0,0,0,,Құны қанша! Балалардың күлкісін қорғау➡
Dialogue: 0,0:20:34.22,0:20:36.71,Default,,0,0,0,,Бұл үлкендердің міндеті емес пе?
Dialogue: 0,0:20:36.71,0:20:40.21,Default,,0,0,0,,Борышкердің жүрегі мен Авангард ластанған кезде➡
Dialogue: 0,0:20:40.21,0:20:44.55,Default,,0,0,0,,Сөздеріңді тыңдаудың пайдасы жоқ!
Dialogue: 0,0:20:44.55,0:20:46.89,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ
Dialogue: 0,0:20:46.89,0:20:49.51,Default,,0,0,0,,Мен сондай кір қолмен ұстаған болашақ➡
Dialogue: 0,0:20:49.51,0:20:55.61,Default,,0,0,0,,Сіз шынымен де қорғауға тиісті адамдарға өзіңізді мақтан ете аламын деп ойлайсыз ба?
Dialogue: 0,0:21:01.72,0:21:04.32,Default,,0,0,0,,)
Dialogue: 0,0:21:15.05,0:21:18.22,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:21:18.22,0:21:20.22,Default,,0,0,0,,Э-э… Зеницу-сан
Dialogue: 0,0:21:25.74,0:21:29.36,Default,,0,0,0,,Куроно Жақындарыңызға➡
Dialogue: 0,0:21:29.36,0:21:32.96,Default,,0,0,0,,Сіз өзіңіздің шынайы болашағыңызды құрбан еткіңіз келмейді ме?
Dialogue: 0,0:21:38.49,0:21:40.49,Default,,0,0,0,,ﾀﾞﾒｰｼﾞﾁｪｯｸ
Dialogue: 0,0:21:46.38,0:21:49.40,Default,,0,0,0,,Сот үкімі шыққан сияқты.
Dialogue: 0,0:21:49.40,0:21:51.85,Default,,0,0,0,,Иә! Хаха!
Dialogue: 0,0:21:51.85,0:21:56.01,Default,,0,0,0,,Мен түсінбедім, бірақ Мамору-сан жеңеді! Ой!
Dialogue: 0,0:21:56.01,0:21:58.47,Default,,0,0,0,,Мамору-санды қатты ашуландырдың➡
Dialogue: 0,0:21:58.47,0:22:01.27,Default,,0,0,0,,Мен Эниши мырзаның кінәлі екеніне сенімдімін.
Dialogue: 0,0:22:05.10,0:22:08.72,Default,,0,0,0,,((Шинономе: Жақсы, егер Эниши мырза келгісі келсе.
Dialogue: 0,0:22:08.72,0:22:11.35,Default,,0,0,0,,Сіз өзіңіз қалаған нәрсені жасай аласыз.
Dialogue: 0,0:22:11.35,0:22:17.56,Default,,0,0,0,,Дегенмен, менің ұсынысым Лами Лабиринтке негізделген қатаң шешім.
Dialogue: 0,0:22:17.56,0:22:22.90,Default,,0,0,0,,Жеңіске жетпесең...))
Dialogue: 0,0:22:22.90,0:22:28.39,Default,,0,0,0,,《Әлемді басқаратын шындық – мен емес, олар➡
Dialogue: 0,0:22:28.39,0:22:31.19,Default,,0,0,0,,Сіз маған мұны істеуді айтасыз ба?
Dialogue: 0,0:22:31.19,0:22:33.56,Default,,0,0,0,,Бұл жеткілікті ме?
Dialogue: 0,0:22:33.56,0:22:36.56,Default,,0,0,0,,Рахмет
Dialogue: 0,0:22:39.72,0:22:42.20,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:22:42.20,0:22:44.39,Default,,0,0,0,,Біз тағы ұрысатын сияқтымыз.
Dialogue: 0,0:22:44.39,0:22:48.24,Default,,0,0,0,,Бұл не? Жаңа дожо-брейкер?
Dialogue: 0,0:22:48.24,0:22:51.11,Default,,0,0,0,,А, Токоха-чан?
Dialogue: 0,0:22:51.11,0:22:54.01,Default,,0,0,0,,ｽﾀﾞﾝﾄﾞｱｯﾌﾟ ｻﾞ ｳﾞｧﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:22:54.01,0:22:56.85,Default,,0,0,0,,ﾗｲﾄﾞ ﾊﾟｰﾃｨﾝｸﾞ･ｼｪｲﾄﾞ！
Dialogue: 0,0:22:56.85,0:22:59.90,Default,,0,0,0,,ﾗｲﾄﾞ ｱｽﾘｰﾌﾟ･ﾒｻｲｱ
Dialogue: 0,0:22:59.90,0:23:02.22,Default,,0,0,0,,Неон Мәсіхті пионер ретінде жылжытыңыз
Dialogue: 0,0:23:02.22,0:23:07.21,Default,,0,0,0,,Неон Мессидің Ұйқыдағы Мәсіхпен бірге шабуылын күшейтетін авангард
Dialogue: 0,0:23:07.21,0:23:10.03,Default,,0,0,0,,Күзетші жоқ. (Ибуки) Көлікті тексеру
Dialogue: 0,0:23:10.03,0:23:12.38,Default,,0,0,0,,ﾀﾞﾒｰｼﾞﾁｪｯｸ
Dialogue: 0,0:23:12.38,0:23:15.38,Default,,0,0,0,,ｽﾀﾝﾄﾞｱﾝﾄﾞﾄﾞﾛｰ
Dialogue: 0,0:23:29.75,0:23:31.85,Default,,0,0,0,,ﾗｲﾄﾞ
Dialogue: 0,0:23:35.67,0:23:40.71,Default,,0,0,0,,Өгіздің зодиак аңының уақыты
Dialogue: 0,0:23:40.71,0:23:43.21,Default,,0,0,0,,ｸﾛﾉﾋﾞｰﾄﾊﾞｯﾌｧﾛｰ
Dialogue: 0,0:24:01.43,0:24:04.73,Default,,0,0,0,,ｱﾀｯｸ
Dialogue: 0,0:24:07.72,0:24:09.72,Default,,0,0,0,,Э? Естімеймін.
Dialogue: 0,0:24:18.73,0:24:21.03,Default,,0,0,0,,Э? Естімеймін.
Dialogue: 0,0:24:28.09,0:24:31.39,Default,,0,0,0,,Токоха! (Токоха) Бауырым!?
Dialogue: 0,0:24:43.41,0:24:45.41,Default,,0,0,0,,ｲﾀｯ…
Dialogue: 0,0:24:50.05,0:24:53.60,Default,,0,0,0,,Бауырым? Бауырым!
Dialogue: 0,0:24:53.60,0:24:58.40,Default,,0,0,0,,Аға, аға, аға!
Dialogue: 0,0:25:21.43,0:25:24.23,Default,,0,0,0,,ｱﾑ ﾙｰﾅ…
Dialogue: 0,0:25:27.20,0:25:29.20,Default,,0,0,0,,ｱﾑ！
Dialogue: 0,0:25:31.27,0:25:34.07,Default,,0,0,0,,ｱﾑ!!
Dialogue: 0,0:25:37.38,0:25:40.40,Default,,0,0,0,,Құбыжықтармен күресетіндер➡
Dialogue: 0,0:25:40.40,0:25:45.18,Default,,0,0,0,,Біз өзіміз құбыжық болудан сақ болуымыз керек.
Dialogue: 0,0:25:45.18,0:25:48.44,Default,,0,0,0,,Тұңғиыққа қадала қараған кезде➡
Dialogue: 0,0:25:48.44,0:25:52.54,Default,,0,0,0,,Тұңғиық та саған қарап тұр.
Dialogue: 0,0:25:56.25,0:25:59.27,Default,,0,0,0,,Бітімгер оянды
Dialogue: 0,0:25:59.27,0:26:03.37,Default,,0,0,0,,Жүр, мен көбірек тырысайын.
Dialogue: 0,0:27:40.37,0:27:43.05,Default,,0,0,0,,Бұл менмін. Түсінді.
Dialogue: 0,0:27:43.05,0:27:47.04,Default,,0,0,0,,Кейінгі өңдеуді бізге қалдырыңыз
Dialogue: 0,0:27:47.04,0:27:50.06,Default,,0,0,0,,Бұл туралы ойлану үшін сізге де біраз уақыт қажет болуы мүмкін.
Dialogue: 0,0:27:50.06,0:27:55.40,Default,,0,0,0,,Мен ертең осы уақытта және осы жерде күтемін.
Dialogue: 0,0:27:55.40,0:27:57.40,Default,,0,0,0,,Ол келеді деп ойлайсың ба?
Dialogue: 0,0:30:39.31,0:30:42.36,Default,,0,0,0,,<2015 жылы Жапонияда туылғандар саны ➡ болды
Dialogue: 0,0:30:42.36,0:30:44.32,Default,,0,0,0,,5 жылда бірінші рет өсу
Dialogue: 0,0:30:44.32,0:30:50.17,Default,,0,0,0,,Ойын-сауық әлемі де сәби асығыс және қуанышты жаңалықтар ұшады.
Dialogue: 0,0:30:50.17,0:30:54.84,Default,,0,0,0,,Барлық үлкен жұптарды құттықтаймыз
Dialogue: 0,0:30:54.84,0:30:58.44,Default,,0,0,0,,Осындай атақты адамдар да аман-есен босану үшін дұға етуге келеді →
Dialogue: 0,0:30:59.94,0:31:05.94,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory