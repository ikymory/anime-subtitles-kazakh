Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:04.27,0:01:06.49,Default,,0,0,0,,Менімен күрес, Луиза
Dialogue: 0,0:01:06.49,0:01:10.29,Default,,0,0,0,,Бірақ бұл жерде аздап шулы.
Dialogue: 0,0:01:13.49,0:01:15.79,Default,,0,0,0,,Куроноға мінбе!
Dialogue: 0,0:01:18.93,0:01:20.92,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:01:20.92,0:01:23.47,Default,,0,0,0,,ｽﾀﾝﾄﾞｱｯﾌﾟ ｳﾞｧﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:01:23.47,0:01:26.44,Default,,0,0,0,,Балалар сендер мұны көрмедіңдер!
Dialogue: 0,0:01:26.44,0:01:29.29,Default,,0,0,0,,Мен кінәлімін
Dialogue: 0,0:01:29.29,0:01:32.76,Default,,0,0,0,,Сізді алып кеткен жағдайларды айтып беріңізші.
Dialogue: 0,0:01:32.76,0:01:37.10,Default,,0,0,0,,Иә. Мен Курононы да жіберген жоқпын.
Dialogue: 0,0:01:37.10,0:01:41.07,Default,,0,0,0,,Екі дүниені байланыстыратын тағдырдың құдіреті
Dialogue: 0,0:01:41.07,0:01:44.78,Default,,0,0,0,,Льюес тепе-теңдікті еңкейтуге тырысады.
Dialogue: 0,0:01:44.78,0:01:48.70,Default,,0,0,0,,Бұл дүниенің барлық нығметтері
Dialogue: 0,0:01:48.70,0:01:53.45,Default,,0,0,0,,Және барлық зұлымдық ...
Dialogue: 0,0:01:53.45,0:01:56.95,Default,,0,0,0,,Ақымақ болма! Мен мұндай еліктеуді кешіре алмаймын!
Dialogue: 0,0:02:12.34,0:02:16.14,Default,,0,0,0,,Бұл...
Dialogue: 0,0:02:20.96,0:02:23.26,Default,,0,0,0,,Сіз байқадыңыз ба?
Dialogue: 0,0:02:26.58,0:02:30.47,Default,,0,0,0,,6-шы айналым Кимидің Балиф шабуылы ➡
Dialogue: 0,0:02:30.47,0:02:33.98,Default,,0,0,0,,Төбелес мен оны күзеткенде үзілді.
Dialogue: 0,0:02:33.98,0:02:38.88,Default,,0,0,0,,Өйткені сенің байсалды ұрысатындай күйің жоқ еді.
Dialogue: 0,0:02:38.88,0:02:43.27,Default,,0,0,0,,Салқындағаннан кейін біз орындарды ауыстырдық.
Dialogue: 0,0:02:43.27,0:02:48.72,Default,,0,0,0,,Тыныш жер емес пе? Мен ешкімге араласпаймын
Dialogue: 0,0:02:48.72,0:02:51.63,Default,,0,0,0,,Қазір...
Dialogue: 0,0:02:51.63,0:02:55.23,Default,,0,0,0,,Біз жалғастырамыз ба? Синдо Куроно
Dialogue: 0,0:06:10.29,0:06:14.96,Default,,0,0,0,,Шынымды айтсам, мен Вакамизуды түсінбеймін.
Dialogue: 0,0:06:14.96,0:06:19.75,Default,,0,0,0,,Менің ойымша, Реус мырза Синдо Куроно туралы өте ерекше.
Dialogue: 0,0:06:19.75,0:06:26.42,Default,,0,0,0,,Шынында да, оның тәуелді картасының оятуы және қалпына келуі ➡ болып табылады
Dialogue: 0,0:06:26.42,0:06:29.64,Default,,0,0,0,,Мүлдем қажет
Dialogue: 0,0:06:29.64,0:06:32.61,Default,,0,0,0,,Керісінше, одан асқан құндылық жоқ.
Dialogue: 0,0:06:32.61,0:06:35.60,Default,,0,0,0,,Бізде Юдзуки Луна➡ деген есім бар
Dialogue: 0,0:06:35.60,0:06:37.59,Default,,0,0,0,,Өйткені тыныштықты жасаушы бар
Dialogue: 0,0:06:37.59,0:06:39.75,Default,,0,0,0,,Мүлдем негізсіз
Dialogue: 0,0:06:39.75,0:06:41.82,Default,,0,0,0,,Түсініксіз!
Dialogue: 0,0:06:41.82,0:06:44.32,Default,,0,0,0,,Бұл центиментальды.
Dialogue: 0,0:06:47.68,0:06:50.28,Default,,0,0,0,,Ол қозғалды.
Dialogue: 0,0:06:52.62,0:06:56.22,Default,,0,0,0,,Морияма ше? (Ениши) Мен білмеймін
Dialogue: 0,0:07:03.13,0:07:05.08,Default,,0,0,0,,ﾀｰﾝｴﾝﾄﾞ
Dialogue: 0,0:07:05.08,0:07:07.58,Default,,0,0,0,,Warp Drive Dragon G-аймаққа барады
Dialogue: 0,0:07:07.58,0:07:09.83,Default,,0,0,0,,Барифті палубаның төменгі жағына қойыңыз
Dialogue: 0,0:07:09.83,0:07:12.33,Default,,0,0,0,,Биндзонның жоғарғы ағынына қоңырау шалыңыз
Dialogue: 0,0:07:14.76,0:07:16.74,Default,,0,0,0,,ｽﾀﾝﾄﾞｱﾝﾄﾞﾄﾞﾛｰ
Dialogue: 0,0:07:16.74,0:07:19.59,Default,,0,0,0,,Хронофанг жолбарыстың шеберлігі
Dialogue: 0,0:07:19.59,0:07:24.65,Default,,0,0,0,,Сіз төмендететін бірлік бағасын қадам құны 3 ретінде қосыңыз
Dialogue: 0,0:07:24.65,0:07:27.43,Default,,0,0,0,,Сонымен қатар, картаны байлаңыз
Dialogue: 0,0:07:27.43,0:07:29.60,Default,,0,0,0,,Transcend!
Dialogue: 0,0:07:29.60,0:07:33.57,Default,,0,0,0,,Ғарыштық-уақыт жануары Flotogear Pipogriff!
Dialogue: 0,0:07:33.57,0:07:38.91,Default,,0,0,0,,ｺｰﾙ ｽﾁｰﾑﾅｲﾄﾑﾀﾞﾙ ｽﾁｰﾑﾌｧｲﾀｰﾅﾝﾈｱ
Dialogue: 0,0:07:38.91,0:07:42.13,Default,,0,0,0,,Сіз бұл дүниенің болашағы үшінсіз➡
Dialogue: 0,0:07:42.13,0:07:46.02,Default,,0,0,0,,Сіз Крей планетасының болашағын ұрлауды жоспарлап отырсыз.
Dialogue: 0,0:07:46.02,0:07:49.59,Default,,0,0,0,,Әй, ақыры есіңе түскен сияқтысың.
Dialogue: 0,0:07:49.59,0:07:51.81,Default,,0,0,0,,Сол күн туралы барлығы➡
Dialogue: 0,0:07:51.81,0:07:54.28,Default,,0,0,0,,Адамның өз тағдыры
Dialogue: 0,0:07:54.28,0:07:57.30,Default,,0,0,0,,Авангардқа қалқымалы құралмен шабуыл жасаңыз
Dialogue: 0,0:07:57.30,0:07:59.25,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ
Dialogue: 0,0:07:59.25,0:08:03.10,Default,,0,0,0,,Қақпаның ар жағында күту – дүниенің ақиқаты
Dialogue: 0,0:08:03.10,0:08:06.31,Default,,0,0,0,,Крей планетасы және біздің әлем➡
Dialogue: 0,0:08:06.31,0:08:09.43,Default,,0,0,0,,Екеуін байланыстыратын тағдыр таразысы
Dialogue: 0,0:08:09.43,0:08:13.96,Default,,0,0,0,,Таразыны зодиак аңының күшімен аударамын➡
Dialogue: 0,0:08:13.96,0:08:17.27,Default,,0,0,0,,Осы әлемге кемел болашаққа жетелеу!
Dialogue: 0,0:08:17.27,0:08:20.60,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ！
Dialogue: 0,0:08:20.60,0:08:24.48,Default,,0,0,0,,Егер Float Gear біліктілігін тексеруде 3-дәреже пайда болса➡
Dialogue: 0,0:08:24.48,0:08:26.59,Default,,0,0,0,,ﾊﾟﾜｰﾌﾟﾗｽ5000
Dialogue: 0,0:08:26.59,0:08:30.63,Default,,0,0,0,,Сонымен қатар, бір артқы қорғаушыны уақытпен секіріңіз және меламды шақырыңыз.
Dialogue: 0,0:08:30.63,0:08:33.27,Default,,0,0,0,,Карточка байланыстыру аймағына орналастырылған кезде➡
Dialogue: 0,0:08:33.27,0:08:36.75,Default,,0,0,0,,Наннеяның шеберлігі мен күші бар, плюс 4000
Dialogue: 0,0:08:36.75,0:08:39.67,Default,,0,0,0,,Қарғыс атсын... Екінші тексеру
Dialogue: 0,0:08:39.67,0:08:43.58,Default,,0,0,0,,Жылу триггерін алыңыз Қуат меламда
Dialogue: 0,0:08:43.58,0:08:47.13,Default,,0,0,0,,Зақымдану 1 қалпына келтіру үшінші тексеру
Dialogue: 0,0:08:47.13,0:08:50.30,Default,,0,0,0,,ｹﾞｯﾄ ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ
Dialogue: 0,0:08:50.30,0:08:53.40,Default,,0,0,0,,Қуат модальды, критикалық - қалқымалы беріліс
Dialogue: 0,0:08:55.99,0:08:58.29,Default,,0,0,0,,Жақындама! Мен саған айттым ғой, оның ашуы тез шығатынын!
Dialogue: 0,0:09:00.58,0:09:02.80,Default,,0,0,0,,Бұл жігіттер барлығының болашағын ұрлайды➡
Dialogue: 0,0:09:02.80,0:09:07.20,Default,,0,0,0,,Қалай ойлайсың, біз бақытты болғанымыз дұрыс па?
Dialogue: 0,0:09:07.20,0:09:10.27,Default,,0,0,0,,Менің кешірім сұрауға ниетім жоқ!
Dialogue: 0,0:09:10.27,0:09:12.31,Default,,0,0,0,,Авангардқа шабуыл
Dialogue: 0,0:09:12.31,0:09:14.34,Default,,0,0,0,,Қуат плюс 4000 шеберлікпен
Dialogue: 0,0:09:14.34,0:09:16.34,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:09:19.63,0:09:21.58,Default,,0,0,0,,Палубаға мелам қосыңыз
Dialogue: 0,0:09:21.58,0:09:23.63,Default,,0,0,0,,Қалған кезде Улу Ватарға қоңырау шалыңыз
Dialogue: 0,0:09:23.63,0:09:26.59,Default,,0,0,0,,Ешкім жыламайды, ешкім зардап шекпейді➡
Dialogue: 0,0:09:26.59,0:09:29.42,Default,,0,0,0,,Кемелді болашақ орындалады
Dialogue: 0,0:09:29.42,0:09:32.78,Default,,0,0,0,,Авангард әлемді құтқарады!
Dialogue: 0,0:09:32.78,0:09:35.35,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:09:35.35,0:09:40.35,Default,,0,0,0,,Клей... және Авангард туралы не ойлайсыз!?
Dialogue: 0,0:09:47.31,0:09:49.64,Default,,0,0,0,,GPS-те өзгеріс жоқ
Dialogue: 0,0:09:49.64,0:09:52.73,Default,,0,0,0,,Содан бері ол бір орында тұрып қалды.
Dialogue: 0,0:09:52.73,0:09:54.60,Default,,0,0,0,,Міне болды!
Dialogue: 0,0:09:54.60,0:09:57.75,Default,,0,0,0,,Антарес компанияға тиесілі.
Dialogue: 0,0:09:57.75,0:10:00.30,Default,,0,0,0,,Антарес! Сен білесің бе?
Dialogue: 0,0:10:00.30,0:10:04.69,Default,,0,0,0,,Кеңейту қауымдастығының еншілес компанияларының бірі
Dialogue: 0,0:10:04.69,0:10:08.31,Default,,0,0,0,,Бұл Миджин Льюестің жеке активтерін басқаратын компания болуы керек еді.
Dialogue: 0,0:10:08.31,0:10:11.10,Default,,0,0,0,,Мүмкін вилла немесе бірдеңе...
Dialogue: 0,0:10:11.10,0:10:14.17,Default,,0,0,0,,Бұл шынымен жақсы ма? қол
Dialogue: 0,0:10:14.17,0:10:16.47,Default,,0,0,0,,Мен кептірілген сардина жедім.
Dialogue: 0,0:10:20.26,0:10:23.66,Default,,0,0,0,,Мен сені жібермеймін, ха!
Dialogue: 0,0:10:23.66,0:10:26.51,Default,,0,0,0,,Не болды? Маған кедергі болған сияқты
Dialogue: 0,0:10:26.51,0:10:28.81,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:10:33.59,0:10:35.84,Default,,0,0,0,,Шинономе...
Dialogue: 0,0:10:35.84,0:10:38.44,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:10:40.61,0:10:43.08,Default,,0,0,0,,Э? Естімеймін.
Dialogue: 0,0:10:43.08,0:10:46.75,Default,,0,0,0,,Бұл қорқынышты интерфейс!
Dialogue: 0,0:10:46.75,0:10:49.34,Default,,0,0,0,,Күте тұрыңыз, бәріңіз!
Dialogue: 0,0:10:49.34,0:10:52.34,Default,,0,0,0,,Ол тым қисық! Ибуки!
Dialogue: 0,0:10:58.93,0:11:01.13,Default,,0,0,0,,Сіз әлі зейнетке шықтыңыз ба?
Dialogue: 0,0:11:01.13,0:11:05.75,Default,,0,0,0,,Менің сүйікті көлігім, Шредингер-чан, 13 құпия қару➡
Dialogue: 0,0:11:05.75,0:11:07.92,Default,,0,0,0,,Бізде оны ашу жоспарлары бар!
Dialogue: 0,0:11:07.92,0:11:10.17,Default,,0,0,0,,Мұндағы Окаринді
Dialogue: 0,0:11:10.17,0:11:12.97,Default,,0,0,0,,Қарғыс атсын...｡ (мотоциклдің жүгіру дыбысы)
Dialogue: 0,0:11:16.11,0:11:18.92,Default,,0,0,0,,ﾌﾞﾗｯﾃﾞｨｴﾝｼﾞｪﾙ？
Dialogue: 0,0:11:18.92,0:11:21.10,Default,,0,0,0,,Мынаны пайдаланыңыз!
Dialogue: 0,0:11:21.10,0:11:24.29,Default,,0,0,0,,Камуи-сан, өтінемін. Маған қалдырыңыз!
Dialogue: 0,0:11:24.29,0:11:26.77,Default,,0,0,0,,Екі адам сұраңыз.
Dialogue: 0,0:11:26.77,0:11:29.27,Default,,0,0,0,,Олар табанды адамдар.
Dialogue: 0,0:11:31.98,0:11:34.33,Default,,0,0,0,,Мен сені жібермеймін! Токоха!
Dialogue: 0,0:11:34.33,0:11:37.10,Default,,0,0,0,,Қайтарыңыз!
Dialogue: 0,0:11:37.10,0:11:40.30,Default,,0,0,0,,Курономен не істейсің!? Аму не болып жатыр!?
Dialogue: 0,0:11:40.30,0:11:42.67,Default,,0,0,0,,Неліктен Луна...
Dialogue: 0,0:11:42.67,0:11:45.67,Default,,0,0,0,,Неліктен Лунаны бұлай етуге мәжбүр еттіңіз?
Dialogue: 0,0:11:47.58,0:11:52.98,Default,,0,0,0,,Луна Юдзуки бітімгершілік қабілетінің орнына өзін-өзі сезінуден айырылды.
Dialogue: 0,0:11:52.98,0:11:56.95,Default,,0,0,0,,Аму Чоно компанияда қосалқы зат ретінде қалады.
Dialogue: 0,0:11:56.95,0:11:58.94,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:11:58.94,0:12:04.01,Default,,0,0,0,,Мен Луна Юдзукиді не болса да қорғаймын.
Dialogue: 0,0:12:04.01,0:12:06.01,Default,,0,0,0,,Ха! Ах!
Dialogue: 0,0:12:08.02,0:12:10.02,Default,,0,0,0,,Күте тұрыңыз! Токоха!
Dialogue: 0,0:12:12.99,0:12:16.57,Default,,0,0,0,,Әй, эй, көп ойнама. Сенімен бәрі жақсы ма?
Dialogue: 0,0:12:16.57,0:12:18.68,Default,,0,0,0,,Өте шиеленісті, иә?
Dialogue: 0,0:12:18.68,0:12:22.68,Default,,0,0,0,,Мен де оларға аздап қарыздармын.
Dialogue: 0,0:12:34.31,0:12:36.31,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:18.28,0:14:20.26,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｼﾞｪﾈﾚｰｼｮﾝ！
Dialogue: 0,0:14:20.26,0:14:23.25,Default,,0,0,0,,ｸﾛﾉﾄﾞﾗｺﾞﾝ･ﾈｸｽﾃｰｼﾞ！
Dialogue: 0,0:14:23.25,0:14:25.27,Default,,0,0,0,,ｽﾄﾗｲﾄﾞｽｷﾙ！
Dialogue: 0,0:14:25.27,0:14:27.64,Default,,0,0,0,,Палубаның түбіне мұжықтарды қойыңыз!
Dialogue: 0,0:14:27.64,0:14:31.01,Default,,0,0,0,,Су төгетін клапан айдаһарына қоңырау шалыңыз!
Dialogue: 0,0:14:31.01,0:14:33.03,Default,,0,0,0,,Дағды іске қосылды!
Dialogue: 0,0:14:33.03,0:14:36.91,Default,,0,0,0,,Пауэр Plus 2000 жоғары ағын және су төгетін клапандар үшін!
Dialogue: 0,0:14:36.91,0:14:40.27,Default,,0,0,0,,Крей планетасы Vanguard➡ есебінен
Dialogue: 0,0:14:40.27,0:14:43.97,Default,,0,0,0,,Болашағыңның несі қуантады, осыншама көп нәрсені ұғасың!
Dialogue: 0,0:14:43.97,0:14:47.92,Default,,0,0,0,,Куроно, маған сурет беріңізші.
Dialogue: 0,0:14:47.92,0:14:53.93,Default,,0,0,0,,Сіз жоғалтқан барлық өткен...
Dialogue: 0,0:14:53.93,0:14:57.28,Default,,0,0,0,,Бұл көз жас...
Dialogue: 0,0:14:57.28,0:14:59.92,Default,,0,0,0,,Оны сақтауға болады! Барлығы!
Dialogue: 0,0:14:59.92,0:15:02.96,Default,,0,0,0,,Авангардтың болашағын алып тастаса да➡
Dialogue: 0,0:15:02.96,0:15:06.26,Default,,0,0,0,,Біз сізге мол бақыт уәде береміз!
Dialogue: 0,0:15:06.26,0:15:08.93,Default,,0,0,0,,Су төгетін клапан айдаһарымен шабуыл!
Dialogue: 0,0:15:08.93,0:15:10.98,Default,,0,0,0,,ｶﾞｰﾄﾞ
Dialogue: 0,0:15:10.98,0:15:14.33,Default,,0,0,0,,Nexus сахнасында Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:15:14.33,0:15:16.29,Default,,0,0,0,,Мен бұл екеніне сенімдімін➡
Dialogue: 0,0:15:16.29,0:15:18.92,Default,,0,0,0,,Авангардтың әлемде өмір сүруінің мәні осы болды.
Dialogue: 0,0:15:18.92,0:15:20.91,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ！
Dialogue: 0,0:15:20.91,0:15:23.64,Default,,0,0,0,,ｹﾞｯﾄ！ ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ！
Dialogue: 0,0:15:23.64,0:15:25.61,Default,,0,0,0,,Хроно Дранға қуат!
Dialogue: 0,0:15:25.61,0:15:27.91,Default,,0,0,0,,Келесі кезеңге сындарлы!
Dialogue: 0,0:15:31.64,0:15:35.32,Default,,0,0,0,,Хроно! Келесі кезең дағдыларды белсендіру!
Dialogue: 0,0:15:35.32,0:15:37.62,Default,,0,0,0,,Chronojet стенді!
Dialogue: 0,0:15:39.91,0:15:45.93,Default,,0,0,0,,Авангардтың мағынасын сіз шешпейсіз!
Dialogue: 0,0:15:45.93,0:15:48.30,Default,,0,0,0,,Оны ешқашан мойындамаңыз
Dialogue: 0,0:15:48.30,0:15:52.26,Default,,0,0,0,,Сіз Авангард➡ орнына болашақты алдыңыз
Dialogue: 0,0:15:52.26,0:15:57.96,Default,,0,0,0,,Мен енді мен емеспін.
Dialogue: 0,0:15:57.96,0:16:02.93,Default,,0,0,0,,Менде қазір бар нәрсені Авангард берді.
Dialogue: 0,0:16:02.93,0:16:07.69,Default,,0,0,0,,Достар... және әлем...
Dialogue: 0,0:16:07.69,0:16:12.29,Default,,0,0,0,,Менің осында тұруымның барлық себептері!
Dialogue: 0,0:16:14.91,0:16:18.93,Default,,0,0,0,,Авангард - өзіммін
Dialogue: 0,0:16:18.93,0:16:21.37,Default,,0,0,0,,Куроно Доранның күшеюі!
Dialogue: 0,0:16:21.37,0:16:24.37,Default,,0,0,0,,Chrono Джет көмегімен Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:16:28.24,0:16:30.24,Default,,0,0,0,,ｼﾞｪﾈﾚｰｼｮﾝｶﾞｰﾄﾞ！
Dialogue: 0,0:16:30.24,0:16:33.65,Default,,0,0,0,,ﾊｲﾌﾞﾛｰｽﾁｰﾑﾗﾌｧﾝﾅ！
Dialogue: 0,0:16:33.65,0:16:36.95,Default,,0,0,0,,Сіз де...
Dialogue: 0,0:16:38.97,0:16:42.32,Default,,0,0,0,,Live ұлы?
Dialogue: 0,0:16:42.32,0:16:47.99,Default,,0,0,0,,Рафаннаның шеберлігі Наннеяны палубаға қайтарып, Машуданы шақыр
Dialogue: 0,0:16:47.99,0:16:51.03,Default,,0,0,0,,Лафаннаның қалқаны плюс 10000
Dialogue: 0,0:16:51.03,0:16:53.68,Default,,0,0,0,,Әлі жоқ!
Dialogue: 0,0:16:53.68,0:16:55.68,Default,,0,0,0,,ﾂｲﾝﾄﾞﾗｲﾌﾞ！
Dialogue: 0,0:16:57.94,0:17:01.59,Default,,0,0,0,,ｾｶﾝﾄﾞﾁｪｯｸ！ ｹﾞｯﾄ ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ！
Dialogue: 0,0:17:01.59,0:17:04.58,Default,,0,0,0,,Барлық әсерлер жоғары ағында
Dialogue: 0,0:17:04.58,0:17:07.61,Default,,0,0,0,,Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:17:07.61,0:17:09.61,Default,,0,0,0,,ｶﾞｰﾄﾞ！
Dialogue: 0,0:17:13.95,0:17:16.92,Default,,0,0,0,,ﾀｰﾝｴﾝﾄﾞ
Dialogue: 0,0:17:16.92,0:17:19.63,Default,,0,0,0,,ｽﾀﾝﾄﾞｱﾝﾄﾞﾄﾞﾛｰ
Dialogue: 0,0:17:19.63,0:17:23.60,Default,,0,0,0,,Қадам құны ретінде Машуданы байлау
Dialogue: 0,0:17:23.60,0:17:26.25,Default,,0,0,0,,Менің тілегім барлық болашаққа!
Dialogue: 0,0:17:26.25,0:17:28.59,Default,,0,0,0,,Қалай болғанда да!
Dialogue: 0,0:17:28.59,0:17:34.27,Default,,0,0,0,,Transcend! Ғарыштық-уақыт айдаһары уақыт айдаһарын байланыстырады!
Dialogue: 0,0:17:34.27,0:17:37.33,Default,,0,0,0,,ｺｰﾙ！ ｸﾛﾉﾌｧﾝｸﾞ･ﾀｲｶﾞｰ！
Dialogue: 0,0:17:37.33,0:17:42.63,Default,,0,0,0,,Неге түсінбейсің?
Dialogue: 0,0:17:44.58,0:17:47.94,Default,,0,0,0,,Мен сендерді қалаймын➡
Dialogue: 0,0:17:47.94,0:17:50.59,Default,,0,0,0,,Мен сені бақытты еткім келді...
Dialogue: 0,0:17:50.59,0:17:53.58,Default,,0,0,0,,Менен мұны ешкім талап еткен жоқ!
Dialogue: 0,0:17:53.58,0:17:56.96,Default,,0,0,0,,Мен сіздің пікіріңізді тыңдамаймын!
Dialogue: 0,0:17:56.96,0:17:59.93,Default,,0,0,0,,Байланыс кезінде Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:17:59.93,0:18:01.97,Default,,0,0,0,,Уақытты байланыстыру дағдылары!
Dialogue: 0,0:18:01.97,0:18:06.59,Default,,0,0,0,,Байланыс Ул-Ватару және қосу уақытында қуат плюс 10000
Dialogue: 0,0:18:06.59,0:18:08.98,Default,,0,0,0,,ｸﾘﾃｨｶﾙﾌﾟﾗｽ１
Dialogue: 0,0:18:08.98,0:18:12.30,Default,,0,0,0,,Байланыс аймағында қанша бірлік болса, сонша бірлік➡
Dialogue: 0,0:18:12.30,0:18:15.93,Default,,0,0,0,,Қарсыластың артқы қорғаушысын палубаның төменгі жағына жылжытыңыз
Dialogue: 0,0:18:15.93,0:18:19.95,Default,,0,0,0,,Сонымен қатар, Уру-Ватаруды палубаның төменгі жағына жылжыту дағдысын пайдаланыңыз.
Dialogue: 0,0:18:19.95,0:18:25.26,Default,,0,0,0,,2 картаны сал. Қолыңыздан палубаға 1 картаны қайтарыңыз.
Dialogue: 0,0:18:25.26,0:18:29.36,Default,,0,0,0,,Мен сенсем де... неге...
Dialogue: 0,0:18:29.36,0:18:32.36,Default,,0,0,0,,Неге маған опасыздық жасайсың!
Dialogue: 0,0:18:34.60,0:18:36.60,Default,,0,0,0,,Біз мұны істей алар едік!
Dialogue: 0,0:18:36.60,0:18:42.96,Default,,0,0,0,,Неліктен Авангард әлемді құтқара алады?
Dialogue: 0,0:18:42.96,0:18:44.93,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:18:44.93,0:18:46.98,Default,,0,0,0,,ﾄﾘﾌﾟﾙﾄﾞﾗｲﾌﾞ！
Dialogue: 0,0:18:46.98,0:18:49.58,Default,,0,0,0,,ｹﾞｯﾄ！ ｸﾘﾃｨｶﾙﾄﾘｶﾞｰ！
Dialogue: 0,0:18:49.58,0:18:53.59,Default,,0,0,0,,Барлық әсерлер Chronofang Tiger-ге өтеді
Dialogue: 0,0:18:53.59,0:18:58.64,Default,,0,0,0,,Мен әлемді құтқарамын! Бұл өмір бітсе де!
Dialogue: 0,0:18:58.64,0:19:01.64,Default,,0,0,0,,Жалғыз бол!
Dialogue: 0,0:19:03.63,0:19:05.67,Default,,0,0,0,,Машуданың күшеюі!
Dialogue: 0,0:19:05.67,0:19:08.62,Default,,0,0,0,,Авангардқа Хронофангпен шабуыл жасаңыз!
Dialogue: 0,0:19:08.62,0:19:10.62,Default,,0,0,0,,ﾉｰｶﾞｰﾄﾞ
Dialogue: 0,0:19:14.04,0:19:16.64,Default,,0,0,0,,ﾀﾞﾒｰｼﾞﾁｪｯｸ… ｸｯ
Dialogue: 0,0:19:19.35,0:19:21.65,Default,,0,0,0,,ｾｶﾝﾄﾞﾁｪｯｸ…
Dialogue: 0,0:19:26.62,0:19:28.62,Default,,0,0,0,,Хе...
Dialogue: 0,0:19:31.68,0:19:34.68,Default,,0,0,0,,Тіпті бітімгердің көмегінсіз...
Dialogue: 0,0:19:37.28,0:19:40.28,Default,,0,0,0,,Сіз мұны көп жасай аласыз.
Dialogue: 0,0:19:44.32,0:19:47.62,Default,,0,0,0,,Қош бол, тірінің баласы
Dialogue: 0,0:19:57.27,0:20:00.82,Default,,0,0,0,,((Хроно Дран: Егер сіз маған және менің достарыма қоңырау шалсаңыз➡
Dialogue: 0,0:20:00.82,0:20:04.62,Default,,0,0,0,,Уақыт пен кеңістікте жүгіру (әрдайым))
Dialogue: 0,0:20:13.25,0:20:15.25,Default,,0,0,0,,Міне, уақыты!
Dialogue: 0,0:20:15.25,0:20:17.60,Default,,0,0,0,,Кеттік, Ибуки!
Dialogue: 0,0:20:17.60,0:20:19.66,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:20:19.66,0:20:21.66,Default,,0,0,0,,Мен Тодомен мүмкіндігінше тезірек кездескім келеді—немесе ең болмағанда Мивамен—бірақ
Dialogue: 0,0:20:25.08,0:20:27.93,Default,,0,0,0,,ол немесе сенімге толы қуғыншы,
Dialogue: 0,0:20:27.93,0:20:48.60,Default,,0,0,0,,♪♪～
Dialogue: 0,0:20:48.60,0:20:52.11,Default,,0,0,0,,Кел! Хроно Дран!
Dialogue: 0,0:20:52.11,0:21:30.31,Default,,0,0,0,,♪♪～
Dialogue: 0,0:21:30.31,0:21:32.31,Default,,0,0,0,,ｸﾛﾉ！
Dialogue: 0,0:21:41.75,0:21:43.74,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:21:43.74,0:21:45.74,Default,,0,0,0,,(шабуыл дыбысы)
Dialogue: 0,0:21:45.74,0:21:48.81,Default,,0,0,0,,Онда!
Dialogue: 0,0:21:48.81,0:21:50.93,Default,,0,0,0,,Күте тұрыңыз, Кузуки! Кузуки!
Dialogue: 0,0:21:50.93,0:22:13.59,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:13.59,0:22:15.62,Default,,0,0,0,,Кузуки!
Dialogue: 0,0:22:15.62,0:22:17.62,Default,,0,0,0,,Тезірек, Кузуки!
Dialogue: 0,0:22:20.26,0:22:22.30,Default,,0,0,0,,О!
Dialogue: 0,0:22:22.30,0:22:44.78,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:44.78,0:22:46.78,Default,,0,0,0,,Хроно! Бұл өте көп!
Dialogue: 0,0:22:49.14,0:22:52.21,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:22:52.21,0:22:54.81,Default,,0,0,0,,Барлығыңыз келіңіздер!
Dialogue: 0,0:22:57.81,0:23:32.77,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:32.77,0:23:35.00,Default,,0,0,0,,ｸﾛﾉ！
Dialogue: 0,0:23:35.00,0:23:37.00,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:23:38.92,0:23:42.83,Default,,0,0,0,,Уау! Уау!
Dialogue: 0,0:23:42.83,0:23:47.93,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:23:51.78,0:23:54.17,Default,,0,0,0,,Кукукукукуку…
Dialogue: 0,0:23:54.17,0:23:56.27,Default,,0,0,0,,Тасымалдау аяқталды!
Dialogue: 0,0:24:11.32,0:24:18.62,Default,,0,0,0,,Әлі көрінбеген тағдыр
Dialogue: 0,0:24:21.25,0:24:23.77,Default,,0,0,0,,Қарсы шыққыңыз келсе, маған еріңіз.
Dialogue: 0,0:24:23.77,0:24:29.22,Default,,0,0,0,,Соңғы үкім қашан шығарылады➡
Dialogue: 0,0:24:29.22,0:24:32.32,Default,,0,0,0,,Қателіктеріңізді есте сақтаңыз
Dialogue: 0,0:24:34.31,0:24:36.31,Default,,0,0,0,,Әлі көрінбеген тағдыр
Dialogue: 0,0:26:24.47,0:26:26.57,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:26:26.57,0:26:28.62,Default,,0,0,0,,Сондай-ақ мұндағы Майушиді
Dialogue: 0,0:26:28.62,0:26:31.94,Default,,0,0,0,,Сәлем бәріңе! Доран!
Dialogue: 0,0:26:31.94,0:26:33.94,Default,,0,0,0,,Қарғыс атсын... неге!
Dialogue: 0,0:26:36.63,0:26:38.60,Default,,0,0,0,,Екеуі де көтеруге тым ауыр.
Dialogue: 0,0:26:38.60,0:26:41.20,Default,,0,0,0,,Мен саған көмектесемін, күте тұр!
Dialogue: 0,0:26:49.30,0:26:51.30,Default,,0,0,0,,ｸﾛﾉ！
Dialogue: 0,0:26:55.92,0:26:58.50,Default,,0,0,0,,Барлығы...Жақсы!
Dialogue: 0,0:26:58.50,0:27:00.50,Default,,0,0,0,,ﾄｺﾊ！ ｼｵﾝ！
Dialogue: 0,0:27:02.43,0:27:05.51,Default,,0,0,0,,Ах! Ал раушан гүлдері ше? Тәуелділік картасы туралы не деуге болады?
Dialogue: 0,0:27:05.51,0:27:09.62,Default,,0,0,0,,Біз ішке кіргенімізде, сен жалғыз қалдың.
Dialogue: 0,0:27:09.62,0:27:11.62,Default,,0,0,0,,Карточка...
Dialogue: 0,0:27:16.32,0:27:19.62,Default,,0,0,0,,Кешіріңіз, бұл менің кінәм
Dialogue: 0,0:27:29.27,0:27:31.27,Default,,0,0,0,,Мен қақпаны бұзып өттім дедің—дәл қазір де, қазір де, солай емес пе?
Dialogue: 0,0:27:33.97,0:27:35.97,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:27:39.93,0:27:42.62,Default,,0,0,0,,Мен оны көрдім.
Dialogue: 0,0:27:42.62,0:27:45.27,Default,,0,0,0,,Мен қайда екенін білмейтін алыс жерде➡
Dialogue: 0,0:27:45.27,0:27:49.31,Default,,0,0,0,,Geacronic➡ зодиак уақытының аңымен бірге
Dialogue: 0,0:27:49.31,0:27:53.28,Default,,0,0,0,,Луна да сонда болды.
Dialogue: 0,0:27:53.28,0:27:56.01,Default,,0,0,0,,Мен сізге көмектесе алатыныма сенімдімін
Dialogue: 0,0:27:56.01,0:27:58.81,Default,,0,0,0,,Барлығы біздің келуімізді күтіп отыр!
Dialogue: 0,0:28:02.79,0:28:04.89,Default,,0,0,0,,Бұл осылай аяқталмайды!
Dialogue: 0,0:30:47.28,0:30:50.28,Default,,0,0,0,,<Юкимураның тамаша әскери ерліктерінің отаны>
Dialogue: 0,0:30:55.32,0:30:57.24,Default,,0,0,0,,<Биыл бұл қала➡
Dialogue: 0,0:30:57.24,0:31:00.75,Default,,0,0,0,,Юкимура Санада қызба кезінде қатты соққыға жығылды
Dialogue: 0,0:31:02.25,0:31:08.25,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory