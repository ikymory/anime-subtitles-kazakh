Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.75,0:00:09.76,Default,,0,0,0,,♪~
Dialogue: 0,0:00:40.45,0:00:45.46,Default,,0,0,0,,~♪
Dialogue: 0,0:00:46.50,0:00:48.92,Default,,0,0,0,,Эй, сен бұл өсімдікті білесің бе?
Dialogue: 0,0:00:49.00,0:00:50.67,Default,,0,0,0,,Daturametel
Dialogue: 0,0:00:50.76,0:00:51.71,Default,,0,0,0,,Жақсы түсіндім.Әдетте «Ібіліс кернейі» деген атпен белгілі
Dialogue: 0,0:00:51.71,0:00:53.38,Default,,0,0,0,,Жақсы түсіндім.Әдетте «Ібіліс кернейі» деген атпен белгілі
Dialogue: 0,0:00:51.71,0:00:53.38,Default,,0,0,0,,Уау
Dialogue: 0,0:00:53.38,0:00:54.30,Default,,0,0,0,,Жақсы түсіндім.Әдетте «Ібіліс кернейі» деген атпен белгілі
Dialogue: 0,0:00:54.38,0:00:55.72,Default,,0,0,0,,Бұл әдемі.
Dialogue: 0,0:00:55.80,0:00:56.89,Default,,0,0,0,,Ген
Dialogue: 0,0:00:56.97,0:00:59.51,Default,,0,0,0,,Сіз оның шын мәнінде не екенін білемін дейсіз бе?
Dialogue: 0,0:00:59.60,0:01:02.14,Default,,0,0,0,,Бұл өлтіретін өсімдік, солай ма? Мен білемін
Dialogue: 0,0:01:02.22,0:01:05.19,Default,,0,0,0,,Әдемі көрінгенімен, улы екені ғажап.
Dialogue: 0,0:01:05.27,0:01:07.98,Default,,0,0,0,,Ол керемет. Ол үйренуге ынталы.
Dialogue: 0,0:01:08.06,0:01:09.82,Default,,0,0,0,,Әкем айтты
Dialogue: 0,0:01:09.90,0:01:10.94,Default,,0,0,0,,Иә
Dialogue: 0,0:01:11.03,0:01:11.98,Default,,0,0,0,,Ах
Dialogue: 0,0:01:16.07,0:01:17.49,Default,,0,0,0,,(Геннің жөтелі)
Dialogue: 0,0:01:17.57,0:01:19.74,Default,,0,0,0,,Бүгін тағы да құрғақ.
Dialogue: 0,0:01:19.83,0:01:22.16,Default,,0,0,0,,Денсаулығым ауыр, ендеше үйге қайтайық.
Dialogue: 0,0:01:22.24,0:01:23.50,Default,,0,0,0,,Иә
Dialogue: 0,0:01:24.46,0:01:27.00,Default,,0,0,0,,Хмм... мм...
Dialogue: 0,0:01:47.52,0:01:49.02,Default,,0,0,0,,Әке, сіз не істеп жатырсыз?
Dialogue: 0,0:01:49.10,0:01:51.52,Default,,0,0,0,,Джин Фудзикоға не болды?
Dialogue: 0,0:01:51.61,0:01:53.53,Default,,0,0,0,,Ах... Уау!
Dialogue: 0,0:01:53.61,0:01:55.53,Default,,0,0,0,,Неліктен не? Бізбен не істеуді жоспарлап отырсыз?
Dialogue: 0,0:01:55.61,0:01:59.03,Default,,0,0,0,,Менің амалым жоқ, Джин, мен енді мұнда қала алмаймын.
Dialogue: 0,0:01:59.11,0:02:02.16,Default,,0,0,0,,Фудзико мен саған Джинді көр деп айттым ғой!
Dialogue: 0,0:02:02.24,0:02:03.54,Default,,0,0,0,,Міне келдік, Рэнди.
Dialogue: 0,0:02:03.62,0:02:05.79,Default,,0,0,0,,Білесің бе?
Dialogue: 0,0:02:05.87,0:02:08.50,Default,,0,0,0,,Фудзико, ұлымды алып қашып кет.
Dialogue: 0,0:02:08.58,0:02:09.54,Default,,0,0,0,,Өзіңді тым жоғары қоя бастадың.
Dialogue: 0,0:02:09.63,0:02:11.92,Default,,0,0,0,,Жан, әке менімен бара алмайды.
Dialogue: 0,0:02:12.00,0:02:14.13,Default,,0,0,0,,Рэнди, өзің жақсысың ба?
Dialogue: 0,0:02:14.21,0:02:16.97,Default,,0,0,0,,А, ең бастысы, ұлым...
Dialogue: 0,0:02:17.05,0:02:19.30,Default,,0,0,0,,Менің жалғыз отбасымды сұра
Dialogue: 0,0:02:19.39,0:02:21.72,Default,,0,0,0,,Жоқ, мен сенімен бірге болғым келеді!
Dialogue: 0,0:02:21.80,0:02:24.35,Default,,0,0,0,,А... Жоқ, Джин.
Dialogue: 0,0:02:24.43,0:02:25.81,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:02:32.57,0:02:34.53,Default,,0,0,0,,Рэнди, асығыңыз.
Dialogue: 0,0:02:34.61,0:02:36.53,Default,,0,0,0,,Мен сені кейінірек міндетті түрде алып кетемін.
Dialogue: 0,0:02:36.61,0:02:37.44,Default,,0,0,0,,Мен осындамын ғой?
Dialogue: 0,0:02:37.53,0:02:39.41,Default,,0,0,0,,Фудзико, егер аман-есен құтыла алсаң
Dialogue: 0,0:02:39.49,0:02:40.74,Default,,0,0,0,,Бір сағаттан кейін осы дүкенде
Dialogue: 0,0:02:41.91,0:02:42.74,Default,,0,0,0,,Хмм
Dialogue: 0,0:02:42.83,0:02:44.83,Default,,0,0,0,,Түсін, Джин.
Dialogue: 0,0:02:46.29,0:02:47.91,Default,,0,0,0,,Өтінемін, Фудзико (Джин)... Уау.
Dialogue: 0,0:02:48.00,0:02:50.50,Default,,0,0,0,,Неліктен? О, жоқ!
Dialogue: 0,0:02:52.79,0:02:54.50,Default,,0,0,0,,Кет (Джин) Уф...
Dialogue: 0,0:02:54.59,0:02:56.76,Default,,0,0,0,,Неге! Неліктен?
Dialogue: 0,0:03:02.09,0:03:03.76,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:03:04.56,0:03:05.76,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:05.85,0:03:07.52,Default,,0,0,0,,Жұмыс
Dialogue: 0,0:03:22.32,0:03:25.66,Default,,0,0,0,,Бинкхэм Келесі кезекте осы жігіт.
Dialogue: 0,0:03:26.33,0:03:27.16,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:03:28.20,0:03:29.46,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:36.09,0:03:37.63,Default,,0,0,0,,Қорқынышты бейбақ.
Dialogue: 0,0:03:38.96,0:03:40.01,Default,,0,0,0,,​​О?
Dialogue: 0,0:03:44.05,0:03:44.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:46.39,0:03:48.52,Default,,0,0,0,,Не? L'Arc
Dialogue: 0,0:03:48.60,0:03:50.98,Default,,0,0,0,,Бәйбіше мен қызметші қашып кетті.
Dialogue: 0,0:03:51.06,0:03:51.89,Default,,0,0,0,,Tsk
Dialogue: 0,0:03:53.98,0:03:55.02,Default,,0,0,0,,Ах
Dialogue: 0,0:03:59.61,0:04:01.28,Default,,0,0,0,,Ақшаның қайда екенін айт
Dialogue: 0,0:04:01.36,0:04:03.41,Default,,0,0,0,,Мен ештеңе білмеймін!
Dialogue: 0,0:04:04.32,0:04:05.16,Default,,0,0,0,,Уф
Dialogue: 0,0:04:10.00,0:04:11.16,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:13.46,0:04:15.67,Default,,0,0,0,,Мен қарғысқа ұшырадым
Dialogue: 0,0:04:15.75,0:04:18.00,Default,,0,0,0,,Арх! Уф...
Dialogue: 0,0:04:18.50,0:04:19.67,Default,,0,0,0,,Ах
Dialogue: 0,0:04:19.76,0:04:21.76,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:27.01,0:04:30.18,Default,,0,0,0,,Арх... арх... арх!
Dialogue: 0,0:04:30.27,0:04:31.48,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:32.89,0:04:34.85,Default,,0,0,0,,Гррр... Ааа!
Dialogue: 0,0:04:36.44,0:04:37.52,Default,,0,0,0,,Я...
Dialogue: 0,0:04:38.61,0:04:39.57,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:41.19,0:04:42.32,Default,,0,0,0,,Уф
Dialogue: 0,0:04:44.70,0:04:45.91,Default,,0,0,0,,Гррр…
Dialogue: 0,0:04:47.32,0:04:49.62,Default,,0,0,0,,Ха... ха-ха
Dialogue: 0,0:04:52.66,0:04:54.87,Default,,0,0,0,,Джин, мені кешіріңіз.
Dialogue: 0,0:04:56.13,0:04:57.42,Default,,0,0,0,,Бұл не өзі?!
Dialogue: 0,0:05:01.09,0:05:02.51,Default,,0,0,0,,Уау! (Карла) Уф!
Dialogue: 0,0:05:02.59,0:05:04.22,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:05:04.30,0:05:07.51,Default,,0,0,0,,Әке? Қайтып кел, Фудзико!
Dialogue: 0,0:05:07.59,0:05:09.01,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:10.35,0:05:11.64,Default,,0,0,0,,Ммм
Dialogue: 0,0:05:16.69,0:05:18.23,Default,,0,0,0,,Ақша қайда?
Dialogue: 0,0:05:20.07,0:05:22.48,Default,,0,0,0,,Ол құсу алдында қайтыс болды.
Dialogue: 0,0:05:23.78,0:05:25.24,Default,,0,0,0,,Хмм…
Dialogue: 0,0:05:26.03,0:05:27.74,Default,,0,0,0,,Жылдық сату көлемі 1 млрд доллар?
Dialogue: 0,0:05:28.32,0:05:30.83,Default,,0,0,0,,Бұл өте табысты компания.
Dialogue: 0,0:05:30.91,0:05:32.87,Default,,0,0,0,,«Кодсыз тау-кен өндіру»
Dialogue: 0,0:05:32.95,0:05:36.17,Default,,0,0,0,,Негізінен Оңтүстік Америкада алтын өндіретін тау-кен компаниясы.
Dialogue: 0,0:05:36.25,0:05:39.50,Default,,0,0,0,,Оның сахнаның артындағы өте жаман істерге қатысы бар деген қауесет бар.
Dialogue: 0,0:05:40.09,0:05:42.09,Default,,0,0,0,,Бәсекелес компанияның басшысын өлтіру
Dialogue: 0,0:05:42.17,0:05:46.76,Default,,0,0,0,,Олар полицияға ірі көлемде пара беріп, оқиғаны жасырып жатқан көрінеді.
Dialogue: 0,0:05:47.38,0:05:51.10,Default,,0,0,0,,Ондай адамдарға аяушылықтың керегі жоқ.
Dialogue: 0,0:05:55.93,0:05:57.19,Default,,0,0,0,,Мен саған кофе әкелдім.
Dialogue: 0,0:05:57.27,0:05:58.10,Default,,0,0,0,,Хмм
Dialogue: 0,0:05:58.19,0:05:59.90,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:06:03.03,0:06:03.86,Default,,0,0,0,,(Есік ашылған дыбыс) (Recovery Girl) Қарым-қатынас дағдылары
Dialogue: 0,0:06:09.07,0:06:11.49,Default,,0,0,0,,Фу~тто (өлшемді) Еңбегіңізге рахмет.
Dialogue: 0,0:06:12.33,0:06:13.99,Default,,0,0,0,,L'Arc баяндамасы
Dialogue: 0,0:06:14.08,0:06:15.87,Default,,0,0,0,,Рэнди қайтыс болды.
Dialogue: 0,0:06:16.37,0:06:18.42,Default,,0,0,0,,Мен оған бәрібір.
Dialogue: 0,0:06:18.50,0:06:20.46,Default,,0,0,0,,Ақша өндірілді ме?
Dialogue: 0,0:06:20.54,0:06:23.50,Default,,0,0,0,,Барлық дәлелдер жойылды.
Dialogue: 0,0:06:24.09,0:06:26.30,Default,,0,0,0,,Ол қанша ақша жымқырды деп ойлайсыз?
Dialogue: 0,0:06:26.38,0:06:27.30,Default,,0,0,0,,500 миллион доллар.
Dialogue: 0,0:06:27.38,0:06:29.01,Default,,0,0,0,,Эй, 500 миллион.
Dialogue: 0,0:06:29.09,0:06:30.55,Default,,0,0,0,,Мен енді жылап жібергім келеді!
Dialogue: 0,0:06:30.64,0:06:33.14,Default,,0,0,0,,Бұл мен таппауға шамасы келмейтін сома.
Dialogue: 0,0:06:33.22,0:06:34.68,Default,,0,0,0,,Рэндидің жалғыз ұлы
Dialogue: 0,0:06:34.77,0:06:37.39,Default,,0,0,0,,Шамасы ол қызметшімен қашып кеткен.
Dialogue: 0,0:06:37.48,0:06:40.31,Default,,0,0,0,,Мүмкін біз қандай да бір анықтамалар таба аламыз.
Dialogue: 0,0:06:40.40,0:06:41.73,Default,,0,0,0,,Қызметші?
Dialogue: 0,0:06:41.81,0:06:43.98,Default,,0,0,0,,Менікі: Мен Фудзико есімді әйелмін.
Dialogue: 0,0:06:45.36,0:06:46.78,Default,,0,0,0,,Сіз Фудзико дедіңіз бе?
Dialogue: 0,0:06:46.86,0:06:50.28,Default,,0,0,0,,Мин Фуджиконы айтқаныңызға сенімдімін.
Dialogue: 0,0:06:50.36,0:06:53.62,Default,,0,0,0,,Ол әлі де жылдам әйел.
Dialogue: 0,0:06:58.62,0:07:01.79,Default,,0,0,0,,Әй, әке қашан келеді?
Dialogue: 0,0:07:01.88,0:07:03.29,Default,,0,0,0,,Я...
Dialogue: 0,0:07:03.84,0:07:06.92,Default,,0,0,0,,Белгіленген уақыттан бір сағат өтті.
Dialogue: 0,0:07:07.01,0:07:08.38,Default,,0,0,0,,Ол енді келмеуі мүмкін.
Dialogue: 0,0:07:08.47,0:07:09.55,Default,,0,0,0,,Неліктен не?
Dialogue: 0,0:07:10.22,0:07:14.05,Default,,0,0,0,,Мүмкін ол дәлелдемелерді жоюға дайындалған жарылғыш заттарға түсіп қалған шығар.
Dialogue: 0,0:07:14.14,0:07:17.56,Default,,0,0,0,,Бұл өтірік! Әкем мені алып кетуге міндетті түрде келетінін айтты!
Dialogue: 0,0:07:22.40,0:07:23.81,Default,,0,0,0,,Рэнди қайтыс болды
Dialogue: 0,0:07:23.90,0:07:24.82,Default,,0,0,0,,Ха…
Dialogue: 0,0:07:30.20,0:07:32.20,Default,,0,0,0,,Джин, көлікке жүгір.
Dialogue: 0,0:07:32.28,0:07:33.82,Default,,0,0,0,,Уф... (Фудзико) Эй.
Dialogue: 0,0:07:33.91,0:07:35.28,Default,,0,0,0,,Ген!
Dialogue: 0,0:07:36.45,0:07:37.83,Default,,0,0,0,,Ақша қайда?
Dialogue: 0,0:07:38.58,0:07:39.96,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:07:40.04,0:07:43.83,Default,,0,0,0,,Енді мұны білген Рэнди өлді, 500 миллион доллар қараңғыда.
Dialogue: 0,0:07:45.13,0:07:46.59,Default,,0,0,0,,Ха!
Dialogue: 0,0:07:48.17,0:07:49.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:49.59,0:07:51.18,Default,,0,0,0,,Ақша қайда?
Dialogue: 0,0:07:51.26,0:07:52.09,Default,,0,0,0,,Уф
Dialogue: 0,0:07:55.68,0:07:56.56,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:56.64,0:07:57.35,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:07:59.39,0:08:01.10,Default,,0,0,0,,Мен қарғысқа ұшырадым
Dialogue: 0,0:08:01.19,0:08:02.31,Default,,0,0,0,,Ах
Dialogue: 0,0:08:05.27,0:08:06.11,Default,,0,0,0,,Қарғыс?
Dialogue: 0,0:08:07.32,0:08:09.11,Default,,0,0,0,,Ақша қайда?
Dialogue: 0,0:08:09.19,0:08:11.86,Default,,0,0,0,,Банктік сейф
Dialogue: 0,0:08:11.95,0:08:15.12,Default,,0,0,0,,Ха! Сіздің PIN нөміріңіз қандай?
Dialogue: 0,0:08:15.70,0:08:17.62,Default,,0,0,0,,PIN нөмірі...
Dialogue: 0,0:08:17.70,0:08:19.41,Default,,0,0,0,,Сөйлеме!
Dialogue: 0,0:08:22.87,0:08:25.00,Default,,0,0,0,,Джин, жақсысың ба? Мықты болыңыз
Dialogue: 0,0:08:25.08,0:08:26.13,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:08:26.96,0:08:28.38,Default,,0,0,0,,Барайық
Dialogue: 0,0:08:34.13,0:08:35.72,Default,,0,0,0,,Уф, уф... (Фудзико) Ах.
Dialogue: 0,0:08:36.22,0:08:37.35,Default,,0,0,0,,Ген
Dialogue: 0,0:08:38.47,0:08:39.43,Default,,0,0,0,,Ха…
Dialogue: 0,0:08:39.97,0:08:40.89,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:08:40.97,0:08:42.14,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:45.69,0:08:47.36,Default,,0,0,0,,Люпин! Неге мұндасың?
Dialogue: 0,0:08:47.44,0:08:49.90,Default,,0,0,0,,Өзіңізбен бірге балаларды әкелу әдеттен тыс емес пе?
Dialogue: 0,0:08:49.98,0:08:52.65,Default,,0,0,0,,Мен асығып тұрмын. Жуықта көріскенше.
Dialogue: 0,0:08:53.24,0:08:55.45,Default,,0,0,0,,Ой, қозғалма!
Dialogue: 0,0:08:55.53,0:08:58.41,Default,,0,0,0,,Әйелдер мен балалармен қарым-қатынаста ол әлі жетілмеген бейбақ.
Dialogue: 0,0:08:58.49,0:08:59.91,Default,,0,0,0,,(көлік есігінің ашылған дыбысы)
Dialogue: 0,0:08:59.99,0:09:02.16,Default,,0,0,0,,(Джиннің ауыр тыныс алуы)
Dialogue: 0,0:09:12.84,0:09:14.42,Default,,0,0,0,,(саусақ ысқырығы)
Dialogue: 0,0:09:19.35,0:09:21.39,Default,,0,0,0,,Менің ұлым мойындамақ болды ма?
Dialogue: 0,0:09:21.47,0:09:24.69,Default,,0,0,0,,Иә, 500 миллион доллар жасырылған сейфтің PIN коды.
Dialogue: 0,0:09:24.77,0:09:26.40,Default,,0,0,0,,Менің ұлым білетін сияқты.
Dialogue: 0,0:09:26.48,0:09:27.81,Default,,0,0,0,,Сен ақымақсың ба?
Dialogue: 0,0:09:27.90,0:09:30.94,Default,,0,0,0,,Білсең, міндетті түрде ұлыңнан біл.
Dialogue: 0,0:09:31.02,0:09:34.19,Default,,0,0,0,,Сондықтан мен Бинкэмді жібердім.
Dialogue: 0,0:09:34.28,0:09:36.45,Default,,0,0,0,,Оны не болса да тауып, құстырыңыз.
Dialogue: 0,0:09:37.20,0:09:38.45,Default,,0,0,0,,Таку
Dialogue: 0,0:09:43.00,0:09:44.20,Default,,0,0,0,,Мұны ішіңіз
Dialogue: 0,0:09:48.17,0:09:49.58,Default,,0,0,0,,Үзіліс жасаңыз
Dialogue: 0,0:09:50.92,0:09:51.84,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:09:51.92,0:09:55.09,Default,,0,0,0,,Мен сені құтқаруға тырыссам да, сен өлетін шығарсың деп ойлаймын.
Dialogue: 0,0:09:55.17,0:09:58.09,Default,,0,0,0,,Жарайды, тез басылып кетесің.
Dialogue: 0,0:10:06.73,0:10:07.98,Default,,0,0,0,,Фудзико
Dialogue: 0,0:10:08.06,0:10:10.73,Default,,0,0,0,,Сен неге ол баламен біргесің?
Dialogue: 0,0:10:10.81,0:10:12.98,Default,,0,0,0,,Қызметші ретінде.
Dialogue: 0,0:10:13.07,0:10:14.48,Default,,0,0,0,,Мен ойымды өзгерттім
Dialogue: 0,0:10:14.57,0:10:17.74,Default,,0,0,0,,Ха, әзілге айналдырсаң күлкілі емес.
Dialogue: 0,0:10:17.82,0:10:20.16,Default,,0,0,0,,Ол баланың жүрегінде ақау бар.
Dialogue: 0,0:10:20.24,0:10:22.95,Default,,0,0,0,,Сондықтан мен саған қамқормын.
Dialogue: 0,0:10:23.04,0:10:27.41,Default,,0,0,0,,Сол ауру баланың әкесі Codfree Mining компаниясының есепшісі.
Dialogue: 0,0:10:27.50,0:10:31.50,Default,,0,0,0,,Оның компаниядан 500 миллион доллар жымқыруы жай ғана кездейсоқтық па?
Dialogue: 0,0:10:32.42,0:10:33.50,Default,,0,0,0,,Неге олай істедің...
Dialogue: 0,0:10:34.13,0:10:37.22,Default,,0,0,0,,Біз де солай ойлайтын сияқтымыз, Фудзико.
Dialogue: 0,0:10:37.30,0:10:38.22,Default,,0,0,0,,Бұл
Dialogue: 0,0:10:38.30,0:10:41.43,Default,,0,0,0,,Сіз де сол компанияның ақшасының артынан жүрдіңіз ғой, солай емес пе?
Dialogue: 0,0:10:41.51,0:10:44.06,Default,,0,0,0,,Бірақ бұл Рэнди де есепші.
Dialogue: 0,0:10:44.77,0:10:47.89,Default,,0,0,0,,Қандай батыл бейбақ. 500 миллион деген үлкен ақша.
Dialogue: 0,0:10:47.98,0:10:49.94,Default,,0,0,0,,Ұлым үшін
Dialogue: 0,0:10:50.02,0:10:53.32,Default,,0,0,0,,Геннің жүрегін ауыстыруға арналған хирургиялық шығындар
Dialogue: 0,0:10:55.73,0:10:59.20,Default,,0,0,0,,Ал қашып жүрген өмірімді қаржыландыру үшін.
Dialogue: 0,0:11:00.20,0:11:01.91,Default,,0,0,0,,Хмм... аа...
Dialogue: 0,0:11:02.70,0:11:05.04,Default,,0,0,0,,Әй балам, ояусың ба?
Dialogue: 0,0:11:05.74,0:11:09.04,Default,,0,0,0,,Ағай кім? Неліктен мылтығың бар?
Dialogue: 0,0:11:09.92,0:11:12.17,Default,,0,0,0,,Балаға білудің қажеті жоқ.
Dialogue: 0,0:11:12.71,0:11:14.54,Default,,0,0,0,,Ағай (көлемді) Бұл не?
Dialogue: 0,0:11:16.00,0:11:17.30,Default,,0,0,0,,О, керемет естіледі!
Dialogue: 0,0:11:17.38,0:11:18.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:20.43,0:11:23.60,Default,,0,0,0,,Бухгалтер өлсе, 500 миллион долларға не болады?
Dialogue: 0,0:11:23.68,0:11:27.77,Default,,0,0,0,,Келіңіздер ме? Мен сейфтің құпия сөзін білмеймін.
Dialogue: 0,0:11:27.85,0:11:29.31,Default,,0,0,0,,Менің бас тартудан басқа амалым жоқ.
Dialogue: 0,0:11:29.89,0:11:32.56,Default,,0,0,0,,Сіз тым тез берілесіз, солай емес пе?
Dialogue: 0,0:11:32.65,0:11:35.73,Default,,0,0,0,,Олай емес сияқты, хмм?
Dialogue: 0,0:11:36.40,0:11:38.32,Default,,0,0,0,,Олай емес сияқты (Фудзико/Люпин)?
Dialogue: 0,0:11:38.99,0:11:41.07,Default,,0,0,0,,Кішкентай клиент қоңырау шалып жатыр.
Dialogue: 0,0:11:41.82,0:11:43.03,Default,,0,0,0,,Сұраныс?
Dialogue: 0,0:11:45.41,0:11:48.08,Default,,0,0,0,,Менің әкемнің кекін алуыңды қалаймын.
Dialogue: 0,0:11:48.16,0:11:49.58,Default,,0,0,0,,Жау дегеніміз не...
Dialogue: 0,0:11:51.04,0:11:53.08,Default,,0,0,0,,Сіз бұрынғы адам туралы айтып отырсыз ба?
Dialogue: 0,0:11:53.17,0:11:56.59,Default,,0,0,0,,Ол әкемді алып кетті...
Dialogue: 0,0:11:56.67,0:11:59.26,Default,,0,0,0,,Егер ол осында болмаса, әкем...
Dialogue: 0,0:11:59.92,0:12:02.34,Default,,0,0,0,,Әкем өлген жоқ!
Dialogue: 0,0:12:02.43,0:12:03.59,Default,,0,0,0,,(Джин жылады)
Dialogue: 0,0:12:04.18,0:12:07.22,Default,,0,0,0,,Сыйақы – бұл сейфтің PIN нөмірі.
Dialogue: 0,0:12:07.31,0:12:09.98,Default,,0,0,0,,Ха... Жоқ, Джин.
Dialogue: 0,0:12:10.06,0:12:12.98,Default,,0,0,0,,Иә? Неге сонша уайымдайсың? Фудзико
Dialogue: 0,0:12:13.06,0:12:15.48,Default,,0,0,0,,А... Мен асықпаймын.
Dialogue: 0,0:12:15.56,0:12:19.73,Default,,0,0,0,,Түсіндім, мына балада 500 миллион доллардың кілті бар.
Dialogue: 0,0:12:19.82,0:12:22.49,Default,,0,0,0,,Мұндай баланың білуі мүмкін емес.
Dialogue: 0,0:12:22.57,0:12:25.03,Default,,0,0,0,,Мен білемін, өтінемін!
Dialogue: 0,0:12:25.12,0:12:27.49,Default,,0,0,0,,Пападан кек алыңыз! (Фудзико) Джин!
Dialogue: 0,0:12:27.58,0:12:30.79,Default,,0,0,0,,Сейф туралы әңгіме рас болса керек.
Dialogue: 0,0:12:30.87,0:12:34.08,Default,,0,0,0,,500 миллион доллар.
Dialogue: 0,0:12:34.17,0:12:35.75,Default,,0,0,0,,Оны қабылдамайтын адам жоқ, Люпин.
Dialogue: 0,0:12:36.33,0:12:38.34,Default,,0,0,0,,Джин Сіз байсалдысыз ба?
Dialogue: 0,0:12:38.42,0:12:39.25,Default,,0,0,0,,Иә
Dialogue: 0,0:12:39.34,0:12:42.34,Default,,0,0,0,,Жарайды, егер солай шешсең, тез сөйлесейік.
Dialogue: 0,0:12:42.42,0:12:44.01,Default,,0,0,0,,Фудзико, оны бала сұрады.
Dialogue: 0,0:12:44.09,0:12:46.22,Default,,0,0,0,,Ей, өзің шешпе.
Dialogue: 0,0:12:46.30,0:12:48.39,Default,,0,0,0,,Люпин! Өлшем...
Dialogue: 0,0:12:48.39,0:12:48.81,Default,,0,0,0,,Люпин! Өлшем...
Dialogue: 0,0:12:48.39,0:12:48.81,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:12:48.81,0:12:48.89,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:12:48.89,0:12:50.39,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:12:48.89,0:12:50.39,Default,,0,0,0,,Ммм
Dialogue: 0,0:12:50.39,0:12:52.52,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:12:56.40,0:12:57.48,Default,,0,0,0,,Кеңестер?
Dialogue: 0,0:12:57.56,0:13:00.98,Default,,0,0,0,,Иә, маған анонимді қоңырау шалды, олар Рэндидің ұлын көрді.
Dialogue: 0,0:13:01.07,0:13:02.36,Default,,0,0,0,,Бұл еркелік пе?
Dialogue: 0,0:13:02.44,0:13:04.95,Default,,0,0,0,,Маған бұл еркелік пе, жоқ па бәрібір.
Dialogue: 0,0:13:05.03,0:13:07.24,Default,,0,0,0,,Бинкэмге оны дереу тексертіңіз.
Dialogue: 0,0:13:07.32,0:13:08.74,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:13:09.95,0:13:12.70,Default,,0,0,0,,(Люпиннің гуілдеуі)
Dialogue: 0,0:13:12.79,0:13:14.87,Default,,0,0,0,,Джиген Мықты болыңыз.
Dialogue: 0,0:13:14.96,0:13:17.38,Default,,0,0,0,,Әй, бұл оңай.
Dialogue: 0,0:13:20.80,0:13:24.38,Default,,0,0,0,,Әй... Баланы жем ретінде пайдалану біртүрлі.
Dialogue: 0,0:13:24.97,0:13:27.89,Default,,0,0,0,,Әкемнің кекін алғанша, жақсы боламын.
Dialogue: 0,0:13:28.60,0:13:31.56,Default,,0,0,0,,Әкең қайтыс болғанда қайғырғаныңды білемін, бірақ
Dialogue: 0,0:13:31.64,0:13:35.64,Default,,0,0,0,,Махаббаттан 500 миллион долларды босату ақымақтық болар еді.
Dialogue: 0,0:13:35.73,0:13:37.35,Default,,0,0,0,,Өзіңді тым жоғары қоя бастадың.
Dialogue: 0,0:13:38.44,0:13:40.57,Default,,0,0,0,,Өткенді ұмытыңыз.
Dialogue: 0,0:13:40.65,0:13:42.90,Default,,0,0,0,,Ол тек өміріңді улайды.
Dialogue: 0,0:13:43.86,0:13:46.70,Default,,0,0,0,,Мен сені қорғаймын.
Dialogue: 0,0:13:46.78,0:13:49.28,Default,,0,0,0,,Мен сіздің операцияңызды да ұйымдастырамын.
Dialogue: 0,0:13:49.95,0:13:51.49,Default,,0,0,0,,Мен сенің анаң боламын.
Dialogue: 0,0:13:51.58,0:13:52.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:52.49,0:13:54.79,Default,,0,0,0,,Ендеше мен үшін кек алғыңыз келмесін...
Dialogue: 0,0:13:54.87,0:13:57.29,Default,,0,0,0,,500 миллион долларға алыс елге қашу.
Dialogue: 0,0:13:57.37,0:14:00.92,Default,,0,0,0,,Бізді алдауға тырыссаң да, ол нәтиже бермейді, Фудзико.
Dialogue: 0,0:14:01.00,0:14:04.30,Default,,0,0,0,,Анаңызға PIN нөмірін айта аласыз ба?
Dialogue: 0,0:14:04.38,0:14:05.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:05.67,0:14:07.68,Default,,0,0,0,,Сәлем? (Джин) Хмм...
Dialogue: 0,0:14:10.01,0:14:11.43,Default,,0,0,0,,Рэнди қайтыс болды
Dialogue: 0,0:14:12.51,0:14:15.27,Default,,0,0,0,,Жоқ! Мен міндетті түрде кек аламын!
Dialogue: 0,0:14:15.35,0:14:16.18,Default,,0,0,0,,Фу…
Dialogue: 0,0:14:16.94,0:14:20.52,Default,,0,0,0,,Бұл жолы Фудзиконың да жоспарлары бұзылды.
Dialogue: 0,0:14:20.61,0:14:23.69,Default,,0,0,0,,Жыныстық тартымдылық та, сөйлесу дағдылары да братқа қарсы жұмыс істемейді.
Dialogue: 0,0:14:24.36,0:14:27.45,Default,,0,0,0,,Бұл әйелдің де әлсіз жақтары болды.
Dialogue: 0,0:14:30.57,0:14:31.45,Default,,0,0,0,,Сіз не қарап тұрсыз?
Dialogue: 0,0:14:31.53,0:14:35.54,Default,,0,0,0,,Бұл Фудзико өз пәтеріндегі қоқыс жәшігіне лақтырған жазба.
Dialogue: 0,0:14:35.62,0:14:36.87,Default,,0,0,0,,Бұған не болды?
Dialogue: 0,0:14:36.96,0:14:38.00,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:14:38.08,0:14:39.12,Default,,0,0,0,,Иә? (Өлшем) Не?
Dialogue: 0,0:14:39.21,0:14:41.21,Default,,0,0,0,,Менің көру қабілетім кенет нашарлады.
Dialogue: 0,0:14:41.79,0:14:44.09,Default,,0,0,0,,Уф, бұл құрғақ аймақ.
Dialogue: 0,0:14:44.17,0:14:46.34,Default,,0,0,0,,Мұндай уақытта твиттер жазбаңыз
Dialogue: 0,0:14:46.42,0:14:47.72,Default,,0,0,0,,Эй, бұл ол.
Dialogue: 0,0:14:50.64,0:14:51.80,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:58.02,0:15:00.15,Default,,0,0,0,,(Қонақтар жөтеледі)
Dialogue: 0,0:15:00.23,0:15:02.40,Default,,0,0,0,,Люпин және басқалары, сен не істеп жатырсың?
Dialogue: 0,0:15:02.48,0:15:03.65,Default,,0,0,0,,Ах
Dialogue: 0,0:15:06.61,0:15:08.78,Default,,0,0,0,,Мен қарғысқа ұшырадым
Dialogue: 0,0:15:09.99,0:15:11.99,Default,,0,0,0,,Ха... менің көлігіме жүгір!
Dialogue: 0,0:15:12.07,0:15:12.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:19.37,0:15:20.33,Default,,0,0,0,,Уф
Dialogue: 0,0:15:21.63,0:15:23.59,Default,,0,0,0,,Хмм... уф
Dialogue: 0,0:15:24.42,0:15:25.92,Default,,0,0,0,,Иә! Гррр...
Dialogue: 0,0:15:27.26,0:15:28.34,Default,,0,0,0,,Хмм
Dialogue: 0,0:15:28.42,0:15:29.34,Default,,0,0,0,,Ха…
Dialogue: 0,0:15:31.64,0:15:32.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:32.93,0:15:34.10,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:34.18,0:15:35.10,Default,,0,0,0,,Ах
Dialogue: 0,0:15:35.18,0:15:37.60,Default,,0,0,0,,Танжиро~!
Dialogue: 0,0:15:42.69,0:15:43.86,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:45.77,0:15:47.03,Default,,0,0,0,,Фудзико (джиген) Балалар да бар.
Dialogue: 0,0:15:47.11,0:15:47.94,Default,,0,0,0,,Әй... (Өлшем) Уау
Dialogue: 0,0:15:48.61,0:15:50.70,Default,,0,0,0,,Балалар, мұнда тыныш болуың керек.
Dialogue: 0,0:15:59.16,0:16:01.25,Default,,0,0,0,,Әй, Фудзико, бұрын!
Dialogue: 0,0:16:04.08,0:16:05.00,Default,,0,0,0,,Кеттік (Джин) Уф.
Dialogue: 0,0:16:07.84,0:16:08.51,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:09.67,0:16:10.72,Default,,0,0,0,,Уф
Dialogue: 0,0:16:13.01,0:16:14.51,Default,,0,0,0,,Бұл қауіпті, мен оны жоғалтамын.
Dialogue: 0,0:16:15.10,0:16:17.26,Default,,0,0,0,,Уф, боқ, уф...
Dialogue: 0,0:16:17.35,0:16:20.02,Default,,0,0,0,,Хахаха, ақымақ, мен сені басып тастаймын.
Dialogue: 0,0:16:20.10,0:16:21.77,Default,,0,0,0,,Гррр…
Dialogue: 0,0:16:21.85,0:16:23.52,Default,,0,0,0,,Иә? Бұл ол!
Dialogue: 0,0:16:25.06,0:16:26.82,Default,,0,0,0,,Қайтып келді. Бинкамға жазылыңыз.
Dialogue: 0,0:16:26.90,0:16:27.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:39.79,0:16:42.46,Default,,0,0,0,,Фудзико Ол әлі тірі!
Dialogue: 0,0:16:49.05,0:16:50.71,Default,,0,0,0,,Фудзико! Ол, ол!
Dialogue: 0,0:16:51.51,0:16:52.88,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:54.55,0:16:55.97,Default,,0,0,0,,Ой, уаа, а...
Dialogue: 0,0:16:56.05,0:16:58.10,Default,,0,0,0,,
Dialogue: 0,0:17:00.27,0:17:01.56,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:09.82,0:17:11.23,Default,,0,0,0,,Мен қазір қашып кете аламын.
Dialogue: 0,0:17:12.57,0:17:18.58,Default,,0,0,0,,(деңгейден өтетін бөгет дыбысы)
Dialogue: 0,0:17:21.95,0:17:23.00,Default,,0,0,0,,Уф!
Dialogue: 0,0:17:26.58,0:17:27.75,Default,,0,0,0,,Иә, Юта Отокоцу
Dialogue: 0,0:17:30.09,0:17:31.76,Default,,0,0,0,,Күте тұрыңыз! (Джин) А? Уф...
Dialogue: 0,0:17:34.59,0:17:35.51,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:37.59,0:17:38.34,Default,,0,0,0,,Хмм
Dialogue: 0,0:17:38.34,0:17:39.01,Default,,0,0,0,,Хмм
Dialogue: 0,0:17:38.34,0:17:39.01,Default,,0,0,0,,Керісінше, қанша адам қарғысқа ұшырап өлетінін болжау мүмкін емес.
Dialogue: 0,0:17:39.01,0:17:41.01,Default,,0,0,0,,Керісінше, қанша адам қарғысқа ұшырап өлетінін болжау мүмкін емес.
Dialogue: 0,0:17:42.85,0:17:44.02,Default,,0,0,0,,Уф (Фудзико) Ах...
Dialogue: 0,0:17:55.32,0:17:57.03,Default,,0,0,0,,Фудзико кеніші
Dialogue: 0,0:17:59.62,0:18:02.29,Default,,0,0,0,,Жоғарыдағы жігіт өте табанды, бірдеңе жасаңыз.
Dialogue: 0,0:18:03.08,0:18:05.04,Default,,0,0,0,,Әй, сен жақсы әйел емессің бе?
Dialogue: 0,0:18:05.12,0:18:06.54,Default,,0,0,0,,Иә? Уау
Dialogue: 0,0:18:06.62,0:18:08.04,Default,,0,0,0,,Айда! Угия!
Dialogue: 0,0:18:08.12,0:18:10.54,Default,,0,0,0,,(Люпиннің ыңырсыуы)
Dialogue: 0,0:18:10.63,0:18:12.80,Default,,0,0,0,,Карла Бинкхэм сонда болды.
Dialogue: 0,0:18:12.88,0:18:14.92,Default,,0,0,0,,Ах~ Бұл өте жақсы! Бұл мүлдем жұмыс істемейді
Dialogue: 0,0:18:15.01,0:18:16.55,Default,,0,0,0,,Көбірек күресіңіз!
Dialogue: 0,0:18:16.63,0:18:18.09,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:18.18,0:18:19.59,Default,,0,0,0,,Керісінше, қанша адам қарғысқа ұшырап өлетінін болжау мүмкін емес.
Dialogue: 0,0:18:19.68,0:18:21.60,Default,,0,0,0,,О, бұл…
Dialogue: 0,0:18:25.10,0:18:29.19,Default,,0,0,0,,Саған еш ренішім жоқ, бірақ клиентімнің кекімді аламын.
Dialogue: 0,0:18:30.23,0:18:31.94,Default,,0,0,0,,Бұл әйел кім?
Dialogue: 0,0:18:32.61,0:18:33.82,Default,,0,0,0,,Әй?
Dialogue: 0,0:18:33.90,0:18:36.78,Default,,0,0,0,,Егер сіз Фуджиконы пайдаланғыңыз келсе, бас тартыңыз, досым.
Dialogue: 0,0:18:36.86,0:18:39.45,Default,,0,0,0,,Егер мен саған қарсылас болсам, бұл менің кінәм.
Dialogue: 0,0:18:40.37,0:18:44.08,Default,,0,0,0,,Сіздің қарсылас команданың ішінде емес.
Dialogue: 0,0:18:44.16,0:18:46.16,Default,,0,0,0,,Мен қарғысқа ұшырадым
Dialogue: 0,0:18:47.54,0:18:50.21,Default,,0,0,0,,Қарғыс? Неге еліктейсің?
Dialogue: 0,0:18:52.04,0:18:52.92,Default,,0,0,0,,Уау
Dialogue: 0,0:18:53.00,0:18:56.88,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:18:56.97,0:18:58.47,Default,,0,0,0,,Сіз қаруыңызды тастаңыз
Dialogue: 0,0:18:58.55,0:19:00.13,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:19:00.22,0:19:02.22,Default,,0,0,0,,Уф... Уф
Dialogue: 0,0:19:02.30,0:19:04.93,Default,,0,0,0,,Кетчуппен бүтіндей бүркелген—
Dialogue: 0,0:19:14.73,0:19:17.94,Default,,0,0,0,,Бинкам Оң иығыңыздағы жарадағы қанды тоқтатыңыз.
Dialogue: 0,0:19:18.03,0:19:20.95,Default,,0,0,0,,Енді жаңғақтар жоқ.
Dialogue: 0,0:19:21.03,0:19:22.70,Default,,0,0,0,,Алдымен қан кетуді тоқтату
Dialogue: 0,0:19:23.99,0:19:24.91,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:30.04,0:19:30.96,Default,,0,0,0,,Әй?
Dialogue: 0,0:19:31.88,0:19:32.71,Default,,0,0,0,,Lupine
Dialogue: 0,0:19:38.34,0:19:39.80,Default,,0,0,0,,Сәлем Люпин!
Dialogue: 0,0:19:40.38,0:19:42.39,Default,,0,0,0,,Уф... (Өлшем) Жақсысың ба? Люпин
Dialogue: 0,0:19:42.47,0:19:44.43,Default,,0,0,0,,Өлшем
Dialogue: 0,0:19:44.51,0:19:46.68,Default,,0,0,0,,Көрініс
Dialogue: 0,0:19:46.76,0:19:49.93,Default,,0,0,0,,Бұл қарғысқа ұшыраған сияқты.
Dialogue: 0,0:19:50.02,0:19:52.94,Default,,0,0,0,,Қарғыс? Бұл Бинкхэм бейбақ па?
Dialogue: 0,0:19:53.02,0:19:54.44,Default,,0,0,0,,Біраз уақыт қыдырайық
Dialogue: 0,0:19:54.52,0:19:57.07,Default,,0,0,0,,Не? Сенімен бәрі жақсы ма?
Dialogue: 0,0:20:02.16,0:20:04.62,Default,,0,0,0,,Әй, кек не болды?
Dialogue: 0,0:20:04.70,0:20:05.58,Default,,0,0,0,,Сол жігіт пен оның адамдарының бәрі Стэнд қолданушылары сияқты
Dialogue: 0,0:20:05.66,0:20:07.54,Default,,0,0,0,,Е, неге... осында тұрасың?
Dialogue: 0,0:20:07.62,0:20:08.45,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:20:08.54,0:20:10.79,Default,,0,0,0,,Мотельдер жоқ.
Dialogue: 0,0:20:10.87,0:20:12.58,Default,,0,0,0,,Жарайды, түс. (Джин) Иә~
Dialogue: 0,0:20:19.80,0:20:21.72,Default,,0,0,0,,Маған бөлме бере аласыз ба?
Dialogue: 0,0:20:22.84,0:20:23.68,Default,,0,0,0,,Ата-ана мен бала?
Dialogue: 0,0:20:23.76,0:20:26.14,Default,,0,0,0,,Әй, олар ғашық сияқты ма?
Dialogue: 0,0:20:26.22,0:20:29.60,Default,,0,0,0,,Жоқ... Тіпті ата-аналар мен балалар екі ересек адамның баламасын ала алады.
Dialogue: 0,0:20:29.68,0:20:33.27,Default,,0,0,0,,Әрине, бірақ мен әмиянымды жоғалтып алдым.
Dialogue: 0,0:20:33.35,0:20:34.35,Default,,0,0,0,,Ха…
Dialogue: 0,0:20:34.44,0:20:35.27,Default,,0,0,0,,
Dialogue: 0,0:20:35.36,0:20:38.98,Default,,0,0,0,,Біз алдын ала төлейміз. Бізді мазақ қылғың келсе, басқа жаққа кет.
Dialogue: 0,0:20:39.07,0:20:41.24,Default,,0,0,0,,Бұл сіз төлейтін ақша емес.
Dialogue: 0,0:20:41.32,0:20:42.24,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:43.82,0:20:44.74,Default,,0,0,0,,Ой
Dialogue: 0,0:20:47.53,0:20:48.74,Default,,0,0,0,,Рахмет
Dialogue: 0,0:20:52.25,0:20:55.17,Default,,0,0,0,,Жан, сен де душ қабылдауың керек.
Dialogue: 0,0:20:55.88,0:20:58.13,Default,,0,0,0,,Ақшам жоқ болса да маған қалуға рұқсат еттіңіз бе?
Dialogue: 0,0:20:58.21,0:21:00.51,Default,,0,0,0,,Балалар бұл туралы алаңдамауы керек
Dialogue: 0,0:21:03.59,0:21:04.97,Default,,0,0,0,,Маған тізеңізді көрсетіңіз
Dialogue: 0,0:21:11.27,0:21:12.31,Default,,0,0,0,,Иә
Dialogue: 0,0:21:14.14,0:21:15.06,Default,,0,0,0,,Хмм
Dialogue: 0,0:21:15.81,0:21:16.98,Default,,0,0,0,,(Айзава) Сондықтан мен қабылдау емтиханы логикаға жат дедім
Dialogue: 0,0:21:17.94,0:21:19.36,Default,,0,0,0,,Оған қол тигізбеңіз
Dialogue: 0,0:21:20.07,0:21:21.23,Default,,0,0,0,,Рахмет
Dialogue: 0,0:21:23.15,0:21:27.24,Default,,0,0,0,,Эй Джин, менің ақшам таусылып барады.
Dialogue: 0,0:21:27.32,0:21:30.62,Default,,0,0,0,,Маған сейфтің құпия сөзін айта аласыз ба?
Dialogue: 0,0:21:30.70,0:21:33.41,Default,,0,0,0,,Жоқ, мен әкем үшін кек аламын.
Dialogue: 0,0:21:35.92,0:21:37.17,Default,,0,0,0,,Я...
Dialogue: 0,0:21:38.21,0:21:41.09,Default,,0,0,0,,Ей Джин, тыңда, мықты бол.
Dialogue: 0,0:21:41.17,0:21:42.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:42.30,0:21:44.30,Default,,0,0,0,,Мәңгілік өткенді сүйреп жүре алмаймын
Dialogue: 0,0:21:44.38,0:21:46.13,Default,,0,0,0,,Әйелді еркектер осылай жасайды.
Dialogue: 0,0:21:46.22,0:21:46.88,Default,,0,0,0,,Өзіңді тым жоғары қоя бастадың.
Dialogue: 0,0:21:47.64,0:21:50.60,Default,,0,0,0,,Мен мұны сенің болашағыңды ойлап айтып отырмын.
Dialogue: 0,0:21:51.10,0:21:53.18,Default,,0,0,0,,Мұқият ойлан
Dialogue: 0,0:21:53.27,0:21:55.64,Default,,0,0,0,,Сізге ана керек
Dialogue: 0,0:21:55.73,0:21:58.90,Default,,0,0,0,,Ана? Сіз шынымен ана бола аласыз ба?
Dialogue: 0,0:21:58.98,0:22:02.65,Default,,0,0,0,,Иә, бұл менің рөлім.
Dialogue: 0,0:22:02.73,0:22:05.74,Default,,0,0,0,,Өткенді ұмытып, анаммен бірге өмір сүр.
Dialogue: 0,0:22:05.82,0:22:06.90,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:22:07.74,0:22:09.32,Default,,0,0,0,,Керісінше, ұлым...
Dialogue: 0,0:22:09.41,0:22:12.16,Default,,0,0,0,,Жалғыз отбасымды сұра
Dialogue: 0,0:22:14.25,0:22:16.62,Default,,0,0,0,,Әкем бұл... Әкем...
Dialogue: 0,0:22:16.71,0:22:19.13,Default,,0,0,0,,Бір ғана отбасы болды.
Dialogue: 0,0:22:19.21,0:22:22.17,Default,,0,0,0,,Тіпті ота жасауыма да ақша берді.
Dialogue: 0,0:22:22.25,0:22:23.46,Default,,0,0,0,,Ген
Dialogue: 0,0:22:23.55,0:22:26.13,Default,,0,0,0,,Жоқ! Фудзико ана емес!
Dialogue: 0,0:22:26.22,0:22:29.43,Default,,0,0,0,,Негізі мен ақша үшін әкеме жақындадым!
Dialogue: 0,0:22:29.51,0:22:30.68,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:22:30.76,0:22:33.43,Default,,0,0,0,,Ген! сен енді абдырап қалдың
Dialogue: 0,0:22:33.51,0:22:36.77,Default,,0,0,0,,Өйткені сіз жай ғана қонақүй қызметкерлерін алдадыңыз!
Dialogue: 0,0:22:36.85,0:22:38.14,Default,,0,0,0,,Әкемді де осылай алдадым!
Dialogue: 0,0:22:38.14,0:22:39.52,Default,,0,0,0,,Әкемді де осылай алдадым!
Dialogue: 0,0:22:38.14,0:22:39.52,Default,,0,0,0,,
Dialogue: 0,0:22:39.52,0:22:39.60,Default,,0,0,0,,
Dialogue: 0,0:22:39.60,0:22:41.48,Default,,0,0,0,,
Dialogue: 0,0:22:39.60,0:22:41.48,Default,,0,0,0,,Осындай уақытта... Кім? (Джин) Жібер!
Dialogue: 0,0:22:41.56,0:22:42.73,Default,,0,0,0,,Тынышталыңыз!
Dialogue: 0,0:22:42.82,0:22:44.48,Default,,0,0,0,,Жоқ! (Фудзико) Қазірдің өзінде!
Dialogue: 0,0:22:44.57,0:22:46.69,Default,,0,0,0,,Тұтынушы, не болды?
Dialogue: 0,0:22:46.78,0:22:49.49,Default,,0,0,0,,Әй, менеджер, сіз шуылдадыңыз ба?
Dialogue: 0,0:22:49.57,0:22:51.20,Default,,0,0,0,,Ақаулық - мәселе.
Dialogue: 0,0:22:51.28,0:22:53.53,Default,,0,0,0,,Бұл жай ғана ата-ана мен бала ұрысы, сақ боламын.
Dialogue: 0,0:22:53.62,0:22:55.12,Default,,0,0,0,,Бұл өтірік! Бұл адам менің анам емес!
Dialogue: 0,0:22:55.12,0:22:55.95,Default,,0,0,0,,Бұл өтірік! Бұл адам менің анам емес!
Dialogue: 0,0:22:55.12,0:22:55.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:56.04,0:22:58.37,Default,,0,0,0,,Мені ұрлап кетті! Полицияға хабарласыңыз!
Dialogue: 0,0:22:58.46,0:22:59.29,Default,,0,0,0,,Жоқ—сол қолымды пайдаланбай-ақ ең үздікке айналу арқылы—
Dialogue: 0,0:22:59.29,0:22:59.83,Default,,0,0,0,,Жоқ—сол қолымды пайдаланбай-ақ ең үздікке айналу арқылы—
Dialogue: 0,0:22:59.29,0:22:59.83,Default,,0,0,0,,Маған қазір қоңырау шалыңыз, асығыңыз, асығыңыз!
Dialogue: 0,0:22:59.83,0:22:59.92,Default,,0,0,0,,Маған қазір қоңырау шалыңыз, асығыңыз, асығыңыз!
Dialogue: 0,0:22:59.92,0:23:02.00,Default,,0,0,0,,Маған қазір қоңырау шалыңыз, асығыңыз, асығыңыз!
Dialogue: 0,0:22:59.92,0:23:02.00,Default,,0,0,0,,Келтірілген қолайсыздықтың орнына тұру ақысы төленеді
Dialogue: 0,0:23:02.00,0:23:03.25,Default,,0,0,0,,Келтірілген қолайсыздықтар үшін тұру ақысы төленеді
Dialogue: 0,0:23:03.34,0:23:05.63,Default,,0,0,0,,Мен сізге көп қызмет көрсетемін.
Dialogue: 0,0:23:03.34,0:23:05.63,Default,,0,0,0,,күрсіну...
Dialogue: 0,0:23:07.09,0:23:09.01,Default,,0,0,0,,Мен анаммен тіл табысуым керек.
Dialogue: 0,0:23:14.64,0:23:15.93,Default,,0,0,0,,Уф...
Dialogue: 0,0:23:16.02,0:23:18.18,Default,,0,0,0,,Әй, қой, қой!
Dialogue: 0,0:23:18.27,0:23:20.19,Default,,0,0,0,,Ой... не істеп жатырсың, ақымақ!
Dialogue: 0,0:23:20.77,0:23:22.44,Default,,0,0,0,,Ах, гах... жібер!
Dialogue: 0,0:23:22.52,0:23:24.40,Default,,0,0,0,,Уайымдауды доғар!
Dialogue: 0,0:23:24.48,0:23:26.40,Default,,0,0,0,,Менімен бірге болудан басқа амалың жоқ!
Dialogue: 0,0:23:26.48,0:23:27.99,Default,,0,0,0,,Шулы! Жіберу!
Dialogue: 0,0:23:28.07,0:23:30.15,Default,,0,0,0,,Ауруыңызға да, болашағыңызға да жауаптысыз.
Dialogue: 0,0:23:30.24,0:23:32.53,Default,,0,0,0,,Өздігінен ештеңе істей алмайтын бала!
Dialogue: 0,0:23:32.62,0:23:33.45,Default,,0,0,0,,Түсіндіңіз бе?
Dialogue: 0,0:23:33.53,0:23:35.70,Default,,0,0,0,,Ууууууууууу...
Dialogue: 0,0:23:36.29,0:23:40.21,Default,,0,0,0,,Бізге әуе шабуылы жасалған сияқты.
Dialogue: 0,0:23:40.96,0:23:42.46,Default,,0,0,0,,Сіз нені зерттейсіз? Люпин
Dialogue: 0,0:23:43.21,0:23:46.96,Default,,0,0,0,,Мен Фудзико қызметші болып жұмыс істеген осы үйге қызығамын.
Dialogue: 0,0:23:47.05,0:23:48.97,Default,,0,0,0,,Ол әйел үнемі күдіктенеді.
Dialogue: 0,0:23:52.55,0:23:53.47,Default,,0,0,0,,Хмм...
Dialogue: 0,0:23:53.55,0:23:55.51,Default,,0,0,0,,Бұдан асқан қорқынышты не бар?
Dialogue: 0,0:23:55.60,0:23:59.48,Default,,0,0,0,,Денесінен құм түтінін шығаратын сол қарғыс атқан жігіт.
Dialogue: 0,0:23:59.56,0:24:00.73,Default,,0,0,0,,О
Dialogue: 0,0:24:01.31,0:24:03.73,Default,,0,0,0,,Мазасыз өтінішім бар.
Dialogue: 0,0:24:03.81,0:24:04.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:08.28,0:24:11.36,Default,,0,0,0,,Қазірдің өзінде! Қосымша жұмыс қоспаңыз
Dialogue: 0,0:24:11.86,0:24:13.49,Default,,0,0,0,,Мен осы жерден кетемін.
Dialogue: 0,0:24:13.57,0:24:16.03,Default,,0,0,0,,Шынымен де, бәрі ақшада, солай ма?
Dialogue: 0,0:24:16.12,0:24:17.70,Default,,0,0,0,,Бұл дұрыс болуы мүмкін емес.
Dialogue: 0,0:24:17.79,0:24:20.20,Default,,0,0,0,,Мен тек сені уайымдап отырмын.
Dialogue: 0,0:24:20.83,0:24:24.25,Default,,0,0,0,,Менің уақытым жоқ, жарай ма? сізде екі таңдау бар
Dialogue: 0,0:24:24.33,0:24:26.21,Default,,0,0,0,,Осы жерден кетіп, анаммен тұрамыз ба?
Dialogue: 0,0:24:26.29,0:24:29.46,Default,,0,0,0,,Сіз полицияның қорғауымен жалғыз аман қаласыз ба?
Dialogue: 0,0:24:30.38,0:24:32.55,Default,,0,0,0,,Бір ғана жауап бар, солай ма?
Dialogue: 0,0:24:33.43,0:24:35.22,Default,,0,0,0,,кеттік (Джин)
Dialogue: 0,0:24:35.30,0:24:36.39,Default,,0,0,0,,Ха…
Dialogue: 0,0:24:36.97,0:24:38.10,Default,,0,0,0,,Өзі ешқашан Ал Майтты басып оза алмайтынын түсінген әкем—
Dialogue: 0,0:24:39.06,0:24:39.89,Default,,0,0,0,,Ах
Dialogue: 0,0:24:40.56,0:24:44.10,Default,,0,0,0,,Бұл полиция. Сізбен бір сәт сөйлессем бола ма?
Dialogue: 0,0:24:47.82,0:24:49.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:49.86,0:24:50.94,Default,,0,0,0,,Хмм
Dialogue: 0,0:24:54.07,0:24:54.91,Default,,0,0,0,,Иә
Dialogue: 0,0:25:18.89,0:25:20.93,Default,,0,0,0,,Бала, сен жалғызсың ба?
Dialogue: 0,0:25:21.43,0:25:22.68,Default,,0,0,0,,Иә
Dialogue: 0,0:25:26.31,0:25:28.19,Default,,0,0,0,,Міне, балалар
Dialogue: 0,0:25:47.46,0:25:49.04,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:25:50.46,0:25:52.34,Default,,0,0,0,,Неліктен полиция мұнда?
Dialogue: 0,0:25:56.38,0:25:59.80,Default,,0,0,0,,Сіз келдіңіз. Мен сізге бұл туралы толығырақ айтып беремін. Өтінемін, түсіңіз.
Dialogue: 0,0:26:00.39,0:26:02.56,Default,,0,0,0,,Иә? иә
Dialogue: 0,0:26:23.08,0:26:28.08,Default,,0,0,0,,♪~
Dialogue: 0,0:26:58.74,0:27:03.74,Default,,0,0,0,,~♪
Dialogue: 0,0:27:08.25,0:27:09.17,Default,,0,0,0,,Төмен түс.
Dialogue: 0,0:27:09.25,0:27:10.92,Default,,0,0,0,,Хмм… Иә.
Dialogue: 0,0:27:12.17,0:27:13.96,Default,,0,0,0,,Тыныш болыңыз және тыңдаңыз
Dialogue: 0,0:27:14.05,0:27:15.42,Default,,0,0,0,,Әйтпесе, сіз зардап шегесіз.
Dialogue: 0,0:27:15.50,0:27:16.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:27:16.67,0:27:17.51,Default,,0,0,0,,Сәлем
Dialogue: 0,0:27:19.51,0:27:20.38,Default,,0,0,0,,Егер сол күйді сақтай отырып қозғалсам…
Dialogue: 0,0:27:21.05,0:27:21.89,Default,,0,0,0,,Ha
Dialogue: 0,0:27:24.72,0:27:27.43,Default,,0,0,0,,Қолдарыңызды жайлап көтеріп, алға қадам жасаңыз.
Dialogue: 0,0:27:31.10,0:27:32.10,Default,,0,0,0,,Ах
Dialogue: 0,0:27:45.41,0:27:48.87,Default,,0,0,0,,Люпин Қараңызшы, бұл Фудзиконың көлігі емес пе?
Dialogue: 0,0:27:48.95,0:27:51.67,Default,,0,0,0,,Бинго, мен бұл баланың да екеніне сенімдімін.
Dialogue: 0,0:27:59.09,0:28:00.97,Default,,0,0,0,,жеке куәлік
Dialogue: 0,0:28:04.43,0:28:05.89,Default,,0,0,0,,Ең сол жаққа өтіңіз
Dialogue: 0,0:28:05.97,0:28:07.26,Default,,0,0,0,,Айо
Dialogue: 0,0:28:08.85,0:28:09.98,Default,,0,0,0,,Иә
Dialogue: 0,0:28:11.02,0:28:14.52,Default,,0,0,0,,Президент, PIN кодқа ұқсайтын жазбаны еш жерден таба алмаймын.
Dialogue: 0,0:28:14.61,0:28:15.86,Default,,0,0,0,,Хмм…
Dialogue: 0,0:28:16.36,0:28:18.53,Default,,0,0,0,,Бұл өте нашар компания.
Dialogue: 0,0:28:18.61,0:28:23.03,Default,,0,0,0,,Олар ақша үшін бәрін жасайды, тіпті полицияға пара береді.
Dialogue: 0,0:28:27.28,0:28:29.04,Default,,0,0,0,,Маған айтқаныңды қаламаймын.
Dialogue: 0,0:28:29.12,0:28:30.58,Default,,0,0,0,,Ақшаға тәуелді қызметші
Dialogue: 0,0:28:30.66,0:28:31.50,Default,,0,0,0,,Ах!
Dialogue: 0,0:28:32.16,0:28:33.92,Default,,0,0,0,,Жымқырылған ақшаны қалай өндіріп алуға болады
Dialogue: 0,0:28:34.00,0:28:35.50,Default,,0,0,0,,Бұл анық.
Dialogue: 0,0:28:35.58,0:28:36.50,Default,,0,0,0,,Мынаны қараңыз
Dialogue: 0,0:28:36.59,0:28:40.51,Default,,0,0,0,,Біздің компанияның бір күнде жылжытатын сомасы - 5 миллион доллар.
Dialogue: 0,0:28:40.59,0:28:42.51,Default,,0,0,0,,Біздің ақша әлемді жылжытады
Dialogue: 0,0:28:42.59,0:28:45.43,Default,,0,0,0,,Дүние деп айту көп.
Dialogue: 0,0:28:45.51,0:28:47.22,Default,,0,0,0,,Хмф... Ген
Dialogue: 0,0:28:47.30,0:28:51.27,Default,,0,0,0,,Сенің әкең ақшамызды ұрлап, жасырып қалды.
Dialogue: 0,0:28:51.35,0:28:54.23,Default,,0,0,0,,Әкеңнің ұры болғанын қаламас едің, солай ма?
Dialogue: 0,0:28:54.31,0:28:58.27,Default,,0,0,0,,Сіз жақсы мен бұрысты айыра алатын жастасыз, солай ма?
Dialogue: 0,0:28:58.36,0:28:59.28,Default,,0,0,0,,Хмм
Dialogue: 0,0:28:59.36,0:29:02.28,Default,,0,0,0,,Сіз бізге ақшамызды қайтарасыз, солай ма?
Dialogue: 0,0:29:03.20,0:29:06.03,Default,,0,0,0,,Маған ұнамайды. Мен сол ақшамен кек аламын.
Dialogue: 0,0:29:07.99,0:29:10.45,Default,,0,0,0,,Уф! (Фудзико) Эй... аа
Dialogue: 0,0:29:10.54,0:29:11.41,Default,,0,0,0,,Тыныш бол
Dialogue: 0,0:29:12.08,0:29:14.17,Default,,0,0,0,,Карла Бинкэмді ояту.
Dialogue: 0,0:29:14.25,0:29:15.42,Default,,0,0,0,,Иә
Dialogue: 0,0:29:20.25,0:29:22.30,Default,,0,0,0,,(дыбыс құлпын ашу)
Dialogue: 0,0:29:28.14,0:29:29.43,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:29:31.31,0:29:32.43,Default,,0,0,0,,Олар бақытты өмір сүруге құқылы
Dialogue: 0,0:29:51.49,0:29:52.37,Default,,0,0,0,,Маған көбірек беріңіз
Dialogue: 0,0:29:53.58,0:29:54.87,Default,,0,0,0,,Бұл жеткілікті
Dialogue: 0,0:29:58.21,0:29:59.38,Default,,0,0,0,,Хмм
Dialogue: 0,0:29:59.46,0:30:00.92,Default,,0,0,0,,Арх! Сен не істеп жатырсың?
Dialogue: 0,0:30:01.00,0:30:03.09,Default,,0,0,0,,Бұл... жібер!
Dialogue: 0,0:30:03.88,0:30:05.84,Default,,0,0,0,,Уау! Уф
Dialogue: 0,0:30:05.93,0:30:07.38,Default,,0,0,0,,Рэнди де Рэнди.
Dialogue: 0,0:30:08.14,0:30:10.60,Default,,0,0,0,,Үндемей, ақшаны санасаң болғаны.
Dialogue: 0,0:30:10.68,0:30:15.14,Default,,0,0,0,,Ол компанияның ақшасымен араласып, содан кейін ит сияқты өлді.
Dialogue: 0,0:30:15.73,0:30:18.65,Default,,0,0,0,,Бинкам, тезірек маған PIN нөмірімді беруге мәжбүр етемін.
Dialogue: 0,0:30:24.74,0:30:25.99,Default,,0,0,0,,Уау
Dialogue: 0,0:30:26.07,0:30:26.90,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:30:30.03,0:30:31.66,Default,,0,0,0,,Мен қарғысқа ұшырадым
Dialogue: 0,0:30:31.74,0:30:32.74,Default,,0,0,0,,Ха!
Dialogue: 0,0:30:33.24,0:30:35.41,Default,,0,0,0,,Уф...
Dialogue: 0,0:30:36.50,0:30:40.17,Default,,0,0,0,,Сен маған бәрін айтасың.Ақша қайда?
Dialogue: 0,0:30:41.04,0:30:43.17,Default,,0,0,0,,Банктік сейф
Dialogue: 0,0:30:43.25,0:30:44.09,Default,,0,0,0,,Ген!
Dialogue: 0,0:30:44.17,0:30:45.80,Default,,0,0,0,,Ах... Гуха!
Dialogue: 0,0:30:48.55,0:30:49.64,Default,,0,0,0,,Не? (Карла) Уф...
Dialogue: 0,0:30:49.72,0:30:50.55,Default,,0,0,0,,Уау!
Dialogue: 0,0:30:51.68,0:30:52.81,Default,,0,0,0,,Ген №!
Dialogue: 0,0:30:52.89,0:30:56.18,Default,,0,0,0,,Сөйлессең түкке тұрғысыз, өлтіресің!
Dialogue: 0,0:30:56.27,0:30:58.06,Default,,0,0,0,,Әкеңнің кекін алмақсың, солай ма?
Dialogue: 0,0:30:58.14,0:31:00.98,Default,,0,0,0,,Сіздің жадыңыз - жалғыз қаруыңыз!
Dialogue: 0,0:31:01.06,0:31:02.31,Default,,0,0,0,,Меніңше, ол фильмнің атауы еді, иә?
Dialogue: 0,0:31:03.40,0:31:04.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:31:06.03,0:31:07.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:31:07.78,0:31:10.16,Default,,0,0,0,,(Фудзиконың ыңырсыуы)
Dialogue: 0,0:31:10.70,0:31:11.74,Default,,0,0,0,,Фудзико-кун
Dialogue: 0,0:31:11.82,0:31:15.58,Default,,0,0,0,,Сізді мұнда не үшін әкелгеніңізді түсінбейтін сияқтысыз.
Dialogue: 0,0:31:15.66,0:31:19.00,Default,,0,0,0,,Codfree Mining – таза компания
Dialogue: 0,0:31:19.08,0:31:22.33,Default,,0,0,0,,Енді олар менің өлтіруші жалдап жатқанымды білді.
Dialogue: 0,0:31:22.42,0:31:24.59,Default,,0,0,0,,Бар болғаны жоғалып кету керек.
Dialogue: 0,0:31:24.67,0:31:26.42,Default,,0,0,0,,Уф... Уф
Dialogue: 0,0:31:27.88,0:31:30.09,Default,,0,0,0,,Уф... аааа
Dialogue: 0,0:31:31.34,0:31:34.10,Default,,0,0,0,,Бинкхэм, алдымен одан құтыл.
Dialogue: 0,0:31:34.18,0:31:37.35,Default,,0,0,0,,(Фудзико мен Джиннің жөтелі)
Dialogue: 0,0:31:37.43,0:31:38.85,Default,,0,0,0,,Уф (Фудзико) Джин!
Dialogue: 0,0:31:38.93,0:31:41.40,Default,,0,0,0,,Эй, Окабе.
Dialogue: 0,0:31:41.48,0:31:44.11,Default,,0,0,0,,Президент сізді өлтіргісі келеді.
Dialogue: 0,0:31:44.73,0:31:45.61,Default,,0,0,0,,Неге...
Dialogue: 0,0:31:45.69,0:31:47.74,Default,,0,0,0,,Ах... иә.
Dialogue: 0,0:31:48.32,0:31:49.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:31:49.61,0:31:51.99,Default,,0,0,0,,Сіз Бинкхэм дедіңіз бе?
Dialogue: 0,0:31:52.07,0:31:55.99,Default,,0,0,0,,Адамдарды манипуляциялау үшін сізде қарғыс күші бар сияқты.
Dialogue: 0,0:31:56.08,0:32:00.25,Default,,0,0,0,,Сонда да сол кісілердің қуыршақтары болып қалу дұрыс па?
Dialogue: 0,0:32:00.83,0:32:02.25,Default,,0,0,0,,Сіз не істеп жатырсыз? Бинкум!
Dialogue: 0,0:32:02.33,0:32:04.84,Default,,0,0,0,,Ол әйелден тез құтыл!
Dialogue: 0,0:32:06.13,0:32:10.76,Default,,0,0,0,,Сен мені сол керемет күшпен иемденгің келмей ме?
Dialogue: 0,0:32:11.51,0:32:12.76,Default,,0,0,0,,Тіпті араластырсам да—
Dialogue: 0,0:32:13.34,0:32:16.47,Default,,0,0,0,,Мен сені адам ретінде білгім келеді.
Dialogue: 0,0:32:16.56,0:32:17.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:32:19.35,0:32:20.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:32:21.60,0:32:22.77,Default,,0,0,0,,Ах!
Dialogue: 0,0:32:22.85,0:32:24.10,Default,,0,0,0,,Ха!
Dialogue: 0,0:32:26.32,0:32:28.53,Default,,0,0,0,,Ер болса да, қыңыр.
Dialogue: 0,0:32:29.15,0:32:32.03,Default,,0,0,0,,Бинкум! Мен саған айтарым тезірек құтыл!
Dialogue: 0,0:32:32.11,0:32:34.03,Default,,0,0,0,,Сіз арзан емессіз!
Dialogue: 0,0:32:34.11,0:32:37.53,Default,,0,0,0,,Инвестицияларыңызға лайықты жұмыс жасаңыз! Бұл қоқыс!
Dialogue: 0,0:32:37.62,0:32:39.87,Default,,0,0,0,,(Қамшылау дыбысы)
Dialogue: 0,0:32:39.95,0:32:42.54,Default,,0,0,0,,Ууууууууууууууууу!
Dialogue: 0,0:32:42.62,0:32:43.79,Default,,0,0,0,,(Нанами) Болмайды. Мен саған бүгін таңертең неге екенін айттым ғой, иә?
Dialogue: 0,0:32:44.75,0:32:46.13,Default,,0,0,0,,Уф
Dialogue: 0,0:32:51.01,0:32:52.84,Default,,0,0,0,,Хмм... Уф!
Dialogue: 0,0:32:53.88,0:32:55.05,Default,,0,0,0,,Ха…
Dialogue: 0,0:32:55.14,0:32:56.80,Default,,0,0,0,,А... хмм?
Dialogue: 0,0:33:02.06,0:33:04.40,Default,,0,0,0,,Тазалау уақыты.
Dialogue: 0,0:33:05.90,0:33:06.98,Default,,0,0,0,,Уау!
Dialogue: 0,0:33:13.57,0:33:15.91,Default,,0,0,0,,Иә, монах, жағдайыңыз қалай?
Dialogue: 0,0:33:15.99,0:33:18.08,Default,,0,0,0,,Әй, жұмыс істей алмайтын қария.
Dialogue: 0,0:33:18.16,0:33:19.28,Default,,0,0,0,,Ол ашық-жарқын бала.
Dialogue: 0,0:33:19.37,0:33:21.20,Default,,0,0,0,,Ах! Ах... эй
Dialogue: 0,0:33:21.83,0:33:23.21,Default,,0,0,0,,Ген?
Dialogue: 0,0:33:23.29,0:33:26.71,Default,,0,0,0,,Уф... менің рюкзак осы жерде болды.
Dialogue: 0,0:33:26.79,0:33:27.92,Default,,0,0,0,,Рюкзак?
Dialogue: 0,0:33:28.00,0:33:29.21,Default,,0,0,0,,Сіз рюкзактарыңыз туралы ойламайсыз, солай ма?
Dialogue: 0,0:33:29.92,0:33:30.96,Default,,0,0,0,,О, солай емес пе?
Dialogue: 0,0:33:31.05,0:33:32.13,Default,,0,0,0,,Ах
Dialogue: 0,0:33:33.55,0:33:34.97,Default,,0,0,0,,болды
Dialogue: 0,0:33:38.30,0:33:40.47,Default,,0,0,0,,Кеттік (Джин) А...
Dialogue: 0,0:33:41.06,0:33:41.72,Default,,0,0,0,,Ммм
Dialogue: 0,0:33:42.85,0:33:43.98,Default,,0,0,0,,Ештеңе емес. Жөніңді тап.
Dialogue: 0,0:33:44.60,0:33:45.89,Default,,0,0,0,,Уау
Dialogue: 0,0:33:46.77,0:33:48.15,Default,,0,0,0,,Оны алыңыз да, жүгіріңіз!
Dialogue: 0,0:33:48.23,0:33:49.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:33:49.23,0:33:51.15,Default,,0,0,0,,Фудзико! Жыртқышты жайына қалдыр!
Dialogue: 0,0:33:52.57,0:33:53.40,Default,,0,0,0,,Әй?
Dialogue: 0,0:33:58.49,0:34:02.66,Default,,0,0,0,,Мына қарғыс атқан бейбақты қарашы, оның бүгін мотивациясы жоқ.
Dialogue: 0,0:34:02.75,0:34:06.50,Default,,0,0,0,,Бұл ыңғайлы, баланы құтқару бірінші кезектегі міндет болуы керек.
Dialogue: 0,0:34:06.58,0:34:09.50,Default,,0,0,0,,Бинкамды ашудың пайдасы жоқ.
Dialogue: 0,0:34:10.17,0:34:11.25,Default,,0,0,0,,Уф...
Dialogue: 0,0:34:11.34,0:34:12.50,Default,,0,0,0,,Ах
Dialogue: 0,0:34:12.92,0:34:13.76,Default,,0,0,0,,Уф
Dialogue: 0,0:34:14.63,0:34:16.26,Default,,0,0,0,,Ахх (Фудзико)
Dialogue: 0,0:34:16.84,0:34:17.84,Default,,0,0,0,,Уф...
Dialogue: 0,0:34:19.55,0:34:21.39,Default,,0,0,0,,Фудзико осы жолмен!
Dialogue: 0,0:34:21.47,0:34:24.56,Default,,0,0,0,,Әйелге көмектесудің қажеті жоқ.
Dialogue: 0,0:34:24.64,0:34:27.23,Default,,0,0,0,,О, маған көмектескеніне өте қуаныштымын.
Dialogue: 0,0:34:27.31,0:34:28.52,Default,,0,0,0,,Шулы
Dialogue: 0,0:34:29.56,0:34:31.40,Default,,0,0,0,,Эй, мен саған қарап тұрмын.
Dialogue: 0,0:34:34.03,0:34:35.49,Default,,0,0,0,,Мен баланы алып кетемін.
Dialogue: 0,0:34:36.74,0:34:39.49,Default,,0,0,0,,(көліктің жүгіру дыбысы)
Dialogue: 0,0:34:54.84,0:34:57.13,Default,,0,0,0,,Балалар мен сендермен қоштасамын.
Dialogue: 0,0:34:57.22,0:34:58.97,Default,,0,0,0,,Мен саған көмекке келсем де...
Dialogue: 0,0:34:59.05,0:35:00.30,Default,,0,0,0,,That's not true.
Dialogue: 0,0:35:00.39,0:35:02.60,Default,,0,0,0,,О, шынында да кеш.
Dialogue: 0,0:35:02.68,0:35:04.01,Default,,0,0,0,,Әй?
Dialogue: 0,0:35:05.31,0:35:08.60,Default,,0,0,0,,Кешеден бері шаршадық.
Dialogue: 0,0:35:08.69,0:35:11.77,Default,,0,0,0,,Ата-ана мен бала суға түспеңдер, демалайық
Dialogue: 0,0:35:11.86,0:35:12.86,Default,,0,0,0,,Кешір мені. Қызығушылығымды тежей алмадым; мен жай ғана…
Dialogue: 0,0:35:12.94,0:35:14.07,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:35:14.15,0:35:17.28,Default,,0,0,0,,Сондықтан мен ол әйелге көмектесе алмайтынымды айттым.
Dialogue: 0,0:35:17.78,0:35:19.49,Default,,0,0,0,,Жылдамдық көрсетілмеген.
Dialogue: 0,0:35:19.57,0:35:21.53,Default,,0,0,0,,А? Не айтқың келеді?
Dialogue: 0,0:35:22.24,0:35:23.66,Default,,0,0,0,,Сіз не істеп жатырсыз? Бинкум!
Dialogue: 0,0:35:23.74,0:35:26.04,Default,,0,0,0,,Ол әйелден тез құтыл!
Dialogue: 0,0:35:26.12,0:35:28.58,Default,,0,0,0,,Сіз арзан емессіз!
Dialogue: 0,0:35:28.66,0:35:31.54,Default,,0,0,0,,Инвестицияға тұрарлық жұмыс жасаңыз!
Dialogue: 0,0:35:31.63,0:35:33.34,Default,,0,0,0,,Шамасы, сол президент
Dialogue: 0,0:35:33.42,0:35:35.88,Default,,0,0,0,,Ол жай сараң емес сияқты.
Dialogue: 0,0:35:35.96,0:35:36.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:35:36.88,0:35:38.22,Default,,0,0,0,,(душ дыбысы)
Dialogue: 0,0:35:38.30,0:35:39.80,Default,,0,0,0,,Жақсы төздің.
Dialogue: 0,0:35:41.64,0:35:43.30,Default,,0,0,0,,Бұл қорқынышты емес пе? (Джин) Иә.
Dialogue: 0,0:35:44.35,0:35:47.89,Default,,0,0,0,,Бірақ қорқытса да ештеңе айтпадың.
Dialogue: 0,0:35:47.98,0:35:49.35,Default,,0,0,0,,Бұл тамаша болды.
Dialogue: 0,0:35:49.85,0:35:51.06,Default,,0,0,0,,Осы сөздерге рахмет...
Dialogue: 0,0:35:51.81,0:35:53.65,Default,,0,0,0,,Әкеңнің кекін алмақсың ғой, солай ма?
Dialogue: 0,0:35:53.73,0:35:56.57,Default,,0,0,0,,Сіздің жадыңыз - жалғыз қаруыңыз!
Dialogue: 0,0:35:56.65,0:35:57.61,Default,,0,0,0,,Ах!
Dialogue: 0,0:36:01.74,0:36:04.58,Default,,0,0,0,,Бұл рас болды, сен мені қорғадың.
Dialogue: 0,0:36:06.62,0:36:09.41,Default,,0,0,0,,Фуджикого күмәнданғаным үшін кешірім сұраймын.
Dialogue: 0,0:36:10.62,0:36:12.83,Default,,0,0,0,,Мен оны жуып тастаймын... Уау.
Dialogue: 0,0:36:12.92,0:36:14.59,Default,,0,0,0,,Не істеп жүрсің?
Dialogue: 0,0:36:17.84,0:36:19.84,Default,,0,0,0,,Ах, бұл жақсы сезінеді
Dialogue: 0,0:36:20.84,0:36:23.09,Default,,0,0,0,,Джин, қазір не ойлап отырсың?
Dialogue: 0,0:36:23.68,0:36:28.10,Default,,0,0,0,,Не... неге Фудзико менімен бірге шомылып жатыр?
Dialogue: 0,0:36:28.18,0:36:30.64,Default,,0,0,0,,Жарайды, кең.
Dialogue: 0,0:36:31.73,0:36:32.85,Default,,0,0,0,,Бұл менің бірінші рет
Dialogue: 0,0:36:32.94,0:36:34.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:34.15,0:36:37.48,Default,,0,0,0,,Мен анаммен ешқашан шомылған емеспін.
Dialogue: 0,0:36:37.57,0:36:38.73,Default,,0,0,0,,Ешқашан?
Dialogue: 0,0:36:38.82,0:36:41.61,Default,,0,0,0,,Ол мен туылғаннан кейін көп ұзамай қайтыс болды.
Dialogue: 0,0:36:41.70,0:36:44.74,Default,,0,0,0,,Иә, сіз осы уақыт бойы әкеңізбен бірге тұрдыңыз.
Dialogue: 0,0:36:44.82,0:36:46.12,Default,,0,0,0,,Иә
Dialogue: 0,0:36:46.70,0:36:50.12,Default,,0,0,0,,Әкем Генді бәрінен де жақсы көретін.
Dialogue: 0,0:36:50.20,0:36:53.96,Default,,0,0,0,,Джин аман болса, көкте жеңілдеп қалатыныңа сенімдімін.
Dialogue: 0,0:36:59.80,0:37:02.93,Default,,0,0,0,,Мен енді кек аламын деп айтпаймын.
Dialogue: 0,0:37:03.43,0:37:04.68,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:37:06.68,0:37:08.06,Default,,0,0,0,,Сіз ақылды адамсыз.
Dialogue: 0,0:37:08.89,0:37:11.77,Default,,0,0,0,,Бұл өте сәнді сарай.
Dialogue: 0,0:37:11.85,0:37:12.89,Default,,0,0,0,,Не? Яғни
Dialogue: 0,0:37:12.98,0:37:18.15,Default,,0,0,0,,Codfree – компания табысының көп бөлігін басқа жаққа аударатын инвестициялық компания.
Dialogue: 0,0:37:18.23,0:37:21.53,Default,,0,0,0,,Инвестициялық компания? Мен оны олай көрмеймін.
Dialogue: 0,0:37:21.61,0:37:23.07,Default,,0,0,0,,Әрине
Dialogue: 0,0:37:23.15,0:37:27.20,Default,,0,0,0,,Инвестициялық компания - бұл тек атымен ғана қабықша компания.
Dialogue: 0,0:37:28.58,0:37:31.04,Default,,0,0,0,,Иә? Бұл жігіт мені таң қалдырды
Dialogue: 0,0:37:31.12,0:37:32.37,Default,,0,0,0,,Өлшемдері қараңыз!
Dialogue: 0,0:37:32.45,0:37:33.79,Default,,0,0,0,,​​О?
Dialogue: 0,0:37:36.25,0:37:37.42,Default,,0,0,0,,Ол жігіт...
Dialogue: 0,0:37:38.63,0:37:43.30,Default,,0,0,0,,Көрінбейтін жіптер қосыла бастаған сияқты.
Dialogue: 0,0:37:53.23,0:37:54.06,Default,,0,0,0,,Хмм
Dialogue: 0,0:37:59.15,0:38:00.15,Default,,0,0,0,,Иә
Dialogue: 0,0:38:02.32,0:38:03.40,Default,,0,0,0,,Әрине
Dialogue: 0,0:38:07.11,0:38:10.95,Default,,0,0,0,,Қайда бара жатырсың? Сәлем Фудзико
Dialogue: 0,0:38:11.58,0:38:13.83,Default,,0,0,0,,Мен жақында ораламын, сондықтан тыныш күтіңіз.
Dialogue: 0,0:38:14.54,0:38:17.21,Default,,0,0,0,,Бұл қауіпті, сондықтан бөлмеден шықпаңыз.
Dialogue: 0,0:38:17.29,0:38:19.58,Default,,0,0,0,,Егер сіз аш болсаңыз, бөлмеге қызмет көрсетіңіз.
Dialogue: 0,0:38:20.67,0:38:23.34,Default,,0,0,0,,Сіз шынымен қайтып келе жатырсыз, солай емес пе?
Dialogue: 0,0:38:25.92,0:38:27.47,Default,,0,0,0,,Неге үндемейсің?
Dialogue: 0,0:38:27.55,0:38:30.10,Default,,0,0,0,,Жоқ! Мені жалғыз қалдырмаңыз!
Dialogue: 0,0:38:30.97,0:38:32.85,Default,,0,0,0,,Сондықтан мен балаларды жек көремін.
Dialogue: 0,0:38:32.93,0:38:34.35,Default,,0,0,0,,А... а
Dialogue: 0,0:38:34.43,0:38:36.64,Default,,0,0,0,,Дүние туралы ештеңе білмесем де
Dialogue: 0,0:38:36.73,0:38:39.86,Default,,0,0,0,,Мен өзімшілмін және жалғыз өмір сүруге күшім жоқ.
Dialogue: 0,0:38:39.94,0:38:41.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:38:41.11,0:38:43.73,Default,,0,0,0,,Мен жыласам, мені біреу қорғайды деп ойлаймын.
Dialogue: 0,0:38:45.19,0:38:47.65,Default,,0,0,0,,Көңіліңіз қалса, мықты болыңыз.
Dialogue: 0,0:38:48.16,0:38:50.62,Default,,0,0,0,,Егер сіз ұл болсаңыз, өзіңіз күте аласыз, солай ма?
Dialogue: 0,0:38:51.24,0:38:53.54,Default,,0,0,0,,Уф...
Dialogue: 0,0:38:57.91,0:38:58.92,Default,,0,0,0,,Иә
Dialogue: 0,0:39:03.96,0:39:05.38,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:39:17.39,0:39:18.89,Default,,0,0,0,,Дәл солай
Dialogue: 0,0:39:18.98,0:39:20.44,Default,,0,0,0,,О, Люпин
Dialogue: 0,0:39:20.52,0:39:22.31,Default,,0,0,0,,Бала бірдей емес пе?
Dialogue: 0,0:39:22.40,0:39:24.07,Default,,0,0,0,,Мен қазір бала күтуді аяқтадым.
Dialogue: 0,0:39:24.15,0:39:27.57,Default,,0,0,0,,Не, сен қазына алдың ба?
Dialogue: 0,0:39:28.82,0:39:30.61,Default,,0,0,0,,Мен жеңдім.
Dialogue: 0,0:39:30.70,0:39:33.70,Default,,0,0,0,,Саке онша жақсы емес сияқты.
Dialogue: 0,0:39:33.78,0:39:36.83,Default,,0,0,0,,Балаға мұндай ерекше көзқараспен қарау керемет.
Dialogue: 0,0:39:39.58,0:39:42.67,Default,,0,0,0,,Кодфридің өлтіруші жалдап жатқанын білгендер
Dialogue: 0,0:39:42.75,0:39:45.59,Default,,0,0,0,,Бала болсаң да, бәрібір үндемей, кәдеге жарайсың.
Dialogue: 0,0:39:46.30,0:39:50.38,Default,,0,0,0,,Егер сіз кәдімгідей болсаңыз, олармен жұмысыңыз біткен соң, сіз еркектерді кесіп тастайтын едіңіз, солай ма?
Dialogue: 0,0:39:50.47,0:39:52.55,Default,,0,0,0,,Ол бала еркек емес.
Dialogue: 0,0:39:52.64,0:39:54.51,Default,,0,0,0,,Әйел де, шеше де білмейді.
Dialogue: 0,0:39:55.01,0:39:58.35,Default,,0,0,0,,Жалғыз өмір сүре алмайсың, балам.
Dialogue: 0,0:39:58.43,0:40:01.98,Default,,0,0,0,,Ол әлі де қызық әйел.
Dialogue: 0,0:40:02.90,0:40:06.23,Default,,0,0,0,,Менің қолымнан келмейтін өтірік айтқым келмейді. Бар болғаны.
Dialogue: 0,0:40:06.32,0:40:07.57,Default,,0,0,0,,Иә
Dialogue: 0,0:40:07.65,0:40:10.49,Default,,0,0,0,,Бинкхэм жай өлтіруші емес.
Dialogue: 0,0:40:10.57,0:40:11.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:40:12.16,0:40:13.07,Default,,0,0,0,,Мен оның кім екенін білмеймін.
Dialogue: 0,0:40:13.16,0:40:16.49,Default,,0,0,0,,Мазасыз өлтірушілерді жаппай шығару үшін зауыт салды.
Dialogue: 0,0:40:17.24,0:40:21.00,Default,,0,0,0,,Сонымен қатар, фабриканы қаржыландыру көзі Codfree Mining болып табылады.
Dialogue: 0,0:40:21.83,0:40:23.88,Default,,0,0,0,,Біреу жасаған сахнада
Dialogue: 0,0:40:23.96,0:40:27.00,Default,,0,0,0,,Дүниедегі барлық жамандық бір-бірімен байланысты.
Dialogue: 0,0:40:27.09,0:40:30.80,Default,,0,0,0,,Олай болса, Бинкхэм де... Жарайды.
Dialogue: 0,0:40:30.88,0:40:32.76,Default,,0,0,0,,Оның біртүрлі қарғысы бар (Фудзико) Ах.
Dialogue: 0,0:40:33.34,0:40:34.93,Default,,0,0,0,,Ол қатал қарсылас.
Dialogue: 0,0:40:35.01,0:40:36.89,Default,,0,0,0,,Кеңесіңізге рахмет.
Dialogue: 0,0:40:36.97,0:40:39.10,Default,,0,0,0,,Қайсысы ақыл-ойды басқарады?
Dialogue: 0,0:40:39.18,0:40:42.94,Default,,0,0,0,,Мен және Бинкхэм, сіз қайсысына бәс тігесіз?
Dialogue: 0,0:40:51.15,0:40:55.78,Default,,0,0,0,,Нәтижесін білетін жерде бәс тігуді қаламаймын.
Dialogue: 0,0:40:57.33,0:40:58.54,Default,,0,0,0,,Фудзикоға не болды?
Dialogue: 0,0:40:59.95,0:41:00.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:41:00.87,0:41:04.46,Default,,0,0,0,,Әзірше кешірім сұраймын.
Dialogue: 0,0:41:05.04,0:41:07.46,Default,,0,0,0,,Жұмыс әлі аяқталған жоқ.
Dialogue: 0,0:41:08.67,0:41:11.21,Default,,0,0,0,,Жарайды ма? Бұл ақша туралы емес
Dialogue: 0,0:41:11.30,0:41:14.89,Default,,0,0,0,,Яэль Окузаки мен Хокты кім жіберді?
Dialogue: 0,0:41:14.97,0:41:17.30,Default,,0,0,0,,Жалғыз сізді қызықтырмайды.
Dialogue: 0,0:41:19.72,0:41:20.97,Default,,0,0,0,,Жаман емес
Dialogue: 0,0:41:23.35,0:41:25.48,Default,,0,0,0,,Сен де бір нәрсені ұнататын адамсың.
Dialogue: 0,0:41:28.40,0:41:30.73,Default,,0,0,0,,Мен сенің бұлай айтқаныңды қаламаймын.
Dialogue: 0,0:41:31.32,0:41:32.94,Default,,0,0,0,,О, түсіндім.
Dialogue: 0,0:41:34.57,0:41:36.24,Default,,0,0,0,,Хмм...
Dialogue: 0,0:41:36.32,0:41:39.28,Default,,0,0,0,,«500 миллион доллар қоймасы басқа жерге ауыстырылды».
Dialogue: 0,0:41:39.37,0:41:43.54,Default,,0,0,0,,«Егер оның қайда екенін білгіңіз келсе, Рэнди отбасының оңтүстігіндегі шөл далада».
Dialogue: 0,0:41:43.62,0:41:45.62,Default,,0,0,0,,«Фудзико шахтасы» Барлығы осы
Dialogue: 0,0:41:46.88,0:41:48.38,Default,,0,0,0,,Неліктен мұндай хабарлама?
Dialogue: 0,0:41:48.96,0:41:52.13,Default,,0,0,0,,Қиындыққа қашпай қарсы тұратын ақымақ әйел.
Dialogue: 0,0:41:52.21,0:41:54.80,Default,,0,0,0,,Карла Бинкхэмді әкеліңіз.
Dialogue: 0,0:41:54.88,0:41:55.93,Default,,0,0,0,,Иә
Dialogue: 0,0:42:06.85,0:42:08.02,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:42:09.06,0:42:10.52,Default,,0,0,0,,Президент сізді шақырды.
Dialogue: 0,0:42:10.61,0:42:11.44,Default,,0,0,0,,Уф!
Dialogue: 0,0:42:11.52,0:42:13.69,Default,,0,0,0,,Ол «Рух толқынын» қолдануда — қалағанынша жоғалып, қайта пайда бола алады.
Dialogue: 0,0:42:16.28,0:42:17.86,Default,,0,0,0,,Ух... Бинкхэм
Dialogue: 0,0:42:17.95,0:42:21.12,Default,,0,0,0,,Уф, не... көшіріп жатырсың...
Dialogue: 0,0:42:32.42,0:42:34.13,Default,,0,0,0,,Сізге енді кетудің қажеті жоқ.
Dialogue: 0,0:42:35.05,0:42:36.38,Default,,0,0,0,,Кел, Бинкэм
Dialogue: 0,0:42:36.47,0:42:41.64,Default,,0,0,0,,Фудзико шахтаға ақшаның қайда екенін ашып, оны өлтіру үшін күшіңізді пайдаланыңыз.
Dialogue: 0,0:42:41.72,0:42:43.56,Default,,0,0,0,,Хмм...
Dialogue: 0,0:42:44.18,0:42:45.39,Default,,0,0,0,,Ах
Dialogue: 0,0:42:48.14,0:42:49.65,Default,,0,0,0,,Уф...
Dialogue: 0,0:42:49.73,0:42:51.48,Default,,0,0,0,,Міне, Шиге-чи осылайша жойылған екен…
Dialogue: 0,0:42:52.15,0:42:53.23,Default,,0,0,0,,Хмм
Dialogue: 0,0:42:57.86,0:42:59.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:43:03.45,0:43:04.70,Default,,0,0,0,,Я...
Dialogue: 0,0:43:15.01,0:43:18.17,Default,,0,0,0,,(Мотоциклдің жүгіру дыбысы)
Dialogue: 0,0:43:26.02,0:43:28.18,Default,,0,0,0,,Мұнда сізді ешкім мазаламайды
Dialogue: 0,0:43:28.27,0:43:30.94,Default,,0,0,0,,Сен екеуміз оңаша сөйлесе аламыз
Dialogue: 0,0:43:34.27,0:43:37.15,Default,,0,0,0,,Жүр, мені өзіңдікі ет.
Dialogue: 0,0:43:37.24,0:43:38.99,Default,,0,0,0,,Егер қолыңыздан келсе
Dialogue: 0,0:43:45.99,0:43:47.70,Default,,0,0,0,,Хмм... Ахх
Dialogue: 0,0:43:49.00,0:43:50.29,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:43:50.83,0:43:52.54,Default,,0,0,0,,бірақ мүмкіндігінше көп адамды құтқарғым келгендіктен…
Dialogue: 0,0:43:52.63,0:43:53.63,Default,,0,0,0,,Ах
Dialogue: 0,0:43:53.71,0:43:55.38,Default,,0,0,0,,Ах! (Фудзико) А... Уф.
Dialogue: 0,0:43:56.21,0:43:57.05,Default,,0,0,0,,Уф!
Dialogue: 0,0:43:57.88,0:43:58.72,Default,,0,0,0,,Уф
Dialogue: 0,0:44:00.63,0:44:02.89,Default,,0,0,0,,Уф... аа
Dialogue: 0,0:44:02.97,0:44:03.97,Default,,0,0,0,,Ха!
Dialogue: 0,0:44:04.80,0:44:07.22,Default,,0,0,0,,Хаха...
Dialogue: 0,0:44:11.90,0:44:12.94,Default,,0,0,0,,Я...
Dialogue: 0,0:44:13.02,0:44:14.48,Default,,0,0,0,,Оңтүстік Италиядағы Неаполис қаласы.
Dialogue: 0,0:44:20.24,0:44:22.28,Default,,0,0,0,,Иә! Уф...хехе!
Dialogue: 0,0:44:23.20,0:44:24.24,Default,,0,0,0,,Уф! (Фудзико) Иә!
Dialogue: 0,0:44:24.32,0:44:25.45,Default,,0,0,0,,Уф...
Dialogue: 0,0:44:25.53,0:44:27.12,Default,,0,0,0,,Уф (Фудзико) Уф... аа
Dialogue: 0,0:44:27.20,0:44:28.29,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:44:28.37,0:44:29.41,Default,,0,0,0,,Уф! (Фудзико) Қарғыс атсын
Dialogue: 0,0:44:29.50,0:44:30.79,Default,,0,0,0,,Шынымен осындай азғырумен құпия мәліметтерді ағызып жіберемін деп ойлайсың ба?
Dialogue: 0,0:44:31.46,0:44:32.54,Default,,0,0,0,,Хмм...
Dialogue: 0,0:44:33.96,0:44:35.59,Default,,0,0,0,,Иә! Иә... Ах!
Dialogue: 0,0:44:37.42,0:44:39.84,Default,,0,0,0,,Уф! Ах...
Dialogue: 0,0:44:40.47,0:44:46.85,Default,,0,0,0,,(Бинкэмнің ауыр тыныс алуы)
Dialogue: 0,0:44:48.01,0:44:50.60,Default,,0,0,0,,(Фудзиконың ауыр тыныс алуы)
Dialogue: 0,0:44:51.77,0:44:55.86,Default,,0,0,0,,Не болды? Мақсат - ақша табу, солай ма?
Dialogue: 0,0:44:55.94,0:44:58.86,Default,,0,0,0,,Хаа… Хаа…
Dialogue: 0,0:44:58.94,0:45:01.36,Default,,0,0,0,,Ерекше қарғыс бар.
Dialogue: 0,0:45:02.53,0:45:05.28,Default,,0,0,0,,Сіз қожайыныңыздың бұйрығын орындауыңыз керек.
Dialogue: 0,0:45:06.45,0:45:12.41,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:45:15.67,0:45:16.84,Default,,0,0,0,,(Эмма) Бүкіл отбасыны алып шығу үшін. (Мусика) Дұрыс
Dialogue: 0,0:45:16.92,0:45:19.05,Default,,0,0,0,,Мені қарғыс атсын!
Dialogue: 0,0:45:21.21,0:45:22.88,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:45:23.59,0:45:24.88,Default,,0,0,0,,Уф
Dialogue: 0,0:45:27.18,0:45:30.64,Default,,0,0,0,,Бәрін айтып, өз өміріңе қиясың!
Dialogue: 0,0:45:30.72,0:45:32.14,Default,,0,0,0,,Иә
Dialogue: 0,0:45:37.27,0:45:38.44,Default,,0,0,0,,Уф
Dialogue: 0,0:45:46.03,0:45:50.20,Default,,0,0,0,,Бинкхам мен сіздің қарғысыңыздың шынайы табиғатын көріп тұрмын.
Dialogue: 0,0:45:50.29,0:45:53.66,Default,,0,0,0,,Бүкіл денеңдегі тер бездерінен тарайтын усың.
Dialogue: 0,0:45:53.75,0:45:56.46,Default,,0,0,0,,Құм бұлтына шашылып қалды.
Dialogue: 0,0:45:57.13,0:45:58.63,Default,,0,0,0,,Сол удың иісі
Dialogue: 0,0:45:58.71,0:46:03.01,Default,,0,0,0,,Ібіліс кернейі, Оңтүстік Азиядан шыққан өлтіретін өсімдік
Dialogue: 0,0:46:03.63,0:46:08.72,Default,,0,0,0,,Бұл өсімдіктің жемісінде адамдардың санасын басқара алатын күшті у бар.
Dialogue: 0,0:46:08.80,0:46:10.47,Default,,0,0,0,,Құрамында скополамин бар
Dialogue: 0,0:46:11.10,0:46:14.56,Default,,0,0,0,,Бірақ бұл қуатты тек құрғақ жерлерде пайдалануға болады.
Dialogue: 0,0:46:14.64,0:46:15.73,Default,,0,0,0,,Неліктен бұл?
Dialogue: 0,0:46:16.31,0:46:17.73,Default,,0,0,0,,Майюри көз алдымызда жоғалып бара жатқандай болды
Dialogue: 0,0:46:17.81,0:46:20.98,Default,,0,0,0,,Сырт келбетім осылай болса да, мен улардан да хабардармын.
Dialogue: 0,0:46:21.07,0:46:25.24,Default,,0,0,0,,Ал мен еккен улы сенің бойыңда айнала бастады.
Dialogue: 0,0:46:25.32,0:46:28.07,Default,,0,0,0,,Не? When did you use such poison?
Dialogue: 0,0:46:28.16,0:46:28.99,Default,,0,0,0,,Ах
Dialogue: 0,0:46:29.07,0:46:32.74,Default,,0,0,0,,Бинкам, тек өлтіру мақсатында жасалған өзгертілген адам.
Dialogue: 0,0:46:32.83,0:46:34.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:46:34.50,0:46:38.25,Default,,0,0,0,,Бірақ сен ол кезде мені өлтіруге тартындың.
Dialogue: 0,0:46:39.00,0:46:43.51,Default,,0,0,0,,Сен мені сол керемет күшпен иемденгің келмей ме?
Dialogue: 0,0:46:44.34,0:46:45.92,Default,,0,0,0,,Тіпті араластырсам да—
Dialogue: 0,0:46:46.01,0:46:47.18,Default,,0,0,0,,Ах!
Dialogue: 0,0:46:47.26,0:46:48.38,Default,,0,0,0,,Ха!
Dialogue: 0,0:46:50.72,0:46:52.97,Default,,0,0,0,,Ер болса да, қорқақ.
Dialogue: 0,0:46:54.10,0:46:58.94,Default,,0,0,0,,Ол кезде мен сенің ішіңе салған уытым айнала бастады.
Dialogue: 0,0:47:01.77,0:47:03.44,Default,,0,0,0,,Онда неге сол тікұшақ келді?
Dialogue: 0,0:47:01.77,0:47:03.44,Default,,0,0,0,,Мен антидотты қолға түсірдім.
Dialogue: 0,0:47:03.53,0:47:07.24,Default,,0,0,0,,Бірақ бұл у тек адамдарға әсер етеді.
Dialogue: 0,0:47:03.53,0:47:07.24,Default,,0,0,0,,(Бинкэмнің ауыр тыныс алуы)
Dialogue: 0,0:47:07.24,0:47:07.32,Default,,0,0,0,,(Binkham's heavy breathing)
Dialogue: 0,0:47:07.32,0:47:10.16,Default,,0,0,0,,(Binkham's heavy breathing)
Dialogue: 0,0:47:07.32,0:47:10.16,Default,,0,0,0,,Демек, сіз өлтіретін машина немесе басқа нәрсе емессіз.
Dialogue: 0,0:47:10.24,0:47:11.95,Default,,0,0,0,,Адамның денесі мен ойы
Dialogue: 0,0:47:12.99,0:47:14.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:47:15.29,0:47:16.54,Default,,0,0,0,,Бейшара жігіт
Dialogue: 0,0:47:16.62,0:47:19.25,Default,,0,0,0,,Өлтіруден басқа ештеңе білмейсің...
Dialogue: 0,0:47:19.33,0:47:22.29,Default,,0,0,0,,Ол ата-анасының өсиетін орындаған бала еді.
Dialogue: 0,0:47:23.25,0:47:25.00,Default,,0,0,0,,Қорықпа
Dialogue: 0,0:47:25.09,0:47:27.72,Default,,0,0,0,,I can understand you
Dialogue: 0,0:47:28.47,0:47:31.59,Default,,0,0,0,,You can quench your thirsty heart
Dialogue: 0,0:47:31.68,0:47:35.06,Default,,0,0,0,,Hey, just say you want me.
Dialogue: 0,0:47:35.14,0:47:40.73,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:47:40.81,0:47:42.94,Default,,0,0,0,,Уф...
Dialogue: 0,0:47:44.02,0:47:45.73,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:47:46.23,0:47:49.36,Default,,0,0,0,,Ах ха ха...
Dialogue: 0,0:47:49.45,0:47:50.57,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:47:51.28,0:47:53.49,Default,,0,0,0,,О... сен...
Dialogue: 0,0:48:08.13,0:48:13.68,Default,,0,0,0,,(Бинкэмнің ауыр тыныс алуы)
Dialogue: 0,0:48:13.76,0:48:15.43,Default,,0,0,0,,Сіз!
Dialogue: 0,0:48:23.15,0:48:24.56,Default,,0,0,0,,Ах!
Dialogue: 0,0:48:26.65,0:48:28.90,Default,,0,0,0,,Уаааааааа...
Dialogue: 0,0:48:30.53,0:48:31.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:48:35.66,0:48:37.54,Default,,0,0,0,,Ах
Dialogue: 0,0:48:38.29,0:48:40.58,Default,,0,0,0,,Гах... аа...
Dialogue: 0,0:48:46.67,0:48:49.09,Default,,0,0,0,,Ах... ха...
Dialogue: 0,0:48:49.17,0:48:54.09,Default,,0,0,0,,Улы бола бастадыңыз, енді менің қуыршағымсыз.
Dialogue: 0,0:48:57.68,0:48:59.47,Default,,0,0,0,,Бізге жақсылап сөйлесу керек!
Dialogue: 0,0:49:01.27,0:49:03.14,Default,,0,0,0,,Жер бетінде қалай...
Dialogue: 0,0:49:03.69,0:49:05.98,Default,,0,0,0,,What poison did you use?
Dialogue: 0,0:49:07.19,0:49:08.48,Default,,0,0,0,,Мен ештеңе пайдаланған жоқпын.
Dialogue: 0,0:49:08.57,0:49:09.69,Default,,0,0,0,,Ха!
Dialogue: 0,0:49:11.53,0:49:15.99,Default,,0,0,0,,Егер мен оны атасам, бұл махаббат деген афродизиак болар еді.
Dialogue: 0,0:49:16.87,0:49:18.03,Default,,0,0,0,,Махаббат?
Dialogue: 0,0:49:22.21,0:49:23.75,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:49:24.21,0:49:25.67,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:49:28.84,0:49:31.51,Default,,0,0,0,,Қайырлы түн
Dialogue: 0,0:49:45.40,0:49:47.44,Default,,0,0,0,,Binkham guy Why Carla?
Dialogue: 0,0:49:47.52,0:49:49.52,Default,,0,0,0,,Мен мұны білемін бе?
Dialogue: 0,0:49:49.61,0:49:50.94,Default,,0,0,0,,Одан да баяу!
Dialogue: 0,0:49:51.03,0:49:53.11,Default,,0,0,0,,What is that guy at Binkham doing?
Dialogue: 0,0:49:53.19,0:49:55.32,Default,,0,0,0,,Себебі мен сізбен байланыса алмаймын.
Dialogue: 0,0:49:55.41,0:49:58.03,Default,,0,0,0,,Ол жұмыстан шығарылды! Жаңа өлтіруші ұйымдастырыңыз
Dialogue: 0,0:49:58.12,0:49:59.08,Default,,0,0,0,,Иә
Dialogue: 0,0:49:59.16,0:50:00.74,Default,,0,0,0,,Mr. Codfree (Codfree and others) Whoa...
Dialogue: 0,0:50:02.37,0:50:06.04,Default,,0,0,0,,Ақшаның құдіретіне тым көп сенбеген абзал.
Dialogue: 0,0:50:06.12,0:50:07.54,Default,,0,0,0,,Тағы да балалар!
Dialogue: 0,0:50:08.33,0:50:09.75,Default,,0,0,0,,Уау (Гюго)...
Dialogue: 0,0:50:09.84,0:50:14.51,Default,,0,0,0,,Сіз ақша ұрлап жатқан өлтіруші фабрика туралы әңгіме бар.
Dialogue: 0,0:50:14.59,0:50:17.26,Default,,0,0,0,,Өлтіруші фабрика? Не айтқың келеді?
Dialogue: 0,0:50:17.34,0:50:19.01,Default,,0,0,0,,Ақымақ болма
Dialogue: 0,0:50:19.10,0:50:22.22,Default,,0,0,0,,Бізді сол өлтіруші бір кездері нысанаға алған болатын.
Dialogue: 0,0:50:22.31,0:50:25.02,Default,,0,0,0,,Мен кісі өлтіруді сұраған адамға бірнеше сөз айтқым келеді.
Dialogue: 0,0:50:25.10,0:50:26.02,Default,,0,0,0,,Хмм...
Dialogue: 0,0:50:26.10,0:50:28.27,Default,,0,0,0,,Сөмкеңде кім бар?
Dialogue: 0,0:50:29.11,0:50:32.48,Default,,0,0,0,,Люпин-кун, саған айтар сөзім жоқ.
Dialogue: 0,0:50:32.57,0:50:33.86,Default,,0,0,0,,Сізге ескертуге рұқсат етіңіз
Dialogue: 0,0:50:33.94,0:50:36.95,Default,,0,0,0,,Бізбен енді араласпауыңызды өтінемін.
Dialogue: 0,0:50:37.03,0:50:38.66,Default,,0,0,0,,Жарайды, мен сені қазір кешіремін.
Dialogue: 0,0:50:38.66,0:50:39.53,Default,,0,0,0,,Жарайды, мен сені қазір кешіремін.
Dialogue: 0,0:50:38.66,0:50:39.53,Default,,0,0,0,,Дос көзілдірік
Dialogue: 0,0:50:39.62,0:50:42.29,Default,,0,0,0,,Әңгіме біткенше ол жаққа көшпе
Dialogue: 0,0:50:42.37,0:50:44.70,Default,,0,0,0,,Иә, Кодфри мырза.
Dialogue: 0,0:50:44.79,0:50:46.66,Default,,0,0,0,,Дұрыс жауап ести алмасаңыз
Dialogue: 0,0:50:46.75,0:50:50.38,Default,,0,0,0,,Бұл тамаша костюмде тесік болады.
Dialogue: 0,0:50:50.46,0:50:51.42,Default,,0,0,0,,Хмм...
Dialogue: 0,0:50:52.25,0:50:55.05,Default,,0,0,0,,Түсіндім, түсіндім, мені өлтірмеші.
Dialogue: 0,0:50:55.13,0:50:57.26,Default,,0,0,0,,Мен сол адамды ғана қалаймын...
Dialogue: 0,0:50:57.34,0:50:58.30,Default,,0,0,0,,Бұл адам?
Dialogue: 0,0:50:59.05,0:51:01.55,Default,,0,0,0,,Иә, ол адам...
Dialogue: 0,0:51:01.64,0:51:03.72,Default,,0,0,0,,Ууууууууу (өлшемді)...
Dialogue: 0,0:51:04.43,0:51:05.68,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:51:05.77,0:51:06.60,Default,,0,0,0,,Уф...
Dialogue: 0,0:51:08.06,0:51:09.60,Default,,0,0,0,,Әй, ол кім?
Dialogue: 0,0:51:09.69,0:51:11.06,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:51:11.15,0:51:13.07,Default,,0,0,0,,Жүрегім ауырады; қатты ауыр.
Dialogue: 0,0:51:13.15,0:51:14.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:51:14.15,0:51:15.36,Default,,0,0,0,,Хмм
Dialogue: 0,0:51:42.60,0:51:43.68,Default,,0,0,0,,Жыл бойы шорт киетін ұрғашы горилла ма!?
Dialogue: 0,0:51:43.76,0:51:44.81,Default,,0,0,0,,
Dialogue: 0,0:51:44.89,0:51:46.18,Default,,0,0,0,,Ах Фудзико
Dialogue: 0,0:51:50.73,0:51:51.73,Default,,0,0,0,,Ах
Dialogue: 0,0:51:53.40,0:51:55.11,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:51:55.19,0:51:58.40,Default,,0,0,0,,Барлығы өзім
Dialogue: 0,0:51:59.20,0:52:00.95,Default,,0,0,0,,Жақсы әйел бұзылады
Dialogue: 0,0:52:01.03,0:52:03.32,Default,,0,0,0,,Мен де ала аламын ба?
Dialogue: 0,0:52:05.41,0:52:06.95,Default,,0,0,0,,Codfree өлді
Dialogue: 0,0:52:07.04,0:52:08.91,Default,,0,0,0,,Қолыңызды түсірудің де қажеті жоқ еді.
Dialogue: 0,0:52:11.33,0:52:13.67,Default,,0,0,0,,Мен кодсыз ойынға мән бермеймін.
Dialogue: 0,0:52:13.75,0:52:15.80,Default,,0,0,0,,Бірақ бұл үлкен ойын.
Dialogue: 0,0:52:15.88,0:52:17.55,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:52:17.63,0:52:19.97,Default,,0,0,0,,500 миллион долларды жымқырған Рэнди.
Dialogue: 0,0:52:20.05,0:52:24.93,Default,,0,0,0,,Дәлелдемелерді жою деген сөз болса да, бүкіл үйді жарып жіберу - бұл асыра сілтеу.
Dialogue: 0,0:52:25.01,0:52:29.43,Default,,0,0,0,,Бізге әуе шабуылы жасалған сияқты.
Dialogue: 0,0:52:33.02,0:52:33.86,Default,,0,0,0,,Хмм...
Dialogue: 0,0:52:33.94,0:52:36.69,Default,,0,0,0,,Барлық жерде өлді деп есептелген Рэндидің іздері бар...
Dialogue: 0,0:52:36.77,0:52:38.48,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:52:38.57,0:52:42.70,Default,,0,0,0,,Бұл сіздің жоспарыңыздың барлығы Рэндиді өлі етіп көрсету еді, солай ма?
Dialogue: 0,0:52:43.74,0:52:44.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:52:48.54,0:52:49.58,Default,,0,0,0,,Өткенге… электрондық хат па?
Dialogue: 0,0:52:50.33,0:52:55.33,Default,,0,0,0,,Бірақ сіз тіпті Рэндидің бар ақшасын алдап алуды жоспарлағансыз.
Dialogue: 0,0:52:56.63,0:52:58.50,Default,,0,0,0,,Фудзико, егер аман-есен құтыла алсаң
Dialogue: 0,0:52:58.59,0:52:59.84,Default,,0,0,0,,Бір сағаттан кейін осы дүкенде
Dialogue: 0,0:53:03.93,0:53:07.31,Default,,0,0,0,,Белгіленген уақыттан бір сағат өтті.
Dialogue: 0,0:53:07.39,0:53:09.18,Default,,0,0,0,,Ол енді келмеуі мүмкін.
Dialogue: 0,0:53:11.27,0:53:14.23,Default,,0,0,0,,Рэндидің баласы әкесі өлді деп ойласын
Dialogue: 0,0:53:14.31,0:53:16.86,Default,,0,0,0,,Мен сейфтің PIN нөмірін алуға тырыстым.
Dialogue: 0,0:53:20.40,0:53:22.36,Default,,0,0,0,,Мен екі қате жібердім.
Dialogue: 0,0:53:22.45,0:53:24.36,Default,,0,0,0,,Бинкхэмнің өлтіруші ретіндегі шеберлігі...
Dialogue: 0,0:53:24.45,0:53:28.33,Default,,0,0,0,,Әкесінің кегін алғысы келген ұлдың махаббаты
Dialogue: 0,0:53:28.41,0:53:29.41,Default,,0,0,0,,Иә
Dialogue: 0,0:53:29.95,0:53:34.87,Default,,0,0,0,,Бірақ баламның отасының құнын алып тастау мен үшін қансыз және көз жасын төгетін еді.
Dialogue: 0,0:53:34.96,0:53:36.79,Default,,0,0,0,,О, жақсы.
Dialogue: 0,0:53:36.88,0:53:40.63,Default,,0,0,0,,Мен Рэнди мұны Джиннен бөлінгеннен кейін түсінгеніне сенімдімін.
Dialogue: 0,0:53:41.34,0:53:43.55,Default,,0,0,0,,Жанды құтқаруға тым көп тырысу
Dialogue: 0,0:53:43.63,0:53:44.22,Default,,0,0,0,,Ол баланы қауіп-қатерге ұшыратқаның қандай ақымақ болды.
Dialogue: 0,0:53:44.22,0:53:47.18,Default,,0,0,0,,Сол балаға қауіп төндіретін ақымақтық.
Dialogue: 0,0:53:44.22,0:53:47.18,Default,,0,0,0,,(Екі адам жылайды)
Dialogue: 0,0:53:47.18,0:53:49.35,Default,,0,0,0,,(Екі адам жылайды)
Dialogue: 0,0:53:49.43,0:53:51.64,Default,,0,0,0,,Сіз мұны да түсіндіңіз бе?
Dialogue: 0,0:53:51.72,0:53:54.02,Default,,0,0,0,,Ақшадан да маңызды нәрсе
Dialogue: 0,0:53:54.56,0:53:56.40,Default,,0,0,0,,Мен? Амал жоқ
Dialogue: 0,0:53:57.02,0:54:00.94,Default,,0,0,0,,Әйтпесе, Бинкэмді өлтіру қиынға соғудың қажеті болмас еді.
Dialogue: 0,0:54:01.03,0:54:03.40,Default,,0,0,0,,Мен қалаған ақшамды алдым.
Dialogue: 0,0:54:04.90,0:54:08.37,Default,,0,0,0,,Мені ұмытпайтын ең болмағанда бір адам болса жақсы болар еді.
Dialogue: 0,0:54:08.45,0:54:10.41,Default,,0,0,0,,Сіз оны бір күні пайдалана аласыз, солай ма?
Dialogue: 0,0:54:11.20,0:54:12.41,Default,,0,0,0,,Сіз сияқты
Dialogue: 0,0:54:13.66,0:54:15.46,Default,,0,0,0,,Ол сізге айтып береді.
Dialogue: 0,0:54:20.75,0:54:23.92,Default,,0,0,0,,Біз ер адамдар билеуге жаралғанбыз.
Dialogue: 0,0:54:24.01,0:54:27.43,Default,,0,0,0,,Фудзико Мина атты сахнада
Dialogue: 0,0:54:29.43,0:54:32.43,Default,,0,0,0,,Эй, мен ұйықтай аламын ба?
Dialogue: 0,0:54:33.02,0:54:35.39,Default,,0,0,0,,О, баяу
Dialogue: 0,0:54:53.08,0:54:58.08,Default,,0,0,0,,♪~
Dialogue: 0,0:56:45.40,0:56:50.40,Default,,0,0,0,,~♪
Dialogue: 0,0:56:54.66,0:56:55.49,Default,,0,0,0,,Хмм
Dialogue: 0,0:57:02.67,0:57:03.50,Default,,0,0,0,,Иә
Dialogue: 0,0:57:04.42,0:57:07.38,Default,,0,0,0,,Оны ұмыту мүмкін емес.
Dialogue: 0,0:57:08.46,0:57:09.67,Default,,0,0,0,,Сіз
Dialogue: 0,0:57:11.17,0:57:17.17,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory