Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:15.00,0:00:19.00,Default,,0,0,0,,(Пойыз ысқырығы)
Dialogue: 0,0:00:19.98,0:03:13.51,Default,,0,0,0,,♪♪~
Dialogue: 0,0:03:13.51,0:03:17.98,Default,,0,0,0,,♪♪~ Қош бол! Сау бол!
Dialogue: 0,0:03:17.98,0:04:33.47,Default,,0,0,0,,♪♪~
Dialogue: 0,0:04:35.56,0:04:40.99,Default,,0,0,0,,♪♪～ «Теңіз анасы»
Dialogue: 0,0:04:40.99,0:04:47.50,Default,,0,0,0,,♪♪~
Dialogue: 0,0:04:47.50,0:04:57.54,Default,,0,0,0,,♪♪~ Теңіз тербеледі
Dialogue: 0,0:04:57.54,0:05:07.00,Default,,0,0,0,,♪♪~ Көк болған кезде
Dialogue: 0,0:05:07.00,0:05:16.48,Default,,0,0,0,,♪♪～ Мен оны санай алмаймын
Dialogue: 0,0:05:16.48,0:05:22.54,Default,,0,0,0,,♪♪~ Бауырларыммен
Dialogue: 0,0:05:22.54,0:05:28.99,Default,,0,0,0,,♪♪~ Көпіршіктер сөзімен
Dialogue: 0,0:05:28.99,0:05:35.98,Default,,0,0,0,,♪♪~ Мен сөйлесіп тұрдым
Dialogue: 0,0:05:35.98,0:05:45.04,Default,,0,0,0,,♪♪~ Есіңде ме?
Dialogue: 0,0:05:45.04,0:05:54.50,Default,,0,0,0,,♪♪~ Баяғыда
Dialogue: 0,0:05:54.50,0:06:03.49,Default,,0,0,0,,♪♪~ Сен көк теңіздесің
Dialogue: 0,0:06:03.49,0:06:12.97,Default,,0,0,0,,♪♪~ Біз бірге тұрдық.
Dialogue: 0,0:06:12.97,0:06:17.51,Default,,0,0,0,,♪♪~ Медузалар да, теңіз кірпілері де
Dialogue: 0,0:06:17.51,0:06:22.48,Default,,0,0,0,,♪♪～ Балық та, шаян да
Dialogue: 0,0:06:22.48,0:06:37.99,Default,,0,0,0,,♪♪~ Біз бәріміз ағайынды едік.
Dialogue: 0,0:06:37.99,0:06:49.01,Default,,0,0,0,,♪♪~
Dialogue: 0,0:06:49.01,0:06:52.01,Default,,0,0,0,,Сусуке! Мен бірден қайтамын!
Dialogue: 0,0:06:52.01,0:06:54.01,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:11.49,0:08:12.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:33.49,0:08:35.49,Default,,0,0,0,,Бұл алтын балық.
Dialogue: 0,0:08:47.54,0:08:49.54,Default,,0,0,0,,Мен оны көтере алмаймын.
Dialogue: 0,0:09:06.51,0:09:08.51,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:09:13.55,0:09:15.05,Default,,0,0,0,,Уф!
Dialogue: 0,0:09:18.51,0:09:20.01,Default,,0,0,0,,Бұл!
Dialogue: 0,0:09:22.49,0:09:24.99,Default,,0,0,0,,Қайтыс болды ма екен...
Dialogue: 0,0:09:28.50,0:09:31.00,Default,,0,0,0,,Жалады! Бұл тірі!
Dialogue: 0,0:09:33.54,0:09:36.09,Default,,0,0,0,,Сусуке! Барайық!
Dialogue: 0,0:09:36.09,0:09:39.59,Default,,0,0,0,,Лиза~! алтын балық! Сусуке~!
Dialogue: 0,0:09:49.50,0:09:51.50,Default,,0,0,0,,Бұл біртүрлі жел.
Dialogue: 0,0:09:51.50,0:09:54.50,Default,,0,0,0,,Сусуке! Мен қозғалтқышты іске қосып жатырмын!
Dialogue: 0,0:10:03.00,0:10:05.00,Default,,0,0,0,,Сіз оны таптыңыз ба?
Dialogue: 0,0:10:09.99,0:10:13.49,Default,,0,0,0,,Иә! Адамдар басып алды!?
Dialogue: 0,0:10:15.98,0:10:18.98,Default,,0,0,0,,Нашар Бұл өте нашар.
Dialogue: 0,0:10:45.06,0:10:47.56,Default,,0,0,0,,Қайтыс болды ма екен...
Dialogue: 0,0:10:54.98,0:10:56.48,Default,,0,0,0,,Тірі!
Dialogue: 0,0:10:58.97,0:11:00.47,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:00.47,0:11:03.97,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:11:05.50,0:11:10.05,Default,,0,0,0,,Сусуке! Мен кешігіп қаламын!
Dialogue: 0,0:11:10.05,0:11:13.50,Default,,0,0,0,,Лиза! Алтын балық тірі болды!
Dialogue: 0,0:11:13.50,0:11:15.00,Default,,0,0,0,,Алтын балық?
Dialogue: 0,0:11:15.00,0:11:16.97,Default,,0,0,0,,Мен оны теңізде алдым!
Dialogue: 0,0:11:16.97,0:11:18.47,Default,,0,0,0,,Эй.
Dialogue: 0,0:11:25.50,0:11:27.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:42.98,0:11:46.99,Default,,0,0,0,,Мен сізді білмеймін, бірақ мұнда гербицид шашпаңыз!
Dialogue: 0,0:11:46.99,0:11:48.99,Default,,0,0,0,,Міне, таптырмас нәрсе! Керемет!
Dialogue: 0,0:11:48.99,0:11:51.99,Default,,0,0,0,,Жоқ, бұл гербицид емес.
Dialogue: 0,0:11:51.99,0:11:55.04,Default,,0,0,0,,Шамадан тыс құрғақтықты болдырмау үшін терең теңіздің таза суын пайдаланыңыз...
Dialogue: 0,0:11:55.04,0:11:58.00,Default,,0,0,0,,Бұл гербицид болмаса, жақсы.
Dialogue: 0,0:11:58.00,0:12:00.00,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:12:04.99,0:12:06.49,Default,,0,0,0,,Ах.
Dialogue: 0,0:12:07.51,0:12:10.01,Default,,0,0,0,,Жаман, Жамандап барады.
Dialogue: 0,0:12:12.12,0:12:14.13,Default,,0,0,0,,Мына сұмдық жігіт қандай?
Dialogue: 0,0:12:14.13,0:12:17.62,Default,,0,0,0,,...Олай айтпа. Сусуке: Адамдар өздері сияқты емес.
Dialogue: 0,0:12:17.62,0:12:19.11,Default,,0,0,0,,Мен айтпаймын.
Dialogue: 0,0:12:19.11,0:12:22.11,Default,,0,0,0,,О, сен оны балабақшаға апарасың ба? Иә.
Dialogue: 0,0:12:22.11,0:12:24.13,Default,,0,0,0,,Мұғалім, жоқ демейсіз бе?
Dialogue: 0,0:12:24.13,0:12:28.20,Default,,0,0,0,,Жарайды, мен сені қорғаймын.
Dialogue: 0,0:12:28.20,0:12:30.20,Default,,0,0,0,,Сүйкімді емес пе?
Dialogue: 0,0:12:36.61,0:12:38.61,Default,,0,0,0,,Бұл кеменің келген күні!
Dialogue: 0,0:12:40.13,0:12:42.63,Default,,0,0,0,,Соуске келмес бұрын тамақтаныңыз.
Dialogue: 0,0:12:43.63,0:12:46.13,Default,,0,0,0,,Қызық, мен мұны жеймін бе?
Dialogue: 0,0:12:46.13,0:12:48.13,Default,,0,0,0,,Тамақтану керек пе?
Dialogue: 0,0:12:49.12,0:12:51.62,Default,,0,0,0,,Не!? Жарақаттар жоқ!
Dialogue: 0,0:12:54.61,0:12:57.13,Default,,0,0,0,,Лиза Бұл қызды Понё деп атайды.
Dialogue: 0,0:12:57.13,0:12:58.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:58.63,0:13:01.63,Default,,0,0,0,,Оның аты Понё және сиқырды қолдана алады.
Dialogue: 0,0:13:01.63,0:13:04.63,Default,,0,0,0,,Понё оны жалағанда, жарақаты жазылды.
Dialogue: 0,0:13:14.63,0:13:16.63,Default,,0,0,0,,Сіз ветчина жейсіз бе?
Dialogue: 0,0:13:31.70,0:13:34.13,Default,,0,0,0,,Лиза! Понё ветчинаны жақсы көреді.
Dialogue: 0,0:13:34.13,0:13:36.13,Default,,0,0,0,,Сен маған ұқсайсың.
Dialogue: 0,0:13:36.13,0:13:59.12,Default,,0,0,0,,♪♪~
Dialogue: 0,0:13:59.12,0:14:01.12,Default,,0,0,0,,Жоқ, жоқ!
Dialogue: 0,0:14:01.12,0:14:05.63,Default,,0,0,0,,Уау! Жоқ, жоқ, жоқ!
Dialogue: 0,0:14:05.63,0:14:07.63,Default,,0,0,0,,Лиза, асығыңыз!
Dialogue: 0,0:14:16.12,0:14:18.62,Default,,0,0,0,,Лас! Ол лас!
Dialogue: 0,0:14:20.13,0:14:22.63,Default,,0,0,0,,Қайырлы таң!
Dialogue: 0,0:14:28.64,0:14:32.14,Default,,0,0,0,,Понё мен сенің үйіңді көремін! Қараңдар!
Dialogue: 0,0:14:41.63,0:14:43.13,Default,,0,0,0,,Түрлі оқиғаларға араласып жүріп—
Dialogue: 0,0:14:53.13,0:14:55.13,Default,,0,0,0,,Мұнда жақсы. Иә.
Dialogue: 0,0:14:55.13,0:14:57.63,Default,,0,0,0,,Қош келдіңіз. мен барамын.
Dialogue: 0,0:14:59.22,0:15:01.13,Default,,0,0,0,,Қайырлы таң! Кешіріңіз!
Dialogue: 0,0:15:01.13,0:15:03.63,Default,,0,0,0,,Нориконың орындығы, өтінемін. Иә!
Dialogue: 0,0:15:18.24,0:15:20.12,Default,,0,0,0,,Қайырлы таң, Со Чан.
Dialogue: 0,0:15:20.12,0:15:23.12,Default,,0,0,0,,Йоши-сан, мен қазір бос емеспін, сондықтан кейінірек орал.
Dialogue: 0,0:15:23.12,0:15:26.13,Default,,0,0,0,,Әй. Сусуке-чан.
Dialogue: 0,0:15:26.13,0:15:28.63,Default,,0,0,0,,Токи-сан, кездескенше. кінә!
Dialogue: 0,0:15:35.67,0:15:38.67,Default,,0,0,0,,Мұғалім: Жоқ деймін...
Dialogue: 0,0:15:39.62,0:15:41.12,Default,,0,0,0,,Шешім!
Dialogue: 0,0:15:44.63,0:15:48.13,Default,,0,0,0,,Осы жерде күт, мен дәл сол жерде боламын.
Dialogue: 0,0:15:50.12,0:15:52.62,Default,,0,0,0,,Мысық келер ме екен.
Dialogue: 0,0:16:03.11,0:16:07.11,Default,,0,0,0,,Тыныш тұрыңыз, мен жақында қайтамын.
Dialogue: 0,0:16:14.64,0:16:16.64,Default,,0,0,0,,Сонда кездескенше... О, Тоши-чан.
Dialogue: 0,0:16:18.14,0:16:22.23,Default,,0,0,0,,Менің қызуым шамалы, бірақ менде бәрі жақсы, солай ма?
Dialogue: 0,0:16:22.23,0:16:24.62,Default,,0,0,0,,Өтінемін, сау болыңыз.
Dialogue: 0,0:16:24.62,0:16:26.64,Default,,0,0,0,,Мұғалім! қайырлы таң!
Dialogue: 0,0:16:26.64,0:16:29.64,Default,,0,0,0,,Қайырлы таң, Со Чан. Со-чан, қалайсың?
Dialogue: 0,0:16:34.61,0:16:37.13,Default,,0,0,0,,Сусуке! Ха! Кумико-чан!
Dialogue: 0,0:16:37.13,0:16:40.17,Default,,0,0,0,,Әдемі көрінесіз бе? Оны маған анам сатып алды!
Dialogue: 0,0:16:40.17,0:16:41.70,Default,,0,0,0,,Хмм.
Dialogue: 0,0:16:41.70,0:16:45.62,Default,,0,0,0,,Сусуке Ойнайық. Бәрі жақсы, өйткені мен қазір бос емеспін.
Dialogue: 0,0:16:45.62,0:16:49.14,Default,,0,0,0,,Сен мұнда не істеп жүрсің? Сондықтан мен бос емеспін.
Dialogue: 0,0:16:49.14,0:16:51.11,Default,,0,0,0,,Біртүрлі Сусуке.
Dialogue: 0,0:16:51.11,0:16:53.61,Default,,0,0,0,,Бұл біртүрлі, Хмф!
Dialogue: 0,0:17:06.11,0:17:07.61,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:13.62,0:17:15.12,Default,,0,0,0,,Понё!
Dialogue: 0,0:17:18.62,0:17:22.18,Default,,0,0,0,,Аха….
Dialogue: 0,0:17:22.18,0:17:24.21,Default,,0,0,0,,Сосуке.
Dialogue: 0,0:17:24.21,0:17:26.63,Default,,0,0,0,,Кумико-чан! Бұл не?
Dialogue: 0,0:17:26.63,0:17:29.63,Default,,0,0,0,,Сізге балабақшаға ештеңе әкелуге рұқсат жоқ.
Dialogue: 0,0:17:29.63,0:17:31.62,Default,,0,0,0,,Бұл ағаш бақшаға жатпайды.
Dialogue: 0,0:17:31.62,0:17:34.14,Default,,0,0,0,,Жарайды, себебі ол ``Күнбағыс үйінен''.
Dialogue: 0,0:17:34.14,0:17:36.12,Default,,0,0,0,,Маған көрсету~.
Dialogue: 0,0:17:36.12,0:17:38.12,Default,,0,0,0,,Әй, алтын балық!
Dialogue: 0,0:17:38.12,0:17:40.14,Default,,0,0,0,,Бұл алтын балық емес, бұл Понё.
Dialogue: 0,0:17:40.14,0:17:42.70,Default,,0,0,0,,Понё? Мен көрдім.
Dialogue: 0,0:17:42.70,0:17:46.70,Default,,0,0,0,,Мен көрсетсем, ешкімге айтпайсың ба? иә! Айтпа!
Dialogue: 0,0:17:48.13,0:17:50.63,Default,,0,0,0,,Қараңызшы, бұл сүйкімді емес пе?
Dialogue: 0,0:17:56.63,0:18:00.63,Default,,0,0,0,,Бұл біртүрлі! Ол семіз, бірақ менің алтын балығым сүйкімді.
Dialogue: 0,0:18:01.63,0:18:03.13,Default,,0,0,0,,Эй!
Dialogue: 0,0:18:06.62,0:18:09.62,Default,,0,0,0,,Ахх...
Dialogue: 0,0:18:09.62,0:18:19.12,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:18:22.15,0:18:24.70,Default,,0,0,0,,Кумико-чан бара алмайды.
Dialogue: 0,0:18:24.70,0:18:27.70,Default,,0,0,0,,Себебі олар Понё туралы жаман сөздер айтады.
Dialogue: 0,0:18:30.63,0:18:33.13,Default,,0,0,0,,Мен су қосамын.
Dialogue: 0,0:18:39.62,0:18:41.12,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:55.14,0:18:56.64,Default,,0,0,0,,Понё!
Dialogue: 0,0:19:00.62,0:19:05.12,Default,,0,0,0,,Ах! Ахах... Жақсы.
Dialogue: 0,0:19:07.65,0:19:09.65,Default,,0,0,0,,Хэхехе...
Dialogue: 0,0:19:09.65,0:19:15.62,Default,,0,0,0,,≪Бұл біртүрлі. Мен Соуске-чанның даусын естимін≫
Dialogue: 0,0:19:15.62,0:19:22.65,Default,,0,0,0,,Бірақ Сусуке-чан балабақшаға баруы керек, сондықтан мен оны естіп тұрмын деп ойлаймын.
Dialogue: 0,0:19:22.65,0:19:25.65,Default,,0,0,0,,Йоши-сан, мен осындамын.
Dialogue: 0,0:19:26.63,0:19:30.63,Default,,0,0,0,,Әй, Сусуке-чан мұнда!
Dialogue: 0,0:19:31.67,0:19:35.13,Default,,0,0,0,,Менде жақсы нәрсе бар ма? Менде бар!
Dialogue: 0,0:19:35.13,0:19:40.13,Default,,0,0,0,,Жеңіс! Ал, ол қандай түсті?
Dialogue: 0,0:19:40.13,0:19:44.12,Default,,0,0,0,,Мм... Қызыл! (Норико) Қызыл!
Dialogue: 0,0:19:44.12,0:19:46.14,Default,,0,0,0,,Жеңіске жет!
Dialogue: 0,0:19:46.14,0:19:49.14,Default,,0,0,0,,Сіз қалай білдіңіз деп ойлаймын.
Dialogue: 0,0:19:49.14,0:19:51.64,Default,,0,0,0,,Маған көрсет. иә!
Dialogue: 0,0:19:54.11,0:19:57.11,Default,,0,0,0,,Әдемі екен. Сондай сүйкімді.
Dialogue: 0,0:19:57.11,0:19:59.13,Default,,0,0,0,,Ол Понё деп аталады.
Dialogue: 0,0:19:59.13,0:20:02.64,Default,,0,0,0,,Ол Хамды ұнатады және сиқырды қолдана алады.
Dialogue: 0,0:20:02.64,0:20:05.12,Default,,0,0,0,,Бұл жердегі жарақат жойылды.
Dialogue: 0,0:20:05.12,0:20:07.14,Default,,0,0,0,,Өйткені Понё оны жалап алды.
Dialogue: 0,0:20:07.14,0:20:09.14,Default,,0,0,0,,Эй!
Dialogue: 0,0:20:09.14,0:20:13.23,Default,,0,0,0,,Біздің де аяғымызды жалайсың ба деп ойлаймын.
Dialogue: 0,0:20:13.23,0:20:17.13,Default,,0,0,0,,Со-чан сияқты тағы да жүгірсем ғой.
Dialogue: 0,0:20:17.13,0:20:21.12,Default,,0,0,0,,Хмм, мен Понёдан сұрамайынша білмеймін.
Dialogue: 0,0:20:21.12,0:20:25.12,Default,,0,0,0,,Маған да бір қараңызшы. Жарайды, Токи-сан.
Dialogue: 0,0:20:26.64,0:20:30.14,Default,,0,0,0,,Уф, мен оны жек көремін! Бұл адам жүзді балық емес пе?
Dialogue: 0,0:20:31.13,0:20:35.22,Default,,0,0,0,,Мені тезірек теңізге қайтаруыңызды өтінемін! Мен цунами шақырамын!
Dialogue: 0,0:20:35.22,0:20:38.64,Default,,0,0,0,,Токи-сан бұл қайтадан цунами болды деді.
Dialogue: 0,0:20:38.64,0:20:41.64,Default,,0,0,0,,Адам жүзді балық жағаға кеткенде цунами келеді →
Dialogue: 0,0:20:41.64,0:20:44.13,Default,,0,0,0,,Көптен бері солай!
Dialogue: 0,0:20:44.13,0:20:50.63,Default,,0,0,0,,Ах! Бұл цунами! Цунами келді!
Dialogue: 0,0:20:50.63,0:20:55.21,Default,,0,0,0,,Цунами келді! О, о, цунами!
Dialogue: 0,0:20:55.21,0:20:56.71,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:57.62,0:21:02.62,Default,,0,0,0,,Не болды? Токи мырза. Әй, менің киімім бұзылды.
Dialogue: 0,0:21:10.14,0:21:12.14,Default,,0,0,0,,≪Сусуке! ≫
Dialogue: 0,0:21:16.61,0:21:19.11,Default,,0,0,0,,≪Сусуке~! ≫
Dialogue: 0,0:21:20.63,0:21:23.13,Default,,0,0,0,,≪Сусуке! ≫
Dialogue: 0,0:21:24.12,0:21:29.62,Default,,0,0,0,,Сусуке! Токи-саннан кешірім сұрама!
Dialogue: 0,0:21:38.63,0:21:42.63,Default,,0,0,0,,Уайымдама, мен сені қорғаймын.
Dialogue: 0,0:21:44.14,0:21:46.14,Default,,0,0,0,,Со-суке.
Dialogue: 0,0:21:49.14,0:21:51.13,Default,,0,0,0,,Сусуке!
Dialogue: 0,0:21:51.13,0:21:53.63,Default,,0,0,0,,А, аа...!
Dialogue: 0,0:21:54.70,0:21:56.70,Default,,0,0,0,,Понё!
Dialogue: 0,0:21:58.13,0:21:59.64,Default,,0,0,0,,Поньо.
Dialogue: 0,0:21:59.64,0:22:01.62,Default,,0,0,0,,Сосуке.
Dialogue: 0,0:22:01.62,0:22:05.62,Default,,0,0,0,,Мен Понё Сусукені жақсы көремін!
Dialogue: 0,0:22:11.13,0:22:13.17,Default,,0,0,0,,Маған да ұнайды!
Dialogue: 0,0:22:13.17,0:22:15.72,Default,,0,0,0,,Мен Понё Сусукені жақсы көремін!
Dialogue: 0,0:22:15.72,0:22:18.12,Default,,0,0,0,,Аспазшы...!
Dialogue: 0,0:22:18.12,0:22:50.14,Default,,0,0,0,,♪♪~
Dialogue: 0,0:22:50.14,0:22:52.66,Default,,0,0,0,,♪♪~ Ах! Ах!
Dialogue: 0,0:22:52.66,0:22:56.23,Default,,0,0,0,,♪♪~
Dialogue: 0,0:22:56.23,0:22:58.23,Default,,0,0,0,,Понё!
Dialogue: 0,0:22:59.13,0:23:02.65,Default,,0,0,0,,Понё! Поньо!
Dialogue: 0,0:23:02.65,0:23:04.65,Default,,0,0,0,,Понё!?
Dialogue: 0,0:23:05.64,0:23:09.12,Default,,0,0,0,,Ах! Поньо! Поньо!
Dialogue: 0,0:23:09.12,0:23:11.62,Default,,0,0,0,,Понё! Сусуке~!
Dialogue: 0,0:23:12.63,0:23:19.71,Default,,0,0,0,,Понё! Поньо!
Dialogue: 0,0:23:21.12,0:23:23.14,Default,,0,0,0,,Понё!
Dialogue: 0,0:23:23.14,0:23:34.11,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:23:34.11,0:23:46.61,Default,,0,0,0,,♪♪~
Dialogue: 0,0:24:16.85,0:24:20.35,Default,,0,0,0,,Сосуке: Тағдыр деген бар.
Dialogue: 0,0:24:20.35,0:24:23.39,Default,,0,0,0,,Қиын болса да тағдырыңды өзгерте алмайсың.
Dialogue: 0,0:24:23.39,0:24:25.94,Default,,0,0,0,,Понё теңізде өмір сүру үшін дүниеге келген→
Dialogue: 0,0:24:25.94,0:24:28.34,Default,,0,0,0,,Менің ойымша, сіз теңізге қайтып кеттіңіз.
Dialogue: 0,0:24:28.34,0:24:31.84,Default,,0,0,0,,Бұл гербицидтің күдікті екені анық.
Dialogue: 0,0:24:32.83,0:24:34.85,Default,,0,0,0,,Маған тістеп беріңізші.
Dialogue: 0,0:24:34.85,0:24:36.85,Default,,0,0,0,,Қараңызшы, тамшылап жатыр.
Dialogue: 0,0:24:39.85,0:24:41.85,Default,,0,0,0,,Бұл дәмді!
Dialogue: 0,0:24:46.42,0:24:50.36,Default,,0,0,0,,Көңілдеріңді көтеріңдер, өйткені бүгін Койчи қайтып келетін күн.
Dialogue: 0,0:24:50.36,0:24:54.35,Default,,0,0,0,,Соускенің жағдайы жақсы болмаса, көңілім қалады.
Dialogue: 0,0:24:54.35,0:25:19.84,Default,,0,0,0,,♪♪~
Dialogue: 0,0:25:19.84,0:25:22.34,Default,,0,0,0,,Өтінемін, бүгін теңізге түспе.
Dialogue: 0,0:25:22.34,0:25:23.83,Default,,0,0,0,,♪♪~ Иә….
Dialogue: 0,0:25:23.83,0:25:48.35,Default,,0,0,0,,♪♪~
Dialogue: 0,0:25:48.35,0:25:51.86,Default,,0,0,0,,≪Сусуке≫
Dialogue: 0,0:25:51.86,0:25:54.38,Default,,0,0,0,,Қазір үйге кіріңіз.
Dialogue: 0,0:25:54.38,0:25:56.41,Default,,0,0,0,,Осы жерге шелек қойсаңыз →
Dialogue: 0,0:25:56.41,0:25:58.85,Default,,0,0,0,,Понё келгенде, сіз бұл үйді білесіз бе?
Dialogue: 0,0:25:58.85,0:26:02.83,Default,,0,0,0,,Жарайды, егер Сусуке мұны істегісі келсе, жасасын.
Dialogue: 0,0:26:02.83,0:26:04.34,Default,,0,0,0,,Иә.
Dialogue: 0,0:26:04.34,0:26:13.36,Default,,0,0,0,,♪♪~
Dialogue: 0,0:26:13.36,0:26:16.43,Default,,0,0,0,,[ТЕЛ]
Dialogue: 0,0:26:16.43,0:26:19.93,Default,,0,0,0,,Сусуке, бірінші кел, мен бұл Коичи екеніне сенімдімін.
Dialogue: 0,0:26:21.85,0:26:25.86,Default,,0,0,0,,Сәлем... Иә, менмін.
Dialogue: 0,0:26:25.86,0:26:27.86,Default,,0,0,0,,[ТЕЛ] Иә, менде бәрі жақсы.
Dialogue: 0,0:26:27.86,0:26:30.35,Default,,0,0,0,,[ТЕЛ] (Койчи) Мен бүгін үйге бара алмаймын.
Dialogue: 0,0:26:30.35,0:26:32.83,Default,,0,0,0,,[TEL] Біз жағалаудан өтеміз, сондықтан әдеттегі сигналды сұрамаңыз.
Dialogue: 0,0:26:32.83,0:26:35.33,Default,,0,0,0,,Иә, мен Лизаны ауыстырамын.
Dialogue: 0,0:26:36.38,0:26:40.34,Default,,0,0,0,,Коичи? Иә иә!?
Dialogue: 0,0:26:40.34,0:26:42.86,Default,,0,0,0,,Өйткені сіз тек жоқ деп айта аласыз!
Dialogue: 0,0:26:42.86,0:26:46.34,Default,,0,0,0,,Әйеліңіз бен балаңызды жардан лақтырыңыз!
Dialogue: 0,0:26:46.34,0:26:48.34,Default,,0,0,0,,Мен енді білмеймін!
Dialogue: 0,0:26:51.35,0:26:53.37,Default,,0,0,0,,Не!
Dialogue: 0,0:26:53.37,0:26:56.39,Default,,0,0,0,,Сусуке! Бүгін кешке тамақ ішейік!
Dialogue: 0,0:26:56.39,0:26:59.39,Default,,0,0,0,,Мен үйде тамақтанғым келеді...
Dialogue: 0,0:27:06.87,0:27:08.37,Default,,0,0,0,,Ах!
Dialogue: 0,0:27:08.37,0:27:27.35,Default,,0,0,0,,♪♪~
Dialogue: 0,0:27:27.35,0:27:31.86,Default,,0,0,0,,Бұл Коичи! Лиза: Бұл Коичидің кемесі! Жарықтарды өшіріңіз!
Dialogue: 0,0:27:31.86,0:27:55.35,Default,,0,0,0,,♪♪~
Dialogue: 0,0:27:55.35,0:27:59.33,Default,,0,0,0,,Бұл Сусуке! Ол данышпан, ол небәрі 5 жаста!
Dialogue: 0,0:27:59.33,0:28:01.83,Default,,0,0,0,,Ханым, сіз ашуланған боларсыз.
Dialogue: 0,0:28:05.87,0:28:09.83,Default,,0,0,0,,«Кешіріңіз.» Лиза: Кешіріңіз.
Dialogue: 0,0:28:09.83,0:28:12.83,Default,,0,0,0,,B.A.K.A.
Dialogue: 0,0:28:16.35,0:28:19.85,Default,,0,0,0,,ＡＡＡＡＡＡ…
Dialogue: 0,0:28:24.36,0:28:27.41,Default,,0,0,0,,Лиза «Мен сені сүйемін»!
Dialogue: 0,0:28:27.41,0:28:30.41,Default,,0,0,0,,Мен «өте, өте» деймін.
Dialogue: 0,0:28:42.83,0:28:46.35,Default,,0,0,0,,Әдемі екен.
Dialogue: 0,0:28:46.35,0:29:19.43,Default,,0,0,0,,♪♪~
Dialogue: 0,0:29:19.43,0:29:22.35,Default,,0,0,0,,Лиза Жылама.
Dialogue: 0,0:29:22.35,0:29:25.35,Default,,0,0,0,,Мен де жыламаймын.
Dialogue: 0,0:29:25.35,0:29:30.35,Default,,0,0,0,,Мен Поньоны қорғауға уәде бердім.
Dialogue: 0,0:29:33.85,0:29:37.35,Default,,0,0,0,,Понё, ол жылап жатыр ма екен...
Dialogue: 0,0:29:40.44,0:29:43.94,Default,,0,0,0,,Уау! Жақсы! Мен сенің көңіліңді көтеремін!
Dialogue: 0,0:29:44.86,0:29:47.84,Default,,0,0,0,,♪~ Менде бәрі жақсы
Dialogue: 0,0:29:47.84,0:29:49.86,Default,,0,0,0,,Ауырды...
Dialogue: 0,0:29:49.86,0:29:51.85,Default,,0,0,0,,Көңіліңді көтер, Сусуке де!
Dialogue: 0,0:29:51.85,0:29:54.83,Default,,0,0,0,,Мен Понёның да Лиза сияқты жақсы болатынына сенімдімін!
Dialogue: 0,0:29:54.83,0:29:56.33,Default,,0,0,0,,Иә.
Dialogue: 0,0:29:57.35,0:30:01.85,Default,,0,0,0,,Жүр, тамақ ішейік! Коичи сыбағасын да жейік!
Dialogue: 0,0:30:10.87,0:30:13.35,Default,,0,0,0,,Дәл маған не болды→
Dialogue: 0,0:30:13.35,0:30:15.84,Default,,0,0,0,,Мен сендерге фермада қалай жұмыс істеу керектігін көрсетемін.→
Dialogue: 0,0:30:15.84,0:30:18.36,Default,,0,0,0,,Оны мұнда әкелгенім дұрыс болмады.
Dialogue: 0,0:30:18.36,0:30:21.36,Default,,0,0,0,,Адамның суы мен тынысы қаншалықты ластанған→
Dialogue: 0,0:30:21.36,0:30:23.85,Default,,0,0,0,,Didn't I teach you so much?
Dialogue: 0,0:30:23.85,0:30:26.91,Default,,0,0,0,,Енді мынаны же!
Dialogue: 0,0:30:26.91,0:30:29.85,Default,,0,0,0,,Сіз мені естімейсіз бе, Брунхилдр?
Dialogue: 0,0:30:29.85,0:30:31.85,Default,,0,0,0,,Ветчина жақсы!
Dialogue: 0,0:30:31.85,0:30:33.35,Default,,0,0,0,,М-м-мұнда… мұнда… мұнда… осы зат!
Dialogue: 0,0:30:33.35,0:30:35.86,Default,,0,0,0,,Ха... ХАМ!?
Dialogue: 0,0:30:35.86,0:30:38.34,Default,,0,0,0,,Соншалықты қорқынышты нәрсе туралы қайдан білдіңіз?→
Dialogue: 0,0:30:38.34,0:30:40.35,Default,,0,0,0,,Айтыңызшы, Брюннхилде.
Dialogue: 0,0:30:40.35,0:30:43.87,Default,,0,0,0,,Бұл Бринхилдр емес, бұл Понё.
Dialogue: 0,0:30:43.87,0:30:45.90,Default,,0,0,0,,По… по… Понё!?
Dialogue: 0,0:30:45.90,0:30:48.45,Default,,0,0,0,,Мен Понё Сусукені жақсы көремін!
Dialogue: 0,0:30:48.45,0:30:51.36,Default,,0,0,0,,Понё адамға айналады!
Dialogue: 0,0:30:51.36,0:30:53.34,Default,,0,0,0,,Адамдарға!?
Dialogue: 0,0:30:53.34,0:30:56.84,Default,,0,0,0,,Мұндай ақымақ, жиіркенішті жаратылыстың несі жақсы!
Dialogue: 0,0:30:56.84,0:31:00.37,Default,,0,0,0,,Адам өмірді тек теңізден алады.
Dialogue: 0,0:31:00.37,0:31:03.37,Default,,0,0,0,,Мен де бір кездері адам болғанмын.
Dialogue: 0,0:31:03.37,0:31:06.39,Default,,0,0,0,,Менің адам болуды тоқтатуым үшін қанша уақыт қажет?
Dialogue: 0,0:31:06.39,0:31:08.94,Default,,0,0,0,,Мен Понёның қолын қалаймын!
Dialogue: 0,0:31:08.94,0:31:11.86,Default,,0,0,0,,Аяқ Маған бұл ұнамайды!
Dialogue: 0,0:31:11.86,0:31:15.33,Default,,0,0,0,,Мен Сусуке сияқты аяқты қалаймын!
Dialogue: 0,0:31:15.33,0:31:17.85,Default,,0,0,0,,Амал жоқ... Ах!
Dialogue: 0,0:31:17.85,0:31:24.84,Default,,0,0,0,,Уау...!
Dialogue: 0,0:31:24.84,0:31:26.87,Default,,0,0,0,,Уф!Уф!
Dialogue: 0,0:31:26.87,0:31:28.87,Default,,0,0,0,,Ах!
Dialogue: 0,0:31:34.83,0:31:36.33,Default,,0,0,0,,Уф!
Dialogue: 0,0:31:36.33,0:31:40.35,Default,,0,0,0,,～
Dialogue: 0,0:31:40.35,0:31:44.86,Default,,0,0,0,,Адамның қанын жалаған жоқсың ғой?
Dialogue: 0,0:31:44.86,0:31:46.83,Default,,0,0,0,,Соускеге барайық!
Dialogue: 0,0:31:46.83,0:31:50.88,Default,,0,0,0,,Жоқ! Жеке адамның туа біткен кемшілік факторы ДНҚ-ның ластануы арқылы оянды!
Dialogue: 0,0:31:50.88,0:31:55.35,Default,,0,0,0,,Қайту, қайту, қайту, қайту, қайту, қайту....
Dialogue: 0,0:31:55.35,0:31:58.84,Default,,0,0,0,,Уау! О!
Dialogue: 0,0:31:58.84,0:32:02.84,Default,,0,0,0,,Грег рег рег... Иә!
Dialogue: 0,0:32:05.85,0:32:08.85,Default,,0,0,0,,Жоқ! Қуат жеткіліксіз!
Dialogue: 0,0:32:10.38,0:32:12.88,Default,,0,0,0,,Шық! Барайық!
Dialogue: 0,0:32:13.84,0:32:16.34,Default,,0,0,0,,Шық! Барайық!
Dialogue: 0,0:32:17.86,0:32:20.34,Default,,0,0,0,,～ ～
Dialogue: 0,0:32:20.34,0:32:23.35,Default,,0,0,0,,Уф! Уф! Барайық!
Dialogue: 0,0:32:23.35,0:32:26.35,Default,,0,0,0,,Бұзылған қан, тоқтатыңызшы.
Dialogue: 0,0:32:26.35,0:32:29.35,Default,,0,0,0,,Барлығы, барлығы, барлығы….
Dialogue: 0,0:32:36.84,0:32:38.86,Default,,0,0,0,,Аа...
Dialogue: 0,0:32:38.86,0:32:42.36,Default,,0,0,0,,Күткендей, ол сол кісінің қаны сіңген бала, күшті.
Dialogue: 0,0:32:47.34,0:32:51.34,Default,,0,0,0,,Мен мәңгі жас және жазықсыз қалсам жақсы болар еді...
Dialogue: 0,0:33:11.86,0:33:14.85,Default,,0,0,0,,Even if I suppress it with my power, it will only be temporary.
Dialogue: 0,0:33:14.85,0:33:17.39,Default,,0,0,0,,After all, I have to ask that person to come.
Dialogue: 0,0:33:17.39,0:33:19.39,Default,,0,0,0,,Бұл қан сенікі емес; бұл Абдулдің қаны.
Dialogue: 0,0:33:26.34,0:33:29.35,Default,,0,0,0,,Жоқ! That's too strong for you!
Dialogue: 0,0:33:29.35,0:33:32.35,Default,,0,0,0,,Тынш! Шш! Жоқ!
Dialogue: 0,0:33:32.35,0:33:35.35,Default,,0,0,0,,Қауіп, Қауіп, шаян тосқауыл босатылды.
Dialogue: 0,0:33:35.35,0:33:37.84,Default,,0,0,0,,Бұл экожүйенің тепе-теңдігін бұзады.
Dialogue: 0,0:33:37.84,0:33:39.34,Default,,0,0,0,,Calm down, calm down.
Dialogue: 0,0:33:39.34,0:33:42.91,Default,,0,0,0,,Ah, the thought of meeting that person makes my heart hurt!
Dialogue: 0,0:33:42.91,0:33:46.41,Default,,0,0,0,,It's gone It's gone It's been refined.
Dialogue: 0,0:33:54.86,0:33:57.36,Default,,0,0,0,,It's not loose here.
Dialogue: 0,0:34:00.34,0:34:03.84,Default,,0,0,0,,Уау! Ол нашар орнатылған.
Dialogue: 0,0:34:08.92,0:34:10.92,Default,,0,0,0,,I'll have to fix it later.
Dialogue: 0,0:34:17.35,0:34:20.35,Default,,0,0,0,,Even one sea fungus is a big deal.
Dialogue: 0,0:34:20.35,0:34:39.85,Default,,0,0,0,,♪♪~
Dialogue: 0,0:34:39.85,0:34:41.85,Default,,0,0,0,,Иә!?
Dialogue: 0,0:34:43.84,0:34:45.86,Default,,0,0,0,,Жақсы аяқталды.
Dialogue: 0,0:34:45.86,0:34:50.36,Default,,0,0,0,,Теңіздің күші ДНҚ спиральының әрбір бұрышына енеді.
Dialogue: 0,0:34:50.36,0:34:54.88,Default,,0,0,0,,Осы құдық толыса, теңіздің жасы қайта басталады.
Dialogue: 0,0:34:54.88,0:34:58.34,Default,,0,0,0,,Кембрий кезеңімен салыстыруға болатын тіршілік жарылысы.
Dialogue: 0,0:34:58.34,0:35:01.34,Default,,0,0,0,,Жиренішті адамдардың дәуірі аяқталады.
Dialogue: 0,0:35:06.34,0:35:08.34,Default,,0,0,0,,Бос... Бос...
Dialogue: 0,0:35:10.08,0:35:18.08,Default,,0,0,0,,♪♪~
Dialogue: 0,0:36:02.07,0:36:31.62,Default,,0,0,0,,♪♪~
Dialogue: 0,0:36:31.62,0:36:33.67,Default,,0,0,0,,♪♪~ Тістер~!
Dialogue: 0,0:36:33.67,0:36:36.09,Default,,0,0,0,,♪♪~ О! кінә! кінә!
Dialogue: 0,0:36:36.09,0:36:41.08,Default,,0,0,0,,♪♪~
Dialogue: 0,0:36:41.08,0:36:43.59,Default,,0,0,0,,♪♪~ Мен Сусукеге барамын!
Dialogue: 0,0:36:43.59,0:36:53.17,Default,,0,0,0,,♪♪~
Dialogue: 0,0:36:53.17,0:36:55.59,Default,,0,0,0,,♪♪~ (Әпкелер) А~!
Dialogue: 0,0:36:55.59,0:37:28.58,Default,,0,0,0,,♪♪~
Dialogue: 0,0:38:18.57,0:38:53.11,Default,,0,0,0,,♪♪~
Dialogue: 0,0:38:53.11,0:38:55.66,Default,,0,0,0,,♪♪~ Иә!
Dialogue: 0,0:38:55.66,0:39:14.60,Default,,0,0,0,,♪♪~
Dialogue: 0,0:39:14.60,0:39:18.10,Default,,0,0,0,,Торнадо?! ♪♪~ (Арай) Капитан! Анау, анау!
Dialogue: 0,0:39:18.10,0:39:21.67,Default,,0,0,0,,♪♪~
Dialogue: 0,0:39:21.67,0:39:24.59,Default,,0,0,0,,Цунами! ♪♪~ (Койчи) Кемені толқындарға жібер!
Dialogue: 0,0:39:24.59,0:39:26.09,Default,,0,0,0,,♪♪~
Dialogue: 0,0:39:26.09,0:39:28.58,Default,,0,0,0,,♪♪~ Не? Иә...
Dialogue: 0,0:39:28.58,0:39:32.60,Default,,0,0,0,,♪♪~
Dialogue: 0,0:39:32.60,0:39:36.07,Default,,0,0,0,,Капитан! Радио ♪♪~ Радар да пайдасыз!
Dialogue: 0,0:39:36.07,0:39:39.62,Default,,0,0,0,,♪♪~
Dialogue: 0,0:39:39.62,0:39:43.19,Default,,0,0,0,,Бұл қыз! ♪♪~ Ол Сусукемен құрдас!
Dialogue: 0,0:39:43.19,0:39:52.10,Default,,0,0,0,,♪♪~
Dialogue: 0,0:39:52.10,0:39:55.60,Default,,0,0,0,,Қош бол. кездескенше.
Dialogue: 0,0:39:56.59,0:40:00.07,Default,,0,0,0,,Көмегің үшін рахмет. (Бала күтімі қызметкері) Еңбегіңізге рахмет.
Dialogue: 0,0:40:00.07,0:40:04.09,Default,,0,0,0,,Су Чан, неге осында күтпейсің? Мұғалім, мен сізбен бірге боламын.
Dialogue: 0,0:40:04.09,0:40:06.13,Default,,0,0,0,,Жарайды, өйткені ол саңылау арқылы өтеді.
Dialogue: 0,0:40:06.13,0:40:09.07,Default,,0,0,0,,Қош бол, ұстаз. Қош бол.
Dialogue: 0,0:40:09.07,0:40:11.07,Default,,0,0,0,,Абайлаңыз.
Dialogue: 0,0:40:53.09,0:40:55.10,Default,,0,0,0,,Ах... Сосуке, кешіріңіз.
Dialogue: 0,0:40:55.10,0:40:58.10,Default,,0,0,0,,Есікті ашпадың, солай ма? Қуат сөніп қалды.
Dialogue: 0,0:40:58.10,0:41:00.58,Default,,0,0,0,,Бақша жақсы болды ма? Иә.
Dialogue: 0,0:41:00.58,0:41:03.62,Default,,0,0,0,,Лиза, жарайды, үйге қайт.
Dialogue: 0,0:41:03.62,0:41:05.66,Default,,0,0,0,,Канеко-сан, сен әлі емес пе?
Dialogue: 0,0:41:05.66,0:41:08.09,Default,,0,0,0,,Жарайды, сәл кешігіп қалдым, сенімдімін.
Dialogue: 0,0:41:08.09,0:41:11.08,Default,,0,0,0,,Біз бәрібір бүгін түнде боламыз.
Dialogue: 0,0:41:11.08,0:41:14.60,Default,,0,0,0,,Мүмкіндігінше үйге барғаныңыз жөн.
Dialogue: 0,0:41:14.60,0:41:17.08,Default,,0,0,0,,Сусуке Сәл күте тұрыңыз.
Dialogue: 0,0:41:17.08,0:41:18.58,Default,,0,0,0,,Иә.
Dialogue: 0,0:41:28.58,0:41:30.58,Default,,0,0,0,,Йоши мырза.
Dialogue: 0,0:41:30.58,0:41:36.07,Default,,0,0,0,,О, Соу-чан, қап-қара, мен жақсы көрмеймін.
Dialogue: 0,0:41:36.07,0:41:38.57,Default,,0,0,0,,Білесің бе, мен саған мынаны беремін.
Dialogue: 0,0:41:40.57,0:41:43.61,Default,,0,0,0,,Ал, бұл не?
Dialogue: 0,0:41:43.61,0:41:45.65,Default,,0,0,0,,Мен оны Норикоға да беремін.
Dialogue: 0,0:41:45.65,0:41:47.18,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:41:47.18,0:41:49.58,Default,,0,0,0,,Қап қараңғы, мен ештеңе көрмеймін.
Dialogue: 0,0:41:49.58,0:41:52.59,Default,,0,0,0,,Бұндай дауыл электр қуатын қалай үзуі мүмкін→
Dialogue: 0,0:41:52.59,0:41:56.09,Default,,0,0,0,,Сондықтан мен ұйықтағым келмейтінін айттым.
Dialogue: 0,0:41:59.09,0:42:01.58,Default,,0,0,0,,Түсіндім! жақсы.
Dialogue: 0,0:42:01.58,0:42:04.10,Default,,0,0,0,,Өте жарқын... Алтын балық!
Dialogue: 0,0:42:04.10,0:42:08.57,Default,,0,0,0,,Со-чан келгендіктен электр жарығы қосылды ма деп ойлаймын.
Dialogue: 0,0:42:08.57,0:42:11.57,Default,,0,0,0,,[Теледидар] Кенеттен орын алған өте кішкентай және қатыгез тайфун →
Dialogue: 0,0:42:11.57,0:42:14.57,Default,,0,0,0,,Өте күшті күшті сақтай отырып...
Dialogue: 0,0:42:15.59,0:42:18.08,Default,,0,0,0,,Бұл нашар теледидар.
Dialogue: 0,0:42:18.08,0:42:22.62,Default,,0,0,0,,Ауа-райы обсерваториясы да шала. Ауа райы болжамы мүлде дұрыс емес.
Dialogue: 0,0:42:22.62,0:42:25.15,Default,,0,0,0,,Со-чан, сен қазір үйдесің.
Dialogue: 0,0:42:25.15,0:42:30.07,Default,,0,0,0,,Енді алтын балық тұмарын алғандықтан, біз енді қорықпаймыз.
Dialogue: 0,0:42:30.07,0:42:31.57,Default,,0,0,0,,Иә.
Dialogue: 0,0:42:38.10,0:42:40.60,Default,,0,0,0,,Токиге де беремін.
Dialogue: 0,0:42:43.59,0:42:47.66,Default,,0,0,0,,Қытырлақ. Бұл не? бұл.
Dialogue: 0,0:42:47.66,0:42:49.16,Default,,0,0,0,,Міне.
Dialogue: 0,0:42:51.08,0:42:53.10,Default,,0,0,0,,Түсіндім! Бұл шегіртке!
Dialogue: 0,0:42:53.10,0:42:55.58,Default,,0,0,0,,Жоқ, бұл ``Коганеймару''.
Dialogue: 0,0:42:55.58,0:42:59.57,Default,,0,0,0,,Бұл Со Чанның әкесінің кемесі, солай ма? Иә.
Dialogue: 0,0:42:59.57,0:43:02.09,Default,,0,0,0,,Шегірткеге ұқсайды.
Dialogue: 0,0:43:02.09,0:43:06.63,Default,,0,0,0,,Сусуке Кешірсеңіз, барлығына сәлем айтыңыз.
Dialogue: 0,0:43:06.63,0:43:08.15,Default,,0,0,0,,Иә.
Dialogue: 0,0:43:08.15,0:43:11.10,Default,,0,0,0,,Бәріңе сау болыңдар.
Dialogue: 0,0:43:11.10,0:43:13.07,Default,,0,0,0,,Қош бол.
Dialogue: 0,0:43:13.07,0:43:16.59,Default,,0,0,0,,Жел ұшып кетпесін!
Dialogue: 0,0:43:16.59,0:43:18.59,Default,,0,0,0,,Осы жерден жүріңіз.
Dialogue: 0,0:43:23.09,0:43:25.59,Default,,0,0,0,,Мен де телефон арқылы сөйлесе алмайтын сияқтымын.
Dialogue: 0,0:43:48.59,0:43:51.09,Default,,0,0,0,,Теңіз ісіп жатыр.
Dialogue: 0,0:43:54.69,0:43:57.08,Default,,0,0,0,,Кеме суға батады ма деп ойлаймын.
Dialogue: 0,0:43:57.08,0:44:00.08,Default,,0,0,0,,Кеме теңізге шығып кетсе, дауылға жақсы төтеп береді.
Dialogue: 0,0:44:00.08,0:44:02.58,Default,,0,0,0,,Коичи де солай істейтініне сенімдімін.
Dialogue: 0,0:44:03.60,0:44:13.64,Default,,0,0,0,,♪♪~
Dialogue: 0,0:44:13.64,0:44:17.58,Default,,0,0,0,,Балық! ЛИСА Бұл балық! ♪♪~ Белбеуіңізді тақыңыз!
Dialogue: 0,0:44:17.58,0:44:28.07,Default,,0,0,0,,♪♪~
Dialogue: 0,0:44:28.07,0:44:30.59,Default,,0,0,0,,Лиза! Мен енді бұл жерден өте алмаймын!
Dialogue: 0,0:44:30.59,0:44:33.11,Default,,0,0,0,,Жаңа ғана қала тұрғындарына эвакуация туралы бұйрық берілді!
Dialogue: 0,0:44:33.11,0:44:35.67,Default,,0,0,0,,«Күнбағыс үйіндегі» эвакуация →
Dialogue: 0,0:44:35.67,0:44:38.10,Default,,0,0,0,,Бұл жерде әжелер қалды!
Dialogue: 0,0:44:38.10,0:44:42.09,Default,,0,0,0,,Бұл аралдың көлеңкесінде және жағалау биік, сондықтан жақсы!
Dialogue: 0,0:44:42.09,0:44:45.09,Default,,0,0,0,,Қалай болғанда да, мен үйге баруым керек!
Dialogue: 0,0:44:45.09,0:44:48.59,Default,,0,0,0,,Бұл мүмкін емес! Go around the mountains!
Dialogue: 0,0:44:51.08,0:44:53.63,Default,,0,0,0,,Сусуке Кеттік! иә!
Dialogue: 0,0:44:53.63,0:44:57.63,Default,,0,0,0,,Oh, stop it! A big wave has arrived!
Dialogue: 0,0:45:03.09,0:45:07.09,Default,,0,0,0,,It's coming! Қаш, Лиза!
Dialogue: 0,0:45:08.10,0:45:17.09,Default,,0,0,0,,(қозғалтқыштың соғу дыбысы)
Dialogue: 0,0:45:17.09,0:45:46.69,Default,,0,0,0,,♪♪~
Dialogue: 0,0:45:46.69,0:45:50.07,Default,,0,0,0,,Fish will follow! ♪♪~ Белбеуіңді тақ, Сусуке!
Dialogue: 0,0:45:50.07,0:45:59.07,Default,,0,0,0,,♪♪~
Dialogue: 0,0:45:59.07,0:46:00.57,Default,,0,0,0,,♪♪~ Уау!
Dialogue: 0,0:46:00.57,0:46:03.09,Default,,0,0,0,,♪♪~
Dialogue: 0,0:46:03.09,0:46:05.61,Default,,0,0,0,,♪♪~ Жүр, үрлеп жіберейік!
Dialogue: 0,0:46:05.61,0:46:57.12,Default,,0,0,0,,♪♪~
Dialogue: 0,0:46:57.12,0:46:59.68,Default,,0,0,0,,♪♪~ Қандай тұрақты толқындар!
Dialogue: 0,0:46:59.68,0:47:09.57,Default,,0,0,0,,♪♪~
Dialogue: 0,0:47:09.57,0:47:12.09,Default,,0,0,0,,The girl fell! ♪♪~ Huh!?
Dialogue: 0,0:47:12.09,0:47:14.07,Default,,0,0,0,,♪♪~ Бұл балықтың үстінде болды!
Dialogue: 0,0:47:14.07,0:47:18.58,Default,,0,0,0,,♪♪~
Dialogue: 0,0:47:18.58,0:47:20.08,Default,,0,0,0,,♪♪~ Қайда!?
Dialogue: 0,0:47:20.08,0:47:28.59,Default,,0,0,0,,♪♪~
Dialogue: 0,0:47:28.59,0:47:30.57,Default,,0,0,0,,Теңіз көтеріліп барады...
Dialogue: 0,0:47:30.57,0:47:33.09,Default,,0,0,0,,Сусуке Қызды қайдан көрдің?
Dialogue: 0,0:47:33.09,0:47:35.58,Default,,0,0,0,,Мен сол жерде балықтың үстінен жүгірдім!
Dialogue: 0,0:47:35.58,0:47:37.58,Default,,0,0,0,,Fish?
Dialogue: 0,0:47:41.07,0:47:43.57,Default,,0,0,0,,Sousuke Let's go!
Dialogue: 0,0:47:45.16,0:47:47.16,Default,,0,0,0,,Уау!
Dialogue: 0,0:47:59.07,0:48:02.57,Default,,0,0,0,,Мықты бол, Сусуке! You'll be home soon!
Dialogue: 0,0:48:26.08,0:48:27.58,Default,,0,0,0,,Ха!
Dialogue: 0,0:48:38.59,0:48:56.16,Default,,0,0,0,,♪♪~
Dialogue: 0,0:48:56.16,0:48:58.09,Default,,0,0,0,,There's a girl!
Dialogue: 0,0:48:58.09,0:49:01.08,Default,,0,0,0,,It's dangerous! Мында кел!
Dialogue: 0,0:49:01.08,0:49:03.58,Default,,0,0,0,,Сусуке мұнда жоқ!
Dialogue: 0,0:49:11.09,0:49:12.59,Default,,0,0,0,,А...!?
Dialogue: 0,0:49:29.08,0:49:32.06,Default,,0,0,0,,Сусуке: Бұл сіз танитын қыз ба?
Dialogue: 0,0:49:32.06,0:49:52.58,Default,,0,0,0,,♪♪~
Dialogue: 0,0:49:52.58,0:49:54.57,Default,,0,0,0,,Ponyo?
Dialogue: 0,0:49:54.57,0:49:57.09,Default,,0,0,0,,Иә! Бұл Понио!
Dialogue: 0,0:49:57.09,0:50:00.57,Default,,0,0,0,,It's Ponyo! Хахаха! Хахаха!
Dialogue: 0,0:50:00.57,0:50:05.58,Default,,0,0,0,,Лиза! Понё қыз болып оралды! Апыр-ай!
Dialogue: 0,0:50:05.58,0:50:07.08,Default,,0,0,0,,Егер ұсталып қалсам, ең болмағанда сені өлтіремін, Польнарефф》
Dialogue: 0,0:50:08.13,0:50:12.57,Default,,0,0,0,,Уау! Ha~haha~!
Dialogue: 0,0:50:12.57,0:50:15.09,Default,,0,0,0,,Hehehe! Хахаха~!
Dialogue: 0,0:50:15.09,0:50:18.09,Default,,0,0,0,,Сосуке осында!
Dialogue: 0,0:50:18.09,0:50:34.59,Default,,0,0,0,,♪♪~
Dialogue: 0,0:50:36.09,0:50:39.10,Default,,0,0,0,,Жарайсың ба? Сусуке және Понё.
Dialogue: 0,0:50:39.10,0:50:42.57,Default,,0,0,0,,Қанша ғажап, қандай қуанып, қайран қалсаң да→
Dialogue: 0,0:50:42.57,0:50:45.08,Default,,0,0,0,,Енді тыныштал, жарай ма?
Dialogue: 0,0:50:45.08,0:50:46.59,Default,,0,0,0,,Иә.Иә.
Dialogue: 0,0:50:46.59,0:50:48.09,Default,,0,0,0,,Жақсы бала.
Dialogue: 0,0:50:51.12,0:50:53.68,Default,,0,0,0,,Сусуке, пальтоңды шеш.
Dialogue: 0,0:50:53.68,0:50:55.60,Default,,0,0,0,,Понё жалаң аяқ.
Dialogue: 0,0:50:55.60,0:50:57.60,Default,,0,0,0,,Осыны ұстаңыз.
Dialogue: 0,0:50:59.07,0:51:01.08,Default,,0,0,0,,Ах...!
Dialogue: 0,0:51:01.08,0:51:04.08,Default,,0,0,0,,Енді мен саған сүртетін бірдеңе әкелемін.
Dialogue: 0,0:51:20.59,0:51:23.09,Default,,0,0,0,,Понё осылай! Апыр-ай!
Dialogue: 0,0:51:24.09,0:51:26.59,Default,,0,0,0,,Мен Сосукенің иісін сеземін!
Dialogue: 0,0:51:29.58,0:51:31.58,Default,,0,0,0,,Міне. Поньо!
Dialogue: 0,0:51:35.59,0:51:39.57,Default,,0,0,0,,Ұстадым! Қараңызшы, сіз дымқыл бола алмайсыз.
Dialogue: 0,0:51:39.57,0:51:43.59,Default,,0,0,0,,Ах... ааа ааа….
Dialogue: 0,0:51:43.59,0:51:46.08,Default,,0,0,0,,Понёның қызыл шашы әдемі.
Dialogue: 0,0:51:46.08,0:51:47.58,Default,,0,0,0,,Әй?
Dialogue: 0,0:51:47.58,0:51:50.62,Default,,0,0,0,,Не? Сіздің киіміңіз дымқыл емес.
Dialogue: 0,0:51:50.62,0:51:55.59,Default,,0,0,0,,Понё балық болды, сондықтан сулануға болады, солай ма?
Dialogue: 0,0:51:55.59,0:51:57.09,Default,,0,0,0,,Иә!
Dialogue: 0,0:51:58.09,0:52:00.58,Default,,0,0,0,,Понё маған бұл ұнайды!
Dialogue: 0,0:52:00.58,0:52:04.08,Default,,0,0,0,,Жарайды, онда шай ішейік.
Dialogue: 0,0:52:04.08,0:52:06.58,Default,,0,0,0,,Понё Маған жарық беріңізші.
Dialogue: 0,0:52:06.58,0:52:08.07,Default,,0,0,0,,≪Бұл жай ғана зор күшпен соққы емес➡
Dialogue: 0,0:52:08.07,0:52:10.62,Default,,0,0,0,,Енді су болады ма?
Dialogue: 0,0:52:10.62,0:52:13.12,Default,,0,0,0,,Шық! Шығу!
Dialogue: 0,0:52:16.09,0:52:19.08,Default,,0,0,0,,Бұл шықты! Ол шықты!
Dialogue: 0,0:52:19.08,0:52:22.08,Default,,0,0,0,,Өйткені төбенің басында су ыдысы бар.
Dialogue: 0,0:52:23.08,0:52:25.60,Default,,0,0,0,,Газ болады ма?
Dialogue: 0,0:52:25.60,0:52:28.09,Default,,0,0,0,,Оны киіңіз! Алақай!
Dialogue: 0,0:52:28.09,0:52:31.59,Default,,0,0,0,,Иә! Бұл пропан болғандықтан.
Dialogue: 0,0:52:33.66,0:52:36.10,Default,,0,0,0,,Енді орынға отырыңыз.
Dialogue: 0,0:52:36.10,0:52:38.08,Default,,0,0,0,,Иә. Иә.
Dialogue: 0,0:52:38.08,0:52:40.08,Default,,0,0,0,,Понё осы жолмен.
Dialogue: 0,0:52:45.10,0:52:47.60,Default,,0,0,0,,Сіз мұны осылай жасайсыз.
Dialogue: 0,0:52:50.11,0:52:52.61,Default,,0,0,0,,Сіз оны осылай қоясыз.
Dialogue: 0,0:52:54.18,0:52:56.08,Default,,0,0,0,,Мен қолымды пайдалана алмаймын.
Dialogue: 0,0:52:56.08,0:52:58.08,Default,,0,0,0,,Оның аяқтары бар!
Dialogue: 0,0:53:01.09,0:53:02.59,Default,,0,0,0,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,0:53:05.07,0:53:07.58,Default,,0,0,0,,Ой, не?
Dialogue: 0,0:53:07.58,0:53:10.58,Default,,0,0,0,,Поньоның аяғы қолға ұқсайды.
Dialogue: 0,0:53:29.58,0:53:31.58,Default,,0,0,0,,Өтінемін.
Dialogue: 0,0:53:32.59,0:53:34.09,Default,,0,0,0,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:53:38.66,0:53:40.66,Default,,0,0,0,,Ол Аня-чанның әкесі бола ма?
Dialogue: 0,0:53:57.58,0:53:59.58,Default,,0,0,0,,Хмм...!
Dialogue: 0,0:54:02.12,0:54:07.09,Default,,0,0,0,,Фу~ Фу~ Фу~.
Dialogue: 0,0:54:07.09,0:54:10.57,Default,,0,0,0,,Бу-бу-бу-бу.
Dialogue: 0,0:54:10.57,0:54:12.07,Default,,0,0,0,,Көріп тұрғаныңыздай, осы қызыл шамы бар ауданда➡
Dialogue: 0,0:54:21.62,0:54:23.62,Default,,0,0,0,,Әй... Ық!
Dialogue: 0,0:54:24.67,0:54:27.17,Default,,0,0,0,,Аа...
Dialogue: 0,0:54:28.09,0:54:31.09,Default,,0,0,0,,А, өте дәмді болды.
Dialogue: 0,0:54:31.09,0:54:34.58,Default,,0,0,0,,Енді мен не істеуім керек?
Dialogue: 0,0:54:34.58,0:54:36.58,Default,,0,0,0,,Понё Хам жақсы!
Dialogue: 0,0:54:36.58,0:54:39.08,Default,,0,0,0,,Понё ветчинаны жақсы көреді.
Dialogue: 0,0:54:40.09,0:54:42.61,Default,,0,0,0,,Енді тамақ ішейік.
Dialogue: 0,0:54:42.61,0:54:46.19,Default,,0,0,0,,Бірақ алдымен генераторды қосу керек.
Dialogue: 0,0:54:46.19,0:54:50.60,Default,,0,0,0,,Электр энергиясын өндіріп, Коичимен байланыс.
Dialogue: 0,0:54:50.60,0:54:53.60,Default,,0,0,0,,Коичи менің әкем.
Dialogue: 0,0:54:53.60,0:54:55.57,Default,,0,0,0,,Нашар шебер ме?
Dialogue: 0,0:54:55.57,0:54:59.09,Default,,0,0,0,,Жоқ, ол Коганей Марудың капитаны.
Dialogue: 0,0:54:59.09,0:55:02.09,Default,,0,0,0,,Понёның әкесі кім?
Dialogue: 0,0:55:02.09,0:55:05.11,Default,,0,0,0,,Фуджимото! Поньоны құлыптаңыз!
Dialogue: 0,0:55:05.11,0:55:08.18,Default,,0,0,0,,Сәлем. Понё қашып кетті.
Dialogue: 0,0:55:08.18,0:55:09.58,Default,,0,0,0,,Эй!
Dialogue: 0,0:55:09.58,0:55:11.60,Default,,0,0,0,,Понёның анасы кім?
Dialogue: 0,0:55:11.60,0:55:15.07,Default,,0,0,0,,Анашым, мен сізді қатты жақсы көремін!
Dialogue: 0,0:55:15.07,0:55:17.59,Default,,0,0,0,,Бұл өте қорқынышты!
Dialogue: 0,0:55:17.59,0:55:19.58,Default,,0,0,0,,Лизаға ұқсайды.
Dialogue: 0,0:55:19.58,0:55:22.08,Default,,0,0,0,,Құлайтындай… Бұл қылыш…
Dialogue: 0,0:55:24.10,0:55:26.60,Default,,0,0,0,,Понё өтінемін.
Dialogue: 0,0:55:41.60,0:55:45.07,Default,,0,0,0,,Иә? Мүмкін бензин нашарлап кеткен шығар.
Dialogue: 0,0:55:45.07,0:55:47.09,Default,,0,0,0,,Сіз кептеліп қалдыңыз ба?
Dialogue: 0,0:55:47.09,0:55:50.09,Default,,0,0,0,,Ол бітеліп қалды Ол жерде бітелген.
Dialogue: 0,0:55:51.64,0:56:01.10,Default,,0,0,0,,♪♪~
Dialogue: 0,0:56:01.10,0:56:05.09,Default,,0,0,0,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,0:56:05.09,0:56:07.09,Default,,0,0,0,,Иә!
Dialogue: 0,0:56:07.09,0:56:09.09,Default,,0,0,0,,Жарқын!
Dialogue: 0,0:56:10.09,0:56:12.59,Default,,0,0,0,,Понё керемет.
Dialogue: 0,0:56:14.08,0:56:30.58,Default,,0,0,0,,♪♪~
Dialogue: 0,0:56:30.58,0:56:32.60,Default,,0,0,0,,Антенна! Антенна!
Dialogue: 0,0:56:32.60,0:56:36.09,Default,,0,0,0,,Лиза Қызық, бәрі батып кетті ме?
Dialogue: 0,0:56:36.09,0:56:39.07,Default,,0,0,0,,Бірде-бір жарық жоқ.
Dialogue: 0,0:56:39.07,0:56:55.07,Default,,0,0,0,,♪♪~
Dialogue: 0,0:56:55.07,0:56:57.07,Default,,0,0,0,,(Радио шуы)
Dialogue: 0,0:56:57.07,0:56:58.57,Default,,0,0,0,,Шулы!
Dialogue: 0,0:56:58.57,0:57:00.59,Default,,0,0,0,,Өте алмайсыз ба?
Dialogue: 0,0:57:00.59,0:57:04.06,Default,,0,0,0,,Радиотолқындар жақсы емес сияқты.
Dialogue: 0,0:57:04.06,0:57:09.17,Default,,0,0,0,,Бұл JA4LL JA4LL.
Dialogue: 0,0:57:09.17,0:57:11.09,Default,,0,0,0,,[Радио] Коичи мені естисің бе?
Dialogue: 0,0:57:11.09,0:57:13.57,Default,,0,0,0,,[Радио] Бұл Лиза, Сусуке және Понё.
Dialogue: 0,0:57:13.57,0:57:16.08,Default,,0,0,0,,[Радио] Барлығы жақсы!
Dialogue: 0,0:57:16.08,0:57:19.06,Default,,0,0,0,,Енді тамақ ішеміз!
Dialogue: 0,0:57:19.06,0:57:21.06,Default,,0,0,0,,Хам~!!
Dialogue: 0,0:57:29.57,0:57:33.07,Default,,0,0,0,,Сіз оны енгіздіңіз бе? Күн ыстық, абай болыңыз.
Dialogue: 0,0:57:48.67,0:57:50.58,Default,,0,0,0,,Әлі жоқ.
Dialogue: 0,0:57:50.58,0:57:52.58,Default,,0,0,0,,Үш минут.
Dialogue: 0,0:58:07.13,0:58:10.08,Default,,0,0,0,,Көзіңізді жұмыңыз.
Dialogue: 0,0:58:10.08,0:58:12.08,Default,,0,0,0,,Әлі жоқ.
Dialogue: 0,0:58:13.58,0:58:16.08,Default,,0,0,0,,Понионың көздері.
Dialogue: 0,0:58:19.59,0:58:22.07,Default,,0,0,0,,Иә, жақсы.
Dialogue: 0,0:58:22.07,0:58:25.09,Default,,0,0,0,,Ләззат алыңыз!
Dialogue: 0,0:58:25.09,0:58:27.59,Default,,0,0,0,,Ах! Ах!
Dialogue: 0,0:58:31.07,0:58:34.07,Default,,0,0,0,,Хам! Понё: саған жақсы.
Dialogue: 0,0:58:34.07,0:58:35.57,Default,,0,0,0,,Ах!
Dialogue: 0,0:58:35.57,0:58:38.09,Default,,0,0,0,,Ачи! Ачи! Ачиачи...!
Dialogue: 0,0:58:38.09,0:58:55.07,Default,,0,0,0,,♪♪~
Dialogue: 0,0:58:55.07,0:58:57.57,Default,,0,0,0,,Лиза Понё ұйықтап қалды.
Dialogue: 0,0:59:04.07,0:59:07.07,Default,,0,0,0,,Понё алыстан келді ме деп ойлаймын.
Dialogue: 0,0:59:07.07,0:59:09.59,Default,,0,0,0,,Иә, мен сенімдімін...
Dialogue: 0,0:59:09.59,0:59:24.09,Default,,0,0,0,,♪♪~
Dialogue: 0,0:59:24.09,0:59:28.07,Default,,0,0,0,,Сусуке Қараңдаршы, толқындар тыныш.
Dialogue: 0,0:59:28.07,0:59:30.59,Default,,0,0,0,,Понё ұйықтап кеткендіктен шығар.
Dialogue: 0,0:59:30.59,0:59:32.59,Default,,0,0,0,,Соуске.
Dialogue: 0,0:59:39.69,0:59:42.59,Default,,0,0,0,,Ол қозғалады. Онда біреу бар.
Dialogue: 0,0:59:42.59,0:59:45.09,Default,,0,0,0,,Бұл Йоши-сан және басқалар ма?
Dialogue: 0,0:59:51.08,0:59:54.58,Default,,0,0,0,,Жоқ. Бұл тауға көтерілетін жол.
Dialogue: 0,0:59:57.62,1:00:00.62,Default,,0,0,0,,Сусуке Понёмен бірге болды.
Dialogue: 0,1:00:11.10,1:00:15.60,Default,,0,0,0,,Мен қазір өте аламын деп ойлаймын. Тауды айналып өтсем, ол жерге жетуім мүмкін.
Dialogue: 0,1:00:18.09,1:00:20.58,Default,,0,0,0,,Соусуке Мен ``Химавариге'' барамын.
Dialogue: 0,1:00:20.58,1:00:22.61,Default,,0,0,0,,Мен де барамын!
Dialogue: 0,1:00:22.61,1:00:25.68,Default,,0,0,0,,Сосуке Понёмен бірге.
Dialogue: 0,1:00:25.68,1:00:29.10,Default,,0,0,0,,Мен де барамын! Сіз де Поньоны әкелуіңіз керек!
Dialogue: 0,1:00:29.10,1:00:31.60,Default,,0,0,0,,Лизамен жүр!
Dialogue: 0,1:00:33.09,1:00:37.08,Default,,0,0,0,,Сусуке, дәл қазір бұл үй дауылдағы маяк.
Dialogue: 0,1:00:37.08,1:00:41.06,Default,,0,0,0,,Қараңғыда жүрген әрбір адам осы жарықтан қуат алады.
Dialogue: 0,1:00:41.06,1:00:44.13,Default,,0,0,0,,Сондықтан біреу болуы керек.
Dialogue: 0,1:00:44.13,1:00:46.69,Default,,0,0,0,,Көптеген оғаш нәрселер болып жатыр, дегенмен→
Dialogue: 0,1:00:46.69,1:00:51.09,Default,,0,0,0,,Дәл қазір неге екенін білмеймін, бірақ оны ақырында білесің.
Dialogue: 0,1:00:51.09,1:00:54.09,Default,,0,0,0,,Мен қазір ``Химавари'' тұрғындары үшін алаңдаймын.
Dialogue: 0,1:00:54.09,1:00:58.60,Default,,0,0,0,,Осы жерді Сусуке қорғаса, Лизаның күші күштірек болады.
Dialogue: 0,1:00:58.60,1:01:02.07,Default,,0,0,0,,Уайымдама, мен міндетті түрде қайтамын.
Dialogue: 0,1:01:02.07,1:01:04.59,Default,,0,0,0,,Косэй?
Dialogue: 0,1:01:04.59,1:01:07.14,Default,,0,0,0,,Мүлдем!
Dialogue: 0,1:01:07.14,1:01:09.18,Default,,0,0,0,,Мүлдем.
Dialogue: 0,1:01:09.18,1:01:11.58,Default,,0,0,0,,Мен Сусукені жақсы көремін.
Dialogue: 0,1:01:11.58,1:02:01.07,Default,,0,0,0,,♪♪~
Dialogue: 0,1:02:05.61,1:02:09.13,Default,,0,0,0,,Ай шықты! Сіз қала шамдарын көре аласыз!
Dialogue: 0,1:02:09.13,1:02:12.13,Default,,0,0,0,,Рахмет, енді мен өз жолымды таба аламын!
Dialogue: 0,1:02:12.13,1:02:15.13,Default,,0,0,0,,Бұл мен бұрын көрмеген қала.
Dialogue: 0,1:02:20.62,1:02:23.62,Default,,0,0,0,,Сіз Америкаға келдіңіз бе деп ойлаймын.
Dialogue: 0,1:02:39.22,1:02:41.11,Default,,0,0,0,,Хмм….
Dialogue: 0,1:02:41.11,1:02:44.61,Default,,0,0,0,,Бұл тау емес, порт емес.
Dialogue: 0,1:02:44.61,1:02:46.63,Default,,0,0,0,,Мұның бәрі кеме.
Dialogue: 0,1:02:46.63,1:02:55.62,Default,,0,0,0,,♪♪~
Dialogue: 0,1:02:55.62,1:02:59.71,Default,,0,0,0,,Теңіз суы сонда жиналып, тау құрайды.
Dialogue: 0,1:02:59.71,1:03:04.11,Default,,0,0,0,,Бұл кеме зираты. Мен сенімдімін... О дүниенің есігі ашылды!
Dialogue: 0,1:03:04.11,1:03:05.61,Default,,0,0,0,,Иә?
Dialogue: 0,1:03:08.62,1:03:10.62,Default,,0,0,0,,Қозғалтқыш тоқтады!!
Dialogue: 0,1:03:10.62,1:03:14.11,Default,,0,0,0,,Кемені толқынға шығарыңыз! Теңіз зәкірін түсірейік!
Dialogue: 0,1:03:14.11,1:03:15.61,Default,,0,0,0,,Иә!
Dialogue: 0,1:03:15.61,1:03:28.12,Default,,0,0,0,,♪♪~
Dialogue: 0,1:03:28.12,1:03:30.61,Default,,0,0,0,,♪♪~ Артынан бірдеңе келе жатыр!
Dialogue: 0,1:03:30.61,1:03:40.63,Default,,0,0,0,,♪♪~
Dialogue: 0,1:03:40.63,1:03:44.17,Default,,0,0,0,,♪♪~ (Койчи) Уау!!
Dialogue: 0,1:03:44.17,1:03:58.12,Default,,0,0,0,,♪♪~
Dialogue: 0,1:03:58.12,1:04:00.14,Default,,0,0,0,,♪♪~ Мен Каннонды көрдім!
Dialogue: 0,1:04:00.14,1:04:02.11,Default,,0,0,0,,♪♪~ Ах! иә?
Dialogue: 0,1:04:02.11,1:04:10.18,Default,,0,0,0,,♪♪~
Dialogue: 0,1:04:10.18,1:04:12.62,Default,,0,0,0,,Ол қозғалады! ♪♪~ Бұл пайдалы болды!
Dialogue: 0,1:04:12.62,1:04:16.12,Default,,0,0,0,,Бұл Каннон ♪♪~ Каннонның қасиетті өткелі!
Dialogue: 0,1:04:16.12,1:04:20.11,Default,,0,0,0,,Нанмандуб Нанмандуб ♪♪~ Нанмандуб….
Dialogue: 0,1:04:20.11,1:04:35.11,Default,,0,0,0,,♪♪~
Dialogue: 0,1:04:46.63,1:04:48.63,Default,,0,0,0,,Толығырақ….
Dialogue: 0,1:04:55.21,1:04:56.71,Default,,0,0,0,,Ха!
Dialogue: 0,1:05:02.12,1:05:04.63,Default,,0,0,0,,Толық тосқауыл қойылды.
Dialogue: 0,1:05:04.63,1:05:07.63,Default,,0,0,0,,Сен мұны қайдан білдің?
Dialogue: 0,1:05:23.62,1:05:27.61,Default,,0,0,0,,Ах! О құдайым-ай! Ол адам кейпіне енген!
Dialogue: 0,1:05:27.61,1:05:31.63,Default,,0,0,0,,А, бұл қауіпті! Эй... мұнда не істеп жүрсің!?
Dialogue: 0,1:05:31.63,1:05:34.13,Default,,0,0,0,,Уа! О! Апыр-ай!
Dialogue: 0,1:05:34.13,1:05:39.67,Default,,0,0,0,,(су балығының күлкісі)
Dialogue: 0,1:05:39.67,1:05:43.12,Default,,0,0,0,,Балалар! А, бұл қауіпті...
Dialogue: 0,1:05:43.12,1:05:47.11,Default,,0,0,0,,Уа... ау... тоқтат!
Dialogue: 0,1:05:47.11,1:05:49.13,Default,,0,0,0,,Ах!
Dialogue: 0,1:05:49.13,1:05:50.63,Default,,0,0,0,,Уау!
Dialogue: 0,1:05:54.62,1:05:58.12,Default,,0,0,0,,Әкең екеуің әпкеңді ойлағанда...
Dialogue: 0,1:06:03.11,1:06:06.61,Default,,0,0,0,,Бұл сол адам! Эй... ол келді!
Dialogue: 0,1:06:14.62,1:06:42.10,Default,,0,0,0,,♪♪~
Dialogue: 0,1:06:42.10,1:06:44.15,Default,,0,0,0,,Фуджимото….
Dialogue: 0,1:06:44.15,1:06:47.20,Default,,0,0,0,,Келдің!
Dialogue: 0,1:06:47.20,1:06:49.70,Default,,0,0,0,,Керемет теңіз!
Dialogue: 0,1:06:53.11,1:06:55.61,Default,,0,0,0,,Сиқырлы күшке толы→
Dialogue: 0,1:06:55.61,1:06:58.13,Default,,0,0,0,,Девон теңізіне қайта оралғандай.
Dialogue: 0,1:06:58.13,1:07:00.62,Default,,0,0,0,,Понё адам қанын ішті.
Dialogue: 0,1:07:00.62,1:07:04.60,Default,,0,0,0,,Мен жинаған өмір суы бітті!
Dialogue: 0,1:07:04.60,1:07:09.10,Default,,0,0,0,,Понё? Хехе... Атың жақсы шығар деп ойлаймын.
Dialogue: 0,1:07:13.61,1:07:16.60,Default,,0,0,0,,Бұл менің сәтсіздігім→
Dialogue: 0,1:07:16.60,1:07:21.10,Default,,0,0,0,,Понё сиқырды қалағанынша қолдана алады және әлемде үлкен тесік жасады.
Dialogue: 0,1:07:21.10,1:07:24.11,Default,,0,0,0,,Сіз не істеп жатқаныңызды білмейсіз→
Dialogue: 0,1:07:24.11,1:07:26.13,Default,,0,0,0,,Және адам кейпінде→
Dialogue: 0,1:07:26.13,1:07:30.16,Default,,0,0,0,,Ол адам жігітінің үйіне басып кірген болып шықты.
Dialogue: 0,1:07:30.16,1:07:34.13,Default,,0,0,0,,Бұлай жалғаса берсе, дүние жойылады!
Dialogue: 0,1:07:34.13,1:07:36.63,Default,,0,0,0,,Иә!? Ах!
Dialogue: 0,1:07:42.63,1:07:46.13,Default,,0,0,0,,Жоқ! Тіпті спутниктер де құлай бастады!
Dialogue: 0,1:07:46.13,1:07:49.67,Default,,0,0,0,,Жұлдыздың гравитациялық өрісінің ыдырауы Екінші кезең...
Dialogue: 0,1:07:49.67,1:07:52.17,Default,,0,0,0,,Тыныш...
Dialogue: 0,1:07:58.61,1:08:03.11,Default,,0,0,0,,Сусуке... Оның аты Сусуке.
Dialogue: 0,1:08:06.12,1:08:10.12,Default,,0,0,0,,Балалар сендер қарындастарыңды жақсы көресіңдер.
Dialogue: 0,1:08:13.12,1:08:17.21,Default,,0,0,0,,Эй, сен Понёны адам ете аласың.
Dialogue: 0,1:08:17.21,1:08:19.61,Default,,0,0,0,,Не?! Ескі сиқыр.
Dialogue: 0,1:08:19.61,1:08:22.13,Default,,0,0,0,,Жігіттің жүрегі селт етпесе →
Dialogue: 0,1:08:22.13,1:08:25.13,Default,,0,0,0,,Понё адам болып, сиқырынан айырылады.
Dialogue: 0,1:08:25.13,1:08:29.64,Default,,0,0,0,,Алайда, егер бұл әдіс сәтсіз болса, Поньо көпіршіктерге айналады.
Dialogue: 0,1:08:29.64,1:08:33.63,Default,,0,0,0,,О, біз әуелде көпіршіктерден туғанбыз.
Dialogue: 0,1:08:33.63,1:08:36.18,Default,,0,0,0,,Бірақ небәрі 5 жаста...→
Dialogue: 0,1:08:36.18,1:08:38.18,Default,,0,0,0,,Бұл мүмкін емес. Ш~.
Dialogue: 0,1:08:41.63,1:08:45.63,Default,,0,0,0,,Қайырлы түн, балалар.
Dialogue: 0,1:08:58.62,1:09:00.12,Default,,0,0,0,,Сусуке!
Dialogue: 0,1:09:01.14,1:09:03.11,Default,,0,0,0,,Сусуке!
Dialogue: 0,1:09:03.11,1:09:05.61,Default,,0,0,0,,Уф! Бұл~!
Dialogue: 0,1:09:07.61,1:09:09.63,Default,,0,0,0,,Понё Қайырлы таң!
Dialogue: 0,1:09:09.63,1:09:12.63,Default,,0,0,0,,Сусуке Қайырлы таң!
Dialogue: 0,1:09:15.69,1:09:18.12,Default,,0,0,0,,Қандай азап…
Dialogue: 0,1:09:18.12,1:09:21.12,Default,,0,0,0,,Теңіз осында дерлік.
Dialogue: 0,1:09:44.13,1:09:46.10,Default,,0,0,0,,Лиза жоқ.
Dialogue: 0,1:09:46.10,1:09:48.62,Default,,0,0,0,,Себебі жол батып кеткен.
Dialogue: 0,1:09:48.62,1:09:52.12,Default,,0,0,0,,Әй, кеме болса ғой.
Dialogue: 0,1:09:54.17,1:09:56.67,Default,,0,0,0,,Мұнда кеме бар.
Dialogue: 0,1:09:58.11,1:10:01.61,Default,,0,0,0,,Мен оны міне алмаймын. Мен міне аламын.
Dialogue: 0,1:10:05.60,1:10:08.60,Default,,0,0,0,,Уау...!
Dialogue: 0,1:10:08.60,1:10:10.10,Default,,0,0,0,,Ах!
Dialogue: 0,1:10:14.16,1:10:15.66,Default,,0,0,0,,Ах...
Dialogue: 0,1:10:17.21,1:10:19.21,Default,,0,0,0,,Жабыңыз!
Dialogue: 0,1:10:20.13,1:10:23.12,Default,,0,0,0,,Ой, шырақтар да үлкейіп барады.
Dialogue: 0,1:10:23.12,1:10:26.12,Default,,0,0,0,,Сіз міне аласыз! Иә, бұл таң қалдырады.
Dialogue: 0,1:10:26.12,1:10:29.13,Default,,0,0,0,,Бұл тамаша. Соны ал.
Dialogue: 0,1:10:29.13,1:10:30.63,Default,,0,0,0,,Иә!
Dialogue: 0,1:10:32.13,1:10:34.13,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,1:10:34.13,1:10:36.18,Default,,0,0,0,,Жақсы! Апыр-ай!
Dialogue: 0,1:10:36.18,1:10:40.10,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,1:10:40.10,1:10:41.60,Default,,0,0,0,,Ах!
Dialogue: 0,1:10:48.11,1:10:50.61,Default,,0,0,0,,Қалқымалы!
Dialogue: 0,1:10:50.61,1:10:54.63,Default,,0,0,0,,Хахаха! Су ағып кетпейді.
Dialogue: 0,1:10:54.63,1:10:58.20,Default,,0,0,0,,Иә, құбырды сумен толтыруымыз керек.
Dialogue: 0,1:10:58.20,1:11:01.11,Default,,0,0,0,,Осы жерден суды қосыңыз →
Dialogue: 0,1:11:01.11,1:11:04.11,Default,,0,0,0,,Оны дөңгелек орынға қойыңыз.
Dialogue: 0,1:11:04.11,1:11:29.14,Default,,0,0,0,,♪♪~
Dialogue: 0,1:11:29.14,1:11:33.14,Default,,0,0,0,,Хахаха! Зымыранға ұқсайды!
Dialogue: 0,1:11:37.63,1:11:39.66,Default,,0,0,0,,неғұрлым көп жесең, соғұрлым күшті болып, бойға биіктейсің.
Dialogue: 0,1:11:39.66,1:11:41.70,Default,,0,0,0,,Понё Сіз тамаша істеп жатырсыз.
Dialogue: 0,1:11:41.70,1:11:43.62,Default,,0,0,0,,Джожо? Иә.
Dialogue: 0,1:11:43.62,1:11:46.10,Default,,0,0,0,,Джожо? Бар жақсылықты тілеймін.
Dialogue: 0,1:11:46.10,1:11:50.60,Default,,0,0,0,,Джожо! Джожо! Джожо! Джожо!
Dialogue: 0,1:12:11.61,1:12:14.61,Default,,0,0,0,,Achii? Ачи!
Dialogue: 0,1:12:18.12,1:12:21.12,Default,,0,0,0,,Ачи! Ачи~!
Dialogue: 0,1:12:22.69,1:12:25.11,Default,,0,0,0,,А, қосылды.
Dialogue: 0,1:12:25.11,1:12:26.61,Default,,0,0,0,,Түсіндім!
Dialogue: 0,1:12:26.61,1:12:30.11,Default,,0,0,0,,Ачи! Ачи! Ачи! Ачи!
Dialogue: 0,1:12:37.62,1:12:39.64,Default,,0,0,0,,Сәлем Ачи.
Dialogue: 0,1:12:39.64,1:12:41.14,Default,,0,0,0,,Иә….
Dialogue: 0,1:12:50.13,1:12:52.13,Default,,0,0,0,,Аузыңды жап!
Dialogue: 0,1:12:53.62,1:12:56.61,Default,,0,0,0,,Сусуке Бұл тамаша. Иә.
Dialogue: 0,1:12:56.61,1:12:58.61,Default,,0,0,0,,Бұл тамаша. Иә.
Dialogue: 0,1:13:03.18,1:13:05.18,Default,,0,0,0,,Уау!
Dialogue: 0,1:13:06.19,1:13:09.71,Default,,0,0,0,,Сусуке мен бақыттымын. Иә.
Dialogue: 0,1:13:09.71,1:13:12.76,Default,,0,0,0,,Сусуке Жанып жатыр. Иә.
Dialogue: 0,1:13:12.76,1:13:15.70,Default,,0,0,0,,Сусуке Ачи.
Dialogue: 0,1:13:15.70,1:13:17.70,Default,,0,0,0,,Понё алдыңғы жағын бақылайды.
Dialogue: 0,1:13:17.70,1:13:20.18,Default,,0,0,0,,Мен рульді ұстаймын.
Dialogue: 0,1:13:20.18,1:13:22.69,Default,,0,0,0,,Иә, мен сені қадағалаймын!
Dialogue: 0,1:13:22.69,1:13:48.70,Default,,0,0,0,,♪♪~
Dialogue: 0,1:13:48.70,1:13:50.70,Default,,0,0,0,,Жол бар.
Dialogue: 0,1:13:50.70,1:13:53.20,Default,,0,0,0,,Бұл Лиза жүріп өткен тау жолы.
Dialogue: 0,1:13:54.68,1:13:57.24,Default,,0,0,0,,Лиза жоқ.
Dialogue: 0,1:13:57.24,1:14:00.74,Default,,0,0,0,,Лиза, мен осындамын. Мен сізге уәде бердім.
Dialogue: 0,1:14:05.19,1:14:08.70,Default,,0,0,0,,Бұл ежелгі балық. Бұл девон дәуіріндегі теңіз жануары.
Dialogue: 0,1:14:08.70,1:14:11.70,Default,,0,0,0,,Бұл Ботриолепис.
Dialogue: 0,1:14:15.19,1:14:17.19,Default,,0,0,0,,Бұл...
Dialogue: 0,1:14:17.19,1:14:20.23,Default,,0,0,0,,Дипнорхинх. Dipnolinks!
Dialogue: 0,1:14:20.23,1:14:22.78,Default,,0,0,0,,Уау, бұл үлкен!
Dialogue: 0,1:14:22.78,1:14:24.70,Default,,0,0,0,,Бұл Девоненкс.
Dialogue: 0,1:14:24.70,1:14:26.70,Default,,0,0,0,,Девоненкс!
Dialogue: 0,1:14:32.71,1:14:37.68,Default,,0,0,0,,Эй!
Dialogue: 0,1:14:37.68,1:14:40.23,Default,,0,0,0,,Сәлем! Бұл кеме!
Dialogue: 0,1:14:40.23,1:14:43.30,Default,,0,0,0,,Эй!
Dialogue: 0,1:14:43.30,1:14:46.20,Default,,0,0,0,,«Сәлем!»
Dialogue: 0,1:14:46.20,1:14:49.20,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:14:50.19,1:14:51.69,Default,,0,0,0,,Ачи!
Dialogue: 0,1:14:53.71,1:14:55.71,Default,,0,0,0,,Уау?
Dialogue: 0,1:14:57.70,1:15:00.70,Default,,0,0,0,,Уау! Мен мұны қалай істеу керектігін білемін.
Dialogue: 0,1:15:03.79,1:15:05.71,Default,,0,0,0,,Понё Жарайды!
Dialogue: 0,1:15:05.71,1:15:07.21,Default,,0,0,0,,Боу!
Dialogue: 0,1:15:11.71,1:15:14.20,Default,,0,0,0,,Сәлеметсіз бе. Сәлем.
Dialogue: 0,1:15:14.20,1:15:16.68,Default,,0,0,0,,Ей, бұл керемет қайық.
Dialogue: 0,1:15:16.68,1:15:20.22,Default,,0,0,0,,Мен біреуді ойласам, Со-чан болды. Лиза-сан және мынау.
Dialogue: 0,1:15:20.22,1:15:22.77,Default,,0,0,0,,Бұл Су Чан емес, Сосуке.
Dialogue: 0,1:15:22.77,1:15:24.69,Default,,0,0,0,,Бұл Понио.
Dialogue: 0,1:15:24.69,1:15:27.69,Default,,0,0,0,,Понё Бұл балық болды.
Dialogue: 0,1:15:27.69,1:15:32.20,Default,,0,0,0,,Балық? Хехехе Понё деген керемет есім.
Dialogue: 0,1:15:32.20,1:15:34.20,Default,,0,0,0,,Әй!
Dialogue: 0,1:15:34.20,1:15:38.19,Default,,0,0,0,,Лиза аға, білмейсіз бе? (Жас жігіт) Лиза?
Dialogue: 0,1:15:38.19,1:15:40.24,Default,,0,0,0,,Біз бірге болған жоқпыз.
Dialogue: 0,1:15:40.24,1:15:43.29,Default,,0,0,0,,Мен ``Химавари''-ге бардым. «Күнбағыста»?
Dialogue: 0,1:15:43.29,1:15:45.29,Default,,0,0,0,,Бала.
Dialogue: 0,1:16:05.73,1:16:08.23,Default,,0,0,0,,Ух... у...
Dialogue: 0,1:16:12.69,1:16:14.67,Default,,0,0,0,,Уф….
Dialogue: 0,1:16:14.67,1:16:17.68,Default,,0,0,0,,Әй, не болып жатыр?
Dialogue: 0,1:16:17.68,1:16:22.68,Default,,0,0,0,,Уф...
Dialogue: 0,1:16:22.68,1:16:25.68,Default,,0,0,0,,Иә! Жақсы, оны маған бере аласыз ба?
Dialogue: 0,1:16:38.68,1:16:40.68,Default,,0,0,0,,Маған аздап қарыз беріңізші.
Dialogue: 0,1:16:45.19,1:16:47.19,Default,,0,0,0,,Рахмет.
Dialogue: 0,1:16:47.19,1:16:49.19,Default,,0,0,0,,Мен оны аламын.
Dialogue: 0,1:16:52.21,1:16:54.76,Default,,0,0,0,,Әй, дәмді сорпа!
Dialogue: 0,1:16:54.76,1:16:57.18,Default,,0,0,0,,Лиза орындады.
Dialogue: 0,1:16:57.18,1:16:59.69,Default,,0,0,0,,Балақай!
Dialogue: 0,1:16:59.69,1:17:04.69,Default,,0,0,0,,Ой, кешіріңіз, бала әлі сорпа іше алмайды.
Dialogue: 0,1:17:04.69,1:17:09.20,Default,,0,0,0,,Бірақ мен оны ішсем, ол кеудеге айналады және оны бала ішеді.
Dialogue: 0,1:17:09.20,1:17:11.20,Default,,0,0,0,,Хмм….
Dialogue: 0,1:17:11.20,1:17:13.75,Default,,0,0,0,,Мен де Лизаның кеудесін іштім.
Dialogue: 0,1:17:13.75,1:17:17.20,Default,,0,0,0,,Понё, мына сорпаны алуға бола ма?
Dialogue: 0,1:17:17.20,1:17:19.17,Default,,0,0,0,,Иә, жақсы.
Dialogue: 0,1:17:19.17,1:17:21.71,Default,,0,0,0,,Рахмет.
Dialogue: 0,1:17:21.71,1:17:24.69,Default,,0,0,0,,Эйса!
Dialogue: 0,1:17:24.69,1:17:38.21,Default,,0,0,0,,Эйса! Эйса! Эйса! Эйса!
Dialogue: 0,1:17:38.21,1:17:42.20,Default,,0,0,0,,Бұл қала тұрғындары. Бұл қайық фестивалі сияқты.
Dialogue: 0,1:17:42.20,1:17:47.20,Default,,0,0,0,,Сәлем! Сізге көмектесе алатын бір нәрсе бар ма?
Dialogue: 0,1:17:47.20,1:17:52.72,Default,,0,0,0,,Рахмет! Қазір бәрі жақсы!
Dialogue: 0,1:17:52.72,1:17:58.18,Default,,0,0,0,,Енді конвойдың соңынан еріңіз! Таудағы қонақүйге көшейік!
Dialogue: 0,1:17:58.18,1:18:01.68,Default,,0,0,0,,Иә, түсіндім!
Dialogue: 0,1:18:02.68,1:18:04.68,Default,,0,0,0,,Олар өте көп.
Dialogue: 0,1:18:04.68,1:18:07.19,Default,,0,0,0,,Жақсы. Барлығы жақсы ма?
Dialogue: 0,1:18:07.19,1:18:11.19,Default,,0,0,0,,Понё Мен от жағамын. Сәл күте тұрыңыз...
Dialogue: 0,1:18:16.28,1:18:18.20,Default,,0,0,0,,Бұл кеуделер.
Dialogue: 0,1:18:18.20,1:18:20.20,Default,,0,0,0,,Жақсы!
Dialogue: 0,1:18:20.20,1:18:22.18,Default,,0,0,0,,Сиськи!
Dialogue: 0,1:18:22.18,1:18:24.70,Default,,0,0,0,,Понё ветчинаның бәрін жеп қойды.
Dialogue: 0,1:18:24.70,1:18:28.19,Default,,0,0,0,,Рахмет. Сіздің кеуделеріңіз әдемі болатынына сенімдімін.
Dialogue: 0,1:18:28.19,1:18:32.19,Default,,0,0,0,,Сусуке-кун, менде қалдық бар, мынау сенде бар ма?
Dialogue: 0,1:18:32.19,1:18:36.28,Default,,0,0,0,,Иә, Понё оны үлкейтеді Рахмет!
Dialogue: 0,1:18:36.28,1:18:39.28,Default,,0,0,0,,Абайлаңыз. Рақмет сізге.
Dialogue: 0,1:18:43.69,1:18:46.69,Default,,0,0,0,,Не болды?
Dialogue: 0,1:18:46.69,1:18:51.20,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:18:51.20,1:18:55.70,Default,,0,0,0,,Жарайды, жарайды, жарайды.... (жылау)
Dialogue: 0,1:18:55.70,1:18:59.74,Default,,0,0,0,,♪♪~
Dialogue: 0,1:18:59.74,1:19:01.27,Default,,0,0,0,,♪♪~ Ах!
Dialogue: 0,1:19:01.27,1:19:03.19,Default,,0,0,0,,♪♪~
Dialogue: 0,1:19:03.19,1:19:04.69,Default,,0,0,0,,♪♪~ Ах!
Dialogue: 0,1:19:04.69,1:19:11.68,Default,,0,0,0,,♪♪~
Dialogue: 0,1:19:11.68,1:19:13.70,Default,,0,0,0,,♪♪~ Понё!
Dialogue: 0,1:19:13.70,1:19:22.18,Default,,0,0,0,,♪♪~
Dialogue: 0,1:19:22.18,1:19:23.68,Default,,0,0,0,,♪♪~ Жақсы….
Dialogue: 0,1:19:23.68,1:19:26.20,Default,,0,0,0,,♪♪~
Dialogue: 0,1:19:26.20,1:19:28.70,Default,,0,0,0,,Со-чан! Су-чан!
Dialogue: 0,1:19:28.70,1:19:30.70,Default,,0,0,0,,Бұл тамаша. Лиза ше?
Dialogue: 0,1:19:30.70,1:19:32.69,Default,,0,0,0,,Лизаға не болды?
Dialogue: 0,1:19:32.69,1:19:36.19,Default,,0,0,0,,Мен «Химавариге» бардым, мен сені алып кетуге келемін!
Dialogue: 0,1:19:36.19,1:19:39.26,Default,,0,0,0,,Сонымен, Лиза-сан бұл толқыннан өтті!
Dialogue: 0,1:19:39.26,1:19:42.70,Default,,0,0,0,,Керемет! Сусуке! Маған да мінуге рұқсат етіңіз!
Dialogue: 0,1:19:42.70,1:19:46.19,Default,,0,0,0,,Кумико-чан, менің қолым бос емес, кейінірек кел!
Dialogue: 0,1:19:46.19,1:19:49.69,Default,,0,0,0,,"Химавари" тұрғындары Маеяма саябағына эвакуациялануда!
Dialogue: 0,1:19:49.69,1:19:52.19,Default,,0,0,0,,Қатты! жалғастыра бер!
Dialogue: 0,1:19:52.19,1:19:56.21,Default,,0,0,0,,Бос уақытымыз бола салысымен, біздің қайығымыз да «Химавариге» барады!
Dialogue: 0,1:19:56.21,1:19:58.76,Default,,0,0,0,,Тынымсыз жұмыс күтіңіз!
Dialogue: 0,1:19:58.76,1:20:47.21,Default,,0,0,0,,♪♪~
Dialogue: 0,1:20:47.21,1:20:50.71,Default,,0,0,0,,Понё Мен шамды ауыстыруым керек.
Dialogue: 0,1:20:53.69,1:20:58.19,Default,,0,0,0,,Жарайды, менде бұрын алғаныңыз бар.
Dialogue: 0,1:20:58.19,1:21:01.19,Default,,0,0,0,,Ачи! Әлі ыстық.
Dialogue: 0,1:21:05.68,1:21:09.24,Default,,0,0,0,,Қош… сау бол….
Dialogue: 0,1:21:09.24,1:21:13.19,Default,,0,0,0,,Понё Сіз мұны үлкейте аласыз ба?
Dialogue: 0,1:21:13.19,1:21:15.19,Default,,0,0,0,,Жарайды….
Dialogue: 0,1:21:19.70,1:21:23.20,Default,,0,0,0,,Понё, ұйықтап жатырсың ба?
Dialogue: 0,1:21:29.76,1:21:32.76,Default,,0,0,0,,Понё? иә?
Dialogue: 0,1:21:34.69,1:21:36.19,Default,,0,0,0,,Әй!
Dialogue: 0,1:21:46.71,1:21:49.71,Default,,0,0,0,,Понё? Поньо?
Dialogue: 0,1:22:17.27,1:22:47.18,Default,,0,0,0,,♪♪~
Dialogue: 0,1:22:47.18,1:22:49.70,Default,,0,0,0,,♪♪~ Жабыңыз! Мен аяғымды таптым!
Dialogue: 0,1:22:49.70,1:23:11.19,Default,,0,0,0,,♪♪~
Dialogue: 0,1:23:11.19,1:23:12.69,Default,,0,0,0,,♪♪~ Ах.
Dialogue: 0,1:23:12.69,1:23:15.68,Default,,0,0,0,,♪♪~
Dialogue: 0,1:23:15.68,1:23:17.70,Default,,0,0,0,,♪♪~ Жол бар.
Dialogue: 0,1:23:17.70,1:23:27.24,Default,,0,0,0,,♪♪~
Dialogue: 0,1:23:27.24,1:23:29.28,Default,,0,0,0,,Ах!
Dialogue: 0,1:23:29.28,1:23:31.78,Default,,0,0,0,,Ах! Қайық!
Dialogue: 0,1:23:33.21,1:23:34.71,Default,,0,0,0,,Понё!
Dialogue: 0,1:23:34.71,1:23:53.70,Default,,0,0,0,,♪♪~
Dialogue: 0,1:23:53.70,1:23:55.68,Default,,0,0,0,,Понё!
Dialogue: 0,1:23:55.68,1:23:58.68,Default,,0,0,0,,Понё оян!
Dialogue: 0,1:24:00.17,1:24:03.17,Default,,0,0,0,,Сусуке….
Dialogue: 0,1:24:04.68,1:24:08.21,Default,,0,0,0,,Fa...
Dialogue: 0,1:24:08.21,1:24:10.27,Default,,0,0,0,,Құдайға шүкір.
Dialogue: 0,1:24:10.27,1:24:13.77,Default,,0,0,0,,Мен Понё алтын балыққа айналады деп ойладым.
Dialogue: 0,1:24:20.69,1:24:22.19,Default,,0,0,0,,Ха!
Dialogue: 0,1:24:25.20,1:24:27.18,Default,,0,0,0,,Бұл Лисакар!
Dialogue: 0,1:24:27.18,1:24:29.68,Default,,0,0,0,,Понё Лизаның көлігі сонда болды!
Dialogue: 0,1:24:33.21,1:24:35.24,Default,,0,0,0,,Лиза~!
Dialogue: 0,1:24:35.24,1:24:36.74,Default,,0,0,0,,Лиза!
Dialogue: 0,1:24:38.19,1:24:40.20,Default,,0,0,0,,Лиза~!!
Dialogue: 0,1:24:40.20,1:24:42.20,Default,,0,0,0,,Лиза!
Dialogue: 0,1:24:43.68,1:24:45.68,Default,,0,0,0,,Лиза~!!
Dialogue: 0,1:24:47.70,1:24:49.70,Default,,0,0,0,,Лиза~!!
Dialogue: 0,1:24:50.71,1:24:52.21,Default,,0,0,0,,Лиза!
Dialogue: 0,1:24:54.24,1:24:55.74,Default,,0,0,0,,Лиза!
Dialogue: 0,1:24:57.70,1:24:59.70,Default,,0,0,0,,Лиза~!!
Dialogue: 0,1:25:02.70,1:25:04.20,Default,,0,0,0,,Лиза!!
Dialogue: 0,1:25:04.20,1:25:32.20,Default,,0,0,0,,♪♪~
Dialogue: 0,1:25:32.20,1:25:34.68,Default,,0,0,0,,♪♪~ Сусуке Кемеде.
Dialogue: 0,1:25:34.68,1:25:37.72,Default,,0,0,0,,♪♪~ Көзіңнен су шығып жатыр.
Dialogue: 0,1:25:37.72,1:25:44.19,Default,,0,0,0,,♪♪~
Dialogue: 0,1:25:44.19,1:25:48.18,Default,,0,0,0,,Лизаны іздейік. ♪♪~ Иә.
Dialogue: 0,1:25:48.18,1:25:58.18,Default,,0,0,0,,♪♪~
Dialogue: 0,1:26:10.22,1:26:28.32,Default,,0,0,0,,♪♪~
Dialogue: 0,1:26:28.32,1:26:33.25,Default,,0,0,0,,Ахахаха! Ах ха ха ха!
Dialogue: 0,1:26:33.25,1:26:36.72,Default,,0,0,0,,Күте тұрыңыз, төсеніш көрпе. Жарайды, солай емес пе?
Dialogue: 0,1:26:36.72,1:26:40.74,Default,,0,0,0,,Тезірек келіңіз, Кит мырза. Бұл тамаша!
Dialogue: 0,1:26:40.74,1:26:43.74,Default,,0,0,0,,Одан кейінгі өмір де жақсы! Менің де тізем ауырмайды.
Dialogue: 0,1:26:43.74,1:26:46.78,Default,,0,0,0,,Қорықпау керек еді. (Норико) Бұл кейінгі өмір ме?
Dialogue: 0,1:26:46.78,1:26:51.25,Default,,0,0,0,,Мен бұл Рюгуджо деп ойладым ба? Ахахха!
Dialogue: 0,1:26:51.25,1:26:55.23,Default,,0,0,0,,Сәлем бәріңе! Бірге келіңіздер!
Dialogue: 0,1:26:55.23,1:26:58.24,Default,,0,0,0,,Иә! Барайық!
Dialogue: 0,1:26:58.24,1:27:00.24,Default,,0,0,0,,Хахаха!
Dialogue: 0,1:27:00.24,1:27:02.22,Default,,0,0,0,,Жүгіре білу керемет.
Dialogue: 0,1:27:02.22,1:27:04.72,Default,,0,0,0,,Алға!
Dialogue: 0,1:27:07.80,1:27:11.22,Default,,0,0,0,,1 орын! Ахахха!
Dialogue: 0,1:27:11.22,1:27:14.22,Default,,0,0,0,,Кайо-сан жылдам!
Dialogue: 0,1:27:14.22,1:27:16.74,Default,,0,0,0,,Барлығың тыныш болыңдар!
Dialogue: 0,1:27:16.74,1:27:19.74,Default,,0,0,0,,Тағдырлы сәт ақыры жақындап қалды →
Dialogue: 0,1:27:19.74,1:27:22.23,Default,,0,0,0,,Соуске-кун мен Понё осында келе жатыр.
Dialogue: 0,1:27:22.23,1:27:25.75,Default,,0,0,0,,Кя~ Не істеуім керек! Бұл махаббаттың сынағы.
Dialogue: 0,1:27:25.75,1:27:29.32,Default,,0,0,0,,Жүрегім дүрсілдеп кетті. Ахахха!
Dialogue: 0,1:27:29.32,1:27:33.72,Default,,0,0,0,,Тыныш! Баршаңыз осы қасиетті сынақтың куәсісіздер.
Dialogue: 0,1:27:33.72,1:27:36.73,Default,,0,0,0,,Біраз күтіңіз.
Dialogue: 0,1:27:36.73,1:27:38.73,Default,,0,0,0,,Фуджимото мырза →
Dialogue: 0,1:27:38.73,1:27:42.25,Default,,0,0,0,,Менің ойымша, ол Су-чанға немесе Понёға қорқынышты ештеңе жасамайды, солай ма?
Dialogue: 0,1:27:42.25,1:27:45.23,Default,,0,0,0,,≪Иә! ≫ ≪Әрине! ≫
Dialogue: 0,1:27:45.23,1:27:49.77,Default,,0,0,0,,Әрине, Понё ұйықтағанша...
Dialogue: 0,1:27:49.77,1:27:51.27,Default,,0,0,0,,Сонымен.
Dialogue: 0,1:27:59.73,1:28:02.22,Default,,0,0,0,,Менің ойымша, ол жақсы адам, бірақ...
Dialogue: 0,1:28:02.22,1:28:04.74,Default,,0,0,0,,Лиза, қалыңыз қалай?
Dialogue: 0,1:28:04.74,1:28:10.24,Default,,0,0,0,,Қараңдаршы, мен сол жерде Понёның анасымен сөйлесіп жатырмын.
Dialogue: 0,1:28:17.32,1:28:20.22,Default,,0,0,0,,Лиза, бұл қиын болуы керек.
Dialogue: 0,1:28:20.22,1:28:22.74,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,1:28:22.74,1:28:26.23,Default,,0,0,0,,Мен сені шақырамын, Лиза!
Dialogue: 0,1:28:26.23,1:28:29.73,Default,,0,0,0,,Лиза!
Dialogue: 0,1:28:34.75,1:28:41.75,Default,,0,0,0,,Біз бәріміз Сосуке мен Понёның жағындамыз!
Dialogue: 0,1:28:54.72,1:28:57.72,Default,,0,0,0,,Лиза! Уайымдайсыз ба?
Dialogue: 0,1:28:57.72,1:29:00.76,Default,,0,0,0,,Соучан жарайсың, күшті қыз!
Dialogue: 0,1:29:00.76,1:29:02.80,Default,,0,0,0,,Тура бала!
Dialogue: 0,1:29:02.80,1:29:06.73,Default,,0,0,0,,Рахмет, бәрімізге қолдау көрсетіңіздер.
Dialogue: 0,1:29:06.73,1:29:09.23,Default,,0,0,0,,Иә! әрине!
Dialogue: 0,1:29:15.72,1:29:18.22,Default,,0,0,0,,Поньо туннелі.
Dialogue: 0,1:29:32.74,1:29:36.21,Default,,0,0,0,,Мен бұл жерден бұрын да өткенмін.
Dialogue: 0,1:29:36.21,1:29:38.23,Default,,0,0,0,,Понё?
Dialogue: 0,1:29:38.23,1:29:40.73,Default,,0,0,0,,Мен бұл жерді жек көремін...
Dialogue: 0,1:29:43.72,1:29:46.24,Default,,0,0,0,,Босатпаңыз.
Dialogue: 0,1:29:46.24,1:29:48.24,Default,,0,0,0,,Хмм….
Dialogue: 0,1:30:08.21,1:30:19.74,Default,,0,0,0,,(шелек сүйреп бара жатқан дыбыс)
Dialogue: 0,1:30:19.74,1:30:21.24,Default,,0,0,0,,Ах!?
Dialogue: 0,1:30:23.73,1:30:26.21,Default,,0,0,0,,Понё!
Dialogue: 0,1:30:26.21,1:30:45.25,Default,,0,0,0,,♪♪~
Dialogue: 0,1:30:45.25,1:30:46.73,Default,,0,0,0,,♪♪~ Понё!
Dialogue: 0,1:30:46.73,1:30:54.24,Default,,0,0,0,,♪♪~
Dialogue: 0,1:30:54.24,1:30:55.74,Default,,0,0,0,,♪♪~ Понё!
Dialogue: 0,1:30:55.74,1:30:58.74,Default,,0,0,0,,♪♪~ Ах... Ах....
Dialogue: 0,1:30:58.74,1:31:17.23,Default,,0,0,0,,♪♪~
Dialogue: 0,1:31:17.23,1:31:19.75,Default,,0,0,0,,Понё! Өлсең жақсы емес!
Dialogue: 0,1:31:19.75,1:31:21.25,Default,,0,0,0,,Понё!
Dialogue: 0,1:31:22.23,1:31:24.75,Default,,0,0,0,,Понё! Поньоны оят!
Dialogue: 0,1:31:24.75,1:31:28.32,Default,,0,0,0,,Ши~! Мені оятпа.
Dialogue: 0,1:31:28.32,1:31:30.73,Default,,0,0,0,,Сусуке-кун, сені осында көргеніме қуаныштымын.
Dialogue: 0,1:31:30.73,1:31:34.75,Default,,0,0,0,,Лиза мен әжелер барлығы күтіп отыр.
Dialogue: 0,1:31:34.75,1:31:36.25,Default,,0,0,0,,Лиза?
Dialogue: 0,1:31:36.25,1:31:40.25,Default,,0,0,0,,Менімен келесің бе? Понёмен бірге.
Dialogue: 0,1:31:42.24,1:31:45.24,Default,,0,0,0,,Понёны ұйықтатып тастап, кеттік...
Dialogue: 0,1:31:45.24,1:31:47.79,Default,,0,0,0,,≪Сусуке~! ≫ иә!?
Dialogue: 0,1:31:47.79,1:31:51.25,Default,,0,0,0,,Ол жігітке алданба!
Dialogue: 0,1:31:51.25,1:31:54.72,Default,,0,0,0,,Жақсы сөз айтып, бәрін алып кетті!
Dialogue: 0,1:31:54.72,1:31:58.24,Default,,0,0,0,,Токи-сан! Мен алданбаймын!
Dialogue: 0,1:31:58.24,1:32:01.74,Default,,0,0,0,,Сондықтан біздің уақытымыз жоқ!
Dialogue: 0,1:32:01.74,1:32:04.23,Default,,0,0,0,,Сіз мұны көрмейсіз бе?
Dialogue: 0,1:32:04.23,1:32:07.80,Default,,0,0,0,,Ай жақындаса, артқа жол жоқ!
Dialogue: 0,1:32:07.80,1:32:11.22,Default,,0,0,0,,Өтірік болса, одан жақсы өтірік ойлап тап!
Dialogue: 0,1:32:11.22,1:32:14.22,Default,,0,0,0,,Әй, моо! Сусуке, мұнда кел!
Dialogue: 0,1:32:14.22,1:32:16.24,Default,,0,0,0,,Сусуке-кун, бірге барайық!
Dialogue: 0,1:32:16.24,1:32:19.74,Default,,0,0,0,,Әлемді тек сіз ғана құтқара аласыз! Мен зорлық-зомбылық көрсеткім келмейді.
Dialogue: 0,1:32:19.74,1:32:21.24,Default,,0,0,0,,Ах!
Dialogue: 0,1:32:21.24,1:32:22.74,Default,,0,0,0,,Понё!
Dialogue: 0,1:32:22.74,1:32:26.80,Default,,0,0,0,,Ах! Нағыз әкеме не істеу керек!
Dialogue: 0,1:32:26.80,1:32:32.74,Default,,0,0,0,,♪♪~
Dialogue: 0,1:32:32.74,1:32:34.74,Default,,0,0,0,,♪♪~ Понё!
Dialogue: 0,1:32:34.74,1:32:37.74,Default,,0,0,0,,♪♪~ Сусуке! Кәне!
Dialogue: 0,1:32:37.74,1:32:39.73,Default,,0,0,0,,♪♪~ Бұл дұрыс емес!
Dialogue: 0,1:32:39.73,1:32:44.73,Default,,0,0,0,,♪♪~
Dialogue: 0,1:32:44.73,1:32:46.75,Default,,0,0,0,,♪♪~ Бар күшіңізді салыңыз!
Dialogue: 0,1:32:46.75,1:32:48.27,Default,,0,0,0,,♪♪~
Dialogue: 0,1:32:48.27,1:32:50.32,Default,,0,0,0,,♪♪~ Тобина~!
Dialogue: 0,1:32:50.32,1:33:09.75,Default,,0,0,0,,♪♪~
Dialogue: 0,1:33:16.72,1:33:27.21,Default,,0,0,0,,♪♪~
Dialogue: 0,1:33:27.21,1:33:31.23,Default,,0,0,0,,♪♪~ Ах! Сіз жігіттер!
Dialogue: 0,1:33:31.23,1:34:25.75,Default,,0,0,0,,♪♪~
Dialogue: 0,1:34:25.75,1:34:27.79,Default,,0,0,0,,Лиза! ♪♪~ Сусуке.
Dialogue: 0,1:34:27.79,1:34:29.32,Default,,0,0,0,,♪♪~ Понё!
Dialogue: 0,1:34:29.32,1:34:33.73,Default,,0,0,0,,♪♪~
Dialogue: 0,1:34:33.73,1:34:35.74,Default,,0,0,0,,♪♪~ Мына жаққа қара!
Dialogue: 0,1:34:35.74,1:34:38.23,Default,,0,0,0,,♪♪~ Бұл қайда...?
Dialogue: 0,1:34:38.23,1:34:47.74,Default,,0,0,0,,♪♪~
Dialogue: 0,1:34:47.74,1:34:50.29,Default,,0,0,0,,Сосуке-сан, солай ма?
Dialogue: 0,1:34:50.29,1:34:53.75,Default,,0,0,0,,Сәлеметсіз бе, Понёның анасы?
Dialogue: 0,1:34:53.75,1:34:55.71,Default,,0,0,0,,Иә→
Dialogue: 0,1:34:55.71,1:35:00.22,Default,,0,0,0,,Сіз Поньоны жиі алып келетінсіз. Рақмет сізге.
Dialogue: 0,1:35:00.22,1:35:03.74,Default,,0,0,0,,Сусуке-сан Понё адам болғысы келеді →
Dialogue: 0,1:35:03.74,1:35:06.73,Default,,0,0,0,,Мен сиқырлы қақпақты аштым.
Dialogue: 0,1:35:06.73,1:35:10.81,Default,,0,0,0,,Поньоның шынайы түрін біле тұра адам болу→
Dialogue: 0,1:35:10.81,1:35:14.23,Default,,0,0,0,,Осыған көнетін бір бала бар.
Dialogue: 0,1:35:14.23,1:35:18.74,Default,,0,0,0,,Понёның балық екенін білдіңіз бе?
Dialogue: 0,1:35:18.74,1:35:20.24,Default,,0,0,0,,Иә.
Dialogue: 0,1:35:20.24,1:35:23.74,Default,,0,0,0,,Понё сенің қаныңды жалап, жартылай су перісіне айналды.
Dialogue: 0,1:35:23.74,1:35:28.75,Default,,0,0,0,,Түсіндім! Понё менің жарақатымды жалап, мені емдеді.
Dialogue: 0,1:35:28.75,1:35:31.82,Default,,0,0,0,,Сондықтан мен жартылай су перісі болдым.
Dialogue: 0,1:35:31.82,1:35:36.22,Default,,0,0,0,,Поньоның шынайы тұлғасы жартылай су перісі болса, дұрыс па?
Dialogue: 0,1:35:36.22,1:35:39.72,Default,,0,0,0,,Иә! Мен, балық Понё және жартылай теңізші Понё →
Dialogue: 0,1:35:39.72,1:35:43.22,Default,,0,0,0,,Барлығы адам Поньоны жақсы көреді.
Dialogue: 0,1:35:45.73,1:35:48.73,Default,,0,0,0,,Аха, хехе...
Dialogue: 0,1:35:48.73,1:35:52.23,Default,,0,0,0,,Хэхехе...
Dialogue: 0,1:35:56.74,1:35:59.74,Default,,0,0,0,,Понё, мұнда кел.
Dialogue: 0,1:36:13.31,1:36:18.81,Default,,0,0,0,,Понё Сосуке сіздің агентіңіз болады.
Dialogue: 0,1:36:20.75,1:36:25.25,Default,,0,0,0,,Адам болу үшін сиқырдан бас тарту керек→
Dialogue: 0,1:36:25.25,1:36:27.22,Default,,0,0,0,,Сіз мұны істей аласыз ба?
Dialogue: 0,1:36:27.22,1:36:29.22,Default,,0,0,0,,Иә!
Dialogue: 0,1:36:37.30,1:36:40.72,Default,,0,0,0,,Бұл көпіршікті жер бетіне қайтып келгенде сүйіңіз.
Dialogue: 0,1:36:40.72,1:36:45.72,Default,,0,0,0,,Понё да сен сияқты 5 жасар қыз болады.
Dialogue: 0,1:36:48.23,1:36:51.23,Default,,0,0,0,,Понё сізге жақсы.
Dialogue: 0,1:36:51.23,1:36:54.23,Default,,0,0,0,,Рахмет, Понёның анасы.
Dialogue: 0,1:36:59.72,1:37:03.74,Default,,0,0,0,,Барлығы, дүниедегі жарықтар жабылды!
Dialogue: 0,1:37:03.74,1:37:06.23,Default,,0,0,0,,Уау! Алақай!
Dialogue: 0,1:37:06.23,1:37:08.71,Default,,0,0,0,,Со-чан, сен кереметсің!
Dialogue: 0,1:37:08.71,1:37:12.71,Default,,0,0,0,,Сусуке! Сусуке!
Dialogue: 0,1:37:14.24,1:37:17.24,Default,,0,0,0,,Сусуке….
Dialogue: 0,1:37:19.22,1:37:32.24,Default,,0,0,0,,♪♪~
Dialogue: 0,1:37:32.24,1:37:34.26,Default,,0,0,0,,♪♪~ Ах...!
Dialogue: 0,1:37:34.26,1:37:40.21,Default,,0,0,0,,♪♪~
Dialogue: 0,1:37:40.21,1:37:42.73,Default,,0,0,0,,♪♪~ Лизаға рахмет.
Dialogue: 0,1:37:42.73,1:37:45.73,Default,,0,0,0,,Сіз де! ♪♪~ Бие әже!
Dialogue: 0,1:37:45.73,1:37:52.23,Default,,0,0,0,,♪♪~
Dialogue: 0,1:37:56.78,1:38:00.28,Default,,0,0,0,,Бәріңе сәлем! Сіз амансыз деп үміттенемін!
Dialogue: 0,1:38:04.72,1:38:07.24,Default,,0,0,0,,Мен саған қазір мүгедектер арбасын әкелемін!
Dialogue: 0,1:38:07.24,1:38:09.72,Default,,0,0,0,,Жарайды, жаяу барамыз.
Dialogue: 0,1:38:09.72,1:38:11.72,Default,,0,0,0,,Бұл жанды.
Dialogue: 0,1:38:14.75,1:38:17.23,Default,,0,0,0,,Бұл... сенің кемең.
Dialogue: 0,1:38:17.23,1:38:20.77,Default,,0,0,0,,Ай! Сен эскиз салмайсың ба!?
Dialogue: 0,1:38:20.77,1:38:22.80,Default,,0,0,0,,Бәрі үшін кешірім сұраймын.
Dialogue: 0,1:38:22.80,1:38:25.80,Default,,0,0,0,,Мм... жарайды ма?
Dialogue: 0,1:38:30.23,1:38:32.73,Default,,0,0,0,,Понёға қамқорлық жасаңыз.
Dialogue: 0,1:38:34.72,1:38:36.72,Default,,0,0,0,,Бұл Коичидің кемесі!
Dialogue: 0,1:38:40.72,1:38:42.72,Default,,0,0,0,,Коичи!
Dialogue: 0,1:38:42.72,1:38:46.78,Default,,0,0,0,,Сәлем! Эй!
Dialogue: 0,1:38:46.78,1:38:50.23,Default,,0,0,0,,А, бұл Лиза! Соуске де сонда!
Dialogue: 0,1:38:50.23,1:38:52.23,Default,,0,0,0,,Эй!
Dialogue: 0,1:38:52.23,1:38:55.72,Default,,0,0,0,,Понё Бұл Коичидің кемесі.
Dialogue: 0,1:38:55.72,1:38:57.22,Default,,0,0,0,,Ах!
Dialogue: 0,1:38:57.22,1:39:09.22,Default,,0,0,0,,♪♪~
Dialogue: 0,1:39:11.24,1:39:16.24,Default,,0,0,0,,♪♪~ «Жартастағы понио»
Dialogue: 0,1:39:16.24,1:39:20.23,Default,,0,0,0,,♪♪~ Ponyo Ponyo Ponyo Fish Child
Dialogue: 0,1:39:20.23,1:39:24.22,Default,,0,0,0,,♪♪~ Мен көк теңізден келдім
Dialogue: 0,1:39:24.22,1:39:28.30,Default,,0,0,0,,♪♪~ Понё Понё Понё ісіп кетті
Dialogue: 0,1:39:28.30,1:39:32.24,Default,,0,0,0,,♪♪~ Домалақ іш қыз
Dialogue: 0,1:39:32.24,1:39:40.25,Default,,0,0,0,,♪♪~
Dialogue: 0,1:39:40.25,1:39:44.24,Default,,0,0,0,,♪♪～
Dialogue: 0,1:39:44.24,1:39:48.29,Default,,0,0,0,,♪♪~ Аяқтары жақсы, тепкілейміз!
Dialogue: 0,1:39:48.29,1:39:51.73,Default,,0,0,0,,♪♪~ Негиниги бум бум
Dialogue: 0,1:39:51.73,1:39:54.23,Default,,0,0,0,,♪♪~ Сізге жоғары қарау жақсы.
Dialogue: 0,1:39:54.23,1:39:56.75,Default,,0,0,0,,♪♪~ Қосылыңыз!
Dialogue: 0,1:39:56.75,1:40:00.22,Default,,0,0,0,,♪♪~ Мен сол қызбен секіргенімде
Dialogue: 0,1:40:00.22,1:40:04.24,Default,,0,0,0,,♪♪~ Менің де жүрегім билейді
Dialogue: 0,1:40:04.24,1:40:08.81,Default,,0,0,0,,♪♪~ Пак Пак Чуггю!
Dialogue: 0,1:40:08.81,1:40:14.23,Default,,0,0,0,,♪♪~ Мен ол қызды жақсы көремін
Dialogue: 0,1:40:14.23,1:40:16.25,Default,,0,0,0,,♪♪~ Маккаккано
Dialogue: 0,1:40:16.25,1:40:20.24,Default,,0,0,0,,♪♪~ Ponyo Ponyo Ponyo Fish Child
Dialogue: 0,1:40:20.24,1:40:24.23,Default,,0,0,0,,♪♪~ Мен көк теңізден келдім
Dialogue: 0,1:40:24.23,1:40:28.25,Default,,0,0,0,,♪♪~ Понё Понё Понё ісіп кетті
Dialogue: 0,1:40:28.25,1:40:32.72,Default,,0,0,0,,♪♪~ Домалақ іш қыз
Dialogue: 0,1:40:32.72,1:40:43.72,Default,,0,0,0,,♪♪~
