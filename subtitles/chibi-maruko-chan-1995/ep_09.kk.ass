Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:33.41,0:00:35.43,Default,,0000,0000,0000,,Келіңіздер, бәріңіз→
Dialogue: 0,0:00:35.43,0:00:37.45,Default,,0000,0000,0000,,«Чиби Маруко-чан» 1 сағаттық ерекше басталады!
Dialogue: 0,0:00:37.45,0:00:47.45,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:58.46,0:04:01.49,Default,,0000,0000,0000,,Жұмсақ.
Dialogue: 0,0:04:01.49,0:04:05.53,Default,,0000,0000,0000,,Қайырлы таң Мару-чан. А~ Қайырлы таң Тама Чан.
Dialogue: 0,0:04:05.53,0:04:10.58,Default,,0000,0000,0000,,Жазғы демалыс көзді ашып-жұмғанша өтті. Сондай жұмсақ.
Dialogue: 0,0:04:10.58,0:04:12.60,Default,,0000,0000,0000,,Мару-чан, сен ұйықтап жатқан сияқтысың.
Dialogue: 0,0:04:12.60,0:04:16.64,Default,,0000,0000,0000,,Эхехе кеше кешке дейін үй тапсырмасын орындадым.
Dialogue: 0,0:04:16.64,0:04:20.68,Default,,0000,0000,0000,,Аа, дұрыс. Бұл мүлдем бітпейді →
Dialogue: 0,0:04:20.68,0:04:23.71,Default,,0000,0000,0000,,Соңында барлығы маған көмектесті.
Dialogue: 0,0:04:23.71,0:04:27.75,Default,,0000,0000,0000,,Міне, мұндай кезде отбасы жақсы.
Dialogue: 0,0:04:27.75,0:04:29.77,Default,,0000,0000,0000,,<Отбасыма алғысым шексіз→
Dialogue: 0,0:04:29.77,0:04:31.79,Default,,0000,0000,0000,,Бұл сіз сезетін нәрсе емес.＞
Dialogue: 0,0:04:31.79,0:04:34.82,Default,,0000,0000,0000,,Сәлем Сакура Хонами Қайырлы таң.
Dialogue: 0,0:04:34.82,0:04:38.86,Default,,0000,0000,0000,,Қайырлы таң.
Dialogue: 0,0:04:38.86,0:04:41.89,Default,,0000,0000,0000,,Фуджики: Атмосфера сәл басқаша.
Dialogue: 0,0:04:41.89,0:04:45.93,Default,,0000,0000,0000,,Дұрыс. Оның ерні әлі көк.
Dialogue: 0,0:04:45.93,0:04:47.95,Default,,0000,0000,0000,,（）～ （）
Dialogue: 0,0:04:47.95,0:04:53.34,Default,,0000,0000,0000,,Хехехе Бұл жыланның қабығы. (Қыз) Мен оны жек көремін!
Dialogue: 0,0:04:53.34,0:04:57.38,Default,,0000,0000,0000,,Сіз мұны істемеуіңіз керек.
Dialogue: 0,0:04:57.38,0:05:01.42,Default,,0000,0000,0000,,Уф... Тексеріңіз...
Dialogue: 0,0:05:01.42,0:05:04.45,Default,,0000,0000,0000,,Рахмет. (Қыз) Үлкен аға керемет.
Dialogue: 0,0:05:04.45,0:05:06.47,Default,,0000,0000,0000,,Жоқ...
Dialogue: 0,0:05:06.47,0:05:09.47,Default,,0000,0000,0000,,Фуджики?
Dialogue: 0,0:05:11.52,0:05:14.55,Default,,0000,0000,0000,,Эй, эй, Фуджики. иә? Бұл не?
Dialogue: 0,0:05:14.55,0:05:18.59,Default,,0000,0000,0000,,Мен оны бұрын көрдім. О иә.
Dialogue: 0,0:05:18.59,0:05:20.61,Default,,0000,0000,0000,,Саған не болды?
Dialogue: 0,0:05:20.61,0:05:22.63,Default,,0000,0000,0000,,Бұрынғы Фуджикиге ұқсамайды.
Dialogue: 0,0:05:22.63,0:05:27.68,Default,,0000,0000,0000,,Иә, ол мүлдем басқа адам сияқты еді. Жазғы демалыста бірдеңе болды ма?
Dialogue: 0,0:05:27.68,0:05:32.73,Default,,0000,0000,0000,,Иә. Негізі Батырмен жазғы демалыста таныстым.
Dialogue: 0,0:05:32.73,0:05:34.75,Default,,0000,0000,0000,,Батыр?
Dialogue: 0,0:05:34.75,0:05:39.80,Default,,0000,0000,0000,,Ол Сидзуокадағы әмбебап дүкенде батыр адам шоуын жасап жатқан.
Dialogue: 0,0:05:39.80,0:05:42.83,Default,,0000,0000,0000,,《Же бер! Батыр соққы! 》
Dialogue: 0,0:05:42.83,0:05:47.88,Default,,0000,0000,0000,,《Уау! Мен ұрдым...》
Dialogue: 0,0:05:47.88,0:05:49.90,Default,,0000,0000,0000,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:05:49.90,0:05:51.09,Default,,0000,0000,0000,,《Қолдауыңыз үшін рахмет→
Dialogue: 0,0:05:51.09,0:05:53.27,Default,,0000,0000,0000,,Мен зұлымдықты жойдым》→
Dialogue: 0,0:05:53.27,0:05:57.31,Default,,0000,0000,0000,,《Менімен бірге жердің тыныштығын қорғайық. Бұл уәде! 》
Dialogue: 0,0:05:57.31,0:06:02.36,Default,,0000,0000,0000,,《Батыр! 》
Dialogue: 0,0:06:02.36,0:06:05.39,Default,,0000,0000,0000,,《Әй, мен де Батыр сияқтымын→
Dialogue: 0,0:06:05.39,0:06:08.42,Default,,0000,0000,0000,,Мен барын саламын》 (Батыр)《Иә》
Dialogue: 0,0:06:08.42,0:06:12.46,Default,,0000,0000,0000,,《Батыр…》
Dialogue: 0,0:06:12.46,0:06:14.48,Default,,0000,0000,0000,,Бұл өте керемет.
Dialogue: 0,0:06:14.48,0:06:17.51,Default,,0000,0000,0000,,Мен де Батырға ұқсағым келді.
Dialogue: 0,0:06:17.51,0:06:19.53,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:06:19.53,0:06:21.55,Default,,0000,0000,0000,,（） （）
Dialogue: 0,0:06:21.55,0:06:23.57,Default,,0000,0000,0000,,Иә? Ах.
Dialogue: 0,0:06:23.57,0:06:25.59,Default,,0000,0000,0000,,Сендер, үндемеңдер!➡
Dialogue: 0,0:06:25.59,0:06:28.62,Default,,0000,0000,0000,,Иә? Бұрынғы қыздар емес пе?
Dialogue: 0,0:06:28.62,0:06:30.64,Default,,0000,0000,0000,,Иә, солай сияқты.
Dialogue: 0,0:06:30.64,0:06:33.67,Default,,0000,0000,0000,,Әділдік одақтасы.
Dialogue: 0,0:06:33.67,0:06:35.69,Default,,0000,0000,0000,,Не? Әділдік одақтасы ма?
Dialogue: 0,0:06:35.69,0:06:38.72,Default,,0000,0000,0000,,Әй, сен әділдік жағындасың.
Dialogue: 0,0:06:38.72,0:06:43.77,Default,,0000,0000,0000,,Бұл таңқаларлық. Эхехе. Бәріңе сәлем!
Dialogue: 0,0:06:43.77,0:06:47.81,Default,,0000,0000,0000,,Егер сізде қандай да бір қиыншылық болса, маған айтыңыз.
Dialogue: 0,0:06:47.81,0:06:51.52,Default,,0000,0000,0000,,Рахмет, аға. (Қыз) Сау болыңыз.
Dialogue: 0,0:06:51.52,0:06:54.21,Default,,0000,0000,0000,,Эхехе. Эй, мен мұны істеймін, Фуджики.
Dialogue: 0,0:06:54.21,0:06:57.24,Default,,0000,0000,0000,,Эххе мен көріп тұрмын.
Dialogue: 0,0:06:57.24,0:07:01.28,Default,,0000,0000,0000,,Неліктен мұны әділдіктің одақтасы болуды мақсат ету мүмкіндігі ретінде қабылдамасқа?
Dialogue: 0,0:07:01.28,0:07:05.32,Default,,0000,0000,0000,,（） →
Dialogue: 0,0:07:05.32,0:07:08.35,Default,,0000,0000,0000,,Солай етіңіз. (Фуджики) Ханава-кун.
Dialogue: 0,0:07:08.35,0:07:11.38,Default,,0000,0000,0000,,Ханымды қорғап, әділдіктің одақтасы болуды мақсат ету→
Dialogue: 0,0:07:11.38,0:07:13.40,Default,,0000,0000,0000,,Керемет.
Dialogue: 0,0:07:13.40,0:07:17.44,Default,,0000,0000,0000,,Фуджики-кун, бар күшіңді сал. Мен де сені қолдаймын.
Dialogue: 0,0:07:17.44,0:07:21.48,Default,,0000,0000,0000,,Рахмет, Ханава-кун. Жарайды, бүгіннен бастап →
Dialogue: 0,0:07:21.48,0:07:25.52,Default,,0000,0000,0000,,Мен әділдіктің одақтасы болуды мақсат етемін. (3 адам) О!
Dialogue: 0,0:07:25.52,0:07:29.56,Default,,0000,0000,0000,,Біз Батырмыз!
Dialogue: 0,0:07:29.56,0:07:32.59,Default,,0000,0000,0000,,Хун.
Dialogue: 0,0:07:32.59,0:07:35.62,Default,,0000,0000,0000,,Олай болса, жазғы демалыс біткен соң→
Dialogue: 0,0:07:35.62,0:07:38.65,Default,,0000,0000,0000,,Ақымақ болудан әділдіктің одақтасы болу→
Dialogue: 0,0:07:38.65,0:07:40.67,Default,,0000,0000,0000,,Мен таң қалдым. (Томозо) О.
Dialogue: 0,0:07:40.67,0:07:44.71,Default,,0000,0000,0000,,Фуджики-кунның әділдік одақтасына айналғаны таңқаларлық.
Dialogue: 0,0:07:44.71,0:07:46.73,Default,,0000,0000,0000,,Өйткені, сіз түрлендіргенде→
Dialogue: 0,0:07:46.73,0:07:50.77,Default,,0000,0000,0000,,Сіз секіріп, ауада айналасыз ба?
Dialogue: 0,0:07:50.77,0:07:52.13,Default,,0000,0000,0000,,Ата, бұл теледидар емес.
Dialogue: 0,0:07:52.13,0:07:56.17,Default,,0000,0000,0000,,Иә, адам өзгере алмайды.
Dialogue: 0,0:07:56.17,0:07:59.20,Default,,0000,0000,0000,,Үш күндік монахқа айналмас деп үміттенемін.
Dialogue: 0,0:07:59.20,0:08:01.22,Default,,0000,0000,0000,,Менің айтып тұрғаным бұл емес.
Dialogue: 0,0:08:01.22,0:08:04.25,Default,,0000,0000,0000,,Өзіңді өзгерту қиын нәрсе.
Dialogue: 0,0:08:04.25,0:08:08.29,Default,,0000,0000,0000,,Дұрыс, Марукоға оның жалқау екенін қанша рет ескертсем де →
Dialogue: 0,0:08:08.29,0:08:11.32,Default,,0000,0000,0000,,Ол мүлде өзгермейді. Хмф, не?
Dialogue: 0,0:08:11.32,0:08:14.35,Default,,0000,0000,0000,,Сенің анаң керемет деп ойлаймын, Фуджики-кун.
Dialogue: 0,0:08:14.35,0:08:16.37,Default,,0000,0000,0000,,Иә. Бұл үлкен мәселе.
Dialogue: 0,0:08:16.37,0:08:23.44,Default,,0000,0000,0000,,Мен түсіндім, мүмкін солай. Мен де Фуджикиді қолдаймын деп ойлаймын.
Dialogue: 0,0:08:23.44,0:08:25.46,Default,,0000,0000,0000,,Бірақ мен ондай нәрсе істей алмаймын ғой…》 Кешірші, кешірші…
Dialogue: 0,0:08:25.46,0:08:27.48,Default,,0000,0000,0000,,Иә. (Ұлдар) Хахаха...
Dialogue: 0,0:08:27.48,0:08:31.52,Default,,0000,0000,0000,,Ой, балалар, дәлізде жүгіру қауіпті.
Dialogue: 0,0:08:31.52,0:08:34.55,Default,,0000,0000,0000,,Иә. (Фуджики) Жарайды, бұл жақсы қыз.
Dialogue: 0,0:08:34.55,0:08:36.57,Default,,0000,0000,0000,,Ауырды... (Фуджики) Иә?
Dialogue: 0,0:08:36.57,0:08:39.60,Default,,0000,0000,0000,,(қыз жылап жатыр)
Dialogue: 0,0:08:39.60,0:08:41.62,Default,,0000,0000,0000,,Қарт әже, кіріп келемін.
Dialogue: 0,0:08:41.62,0:08:43.64,Default,,0000,0000,0000,,Мен құладым...
Dialogue: 0,0:08:43.64,0:08:46.67,Default,,0000,0000,0000,,Амансың ба? Емханаға барайық па? →
Dialogue: 0,0:08:46.67,0:08:48.69,Default,,0000,0000,0000,,Сіз тұра аласыз ба?
Dialogue: 0,0:08:48.69,0:08:51.55,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:08:51.55,0:08:55.55,Default,,0000,0000,0000,,Фуджики Сіз қолыңыздан келгеннің бәрін істеп жатырсыз. Мен келісемін.
Dialogue: 0,0:08:57.11,0:09:01.15,Default,,0000,0000,0000,,Иә! (Фуджики) Уау!
Dialogue: 0,0:09:01.15,0:09:04.18,Default,,0000,0000,0000,,Балалар жүгірсеңдер қауіпті. (Бала) Шу!
Dialogue: 0,0:09:04.18,0:09:06.18,Default,,0000,0000,0000,,А, сәл күте тұрыңыз...
Dialogue: 0,0:09:10.24,0:09:18.32,Default,,0000,0000,0000,,Аа... Әділдіктің одақтасы болу өте қиын...
Dialogue: 0,0:09:18.32,0:09:20.34,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:09:20.34,0:09:23.34,Default,,0000,0000,0000,,Ах... (Фуджики) Ах...
Dialogue: 0,0:09:25.39,0:09:28.42,Default,,0000,0000,0000,,Иә. (Қыз) Рахмет.
Dialogue: 0,0:09:28.42,0:09:30.44,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:09:30.44,0:09:35.49,Default,,0000,0000,0000,,Фуджики: Барлығыңыз әділдік жағындасыздар.
Dialogue: 0,0:09:35.49,0:09:37.51,Default,,0000,0000,0000,,Солай ма? Иә.
Dialogue: 0,0:09:37.51,0:09:39.53,Default,,0000,0000,0000,,Мүмкін бұл керемет көріне бастады.
Dialogue: 0,0:09:39.53,0:09:42.56,Default,,0000,0000,0000,,Иә? Шынымен бе? Эхехе.
Dialogue: 0,0:09:42.56,0:09:46.60,Default,,0000,0000,0000,,Мен де сенің бұлай өзгереді деп күтпедім.
Dialogue: 0,0:09:52.99,0:09:54.99,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:09:56.03,0:09:59.06,Default,,0000,0000,0000,,Иә, Нагасава-кун.
Dialogue: 0,0:09:59.06,0:10:01.08,Default,,0000,0000,0000,,Хмф! (Фуджики) Ах...
Dialogue: 0,0:10:01.08,0:10:04.11,Default,,0000,0000,0000,,Нагасава-кун, не болды? Сіз бір нәрсеге ашуланып тұрсыз ба?
Dialogue: 0,0:10:04.11,0:10:07.14,Default,,0000,0000,0000,,Бұл ерекше ештеңе емес.
Dialogue: 0,0:10:07.14,0:10:09.16,Default,,0000,0000,0000,,Бірақ біртүрлі болып көрінеді.
Dialogue: 0,0:10:09.16,0:10:13.20,Default,,0000,0000,0000,,Егер сізде бірдеңе болса, маған айтыңыз.
Dialogue: 0,0:10:13.20,0:10:15.22,Default,,0000,0000,0000,,Әділдіктің одақтасы болып көрінесің→
Dialogue: 0,0:10:15.22,0:10:18.25,Default,,0000,0000,0000,,Сіз мәңгілікке жалғастыруды жоспарлайсыз ба?
Dialogue: 0,0:10:18.25,0:10:22.25,Default,,0000,0000,0000,,Эх, Нагасава-кун….
Dialogue: 0,0:10:24.31,0:10:28.35,Default,,0000,0000,0000,,Эй Фуджики, асығыңыз, асығыңыз!
Dialogue: 0,0:10:28.35,0:10:31.35,Default,,0000,0000,0000,,Күте тұрыңыз...
Dialogue: 0,0:10:38.45,0:10:40.47,Default,,0000,0000,0000,,（）
Dialogue: 0,0:10:40.47,0:10:42.49,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:10:42.49,0:10:44.51,Default,,0000,0000,0000,,Эй!
Dialogue: 0,0:10:44.51,0:10:47.54,Default,,0000,0000,0000,,… （）
Dialogue: 0,0:10:47.54,0:10:51.58,Default,,0000,0000,0000,,А, у, у...
Dialogue: 0,0:10:51.58,0:10:53.94,Default,,0000,0000,0000,,О, күте тұрыңыз, Фуджики.
Dialogue: 0,0:10:53.94,0:10:55.96,Default,,0000,0000,0000,,Қоқысты дұрыс тастамасаңыз, бұл жақсы емес.
Dialogue: 0,0:10:55.96,0:11:00.01,Default,,0000,0000,0000,,Уф... Сакура: Бұл менің қоқысым емес.
Dialogue: 0,0:11:00.01,0:11:02.03,Default,,0000,0000,0000,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:11:02.03,0:11:06.07,Default,,0000,0000,0000,,Мен сенің шайқасыңды өз көзіммен көрдім.
Dialogue: 0,0:11:06.07,0:11:08.09,Default,,0000,0000,0000,,Дұрыс, Фуджикидің қоқысы.
Dialogue: 0,0:11:08.09,0:11:13.14,Default,,0000,0000,0000,,Жоқ, мен оны алдым, бірақ бұл менің қоқыс жәшігім емес еді.
Dialogue: 0,0:11:13.14,0:11:17.18,Default,,0000,0000,0000,,Бұлай сылтау айту үшін сен ақымақ болуың керек!
Dialogue: 0,0:11:17.18,0:11:19.20,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:11:19.20,0:11:23.24,Default,,0000,0000,0000,,Мен енді шыбын аулаушы емеспін! Жоқ. Сіз қазір →
Dialogue: 0,0:11:23.24,0:11:26.27,Default,,0000,0000,0000,,Ол әділдіктің одақтасы емес, қорқақ.
Dialogue: 0,0:11:26.27,0:11:29.30,Default,,0000,0000,0000,,Құдайға шүкір.
Dialogue: 0,0:11:29.30,0:11:34.35,Default,,0000,0000,0000,,Жүр, қоқысты дұрыстап ал. Өтінемін, мені жіберіңізші. →
Dialogue: 0,0:11:34.35,0:11:37.38,Default,,0000,0000,0000,,Хмм…. Уау, тат, тат...
Dialogue: 0,0:11:37.38,0:11:39.40,Default,,0000,0000,0000,,Nuo...
Dialogue: 0,0:11:39.40,0:11:42.40,Default,,0000,0000,0000,,Иә! (Маруко/Тамае) Ах!
Dialogue: 0,0:11:44.45,0:11:48.45,Default,,0000,0000,0000,,Ах! Не істеуім керек... Иә?
Dialogue: 0,0:11:50.51,0:11:52.86,Default,,0000,0000,0000,,Үлкен аға...
Dialogue: 0,0:11:52.86,0:11:55.89,Default,,0000,0000,0000,,А, м... мынау.
Dialogue: 0,0:11:55.89,0:11:57.91,Default,,0000,0000,0000,,Ей! (Бала) Ой, бұл қауіпті!
Dialogue: 0,0:11:57.91,0:11:59.93,Default,,0000,0000,0000,,Иә? →
Dialogue: 0,0:11:59.93,0:12:01.93,Default,,0000,0000,0000,,Кя!
Dialogue: 0,0:12:04.98,0:12:06.00,Default,,0000,0000,0000,,Бұл. →
Dialogue: 0,0:12:06.00,0:12:10.00,Default,,0000,0000,0000,,Хун. Ханымдар, ауырып қалдыңыз ба?
Dialogue: 0,0:12:12.06,0:12:16.10,Default,,0000,0000,0000,,Рахмет, аға. (Қыз) Үлкен аға керемет.
Dialogue: 0,0:12:16.10,0:12:18.12,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:18.12,0:12:23.17,Default,,0000,0000,0000,,Ал, ханымдар, адиос. (Қыздар) Әй, аға.
Dialogue: 0,0:12:23.17,0:12:27.21,Default,,0000,0000,0000,,Ах... Фуджики....
Dialogue: 0,0:12:27.21,0:12:30.24,Default,,0000,0000,0000,,Әділдіктің одақтасы болу саған жараспайды ғой.
Dialogue: 0,0:12:30.24,0:12:33.27,Default,,0000,0000,0000,,Ух... Нагасава-кун.
Dialogue: 0,0:12:33.27,0:12:36.30,Default,,0000,0000,0000,,Сіз өзіңізді қатты итеріп жіберген шығарсыз, солай ма?
Dialogue: 0,0:12:36.30,0:12:44.38,Default,,0000,0000,0000,,Уф... Иә, солай шығар. Иә, мен оны сәл асырып жіберген шығармын.
Dialogue: 0,0:12:44.38,0:12:48.42,Default,,0000,0000,0000,,Менің ойымша, бұрынғы қалпында қалған дұрыс.
Dialogue: 0,0:12:48.42,0:12:50.44,Default,,0000,0000,0000,,Фуджики Сіз...
Dialogue: 0,0:12:50.44,0:12:54.81,Default,,0000,0000,0000,,Менің ойымша, бұл сізге көбірек ұқсайды.
Dialogue: 0,0:12:54.81,0:12:56.83,Default,,0000,0000,0000,,Нагасава-кун….
Dialogue: 0,0:12:56.83,0:13:01.83,Default,,0000,0000,0000,,Бар күшіңді салу жақсы, бірақ өзіңді қатты итермелеу жақсы емес.
Dialogue: 0,0:13:04.91,0:13:09.96,Default,,0000,0000,0000,,Иә. Мен өзімді итеруді тоқтатамын. Мен бұрынғыдай адам болып қайтамын.
Dialogue: 0,0:13:09.96,0:13:12.99,Default,,0000,0000,0000,,Мм, түсіндім.
Dialogue: 0,0:13:12.99,0:13:16.99,Default,,0000,0000,0000,,А, күте тұрыңыз, Нагасава-кун.
Dialogue: 0,0:13:18.05,0:13:22.09,Default,,0000,0000,0000,,Хмм, мен бұл босқа кеткендей болдым.
Dialogue: 0,0:13:22.09,0:13:27.14,Default,,0000,0000,0000,,Бірақ Фуджикидің бұрынғы қалпында қалғаны жақсы шығар.
Dialogue: 0,0:13:27.14,0:13:30.17,Default,,0000,0000,0000,,<Егер мен қалыпты жағдайға оралсам, Нагасавамен қарым-қатынасым да қайта оралады→
Dialogue: 0,0:13:30.17,0:13:32.19,Default,,0000,0000,0000,,Ақыр соңында, бұрынғы қалпында қалған дұрыс →
Dialogue: 0,0:13:32.19,0:13:37.19,Default,,0000,0000,0000,,Менің ойымша, өз-өзіңмен болған дұрыс. Бұл Фуджики болатын.
Dialogue: 0,0:15:20.60,0:15:23.63,Default,,0000,0000,0000,,Жылама! Ақымақ, Косей! Енді мен де…
Dialogue: 0,0:15:23.63,0:15:26.66,Default,,0000,0000,0000,,Сәттілік Оно! (Нагата) Сугияма Жоғалтпа!
Dialogue: 0,0:15:26.66,0:15:30.70,Default,,0000,0000,0000,,Ха ха ха ха….
Dialogue: 0,0:15:30.70,0:15:32.72,Default,,0000,0000,0000,,Иә! (Сугияма) Қат!
Dialogue: 0,0:15:32.72,0:15:38.78,Default,,0000,0000,0000,,Ха ха ха ха…. →
Dialogue: 0,0:15:38.78,0:15:43.83,Default,,0000,0000,0000,,Қат! (Сугияма) Сонымен қазір менде 5 жеңіс және 4 жеңіліс бар.
Dialogue: 0,0:15:43.83,0:15:47.87,Default,,0000,0000,0000,,Келесі жолы тағы да жеңіп, 5 жеңіс пен 5 жеңіліс жасайық.
Dialogue: 0,0:15:47.87,0:15:49.89,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:15:49.89,0:15:51.91,Default,,0000,0000,0000,,Келесі Жарайды.
Dialogue: 0,0:15:54.94,0:15:58.98,Default,,0000,0000,0000,,Ха ха ха ха….
Dialogue: 0,0:15:58.98,0:16:00.00,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:16:00.00,0:16:03.03,Default,,0000,0000,0000,,Онда да, жерде де жақсы жүзіңіз!
Dialogue: 0,0:16:03.03,0:16:05.03,Default,,0000,0000,0000,,Иә, иә….
Dialogue: 0,0:16:08.08,0:16:12.12,Default,,0000,0000,0000,,Келесі сабақ жүзу бойынша соңғы болады. Барлығына сәттілік және жүзу.
Dialogue: 0,0:16:12.12,0:16:14.31,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:16:14.31,0:16:19.53,Default,,0000,0000,0000,,Бұл Оно мен Сугияма арасындағы соңғы бәсеке бола ма?
Dialogue: 0,0:16:19.53,0:16:21.55,Default,,0000,0000,0000,,Кім жеңеді?
Dialogue: 0,0:16:21.55,0:16:24.58,Default,,0000,0000,0000,,...
Dialogue: 0,0:16:24.58,0:16:26.60,Default,,0000,0000,0000,,Маған тапсырма беріңізші.
Dialogue: 0,0:16:26.60,0:16:28.62,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:16:28.62,0:16:31.65,Default,,0000,0000,0000,,Мұны қайталаңыз.
Dialogue: 0,0:16:31.65,0:16:34.68,Default,,0000,0000,0000,,Менің жүзуден шаршағаным сонша, ештеңе істегім келмейді.
Dialogue: 0,0:16:34.68,0:16:38.72,Default,,0000,0000,0000,,Бүгін 25 метрге жүздіңіз бе? Уф.
Dialogue: 0,0:16:38.72,0:16:42.76,Default,,0000,0000,0000,,Осы жылы жүзуді үйренуге бар күшіңізді салмадыңыз ба?
Dialogue: 0,0:16:42.76,0:16:46.76,Default,,0000,0000,0000,,Жүр, тез кел. Ха...
Dialogue: 0,0:16:48.82,0:16:52.86,Default,,0000,0000,0000,,Әлі ыстық. Ах...
Dialogue: 0,0:16:52.86,0:16:57.91,Default,,0000,0000,0000,,２６ ２７ ２８→
Dialogue: 0,0:16:57.91,0:17:01.95,Default,,0000,0000,0000,,29 30…. Сугияма мырза.
Dialogue: 0,0:17:01.95,0:17:04.98,Default,,0000,0000,0000,,Ах, Сакура. не болды? Осындай жерде.
Dialogue: 0,0:17:04.98,0:17:09.03,Default,,0000,0000,0000,,Мен Охноны жеңу үшін жаз бойы жаттығамын.
Dialogue: 0,0:17:09.03,0:17:11.05,Default,,0000,0000,0000,,Мен оған жеңіле алмаймын.
Dialogue: 0,0:17:11.05,0:17:15.05,Default,,0000,0000,0000,,Хмм, сен жақсысың. Онда сәттілік.
Dialogue: 0,0:17:21.48,0:17:23.50,Default,,0000,0000,0000,,Иә? Бұл жолы Ямане.
Dialogue: 0,0:17:23.50,0:17:30.57,Default,,0000,0000,0000,,5… 6…. Ха ха ха ха….
Dialogue: 0,0:17:30.57,0:17:34.61,Default,,0000,0000,0000,,Ямане: Сен де жаттығасың ба?
Dialogue: 0,0:17:34.61,0:17:38.65,Default,,0000,0000,0000,,Сакура? Қарсыластарымызға ұтыла алмаймыз.
Dialogue: 0,0:17:38.65,0:17:40.67,Default,,0000,0000,0000,,Бәсекелес дегеніміз не?
Dialogue: 0,0:17:40.67,0:17:44.71,Default,,0000,0000,0000,,Охно-кун және Сугияма-кун. Эх!
Dialogue: 0,0:17:44.71,0:17:46.73,Default,,0000,0000,0000,,Мен, биылғы жаз →
Dialogue: 0,0:17:46.73,0:17:51.78,Default,,0000,0000,0000,,Мен Охно-кун мен Сугияма-кунға жеңілмейтін мықты адам боламын деп шештім!
Dialogue: 0,0:17:51.78,0:17:54.81,Default,,0000,0000,0000,,Бұл қылыш не өзі?!➡
Dialogue: 0,0:17:54.81,0:17:56.83,Default,,0000,0000,0000,,Жалғыз күйіп жатырмын...
Dialogue: 0,0:17:56.83,0:17:58.85,Default,,0000,0000,0000,,Бірақ мен ондай нәрсе істей алмаймын ғой…》 Кешірші, кешірші…
Dialogue: 0,0:17:58.85,0:18:02.89,Default,,0000,0000,0000,,Ха ха ха ха….
Dialogue: 0,0:18:02.89,0:18:06.93,Default,,0000,0000,0000,,Аа, мен оны уақытында жасадым. Қайырлы таң, Тама-чан.
Dialogue: 0,0:18:06.93,0:18:08.95,Default,,0000,0000,0000,,Қайырлы таң.
Dialogue: 0,0:18:08.95,0:18:10.97,Default,,0000,0000,0000,,Охноның жігіті баяу.
Dialogue: 0,0:18:10.97,0:18:13.00,Default,,0000,0000,0000,,Охно-кун бүгін суыққа байланысты жоқ.
Dialogue: 0,0:18:13.00,0:18:17.37,Default,,0000,0000,0000,,Шынымен бе? Хонами. Мен қазір қызметкерлер бөлмесіне бардым →
Dialogue: 0,0:18:17.37,0:18:21.41,Default,,0000,0000,0000,,Маған Ононың анасы қоңырау шалды, ол Тогава-сенсэй еді.
Dialogue: 0,0:18:21.41,0:18:27.47,Default,,0000,0000,0000,,Ононың үзіліс жасауы әдеттен тыс. Иә, бұл шынымен жаман болуы мүмкін.
Dialogue: 0,0:18:27.47,0:18:31.51,Default,,0000,0000,0000,,Болды... Келесі жүзуде емделмесе→
Dialogue: 0,0:18:31.51,0:18:34.54,Default,,0000,0000,0000,,Сіз соңғы кездесуді өткізе алмайсыз.
Dialogue: 0,0:18:34.54,0:18:38.58,Default,,0000,0000,0000,,Бірақ Сугияма-кун үшін Охно-кун демалғаны жақсы еді→
Dialogue: 0,0:18:38.58,0:18:40.60,Default,,0000,0000,0000,,Менің жолым болды деп ойлаймын.
Dialogue: 0,0:18:40.60,0:18:42.62,Default,,0000,0000,0000,,Неліктен? Өйткені ол кезде →
Dialogue: 0,0:18:42.62,0:18:46.66,Default,,0000,0000,0000,,5 жеңіс пен 4 жеңіліспен Сугияма жеңімпаз емес пе?
Dialogue: 0,0:18:46.66,0:18:50.70,Default,,0000,0000,0000,,Фуджикиден айырмашылығы, Сугияма-кун ондай жеңіл-желпі нәрселер туралы ойламайды.
Dialogue: 0,0:18:50.70,0:18:52.70,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:18:56.76,0:18:59.79,Default,,0000,0000,0000,,《Сугияма-кун…》
Dialogue: 0,0:18:59.79,0:19:02.82,Default,,0000,0000,0000,,Сонда кездескенше. Кейін ойнаймыз.
Dialogue: 0,0:19:02.82,0:19:04.82,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:19:07.87,0:19:09.89,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:19:09.89,0:19:13.93,Default,,0000,0000,0000,,Мен міндетті түрде жүзуге барамын. Бұл Сугиямамен соңғы кездесу.
Dialogue: 0,0:19:13.93,0:19:17.30,Default,,0000,0000,0000,,Жүзу мүмкін емес. Өйткені қызуым көтеріліп тұр.
Dialogue: 0,0:19:17.30,0:19:19.32,Default,,0000,0000,0000,,Оно мырза. (Охно) Сакура.
Dialogue: 0,0:19:19.32,0:19:22.35,Default,,0000,0000,0000,,Сәлеметсіз бе. Сәлем.
Dialogue: 0,0:19:22.35,0:19:26.39,Default,,0000,0000,0000,,Суық тигенде ше? (Охно) Бұл үлкен мәселе емес. →
Dialogue: 0,0:19:26.39,0:19:29.42,Default,,0000,0000,0000,,Бүгін де демалыссыз жақсымын дедім.
Dialogue: 0,0:19:29.42,0:19:32.45,Default,,0000,0000,0000,,Жоқ, сен тыныш ұйықтау керек.
Dialogue: 0,0:19:32.45,0:19:35.48,Default,,0000,0000,0000,,Қарғыс атсын! Неліктен мен осындай уақытта суық тиюге болады?
Dialogue: 0,0:19:35.48,0:19:38.51,Default,,0000,0000,0000,,Жарайды. Жақын арада сауығып кететініңізге сенімдімін.
Dialogue: 0,0:19:38.51,0:19:40.51,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:19:47.60,0:19:54.67,Default,,0000,0000,0000,,Ммммммм…. →
Dialogue: 0,0:19:54.67,0:19:56.67,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:20:00.73,0:20:05.78,Default,,0000,0000,0000,,Охно мен Сугияманың жекпе-жегі не болады деп ойлаймын.
Dialogue: 0,0:20:05.78,0:20:08.81,Default,,0000,0000,0000,,Иә... (Маруко/Тамае) Ах.
Dialogue: 0,0:20:08.81,0:20:11.84,Default,,0000,0000,0000,,Сугияма мырза.
Dialogue: 0,0:20:11.84,0:20:16.23,Default,,0000,0000,0000,,Бүгін жаттығуға бармайсың ба?
Dialogue: 0,0:20:16.23,0:20:20.27,Default,,0000,0000,0000,,Егер Охно өшірілсе, Сугияма жеңеді...
Dialogue: 0,0:20:20.27,0:20:23.30,Default,,0000,0000,0000,,Шын мәнінде емес. (Маруко/Тамае) Иә?
Dialogue: 0,0:20:23.30,0:20:27.34,Default,,0000,0000,0000,,Ононың демалып жеңгеніне қуанбаймын.
Dialogue: 0,0:20:27.34,0:20:30.37,Default,,0000,0000,0000,,Охно көп жұмыс істегендіктен, мен де көп жұмыс істедім.
Dialogue: 0,0:20:30.37,0:20:32.39,Default,,0000,0000,0000,,Охномен бетпе-бет келе білу керек →
Dialogue: 0,0:20:32.39,0:20:35.42,Default,,0000,0000,0000,,Жаттығудың пайдасы жоқ.
Dialogue: 0,0:20:35.42,0:20:41.48,Default,,0000,0000,0000,,Сугияма мырза…. Охнокунды аурухананың алдында кездестірдім.
Dialogue: 0,0:20:41.48,0:20:45.52,Default,,0000,0000,0000,,Охноның да көңілі қалды. иә?
Dialogue: 0,0:20:45.52,0:20:49.56,Default,,0000,0000,0000,,Қарғыс атсын! Әйтеуір жазыла ма деп ойлаймын.
Dialogue: 0,0:20:49.56,0:20:51.58,Default,,0000,0000,0000,,（） （）
Dialogue: 0,0:20:51.58,0:20:53.60,Default,,0000,0000,0000,,Не болды? Ямане.
Dialogue: 0,0:20:53.60,0:20:58.60,Default,,0000,0000,0000,,Охно-кун үзіліс алса да, мен сенімен бар күшіммен күресемін.
Dialogue: 0,0:21:00.67,0:21:04.71,Default,,0000,0000,0000,,１… ２…。
Dialogue: 0,0:21:04.71,0:21:06.71,Default,,0000,0000,0000,,А...
Dialogue: 0,0:21:12.79,0:21:17.17,Default,,0000,0000,0000,,Маруко екеуміз буға пісірілген дәмді тоқаш алдық.
Dialogue: 0,0:21:17.17,0:21:20.20,Default,,0000,0000,0000,,Ал, Охно-кун, суық тиіп қалдың ба? Мен уайымдап тұрмын.
Dialogue: 0,0:21:20.20,0:21:24.24,Default,,0000,0000,0000,,Иә. Сугияма-кун да өзін әдеттегідей жігерлі сезінбейді.
Dialogue: 0,0:21:24.24,0:21:26.26,Default,,0000,0000,0000,,Маруко Манжу….
Dialogue: 0,0:21:26.26,0:21:29.29,Default,,0000,0000,0000,,Охно-кун, тез сауығып кетуіңе сенемін.
Dialogue: 0,0:21:29.29,0:21:31.31,Default,,0000,0000,0000,,Егер сіз суық тиіп қалсаңыз, сізге пайдалы нәрсе бар.
Dialogue: 0,0:21:31.31,0:21:33.33,Default,,0000,0000,0000,,Шынымен бе?
Dialogue: 0,0:21:33.33,0:21:36.36,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:21:36.36,0:21:39.39,Default,,0000,0000,0000,,Не болды? Ата.
Dialogue: 0,0:21:39.39,0:21:41.41,Default,,0000,0000,0000,,Тамағыңызға тоқаш кептеліп қалды ма?
Dialogue: 0,0:21:41.41,0:21:43.43,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:21:43.43,0:21:46.43,Default,,0000,0000,0000,,Сізге қайсысын жасауым керек? Иә.
Dialogue: 0,0:21:50.50,0:21:54.54,Default,,0000,0000,0000,,《Мистер Охно және Сугияма мырза. Ол менің қарсыласым болатын сияқты.
Dialogue: 0,0:21:54.54,0:21:58.58,Default,,0000,0000,0000,,<Томозо, сен жеңе алмайсың>
Dialogue: 0,0:21:58.58,0:22:00.58,Default,,0000,0000,0000,,Бірақ мен ондай нәрсе істей алмаймын ғой…》 Кешірші, кешірші…
Dialogue: 0,0:22:04.64,0:22:07.67,Default,,0000,0000,0000,,...
Dialogue: 0,0:22:07.67,0:22:10.70,Default,,0000,0000,0000,,Ха ха ха ха….
Dialogue: 0,0:22:10.70,0:22:17.10,Default,,0000,0000,0000,,Мынаны Охнокунға апарыңыз, ол суық тиюге ең жақсысы дейді.
Dialogue: 0,0:22:17.10,0:22:21.14,Default,,0000,0000,0000,,Сугияма-кун кетсе, Охно-кун міндетті түрде жақсарады →
Dialogue: 0,0:22:21.14,0:22:25.18,Default,,0000,0000,0000,,Бізде соңғы кездесу болатынына сенімдімін.
Dialogue: 0,0:22:25.18,0:22:27.20,Default,,0000,0000,0000,,Сакура….
Dialogue: 0,0:22:27.20,0:22:29.22,Default,,0000,0000,0000,,Бұл Сакура→
Dialogue: 0,0:22:29.22,0:22:33.26,Default,,0000,0000,0000,,Өйткені ол суық тиюге қарсы тиімді. (Охно) Түсінемін.
Dialogue: 0,0:22:33.26,0:22:37.30,Default,,0000,0000,0000,,Мен берілмеймін. (Охно) Иә?
Dialogue: 0,0:22:37.30,0:22:41.34,Default,,0000,0000,0000,,Охноның келіп, соңына дейін жаттығуын жалғастыратынына сеніңіз.
Dialogue: 0,0:22:41.34,0:22:45.38,Default,,0000,0000,0000,,Сугияма Мен де берілмеймін. →
Dialogue: 0,0:22:45.38,0:22:49.42,Default,,0000,0000,0000,,Суға шомылатын күннің алдында міндетті түрде суық тиюді емдеймін.
Dialogue: 0,0:22:49.42,0:22:51.44,Default,,0000,0000,0000,,Бұл уәде. (Охно) Ой.
Dialogue: 0,0:22:51.44,0:22:54.47,Default,,0000,0000,0000,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:22:54.47,0:22:57.47,Default,,0000,0000,0000,,Онда не бар? (Сугияма) Жүрші?
Dialogue: 0,0:22:59.52,0:23:02.55,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:23:02.55,0:23:04.57,Default,,0000,0000,0000,,«Қара қара өрік» →
Dialogue: 0,0:23:04.57,0:23:09.62,Default,,0000,0000,0000,,«Ыстық шайға салып іш»? →
Dialogue: 0,0:23:09.62,0:23:13.66,Default,,0000,0000,0000,,Ол емделе ме? (Сугияма) Жүрші?
Dialogue: 0,0:23:13.66,0:23:20.06,Default,,0000,0000,0000,,３２ ３３ ３４ ３５…。
Dialogue: 0,0:23:20.06,0:23:24.10,Default,,0000,0000,0000,,<Ал соңғы жүзу жарысының күні келді>
Dialogue: 0,0:23:24.10,0:23:27.13,Default,,0000,0000,0000,,Охноның жігіті баяу.
Dialogue: 0,0:23:27.13,0:23:29.15,Default,,0000,0000,0000,,（） （）
Dialogue: 0,0:23:29.15,0:23:33.19,Default,,0000,0000,0000,,Ха ха ха ха…. О, мен оны уақытында жасадым.
Dialogue: 0,0:23:33.19,0:23:35.21,Default,,0000,0000,0000,,Бұл не, Сакура?
Dialogue: 0,0:23:35.21,0:23:40.26,Default,,0000,0000,0000,,Ештеңе... Оно-кун, сен әлі келдің бе?
Dialogue: 0,0:23:40.26,0:23:43.29,Default,,0000,0000,0000,,Иә. (Фуджики) Сакурадан баяу →
Dialogue: 0,0:23:43.29,0:23:48.34,Default,,0000,0000,0000,,Менің ойымша, бұл демалыс күні. Не айтқың келеді?
Dialogue: 0,0:23:48.34,0:23:51.34,Default,,0000,0000,0000,,Не болды, Оно?
Dialogue: 0,0:23:53.39,0:23:57.43,Default,,0000,0000,0000,,Менің ойымша, бұл демалыс күні.
Dialogue: 0,0:23:57.43,0:23:59.45,Default,,0000,0000,0000,,（） （）
Dialogue: 0,0:23:59.45,0:24:02.48,Default,,0000,0000,0000,,Иә? →
Dialogue: 0,0:24:02.48,0:24:04.50,Default,,0000,0000,0000,,Охно.
Dialogue: 0,0:24:04.50,0:24:08.54,Default,,0000,0000,0000,,Оно-кун. Охно: Суық бітті деп ойлаймын.
Dialogue: 0,0:24:08.54,0:24:10.56,Default,,0000,0000,0000,,О.
Dialogue: 0,0:24:10.56,0:24:14.77,Default,,0000,0000,0000,,Сіз маған міндетті түрде емделемін деп уәде бергенсіз.
Dialogue: 0,0:24:14.77,0:24:17.97,Default,,0000,0000,0000,,Ахха, Охно күткендей.
Dialogue: 0,0:24:17.97,0:24:20.97,Default,,0000,0000,0000,,Жақсы. Иә.
Dialogue: 0,0:24:22.02,0:24:24.04,Default,,0000,0000,0000,,Мен суық тигендіктен, мен саған жеңіл жүрмеймін.
Dialogue: 0,0:24:24.04,0:24:26.06,Default,,0000,0000,0000,,Қалауыңызша.
Dialogue: 0,0:24:26.06,0:24:28.08,Default,,0000,0000,0000,,Екеуіңізге сәттілік!
Dialogue: 0,0:24:28.08,0:24:30.10,Default,,0000,0000,0000,,Сәлем! (Ямане) Ух...
Dialogue: 0,0:24:30.10,0:24:34.14,Default,,0000,0000,0000,,《Мен бұл қарсыласыммен биылғы соңғы кездесу деп ойладым→
Dialogue: 0,0:24:34.14,0:24:36.16,Default,,0000,0000,0000,,Асқазан, асқазан және ішек...》
Dialogue: 0,0:24:38.18,0:24:40.20,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:24:40.20,0:24:43.23,Default,,0000,0000,0000,,Ха ха ха ха….
Dialogue: 0,0:24:43.23,0:24:46.26,Default,,0000,0000,0000,,Сәттілік! (Охно/Сугияма) Ха ха ха...
Dialogue: 0,0:24:46.26,0:24:48.28,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,0:24:48.28,0:24:51.31,Default,,0000,0000,0000,,Ха ха ха ха….
Dialogue: 0,0:24:51.31,0:24:55.35,Default,,0000,0000,0000,,Жылама! Ақымақ, Косей! Енді мен де…
Dialogue: 0,0:24:55.35,0:25:00.35,Default,,0000,0000,0000,,Ха ха ха ха….
Dialogue: 0,0:25:02.42,0:25:05.45,Default,,0000,0000,0000,,Ха ха ха ха….
Dialogue: 0,0:25:05.45,0:25:08.48,Default,,0000,0000,0000,,Иә! (Сугияма) Қарғыс атсын!
Dialogue: 0,0:25:08.48,0:25:11.51,Default,,0000,0000,0000,,Хаааах! Гүх!
Dialogue: 0,0:25:11.51,0:25:16.56,Default,,0000,0000,0000,,Енді 5-5 тең. (Сугияма) Келесі жылы шешеміз.
Dialogue: 0,0:25:16.56,0:25:20.60,Default,,0000,0000,0000,,Мен жеңілмеймін. (Сугияма) Мен де.
Dialogue: 0,0:25:20.60,0:25:23.63,Default,,0000,0000,0000,,Сугияма-кун мен Охно-кун келмегенде, біз жеңер едік →
Dialogue: 0,0:25:23.63,0:25:26.66,Default,,0000,0000,0000,,Сіз қандай әділ және турашылсыз!
Dialogue: 0,0:25:26.66,0:25:30.70,Default,,0000,0000,0000,,Фуджики де аздап шәкірт болуы керек. Эх...
Dialogue: 0,0:25:30.70,0:25:32.70,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:25:36.76,0:25:38.78,Default,,0000,0000,0000,,А... Иә?
Dialogue: 0,0:25:38.78,0:25:42.78,Default,,0000,0000,0000,,Биылғы жүзу аяқталды. Иә.
Dialogue: 0,0:25:50.90,0:25:52.92,Default,,0000,0000,0000,,Рахмет. Әжеме рахмет→
Dialogue: 0,0:25:52.92,0:25:57.97,Default,,0000,0000,0000,,Охно-кун, мен суықтан жазылып, жүзе алдым. Жоқ, жоқ.
Dialogue: 0,0:25:57.97,0:26:01.01,Default,,0000,0000,0000,,Өйткені, Охно-кун мен Сугияма-кун екеуі де жақсы қарсылас →
Dialogue: 0,0:26:01.01,0:26:07.07,Default,,0000,0000,0000,,Сіз көп жұмыс істей аласыз. Бірақ жүзу шаршатады.
Dialogue: 0,0:26:07.07,0:26:10.10,Default,,0000,0000,0000,,Эй, жалқау болма, Марукоға көмектес.
Dialogue: 0,0:26:10.10,0:26:15.48,Default,,0000,0000,0000,,Сонымен Маруко енді 25 метр жүзе алады ма?
Dialogue: 0,0:26:15.48,0:26:19.52,Default,,0000,0000,0000,,Міне, мен де бүгін жолда тұрып қалдым.
Dialogue: 0,0:26:19.52,0:26:21.54,Default,,0000,0000,0000,,Маруко үшін Оно мен Сугияма сияқты→
Dialogue: 0,0:26:21.54,0:26:25.58,Default,,0000,0000,0000,,Сізге қарсылас керек. Менің қарсыласым →
Dialogue: 0,0:26:25.58,0:26:27.60,Default,,0000,0000,0000,,Бұл менің әкем. иә?
Dialogue: 0,0:26:27.60,0:26:31.64,Default,,0000,0000,0000,,Біз қаншалықты қолымыздан келетінін білу үшін бәсекелеспіз.
Dialogue: 0,0:26:31.64,0:26:33.66,Default,,0000,0000,0000,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:26:33.66,0:26:36.69,Default,,0000,0000,0000,,Сыра ана. (3 адам) Әй...
Dialogue: 0,0:26:36.69,0:26:38.71,Default,,0000,0000,0000,,<Охно-кун мен Сугияма-кун сияқты→
Dialogue: 0,0:26:38.71,0:26:42.71,Default,,0000,0000,0000,,Ол өте күшті қарсылас болды>
Dialogue: 0,0:28:25.45,0:28:28.48,Default,,0000,0000,0000,,Қайырлы таң Тама-чан. Мару-чан Қайырлы таң.
Dialogue: 0,0:28:28.48,0:28:32.52,Default,,0000,0000,0000,,Иә? Ауада бір мұңды нәрсе бар...
Dialogue: 0,0:28:32.52,0:28:35.55,Default,,0000,0000,0000,,Уф... Мен аздап байланып қалдым, не болды?
Dialogue: 0,0:28:35.55,0:28:37.57,Default,,0000,0000,0000,,Бүгін шынымен қараңғы, боо.
Dialogue: 0,0:28:37.57,0:28:41.61,Default,,0000,0000,0000,,Амансың ба? Өзіңізді нашар сезінесіз бе?
Dialogue: 0,0:28:41.61,0:28:44.64,Default,,0000,0000,0000,,Олай емес. иә?
Dialogue: 0,0:28:44.64,0:28:47.67,Default,,0000,0000,0000,,Менің анам жоғалып кетуі мүмкін.
Dialogue: 0,0:28:47.67,0:28:49.69,Default,,0000,0000,0000,,Иә! Анам →
Dialogue: 0,0:28:49.69,0:28:51.71,Default,,0000,0000,0000,,Ол кетуі мүмкін!
Dialogue: 0,0:28:51.71,0:28:55.75,Default,,0000,0000,0000,,Е!
Dialogue: 0,0:28:55.75,0:28:57.77,Default,,0000,0000,0000,,Үйде болайық...
Dialogue: 0,0:28:57.77,0:29:00.80,Default,,0000,0000,0000,,《Таңертең тағы да кеш болды! 》→
Dialogue: 0,0:29:00.80,0:29:02.82,Default,,0000,0000,0000,,《Қайда, не істеп жүр едің?! 》
Dialogue: 0,0:29:02.82,0:29:04.84,Default,,0000,0000,0000,,《Оған көмектесу мүмкін емес.》
Dialogue: 0,0:29:04.84,0:29:06.86,Default,,0000,0000,0000,,《Ерлердің еркектерге қатысы бар.》
Dialogue: 0,0:29:06.86,0:29:08.88,Default,,0000,0000,0000,,《Ер адаммен қарым-қатынас дегеніміз не? 》
Dialogue: 0,0:29:08.88,0:29:11.91,Default,,0000,0000,0000,,《Біз күн сайын 5 иенден 10 иенге дейін күн көреміз→
Dialogue: 0,0:29:11.91,0:29:13.93,Default,,0000,0000,0000,,Менің басым толы болса да》
Dialogue: 0,0:29:13.93,0:29:15.95,Default,,0000,0000,0000,,《Тауық! Күнкөріспен айналысу әйелдің міндеті.
Dialogue: 0,0:29:15.95,0:29:19.15,Default,,0000,0000,0000,,《Соны айтсаң да болар еді.》
Dialogue: 0,0:29:19.15,0:29:22.35,Default,,0000,0000,0000,,《Таңертең доғарыңдар, ана мен әке.》
Dialogue: 0,0:29:22.35,0:29:24.37,Default,,0000,0000,0000,,《Шу! Шулы! 》
Dialogue: 0,0:29:24.37,0:29:27.40,Default,,0000,0000,0000,,《Мен тапқан ақша, оны жұмсағаным несі?》
Dialogue: 0,0:29:27.40,0:29:29.42,Default,,0000,0000,0000,,《Не деп тұрсың, сонша тәкаппар?》
Dialogue: 0,0:29:29.42,0:29:31.44,Default,,0000,0000,0000,,《Отбасына кім қамқорлық жасайды?》
Dialogue: 0,0:29:31.44,0:29:34.47,Default,,0000,0000,0000,,《Не…? Арызыңыз болса, шығыңыз! 》
Dialogue: 0,0:29:34.47,0:29:37.50,Default,,0000,0000,0000,,《Иә, иә, мен шығамын! 》
Dialogue: 0,0:29:37.50,0:29:41.54,Default,,0000,0000,0000,,《Мм…》
Dialogue: 0,0:29:41.54,0:29:44.57,Default,,0000,0000,0000,,《Әке ана》
Dialogue: 0,0:29:44.57,0:29:48.61,Default,,0000,0000,0000,,《Әй, ата, мына екеуін тоқтатыңыз.》
Dialogue: 0,0:29:48.61,0:29:50.63,Default,,0000,0000,0000,,《Мүмкін емес пе?》
Dialogue: 0,0:29:50.63,0:29:54.67,Default,,0000,0000,0000,,《Уф... уф...》
Dialogue: 0,0:29:54.67,0:29:57.70,Default,,0000,0000,0000,,Міне, таңнан бері қиналып жүрсің.
Dialogue: 0,0:29:57.70,0:30:02.75,Default,,0000,0000,0000,,Не істеуім керек? Егер анам шынымен келсе, мен... мен...
Dialogue: 0,0:30:02.75,0:30:04.77,Default,,0000,0000,0000,,Ой, сабыр ет.
Dialogue: 0,0:30:04.77,0:30:07.80,Default,,0000,0000,0000,,Апайдың кететіні әлі шешілген жоқ, боо.
Dialogue: 0,0:30:07.80,0:30:09.82,Default,,0000,0000,0000,,Дұрыс. Жеткілікті...
Dialogue: 0,0:30:09.82,0:30:12.85,Default,,0000,0000,0000,,Менің жастық шағым өтті.
Dialogue: 0,0:30:12.85,0:30:16.89,Default,,0000,0000,0000,,Иә? Жастық шақ әлі қалыптасу кезеңінде.
Dialogue: 0,0:30:16.89,0:30:20.26,Default,,0000,0000,0000,,Қалған өмірімді балам мен атамның күтімімен өткіздім→
Dialogue: 0,0:30:20.26,0:30:24.30,Default,,0000,0000,0000,,Тек аман қалуға тырысу. (бала жылайды)
Dialogue: 0,0:30:24.30,0:30:27.33,Default,,0000,0000,0000,,《Жарайды, жарайды, мен жақсы қызмын, сондықтан жылама, жылама.》
Dialogue: 0,0:30:27.33,0:30:30.36,Default,,0000,0000,0000,,（）《 》
Dialogue: 0,0:30:30.36,0:30:33.39,Default,,0000,0000,0000,,《Әже》 (Хамаджи атасы) 《Норитака》
Dialogue: 0,0:30:33.39,0:30:36.42,Default,,0000,0000,0000,,《Жарайды, жарайды, мен тамақ әзірлеуім керек.》
Dialogue: 0,0:30:36.42,0:30:40.46,Default,,0000,0000,0000,,《Бүгін түн тек күріш ботқасы мен маринадталған қара өрік, бірақ шыдамды болыңыз.》
Dialogue: 0,0:30:40.46,0:30:43.49,Default,,0000,0000,0000,,《Норика》 (нәрестенің жылауы)
Dialogue: 0,0:30:43.49,0:30:45.51,Default,,0000,0000,0000,,《Жарайды, жарайды, жылама, жылама》
Dialogue: 0,0:30:45.51,0:30:47.53,Default,,0000,0000,0000,,《Норика》
Dialogue: 0,0:30:47.53,0:30:50.56,Default,,0000,0000,0000,,Ах! Не істеуім керек? Не істеуім керек? →
Dialogue: 0,0:30:50.56,0:30:53.59,Default,,0000,0000,0000,,Уф…. (Бутаро) Ха, мен қатты таң қалдым...
Dialogue: 0,0:30:53.59,0:30:57.59,Default,,0000,0000,0000,,Менің асылатын сөзім жоқ. Мен келісемін.
Dialogue: 0,0:30:59.65,0:31:03.69,Default,,0000,0000,0000,,Боо…. аа….
Dialogue: 0,0:31:03.69,0:31:06.72,Default,,0000,0000,0000,,Көңіліңді көтер, жігітім. Бұл дұрыс.
Dialogue: 0,0:31:06.72,0:31:09.72,Default,,0000,0000,0000,,Ах. Сонда кездескенше.
Dialogue: 0,0:31:11.77,0:31:13.79,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:31:13.79,0:31:16.82,Default,,0000,0000,0000,,Бұл өте қиын.
Dialogue: 0,0:31:16.82,0:31:19.02,Default,,0000,0000,0000,,Учи де, өткен күні. иә?
Dialogue: 0,0:31:19.02,0:31:22.21,Default,,0000,0000,0000,,Анасы мен әкесі ұрысып қалды.
Dialogue: 0,0:31:22.21,0:31:24.23,Default,,0000,0000,0000,,《Бүгінгі бизнес туралы көптен бері айтып келемін →
Dialogue: 0,0:31:24.23,0:31:26.25,Default,,0000,0000,0000,,Сіз мұны сұрадыңыз! 》→
Dialogue: 0,0:31:26.25,0:31:28.27,Default,,0000,0000,0000,,《Соған қарамастан ол жоғалып кетті》
Dialogue: 0,0:31:28.27,0:31:30.29,Default,,0000,0000,0000,,《Ол жақтағы табиғат →
Dialogue: 0,0:31:30.29,0:31:33.32,Default,,0000,0000,0000,,Мен қазір суретке түсуім керек! 》
Dialogue: 0,0:31:33.32,0:31:35.34,Default,,0000,0000,0000,,《Оның қаншалықты маңызды екенін түсінбейсің! 》
Dialogue: 0,0:31:35.34,0:31:39.38,Default,,0000,0000,0000,,《Фотосуреттер Фотосуреттерге абай болмаңыз! 》
Dialogue: 0,0:31:39.38,0:31:41.40,Default,,0000,0000,0000,,《Мм…》
Dialogue: 0,0:31:41.40,0:31:43.42,Default,,0000,0000,0000,,《Әке, ана! 》
Dialogue: 0,0:31:43.42,0:31:46.45,Default,,0000,0000,0000,,Иә. Соңында әкем кешірім сұрады →
Dialogue: 0,0:31:46.45,0:31:48.47,Default,,0000,0000,0000,,Анам мені кешірді.
Dialogue: 0,0:31:48.47,0:31:52.51,Default,,0000,0000,0000,,Әкең мен шешеңнің ұрысып қалғанын ұнатпайсың.
Dialogue: 0,0:31:52.51,0:31:56.55,Default,,0000,0000,0000,,Маручанчи жоқ па? Әкем мен анам?
Dialogue: 0,0:31:56.55,0:32:00.59,Default,,0000,0000,0000,,Хмм, екеуі. Ұрыспайсың ба?
Dialogue: 0,0:32:00.59,0:32:03.62,Default,,0000,0000,0000,,Кішкентай нәрселер бар.
Dialogue: 0,0:32:03.62,0:32:06.65,Default,,0000,0000,0000,,《Аа, бұл жақсы ванна болды》 (Маруко/Сакико) 《Сәлеметсіз бе! 》
Dialogue: 0,0:32:06.65,0:32:08.67,Default,,0000,0000,0000,,《Әке, бірдеңе киіп беріңізші.》
Dialogue: 0,0:32:08.67,0:32:11.70,Default,,0000,0000,0000,,《Ол маска киіп, оны жасырып жүрген болуы керек.》
Dialogue: 0,0:32:11.70,0:32:14.73,Default,,0000,0000,0000,,《Егер көңіліңіз қалса, сіз де жасап көріңіз》
Dialogue: 0,0:32:14.73,0:32:16.75,Default,,0000,0000,0000,,《Ааа! 》《Хехехе...》
Dialogue: 0,0:32:16.75,0:32:19.45,Default,,0000,0000,0000,,《Ақылсыз сөйлеуді доғар》
Dialogue: 0,0:32:19.45,0:32:23.15,Default,,0000,0000,0000,,Мынадай нәрсе. Фуфуфуфу….
Dialogue: 0,0:32:23.15,0:32:26.18,Default,,0000,0000,0000,,Ойланып қарасақ, біз әрине татумыз.
Dialogue: 0,0:32:26.18,0:32:30.22,Default,,0000,0000,0000,,Әкем мен шешем сараң, сондықтан ұрысады.→
Dialogue: 0,0:32:30.22,0:32:33.25,Default,,0000,0000,0000,,Бұл энергияны босқа жұмсау деп ойламайсыз ба?
Dialogue: 0,0:32:33.25,0:32:36.28,Default,,0000,0000,0000,,Мұндай кезде тіпті сараң болу да пайдалы болуы мүмкін.
Dialogue: 0,0:32:36.28,0:32:39.31,Default,,0000,0000,0000,,Менің жағдайда. иә?
Dialogue: 0,0:32:39.31,0:32:41.33,Default,,0000,0000,0000,,Марукоға ашулану арқылы→
Dialogue: 0,0:32:41.33,0:32:44.36,Default,,0000,0000,0000,,Ананың қуаты таусылды →
Dialogue: 0,0:32:44.36,0:32:46.38,Default,,0000,0000,0000,,Ерлі-зайыптылардың төбелесіне айналады деп ойламаймын.
Dialogue: 0,0:32:46.38,0:32:49.41,Default,,0000,0000,0000,,Не? Бұл жақсы.
Dialogue: 0,0:32:49.41,0:32:51.43,Default,,0000,0000,0000,,Сізге рахмет, әкем мен анам осында →
Dialogue: 0,0:32:51.43,0:32:54.46,Default,,0000,0000,0000,,Төбелеспесең, пайдалысың.
Dialogue: 0,0:32:54.46,0:32:58.50,Default,,0000,0000,0000,,Иә? Ерлі-зайыптылардың арасында ұрыс-керіс болмайтыны менің кесірімнен бе?
Dialogue: 0,0:32:58.50,0:33:01.53,Default,,0000,0000,0000,,（） →
Dialogue: 0,0:33:01.53,0:33:04.56,Default,,0000,0000,0000,,Тамақтың уақыты келді! (Сакико/Маруко) Иә.
Dialogue: 0,0:33:04.56,0:33:19.71,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:33:19.71,0:33:23.09,Default,,0000,0000,0000,,Әй, ана, әке, бірдеңе болған жоқ па?
Dialogue: 0,0:33:23.09,0:33:27.13,Default,,0000,0000,0000,,Иә, төбелес шығар? Ха!
Dialogue: 0,0:33:27.13,0:33:29.13,Default,,0000,0000,0000,,Тыныш!
Dialogue: 0,0:33:32.18,0:33:36.22,Default,,0000,0000,0000,,Әке, ана, бірдеңе болды ма?
Dialogue: 0,0:33:36.22,0:33:38.24,Default,,0000,0000,0000,,Бөлек. Ештеңе.
Dialogue: 0,0:33:38.24,0:33:40.26,Default,,0000,0000,0000,,Бұл әлі біртүрлі.
Dialogue: 0,0:33:40.26,0:33:43.29,Default,,0000,0000,0000,,Маруко, сен бірдеңе істеген жоқсың ба?
Dialogue: 0,0:33:43.29,0:33:45.31,Default,,0000,0000,0000,,Не? Сіз үшін→
Dialogue: 0,0:33:45.31,0:33:47.33,Default,,0000,0000,0000,,Әкең мен шешең ұрысып жатқан жоқ па?
Dialogue: 0,0:33:47.33,0:33:49.35,Default,,0000,0000,0000,,Міне... Бұрынғы →
Dialogue: 0,0:33:49.35,0:33:52.38,Default,,0000,0000,0000,,Менің арқамда аманмын десең де.
Dialogue: 0,0:33:52.38,0:33:55.41,Default,,0000,0000,0000,,Енді мені ештеңеге кінәлама.
Dialogue: 0,0:33:55.41,0:33:59.45,Default,,0000,0000,0000,,Ах~ мен жедім мен жедім. Жақсы. иә?
Dialogue: 0,0:33:59.45,0:34:01.47,Default,,0000,0000,0000,,Әке, қайда барасыз?
Dialogue: 0,0:34:01.47,0:34:04.50,Default,,0000,0000,0000,,Тамақтанып болған соң, мен өз бөлмеме барамын.
Dialogue: 0,0:34:04.50,0:34:06.52,Default,,0000,0000,0000,,Бірақ әдетте тамақ ішіп болғаннан кейін де →
Dialogue: 0,0:34:06.52,0:34:09.55,Default,,0000,0000,0000,,Мен бұл жерде жалқау боламын.
Dialogue: 0,0:34:09.55,0:34:13.59,Default,,0000,0000,0000,,Мен осындамын ба, бөлмемдемін бе, өз еркім.
Dialogue: 0,0:34:13.59,0:34:15.61,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:34:15.61,0:34:17.63,Default,,0000,0000,0000,,Мені жалғыз қалдырыңыз. (Томозо) Дұрыс, дұрыс.
Dialogue: 0,0:34:17.63,0:34:19.48,Default,,0000,0000,0000,,Хиросиді жайына қалдыр.
Dialogue: 0,0:34:19.48,0:34:22.48,Default,,0000,0000,0000,,Хмм, бірақ...
Dialogue: 0,0:34:25.04,0:34:28.04,Default,,0000,0000,0000,,Ана…. Мен саған шай берейін.
Dialogue: 0,0:34:32.11,0:34:35.14,Default,,0000,0000,0000,,Эй Маруко, тырнақ қайшың қайда?
Dialogue: 0,0:34:35.14,0:34:39.18,Default,,0000,0000,0000,,Не? Бұл жақсы уақыт, сондықтан анаңыздан сұраңыз.
Dialogue: 0,0:34:39.18,0:34:41.20,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:34:41.20,0:34:44.23,Default,,0000,0000,0000,,Жарайды, маған тырнақ қайшы берші. Маған тырнақ қайшы берші.
Dialogue: 0,0:34:44.23,0:34:48.27,Default,,0000,0000,0000,,Мен неге...? Анашым, тырнақ қайшы қайда?
Dialogue: 0,0:34:48.27,0:34:55.34,Default,,0000,0000,0000,,Шайға арналған жәшік. Мүлдем емес...
Dialogue: 0,0:34:55.34,0:34:57.34,Default,,0000,0000,0000,,Иә. Оу.
Dialogue: 0,0:35:00.39,0:35:02.41,Default,,0000,0000,0000,,Мен оны өзім шығаруым керек еді.
Dialogue: 0,0:35:02.41,0:35:05.44,Default,,0000,0000,0000,,Өйткені анам оны үнемі шығарып отырады →
Dialogue: 0,0:35:05.44,0:35:07.46,Default,,0000,0000,0000,,Сіз оның қайда екенін білмейсіз. Маруко.
Dialogue: 0,0:35:07.46,0:35:09.48,Default,,0000,0000,0000,,Иә? Бұл →
Dialogue: 0,0:35:09.48,0:35:11.50,Default,,0000,0000,0000,,Әкеңе апар.
Dialogue: 0,0:35:11.50,0:35:15.54,Default,,0000,0000,0000,,Әй, мен саған ертерек беруім керек еді. Мен жаңа ғана тігуді аяқтадым.
Dialogue: 0,0:35:15.54,0:35:21.93,Default,,0000,0000,0000,,Мама, бару керек. Мама, менің жуатын ыдысым қалды.
Dialogue: 0,0:35:21.93,0:35:24.96,Default,,0000,0000,0000,,Сосын мен оны сұрадым.
Dialogue: 0,0:35:24.96,0:35:28.00,Default,,0000,0000,0000,,Сөз жоқ. Бұл біртүрлі, әпке. Иә.
Dialogue: 0,0:35:28.00,0:35:31.03,Default,,0000,0000,0000,,Сенің әкең мен шешең ұрысып жатыр ма?
Dialogue: 0,0:35:31.03,0:35:34.06,Default,,0000,0000,0000,,Иә. Біз сөйлеспейміз немесе көзбен байланыспаймыз.
Dialogue: 0,0:35:34.06,0:35:39.11,Default,,0000,0000,0000,,Ата, әже, сіз бірдеңе білесіз бе?
Dialogue: 0,0:35:39.11,0:35:42.14,Default,,0000,0000,0000,,Жоқ, біз әсіресе...
Dialogue: 0,0:35:42.14,0:35:44.16,Default,,0000,0000,0000,,Ұрыс жақсы емес.
Dialogue: 0,0:35:44.16,0:35:46.18,Default,,0000,0000,0000,,Мен саған айтамын, ұрысуды доғар.
Dialogue: 0,0:35:46.18,0:35:50.22,Default,,0000,0000,0000,,Мен әкем мен шешемнің ұрысып жатқанын жек көремін.
Dialogue: 0,0:35:50.22,0:35:52.24,Default,,0000,0000,0000,,Жарайды. (Сакико/Маруко) Иә?
Dialogue: 0,0:35:52.24,0:35:55.27,Default,,0000,0000,0000,,Уайымдамаңыз. Бұл әдеттегі.
Dialogue: 0,0:35:55.27,0:35:58.30,Default,,0000,0000,0000,,Жалпы ма? Солай ма?
Dialogue: 0,0:35:58.30,0:36:01.33,Default,,0000,0000,0000,,Ах. Ерлі-зайыптылар ұзақ уақыт бірге тұрса →
Dialogue: 0,0:36:01.33,0:36:04.36,Default,,0000,0000,0000,,Мұндай жағдай барлық жерде болады.
Dialogue: 0,0:36:04.36,0:36:07.39,Default,,0000,0000,0000,,Сонымен, ата мен әжеде де бар ма?
Dialogue: 0,0:36:07.39,0:36:10.42,Default,,0000,0000,0000,,Ал, біз... Хохохохо....
Dialogue: 0,0:36:10.42,0:36:14.46,Default,,0000,0000,0000,,Әрине болды. Ха! Әже, шынымен бе?
Dialogue: 0,0:36:14.46,0:36:18.50,Default,,0000,0000,0000,,Қалай өтті деп таң қалдым...
Dialogue: 0,0:36:18.50,0:36:21.87,Default,,0000,0000,0000,,Әй, мынаны-мұны ұмыттың ба?
Dialogue: 0,0:36:21.87,0:36:24.90,Default,,0000,0000,0000,,Иә! Эй, эй сен не деп тұрсың?
Dialogue: 0,0:36:24.90,0:36:26.92,Default,,0000,0000,0000,,Мен оны естігім келеді. Солай емес пе?
Dialogue: 0,0:36:26.92,0:36:29.95,Default,,0000,0000,0000,,Сол кезде...
Dialogue: 0,0:36:29.95,0:36:32.98,Default,,0000,0000,0000,,《Неге сонша қымбат сатып алдың!? 》
Dialogue: 0,0:36:32.98,0:36:34.00,Default,,0000,0000,0000,,《Біраз уақыт күріш сатып ала алмайсың! 》
Dialogue: 0,0:36:34.00,0:36:37.03,Default,,0000,0000,0000,,《Бірақ менің отбасымның қауіпсіздігі》
Dialogue: 0,0:36:37.03,0:36:40.06,Default,,0000,0000,0000,,《Әйелімнің қауіпсіздігі туралы емес! 》
Dialogue: 0,0:36:40.06,0:36:44.10,Default,,0000,0000,0000,,《Сәлеметсіз бе! кешіріңіз…»
Dialogue: 0,0:36:44.10,0:36:49.15,Default,,0000,0000,0000,,Уау! Әженің есте сақтау қабілеті керемет. Ахахаха….
Dialogue: 0,0:36:49.15,0:36:52.18,Default,,0000,0000,0000,,Бұл тек бастамасы ғана.
Dialogue: 0,0:36:52.18,0:36:54.20,Default,,0000,0000,0000,,Иә. Ата мен әже →
Dialogue: 0,0:36:54.20,0:36:57.23,Default,,0000,0000,0000,,Мен сені ұрыспайды деп ойладым.
Dialogue: 0,0:36:57.23,0:36:59.25,Default,,0000,0000,0000,,Жарайды, ұрыстан артық→
Dialogue: 0,0:36:59.25,0:37:02.28,Default,,0000,0000,0000,,Атаны әжесі ұрысты, солай ма?
Dialogue: 0,0:37:02.28,0:37:05.31,Default,,0000,0000,0000,,Гүлп…. Хохохохо.
Dialogue: 0,0:37:05.31,0:37:09.35,Default,,0000,0000,0000,,Осыларды қайта-қайта жеңу→
Dialogue: 0,0:37:09.35,0:37:13.39,Default,,0000,0000,0000,,Екеуміз бірге қартайдық. →
Dialogue: 0,0:37:13.39,0:37:15.41,Default,,0000,0000,0000,,Барлық жерде солай.
Dialogue: 0,0:37:15.41,0:37:17.43,Default,,0000,0000,0000,,Иә, солай.
Dialogue: 0,0:37:17.43,0:37:21.80,Default,,0000,0000,0000,,Әкем, анам, әпкем және Маруко→
Dialogue: 0,0:37:21.80,0:37:24.83,Default,,0000,0000,0000,,Мен сені ренжітетін ештеңе жасамас едім.
Dialogue: 0,0:37:24.83,0:37:27.86,Default,,0000,0000,0000,,Жарайды. (Томозо) Дұрыс, дұрыс.
Dialogue: 0,0:37:27.86,0:37:30.89,Default,,0000,0000,0000,,Ертең келгенде мен сонда боламын.
Dialogue: 0,0:37:30.89,0:37:34.93,Default,,0000,0000,0000,,Түсінемін, бұл жақсы болар еді.
Dialogue: 0,0:37:34.93,0:37:36.93,Default,,0000,0000,0000,,<Ал келесі күні таңертең>
Dialogue: 0,0:37:44.03,0:37:49.08,Default,,0000,0000,0000,,Керотто қайда орналасқан? Иә.
Dialogue: 0,0:37:49.08,0:37:51.08,Default,,0000,0000,0000,,Жүр, кеттік.
Dialogue: 0,0:37:53.12,0:37:56.15,Default,,0000,0000,0000,,Қош келдіңіз. Өз-өзіңді күт.
Dialogue: 0,0:37:56.15,0:37:59.18,Default,,0000,0000,0000,,Қош келдіңіз.
Dialogue: 0,0:37:59.18,0:38:04.18,Default,,0000,0000,0000,,Иә? Тез тамақ ішпесеңіз, кешігіп қаласыз. Уф иә.
Dialogue: 0,0:38:12.31,0:38:14.33,Default,,0000,0000,0000,,Әке мен шеше→
Dialogue: 0,0:38:14.33,0:38:17.36,Default,,0000,0000,0000,,Сөйлесе алмайсың ғой. Иә….
Dialogue: 0,0:38:17.36,0:38:19.38,Default,,0000,0000,0000,,<Әкең мен анаң ше?>
Dialogue: 0,0:38:19.38,0:38:21.40,Default,,0000,0000,0000,,Ұрыстың себебі неде＞
Dialogue: 0,0:38:21.40,0:38:25.44,Default,,0000,0000,0000,,<Ал екеуі аман-есен татуласа ала ма>
Dialogue: 0,0:38:25.44,0:38:27.44,Default,,0000,0000,0000,,<Екінші жартыға алаңдаушылықпен жалғастыру>
Dialogue: 0,0:40:41.46,0:40:43.48,Default,,0000,0000,0000,,Аа... не болды? Мару-чан.
Dialogue: 0,0:40:43.48,0:40:47.52,Default,,0000,0000,0000,,Иә, аздап. иә? Ойлап қарасаңыз, сіз оған тәуелдісіз бе?
Dialogue: 0,0:40:47.52,0:40:51.52,Default,,0000,0000,0000,,（）
Dialogue: 0,0:40:53.58,0:40:55.60,Default,,0000,0000,0000,,Қайырлы таң.
Dialogue: 0,0:40:55.60,0:40:58.63,Default,,0000,0000,0000,,Хамасаки-кун бүгін отбасылық мәселелерге байланысты жоқ.
Dialogue: 0,0:40:58.63,0:41:01.66,Default,,0000,0000,0000,,Отбасылық жағдайлар? Бұл не?
Dialogue: 0,0:41:01.66,0:41:04.69,Default,,0000,0000,0000,,Ха! Мен апам келеді деп күтпедім...
Dialogue: 0,0:41:04.69,0:41:06.71,Default,,0000,0000,0000,,(нәресте жылады)
Dialogue: 0,0:41:06.71,0:41:08.73,Default,,0000,0000,0000,,《А, жарайды, жарайды, бұдан былай →
Dialogue: 0,0:41:08.73,0:41:10.75,Default,,0000,0000,0000,,Сені ағам өсіреді.
Dialogue: 0,0:41:10.75,0:41:13.78,Default,,0000,0000,0000,,《Норика Норика》
Dialogue: 0,0:41:13.78,0:41:16.81,Default,,0000,0000,0000,,《Норика әлі тамақтанып жатыр》
Dialogue: 0,0:41:16.81,0:41:19.84,Default,,0000,0000,0000,,《Жарайды, жарайды, ата, мен қазір дайындалайын.》
Dialogue: 0,0:41:19.84,0:41:22.87,Default,,0000,0000,0000,,(нәресте жылады)
Dialogue: 0,0:41:22.87,0:41:25.90,Default,,0000,0000,0000,,《Ух...》 (Хамаджи атасы) 《Норитака》
Dialogue: 0,0:41:25.90,0:41:29.94,Default,,0000,0000,0000,,《Осындай болса, мынандай боламын →
Dialogue: 0,0:41:29.94,0:41:32.97,Default,,0000,0000,0000,,Мама кете ме деп ойлаймын.
Dialogue: 0,0:41:32.97,0:41:49.48,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:41:49.48,0:41:52.51,Default,,0000,0000,0000,,Үлкен апа, әке және шеше→
Dialogue: 0,0:41:52.51,0:41:54.53,Default,,0000,0000,0000,,Осылай қанша уақыт болғың келеді?
Dialogue: 0,0:41:54.53,0:41:56.55,Default,,0000,0000,0000,,Маруко. иә?
Dialogue: 0,0:41:56.55,0:41:59.58,Default,,0000,0000,0000,,Сіз ашулануыңыз керек. иә?
Dialogue: 0,0:41:59.58,0:42:01.60,Default,,0000,0000,0000,,Қараңыз, егер ашулансаңыз →
Dialogue: 0,0:42:01.60,0:42:04.63,Default,,0000,0000,0000,,Күйеуіңізбен ұрысуға күшіңіз таусылуы мүмкін.
Dialogue: 0,0:42:04.63,0:42:07.66,Default,,0000,0000,0000,,Күте тұрыңыз... сіз кенет осылай дедіңіз.
Dialogue: 0,0:42:07.66,0:42:10.69,Default,,0000,0000,0000,,Ана мен әкенің мәңгі осылай қалуы дұрыс па?
Dialogue: 0,0:42:10.69,0:42:12.71,Default,,0000,0000,0000,,Маған бұл ұнамайды, бірақ...
Dialogue: 0,0:42:12.71,0:42:15.74,Default,,0000,0000,0000,,Тест тапсырыңыз. Ха!
Dialogue: 0,0:42:15.74,0:42:18.77,Default,,0000,0000,0000,,Көрінбейтіндіктен жасырынғандар. Өйткені бұл сіз туралы →
Dialogue: 0,0:42:18.77,0:42:22.81,Default,,0000,0000,0000,,Сіздің үстеліңізде бір-екі бар, солай ма?
Dialogue: 0,0:42:22.81,0:42:26.85,Default,,0000,0000,0000,,Сіз қайдан білесіз? Әй, әпке, көрдіңіз ғой.
Dialogue: 0,0:42:26.85,0:42:29.88,Default,,0000,0000,0000,,Білу үшін іздеудің қажеті жоқ. Жүр, тезірек.
Dialogue: 0,0:42:29.88,0:42:32.91,Default,,0000,0000,0000,,А, мен көмектесе алмаймын!
Dialogue: 0,0:42:32.91,0:42:37.96,Default,,0000,0000,0000,,Қандай ұпай! Мен оны қалай аламын?
Dialogue: 0,0:42:37.96,0:42:39.14,Default,,0000,0000,0000,,Шынында да, бұл менің әкем мен шешем→
Dialogue: 0,0:42:39.14,0:42:41.33,Default,,0000,0000,0000,,Сіз төбелесуді тоқтатасыз, солай ма?
Dialogue: 0,0:42:41.33,0:42:45.37,Default,,0000,0000,0000,,Бұл сөзсіз. Және бұл да.
Dialogue: 0,0:42:45.37,0:42:49.41,Default,,0000,0000,0000,,Иә? Апыр-ай! Бұл сенің анаңның алқасы емес.
Dialogue: 0,0:42:49.41,0:42:52.44,Default,,0000,0000,0000,,Не болды? Жоқ, өзіңізді Линда деп көрсетіңіз.
Dialogue: 0,0:42:52.44,0:42:57.49,Default,,0000,0000,0000,,Қараңдаршы, бұл сахналық киім. Мен атмосфераны жандандырғым келді.
Dialogue: 0,0:42:57.49,0:43:01.53,Default,,0000,0000,0000,,Сосын сен мені ұрдың.
Dialogue: 0,0:43:01.53,0:43:04.56,Default,,0000,0000,0000,,Сіз оны көптен бері жасырып жүрсіз.
Dialogue: 0,0:43:04.56,0:43:08.60,Default,,0000,0000,0000,,Бірақ әке мен шеше төбелесуді тоқтатса→
Dialogue: 0,0:43:08.60,0:43:11.63,Default,,0000,0000,0000,,Денемді сапқа қойып, жаман адам боламын!
Dialogue: 0,0:43:11.63,0:43:14.63,Default,,0000,0000,0000,,<Ол көптен бері жаман жігіт>
Dialogue: 0,0:43:16.68,0:43:20.72,Default,,0000,0000,0000,,...
Dialogue: 0,0:43:20.72,0:43:24.76,Default,,0000,0000,0000,,Маған не көрсеткіңіз келеді? Қарашы, Маруко.
Dialogue: 0,0:43:24.76,0:43:27.79,Default,,0000,0000,0000,,Мама, менің ойымша, ол ашуланады...
Dialogue: 0,0:43:27.79,0:43:31.83,Default,,0000,0000,0000,,Жоқ, ашулануға болмайды. иә?
Dialogue: 0,0:43:31.83,0:43:33.85,Default,,0000,0000,0000,,Иә! Бұл қандай қорқынышты нүкте?
Dialogue: 0,0:43:33.85,0:43:35.87,Default,,0000,0000,0000,,А, бұл да, мынау да!
Dialogue: 0,0:43:35.87,0:43:39.58,Default,,0000,0000,0000,,Қараңызшы, бұл да. Уф...
Dialogue: 0,0:43:39.58,0:43:41.26,Default,,0000,0000,0000,,Иә, бұл да... Ах!
Dialogue: 0,0:43:41.26,0:43:45.30,Default,,0000,0000,0000,,Мен мұны жоғалтып алдым деп ойлап, іздеп жүрмін. →
Dialogue: 0,0:43:45.30,0:43:48.30,Default,,0000,0000,0000,,Ах, бұзылды!
Dialogue: 0,0:43:50.35,0:43:54.39,Default,,0000,0000,0000,,Маруко! →
Dialogue: 0,0:43:54.39,0:43:57.42,Default,,0000,0000,0000,,Сіз кімсіз! кешіріңіз….
Dialogue: 0,0:43:57.42,0:44:00.45,Default,,0000,0000,0000,,Ха ха ха ха….
Dialogue: 0,0:44:00.45,0:44:05.50,Default,,0000,0000,0000,,Аа... Менің ашуланып, шаршағаныма біраз болды.
Dialogue: 0,0:44:05.50,0:44:08.53,Default,,0000,0000,0000,,Анашым, амансыз ба? иә?
Dialogue: 0,0:44:08.53,0:44:10.55,Default,,0000,0000,0000,,Анам маған ашуланса→
Dialogue: 0,0:44:10.55,0:44:14.59,Default,,0000,0000,0000,,Шаршап, әкеңмен ұрысып қалсаң, қуат таусылады, солай ма?
Dialogue: 0,0:44:14.59,0:44:17.62,Default,,0000,0000,0000,,Анашым, әкем екеуіңіз ұрысып жатырсыздар, солай ма?
Dialogue: 0,0:44:17.62,0:44:19.62,Default,,0000,0000,0000,,Иә? иә?
Dialogue: 0,0:44:21.66,0:44:24.69,Default,,0000,0000,0000,,Ана мен әке ұрыспайды.
Dialogue: 0,0:44:24.69,0:44:26.71,Default,,0000,0000,0000,,Өтірік. Өйткені...
Dialogue: 0,0:44:26.71,0:44:28.73,Default,,0000,0000,0000,,Осындай нәрселерге алаңдауға уақыт болса →
Dialogue: 0,0:44:28.73,0:44:30.75,Default,,0000,0000,0000,,Тез шомылып, төсекке жату.
Dialogue: 0,0:44:30.75,0:44:32.77,Default,,0000,0000,0000,,Бірақ... Балалар бір-бірден →
Dialogue: 0,0:44:32.77,0:44:34.79,Default,,0000,0000,0000,,Басыңды кіргізбе!
Dialogue: 0,0:44:34.79,0:44:37.79,Default,,0000,0000,0000,,Ах... Хмф!
Dialogue: 0,0:44:39.84,0:44:42.21,Default,,0000,0000,0000,,Не, бұл не! (Хироши/Сумире) Иә?
Dialogue: 0,0:44:42.21,0:44:46.25,Default,,0000,0000,0000,,Мен оларға сынақты көрсетсем де... Тіпті алқа да...
Dialogue: 0,0:44:46.25,0:44:49.28,Default,,0000,0000,0000,,Сосын маған ұрысу жақсы емес.
Dialogue: 0,0:44:49.28,0:44:55.34,Default,,0000,0000,0000,,Мен екеуі төбелесуді тоқтатады деп ойладым, бірақ...
Dialogue: 0,0:44:55.34,0:44:57.34,Default,,0000,0000,0000,,Ах! Маруко!
Dialogue: 0,0:44:59.38,0:45:02.38,Default,,0000,0000,0000,,Хун. Хм... Хмф!
Dialogue: 0,0:45:05.44,0:45:07.44,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:45:10.49,0:45:12.49,Default,,0000,0000,0000,,Кешіріңіз, Маруко.
Dialogue: 0,0:45:17.56,0:45:23.56,Default,,0000,0000,0000,,《Не, не, әкең ақымақ, шешең ақымақ》
Dialogue: 0,0:45:28.67,0:45:30.69,Default,,0000,0000,0000,,Қайырлы таң. (Балалар) Қайырлы таң.
Dialogue: 0,0:45:30.69,0:45:32.71,Default,,0000,0000,0000,,Қайырлы таң Мару-чан.
Dialogue: 0,0:45:32.71,0:45:35.74,Default,,0000,0000,0000,,Не болды? Сіз өзіңізді жақсы сезінбейтін сияқтысыз.
Dialogue: 0,0:45:35.74,0:45:39.74,Default,,0000,0000,0000,,Иә, жарайды, жарайды.
Dialogue: 0,0:45:41.13,0:45:44.16,Default,,0000,0000,0000,,《Хамаджи бүгін де жабық па?》
Dialogue: 0,0:45:44.16,0:45:46.18,Default,,0000,0000,0000,,Е!
Dialogue: 0,0:45:46.18,0:45:48.20,Default,,0000,0000,0000,,Анам Шидзуокада?
Dialogue: 0,0:45:48.20,0:45:50.22,Default,,0000,0000,0000,,Сіз шынымен кетіп қалдыңыз ба?
Dialogue: 0,0:45:50.22,0:45:52.24,Default,,0000,0000,0000,,Жоқ, жоқ.
Dialogue: 0,0:45:52.24,0:45:55.27,Default,,0000,0000,0000,,Менің Сидзуокада тұратын әжемнің жағдайы нашар.
Dialogue: 0,0:45:55.27,0:45:57.29,Default,,0000,0000,0000,,Сондықтан мен саған көмектесуге бардым.
Dialogue: 0,0:45:57.29,0:46:00.32,Default,,0000,0000,0000,,Не? Шизуоканың әжесі ауырып жатыр ма?
Dialogue: 0,0:46:00.32,0:46:06.38,Default,,0000,0000,0000,,Жаздан шаршаған сияқтысың. Бірақ алаңдаудың қажеті жоқ.
Dialogue: 0,0:46:06.38,0:46:10.42,Default,,0000,0000,0000,,Мен көремін. Мама, ол кетпеді.
Dialogue: 0,0:46:10.42,0:46:12.44,Default,,0000,0000,0000,,Аа, жақсы. Қайтар жолда сәл ғана →
Dialogue: 0,0:46:12.44,0:46:15.47,Default,,0000,0000,0000,,Кеш болатын сияқты. Түсіндім.
Dialogue: 0,0:46:15.47,0:46:19.51,Default,,0000,0000,0000,,Иә. Маруко мен әже бүгін жетті ме?
Dialogue: 0,0:46:19.51,0:46:23.55,Default,,0000,0000,0000,,Ол ерекше керемет болды. Хехехе….
Dialogue: 0,0:46:23.55,0:46:26.58,Default,,0000,0000,0000,,Маруко: Бұл қайнатылған балық дәмді.
Dialogue: 0,0:46:26.58,0:46:30.62,Default,,0000,0000,0000,,Охиташи де, мисо сорпасы да дәмді.
Dialogue: 0,0:46:30.62,0:46:34.66,Default,,0000,0000,0000,,Мен қайнатылған тағамдар, охиташи немесе мисо сорпасын жасамаймын.
Dialogue: 0,0:46:34.66,0:46:36.68,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:46:36.68,0:46:38.70,Default,,0000,0000,0000,,Маруко маған күрішті қайнатып берді.
Dialogue: 0,0:46:38.70,0:46:42.07,Default,,0000,0000,0000,,Күтілгендей! Мен бұл күрішті дәмді деп ойладым.
Dialogue: 0,0:46:42.07,0:46:45.10,Default,,0000,0000,0000,,Мен көремін. Оны Маруко пісірді. (Барлығы) Ух...
Dialogue: 0,0:46:45.10,0:46:50.15,Default,,0000,0000,0000,,Мен оны күріш пеште пісірдім, мен жай ғана қосқышты басқанмын.
Dialogue: 0,0:46:50.15,0:46:52.17,Default,,0000,0000,0000,,Не болса да мені мақтағың келді.
Dialogue: 0,0:46:52.17,0:46:55.20,Default,,0000,0000,0000,,...
Dialogue: 0,0:46:58.23,0:47:02.27,Default,,0000,0000,0000,,Иә Сәлем. Ана, сіз Шимизу станциясына келдіңіз бе?
Dialogue: 0,0:47:02.27,0:47:04.29,Default,,0000,0000,0000,,Не? Әлі де Шидзуокадасыз ба?
Dialogue: 0,0:47:04.29,0:47:08.33,Default,,0000,0000,0000,,Шидзуокада әже дәрігерге қаралған соң →
Dialogue: 0,0:47:08.33,0:47:11.36,Default,,0000,0000,0000,,Ол бүгін күні бойы ұйықтауым керек деді. иә?
Dialogue: 0,0:47:11.36,0:47:13.38,Default,,0000,0000,0000,,Мен туралы →
Dialogue: 0,0:47:13.38,0:47:16.41,Default,,0000,0000,0000,,Уайымдама, қазір үйге қайт.
Dialogue: 0,0:47:16.41,0:47:18.43,Default,,0000,0000,0000,,Әже ұйықтап жатыр...
Dialogue: 0,0:47:18.43,0:47:21.46,Default,,0000,0000,0000,,Қазір бәрі жақсы. Уф...
Dialogue: 0,0:47:21.46,0:47:24.49,Default,,0000,0000,0000,,А, әже... А, сәлем, Маруко. →
Dialogue: 0,0:47:24.49,0:47:28.53,Default,,0000,0000,0000,,Кешіріңіз. Сондықтан, мама, мен бүгін осында қаламын.
Dialogue: 0,0:47:28.53,0:47:32.57,Default,,0000,0000,0000,,Иә, түсіндім. Ертең жексенбі.
Dialogue: 0,0:47:32.57,0:47:36.57,Default,,0000,0000,0000,,Иә, бұл жерде бәрі жақсы. Сонда кездескенше, сау бол.
Dialogue: 0,0:47:38.63,0:47:41.99,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:47:41.99,0:47:44.02,Default,,0000,0000,0000,,Мама, сіз бүгін қонақтасыз. Мен түсінемін.
Dialogue: 0,0:47:44.02,0:47:47.05,Default,,0000,0000,0000,,Шизуокада әже, жақсысыз ба?
Dialogue: 0,0:47:47.05,0:47:51.09,Default,,0000,0000,0000,,Не? Анаң жаныңда болса, бәрі жақсы болады.
Dialogue: 0,0:47:51.09,0:47:54.12,Default,,0000,0000,0000,,Дұрыс, дұрыс. Иә….
Dialogue: 0,0:47:54.12,0:47:56.14,Default,,0000,0000,0000,,Иә? Ах!
Dialogue: 0,0:47:56.14,0:47:58.16,Default,,0000,0000,0000,,Әке! Бұл Хироси!
Dialogue: 0,0:47:58.16,0:48:01.19,Default,,0000,0000,0000,,Хехе. Жын жоқта тағы біреуі.
Dialogue: 0,0:48:01.19,0:48:04.22,Default,,0000,0000,0000,,Мен ертең анаңа айтамын.
Dialogue: 0,0:48:04.22,0:48:06.24,Default,,0000,0000,0000,,Иә, иә, айтамын.
Dialogue: 0,0:48:06.24,0:48:09.27,Default,,0000,0000,0000,,Айтқыңыз келсе, айтыңыз. Кім ішсе, сол жеңеді. →
Dialogue: 0,0:48:09.27,0:48:13.27,Default,,0000,0000,0000,,Мен оны қазір іше алатын болсам, бұл жақсы.
Dialogue: 0,0:48:15.33,0:48:17.35,Default,,0000,0000,0000,,Пуха~! Дәмді! →
Dialogue: 0,0:48:17.35,0:48:21.35,Default,,0000,0000,0000,,Мен бүгін кешке барамын деп ойлаймын.
Dialogue: 0,0:48:23.41,0:48:25.43,Default,,0000,0000,0000,,Пуха~!
Dialogue: 0,0:48:25.43,0:48:28.46,Default,,0000,0000,0000,,Анаңның жоқтығына әкең риза ма?
Dialogue: 0,0:48:28.46,0:48:30.46,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:48:32.50,0:48:38.56,Default,,0000,0000,0000,,Бұл маңызды емес. Мен мұны іше алатын болсам, бұл жақсы.
Dialogue: 0,0:48:38.56,0:48:43.95,Default,,0000,0000,0000,,«Бұл маңызды емес»... өзімізді қалай сезінетінімізді де білмейміз.
Dialogue: 0,0:48:43.95,0:48:48.95,Default,,0000,0000,0000,,Тауық. Қарғыс атсын, сен тіпті менің сезімімді білмейсің.
Dialogue: 0,0:48:50.02,0:48:52.04,Default,,0000,0000,0000,,Әкемнің ақымақ! Ах, Маруко.
Dialogue: 0,0:48:52.04,0:48:54.06,Default,,0000,0000,0000,,Маруко.
Dialogue: 0,0:48:54.06,0:48:56.06,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:49:04.16,0:49:06.18,Default,,0000,0000,0000,,Маруко.
Dialogue: 0,0:49:06.18,0:49:09.21,Default,,0000,0000,0000,,Әкем сыра ішкісі келеді.
Dialogue: 0,0:49:09.21,0:49:14.26,Default,,0000,0000,0000,,Жарайды, мама, мен ертең келемін.
Dialogue: 0,0:49:14.26,0:49:16.28,Default,,0000,0000,0000,,Ертең қайтып келетініңізге сенімдісіз бе?
Dialogue: 0,0:49:16.28,0:49:20.32,Default,,0000,0000,0000,,Не? Маған не болды→
Dialogue: 0,0:49:20.32,0:49:24.36,Default,,0000,0000,0000,,Мама, мен қайтып келмейтін сияқтымын.
Dialogue: 0,0:49:24.36,0:49:26.36,Default,,0000,0000,0000,,Маруко….
Dialogue: 0,0:49:28.40,0:49:31.43,Default,,0000,0000,0000,,《Анашым! Анашым! 》
Dialogue: 0,0:49:31.43,0:49:36.48,Default,,0000,0000,0000,,《Сау бол, жақсы қыз бол. Қош бол Маруко》
Dialogue: 0,0:49:36.48,0:49:38.50,Default,,0000,0000,0000,,《Анашым! 》
Dialogue: 0,0:49:38.50,0:49:43.88,Default,,0000,0000,0000,,《Анашым! Анашым! 》
Dialogue: 0,0:49:43.88,0:49:48.88,Default,,0000,0000,0000,,Ха! Бұл арман болды ма? Мен қуаныштымын...
Dialogue: 0,0:49:50.95,0:49:52.97,Default,,0000,0000,0000,,Мен музыка колледжінде Саки Аримамен бір курс болғанмын, сондықтан→
Dialogue: 0,0:49:52.97,0:49:56.01,Default,,0000,0000,0000,,(ұйықтау)
Dialogue: 0,0:49:56.01,0:50:00.05,Default,,0000,0000,0000,,Әке Әке. Уф...
Dialogue: 0,0:50:00.05,0:50:02.07,Default,,0000,0000,0000,,Иә? мен барамын.
Dialogue: 0,0:50:02.07,0:50:04.07,Default,,0000,0000,0000,,Қайда?
Dialogue: 0,0:50:07.12,0:50:12.17,Default,,0000,0000,0000,,Жұмсақ. Күте тұрсаң, ол қайтып келеді.
Dialogue: 0,0:50:12.17,0:50:14.19,Default,,0000,0000,0000,,Жоқ. Мен сені алып кетейін.
Dialogue: 0,0:50:14.19,0:50:18.23,Default,,0000,0000,0000,,Тексеру. Мен Кеса жай демалып, ұйықтай алады деп ойладым.
Dialogue: 0,0:50:18.23,0:50:21.23,Default,,0000,0000,0000,,Жұмсақ.
Dialogue: 0,0:50:25.30,0:50:27.32,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:50:27.32,0:50:39.44,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:50:39.44,0:50:41.46,Default,,0000,0000,0000,,Жақсы.
Dialogue: 0,0:50:41.46,0:50:45.50,Default,,0000,0000,0000,,Маруко мені алып кетуге бара жатқанда шу болды.
Dialogue: 0,0:50:45.50,0:50:47.52,Default,,0000,0000,0000,,Әже, көңіл күйіңіз қалай? Емделді ме?
Dialogue: 0,0:50:47.52,0:50:51.56,Default,,0000,0000,0000,,Сізді алаңдатқаным үшін кешіріңіз. Ол әлдеқайда жақсарды.
Dialogue: 0,0:50:51.56,0:50:54.59,Default,,0000,0000,0000,,Мен үйге қайтуды ойлап жүр едім.
Dialogue: 0,0:50:54.59,0:50:56.61,Default,,0000,0000,0000,,Шынымен бе? иә?
Dialogue: 0,0:50:56.61,0:51:01.66,Default,,0000,0000,0000,,Мама, ол үйге келмейтін шығар.
Dialogue: 0,0:51:01.66,0:51:03.68,Default,,0000,0000,0000,,Эй, бұл дұрыс емес.
Dialogue: 0,0:51:03.68,0:51:06.71,Default,,0000,0000,0000,,Жүр, кел, тұр, тұр.
Dialogue: 0,0:51:06.71,0:51:08.73,Default,,0000,0000,0000,,Жоқ, бүгін осында.
Dialogue: 0,0:51:08.73,0:51:12.77,Default,,0000,0000,0000,,Әже, денеңізді күтіңіз. Рақмет сізге.
Dialogue: 0,0:51:12.77,0:51:15.80,Default,,0000,0000,0000,,Мару-чан, келесі жолы тағы кел.
Dialogue: 0,0:51:15.80,0:51:17.80,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:51:22.87,0:51:26.91,Default,,0000,0000,0000,,Әй, әкең мен шешеңнің ұрысуының себебі не?
Dialogue: 0,0:51:26.91,0:51:28.93,Default,,0000,0000,0000,,Уф! Бөлек →
Dialogue: 0,0:51:28.93,0:51:30.95,Default,,0000,0000,0000,,Біз ұрысып жатқан жоқпыз.
Dialogue: 0,0:51:30.95,0:51:35.95,Default,,0000,0000,0000,,Дұрыс, ұрыспа. Өтірік өтірік. Оны да бәрі білетін.
Dialogue: 0,0:51:37.02,0:51:39.21,Default,,0000,0000,0000,,Фарт. иә?
Dialogue: 0,0:51:39.21,0:51:41.39,Default,,0000,0000,0000,,Әке, мен анама ауыз тидім.
Dialogue: 0,0:51:41.39,0:51:43.41,Default,,0000,0000,0000,,Не!
Dialogue: 0,0:51:43.41,0:51:47.45,Default,,0000,0000,0000,,Сондықтан анамның жүзін көргенім кездейсоқтық болды →
Dialogue: 0,0:51:47.45,0:51:49.47,Default,,0000,0000,0000,,Сіз мұны әдейі емес деп айттыңыз.
Dialogue: 0,0:51:49.47,0:51:52.50,Default,,0000,0000,0000,,Әдейі болмаса да, кешірім сұрайсыз, солай ма? Әдетте.
Dialogue: 0,0:51:52.50,0:51:55.53,Default,,0000,0000,0000,,Жақсы емес пе? Қолдан бірдеңе шығып кетсе, көмектесу мүмкін емес.
Dialogue: 0,0:51:55.53,0:51:59.57,Default,,0000,0000,0000,,Сен істеген ісіңе ренжімейсің, кешірім сұрамағаныма ренжідің!
Dialogue: 0,0:51:59.57,0:52:03.61,Default,,0000,0000,0000,,Көбінесе дәл көз алдымда тұрып, сасып қалатын!
Dialogue: 0,0:52:03.61,0:52:05.63,Default,,0000,0000,0000,,Үйдің сасығанына мен кінәлі емеспін!
Dialogue: 0,0:52:05.63,0:52:10.68,Default,,0000,0000,0000,,Хахаха... Бұл тым ақымақтық.
Dialogue: 0,0:52:10.68,0:52:12.70,Default,,0000,0000,0000,,Мен бұл туралы қатты уайымдадым →
Dialogue: 0,0:52:12.70,0:52:15.73,Default,,0000,0000,0000,,Мен кіммін жер бетінде...? (Сумире/Хироши) Хмф!
Dialogue: 0,0:52:15.73,0:52:18.76,Default,,0000,0000,0000,,<Ерлі-зайыптылар арасындағы жанжал осындай қызық нәрседен басталады ма деп ойлаймын→
Dialogue: 0,0:52:18.76,0:52:21.79,Default,,0000,0000,0000,,Мен бала жүрегімнен сабақ алған Маруко болдым＞
Dialogue: 0,0:52:21.79,0:52:23.79,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:52:31.89,0:52:33.89,Default,,0000,0000,0000,,О.
Dialogue: 0,0:52:36.94,0:52:39.64,Default,,0000,0000,0000,,Эххе.
Dialogue: 0,0:52:39.64,0:52:41.32,Default,,0000,0000,0000,,О, Сакура.
Dialogue: 0,0:52:41.32,0:52:44.35,Default,,0000,0000,0000,,Хамадзи. Сәлем.
Dialogue: 0,0:52:44.35,0:52:47.38,Default,,0000,0000,0000,,Сәлеметсіз бе. (Хамаджидің атасы) Сәлеметсіз бе.
Dialogue: 0,0:52:47.38,0:52:50.41,Default,,0000,0000,0000,,Сіз ұзақ уақыт демалып жатырсыз. Сен не істейсің?
Dialogue: 0,0:52:50.41,0:52:53.44,Default,,0000,0000,0000,,Туысқан ағасының тойына бару→
Dialogue: 0,0:52:53.44,0:52:56.47,Default,,0000,0000,0000,,Мен кеше қайтып келдім. (Хамаджидің атасы) Фофофо.
Dialogue: 0,0:52:56.47,0:52:58.49,Default,,0000,0000,0000,,Құтты болсын.
Dialogue: 0,0:52:58.49,0:53:01.52,Default,,0000,0000,0000,,Ха... Дұрыс. Әй, апаң ше?
Dialogue: 0,0:53:01.52,0:53:05.56,Default,,0000,0000,0000,,Иә, ана? Мен үйдемін, бірақ неге?
Dialogue: 0,0:53:05.56,0:53:09.60,Default,,0000,0000,0000,,Неліктен? Жоқ, жақсы.
Dialogue: 0,0:53:09.60,0:53:13.64,Default,,0000,0000,0000,,Хмм, кездескенше. Кеттік, ата.
Dialogue: 0,0:53:13.64,0:53:16.67,Default,,0000,0000,0000,,Фофо Норика.
Dialogue: 0,0:53:16.67,0:53:18.69,Default,,0000,0000,0000,,Жақсы. не болды?
Dialogue: 0,0:53:18.69,0:53:22.73,Default,,0000,0000,0000,,Жоқ, ештеңе.
Dialogue: 0,0:53:22.73,0:53:24.75,Default,,0000,0000,0000,,О.
Dialogue: 0,0:53:24.75,0:53:28.79,Default,,0000,0000,0000,,Иә? Эхехе Ехехе Ехе.
Dialogue: 0,0:53:28.79,0:53:31.82,Default,,0000,0000,0000,,Ухуху. Хехе.
Dialogue: 0,0:53:31.82,0:53:33.84,Default,,0000,0000,0000,,Эхехехе….
Dialogue: 0,0:53:33.84,0:53:38.84,Default,,0000,0000,0000,,Хм
Dialogue: 0,0:56:03.34,0:56:05.36,Default,,0000,0000,0000,,Міне, бұл қазіргі викторинаның соңғысы.
Dialogue: 0,0:56:05.36,0:56:07.36,Default,,0000,0000,0000,,Бұл Маруконың викторинасы.
Dialogue: 0,0:56:09.40,0:56:11.42,Default,,0000,0000,0000,,Дұрыс деп санайтын нөмірге қоңырау шалыңыз.
Dialogue: 0,0:56:11.42,0:56:14.42,Default,,0000,0000,0000,,Дұрыс жауап бергендер арасында...
Dialogue: 0,0:56:19.50,0:56:22.53,Default,,0000,0000,0000,,Маруко сонда болады, маған қоңырау шалыңыз.
Dialogue: 0,0:56:22.53,0:56:26.57,Default,,0000,0000,0000,,Олай болса, келесі жолы асыға күтіңіздер.
Dialogue: 0,0:56:26.57,0:56:36.57,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:56:38.07,0:56:44.07,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory