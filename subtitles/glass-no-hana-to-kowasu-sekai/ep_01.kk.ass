Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.05,0:00:13.05,Default,,0,0,0,,Сен әзілдескің келгенін түсіндім—
Dialogue: 0,0:00:13.88,0:00:16.59,Default,,0,0,0,,Мен сені гүл баққа апарамын.
Dialogue: 0,0:00:17.72,0:00:18.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:21.73,0:00:22.98,Default,,0,0,0,,Kyaaah
Dialogue: 0,0:00:25.40,0:00:28.61,Default,,0,0,0,,(фортепиано дыбысы)
Dialogue: 0,0:00:28.61,0:00:31.28,Default,,0,0,0,,(фортепиано дыбысы)
Dialogue: 0,0:00:28.61,0:00:31.28,Default,,0,0,0,,2064 Лондон
Dialogue: 0,0:00:31.28,0:00:31.40,Default,,0,0,0,,2064 Лондон
Dialogue: 0,0:00:31.40,0:00:31.94,Default,,0,0,0,,2064 Лондон
Dialogue: 0,0:00:31.40,0:00:31.94,Default,,0,0,0,,Қашықтан басқару пульті
Dialogue: 0,0:00:31.94,0:00:32.86,Default,,0,0,0,,Қашықтан басқару пульті
Dialogue: 0,0:00:33.61,0:00:34.40,Default,,0,0,0,,Әже
Dialogue: 0,0:00:40.49,0:00:42.50,Default,,0,0,0,,Мен саған да беремін, Тору.
Dialogue: 0,0:00:45.21,0:00:49.38,Default,,0,0,0,,2073 Лондон
Dialogue: 0,0:00:49.38,0:00:50.21,Default,,0,0,0,,2073 Лондон
Dialogue: 0,0:00:49.38,0:00:50.21,Default,,0,0,0,,♪～
Dialogue: 0,0:00:50.21,0:00:54.38,Default,,0,0,0,,♪～
Dialogue: 0,0:01:10.77,0:01:15.78,Default,,0,0,0,,～♪
Dialogue: 0,0:01:17.20,0:01:24.16,Default,,0,0,0,,(«Арман бүршіктері» фортепианолық қойылым)
Dialogue: 0,0:02:00.57,0:02:05.58,Default,,0,0,0,,～♪
Dialogue: 0,0:02:06.16,0:02:07.54,Default,,0,0,0,,Қос!
Dialogue: 0,0:02:08.00,0:02:10.33,Default,,0,0,0,,Хэхе ха ха ха
Dialogue: 0,0:02:12.09,0:02:16.01,Default,,0,0,0,,Хаха хаха хехехехе
Dialogue: 0,0:02:16.13,0:02:18.26,Default,,0,0,0,,Ааа... мен жасадым!
Dialogue: 0,0:02:18.38,0:02:21.43,Default,,0,0,0,,Алтын жүлде! Алтын жүлде! сену мүмкін емес!
Dialogue: 0,0:02:21.85,0:02:24.60,Default,,0,0,0,,Уфуфу фуфу иә
Dialogue: 0,0:02:25.01,0:02:25.85,Default,,0,0,0,,Сізге жақсы.
Dialogue: 0,0:02:25.97,0:02:28.18,Default,,0,0,0,,Енді мен көктемде Лондонға бара аламын
Dialogue: 0,0:02:28.31,0:02:30.73,Default,,0,0,0,,Мүмкін сіз шетелде оқуыңыз мүмкін
Dialogue: 0,0:02:31.02,0:02:32.65,Default,,0,0,0,,Сіздің арманыңыз орындалуы мүмкін
Dialogue: 0,0:02:32.81,0:02:35.44,Default,,0,0,0,,Иә, бұл менің кішкентай кезімнен арманым.
Dialogue: 0,0:02:35.61,0:02:39.32,Default,,0,0,0,,Дүние жүзін аралап, адамдарға менің фортепианомды тыңдауға мүмкіндік беріңіз.
Dialogue: 0,0:02:39.45,0:02:40.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:40.57,0:02:43.16,Default,,0,0,0,,Сіз мені әрқашан жігерлендірдіңіз.
Dialogue: 0,0:02:44.16,0:02:45.37,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:02:45.87,0:02:49.79,Default,,0,0,0,,Егер Дуал болмаса, мен ешқашан осыншама жерге келмес едім.
Dialogue: 0,0:02:51.29,0:02:53.17,Default,,0,0,0,,Күлгін гүлдер?
Dialogue: 0,0:02:54.88,0:02:56.09,Default,,0,0,0,,Кешіріңіз, иә?
Dialogue: 0,0:02:57.71,0:03:02.18,Default,,0,0,0,,Бұл сақтық көшірме деректері вирус жұқтырған.
Dialogue: 0,0:03:03.72,0:03:04.85,Default,,0,0,0,,Қалпына келтіру мүмкін емес
Dialogue: 0,0:03:06.89,0:03:07.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:08.47,0:03:10.81,Default,,0,0,0,,Мен сен білетін дуал емеспін.
Dialogue: 0,0:03:11.52,0:03:14.81,Default,,0,0,0,,Бұл 21 ғасырдағы Жапонияның сақтық көшірме деректері
Dialogue: 0,0:03:15.23,0:03:17.82,Default,,0,0,0,,«Білім қорабының» ішіндегі виртуалды әлем
Dialogue: 0,0:03:18.57,0:03:20.65,Default,,0,0,0,,Әй, не болды?
Dialogue: 0,0:03:23.36,0:03:24.32,Default,,0,0,0,,Уақыт аяқталды
Dialogue: 0,0:03:31.29,0:03:32.58,Default,,0,0,0,,О, не?
Dialogue: 0,0:03:33.67,0:03:37.09,Default,,0,0,0,,Бұл әлемді вирустар толығымен басып алды.
Dialogue: 0,0:03:40.47,0:03:42.59,Default,,0,0,0,,Сіз де Виолет
Dialogue: 0,0:03:43.34,0:03:44.39,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:03:48.10,0:03:49.52,Default,,0,0,0,,Жоқ... бұл не?
Dialogue: 0,0:03:51.56,0:03:52.52,Default,,0,0,0,,Жою
Dialogue: 0,0:04:09.70,0:04:11.16,Default,,0,0,0,,Бұл не...?
Dialogue: 0,0:04:14.67,0:04:15.75,Default,,0,0,0,,Бұл арман ма?
Dialogue: 0,0:04:17.21,0:04:18.63,Default,,0,0,0,,Сіз армандайсыз ба...?
Dialogue: 0,0:04:19.42,0:04:20.09,Default,,0,0,0,,Сол Титан
Dialogue: 0,0:04:20.92,0:04:24.13,Default,,0,0,0,,Осы уақытқа дейін көрген дүниең түс еді
Dialogue: 0,0:04:24.88,0:04:25.55,Default,,0,0,0,,Сіз жақсысыз ба?
Dialogue: 0,0:04:26.43,0:04:27.43,Default,,0,0,0,,үшін арман
Dialogue: 0,0:04:28.14,0:04:30.31,Default,,0,0,0,,Сіз және мен бағдарлама деректері
Dialogue: 0,0:04:31.31,0:04:34.14,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Қосарлылық қос, солай ма?
Dialogue: 0,0:04:34.64,0:04:35.94,Default,,0,0,0,,Біз көптен бері біргеміз ғой, солай емес пе?
Dialogue: 0,0:04:36.10,0:04:37.65,Default,,0,0,0,,Сізге, иә.
Dialogue: 0,0:04:37.98,0:04:42.40,Default,,0,0,0,,Бірақ мен үшін бұл дүние біраз уақыт бұрын еріді.
Dialogue: 0,0:04:42.99,0:04:47.24,Default,,0,0,0,,Сіздің естеліктеріңіз бен естеліктеріңіз жаңадан ретке келтірілді.
Dialogue: 0,0:04:47.78,0:04:49.24,Default,,0,0,0,,Түсінуім үшін айтыңыз
Dialogue: 0,0:04:50.83,0:04:52.66,Default,,0,0,0,,Вируспен ластанған деректер...
Dialogue: 0,0:04:53.87,0:04:55.62,Default,,0,0,0,,Жою керек
Dialogue: 0,0:05:00.71,0:05:03.76,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:05:42.55,0:05:44.34,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:05:46.97,0:05:47.63,Default,,0,0,0,,Не?
Dialogue: 0,0:05:48.26,0:05:50.43,Default,,0,0,0,,«Не?» емес!
Dialogue: 0,0:05:50.76,0:05:54.72,Default,,0,0,0,,Сіз немен айналысасыз? Дәл қазір бұл дүниедегі менің кезегім.
Dialogue: 0,0:05:55.14,0:05:55.89,Default,,0,0,0,,Иә.
Dialogue: 0,0:05:56.23,0:06:00.15,Default,,0,0,0,,«Иә» деп айтпаңыз! Ережелерді сақтаңыз
Dialogue: 0,0:06:00.73,0:06:02.15,Default,,0,0,0,,Мен көптен бері күттім
Dialogue: 0,0:06:02.32,0:06:04.65,Default,,0,0,0,,Сіз оны көрдіңіз бе? (Дороти) Сіз нені айтып тұрсыз?
Dialogue: 0,0:06:05.23,0:06:07.86,Default,,0,0,0,,Мүмкін мен оны шешуім керек шығар...
Dialogue: 0,0:06:08.86,0:06:09.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:10.07,0:06:13.41,Default,,0,0,0,,Сумире мені оның бала күнгі досы және жақын досы деп есептеді.
Dialogue: 0,0:06:13.91,0:06:15.58,Default,,0,0,0,,Сонымен, I
Dialogue: 0,0:06:15.91,0:06:18.21,Default,,0,0,0,,Не? Сен, бұрынғы Сумире деген қыз...
Dialogue: 0,0:06:18.33,0:06:19.62,Default,,0,0,0,,Сіздің міндетіңіз бар ма?
Dialogue: 0,0:06:22.54,0:06:24.80,Default,,0,0,0,,Бүгінгі әлемде...
Dialogue: 0,0:06:24.92,0:06:27.76,Default,,0,0,0,,Сен сол қыздың досы болуың керек еді.
Dialogue: 0,0:06:28.72,0:06:30.68,Default,,0,0,0,,Екінші тарап виртуалды әлем бағдарламасында.
Dialogue: 0,0:06:30.80,0:06:32.51,Default,,0,0,0,,Бұл жеке тұлға деректерінің шағын бөлігі.
Dialogue: 0,0:06:33.43,0:06:35.26,Default,,0,0,0,,Ол да жай ғана ашылды.
Dialogue: 0,0:06:37.93,0:06:40.73,Default,,0,0,0,,Мен оны өшірген сайын қисық болса, не істеуім керек?
Dialogue: 0,0:06:41.10,0:06:44.32,Default,,0,0,0,,Қараңызшы, ол деректерді де тез жойып жіберейік.
Dialogue: 0,0:06:47.57,0:06:49.95,Default,,0,0,0,,Нұсқаны жаңартқаннан кейін мұндай нәрселер көп.
Dialogue: 0,0:06:50.45,0:06:51.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:51.53,0:06:54.95,Default,,0,0,0,,Біз еріген әлемге қосылған үлгі.
Dialogue: 0,0:06:55.49,0:06:56.91,Default,,0,0,0,,Достармен немесе отбасымен
Dialogue: 0,0:06:57.66,0:06:59.87,Default,,0,0,0,,Бұрын мұндай болған жоқ.
Dialogue: 0,0:07:00.79,0:07:03.46,Default,,0,0,0,,Адамдар біз үшін қиын істер жасайды, солай емес пе?
Dialogue: 0,0:07:04.46,0:07:07.09,Default,,0,0,0,,Ол өзінің арманы пианист болу екенін айтты.
Dialogue: 0,0:07:07.63,0:07:08.97,Default,,0,0,0,,Арман
Dialogue: 0,0:07:10.26,0:07:13.14,Default,,0,0,0,,Мен мұны мүлдем түсінбеймін, бірақ...
Dialogue: 0,0:07:15.14,0:07:17.47,Default,,0,0,0,,Соңғы кездері біртүрлі әрекет жасап жүрсіз бе?
Dialogue: 0,0:07:18.35,0:07:20.94,Default,,0,0,0,,Жойылатын деректерге мұқият болыңыз.
Dialogue: 0,0:07:21.39,0:07:24.23,Default,,0,0,0,,Біз бағдарламамыз, сондықтан ... алгоритмін ұстанамыз.
Dialogue: 0,0:07:24.36,0:07:26.32,Default,,0,0,0,,Вирусты жойсаңыз болғаны.
Dialogue: 0,0:07:27.15,0:07:28.99,Default,,0,0,0,,Не! Бұл көңілсіз
Dialogue: 0,0:07:29.11,0:07:30.82,Default,,0,0,0,,Дерлік! Мен және сен -
Dialogue: 0,0:07:30.99,0:07:34.45,Default,,0,0,0,,Екі антивирустық бағдарламалық құрал орнатылған, сондықтан бұл мәселе.
Dialogue: 0,0:07:34.82,0:07:37.83,Default,,0,0,0,,Неліктен екеуін орнаттыңыз?
Dialogue: 0,0:07:38.33,0:07:39.04,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:07:40.08,0:07:43.08,Default,,0,0,0,,Сіз маған қайсысы жақсы екенін анықтауға тырысасыз ба?
Dialogue: 0,0:07:43.33,0:07:46.42,Default,,0,0,0,,Олай болса, мен жеңетініме сенімдімін.
Dialogue: 0,0:07:46.63,0:07:48.34,Default,,0,0,0,,Әңгімешіл (Дороти), иә?
Dialogue: 0,0:07:48.46,0:07:50.30,Default,,0,0,0,,Ол вируспен ластанған жоқ па?
Dialogue: 0,0:07:50.42,0:07:53.43,Default,,0,0,0,,Сізде қате жоқ па?
Dialogue: 0,0:07:53.55,0:07:54.26,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:55.34,0:07:56.01,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:00.68,0:08:02.85,Default,,0,0,0,,Дороти (Дороти) Шулы! Ах
Dialogue: 0,0:08:03.52,0:08:04.35,Default,,0,0,0,,Не? мм...
Dialogue: 0,0:08:06.94,0:08:08.15,Default,,0,0,0,,Хмм (Дороти) Ммм.
Dialogue: 0,0:08:08.27,0:08:10.69,Default,,0,0,0,,Сәлем! Мен тағы жалғызбын
Dialogue: 0,0:08:12.70,0:08:15.45,Default,,0,0,0,,Жою (Дороти) Келіңіздер!
Dialogue: 0,0:08:26.88,0:08:28.38,Default,,0,0,0,,Өте көп.
Dialogue: 0,0:08:28.50,0:08:30.17,Default,,0,0,0,,Қазіргі уақытта вирустар өте көп.
Dialogue: 0,0:08:30.38,0:08:31.84,Default,,0,0,0,,Тыңдап тұрсың ба? Балалар сендер
Dialogue: 0,0:08:31.92,0:08:35.05,Default,,0,0,0,,Мен қателерді бұрын түзетуім керек еді.
Dialogue: 0,0:08:48.31,0:08:49.90,Default,,0,0,0,,Тағы сәл ғана, аа
Dialogue: 0,0:08:52.19,0:08:53.36,Default,,0,0,0,,А, көкек...
Dialogue: 0,0:08:54.07,0:08:54.82,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:54.95,0:08:55.66,Default,,0,0,0,,Хмм!
Dialogue: 0,0:08:56.82,0:08:59.03,Default,,0,0,0,,Хмм, кедергі жасамаңыз.
Dialogue: 0,0:08:59.66,0:09:00.58,Default,,0,0,0,,Міне, солай ма?
Dialogue: 0,0:09:02.29,0:09:04.08,Default,,0,0,0,,Wow қысу
Dialogue: 0,0:09:04.21,0:09:05.16,Default,,0,0,0,,Шулы
Dialogue: 0,0:09:15.05,0:09:16.01,Default,,0,0,0,,Жою
Dialogue: 0,0:09:20.85,0:09:23.10,Default,,0,0,0,,Аа, бұл біраз қиын болды.
Dialogue: 0,0:09:23.77,0:09:26.81,Default,,0,0,0,,Соны айтсам да, өз қолымнан келдім.
Dialogue: 0,0:09:27.31,0:09:29.44,Default,,0,0,0,,Вирустар көбейіп бара жатқан сияқты.
Dialogue: 0,0:09:30.19,0:09:31.11,Default,,0,0,0,,Әрине
Dialogue: 0,0:09:31.82,0:09:33.23,Default,,0,0,0,,Соңғы кездері біртүрлі болды, солай емес пе?
Dialogue: 0,0:09:33.57,0:09:34.90,Default,,0,0,0,,Ол қайдан шыққан?
Dialogue: 0,0:09:36.61,0:09:37.61,Default,,0,0,0,,Хмм?
Dialogue: 0,0:09:39.62,0:09:42.03,Default,,0,0,0,,Бұл ештеңе емес сияқты.
Dialogue: 0,0:09:44.62,0:09:46.08,Default,,0,0,0,,Вирусты анықтау нөлдік
Dialogue: 0,0:09:46.46,0:09:47.58,Default,,0,0,0,,Хмм.
Dialogue: 0,0:09:48.46,0:09:49.79,Default,,0,0,0,,Мүмкін Троя немесе бір нәрсе.
Dialogue: 0,0:09:50.84,0:09:52.71,Default,,0,0,0,,Әзірше жойып жіберген дұрыс емес пе?
Dialogue: 0,0:09:53.09,0:09:56.63,Default,,0,0,0,,Бұл бағдарламаны жоюға құқығымыз жоқ.
Dialogue: 0,0:09:57.13,0:09:58.09,Default,,0,0,0,,Аздап
Dialogue: 0,0:09:58.47,0:10:00.14,Default,,0,0,0,,Мені өзіңізбен бірге алып кеткіңіз келе ме?
Dialogue: 0,0:10:00.26,0:10:01.89,Default,,0,0,0,,Ақауларды түзету
Dialogue: 0,0:10:02.14,0:10:03.72,Default,,0,0,0,,Бұл да біздің жұмысымыз
Dialogue: 0,0:10:03.85,0:10:05.73,Default,,0,0,0,,Бұл дұрыс, бірақ келіңіз.
Dialogue: 0,0:10:11.31,0:10:12.69,Default,,0,0,0,,Эй, уа!
Dialogue: 0,0:10:23.62,0:10:26.66,Default,,0,0,0,,Дуал-сан, жаман емес пе?
Dialogue: 0,0:10:27.04,0:10:27.83,Default,,0,0,0,,Не?
Dialogue: 0,0:10:28.00,0:10:31.29,Default,,0,0,0,,Егер сіз мені растамасаңыз, мен кіре алмаймын.
Dialogue: 0,0:10:31.46,0:10:35.00,Default,,0,0,0,,Мен өз орныма қайтып оралсам ше? Мен бұл баламен біргемін
Dialogue: 0,0:10:35.13,0:10:38.26,Default,,0,0,0,,Ақымақ болма. Егер бұл жаңа вирус болса...
Dialogue: 0,0:10:38.47,0:10:40.80,Default,,0,0,0,,Сіз де ластанасыз.
Dialogue: 0,0:10:46.06,0:10:47.60,Default,,0,0,0,,Ах, бұл қиын.
Dialogue: 0,0:10:48.35,0:10:49.81,Default,,0,0,0,,Сенсіз мен жалғыз қаламын
Dialogue: 0,0:10:49.94,0:10:51.98,Default,,0,0,0,,Ах (Дороти) Мен мұның бәрін қолдана аламын.
Dialogue: 0,0:10:52.15,0:10:52.81,Default,,0,0,0,,Ах
Dialogue: 0,0:10:53.56,0:10:55.19,Default,,0,0,0,,Не? Не?
Dialogue: 0,0:10:59.82,0:11:00.82,Default,,0,0,0,,Ах (Дороти) Ахх.
Dialogue: 0,0:11:01.74,0:11:04.16,Default,,0,0,0,,Не? Не? Не?
Dialogue: 0,0:11:06.74,0:11:08.29,Default,,0,0,0,,Уау... Уау.
Dialogue: 0,0:11:14.96,0:11:15.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:17.21,0:11:18.17,Default,,0,0,0,,Сіз ұйықтап қалдыңыз ба?
Dialogue: 0,0:11:18.34,0:11:19.67,Default,,0,0,0,,Хмм (Дороти) Ахх!
Dialogue: 0,0:11:23.89,0:11:24.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:25.55,0:11:26.56,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:11:29.89,0:11:30.98,Default,,0,0,0,,I қос
Dialogue: 0,0:11:31.60,0:11:34.44,Default,,0,0,0,,Сізге вирус шабуыл жасады, солай ма?
Dialogue: 0,0:11:36.15,0:11:37.23,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:11:38.23,0:11:41.03,Default,,0,0,0,,Біздікі сияқты антивирустық бағдарлама?
Dialogue: 0,0:11:41.15,0:11:43.74,Default,,0,0,0,,Бұл вирус, солай ма? айт
Dialogue: 0,0:11:44.20,0:11:44.87,Default,,0,0,0,,италиялықтарға тән —
Dialogue: 0,0:11:46.37,0:11:49.79,Default,,0,0,0,,Өзімді таныстырып жатқан менмін, атыңды айтып жіберші!
Dialogue: 0,0:11:50.79,0:11:51.50,Default,,0,0,0,,Қашықтан басқару пульті
Dialogue: 0,0:11:51.87,0:11:52.58,Default,,0,0,0,,Иә
Dialogue: 0,0:11:52.96,0:11:55.25,Default,,0,0,0,,Remo Бұл атау ма?
Dialogue: 0,0:11:56.92,0:11:58.71,Default,,0,0,0,,Сіз қандай бағдарламасыз?
Dialogue: 0,0:11:59.42,0:12:00.76,Default,,0,0,0,,Гүлдер... (Дороти) Иә?
Dialogue: 0,0:12:01.26,0:12:02.01,Default,,0,0,0,,Гүлдер?
Dialogue: 0,0:12:02.34,0:12:04.59,Default,,0,0,0,,Мен гүл баққа қайта баруым керек.
Dialogue: 0,0:12:05.05,0:12:08.35,Default,,0,0,0,,Қайда? Кейбір сақтық көшірме деректері туралы айтып отырсыз ба?
Dialogue: 0,0:12:08.97,0:12:09.97,Default,,0,0,0,,Мен...
Dialogue: 0,0:12:10.93,0:12:12.27,Default,,0,0,0,,Мен...
Dialogue: 0,0:12:12.44,0:12:14.94,Default,,0,0,0,,Неліктен білім қорабына орнатылдыңыз?
Dialogue: 0,0:12:15.06,0:12:16.02,Default,,0,0,0,,Маған жауап бер.
Dialogue: 0,0:12:16.40,0:12:18.27,Default,,0,0,0,,Бағдарлама не үшін арналған?
Dialogue: 0,0:12:18.48,0:12:19.19,Default,,0,0,0,,Ух... а
Dialogue: 0,0:12:21.61,0:12:22.45,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:27.83,0:12:31.62,Default,,0,0,0,,Мен түсінбейтін нәрсені айтыңыз.
Dialogue: 0,0:12:31.75,0:12:33.96,Default,,0,0,0,,Бұл күдікті. Бұл қауіпті.
Dialogue: 0,0:12:34.21,0:12:36.46,Default,,0,0,0,,Оны дереу жойған дұрыс.
Dialogue: 0,0:12:36.79,0:12:40.21,Default,,0,0,0,,Сіз ластанбаған деректерді жоя алмайсыз, солай ма?
Dialogue: 0,0:12:40.42,0:12:43.47,Default,,0,0,0,,Бірақ! Оқшаулау деген нәрсе бар, солай ма?
Dialogue: 0,0:12:43.67,0:12:45.51,Default,,0,0,0,,Бізде ерік бостандығы жоқ
Dialogue: 0,0:12:46.05,0:12:49.26,Default,,0,0,0,,Егер программа өздігінен жұмыс істей бастаса, оның вирустан айырмашылығы жоқ.
Dialogue: 0,0:12:49.89,0:12:50.56,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:51.39,0:12:55.73,Default,,0,0,0,,Менің ойымша, бұл дәл қазір тұрақты емес. Бәлкім, ақыры жөнделетін шығар.
Dialogue: 0,0:12:56.31,0:12:57.81,Default,,0,0,0,,Мен айтқанымдай, қос
Dialogue: 0,0:12:58.48,0:13:00.98,Default,,0,0,0,,Егер бұл бала вирус болса, оны дереу жоюымыз керек.
Dialogue: 0,0:13:01.15,0:13:02.49,Default,,0,0,0,,Біз де қиындыққа тап болдық.
Dialogue: 0,0:13:03.07,0:13:04.15,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:13:06.99,0:13:07.66,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:09.37,0:13:10.08,Default,,0,0,0,,Иә
Dialogue: 0,0:13:14.16,0:13:15.25,Default,,0,0,0,,1?
Dialogue: 0,0:13:15.62,0:13:18.00,Default,,0,0,0,,Иә, бұл бірінші қабат
Dialogue: 0,0:13:18.46,0:13:21.84,Default,,0,0,0,,Мен және Доротиден басқа сен біріншісің.
Dialogue: 0,0:13:22.67,0:13:25.63,Default,,0,0,0,,Білім қорабы үш деңгейге бөлінеді.
Dialogue: 0,0:13:26.13,0:13:28.18,Default,,0,0,0,,Мен сені екінші қабаттан таптым
Dialogue: 0,0:13:28.30,0:13:31.10,Default,,0,0,0,,Біріктірілген деректердің сақтық көшірмесі бар
Dialogue: 0,0:13:31.35,0:13:32.97,Default,,0,0,0,,Деректердің сақтық көшірмесін жасау керек пе?
Dialogue: 0,0:13:33.39,0:13:34.52,Default,,0,0,0,,Әр түрлі дәуірлер...
Dialogue: 0,0:13:35.23,0:13:37.48,Default,,0,0,0,,Бұл әртүрлі орындардан деректерді қалпына келтіруге қатысты.
Dialogue: 0,0:13:38.44,0:13:41.86,Default,,0,0,0,,Дороти екеуміз Білім сандығын күзетеміз.
Dialogue: 0,0:13:42.44,0:13:44.86,Default,,0,0,0,,Табылған қателерді немесе ақауларды түзетіңіз.
Dialogue: 0,0:13:45.19,0:13:48.20,Default,,0,0,0,,Вирус пайда болған кезде оны қысып, жойыңыз
Dialogue: 0,0:13:48.57,0:13:50.78,Default,,0,0,0,,Ашылмаған деректерді орау...
Dialogue: 0,0:13:50.91,0:13:52.33,Default,,0,0,0,,Вирустарды тексеру
Dialogue: 0,0:13:53.33,0:13:53.99,Default,,0,0,0,,О
Dialogue: 0,0:14:04.34,0:14:06.55,Default,,0,0,0,,Бұлардың әрқайсысы деректердің сақтық көшірмесі болып табылады
Dialogue: 0,0:14:06.88,0:14:10.93,Default,,0,0,0,,Әр түрлі дәуірлерді, елдерді және аймақтарды қайталайтын виртуалды әлем
Dialogue: 0,0:14:11.05,0:14:13.43,Default,,0,0,0,,Ой, бұл не?
Dialogue: 0,0:14:13.89,0:14:15.02,Default,,0,0,0,,Қорықпа
Dialogue: 0,0:14:15.85,0:14:18.35,Default,,0,0,0,,Өйткені бұл біз емдеген вирустың қалдықтары.
Dialogue: 0,0:14:19.52,0:14:20.48,Default,,0,0,0,,Компресс
Dialogue: 0,0:14:22.98,0:14:23.69,Default,,0,0,0,,Мен Жапониядамын.
Dialogue: 0,0:14:24.23,0:14:25.03,Default,,0,0,0,,Ах
Dialogue: 0,0:14:25.40,0:14:27.49,Default,,0,0,0,,Сонымен, Дороти айтқандай...
Dialogue: 0,0:14:27.78,0:14:29.36,Default,,0,0,0,,Егер мен вирус болсам ше?
Dialogue: 0,0:14:31.16,0:14:32.95,Default,,0,0,0,,Сізде вирустық реакция жоқ
Dialogue: 0,0:14:33.74,0:14:34.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:36.04,0:14:38.87,Default,,0,0,0,,Вирусты тексеру Менімен бірге келгіңіз келе ме?
Dialogue: 0,0:14:39.25,0:14:39.92,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:40.25,0:14:41.92,Default,,0,0,0,,Бірдеңе есіңізде болуы мүмкін
Dialogue: 0,0:14:55.35,0:14:57.10,Default,,0,0,0,,Уа... ау...
Dialogue: 0,0:14:58.14,0:14:59.35,Default,,0,0,0,,О! (2-жас жігіт) О
Dialogue: 0,0:15:00.52,0:15:04.27,Default,,0,0,0,,Сүйкімді, менің ойымша, ол талантты.
Dialogue: 0,0:15:06.44,0:15:07.94,Default,,0,0,0,,Бұл үшінші қабат
Dialogue: 0,0:15:08.57,0:15:11.70,Default,,0,0,0,,Дәл осы сәтте, бұл дүние дүниеге келді.
Dialogue: 0,0:15:12.32,0:15:13.66,Default,,0,0,0,,Ішінде тұратын әрбір адам
Dialogue: 0,0:15:13.78,0:15:15.28,Default,,0,0,0,,Уау Уау
Dialogue: 0,0:15:17.95,0:15:19.50,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:15:21.12,0:15:22.54,Default,,0,0,0,,Мұнда бірдеңе бар ма?
Dialogue: 0,0:15:23.08,0:15:23.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:24.59,0:15:25.79,Default,,0,0,0,,Хмм.
Dialogue: 0,0:15:26.46,0:15:28.80,Default,,0,0,0,,Шынымен де... Неге екен деп ойлаймын.
Dialogue: 0,0:15:29.47,0:15:30.93,Default,,0,0,0,,Есіңде бірдеңе бар ма?
Dialogue: 0,0:15:31.63,0:15:33.72,Default,,0,0,0,,Жоқ, кешіріңіз.
Dialogue: 0,0:15:34.14,0:15:36.14,Default,,0,0,0,,Мен сені осында әкелу үшін қиналсам да.
Dialogue: 0,0:15:36.56,0:15:38.47,Default,,0,0,0,,Жоқ, қарсы емеспін.
Dialogue: 0,0:15:39.31,0:15:41.81,Default,,0,0,0,,Менің бірдеңе жегім келеді
Dialogue: 0,0:15:42.06,0:15:42.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:43.31,0:15:45.56,Default,,0,0,0,,Дәмді көрінеді Уау
Dialogue: 0,0:15:45.69,0:15:46.69,Default,,0,0,0,,Дәмді көрінеді...?
Dialogue: 0,0:15:49.65,0:15:50.44,Default,,0,0,0,,Хмм!
Dialogue: 0,0:15:55.99,0:16:00.66,Default,,0,0,0,,Адамдар дәмділік пен салқындық сияқты нәрселерді сезінеді, солай емес пе?
Dialogue: 0,0:16:01.37,0:16:02.41,Default,,0,0,0,,Сіз мұны сезбейсіз бе?
Dialogue: 0,0:16:02.67,0:16:06.21,Default,,0,0,0,,Дәмді Әдемі Көңілді Қызықты
Dialogue: 0,0:16:06.71,0:16:08.21,Default,,0,0,0,,Мен тұжырымдаманы білемін, бірақ...
Dialogue: 0,0:16:08.34,0:16:10.97,Default,,0,0,0,,Сіз оны шынымен сезіне алмайсыз.
Dialogue: 0,0:16:11.38,0:16:14.47,Default,,0,0,0,,Бұл антивирустық бағдарлама үшін қажетті мүмкіндік емес.
Dialogue: 0,0:16:14.76,0:16:17.60,Default,,0,0,0,,Сіз өзіңізді бақытты сезінесіз бе, әлде қайғысыз ба?
Dialogue: 0,0:16:19.43,0:16:20.14,Default,,0,0,0,,(Ватару) Не болып жатыр? Бұл әңгіме… (Ер оқушы) Ол ұялы телефонымен дауласып жатыр.
Dialogue: 0,0:16:21.10,0:16:22.14,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:16:22.69,0:16:25.23,Default,,0,0,0,,Мен кейде осындай нәрсені сезінемін.
Dialogue: 0,0:16:26.44,0:16:28.48,Default,,0,0,0,,Бұл адамның эмоциясы деп аталады.
Dialogue: 0,0:16:29.48,0:16:32.03,Default,,0,0,0,,Бірақ мен оны өзім растай алмаймын.
Dialogue: 0,0:16:32.95,0:16:35.53,Default,,0,0,0,,Тұлға деректерінде эмоциялар болуы мүмкін
Dialogue: 0,0:16:36.37,0:16:39.37,Default,,0,0,0,,Естеліктер, естеліктер және армандар
Dialogue: 0,0:16:39.95,0:16:40.70,Default,,0,0,0,,Сіз жақсысыз ба?
Dialogue: 0,0:16:41.62,0:16:45.00,Default,,0,0,0,,Бірақ бұл жай ғана бағдарламаланған.
Dialogue: 0,0:16:46.04,0:16:47.25,Default,,0,0,0,,Қашықтан басқару пульті керемет.
Dialogue: 0,0:16:48.00,0:16:49.38,Default,,0,0,0,,Дәмі дәмді ме?
Dialogue: 0,0:16:50.13,0:16:51.30,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:51.96,0:16:53.59,Default,,0,0,0,,Мен бұл дәмді сезінемін.
Dialogue: 0,0:16:55.01,0:16:56.93,Default,,0,0,0,,Жеке деректеріңіз бар ма?
Dialogue: 0,0:16:57.43,0:16:58.39,Default,,0,0,0,,Келіңіздер...
Dialogue: 0,0:16:58.55,0:17:01.64,Default,,0,0,0,,Бірақ егер сіз оны дәмді деп ойласаңыз, олай сезінбейсіз бе?
Dialogue: 0,0:17:02.64,0:17:05.52,Default,,0,0,0,,Дәмді деп ойласаң, дәмді ме?
Dialogue: 0,0:17:05.98,0:17:08.06,Default,,0,0,0,,Ей, бұл дәмді.
Dialogue: 0,0:17:08.73,0:17:11.19,Default,,0,0,0,,Оның дәмді екенін білесің.
Dialogue: 0,0:17:11.73,0:17:13.24,Default,,0,0,0,,Оны рұқсатсыз қайта ашыңыз.
Dialogue: 0,0:17:13.65,0:17:15.45,Default,,0,0,0,,Енді менің кезегім.
Dialogue: 0,0:17:15.99,0:17:17.41,Default,,0,0,0,,Мен оны Ремоға көрсеткім келді.
Dialogue: 0,0:17:17.99,0:17:20.24,Default,,0,0,0,,Өйткені мен әрқашан өзімшіл істермен айналысамын.
Dialogue: 0,0:17:21.37,0:17:22.79,Default,,0,0,0,,Хмм, бұл қызық.
Dialogue: 0,0:17:22.95,0:17:25.71,Default,,0,0,0,,Сонымен, гүл бағының не екенін білдің бе?
Dialogue: 0,0:17:26.17,0:17:27.67,Default,,0,0,0,,Хмм (Дороти) Ия...
Dialogue: 0,0:17:28.08,0:17:29.25,Default,,0,0,0,,Міне.
Dialogue: 0,0:17:33.17,0:17:35.01,Default,,0,0,0,,Маған тез еске түсіріңіз.
Dialogue: 0,0:17:36.63,0:17:37.34,Default,,0,0,0,,Ах… «C» рейтингі
Dialogue: 0,0:17:39.18,0:17:40.39,Default,,0,0,0,,Мен оның бетіндегі өңді көргім келеді
Dialogue: 0,0:17:42.35,0:17:46.73,Default,,0,0,0,,Мұндағы адамдар өздерінің тіршілігін түс сияқты дейді.
Dialogue: 0,0:17:47.02,0:17:48.15,Default,,0,0,0,,Сіз білмейсіз.
Dialogue: 0,0:17:48.98,0:17:51.32,Default,,0,0,0,,Білім сандығын жасаған кім?
Dialogue: 0,0:17:52.23,0:17:54.44,Default,,0,0,0,,Әртүрлі уақыттан және жерінен келген пакеттер...
Dialogue: 0,0:17:54.82,0:17:57.24,Default,,0,0,0,,Тіпті сол жерде тұратын адамдардың жеке басының деректері.
Dialogue: 0,0:17:57.61,0:17:59.74,Default,,0,0,0,,Кім және неге?
Dialogue: 0,0:18:00.28,0:18:03.62,Default,,0,0,0,,Енді... біз тек бағдарламаны орындаймыз.
Dialogue: 0,0:18:05.83,0:18:08.54,Default,,0,0,0,,Мен бұл жердің вируспен ластанбағанына қуаныштымын.
Dialogue: 0,0:18:09.63,0:18:11.46,Default,,0,0,0,,Егер ол ластанған болса ше?
Dialogue: 0,0:18:13.00,0:18:16.09,Default,,0,0,0,,Бүкіл әлемді қысу және жою
Dialogue: 0,0:18:16.67,0:18:17.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:19.38,0:18:22.64,Default,,0,0,0,,Бұл қораптың сыртында шынайы әлем бар, солай ма?
Dialogue: 0,0:18:23.31,0:18:24.10,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:18:24.56,0:18:27.10,Default,,0,0,0,,Адамдардың шынайы әлемі
Dialogue: 0,0:18:27.73,0:18:29.31,Default,,0,0,0,,Иә, мүмкін...
Dialogue: 0,0:18:29.81,0:18:31.27,Default,,0,0,0,,Мен оны көрмесем де
Dialogue: 0,0:18:32.11,0:18:35.98,Default,,0,0,0,,Сөйлескіңіз келе ме? бізді бағдарламалаған адамдармен
Dialogue: 0,0:18:36.32,0:18:37.32,Default,,0,0,0,,Адамдармен?
Dialogue: 0,0:18:40.86,0:18:42.62,Default,,0,0,0,,Мен бұл туралы ешқашан ойлаған емеспін.
Dialogue: 0,0:18:43.24,0:18:45.54,Default,,0,0,0,,Сіз біртүрлі нәрселер ойлап табасыз.
Dialogue: 0,0:18:47.00,0:18:48.16,Default,,0,0,0,,Менің ойымша, солай
Dialogue: 0,0:18:48.83,0:18:52.00,Default,,0,0,0,,Менің ойымша, бұл біртүрлі бағдарлама.
Dialogue: 0,0:19:00.34,0:19:03.35,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:04.35,0:19:05.18,Default,,0,0,0,,Қашықтан…
Dialogue: 0,0:19:05.85,0:19:06.52,Default,,0,0,0,,Ах
Dialogue: 0,0:19:09.06,0:19:09.94,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:14.90,0:19:16.23,Default,,0,0,0,,Тазалық жасайық
Dialogue: 0,0:19:30.50,0:19:37.46,Default,,0,0,0,,(Лимузиннің шуылдауы)
Dialogue: 0,0:19:39.09,0:19:45.35,Default,,0,0,0,,(Лимузиннің шуылдауы)
Dialogue: 0,0:19:47.43,0:19:50.02,Default,,0,0,0,,Қайырлы таң, жақсы түс көрдіңіз бе?
Dialogue: 0,0:19:50.85,0:19:51.89,Default,,0,0,0,,Мен армандамаймын
Dialogue: 0,0:19:53.44,0:19:56.27,Default,,0,0,0,,Жаңарту үшін әрекеттерді тоқтатыңыз
Dialogue: 0,0:19:56.48,0:19:57.57,Default,,0,0,0,,Иә
Dialogue: 0,0:19:57.77,0:20:02.74,Default,,0,0,0,,Олардың біреуі жаңартылса, екіншісі де автоматты түрде жаңартылады.
Dialogue: 0,0:20:03.16,0:20:06.28,Default,,0,0,0,,Адамдар жаңартуларды қамтамасыз ете ме?
Dialogue: 0,0:20:06.91,0:20:07.99,Default,,0,0,0,,Адамдар?
Dialogue: 0,0:20:08.95,0:20:09.75,Default,,0,0,0,,Не болды?
Dialogue: 0,0:20:10.00,0:20:13.33,Default,,0,0,0,,А... жоқ, бұл ештеңе емес, бұл жай...
Dialogue: 0,0:20:13.58,0:20:14.83,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:20:16.00,0:20:16.88,Default,,0,0,0,,Ас әзірлеу!
Dialogue: 0,0:20:17.29,0:20:20.13,Default,,0,0,0,,Мен Дуал мен Дороти оны жегенін қаладым.
Dialogue: 0,0:20:20.38,0:20:21.88,Default,,0,0,0,,Хехе, жақсы жұмыс.
Dialogue: 0,0:20:22.55,0:20:24.43,Default,,0,0,0,,Ләззат алыңыз!
Dialogue: 0,0:20:25.01,0:20:26.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:27.10,0:20:28.93,Default,,0,0,0,,Неліктен бұл болып жатыр?
Dialogue: 0,0:20:29.10,0:20:30.89,Default,,0,0,0,,Менен сұрасаң да...
Dialogue: 0,0:20:31.31,0:20:34.81,Default,,0,0,0,,Неге екені белгісіз, мен кенет тамақ әзірлегім келді.
Dialogue: 0,0:20:34.98,0:20:36.69,Default,,0,0,0,,Тез бұзылатын заттармен не бар?
Dialogue: 0,0:20:36.94,0:20:38.94,Default,,0,0,0,,Мен оны сақтық көшірме деректерінен алдым.
Dialogue: 0,0:20:39.11,0:20:41.78,Default,,0,0,0,,Иә? Тіпті сіз қалағаныңызды жасайсыз
Dialogue: 0,0:20:41.94,0:20:45.57,Default,,0,0,0,,Эххе, мен жасай бастағанда қызық болып кетті.
Dialogue: 0,0:20:46.03,0:20:48.28,Default,,0,0,0,,Сіз өзіңізбен бірге вирус алып келмеген шығарсыз.
Dialogue: 0,0:20:50.45,0:20:51.58,Default,,0,0,0,,Жақсы сияқты.
Dialogue: 0,0:20:51.87,0:20:53.12,Default,,0,0,0,,Сіз қалай ойлайсыз? мыс?
Dialogue: 0,0:20:53.54,0:20:54.29,Default,,0,0,0,,Иә...
Dialogue: 0,0:20:54.46,0:20:57.92,Default,,0,0,0,,Ненің дәмді, ненің жаман екенін білмейміз дейді.
Dialogue: 0,0:20:58.29,0:20:59.71,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:21:00.30,0:21:02.71,Default,,0,0,0,,Бірақ егер сіз оны дәмді деп ойласаңыз, ол дәмді болуы мүмкін.
Dialogue: 0,0:21:02.92,0:21:03.63,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:21:03.84,0:21:04.55,Default,,0,0,0,,Иә
Dialogue: 0,0:21:04.80,0:21:07.39,Default,,0,0,0,,Ия, Дороти де жейді.
Dialogue: 0,0:21:07.72,0:21:10.47,Default,,0,0,0,,Мені адам мәдениеті қызықтырмайды.
Dialogue: 0,0:21:10.68,0:21:11.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:11.97,0:21:14.02,Default,,0,0,0,,Сіз өзіңіздің чектеріңізге сенімді емессіз.
Dialogue: 0,0:21:14.23,0:21:16.81,Default,,0,0,0,,Не? Бұл шындық болуы мүмкін емес, иә?
Dialogue: 0,0:21:18.23,0:21:19.69,Default,,0,0,0,,Ойласам, біз ұзақ уақыт сөйлеспеген сияқтымыз
Dialogue: 0,0:21:22.15,0:21:25.28,Default,,0,0,0,,Жақсы, егер сіз дәмді деп ойласаңыз, бұл дәмді болуы мүмкін.
Dialogue: 0,0:21:25.45,0:21:27.16,Default,,0,0,0,,Жақсы
Dialogue: 0,0:21:27.36,0:21:29.07,Default,,0,0,0,,Сізді не бақытты етеді?
Dialogue: 0,0:21:30.74,0:21:33.66,Default,,0,0,0,,Жақсы Жақсы Мен мұны өзім істей аламын!
Dialogue: 0,0:21:36.50,0:21:38.00,Default,,0,0,0,,Аха хехехе сен жақсысың
Dialogue: 0,0:21:38.38,0:21:39.84,Default,,0,0,0,,Мұны да алдың ба?
Dialogue: 0,0:21:40.09,0:21:40.79,Default,,0,0,0,,Иә
Dialogue: 0,0:21:41.00,0:21:43.46,Default,,0,0,0,,Маған бұл елдің деректері ұнайды
Dialogue: 0,0:21:44.05,0:21:46.88,Default,,0,0,0,,Қараңдар, қараңдар, мен 3 жасадым! 3!
Dialogue: 0,0:21:47.30,0:21:48.18,Default,,0,0,0,,(Лимузиннің дыбысы)
Dialogue: 0,0:21:48.34,0:21:50.22,Default,,0,0,0,,Бұл да мен сияқты.
Dialogue: 0,0:21:54.60,0:21:59.60,Default,,0,0,0,,Ватару!
Dialogue: 0,0:22:03.69,0:22:04.99,Default,,0,0,0,,Ол қандай ән деп аталады?
Dialogue: 0,0:22:05.86,0:22:07.61,Default,,0,0,0,,«Шуберттің бесік жыры»
Dialogue: 0,0:22:09.61,0:22:11.53,Default,,0,0,0,,Сіз оғаш нәрселер жасай аласыз.
Dialogue: 0,0:22:13.24,0:22:14.87,Default,,0,0,0,,Иә? оғаш?
Dialogue: 0,0:22:15.54,0:22:17.41,Default,,0,0,0,,Кем дегенде біз сияқты-
Dialogue: 0,0:22:17.54,0:22:19.42,Default,,0,0,0,,Бұл вирустарды жоюға арналған бағдарламалық құрал емес сияқты.
Dialogue: 0,0:22:20.50,0:22:23.21,Default,,0,0,0,,Мен жаныңда болсам, тағамның дәмі жақсырақ болады...
Dialogue: 0,0:22:23.42,0:22:25.88,Default,,0,0,0,,Мен музыканың сұлулығын түсіне алатындай сезінемін.
Dialogue: 0,0:22:26.05,0:22:27.22,Default,,0,0,0,,Хмм.
Dialogue: 0,0:22:27.42,0:22:31.43,Default,,0,0,0,,Бұл өзімді дәмді және әдемі сезінгендіктен болса керек.
Dialogue: 0,0:22:31.60,0:22:34.06,Default,,0,0,0,,Сол себепті қосарлыларға жеткізіледі деп ойлаймын.
Dialogue: 0,0:22:34.39,0:22:35.06,Default,,0,0,0,,Тачи?
Dialogue: 0,0:22:35.35,0:22:36.68,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:22:36.85,0:22:39.69,Default,,0,0,0,,Иә, біз байланыстыра аламыз.
Dialogue: 0,0:22:39.81,0:22:42.27,Default,,0,0,0,,～♪
Dialogue: 0,0:22:43.90,0:22:46.15,Default,,0,0,0,,Әй, тыңдағың келетін ән бар ма?
Dialogue: 0,0:22:46.78,0:22:50.41,Default,,0,0,0,,Сондықтан мен музыканы түсінбеймін.
Dialogue: 0,0:22:50.53,0:22:52.32,Default,,0,0,0,,Эй, сен мұны білесің бе?
Dialogue: 0,0:22:52.62,0:22:57.62,Default,,0,0,0,,(Қос ызылдау)
Dialogue: 0,0:22:59.96,0:23:01.67,Default,,0,0,0,,(«Арман бүршіктері» фортепианолық қойылым)
Dialogue: 0,0:23:01.79,0:23:03.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:03.34,0:23:04.25,Default,,0,0,0,,Неліктен оны ойнай аласыз?
Dialogue: 0,0:23:04.71,0:23:05.88,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:23:08.59,0:23:10.22,Default,,0,0,0,,Менің армандарым
Dialogue: 0,0:23:10.34,0:23:13.43,Default,,0,0,0,,Пианист болыңыз және әлем бойынша саяхаттаңыз
Dialogue: 0,0:23:13.97,0:23:16.47,Default,,0,0,0,,Музыка дәуірлер мен елдерден асып түседі.
Dialogue: 0,0:23:16.60,0:23:18.93,Default,,0,0,0,,Сіз адамдардың сезімін байланыстыра аласыз, солай ма?
Dialogue: 0,0:23:19.31,0:23:22.94,Default,,0,0,0,,Мен де солай өнер көрсетсем ғой.
Dialogue: 0,0:23:23.44,0:23:25.82,Default,,0,0,0,,Фортепианода мұндай күш бар ма?
Dialogue: 0,0:23:26.61,0:23:27.32,Default,,0,0,0,,Ах!
Dialogue: 0,0:23:28.44,0:23:30.36,Default,,0,0,0,,Келесі не болатынын есіме түсіре алмаймын.
Dialogue: 0,0:23:31.32,0:23:33.16,Default,,0,0,0,,Мен оны дұрыс есімде сақтамадым деп ойлаймын.
Dialogue: 0,0:23:33.70,0:23:36.33,Default,,0,0,0,,О, не болды? қос
Dialogue: 0,0:23:37.08,0:23:38.04,Default,,0,0,0,,Сіз жылап жатырсыз ба?
Dialogue: 0,0:23:39.25,0:23:41.04,Default,,0,0,0,,Біз жыламаймыз
Dialogue: 0,0:23:41.37,0:23:42.87,Default,,0,0,0,,Мұның қажеті жоқ.
Dialogue: 0,0:23:43.63,0:23:46.50,Default,,0,0,0,,Уайымдама, бұл сенің кінәң емес.
Dialogue: 0,0:23:47.80,0:23:49.80,Default,,0,0,0,,Кешіріңіз, мен қазір жақсымын.
Dialogue: 0,0:23:50.51,0:23:51.93,Default,,0,0,0,,Оны қайта ойнай аласыз ба?
Dialogue: 0,0:23:52.47,0:23:55.47,Default,,0,0,0,,Бірақ мен тек осыны ғана түсінемін.
Dialogue: 0,0:23:56.56,0:23:57.47,Default,,0,0,0,,Бұл жақсы
Dialogue: 0,0:23:57.64,0:23:58.47,Default,,0,0,0,,(Изуна) Ә? (Сора) Қашан?
Dialogue: 0,0:24:13.86,0:24:15.20,Default,,0,0,0,,Сіз...
Dialogue: 0,0:24:15.32,0:24:17.95,Default,,0,0,0,,Бұл жеке деректер бір жерден шығып кеткен жоқ па?
Dialogue: 0,0:24:18.37,0:24:19.83,Default,,0,0,0,,Тұлға деректері?
Dialogue: 0,0:24:20.33,0:24:22.54,Default,,0,0,0,,Иә, міне деректердің сақтық көшірмесі...
Dialogue: 0,0:24:22.66,0:24:25.88,Default,,0,0,0,,Менің ойымша, бұл бір жерден түсіп қалған болуы керек.
Dialogue: 0,0:24:26.38,0:24:27.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:24:28.42,0:24:30.30,Default,,0,0,0,,Әйтпесе, адамзат мәдениеті...
Dialogue: 0,0:24:30.42,0:24:32.30,Default,,0,0,0,,Сіз соншалықты білімді бола алмайсыз деп ойламайсыз ба?
Dialogue: 0,0:24:33.01,0:24:33.72,Default,,0,0,0,,Иә...
Dialogue: 0,0:24:34.30,0:24:35.97,Default,,0,0,0,,Мүмкін солай шығар.
Dialogue: 0,0:24:36.39,0:24:38.93,Default,,0,0,0,,Дұрыс па? Хмм!
Dialogue: 0,0:24:41.60,0:24:44.48,Default,,0,0,0,,Ол бір жерде гүлзардан құлаған болуы керек.
Dialogue: 0,0:24:44.77,0:24:45.94,Default,,0,0,0,,​​Күмән жоқ!
Dialogue: 0,0:24:46.35,0:24:48.98,Default,,0,0,0,,Уау, мен өте жақсымын.
Dialogue: 0,0:24:50.44,0:24:51.23,Default,,0,0,0,,Кристалда жарық жүздеген миллион рет шағылады—
Dialogue: 0,0:24:51.86,0:24:52.90,Default,,0,0,0,,Не?
Dialogue: 0,0:24:53.45,0:24:55.70,Default,,0,0,0,,Жоқ, Дороти де мені қалады...
Dialogue: 0,0:24:55.82,0:24:58.37,Default,,0,0,0,,Мен сені мен үшін уайымдады деп ойладым...
Dialogue: 0,0:24:58.58,0:25:00.33,Default,,0,0,0,,Мен уайымдамаймын.
Dialogue: 0,0:25:00.74,0:25:03.71,Default,,0,0,0,,Сенің кім екеніңді білмейінше өзімді қауіпсіз сезіне алмаймын.
Dialogue: 0,0:25:04.12,0:25:05.12,Default,,0,0,0,,үшін осы
Dialogue: 0,0:25:06.37,0:25:10.55,Default,,0,0,0,,Сонда да барлық сақтық көшірмелерді тексеру қиын.
Dialogue: 0,0:25:11.17,0:25:12.92,Default,,0,0,0,,Егер сіз де вирустарды тексерсеңіз...
Dialogue: 0,0:25:13.26,0:25:14.76,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:25:15.93,0:25:18.76,Default,,0,0,0,,А, бірақ тағы адасып қалсам, қиналып қалар едім.
Dialogue: 0,0:25:20.47,0:25:22.22,Default,,0,0,0,,Сізде әлі бар ма?
Dialogue: 0,0:25:22.97,0:25:26.52,Default,,0,0,0,,Бұны тег ретінде пайдалансаңыз, қашықтан басқару құралын қай жерде болса да таба аласыз.
Dialogue: 0,0:25:31.32,0:25:33.24,Default,,0,0,0,,Dual сізге жақсырақ көрінеді.
Dialogue: 0,0:25:33.90,0:25:34.57,Default,,0,0,0,,Егер өзіңді жақсы ұстасаң, мен саған зиян тигізбеймін.
Dialogue: 0,0:25:34.99,0:25:37.74,Default,,0,0,0,,Бұл Сумире есімді баланың естелігі.
Dialogue: 0,0:25:38.11,0:25:39.03,Default,,0,0,0,,Күлгін…
Dialogue: 0,0:25:40.12,0:25:42.99,Default,,0,0,0,,Бұл қос дос параметрі болды. Тұлға деректері.
Dialogue: 0,0:25:43.66,0:25:46.08,Default,,0,0,0,,Мен оны жойдым, себебі ол вируспен ластанған.
Dialogue: 0,0:25:50.00,0:25:51.54,Default,,0,0,0,,Уау
Dialogue: 0,0:25:57.05,0:25:59.59,Default,,0,0,0,,Рахмет, мен сені жақсы көремін.
Dialogue: 0,0:26:04.10,0:26:04.81,Default,,0,0,0,,Не?
Dialogue: 0,0:26:05.31,0:26:06.85,Default,,0,0,0,,Олар үш апалы-сіңліліге ұқсайды.
Dialogue: 0,0:26:07.73,0:26:10.31,Default,,0,0,0,,Сіз шынымен біртүрлі бағдарламасыз.
Dialogue: 0,0:26:10.98,0:26:12.61,Default,,0,0,0,,Кеттік
Dialogue: 0,0:26:13.36,0:26:18.36,Default,,0,0,0,,(«Қосымша жады»)
Dialogue: 0,0:26:34.30,0:26:37.92,Default,,0,0,0,,♪ тыныш ағып жатыр
Dialogue: 0,0:26:38.01,0:26:43.05,Default,,0,0,0,,♪ Уақытында
Dialogue: 0,0:26:43.14,0:26:46.06,Default,,0,0,0,,♪ ақырын
Dialogue: 0,0:26:48.18,0:26:51.69,Default,,0,0,0,,♪ Әлемді қорға
Dialogue: 0,0:26:51.77,0:26:56.44,Default,,0,0,0,,♪ Бұл жақсы.
Dialogue: 0,0:26:57.11,0:27:00.20,Default,,0,0,0,,♪ Мен ойладым
Dialogue: 0,0:27:00.53,0:27:01.57,Default,,0,0,0,,♪ Бірақ
Dialogue: 0,0:27:01.70,0:27:08.33,Default,,0,0,0,,♪ Менің жүрегім табиғи түрде балқиды
Dialogue: 0,0:27:08.62,0:27:14.42,Default,,0,0,0,,♪ Дәмді - әдемі
Dialogue: 0,0:27:14.50,0:27:18.05,Default,,0,0,0,,♪ Мен сізге айтқым келеді
Dialogue: 0,0:27:18.13,0:27:21.38,Default,,0,0,0,,♪ Жеңіл есте сақтау
Dialogue: 0,0:27:21.47,0:27:25.97,Default,,0,0,0,,♪ Мен және сен әлемі
Dialogue: 0,0:27:26.06,0:27:32.81,Default,,0,0,0,,♪ Сондай әдемі идеалда
Dialogue: 0,0:27:32.90,0:27:39.61,Default,,0,0,0,,♪ Бұл сізді аз да болса қуантады деп үміттенемін.
Dialogue: 0,0:27:39.82,0:27:43.78,Default,,0,0,0,,♪ Мен өзімді өте бақытты сезінемін.
Dialogue: 0,0:27:44.82,0:27:49.12,Default,,0,0,0,,♪ Менің сезімдерім
Dialogue: 0,0:27:49.87,0:27:55.84,Default,,0,0,0,,♪ Эй, көбірек сөйлесейік.
Dialogue: 0,0:28:15.23,0:28:20.24,Default,,0,0,0,,～♪
Dialogue: 0,0:28:21.28,0:28:23.61,Default,,0,0,0,,(танк ату дыбысы)
Dialogue: 0,0:28:25.66,0:28:26.83,Default,,0,0,0,,(танк ату дыбысы)
Dialogue: 0,0:28:31.20,0:28:36.21,Default,,0,0,0,,♪～
Dialogue: 0,0:29:26.01,0:29:31.01,Default,,0,0,0,,～♪
Dialogue: 0,0:29:37.02,0:29:39.06,Default,,0,0,0,,(«Осиете»)
Dialogue: 0,0:29:39.15,0:29:43.65,Default,,0,0,0,,♪ Тоңған жүрегім шулай бастайды
Dialogue: 0,0:29:43.82,0:29:48.74,Default,,0,0,0,,♪ Мен сені көбірек ұстағым келеді, мен сені сезгім келеді, мен сені көбірек білгім келеді
Dialogue: 0,0:29:50.24,0:29:53.45,Default,,0,0,0,,♪ Жалғыз...
Dialogue: 0,0:29:54.04,0:29:58.46,Default,,0,0,0,,♪ Онда болу табиғи нәрсе.
Dialogue: 0,0:30:00.42,0:30:03.63,Default,,0,0,0,,♪ Бірақ біреумен
Dialogue: 0,0:30:04.30,0:30:08.76,Default,,0,0,0,,♪ Екеуміз бірге жүргенде осылай болады
Dialogue: 0,0:30:08.89,0:30:14.22,Default,,0,0,0,,♪ Бағдарламаны өзгертіңіз
Dialogue: 0,0:30:14.81,0:30:16.94,Default,,0,0,0,,♪ Қараңыз
Dialogue: 0,0:30:17.10,0:30:21.94,Default,,0,0,0,,♪ Жаңа және ашық түстер
Dialogue: 0,0:30:22.48,0:30:27.07,Default,,0,0,0,,♪ Мен білмейтін нәрсені қалаймын
Dialogue: 0,0:30:27.20,0:30:33.03,Default,,0,0,0,,♪ Пішіннен бастау керек пе?
Dialogue: 0,0:30:33.12,0:30:37.12,Default,,0,0,0,,♪ Сіз бақыттысыз ба? қайғылы? жалғыздық? қызық?
Dialogue: 0,0:30:37.41,0:30:40.71,Default,,0,0,0,,♪ Мен өзімді бос емес сезінемін.
Dialogue: 0,0:30:40.83,0:30:43.21,Default,,0,0,0,,♪ Тағы да қызық
Dialogue: 0,0:30:43.34,0:30:47.47,Default,,0,0,0,,♪ Анау, мынау, сонда, барлық жерде.
Dialogue: 0,0:30:47.59,0:30:51.09,Default,,0,0,0,,♪ Мен бәріне қарсы шыққым келеді
Dialogue: 0,0:30:51.22,0:30:53.43,Default,,0,0,0,,♪ Өйткені бұл қызық
Dialogue: 0,0:30:53.51,0:31:00.14,Default,,0,0,0,,♪ үшінмен бірге күлсеңіз, өзіңізді жақсы сезінесіз
Dialogue: 0,0:31:10.86,0:31:14.70,Default,,0,0,0,,♪ Мен бақыттымын.
Dialogue: 0,0:31:14.78,0:31:16.45,Default,,0,0,0,,～♪
Dialogue: 0,0:31:16.79,0:31:20.04,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:31:20.75,0:31:24.38,Default,,0,0,0,,Дороти туған күніңмен!
Dialogue: 0,0:31:25.25,0:31:27.55,Default,,0,0,0,,Бұл менің сыйлығым.
Dialogue: 0,0:31:27.71,0:31:28.42,Default,,0,0,0,,Қалпақ
Dialogue: 0,0:31:28.80,0:31:30.72,Default,,0,0,0,,Мен бұл Доротиге жарасады деп ойладым.
Dialogue: 0,0:31:31.80,0:31:33.01,Default,,0,0,0,,Уау, керемет!
Dialogue: 0,0:31:33.14,0:31:34.43,Default,,0,0,0,,Мен Кәмпитпін
Dialogue: 0,0:31:34.85,0:31:37.10,Default,,0,0,0,,Дороти, сен тәттілерді жақсы көресің.
Dialogue: 0,0:31:38.31,0:31:39.64,Default,,0,0,0,,Мен оны жақсы көремін!
Dialogue: 0,0:31:39.77,0:31:41.35,Default,,0,0,0,,Бұл маған анамның айтқаны.
Dialogue: 0,0:31:41.60,0:31:44.31,Default,,0,0,0,,Менің ойымша, сіздің де осындай киіммен әдемі көрінетін уақыт келді.
Dialogue: 0,0:31:44.52,0:31:47.82,Default,,0,0,0,,Маған анам тігіп берді. Ол оны ұзақ уақыт бойы дайындап келген.
Dialogue: 0,0:31:47.98,0:31:50.19,Default,,0,0,0,,Әпкем екеуміз де көмектестік.
Dialogue: 0,0:31:50.45,0:31:52.11,Default,,0,0,0,,Рахмет
Dialogue: 0,0:31:52.28,0:31:54.24,Default,,0,0,0,,Әкемнен... (саусақ ысқырығы)
Dialogue: 0,0:31:54.45,0:31:55.28,Default,,0,0,0,,Жақсы
Dialogue: 0,0:31:57.62,0:31:58.66,Default,,0,0,0,,Не? О?
Dialogue: 0,0:32:00.12,0:32:02.46,Default,,0,0,0,,Уау күшік! сүйкімді
Dialogue: 0,0:32:02.62,0:32:05.88,Default,,0,0,0,,Сіз мұны қалайтыныңызды біраз уақыттан бері айттыңыз. Оны еркелетіңіз.
Dialogue: 0,0:32:06.21,0:32:07.34,Default,,0,0,0,,Рахмет
Dialogue: 0,0:32:08.00,0:32:09.92,Default,,0,0,0,,Кел, Дороти.
Dialogue: 0,0:32:10.05,0:32:13.22,Default,,0,0,0,,Өшіргенде тілек айтсаңыз, арманыңыз орындалады.
Dialogue: 0,0:32:13.51,0:32:15.35,Default,,0,0,0,,Доротидің арманы қандай?
Dialogue: 0,0:32:16.89,0:32:18.06,Default,,0,0,0,,Секір!!
Dialogue: 0,0:32:18.51,0:32:22.19,Default,,0,0,0,,Біз бәріміз мәңгілік келісімде өмір сүре аламыз деп сенемін.
Dialogue: 0,0:32:27.86,0:32:28.90,Default,,0,0,0,,Дороти?
Dialogue: 0,0:32:29.48,0:32:32.53,Default,,0,0,0,,Бұл әлем вируспен ластанған.
Dialogue: 0,0:32:33.03,0:32:34.86,Default,,0,0,0,,Жалғыз опция - оны жою.
Dialogue: 0,0:32:35.53,0:32:37.74,Default,,0,0,0,,Бұл жай ғана бағдарлама деректері.
Dialogue: 0,0:32:38.08,0:32:40.50,Default,,0,0,0,,Мен сенің нағыз отбасыңмын деп сен.
Dialogue: 0,0:32:40.62,0:32:41.58,Default,,0,0,0,,Маған жауап бер.
Dialogue: 0,0:32:42.54,0:32:43.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:32:44.21,0:32:45.50,Default,,0,0,0,,Ах... Ах!
Dialogue: 0,0:32:48.09,0:32:49.17,Default,,0,0,0,,Уф
Dialogue: 0,0:32:50.17,0:32:51.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:32:57.68,0:32:58.72,Default,,0,0,0,,Дороти
Dialogue: 0,0:32:59.35,0:33:00.52,Default,,0,0,0,,Ал Кира
Dialogue: 0,0:33:01.60,0:33:02.85,Default,,0,0,0,,Сол торт
Dialogue: 0,0:33:03.23,0:33:03.73,Default,,0,0,0,,Иә
Dialogue: 0,0:33:04.19,0:33:06.31,Default,,0,0,0,,Мен анамның жасағанын жесем ғой.
Dialogue: 0,0:33:06.60,0:33:07.19,Default,,0,0,0,,Иә
Dialogue: 0,0:33:07.61,0:33:09.61,Default,,0,0,0,,Дәмді екеніне сенімдімін.
Dialogue: 0,0:33:10.98,0:33:12.65,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,0:33:13.15,0:33:15.49,Default,,0,0,0,,Мен тіпті жынды бола бастаған сияқтымын.
Dialogue: 0,0:33:15.61,0:33:17.03,Default,,0,0,0,,Балалар сендер үшін
Dialogue: 0,0:33:18.41,0:33:20.41,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:33:20.95,0:33:22.91,Default,,0,0,0,,Маған сақтық көшірме не үшін қажет?
Dialogue: 0,0:33:23.25,0:33:27.00,Default,,0,0,0,,Бұл білім сандығы әлемді жаратқан адамдарға ғана белгілі.
Dialogue: 0,0:33:27.50,0:33:29.42,Default,,0,0,0,,Вирустар қайдан пайда болады?
Dialogue: 0,0:33:29.63,0:33:31.42,Default,,0,0,0,,Неліктен кенет өсті?
Dialogue: 0,0:33:31.84,0:33:33.88,Default,,0,0,0,,Ластанған болса, өшіруден басқа амал жоқ па?
Dialogue: 0,0:33:34.26,0:33:36.22,Default,,0,0,0,,Мен тағы не істей аламын?
Dialogue: 0,0:33:36.97,0:33:40.72,Default,,0,0,0,,Біз тек бағдарламаның айтқанын орындаймыз.
Dialogue: 0,0:33:41.72,0:33:45.23,Default,,0,0,0,,Бұл дүниеде мен түсінбейтін нәрселер өте көп.
Dialogue: 0,0:33:45.98,0:33:46.77,Default,,0,0,0,,Мен...
Dialogue: 0,0:33:47.73,0:33:49.98,Default,,0,0,0,,Сіз мұнда не үшін келдіңіз?
Dialogue: 0,0:33:52.03,0:33:55.11,Default,,0,0,0,,Сонда да маған бұл дүние ұнайды
Dialogue: 0,0:33:55.61,0:33:59.41,Default,,0,0,0,,Мен сені әрқашан қорғадым, мен сені әрқашан қорғаймын.
Dialogue: 0,0:34:02.24,0:34:03.83,Default,,0,0,0,,Фуйошитто
Dialogue: 0,0:34:06.00,0:34:09.79,Default,,0,0,0,,Шулы екен, мені оятты.
Dialogue: 0,0:34:09.92,0:34:13.05,Default,,0,0,0,,Мен үйде жұмыс істегенде өзімді тыныш сезінемін.
Dialogue: 0,0:34:13.17,0:34:16.38,Default,,0,0,0,,Жарайсың, себебі жаңарту жоқ.
Dialogue: 0,0:34:17.05,0:34:19.22,Default,,0,0,0,,Ұйықтасаң да, жатпасаң да бәрібір.
Dialogue: 0,0:34:19.80,0:34:20.97,Default,,0,0,0,,Сіз күтпеген жерден...
Dialogue: 0,0:34:21.10,0:34:23.72,Default,,0,0,0,,Бұл біздің қолдау құралы емес пе?
Dialogue: 0,0:34:24.06,0:34:27.23,Default,,0,0,0,,Гүл бақтарының несі бар, әзіл.
Dialogue: 0,0:34:27.85,0:34:33.11,Default,,0,0,0,,Менің ойымша, гүл бақшасы маңызды нәрсе болды.
Dialogue: 0,0:34:35.82,0:34:37.11,Default,,0,0,0,,Хмм.
Dialogue: 0,0:34:37.32,0:34:39.16,Default,,0,0,0,,Қолдау құралы? (Дороти) О.
Dialogue: 0,0:34:39.32,0:34:41.28,Default,,0,0,0,,Егер солай болса, мен бақытты болар едім.
Dialogue: 0,0:34:41.49,0:34:42.37,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:34:42.78,0:34:45.37,Default,,0,0,0,,Өйткені үшеуміз мәңгі бірге бола аламыз.
Dialogue: 0,0:34:46.29,0:34:46.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:34:48.33,0:34:49.67,Default,,0,0,0,,А, вирус
Dialogue: 0,0:34:49.96,0:34:50.79,Default,,0,0,0,,Орташа қауіп
Dialogue: 0,0:34:51.79,0:34:54.59,Default,,0,0,0,,Қызық, қайдан шыққан?
Dialogue: 0,0:34:54.96,0:34:55.96,Default,,0,0,0,,Лимузы осында
Dialogue: 0,0:34:56.13,0:34:57.59,Default,,0,0,0,,Неліктен? Менің де барғым келеді
Dialogue: 0,0:34:57.67,0:34:59.63,Default,,0,0,0,,Жақсы Жақсы Джама Джама
Dialogue: 0,0:34:59.72,0:35:00.68,Default,,0,0,0,,Ой...
Dialogue: 0,0:35:17.24,0:35:18.03,Default,,0,0,0,,Жаңа түрлер?
Dialogue: 0,0:35:19.57,0:35:21.03,Default,,0,0,0,,Бұл мен бұрын көрмеген түрім.
Dialogue: 0,0:35:21.70,0:35:22.45,Default,,0,0,0,,Эй!
Dialogue: 0,0:35:23.24,0:35:23.99,Default,,0,0,0,,Эй!
Dialogue: 0,0:35:27.54,0:35:29.54,Default,,0,0,0,,Бұл оңай жеңіс.
Dialogue: 0,0:35:33.04,0:35:34.21,Default,,0,0,0,,Компрессия!
Dialogue: 0,0:35:42.51,0:35:43.39,Default,,0,0,0,,Жою
Dialogue: 0,0:35:44.97,0:35:48.10,Default,,0,0,0,,Жойылған вирустармен не болады?
Dialogue: 0,0:35:48.22,0:35:49.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:35:49.31,0:35:52.02,Default,,0,0,0,,Ол жойылды ма? Ол жоғалып кетті ме?
Dialogue: 0,0:35:52.15,0:35:53.69,Default,,0,0,0,,Сен неге бұлай ойлайсың?
Dialogue: 0,0:35:54.19,0:35:56.57,Default,,0,0,0,,Бір күні Ремоның айтқаны есіме түсті.
Dialogue: 0,0:35:58.07,0:35:59.36,Default,,0,0,0,,Хмм...
Dialogue: 0,0:35:59.94,0:36:02.49,Default,,0,0,0,,Сіз шынымен есінен танып қалдыңыз, солай емес пе?
Dialogue: 0,0:36:02.61,0:36:03.20,Default,,0,0,0,,Ах
Dialogue: 0,0:36:03.61,0:36:04.62,Default,,0,0,0,,Мен де, әпкем де осы жерде күтеміз.
Dialogue: 0,0:36:10.91,0:36:11.54,Default,,0,0,0,,Үлкен
Dialogue: 0,0:36:16.42,0:36:17.55,Default,,0,0,0,,Мен мұны сізге қалдырамын.
Dialogue: 0,0:36:23.38,0:36:25.01,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:36:26.39,0:36:28.06,Default,,0,0,0,,Леви…
Dialogue: 0,0:36:28.56,0:36:29.77,Default,,0,0,0,,Күлгін гүлдер...?
Dialogue: 0,0:36:29.89,0:36:32.06,Default,,0,0,0,,Маған қайтаруыңызды өтінемін
Dialogue: 0,0:36:34.73,0:36:35.73,Default,,0,0,0,,Леви…
Dialogue: 0,0:36:36.61,0:36:37.82,Default,,0,0,0,,Менің арманым
Dialogue: 0,0:36:38.15,0:36:38.90,Default,,0,0,0,,Сіз жақсысыз ба?
Dialogue: 0,0:36:40.48,0:36:42.07,Default,,0,0,0,,Күлгін гүлдер...
Dialogue: 0,0:36:42.20,0:36:42.90,Default,,0,0,0,,Сіз жақсысыз ба?
Dialogue: 0,0:36:49.79,0:36:51.58,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:36:53.00,0:36:54.67,Default,,0,0,0,,Екеуің неге сонда тұрып, аң-таң болып қарап тұрсыңдар?
Dialogue: 0,0:36:56.38,0:36:57.75,Default,,0,0,0,,Боқ, қажетсіз функциялар
Dialogue: 0,0:36:58.63,0:36:59.25,Default,,0,0,0,,Ей, жартылай жұмыс істейтін! Алдыңа шықшы, өтінемін!
Dialogue: 0,0:36:59.63,0:37:00.96,Default,,0,0,0,,Қос! Ах...!
Dialogue: 0,0:37:03.13,0:37:07.68,Default,,0,0,0,,Дороти, егер мен ластансам, мені өшір.
Dialogue: 0,0:37:08.60,0:37:11.14,Default,,0,0,0,,Маған пультті беріңізші
Dialogue: 0,0:37:11.35,0:37:12.68,Default,,0,0,0,,Мен ақымақ емеспін!
Dialogue: 0,0:37:14.98,0:37:16.35,Default,,0,0,0,,Мен қазір саған көмектесемін
Dialogue: 0,0:37:16.77,0:37:18.77,Default,,0,0,0,,Дороти! қос!
Dialogue: 0,0:37:20.32,0:37:22.53,Default,,0,0,0,,Идиот! Не үшін келдің?
Dialogue: 0,0:37:23.03,0:37:23.78,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:37:26.61,0:37:28.16,Default,,0,0,0,,Не? иә?
Dialogue: 0,0:37:28.57,0:37:30.33,Default,,0,0,0,,Кяах!
Dialogue: 0,0:37:31.95,0:37:32.79,Default,,0,0,0,,Ремо!
Dialogue: 0,0:37:35.96,0:37:36.50,Default,,0,0,0,,Маған жауап бер.
Dialogue: 0,0:37:50.97,0:37:53.31,Default,,0,0,0,,...
Dialogue: 0,0:38:06.49,0:38:08.28,Default,,0,0,0,,Ах... ах
Dialogue: 0,0:38:08.41,0:38:09.07,Default,,0,0,0,,(Көрермен) Мен оны мінген күйдегі шайқасқа дейін қызықты жігіт деп ойладым…
Dialogue: 0,0:38:09.41,0:38:10.16,Default,,0,0,0,,Қашықтан басқару пульті ше?
Dialogue: 0,0:38:10.66,0:38:11.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:38:15.08,0:38:16.66,Default,,0,0,0,,А, бар!
Dialogue: 0,0:38:22.00,0:38:23.42,Default,,0,0,0,,Ластанбаған
Dialogue: 0,0:38:24.17,0:38:25.97,Default,,0,0,0,,Оны да қарастырып көрейін.
Dialogue: 0,0:38:27.26,0:38:28.30,Default,,0,0,0,,Ештеңе
Dialogue: 0,0:38:28.84,0:38:30.01,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:38:30.72,0:38:33.68,Default,,0,0,0,,Екеуміз де бізді толығымен басып алды деп ойладық.
Dialogue: 0,0:38:34.02,0:38:36.52,Default,,0,0,0,,Не болды? Вирустар ше?
Dialogue: 0,0:38:37.10,0:38:38.06,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:38:39.77,0:38:43.19,Default,,0,0,0,,Жарқырап барады, ізі қалмады.
Dialogue: 0,0:38:51.28,0:38:52.20,Default,,0,0,0,,Уф
Dialogue: 0,0:38:52.74,0:38:54.08,Default,,0,0,0,,Уф...
Dialogue: 0,0:38:55.70,0:38:57.87,Default,,0,0,0,,Өйткені, оған вирус шабуыл жасап жатқан жоқ па?
Dialogue: 0,0:38:58.46,0:38:59.50,Default,,0,0,0,,Реакция жоқ
Dialogue: 0,0:39:00.58,0:39:02.38,Default,,0,0,0,,Қызық, есте сақтау қабілетім қайта орала ма?
Dialogue: 0,0:39:03.96,0:39:05.88,Default,,0,0,0,,Сіз шегіргүл дедіңіз, солай ма?
Dialogue: 0,0:39:06.55,0:39:09.72,Default,,0,0,0,,Мен вирустың ішінен күлгін түсті көрдім.
Dialogue: 0,0:39:10.22,0:39:12.55,Default,,0,0,0,,Бірақ сіз күлгін гүлдерді жойдыңыз, солай ма?
Dialogue: 0,0:39:14.81,0:39:17.18,Default,,0,0,0,,«Жойылған вирустар жойылады»
Dialogue: 0,0:39:17.73,0:39:19.56,Default,,0,0,0,,Біз әрқашан солай ойлайтынбыз.
Dialogue: 0,0:39:20.02,0:39:23.56,Default,,0,0,0,,Дұрыс, білім сандығынан жоғалып, жоғалады.
Dialogue: 0,0:39:24.07,0:39:25.44,Default,,0,0,0,,Бұл соңы емес
Dialogue: 0,0:39:26.32,0:39:28.57,Default,,0,0,0,,Бірақ егер жоқ болса...
Dialogue: 0,0:39:29.28,0:39:30.57,Default,,0,0,0,,Әйтеуір бұл күндері...
Dialogue: 0,0:39:30.70,0:39:34.08,Default,,0,0,0,,Бұрын ойланбаған дүниелер ойыма оралды.
Dialogue: 0,0:39:37.24,0:39:39.41,Default,,0,0,0,,Дәл қазір, мені вирустар қоршап алған кезде
Dialogue: 0,0:39:40.00,0:39:40.75,Default,,0,0,0,,Не?
Dialogue: 0,0:39:41.46,0:39:43.21,Default,,0,0,0,,Сен маған көмектесуге тырыстың.
Dialogue: 0,0:39:44.25,0:39:45.17,Default,,0,0,0,,Рахмет
Dialogue: 0,0:39:46.80,0:39:47.92,Default,,0,0,0,,Ммм
Dialogue: 0,0:39:52.76,0:39:54.68,Default,,0,0,0,,Негізгі компьютерге қосылу
Dialogue: 0,0:39:55.26,0:39:56.35,Default,,0,0,0,,Қашықтан қол жеткізу
Dialogue: 0,0:39:56.76,0:39:57.60,Default,,0,0,0,,Ремо!
Dialogue: 0,0:39:58.35,0:40:02.27,Default,,0,0,0,,Білім ұяшығының виртуалды координатасын өлшеу
Dialogue: 0,0:40:03.19,0:40:06.48,Default,,0,0,0,,Протоколды толық бөлу Іздеуді бастау
Dialogue: 0,0:40:06.98,0:40:07.73,Default,,0,0,0,,Ремо!
Dialogue: 0,0:40:09.03,0:40:10.82,Default,,0,0,0,,Ремо Сіз кімсіз?
Dialogue: 0,0:40:11.45,0:40:14.07,Default,,0,0,0,,Неліктен білім қорабына орнатылды?
Dialogue: 0,0:40:15.32,0:40:19.33,Default,,0,0,0,,Деректерді іздеймін және шығарамын
Dialogue: 0,0:40:19.75,0:40:21.66,Default,,0,0,0,,Деректер қандай деректер түріне жатады?
Dialogue: 0,0:40:22.21,0:40:24.88,Default,,0,0,0,,Эксперименттік іздеу деректері
Dialogue: 0,0:40:25.79,0:40:27.00,Default,,0,0,0,,Эксперимент дегеніміз не?
Dialogue: 0,0:40:27.42,0:40:29.80,Default,,0,0,0,,Адамдар сізге не істеуге тырысады?
Dialogue: 0,0:40:30.51,0:40:33.22,Default,,0,0,0,,Адамдар жасамайды
Dialogue: 0,0:40:33.72,0:40:34.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:40:34.59,0:40:37.68,Default,,0,0,0,,Сонда сізді кім бағдарламалады?
Dialogue: 0,0:40:38.31,0:40:42.98,Default,,0,0,0,,Адамдардың бәрі жоғалып кеткен шығар.
Dialogue: 0,0:40:45.35,0:40:46.81,Default,,0,0,0,,Оның нені білдіретінін түсіндіңіз бе?
Dialogue: 0,0:40:49.53,0:40:50.32,Default,,0,0,0,,Эй
Dialogue: 0,0:40:51.19,0:40:54.28,Default,,0,0,0,,Дороти Бізді орнатқаннан бері
Dialogue: 0,0:40:54.61,0:40:55.99,Default,,0,0,0,,Сіз қанша уақыт өткенін білесіз бе?
Dialogue: 0,0:40:56.16,0:40:57.28,Default,,0,0,0,,Келіңіздер...
Dialogue: 0,0:40:57.74,0:41:00.83,Default,,0,0,0,,Мен оны дұрыс қарастырмадым, бірақ...
Dialogue: 0,0:41:01.50,0:41:02.66,Default,,0,0,0,,5 жылға жуық?
Dialogue: 0,0:41:03.83,0:41:06.13,Default,,0,0,0,,Білім сандығында ағып жатқан уақыт
Dialogue: 0,0:41:06.50,0:41:08.84,Default,,0,0,0,,Сыртқы дүниедегі уақыт әртүрлі болуы мүмкін.
Dialogue: 0,0:41:09.84,0:41:11.46,Default,,0,0,0,,Деректердің сақтық көшірмесін жасау уақыты және
Dialogue: 0,0:41:12.05,0:41:14.34,Default,,0,0,0,,Бұл қабаттағы уақыт ағымы басқаша сияқты.
Dialogue: 0,0:41:14.93,0:41:15.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:41:16.05,0:41:17.43,Default,,0,0,0,,Сыртқы әлемде
Dialogue: 0,0:41:17.85,0:41:18.93,Default,,0,0,0,,Өте ұзақ уақыт
Dialogue: 0,0:41:19.05,0:41:20.56,Default,,0,0,0,,тым кеш болуы мүмкін.
Dialogue: 0,0:41:21.39,0:41:22.27,Default,,0,0,0,,50 жыл…
Dialogue: 0,0:41:22.39,0:41:23.18,Default,,0,0,0,,100 жыл...
Dialogue: 0,0:41:23.73,0:41:24.89,Default,,0,0,0,,Мүмкін көп
Dialogue: 0,0:41:25.39,0:41:27.52,Default,,0,0,0,,Сіз не ойлап отырсыз?
Dialogue: 0,0:41:28.73,0:41:30.61,Default,,0,0,0,,...
Dialogue: 0,0:41:34.15,0:41:35.65,Default,,0,0,0,,Уф...
Dialogue: 0,0:41:35.82,0:41:38.78,Default,,0,0,0,,Бұл мәңгілікке қалмайды, солай ма?
Dialogue: 0,0:41:40.62,0:41:42.20,Default,,0,0,0,,Қалаған нәрсе бар ма?
Dialogue: 0,0:41:42.33,0:41:44.66,Default,,0,0,0,,Уф...
Dialogue: 0,0:41:45.46,0:41:47.12,Default,,0,0,0,,P… a… жоқ…
Dialogue: 0,0:41:47.42,0:41:48.67,Default,,0,0,0,,Сіз пианино дедіңіз бе?
Dialogue: 0,0:41:49.59,0:41:50.92,Default,,0,0,0,,Сол ән
Dialogue: 0,0:41:51.92,0:41:53.67,Default,,0,0,0,,Бесік жырын тыңдағың келе ме?
Dialogue: 0,0:41:53.92,0:41:54.92,Default,,0,0,0,,Қазірге дейінгі тәжірибелердің нәтижелеріне сүйене отырып,
Dialogue: 0,0:41:55.38,0:41:56.34,Default,,0,0,0,,Бірақ оны қазір анаға көрсетпе.
Dialogue: 0,0:41:56.93,0:42:00.55,Default,,0,0,0,,Лимузы мен Сумиренің әлемін өшіргенімде пайда болды.
Dialogue: 0,0:42:01.01,0:42:04.23,Default,,0,0,0,,Бұл ән менің есте сақтау қабілетімді қалпына келтіруге түрткі болуы мүмкін.
Dialogue: 0,0:42:04.64,0:42:06.52,Default,,0,0,0,,Сіз пианинода ойнай аласыз ба?
Dialogue: 0,0:42:07.56,0:42:11.07,Default,,0,0,0,,Мен ноталарды орындағаннан гөрі лимузин ойнағанды ​​жақсы көремін.
Dialogue: 0,0:42:11.44,0:42:18.03,Default,,0,0,0,,(Қос ойнайтын пианино дыбысы)
Dialogue: 0,0:42:18.95,0:42:22.83,Default,,0,0,0,,Бұл жақсы емес пе? екі жақты жалғастырыңыз
Dialogue: 0,0:42:23.74,0:42:30.25,Default,,0,0,0,,(фортепианода ойнайтын қос дыбыс)
Dialogue: 0,0:42:37.51,0:42:39.64,Default,,0,0,0,,Сіз тек лимузин ойнай аласыз, солай ма?
Dialogue: 0,0:42:40.26,0:42:40.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:42:41.55,0:42:46.35,Default,,0,0,0,,(Ойнауды жалғастыру)
Dialogue: 0,0:42:46.48,0:42:48.14,Default,,0,0,0,,Уа, ау, ау!
Dialogue: 0,0:42:48.31,0:42:48.94,Default,,0,0,0,,Ах...!
Dialogue: 0,0:42:51.61,0:42:56.57,Default,,0,0,0,,(фортепианода ойнау дыбысы)
Dialogue: 0,0:42:57.86,0:42:59.20,Default,,0,0,0,,Кім бар?
Dialogue: 0,0:42:59.95,0:43:02.78,Default,,0,0,0,,Ең алдымен, техникалық колледжде—
Dialogue: 0,0:43:02.91,0:43:06.62,Default,,0,0,0,,～♪
Dialogue: 0,0:43:07.33,0:43:08.16,Default,,0,0,0,,Уау!
Dialogue: 0,0:43:08.58,0:43:09.21,Default,,0,0,0,,Ремо!
Dialogue: 0,0:43:10.17,0:43:11.67,Default,,0,0,0,,Тек таза заттар
Dialogue: 0,0:43:12.88,0:43:13.63,Default,,0,0,0,,Анаға
Dialogue: 0,0:43:14.13,0:43:15.96,Default,,0,0,0,,Иә? Ана?
Dialogue: 0,0:43:16.46,0:43:17.09,Default,,0,0,0,,Ах
Dialogue: 0,0:43:17.80,0:43:19.63,Default,,0,0,0,,Уау!
Dialogue: 0,0:43:21.30,0:43:22.80,Default,,0,0,0,,Маған басқа ештеңе керек емес
Dialogue: 0,0:43:28.39,0:43:29.18,Default,,0,0,0,,(Киришима & Сейро) Хахаха… Шынымен бе? Шынымен бе? Бакуго!
Dialogue: 0,0:43:29.81,0:43:31.02,Default,,0,0,0,,Міне.
Dialogue: 0,0:43:38.24,0:43:38.94,Default,,0,0,0,,Ремо!
Dialogue: 0,0:43:39.86,0:43:40.82,Default,,0,0,0,,Уау~
Dialogue: 0,0:43:47.16,0:43:47.83,Default,,0,0,0,,Ремо!
Dialogue: 0,0:43:48.00,0:43:50.08,Default,,0,0,0,,Бұл лабиринт сияқты!
Dialogue: 0,0:43:50.54,0:43:53.58,Default,,0,0,0,,Иә! Мен тег қостым, солай ма?
Dialogue: 0,0:43:53.79,0:43:54.79,Default,,0,0,0,,Мұнда
Dialogue: 0,0:43:58.38,0:43:59.38,Default,,0,0,0,,Уау
Dialogue: 0,0:43:59.72,0:44:00.63,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:44:10.81,0:44:11.69,Default,,0,0,0,,Ах
Dialogue: 0,0:44:14.27,0:44:15.86,Default,,0,0,0,,Уау, лимузин!
Dialogue: 0,0:44:16.02,0:44:17.11,Default,,0,0,0,,Сіз мені естімейсіз бе?
Dialogue: 0,0:44:17.52,0:44:21.70,Default,,0,0,0,,Бұл тым жылдам. Өңдеу жылдамдығы шектен асады.
Dialogue: 0,0:44:22.03,0:44:24.37,Default,,0,0,0,,Егер біз одан да көп душ жасасақ...
Dialogue: 0,0:44:24.74,0:44:25.70,Default,,0,0,0,,Уф...
Dialogue: 0,0:44:47.72,0:44:50.31,Default,,0,0,0,,Адамзаттың ақымақтығын түсінесің.
Dialogue: 0,0:44:50.68,0:44:53.60,Default,,0,0,0,,Бірақ соңғы сусын дәмді.
Dialogue: 0,0:44:55.15,0:44:57.15,Default,,0,0,0,,Бұл колония да өзінің шегінде.
Dialogue: 0,0:44:57.69,0:44:58.36,Default,,0,0,0,,Иә
Dialogue: 0,0:44:59.23,0:45:00.53,Default,,0,0,0,,Біраз көңілім қалды.
Dialogue: 0,0:45:01.28,0:45:04.99,Default,,0,0,0,,Мен ешқашан адамзаттың жойылуына қатысамын деп ойламадым.
Dialogue: 0,0:45:09.83,0:45:10.91,Default,,0,0,0,,Адамгершілік...
Dialogue: 0,0:45:12.08,0:45:13.21,Default,,0,0,0,,Қирау...
Dialogue: 0,0:45:45.20,0:45:45.90,Default,,0,0,0,,Ремо!
Dialogue: 0,0:45:46.99,0:45:48.20,Default,,0,0,0,,Сіздің жадыңыз қалпына келді ме?
Dialogue: 0,0:45:49.41,0:45:50.45,Default,,0,0,0,,Менің кінәм
Dialogue: 0,0:45:50.83,0:45:51.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:45:52.83,0:45:57.00,Default,,0,0,0,,Бірнеше әлемді жою керек болды.
Dialogue: 0,0:45:57.46,0:45:59.96,Default,,0,0,0,,Сіз нені айтасыз? Дұрыстап түсіндіріп беріңізші!
Dialogue: 0,0:46:00.29,0:46:01.80,Default,,0,0,0,,Адамзаттың жойылуы дегеніміз не?
Dialogue: 0,0:46:05.59,0:46:09.51,Default,,0,0,0,,Бұл білім сандығы идеалды әлем үшін жасалған.
Dialogue: 0,0:46:12.97,0:46:16.39,Default,,0,0,0,,Қоршаған ортаны қорғау демонстрациясында баламнан апатқа ұшырадым.
Dialogue: 0,0:46:16.52,0:46:18.31,Default,,0,0,0,,Доктор Диана Доусонның зерттеулері...
Dialogue: 0,0:46:18.44,0:46:19.73,Default,,0,0,0,,Идеал Жер біздің қолымызда.
Dialogue: 0,0:46:20.40,0:46:20.94,Default,,0,0,0,,Доктор Дэниел Доусон, Bios әзірлеушісі.
Dialogue: 0,0:46:20.94,0:46:22.61,Default,,0,0,0,,Доктор Дэниел Доусон, Bios әзірлеушісі.
Dialogue: 0,0:46:20.94,0:46:22.61,Default,,0,0,0,,2100 Лондон
Dialogue: 0,0:46:22.61,0:46:22.73,Default,,0,0,0,,2100 Лондон
Dialogue: 0,0:46:22.73,0:46:24.65,Default,,0,0,0,,2100 Лондон
Dialogue: 0,0:46:22.73,0:46:24.65,Default,,0,0,0,,Бұл менің қызым, доктор Диана.
Dialogue: 0,0:46:25.32,0:46:29.16,Default,,0,0,0,,Мен қызымның қасіретін қайталамаймын деп уәде беремін.
Dialogue: 0,0:46:29.87,0:46:31.45,Default,,0,0,0,,2100 ж
Dialogue: 0,0:46:31.95,0:46:34.83,Default,,0,0,0,,Адам баласы Ана атты бағдарламада.
Dialogue: 0,0:46:35.12,0:46:36.91,Default,,0,0,0,,Қоғамды басқару маған сеніп тапсырылды.
Dialogue: 0,0:46:37.54,0:46:41.25,Default,,0,0,0,,Сол желі әлемге бейбітшілік пен тұрақтылық әкелді.
Dialogue: 0,0:46:41.96,0:46:43.80,Default,,0,0,0,,Бірақ керісінше...
Dialogue: 0,0:46:43.92,0:46:46.84,Default,,0,0,0,,Адамзат өркениетін тоқырау мен құлдырауға итермеледі.
Dialogue: 0,0:46:48.51,0:46:52.01,Default,,0,0,0,,Әлеуметтік тоқырау туу көрсеткішінің төмендеуіне түрткі болды
Dialogue: 0,0:46:55.02,0:46:59.39,Default,,0,0,0,,Адамдар түр ретінде өмірінің соңына таяп қалды.
Dialogue: 0,0:47:00.35,0:47:03.27,Default,,0,0,0,,Бірақ мұның бәрі ананың жоспары
Dialogue: 0,0:47:05.44,0:47:08.78,Default,,0,0,0,,Өйткені адам жалғыз жойғыш түр болды.
Dialogue: 0,0:47:09.78,0:47:13.87,Default,,0,0,0,,Ана жоспарлаған идеалды әлемде адам қажет емес.
Dialogue: 0,0:47:14.58,0:47:16.70,Default,,0,0,0,,Шешім қабылдайтын адамдар кедергі жасайды
Dialogue: 0,0:47:17.29,0:47:21.04,Default,,0,0,0,,Сондықтан адамды азайтуды түзету бағдарламасы басталды.
Dialogue: 0,0:47:21.63,0:47:25.17,Default,,0,0,0,,Сол уақытта анам деректердің сақтық көшірмесін жасай бастады.
Dialogue: 0,0:47:26.51,0:47:31.05,Default,,0,0,0,,Адамзат тарихы мен мәдениеті виртуалды кеңістікте деректер ретінде сақталды.
Dialogue: 0,0:47:31.97,0:47:33.76,Default,,0,0,0,,Онда тұратын адамдар туралы деректер
Dialogue: 0,0:47:34.30,0:47:37.18,Default,,0,0,0,,Тірі адамның тұлғасын көшіру
Dialogue: 0,0:47:37.68,0:47:39.98,Default,,0,0,0,,Барлық нақты адамдар
Dialogue: 0,0:47:40.56,0:47:44.36,Default,,0,0,0,,Сол көп адамдардың арасынан тек әдемі нәрселерді таңда...
Dialogue: 0,0:47:44.98,0:47:48.57,Default,,0,0,0,,Мен мұның бәрін біріктіріп, идеалды адамды жасауға тырысамын.
Dialogue: 0,0:47:50.78,0:47:52.03,Default,,0,0,0,,Идеал адам?
Dialogue: 0,0:47:52.41,0:47:55.99,Default,,0,0,0,,Жерге араласпайтын, шешім қабылдамайтын тірі заттар
Dialogue: 0,0:47:56.74,0:47:59.25,Default,,0,0,0,,Бұл адам емес.
Dialogue: 0,0:48:00.75,0:48:01.62,Default,,0,0,0,,Адамдар туралы не деуге болады?
Dialogue: 0,0:48:02.58,0:48:05.92,Default,,0,0,0,,Әрине, адамдар Ананы жоюға тырысты.
Dialogue: 0,0:48:06.34,0:48:07.38,Default,,0,0,0,,Сіз оны жойдыңыз ба?
Dialogue: 0,0:48:10.26,0:48:12.63,Default,,0,0,0,,Бірақ, адамдар қазірдің өзінде...
Dialogue: 0,0:48:13.01,0:48:16.10,Default,,0,0,0,,Сол бағдарламаға қарсы тұруға күшім қалмады.
Dialogue: 0,0:48:16.76,0:48:17.85,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:48:18.35,0:48:20.18,Default,,0,0,0,,Ананы жоюмен бір мезгілде――
Dialogue: 0,0:48:20.93,0:48:22.85,Default,,0,0,0,,Барлық адамдар жойылды.
Dialogue: 0,0:48:23.10,0:48:23.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:48:33.11,0:48:35.45,Default,,0,0,0,,Мына гүл әдемі ме?
Dialogue: 0,0:48:36.45,0:48:38.33,Default,,0,0,0,,Неліктен көп?
Dialogue: 0,0:48:39.79,0:48:41.25,Default,,0,0,0,,Өйткені мен оларды жинаймын.
Dialogue: 0,0:48:42.91,0:48:44.92,Default,,0,0,0,,Жаңарту файлын кім жіберді?
Dialogue: 0,0:48:45.17,0:48:47.29,Default,,0,0,0,,Иә, адам жоқ, солай ма?
Dialogue: 0,0:48:48.55,0:48:50.55,Default,,0,0,0,,Алынған таза заттардың қалдықтары...
Dialogue: 0,0:48:51.01,0:48:53.18,Default,,0,0,0,,Белсендіру күтпеген болды.
Dialogue: 0,0:48:53.55,0:48:54.89,Default,,0,0,0,,Іске қосу...
Dialogue: 0,0:48:55.18,0:48:56.60,Default,,0,0,0,,Қоқыс дегеніміз не?
Dialogue: 0,0:48:57.51,0:49:00.47,Default,,0,0,0,,Алгоритміңізді қайта жазыңыз...
Dialogue: 0,0:49:00.81,0:49:04.35,Default,,0,0,0,,Біз жүйені деректер қалдықтарын вирус ретінде анықтауға арналған.
Dialogue: 0,0:49:04.65,0:49:05.44,Default,,0,0,0,,(Изуку) Ка… Качан! Бұл емтиханда мұғалім жаман кейіпкер рөлін сомдап отыр,
Dialogue: 0,0:49:05.56,0:49:07.52,Default,,0,0,0,,Анам әлі тірі ме?
Dialogue: 0,0:49:09.48,0:49:10.23,Default,,0,0,0,,Ремо!
Dialogue: 0,0:49:10.53,0:49:11.49,Default,,0,0,0,,Ана пульті
Dialogue: 0,0:49:11.65,0:49:12.32,Default,,0,0,0,,Ах!
Dialogue: 0,0:49:12.65,0:49:14.36,Default,,0,0,0,,Менің атым жоқ
Dialogue: 0,0:49:15.95,0:49:18.16,Default,,0,0,0,,Ана…Қашықтан
Dialogue: 0,0:49:18.49,0:49:19.33,Default,,0,0,0,,Қашықтан…
Dialogue: 0,0:49:19.99,0:49:20.70,Default,,0,0,0,,Сіз...
Dialogue: 0,0:49:21.33,0:49:25.33,Default,,0,0,0,,Анадан жасырынып қалған жалғыз резервтік бағдарлама
Dialogue: 0,0:49:26.50,0:49:27.63,Default,,0,0,0,,Мен анамын
Dialogue: 0,0:49:27.96,0:49:28.63,Default,,0,0,0,,Ах!
Dialogue: 0,0:49:29.17,0:49:32.88,Default,,0,0,0,,Тоқтату бұйырғанша әдемі заттарды жинауды жалғастырыңыз.
Dialogue: 0,0:49:33.38,0:49:34.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:49:37.26,0:49:38.51,Default,,0,0,0,,Күн... Вирус
Dialogue: 0,0:49:38.68,0:49:40.35,Default,,0,0,0,,Иерархияның қабырғасы бұзылған.
Dialogue: 0,0:49:56.49,0:49:57.78,Default,,0,0,0,,Уау! Ремо!
Dialogue: 0,0:49:58.03,0:49:59.78,Default,,0,0,0,,Мен білмеймін, бұл не?
Dialogue: 0,0:50:00.24,0:50:00.91,Default,,0,0,0,,Қашықтан басқару?
Dialogue: 0,0:50:01.41,0:50:02.74,Default,,0,0,0,,Әдеттегі қашықтан басқару пультіне...
Dialogue: 0,0:50:03.04,0:50:03.95,Default,,0,0,0,,Қайтып келдіңіз бе?
Dialogue: 0,0:50:05.37,0:50:06.71,Default,,0,0,0,,Қалқан сияқты
Dialogue: 0,0:50:07.71,0:50:09.50,Default,,0,0,0,,Бұл вирус емес еді, солай ма?
Dialogue: 0,0:50:10.84,0:50:13.21,Default,,0,0,0,,Бірақ күресуден басқа амалымыз жоқ.
Dialogue: 0,0:50:13.55,0:50:15.17,Default,,0,0,0,,Ха, ха, ха!
Dialogue: 0,0:50:16.05,0:50:17.84,Default,,0,0,0,,Қорғайық (Дороти) Иә.
Dialogue: 0,0:50:22.43,0:50:23.35,Default,,0,0,0,,Иә!
Dialogue: 0,0:50:27.73,0:50:28.40,Default,,0,0,0,,Уф!
Dialogue: 0,0:50:40.87,0:50:42.12,Default,,0,0,0,,Гүлге ұмтылу!
Dialogue: 0,0:50:43.41,0:50:46.00,Default,,0,0,0,,Сіз алынған деректерді қайтаруға әрекеттеніп жатырсыз ба?
Dialogue: 0,0:50:48.29,0:50:50.29,Default,,0,0,0,,Қайтарыңыз... (Дороти) А...?
Dialogue: 0,0:50:52.84,0:50:53.75,Default,,0,0,0,,Анашым!
Dialogue: 0,0:50:54.46,0:50:56.59,Default,,0,0,0,,Әке... Әпке?
Dialogue: 0,0:50:57.47,0:50:58.34,Default,,0,0,0,,Дороти
Dialogue: 0,0:50:58.88,0:51:00.14,Default,,0,0,0,,Дороти
Dialogue: 0,0:51:00.76,0:51:01.51,Default,,0,0,0,,Леви…
Dialogue: 0,0:51:01.76,0:51:03.76,Default,,0,0,0,,Бізге қайтарыңыз!
Dialogue: 0,0:51:04.35,0:51:05.10,Default,,0,0,0,,Уф!
Dialogue: 0,0:51:06.27,0:51:07.18,Default,,0,0,0,,Уф
Dialogue: 0,0:51:07.43,0:51:08.77,Default,,0,0,0,,Әй, қос!
Dialogue: 0,0:51:13.27,0:51:14.23,Default,,0,0,0,,Күлгін…
Dialogue: 0,0:51:15.94,0:51:17.28,Default,,0,0,0,,Қос!
Dialogue: 0,0:51:22.20,0:51:22.91,Default,,0,0,0,,Ах!
Dialogue: 0,0:51:23.16,0:51:27.25,Default,,0,0,0,,О, жоқ!
Dialogue: 0,0:51:30.00,0:51:30.96,Default,,0,0,0,,Ремо!
Dialogue: 0,0:51:41.97,0:51:43.60,Default,,0,0,0,,Эй, шегіргүлдер де?
Dialogue: 0,0:51:43.85,0:51:45.97,Default,,0,0,0,,Данияр да хехехехе
Dialogue: 0,0:51:49.64,0:51:50.31,Default,,0,0,0,,Диана
Dialogue: 0,0:51:50.64,0:51:52.98,Default,,0,0,0,,Анам менің Даниярға ұқсайтынымды айтты.
Dialogue: 0,0:51:53.23,0:51:53.94,Default,,0,0,0,,Әжеміздің бір ескі танысы шығар. Ах, дұрыс.
Dialogue: 0,0:52:07.99,0:52:08.95,Default,,0,0,0,,(Гильда) Бірден көп жеме – аздап-аздап же.
Dialogue: 0,0:52:09.25,0:52:11.16,Default,,0,0,0,,Көрдім Жаңалықты көрдім
Dialogue: 0,0:52:11.71,0:52:13.33,Default,,0,0,0,,Атам ұялып қалды.
Dialogue: 0,0:52:13.79,0:52:15.13,Default,,0,0,0,,Сіз ұятқа қалдыңыз.
Dialogue: 0,0:52:17.88,0:52:20.34,Default,,0,0,0,,Бұл доктор Дэниел Доусонмен баспасөз мәслихаты болды.
Dialogue: 0,0:52:20.55,0:52:24.01,Default,,0,0,0,,Бұл дәрігердің әйелінің атымен аталатын революциялық ОЖ.
Dialogue: 0,0:52:24.39,0:52:28.47,Default,,0,0,0,,Дүние жүзіне әйгілі пианистің жарының тілегі де қамтылса керек.
Dialogue: 0,0:52:32.98,0:52:37.02,Default,,0,0,0,,Хмм, қазір күн жылып барады.
Dialogue: 0,0:52:37.36,0:52:38.02,Default,,0,0,0,,Иә
Dialogue: 0,0:52:40.86,0:52:42.86,Default,,0,0,0,,Шашыңызды жинап көріңіз.
Dialogue: 0,0:52:51.33,0:52:53.00,Default,,0,0,0,,Сіз өте қысқа екенсіз.
Dialogue: 0,0:52:53.37,0:52:56.38,Default,,0,0,0,,Дуал мен кішкентай кезімнен солай болды, солай ма?
Dialogue: 0,0:52:58.71,0:53:00.21,Default,,0,0,0,,Мен келесі жолы конкурсқа қатысамын.
Dialogue: 0,0:53:00.59,0:53:02.92,Default,,0,0,0,,Ұстаз бүкіл елге мақсат қоя аламыз деді.
Dialogue: 0,0:53:03.38,0:53:04.13,Default,,0,0,0,,Иә
Dialogue: 0,0:53:04.68,0:53:06.93,Default,,0,0,0,,Мен одан да жақсырақ болғым келеді.
Dialogue: 0,0:53:07.39,0:53:11.56,Default,,0,0,0,,Мен дүние жүзіндегі адамдар бір күні менің фортепианомды естігенін қалаймын.
Dialogue: 0,0:53:13.48,0:53:18.23,Default,,0,0,0,,Сумире өз болашағын өз қалауымен шешеді, солай ма?
Dialogue: 0,0:53:18.86,0:53:21.19,Default,,0,0,0,,Түс көру деген осы.
Dialogue: 0,0:53:21.82,0:53:22.99,Default,,0,0,0,,Қосарлы, солай ма?
Dialogue: 0,0:53:23.45,0:53:24.20,Default,,0,0,0,,Ах!
Dialogue: 0,0:53:24.49,0:53:26.78,Default,,0,0,0,,Маған бірге көмектесіңдер.
Dialogue: 0,0:53:27.41,0:53:28.41,Default,,0,0,0,,үшінн қорғаңыз
Dialogue: 0,0:53:28.95,0:53:29.66,Default,,0,0,0,,Ха!
Dialogue: 0,0:53:34.08,0:53:34.96,Default,,0,0,0,,Күлгін
Dialogue: 0,0:53:35.79,0:53:38.08,Default,,0,0,0,,Бағдарламаны қайта іске қосу Жаңартуды бастау
Dialogue: 0,0:53:39.13,0:53:39.96,Default,,0,0,0,,Vaios!
Dialogue: 0,0:53:47.47,0:53:49.30,Default,,0,0,0,,Ой, Дороти!
Dialogue: 0,0:53:49.93,0:53:50.97,Default,,0,0,0,,Жетеді
Dialogue: 0,0:53:51.43,0:53:52.81,Default,,0,0,0,,Аузыңды жап!
Dialogue: 0,0:53:55.10,0:53:57.94,Default,,0,0,0,,Екеуің неге сонда тұрып, аң-таң болып қарап тұрсыңдар?
Dialogue: 0,0:54:03.86,0:54:05.11,Default,,0,0,0,,Ха, ха, ха!
Dialogue: 0,0:54:05.45,0:54:06.20,Default,,0,0,0,,Ей!
Dialogue: 0,0:54:13.62,0:54:14.45,Default,,0,0,0,,Каранэс ауданына оралу.
Dialogue: 0,0:54:15.00,0:54:15.87,Default,,0,0,0,,Қос!
Dialogue: 0,0:54:16.67,0:54:17.75,Default,,0,0,0,,Уау~
Dialogue: 0,0:54:19.46,0:54:20.17,Default,,0,0,0,,Кеттік
Dialogue: 0,0:54:25.84,0:54:27.18,Default,,0,0,0,,Баршаңыз да сапарыңызды жалғастырғанда абай болыңыздар
Dialogue: 0,0:54:28.84,0:54:31.14,Default,,0,0,0,,Нұсқаның қалай жаңартылғаны таңқаларлық.
Dialogue: 0,0:54:31.39,0:54:33.31,Default,,0,0,0,,Жоқ, ол біршама төмендеді.
Dialogue: 0,0:54:33.81,0:54:36.77,Default,,0,0,0,,Өтірік? Бұл ең жақсысы
Dialogue: 0,0:54:44.32,0:54:46.49,Default,,0,0,0,,Міне, біз кімбіз
Dialogue: 0,0:54:46.90,0:54:49.45,Default,,0,0,0,,Ана жаңарту файлына дейінгі нұсқа қосылған
Dialogue: 0,0:54:49.57,0:54:52.87,Default,,0,0,0,,Сіз сол жерге жаңа ғана оралдыңыз ба? Осылай болды ма?
Dialogue: 0,0:54:53.66,0:54:58.83,Default,,0,0,0,,Күлгіндер туралы естеліктер, ойлар... толыққанды су астында қалды.
Dialogue: 0,0:55:03.84,0:55:05.38,Default,,0,0,0,,Виолеттің ойлары?
Dialogue: 0,0:55:06.55,0:55:07.92,Default,,0,0,0,,Бала жақсы ма?
Dialogue: 0,0:55:08.72,0:55:09.43,Default,,0,0,0,,Иә
Dialogue: 0,0:55:11.59,0:55:12.85,Default,,0,0,0,,Жақсы
Dialogue: 0,0:55:14.10,0:55:14.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:55:14.93,0:55:15.72,Default,,0,0,0,,Қашықтан басқару пульті
Dialogue: 0,0:55:16.35,0:55:17.23,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:55:17.85,0:55:20.44,Default,,0,0,0,,Мен үшеуміздің мәңгі бірге болғанымызды қаладым
Dialogue: 0,0:55:20.98,0:55:23.61,Default,,0,0,0,,Иә, үшеуміз біргеміз.
Dialogue: 0,0:55:24.32,0:55:25.23,Default,,0,0,0,,Үй ойынынан біраз жалығып кеттім ғой, иә?
Dialogue: 0,0:55:28.03,0:55:33.07,Default,,0,0,0,,(Бағдарламаны іске қосу дыбысы)
Dialogue: 0,0:55:35.24,0:55:36.12,Default,,0,0,0,,Неге...
Dialogue: 0,0:55:39.16,0:55:40.04,Default,,0,0,0,,Дене...
Dialogue: 0,0:55:42.75,0:55:44.63,Default,,0,0,0,,Күлгін Бұл не?
Dialogue: 0,0:55:46.59,0:55:47.88,Default,,0,0,0,,Мәжбүрлеп пішімдеу
Dialogue: 0,0:55:48.05,0:55:48.76,Default,,0,0,0,,Ха...
Dialogue: 0,0:55:48.97,0:55:50.01,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:55:50.88,0:55:54.05,Default,,0,0,0,,Анаң қатені қайтаруыңды күтті.
Dialogue: 0,0:56:01.73,0:56:03.02,Default,,0,0,0,,Дуаль және Дороти
Dialogue: 0,0:56:03.77,0:56:07.44,Default,,0,0,0,,Екі бағдарлама енді ананың бақылауында болмаса...
Dialogue: 0,0:56:08.32,0:56:10.53,Default,,0,0,0,,Бұл білім сандығы тасталған.
Dialogue: 0,0:56:11.11,0:56:11.95,Default,,0,0,0,,Қашықтан…
Dialogue: 0,0:56:12.49,0:56:13.74,Default,,0,0,0,,Неліктен олай істедің?
Dialogue: 0,0:56:14.41,0:56:17.70,Default,,0,0,0,,Ана сіздің эвристикалық қозғалтқышыңыз
Dialogue: 0,0:56:18.24,0:56:21.29,Default,,0,0,0,,Адамның соңғы еркі ретінде маған қауіп төнгенін сезіндім.
Dialogue: 0,0:56:26.42,0:56:27.34,Default,,0,0,0,,Әже
Dialogue: 0,0:56:28.17,0:56:28.96,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:56:29.92,0:56:31.22,Default,,0,0,0,,Мен білмедім
Dialogue: 0,0:56:38.64,0:56:40.43,Default,,0,0,0,,Сіздің атыңыз бар
Dialogue: 0,0:56:41.48,0:56:42.19,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:56:42.44,0:56:43.60,Default,,0,0,0,,Бұл анық емес
Dialogue: 0,0:56:43.81,0:56:45.02,Default,,0,0,0,,Жақсы
Dialogue: 0,0:56:47.19,0:56:48.11,Default,,0,0,0,,Әже
Dialogue: 0,0:56:49.23,0:56:51.61,Default,,0,0,0,,Менің қорғағым келетін нәрсем бар.
Dialogue: 0,0:56:52.95,0:56:55.91,Default,,0,0,0,,Бірақ мен не істей алатынымды білмеймін.
Dialogue: 0,0:56:56.49,0:56:57.24,Default,,0,0,0,,Қашықтан басқару пульті
Dialogue: 0,0:56:58.49,0:57:00.04,Default,,0,0,0,,Мұны тек сіз жасай аласыз
Dialogue: 0,0:57:00.33,0:57:01.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:57:01.91,0:57:03.41,Default,,0,0,0,,Анаңнан сұра
Dialogue: 0,0:57:04.67,0:57:05.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:57:06.58,0:57:07.29,Default,,0,0,0,,Уау
Dialogue: 0,0:57:08.00,0:57:09.13,Default,,0,0,0,,Уау
Dialogue: 0,0:57:10.34,0:57:11.05,Default,,0,0,0,,Иә
Dialogue: 0,0:57:12.01,0:57:13.80,Default,,0,0,0,,Адамдар Ананы өшірді, солай ма?
Dialogue: 0,0:57:14.18,0:57:16.22,Default,,0,0,0,,Неліктен тек команда ғана тірі?
Dialogue: 0,0:57:16.64,0:57:17.76,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:57:18.10,0:57:18.76,Default,,0,0,0,,Ах
Dialogue: 0,0:57:19.47,0:57:21.14,Default,,0,0,0,,Remo Неліктен?
Dialogue: 0,0:57:22.02,0:57:23.69,Default,,0,0,0,,Хехе, рахмет.
Dialogue: 0,0:57:24.31,0:57:25.65,Default,,0,0,0,,Неге олай дейсің?
Dialogue: 0,0:57:25.90,0:57:29.44,Default,,0,0,0,,Сіз темірмен қапталған екі антивируссыз.
Dialogue: 0,0:57:29.98,0:57:31.48,Default,,0,0,0,,Ол Вайостың бөлігі болды.
Dialogue: 0,0:57:31.78,0:57:33.03,Default,,0,0,0,,Мен Сумиреден сұрадым
Dialogue: 0,0:57:33.19,0:57:34.24,Default,,0,0,0,,Айтыңыз
Dialogue: 0,0:57:34.40,0:57:36.74,Default,,0,0,0,,Me too Vios негізгі бағдарламасы
Dialogue: 0,0:57:36.99,0:57:38.37,Default,,0,0,0,,Олар дос болды.
Dialogue: 0,0:57:38.66,0:57:40.99,Default,,0,0,0,,Ал анам маған-
Dialogue: 0,0:57:41.12,0:57:44.41,Default,,0,0,0,,Сіз маған алгоритмдеріңізді қайта жазуға рұқсат бердіңіз.
Dialogue: 0,0:57:45.21,0:57:46.54,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:57:47.38,0:57:50.63,Default,,0,0,0,,Пішімдеу бағдарламасы қашықтан басқару пультінде...
Dialogue: 0,0:57:51.17,0:57:54.22,Default,,0,0,0,,Анамның маған салған тұзағы.
Dialogue: 0,0:57:54.72,0:57:55.93,Default,,0,0,0,,Вирустық реакция
Dialogue: 0,0:57:57.34,0:57:58.64,Default,,0,0,0,,Маған ұнамайды!
Dialogue: 0,0:57:58.89,0:58:00.39,Default,,0,0,0,,Неге!
Dialogue: 0,0:58:00.60,0:58:02.39,Default,,0,0,0,,Қос! Не істеу керек?
Dialogue: 0,0:58:02.77,0:58:04.02,Default,,0,0,0,,Мен қашықтан басқару пультін өшіремін.
Dialogue: 0,0:58:04.18,0:58:05.19,Default,,0,0,0,,Күлгін!
Dialogue: 0,0:58:06.10,0:58:09.98,Default,,0,0,0,,Римо бақытты, өйткені оның қорғағысы келетін нәрсесі бар.
Dialogue: 0,0:58:10.40,0:58:11.48,Default,,0,0,0,,Қосарлы
Dialogue: 0,0:58:11.69,0:58:15.24,Default,,0,0,0,,Мәжбүрлі формат Dual, Дороти және маған...
Dialogue: 0,0:58:15.57,0:58:19.16,Default,,0,0,0,,Екінші деңгейдегі барлық адамдарды да өшіріңіз.
Dialogue: 0,0:58:19.62,0:58:22.87,Default,,0,0,0,,Жақсы, жақсы, бәріміз жоғалып кетуіміз керек.
Dialogue: 0,0:58:22.99,0:58:25.21,Default,,0,0,0,,Бұл үшін сені кешіремін деп ойлайсың ба?
Dialogue: 0,0:58:25.37,0:58:27.87,Default,,0,0,0,,Жақсы, жақсы, мені кешір!
Dialogue: 0,0:58:28.08,0:58:29.29,Default,,0,0,0,,Һм? Не болды?
Dialogue: 0,0:58:33.88,0:58:34.96,Default,,0,0,0,,Бұл тек кішігірім жауынгерлерге ғана тиімді. Тастайық.
Dialogue: 0,0:58:36.47,0:58:37.38,Default,,0,0,0,,Сол жігіт мүлде есінен танып кетті – адамдар оны ұстап тұруға мәжбүр болды.
Dialogue: 0,0:58:38.68,0:58:41.80,Default,,0,0,0,,Мен шынымен қорғағым келетін адамдар бар.
Dialogue: 0,0:58:42.68,0:58:44.06,Default,,0,0,0,,Құрметті досым.
Dialogue: 0,0:58:44.39,0:58:45.06,Default,,0,0,0,,Иә
Dialogue: 0,0:58:46.10,0:58:48.60,Default,,0,0,0,,Жақсы, сен жалғыз емессің.
Dialogue: 0,0:58:49.73,0:58:50.56,Default,,0,0,0,,Лимон
Dialogue: 0,0:58:54.28,0:58:56.53,Default,,0,0,0,,Сіз антивирустық бағдарламасыз ба?
Dialogue: 0,0:58:57.40,0:59:00.07,Default,,0,0,0,,Мен вируспын
Dialogue: 0,0:59:02.74,0:59:03.87,Default,,0,0,0,,Мені жою-
Dialogue: 0,0:59:04.58,0:59:07.25,Default,,0,0,0,,Әлемді қорғаңыз... әркім.
Dialogue: 0,0:59:08.00,0:59:09.50,Default,,0,0,0,,Біз оны бірге қорғаймыз.
Dialogue: 0,0:59:10.29,0:59:11.25,Default,,0,0,0,,Сен сияқты — олардың әрқайсысы.
Dialogue: 0,0:59:12.09,0:59:13.21,Default,,0,0,0,,Уәде
Dialogue: 0,0:59:13.84,0:59:14.63,Default,,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:59:19.80,0:59:20.80,Default,,0,0,0,,Тек қарап тұр.
Dialogue: 0,0:59:22.85,0:59:23.68,Default,,0,0,0,,Дороти
Dialogue: 0,0:59:30.94,0:59:34.27,Default,,0,0,0,,Сенімен болған қызық болды, Лимузы.
Dialogue: 0,0:59:35.07,0:59:36.03,Default,,0,0,0,,Мен де
Dialogue: 0,0:59:40.07,0:59:42.49,Default,,0,0,0,,Маған тамақ дайындауды үйреткеніңіз үшін рахмет.
Dialogue: 0,0:59:42.66,0:59:43.32,Default,,0,0,0,,Иә
Dialogue: 0,0:59:43.45,0:59:44.62,Default,,0,0,0,,Бұршақ қаптары да
Dialogue: 0,0:59:45.20,0:59:46.79,Default,,0,0,0,,Мен келесі жолы жеңілмеймін
Dialogue: 0,0:59:48.04,0:59:50.21,Default,,0,0,0,,Тазалағаныңыз үшін рахмет.
Dialogue: 0,0:59:51.87,0:59:52.67,Default,,0,0,0,,Бұл субтитрлер JOJO's Bizarre Adventure форумы, Yuhari Subtitles және Gods Subtitles тобы дайындады
Dialogue: 0,0:59:54.79,0:59:56.92,Default,,0,0,0,,Рахмет сізге Ремо
Dialogue: 0,1:00:00.84,1:00:03.34,Default,,0,0,0,,Уф...
Dialogue: 0,1:00:04.51,1:00:07.10,Default,,0,0,0,,Екеуің неге сонда тұрып, аң-таң болып қарап тұрсыңдар?
Dialogue: 0,1:00:07.47,1:00:11.52,Default,,0,0,0,,Уф...
Dialogue: 0,1:00:25.49,1:00:26.70,Default,,0,0,0,,Ол сынған.
Dialogue: 0,1:00:27.62,1:00:28.33,Default,,0,0,0,,Иә
Dialogue: 0,1:00:29.54,1:00:30.75,Default,,0,0,0,,Бұл көңілді болды.
Dialogue: 0,1:00:31.50,1:00:32.29,Default,,0,0,0,,Иә
Dialogue: 0,1:00:34.54,1:00:35.71,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,1:00:39.67,1:00:43.13,Default,,0,0,0,,Мен Ремоның үйіне бара алатын жерін қорғағым келеді.
Dialogue: 0,1:00:43.72,1:00:46.18,Default,,0,0,0,,Мұнда тұратын халықтың болашағын көре білу
Dialogue: 0,1:00:46.89,1:00:49.52,Default,,0,0,0,,Бұл жақсы емес пе? Мен де саған қосыламын
Dialogue: 0,1:00:49.89,1:00:50.60,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,1:00:50.81,1:00:52.85,Default,,0,0,0,,Бұл анық, иә?
Dialogue: 0,1:00:53.52,1:00:55.15,Default,,0,0,0,,Мен де үйімді қайта салуым керек.
Dialogue: 0,1:00:55.61,1:00:56.36,Default,,0,0,0,,Иә
Dialogue: 0,1:00:57.36,1:00:59.40,Default,,0,0,0,,Ас үйді 3 адам пайдалана алады
Dialogue: 0,1:01:00.11,1:01:00.82,Default,,0,0,0,,Иә
Dialogue: 0,1:01:00.99,1:01:04.36,Default,,0,0,0,,Оны кеңінен таратайық, өйткені Ремо тазалауды жақсы көреді.
Dialogue: 0,1:01:05.24,1:01:06.82,Default,,0,0,0,,Сол бала бақытты болады.
Dialogue: 0,1:01:07.41,1:01:08.20,Default,,0,0,0,,Мүлдем!
Dialogue: 0,1:01:08.41,1:01:09.20,Default,,0,0,0,,Ах...
Dialogue: 0,1:01:09.99,1:01:12.21,Default,,0,0,0,,Түс көру деген осы.
Dialogue: 0,1:01:13.41,1:01:14.12,Default,,0,0,0,,Егер өзіңді жақсы ұстасаң, мен саған зиян тигізбеймін.
Dialogue: 0,1:01:14.83,1:01:17.38,Default,,0,0,0,,Лимузы бұл саған жақсы көрінеді деді.
Dialogue: 0,1:01:22.30,1:01:25.80,Default,,0,0,0,,Мүмкін біз Жерге керек емеспіз.
Dialogue: 0,1:01:26.22,1:01:30.89,Default,,0,0,0,,Жоқ, адамзаттың жойылуы доктор Доусонның шынайы ниеті емес.
Dialogue: 0,1:01:31.35,1:01:32.81,Default,,0,0,0,,Бұл менің соңғы үмітім.
Dialogue: 0,1:01:33.35,1:01:34.06,Default,,0,0,0,,О
Dialogue: 0,1:01:35.56,1:01:36.48,Default,,0,0,0,,Vaios
Dialogue: 0,1:01:38.61,1:01:45.53,Default,,0,0,0,,(«Арман бүршігі» қос ызылдаған)
Dialogue: 0,1:01:50.24,1:01:55.25,Default,,0,0,0,,♪〝Арман бүршігі〞
Dialogue: 0,1:02:08.47,1:02:12.31,Default,,0,0,0,,♪ Желмен теңселіп тұрды
Dialogue: 0,1:02:12.43,1:02:16.35,Default,,0,0,0,,♪ Кішкентай гүлге
Dialogue: 0,1:02:16.48,1:02:23.44,Default,,0,0,0,,♪ Мен кенет сені ойладым.
Dialogue: 0,1:02:24.32,1:02:28.28,Default,,0,0,0,,♪ Бұл ностальгия
Dialogue: 0,1:02:28.41,1:02:32.29,Default,,0,0,0,,♪ Жадтың бетбелгісі
Dialogue: 0,1:02:32.41,1:02:39.38,Default,,0,0,0,,♪ Мен бұрыннан білетін иіс
Dialogue: 0,1:02:44.42,1:02:48.22,Default,,0,0,0,,♪ Мен сені қазір, қазір сеземін
Dialogue: 0,1:02:48.34,1:02:52.22,Default,,0,0,0,,♪ Сол жүрек
Dialogue: 0,1:02:52.35,1:02:56.06,Default,,0,0,0,,♪ Мен сенің жаныңда жүргендеймін
Dialogue: 0,1:02:56.18,1:03:00.31,Default,,0,0,0,,♪ Бозғылт жылу
Dialogue: 0,1:03:00.44,1:03:04.32,Default,,0,0,0,,♪ Уақыт өте келе
Dialogue: 0,1:03:04.44,1:03:08.32,Default,,0,0,0,,♪ Бұзба
Dialogue: 0,1:03:08.45,1:03:15.41,Default,,0,0,0,,♪ Мен оны кеудеме жайлап қойдым
Dialogue: 0,1:03:20.46,1:03:24.34,Default,,0,0,0,,♪ Белгілі бір уақыттан бері
Dialogue: 0,1:03:24.46,1:03:28.34,Default,,0,0,0,,♪ Жарық келеді
Dialogue: 0,1:03:28.47,1:03:35.43,Default,,0,0,0,,♪ Жұлдызға тілеу, шашу
Dialogue: 0,1:03:36.43,1:03:40.31,Default,,0,0,0,,♪ «Ертең кездескенше».
Dialogue: 0,1:03:40.44,1:03:44.36,Default,,0,0,0,,♪ Мен уәде бердім
Dialogue: 0,1:03:44.48,1:03:51.45,Default,,0,0,0,,♪ Міне, біздің жерде
Dialogue: 0,1:03:56.45,1:04:00.37,Default,,0,0,0,,♪ Иә, қазір сенемін.
Dialogue: 0,1:04:00.50,1:04:04.34,Default,,0,0,0,,♪ Бұл бүкіл әлем
Dialogue: 0,1:04:04.46,1:04:08.09,Default,,0,0,0,,♪ Толқыған сезімдер
Dialogue: 0,1:04:08.21,1:04:12.34,Default,,0,0,0,,♪ Тек бір
Dialogue: 0,1:04:12.47,1:04:16.35,Default,,0,0,0,,♪ Байланысқан шоқжұлдыздар сияқты
Dialogue: 0,1:04:16.47,1:04:20.35,Default,,0,0,0,,♪ Қол ұстасақ
Dialogue: 0,1:04:20.48,1:04:27.40,Default,,0,0,0,,♪ Түстің пішінін түрттім
Dialogue: 0,1:04:30.40,1:04:36.78,Default,,0,0,0,,♪ Бүршік сияқты
Dialogue: 0,1:04:38.45,1:04:44.63,Default,,0,0,0,,♪ Сен күлдің
Dialogue: 0,1:04:44.96,1:04:48.09,Default,,0,0,0,,♪ Каджикаму-
Dialogue: 0,1:04:48.46,1:04:52.17,Default,,0,0,0,,♪ Саусағыңыздың ұшында
Dialogue: 0,1:04:52.93,1:04:58.60,Default,,0,0,0,,♪ Сол әуенді жеткізіңіз
Dialogue: 0,1:04:58.72,1:05:04.73,Default,,0,0,0,,♪ Бізге қарай ағып жатыр
Dialogue: 0,1:05:06.48,1:05:10.11,Default,,0,0,0,,♪ Мен сені қорғағым келеді... Мен солай ойладым.
Dialogue: 0,1:05:10.48,1:05:15.91,Default,,0,0,0,,♪ Шын жүректен
Dialogue: 0,1:05:18.45,1:05:22.20,Default,,0,0,0,,♪ Сондықтан мен оны қазір сезінемін
Dialogue: 0,1:05:22.46,1:05:26.00,Default,,0,0,0,,♪ Бұл бүкіл әлем
Dialogue: 0,1:05:26.46,1:05:30.13,Default,,0,0,0,,♪ Толқыған сезімдер
Dialogue: 0,1:05:30.30,1:05:34.26,Default,,0,0,0,,♪ Тек бір рет
Dialogue: 0,1:05:34.51,1:05:38.05,Default,,0,0,0,,♪ Байланысқан кездесу сияқты
Dialogue: 0,1:05:38.47,1:05:42.06,Default,,0,0,0,,♪ Қол ұстасып тұрсақ
Dialogue: 0,1:05:42.52,1:05:49.36,Default,,0,0,0,,♪ Мен арманымның пішінін таптым
Dialogue: 0,1:05:50.48,1:05:53.90,Default,,0,0,0,,♪ Арман бүршігі
Dialogue: 0,1:05:54.24,1:05:58.49,Default,,0,0,0,,♪ Мен таптым
Dialogue: 0,1:06:05.21,1:06:10.21,Default,,0,0,0,,～♪
Dialogue: 0,1:06:12.17,1:06:19.14,Default,,0,0,0,,(Ремоның ызылдаған «Арман бүршігі»)
Dialogue: 0,1:06:22.52,1:06:25.10,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,1:06:26.60,1:06:32.60,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
