Dialogue: 0,0:10:09.56,0:10:12.35,Default,,0,0,0,,Дәл тимеді!
Dialogue: 0,0:10:13.35,0:10:16.73,Default,,0,0,0,,«Гардарик және—»
Dialogue: 0,0:10:16.86,0:10:18.44,Default,,0,0,0,,Виолет-чан
Dialogue: 0,0:10:20.28,0:10:22.40,Default,,0,0,0,,«Лейденшафтлих екі мемлекеті—»
Dialogue: 0,0:10:22.53,0:10:25.91,Default,,0,0,0,,«Халықаралық бейбітшілік пен қауіпсіздікті сақтау мақсатында—»
