Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:19.89,0:00:21.64,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:00:22.60,0:00:23.93,Default,,0,0,0,,Әзірге үш минут
Dialogue: 0,0:00:24.06,0:00:24.89,Default,,0,0,0,,Әй!
Dialogue: 0,0:00:30.02,0:00:32.06,Default,,0,0,0,,Мен тастап кеткен құралдар—
Dialogue: 0,0:00:32.19,0:00:34.27,Default,,0,0,0,,Гилберттің итіне айналды
Dialogue: 0,0:00:35.07,0:00:38.86,Default,,0,0,0,,Бірақ екі қолымды да, иемді де жоғалтқаннан кейін—
Dialogue: 0,0:00:38.99,0:00:41.03,Default,,0,0,0,,Барлығын жоғалтқаннан кейін, ең соңында—
Dialogue: 0,0:00:42.45,0:00:44.41,Default,,0,0,0,,Білмедім неге, мен сол жерде тұрдым
Dialogue: 0,0:00:44.41,0:00:46.25,Default,,0,0,0,,(Виолет) Хаа, хаа… Білмедім неге, мен сол жерде тұрдым
Dialogue: 0,0:00:46.25,0:00:46.75,Default,,0,0,0,,Білмедім неге, мен сол жерде тұрдым
Dialogue: 0,0:00:53.13,0:00:54.34,Default,,0,0,0,,(Журналдың таусылып бара жатқан дыбысы)
Dialogue: 0,0:01:02.34,0:01:03.35,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:04.68,0:01:05.97,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:07.81,0:01:09.77,Default,,0,0,0,,Увааах! Оох…
Dialogue: 0,0:01:09.89,0:01:11.06,Default,,0,0,0,,Ха!
Dialogue: 0,0:01:25.37,0:01:26.29,Default,,0,0,0,,Ha
Dialogue: 0,0:01:26.49,0:01:27.70,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:34.21,0:01:35.96,Default,,0,0,0,,Рахмет
Dialogue: 0,0:01:40.76,0:01:41.47,Default,,0,0,0,,Ha
Dialogue: 0,0:01:45.72,0:01:46.81,Default,,0,0,0,,Сен тым наивсің.
Dialogue: 0,0:01:48.14,0:01:49.85,Default,,0,0,0,,Уақыт таусылды.
Dialogue: 0,0:01:50.35,0:01:53.85,Default,,0,0,0,,Егер мені бірден өлтіргенде, уақытында жете алар едің.
Dialogue: 0,0:01:53.98,0:01:56.94,Default,,0,0,0,,Ха! Бомба ма?
Dialogue: 0,0:01:57.27,0:01:59.99,Default,,0,0,0,,Тіркелмеген Арнайы Сынып па?
Dialogue: 0,0:02:00.82,0:02:02.91,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:02:03.03,0:02:05.53,Default,,0,0,0,,Төтенше тоқтау! Жүгір!
Dialogue: 0,0:02:08.08,0:02:09.12,Default,,0,0,0,,Жұмыс істемей жатыр!
Dialogue: 0,0:02:09.75,0:02:11.00,Default,,0,0,0,,Вагон тежегішті басады!
Dialogue: 0,0:02:11.46,0:02:12.54,Default,,0,0,0,,Төтенше тежегіш!
Dialogue: 0,0:02:22.47,0:02:23.80,Default,,0,0,0,,Керісінше, қанша адам қарғысқа ұшырап өлетінін болжау мүмкін емес.
Dialogue: 0,0:02:23.93,0:02:25.59,Default,,0,0,0,,Ах! Бұл не?
Dialogue: 0,0:02:37.73,0:02:38.73,Default,,0,0,0,,Жылдамдық көрсетілмеген.
Dialogue: 0,0:02:48.28,0:02:49.45,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:50.33,0:02:51.83,Default,,0,0,0,,Жылдамдық көрсетілмеген.
Dialogue: 0,0:02:51.95,0:02:53.50,Default,,0,0,0,,Екінші бомба!
Dialogue: 0,0:02:53.62,0:02:54.54,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:02:56.17,0:02:58.75,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:03:03.01,0:03:03.88,Default,,0,0,0,,Дәл тимеді!
Dialogue: 0,0:03:09.51,0:03:10.35,Default,,0,0,0,,Жылдамдық көрсетілмеген.
Dialogue: 0,0:03:11.43,0:03:12.98,Default,,0,0,0,,(Пойыз ысқырығы)
Dialogue: 0,0:03:13.10,0:03:13.93,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:03:18.48,0:03:19.11,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:21.53,0:03:22.90,Default,,0,0,0,,Уф!
Dialogue: 0,0:03:29.49,0:03:30.74,Default,,0,0,0,,Бүгінгі жағдайда ол профессор Годжо немесе сондай біреу болар еді.
Dialogue: 0,0:03:32.08,0:03:33.91,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:38.25,0:03:43.96,Default,,0,0,0,,Бүгінгі жағдайда ол профессор Годжо немесе сондай біреу болар еді.
Dialogue: 0,0:03:44.09,0:03:45.22,Default,,0,0,0,,Уф!
Dialogue: 0,0:04:04.11,0:04:05.11,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:17.91,0:04:19.50,Default,,0,0,0,,Жылдамдық көрсетілмеген.
Dialogue: 0,0:04:28.76,0:04:29.89,Default,,0,0,0,,«Гардарик және—»
Dialogue: 0,0:04:30.34,0:04:32.43,Default,,0,0,0,,«Лейденшафтлих екі мемлекеті—»
Dialogue: 0,0:04:32.55,0:04:35.31,Default,,0,0,0,,«Халықаралық бейбітшілік пен қауіпсіздікті сақтау мақсатында—»
Dialogue: 0,0:04:35.43,0:04:37.93,Default,,0,0,0,,«Егеменді және тең серіктестер ретінде—»
Dialogue: 0,0:04:38.06,0:04:39.39,Default,,0,0,0,,«Бір-бірімен ынтымақтастық жасайды»
Dialogue: 0,0:04:41.23,0:04:45.19,Default,,0,0,0,,«Осы мақсатта біз әділ сауданы дереу қайта жаңғыртамыз—»
Dialogue: 0,0:04:45.32,0:04:48.40,Default,,0,0,0,,«Және достық белгісі ретінде Лейденшафтихих—»
Dialogue: 0,0:04:48.53,0:04:51.82,Default,,0,0,0,,«бір жылдық төтенше көмек заттарын қамтамасыз етеді»
Dialogue: 0,0:04:53.53,0:04:58.33,Default,,0,0,0,,«Осылайша біз екі ел арасындағы осы бейбіт келісімшартқа қол қоюға уәде береміз»
Dialogue: 0,0:04:59.50,0:05:01.38,Default,,0,0,0,,(азаматтардың қошемет шапалақтары)
Dialogue: 0,0:05:01.50,0:05:02.92,Default,,0,0,0,,Бітті
Dialogue: 0,0:05:03.04,0:05:04.29,Default,,0,0,0,,О
Dialogue: 0,0:05:06.46,0:05:07.46,Default,,0,0,0,,Не болды?
Dialogue: 0,0:05:09.97,0:05:11.59,Default,,0,0,0,,Бітсе де…
Dialogue: 0,0:05:13.43,0:05:14.64,Default,,0,0,0,,Бітсе де…
Dialogue: 0,0:05:15.35,0:05:20.02,Default,,0,0,0,,Соғыс бітсе де, ұлым үйге оралмайды
Dialogue: 0,0:05:20.73,0:05:25.02,Default,,0,0,0,,Мен тастап кеткен құралдар—
Dialogue: 0,0:05:26.86,0:05:28.15,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:05:29.11,0:05:30.61,Default,,0,0,0,,О, демек, сен бұл туралы ашық айтып отырсың ғой.
Dialogue: 0,0:05:31.99,0:05:34.70,Default,,0,0,0,,Гилберттің итіне айналды
Dialogue: 0,0:05:39.08,0:05:41.71,Default,,0,0,0,,Бірақ екі қолымды да, иемді де жоғалтқаннан кейін—
Dialogue: 0,0:05:42.92,0:05:48.30,Default,,0,0,0,,Барлығын жоғалтқаннан кейін, ең соңында—
Dialogue: 0,0:05:51.13,0:05:52.47,Default,,0,0,0,,Иә
Dialogue: 0,0:05:53.68,0:05:55.26,Default,,0,0,0,,Білмедім неге, мен сол жерде тұрдым
Dialogue: 0,0:05:55.39,0:05:57.72,Default,,0,0,0,,(Виолет) Хаа, хаа… Білмедім неге, мен сол жерде тұрдым
Dialogue: 0,0:05:58.35,0:06:02.19,Default,,0,0,0,,Білмедім неге, мен сол жерде тұрдым
Dialogue: 0,0:06:03.65,0:06:07.27,Default,,0,0,0,,(Журналдың таусылып бара жатқан дыбысы)
Dialogue: 0,0:06:08.44,0:06:10.11,Default,,0,0,0,,Увааах! Оох…
Dialogue: 0,0:06:12.53,0:06:13.53,Default,,0,0,0,,Уау
Dialogue: 0,0:06:14.36,0:06:17.87,Default,,0,0,0,,Сен тым наивсің.
Dialogue: 0,0:06:18.74,0:06:22.12,Default,,0,0,0,,Уақыт таусылды.
Dialogue: 0,0:06:22.50,0:06:24.92,Default,,0,0,0,,Егер мені бірден өлтіргенде, уақытында жете алар едің.
Dialogue: 0,0:06:26.38,0:06:28.55,Default,,0,0,0,,Ха! Бомба ма?
Dialogue: 0,0:06:30.84,0:06:33.26,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:06:35.97,0:06:37.76,Default,,0,0,0,,Төтенше тоқтау! Жүгір!
Dialogue: 0,0:06:39.93,0:06:44.39,Default,,0,0,0,,Жұмыс істемей жатыр!
Dialogue: 0,0:06:44.98,0:06:48.48,Default,,0,0,0,,Вагон тежегішті басады!
Dialogue: 0,0:06:50.15,0:06:53.53,Default,,0,0,0,,Төтенше тежегіш!
Dialogue: 0,0:06:53.95,0:06:55.70,Default,,0,0,0,,Ах! Бұл не?
Dialogue: 0,0:06:57.62,0:06:59.03,Default,,0,0,0,,Екінші бомба!
Dialogue: 0,0:07:03.87,0:07:05.12,Default,,0,0,0,,Майор
Dialogue: 0,0:07:05.71,0:07:06.54,Default,,0,0,0,,Не?
Dialogue: 0,0:07:07.38,0:07:09.67,Default,,0,0,0,,Майор… Майор Гилберт
Dialogue: 0,0:07:10.21,0:07:11.55,Default,,0,0,0,,Не айтып тұрсың?
Dialogue: 0,0:07:12.17,0:07:13.92,Default,,0,0,0,,Ол әлі оралмады ма?
Dialogue: 0,0:07:14.05,0:07:16.55,Default,,0,0,0,,Сен білмедің бе?
Dialogue: 0,0:07:18.35,0:07:22.39,Default,,0,0,0,,Гилберт қазір…
Dialogue: 0,0:07:24.14,0:07:28.19,Default,,0,0,0,,Дәл тимеді!
Dialogue: 0,0:07:28.31,0:07:29.69,Default,,0,0,0,,«Гардарик және—»
Dialogue: 0,0:07:32.32,0:07:36.20,Default,,0,0,0,,«Лейденшафтлих екі мемлекеті—»
Dialogue: 0,0:07:37.20,0:07:40.08,Default,,0,0,0,,«Халықаралық бейбітшілік пен қауіпсіздікті сақтау мақсатында—»
Dialogue: 0,0:07:40.20,0:07:41.03,Default,,0,0,0,,Ах
Dialogue: 0,0:07:41.16,0:07:42.20,Default,,0,0,0,,«Егеменді және тең серіктестер ретінде—»
Dialogue: 0,0:07:43.29,0:07:46.08,Default,,0,0,0,,«Бір-бірімен ынтымақтастық жасайды»
Dialogue: 0,0:07:46.21,0:07:47.00,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:48.00,0:07:51.38,Default,,0,0,0,,«Осы мақсатта біз әділ сауданы дереу қайта жаңғыртамыз—»
Dialogue: 0,0:07:52.55,0:07:57.13,Default,,0,0,0,,«Және достық белгісі ретінде Лейденшафтихих—»
