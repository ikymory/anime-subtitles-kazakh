Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.03,0:00:13.45,Default-ja,,0,0,0,,Шоги шебері Янагихара Шоги шебері
Dialogue: 5,0:00:11.07,0:00:13.46,Default,,0,0,0,,Шоги Маэстро... Шоги Маэстро Янагихара...
Dialogue: 0,0:00:17.25,0:00:20.42,Default-ja,,0,0,0,,Ａ
Dialogue: 5,0:00:17.26,0:00:20.16,Default,,0,0,0,,А сыныбында қанша уақыт қалуға болады деп ойлайсыз?
Dialogue: 0,0:00:21.63,0:00:24.84,Default-ja,,0,0,0,,Ａ
Dialogue: 5,0:00:21.68,0:00:24.54,Default,,0,0,0,,Егер сізді А сыныбынан төмендетсе, зейнетке шығу туралы ойлайсыз ба?
Dialogue: 0,0:00:25.67,0:00:28.63,Default-ja,,0,0,0,,Жастардың өрлеуі туралы не айтасыз?
Dialogue: 5,0:00:25.71,0:00:28.34,Default,,0,0,0,,Келешек жастар туралы не ойлайсыз?
Dialogue: 0,0:00:30.89,0:00:32.39,Default-ja,,0,0,0,,Бұл қорқынышты
Dialogue: 5,0:00:30.93,0:00:32.45,Default,,0,0,0,,содан кейін өзіңіз бен Фантомның арасында сызық сызып көріңіз.
Dialogue: 5,0:00:32.45,0:00:34.66,Default,,0,0,0,,Менің жұмысым болмаса,
Dialogue: 0,0:00:32.51,0:00:36.56,Default-ja,,0,0,0,,...
Dialogue: 5,0:00:34.66,0:00:36.56,Default,,0,0,0,,Маған не қалды?
Dialogue: 0,0:00:39.31,0:00:41.61,Default-ja,,0,0,0,,Қорық, Саку-чан
Dialogue: 5,0:00:39.34,0:00:41.61,Default,,0,0,0,,Мен қорқамын, Саку.
Dialogue: 0,0:00:46.03,0:00:48.86,Default-ja,,0,0,0,,Дұрыс, Рак-чан.
Dialogue: 5,0:00:46.04,0:00:48.87,Default,,0,0,0,,Мен сізді тыңдаймын, Ган.
Dialogue: 0,0:00:54.87,0:00:57.87,Default-ja,,0,0,0,,Мен де солай ойладым.
Dialogue: 5,0:00:54.95,0:00:57.87,Default,,0,0,0,,Мен үнемі бір нәрсені ойлаймын.
Dialogue: 0,0:01:04.88,0:01:07.88,Default-ja,,0,0,0,,Бірақ бізде әлі де жауап жоқ.
Dialogue: 5,0:01:04.93,0:01:07.88,Default,,0,0,0,,Бірақ менде әлі жауап жоқ.
Dialogue: 0,0:01:08.84,0:01:11.39,Default-ja,,0,0,0,,Сен сол жерде тұрсың...
Dialogue: 5,0:01:08.90,0:01:11.39,Default,,0,0,0,,Дегенмен, егер сіз тұрып жатсаңыз
Dialogue: 0,0:01:13.35,0:01:15.76,Default-ja,,0,0,0,,Өртенген егістік болса...
Dialogue: 5,0:01:13.37,0:01:15.58,Default,,0,0,0,,өртенген далада,
Dialogue: 0,0:01:20.73,0:01:26.02,Default-ja,,0,0,0,,Мен әлі күнге дейін күйіп-жанып жатырмын.
Dialogue: 5,0:01:20.75,0:01:25.73,Default,,0,0,0,,сонда мен әлі күйіп жатырмын.
Dialogue: 0,0:01:27.86,0:01:30.15,Default-ja,,0,0,0,,Ал, кеттік.
Dialogue: 5,0:01:27.92,0:01:30.16,Default,,0,0,0,,Ал, барамыз ба?
Dialogue: 0,0:01:31.15,0:01:32.78,Default-ja,,0,0,0,,Сіз жеңе аласыз—
Dialogue: 5,0:01:31.22,0:01:32.78,Default,,0,0,0,,Жеңіс,
Dialogue: 0,0:01:33.82,0:01:35.37,Default-ja,,0,0,0,,Және—
Dialogue: 5,0:01:33.88,0:01:39.29,Default,,0,0,0,,және тіпті жоғалту,
Dialogue: 0,0:01:36.03,0:01:39.29,Default-ja,,0,0,0,,Тіпті жеңіліс әрқашан...
Dialogue: 0,0:01:39.71,0:01:44.29,Default-ja,,0,0,0,,Мұны оңай шешу мүмкін емес.
Dialogue: 5,0:01:39.74,0:01:44.30,Default,,0,0,0,,оңай шешілетін нәрселер емес.
Dialogue: 0,0:01:45.75,0:01:49.55,Default-ja,,0,0,0,,Бүгін тағы да отты шарға айналдым...
Dialogue: 5,0:01:45.81,0:01:49.55,Default,,0,0,0,,Бүгін тағы да адам шырағы боламын
Dialogue: 0,0:01:53.18,0:01:56.76,Default-ja,,0,0,0,,Барынша қиналайық
Dialogue: 5,0:01:53.22,0:01:56.55,Default,,0,0,0,,және менің азапты толық тізгінді бер.
Dialogue: 0,0:02:06.78,0:02:09.49,OP,,0,0,0,,Жаңа гүлдеген одуванчиктердің арасында
Dialogue: 0,0:02:09.49,0:02:13.41,OP,,0,0,0,,Қарға айналмайтын су тамшылары
Dialogue: 0,0:02:13.41,0:02:17.28,OP,,0,0,0,,Мен көз жасына боялған жүзді ажырата аламын деп ойладым
Dialogue: 0,0:02:17.28,0:02:20.00,OP,,0,0,0,,Мен ойланбастан қолшатырымды ұсындым
Dialogue: 0,0:02:20.00,0:02:24.11,OP,,0,0,0,,Солға немесе оңға жүру дұрыс па?
Dialogue: 0,0:02:24.11,0:02:27.92,OP,,0,0,0,,Мен шынымен шешім қабылдамай тұрып жол аяқталды
Dialogue: 0,0:02:27.92,0:02:31.97,OP,,0,0,0,,Бірақ бұл ерекше біреуді аямайтын дұрыс қоңырау екені сөзсіз
Dialogue: 0,0:02:31.97,0:02:35.89,OP,,0,0,0,,Кез келген азапты тәжірибелерден
Dialogue: 0,0:02:35.89,0:02:39.03,OP,,0,0,0,,Ендеше, кішкене батылдықпен, алға ұмтылыңыз
Dialogue: 0,0:02:39.03,0:02:42.61,OP,,0,0,0,,Егер бәрі қисық болса, қиғаш жолмен жүріңіз
Dialogue: 0,0:02:42.61,0:02:46.34,OP,,0,0,0,,Алға қарай жүрсең, нұрды табасың
Dialogue: 0,0:02:46.34,0:02:50.06,OP,,0,0,0,,Бір-біріне үйіріліп, бір дауыста сайрап тұрған кішкентай құстар сияқты
Dialogue: 0,0:02:50.06,0:02:53.66,OP,,0,0,0,,Біз жаңа маусымның басында міндетті түрде қоңырау шаламыз
Dialogue: 0,0:02:53.66,0:02:56.46,OP,,0,0,0,,Сонымен көктем бізді тағы да құшағына алады
Dialogue: 0,0:02:56.46,0:03:00.69,OP,,0,0,0,,Біз жаңа беттерге бояуды шашыратып жібереміз
Dialogue: 0,0:03:00.69,0:03:04.58,OP,,0,0,0,,Екеуміз тез дос болдық, жақсы тамақтандық
Dialogue: 0,0:03:04.58,0:03:07.21,OP,,0,0,0,,Біз тіпті аздап ұрысып қалған шығармыз
Dialogue: 0,0:03:07.21,0:03:10.86,OP,,0,0,0,,Бірақ біз сол кішкентай сәттерді жүрегімізде сақтаймыз
Dialogue: 0,0:03:10.86,0:03:14.59,OP,,0,0,0,,Бізді қателесуге болмайтын болашаққа итермелейтін себептер ретінде
Dialogue: 0,0:03:14.59,0:03:18.97,OP,,0,0,0,,Күн сәулесі түскен ағаштардың арасында қанша рет адасып қалсақ та
Dialogue: 0,0:03:18.97,0:03:23.58,OP,,0,0,0,,Бүгін мұнда бір жақты билетпен желдер алып кетті
Dialogue: 0,0:03:23.58,0:03:25.02,OP,,0,0,0,,Бұл тамаша күнге гүлдейді
Dialogue: 0,0:03:29.90,0:03:32.99,titles,,0,0,0,,Өртенген өріс (3-бөлім)
Dialogue: 0,0:03:33.15,0:03:34.49,Default-ja,,0,0,0,,Ах...
Dialogue: 0,0:03:38.20,0:03:40.62,Default-ja,,0,0,0,,12 күміс…
Dialogue: 5,0:03:38.22,0:03:40.62,Default,,0,0,0,,S*1b?
Dialogue: 0,0:03:40.78,0:03:42.74,Default-ja,,0,0,0,,А... мүйіздер ше?
Dialogue: 5,0:03:41.78,0:03:42.75,Default,,0,0,0,,Епископ туралы не деуге болады?
Dialogue: 0,0:03:43.33,0:03:44.75,Default-ja,,0,0,0,,Ах...
Dialogue: 5,0:03:46.50,0:03:48.64,Default,,0,0,0,,Епископ қашып кетпей ме?
Dialogue: 0,0:03:46.67,0:03:48.83,Default-ja,,0,0,0,,Мүйіздер қашып кетпей ме?
Dialogue: 0,0:03:57.22,0:03:59.05,Default-ja,,0,0,0,,Ха... Түсіндім.
Dialogue: 5,0:03:58.09,0:03:59.06,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:03:59.89,0:04:01.18,signs,,0,0,0,,Лэнс
Dialogue: 1,0:03:59.89,0:04:01.18,signs,,0,0,0,,Лэнс
Dialogue: 5,0:04:01.18,0:04:02.43,Default,,0,0,0,,Бұл емес.
Dialogue: 0,0:04:01.35,0:04:02.43,Default-ja,,0,0,0,,Жоқ
Dialogue: 5,0:04:03.31,0:04:06.81,Default,,0,0,0,,Янагихара одан әрі қарайды.
Dialogue: 0,0:04:03.47,0:04:06.81,Default-ja,,0,0,0,,Янагихара мырзаның қарап тұрғаны алда...
Dialogue: 0,0:04:12.65,0:04:15.03,Default-ja,,0,0,0,,Екі бес хош иісті зат.
Dialogue: 5,0:04:12.69,0:04:15.20,Default,,0,0,0,,Бұл L*2e.
Dialogue: 0,0:04:15.69,0:04:17.95,Default-ja,,0,0,0,,Егер сізге соққы тисе, оны ұстаудың жолы жоқ...
Dialogue: 5,0:04:15.76,0:04:17.95,Default,,0,0,0,,Егер ол жерге түсірсе, мен...
Dialogue: 5,0:04:19.08,0:04:19.83,Default,,0,0,0,,қорғаңыз!
Dialogue: 0,0:04:19.24,0:04:19.91,Default-ja,,0,0,0,,Жоқ...
Dialogue: 0,0:04:23.20,0:04:24.33,Default-ja,,0,0,0,,Пайдасы жоқ.
Dialogue: 5,0:04:23.25,0:04:24.33,Default,,0,0,0,,Ол жақсы.
Dialogue: 0,0:04:24.91,0:04:27.33,Default-ja,,0,0,0,,Ең қарт белсенді мүше кім?
Dialogue: 5,0:04:24.95,0:04:27.33,Default,,0,0,0,,Ең үлкен белсенді ойыншы, құлыным!
Dialogue: 5,0:04:29.57,0:04:31.18,Default,,0,0,0,,Амал жоқ.
Dialogue: 0,0:04:29.58,0:04:34.92,Default-ja,,0,0,0,,Бұл өтірік болса керек... Не? Бұл кездейсоқ күш
Dialogue: 5,0:04:31.90,0:04:34.78,Default,,0,0,0,,Ол мұндай жақсы болуы мүмкін емес.
Dialogue: 5,0:04:36.72,0:04:38.72,Default,,0,0,0,,Мен бір қолымда оқталған винтовка ұстап тұрмын
Dialogue: 0,0:04:36.88,0:04:38.72,Default-ja,,0,0,0,,Не істеуім керек?
Dialogue: 5,0:04:42.60,0:04:44.60,Default,,0,0,0,,Мен не істеуім керек...
Dialogue: 0,0:04:42.76,0:04:44.60,Default-ja,,0,0,0,,Не істеуім керек...
Dialogue: 0,0:04:59.03,0:05:02.99,Default-ja,,0,0,0,,Міне! 2 Гока (Никаидо) Бауырым, не істеуіміз керек?
Dialogue: 5,0:04:59.16,0:04:59.87,Default,,0,0,0,,Міне.
Dialogue: 5,0:04:59.87,0:05:01.13,Default,,0,0,0,,L*2e!
Dialogue: 5,0:05:01.13,0:05:02.99,Default,,0,0,0,,Үлкен аға, сен не істейсің?
Dialogue: 5,0:05:17.09,0:05:18.37,Default,,0,0,0,,Алайда, оны ашқан кезде босап шыққан айакашилермен әлі күреспедік.
Dialogue: 0,0:05:17.26,0:05:18.84,Default-ja,,0,0,0,,Наму…
Dialogue: 5,0:05:18.84,0:05:20.10,Default,,0,0,0,,B*1d!
Dialogue: 0,0:05:19.01,0:05:20.09,Default-ja,,0,0,0,,1 шаршы!
Dialogue: 5,0:05:21.35,0:05:23.85,Default,,0,0,0,,Жаңа ғана қолға түсірген епископпен бірге қорғады ма?
Dialogue: 0,0:05:21.51,0:05:23.72,Default-ja,,0,0,0,,Жаңа ғана алған мүйізіммен алдым!
Dialogue: 5,0:05:23.85,0:05:25.45,Default,,0,0,0,,Бірақ бұл...
Dialogue: 0,0:05:23.85,0:05:27.22,Default-ja,,0,0,0,,Ах, бірақ бұл... (Нөл) Жоқ, бірақ...
Dialogue: 5,0:05:25.45,0:05:27.23,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:05:31.40,0:05:32.73,Default-ja,,0,0,0,,Шынында да…
Dialogue: 5,0:05:31.52,0:05:32.73,Default,,0,0,0,,Бұл әрине...
Dialogue: 5,0:05:35.24,0:05:37.19,Default,,0,0,0,,Бұл дұрыс қадам болды ма?
Dialogue: 0,0:05:35.40,0:05:39.82,Default-ja,,0,0,0,,Жақсы болды ма? Жоқ, бірақ-
Dialogue: 5,0:05:37.84,0:05:44.36,Default,,0,0,0,,Бірақ мен 2c-те пешке үшін жалғыз қорғанысым осы епископты тастап кету болды.
Dialogue: 0,0:05:39.99,0:05:44.83,Default-ja,,0,0,0,,Бұл 23 ұпай алудың жалғыз жолы...
Dialogue: 5,0:05:49.83,0:05:52.96,Default,,0,0,0,,Ол епископты бірден түсіріп алды.
Dialogue: 0,0:05:50.00,0:05:52.96,Default-ja,,0,0,0,,Ол кенет бұрышты соқты.
Dialogue: 0,0:05:54.88,0:05:56.46,Default-ja,,0,0,0,,Бірақ...
Dialogue: 5,0:05:54.93,0:05:56.46,Default,,0,0,0,,Алайда,
Dialogue: 0,0:05:59.46,0:06:01.72,Default-ja,,0,0,0,,(Номуның ыңқылдауы)
Dialogue: 5,0:05:59.49,0:06:01.52,Default,,0,0,0,,бұл дана шешім болды.
Dialogue: 0,0:06:02.13,0:06:03.72,Default-ja,,0,0,0,,Я... Шимада...
Dialogue: 5,0:06:02.86,0:06:06.59,Default,,0,0,0,,Егер сіз Шимаданы жалғыз қалдырсаңыз, ол қайтадан жеңіске жететініне сенімдімін.
Dialogue: 0,0:06:03.84,0:06:06.81,Default-ja,,0,0,0,,Егер сіз оны жіберсеңіз, ол қайтадан жеңе бастайды.
Dialogue: 0,0:06:08.06,0:06:12.69,Default-ja,,0,0,0,,Иә, Гото, дұрыс айтасың.
Dialogue: 5,0:06:08.09,0:06:10.27,Default,,0,0,0,,Дұрыс, Готу.
Dialogue: 5,0:06:10.27,0:06:12.43,Default,,0,0,0,,Бұл дәл сіз айтқандай.
Dialogue: 5,0:06:13.73,0:06:16.11,Default,,0,0,0,,Ашық, тұрақты,
Dialogue: 0,0:06:13.90,0:06:16.11,Default-ja,,0,0,0,,Ақылмен, тұрақты
Dialogue: 5,0:06:16.99,0:06:20.39,Default,,0,0,0,,және ол өзін күшпен құрастырды,
Dialogue: 0,0:06:17.15,0:06:20.19,Default-ja,,0,0,0,,Біртіндеп өзіңізді қалыптастырыңыз—
Dialogue: 5,0:06:20.39,0:06:24.74,Default,,0,0,0,,сосын қайтып келді, бір қабат қалың.
Dialogue: 0,0:06:20.57,0:06:24.74,Default-ja,,0,0,0,,Қайта оралды, қалыңырақ.
Dialogue: 5,0:06:27.75,0:06:29.75,Default,,0,0,0,,Иә, ол болуы керек...
Dialogue: 0,0:06:27.91,0:06:29.74,Default-ja,,0,0,0,,Бұл
Dialogue: 0,0:06:31.33,0:06:33.58,Default-ja,,0,0,0,,Бұл зелькова ағашы.
Dialogue: 5,0:06:31.36,0:06:33.38,Default,,0,0,0,,зелкова ағашы.
Dialogue: 5,0:06:36.67,0:06:40.94,Default,,0,0,0,,Олардың үлкен болуы үшін көп уақыт қажет,
Dialogue: 0,0:06:36.67,0:06:41.13,Default-ja,,0,0,0,,Сіз тек баяу өсе аласыз, бірақ оның орнына...
Dialogue: 0,0:06:41.72,0:06:47.01,Default-ja,,0,0,0,,Жаңбыр мен желге төтеп беретін күшті және үлкен ағаш болып өседі.
Dialogue: 5,0:06:41.73,0:06:43.97,Default,,0,0,0,,бірақ олар жел мен жаңбырға төзімді,
Dialogue: 5,0:06:43.97,0:06:47.02,Default,,0,0,0,,және олар ақырында үлкен, қатты ағаштарға айналады.
Dialogue: 0,0:06:48.72,0:06:51.27,Default-ja,,0,0,0,,Сонда мен ше?
Dialogue: 5,0:06:48.73,0:06:51.27,Default,,0,0,0,,Сонда мен қандаймын?
Dialogue: 5,0:06:52.77,0:06:55.15,Default,,0,0,0,,Егер мен өзімді бір нәрсемен салыстыру керек болсам,
Dialogue: 0,0:06:52.93,0:06:55.15,Default-ja,,0,0,0,,Мысалы, мен...
Dialogue: 0,0:07:01.74,0:07:04.24,Default-ja,,0,0,0,,Бұл не болды?
Dialogue: 5,0:07:01.76,0:07:04.05,Default,,0,0,0,,Мен қандай болар едім?
Dialogue: 0,0:07:07.70,0:07:11.29,Default-ja,,0,0,0,,Иә, білмеймін.
Dialogue: 5,0:07:07.73,0:07:09.37,Default,,0,0,0,,Оқу, оқу
Dialogue: 5,0:07:09.37,0:07:11.29,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:07:13.96,0:07:16.79,Default-ja,,0,0,0,,Біздің ата-бабаларымыз да мысалдар келтіреді.
Dialogue: 5,0:07:14.16,0:07:16.80,Default,,0,0,0,,Менде бірде-бір предшественник қалмады
Dialogue: 0,0:07:17.29,0:07:20.59,Default-ja,,0,0,0,,Ешкім қалмады
Dialogue: 5,0:07:17.32,0:07:20.33,Default,,0,0,0,,кім мені бір нәрсеге теңейді.
Dialogue: 0,0:07:26.13,0:07:27.72,Default-ja,,0,0,0,,Иә? Қарғыс атсын
Dialogue: 5,0:07:26.14,0:07:27.72,Default,,0,0,0,,Иә? Қырсық.
Dialogue: 5,0:07:27.72,0:07:32.85,Default,,0,0,0,,Мен сіріңкенің ортасында ойымды жібере алмаймын.
Dialogue: 0,0:07:27.89,0:07:32.85,Default-ja,,0,0,0,,Олай емес, ойын барысында қажетсіз нәрселер басымнан өтіп жатты...
Dialogue: 0,0:07:33.39,0:07:37.60,Default-ja,,0,0,0,,А... белім ауырып, көзім бұлдырап барады.
Dialogue: 5,0:07:33.43,0:07:35.78,Default,,0,0,0,,Аға, арқам ауырып тұр.
Dialogue: 5,0:07:35.78,0:07:37.61,Default,,0,0,0,,Менің көруім бұлыңғырлана бастады.
Dialogue: 0,0:07:38.56,0:07:42.36,Default-ja,,0,0,0,,Жоқ, мен әдеттегіден әлдеқайда жақсы сезінемін.
Dialogue: 5,0:07:38.62,0:07:42.36,Default,,0,0,0,,Дегенмен, өзімді әдеттегіден әлдеқайда жақсы сезінемін.
Dialogue: 0,0:07:42.90,0:07:45.49,Default-ja,,0,0,0,,Бірінші ойын қорқынышты болды.
Dialogue: 5,0:07:42.93,0:07:45.60,Default,,0,0,0,,Бірінші матчта өзімді қорқынышты сезіндім.
Dialogue: 5,0:07:45.60,0:07:47.49,Default,,0,0,0,,Оны «егде жастағы пневмония» деп атайды.
Dialogue: 0,0:07:45.61,0:07:49.12,Default-ja,,0,0,0,,Кәрілік пневмония... Мен өлемін деп ойладым.
Dialogue: 5,0:07:47.49,0:07:49.17,Default,,0,0,0,,Мен өлемін деп ойладым.
Dialogue: 5,0:07:49.17,0:07:52.54,Default,,0,0,0,,Мен оны жеңгеніме таң қалдым.
Dialogue: 0,0:07:49.24,0:07:52.54,Default-ja,,0,0,0,,Жарайды, мен осылай жеңдім.
Dialogue: 5,0:07:56.71,0:07:59.41,Default,,0,0,0,,Ой, ол маған жалт қарады.
Dialogue: 0,0:07:56.87,0:08:00.79,Default-ja,,0,0,0,,Ой, жоқ... Маған жалт қарады. Ой, қорқынышты. Бұл қорқынышты.
Dialogue: 5,0:07:59.41,0:08:00.80,Default,,0,0,0,,Қандай қорқынышты.
Dialogue: 5,0:08:00.80,0:08:03.52,Default,,0,0,0,,Мұндай бетті жасаудың қажеті жоқ.
Dialogue: 0,0:08:00.96,0:08:04.21,Default-ja,,0,0,0,,Ол бетіңді жасамасаң да, иә...
Dialogue: 0,0:08:06.22,0:08:08.47,Default-ja,,0,0,0,,Енді сізде басымдық бар.
Dialogue: 5,0:08:06.25,0:08:08.47,Default,,0,0,0,,Сізде дәл қазір артықшылық бар.
Dialogue: 0,0:08:08.93,0:08:10.68,Default-ja,,0,0,0,,Саған жақсырақ
Dialogue: 5,0:08:08.95,0:08:10.54,Default,,0,0,0,,Сіріңке сізге еңкейіп тұр.
Dialogue: 5,0:08:13.39,0:08:14.87,Default,,0,0,0,,Б... бір сызық
Dialogue: 0,0:08:13.39,0:08:16.31,Default-ja,,0,0,0,,Түсіндім, мен...
Dialogue: 5,0:08:14.87,0:08:16.14,Default,,0,0,0,,Мен де...
Dialogue: 5,0:08:16.86,0:08:19.11,Default,,0,0,0,,Жоғалтасыз ба?
Dialogue: 0,0:08:17.02,0:08:19.10,Default-ja,,0,0,0,,Сіз ұтыласыз ба?
Dialogue: 0,0:08:23.90,0:08:26.40,Default-ja,,0,0,0,,Мен бұл туралы ұзақ ойладым.
Dialogue: 5,0:08:23.94,0:08:26.04,Default,,0,0,0,,Осы уақыт бойы мен бұл туралы ойладым.
Dialogue: 0,0:08:27.78,0:08:33.08,Default-ja,,0,0,0,,Менен шоги алсаң, не қалады?
Dialogue: 5,0:08:27.81,0:08:32.84,Default,,0,0,0,,Менен шогиді алып кетсе, не қалады?
Dialogue: 5,0:08:44.13,0:08:49.43,Default,,0,0,0,,Шимада Кай, 8-дан, Шоги Маэстро Янагихараның L*2e-ден басталған шабуылдарынан қорғанды.
Dialogue: 0,0:08:44.30,0:08:46.92,Default-ja,,0,0,0,,2 Гокадан Янагихара Кишоның шабуылы—
Dialogue: 0,0:08:47.05,0:08:51.39,Default-ja,,0,0,0,,Осы уақытқа дейін қабылдаған Шимада Кай 8-ші дан енді басымдыққа ие болды.
Dialogue: 5,0:08:49.43,0:08:51.39,Default,,0,0,0,,Енді артықшылық кері қайтарылды.
Dialogue: 5,0:08:51.39,0:08:54.14,Default,,0,0,0,,Ол ақырында өзінің алғашқы атағын алады ма?
Dialogue: 0,0:08:51.55,0:08:54.14,Default-ja,,0,0,0,,Сіз көптен күткен бірінші атағыңызды ала аласыз ба?
Dialogue: 0,0:08:54.68,0:08:56.27,Default-ja,,0,0,0,,Мастер Янагихараға қарсы
Dialogue: 5,0:08:54.70,0:09:00.17,Default,,0,0,0,,Ал, Шоги Маэстро Янагихара 8-дан жастағы Шимада оған қысым жасағандықтан шаршаған сияқты.
Dialogue: 0,0:08:56.39,0:08:59.39,Default-ja,,0,0,0,,Шимада 8-данды қуып жеткенде шаршай бастадыңыз ба?
Dialogue: 5,0:09:00.17,0:09:03.85,Default,,0,0,0,,Ол қиналып, зейінін жинақтай алмай жатқан сияқты.
Dialogue: 0,0:09:00.23,0:09:04.11,Default-ja,,0,0,0,,Мен ойымды жинақтай алмаймын және мен өзімді жинақтау қиынға соғып жатқандай сезінемін.
Dialogue: 5,0:09:05.90,0:09:10.72,Default,,0,0,0,,Шоги Маэстро Янагихара Мәңгілік Шоги Маэстро титулына жақын, оны он рет жеңіп алу керек,
Dialogue: 0,0:09:06.07,0:09:10.66,Default-ja,,0,0,0,,Янагихара Кишо, барлығы 10 Кишо турнирі және Мәңгілік Кишо...
Dialogue: 5,0:09:10.72,0:09:13.91,Default,,0,0,0,,бірақ ол соңғы қадамды жасай ала ма?
Dialogue: 0,0:09:10.78,0:09:13.91,Default-ja,,0,0,0,,Тағы бір қадамға жете алмайсыз ба?
Dialogue: 5,0:09:16.92,0:09:18.92,Default,,0,0,0,,Саку, сенің жеткен жерің осы ма?
Dialogue: 0,0:09:17.08,0:09:18.91,Default-ja,,0,0,0,,Саку-чан, осының бәрі бар ма?
Dialogue: 5,0:09:18.92,0:09:21.92,Default,,0,0,0,,Тағы бір! Сізге тағы бір жеңіс керек!
Dialogue: 0,0:09:19.08,0:09:21.92,Default-ja,,0,0,0,,Сонымен қатар... Менде тағы бір ғана жеңіс болды.
Dialogue: 5,0:09:21.92,0:09:24.42,Default,,0,0,0,,Жоқ, сен керемет жасадың, Саку.
Dialogue: 0,0:09:22.08,0:09:24.42,Default-ja,,0,0,0,,Жоқ, Саку-чан, сен барыңды істедің.
Dialogue: 5,0:09:24.42,0:09:27.43,Default,,0,0,0,,Шындығында, сіз осы уақытқа дейін керемет жасадыңыз!
Dialogue: 0,0:09:24.59,0:09:27.42,Default-ja,,0,0,0,,Жарайсыңдар, осы уақытқа дейін қолыңнан келгеннің бәрін жасадың.
Dialogue: 5,0:09:29.43,0:09:32.06,Default,,0,0,0,,Мен зейнеткерлікке шығамын.
Dialogue: 0,0:09:29.59,0:09:31.93,Default-ja,,0,0,0,,Мен зейнеткерлікке шығамын
Dialogue: 0,0:09:32.05,0:09:35.35,Default-ja,,0,0,0,,Саку-чан, мен төмендетілдім.
Dialogue: 5,0:09:32.06,0:09:35.42,Default,,0,0,0,,Саку, мен... төмендетіліп жатырмын.
Dialogue: 5,0:09:35.42,0:09:38.16,Default,,0,0,0,,Бұл көңілсіз, бірақ мен басқа жол іздеймін.
Dialogue: 0,0:09:35.47,0:09:37.97,Default-ja,,0,0,0,,Менің көңілім қалды, бірақ мен басқа жолды табамын.
Dialogue: 0,0:09:38.10,0:09:43.06,Default-ja,,0,0,0,,Саку-чан, жоқ, мен уақыт келді деп ойладым.
Dialogue: 5,0:09:38.16,0:09:40.55,Default,,0,0,0,,Саку, мен үшін бітті.
Dialogue: 5,0:09:40.55,0:09:43.18,Default,,0,0,0,,Мен бұл дұрыс уақыт екенін қабылдадым.
Dialogue: 5,0:09:43.18,0:09:47.45,Default,,0,0,0,,Саку, мен ауылға қайтамын.
Dialogue: 0,0:09:43.19,0:09:47.44,Default-ja,,0,0,0,,Саку-чан, мен ауылға қайтуды жөн көрдім.
Dialogue: 0,0:09:48.15,0:09:53.20,Default-ja,,0,0,0,,Қорқынышты, қорқынышты, Саку-чан
Dialogue: 5,0:09:48.16,0:09:49.94,Default,,0,0,0,,содан кейін өзіңіз бен Фантомның арасында сызық сызып көріңіз.
Dialogue: 5,0:09:50.65,0:09:53.20,Default,,0,0,0,,Мен қорқамын, Саку.
Dialogue: 0,0:09:53.37,0:09:55.28,Default-ja,,0,0,0,,—
Dialogue: 5,0:09:53.52,0:09:54.90,Default,,0,0,0,,Мен өзімді...
Dialogue: 5,0:09:55.70,0:09:58.36,Default,,0,0,0,,Мен өртенген даладамын.
Dialogue: 0,0:09:55.87,0:09:58.58,Default-ja,,0,0,0,,Өртенген далада жүрген сияқтымыз.
Dialogue: 5,0:10:12.93,0:10:13.72,Default,,0,0,0,,(Тик-так, сағаттың көрсеткіштері тик-так)
Dialogue: 0,0:10:13.09,0:10:14.47,Default-ja,,0,0,0,,Жоқ...
Dialogue: 0,0:10:15.14,0:10:17.43,Default-ja,,0,0,0,,Мен білмеймін, бірақ бұл ...
Dialogue: 5,0:10:15.19,0:10:17.12,Default,,0,0,0,,Неге екенін білмеймін,
Dialogue: 5,0:10:20.94,0:10:23.31,Default,,0,0,0,,бірақ мен...
Dialogue: 0,0:10:21.10,0:10:23.31,Default-ja,,0,0,0,,Мен сені ешқашан жібермеймін...
Dialogue: 0,0:10:28.23,0:10:30.44,Default-ja,,0,0,0,,Жоқ!
Dialogue: 5,0:10:28.40,0:10:30.45,Default,,0,0,0,,Мынаны жібер!
Dialogue: 0,0:10:34.61,0:10:37.49,Default-ja,,0,0,0,,Менің алып жүргенім де, жеткізгенім де осы.
Dialogue: 5,0:10:34.69,0:10:37.50,Default,,0,0,0,,Мен бұл жүкті иығыма алып, жеткіземін!
Dialogue: 0,0:10:38.28,0:10:42.66,Default-ja,,0,0,0,,Ерінбей еңбек еткен адамның жеткен жері...
Dialogue: 5,0:10:38.39,0:10:42.67,Default,,0,0,0,,Бар күшімен тырысқан адамдар бір жерге жету үшін...
Dialogue: 5,0:10:56.64,0:11:00.52,Default,,0,0,0,,бұл өртенген өріс емес!
Dialogue: 0,0:10:56.80,0:11:00.52,Default-ja,,0,0,0,,Өртенген далада құны бар ма?
Dialogue: 0,0:11:02.56,0:11:04.14,Default-ja,,0,0,0,,1 жеті шар...
Dialogue: 5,0:11:02.60,0:11:04.15,Default,,0,0,0,,K-1g?
Dialogue: 0,0:11:05.81,0:11:07.65,Default-ja,,0,0,0,,Допты көтерсең ше?
Dialogue: 5,0:11:06.07,0:11:07.65,Default,,0,0,0,,Ол патшасын жоғары көтеріп жатыр ма?
Dialogue: 5,0:11:19.04,0:11:20.85,Default,,0,0,0,,K-1f?!
Dialogue: 0,0:11:19.20,0:11:23.16,Default-ja,,0,0,0,,16 шар? Мен ешқашан 16 доп туралы естіген емеспін.
Dialogue: 5,0:11:20.85,0:11:23.27,Default,,0,0,0,,Мен ешкімнің бұлай істегенін естіген емеспін!
Dialogue: 5,0:11:23.27,0:11:24.25,Default,,0,0,0,,Альпинизм патшасы?
Dialogue: 0,0:11:23.29,0:11:25.42,Default-ja,,0,0,0,,Шарлар? (Нөл) Сіз нені білдіреді?
Dialogue: 5,0:11:24.25,0:11:25.42,Default,,0,0,0,,Бұл не болып жатыр өзі?!
Dialogue: 5,0:11:25.42,0:11:27.79,Default,,0,0,0,,C-Ол мұны істей ала ма?
Dialogue: 0,0:11:25.58,0:11:29.67,Default-ja,,0,0,0,,Ал... мұны істеудің жолы бар ма? (Нөл) А, бірақ...
Dialogue: 5,0:11:27.79,0:11:29.67,Default,,0,0,0,,Иә, бірақ...
Dialogue: 5,0:11:31.05,0:11:32.51,Default,,0,0,0,,Саку!
Dialogue: 0,0:11:31.21,0:11:34.05,Default-ja,,0,0,0,,Саку-чан (Ер) Саку-чан, қолыңнан келгенін істе
Dialogue: 5,0:11:32.51,0:11:34.05,Default,,0,0,0,,Саку, сенің қолыңнан келеді!
Dialogue: 0,0:11:36.72,0:11:38.30,Default-ja,,0,0,0,,Шынында да…
Dialogue: 5,0:11:36.75,0:11:37.51,Default,,0,0,0,,Рас.
Dialogue: 0,0:11:39.35,0:11:41.39,Default-ja,,0,0,0,,Сын айтудың жолы жоқ
Dialogue: 5,0:11:39.49,0:11:41.21,Default,,0,0,0,,Менде мұны сөгуге әрекетім жоқ.
Dialogue: 0,0:11:44.60,0:11:46.64,Default-ja,,0,0,0,,Қарт…
Dialogue: 5,0:11:44.65,0:11:46.69,Default,,0,0,0,,Қарғыс атсын, қария...
Dialogue: 5,0:11:46.69,0:11:50.82,Default,,0,0,0,,Сіз бұл әрекетті жасау үшін тым қартайдыңыз.
Dialogue: 0,0:11:46.77,0:11:50.82,Default-ja,,0,0,0,,Бұл қолдар тым жас.
Dialogue: 5,0:11:54.36,0:11:56.20,Default,,0,0,0,,Уақыт өте келе,
Dialogue: 0,0:11:54.36,0:11:56.20,Default-ja,,0,0,0,,Уақыт бойынша—
Dialogue: 0,0:11:57.03,0:12:02.66,Default-ja,,0,0,0,,Ұнамаса да, өртенген далада аз уақытта шөп қайта шығады.
Dialogue: 5,0:11:57.07,0:12:02.45,Default,,0,0,0,,Өртенген далада қаласақ та, қаламасақ та шөп қайта шығады.
Dialogue: 5,0:12:03.75,0:12:06.21,Default,,0,0,0,,Ол жасыл алқапқа айналады.
Dialogue: 0,0:12:03.75,0:12:06.21,Default-ja,,0,0,0,,Жасыл далаға айнал
Dialogue: 0,0:12:08.88,0:12:11.46,Default-ja,,0,0,0,,Оны біріктіріңіз...
Dialogue: 5,0:12:08.93,0:12:11.31,Default,,0,0,0,,Ал біз оны көреміз...
Dialogue: 0,0:12:15.05,0:12:18.01,Default-ja,,0,0,0,,Қараңдар!
Dialogue: 5,0:12:15.09,0:12:17.81,Default,,0,0,0,,бірге!
Dialogue: 0,0:12:18.47,0:12:20.98,titles,,0,0,0,,Өртенген өріс (3-бөлім)
Dialogue: 0,0:12:20.98,0:12:24.98,titles,,0,0,0,,Өртенген өріс (4-бөлім)
Dialogue: 0,0:12:44.95,0:12:47.33,Default-ja,,0,0,0,,Лимит әлдеқашан асып кеткен —
Dialogue: 5,0:12:44.98,0:12:47.33,Default,,0,0,0,,Ол өз шегінен асып кетті.
Dialogue: 0,0:12:50.33,0:12:52.50,Default-ja,,0,0,0,,Мен оған қарап-ақ айта аламын.
Dialogue: 5,0:12:50.37,0:12:52.51,Default,,0,0,0,,Мұны көрген кез келген адам көре алады.
Dialogue: 0,0:12:55.92,0:12:59.76,Default-ja,,0,0,0,,Денемді балшықтай ауыр жағымда қалдырып,
Dialogue: 5,0:12:55.93,0:12:59.55,Default,,0,0,0,,Оның денесі қолтық сүйегіне қатты сүйенді,
Dialogue: 0,0:13:00.43,0:13:04.26,Default-ja,,0,0,0,,Тақтаға оны ішкендей қарап тұр.
Dialogue: 5,0:13:00.44,0:13:04.27,Default,,0,0,0,,алға құлайтындай тақтаға қарап тұр.
Dialogue: 5,0:13:14.61,0:13:20.84,Default,,0,0,0,,Бірақ дірілдеген саусақтар әр қимылдады...
Dialogue: 0,0:13:14.77,0:13:20.99,Default-ja,,0,0,0,,Бірақ сол дірілдеген саусақтардың әрбір қимылы...
Dialogue: 0,0:13:23.99,0:13:27.50,Default-ja,,0,0,0,,Баяу ағып жатқан лава ағыны сияқты—
Dialogue: 5,0:13:24.01,0:13:27.32,Default,,0,0,0,,баяу ағып жатқан лава сияқты болды.
Dialogue: 0,0:13:27.91,0:13:30.37,Default-ja,,0,0,0,,Қатты қызыл...
Dialogue: 5,0:13:27.96,0:13:30.38,Default,,0,0,0,,ауыр, қызыл,
Dialogue: 0,0:13:34.75,0:13:37.34,Default-ja,,0,0,0,,Жарқырап тұрды
Dialogue: 5,0:13:34.78,0:13:37.17,Default,,0,0,0,,және жарқыраған.
Dialogue: 0,0:13:44.05,0:13:45.64,Default-ja,,0,0,0,,Бұл кескілескен шайқас болды.
Dialogue: 5,0:13:44.17,0:13:45.64,Default,,0,0,0,,Бұл кескілескен шайқас болды.
Dialogue: 0,0:13:48.18,0:13:49.52,Default-ja,,0,0,0,,Шоги ойыншысы болған кез келген адам...
Dialogue: 5,0:13:48.19,0:13:49.52,Default,,0,0,0,,Кез келген кәсіби шоги ойыншысы...
Dialogue: 5,0:13:53.52,0:13:56.14,Default,,0,0,0,,шын жүректен айтар еді...
Dialogue: 0,0:13:53.69,0:13:56.32,Default-ja,,0,0,0,,«Мен осылай шоги ойнағым келеді»...
Dialogue: 0,0:13:59.15,0:14:00.99,Default-ja,,0,0,0,,Шын жүректен...
Dialogue: 5,0:13:59.19,0:14:00.83,Default,,0,0,0,,олар әрқашан ойнағысы келді ...
Dialogue: 0,0:14:03.49,0:14:06.08,Default-ja,,0,0,0,,Ойланбасқа амалым жоқ
Dialogue: 5,0:14:03.68,0:14:05.92,Default,,0,0,0,,осындай сәйкестік.
Dialogue: 0,0:14:26.06,0:14:27.56,signs,,0,0,0,,Шоги залы
Dialogue: 1,0:14:26.06,0:14:27.56,signs,,0,0,0,,Шоги залы
Dialogue: 0,0:14:32.98,0:14:34.56,Default-ja,,0,0,0,,Және…
Dialogue: 5,0:14:33.01,0:14:33.97,Default,,0,0,0,,Дәл солай! Ицумида!
Dialogue: 0,0:14:41.44,0:14:44.82,Default-ja,,0,0,0,,169 Қатты шайқас болды...
Dialogue: 5,0:14:41.49,0:14:44.83,Default,,0,0,0,,169 жүріске созылған қызу шайқастан кейін,
Dialogue: 0,0:14:55.08,0:14:58.21,Default-ja,,0,0,0,,Шимада мырзаның сендіретін сөздері...
Dialogue: 5,0:14:55.11,0:14:58.21,Default,,0,0,0,,екі сөзді айту үшін Шимаданың бар күші қажет болды
Dialogue: 0,0:15:02.92,0:15:04.63,Default-ja,,0,0,0,,Перде түсірілді
Dialogue: 5,0:15:02.97,0:15:04.50,Default,,0,0,0,,оны аяқтады.
Dialogue: 0,0:15:07.01,0:15:12.48,Default-ja,,0,0,0,,169 жүріспен бірінші қозғаушы Мастер Шоги Янагихара жеңеді.
Dialogue: 5,0:15:07.03,0:15:12.61,Default,,0,0,0,,169 қозғалыстан кейін жеңімпаз Шоги Маэстро Янагихара.
Dialogue: 0,0:15:12.60,0:15:13.89,Default-ja,,0,0,0,,Кишо турнирінің ережесіне сәйкес—
Dialogue: 5,0:15:12.61,0:15:15.71,Default,,0,0,0,,Shogi Maestro турнирінің ережелері бойынша, ол титулды он рет сақтап қалды,
Dialogue: 0,0:15:14.02,0:15:17.48,Default-ja,,0,0,0,,Сіз 10-тоқсанды жалпы аяқтағаныңыз үшін Мәңгілік шахмат шебері атағын аласыз.
Dialogue: 5,0:15:15.71,0:15:17.48,Default,,0,0,0,,ол «Мәңгілік Шоги Маэстро» атағын алады.
Dialogue: 0,0:15:17.65,0:15:21.32,Default-ja,,0,0,0,,Саку-чан жасады! Барлығы 10 тоқсан!
Dialogue: 5,0:15:18.70,0:15:21.32,Default,,0,0,0,,Саку, сен істедің! Он жеңіс!
Dialogue: 0,0:15:21.48,0:15:24.99,Default-ja,,0,0,0,,О! Алақай! Мен Эйзиді алдым!
Dialogue: 5,0:15:22.26,0:15:24.99,Default,,0,0,0,,Ол мұны істеді! Ол Мәңгілік Шоги Маэстро!
Dialogue: 5,0:15:24.99,0:15:27.24,Default,,0,0,0,,Мен бір қолымда оқталған винтовка ұстап тұрмын
Dialogue: 0,0:15:25.15,0:15:27.24,Default-ja,,0,0,0,,Иә! (қол шапалақтау)
Dialogue: 5,0:16:14.54,0:16:17.05,Default,,0,0,0,,Янагихара мырза, жақсысыз ба?
Dialogue: 0,0:16:14.70,0:16:16.87,Default-ja,,0,0,0,,Янагихара мырза, жақсысыз ба?
Dialogue: 0,0:16:17.00,0:16:20.17,Default-ja,,0,0,0,,А... жарайды.
Dialogue: 5,0:16:18.54,0:16:19.92,Default,,0,0,0,,Менде бәрі жақсы.
Dialogue: 0,0:16:20.29,0:16:24.17,Default-ja,,0,0,0,,Хаха... Менің тізем сәл күлді.
Dialogue: 5,0:16:21.19,0:16:23.84,Default,,0,0,0,,Менің тізем дәл жол берді.
Dialogue: 0,0:16:25.42,0:16:26.72,Default-ja,,0,0,0,,Рахмет
Dialogue: 5,0:16:25.44,0:16:26.53,Default,,0,0,0,,Кел де жуынып ал.
Dialogue: 0,0:16:42.32,0:16:44.82,signs,,0,0,0,,Shogi Maestro турнирінің бесінші матчы
Dialogue: 1,0:16:42.32,0:16:44.82,signs,,0,0,0,,Shogi Maestro турнирінің бесінші матчы
Dialogue: 0,0:16:47.86,0:16:50.03,Default-ja,,0,0,0,,Саку-чан! (қуаныш)
Dialogue: 5,0:16:47.91,0:16:50.20,Default,,0,0,0,,Саку!
Dialogue: 0,0:16:50.16,0:16:51.99,Default-ja,,0,0,0,,Янагихара Шоги Мастер
Dialogue: 5,0:16:50.20,0:16:51.99,Default,,0,0,0,,Шоги Маэстро Янагихара...
Dialogue: 5,0:16:51.99,0:16:54.08,Default,,0,0,0,,Wh- Матчтан кейінгі шолу туралы не деуге болады?
Dialogue: 0,0:16:52.16,0:16:54.08,Default-ja,,0,0,0,,Немесе... Алған әсерлері ше?
Dialogue: 5,0:16:54.08,0:16:55.71,Default,,0,0,0,,Янагихара мырза!
Dialogue: 0,0:16:54.24,0:16:57.46,Default-ja,,0,0,0,,Янагихара мырза! Апыр-ай! Құттықтаймыз!
Dialogue: 5,0:16:55.71,0:16:57.66,Default,,0,0,0,,Уау! Құттықтаймыз!
Dialogue: 0,0:16:57.58,0:16:58.87,Default-ja,,0,0,0,,Саку-чан!
Dialogue: 5,0:16:57.66,0:16:58.88,Default,,0,0,0,,Саку!
Dialogue: 5,0:16:58.88,0:17:02.86,Default,,0,0,0,,Бұл керемет болды! Бұл шоги керемет болды!
Dialogue: 0,0:16:59.00,0:17:02.84,Default-ja,,0,0,0,,Керемет! Бұл таңғажайып шоги болды!
Dialogue: 0,0:17:08.59,0:17:09.84,Default-ja,,0,0,0,,Қатерлі ісік!
Dialogue: 5,0:17:08.62,0:17:09.85,Default,,0,0,0,,Ган!
Dialogue: 5,0:17:09.85,0:17:11.05,Default,,0,0,0,,А-а?
Dialogue: 0,0:17:10.01,0:17:13.47,Default-ja,,0,0,0,,А... Иә? Мен бе? Не... ол не? Саку-чан
Dialogue: 5,0:17:11.05,0:17:11.82,Default,,0,0,0,,Мен?
Dialogue: 5,0:17:11.82,0:17:13.47,Default,,0,0,0,,Бұл не, Саку?
Dialogue: 0,0:17:13.64,0:17:16.60,Default-ja,,0,0,0,,Суретке түсіріңізші, иә?
Dialogue: 5,0:17:13.84,0:17:15.52,Default,,0,0,0,,Суретке түсіріңіз!
Dialogue: 5,0:17:15.52,0:17:16.60,Default,,0,0,0,,Жер
Dialogue: 5,0:17:16.60,0:17:18.98,Default,,0,0,0,,Сіз камераңызды әкелдіңіз, солай ма?
Dialogue: 0,0:17:16.77,0:17:18.98,Default-ja,,0,0,0,,Сен әкелдің, солай ма? камера
Dialogue: 0,0:17:19.73,0:17:21.98,Default-ja,,0,0,0,,Суретке түсіріңіз.
Dialogue: 5,0:17:19.76,0:17:21.98,Default,,0,0,0,,Суретке түсіріңіз!
Dialogue: 5,0:17:21.98,0:17:24.64,Default,,0,0,0,,Барлығымен бірге!
Dialogue: 0,0:17:22.15,0:17:24.86,Default-ja,,0,0,0,,Мен осындамын.
Dialogue: 0,0:17:27.11,0:17:29.86,Default-ja,,0,0,0,,А... А, сәл күте тұрыңыз.
Dialogue: 5,0:17:27.15,0:17:29.87,Default,,0,0,0,,О-Ой, күте тұрыңыз!
Dialogue: 5,0:17:29.87,0:17:32.12,Default,,0,0,0,,Мүмкін біреу мұны еске алу үшін ұстауы керек.
Dialogue: 0,0:17:29.87,0:17:32.12,signs,,0,0,0,,33-ші
Dialogue: 1,0:17:29.87,0:17:32.12,signs,,0,0,0,,33-ші
Dialogue: 0,0:17:29.87,0:17:32.12,signs,,0,0,0,,Шоги маэстро турнирі
Dialogue: 1,0:17:29.87,0:17:32.12,signs,,0,0,0,,Шоги маэстро турнирі
Dialogue: 0,0:17:29.87,0:17:32.12,signs,,0,0,0,,М
Dialogue: 1,0:17:29.87,0:17:32.12,signs,,0,0,0,,Бесінші матч
Dialogue: 0,0:17:30.03,0:17:32.12,Default-ja,,0,0,0,,Бұл сізде болса, естелік болуы мүмкін.
Dialogue: 5,0:17:32.12,0:17:34.42,Default,,0,0,0,,Жақсы ой, балақай.
Dialogue: 0,0:17:32.28,0:17:35.20,Default-ja,,0,0,0,,О, балам! Сен ақылдысың, мұнда кел.
Dialogue: 5,0:17:34.42,0:17:35.35,Default,,0,0,0,,Келіңіздер.
Dialogue: 0,0:17:35.33,0:17:37.12,Default-ja,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 5,0:17:35.35,0:17:37.12,Default,,0,0,0,,5 йен
Dialogue: 0,0:17:37.29,0:17:41.58,Default-ja,,0,0,0,,Жақсы жұмыс... (Никаидо) Аа... Көрші үй.
Dialogue: 5,0:17:37.45,0:17:39.44,Default,,0,0,0,,Және, сонда.
Dialogue: 5,0:17:39.44,0:17:41.69,Default,,0,0,0,,Уау, мен оның қасындамын!
Dialogue: 5,0:17:41.69,0:17:43.83,Default,,0,0,0,,Жарайды, мен осында барамын.
Dialogue: 0,0:17:41.71,0:17:45.50,Default-ja,,0,0,0,,Эй... Мен осында тұра аламын ба? Мен куәмін.
Dialogue: 5,0:17:43.83,0:17:45.51,Default,,0,0,0,,Мен бақылаушымын ғой.
Dialogue: 0,0:17:45.67,0:17:47.80,Default-ja,,0,0,0,,Мен екінші қатарда отырайын ба?
Dialogue: 5,0:17:45.82,0:17:47.80,Default,,0,0,0,,Екінші қатар осында отыруы керек пе?
Dialogue: 5,0:17:47.80,0:17:50.85,Default,,0,0,0,,Танабе! Сакудың артына жүр!
Dialogue: 0,0:17:47.96,0:17:50.84,Default-ja,,0,0,0,,Танабе мырза, Саку-чанның артынан қалмаңыз.
Dialogue: 5,0:17:50.85,0:17:54.00,Default,,0,0,0,,Не болды? Сіз қыдырып жүргенде мен бәріне сыйдыра алмаймын.
Dialogue: 0,0:17:51.01,0:17:53.89,Default-ja,,0,0,0,,Не болды? Кірме. Сен сондай сұмсың.
Dialogue: 5,0:17:54.00,0:17:55.52,Default,,0,0,0,,Жақынырақ кіріңіз.
Dialogue: 0,0:17:54.01,0:17:55.51,Default-ja,,0,0,0,,Солға және оңға жақынырақ!
Dialogue: 0,0:17:55.68,0:17:57.56,Default-ja,,0,0,0,,Кең бұрыш жоқ па?
Dialogue: 5,0:17:55.83,0:17:57.67,Default,,0,0,0,,Сізде кең бұрышты объектив жоқ па?
Dialogue: 5,0:17:57.67,0:18:00.49,Default,,0,0,0,,Өзің жарасып тұрсаң не болды?
Dialogue: 0,0:17:57.68,0:18:00.39,Default-ja,,0,0,0,,Кіру жақсы идея болмас еді.
Dialogue: 5,0:18:00.49,0:18:03.36,Default,,0,0,0,,Сәлем, Ган! Сіз де осында кіресіз!
Dialogue: 0,0:18:00.52,0:18:04.90,Default-ja,,0,0,0,,...Ал, Ган-чан, сен де қосыла аласың. Таймерді пайдаланыңыз.
Dialogue: 5,0:18:03.36,0:18:04.90,Default,,0,0,0,,Автоматты таймерді пайдаланыңыз!
Dialogue: 0,0:18:06.73,0:18:08.40,Default-ja,,0,0,0,,А, міне, осында.
Dialogue: 5,0:18:06.75,0:18:08.40,Default,,0,0,0,,О, міне, ол!
Dialogue: 0,0:18:08.82,0:18:10.40,Default-ja,,0,0,0,,Шимада да
Dialogue: 5,0:18:08.84,0:18:10.41,Default,,0,0,0,,Шимада, сен де!
Dialogue: 5,0:18:10.41,0:18:13.16,Default,,0,0,0,,Сіз суретте болар ма едіңіз?
Dialogue: 0,0:18:10.57,0:18:13.16,Default-ja,,0,0,0,,Өтінемін, кіре аласыз ба?
Dialogue: 0,0:18:14.32,0:18:18.16,Default-ja,,0,0,0,,Естелік сурет? Мен де?
Dialogue: 5,0:18:14.36,0:18:16.43,Default,,0,0,0,,Еске алу суреті?
Dialogue: 5,0:18:16.43,0:18:18.16,Default,,0,0,0,,Менің оған қатысқанымды қалайсың ба?
Dialogue: 0,0:18:18.17,0:18:18.21,signs,,0,0,0,,Жарқыраған
Dialogue: 1,0:18:18.17,0:18:18.21,signs,,0,0,0,,Жарқыраған
Dialogue: 0,0:18:18.17,0:18:18.21,signs,,0,0,0,,Жанды
Dialogue: 1,0:18:18.17,0:18:18.21,signs,,0,0,0,,Жанды
Dialogue: 0,0:18:18.17,0:18:18.21,signs,,0,0,0,,Жылтыр
Dialogue: 1,0:18:18.17,0:18:18.21,signs,,0,0,0,,Жылтыр
Dialogue: 0,0:18:18.17,0:18:23.42,signs,,0,0,0,,Янагихара тауары
Dialogue: 1,0:18:18.17,0:18:23.42,signs,,0,0,0,,Янагихара тауары
Dialogue: 0,0:18:18.21,0:18:18.25,signs,,0,0,0,,Жарқыраған
Dialogue: 1,0:18:18.21,0:18:18.25,signs,,0,0,0,,Жарқыраған
Dialogue: 0,0:18:18.21,0:18:18.25,signs,,0,0,0,,Жанды
Dialogue: 1,0:18:18.21,0:18:18.25,signs,,0,0,0,,Жанды
Dialogue: 0,0:18:18.21,0:18:18.25,signs,,0,0,0,,Жылтыр
Dialogue: 1,0:18:18.21,0:18:18.25,signs,,0,0,0,,Жылтыр
