Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.24,0:00:11.97,OP,,0,0,0,,Жаңа гүлдеген одуванчиктердің арасында
Dialogue: 0,0:00:11.97,0:00:15.89,OP,,0,0,0,,Қарға айнала алмаған су тамшылары
Dialogue: 0,0:00:15.89,0:00:19.76,OP,,0,0,0,,Мен көз жасына боялған жүзді ажырата аламын деп ойладым
Dialogue: 0,0:00:19.76,0:00:22.48,OP,,0,0,0,,Сондықтан мен ойланбастан қолшатырымды ұсындым
Dialogue: 0,0:00:22.48,0:00:26.59,OP,,0,0,0,,Солға немесе оңға жүру дұрыс па?
Dialogue: 0,0:00:26.59,0:00:30.40,OP,,0,0,0,,Мен шынымен шешім қабылдамай тұрып жол аяқталды
Dialogue: 0,0:00:30.40,0:00:34.45,OP,,0,0,0,,Бірақ бұл ерекше біреуді аямайтын дұрыс қоңырау екені сөзсіз
Dialogue: 0,0:00:34.45,0:00:38.38,OP,,0,0,0,,Кез келген азапты тәжірибелерден
Dialogue: 0,0:00:38.38,0:00:41.51,OP,,0,0,0,,Ендеше, кішкене батылдықпен, алға ұмтылыңыз
Dialogue: 0,0:00:41.51,0:00:45.09,OP,,0,0,0,,Егер бәрі қисық болса, қиғаш жолмен жүріңіз
Dialogue: 0,0:00:45.09,0:00:48.82,OP,,0,0,0,,Алға қарай жүрсең, нұрды табасың
Dialogue: 0,0:00:48.82,0:00:52.54,OP,,0,0,0,,Бір-біріне үйіріліп, бір дауыста сайрап тұрған кішкентай құстар сияқты
Dialogue: 0,0:00:52.54,0:00:56.14,OP,,0,0,0,,Жаңа маусымның басында міндетті түрде қоңырау шаламыз
Dialogue: 0,0:00:56.14,0:00:58.94,OP,,0,0,0,,Сонымен көктем бізді тағы да құшағына алады
Dialogue: 0,0:00:58.94,0:01:03.17,OP,,0,0,0,,Біз жаңа беттерге бояуды шашыратып жібереміз
Dialogue: 0,0:01:03.17,0:01:07.06,OP,,0,0,0,,Екеуміз тез дос болдық, жақсы тамақтандық
Dialogue: 0,0:01:07.06,0:01:09.70,OP,,0,0,0,,Біз тіпті аздап ұрысып қалған шығармыз
Dialogue: 0,0:01:09.70,0:01:13.34,OP,,0,0,0,,Бірақ біз сол кішкентай сәттерді жүрегімізде сақтаймыз
Dialogue: 0,0:01:13.34,0:01:17.07,OP,,0,0,0,,Бізді қателесуге болмайтын болашаққа итермелейтін себептер ретінде
Dialogue: 0,0:01:17.07,0:01:21.46,OP,,0,0,0,,Күн сәулесі түскен ағаштардың арасында қанша рет адасып қалсақ та
Dialogue: 0,0:01:21.46,0:01:26.06,OP,,0,0,0,,Бүгін мұнда бір жақты билетпен желдер алып кетті
Dialogue: 0,0:01:26.06,0:01:27.51,OP,,0,0,0,,Бұл тамаша күнге гүлдейді
Dialogue: 0,0:01:32.41,0:01:35.50,titles,,0,0,0,,Ағып кету
Dialogue: 0,0:01:39.61,0:01:42.45,Default-ja,,0,0,0,,Ммм...
Dialogue: 0,0:01:42.50,0:01:44.51,signs,,0,0,0,,Мастер Соуя Тоуджи
Dialogue: 1,0:01:42.50,0:01:44.51,signs,,0,0,0,,Мастер Соуя Тоуджи
Dialogue: 0,0:01:42.50,0:01:44.51,signs,,0,0,0,,Әдемі болашаққа шақыру
Dialogue: 1,0:01:42.50,0:01:44.51,signs,,0,0,0,,Әдемі болашаққа шақыру
Dialogue: 0,0:01:44.51,0:01:46.51,signs,,0,0,0,,2008 Жаңадан келген король Кирияма Рей, 5-дан
Dialogue: 1,0:01:44.51,0:01:46.51,signs,,0,0,0,,2008 Жаңадан келген король Кирияма Рей, 5-дан
Dialogue: 0,0:01:44.51,0:01:46.51,signs,,0,0,0,,43-ші жаңа ойыншылар турнирінің естелік матчы
Dialogue: 1,0:01:44.51,0:01:46.51,signs,,0,0,0,,43-ші жаңа ойыншылар турнирінің естелік матчы
Dialogue: 5,0:01:54.26,0:01:56.27,Default,,0,0,0,,Бұл не болып жатыр өзі?!
Dialogue: 0,0:01:54.67,0:01:57.80,Default-ja,,0,0,0,,Не? Бұл не? бұл постер
Dialogue: 5,0:01:56.27,0:01:57.91,Default,,0,0,0,,Бұл постер не?
Dialogue: 5,0:01:57.91,0:01:58.74,Default,,0,0,0,,Бұл не болып жатыр өзі?!
Dialogue: 0,0:01:57.92,0:02:01.09,Default-ja,,0,0,0,,Не? Бұл дизайн өте керемет
Dialogue: 5,0:01:58.74,0:02:01.15,Default,,0,0,0,,Неліктен дизайн соншалықты керемет?
Dialogue: 0,0:02:01.43,0:02:03.26,Default-ja,,0,0,0,,Өте жақсы қағаз—
Dialogue: 5,0:02:01.44,0:02:06.48,Default,,0,0,0,,Бұл өте жақсы қағазда, әріптер парақтан шығып жатқан сияқты.
Dialogue: 0,0:02:03.39,0:02:06.35,Default-ja,,0,0,0,,Оның үстіне әріптер көтерілген сияқты.
Dialogue: 0,0:02:06.47,0:02:10.10,Default-ja,,0,0,0,,Бұл жай ғана жылдың жаңа ойыншысы мен шебердің арасындағы естелік матч, солай ма?
Dialogue: 5,0:02:06.48,0:02:10.16,Default,,0,0,0,,Бұл жаңадан келген патша мен шебер арасындағы естелік шайқас, солай ма?
Dialogue: 5,0:02:10.16,0:02:15.64,Default,,0,0,0,,Оның бөліктері күңгірт түсті, ал басқа бөліктері жылтыр...
Dialogue: 0,0:02:10.35,0:02:15.57,Default-ja,,0,0,0,,Күңгірт және жылтыр бөліктер бар.
Dialogue: 5,0:02:15.64,0:02:17.20,Default,,0,0,0,,Арнайы өндіріс процесі?
Dialogue: 0,0:02:15.69,0:02:17.19,Default-ja,,0,0,0,,Арнайы өңдеу?
Dialogue: 5,0:02:17.20,0:02:18.56,Default,,0,0,0,,Бұл не болып жатыр өзі?!
Dialogue: 0,0:02:17.32,0:02:18.44,Default-ja,,0,0,0,,Не? Бұл
Dialogue: 5,0:02:18.56,0:02:21.17,Default,,0,0,0,,Неліктен олар осындай керемет плакаттар жасайды?
Dialogue: 0,0:02:18.57,0:02:21.11,Default-ja,,0,0,0,,Сіз осындай керемет постер жасадыңыз ба?
Dialogue: 0,0:02:21.29,0:02:21.34,signs,,0,0,0,,Жаб
Dialogue: 0,0:02:21.34,0:02:21.38,signs,,0,0,0,,Жаб
Dialogue: 0,0:02:21.38,0:02:21.42,signs,,0,0,0,,Жаб
Dialogue: 0,0:02:21.40,0:02:23.20,Default-ja,,0,0,0,,Иә! Сіз байқадыңыз ба?
Dialogue: 0,0:02:21.42,0:02:21.46,signs,,0,0,0,,Жаб
Dialogue: 5,0:02:21.45,0:02:21.96,Default,,0,0,0,,Иә!
Dialogue: 0,0:02:21.46,0:02:21.96,signs,,0,0,0,,Жаб
Dialogue: 5,0:02:21.96,0:02:23.29,Default,,0,0,0,,Сіз байқадыңыз ба?
Dialogue: 5,0:02:23.29,0:02:25.00,Default,,0,0,0,,Керемет, солай ма?
Dialogue: 0,0:02:23.32,0:02:24.95,Default-ja,,0,0,0,,Керемет емес пе? (Саусақтарды сермеу дыбысы)
Dialogue: 5,0:02:25.00,0:02:26.88,Default,,0,0,0,,Балалар, сендердің көздерің білгір.
Dialogue: 0,0:02:25.16,0:02:26.83,Default-ja,,0,0,0,,Күткендей, көздерің керемет!
Dialogue: 5,0:02:26.88,0:02:29.25,Default,,0,0,0,,Мен оны жасау үшін дизайнер жалдадым!
Dialogue: 0,0:02:26.99,0:02:30.62,Default-ja,,0,0,0,,Мен дизайнерден оны әдемі етіп көрсетуін сұрадым.
Dialogue: 5,0:02:29.25,0:02:30.72,Default,,0,0,0,,Мен оған салқындатуды айттым.
Dialogue: 5,0:02:30.72,0:02:32.84,Default,,0,0,0,,Мен тіпті басып шығаруға шашылдым.
Dialogue: 0,0:02:30.75,0:02:32.79,Default-ja,,0,0,0,,Мен де басып шығаруда аздап қиындық көрдім.
Dialogue: 5,0:02:32.84,0:02:35.22,Default,,0,0,0,,Оны естігім келмейді, Току!
Dialogue: 0,0:02:32.96,0:02:35.17,Default-ja,,0,0,0,,Олай айтпа, Току-чан!
Dialogue: 5,0:02:35.22,0:02:38.02,Default,,0,0,0,,Менің айтайын дегенім, біздің плакаттар осылай көрінеді!
Dialogue: 0,0:02:35.33,0:02:37.96,Default-ja,,0,0,0,,Өйткені плакатымыз осылай көрінеді.
Dialogue: 0,0:02:38.02,0:02:40.65,signs,,0,0,0,,33-ші Шоги Маэстро чемпионаты
Dialogue: 1,0:02:38.02,0:02:40.65,signs,,0,0,0,,33-ші Шоги Маэстро чемпионаты
Dialogue: 0,0:02:38.02,0:02:40.65,signs,,0,0,0,,Шоги Маэстро Янагихара Сакутару
Dialogue: 1,0:02:38.02,0:02:40.65,signs,,0,0,0,,Шоги Маэстро Янагихара Сакутару
Dialogue: 0,0:02:38.02,0:02:40.65,signs,,0,0,0,,Шимада Кай, 8-дан
Dialogue: 1,0:02:38.02,0:02:40.65,signs,,0,0,0,,Шимада Кай, 8-дан
Dialogue: 0,0:02:38.27,0:02:40.65,signs,,0,0,0,,Тек қажетті ақпарат қамтылған
Dialogue: 1,0:02:38.27,0:02:40.65,signs,,0,0,0,,Тек қажетті ақпарат қамтылған
Dialogue: 0,0:02:38.81,0:02:40.65,signs,,0,0,0,,Қарапайым
Dialogue: 1,0:02:38.81,0:02:40.65,signs,,0,0,0,,Қарапайым
Dialogue: 5,0:02:40.65,0:02:42.21,Default,,0,0,0,,Бұл сурет қашан түсірілген?
Dialogue: 0,0:02:40.88,0:02:44.09,Default-ja,,0,0,0,,Бұл сурет қашан түсірілген? Сіз фотосуреттерді қашан қайта пайдаланасыз?
Dialogue: 5,0:02:42.21,0:02:44.21,Default,,0,0,0,,Ол бастапқыда қандай жағдайда қолданылған?
Dialogue: 5,0:02:44.21,0:02:46.53,Default,,0,0,0,,Сурет түйіршіктелген!
Dialogue: 0,0:02:44.22,0:02:46.47,Default-ja,,0,0,0,,Бөлшектер сәл дөрекі.
Dialogue: 5,0:02:46.53,0:02:47.78,Default,,0,0,0,,Айтыңызшы!
Dialogue: 0,0:02:46.53,0:02:47.78,signs,,0,0,0,,Жүйке
Dialogue: 1,0:02:46.53,0:02:47.78,signs,,0,0,0,,Жүйке
Dialogue: 0,0:02:46.64,0:02:47.72,Default-ja,,0,0,0,,Эй?
Dialogue: 5,0:02:47.78,0:02:50.88,Default,,0,0,0,,Және... мұны қалай қоюға болады?
Dialogue: 0,0:02:47.97,0:02:50.77,Default-ja,,0,0,0,,Тағы не айтуым керек?
Dialogue: 5,0:02:50.88,0:02:56.58,Default,,0,0,0,,Бұл плакат кәсіби түрде емес, қауымдастық жасаған, солай емес пе?
Dialogue: 0,0:02:50.89,0:02:55.10,Default-ja,,0,0,0,,Бұл басып шығарылмаған шығар, бірақ федерация шығарған, солай ма?
Dialogue: 0,0:02:55.41,0:02:56.58,signs,,0,0,0,,Жүйке
Dialogue: 1,0:02:55.41,0:02:56.58,signs,,0,0,0,,Жүйке
Dialogue: 0,0:02:55.48,0:02:56.52,Default-ja,,0,0,0,,Тек...
Dialogue: 5,0:02:56.58,0:03:00.91,Default,,0,0,0,,Бұл ғана емес, мен мұны қалай қоятынымды білмеймін, қонақүй орналасқан жердің фотосы біртүрлі екен...
Dialogue: 0,0:02:56.65,0:03:00.86,Default-ja,,0,0,0,,Оның үстіне, қонақүйдің өтетін жердегі фотосы біртүрлі көрінеді...
Dialogue: 5,0:03:00.91,0:03:03.67,Default,,0,0,0,,жоқ, бізден әлдеқайда үлкен!
Dialogue: 0,0:03:01.03,0:03:03.61,Default-ja,,0,0,0,,Дәлірек айтқанда, бұл өте үлкен!
Dialogue: 5,0:03:05.80,0:03:07.17,Default,,0,0,0,,Дәл солай! Ицумида!
Dialogue: 0,0:03:05.80,0:03:07.17,signs,,0,0,0,,Еееек
Dialogue: 0,0:03:05.91,0:03:07.12,Default-ja,,0,0,0,,Бұл қорқынышты!
Dialogue: 0,0:03:07.45,0:03:10.20,Default-ja,,0,0,0,,Кирияма мен Соя өте жас және сүйкімді болғандықтан...
Dialogue: 5,0:03:07.48,0:03:11.55,Default,,0,0,0,,Кирияма мен Соуя сәл жас әрі сүйкімді болғандықтан бізге қалай қарай аласыз?!
Dialogue: 0,0:03:10.33,0:03:11.50,Default-ja,,0,0,0,,Не? Бұл емдеу
Dialogue: 5,0:03:11.55,0:03:14.20,Default,,0,0,0,,Менің «Мәңгілік Шоги Маэстром» атағы дайын!
Dialogue: 0,0:03:11.70,0:03:14.04,Default-ja,,0,0,0,,Мен мәңгілікке шоги ойынын ойнаймын.
Dialogue: 0,0:03:13.22,0:03:13.26,signs,,0,0,0,,Этер
Dialogue: 1,0:03:13.22,0:03:13.26,signs,,0,0,0,,Этер
