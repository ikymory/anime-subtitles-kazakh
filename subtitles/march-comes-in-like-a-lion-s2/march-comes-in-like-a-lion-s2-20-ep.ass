Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.24,0:00:11.95,OP,,0,0,0,,Жаңа гүлдеген одуванчиктердің арасында
Dialogue: 0,0:00:11.95,0:00:15.87,OP,,0,0,0,,Қарға айналмайтын су тамшылары
Dialogue: 0,0:00:15.87,0:00:19.74,OP,,0,0,0,,Мен көз жасына боялған жүзді ажырата аламын деп ойладым
Dialogue: 0,0:00:19.74,0:00:22.46,OP,,0,0,0,,Мен ойланбастан қолшатырымды ұсындым
Dialogue: 0,0:00:22.46,0:00:26.57,OP,,0,0,0,,Солға немесе оңға жүру дұрыс па?
Dialogue: 0,0:00:26.57,0:00:30.38,OP,,0,0,0,,Мен шынымен шешім қабылдамай тұрып жол аяқталды
Dialogue: 0,0:00:30.38,0:00:34.43,OP,,0,0,0,,Бірақ бұл ерекше біреуді аямайтын дұрыс қоңырау екені сөзсіз
Dialogue: 0,0:00:34.43,0:00:38.36,OP,,0,0,0,,Кез келген азапты тәжірибелерден
Dialogue: 0,0:00:38.36,0:00:41.49,OP,,0,0,0,,Ендеше, кішкене батылдықпен, алға ұмтылыңыз
Dialogue: 0,0:00:41.49,0:00:45.07,OP,,0,0,0,,Егер бәрі қисық болса, қиғаш жолмен жүріңіз
Dialogue: 0,0:00:45.07,0:00:48.80,OP,,0,0,0,,Алға қарай жүрсең, нұрды табасың
Dialogue: 0,0:00:48.80,0:00:52.52,OP,,0,0,0,,Бір-біріне үйіріліп, бір дауыста сайрап тұрған кішкентай құстар сияқты
Dialogue: 0,0:00:52.52,0:00:56.12,OP,,0,0,0,,Біз жаңа маусымның басында міндетті түрде қоңырау шаламыз
Dialogue: 0,0:00:56.12,0:00:58.92,OP,,0,0,0,,Сонымен көктем бізді тағы да құшағына алады
Dialogue: 0,0:00:58.92,0:01:03.15,OP,,0,0,0,,Біз жаңа беттерге бояуды шашыратып жібереміз
Dialogue: 0,0:01:03.15,0:01:07.04,OP,,0,0,0,,Екеуміз тез дос болдық, жақсы тамақтандық
Dialogue: 0,0:01:07.04,0:01:09.68,OP,,0,0,0,,Біз тіпті аздап ұрысып қалған шығармыз
Dialogue: 0,0:01:09.68,0:01:13.32,OP,,0,0,0,,Бірақ біз сол кішкентай сәттерді жүрегімізде сақтаймыз
Dialogue: 0,0:01:13.32,0:01:17.05,OP,,0,0,0,,Бізді қателесуге болмайтын болашаққа итермелейтін себептер ретінде
Dialogue: 0,0:01:17.05,0:01:21.44,OP,,0,0,0,,Күн сәулесі түскен ағаштардың арасында қанша рет адасып қалсақ та
Dialogue: 0,0:01:21.44,0:01:26.04,OP,,0,0,0,,Бүгін мұнда бір жақты билетпен желдер алып кетті
Dialogue: 0,0:01:26.04,0:01:27.49,OP,,0,0,0,,Бұл тамаша күнге гүлдейді
Dialogue: 0,0:01:32.41,0:01:35.50,titles,,0,0,0,,Жазғы демалыс (2 бөлім)
Dialogue: 0,0:01:57.14,0:01:58.77,Default-ja,,0,0,0,,О...
Dialogue: 0,0:02:01.77,0:02:04.78,signs,,0,0,0,,Шие гүлінен жасалған желе
Dialogue: 1,0:02:01.77,0:02:04.78,signs,,0,0,0,,Шие гүлінің желеі
Dialogue: 0,0:02:01.77,0:02:04.78,signs,,0,0,0,,Шие гүлінің муссы!
Dialogue: 1,0:02:01.77,0:02:04.78,signs,,0,0,0,,Шие гүлі муссы!
Dialogue: 0,0:02:01.77,0:02:04.78,signs,,0,0,0,,Сары күріш ұнынан жасалған тұшпара
Dialogue: 1,0:02:01.77,0:02:04.78,signs,,0,0,0,,Сары күріш ұнынан жасалған тұшпара
Dialogue: 0,0:02:01.77,0:02:04.78,signs,,0,0,0,,Көк шайдан жасалған күріш торты
Dialogue: 1,0:02:01.77,0:02:04.78,signs,,0,0,0,,Көк шайдан жасалған күріш торты
Dialogue: 0,0:02:01.77,0:02:04.78,signs,,0,0,0,,Құрамында қызыл бұршақ кептелісі бар!
Dialogue: 1,0:02:01.77,0:02:04.78,signs,,0,0,0,,Құрамында қызыл бұршақ кептелісі бар!
Dialogue: 0,0:02:01.77,0:02:04.78,signs,,0,0,0,,Су тамшылары бар желе
Dialogue: 1,0:02:01.77,0:02:04.78,signs,,0,0,0,,Су тамшылары бар желе
Dialogue: 0,0:02:01.77,0:02:04.78,signs,,0,0,0,,Көпіршік!
Dialogue: 1,0:02:01.77,0:02:04.78,signs,,0,0,0,,Көпіршік!
Dialogue: 0,0:02:01.77,0:02:04.78,signs,,0,0,0,,Ішінде балмұздақ бар азуки бұршағы
Dialogue: 1,0:02:01.77,0:02:04.78,signs,,0,0,0,,Ішінде балмұздақ бар азуки бұршағы
Dialogue: 0,0:02:01.77,0:02:04.78,signs,,0,0,0,,Құлпынай
Dialogue: 1,0:02:01.77,0:02:04.78,signs,,0,0,0,,Құлпынай
Dialogue: 0,0:02:01.77,0:02:04.78,signs,,0,0,0,,Сиропты пудинг
Dialogue: 1,0:02:01.77,0:02:04.78,signs,,0,0,0,,Сиропты пудинг
Dialogue: 5,0:02:04.78,0:02:07.18,Default,,0,0,0,,Сіз көп сурет салдыңыз.
Dialogue: 0,0:02:04.94,0:02:07.36,Default-ja,,0,0,0,,Мен көп сурет салдым.
Dialogue: 0,0:02:08.78,0:02:12.78,signs,,0,0,0,,Мысықтың инфекциясы
Dialogue: 1,0:02:08.78,0:02:12.78,signs,,0,0,0,,Мысықтың инфекциясы
Dialogue: 0,0:02:08.78,0:02:12.78,signs,,0,0,0,,Шөптің үстінде ұйықтап жатқандай!
Dialogue: 1,0:02:08.78,0:02:12.78,signs,,0,0,0,,Шөптің үстінде ұйықтап жатқандай!
Dialogue: 0,0:02:08.78,0:02:12.78,signs,,0,0,0,,Құлпынай
Dialogue: 1,0:02:08.78,0:02:12.78,signs,,0,0,0,,Құлпынай
Dialogue: 0,0:02:08.78,0:02:12.78,signs,,0,0,0,,Лимон
Dialogue: 1,0:02:08.78,0:02:12.78,signs,,0,0,0,,Лимон
Dialogue: 0,0:02:08.78,0:02:12.78,signs,,0,0,0,,Алтын балық желе (сода хош иістендірілген болуы мүмкін!)
Dialogue: 1,0:02:08.78,0:02:12.78,signs,,0,0,0,,Алтын балық желе (сода хош иістендірілген болуы мүмкін!)
Dialogue: 0,0:02:08.78,0:02:12.78,signs,,0,0,0,,Шие гүлі
Dialogue: 1,0:02:08.78,0:02:12.78,signs,,0,0,0,,Шие гүлі
Dialogue: 0,0:02:08.78,0:02:12.78,signs,,0,0,0,,Жапондық ақ көз инфекциясы
Dialogue: 1,0:02:08.78,0:02:12.78,signs,,0,0,0,,Жапондық ақ көз инфекциясы
Dialogue: 0,0:02:08.78,0:02:12.78,signs,,0,0,0,,Қызғылт қант кәмпит жұлдыздары
Dialogue: 1,0:02:08.78,0:02:12.78,signs,,0,0,0,,Қызғылт қант кәмпит жұлдыздары
Dialogue: 0,0:02:08.78,0:02:12.78,signs,,0,0,0,,Жұлдызды аспан агары
Dialogue: 1,0:02:08.78,0:02:12.78,signs,,0,0,0,,Жұлдызды аспан агары
Dialogue: 0,0:02:08.78,0:02:12.78,signs,,0,0,0,,Маңайдағы үлкен көпір
Dialogue: 1,0:02:08.78,0:02:12.78,signs,,0,0,0,,Маңайдағы үлкен көпір
Dialogue: 0,0:02:08.78,0:02:12.78,signs,,0,0,0,,Жарқыраған жұлдыздар!
Dialogue: 1,0:02:08.78,0:02:12.78,signs,,0,0,0,,Жарқыраған жұлдыздар!
Dialogue: 0,0:02:13.41,0:02:16.28,Default-ja,,0,0,0,,Бұл өте әдемі және дәмді көрінеді.
Dialogue: 5,0:02:13.44,0:02:16.29,Default,,0,0,0,,Олар өте әдемі және дәмді көрінеді.
Dialogue: 0,0:02:16.66,0:02:18.04,Default-ja,,0,0,0,,Дұрыс? Дұрыс па?
Dialogue: 5,0:02:16.71,0:02:18.04,Default,,0,0,0,,Ах, таңертең ерте келіп жұмыс істегеніңе рахмет.
Dialogue: 0,0:02:18.20,0:02:20.33,Default-ja,,0,0,0,,Жолақты желе Сүйкімді емес пе?
Dialogue: 5,0:02:18.34,0:02:20.41,Default,,0,0,0,,Жолақ желе сүйкімді, солай емес пе?
Dialogue: 5,0:02:20.41,0:02:23.48,Default,,0,0,0,,Ал желе шарлары су тамшыларына ұқсайды, солай ма?
Dialogue: 0,0:02:20.46,0:02:23.67,Default-ja,,0,0,0,,Сондай-ақ, желе шарлары полка нүктелеріне ұқсамайды ма?
Dialogue: 0,0:02:27.75,0:02:31.42,Default-ja,,0,0,0,,Атам келесі жылы қайталайтынымды айтты.
Dialogue: 5,0:02:27.77,0:02:31.24,Default,,0,0,0,,Атам келесі жылы қайталай аламыз деді.
Dialogue: 5,0:02:31.68,0:02:39.13,Default,,0,0,0,,Негізі, мен мұны жазғы фестиваль мен Жаңа жыл мерекесіне де жасағым келеді.
Dialogue: 0,0:02:31.84,0:02:36.43,Default-ja,,0,0,0,,Негізінде, бұл жазғы фестивальдерге, жыл аяғына және жаңа жылдық мерекелерге және т.б.
Dialogue: 0,0:02:36.60,0:02:39.27,Default-ja,,0,0,0,,Мен мұны жақын арада қайталағым келеді.
Dialogue: 0,0:02:44.35,0:02:45.44,Default-ja,,0,0,0,,Бұл—
Dialogue: 5,0:02:44.38,0:02:45.44,Default,,0,0,0,,Мен сенің жаныңа дүрлігіп бара жатырмын, дірілдеп
Dialogue: 0,0:02:45.77,0:02:47.94,Default-ja,,0,0,0,,Үй тапсырмасы...
Dialogue: 5,0:02:45.80,0:02:47.95,Default,,0,0,0,,Үй тапсырмасын таудай етіп алдым.
Dialogue: 0,0:02:46.23,0:02:47.95,signs,,0,0,0,,Үйінді
Dialogue: 1,0:02:46.23,0:02:47.95,signs,,0,0,0,,Үйінді
Dialogue: 5,0:02:50.07,0:02:53.69,Default,,0,0,0,,Кәмпиттер туралы осы идеялардың бәрі менің басымда пайда болады,
Dialogue: 0,0:02:50.23,0:02:53.57,Default-ja,,0,0,0,,Дәл қазір менің ойыма тәттілер туралы көптеген идеялар келеді.
Dialogue: 5,0:02:53.69,0:02:57.83,Default,,0,0,0,,бірақ менде көптеген үй тапсырмалары мен жазғы демалыста міндетті оқу күндері бар!
Dialogue: 0,0:02:53.70,0:02:57.83,Default-ja,,0,0,0,,Жазғы каникулда үй тапсырмалары мен оқу күндері көп болатынына сене алар емеспін...
Dialogue: 0,0:03:04.00,0:03:06.33,Default-ja,,0,0,0,,Бұл өте көп...
Dialogue: 5,0:03:04.01,0:03:06.34,Default,,0,0,0,,Бұл өте көп.
Dialogue: 5,0:03:06.91,0:03:07.88,Default,,0,0,0,,Оқу, оқу
Dialogue: 5,0:03:11.80,0:03:15.47,Default,,0,0,0,,Біз орта мектептің соңғы курсындамыз, бірақ сыныпта көп нәрсе болғандықтан,
Dialogue: 0,0:03:11.80,0:03:15.47,Default-ja,,0,0,0,,Сыныпта үшінші курста болсам да, көп нәрсе болды.
Dialogue: 0,0:03:16.26,0:03:19.51,Default-ja,,0,0,0,,Мен үйге кешігіп қалдым, т.б.
Dialogue: 5,0:03:16.35,0:03:19.37,Default,,0,0,0,,үй бөлмесі шынымен артта қалды.
Dialogue: 0,0:03:27.52,0:03:28.86,Default-ja,,0,0,0,,Сонымен...
Dialogue: 5,0:03:27.55,0:03:28.61,Default,,0,0,0,,Тек сен ғана, Хиёри-чан, осы жаққа келуге рұқсат
Dialogue: 0,0:03:39.08,0:03:43.25,Default-ja,,0,0,0,,Рей-чан неше жасында кәсіби шоги ойыншысы боламын деп шешті?
Dialogue: 5,0:03:39.09,0:03:43.25,Default,,0,0,0,,Рей, сен алғаш рет кәсіби шоги ойыншысы болғың келгенде неше жаста едің?
Dialogue: 0,0:04:02.39,0:04:04.02,Default-ja,,0,0,0,,Дұрыс...
Dialogue: 5,0:04:02.44,0:04:04.03,Default,,0,0,0,,Ал...
Dialogue: 5,0:04:04.03,0:04:06.76,Default,,0,0,0,,Мен төртінші сыныпта оқитын сияқтымын.
Dialogue: 0,0:04:04.14,0:04:06.94,Default-ja,,0,0,0,,Мен 4-сыныпта оқып жүрген кезімде...шамасы
Dialogue: 0,0:04:20.58,0:04:21.74,Default-ja,,0,0,0,,Жоқ…
Dialogue: 5,0:04:20.63,0:04:21.60,Default,,0,0,0,,Ақыры заман мені қуып жетті ме?
Dialogue: 0,0:04:22.99,0:04:24.45,Default-ja,,0,0,0,,Жоқ.
Dialogue: 5,0:04:23.02,0:04:24.24,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 5,0:04:25.77,0:04:27.02,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:04:25.79,0:04:27.25,Default-ja,,0,0,0,,Мүмкін емес
Dialogue: 5,0:04:30.63,0:04:34.38,Default,,0,0,0,,Бір кезде мен бұл жалғыз жол екенін түсіндім.
Dialogue: 0,0:04:30.63,0:04:34.38,Default-ja,,0,0,0,,Мен мұны білмей тұрып, бұл жалғыз жол қалды.
Dialogue: 0,0:04:35.42,0:04:36.88,Default-ja,,0,0,0,,...немесе айту керек пе—
Dialogue: 5,0:04:35.43,0:04:36.89,Default,,0,0,0,,Немесе,
Dialogue: 0,0:04:37.72,0:04:41.26,Default-ja,,0,0,0,,Менің ойымша, бұл менің қолымнан келетін жалғыз нәрсе болды.
Dialogue: 5,0:04:37.75,0:04:41.26,Default,,0,0,0,,бұл мен қалай істеу керектігін білетін жалғыз нәрсе болды.
Dialogue: 0,0:04:43.68,0:04:45.27,Default-ja,,0,0,0,,О, түсіндім.
Dialogue: 5,0:04:43.72,0:04:45.27,Default,,0,0,0,,О, дұрыс.
Dialogue: 0,0:04:45.27,0:04:46.90,signs,,0,0,0,,Шие гүлінің муссы!
Dialogue: 1,0:04:45.27,0:04:46.90,signs,,0,0,0,,Шие гүлі муссы!
Dialogue: 0,0:04:45.27,0:04:46.90,signs,,0,0,0,,Су тамшылары бар желе
Dialogue: 1,0:04:45.27,0:04:46.90,signs,,0,0,0,,Су тамшылары бар желе
Dialogue: 0,0:04:45.27,0:04:46.90,signs,,0,0,0,,Көк шайдан жасалған күріш торты
Dialogue: 1,0:04:45.27,0:04:46.90,signs,,0,0,0,,Көк шайдан жасалған күріш торты
Dialogue: 0,0:04:45.27,0:04:46.90,signs,,0,0,0,,Құрамында қызыл бұршақ кептелісі бар!
Dialogue: 1,0:04:45.27,0:04:46.90,signs,,0,0,0,,Құрамында қызыл бұршақ кептелісі бар!
Dialogue: 5,0:04:46.90,0:04:51.27,Default,,0,0,0,,Сіз атаңыздың дүкенін жақсы көресіз, сондықтан сол жерде көмектескіңіз келеді, солай ма?
Dialogue: 0,0:04:47.06,0:04:49.98,Default-ja,,0,0,0,,Хина-чан атасының дүкенін ұнатады.
Dialogue: 0,0:04:50.10,0:04:51.27,Default-ja,,0,0,0,,Сіз көмектескіңіз келеді, солай ма?
Dialogue: 5,0:04:53.48,0:04:54.37,Default,,0,0,0,,Оқу, оқу
Dialogue: 5,0:04:55.78,0:05:00.30,Default,,0,0,0,,Дәл қазір мен көп нәрсе істегім келеді, олардың бәрі менің алдымда,
Dialogue: 0,0:04:55.94,0:05:00.16,Default-ja,,0,0,0,,Мен дәл қазір не істегім келетінін көріп тұрсам да, ол менің алдымда.
Dialogue: 0,0:05:00.28,0:05:02.99,Default-ja,,0,0,0,,Мен оған қол тигізбеу керек деп абдырап тұрмын.
Dialogue: 5,0:05:00.30,0:05:02.77,Default,,0,0,0,,бірақ мен оларға қол тигізе алмаймын, бұл мені қынжылтады.
Dialogue: 5,0:05:03.29,0:05:07.29,Default,,0,0,0,,Немесе мен жай ғана алаңдатқысы келетін шығармын.
Dialogue: 0,0:05:03.45,0:05:07.29,Default-ja,,0,0,0,,Әлде мен жай ғана басқа жаққа қарағым келеді ме?
Dialogue: 0,0:05:09.08,0:05:13.29,Default-ja,,0,0,0,,Көптеген үй тапсырмалары, тесттер, қабылдау емтихандары...
Dialogue: 5,0:05:09.09,0:05:13.30,Default,,0,0,0,,Үй тапсырмасы тауынан, алдағы сынақтар немесе менің қабылдау емтихандарым.
Dialogue: 0,0:05:14.67,0:05:17.38,Default-ja,,0,0,0,,Бірақ бұл олардың таңдауы бойынша мектеп десе де...
Dialogue: 5,0:05:14.70,0:05:21.21,Default,,0,0,0,,Адамдар орта мектепті таңда дейді, бірақ мен өзімді орта мектеп оқушысы ретінде елестете де алмаймын.
Dialogue: 0,0:05:17.51,0:05:21.34,Default-ja,,0,0,0,,Мен өзімді әлі де мектеп оқушысы ретінде елестете алмаймын.
Dialogue: 0,0:05:22.64,0:05:25.81,Default-ja,,0,0,0,,«Сіз онда жақсы жұмыс істей аласыз ба?» және т.б....
Dialogue: 5,0:05:22.67,0:05:25.81,Default,,0,0,0,,Онда мен үшін жағдай жақсы болатынын білмеймін.
Dialogue: 0,0:05:26.68,0:05:30.81,Default-ja,,0,0,0,,Бейтаныс адамдардың арасына тағы бару...
Dialogue: 5,0:05:26.70,0:05:30.81,Default,,0,0,0,,Мен танымайтын басқа адамдар тобына қосылу...
Dialogue: 0,0:05:33.48,0:05:36.82,Default-ja,,0,0,0,,Мен мұны жақсы айта алмаймын...
Dialogue: 5,0:05:33.51,0:05:36.66,Default,,0,0,0,,Мен оны нақты түсіндіре алмаймын деп ойлаймын.
Dialogue: 5,0:05:44.12,0:05:47.54,Default,,0,0,0,,Хина, егер қаласаңыз,
Dialogue: 0,0:05:44.12,0:05:44.95,Default-ja,,0,0,0,,Хина-чан
Dialogue: 0,0:05:45.12,0:05:49.71,Default-ja,,0,0,0,,Жақсы болса, келесі сенбі...
Dialogue: 5,0:05:48.20,0:05:49.71,Default,,0,0,0,,және сенбі күні бос болмасаңыз...
Dialogue: 5,0:06:00.72,0:06:04.57,Default,,0,0,0,,Гүлдер, бұл гүлдер!
Dialogue: 0,0:06:06.89,0:06:08.47,Default-ja,,0,0,0,,Кирияма-кун!
Dialogue: 5,0:06:07.09,0:06:08.48,Default,,0,0,0,,Кирияма!
Dialogue: 0,0:06:08.64,0:06:12.98,Default-ja,,0,0,0,,Ал, күн ашық. Хохохохо!
Dialogue: 5,0:06:08.77,0:06:11.49,Default,,0,0,0,,Бұл жақсы және ашық күн, солай емес пе?
Dialogue: 0,0:06:12.98,0:06:14.73,signs,,0,0,0,,Хох
Dialogue: 0,0:06:12.98,0:06:14.73,signs,,0,0,0,,Хох
Dialogue: 0,0:06:12.98,0:06:14.73,signs,,0,0,0,,Хох
Dialogue: 0,0:06:14.90,0:06:19.24,Default-ja,,0,0,0,,Бүгін мені шақырғандарыңызға көп рахмет.
Dialogue: 5,0:06:15.05,0:06:19.24,Default,,0,0,0,,Бүгін бізді шақырғандарыңызға көп рахмет.
Dialogue: 0,0:06:15.73,0:06:15.77,signs,,0,0,0,,Терең тағзым
Dialogue: 0,0:06:15.77,0:06:15.81,signs,,0,0,0,,Терең тағзым
