Dialogue: 1,0:10:17.23,0:10:17.85,signs,,0,0,0,,Нұсқау
Dialogue: 5,0:10:17.70,0:10:18.94,Default,,0,0,0,,Ол өте қамқор!
Dialogue: 0,0:10:17.85,0:10:18.48,signs,,0,0,0,,Анықтама
Dialogue: 1,0:10:17.85,0:10:18.48,signs,,0,0,0,,Шақыру
Dialogue: 0,0:10:17.85,0:10:18.48,signs,,0,0,0,,Анықтама
Dialogue: 1,0:10:17.85,0:10:18.48,signs,,0,0,0,,Нұсқау
Dialogue: 0,0:10:18.48,0:10:19.10,signs,,0,0,0,,Нұсқау
Dialogue: 1,0:10:18.48,0:10:19.10,signs,,0,0,0,,Нұсқау
Dialogue: 0,0:10:18.48,0:10:19.10,signs,,0,0,0,,Нұсқау
Dialogue: 1,0:10:18.48,0:10:19.10,signs,,0,0,0,,Нұсқау
Dialogue: 5,0:10:18.94,0:10:20.48,Default,,0,0,0,,Уау! Бұл үлкен көмек!
Dialogue: 0,0:10:18.97,0:10:20.48,Default-ja,,0,0,0,,Керемет! Бұл пайдалы!
Dialogue: 0,0:10:19.10,0:10:19.72,signs,,0,0,0,,Нұсқау
Dialogue: 1,0:10:19.10,0:10:19.72,signs,,0,0,0,,Шақыру
