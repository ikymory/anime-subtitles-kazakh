Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.11,0:00:06.07,Default-ja,,0,0,0,,Әпке, жарайды.
Dialogue: 5,0:00:04.13,0:00:05.97,Default,,0,0,0,,Бәрі жақсы болады.
Dialogue: 0,0:00:06.65,0:00:10.16,Default-ja,,0,0,0,,Рахмет, Хина барын салады.
Dialogue: 5,0:00:06.67,0:00:08.10,Default,,0,0,0,,Кел де жуынып ал.
Dialogue: 5,0:00:08.10,0:00:10.00,Default,,0,0,0,,Мен сонда ілінемін.
Dialogue: 5,0:00:10.62,0:00:13.17,Default,,0,0,0,,Рахмет, әпке.
Dialogue: 0,0:00:10.78,0:00:13.24,Default-ja,,0,0,0,,Рахмет, әпке
Dialogue: 5,0:00:16.60,0:00:18.01,Default,,0,0,0,,Бөліп алғаным үшін кешіріңіз.
Dialogue: 0,0:00:16.62,0:00:19.33,Default-ja,,0,0,0,,Кешіріңіз, сэр.
Dialogue: 5,0:00:18.01,0:00:19.38,Default,,0,0,0,,О, Кокубу мырза.
Dialogue: 5,0:00:19.88,0:00:22.71,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:00:19.88,0:00:22.63,Default-ja,,0,0,0,,Әпке, көңіл күйіңіз қалай?
Dialogue: 5,0:00:22.71,0:00:24.57,Default,,0,0,0,,Мен шынымен кешірім сұраймын.
Dialogue: 0,0:00:22.75,0:00:26.59,Default-ja,,0,0,0,,Кешіріңіз, мұғалім, у... қазір бәрі жақсы.
Dialogue: 5,0:00:24.57,0:00:26.79,Default,,0,0,0,,Ум, мен өзімді жақсы сезінемін, сондықтан...
Dialogue: 0,0:00:26.72,0:00:28.84,Default-ja,,0,0,0,,А, а... дәл солай, дәл солай
Dialogue: 5,0:00:26.79,0:00:28.89,Default,,0,0,0,,Жарайды. Тұрудың қажеті жоқ.
Dialogue: 0,0:00:29.84,0:00:32.39,Default-ja,,0,0,0,,Мм... мұғалім
Dialogue: 5,0:00:29.87,0:00:35.89,Default,,0,0,0,,Кокубу мырза, мен бұрын дөрекі болған едім...
Dialogue: 0,0:00:32.51,0:00:37.60,Default-ja,,0,0,0,,Бұрынғы қолайсыздық үшін кешірім сұраймын...
Dialogue: 5,0:00:36.32,0:00:37.65,Default,,0,0,0,,Олар дәл қашан осы үйдің бір бөлігіне айналды?
Dialogue: 5,0:00:37.65,0:00:43.28,Default,,0,0,0,,Сізде өкінетін ештеңе жоқ.
Dialogue: 0,0:00:37.81,0:00:43.23,Default-ja,,0,0,0,,Әй, апа, уайымдайтын ештеңе жоқ.
Dialogue: 5,0:00:44.51,0:00:46.03,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:00:44.53,0:00:47.78,Default-ja,,0,0,0,,Жарайды, бірақ...
Dialogue: 5,0:00:46.39,0:00:48.03,Default,,0,0,0,,Ең бастысы...
Dialogue: 0,0:00:48.36,0:00:53.03,Default-ja,,0,0,0,,Енді не болатынын айтайық.
Dialogue: 5,0:00:48.38,0:00:49.03,Default,,0,0,0,,Олай болса,
Dialogue: 5,0:00:50.22,0:00:52.90,Default,,0,0,0,,неге келесі қадамдарымызды талқыламаймыз?
Dialogue: 0,0:01:02.80,0:01:05.53,OP,,0,0,0,,Жаңа гүлдеген одуванчиктердің арасында
Dialogue: 0,0:01:05.53,0:01:09.45,OP,,0,0,0,,Қарға айналмайтын су тамшылары
Dialogue: 0,0:01:09.45,0:01:13.32,OP,,0,0,0,,Мен көз жасына боялған жүзді ажырата аламын деп ойладым
Dialogue: 0,0:01:13.32,0:01:16.04,OP,,0,0,0,,Мен ойланбастан қолшатырымды ұсындым
Dialogue: 0,0:01:16.04,0:01:20.15,OP,,0,0,0,,Солға немесе оңға жүру дұрыс па?
Dialogue: 0,0:01:20.15,0:01:23.96,OP,,0,0,0,,Мен шынымен шешім қабылдамай тұрып жол аяқталды
Dialogue: 0,0:01:23.96,0:01:28.01,OP,,0,0,0,,Бірақ бұл ерекше біреуді аямайтын дұрыс қоңырау екені сөзсіз
Dialogue: 0,0:01:28.01,0:01:31.94,OP,,0,0,0,,Кез келген азапты тәжірибелерден
Dialogue: 0,0:01:31.94,0:01:35.07,OP,,0,0,0,,Ендеше, кішкене батылдықпен, алға ұмтылыңыз
Dialogue: 0,0:01:35.07,0:01:38.65,OP,,0,0,0,,Егер бәрі қисық болса, қиғаш жолмен жүріңіз
Dialogue: 0,0:01:38.65,0:01:42.38,OP,,0,0,0,,Алға қарай жүрсең, нұрды табасың
Dialogue: 0,0:01:42.38,0:01:46.10,OP,,0,0,0,,Бір-біріне үйіріліп, бір дауыста сайрап тұрған кішкентай құстар сияқты
Dialogue: 0,0:01:46.10,0:01:49.70,OP,,0,0,0,,Біз жаңа маусымның басында міндетті түрде қоңырау шаламыз
Dialogue: 0,0:01:49.70,0:01:52.50,OP,,0,0,0,,Сонымен көктем бізді тағы да құшағына алады
Dialogue: 0,0:01:52.50,0:01:56.73,OP,,0,0,0,,Біз жаңа беттерге бояуды шашыратып жібереміз
Dialogue: 0,0:01:56.73,0:02:00.62,OP,,0,0,0,,Екеуміз тез дос болдық, жақсы тамақтандық
Dialogue: 0,0:02:00.62,0:02:03.26,OP,,0,0,0,,Біз тіпті аздап ұрысып қалған шығармыз
Dialogue: 0,0:02:03.26,0:02:06.90,OP,,0,0,0,,Бірақ біз сол кішкентай сәттерді жүрегімізде сақтаймыз
Dialogue: 0,0:02:06.90,0:02:10.63,OP,,0,0,0,,Бізді қателесуге болмайтын болашаққа итермелейтін себептер ретінде
Dialogue: 0,0:02:10.63,0:02:15.02,OP,,0,0,0,,Күн сәулесі түскен ағаштардың арасында қанша рет адасып қалсақ та
Dialogue: 0,0:02:15.02,0:02:19.62,OP,,0,0,0,,Бүгін мұнда бір жақты билетпен желдер алып кетті
Dialogue: 0,0:02:19.62,0:02:21.07,OP,,0,0,0,,Бұл тамаша күнге гүлдейді
Dialogue: 0,0:02:25.92,0:02:29.01,titles,,0,0,0,,Кішкентай алақан
Dialogue: 5,0:02:31.79,0:02:33.01,Default,,0,0,0,,Сәлем, Кокубу мырза.
Dialogue: 0,0:02:31.80,0:02:32.97,Default-ja,,0,0,0,,Сәлем, мұғалім
Dialogue: 5,0:02:34.18,0:02:37.02,Default,,0,0,0,,Қашанға дейін мені осында шақыра бересің?
Dialogue: 0,0:02:34.18,0:02:36.97,Default-ja,,0,0,0,,Мен қанша уақытқа дейін шақырыладым?
Dialogue: 5,0:02:41.88,0:02:42.77,Default,,0,0,0,,9-эпизод
Dialogue: 0,0:02:41.89,0:02:45.23,Default-ja,,0,0,0,,...Дәлірек айтсақ, кешірім сұрадың, солай ма?
Dialogue: 5,0:02:43.75,0:02:45.27,Default,,0,0,0,,Мен кешірім сұрадым.
Dialogue: 5,0:02:45.69,0:02:46.40,Default,,0,0,0,,Ұзақ жұмыс күнінен кейін бір шыныаяқ сакэ ішуден артық ештеңе жоқ!
Dialogue: 0,0:02:45.69,0:02:46.56,Default-ja,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:02:48.90,0:02:51.24,Default-ja,,0,0,0,,О, аузыңмен емес.
Dialogue: 5,0:02:48.91,0:02:51.06,Default,,0,0,0,,Иә. Сөздеріңмен.
Dialogue: 5,0:02:54.10,0:02:57.33,Default,,0,0,0,,Мен істеген ісім үшін өкінемін.
Dialogue: 0,0:02:54.49,0:02:57.49,Default-ja,,0,0,0,,Сәлем~ Кешіріңіз.
Dialogue: 5,0:03:00.86,0:03:04.88,Default,,0,0,0,,Мен кешірім сұрадым, мен сабақта аузымды жауып отырмын.
Dialogue: 0,0:03:00.87,0:03:04.83,Default-ja,,0,0,0,,Сіз дұрыс кешірім сұрап, үндемей жатқандықтан...
Dialogue: 5,0:03:05.77,0:03:07.38,Default,,0,0,0,,Бұл жеткілікті емес пе?
Dialogue: 0,0:03:05.79,0:03:07.34,Default-ja,,0,0,0,,Жетеді, солай ма?
Dialogue: 5,0:03:10.88,0:03:15.89,Default,,0,0,0,,Жұмыстың бір бөлігі сіздің не істегеніңіз туралы хабардар болу.
Dialogue: 0,0:03:10.88,0:03:15.84,Default-ja,,0,0,0,,Сіздің не істегеніңізді түсінуге көмектесу менің жұмысымның бір бөлігі.
Dialogue: 5,0:03:18.03,0:03:20.34,Default,,0,0,0,,Мен бұл туралы білсем не болады?
Dialogue: 0,0:03:18.14,0:03:21.89,Default-ja,,0,0,0,,Оны түсінгенде не болады? Бірдеңе өзгере ме?
Dialogue: 5,0:03:20.34,0:03:22.14,Default,,0,0,0,,Бір нәрсе өзгере ме?
Dialogue: 5,0:03:23.10,0:03:25.90,Default,,0,0,0,,Егер бірдеңе өзгерсе, мен одан жақсы нәрсе аламын ба?
Dialogue: 0,0:03:23.10,0:03:25.85,Default-ja,,0,0,0,,Өзгерудің жақсы жағы бар ма?
Dialogue: 0,0:03:27.81,0:03:29.27,Default-ja,,0,0,0,,Сәлем, мұғалім
Dialogue: 5,0:03:27.82,0:03:29.11,Default,,0,0,0,,Айтыңызшы, Кокубу мырза.
Dialogue: 5,0:03:29.74,0:03:33.77,Default,,0,0,0,,Біз өмір сүре берсек, жақсы нәрсе бола ма?
Dialogue: 0,0:03:29.77,0:03:33.95,Default-ja,,0,0,0,,Біздің өмірімізде біз үшін жақсы нәрсе бола ма?
Dialogue: 0,0:03:35.70,0:03:38.37,Default-ja,,0,0,0,,Ана, әке, барлығы
Dialogue: 5,0:03:35.71,0:03:43.20,Default,,0,0,0,,Менің ата-анам және менің айналамдағылардың бәрі жақсы орта мектепке түсу үшін қолыңнан келгеннің бәрін жаса және жақсы оқы,
Dialogue: 0,0:03:38.49,0:03:42.91,Default-ja,,0,0,0,,Жақсы оқу керек, жақсы мектепте оқу керек дейді.
Dialogue: 5,0:03:43.20,0:03:49.49,Default,,0,0,0,,бірақ мен жақсы оқу орнына түссем де, жақсы компанияға жұмысқа тұрамын деп кім айта алады?
Dialogue: 0,0:03:43.37,0:03:46.46,Default-ja,,0,0,0,,Жақсы компанияны былай қойғанда, жақсы мектепке түссең де—
Dialogue: 0,0:03:46.58,0:03:49.67,Default-ja,,0,0,0,,Сіз қазір жұмысқа тұра алатыныңызды білмейсіз бе?
Dialogue: 5,0:03:53.42,0:03:56.00,Default,,0,0,0,,«Қолыңнан келгеннің бәрін жасасаң, жақсы нәтижеге жетесің».
Dialogue: 0,0:03:53.46,0:03:55.97,Default-ja,,0,0,0,,«Еңбек етсең, жақсылық болады»—
Dialogue: 5,0:03:56.00,0:03:59.74,Default,,0,0,0,,Бұған кепілдік жоқ, сонда да адамдар: «Қолыңнан келгеннің бәрін жаса!» дейді.
Dialogue: 0,0:03:56.09,0:03:59.51,Default-ja,,0,0,0,,Ешқандай кепілдік болмаса да, «Қолыңнан келгеннің бәрін істе, барыңды істе».
Dialogue: 5,0:03:59.74,0:04:01.02,Default,,0,0,0,,Бұл ақылсыздық емес пе?
Dialogue: 0,0:03:59.85,0:04:01.22,Default-ja,,0,0,0,,Бұл біртүрлі емес пе?
Dialogue: 5,0:04:01.93,0:04:07.44,Default,,0,0,0,,Қолымнан келгенше жұмыс істесем, бірақ нәтиже шықпаса, ешкім жауапкершілікке тартылмайды деген сияқты.
Dialogue: 0,0:04:01.93,0:04:05.23,Default-ja,,0,0,0,,Қатты тырысқаннан кейін нәтиже шықпаса да...
Dialogue: 0,0:04:05.35,0:04:07.40,Default-ja,,0,0,0,,Ешкім жауапкершілік алмайды, солай ма?
Dialogue: 0,0:04:09.11,0:04:11.15,Default-ja,,0,0,0,,Хмм, түсіндім...
Dialogue: 5,0:04:09.97,0:04:11.19,Default,,0,0,0,,Б... бір сызық
Dialogue: 0,0:04:12.40,0:04:15.65,Default-ja,,0,0,0,,Сонымен сіз: «Мен болашаққа алаңдадым» дедіңіз.
Dialogue: 5,0:04:12.41,0:04:15.70,Default,,0,0,0,,Сондықтан сіз болашаққа алаңдайсыз.
Dialogue: 5,0:04:16.57,0:04:20.12,Default,,0,0,0,,Ал ата-анаң сені түсінбейді.
Dialogue: 0,0:04:16.57,0:04:20.07,Default-ja,,0,0,0,,«Ата-анам мені түсінбейді»
Dialogue: 5,0:04:23.04,0:04:24.16,Default,,0,0,0,,Көремін, көремін.
Dialogue: 0,0:04:23.04,0:04:25.37,Default-ja,,0,0,0,,Хмм... солай ма?
Dialogue: 5,0:04:24.66,0:04:25.42,Default,,0,0,0,,Сонымен?
Dialogue: 5,0:04:27.87,0:04:32.13,Default,,0,0,0,,Мұның қай бөлігінің Кавамото мен Сакураға қатысы бар?
Dialogue: 0,0:04:27.87,0:04:32.25,Default-ja,,0,0,0,,Мұның қай бөлігінің Кавамото мен Сакураға қатысы бар?
Dialogue: 5,0:04:32.72,0:04:35.05,Default,,0,0,0,,Бұл мүлдем қатысы жоқ, солай ма?
Dialogue: 0,0:04:32.75,0:04:35.01,Default-ja,,0,0,0,,Бұл мүлдем маңызды емес.
Dialogue: 5,0:04:36.30,0:04:41.64,Default,,0,0,0,,Бәріне қоғам кінәлі деген қорытындыға келгендей сөйлеуді доғар.
Dialogue: 0,0:04:36.42,0:04:39.72,Default-ja,,0,0,0,,Дәл солай, мұның бәрі әлемдегі атмосфераға байланысты.
Dialogue: 0,0:04:39.84,0:04:41.60,Default-ja,,0,0,0,,Қорытындылауды доғарыңыз.
Dialogue: 5,0:04:41.64,0:04:45.69,Default,,0,0,0,,Жалғастырыңыз, мен бала кезімдегі Жапониядағы өмір туралы айта бастаймын.
Dialogue: 0,0:04:41.89,0:04:45.64,Default-ja,,0,0,0,,Олай десеңіз, мен 1940 жылдар туралы айтамын.
Dialogue: 5,0:04:45.69,0:04:46.81,Default,,0,0,0,,Соғыстан кейінгі кезең!
Dialogue: 0,0:04:45.81,0:04:48.35,Default-ja,,0,0,0,,Бұл әлі соғыстан кейінгі кезең! Бұл әлі соғыстан кейінгі кезең!
Dialogue: 5,0:04:46.81,0:04:48.40,Default,,0,0,0,,Бұл әлі соғыстан кейінгі уақыт еді!
Dialogue: 5,0:04:48.40,0:04:53.19,Default,,0,0,0,,Егер мен мұны істесем, сіз: «Мұның бұған еш қатысы жоқ» деп қалар едіңіз. Шиш!
Dialogue: 0,0:04:48.52,0:04:49.48,Default-ja,,0,0,0,,Дәл солай, балалар...
Dialogue: 0,0:04:49.73,0:04:51.81,Default-ja,,0,0,0,,«Аа, қазір не айтқаның маңызды емес» немесе сол сияқты.
Dialogue: 0,0:04:51.98,0:04:53.15,Default-ja,,0,0,0,,Сіз солай айтасыз, солай ма? …Таку
Dialogue: 0,0:04:54.82,0:04:58.03,Default-ja,,0,0,0,,Мұғалім менің сезімімді білмейді.
Dialogue: 5,0:04:54.83,0:04:58.07,Default,,0,0,0,,Сіз менің сезімімді түсінбейсіз.
Dialogue: 0,0:04:58.45,0:05:02.03,Default-ja,,0,0,0,,Иә, сондықтан мен қазір тыңдап отырмын.
Dialogue: 5,0:04:59.91,0:05:02.08,Default,,0,0,0,,Сондықтан мен қазір сұрап отырмын!
Dialogue: 0,0:05:04.49,0:05:06.25,Default-ja,,0,0,0,,Әңгімелесейік
Dialogue: 5,0:05:04.51,0:05:06.15,Default,,0,0,0,,Әңгімелесейік!
Dialogue: 0,0:05:09.00,0:05:13.04,Default-ja,,0,0,0,,Жарайды... Шисо жетеді.
Dialogue: 5,0:05:09.02,0:05:11.06,Default,,0,0,0,,Вент ашылғалы үш күн өтті
Dialogue: 5,0:05:11.06,0:05:13.09,Default,,0,0,0,,Перилла өсімдігі орнатылған.
Dialogue: 0,0:05:14.34,0:05:16.55,Default-ja,,0,0,0,,Оның қасында насыбайгүл болуы керек.
Dialogue: 5,0:05:14.35,0:05:16.59,Default,,0,0,0,,Оның қасына насыбайгүлді қоюға болады.
Dialogue: 5,0:05:16.90,0:05:18.95,Default,,0,0,0,,Ал жалбызды басқа жерге қояйық.
Dialogue: 0,0:05:16.92,0:05:20.30,Default-ja,,0,0,0,,...және жалбызды қалдырайық, өйткені ол тым көбейеді.
Dialogue: 5,0:05:18.95,0:05:20.42,Default,,0,0,0,,Жабайы өскенді ұнатады.
Dialogue: 5,0:05:20.42,0:05:21.35,Default,,0,0,0,,Дұрыс.
Dialogue: 5,0:05:22.89,0:05:26.10,Default,,0,0,0,,Енді оларға көп су берейік.
Dialogue: 0,0:05:22.89,0:05:25.89,Default-ja,,0,0,0,,Сізге су беруім керек пе? Оның көп екеніне көз жеткізіңіз.
Dialogue: 5,0:05:26.53,0:05:27.22,Default,,0,0,0,,Алдымен, ортаңғы және көрсеткі саусақтарыңызды осылайша қосыңыз,
Dialogue: 5,0:05:30.56,0:05:36.43,Default,,0,0,0,,Өткен аптада сабақта Кокубу мырза сыныпқа анық дауыспен бірдеңе деді.
Dialogue: 0,0:05:30.56,0:05:33.81,Default-ja,,0,0,0,,Өткен аптада үй уақытында—
Dialogue: 0,0:05:33.94,0:05:36.61,Default-ja,,0,0,0,,Мұғалім анық дауыспен айтты.
Dialogue: 0,0:05:38.36,0:05:41.20,Default-ja,,0,0,0,,Ал... Бүгін мен барлығынан сұрағым келеді...
Dialogue: 5,0:05:38.38,0:05:44.49,Default,,0,0,0,,Жарайды, бүгін мен сізден бірнеше нәрсе сұрағым келеді.
Dialogue: 0,0:05:41.32,0:05:44.45,Default-ja,,0,0,0,,Сізден сұрайын дегенім бар.
Dialogue: 5,0:05:45.39,0:05:52.25,Default,,0,0,0,,Ең алдымен, Арай, Такаши, Кимура, Мочизуки, Такаги және Вакабаяси.
Dialogue: 0,0:05:45.41,0:05:49.21,Default-ja,,0,0,0,,...Біріншіден, Такаши Арай Кимура
Dialogue: 0,0:05:49.33,0:05:52.21,Default-ja,,0,0,0,,Мочизуки Такаги Вакабаяши
Dialogue: 5,0:05:52.96,0:06:00.01,Default,,0,0,0,,Сізге алты жеке сұрақтар бар, сондықтан әрқайсысыңыз мұғаліммен бірге басқа сыныпқа барасыз.
Dialogue: 0,0:05:52.96,0:05:56.21,Default-ja,,0,0,0,,Менің осы алты адамға жеке сұрақтарым бар...
Dialogue: 0,0:05:56.34,0:05:59.97,Default-ja,,0,0,0,,Әр мұғалім туралы Басқа сыныптарға бару
Dialogue: 5,0:06:01.16,0:06:04.76,Default,,0,0,0,,Сол кезде сыныптағылардың барлығы түсінді.
Dialogue: 0,0:06:01.18,0:06:04.72,Default-ja,,0,0,0,,Осы кезде бүкіл сынып байқады
Dialogue: 5,0:06:06.46,0:06:11.54,Default,,0,0,0,,Мектеп біздің сыныптағы қараңғылыққа араласуға кірісті.
Dialogue: 0,0:06:06.47,0:06:11.64,Default-ja,,0,0,0,,Сыныптағы қараңғылыққа мектеп шындап араласты.
Dialogue: 5,0:06:12.65,0:06:17.66,Default,,0,0,0,,Енді біз бұл мұғалімнің бірдеңе жасау қимылдарын басынан өткермейтінін білдік.
Dialogue: 0,0:06:12.77,0:06:14.61,Default-ja,,0,0,0,,Бұл мұғалім мұны ешқашан істемеген
Dialogue: 0,0:06:15.02,0:06:17.86,Default-ja,,0,0,0,,Мен мұны жасырғым келмейді.
Dialogue: 0,0:06:19.86,0:06:21.24,Default-ja,,0,0,0,,ал біз батырлармыз.
Dialogue: 5,0:06:19.87,0:06:21.28,Default,,0,0,0,,Алдымен, ортаңғы және көрсеткі саусақтарыңызды осылайша қосыңыз,
Dialogue: 5,0:06:22.71,0:06:25.29,Default,,0,0,0,,Менің ойымша, біз осы жерден бастаймыз.
Dialogue: 0,0:06:22.74,0:06:25.24,Default-ja,,0,0,0,,Олай болса, қысқаша тоқталайық.
Dialogue: 0,0:06:27.08,0:06:28.08,Default-ja,,0,0,0,,...және!
Dialogue: 5,0:06:27.13,0:06:27.54,Default,,0,0,0,,Тек сен ғана, Хиёри-чан, осы жаққа келуге рұқсат
Dialogue: 5,0:06:29.16,0:06:31.88,Default,,0,0,0,,маған шын мәнінде не болып жатқанын айтыңыз.
Dialogue: 0,0:06:29.37,0:06:32.04,Default-ja,,0,0,0,,Шынымды айтсам, сіз қалай ойлайсыз? Шындығында
Dialogue: 0,0:06:34.83,0:06:37.75,Default-ja,,0,0,0,,Сынып ішінде жүретін жасырын ережелер:
Dialogue: 5,0:06:34.84,0:06:40.80,Default,,0,0,0,,Біздің сыныпта тараған жазылмаған ережелер енді жұмыс істемейді.
Dialogue: 0,0:06:38.55,0:06:40.76,Default-ja,,0,0,0,,Енді қолданылмайтын нәрселер
Dialogue: 5,0:06:43.85,0:06:52.00,Default,,0,0,0,,Бәлкім, келесі нысанаға айналудан қорқумен өмір сүретін күндер енді аяқталуы мүмкін екенін бәрі түсінді.
Dialogue: 0,0:06:43.88,0:06:46.76,Default-ja,,0,0,0,,«Мен келесі мақсат болуы мүмкін»—
Dialogue: 0,0:06:47.68,0:06:51.73,Default-ja,,0,0,0,,Қорқынышты күндер өтіп кетуі мүмкін
Dialogue: 5,0:06:59.96,0:07:02.96,Default,,0,0,0,,Сонымен, шымылдық ашылды.
Dialogue: 0,0:06:59.98,0:07:03.11,Default-ja,,0,0,0,,Ал шымылдық жабылды.
Dialogue: 5,0:07:06.97,0:07:10.33,Default,,0,0,0,,Мм, кешірім сұраймын.
Dialogue: 0,0:07:06.99,0:07:10.29,Default-ja,,0,0,0,,Мм... Кешіріңіз.
Dialogue: 5,0:07:10.33,0:07:13.33,Default,,0,0,0,,Мұнда.
Dialogue: 0,0:07:10.45,0:07:13.29,Default-ja,,0,0,0,,Кешіріңіз, кешіріңіз
Dialogue: 5,0:07:14.79,0:07:18.36,Default,,0,0,0,,Онымен бірге оның шынымен аяқталғанын айту қиынға соғатын сөздер де келді.
Dialogue: 0,0:07:14.79,0:07:18.46,Default-ja,,0,0,0,,Сөзбен айтқанда жабық па, жоқ па білмеймін...
Dialogue: 5,0:07:25.00,0:07:27.64,Default,,0,0,0,,Бұл жерде шыншылдық жоқ еді.
Dialogue: 0,0:07:25.05,0:07:30.81,Default-ja,,0,0,0,,Жүрегім қапасқа біткен жоқ, әлі алда әлі алда.
Dialogue: 5,0:07:28.41,0:07:30.69,Default,,0,0,0,,Бізде әлі көп жол бар сияқты.
Dialogue: 0,0:07:36.52,0:07:41.11,Default-ja,,0,0,0,,Мұғалім, мен сізді кешіруім керек пе?
Dialogue: 5,0:07:36.53,0:07:41.15,Default,,0,0,0,,Кокубу мырза, мен оларды кешірмесем болады ма?
Dialogue: 5,0:07:46.12,0:07:51.80,Default,,0,0,0,,«Кешірім сұрасаң, кешіресің» деп еш жазасыз айтыңыз.
Dialogue: 0,0:07:46.16,0:07:51.62,Default-ja,,0,0,0,,Айыппұл жоқ; тек кешірім сұрасаң, кешіресің.
Dialogue: 5,0:07:51.80,0:07:54.92,Default,,0,0,0,,Мен Чихоға мектепті қалай ауыстыруға тура келді деп ойласам,
Dialogue: 0,0:07:51.95,0:07:54.87,Default-ja,,0,0,0,,Чихо-чан мектептерді ауыстыруға мәжбүр болды...
Dialogue: 0,0:07:56.54,0:07:59.54,Default-ja,,0,0,0,,Мен мұны көтере алмаймын.
Dialogue: 5,0:07:56.55,0:07:59.42,Default,,0,0,0,,кешіру тым көп.
Dialogue: 5,0:08:00.88,0:08:02.34,Default,,0,0,0,,«Мейірімділік»?
Dialogue: 0,0:08:00.92,0:08:02.51,Default-ja,,0,0,0,,Жанашырлық?
Dialogue: 0,0:08:02.96,0:08:07.26,Default-ja,,0,0,0,,Хмм... Менің ойымша, бұл маған ұнамайды...
Dialogue: 5,0:08:03.94,0:08:07.12,Default,,0,0,0,,Мен дайындаманы сызып жатырмын.
Dialogue: 5,0:08:07.76,0:08:10.43,Default,,0,0,0,,Бұл екіжүзділік сияқты ма?
Dialogue: 0,0:08:07.76,0:08:10.39,Default-ja,,0,0,0,,Екіжүзділік? ... сияқты
Dialogue: 0,0:08:10.72,0:08:14.89,Default-ja,,0,0,0,,Бұл қажет пе? ... сияқты
Dialogue: 5,0:08:10.74,0:08:14.71,Default,,0,0,0,,Бұл сізге қажет нәрсе сияқты немесе не?
Dialogue: 5,0:08:23.73,0:08:25.50,Default,,0,0,0,,Білім, иә?
Dialogue: 0,0:08:23.73,0:08:28.53,Default-ja,,0,0,0,,Білім... Оқыту дегеніңіз жақсы айттыңыз.
Dialogue: 5,0:08:25.50,0:08:28.40,Default,,0,0,0,,Бұл айтылғандай оңай болса ғой.
Dialogue: 5,0:08:33.66,0:08:36.33,Default,,0,0,0,,Біздің жұмысымыз оқушыларды оқыту және тәрбиелеу.
Dialogue: 0,0:08:33.66,0:08:36.29,Default-ja,,0,0,0,,«Оқыту» немесе «тәрбиелеу»?
Dialogue: 5,0:08:40.85,0:08:45.59,Default,,0,0,0,,Теңдеуден «көтеруді» алыңыз, мен ешқашан араласпас едім...
Dialogue: 0,0:08:40.88,0:08:45.34,Default-ja,,0,0,0,,«Ику» таңбасы болмаса, мен оны әлдеқашан лақтырып жіберер едім.
Осы мәселе бойынша
Dialogue: 5,0:08:47.53,0:08:48.94,Default,,0,0,0,,.
Dialogue: 0,0:08:47.55,0:08:49.13,Default-ja,,0,0,0,,Осыған ұқсас нәрсе...
Dialogue: 5,0:08:55.93,0:08:58.61,Default,,0,0,0,,Қорылдау, қорылдау...
Dialogue: 5,0:08:59.01,0:09:02.11,Default,,0,0,0,,Қырсыл...
Dialogue: 0,0:09:12.37,0:09:13.20,Default-ja,,0,0,0,,Хина!
Dialogue: 5,0:09:12.39,0:09:13.24,Default,,0,0,0,,Хина!
Dialogue: 0,0:09:17.75,0:09:20.25,signs,,0,0,0,,Кавамото Хинатаға
Dialogue: 1,0:09:17.75,0:09:20.25,signs,,0,0,0,,Кавамото Хинатаға
Dialogue: 0,0:09:21.75,0:09:24.26,signs,,0,0,0,,Сакура Чиходан
Dialogue: 1,0:09:21.75,0:09:24.26,signs,,0,0,0,,Сакура Чиходан
Dialogue: 5,0:09:24.26,0:09:25.88,Default,,0,0,0,,Бұл Чиходан!
Dialogue: 0,0:09:24.38,0:09:26.01,Default-ja,,0,0,0,,Чихо-чанның денесі
Dialogue: 5,0:09:28.19,0:09:32.35,Default,,0,0,0,,Хина, кешіріңіз, сізге қайта оралуым ұзақ болды.
Dialogue: 0,0:09:28.26,0:09:29.55,Default-ja,,0,0,0,,Хина-чан
Dialogue: 0,0:09:29.68,0:09:32.47,Default-ja,,0,0,0,,Кеш жауап бергенім үшін кешіріңіз.
Dialogue: 5,0:09:35.39,0:09:42.77,Default,,0,0,0,,Дәл қазір мен «Жүрек күтімі орталығы» деген жерде мұғаліммен бірге оқып жатырмын.
Dialogue: 0,0:09:35.39,0:09:39.23,Default-ja,,0,0,0,,Мен қазір «Психикалық көмек орталығы» деп аталатын жерде жұмыс істеймін.
Dialogue: 0,0:09:39.81,0:09:42.73,Default-ja,,0,0,0,,Мен мұғаліммен бірге оқимын.
Dialogue: 0,0:09:46.07,0:09:50.15,Default-ja,,0,0,0,,Бұл жер таулар мен ормандармен қоршалған.
Dialogue: 5,0:09:46.08,0:09:52.60,Default,,0,0,0,,Бұл таулар мен ормандармен қоршалған тыныш, әдемі аймақ.
Dialogue: 0,0:09:50.28,0:09:52.74,Default-ja,,0,0,0,,Бұл тыныш және әдемі жер.
Dialogue: 0,0:09:53.24,0:09:56.70,Default-ja,,0,0,0,,Орталықтың жанында ранчо мен ферма орналасқан.
Dialogue: 5,0:09:53.25,0:09:56.98,Default,,0,0,0,,Орталықтың жанында ранчо мен ферма бар.
Dialogue: 5,0:09:56.98,0:10:02.04,Default,,0,0,0,,Олар маған кейде көмектесуге мүмкіндік береді.
Dialogue: 0,0:09:57.08,0:10:02.00,Default-ja,,0,0,0,,Қазір мен кейде сонда көмектесемін.
Dialogue: 0,0:10:07.55,0:10:12.89,Default-ja,,0,0,0,,Бұл фермада туған ешкінің баласы. Оның есімі Мэй Чан.
Dialogue: 5,0:10:07.56,0:10:11.11,Default,,0,0,0,,Бұл ешкінің қожалықта туған баласы.
Dialogue: 5,0:10:11.11,0:10:13.04,Default,,0,0,0,,Оның аты – Мэй.
Dialogue: 5,0:10:13.04,0:10:15.06,Default,,0,0,0,,Менің сол жағымдағы ит - Хана.
Dialogue: 0,0:10:13.18,0:10:15.01,Default-ja,,0,0,0,,Көрші үй – Хана-чан иті.
Dialogue: 5,0:10:15.91,0:10:20.06,Default,,0,0,0,,Мен ранчоға барсам, олар үнемі жүгіріп келеді.
Dialogue: 0,0:10:16.14,0:10:20.81,Default-ja,,0,0,0,,Мен ранчоға барсам екеуі де мені тауып алып ұшып келеді.
Dialogue: 5,0:10:21.78,0:10:24.57,Default,,0,0,0,,Олар менің осында тапқан алғашқы достарым.
Dialogue: 0,0:10:21.81,0:10:24.73,Default-ja,,0,0,0,,Міне, мен алғашқы достарымды таптым.
Dialogue: 5,0:10:29.32,0:10:34.19,Default,,0,0,0,,Ферма мен фермадағы адамдардың барлығы өте мейірімді.
Dialogue: 0,0:10:29.32,0:10:34.16,Default-ja,,0,0,0,,Ферма мен фермадағы адамдар да өте жақсы адамдар.
Dialogue: 5,0:10:34.19,0:10:36.08,Default,,0,0,0,,Жақын жерде тұратын адамдар да солай.
Dialogue: 0,0:10:34.28,0:10:36.03,Default-ja,,0,0,0,,Көршілер де
Dialogue: 5,0:10:39.76,0:10:45.34,Default,,0,0,0,,Өткенде біз бірге қара өрік шарабы, алхоры шәрбаты, алхоры джемін жасадық.
Dialogue: 0,0:10:39.79,0:10:45.42,Default-ja,,0,0,0,,Өткенде бәріміз қара өрік шарабы, қара өрік шәрбаты, алхоры джемін дайындадық.
Dialogue: 5,0:10:48.42,0:10:50.96,Default,,0,0,0,,Менің анам да көмектесті. Бұл өте қызық болды.
Dialogue: 0,0:10:48.42,0:10:51.09,Default-ja,,0,0,0,,Анамның қасымда болғаны қызық болды.
Dialogue: 5,0:10:56.05,0:11:04.11,Default,,0,0,0,,Әкемнің кабинеті орталықтан онша алыс емес, сондықтан ол мені күнде түсіріп, алып кетеді.
Dialogue: 0,0:10:56.05,0:11:01.18,Default-ja,,0,0,0,,Мен әкемнің компаниясында жалғыз жұмыс істеп жүргенмін, ол аз ғана жерде болатын.
Dialogue: 0,0:11:01.31,0:11:03.81,Default-ja,,0,0,0,,Ол мені күнде алып кетеді.
Dialogue: 5,0:11:10.33,0:11:14.62,Default,,0,0,0,,Мен қазір онымен сөйлесуге мүмкіндігім бар екеніне өте қуаныштымын.
Dialogue: 0,0:11:10.36,0:11:14.57,Default-ja,,0,0,0,,Мен қазір көп сөйлей алатыныма өте қуаныштымын.
Dialogue: 5,0:11:18.56,0:11:26.18,Default,,0,0,0,,Мен мұнда алғаш келгенімде бұл жаңа жерге үйрене алмай, шынымен жалғызсырап қалдым.
Dialogue: 0,0:11:18.58,0:11:21.91,Default-ja,,0,0,0,,Мен мұнда алғаш келгенде...
Dialogue: 0,0:11:22.04,0:11:26.29,Default-ja,,0,0,0,,Мен өзімді өте жалғыз сезіндім, өйткені жаңа жерге үйрене алмай қалдым.
Dialogue: 5,0:11:33.69,0:11:41.85,Default,,0,0,0,,Бірақ содан кейін орталықтағы мұғалімім Сату ханым маған достасудың үш қадамын үйретті.
Dialogue: 0,0:11:33.72,0:11:37.30,Default-ja,,0,0,0,,Сол кезде орталықтан доктор Сато...
Dialogue: 0,0:11:37.43,0:11:41.97,Default-ja,,0,0,0,,Маған достасудың үш қадамы үйретілді.
Dialogue: 5,0:11:44.53,0:11:48.65,Default,,0,0,0,,Жануарлармен достасудан бастайсың.
Dialogue: 0,0:11:44.56,0:11:48.61,Default-ja,,0,0,0,,«Алдымен жануарлармен достасайық».
Dialogue: 5,0:11:49.27,0:11:53.15,Default,,0,0,0,,Осыдан кейін келесі қадам сізден үлкен адамдармен достасу.
Dialogue: 0,0:11:49.27,0:11:53.11,Default-ja,,0,0,0,,«Бұдан кейін, келесі жолы менің үлкен достарым болады».
Dialogue: 5,0:11:59.05,0:12:00.66,Default,,0,0,0,,Ал бүгін...
Dialogue: 0,0:11:59.07,0:12:00.62,Default-ja,,0,0,0,,Ал бүгін
Dialogue: 0,0:12:00.66,0:12:03.16,signs,,0,0,0,,Сату ханым үшін
Dialogue: 0,0:12:07.29,0:12:08.13,Default-ja,,0,0,0,,Мұғалімге –
Dialogue: 5,0:12:07.32,0:12:13.47,Default,,0,0,0,,Сатоу ханым: «Үшінші қадамға неге өтпейміз?» деді.
Dialogue: 0,0:12:08.83,0:12:11.80,Default-ja,,0,0,0,,«Үшінші қадамға көшейік», - деді ол.
Dialogue: 0,0:12:11.92,0:12:13.59,Default-ja,,0,0,0,,Маған айтты
Dialogue: 5,0:12:14.79,0:12:19.68,Default,,0,0,0,,Үшінші қадам - өз жасыңызға жақын адаммен достасу.
Dialogue: 0,0:12:14.80,0:12:19.64,Default-ja,,0,0,0,,Үшінші қадам – «өз жасыңызда достар табу».
Dialogue: 0,0:12:23.06,0:12:25.64,Default-ja,,0,0,0,,Мен мұны естігенде...
Dialogue: 5,0:12:23.07,0:12:25.69,Default,,0,0,0,,Мен мұны естігенде,
Dialogue: 5,0:12:34.16,0:12:36.70,Default,,0,0,0,,Мен сен туралы ойладым, Хина.
Dialogue: 0,0:12:34.19,0:12:36.65,Default-ja,,0,0,0,,Хина-чанның түрі есіме түсті
Dialogue: 5,0:12:38.73,0:12:42.41,Default,,0,0,0,,Мен сені қатты сағындым.
Dialogue: 0,0:12:38.74,0:12:42.49,Default-ja,,0,0,0,,Мен шынымен... сені қатты сағындым.
Dialogue: 0,0:12:45.25,0:12:48.25,Default-ja,,0,0,0,,Алхоры шәрбаты дәмді болғанда...
Dialogue: 5,0:12:45.25,0:12:50.29,Default,,0,0,0,,Алхоры шәрбаты дұрыс болғанда, мен сенімен бірге ішкім келеді.
Dialogue: 0,0:12:48.37,0:12:50.46,Default-ja,,0,0,0,,Мен Хина Чанмен ішкім келеді
Dialogue: 5,0:12:53.96,0:12:56.44,Default,,0,0,0,,Мен де жүгері отырғыздым.
Dialogue: 0,0:12:53.96,0:12:59.64,Default-ja,,0,0,0,,Тамыз айында жеміс беретін жүгері де ектік.
Dialogue: 5,0:12:57.22,0:12:59.53,Default,,0,0,0,,Ол тамызға дейін таңдауға дайын болады.
Dialogue: 5,0:13:00.72,0:13:02.48,Default,,0,0,0,,Мен сенімен жүгері жегім келеді.
Dialogue: 0,0:13:00.84,0:13:02.64,Default-ja,,0,0,0,,Мен сенімен тамақтанғым келеді
Dialogue: 5,0:13:15.01,0:13:18.24,Default,,0,0,0,,Жазғы демалыста маған қонаққа келесің бе?
Dialogue: 0,0:13:15.03,0:13:18.20,Default-ja,,0,0,0,,Жазғы демалыста бізге қонаққа келгіңіз келе ме?
Dialogue: 0,0:13:20.70,0:13:24.24,Default-ja,,0,0,0,,Күте аламын ба? Чиходан
Dialogue: 5,0:13:20.71,0:13:22.41,Default,,0,0,0,,Сіздің келуіңізді асыға күтуге бола ма?
Dialogue: 5,0:13:23.05,0:13:24.13,Default,,0,0,0,,Чиходан.
Dialogue: 0,0:13:28.00,0:13:31.00,titles,,0,0,0,,Кішкентай алақан
Dialogue: 0,0:13:31.00,0:13:35.01,titles,,0,0,0,,Күнде
Dialogue: 0,0:13:45.76,0:13:46.85,Default-ja,,0,0,0,,Сәлем
Dialogue: 5,0:13:45.79,0:13:46.89,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:13:57.86,0:14:02.24,Default-ja,,0,0,0,,Ннн... Кешіріңіз...
Dialogue: 5,0:13:59.88,0:14:02.28,Default,,0,0,0,,Мен бір қолымда оқпен жүктелген винтовка ұстап тұрмын
Dialogue: 5,0:14:32.19,0:14:33.33,Default,,0,0,0,,Ол ұйықтап жатыр.
Dialogue: 0,0:14:32.19,0:14:33.35,Default-ja,,0,0,0,,(Үш мүйізді) Құрлықтағыдай еркін қозғала алмайсың. Көресің әлі!
Dialogue: 0,0:14:45.70,0:14:49.96,signs,,0,0,0,,Кіргісі келеді, бірақ кіре алмайды
Dialogue: 1,0:14:45.70,0:14:49.96,signs,,0,0,0,,Кіргісі келеді, бірақ кіре алмайды
Dialogue: 0,0:14:46.70,0:14:49.96,signs,,0,0,0,,*Қыз ұйықтап жатқан үйге кіруге болатын-болмайтынына сенімді емес
Dialogue: 1,0:14:46.70,0:14:49.96,signs,,0,0,0,,*Қыз ұйықтап жатқан үйге кіруге болатын-болмайтынына сенімді емес
Dialogue: 5,0:14:50.96,0:14:53.96,Default,,0,0,0,,Опф...
Dialogue: 0,0:14:51.16,0:14:53.92,Default-ja,,0,0,0,,Кішкене ғана...
Dialogue: 0,0:14:55.21,0:14:57.71,signs,,0,0,0,,Әзірге отырыңыз
Dialogue: 1,0:14:55.21,0:14:57.71,signs,,0,0,0,,Әзірге отырыңыз
Dialogue: 5,0:15:10.37,0:15:13.46,Default,,0,0,0,,Мен неге екенін білмеймін, бірақ біраз уақыттан кейін бірінші рет
Dialogue: 0,0:15:10.39,0:15:13.60,Default-ja,,0,0,0,,Не? Біраз уақыт өтті
Dialogue: 5,0:15:14.19,0:15:16.98,Default,,0,0,0,,оның айналасында жұмсақ аура бар.
Dialogue: 0,0:15:14.19,0:15:16.94,Default-ja,,0,0,0,,Оның айналасындағы ауа жұмсақ.
Dialogue: 5,0:15:18.14,0:15:21.99,Default,,0,0,0,,Ол әлсіз жарқырап тұрғандай.
Dialogue: 0,0:15:18.15,0:15:21.94,Default-ja,,0,0,0,,Бұлыңғыр жарқырап тұрған сияқты...
Dialogue: 0,0:15:23.82,0:15:27.45,Default-ja,,0,0,0,,Мен оны мәңгі көргім келетін сияқты...
Dialogue: 5,0:15:23.83,0:15:27.41,Default,,0,0,0,,Мен оған мәңгі осылай қарай алатын сияқтымын.
Dialogue: 0,0:15:43.92,0:15:45.18,Default-ja,,0,0,0,,Нөл-чан...
Dialogue: 5,0:15:43.97,0:15:45.02,Default,,0,0,0,,Rei...
Dialogue: 0,0:15:46.76,0:15:48.05,Default-ja,,0,0,0,,Нөл-чан
Dialogue: 5,0:15:46.78,0:15:47.78,Default,,0,0,0,,Rei.
Dialogue: 0,0:15:49.10,0:15:49.85,Default-ja,,0,0,0,,Нөл-чан
Dialogue: 5,0:15:49.15,0:15:49.89,Default,,0,0,0,,Рей!
Dialogue: 0,0:15:51.06,0:15:53.15,signs,,0,0,0,,Дыбыс жоқ сияқты
Dialogue: 1,0:15:51.06,0:15:53.15,signs,,0,0,0,,Үнсіз сияқты
Dialogue: 5,0:15:54.52,0:15:56.23,Default,,0,0,0,,Уау! Жазғы мандариндер!
Dialogue: 0,0:15:54.56,0:15:57.69,Default-ja,,0,0,0,,Уау, жазғы апельсиндер! Сонша
Dialogue: 5,0:15:56.55,0:15:57.62,Default,,0,0,0,,Және өте көп!
Dialogue: 5,0:15:57.62,0:15:59.99,Default,,0,0,0,,Оларды маған шеберханадағы тәлімгерім берді.
Dialogue: 0,0:15:57.81,0:16:02.19,Default-ja,,0,0,0,,Мен оны зерттеу тобының жоғары курсынан алдым. Мен көп егін жинадым, сондықтан оны маған әкелуін өтіндім.
Dialogue: 5,0:15:59.99,0:16:02.24,Default,,0,0,0,,Ол бір тоннаны жинады, сондықтан ол маған оларды алып кет деді.
Dialogue: 5,0:16:02.84,0:16:05.76,Default,,0,0,0,,Оның босағасында ұйықтап қалғаныма сене алар емеспін.
Dialogue: 0,0:16:02.86,0:16:05.86,Default-ja,,0,0,0,,Жоқ, мені сүйретіп ұйықтатты.
Dialogue: 5,0:16:07.07,0:16:08.49,Default,,0,0,0,,О, уау!
Dialogue: 0,0:16:07.07,0:16:10.08,Default-ja,,0,0,0,,Ой, бұл сондай...
Dialogue: 5,0:16:08.89,0:16:10.33,Default,,0,0,0,,Бұл сөзсіз...
Dialogue: 0,0:16:10.20,0:16:13.95,Default-ja,,0,0,0,,...дәлірек айтқанда, бәрі? Шимада мырза ше?
Dialogue: 5,0:16:10.33,0:16:12.25,Default,,0,0,0,,Күте тұрыңыз, олардың бәрі?
Dialogue: 5,0:16:12.95,0:16:14.00,Default,,0,0,0,,Сіз ше, Шимада?
Dialogue: 5,0:16:14.42,0:16:17.00,Default,,0,0,0,,Ол сіздің меншігіңізде өсті, бірақ сіз оны жемейсіз бе?
Dialogue: 0,0:16:14.62,0:16:16.96,Default-ja,,0,0,0,,Осы жерде болса да, неге жемейсің?
Dialogue: 5,0:16:17.48,0:16:22.01,Default,,0,0,0,,Жоқ, мен мандариндердегі қышқыл асқазанның шырышты қабығы арқылы еріп кететін сияқтымын.
Dialogue: 0,0:16:17.50,0:16:21.96,Default-ja,,0,0,0,,Жазғы мандарин апельсиніндегі қышқыл менің асқазанымды ерітіп жіберетін сияқты.
Dialogue: 5,0:16:22.57,0:16:26.16,Default,,0,0,0,,Оларда пестицидтер жоқ, сондықтан сіз джем және басқа заттар жасай аласыз.
Dialogue: 0,0:16:22.59,0:16:26.01,Default-ja,,0,0,0,,Құрамында пестицидтер жоқ, сондықтан оны джем жасауға болады.
Dialogue: 5,0:16:26.16,0:16:27.66,Default,,0,0,0,,Мен мүмкін емес.
Dialogue: 0,0:16:26.26,0:16:27.34,Default-ja,,0,0,0,,Мен үлгере алмаймын, бірақ...
Dialogue: 0,0:16:27.30,0:16:30.51,signs,,0,0,0,,Хахаха...
Dialogue: 1,0:16:27.30,0:16:30.51,signs,,0,0,0,,Хахаха...
Dialogue: 0,0:16:28.55,0:16:29.76,signs,,0,0,0,,Кептеліс пе?
Dialogue: 1,0:16:28.55,0:16:29.76,signs,,0,0,0,,Кептеліс пе?
Dialogue: 5,0:16:28.74,0:16:29.54,Default,,0,0,0,,Кептеліс пе?
Dialogue: 0,0:16:30.01,0:16:30.51,signs,,0,0,0,,сызық!
Dialogue: 1,0:16:30.01,0:16:30.51,signs,,0,0,0,,сызық!
Dialogue: 0,0:16:30.89,0:16:31.85,Default-ja,,0,0,0,,Акари-сан
Dialogue: 5,0:16:31.02,0:16:31.94,Default,,0,0,0,,Акари.
Dialogue: 5,0:16:31.94,0:16:34.23,Default,,0,0,0,,Сіз маған азық-түлікке ақша үнемдейсіз!
Dialogue: 0,0:16:31.97,0:16:35.48,Default-ja,,0,0,0,,Азық-түлік бағасы қайтадан қымбаттап жатыр. Кептеліс жасау.
Dialogue: 5,0:16:34.23,0:16:35.52,Default,,0,0,0,,Мен джем жасаймын!
Dialogue: 5,0:16:39.95,0:16:41.77,Default,,0,0,0,,Жақсы иіс шығады.
Dialogue: 0,0:16:39.98,0:16:43.19,Default-ja,,0,0,0,,Жағымды иіс. Мен бақыттымын.
Dialogue: 5,0:16:41.77,0:16:43.25,Default,,0,0,0,,Бұл тамаша болады.
Dialogue: 5,0:16:43.25,0:16:46.03,Default,,0,0,0,,Систің мармелады дәмді.
Dialogue: 0,0:16:43.32,0:16:45.99,Default-ja,,0,0,0,,Менің әпкемнің мармелады дәмді.
Dialogue: 5,0:16:48.44,0:16:51.71,Default,,0,0,0,,Мен ойлағандай, ол әлсіз жарқырап тұр.
Dialogue: 0,0:16:48.45,0:16:53.49,Default-ja,,0,0,0,,Өйткені, ол күңгірттеніп тұр. Неліктен?
Dialogue: 5,0:16:52.53,0:16:53.54,Default,,0,0,0,,Неге деп ойлаймын.
Dialogue: 5,0:17:06.07,0:17:09.47,Default,,0,0,0,,Кирияма, шын мәнінде...
Dialogue: 0,0:17:06.09,0:17:09.43,Default-ja,,0,0,0,,Кирияма-кун, сен білесің...
Dialogue: 5,0:17:12.48,0:17:13.91,Default,,0,0,0,,Біткен сияқты.
Dialogue: 0,0:17:12.51,0:17:14.10,Default-ja,,0,0,0,,Біткен сияқты
Dialogue: 5,0:17:15.39,0:17:15.98,Default,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:17:18.52,0:17:20.48,Default-ja,,0,0,0,,Менің ойымша, бұл аяқталды
Dialogue: 5,0:17:18.54,0:17:20.27,Default,,0,0,0,,Менің ойымша, бәрі бітті.
Dialogue: 5,0:17:22.36,0:17:23.24,Default,,0,0,0,,Қандай сәнсіз...
Dialogue: 0,0:17:22.36,0:17:23.36,Default-ja,,0,0,0,,Онда тас, қағаз, қайшы ойнайық.
Dialogue: 0,0:17:25.94,0:17:28.82,Default-ja,,0,0,0,,Тек сол жерде тұрып ұйықтап жат.
Dialogue: 5,0:17:27.26,0:17:28.63,Default,,0,0,0,,Б... бір сызық
Dialogue: 5,0:17:29.29,0:17:30.24,Default,,0,0,0,,Сондықтан...
Dialogue: 0,0:17:29.32,0:17:33.49,Default-ja,,0,0,0,,Бұл жарық па?
Dialogue: 5,0:17:31.67,0:17:33.36,Default,,0,0,0,,ол жарқырап тұр.
Dialogue: 5,0:17:49.78,0:17:51.01,Default,,0,0,0,,Сүйкімді, солай ма?
Dialogue: 0,0:17:49.80,0:17:50.97,Default-ja,,0,0,0,,Сүйкімді емес пе?
Dialogue: 5,0:17:51.57,0:17:55.52,Default,,0,0,0,,Біз оларды кеше менің сыныптасым Кавасиманың үйінде пісірдік.
Dialogue: 0,0:17:51.59,0:17:55.47,Default-ja,,0,0,0,,Кеше біз мұны менімен бір сыныпта оқитын Кавасима мырзаның үйінде бірге жасадық.
Dialogue: 5,0:17:56.21,0:17:57.52,Default,,0,0,0,,Біз бір топтамыз.
Dialogue: 0,0:17:56.22,0:17:57.47,Default-ja,,0,0,0,,Біз бір топтамыз.
Dialogue: 5,0:17:58.73,0:18:02.89,Default,,0,0,0,,Киучи, Кобаяши және Кудоу да топта, сондықтан барлығымыз бесеуміз.
Dialogue: 0,0:17:58.73,0:18:03.06,Default-ja,,0,0,0,,Киучи мырза, Кобаяши мырза, Кудо мырза және бесеуміз.
Dialogue: 0,0:18:05.69,0:18:06.73,Default-ja,,0,0,0,,Кавамото мырза
Dialogue: 5,0:18:05.73,0:18:06.78,Default,,0,0,0,,Кавамото.
Dialogue: 0,0:18:09.15,0:18:13.49,Default-ja,,0,0,0,,Білесіз бе, Кавасима мырза бүгін үйінде печенье дайындайтынын айтты...
Dialogue: 5,0:18:09.16,0:18:13.53,Default,,0,0,0,,Олай болса, біз бүгін Кавасиманың үйінде печенье жасаймыз.
Dialogue: 0,0:18:14.78,0:18:17.04,Default-ja,,0,0,0,,Менімен бірге келмейсің бе? иә?
Dialogue: 5,0:18:14.80,0:18:16.27,Default,,0,0,0,,Бізге қосылғыңыз келе ме?
Dialogue: 5,0:18:16.27,0:18:16.91,Default,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:18:19.16,0:18:20.62,Default-ja,,0,0,0,,Ал...
Dialogue: 5,0:18:19.19,0:18:20.67,Default,,0,0,0,,Олар дәл қашан осы үйдің бір бөлігіне айналды?
Dialogue: 5,0:18:27.08,0:18:28.36,Default,,0,0,0,,Неге?!
Dialogue: 0,0:18:27.09,0:18:30.63,Default-ja,,0,0,0,,Кешіріңіз! Мен... мен қорықтым.
Dialogue: 5,0:18:28.36,0:18:30.68,Default,,0,0,0,,Мен-мен қорықтым.
Dialogue: 5,0:18:31.96,0:18:33.93,Default,,0,0,0,,Сондықтан мен ештеңе істей алмадым.
Dialogue: 0,0:18:31.97,0:18:33.89,Default-ja,,0,0,0,,Сондықтан мен ештеңе істей алмадым.
Dialogue: 5,0:18:34.77,0:18:38.68,Default,,0,0,0,,Кешірім сұрасақ та... деп ойладық.
Dialogue: 0,0:18:34.97,0:18:38.64,Default-ja,,0,0,0,,Кешірім сұрасақ та, біз сені кешіріп қойғанбыз...
Dialogue: 0,0:18:39.35,0:18:41.85,Default-ja,,0,0,0,,...Мен оны түсінбеуім мүмкін
Dialogue: 5,0:18:39.36,0:18:41.72,Default,,0,0,0,,сіз бізді кешірмейтін шығарсыз...
Dialogue: 5,0:18:44.32,0:18:47.73,Default,,0,0,0,,Бірақ мен сізден кешірім сұрағым келді.
Dialogue: 0,0:18:44.35,0:18:47.69,Default-ja,,0,0,0,,Бірақ мен шынымен кешірім сұрағым келеді...
Dialogue: 5,0:18:51.55,0:18:52.45,Default,,0,0,0,,Осыдан кейін,
Dialogue: 0,0:18:51.57,0:18:54.41,Default-ja,,0,0,0,,Содан кейін киіміңді ауыстырып,—
Dialogue: 5,0:18:53.34,0:18:54.45,Default,,0,0,0,,Мен киім ауыстырдым,
Dialogue: 5,0:18:55.43,0:18:58.20,Default,,0,0,0,,содан кейін Кавасиманың үйінде қыздармен кездесті.
Dialogue: 0,0:18:55.45,0:18:58.16,Default-ja,,0,0,0,,Біз тағы да Кавасима мырзаның үйіне жиналдық...
Dialogue: 5,0:19:03.33,0:19:06.06,Default,,0,0,0,,Біз бірге тонна печенье пісірдік.
Dialogue: 0,0:19:03.33,0:19:06.21,Default-ja,,0,0,0,,Барлығымыз көп печенье пісірдік.
Dialogue: 5,0:19:26.47,0:19:30.99,Default,,0,0,0,,Печенье қатты және дұрыс емес болып шықты.
Dialogue: 0,0:19:26.48,0:19:30.94,Default-ja,,0,0,0,,Дайын печенье ыңғайсыз және қатты болды...
Dialogue: 0,0:19:37.24,0:19:38.53,Default-ja,,0,0,0,,Сәлем...
Dialogue: 0,0:19:42.91,0:19:44.58,Default-ja,,0,0,0,,Бұл не?
Dialogue: 5,0:19:42.92,0:19:44.47,Default,,0,0,0,,Бұл не? Бұл жиіркенішті!
Dialogue: 5,0:19:45.17,0:19:46.00,Default,,0,0,0,,Мен мұны айтқан соң,
Dialogue: 0,0:19:45.17,0:19:50.55,Default-ja,,0,0,0,,Мен бұл сөзді айтсам, бәрі күлкісін тыя алмады.
Dialogue: 5,0:19:47.11,0:19:50.83,Default,,0,0,0,,күлкімізді тоқтата алмадық.
Dialogue: 5,0:19:52.25,0:19:54.01,Default,,0,0,0,,Біз күліп жүргенде,
Dialogue: 0,0:19:52.26,0:19:53.97,Default-ja,,0,0,0,,Біз бәріміз күлдік
Dialogue: 5,0:19:54.78,0:19:57.01,Default,,0,0,0,,біз: «Бірақ, жаңа пісірілген печенье жақсы», - дедік.
Dialogue: 0,0:19:54.80,0:19:56.97,Default-ja,,0,0,0,,«Бірақ жаңа пісірілген тағам дәмді.»
Dialogue: 5,0:19:57.63,0:20:00.02,Default,,0,0,0,,және оларды қасқырлай берді.
Dialogue: 0,0:19:57.64,0:19:59.80,Default-ja,,0,0,0,,Мен көп жедім.
Dialogue: 5,0:20:01.64,0:20:03.22,Default,,0,0,0,,Неге деп ойлаймын.
Dialogue: 0,0:20:01.68,0:20:03.06,Default-ja,,0,0,0,,Неліктен?
Dialogue: 5,0:20:03.22,0:20:06.89,Default,,0,0,0,,Дүкенде сатып алынған печеньелердің дәмі әлдеқайда жақсы,
Dialogue: 0,0:20:03.35,0:20:07.06,Default-ja,,0,0,0,,Мен сатып алған печенье әлдеқайда дәмді.
Dialogue: 5,0:20:07.93,0:20:12.53,Default,,0,0,0,,бірақ мен өте жақсы уақыт өткіздім және олардың дәмді болғанына қатты қуандым.
Dialogue: 0,0:20:07.94,0:20:12.48,Default-ja,,0,0,0,,Көңілді, дәмді және бақытты
Dialogue: 5,0:20:15.73,0:20:18.03,Default,,0,0,0,,Сіз мұны білесіз бе, Кирияма?
Dialogue: 0,0:20:15.74,0:20:18.03,Default-ja,,0,0,0,,Кирияма-кун, сен білесің бе?
Dialogue: 5,0:20:18.03,0:20:21.79,Default,,0,0,0,,Пештен шыққан печеньені аузыңызға тіке салсаңыз, қытырлақ болады.
Dialogue: 0,0:20:18.16,0:20:21.74,Default-ja,,0,0,0,,Жаңа піскен кезде ауызға салғанда «жу» дыбысы шығады.
Dialogue: 5,0:20:22.40,0:20:24.73,Default,,0,0,0,,Аузымның ішін күйдіріп алдым.
Dialogue: 0,0:20:22.41,0:20:25.79,Default-ja,,0,0,0,,Аузым күйіп қалды Қараңызшы!
Dialogue: 5,0:20:24.73,0:20:25.65,Default,,0,0,0,,Қараңдар!
Dialogue: 0,0:20:28.21,0:20:29.38,Default-ja,,0,0,0,,Айтыңыз:
Dialogue: 5,0:20:28.23,0:20:29.42,Default,,0,0,0,,Мұны айта отырып,
Dialogue: 0,0:20:30.42,0:20:34.88,Default-ja,,0,0,0,,Жазықсыз аузын ашып, тістері мен тілін көрсетеді.
Dialogue: 5,0:20:30.44,0:20:33.52,Default,,0,0,0,,ол бейкүнә аузын ашты.
Dialogue: 5,0:20:33.52,0:20:37.08,Default,,0,0,0,,Мен оның тістері мен тілінде күн сәулесін көргенде,
Dialogue: 0,0:20:35.01,0:20:37.18,Default-ja,,0,0,0,,Жарқырап тұрған күнді көру
Dialogue: 5,0:20:37.96,0:20:41.93,Default,,0,0,0,,неге екені белгісіз, ішімде неше түрлі сезім пайда болды.
Dialogue: 0,0:20:37.97,0:20:41.89,Default-ja,,0,0,0,,Менің ішімде көп нәрсе өрбіген сияқты...
Dialogue: 5,0:20:42.58,0:20:47.44,Default,,0,0,0,,Кеудемде тарылып, жылап жіберетіндей болдым.
Dialogue: 0,0:20:42.60,0:20:47.52,Default-ja,,0,0,0,,Кеудем ауырғандай болды, жылағым келді.
Dialogue: 0,0:20:50.06,0:20:51.40,Default-ja,,0,0,0,,Хина-чан, кешіріңіз.
Dialogue: 5,0:20:50.08,0:20:51.44,Default,,0,0,0,,Хина, кешіріңіз.
Dialogue: 5,0:20:53.44,0:20:54.45,Default,,0,0,0,,Ой, Хиёри-я! Жаңа жылды әзілмен бастап жатырсың ғой, иә?
Dialogue: 0,0:20:53.44,0:20:54.40,Default-ja,,0,0,0,,Өзі ешқашан Ал Майтты басып оза алмайтынын түсінген әкем—
Dialogue: 5,0:20:56.89,0:20:59.38,Default,,0,0,0,,Ақырында мен саған мүлдем көмектесе алмадым.
Dialogue: 0,0:20:56.90,0:20:59.53,Default-ja,,0,0,0,,Ақырында мен ештеңе істей алмадым.
Dialogue: 5,0:21:02.60,0:21:03.64,Default,,0,0,0,,Өте талғампаз болма.
Dialogue: 0,0:21:02.62,0:21:06.62,Default-ja,,0,0,0,,Иә, мен ол кезде осында едім...
Dialogue: 5,0:21:04.46,0:21:06.48,Default,,0,0,0,,Мен дәл осы жерде уәде берсем де
Dialogue: 5,0:21:07.90,0:21:10.52,Default,,0,0,0,,мен сені қорғаймын деп.
Dialogue: 0,0:21:07.91,0:21:10.63,Default-ja,,0,0,0,,Мен сені қорғауға уәде бердім
Dialogue: 5,0:21:16.49,0:21:17.69,Default,,0,0,0,,Жалпы?
Dialogue: 0,0:21:16.51,0:21:17.80,Default-ja,,0,0,0,,«Ештеңе»?
Dialogue: 5,0:21:28.79,0:21:29.98,Default,,0,0,0,,Кирияма.
Dialogue: 0,0:21:28.81,0:21:29.94,Default-ja,,0,0,0,,Кирияма-кун
Dialogue: 0,0:21:32.15,0:21:36.23,Default-ja,,0,0,0,,Сонша… сонша…
Dialogue: 5,0:21:32.17,0:21:33.50,Default,,0,0,0,,Тіпті...
Dialogue: 5,0:21:34.78,0:21:35.57,Default,,0,0,0,,Тіпті...
Dialogue: 5,0:21:37.52,0:21:38.57,Default,,0,0,0,,тыңдадың...
Dialogue: 0,0:21:37.53,0:21:38.53,Default-ja,,0,0,0,,Көп...
Dialogue: 5,0:21:40.57,0:21:42.58,Default,,0,0,0,,маған осы уақытта?
Dialogue: 0,0:21:40.57,0:21:42.53,Default-ja,,0,0,0,,Сіз мені тыңдасаңыз да?
Dialogue: 5,0:21:45.18,0:21:47.71,Default,,0,0,0,,Мені іздеуге Киотоға барсаң да?
Dialogue: 0,0:21:45.20,0:21:47.66,Default-ja,,0,0,0,,Мені іздеу үшін Киотоға дейін келдіңіз бе?
Dialogue: 5,0:21:49.96,0:21:52.55,Default,,0,0,0,,Сіз мені соншалықты бақытты етсеңіз де?
Dialogue: 0,0:21:50.17,0:21:52.50,Default-ja,,0,0,0,,Мен сондай бақытты болсам да?
Dialogue: 0,0:21:52.83,0:21:55.50,Default-ja,,0,0,0,,Иә? Өйткені, соңында...
Dialogue: 5,0:21:53.84,0:21:56.09,Default,,0,0,0,,Менің қолымнан келмеді...
Dialogue: 0,0:21:55.67,0:21:56.76,Default-ja,,0,0,0,,Келіңіздер!
Dialogue: 0,0:21:55.97,0:21:56.01,signs,,0,0,0,,Чомп
Dialogue: 1,0:21:55.97,0:21:56.01,signs,,0,0,0,,Чомп
Dialogue: 0,0:21:56.01,0:21:56.05,signs,,0,0,0,,Шомп
Dialogue: 1,0:21:56.01,0:21:56.05,signs,,0,0,0,,Чомп
Dialogue: 0,0:21:56.05,0:21:56.09,signs,,0,0,0,,Шомп
Dialogue: 1,0:21:56.05,0:21:56.09,signs,,0,0,0,,Чомп
Dialogue: 5,0:21:56.09,0:21:56.80,Default,,0,0,0,,Ой!
Dialogue: 5,0:21:56.80,0:21:58.43,Default,,0,0,0,,Мен бір қолымда оқталған винтовка ұстап тұрмын
Dialogue: 0,0:21:56.96,0:21:59.22,Default-ja,,0,0,0,,«Өйткені» емес...
Dialogue: 5,0:21:58.43,0:21:59.26,Default,,0,0,0,,Бұл не?!
Dialogue: 0,0:21:58.72,0:21:58.76,signs,,0,0,0,,Бұл не?!
Dialogue: 1,0:21:58.72,0:21:58.76,signs,,0,0,0,,Бұл не?!
