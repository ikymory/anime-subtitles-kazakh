Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.24,0:00:11.95,OP,,0,0,0,,Жаңа гүлдеген одуванчиктердің арасында
Dialogue: 0,0:00:11.95,0:00:15.87,OP,,0,0,0,,Қарға айнала алмаған су тамшылары
Dialogue: 0,0:00:15.87,0:00:19.74,OP,,0,0,0,,Мен көз жасына боялған жүзді ажырата аламын деп ойладым
Dialogue: 0,0:00:19.74,0:00:22.46,OP,,0,0,0,,Сондықтан мен ойланбастан қолшатырымды ұсындым
Dialogue: 0,0:00:22.46,0:00:26.57,OP,,0,0,0,,Солға немесе оңға жүру дұрыс па?
Dialogue: 0,0:00:26.57,0:00:30.38,OP,,0,0,0,,Мен шынымен шешім қабылдамай тұрып жол аяқталды
Dialogue: 0,0:00:30.38,0:00:34.43,OP,,0,0,0,,Бірақ бұл ерекше біреуді аямайтын дұрыс қоңырау екені сөзсіз
Dialogue: 0,0:00:34.43,0:00:38.36,OP,,0,0,0,,Кез келген азапты тәжірибелерден
Dialogue: 0,0:00:38.36,0:00:41.49,OP,,0,0,0,,Ендеше, кішкене батылдықпен, алға ұмтылыңыз
Dialogue: 0,0:00:41.49,0:00:45.07,OP,,0,0,0,,Егер бәрі қисық болса, қиғаш жолмен жүріңіз
Dialogue: 0,0:00:45.07,0:00:48.80,OP,,0,0,0,,Алға қарай жүрсең, нұрды табасың
Dialogue: 0,0:00:48.80,0:00:52.52,OP,,0,0,0,,Бір-біріне үйіріліп, бір дауыста сайрап тұрған кішкентай құстар сияқты
Dialogue: 0,0:00:52.52,0:00:56.12,OP,,0,0,0,,Жаңа маусымның басында міндетті түрде қоңырау шаламыз
Dialogue: 0,0:00:56.12,0:00:58.92,OP,,0,0,0,,Сонымен көктем бізді тағы да құшағына алады
Dialogue: 0,0:00:58.92,0:01:03.15,OP,,0,0,0,,Біз жаңа беттерге бояуды шашыратып жібереміз
Dialogue: 0,0:01:03.15,0:01:07.04,OP,,0,0,0,,Екеуміз тез дос болдық, жақсы тамақтандық
Dialogue: 0,0:01:07.04,0:01:09.68,OP,,0,0,0,,Біз тіпті аздап ұрысып қалған шығармыз
Dialogue: 0,0:01:09.68,0:01:13.32,OP,,0,0,0,,Бірақ біз сол кішкентай сәттерді жүрегімізде сақтаймыз
Dialogue: 0,0:01:13.32,0:01:17.05,OP,,0,0,0,,Бізді қателесуге болмайтын болашаққа итермелейтін себептер ретінде
Dialogue: 0,0:01:17.05,0:01:21.44,OP,,0,0,0,,Күн сәулесі түскен ағаштардың арасында қанша рет адасып қалсақ та
Dialogue: 0,0:01:21.44,0:01:26.04,OP,,0,0,0,,Бүгін мұнда бір жақты билетпен желдер алып кетті
Dialogue: 0,0:01:26.04,0:01:27.49,OP,,0,0,0,,Бұл тамаша күнге гүлдейді
Dialogue: 0,0:01:32.41,0:01:35.50,titles,,0,0,0,,Өту уақыты
Dialogue: 5,0:01:50.76,0:01:52.10,Default,,0,0,0,,Көрейік.
Dialogue: 0,0:01:50.92,0:01:55.76,Default-ja,,0,0,0,,Ал... жоғарғысы 135, төменгісі 80
Dialogue: 5,0:01:52.10,0:01:55.77,Default,,0,0,0,,135 80-ден жоғары.
Dialogue: 0,0:01:55.93,0:01:57.26,Default-ja,,0,0,0,,Хмм...
Dialogue: 5,0:01:57.27,0:01:59.94,Default,,0,0,0,,Жаман емес, Кейбір.
Dialogue: 0,0:01:57.43,0:01:59.81,Default-ja,,0,0,0,,Жақсы емес пе? Сомай-чан
Dialogue: 0,0:01:59.93,0:02:00.77,Default-ja,,0,0,0,,Хмм…
Dialogue: 5,0:02:00.77,0:02:02.40,Default,,0,0,0,,Вент ашылғалы үш күн өтті
Dialogue: 0,0:02:00.93,0:02:02.39,Default-ja,,0,0,0,,Жарайды...
Dialogue: 5,0:02:02.40,0:02:04.11,Default,,0,0,0,,Менің айтып отырғаным осы.
Dialogue: 0,0:02:02.56,0:02:04.06,Default-ja,,0,0,0,,Мен күткендей
Dialogue: 5,0:02:04.11,0:02:06.46,Default,,0,0,0,,Қан қысымыңыз біршама төмендеді.
Dialogue: 0,0:02:04.19,0:02:09.61,Default-ja,,0,0,0,,Менің қан қысымым айтарлықтай төмендеді, бірақ дәрі қабылдауды жалғастыруыңызды өтінемін.
Dialogue: 5,0:02:06.46,0:02:08.38,Default,,0,0,0,,Бірақ мен саған көбірек дәрі берейін деп жатырмын.
Dialogue: 5,0:02:08.38,0:02:09.61,Default,,0,0,0,,Оны қабылдауды жалғастырыңыз.
Dialogue: 5,0:02:09.61,0:02:10.45,Default,,0,0,0,,Әрине.
Dialogue: 0,0:02:09.78,0:02:10.44,Default-ja,,0,0,0,,О!
Dialogue: 5,0:02:10.45,0:02:12.37,Default,,0,0,0,,Оны менің үстіме қойыңыз!
Dialogue: 0,0:02:10.61,0:02:12.36,Default-ja,,0,0,0,,Тек соғып жіберіңіз.
Dialogue: 5,0:02:12.37,0:02:14.33,Default,,0,0,0,,Шамамен үш айдың құны.
Dialogue: 0,0:02:12.53,0:02:14.32,Default-ja,,0,0,0,,3 айға жуық
Dialogue: 0,0:02:14.33,0:02:24.17,signs,,0,0,0,,Сакума, М.Д.
Dialogue: 0,0:02:14.49,0:02:18.41,Default-ja,,0,0,0,,Идиот, сен соншалықты бере аласың ба? Бұл 3 аптаға жетеді.
Dialogue: 5,0:02:14.62,0:02:16.94,Default,,0,0,0,,Идиот. Мен саған соншалықты бере алмаймын.
Dialogue: 5,0:02:16.94,0:02:18.51,Default,,0,0,0,,Сіз үш аптаның құнын аласыз.
Dialogue: 5,0:02:18.51,0:02:20.29,Default,,0,0,0,,Қосымша ақпарат алу үшін келесі айда қайта оралыңыз.
Dialogue: 0,0:02:18.54,0:02:20.20,Default-ja,,0,0,0,,Оны алу үшін келесі айда қайтып келіңіз.
Dialogue: 5,0:02:20.29,0:02:22.77,Default,,0,0,0,,Жарайды, жақсы.
Dialogue: 0,0:02:20.33,0:02:24.17,Default-ja,,0,0,0,,Tsk! Қолымнан келмейді, хехе... тағы келемін бе?
Dialogue: 5,0:02:22.77,0:02:24.17,Default,,0,0,0,,Мен сені сонда көремін.
Dialogue: 5,0:02:25.59,0:02:28.81,Default,,0,0,0,,Сіз шынымен де өзгердіңіз, Кейбіреулер.
Dialogue: 0,0:02:25.75,0:02:28.67,Default-ja,,0,0,0,,Сомай-чан да өзгерді.
Dialogue: 0,0:02:28.80,0:02:32.30,Default-ja,,0,0,0,,Ертеде «Дәрігерді бұлай емдемес едім»
Dialogue: 5,0:02:28.81,0:02:32.30,Default,,0,0,0,,Баяғыда сіз: «Мен ешбір дәрігерге сенбеймін!
Dialogue: 5,0:02:32.30,0:02:37.06,Default,,0,0,0,,«Мен қалай өмір сүремін, қашан өлемін!» деуші едің.
Dialogue: 0,0:02:32.47,0:02:37.05,Default-ja,,0,0,0,,«Мен қалағанымдай өмір сүремін, қалағанымдай өлемін» дедің.
Dialogue: 5,0:02:38.06,0:02:44.19,Default,,0,0,0,,Жарайды, әйелім мен қызым мені үш кішкентайыммен тастап кетті.
Dialogue: 0,0:02:38.10,0:02:39.97,Default-ja,,0,0,0,,Кемпір мен оның қызы —
Dialogue: 0,0:02:40.10,0:02:44.19,Default-ja,,0,0,0,,Ол артында үш Хинако қалдырып, дүниеден өтті.
Dialogue: 5,0:02:44.19,0:02:48.01,Default,,0,0,0,,Олар үшін мен оларда бар нәрсемін.
Dialogue: 0,0:02:44.35,0:02:48.11,Default-ja,,0,0,0,,Қазір оларға тек мен ғана керек.
Dialogue: 5,0:02:48.57,0:02:56.08,Default,,0,0,0,,Тозақ болсын, су болсын, мен үшеуі үйленбейінше тірі қалуым керек.
Dialogue: 0,0:02:48.73,0:02:51.86,Default-ja,,0,0,0,,Үшеуі дұрыс үйленбейінше...
Dialogue: 0,0:02:51.99,0:02:56.07,Default-ja,,0,0,0,,Тас шағып кетсе де өмір сүруім керек.
Dialogue: 0,0:02:59.16,0:03:01.45,Default-ja,,0,0,0,,Оларды жайына қалдырыңыз—
Dialogue: 5,0:02:59.19,0:03:06.84,Default,,0,0,0,,Мен олардың алтын жапырақ жиналмалы экранның алдында жалғыз тұруына жол бере алмаймын.
Dialogue: 0,0:03:01.58,0:03:06.79,Default-ja,,0,0,0,,Мен сені алтын жиналмалы экранның алдында тұрғыза алмаймын.
Dialogue: 0,0:03:08.00,0:03:09.71,Default-ja,,0,0,0,,Сомай-чан...
Dialogue: 5,0:03:08.03,0:03:09.56,Default,,0,0,0,,Кейбір...
Dialogue: 0,0:03:11.05,0:03:12.76,Default-ja,,0,0,0,,Бірақ...
Dialogue: 5,0:03:11.08,0:03:12.76,Default,,0,0,0,,Бірақ бәрібір...
Dialogue: 0,0:03:12.92,0:03:14.42,Default-ja,,0,0,0,,Иә...
Dialogue: 5,0:03:14.43,0:03:20.93,Default,,0,0,0,,Момомен ол тезірек үйленсе, маған көмектесер еді.
Dialogue: 0,0:03:14.59,0:03:16.43,Default-ja,,0,0,0,,Тек Момо...
Dialogue: 0,0:03:16.55,0:03:20.93,Default-ja,,0,0,0,,«Сіз маған тезірек үйленсеңіз пайдалы болар еді»...
Dialogue: 0,0:03:20.98,0:03:22.69,signs,,0,0,0,,Хмм...
Dialogue: 1,0:03:20.98,0:03:22.69,signs,,0,0,0,,Хмм...
Dialogue: 5,0:03:22.69,0:03:24.54,Default,,0,0,0,,Ең кішісі, иә?
Dialogue: 0,0:03:22.85,0:03:25.69,Default-ja,,0,0,0,,Ең кенжесі... неше жаста?
Dialogue: 5,0:03:24.54,0:03:25.69,Default,,0,0,0,,Оның жасы нешеде?
Dialogue: 0,0:03:25.86,0:03:25.90,signs,,0,0,0,,шаршы.
Dialogue: 0,0:03:25.90,0:03:25.98,signs,,0,0,0,,Скв
Dialogue: 0,0:03:25.98,0:03:26.07,signs,,0,0,0,,Sque
Dialogue: 0,0:03:26.07,0:03:26.15,signs,,0,0,0,,Сығымдау
Dialogue: 0,0:03:26.15,0:03:27.32,signs,,0,0,0,,Сыққыш
Dialogue: 0,0:03:27.44,0:03:28.69,signs,,0,0,0,,Балшықтан жасалған шарлар
Dialogue: 1,0:03:27.44,0:03:28.69,signs,,0,0,0,,Балшықтан жасалған шарлар
Dialogue: 2,0:03:27.44,0:03:28.69,signs,,0,0,0,,Балшықтан жасалған шарлар
Dialogue: 0,0:03:28.78,0:03:30.65,signs,,0,0,0,,Мектеп жасына дейінгі бала
Dialogue: 1,0:03:28.78,0:03:30.65,signs,,0,0,0,,Мектеп жасына дейінгі бала
Dialogue: 5,0:03:30.65,0:03:33.68,Default,,0,0,0,,Ол әлі мектепке дейінгі мекемеде.
Dialogue: 0,0:03:30.82,0:03:33.57,Default-ja,,0,0,0,,Бұл әлі балабақша.
Dialogue: 5,0:03:33.68,0:03:37.66,Default,,0,0,0,,Егер ол жиырмадан кейін үйленсе, мен...
Dialogue: 0,0:03:33.69,0:03:37.66,Default-ja,,0,0,0,,Сен мені 20 жасымда тастап кетсең де, мен...
Dialogue: 5,0:03:37.66,0:03:40.16,Default,,0,0,0,,менің 90-жылдардың ортасында?!
Dialogue: 0,0:03:37.82,0:03:40.16,Default-ja,,0,0,0,,90-жылдардың ортасы...
Dialogue: 0,0:03:42.54,0:03:47.96,Default-ja,,0,0,0,,Кешіріңіз, Сомай-чан, мен сізді соншалықты тексере алмаймын...
Dialogue: 5,0:03:42.60,0:03:44.70,Default,,0,0,0,,Мұнда.
Dialogue: 5,0:03:44.70,0:03:47.79,Default,,0,0,0,,Мен саған ұзақ қарай алмаймын.
Dialogue: 0,0:03:54.67,0:03:57.51,Default-ja,,0,0,0,,Емтиханға 5 күн қалды...
Dialogue: 5,0:03:54.72,0:03:56.80,Default,,0,0,0,,Қабылдау емтиханына тағы бес күн қалды.
Dialogue: 0,0:03:58.97,0:04:02.06,Default-ja,,0,0,0,,Иә! Мен сондай қуаныштымын!
Dialogue: 5,0:03:59.77,0:04:01.61,Default,,0,0,0,,Мен қатты қобалжыдым!
Dialogue: 0,0:04:02.23,0:04:02.27,signs,,0,0,0,,Үніреу
Dialogue: 1,0:04:02.23,0:04:02.27,signs,,0,0,0,,Үңілу
