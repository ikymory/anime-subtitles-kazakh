Dialogue: 0,0:01:32.41,0:01:35.50,titles,,0,0,0,,Патшалық (1 бөлім)
Dialogue: 0,0:01:39.88,0:01:42.72,Default-ja,,0,0,0,,Уау! таңқаларлық!
Dialogue: 5,0:01:41.25,0:01:42.75,Default,,0,0,0,,Мен көптен бері өлі болсам да
Dialogue: 0,0:01:41.25,0:01:42.75,signs,,0,0,0,,Ыңғайлы
Dialogue: 1,0:01:41.25,0:01:42.75,signs,,0,0,0,,Ыңғайлы
