Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 5,0:00:03.74,0:00:06.02,Default,,0,0,0,,Мен ештеңеге өкінбеймін!
Dialogue: 0,0:00:04.01,0:00:07.60,Default-ja,,0,0,0,,Өкінбейсіз, Жасамаңыз!
Dialogue: 5,0:00:06.02,0:00:07.62,Default,,0,0,0,,Мен алмаймын!
Dialogue: 5,0:00:07.62,0:00:09.04,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:00:07.77,0:00:09.02,Default-ja,,0,0,0,,Себебі—
Dialogue: 5,0:00:09.04,0:00:14.62,Default,,0,0,0,,Менің істегенім дұрыс емес!
Dialogue: 0,0:00:09.18,0:00:14.61,Default-ja,,0,0,0,,Менің істеген ісімде еш қателік жоқ!
Dialogue: 5,0:00:37.74,0:00:38.86,Default,,0,0,0,,Біртүрлі екен.
Dialogue: 0,0:00:37.75,0:00:39.01,Default-ja,,0,0,0,,Бұл біртүрлі.
Dialogue: 5,0:00:40.34,0:00:41.26,Default,,0,0,0,,Тіпті кейін...
Dialogue: 0,0:00:40.34,0:00:41.47,Default-ja,,0,0,0,,Адамдар...
Dialogue: 5,0:00:43.18,0:00:45.32,Default,,0,0,0,,қаншама уақыт өтті,
Dialogue: 0,0:00:43.18,0:00:45.30,Default-ja,,0,0,0,,Қаншама уақыт өткен соң...
Dialogue: 5,0:00:49.98,0:00:51.83,Default,,0,0,0,,Сізді бір нәрсе құтқара алады,
Dialogue: 0,0:00:50.02,0:00:55.56,Default-ja,,0,0,0,,Сіз мүлде басқа жақтан дауыл сияқты құтқарыла аласыз.
Dialogue: 5,0:00:52.76,0:00:55.58,Default,,0,0,0,,мүлде басқа жақтан дауыл сияқты кіріп келеді.
Dialogue: 5,0:01:01.41,0:01:02.40,Default,,0,0,0,,Хина.
Dialogue: 0,0:01:01.44,0:01:02.70,Default-ja,,0,0,0,,Хина-чан
Dialogue: 5,0:01:10.02,0:01:11.02,Default,,0,0,0,,Кел де жуынып ал.
Dialogue: 0,0:01:10.04,0:01:11.20,Default-ja,,0,0,0,,Рахмет
Dialogue: 5,0:01:12.60,0:01:14.10,Default,,0,0,0,,Сіз...
Dialogue: 0,0:01:12.62,0:01:16.21,Default-ja,,0,0,0,,Сен менің жанашырымсың
Dialogue: 5,0:01:14.91,0:01:16.23,Default,,0,0,0,,менің құтқарушым.
Dialogue: 0,0:01:17.38,0:01:18.71,Default-ja,,0,0,0,,Тек қарап тұр.
Dialogue: 5,0:01:17.39,0:01:18.51,Default,,0,0,0,,Дәл солай! Ицумида!
Dialogue: 5,0:01:20.16,0:01:21.61,Default,,0,0,0,,Мен сенімен бірге боламын.
Dialogue: 0,0:01:20.17,0:01:21.59,Default-ja,,0,0,0,,Мен сенімен біргемін
Dialogue: 5,0:01:24.17,0:01:25.39,Default,,0,0,0,,Rei...
Dialogue: 0,0:01:24.18,0:01:25.59,Default-ja,,0,0,0,,Нөл-чан...
Dialogue: 0,0:01:27.47,0:01:32.89,Default-ja,,0,0,0,,Бүкіл өмірімді алса да, мен саған өтемін.
Dialogue: 5,0:01:27.50,0:01:29.16,Default,,0,0,0,,Өмірімнің соңына дейін болса да,
Dialogue: 5,0:01:30.33,0:01:32.75,Default,,0,0,0,,Мен сізге қайтарамын.
Dialogue: 0,0:01:44.25,0:01:51.12,OP,,0,0,0,,Батып бара жатқан күнді әшекейлеген бұлттар құлағыма «Келесі сіздің кезегіңіз» деп сыбырлады.
Dialogue: 1,0:01:44.25,0:01:51.12,OP,,0,0,0,,Батып бара жатқан күнді әшекейлеген бұлттар құлағыма «Келесі сіздің кезегіңіз» деп сыбырлады.
Dialogue: 0,0:01:51.12,0:01:58.34,OP,,0,0,0,,Бірақ қазір олар жай ғана уақытты өлтіруден шаршағандықтан, мен олардың кінәсі болатыныма сенімдімін
Dialogue: 1,0:01:51.12,0:01:58.34,OP,,0,0,0,,Бірақ қазір олар уақытты өлтіруден шаршағандықтан, мен олардың кінәсі болатыныма сенімдімін
Dialogue: 0,0:01:58.34,0:02:01.98,OP,,0,0,0,,Бірақ мен өз әлемімнің патшасымын
Dialogue: 1,0:01:58.34,0:02:01.98,OP,,0,0,0,,Бірақ мен өз әлемімнің патшасымын
Dialogue: 0,0:02:01.98,0:02:05.62,OP,,0,0,0,,Мен тіпті судың үстіне жүгіре аламын
Dialogue: 1,0:02:01.98,0:02:05.62,OP,,0,0,0,,Мен тіпті судың үстіне жүгіре аламын
Dialogue: 0,0:02:05.62,0:02:06.24,OP,,0,0,0,,Мен құлағаннан кейін қайтадан жинала алатын жұмыртқамын
Dialogue: 1,0:02:05.62,0:02:06.24,OP,,0,0,0,,Мен құлағаннан кейін қайтадан жинала алатын жұмыртқамын
Dialogue: 0,0:02:06.24,0:02:09.28,OP,,0,0,0,,Мен құлағаннан кейін қайтадан жинала алатын жұмыртқамын
Dialogue: 1,0:02:06.24,0:02:09.28,OP,,0,0,0,,Мен құлағаннан кейін қайтадан жинала алатын жұмыртқамын
Dialogue: 0,0:02:09.28,0:02:12.82,OP,,0,0,0,,Тіпті ғарышкер болуды жалғастыра алады
Dialogue: 1,0:02:09.28,0:02:12.82,OP,,0,0,0,,Тіпті ғарышкер болуды жалғастыра алады
Dialogue: 0,0:02:12.82,0:02:17.08,OP,,0,0,0,,Мен аспаннан жауған моншақтарды жинап алып, жинайтыныма сенімдімін.
Dialogue: 1,0:02:12.82,0:02:17.08,OP,,0,0,0,,Мен аспаннан жауған моншақтарды жинап алып, жинайтыныма сенімдімін.
Dialogue: 0,0:02:17.08,0:02:20.19,OP,,0,0,0,,Мен аспаннан жауған моншақтарды жинап алып, жинайтыныма сенімдімін.
Dialogue: 1,0:02:17.08,0:02:20.19,OP,,0,0,0,,Мен аспаннан жауған моншақтарды жинап, жинайтыныма сенімдімін.
Dialogue: 0,0:02:20.19,0:02:27.22,OP,,0,0,0,,Содан кейін бір күні мен өзімнің еркіндігімді білдіретін туды отырғыза аламын
Dialogue: 1,0:02:20.19,0:02:27.22,OP,,0,0,0,,Содан кейін бір күні мен өзімнің еркіндігімді білдіретін туды отырғыза аламын
Dialogue: 0,0:02:27.44,0:02:34.71,OP,,0,0,0,,Сондықтан мен жыртылған джинс шалбарымды киіп, сызба әкелетін көз жасымды қайтарамын
Dialogue: 1,0:02:27.44,0:02:34.71,OP,,0,0,0,,Сондықтан мен жыртылған джинс шалбарымды киіп, сызба әкелетін көз жасымды қайтарамын
Dialogue: 0,0:02:34.71,0:02:42.01,OP,,0,0,0,,Мен бір жұтым ауа шығарамын, содан кейін тағы бір жұтамын, өйткені мен қайтадан боксшымын
Dialogue: 1,0:02:34.71,0:02:42.01,OP,,0,0,0,,Мен бір жұтым ауа шығарамын, содан кейін тағы бір жұтамын, өйткені мен қайтадан боксшымын
Dialogue: 0,0:02:42.01,0:02:45.69,OP,,0,0,0,,Сіз жағадан қайту үшін бір ғана мүмкіндік аласыз
Dialogue: 1,0:02:42.01,0:02:45.69,OP,,0,0,0,,Сіз жағадан қайту үшін бір ғана мүмкіндік аласыз
Dialogue: 0,0:02:45.69,0:02:49.27,OP,,0,0,0,,Өзің бояған есікті қағып ал
Dialogue: 1,0:02:45.69,0:02:49.27,OP,,0,0,0,,Өзің бояған есікті қағып ал
Dialogue: 0,0:02:49.27,0:02:53.28,OP,,0,0,0,,Түрлі-түсті сия екі жолға таралады
Dialogue: 1,0:02:49.27,0:02:53.28,OP,,0,0,0,,Түрлі-түсті сия екі жолға таралады
Dialogue: 0,0:02:53.28,0:02:56.67,OP,,0,0,0,,Бірақ сіздің гүліңіздің қалай гүлдейтінін өзіңіз шешесіз
Dialogue: 1,0:02:53.28,0:02:56.67,OP,,0,0,0,,Бірақ сіздің гүліңіздің қалай гүлдейтінін өзіңіз шешесіз
Dialogue: 0,0:03:05.88,0:03:08.97,titles,,0,0,0,,Кіші әлем
Dialogue: 5,0:03:13.34,0:03:14.39,Default,,0,0,0,,Иіскеу, иіскеу.
Dialogue: 5,0:03:18.00,0:03:19.02,Default,,0,0,0,,Иіскеу, иіскеу.
Dialogue: 0,0:03:20.79,0:03:22.88,Default-ja,,0,0,0,,Иә десерт мияу...
Dialogue: 5,0:03:20.81,0:03:22.52,Default,,0,0,0,,Міне десерт!
Dialogue: 0,0:03:24.84,0:03:27.63,Default-ja,,0,0,0,,Бұл Кирияма-кунның кәдесый шиелері.
Dialogue: 5,0:03:24.85,0:03:27.65,Default,,0,0,0,,Бұл Кирияма әкелген шие.
Dialogue: 0,0:03:30.76,0:03:31.64,Default-ja,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 5,0:03:32.06,0:03:34.62,Default,,0,0,0,,Шие!
Dialogue: 0,0:03:32.10,0:03:35.64,Default-ja,,0,0,0,,Шие! Хаха!
Dialogue: 0,0:03:36.35,0:03:38.14,Default-ja,,0,0,0,,Хмм!
Dialogue: 5,0:03:38.54,0:03:40.29,Default,,0,0,0,,Рахмет, Кирияма.
Dialogue: 0,0:03:38.56,0:03:40.27,Default-ja,,0,0,0,,Рахмет, Кирияма-кун
Dialogue: 0,0:03:48.96,0:03:52.22,signs,,0,0,0,,Ном ном
Dialogue: 1,0:03:48.96,0:03:52.22,signs,,0,0,0,,Ном ном
Dialogue: 0,0:03:49.49,0:03:50.74,Default-ja,,0,0,0,,Хмм!
Dialogue: 5,0:03:50.77,0:03:52.22,Default,,0,0,0,,Дәмді!
Dialogue: 0,0:03:50.86,0:03:52.20,Default-ja,,0,0,0,,Ал Батыста Весталис, оны тоқтатуға бел буған
Dialogue: 5,0:03:54.83,0:03:56.74,Default,,0,0,0,,Олардан қышқыл иіс шығады.
Dialogue: 0,0:03:54.87,0:03:56.66,Default-ja,,0,0,0,,Ащы иіс...
Dialogue: 5,0:03:56.74,0:03:58.97,Default,,0,0,0,,Мен жеміс-жидекке ақымақ емеспін.
Dialogue: 0,0:03:56.79,0:03:58.96,Default-ja,,0,0,0,,Жемістер онша емес...
Dialogue: 0,0:04:02.67,0:04:06.96,Default-ja,,0,0,0,,Мм... ннн...
Dialogue: 0,0:04:07.63,0:04:11.18,Default-ja,,0,0,0,,Хмм... Иә? Момо, ұйықтап жатырсың ба?
Dialogue: 5,0:04:09.04,0:04:11.25,Default,,0,0,0,,Иә? Момо, ұйықтап жатырсың ба?
Dialogue: 5,0:04:11.25,0:04:13.36,Default,,0,0,0,,Мүмкін ваннаға түсуіміз керек шығар.
Dialogue: 0,0:04:11.30,0:04:14.97,Default-ja,,0,0,0,,Жуыну керек пе? Қазірдің өзінде сәл ерте.
Dialogue: 5,0:04:13.36,0:04:14.99,Default,,0,0,0,,Бұл үшін әлі ерте.
Dialogue: 0,0:04:19.56,0:04:24.23,Default-ja,,0,0,0,,Ал, Хина-чан, шоги ойнайық.
Dialogue: 5,0:04:19.58,0:04:24.25,Default,,0,0,0,,Сонымен, Хина, шоги ойнап көргің келе ме?
Dialogue: 5,0:04:27.75,0:04:28.75,Default,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
