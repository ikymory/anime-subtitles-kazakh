Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.01,0:00:03.01,Default,,0,0,0,,♪~
Dialogue: 0,0:01:26.55,0:01:28.55,Default,,0,0,0,,~♪
Dialogue: 0,0:01:33.81,0:01:36.89,Default,,0,0,0,,Өлген жоқ, жай ғана шал.
Dialogue: 0,0:01:36.98,0:01:39.31,Default,,0,0,0,,Осы деңгейде? Оны емдеуге болады ма?
Dialogue: 0,0:01:39.40,0:01:40.65,Default,,0,0,0,,Қазір...
Dialogue: 0,0:01:45.90,0:01:46.70,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:01:46.78,0:01:50.49,Default,,0,0,0,,Гехо Гехо Гехо Гехо...
Dialogue: 0,0:01:51.20,0:01:53.79,Default,,0,0,0,,Жарайды, емделіп кеткен сияқтысың.
Dialogue: 0,0:01:56.83,0:02:00.71,Default,,0,0,0,,Сіз толығымен жойылдыңыз ба? біз...
Dialogue: 0,0:02:00.79,0:02:03.00,Default,,0,0,0,,Ах! Менде алқа жоқ
Dialogue: 0,0:02:03.09,0:02:05.34,Default,,0,0,0,,Ах! менің тиыным да
Dialogue: 0,0:02:05.42,0:02:07.51,Default,,0,0,0,,Барлық әшекейлер де жоғалып кетті.
Dialogue: 0,0:02:08.18,0:02:10.55,Default,,0,0,0,,Кейбір заттарыңыз жоғалып кетті
Dialogue: 0,0:02:10.64,0:02:11.97,Default,,0,0,0,,Сіз ештеңе білмейсіз бе?
Dialogue: 0,0:02:12.55,0:02:14.77,Default,,0,0,0,,Бұл сөзсіз қазына жәндігі.
Dialogue: 0,0:02:14.85,0:02:15.68,Default,,0,0,0,,Тынш!
Dialogue: 0,0:02:15.77,0:02:17.64,Default,,0,0,0,,Ал, мен білмеймін.
Dialogue: 0,0:02:17.73,0:02:20.73,Default,,0,0,0,,Сен осында сап түзеп жаттың.
Dialogue: 0,0:02:20.81,0:02:24.48,Default,,0,0,0,,Бұл жерден бізден бұрын өткен адамдар болса керек.
Dialogue: 0,0:02:25.78,0:02:26.82,Default,,0,0,0,,Шаш…
Dialogue: 0,0:02:27.86,0:02:29.49,Default,,0,0,0,,Аруақтардан сақтандыратын сиқыр.
Dialogue: 0,0:02:29.99,0:02:32.62,Default,,0,0,0,,Сізге біреу хабарласқаны анық сияқты.
Dialogue: 0,0:02:32.70,0:02:33.24,Default,,0,0,0,,Иә
Dialogue: 0,0:02:33.33,0:02:35.74,Default,,0,0,0,,（）
Dialogue: 0,0:02:35.83,0:02:36.75,Default,,0,0,0,,Эльф…
Dialogue: 0,0:02:37.33,0:02:38.71,Default,,0,0,0,,Таллман
Dialogue: 0,0:02:39.33,0:02:42.25,Default,,0,0,0,,Жарты аяқ… Гном…
Dialogue: 0,0:02:42.96,0:02:45.00,Default,,0,0,0,,Мына жігіттер тамақ ішіп отыр.
Dialogue: 0,0:02:45.09,0:02:48.38,Default,,0,0,0,,Тамақ? Сізде қандай жүйке бар?
Dialogue: 0,0:02:48.47,0:02:49.38,Default,,0,0,0,,Мен сені қуамын
Dialogue: 0,0:02:49.47,0:02:51.51,Default,,0,0,0,,- (Жинаушы А) Тоқта - (Кабуру) Әй?
Dialogue: 0,0:02:52.09,0:02:53.51,Default,,0,0,0,,Бұл қайырымдылық емес.
Dialogue: 0,0:02:56.60,0:02:57.47,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:02:57.56,0:02:58.77,Default,,0,0,0,,Мен шын мәнінде айта алмаймын.
Dialogue: 0,0:03:00.85,0:03:03.02,Default,,0,0,0,,Неліктен бізге жасыру керек...
Dialogue: 0,0:03:03.11,0:03:06.86,Default,,0,0,0,,Мәйіт неғұрлым көп болса, соғұрлым жақсы.
Dialogue: 0,0:03:07.61,0:03:09.53,Default,,0,0,0,,(Су дыбысы)
Dialogue: 0,0:03:11.36,0:03:14.78,Default,,0,0,0,,Ах~ Мен шашымды тез жуғым келеді.
Dialogue: 0,0:03:14.87,0:03:16.79,Default,,0,0,0,,Оны шабсаң, сергек боласың.
Dialogue: 0,0:03:16.87,0:03:19.58,Default,,0,0,0,,Сіз тағы да осындай дөрекі сөздер айтып отырсыз.
Dialogue: 0,0:03:20.08,0:03:22.58,Default,,0,0,0,,Тіпті Сенші сақалын жуғысы келеді, солай ма?
Dialogue: 0,0:03:24.38,0:03:27.88,Default,,0,0,0,,Сіз қанша уақыттан бері киіміңізді жумайсыз? Қазір жуыңыз!
Dialogue: 0,0:03:28.96,0:03:31.80,Default,,0,0,0,,Сиқырда шаштың да маңызы зор
Dialogue: 0,0:03:31.88,0:03:35.55,Default,,0,0,0,,Оны күту денені қыздыру жаттығуымен бірдей.
Dialogue: 0,0:03:35.64,0:03:39.39,Default,,0,0,0,,Мұндай сақалмен менің тірек сиқырым жұмыс істемеуі мүмкін.
Dialogue: 0,0:03:39.47,0:03:40.93,Default,,0,0,0,,Мен бұл үшін ризамын.
Dialogue: 0,0:03:41.02,0:03:44.31,Default,,0,0,0,,Иә, менде жақсы сабын бар.
Dialogue: 0,0:03:44.90,0:03:47.36,Default,,0,0,0,,Олай болса сақалыңды жуып, өремін.
Dialogue: 0,0:03:50.07,0:03:52.82,Default,,0,0,0,,Иә? иә? Жоқ.
Dialogue: 0,0:03:52.91,0:03:53.82,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:54.53,0:03:56.70,Default,,0,0,0,,Түсіндім, сол кезде...
Dialogue: 0,0:03:56.78,0:03:59.87,Default,,0,0,0,,Міне! Қымбат болғанымен
Dialogue: 0,0:03:59.95,0:04:01.20,Default,,0,0,0,,Біз барамыз ба?
Dialogue: 0,0:04:02.58,0:04:03.96,Default,,0,0,0,,4-ші жертөле қабаты
Dialogue: 0,0:04:04.04,0:04:07.13,Default,,0,0,0,,Ойылған тау жыныстарынан шығатын жер асты сулары
Dialogue: 0,0:04:07.21,0:04:09.17,Default,,0,0,0,,Көл құрайды
Dialogue: 0,0:04:10.34,0:04:13.72,Default,,0,0,0,,Құрамында сиқырлы күш бар су әлсіз жарқырайды.
Dialogue: 0,0:04:13.80,0:04:18.72,Default,,0,0,0,,Су түбінде көрінетін қамал қалашығы елес сияқты тербеледі.
Dialogue: 0,0:04:19.89,0:04:22.98,Default,,0,0,0,,Сенши әдетте 4-қабатты қалай зерттейді?
Dialogue: 0,0:04:23.06,0:04:27.98,Default,,0,0,0,,Бұл жерде балық аулау және аулау... Бұл туралы.
Dialogue: 0,0:04:28.57,0:04:30.98,Default,,0,0,0,,Балалар, сендер оған қалай жетесіңдер?
Dialogue: 0,0:04:31.07,0:04:33.86,Default,,0,0,0,,Әрине, бұл жерде сиқыр пайда болады.
Dialogue: 0,0:04:33.95,0:04:36.45,Default,,0,0,0,,Осылай орындаңыз...
Dialogue: 0,0:04:37.74,0:04:38.74,Default,,0,0,0,,Біз тек сүйіскендей боламыз.
Dialogue: 0,0:04:40.74,0:04:42.91,Default,,0,0,0,,Суда жүру
Dialogue: 0,0:04:43.00,0:04:45.08,Default,,0,0,0,,Бұл...
Dialogue: 0,0:04:45.17,0:04:46.00,Default,,0,0,0,,Ггаааах!
Dialogue: 0,0:04:46.08,0:04:48.00,Default,,0,0,0,,Маған ұнамайды!
Dialogue: 0,0:04:48.09,0:04:50.25,Default,,0,0,0,,Маған ұнамайды! Маған ұнамайды~ Маған ұнамайды~
Dialogue: 0,0:04:50.34,0:04:51.76,Default,,0,0,0,,Оны сонша жек көрмесең де
Dialogue: 0,0:04:51.84,0:04:53.97,Default,,0,0,0,,-Маған ұнамайды- -Ой, жоқ.
Dialogue: 0,0:04:54.05,0:04:55.88,Default,,0,0,0,,Арқанды ілмектеп, тартайық.
Dialogue: 0,0:04:55.97,0:04:57.01,Default,,0,0,0,,Жоқ
Dialogue: 0,0:04:57.09,0:04:59.64,Default,,0,0,0,,Мен оны басып тұрғанда сиқырлы!
Dialogue: 0,0:04:59.72,0:05:00.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:00.35,0:05:01.89,Default,,0,0,0,,Құрышта... Уф
Dialogue: 0,0:05:01.97,0:05:05.27,Default,,0,0,0,,Бұл сауытпен судан өтудің жалғыз жолы
Dialogue: 0,0:05:05.35,0:05:07.27,Default,,0,0,0,,Қайықтағы қауіпті
Dialogue: 0,0:05:08.56,0:05:11.15,Default,,0,0,0,,Адамдар оңай жолға оңай түседі.
Dialogue: 0,0:05:11.23,0:05:14.74,Default,,0,0,0,,Бір сәт тот басады, бірақ оны қайрауға көп уақыт керек...
Dialogue: 0,0:05:14.82,0:05:16.36,Default,,0,0,0,,-Ей! -Гяаааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:05:16.95,0:05:19.03,Default,,0,0,0,,Қараңызшы, бұл үлкен мәселе емес, солай ма?
Dialogue: 0,0:05:19.12,0:05:20.41,Default,,0,0,0,,Мұнда...
Dialogue: 0,0:05:20.99,0:05:24.54,Default,,0,0,0,,Мен түсінбеймін. Нені сонша жек көресің?
Dialogue: 0,0:05:24.62,0:05:28.13,Default,,0,0,0,,Балалар, сиқырға тым немқұрайлы қарайсыңдар.
Dialogue: 0,0:05:28.21,0:05:30.17,Default,,0,0,0,,Мен мұны түсінбеймін.
Dialogue: 0,0:05:30.25,0:05:33.30,Default,,0,0,0,,Ал... көмектесу мүмкін емес.
Dialogue: 0,0:05:33.38,0:05:35.67,Default,,0,0,0,,Сізге ұнауы мүмкін... Иә!
Dialogue: 0,0:05:35.76,0:05:36.30,Default,,0,0,0,,Нува
Dialogue: 0,0:05:39.72,0:05:40.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:41.18,0:05:44.31,Default,,0,0,0,,Не... не? Неліктен бұл соншалықты тиімсіз?
Dialogue: 0,0:05:44.39,0:05:45.81,Default,,0,0,0,,Не~!? (Официант) Бұл – «Ой-Пи», көріп тұрсыз ба.
Dialogue: 0,0:05:45.89,0:05:47.69,Default,,0,0,0,,Иә! Бұл не, оқшаулағыш?
Dialogue: 0,0:05:47.77,0:05:50.73,Default,,0,0,0,,Түрлі құбыжықтардың майы мен қанына малынған.
Dialogue: 0,0:05:50.81,0:05:53.32,Default,,0,0,0,,Жоқ, тез жуып тастаңыз!
Dialogue: 0,0:05:53.40,0:05:55.36,Default,,0,0,0,,Бұны сумен жууға болмайды...
Dialogue: 0,0:05:55.44,0:05:56.74,Default,,0,0,0,,Мұндағы Окаринді
Dialogue: 0,0:05:57.53,0:06:00.70,Default,,0,0,0,,Мен судан өз жолыммен өтемін
Dialogue: 0,0:06:00.78,0:06:01.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:02.03,0:06:03.33,Default,,0,0,0,,Сіз қайық жасағыңыз келе ме?
Dialogue: 0,0:06:03.41,0:06:04.95,Default,,0,0,0,,Ол әп-сәтте балдырға айналады.
Dialogue: 0,0:06:05.04,0:06:08.50,Default,,0,0,0,,Жоқ, сізде керемет идея болуы керек.
Dialogue: 0,0:06:08.58,0:06:10.67,Default,,0,0,0,,Бұл жалпы сенім дегеніміз не?
Dialogue: 0,0:06:10.75,0:06:11.96,Default,,0,0,0,,Мен түсінбеймін
Dialogue: 0,0:06:12.04,0:06:13.46,Default,,0,0,0,,Қараңдар!
Dialogue: 0,0:06:15.80,0:06:18.09,Default,,0,0,0,,- Мимикалық қабық? -Шш!
Dialogue: 0,0:06:22.68,0:06:23.81,Default,,0,0,0,,(Су дыбысы)
Dialogue: 0,0:06:31.69,0:06:32.98,Default,,0,0,0,,Су жылқысы (Келпи)
Dialogue: 0,0:06:33.07,0:06:34.69,Default,,0,0,0,,Қауіпті, артта қал
Dialogue: 0,0:06:34.78,0:06:36.69,Default,,0,0,0,,Жарайды, зияны жоқ.
Dialogue: 0,0:06:37.69,0:06:41.24,Default,,0,0,0,,Анна - балық аулауға барсам, үнемі маған келетін жылқы.
Dialogue: 0,0:06:41.32,0:06:42.24,Default,,0,0,0,,Анна?
Dialogue: 0,0:06:42.82,0:06:46.75,Default,,0,0,0,,Мен біраз уақыттан бері осы затпен көлден өтуді ойлап жүрмін.
Dialogue: 0,0:06:46.83,0:06:48.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:48.21,0:06:52.25,Default,,0,0,0,,Мимикалық қабықшаны сәтті бағыттау үшін қолдануға болады ма?
Dialogue: 0,0:06:52.33,0:06:55.13,Default,,0,0,0,,Міне...
Dialogue: 0,0:06:55.21,0:06:57.09,Default,,0,0,0,,Бұл өте жақсы
Dialogue: 0,0:06:57.84,0:06:59.26,Default,,0,0,0,,-Мен қарсымын -Ой.
Dialogue: 0,0:06:59.88,0:07:03.85,Default,,0,0,0,,Менің ойымша, оның ішкі мүшелерінен жүзу қуығын жасау әлі де пайдалырақ болар еді.
Dialogue: 0,0:07:03.93,0:07:06.06,Default,,0,0,0,,Ха... не деп тұрсың!
Dialogue: 0,0:07:06.14,0:07:08.02,Default,,0,0,0,,Сіз қорқынышты адамсыз.
Dialogue: 0,0:07:08.60,0:07:10.14,Default,,0,0,0,,Құбыжықтар қауіпті
Dialogue: 0,0:07:10.23,0:07:12.40,Default,,0,0,0,,Әсіресе сүйкімділері
Dialogue: 0,0:07:12.48,0:07:16.02,Default,,0,0,0,,Келпилер адамдарды абайсызда ұстап алып, суға түсіреді.
Dialogue: 0,0:07:16.65,0:07:19.40,Default,,0,0,0,,Сіз құбыжықтың шынайы ниетін ешқашан байқамайсыз
Dialogue: 0,0:07:19.49,0:07:23.24,Default,,0,0,0,,Мен Аннді Голем сияқты бұрыннан білемін.
Dialogue: 0,0:07:23.32,0:07:25.91,Default,,0,0,0,,Мен сенен әлдеқайда жақсы білемін.
Dialogue: 0,0:07:25.99,0:07:26.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:27.49,0:07:30.29,Default,,0,0,0,,Неліктен бәрі сүтқоректілерге жұмсақ?
Dialogue: 0,0:07:30.37,0:07:33.33,Default,,0,0,0,,Адам жейтін өсімдіктерді өсіруге қарсы болсам да...
Dialogue: 0,0:07:33.83,0:07:36.25,Default,,0,0,0,,Мен шынымен неге екенін білмеймін?
Dialogue: 0,0:07:36.75,0:07:38.92,Default,,0,0,0,,Кеттік! Энн
Dialogue: 0,0:07:40.97,0:07:42.34,Default,,0,0,0,,Ах... Ei.
Dialogue: 0,0:07:44.01,0:07:45.43,Default,,0,0,0,,Хош иісті!
Dialogue: 0,0:07:45.51,0:07:47.56,Default,,0,0,0,,-Марсиль -Не? Ааа...
Dialogue: 0,0:07:55.48,0:07:56.57,Default,,0,0,0,,Анна…
Dialogue: 0,0:08:02.90,0:08:04.32,Default,,0,0,0,,Тоқта, Энн.
Dialogue: 0,0:08:04.41,0:08:05.49,Default,,0,0,0,,Сен Лорд Дио үшін шайқастың—сен нағыз жақсы жігіт едің, Дж. Гейл.
Dialogue: 0,0:08:07.20,0:08:08.49,Default,,0,0,0,,Уф... уф!
Dialogue: 0,0:08:08.58,0:08:10.50,Default,,0,0,0,,-Уф -Райос...
Dialogue: 0,0:08:10.58,0:08:12.21,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:12.29,0:08:14.21,Default,,0,0,0,,Ммм!
Dialogue: 0,0:08:14.92,0:08:16.21,Default,,0,0,0,,Кешір мені, Энн
Dialogue: 0,0:08:19.30,0:08:20.38,Default,,0,0,0,,Хмм... мм
Dialogue: 0,0:08:21.30,0:08:23.72,Default,,0,0,0,,Хмм, ха!
Dialogue: 0,0:08:24.76,0:08:25.97,Default,,0,0,0,,Өтірік…
Dialogue: 0,0:08:26.05,0:08:28.01,Default,,0,0,0,,Егер болашақ өзгерсе, қайта оралудың қажеті болмайды.
Dialogue: 0,0:08:28.55,0:08:32.39,Default,,0,0,0,,Жоқ...! Ммммммм
Dialogue: 0,0:08:33.06,0:08:34.19,Default,,0,0,0,,Дәл…
Dialogue: 0,0:08:36.35,0:08:37.98,Default,,0,0,0,,Хаа~
Dialogue: 0,0:08:38.82,0:08:41.49,Default,,0,0,0,,Сен мені арқаңа мінуімді күтемін дедің бе?
Dialogue: 0,0:08:41.57,0:08:44.70,Default,,0,0,0,,Мен саған кез келген уақытта шабуыл жасауым мүмкін еді.
Dialogue: 0,0:08:44.78,0:08:48.95,Default,,0,0,0,,Келіңіздер, мен құбыжықтар не ойлайтынын түсінбеймін.
Dialogue: 0,0:08:50.58,0:08:53.46,Default,,0,0,0,,Мен білмеймін. Мен мүлде түсінбеймін.
Dialogue: 0,0:08:58.04,0:09:00.25,Default,,0,0,0,,Әй, суық, солай емес пе?
Dialogue: 0,0:09:00.34,0:09:02.46,Default,,0,0,0,,Енді өртті бастайық.
Dialogue: 0,0:09:02.55,0:09:04.84,Default,,0,0,0,,Ха! Эй...
Dialogue: 0,0:09:05.51,0:09:08.01,Default,,0,0,0,,Сен оны қатты жақсы көрсең де, жейсің бе?
Dialogue: 0,0:09:08.76,0:09:11.26,Default,,0,0,0,,Мен сене алар емеспін. Неліктен?
Dialogue: 0,0:09:12.31,0:09:13.31,Default,,0,0,0,,Саған көмектесейін бе?
Dialogue: 0,0:09:14.48,0:09:15.52,Default,,0,0,0,,Жоқ
Dialogue: 0,0:09:16.19,0:09:17.85,Default,,0,0,0,,Мен мұны жалғыз жасаймын
Dialogue: 0,0:09:24.65,0:09:25.53,Default,,0,0,0,,(Рюи) Неге сен өртеніп жатқан жоқсың?
Dialogue: 0,0:09:26.11,0:09:29.28,Default,,0,0,0,,Майдың біраз бөлігін алуға бола ма?
Dialogue: 0,0:09:29.91,0:09:32.12,Default,,0,0,0,,Ол қандай жел соғады?
Dialogue: 0,0:09:34.12,0:09:35.46,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:09:38.25,0:09:39.17,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:09:40.88,0:09:43.46,Default,,0,0,0,,Біз мұнда не үшін келдік?
Dialogue: 0,0:09:43.96,0:09:45.30,Default,,0,0,0,,- Чилчак - Әй?
Dialogue: 0,0:09:45.38,0:09:47.84,Default,,0,0,0,,Онда бір нәрсе қалқып жатыр
Dialogue: 0,0:09:47.93,0:09:50.51,Default,,0,0,0,,Адам болса жаман болар еді. Барып көрейік.
Dialogue: 0,0:09:50.60,0:09:52.60,Default,,0,0,0,,Иә, маған ұнамайды.
Dialogue: 0,0:09:57.02,0:09:58.90,Default,,0,0,0,,Не? Мынау ақ
Dialogue: 0,0:09:58.98,0:10:01.36,Default,,0,0,0,,Бұл бидай, ішіндегісі ағып жатыр.
Dialogue: 0,0:10:01.90,0:10:03.44,Default,,0,0,0,,Иесімен бірге келеді
Dialogue: 0,0:10:03.53,0:10:04.82,Default,,0,0,0,,Иә
Dialogue: 0,0:10:04.90,0:10:07.11,Default,,0,0,0,,Оны жерге апарайық, а?
Dialogue: 0,0:10:07.65,0:10:08.57,Default,,0,0,0,,Не болды?
Dialogue: 0,0:10:08.66,0:10:11.57,Default,,0,0,0,,Сіз бұл бетті бір жерден танисыз ба?
Dialogue: 0,0:10:11.66,0:10:12.58,Default,,0,0,0,,(Чунтарo) Чип… (Танжиро) Ә?
Dialogue: 0,0:10:13.12,0:10:15.45,Default,,0,0,0,,А, мен бұл коболды білемін.
Dialogue: 0,0:10:15.54,0:10:17.62,Default,,0,0,0,,Ол үшінші жертөле қабатында құлады.
Dialogue: 0,0:10:17.71,0:10:19.79,Default,,0,0,0,,Неге өзіңнен озып бара жатырсың?
Dialogue: 0,0:10:25.30,0:10:26.21,Default,,0,0,0,,Иә
Dialogue: 0,0:10:26.30,0:10:27.47,Default,,0,0,0,,Маған жеңіл қарама
Dialogue: 0,0:10:27.55,0:10:29.22,Default,,0,0,0,,Су перілерімен сауда жасау?
Dialogue: 0,0:10:29.80,0:10:31.80,Default,,0,0,0,,Кешіріңіз... Иә?
Dialogue: 0,0:10:35.97,0:10:36.93,Default,,0,0,0,,Chilchak?
Dialogue: 0,0:10:37.85,0:10:39.73,Default,,0,0,0,,Сау болыңыз! Чакты салқындатыңыз!
Dialogue: 0,0:10:42.31,0:10:43.52,Default,,0,0,0,,Сау болыңыз!
Dialogue: 0,0:10:45.32,0:10:52.32,Default,,0,0,0,,(су перісінің ән айту дауысы)
Dialogue: 0,0:10:54.08,0:11:00.96,Default,,0,0,0,,(Лайостың ән салған дауысы)
Dialogue: 0,0:11:01.71,0:11:04.63,Default,,0,0,0,,(Лайостың ән салған дауысы)
Dialogue: 0,0:11:04.71,0:11:07.63,Default,,0,0,0,,(су перісінің ән айту дауысы)
Dialogue: 0,0:11:07.71,0:11:13.97,Default,,0,0,0,,(Лайостың ән салған дауысы)
Dialogue: 0,0:11:14.05,0:11:15.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:15.97,0:11:18.48,Default,,0,0,0,,Тағы да соңына дейін ән айта алмадым
Dialogue: 0,0:11:18.56,0:11:20.56,Default,,0,0,0,,Мен оны үйренсем де...
Dialogue: 0,0:11:22.60,0:11:25.27,Default,,0,0,0,,Уф... Мен мұнымен жақсымын.
Dialogue: 0,0:11:26.65,0:11:29.07,Default,,0,0,0,,Шашылған бидай – ысырап.
Dialogue: 0,0:11:29.15,0:11:30.45,Default,,0,0,0,,Оларды жинауым керек пе?
Dialogue: 0,0:11:30.53,0:11:32.03,Default,,0,0,0,,Қолайсыздық үшін рахмет.
Dialogue: 0,0:11:32.11,0:11:35.83,Default,,0,0,0,,Олай болса алайық.Марсиль бақытты болады.
Dialogue: 0,0:11:35.91,0:11:37.66,Default,,0,0,0,,Мен Марсильді аяймын.
Dialogue: 0,0:11:37.74,0:11:38.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:40.37,0:11:41.00,Default,,0,0,0,,О
Dialogue: 0,0:11:42.87,0:11:43.96,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:11:44.54,0:11:45.88,Default,,0,0,0,,Мен әлі ештеңе айтқан жоқпын...
Dialogue: 0,0:11:45.96,0:11:48.84,Default,,0,0,0,,Сіз деми адамдарға тиіспеуге уәде бердіңіз!
Dialogue: 0,0:11:48.92,0:11:51.84,Default,,0,0,0,,Аджин Аджин
Dialogue: 0,0:11:52.43,0:11:53.97,Default,,0,0,0,,...Қызық, бұл не?
Dialogue: 0,0:11:54.05,0:11:55.10,Default,,0,0,0,,Не?
Dialogue: 0,0:11:55.18,0:11:59.10,Default,,0,0,0,,Су перілерінің әртүрлі түрлері бар: сүтқоректілер мен балықтар.
Dialogue: 0,0:11:59.18,0:12:01.14,Default,,0,0,0,,Бұл балыққа арналған
Dialogue: 0,0:12:01.23,0:12:03.56,Default,,0,0,0,,Жұмыртқа салатындықтан, кіндік те, емшегі де болмайды.
Dialogue: 0,0:12:03.65,0:12:04.60,Default,,0,0,0,,Желбезектері де бар.
Dialogue: 0,0:12:05.15,0:12:08.57,Default,,0,0,0,,Жіктелуі жағынан олар сиыр мен шошқаға қарағанда адамнан алысырақ деп ойлаймын.
Dialogue: 0,0:12:09.61,0:12:10.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:11.57,0:12:13.99,Default,,0,0,0,,-Жоқ~ -Ех~
Dialogue: 0,0:12:14.07,0:12:15.87,Default,,0,0,0,,Не? Не болды?
Dialogue: 0,0:12:15.95,0:12:18.49,Default,,0,0,0,,Неліктен сиыр жақсы, балықшы жаман?
Dialogue: 0,0:12:18.58,0:12:20.50,Default,,0,0,0,,Маған ұнамайды!
Dialogue: 0,0:12:20.58,0:12:22.50,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:12:23.79,0:12:24.83,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:12:28.34,0:12:29.71,Default,,0,0,0,,Әлі де істеп жатыр
Dialogue: 0,0:12:30.26,0:12:32.67,Default,,0,0,0,,Менің қарным ашты, тамақ жасап берейін деп ойлаймын.
Dialogue: 0,0:12:34.01,0:12:36.26,Default,,0,0,0,,Бидайды суға салып, қыздырыңыз.
Dialogue: 0,0:12:36.34,0:12:39.14,Default,,0,0,0,,Қопсытылған мимикалық ет пен су өсімдіктерін қосыңыз...
Dialogue: 0,0:12:39.22,0:12:40.52,Default,,0,0,0,,Оның мойны… кесіліп қалған жоқ па?
Dialogue: 0,0:12:40.60,0:12:42.89,Default,,0,0,0,,Балықшының басына өскені осы.
Dialogue: 0,0:12:42.98,0:12:46.40,Default,,0,0,0,,Иә, бірақ бұл жай ғана өсімдік.
Dialogue: 0,0:12:46.48,0:12:48.65,Default,,0,0,0,,Балықшылар мұны мимика үшін пайдаланады
Dialogue: 0,0:12:49.23,0:12:52.19,Default,,0,0,0,,Бұл болмаса, ол балыққа көбірек ұқсайтын еді...
Dialogue: 0,0:12:53.49,0:12:55.49,Default,,0,0,0,,Бұл менің көңіл-күйім үшін әлі де нашар ма?
Dialogue: 0,0:12:55.57,0:12:57.53,Default,,0,0,0,,Уф, бұл қиын.
Dialogue: 0,0:12:57.62,0:13:00.29,Default,,0,0,0,,Түсіндім, түсіндім, қалағаныңды істе.
Dialogue: 0,0:13:00.91,0:13:02.29,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:13:02.87,0:13:06.04,Default,,0,0,0,,Мен дәл қазір қате шешім қабылдағандай сезінемін.
Dialogue: 0,0:13:06.12,0:13:07.75,Default,,0,0,0,,Жарайды, дайын!
Dialogue: 0,0:13:10.63,0:13:12.88,Default,,0,0,0,,Марсиль Сенси Түскі ас ішейік
Dialogue: 0,0:13:13.38,0:13:15.13,Default,,0,0,0,,Бұл уақыт әлдеқашан ба?
Dialogue: 0,0:13:15.22,0:13:17.55,Default,,0,0,0,,Бидайды қайдан алдың?
Dialogue: 0,0:13:17.64,0:13:20.26,Default,,0,0,0,,Мен өлі авантюристті сонда алдым.
Dialogue: 0,0:13:20.35,0:13:21.81,Default,,0,0,0,,Не істеп жүрсің?
Dialogue: 0,0:13:21.89,0:13:22.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:22.64,0:13:25.56,Default,,0,0,0,,Дұрыс, Марсиль күткендей.
Dialogue: 0,0:13:25.64,0:13:28.15,Default,,0,0,0,,Жарайды, мен жасаған нәрсеме көмектесе алмаймын.
Dialogue: 0,0:13:28.81,0:13:30.15,Default,,0,0,0,,Itadadakimasu
Dialogue: 0,0:13:31.44,0:13:33.40,Default,,0,0,0,,Өте ұзақ уақыттан бері көрмеппін.
Dialogue: 0,0:13:34.65,0:13:37.82,Default,,0,0,0,,Хм уфф уфф...
Dialogue: 0,0:13:37.91,0:13:41.49,Default,,0,0,0,,Бұл жабысқақ. Бұл не?
Dialogue: 0,0:13:41.58,0:13:44.87,Default,,0,0,0,,Балық улығы Су өсімдіктеріне қосылды деп ойлаймын?
Dialogue: 0,0:13:44.95,0:13:47.12,Default,,0,0,0,,Хмм, бұл дәмді.
Dialogue: 0,0:13:47.21,0:13:49.08,Default,,0,0,0,,Менің ойымша, солай.
Dialogue: 0,0:13:49.17,0:13:50.67,Default,,0,0,0,,Мен оны қолданып көргеніме қуаныштымын.
Dialogue: 0,0:13:51.29,0:13:52.34,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:13:53.00,0:13:53.84,Default,,0,0,0,,Эй!
Dialogue: 0,0:13:53.92,0:13:56.13,Default,,0,0,0,,Бұл балықшының жұмыртқалары.
Dialogue: 0,0:13:56.22,0:14:01.35,Default,,0,0,0,,Балықшылардың басындағы су өсімдіктеріне жұмыртқа салып, қорғайтын әдеті бар дейді.
Dialogue: 0,0:14:02.01,0:14:03.06,Default,,0,0,0,,Не болды?
Dialogue: 0,0:14:03.81,0:14:05.23,Default,,0,0,0,,-Марсиль... -Ах...
Dialogue: 0,0:14:06.81,0:14:08.73,Default,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:14:11.81,0:14:12.77,Default,,0,0,0,,Ал Батыста Весталис, оны тоқтатуға бел буған
Dialogue: 0,0:14:18.07,0:14:18.99,Default,,0,0,0,,Сенси
Dialogue: 0,0:14:20.41,0:14:21.74,Default,,0,0,0,,Мен саған мынаны беремін...
Dialogue: 0,0:14:22.58,0:14:25.50,Default,,0,0,0,,Ламинария майынан сабын жасадым.
Dialogue: 0,0:14:26.08,0:14:31.25,Default,,0,0,0,,Келпи майы шашқа арналған май ретінде пайдалы және оны киім мен ыдысқа да қолдануға болады.
Dialogue: 0,0:14:34.34,0:14:36.55,Default,,0,0,0,,Оны қазір қолдануға бола ма?
Dialogue: 0,0:14:36.63,0:14:39.26,Default,,0,0,0,,Ол әлі сабындану процесінде, сондықтан мен білмеймін ...
Dialogue: 0,0:14:39.84,0:14:43.01,Default,,0,0,0,,Мен оны пайдаланғым келеді. Бұл сіз көп еңбектенген нәрсе емес пе?
Dialogue: 0,0:14:44.85,0:14:45.85,Default,,0,0,0,,Олар үшін де тойып жеңіздер
Dialogue: 0,0:15:01.61,0:15:06.04,Default,,0,0,0,,Хаа ха ха... хаа ха...
Dialogue: 0,0:15:06.12,0:15:11.29,Default,,0,0,0,,Ха ха ха... ха ха ха...
Dialogue: 0,0:15:20.38,0:15:21.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:25.26,0:15:27.22,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:15:27.31,0:15:29.43,Default,,0,0,0,,Енді бірге алға жылжайық.
Dialogue: 0,0:15:30.64,0:15:31.98,Default,,0,0,0,,Төзе бер, шыдай бер!
Dialogue: 0,0:15:32.06,0:15:34.77,Default,,0,0,0,,Осылай қарағанымда мен бір нәрсені түсіндім.
Dialogue: 0,0:15:35.77,0:15:39.69,Default,,0,0,0,,Суда жүру өте жақсы сезінеді.
Dialogue: 0,0:15:40.74,0:15:42.82,Default,,0,0,0,,Рахмет сізге Марсиль
Dialogue: 0,0:15:43.78,0:15:44.49,Default,,0,0,0,,Иә
Dialogue: 0,0:15:45.16,0:15:48.20,Default,,0,0,0,,Сабын көзімді шағып тұр.
Dialogue: 0,0:15:55.84,0:15:56.92,Default,,0,0,0,,Ішек
Dialogue: 0,0:15:57.00,0:15:59.59,Default,,0,0,0,,...
Dialogue: 0,0:16:00.30,0:16:01.30,Default,,0,0,0,,Маған қалдырыңыз!
Dialogue: 0,0:16:01.80,0:16:03.72,Default,,0,0,0,,I'll wipe it out!
Dialogue: 0,0:16:03.80,0:16:04.97,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:16:06.01,0:16:06.72,Default,,0,0,0,,Уау
Dialogue: 0,0:16:10.48,0:16:12.14,Default,,0,0,0,,- Қауіпті! -Оу
Dialogue: 0,0:16:12.23,0:16:14.02,Default,,0,0,0,,Nu… ku…
Dialogue: 0,0:16:14.60,0:16:16.15,Default,,0,0,0,,I told you not to!
Dialogue: 0,0:16:16.23,0:16:18.73,Default,,0,0,0,,Су астындағы жарылыс тым көп өлтіреді!
Dialogue: 0,0:16:18.82,0:16:19.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:19.73,0:16:26.24,Default,,0,0,0,,Бұл жүзді балықты қайнатып, грильде, бумен пісіруге, кептіруге, ысталған немесе шикі түрде жеуге болады...
Dialogue: 0,0:16:26.32,0:16:28.66,Default,,0,0,0,,Қалай пісірсең де дәмді балық екен.
Dialogue: 0,0:16:29.33,0:16:31.70,Default,,0,0,0,,Сондай-ақ басқа құбыжықтарға тамақ ретінде қызмет етеді
Dialogue: 0,0:16:31.79,0:16:35.92,Default,,0,0,0,,Егер ол азайса, лабиринттің экожүйесіне әсер етеді.
Dialogue: 0,0:16:36.00,0:16:38.59,Default,,0,0,0,,Егер сіз мұны жасағыңыз келсе, оны бір-бірден мақсат етіңіз.
Dialogue: 0,0:16:38.67,0:16:41.05,Default,,0,0,0,,Иә~ Бұл мүмкін емес.
Dialogue: 0,0:16:41.63,0:16:45.30,Default,,0,0,0,,Ойлап қарасам, орташа бойлы құбыжықтар әдеттегіден азырақ сияқты...
Dialogue: 0,0:16:45.39,0:16:46.30,Default,,0,0,0,,Мұнда қараңыз.
Dialogue: 0,0:16:46.39,0:16:48.97,Default,,0,0,0,,Мен бұрыштарды кесіп жатқан жоқпын.
Dialogue: 0,0:16:49.06,0:16:50.93,Default,,0,0,0,,Олар сені де өлтірмекші болып отыр.
Dialogue: 0,0:16:51.52,0:16:54.44,Default,,0,0,0,,Жүзді балықтар әдеттегіден көп.
Dialogue: 0,0:16:54.52,0:16:56.56,Default,,0,0,0,,Уайымдайтын ештеңе жоқ, солай ма?
Dialogue: 0,0:16:56.65,0:16:58.69,Default,,0,0,0,,Енді тамақ іше алмасаңыз не істейсіз?
Dialogue: 0,0:16:58.77,0:17:01.82,Default,,0,0,0,,Құбыжық экожүйесін қорға, менің өлгім келмейді.
Dialogue: 0,0:17:05.66,0:17:09.24,Default,,0,0,0,,Хмф, сендер оңай жолды таңдайсыңдар.
Dialogue: 0,0:17:09.74,0:17:13.08,Default,,0,0,0,,Иә? Ендеше, Сенші, оларды бір-бірлеп жеңіп көр.
Dialogue: 0,0:17:13.16,0:17:14.54,Default,,0,0,0,,Өйткені бұл қиын
Dialogue: 0,0:17:16.67,0:17:19.29,Default,,0,0,0,,Экожүйе туралы көбірек ойланыңыз...
Dialogue: 0,0:17:19.38,0:17:21.21,Default,,0,0,0,,-Ааааа~ -Ну~?
Dialogue: 0,0:17:21.30,0:17:23.59,Default,,0,0,0,,Уау! Не? Не?
Dialogue: 0,0:17:23.67,0:17:25.01,Default,,0,0,0,,Сенші!
Dialogue: 0,0:17:27.01,0:17:29.68,Default,,0,0,0,,Не? Мен өтіп бара жаттым
Dialogue: 0,0:17:30.56,0:17:31.60,Default,,0,0,0,,Сіз жарақат алдыңыз ба?
Dialogue: 0,0:17:33.31,0:17:34.31,Default,,0,0,0,,Сенши?
Dialogue: 0,0:17:36.02,0:17:38.19,Default,,0,0,0,,- Бірдеңе жақындап қалды - А?
Dialogue: 0,0:17:44.11,0:17:46.20,Default,,0,0,0,,-Уау! -Уау
Dialogue: 0,0:17:46.28,0:17:48.20,Default,,0,0,0,,-Уау~ -Бұл өтірік, солай ма?
Dialogue: 0,0:17:49.12,0:17:50.45,Default,,0,0,0,,Тым үлкен
Dialogue: 0,0:17:50.53,0:17:52.95,Default,,0,0,0,,Уау! Ах...
Dialogue: 0,0:17:54.29,0:17:54.95,Default,,0,0,0,,Уау
Dialogue: 0,0:17:56.29,0:17:57.21,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:58.00,0:17:59.58,Default,,0,0,0,,Ахх!
Dialogue: 0,0:18:00.46,0:18:03.30,Default,,0,0,0,,Кальмар... Әлде сегізаяқ па?
Dialogue: 0,0:18:03.38,0:18:04.59,Default,,0,0,0,,Бұл Кракен!
Dialogue: 0,0:18:04.67,0:18:09.55,Default,,0,0,0,,Бұл бастапқыда үлкен құбыжық, бірақ әдеттегіден бірнеше есе үлкен.
Dialogue: 0,0:18:10.55,0:18:11.97,Default,,0,0,0,,Тамаша, салқын таң, иә?
Dialogue: 0,0:18:12.05,0:18:13.51,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:18:13.60,0:18:15.39,Default,,0,0,0,,Нашар қозғалсаң, өлтіресің.
Dialogue: 0,0:18:15.48,0:18:16.89,Default,,0,0,0,,Оны бірге тартамыз
Dialogue: 0,0:18:17.39,0:18:18.60,Default,,0,0,0,,Мен сені сұрадым, Марсиль.
Dialogue: 0,0:18:19.65,0:18:21.11,Default,,0,0,0,,Бұл тағы да сиқыр ма?
Dialogue: 0,0:18:21.19,0:18:23.98,Default,,0,0,0,,Уайымдамаңыз, мен мұны дұрыс түсінемін.
Dialogue: 0,0:18:26.11,0:18:26.99,Default,,0,0,0,,Ах
Dialogue: 0,0:18:27.70,0:18:28.61,Default,,0,0,0,,келді
Dialogue: 0,0:18:29.49,0:18:30.78,Default,,0,0,0,,Тоқтамаңыз!
Dialogue: 0,0:18:36.58,0:18:37.71,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:38.50,0:18:39.33,Default,,0,0,0,,Ол күтпеген жерден сол жақ қорғаныстан тік соққымен жауап қайтарды
Dialogue: 0,0:18:39.42,0:18:41.92,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:18:42.00,0:18:43.29,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:50.26,0:18:51.97,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:52.05,0:18:54.18,Default,,0,0,0,,Өтірік... Мен мүлде жауап бермедім.
Dialogue: 0,0:18:54.93,0:18:55.77,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:18:55.85,0:18:58.89,Default,,0,0,0,,Қару-жараққа келсек, бір жұқа тері – таудай қауіпсіздік...
Dialogue: 0,0:18:58.98,0:18:59.77,Default,,0,0,0,,Хмм.
Dialogue: 0,0:19:00.94,0:19:01.77,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:02.36,0:19:03.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:07.44,0:19:08.15,Default,,0,0,0,,Ой
Dialogue: 0,0:19:09.36,0:19:11.74,Default,,0,0,0,,Ахх! Уф!
Dialogue: 0,0:19:17.58,0:19:19.50,Default,,0,0,0,,Сиқырдың бір түрі Сиқырдың бір түрі...
Dialogue: 0,0:19:19.58,0:19:20.87,Default,,0,0,0,,-Марсиль! -Ах
Dialogue: 0,0:19:20.96,0:19:23.63,Default,,0,0,0,,-Тағы да сиқыр сұраңыз -Иә?
Dialogue: 0,0:19:23.71,0:19:26.21,Default,,0,0,0,,Мұндай үлкен атуды бірнеше рет ату мүмкін емес.
Dialogue: 0,0:19:26.30,0:19:27.13,Default,,0,0,0,,Жоқ
Dialogue: 0,0:19:27.80,0:19:28.71,Default,,0,0,0,,Жан-Пьер Польнарефф
Dialogue: 0,0:19:29.88,0:19:32.64,Default,,0,0,0,,Біріншіден, сіз Кракенді бірінші рет көріп тұрсыз, солай ма?
Dialogue: 0,0:19:33.76,0:19:35.81,Default,,0,0,0,,Оның қандай құбыжық екенін білесің бе?
Dialogue: 0,0:19:35.89,0:19:37.27,Default,,0,0,0,,-Білмеймін -Жоқ!
Dialogue: 0,0:19:37.85,0:19:39.43,Default,,0,0,0,,Мен Кракен туралы білмеймін, бірақ
Dialogue: 0,0:19:39.52,0:19:42.02,Default,,0,0,0,,Мен бұрын кальмар мен сегізаяқты өңдегенмін.
Dialogue: 0,0:19:43.44,0:19:44.90,Default,,0,0,0,,А, бұл қауіпті, Марсиль!
Dialogue: 0,0:19:44.98,0:19:46.15,Default,,0,0,0,,Мен сонда бардым!
Dialogue: 0,0:19:49.15,0:19:50.40,Default,,0,0,0,,Су…
Dialogue: 0,0:19:50.49,0:19:51.53,Default,,0,0,0,,Жаяу!
Dialogue: 0,0:19:52.36,0:19:53.41,Default,,0,0,0,,Ой-оу!
Dialogue: 0,0:19:58.79,0:19:59.41,Default,,0,0,0,,Әй!
Dialogue: 0,0:20:06.34,0:20:08.42,Default,,0,0,0,,Кальмар сегізаяқты қатайтқанда
Dialogue: 0,0:20:08.50,0:20:09.67,Default,,0,0,0,,Көзге…
Dialogue: 0,0:20:09.76,0:20:10.67,Default,,0,0,0,,Арасында!
Dialogue: 0,0:20:11.67,0:20:12.68,Default,,0,0,0,,(пышақ сұққан дыбысы)
Dialogue: 0,0:20:22.27,0:20:23.69,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:20:24.60,0:20:26.73,Default,,0,0,0,,Иә? Лайос ше?
Dialogue: 0,0:20:27.90,0:20:31.19,Default,,0,0,0,,Әй, міне, осында.
Dialogue: 0,0:20:31.28,0:20:32.70,Default,,0,0,0,,Иә~
Dialogue: 0,0:20:33.86,0:20:37.33,Default,,0,0,0,,Мына жігіт орта бойлы құбыжықтарды жеп жүрген сияқты...
Dialogue: 0,0:20:37.99,0:20:39.20,Default,,0,0,0,,-Екеуі де -(Екі адам) Ах.
Dialogue: 0,0:20:39.29,0:20:40.54,Default,,0,0,0,,Бір сәт осында кел.
Dialogue: 0,0:20:42.16,0:20:42.96,Default,,0,0,0,,Хмм.
Dialogue: 0,0:20:43.04,0:20:46.92,Default,,0,0,0,,Теңіз өнімдерін бір рет тазалап көру керек.
Dialogue: 0,0:20:47.54,0:20:50.71,Default,,0,0,0,,Бұл аймақты ойып алсаңыз, кальмар мен сегізаяқ жақсы тартылады.
Dialogue: 0,0:20:50.80,0:20:52.97,Default,,0,0,0,,Кальмар мен сегізаяқ жақсы ма?
Dialogue: 0,0:20:53.05,0:20:55.43,Default,,0,0,0,,Не, бұл өтірік! Сіз оны ешқашан жеп көрмедіңіз бе?
Dialogue: 0,0:20:55.51,0:20:57.47,Default,,0,0,0,,Өте дәмді болса да...
Dialogue: 0,0:20:57.55,0:21:02.10,Default,,0,0,0,,Қайнату, пісіру, бумен пісіру, кептіру, шегу, шикі жеу...
Dialogue: 0,0:21:02.18,0:21:04.98,Default,,0,0,0,,Не істесең де дәмді~
Dialogue: 0,0:21:05.06,0:21:08.73,Default,,0,0,0,,Мен жақсы мейрамхананы білемін, сондықтан келесі жолы ол туралы айтамын.
Dialogue: 0,0:21:08.81,0:21:10.15,Default,,0,0,0,,Қазір жақсы емес пе?
Dialogue: 0,0:21:11.07,0:21:11.61,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:11.69,0:21:12.99,Default,,0,0,0,,Қабір...!
Dialogue: 0,0:21:13.69,0:21:15.99,Default,,0,0,0,,Уау, бұл біртүрлі.
Dialogue: 0,0:21:16.07,0:21:17.99,Default,,0,0,0,,Оны қалай жеу керек?
Dialogue: 0,0:21:18.07,0:21:20.24,Default,,0,0,0,,Оған тұз себу керек пе?
Dialogue: 0,0:21:20.33,0:21:21.41,Default,,0,0,0,,Ахх
Dialogue: 0,0:21:22.33,0:21:24.66,Default,,0,0,0,,Уф... сасық!
Dialogue: 0,0:21:24.75,0:21:25.37,Default,,0,0,0,,Жарайды, барлығыңыз, ережелерді түсіндірейін
Dialogue: 0,0:21:25.96,0:21:29.63,Default,,0,0,0,,Сұмдық, аузымды шымырлатып жібереді.
Dialogue: 0,0:21:29.71,0:21:32.51,Default,,0,0,0,,Марсиль мұны барлық тағамдармен бірге жейді...
Dialogue: 0,0:21:32.59,0:21:35.51,Default,,0,0,0,,Жоқ, жоқ! Осы біртүрлі түсініспеушілікті тоқтатыңыз!
Dialogue: 0,0:21:36.13,0:21:36.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:40.51,0:21:42.01,Default,,0,0,0,,Фуууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:21:43.52,0:21:45.43,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:21:45.52,0:21:47.65,Default,,0,0,0,,Ғажайып таңғажайып
Dialogue: 0,0:21:47.73,0:21:50.56,Default,,0,0,0,,Ірі құбыжықтардың да ірі паразиттері болады.
Dialogue: 0,0:21:50.65,0:21:52.78,Default,,0,0,0,,Жоқ, бұл жиіркенішті.
Dialogue: 0,0:21:52.86,0:21:53.94,Default,,0,0,0,,Оны қазір лақтырып тастаңыз!
Dialogue: 0,0:21:54.03,0:21:55.78,Default,,0,0,0,,Нені шулатып жатырсың?
Dialogue: 0,0:21:55.86,0:21:58.20,Default,,0,0,0,,Паразиттер тірі организмдерге ортақ
Dialogue: 0,0:21:58.28,0:22:01.66,Default,,0,0,0,,Олардың көпшілігі тамақ дайындауға да жол табады.
Dialogue: 0,0:22:01.74,0:22:03.33,Default,,0,0,0,,Мұны айтудың қажеті жоқ!
Dialogue: 0,0:22:03.91,0:22:06.21,Default,,0,0,0,,Олай болса, сіз оны пісірсеңіз, оны да жеуге болады.
Dialogue: 0,0:22:06.29,0:22:07.37,Default,,0,0,0,,Маған ұнамайды!
Dialogue: 0,0:22:07.46,0:22:09.67,Default,,0,0,0,,Мұндай ойлау тәсілі де бар.
Dialogue: 0,0:22:09.75,0:22:11.46,Default,,0,0,0,,Маған ұнамайды.
Dialogue: 0,0:22:11.54,0:22:12.50,Default,,0,0,0,,(пышақ сұққан дыбысы)
Dialogue: 0,0:22:29.10,0:22:32.61,Default,,0,0,0,,Мұны тұздықпен гриль жасап көруім керек пе?
Dialogue: 0,0:22:35.61,0:22:39.53,Default,,0,0,0,,А... бірер минут бұрын оның иісі шыққаны сонша, ашуланып кеттім.
Dialogue: 0,0:22:39.61,0:22:41.66,Default,,0,0,0,,(желдеткіш дыбыс)
Dialogue: 0,0:22:42.24,0:22:43.58,Default,,0,0,0,,(Эмма) Бүкіл отбасыны алып шығу үшін. (Мусика) Дұрыс
Dialogue: 0,0:22:46.25,0:22:47.46,Default,,0,0,0,,Аму, аму...
Dialogue: 0,0:22:48.00,0:22:49.25,Default,,0,0,0,,Ол аяқталды!
Dialogue: 0,0:22:52.59,0:22:54.42,Default,,0,0,0,,Өте ұзақ уақыттан бері көрмеппін.
Dialogue: 0,0:22:55.13,0:22:55.63,Default,,0,0,0,,Аму
Dialogue: 0,0:22:56.51,0:22:57.17,Default,,0,0,0,,Хмм...
Dialogue: 0,0:22:57.76,0:22:59.01,Default,,0,0,0,,Тамаша!
Dialogue: 0,0:22:59.59,0:23:03.01,Default,,0,0,0,,Маған қызық, бұл не, ол сондай үлпілдек, дәмді.
Dialogue: 0,0:23:03.10,0:23:05.85,Default,,0,0,0,,Бұл аздап шырышты, бірақ ол қалың.
Dialogue: 0,0:23:05.93,0:23:08.48,Default,,0,0,0,,-Ммммммммм -мммммммм
Dialogue: 0,0:23:09.31,0:23:11.19,Default,,0,0,0,,Әй, дәмді!
Dialogue: 0,0:23:11.27,0:23:12.35,Default,,0,0,0,,бара алмаймын
Dialogue: 0,0:23:12.44,0:23:15.65,Default,,0,0,0,,Дәмі кәдімгі балықтан өзгеше.
Dialogue: 0,0:23:15.73,0:23:18.32,Default,,0,0,0,,Бұл кальмардан немесе сегізаяқтан жақсы емес пе?
Dialogue: 0,0:23:18.40,0:23:20.49,Default,,0,0,0,,Бұл дұрыс емес... Ах.
Dialogue: 0,0:23:21.61,0:23:23.74,Default,,0,0,0,,Жоқ... мүмкін
Dialogue: 0,0:23:23.82,0:23:27.29,Default,,0,0,0,,Бірақ бұл қалай дайындасаңыз да дәмді болып көрінеді.
Dialogue: 0,0:23:27.37,0:23:29.66,Default,,0,0,0,,Мен оны шикі түрде тістеп алдым, дәмі жоқ.
Dialogue: 0,0:23:29.75,0:23:31.50,Default,,0,0,0,,Сәлем! Сіз оны шикі жедіңіз бе?
Dialogue: 0,0:23:32.08,0:23:33.13,Default,,0,0,0,,Кішкене ғана.
Dialogue: 0,0:23:33.21,0:23:34.79,Default,,0,0,0,,Жарайды, өйткені ол әлдеқашан өлді.
Dialogue: 0,0:23:34.88,0:23:35.50,Default,,0,0,0,,О
Dialogue: 0,0:23:35.59,0:23:38.76,Default,,0,0,0,,Ой, балықтар кракенді жеп жатыр.
Dialogue: 0,0:23:38.84,0:23:43.26,Default,,0,0,0,,Осы арқылы орташа өлшемді құбыжықтар саны біртіндеп қайтады.
Dialogue: 0,0:23:45.10,0:23:46.56,Default,,0,0,0,,Уф
Dialogue: 0,0:23:46.64,0:23:48.27,Default,,0,0,0,,Уф... Менің қарным ашты...
Dialogue: 0,0:23:48.35,0:23:49.10,Default,,0,0,0,,Уф, ауырып тұр
Dialogue: 0,0:23:49.81,0:23:51.27,Default,,0,0,0,,Itetetetetetete…
Dialogue: 0,0:23:51.35,0:23:53.56,Default,,0,0,0,,Не болды?Сенімен бәрі жақсы ма?
Dialogue: 0,0:23:53.65,0:23:54.86,Default,,0,0,0,,Бұл...
Dialogue: 0,0:23:55.36,0:23:57.15,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:23:57.23,0:23:58.15,Default,,0,0,0,,Лайос
Dialogue: 0,0:23:58.23,0:24:01.95,Default,,0,0,0,,Сіз алып паразиттің ішінде болдыңыз. Сізді паразит басып қалды.
Dialogue: 0,0:24:02.03,0:24:03.28,Default,,0,0,0,,Уф...
Dialogue: 0,0:24:03.36,0:24:06.12,Default,,0,0,0,,Қарапайым балыққа да жабысады.
Dialogue: 0,0:24:06.20,0:24:07.99,Default,,0,0,0,,Мен оны тазалау кезінде көрдім
Dialogue: 0,0:24:08.08,0:24:09.04,Default,,0,0,0,,Бұл...
Dialogue: 0,0:24:09.62,0:24:14.04,Default,,0,0,0,,Адам үшін паразиттік емес, бірақ асқазанды тесетіндіктен өте ауырады.
Dialogue: 0,0:24:14.13,0:24:16.88,Default,,0,0,0,,Жарайды... жәндіктердің өлуін күтуіміз керек.
Dialogue: 0,0:24:17.88,0:24:20.55,Default,,0,0,0,,Мен бірінші өлмеймін бе?
Dialogue: 0,0:24:20.63,0:24:23.09,Default,,0,0,0,,Егер мен сізге оқтын-оқтын қалпына келтіру сиқырын жасасам ше?
Dialogue: 0,0:24:23.18,0:24:24.30,Default,,0,0,0,,Иә.
Dialogue: 0,0:24:24.39,0:24:26.43,Default,,0,0,0,,Бірақ мен...
Dialogue: 0,0:24:26.97,0:24:31.52,Default,,0,0,0,,Балықшы жүзді балықты жейді, кракен балықшыны жейді
Dialogue: 0,0:24:31.60,0:24:35.94,Default,,0,0,0,,Кракенді жеңеміз, ал кішкентай балық оның етін жейді.
Dialogue: 0,0:24:36.65,0:24:39.86,Default,,0,0,0,,Кракен паразиттерін жеген Лайостың асқазан қабырғасында.
Dialogue: 0,0:24:39.94,0:24:43.20,Default,,0,0,0,,Сонымен қатар, паразит тесік жасайды.
Dialogue: 0,0:24:44.66,0:24:49.37,Default,,0,0,0,,«Экожүйені қорғау» аздап әсірелеу.
Dialogue: 0,0:24:49.45,0:24:54.46,Default,,0,0,0,,Бізді әуел бастан лабиринт шеңберіне қостық.
Dialogue: 0,0:24:56.42,0:24:58.46,Default,,0,0,0,,Лайос бірдеңе айтқысы келді, бірақ
Dialogue: 0,0:24:58.54,0:25:03.47,Default,,0,0,0,,Қатты ауырсыну мен жүрек айнуы ойлауға мүмкіндік бермеді.
Dialogue: 0,0:25:04.38,0:25:09.56,Default,,0,0,0,,Денемнің ішін кескен пышақтай ауыру түні бойы созылды.
Dialogue: 0,0:25:10.06,0:25:15.14,Default,,0,0,0,,Мен енді ешқашан шикі паразиттерді жемеуге ант бердім.
Dialogue: 0,0:25:16.06,0:25:18.06,Default,,0,0,0,,♪~
Dialogue: 0,0:26:43.23,0:26:45.23,Default,,0,0,0,,~♪
