Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:36.53,0:01:39.37,Default,,0000,0000,0000,,《Laios: Оның иісі жақсы》
Dialogue: 0,0:01:39.37,0:01:41.37,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:01:43.54,0:01:45.54,Default,,0000,0000,0000,,Хош иісті?
Dialogue: 0,0:01:45.54,0:01:48.71,Default,,0000,0000,0000,,Уа... ау!
Dialogue: 0,0:01:48.71,0:01:51.38,Default,,0000,0000,0000,,Мұнда ешкім жоқ сияқты. (Ұшқыш А) Жоқ, бар.
Dialogue: 0,0:01:51.38,0:01:53.38,Default,,0000,0000,0000,,Міне болды.
Dialogue: 0,0:01:53.38,0:01:56.05,Default,,0000,0000,0000,,О, ояусың ба?
Dialogue: 0,0:01:53.38,0:01:56.05,Default,,0000,0000,0000,,Қайырлы таң.
Dialogue: 0,0:01:56.05,0:01:58.38,Default,,0000,0000,0000,,Сіз таңғы ас әзірледіңіз бе?
Dialogue: 0,0:01:58.38,0:02:01.65,Default,,0000,0000,0000,,Сенши мырза
Dialogue: 0,0:01:58.38,0:02:01.65,Default,,0000,0000,0000,,Сіз өте жақсы аспазсыз.
Dialogue: 0,0:02:01.65,0:02:05.16,Default,,0000,0000,0000,,Дұрыс, Сенші керемет!
Dialogue: 0,0:02:12.33,0:02:14.33,Default,,0000,0000,0000,,Аан.
Dialogue: 0,0:02:14.33,0:02:18.17,Default,,0000,0000,0000,,Хмм, дәмді.
Dialogue: 0,0:02:14.33,0:02:18.17,Default,,0000,0000,0000,,Яад.
Dialogue: 0,0:02:18.17,0:02:20.34,Default,,0000,0000,0000,,​​О?
Dialogue: 0,0:02:18.17,0:02:20.34,Default,,0000,0000,0000,,Сіз де қолданып көргіңіз келе ме?
Dialogue: 0,0:02:20.34,0:02:23.01,Default,,0000,0000,0000,,Бірақ мен дәмін татамын...
Dialogue: 0,0:02:23.01,0:02:25.01,Default,,0000,0000,0000,,Қараңыз.
Dialogue: 0,0:02:32.19,0:02:35.02,Default,,0000,0000,0000,,Жылы және... жұмсақ.
Dialogue: 0,0:02:35.02,0:02:41.03,Default,,0000,0000,0000,,Дәмі бұлшық ет тәрізді.
Dialogue: 0,0:02:35.02,0:02:41.03,Default,,0000,0000,0000,,Жылтыратпасаң, бұзылады.
Dialogue: 0,0:02:41.03,0:02:46.03,Default,,0000,0000,0000,,Алдымен текстурадан ләззат алыңыз
Dialogue: 0,0:02:41.03,0:02:46.03,Default,,0000,0000,0000,,Жұмысты бастау.
Dialogue: 0,0:02:41.03,0:02:46.03,Default,,0000,0000,0000,,Иә….
Dialogue: 0,0:02:46.03,0:02:49.04,Default,,0000,0000,0000,,Сондай-ақ, қараңыз ...
Dialogue: 0,0:02:46.03,0:02:49.04,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:02:49.04,0:02:51.04,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:02:51.04,0:02:53.54,Default,,0000,0000,0000,,Кейде өткенде➡
Dialogue: 0,0:02:53.54,0:02:57.21,Default,,0000,0000,0000,,Осылайша атаммен, ата-анаммен
Dialogue: 0,0:02:53.54,0:02:57.21,Default,,0000,0000,0000,,Олар үстелдің айналасында отырды.
Dialogue: 0,0:02:57.21,0:03:00.15,Default,,0000,0000,0000,,Ошаған әрқашан атамның қасында...
Dialogue: 0,0:03:00.15,0:03:03.82,Default,,0000,0000,0000,,Ашуланған сиқыршының бейнесі болды.
Dialogue: 0,0:03:03.82,0:03:08.15,Default,,0000,0000,0000,,Бастапқыда сайқымазақ ретінде
Dialogue: 0,0:03:03.82,0:03:08.15,Default,,0000,0000,0000,,Арғы атам мені қамалға қарсы алды.
Dialogue: 0,0:03:08.15,0:03:11.32,Default,,0000,0000,0000,,Атасымен ағалы-інілі болып өсті.
Dialogue: 0,0:03:11.32,0:03:14.99,Default,,0000,0000,0000,,Ақыры таққа отырды.
Dialogue: 0,0:03:11.32,0:03:14.99,Default,,0000,0000,0000,,Сиқырды атамның ұсынысымен үйрендім➡
Dialogue: 0,0:03:14.99,0:03:17.83,Default,,0000,0000,0000,,Ол өз белгісін қойды.
Dialogue: 0,0:03:17.83,0:03:22.00,Default,,0000,0000,0000,,Бастапқыда бұл жер болды
Dialogue: 0,0:03:17.83,0:03:22.00,Default,,0000,0000,0000,,Гном мен пері реликтеріне толы➡
Dialogue: 0,0:03:22.00,0:03:25.34,Default,,0000,0000,0000,,Онда
Dialogue: 0,0:03:22.00,0:03:25.34,Default,,0000,0000,0000,,Қара магия да болған шығар...
Dialogue: 0,0:03:25.34,0:03:29.84,Default,,0000,0000,0000,,Билікке құмар болып, жынды бола бастады.
Dialogue: 0,0:03:25.34,0:03:29.84,Default,,0000,0000,0000,,Ақырында елге➡
Dialogue: 0,0:03:29.84,0:03:32.85,Default,,0000,0000,0000,,Мен өлмейтін қарғысқа ұшырадым.
Dialogue: 0,0:03:32.85,0:03:35.68,Default,,0000,0000,0000,,Негізі мен онымен сөйлескім келеді.
Dialogue: 0,0:03:35.68,0:03:39.02,Default,,0000,0000,0000,,Қай жерде кездесуге болады?
Dialogue: 0,0:03:35.68,0:03:39.02,Default,,0000,0000,0000,,Әңгімелеу! ?
Dialogue: 0,0:03:39.02,0:03:41.35,Default,,0000,0000,0000,,Бұл мүлдем мүмкін емес.
Dialogue: 0,0:03:41.35,0:03:43.86,Default,,0000,0000,0000,,Қалыпты әңгіме құра алады
Dialogue: 0,0:03:41.35,0:03:43.86,Default,,0000,0000,0000,,Бұл сіздің қарсыласыңыз емес.
Dialogue: 0,0:03:43.86,0:03:47.36,Default,,0000,0000,0000,,Атамды жасырып, кетсін
Dialogue: 0,0:03:43.86,0:03:47.36,Default,,0000,0000,0000,,Маған қиын болды.
Dialogue: 0,0:03:47.36,0:03:50.53,Default,,0000,0000,0000,,Бұған қатысы бар деген күдіктілер де өлім жазасына кесілді...
Dialogue: 0,0:03:50.53,0:03:53.53,Default,,0000,0000,0000,,Кездесу оңай.
Dialogue: 0,0:03:53.53,0:03:57.70,Default,,0000,0000,0000,,Ауылдағы біртүрлі нәрсені иіскеу
Dialogue: 0,0:03:53.53,0:03:57.70,Default,,0000,0000,0000,,Сиқыршының көзі жиналып қалды.
Dialogue: 0,0:03:57.70,0:04:01.81,Default,,0000,0000,0000,,Сиқыршының өзі
Dialogue: 0,0:03:57.70,0:04:01.81,Default,,0000,0000,0000,,Ол ақырында осында келеді.
Dialogue: 0,0:04:01.81,0:04:05.48,Default,,0000,0000,0000,,Бұл лабиринт оның мүшелері сияқты.
Dialogue: 0,0:04:05.48,0:04:08.98,Default,,0000,0000,0000,,Бұл күш қаншалықты қорқынышты?
Dialogue: 0,0:04:05.48,0:04:08.98,Default,,0000,0000,0000,,Сіз мұны білесіз.
Dialogue: 0,0:04:08.98,0:04:12.15,Default,,0000,0000,0000,,Бірақ бұл өте қажет.
Dialogue: 0,0:04:12.15,0:04:15.15,Default,,0000,0000,0000,,Сіз сөйлесе аласыз ба?
Dialogue: 0,0:04:12.15,0:04:15.15,Default,,0000,0000,0000,,Мен білмеймін➡
Dialogue: 0,0:04:15.15,0:04:19.83,Default,,0000,0000,0000,,Ең терең тереңдікте қамалған
Dialogue: 0,0:04:15.15,0:04:19.83,Default,,0000,0000,0000,,Қанатты арыстанның күшін алыңыз.
Dialogue: 0,0:04:19.83,0:04:23.33,Default,,0000,0000,0000,,Сиқыршының күші
Dialogue: 0,0:04:19.83,0:04:23.33,Default,,0000,0000,0000,,Оны басу мүмкін болады.
Dialogue: 0,0:04:27.83,0:04:30.67,Default,,0000,0000,0000,,Осы жерден жүрсеңіз, қамал қабырғасының ішінде боласыз➡
Dialogue: 0,0:04:30.67,0:04:33.67,Default,,0000,0000,0000,,Бұл лабиринтке оралуға болатынын білдіреді.
Dialogue: 0,0:04:33.67,0:04:37.51,Default,,0000,0000,0000,,Мынаны өзіңізбен бірге алыңыз.
Dialogue: 0,0:04:33.67,0:04:37.51,Default,,0000,0000,0000,,О, рахмет.
Dialogue: 0,0:04:37.51,0:04:39.85,Default,,0000,0000,0000,,Егер сіз тым көп жүк алып жүрсеңіз➡
Dialogue: 0,0:04:39.85,0:04:43.68,Default,,0000,0000,0000,,Өйткені оны көтеріп жүргендер қиналады.
Dialogue: 0,0:04:39.85,0:04:43.68,Default,,0000,0000,0000,,Тасымалдаушы?
Dialogue: 0,0:04:43.68,0:04:45.85,Default,,0000,0000,0000,,Сіз де дәл осылай келдіңіз➡
Dialogue: 0,0:04:45.85,0:04:49.36,Default,,0000,0000,0000,,Мен де оны үйге қарай апарамын.
Dialogue: 0,0:04:45.85,0:04:49.36,Default,,0000,0000,0000,,Гей….
Dialogue: 0,0:04:49.36,0:04:53.66,Default,,0000,0000,0000,,Көмегің үшін рахмет.
Dialogue: 0,0:04:49.36,0:04:53.66,Default,,0000,0000,0000,,Сәттілік.
Dialogue: 0,0:04:55.86,0:04:58.20,Default,,0000,0000,0000,,(Лайостың айқайы)
Dialogue: 0,0:04:58.20,0:05:00.47,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:05:00.47,0:05:02.64,Default,,0000,0000,0000,,Мұндай сөздерді айтпа
Dialogue: 0,0:05:00.47,0:05:02.64,Default,,0000,0000,0000,,Бірақ ➡
Dialogue: 0,0:05:02.64,0:05:07.14,Default,,0000,0000,0000,,Олар шынымен де олар ма?
Dialogue: 0,0:05:02.64,0:05:07.14,Default,,0000,0000,0000,,Мен солай ойлағым келеді, бірақ...
Dialogue: 0,0:05:09.31,0:05:11.98,Default,,0000,0000,0000,,Маған жауап бер.
Dialogue: 0,0:05:09.31,0:05:11.98,Default,,0000,0000,0000,,Яад.
Dialogue: 0,0:05:11.98,0:05:14.31,Default,,0000,0000,0000,,Ши... Тисл! ?
Dialogue: 0,0:05:14.31,0:05:18.15,Default,,0000,0000,0000,,Сіз дәл қазір кіммен сөйлестіңіз?
Dialogue: 0,0:05:18.15,0:05:21.05,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:05:23.49,0:05:26.99,Default,,0000,0000,0000,,Қанша рет!
Dialogue: 0,0:05:23.49,0:05:26.99,Default,,0000,0000,0000,,Мұнда...
Dialogue: 0,0:05:26.99,0:05:31.33,Default,,0000,0000,0000,,Ататата….
Dialogue: 0,0:05:26.99,0:05:31.33,Default,,0000,0000,0000,,Ежелгі ергежейлі су қоймасы.
Dialogue: 0,0:05:31.33,0:05:34.83,Default,,0000,0000,0000,,Бұл үлкен жер ме?
Dialogue: 0,0:05:31.33,0:05:34.83,Default,,0000,0000,0000,,Қай жағы?
Dialogue: 0,0:05:34.83,0:05:37.50,Default,,0000,0000,0000,,Магнит жұмыс істемейді.
Dialogue: 0,0:05:37.50,0:05:41.34,Default,,0000,0000,0000,,Мұндай тентек нәрселер
Dialogue: 0,0:05:37.50,0:05:41.34,Default,,0000,0000,0000,,Гномдар осылай істейді.
Dialogue: 0,0:05:41.34,0:05:44.51,Default,,0000,0000,0000,,Қорғаныс нүктелері
Dialogue: 0,0:05:41.34,0:05:44.51,Default,,0000,0000,0000,,Шамасы, бұл да қалды...
Dialogue: 0,0:05:44.51,0:05:47.51,Default,,0000,0000,0000,,Гном….
Dialogue: 0,0:05:44.51,0:05:47.51,Default,,0000,0000,0000,,Оге.
Dialogue: 0,0:05:47.51,0:05:49.52,Default,,0000,0000,0000,,Сенши: Ауысу ауруы?
Dialogue: 0,0:05:49.52,0:05:53.35,Default,,0000,0000,0000,,Өйткені ергежейлілерде үшкір жартылай шеңберлі арналар болады.
Dialogue: 0,0:05:49.52,0:05:53.35,Default,,0000,0000,0000,,Қалай болғанда да.
Dialogue: 0,0:05:53.35,0:05:58.19,Default,,0000,0000,0000,,Бұған гномдар да бейім бе деп ойлаймын.
Dialogue: 0,0:05:53.35,0:05:58.19,Default,,0000,0000,0000,,Менің ойымша, сиқырлы ауру да бар.
Dialogue: 0,0:05:58.19,0:06:00.79,Default,,0000,0000,0000,,Хмм... бұл қайда?
Dialogue: 0,0:06:00.79,0:06:04.30,Default,,0000,0000,0000,,А, қайтып келдің бе?
Dialogue: 0,0:06:00.79,0:06:04.30,Default,,0000,0000,0000,,Не? Не?
Dialogue: 0,0:06:04.30,0:06:07.30,Default,,0000,0000,0000,,Конверт пе?
Dialogue: 0,0:06:07.30,0:06:10.30,Default,,0000,0000,0000,,Жақсысың ба?
Dialogue: 0,0:06:07.30,0:06:10.30,Default,,0000,0000,0000,,Сол жерде біраз демалыңыз.
Dialogue: 0,0:06:10.30,0:06:12.31,Default,,0000,0000,0000,,Мен айналама қараймын.
Dialogue: 0,0:06:15.31,0:06:17.31,Default,,0000,0000,0000,,Салқындату.
Dialogue: 0,0:06:15.31,0:06:17.31,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:06:17.31,0:06:21.15,Default,,0000,0000,0000,,Мұндағы белгіні көріп тұрсың ба?
Dialogue: 0,0:06:21.15,0:06:23.82,Default,,0000,0000,0000,,А, бірдеңе болып жатқаны сөзсіз.
Dialogue: 0,0:06:23.82,0:06:27.15,Default,,0000,0000,0000,,Айналадағы тіректерді белгілеңіз
Dialogue: 0,0:06:23.82,0:06:27.15,Default,,0000,0000,0000,,Жазуларыңызды қалаймын.
Dialogue: 0,0:06:27.15,0:06:29.49,Default,,0000,0000,0000,,Шамамен
Dialogue: 0,0:06:27.15,0:06:29.49,Default,,0000,0000,0000,,Ағымдағы орналасқан жеріңізді біліңіз.
Dialogue: 0,0:06:29.49,0:06:33.66,Default,,0000,0000,0000,,Сіз мұны қайдан білесіз?
Dialogue: 0,0:06:29.49,0:06:33.66,Default,,0000,0000,0000,,Ол әрқашан осындай жерлерде болады.
Dialogue: 0,0:06:33.66,0:06:35.66,Default,,0000,0000,0000,,Бұл код сияқты.
Dialogue: 0,0:06:35.66,0:06:38.83,Default,,0000,0000,0000,,Жақсы... Бағыттың керемет сезімі➡
Dialogue: 0,0:06:38.83,0:06:41.83,Default,,0000,0000,0000,,Тек ергежейлілер емес
Dialogue: 0,0:06:38.83,0:06:41.83,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:06:45.51,0:06:47.51,Default,,0000,0000,0000,,Түсіндім.
Dialogue: 0,0:06:47.51,0:06:52.18,Default,,0000,0000,0000,,Бұл жер бүкіл жердің оңтүстік-шығысында...
Dialogue: 0,0:06:47.51,0:06:52.18,Default,,0000,0000,0000,,Қатты! Өте қиын!
Dialogue: 0,0:06:52.18,0:06:54.18,Default,,0000,0000,0000,,Хмм, мен қайтып келдім.
Dialogue: 0,0:06:54.18,0:06:56.68,Default,,0000,0000,0000,,Сіз Фаринді тапқан боларсыз!
Dialogue: 0,0:06:56.68,0:06:59.35,Default,,0000,0000,0000,,Бұл Фариннің ізі ме?
Dialogue: 0,0:06:59.35,0:07:02.29,Default,,0000,0000,0000,,Бізге назар аударыңыз
Dialogue: 0,0:06:59.35,0:07:02.29,Default,,0000,0000,0000,,Мен қашып кеттім.
Dialogue: 0,0:07:02.29,0:07:05.63,Default,,0000,0000,0000,,Неге? Хм?
Dialogue: 0,0:07:02.29,0:07:05.63,Default,,0000,0000,0000,,Силуэт осылай көрінеді!
Dialogue: 0,0:07:05.63,0:07:07.79,Default,,0000,0000,0000,,Эй!
Dialogue: 0,0:07:05.63,0:07:07.79,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:07:07.79,0:07:10.30,Default,,0000,0000,0000,,Менің ойымша, бұл грифон немесе басқа нәрсе...
Dialogue: 0,0:07:10.30,0:07:13.97,Default,,0000,0000,0000,,Эй...! Гриффин бұл...
Dialogue: 0,0:07:13.97,0:07:17.64,Default,,0000,0000,0000,,Денесінің үстіңгі бөлігі құс тәрізді
Dialogue: 0,0:07:13.97,0:07:17.64,Default,,0000,0000,0000,,Бұл арыстанның төменгі денесі бар құбыжық.
Dialogue: 0,0:07:17.64,0:07:21.47,Default,,0000,0000,0000,,Бұл лабиринтте грифон бар ма?
Dialogue: 0,0:07:17.64,0:07:21.47,Default,,0000,0000,0000,,Мен бұл туралы ешқашан естіген емеспін.
Dialogue: 0,0:07:21.47,0:07:23.64,Default,,0000,0000,0000,,Иісті танымайсың ба?
Dialogue: 0,0:07:23.64,0:07:27.98,Default,,0000,0000,0000,,Бұл ит емес... Хм.
Dialogue: 0,0:07:27.98,0:07:30.48,Default,,0000,0000,0000,,Жануарлардың иісі.
Dialogue: 0,0:07:30.48,0:07:32.65,Default,,0000,0000,0000,,Қалай болғанда да, мен оны тез табуым керек.
Dialogue: 0,0:07:32.65,0:07:35.66,Default,,0000,0000,0000,,Маған ұнамайды.
Dialogue: 0,0:07:32.65,0:07:35.66,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:35.66,0:07:39.16,Default,,0000,0000,0000,,Ұнамайсың ба? неге?
Dialogue: 0,0:07:35.66,0:07:39.16,Default,,0000,0000,0000,,Хмм... жоқ, бұл...
Dialogue: 0,0:07:39.16,0:07:42.16,Default,,0000,0000,0000,,Бұл Фарин болуы мүмкін.
Dialogue: 0,0:07:39.16,0:07:42.16,Default,,0000,0000,0000,,Жоқ... а...
Dialogue: 0,0:07:42.16,0:07:45.33,Default,,0000,0000,0000,,О, мінекей! Бұл мен көрген бірінші саңырауқұлақ.
Dialogue: 0,0:07:45.33,0:07:48.00,Default,,0000,0000,0000,,Мен тамақ жасап көргім келеді.
Dialogue: 0,0:07:45.33,0:07:48.00,Default,,0000,0000,0000,,Саңырауқұлақ?
Dialogue: 0,0:07:48.00,0:07:53.67,Default,,0000,0000,0000,,Мен мұны бір жерден танимын.
Dialogue: 0,0:07:48.00,0:07:53.67,Default,,0000,0000,0000,,Бұл улы немесе басқа, сондықтан оны жеуге болмайды.
Dialogue: 0,0:07:53.67,0:07:55.68,Default,,0000,0000,0000,,Мен грифондарды жек көремін.
Dialogue: 0,0:07:55.68,0:07:58.68,Default,,0000,0000,0000,,Неліктен мен бұрын ешқашан көрмеген құбыжық?
Dialogue: 0,0:07:55.68,0:07:58.68,Default,,0000,0000,0000,,Оларға бұл ұнамайды.
Dialogue: 0,0:07:58.68,0:08:01.78,Default,,0000,0000,0000,,Жетеді! Барайық!
Dialogue: 0,0:07:58.68,0:08:01.78,Default,,0000,0000,0000,,Күте тұрыңыз! Тоқта!
Dialogue: 0,0:08:01.78,0:08:03.95,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:01.78,0:08:03.95,Default,,0000,0000,0000,,Нашар қозғалсаңыз, қауіпті болуы мүмкін!
Dialogue: 0,0:08:03.95,0:08:06.55,Default,,0000,0000,0000,,Нағыз шайқас көрмегелі жылдар болды
Dialogue: 0,0:08:03.95,0:08:06.55,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:08:08.79,0:08:11.29,Default,,0000,0000,0000,,Ал... Мен мұны білдім...
Dialogue: 0,0:08:11.29,0:08:13.29,Default,,0000,0000,0000,,Гриффин!
Dialogue: 0,0:08:15.29,0:08:17.30,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:08:17.30,0:08:22.30,Default,,0000,0000,0000,,Керемет~ Бірінші рет көруім!
Dialogue: 0,0:08:17.30,0:08:22.30,Default,,0000,0000,0000,,Гриффин….
Dialogue: 0,0:08:22.30,0:08:26.14,Default,,0000,0000,0000,,Эй... Дабыл берме...!
Dialogue: 0,0:08:26.14,0:08:28.14,Default,,0000,0000,0000,,Тағы да келеді!
Dialogue: 0,0:08:26.14,0:08:28.14,Default,,0000,0000,0000,,Артқа тұрыңыз!
Dialogue: 0,0:08:28.14,0:08:30.98,Default,,0000,0000,0000,,Spelae Yeptum Rufermus.
Dialogue: 0,0:08:30.98,0:08:33.65,Default,,0000,0000,0000,,Руфермус Спелае Аламандрас.
Dialogue: 0,0:08:33.65,0:08:35.65,Default,,0000,0000,0000,,Тронсома Джовис….
Dialogue: 0,0:08:33.65,0:08:35.65,Default,,0000,0000,0000,,Хи хи...
Dialogue: 0,0:08:35.65,0:08:37.65,Default,,0000,0000,0000,,Ой~!
Dialogue: 0,0:08:35.65,0:08:37.65,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:08:39.65,0:08:43.82,Default,,0000,0000,0000,,Хмм, мақсат!
Dialogue: 0,0:08:39.65,0:08:43.82,Default,,0000,0000,0000,,Сенші!
Dialogue: 0,0:08:39.65,0:08:43.82,Default,,0000,0000,0000,,Арқаңды көрсетіп, қашпа!
Dialogue: 0,0:08:43.82,0:08:46.16,Default,,0000,0000,0000,,Хахаха...
Dialogue: 0,0:08:46.16,0:08:49.33,Default,,0000,0000,0000,,Ха ха ха... Уау.
Dialogue: 0,0:08:49.33,0:08:51.83,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:08:51.83,0:08:53.83,Default,,0000,0000,0000,,Сенші!
Dialogue: 0,0:08:53.83,0:08:59.04,Default,,0000,0000,0000,,Ха ха ха ха….
Dialogue: 0,0:09:01.61,0:09:03.78,Default,,0000,0000,0000,,Бұл жаман...
Dialogue: 0,0:09:03.78,0:09:09.12,Default,,0000,0000,0000,,Мен бір сәт ештеңе істей алмадым.
Dialogue: 0,0:09:03.78,0:09:09.12,Default,,0000,0000,0000,,Сеншіде қару болды ма?
Dialogue: 0,0:09:09.12,0:09:12.12,Default,,0000,0000,0000,,Жоқ, ол қарусыз.
Dialogue: 0,0:09:09.12,0:09:12.12,Default,,0000,0000,0000,,Бізге тезірек жету керек!
Dialogue: 0,0:09:12.12,0:09:16.96,Default,,0000,0000,0000,,Әр бағанаға шығып, іздеу керек пе?
Dialogue: 0,0:09:12.12,0:09:16.96,Default,,0000,0000,0000,,Мен мұны істемеймін.
Dialogue: 0,0:09:16.96,0:09:18.96,Default,,0000,0000,0000,,《Қайда бардың?
Dialogue: 0,0:09:18.96,0:09:21.13,Default,,0000,0000,0000,,Биік жерге апару
Dialogue: 0,0:09:18.96,0:09:21.13,Default,,0000,0000,0000,,Мен аяқ-қолымды пайдалана алмаймын.
Dialogue: 0,0:09:21.13,0:09:23.13,Default,,0000,0000,0000,,Тіпті өлі де табылмады.
Dialogue: 0,0:09:23.13,0:09:27.97,Default,,0000,0000,0000,,Осындай сәтте?
Dialogue: 0,0:09:23.13,0:09:27.97,Default,,0000,0000,0000,,Қарусыз... Мен сені енді көре алмаймын》
Dialogue: 0,0:09:27.97,0:09:30.64,Default,,0000,0000,0000,,Марсиль! Бір амал бар ма?
Dialogue: 0,0:09:30.64,0:09:34.31,Default,,0000,0000,0000,,Ах! Хмм...
Dialogue: 0,0:09:34.31,0:09:36.98,Default,,0000,0000,0000,,Таныс адамды шақыру және іздеу.
Dialogue: 0,0:09:36.98,0:09:39.98,Default,,0000,0000,0000,,Таныссыз ба? Ол жын шақырады ма?
Dialogue: 0,0:09:39.98,0:09:43.48,Default,,0000,0000,0000,,Қоңырау шалудың орнына
Dialogue: 0,0:09:39.98,0:09:43.48,Default,,0000,0000,0000,,Менің ойымша, «жаса» деген дұрысырақ.
Dialogue: 0,0:09:43.48,0:09:45.48,Default,,0000,0000,0000,,Шақыру әдістерінің үш түрі бар.
Dialogue: 0,0:09:45.48,0:09:49.49,Default,,0000,0000,0000,,1. бар рухтар мен құбыжықтар
Dialogue: 0,0:09:45.48,0:09:49.49,Default,,0000,0000,0000,,Басқару және манипуляциялау.
Dialogue: 0,0:09:49.49,0:09:51.66,Default,,0000,0000,0000,,Бұл шарт күрделі➡
Dialogue: 0,0:09:51.66,0:09:54.83,Default,,0000,0000,0000,,Лабиринт шебері
Dialogue: 0,0:09:51.66,0:09:54.83,Default,,0000,0000,0000,,Байқау мүмкіндігі жоғары.
Dialogue: 0,0:09:54.83,0:09:58.33,Default,,0000,0000,0000,,2. Өсімдіктер мен жануарларды құбыжыққа айналдыру.
Dialogue: 0,0:09:58.33,0:10:02.34,Default,,0000,0000,0000,,Бұл да мүмкін емес.
Dialogue: 0,0:09:58.33,0:10:02.34,Default,,0000,0000,0000,,Өйткені ол үлкен уақыт пен дайындықты қажет етеді.
Dialogue: 0,0:10:02.34,0:10:04.50,Default,,0000,0000,0000,,3. Оны нөлден бастап жасаңыз.
Dialogue: 0,0:10:04.50,0:10:08.51,Default,,0000,0000,0000,,Бұл жолы мен мұны істеймін.
Dialogue: 0,0:10:04.50,0:10:08.51,Default,,0000,0000,0000,,Бұл ең қиын сияқты...
Dialogue: 0,0:10:08.51,0:10:11.34,Default,,0000,0000,0000,,Тәуелсіз жаратылыс жасағыңыз келсе
Dialogue: 0,0:10:08.51,0:10:11.34,Default,,0000,0000,0000,,Әрине➡
Dialogue: 0,0:10:11.34,0:10:14.55,Default,,0000,0000,0000,,Әзірге қозғалыстың минимумы жеткілікті.
Dialogue: 0,0:10:16.52,0:10:18.52,Default,,0000,0000,0000,,Мен сиқырлы шеңберді дайындап жатырмын➡
Dialogue: 0,0:10:18.52,0:10:21.62,Default,,0000,0000,0000,,Бар етіңізді қазанға салыңыз.
Dialogue: 0,0:10:18.52,0:10:21.62,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:10:25.86,0:10:29.36,Default,,0000,0000,0000,,Мұның бәрі ме? Аздап көп болса
Dialogue: 0,0:10:25.86,0:10:29.36,Default,,0000,0000,0000,,Мен қуаныштымын.
Dialogue: 0,0:10:31.36,0:10:33.37,Default,,0000,0000,0000,,Жоқ….
Dialogue: 0,0:10:33.37,0:10:36.54,Default,,0000,0000,0000,,Менде ірімшік пен жұмыртқа бар.
Dialogue: 0,0:10:33.37,0:10:36.54,Default,,0000,0000,0000,,Көкөністер де!
Dialogue: 0,0:10:36.54,0:10:40.04,Default,,0000,0000,0000,,Хм... Калория қосады ма деп ойлаймын...
Dialogue: 0,0:10:40.04,0:10:42.34,Default,,0000,0000,0000,,Оны әкеліңіз.
Dialogue: 0,0:10:40.04,0:10:42.34,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:10:46.55,0:10:51.55,Default,,0000,0000,0000,,Сіз қандай құбыжық жасайсыз?
Dialogue: 0,0:10:46.55,0:10:51.55,Default,,0000,0000,0000,,Сіз оны еркін басқара аласыз ба? Маған да айтыңызшы...
Dialogue: 0,0:10:51.55,0:10:53.55,Default,,0000,0000,0000,,Жоқ! Қалыпты процедураны орындаңыз➡
Dialogue: 0,0:10:53.55,0:10:56.06,Default,,0000,0000,0000,,Қауіпті техникамен жұмыс істеу біліктілігі
Dialogue: 0,0:10:53.55,0:10:56.06,Default,,0000,0000,0000,,Алдымен қабылдаңыз!
Dialogue: 0,0:10:56.06,0:10:59.39,Default,,0000,0000,0000,,Уау….
Dialogue: 0,0:10:56.06,0:10:59.39,Default,,0000,0000,0000,,Ондай нәрсе бар ма?
Dialogue: 0,0:10:59.39,0:11:03.16,Default,,0000,0000,0000,,Әй, айтпақшы.
Dialogue: 0,0:10:59.39,0:11:03.16,Default,,0000,0000,0000,,Бұл қария кім?
Dialogue: 0,0:11:03.16,0:11:05.16,Default,,0000,0000,0000,,Сіз қалай келдіңіз?
Dialogue: 0,0:11:05.16,0:11:08.17,Default,,0000,0000,0000,,Сол асқа
Dialogue: 0,0:11:05.16,0:11:08.17,Default,,0000,0000,0000,,Тіркеме дегеніміз не?
Dialogue: 0,0:11:08.17,0:11:10.17,Default,,0000,0000,0000,,А...?
Dialogue: 0,0:11:10.17,0:11:12.67,Default,,0000,0000,0000,,Ха! ?
Dialogue: 0,0:11:10.17,0:11:12.67,Default,,0000,0000,0000,,Эй, сен білмейсің! ?
Dialogue: 0,0:11:12.67,0:11:14.67,Default,,0000,0000,0000,,Дос сияқты көрін! ?
Dialogue: 0,0:11:14.67,0:11:17.51,Default,,0000,0000,0000,,Жоқ, жақсы.
Dialogue: 0,0:11:14.67,0:11:17.51,Default,,0000,0000,0000,,Менің мүмкіндігім болмады...
Dialogue: 0,0:11:17.51,0:11:21.68,Default,,0000,0000,0000,,Жеке өмірім туралы айтқым келмейді
Dialogue: 0,0:11:17.51,0:11:21.68,Default,,0000,0000,0000,,Біз өзара.
Dialogue: 0,0:11:21.68,0:11:25.18,Default,,0000,0000,0000,,Тек...
Dialogue: 0,0:11:21.68,0:11:25.18,Default,,0000,0000,0000,,Мазаламады десем, өтірік айтқан болар едім.
Dialogue: 0,0:11:25.18,0:11:28.35,Default,,0000,0000,0000,,Сеншінің сөзі мен іс-әрекеті
Dialogue: 0,0:11:25.18,0:11:28.35,Default,,0000,0000,0000,,Кептелетін тұстар көп.
Dialogue: 0,0:11:28.35,0:11:31.86,Default,,0000,0000,0000,,Біз алғаш кездескен кезде
Dialogue: 0,0:11:28.35,0:11:31.86,Default,,0000,0000,0000,,Сеншінің не айтқаны есіңізде ме?
Dialogue: 0,0:11:31.86,0:11:36.36,Default,,0000,0000,0000,,Осы лабиринтте 10 жылдан астам
Dialogue: 0,0:11:31.86,0:11:36.36,Default,,0000,0000,0000,,Ол құбыжық тағамын зерттеп жатыр.
Dialogue: 0,0:11:36.36,0:11:38.70,Default,,0000,0000,0000,,Бірақ бұл лабиринт ➡ ашылды
Dialogue: 0,0:11:38.70,0:11:41.20,Default,,0000,0000,0000,,Алты жыл бұрын.
Dialogue: 0,0:11:38.70,0:11:41.20,Default,,0000,0000,0000,,(Самурай) Батырлар мықты. Батырлар жалғыз…
Dialogue: 0,0:11:41.20,0:11:45.87,Default,,0000,0000,0000,,Басқа қымбат металдан жасалған кәстрөлдер мен пышақтар
Dialogue: 0,0:11:41.20,0:11:45.87,Default,,0000,0000,0000,,Көп нәрсеге ие болу.
Dialogue: 0,0:11:45.87,0:11:48.54,Default,,0000,0000,0000,,Ежелгі ергежейлі кодтардың шифрын ашу.
Dialogue: 0,0:11:48.54,0:11:51.54,Default,,0000,0000,0000,,Ешқашан келмеу керек еді
Dialogue: 0,0:11:48.54,0:11:51.54,Default,,0000,0000,0000,,Едендегі құбыжықтардан қорқу➡
Dialogue: 0,0:11:51.54,0:11:53.88,Default,,0000,0000,0000,,Сен маған баладай қарайсың.
Dialogue: 0,0:11:53.88,0:11:56.38,Default,,0000,0000,0000,,Соңғысы
Dialogue: 0,0:11:53.88,0:11:56.38,Default,,0000,0000,0000,,Бұл жай ғана сылтау емес пе?
Dialogue: 0,0:11:56.38,0:12:00.49,Default,,0000,0000,0000,,Жоқ, бізді танымайтын адамдар
Dialogue: 0,0:11:56.38,0:12:00.49,Default,,0000,0000,0000,,Бұл жалпы түсінбеушілік.
Dialogue: 0,0:12:00.49,0:12:03.32,Default,,0000,0000,0000,,Жарты аяқтың жарыс екенін түсінбеймін.
Dialogue: 0,0:12:03.32,0:12:07.33,Default,,0000,0000,0000,,Өскенде
Dialogue: 0,0:12:03.32,0:12:07.33,Default,,0000,0000,0000,,Өзіңізді ұзын адам немесе гном боламын деп ойлаңыз.
Dialogue: 0,0:12:07.33,0:12:11.50,Default,,0000,0000,0000,,Дегенмен, бұл Тухоу сияқты.
Dialogue: 0,0:12:07.33,0:12:11.50,Default,,0000,0000,0000,,Тек кейбір аймақтарда.
Dialogue: 0,0:12:11.50,0:12:16.17,Default,,0000,0000,0000,,Мен бұл аралда 10 жыл тұрдым.
Dialogue: 0,0:12:11.50,0:12:16.17,Default,,0000,0000,0000,,Білмейтінің қызық... Ха.
Dialogue: 0,0:12:16.17,0:12:20.34,Default,,0000,0000,0000,,Мүмкін Сенши
Dialogue: 0,0:12:16.17,0:12:20.34,Default,,0000,0000,0000,,Жердегі адамдарға келсек...
Dialogue: 0,0:12:20.34,0:12:22.68,Default,,0000,0000,0000,,Сеншіні➡ аман-есен құтқара алсаң
Dialogue: 0,0:12:22.68,0:12:26.85,Default,,0000,0000,0000,,тағы да
Dialogue: 0,0:12:22.68,0:12:26.85,Default,,0000,0000,0000,,Өзімізді таныстыруға мүмкіндік жасайық.
Dialogue: 0,0:12:26.85,0:12:29.01,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:12:26.85,0:12:29.01,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:29.01,0:12:32.02,Default,,0000,0000,0000,,Spelae Yeptum Rufermus.
Dialogue: 0,0:12:32.02,0:12:35.52,Default,,0000,0000,0000,,Rufermus spelae virar indumurizbam.
Dialogue: 0,0:12:35.52,0:12:38.19,Default,,0000,0000,0000,,Мартис Тирнунт Иасдам.
Dialogue: 0,0:12:38.19,0:12:40.86,Default,,0000,0000,0000,,Хистум Эрес Ангеркант.
Dialogue: 0,0:12:40.86,0:12:42.86,Default,,0000,0000,0000,,Rementalent.
Dialogue: 0,0:12:42.86,0:12:44.86,Default,,0000,0000,0000,,Кейін қалсаң, капитан мені сөгіп тастайды.
Dialogue: 0,0:12:49.87,0:12:53.04,Default,,0000,0000,0000,,Ол аяқталды ма?
Dialogue: 0,0:12:49.87,0:12:53.04,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:12:53.04,0:12:55.71,Default,,0000,0000,0000,,Қақпақты ашайық.
Dialogue: 0,0:12:55.71,0:13:06.72,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:13:13.16,0:13:17.83,Default,,0000,0000,0000,,А, жақсы.
Dialogue: 0,0:13:13.16,0:13:17.83,Default,,0000,0000,0000,,Мен қобалжыдым, бірақ бұл сәтті болған сияқты.
Dialogue: 0,0:13:17.83,0:13:20.50,Default,,0000,0000,0000,,Бұл қандай бет?
Dialogue: 0,0:13:17.83,0:13:20.50,Default,,0000,0000,0000,,Тек қозғал, жай ғана қозғал!
Dialogue: 0,0:13:20.50,0:13:24.00,Default,,0000,0000,0000,,Қажетсіз әшекейлермен шектелген
Dialogue: 0,0:13:20.50,0:13:24.00,Default,,0000,0000,0000,,Себебі сіз ресурстарды бөле алмайсыз!
Dialogue: 0,0:13:24.00,0:13:26.34,Default,,0000,0000,0000,,Кеттік!
Dialogue: 0,0:13:26.34,0:13:29.51,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:13:26.34,0:13:29.51,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:13:29.51,0:13:32.68,Default,,0000,0000,0000,,Уау, бұл менің көзқарасыма сәйкес келеді
Dialogue: 0,0:13:29.51,0:13:32.68,Default,,0000,0000,0000,,Бұл жиіркенішті.
Dialogue: 0,0:13:32.68,0:13:35.18,Default,,0000,0000,0000,,Менің көзімді біреу жауып тұр.
Dialogue: 0,0:13:37.18,0:13:40.35,Default,,0000,0000,0000,,Ашуланған сиқыршы
Dialogue: 0,0:13:37.18,0:13:40.35,Default,,0000,0000,0000,,Бұлардың көбін ұшып кетіңіз➡
Dialogue: 0,0:13:40.35,0:13:43.86,Default,,0000,0000,0000,,Ақпараттың қандай түрі өңделеді?
Dialogue: 0,0:13:40.35,0:13:43.86,Default,,0000,0000,0000,,Маған қызық.
Dialogue: 0,0:13:43.86,0:13:47.03,Default,,0000,0000,0000,,Мұны кейінге қалдыра аламыз.
Dialogue: 0,0:13:43.86,0:13:47.03,Default,,0000,0000,0000,,Сенши қазір.
Dialogue: 0,0:13:47.03,0:13:51.20,Default,,0000,0000,0000,,Зынданда тазалаушылар мен рухтардың қозғалысына байланысты.
Dialogue: 0,0:13:47.03,0:13:51.20,Default,,0000,0000,0000,,Лабиринттен бөгде заттарды іздеу.
Dialogue: 0,0:13:51.20,0:13:53.20,Default,,0000,0000,0000,,Менің артымнан жүр!
Dialogue: 0,0:13:53.20,0:13:56.20,Default,,0000,0000,0000,,А... аа....
Dialogue: 0,0:13:53.20,0:13:56.20,Default,,0000,0000,0000,,​​О?
Dialogue: 0,0:13:56.20,0:14:01.14,Default,,0000,0000,0000,,Сіз ілесе алмайсыз ба?
Dialogue: 0,0:13:56.20,0:14:01.14,Default,,0000,0000,0000,,Мен ұшқанда жүре аламын деп ойлаймын! ?
Dialogue: 0,0:14:01.14,0:14:05.48,Default,,0000,0000,0000,,Мен оны арқама көтеріп алайын.
Dialogue: 0,0:14:01.14,0:14:05.48,Default,,0000,0000,0000,,Изуцуми мен Чиру жүктерін сұрайды.
Dialogue: 0,0:14:05.48,0:14:07.81,Default,,0000,0000,0000,,Кеттік, Марсиль.
Dialogue: 0,0:14:05.48,0:14:07.81,Default,,0000,0000,0000,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,0:14:07.81,0:14:09.98,Default,,0000,0000,0000,,Не? Қорқынышты, қорқынышты, а...
Dialogue: 0,0:14:09.98,0:14:11.98,Default,,0000,0000,0000,,Қолыңызды бұрыңыз.
Dialogue: 0,0:14:09.98,0:14:11.98,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:14:11.98,0:14:14.09,Default,,0000,0000,0000,,Құла, құла!
Dialogue: 0,0:14:11.98,0:14:14.09,Default,,0000,0000,0000,,Ой, мен қозғалсам құлап қалады...
Dialogue: 0,0:14:17.16,0:14:19.33,Default,,0000,0000,0000,,Бұл қандай қалып?
Dialogue: 0,0:14:19.33,0:14:22.13,Default,,0000,0000,0000,,Ха ха ха….
Dialogue: 0,0:14:19.33,0:14:22.13,Default,,0000,0000,0000,,Бұл ең тыныштандыратын сияқты.
Dialogue: 0,0:14:25.33,0:14:27.33,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:14:29.34,0:14:31.84,Default,,0000,0000,0000,,Сол тірек!
Dialogue: 0,0:14:29.34,0:14:31.84,Default,,0000,0000,0000,,Зынданда тазалаушылар жиналып жатыр!
Dialogue: 0,0:14:31.84,0:14:33.84,Default,,0000,0000,0000,,Мен бұл жерде екеніне сенімдімін...
Dialogue: 0,0:14:35.84,0:14:38.51,Default,,0000,0000,0000,,Сенші! менде сен барсың!
Dialogue: 0,0:14:38.51,0:14:42.85,Default,,0000,0000,0000,,Бағананың басында айқышқа шегеленген!
Dialogue: 0,0:14:38.51,0:14:42.85,Default,,0000,0000,0000,,Гриффин Тездетіңіз!
Dialogue: 0,0:14:42.85,0:14:47.19,Default,,0000,0000,0000,,《Мен саған көмектесуге келдім, Сенші!
Dialogue: 0,0:14:42.85,0:14:47.19,Default,,0000,0000,0000,,Сіз мені түсінесіз бе? 》
Dialogue: 0,0:14:42.85,0:14:47.19,Default,,0000,0000,0000,,Шыбындар...?
Dialogue: 0,0:14:47.19,0:14:49.36,Default,,0000,0000,0000,,《Мм! Хмм!
Dialogue: 0,0:14:49.36,0:14:53.19,Default,,0000,0000,0000,,Ха ха ха... қозғалмайды.
Dialogue: 0,0:14:49.36,0:14:53.19,Default,,0000,0000,0000,,Оны қалай түсіремін...》
Dialogue: 0,0:14:53.19,0:14:57.20,Default,,0000,0000,0000,,Абайлаңыз, Марсиль.
Dialogue: 0,0:14:53.19,0:14:57.20,Default,,0000,0000,0000,,Гриффин – өте жақсы көретін құбыжық.
Dialogue: 0,0:14:57.20,0:14:59.70,Default,,0000,0000,0000,,Мен байқаған кезде ол әлдеқашан➡ болды
Dialogue: 0,0:14:59.70,0:15:01.80,Default,,0000,0000,0000,,Олар маған қарап тұр.
Dialogue: 0,0:14:59.70,0:15:01.80,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:15:01.80,0:15:03.80,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:15:03.80,0:15:06.81,Default,,0000,0000,0000,,Мен енді ештеңе көре алмаймын.
Dialogue: 0,0:15:06.81,0:15:09.98,Default,,0000,0000,0000,,Гриффиннің денесі өте функционалды.
Dialogue: 0,0:15:09.98,0:15:14.65,Default,,0000,0000,0000,,Қанаттары күшті, денесі серпімді.
Dialogue: 0,0:15:09.98,0:15:14.65,Default,,0000,0000,0000,,Айналуға жақсы және лездік қуатқа ие.
Dialogue: 0,0:15:14.65,0:15:18.65,Default,,0000,0000,0000,,Өткір тырнақтар мен тұмсықтар да.
Dialogue: 0,0:15:14.65,0:15:18.65,Default,,0000,0000,0000,,Оларды алдау өте қиын.
Dialogue: 0,0:15:18.65,0:15:22.32,Default,,0000,0000,0000,,Тірі заттар
Dialogue: 0,0:15:18.65,0:15:22.32,Default,,0000,0000,0000,,Қажеттілікке байланысты сол пішінді алады.
Dialogue: 0,0:15:22.32,0:15:24.32,Default,,0000,0000,0000,,Бұл қажетсіз безендіру емес.
Dialogue: 0,0:15:26.33,0:15:29.83,Default,,0000,0000,0000,,Laios Мен қандай пішінді алуым керек?
Dialogue: 0,0:15:26.33,0:15:29.83,Default,,0000,0000,0000,,Гриффинмен бәсекеге түсе аласыз ба?
Dialogue: 0,0:15:34.00,0:15:36.17,Default,,0000,0000,0000,,Бұл мүйіз шынымен бар ма?
Dialogue: 0,0:15:36.17,0:15:39.00,Default,,0000,0000,0000,,Тегістелген дененің ауа кедергісі аз болады.
Dialogue: 0,0:15:39.00,0:15:41.84,Default,,0000,0000,0000,,Шапшаңырақ болыңыз
Dialogue: 0,0:15:39.00,0:15:41.84,Default,,0000,0000,0000,,Сіз қозғала алуыңыз керек.
Dialogue: 0,0:15:41.84,0:15:45.68,Default,,0000,0000,0000,,Қатты сиқыршы жұмыс істеп тұрды
Dialogue: 0,0:15:41.84,0:15:45.68,Default,,0000,0000,0000,,Виверн есіңізде ме?
Dialogue: 0,0:15:45.68,0:15:49.58,Default,,0000,0000,0000,,Жебедей жылдам болды.
Dialogue: 0,0:15:45.68,0:15:49.58,Default,,0000,0000,0000,,Сол пішінді мақсат етіп алайық.
Dialogue: 0,0:15:52.85,0:15:55.85,Default,,0000,0000,0000,,Әзірше осы.
Dialogue: 0,0:15:52.85,0:15:55.85,Default,,0000,0000,0000,,Оны өткізіп көріңіз.
Dialogue: 0,0:15:59.86,0:16:02.96,Default,,0000,0000,0000,,Қозғалыстары мүлде басқа...
Dialogue: 0,0:15:59.86,0:16:02.96,Default,,0000,0000,0000,,Сіз мұны істей аласыз!
Dialogue: 0,0:16:02.96,0:16:07.13,Default,,0000,0000,0000,,Сенші жерге түсіп бара жатқанда
Dialogue: 0,0:16:02.96,0:16:07.13,Default,,0000,0000,0000,,Мен Гриффиннің назарын аударамын!
Dialogue: 0,0:16:07.13,0:16:09.47,Default,,0000,0000,0000,,Барлығыңыз, соңынан еріп, шайқасқа дайындалыңыз!
Dialogue: 0,0:16:09.47,0:16:11.80,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,0:16:09.47,0:16:11.80,Default,,0000,0000,0000,,Бұл қозғалыс туралы не деуге болады?
Dialogue: 0,0:16:11.80,0:16:14.81,Default,,0000,0000,0000,,Бізге бірлік сезімі керек емес пе?
Dialogue: 0,0:16:14.81,0:16:18.81,Default,,0000,0000,0000,,《Жүр, Сенші, мына арқанды пайдалан!
Dialogue: 0,0:16:18.81,0:16:21.65,Default,,0000,0000,0000,,Жарайды, қалғаны...
Dialogue: 0,0:16:21.65,0:16:23.65,Default,,0000,0000,0000,,Асығыңыз!
Dialogue: 0,0:16:23.65,0:16:27.55,Default,,0000,0000,0000,,Гриффинді бағыттаңыз!
Dialogue: 0,0:16:23.65,0:16:27.55,Default,,0000,0000,0000,,Жүр, менің артымнан жүр! 》
Dialogue: 0,0:16:31.99,0:16:36.00,Default,,0000,0000,0000,,《Осылай жерде қал...! 》
Dialogue: 0,0:16:36.00,0:16:38.00,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:16:40.00,0:16:42.33,Default,,0000,0000,0000,,Мен жеңілдім...
Dialogue: 0,0:16:42.33,0:16:46.34,Default,,0000,0000,0000,,Жоқ, мен сенімен бәсекелесе алмаймын...
Dialogue: 0,0:16:42.33,0:16:46.34,Default,,0000,0000,0000,,Мен не істеуім керек?
Dialogue: 0,0:16:46.34,0:16:48.34,Default,,0000,0000,0000,,Жарайды, маған қалдырыңыз!
Dialogue: 0,0:16:48.34,0:16:50.84,Default,,0000,0000,0000,,Күшті
Dialogue: 0,0:16:48.34,0:16:50.84,Default,,0000,0000,0000,,Мен оны қайсарлықпен саламын!
Dialogue: 0,0:16:50.84,0:16:54.01,Default,,0000,0000,0000,,Мұнда мүйіздерді қосып, тістерді туралаңыз
Dialogue: 0,0:16:50.84,0:16:54.01,Default,,0000,0000,0000,,Өткір тырнақтармен қарулан!
Dialogue: 0,0:16:54.01,0:16:56.01,Default,,0000,0000,0000,,Денеңізді таразымен жабыңыз...
Dialogue: 0,0:16:56.01,0:16:59.52,Default,,0000,0000,0000,,Басыңды көтер!
Dialogue: 0,0:16:56.01,0:16:59.52,Default,,0000,0000,0000,,Мүмкіндіктер артады және сіз міндетті түрде күшті боласыз!
Dialogue: 0,0:16:59.52,0:17:02.29,Default,,0000,0000,0000,,Жалынмен дем ал! Мұзды түкір!
Dialogue: 0,0:16:59.52,0:17:02.29,Default,,0000,0000,0000,,Мектеп оқушысы үшін ол өзімен бірге таңғаларлықтай 50 000 йен алып жүр
Dialogue: 0,0:17:02.29,0:17:04.46,Default,,0000,0000,0000,,Хэхехе...
Dialogue: 0,0:17:02.29,0:17:04.46,Default,,0000,0000,0000,,《Грифинмен қалай күресуге болады?
Dialogue: 0,0:17:04.46,0:17:07.63,Default,,0000,0000,0000,,Шабуыл күші қажет пе? Қорғаныс күші?
Dialogue: 0,0:17:07.63,0:17:11.13,Default,,0000,0000,0000,,Жоқ! 》
Dialogue: 0,0:17:07.63,0:17:11.13,Default,,0000,0000,0000,,Хехе... Иә?
Dialogue: 0,0:17:11.13,0:17:13.30,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:17:13.30,0:17:15.97,Default,,0000,0000,0000,,《Тырнақ пен тістің қажеті жоқ.
Dialogue: 0,0:17:15.97,0:17:20.31,Default,,0000,0000,0000,,Жылдам, серпімді және әдемі...
Dialogue: 0,0:17:15.97,0:17:20.31,Default,,0000,0000,0000,,Сізге тек… қажет.
Dialogue: 0,0:17:20.31,0:17:23.81,Default,,0000,0000,0000,,Сеншиді құтқару үшін
Dialogue: 0,0:17:20.31,0:17:23.81,Default,,0000,0000,0000,,Тірі заттарды жасау➡
Dialogue: 0,0:17:23.81,0:17:25.81,Default,,0000,0000,0000,,Шешімділік және эго》
Dialogue: 0,0:17:25.81,0:17:29.31,Default,,0000,0000,0000,,< Осы уақытта
Dialogue: 0,0:17:25.81,0:17:29.31,Default,,0000,0000,0000,,Марсильдің шынайы ойлары➡
Dialogue: 0,0:17:29.31,0:17:31.32,Default,,0000,0000,0000,,Дұға.
Dialogue: 0,0:17:31.32,0:17:33.99,Default,,0000,0000,0000,,Ғажайыпқа қол жеткізілді>
Dialogue: 0,0:17:33.99,0:17:36.32,Default,,0000,0000,0000,,Мен саған ат беремін.
Dialogue: 0,0:17:36.32,0:17:39.99,Default,,0000,0000,0000,,Амака
Dialogue: 0,0:17:36.32,0:17:39.99,Default,,0000,0000,0000,,Қалықтаған күміс қанаттар.
Dialogue: 0,0:17:39.99,0:17:43.33,Default,,0000,0000,0000,,Аспан балығы! Шақыру!
Dialogue: 0,0:17:43.33,0:17:45.33,Default,,0000,0000,0000,,Қа...!
Dialogue: 0,0:17:45.33,0:17:47.33,Default,,0000,0000,0000,,Салқын емес….
Dialogue: 0,0:17:45.33,0:17:47.33,Default,,0000,0000,0000,,Жақсы! Осымен!
Dialogue: 0,0:17:47.33,0:17:49.67,Default,,0000,0000,0000,,Енді жүр!
Dialogue: 0,0:17:49.67,0:17:56.68,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:17:56.68,0:17:58.84,Default,,0000,0000,0000,,Асығыңыз!
Dialogue: 0,0:17:56.68,0:17:58.84,Default,,0000,0000,0000,,Қозғалыс жиіркенішті сезіледі!
Dialogue: 0,0:17:58.84,0:18:01.95,Default,,0000,0000,0000,,Бар күшіңізбен жүріңіз! Барлығы дайындал!
Dialogue: 0,0:18:01.95,0:18:04.45,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:18:01.95,0:18:04.45,Default,,0000,0000,0000,,Сонда ол кім?
Dialogue: 0,0:18:04.45,0:18:06.95,Default,,0000,0000,0000,,Ол көп жұмыс істейді.
Dialogue: 0,0:18:04.45,0:18:06.95,Default,,0000,0000,0000,,Уф уф...
Dialogue: 0,0:18:08.95,0:18:10.96,Default,,0000,0000,0000,,Сәлем.
Dialogue: 0,0:18:10.96,0:18:14.63,Default,,0000,0000,0000,,《Уау!
Dialogue: 0,0:18:14.63,0:18:17.13,Default,,0000,0000,0000,,Эй, мен рульді басқара алмаймын! 》
Dialogue: 0,0:18:20.13,0:18:22.97,Default,,0000,0000,0000,,《Бұл жолы!
Dialogue: 0,0:18:22.97,0:18:25.30,Default,,0000,0000,0000,,Айналыңыз...!
Dialogue: 0,0:18:25.30,0:18:27.64,Default,,0000,0000,0000,,Жарылыңыз! 》
Dialogue: 0,0:18:27.64,0:18:41.32,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:18:41.32,0:18:44.82,Default,,0000,0000,0000,,Гах...!
Dialogue: 0,0:18:51.50,0:18:54.50,Default,,0000,0000,0000,,Жарыс басталмас бұрын Қвиркіңді қолданба! Өзіңді шаршатпа!
Dialogue: 0,0:18:51.50,0:18:54.50,Default,,0000,0000,0000,,Ах, а...
Dialogue: 0,0:18:54.50,0:18:56.67,Default,,0000,0000,0000,,Менің ойымша, сізге біраз демалу керек.
Dialogue: 0,0:18:56.67,0:18:59.84,Default,,0000,0000,0000,,Мен тамақ дайындаймын.
Dialogue: 0,0:18:56.67,0:18:59.84,Default,,0000,0000,0000,,Сенші, сонда демал.
Dialogue: 0,0:18:59.84,0:19:02.64,Default,,0000,0000,0000,,Ах... Ах.
Dialogue: 0,0:19:08.28,0:19:10.28,Default,,0000,0000,0000,,Рахмет.
Dialogue: 0,0:19:10.28,0:19:12.78,Default,,0000,0000,0000,,Еңбегіңіз үшін рахмет….
Dialogue: 0,0:19:12.78,0:19:14.79,Default,,0000,0000,0000,,《Аспан балығы…》
Dialogue: 0,0:19:17.12,0:19:20.29,Default,,0000,0000,0000,,Уау~ Бұл керемет.
Dialogue: 0,0:19:20.29,0:19:23.96,Default,,0000,0000,0000,,Көкөністер ішкі мүшелер сияқты толтырылған.
Dialogue: 0,0:19:23.96,0:19:25.96,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:19:23.96,0:19:25.96,Default,,0000,0000,0000,,Сендер-ай, шіркін!
Dialogue: 0,0:19:25.96,0:19:29.13,Default,,0000,0000,0000,,Иә, бұл әлі де қажет болды ма?
Dialogue: 0,0:19:25.96,0:19:29.13,Default,,0000,0000,0000,,Уф... бұл дұрыс емес!
Dialogue: 0,0:19:29.13,0:19:31.97,Default,,0000,0000,0000,,Бірдеңе... бұл шамалы...
Dialogue: 0,0:19:31.97,0:19:34.31,Default,,0000,0000,0000,,Жоқтау сезімі...
Dialogue: 0,0:19:31.97,0:19:34.31,Default,,0000,0000,0000,,Мұндай уақыт керек...
Dialogue: 0,0:19:34.31,0:19:36.81,Default,,0000,0000,0000,,Амансың ба? Сенси.
Dialogue: 0,0:19:36.81,0:19:38.81,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:19:44.98,0:19:47.99,Default,,0000,0000,0000,,Жетеді, қалағаныңды істе.
Dialogue: 0,0:19:47.99,0:19:51.66,Default,,0000,0000,0000,,《Шақырылған аңдар
Dialogue: 0,0:19:47.99,0:19:51.66,Default,,0000,0000,0000,,Тиісті ұзындықтарды кесіңіз➡
Dialogue: 0,0:19:51.66,0:19:54.49,Default,,0000,0000,0000,,Түбіндегі қауырсындарды кесіңіз.
Dialogue: 0,0:19:54.49,0:19:58.00,Default,,0000,0000,0000,,Ылғалды шүберекпен кетіріңіз.
Dialogue: 0,0:19:58.00,0:20:00.00,Default,,0000,0000,0000,,Тұз және бұрыш.
Dialogue: 0,0:20:00.00,0:20:02.00,Default,,0000,0000,0000,,Қанаттарды кішкене бөліктерге бүктеңіз.
Dialogue: 0,0:20:02.00,0:20:07.17,Default,,0000,0000,0000,,Ұнды, жұмыртқаны және суды жақсылап араластырыңыз.
Dialogue: 0,0:20:02.00,0:20:07.17,Default,,0000,0000,0000,,Филе ➡ өткізіңіз
Dialogue: 0,0:20:07.17,0:20:09.34,Default,,0000,0000,0000,,Қуыр!
Dialogue: 0,0:20:09.34,0:20:12.68,Default,,0000,0000,0000,,Қауырсындар оңай күйіп кетеді
Dialogue: 0,0:20:09.34,0:20:12.68,Default,,0000,0000,0000,,Ол арқылы өтуге болатын дәрежеде.
Dialogue: 0,0:20:12.68,0:20:15.01,Default,,0000,0000,0000,,Тұздықпен беріледі...》
Dialogue: 0,0:20:15.01,0:20:17.02,Default,,0000,0000,0000,,Completed!
Dialogue: 0,0:20:25.02,0:20:29.70,Default,,0000,0000,0000,,Ет пен көкөністі араластыру
Dialogue: 0,0:20:25.02,0:20:29.70,Default,,0000,0000,0000,,Тамаша!
Dialogue: 0,0:20:25.02,0:20:29.70,Default,,0000,0000,0000,,Сөзбе-сөз.
Dialogue: 0,0:20:29.70,0:20:33.20,Default,,0000,0000,0000,,Шақыруды пісіру әдісі ретінде де қолдануға болады
Dialogue: 0,0:20:29.70,0:20:33.20,Default,,0000,0000,0000,,Өте жақсы емес пе?
Dialogue: 0,0:20:33.20,0:20:37.87,Default,,0000,0000,0000,,Бір тамаққа бір апталық тағамды пайдаланыңыз
Dialogue: 0,0:20:33.20,0:20:37.87,Default,,0000,0000,0000,,Үздік деген нәрсе жоқ.
Dialogue: 0,0:20:37.87,0:20:41.04,Default,,0000,0000,0000,,Тәтті, мен оны білдім.
Dialogue: 0,0:20:37.87,0:20:41.04,Default,,0000,0000,0000,,Мен ішімдік алып, үйге қайтпақшы болдым.
Dialogue: 0,0:20:41.04,0:20:45.54,Default,,0000,0000,0000,,Изуцуми Қанаттардан басқа
Dialogue: 0,0:20:41.04,0:20:45.54,Default,,0000,0000,0000,,Тамақтану.
Dialogue: 0,0:20:41.04,0:20:45.54,Default,,0000,0000,0000,,Жоқ.
Dialogue: 0,0:20:45.54,0:20:47.55,Default,,0000,0000,0000,,Сенші де тістеп алды...
Dialogue: 0,0:20:50.22,0:20:52.22,Default,,0000,0000,0000,,Гриффин туралы қызық па?
Dialogue: 0,0:20:50.22,0:20:52.22,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:20:52.22,0:20:56.22,Default,,0000,0000,0000,,Қанды ағызу керек пе?
Dialogue: 0,0:20:52.22,0:20:56.22,Default,,0000,0000,0000,,Жоқ, бұл ештеңе емес.
Dialogue: 0,0:20:56.22,0:20:59.56,Default,,0000,0000,0000,,Дәл қазір тәбетім жоқ...
Dialogue: 0,0:20:59.56,0:21:01.49,Default,,0000,0000,0000,,(тамақты тазартады)
Dialogue: 0,0:21:01.49,0:21:03.50,Default,,0000,0000,0000,,Әй, Сенші.
Dialogue: 0,0:21:05.83,0:21:07.83,Default,,0000,0000,0000,,Менің атым Чилчак.
Dialogue: 0,0:21:07.83,0:21:12.67,Default,,0000,0000,0000,,Мен осы жерден солтүстік-шығысқа қарай дүниеге келдім.
Dialogue: 0,0:21:07.83,0:21:12.67,Default,,0000,0000,0000,,Бұл шағын бассейндік ауыл.
Dialogue: 0,0:21:12.67,0:21:17.51,Default,,0000,0000,0000,,Шамамен 10 жыл бұрын
Dialogue: 0,0:21:12.67,0:21:17.51,Default,,0000,0000,0000,,Олар ел бойынша лабиринттердің айналасында бизнес жасайды.
Dialogue: 0,0:21:17.51,0:21:20.85,Default,,0000,0000,0000,,Құлыптау, түсіндіру, делдалдық, білгірлік….
Dialogue: 0,0:21:20.85,0:21:22.85,Default,,0000,0000,0000,,Сондай-ақ...
Dialogue: 0,0:21:22.85,0:21:26.52,Default,,0000,0000,0000,,Менің әйелім мен қызым бар.
Dialogue: 0,0:21:22.85,0:21:26.52,Default,,0000,0000,0000,,Түрлі жағдайларға байланысты көп жылдар бойы көрмедік.
Dialogue: 0,0:21:26.52,0:21:28.52,Default,,0000,0000,0000,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:21:28.52,0:21:31.69,Default,,0000,0000,0000,,Әйелі? қызым?
Dialogue: 0,0:21:28.52,0:21:31.69,Default,,0000,0000,0000,,Менің өткенім туралы
Dialogue: 0,0:21:28.52,0:21:31.69,Default,,0000,0000,0000,,Негізінен осындай.
Dialogue: 0,0:21:31.69,0:21:34.36,Default,,0000,0000,0000,,Бұл жолы
Dialogue: 0,0:21:31.69,0:21:34.36,Default,,0000,0000,0000,,Өзіңіз туралы айтып беріңіз.
Dialogue: 0,0:21:34.36,0:21:38.86,Default,,0000,0000,0000,,Неліктен мұндай жерде тұрасың?
Dialogue: 0,0:21:34.36,0:21:38.86,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:21:40.87,0:21:42.87,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:21:44.87,0:21:52.38,Default,,0000,0000,0000,,Бүркіттің аты – Ізғандының Сеншіі.
Dialogue: 0,0:21:44.87,0:21:52.38,Default,,0000,0000,0000,,Ол шахтерлердің шағын бандасының мүшесі болды.
Dialogue: 0,0:21:52.38,0:21:54.71,Default,,0000,0000,0000,,Кенші десең де➡
Dialogue: 0,0:21:54.71,0:21:57.22,Default,,0000,0000,0000,,Кен менің мақсатым емес еді.
Dialogue: 0,0:21:57.22,0:22:02.49,Default,,0000,0000,0000,,Соғыс алдындағы қирандыларды іздеу
Dialogue: 0,0:21:57.22,0:22:02.49,Default,,0000,0000,0000,,Мен оны байытуды армандадым.
Dialogue: 0,0:22:02.49,0:22:06.33,Default,,0000,0000,0000,,Дегенмен, негізгі өнім – кен➡
Dialogue: 0,0:22:06.33,0:22:12.33,Default,,0000,0000,0000,,Сирек жағдайларда тісті доңғалақтар, линзалар және т.б.
Dialogue: 0,0:22:06.33,0:22:12.33,Default,,0000,0000,0000,,Егер жәдігерлер табылса жақсы болар еді, бірақ...
Dialogue: 0,0:22:12.33,0:22:18.00,Default,,0000,0000,0000,,Сол күні біз өте жақсы болдық
Dialogue: 0,0:22:12.33,0:22:18.00,Default,,0000,0000,0000,,Мен үлкен нәрсе таптым.
Dialogue: 0,0:22:18.00,0:22:20.17,Default,,0000,0000,0000,,｟Сенси: Уау...｠
Dialogue: 0,0:22:20.17,0:22:25.18,Default,,0000,0000,0000,,Алтынмен жарқыраған көне қамал...
Dialogue: 0,0:22:25.18,0:22:29.08,Default,,0000,0000,0000,,Иә... бұл лабиринт.
Dialogue: 0,0:22:30.58,0:22:36.58,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory