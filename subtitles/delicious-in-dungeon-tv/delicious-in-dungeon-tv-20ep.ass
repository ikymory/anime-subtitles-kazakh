Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:30.52,0:01:33.86,Default,,0000,0000,0000,,А...
Dialogue: 0,0:01:30.52,0:01:33.86,Default,,0000,0000,0000,,Осылай болды ма?
Dialogue: 0,0:01:33.86,0:01:36.66,Default,,0000,0000,0000,,Сөз жоқ.
Dialogue: 0,0:01:33.86,0:01:36.66,Default,,0000,0000,0000,,Шынымен бе?
Dialogue: 0,0:01:39.03,0:01:42.20,Default,,0000,0000,0000,,Кеш! Тезірек жалғастырыңыз!
Dialogue: 0,0:01:39.03,0:01:42.20,Default,,0000,0000,0000,,Алдыңғы жағы кептеліп қалды...
Dialogue: 0,0:01:42.20,0:01:45.21,Default,,0000,0000,0000,,Итермеңіз. Итермеңіз.
Dialogue: 0,0:01:42.20,0:01:45.21,Default,,0000,0000,0000,,О, күте тұрыңыз ...
Dialogue: 0,0:01:42.20,0:01:45.21,Default,,0000,0000,0000,,Қауіпті.
Dialogue: 0,0:01:45.21,0:01:47.21,Default,,0000,0000,0000,,(Химецудзима) Жәбірленген-ай… Қандай әлсіз, аянышты бала.
Dialogue: 0,0:01:45.21,0:01:47.21,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:01:45.21,0:01:47.21,Default,,0000,0000,0000,,О!
Dialogue: 0,0:01:47.21,0:01:49.54,Default,,0000,0000,0000,,Иә! Қарғыс атқыр... Ах.
Dialogue: 0,0:01:49.54,0:01:53.05,Default,,0000,0000,0000,,Бұл зал!
Dialogue: 0,0:01:49.54,0:01:53.05,Default,,0000,0000,0000,,Қызыл айдаһармен қай жерде шайқасты!
Dialogue: 0,0:01:55.05,0:01:58.89,Default,,0000,0000,0000,,Алдыңғы іздеуде
Dialogue: 0,0:01:55.05,0:01:58.89,Default,,0000,0000,0000,,Сіз осындай жерге келдіңіз бе?
Dialogue: 0,0:01:58.89,0:02:00.82,Default,,0000,0000,0000,,Иә….
Dialogue: 0,0:02:00.82,0:02:03.99,Default,,0000,0000,0000,,Ұзақ уақыт бойы мен мұның ең терең бөлігі екенін білдім.
Dialogue: 0,0:02:00.82,0:02:03.99,Default,,0000,0000,0000,,Бұл болды.
Dialogue: 0,0:02:00.82,0:02:03.99,Default,,0000,0000,0000,,Буха!
Dialogue: 0,0:02:03.99,0:02:07.99,Default,,0000,0000,0000,,Жақында осы жерде
Dialogue: 0,0:02:03.99,0:02:07.99,Default,,0000,0000,0000,,Артқы жаққа апаратын есік табылды.
Dialogue: 0,0:02:07.99,0:02:11.83,Default,,0000,0000,0000,,Үстіне өрнек ойылған.
Dialogue: 0,0:02:07.99,0:02:11.83,Default,,0000,0000,0000,,Менің ойымша, бұл сиқырдың күшімен жұмыс істейді.
Dialogue: 0,0:02:11.83,0:02:15.84,Default,,0000,0000,0000,,Арал иесінің өтініші бойынша өрнек
Dialogue: 0,0:02:11.83,0:02:15.84,Default,,0000,0000,0000,,Мен суретке түсуге келдім...
Dialogue: 0,0:02:15.84,0:02:18.34,Default,,0000,0000,0000,,｟n…｠
Dialogue: 0,0:02:18.34,0:02:23.51,Default,,0000,0000,0000,,Қызыл айдаһармен кездесу
Dialogue: 0,0:02:18.34,0:02:23.51,Default,,0000,0000,0000,,Шығарылды.
Dialogue: 0,0:02:23.51,0:02:28.11,Default,,0000,0000,0000,,Енді бағыңызды сынап көріңіз.
Dialogue: 0,0:02:23.51,0:02:28.11,Default,,0000,0000,0000,,Ол кезде менің ойымша, сол жерде болды.
Dialogue: 0,0:02:30.18,0:02:32.19,Default,,0000,0000,0000,,Міне болды! Бұл багаж!
Dialogue: 0,0:02:32.19,0:02:35.02,Default,,0000,0000,0000,,Оны бүлдіруде...
Dialogue: 0,0:02:32.19,0:02:35.02,Default,,0000,0000,0000,,Міне!
Dialogue: 0,0:02:35.02,0:02:37.19,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:02:35.02,0:02:37.19,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:02:37.19,0:02:40.03,Default,,0000,0000,0000,,Иә! Ұйықтау қапшығына қараңыз!
Dialogue: 0,0:02:40.03,0:02:42.53,Default,,0000,0000,0000,,Жақсы, менің іш киімім қауіпсіз.
Dialogue: 0,0:02:42.53,0:02:45.53,Default,,0000,0000,0000,,Бұл ақшаны немесе тауарды тексермес бұрын тексеру керек пе?
Dialogue: 0,0:02:45.53,0:02:48.20,Default,,0000,0000,0000,,Тағам тамырымен жұлынып кетті➡
Dialogue: 0,0:02:48.20,0:02:52.04,Default,,0000,0000,0000,,Басқа заттар қол тимеген.
Dialogue: 0,0:02:48.20,0:02:52.04,Default,,0000,0000,0000,,Бұл құбыжықтың жұмысы сияқты.
Dialogue: 0,0:02:52.04,0:02:55.71,Default,,0000,0000,0000,,Уф, тым қызықсыз екен.
Dialogue: 0,0:02:52.04,0:02:55.71,Default,,0000,0000,0000,,Енді сіз жылы ұйықтай аласыз...
Dialogue: 0,0:02:55.71,0:02:57.71,Default,,0000,0000,0000,,Актун!
Dialogue: 0,0:02:55.71,0:02:57.71,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:02:57.71,0:03:00.48,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:02:57.71,0:03:00.48,Default,,0000,0000,0000,,Жоқ.
Dialogue: 0,0:02:57.71,0:03:00.48,Default,,0000,0000,0000,,
Dialogue: 0,0:03:00.48,0:03:04.98,Default,,0000,0000,0000,,Демалу үшін жер іздеу керек пе?
Dialogue: 0,0:03:00.48,0:03:04.98,Default,,0000,0000,0000,,Мен де жүктерімді реттегім келеді.
Dialogue: 0,0:03:04.98,0:03:07.99,Default,,0000,0000,0000,,Қарда
Dialogue: 0,0:03:04.98,0:03:07.99,Default,,0000,0000,0000,,Тазалаушының да қимылы баяулай ма деп ойлаймын.
Dialogue: 0,0:03:07.99,0:03:10.32,Default,,0000,0000,0000,,Сабын шағып алды...
Dialogue: 0,0:03:10.32,0:03:13.33,Default,,0000,0000,0000,,Сәлем кола
Dialogue: 0,0:03:10.32,0:03:13.33,Default,,0000,0000,0000,,Қалтаңызға жаңа салғаныңызды алыңыз.
Dialogue: 0,0:03:16.83,0:03:19.33,Default,,0000,0000,0000,,Қараңызшы, Марсиль.
Dialogue: 0,0:03:16.83,0:03:19.33,Default,,0000,0000,0000,,Иә? Ол аурады.
Dialogue: 0,0:03:19.33,0:03:21.83,Default,,0000,0000,0000,,Ол тәртіпсіз хайуан.
Dialogue: 0,0:03:21.83,0:03:24.84,Default,,0000,0000,0000,,Осындай жағаны кие білу
Dialogue: 0,0:03:21.83,0:03:24.84,Default,,0000,0000,0000,,Мен бұл Мубе Нару ма деп ойлаймын.
Dialogue: 0,0:03:24.84,0:03:27.84,Default,,0000,0000,0000,,Менің ойымша, бұл жарты фут деп аталады.
Dialogue: 0,0:03:27.84,0:03:30.84,Default,,0000,0000,0000,,Шығыста
Dialogue: 0,0:03:27.84,0:03:30.84,Default,,0000,0000,0000,,Өйткені сендей адам болған жоқ➡
Dialogue: 0,0:03:30.84,0:03:33.68,Default,,0000,0000,0000,,Мен мұны алғаш рет осында келгенде білдім.
Dialogue: 0,0:03:33.68,0:03:36.02,Default,,0000,0000,0000,,Сол біртүрлі нәсіл атауы➡
Dialogue: 0,0:03:36.02,0:03:41.02,Default,,0000,0000,0000,,Ұрлық үшін бір аяғынан айырылып қалуы мүмкін.
Dialogue: 0,0:03:36.02,0:03:41.02,Default,,0000,0000,0000,,Мен олардың көп болғандығынан деп ойлаймын.
Dialogue: 0,0:03:41.02,0:03:43.02,Default,,0000,0000,0000,,Уф...!
Dialogue: 0,0:03:43.02,0:03:45.02,Default,,0000,0000,0000,,Екеуің тоқтаңдар.
Dialogue: 0,0:03:45.02,0:03:48.36,Default,,0000,0000,0000,,Марсиль!
Dialogue: 0,0:03:45.02,0:03:48.36,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:03:45.02,0:03:48.36,Default,,0000,0000,0000,,Кел!
Dialogue: 0,0:03:48.36,0:03:51.03,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:03:51.03,0:03:53.03,Default,,0000,0000,0000,,Әй, балық!
Dialogue: 0,0:03:53.03,0:03:56.54,Default,,0000,0000,0000,,Тек осы бөлік
Dialogue: 0,0:03:53.03,0:03:56.54,Default,,0000,0000,0000,,Оны қиып тастаудың жолы жоқ.
Dialogue: 0,0:03:56.54,0:04:00.47,Default,,0000,0000,0000,,Ооо мен сиқырлы шеңберді пайдалана алдым...
Dialogue: 0,0:04:00.47,0:04:05.31,Default,,0000,0000,0000,,Иә, сіз Laios қолданбасын қолданғыңыз келе ме?
Dialogue: 0,0:04:00.47,0:04:05.31,Default,,0000,0000,0000,,Мен сендерге сиқырлы шеңбер салуды үйретемін.
Dialogue: 0,0:04:05.31,0:04:09.48,Default,,0000,0000,0000,,Соңғы уақытта сиқырлы ауруыңыз қалай болды?
Dialogue: 0,0:04:05.31,0:04:09.48,Default,,0000,0000,0000,,Менің енді басым айналып тұрған жоқ.
Dialogue: 0,0:04:09.48,0:04:13.65,Default,,0000,0000,0000,,《Есту галлюцинациялары мен галлюцинациялар болып табылады
Dialogue: 0,0:04:09.48,0:04:13.65,Default,,0000,0000,0000,,Ол сәл күшейді...》
Dialogue: 0,0:04:13.65,0:04:17.49,Default,,0000,0000,0000,,《Мен 4-қабатта ұстаған балық.
Dialogue: 0,0:04:17.49,0:04:22.16,Default,,0000,0000,0000,,Жоғарғы қабаттан ағып жатқан су
Dialogue: 0,0:04:17.49,0:04:22.16,Default,,0000,0000,0000,,Тоңып қалдыңыз ба?
Dialogue: 0,0:04:22.16,0:04:25.57,Default,,0000,0000,0000,,Әртүрлі заттар
Dialogue: 0,0:04:22.16,0:04:25.57,Default,,0000,0000,0000,,Оны шайып жатқан сияқты》
Dialogue: 0,0:04:27.50,0:04:29.50,Default,,0000,0000,0000,,Қалыптастыру енді аяқталды.
Dialogue: 0,0:04:29.50,0:04:33.01,Default,,0000,0000,0000,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:04:29.50,0:04:33.01,Default,,0000,0000,0000,,Мен аздап шаршадым.
Dialogue: 0,0:04:33.01,0:04:35.01,Default,,0000,0000,0000,,Ал, мен бастайын.
Dialogue: 0,0:04:35.01,0:04:40.18,Default,,0000,0000,0000,,Ойылған әріптерде
Dialogue: 0,0:04:35.01,0:04:40.18,Default,,0000,0000,0000,,Су құйып жатқанын елестетіңіз...
Dialogue: 0,0:04:40.18,0:04:42.18,Default,,0000,0000,0000,,Nuo.
Dialogue: 0,0:04:42.18,0:04:44.35,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:04:42.18,0:04:44.35,Default,,0000,0000,0000,,Не! ?
Dialogue: 0,0:04:44.35,0:04:47.02,Default,,0000,0000,0000,,Жер... Нуо!
Dialogue: 0,0:04:47.02,0:04:49.52,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:04:49.52,0:04:52.86,Default,,0000,0000,0000,,Ма, құбыжық! ?
Dialogue: 0,0:04:49.52,0:04:52.86,Default,,0000,0000,0000,,Мұз големі?
Dialogue: 0,0:04:52.86,0:04:56.20,Default,,0000,0000,0000,,《Мм….
Dialogue: 0,0:04:56.20,0:04:58.36,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:04:58.36,0:05:00.63,Default,,0000,0000,0000,,Керемет!
Dialogue: 0,0:05:00.63,0:05:02.64,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:05:05.14,0:05:07.14,Default,,0000,0000,0000,,Сәлем! Сақ болыңыз!
Dialogue: 0,0:05:07.14,0:05:09.14,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:05:09.14,0:05:11.14,Default,,0000,0000,0000,,Жақсы….
Dialogue: 0,0:05:09.14,0:05:11.14,Default,,0000,0000,0000,,Лайос!
Dialogue: 0,0:05:13.15,0:05:15.65,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:05:15.65,0:05:17.65,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:05:21.32,0:05:23.32,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:05:23.32,0:05:25.83,Default,,0000,0000,0000,,Мен қалай өлемін? Сол жігіт.
Dialogue: 0,0:05:25.83,0:05:28.66,Default,,0000,0000,0000,,Голем өзегін жоюы керек.
Dialogue: 0,0:05:25.83,0:05:28.66,Default,,0000,0000,0000,,Мұның мағынасы жоқ!
Dialogue: 0,0:05:28.66,0:05:31.16,Default,,0000,0000,0000,,Ядролық? Ол қайда...?
Dialogue: 0,0:05:34.17,0:05:36.17,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:05:39.17,0:05:42.01,Default,,0000,0000,0000,,Сәлем! Ядро қайда!
Dialogue: 0,0:05:39.17,0:05:42.01,Default,,0000,0000,0000,,Бір сәт!
Dialogue: 0,0:05:42.01,0:05:44.84,Default,,0000,0000,0000,,Ядро... Әлде балық па?
Dialogue: 0,0:05:44.84,0:05:47.01,Default,,0000,0000,0000,,《Тым көп қоспалар》
Dialogue: 0,0:05:47.01,0:05:50.02,Default,,0000,0000,0000,,Сәлем! Мүмкіндігінше көп жауды тартыңыз
Dialogue: 0,0:05:47.01,0:05:50.02,Default,,0000,0000,0000,,Уақытты сатып алыңыз!
Dialogue: 0,0:05:50.02,0:05:52.52,Default,,0000,0000,0000,,Мен ядроның орнын білмеймін!
Dialogue: 0,0:05:50.02,0:05:52.52,Default,,0000,0000,0000,,Ха! ?
Dialogue: 0,0:05:52.52,0:05:54.52,Default,,0000,0000,0000,,《Мына бейбақтар сап түзеп жатыр➡
Dialogue: 0,0:05:54.52,0:05:57.32,Default,,0000,0000,0000,,Мені ұстап тұруға тырысады
Dialogue: 0,0:05:54.52,0:05:57.32,Default,,0000,0000,0000,,Менің ойымша, ол мұны істемейді.
Dialogue: 0,0:06:03.63,0:06:05.80,Default,,0000,0000,0000,,Қар...
Dialogue: 0,0:06:05.80,0:06:07.80,Default,,0000,0000,0000,,Аһ!
Dialogue: 0,0:06:07.80,0:06:09.80,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:06:14.97,0:06:17.08,Default,,0000,0000,0000,,《Қозғалысты тоқтатты》
Dialogue: 0,0:06:23.32,0:06:25.32,Default,,0000,0000,0000,,Пуха!
Dialogue: 0,0:06:29.32,0:06:32.33,Default,,0000,0000,0000,,Эй, сен әлі осындасың!
Dialogue: 0,0:06:29.32,0:06:32.33,Default,,0000,0000,0000,,Бұған қанша уақыт жол бересіз?
Dialogue: 0,0:06:32.33,0:06:34.33,Default,,0000,0000,0000,,Жарайсың, Изцуми!
Dialogue: 0,0:06:40.50,0:06:42.50,Default,,0000,0000,0000,,Жарайды, тамаша!
Dialogue: 0,0:06:42.50,0:06:44.84,Default,,0000,0000,0000,,Теми Мені қалжыңдап тұрсың ба?
Dialogue: 0,0:06:44.84,0:06:48.14,Default,,0000,0000,0000,,Идиот! Жебе қай жерге тигенін мұқият қараңыз!
Dialogue: 0,0:06:44.84,0:06:48.14,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:06:51.34,0:06:54.51,Default,,0000,0000,0000,,Олай болса!
Dialogue: 0,0:06:51.34,0:06:54.51,Default,,0000,0000,0000,,Мен снарядтарды қолдана аламын!
Dialogue: 0,0:06:54.51,0:06:57.35,Default,,0000,0000,0000,,ауыр жарақат
Dialogue: 0,0:06:54.51,0:06:57.35,Default,,0000,0000,0000,,Бұл тұрарлық емес!
Dialogue: 0,0:06:57.35,0:06:59.69,Default,,0000,0000,0000,,Мені күш деп санама!
Dialogue: 0,0:06:59.69,0:07:01.89,Default,,0000,0000,0000,,Қалғанын сізге қалдырамын!
Dialogue: 0,0:06:59.69,0:07:01.89,Default,,0000,0000,0000,,Дұрыс, болды!
Dialogue: 0,0:07:03.96,0:07:05.96,Default,,0000,0000,0000,,《Жақсы….
Dialogue: 0,0:07:05.96,0:07:08.13,Default,,0000,0000,0000,,Оны қалай жеңуге болатынын білгенше...》
Dialogue: 0,0:07:08.13,0:07:14.83,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:07:28.31,0:07:30.32,Default,,0000,0000,0000,,Hmph.
Dialogue: 0,0:07:30.32,0:07:32.49,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:07:30.32,0:07:32.49,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:07:32.49,0:07:35.32,Default,,0000,0000,0000,,Шамасы осында
Dialogue: 0,0:07:32.49,0:07:35.32,Default,,0000,0000,0000,,Дұрыс қозғала алатын жалғыз нәрсе – ➡
Dialogue: 0,0:07:35.32,0:07:40.83,Default,,0000,0000,0000,,Жалғыз мен сияқтымын.
Dialogue: 0,0:07:35.32,0:07:40.83,Default,,0000,0000,0000,,Бұл жігіттің бәрі де бар ха… ха….
Dialogue: 0,0:07:40.83,0:07:43.33,Default,,0000,0000,0000,,Хакушун!
Dialogue: 0,0:07:43.33,0:07:47.00,Default,,0000,0000,0000,,Уау~ Уау….
Dialogue: 0,0:07:47.00,0:07:50.67,Default,,0000,0000,0000,,Барлығы жақсы ма?
Dialogue: 0,0:07:47.00,0:07:50.67,Default,,0000,0000,0000,,Жылығалы жатыр.
Dialogue: 0,0:07:50.67,0:07:54.34,Default,,0000,0000,0000,,Сол сиқырлы шеңбер күшті жылу шығарады.
Dialogue: 0,0:07:50.67,0:07:54.34,Default,,0000,0000,0000,,Күйіп қалмау үшін абай болыңыз.
Dialogue: 0,0:07:54.34,0:07:58.34,Default,,0000,0000,0000,,Ылғал киімді шешіп, құрғатыңыз.
Dialogue: 0,0:07:54.34,0:07:58.34,Default,,0000,0000,0000,,Эй, сен де.
Dialogue: 0,0:07:58.34,0:08:00.61,Default,,0000,0000,0000,,Мен сізді блоктаймын.
Dialogue: 0,0:08:00.61,0:08:04.62,Default,,0000,0000,0000,,Лайос оны өздігінен шешетін сияқты ма?
Dialogue: 0,0:08:00.61,0:08:04.62,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:08:04.62,0:08:07.62,Default,,0000,0000,0000,,Біреу маған көмектесуін өтінемін.
Dialogue: 0,0:08:04.62,0:08:07.62,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:08:07.62,0:08:10.46,Default,,0000,0000,0000,,Оны бұғаттаудың қажеті жоқ.
Dialogue: 0,0:08:10.46,0:08:12.46,Default,,0000,0000,0000,,Мен осылай дедім...
Dialogue: 0,0:08:21.47,0:08:23.64,Default,,0000,0000,0000,,Аңның жалаңаш жүрген жері➡
Dialogue: 0,0:08:23.64,0:08:25.64,Default,,0000,0000,0000,,Бақытты жігіт жоқ...
Dialogue: 0,0:08:23.64,0:08:25.64,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:08:23.64,0:08:25.64,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:08:25.64,0:08:27.64,Default,,0000,0000,0000,,Не істеп жатырсың?!
Dialogue: 0,0:08:25.64,0:08:27.64,Default,,0000,0000,0000,,Жоқ….
Dialogue: 0,0:08:27.64,0:08:29.64,Default,,0000,0000,0000,,Денені салқындату жаман...
Dialogue: 0,0:08:29.64,0:08:32.85,Default,,0000,0000,0000,,Ең болмағанда емізіктердің саны...
Dialogue: 0,0:08:29.64,0:08:32.85,Default,,0000,0000,0000,,Жоқ, тек құйрықтың негізі.
Dialogue: 0,0:08:37.32,0:08:39.99,Default,,0000,0000,0000,,Күн аздап жылынуда.
Dialogue: 0,0:08:39.99,0:08:42.99,Default,,0000,0000,0000,,Уау….
Dialogue: 0,0:08:39.99,0:08:42.99,Default,,0000,0000,0000,,Жылы нәрсе дайындап алайық.
Dialogue: 0,0:08:42.99,0:08:45.49,Default,,0000,0000,0000,,Оны ықшамдауыңыз керек.
Dialogue: 0,0:08:45.49,0:08:48.49,Default,,0000,0000,0000,,Оны сиқырлы шеңбердің жылуымен сүртіп көруім керек пе?
Dialogue: 0,0:08:50.50,0:08:53.00,Default,,0000,0000,0000,,Уа, сіз тым жақын қалдыңыз.
Dialogue: 0,0:08:53.00,0:08:56.00,Default,,0000,0000,0000,,Ах, бірақ бұл керемет! Бұл сауна болады!
Dialogue: 0,0:08:56.00,0:09:00.31,Default,,0000,0000,0000,,Мен көптен бері жуынбадым.
Dialogue: 0,0:08:56.00,0:09:00.31,Default,,0000,0000,0000,,Тер төгейік!
Dialogue: 0,0:09:04.61,0:09:08.61,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:09:04.61,0:09:08.61,Default,,0000,0000,0000,,Әй, шеш! ?
Dialogue: 0,0:09:04.61,0:09:08.61,Default,,0000,0000,0000,,Неге мен жалғызбын...?
Dialogue: 0,0:09:08.61,0:09:12.45,Default,,0000,0000,0000,,《Сенші: Балықты кесіп ал
Dialogue: 0,0:09:08.61,0:09:12.45,Default,,0000,0000,0000,,Бас пен сүйектен қамыр жасау》
Dialogue: 0,0:09:12.45,0:09:14.95,Default,,0000,0000,0000,,Балықтың иісі еніп тұрғандай.
Dialogue: 0,0:09:14.95,0:09:18.46,Default,,0000,0000,0000,,《Саңырауқұлақтар мен кошмарларды кішкене бөліктерге кесіңіз.
Dialogue: 0,0:09:18.46,0:09:22.13,Default,,0000,0000,0000,,Пішін өзгертуші ет
Dialogue: 0,0:09:18.46,0:09:22.13,Default,,0000,0000,0000,,Көбікті кетіру үшін аздап қайнатыңыз.
Dialogue: 0,0:09:22.13,0:09:24.46,Default,,0000,0000,0000,,Гарпи жұмыртқасын көтеріңіз➡
Dialogue: 0,0:09:24.46,0:09:28.13,Default,,0000,0000,0000,,Мен оны жаңа ғана алдым.
Dialogue: 0,0:09:24.46,0:09:28.13,Default,,0000,0000,0000,,Сорпа мен ингредиенттерді біріктіріңіз》
Dialogue: 0,0:09:28.13,0:09:30.47,Default,,0000,0000,0000,,Уау….
Dialogue: 0,0:09:30.47,0:09:32.97,Default,,0000,0000,0000,,《Оны кесеге құйыңыз➡
Dialogue: 0,0:09:32.97,0:09:37.64,Default,,0000,0000,0000,,Мұз голем сынығымен бірге.
Dialogue: 0,0:09:32.97,0:09:37.64,Default,,0000,0000,0000,,Қазанға салып, қыздырыңыз.
Dialogue: 0,0:09:37.64,0:09:41.15,Default,,0000,0000,0000,,Қараңыз~ Ол шаш шарларынан жасалған.
Dialogue: 0,0:09:37.64,0:09:41.15,Default,,0000,0000,0000,,Бос уақытыңыз бар ма?
Dialogue: 0,0:09:41.15,0:09:44.65,Default,,0000,0000,0000,,《Соңында мандрака жапырағын қосыңыз》
Dialogue: 0,0:09:44.65,0:09:46.65,Default,,0000,0000,0000,,Толық….
Dialogue: 0,0:09:44.65,0:09:46.65,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:09:46.65,0:09:49.66,Default,,0000,0000,0000,,Бұл!
Dialogue: 0,0:09:46.65,0:09:49.66,Default,,0000,0000,0000,,Уф.
Dialogue: 0,0:09:46.65,0:09:49.66,Default,,0000,0000,0000,,Рұқсатсыз тамақты бастауға болмайды.
Dialogue: 0,0:09:49.66,0:09:52.33,Default,,0000,0000,0000,,Барлығы үстелге келгенше күтіңіз.
Dialogue: 0,0:09:52.33,0:09:55.83,Default,,0000,0000,0000,,Мен сені екеуіңді де жақсы көремін, сондықтан оны өзім бергім келеді.
Dialogue: 0,0:09:52.33,0:09:55.83,Default,,0000,0000,0000,,Жауды өзім жеңдім!
Dialogue: 0,0:09:55.83,0:09:58.33,Default,,0000,0000,0000,,Менің бірінші жеуге құқығым бар!
Dialogue: 0,0:09:58.33,0:10:01.67,Default,,0000,0000,0000,,Тамақты барлығы бірге бастау керек.
Dialogue: 0,0:10:01.67,0:10:06.17,Default,,0000,0000,0000,,Чилчак Лайос сыртта
Dialogue: 0,0:10:01.67,0:10:06.17,Default,,0000,0000,0000,,Маған қоңырау шалыңыз.
Dialogue: 0,0:10:01.67,0:10:06.17,Default,,0000,0000,0000,,Айо.
Dialogue: 0,0:10:06.17,0:10:10.38,Default,,0000,0000,0000,,Әй, өте жақсы...
Dialogue: 0,0:10:06.17,0:10:10.38,Default,,0000,0000,0000,,Шынымен, бұл жігіт пе?
Dialogue: 0,0:10:14.85,0:10:17.85,Default,,0000,0000,0000,,Енді барлығы жиналды.
Dialogue: 0,0:10:17.85,0:10:22.02,Default,,0000,0000,0000,,Ол Аня-чанның әкесі бола ма?
Dialogue: 0,0:10:17.85,0:10:22.02,Default,,0000,0000,0000,,Itadadakimasu.
Dialogue: 0,0:10:22.02,0:10:24.36,Default,,0000,0000,0000,,Бұл пудинг.
Dialogue: 0,0:10:24.36,0:10:27.36,Default,,0000,0000,0000,,Ах, кешіріңіз Марсиль.
Dialogue: 0,0:10:24.36,0:10:27.36,Default,,0000,0000,0000,,Дәмді.
Dialogue: 0,0:10:24.36,0:10:27.36,Default,,0000,0000,0000,,(Мұғалім) О, қандай жаһандық көзқарас. (Цубаки) 《Уф! Сол сұм~》
Dialogue: 0,0:10:27.36,0:10:30.86,Default,,0000,0000,0000,,《Бұл уақытты босқа кетіру》
Dialogue: 0,0:10:27.36,0:10:30.86,Default,,0000,0000,0000,,Сәлем Изуцуми.
Dialogue: 0,0:10:30.86,0:10:33.70,Default,,0000,0000,0000,,Не деген сұмдық!
Dialogue: 0,0:10:30.86,0:10:33.70,Default,,0000,0000,0000,,Мұны орындаңыз.
Dialogue: 0,0:10:33.70,0:10:37.20,Default,,0000,0000,0000,,Жыртылған дорбаны тіктіріп алдым.
Dialogue: 0,0:10:33.70,0:10:37.20,Default,,0000,0000,0000,,Сіз оны пайдалана аласыз.
Dialogue: 0,0:10:40.71,0:10:44.04,Default,,0000,0000,0000,,Мен бар күшімді салып, сол екі команданың ұпайларын жұлып аламын!
Dialogue: 0,0:10:40.71,0:10:44.04,Default,,0000,0000,0000,,Мен сені хайуан деп қателестім.
Dialogue: 0,0:10:44.04,0:10:46.71,Default,,0000,0000,0000,,Менің аузым нашар.
Dialogue: 0,0:10:46.71,0:10:49.38,Default,,0000,0000,0000,,Бейтаныс адамдармен
Dialogue: 0,0:10:46.71,0:10:49.38,Default,,0000,0000,0000,,Топтық әрекет➡
Dialogue: 0,0:10:49.38,0:10:52.05,Default,,0000,0000,0000,,Біраз уақыт тар болады.
Dialogue: 0,0:10:49.38,0:10:52.05,Default,,0000,0000,0000,,Менің ойымша, бұл тітіркендіргіш➡
Dialogue: 0,0:10:52.05,0:10:55.22,Default,,0000,0000,0000,,Үйреніп алғаннан кейін оның жақсы жақтары бар деп ойлаймын.
Dialogue: 0,0:10:55.22,0:10:57.72,Default,,0000,0000,0000,,Мен өз бетімше не істей алмаймын
Dialogue: 0,0:10:55.22,0:10:57.72,Default,,0000,0000,0000,,Сеніп тапсырылсын.
Dialogue: 0,0:11:02.66,0:11:06.00,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:11:06.00,0:11:10.10,Default,,0000,0000,0000,,Ас үшін рахмет!
Dialogue: 0,0:11:06.00,0:11:10.10,Default,,0000,0000,0000,,Мен жасадым...
Dialogue: 0,0:11:13.01,0:11:17.18,Default,,0000,0000,0000,,Эй, сен әлі сондасың ба?
Dialogue: 0,0:11:13.01,0:11:17.18,Default,,0000,0000,0000,,Тағы біраз күтіңіз.
Dialogue: 0,0:11:17.18,0:11:19.18,Default,,0000,0000,0000,,Осылайша...
Dialogue: 0,0:11:19.18,0:11:21.18,Default,,0000,0000,0000,,Жарайды!
Dialogue: 0,0:11:21.18,0:11:25.18,Default,,0000,0000,0000,,Джажан!
Dialogue: 0,0:11:25.18,0:11:29.02,Default,,0000,0000,0000,,Намаридің киімі жарасымды.
Dialogue: 0,0:11:25.18,0:11:29.02,Default,,0000,0000,0000,,Қозғалыстағы қиындық.
Dialogue: 0,0:11:29.02,0:11:31.36,Default,,0000,0000,0000,,Ені тарылту үшін біраз уақыт қажет болды.
Dialogue: 0,0:11:31.36,0:11:34.36,Default,,0000,0000,0000,,Бұл мүлдем суық.
Dialogue: 0,0:11:31.36,0:11:34.36,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:11:34.36,0:11:36.66,Default,,0000,0000,0000,,Олай болса кетейік.
Dialogue: 0,0:11:34.36,0:11:36.66,Default,,0000,0000,0000,,'Белдік менің денеме тартылып жатыр.'
Dialogue: 0,0:11:38.70,0:11:41.70,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:11:38.70,0:11:41.70,Default,,0000,0000,0000,,Тәтті қайнатылған мандрака.
Dialogue: 0,0:11:41.70,0:11:45.10,Default,,0000,0000,0000,,Жолда тасымалданатын тағамға жарай ма деп ойладым.
Dialogue: 0,0:11:47.87,0:11:50.38,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:11:47.87,0:11:50.38,Default,,0000,0000,0000,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:11:47.87,0:11:50.38,Default,,0000,0000,0000,,​​О?
Dialogue: 0,0:11:50.38,0:11:52.38,Default,,0000,0000,0000,,Жасаңыз.
Dialogue: 0,0:11:52.38,0:11:55.55,Default,,0000,0000,0000,,Бұл сізге арналған.
Dialogue: 0,0:11:55.55,0:11:58.22,Default,,0000,0000,0000,,Қажет емес.
Dialogue: 0,0:11:55.55,0:11:58.22,Default,,0000,0000,0000,,(Номудың айғайы)
Dialogue: 0,0:11:58.22,0:12:01.65,Default,,0000,0000,0000,,Бұл өте дәмді.
Dialogue: 0,0:11:58.22,0:12:01.65,Default,,0000,0000,0000,,Менің ойымша, бұл тітіркендіргіш.
Dialogue: 0,0:12:01.65,0:12:03.66,Default,,0000,0000,0000,,Жоқ, бір жұтым.
Dialogue: 0,0:12:03.66,0:12:05.66,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:12:03.66,0:12:05.66,Default,,0000,0000,0000,,Қараңыз.
Dialogue: 0,0:12:03.66,0:12:05.66,Default,,0000,0000,0000,,Бағдарлама коды…
Dialogue: 0,0:12:07.99,0:12:10.00,Default,,0000,0000,0000,,H Қорқынышты.
Dialogue: 0,0:12:10.00,0:12:12.16,Default,,0000,0000,0000,,Неліктен мұндай жағдайда?
Dialogue: 0,0:12:10.00,0:12:12.16,Default,,0000,0000,0000,,Қанның ағуы.
Dialogue: 0,0:12:12.16,0:12:15.33,Default,,0000,0000,0000,,Мені жалғыз қалдырыңыз
Dialogue: 0,0:12:12.16,0:12:15.33,Default,,0000,0000,0000,,Қарным ашса, жеймін.
Dialogue: 0,0:12:15.33,0:12:18.17,Default,,0000,0000,0000,,Неге тамақ жегің келмейді?
Dialogue: 0,0:12:18.17,0:12:20.84,Default,,0000,0000,0000,,Өйткені бұл құбыжық.
Dialogue: 0,0:12:18.17,0:12:20.84,Default,,0000,0000,0000,,Барлығы осылай дейді➡
Dialogue: 0,0:12:20.84,0:12:23.01,Default,,0000,0000,0000,,Жануарларды жеудің айырмашылығы неде?
Dialogue: 0,0:12:23.01,0:12:25.51,Default,,0000,0000,0000,,Егер сіз құбыжықты жесеңіз
Dialogue: 0,0:12:23.01,0:12:25.51,Default,,0000,0000,0000,,Менде біртүрлі ауру бар➡
Dialogue: 0,0:12:25.51,0:12:27.68,Default,,0000,0000,0000,,Құбыжыққа айналып барады, сондықтан маған ұнамайды!
Dialogue: 0,0:12:27.68,0:12:31.52,Default,,0000,0000,0000,,Құбыжықтарды жеу арқылы
Dialogue: 0,0:12:27.68,0:12:31.52,Default,,0000,0000,0000,,Құбыжық бола алсам, қиналмас едім.
Dialogue: 0,0:12:31.52,0:12:34.19,Default,,0000,0000,0000,,Жарайды, бұл арам сенім.
Dialogue: 0,0:12:34.19,0:12:36.52,Default,,0000,0000,0000,,Теориялық емес не?
Dialogue: 0,0:12:34.19,0:12:36.52,Default,,0000,0000,0000,,Мен білемін, бірақ➡
Dialogue: 0,0:12:36.52,0:12:40.03,Default,,0000,0000,0000,,Көптеген адамдар, соның ішінде мен
Dialogue: 0,0:12:36.52,0:12:40.03,Default,,0000,0000,0000,,Менің ойымша, бұл себеп.
Dialogue: 0,0:12:40.03,0:12:43.36,Default,,0000,0000,0000,,Қандай да бір жаман нәрсе
Dialogue: 0,0:12:40.03,0:12:43.36,Default,,0000,0000,0000,,Мен оны қабылдағым келеді.
Dialogue: 0,0:12:43.36,0:12:47.20,Default,,0000,0000,0000,,Адаммен тығыз байланысты тірі заттардан
Dialogue: 0,0:12:43.36,0:12:47.20,Default,,0000,0000,0000,,Жаңа аурулар пайда болуы мүмкін➡
Dialogue: 0,0:12:47.20,0:12:51.20,Default,,0000,0000,0000,,«Маған ұнамайды»
Dialogue: 0,0:12:47.20,0:12:51.20,Default,,0000,0000,0000,,Менің ойымша, сіз оны мазақ ете алмайсыз.
Dialogue: 0,0:12:53.37,0:12:56.04,Default,,0000,0000,0000,,Хмм, бұл дәмді.
Dialogue: 0,0:12:56.04,0:12:58.71,Default,,0000,0000,0000,,Көп нәрсе болды, бірақ ақыры өз орныңды тапқан сияқтысың.
Dialogue: 0,0:12:56.04,0:12:58.71,Default,,0000,0000,0000,,Сіз не істедіңіз?
Dialogue: 0,0:12:58.71,0:13:01.65,Default,,0000,0000,0000,,Өзіңізге ұнамайтын нәрсені жесеңіз ше?
Dialogue: 0,0:13:01.65,0:13:03.65,Default,,0000,0000,0000,,Осы уақытқа дейін...
Dialogue: 0,0:13:05.65,0:13:07.65,Default,,0000,0000,0000,,｟Біз….
Dialogue: 0,0:13:09.66,0:13:11.82,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:13:09.66,0:13:11.82,Default,,0000,0000,0000,,Таде мен оны саған беремін.
Dialogue: 0,0:13:11.82,0:13:15.66,Default,,0000,0000,0000,,Уау, рахмет саған Изу...
Dialogue: 0,0:13:11.82,0:13:15.66,Default,,0000,0000,0000,,Асеби-чан! ｠
Dialogue: 0,0:13:15.66,0:13:20.07,Default,,0000,0000,0000,,Шын мәнінде емес.
Dialogue: 0,0:13:15.66,0:13:20.07,Default,,0000,0000,0000,,Бұл өтірік.
Dialogue: 0,0:13:15.66,0:13:20.07,Default,,0000,0000,0000,,Екеуің кеттік.
Dialogue: 0,0:13:30.34,0:13:33.68,Default,,0000,0000,0000,,Қарлы боран
Dialogue: 0,0:13:30.34,0:13:33.68,Default,,0000,0000,0000,,Бұл сәйкес келмейтін сияқты.
Dialogue: 0,0:13:33.68,0:13:37.85,Default,,0000,0000,0000,,Бүгін осы жерде лагерь жасаймыз ба?
Dialogue: 0,0:13:33.68,0:13:37.85,Default,,0000,0000,0000,,Менің де қарным ашты.
Dialogue: 0,0:13:37.85,0:13:42.69,Default,,0000,0000,0000,,Сенші де шаршаған сияқты.
Dialogue: 0,0:13:37.85,0:13:42.69,Default,,0000,0000,0000,,Тамақты дайындаймыз ба?
Dialogue: 0,0:13:42.69,0:13:44.69,Default,,0000,0000,0000,,Ингредиенттер Не қалды?
Dialogue: 0,0:13:44.69,0:13:49.36,Default,,0000,0000,0000,,Қошмар және Мандраке
Dialogue: 0,0:13:44.69,0:13:49.36,Default,,0000,0000,0000,,Жұмыртқа мен саңырауқұлақ... Бұл не?
Dialogue: 0,0:13:49.36,0:13:52.03,Default,,0000,0000,0000,,Балық ше?
Dialogue: 0,0:13:49.36,0:13:52.03,Default,,0000,0000,0000,,Енді балық жоқ.
Dialogue: 0,0:13:52.03,0:13:56.20,Default,,0000,0000,0000,,Сонда күріш!
Dialogue: 0,0:13:52.03,0:13:56.20,Default,,0000,0000,0000,,Күріш өте көп
Dialogue: 0,0:13:52.03,0:13:56.20,Default,,0000,0000,0000,,Ешқайсысы қалмады.
Dialogue: 0,0:13:56.20,0:13:58.70,Default,,0000,0000,0000,,Одан жақсысы бар емес пе?
Dialogue: 0,0:13:58.70,0:14:01.97,Default,,0000,0000,0000,,Барлығы осы.
Dialogue: 0,0:13:58.70,0:14:01.97,Default,,0000,0000,0000,,Өтірікші! Сіз оны жасырып жатырсыз!
Dialogue: 0,0:14:01.97,0:14:06.65,Default,,0000,0000,0000,,Сіз лабиринттегі тағамға талғампаз бола алмайсыз.
Dialogue: 0,0:14:01.97,0:14:06.65,Default,,0000,0000,0000,,Тез үйреніп алғаныңыз жөн.
Dialogue: 0,0:14:06.65,0:14:09.32,Default,,0000,0000,0000,,Мен оны жек көремін!
Dialogue: 0,0:14:06.65,0:14:09.32,Default,,0000,0000,0000,,Мен тек қалағанымды жеймін!
Dialogue: 0,0:14:09.32,0:14:13.32,Default,,0000,0000,0000,,Эй, Изицуми, құбыжықтарды же.
Dialogue: 0,0:14:09.32,0:14:13.32,Default,,0000,0000,0000,,Сіз құбыжық бола алмайсыз.
Dialogue: 0,0:14:13.32,0:14:17.32,Default,,0000,0000,0000,,Қой мен шошқа жеген адам
Dialogue: 0,0:14:13.32,0:14:17.32,Default,,0000,0000,0000,,Қойға немесе шошқаға айналдың ба?
Dialogue: 0,0:14:17.32,0:14:21.16,Default,,0000,0000,0000,,Көру қабілетінен айырылғандар
Dialogue: 0,0:14:17.32,0:14:21.16,Default,,0000,0000,0000,,Көз алмасын жесем, сауығып кетемін бе?
Dialogue: 0,0:14:21.16,0:14:24.33,Default,,0000,0000,0000,,Қой тек өсімдіктерді жейді, бірақ
Dialogue: 0,0:14:21.16,0:14:24.33,Default,,0000,0000,0000,,Ол өсімдікке айнала ма?
Dialogue: 0,0:14:24.33,0:14:27.83,Default,,0000,0000,0000,,Тамақтану және тамақтану
Dialogue: 0,0:14:24.33,0:14:27.83,Default,,0000,0000,0000,,Бұл оңай емес.
Dialogue: 0,0:14:27.83,0:14:30.67,Default,,0000,0000,0000,,Сондықтан адамдар күреседі
Dialogue: 0,0:14:27.83,0:14:30.67,Default,,0000,0000,0000,,Бұл сынақ және қате.
Dialogue: 0,0:14:30.67,0:14:33.84,Default,,0000,0000,0000,,Шулы Шулы!
Dialogue: 0,0:14:30.67,0:14:33.84,Default,,0000,0000,0000,,Сонда бұл не? ?
Dialogue: 0,0:14:33.84,0:14:35.84,Default,,0000,0000,0000,,22 мамыр: Біз Аоямада бір-бірімізге дәптерлерімізді көрсетеміз.
Dialogue: 0,0:14:39.18,0:14:41.51,Default,,0000,0000,0000,,Қой ағашқа айналып барады...
Dialogue: 0,0:14:41.51,0:14:43.52,Default,,0000,0000,0000,,Баромец.
Dialogue: 0,0:14:43.52,0:14:45.85,Default,,0000,0000,0000,,Ештеңе
Dialogue: 0,0:14:43.52,0:14:45.85,Default,,0000,0000,0000,,Тіпті мұндай уақытта көрсетілмесе де.
Dialogue: 0,0:14:45.85,0:14:48.52,Default,,0000,0000,0000,,Ал, Изицуми, бұл бастапқыда➡ болды
Dialogue: 0,0:14:48.52,0:14:51.69,Default,,0000,0000,0000,,Мұндай өсімдік...
Dialogue: 0,0:14:48.52,0:14:51.69,Default,,0000,0000,0000,,Аузыңды жап! Саған сенуден шаршадым!
Dialogue: 0,0:14:51.69,0:14:54.69,Default,,0000,0000,0000,,Жетер, мен анау қойды ұстаймын.
Dialogue: 0,0:14:54.69,0:14:57.03,Default,,0000,0000,0000,,Баромец дегеніміз не? Бұл құбыжық па?
Dialogue: 0,0:14:57.03,0:15:00.97,Default,,0000,0000,0000,,Оның құбыжық екені даусыз.
Dialogue: 0,0:14:57.03,0:15:00.97,Default,,0000,0000,0000,,Ешқандай зияны жоқ. Дегенмен➡
Dialogue: 0,0:15:00.97,0:15:04.30,Default,,0000,0000,0000,,Баромецті іздеу
Dialogue: 0,0:15:00.97,0:15:04.30,Default,,0000,0000,0000,,Мұнда жыртқыш аңдар жиналады.
Dialogue: 0,0:15:04.30,0:15:08.01,Default,,0000,0000,0000,,Сау бол, Изуцуми.
Dialogue: 0,0:15:04.30,0:15:08.01,Default,,0000,0000,0000,,《Кімге...》
Dialogue: 0,0:15:11.14,0:15:14.48,Default,,0000,0000,0000,,Тым ұзақ тұру қауіпті
Dialogue: 0,0:15:11.14,0:15:14.48,Default,,0000,0000,0000,,Егінді тез жинаңыз...
Dialogue: 0,0:15:11.14,0:15:14.48,Default,,0000,0000,0000,,келді.
Dialogue: 0,0:15:14.48,0:15:16.48,Default,,0000,0000,0000,,(Мұғалім) О, қандай жаһандық көзқарас. (Цубаки) 《Уф! Сол сұм~》
Dialogue: 0,0:15:19.49,0:15:21.82,Default,,0000,0000,0000,,Бұл жаман қасқыр!
Dialogue: 0,0:15:21.82,0:15:24.49,Default,,0000,0000,0000,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:15:24.49,0:15:26.83,Default,,0000,0000,0000,,Hmph.
Dialogue: 0,0:15:24.49,0:15:26.83,Default,,0000,0000,0000,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:15:26.83,0:15:28.83,Default,,0000,0000,0000,,Ах... бір таяқ....
Dialogue: 0,0:15:28.83,0:15:30.83,Default,,0000,0000,0000,,А... а... а?
Dialogue: 0,0:15:33.50,0:15:36.50,Default,,0000,0000,0000,,Бір минут күтіңіз! Қайда бара жатырсың?
Dialogue: 0,0:15:36.50,0:15:40.01,Default,,0000,0000,0000,,Мен иттерді жек көремін.
Dialogue: 0,0:15:36.50,0:15:40.01,Default,,0000,0000,0000,,Сасық, шулы және тұрақты.
Dialogue: 0,0:15:40.01,0:15:43.18,Default,,0000,0000,0000,,Міне.
Dialogue: 0,0:15:40.01,0:15:43.18,Default,,0000,0000,0000,,Неліктен біз өзіміз қалағандай әрекет етеміз?
Dialogue: 0,0:15:43.18,0:15:45.51,Default,,0000,0000,0000,,Иә? -Мен саған қалдырдым.
Dialogue: 0,0:15:45.51,0:15:47.68,Default,,0000,0000,0000,,Күшті жақтары Әлсіз жақтардың орнын толтыру ➡
Dialogue: 0,0:15:47.68,0:15:50.52,Default,,0000,0000,0000,,Менің ойымша, бұл сіз «достар» деп атайды.
Dialogue: 0,0:15:47.68,0:15:50.52,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:15:50.52,0:15:53.02,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,0:15:50.52,0:15:53.02,Default,,0000,0000,0000,,Менің айтқым келгені бұл емес.
Dialogue: 0,0:15:53.02,0:15:57.02,Default,,0000,0000,0000,,Не! ? Бұл голем болғанда
Dialogue: 0,0:15:53.02,0:15:57.02,Default,,0000,0000,0000,,Сіз де төбелескен жоқсыз.
Dialogue: 0,0:15:57.02,0:15:59.69,Default,,0000,0000,0000,,әрине
Dialogue: 0,0:15:57.02,0:15:59.69,Default,,0000,0000,0000,,Мен сізге сол кезде қалдырдым➡
Dialogue: 0,0:15:59.69,0:16:01.79,Default,,0000,0000,0000,,Маған ұнамайды немесе ұнамайды...
Dialogue: 0,0:16:01.79,0:16:04.80,Default,,0000,0000,0000,,Эй, қайтып келші?
Dialogue: 0,0:16:04.80,0:16:06.80,Default,,0000,0000,0000,,Мүмкін емес.
Dialogue: 0,0:16:06.80,0:16:08.97,Default,,0000,0000,0000,,《Желден оттың иісін сеземін.
Dialogue: 0,0:16:08.97,0:16:11.97,Default,,0000,0000,0000,,Егер сіз жолды ұстансаңыз, алдыңғы орынға оралуға болады.
Dialogue: 0,0:16:11.97,0:16:13.97,Default,,0000,0000,0000,,О, күте тұрыңыз.
Dialogue: 0,0:16:15.98,0:16:20.48,Default,,0000,0000,0000,,《Оң жақта иіс күштірек...бірақ
Dialogue: 0,0:16:15.98,0:16:20.48,Default,,0000,0000,0000,,Жол нашар, мұнда кел.
Dialogue: 0,0:16:20.48,0:16:22.82,Default,,0000,0000,0000,,Осы жолы сен жұмсаған күшіңе сай нәтижеге қол жеткіздің—
Dialogue: 0,0:16:20.48,0:16:22.82,Default,,0000,0000,0000,,Бұл дұрыс жол ма?
Dialogue: 0,0:16:22.82,0:16:27.32,Default,,0000,0000,0000,,Мен өзіме ұнайтын жолды таңдаймын.
Dialogue: 0,0:16:22.82,0:16:27.32,Default,,0000,0000,0000,,Сіз де солай істеуіңіз керек.
Dialogue: 0,0:16:27.32,0:16:30.16,Default,,0000,0000,0000,,Неліктен көбірек?
Dialogue: 0,0:16:27.32,0:16:30.16,Default,,0000,0000,0000,,Неге өзіңе ұнайтын іспен айналыспасқа?
Dialogue: 0,0:16:30.16,0:16:34.16,Default,,0000,0000,0000,,Тіпті құбыжық тағам
Dialogue: 0,0:16:30.16,0:16:34.16,Default,,0000,0000,0000,,Сіз оны сондай құлықсыз жейсіз.
Dialogue: 0,0:16:34.16,0:16:37.66,Default,,0000,0000,0000,,Мен түсінбеймін.
Dialogue: 0,0:16:34.16,0:16:37.66,Default,,0000,0000,0000,,А... бұл...
Dialogue: 0,0:16:37.66,0:16:39.67,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:16:37.66,0:16:39.67,Default,,0000,0000,0000,,(қабығы)
Dialogue: 0,0:16:39.67,0:16:43.00,Default,,0000,0000,0000,,Бізді қасқыр қуып келе жатқан сияқты.
Dialogue: 0,0:16:39.67,0:16:43.00,Default,,0000,0000,0000,,Сіз мені осы жерде ұстайсыз ба?
Dialogue: 0,0:16:39.67,0:16:43.00,Default,,0000,0000,0000,,(қабығы)
Dialogue: 0,0:16:43.00,0:16:47.17,Default,,0000,0000,0000,,Мен жарылыс сиқырын қолдана аламын, бірақ
Dialogue: 0,0:16:43.00,0:16:47.17,Default,,0000,0000,0000,,А, менде қазір таяқ жоқ.
Dialogue: 0,0:16:43.00,0:16:47.17,Default,,0000,0000,0000,,(қабығы)
Dialogue: 0,0:16:47.17,0:16:49.17,Default,,0000,0000,0000,,Мұндай шағын кеңістікте қауіпті.
Dialogue: 0,0:16:47.17,0:16:49.17,Default,,0000,0000,0000,,(қабығы)
Dialogue: 0,0:16:49.17,0:16:51.68,Default,,0000,0000,0000,,Күшті жарықпен естен тану әдісі де бар.
Dialogue: 0,0:16:49.17,0:16:51.68,Default,,0000,0000,0000,,(қабығы)
Dialogue: 0,0:16:51.68,0:16:53.68,Default,,0000,0000,0000,,Жүгіру.
Dialogue: 0,0:16:51.68,0:16:53.68,Default,,0000,0000,0000,,(қабығы)
Dialogue: 0,0:16:53.68,0:16:56.68,Default,,0000,0000,0000,,(қабығы)
Dialogue: 0,0:16:56.68,0:16:59.08,Default,,0000,0000,0000,,Ех! ?
Dialogue: 0,0:17:02.96,0:17:06.56,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:17:13.13,0:17:16.97,Default,,0000,0000,0000,,｟Таде: Айта!
Dialogue: 0,0:17:13.13,0:17:16.97,Default,,0000,0000,0000,,(құлау дыбысы)
Dialogue: 0,0:17:16.97,0:17:19.14,Default,,0000,0000,0000,,тармақ.
Dialogue: 0,0:17:19.14,0:17:22.14,Default,,0000,0000,0000,,тармақ….
Dialogue: 0,0:17:22.14,0:17:24.48,Default,,0000,0000,0000,,Әй, кола, Әсеби!
Dialogue: 0,0:17:24.48,0:17:28.81,Default,,0000,0000,0000,,Сен дайындық залындағы қарды тазалайсың.
Dialogue: 0,0:17:24.48,0:17:28.81,Default,,0000,0000,0000,,Сіз оны Тадқа қарсы итеріп жібердіңіз.
Dialogue: 0,0:17:28.81,0:17:31.15,Default,,0000,0000,0000,,Жоқ.
Dialogue: 0,0:17:28.81,0:17:31.15,Default,,0000,0000,0000,,Өтірікші!
Dialogue: 0,0:17:31.15,0:17:33.32,Default,,0000,0000,0000,,Сондықтан ол төбесінен құлады.
Dialogue: 0,0:17:33.32,0:17:35.82,Default,,0000,0000,0000,,Сізге ұқсамайды
Dialogue: 0,0:17:33.32,0:17:35.82,Default,,0000,0000,0000,,Әлгі жігіт ақымақ➡
Dialogue: 0,0:17:35.82,0:17:38.16,Default,,0000,0000,0000,,Өзіңізге ұнамайтын жұмысқа өзіңізді мәжбүрлемеңіз!
Dialogue: 0,0:17:38.16,0:17:42.49,Default,,0000,0000,0000,,Мен сізді алып кеткеніңіз үшін өтей алмаймын деп ойлаймын.
Dialogue: 0,0:17:42.49,0:17:44.50,Default,,0000,0000,0000,,Бах.
Dialogue: 0,0:17:44.50,0:17:46.83,Default,,0000,0000,0000,,Сәлем Таде.
Dialogue: 0,0:17:44.50,0:17:46.83,Default,,0000,0000,0000,,​​О?
Dialogue: 0,0:17:46.83,0:17:50.50,Default,,0000,0000,0000,,Мен сенен талап етпеген нәрсені неге істедің?
Dialogue: 0,0:17:46.83,0:17:50.50,Default,,0000,0000,0000,,Бұл шынымен ақымақтық.
Dialogue: 0,0:17:50.50,0:17:54.51,Default,,0000,0000,0000,,Бірақ... Таде...｠
Dialogue: 0,0:17:54.51,0:17:58.01,Default,,0000,0000,0000,,《Сол кезде
Dialogue: 0,0:17:54.51,0:17:58.01,Default,,0000,0000,0000,,Ол не деді?
Dialogue: 0,0:17:58.01,0:18:00.01,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:18:03.28,0:18:05.28,Default,,0000,0000,0000,,Не!
Dialogue: 0,0:18:05.28,0:18:07.29,Default,,0000,0000,0000,,《Болды...
Dialogue: 0,0:18:07.29,0:18:10.62,Default,,0000,0000,0000,,Жарылыс желдің бағытын өзгертті.
Dialogue: 0,0:18:07.29,0:18:10.62,Default,,0000,0000,0000,,Мен байқамадым》
Dialogue: 0,0:18:10.62,0:18:12.62,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:18:12.62,0:18:14.79,Default,,0000,0000,0000,,Уф! Уау...
Dialogue: 0,0:18:14.79,0:18:18.30,Default,,0000,0000,0000,,Бір… көзге… соқты.
Dialogue: 0,0:18:18.30,0:18:21.13,Default,,0000,0000,0000,,Көзіңді жұмы...
Dialogue: 0,0:18:21.13,0:18:23.34,Default,,0000,0000,0000,,Оны ұсақтаңыз!
Dialogue: 0,0:18:30.98,0:18:32.98,Default,,0000,0000,0000,,Чи… чика….
Dialogue: 0,0:18:32.98,0:18:36.48,Default,,0000,0000,0000,,Ммм… Ммм….
Dialogue: 0,0:18:36.48,0:18:40.15,Default,,0000,0000,0000,,Уау! Апыр-ай...!
Dialogue: 0,0:18:36.48,0:18:40.15,Default,,0000,0000,0000,,Кун….
Dialogue: 0,0:18:40.15,0:18:42.65,Default,,0000,0000,0000,,Хмм... Изцуми!
Dialogue: 0,0:18:42.65,0:18:44.66,Default,,0000,0000,0000,,А... ол тірі! ?
Dialogue: 0,0:18:44.66,0:18:47.83,Default,,0000,0000,0000,,(Химецудзима) Жәбірленген-ай… Қандай әлсіз, аянышты бала.
Dialogue: 0,0:18:44.66,0:18:47.83,Default,,0000,0000,0000,,А, қолың сынған.
Dialogue: 0,0:18:47.83,0:18:50.63,Default,,0000,0000,0000,,Сіз жүре аласыз ба? Барлығымен кездесейік.
Dialogue: 0,0:18:57.50,0:18:59.51,Default,,0000,0000,0000,,Сіз білесіз.
Dialogue: 0,0:18:57.50,0:18:59.51,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:18:59.51,0:19:02.77,Default,,0000,0000,0000,,Неліктен құбыжықтарды жейсің?
Dialogue: 0,0:18:59.51,0:19:02.77,Default,,0000,0000,0000,,Сіз мұны естідіңіз.
Dialogue: 0,0:19:02.77,0:19:07.45,Default,,0000,0000,0000,,Мен бұл туралы біраз уақыт ойладым.
Dialogue: 0,0:19:02.77,0:19:07.45,Default,,0000,0000,0000,,Менің мақсаттарым мен міндеттерім бар.
Dialogue: 0,0:19:07.45,0:19:12.62,Default,,0000,0000,0000,,Досыңызға көмектескіңіз келе ме?
Dialogue: 0,0:19:07.45,0:19:12.62,Default,,0000,0000,0000,,Сиқыр туралы көбірек білгіңіз келе ме?
Dialogue: 0,0:19:12.62,0:19:15.79,Default,,0000,0000,0000,,! мақсатқа қарай
Dialogue: 0,0:19:12.62,0:19:15.79,Default,,0000,0000,0000,,Мен алға жылжамын➡
Dialogue: 0,0:19:15.79,0:19:18.79,Default,,0000,0000,0000,,Ақырында
Dialogue: 0,0:19:15.79,0:19:18.79,Default,,0000,0000,0000,,Мен көптеген жағымсыз нәрселерге тап боламын.
Dialogue: 0,0:19:18.79,0:19:21.29,Default,,0000,0000,0000,,Мазасыздық немесе шаршау➡
Dialogue: 0,0:19:21.29,0:19:24.13,Default,,0000,0000,0000,,Мен жек көретін нәрселер
Dialogue: 0,0:19:21.29,0:19:24.13,Default,,0000,0000,0000,,Мен тамақ ішуім керек.
Dialogue: 0,0:19:24.13,0:19:27.80,Default,,0000,0000,0000,,Әрқайсысы үлкен мәселе емес.
Dialogue: 0,0:19:24.13,0:19:27.80,Default,,0000,0000,0000,,Бірақ➡
Dialogue: 0,0:19:27.80,0:19:30.47,Default,,0000,0000,0000,,Мен жек көретін нәрселердің бәрі
Dialogue: 0,0:19:27.80,0:19:30.47,Default,,0000,0000,0000,,Одан аулақ болсаңыз➡
Dialogue: 0,0:19:30.47,0:19:33.81,Default,,0000,0000,0000,,Көбірек жолдар
Dialogue: 0,0:19:30.47,0:19:33.81,Default,,0000,0000,0000,,Бұл алысқа барады... иә?
Dialogue: 0,0:19:33.81,0:19:37.31,Default,,0000,0000,0000,,Дәл қазір біз сияқты.
Dialogue: 0,0:19:37.31,0:19:41.31,Default,,0000,0000,0000,,Неліктен Изуцуми?
Dialogue: 0,0:19:37.31,0:19:41.31,Default,,0000,0000,0000,,Артымыздан келе жатыр ма деп ойлаймын.
Dialogue: 0,0:19:41.31,0:19:44.65,Default,,0000,0000,0000,,Сізге қарғысты бұзу үшін
Dialogue: 0,0:19:41.31,0:19:44.65,Default,,0000,0000,0000,,Сіз ашуланған Нантоканы кездестірген кезде➡
Dialogue: 0,0:19:44.65,0:19:48.15,Default,,0000,0000,0000,,Мүмкін болатын шығар
Dialogue: 0,0:19:44.65,0:19:48.15,Default,,0000,0000,0000,,Өйткені мен солай айтамын! Бұл осылай!
Dialogue: 0,0:19:48.15,0:19:53.06,Default,,0000,0000,0000,,Иә, солай
Dialogue: 0,0:19:48.15,0:19:53.06,Default,,0000,0000,0000,,Сіз «төте жолдарға» дайын болуыңыз керек.
Dialogue: 0,0:19:58.33,0:20:02.67,Default,,0000,0000,0000,,Ах... Изцуми! Марсиль!
Dialogue: 0,0:19:58.33,0:20:02.67,Default,,0000,0000,0000,,Жақсы болды ма?
Dialogue: 0,0:20:02.67,0:20:05.00,Default,,0000,0000,0000,,Барлығы жақсы болды ма?
Dialogue: 0,0:20:05.00,0:20:07.34,Default,,0000,0000,0000,,Мұның бәрі жақсы болған жоқ➡
Dialogue: 0,0:20:07.34,0:20:10.84,Default,,0000,0000,0000,,Лайостың қорқытуының арқасында бәрі ойдағыдай өтті.
Dialogue: 0,0:20:10.84,0:20:14.01,Default,,0000,0000,0000,,Қасқырлардың көпшілігі
Dialogue: 0,0:20:10.84,0:20:14.01,Default,,0000,0000,0000,,Өйткені мен Марсильдің соңынан ердім.
Dialogue: 0,0:20:14.01,0:20:17.85,Default,,0000,0000,0000,,Жарыс басталмас бұрын Қвиркіңді қолданба! Өзіңді шаршатпа!
Dialogue: 0,0:20:14.01,0:20:17.85,Default,,0000,0000,0000,,Қолыңды сындырып алған сияқтысың.
Dialogue: 0,0:20:17.85,0:20:22.19,Default,,0000,0000,0000,,Бастапқы қалыпқа оралу кезінде
Dialogue: 0,0:20:17.85,0:20:22.19,Default,,0000,0000,0000,,Маған қалпына келтіру заклинаниясын жасауға көмектесіңіз.
Dialogue: 0,0:20:22.19,0:20:24.19,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:20:24.19,0:20:27.53,Default,,0000,0000,0000,,Фугия!
Dialogue: 0,0:20:27.53,0:20:32.36,Default,,0000,0000,0000,,Сіз тамаша жұмыс жасадыңыз.
Dialogue: 0,0:20:27.53,0:20:32.36,Default,,0000,0000,0000,,Қалпына келтіру сиқыры көбірек ауырады.
Dialogue: 0,0:20:32.36,0:20:34.87,Default,,0000,0000,0000,,Мен Баромецті жинағым келді, бірақ➡
Dialogue: 0,0:20:34.87,0:20:37.54,Default,,0000,0000,0000,,Ересек қойлар қасқыр
Dialogue: 0,0:20:34.87,0:20:37.54,Default,,0000,0000,0000,,Мен оны өзіммен бірге үйге апардым.
Dialogue: 0,0:20:37.54,0:20:41.71,Default,,0000,0000,0000,,Қалғаны болды
Dialogue: 0,0:20:37.54,0:20:41.71,Default,,0000,0000,0000,,Бұл піспеген жеміс...
Dialogue: 0,0:20:41.71,0:20:44.11,Default,,0000,0000,0000,,Тамақ жасап көрейін бе?
Dialogue: 0,0:20:50.05,0:20:52.05,Default,,0000,0000,0000,,Кейін қалсаң, капитан мені сөгіп тастайды.
Dialogue: 0,0:20:52.05,0:20:55.22,Default,,0000,0000,0000,,Көкөністерде қой бар.
Dialogue: 0,0:20:52.05,0:20:55.22,Default,,0000,0000,0000,,Уау, бұл мүмкін емес!
Dialogue: 0,0:20:55.22,0:20:58.89,Default,,0000,0000,0000,,Бұрынғыдан басқа бағытта
Dialogue: 0,0:20:55.22,0:20:58.89,Default,,0000,0000,0000,,Этикалық тұрғыдан мүмкін емес!
Dialogue: 0,0:20:55.22,0:20:58.89,Default,,0000,0000,0000,,Oe.
Dialogue: 0,0:20:58.89,0:21:02.66,Default,,0000,0000,0000,,《Баромецтің қабырғалары
Dialogue: 0,0:20:58.89,0:21:02.66,Default,,0000,0000,0000,,Сәйкес өлшемге кесіңіз➡
Dialogue: 0,0:21:02.66,0:21:05.16,Default,,0000,0000,0000,,Жыл мезгілі және жылу.
Dialogue: 0,0:21:05.16,0:21:07.83,Default,,0000,0000,0000,,Екі жағынан
Dialogue: 0,0:21:05.16,0:21:07.83,Default,,0000,0000,0000,,Әдемі қоңыр түсті алған соң➡
Dialogue: 0,0:21:07.83,0:21:11.84,Default,,0000,0000,0000,,Шарап қосыңыз
Dialogue: 0,0:21:07.83,0:21:11.84,Default,,0000,0000,0000,,Қақпақ және бу.
Dialogue: 0,0:21:11.84,0:21:17.18,Default,,0000,0000,0000,,Қабық бөлігі ыстық суға малынғаннан кейін
Dialogue: 0,0:21:11.84,0:21:17.18,Default,,0000,0000,0000,,Теріні аршып, кесектерге кесіңіз.
Dialogue: 0,0:21:17.18,0:21:20.01,Default,,0000,0000,0000,,Сарымсақ қосып, бірге қайнатыңыз.
Dialogue: 0,0:21:20.01,0:21:23.85,Default,,0000,0000,0000,,Дайын тұздық
Dialogue: 0,0:21:20.01,0:21:23.85,Default,,0000,0000,0000,,Бұрынғы етпен араластырсаңыз...》
Dialogue: 0,0:21:23.85,0:21:25.85,Default,,0000,0000,0000,,Ол аяқталды!
Dialogue: 0,0:21:27.85,0:21:31.36,Default,,0000,0000,0000,,Қараңыз.
Dialogue: 0,0:21:27.85,0:21:31.36,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:21:27.85,0:21:31.36,Default,,0000,0000,0000,,Мысық қыз Бұл сенікі.
Dialogue: 0,0:21:31.36,0:21:36.86,Default,,0000,0000,0000,,Біртүрлі нәрселер араласқан.
Dialogue: 0,0:21:31.36,0:21:36.86,Default,,0000,0000,0000,,Баромец жемісінің қабығы мен жас бүршіктері.
Dialogue: 0,0:21:38.86,0:21:41.17,Default,,0000,0000,0000,,Егер сіз жай ғана етті гриль жасай алсаңыз.
Dialogue: 0,0:21:38.86,0:21:41.17,Default,,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:21:43.70,0:21:45.70,Default,,0000,0000,0000,,Ахх.
Dialogue: 0,0:21:48.71,0:21:51.88,Default,,0000,0000,0000,,Баромец қойға ұқсайды➡
Dialogue: 0,0:21:51.88,0:21:55.55,Default,,0000,0000,0000,,Дәмі краб сияқты!
Dialogue: 0,0:21:51.88,0:21:55.55,Default,,0000,0000,0000,,《Бұл не?》
Dialogue: 0,0:21:55.55,0:21:59.89,Default,,0000,0000,0000,,《Дәмді... Сондай дәмді тағам
Dialogue: 0,0:21:55.55,0:21:59.89,Default,,0000,0000,0000,,Оның бар екендігі.
Dialogue: 0,0:21:59.89,0:22:02.32,Default,,0000,0000,0000,,Енді мен бұл туралы ойласам…》
Dialogue: 0,0:22:02.32,0:22:06.66,Default,,0000,0000,0000,,｟Таде, сен неге?
Dialogue: 0,0:22:02.32,0:22:06.66,Default,,0000,0000,0000,,Мен сенен сұрамаған нәрсені жасадым.
Dialogue: 0,0:22:06.66,0:22:08.99,Default,,0000,0000,0000,,Бұл шынымен ақымақтық.
Dialogue: 0,0:22:08.99,0:22:14.00,Default,,0000,0000,0000,,Көпбұрыш әділ
Dialogue: 0,0:22:08.99,0:22:14.00,Default,,0000,0000,0000,,Мен сізге көмектесе аламын деп үміттенемін...
Dialogue: 0,0:22:14.00,0:22:17.00,Default,,0000,0000,0000,,Міне. Өйткені бұл тамаша жер!
Dialogue: 0,0:22:17.00,0:22:21.01,Default,,0000,0000,0000,,3 мезгіл тамақ, жылы футон
Dialogue: 0,0:22:17.00,0:22:21.01,Default,,0000,0000,0000,,Сондай-ақ ваннаны қабылдауға болады.
Dialogue: 0,0:22:21.01,0:22:23.84,Default,,0000,0000,0000,,Мені қуып жіберуге амал жоқ
Dialogue: 0,0:22:21.01,0:22:23.84,Default,,0000,0000,0000,,Мен бармаймын.
Dialogue: 0,0:22:23.84,0:22:26.51,Default,,0000,0000,0000,,Үй шаруасын немесе кез келген нәрсені жасаңыз.
Dialogue: 0,0:22:23.84,0:22:26.51,Default,,0000,0000,0000,,Мен оны сатуым керек!
Dialogue: 0,0:22:26.51,0:22:30.02,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:22:26.51,0:22:30.02,Default,,0000,0000,0000,,Асеби-чан.
Dialogue: 0,0:22:30.02,0:22:33.62,Default,,0000,0000,0000,,Кішкене қиындыққа бой алдыру
Dialogue: 0,0:22:30.02,0:22:33.62,Default,,0000,0000,0000,,Жоғалмаңыз.
Dialogue: 0,0:22:36.36,0:22:40.19,Default,,0000,0000,0000,,Сонымен қатар, кейде Майзуру-сама
Dialogue: 0,0:22:36.36,0:22:40.19,Default,,0000,0000,0000,,Олар сізге сыйлық ретінде тәттілер береді.
Dialogue: 0,0:22:40.19,0:22:42.53,Default,,0000,0000,0000,,Ақырында, сіз осыны мақсат етіп отырсыз ба?｠
Dialogue: 0,0:22:42.53,0:22:45.20,Default,,0000,0000,0000,,《Дәл өзі айтқандай➡
Dialogue: 0,0:22:45.20,0:22:48.37,Default,,0000,0000,0000,,Кейде маған дәмді ойлар келеді
Dialogue: 0,0:22:45.20,0:22:48.37,Default,,0000,0000,0000,,Кейде солай дейсің бе?》
Dialogue: 0,0:22:48.37,0:22:50.37,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:22:52.37,0:22:54.87,Default,,0000,0000,0000,,Керемет, тамаша ~ Изуцуми.
Dialogue: 0,0:22:54.87,0:22:57.04,Default,,0000,0000,0000,,Сіз қолыңыздан келгеннің бәрін жасадыңыз! Сен жақсы қызсың.
Dialogue: 0,0:22:54.87,0:22:57.04,Default,,0000,0000,0000,,Жарайды, жарайды.
Dialogue: 0,0:22:57.04,0:23:00.65,Default,,0000,0000,0000,,Тоқтаңдар... балалар... адамдармен не істеп жатырсыңдар?
Dialogue: 0,0:23:00.65,0:23:02.98,Default,,0000,0000,0000,,Мен солай ойладым!
Dialogue: 0,0:23:02.98,0:23:05.48,Default,,0000,0000,0000,,Басқа жол болмаған кезде ғана!
Dialogue: 0,0:23:05.48,0:23:08.32,Default,,0000,0000,0000,,Болашақта жаман көкөністер де, құбыжықтар да болмайды.
Dialogue: 0,0:23:05.48,0:23:08.32,Default,,0000,0000,0000,,Себебі мен оны жемеймін!
Dialogue: 0,0:23:08.32,0:23:11.66,Default,,0000,0000,0000,,Жаман ба, жоқ па?
Dialogue: 0,0:23:08.32,0:23:11.66,Default,,0000,0000,0000,,Оны жемейінше білмейсің.
Dialogue: 0,0:23:11.66,0:23:15.16,Default,,0000,0000,0000,,Айтпақшы, Марсильдің тұтылуы да алға басып жатқан жоқ.
Dialogue: 0,0:23:11.66,0:23:15.16,Default,,0000,0000,0000,,Уф.
Dialogue: 0,0:23:15.16,0:23:17.50,Default,,0000,0000,0000,,Мақтаныш
Dialogue: 0,0:23:15.16,0:23:17.50,Default,,0000,0000,0000,,Дәріс оқыды➡
Dialogue: 0,0:23:17.50,0:23:20.50,Default,,0000,0000,0000,,Мен қашуға тырысамын ба?
Dialogue: 0,0:23:17.50,0:23:20.50,Default,,0000,0000,0000,,Ух... у...
Dialogue: 0,0:23:20.50,0:23:25.50,Default,,0000,0000,0000,,<Қашу жолын өзім жауып тастадым.
Dialogue: 0,0:23:20.50,0:23:25.50,Default,,0000,0000,0000,,Марсиль қатты өкінді.
Dialogue: 0,0:23:25.50,0:23:29.61,Default,,0000,0000,0000,,Зиндан тағамы Ah Dungeon Meal＞
Dialogue: 0,0:23:31.11,0:23:37.11,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory