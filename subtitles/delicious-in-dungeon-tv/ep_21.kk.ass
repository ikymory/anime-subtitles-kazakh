Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:34.03,0:01:36.36,Default,,0000,0000,0000,,Мен үйдемін!
Dialogue: 0,0:01:36.36,0:01:39.20,Default,,0000,0000,0000,,Ойлағанымдай,
Dialogue: 0,0:01:36.36,0:01:39.20,Default,,0000,0000,0000,,Жер үстіндегі ауа ең жақсы.
Dialogue: 0,0:01:39.20,0:01:41.37,Default,,0000,0000,0000,,Бұл таң ба? кеш?
Dialogue: 0,0:01:41.37,0:01:44.54,Default,,0000,0000,0000,,Терезені әлі ұстамаңыз.
Dialogue: 0,0:01:41.37,0:01:44.54,Default,,0000,0000,0000,,Телепортация техникасы сәтсіз болады!
Dialogue: 0,0:01:44.54,0:01:46.54,Default,,0000,0000,0000,,Кабру.
Dialogue: 0,0:01:44.54,0:01:46.54,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:01:46.54,0:01:51.38,Default,,0000,0000,0000,,Мен ертең аралдың иесіне барамын.
Dialogue: 0,0:01:46.54,0:01:51.38,Default,,0000,0000,0000,,Мен қосымша айғақтар сұрағым келеді.
Dialogue: 0,0:01:51.38,0:01:53.88,Default,,0000,0000,0000,,Сен маған бәрін айтасың ба?
Dialogue: 0,0:01:53.88,0:01:57.38,Default,,0000,0000,0000,,Лайос пен оның достары ше?
Dialogue: 0,0:01:53.88,0:01:57.38,Default,,0000,0000,0000,,Оны айтудың қажеті жоқ.
Dialogue: 0,0:01:57.38,0:02:02.32,Default,,0000,0000,0000,,Менде Фаринге басқа адам жоқ.
Dialogue: 0,0:01:57.38,0:02:02.32,Default,,0000,0000,0000,,Мен сенің бас тартқаныңды қаламаймын.
Dialogue: 0,0:02:02.32,0:02:05.83,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:02:02.32,0:02:05.83,Default,,0000,0000,0000,,Бүгін жақсылап демалыңыз.
Dialogue: 0,0:02:05.83,0:02:09.16,Default,,0000,0000,0000,,Ой! Қараңыз, Куро!
Dialogue: 0,0:02:05.83,0:02:09.16,Default,,0000,0000,0000,,Үлкен кеме!
Dialogue: 0,0:02:09.16,0:02:12.17,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:02:09.16,0:02:12.17,Default,,0000,0000,0000,,Кемеде байлар көп пе?
Dialogue: 0,0:02:12.17,0:02:14.17,Default,,0000,0000,0000,,Иә? Апыр-ай!
Dialogue: 0,0:02:16.17,0:02:19.01,Default,,0000,0000,0000,,Бұл жаман...
Dialogue: 0,0:02:19.01,0:02:22.68,Default,,0000,0000,0000,,Тосиро-сан, қазір.
Dialogue: 0,0:02:19.01,0:02:22.68,Default,,0000,0000,0000,,Бастап кеткен жөн сияқты.
Dialogue: 0,0:02:22.68,0:02:27.01,Default,,0000,0000,0000,,Сол ақ кеме.
Dialogue: 0,0:02:22.68,0:02:27.01,Default,,0000,0000,0000,,Бұл батыс эльф кемесі.
Dialogue: 0,0:02:27.01,0:02:29.85,Default,,0000,0000,0000,,Құстың басы.
Dialogue: 0,0:02:29.85,0:02:32.35,Default,,0000,0000,0000,,Оны канарея деп атайды.
Dialogue: 0,0:02:32.35,0:02:36.52,Default,,0000,0000,0000,,Лабиринттің қауіптілігі
Dialogue: 0,0:02:32.35,0:02:36.52,Default,,0000,0000,0000,,Белгілі бір нүктеден асқанда келеді.
Dialogue: 0,0:02:36.52,0:02:41.69,Default,,0000,0000,0000,,Олардың міндеті
Dialogue: 0,0:02:36.52,0:02:41.69,Default,,0000,0000,0000,,Лабиринтті зерттеу... және оны жеңу.
Dialogue: 0,0:02:41.69,0:02:45.53,Default,,0000,0000,0000,,Ол көптен бері арал иесіне қысым көрсетіп келеді.
Dialogue: 0,0:02:41.69,0:02:45.53,Default,,0000,0000,0000,,Сыбыс тарады➡
Dialogue: 0,0:02:45.53,0:02:49.87,Default,,0000,0000,0000,,Сіз мәжбүрлеу шараларына жүгінген сияқтысыз.
Dialogue: 0,0:02:45.53,0:02:49.87,Default,,0000,0000,0000,,Бұл рұқсат етілген бе?
Dialogue: 0,0:02:49.87,0:02:52.21,Default,,0000,0000,0000,,Бұл Таллманның жері, солай ма?
Dialogue: 0,0:02:52.21,0:02:56.54,Default,,0000,0000,0000,,Эльфтер мен гномдар үшін
Dialogue: 0,0:02:52.21,0:02:56.54,Default,,0000,0000,0000,,Қысқа өмір сүретін түрлер сәбилер сияқты.
Dialogue: 0,0:02:56.54,0:02:59.98,Default,,0000,0000,0000,,Сонымен қатар, арал иесі
Dialogue: 0,0:02:56.54,0:02:59.98,Default,,0000,0000,0000,,Мен жақсы келіссөз жүргізуші емеспін.
Dialogue: 0,0:02:59.98,0:03:01.98,Default,,0000,0000,0000,,Тезірек барайық.
Dialogue: 0,0:03:03.98,0:03:07.15,Default,,0000,0000,0000,,Хм... Эй!
Dialogue: 0,0:03:07.15,0:03:09.99,Default,,0000,0000,0000,,Бұл Шлоу емес пе?
Dialogue: 0,0:03:07.15,0:03:09.99,Default,,0000,0000,0000,,Намари?
Dialogue: 0,0:03:09.99,0:03:12.09,Default,,0000,0000,0000,,Фарин ше?
Dialogue: 0,0:03:14.99,0:03:19.10,Default,,0000,0000,0000,,Лайос пен басқалары бас тартпаған сияқты.
Dialogue: 0,0:03:14.99,0:03:19.10,Default,,0000,0000,0000,,Мен...
Dialogue: 0,0:03:21.50,0:03:24.67,Default,,0000,0000,0000,,Сіз мұны жедіңіз бе?
Dialogue: 0,0:03:21.50,0:03:24.67,Default,,0000,0000,0000,,Мен тамақтанып отырдым...
Dialogue: 0,0:03:24.67,0:03:27.51,Default,,0000,0000,0000,,Біз арал иесін көруге келдік.
Dialogue: 0,0:03:27.51,0:03:29.68,Default,,0000,0000,0000,,А, бұл мүмкін емес.
Dialogue: 0,0:03:29.68,0:03:32.68,Default,,0000,0000,0000,,Кенеттен маңызды адам келді.
Dialogue: 0,0:03:29.68,0:03:32.68,Default,,0000,0000,0000,,Жаңа ғана енгізілді.
Dialogue: 0,0:03:32.68,0:03:35.18,Default,,0000,0000,0000,,Ол бірнеше сағат бойы шықпайды.
Dialogue: 0,0:03:35.18,0:03:37.35,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:03:35.18,0:03:37.35,Default,,0000,0000,0000,,Тым кеш пе?
Dialogue: 0,0:03:37.35,0:03:40.19,Default,,0000,0000,0000,,ішке кірейік.
Dialogue: 0,0:03:37.35,0:03:40.19,Default,,0000,0000,0000,,Бұл жаман болар еді.
Dialogue: 0,0:03:40.19,0:03:43.36,Default,,0000,0000,0000,,Лабиринт эльфтердің қолына түссе
Dialogue: 0,0:03:40.19,0:03:43.36,Default,,0000,0000,0000,,Барлығы осы.
Dialogue: 0,0:03:43.36,0:03:48.53,Default,,0000,0000,0000,,Менің де туған жерім
Dialogue: 0,0:03:43.36,0:03:48.53,Default,,0000,0000,0000,,Бұл лабиринтте гүлденген қала болды.
Dialogue: 0,0:03:48.53,0:03:52.70,Default,,0000,0000,0000,,Бір күні құбыжықтар кенет толып кетті.
Dialogue: 0,0:03:48.53,0:03:52.70,Default,,0000,0000,0000,,Пері келді...
Dialogue: 0,0:03:52.70,0:03:54.70,Default,,0000,0000,0000,,Көп адам қайтыс болды.
Dialogue: 0,0:03:54.70,0:03:57.87,Default,,0000,0000,0000,,Неліктен менің отбасым?
Dialogue: 0,0:03:54.70,0:03:57.87,Default,,0000,0000,0000,,Оған өлу керек болды ма?
Dialogue: 0,0:03:57.87,0:04:02.31,Default,,0000,0000,0000,,Ана жалғыз
Dialogue: 0,0:03:57.87,0:04:02.31,Default,,0000,0000,0000,,Сен мені жан-тәнімен өсірдің.
Dialogue: 0,0:04:02.31,0:04:06.15,Default,,0000,0000,0000,,Бұлай өлетін адам емес.
Dialogue: 0,0:04:06.15,0:04:09.32,Default,,0000,0000,0000,,Бұл менің басымнан өтті
Dialogue: 0,0:04:06.15,0:04:09.32,Default,,0000,0000,0000,,Мен өзімді қайталағым келмейді.
Dialogue: 0,0:04:09.32,0:04:12.65,Default,,0000,0000,0000,,Тек кейбір нәсілдер
Dialogue: 0,0:04:09.32,0:04:12.65,Default,,0000,0000,0000,,Қуаты бар ток құрылымы ➡
Dialogue: 0,0:04:12.65,0:04:14.85,Default,,0000,0000,0000,,Бұл екеуіне де зиянды.
Dialogue: 0,0:04:20.66,0:04:24.50,Default,,0000,0000,0000,,Кешіріңіз. Арал шеберіне
Dialogue: 0,0:04:20.66,0:04:24.50,Default,,0000,0000,0000,,Менің хабарлайтын нәрсем бар➡
Dialogue: 0,0:04:24.50,0:04:26.83,Default,,0000,0000,0000,,Мен осындамын.
Dialogue: 0,0:04:24.50,0:04:26.83,Default,,0000,0000,0000,,Ммм….
Dialogue: 0,0:04:26.83,0:04:28.84,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:04:28.84,0:04:32.34,Default,,0000,0000,0000,,As you can see
Dialogue: 0,0:04:28.84,0:04:32.34,Default,,0000,0000,0000,,Қазіргі уақытта импортталады. Шығаруға өтініш берейік.
Dialogue: 0,0:04:32.34,0:04:37.04,Default,,0000,0000,0000,,Бұл лабиринттің қазіргі жағдайы туралы есеп.
Dialogue: 0,0:04:32.34,0:04:37.04,Default,,0000,0000,0000,,Тыңдаңыз.
Dialogue: 0,0:04:39.01,0:04:41.35,Default,,0000,0000,0000,,《Қысуға болмайды...》
Dialogue: 0,0:04:41.35,0:04:44.02,Default,,0000,0000,0000,,Қысқа болыңыз.
Dialogue: 0,0:04:44.02,0:04:47.02,Default,,0000,0000,0000,,Лабиринтті зерттеу кезінде➡
Dialogue: 0,0:04:47.02,0:04:50.36,Default,,0000,0000,0000,,Құбыжыққа айналды
Dialogue: 0,0:04:47.02,0:04:50.36,Default,,0000,0000,0000,,Адамдар кездесті.
Dialogue: 0,0:04:50.36,0:04:52.36,Default,,0000,0000,0000,,Кешір… (Иура) Қайдағы жоқ.
Dialogue: 0,0:04:50.36,0:04:52.36,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:04:52.36,0:04:55.86,Default,,0000,0000,0000,,Химера ма?
Dialogue: 0,0:04:52.36,0:04:55.86,Default,,0000,0000,0000,,Прогресс күтілгеннен жылдамырақ.
Dialogue: 0,0:04:55.86,0:04:57.86,Default,,0000,0000,0000,,Мен айттым ғой!
Dialogue: 0,0:04:57.86,0:05:00.63,Default,,0000,0000,0000,,Жауапты шыдамдылықпен күту
Dialogue: 0,0:04:57.86,0:05:00.63,Default,,0000,0000,0000,,Уақыт болмады!
Dialogue: 0,0:05:00.63,0:05:03.64,Default,,0000,0000,0000,,Қону тапсырыстары қазір!
Dialogue: 0,0:05:00.63,0:05:03.64,Default,,0000,0000,0000,,Қандай өзімшіл нәрсе!
Dialogue: 0,0:05:03.64,0:05:05.81,Default,,0000,0000,0000,,Қария, сабыр сақта.
Dialogue: 0,0:05:03.64,0:05:05.81,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:05:05.81,0:05:09.64,Default,,0000,0000,0000,,Шекаралар және т.б.
Dialogue: 0,0:05:05.81,0:05:09.64,Default,,0000,0000,0000,,Адам өміріне келетін болсақ, ол тривиальды.
Dialogue: 0,0:05:09.64,0:05:12.98,Default,,0000,0000,0000,,Сен маған қарт адамдай қарайсың.
Dialogue: 0,0:05:09.64,0:05:12.98,Default,,0000,0000,0000,,Мұның мағынасы жоқ!
Dialogue: 0,0:05:12.98,0:05:16.48,Default,,0000,0000,0000,,Сандық... Бұл жеткілікті емес пе?
Dialogue: 0,0:05:12.98,0:05:16.48,Default,,0000,0000,0000,,Дұрыс, болды!
Dialogue: 0,0:05:16.48,0:05:20.15,Default,,0000,0000,0000,,Арал шебері күткендей
Dialogue: 0,0:05:16.48,0:05:20.15,Default,,0000,0000,0000,,Икемді және ақылды.
Dialogue: 0,0:05:20.15,0:05:22.49,Default,,0000,0000,0000,,Олай болса, осы жерге мөртаңба қойыңыз.
Dialogue: 0,0:05:22.49,0:05:24.66,Default,,0000,0000,0000,,Мүмкін емес!
Dialogue: 0,0:05:22.49,0:05:24.66,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:05:24.66,0:05:28.16,Default,,0000,0000,0000,,Бұл қажет емес
Dialogue: 0,0:05:24.66,0:05:28.16,Default,,0000,0000,0000,,Жағдайды нашарлату...
Dialogue: 0,0:05:28.16,0:05:30.33,Default,,0000,0000,0000,,《Шынында... маған➡
Dialogue: 0,0:05:30.33,0:05:34.17,Default,,0000,0000,0000,,Лабиринтті басқара алады
Dialogue: 0,0:05:30.33,0:05:34.17,Default,,0000,0000,0000,,Қабілетіңіз болса, еш қиындық болмас еді.
Dialogue: 0,0:05:34.17,0:05:36.34,Default,,0000,0000,0000,,Бірақ бұл мүмкін емес.
Dialogue: 0,0:05:36.34,0:05:41.67,Default,,0000,0000,0000,,Сонымен, басқа да талантты авантюристер
Dialogue: 0,0:05:36.34,0:05:41.67,Default,,0000,0000,0000,,Мен көмектесетін жолдарды іздей бастадым.
Dialogue: 0,0:05:41.67,0:05:46.01,Default,,0000,0000,0000,,Бірақ көбінесе өзімшіл
Dialogue: 0,0:05:41.67,0:05:46.01,Default,,0000,0000,0000,,Көбі елеусіз болды.
Dialogue: 0,0:05:46.01,0:05:48.01,Default,,0000,0000,0000,,Соңында, өзіңіз➡
Dialogue: 0,0:05:48.01,0:05:50.85,Default,,0000,0000,0000,,Лабиринтті бағындырудан басқа амалымыз жоқ.
Dialogue: 0,0:05:48.01,0:05:50.85,Default,,0000,0000,0000,,Қарным ашқанда➡
Dialogue: 0,0:05:50.85,0:05:53.52,Default,,0000,0000,0000,,Мен Тоден ағалары мен апалары туралы өсек естідім.
Dialogue: 0,0:05:53.52,0:05:55.86,Default,,0000,0000,0000,,｟Бұл біршама жақсы тәрбиелі.
Dialogue: 0,0:05:55.86,0:05:59.03,Default,,0000,0000,0000,,Оның түйсігі жақсы, бірақ риясыз сияқты.
Dialogue: 0,0:05:59.03,0:06:01.46,Default,,0000,0000,0000,,Ол біртүрлі жігіт.
Dialogue: 0,0:06:01.46,0:06:04.30,Default,,0000,0000,0000,,《Мен іздеген сайын ол бөтен болып кетті.
Dialogue: 0,0:06:04.30,0:06:08.13,Default,,0000,0000,0000,,Көп емес
Dialogue: 0,0:06:04.30,0:06:08.13,Default,,0000,0000,0000,,Мықты болмасам да, тереңдікке жеттім.
Dialogue: 0,0:06:08.13,0:06:11.47,Default,,0000,0000,0000,,Жаман қауесет келе береді
Dialogue: 0,0:06:08.13,0:06:11.47,Default,,0000,0000,0000,,Оларға ақша ағыны.
Dialogue: 0,0:06:11.47,0:06:15.81,Default,,0000,0000,0000,,Шығу жұмбағы
Dialogue: 0,0:06:11.47,0:06:15.81,Default,,0000,0000,0000,,Белгісіз достық.
Dialogue: 0,0:06:15.81,0:06:17.81,Default,,0000,0000,0000,,Бірақ әйтеуір➡
Dialogue: 0,0:06:17.81,0:06:22.32,Default,,0000,0000,0000,,Бұл кісінің арал тағдырына ықпалы зор.
Dialogue: 0,0:06:17.81,0:06:22.32,Default,,0000,0000,0000,,Мен оның қатысы болуы мүмкін деп ойладым.
Dialogue: 0,0:06:22.32,0:06:25.99,Default,,0000,0000,0000,,Мәселе мынада
Dialogue: 0,0:06:22.32,0:06:25.99,Default,,0000,0000,0000,,Бұл жақсы ма, әлде жаман ба?
Dialogue: 0,0:06:25.99,0:06:29.32,Default,,0000,0000,0000,,Мен тікелей сөйлесіп, шешім қабылдағым келеді.
Dialogue: 0,0:06:25.99,0:06:29.32,Default,,0000,0000,0000,,Мен әрқашан осылай ойлайтынмын➡
Dialogue: 0,0:06:29.32,0:06:32.49,Default,,0000,0000,0000,,Ақыры кездесіп, әңгімелескенімізде көзім жетті.
Dialogue: 0,0:06:32.49,0:06:35.66,Default,,0000,0000,0000,,Ол тек құбыжықтар туралы ойлайды.
Dialogue: 0,0:06:35.66,0:06:38.66,Default,,0000,0000,0000,,Оған аралдың болашағын беріңіз
Dialogue: 0,0:06:35.66,0:06:38.66,Default,,0000,0000,0000,,Мен бұл туралы ойлана алмаймын➡
Dialogue: 0,0:06:38.66,0:06:42.00,Default,,0000,0000,0000,,Оны саған сеніп тапсыруға болмайды.
Dialogue: 0,0:06:38.66,0:06:42.00,Default,,0000,0000,0000,,Менің айта алатыным осы ғана.
Dialogue: 0,0:06:42.00,0:06:44.00,Default,,0000,0000,0000,,Енді Таллманның ішінде➡
Dialogue: 0,0:06:44.00,0:06:47.51,Default,,0000,0000,0000,,Лабиринттің ортасында
Dialogue: 0,0:06:44.00,0:06:47.51,Default,,0000,0000,0000,,Ол жақындап қалды.
Dialogue: 0,0:06:47.51,0:06:50.68,Default,,0000,0000,0000,,Мүмкін бұл
Dialogue: 0,0:06:47.51,0:06:50.68,Default,,0000,0000,0000,,Бұл сіздің бірінші және соңғы мүмкіндігіңіз➡
Dialogue: 0,0:06:50.68,0:06:53.68,Default,,0000,0000,0000,,Эльфтерге
Dialogue: 0,0:06:50.68,0:06:53.68,Default,,0000,0000,0000,,Мен сізге кедергі келтіре алмаймын.
Dialogue: 0,0:06:53.68,0:06:57.02,Default,,0000,0000,0000,,Онымен не істеу керек, содан кейін.
Dialogue: 0,0:06:57.02,0:06:59.02,Default,,0000,0000,0000,,Жетеді...
Dialogue: 0,0:06:57.02,0:06:59.02,Default,,0000,0000,0000,,​​О?
Dialogue: 0,0:06:59.02,0:07:01.29,Default,,0000,0000,0000,,Өзіңізге ұнайтын нәрсені жасаңыз.
Dialogue: 0,0:06:59.02,0:07:01.29,Default,,0000,0000,0000,,О!
Dialogue: 0,0:06:59.02,0:07:01.29,Default,,0000,0000,0000,,Арал шебері!
Dialogue: 0,0:07:01.29,0:07:04.79,Default,,0000,0000,0000,,Қону туралы бұйрықтар.
Dialogue: 0,0:07:01.29,0:07:04.79,Default,,0000,0000,0000,,(Night Eye) Мен ойлағандай, «Барлығы Бір» шын мәнінде Миллиоға берілуі керек еді.
Dialogue: 0,0:07:04.79,0:07:09.63,Default,,0000,0000,0000,,Енді лабиринт - бұл құрылым және қоршаған орта
Dialogue: 0,0:07:04.79,0:07:09.63,Default,,0000,0000,0000,,Құбыжықтардың түрлері де әр түрлі➡
Dialogue: 0,0:07:09.63,0:07:12.97,Default,,0000,0000,0000,,Өте тұрақсыз.
Dialogue: 0,0:07:09.63,0:07:12.97,Default,,0000,0000,0000,,Әрине түсінемін.
Dialogue: 0,0:07:12.97,0:07:17.80,Default,,0000,0000,0000,,Бұл лабиринт өскен кездегі қасиет.
Dialogue: 0,0:07:12.97,0:07:17.80,Default,,0000,0000,0000,,Оны мүмкіндігінше тез тоқтату керек.
Dialogue: 0,0:07:17.80,0:07:20.14,Default,,0000,0000,0000,,Адамның өсу кезеңі.
Dialogue: 0,0:07:20.14,0:07:22.81,Default,,0000,0000,0000,,Ең нәрлі
Dialogue: 0,0:07:20.14,0:07:22.81,Default,,0000,0000,0000,,Қажет кезде.
Dialogue: 0,0:07:22.81,0:07:24.81,Default,,0000,0000,0000,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:07:24.81,0:07:29.32,Default,,0000,0000,0000,,Менің туған жерім осыдан 15 жыл бұрын болды
Dialogue: 0,0:07:24.81,0:07:29.32,Default,,0000,0000,0000,,Лабиринтпен жойылған.
Dialogue: 0,0:07:29.32,0:07:31.82,Default,,0000,0000,0000,,Бұл Утайя деген қала.
Dialogue: 0,0:07:31.82,0:07:34.32,Default,,0000,0000,0000,,15 жыл бұрын?
Dialogue: 0,0:07:31.82,0:07:34.32,Default,,0000,0000,0000,,Сонымен.
Dialogue: 0,0:07:34.32,0:07:37.49,Default,,0000,0000,0000,,Сіз сол кезде
Dialogue: 0,0:07:34.32,0:07:37.49,Default,,0000,0000,0000,,Тірі қалған бала! ?
Dialogue: 0,0:07:37.49,0:07:41.16,Default,,0000,0000,0000,,Менің ойымша, сол кездегі командирдің орынбасары немесе біреу
Dialogue: 0,0:07:37.49,0:07:41.16,Default,,0000,0000,0000,,Оны қайтарғаныңызды естідім.
Dialogue: 0,0:07:41.16,0:07:44.33,Default,,0000,0000,0000,,Иә, бірнеше жыл бойы көмектескеніңіз үшін рахмет.
Dialogue: 0,0:07:44.33,0:07:47.83,Default,,0000,0000,0000,,Эй, сен сондай сүйкімді едің
Dialogue: 0,0:07:44.33,0:07:47.83,Default,,0000,0000,0000,,Мен авантюрист болдым.
Dialogue: 0,0:07:47.83,0:07:51.84,Default,,0000,0000,0000,,Менің арманым әскерге бару болатын.
Dialogue: 0,0:07:47.83,0:07:51.84,Default,,0000,0000,0000,,Нәсілдік кедергілер де бар...
Dialogue: 0,0:07:51.84,0:07:55.84,Default,,0000,0000,0000,,Туған жерімнің қасіретін қайталамау үшін
Dialogue: 0,0:07:51.84,0:07:55.84,Default,,0000,0000,0000,,Мен бір көмек болсам деймін.
Dialogue: 0,0:07:55.84,0:07:59.18,Default,,0000,0000,0000,,Бұл ерекше жеңіс.
Dialogue: 0,0:07:55.84,0:07:59.18,Default,,0000,0000,0000,,Сіз дұрыс тамақтанып жатырсыз ба?
Dialogue: 0,0:07:59.18,0:08:03.12,Default,,0000,0000,0000,,Көңілді жүзіңізді анда-санда көрсетіңіз.
Dialogue: 0,0:07:59.18,0:08:03.12,Default,,0000,0000,0000,,Сонымен.
Dialogue: 0,0:08:03.12,0:08:06.95,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:08:03.12,0:08:06.95,Default,,0000,0000,0000,,«Тамақтану»? не болды.
Dialogue: 0,0:08:06.95,0:08:08.96,Default,,0000,0000,0000,,Жалғастыру.
Dialogue: 0,0:08:08.96,0:08:11.29,Default,,0000,0000,0000,,Еңбегіңізге рахмет➡
Dialogue: 0,0:08:11.29,0:08:13.96,Default,,0000,0000,0000,,Утайя лабиринті
Dialogue: 0,0:08:11.29,0:08:13.96,Default,,0000,0000,0000,,Ол бірден құлады➡
Dialogue: 0,0:08:13.96,0:08:18.13,Default,,0000,0000,0000,,Сарбаздар да, тұрғындар да
Dialogue: 0,0:08:13.96,0:08:18.13,Default,,0000,0000,0000,,Көп шығын келтірілді.
Dialogue: 0,0:08:18.13,0:08:22.64,Default,,0000,0000,0000,,Өлгендер құбыжықтарға айналады
Dialogue: 0,0:08:18.13,0:08:22.64,Default,,0000,0000,0000,,Өйткені олар адамдарды тірідей жеген.
Dialogue: 0,0:08:22.64,0:08:26.14,Default,,0000,0000,0000,,Артынан шабуыл жасалды
Dialogue: 0,0:08:22.64,0:08:26.14,Default,,0000,0000,0000,,Солдаттар да көп болды.
Dialogue: 0,0:08:26.14,0:08:29.64,Default,,0000,0000,0000,,Сандармен шабуыл жасасаңыз да
Dialogue: 0,0:08:26.14,0:08:29.64,Default,,0000,0000,0000,,Утайяның мұқабасына бас.
Dialogue: 0,0:08:29.64,0:08:32.14,Default,,0000,0000,0000,,Мен лабиринтті жабуды ұсынамын.
Dialogue: 0,0:08:32.14,0:08:35.31,Default,,0000,0000,0000,,Лабиринтті тамақтандыруға болмайды.
Dialogue: 0,0:08:35.31,0:08:37.82,Default,,0000,0000,0000,,Лабиринт шайқаста зақымдалуы мүмкін➡
Dialogue: 0,0:08:37.82,0:08:40.15,Default,,0000,0000,0000,,Сізге
Dialogue: 0,0:08:37.82,0:08:40.15,Default,,0000,0000,0000,,Бұл шынайы ниет болмауы керек.
Dialogue: 0,0:08:40.15,0:08:42.15,Default,,0000,0000,0000,,Кім қалды?
Dialogue: 0,0:08:42.15,0:08:46.99,Default,,0000,0000,0000,,Олардың көпшілігі бір қабатта шоғырланған.
Dialogue: 0,0:08:42.15,0:08:46.99,Default,,0000,0000,0000,,Біртіндеп көшейік.
Dialogue: 0,0:08:46.99,0:08:50.00,Default,,0000,0000,0000,,Кез келген адамға
Dialogue: 0,0:08:46.99,0:08:50.00,Default,,0000,0000,0000,,Байланыстың қандай да бір түрі бар.
Dialogue: 0,0:08:50.00,0:08:53.17,Default,,0000,0000,0000,,Ынтымақтастықты қалай сұрауға болады
Dialogue: 0,0:08:50.00,0:08:53.17,Default,,0000,0000,0000,,Мен бірнеше нәрсені білемін.
Dialogue: 0,0:08:53.17,0:08:55.67,Default,,0000,0000,0000,,Оны маған қалдыр!
Dialogue: 0,0:08:55.67,0:08:57.67,Default,,0000,0000,0000,,Гует.
Dialogue: 0,0:08:57.67,0:09:03.18,Default,,0000,0000,0000,,《Шлоу: Мына жігіт... сол жағдайда
Dialogue: 0,0:08:57.67,0:09:03.18,Default,,0000,0000,0000,,Сіз құбыжықты жедіңіз бе?
Dialogue: 0,0:09:05.78,0:09:08.28,Default,,0000,0000,0000,,Эй, дайындал.
Dialogue: 0,0:09:05.78,0:09:08.28,Default,,0000,0000,0000,,(Мұғалім) О, қандай жаһандық көзқарас. (Цубаки) 《Уф! Сол сұм~》
Dialogue: 0,0:09:08.28,0:09:10.45,Default,,0000,0000,0000,,Тергеуге дайындық.
Dialogue: 0,0:09:08.28,0:09:10.45,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:09:10.45,0:09:14.12,Default,,0000,0000,0000,,Ол бірдеңені жоспарлап отырған болуы керек.
Dialogue: 0,0:09:14.12,0:09:17.46,Default,,0000,0000,0000,,Осыншама көп айтсаң
Dialogue: 0,0:09:14.12,0:09:17.46,Default,,0000,0000,0000,,Маған жасап көрейін.
Dialogue: 0,0:09:17.46,0:09:21.29,Default,,0000,0000,0000,,Егер бірдеңе болса
Dialogue: 0,0:09:17.46,0:09:21.29,Default,,0000,0000,0000,,Дереу әскерді жіберіңіз.
Dialogue: 0,0:09:21.29,0:09:24.10,Default,,0000,0000,0000,,Жақсы.
Dialogue: 0,0:09:21.29,0:09:24.10,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:09:29.14,0:09:32.14,Default,,0000,0000,0000,,Уау….
Dialogue: 0,0:09:32.14,0:09:35.47,Default,,0000,0000,0000,,Бұл пісірілген жұмыртқа ма?
Dialogue: 0,0:09:32.14,0:09:35.47,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:09:35.47,0:09:38.48,Default,,0000,0000,0000,,Бұрын мен жанды жұмыртқаға теңеп едім➡
Dialogue: 0,0:09:38.48,0:09:42.65,Default,,0000,0000,0000,,Аралас жандардың күйі
Dialogue: 0,0:09:38.48,0:09:42.65,Default,,0000,0000,0000,,Жұмыртқа бойынша➡
Dialogue: 0,0:09:42.65,0:09:44.65,Default,,0000,0000,0000,,Жағдай қандай?
Dialogue: 0,0:09:44.65,0:09:50.49,Default,,0000,0000,0000,,Мысалы, қатты пісірілген жұмыртқада және қуырылған жұмыртқада
Dialogue: 0,0:09:44.65,0:09:50.49,Default,,0000,0000,0000,,Бұл мүлдем басқа әңгіме болар еді, солай емес пе?
Dialogue: 0,0:09:50.49,0:09:53.66,Default,,0000,0000,0000,,Білесің бе, жанды жұмыртқаға салыстыру➡
Dialogue: 0,0:09:53.66,0:09:56.16,Default,,0000,0000,0000,,Сөздердің мағынасын түсіру
Dialogue: 0,0:09:53.66,0:09:56.16,Default,,0000,0000,0000,,Бұл көңіл көтеру үшін емес.
Dialogue: 0,0:09:56.16,0:09:58.16,Default,,0000,0000,0000,,Маған күшіңді бересің бе?
Dialogue: 0,0:09:58.16,0:10:01.50,Default,,0000,0000,0000,,Бұл жақсы ұқсастық.
Dialogue: 0,0:09:58.16,0:10:01.50,Default,,0000,0000,0000,,Маған қатты әсер етті.
Dialogue: 0,0:10:01.50,0:10:05.50,Default,,0000,0000,0000,,Жұмыртқа қанша түрлі қасиеттерге ие
Dialogue: 0,0:10:01.50,0:10:05.50,Default,,0000,0000,0000,,Сақтайтын ештеңе жоқ.
Dialogue: 0,0:10:05.50,0:10:10.84,Default,,0000,0000,0000,,Мысалы, бұл қыздыру қатаю қасиеті болып табылады
Dialogue: 0,0:10:05.50,0:10:10.84,Default,,0000,0000,0000,,Ақ пен сарысы әртүрлі температураға ие.
Dialogue: 0,0:10:10.84,0:10:15.51,Default,,0000,0000,0000,,Көбікті ылғалдандыратын адгезия
Dialogue: 0,0:10:10.84,0:10:15.51,Default,,0000,0000,0000,,Ең қызығы эмульсия.
Dialogue: 0,0:10:15.51,0:10:18.02,Default,,0000,0000,0000,,Су мен май сияқты➡
Dialogue: 0,0:10:18.02,0:10:22.52,Default,,0000,0000,0000,,Бастапқыда араласпайтын заттар
Dialogue: 0,0:10:18.02,0:10:22.52,Default,,0000,0000,0000,,Шарттар дұрыс болса, олар жақсы араласады.
Dialogue: 0,0:10:22.52,0:10:24.52,Default,,0000,0000,0000,,Осы сияқты.
Dialogue: 0,0:10:24.52,0:10:28.69,Default,,0000,0000,0000,,Ал...
Dialogue: 0,0:10:24.52,0:10:28.69,Default,,0000,0000,0000,,Шынында да, жұмыртқа неліктен? ?
Dialogue: 0,0:10:28.69,0:10:31.40,Default,,0000,0000,0000,,Лайос Мына нанды ал.
Dialogue: 0,0:10:33.37,0:10:35.37,Default,,0000,0000,0000,,Уф... Уф.
Dialogue: 0,0:10:33.37,0:10:35.37,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:10:42.21,0:10:44.21,Default,,0000,0000,0000,,Ол аяқталды!
Dialogue: 0,0:10:47.05,0:10:49.72,Default,,0000,0000,0000,,Қалай тамақтану керек
Dialogue: 0,0:10:47.05,0:10:49.72,Default,,0000,0000,0000,,Жарайды ма?
Dialogue: 0,0:10:49.72,0:10:52.05,Default,,0000,0000,0000,,Шанышқы мен пышақты пайдаланыңыз.
Dialogue: 0,0:10:52.05,0:10:55.15,Default,,0000,0000,0000,,Нандағы сарысы мен тұздығы
Dialogue: 0,0:10:52.05,0:10:55.15,Default,,0000,0000,0000,,Шөмішпен тамақтаныңыз.
Dialogue: 0,0:11:00.99,0:11:03.00,Default,,0000,0000,0000,,Әрине жақсы.
Dialogue: 0,0:11:03.00,0:11:05.16,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:11:03.00,0:11:05.16,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:11:05.16,0:11:09.50,Default,,0000,0000,0000,,Изуцуми сен
Dialogue: 0,0:11:05.16,0:11:09.50,Default,,0000,0000,0000,,Ештеңеге қарауды доғар!
Dialogue: 0,0:11:09.50,0:11:12.34,Default,,0000,0000,0000,,Сіз бірдеңе көріп тұрсыз ба?
Dialogue: 0,0:11:09.50,0:11:12.34,Default,,0000,0000,0000,,Жоқ, олай емес.
Dialogue: 0,0:11:12.34,0:11:15.84,Default,,0000,0000,0000,,Мен жай ғана қатысуды сезіндім.
Dialogue: 0,0:11:12.34,0:11:15.84,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:11:15.84,0:11:19.68,Default,,0000,0000,0000,,Иә! Мүмкін бұл
Dialogue: 0,0:11:15.84,0:11:19.68,Default,,0000,0000,0000,,Бұл галлюцинация емес! ?
Dialogue: 0,0:11:19.68,0:11:22.85,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:22.85,0:11:25.52,Default,,0000,0000,0000,,Жоқ, бұрын сиқырлы мас болған кезде➡
Dialogue: 0,0:11:25.52,0:11:28.52,Default,,0000,0000,0000,,Егер сізде галлюцинация немесе есту галлюцинациялары болса
Dialogue: 0,0:11:25.52,0:11:28.52,Default,,0000,0000,0000,,Мен айттым ғой.
Dialogue: 0,0:11:28.52,0:11:32.53,Default,,0000,0000,0000,,Бұл ұзақ уақытқа созылды.
Dialogue: 0,0:11:28.52,0:11:32.53,Default,,0000,0000,0000,,Мәңгі! ? Неге үндемедің? ?
Dialogue: 0,0:11:32.53,0:11:35.53,Default,,0000,0000,0000,,Өйткені жақында
Dialogue: 0,0:11:32.53,0:11:35.53,Default,,0000,0000,0000,,Басым ауырып жатыр деп қорқытады.
Dialogue: 0,0:11:35.53,0:11:39.63,Default,,0000,0000,0000,,Жоқ, сіз ауырып жатырсыз.
Dialogue: 0,0:11:35.53,0:11:39.63,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:11:35.53,0:11:39.63,Default,,0000,0000,0000,,Бұл галлюцинацияның қандай түрі?
Dialogue: 0,0:11:42.37,0:11:45.71,Default,,0000,0000,0000,,Менімен үнемі біреу сөйлеседі.
Dialogue: 0,0:11:45.71,0:11:48.71,Default,,0000,0000,0000,,Басында не айтасыз?
Dialogue: 0,0:11:45.71,0:11:48.71,Default,,0000,0000,0000,,Мен түсінбеймін.
Dialogue: 0,0:11:48.71,0:11:52.04,Default,,0000,0000,0000,,Бірақ біртіндеп
Dialogue: 0,0:11:48.71,0:11:52.04,Default,,0000,0000,0000,,Дауысы да, пішіні де анық болды.
Dialogue: 0,0:11:52.04,0:11:55.38,Default,,0000,0000,0000,,Мен үнемі қорқамын
Dialogue: 0,0:11:52.04,0:11:55.38,Default,,0000,0000,0000,,Мен оны көрмеген кейіп таныттым.
Dialogue: 0,0:11:55.38,0:11:59.89,Default,,0000,0000,0000,,Өйткені, бұл сенсің.
Dialogue: 0,0:11:55.38,0:11:59.89,Default,,0000,0000,0000,,Сіз мені естіген болуыңыз керек.
Dialogue: 0,0:11:59.89,0:12:01.82,Default,,0000,0000,0000,,Енді ше?
Dialogue: 0,0:12:01.82,0:12:04.66,Default,,0000,0000,0000,,Елемеу үшін
Dialogue: 0,0:12:01.82,0:12:04.66,Default,,0000,0000,0000,,Сіз ашулысыз ба...?
Dialogue: 0,0:12:04.66,0:12:06.66,Default,,0000,0000,0000,,Әңгімелесу дұрыс па?
Dialogue: 0,0:12:06.66,0:12:09.16,Default,,0000,0000,0000,,Бұл зұлым рухқа ұқсайды ма?
Dialogue: 0,0:12:06.66,0:12:09.16,Default,,0000,0000,0000,,Иә….
Dialogue: 0,0:12:09.16,0:12:11.66,Default,,0000,0000,0000,,Менің ойымша, кез келген жағдайда.
Dialogue: 0,0:12:09.16,0:12:11.66,Default,,0000,0000,0000,,Уф.
Dialogue: 0,0:12:11.66,0:12:13.67,Default,,0000,0000,0000,,Сәлеметсіз бе!
Dialogue: 0,0:12:13.67,0:12:17.00,Default,,0000,0000,0000,,Сізге қажет нәрсе бар ма?
Dialogue: 0,0:12:13.67,0:12:17.00,Default,,0000,0000,0000,,Иә... Иә...
Dialogue: 0,0:12:17.00,0:12:19.00,Default,,0000,0000,0000,,Сіз не айтасыз?
Dialogue: 0,0:12:19.00,0:12:22.01,Default,,0000,0000,0000,,Жын сияқты қарау
Dialogue: 0,0:12:19.00,0:12:22.01,Default,,0000,0000,0000,,Ашулы.
Dialogue: 0,0:12:22.01,0:12:24.18,Default,,0000,0000,0000,,Сондай-ақ.
Dialogue: 0,0:12:22.01,0:12:24.18,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:24.18,0:12:28.35,Default,,0000,0000,0000,,Сиқыршының көмегіне жауап ретінде
Dialogue: 0,0:12:24.18,0:12:28.35,Default,,0000,0000,0000,,Сіз ұмыттыңыз ба?
Dialogue: 0,0:12:28.35,0:12:30.35,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:30.35,0:12:32.35,Default,,0000,0000,0000,,Әй, сол кезде.
Dialogue: 0,0:12:32.35,0:12:36.52,Default,,0000,0000,0000,,Бұл болды.
Dialogue: 0,0:12:32.35,0:12:36.52,Default,,0000,0000,0000,,Рахмет.
Dialogue: 0,0:12:36.52,0:12:38.52,Default,,0000,0000,0000,,Hmph….
Dialogue: 0,0:12:38.52,0:12:40.53,Default,,0000,0000,0000,,Мен сені таныстырғым келетін біреу бар.
Dialogue: 0,0:12:40.53,0:12:43.36,Default,,0000,0000,0000,,Біз не істеуіміз керек?
Dialogue: 0,0:12:40.53,0:12:43.36,Default,,0000,0000,0000,,Өлім құдай емес пе?
Dialogue: 0,0:12:43.36,0:12:46.70,Default,,0000,0000,0000,,Менің басқа амалым жоқ.
Dialogue: 0,0:12:43.36,0:12:46.70,Default,,0000,0000,0000,,Жарайды!
Dialogue: 0,0:12:46.70,0:12:49.20,Default,,0000,0000,0000,,Олай болса мен ол кісімен танысуға рұқсат етіңіз!
Dialogue: 0,0:12:51.20,0:12:53.21,Default,,0000,0000,0000,,А... Жоқ! ?
Dialogue: 0,0:12:53.21,0:12:55.88,Default,,0000,0000,0000,,Иә! ? Апыр-ай! Апыр-ай!
Dialogue: 0,0:12:55.88,0:12:57.88,Default,,0000,0000,0000,,Ал әйелім ше? Әйелім мен ұлым? Екеуі де аман ба?
Dialogue: 0,0:12:57.88,0:13:00.15,Default,,0000,0000,0000,,Уф... Ааа...
Dialogue: 0,0:13:00.15,0:13:04.85,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:13:07.82,0:13:11.99,Default,,0000,0000,0000,,(Инелік аспаз)
Dialogue: 0,0:13:11.99,0:13:14.49,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:13:16.50,0:13:20.30,Default,,0000,0000,0000,,Мм... Аа!
Dialogue: 0,0:13:26.34,0:13:29.51,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:13:26.34,0:13:29.51,Default,,0000,0000,0000,,Хмм... ой...
Dialogue: 0,0:13:26.34,0:13:29.51,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:13:29.51,0:13:33.01,Default,,0000,0000,0000,,Мұнда...
Dialogue: 0,0:13:29.51,0:13:33.01,Default,,0000,0000,0000,,⚟Сәлем!
Dialogue: 0,0:13:33.01,0:13:35.01,Default,,0000,0000,0000,,Бұл қауіпті!
Dialogue: 0,0:13:35.01,0:13:37.62,Default,,0000,0000,0000,,Ю! жалғыз мүйізді!
Dialogue: 0,0:13:39.69,0:13:42.52,Default,,0000,0000,0000,,Балалар... Сырттан келдің бе? ?
Dialogue: 0,0:13:42.52,0:13:45.52,Default,,0000,0000,0000,,Жоқ, біз лабиринттен келдік...
Dialogue: 0,0:13:45.52,0:13:48.53,Default,,0000,0000,0000,,Бұл өте қиын! Менімен жүр!
Dialogue: 0,0:13:48.53,0:13:55.03,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:13:55.03,0:13:58.04,Default,,0000,0000,0000,,Құбыжықтар өте көп
Dialogue: 0,0:13:55.03,0:13:58.04,Default,,0000,0000,0000,,Ол тыныш...
Dialogue: 0,0:13:58.04,0:14:01.31,Default,,0000,0000,0000,,Бізді ренжітпе
Dialogue: 0,0:13:58.04,0:14:01.31,Default,,0000,0000,0000,,Бұйрық бойынша.
Dialogue: 0,0:14:01.31,0:14:04.81,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:14:01.31,0:14:04.81,Default,,0000,0000,0000,,Бірақ сырттан келгендер басқаша.
Dialogue: 0,0:14:04.81,0:14:07.31,Default,,0000,0000,0000,,Ауылдың заттарын жаныңда ұста.
Dialogue: 0,0:14:07.31,0:14:10.82,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:14:07.31,0:14:10.82,Default,,0000,0000,0000,,Ах, Изуцуми, не болды?
Dialogue: 0,0:14:10.82,0:14:13.99,Default,,0000,0000,0000,,Бұл трансферттік ауру ма?
Dialogue: 0,0:14:10.82,0:14:13.99,Default,,0000,0000,0000,,Сіз шаршадыңыз ба?
Dialogue: 0,0:14:13.99,0:14:18.32,Default,,0000,0000,0000,,Бұл Алтын қамал ма?
Dialogue: 0,0:14:13.99,0:14:18.32,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:14:18.32,0:14:20.99,Default,,0000,0000,0000,,Мен мұнда рухпен танысқандықтан келдім➡
Dialogue: 0,0:14:20.99,0:14:24.33,Default,,0000,0000,0000,,Олар осында тұрады ма?
Dialogue: 0,0:14:20.99,0:14:24.33,Default,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:14:24.33,0:14:27.83,Default,,0000,0000,0000,,Толық ақпарат алу үшін
Dialogue: 0,0:14:24.33,0:14:27.83,Default,,0000,0000,0000,,Кездесетін адамнан сұраңыз.
Dialogue: 0,0:14:27.83,0:14:30.00,Default,,0000,0000,0000,,Неліктен сізді таңдадыңыз?➡
Dialogue: 0,0:14:30.00,0:14:33.34,Default,,0000,0000,0000,,Мен де көп білмеймін.
Dialogue: 0,0:14:30.00,0:14:33.34,Default,,0000,0000,0000,,Таңдалған?
Dialogue: 0,0:14:33.34,0:14:36.84,Default,,0000,0000,0000,,Мен таптым. Бір минут күте тұрыңыз.
Dialogue: 0,0:14:39.51,0:14:42.31,Default,,0000,0000,0000,,Күйеуіңіз құлшылыққа кетті.
Dialogue: 0,0:14:44.35,0:14:46.69,Default,,0000,0000,0000,,Мысал….
Dialogue: 0,0:14:44.35,0:14:46.69,Default,,0000,0000,0000,,Ех➡
Dialogue: 0,0:14:46.69,0:14:48.69,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:14:48.69,0:14:51.36,Default,,0000,0000,0000,,Біраз кідіріс болған сияқты.
Dialogue: 0,0:14:51.36,0:14:55.86,Default,,0000,0000,0000,,Иесі қайтып келгенше
Dialogue: 0,0:14:51.36,0:14:55.86,Default,,0000,0000,0000,,Ауылға уақытыңызды бөлуіңізді өтінемін.
Dialogue: 0,0:14:55.86,0:14:59.70,Default,,0000,0000,0000,,Барлығы сізге қамқорлық жасағысы келеді.
Dialogue: 0,0:14:55.86,0:14:59.70,Default,,0000,0000,0000,,Төзгісіз сияқты.
Dialogue: 0,0:14:59.70,0:15:04.14,Default,,0000,0000,0000,,Мен саған қайда көрсеттім?
Dialogue: 0,0:14:59.70,0:15:04.14,Default,,0000,0000,0000,,Бұл бос ауыл.
Dialogue: 0,0:15:04.14,0:15:08.64,Default,,0000,0000,0000,,Бұлардың барлығы Алтын сарайдың тұрғындары ма?
Dialogue: 0,0:15:04.14,0:15:08.64,Default,,0000,0000,0000,,Қарт адамдар жоқ.
Dialogue: 0,0:15:08.64,0:15:11.81,Default,,0000,0000,0000,,Мен құбыжықпын
Dialogue: 0,0:15:08.64,0:15:11.81,Default,,0000,0000,0000,,Олардың қайда сақталғанын көргіңіз келе ме?
Dialogue: 0,0:15:11.81,0:15:16.15,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:15:11.81,0:15:16.15,Default,,0000,0000,0000,,Бүркіт жолда көрген егістік жерлерді аралағысы келеді.
Dialogue: 0,0:15:16.15,0:15:20.82,Default,,0000,0000,0000,,Иә, жақсы ма?
Dialogue: 0,0:15:16.15,0:15:20.82,Default,,0000,0000,0000,,Әрине, мен сізге бағыт-бағдар беремін.
Dialogue: 0,0:15:20.82,0:15:22.82,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:15:22.82,0:15:25.32,Default,,0000,0000,0000,,Мен осында күтемін.
Dialogue: 0,0:15:25.32,0:15:29.16,Default,,0000,0000,0000,,Мен Изуцумиді жалғыз қалдыра алмаймын.
Dialogue: 0,0:15:25.32,0:15:29.16,Default,,0000,0000,0000,,Мен де.
Dialogue: 0,0:15:29.16,0:15:32.83,Default,,0000,0000,0000,,Ми Минотавр! әйел! ?
Dialogue: 0,0:15:32.83,0:15:35.67,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:15:32.83,0:15:35.67,Default,,0000,0000,0000,,Сауын сиырларды ауыстырады.
Dialogue: 0,0:15:35.67,0:15:38.17,Default,,0000,0000,0000,,Неліктен құбыжықтарды мал ретінде пайдалану керек?
Dialogue: 0,0:15:35.67,0:15:38.17,Default,,0000,0000,0000,,(Мұғалім) О, қандай жаһандық көзқарас. (Цубаки) 《Уф! Сол сұм~》
Dialogue: 0,0:15:38.17,0:15:41.17,Default,,0000,0000,0000,,Қарапайым үй жануарлары
Dialogue: 0,0:15:38.17,0:15:41.17,Default,,0000,0000,0000,,Оны алу қиын болды.
Dialogue: 0,0:15:41.17,0:15:43.18,Default,,0000,0000,0000,,О...
Dialogue: 0,0:15:45.18,0:15:47.18,Default,,0000,0000,0000,,Конверт пе?
Dialogue: 0,0:15:49.68,0:15:54.19,Default,,0000,0000,0000,,Вум жақсы күтімді
Dialogue: 0,0:15:49.68,0:15:54.19,Default,,0000,0000,0000,,Бұл әдемі дала.
Dialogue: 0,0:15:54.19,0:15:59.53,Default,,0000,0000,0000,,Оны тек ауыл тұрғындары тұтына ма?
Dialogue: 0,0:15:54.19,0:15:59.53,Default,,0000,0000,0000,,Ысыраптың көп екені рас.
Dialogue: 0,0:15:59.53,0:16:03.30,Default,,0000,0000,0000,,Егер өріс болмаса
Dialogue: 0,0:15:59.53,0:16:03.30,Default,,0000,0000,0000,,Істейтін ештеңе қалмады.
Dialogue: 0,0:16:03.30,0:16:06.63,Default,,0000,0000,0000,,Формасы бойынша болса да жердегідей өмір сүру.
Dialogue: 0,0:16:03.30,0:16:06.63,Default,,0000,0000,0000,,Ол жалғасады.
Dialogue: 0,0:16:06.63,0:16:08.63,Default,,0000,0000,0000,,Не...
Dialogue: 0,0:16:08.63,0:16:12.04,Default,,0000,0000,0000,,Изуцуми, жақсысың ба?
Dialogue: 0,0:16:14.64,0:16:17.31,Default,,0000,0000,0000,,《Ол ауырмаған сияқты》
Dialogue: 0,0:16:17.31,0:16:21.31,Default,,0000,0000,0000,,Бұл! Бір сәтке бола ма?
Dialogue: 0,0:16:21.31,0:16:24.32,Default,,0000,0000,0000,,Хмм... көйлек?
Dialogue: 0,0:16:24.32,0:16:27.32,Default,,0000,0000,0000,,Иә! Біз тіккен киімдер!
Dialogue: 0,0:16:27.32,0:16:29.32,Default,,0000,0000,0000,,Әрқашан кезекпен жүріңіз
Dialogue: 0,0:16:27.32,0:16:29.32,Default,,0000,0000,0000,,Олар бірге киінген➡
Dialogue: 0,0:16:29.32,0:16:31.66,Default,,0000,0000,0000,,Бұл қызықсыз, өйткені бәрі бірдей жүздер...
Dialogue: 0,0:16:31.66,0:16:34.83,Default,,0000,0000,0000,,Мен болсам.
Dialogue: 0,0:16:31.66,0:16:34.83,Default,,0000,0000,0000,,Кя.
Dialogue: 0,0:16:34.83,0:16:38.00,Default,,0000,0000,0000,,Мен қайсысын таңдауым керек?
Dialogue: 0,0:16:34.83,0:16:38.00,Default,,0000,0000,0000,,Бұл қызыл ма?
Dialogue: 0,0:16:38.00,0:16:40.33,Default,,0000,0000,0000,,Кешіріңіз, сіздің көзқарасыңыз бойынша➡
Dialogue: 0,0:16:40.33,0:16:44.14,Default,,0000,0000,0000,,Мұның бәрі ескірген болуы мүмкін.
Dialogue: 0,0:16:40.33,0:16:44.14,Default,,0000,0000,0000,,Міне...
Dialogue: 0,0:16:47.34,0:16:51.84,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:16:47.34,0:16:51.84,Default,,0000,0000,0000,,《Бұл мен ойлағаннан басқаша...
Dialogue: 0,0:16:51.84,0:16:55.35,Default,,0000,0000,0000,,Сыртынан кесіңіз
Dialogue: 0,0:16:51.84,0:16:55.35,Default,,0000,0000,0000,,Мың жылдан кейін тенденциялар өзгере ме?
Dialogue: 0,0:16:55.35,0:16:57.35,Default,,0000,0000,0000,,Келесі - бұл.
Dialogue: 0,0:16:59.35,0:17:01.62,Default,,0000,0000,0000,,Пуха! Жақсы!
Dialogue: 0,0:17:01.62,0:17:05.46,Default,,0000,0000,0000,,Мен ішімдікке аздап талғампазмын.
Dialogue: 0,0:17:01.62,0:17:05.46,Default,,0000,0000,0000,,Бұл жаман емес!
Dialogue: 0,0:17:05.46,0:17:08.79,Default,,0000,0000,0000,,Бұл құрмет. еменге
Dialogue: 0,0:17:05.46,0:17:08.79,Default,,0000,0000,0000,,Мен оған ішетін бірдеңе беріп жатырмын➡
Dialogue: 0,0:17:08.79,0:17:11.46,Default,,0000,0000,0000,,Соңғылар
Dialogue: 0,0:17:08.79,0:17:11.46,Default,,0000,0000,0000,,Әсіресе жақсы беделге ие.
Dialogue: 0,0:17:11.46,0:17:14.47,Default,,0000,0000,0000,,Ммм... Керемет.
Dialogue: 0,0:17:14.47,0:17:16.64,Default,,0000,0000,0000,,Мұндай адамды қайдан тауып алдың?
Dialogue: 0,0:17:14.47,0:17:16.64,Default,,0000,0000,0000,,Сіз шарап жасайсыз ба?
Dialogue: 0,0:17:16.64,0:17:19.30,Default,,0000,0000,0000,,Негізі мен оны жақында ғана сала бастадым➡
Dialogue: 0,0:17:19.30,0:17:23.31,Default,,0000,0000,0000,,400 жыл бойы құрылысы жалғасты
Dialogue: 0,0:17:19.30,0:17:23.31,Default,,0000,0000,0000,,Алемен салыстырғанда бұл жақсы емес.
Dialogue: 0,0:17:23.31,0:17:27.81,Default,,0000,0000,0000,,400 жыл! Бұл бұрыннан қалыптасқан саке сыра зауыты!
Dialogue: 0,0:17:23.31,0:17:27.81,Default,,0000,0000,0000,,Сіз қай ұрпақсыз?
Dialogue: 0,0:17:27.81,0:17:31.32,Default,,0000,0000,0000,,Мен 600 жасымда бастадым
Dialogue: 0,0:17:27.81,0:17:31.32,Default,,0000,0000,0000,,Бірінші буын.
Dialogue: 0,0:17:31.32,0:17:32.85,Default,,0000,0000,0000,,А... Иә?
Dialogue: 0,0:17:31.32,0:17:32.85,Default,,0000,0000,0000,,Апамды айқайлата алмай тұрып, оған не істедің?
Dialogue: 0,0:17:32.85,0:17:35.85,Default,,0000,0000,0000,,Мен Минотаврды саууым керек!
Dialogue: 0,0:17:35.85,0:17:38.86,Default,,0000,0000,0000,,О, сен мұны істедің.
Dialogue: 0,0:17:35.85,0:17:38.86,Default,,0000,0000,0000,,Оны жүрегіңе жап.
Dialogue: 0,0:17:38.86,0:17:40.86,Default,,0000,0000,0000,,О, құдай!
Dialogue: 0,0:17:40.86,0:17:44.36,Default,,0000,0000,0000,,Мұнда, құбыжықтарды өсіру үшін.
Dialogue: 0,0:17:40.86,0:17:44.36,Default,,0000,0000,0000,,Толық сәтті!
Dialogue: 0,0:17:44.36,0:17:50.37,Default,,0000,0000,0000,,Міне! Бұл үлкен дриад фермасы!
Dialogue: 0,0:17:44.36,0:17:50.37,Default,,0000,0000,0000,,Сиыр сияқты төрт емшегі бар!
Dialogue: 0,0:17:50.37,0:17:53.37,Default,,0000,0000,0000,,Мен мас болып бара жатқан сияқтымын...
Dialogue: 0,0:17:53.37,0:17:58.04,Default,,0000,0000,0000,,Жоқ, бірақ бұл таңғажайып тәжірибе болды.
Dialogue: 0,0:17:53.37,0:17:58.04,Default,,0000,0000,0000,,Солай сауу...
Dialogue: 0,0:17:58.04,0:18:02.31,Default,,0000,0000,0000,,Енді ойлап қарасам, Марсиль мен Изуцуми...
Dialogue: 0,0:17:58.04,0:18:02.31,Default,,0000,0000,0000,,Есіңізде қалай қалды?
Dialogue: 0,0:18:02.31,0:18:04.82,Default,,0000,0000,0000,,О... күткенім үшін кешіріңіз...
Dialogue: 0,0:18:08.32,0:18:12.16,Default,,0000,0000,0000,,Боу! Бұл көріністе не бар!
Dialogue: 0,0:18:08.32,0:18:12.16,Default,,0000,0000,0000,,Сіз тым толқып тұрсыз!
Dialogue: 0,0:18:12.16,0:18:15.49,Default,,0000,0000,0000,,Жоқ, бұл!
Dialogue: 0,0:18:12.16,0:18:15.49,Default,,0000,0000,0000,,Менің мұны сұраудан басқа амалым қалмады...
Dialogue: 0,0:18:15.49,0:18:20.00,Default,,0000,0000,0000,,Бұл әлі де ең тыныш
Dialogue: 0,0:18:15.49,0:18:20.00,Default,,0000,0000,0000,,Мен оны таңдадым.
Dialogue: 0,0:18:20.00,0:18:22.33,Default,,0000,0000,0000,,Марсиль... Бұл...
Dialogue: 0,0:18:22.33,0:18:25.04,Default,,0000,0000,0000,,А... не... не?
Dialogue: 0,0:18:27.01,0:18:29.34,Default,,0000,0000,0000,,Неліктен Изуцуми?
Dialogue: 0,0:18:27.01,0:18:29.34,Default,,0000,0000,0000,,Сен мені сонша сағындың ба?
Dialogue: 0,0:18:29.34,0:18:32.34,Default,,0000,0000,0000,,А, бар! ?
Dialogue: 0,0:18:29.34,0:18:32.34,Default,,0000,0000,0000,,Неге деп таң қалдым! Міне осы! ?
Dialogue: 0,0:18:34.35,0:18:36.85,Default,,0000,0000,0000,,Дұшпан тұзақты тарылтып жатыр.
Dialogue: 0,0:18:34.35,0:18:36.85,Default,,0000,0000,0000,,Мен сәбиге айналып кеткендеймін.
Dialogue: 0,0:18:36.85,0:18:38.85,Default,,0000,0000,0000,,Эй.
Dialogue: 0,0:18:38.85,0:18:40.85,Default,,0000,0000,0000,,Мен оны жек көремін!
Dialogue: 0,0:18:38.85,0:18:40.85,Default,,0000,0000,0000,,Уф.
Dialogue: 0,0:18:40.85,0:18:44.36,Default,,0000,0000,0000,,Мұнда көптеген кедергілер бар.
Dialogue: 0,0:18:40.85,0:18:44.36,Default,,0000,0000,0000,,Өйткені ол көптеген қабаттармен жабылған➡
Dialogue: 0,0:18:44.36,0:18:47.86,Default,,0000,0000,0000,,Бұл Изцуми туралы.
Dialogue: 0,0:18:44.36,0:18:47.86,Default,,0000,0000,0000,,Мүмкін олар араласып жатқан шығар.
Dialogue: 0,0:18:47.86,0:18:51.03,Default,,0000,0000,0000,,Олардың жартысы құбыжықтар.
Dialogue: 0,0:18:47.86,0:18:51.03,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:18:51.03,0:18:55.87,Default,,0000,0000,0000,,Бірақ ол монстрлардың агрессиясын жояды.
Dialogue: 0,0:18:51.03,0:18:55.87,Default,,0000,0000,0000,,Мен ешқашан тосқауыл көрген емеспін.
Dialogue: 0,0:18:55.87,0:18:59.30,Default,,0000,0000,0000,,Мен мұны шеше алсам ғой.
Dialogue: 0,0:18:59.30,0:19:02.64,Default,,0000,0000,0000,,Мен бұрын көрмеген көптеген кейіпкерлер бар.
Dialogue: 0,0:18:59.30,0:19:02.64,Default,,0000,0000,0000,,Мұны бір түнде жасау мүмкін емес!
Dialogue: 0,0:19:02.64,0:19:06.48,Default,,0000,0000,0000,,Соңғы уақытта
Dialogue: 0,0:19:02.64,0:19:06.48,Default,,0000,0000,0000,,Барлығына цензура цензура!
Dialogue: 0,0:19:06.48,0:19:09.82,Default,,0000,0000,0000,,Бірақ бұл шынымен де ғажайып жер.
Dialogue: 0,0:19:09.82,0:19:15.15,Default,,0000,0000,0000,,Егер бұл жағдай болмаса
Dialogue: 0,0:19:09.82,0:19:15.15,Default,,0000,0000,0000,,Мен мәңгі қалғым келді.
Dialogue: 0,0:19:15.15,0:19:17.16,Default,,0000,0000,0000,,Мен де...
Dialogue: 0,0:19:21.49,0:19:23.50,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:19:21.49,0:19:23.50,Default,,0000,0000,0000,,(есіктің ашылған дыбысы)
Dialogue: 0,0:19:23.50,0:19:25.50,Default,,0000,0000,0000,,Күткендеріңізге рахмет.
Dialogue: 0,0:19:25.50,0:19:28.17,Default,,0000,0000,0000,,Бұл кішкентай нәрсе, бірақ
Dialogue: 0,0:19:25.50,0:19:28.17,Default,,0000,0000,0000,,Асқа дастархан жайылды.
Dialogue: 0,0:19:28.17,0:19:30.17,Default,,0000,0000,0000,,Мұнда келіңіз.
Dialogue: 0,0:19:30.17,0:19:33.17,Default,,0000,0000,0000,,(есіктің ашылған дыбысы)
Dialogue: 0,0:19:33.17,0:19:37.34,Default,,0000,0000,0000,,Барлығыңызға қош келдіңіздер.
Dialogue: 0,0:19:33.17,0:19:37.34,Default,,0000,0000,0000,,Мен сенімен танысқым келді.
Dialogue: 0,0:19:37.34,0:19:41.18,Default,,0000,0000,0000,,Менің атым Яад.
Dialogue: 0,0:19:37.34,0:19:41.18,Default,,0000,0000,0000,,Өздеріңіз білетіндей➡
Dialogue: 0,0:19:41.18,0:19:44.52,Default,,0000,0000,0000,,Ол Дельгалдың немересі.
Dialogue: 0,0:19:41.18,0:19:44.52,Default,,0000,0000,0000,,Делгал….
Dialogue: 0,0:19:44.52,0:19:46.52,Default,,0000,0000,0000,,Енді трубканы қойыңыз.
Dialogue: 0,0:19:46.52,0:19:51.19,Default,,0000,0000,0000,,Мені неге шақырдың?
Dialogue: 0,0:19:46.52,0:19:51.19,Default,,0000,0000,0000,,Мен сендерге ұзақ әңгіме айтып берейін.
Dialogue: 0,0:19:51.19,0:19:53.19,Default,,0000,0000,0000,,Тамақты ұсыну.
Dialogue: 0,0:19:59.70,0:20:02.37,Default,,0000,0000,0000,,Мм... мына ет...
Dialogue: 0,0:19:59.70,0:20:02.37,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:20:02.37,0:20:06.37,Default,,0000,0000,0000,,Барлығы мұны сұрағандай,
Dialogue: 0,0:20:02.37,0:20:06.37,Default,,0000,0000,0000,,Минотавр еті!
Dialogue: 0,0:20:06.37,0:20:08.54,Default,,0000,0000,0000,,Уау...!
Dialogue: 0,0:20:06.37,0:20:08.54,Default,,0000,0000,0000,,Гугу….
Dialogue: 0,0:20:08.54,0:20:11.71,Default,,0000,0000,0000,,Әркім де күнделікті.
Dialogue: 0,0:20:08.54,0:20:11.71,Default,,0000,0000,0000,,Сіз құбыжықтарды жейсіз бе?
Dialogue: 0,0:20:11.71,0:20:13.88,Default,,0000,0000,0000,,Оны кейбір адамдар жейді➡
Dialogue: 0,0:20:13.88,0:20:16.55,Default,,0000,0000,0000,,Негізі мен тамақ жемеймін.
Dialogue: 0,0:20:13.88,0:20:16.55,Default,,0000,0000,0000,,(Мұғалім) О, қандай жаһандық көзқарас. (Цубаки) 《Уф! Сол сұм~》
Dialogue: 0,0:20:16.55,0:20:19.38,Default,,0000,0000,0000,,Дәм сезуім түтіккен.
Dialogue: 0,0:20:16.55,0:20:19.38,Default,,0000,0000,0000,,Иә, бірақ➡
Dialogue: 0,0:20:19.38,0:20:23.39,Default,,0000,0000,0000,,Ең алдымен,
Dialogue: 0,0:20:19.38,0:20:23.39,Default,,0000,0000,0000,,Менің тәбетім жоқ.
Dialogue: 0,0:20:23.39,0:20:25.72,Default,,0000,0000,0000,,Бұл ашуланған сиқыршы➡
Dialogue: 0,0:20:25.72,0:20:28.33,Default,,0000,0000,0000,,Бізге қоңырау шалды
Dialogue: 0,0:20:25.72,0:20:28.33,Default,,0000,0000,0000,,Бұл өлмейтіндіктің қарғысы.
Dialogue: 0,0:20:31.23,0:20:33.73,Default,,0000,0000,0000,,Неліктен сиқыршы мұндай әрекетке барады?
Dialogue: 0,0:20:33.73,0:20:37.24,Default,,0000,0000,0000,,Қазір... есіме түскенше ➡
Dialogue: 0,0:20:37.24,0:20:42.41,Default,,0000,0000,0000,,Мен дұрыс сөйлей аламын.
Dialogue: 0,0:20:37.24,0:20:42.41,Default,,0000,0000,0000,,Өйткені ол мемлекет емес еді.
Dialogue: 0,0:20:42.41,0:20:46.91,Default,,0000,0000,0000,,Бірақ біз үшін алаңдамаңыз.
Dialogue: 0,0:20:42.41,0:20:46.91,Default,,0000,0000,0000,,Көңіліңіз жеткенше ләззат алыңыз!
Dialogue: 0,0:20:46.91,0:20:48.91,Default,,0000,0000,0000,,Тәбетіңіз болмаса да➡
Dialogue: 0,0:20:48.91,0:20:52.25,Default,,0000,0000,0000,,Басқа адамдардың тамақтанып жатқанын көру
Dialogue: 0,0:20:48.91,0:20:52.25,Default,,0000,0000,0000,,Бұл бір ғанибет.
Dialogue: 0,0:20:52.25,0:20:56.76,Default,,0000,0000,0000,,《2 адам: Мен оны жегім келмейді деп айта алмаймын.
Dialogue: 0,0:20:52.25,0:20:56.76,Default,,0000,0000,0000,,Бұл атмосфераға айналды》
Dialogue: 0,0:20:58.69,0:21:00.69,Default,,0000,0000,0000,,Менің атам...
Dialogue: 0,0:21:00.69,0:21:02.69,Default,,0000,0000,0000,,Ашуланған сиқыршы➡
Dialogue: 0,0:21:02.69,0:21:05.86,Default,,0000,0000,0000,,Қара магияға бет бұруға не себеп болды?
Dialogue: 0,0:21:02.69,0:21:05.86,Default,,0000,0000,0000,,Бұл менің кінәм➡
Dialogue: 0,0:21:05.86,0:21:08.37,Default,,0000,0000,0000,,Ол көптен бері ауырған сияқты.
Dialogue: 0,0:21:08.37,0:21:13.54,Default,,0000,0000,0000,,Және көмек сұрау
Dialogue: 0,0:21:08.37,0:21:13.54,Default,,0000,0000,0000,,Ол жерге қарай беттеді.
Dialogue: 0,0:21:13.54,0:21:16.54,Default,,0000,0000,0000,,Атам туралы
Dialogue: 0,0:21:13.54,0:21:16.54,Default,,0000,0000,0000,,Жер бетінде қалай?
Dialogue: 0,0:21:16.54,0:21:18.54,Default,,0000,0000,0000,,Менің естуім бойынша➡
Dialogue: 0,0:21:18.54,0:21:21.38,Default,,0000,0000,0000,,(Реинер) Гү!
Dialogue: 0,0:21:18.54,0:21:21.38,Default,,0000,0000,0000,,Ауыл катакомбаларынан шығады➡
Dialogue: 0,0:21:21.38,0:21:23.38,Default,,0000,0000,0000,,Өзін жер аударылған патшалықтың патшасы деп атаған➡
Dialogue: 0,0:21:23.38,0:21:27.39,Default,,0000,0000,0000,,Жынды сиқыршыны жеңетіндерге
Dialogue: 0,0:21:23.38,0:21:27.39,Default,,0000,0000,0000,,Ел үшін бәрін жасаймын деп айт➡
Dialogue: 0,0:21:27.39,0:21:31.22,Default,,0000,0000,0000,,Шаңға айналады...
Dialogue: 0,0:21:27.39,0:21:31.22,Default,,0000,0000,0000,,Мен...
Dialogue: 0,0:21:31.22,0:21:36.23,Default,,0000,0000,0000,,Атам аурудан құтылды.
Dialogue: 0,0:21:31.22,0:21:36.23,Default,,0000,0000,0000,,Ең болмаса жұбаныш болар.
Dialogue: 0,0:21:36.23,0:21:40.23,Default,,0000,0000,0000,,Көптеген адамдар қарғыстан құтылуға тырысады.
Dialogue: 0,0:21:36.23,0:21:40.23,Default,,0000,0000,0000,,Мен ауылдан шықтым.
Dialogue: 0,0:21:40.23,0:21:45.74,Default,,0000,0000,0000,,Бірақ ешкім табысқа жете алмады
Dialogue: 0,0:21:40.23,0:21:45.74,Default,,0000,0000,0000,,Ол жай ғана физикалық денесінен айырылды.
Dialogue: 0,0:21:45.74,0:21:50.74,Default,,0000,0000,0000,,Денеңізді жоғалтқанда, сіз бірте-бірте өзіңізді сезінесіз.
Dialogue: 0,0:21:45.74,0:21:50.74,Default,,0000,0000,0000,,Зұлым рухқа айналады.
Dialogue: 0,0:21:50.74,0:21:53.25,Default,,0000,0000,0000,,Мұнда қайтып келу
Dialogue: 0,0:21:50.74,0:21:53.25,Default,,0000,0000,0000,,№.
Dialogue: 0,0:21:53.25,0:21:57.08,Default,,0000,0000,0000,,Сіз онымен бірнеше рет кездескен болуыңыз керек.
Dialogue: 0,0:21:53.25,0:21:57.08,Default,,0000,0000,0000,,《3 адам: Мен жасадым!
Dialogue: 0,0:21:57.08,0:22:01.52,Default,,0000,0000,0000,,Олар маған қасиетті суды лақтырды
Dialogue: 0,0:21:57.08,0:22:01.52,Default,,0000,0000,0000,,Мен тіпті шербет жасадым! 》
Dialogue: 0,0:22:01.52,0:22:06.19,Default,,0000,0000,0000,,Бір, екі, үш.
Dialogue: 0,0:22:01.52,0:22:06.19,Default,,0000,0000,0000,,Бізді мұнда не үшін шақырды?
Dialogue: 0,0:22:06.19,0:22:09.36,Default,,0000,0000,0000,,Бұл пайғамбарлық.
Dialogue: 0,0:22:06.19,0:22:09.36,Default,,0000,0000,0000,,Пайғамбарлық?
Dialogue: 0,0:22:06.19,0:22:09.36,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:22:09.36,0:22:14.53,Default,,0000,0000,0000,,«Қолында қанатты қылыш бар.
Dialogue: 0,0:22:09.36,0:22:14.53,Default,,0000,0000,0000,,Ашуланған сиқыршыны жеңіңіз➡
Dialogue: 0,0:22:14.53,0:22:17.54,Default,,0000,0000,0000,,Ол бізді босатады».
Dialogue: 0,0:22:17.54,0:22:20.04,Default,,0000,0000,0000,,Қанаттар?
Dialogue: 0,0:22:17.54,0:22:20.04,Default,,0000,0000,0000,,Кенсуке ше?
Dialogue: 0,0:22:20.04,0:22:22.71,Default,,0000,0000,0000,,Оның қанаттары бар, бірақ...
Dialogue: 0,0:22:22.71,0:22:25.88,Default,,0000,0000,0000,,Бұл! ? Оның бетінде арыстан бар! ?
Dialogue: 0,0:22:25.88,0:22:27.88,Default,,0000,0000,0000,,Мен мұны білмей тұрып...
Dialogue: 0,0:22:25.88,0:22:27.88,Default,,0000,0000,0000,,Мұнда ешкім жоқ сияқты. (Ұшқыш А) Жоқ, бар.
Dialogue: 0,0:22:27.88,0:22:30.72,Default,,0000,0000,0000,,Қанатты арыстан – бұл елдің қамқоршысы.
Dialogue: 0,0:22:30.72,0:22:34.89,Default,,0000,0000,0000,,Ақылсыз сиқыршы
Dialogue: 0,0:22:30.72,0:22:34.89,Default,,0000,0000,0000,,Лабиринттің түбінде қамалған➡
Dialogue: 0,0:22:34.89,0:22:37.72,Default,,0000,0000,0000,,Арман арқылы болашақты болжау➡
Dialogue: 0,0:22:37.72,0:22:40.39,Default,,0000,0000,0000,,Ол әлі күнге дейін бізге жол көрсетеді.
Dialogue: 0,0:22:40.39,0:22:44.90,Default,,0000,0000,0000,,Менің атам жерге аттанды.
Dialogue: 0,0:22:40.39,0:22:44.90,Default,,0000,0000,0000,,Пайғамбарлық триггер болды.
Dialogue: 0,0:22:44.90,0:22:49.57,Default,,0000,0000,0000,,Лорд Лайос Пайғамбарлық осылай жалғасады.
Dialogue: 0,0:22:49.57,0:22:54.57,Default,,0000,0000,0000,,«Қанатты қылыш
Dialogue: 0,0:22:49.57,0:22:54.57,Default,,0000,0000,0000,,Ашуланған сиқыршыны жеңіңіз➡
Dialogue: 0,0:22:54.57,0:22:59.01,Default,,0000,0000,0000,,Бұл елдің жаңасы
Dialogue: 0,0:22:54.57,0:22:59.01,Default,,0000,0000,0000,,Ол патша болады».
Dialogue: 0,0:22:54.57,0:22:59.01,Default,,0000,0000,0000,,М-м-мұнда… мұнда… мұнда… осы зат!
Dialogue: 0,0:22:59.01,0:23:03.18,Default,,0000,0000,0000,,Бұл! Сіз қате адамсыз!
Dialogue: 0,0:22:59.01,0:23:03.18,Default,,0000,0000,0000,,Мен бұл қылышты кездейсоқ тауып алдым!
Dialogue: 0,0:23:03.18,0:23:05.18,Default,,0000,0000,0000,,Кездейсоқ емес.
Dialogue: 0,0:23:05.18,0:23:07.19,Default,,0000,0000,0000,,Міне, қазір
Dialogue: 0,0:23:05.18,0:23:07.19,Default,,0000,0000,0000,,Бар болу ➡ дегенді білдіреді
Dialogue: 0,0:23:07.19,0:23:10.19,Default,,0000,0000,0000,,Қандай шешім қабылданды
Бұл
Dialogue: 0,0:23:07.19,0:23:10.19,Default,,0000,0000,0000,,болса керек.
Dialogue: 0,0:23:10.19,0:23:13.36,Default,,0000,0000,0000,,Лорд Лайос.
Dialogue: 0,0:23:13.36,0:23:16.19,Default,,0000,0000,0000,,Маған уәде бере аласыз ба?
Dialogue: 0,0:23:16.19,0:23:18.53,Default,,0000,0000,0000,,Ашуланған сиқыршыны жеңіңіз➡
Dialogue: 0,0:23:18.53,0:23:23.03,Default,,0000,0000,0000,,Сіз бізді босататын едіңіз.
Dialogue: 0,0:23:18.53,0:23:23.03,Default,,0000,0000,0000,,Уау….
Dialogue: 0,0:23:18.53,0:23:23.03,Default,,0000,0000,0000,,(Самурай) Батырлар мықты. Батырлар жалғыз…
Dialogue: 0,0:23:23.03,0:23:25.04,Default,,0000,0000,0000,,Ум...
Dialogue: 0,0:23:29.04,0:23:32.71,Default,,0000,0000,0000,,Бір сәт ойланып көрейін.
Dialogue: 0,0:23:32.71,0:23:36.55,Default,,0000,0000,0000,,Жоқ, жоқ деп айтыңыз.
Dialogue: 0,0:23:32.71,0:23:36.55,Default,,0000,0000,0000,,Неліктен кез келген мүмкіндікті ашық қалдырасыз?
Dialogue: 0,0:23:36.55,0:23:39.22,Default,,0000,0000,0000,,Бірақ бәрібір мұны істей алмайсыз.
Dialogue: 0,0:23:39.22,0:23:43.22,Default,,0000,0000,0000,,Кенсуке, қанша уақыт болдыңыз?
Dialogue: 0,0:23:39.22,0:23:43.22,Default,,0000,0000,0000,,Ол осылай көрінді.
Dialogue: 0,0:23:43.22,0:23:47.23,Default,,0000,0000,0000,,Зынданда тазалағыш
Dialogue: 0,0:23:43.22,0:23:47.23,Default,,0000,0000,0000,,Тамақ жегенде күдікті.
Dialogue: 0,0:23:47.23,0:23:51.06,Default,,0000,0000,0000,,Тамақ әзірлеуге қобалжығанымнан шығар➡
Dialogue: 0,0:23:51.06,0:23:53.90,Default,,0000,0000,0000,,Не жесең де
Dialogue: 0,0:23:51.06,0:23:53.90,Default,,0000,0000,0000,,Дәмін түсінбедім...
Dialogue: 0,0:23:53.90,0:23:56.23,Default,,0000,0000,0000,,Жақсы….
Dialogue: 0,0:23:53.90,0:23:56.23,Default,,0000,0000,0000,,Бұл жігіт қу!
Dialogue: 0,0:23:56.23,0:23:59.34,Default,,0000,0000,0000,,«Әркімнің қалауы» дегеніміз не?
Dialogue: 0,0:23:56.23,0:23:59.34,Default,,0000,0000,0000,,Гррр….
Dialogue: 0,0:23:59.34,0:24:03.18,Default,,0000,0000,0000,,Іс жүзінде оның дәмі жоқтың қасы.
Dialogue: 0,0:23:59.34,0:24:03.18,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:24:03.18,0:24:06.68,Default,,0000,0000,0000,,Оларда тамақ жоқ.
Dialogue: 0,0:24:03.18,0:24:06.68,Default,,0000,0000,0000,,Ол бұл қажет емес екенін айтты.
Dialogue: 0,0:24:06.68,0:24:10.68,Default,,0000,0000,0000,,Осылайша сіз жақсы пісіре аласыз.
Dialogue: 0,0:24:06.68,0:24:10.68,Default,,0000,0000,0000,,Мүмкін орындай алмаған шығар.
Dialogue: 0,0:24:10.68,0:24:12.85,Default,,0000,0000,0000,,Мен бұл туралы көптен бері ойлап жүрдім.
Dialogue: 0,0:24:12.85,0:24:17.36,Default,,0000,0000,0000,,Табиғаты бойынша
Dialogue: 0,0:24:12.85,0:24:17.36,Default,,0000,0000,0000,,Өрістерге немесе ыдыс-аяқтарға қажеттілік болмауы керек➡
Dialogue: 0,0:24:17.36,0:24:19.86,Default,,0000,0000,0000,,Неліктен олардың бәрі сонда?
Dialogue: 0,0:24:19.86,0:24:23.86,Default,,0000,0000,0000,,Мың жыл бойы
Dialogue: 0,0:24:19.86,0:24:23.86,Default,,0000,0000,0000,,Оларға не үшін қамқорлық жасау керек➡
Dialogue: 0,0:24:23.86,0:24:26.03,Default,,0000,0000,0000,,Сіз оны сақтауды жалғастырдыңыз ба?
Dialogue: 0,0:24:26.03,0:24:29.53,Default,,0000,0000,0000,,Бұл әлі де
Dialogue: 0,0:24:26.03,0:24:29.53,Default,,0000,0000,0000,,Қажет болғандықтан шығар.
Dialogue: 0,0:24:29.53,0:24:35.21,Default,,0000,0000,0000,,Егер олар есі дұрыс болса
Dialogue: 0,0:24:29.53,0:24:35.21,Default,,0000,0000,0000,,Өмір сүруді жалғастыру үшін...
Dialogue: 0,0:24:35.21,0:24:37.21,Default,,0000,0000,0000,,Лайос.
Dialogue: 0,0:24:35.21,0:24:37.21,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:24:37.21,0:24:42.38,Default,,0000,0000,0000,,Мен бір кездері орктардың басшысы болдым.
Dialogue: 0,0:24:37.21,0:24:42.38,Default,,0000,0000,0000,,Сіздің айтқаныңыз есімде.
Dialogue: 0,0:24:42.38,0:24:46.22,Default,,0000,0000,0000,,А... не болды?
Dialogue: 0,0:24:46.22,0:24:49.82,Default,,0000,0000,0000,,Бір түн ойланыңыз.
Dialogue: 0,0:24:52.06,0:24:56.06,Default,,0000,0000,0000,,Мен де осында ұйықтай аламын ба?
Dialogue: 0,0:24:52.06,0:24:56.06,Default,,0000,0000,0000,,Берілген бөлмеде ұйықтау.
Dialogue: 0,0:24:56.06,0:24:59.83,Default,,0000,0000,0000,,Мен жалғыз қалғым келмейді!
Dialogue: 0,0:24:56.06,0:24:59.83,Default,,0000,0000,0000,,Изицуми де біртүрлі.
Dialogue: 0,0:24:59.83,0:25:02.83,Default,,0000,0000,0000,,Қаптама және орау.
Dialogue: 0,0:24:59.83,0:25:02.83,Default,,0000,0000,0000,,Еденде ұйықта!
Dialogue: 0,0:25:02.83,0:25:05.24,Default,,0000,0000,0000,,《Қолдарым суық болды...》
Dialogue: 0,0:25:06.74,0:25:12.74,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory