Dialogue: 0,0:00:43.60,0:00:48.02,Default,,0,0,0,,Бұл субтитрді Мэн Чая жазған және коммерциялық алмасу мақсаттарына арналған.
Dialogue: 0,0:00:43.60,0:00:48.02,Default,,0,0,0,,Жапон: Ронни аудармасы/Уақыты: Неметон Кейінгі кезең: MIR
Dialogue: 1,0:00:03.54,0:00:06.15,Dialogue_JP,,0,0,0,,Бұл шағын ауылдан басталды
Dialogue: 1,0:00:07.25,0:00:11.61,Dialogue_JP,,0,0,0,,Бір күні азғантай дүбірмен катакомбалардың түбі шығып кетті.
Dialogue: 1,0:00:12.01,0:00:14.51,Dialogue_JP,,0,0,0,,Арт жақтан бір адам көрінді.
Dialogue: 1,0:00:15.17,0:00:19.54,Dialogue_JP,,0,0,0,,Бір адам 1000 жыл бұрын жойылған алтын патшалықтың патшасымын дейді.
Dialogue: 1,0:00:20.55,0:00:22.77,Dialogue_JP,,0,0,0,,Бір кездегі гүлденген ел
Dialogue: 1,0:00:22.93,0:00:28.81,Dialogue_JP,,0,0,0,,Айтуларынша, ол әлі күнге дейін жер астында құтырған сиқыршының тұтқынында.
Dialogue: 1,0:00:29.65,0:00:33.61,Dialogue_JP,,0,0,0,,Сиқыршыны жеңгенге, Елімнің бәрін беремін.
Dialogue: 1,0:00:34.70,0:00:38.75,Dialogue_JP,,0,0,0,,Осыны айтып, адам шаңға айналып, ғайып болды.
Dialogue: 1,0:00:58.69,0:00:59.61,Dialogue_JP,,0,0,0,,Барлығына сәттілік
Dialogue: 1,0:01:00.05,0:01:02.16,Dialogue_JP,,0,0,0,,Осы айдаһарды жеңсек, тағы бір мүмкіндігіміз бар.
Dialogue: 1,0:01:02.70,0:01:03.38,Dialogue_JP,,0,0,0,,Кеттік
Dialogue: 1,0:01:04.88,0:01:06.15,Dialogue_JP,,0,0,0,,Толық дайындалды
Dialogue: 1,0:01:06.48,0:01:07.87,Dialogue_JP,,0,0,0,,Жоғалтқан ештеңе жоқ
Dialogue: 1,0:01:13.78,0:01:14.45,Dialogue_JP,,0,0,0,,Жоқ
Dialogue: 1,0:01:16.24,0:01:17.51,Dialogue_JP,,0,0,0,,Менің қарным ашты.
Dialogue: 1,0:01:20.01,0:01:22.26,Dialogue_JP,,0,0,0,,Әркімнің қимылы аз.
Dialogue: 1,0:01:23.35,0:01:26.90,Dialogue_JP,,0,0,0,,Мен мұнда келер алдында картадан қателескендіктен, бір күнді қыдырдым.
Dialogue: 1,0:01:27.17,0:01:30.17,Dialogue_JP,,0,0,0,,Мен тұзаққа түсіп, 3 күндік тамақты жоғалттым.
Dialogue: 1,0:01:35.39,0:01:36.59,Dialogue_JP,,0,0,0,,Бұл қиын, бірақ
Dialogue: 1,0:01:36.78,0:01:39.51,Dialogue_JP,,0,0,0,,Айдаһарды жеңгеннен кейін артқа бұрылу керек.
Dialogue: 1,0:01:39.79,0:01:40.55,Dialogue_JP,,0,0,0,,Аға
Dialogue: 1,0:01:41.48,0:01:42.64,Dialogue_JP,,0,0,0,,Фарин не болды?
Dialogue: 1,0:01:42.87,0:01:44.88,Dialogue_JP,,0,0,0,,Сіз шатасу сиқырының астында қалдыңыз ба?
Dialogue: 1,0:01:53.48,0:01:54.50,Dialogue_JP,,0,0,0,,Бұл өтірік
Dialogue: 1,0:01:55.19,0:01:58.17,Dialogue_JP,,0,0,0,,Осы сияқты ең терең тереңдікте жойылу
Dialogue: 1,0:01:59.36,0:02:02.23,Dialogue_JP,,0,0,0,,... қашу үшін
Dialogue: 1,0:02:14.04,0:02:14.84,Dialogue_JP,,0,0,0,,Лайос
Dialogue: 1,0:02:19.48,0:02:20.33,Dialogue_JP,,0,0,0,,Және біз бастаймыз
Dialogue: 1,0:02:21.18,0:02:25.08,Dialogue_JP,,0,0,0,,Біз лабиринттен сиқырдың көмегімен құтылған сияқтымыз.
Dialogue: 1,0:02:25.99,0:02:28.12,Dialogue_JP,,0,0,0,,Бірақ Фарин еш жерде жоқ.
Dialogue: 1,0:02:31.61,0:02:32.57,Dialogue_JP,,0,0,0,,Мені жеп қойды.
Dialogue: 1,0:02:34.61,0:02:37.16,Dialogue_JP,,0,0,0,,Айдаһардың ішінде сиқыр жұмыс істемеді.
Dialogue: 1,0:02:37.98,0:02:39.03,Dialogue_JP,,0,0,0,,Мұндай нәрсе
Dialogue: 1,0:02:39.68,0:02:41.07,Dialogue_JP,,0,0,0,,Әлі лабиринтте шығар.
Dialogue: 1,0:02:41.82,0:02:42.93,Dialogue_JP,,0,0,0,,Қазір көмектесейік
Dialogue: 1,0:02:43.46,0:02:44.85,Dialogue_JP,,0,0,0,,Мен… осындай күйде телефон шала алмаймын.
Dialogue: 1,0:02:46.13,0:02:50.75,Dialogue_JP,,0,0,0,,Негізі, жүктеріміздің көп бөлігін лабиринтке тастап кеткен сияқтымыз.
Dialogue: 1,0:02:51.49,0:02:53.14,Dialogue_JP,,0,0,0,,Басқаша айтқанда, тиынсыз дерлік.
Dialogue: 1,0:02:53.34,0:02:54.11,Dialogue_JP,,0,0,0,,Қорқып қалмаңдар
Dialogue: 1,0:02:54.27,0:02:56.10,Dialogue_JP,,0,0,0,,Және одан да нашар
Dialogue: 1,0:02:56.25,0:02:56.96,Dialogue_JP,,0,0,0,,Чилчак
Dialogue: 1,0:02:57.69,0:03:00.22,Dialogue_JP,,0,0,0,,Мен екі досымнан айырылдым.
Dialogue: 1,0:03:01.26,0:03:01.97,Dialogue_JP,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 1,0:03:02.72,0:03:06.01,Dialogue_JP,,0,0,0,,Шамасы, оны біраз уақыттан бері басқа тарап сұраған.
Dialogue: 1,0:03:08.42,0:03:10.57,Dialogue_JP,,0,0,0,,Лабиринтті зерттеу ақшаны қажет етеді
Dialogue: 1,0:03:10.86,0:03:13.20,Dialogue_JP,,0,0,0,,Серіктесті жұмысқа орналастыру шығындары Жабдық шығындары
Dialogue: 1,0:03:13.36,0:03:14.66,Dialogue_JP,,0,0,0,,Және азық-түлік шығындары
Dialogue: 1,0:03:15.30,0:03:18.98,Dialogue_JP,,0,0,0,,Қолда бар қару-жарақты сатып, ақшаны әзірше қамтамасыз етейік.
Dialogue: 1,0:03:19.27,0:03:21.39,Dialogue_JP,,0,0,0,,Бұл ақшаны арзанырақ қару сатып алуға жұмсаңыз
Dialogue: 1,0:03:21.62,0:03:26.05,Dialogue_JP,,0,0,0,,Азық-түлік және дәрі-дәрмек Күнделікті қажетті заттарды жинап, жаңа одақтастарды жалдаңыз
Dialogue: 1,0:03:26.50,0:03:27.28,Dialogue_JP,,0,0,0,,Бұл жеткілікті ме?
Dialogue: 1,0:03:27.44,0:03:28.25,Dialogue_JP,,0,0,0,,Мүлдем емес
Dialogue: 1,0:03:29.28,0:03:32.56,Dialogue_JP,,0,0,0,,Әпкем менің құрал-жабдықтарымды дайындап жатқанда қорытылды.
Dialogue: 1,0:03:33.41,0:03:36.03,Dialogue_JP,,0,0,0,,Шап-шайқанша тірілткен жігіт болды.
Dialogue: 1,0:03:36.25,0:03:38.39,Dialogue_JP,,0,0,0,,Тәжіктен өмірге оралған авантюристтің мысалы
Dialogue: 1,0:03:39.13,0:03:40.61,Dialogue_JP,,0,0,0,,Мен бұл туралы ешқашан естіген емеспін.
Dialogue: 1,0:03:44.94,0:03:46.71,Dialogue_JP,,0,0,0,,Менде ақша мәселесі бар.
Dialogue: 1,0:03:46.88,0:03:48.41,Dialogue_JP,,0,0,0,,Мен әзірге ештеңе жемеймін.
Dialogue: 1,0:03:48.57,0:03:51.82,Dialogue_JP,,0,0,0,,Біз аш болғандықтан сәтсіздікке ұшыраған сияқтымыз.
Dialogue: 1,0:03:53.19,0:03:54.80,Dialogue_JP,,0,0,0,,Біз не жейміз?
Dialogue: 1,0:03:54.99,0:03:58.28,Dialogue_JP,,0,0,0,,Арзан тамақ алғыңыз келсе, орталық көшедегі танымал мейрамханаға барыңыз.
Dialogue: 1,0:03:58.53,0:04:00.96,Dialogue_JP,,0,0,0,,Саны бар «Күлуші Қасқыр Тей».
Dialogue: 1,0:04:01.66,0:04:03.89,Dialogue_JP,,0,0,0,,Бірақ мен де ол бардан бас тарта алмаймын.
Dialogue: 1,0:04:04.01,0:04:06.83,Dialogue_JP,,0,0,0,,Сол мейрамханадағы ет сорпасы өте дәмді.
Dialogue: 1,0:04:07.15,0:04:07.64,Dialogue_JP,,0,0,0,,Жоқ
Dialogue: 1,0:04:09.16,0:04:11.13,Dialogue_JP,,0,0,0,,Біз қазір лабиринтке сүңгуіміз керек.
Dialogue: 1,0:04:11.41,0:04:12.96,Dialogue_JP,,0,0,0,,Тағдырымыз өріліп-жалғассын
Dialogue: 1,0:04:13.19,0:04:14.34,Dialogue_JP,,0,0,0,,Менің бір ойым бар.
Dialogue: 1,0:04:15.25,0:04:17.07,Dialogue_JP,,0,0,0,,Екеуі кештен кетсін.
Dialogue: 1,0:04:18.14,0:04:21.53,Dialogue_JP,,0,0,0,,Сосын мен құрал-жабдықты сатып, лабиринтке өзім сүңгемін.
Dialogue: 1,0:04:21.95,0:04:23.39,Dialogue_JP,,0,0,0,,Бұл өте ақылсыз
Dialogue: 1,0:04:23.39,0:04:24.49,Dialogue_JP,,0,0,0,,...
Dialogue: 1,0:04:24.75,0:04:28.00,Dialogue_JP,,0,0,0,,Жоқ, осылайша қарудың өнімділігін төмендетпей-ақ жасауға болады.
Dialogue: 1,0:04:28.23,0:04:31.74,Dialogue_JP,,0,0,0,,Егер сіз жалғыз болсаңыз, құбыжықтардан аулақ бола аласыз және ең аз шайқаспен ең терең қабатқа бара аласыз.
Dialogue: 1,0:04:32.09,0:04:33.48,Dialogue_JP,,0,0,0,,Бұл мүмкін емес
Dialogue: 1,0:04:34.17,0:04:35.80,Dialogue_JP,,0,0,0,,Бастапқыда бұл менің кінәм болды.
Dialogue: 1,0:04:36.23,0:04:38.66,Dialogue_JP,,0,0,0,,Мен екі адамға қауіпті нәрсе жасауға рұқсат ете алмаймын.
Dialogue: 1,0:04:41.68,0:04:43.28,Dialogue_JP,,0,0,0,,Мен де міндетті түрде барамын.
Dialogue: 1,0:04:43.59,0:04:45.69,Dialogue_JP,,0,0,0,,Мен Фаринге көмектесу үшін бәрін жасаймын.
Dialogue: 1,0:04:45.95,0:04:48.09,Dialogue_JP,,0,0,0,,Мен де Фаринді жақсы көремін.
Dialogue: 1,0:04:49.57,0:04:51.27,Dialogue_JP,,0,0,0,,Кедергі болдым демеймін
Dialogue: 1,0:04:51.68,0:04:54.34,Dialogue_JP,,0,0,0,,Менің сиқырымның қаншалықты күшті екенін білесің.
Dialogue: 1,0:04:54.81,0:04:57.25,Dialogue_JP,,0,0,0,,Адамдар да менің жұмысымды ұмытып кетсе, қиын болар еді.
Dialogue: 1,0:04:57.57,0:05:00.74,Dialogue_JP,,0,0,0,,Мен есіктер мен қақпандарды ашудың қажеті жоқ деп айтпаймын.
Dialogue: 1,0:05:01.54,0:05:02.82,Dialogue_JP,,0,0,0,,Екеуі де
Dialogue: 1,0:05:06.03,0:05:09.13,Dialogue_JP,,0,0,0,,Сізде шынымен де маған еруге ерік бар.
Dialogue: 1,0:05:09.32,0:05:10.95,Dialogue_JP,,0,0,0,,Не болса да
Dialogue: 1,0:05:12.48,0:05:13.66,Dialogue_JP,,0,0,0,,Ух... иә
Dialogue: 1,0:05:15.31,0:05:17.86,Dialogue_JP,,0,0,0,,Лабиринт ішінде тамақ өзін-өзі қамтамасыз етеді.
Dialogue: 1,0:05:19.33,0:05:21.53,Dialogue_JP,,0,0,0,,Лабиринт құбыжықтарға толы.
Dialogue: 1,0:05:21.79,0:05:24.92,Dialogue_JP,,0,0,0,,Басқаша айтқанда, экожүйе бар.
Dialogue: 1,0:05:25.56,0:05:28.81,Dialogue_JP,,0,0,0,,Етқоректі құбыжықтар болса, олармен қоректенетін шөпқоректі құбыжықтар бар.
Dialogue: 1,0:05:29.06,0:05:33.78,Dialogue_JP,,0,0,0,,Шөпқоректі құбыжықтар жейтін өсімдіктерде қоректенетін су, жарық, топырақ бар.
Dialogue: 1,0:05:34.22,0:05:38.15,Dialogue_JP,,0,0,0,,Басқаша айтқанда, адамдар лабиринтте де өмір сүре алады.
Dialogue: 1,0:05:41.48,0:05:42.90,Dialogue_JP,,0,0,0,,Бұл дегеніміз
Dialogue: 1,0:05:43.24,0:05:44.81,Dialogue_JP,,0,0,0,,Құбыжықтарды жеу
Dialogue: 1,0:05:45.20,0:05:46.63,Dialogue_JP,,0,0,0,,Құбыжықтар да жейді
Dialogue: 1,0:05:47.04,0:05:49.05,Dialogue_JP,,0,0,0,,Өткен шытырман оқиғаларыңызды еске түсіріңіз.
Dialogue: 1,0:05:49.63,0:05:52.46,Dialogue_JP,,0,0,0,,Өте дәмді нәрсе болуы керек.
Dialogue: 1,0:05:53.69,0:05:54.84,Dialogue_JP,,0,0,0,,Негізсіз мүмкін емес
Dialogue: 1,0:05:54.84,0:05:56.01,Dialogue_JP,,0,0,0,,Мүлде мүмкін емес
Dialogue: 1,0:05:56.37,0:05:59.21,Dialogue_JP,,0,0,0,,Құбыжықтарды аулайтын және жейтін адамдар аз емес.
Dialogue: 1,0:05:59.58,0:06:02.56,Dialogue_JP,,0,0,0,,Сіз жерге орала алмайтын қылмыскерлер туралы айтып отырсыз.
Dialogue: 1,0:06:02.73,0:06:06.21,Dialogue_JP,,0,0,0,,Олар тамақтан улану салдарынан ауруханаға жиі жеткізіледі.
Dialogue: 1,0:06:06.71,0:06:09.37,Dialogue_JP,,0,0,0,,Сіз Фаринге көмектесу үшін бәрін жасаймын дедіңіз.
Dialogue: 1,0:06:09.52,0:06:11.49,Dialogue_JP,,0,0,0,,Мен құбыжықтарды жеймін деп айтқан жоқпын.
Dialogue: 1,0:06:11.60,0:06:12.83,Dialogue_JP,,0,0,0,,Ақша немесе уақыт жоқ
Dialogue: 1,0:06:13.10,0:06:14.13,Dialogue_JP,,0,0,0,,Басқа ойларыңыз бар ма?
Dialogue: 1,0:06:14.33,0:06:17.34,Dialogue_JP,,0,0,0,,Сондықтан мен біртүрлі тамақ жеп, тамақтан уланғандықтан қозғала алмай қалдым.
Dialogue: 1,0:06:17.34,0:06:18.72,Dialogue_JP,,0,0,0,,Бұл мағынасыз.
Dialogue: 1,0:06:19.97,0:06:21.05,Dialogue_JP,,0,0,0,,Құдай-ай, оны тауып алуға тура келеді
Dialogue: 1,0:06:21.05,0:06:22.23,Dialogue_JP,,0,0,0,,Бұл мүмкін емес қой?
Dialogue: 1,0:06:27.61,0:06:29.98,Dialogue_JP,,0,0,0,,Сіз лабиринтпен жаңадан таныссыз.
Dialogue: 1,0:06:30.46,0:06:33.83,Dialogue_JP,,0,0,0,,Толық жою бұл деңгейдегі құбыжықтар үшін жарамсыз.
Dialogue: 1,0:06:34.85,0:06:36.91,Dialogue_JP,,0,0,0,,Сәлем Лайос
Dialogue: 1,0:06:38.00,0:06:39.75,Dialogue_JP,,0,0,0,,Бүгін түскі асқа мұны жасайық.
Dialogue: 1,0:06:40.23,0:06:41.87,Dialogue_JP,,0,0,0,,Мен осындамын ғой?
Dialogue: 1,0:06:42.14,0:06:43.34,Dialogue_JP,,0,0,0,,Жоқ, жоқ, жоқ, жоқ.
Dialogue: 1,0:06:43.34,0:06:45.10,Dialogue_JP,,0,0,0,,Мүлдем жоқ
Dialogue: 1,0:06:45.10,0:06:47.68,Dialogue_JP,,0,0,0,,Саңырауқұлақтарды кенеттен көру қауіпті емес пе?
Dialogue: 1,0:06:47.84,0:06:49.63,Dialogue_JP,,0,0,0,,«Лабиринттік гурман нұсқаулығы» бойынша
Dialogue: 1,0:06:50.30,0:06:52.63,Dialogue_JP,,0,0,0,,Жаңадан бастаушыларға азық болатын сияқты.
Dialogue: 1,0:06:52.97,0:06:55.22,Dialogue_JP,,0,0,0,,Дәмі қою әрі тегіс болады дейді.
Dialogue: 1,0:06:55.52,0:06:56.49,Dialogue_JP,,0,0,0,,Бұл не кітап?
Dialogue: 1,0:06:56.68,0:06:58.32,Dialogue_JP,,0,0,0,,Бұл өте ескі.
Dialogue: 1,0:06:59.02,0:07:01.39,Dialogue_JP,,0,0,0,,Кішкене алға барып, ашық жерде от жағыңыз.
Dialogue: 1,0:07:01.76,0:07:03.91,Dialogue_JP,,0,0,0,,Маған тағы бір немесе екі ингредиент керек.
Dialogue: 1,0:07:06.29,0:07:09.02,Dialogue_JP,,0,0,0,,Сол аяқ іздері – дәу шаян.
Dialogue: 1,0:07:09.76,0:07:11.22,Dialogue_JP,,0,0,0,,Мүмкін емес!
Dialogue: 1,0:07:12.00,0:07:14.57,Dialogue_JP,,0,0,0,,Лабиринттің ішінде болса да көлік көп.
Dialogue: 1,0:07:14.81,0:07:17.22,Dialogue_JP,,0,0,0,,Авантюристер мен саудагерлермен қызу
Dialogue: 1,0:07:17.96,0:07:19.24,Dialogue_JP,,0,0,0,,Басында зиратта
Dialogue: 1,0:07:19.43,0:07:22.30,Dialogue_JP,,0,0,0,,Бұл ауыл адамдары жатқан тыныш киелі жер еді.
Dialogue: 1,0:07:22.71,0:07:25.72,Dialogue_JP,,0,0,0,,Алты жыл бұрын лабиринтке қосылғаннан кейін,
Dialogue: 1,0:07:25.88,0:07:28.91,Dialogue_JP,,0,0,0,,Ауылдың ең көп жүретін жеріне айналды.
Dialogue: 1,0:07:29.47,0:07:32.77,Dialogue_JP,,0,0,0,,Лабиринттің тереңінен құбыжықтар шығады дейді.
Dialogue: 1,0:07:33.36,0:07:37.10,Dialogue_JP,,0,0,0,,Жердегі жаратылыстар кенеттен тыйымдардың әсерінен өзгерді ме?
Dialogue: 1,0:07:37.24,0:07:40.43,Dialogue_JP,,0,0,0,,Жындар әлемінен шақырылды ма, белгісіз.
Dialogue: 1,0:07:40.64,0:07:43.47,Dialogue_JP,,0,0,0,,Олардың барлығының сыртқы түрі біртүрлі.
Dialogue: 1,0:07:43.63,0:07:46.26,Dialogue_JP,,0,0,0,,Бір нәрсені қорғағандай шабуыл жасау
Dialogue: 1,0:07:47.19,0:07:51.42,Dialogue_JP,,0,0,0,,Бірақ олар қарғыс атқан алтын қаланы көрсетеді.
Dialogue: 1,0:07:51.61,0:07:53.57,Dialogue_JP,,0,0,0,,Бұл жалғыз дәлел болды
Dialogue: 1,0:07:55.35,0:07:56.88,Dialogue_JP,,0,0,0,,Оны шаян сияқты қабылдамаңыз
Dialogue: 1,0:07:57.21,0:08:00.35,Dialogue_JP,,0,0,0,,Мына құбыжықты осылай ұстайсың, сондықтан шаянға қарағанда оңайырақ.
Dialogue: 1,0:08:00.59,0:08:01.68,Dialogue_JP,,0,0,0,,Сіз білесіз бе?
Dialogue: 1,0:08:02.35,0:08:04.00,Dialogue_JP,,0,0,0,,Мүмкін сіз
Dialogue: 1,0:08:04.16,0:08:07.02,Dialogue_JP,,0,0,0,,Сіз құбыжықтарды жеу мүмкіндігін біраз уақыттан бері іздеп жүрсіз.
Dialogue: 1,0:08:09.16,0:08:12.26,Dialogue_JP,,0,0,0,,Бірақ менің әпкеме көмектескім келетіні рас.
Dialogue: 1,0:08:12.84,0:08:13.62,Dialogue_JP,,0,0,0,,Иә, иә
Dialogue: 1,0:08:14.09,0:08:15.52,Dialogue_JP,,0,0,0,,Мен ұзақ үнсіз қалдым, бірақ
Dialogue: 1,0:08:15.62,0:08:17.04,Dialogue_JP,,0,0,0,,Маған құбыжықтар ұнайды
Dialogue: 1,0:08:17.32,0:08:20.57,Dialogue_JP,,0,0,0,,Сыртқы түрі мен дыбысы Оның қандай экологиясы бар?
Dialogue: 1,0:08:21.02,0:08:22.98,Dialogue_JP,,0,0,0,,Көп ұзамай мен де дәмін білгім келді.
Dialogue: 1,0:08:23.14,0:08:24.03,Dialogue_JP,,0,0,0,,Ол психопат.
Dialogue: 1,0:08:29.97,0:08:33.26,Dialogue_JP,,0,0,0,,Мүмкін мұны жеке жерде жасаған дұрыс болар.
Dialogue: 1,0:08:33.48,0:08:36.32,Dialogue_JP,,0,0,0,,Суды көп рет пайдалану үшін алға-артқа жүру азапты болар еді.
Dialogue: 1,0:08:37.90,0:08:39.93,Dialogue_JP,,0,0,0,,Сонымен, сіз мұны қалай жейсіз?
Dialogue: 1,0:08:40.12,0:08:41.88,Dialogue_JP,,0,0,0,,Мен оны православиелік жолмен қайнатып көруім керек пе?
Dialogue: 1,0:08:44.19,0:08:44.93,Dialogue_JP,,0,0,0,,Таңғалатын ештеңе жоқ — кенеттен біздің көптеген жолдастарымыз қаза тауып жатыр.
Dialogue: 1,0:08:45.57,0:08:48.87,Dialogue_JP,,0,0,0,,Тігінен кесу оңай, бірақ көлденең кесу кезінде кедергі болады
Dialogue: 1,0:08:49.12,0:08:51.10,Dialogue_JP,,0,0,0,,Саңырауқұлақ тәрізді жаулармен күресу кезінде
Dialogue: 1,0:08:51.10,0:08:53.72,Dialogue_JP,,0,0,0,,Кесагири мен денені кесу тиімділігі азырақ болуы мүмкін.
Dialogue: 1,0:08:54.78,0:08:55.88,Dialogue_JP,,0,0,0,,Мен көп нәрсені білдім
Dialogue: 1,0:08:56.17,0:08:58.62,Dialogue_JP,,0,0,0,,Оны кесіп алсаң, тағамға ұқсайды.
Dialogue: 1,0:08:58.98,0:08:59.61,Dialogue_JP,,0,0,0,,Қайда
Dialogue: 1,0:09:02.43,0:09:03.60,Dialogue_JP,,0,0,0,,Эй... сәл күте тұрыңыз.
Dialogue: 1,0:09:04.14,0:09:05.59,Dialogue_JP,,0,0,0,,Оны сол күйінде жеңіз.
Dialogue: 1,0:09:05.75,0:09:07.16,Dialogue_JP,,0,0,0,,У тарайды
Dialogue: 1,0:09:07.47,0:09:09.81,Dialogue_JP,,0,0,0,,Бұл шаянның уы жесе зиянсыз.
Кітапта
Dialogue: 1,0:09:11.69,0:09:12.73,Dialogue_JP,,0,0,0,,Шынымен
Dialogue: 1,0:09:12.73,0:09:15.17,Dialogue_JP,,0,0,0,,деп жазылған, сондықтан мен оны қолданғым келеді.
Dialogue: 1,0:09:19.72,0:09:20.81,Dialogue_JP,,0,0,0,,Маған айтпа.
Dialogue: 1,0:09:20.93,0:09:22.10,Dialogue_JP,,0,0,0,,Ято-сама!
Dialogue: 1,0:09:23.11,0:09:24.56,Dialogue_JP,,0,0,0,,Скорпион қазаны?
Dialogue: 1,0:09:25.02,0:09:27.72,Dialogue_JP,,0,0,0,,Бірақ сіздің көзқарасыңыз мені таңдандырмады.
Dialogue: 1,0:09:28.15,0:09:28.95,Dialogue_JP,,0,0,0,,Кім
Dialogue: 1,0:09:29.40,0:09:31.46,Dialogue_JP,,0,0,0,,Мына жігітті жеген кезде
Dialogue: 1,0:09:31.93,0:09:35.92,Dialogue_JP,,0,0,0,,Қайшыны, басты, аяқты және құйрықты алуды ұмытпаңыз.
Dialogue: 1,0:09:36.58,0:09:38.19,Dialogue_JP,,0,0,0,,Құйрық ішін ашады
Dialogue: 1,0:09:38.90,0:09:41.32,Dialogue_JP,,0,0,0,,Кітап жақсы деп айтса да.
Dialogue: 1,0:09:41.46,0:09:43.31,Dialogue_JP,,0,0,0,,Дәлірек айтсақ, бұл жай ғана жаман.
Dialogue: 1,0:09:43.83,0:09:45.96,Dialogue_JP,,0,0,0,,Денеңізге де саңылау жасаңыз.
Dialogue: 1,0:09:46.24,0:09:48.46,Dialogue_JP,,0,0,0,,Жылу оңай өтіп, сорпа сорпасы да шығады.
Dialogue: 1,0:09:48.46,0:09:50.26,Dialogue_JP,,0,0,0,,Бүкіл қазан жақсырақ болады.
Dialogue: 1,0:09:50.68,0:09:52.13,Dialogue_JP,,0,0,0,,Жеуге оңай
Dialogue: 1,0:09:52.59,0:09:54.76,Dialogue_JP,,0,0,0,,Ішкі мүшелерді оңай алып тастаңыз
Dialogue: 1,0:09:54.99,0:09:56.84,Dialogue_JP,,0,0,0,,Бұл ащы, құрылымы жақсы емес.
Dialogue: 1,0:09:57.16,0:10:01.19,Dialogue_JP,,0,0,0,,Саңырауқұлақтардың түбін және 3см бетін тастаңыз.
Dialogue: 1,0:10:01.55,0:10:03.49,Dialogue_JP,,0,0,0,,Менің аяғым жақсы, сондықтан мен бәрін салып қойдым.
Dialogue: 1,0:10:03.83,0:10:05.16,Dialogue_JP,,0,0,0,,Аяғыңызды жақсы ұстайсыз ба?
Dialogue: 1,0:10:05.34,0:10:05.95,Dialogue_JP,,0,0,0,,Иә.
Dialogue: 1,0:10:06.24,0:10:08.38,Dialogue_JP,,0,0,0,,Оның ерекше иісі болады.
Dialogue: 1,0:10:08.70,0:10:10.19,Dialogue_JP,,0,0,0,,Бұл аяқтың иісі ме?
Dialogue: 1,0:10:10.57,0:10:12.50,Dialogue_JP,,0,0,0,,Бұл кастрюльге тым кішкентай.
Dialogue: 1,0:10:13.00,0:10:14.29,Dialogue_JP,,0,0,0,,Бүркіт ыдысын қолданыңыз
Dialogue: 1,0:10:15.40,0:10:16.88,Dialogue_JP,,0,0,0,,Сіз өте жақсы дайындалдыңыз.
Dialogue: 1,0:10:17.59,0:10:20.86,Dialogue_JP,,0,0,0,,Шаяндар мен саңырауқұлақтар аздап жалғыз.
Dialogue: 1,0:10:26.89,0:10:27.64,Dialogue_JP,,0,0,0,,Ууух!
Dialogue: 1,0:10:27.64,0:10:29.61,Dialogue_JP,,0,0,0,,Бір минут күте тұрыңыз, бұл жақсы емес.
Dialogue: 1,0:10:29.69,0:10:30.23,Dialogue_JP,,0,0,0,,Марсиль
Dialogue: 1,0:10:30.34,0:10:31.91,Dialogue_JP,,0,0,0,,Жоқ, жоқ, жоқ, мүмкін емес
Dialogue: 1,0:10:32.22,0:10:34.03,Dialogue_JP,,0,0,0,,Білесің бе, бұл зират.
Dialogue: 1,0:10:34.19,0:10:35.98,Dialogue_JP,,0,0,0,,Құбыжықтар жүз қадамнан бас тартса жақсы.
Dialogue: 1,0:10:36.34,0:10:38.23,Dialogue_JP,,0,0,0,,Тамырлы өсімдіктер болмайды
Dialogue: 1,0:10:38.54,0:10:40.85,Dialogue_JP,,0,0,0,,Жарайды, бұл өздігінен дәмді көрінеді.
Dialogue: 1,0:10:40.85,0:10:41.46,Dialogue_JP,,0,0,0,,Марсиль
Dialogue: 1,0:10:41.46,0:10:42.85,Dialogue_JP,,0,0,0,,Сіз кімсіз?
Dialogue: 1,0:10:42.85,0:10:43.36,Dialogue_JP,,0,0,0,,Дионың Рух толқынының шынайы табиғатын қалай ашуға болады
Dialogue: 1,0:10:43.73,0:10:44.24,Dialogue_JP,,0,0,0,,Түсінікті! Рақмет!
Dialogue: 1,0:10:50.50,0:10:51.33,Dialogue_JP,,0,0,0,,Шлам
Dialogue: 1,0:10:51.82,0:10:53.96,Dialogue_JP,,0,0,0,,Оны бетке кию өте жаман
Dialogue: 1,0:10:54.81,0:10:56.96,Dialogue_JP,,0,0,0,,Жоқ, мен сиқырлай алмаймын.
Dialogue: 1,0:10:57.32,0:11:00.84,Dialogue_JP,,0,0,0,,Ойлап қарасам, ең бірінші өлген адам шлам екен.
Dialogue: 1,0:11:07.07,0:11:07.99,Dialogue_JP,,0,0,0,,Сендердің міндетің не, көпшілік?
Dialogue: 1,0:11:08.19,0:11:08.96,Dialogue_JP,,0,0,0,,Жарайды
Dialogue: 1,0:11:09.08,0:11:10.76,Dialogue_JP,,0,0,0,,Мұрнымда аздап
Dialogue: 1,0:11:10.91,0:11:12.00,Dialogue_JP,,0,0,0,,Алдау
Dialogue: 1,0:11:12.39,0:11:14.84,Dialogue_JP,,0,0,0,,Шламмен пышақпен күресу?
Dialogue: 1,0:11:15.17,0:11:17.60,Dialogue_JP,,0,0,0,,Құрылымын білсеңіз оңай
Dialogue: 1,0:11:18.22,0:11:19.99,Dialogue_JP,,0,0,0,,Аморфтыға ұқсайды
Dialogue: 1,0:11:20.14,0:11:23.02,Dialogue_JP,,0,0,0,,Іс жүзінде олар айналасындағы басқа адамдарға қарағанда біркелкі.
Dialogue: 1,0:11:23.70,0:11:26.65,Dialogue_JP,,0,0,0,,Шламның ішкі мүшелері осылай көрінеді
Dialogue: 1,0:11:26.80,0:11:27.98,Dialogue_JP,,0,0,0,,Адам тұрғысынан
Dialogue: 1,0:11:28.10,0:11:29.42,Dialogue_JP,,0,0,0,,Ішім төңкерілді.
Dialogue: 1,0:11:29.42,0:11:33.12,Dialogue_JP,,0,0,0,,Асқорыту сөлдері ішкі мүшелер мен басты қоршап тұрады.
Dialogue: 1,0:11:33.53,0:11:36.85,Dialogue_JP,,0,0,0,,Жемтігінің тынысын сезеді де, соғады.
Dialogue: 1,0:11:37.19,0:11:39.32,Dialogue_JP,,0,0,0,,Егер сіз қатты айқайласаңыз
Dialogue: 1,0:11:39.49,0:11:41.14,Dialogue_JP,,0,0,0,,Бұл сізді шабуылға осал етеді.
Dialogue: 1,0:11:41.76,0:11:44.25,Dialogue_JP,,0,0,0,,Мен оны сол күйінде жей алмаймын.
Dialogue: 1,0:11:44.42,0:11:47.51,Dialogue_JP,,0,0,0,,Цитрус шырыны қосылған қайнаған сумен жақсылап жуыңыз
Dialogue: 1,0:11:47.79,0:11:49.81,Dialogue_JP,,0,0,0,,Ылғалды жақсылап сүртіңіз
Dialogue: 1,0:11:49.81,0:11:53.46,Dialogue_JP,,0,0,0,,Немесе тұзбен ысқылап, күнге абайлап кептірсеңіз.
Dialogue: 1,0:11:53.57,0:11:55.45,Dialogue_JP,,0,0,0,,Сәнді ингредиенттер толық.
Dialogue: 1,0:11:55.73,0:11:58.95,Dialogue_JP,,0,0,0,,Мүмкіндігінше екі аптаға жуық ораза ұстаған абзал.
Dialogue: 1,0:11:59.14,0:12:00.98,Dialogue_JP,,0,0,0,,Кептіру уақыт алады
Dialogue: 1,0:12:01.77,0:12:05.03,Dialogue_JP,,0,0,0,,Бұл бүркіт жасаған жылжымалы шламды кептіру торы.
Dialogue: 1,0:12:05.39,0:12:07.32,Dialogue_JP,,0,0,0,,Егер сіз оны осылай сэндвичпен пісірсеңіз
Dialogue: 1,0:12:07.32,0:12:09.47,Dialogue_JP,,0,0,0,,Жаяу жүргенде құрғатыңыз.
Dialogue: 1,0:12:09.99,0:12:12.13,Dialogue_JP,,0,0,0,,Аяқтау үшін уақыт қажет болса да
Dialogue: 1,0:12:12.83,0:12:14.61,Dialogue_JP,,0,0,0,,Міне, дайын өнім
Dialogue: 1,0:12:15.33,0:12:16.89,Dialogue_JP,,0,0,0,,Бүгін осыны қосайық
Dialogue: 1,0:12:17.48,0:12:19.55,Dialogue_JP,,0,0,0,,Бірақ бұл сәнді ингредиент пе?
Dialogue: 1,0:12:19.82,0:12:20.50,Dialogue_JP,,0,0,0,,Маған бәрібір
Dialogue: 1,0:12:20.95,0:12:25.69,Dialogue_JP,,0,0,0,,Мен осы лабиринттегі құбыжық тағамын 10 жылдан астам зерттедім.
Dialogue: 1,0:12:26.17,0:12:30.53,Dialogue_JP,,0,0,0,,Мен құбыжық тағамдарына қызығушылық танытқан адамдардың барына өте қуаныштымын.
Dialogue: 1,0:12:30.53,0:12:31.65,Dialogue_JP,,0,0,0,,10 жыл
Dialogue: 1,0:12:31.65,0:12:34.13,Dialogue_JP,,0,0,0,,Лабиринттер соншалықты ұзақ уақыт болды ма?
Dialogue: 1,0:12:34.90,0:12:36.34,Dialogue_JP,,0,0,0,,Ал, сәл күте тұрыңыз.
Dialogue: 1,0:12:55.15,0:12:56.10,Dialogue_JP_Alt,,0,0,0,,Орындалды!
Dialogue: 1,0:13:01.72,0:13:04.47,Dialogue_JP,,0,0,0,,Үлкен шаян қайнатқанда қызыл түске боялады ма?
Dialogue: 1,0:13:04.68,0:13:07.01,Dialogue_JP,,0,0,0,,Кітапты оқу мен оны көрудің арасында үлкен айырмашылық бар.
Dialogue: 1,0:13:08.09,0:13:10.04,Dialogue_JP,,0,0,0,,Бұл дәмді иіс.
Dialogue: 1,0:13:10.45,0:13:13.09,Dialogue_JP,,0,0,0,,Өйткені жылу әсер еткенде дене аздап кішірейеді.
Dialogue: 1,0:13:13.09,0:13:14.85,Dialogue_JP,,0,0,0,,Сіз өзіңізді оңай демалуға болады.
Dialogue: 1,0:13:15.78,0:13:16.74,Dialogue_JP,,0,0,0,,Бұл рас.
Dialogue: 1,0:13:20.23,0:13:21.08,Dialogue_JP,,0,0,0,,Мен бір қолымда оқпен жүктелген винтовка ұстап тұрмын
Dialogue: 1,0:13:21.30,0:13:22.85,Dialogue_JP,,0,0,0,,Менің ойымша.
Dialogue: 1,0:13:23.04,0:13:25.36,Dialogue_JP,,0,0,0,,Дәмі пісіруге байланысты қатты өзгереді.
Dialogue: 1,0:13:25.78,0:13:27.32,Dialogue_JP,,0,0,0,,Менің ойымша.
Dialogue: 1,0:13:27.32,0:13:28.54,Dialogue_JP,,0,0,0,,Өте жақсы
Dialogue: 1,0:13:28.54,0:13:29.36,Dialogue_JP,,0,0,0,,Мен сен тұрған жерге дүрлігіп барамын
Dialogue: 1,0:13:29.36,0:13:31.34,Dialogue_JP,,0,0,0,,Мен солай ойлаймын.
Dialogue: 1,0:13:34.73,0:13:36.29,Dialogue_JP,,0,0,0,,Маған да бер
Dialogue: 1,0:13:38.55,0:13:39.44,Dialogue_JP,,0,0,0,,Неге осы дене функциялары әлі де болады?
Dialogue: 1,0:13:39.65,0:13:41.63,Dialogue_JP,,0,0,0,,Кептірілген шламды ішектер
Dialogue: 1,0:13:45.27,0:13:46.23,Dialogue_JP,,0,0,0,,Дәмді
Dialogue: 1,0:13:46.62,0:13:49.33,Dialogue_JP,,0,0,0,,Шламды осылай жейсің.
Dialogue: 1,0:13:49.52,0:13:52.03,Dialogue_JP,,0,0,0,,Оны жеміс шырынына салып жеуге де болады.
Dialogue: 1,0:13:52.35,0:13:55.18,Dialogue_JP,,0,0,0,,Бұл ағаштың тамыры да қытырлақ, дәмді.
Dialogue: 1,0:13:55.43,0:13:57.18,Dialogue_JP,,0,0,0,,Дәл түбір емес
Dialogue: 1,0:13:57.35,0:14:00.64,Dialogue_JP,,0,0,0,,Бұл лабиринтте төңкеріліп гүлдеген өсімдіктің діңі.
Dialogue: 1,0:14:00.85,0:14:03.03,Dialogue_JP,,0,0,0,,Бұл балдыр да жұмсақ әрі дәмді.
Dialogue: 1,0:14:03.25,0:14:05.39,Dialogue_JP,,0,0,0,,Бұл да лабиринтте гүлдейтін өсімдік.
Dialogue: 1,0:14:05.83,0:14:09.11,Dialogue_JP,,0,0,0,,Бұл ылғалды жерлерде жиі өсетін қарапайым балдырлар.
Dialogue: 1,0:14:09.58,0:14:13.28,Dialogue_JP,,0,0,0,,Мен әдетте кездейсоқ өтіп кететін лабиринтте мұндай нәрсе бар екеніне сене алмаймын.
Dialogue: 1,0:14:18.33,0:14:19.82,Dialogue_JP,,0,0,0,,жеді
Dialogue: 1,0:14:19.99,0:14:22.10,Dialogue_JP,,0,0,0,,Ойланып қарасам, өзімді әлі таныстыра қойған жоқпын.
Dialogue: 1,0:14:22.72,0:14:24.26,Dialogue_JP,,0,0,0,,Бүркіттің аты – Сенші.
Dialogue: 1,0:14:24.47,0:14:27.06,Dialogue_JP,,0,0,0,,ергежейлі тілінен аударғанда «іздеуші» дегенді білдіреді.
Dialogue: 1,0:14:27.60,0:14:28.63,Dialogue_JP,,0,0,0,,Мен Лайоспын
Dialogue: 1,0:14:29.00,0:14:30.32,Dialogue_JP,,0,0,0,,Сиқыршы Марсиль
Dialogue: 1,0:14:30.53,0:14:31.74,Dialogue_JP,,0,0,0,,Слесарь Чилчак
Dialogue: 1,0:14:32.29,0:14:34.80,Dialogue_JP,,0,0,0,,Сапардың себебі бар сияқты.
Dialogue: 1,0:14:35.01,0:14:36.11,Dialogue_JP,,0,0,0,,Иә, жақсы
Dialogue: 1,0:14:37.11,0:14:40.74,Dialogue_JP,,0,0,0,,Менің бір досымды лабиринттің төменгі қабатында құбыжық жеп қойды.
Dialogue: 1,0:14:41.31,0:14:43.42,Dialogue_JP,,0,0,0,,Мен оны қорытпас бұрын көмектескім келеді.
Dialogue: 1,0:14:44.13,0:14:45.65,Dialogue_JP,,0,0,0,,Қандай құбыжық
Dialogue: 1,0:14:45.79,0:14:46.81,Dialogue_JP,,0,0,0,,Жерде не?
Dialogue: 1,0:14:47.13,0:14:49.33,Dialogue_JP,,0,0,0,,Бұл ашық қызыл қабыршақтары бар айдаһар.
Dialogue: 1,0:14:49.86,0:14:52.12,Dialogue_JP,,0,0,0,,Ашық қызыл шкала төменгі қабат
Dialogue: 1,0:14:52.66,0:14:54.00,Dialogue_JP,,0,0,0,,Жалын айдаһар?
Dialogue: 1,0:14:54.67,0:14:56.95,Dialogue_JP,,0,0,0,,Өзінің алып өлшемін сақтау үшін айдаһар
Dialogue: 1,0:14:56.95,0:14:58.83,Dialogue_JP,,0,0,0,,Уақытының көп бөлігін ұйықтаумен өткізеді.
Dialogue: 1,0:14:59.03,0:15:01.97,Dialogue_JP,,0,0,0,,Ас қорыту да басқа құбыжықтарға қарағанда әлдеқайда баяу болуы керек.
Dialogue: 1,0:15:02.82,0:15:04.27,Dialogue_JP,,0,0,0,,деп үміттенемін
Dialogue: 1,0:15:04.61,0:15:05.25,Dialogue_JP,,0,0,0,,Бұл өте қорқынышты.
Dialogue: 1,0:15:06.06,0:15:08.40,Dialogue_JP,,0,0,0,,Маған еріп жүруге рұқсат ете аласыз ба?
Dialogue: 1,0:15:08.75,0:15:10.39,Dialogue_JP,,0,0,0,,Әрине, мен мұны істеуге қуанышты болар едім.
Dialogue: 1,0:15:10.89,0:15:13.13,Dialogue_JP,,0,0,0,,Бұл да үлкен көмек.
Dialogue: 1,0:15:13.51,0:15:14.64,Dialogue_JP,,0,0,0,,Бұл рас па?
Dialogue: 1,0:15:14.89,0:15:15.52,Dialogue_JP,,0,0,0,,Жоқ
Dialogue: 1,0:15:16.15,0:15:17.07,Dialogue_JP,,0,0,0,,Рахмет
Dialogue: 1,0:15:17.31,0:15:18.14,Dialogue_JP,,0,0,0,,Мен де солай.
Dialogue: 1,0:15:18.62,0:15:22.38,Dialogue_JP,,0,0,0,,Жалын айдаһарын пісіру көп жылдар бойы менің арманым еді.
Dialogue: 1,0:15:23.04,0:15:24.25,Dialogue_JP,,0,0,0,,Жалын айдаһары?
Dialogue: 1,0:15:24.59,0:15:28.13,Dialogue_JP,,0,0,0,,Стейк немесе гамбургер - бұл баратын жол?
Dialogue: 1,0:15:28.78,0:15:30.98,Dialogue_JP,,0,0,0,,Шабу-шабуды да лақтыру қиын.
Dialogue: 1,0:15:30.98,0:15:34.15,Dialogue_JP,,0,0,0,,Жоқ, жұмыртқа болса, оякодон да жеуге болады.
Dialogue: 1,0:15:37.62,0:15:40.00,Dialogue_JP,,0,0,0,,Тамақ жеуге бола ма?
Dialogue: 1,0:15:41.72,0:15:43.57,Dialogue_JP,,0,0,0,,Мен осылай ойламай тұра алмадым
Dialogue: 1,0:15:43.80,0:15:45.62,Dialogue_JP,,0,0,0,,Ешкім ештеңе айтқан жоқ
Dialogue: 1,0:15:49.36,0:15:50.41,Dialogue_JP,,0,0,0,,2-ші жертөле қабаты
Dialogue: 1,0:15:51.44,0:15:54.10,Dialogue_JP,,0,0,0,,Ауыл зиратының бірінші жертөле қабатынан айырмашылығы.
Dialogue: 1,0:15:54.51,0:15:57.33,Dialogue_JP,,0,0,0,,Ерекше көріністер бола бастайды
Dialogue: 1,0:15:58.05,0:15:59.09,Dialogue_JP,,0,0,0,,Ғалымдардың пікірі бойынша
Dialogue: 1,0:15:59.25,0:16:03.71,Dialogue_JP,,0,0,0,,Бұл жердің тереңінде жатқан Алтын қамалдың шыңы деп айтылады.
Dialogue: 1,0:16:04.28,0:16:06.52,Dialogue_JP,,0,0,0,,Менде бұл сұрақ біраздан бері болды.
Dialogue: 1,0:16:06.81,0:16:09.84,Dialogue_JP,,0,0,0,,Неліктен ол ағаш жерге ене алмайтындай биік болмайды?
Dialogue: 1,0:16:10.25,0:16:12.39,Dialogue_JP,,0,0,0,,Өйткені бұл қарғыстан жасалған зындан.
Dialogue: 1,0:16:14.48,0:16:16.19,Dialogue_JP,,0,0,0,,Марсиль, жақсысың ба?
Dialogue: 1,0:16:16.77,0:16:19.19,Dialogue_JP,,0,0,0,,Мен көпірдегі саңылаудан өтіп кеттім.
Dialogue: 1,0:16:19.19,0:16:20.81,Dialogue_JP,,0,0,0,,Мен көп жүрдім.
Dialogue: 1,0:16:21.22,0:16:22.34,Dialogue_JP,,0,0,0,,Өзіңізді шаршап жатырсыз ба?
Dialogue: 1,0:16:23.10,0:16:25.53,Dialogue_JP,,0,0,0,,Лагерьді таңдап, бүгін ерте демалыңыз.
Dialogue: 1,0:16:26.98,0:16:30.48,Dialogue_JP,,0,0,0,,Баяғыда осы маңдағы ағаштың ойпаңында түнеп едім.
Dialogue: 1,0:16:30.72,0:16:32.03,Dialogue_JP,,0,0,0,,...
Dialogue: 1,0:16:32.27,0:16:34.73,Dialogue_JP,,0,0,0,,Шошқа етінен сорпа жасаймын деп күйіп қалдым.
Dialogue: 1,0:16:36.08,0:16:37.17,Dialogue_JP,,0,0,0,,Сорпа
Dialogue: 1,0:16:37.30,0:16:38.64,Dialogue_JP,,0,0,0,,Сіздің қарныңыз ашты ма?
Dialogue: 1,0:16:38.89,0:16:42.07,Dialogue_JP,,0,0,0,,Менде түскі астан қалған шаян шырыны бар.
Dialogue: 1,0:16:42.43,0:16:43.11,Dialogue_JP,,0,0,0,,Бетіңде әлі де сол мұңды кейіп бар.
Dialogue: 1,0:16:43.54,0:16:44.70,Dialogue_JP,,0,0,0,,That's right.
Dialogue: 1,0:16:45.02,0:16:46.94,Dialogue_JP,,0,0,0,,Кешкі асқа құбыжықтарды аулайық
Dialogue: 1,0:16:49.59,0:16:51.18,Dialogue_JP,,0,0,0,,Марсиль не жегісі келеді?
Dialogue: 1,0:16:52.47,0:16:54.90,Dialogue_JP,,0,0,0,,Үміт болса, қолыңнан келгенше тырыс
Dialogue: 1,0:16:55.13,0:16:57.07,Dialogue_JP,,0,0,0,,Мен осылай дедім
Dialogue: 1,0:16:59.39,0:17:01.20,Dialogue_JP,,0,0,0,,Бірақ сен құбыжықтарды жейсің, солай ма?
Dialogue: 1,0:17:03.33,0:17:06.03,Dialogue_JP,,0,0,0,,Жеуге жарамды болса, бәрі жақсы.
Dialogue: 1,0:17:06.60,0:17:08.96,Dialogue_JP,,0,0,0,,Бұл жерде қандай құбыжықтар пайда болады?
Dialogue: 1,0:17:09.66,0:17:10.83,Dialogue_JP,,0,0,0,,Жақсы
Dialogue: 1,0:17:11.88,0:17:13.59,Dialogue_JP,,0,0,0,,Үлкен жарғанақ, үлкен егеуқұйрық
Dialogue: 1,0:17:13.71,0:17:15.58,Dialogue_JP,,0,0,0,,Мен оның антисанитариялық болғанын қаламаймын.
Dialogue: 1,0:17:16.03,0:17:16.99,Dialogue_JP,,0,0,0,,Орман гоблині
Dialogue: 1,0:17:16.99,0:17:18.34,Dialogue_JP,,0,0,0,,Деми-адамдар туралы сөз жоқ.
Dialogue: 1,0:17:18.60,0:17:19.47,Dialogue_JP,,0,0,0,,Қозғалатын сауыт
Dialogue: 1,0:17:19.86,0:17:21.33,Dialogue_JP,,0,0,0,,Металл?
Dialogue: 1,0:17:21.33,0:17:23.68,Dialogue_JP,,0,0,0,,Бұл жиірек емес пе?
Dialogue: 1,0:17:23.86,0:17:25.35,Dialogue_JP,,0,0,0,,Құстар, жаңғақтар, т.б.
Dialogue: 1,0:17:25.64,0:17:28.83,Dialogue_JP,,0,0,0,,Міне, сіз мұны жақсы деп айтса да, сіз барсыз.
Dialogue: 1,0:17:28.83,0:17:30.97,Dialogue_JP,,0,0,0,,Бір нәрсе ойлап тапсам, ұнатпайтын адам
Dialogue: 1,0:17:30.97,0:17:33.36,Dialogue_JP,,0,0,0,,Мен осылай өзімшілмін бе?
Dialogue: 1,0:17:33.73,0:17:35.15,Dialogue_JP,,0,0,0,,Олардың кейбіреулері қалыпты болып көрінеді.
Dialogue: 1,0:17:35.15,0:17:36.45,Dialogue_JP,,0,0,0,,Өйткені олар сізге шабуыл жасамайды
Dialogue: 1,0:17:36.63,0:17:38.36,Dialogue_JP,,0,0,0,,Аңшылық біраз дайындықты қажет етеді.
Dialogue: 1,0:17:38.98,0:17:41.57,Dialogue_JP,,0,0,0,,Үйректер сізге ешқашан жасыл пияз әкелмейді.
Dialogue: 1,0:17:42.14,0:17:44.01,Dialogue_JP,,0,0,0,,Кешіріңіз, дұрыс айтасыз.
Dialogue: 1,0:17:44.01,0:17:44.75,Dialogue_JP,,0,0,0,,«Барлығын мен үшін» мұрагері…
Dialogue: 1,0:17:45.08,0:17:48.68,Dialogue_JP,,0,0,0,,Лабиринт - адам жейтін жасыл пиязы бар құбыжық үйрек пайда болуы мүмкін жерде.
Dialogue: 1,0:17:48.84,0:17:50.89,Dialogue_JP,,0,0,0,,Көбірек көңіл көтерейік
Dialogue: 1,0:17:51.28,0:17:53.31,Dialogue_JP,,0,0,0,,Мен соншалықты позитивті бола алмаймын.
Dialogue: 1,0:17:53.79,0:17:57.46,Dialogue_JP,,0,0,0,,Жоқ, жылдың осы мезгілінде жаңғақтар мен жемістер көп.
Dialogue: 1,0:17:58.70,0:17:59.51,Dialogue_JP,,0,0,0,,Рас
Dialogue: 1,0:18:00.48,0:18:01.01,Dialogue_JP,,0,0,0,,Иә
Dialogue: 1,0:18:04.64,0:18:07.52,Dialogue_JP,,0,0,0,,Қараңдаршы, бұл адам жейтін өсімдіктің жемісі ғой.
Dialogue: 1,0:18:07.82,0:18:09.39,Dialogue_JP,,0,0,0,,Марсиль Бұл дұрыс емес.
Dialogue: 1,0:18:09.73,0:18:11.37,Dialogue_JP,,0,0,0,,«Адам жейтін өсімдік» ауызекі атау
Dialogue: 1,0:18:11.75,0:18:13.01,Dialogue_JP,,0,0,0,,Мысалы, сол гүл
Dialogue: 1,0:18:13.22,0:18:15.02,Dialogue_JP,,0,0,0,,Ресми атауы - розерия.
Dialogue: 1,0:18:15.61,0:18:17.32,Dialogue_JP,,0,0,0,,Негізінен жануарлардың соқпақтарында өседі
Dialogue: 1,0:18:17.74,0:18:19.64,Dialogue_JP,,0,0,0,,Өрмекші жібекке ұқсас шырыш түзеді
Dialogue: 1,0:18:19.72,0:18:22.17,Dialogue_JP,,0,0,0,,Қол тигізгенде рефлексивті түрде тіршілік иелерін тартады
Dialogue: 1,0:18:24.25,0:18:26.78,Dialogue_JP,,0,0,0,,Қозғалатын заттарды орап алады, бірақ ас қорыту қабілеті жоқ.
Dialogue: 1,0:18:27.21,0:18:29.27,Dialogue_JP,,0,0,0,,Өзі компост жасайтын өсімдік.
Dialogue: 1,0:18:29.89,0:18:32.71,Dialogue_JP,,0,0,0,,Бірақ ол адамдарға да қоректенеді, солай емес пе?
Dialogue: 1,0:18:33.34,0:18:35.22,Dialogue_JP,,0,0,0,,Сіз әдетте жейтін көкөністер
Dialogue: 1,0:18:35.44,0:18:38.83,Dialogue_JP,,0,0,0,,Оның шығу тегін байқайтын болсақ, ол тірі жануарлардың саңырауқұлағынан және өлекселерінен жасалған.
Dialogue: 1,0:18:39.07,0:18:41.80,Dialogue_JP,,0,0,0,,Мен бұл ағымды сынамаймын, бірақ
Dialogue: 1,0:18:42.06,0:18:44.68,Dialogue_JP,,0,0,0,,Жарайды, ол әлі екінші жертөле қабатында.
Dialogue: 1,0:18:44.99,0:18:48.21,Dialogue_JP,,0,0,0,,Осы жерде өлі денелер жатқан болса, біреу бірден байқайды.
Dialogue: 1,0:18:48.76,0:18:50.70,Dialogue_JP,,0,0,0,,Мәйітті қалпына келтіретін компания да бар.
Dialogue: 1,0:18:50.90,0:18:52.19,Dialogue_JP,,0,0,0,,Тереңдіктер шетке
Dialogue: 1,0:18:52.33,0:18:55.12,Dialogue_JP,,0,0,0,,Мұндай жерде құбыжықтарды тамақтандыратын ешкім жоқ.
Dialogue: 1,0:18:55.87,0:18:57.30,Dialogue_JP,,0,0,0,,Менің ойымша, солай
Dialogue: 1,0:18:57.73,0:18:59.71,Dialogue_JP,,0,0,0,,Оған жасырын түрде жету қиынға соғатын сияқты
Dialogue: 1,0:19:00.79,0:19:02.31,Dialogue_JP,,0,0,0,,Бізде күресуден басқа амал жоқ.
Dialogue: 1,0:19:04.48,0:19:05.47,Dialogue_JP,,0,0,0,,Онда жетіңіз
Dialogue: 1,0:19:06.58,0:19:08.76,Dialogue_JP,,0,0,0,,Мен бәрін тазалаймын.
Dialogue: 1,0:19:09.88,0:19:12.75,Dialogue_JP,,0,0,0,,Spelae Yeptum Rufermus
Dialogue: 1,0:19:13.34,0:19:15.25,Dialogue_JP,,0,0,0,,Аламандрас плогасы
Dialogue: 1,0:19:15.83,0:19:17.59,Dialogue_JP,,0,0,0,,Нексант Асура
Dialogue: 1,0:19:17.79,0:19:18.99,Dialogue_JP,,0,0,0,,Тоқта, ақымақ.
Dialogue: 1,0:19:20.13,0:19:21.00,Dialogue_JP,,0,0,0,,Неліктен?
Dialogue: 1,0:19:25.01,0:19:27.76,Dialogue_JP,,0,0,0,,Ағаштың жаңғақтарын сиқырмен үрлеуді жоспарлап отырсыз ба?
Dialogue: 1,0:19:28.00,0:19:31.27,Dialogue_JP,,0,0,0,,Жеуге болатын нәрсені ғана ал Бұл темірдің заңы.
Dialogue: 1,0:19:31.46,0:19:33.04,Dialogue_JP,,0,0,0,,Бұл айтудың жағдайы ма?
Dialogue: 1,0:19:34.22,0:19:34.86,Dialogue_JP,,0,0,0,,Мен осындамын ғой?
Dialogue: 1,0:19:34.86,0:19:35.89,Dialogue_JP,,0,0,0,,Жоқ, жоқ, жоқ.
Dialogue: 1,0:19:35.89,0:19:36.66,Dialogue_JP,,0,0,0,,Сен сияқты біреуге уақытымды босқа жұмсауға уақытым жоқ.
Dialogue: 1,0:19:41.97,0:19:43.75,Dialogue_JP,,0,0,0,,«Ас қорыту қызметі жоқ» дегеніміз не?
Dialogue: 1,0:19:43.85,0:19:45.55,Dialogue_JP,,0,0,0,,Қалағаныңызша жеуге болады
Dialogue: 1,0:19:46.47,0:19:48.43,Dialogue_JP,,0,0,0,,Жоқ, кейбір адамдарда ас қорыту қызметі бар.
Dialogue: 1,0:19:48.71,0:19:50.05,Dialogue_JP,,0,0,0,,Түріне байланысты.
Dialogue: 1,0:19:50.73,0:19:53.03,Dialogue_JP,,0,0,0,,Айтпақшы, қазір Марсильді қамауға алуда.
Dialogue: 1,0:19:53.03,0:19:55.51,Dialogue_JP,,0,0,0,,Терінің астына тұқым отырғызатын паразиттік тип.
Dialogue: 1,0:19:55.65,0:19:57.62,Dialogue_JP,,0,0,0,,Ең ұнамаған
Dialogue: 1,0:19:58.19,0:19:59.68,Dialogue_JP,,0,0,0,,Көп қозғалма, Марсиль.
Dialogue: 1,0:20:00.57,0:20:03.56,Dialogue_JP,,0,0,0,,Өсімдік құбыжықтарының бірнеше қолдары бар сияқты.
Dialogue: 1,0:20:03.88,0:20:06.05,Dialogue_JP,,0,0,0,,Әр адаммен жеке-жеке айналыссаң, күн батады
Dialogue: 1,0:20:06.53,0:20:08.41,Dialogue_JP,,0,0,0,,Пышақты тек бір жерге қойыңыз
Dialogue: 1,0:20:09.43,0:20:10.16,Dialogue_JP,,0,0,0,,Түбір
Dialogue: 1,0:20:14.43,0:20:15.75,Dialogue_JP,,0,0,0,,Itata
Dialogue: 1,0:20:16.52,0:20:17.34,Dialogue_JP,,0,0,0,,Сендердің міндетің не, көпшілік?
Dialogue: 1,0:20:18.42,0:20:20.07,Dialogue_JP,,0,0,0,,Рахмет сізге Лайос
Dialogue: 1,0:20:20.62,0:20:21.34,Dialogue_JP,,0,0,0,,Қалай болды?
Dialogue: 1,0:20:22.91,0:20:24.26,Dialogue_JP,,0,0,0,,Бұл көлеңкелі құйрық деп аталады.
Dialogue: 1,0:20:24.26,0:20:27.72,Dialogue_JP,,0,0,0,,Тұқымдар тірі заттардың терісінің астына егіледі Жыртқыш-паразиттік тип
Dialogue: 1,0:20:28.16,0:20:31.66,Dialogue_JP,,0,0,0,,Жүзімдіктерді қатты орайтын, сүйектің сынуына әкелетін Баласерия түрлерімен салыстырғанда.
Dialogue: 1,0:20:31.91,0:20:34.98,Dialogue_JP,,0,0,0,,Нысананы жіберіп алмай, өлтірмей алу керек.
Dialogue: 1,0:20:35.61,0:20:38.09,Dialogue_JP,,0,0,0,,Мен қатты болғандықтан қозғала алмаймын.
Dialogue: 1,0:20:38.09,0:20:41.12,Dialogue_JP,,0,0,0,,Бұл ыңғайсыздық тудырмайтын нәзік тепе-теңдік.
Dialogue: 1,0:20:41.37,0:20:43.96,Dialogue_JP,,0,0,0,,Менің ойымша, бұл өте жақсы.
Dialogue: 1,0:20:44.22,0:20:44.84,Dialogue_JP,,0,0,0,,Қалай болды?
Dialogue: 1,0:20:47.17,0:20:48.61,Dialogue_JP,,0,0,0,,Мен сені тағы да ашуландырдым.
Dialogue: 1,0:20:48.92,0:20:51.54,Dialogue_JP,,0,0,0,,Тіпті менің ойымша, бұл қазір біраз оғаш.
Dialogue: 1,0:21:03.35,0:21:04.86,Dialogue_JP,,0,0,0,,Алдымен аздап бумен пісіріңіз
Dialogue: 1,0:21:05.53,0:21:07.85,Dialogue_JP,,0,0,0,,Сабақ бойымен шеңберлермен кесіңіз.
Dialogue: 1,0:21:08.33,0:21:12.32,Dialogue_JP,,0,0,0,,Тұқымдарды ұқыпты алу үшін бұрап, аздап тартыңыз.
Dialogue: 1,0:21:13.77,0:21:14.67,Dialogue_JP,,0,0,0,,Қабық
Dialogue: 1,0:21:14.93,0:21:17.85,Dialogue_JP,,0,0,0,,Жұмсақ болу үшін жақсылап шайқаңыз.
Dialogue: 1,0:21:17.98,0:21:19.77,Dialogue_JP,,0,0,0,,Қуыруға арналған табаға жайыңыз
Dialogue: 1,0:21:20.46,0:21:25.06,Dialogue_JP,,0,0,0,,Ұнтақталған піспеген жемістерге шламды және аздап шаян шырынын қосыңыз.
Dialogue: 1,0:21:25.38,0:21:27.19,Dialogue_JP,,0,0,0,,Жабысқақ болғанша араластырыңыз.
Dialogue: 1,0:21:27.63,0:21:29.02,Dialogue_JP,,0,0,0,,Бір рет тегіс
Dialogue: 1,0:21:29.14,0:21:33.25,Dialogue_JP,,0,0,0,,Қалған шаян шырынын және туралған жаңғақтарды қосыңыз.
Dialogue: 1,0:21:33.40,0:21:36.36,Dialogue_JP,,0,0,0,,Дөрекі араластырғаннан кейін табаға құйыңыз.
Dialogue: 1,0:21:36.80,0:21:38.05,Dialogue_JP,,0,0,0,,Уақытша жылыту
Dialogue: 1,0:21:38.17,0:21:40.79,Dialogue_JP,,0,0,0,,Мен оны жерге өсіре аламын ба көргім келеді.
Dialogue: 1,0:21:40.79,0:21:42.27,Dialogue_JP,,0,0,0,,Бұл жұмыс істемейтініне сенімдімін.
Dialogue: 1,0:21:44.82,0:21:46.93,Dialogue_JP,,0,0,0,,Егер беті жұмсақ болса
Dialogue: 1,0:21:47.11,0:21:48.63,Dialogue_JP,,0,0,0,,Денеңіздің қалған бөлігін жүктеңіз
Dialogue: 1,0:21:50.56,0:21:51.28,Dialogue_JP,,0,0,0,,Жарайды
Dialogue: 1,0:21:51.97,0:21:52.98,Dialogue_JP,,0,0,0,,Орындалды
Dialogue: 1,0:21:55.52,0:21:56.43,Dialogue_JP,,0,0,0,,Тарт?
Dialogue: 1,0:21:56.71,0:21:58.10,Dialogue_JP,,0,0,0,,Бұл жай ғана өтірік.
Dialogue: 1,0:21:58.74,0:22:01.25,Dialogue_JP,,0,0,0,,Тері жабыспайды, сондықтан оны киюге болады.
Dialogue: 1,0:22:02.32,0:22:05.30,Dialogue_JP,,0,0,0,,Дәмі тұзды. Дәмі мен елестеткеннен басқаша.
Dialogue: 1,0:22:05.58,0:22:06.95,Dialogue_JP,,0,0,0,,Иә, бұл дәмді.
Dialogue: 1,0:22:07.57,0:22:08.77,Dialogue_JP,,0,0,0,,Марцилла жеп қой
Dialogue: 1,0:22:09.19,0:22:10.78,Dialogue_JP,,0,0,0,,Мүмкін бұл сіздің сүйікті дәміңіз болар.
Dialogue: 1,0:22:11.74,0:22:14.84,Dialogue_JP,,0,0,0,,Меніңше, мәйіт болған зауыт қосылмаған.
Dialogue: 1,0:22:15.19,0:22:16.09,Dialogue_JP,,0,0,0,,Қосылмаған
Dialogue: 1,0:22:16.38,0:22:19.15,Dialogue_JP,,0,0,0,,Сол өсімдікте жиналатын желатинді пайдалансаңыз
Dialogue: 1,0:22:19.15,0:22:21.35,Dialogue_JP,,0,0,0,,Оны ұқыптырақ ұйымдастыруға болар еді.
Dialogue: 1,0:22:21.55,0:22:23.81,Dialogue_JP,,0,0,0,,Шлам жақсы қатпайды.
Dialogue: 1,0:22:30.73,0:22:32.18,Dialogue_JP,,0,0,0,,Бұл дәмді
Dialogue: 1,0:22:32.55,0:22:35.05,Dialogue_JP,,0,0,0,,Қоректік зат түрі балғын және тәтті.
Dialogue: 1,0:22:35.19,0:22:37.33,Dialogue_JP,,0,0,0,,Ас қорытылған түрі қапталған, дәмі күшті.
Dialogue: 1,0:22:37.74,0:22:39.56,Dialogue_JP,,0,0,0,,Бірақ бұл дұрыс па?
Dialogue: 1,0:22:39.68,0:22:42.71,Dialogue_JP,,0,0,0,,Оның дәмді болуы оның басқа жануарларға да тағам екенін білдірмейді.
Dialogue: 1,0:22:42.95,0:22:45.65,Dialogue_JP,,0,0,0,,Жеміс берсе де жейді.
Dialogue: 1,0:22:46.33,0:22:48.31,Dialogue_JP,,0,0,0,,Бұл жыртқыш өсімдік болғандықтан.
Dialogue: 1,0:22:48.52,0:22:51.35,Dialogue_JP,,0,0,0,,Нысаналы жануарды ұстап, оны қоректік зат ретінде қолданыңыз.
Dialogue: 1,0:22:51.73,0:22:52.72,Dialogue_JP,,0,0,0,,Мен көремін.
Dialogue: 1,0:22:53.97,0:22:56.47,Dialogue_JP,,0,0,0,,Сонымен, бұл дәмділік те стратегия ма?
Dialogue: 1,0:22:56.83,0:22:58.43,Dialogue_JP,,0,0,0,,Мен көремін.
Dialogue: 1,0:23:01.08,0:23:04.05,Dialogue_JP,,0,0,0,,Қызығушылық таныта бастағаныңызға қуаныштымын.
Dialogue: 1,0:23:04.15,0:23:04.88,Dialogue_JP,,0,0,0,,Тоқта
Dialogue: 1,0:23:13.33,0:23:15.17,Dialogue_JP,,0,0,0,,Сонда ол мәйітті не істейміз?
Dialogue: 1,0:23:15.38,0:23:17.60,Dialogue_JP,,0,0,0,,Қазір қалаға қайту мүмкін емес.
Dialogue: 1,0:23:18.09,0:23:20.45,Dialogue_JP,,0,0,0,,Мен сені сиқырмен өмірге қайтарайын ба?
Dialogue: 1,0:23:20.91,0:23:21.71,Dialogue_JP,,0,0,0,,Тоқтатайық
Dialogue: 1,0:23:22.03,0:23:23.48,Dialogue_JP,,0,0,0,,Істен шығу мүмкіндігі
Dialogue: 1,0:23:24.22,0:23:26.23,Dialogue_JP,,0,0,0,,Егер сіз оны анық көрінетін жерге қалдырсаңыз
Dialogue: 1,0:23:26.23,0:23:27.69,Dialogue_JP,,0,0,0,,Оны біреу алып кетеді.
Dialogue: 1,0:23:28.03,0:23:28.94,Dialogue_JP,,0,0,0,,That's right.
Dialogue: 1,0:23:30.12,0:23:32.06,Dialogue_JP,,0,0,0,,Мүмкіндігінше көрінетін болыңыз
Dialogue: 1,0:23:33.83,0:23:36.37,Dialogue_JP,,0,0,0,,Мен өлім жазасына кесілген жерде осындай нәрсені көрдім.
Dialogue: 1,0:23:39.61,0:23:42.80,Dialogue_JP,,0,0,0,,Сол түні Марсиль кішкентай қорқынышты түс көрді.
Dialogue: 1,0:23:44.11,0:23:45.51,Dialogue_JP,,0,0,0,,Зынданда тамақ
Dialogue: 1,0:23:45.70,0:23:47.61,Dialogue_JP,,0,0,0,,Бұл жеуге бола ма, әлде жеуге бола ма?
Dialogue: 1,0:23:48.40,0:23:50.28,Dialogue_JP,,0,0,0,,Жоғарғы немесе төменгі жағы болмайды
Dialogue: 1,0:23:50.50,0:23:53.98,Dialogue_JP,,0,0,0,,Тамақ жай ғана өмірдің артықшылығы болды.
Dialogue: 1,0:23:54.71,0:23:56.03,Dialogue_JP,,0,0,0,,Зынданда тамақ
Dialogue: 1,0:23:56.29,0:23:58.42,Dialogue_JP,,0,0,0,,А, зындандағы тағам
Dialogue: 2,0:12:55.15,0:12:56.10,Dialogue_CN_Alt,,0,0,0,,Аяқталды
Dialogue: 0,0:03:02.28,0:03:07.78,Screen,,0,0,0,,Бұл келесі жолы пайдаланушы кету туралы шешімге жауапты болады.
Dialogue: 0,0:07:17.66,0:07:22.41,Screen,,0,0,0,,Ерекше отбасының бейіті
Dialogue: 0,0:11:51.13,0:11:51.18,Screen,,0,0,0,,Әйгілі көктемгі аспан декорациясының тарихы
Dialogue: 0,0:11:51.18,0:11:51.22,Screen,,0,0,0,,Әйгілі көктемгі аспан декорациясының тарихы
Dialogue: 0,0:11:51.22,0:11:51.26,Screen,,0,0,0,,Әйгілі көктемгі аспан декорациясының тарихы
Dialogue: 0,0:11:51.26,0:11:51.30,Screen,,0,0,0,,Әйгілі көктемгі аспан декорациясының тарихы
Dialogue: 0,0:11:51.30,0:11:51.34,Screen,,0,0,0,,Ширай Мэйдзи әйгілі жер көктемгі аспан пейзажы
Dialogue: 0,0:11:51.34,0:11:51.38,Screen,,0,0,0,,Әйгілі көктемгі аспан декорациясының тарихы
Dialogue: 0,0:11:51.38,0:11:51.43,Screen,,0,0,0,,Ширай Мэйдзи әйгілі жер көктемгі аспан пейзажы
