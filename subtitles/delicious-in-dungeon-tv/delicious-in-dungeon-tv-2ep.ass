Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.41,0:00:03.42,Default,,0,0,0,,♪~
Dialogue: 0,0:01:27.88,0:01:29.88,Default,,0,0,0,,~♪
Dialogue: 0,0:01:31.67,0:01:32.88,Default,,0,0,0,,(пышақ дыбысы)
Dialogue: 0,0:01:32.96,0:01:34.88,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:01:34.97,0:01:36.68,Default,,0,0,0,,Мен үйдемін, анашым.
Dialogue: 0,0:01:38.30,0:01:38.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:39.51,0:01:40.72,Default,,0,0,0,,Менің қалай сезініп жүргенімді елестетіп көр.
Dialogue: 0,0:01:40.80,0:01:42.35,Default,,0,0,0,,Иісі өте жақсы
Dialogue: 0,0:01:42.43,0:01:43.47,Default,,0,0,0,,Хехе…
Dialogue: 0,0:01:43.56,0:01:45.93,Default,,0,0,0,,Бүгін менің туған күнім.
Dialogue: 0,0:01:46.52,0:01:48.52,Default,,0,0,0,,Барлық сүйікті тағамдарыңыз
Dialogue: 0,0:01:49.02,0:01:50.77,Default,,0,0,0,,Иә? Шынымен бе?
Dialogue: 0,0:01:50.86,0:01:52.69,Default,,0,0,0,,Танто жоғары
Dialogue: 0,0:01:52.78,0:01:56.20,Default,,0,0,0,,Қараңызшы, сіз жақсы көретін барлық нәрсе ...
Dialogue: 0,0:01:56.78,0:01:59.20,Default,,0,0,0,,Зынданда жиналған ингредиенттер
Dialogue: 0,0:01:59.28,0:02:01.03,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:01.12,0:02:02.53,Default,,0,0,0,,Ха...
Dialogue: 0,0:02:02.62,0:02:04.50,Default,,0,0,0,,Не болды? марсиль
Dialogue: 0,0:02:04.58,0:02:07.12,Default,,0,0,0,,Ах... аздап қорқынышты түс...
Dialogue: 0,0:02:07.62,0:02:10.04,Default,,0,0,0,,Уф
Dialogue: 0,0:02:10.13,0:02:14.05,Default,,0,0,0,,Не? Бұл иіс менің түсімдегідей
Dialogue: 0,0:02:14.13,0:02:16.88,Default,,0,0,0,,Тағы бір партия сол жерде таңғы ас әзірлеп жатыр.
Dialogue: 0,0:02:17.38,0:02:19.18,Default,,0,0,0,,Тұздалған шошқа етін қуыру
Dialogue: 0,0:02:19.80,0:02:20.72,Default,,0,0,0,,Тамақтану!
Dialogue: 0,0:02:20.80,0:02:22.22,Default,,0,0,0,,Мен қызғанамын!
Dialogue: 0,0:02:22.30,0:02:23.93,Default,,0,0,0,,-Бұл шынымен қорқынышты- (2 адам) Әй?
Dialogue: 0,0:02:24.01,0:02:25.93,Default,,0,0,0,,Бұл өте өкінішті.
Dialogue: 0,0:02:27.10,0:02:30.35,Default,,0,0,0,,Бұл күндері жас авантюристер не жейді?
Dialogue: 0,0:02:30.44,0:02:33.27,Default,,0,0,0,,Нан, кептірілген ет, шарап
Dialogue: 0,0:02:33.36,0:02:36.44,Default,,0,0,0,,Лабиринтті зерттеуге дене күшін қалыптастыру
Dialogue: 0,0:02:36.53,0:02:38.28,Default,,0,0,0,,Ет майы маңызды, бірақ
Dialogue: 0,0:02:38.36,0:02:40.03,Default,,0,0,0,,Осының өзі жеткіліксіз
Dialogue: 0,0:02:40.11,0:02:43.20,Default,,0,0,0,,Дұрыс тамақтанбау құбыжықтан да қорқынышты
Dialogue: 0,0:02:44.12,0:02:45.95,Default,,0,0,0,,...бірақ ол дәріс оқыды.
Dialogue: 0,0:02:46.04,0:02:50.46,Default,,0,0,0,,Шындығында, бәрімізде тамаша тамақ жоқ.
Dialogue: 0,0:02:50.54,0:02:55.46,Default,,0,0,0,,Эльф қыз жаңа ғана шошқа етін көріп, қызғанғанын айтты.
Dialogue: 0,0:02:55.55,0:02:58.38,Default,,0,0,0,,Себебі сіздің денеңіз майға құмар.
Dialogue: 0,0:02:58.47,0:03:00.22,Default,,0,0,0,,Құбыжық, мен оны жегім келмейді!
Dialogue: 0,0:03:00.80,0:03:05.22,Default,,0,0,0,,Ендеше біз бүгін майға бай құбыжықтарды аулаймыз.
Dialogue: 0,0:03:05.31,0:03:09.81,Default,,0,0,0,,Жұмыртқаларды да жинап алсаңыз, тіпті жақсы болар еді. Жұмыртқа – толық қоректік тағам.
Dialogue: 0,0:03:09.89,0:03:12.23,Default,,0,0,0,,Мен лабиринтте белсенді болғым келеді.
Dialogue: 0,0:03:12.31,0:03:13.11,Default,,0,0,0,,Ха!
Dialogue: 0,0:03:13.69,0:03:15.02,Default,,0,0,0,,Бұл солай ма?
Dialogue: 0,0:03:15.11,0:03:16.11,Default,,0,0,0,,Міне...
Dialogue: 0,0:03:16.19,0:03:17.23,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:03:17.99,0:03:19.28,Default,,0,0,0,,Тауықтың денесі
Dialogue: 0,0:03:20.03,0:03:21.16,Default,,0,0,0,,Жылан құйрығы
Dialogue: 0,0:03:21.78,0:03:25.12,Default,,0,0,0,,Оның азу тістері мен тырнақтары өте улы деп саналады.
Dialogue: 0,0:03:25.87,0:03:27.79,Default,,0,0,0,,Базилиск, жыландар патшасы!
Dialogue: 0,0:03:28.45,0:03:30.62,Default,,0,0,0,,Ах... Базилиск?
Dialogue: 0,0:03:30.71,0:03:33.75,Default,,0,0,0,,Керемет, Марсиль, мен тауық етін жей аламын деп ойлаймын.
Dialogue: 0,0:03:33.83,0:03:35.09,Default,,0,0,0,,Хмм.
Dialogue: 0,0:03:35.17,0:03:38.46,Default,,0,0,0,,Бұл тауық еті ме? Мен оны шынымен тауық деп атай аламын ба?
Dialogue: 0,0:03:38.55,0:03:40.55,Default,,0,0,0,,Керемет~
Dialogue: 0,0:03:40.63,0:03:43.76,Default,,0,0,0,,Неғұрлым сорт көп болса, соғұрлым жақсы деп ойлайтынмын.
Dialogue: 0,0:03:43.84,0:03:45.72,Default,,0,0,0,,Соңында екі түрі жақсырақ
Dialogue: 0,0:03:45.80,0:03:48.35,Default,,0,0,0,,Бір-бірімізге деген қызығушылықты арттырып жатырмыз деп айтуға болады.
Dialogue: 0,0:03:48.43,0:03:50.27,Default,,0,0,0,,Осы уақытқа дейін мен оны тек құс еті деп танитынмын⸺
Dialogue: 0,0:03:50.35,0:03:52.85,Default,,0,0,0,,Тауықтың сүйкімділігін де сезіндім.
Dialogue: 0,0:03:52.94,0:03:55.23,Default,,0,0,0,,Бұл қарапайым, бірақ терең комбинация.
Dialogue: 0,0:03:55.31,0:03:58.65,Default,,0,0,0,,Айтпақшы, кокатрица сәл тереңірек өмір сүреді.
Dialogue: 0,0:03:58.73,0:04:00.99,Default,,0,0,0,,Сол құйрықты жыланның тағы бір түрі...
Dialogue: 0,0:04:01.07,0:04:04.41,Default,,0,0,0,,Тамақты насыбайгүлмен салыстыру менің көптен бергі арманым еді.
Dialogue: 0,0:04:04.49,0:04:06.37,Default,,0,0,0,,Мұндай тілек...
Dialogue: 0,0:04:07.08,0:04:09.58,Default,,0,0,0,,Ол аймақ насыбайгүлдің ұясы.
Dialogue: 0,0:04:11.75,0:04:13.00,Default,,0,0,0,,болды
Dialogue: 0,0:04:13.58,0:04:15.58,Default,,0,0,0,,Жақында дүниеге келген сияқты.
Dialogue: 0,0:04:16.08,0:04:18.75,Default,,0,0,0,,Оны жынның ит бөлмесінде ұрлап алайық
Dialogue: 0,0:04:18.84,0:04:20.42,Default,,0,0,0,,Ұзын әрі жіңішке емес пе?
Dialogue: 0,0:04:20.51,0:04:21.30,Default,,0,0,0,,Иә, бар.
Dialogue: 0,0:04:21.84,0:04:23.09,Default,,0,0,0,,Иә, жұмсақ емес пе?
Dialogue: 0,0:04:23.18,0:04:24.38,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:04:24.47,0:04:26.09,Default,,0,0,0,,Бұл насыбайгүлдің қорқытқан дыбысы.
Dialogue: 0,0:04:26.60,0:04:27.64,Default,,0,0,0,,Тезірек жүр, Сенші.
Dialogue: 0,0:04:27.72,0:04:29.72,Default,,0,0,0,,Тоқта, күт, мынау шүберекке оранған...
Dialogue: 0,0:04:29.81,0:04:30.89,Default,,0,0,0,,Ха!
Dialogue: 0,0:04:31.60,0:04:32.89,Default,,0,0,0,,(Басилисктің айқайы)
Dialogue: 0,0:04:33.56,0:04:34.90,Default,,0,0,0,,Бұрынғы партия.
Dialogue: 0,0:04:34.98,0:04:36.90,Default,,0,0,0,,(Донидің айқайы)
Dialogue: 0,0:04:36.98,0:04:37.98,Default,,0,0,0,,Ай…
Dialogue: 0,0:04:39.48,0:04:40.03,Default,,0,0,0,,Әй!
Dialogue: 0,0:04:42.99,0:04:44.91,Default,,0,0,0,,А... ә...
Dialogue: 0,0:04:44.99,0:04:47.57,Default,,0,0,0,,Шуллу…ша
Dialogue: 0,0:04:51.50,0:04:54.41,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:04:54.50,0:04:56.29,Default,,0,0,0,,Гах!
Dialogue: 0,0:04:56.38,0:04:59.29,Default,,0,0,0,,Coquet sur le…
Dialogue: 0,0:04:59.38,0:05:02.88,Default,,0,0,0,,Гя~ ха ха... ух...
Dialogue: 0,0:05:02.97,0:05:04.72,Default,,0,0,0,,Бұл қашу тәсілі ең жаманы.
Dialogue: 0,0:05:04.80,0:05:06.89,Default,,0,0,0,,Бұл мені арқаңнан теууді сұрағанмен бірдей.
Dialogue: 0,0:05:06.97,0:05:08.30,Default,,0,0,0,,Маған тезірек көмектесіңізші!
Dialogue: 0,0:05:08.39,0:05:09.18,Default,,0,0,0,,Уф!
Dialogue: 0,0:05:10.10,0:05:10.60,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:10.68,0:05:12.10,Default,,0,0,0,,Ой-оу!
Dialogue: 0,0:05:12.18,0:05:14.10,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:05:14.18,0:05:16.85,Default,,0,0,0,,Que!
Dialogue: 0,0:05:16.94,0:05:19.98,Default,,0,0,0,,Денеңізді одан да үлкенірек ету үшін қолдарыңызды және аяқтарыңызды жайыңыз.
Dialogue: 0,0:05:20.07,0:05:21.73,Default,,0,0,0,,Қатты дыбыс шығару арқылы қорқыту
Dialogue: 0,0:05:21.82,0:05:25.11,Default,,0,0,0,,Осымен ғана сіз қашықтықты бірінші болып жаба алмайсыз~!
Dialogue: 0,0:05:25.20,0:05:27.49,Default,,0,0,0,,Шапшаң шайқау...
Dialogue: 0,0:05:27.57,0:05:29.16,Default,,0,0,0,,Өзіңді басқа біреу деп көрсеткің келмейді
Dialogue: 0,0:05:29.24,0:05:30.74,Default,,0,0,0,,Que!
Dialogue: 0,0:05:31.58,0:05:32.20,Default,,0,0,0,,Әй!
Dialogue: 0,0:05:32.83,0:05:34.96,Default,,0,0,0,,Шу Чар
Dialogue: 0,0:05:35.04,0:05:35.71,Default,,0,0,0,,Ko!
Dialogue: 0,0:05:35.79,0:05:37.54,Default,,0,0,0,,Хмм... Жарайды!
Dialogue: 0,0:05:37.62,0:05:39.96,Default,,0,0,0,,Насыбайгүлдің құйрығында да басы бар.
Dialogue: 0,0:05:40.04,0:05:43.21,Default,,0,0,0,,Бір қарағанда, соқыр нүктелер жоқ сияқты, бірақ бір ғана дене бар.
Dialogue: 0,0:05:43.30,0:05:46.30,Default,,0,0,0,,Бір уақытта әртүрлі бағыттағы шабуылдар назарыңызды аударса
Dialogue: 0,0:05:46.38,0:05:47.80,Default,,0,0,0,,Екі ми бірден...
Dialogue: 0,0:05:49.18,0:05:50.68,Default,,0,0,0,,Менің денем абдырап қалды!
Dialogue: 0,0:05:52.26,0:05:53.22,Default,,0,0,0,,Егер ұйықтап жатқанда Толық шоғырлану тынысын тоқтатсам,
Dialogue: 0,0:05:55.48,0:05:56.56,Default,,0,0,0,,Сіздің жарақатыңыз қалай?
Dialogue: 0,0:05:57.06,0:05:58.48,Default,,0,0,0,,Сіз уландыңыз ба?
Dialogue: 0,0:05:58.56,0:05:59.98,Default,,0,0,0,,- бұл... иә - Лайос
Dialogue: 0,0:06:00.56,0:06:02.65,Default,,0,0,0,,Уларды жойғың келсе, Сенші бар.
Dialogue: 0,0:06:02.73,0:06:03.98,Default,,0,0,0,,Мистер Столкер
Dialogue: 0,0:06:04.07,0:06:07.24,Default,,0,0,0,,Мен мұны бүгінгі ингредиенттерге қолдануды ойлап жүрмін.
Dialogue: 0,0:06:07.32,0:06:08.99,Default,,0,0,0,,Эх!
Dialogue: 0,0:06:09.07,0:06:11.24,Default,,0,0,0,,Мен өлемін! Мен өліп жатырмын!
Dialogue: 0,0:06:11.32,0:06:13.66,Default,,0,0,0,,Антидот оны жалғыз жегеннен жақсы
Dialogue: 0,0:06:13.74,0:06:14.99,Default,,0,0,0,,Оны пісірсеңіз жақсы.
Dialogue: 0,0:06:15.08,0:06:16.62,Default,,0,0,0,,Олай болса тез дайында!
Dialogue: 0,0:06:17.50,0:06:19.79,Default,,0,0,0,,Алдымен құйрық пен аяқты кесіңіз.
Dialogue: 0,0:06:19.88,0:06:22.88,Default,,0,0,0,,Аздап қайнатып, қауырсындарын жұл.
Dialogue: 0,0:06:24.38,0:06:25.17,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:06:25.76,0:06:27.26,Default,,0,0,0,,Тауық болды
Dialogue: 0,0:06:27.34,0:06:30.68,Default,,0,0,0,,Ішкі мүшелерді алып, дәмдеуіштермен сүртіңіз
Dialogue: 0,0:06:30.76,0:06:34.31,Default,,0,0,0,,Ішіңізді көкөністер мен туралған шөптермен толтырыңыз.
Dialogue: 0,0:06:34.39,0:06:36.06,Default,,0,0,0,,Кесілген жерді байлаңыз
Dialogue: 0,0:06:36.14,0:06:40.56,Default,,0,0,0,,Етті шашлыққа салып, мұқият қуырыңыз...
Dialogue: 0,0:06:41.15,0:06:42.06,Default,,0,0,0,,Ол аяқталды!
Dialogue: 0,0:06:42.15,0:06:44.02,Default,,0,0,0,,Асығыңыз! Маған тезірек жеуге рұқсат етіңіз!
Dialogue: 0,0:06:45.44,0:06:48.65,Default,,0,0,0,,Амммм... жұт
Dialogue: 0,0:06:49.36,0:06:52.03,Default,,0,0,0,,Ет шырынды, дәмді.
Dialogue: 0,0:06:52.12,0:06:54.08,Default,,0,0,0,,Уф... Кешіріңіз...
Dialogue: 0,0:06:54.66,0:06:56.29,Default,,0,0,0,,Жеңдер, сен де.
Dialogue: 0,0:06:56.37,0:06:57.45,Default,,0,0,0,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,0:06:57.54,0:06:59.33,Default,,0,0,0,,Алдымен сиқырды қалпына келтіріңіз...
Dialogue: 0,0:07:00.54,0:07:01.46,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:02.42,0:07:06.05,Default,,0,0,0,,Иә! Мұны қаладағы мейрамханадан табуға болатын сияқты.
Dialogue: 0,0:07:06.13,0:07:08.59,Default,,0,0,0,,Дәмі дәл тауық етіне ұқсайды.
Dialogue: 0,0:07:08.67,0:07:11.22,Default,,0,0,0,,Жылан еті тауық етіне ұқсайды деп естідім...
Dialogue: 0,0:07:11.30,0:07:12.09,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:12.68,0:07:15.81,Default,,0,0,0,,Кешіріңіз... Мен сізге қалпына келтіру сиқырын көрсетемін.
Dialogue: 0,0:07:15.89,0:07:16.72,Default,,0,0,0,,А, мен қателестім.
Dialogue: 0,0:07:18.64,0:07:20.23,Default,,0,0,0,,Лабиринтте
Dialogue: 0,0:07:20.31,0:07:22.85,Default,,0,0,0,,Мен мұндай дұрыс тағамды бірінші рет жедім.
Dialogue: 0,0:07:22.94,0:07:24.31,Default,,0,0,0,,Иә
Dialogue: 0,0:07:24.94,0:07:26.15,Default,,0,0,0,,(Исуми Миямура) Ишикава-кун, сенде абсурдтай көп зат бар, иә?
Dialogue: 0,0:07:26.69,0:07:31.11,Default,,0,0,0,,Лабиринтті сынай бастағанымызға үш ай болды.
Dialogue: 0,0:07:31.70,0:07:34.62,Default,,0,0,0,,Мен бір жерде жойылған сайын...
Dialogue: 0,0:07:34.70,0:07:37.33,Default,,0,0,0,,Мен қалай Лайос пен басқалар сияқты бола аламын?
Dialogue: 0,0:07:37.41,0:07:40.12,Default,,0,0,0,,Мен құбыжықтар пісіретіндей күшті бола аламын ба?
Dialogue: 0,0:07:40.71,0:07:42.04,Default,,0,0,0,,Бұл...
Dialogue: 0,0:07:42.12,0:07:44.25,Default,,0,0,0,,Бірінші! Тамақтану әдеттеріңізді жақсартыңыз!
Dialogue: 0,0:07:44.33,0:07:46.25,Default,,0,0,0,,Өмір ырғағына шолу!
Dialogue: 0,0:07:46.34,0:07:48.26,Default,,0,0,0,,Және дұрыс жаттығу!
Dialogue: 0,0:07:48.34,0:07:50.88,Default,,0,0,0,,Сол үш нүктеге назар аударсаңыз
Dialogue: 0,0:07:50.97,0:07:53.64,Default,,0,0,0,,Күшті дене табиғи түрде жасалады!
Dialogue: 0,0:07:54.85,0:07:57.85,Default,,0,0,0,,Олар керемет адамдар еді.
Dialogue: 0,0:07:58.35,0:08:00.02,Default,,0,0,0,,Біз де қолымыздан келгенді жасайық...!
Dialogue: 0,0:08:03.23,0:08:04.23,Default,,0,0,0,,Хмм.
Dialogue: 0,0:08:05.36,0:08:08.11,Default,,0,0,0,,Бүгін үшінші қабатқа жету мүмкін емес пе?
Dialogue: 0,0:08:08.19,0:08:10.69,Default,,0,0,0,,Өйткені ол мұқият қуырылған.
Dialogue: 0,0:08:11.28,0:08:14.36,Default,,0,0,0,,Қызыл айдаһарлар айына бір рет аң аулау үшін оянатын сияқты.
Dialogue: 0,0:08:15.07,0:08:17.78,Default,,0,0,0,,Менің ойымша, біз өткен күні кездестік сол кезде болды.
Dialogue: 0,0:08:17.87,0:08:20.95,Default,,0,0,0,,Енді сіз тоқ ұйықтап жатырсыз ба?
Dialogue: 0,0:08:21.04,0:08:24.29,Default,,0,0,0,,Мен оны қайтадан аш болғанша тапқым келеді.
Dialogue: 0,0:08:24.37,0:08:25.96,Default,,0,0,0,,...Сонымен Марсиль
Dialogue: 0,0:08:26.04,0:08:28.42,Default,,0,0,0,,- Ха! -Мен аздап тездеткім келеді.
Dialogue: 0,0:08:30.42,0:08:31.26,Default,,0,0,0,,Уф!
Dialogue: 0,0:08:31.34,0:08:32.76,Default,,0,0,0,,Уф
Dialogue: 0,0:08:33.34,0:08:34.68,Default,,0,0,0,,Осы қарқынмен қиын ба...
Dialogue: 0,0:08:35.47,0:08:39.22,Default,,0,0,0,,Мен мүлдем жақсымын және әлі де ыңғайлы жүре аламын.
Dialogue: 0,0:08:39.31,0:08:40.31,Default,,0,0,0,,Оны асыра алмаңыз
Dialogue: 0,0:08:40.39,0:08:41.56,Default,,0,0,0,,Кішкене үзіліс жасайық
Dialogue: 0,0:08:41.64,0:08:42.89,Default,,0,0,0,,Мен өзімді күштеп жатқан жоқпын!
Dialogue: 0,0:08:42.98,0:08:44.02,Default,,0,0,0,,Осымен
Dialogue: 0,0:08:44.10,0:08:46.40,Default,,0,0,0,,Енді сен осылай батылдық танытасың.
Dialogue: 0,0:08:46.48,0:08:50.15,Default,,0,0,0,,Тіпті менің денем бұзылса, мен одан да көп кедергі боламын!
Dialogue: 0,0:08:50.23,0:08:51.90,Default,,0,0,0,,Гарн!
Dialogue: 0,0:08:51.99,0:08:54.70,Default,,0,0,0,,Басқа жолды пайдалану оңайырақ болуы мүмкін.
Dialogue: 0,0:08:54.78,0:08:57.07,Default,,0,0,0,,Бірақ сыртта үлкен жарғанақ бар.
Dialogue: 0,0:08:57.16,0:08:57.66,Default,,0,0,0,,Ха!
Dialogue: 0,0:08:57.74,0:08:59.99,Default,,0,0,0,,Егер бұл үлкен жарқанат болса, менің сиқырымды қолдан!
Dialogue: 0,0:09:00.08,0:09:01.12,Default,,0,0,0,,Жоқ, бұл қажет емес.
Dialogue: 0,0:09:01.20,0:09:01.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:01.83,0:09:03.58,Default,,0,0,0,,Құпия үзінді кім қолдануы керек?
Dialogue: 0,0:09:03.66,0:09:05.67,Default,,0,0,0,,Тұзақтар көп, бірақ құбыжықтар аз.
Dialogue: 0,0:09:05.75,0:09:07.42,Default,,0,0,0,,Мен тұзақты босататын сиқырмын...
Dialogue: 0,0:09:07.50,0:09:10.09,Default,,0,0,0,,Оны Чилчак босатса, тезірек болар еді.
Dialogue: 0,0:09:10.17,0:09:10.71,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:11.38,0:09:14.30,Default,,0,0,0,,Құбыжықтар аз жерден өтіп бара жатырсың ба?
Dialogue: 0,0:09:14.38,0:09:16.97,Default,,0,0,0,,Сондықтан менде жеткілікті ингредиенттер бар екеніне көз жеткізгім келеді.
Dialogue: 0,0:09:17.05,0:09:19.30,Default,,0,0,0,,Түстен кейінгі уақытта бірдеңе істей аламыз ба?
Dialogue: 0,0:09:19.39,0:09:22.72,Default,,0,0,0,,Бізде тек ет пен жұмыртқа бар. Бізге көкөністер керек.
Dialogue: 0,0:09:22.81,0:09:25.31,Default,,0,0,0,,Бұл жерде мандраковтардың колониясы бар.
Dialogue: 0,0:09:25.39,0:09:26.14,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:26.23,0:09:29.23,Default,,0,0,0,,Иә Иә! Мен мандраларды қалай жинау керектігін білемін
Dialogue: 0,0:09:29.31,0:09:30.48,Default,,0,0,0,,Маған қалдырыңыз!
Dialogue: 0,0:09:31.73,0:09:34.65,Default,,0,0,0,,Мандрака - сиқыр мен медицинаның негізі!
Dialogue: 0,0:09:35.28,0:09:37.11,Default,,0,0,0,,Яғни, менің мамандығым.
Dialogue: 0,0:09:37.20,0:09:39.66,Default,,0,0,0,,Барлығы бұл жолы менің нұсқауларымды орындаңыз!
Dialogue: 0,0:09:39.74,0:09:42.66,Default,,0,0,0,,Топырақтан жұлынғанда мандраза айғайлайды.
Dialogue: 0,0:09:42.74,0:09:45.66,Default,,0,0,0,,Естісең жынды боласың немесе одан бетер өлесің.
Dialogue: 0,0:09:46.25,0:09:48.33,Default,,0,0,0,,Егер бұл орын алса, біз жойыламыз
Dialogue: 0,0:09:48.42,0:09:51.59,Default,,0,0,0,,Мен Фаринді құтқарамын десем де, мен одан бір қадам алыстадым...
Dialogue: 0,0:09:51.67,0:09:53.42,Default,,0,0,0,,Мұның алдын алу үшін
Dialogue: 0,0:09:54.13,0:09:57.26,Default,,0,0,0,,Алдымен бау мен жақсы үйретілген ит дайында.
Dialogue: 0,0:09:57.34,0:09:58.18,Default,,0,0,0,,Ит пе?
Dialogue: 0,0:09:58.26,0:10:02.93,Default,,0,0,0,,Иттің жағасына мандраканы байлап, итті алыстан шақыр.
Dialogue: 0,0:10:03.01,0:10:05.77,Default,,0,0,0,,Содан кейін ит мандраканы суырып алады.
Dialogue: 0,0:10:06.27,0:10:07.77,Default,,0,0,0,,Итке не болады?
Dialogue: 0,0:10:07.85,0:10:09.85,Default,,0,0,0,,Уф... мен өлемін.
Dialogue: 0,0:10:09.94,0:10:11.27,Default,,0,0,0,,Я, бұл қорқынышты.
Dialogue: 0,0:10:11.36,0:10:14.03,Default,,0,0,0,,Жоқ, итті қайдан аласың?
Dialogue: 0,0:10:14.61,0:10:17.78,Default,,0,0,0,,Бұл әдіс тым тиімсіз емес пе?
Dialogue: 0,0:10:17.86,0:10:19.70,Default,,0,0,0,,Бірақ мектепте...
Dialogue: 0,0:10:19.78,0:10:21.99,Default,,0,0,0,,Ұзын жіптерді қолдану дұрыс емес пе?
Dialogue: 0,0:10:22.08,0:10:22.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:22.87,0:10:25.62,Default,,0,0,0,,Айқай естілмейтіндей қашықтыққа жететін жіпті пайдаланыңыз.
Dialogue: 0,0:10:25.70,0:10:27.46,Default,,0,0,0,,Осылайша итті пайдаланудың қажеті жоқ
Dialogue: 0,0:10:28.04,0:10:28.96,Default,,0,0,0,,Ал...
Dialogue: 0,0:10:29.04,0:10:31.13,Default,,0,0,0,,Бірдеңе дұрыс емес шығар.
Dialogue: 0,0:10:31.21,0:10:33.84,Default,,0,0,0,,Күш мөлшерін реттеу қиын... Әлде соған ұқсас нәрсе ме?
Dialogue: 0,0:10:37.01,0:10:39.55,Default,,0,0,0,,Шыу!
Dialogue: 0,0:10:39.63,0:10:41.01,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:41.68,0:10:42.93,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:10:43.01,0:10:44.68,Default,,0,0,0,,Бұл Марсиль болды ма?
Dialogue: 0,0:10:45.64,0:10:48.89,Default,,0,0,0,,Айқайламас бұрын басыңды кесіп алсаң, дыбыс шықпайды.
Dialogue: 0,0:10:48.98,0:10:50.23,Default,,0,0,0,,Бұл да рас.
Dialogue: 0,0:10:50.31,0:10:52.06,Default,,0,0,0,,Жоқ, жоқ, бұл қауіпті.
Dialogue: 0,0:10:52.15,0:10:54.32,Default,,0,0,0,,Мен мұны көп жылдар бойы жеп келемін.
Dialogue: 0,0:10:54.40,0:10:57.40,Default,,0,0,0,,Мұндай әуесқой пікір ең қауіпті.
Dialogue: 0,0:10:57.49,0:11:00.24,Default,,0,0,0,,Бірақ Сеншидің тәжірибесі өте көп, солай емес пе?
Dialogue: 0,0:11:00.32,0:11:04.16,Default,,0,0,0,,Марсиль кітапта сипатталған әдістерді қолданып көрді ме?
Dialogue: 0,0:11:04.95,0:11:07.66,Default,,0,0,0,,Жоқ... өйткені итті аяймын.
Dialogue: 0,0:11:07.75,0:11:11.17,Default,,0,0,0,,Әйтеуір, дәл қазір менің итім де жоқ, уақытым да жоқ.
Dialogue: 0,0:11:11.25,0:11:13.67,Default,,0,0,0,,Кешіріңіз, бірақ мен Сеншидің әдісін қолдануға тырысамын.
Dialogue: 0,0:11:14.25,0:11:16.05,Default,,0,0,0,,Осыншама қарапайым болса ғой
Dialogue: 0,0:11:16.13,0:11:18.67,Default,,0,0,0,,Арнайы кітапта осылай жазылу керек...
Dialogue: 0,0:11:19.42,0:11:23.09,Default,,0,0,0,,Бірақ кітап туралы білімнің өзі жеткілікті сенімді емес.
Dialogue: 0,0:11:23.18,0:11:25.68,Default,,0,0,0,,Әркімнен бұрын жасамаған нәрсені талап ету жақсы емес.
Dialogue: 0,0:11:27.14,0:11:28.68,Default,,0,0,0,,«Мен мұны ешқашан жасаған емеспін»?
Dialogue: 0,0:11:29.31,0:11:31.19,Default,,0,0,0,,Содан кейін ғана көріңіз!
Dialogue: 0,0:11:31.27,0:11:34.19,Default,,0,0,0,,Бұл әдістің мағынасы бар екенін дәлелдеңіз!
Dialogue: 0,0:11:34.27,0:11:36.02,Default,,0,0,0,,Кешіріңіз, Марсиль.
Dialogue: 0,0:11:36.11,0:11:37.19,Default,,0,0,0,,"Бүгін түнде біз батырды құрметтейміз!!"
Dialogue: 0,0:11:37.78,0:11:40.03,Default,,0,0,0,,Алайда иттерді қолдануға болмайды...
Dialogue: 0,0:11:40.61,0:11:41.45,Default,,0,0,0,,Құбыжық!
Dialogue: 0,0:11:42.28,0:11:44.87,Default,,0,0,0,,Бұл жердегі құбыжықтар - алып жарғанаттар.
Dialogue: 0,0:11:44.95,0:11:46.95,Default,,0,0,0,,Ол қазір өз ұясында ұйықтап жатқан болуы керек.
Dialogue: 0,0:11:49.29,0:11:51.29,Default,,0,0,0,,Осындай нәрсе дұрыс па?
Dialogue: 0,0:11:51.37,0:11:53.46,Default,,0,0,0,,Мен күштің мөлшерін жазбадым.
Dialogue: 0,0:11:54.54,0:11:57.00,Default,,0,0,0,,Алып жарғанат ұяларын саңылаулардың болуы немесе болмауы арқылы анықтауға болады.
Dialogue: 0,0:11:57.59,0:12:00.63,Default,,0,0,0,,Мен Лайостың нәжісінің пайдалы екеніне сене алмаймын.
Dialogue: 0,0:12:00.72,0:12:03.97,Default,,0,0,0,,Ал мына жерден айқай естілмейтін жер туралы айтсақ...
Dialogue: 0,0:12:04.55,0:12:05.68,Default,,0,0,0,,Сол мұнара
Dialogue: 0,0:12:06.18,0:12:09.18,Default,,0,0,0,,Ха ха ха ха~
Dialogue: 0,0:12:09.27,0:12:11.64,Default,,0,0,0,,Хаа~ ха…
Dialogue: 0,0:12:13.48,0:12:14.90,Default,,0,0,0,,Жақсы мақсат қойыңыз
Dialogue: 0,0:12:17.02,0:12:18.94,Default,,0,0,0,,Эйре Фаум
Dialogue: 0,0:12:20.15,0:12:20.65,Default,,0,0,0,,Орбис!
Dialogue: 0,0:12:23.20,0:12:24.24,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:12:27.16,0:12:29.04,Default,,0,0,0,,(айқай)
Dialogue: 0,0:12:30.91,0:12:31.75,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:12:32.50,0:12:34.87,Default,,0,0,0,,(Мандрейктің айқайы)
Dialogue: 0,0:12:34.96,0:12:36.46,Default,,0,0,0,,Уау! Не?
Dialogue: 0,0:12:36.54,0:12:37.63,Default,,0,0,0,,Марсиль?
Dialogue: 0,0:12:37.71,0:12:41.13,Default,,0,0,0,,(Мандрейктің айқайы)
Dialogue: 0,0:12:45.18,0:12:48.64,Default,,0,0,0,,Эй... Эй... Эй!
Dialogue: 0,0:12:48.72,0:12:50.64,Default,,0,0,0,,Практика өте маңызды
Dialogue: 0,0:12:51.22,0:12:52.14,Default,,0,0,0,,Кем дегенде
Dialogue: 0,0:12:52.23,0:12:56.02,Default,,0,0,0,,Енді мен неге алып жарғанатты иттің орнына пайдаланбау керектігін түсіндім.
Dialogue: 0,0:12:56.10,0:12:56.94,Default,,0,0,0,,Хоге!
Dialogue: 0,0:12:57.02,0:12:59.02,Default,,0,0,0,,Ма...Марсиль~!
Dialogue: 0,0:13:00.15,0:13:01.07,Default,,0,0,0,,Өлді ме?
Dialogue: 0,0:13:03.36,0:13:05.20,Default,,0,0,0,,А... Мен тірімін.
Dialogue: 0,0:13:07.24,0:13:10.12,Default,,0,0,0,,Иттің орнына алып жарғанатты қолдану...
Dialogue: 0,0:13:10.20,0:13:11.29,Default,,0,0,0,,Бұл ақымақ!
Dialogue: 0,0:13:12.87,0:13:15.46,Default,,0,0,0,,Эй Марсиль, сен мені естисің бе?
Dialogue: 0,0:13:15.54,0:13:16.29,Default,,0,0,0,,А...
Dialogue: 0,0:13:16.37,0:13:18.71,Default,,0,0,0,,Иә, менің денсаулығым өте жақсы.
Dialogue: 0,0:13:18.79,0:13:19.96,Default,,0,0,0,,Жоқ, мүмкін емес.
Dialogue: 0,0:13:20.04,0:13:21.63,Default,,0,0,0,,Мен айқай естідім
Dialogue: 0,0:13:21.71,0:13:25.05,Default,,0,0,0,,Сөйлесе бер, бірте-бірте түсінікті болады.
Dialogue: 0,0:13:26.47,0:13:27.55,Default,,0,0,0,,Неге бұлай істеп жатырсың?
Dialogue: 0,0:13:27.64,0:13:30.14,Default,,0,0,0,,Мені кедергі деп атағандықтан мазасыздандым.
Dialogue: 0,0:13:30.22,0:13:30.93,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:13:31.01,0:13:34.73,Default,,0,0,0,,Мен бұл жігіттерге қайта қарап, оларды жерге тізерлеткім келді де, әрекет еттім.
Dialogue: 0,0:13:34.81,0:13:35.98,Default,,0,0,0,,Мынау кім?
Dialogue: 0,0:13:36.06,0:13:37.06,Default,,0,0,0,,Чилчак
Dialogue: 0,0:13:37.65,0:13:41.94,Default,,0,0,0,,Мен бәрің үшін ештеңе істей алмайтыныма қынжыламын.
Dialogue: 0,0:13:45.03,0:13:47.86,Default,,0,0,0,,Лабиринт тереңдеген сайын құбыжықтар күшейе түседі.
Dialogue: 0,0:13:47.95,0:13:50.62,Default,,0,0,0,,Сіздің сиқырыңыз ең сенімді.
Dialogue: 0,0:13:50.70,0:13:54.29,Default,,0,0,0,,Сондықтан мен осындай таяз деңгейде өзімді шаршатпағым келді.
Dialogue: 0,0:13:55.12,0:13:57.83,Default,,0,0,0,,Сонымен қатар, адамдардың күшті және әлсіз жақтары болады.
Dialogue: 0,0:13:58.42,0:14:00.54,Default,,0,0,0,,Мен сіздің күшті жақтарыңызға сүйенгім келеді.
Dialogue: 0,0:14:00.63,0:14:03.46,Default,,0,0,0,,Бұлай болмаса, басқалар шешеді.
Dialogue: 0,0:14:04.88,0:14:06.72,Default,,0,0,0,,Сіз маған көбірек сене аласыз.
Dialogue: 0,0:14:09.30,0:14:10.97,Default,,0,0,0,,Қарашы, Чилчак та.
Dialogue: 0,0:14:12.14,0:14:16.73,Default,,0,0,0,,Марсильдің менімен бірге келуі шынымен көмектесті деп ойлаймын.
Dialogue: 0,0:14:21.56,0:14:23.23,Default,,0,0,0,,Көбірек эмоциямен айтыңыз
Dialogue: 0,0:14:23.32,0:14:24.90,Default,,0,0,0,,Сен есін жидың!
Dialogue: 0,0:14:24.98,0:14:25.99,Default,,0,0,0,,Енді, енді.
Dialogue: 0,0:14:26.57,0:14:30.24,Default,,0,0,0,,Тіпті алып жарғанатты алу да күтпеген егін болды.
Dialogue: 0,0:14:30.32,0:14:32.49,Default,,0,0,0,,Бүгін омлет жасайын ба?
Dialogue: 0,0:14:33.49,0:14:36.33,Default,,0,0,0,,Is this really a basilisk egg?
Dialogue: 0,0:14:36.41,0:14:38.75,Default,,0,0,0,,Бұл тауық жұмыртқасынан мүлдем басқа.
Dialogue: 0,0:14:38.83,0:14:40.58,Default,,0,0,0,,Жылан жұмыртқалары осылай көрінеді.
Dialogue: 0,0:14:40.67,0:14:42.67,Default,,0,0,0,,Жыланның құйрығы ғана, солай ма?
Dialogue: 0,0:14:42.75,0:14:44.63,Default,,0,0,0,,Тауықтың денесі мен басы
Dialogue: 0,0:14:44.71,0:14:46.80,Default,,0,0,0,,Жоқ, оның тауықтың құйрығы бар.
Dialogue: 0,0:14:48.88,0:14:51.89,Default,,0,0,0,,Хмм? Тек осының түсі басқа
Dialogue: 0,0:14:51.97,0:14:53.26,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:14:53.35,0:14:56.27,Default,,0,0,0,,Басы әлі сол жерде, сондықтан оны Марсиль алған болуы керек.
Dialogue: 0,0:14:56.35,0:14:56.89,Default,,0,0,0,,Хмм?
Dialogue: 0,0:14:57.93,0:14:59.14,Default,,0,0,0,,Ммм
Dialogue: 0,0:14:59.23,0:15:02.73,Default,,0,0,0,,Мандраканы турап, жақсылап қуырыңыз.
Dialogue: 0,0:15:02.81,0:15:05.23,Default,,0,0,0,,Оны жұмыртқамен жабыңыз
Dialogue: 0,0:15:05.32,0:15:07.53,Default,,0,0,0,,Егер сіз оны толық етсеңіз...
Dialogue: 0,0:15:07.61,0:15:09.07,Default,,0,0,0,,Ол аяқталды!
Dialogue: 0,0:15:11.61,0:15:14.20,Default,,0,0,0,,Ол тауық жұмыртқасына қарағанда сары түске боялған.
Dialogue: 0,0:15:14.28,0:15:16.87,Default,,0,0,0,,This is the mandrake we collected.
Dialogue: 0,0:15:16.95,0:15:20.54,Default,,0,0,0,,Бұл пері қыз жинаған мандраканы пайдаланды.
Dialogue: 0,0:15:20.62,0:15:23.13,Default,,0,0,0,,It's bad taste to follow up.
Dialogue: 0,0:15:23.21,0:15:24.04,Default,,0,0,0,,Енді, енді.
Dialogue: 0,0:15:24.63,0:15:25.30,Default,,0,0,0,,Аму
Dialogue: 0,0:15:25.84,0:15:27.05,Default,,0,0,0,,Хмм... мм!
Dialogue: 0,0:15:27.13,0:15:30.72,Default,,0,0,0,,Марсильдің тұтқырлығы аз, дәмі жұмсақ.
Dialogue: 0,0:15:30.80,0:15:32.39,Default,,0,0,0,,Хмм, дәмді
Dialogue: 0,0:15:32.47,0:15:36.06,Default,,0,0,0,,Бәлкім, оларды айқайлату, шіркіннің біразынан құтылатын шығар.
Dialogue: 0,0:15:36.64,0:15:40.14,Default,,0,0,0,,Дәмді аз ғана күш жұмсау арқылы қалай жақсартуға болады - бұл тамақ дайындаудың негізі
Dialogue: 0,0:15:40.23,0:15:45.15,Default,,0,0,0,,Мен тек тиімділікті іздеп, мәнін ұмытып кеткен сияқтымын.
Dialogue: 0,0:15:45.23,0:15:46.90,Default,,0,0,0,,Рахмет сізге Марсиль
Dialogue: 0,0:15:47.40,0:15:49.82,Default,,0,0,0,,Your knowledge and books are amazing.
Dialogue: 0,0:15:49.90,0:15:51.74,Default,,0,0,0,,This is not a cookbook!
Dialogue: 0,0:15:52.32,0:15:54.82,Default,,0,0,0,,Бұл аз ғана рахмет.
Dialogue: 0,0:15:54.91,0:15:57.29,Default,,0,0,0,,Eat the most delicious part
Dialogue: 0,0:15:57.37,0:15:59.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:00.37,0:16:02.33,Default,,0,0,0,,No need!
Dialogue: 0,0:16:03.08,0:16:06.67,Default,,0,0,0,,It's too much to eat monsters~
Dialogue: 0,0:16:08.84,0:16:10.21,Default,,0,0,0,,Was it around here?
Dialogue: 0,0:16:10.30,0:16:12.26,Default,,0,0,0,,Is there a shortcut entrance?
Dialogue: 0,0:16:12.34,0:16:13.26,Default,,0,0,0,,Кіру?
Dialogue: 0,0:16:13.34,0:16:15.18,Default,,0,0,0,,Raios, lend me your sword.
Dialogue: 0,0:16:15.85,0:16:17.14,Default,,0,0,0,,Тағы 500 рет!
Dialogue: 0,0:16:17.22,0:16:19.93,Default,,0,0,0,,(reverberating sound)
Dialogue: 0,0:16:22.27,0:16:23.27,Default,,0,0,0,,Міне, осы жерде.
Dialogue: 0,0:16:25.19,0:16:27.61,Default,,0,0,0,,«Қажет болса», – дейді Джосуке. «Жарайды».
Dialogue: 0,0:16:27.69,0:16:29.82,Default,,0,0,0,,What just happened?
Dialogue: 0,0:16:29.90,0:16:33.36,Default,,0,0,0,,Чилчак – қақпан тауып, құлыпты теретін шебер.
Dialogue: 0,0:16:33.95,0:16:35.37,Default,,0,0,0,,Сізге айтайын
Dialogue: 0,0:16:35.45,0:16:38.91,Default,,0,0,0,,Алда көп тұзақтар бар, мен айтпайынша қозғалма.
Dialogue: 0,0:16:41.87,0:16:46.71,Default,,0,0,0,,Менің ең жек көретінім – жұмысыма басқа адамдардың араласуы.
Dialogue: 0,0:16:49.13,0:16:49.71,Default,,0,0,0,,Мм.
Dialogue: 0,0:16:55.97,0:16:57.01,Default,,0,0,0,,Қазірше тек сен мен мен ғана оралдық.
Dialogue: 0,0:17:07.86,0:17:09.27,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:12.78,0:17:14.78,Default,,0,0,0,,You can step on the tiles here and here.
Dialogue: 0,0:17:19.70,0:17:21.12,Default,,0,0,0,,Хе~!
Dialogue: 0,0:17:23.71,0:17:25.16,Default,,0,0,0,,Бірақ мен әлі біраз уақыт үйге оралмаймын.
Dialogue: 0,0:17:25.25,0:17:27.88,Default,,0,0,0,,Мен рұқсат берген жерде ғана жүре бер дедім!
Dialogue: 0,0:17:27.96,0:17:30.63,Default,,0,0,0,,Her legs are sticking out!
Dialogue: 0,0:17:30.71,0:17:32.51,Default,,0,0,0,,I don't like tricks.
Dialogue: 0,0:17:32.59,0:17:36.38,Default,,0,0,0,,If you're saying that! Маған орынсыз бірдеңе болған кезде қиналамын.
Dialogue: 0,0:17:36.47,0:17:37.34,Default,,0,0,0,,Тұзақ дегеніміз не?
Dialogue: 0,0:17:37.43,0:17:40.18,Default,,0,0,0,,Бірге жұмыс істейтін және бір-біріне әсер ететін көптеген нәрселер бар.
Dialogue: 0,0:17:40.26,0:17:43.39,Default,,0,0,0,,Егер біреу қозғалса, сол нүктеге дейінгі барлық есептеулер тең болады!
Dialogue: 0,0:17:43.47,0:17:46.56,Default,,0,0,0,,You just have to do as I say.
Dialogue: 0,0:17:46.64,0:17:47.31,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:17:48.90,0:17:50.15,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:17:50.23,0:17:50.90,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:17:50.98,0:17:52.15,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:17:52.69,0:17:53.94,Default,,0,0,0,,Мм... Уау.
Dialogue: 0,0:17:57.20,0:17:58.82,Default,,0,0,0,,Қандай атыс күші
Dialogue: 0,0:17:58.91,0:18:01.45,Default,,0,0,0,,I see, traps are diverse.
Dialogue: 0,0:18:01.53,0:18:02.99,Default,,0,0,0,,Get off your feet quickly!
Dialogue: 0,0:18:03.08,0:18:06.25,Default,,0,0,0,,Өрт қақпағының жанында әдетте май немесе отын құрылғыларының жинағы болады.
Dialogue: 0,0:18:06.33,0:18:07.17,Default,,0,0,0,,Май…
Dialogue: 0,0:18:07.25,0:18:09.46,Default,,0,0,0,,Гномды қуырудың қажеті жоқ!
Dialogue: 0,0:18:09.54,0:18:10.92,Default,,0,0,0,,Қуырылған ба?
Dialogue: 0,0:18:11.67,0:18:12.84,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:18:12.92,0:18:13.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:13.55,0:18:15.92,Default,,0,0,0,,Қуырылған тауық…
Dialogue: 0,0:18:16.55,0:18:18.26,Default,,0,0,0,,Какиаж~!
Dialogue: 0,0:18:19.30,0:18:21.64,Default,,0,0,0,,Бүгін түскі ас ішейік.
Dialogue: 0,0:18:22.22,0:18:24.60,Default,,0,0,0,,Бұл майлы қулық қайда?
Dialogue: 0,0:18:24.68,0:18:26.48,Default,,0,0,0,,Мүлдем жеуге болмайды...
Dialogue: 0,0:18:26.56,0:18:28.27,Default,,0,0,0,,Жартылай аяқты бала
Dialogue: 0,0:18:28.35,0:18:30.61,Default,,0,0,0,,Сіз мұнай маманы емессіз.
Dialogue: 0,0:18:30.69,0:18:32.48,Default,,0,0,0,,Демек, бұл бала емес
Dialogue: 0,0:18:32.57,0:18:35.78,Default,,0,0,0,,Өсімдік майы – ең арзан және ең көп.
Dialogue: 0,0:18:35.86,0:18:39.95,Default,,0,0,0,,Қалай болғанда да, мен нақты өнімді көргім келеді. Егер ол жеуге жарамды май болмаса, мен бас тартамын.
Dialogue: 0,0:18:41.03,0:18:43.49,Default,,0,0,0,,Уф... түсіндім.
Dialogue: 0,0:18:43.58,0:18:44.87,Default,,0,0,0,,Құдай-ай, неге қыздар дәретханасында граффити жазып жүрсің өзің?!
Dialogue: 0,0:18:44.95,0:18:48.37,Default,,0,0,0,,Бұдан былай, тұзақтардың жанында болғанда әрқашан менің нұсқауларымды орындаңыз!
Dialogue: 0,0:18:48.46,0:18:50.67,Default,,0,0,0,,Егер бұл шарт орындалмаса
Dialogue: 0,0:18:50.75,0:18:52.13,Default,,0,0,0,,Ынтымақтастық жоқ
Dialogue: 0,0:18:53.25,0:18:54.17,Default,,0,0,0,,Ант берейік
Dialogue: 0,0:18:54.25,0:18:55.92,Default,,0,0,0,,Қажет болса, көмектесіңіз
Dialogue: 0,0:18:56.01,0:18:57.13,Default,,0,0,0,,Бұл қажет емес
Dialogue: 0,0:18:57.22,0:19:00.26,Default,,0,0,0,,Тыңдаңыздар, әр адамның өз аумағы бар.
Dialogue: 0,0:19:00.34,0:19:01.59,Default,,0,0,0,,Сіз тамақ әзірлеп жатырсыз
Dialogue: 0,0:19:01.68,0:19:03.26,Default,,0,0,0,,Мен қақпандарды қарусыздандырып, құлыптарды аша аламын.
Dialogue: 0,0:19:03.35,0:19:05.14,Default,,0,0,0,,Марсиль - сиқыр
Dialogue: 0,0:19:05.22,0:19:08.23,Default,,0,0,0,,Мен сіздің пісіру әдістеріңізге де араласпаймын.
Dialogue: 0,0:19:08.31,0:19:11.73,Default,,0,0,0,,Сондықтан менің жұмысыма мүлде араласпауыңызды өтінемін.
Dialogue: 0,0:19:15.78,0:19:16.86,Default,,0,0,0,,Қазынашылық
Dialogue: 0,0:19:16.94,0:19:20.78,Default,,0,0,0,,Тұзақтардың көп болуының себебі осы жерді қаскүнемдерден қорғау үшін болса керек.
Dialogue: 0,0:19:23.12,0:19:24.91,Default,,0,0,0,,Еденге бекітілген
Dialogue: 0,0:19:25.83,0:19:27.58,Default,,0,0,0,,Мен оны бәрібір ашып көруім керек пе?
Dialogue: 0,0:19:29.75,0:19:30.79,Default,,0,0,0,,Онда барыңыз.
Dialogue: 0,0:19:32.17,0:19:34.67,Default,,0,0,0,,Мен әдетте ең жетілген адаммын.
Dialogue: 0,0:19:35.25,0:19:37.67,Default,,0,0,0,,Достарының өміріне жауапты болу сезімі
Dialogue: 0,0:19:38.34,0:19:40.42,Default,,0,0,0,,Менің ойымша, бұл оның жүйкесіне тиеді.
Dialogue: 0,0:19:41.18,0:19:41.68,Default,,0,0,0,,Мм.
Dialogue: 0,0:19:42.64,0:19:43.59,Default,,0,0,0,,Ол ашылды.
Dialogue: 0,0:19:44.14,0:19:44.80,Default,,0,0,0,,Ой
Dialogue: 0,0:19:44.89,0:19:47.06,Default,,0,0,0,,Майды қалай шығаруға болады?
Dialogue: 0,0:19:47.14,0:19:48.56,Default,,0,0,0,,Мен онша көп білмеймін.
Dialogue: 0,0:19:49.14,0:19:51.10,Default,,0,0,0,,Бұл шүмек
Dialogue: 0,0:19:51.19,0:19:55.36,Default,,0,0,0,,Бұл триггер тартылғанда, май шығады, бірақ күш...
Dialogue: 0,0:19:55.44,0:19:57.57,Default,,0,0,0,,Содан кейін мен кастрюльді орнаттым.
Dialogue: 0,0:19:57.65,0:19:59.15,Default,,0,0,0,,Сіз триггерді тартасыз
Dialogue: 0,0:19:59.24,0:19:59.86,Default,,0,0,0,,Саған қонақүй тауып беремін.
Dialogue: 0,0:19:59.94,0:20:02.74,Default,,0,0,0,,Маған ұнамайды! Бұл қайнатылған май болса керек.
Dialogue: 0,0:20:02.82,0:20:04.12,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:20:04.20,0:20:05.24,Default,,0,0,0,,Мен уайымдап тұрмын
Dialogue: 0,0:20:08.37,0:20:10.12,Default,,0,0,0,,Себебі мен білмеймін!
Dialogue: 0,0:20:10.20,0:20:11.29,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:12.92,0:20:14.92,Default,,0,0,0,,Күн ыстық! Ах, а, атту...
Dialogue: 0,0:20:15.54,0:20:17.21,Default,,0,0,0,,Аа, мен айтпаймын.
Dialogue: 0,0:20:17.80,0:20:19.42,Default,,0,0,0,,Амансың ба? Сенси...
Dialogue: 0,0:20:19.51,0:20:20.80,Default,,0,0,0,,Онда саусақ бар!
Dialogue: 0,0:20:20.88,0:20:24.68,Default,,0,0,0,,Хмм, 180 градус, қуыру үшін сәйкес температура.
Dialogue: 0,0:20:25.26,0:20:27.64,Default,,0,0,0,,Аа... Ондай нәрсеге жарайсың ба?
Dialogue: 0,0:20:27.72,0:20:31.56,Default,,0,0,0,,Бұл иіс пен дәм... Зәйтүн майы сияқты.
Dialogue: 0,0:20:31.64,0:20:32.56,Default,,0,0,0,,Бұл Декү.
Dialogue: 0,0:20:32.64,0:20:35.81,Default,,0,0,0,,Бұл жер алғашында зәйтүн өсіретін аймақ болған дейді.
Dialogue: 0,0:20:35.90,0:20:38.32,Default,,0,0,0,,Тұзақ ретінде қолданылса, ғажап болмас еді.
Dialogue: 0,0:20:40.19,0:20:41.19,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:20:41.28,0:20:43.53,Default,,0,0,0,,Қалай болғанда да, мұнымен тағамды қуыруға болады.
Dialogue: 0,0:20:43.61,0:20:44.45,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:44.53,0:20:47.91,Default,,0,0,0,,Етті кесу үшін бұрын құлаған пышақ қақпағын пайдалана аласыз ба?
Dialogue: 0,0:20:47.99,0:20:51.08,Default,,0,0,0,,Жоқ, мұндай заттар әрқашан бір орында тұра бермейді...
Dialogue: 0,0:20:52.41,0:20:54.37,Default,,0,0,0,,Мен мұны сізге қалдырамын.
Dialogue: 0,0:20:54.46,0:20:57.38,Default,,0,0,0,,Мен қақпандарды қалай ұстау керектігін білмеймін.
Dialogue: 0,0:20:57.46,0:20:59.21,Default,,0,0,0,,Мен неге мұндай әрекетке барамын?
Dialogue: 0,0:20:59.80,0:21:01.76,Default,,0,0,0,,Ас әзірлеу – менің доменім.
Dialogue: 0,0:21:01.84,0:21:03.51,Default,,0,0,0,,Олар сіздің нұсқауларыңызды орындасын.
Dialogue: 0,0:21:03.59,0:21:06.22,Default,,0,0,0,,Бұл мәміле болуы керек еді.
Dialogue: 0,0:21:07.26,0:21:08.72,Default,,0,0,0,,Мен бұлай айтқан жоқпын...
Dialogue: 0,0:21:08.80,0:21:09.64,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:21:15.90,0:21:17.31,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:17.40,0:21:19.40,Default,,0,0,0,,Мен не істеп жатырмын?
Dialogue: 0,0:21:21.03,0:21:22.82,Default,,0,0,0,,Мен үлкен жарғанатты кесіп алдым, бірақ...
Dialogue: 0,0:21:22.90,0:21:23.74,Default,,0,0,0,,Ой
Dialogue: 0,0:21:25.07,0:21:28.37,Default,,0,0,0,,Одан кейін осы майды ертеректен өрт қақпағында қыздырыңыз.
Dialogue: 0,0:21:29.28,0:21:30.95,Default,,0,0,0,,Не болды? Тездете аласыз ба?
Dialogue: 0,0:21:31.04,0:21:32.12,Default,,0,0,0,,Иә.
Dialogue: 0,0:21:34.58,0:21:38.71,Default,,0,0,0,,Алып жарғанақтың терісін аршып, кесектерге бөл.
Dialogue: 0,0:21:38.79,0:21:42.88,Default,,0,0,0,,Аздап кесу жасап, дәмдеуіштерді ысқылап, оны біраз уақытқа қалдырыңыз.
Dialogue: 0,0:21:42.96,0:21:46.26,Default,,0,0,0,,Осы арада қуырылған мандраканы дайындап алайық.
Dialogue: 0,0:21:46.84,0:21:51.43,Default,,0,0,0,,Мандраканың терісін сыпырғанда алдымен аяқ-қолын ажыратқан дұрыс.
Dialogue: 0,0:21:51.51,0:21:53.68,Default,,0,0,0,,Егер сіз оны шешсеңіз, ол қолыңызбен шығып кетеді.
Dialogue: 0,0:21:53.77,0:21:55.52,Default,,0,0,0,,Дене бөлігі берік болуы керек
Dialogue: 0,0:21:55.60,0:21:58.85,Default,,0,0,0,,Қолдар мен аяқтардың күңгірт түсті бөліктерін ақырын сүртіңіз.
Dialogue: 0,0:21:58.94,0:22:00.77,Default,,0,0,0,,Және киімдерді дайындау
Dialogue: 0,0:22:00.86,0:22:05.70,Default,,0,0,0,,Насыбайгүл жұмыртқасын суға салып, ұнға себіңіз.
Dialogue: 0,0:22:05.78,0:22:09.66,Default,,0,0,0,,Кесек болмас үшін араластырғаннан кейін қамырға мандраканы қосыңыз.
Dialogue: 0,0:22:10.24,0:22:11.95,Default,,0,0,0,,Өрт қалай?
Dialogue: 0,0:22:12.03,0:22:13.41,Default,,0,0,0,,Ештеңе жоқ
Dialogue: 0,0:22:13.49,0:22:16.37,Default,,0,0,0,,Мен тұзақтың атыс күшін бірінші рет реттеп отырмын. Боқ.
Dialogue: 0,0:22:18.46,0:22:20.21,Default,,0,0,0,,Бұл дұрыс емес пе?
Dialogue: 0,0:22:25.26,0:22:28.13,Default,,0,0,0,,Бөлінбейтін етіп қуырылғаннан кейін оны аударыңыз.
Dialogue: 0,0:22:28.22,0:22:29.14,Default,,0,0,0,,Тек жалаңаш, бос жер учаскесін қалдырады…
Dialogue: 0,0:22:29.22,0:22:30.30,Default,,0,0,0,,Олар жай ғана тірі қалуға тиіс емес.
Dialogue: 0,0:22:34.60,0:22:35.89,Default,,0,0,0,,Жетеді ме?
Dialogue: 0,0:22:36.52,0:22:38.94,Default,,0,0,0,,Кешіріңіз... Әлі ерте болды ма?
Dialogue: 0,0:22:39.52,0:22:40.90,Default,,0,0,0,,Атыс күші әлсіз бе?
Dialogue: 0,0:22:41.52,0:22:42.36,Default,,0,0,0,,Не!
Dialogue: 0,0:22:43.77,0:22:45.74,Default,,0,0,0,,А, өртеніп кетті.
Dialogue: 0,0:22:45.82,0:22:47.24,Default,,0,0,0,,Қалайсың?
Dialogue: 0,0:22:47.32,0:22:49.28,Default,,0,0,0,,Мүлдем емес, мені ауыстырыңыз.
Dialogue: 0,0:22:49.36,0:22:50.91,Default,,0,0,0,,Өрт қақпандары сіздің доменіңіз болып табылады.
Dialogue: 0,0:22:50.99,0:22:54.54,Default,,0,0,0,,От қуатына қарамастан, қуыру дәрежесі тағам дайындау саласы болып табылады.
Dialogue: 0,0:22:54.62,0:22:56.70,Default,,0,0,0,,От әлсіресе, быт-шыт болады...
Dialogue: 0,0:22:56.79,0:22:59.00,Default,,0,0,0,,Тым күшті болса, тез жанып кетеді.
Dialogue: 0,0:22:59.58,0:23:02.34,Default,,0,0,0,,Онда бұл қақпанның аумағы емес.
Dialogue: 0,0:23:02.42,0:23:04.25,Default,,0,0,0,,Уақыт келді емес пе?
Dialogue: 0,0:23:06.34,0:23:07.80,Default,,0,0,0,,Мен жақсы түс ала алдым.
Dialogue: 0,0:23:09.18,0:23:10.26,Default,,0,0,0,,Ол аяқталды!
Dialogue: 0,0:23:12.35,0:23:16.14,Default,,0,0,0,,Мен сені бұлай лабиринтте қуырылған тамақ жеймін деп ойламаппын.
Dialogue: 0,0:23:16.68,0:23:19.39,Default,,0,0,0,,Иә, өте жақсы қуырылған.
Dialogue: 0,0:23:19.48,0:23:21.06,Default,,0,0,0,,Өйткені оның атыс күші жақсы болды
Dialogue: 0,0:23:21.15,0:23:24.07,Default,,0,0,0,,Тағамдарды тиісті температурада жылдам қуырыңыз
Dialogue: 0,0:23:24.15,0:23:25.61,Default,,0,0,0,,Бұл оны қытырлақ етеді
Dialogue: 0,0:23:25.69,0:23:28.99,Default,,0,0,0,,Бұны оттың үстінде жасау өте қиын.
Dialogue: 0,0:23:29.07,0:23:31.61,Default,,0,0,0,,Мен мұны от жағу үстінде істемеймін деп ойлаймын, бірақ...
Dialogue: 0,0:23:31.70,0:23:35.91,Default,,0,0,0,,Мен бұл жерде көп жүремін, бірақ мұндай ыңғайлы бөлме бар екенін білмедім...
Dialogue: 0,0:23:35.99,0:23:37.12,Default,,0,0,0,,Гехо Гехо...
Dialogue: 0,0:23:37.70,0:23:38.83,Default,,0,0,0,,Сізге айтайын
Dialogue: 0,0:23:38.91,0:23:41.33,Default,,0,0,0,,Мен жоқ кезде маған еліктеуге тырыспа.
Dialogue: 0,0:23:41.42,0:23:42.83,Default,,0,0,0,,Өйткені мен міндетті түрде өлемін
Dialogue: 0,0:23:42.92,0:23:44.09,Default,,0,0,0,,Егер олар тым жылдам қозғалса (оу, вей, оу)
Dialogue: 0,0:23:44.17,0:23:47.51,Default,,0,0,0,,Сіздің тұзақпен айналысу шеберлігіңізге еліктеуге болмайды.
Dialogue: 0,0:23:47.59,0:23:49.13,Default,,0,0,0,,Керемет
Dialogue: 0,0:23:49.22,0:23:52.18,Default,,0,0,0,,Бұдан былай мен сенен қоштасар кезде
Dialogue: 0,0:23:52.26,0:23:55.93,Default,,0,0,0,,Өкініштісі, енді мұны өз бетімше көтере алмаймын.
Dialogue: 0,0:23:57.97,0:24:00.35,Default,,0,0,0,,Хмм, мен көмектесе алмаймын.
Dialogue: 0,0:24:00.43,0:24:04.36,Default,,0,0,0,,Мен бос уақытымда тұзақтар туралы аздап үйретемін.
Dialogue: 0,0:24:04.44,0:24:05.52,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:24:05.61,0:24:08.03,Default,,0,0,0,,Мен шынымен де құштар емеспін.
Dialogue: 0,0:24:09.07,0:24:13.32,Default,,0,0,0,,Жарайды, сенші маған тамақ пісіруді де үйретті...
Dialogue: 0,0:24:14.87,0:24:17.12,Default,,0,0,0,,Нан етті алмастыра алмайды.
Dialogue: 0,0:24:17.20,0:24:19.45,Default,,0,0,0,,Етті нанның орнына қолдануға болмайды.
Dialogue: 0,0:24:19.54,0:24:22.41,Default,,0,0,0,,... бірге болғанда дәмдірек.
Dialogue: 0,0:24:24.96,0:24:28.30,Default,,0,0,0,,Адамдар мен тамақ сол күйінде қалады.
Dialogue: 0,0:24:28.38,0:24:29.88,Default,,0,0,0,,Зынданда тамақ
Dialogue: 0,0:24:31.01,0:24:33.01,Default,,0,0,0,,♪~
Dialogue: 0,0:25:58.34,0:26:00.35,Default,,0,0,0,,~♪
