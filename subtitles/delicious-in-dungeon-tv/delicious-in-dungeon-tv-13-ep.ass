Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.00,0:00:03.00,Default,,0,0,0,,♪~
Dialogue: 0,0:01:26.54,0:01:28.54,Default,,0,0,0,,~♪
Dialogue: 0,0:01:31.59,0:01:32.55,Default,,0,0,0,,Осы тапаншаны пайдаланып—
Dialogue: 0,0:01:33.30,0:01:35.51,Default,,0,0,0,,Қанша өңдесем де, бәрін жей алмаймын.
Dialogue: 0,0:02:10.75,0:02:11.84,Default,,0,0,0,,Сіз сонда болдыңыз ба?
Dialogue: 0,0:02:11.92,0:02:12.54,Default,,0,0,0,,Ха!
Dialogue: 0,0:02:13.84,0:02:15.84,Default,,0,0,0,,Бұл қандай көрініс?
Dialogue: 0,0:02:16.51,0:02:19.76,Default,,0,0,0,,Менің ойымша, Сізге Ұлы Мәртебені іздеу міндеті жүктелді.
Dialogue: 0,0:02:21.26,0:02:23.47,Default,,0,0,0,,Саған уақыт бергенім есімде жоқ.
Dialogue: 0,0:02:25.43,0:02:27.31,Default,,0,0,0,,Ха...
Dialogue: 0,0:02:28.56,0:02:29.35,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:29.44,0:02:30.98,Default,,0,0,0,,Сәлем қазір...
Dialogue: 0,0:02:31.86,0:02:34.23,Default,,0,0,0,,Мен тіреген қылыш құлаған сияқты.
Dialogue: 0,0:02:34.32,0:02:36.86,Default,,0,0,0,,Енді оны байлаңыз.
Dialogue: 0,0:02:37.74,0:02:38.24,Default,,0,0,0,,Әй?
Dialogue: 0,0:02:39.28,0:02:40.07,Default,,0,0,0,,Фарин?
Dialogue: 0,0:02:40.82,0:02:42.78,Default,,0,0,0,,Марсиль...Марсиль
Dialogue: 0,0:02:43.74,0:02:44.66,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:44.74,0:02:45.99,Default,,0,0,0,,Фаринге не болды?
Dialogue: 0,0:02:46.08,0:02:48.50,Default,,0,0,0,,-Аа... А? -Ах
Dialogue: 0,0:02:48.58,0:02:50.12,Default,,0,0,0,,-Сенші -Хмм?
Dialogue: 0,0:02:50.21,0:02:51.17,Default,,0,0,0,,Фарин қайда?
Dialogue: 0,0:02:51.25,0:02:53.04,Default,,0,0,0,,Ешкім өтпейді.
Dialogue: 0,0:02:53.63,0:02:54.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:54.34,0:02:56.76,Default,,0,0,0,,Не болды?
Dialogue: 0,0:02:58.09,0:02:59.38,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:03:00.47,0:03:02.34,Default,,0,0,0,,Сен осы жерден кеттің бе?
Dialogue: 0,0:03:03.10,0:03:04.51,Default,,0,0,0,,О...
Dialogue: 0,0:03:04.60,0:03:05.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:05.56,0:03:07.52,Default,,0,0,0,,Мен аздап сыртқа қараймын.
Dialogue: 0,0:03:07.60,0:03:08.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:18.11,0:03:19.19,Default,,0,0,0,,Бұл...
Dialogue: 0,0:03:19.28,0:03:20.53,Default,,0,0,0,,Ах
Dialogue: 0,0:03:20.61,0:03:22.03,Default,,0,0,0,,Фарин!
Dialogue: 0,0:03:23.87,0:03:25.28,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:03:25.37,0:03:26.37,Default,,0,0,0,,Өзіңді тым биік ұстама! (Какиёин) Қойсаңшы енді!
Dialogue: 0,0:03:26.45,0:03:27.99,Default,,0,0,0,,(Кенсукенің діріл дыбысы)
Dialogue: 0,0:03:28.08,0:03:29.16,Default,,0,0,0,,(Фариннің айқайы)
Dialogue: 0,0:03:29.25,0:03:31.54,Default,,0,0,0,,Не болды!
Dialogue: 0,0:03:32.25,0:03:36.30,Default,,0,0,0,,Құрметті Делғал... Мен сені іздеуім керек...
Dialogue: 0,0:03:36.38,0:03:38.55,Default,,0,0,0,,Делгал? ДДСҰ?
Dialogue: 0,0:03:38.63,0:03:39.63,Default,,0,0,0,,Бұл елде...
Dialogue: 0,0:03:40.38,0:03:44.05,Default,,0,0,0,,Осы жердегі ғимараттар
Dialogue: 0,0:03:44.14,0:03:49.81,Default,,0,0,0,,Алтын тиындар, адамдар, малдар, қан, ет...
Dialogue: 0,0:03:49.89,0:03:55.06,Default,,0,0,0,,Дәл қазір басып жатқан құмның әрбір түйірі
Dialogue: 0,0:03:55.15,0:03:57.82,Default,,0,0,0,,Мәртебелі Король Делгар туралы
Dialogue: 0,0:03:57.90,0:04:00.78,Default,,0,0,0,,сол адамның меншігі болып табылады
Dialogue: 0,0:04:03.16,0:04:05.82,Default,,0,0,0,,Арам ұры
Dialogue: 0,0:04:06.91,0:04:09.83,Default,,0,0,0,,Сізге таныс сияқтысыз.
Dialogue: 0,0:04:09.91,0:04:12.83,Default,,0,0,0,,Суретте кезіп жүрдің.
Dialogue: 0,0:04:12.92,0:04:16.29,Default,,0,0,0,,Сіз оны танисыз ба? Король?
Dialogue: 0,0:04:16.38,0:04:18.09,Default,,0,0,0,,Суретте?
Dialogue: 0,0:04:18.17,0:04:19.67,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:04:20.26,0:04:21.84,Default,,0,0,0,,Мақсаты не?
Dialogue: 0,0:04:21.92,0:04:22.59,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:26.30,0:04:28.39,Default,,0,0,0,,Лабиринт шебері
Dialogue: 0,0:04:28.47,0:04:30.89,Default,,0,0,0,,Ақылсыз сиқыршы!
Dialogue: 0,0:04:31.48,0:04:32.64,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:04:34.73,0:04:37.90,Default,,0,0,0,,Сонымен...сен, кет!
Dialogue: 0,0:04:37.98,0:04:39.19,Default,,0,0,0,,Мен келесі жолы болжаймын!
Dialogue: 0,0:04:42.24,0:04:45.07,Default,,0,0,0,,Ұстап алушылар...
Dialogue: 0,0:04:45.16,0:04:46.32,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:46.41,0:04:47.82,Default,,0,0,0,,Фарин, сен тұра аласың ба? Фарин
Dialogue: 0,0:04:47.91,0:04:49.91,Default,,0,0,0,,Ух... у... у...
Dialogue: 0,0:04:49.99,0:04:50.83,Default,,0,0,0,,Шулы!
Dialogue: 0,0:04:55.08,0:04:56.42,Default,,0,0,0,,Ла Рио
Dialogue: 0,0:04:56.50,0:04:58.34,Default,,0,0,0,,Қандай құдірет!
Dialogue: 0,0:04:59.04,0:05:01.00,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:05:01.09,0:05:02.59,Default,,0,0,0,,Ол авантюрист пе?
Dialogue: 0,0:05:04.93,0:05:06.43,Default,,0,0,0,,Хмм, кітап па?
Dialogue: 0,0:05:06.51,0:05:08.60,Default,,0,0,0,,Менде өте жағымсыз сезім бар
Dialogue: 0,0:05:08.68,0:05:10.60,Default,,0,0,0,,Оқиға туралы хабарлама
Dialogue: 0,0:05:10.68,0:05:11.60,Default,,0,0,0,,Ммм
Dialogue: 0,0:05:11.68,0:05:13.85,Default,,0,0,0,,Әй, сен бірдеңе айтып тұрған жоқсың ба?
Dialogue: 0,0:05:13.93,0:05:16.85,Default,,0,0,0,,Оқиға туралы Ромфес Людбум
Dialogue: 0,0:05:16.94,0:05:19.11,Default,,0,0,0,,Бұл ән...
Dialogue: 0,0:05:19.19,0:05:20.61,Default,,0,0,0,,Оқиға туралы хабарлама
Dialogue: 0,0:05:20.69,0:05:23.61,Default,,0,0,0,,Ромфес Людбум және Решфам
Dialogue: 0,0:05:23.69,0:05:25.49,Default,,0,0,0,,Ежелгі сиқыр...
Dialogue: 0,0:05:25.57,0:05:26.86,Default,,0,0,0,,Жеңдер!
Dialogue: 0,0:05:28.20,0:05:29.74,Default,,0,0,0,,Оянып қалдым да, бүкіл денем ауырады~!
Dialogue: 0,0:05:29.83,0:05:30.33,Default,,0,0,0,,Уф
Dialogue: 0,0:05:31.62,0:05:32.29,Default,,0,0,0,,Ах
Dialogue: 0,0:05:32.37,0:05:33.33,Default,,0,0,0,,Уф
Dialogue: 0,0:05:33.41,0:05:35.29,Default,,0,0,0,,Уф... күрсініп...
Dialogue: 0,0:05:36.12,0:05:38.13,Default,,0,0,0,,Жарылыс сиқыры Қорғаныс сиқыры...
Dialogue: 0,0:05:38.21,0:05:40.54,Default,,0,0,0,,Жоқ, сіз ондай нәрсенің алдын алмайсыз.
Dialogue: 0,0:05:40.63,0:05:42.42,Default,,0,0,0,,Ийда…
Dialogue: 0,0:05:48.01,0:05:50.55,Default,,0,0,0,,Техниканы тікелей қайта жазыңыз!
Dialogue: 0,0:05:51.47,0:05:52.56,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:05:58.40,0:05:59.44,Default,,0,0,0,,Шығарылды!
Dialogue: 0,0:06:01.40,0:06:02.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:05.11,0:06:07.99,Default,,0,0,0,,Шығарылды! Бас тарту! Бас тарту! Бас тарту!
Dialogue: 0,0:06:08.57,0:06:09.91,Default,,0,0,0,,Бұл ежелгі сиқыр...
Dialogue: 0,0:06:09.99,0:06:12.03,Default,,0,0,0,,Түсіндім! Мен оны оқи аламын!
Dialogue: 0,0:06:12.12,0:06:13.12,Default,,0,0,0,,Басқа амал жоқ па?!
Dialogue: 0,0:06:13.20,0:06:14.75,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:14.83,0:06:17.75,Default,,0,0,0,,Ухихи Ухихи Ухихи Ухихи
Dialogue: 0,0:06:17.83,0:06:20.00,Default,,0,0,0,,Оған жету мүмкін емес!
Dialogue: 0,0:06:20.08,0:06:22.34,Default,,0,0,0,,- Ухихи Ухихи - Хиееееее
Dialogue: 0,0:06:22.42,0:06:23.00,Default,,0,0,0,,Әй?
Dialogue: 0,0:06:31.60,0:06:35.52,Default,,0,0,0,,Сен тәжірибелер жүргізіп, пулемётпен оқ жаудырып жүрсің — нағыз ақымақсың.
Dialogue: 0,0:06:35.60,0:06:39.52,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:06:40.15,0:06:43.27,Default,,0,0,0,,А... сен бұл лабиринтті тұрғыздың ба?
Dialogue: 0,0:06:44.61,0:06:46.94,Default,,0,0,0,,Мен сенімен сөйлескім келеді...
Dialogue: 0,0:06:47.03,0:06:48.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:48.86,0:06:51.37,Default,,0,0,0,,Вааааааааааааа...
Dialogue: 0,0:06:54.99,0:06:55.66,Default,,0,0,0,,Хун
Dialogue: 0,0:07:07.55,0:07:09.30,Default,,0,0,0,,Бұл мені алаңдатады.
Dialogue: 0,0:07:09.38,0:07:11.30,Default,,0,0,0,,Сатқын кетті.
Dialogue: 0,0:07:13.14,0:07:15.56,Default,,0,0,0,,Мәртебелі жақында оралады.
Dialogue: 0,0:07:15.64,0:07:18.10,Default,,0,0,0,,Сол кезде салтанатты түрде тойлайық.
Dialogue: 0,0:07:20.77,0:07:22.06,Default,,0,0,0,,Сәлем Рю
Dialogue: 0,0:07:23.36,0:07:24.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:24.52,0:07:26.94,Default,,0,0,0,,Бұл ыңғайсыз болар еді.
Dialogue: 0,0:07:27.03,0:07:29.90,Default,,0,0,0,,Мен тағы да жаңа кейіпке енемін
Dialogue: 0,0:07:30.74,0:07:31.70,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:07:38.83,0:07:40.71,Default,,0,0,0,,Орындау керек нәрсені жасаңыз
Dialogue: 0,0:07:42.83,0:07:43.96,Default,,0,0,0,,Иә
Dialogue: 0,0:07:46.55,0:07:48.42,Default,,0,0,0,,Уф, ауырып тұр...
Dialogue: 0,0:07:48.51,0:07:49.59,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:07:49.67,0:07:52.22,Default,,0,0,0,,Күте тұрыңыз, шамды қосыңыз
Dialogue: 0,0:07:56.30,0:07:57.72,Default,,0,0,0,,Не? Мұнда...
Dialogue: 0,0:07:57.81,0:08:00.23,Default,,0,0,0,,Біз қай жерден құладық?
Dialogue: 0,0:08:01.02,0:08:02.98,Default,,0,0,0,,Шығуда не болып жатыр...
Dialogue: 0,0:08:03.06,0:08:04.10,Default,,0,0,0,,Уф
Dialogue: 0,0:08:04.19,0:08:06.15,Default,,0,0,0,,-Уау! -Не?
Dialogue: 0,0:08:06.23,0:08:08.69,Default,,0,0,0,,Уф! Қабырға жабылып жатқан жоқ па?
Dialogue: 0,0:08:08.78,0:08:10.49,Default,,0,0,0,,Сіз қалжыңдап тұрсыз ба? Қат!
Dialogue: 0,0:08:10.57,0:08:12.20,Default,,0,0,0,,Сенши Шығу жолын тап!
Dialogue: 0,0:08:12.28,0:08:12.90,Default,,0,0,0,,Қайда?
Dialogue: 0,0:08:12.99,0:08:14.99,Default,,0,0,0,,Сіз сиқырмен бірдеңе жасай алмайсыз ба?
Dialogue: 0,0:08:15.07,0:08:17.24,Default,,0,0,0,,Бұл қандай сиқыр?
Dialogue: 0,0:08:17.33,0:08:19.74,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:08:19.83,0:08:22.50,Default,,0,0,0,,Уууууууууууууууууууууууууууууууу
Dialogue: 0,0:08:22.58,0:08:24.88,Default,,0,0,0,,Не деп тұрсың өзің?
Dialogue: 0,0:08:24.96,0:08:26.88,Default,,0,0,0,,Уау, мен өліп жатырмын
Dialogue: 0,0:08:26.96,0:08:29.25,Default,,0,0,0,,Мен бірінші рет өліп тұрған жоқпын
Dialogue: 0,0:08:29.34,0:08:31.63,Default,,0,0,0,,Сізді тастың ішінен ешкім ашпайды!
Dialogue: 0,0:08:32.47,0:08:35.05,Default,,0,0,0,,Ақыры Фаринмен кездессем де...
Dialogue: 0,0:08:35.14,0:08:37.51,Default,,0,0,0,,Лабиринт жұмбағына жақындасам да...
Dialogue: 0,0:08:37.60,0:08:40.14,Default,,0,0,0,,Барлығы мағынасыз болып қалады.
Dialogue: 0,0:08:40.22,0:08:43.39,Default,,0,0,0,,Осылай аяқталады...
Dialogue: 0,0:08:44.23,0:08:44.90,Default,,0,0,0,,Уф
Dialogue: 0,0:08:44.98,0:08:45.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:45.98,0:08:49.11,Default,,0,0,0,,-Уф... -Марсиль!
Dialogue: 0,0:08:49.19,0:08:50.07,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:50.15,0:08:53.03,Default,,0,0,0,,Ой, қуыс! Мен ол жерден шыға аламын.
Dialogue: 0,0:08:53.78,0:08:56.16,Default,,0,0,0,,Оның қайда апаратынын білмеймін.
Dialogue: 0,0:08:56.24,0:08:57.99,Default,,0,0,0,,Тегістеуден бәрі жақсы!
Dialogue: 0,0:08:58.07,0:09:00.41,Default,,0,0,0,,Жарайды, асығыңыз!
Dialogue: 0,0:09:00.49,0:09:01.12,Default,,0,0,0,,Nuo
Dialogue: 0,0:09:01.20,0:09:02.33,Default,,0,0,0,,Эй!
Dialogue: 0,0:09:03.04,0:09:04.71,Default,,0,0,0,,(жарылған дыбыс)
Dialogue: 0,0:09:06.75,0:09:08.67,Default,,0,0,0,,Ух... мм
Dialogue: 0,0:09:08.75,0:09:11.17,Default,,0,0,0,,Қайда? Мұнда...
Dialogue: 0,0:09:11.25,0:09:12.42,Default,,0,0,0,,Денемде болмасам да, әлі де заттарды ұстай аламын ғой, иә?
Dialogue: 0,0:09:13.97,0:09:16.38,Default,,0,0,0,,Әзірше осы жерден кетуім керек.
Dialogue: 0,0:09:16.47,0:09:17.43,Default,,0,0,0,,Дұрыс~, оны баяу төмен түсір. Не істегің келетінін білемін.
Dialogue: 0,0:09:17.51,0:09:20.89,Default,,0,0,0,,Мен енді бір саусақты қимылдата алмаймын...
Dialogue: 0,0:09:20.97,0:09:22.93,Default,,0,0,0,,Жоқ, мен бар күшімді саламын!
Dialogue: 0,0:09:23.02,0:09:24.94,Default,,0,0,0,,Егер ол мені тағы тапса...
Dialogue: 0,0:09:32.53,0:09:34.78,Default,,0,0,0,,О, бітті.
Dialogue: 0,0:09:36.66,0:09:38.20,Default,,0,0,0,,(Рухтың сыбырлауы)
Dialogue: 0,0:09:38.28,0:09:39.95,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:09:40.70,0:09:41.45,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:09:42.04,0:09:45.00,Default,,0,0,0,,Уайымдама...
Dialogue: 0,0:09:46.21,0:09:46.96,Default,,0,0,0,,Ах
Dialogue: 0,0:09:47.04,0:09:49.46,Default,,0,0,0,,Ол жоғалып кетті ме?
Dialogue: 0,0:09:49.54,0:09:52.80,Default,,0,0,0,,Ой, менің басым бірдеңе болып жатқан сияқты.
Dialogue: 0,0:09:54.80,0:09:55.59,Default,,0,0,0,,Сенси
Dialogue: 0,0:09:55.67,0:09:57.34,Default,,0,0,0,,Лайосты ояту.
Dialogue: 0,0:09:58.05,0:10:00.14,Default,,0,0,0,,Мен осы жердегі жағдайды тексеремін.
Dialogue: 0,0:10:02.68,0:10:03.85,Default,,0,0,0,,Кяаааааааааааа!
Dialogue: 0,0:10:03.93,0:10:05.10,Default,,0,0,0,,Ууууууу!
Dialogue: 0,0:10:05.18,0:10:05.89,Default,,0,0,0,,Hii
Dialogue: 0,0:10:05.98,0:10:07.27,Default,,0,0,0,,Мені ұстаңыз!
Dialogue: 0,0:10:07.35,0:10:09.02,Default,,0,0,0,,Бұл балалар жасырын түрде қайда кірді?
Dialogue: 0,0:10:09.10,0:10:10.86,Default,,0,0,0,,Ей, менің құлағым ұзын.
Dialogue: 0,0:10:10.94,0:10:12.23,Default,,0,0,0,,Мен сонда бардым.
Dialogue: 0,0:10:12.32,0:10:13.78,Default,,0,0,0,,Бұл жігіт
Dialogue: 0,0:10:13.86,0:10:14.86,Default,,0,0,0,,Шулы!
Dialogue: 0,0:10:15.44,0:10:16.65,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:10:16.74,0:10:18.36,Default,,0,0,0,,Бұл мең, капитан.
Dialogue: 0,0:10:18.45,0:10:20.03,Default,,0,0,0,,Ол қайдан пайда болды?
Dialogue: 0,0:10:20.12,0:10:21.91,Default,,0,0,0,,Күзетші не істеді?
Dialogue: 0,0:10:22.45,0:10:24.74,Default,,0,0,0,,Бұл бізге де қатысты...
Dialogue: 0,0:10:24.83,0:10:26.37,Default,,0,0,0,,Тесік бітеліп қалды
Dialogue: 0,0:10:26.45,0:10:27.87,Default,,0,0,0,,-Жарайды. -Ха.
Dialogue: 0,0:10:27.96,0:10:29.42,Default,,0,0,0,,Гномға
Dialogue: 0,0:10:30.21,0:10:31.88,Default,,0,0,0,,Жер астындағы адамдарға
Dialogue: 0,0:10:31.96,0:10:33.55,Default,,0,0,0,,Ұзын аяқ
Dialogue: 0,0:10:33.63,0:10:35.38,Default,,0,0,0,,Ұзын құлақ!
Dialogue: 0,0:10:35.46,0:10:36.72,Default,,0,0,0,,Қызықты
Dialogue: 0,0:10:36.80,0:10:39.30,Default,,0,0,0,,Бұл менің миминачоны бірінші рет өлтіруім.
Dialogue: 0,0:10:39.38,0:10:40.76,Default,,0,0,0,,Мен мұны істеймін
Dialogue: 0,0:10:40.84,0:10:43.22,Default,,0,0,0,,Гномды итке бер.
Dialogue: 0,0:10:43.31,0:10:45.27,Default,,0,0,0,,Бұл жігіттер де көңіл көтеруге құштар.
Dialogue: 0,0:10:45.35,0:10:46.52,Default,,0,0,0,,Қ-Қандай?
Dialogue: 0,0:10:46.60,0:10:50.52,Default,,0,0,0,,Сіз Зонг бастығының әпкесі емессіз бе?
Dialogue: 0,0:10:50.60,0:10:54.61,Default,,0,0,0,,Біз бастыққа берген уәдемізді орындауға келдік.
Dialogue: 0,0:10:54.69,0:10:57.28,Default,,0,0,0,,Мейірімділікке ұмтылу
Dialogue: 0,0:10:58.40,0:11:00.03,Default,,0,0,0,,Неліктен бұл атау?
Dialogue: 0,0:11:01.03,0:11:02.12,Default,,0,0,0,,Әй?
Dialogue: 0,0:11:02.20,0:11:04.91,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:11:04.99,0:11:06.91,Default,,0,0,0,,Сіз көкөніс сатушысыз ба?
Dialogue: 0,0:11:06.99,0:11:09.66,Default,,0,0,0,,Иісі басқаша болғандықтан байқамадым.
Dialogue: 0,0:11:09.75,0:11:12.58,Default,,0,0,0,,Осы уақытқа дейін келгеніңізге сенбеймін.
Dialogue: 0,0:11:13.25,0:11:15.38,Default,,0,0,0,,Бастықпен қандай уәде бар?
Dialogue: 0,0:11:17.84,0:11:18.67,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:11:18.76,0:11:21.22,Default,,0,0,0,,Бұл болды ма?
Dialogue: 0,0:11:21.30,0:11:25.35,Default,,0,0,0,,Айдаһардың кенет жоғалып кеткені біртүрлі болды деп ойладым.
Dialogue: 0,0:11:26.26,0:11:28.56,Default,,0,0,0,,Бастық атынан тағзым ету
Dialogue: 0,0:11:28.64,0:11:30.39,Default,,0,0,0,,Композицияға дайындық
Dialogue: 0,0:11:30.48,0:11:31.19,Default,,0,0,0,,Иә
Dialogue: 0,0:11:33.02,0:11:34.81,Default,,0,0,0,,Хмм... Эй!
Dialogue: 0,0:11:34.90,0:11:39.07,Default,,0,0,0,,(дыбысты араластыру)
Dialogue: 0,0:11:39.15,0:11:40.40,Default,,0,0,0,,Аяқталды
Dialogue: 0,0:11:43.87,0:11:44.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:45.03,0:11:46.70,Default,,0,0,0,,-Хмм -Хмм?
Dialogue: 0,0:11:46.79,0:11:48.20,Default,,0,0,0,,(Оқушылар) Э-э… Мүмкін емес! Мүмкін емес!
Dialogue: 0,0:11:48.29,0:11:54.71,Default,,0,0,0,,(Марсильдің үрейлі дауысы)
Dialogue: 0,0:11:55.46,0:11:56.38,Default,,0,0,0,,Фу~
Dialogue: 0,0:11:56.46,0:11:58.21,Default,,0,0,0,,(Марсильдің үрейлі дауысы)
Dialogue: 0,0:11:58.30,0:12:00.72,Default,,0,0,0,,-Ух~ -Ха ха...
Dialogue: 0,0:12:00.80,0:12:03.22,Default,,0,0,0,,Ах... ой...
Dialogue: 0,0:12:03.30,0:12:06.10,Default,,0,0,0,,Мен... Варахи...
Dialogue: 0,0:12:06.18,0:12:08.47,Default,,0,0,0,,Тараның сиқыры...
Dialogue: 0,0:12:08.56,0:12:10.98,Default,,0,0,0,,Кесу…
Dialogue: 0,0:12:11.06,0:12:13.73,Default,,0,0,0,,(Лидоның тыныс алуы)
Dialogue: 0,0:12:18.53,0:12:19.73,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:12:19.82,0:12:22.65,Default,,0,0,0,,Бізге сиқыршы пері шабуыл жасады.
Dialogue: 0,0:12:23.32,0:12:25.66,Default,,0,0,0,,Сіз ол туралы бірдеңе білесіз бе?
Dialogue: 0,0:12:25.74,0:12:27.28,Default,,0,0,0,,Сіз оны кездестірдіңіз бе?
Dialogue: 0,0:12:27.37,0:12:30.70,Default,,0,0,0,,Мм... қара тері, күміс шаш...
Dialogue: 0,0:12:30.79,0:12:31.87,Default,,0,0,0,,Зұлымдар Альянсы мен Шие Хачисай-кай арасында жақсы ынтымақтастық жоқ —
Dialogue: 0,0:12:32.54,0:12:34.62,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:12:34.71,0:12:38.17,Default,,0,0,0,,Біз көшкенге дейін осында.
Dialogue: 0,0:12:38.25,0:12:40.63,Default,,0,0,0,,Лабиринтті басқаратын сияқты.
Dialogue: 0,0:12:40.71,0:12:45.05,Default,,0,0,0,,Егер лабиринттен тыс біреу лабиринтке қажетінен артық кедергі жасаса.
Dialogue: 0,0:12:45.14,0:12:47.39,Default,,0,0,0,,Ол пайда болады
Dialogue: 0,0:12:47.47,0:12:51.93,Default,,0,0,0,,Құбыжықтар жасаңыз, оларды еркін басқарыңыз және жер бедерін өзгертіңіз
Dialogue: 0,0:12:52.02,0:12:55.90,Default,,0,0,0,,Кітапты парақтау арқылы барлық тірі жанды өлтіріңіз
Dialogue: 0,0:12:55.98,0:12:58.15,Default,,0,0,0,,Лабиринт билеушісі...
Dialogue: 0,0:12:58.82,0:12:59.90,Default,,0,0,0,,Хе-хе. Баспалдақтан төмен түсіп кеткенсің ғой?
Dialogue: 0,0:12:59.98,0:13:04.40,Default,,0,0,0,,Бұл бізді ашулы сиқыршы байқады дегенді білдіре ме?
Dialogue: 0,0:13:04.49,0:13:05.86,Default,,0,0,0,,Қалжың емес!
Dialogue: 0,0:13:05.95,0:13:08.91,Default,,0,0,0,,Шүкір, мен тезірек қашуым керек...
Dialogue: 0,0:13:08.99,0:13:11.49,Default,,0,0,0,,Марсильдің сиқыры сізді шақырды ма?
Dialogue: 0,0:13:11.58,0:13:14.66,Default,,0,0,0,,Жоқ. Жалын айдаһарын ойнағаным үшін бе?
Dialogue: 0,0:13:14.75,0:13:17.67,Default,,0,0,0,,Ол құбыжықтарды пайдаланып жатыр.
Dialogue: 0,0:13:17.75,0:13:20.67,Default,,0,0,0,,Оны өлтіру оның ашуын тудырады
Dialogue: 0,0:13:20.75,0:13:22.55,Default,,0,0,0,,Менің ағам осыдан сақ болды.
Dialogue: 0,0:13:22.63,0:13:27.18,Default,,0,0,0,,Сіз бізге қызыл айдаһарға тиіспеңіз дедіңіз.
Dialogue: 0,0:13:27.26,0:13:29.60,Default,,0,0,0,,Менің ағам әрқашан дұрыс
Dialogue: 0,0:13:29.68,0:13:30.93,Default,,0,0,0,,Мен бұған жол бермеймін. Мен бұған жол бермеймін!
Dialogue: 0,0:13:31.64,0:13:35.27,Default,,0,0,0,,Екеуі оянғанда міндетті түрде Фаринді іздегісі келеді.
Dialogue: 0,0:13:35.89,0:13:38.15,Default,,0,0,0,,Мен оны ештеңеге қарамастан бас тартуға мәжбүрлеуім керек...
Dialogue: 0,0:13:38.94,0:13:40.06,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:13:40.15,0:13:41.57,Default,,0,0,0,,(Барлығы төрт адам) Һмм? (JoJo) Дерби?
Dialogue: 0,0:13:41.65,0:13:42.73,Default,,0,0,0,,Таяқты жағу
Dialogue: 0,0:13:42.82,0:13:45.32,Default,,0,0,0,,Фариннің жерге қарай бара жатқанын көрдіңіз бе?
Dialogue: 0,0:13:45.40,0:13:48.70,Default,,0,0,0,,Айдаһардың етін жегендіктен тойдым дейсің...
Dialogue: 0,0:13:49.78,0:13:51.70,Default,,0,0,0,,Екі адамды алдау?
Dialogue: 0,0:13:51.78,0:13:53.04,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:53.12,0:13:56.71,Default,,0,0,0,,Әйтпесе, әлгі екі тентек ешқашан берілмейді.
Dialogue: 0,0:13:56.79,0:13:59.88,Default,,0,0,0,,Одан әрі жүрсек, міндетті түрде өлтіреміз.
Dialogue: 0,0:13:59.96,0:14:01.67,Default,,0,0,0,,Сіз қабырғаның бір бөлігі болғыңыз келе ме?
Dialogue: 0,0:14:01.75,0:14:03.46,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:14:03.55,0:14:04.09,Default,,0,0,0,,Сондай-ақ...
Dialogue: 0,0:14:05.92,0:14:07.30,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:08.18,0:14:09.47,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:09.55,0:14:12.81,Default,,0,0,0,,Мен ол жігіттермен өлгенді жек көремін.
Dialogue: 0,0:14:14.68,0:14:15.73,Default,,0,0,0,,Ол өзіне иелік етіп тұрған Триту рухын тесіп өтті
Dialogue: 0,0:14:15.81,0:14:18.14,Default,,0,0,0,,Мен қалдырған жүгімді алғым келеді.
Dialogue: 0,0:14:19.02,0:14:20.98,Default,,0,0,0,,Мен басшылық сұрай аламын ба?
Dialogue: 0,0:14:21.06,0:14:22.19,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:23.61,0:14:24.82,Default,,0,0,0,,Бас тарт!
Dialogue: 0,0:14:24.90,0:14:27.74,Default,,0,0,0,,Шіріген ішектің иісі тараған сияқты.
Dialogue: 0,0:14:27.82,0:14:28.45,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:29.45,0:14:31.28,Default,,0,0,0,,Мен де сұраймын
Dialogue: 0,0:14:31.37,0:14:33.24,Default,,0,0,0,,Мені өзіңізбен бірге алыңыз.
Dialogue: 0,0:14:33.33,0:14:36.37,Default,,0,0,0,,Ол қорқақ, бірақ жаман жігіт емес.
Dialogue: 0,0:14:36.45,0:14:39.00,Default,,0,0,0,,Сенші, келмейсің!
Dialogue: 0,0:14:39.08,0:14:42.63,Default,,0,0,0,,Екеуіңіздің қасыңызда тұратын адам да қажет болады.
Dialogue: 0,0:14:42.71,0:14:43.29,Default,,0,0,0,,Ах
Dialogue: 0,0:14:45.63,0:14:46.34,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:47.72,0:14:50.64,Default,,0,0,0,,Менен сұрасаңыз, көмектесе алмаймын
Dialogue: 0,0:14:50.72,0:14:53.39,Default,,0,0,0,,Маған ұнамайды, бірақ мен саған айналамын.
Dialogue: 0,0:15:00.48,0:15:01.56,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:15:02.48,0:15:05.36,Default,,0,0,0,,Барлығы ақымақ, ақымақ!
Dialogue: 0,0:15:06.11,0:15:07.74,Default,,0,0,0,,Достарыңнан айырылдың ба?
Dialogue: 0,0:15:08.86,0:15:09.90,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:15:09.99,0:15:13.99,Default,,0,0,0,,Мен оны соңғы рет көргенімде, ол сиқыршының аяғында жатыр екен.
Dialogue: 0,0:15:14.62,0:15:16.45,Default,,0,0,0,,Сіз оптимистік бола алмайсыз.
Dialogue: 0,0:15:17.66,0:15:20.62,Default,,0,0,0,,Бұл достарыңызды алдау үшін ақтауға болмайды.
Dialogue: 0,0:15:21.50,0:15:23.96,Default,,0,0,0,,Сырттан келгендер қалағанын айта алады.
Dialogue: 0,0:15:24.04,0:15:24.79,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:24.88,0:15:27.01,Default,,0,0,0,,А, жоқ, бұл ештеңе емес...
Dialogue: 0,0:15:27.88,0:15:28.84,Default,,0,0,0,,Бұл менің артымда.
Dialogue: 0,0:15:29.59,0:15:30.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:30.51,0:15:34.93,Default,,0,0,0,,Хе, аа, аа, аа~
Dialogue: 0,0:15:35.01,0:15:36.26,Default,,0,0,0,,Сендер де сол істі тамаша шешесіңдер деп ойлаймын.
Dialogue: 0,0:15:36.35,0:15:37.22,Default,,0,0,0,,Дау-дамай жасамаңыз
Dialogue: 0,0:15:37.31,0:15:38.18,Default,,0,0,0,,Суық!
Dialogue: 0,0:15:38.27,0:15:40.64,Default,,0,0,0,,Бұл осы қаланың тұрғыны.
Dialogue: 0,0:15:41.27,0:15:44.23,Default,,0,0,0,,Бұл жердегі әруақтар әлі де есі дұрыс.
Dialogue: 0,0:15:44.31,0:15:46.69,Default,,0,0,0,,Сіз пайда болған кезде ғана пайда болады
Dialogue: 0,0:15:47.78,0:15:50.28,Default,,0,0,0,,Олардың жолы қауіпсіз
Dialogue: 0,0:15:50.36,0:15:51.57,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:15:51.65,0:15:52.16,Default,,0,0,0,,Маюри үшін сол сәт келгенде қасында болғым келеді… яғни…
Dialogue: 0,0:15:53.53,0:15:54.66,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:55.45,0:15:56.99,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:16:06.84,0:16:07.34,Default,,0,0,0,,Әй?
Dialogue: 0,0:16:07.96,0:16:08.88,Default,,0,0,0,,Сол жерде...
Dialogue: 0,0:16:08.96,0:16:10.59,Default,,0,0,0,,Бұл мен бұрын болған жерім.
Dialogue: 0,0:16:11.13,0:16:13.13,Default,,0,0,0,,Қызыл айдаһар жоқ
Dialogue: 0,0:16:14.18,0:16:17.18,Default,,0,0,0,,Сіз шынымен өмірге оралдыңыз ба...?
Dialogue: 0,0:16:17.26,0:16:18.06,Default,,0,0,0,,Жоқ
Dialogue: 0,0:16:18.14,0:16:20.73,Default,,0,0,0,,Иттер сергек емес сияқты.
Dialogue: 0,0:16:21.23,0:16:24.31,Default,,0,0,0,,Сиқыршы оны өшіріп тастаған немесе алып кеткен шығар.
Dialogue: 0,0:16:24.40,0:16:26.56,Default,,0,0,0,,Жарылыс белгілері бар...
Dialogue: 0,0:16:26.65,0:16:29.69,Default,,0,0,0,,Айдаһардың жанармай қалтасының жанында отты қолданыңыз.
Dialogue: 0,0:16:29.78,0:16:31.07,Default,,0,0,0,,Өртке оранды.
Dialogue: 0,0:16:31.15,0:16:33.07,Default,,0,0,0,,Сен жақсысың деп үміттенемін.
Dialogue: 0,0:16:33.15,0:16:35.32,Default,,0,0,0,,Менің достарымның бірі кенеттен
Dialogue: 0,0:16:35.41,0:16:37.58,Default,,0,0,0,,Мені қорғаныс сиқырымен қорға
Dialogue: 0,0:16:37.66,0:16:38.58,Default,,0,0,0,,Барлығы жақсы болды
Dialogue: 0,0:16:39.29,0:16:42.08,Default,,0,0,0,,Достарың бар емес пе?
Dialogue: 0,0:16:42.16,0:16:44.58,Default,,0,0,0,,Менің айтып отырғаным бұл емес.
Dialogue: 0,0:16:44.67,0:16:47.96,Default,,0,0,0,,Ол мұндай сиқырды қолдана алатынын білмеді де.
Dialogue: 0,0:16:48.04,0:16:50.71,Default,,0,0,0,,Емші ішке кіріп, барлығын қырып сала жаздады.
Dialogue: 0,0:16:51.67,0:16:53.55,Default,,0,0,0,,Соңында сәтті болғанымен
Dialogue: 0,0:16:53.63,0:16:56.34,Default,,0,0,0,,Егер сәтсіздікке ұшырасаңыз, сіз жай ғана ақымақсыз.
Dialogue: 0,0:16:57.80,0:17:00.72,Default,,0,0,0,,Олар осындай.
Dialogue: 0,0:17:02.73,0:17:05.60,Default,,0,0,0,,Біріншіден, балалар мұны өз беттеріңізбен қалай орындадыңыздар?
Dialogue: 0,0:17:05.69,0:17:07.23,Default,,0,0,0,,Қызыл айдаһарды жеңдіңіз бе?
Dialogue: 0,0:17:08.40,0:17:10.19,Default,,0,0,0,,Мені және Сеншіді тарт
Dialogue: 0,0:17:10.27,0:17:13.28,Default,,0,0,0,,Сол кезде Лайос... оның жолдасы Таллман...
Dialogue: 0,0:17:13.36,0:17:15.41,Default,,0,0,0,,Қызыл айдаһардың төсіне секіру
Dialogue: 0,0:17:15.49,0:17:16.99,Default,,0,0,0,,Сіз маңызды нүктеге жеткен сияқтысыз.
Dialogue: 0,0:17:17.07,0:17:18.91,Default,,0,0,0,,Ой, әсері кетіп қалды ғой
Dialogue: 0,0:17:18.99,0:17:22.25,Default,,0,0,0,,Соғысқандар батыл болуы керек.
Dialogue: 0,0:17:22.33,0:17:24.58,Default,,0,0,0,,Бұл батылдық емес
Dialogue: 0,0:17:25.08,0:17:27.29,Default,,0,0,0,,Бұл жақсы, өйткені ол табысты.
Dialogue: 0,0:17:27.38,0:17:28.75,Default,,0,0,0,,Бұл ақымақ ставка болды.
Dialogue: 0,0:17:29.59,0:17:31.80,Default,,0,0,0,,Шынымды айтсам, мен шошып кеттім.
Dialogue: 0,0:17:31.88,0:17:34.88,Default,,0,0,0,,Осындай үкім шығарған адам не болады екен...
Dialogue: 0,0:17:35.59,0:17:38.72,Default,,0,0,0,,Кейбір достар кешті тастап кетті, бірақ...
Dialogue: 0,0:17:40.85,0:17:44.35,Default,,0,0,0,,Енді ойлап қарасам, олар менен ақылдырақ болған шығар.
Dialogue: 0,0:17:45.06,0:17:46.23,Default,,0,0,0,,Қыңыр болмай
Dialogue: 0,0:17:46.73,0:17:48.69,Default,,0,0,0,,Менің де сол кезде кетуім керек еді.
Dialogue: 0,0:17:50.27,0:17:53.99,Default,,0,0,0,,Осының кесірінен достарыңызды жоғалтқыңыз келе ме?
Dialogue: 0,0:17:56.32,0:17:58.49,Default,,0,0,0,,Сіз қалай ойлайсыз? Күтпеген жерден...
Dialogue: 0,0:17:59.16,0:18:01.49,Default,,0,0,0,,Себебі сіз артыңыздан барамын дедіңіз
Dialogue: 0,0:18:01.58,0:18:03.91,Default,,0,0,0,,Бәлкім, ол енді айтқанынан қайтпайтын шығар...
Dialogue: 0,0:18:06.04,0:18:08.37,Default,,0,0,0,,Одан кейін не болды?
Dialogue: 0,0:18:09.33,0:18:12.21,Default,,0,0,0,,Жарақаттарыңызды және барлығын емдеңіз.
Dialogue: 0,0:18:12.30,0:18:14.26,Default,,0,0,0,,Осы бөлмеде
Dialogue: 0,0:18:19.34,0:18:21.43,Default,,0,0,0,,Айдаһардың етін пісіріп жеді.
Dialogue: 0,0:18:22.10,0:18:23.18,Default,,0,0,0,,Бұл жақсы
Dialogue: 0,0:18:23.26,0:18:25.14,Default,,0,0,0,,Бұл оны жеңген адамның артықшылығы.
Dialogue: 0,0:18:29.10,0:18:31.81,Default,,0,0,0,,Сиқыршы бұдан кейін пайда болды ма?
Dialogue: 0,0:18:31.90,0:18:34.28,Default,,0,0,0,,Балалар, сендер қалай аман қалдыңдар?
Dialogue: 0,0:18:35.74,0:18:37.53,Default,,0,0,0,,Сиқыршы жолдас
Dialogue: 0,0:18:37.61,0:18:39.32,Default,,0,0,0,,Бұл маған шабуылдан аман қалуға көмектесті.
Dialogue: 0,0:18:40.16,0:18:41.70,Default,,0,0,0,,Мынау ұзын құлақ адам кім?
Dialogue: 0,0:18:41.78,0:18:44.24,Default,,0,0,0,,Ол соншалықты ақымақ болып көрінсе де.
Dialogue: 0,0:18:44.33,0:18:46.04,Default,,0,0,0,,Бұл шынымен ақымақ.
Dialogue: 0,0:18:46.12,0:18:48.21,Default,,0,0,0,,Тіпті күмәнді сиқырды қолдану
Dialogue: 0,0:18:48.29,0:18:50.04,Default,,0,0,0,,Лабиринттен шыға білу
Dialogue: 0,0:18:50.12,0:18:52.42,Default,,0,0,0,,Мен лайықты өмір сүре алмаймын деп ойлаймын!
Dialogue: 0,0:18:53.50,0:18:57.42,Default,,0,0,0,,Барлығы, мынау, ақымақ және ақымақ.
Dialogue: 0,0:18:57.51,0:18:59.09,Default,,0,0,0,,Сен үлкен ақымақсың!
Dialogue: 0,0:18:59.76,0:19:02.60,Default,,0,0,0,,Мен өзімді қатты итерсем, сауап алатыныма сенемін.
Dialogue: 0,0:19:02.68,0:19:03.68,Default,,0,0,0,,Сол жігіттер
Dialogue: 0,0:19:03.76,0:19:05.93,Default,,0,0,0,,Сіз мені шынымен көндіре аласыз ба?
Dialogue: 0,0:19:06.81,0:19:08.68,Default,,0,0,0,,Сонда сен алдайсың ба?
Dialogue: 0,0:19:08.77,0:19:11.10,Default,,0,0,0,,Басқа, жақсы жолдар бар.
Dialogue: 0,0:19:12.02,0:19:15.94,Default,,0,0,0,,Өтірік айту арқылы жерге қайта оралсаңыз, бұл керемет!
Dialogue: 0,0:19:16.03,0:19:17.44,Default,,0,0,0,,Мен қорқақпын!
Dialogue: 0,0:19:17.53,0:19:20.36,Default,,0,0,0,,Өйткені менің өмірім ең маңыздысы!
Dialogue: 0,0:19:21.11,0:19:22.32,Default,,0,0,0,,орнына...
Dialogue: 0,0:19:24.53,0:19:27.83,Default,,0,0,0,,«Мен сенің өлгеніңді қаламаймын» деп шынымды айтсам екен.
Dialogue: 0,0:19:28.33,0:19:29.12,Default,,0,0,0,,Хмм
Dialogue: 0,0:19:34.96,0:19:38.80,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:19:38.88,0:19:40.17,Default,,0,0,0,,Уф!
Dialogue: 0,0:19:40.68,0:19:43.34,Default,,0,0,0,,...байғұс, сен мұнда неге келдің?
Dialogue: 0,0:19:43.93,0:19:46.26,Default,,0,0,0,,Осы жерге дейін жорғалап шықтыңыз ба?
Dialogue: 0,0:19:47.85,0:19:49.10,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:51.69,0:19:55.44,Default,,0,0,0,,Арамыздағы ең ақылдысы сен едің.
Dialogue: 0,0:19:59.57,0:20:00.78,Default,,0,0,0,,Қан ізі…
Dialogue: 0,0:20:01.45,0:20:03.66,Default,,0,0,0,,Тіпті өлі денені де сүйреп апарған...
Dialogue: 0,0:20:04.57,0:20:05.16,Default,,0,0,0,,Эй
Dialogue: 0,0:20:05.70,0:20:06.91,Default,,0,0,0,,Мен оны қалдырамын.
Dialogue: 0,0:20:07.45,0:20:09.16,Default,,0,0,0,,Ах, оо
Dialogue: 0,0:20:15.67,0:20:17.50,Default,,0,0,0,,Мен жүктерімді жинадым...
Dialogue: 0,0:20:20.21,0:20:22.05,Default,,0,0,0,,Ой, не істеп жатырсың!
Dialogue: 0,0:20:22.13,0:20:23.84,Default,,0,0,0,,Тынышсыз демалыңыз!
Dialogue: 0,0:20:23.93,0:20:25.14,Default,,0,0,0,,Еш жері ауырмайды!
Dialogue: 0,0:20:25.22,0:20:28.01,Default,,0,0,0,,Бұл сіздің ауырсыну сезімін ақымақ ететін дәрі ғана!
Dialogue: 0,0:20:28.10,0:20:31.02,Default,,0,0,0,,Фарин ше? Ол әлі де жақын жерде болуы керек! ау
Dialogue: 0,0:20:32.10,0:20:33.60,Default,,0,0,0,,Сабыр ет!
Dialogue: 0,0:20:34.10,0:20:35.52,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:37.11,0:20:38.82,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:20:40.65,0:20:41.90,Default,,0,0,0,,Екі адам сөйлесетін нәрсе бар.
Dialogue: 0,0:20:42.49,0:20:43.70,Default,,0,0,0,,Чилчак
Dialogue: 0,0:20:43.78,0:20:45.91,Default,,0,0,0,,Мен бұл туралы ойладым, бірақ мен...
Dialogue: 0,0:20:45.99,0:20:48.62,Default,,0,0,0,,Алдымен мен сөйлесейін.
Dialogue: 0,0:20:50.75,0:20:51.58,Default,,0,0,0,,Лайос
Dialogue: 0,0:20:53.04,0:20:56.21,Default,,0,0,0,,Дәл қазір сіздің ойыңызда не бар екенін болжау тым көп.
Dialogue: 0,0:20:56.75,0:21:00.76,Default,,0,0,0,,Бірақ одан әрі зерттеу мүмкін емес.
Dialogue: 0,0:21:02.26,0:21:04.18,Default,,0,0,0,,Біреу болуы керек...
Dialogue: 0,0:21:04.26,0:21:05.43,Default,,0,0,0,,Өл
Dialogue: 0,0:21:05.51,0:21:06.22,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:06.76,0:21:08.51,Default,,0,0,0,,Өтінемін... Лайос
Dialogue: 0,0:21:10.06,0:21:13.14,Default,,0,0,0,,Осы жерде шыдап, жер бетіне қайт!
Dialogue: 0,0:21:13.23,0:21:15.60,Default,,0,0,0,,Балалар мен сендерді жоғалтқым келмейді!
Dialogue: 0,0:21:15.69,0:21:19.32,Default,,0,0,0,,Сенің әпкеңе деген сезіміңмен теңесе алмасам да.
Dialogue: 0,0:21:19.40,0:21:20.73,Default,,0,0,0,,Бұл үш адамға арналған!
Dialogue: 0,0:21:20.82,0:21:24.28,Default,,0,0,0,,Егер сіз ашуланған сиқыршыны көрдім десеңіз, аралдың иесі қозғалуы мүмкін!
Dialogue: 0,0:21:24.36,0:21:27.07,Default,,0,0,0,,Сіз сондай-ақ ақша жинап, біреуді жалдай аласыз!
Dialogue: 0,0:21:27.16,0:21:28.45,Default,,0,0,0,,Дайын болсаңыз
Dialogue: 0,0:21:28.53,0:21:31.08,Default,,0,0,0,,Сіз бұл қабатқа тезірек жете аласыз!
Dialogue: 0,0:21:31.66,0:21:34.83,Default,,0,0,0,,Сонымен... өтінемін...
Dialogue: 0,0:21:36.62,0:21:39.13,Default,,0,0,0,,Артқа бұрылайық... Лайос
Dialogue: 0,0:21:41.67,0:21:43.55,Default,,0,0,0,,Уф... Уф
Dialogue: 0,0:21:43.63,0:21:45.34,Default,,0,0,0,,Шынымды айтсам...
Dialogue: 0,0:21:45.42,0:21:49.85,Default,,0,0,0,,Дәмдеуіштер сияқты аз ғана ингредиенттер қалды.
Dialogue: 0,0:21:49.93,0:21:54.02,Default,,0,0,0,,Мен Фаринге дәмді тағам бергім келеді.
Dialogue: 0,0:21:54.10,0:21:57.10,Default,,0,0,0,,Біз қалаға оралып, қорларды толтыруымыз керек.
Dialogue: 0,0:21:59.61,0:22:02.61,Default,,0,0,0,,Қызыл айдаһар құлап, хабаршы жіберілді.
Dialogue: 0,0:22:02.69,0:22:04.86,Default,,0,0,0,,Менің ағаларым қайтып келеді.
Dialogue: 0,0:22:05.57,0:22:07.45,Default,,0,0,0,,Дайындықты аяқтасаңыз
Dialogue: 0,0:22:07.53,0:22:09.62,Default,,0,0,0,,Егер сіз қайта оралсаңыз
Dialogue: 0,0:22:09.70,0:22:13.29,Default,,0,0,0,,Қолымыздан келгенше ынтымақтасамыз.
Dialogue: 0,0:22:14.12,0:22:16.37,Default,,0,0,0,,Хмм...
Dialogue: 0,0:22:16.46,0:22:18.12,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:22:18.21,0:22:19.38,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:22:20.84,0:22:23.13,Default,,0,0,0,,Сізді алаңдатқаным үшін кешіріңіз.
Dialogue: 0,0:22:23.96,0:22:26.88,Default,,0,0,0,,Бір рет артқа бұрылайық
Dialogue: 0,0:22:29.05,0:22:29.76,Default,,0,0,0,,Иә
Dialogue: 0,0:22:31.01,0:22:33.01,Default,,0,0,0,,♪~
Dialogue: 0,0:23:58.18,0:24:00.18,Default,,0,0,0,,~♪
Dialogue: 0,0:24:01.68,0:24:07.68,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory