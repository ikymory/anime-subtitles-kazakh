Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:30.02,0:01:40.03,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:01:40.03,0:01:42.04,Default,,0000,0000,0000,,Жоқ, шынымен➡
Dialogue: 0,0:01:42.04,0:01:45.71,Default,,0000,0000,0000,,Қара магия қорқынышты.
Dialogue: 0,0:01:42.04,0:01:45.71,Default,,0000,0000,0000,,Белгілі бір сома бар.
Dialogue: 0,0:01:45.71,0:01:49.04,Default,,0000,0000,0000,,Барлығы осы
Dialogue: 0,0:01:45.71,0:01:49.04,Default,,0000,0000,0000,,Қайта тірілу керек еді?
Dialogue: 0,0:01:49.04,0:01:51.71,Default,,0000,0000,0000,,Шлоу мырзаның ашуланғаны таңқаларлық емес.
Dialogue: 0,0:01:51.71,0:01:55.38,Default,,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,0:01:51.71,0:01:55.38,Default,,0000,0000,0000,,Ол әдіс арқылы өмірге қайтарылды➡
Dialogue: 0,0:01:55.38,0:01:57.38,Default,,0000,0000,0000,,Тәуекелден басқа ештеңе жоқ, солай ма?
Dialogue: 0,0:01:57.38,0:02:00.99,Default,,0000,0000,0000,,Өлгені жөн
Dialogue: 0,0:01:57.38,0:02:00.99,Default,,0000,0000,0000,,Тіпті ол үшін.
Dialogue: 0,0:01:57.38,0:02:00.99,Default,,0000,0000,0000,,Тоқта!
Dialogue: 0,0:02:00.99,0:02:04.49,Default,,0000,0000,0000,,Менің айтқым келгені
Dialogue: 0,0:02:00.99,0:02:04.49,Default,,0000,0000,0000,,Себебі мен түсінемін.
Dialogue: 0,0:02:04.49,0:02:07.49,Default,,0000,0000,0000,,Артық емес.
Dialogue: 0,0:02:07.49,0:02:11.00,Default,,0000,0000,0000,,Уф... Кешіріңіз.
Dialogue: 0,0:02:11.00,0:02:14.67,Default,,0000,0000,0000,,Шлоу мырза да, тереңде,
Dialogue: 0,0:02:11.00,0:02:14.67,Default,,0000,0000,0000,,Сіз байқағаныңызға сенімдімін.
Dialogue: 0,0:02:14.67,0:02:17.34,Default,,0000,0000,0000,,Егер сіз
Dialogue: 0,0:02:14.67,0:02:17.34,Default,,0000,0000,0000,,Егер сіз де осындай жағдайда болсаңыз➡
Dialogue: 0,0:02:17.34,0:02:19.51,Default,,0000,0000,0000,,Дәл сол құралдар
Dialogue: 0,0:02:17.34,0:02:19.51,Default,,0000,0000,0000,,Сіз оны таңдамадыңыз ба?
Dialogue: 0,0:02:19.51,0:02:23.84,Default,,0000,0000,0000,,Мен білемін! Білемін бірақ
Dialogue: 0,0:02:19.51,0:02:23.84,Default,,0000,0000,0000,,Мына жігіттің мінезі тым көп!
Dialogue: 0,0:02:23.84,0:02:25.85,Default,,0000,0000,0000,,｟Райос: Мен құбыжықтарды жедім.
Dialogue: 0,0:02:25.85,0:02:28.35,Default,,0000,0000,0000,,Естеліктері бар қызыл айдаһар ма деп ойлаймын.
Dialogue: 0,0:02:28.35,0:02:30.35,Default,,0000,0000,0000,,Қараңдар, қараңдар! Құбыжық қылыш!
Dialogue: 0,0:02:30.35,0:02:33.85,Default,,0000,0000,0000,,Мен қара магияны қолдандым...
Dialogue: 0,0:02:30.35,0:02:33.85,Default,,0000,0000,0000,,Шро үндемейді, солай ма? ｠
Dialogue: 0,0:02:33.85,0:02:36.19,Default,,0000,0000,0000,,Ко...! Қалай болғанда да➡
Dialogue: 0,0:02:36.19,0:02:39.53,Default,,0000,0000,0000,,Мен сенің не ойлайтыныңды білемін
Dialogue: 0,0:02:36.19,0:02:39.53,Default,,0000,0000,0000,,Мен шынымен түсінбеймін.
Dialogue: 0,0:02:39.53,0:02:42.20,Default,,0000,0000,0000,,Мен тіпті түсінбеймін деп ойлаймын.
Dialogue: 0,0:02:42.20,0:02:44.20,Default,,0000,0000,0000,,Ынтымақтастық мүмкін емес.
Dialogue: 0,0:02:44.20,0:02:46.20,Default,,0000,0000,0000,,Лайос! Сенши!
Dialogue: 0,0:02:44.20,0:02:46.20,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:02:46.20,0:02:51.87,Default,,0000,0000,0000,,Жаман, аспазшылар тобына бар.
Dialogue: 0,0:02:46.20,0:02:51.87,Default,,0000,0000,0000,,Бір топ құбыжықтар кіріп келеді...
Dialogue: 0,0:02:51.87,0:02:54.04,Default,,0000,0000,0000,,Сіз не істедіңіз?
Dialogue: 0,0:02:54.04,0:02:57.38,Default,,0000,0000,0000,,Мен саған болғанның бәрін айттым.
Dialogue: 0,0:02:57.38,0:03:00.81,Default,,0000,0000,0000,,Барлығы! ?
Dialogue: 0,0:02:57.38,0:03:00.81,Default,,0000,0000,0000,,Шлоу түсінеді ме деп ойлаймын...
Dialogue: 0,0:03:00.81,0:03:03.65,Default,,0000,0000,0000,,Қалай қарасаң да, ең сорақысы!
Dialogue: 0,0:03:00.81,0:03:03.65,Default,,0000,0000,0000,,, солай ма?
Dialogue: 0,0:03:03.65,0:03:08.15,Default,,0000,0000,0000,,Не, бұл менің кінәм бе?
Dialogue: 0,0:03:03.65,0:03:08.15,Default,,0000,0000,0000,,Бұл менің қателігім болды ма? бұл.
Dialogue: 0,0:03:08.15,0:03:12.16,Default,,0000,0000,0000,,Көңіл көтеру.
Dialogue: 0,0:03:08.15,0:03:12.16,Default,,0000,0000,0000,,Ол да аздап шаршады.
Dialogue: 0,0:03:14.16,0:03:16.83,Default,,0000,0000,0000,,Мен оны құрметтеймін.
Dialogue: 0,0:03:16.83,0:03:20.67,Default,,0000,0000,0000,,Шытырман оқиға кезінде неше рет
Dialogue: 0,0:03:16.83,0:03:20.67,Default,,0000,0000,0000,,Ол маған көмектесті ме, білмеймін➡
Dialogue: 0,0:03:20.67,0:03:23.84,Default,,0000,0000,0000,,Отан және
Dialogue: 0,0:03:20.67,0:03:23.84,Default,,0000,0000,0000,,Мен бұл аралды ғана білемін➡
Dialogue: 0,0:03:23.84,0:03:26.51,Default,,0000,0000,0000,,Маған шет елдер туралы әңгімелеп берді.
Dialogue: 0,0:03:26.51,0:03:31.18,Default,,0000,0000,0000,,Шлоу әрқашан сабырлы.
Dialogue: 0,0:03:26.51,0:03:31.18,Default,,0000,0000,0000,,Ол ақылды адам еді.
Dialogue: 0,0:03:31.18,0:03:34.35,Default,,0000,0000,0000,,Сондықтан ашуланады.
Dialogue: 0,0:03:34.35,0:03:37.35,Default,,0000,0000,0000,,Мен өте жаман нәрсе жасаған болуым керек.
Dialogue: 0,0:03:37.35,0:03:41.02,Default,,0000,0000,0000,,Достық осылай жалғасады
Dialogue: 0,0:03:37.35,0:03:41.02,Default,,0000,0000,0000,,Соның аяқталғанын көргенде қынжыламын.
Dialogue: 0,0:03:41.02,0:03:43.19,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:03:41.02,0:03:43.19,Default,,0000,0000,0000,,(Гарпының күлкісі)
Dialogue: 0,0:03:43.19,0:03:45.86,Default,,0000,0000,0000,,Онда неге сол тікұшақ келді?
Dialogue: 0,0:03:43.19,0:03:45.86,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:03:43.19,0:03:45.86,Default,,0000,0000,0000,,Уф.
Dialogue: 0,0:03:45.86,0:03:48.36,Default,,0000,0000,0000,,(Гарпилердің күлкісі)
Dialogue: 0,0:03:48.36,0:03:50.36,Default,,0000,0000,0000,,Гарпи….
Dialogue: 0,0:03:50.36,0:03:53.53,Default,,0000,0000,0000,,Ей! Хмм.
Dialogue: 0,0:03:53.53,0:03:56.84,Default,,0000,0000,0000,,Себебі анық емес.
Dialogue: 0,0:03:53.53,0:03:56.84,Default,,0000,0000,0000,,Әсеби! Кеттік, үшеуі де!
Dialogue: 0,0:03:58.87,0:04:00.81,Default,,0000,0000,0000,,А...?
Dialogue: 0,0:04:00.81,0:04:04.48,Default,,0000,0000,0000,,Лайостағы Шуро деген жігітке.
Dialogue: 0,0:04:00.81,0:04:04.48,Default,,0000,0000,0000,,Мен саған осы уақытқа дейін бәрін айттым.
Dialogue: 0,0:04:04.48,0:04:08.98,Default,,0000,0000,0000,,Иә! Және бұл атмосфера! ?
Dialogue: 0,0:04:04.48,0:04:08.98,Default,,0000,0000,0000,,Шро - банка.
Dialogue: 0,0:04:08.98,0:04:11.99,Default,,0000,0000,0000,,Мен не істеуім керек?
Dialogue: 0,0:04:08.98,0:04:11.99,Default,,0000,0000,0000,,Бұл туралы жер бетінде білсек...
Dialogue: 0,0:04:11.99,0:04:14.99,Default,,0000,0000,0000,,Мен білемін. Мен білемін, бірақ...
Dialogue: 0,0:04:11.99,0:04:14.99,Default,,0000,0000,0000,,Құдай-ай!
Dialogue: 0,0:04:14.99,0:04:16.99,Default,,0000,0000,0000,,Нвааах!
Dialogue: 0,0:04:16.99,0:04:19.49,Default,,0000,0000,0000,,Ниндзяларға келетін болсақ
Dialogue: 0,0:04:16.99,0:04:19.49,Default,,0000,0000,0000,,Іс жақсы жүріп жатқан сияқты.
Dialogue: 0,0:04:19.49,0:04:21.83,Default,,0000,0000,0000,,Әзірге
Dialogue: 0,0:04:19.49,0:04:21.83,Default,,0000,0000,0000,,Тағы кім біледі?
Dialogue: 0,0:04:21.83,0:04:25.67,Default,,0000,0000,0000,,Қазіргі уақытта 4 адам.
Dialogue: 0,0:04:21.83,0:04:25.67,Default,,0000,0000,0000,,Шлоуға және оның екі қызметшісіне...
Dialogue: 0,0:04:25.67,0:04:28.67,Default,,0000,0000,0000,,Ал әлгі бұйра шашты жігіт.
Dialogue: 0,0:04:28.67,0:04:31.34,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:04:28.67,0:04:31.34,Default,,0000,0000,0000,,Уф.
Dialogue: 0,0:04:31.34,0:04:34.67,Default,,0000,0000,0000,,Бұл адам?
Dialogue: 0,0:04:31.34,0:04:34.67,Default,,0000,0000,0000,,Ол қазынаның құрсауынан жойылды, солай ма?
Dialogue: 0,0:04:34.67,0:04:37.84,Default,,0000,0000,0000,,Сен мұнда не үшін келдің?
Dialogue: 0,0:04:34.67,0:04:37.84,Default,,0000,0000,0000,,Келіңіздер.
Dialogue: 0,0:04:37.84,0:04:41.85,Default,,0000,0000,0000,,Ұрланған олжа немесе азық-түлік
Dialogue: 0,0:04:37.84,0:04:41.85,Default,,0000,0000,0000,,Сіз «біреуді» іздемейсіз бе?
Dialogue: 0,0:04:41.85,0:04:45.69,Default,,0000,0000,0000,,Түсініспеушілікті жоюым керек!
Dialogue: 0,0:04:41.85,0:04:45.69,Default,,0000,0000,0000,,Олжа - қазынаның қатесі➡
Dialogue: 0,0:04:45.69,0:04:49.52,Default,,0000,0000,0000,,Тамақ су астында қалды
Dialogue: 0,0:04:45.69,0:04:49.52,Default,,0000,0000,0000,,Өйткені ол қираған!
Dialogue: 0,0:04:45.69,0:04:49.52,Default,,0000,0000,0000,,Идиот!
Dialogue: 0,0:04:49.52,0:04:52.19,Default,,0000,0000,0000,,Мәселе қара магияда көбірек.
Dialogue: 0,0:04:52.19,0:04:55.19,Default,,0000,0000,0000,,Шро ашуланады, бірақ проблема жоқ.
Dialogue: 0,0:04:55.19,0:04:58.87,Default,,0000,0000,0000,,Жою қаупі бар Фарин
Dialogue: 0,0:04:55.19,0:04:58.87,Default,,0000,0000,0000,,Өйткені сен бізге ашулысың.
Dialogue: 0,0:04:58.87,0:05:01.80,Default,,0000,0000,0000,,Ал басқалары ше...
Dialogue: 0,0:05:01.80,0:05:04.64,Default,,0000,0000,0000,,Айтпақшы
Dialogue: 0,0:05:01.80,0:05:04.64,Default,,0000,0000,0000,,Сіздің қара магияны қолданғаныңыздың дәлелі➡
Dialogue: 0,0:05:04.64,0:05:06.64,Default,,0000,0000,0000,,Қанша қалды?
Dialogue: 0,0:05:06.64,0:05:10.14,Default,,0000,0000,0000,,Мм... сиқырлы шеңбер қазірдің өзінде бар.
Dialogue: 0,0:05:06.64,0:05:10.14,Default,,0000,0000,0000,,Ол тазалаушымен бірге жоғалып кетті➡
Dialogue: 0,0:05:10.14,0:05:12.31,Default,,0000,0000,0000,,Фариннің денесі мен таяқтары➡
Dialogue: 0,0:05:12.31,0:05:15.15,Default,,0000,0000,0000,,Мұқият зерттелсе
Dialogue: 0,0:05:12.31,0:05:15.15,Default,,0000,0000,0000,,Бұл қаншалықты жаман болуы мүмкін?
Dialogue: 0,0:05:15.15,0:05:18.48,Default,,0000,0000,0000,,Олай болса, таяқты қазір өрте!
Dialogue: 0,0:05:15.15,0:05:18.48,Default,,0000,0000,0000,,Күтіңіз, күтіңіз!
Dialogue: 0,0:05:18.48,0:05:21.82,Default,,0000,0000,0000,,Күдік сол кезеңге жетсе
Dialogue: 0,0:05:18.48,0:05:21.82,Default,,0000,0000,0000,,Бірдеңе істеуге қазірдің өзінде кеш...
Dialogue: 0,0:05:21.82,0:05:25.16,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:05:21.82,0:05:25.16,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:05:25.16,0:05:27.49,Default,,0000,0000,0000,,Уау! Бұл! Бұл!
Dialogue: 0,0:05:27.49,0:05:29.50,Default,,0000,0000,0000,,(Гарпилердің күлкісі)
Dialogue: 0,0:05:29.50,0:05:31.50,Default,,0000,0000,0000,,Не? Сол құбыжық.
Dialogue: 0,0:05:31.50,0:05:35.50,Default,,0000,0000,0000,,Гарпи... жоқ.
Dialogue: 0,0:05:31.50,0:05:35.50,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:05:35.50,0:05:53.02,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:05:53.02,0:05:55.02,Default,,0000,0000,0000,,А... бұл өтірік...
Dialogue: 0,0:05:55.02,0:05:57.52,Default,,0000,0000,0000,,Өтірік Неге?
Dialogue: 0,0:05:57.52,0:05:59.53,Default,,0000,0000,0000,,Фари….
Dialogue: 0,0:06:01.46,0:06:04.46,Default,,0000,0000,0000,,Мүмкін емес.
Dialogue: 0,0:06:04.46,0:06:07.30,Default,,0000,0000,0000,,Міне...
Dialogue: 0,0:06:07.30,0:06:09.30,Default,,0000,0000,0000,,Бұл не...!
Dialogue: 0,0:06:13.97,0:06:18.14,Default,,0000,0000,0000,,《Тамаша!
Dialogue: 0,0:06:18.14,0:06:20.81,Default,,0000,0000,0000,,Бірақ аз
Dialogue: 0,0:06:18.14,0:06:20.81,Default,,0000,0000,0000,,Сіз тым сараң емессіз бе?
Dialogue: 0,0:06:20.81,0:06:24.65,Default,,0000,0000,0000,,Қанаттар, қауырсындар, таразылар...》
Dialogue: 0,0:06:20.81,0:06:24.65,Default,,0000,0000,0000,,Фарин!
Dialogue: 0,0:06:24.65,0:06:26.65,Default,,0000,0000,0000,,Сіз мені түсінесіз бе?
Dialogue: 0,0:06:26.65,0:06:28.65,Default,,0000,0000,0000,,Кел, Марсиль!
Dialogue: 0,0:06:26.65,0:06:28.65,Default,,0000,0000,0000,,Құлдым!
Dialogue: 0,0:06:31.16,0:06:34.33,Default,,0000,0000,0000,,Холм! Рин! Ұрысқа дайын!
Dialogue: 0,0:06:31.16,0:06:34.33,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:06:34.33,0:06:37.83,Default,,0000,0000,0000,,Лайос! Шлоу!
Dialogue: 0,0:06:34.33,0:06:37.83,Default,,0000,0000,0000,,Не істеу керек! Маған нұсқау беріңіз!
Dialogue: 0,0:06:34.33,0:06:37.83,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:06:37.83,0:06:40.17,Default,,0000,0000,0000,,Ит балық! Оны ренжітпе!
Dialogue: 0,0:06:40.17,0:06:43.17,Default,,0000,0000,0000,,Ұстаңыз!
Dialogue: 0,0:06:40.17,0:06:43.17,Default,,0000,0000,0000,,Ах... Уау?
Dialogue: 0,0:06:43.17,0:06:46.01,Default,,0000,0000,0000,,Қашуға болмайды, кішкентай бала... Уф.
Dialogue: 0,0:06:46.01,0:06:48.31,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:06:53.51,0:06:56.52,Default,,0000,0000,0000,,Гвааа!
Dialogue: 0,0:06:53.51,0:06:56.52,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:06:58.52,0:07:01.95,Default,,0000,0000,0000,,Гуарг... Уау!
Dialogue: 0,0:07:01.95,0:07:05.63,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:07:01.95,0:07:05.63,Default,,0000,0000,0000,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:07:05.63,0:07:09.46,Default,,0000,0000,0000,,Ум, басып ал, басып ал. Зақым келтірместен ұсталды.
Dialogue: 0,0:07:09.46,0:07:11.80,Default,,0000,0000,0000,,Зиянсыз түсіріңіз! ?
Dialogue: 0,0:07:11.80,0:07:13.80,Default,,0000,0000,0000,,Нуах!
Dialogue: 0,0:07:18.97,0:07:20.97,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:07:24.81,0:07:27.81,Default,,0000,0000,0000,,Мен бара аламын ба, Холм?
Dialogue: 0,0:07:24.81,0:07:27.81,Default,,0000,0000,0000,,Ух... иә.
Dialogue: 0,0:07:27.81,0:07:31.65,Default,,0000,0000,0000,,Жарайды...шығыңдар.
Dialogue: 0,0:07:31.65,0:07:33.82,Default,,0000,0000,0000,,Хмм… мм….
Dialogue: 0,0:07:33.82,0:07:38.83,Default,,0000,0000,0000,,Хмм... аа... ой...
Dialogue: 0,0:07:38.83,0:07:40.99,Default,,0000,0000,0000,,Как… Как….
Dialogue: 0,0:07:40.99,0:07:44.30,Default,,0000,0000,0000,,Гах... ха...
Dialogue: 0,0:07:49.00,0:07:52.34,Default,,0000,0000,0000,,А...?
Dialogue: 0,0:07:52.34,0:07:54.34,Default,,0000,0000,0000,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:07:54.34,0:07:56.51,Default,,0000,0000,0000,,Фарин!
Dialogue: 0,0:07:54.34,0:07:56.51,Default,,0000,0000,0000,,Болдырмау керек пе?
Dialogue: 0,0:07:56.51,0:07:58.68,Default,,0000,0000,0000,,Сіз мұны басқарасыз ба?
Dialogue: 0,0:07:58.68,0:08:02.28,Default,,0000,0000,0000,,Оны тоқтатуыңызды өтінемін!
Dialogue: 0,0:07:58.68,0:08:02.28,Default,,0000,0000,0000,,Ол жай ғана абдырап қалды!
Dialogue: 0,0:08:02.28,0:08:05.12,Default,,0000,0000,0000,,Цк, уайымдама.
Dialogue: 0,0:08:05.12,0:08:07.95,Default,,0000,0000,0000,,Сіздің
Dialogue: 0,0:08:05.12,0:08:07.95,Default,,0000,0000,0000,,Өзіңіз үшін маңызды адамды қорғағыңыз келсе➡
Dialogue: 0,0:08:07.95,0:08:10.62,Default,,0000,0000,0000,,Қанша адамды құрбандыққа шалсақ та
Dialogue: 0,0:08:07.95,0:08:10.62,Default,,0000,0000,0000,,Қарсысыз ба?
Dialogue: 0,0:08:10.62,0:08:13.63,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:08:10.62,0:08:13.63,Default,,0000,0000,0000,,Бұл «ол» емес.
Dialogue: 0,0:08:13.63,0:08:15.83,Default,,0000,0000,0000,,Бұл жай ғана құбыжық!
Dialogue: 0,0:08:13.63,0:08:15.83,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:08:19.13,0:08:22.03,Default,,0000,0000,0000,,Людероес Арнбит.
Dialogue: 0,0:08:27.31,0:08:29.31,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:08:29.31,0:08:33.15,Default,,0000,0000,0000,,Ах, Мариллиер.
Dialogue: 0,0:08:29.31,0:08:33.15,Default,,0000,0000,0000,,Сіз де сиқырлайсыз ба?
Dialogue: 0,0:08:33.15,0:08:38.15,Default,,0000,0000,0000,,Гуруруру….
Dialogue: 0,0:08:38.15,0:08:40.99,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:08:40.99,0:08:43.09,Default,,0000,0000,0000,,Гаа….
Dialogue: 0,0:08:47.49,0:08:50.50,Default,,0000,0000,0000,,Уау Куро!
Dialogue: 0,0:08:47.49,0:08:50.50,Default,,0000,0000,0000,,Ақымақ, жасырын!
Dialogue: 0,0:08:52.67,0:08:54.67,Default,,0000,0000,0000,,Фарин….
Dialogue: 0,0:09:00.44,0:09:02.44,Default,,0000,0000,0000,,Түнгі күзетші келеді. Көзіңді жұмшы.
Dialogue: 0,0:09:02.44,0:09:04.54,Default,,0000,0000,0000,,Орвисті төмендетеді!
Dialogue: 0,0:09:08.11,0:09:10.95,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:09:10.95,0:09:14.75,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:09:19.63,0:09:22.46,Default,,0000,0000,0000,,｟Құбыжықтар қауіпті.
Dialogue: 0,0:09:22.46,0:09:25.46,Default,,0000,0000,0000,,Боқ Кенсуке... Бұл құбыжық! ｠
Dialogue: 0,0:09:28.30,0:09:30.97,Default,,0000,0000,0000,,Кешіріңіз Фарин.
Dialogue: 0,0:09:30.97,0:09:34.27,Default,,0000,0000,0000,,Егер ол ауыстырылса
Dialogue: 0,0:09:30.97,0:09:34.27,Default,,0000,0000,0000,,Мен мұны сен үшін жасағым келді.
Dialogue: 0,0:09:42.98,0:09:45.32,Default,,0000,0000,0000,,Лайос ағасы.
Dialogue: 0,0:09:45.32,0:09:47.32,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:09:54.33,0:09:56.33,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:09:56.33,0:09:58.33,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:09:56.33,0:09:58.33,Default,,0000,0000,0000,,Құлдым!
Dialogue: 0,0:09:58.33,0:10:00.33,Default,,0000,0000,0000,,Өкпе! бүйрек!
Dialogue: 0,0:10:00.33,0:10:02.34,Default,,0000,0000,0000,,Жүрек!
Dialogue: 0,0:10:02.34,0:10:04.34,Default,,0000,0000,0000,,Гаха….
Dialogue: 0,0:10:08.17,0:10:10.18,Default,,0000,0000,0000,,Мм... Аа!
Dialogue: 0,0:10:13.01,0:10:15.01,Default,,0000,0000,0000,,《Өл...》
Dialogue: 0,0:10:13.01,0:10:15.01,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:10:15.01,0:10:17.52,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:10:17.52,0:10:20.35,Default,,0000,0000,0000,,Сіз тұра аласыз ба? ?
Dialogue: 0,0:10:17.52,0:10:20.35,Default,,0000,0000,0000,,Екілене бергеніме менің кінәм болды.
Dialogue: 0,0:10:20.35,0:10:22.52,Default,,0000,0000,0000,,Дұрыс айтасыз.
Dialogue: 0,0:10:22.52,0:10:26.63,Default,,0000,0000,0000,,Менің апамның жаны енді лабиринт иесіне тиесілі.
Dialogue: 0,0:10:22.52,0:10:26.63,Default,,0000,0000,0000,,Бәлкім, бақылауда.
Dialogue: 0,0:10:28.86,0:10:32.03,Default,,0000,0000,0000,,Бірақ мен сені өлтірсем,
Dialogue: 0,0:10:28.86,0:10:32.03,Default,,0000,0000,0000,,Ашуланған сиқыршы шығады.
Dialogue: 0,0:10:32.03,0:10:34.70,Default,,0000,0000,0000,,Енді мен бұл жерден кетуім керек.
Dialogue: 0,0:10:34.70,0:10:37.70,Default,,0000,0000,0000,,Сонымен….
Dialogue: 0,0:10:34.70,0:10:37.70,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:10:37.70,0:10:40.21,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:10:40.21,0:10:42.88,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:10:42.88,0:10:46.05,Default,,0000,0000,0000,,Хаа… Хаа… Хаа….
Dialogue: 0,0:10:46.05,0:10:48.05,Default,,0000,0000,0000,,Фарин!
Dialogue: 0,0:10:48.05,0:10:50.22,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:10:48.05,0:10:50.22,Default,,0000,0000,0000,,Сәлем! ?
Dialogue: 0,0:10:48.05,0:10:50.22,Default,,0000,0000,0000,,Уф.
Dialogue: 0,0:10:50.22,0:10:53.89,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:10:53.89,0:10:56.39,Default,,0000,0000,0000,,Қарғыс атсын... құбыжық!
Dialogue: 0,0:10:56.39,0:11:00.66,Default,,0000,0000,0000,,Ruderoes ejectulum hemtum.
Dialogue: 0,0:11:00.66,0:11:04.00,Default,,0000,0000,0000,,Сол техника... Барлығы менің қасымда қалсын!
Dialogue: 0,0:11:04.00,0:11:11.00,Default,,0000,0000,0000,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:11:11.00,0:11:13.01,Default,,0000,0000,0000,,Эсси!
Dialogue: 0,0:11:11.00,0:11:13.01,Default,,0000,0000,0000,,(Фариннің айқайы)
Dialogue: 0,0:11:13.01,0:11:18.31,Default,,0000,0000,0000,,(Фариннің айқайы)
Dialogue: 0,0:11:25.35,0:11:27.35,Default,,0000,0000,0000,,Кух….
Dialogue: 0,0:11:27.35,0:11:29.36,Default,,0000,0000,0000,,Уау….
Dialogue: 0,0:11:35.86,0:11:38.16,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:11:40.87,0:11:44.54,Default,,0000,0000,0000,,Мүмкін мен қайта оралармын.
Dialogue: 0,0:11:40.87,0:11:44.54,Default,,0000,0000,0000,,Зардап шеккендерді тосқауылға көшіру.
Dialogue: 0,0:11:44.54,0:11:48.37,Default,,0000,0000,0000,,Өлгендер... жақсы, не істеуіміз керек?
Dialogue: 0,0:11:48.37,0:11:52.71,Default,,0000,0000,0000,,Мен тірілемін. Бұл барлығына мүмкін емес.
Dialogue: 0,0:11:52.71,0:11:57.38,Default,,0000,0000,0000,,Мәйіттерді жинаймыз ба?
Dialogue: 0,0:11:52.71,0:11:57.38,Default,,0000,0000,0000,,Жоқ, жоқ, қозғалма.
Dialogue: 0,0:11:57.38,0:12:01.15,Default,,0000,0000,0000,,Төгілген қанның бір тамшысы да босқа кетпейді.
Dialogue: 0,0:12:01.15,0:12:03.99,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:12:03.99,0:12:07.66,Default,,0000,0000,0000,,Құбыжықтар! ?
Dialogue: 0,0:12:03.99,0:12:07.66,Default,,0000,0000,0000,,Ол қашып кетті. Қазір бәрі жақсы.
Dialogue: 0,0:12:07.66,0:12:10.16,Default,,0000,0000,0000,,Енді, келесі...
Dialogue: 0,0:12:07.66,0:12:10.16,Default,,0000,0000,0000,,Күте тұрыңыз!
Dialogue: 0,0:12:10.16,0:12:12.57,Default,,0000,0000,0000,,Алдымен сол адамды тірілткіңіз келсе.
Dialogue: 0,0:12:14.50,0:12:16.50,Default,,0000,0000,0000,,Неге мен?
Dialogue: 0,0:12:16.50,0:12:20.01,Default,,0000,0000,0000,,Майзуру мырза күшті сиқыршы.
Dialogue: 0,0:12:16.50,0:12:20.01,Default,,0000,0000,0000,,Себебі мен сені көрдім➡
Dialogue: 0,0:12:20.01,0:12:23.01,Default,,0000,0000,0000,,Емдеу және реанимация
Dialogue: 0,0:12:20.01,0:12:23.01,Default,,0000,0000,0000,,Бұл пайдалы болуы мүмкін деп ойладым.
Dialogue: 0,0:12:23.01,0:12:26.51,Default,,0000,0000,0000,,Барлығына жалғыз өзі қарайды
Dialogue: 0,0:12:23.01,0:12:26.51,Default,,0000,0000,0000,,Бұл мүмкін емес.
Dialogue: 0,0:12:26.51,0:12:29.01,Default,,0000,0000,0000,,Осы уақытқа дейінгі саяхат
Dialogue: 0,0:12:26.51,0:12:29.01,Default,,0000,0000,0000,,Көмегіңе рахмет➡
Dialogue: 0,0:12:29.01,0:12:31.68,Default,,0000,0000,0000,,Осы дәрежеде.
Dialogue: 0,0:12:29.01,0:12:31.68,Default,,0000,0000,0000,,Сіз несие алдыңыз ба?
Dialogue: 0,0:12:31.68,0:12:37.19,Default,,0000,0000,0000,,Мен оның бәрібір басқа техниканы іздейтініне сенімдімін.
Dialogue: 0,0:12:31.68,0:12:37.19,Default,,0000,0000,0000,,Жарайды, мен оны тез бітіремін.
Dialogue: 0,0:12:37.19,0:12:40.53,Default,,0000,0000,0000,,Егер менде қарапайым реанимация техникасы болса...
Dialogue: 0,0:12:40.53,0:12:43.70,Default,,0000,0000,0000,,Тоқта. Маған бір саусағыңды тигізбе.
Dialogue: 0,0:12:43.70,0:12:48.03,Default,,0000,0000,0000,,Сізге енді қара магия болмайды.
Dialogue: 0,0:12:43.70,0:12:48.03,Default,,0000,0000,0000,,Мен сізге оны пайдалануға рұқсат ете алмаймын.
Dialogue: 0,0:12:48.03,0:12:51.04,Default,,0000,0000,0000,,Мұндай нәрсені қолданбаңыз...
Dialogue: 0,0:12:48.03,0:12:51.04,Default,,0000,0000,0000,,Сонда бұл не?
Dialogue: 0,0:12:51.04,0:12:53.37,Default,,0000,0000,0000,,Ол неге олай көрінеді?
Dialogue: 0,0:12:53.37,0:12:57.04,Default,,0000,0000,0000,,Сіз айдаһар етін пайдаландыңыз.
Dialogue: 0,0:12:53.37,0:12:57.04,Default,,0000,0000,0000,,Менің қара магияны қолданғанымнан болса керек!
Dialogue: 0,0:12:57.04,0:13:01.15,Default,,0000,0000,0000,,Жоқ! Бұл шындық болуы мүмкін емес!
Dialogue: 0,0:12:57.04,0:13:01.15,Default,,0000,0000,0000,,Бұл сиқырдың мұндай күші жоқ!
Dialogue: 0,0:13:01.15,0:13:04.82,Default,,0000,0000,0000,,➡-де ойласаңыз
Dialogue: 0,0:13:04.82,0:13:08.99,Default,,0000,0000,0000,,Қызыл айдаһардың рухына
Dialogue: 0,0:13:04.82,0:13:08.99,Default,,0000,0000,0000,,Қандай да бір трюк орнатылды➡
Dialogue: 0,0:13:08.99,0:13:11.32,Default,,0000,0000,0000,,Фарин мен айдаһардың жаны аралас➡
Dialogue: 0,0:13:11.32,0:13:15.16,Default,,0000,0000,0000,,Ашуланған сиқыршының қолында
Dialogue: 0,0:13:11.32,0:13:15.16,Default,,0000,0000,0000,,Бұл көріністе...
Dialogue: 0,0:13:15.16,0:13:18.83,Default,,0000,0000,0000,,Schro...?
Dialogue: 0,0:13:15.16,0:13:18.83,Default,,0000,0000,0000,,Мына жігітті батыстағы эльфтерге тапсыр.
Dialogue: 0,0:13:15.16,0:13:18.83,Default,,0000,0000,0000,,(Мұғалім) О, қандай жаһандық көзқарас. (Цубаки) 《Уф! Сол сұм~》
Dialogue: 0,0:13:18.83,0:13:21.17,Default,,0000,0000,0000,,Мен «мұны» өлтіре алмаймын.
Dialogue: 0,0:13:21.17,0:13:24.00,Default,,0000,0000,0000,,Бірақ солай
Dialogue: 0,0:13:21.17,0:13:24.00,Default,,0000,0000,0000,,Біз оны жай қалдыра алмаймыз.
Dialogue: 0,0:13:24.00,0:13:27.51,Default,,0000,0000,0000,,Ең болмаса жаным
Dialogue: 0,0:13:24.00,0:13:27.51,Default,,0000,0000,0000,,Лабиринттен босатылды➡
Dialogue: 0,0:13:27.51,0:13:31.51,Default,,0000,0000,0000,,Мен оны тыныштандырғым келеді.
Dialogue: 0,0:13:27.51,0:13:31.51,Default,,0000,0000,0000,,Міне...
Dialogue: 0,0:13:31.51,0:13:34.51,Default,,0000,0000,0000,,Егер эльфтер
Dialogue: 0,0:13:31.51,0:13:34.51,Default,,0000,0000,0000,,Сіз құралдарды білуіңіз керек.
Dialogue: 0,0:13:34.51,0:13:37.85,Default,,0000,0000,0000,,Батыс эльфтерінің алдында
Dialogue: 0,0:13:34.51,0:13:37.85,Default,,0000,0000,0000,,Маған бәрін айтып бер.
Dialogue: 0,0:13:37.85,0:13:41.52,Default,,0000,0000,0000,,Тоқта, Шро.
Dialogue: 0,0:13:37.85,0:13:41.52,Default,,0000,0000,0000,,Басқа жол болуы керек.
Dialogue: 0,0:13:41.52,0:13:44.86,Default,,0000,0000,0000,,бірақ мен міндетті түрде Незуконы қайтадан адамға айналдырамын.
Dialogue: 0,0:13:41.52,0:13:44.86,Default,,0000,0000,0000,,Балалар, осы уақытқа дейін не істедіңдер?
Dialogue: 0,0:13:44.86,0:13:47.69,Default,,0000,0000,0000,,Басқа жол! ?
Dialogue: 0,0:13:44.86,0:13:47.69,Default,,0000,0000,0000,,Сіз не істемексіз?
Dialogue: 0,0:13:47.69,0:13:49.70,Default,,0000,0000,0000,,Ол қалыпты жағдайға оралғанша ➡
Dialogue: 0,0:13:49.70,0:13:53.37,Default,,0000,0000,0000,,Барлық құбыжықтардың етінде
Dialogue: 0,0:13:49.70,0:13:53.37,Default,,0000,0000,0000,,Мен реанимация жасап көруім керек пе? ?
Dialogue: 0,0:13:53.37,0:13:56.70,Default,,0000,0000,0000,,Айт!
Dialogue: 0,0:13:53.37,0:13:56.70,Default,,0000,0000,0000,,Сіз не істеуді жоспарлап отырсыз?
Dialogue: 0,0:13:56.70,0:13:59.91,Default,,0000,0000,0000,,Сізде идея бар ма?
Dialogue: 0,0:13:56.70,0:13:59.91,Default,,0000,0000,0000,,Айт!
Dialogue: 0,0:14:05.31,0:14:07.65,Default,,0000,0000,0000,,Ашуланған сиқыршыны жеңіңіз!
Dialogue: 0,0:14:07.65,0:14:11.82,Default,,0000,0000,0000,,Бұл қызыл айдаһар анық
Dialogue: 0,0:14:07.65,0:14:11.82,Default,,0000,0000,0000,,Оған бірдеңе істеу бұйырылды.
Dialogue: 0,0:14:11.82,0:14:13.82,Default,,0000,0000,0000,,Сіз мұны істей аласыз ➡
Dialogue: 0,0:14:13.82,0:14:16.66,Default,,0000,0000,0000,,Осы лабиринтті жасады
Dialogue: 0,0:14:13.82,0:14:16.66,Default,,0000,0000,0000,,Сиқыршыдан басқа ешкім жоқ.
Dialogue: 0,0:14:16.66,0:14:20.33,Default,,0000,0000,0000,,Содан кейін сиқыршыны өлтіріңіз
Dialogue: 0,0:14:16.66,0:14:20.33,Default,,0000,0000,0000,,Тек пәрменді қайта жазыңыз.
Dialogue: 0,0:14:20.33,0:14:23.16,Default,,0000,0000,0000,,Бұл туралы
Dialogue: 0,0:14:20.33,0:14:23.16,Default,,0000,0000,0000,,Мен оны шынымен түсінбеймін➡
Dialogue: 0,0:14:23.16,0:14:25.50,Default,,0000,0000,0000,,Марсиль мұны істей алуы керек!
Dialogue: 0,0:14:23.16,0:14:25.50,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:14:25.50,0:14:27.67,Default,,0000,0000,0000,,Сондықтан мен саған Марсильді бере алмаймын!
Dialogue: 0,0:14:27.67,0:14:30.00,Default,,0000,0000,0000,,Бір сәт!
Dialogue: 0,0:14:30.00,0:14:34.17,Default,,0000,0000,0000,,Қара магиядан туындаған мәселелер
Dialogue: 0,0:14:30.00,0:14:34.17,Default,,0000,0000,0000,,Сіз оны қара магиямен шешуді жоспарлап отырсыз ба? ?
Dialogue: 0,0:14:34.17,0:14:38.18,Default,,0000,0000,0000,,Кішкене байыпты
Dialogue: 0,0:14:34.17,0:14:38.18,Default,,0000,0000,0000,,Егер заттар туралы ойласақ ше...
Dialogue: 0,0:14:38.18,0:14:40.18,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:14:40.18,0:14:42.18,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:14:44.18,0:14:46.59,Default,,0000,0000,0000,,Кешіріңіз...
Dialogue: 0,0:14:48.69,0:14:50.69,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:14:50.69,0:14:52.69,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:14:50.69,0:14:52.69,Default,,0000,0000,0000,,О!
Dialogue: 0,0:14:52.69,0:14:56.20,Default,,0000,0000,0000,,Мен бұл деңгейге жеткеніме сенімдімін.
Dialogue: 0,0:14:52.69,0:14:56.20,Default,,0000,0000,0000,,Мен онша жақсы емеспін➡
Dialogue: 0,0:14:56.20,0:14:59.87,Default,,0000,0000,0000,,Сіз авантюристтердің көпшілігінен күштісіз.
Dialogue: 0,0:14:59.87,0:15:03.64,Default,,0000,0000,0000,,Бірақ мен мұны анық айта аламын.
Dialogue: 0,0:15:03.64,0:15:05.80,Default,,0000,0000,0000,,Күніне үш рет тамақтаныңыз➡
Dialogue: 0,0:15:05.80,0:15:09.64,Default,,0000,0000,0000,,Бізде ұйықтап жатқандар жақсырақ
Dialogue: 0,0:15:05.80,0:15:09.64,Default,,0000,0000,0000,,Мен байыпты болдым!
Dialogue: 0,0:15:09.64,0:15:11.64,Default,,0000,0000,0000,,Қараңдар!
Dialogue: 0,0:15:09.64,0:15:11.64,Default,,0000,0000,0000,,Уф.
Dialogue: 0,0:15:11.64,0:15:14.81,Default,,0000,0000,0000,,Біз жынды сиқыршылармыз
Dialogue: 0,0:15:11.64,0:15:14.81,Default,,0000,0000,0000,,Міндетті түрде жеңіңіз➡
Dialogue: 0,0:15:14.81,0:15:16.82,Default,,0000,0000,0000,,Мен Фаринді міндетті түрде құтқарамын!
Dialogue: 0,0:15:16.82,0:15:19.32,Default,,0000,0000,0000,,Шуро, жер бетіне оралу керек.
Dialogue: 0,0:15:19.32,0:15:21.99,Default,,0000,0000,0000,,Олай болса тамақ іш, шомыл, ұйықта!
Dialogue: 0,0:15:21.99,0:15:24.66,Default,,0000,0000,0000,,​​О?
Dialogue: 0,0:15:21.99,0:15:24.66,Default,,0000,0000,0000,,(мырылдаған дауыс)
Dialogue: 0,0:15:24.66,0:15:27.66,Default,,0000,0000,0000,,(Косей) Аа, дұрыс. Шыны мен ауыстыратын киім—
Dialogue: 0,0:15:24.66,0:15:27.66,Default,,0000,0000,0000,,(мырылдаған дауыс)
Dialogue: 0,0:15:27.66,0:15:31.86,Default,,0000,0000,0000,,Шулы!
Dialogue: 0,0:15:33.83,0:15:36.17,Default,,0000,0000,0000,,Бұл әлі ойын
Dialogue: 0,0:15:33.83,0:15:36.17,Default,,0000,0000,0000,,Мүмкін емес!
Dialogue: 0,0:15:36.17,0:15:39.84,Default,,0000,0000,0000,,Егер сізге ұнаса
Dialogue: 0,0:15:36.17,0:15:39.84,Default,,0000,0000,0000,,Менің де бір ойым бар!
Dialogue: 0,0:15:39.84,0:15:42.01,Default,,0000,0000,0000,,Ойлар...?
Dialogue: 0,0:15:39.84,0:15:42.01,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:15:42.01,0:15:45.01,Default,,0000,0000,0000,,Лайос! Мен...
Dialogue: 0,0:15:45.01,0:15:47.01,Default,,0000,0000,0000,,Ұзақ уақыт бойы!
Dialogue: 0,0:15:47.01,0:15:49.85,Default,,0000,0000,0000,,Мен саған жақсы емеспін
Dialogue: 0,0:15:47.01,0:15:49.85,Default,,0000,0000,0000,,Бұл қайтымсыз болды!
Dialogue: 0,0:15:49.85,0:15:53.19,Default,,0000,0000,0000,,Өйткені сен
Dialogue: 0,0:15:49.85,0:15:53.19,Default,,0000,0000,0000,,Дөрекі және сезімтал емес➡
Dialogue: 0,0:15:53.19,0:15:56.52,Default,,0000,0000,0000,,Нашар уақыт!
Dialogue: 0,0:15:53.19,0:15:56.52,Default,,0000,0000,0000,,｟Ей, көп шетелдік әңгімелер!
Dialogue: 0,0:15:56.52,0:15:58.69,Default,,0000,0000,0000,,Не, ас беруге уәде? Мен де барамын!
Dialogue: 0,0:15:58.69,0:16:01.13,Default,,0000,0000,0000,,Біз қазір доспыз, солай ма? ｠
Dialogue: 0,0:16:01.13,0:16:04.30,Default,,0000,0000,0000,,Оның үстіне ешқандай зиянды ниет жоқ.
Dialogue: 0,0:16:01.13,0:16:04.30,Default,,0000,0000,0000,,Одан да жаман болды!
Dialogue: 0,0:16:04.30,0:16:06.30,Default,,0000,0000,0000,,Мен сені осы жерде және қазір өлтіремін➡
Dialogue: 0,0:16:06.30,0:16:09.30,Default,,0000,0000,0000,,Марсильді өзіңізбен бірге алыңыз...
Dialogue: 0,0:16:06.30,0:16:09.30,Default,,0000,0000,0000,,Олай болса тез айт!
Dialogue: 0,0:16:09.30,0:16:13.47,Default,,0000,0000,0000,,Неге осы уақытқа дейін үндемедің?
Dialogue: 0,0:16:09.30,0:16:13.47,Default,,0000,0000,0000,,Сен мені ұнатпайсың!
Dialogue: 0,0:16:13.47,0:16:15.64,Default,,0000,0000,0000,,Бұл сезімсіз немесе нашар!
Dialogue: 0,0:16:15.64,0:16:18.98,Default,,0000,0000,0000,,Адамдардың көпшілігі
Dialogue: 0,0:16:15.64,0:16:18.98,Default,,0000,0000,0000,,Байқау үшін айттым!
Dialogue: 0,0:16:18.98,0:16:23.48,Default,,0000,0000,0000,,Оны да аздап түсінуге тырысу керек!
Dialogue: 0,0:16:18.98,0:16:23.48,Default,,0000,0000,0000,,Сіз оны болжай аласыз ба?
Dialogue: 0,0:16:23.48,0:16:26.99,Default,,0000,0000,0000,,Осы аралда тапқан алғашқы досым➡
Dialogue: 0,0:16:26.99,0:16:29.66,Default,,0000,0000,0000,,Мынау қалықтады!
Dialogue: 0,0:16:29.66,0:16:33.33,Default,,0000,0000,0000,,Уау... сен солай айттың...
Dialogue: 0,0:16:29.66,0:16:33.33,Default,,0000,0000,0000,,Маған да бұл жер ұнамайды!
Dialogue: 0,0:16:33.33,0:16:38.33,Default,,0000,0000,0000,,Өзіңіз үшін адал жүзді сақтаңыз!
Dialogue: 0,0:16:33.33,0:16:38.33,Default,,0000,0000,0000,,Сіз басқаларды ауыртпалықты көтеруге мәжбүрлейсіз!
Dialogue: 0,0:16:38.33,0:16:40.33,Default,,0000,0000,0000,,Сіз мұны білесіз бе?
Dialogue: 0,0:16:38.33,0:16:40.33,Default,,0000,0000,0000,,Уау….
Dialogue: 0,0:16:40.33,0:16:43.17,Default,,0000,0000,0000,,Ештеңе айтпа! Мен тіпті жемеймін!
Dialogue: 0,0:16:43.17,0:16:46.51,Default,,0000,0000,0000,,Біз өлерміз
Dialogue: 0,0:16:43.17,0:16:46.51,Default,,0000,0000,0000,,Бұл ауыз ашық!
Dialogue: 0,0:16:46.51,0:16:48.51,Default,,0000,0000,0000,,Шулы ~ Барка!
Dialogue: 0,0:16:48.51,0:16:51.68,Default,,0000,0000,0000,,Сіз жарты Марсильсіз.
Dialogue: 0,0:16:48.51,0:16:51.68,Default,,0000,0000,0000,,Қатты тырыспаңыз!
Dialogue: 0,0:16:51.68,0:16:56.01,Default,,0000,0000,0000,,Егер сіз осындай нәрсені істеп жатсаңыз...
Dialogue: 0,0:16:51.68,0:16:56.01,Default,,0000,0000,0000,,Бұл балалық ұрыс.
Dialogue: 0,0:16:56.01,0:16:58.85,Default,,0000,0000,0000,,Менің білімім үшін кінәлімін.
Dialogue: 0,0:16:58.85,0:17:04.62,Default,,0000,0000,0000,,Жеті адам қайтыс болды, соның ішінде мен де.
Dialogue: 0,0:16:58.85,0:17:04.62,Default,,0000,0000,0000,,1 адам ауыр жағдайда, 3 адам белгісіз.
Dialogue: 0,0:17:04.62,0:17:08.63,Default,,0000,0000,0000,,Мен және гном қолымызды екіге бөлдік.
Dialogue: 0,0:17:04.62,0:17:08.63,Default,,0000,0000,0000,,Мен сені тірілтемін, бірақ қаным жетпейді.
Dialogue: 0,0:17:08.63,0:17:13.30,Default,,0000,0000,0000,,Сенши Шашылған ингредиенттер
Dialogue: 0,0:17:08.63,0:17:13.30,Default,,0000,0000,0000,,Сіз оны жинап аласыз ба?
Dialogue: 0,0:17:08.63,0:17:13.30,Default,,0000,0000,0000,,Хабардар.
Dialogue: 0,0:17:13.30,0:17:16.80,Default,,0000,0000,0000,,Мен де қарапайым реанимация техникасын алғым келеді.
Dialogue: 0,0:17:16.80,0:17:18.80,Default,,0000,0000,0000,,Бұл үшін кешіріңіз.
Dialogue: 0,0:17:20.81,0:17:24.81,Default,,0000,0000,0000,,зардап шеккен адамдарды емдеуді қамтамасыз етеді және
Dialogue: 0,0:17:20.81,0:17:24.81,Default,,0000,0000,0000,,Жоғалған адамдарды іздеу.
Dialogue: 0,0:17:24.81,0:17:29.48,Default,,0000,0000,0000,,Біртүрлі әдісті қолдансаңыз, оны бірден қысқартуға болады.
Dialogue: 0,0:17:24.81,0:17:29.48,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:17:29.48,0:17:49.50,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:17:49.50,0:17:52.84,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:17:49.50,0:17:52.84,Default,,0000,0000,0000,,Хмм!
Dialogue: 0,0:17:52.84,0:17:54.84,Default,,0000,0000,0000,,Не болды, Шло!
Dialogue: 0,0:17:54.84,0:17:59.51,Default,,0000,0000,0000,,Тағы да, осында
Dialogue: 0,0:17:54.84,0:17:59.51,Default,,0000,0000,0000,,Мен жеген адаммын! күшті!
Dialogue: 0,0:17:59.51,0:18:01.61,Default,,0000,0000,0000,,Құтты болсын….
Dialogue: 0,0:18:14.79,0:18:17.63,Default,,0000,0000,0000,,Дәмді….
Dialogue: 0,0:18:17.63,0:18:20.47,Default,,0000,0000,0000,,Ботчан
Dialogue: 0,0:18:17.63,0:18:20.47,Default,,0000,0000,0000,,Реанимация аяқталды.
Dialogue: 0,0:18:20.47,0:18:23.64,Default,,0000,0000,0000,,Келесіде қашан кетесіз?
Dialogue: 0,0:18:23.64,0:18:28.14,Default,,0000,0000,0000,,No Қайтару техникасына дайындалу.
Dialogue: 0,0:18:23.64,0:18:28.14,Default,,0000,0000,0000,,Жер бетіне қайта оралайық.
Dialogue: 0,0:18:28.14,0:18:30.64,Default,,0000,0000,0000,,Сіз сенімдісіз бе?
Dialogue: 0,0:18:30.64,0:18:35.48,Default,,0000,0000,0000,,Асеби жоқ.
Dialogue: 0,0:18:30.64,0:18:35.48,Default,,0000,0000,0000,,Сізде сәттілік жоқ. Оны тастаңыз.
Dialogue: 0,0:18:35.48,0:18:40.15,Default,,0000,0000,0000,,Біздің күшімізден
Dialogue: 0,0:18:35.48,0:18:40.15,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:18:35.48,0:18:40.15,Default,,0000,0000,0000,,Жоқ.
Dialogue: 0,0:18:40.15,0:18:44.49,Default,,0000,0000,0000,,Сіз қолыңыздан келгеннің бәрін жасадыңыз.
Dialogue: 0,0:18:40.15,0:18:44.49,Default,,0000,0000,0000,,Рахмет.
Dialogue: 0,0:18:44.49,0:18:49.83,Default,,0000,0000,0000,,Сізбен сөйлескенім үшін кешіріңіз.
Dialogue: 0,0:18:44.49,0:18:49.83,Default,,0000,0000,0000,,Уф.
Dialogue: 0,0:18:49.83,0:18:57.00,Default,,0000,0000,0000,,Мен еліме қайтамын.
Dialogue: 0,0:18:49.83,0:18:57.00,Default,,0000,0000,0000,,Мен бұл аралға ешқашан оралмаймын.
Dialogue: 0,0:18:57.00,0:19:02.61,Default,,0000,0000,0000,,Бұл жолы мен арал иесіне ескертемін.
Dialogue: 0,0:18:57.00,0:19:02.61,Default,,0000,0000,0000,,Мен...
Dialogue: 0,0:19:02.61,0:19:05.78,Default,,0000,0000,0000,,Мен Фаринмен бірге үйге барғым келді.
Dialogue: 0,0:19:05.78,0:19:10.28,Default,,0000,0000,0000,,Үйлену туралы ұсынысқа қандай жауап беріледі?
Dialogue: 0,0:19:05.78,0:19:10.28,Default,,0000,0000,0000,,Мен білмеймін.
Dialogue: 0,0:19:10.28,0:19:13.29,Default,,0000,0000,0000,,...
Dialogue: 0,0:19:10.28,0:19:13.29,Default,,0000,0000,0000,,«Ол туралы ойлағаныңды қалаймын» деп айт➡
Dialogue: 0,0:19:13.29,0:19:15.99,Default,,0000,0000,0000,,Мен сенің жауабыңды күттім.
Dialogue: 0,0:19:23.13,0:19:27.63,Default,,0000,0000,0000,,Сондай тартымды әйел
Dialogue: 0,0:19:23.13,0:19:27.63,Default,,0000,0000,0000,,Басқа ешкім жоқ.
Dialogue: 0,0:19:27.63,0:19:32.30,Default,,0000,0000,0000,,Оның дауысы, ойлау тәсілі...
Dialogue: 0,0:19:32.30,0:19:35.01,Default,,0000,0000,0000,,Маған сенің күлкің ұнады.
Dialogue: 0,0:19:37.64,0:19:42.81,Default,,0000,0000,0000,,Негізі мұндай жағдай әлі де бола бермейді.
Dialogue: 0,0:19:37.64,0:19:42.81,Default,,0000,0000,0000,,Мен оған айтқан жоқпын.
Dialogue: 0,0:19:42.81,0:19:46.49,Default,,0000,0000,0000,,Мен сізге ертерек айтуым керек еді.
Dialogue: 0,0:19:46.49,0:19:48.99,Default,,0000,0000,0000,,Не, сен кенет ұсыныс жасадың ба?
Dialogue: 0,0:19:48.99,0:19:52.66,Default,,0000,0000,0000,,Сіз қорықпайсыз ба?
Dialogue: 0,0:19:48.99,0:19:52.66,Default,,0000,0000,0000,,Дүниеден келген адаммын.
Dialogue: 0,0:19:52.66,0:19:55.83,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:19:52.66,0:19:55.83,Default,,0000,0000,0000,,Сондықтан мен мұны Фаринге айтамын.
Dialogue: 0,0:19:55.83,0:19:58.50,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:19:58.50,0:20:03.50,Default,,0000,0000,0000,,Сен солайсың...
Dialogue: 0,0:20:03.50,0:20:05.50,Default,,0000,0000,0000,,Мен қызғанамын.
Dialogue: 0,0:20:07.51,0:20:09.51,Default,,0000,0000,0000,,Кабру.
Dialogue: 0,0:20:09.51,0:20:12.84,Default,,0000,0000,0000,,Сіз маған көп көмектестіңіз.
Dialogue: 0,0:20:09.51,0:20:12.84,Default,,0000,0000,0000,,Ерекше ештеңе жоқ.
Dialogue: 0,0:20:12.84,0:20:15.51,Default,,0000,0000,0000,,Менің шабуылым мағынасыз болды.
Dialogue: 0,0:20:12.84,0:20:15.51,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:20:15.51,0:20:19.02,Default,,0000,0000,0000,,Бұл маған көп нәрсені түсінуге мүмкіндік берді!
Dialogue: 0,0:20:15.51,0:20:19.02,Default,,0000,0000,0000,,Әртүрлі заттар?
Dialogue: 0,0:20:19.02,0:20:22.02,Default,,0000,0000,0000,,Сіз мені пышақтап алған жеріңіз
Dialogue: 0,0:20:19.02,0:20:22.02,Default,,0000,0000,0000,,Бұл жарақаттардың барлығы адам үшін өлімге әкеледі➡
Dialogue: 0,0:20:22.02,0:20:26.19,Default,,0000,0000,0000,,Менің әпкемде олай емес еді.
Dialogue: 0,0:20:22.02,0:20:26.19,Default,,0000,0000,0000,,Басқаша айтқанда, сол бөлікте ➡
Dialogue: 0,0:20:26.19,0:20:29.53,Default,,0000,0000,0000,,Өмірлік маңызды мүшелер бар ма?
Dialogue: 0,0:20:26.19,0:20:29.53,Default,,0000,0000,0000,,Немесе біреуден көп бар.
Dialogue: 0,0:20:29.53,0:20:32.20,Default,,0000,0000,0000,,Базилиск, Цербер және Скилла.
Dialogue: 0,0:20:32.20,0:20:37.20,Default,,0000,0000,0000,,Бірнеше миы бар құбыжықтар аз емес.
Dialogue: 0,0:20:32.20,0:20:37.20,Default,,0000,0000,0000,,Химериялық деп аталатын түрлерде жиі кездеседі.
Dialogue: 0,0:20:37.20,0:20:40.37,Default,,0000,0000,0000,,《Қарашықтары кеңейген.
Dialogue: 0,0:20:40.37,0:20:44.71,Default,,0000,0000,0000,,Сіз құбыжықтарды жақсы көресіз...
Dialogue: 0,0:20:40.37,0:20:44.71,Default,,0000,0000,0000,,Бұл білім қару ма?
Dialogue: 0,0:20:44.71,0:20:47.38,Default,,0000,0000,0000,,Лабиринт шеберін жеңу...
Dialogue: 0,0:20:47.38,0:20:50.72,Default,,0000,0000,0000,,Әрине, одан жақсырақ
Dialogue: 0,0:20:47.38,0:20:50.72,Default,,0000,0000,0000,,Көптеген авантюристер бар➡
Dialogue: 0,0:20:50.72,0:20:54.05,Default,,0000,0000,0000,,Осы уақытқа дейін білім мен мотивация
Dialogue: 0,0:20:50.72,0:20:54.05,Default,,0000,0000,0000,,Басқа ешкімде жоқ.
Dialogue: 0,0:20:54.05,0:20:58.06,Default,,0000,0000,0000,,Ол мұны шынымен де жасай алады.
Dialogue: 0,0:20:58.06,0:20:59.99,Default,,0000,0000,0000,,Бірақ...
Dialogue: 0,0:20:59.99,0:21:02.83,Default,,0000,0000,0000,,Лабиринт шеберін жеңгеннен кейін не болады?
Dialogue: 0,0:21:02.83,0:21:05.16,Default,,0000,0000,0000,,Ашуланған сиқыршыны жеңген➡
Dialogue: 0,0:21:05.16,0:21:08.33,Default,,0000,0000,0000,,«Осы елде бәрі»
Dialogue: 0,0:21:05.16,0:21:08.33,Default,,0000,0000,0000,,Сіз аласыз деп естідім➡
Dialogue: 0,0:21:08.33,0:21:10.34,Default,,0000,0000,0000,,Бұл дегеніміз➡
Dialogue: 0,0:21:10.34,0:21:13.51,Default,,0000,0000,0000,,Келесі лабиринттің шебері бол
Dialogue: 0,0:21:10.34,0:21:13.51,Default,,0000,0000,0000,,Бұл дегеніміз не?
Dialogue: 0,0:21:13.51,0:21:16.01,Default,,0000,0000,0000,,Қара сиқырмен жасалған қала➡
Dialogue: 0,0:21:16.01,0:21:18.51,Default,,0000,0000,0000,,Барлық құбыжықтар
Dialogue: 0,0:21:16.01,0:21:18.51,Default,,0000,0000,0000,,Қолыңызға түскенде➡
Dialogue: 0,0:21:18.51,0:21:20.51,Default,,0000,0000,0000,,Бұл адам не істейді?
Dialogue: 0,0:21:20.51,0:21:24.02,Default,,0000,0000,0000,,Осы лабиринтті шындап зерттеңіз
Dialogue: 0,0:21:20.51,0:21:24.02,Default,,0000,0000,0000,,Ол мөрлене ме? 》
Dialogue: 0,0:21:24.02,0:21:27.19,Default,,0000,0000,0000,,Қарныңыз ашты ма?
Dialogue: 0,0:21:24.02,0:21:27.19,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:21:27.19,0:21:39.60,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:21:46.20,0:21:50.38,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:21:46.20,0:21:50.38,Default,,0000,0000,0000,,Тамагояки гарпи жұмыртқасынан жасалған.
Dialogue: 0,0:21:50.38,0:21:52.38,Default,,0000,0000,0000,,｟Кяхахахаха…｠
Dialogue: 0,0:21:52.38,0:21:55.05,Default,,0000,0000,0000,,Сенши оны ертерек тауыпты.
Dialogue: 0,0:21:55.05,0:21:59.22,Default,,0000,0000,0000,,Сіз құбыжық тағамына қызығатын сияқтысыз.
Dialogue: 0,0:21:55.05,0:21:59.22,Default,,0000,0000,0000,,Маған біреуін беріңізші.
Dialogue: 0,0:21:59.22,0:22:03.16,Default,,0000,0000,0000,,(Айқай)
Dialogue: 0,0:22:03.16,0:22:05.16,Default,,0000,0000,0000,,｟Кабуру: Ана｠
Dialogue: 0,0:22:05.16,0:22:07.66,Default,,0000,0000,0000,,《Мен оны жегім келмейді!
Dialogue: 0,0:22:07.66,0:22:09.83,Default,,0000,0000,0000,,Не істеу керек Қалай аман қалу керек.
Dialogue: 0,0:22:09.83,0:22:13.67,Default,,0000,0000,0000,,Жоқ, оны қазір өлтіруден басқа амалым жоқ...
Dialogue: 0,0:22:09.83,0:22:13.67,Default,,0000,0000,0000,,Бұл… кісі өлтіру….
Dialogue: 0,0:22:13.67,0:22:15.83,Default,,0000,0000,0000,,Қазір мүмкін емес! 》
Dialogue: 0,0:22:13.67,0:22:15.83,Default,,0000,0000,0000,,Itadadakimasu!
Dialogue: 0,0:22:15.83,0:22:17.84,Default,,0000,0000,0000,,《Күтілгендей》
Dialogue: 0,0:22:17.84,0:22:20.34,Default,,0000,0000,0000,,《Холм: Адамдардың қалтасына түсу үшін
Dialogue: 0,0:22:17.84,0:22:20.34,Default,,0000,0000,0000,,Барлығын жасайтын адам》
Dialogue: 0,0:22:20.34,0:22:22.51,Default,,0000,0000,0000,,《Өте жақсы адам》
Dialogue: 0,0:22:22.51,0:22:32.82,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:22:34.85,0:22:38.19,Default,,0000,0000,0000,,Қайтару техникасы Дайындық аяқталды.
Dialogue: 0,0:22:38.19,0:22:40.19,Default,,0000,0000,0000,,Ешкім зардап шеккен жоқ па?
Dialogue: 0,0:22:40.19,0:22:43.53,Default,,0000,0000,0000,,Мұның арғы жағында жер бар
Dialogue: 0,0:22:40.19,0:22:43.53,Default,,0000,0000,0000,,Өлсең, қайта тірілу болмайды.
Dialogue: 0,0:22:43.53,0:22:47.20,Default,,0000,0000,0000,,Шынымды айтсам, мен
Dialogue: 0,0:22:43.53,0:22:47.20,Default,,0000,0000,0000,,Сіз ашуланған сиқыршыға айналасыз➡
Dialogue: 0,0:22:47.20,0:22:49.53,Default,,0000,0000,0000,,Ол жерге жеткенше
Dialogue: 0,0:22:47.20,0:22:49.53,Default,,0000,0000,0000,,Мен өлемін деп ойлаймын➡
Dialogue: 0,0:22:49.53,0:22:52.54,Default,,0000,0000,0000,,Егер аман қалуыңыз мүмкін болса➡
Dialogue: 0,0:22:52.54,0:22:55.87,Default,,0000,0000,0000,,Бірақ қара магияның арқасында
Dialogue: 0,0:22:52.54,0:22:55.87,Default,,0000,0000,0000,,Мен тіпті жерге орала алмаған кезде➡
Dialogue: 0,0:22:55.87,0:22:58.21,Default,,0000,0000,0000,,Мұны қоңырау шалыңыз.
Dialogue: 0,0:22:58.21,0:23:01.31,Default,,0000,0000,0000,,Алыстағы жұп қоңыраумен резонанс.
Dialogue: 0,0:23:01.31,0:23:05.98,Default,,0000,0000,0000,,Тапсырманы орындау
Dialogue: 0,0:23:01.31,0:23:05.98,Default,,0000,0000,0000,,Шығысқа қашуды ұйымдастырайық.
Dialogue: 0,0:23:05.98,0:23:08.99,Default,,0000,0000,0000,,Өлме.
Dialogue: 0,0:23:08.99,0:23:11.99,Default,,0000,0000,0000,,Рахмет.
Dialogue: 0,0:23:11.99,0:23:13.99,Default,,0000,0000,0000,,Лайос.
Dialogue: 0,0:23:13.99,0:23:17.33,Default,,0000,0000,0000,,Әңгімелескенімізге қуаныштымын.
Dialogue: 0,0:23:13.99,0:23:17.33,Default,,0000,0000,0000,,Бұл менің ең үлкен өнімім болды.
Dialogue: 0,0:23:17.33,0:23:20.50,Default,,0000,0000,0000,,Қош келдіңіз.
Dialogue: 0,0:23:17.33,0:23:20.50,Default,,0000,0000,0000,,Ум...
Dialogue: 0,0:23:17.33,0:23:20.50,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:23:20.50,0:23:24.50,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:23:20.50,0:23:24.50,Default,,0000,0000,0000,,Менің атым
Dialogue: 0,0:23:20.50,0:23:24.50,Default,,0000,0000,0000,,Есіңізде қалды, солай ма?
Dialogue: 0,0:23:24.50,0:23:28.17,Default,,0000,0000,0000,,Иә? әрине.
Dialogue: 0,0:23:24.50,0:23:28.17,Default,,0000,0000,0000,,Құдайға шүкір.
Dialogue: 0,0:23:28.17,0:23:31.68,Default,,0000,0000,0000,,Келесі жолы ұмытпаңыз.
Dialogue: 0,0:23:31.68,0:23:34.68,Default,,0000,0000,0000,,Сонда кездескенше.
Dialogue: 0,0:23:34.68,0:23:37.18,Default,,0000,0000,0000,,《“Келесі”? 》
Dialogue: 0,0:23:37.18,0:23:39.18,Default,,0000,0000,0000,,Кеттік, Лайос.
Dialogue: 0,0:23:39.18,0:23:41.52,Default,,0000,0000,0000,,Мен енді қайтып бара алмаймын!
Dialogue: 0,0:23:41.52,0:23:44.02,Default,,0000,0000,0000,,Қап, мына жерге қара.
Dialogue: 0,0:23:44.02,0:23:47.19,Default,,0000,0000,0000,,Соңында осылай болады
Dialogue: 0,0:23:44.02,0:23:47.19,Default,,0000,0000,0000,,Менің бір болжамым бар еді.
Dialogue: 0,0:23:47.19,0:23:50.86,Default,,0000,0000,0000,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,0:23:47.19,0:23:50.86,Default,,0000,0000,0000,,Бұл дөрекі, Чилл.
Dialogue: 0,0:23:50.86,0:23:53.06,Default,,0000,0000,0000,,Кешіріңіз...
Dialogue: 0,0:23:50.86,0:23:53.06,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:23:55.03,0:23:57.54,Default,,0000,0000,0000,,Бұл қалай да болады.
Dialogue: 0,0:23:59.04,0:24:05.04,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory