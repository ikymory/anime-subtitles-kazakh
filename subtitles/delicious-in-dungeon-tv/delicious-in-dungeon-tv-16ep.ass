Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:31.52,0:01:34.86,Default,,0000,0000,0000,,Балалар сендер тасқа айналдыңдар
Dialogue: 0,0:01:31.52,0:01:34.86,Default,,0000,0000,0000,,Мұрыннан қан кету➡
Dialogue: 0,0:01:34.86,0:01:37.70,Default,,0000,0000,0000,,Ингредиенттерді іздеу
Dialogue: 0,0:01:34.86,0:01:37.70,Default,,0000,0000,0000,,Мен күйзелістен арылу кезінде➡
Dialogue: 0,0:01:37.70,0:01:41.03,Default,,0000,0000,0000,,Лабиринттің тербелістеріне
Dialogue: 0,0:01:37.70,0:01:41.03,Default,,0000,0000,0000,,Мен кейбір ережелерді таптым.
Dialogue: 0,0:01:41.03,0:01:43.37,Default,,0000,0000,0000,,Адамдар
Dialogue: 0,0:01:41.03,0:01:43.37,Default,,0000,0000,0000,,Махаббаттан тасқа айналғандай.
Dialogue: 0,0:01:43.37,0:01:45.37,Default,,0000,0000,0000,,Дұрыс!
Dialogue: 0,0:01:45.37,0:01:48.54,Default,,0000,0000,0000,,Бұл үш күн жемісті болды!
Dialogue: 0,0:01:45.37,0:01:48.54,Default,,0000,0000,0000,,Эй, эй.
Dialogue: 0,0:01:48.54,0:01:53.88,Default,,0000,0000,0000,,Бір жері бітеліп, бір жері қосылған.
Dialogue: 0,0:01:48.54,0:01:53.88,Default,,0000,0000,0000,,Негізінен бұл қайталанады.
Dialogue: 0,0:01:53.88,0:01:57.88,Default,,0000,0000,0000,,Есіктердің және жиһаздардың саны
Dialogue: 0,0:01:53.88,0:01:57.88,Default,,0000,0000,0000,,Ғимараттың түрі өзгермейді.
Dialogue: 0,0:01:57.88,0:02:00.32,Default,,0000,0000,0000,,Жеке үйлер зират бола алмайды.
Dialogue: 0,0:02:00.32,0:02:04.32,Default,,0000,0000,0000,,Тұрақты аралықтағы қабырғалар
Dialogue: 0,0:02:00.32,0:02:04.32,Default,,0000,0000,0000,,Оң жақ спираль бойынша қозғалады.
Dialogue: 0,0:02:04.32,0:02:09.33,Default,,0000,0000,0000,,Тас мүсіннің орны, оның бағытымен қоса бекітілген.
Dialogue: 0,0:02:04.32,0:02:09.33,Default,,0000,0000,0000,,Барлық басқа нәрселерді ескере отырып ...
Dialogue: 0,0:02:11.33,0:02:13.33,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:02:13.33,0:02:18.00,Default,,0000,0000,0000,,Бұл жол таныс сияқты!
Dialogue: 0,0:02:13.33,0:02:18.00,Default,,0000,0000,0000,,Сол үй менің айдаһарды жеген жерім.
Dialogue: 0,0:02:18.00,0:02:22.51,Default,,0000,0000,0000,,Чилчак керемет!
Dialogue: 0,0:02:18.00,0:02:22.51,Default,,0000,0000,0000,,Күте тұрыңыз, бұл жұмыс.
Dialogue: 0,0:02:22.51,0:02:25.18,Default,,0000,0000,0000,,Бірақ бұл жол...
Dialogue: 0,0:02:25.18,0:02:27.85,Default,,0000,0000,0000,,《Дұрыс...
Dialogue: 0,0:02:27.85,0:02:30.02,Default,,0000,0000,0000,,Фариннен айырылған жерім➡
Dialogue: 0,0:02:30.02,0:02:32.85,Default,,0000,0000,0000,,Қанның көлі мен ізі сияқты.
Dialogue: 0,0:02:30.02,0:02:32.85,Default,,0000,0000,0000,,Іздер қалды.
Dialogue: 0,0:02:32.85,0:02:36.19,Default,,0000,0000,0000,,Бұны екеуің көрсеңдер, тағы ренжіп қаларсыңдар.
Dialogue: 0,0:02:36.19,0:02:38.19,Default,,0000,0000,0000,,Қалай тыныштандыру керек...》
Dialogue: 0,0:02:38.19,0:02:41.69,Default,,0000,0000,0000,,Лайус көзқарасы.
Dialogue: 0,0:02:38.19,0:02:41.69,Default,,0000,0000,0000,,Уф.
Dialogue: 0,0:02:38.19,0:02:41.69,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,0:02:41.69,0:02:44.53,Default,,0000,0000,0000,,Онда!
Dialogue: 0,0:02:41.69,0:02:44.53,Default,,0000,0000,0000,,Мені мазалайтын нәрселер көп➡
Dialogue: 0,0:02:44.53,0:02:47.70,Default,,0000,0000,0000,,Әзірге жерге оралайық...
Dialogue: 0,0:02:47.70,0:02:49.70,Default,,0000,0000,0000,,​​О?
Dialogue: 0,0:02:54.04,0:02:57.38,Default,,0000,0000,0000,,Бұл осында болды, солай ма?
Dialogue: 0,0:02:54.04,0:02:57.38,Default,,0000,0000,0000,,Айдаһардың қалдықтары қайда болды.
Dialogue: 0,0:02:57.38,0:03:00.31,Default,,0000,0000,0000,,Таза және жинақы.
Dialogue: 0,0:03:00.31,0:03:02.98,Default,,0000,0000,0000,,Бірақ қабырғадағы жарықшақ➡
Dialogue: 0,0:03:02.98,0:03:05.99,Default,,0000,0000,0000,,Қызыл айдаһар құлаған кезде
Dialogue: 0,0:03:02.98,0:03:05.99,Default,,0000,0000,0000,,Бәлкім, не қалды.
Dialogue: 0,0:03:05.99,0:03:08.99,Default,,0000,0000,0000,,Бұл жарықшақ жабылғалы жатыр...
Dialogue: 0,0:03:10.99,0:03:12.99,Default,,0000,0000,0000,,​​О?
Dialogue: 0,0:03:12.99,0:03:15.33,Default,,0000,0000,0000,,Сиқыршының көзі келе жатыр.
Dialogue: 0,0:03:15.33,0:03:17.33,Default,,0000,0000,0000,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:03:15.33,0:03:17.33,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:03:17.33,0:03:19.33,Default,,0000,0000,0000,,Кенеттен айқайламаңыз!
Dialogue: 0,0:03:19.33,0:03:21.67,Default,,0000,0000,0000,,Енді... сонда.
Dialogue: 0,0:03:19.33,0:03:21.67,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:03:21.67,0:03:24.17,Default,,0000,0000,0000,,А... Иә?
Dialogue: 0,0:03:24.17,0:03:27.34,Default,,0000,0000,0000,,Мен қайтадан сиқырлы мас болып кеткендей болдым.
Dialogue: 0,0:03:24.17,0:03:27.34,Default,,0000,0000,0000,,Мен де, әпкем де осы жерде күтеміз.
Dialogue: 0,0:03:27.34,0:03:32.18,Default,,0000,0000,0000,,Қалпына келтіру сиқырын қолданғаннан бері
Dialogue: 0,0:03:27.34,0:03:32.18,Default,,0000,0000,0000,,Кейде менде галлюцинация және есту галлюцинациялары болады...
Dialogue: 0,0:03:32.18,0:03:35.52,Default,,0000,0000,0000,,Есту галлюцинациялары? Бұл шынымен сиқырлы мас па?
Dialogue: 0,0:03:35.52,0:03:39.69,Default,,0000,0000,0000,,Не естідің?
Dialogue: 0,0:03:35.52,0:03:39.69,Default,,0000,0000,0000,,Мм... Сиқыршының көзі келе жатыр.
Dialogue: 0,0:03:39.69,0:03:43.69,Default,,0000,0000,0000,,Сиқыршының көзі... Ха! Міне бітті!
Dialogue: 0,0:03:45.86,0:03:48.19,Default,,0000,0000,0000,,(Хане)
Dialogue: 0,0:03:48.19,0:03:52.20,Default,,0000,0000,0000,,Бұл қанаттардың дыбысы!
Dialogue: 0,0:03:48.19,0:03:52.20,Default,,0000,0000,0000,,Сол кішкентай айдаһар...
Dialogue: 0,0:03:48.19,0:03:52.20,Default,,0000,0000,0000,,Мен жасыруым керек!
Dialogue: 0,0:03:52.20,0:03:55.70,Default,,0000,0000,0000,,Жоқ, бұл мүмкін емес!
Dialogue: 0,0:03:52.20,0:03:55.70,Default,,0000,0000,0000,,Мұнда көріну тым жақсы.
Dialogue: 0,0:03:55.70,0:03:59.71,Default,,0000,0000,0000,,Жүгірейік, Марсиль.
Dialogue: 0,0:03:55.70,0:03:59.71,Default,,0000,0000,0000,,Жоқ. Жасырғыңыз келсе.
Dialogue: 0,0:03:59.71,0:04:01.64,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:04:01.64,0:04:03.98,Default,,0000,0000,0000,,Қабырғаның ішінде!
Dialogue: 0,0:04:01.64,0:04:03.98,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:04:03.98,0:04:05.98,Default,,0000,0000,0000,,Хмм! Ngggg….
Dialogue: 0,0:04:05.98,0:04:07.98,Default,,0000,0000,0000,,Жүріңдер, екеуің, асығыңдар!
Dialogue: 0,0:04:05.98,0:04:07.98,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:04:07.98,0:04:11.82,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,0:04:07.98,0:04:11.82,Default,,0000,0000,0000,,Бұл сиқырдың бір түрі ме?
Dialogue: 0,0:04:11.82,0:04:18.83,Default,,0000,0000,0000,,(Хане)
Dialogue: 0,0:04:18.83,0:04:22.50,Default,,0000,0000,0000,,Пух!
Dialogue: 0,0:04:18.83,0:04:22.50,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:04:18.83,0:04:22.50,Default,,0000,0000,0000,,О...
Dialogue: 0,0:04:22.50,0:04:26.00,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:04:22.50,0:04:26.00,Default,,0000,0000,0000,,Хаа… Хаа… Хаа….
Dialogue: 0,0:04:22.50,0:04:26.00,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:04:26.00,0:04:28.84,Default,,0000,0000,0000,,Марсиль... Мынау не...?
Dialogue: 0,0:04:28.84,0:04:31.54,Default,,0000,0000,0000,,Қандай сиқыр?
Dialogue: 0,0:04:28.84,0:04:31.54,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:04:34.51,0:04:37.01,Default,,0000,0000,0000,,Тазалаушы!
Dialogue: 0,0:04:34.51,0:04:37.01,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:04:37.01,0:04:40.85,Default,,0000,0000,0000,,Зындан тазалау құралы.
Dialogue: 0,0:04:37.01,0:04:40.85,Default,,0000,0000,0000,,Лабиринттегі қоқысты тазалаңыз ➡
Dialogue: 0,0:04:40.85,0:04:45.35,Default,,0000,0000,0000,,Қираған жер
Dialogue: 0,0:04:40.85,0:04:45.35,Default,,0000,0000,0000,,Ремонт жасайтын организмдер? Иә.
Dialogue: 0,0:04:40.85,0:04:45.35,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:04:45.35,0:04:49.52,Default,,0000,0000,0000,,Әлі толық қатып қалған жоқ
Dialogue: 0,0:04:45.35,0:04:49.52,Default,,0000,0000,0000,,Менің ойымша, солай болуы керек.
Dialogue: 0,0:04:49.52,0:04:53.69,Default,,0000,0000,0000,,Әзірге бұл бастапқы қабырға...
Dialogue: 0,0:04:49.52,0:04:53.69,Default,,0000,0000,0000,,Тазартқыш осы жерден басталады!
Dialogue: 0,0:04:53.69,0:04:55.70,Default,,0000,0000,0000,,Тіпті еден! Қараңдар!
Dialogue: 0,0:04:55.70,0:04:58.70,Default,,0000,0000,0000,,Уақыт өте келе нашарлауы және
Dialogue: 0,0:04:55.70,0:04:58.70,Default,,0000,0000,0000,,Ең кішкентай сызаттар да қайталанады!
Dialogue: 0,0:04:58.70,0:05:02.47,Default,,0000,0000,0000,,Қарап-ақ айта алмайсың.
Dialogue: 0,0:04:58.70,0:05:02.47,Default,,0000,0000,0000,,А...?
Dialogue: 0,0:05:02.47,0:05:04.47,Default,,0000,0000,0000,,Ии!
Dialogue: 0,0:05:04.47,0:05:08.81,Default,,0000,0000,0000,,Еденде кішкентай нәрсе
Dialogue: 0,0:05:04.47,0:05:08.81,Default,,0000,0000,0000,,Ол қозғалады! Бұл қорқынышты.
Dialogue: 0,0:05:08.81,0:05:11.14,Default,,0000,0000,0000,,Барлығы тазарақ.
Dialogue: 0,0:05:11.14,0:05:14.65,Default,,0000,0000,0000,,Оларсыз лабиринт
Dialogue: 0,0:05:11.14,0:05:14.65,Default,,0000,0000,0000,,Ол тез құлайды.
Dialogue: 0,0:05:14.65,0:05:16.98,Default,,0000,0000,0000,,Бұл құбыжық емес және зиянсыз.
Dialogue: 0,0:05:16.98,0:05:18.99,Default,,0000,0000,0000,,Зиян бар.
Dialogue: 0,0:05:18.99,0:05:22.99,Default,,0000,0000,0000,,Бүркіт шатыры
Dialogue: 0,0:05:18.99,0:05:22.99,Default,,0000,0000,0000,,Бұл балалар көп шайнайды.
Dialogue: 0,0:05:18.99,0:05:22.99,Default,,0000,0000,0000,,Хаха.
Dialogue: 0,0:05:22.99,0:05:27.83,Default,,0000,0000,0000,,Мазасыздық деп санайтын нәрсе
Dialogue: 0,0:05:22.99,0:05:27.83,Default,,0000,0000,0000,,Барлығы бөлшектеледі.
Dialogue: 0,0:05:27.83,0:05:31.83,Default,,0000,0000,0000,,Айдаһардың өлекселері мен жарылыстың қалдықтары
Dialogue: 0,0:05:27.83,0:05:31.83,Default,,0000,0000,0000,,Менің ойымша, сіз мұнда тамақ ішуге келдіңіз.
Dialogue: 0,0:05:31.83,0:05:37.67,Default,,0000,0000,0000,,Лабиринттің іші зақымдалғанда пайда болады.
Dialogue: 0,0:05:31.83,0:05:37.67,Default,,0000,0000,0000,,Сірінділер оттың таралуына және құлауына жол бермейді.
Dialogue: 0,0:05:37.67,0:05:42.34,Default,,0000,0000,0000,,Ал қоқыс жан-жағына шашылды
Dialogue: 0,0:05:37.67,0:05:42.34,Default,,0000,0000,0000,,Тамақ ішуді бастаңыз. Маған ұнайтын немесе ұнатпайтын нәрсе жоқ.
Dialogue: 0,0:05:42.34,0:05:46.01,Default,,0000,0000,0000,,Соңында, жетіспейтін орын
Dialogue: 0,0:05:42.34,0:05:46.01,Default,,0000,0000,0000,,Сұйықтықты толтырғандай босатыңыз➡
Dialogue: 0,0:05:46.01,0:05:49.18,Default,,0000,0000,0000,,Лабиринтті бастапқы қалпына келтіру.
Dialogue: 0,0:05:49.18,0:05:51.85,Default,,0000,0000,0000,,Бұл тірі ағзаларды емдеумен бірдей процесс.
Dialogue: 0,0:05:51.85,0:05:54.85,Default,,0000,0000,0000,,Құбыжықтар мен микробтарды жою➡
Dialogue: 0,0:05:54.85,0:05:57.86,Default,,0000,0000,0000,,Оны иммундық жүйе деп атауға болады.
Dialogue: 0,0:05:54.85,0:05:57.86,Default,,0000,0000,0000,,Микроб дегеніміз кім?
Dialogue: 0,0:05:57.86,0:06:01.79,Default,,0000,0000,0000,,Бұл да сиқырдың жұмысы ма?
Dialogue: 0,0:05:57.86,0:06:01.79,Default,,0000,0000,0000,,Бұл керемет, солай емес пе?
Dialogue: 0,0:06:01.79,0:06:05.80,Default,,0000,0000,0000,,О, келесі сиқырлы ас қорыту жүйесі.
Dialogue: 0,0:06:05.80,0:06:09.47,Default,,0000,0000,0000,,Бұл жағдайда
Dialogue: 0,0:06:05.80,0:06:09.47,Default,,0000,0000,0000,,Мен лабиринт немен қоректенеді деп ойлаймын.
Dialogue: 0,0:06:09.47,0:06:11.47,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:06:11.47,0:06:14.14,Default,,0000,0000,0000,,《Мен құтқарылдым, себебі қан іздері жоғалып кетті》
Dialogue: 0,0:06:14.14,0:06:17.64,Default,,0000,0000,0000,,Эй
Dialogue: 0,0:06:14.14,0:06:17.64,Default,,0000,0000,0000,,Басқа өзгеріс болмай тұрып, әрі қарай жүрейік.
Dialogue: 0,0:06:17.64,0:06:19.65,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:06:19.65,0:06:29.99,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:06:29.99,0:06:31.99,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:06:31.99,0:06:35.50,Default,,0000,0000,0000,,Уау, баспалдақтар!
Dialogue: 0,0:06:35.50,0:06:39.00,Default,,0000,0000,0000,,Ха... Мен бұл жерден шыға аламын.
Dialogue: 0,0:06:39.00,0:06:42.34,Default,,0000,0000,0000,,Міне, кадр.
Dialogue: 0,0:06:39.00,0:06:42.34,Default,,0000,0000,0000,,Мен мұны істеуім керек пе?
Dialogue: 0,0:06:42.34,0:06:45.17,Default,,0000,0000,0000,,Иә, солай істейік!
Dialogue: 0,0:06:45.17,0:06:48.84,Default,,0000,0000,0000,,Не? А, түсіндім.
Dialogue: 0,0:06:48.84,0:06:56.18,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:06:56.18,0:06:59.02,Default,,0000,0000,0000,,Иә! ? Бұл тамақ дегенді білдіре ме?
Dialogue: 0,0:06:59.02,0:07:03.29,Default,,0000,0000,0000,,Осы баспалдақтардағы шатырлар
Dialogue: 0,0:06:59.02,0:07:03.29,Default,,0000,0000,0000,,Мүмкін емес.
Dialogue: 0,0:06:59.02,0:07:03.29,Default,,0000,0000,0000,,Иә деп айт!
Dialogue: 0,0:07:03.29,0:07:06.46,Default,,0000,0000,0000,,Негізі бұл сізге ұнады деп ойлаймын.
Dialogue: 0,0:07:03.29,0:07:06.46,Default,,0000,0000,0000,,Басқа!
Dialogue: 0,0:07:06.46,0:07:12.63,Default,,0000,0000,0000,,Хмм... ингредиенттер өте көп.
Dialogue: 0,0:07:06.46,0:07:12.63,Default,,0000,0000,0000,,Сіз не жасадыңыз?
Dialogue: 0,0:07:12.63,0:07:15.30,Default,,0000,0000,0000,,Оны пайдаланып көруім керек пе?
Dialogue: 0,0:07:15.30,0:07:19.47,Default,,0000,0000,0000,,Арпаны пісіріңіз.
Dialogue: 0,0:07:15.30,0:07:19.47,Default,,0000,0000,0000,,Бұл сіз үшінші қабатта көтергеніңіз бе?
Dialogue: 0,0:07:19.47,0:07:23.64,Default,,0000,0000,0000,,Тамақ таусылғанда
Dialogue: 0,0:07:19.47,0:07:23.64,Default,,0000,0000,0000,,Мен оны кейінге қалдырдым.
Dialogue: 0,0:07:23.64,0:07:25.65,Default,,0000,0000,0000,,Кокатрица еті.
Dialogue: 0,0:07:25.65,0:07:29.48,Default,,0000,0000,0000,,Құрғақ жеміс Мандрака жемісі мен жапырақтары.
Dialogue: 0,0:07:29.48,0:07:32.65,Default,,0000,0000,0000,,Тастаған шөп жапырақтарын кесіңіз...
Dialogue: 0,0:07:32.65,0:07:35.15,Default,,0000,0000,0000,,Дәмдеуіш және қуыру.
Dialogue: 0,0:07:35.15,0:07:38.66,Default,,0000,0000,0000,,Шұңқыр кірпіштің үстіне арпа күрішін жайыңыз➡
Dialogue: 0,0:07:38.66,0:07:42.66,Default,,0000,0000,0000,,Ингредиенттерді үстіне қойып, кірпішті қыздырыңыз.
Dialogue: 0,0:07:42.66,0:07:45.33,Default,,0000,0000,0000,,Және….
Dialogue: 0,0:07:42.66,0:07:45.33,Default,,0000,0000,0000,,Иә, бұл не?
Dialogue: 0,0:07:45.33,0:07:47.63,Default,,0000,0000,0000,,Бұл кокатрица жұмыртқасы.
Dialogue: 0,0:07:49.67,0:07:54.17,Default,,0000,0000,0000,,Менің әкелгенім жақсы болды, бірақ
Dialogue: 0,0:07:49.67,0:07:54.17,Default,,0000,0000,0000,,Оны пайдалану оңай емес.
Dialogue: 0,0:07:56.51,0:07:59.68,Default,,0000,0000,0000,,Соңында жұмыртқа пастасын қосамыз...
Dialogue: 0,0:07:59.68,0:08:01.88,Default,,0000,0000,0000,,Ол аяқталды!
Dialogue: 0,0:08:03.78,0:08:06.95,Default,,0000,0000,0000,,Уау, бұл дәмді көрінеді.
Dialogue: 0,0:08:06.95,0:08:11.06,Default,,0000,0000,0000,,《Егер мен тас болып қала берсем
Dialogue: 0,0:08:06.95,0:08:11.06,Default,,0000,0000,0000,,Бұл тағамда қолданылған ба? 》
Dialogue: 0,0:08:13.13,0:08:16.13,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:08:16.13,0:08:18.30,Default,,0000,0000,0000,,Хмм, күйдірілген күріш дәмді!
Dialogue: 0,0:08:18.30,0:08:21.50,Default,,0000,0000,0000,,Қасықты тәрелкеге ​​салып көріңіз.
Dialogue: 0,0:08:24.64,0:08:28.31,Default,,0000,0000,0000,,Dungeon Cleaner көмегімен жасалған
Dialogue: 0,0:08:24.64,0:08:28.31,Default,,0000,0000,0000,,Мен кірпішті қолданып көрдім.
Dialogue: 0,0:08:28.31,0:08:31.98,Default,,0000,0000,0000,,Сіз тәрелкені толық жеуге болады дейсіз бе!
Dialogue: 0,0:08:28.31,0:08:31.98,Default,,0000,0000,0000,,О...
Dialogue: 0,0:08:31.98,0:08:34.28,Default,,0000,0000,0000,,Рахмет Сенши!
Dialogue: 0,0:08:37.98,0:08:39.99,Default,,0000,0000,0000,,Оның дәмі қандай?
Dialogue: 0,0:08:39.99,0:08:42.15,Default,,0000,0000,0000,,Менің алғашқы әсерім, бұл балшық ➡
Dialogue: 0,0:08:42.15,0:08:47.16,Default,,0000,0000,0000,,Дәмін жақсы көрсең, құрт, темір, лимон табасың.
Dialogue: 0,0:08:42.15,0:08:47.16,Default,,0000,0000,0000,,Бұл сиқырлы қоспа сияқты...
Dialogue: 0,0:08:47.16,0:08:50.33,Default,,0000,0000,0000,,Сіз оны басқа нәрселермен салыстыра бересіз.
Dialogue: 0,0:08:50.33,0:08:52.67,Default,,0000,0000,0000,,Оны білдірудің жолы жоқ.
Dialogue: 0,0:08:52.67,0:08:58.34,Default,,0000,0000,0000,,Сиқырлы тіршілік иелерін жеуге бола ма?
Dialogue: 0,0:08:52.67,0:08:58.34,Default,,0000,0000,0000,,Менде қайтадан есту галлюцинациялары және мұрыннан қан кетулер бар.
Dialogue: 0,0:08:58.34,0:09:01.77,Default,,0000,0000,0000,,Бұл галлюцинация дегеніміз не?
Dialogue: 0,0:08:58.34,0:09:01.77,Default,,0000,0000,0000,,Мм.
Dialogue: 0,0:09:01.77,0:09:05.61,Default,,0000,0000,0000,,Қалаға қайтып келгенде
Dialogue: 0,0:09:01.77,0:09:05.61,Default,,0000,0000,0000,,Дереу дәрігерге барыңыз.
Dialogue: 0,0:09:05.61,0:09:09.45,Default,,0000,0000,0000,,Дәрігер! ? Бұл ауру ма?
Dialogue: 0,0:09:09.45,0:09:11.45,Default,,0000,0000,0000,,Иә? иә?
Dialogue: 0,0:09:11.45,0:09:14.45,Default,,0000,0000,0000,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:09:14.45,0:09:17.12,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:09:14.45,0:09:17.12,Default,,0000,0000,0000,,Е, бұл да галлюцинация ма?
Dialogue: 0,0:09:17.12,0:09:19.13,Default,,0000,0000,0000,,Оны барлығы көре ала ма? бұл!
Dialogue: 0,0:09:19.13,0:09:21.63,Default,,0000,0000,0000,,Мен... Мен оны көріп тұрмын.
Dialogue: 0,0:09:21.63,0:09:24.63,Default,,0000,0000,0000,,Бір… біз….
Dialogue: 0,0:09:24.63,0:09:27.30,Default,,0000,0000,0000,,Бізге шабуыл жасалды!
Dialogue: 0,0:09:24.63,0:09:27.30,Default,,0000,0000,0000,,Уау...
Dialogue: 0,0:09:27.30,0:09:29.30,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:09:29.30,0:09:33.81,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:09:29.30,0:09:33.81,Default,,0000,0000,0000,,А? Бұл не?
Dialogue: 0,0:09:33.81,0:09:36.31,Default,,0000,0000,0000,,Бақа терісі?
Dialogue: 0,0:09:36.31,0:09:39.98,Default,,0000,0000,0000,,Бұл бұрыш та
Dialogue: 0,0:09:36.31,0:09:39.98,Default,,0000,0000,0000,,Бұл жай ғана дулыға әшекейі сияқты.
Dialogue: 0,0:09:39.98,0:09:42.48,Default,,0000,0000,0000,,Балалар….
Dialogue: 0,0:09:39.98,0:09:42.48,Default,,0000,0000,0000,,Coo!
Dialogue: 0,0:09:42.48,0:09:46.99,Default,,0000,0000,0000,,Ғұн Адамға айнала алатын жындар бар.
Dialogue: 0,0:09:46.99,0:09:49.66,Default,,0000,0000,0000,,Өзіңіздің шынайы болмысыңызды көрсету керек пе➡
Dialogue: 0,0:09:49.66,0:09:53.16,Default,,0000,0000,0000,,Сынақ ретінде бір адамды өлтіру...
Dialogue: 0,0:09:49.66,0:09:53.16,Default,,0000,0000,0000,,⚟Тоқта, Майзуру.
Dialogue: 0,0:09:53.16,0:09:55.16,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:09:57.16,0:09:59.67,Default,,0000,0000,0000,,Біз таныспыз.
Dialogue: 0,0:09:57.16,0:09:59.67,Default,,0000,0000,0000,,Шло!
Dialogue: 0,0:09:59.67,0:10:02.67,Default,,0000,0000,0000,,Уау, Шро, біраз уақыт болды!
Dialogue: 0,0:10:02.67,0:10:07.01,Default,,0000,0000,0000,,Біздің мұндай жерде кездесетінімізге сене алар емеспін
Dialogue: 0,0:10:02.67,0:10:07.01,Default,,0000,0000,0000,,Мен өте қуаныштымын~ Ахаха.
Dialogue: 0,0:10:07.01,0:10:09.18,Default,,0000,0000,0000,,Сіз салмақ жоғалттыңыз ба?
Dialogue: 0,0:10:07.01,0:10:09.18,Default,,0000,0000,0000,,Цк.
Dialogue: 0,0:10:09.18,0:10:11.18,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:10:13.85,0:10:15.85,Default,,0000,0000,0000,,О...
Dialogue: 0,0:10:15.85,0:10:18.52,Default,,0000,0000,0000,,Шлоуға рахмет.
Dialogue: 0,0:10:15.85,0:10:18.52,Default,,0000,0000,0000,,Иә….
Dialogue: 0,0:10:18.52,0:10:22.86,Default,,0000,0000,0000,,Сіздің жақсы болғаныңызға қуаныштымын.
Dialogue: 0,0:10:18.52,0:10:22.86,Default,,0000,0000,0000,,Ммм, өте таныс!
Dialogue: 0,0:10:22.86,0:10:26.03,Default,,0000,0000,0000,,А, мен сені таныстырамын. Бұл Сенши.
Dialogue: 0,0:10:26.03,0:10:29.86,Default,,0000,0000,0000,,Сенши Ол бұрын партияда болған Шро.
Dialogue: 0,0:10:29.86,0:10:31.86,Default,,0000,0000,0000,,Шро деген не?
Dialogue: 0,0:10:31.86,0:10:36.57,Default,,0000,0000,0000,,Бұл Тосиро-чан туралы болуы керек.
Dialogue: 0,0:10:31.86,0:10:36.57,Default,,0000,0000,0000,,Toshlow….
Dialogue: 0,0:10:38.87,0:10:41.21,Default,,0000,0000,0000,,Тұрып сөйлессең де неге отыру керек?
Dialogue: 0,0:10:41.21,0:10:45.71,Default,,0000,0000,0000,,Мен жаңа ғана тамақтанып отырмын.
Dialogue: 0,0:10:41.21,0:10:45.71,Default,,0000,0000,0000,,Менің достарым да...
Dialogue: 0,0:10:45.71,0:10:50.05,Default,,0000,0000,0000,,Ия... бірдеңе
Dialogue: 0,0:10:45.71,0:10:50.05,Default,,0000,0000,0000,,Бұл өте үлкен үй шаруашылығы.
Dialogue: 0,0:10:50.05,0:10:53.65,Default,,0000,0000,0000,,Эй Каблу, бұл...
Dialogue: 0,0:10:55.72,0:10:58.06,Default,,0000,0000,0000,,Танысқаныма қуаныштымын.
Dialogue: 0,0:10:55.72,0:10:58.06,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:10:58.06,0:11:00.06,Default,,0000,0000,0000,,Лайос мырза, солай ма?
Dialogue: 0,0:11:01.99,0:11:04.10,Default,,0000,0000,0000,,Танысқаныма қуаныштымын.
Dialogue: 0,0:11:07.17,0:11:10.67,Default,,0000,0000,0000,,Қанша уақыт өтті деп ойлаймын.
Dialogue: 0,0:11:10.67,0:11:12.84,Default,,0000,0000,0000,,Сәлем Кабру.
Dialogue: 0,0:11:10.67,0:11:12.84,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:11:12.84,0:11:16.01,Default,,0000,0000,0000,,Бұл олар, солай ма?
Dialogue: 0,0:11:12.84,0:11:16.01,Default,,0000,0000,0000,,Сен бізден бірдеңе ұрлап алдың.
Dialogue: 0,0:11:16.01,0:11:19.01,Default,,0000,0000,0000,,Біз не істеуіміз керек?
Dialogue: 0,0:11:16.01,0:11:19.01,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:11:19.01,0:11:21.18,Default,,0000,0000,0000,,Мен бұған көмектесе алмаймын.
Dialogue: 0,0:11:19.01,0:11:21.18,Default,,0000,0000,0000,,Ха! ?
Dialogue: 0,0:11:21.18,0:11:23.58,Default,,0000,0000,0000,,Онда сен бұл жерге не үшін келдің?
Dialogue: 0,0:11:25.52,0:11:27.52,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:11:27.52,0:11:31.36,Default,,0000,0000,0000,,Мен сенімен танысқым келді.
Dialogue: 0,0:11:27.52,0:11:31.36,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:31.36,0:11:35.03,Default,,0000,0000,0000,,Мүмкін зергерлік бұйымдар туралы
Dialogue: 0,0:11:31.36,0:11:35.03,Default,,0000,0000,0000,,Сұраудың қажеті жоқ.
Dialogue: 0,0:11:35.03,0:11:38.53,Default,,0000,0000,0000,,Бізге қарасаң да
Dialogue: 0,0:11:35.03,0:11:38.53,Default,,0000,0000,0000,,Мен өзімді кінәлі сезінбедім.
Dialogue: 0,0:11:38.53,0:11:41.70,Default,,0000,0000,0000,,Есіңде жоқ па?
Dialogue: 0,0:11:38.53,0:11:41.70,Default,,0000,0000,0000,,Бұл түсінбеушілік пе?➡
Dialogue: 0,0:11:41.70,0:11:45.87,Default,,0000,0000,0000,,Ең алдымен қазынаның өзі тұзақ болды ма?
Dialogue: 0,0:11:41.70,0:11:45.87,Default,,0000,0000,0000,,Мұның бәрі болуы мүмкін.
Dialogue: 0,0:11:45.87,0:11:51.04,Default,,0000,0000,0000,,Демек бұл уақытты босқа кетірді ме?
Dialogue: 0,0:11:45.87,0:11:51.04,Default,,0000,0000,0000,,Маған тағы біраз уақыт беріңіз.
Dialogue: 0,0:11:51.04,0:11:54.05,Default,,0000,0000,0000,,Олар осында келді
Dialogue: 0,0:11:51.04,0:11:54.05,Default,,0000,0000,0000,,Біз оған қалай жеттік➡
Dialogue: 0,0:11:54.05,0:11:58.38,Default,,0000,0000,0000,,Бұдан әрі не істеуді жоспарлап отырсыз?
Dialogue: 0,0:11:54.05,0:11:58.38,Default,,0000,0000,0000,,Білгіңіз келеді, солай ма?
Dialogue: 0,0:11:58.38,0:12:03.49,Default,,0000,0000,0000,,Шроның жүргеніне біраз уақыт болды.
Dialogue: 0,0:11:58.38,0:12:03.49,Default,,0000,0000,0000,,Сіз осы қабатта болдыңыз ба?
Dialogue: 0,0:11:58.38,0:12:03.49,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:12:03.49,0:12:07.66,Default,,0000,0000,0000,,Бір жерде жүру
Dialogue: 0,0:12:03.49,0:12:07.66,Default,,0000,0000,0000,,Сіз өзіңізді өттім деп ойлаған кезде, сіз кіре берістесіз.
Dialogue: 0,0:12:07.66,0:12:10.50,Default,,0000,0000,0000,,Біз де қатты абдырап қалдық.
Dialogue: 0,0:12:10.50,0:12:13.67,Default,,0000,0000,0000,,Бірақ Чилчак
Dialogue: 0,0:12:10.50,0:12:13.67,Default,,0000,0000,0000,,Өзгеріс заңын ашқаны үшін➡
Dialogue: 0,0:12:13.67,0:12:17.00,Default,,0000,0000,0000,,Ақыры осы уақытқа дейін жеттік.
Dialogue: 0,0:12:13.67,0:12:17.00,Default,,0000,0000,0000,,Мен...
Dialogue: 0,0:12:17.00,0:12:20.01,Default,,0000,0000,0000,,Сонда да, Шро...
Dialogue: 0,0:12:20.01,0:12:22.51,Default,,0000,0000,0000,,Уау….
Dialogue: 0,0:12:22.51,0:12:25.85,Default,,0000,0000,0000,,Бұл азғын нәрсе! Сіз айтқан қулық осы ма?
Dialogue: 0,0:12:25.85,0:12:30.52,Default,,0000,0000,0000,,Жақсы күй!
Dialogue: 0,0:12:25.85,0:12:30.52,Default,,0000,0000,0000,,Хмм... жай ғана туыс.
Dialogue: 0,0:12:30.52,0:12:33.35,Default,,0000,0000,0000,,Менің қолым ғана тұра алады.
Dialogue: 0,0:12:33.35,0:12:37.02,Default,,0000,0000,0000,,Мен партиядан шыққаныма ренжідім. Бірақ➡
Dialogue: 0,0:12:37.02,0:12:39.86,Default,,0000,0000,0000,,Жерде Фарин жоқ
Dialogue: 0,0:12:37.02,0:12:39.86,Default,,0000,0000,0000,,Сіз байқаған кезде➡
Dialogue: 0,0:12:39.86,0:12:46.37,Default,,0000,0000,0000,,Лабиринтке қайтадан сүңгіп, оны іздеу
Dialogue: 0,0:12:39.86,0:12:46.37,Default,,0000,0000,0000,,Мен мұны сенімдірек деп санадым.
Dialogue: 0,0:12:46.37,0:12:50.20,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:12:46.37,0:12:50.20,Default,,0000,0000,0000,,Жарайды. Менің таңдауым жоқ.
Dialogue: 0,0:12:50.20,0:12:54.04,Default,,0000,0000,0000,,Бірақ мен одан кейін мұндайды күткен жоқпын
Dialogue: 0,0:12:50.20,0:12:54.04,Default,,0000,0000,0000,,Бірден лабиринтке сүңгу➡
Dialogue: 0,0:12:54.04,0:12:56.04,Default,,0000,0000,0000,,Бұл сәл абайсыздық емес пе?
Dialogue: 0,0:12:56.04,0:13:00.48,Default,,0000,0000,0000,,Егер біреу қайтадан жарақат алса
Dialogue: 0,0:12:56.04,0:13:00.48,Default,,0000,0000,0000,,Сіз не істеуді жоспарладыңыз?
Dialogue: 0,0:13:00.48,0:13:02.98,Default,,0000,0000,0000,,Тек сіздің сөздеріңіз.
Dialogue: 0,0:13:02.98,0:13:07.32,Default,,0000,0000,0000,,Осы төрт адаммен бірге Қызыл Айдаһар да
Dialogue: 0,0:13:02.98,0:13:07.32,Default,,0000,0000,0000,,Себебі мен оны жеңдім.
Dialogue: 0,0:13:07.32,0:13:09.99,Default,,0000,0000,0000,,Бұл тек менің қиялым ғана болды.
Dialogue: 0,0:13:07.32,0:13:09.99,Default,,0000,0000,0000,,Қызыл Айдаһар...
Dialogue: 0,0:13:09.99,0:13:12.66,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:13:09.99,0:13:12.66,Default,,0000,0000,0000,,Уф! ?
Dialogue: 0,0:13:09.99,0:13:12.66,Default,,0000,0000,0000,,Ол солай!
Dialogue: 0,0:13:12.66,0:13:15.66,Default,,0000,0000,0000,,Ах... а...
Dialogue: 0,0:13:15.66,0:13:18.33,Default,,0000,0000,0000,,Шлоу!
Dialogue: 0,0:13:15.66,0:13:18.33,Default,,0000,0000,0000,,А... Бала!
Dialogue: 0,0:13:18.33,0:13:22.17,Default,,0000,0000,0000,,Бұл кейінгі өмір, сондықтан жақсы.
Dialogue: 0,0:13:18.33,0:13:22.17,Default,,0000,0000,0000,,Тамақ іш, ұйықта!
Dialogue: 0,0:13:22.17,0:13:24.50,Default,,0000,0000,0000,,Сіздің денеңіз бұрынғыдай өмір сүрмейді.
Dialogue: 0,0:13:24.50,0:13:26.51,Default,,0000,0000,0000,,Сіз осылай әрекет етесіз бе?
Dialogue: 0,0:13:26.51,0:13:29.84,Default,,0000,0000,0000,,Сен де қарашы мына сұмдық түрін.
Dialogue: 0,0:13:26.51,0:13:29.84,Default,,0000,0000,0000,,Қараңыз.
Dialogue: 0,0:13:29.84,0:13:33.01,Default,,0000,0000,0000,,Тамақтанып, ұйықтау керек.
Dialogue: 0,0:13:33.01,0:13:36.68,Default,,0000,0000,0000,,Менің мұны істеуге уақытым жоқ...
Dialogue: 0,0:13:36.68,0:13:40.52,Default,,0000,0000,0000,,Шро тағамдары
Dialogue: 0,0:13:36.68,0:13:40.52,Default,,0000,0000,0000,,Бұл сіздің бос уақытыңызда істейтін іс емес.
Dialogue: 0,0:13:40.52,0:13:45.02,Default,,0000,0000,0000,,Ұйықтап, тамақ ішкеннен кейін
Dialogue: 0,0:13:40.52,0:13:45.02,Default,,0000,0000,0000,,Тірі заттар ақырында➡
Dialogue: 0,0:13:45.02,0:13:47.53,Default,,0000,0000,0000,,Мен не істегім келеді
Dialogue: 0,0:13:45.02,0:13:47.53,Default,,0000,0000,0000,,Сіз мұны істей аласыз.
Dialogue: 0,0:13:47.53,0:13:52.83,Default,,0000,0000,0000,,Бірдеңе жейміз.
Dialogue: 0,0:13:47.53,0:13:52.83,Default,,0000,0000,0000,,Осы уақытқа дейін не болғанын айтып берейін.
Dialogue: 0,0:13:54.87,0:13:58.54,Default,,0000,0000,0000,,Бізді жай ғана адастырды!
Dialogue: 0,0:13:54.87,0:13:58.54,Default,,0000,0000,0000,,Бірдеңе дайындай аласыз ба?➡
Dialogue: 0,0:13:58.54,0:14:01.97,Default,,0000,0000,0000,,Май кран.
Dialogue: 0,0:13:58.54,0:14:01.97,Default,,0000,0000,0000,,Конверт пе?
Dialogue: 0,0:14:01.97,0:14:05.48,Default,,0000,0000,0000,,Жеңдер! Тамағыңызды дайындаңыз!
Dialogue: 0,0:14:05.48,0:14:08.98,Default,,0000,0000,0000,,Таде, сен су алып кел!
Dialogue: 0,0:14:05.48,0:14:08.98,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:14:08.98,0:14:10.98,Default,,0000,0000,0000,,Хиен қызыл пловер.
Dialogue: 0,0:14:08.98,0:14:10.98,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:14:10.98,0:14:13.15,Default,,0000,0000,0000,,Күріш пісіруге дайындал.
Dialogue: 0,0:14:13.15,0:14:16.82,Default,,0000,0000,0000,,Әсеби Сен...
Dialogue: 0,0:14:13.15,0:14:16.82,Default,,0000,0000,0000,,Ммм.
Dialogue: 0,0:14:16.82,0:14:18.82,Default,,0000,0000,0000,,Баланы қорғаңыз.
Dialogue: 0,0:14:18.82,0:14:21.66,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:14:18.82,0:14:21.66,Default,,0000,0000,0000,,Тағамыңызға біртүрлі нәрсе араласып кетсе, бұл мәселе.
Dialogue: 0,0:14:21.66,0:14:26.17,Default,,0000,0000,0000,,Онда мен от жағамын.
Dialogue: 0,0:14:21.66,0:14:26.17,Default,,0000,0000,0000,,О, сен сондай қамқорсың.
Dialogue: 0,0:14:26.17,0:14:28.33,Default,,0000,0000,0000,,Мен мұны саған қалдырамын, ергежейлі.
Dialogue: 0,0:14:28.33,0:14:33.34,Default,,0000,0000,0000,,Эххехе күріш күріш.
Dialogue: 0,0:14:28.33,0:14:33.34,Default,,0000,0000,0000,,Хмм... мұнда адам көп.
Dialogue: 0,0:14:33.34,0:14:36.68,Default,,0000,0000,0000,,Бір жерге көп адам жиналғанда
Dialogue: 0,0:14:33.34,0:14:36.68,Default,,0000,0000,0000,,Өте жақсы емес.
Dialogue: 0,0:14:36.68,0:14:41.68,Default,,0000,0000,0000,,Шамамен 3 топқа бөлінейік.
Dialogue: 0,0:14:36.68,0:14:41.68,Default,,0000,0000,0000,,Хмф... Олай болса.
Dialogue: 0,0:14:41.68,0:14:44.18,Default,,0000,0000,0000,,Орын!
Dialogue: 0,0:14:41.68,0:14:44.18,Default,,0000,0000,0000,,Ой! ?
Dialogue: 0,0:14:41.68,0:14:44.18,Default,,0000,0000,0000,,Гном!
Dialogue: 0,0:14:44.18,0:14:46.35,Default,,0000,0000,0000,,Бақа әйел.
Dialogue: 0,0:14:44.18,0:14:46.35,Default,,0000,0000,0000,,Ка! ?
Dialogue: 0,0:14:46.35,0:14:50.19,Default,,0000,0000,0000,,Сиқырды қолдана алатындар
Dialogue: 0,0:14:46.35,0:14:50.19,Default,,0000,0000,0000,,Осы жерде бөгет орнатыңыз.
Dialogue: 0,0:14:50.19,0:14:54.36,Default,,0000,0000,0000,,Ботчанның тамақтануы кезінде
Dialogue: 0,0:14:50.19,0:14:54.36,Default,,0000,0000,0000,,Құбыжықтардың сізге жақындауына жол бермеңіз.
Dialogue: 0,0:14:54.36,0:14:59.20,Default,,0000,0000,0000,,Танысқаныма қуаныштымын, жас ханым.
Dialogue: 0,0:14:54.36,0:14:59.20,Default,,0000,0000,0000,,Иә... иә.
Dialogue: 0,0:14:59.20,0:15:05.47,Default,,0000,0000,0000,,Жарайды, Шро, біраз уақытқа кетейік.
Dialogue: 0,0:14:59.20,0:15:05.47,Default,,0000,0000,0000,,Жағдайларды қысқаша түсіндірейін.
Dialogue: 0,0:15:05.47,0:15:08.64,Default,,0000,0000,0000,,Қолдау.
Dialogue: 0,0:15:05.47,0:15:08.64,Default,,0000,0000,0000,,Рахмет.
Dialogue: 0,0:15:08.64,0:15:11.14,Default,,0000,0000,0000,,《А... Бұл жағдайда➡
Dialogue: 0,0:15:11.14,0:15:14.15,Default,,0000,0000,0000,,Мені жалғыз қалдырсаң
Dialogue: 0,0:15:11.14,0:15:14.15,Default,,0000,0000,0000,,Қауіпті дегеніміз...》
Dialogue: 0,0:15:14.15,0:15:17.48,Default,,0000,0000,0000,,｟Монстр Ума~и Психо~
Dialogue: 0,0:15:17.48,0:15:20.82,Default,,0000,0000,0000,,｟Мамоно! Риори! Квест!
Dialogue: 0,0:15:20.82,0:15:23.66,Default,,0000,0000,0000,,Жинақ!
Dialogue: 0,0:15:20.82,0:15:23.66,Default,,0000,0000,0000,,Өлтіру｠
Dialogue: 0,0:15:23.66,0:15:26.33,Default,,0000,0000,0000,,Сенші! Мен де сонда барамын!
Dialogue: 0,0:15:26.33,0:15:39.00,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:15:39.00,0:15:43.51,Default,,0000,0000,0000,,Сәлем
Dialogue: 0,0:15:39.00,0:15:43.51,Default,,0000,0000,0000,,Сіз қатты толқып тұрсыз ба? Түтін.
Dialogue: 0,0:15:43.51,0:15:45.51,Default,,0000,0000,0000,,А... Тамақтанып болған соң ➡
Dialogue: 0,0:15:45.51,0:15:48.51,Default,,0000,0000,0000,,Маған шомылу керек.
Dialogue: 0,0:15:45.51,0:15:48.51,Default,,0000,0000,0000,,《Міне? 》
Dialogue: 0,0:15:48.51,0:15:51.02,Default,,0000,0000,0000,,Жүр, Шлоу, осында отыр.
Dialogue: 0,0:15:51.02,0:15:54.35,Default,,0000,0000,0000,,Оны маған бір сәтке бересіз бе?
Dialogue: 0,0:15:51.02,0:15:54.35,Default,,0000,0000,0000,,Маған не болғанын айтыңыз.
Dialogue: 0,0:15:54.35,0:15:56.36,Default,,0000,0000,0000,,Шуро мен Намаримен ажырасқаннан кейін➡
Dialogue: 0,0:15:56.36,0:15:59.02,Default,,0000,0000,0000,,Біз...
Dialogue: 0,0:15:56.36,0:15:59.02,Default,,0000,0000,0000,,Тек негізгі ойларды сұраңыз.
Dialogue: 0,0:15:59.02,0:16:03.46,Default,,0000,0000,0000,,Қызыл Айдаһарды жеңіп, Фаринді жинаңыз.
Dialogue: 0,0:15:59.02,0:16:03.46,Default,,0000,0000,0000,,Мен қайта тірілдім➡
Dialogue: 0,0:16:03.46,0:16:07.97,Default,,0000,0000,0000,,Үйге қайтып бара жатқанымда маған ашулы сиқыршы шабуыл жасады.
Dialogue: 0,0:16:03.46,0:16:07.97,Default,,0000,0000,0000,,Біз ажырастық.
Dialogue: 0,0:16:07.97,0:16:10.97,Default,,0000,0000,0000,,Артық емес
Dialogue: 0,0:16:07.97,0:16:10.97,Default,,0000,0000,0000,,Өйткені бұл біздің қолымыздан келмейді➡
Dialogue: 0,0:16:10.97,0:16:14.47,Default,,0000,0000,0000,,Көмек сұрау
Dialogue: 0,0:16:10.97,0:16:14.47,Default,,0000,0000,0000,,Мен жер бетіне қайта оралуды шештім➡
Dialogue: 0,0:16:14.47,0:16:16.98,Default,,0000,0000,0000,,Мен адасып қалдым...
Dialogue: 0,0:16:16.98,0:16:20.15,Default,,0000,0000,0000,,Бірақ! мұнда
Dialogue: 0,0:16:16.98,0:16:20.15,Default,,0000,0000,0000,,Танысқаныма қуаныштымын Шро!
Dialogue: 0,0:16:20.15,0:16:22.15,Default,,0000,0000,0000,,Сен маған күшіңді бере аласың ба?
Dialogue: 0,0:16:22.15,0:16:25.32,Default,,0000,0000,0000,,А... а...?
Dialogue: 0,0:16:25.32,0:16:27.65,Default,,0000,0000,0000,,Мен сізге бұл сұрақты қоя аламын ба?
Dialogue: 0,0:16:27.65,0:16:29.66,Default,,0000,0000,0000,,Ашуланған сиқыршы деген не➡
Dialogue: 0,0:16:29.66,0:16:32.49,Default,,0000,0000,0000,,Бұл лабиринт жасалған деп айтылады
Dialogue: 0,0:16:29.66,0:16:32.49,Default,,0000,0000,0000,,Болмыс, солай ма?
Dialogue: 0,0:16:32.49,0:16:35.33,Default,,0000,0000,0000,,Сыбыс және бар болу
Dialogue: 0,0:16:32.49,0:16:35.33,Default,,0000,0000,0000,,Не сыбырлады➡
Dialogue: 0,0:16:35.33,0:16:38.00,Default,,0000,0000,0000,,Оны ешкім көріп, қайтып оралған жоқ.
Dialogue: 0,0:16:38.00,0:16:41.17,Default,,0000,0000,0000,,Неге ессіз сиқыршы?
Dialogue: 0,0:16:38.00,0:16:41.17,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:16:41.17,0:16:44.50,Default,,0000,0000,0000,,Бірдеңе...
Dialogue: 0,0:16:41.17,0:16:44.50,Default,,0000,0000,0000,,Өйткені оның сөзі де, әрекеті де солай көрінетін.
Dialogue: 0,0:16:44.50,0:16:47.84,Default,,0000,0000,0000,,Сол жерден қалай
Dialogue: 0,0:16:44.50,0:16:47.84,Default,,0000,0000,0000,,Оқиға орнынан қашып кеттіңіз бе?
Dialogue: 0,0:16:47.84,0:16:50.01,Default,,0000,0000,0000,,Бұл Марсиль... Ах.
Dialogue: 0,0:16:50.01,0:16:52.85,Default,,0000,0000,0000,,Бір сиқыршы
Dialogue: 0,0:16:50.01,0:16:52.85,Default,,0000,0000,0000,,Сіз қолыңыздан келгеннің бәрін жасадыңыз.
Dialogue: 0,0:16:52.85,0:16:56.52,Default,,0000,0000,0000,,Нақты не?
Dialogue: 0,0:16:52.85,0:16:56.52,Default,,0000,0000,0000,,Жақсы….
Dialogue: 0,0:16:56.52,0:17:01.82,Default,,0000,0000,0000,,Сиқырлық менің мамандығым емес...
Бұл
Dialogue: 0,0:16:56.52,0:17:01.82,Default,,0000,0000,0000,,ма?
Dialogue: 0,0:17:03.79,0:17:05.99,Default,,0000,0000,0000,,Менен де біреуін қалайсың ба?
Dialogue: 0,0:17:03.79,0:17:05.99,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:17:12.63,0:17:15.47,Default,,0000,0000,0000,,Неге кірпішті шайнадың?
Dialogue: 0,0:17:15.47,0:17:19.30,Default,,0000,0000,0000,,Не? А, жоқ, жоқ.
Dialogue: 0,0:17:15.47,0:17:19.30,Default,,0000,0000,0000,,Кірпіш емес➡
Dialogue: 0,0:17:19.30,0:17:22.31,Default,,0000,0000,0000,,Зынданда тазалағыштан жасалған қабырға
Dialogue: 0,0:17:19.30,0:17:22.31,Default,,0000,0000,0000,,Мен оны тістеп алдым.
Dialogue: 0,0:17:22.31,0:17:26.31,Default,,0000,0000,0000,,Бізде тамақ пен ақша бар.
Dialogue: 0,0:17:22.31,0:17:26.31,Default,,0000,0000,0000,,Сіз бәрін артта қалдырдыңыз.
Dialogue: 0,0:17:26.31,0:17:28.65,Default,,0000,0000,0000,,Сондықтан лабиринтке сүңгуге асықтым➡
Dialogue: 0,0:17:28.65,0:17:30.82,Default,,0000,0000,0000,,Құбыжықтарды жеп жатқанда
Dialogue: 0,0:17:28.65,0:17:30.82,Default,,0000,0000,0000,,Біз осы уақытқа дейін жеттік.
Dialogue: 0,0:17:30.82,0:17:34.82,Default,,0000,0000,0000,,Ах ха ха.
Dialogue: 0,0:17:37.66,0:17:40.99,Default,,0000,0000,0000,,Бұл….
Dialogue: 0,0:17:37.66,0:17:40.99,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:17:40.99,0:17:44.33,Default,,0000,0000,0000,,Бұл өте қызық!
Dialogue: 0,0:17:40.99,0:17:44.33,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:17:44.33,0:17:46.67,Default,,0000,0000,0000,,Ең жақсысы
Dialogue: 0,0:17:44.33,0:17:46.67,Default,,0000,0000,0000,,Не дәмді болды?
Dialogue: 0,0:17:46.67,0:17:49.17,Default,,0000,0000,0000,,А, бұл туралы уайымдамаңыз.
Dialogue: 0,0:17:49.17,0:17:51.17,Default,,0000,0000,0000,,Kelpie Moving бронь...
Dialogue: 0,0:17:51.17,0:17:53.51,Default,,0000,0000,0000,,Жоқ, менің ойымша, бұл Қызыл Айдаһар!
Dialogue: 0,0:17:51.17,0:17:53.51,Default,,0000,0000,0000,,Иә! ?
Dialogue: 0,0:17:53.51,0:17:56.84,Default,,0000,0000,0000,,Менің әпкем жеген қызыл айдаһар
Dialogue: 0,0:17:53.51,0:17:56.84,Default,,0000,0000,0000,,Сіз оны жедіңіз бе?
Dialogue: 0,0:17:53.51,0:17:56.84,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:17:56.84,0:17:59.85,Default,,0000,0000,0000,,Ең алдымен қозғалмалы сауыт?
Dialogue: 0,0:17:56.84,0:17:59.85,Default,,0000,0000,0000,,Жеуге болатын бөліктері бар ма?
Dialogue: 0,0:17:59.85,0:18:01.78,Default,,0000,0000,0000,,Жақсы сұрақ!
Dialogue: 0,0:18:01.78,0:18:04.28,Default,,0000,0000,0000,,Бұл шын мәнінде
Dialogue: 0,0:18:01.78,0:18:04.28,Default,,0000,0000,0000,,Қабығы бар моллюска➡
Dialogue: 0,0:18:04.28,0:18:06.29,Default,,0000,0000,0000,,Қараңызшы, бұл қылыш...
Dialogue: 0,0:18:06.29,0:18:08.95,Default,,0000,0000,0000,,Уау, тазалаушы Кенсукені жеп жатыр!
Dialogue: 0,0:18:08.95,0:18:10.96,Default,,0000,0000,0000,,Сақтықты төмендетпеңіз.
Dialogue: 0,0:18:10.96,0:18:13.96,Default,,0000,0000,0000,,Айтпақшы
Dialogue: 0,0:18:10.96,0:18:13.96,Default,,0000,0000,0000,,Егер сізді құбыжық тағамдары қызықтырса➡
Dialogue: 0,0:18:13.96,0:18:17.30,Default,,0000,0000,0000,,Мен әрқашан өзімді ұстаймын!
Dialogue: 0,0:18:13.96,0:18:17.30,Default,,0000,0000,0000,,Уау, өтінемін!
Dialogue: 0,0:18:17.30,0:18:20.80,Default,,0000,0000,0000,,《Жаман, мен оны осында әкелемін》
Dialogue: 0,0:18:20.80,0:18:24.30,Default,,0000,0000,0000,,Ха... Сонымен.
Dialogue: 0,0:18:24.30,0:18:28.31,Default,,0000,0000,0000,,Оны өмірге қайтарыңыз...
Dialogue: 0,0:18:24.30,0:18:28.31,Default,,0000,0000,0000,,Соңғы рет көргенде➡
Dialogue: 0,0:18:28.31,0:18:31.14,Default,,0000,0000,0000,,Жақсы болды ма?
Dialogue: 0,0:18:28.31,0:18:31.14,Default,,0000,0000,0000,,А, а.
Dialogue: 0,0:18:31.14,0:18:33.15,Default,,0000,0000,0000,,Сіздің қай жерде екеніңіз туралы түсінік бар ма?
Dialogue: 0,0:18:33.15,0:18:35.65,Default,,0000,0000,0000,,Бұл иерархия
Dialogue: 0,0:18:33.15,0:18:35.65,Default,,0000,0000,0000,,Жасыратын жерлер көп➡
Dialogue: 0,0:18:35.65,0:18:38.15,Default,,0000,0000,0000,,Мұндай жерлер әдетте орктардың бекіністері болып табылады.
Dialogue: 0,0:18:38.15,0:18:43.66,Default,,0000,0000,0000,,А, сен орк болсаң, уайымдаудың қажеті жоқ.
Dialogue: 0,0:18:38.15,0:18:43.66,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:18:43.66,0:18:45.82,Default,,0000,0000,0000,,Дәмі қандай болды?
Dialogue: 0,0:18:43.66,0:18:45.82,Default,,0000,0000,0000,,Жоқ, жоқ!
Dialogue: 0,0:18:45.82,0:18:50.00,Default,,0000,0000,0000,,Оларда көп заттар бар.
Dialogue: 0,0:18:45.82,0:18:50.00,Default,,0000,0000,0000,,Біз қазір ынтымақтастық қарым-қатынастамыз!
Dialogue: 0,0:18:50.00,0:18:52.00,Default,,0000,0000,0000,,Ынтымақтастық….
Dialogue: 0,0:18:52.00,0:18:55.50,Default,,0000,0000,0000,,《Бір-ақ рет бағындыру
Dialogue: 0,0:18:52.00,0:18:55.50,Default,,0000,0000,0000,,Бұл авантюристтің міндеті.
Dialogue: 0,0:18:55.50,0:18:57.50,Default,,0000,0000,0000,,Міне, мен тиесілімін➡
Dialogue: 0,0:18:57.50,0:19:01.44,Default,,0000,0000,0000,,Мүмкін Фарин
Dialogue: 0,0:18:57.50,0:19:01.44,Default,,0000,0000,0000,,Мұндағыдан тереңірек қабат...
Dialogue: 0,0:19:01.44,0:19:03.94,Default,,0000,0000,0000,,Онда
Dialogue: 0,0:19:01.44,0:19:03.94,Default,,0000,0000,0000,,Оны алып кеткен болуы мүмкін.
Dialogue: 0,0:19:03.94,0:19:06.28,Default,,0000,0000,0000,,А... Мені алып кетті! ? неге! ?
Dialogue: 0,0:19:06.28,0:19:09.28,Default,,0000,0000,0000,,Жақсы….
Dialogue: 0,0:19:09.28,0:19:11.95,Default,,0000,0000,0000,,《Ол Шроға айналса жақсы ма?》
Dialogue: 0,0:19:11.95,0:19:16.76,Default,,0000,0000,0000,,Мен сенімен біраз сөйлескім келеді.
Dialogue: 0,0:19:11.95,0:19:16.76,Default,,0000,0000,0000,,Ал, мен оны алып тастаймын.
Dialogue: 0,0:19:22.63,0:19:25.96,Default,,0000,0000,0000,,Иә... Сонымен?
Dialogue: 0,0:19:25.96,0:19:28.27,Default,,0000,0000,0000,,Иә….
Dialogue: 0,0:19:31.30,0:19:34.31,Default,,0000,0000,0000,,Хёрёмару
Dialogue: 0,0:19:31.30,0:19:34.31,Default,,0000,0000,0000,,Жаман емес, бірақ➡
Dialogue: 0,0:19:34.31,0:19:36.31,Default,,0000,0000,0000,,Күн сайын емес...
Dialogue: 0,0:19:36.31,0:19:39.31,Default,,0000,0000,0000,,Өйткені, кейде
Dialogue: 0,0:19:36.31,0:19:39.31,Default,,0000,0000,0000,,Менің ішіме жылы нәрсе салу керек.
Dialogue: 0,0:19:39.31,0:19:42.15,Default,,0000,0000,0000,,Мен келісемін. Тамақтар ➡
Dialogue: 0,0:19:42.15,0:19:44.65,Default,,0000,0000,0000,,Тек ішіңіз ісіп кетсе
Dialogue: 0,0:19:42.15,0:19:44.65,Default,,0000,0000,0000,,Бұл жақсы нәрсе емес.
Dialogue: 0,0:19:44.65,0:19:47.49,Default,,0000,0000,0000,,Менің не айтып тұрғанымды білесің, ергежейлі.
Dialogue: 0,0:19:47.49,0:19:50.16,Default,,0000,0000,0000,,Ботчан
Dialogue: 0,0:19:47.49,0:19:50.16,Default,,0000,0000,0000,,Жас кезімде жиі ауыратынмын➡
Dialogue: 0,0:19:50.16,0:19:54.49,Default,,0000,0000,0000,,Оның үстіне диетам жұқа.
Dialogue: 0,0:19:50.16,0:19:54.49,Default,,0000,0000,0000,,Сіз айналаңыздағы адамдарды алаңдатасыз.
Dialogue: 0,0:19:54.49,0:19:56.50,Default,,0000,0000,0000,,Бірақ кез келген уақытта➡
Dialogue: 0,0:19:56.50,0:19:59.03,Default,,0000,0000,0000,,Тек осы Майзуру жасаған заттар
Dialogue: 0,0:19:56.50,0:19:59.03,Default,,0000,0000,0000,,Мен жақсы тамақтандым.
Dialogue: 0,0:19:59.03,0:20:00.77,Default,,0000,0000,0000,,Миссиялар кезінде жиі
Dialogue: 0,0:19:59.03,0:20:00.77,Default,,0000,0000,0000,,Оны ас үйге сүйреп апарды.
Dialogue: 0,0:20:00.77,0:20:05.10,Default,,0000,0000,0000,,Өзімшілдік деп кім айтты?
Dialogue: 0,0:20:00.77,0:20:05.10,Default,,0000,0000,0000,,Бұл алдыңғы немесе кейінгі жалғыз уақыт.
Dialogue: 0,0:20:05.10,0:20:07.11,Default,,0000,0000,0000,,｟Маизуру.
Dialogue: 0,0:20:07.11,0:20:11.61,Default,,0000,0000,0000,,Мен көмектескім келетін біреу бар.
Dialogue: 0,0:20:07.11,0:20:11.61,Default,,0000,0000,0000,,Маған күшіңді бер｠
Dialogue: 0,0:20:11.61,0:20:13.95,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:20:13.95,0:20:18.12,Default,,0000,0000,0000,,Мен шын мәнінде жаттығатынмын.
Dialogue: 0,0:20:13.95,0:20:18.12,Default,,0000,0000,0000,,Солтүстік әйелдің арбауына түсу➡
Dialogue: 0,0:20:18.12,0:20:23.29,Default,,0000,0000,0000,,Сіз оны бас тарту үшін не айттыңыз?
Dialogue: 0,0:20:18.12,0:20:23.29,Default,,0000,0000,0000,,Менің бас тартқанымды қалайсың ба?
Dialogue: 0,0:20:23.29,0:20:27.13,Default,,0000,0000,0000,,Мен отағасынанмын.
Dialogue: 0,0:20:23.29,0:20:27.13,Default,,0000,0000,0000,,Баланы күту маған сеніп тапсырылған.
Dialogue: 0,0:20:27.13,0:20:29.80,Default,,0000,0000,0000,,Эмоцияға әрекет ете алмайсыз.
Dialogue: 0,0:20:29.80,0:20:33.30,Default,,0000,0000,0000,,алып ағаштар орманға жүгіріп кірді
Dialogue: 0,0:20:29.80,0:20:33.30,Default,,0000,0000,0000,,Қазір не істеп жатырсың?
Dialogue: 0,0:20:33.30,0:20:35.30,Default,,0000,0000,0000,,Егер сіз тағамды сақтаған болсаңыз➡
Dialogue: 0,0:20:35.30,0:20:39.64,Default,,0000,0000,0000,,Пісіру кезінде қиындықтан өтудің қажеті жоқ.
Dialogue: 0,0:20:35.30,0:20:39.64,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:20:39.64,0:20:43.48,Default,,0000,0000,0000,,Неліктен тек сен жасаған нәрсе?
Dialogue: 0,0:20:39.64,0:20:43.48,Default,,0000,0000,0000,,Сіз жақсы тамақтандыңыз ба?
Dialogue: 0,0:20:43.48,0:20:47.81,Default,,0000,0000,0000,,Онда не болды?
Dialogue: 0,0:20:43.48,0:20:47.81,Default,,0000,0000,0000,,Мен түсіндім.
Dialogue: 0,0:20:43.48,0:20:47.81,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:20:47.81,0:20:51.02,Default,,0000,0000,0000,,Бұл махаббат деп аталады.
Dialogue: 0,0:20:52.99,0:20:57.09,Default,,0000,0000,0000,,Пху... Бұл не?
Dialogue: 0,0:20:52.99,0:20:57.09,Default,,0000,0000,0000,,Сіз жақсы нәрсе айтқыңыз келді ме?
Dialogue: 0,0:20:57.09,0:21:01.76,Default,,0000,0000,0000,,Бірақ... иә, қазір тым кеш.
Dialogue: 0,0:21:01.76,0:21:07.27,Default,,0000,0000,0000,,Жағдайға байланысты
Dialogue: 0,0:21:01.76,0:21:07.27,Default,,0000,0000,0000,,Мүмкін, сөзге араласу дұрыс шығар.
Dialogue: 0,0:21:12.94,0:21:14.94,Default,,0000,0000,0000,,Өнер жабдықтары өзгерді.
Dialogue: 0,0:21:14.94,0:21:17.78,Default,,0000,0000,0000,,Әлі де аз
Dialogue: 0,0:21:14.94,0:21:17.78,Default,,0000,0000,0000,,Бұл қиын, солай емес пе?
Dialogue: 0,0:21:17.78,0:21:20.61,Default,,0000,0000,0000,,Жарайды, осындай нәрсе ме?
Dialogue: 0,0:21:20.61,0:21:22.61,Default,,0000,0000,0000,,Ол аяқталды.
Dialogue: 0,0:21:24.78,0:21:28.62,Default,,0000,0000,0000,,Ал, енді, күн жылы.
Dialogue: 0,0:21:24.78,0:21:28.62,Default,,0000,0000,0000,,Оны жеу керек.
Dialogue: 0,0:21:28.62,0:21:30.62,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:21:30.62,0:21:35.79,Default,,0000,0000,0000,,Балалар, мұнда неге келдіңдер?
Dialogue: 0,0:21:30.62,0:21:35.79,Default,,0000,0000,0000,,Құпия нәрсе болып жатыр.
Dialogue: 0,0:21:35.79,0:21:38.30,Default,,0000,0000,0000,,Бала, мен кіремін.
Dialogue: 0,0:21:38.30,0:21:41.80,Default,,0000,0000,0000,,А... Бала!
Dialogue: 0,0:21:41.80,0:21:43.80,Default,,0000,0000,0000,,Уа.
Dialogue: 0,0:21:41.80,0:21:43.80,Default,,0000,0000,0000,,Жерде не! ?
Dialogue: 0,0:21:43.80,0:21:46.81,Default,,0000,0000,0000,,Хмм!
Dialogue: 0,0:21:43.80,0:21:46.81,Default,,0000,0000,0000,,Мынау кім? ?
Dialogue: 0,0:21:48.81,0:21:53.75,Default,,0000,0000,0000,,Сәлем! Не болды!
Dialogue: 0,0:21:48.81,0:21:53.75,Default,,0000,0000,0000,,Кешіріңіз, бізде ештеңе жоқ.
Dialogue: 0,0:21:53.75,0:21:55.91,Default,,0000,0000,0000,,Бұл қара магия.
Dialogue: 0,0:21:55.91,0:22:00.92,Default,,0000,0000,0000,,Бұл жігіт қара магияны қолданады
Dialogue: 0,0:21:55.91,0:22:00.92,Default,,0000,0000,0000,,Әйел құбыжықтың қаны мен етімен тірілді.
Dialogue: 0,0:22:00.92,0:22:03.09,Default,,0000,0000,0000,,Қара….
Dialogue: 0,0:22:03.09,0:22:05.76,Default,,0000,0000,0000,,Неліктен олай істедің?
Dialogue: 0,0:22:05.76,0:22:08.43,Default,,0000,0000,0000,,Сіз не істегеніңізді білесіз бе? ?
Dialogue: 0,0:22:08.43,0:22:10.76,Default,,0000,0000,0000,,Қара магиямен айналысатын адамдар….
Dialogue: 0,0:22:10.76,0:22:14.43,Default,,0000,0000,0000,,Себеп немесе дәреже маңызды емес.
Dialogue: 0,0:22:10.76,0:22:14.43,Default,,0000,0000,0000,,Барлығы үлкен күнәкарлар!
Dialogue: 0,0:22:14.43,0:22:19.27,Default,,0000,0000,0000,,Өлгенше жарық жетпейтін жерде
Dialogue: 0,0:22:14.43,0:22:19.27,Default,,0000,0000,0000,,Түрмеге қамалды, денесі қайтып оралмады.
Dialogue: 0,0:22:19.27,0:22:23.78,Default,,0000,0000,0000,,Егер батыстың эльфтері білсе
Dialogue: 0,0:22:19.27,0:22:23.78,Default,,0000,0000,0000,,Ол немен бетпе-бет келеді екен...
Dialogue: 0,0:22:23.78,0:22:27.28,Default,,0000,0000,0000,,«Егер лабиринттен тыс белгілі болса».
Dialogue: 0,0:22:27.28,0:22:30.62,Default,,0000,0000,0000,,Сіз мұны айттыңыз
Dialogue: 0,0:22:27.28,0:22:30.62,Default,,0000,0000,0000,,Ешқашан сөйлеспе.
Dialogue: 0,0:22:30.62,0:22:32.92,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:22:30.62,0:22:32.92,Default,,0000,0000,0000,,Мен және ұлым
Dialogue: 0,0:22:37.79,0:22:40.13,Default,,0000,0000,0000,,Менің мұны істеуден басқа амалым қалмады.
Dialogue: 0,0:22:40.13,0:22:42.63,Default,,0000,0000,0000,,Түсініңіз, Шро.
Dialogue: 0,0:22:40.13,0:22:42.63,Default,,0000,0000,0000,,Бұл өтірік болғандықтан ба?>
Dialogue: 0,0:22:44.63,0:22:46.63,Default,,0000,0000,0000,,《Қара магия!
Dialogue: 0,0:22:46.63,0:22:50.47,Default,,0000,0000,0000,,Мен күткеннен де қауіпті нәрсе шықты.
Dialogue: 0,0:22:46.63,0:22:50.47,Default,,0000,0000,0000,,Бұл туралы не істеуім керек?
Dialogue: 0,0:22:50.47,0:23:10.42,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:23:10.42,0:23:12.42,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:23:12.42,0:23:15.93,Default,,0000,0000,0000,,Құрметті Делгар…
Dialogue: 0,0:23:15.93,0:23:20.63,Default,,0000,0000,0000,,Мен сені іздеуім керек...
Dialogue: 0,0:23:22.13,0:23:28.13,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory