Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:30.36,0:01:32.56,Default,,0000,0000,0000,,Қаруларыңызды тез лақтырыңыз.
Dialogue: 0,0:01:35.53,0:01:41.03,Default,,0000,0000,0000,,Артқа шегініп, жүгіріп өтіңіз.
Dialogue: 0,0:01:35.53,0:01:41.03,Default,,0000,0000,0000,,Сәл қимылдасаң, мен сені өлтіремін.
Dialogue: 0,0:01:41.03,0:01:43.04,Default,,0000,0000,0000,,Сол жігіт, меніңше➡
Dialogue: 0,0:01:43.04,0:01:45.04,Default,,0000,0000,0000,,Шроның қасындағылар
Dialogue: 0,0:01:43.04,0:01:45.04,Default,,0000,0000,0000,,Сіз жалғыз емессіз бе?
Dialogue: 0,0:01:45.04,0:01:47.87,Default,,0000,0000,0000,,Бізді мәңгі бақылаңыз
Dialogue: 0,0:01:45.04,0:01:47.87,Default,,0000,0000,0000,,Сіз оны әкелдіңіз бе?
Dialogue: 0,0:01:47.87,0:01:49.88,Default,,0000,0000,0000,,Сіз.
Dialogue: 0,0:01:47.87,0:01:49.88,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:01:49.88,0:01:52.05,Default,,0000,0000,0000,,Осы техниканы шешіңіз.
Dialogue: 0,0:01:49.88,0:01:52.05,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:01:52.05,0:01:54.05,Default,,0000,0000,0000,,Бұл маған байланысты!
Dialogue: 0,0:01:52.05,0:01:54.05,Default,,0000,0000,0000,,Сәлеметсіз бе.
Dialogue: 0,0:01:54.05,0:01:57.88,Default,,0000,0000,0000,,Һм. Менің немерем сәл қатал сыншы екен, иә?
Dialogue: 0,0:01:54.05,0:01:57.88,Default,,0000,0000,0000,,Саған қандай сиқыр жасалып жатыр?
Dialogue: 0,0:01:57.88,0:01:59.89,Default,,0000,0000,0000,,Сіз оны көрмейсіз бе?
Dialogue: 0,0:01:59.89,0:02:04.16,Default,,0000,0000,0000,,Сіз қара сиқыршысыз, солай ма?
Dialogue: 0,0:01:59.89,0:02:04.16,Default,,0000,0000,0000,,Ең болмағанда қай жерде ілулі тұр?➡
Dialogue: 0,0:02:04.16,0:02:07.83,Default,,0000,0000,0000,,Бұл қандай сиқыр екенін айт.
Dialogue: 0,0:02:04.16,0:02:07.83,Default,,0000,0000,0000,,Тс!
Dialogue: 0,0:02:07.83,0:02:11.16,Default,,0000,0000,0000,,Маған әсер ететін сиқырдың екі түрі бар.
Dialogue: 0,0:02:11.16,0:02:13.17,Default,,0000,0000,0000,,Біреуі мойынға.
Dialogue: 0,0:02:13.17,0:02:15.37,Default,,0000,0000,0000,,Тағы бір нәрсе...
Dialogue: 0,0:02:13.17,0:02:15.37,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:02:17.34,0:02:19.34,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:02:19.34,0:02:21.84,Default,,0000,0000,0000,,Барлық денеде.
Dialogue: 0,0:02:21.84,0:02:27.68,Default,,0000,0000,0000,,Бұл жануар ма?
Dialogue: 0,0:02:21.84,0:02:27.68,Default,,0000,0000,0000,,Хаха, баяғыда бір көргенмін.
Dialogue: 0,0:02:27.68,0:02:30.68,Default,,0000,0000,0000,,Олар жасанды түрде жасалған аңдар.
Dialogue: 0,0:02:30.68,0:02:34.69,Default,,0000,0000,0000,,Қара магияның көмегімен адамдар мен аңдардың жанын жаулап алу.
Dialogue: 0,0:02:30.68,0:02:34.69,Default,,0000,0000,0000,,Араластырып жасалған дейді.
Dialogue: 0,0:02:36.69,0:02:40.03,Default,,0000,0000,0000,,Жарайды, мен бар күшімді саламын.
Dialogue: 0,0:02:40.03,0:02:42.20,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,0:02:42.20,0:02:45.03,Default,,0000,0000,0000,,Шығыс тілінде жазылғанға ұқсайды.
Dialogue: 0,0:02:45.03,0:02:48.87,Default,,0000,0000,0000,,Бұл техниканың қандай түрі?
Dialogue: 0,0:02:45.03,0:02:48.87,Default,,0000,0000,0000,,Сіз оны көрмейсіз бе?
Dialogue: 0,0:02:48.87,0:02:52.54,Default,,0000,0000,0000,,Егер құюшы оны белгілі бір уақыт ішінде ұстамаса,
Dialogue: 0,0:02:48.87,0:02:52.54,Default,,0000,0000,0000,,Бұл жұмыс істейтін заклинание.
Dialogue: 0,0:02:52.54,0:02:57.04,Default,,0000,0000,0000,,Бұл адам Майзуру деп аталады ма?
Dialogue: 0,0:02:52.54,0:02:57.04,Default,,0000,0000,0000,,Жеңілдік мерзімі қанша?
Dialogue: 0,0:02:57.04,0:03:02.15,Default,,0000,0000,0000,,Мерзім жеткенде не болады?
Dialogue: 0,0:02:57.04,0:03:02.15,Default,,0000,0000,0000,,Енді? Мүмкін мен асығуым керек.
Dialogue: 0,0:03:02.15,0:03:05.49,Default,,0000,0000,0000,,Менімен бірге өлгің келмейді.
Dialogue: 0,0:03:05.49,0:03:08.32,Default,,0000,0000,0000,,Сен оны босатсаң, мен сені босатамын.
Dialogue: 0,0:03:08.32,0:03:11.49,Default,,0000,0000,0000,,《Кейіпкер ерекше.
Dialogue: 0,0:03:11.49,0:03:13.49,Default,,0000,0000,0000,,Бірақ менің ойымша, мұны жоюға болады.
Dialogue: 0,0:03:13.49,0:03:15.50,Default,,0000,0000,0000,,Сәлем! Сол бала!
Dialogue: 0,0:03:13.49,0:03:15.50,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:03:13.49,0:03:15.50,Default,,0000,0000,0000,,(Мұғалім) О, қандай жаһандық көзқарас. (Цубаки) 《Уф! Сол сұм~》
Dialogue: 0,0:03:15.50,0:03:17.50,Default,,0000,0000,0000,,Маған тамақ әкел.
Dialogue: 0,0:03:21.83,0:03:23.84,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:03:27.34,0:03:30.68,Default,,0000,0000,0000,,Оноши
Dialogue: 0,0:03:27.34,0:03:30.68,Default,,0000,0000,0000,,Соңғы рет қашан тамақтандыңыз?
Dialogue: 0,0:03:30.68,0:03:34.68,Default,,0000,0000,0000,,Тамақ ішу
Dialogue: 0,0:03:30.68,0:03:34.68,Default,,0000,0000,0000,,Тамағыңа кептеліп қалады.
Dialogue: 0,0:03:30.68,0:03:34.68,Default,,0000,0000,0000,,Ой!
Dialogue: 0,0:03:34.68,0:03:37.52,Default,,0000,0000,0000,,Маған жылы нәрсе дайындап беріңізші...
Dialogue: 0,0:03:34.68,0:03:37.52,Default,,0000,0000,0000,,Эй!
Dialogue: 0,0:03:37.52,0:03:39.52,Default,,0000,0000,0000,,Өз бетімен қозғалма!
Dialogue: 0,0:03:37.52,0:03:39.52,Default,,0000,0000,0000,,О, күте тұрыңыз ...
Dialogue: 0,0:03:39.52,0:03:41.52,Default,,0000,0000,0000,,Менің атымды айт...
Dialogue: 0,0:03:41.52,0:03:43.52,Default,,0000,0000,0000,,Гохо! Гохо гохо!
Dialogue: 0,0:03:43.52,0:03:48.53,Default,,0000,0000,0000,,Тамағыңызды қандыратын нәрсе керек.
Dialogue: 0,0:03:43.52,0:03:48.53,Default,,0000,0000,0000,,Жай дайындалыңыз.
Dialogue: 0,0:03:48.53,0:03:51.36,Default,,0000,0000,0000,,Егер сіз құбыжықты тамақтандыруға тырыссаңыз
Dialogue: 0,0:03:48.53,0:03:51.36,Default,,0000,0000,0000,,Мен сені өлтіремін.
Dialogue: 0,0:03:51.36,0:03:53.87,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:03:53.87,0:03:56.20,Default,,0000,0000,0000,,Умм….
Dialogue: 0,0:03:56.20,0:04:00.81,Default,,0000,0000,0000,,Мен оны драйадтың жанынан алдым деп ойлаймын.
Dialogue: 0,0:03:56.20,0:04:00.81,Default,,0000,0000,0000,,Саңырауқұлақтар... Ммм?
Dialogue: 0,0:04:00.81,0:04:04.81,Default,,0000,0000,0000,,《Аяқ сияқты нәрсе
Dialogue: 0,0:04:00.81,0:04:04.81,Default,,0000,0000,0000,,Ол өсе бастады ма?
Dialogue: 0,0:04:04.81,0:04:07.31,Default,,0000,0000,0000,,Мүмкін бұл менің қиялым шығар.
Dialogue: 0,0:04:07.31,0:04:09.98,Default,,0000,0000,0000,,Кәстрөлді сиқырлы шеңбердің үстіне қойыңыз➡
Dialogue: 0,0:04:09.98,0:04:13.82,Default,,0000,0000,0000,,Сары майды ерітіп, сарымсақты қуырамыз ➡
Dialogue: 0,0:04:13.82,0:04:15.82,Default,,0000,0000,0000,,Күрішті қосыңыз.
Dialogue: 0,0:04:15.82,0:04:18.32,Default,,0000,0000,0000,,Саңырауқұлақтарға арналған дәмдеуіштер.
Dialogue: 0,0:04:18.32,0:04:21.13,Default,,0000,0000,0000,,Су құйып, біраз уақыт қайнатыңыз.
Dialogue: 0,0:04:25.16,0:04:27.33,Default,,0000,0000,0000,,Мм.
Dialogue: 0,0:04:27.33,0:04:32.67,Default,,0000,0000,0000,,《Мен тек осы деңгейдегі заттарды ғана жасай аламын.
Dialogue: 0,0:04:27.33,0:04:32.67,Default,,0000,0000,0000,,Бұл күшсіз. Бұл аянышты.
Dialogue: 0,0:04:32.67,0:04:37.34,Default,,0000,0000,0000,,Қалай десек те, жастарда терең сезім болады.
Dialogue: 0,0:04:32.67,0:04:37.34,Default,,0000,0000,0000,,Мен не істеп жатқаныма шыдай алмаймын.
Dialogue: 0,0:04:37.34,0:04:41.18,Default,,0000,0000,0000,,Ең болмаса... ірімшік қосамыз.》
Dialogue: 0,0:04:41.18,0:04:43.18,Default,,0000,0000,0000,,Ол аяқталды!
Dialogue: 0,0:04:45.18,0:04:48.89,Default,,0000,0000,0000,,Мен оны осында қоямын.
Dialogue: 0,0:04:45.18,0:04:48.89,Default,,0000,0000,0000,,Мұны кім жасайды...?
Dialogue: 0,0:04:50.86,0:04:52.86,Default,,0000,0000,0000,,Хун.
Dialogue: 0,0:04:52.86,0:04:54.86,Default,,0000,0000,0000,,Хехе.
Dialogue: 0,0:04:54.86,0:04:57.86,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:04:57.86,0:05:01.13,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:04:57.86,0:05:01.13,Default,,0000,0000,0000,,Ах, а...
Dialogue: 0,0:05:01.13,0:05:05.14,Default,,0000,0000,0000,,《Бұл баланың... тамақ ішу тәртібі нашар...
Dialogue: 0,0:05:05.14,0:05:08.81,Default,,0000,0000,0000,,Нашар! 》
Dialogue: 0,0:05:05.14,0:05:08.81,Default,,0000,0000,0000,,Маған көбірек беріңіз!
Dialogue: 0,0:05:08.81,0:05:12.31,Default,,0000,0000,0000,,Шығыста этикет болып табылады
Dialogue: 0,0:05:08.81,0:05:12.31,Default,,0000,0000,0000,,Бұл дәл қарама-қарсы ма?
Dialogue: 0,0:05:12.31,0:05:16.32,Default,,0000,0000,0000,,Жоқ, Шлоу солай болды.
Dialogue: 0,0:05:12.31,0:05:16.32,Default,,0000,0000,0000,,Менің оны жегенімді ешқашан көрген емессің.
Dialogue: 0,0:05:16.32,0:05:18.65,Default,,0000,0000,0000,,Мен жай ғана нашар тәрбиеленгенмін.
Dialogue: 0,0:05:18.65,0:05:20.65,Default,,0000,0000,0000,,Бұл сіз үшін әдеттен тыс па?
Dialogue: 0,0:05:26.66,0:05:28.66,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:05:26.66,0:05:28.66,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:05:32.00,0:05:34.17,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:05:34.17,0:05:37.84,Default,,0000,0000,0000,,Енді... не?
Dialogue: 0,0:05:34.17,0:05:37.84,Default,,0000,0000,0000,,Мен саңырауқұлақтарды жек көремін.
Dialogue: 0,0:05:37.84,0:05:41.01,Default,,0000,0000,0000,,《Таңдаусыз жегіш! 》
Dialogue: 0,0:05:37.84,0:05:41.01,Default,,0000,0000,0000,,《Бұл бұрын-соңды болмаған үлгі! 》
Dialogue: 0,0:05:41.01,0:05:43.84,Default,,0000,0000,0000,,《Сенси...》
Dialogue: 0,0:05:43.84,0:05:46.35,Default,,0000,0000,0000,,Қасық….
Dialogue: 0,0:05:43.84,0:05:46.35,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:05:46.35,0:05:49.02,Default,,0000,0000,0000,,Қасықты дұрыс ұстаңыз.
Dialogue: 0,0:05:49.02,0:05:52.02,Default,,0000,0000,0000,,Сәлем! одан да көп
Dialogue: 0,0:05:49.02,0:05:52.02,Default,,0000,0000,0000,,Егер жақындасаң, мен сені өлтіремін!
Dialogue: 0,0:05:52.02,0:05:56.69,Default,,0000,0000,0000,,Қасықты дұрыс ұстаңыз
Dialogue: 0,0:05:52.02,0:05:56.69,Default,,0000,0000,0000,,Еденге лақтырған нәрсені ал.
Dialogue: 0,0:05:56.69,0:05:58.69,Default,,0000,0000,0000,,Нада Теми!
Dialogue: 0,0:05:56.69,0:05:58.69,Default,,0000,0000,0000,,О, күте тұрыңыз!
Dialogue: 0,0:05:58.69,0:06:00.63,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:05:58.69,0:06:00.63,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:06:00.63,0:06:02.63,Default,,0000,0000,0000,,Құлыптан босатылған кезде қозғалу қауіпті!
Dialogue: 0,0:06:02.63,0:06:04.96,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:06:04.96,0:06:06.97,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:06:06.97,0:06:09.14,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:06:06.97,0:06:09.14,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,0:06:06.97,0:06:09.14,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:06:09.14,0:06:11.14,Default,,0000,0000,0000,,О, жоқ!
Dialogue: 0,0:06:11.14,0:06:13.14,Default,,0000,0000,0000,,Ах...!
Dialogue: 0,0:06:13.14,0:06:15.64,Default,,0000,0000,0000,,Ол адам қуанады…
Dialogue: 0,0:06:15.64,0:06:19.81,Default,,0000,0000,0000,,Қасықты осылай ұстайсың.
Dialogue: 0,0:06:15.64,0:06:19.81,Default,,0000,0000,0000,,Әй, бұл адамдарға байланысты!
Dialogue: 0,0:06:19.81,0:06:22.15,Default,,0000,0000,0000,,Бұл мен үшін ең жақсысы
Dialogue: 0,0:06:19.81,0:06:22.15,Default,,0000,0000,0000,,Мұны істеу оңай!
Dialogue: 0,0:06:22.15,0:06:24.15,Default,,0000,0000,0000,,Мен солай ойлаймын.
Dialogue: 0,0:06:24.15,0:06:27.49,Default,,0000,0000,0000,,Мен бейтаныс жолмен бірдеңені ұстауға мәжбүр болсам да
Dialogue: 0,0:06:24.15,0:06:27.49,Default,,0000,0000,0000,,Бұл қиын болар еді.
Dialogue: 0,0:06:27.49,0:06:29.66,Default,,0000,0000,0000,,Бірақ...
Dialogue: 0,0:06:27.49,0:06:29.66,Default,,0000,0000,0000,,Сенші, артта!
Dialogue: 0,0:06:29.66,0:06:31.82,Default,,0000,0000,0000,,Таа!
Dialogue: 0,0:06:31.82,0:06:34.49,Default,,0000,0000,0000,,Сондықтан, егер Урарака ханым алғашқы қадамды жасаса…
Dialogue: 0,0:06:31.82,0:06:34.49,Default,,0000,0000,0000,,(Мұғалім) О, қандай жаһандық көзқарас. (Цубаки) 《Уф! Сол сұм~》
Dialogue: 0,0:06:34.49,0:06:36.50,Default,,0000,0000,0000,,《Жауап...》
Dialogue: 0,0:06:36.50,0:06:38.50,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:06:36.50,0:06:38.50,Default,,0000,0000,0000,,《Қағаз? 》
Dialogue: 0,0:06:38.50,0:06:40.50,Default,,0000,0000,0000,,Сенші! Абайлаңыз!
Dialogue: 0,0:06:40.50,0:06:43.50,Default,,0000,0000,0000,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:06:43.50,0:06:49.18,Default,,0000,0000,0000,,Бұл етті кесу кезінде қолданылады.
Dialogue: 0,0:06:43.50,0:06:49.18,Default,,0000,0000,0000,,Бұл «суджихики» деп аталатын пышақтың бір түрі.
Dialogue: 0,0:06:49.18,0:06:53.18,Default,,0000,0000,0000,,Пышақ ұзын және өткір.
Dialogue: 0,0:06:49.18,0:06:53.18,Default,,0000,0000,0000,,Бұл қорқынышты көрінеді➡
Dialogue: 0,0:06:53.18,0:06:55.18,Default,,0000,0000,0000,,Ол жұқа және нәзік.
Dialogue: 0,0:06:55.18,0:06:57.85,Default,,0000,0000,0000,,Оны осылай шайқаңыз
Dialogue: 0,0:06:55.18,0:06:57.85,Default,,0000,0000,0000,,Егер сіз оны тербетсеңіз➡
Dialogue: 0,0:06:57.85,0:07:01.15,Default,,0000,0000,0000,,Не болады...
Dialogue: 0,0:06:57.85,0:07:01.15,Default,,0000,0000,0000,,Сенші! Ха!
Dialogue: 0,0:07:04.12,0:07:06.79,Default,,0000,0000,0000,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:07:04.12,0:07:06.79,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,0:07:06.79,0:07:08.80,Default,,0000,0000,0000,,Уау….
Dialogue: 0,0:07:10.80,0:07:13.97,Default,,0000,0000,0000,,Миссия үшін,
Dialogue: 0,0:07:10.80,0:07:13.97,Default,,0000,0000,0000,,Құралдың барлық мүмкіндіктерін көрсете алмау➡
Dialogue: 0,0:07:13.97,0:07:16.80,Default,,0000,0000,0000,,Сіздің қолайсыз жағдайға ұшырауыңыз мүмкін.
Dialogue: 0,0:07:16.80,0:07:18.97,Default,,0000,0000,0000,,Уау….
Dialogue: 0,0:07:18.97,0:07:21.57,Default,,0000,0000,0000,,Нуу!
Dialogue: 0,0:07:23.64,0:07:25.98,Default,,0000,0000,0000,,Сенші!
Dialogue: 0,0:07:23.64,0:07:25.98,Default,,0000,0000,0000,,Қазір! Лайос!
Dialogue: 0,0:07:25.98,0:07:31.48,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:07:25.98,0:07:31.48,Default,,0000,0000,0000,,Құдай-ай!
Dialogue: 0,0:07:34.32,0:07:37.49,Default,,0000,0000,0000,,Сіз жарақат алдыңыз ба? мысық қыз
Dialogue: 0,0:07:37.49,0:07:41.49,Default,,0000,0000,0000,,Сізді таң қалдыратындай әрекет етіңіз.
Dialogue: 0,0:07:37.49,0:07:41.49,Default,,0000,0000,0000,,Бұл жаман болды, бірақ...
Dialogue: 0,0:07:41.49,0:07:46.00,Default,,0000,0000,0000,,Құрал-саймандарды ұстаудың жақсы және жаман тәсілдері бар.
Dialogue: 0,0:07:41.49,0:07:46.00,Default,,0000,0000,0000,,Неліктен?➡
Dialogue: 0,0:07:46.00,0:07:48.50,Default,,0000,0000,0000,,Бұл туралы бір рет ойланыңыз.
Dialogue: 0,0:07:48.50,0:07:51.67,Default,,0000,0000,0000,,Сиқырдан бас тартылған кезде де ол қозғалмайды.
Dialogue: 0,0:07:51.67,0:07:54.84,Default,,0000,0000,0000,,Бұл қиынырақ әдіс болса ше?
Dialogue: 0,0:07:51.67,0:07:54.84,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:07:54.84,0:07:56.84,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:07:56.84,0:08:01.15,Default,,0000,0000,0000,,Тағам суып кетті.
Dialogue: 0,0:07:56.84,0:08:01.15,Default,,0000,0000,0000,,Дереу қайта қыздырыңыз.
Dialogue: 0,0:08:03.12,0:08:07.12,Default,,0000,0000,0000,,Ендеше, сен бізге неге еріп жүрсің?
Dialogue: 0,0:08:03.12,0:08:07.12,Default,,0000,0000,0000,,Сіз оны әкелдіңіз бе?
Dialogue: 0,0:08:07.12,0:08:09.12,Default,,0000,0000,0000,,Мен әрқашан➡ болдым
Dialogue: 0,0:08:09.12,0:08:12.63,Default,,0000,0000,0000,,Денеге қолданылады
Dialogue: 0,0:08:09.12,0:08:12.63,Default,,0000,0000,0000,,Мен бұл қарғысты жоюдың жолын іздедім.
Dialogue: 0,0:08:14.63,0:08:17.63,Default,,0000,0000,0000,,Бұл қара магияның әсерінен болатын қарғыс.
Dialogue: 0,0:08:14.63,0:08:17.63,Default,,0000,0000,0000,,Мен сіздің айтқаныңызды түсіндім, бірақ➡
Dialogue: 0,0:08:17.63,0:08:21.30,Default,,0000,0000,0000,,Қара магияны қолдана алатын адамдар
Dialogue: 0,0:08:17.63,0:08:21.30,Default,,0000,0000,0000,,Табылмады.
Dialogue: 0,0:08:21.30,0:08:24.14,Default,,0000,0000,0000,,Онда... Мимичомен кездескенше.
Dialogue: 0,0:08:21.30,0:08:24.14,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:08:24.14,0:08:28.47,Default,,0000,0000,0000,,Қара... Ежелгі сиқыр десе де.
Dialogue: 0,0:08:24.14,0:08:28.47,Default,,0000,0000,0000,,Менің зерттеуім негізінен ➡
Dialogue: 0,0:08:28.47,0:08:30.81,Default,,0000,0000,0000,,Басқа өлшемдегі энергия...
Dialogue: 0,0:08:28.47,0:08:30.81,Default,,0000,0000,0000,,Алдамаңыз!
Dialogue: 0,0:08:30.81,0:08:32.98,Default,,0000,0000,0000,,Сіз мұны істей аласыз!
Dialogue: 0,0:08:32.98,0:08:35.48,Default,,0000,0000,0000,,(Толық шоғырлану тынысы)
Dialogue: 0,0:08:32.98,0:08:35.48,Default,,0000,0000,0000,,Сіз мұны шынымен жасадыңыз!
Dialogue: 0,0:08:35.48,0:08:39.99,Default,,0000,0000,0000,,Адамдар мен құбыжықтар
Dialogue: 0,0:08:35.48,0:08:39.99,Default,,0000,0000,0000,,Біртүрлі фигуралар жасайтын қара магия!
Dialogue: 0,0:08:39.99,0:08:42.32,Default,,0000,0000,0000,,Ал... сендер балалар➡
Dialogue: 0,0:08:42.32,0:08:45.49,Default,,0000,0000,0000,,Сол әйелдің қарғысын бұзу
Dialogue: 0,0:08:42.32,0:08:45.49,Default,,0000,0000,0000,,Сіз лабиринт арқылы өтіп бара жатырсыз, солай ма?
Dialogue: 0,0:08:45.49,0:08:48.83,Default,,0000,0000,0000,,Қарғысты осылай бұзуға болады.
Dialogue: 0,0:08:45.49,0:08:48.83,Default,,0000,0000,0000,,Сіз мұны білесіз бе?
Dialogue: 0,0:08:48.83,0:08:51.83,Default,,0000,0000,0000,,Сонда менің қарғысым жойылады!
Dialogue: 0,0:08:51.83,0:08:55.53,Default,,0000,0000,0000,,мені иемденді
Dialogue: 0,0:08:51.83,0:08:55.53,Default,,0000,0000,0000,,Мына аңның жанын алып тастаңыз!
Dialogue: 0,0:08:57.67,0:09:02.11,Default,,0000,0000,0000,,Кешіріңіз... бұл мен үшін емес
Dialogue: 0,0:08:57.67,0:09:02.11,Default,,0000,0000,0000,,Ештеңе істеу мүмкін емес.
Dialogue: 0,0:09:02.11,0:09:04.11,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:09:04.11,0:09:06.95,Default,,0000,0000,0000,,Жанға
Dialogue: 0,0:09:04.11,0:09:06.95,Default,,0000,0000,0000,,Мен әлі де түсінбейтін нәрселер көп➡
Dialogue: 0,0:09:06.95,0:09:09.78,Default,,0000,0000,0000,,Көбінесе жұмыртқамен салыстырылады.
Dialogue: 0,0:09:09.78,0:09:12.79,Default,,0000,0000,0000,,Әдетте
Dialogue: 0,0:09:09.78,0:09:12.79,Default,,0000,0000,0000,,Дененің қабықшасының ішінде➡
Dialogue: 0,0:09:12.79,0:09:18.12,Default,,0000,0000,0000,,Дене ыдырағанда ішіндегісі ағып кетеді.
Dialogue: 0,0:09:12.79,0:09:18.12,Default,,0000,0000,0000,,Ол ешқашан қалыпты жағдайға оралмайды.
Dialogue: 0,0:09:18.12,0:09:23.30,Default,,0000,0000,0000,,Осы лабиринтте, қабықтың ішінде
Dialogue: 0,0:09:18.12,0:09:23.30,Default,,0000,0000,0000,,Күшті мембрана жасау техникасы бар➡
Dialogue: 0,0:09:23.30,0:09:26.47,Default,,0000,0000,0000,,Зардап алсаң да, жаның сені тастап кетпейді.
Dialogue: 0,0:09:26.47,0:09:28.63,Default,,0000,0000,0000,,Қазір Фарин екеуің➡
Dialogue: 0,0:09:28.63,0:09:32.97,Default,,0000,0000,0000,,Бір қабықшада
Dialogue: 0,0:09:28.63,0:09:32.97,Default,,0000,0000,0000,,Екі мазмұнды қамтиды.
Dialogue: 0,0:09:32.97,0:09:38.48,Default,,0000,0000,0000,,Жандар бір кезде араласқан
Dialogue: 0,0:09:32.97,0:09:38.48,Default,,0000,0000,0000,,Ол ешқашан өзінің бастапқы түріне оралмайды.
Dialogue: 0,0:09:38.48,0:09:43.15,Default,,0000,0000,0000,,《Түсіндім, бірақ
Dialogue: 0,0:09:38.48,0:09:43.15,Default,,0000,0000,0000,,Бұлай анық айтылғанда》
Dialogue: 0,0:09:43.15,0:09:45.65,Default,,0000,0000,0000,,А... Иә? Олай болса➡
Dialogue: 0,0:09:45.65,0:09:49.82,Default,,0000,0000,0000,,Сен неге
Dialogue: 0,0:09:45.65,0:09:49.82,Default,,0000,0000,0000,,Саяхатыңызды жалғастырып жатырсыз ба?
Dialogue: 0,0:09:49.82,0:09:51.82,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:09:51.82,0:09:55.16,Default,,0000,0000,0000,,Бірі – апамды сол күйінде қалдыру.
Dialogue: 0,0:09:51.82,0:09:55.16,Default,,0000,0000,0000,,Оны жалғыз қалдыруға болмайды.
Dialogue: 0,0:09:55.16,0:09:58.50,Default,,0000,0000,0000,,Мен кездестірген келесі авантюрист
Dialogue: 0,0:09:55.16,0:09:58.50,Default,,0000,0000,0000,,Мен сені өлтіруім мүмкін➡
Dialogue: 0,0:09:58.50,0:10:00.67,Default,,0000,0000,0000,,Сізді өлтіруі мүмкін...
Dialogue: 0,0:10:00.67,0:10:03.34,Default,,0000,0000,0000,,Бұған дейін біз бұл туралы бірдеңе жасағымыз келеді.
Dialogue: 0,0:10:03.34,0:10:06.01,Default,,0000,0000,0000,,Сондай-ақ, жай ғана қазір жерге оралу➡
Dialogue: 0,0:10:06.01,0:10:08.01,Default,,0000,0000,0000,,Қара магия арқылы ұсталды.
Dialogue: 0,0:10:08.01,0:10:12.35,Default,,0000,0000,0000,,Бұл жолы Шро айтты
Dialogue: 0,0:10:08.01,0:10:12.35,Default,,0000,0000,0000,,Мен арал иесіне хабарлаймын.
Dialogue: 0,0:10:12.35,0:10:15.85,Default,,0000,0000,0000,,Болды... Сосын мен➡
Dialogue: 0,0:10:15.85,0:10:18.52,Default,,0000,0000,0000,,Барлық уақытта...
Dialogue: 0,0:10:15.85,0:10:18.52,Default,,0000,0000,0000,,Жоқ! Бірақ мен➡
Dialogue: 0,0:10:18.52,0:10:20.69,Default,,0000,0000,0000,,Осылай айтсаң да
Dialogue: 0,0:10:18.52,0:10:20.69,Default,,0000,0000,0000,,Бірақ ➡
Dialogue: 0,0:10:20.69,0:10:23.02,Default,,0000,0000,0000,,Танысқаныма қуаныштымын
Dialogue: 0,0:10:20.69,0:10:23.02,Default,,0000,0000,0000,,Мен жасағаныма өте қуаныштымын!
Dialogue: 0,0:10:23.02,0:10:25.36,Default,,0000,0000,0000,,Қандай құбыжықпен араласқан?
Dialogue: 0,0:10:23.02,0:10:25.36,Default,,0000,0000,0000,,Мен білмеймін, бірақ➡
Dialogue: 0,0:10:25.36,0:10:27.86,Default,,0000,0000,0000,,Сіздің мінез-құлқыңыз
Dialogue: 0,0:10:25.36,0:10:27.86,Default,,0000,0000,0000,,Бұл жай ғана адамға ұқсайды➡
Dialogue: 0,0:10:27.86,0:10:29.86,Default,,0000,0000,0000,,Өлтіретін импульстар жоқ!
Dialogue: 0,0:10:29.86,0:10:33.70,Default,,0000,0000,0000,,Артқа қарасаң, Фарин екен.
Dialogue: 0,0:10:29.86,0:10:33.70,Default,,0000,0000,0000,,Егер сізді лабиринт басқармаса➡
Dialogue: 0,0:10:33.70,0:10:36.54,Default,,0000,0000,0000,,Түпнұсқа тұлға
Dialogue: 0,0:10:33.70,0:10:36.54,Default,,0000,0000,0000,,Оны қалпына келтіру мүмкін болуы мүмкін.
Dialogue: 0,0:10:36.54,0:10:40.21,Default,,0000,0000,0000,,Мұны білу
Dialogue: 0,0:10:36.54,0:10:40.21,Default,,0000,0000,0000,,Мен... бұл...
Dialogue: 0,0:10:40.21,0:10:42.38,Default,,0000,0000,0000,,Мен қазір шынымен бақыттымын.
Dialogue: 0,0:10:42.38,0:10:44.38,Default,,0000,0000,0000,,Қараңыз.
Dialogue: 0,0:10:42.38,0:10:44.38,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:10:44.38,0:10:47.88,Default,,0000,0000,0000,,Сіз не күтесіз?
Dialogue: 0,0:10:44.38,0:10:47.88,Default,,0000,0000,0000,,Бұл сәл басқаша болуы мүмкін, бірақ➡
Dialogue: 0,0:10:47.88,0:10:52.22,Default,,0000,0000,0000,,Бұл да байланыстың бір түрі.
Dialogue: 0,0:10:47.88,0:10:52.22,Default,,0000,0000,0000,,Неліктен позитивті ойлауға болмайды?
Dialogue: 0,0:10:52.22,0:10:54.22,Default,,0000,0000,0000,,Бұл лабиринттің иесі➡
Dialogue: 0,0:10:54.22,0:10:57.56,Default,,0000,0000,0000,,Менен әлдеқайда көп
Dialogue: 0,0:10:54.22,0:10:57.56,Default,,0000,0000,0000,,Ежелгі сиқырды жақсы меңгерген.
Dialogue: 0,0:10:57.56,0:10:59.56,Default,,0000,0000,0000,,Мүмкін ол➡
Dialogue: 0,0:10:59.56,0:11:02.50,Default,,0000,0000,0000,,Сондай-ақ жандардың бөлінуіне қатысты
Dialogue: 0,0:10:59.56,0:11:02.50,Default,,0000,0000,0000,,Мүмкін сіз бірдеңе білетін шығарсыз.
Dialogue: 0,0:11:02.50,0:11:06.00,Default,,0000,0000,0000,,Не? Сіз шынымен мені сұрап жатырсыз ба?
Dialogue: 0,0:11:06.00,0:11:09.17,Default,,0000,0000,0000,,Кез келген жағдайда
Dialogue: 0,0:11:06.00,0:11:09.17,Default,,0000,0000,0000,,Жерге жалғыз қайту мүмкін емес.
Dialogue: 0,0:11:09.17,0:11:12.17,Default,,0000,0000,0000,,Есіміңді Әсеби деп айттың ба?
Dialogue: 0,0:11:12.17,0:11:14.17,Default,,0000,0000,0000,,Бұл көше атауы.
Dialogue: 0,0:11:14.17,0:11:16.18,Default,,0000,0000,0000,,Олай болса...
Dialogue: 0,0:11:14.17,0:11:16.18,Default,,0000,0000,0000,,Изуцуми.
Dialogue: 0,0:11:16.18,0:11:19.35,Default,,0000,0000,0000,,Менің атым Изуцуми, есіңізде болсын.
Dialogue: 0,0:11:19.35,0:11:22.35,Default,,0000,0000,0000,,Пича Пича Пича….
Dialogue: 0,0:11:25.02,0:11:29.36,Default,,0000,0000,0000,,Хаа… Хаа… Хаа….
Dialogue: 0,0:11:29.36,0:11:33.36,Default,,0000,0000,0000,,⚟Райостар қашанға дейін
Dialogue: 0,0:11:29.36,0:11:33.36,Default,,0000,0000,0000,,Сіз осылай өмір сүргіңіз келе ме?
Dialogue: 0,0:11:33.36,0:11:36.86,Default,,0000,0000,0000,,Әке….
Dialogue: 0,0:11:33.36,0:11:36.86,Default,,0000,0000,0000,,Дұрыс өмір сүрудің уақыты келді.
Dialogue: 0,0:11:36.86,0:11:40.87,Default,,0000,0000,0000,,Айдаһарды өлтіру үшін
Dialogue: 0,0:11:36.86,0:11:40.87,Default,,0000,0000,0000,,Мен сені жіберген жоқпын.
Dialogue: 0,0:11:40.87,0:11:44.20,Default,,0000,0000,0000,,Ауылға қайт!
Dialogue: 0,0:11:40.87,0:11:44.20,Default,,0000,0000,0000,,Бірақ Фарин бар.
Dialogue: 0,0:11:44.20,0:11:46.71,Default,,0000,0000,0000,,Бұл туралы ұмытыңыз.
Dialogue: 0,0:11:44.20,0:11:46.71,Default,,0000,0000,0000,,(Мұғалім) О, қандай жаһандық көзқарас. (Цубаки) 《Уф! Сол сұм~》
Dialogue: 0,0:11:46.71,0:11:50.71,Default,,0000,0000,0000,,Сіз сияқты біреу
Dialogue: 0,0:11:46.71,0:11:50.71,Default,,0000,0000,0000,,Сіз сыртта жақсы жұмыс істей аламын деп ойлайсыз ба?
Dialogue: 0,0:11:50.71,0:11:54.21,Default,,0000,0000,0000,,Мектепте және әскерде
Dialogue: 0,0:11:50.71,0:11:54.21,Default,,0000,0000,0000,,Сыймай қашсам да.
Dialogue: 0,0:11:54.21,0:11:57.72,Default,,0000,0000,0000,,Сізде лабиринттерді зерттеу қабілеті жоқ.
Dialogue: 0,0:11:57.72,0:12:02.66,Default,,0000,0000,0000,,Дәл мен металлург болған кездегідей
Dialogue: 0,0:11:57.72,0:12:02.66,Default,,0000,0000,0000,,Достарыңа алданып, несиеңді тартып алу.
Dialogue: 0,0:12:02.66,0:12:05.66,Default,,0000,0000,0000,,Себебі сенде адамдарды көретін көзің жоқ.
Dialogue: 0,0:12:05.66,0:12:07.99,Default,,0000,0000,0000,,Мен үшін де солай.
Dialogue: 0,0:12:05.66,0:12:07.99,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:12:07.99,0:12:10.66,Default,,0000,0000,0000,,Сіз мен туралы айтып отырсыз
Dialogue: 0,0:12:07.99,0:12:10.66,Default,,0000,0000,0000,,Мен екеумізді жақын достар деп ойладым➡
Dialogue: 0,0:12:10.66,0:12:14.00,Default,,0000,0000,0000,,Мен саған әрқашан жаман болдым...
Dialogue: 0,0:12:10.66,0:12:14.00,Default,,0000,0000,0000,,Өте табанды!
Dialogue: 0,0:12:14.00,0:12:17.34,Default,,0000,0000,0000,,Бұл әңгіме...
Dialogue: 0,0:12:14.00,0:12:17.34,Default,,0000,0000,0000,,Жоқ, күте тұрыңыз ба?
Dialogue: 0,0:12:17.34,0:12:22.01,Default,,0000,0000,0000,,《Менің ата-анам неге мұнда?
Dialogue: 0,0:12:17.34,0:12:22.01,Default,,0000,0000,0000,,Бір-бірімізді көрмегенімізге 10 жылдан асты.
Dialogue: 0,0:12:22.01,0:12:25.51,Default,,0000,0000,0000,,Біріншіден, бұл қай жер?
Dialogue: 0,0:12:22.01,0:12:25.51,Default,,0000,0000,0000,,Сіз не істеп жүрсіз?
Dialogue: 0,0:12:25.51,0:12:27.51,Default,,0000,0000,0000,,Мен сенімдімін...》
Dialogue: 0,0:12:30.18,0:12:33.35,Default,,0000,0000,0000,,《Мен бұл күндері Марсиль туралы не айта аламын?
Dialogue: 0,0:12:33.35,0:12:36.36,Default,,0000,0000,0000,,Ол әбден шаршаған сияқты》
Dialogue: 0,0:12:36.36,0:12:40.19,Default,,0000,0000,0000,,｟Марсиль Бүгінгі сағат
Dialogue: 0,0:12:36.36,0:12:40.19,Default,,0000,0000,0000,,Біз мұны сіз үшін жасаймыз, сонда сіз демалыңыз.
Dialogue: 0,0:12:40.19,0:12:43.53,Default,,0000,0000,0000,,Не? Неліктен?
Dialogue: 0,0:12:40.19,0:12:43.53,Default,,0000,0000,0000,,Жарайды, солай.
Dialogue: 0,0:12:43.53,0:12:45.53,Default,,0000,0000,0000,,Жарайды, жарайды!
Dialogue: 0,0:12:45.53,0:12:48.37,Default,,0000,0000,0000,,Сәлем! Қазірдің өзінде ол не?
Dialogue: 0,0:12:48.37,0:12:52.71,Default,,0000,0000,0000,,Мен соншалықты шаршаған емеспін.
Dialogue: 0,0:12:48.37,0:12:52.71,Default,,0000,0000,0000,,Мен жақында оянамын!
Dialogue: 0,0:12:52.71,0:12:55.21,Default,,0000,0000,0000,,Тек мен... бірақ...｠
Dialogue: 0,0:12:55.21,0:12:57.54,Default,,0000,0000,0000,,《Бірақ ұйқы жақында келеді➡
Dialogue: 0,0:12:57.54,0:13:00.31,Default,,0000,0000,0000,,Дауыс қорқынышты дыбысқа айналды.
Dialogue: 0,0:12:57.54,0:13:00.31,Default,,0000,0000,0000,,｟Уау….
Dialogue: 0,0:13:00.31,0:13:03.98,Default,,0000,0000,0000,,Не болды, Марсиль?
Dialogue: 0,0:13:00.31,0:13:03.98,Default,,0000,0000,0000,,Бұл жай ғана нәрсе емес.
Dialogue: 0,0:13:03.98,0:13:07.82,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:13:03.98,0:13:07.82,Default,,0000,0000,0000,,Бұл құбыжық па?
Dialogue: 0,0:13:03.98,0:13:07.82,Default,,0000,0000,0000,,Иә, мүмкін Кобус.
Dialogue: 0,0:13:07.82,0:13:12.49,Default,,0000,0000,0000,,Ұйықтап жатқан адамға ие болыңыз
Dialogue: 0,0:13:07.82,0:13:12.49,Default,,0000,0000,0000,,қорқынышты түс көріп, эмоцияны жейді.
Dialogue: 0,0:13:12.49,0:13:16.50,Default,,0000,0000,0000,,Іс осылай жалғаса берсе, Марсиль болады
Dialogue: 0,0:13:12.49,0:13:16.50,Default,,0000,0000,0000,,Олар әлсіреп өледі.
Dialogue: 0,0:13:16.50,0:13:18.50,Default,,0000,0000,0000,,Оян, Марсиль!
Dialogue: 0,0:13:16.50,0:13:18.50,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:13:18.50,0:13:21.50,Default,,0000,0000,0000,,Егер сіз өзіңізді оятуға мәжбүрлесеңіз
Dialogue: 0,0:13:18.50,0:13:21.50,Default,,0000,0000,0000,,Психикалық тыртықтар.
Dialogue: 0,0:13:21.50,0:13:26.51,Default,,0000,0000,0000,,Бұрын Шро иеленген кезде
Dialogue: 0,0:13:21.50,0:13:26.51,Default,,0000,0000,0000,,Фарин түсіне кіріп, оны құтқарды.
Dialogue: 0,0:13:26.51,0:13:29.01,Default,,0000,0000,0000,,Сол әдісті қолданып көрейік.
Dialogue: 0,0:13:29.01,0:13:31.18,Default,,0000,0000,0000,,Сіз Марсильдің ішіндесіз бе?
Dialogue: 0,0:13:31.18,0:13:34.35,Default,,0000,0000,0000,,Біреу мұны түс деп айтты
Dialogue: 0,0:13:31.18,0:13:34.35,Default,,0000,0000,0000,,Мен сізді түсінуге мәжбүрлеуім керек.
Dialogue: 0,0:13:34.35,0:13:37.68,Default,,0000,0000,0000,,Армандаған адамды жастығыңдай пайдалан...
Dialogue: 0,0:13:37.68,0:13:41.69,Default,,0000,0000,0000,,Ммм... Ммм...｠
Dialogue: 0,0:13:41.69,0:13:45.02,Default,,0000,0000,0000,,♬
Dialogue: 0,0:13:45.02,0:13:48.86,Default,,0000,0000,0000,,《Иә!
Dialogue: 0,0:13:45.02,0:13:48.86,Default,,0000,0000,0000,,Марсильге көмектесу үшін...》
Dialogue: 0,0:13:48.86,0:13:51.36,Default,,0000,0000,0000,,Бұл менің түсімде!
Dialogue: 0,0:13:51.36,0:13:55.20,Default,,0000,0000,0000,,Кобус маған солай дәм татты.
Dialogue: 0,0:13:51.36,0:13:55.20,Default,,0000,0000,0000,,Әрқашан осылай.
Dialogue: 0,0:13:55.20,0:13:58.04,Default,,0000,0000,0000,,Шынымен де, адамдарға не ұнамайды
Dialogue: 0,0:13:55.20,0:13:58.04,Default,,0000,0000,0000,,Мен өте жақсы түсінемін.
Dialogue: 0,0:13:58.04,0:14:01.31,Default,,0000,0000,0000,,Бірақ!
Dialogue: 0,0:13:58.04,0:14:01.31,Default,,0000,0000,0000,,Оның арман екенін түсінгенде, бұл арман!
Dialogue: 0,0:14:01.31,0:14:04.11,Default,,0000,0000,0000,,Келіңіздер! Менің ең күшті қызметшім!
Dialogue: 0,0:14:07.65,0:14:09.65,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:14:09.65,0:14:12.82,Default,,0000,0000,0000,,《Енді, Марсильдің арманына кіру үшін...》
Dialogue: 0,0:14:12.82,0:14:15.32,Default,,0000,0000,0000,,Қазір ол менің басымның астында.
Dialogue: 0,0:14:15.32,0:14:18.62,Default,,0000,0000,0000,,Қанша уақыт күтуімді күтесің? Жылдам бол.
Dialogue: 0,0:14:15.32,0:14:18.62,Default,,0000,0000,0000,,Бар болғаны жерді қазып шығу керек.
Dialogue: 0,0:14:22.16,0:14:26.07,Default,,0000,0000,0000,,Бұл арманның жақсы жағы.
Dialogue: 0,0:14:22.16,0:14:26.07,Default,,0000,0000,0000,,Тек менің армандарым үшін.
Dialogue: 0,0:14:28.00,0:14:31.00,Default,,0000,0000,0000,,Уау! Уууу.
Dialogue: 0,0:14:31.00,0:14:35.34,Default,,0000,0000,0000,,Бұл қауіпті болды...
Dialogue: 0,0:14:31.00,0:14:35.34,Default,,0000,0000,0000,,Құлаған сезім мені оятып жібере жаздады.
Dialogue: 0,0:14:35.34,0:14:40.68,Default,,0000,0000,0000,,Бұл... Марсильдің түсінде.
Dialogue: 0,0:14:40.68,0:14:42.68,Default,,0000,0000,0000,,Бұл таңқаларлық.
Dialogue: 0,0:14:42.68,0:14:44.68,Default,,0000,0000,0000,,Онда біреу бар ма?
Dialogue: 0,0:14:42.68,0:14:44.68,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:14:44.68,0:14:49.36,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:14:44.68,0:14:49.36,Default,,0000,0000,0000,,Бұл жерде қауіпті, тез қашыңдар.
Dialogue: 0,0:14:49.36,0:14:51.86,Default,,0000,0000,0000,,Ма...Марсиль?
Dialogue: 0,0:14:49.36,0:14:51.86,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:14:51.86,0:14:53.86,Default,,0000,0000,0000,,А... сен кімсің?
Dialogue: 0,0:14:53.86,0:14:57.86,Default,,0000,0000,0000,,Бұл менмін! Бұл Лайос.
Dialogue: 0,0:14:53.86,0:14:57.86,Default,,0000,0000,0000,,Бұл сіздің арманыңызда!
Dialogue: 0,0:14:57.86,0:15:00.80,Default,,0000,0000,0000,,Енді оян...?
Dialogue: 0,0:15:00.80,0:15:03.97,Default,,0000,0000,0000,,Шайқау?
Dialogue: 0,0:15:00.80,0:15:03.97,Default,,0000,0000,0000,,А, ол келе жатыр.
Dialogue: 0,0:15:03.97,0:15:07.31,Default,,0000,0000,0000,,Мен қашуым керек.
Dialogue: 0,0:15:03.97,0:15:07.31,Default,,0000,0000,0000,,Ол кім?
Dialogue: 0,0:15:07.31,0:15:09.31,Default,,0000,0000,0000,,Жарайды, осылай!
Dialogue: 0,0:15:09.31,0:15:13.15,Default,,0000,0000,0000,,Хаха….
Dialogue: 0,0:15:09.31,0:15:13.15,Default,,0000,0000,0000,,｟Папа мен Пипи де онымен бірге
Dialogue: 0,0:15:09.31,0:15:13.15,Default,,0000,0000,0000,,Мені жұтып қойды｠
Dialogue: 0,0:15:13.15,0:15:15.31,Default,,0000,0000,0000,,《Папа мен Пипи….
Dialogue: 0,0:15:15.31,0:15:17.65,Default,,0000,0000,0000,,Бірдеңе қуған арман ба?
Dialogue: 0,0:15:17.65,0:15:20.65,Default,,0000,0000,0000,,Бұл кәдімгі, бірақ жағымсыз түс.
Dialogue: 0,0:15:20.65,0:15:22.82,Default,,0000,0000,0000,,Фарин екеніне сенімдімін...》
Dialogue: 0,0:15:22.82,0:15:26.16,Default,,0000,0000,0000,,｟Фарин: Қошмар
Dialogue: 0,0:15:22.82,0:15:26.16,Default,,0000,0000,0000,,Мен жүрек соғысын жақсы көремін.
Dialogue: 0,0:15:26.16,0:15:30.83,Default,,0000,0000,0000,,Стресс және жарақат
Dialogue: 0,0:15:26.16,0:15:30.83,Default,,0000,0000,0000,,Сол естеліктерді ынталандыру➡
Dialogue: 0,0:15:30.83,0:15:33.50,Default,,0000,0000,0000,,Адамдарға қорқынышты түс береді.
Dialogue: 0,0:15:33.50,0:15:36.67,Default,,0000,0000,0000,,Сол себепті жүрегімдегі жара
Dialogue: 0,0:15:33.50,0:15:36.67,Default,,0000,0000,0000,,Сіз оны қорғауыңыз керек.
Dialogue: 0,0:15:36.67,0:15:38.84,Default,,0000,0000,0000,,Эй.
Dialogue: 0,0:15:36.67,0:15:38.84,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:15:38.84,0:15:42.17,Default,,0000,0000,0000,,Бірақ оған еліктемеңіз, себебі бұл қауіпті.
Dialogue: 0,0:15:42.17,0:15:44.18,Default,,0000,0000,0000,,Жақсы! Түсінікті!
Dialogue: 0,0:15:44.18,0:15:46.51,Default,,0000,0000,0000,,Мен оны жеңемін!
Dialogue: 0,0:15:44.18,0:15:46.51,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:15:46.51,0:15:50.68,Default,,0000,0000,0000,,Не істеп жатырсың! ? Бұл қауіпті!
Dialogue: 0,0:15:46.51,0:15:50.68,Default,,0000,0000,0000,,Жарайды Жарайды.
Dialogue: 0,0:15:50.68,0:15:52.69,Default,,0000,0000,0000,,Осыған қарап, мен өте...
Dialogue: 0,0:15:57.02,0:15:59.02,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:15:57.02,0:15:59.02,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:15:59.02,0:16:01.03,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:16:02.96,0:16:04.96,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:16:04.96,0:16:07.97,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:16:04.96,0:16:07.97,Default,,0000,0000,0000,,Мен білмеймін!
Dialogue: 0,0:16:07.97,0:16:10.97,Default,,0000,0000,0000,,《Бұл Марсильдің қорқынышы ма...?
Dialogue: 0,0:16:10.97,0:16:13.47,Default,,0000,0000,0000,,біршама
Dialogue: 0,0:16:10.97,0:16:13.47,Default,,0000,0000,0000,,Бұл драмаландырылған сияқты➡
Dialogue: 0,0:16:13.47,0:16:17.14,Default,,0000,0000,0000,,Мен бұған сенімдімін
Dialogue: 0,0:16:13.47,0:16:17.14,Default,,0000,0000,0000,,Мен оны жеңу мүмкін емес сияқты.
Dialogue: 0,0:16:17.14,0:16:20.98,Default,,0000,0000,0000,,Егер адам түсін түсінсе
Dialogue: 0,0:16:17.14,0:16:20.98,Default,,0000,0000,0000,,Біз жау болмасақ та》
Dialogue: 0,0:16:20.98,0:16:23.82,Default,,0000,0000,0000,,Осы уақытқа дейін келген болсаңыз... а?
Dialogue: 0,0:16:23.82,0:16:26.32,Default,,0000,0000,0000,,Ешбір орын қауіпсіз емес.
Dialogue: 0,0:16:26.32,0:16:29.82,Default,,0000,0000,0000,,Маған ешкім қарсы тұра алмайды... Ах.
Dialogue: 0,0:16:29.82,0:16:31.82,Default,,0000,0000,0000,,Жарайды!
Dialogue: 0,0:16:31.82,0:16:34.83,Default,,0000,0000,0000,,Оны қалай жеңуге болатынын бірге ойланайық.
Dialogue: 0,0:16:34.83,0:16:39.50,Default,,0000,0000,0000,,《Марсиль қорқатын нәрсе ме...?
Dialogue: 0,0:16:34.83,0:16:39.50,Default,,0000,0000,0000,,Бұл құбыжық.
Dialogue: 0,0:16:39.50,0:16:45.17,Default,,0000,0000,0000,,Баяу жорғалау қозғалысы
Dialogue: 0,0:16:39.50,0:16:45.17,Default,,0000,0000,0000,,Оның сансыз шандырлары және ашкөздік тәбеті бар.
Dialogue: 0,0:16:45.17,0:16:48.84,Default,,0000,0000,0000,,Жиренішті көрінеді... Жәндікке ұқсайды ма?
Dialogue: 0,0:16:48.84,0:16:52.34,Default,,0000,0000,0000,,Дегенмен
Dialogue: 0,0:16:48.84,0:16:52.34,Default,,0000,0000,0000,,Жәндіктің соншалықты үлкен болуы қиын...
Dialogue: 0,0:16:52.34,0:16:54.85,Default,,0000,0000,0000,,Жәндік… Жәндік жәндік…》
Dialogue: 0,0:16:54.85,0:16:57.18,Default,,0000,0000,0000,,Түсіндім! Бұл құрт!
Dialogue: 0,0:16:54.85,0:16:57.18,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:16:57.18,0:16:59.69,Default,,0000,0000,0000,,Айдаһар тектес құрт!
Dialogue: 0,0:16:59.69,0:17:02.45,Default,,0000,0000,0000,,Аяқтар мен көздер нашарлайды
Dialogue: 0,0:16:59.69,0:17:02.45,Default,,0000,0000,0000,,Алып құрт тәрізді.
Dialogue: 0,0:17:02.45,0:17:05.29,Default,,0000,0000,0000,,Бірдеңе сараңдықпен өмір сүрсе
Dialogue: 0,0:17:02.45,0:17:05.29,Default,,0000,0000,0000,,Кез келген нәрсені жеңіз!
Dialogue: 0,0:17:05.29,0:17:07.29,Default,,0000,0000,0000,,Әлсіздік – от пен жарық!
Dialogue: 0,0:17:05.29,0:17:07.29,Default,,0000,0000,0000,,Бағана. ➡
Dialogue: 0,0:17:07.29,0:17:09.63,Default,,0000,0000,0000,,Бұл өте ащы.
Dialogue: 0,0:17:09.63,0:17:11.63,Default,,0000,0000,0000,,А... аа....
Dialogue: 0,0:17:09.63,0:17:11.63,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:17:13.63,0:17:15.63,Default,,0000,0000,0000,,Мен мұны білмей тұрып! ?
Dialogue: 0,0:17:15.63,0:17:17.64,Default,,0000,0000,0000,,Ия...!
Dialogue: 0,0:17:15.63,0:17:17.64,Default,,0000,0000,0000,,Құдай-ай.
Dialogue: 0,0:17:17.64,0:17:19.64,Default,,0000,0000,0000,,Қарғыс атсын... Қаш... Қаш!
Dialogue: 0,0:17:19.64,0:17:22.47,Default,,0000,0000,0000,,Ол саған қолын тигізді ме?
Dialogue: 0,0:17:22.47,0:17:26.31,Default,,0000,0000,0000,,Мен оны жаңа ғана тырнап алдым.
Dialogue: 0,0:17:22.47,0:17:26.31,Default,,0000,0000,0000,,Маған көрсет!
Dialogue: 0,0:17:26.31,0:17:30.15,Default,,0000,0000,0000,,Уау! Бұл не...
Dialogue: 0,0:17:26.31,0:17:30.15,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:17:30.15,0:17:32.15,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:17:32.15,0:17:35.85,Default,,0000,0000,0000,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:17:37.82,0:17:41.33,Default,,0000,0000,0000,,Уау….
Dialogue: 0,0:17:37.82,0:17:41.33,Default,,0000,0000,0000,,《Жаман! Қорқынышты қоздырды!
Dialogue: 0,0:17:41.33,0:17:44.16,Default,,0000,0000,0000,,Nightmare күші артады! 》
Dialogue: 0,0:17:44.16,0:17:46.17,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:17:48.33,0:17:50.34,Default,,0000,0000,0000,,《Қандай улы...
Dialogue: 0,0:17:50.34,0:17:52.67,Default,,0000,0000,0000,,Біреудің түсінде өлсең
Dialogue: 0,0:17:50.34,0:17:52.67,Default,,0000,0000,0000,,Не болады? 》
Dialogue: 0,0:17:52.67,0:17:54.67,Default,,0000,0000,0000,,Уау….
Dialogue: 0,0:17:52.67,0:17:54.67,Default,,0000,0000,0000,,《Жоқ.
Dialogue: 0,0:17:54.67,0:17:57.01,Default,,0000,0000,0000,,Егер сіз алаңдаушылық немесе қорқыныш сезінсеңіз
Dialogue: 0,0:17:54.67,0:17:57.01,Default,,0000,0000,0000,,Менің ойыма келгені осы ғана.
Dialogue: 0,0:17:57.01,0:17:59.01,Default,,0000,0000,0000,,Марсильді жігерлендіріңіз! 》
Dialogue: 0,0:17:59.01,0:18:02.11,Default,,0000,0000,0000,,Жарайды! Сізде сиқырлы күштер бар!
Dialogue: 0,0:18:02.11,0:18:09.79,Default,,0000,0000,0000,,Ол жігітті өзің жеңе алуың керек.
Dialogue: 0,0:18:02.11,0:18:09.79,Default,,0000,0000,0000,,Сиқыр...
Dialogue: 0,0:18:09.79,0:18:11.79,Default,,0000,0000,0000,,...
Dialogue: 0,0:18:11.79,0:18:14.29,Default,,0000,0000,0000,,《Өріс одан сайын тұрақсыз болады...
Dialogue: 0,0:18:14.29,0:18:17.30,Default,,0000,0000,0000,,Мен жаман нәрсе айттым ба? 》
Dialogue: 0,0:18:14.29,0:18:17.30,Default,,0000,0000,0000,,Мен...
Dialogue: 0,0:18:17.30,0:18:21.13,Default,,0000,0000,0000,,Мен оны жеңемін
Dialogue: 0,0:18:17.30,0:18:21.13,Default,,0000,0000,0000,,Сиқырды қолданғандықтан➡
Dialogue: 0,0:18:21.13,0:18:24.97,Default,,0000,0000,0000,,Бұл бала
Dialogue: 0,0:18:21.13,0:18:24.97,Default,,0000,0000,0000,,Мынадай көрінді.
Dialogue: 0,0:18:24.97,0:18:29.14,Default,,0000,0000,0000,,《Мына бала...мүмкін
Dialogue: 0,0:18:24.97,0:18:29.14,Default,,0000,0000,0000,,Бұл Фарин ба? ?
Dialogue: 0,0:18:29.14,0:18:32.64,Default,,0000,0000,0000,,Түсіндім!
Dialogue: 0,0:18:29.14,0:18:32.64,Default,,0000,0000,0000,,Сол реанимация техникасының арқасында Марсиль
Dialogue: 0,0:18:32.64,0:18:34.65,Default,,0000,0000,0000,,Фарин болған оқиғаға өкінеді.
Dialogue: 0,0:18:34.65,0:18:37.65,Default,,0000,0000,0000,,Оны жеңуге тырысу дегенді қалай түсінесіңдер?
Dialogue: 0,0:18:34.65,0:18:37.65,Default,,0000,0000,0000,,Басқаша айтқанда….
Dialogue: 0,0:18:37.65,0:18:40.65,Default,,0000,0000,0000,,Марсиль өлімнен қорқады! 》
Dialogue: 0,0:18:40.65,0:18:42.99,Default,,0000,0000,0000,,А... Мен тағы келдім. Ах.
Dialogue: 0,0:18:42.99,0:18:45.16,Default,,0000,0000,0000,,Сіз жай ғана қашып кете алмайсыз.
Dialogue: 0,0:18:45.16,0:18:47.99,Default,,0000,0000,0000,,Сіз тұруыңыз керек.
Dialogue: 0,0:18:45.16,0:18:47.99,Default,,0000,0000,0000,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:18:47.99,0:18:50.00,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:18:50.00,0:18:52.00,Default,,0000,0000,0000,,Қорқудың қажеті жоқ.
Dialogue: 0,0:18:50.00,0:18:52.00,Default,,0000,0000,0000,,Е, ә, ә! ?
Dialogue: 0,0:18:52.00,0:18:54.83,Default,,0000,0000,0000,,Бұл лабиринтте
Dialogue: 0,0:18:52.00,0:18:54.83,Default,,0000,0000,0000,,Өлсең де қайта тірілуге болады➡
Dialogue: 0,0:18:54.83,0:18:58.34,Default,,0000,0000,0000,,Тіпті Фарин, реанимация техникасының арқасында.
Dialogue: 0,0:18:54.83,0:18:58.34,Default,,0000,0000,0000,,Ол әлі тірі.
Dialogue: 0,0:18:58.34,0:19:00.77,Default,,0000,0000,0000,,Тіпті мәйіт
Dialogue: 0,0:18:58.34,0:19:00.77,Default,,0000,0000,0000,,Бұл таныс көрінді, солай ма?
Dialogue: 0,0:19:00.77,0:19:02.77,Default,,0000,0000,0000,,Ех! ?
Dialogue: 0,0:19:05.78,0:19:08.78,Default,,0000,0000,0000,,Ой... Тоқта... Мені сорып жатыр!
Dialogue: 0,0:19:08.78,0:19:12.12,Default,,0000,0000,0000,,Не? Жоқ, жоқ!
Dialogue: 0,0:19:08.78,0:19:12.12,Default,,0000,0000,0000,,О, мен ғана дем алып жатырмын! ?
Dialogue: 0,0:19:12.12,0:19:14.32,Default,,0000,0000,0000,,Күте тұрыңыз!
Dialogue: 0,0:19:16.29,0:19:18.29,Default,,0000,0000,0000,,《Ол улы емес...
Dialogue: 0,0:19:18.29,0:19:21.13,Default,,0000,0000,0000,,Мен тез қартайдым》
Dialogue: 0,0:19:21.13,0:19:24.96,Default,,0000,0000,0000,,Сәл күте тұршы, Марсиль, мен дем ала алмаймын...
Dialogue: 0,0:19:24.96,0:19:27.13,Default,,0000,0000,0000,,Хаа… Хаа… Хаа….
Dialogue: 0,0:19:24.96,0:19:27.13,Default,,0000,0000,0000,,《Бірдеңе дұрыс емес.
Dialogue: 0,0:19:27.13,0:19:29.97,Default,,0000,0000,0000,,Сіз мұны істей аласыз
Dialogue: 0,0:19:27.13,0:19:29.97,Default,,0000,0000,0000,,Тірі заттар бар ма?
Dialogue: 0,0:19:29.97,0:19:32.47,Default,,0000,0000,0000,,Ол басқа суреттерде де бар емес пе?
Dialogue: 0,0:19:29.97,0:19:32.47,Default,,0000,0000,0000,,Бұл тірі зат болмауы мүмкін》
Dialogue: 0,0:19:32.47,0:19:35.31,Default,,0000,0000,0000,,Сен де маған
Dialogue: 0,0:19:32.47,0:19:35.31,Default,,0000,0000,0000,,Менімен бірге келмейсің бе?
Dialogue: 0,0:19:35.31,0:19:38.31,Default,,0000,0000,0000,,Жоқ, сәл демалғаннан кейін.
Dialogue: 0,0:19:35.31,0:19:38.31,Default,,0000,0000,0000,,Өйткені мен қайтадан жүгіре аламын.
Dialogue: 0,0:19:38.31,0:19:41.65,Default,,0000,0000,0000,,Өтірік! Барлығы
Dialogue: 0,0:19:38.31,0:19:41.65,Default,,0000,0000,0000,,Менімен жүгіруден бас тарт➡
Dialogue: 0,0:19:41.65,0:19:43.65,Default,,0000,0000,0000,,Мен оны жұтып қоямын!
Dialogue: 0,0:19:43.65,0:19:47.15,Default,,0000,0000,0000,,Папа, Пипи, Фарин, бәріңіз!
Dialogue: 0,0:19:47.15,0:19:50.32,Default,,0000,0000,0000,,Сонымен, мен
Dialogue: 0,0:19:47.15,0:19:50.32,Default,,0000,0000,0000,,Мен сиқырды көп оқыдым!
Dialogue: 0,0:19:50.32,0:19:53.83,Default,,0000,0000,0000,,Бұл Фарин
Dialogue: 0,0:19:50.32,0:19:53.83,Default,,0000,0000,0000,,Егер сіз осылай көрінетін болсаңыз➡
Dialogue: 0,0:19:53.83,0:19:57.66,Default,,0000,0000,0000,,Мен не істеуім керек?
Dialogue: 0,0:19:57.66,0:20:04.34,Default,,0000,0000,0000,,Әкең жастай қайтыс болды ма?
Dialogue: 0,0:19:57.66,0:20:04.34,Default,,0000,0000,0000,,Әкемнің жерлеу рәсімінде анам айтты.
Dialogue: 0,0:20:04.34,0:20:08.01,Default,,0000,0000,0000,,Мен барлығымен біргемін
Dialogue: 0,0:20:04.34,0:20:08.01,Default,,0000,0000,0000,,Олар әртүрлі жылдамдықпен жүгіретінін айтады.
Dialogue: 0,0:20:08.01,0:20:12.84,Default,,0000,0000,0000,,Мен көп адамды қолдаймын
Dialogue: 0,0:20:08.01,0:20:12.84,Default,,0000,0000,0000,,Мен сені шығарып салуым керек.
Dialogue: 0,0:20:12.84,0:20:15.51,Default,,0000,0000,0000,,Айтпақшы, Пипи туыс па?
Dialogue: 0,0:20:15.51,0:20:18.52,Default,,0000,0000,0000,,Бұл құс.
Dialogue: 0,0:20:15.51,0:20:18.52,Default,,0000,0000,0000,,《Мен түсіндім.
Dialogue: 0,0:20:18.52,0:20:21.35,Default,,0000,0000,0000,,Марсиль өлімнен қорқады
Dialogue: 0,0:20:18.52,0:20:21.35,Default,,0000,0000,0000,,Жоқ.
Dialogue: 0,0:20:21.35,0:20:25.06,Default,,0000,0000,0000,,Сізге жақын адам
Dialogue: 0,0:20:21.35,0:20:25.06,Default,,0000,0000,0000,,Сіздің алдыңызда өлуден қорқу
Dialogue: 0,0:20:31.03,0:20:33.20,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:20:31.03,0:20:33.20,Default,,0000,0000,0000,,Марсиль! Тыныштал!
Dialogue: 0,0:20:33.20,0:20:36.20,Default,,0000,0000,0000,,Қорыққан сайын
Dialogue: 0,0:20:33.20,0:20:36.20,Default,,0000,0000,0000,,Оның құдіреті тек артады!
Dialogue: 0,0:20:36.20,0:20:39.04,Default,,0000,0000,0000,,Мен осылай дедім
Dialogue: 0,0:20:36.20,0:20:39.04,Default,,0000,0000,0000,,Мен не істеуім керек?
Dialogue: 0,0:20:39.04,0:20:42.21,Default,,0000,0000,0000,,Мен ештеңе істей алмаймын!
Dialogue: 0,0:20:39.04,0:20:42.21,Default,,0000,0000,0000,,Жоқ, мүмкін! Өйткені➡
Dialogue: 0,0:20:42.21,0:20:44.21,Default,,0000,0000,0000,,Марсиль керемет!
Dialogue: 0,0:20:44.21,0:20:46.71,Default,,0000,0000,0000,,Қараңдар! Кітап саны!
Dialogue: 0,0:20:44.21,0:20:46.71,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:20:46.71,0:20:49.72,Default,,0000,0000,0000,,Түсімде
Dialogue: 0,0:20:46.71,0:20:49.72,Default,,0000,0000,0000,,Ештеңе болмады!
Dialogue: 0,0:20:49.72,0:20:52.38,Default,,0000,0000,0000,,Сіз әрқашан болдыңыз
Dialogue: 0,0:20:49.72,0:20:52.38,Default,,0000,0000,0000,,Сіз тырыса бердіңіз, солай ма?
Dialogue: 0,0:20:52.38,0:20:55.39,Default,,0000,0000,0000,,Көңіліңізді түсірмеңіз!
Dialogue: 0,0:20:52.38,0:20:55.39,Default,,0000,0000,0000,,Өзіңізге сенімді болыңыз!
Dialogue: 0,0:20:55.39,0:20:57.39,Default,,0000,0000,0000,,Сәттілік! Марсиль!
Dialogue: 0,0:20:57.39,0:21:01.83,Default,,0000,0000,0000,,Маған ұнамайды, тұр.
Dialogue: 0,0:20:57.39,0:21:01.83,Default,,0000,0000,0000,,Ендеше қашайық! Бірінші орында➡
Dialogue: 0,0:21:01.83,0:21:04.66,Default,,0000,0000,0000,,Менің сиқырым жетілмеген!
Dialogue: 0,0:21:04.66,0:21:07.67,Default,,0000,0000,0000,,Кітап сол балада болса➡
Dialogue: 0,0:21:07.67,0:21:10.67,Default,,0000,0000,0000,,Мен мінсізмін
Dialogue: 0,0:21:07.67,0:21:10.67,Default,,0000,0000,0000,,Мен сиқырды қолдана аламын.
Dialogue: 0,0:21:10.67,0:21:12.84,Default,,0000,0000,0000,,Олай болса солай үміттенейік!
Dialogue: 0,0:21:10.67,0:21:12.84,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:21:12.84,0:21:15.51,Default,,0000,0000,0000,,Егер сіз қатты қаласаңыз, бәрі мүмкін!
Dialogue: 0,0:21:15.51,0:21:18.51,Default,,0000,0000,0000,,Қорықпа!
Dialogue: 0,0:21:15.51,0:21:18.51,Default,,0000,0000,0000,,Келесі жолы жақсы болатыныңызға сенімдімін!
Dialogue: 0,0:21:18.51,0:21:20.85,Default,,0000,0000,0000,,Берілме...
Dialogue: 0,0:21:18.51,0:21:20.85,Default,,0000,0000,0000,,(Косей) «Мен музыка дайындау бөлмесіне келсем, сені көремін деп ойладым.»
Dialogue: 0,0:21:20.85,0:21:23.52,Default,,0000,0000,0000,,Маған ұнамайды! Мен оны ұнатпаймын! Мен оны ұнатпаймын! Мен оны ұнатпаймын!
Dialogue: 0,0:21:23.52,0:21:25.52,Default,,0000,0000,0000,,Мен оны жек көремін!
Dialogue: 0,0:21:31.52,0:21:33.53,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:21:33.53,0:21:36.36,Default,,0000,0000,0000,,Иә, Марсиль! Бар!
Dialogue: 0,0:21:36.36,0:21:38.36,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:21:38.36,0:21:46.71,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:21:46.71,0:21:50.61,Default,,0000,0000,0000,,Сіз оны осылай пайдаланасыз ба?
Dialogue: 0,0:21:52.54,0:21:55.38,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:21:52.54,0:21:55.38,Default,,0000,0000,0000,,О, ояусың ба?
Dialogue: 0,0:21:55.38,0:21:58.22,Default,,0000,0000,0000,,Бәріміз бірге қуандық.
Dialogue: 0,0:21:55.38,0:21:58.22,Default,,0000,0000,0000,,Амансың ба?
Dialogue: 0,0:21:58.22,0:22:03.32,Default,,0000,0000,0000,,Мен жақсы есімде жоқ...
Dialogue: 0,0:21:58.22,0:22:03.32,Default,,0000,0000,0000,,Шаршаған түс көргендей болдым.
Dialogue: 0,0:22:03.32,0:22:05.32,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:22:05.32,0:22:08.16,Default,,0000,0000,0000,,А... Мм...
Dialogue: 0,0:22:08.16,0:22:11.33,Default,,0000,0000,0000,,Мен қайтадан ұйықтаймын!
Dialogue: 0,0:22:08.16,0:22:11.33,Default,,0000,0000,0000,,Жоқ! Оян, Марсиль!
Dialogue: 0,0:22:11.33,0:22:13.33,Default,,0000,0000,0000,,Сіз жақсысыз ба?
Dialogue: 0,0:22:13.33,0:22:15.67,Default,,0000,0000,0000,,Мен шынымен есімде жоқ.
Dialogue: 0,0:22:15.67,0:22:18.50,Default,,0000,0000,0000,,Біршама жағымды арман
Dialogue: 0,0:22:15.67,0:22:18.50,Default,,0000,0000,0000,,Мен көрдім деп ойлаймын.
Dialogue: 0,0:22:18.50,0:22:21.67,Default,,0000,0000,0000,,Бұл сәтті болған сияқты.
Dialogue: 0,0:22:18.50,0:22:21.67,Default,,0000,0000,0000,,«Оның аман-есен жетуін қамтамасыз етші.»
Dialogue: 0,0:22:21.67,0:22:24.08,Default,,0000,0000,0000,,Маған жастық беріңізші.
Dialogue: 0,0:22:21.67,0:22:24.08,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:22:26.01,0:22:29.68,Default,,0000,0000,0000,,Иә! ?
Dialogue: 0,0:22:26.01,0:22:29.68,Default,,0000,0000,0000,,Шабуыл
Dialogue: 0,0:22:26.01,0:22:29.68,Default,,0000,0000,0000,,Бұл кошмар.
Dialogue: 0,0:22:29.68,0:22:34.19,Default,,0000,0000,0000,,Мына жігіт адамдардың жастығына тығылып отыр.
Dialogue: 0,0:22:29.68,0:22:34.19,Default,,0000,0000,0000,,Бұл маған қорқынышты түс береді.
Dialogue: 0,0:22:34.19,0:22:36.52,Default,,0000,0000,0000,,Бұл әлі де үлкен сома.
Dialogue: 0,0:22:36.52,0:22:38.86,Default,,0000,0000,0000,,Баяғыда
Dialogue: 0,0:22:36.52,0:22:38.86,Default,,0000,0000,0000,,Жастыққа тығылып жатқан шығар.
Dialogue: 0,0:22:38.86,0:22:41.69,Default,,0000,0000,0000,,Өтірік….
Dialogue: 0,0:22:38.86,0:22:41.69,Default,,0000,0000,0000,,Сенши, мынаны жесем болады ма?
Dialogue: 0,0:22:41.69,0:22:45.53,Default,,0000,0000,0000,,Мен әрқашан дәмге қызығатынмын.
Dialogue: 0,0:22:41.69,0:22:45.53,Default,,0000,0000,0000,,О, әрине.
Dialogue: 0,0:22:45.53,0:22:49.20,Default,,0000,0000,0000,,Алдымен қоқысты түкіртейік.
Dialogue: 0,0:22:49.20,0:22:53.21,Default,,0000,0000,0000,,Оны біраз уақыт ыстық суға салып қойыңыз.
Dialogue: 0,0:22:49.20,0:22:53.21,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:22:53.21,0:22:57.88,Default,,0000,0000,0000,,Бұл түнгі түн Шин деп те аталады.
Dialogue: 0,0:22:53.21,0:22:57.88,Default,,0000,0000,0000,,Негізінде бұл айдаһар тұқымдасының мүшесі.
Dialogue: 0,0:22:57.88,0:23:01.31,Default,,0000,0000,0000,,Мұқият қарасаңыз, айдаһарға ұқсайды, солай ма?
Dialogue: 0,0:22:57.88,0:23:01.31,Default,,0000,0000,0000,,Бұл өтірік емес пе?
Dialogue: 0,0:23:01.31,0:23:05.32,Default,,0000,0000,0000,,《Sensi: еріген сары майдың үстіне
Dialogue: 0,0:23:01.31,0:23:05.32,Default,,0000,0000,0000,,Қобалжыған түстерді сапқа қойыңыз➡
Dialogue: 0,0:23:05.32,0:23:07.82,Default,,0000,0000,0000,,Шарап қосып, жабыңыз
Dialogue: 0,0:23:11.16,0:23:14.16,Default,,0000,0000,0000,,《Соңында аздап
Dialogue: 0,0:23:11.16,0:23:14.16,Default,,0000,0000,0000,,Соя соусын тамызыңыз...》
Dialogue: 0,0:23:14.16,0:23:16.16,Default,,0000,0000,0000,,Аяқталды! ау.
Dialogue: 0,0:23:16.16,0:23:19.16,Default,,0000,0000,0000,,О? бұл….
Dialogue: 0,0:23:19.16,0:23:21.50,Default,,0000,0000,0000,,А, бұл менмін!
Dialogue: 0,0:23:21.50,0:23:24.84,Default,,0000,0000,0000,,Қошмар жеген түс
Dialogue: 0,0:23:21.50,0:23:24.84,Default,,0000,0000,0000,,Сағымға айналды.
Dialogue: 0,0:23:24.84,0:23:27.51,Default,,0000,0000,0000,,Мүмкін есімде бірдеңе бар шығар.
Dialogue: 0,0:23:27.51,0:23:32.34,Default,,0000,0000,0000,,Дұрыс, егер мен бір нәрседен қашып жүрсем
Dialogue: 0,0:23:27.51,0:23:32.34,Default,,0000,0000,0000,,Бір ит шықты.
Dialogue: 0,0:23:32.34,0:23:36.85,Default,,0000,0000,0000,,Бала мен қазынаны іздеу
Dialogue: 0,0:23:32.34,0:23:36.85,Default,,0000,0000,0000,,Шытырман оқиғаға бару!
Dialogue: 0,0:23:36.85,0:23:39.18,Default,,0000,0000,0000,,Бұл қызық түс болды.
Dialogue: 0,0:23:39.18,0:23:42.85,Default,,0000,0000,0000,,Қандай лас ит.
Dialogue: 0,0:23:39.18,0:23:42.85,Default,,0000,0000,0000,,Ақыл-ойы жоқ сияқты.
Dialogue: 0,0:23:42.85,0:23:44.86,Default,,0000,0000,0000,,Не болды, Лайос?
Dialogue: 0,0:23:44.86,0:23:48.69,Default,,0000,0000,0000,,Менің есімде қалғаны, күміс қасқыр болуы керек еді.
Dialogue: 0,0:23:48.69,0:23:52.03,Default,,0000,0000,0000,,Жақсы, жақсы түс
