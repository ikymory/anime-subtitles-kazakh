Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.50,0:00:03.50,Default,,0,0,0,,♪～
Dialogue: 0,0:01:28.92,0:01:30.92,Default,,0,0,0,,～♪
Dialogue: 0,0:01:35.13,0:01:37.38,Default,,0,0,0,,Мен Рух патшасының орнын аламын.
Dialogue: 0,0:01:37.88,0:01:39.72,Default,,0,0,0,,Мұндай нәрсе...
Dialogue: 0,0:01:40.30,0:01:41.51,Default,,0,0,0,,Түсіндірме кейінірек келеді
Dialogue: 0,0:01:49.77,0:01:50.90,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:50.98,0:01:52.07,Default,,0,0,0,,Міне!
Dialogue: 0,0:01:52.15,0:01:53.53,Default,,0,0,0,,Сол бір кездей…
Dialogue: 0,0:01:53.61,0:01:55.24,Default,,0,0,0,,Капитан Укитаке...
Dialogue: 0,0:02:00.20,0:02:02.41,Default,,0,0,0,,Құрметті Мимихаги Құрметті Мимихаги
Dialogue: 0,0:02:02.49,0:02:04.62,Default,,0,0,0,,Көзіңнің қуатын аш
Dialogue: 0,0:02:04.70,0:02:06.96,Default,,0,0,0,,Жүрегімде Үзұмеші Көздің құдіреті
Dialogue: 0,0:02:07.04,0:02:09.33,Default,,0,0,0,,Менің түсінігімнен бас тартып, оны ашыңыз.
Dialogue: 0,0:02:09.42,0:02:11.84,Default,,0,0,0,,Құрметті Мимихаги Құрметті Мимихаги
Dialogue: 0,0:02:11.92,0:02:14.21,Default,,0,0,0,,Жүрегім, жейтін дертті өлтір
Dialogue: 0,0:02:14.30,0:02:16.51,Default,,0,0,0,,Керісінше, оны пайдаланыңыз.
Dialogue: 0,0:02:16.59,0:02:18.97,Default,,0,0,0,,Құрметті Мимихаги Құрметті Мимихаги
Dialogue: 0,0:02:19.05,0:02:20.76,Default,,0,0,0,,Құдайдың қолы көктен түсті
Dialogue: 0,0:02:20.84,0:02:23.35,Default,,0,0,0,,Маған көзіңнің күшін бер
Dialogue: 0,0:02:23.85,0:02:25.89,Default,,0,0,0,,Құрметті Мимихаги Құрметті Мимихаги
Dialogue: 0,0:02:25.97,0:02:28.18,Default,,0,0,0,,Жүрегім, жейтін дертті өлтір
Dialogue: 0,0:02:28.27,0:02:30.65,Default,,0,0,0,,Керісінше, оны пайдаланыңыз.
Dialogue: 0,0:02:30.73,0:02:33.06,Default,,0,0,0,,Құрметті Мимихаги Құрметті Мимихаги
Dialogue: 0,0:02:33.15,0:02:35.23,Default,,0,0,0,,Құдайдың қолы көктен түсті
Dialogue: 0,0:02:35.32,0:02:37.65,Default,,0,0,0,,Маған көзіңнің күшін бер
Dialogue: 0,0:02:37.74,0:02:40.11,Default,,0,0,0,,Құрметті Мимихаги Құрметті Мимихаги
Dialogue: 0,0:02:40.20,0:02:42.32,Default,,0,0,0,,Менің жүрегім жейтін ауруды өлтіреді
Dialogue: 0,0:02:42.41,0:02:43.91,Default,,0,0,0,,Керісінше, оны пайдаланыңыз.
Dialogue: 0,0:02:46.16,0:02:47.41,Default,,0,0,0,,Джуширо!
Dialogue: 0,0:02:48.87,0:02:50.79,Default,,0,0,0,,Маған көзіңнің күшін бер
Dialogue: 0,0:02:53.13,0:02:55.67,Default,,0,0,0,,Мимихаги-сама, өтінемін, мына балаға қамқор болыңыз...
Dialogue: 0,0:02:55.75,0:02:57.46,Default,,0,0,0,,Джушироны құтқарыңыз!
Dialogue: 0,0:02:57.96,0:03:01.38,Default,,0,0,0,,Осы үш жасар кішкентай балаға өмір қуанышын сыйла...
Dialogue: 0,0:03:01.89,0:03:02.80,Default,,0,0,0,,Өтінемін!
Dialogue: 0,0:03:02.89,0:03:05.68,Default,,0,0,0,,Джусиро, кешіріңіз.
Dialogue: 0,0:03:06.22,0:03:08.31,Default,,0,0,0,,Мен сені сау босана алмадым.
Dialogue: 0,0:03:08.39,0:03:10.06,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:03:10.69,0:03:14.69,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:03:15.36,0:03:18.61,Default,,0,0,0,,Ана... жылама
Dialogue: 0,0:03:46.43,0:03:47.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:04.74,0:04:05.49,Default,,0,0,0,,Мен шайқаса аламын!
Dialogue: 0,0:04:25.89,0:04:27.01,Default,,0,0,0,,Ха!
Dialogue: 0,0:04:27.10,0:04:28.97,Default,,0,0,0,,Ах... Джусиро!
Dialogue: 0,0:04:29.06,0:04:30.18,Default,,0,0,0,,Ха!
Dialogue: 0,0:04:33.31,0:04:35.65,Default,,0,0,0,,Ах... Джусиро
Dialogue: 0,0:04:35.73,0:04:38.11,Default,,0,0,0,,(Ата-ананың жылауы)
Dialogue: 0,0:04:38.19,0:04:39.65,Default,,0,0,0,,Сол дауылды түн
Dialogue: 0,0:04:39.73,0:04:43.86,Default,,0,0,0,,Менің өмірім Мимихаги-самамен байланысты болды.
Dialogue: 0,0:04:45.86,0:04:47.24,Default,,0,0,0,,(Балалардың күлкісі)
Dialogue: 0,0:04:47.32,0:04:48.37,Default,,0,0,0,,Хехехе
Dialogue: 0,0:04:49.33,0:04:51.29,Default,,0,0,0,,А, сәлем
Dialogue: 0,0:04:51.37,0:04:52.08,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:52.16,0:04:54.33,Default,,0,0,0,,Қайда жүріп, қарап отырсың, қарт қаңбақ!
Dialogue: 0,0:04:55.12,0:04:57.96,Default,,0,0,0,,Маған соқтығыстың, кешірім де сұрамадың ба?
Dialogue: 0,0:04:58.04,0:05:01.05,Default,,0,0,0,,Жеңдеріміз бір-біріне тиіп кетпеді ме?
Dialogue: 0,0:05:01.13,0:05:03.17,Default,,0,0,0,,Менен бас тартпа.
Dialogue: 0,0:05:03.26,0:05:04.72,Default,,0,0,0,,Не?
Dialogue: 0,0:05:06.13,0:05:07.80,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:05:08.59,0:05:09.80,Default,,0,0,0,,Бұл кім? Теми
Dialogue: 0,0:05:09.89,0:05:11.85,Default,,0,0,0,,Сіз кемпірді қорғауға тырысасыз ба?
Dialogue: 0,0:05:11.93,0:05:12.52,Default,,0,0,0,,Аһ!
Dialogue: 0,0:05:12.60,0:05:13.47,Default,,0,0,0,,Арманым үшін.
Dialogue: 0,0:05:14.06,0:05:14.98,Default,,0,0,0,,Мен шайқаса аламын!
Dialogue: 0,0:05:17.06,0:05:20.27,Default,,0,0,0,,Қартайғаныңыз ақсақ деген сөз емес.
Dialogue: 0,0:05:22.07,0:05:25.45,Default,,0,0,0,,Амансың ба? Сондықтан мен жарайды дедім.
Dialogue: 0,0:05:25.53,0:05:28.91,Default,,0,0,0,,Ойоне-сан осы жерде танымал.
Dialogue: 0,0:05:28.99,0:05:30.91,Default,,0,0,0,,Сізде энергия көп.
Dialogue: 0,0:05:31.62,0:05:34.12,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:05:34.20,0:05:36.54,Default,,0,0,0,,Келесі кездескенімізде, мен сені міндетті түрде үрлеймін.
Dialogue: 0,0:05:36.62,0:05:37.87,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:05:38.37,0:05:42.59,Default,,0,0,0,,Егер сізде қосымша күш болса, менімен бірге Мао рухани академиясына келіңіз.
Dialogue: 0,0:05:42.67,0:05:44.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:44.09,0:05:46.05,Default,,0,0,0,,Егер сіз Готей корпусының қызметкері болсаңыз
Dialogue: 0,0:05:46.13,0:05:49.72,Default,,0,0,0,,Жабайы болсаң, ақша аласың, жұрт сені бағалайды.
Dialogue: 0,0:05:49.80,0:05:51.10,Default,,0,0,0,,Бір оқпен екі құсты өлтіру, солай ма?
Dialogue: 0,0:05:51.18,0:05:53.26,Default,,0,0,0,,Жолдан кет!
Dialogue: 0,0:05:53.89,0:05:54.47,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:57.19,0:05:59.15,Default,,0,0,0,,Мен Джусиро Укитакемін
Dialogue: 0,0:05:59.65,0:06:00.48,Default,,0,0,0,,'Ол да сондай.'
Dialogue: 0,0:06:01.40,0:06:02.69,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:02.77,0:06:04.94,Default,,0,0,0,,... Жібер!
Dialogue: 0,0:06:07.36,0:06:08.74,Default,,0,0,0,,Есте сақтау
Dialogue: 0,0:06:09.24,0:06:11.32,Default,,0,0,0,,Иә, мен мұны есімде сақтаймын.
Dialogue: 0,0:06:11.41,0:06:12.37,Default,,0,0,0,,Жақында кездескенше
Dialogue: 0,0:06:14.41,0:06:15.12,Default,,0,0,0,,Қандай жағымсыз иіс! Тамағымның арты ұстап, ауырып барады.
Dialogue: 0,0:06:28.34,0:06:31.55,Default,,0,0,0,,Өзіңізді қатты итермеңіз.
Dialogue: 0,0:06:32.05,0:06:33.26,Default,,0,0,0,,Укитаке
Dialogue: 0,0:06:39.85,0:06:40.65,Default,,0,0,0,,Кейде көңіл көтеру керек қой…
Dialogue: 0,0:06:48.49,0:06:50.82,Default,,0,0,0,,Бұл жақсы қылыш шеберлігі.
Dialogue: 0,0:06:50.91,0:06:54.70,Default,,0,0,0,,Әлі жастықта, көретін көп нәрсе бар.
Dialogue: 0,0:06:57.12,0:06:57.62,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:07:07.88,0:07:08.38,Default,,0,0,0,,Ал ең бастысы, Иносукэ, өзің қалайсың?
Dialogue: 0,0:07:12.26,0:07:13.18,Default,,0,0,0,,Біз жындан жаңа мәлімет алдық.
Dialogue: 0,0:07:17.89,0:07:19.43,Default,,0,0,0,,Мұны істеме, сен
Dialogue: 0,0:07:20.10,0:07:23.06,Default,,0,0,0,,Науқасқа аяусызсың.
Dialogue: 0,0:07:23.69,0:07:25.57,Default,,0,0,0,,Мен Джусиро Укитакемін
Dialogue: 0,0:07:25.65,0:07:27.32,Default,,0,0,0,,Кйораку Шунсуй
Dialogue: 0,0:07:27.40,0:07:28.73,Default,,0,0,0,,Мені сүюге тиіс еді! Мені сүюге тиіс!
Dialogue: 0,0:07:28.82,0:07:29.94,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:07:30.03,0:07:34.32,Default,,0,0,0,,Сабақ үстінде сен маған үнемі құмарлана қарайсың.
Dialogue: 0,0:07:34.41,0:07:36.95,Default,,0,0,0,,Хахаха, білдің бе?
Dialogue: 0,0:07:37.66,0:07:40.54,Default,,0,0,0,,Негізі саған айтар сөзім бар.
Dialogue: 0,0:07:41.16,0:07:41.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:44.38,0:07:47.21,Default,,0,0,0,,Мен оның Монака екеніне сене алар емеспін.
Dialogue: 0,0:07:47.30,0:07:50.21,Default,,0,0,0,,Маған сені қыздармен таныстыруды өтінсе де.
Dialogue: 0,0:07:50.30,0:07:53.05,Default,,0,0,0,,Шай мен тәттілер дүкені туралы бірінші рет сұрап отыр.
Dialogue: 0,0:07:54.51,0:07:56.76,Default,,0,0,0,,Өйткені сіз әрқашан рахаттанып тамақтанасыз
Dialogue: 0,0:07:56.85,0:07:58.10,Default,,0,0,0,,Мен қызық болдым.
Dialogue: 0,0:07:58.18,0:08:01.06,Default,,0,0,0,,Мұнда ортада саке лиз бар.
Dialogue: 0,0:08:01.14,0:08:02.94,Default,,0,0,0,,Не? Саке Лис?
Dialogue: 0,0:08:03.02,0:08:04.40,Default,,0,0,0,,Мәселе бар ма?
Dialogue: 0,0:08:05.06,0:08:06.11,Default,,0,0,0,,Керемет!
Dialogue: 0,0:08:07.02,0:08:07.57,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:07.65,0:08:10.07,Default,,0,0,0,,- (інілері) Үлкен аға! -(Әпкелер) Бауырым!
Dialogue: 0,0:08:10.15,0:08:11.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:13.03,0:08:14.91,Default,,0,0,0,,Ия, мен оның ортасындамын!
Dialogue: 0,0:08:14.99,0:08:17.33,Default,,0,0,0,,Ал... бұл балалар үшін улы!
Dialogue: 0,0:08:17.41,0:08:20.58,Default,,0,0,0,,- (Шунсуй) А... бұл өте жаман - (Үкітаке) Сондықтан жақсы емес.
Dialogue: 0,0:08:31.92,0:08:33.63,Default,,0,0,0,,Мен сенің көргеніңді қалаймын.
Dialogue: 0,0:08:37.09,0:08:37.89,Default,,0,0,0,,Бұл...
Dialogue: 0,0:08:38.93,0:08:43.23,Default,,0,0,0,,Руконгай ауданы Сакабонада 76 байырғы құдайлар қайтыс болды
Dialogue: 0,0:08:43.73,0:08:44.89,Default,,0,0,0,,Бұл Мимихаги-сама.
Dialogue: 0,0:08:44.98,0:08:48.65,Default,,0,0,0,,Құрметті Мимихаги... Бұл шынымен де болды.
Dialogue: 0,0:08:49.61,0:08:50.69,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:08:51.19,0:08:54.78,Default,,0,0,0,,Аға ақсүйектер арасында қауесет бар.
Dialogue: 0,0:08:55.28,0:09:00.49,Default,,0,0,0,,Баяғыда Рухани Патшадан бөлінген күш жерге түскен сияқты.
Dialogue: 0,0:09:00.58,0:09:02.50,Default,,0,0,0,,Рух патшасының күші...
Dialogue: 0,0:09:02.58,0:09:07.58,Default,,0,0,0,,Біртүрлі екен, солай емес пе? Рух Патшасы Рух Патша сарайында.
Dialogue: 0,0:09:08.08,0:09:10.42,Default,,0,0,0,,Бірақ мына Мимихаги-саманы қараңыз.
Dialogue: 0,0:09:10.50,0:09:13.76,Default,,0,0,0,,Мен қауесеттер рас болуы мүмкін сияқты сезіне бастадым.
Dialogue: 0,0:09:14.34,0:09:15.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:15.22,0:09:19.64,Default,,0,0,0,,Қараңдаршы, мына мүсіннің көз алмасына көңілім ауып барады.
Dialogue: 0,0:09:19.72,0:09:20.85,Default,,0,0,0,,Пішін...
Dialogue: 0,0:09:22.35,0:09:24.02,Default,,0,0,0,,Рух Патшасының денесінде
Dialogue: 0,0:09:24.10,0:09:27.14,Default,,0,0,0,,Түрлі жеңілдіктер бар сияқты.
Dialogue: 0,0:09:27.23,0:09:30.52,Default,,0,0,0,,Сол қол «алға қозғалысты» басқарады
Dialogue: 0,0:09:30.61,0:09:32.53,Default,,0,0,0,,Оң қолмен басқару...
Dialogue: 0,0:09:32.61,0:09:34.78,Default,,0,0,0,,«Стационарлық»?
Dialogue: 0,0:09:34.86,0:09:36.99,Default,,0,0,0,,Иә? Сіз білдіңіз бе?
Dialogue: 0,0:09:38.66,0:09:40.32,Default,,0,0,0,,Бірақ мен оны білдім.
Dialogue: 0,0:09:40.83,0:09:44.00,Default,,0,0,0,,Мимихаги-саманың арқасында мен аман қалдым.
Dialogue: 0,0:09:44.50,0:09:46.75,Default,,0,0,0,,Ауру жойылған жоқ.
Dialogue: 0,0:09:49.29,0:09:53.17,Default,,0,0,0,,Мен туралы біліп, қауесеттерге сенгіңіз келді ме?
Dialogue: 0,0:09:53.67,0:09:55.97,Default,,0,0,0,,Сіз тым көп аңдыдыңыз.
Dialogue: 0,0:09:56.47,0:09:57.26,Default,,0,0,0,,Штаб оның шамамен төрт айда сегіз «Стелла» жинайтынын болжайды, бірақ
Dialogue: 0,0:09:58.34,0:09:59.55,Default,,0,0,0,,Себебі
Dialogue: 0,0:09:59.64,0:10:03.68,Default,,0,0,0,,Маған Готей 13-тен бас тартуды айтқан сен емессің.
Dialogue: 0,0:10:03.76,0:10:04.64,Default,,0,0,0,,Шунсуй
Dialogue: 0,0:10:04.72,0:10:08.14,Default,,0,0,0,,Мен сенің оңай өлуіңе жол бермеймін, Джусиро.
Dialogue: 0,0:10:14.23,0:10:16.11,Default,,0,0,0,,Неге капитанның орынбасарын тағайындамасқа?
Dialogue: 0,0:10:16.19,0:10:19.24,Default,,0,0,0,,Иә, Кайенді алмастыратын ештеңе жоқ.
Dialogue: 0,0:10:19.32,0:10:21.07,Default,,0,0,0,,Сіз дүниеге келдіңіз
Dialogue: 0,0:10:21.16,0:10:24.33,Default,,0,0,0,,Жазылмайтын өкпе дертіне шалдыққан жоқ па?
Dialogue: 0,0:10:24.41,0:10:28.50,Default,,0,0,0,,Мен Холлоумен күрес кезінде ұстамалар болғанын естідім.
Dialogue: 0,0:10:28.58,0:10:31.00,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:10:31.08,0:10:35.05,Default,,0,0,0,,Олай болса, вице-капитан одан да қажет емес пе?
Dialogue: 0,0:10:35.13,0:10:37.55,Default,,0,0,0,,Сіздің ұсынысыңыз қабылданбайды.
Dialogue: 0,0:10:37.63,0:10:40.93,Default,,0,0,0,,«Капитанның орынбасарын тағайындау немесе босату құқығы капитанға тиесілі».
Dialogue: 0,0:10:41.43,0:10:44.26,Default,,0,0,0,,Мұны 46-шы үй шешті.
Dialogue: 0,0:10:45.89,0:10:49.31,Default,,0,0,0,,Жалғыз жұмыс істемесең, көп ұзамай өлесің.
Dialogue: 0,0:10:49.81,0:10:51.77,Default,,0,0,0,,Осыдан кейін мен қалағанымды істеймін.
Dialogue: 0,0:10:51.85,0:10:54.40,Default,,0,0,0,,Неге оны капитан етпеске?
Dialogue: 0,0:10:54.48,0:10:57.07,Default,,0,0,0,,Мен оңай өлмеймін.
Dialogue: 0,0:10:57.15,0:10:58.90,Default,,0,0,0,,Не дедің!
Dialogue: 0,0:11:00.53,0:11:01.91,Default,,0,0,0,,Мен оны естідім.
Dialogue: 0,0:11:01.99,0:11:07.16,Default,,0,0,0,,Олар вице-капитан қажет емес деп, 46-бөлмеге тангка қойды.
Dialogue: 0,0:11:07.83,0:11:10.37,Default,,0,0,0,,Маған кемінде екі адам керек.
Dialogue: 0,0:11:10.87,0:11:12.92,Default,,0,0,0,,Тек сүйкімді қыздарға арналған
Dialogue: 0,0:11:14.59,0:11:15.63,Default,,0,0,0,,Укитаке
Dialogue: 0,0:11:16.30,0:11:18.96,Default,,0,0,0,,Өміріңізге қауіп төндіретін кездер болады.
Dialogue: 0,0:11:19.47,0:11:22.09,Default,,0,0,0,,Бұл жолы болған жоқ.
Dialogue: 0,0:11:22.76,0:11:26.93,Default,,0,0,0,,Әзірге маған Кайен-кунды жоқтау ғана қалды.
Dialogue: 0,0:11:29.56,0:11:32.52,Default,,0,0,0,,Нанао-чаннан алкоголь жасырылған.
Dialogue: 0,0:11:37.53,0:11:38.28,Default,,0,0,0,,Иә
Dialogue: 0,0:11:43.16,0:11:47.91,Default,,0,0,0,,Кәрі тау картоп жақсы жерде өледі.
Dialogue: 0,0:11:47.99,0:11:53.54,Default,,0,0,0,,Бас қолбасшыға бұйрық беру соншалықты жағымсыз болғанына сене алар емеспін.
Dialogue: 0,0:11:54.13,0:11:57.38,Default,,0,0,0,,Егер Ямаджи әлі тірі болса, мен бұл туралы білмес едім.
Dialogue: 0,0:11:57.88,0:12:01.80,Default,,0,0,0,,Осылай уақыт болмаса, бірге ішер едік...
Dialogue: 0,0:12:03.51,0:12:07.93,Default,,0,0,0,,Сіз ішімдік ішіп адасып қалдыңыз ба?
Dialogue: 0,0:12:08.01,0:12:09.06,Default,,0,0,0,,Жылы
Dialogue: 0,0:12:09.14,0:12:12.77,Default,,0,0,0,,Қыз мені тастаған сайын мұңаятынмын.
Dialogue: 0,0:12:13.27,0:12:16.65,Default,,0,0,0,,Онда бұл жолы ішімдік қажет емес.
Dialogue: 0,0:12:17.27,0:12:19.53,Default,,0,0,0,,Ол жең ретінде пайдаланылмайды.
Dialogue: 0,0:12:22.74,0:12:26.37,Default,,0,0,0,,Сіз мені біраз уақытқа жалғыз қалдыра аласыз ба?
Dialogue: 0,0:12:29.03,0:12:31.79,Default,,0,0,0,,Қайырлы күн капитан Укитаке
Dialogue: 0,0:12:34.37,0:12:37.25,Default,,0,0,0,,Жақында кездескенше
Dialogue: 0,0:12:41.21,0:12:44.72,Default,,0,0,0,,Капитан! Сейрейтей пәлеге қалды!
Dialogue: 0,0:12:44.80,0:12:46.14,Default,,0,0,0,,Капитан Укитаке!
Dialogue: 0,0:12:46.22,0:12:49.01,Default,,0,0,0,,- (Сентаро) Капитан Укитаке! - (Укитаке) Мимихаги мырза, Мимихаги мырза
Dialogue: 0,0:12:49.10,0:12:51.02,Default,,0,0,0,,Көзіңнің қуатын аш
Dialogue: 0,0:12:51.10,0:12:53.10,Default,,0,0,0,,Құрметті Мимихаги Құрметті Мимихаги
Dialogue: 0,0:12:53.18,0:12:55.19,Default,,0,0,0,,Көзіңнің қуатын аш
Dialogue: 0,0:12:55.69,0:12:57.98,Default,,0,0,0,,Жүрегімде Үзұмеші Көздің құдіреті
Dialogue: 0,0:12:58.06,0:13:00.52,Default,,0,0,0,,Менің түсінігімнен бас тартып, оны ашыңыз.
Dialogue: 0,0:13:00.61,0:13:01.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:01.86,0:13:03.24,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:13:08.74,0:13:09.95,Default,,0,0,0,,Қаха!
Dialogue: 0,0:13:10.03,0:13:11.20,Default,,0,0,0,,Капитан Укитаке!
Dialogue: 0,0:13:11.29,0:13:12.16,Default,,0,0,0,,Мен оны бетіңе орап тастаймын да, біраз уақыт бойы шешіп ала алмайтындай қылып қоямын!
Dialogue: 0,0:13:12.24,0:13:13.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:13.83,0:13:18.50,Default,,0,0,0,,Лорд Мимихагидің күші менің өкпемді жеп кетті.
Dialogue: 0,0:13:19.08,0:13:22.59,Default,,0,0,0,,Сол күшті бүкіл дене мүшелеріне тарату рәсімі.
Dialogue: 0,0:13:22.67,0:13:24.09,Default,,0,0,0,,«Камикаке» деп аталады.
Dialogue: 0,0:13:25.34,0:13:29.09,Default,,0,0,0,,Менің барлық ішкі мүшелерім енді Мимихаги-самаға тиесілі.
Dialogue: 0,0:13:29.64,0:13:35.27,Default,,0,0,0,,Барлық мүшелерімді ұсына отырып, мен Мимихаги-саманың йориширосы болдым.
Dialogue: 0,0:13:35.98,0:13:39.77,Default,,0,0,0,,Мен қазір Рух патшасының оң қолымын.
Dialogue: 0,0:13:40.77,0:13:45.44,Default,,0,0,0,,Мен мұны әу бастан-ақ алдын ала болжап, сол құдайдың ілмегін жасағаныма сене алмадым...
Dialogue: 0,0:13:45.53,0:13:46.86,Default,,0,0,0,,Иә.
Dialogue: 0,0:13:47.49,0:13:50.16,Default,,0,0,0,,Неліктен аман қалғанымды білгеннен бері
Dialogue: 0,0:13:50.66,0:13:53.20,Default,,0,0,0,,Мен бір күні келетін бұл күнді ойладым.
Dialogue: 0,0:13:53.95,0:13:58.42,Default,,0,0,0,,Мен бұл өмірді қолға алғанда, Готей үшін өлгім келеді.
Dialogue: 0,0:13:58.50,0:14:02.88,Default,,0,0,0,,Капитан Укитаке өлсе, он үшінші дивизия не болады?
Dialogue: 0,0:14:03.55,0:14:05.42,Default,,0,0,0,,Кешіріңіз, Куцуки.
Dialogue: 0,0:14:05.92,0:14:08.72,Default,,0,0,0,,Сіз мені үнемі жаман сезінесіз
Dialogue: 0,0:14:09.72,0:14:11.22,Default,,0,0,0,,Капитан Укитаке...
Dialogue: 0,0:14:12.93,0:14:13.72,Default,,0,0,0,,Адамзат тағы да Титанның шапқыншылығына жол берді
Dialogue: 0,0:14:15.31,0:14:16.10,Default,,0,0,0,,Капитан...
Dialogue: 0,0:14:17.73,0:14:19.40,Default,,0,0,0,,Қайдан бастарын білмеймін.
Dialogue: 0,0:14:19.48,0:14:21.65,Default,,0,0,0,,Ұрыстың екі түрі бар.
Dialogue: 0,0:14:21.73,0:14:22.44,Default,,0,0,0,,Ха!
Dialogue: 0,0:14:22.94,0:14:25.86,Default,,0,0,0,,Сіз Кучикиді білесіз.
Dialogue: 0,0:14:31.91,0:14:34.74,Default,,0,0,0,,(Эндевор) Менің ұлым, Шото, Бүкіл Құдірет-ты басып озуға міндетті.
Dialogue: 0,0:14:39.16,0:14:40.37,Default,,0,0,0,,Джуширо
Dialogue: 0,0:14:41.58,0:14:43.50,Default,,0,0,0,,Ұрыстың екі түрі бар.
Dialogue: 0,0:14:44.21,0:14:46.96,Default,,0,0,0,,Өмірді қорғау үшін күрес және
Dialogue: 0,0:14:47.05,0:14:50.09,Default,,0,0,0,,Тәкаппарлықты қорғау үшін күрес
Dialogue: 0,0:14:51.47,0:14:52.76,Default,,0,0,0,,Сонда мен...
Dialogue: 0,0:14:56.35,0:14:59.69,Default,,0,0,0,,Кел, сөйлесейік.
Dialogue: 0,0:15:00.89,0:15:02.86,Default,,0,0,0,,Сосуке Эйзен
Dialogue: 0,0:15:10.70,0:15:14.49,Default,,0,0,0,,Менімен ұрысуға әлі де себеп бар ма?
Dialogue: 0,0:15:14.58,0:15:19.33,Default,,0,0,0,,Рух Патшасы Жан қоғамын басқарады, онда көптеген жандар келіп-кетеді.
Dialogue: 0,0:15:19.41,0:15:21.83,Default,,0,0,0,,Тұрақтандыру үшін жасалған
Dialogue: 0,0:15:21.92,0:15:23.92,Default,,0,0,0,,Енді ол жоғалды -
Dialogue: 0,0:15:24.42,0:15:26.09,Default,,0,0,0,,Жан қоғамы да
Dialogue: 0,0:15:26.17,0:15:27.09,Default,,0,0,0,,Сондай-ақ кедергі
Dialogue: 0,0:15:27.17,0:15:28.34,Default,,0,0,0,,Сондай-ақ ойдан шығарылған сфера
Dialogue: 0,0:15:28.42,0:15:29.34,Default,,0,0,0,,Тіпті бұл дүниеде де
Dialogue: 0,0:15:29.42,0:15:31.84,Default,,0,0,0,,Барлығы бірдей бөлінеді
Dialogue: 0,0:15:31.93,0:15:34.85,Default,,0,0,0,,Ичиго, сенің қолыңмен.
Dialogue: 0,0:15:35.55,0:15:37.85,Default,,0,0,0,,Мен оның назарын аударамын.
Dialogue: 0,0:15:37.93,0:15:40.14,Default,,0,0,0,,Рух Патшасын қалпына келтіру үшін күшіңізді пайдаланыңыз.
Dialogue: 0,0:15:40.64,0:15:41.23,Default,,0,0,0,,Иә
Dialogue: 0,0:15:41.31,0:15:43.52,Default,,0,0,0,,Кеттік, Чадо Иваваси!
Dialogue: 0,0:15:43.60,0:15:44.44,Default,,0,0,0,,О!
Dialogue: 0,0:15:44.52,0:15:47.73,Default,,0,0,0,,♪ Они-сан, міне, қолдар шырылдады.
Dialogue: 0,0:15:47.82,0:15:49.07,Default,,0,0,0,,Ишинами!
Dialogue: 0,0:15:51.70,0:15:55.37,Default,,0,0,0,,Бласо Изкиерда дель Диабло!
Dialogue: 0,0:15:55.87,0:15:57.49,Default,,0,0,0,,Райоукен!
Dialogue: 0,0:16:01.08,0:16:02.25,Default,,0,0,0,,Қос аспан қалқаны!
Dialogue: 0,0:16:05.83,0:16:06.92,Default,,0,0,0,,Сіз мұны жасадыңыз ба?
Dialogue: 0,0:16:09.92,0:16:10.71,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:11.22,0:16:12.55,Default,,0,0,0,,Уф... Уф!
Dialogue: 0,0:16:15.47,0:16:16.26,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:16.76,0:16:17.76,Default,,0,0,0,,Аһ!
Dialogue: 0,0:16:19.10,0:16:20.72,Default,,0,0,0,,Бұл ақымақтық.
Dialogue: 0,0:16:20.81,0:16:25.73,Default,,0,0,0,,Сіз Рух Патшасын адамға ұқсас күштермен қайта тірілте аласыз деп ойлайсыз ба?
Dialogue: 0,0:16:26.23,0:16:27.86,Default,,0,0,0,,Сендер, қылыштарыңды тартыңдар!
Dialogue: 0,0:16:27.94,0:16:29.36,Default,,0,0,0,,Қандай техниканы пайдалансаңыз да
Dialogue: 0,0:16:29.44,0:16:32.99,Default,,0,0,0,,Енді Рух Патшасын қайта тірілту мүмкін емес.
Dialogue: 0,0:16:35.57,0:16:37.99,Default,,0,0,0,,Рух патшасының күші жойылып барады!
Dialogue: 0,0:16:38.08,0:16:40.12,Default,,0,0,0,,Мен не істерімді білмеймін!
Dialogue: 0,0:16:43.83,0:16:48.21,Default,,0,0,0,,Арх!
Dialogue: 0,0:16:49.92,0:16:51.46,Default,,0,0,0,,- (Урахара) Үкітаке-сан! - Капитан Укитаке!
Dialogue: 0,0:16:59.89,0:17:03.06,Default,,0,0,0,,Жер асты дүмпулері... тоқтады.
Dialogue: 0,0:17:10.82,0:17:12.32,Default,,0,0,0,,Рух патшасы...
Dialogue: 0,0:17:13.40,0:17:15.07,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:17:16.07,0:17:19.74,Default,,0,0,0,,Юхабах та бұл көлеңке күтпеген жерден болды деп айтты ма?
Dialogue: 0,0:17:22.54,0:17:24.96,Default,,0,0,0,,Менің көзіме көрінбейтін болашақ...
Dialogue: 0,0:17:30.63,0:17:31.80,Default,,0,0,0,,Капитан...
Dialogue: 0,0:17:35.55,0:17:37.09,Default,,0,0,0,,Ол қанша уақытқа созылады?
Dialogue: 0,0:17:38.30,0:17:42.72,Default,,0,0,0,,Менің ойымша, Укитаке мұнымен Рейуды толығымен ауыстырмайды.
Dialogue: 0,0:17:43.22,0:17:46.98,Default,,0,0,0,,Бұл тұрақтылық Үкітаке өмірінің соңына дейін сақталады.
Dialogue: 0,0:17:47.85,0:17:49.10,Default,,0,0,0,,Ол қанша уақытқа созылады?
Dialogue: 0,0:17:49.19,0:17:50.36,Default,,0,0,0,,Эй... Капитан!
Dialogue: 0,0:17:50.44,0:17:52.65,Default,,0,0,0,,Бұл рас! Менің ойымша, Урахара.
Dialogue: 0,0:17:53.57,0:17:54.74,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,0:17:55.24,0:17:57.49,Default,,0,0,0,,Бұл камикакенің өзі
Dialogue: 0,0:17:57.57,0:18:00.53,Default,,0,0,0,,Мен мұны бірінші рет көріп немесе естіп тұрмын.
Dialogue: 0,0:18:01.28,0:18:03.99,Default,,0,0,0,,Мен оның қанша уақытқа созылатынын білмеймін.
Dialogue: 0,0:18:05.08,0:18:06.75,Default,,0,0,0,,Бұл анық
Dialogue: 0,0:18:06.83,0:18:10.71,Default,,0,0,0,,Укитаке мырза Рух Патшасының орнын басқан кезде,
Dialogue: 0,0:18:10.79,0:18:15.51,Default,,0,0,0,,Біз әлемді тұрақтандырудың жолын табуымыз керек
Dialogue: 0,0:18:16.84,0:18:19.09,Default,,0,0,0,,Аспан қарулары дайын
Dialogue: 0,0:18:19.18,0:18:20.18,Default,,0,0,0,,Жұмысты бастау
Dialogue: 0,0:18:20.26,0:18:23.22,Default,,0,0,0,,Мен мұны шынымен істегім келеді.
Dialogue: 0,0:18:23.72,0:18:25.02,Default,,0,0,0,,Reiatsu жеткіліксіз
Dialogue: 0,0:18:31.31,0:18:34.07,Default,,0,0,0,,Ешқандай жауап жоқ.
Dialogue: 0,0:18:34.15,0:18:37.36,Default,,0,0,0,,Рейатсу арқылы байланыспау сіздің саясатыңыз болды ма?
Dialogue: 0,0:18:37.95,0:18:42.62,Default,,0,0,0,,Немесе, күткендей, сіз бұл жерде мұны істей алмайсыз ба?
Dialogue: 0,0:18:43.37,0:18:45.58,Default,,0,0,0,,Бұл сіздің мөріңізді бұзудың кілті.
Dialogue: 0,0:18:46.08,0:18:49.58,Default,,0,0,0,,Бұлардың үшеуін ғана пайдалануға рұқсат етілді.
Dialogue: 0,0:18:50.87,0:18:52.88,Default,,0,0,0,,Алдымен аузыңдағы мөрді сындырамын.
Dialogue: 0,0:18:54.63,0:18:55.34,Default,,0,0,0,,(дыбыс құлпын ашу)
Dialogue: 0,0:18:56.34,0:19:00.34,Default,,0,0,0,,Енді сіз Reiatsu қолданбай, аузыңызбен жауап бере алуыңыз керек.
Dialogue: 0,0:19:00.84,0:19:04.05,Default,,0,0,0,,Әдетте мен екі жыл аузымды жауып отыратын едім.
Dialogue: 0,0:19:04.14,0:19:06.77,Default,,0,0,0,,Мен сөйлей алмайтын сияқтымын.
Dialogue: 0,0:19:06.85,0:19:09.64,Default,,0,0,0,,Бұл сізде емес, солай емес пе?
Dialogue: 0,0:19:11.02,0:19:11.81,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:19:13.44,0:19:14.27,Default,,0,0,0,,Ақымақ...
Dialogue: 0,0:19:14.90,0:19:17.61,Default,,0,0,0,,Тек ауыздағы пломба ғана сынған.
Dialogue: 0,0:19:20.90,0:19:21.99,Default,,0,0,0,,Не болды?
Dialogue: 0,0:19:22.78,0:19:25.58,Default,,0,0,0,,Қолдануға болатын екі кілт бар, солай ма?
Dialogue: 0,0:19:26.58,0:19:27.66,Default,,0,0,0,,(дыбыс құлпын ашу)
Dialogue: 0,0:19:29.50,0:19:31.58,Default,,0,0,0,,Бұл үш.
Dialogue: 0,0:19:32.08,0:19:36.21,Default,,0,0,0,,Босаған сол көзіңіз бен тобығыңыз қалай?
Dialogue: 0,0:19:36.71,0:19:40.26,Default,,0,0,0,,Түсіндім, сен бұрынғыдай көрінесің.
Dialogue: 0,0:19:40.34,0:19:43.39,Default,,0,0,0,,Сізді мақтап жатыр ма? Сәлем
Dialogue: 0,0:19:44.68,0:19:46.39,Default,,0,0,0,,Мүгеннен кеткің келе ме?
Dialogue: 0,0:19:46.47,0:19:49.89,Default,,0,0,0,,Мені шығаруды сұрағаным есімде жоқ.
Dialogue: 0,0:19:49.98,0:19:55.40,Default,,0,0,0,,Кеткісі келмейтін адам менен қалған екі кілтті пайдалануымды сұрауға қалай батылы барады?
Dialogue: 0,0:19:55.48,0:20:01.03,Default,,0,0,0,,Сіз бергіңіз келмейтін адамға денеңізге көмілген кілтпен келесіз бе?
Dialogue: 0,0:20:01.11,0:20:04.24,Default,,0,0,0,,О, сен маған не күтіп тұрғанын айтып тұрсың ба?
Dialogue: 0,0:20:04.74,0:20:09.29,Default,,0,0,0,,Бұл жерде шексіздік кілтін жүрекке салуға болатыны рас.
Dialogue: 0,0:20:09.87,0:20:14.67,Default,,0,0,0,,Бұл Мұманның ішіне кіріп, үш жерден шектеуді алып тастаудың шарты.
Dialogue: 0,0:20:14.75,0:20:16.13,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:20:16.21,0:20:21.47,Default,,0,0,0,,Егер өлтірілсең, Мұман қақпасы мәңгі жабылады ма?
Dialogue: 0,0:20:21.97,0:20:23.84,Default,,0,0,0,,Мен сені өлтірсем де
Dialogue: 0,0:20:23.93,0:20:28.01,Default,,0,0,0,,Сіз ол шексіздік кілтін алуға тырысады деп ойладыңыз ба?
Dialogue: 0,0:20:28.51,0:20:32.31,Default,,0,0,0,,46-бөлмедегі жігіттер...
Dialogue: 0,0:20:32.39,0:20:34.81,Default,,0,0,0,,Ал, анау да, анау да.
Dialogue: 0,0:20:34.90,0:20:39.36,Default,,0,0,0,,Егер сіз Soul Society туралы ойласаңыз, бұл ерекше нәрсе болуы мүмкін.
Dialogue: 0,0:20:39.44,0:20:41.11,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:20:42.69,0:20:45.36,Default,,0,0,0,,Енді бұл басты тақырып.
Dialogue: 0,0:20:46.49,0:20:50.20,Default,,0,0,0,,Сізді мына нәрсеге отырғызып, жерге апара аласыз ба?
Dialogue: 0,0:20:50.70,0:20:55.62,Default,,0,0,0,,Біраз уақыттан кейін алғаш рет жан қоғамының ауасын жұтқыңыз келе ме?
Dialogue: 0,0:20:58.09,0:20:59.54,Default,,0,0,0,,- (Ақ костюм) Кешіріңіз - (Шунсуи) Не...
Dialogue: 0,0:20:59.63,0:21:02.26,Default,,0,0,0,,Отырмас бұрын сізді бір рет ұстайды.
Dialogue: 0,0:21:02.34,0:21:03.67,Default,,0,0,0,,Кішкене ғана...
Dialogue: 0,0:21:03.76,0:21:06.39,Default,,0,0,0,,Ха... аааа!
Dialogue: 0,0:21:06.47,0:21:09.26,Default,,0,0,0,,Бұл керемет абайсыздық.
Dialogue: 0,0:21:09.76,0:21:13.89,Default,,0,0,0,,Бұл шектеу менің реятсуымды өшірмейді.
Dialogue: 0,0:21:13.98,0:21:17.65,Default,,0,0,0,,Менің қолымнан келетіні - сені жанымда ұстау.
Dialogue: 0,0:21:17.73,0:21:20.52,Default,,0,0,0,,Оны ұстасаңыз не болады?
Dialogue: 0,0:21:20.61,0:21:22.36,Default,,0,0,0,,Сөйлеспей-ақ білейік
Dialogue: 0,0:21:23.86,0:21:25.49,Default,,0,0,0,,Кйораку Шунсуй
Dialogue: 0,0:21:26.11,0:21:29.45,Default,,0,0,0,,Мен сол орындыққа отырып, сыртқа шыққанымда,
Dialogue: 0,0:21:29.95,0:21:33.91,Default,,0,0,0,,Мен Soul Society-ге көмектесемін деп ойлайсың ба?
Dialogue: 0,0:21:34.00,0:21:38.96,Default,,0,0,0,,Мен саған «Жан қоғамы» үшін күрес деп айтпаймын.
Dialogue: 0,0:21:39.88,0:21:40.67,Default,,0,0,0,,Тек...
Dialogue: 0,0:21:41.50,0:21:46.43,Default,,0,0,0,,Біздің мүдделеріміз бір-біріне жақын шығар деп ойлаймын.
Dialogue: 0,0:21:47.43,0:21:50.43,Default,,0,0,0,,Сіз өте қызық жігітсіз.
Dialogue: 0,0:21:53.68,0:21:56.89,Default,,0,0,0,,Ауа жұтқыңыз келмей ме?
Dialogue: 0,0:21:58.19,0:22:00.40,Default,,0,0,0,,Джухабах басып тастады —
Dialogue: 0,0:22:00.90,0:22:04.15,Default,,0,0,0,,Жан қоғамының жағымсыз атмосферасы
Dialogue: 0,0:22:06.49,0:22:08.49,Default,,0,0,0,,♪～
Dialogue: 0,0:23:31.95,0:23:33.95,Default,,0,0,0,,～♪
Dialogue: 0,0:23:39.25,0:23:42.79,Default,,0,0,0,,Садақ тартатын жұлдызға саусағыңызды қойыңыз
Dialogue: 0,0:23:43.63,0:23:45.17,Default,,0,0,0,,Бас тарту керек еді
Dialogue: 0,0:23:45.67,0:23:47.13,Default,,0,0,0,,Бір ай
Dialogue: 0,0:23:48.63,0:23:54.63,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
