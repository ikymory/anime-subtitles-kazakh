Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:44.00,0:01:47.00,Default,,0,0,0,,Мен Рух патшасының орнын аламын.
Dialogue: 0,0:01:47.00,0:01:49.00,Default,,0,0,0,,Міне, солай болды! ?
Dialogue: 0,0:01:49.00,0:01:51.01,Default,,0,0,0,,Мен кейінірек түсіндіремін.
Dialogue: 0,0:01:59.95,0:02:02.62,Default,,0,0,0,,Міне! (Сентаро) Сол кезде...
Dialogue: 0,0:02:02.62,0:02:04.62,Default,,0,0,0,,Капитан Укитаке….
Dialogue: 0,0:02:08.79,0:02:13.63,Default,,0,0,0,,Құрметті Мимихаги Құрметті Мимихаги, көзіңіздің күшін ашыңыз.
Dialogue: 0,0:02:13.63,0:02:18.47,Default,,0,0,0,,Көзіңнің құдіретін жүрегіме көм, Жүрегімді тастап, мені аш.
Dialogue: 0,0:02:18.47,0:02:20.80,Default,,0,0,0,,Мимихаги-сама Мимихаги-сама….
Dialogue: 0,0:02:20.80,0:02:25.31,Default,,0,0,0,,((Екі адам: Менің жүрегімді жейтін дертті өлтір, оның орнына сол жүректі же.
Dialogue: 0,0:02:25.31,0:02:29.98,Default,,0,0,0,,Мимихаги-сама Мимихаги-сама Құдайдың қолы көктен түсті➡
Dialogue: 0,0:02:29.98,0:02:32.48,Default,,0,0,0,,Маған көзіңнің күшін бер.
Dialogue: 0,0:02:32.48,0:02:36.99,Default,,0,0,0,,Мимихаги-сама Мимихаги-сама Менің баламның рухы тамақ ауруын өлтіреді➡
Dialogue: 0,0:02:36.99,0:02:39.32,Default,,0,0,0,,Сенің орныңа жанымды же.
Dialogue: 0,0:02:39.32,0:02:43.66,Default,,0,0,0,,Мимихаги-сама Мимихаги-сама Құдайдың қолы көктен түсті➡
Dialogue: 0,0:02:43.66,0:02:46.16,Default,,0,0,0,,Маған көзіңнің күшін бер.
Dialogue: 0,0:02:46.16,0:02:50.83,Default,,0,0,0,,Мимихаги-сама Мимихаги-сама Менің баламның рухы тамақ ауруын өлтіреді➡
Dialogue: 0,0:02:50.83,0:02:52.83,Default,,0,0,0,,Сенің орныңа жанымды же.
Dialogue: 0,0:02:52.83,0:02:54.84,Default,,0,0,0,,(жөтел дауысы)
Dialogue: 0,0:02:54.84,0:02:57.51,Default,,0,0,0,,Джуширо!
Dialogue: 0,0:02:57.51,0:03:01.28,Default,,0,0,0,,Маған көзіңнің күшін бер.
Dialogue: 0,0:03:01.28,0:03:06.28,Default,,0,0,0,,Мимихаги-сама! Өтінемін, мына баланы құтқарыңыз... Джусиро!
Dialogue: 0,0:03:06.28,0:03:11.62,Default,,0,0,0,,Осы үш жасар кішкентай балаға өмір қуанышын сыйлаңыз... Өтінемін!
Dialogue: 0,0:03:11.62,0:03:14.46,Default,,0,0,0,,Джусиро... Кешіріңіз.
Dialogue: 0,0:03:14.46,0:03:17.63,Default,,0,0,0,,Мен сені сау босана алмадым...
Dialogue: 0,0:03:17.63,0:03:19.63,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:03:23.63,0:03:28.30,Default,,0,0,0,,Анашым... жыламашы өтінемін...)
Dialogue: 0,0:03:28.30,0:04:35.97,Default,,0,0,0,,♪～
Dialogue: 0,0:04:35.97,0:04:37.97,Default,,0,0,0,,((Джуширо!
Dialogue: 0,0:04:41.64,0:04:44.35,Default,,0,0,0,,Ах... Джуширо...)
Dialogue: 0,0:04:46.31,0:04:53.02,Default,,0,0,0,,《Укитаке: Сол дауылды түн... Мені Мимихаги-сама тірі қалдырды.》
Dialogue: 0,0:04:58.33,0:05:00.93,Default,,0,0,0,,((Сәлеметсіз бе. Ах!
Dialogue: 0,0:05:00.93,0:05:03.27,Default,,0,0,0,,Қайда жүріп, қарап отырсың, қарт қаңбақ!
Dialogue: 0,0:05:03.27,0:05:06.60,Default,,0,0,0,,Маған соқтығысқаның үшін кешірім де сұрамадың!
Dialogue: 0,0:05:06.60,0:05:09.60,Default,,0,0,0,,Жеңгелеріміз тиіп кетті.
Dialogue: 0,0:05:09.60,0:05:11.94,Default,,0,0,0,,Менен бас тартпа.
Dialogue: 0,0:05:11.94,0:05:14.61,Default,,0,0,0,,Не! ?
Dialogue: 0,0:05:14.61,0:05:18.61,Default,,0,0,0,,Жақсы. Теми деген кім?
Dialogue: 0,0:05:18.61,0:05:20.62,Default,,0,0,0,,Сіз кәрі аңды қорғауға тырысасыз ба? ?
Dialogue: 0,0:05:20.62,0:05:23.32,Default,,0,0,0,,Арх! Гуфу!
Dialogue: 0,0:05:25.95,0:05:29.62,Default,,0,0,0,,Қартайғаныңыз жалқау екеніңізді білдірмейді.
Dialogue: 0,0:05:29.62,0:05:33.96,Default,,0,0,0,,Амансың ба? Сондықтан мен жақсы дедім...
Dialogue: 0,0:05:33.96,0:05:37.30,Default,,0,0,0,,Ойоне-сан осы жерде танымал.
Dialogue: 0,0:05:37.30,0:05:40.30,Default,,0,0,0,,Сізде энергия көп сияқты.
Dialogue: 0,0:05:40.30,0:05:42.97,Default,,0,0,0,,Неге екенін білмеймін, бірақ ➡
Dialogue: 0,0:05:42.97,0:05:45.64,Default,,0,0,0,,Келесі жолы сені көргенде, мен сені міндетті түрде үрлеймін.
Dialogue: 0,0:05:45.64,0:05:48.98,Default,,0,0,0,,Ахаха... Егер сізде тым көп күш болса➡
Dialogue: 0,0:05:48.98,0:05:51.31,Default,,0,0,0,,Менімен бірге Мао рухани академиясына кел.
Dialogue: 0,0:05:51.31,0:05:53.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:53.32,0:05:56.48,Default,,0,0,0,,Егер сіз Готей корпусының қызметкері болсаңыз, жабайы болып, ақша табуға болады➡
Dialogue: 0,0:05:56.48,0:05:59.92,Default,,0,0,0,,Адамдар мұны бағалайды, сіз бір оқпен екі құсты өлтіре аласыз, солай ма?
Dialogue: 0,0:05:59.92,0:06:01.92,Default,,0,0,0,,Шулы! Жолдан кет!
Dialogue: 0,0:06:06.09,0:06:09.10,Default,,0,0,0,,Мен Джуширо Укитакемін. сен?
Dialogue: 0,0:06:11.43,0:06:13.54,Default,,0,0,0,,бұл... Жібер!
Dialogue: 0,0:06:15.94,0:06:17.94,Default,,0,0,0,,Есте сақта!
Dialogue: 0,0:06:17.94,0:06:22.11,Default,,0,0,0,,Иә! Мен оны есіме аламын. Кейін кездескенше)
Dialogue: 0,0:06:22.11,0:06:24.61,Default,,0,0,0,,(жөтел дауысы)
Dialogue: 0,0:06:37.29,0:06:42.00,Default,,0,0,0,,Кішкене мәжбүрлеме, Үкітаке.
Dialogue: 0,0:06:48.64,0:06:50.64,Default,,0,0,0,,((Масубе: Бастау!
Dialogue: 0,0:06:57.48,0:06:59.92,Default,,0,0,0,,Бұл жақсы қылыш шеберлігі.
Dialogue: 0,0:06:59.92,0:07:03.52,Default,,0,0,0,,Бұл әлі қалыптасу кезеңінде, бірақ әлі де көретін көп нәрсе бар.
Dialogue: 0,0:07:06.59,0:07:08.99,Default,,0,0,0,,Аһ!
Dialogue: 0,0:07:16.77,0:07:18.77,Default,,0,0,0,,Қаха!
Dialogue: 0,0:07:21.27,0:07:23.27,Default,,0,0,0,,Біз жындан жаңа мәлімет алдық.
Dialogue: 0,0:07:26.27,0:07:28.61,Default,,0,0,0,,Мұны істеме, сен...
Dialogue: 0,0:07:28.61,0:07:32.28,Default,,0,0,0,,Науқасқа аяусызсың.
Dialogue: 0,0:07:32.28,0:07:34.62,Default,,0,0,0,,Мен Джусиро Укитакемін.
Dialogue: 0,0:07:34.62,0:07:37.45,Default,,0,0,0,,Кйораку Шунсуй. Мен білемін.
Dialogue: 0,0:07:37.45,0:07:39.45,Default,,0,0,0,,, солай ма? Сабақ кезінде➡
Dialogue: 0,0:07:39.45,0:07:43.46,Default,,0,0,0,,Маған үнемі құмарлана қарайсың.
Dialogue: 0,0:07:43.46,0:07:45.96,Default,,0,0,0,,Ахаха... Білдің бе?
Dialogue: 0,0:07:45.96,0:07:49.63,Default,,0,0,0,,Негізі саған айтар сөзім бар.
Dialogue: 0,0:07:49.63,0:07:51.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:53.64,0:07:55.97,Default,,0,0,0,,Мен күтпеген едім... Монака.
Dialogue: 0,0:07:55.97,0:07:58.97,Default,,0,0,0,,Маған қызды таныстыруды өтінсе де➡
Dialogue: 0,0:07:58.97,0:08:02.91,Default,,0,0,0,,Шай мен тәттілер дүкені туралы бірінші рет сұрап отыр.
Dialogue: 0,0:08:02.91,0:08:07.25,Default,,0,0,0,,Мен қызық болдым, өйткені сен тамақ ішкенде әрқашан бақытты көрінетінсің.
Dialogue: 0,0:08:07.25,0:08:10.25,Default,,0,0,0,,Мұндағы монакада сакке лиз жоқ.
Dialogue: 0,0:08:10.25,0:08:13.42,Default,,0,0,0,,Не! Саке Лис! ? Мәселе бар ма?
Dialogue: 0,0:08:13.42,0:08:16.42,Default,,0,0,0,,Керемет!
Dialogue: 0,0:08:16.42,0:08:19.26,Default,,0,0,0,,Үлкен аға! (Әпкелер) Бауырым!
Dialogue: 0,0:08:19.26,0:08:21.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:21.60,0:08:23.93,Default,,0,0,0,,Иә! Бұл Монака!
Dialogue: 0,0:08:23.93,0:08:26.43,Default,,0,0,0,,Жарайды... бұл балалар үшін улы!
Dialogue: 0,0:08:26.43,0:08:28.94,Default,,0,0,0,,А... міне, солай болды. Сондықтан бұл жақсы емес.
Dialogue: 0,0:08:28.94,0:08:40.95,Default,,0,0,0,,♪～
Dialogue: 0,0:08:40.95,0:08:42.95,Default,,0,0,0,,Мен сенің көргеніңді қалаймын.
Dialogue: 0,0:08:44.95,0:08:47.62,Default,,0,0,0,,Бұл...
Dialogue: 0,0:08:47.62,0:08:53.96,Default,,0,0,0,,Бұл Руконгайдың 76-шы ауданындағы Сакабоненің байырғы құдайы Мимихаги.
Dialogue: 0,0:08:53.96,0:08:57.80,Default,,0,0,0,,Құрметті Мимихаги... Бұл шынымен де болды.
Dialogue: 0,0:08:57.80,0:09:01.57,Default,,0,0,0,,Сіз білесіз бе? Жоғарғы ақсүйектер арасында➡
Dialogue: 0,0:09:01.57,0:09:03.91,Default,,0,0,0,,Айналада өсек бар...
Dialogue: 0,0:09:03.91,0:09:09.58,Default,,0,0,0,,Баяғыда Рух патша Самадан бөлінген күш жерге құлаған сияқты.
Dialogue: 0,0:09:09.58,0:09:11.58,Default,,0,0,0,,Рух патшасының күші...
Dialogue: 0,0:09:11.58,0:09:16.58,Default,,0,0,0,,Бұл біртүрлі... Рух патшасы Сама Рух патшасының сарайында.
Dialogue: 0,0:09:16.58,0:09:19.42,Default,,0,0,0,,Бірақ мына Мимихаги-сама➡ қараңыз
Dialogue: 0,0:09:19.42,0:09:22.76,Default,,0,0,0,,Мен қауесеттер рас болуы мүмкін сияқты сезіне бастадым.
Dialogue: 0,0:09:22.76,0:09:25.93,Default,,0,0,0,,Иә? Мына мүсінге қараңызшы...
Dialogue: 0,0:09:25.93,0:09:29.93,Default,,0,0,0,,Медамаға көңілім ауып барады, бірақ оның пішіні...
Dialogue: 0,0:09:29.93,0:09:35.94,Default,,0,0,0,,Рух патшасы Саманың денесінде әртүрлі пайдалар бар сияқты...
Dialogue: 0,0:09:35.94,0:09:41.61,Default,,0,0,0,,Сол қол алға қозғалысты басқарады. Оң қол басқарады...
Dialogue: 0,0:09:41.61,0:09:46.95,Default,,0,0,0,,Тыныштық... иә? иә? Сіз білдіңіз бе?
Dialogue: 0,0:09:46.95,0:09:49.62,Default,,0,0,0,,Бірақ мен оны білдім.
Dialogue: 0,0:09:49.62,0:09:52.62,Default,,0,0,0,,Мимихаги-саманың арқасында мен аман қалдым➡
Dialogue: 0,0:09:52.62,0:09:56.02,Default,,0,0,0,,Ауру жойылған жоқ.
Dialogue: 0,0:09:57.96,0:10:02.46,Default,,0,0,0,,Мен туралы біліп, өсекке сендіңіз бе?
Dialogue: 0,0:10:02.46,0:10:06.47,Default,,0,0,0,,Көп сұрағаным үшін кешіріңіз.
Dialogue: 0,0:10:06.47,0:10:10.81,Default,,0,0,0,,Сондықтан мен сізге Готей 13 корпусынан бас тартуды айтып отырмын➡
Dialogue: 0,0:10:10.81,0:10:13.98,Default,,0,0,0,,Бұл сен емес, Шунсуй.
Dialogue: 0,0:10:13.98,0:10:17.28,Default,,0,0,0,,Мен сенің оңай өлуіңе жол бермеймін, Джусиро.
Dialogue: 0,0:10:23.32,0:10:28.32,Default,,0,0,0,,Вице-капитан жоқ! ? иә. Кайенді алмастыратын ешкім жоқ.
Dialogue: 0,0:10:28.32,0:10:33.33,Default,,0,0,0,,Туылғаннан бері жазылмайтын өкпе ауруымен ауырып жүргеніңді естідім.
Dialogue: 0,0:10:33.33,0:10:37.67,Default,,0,0,0,,Мен Холлоумен күрес кезінде талма болғанын естідім.
Dialogue: 0,0:10:37.67,0:10:40.00,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:10:40.00,0:10:44.01,Default,,0,0,0,,Олай болса, вице-капитан қажет емес пе?
Dialogue: 0,0:10:44.01,0:10:46.51,Default,,0,0,0,,Сіздің ұсынысыңыз қабылданбайды!
Dialogue: 0,0:10:46.51,0:10:50.01,Default,,0,0,0,,Капитанның орынбасарын тағайындау немесе босату құқығы капитанға тиесілі.
Dialogue: 0,0:10:50.01,0:10:54.02,Default,,0,0,0,,Сіз осылай шештіңіз.
Dialogue: 0,0:10:54.02,0:10:58.35,Default,,0,0,0,,Жалғыз жұмыс істемесең, көп ұзамай өлесің.
Dialogue: 0,0:10:58.35,0:11:00.96,Default,,0,0,0,,Одан кейін қалағаныңды жасайтындар➡
Dialogue: 0,0:11:00.96,0:11:03.63,Default,,0,0,0,,Неге оны капитан етпеске?
Dialogue: 0,0:11:03.63,0:11:07.53,Default,,0,0,0,,Иә, мен оңай өлмеймін. Хахахахаха.
Dialogue: 0,0:11:09.46,0:11:12.97,Default,,0,0,0,,естідім... сізге вице-капитан керек емес➡
Dialogue: 0,0:11:12.97,0:11:16.14,Default,,0,0,0,,46-бөлмеде тесік кескеніңізді естідім...
Dialogue: 0,0:11:16.14,0:11:19.64,Default,,0,0,0,,Мен болсам, кем дегенде екі адам алғым келеді.
Dialogue: 0,0:11:19.64,0:11:22.64,Default,,0,0,0,,Тек сүйкімді қыздарға арналған.
Dialogue: 0,0:11:22.64,0:11:28.32,Default,,0,0,0,,Үкітаке... Өміріңді қатерге тіккен кездер болады.
Dialogue: 0,0:11:28.32,0:11:31.49,Default,,0,0,0,,Бұл жолы болған жоқ.
Dialogue: 0,0:11:31.49,0:11:36.49,Default,,0,0,0,,Әзірше... маған тек Кайен-кунды жоқтау ғана қалды.
Dialogue: 0,0:11:38.49,0:11:42.00,Default,,0,0,0,,Алкогольді... Нанао-чаннан жасырған.
Dialogue: 0,0:11:51.34,0:11:57.01,Default,,0,0,0,,Таудың тәтті картоп... Жақсы жерде өлетініне сенімдімін.
Dialogue: 0,0:11:57.01,0:12:02.95,Default,,0,0,0,,Бас қолбасшыға бұйрық беру соншалықты жиіркенішті іс болғанына сене алар емеспін.
Dialogue: 0,0:12:02.95,0:12:06.96,Default,,0,0,0,,Егер Ямаджи әлі тірі болса, мен бұл туралы білмес едім...
Dialogue: 0,0:12:06.96,0:12:12.63,Default,,0,0,0,,Осылай уақыт болмаса, сусын ішуге шығатын едік...
Dialogue: 0,0:12:12.63,0:12:16.97,Default,,0,0,0,,Сіз ішімдік ішіп адасып қалдыңыз ба?
Dialogue: 0,0:12:16.97,0:12:19.97,Default,,0,0,0,,Бұл... Бір қыз мені тастап кеткенде➡
Dialogue: 0,0:12:19.97,0:12:22.30,Default,,0,0,0,,Ол үнемі боялған.
Dialogue: 0,0:12:22.30,0:12:25.81,Default,,0,0,0,,Онда бұл жолы ішімдіктің қажеті жоқ.
Dialogue: 0,0:12:25.81,0:12:28.61,Default,,0,0,0,,Ол жең ретінде пайдаланылмайды.
Dialogue: 0,0:12:31.31,0:12:35.62,Default,,0,0,0,,Сіз мені біраз уақытқа жалғыз қалдыра аласыз ба?
Dialogue: 0,0:12:37.65,0:12:41.36,Default,,0,0,0,,Капитан Укитаке... Қайырлы күн.
Dialogue: 0,0:12:43.49,0:12:46.49,Default,,0,0,0,,Жақында кездескенше...
Dialogue: 0,0:12:49.33,0:12:52.17,Default,,0,0,0,,Капитан! Бұл қиын!
Dialogue: 0,0:12:52.17,0:12:55.00,Default,,0,0,0,,.Рухтар соты! Капитан Укитаке! )
Dialogue: 0,0:12:55.00,0:12:59.67,Default,,0,0,0,,Құрметті Мимихаги Құрметті Мимихаги, көзіңіздің күшін ашыңыз.
Dialogue: 0,0:12:59.67,0:13:04.11,Default,,0,0,0,,Лорд Мимихаги Лорд Мимихаги, көзіңіздің күшін ашыңыз.
Dialogue: 0,0:13:04.11,0:13:10.95,Default,,0,0,0,,Көзіңнің қуатын жүрегіме көм, Жүрегімді тастап, аш.
Dialogue: 0,0:13:10.95,0:13:12.95,Default,,0,0,0,,Бұл не... бұл!
Dialogue: 0,0:13:17.79,0:13:20.29,Default,,0,0,0,,Қаха! Капитан Укитаке!
Dialogue: 0,0:13:20.29,0:13:22.30,Default,,0,0,0,,Мен оны бетіңе орап тастаймын да, біраз уақыт бойы шешіп ала алмайтындай қылып қоямын!
Dialogue: 0,0:13:22.30,0:13:27.47,Default,,0,0,0,,Лорд Мимихагидің күші менің өкпемді толтырды.
Dialogue: 0,0:13:27.47,0:13:33.31,Default,,0,0,0,,Сол күшті бүкіл дененің ішкі мүшелеріне тарататын ырым Камикаке деп аталады.
Dialogue: 0,0:13:33.31,0:13:37.98,Default,,0,0,0,,Менің барлық ішкі мүшелерім енді Мимихаги-самаға тиесілі.
Dialogue: 0,0:13:37.98,0:13:44.32,Default,,0,0,0,,Барлық мүшелерімді ұсына отырып, мен Мимихаги-самаға тәуелді болдым.
Dialogue: 0,0:13:44.32,0:13:49.32,Default,,0,0,0,,Дәл қазір мен... Рух Патшасының оң қолымын.
Dialogue: 0,0:13:49.32,0:13:54.66,Default,,0,0,0,,Мен о бастан сене алар емеспін... Мен мұны алдын ала болжап, сол илаһи шақыруды жасадым...
Dialogue: 0,0:13:54.66,0:13:59.33,Default,,0,0,0,,Иә. Неліктен аман қалғанымды білгеннен бері➡
Dialogue: 0,0:13:59.33,0:14:02.44,Default,,0,0,0,,Мен бір күні келетін бұл күнді ойладым.
Dialogue: 0,0:14:02.44,0:14:07.61,Default,,0,0,0,,Бұл өмірді мен бір рет көтерген едім... Гетей үшін өлсем ғой.
Dialogue: 0,0:14:07.61,0:14:11.95,Default,,0,0,0,,Капитан Укитаке өлсе, он үшінші дивизия не болады?
Dialogue: 0,0:14:11.95,0:14:18.29,Default,,0,0,0,,Кешіріңіз, Кучики... Сіз мені үнемі жаман сезінесіз.
Dialogue: 0,0:14:18.29,0:14:20.62,Default,,0,0,0,,Капитан Укитаке...
Dialogue: 0,0:14:20.62,0:14:24.29,Default,,0,0,0,,Капитан….
Dialogue: 0,0:14:24.29,0:14:26.79,Default,,0,0,0,,Капитан….
Dialogue: 0,0:14:26.79,0:14:28.80,Default,,0,0,0,,Капитан! !
Dialogue: 0,0:14:28.80,0:14:31.97,Default,,0,0,0,,Ұрыстың екі түрі бар.
Dialogue: 0,0:14:31.97,0:14:34.97,Default,,0,0,0,,Білесің бе, Кучики.
Dialogue: 0,0:14:40.81,0:14:43.61,Default,,0,0,0,,Арх!
Dialogue: 0,0:14:47.65,0:14:49.98,Default,,0,0,0,,《Джуширо….
Dialogue: 0,0:14:49.98,0:14:52.99,Default,,0,0,0,,Ұрыстың екі түрі бар.
Dialogue: 0,0:14:52.99,0:14:56.32,Default,,0,0,0,,Өмірді қорғау үшін күрес...
Dialogue: 0,0:14:56.32,0:14:59.66,Default,,0,0,0,,Тәкаппарлықты қорғау үшін күрес...
Dialogue: 0,0:14:59.66,0:15:02.06,Default,,0,0,0,,Сонда мен...》
Dialogue: 0,0:15:04.60,0:15:09.27,Default,,0,0,0,,Енді... сөйлесейік.
Dialogue: 0,0:15:09.27,0:15:11.57,Default,,0,0,0,,Сосуке Эйзен.
Dialogue: 0,0:15:19.95,0:15:23.62,Default,,0,0,0,,Менімен ұрысуға әлі де себеп бар ма?
Dialogue: 0,0:15:23.62,0:15:28.46,Default,,0,0,0,,Рух Патшасы Жан қоғамы арқылы өтеді, онда көптеген жандар келіп, кетеді.
Dialogue: 0,0:15:28.46,0:15:33.46,Default,,0,0,0,,Тұрақтандыру үшін жасалған. Енді ол жоғалып кетті➡
Dialogue: 0,0:15:33.46,0:15:38.63,Default,,0,0,0,,Жан қоғамы, Данкай, қуыс патшалық және бұл әлем...
Dialogue: 0,0:15:38.63,0:15:40.97,Default,,0,0,0,,үшін бірдей құлайды!
Dialogue: 0,0:15:40.97,0:15:43.97,Default,,0,0,0,,Ичиго Сіздің қолыңызбен.
Dialogue: 0,0:15:43.97,0:15:46.64,Default,,0,0,0,,Бүркіт оның назарын аударады.
Dialogue: 0,0:15:46.64,0:15:50.31,Default,,0,0,0,,Өз күшіңізбен Рух Патшасын қалпына келтіріңіз. (Орихиме) Иә.
Dialogue: 0,0:15:50.31,0:15:53.48,Default,,0,0,0,,Кеттік, Чадо! Rock Eagle! (Иваваси) О!
Dialogue: 0,0:15:53.48,0:15:56.65,Default,,0,0,0,,Они-сан, міне! Қолдың дыбысына қарай!
Dialogue: 0,0:15:56.65,0:15:58.65,Default,,0,0,0,,Ишинами!
Dialogue: 0,0:16:00.92,0:16:04.93,Default,,0,0,0,,Шайтанның сол қолы.
Dialogue: 0,0:16:04.93,0:16:06.93,Default,,0,0,0,,Райоукен!
Dialogue: 0,0:16:09.93,0:16:11.93,Default,,0,0,0,,Қос аспан қалқаны!
Dialogue: 0,0:16:14.60,0:16:16.60,Default,,0,0,0,,Сіз мұны істедіңіз! ?
Dialogue: 0,0:16:18.94,0:16:21.54,Default,,0,0,0,,Ах! Қарғыс атсын! Уф! ?
Dialogue: 0,0:16:24.45,0:16:26.95,Default,,0,0,0,,Ах! Арх!
Dialogue: 0,0:16:26.95,0:16:29.62,Default,,0,0,0,,Бұл ақымақтық.
Dialogue: 0,0:16:29.62,0:16:35.29,Default,,0,0,0,,Сіз Рух Патшасын адамға ұқсас күштермен тірілте аласыз деп ойлайсыз ба?
Dialogue: 0,0:16:35.29,0:16:38.63,Default,,0,0,0,,Бұл мүмкін емес. Қандай техниканы қолдансаңыз да➡
Dialogue: 0,0:16:38.63,0:16:42.03,Default,,0,0,0,,Енді Рух Патшасын қайта тірілту мүмкін емес.
Dialogue: 0,0:16:44.63,0:16:49.14,Default,,0,0,0,,Рух патшасының күші жойылып барады... Мен не істерімді білмеймін!
Dialogue: 0,0:16:52.64,0:16:56.34,Default,,0,0,0,,Уау! !
Dialogue: 0,0:16:58.98,0:17:00.98,Default,,0,0,0,,Укитаке мырза! Капитан Укитаке!
Dialogue: 0,0:17:08.92,0:17:11.93,Default,,0,0,0,,Дірілдеу... тоқтады.
Dialogue: 0,0:17:19.77,0:17:21.94,Default,,0,0,0,,Рух патшасы...
Dialogue: 0,0:17:21.94,0:17:24.61,Default,,0,0,0,,Не! ? Бұл...
Dialogue: 0,0:17:24.61,0:17:29.01,Default,,0,0,0,,《Джухабах та бұл көлеңке күтпеген жерден болды деп айтты ма? 》
Dialogue: 0,0:17:30.95,0:17:34.25,Default,,0,0,0,,Менің көзіме көрінбейтін болашақ...
Dialogue: 0,0:17:39.12,0:17:41.12,Default,,0,0,0,,Капитан….
Dialogue: 0,0:17:44.63,0:17:46.96,Default,,0,0,0,,Ол қанша уақытқа созылады?
Dialogue: 0,0:17:46.96,0:17:51.63,Default,,0,0,0,,Менің ойымша, Укитаке мұнымен Рейуды толығымен ауыстырмайды.
Dialogue: 0,0:17:51.63,0:17:56.64,Default,,0,0,0,,Бұл тұрақтылық Үкітаке өмірінің соңына дейін сақталады.
Dialogue: 0,0:17:56.64,0:17:58.64,Default,,0,0,0,,Ол қанша уақытқа созылады?
Dialogue: 0,0:17:58.64,0:18:01.58,Default,,0,0,0,,Эй... Капитан! Бұл рас! Солай емес пе? Урахара.
Dialogue: 0,0:18:01.58,0:18:03.91,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:18:03.91,0:18:09.58,Default,,0,0,0,,Мен бұл ками-гаке затын бірінші рет көруім немесе естуім.
Dialogue: 0,0:18:09.58,0:18:13.25,Default,,0,0,0,,Мен оның қанша уақытқа созылатынын білмеймін.
Dialogue: 0,0:18:13.25,0:18:16.59,Default,,0,0,0,,Жалғыз нәрсе - Укитаке-сан➡
Dialogue: 0,0:18:16.59,0:18:19.26,Default,,0,0,0,,Рух Патшасының орнына қызмет ету кезінде➡
Dialogue: 0,0:18:19.26,0:18:21.93,Default,,0,0,0,,Әлемді қалай тұрақтандыруға болады➡
Dialogue: 0,0:18:21.93,0:18:24.93,Default,,0,0,0,,Оны табу керек...
Dialogue: 0,0:18:24.93,0:18:29.27,Default,,0,0,0,,Аспан қаруы дайын. Сіз бастай аласыз.
Dialogue: 0,0:18:29.27,0:18:33.98,Default,,0,0,0,,Мен мұны шынымен істегім келеді, бірақ менде Reiatsu жеткіліксіз.
Dialogue: 0,0:18:40.28,0:18:42.95,Default,,0,0,0,,Ешқандай жауап жоқ.
Dialogue: 0,0:18:42.95,0:18:46.45,Default,,0,0,0,,Рейацумен байланыспау сіздің саясатыңыз болды ма?
Dialogue: 0,0:18:46.45,0:18:51.63,Default,,0,0,0,,Немесе, күткендей, сіз бұл жерде мұны істей алмайсыз ба?
Dialogue: 0,0:18:51.63,0:18:54.96,Default,,0,0,0,,Бұл сіздің мөріңізді бұзудың кілті.
Dialogue: 0,0:18:54.96,0:18:58.63,Default,,0,0,0,,Бұлардың үшеуін ғана пайдалануға рұқсат етілді.
Dialogue: 0,0:18:58.63,0:19:02.04,Default,,0,0,0,,Алдымен аузыңдағы мөрді сындырамын.
Dialogue: 0,0:19:04.74,0:19:09.74,Default,,0,0,0,,Енді сіз Рейатсудың орнына аузыңызбен жауап бере алуыңыз керек.
Dialogue: 0,0:19:09.74,0:19:12.91,Default,,0,0,0,,Әдетте екі жыл аузыңды жауып жүрсең➡
Dialogue: 0,0:19:12.91,0:19:15.92,Default,,0,0,0,,Мен сөйлей алмайтын шығармын...
Dialogue: 0,0:19:15.92,0:19:19.59,Default,,0,0,0,,Бұл сізге ғана емес, солай ма?
Dialogue: 0,0:19:19.59,0:19:21.92,Default,,0,0,0,,Дұрыс. Ха! ?
Dialogue: 0,0:19:21.92,0:19:26.53,Default,,0,0,0,,《Ақымақ... Мен әлі ауыздағы мөрді ғана сындырдым.》
Dialogue: 0,0:19:29.26,0:19:34.57,Default,,0,0,0,,Не болды? Қолдануға болатын екі кілт бар, солай ма?
Dialogue: 0,0:19:38.27,0:19:40.94,Default,,0,0,0,,Бұл үш.
Dialogue: 0,0:19:40.94,0:19:45.61,Default,,0,0,0,,Босаған сол жақ көздерің мен тобықтарың қалай?
Dialogue: 0,0:19:45.61,0:19:49.28,Default,,0,0,0,,Түсіндім... сен бұрынғыдай көрінесің.
Dialogue: 0,0:19:49.28,0:19:52.62,Default,,0,0,0,,Мені мақтап жатыр ма деп... Рахмет.
Dialogue: 0,0:19:52.62,0:19:55.46,Default,,0,0,0,,Бұл жерден кеткіңіз келе ме?
Dialogue: 0,0:19:55.46,0:19:58.96,Default,,0,0,0,,Оның мені шығаруын өтінгені есімде жоқ.
Dialogue: 0,0:19:58.96,0:20:04.47,Default,,0,0,0,,Кеткісі келмейтін адам қалған екі кілтті пайдалануды сұрауға қалай батылы барады?
Dialogue: 0,0:20:04.47,0:20:07.13,Default,,0,0,0,,Барғыңыз келмейтін адамға➡
Dialogue: 0,0:20:07.13,0:20:10.30,Default,,0,0,0,,Сіз өзіңіздің денеңізге салынған кілтпен келесіз бе?
Dialogue: 0,0:20:10.30,0:20:13.64,Default,,0,0,0,,Әй, сен оны көрмейсің.
Dialogue: 0,0:20:13.64,0:20:18.31,Default,,0,0,0,,Бұл жерде... шексіздік кілтін жүрекке салуға болатыны рас➡
Dialogue: 0,0:20:18.31,0:20:23.82,Default,,0,0,0,,Муманға кіру Бұл үш жерде шектеуді алып тастау шарты.
Dialogue: 0,0:20:23.82,0:20:26.65,Default,,0,0,0,,Түсіндім... өлтіріп алсаңыз➡
Dialogue: 0,0:20:26.65,0:20:30.32,Default,,0,0,0,,Бұл шексіздік қақпасының мәңгі жабылатынын білдіре ме?
Dialogue: 0,0:20:30.32,0:20:32.66,Default,,0,0,0,,Мен сені өлтірсем де➡
Dialogue: 0,0:20:32.66,0:20:37.50,Default,,0,0,0,,Сіз ол шексіздік кілтін алуға тырысады деп ойладыңыз ба?
Dialogue: 0,0:20:37.50,0:20:41.34,Default,,0,0,0,,46-бөлмедегі жігіттер...
Dialogue: 0,0:20:41.34,0:20:43.84,Default,,0,0,0,,Жарайды... бұл да➡
Dialogue: 0,0:20:43.84,0:20:48.01,Default,,0,0,0,,Егер сіз Soul Society туралы ойласаңыз, бұл ерекше нәрсе болуы мүмкін.
Dialogue: 0,0:20:48.01,0:20:51.01,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:20:51.01,0:20:54.35,Default,,0,0,0,,Енді... бұл басты тақырып.
Dialogue: 0,0:20:54.35,0:20:59.69,Default,,0,0,0,,Сізді мына нәрсеге отырғызып, жерге апара аласыз ба?
Dialogue: 0,0:20:59.69,0:21:05.09,Default,,0,0,0,,Біраз уақыттан кейін алғаш рет Soul Society ауасын жұтқыңыз келе ме?
Dialogue: 0,0:21:07.29,0:21:09.30,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:21:09.30,0:21:11.30,Default,,0,0,0,,Сіз отырғанға дейін бір рет ұстайсыз.
Dialogue: 0,0:21:11.30,0:21:13.63,Default,,0,0,0,,Кішкене ғана...
Dialogue: 0,0:21:13.63,0:21:15.64,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:15.64,0:21:18.14,Default,,0,0,0,,Бұл керемет абайсыздық.
Dialogue: 0,0:21:18.14,0:21:22.64,Default,,0,0,0,,Бұл шектеу менің реиатсуымды өшірмейді➡
Dialogue: 0,0:21:22.64,0:21:26.65,Default,,0,0,0,,Менің қолымнан келетіні - сені жанымда ұстау.
Dialogue: 0,0:21:26.65,0:21:29.32,Default,,0,0,0,,Оны ұстасаңыз не болады?➡
Dialogue: 0,0:21:29.32,0:21:31.99,Default,,0,0,0,,Сөйлеспей-ақ білейік.
Dialogue: 0,0:21:31.99,0:21:34.99,Default,,0,0,0,,Кйораку Шунсуи.
Dialogue: 0,0:21:34.99,0:21:38.66,Default,,0,0,0,,Мен сол орындыққа отырып далаға шыққанда➡
Dialogue: 0,0:21:38.66,0:21:43.00,Default,,0,0,0,,Мен өз күшімді «Жан» қоғамына берем деп ойлайсыз ба?
Dialogue: 0,0:21:43.00,0:21:48.34,Default,,0,0,0,,Мен саған «Жан қоғамы» үшін күрес деп айтпаймын.
Dialogue: 0,0:21:48.34,0:21:51.51,Default,,0,0,0,,Дегенмен, біздің мүдделеріміз➡
Dialogue: 0,0:21:51.51,0:21:53.84,Default,,0,0,0,,Жақын жерде біреу бар екеніне сенімдімін➡
Dialogue: 0,0:21:53.84,0:21:56.18,Default,,0,0,0,,Менің ойымша.
Dialogue: 0,0:21:56.18,0:21:59.68,Default,,0,0,0,,Сіз өте қызық жігітсіз.
Dialogue: 0,0:22:02.45,0:22:05.95,Default,,0,0,0,,Ауа жұтқыңыз келмей ме?
Dialogue: 0,0:22:05.95,0:22:12.96,Default,,0,0,0,,Жан қоғамының аянышты атмосферасын Юха Бах талқандады.
Dialogue: 0,0:22:14.46,0:22:20.46,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
