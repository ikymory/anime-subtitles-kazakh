Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.00,0:00:07.17,Default,,0,0,0,,Арх! Гах...
Dialogue: 0,0:00:07.17,0:00:42.67,Default,,0,0,0,,♪～
Dialogue: 0,0:00:50.38,0:00:53.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:53.05,0:00:55.72,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:00:55.72,0:00:59.89,Default,,0,0,0,,Бұл сұрақ па? Әлде сіз өзіңізбен сөйлесесіз бе?
Dialogue: 0,0:00:59.89,0:01:02.66,Default,,0,0,0,,Монолог болса, мен оны елемеймін➡
Dialogue: 0,0:01:02.66,0:01:05.83,Default,,0,0,0,,Алайда екеуміз бір нәрсені бірінші рет көріп отырмыз➡
Dialogue: 0,0:01:05.83,0:01:10.50,Default,,0,0,0,,Менің ойымша, 13-ші отрядта бұл сұрақты қоятындай ақымақ адам жоқ.
Dialogue: 0,0:01:10.50,0:01:13.34,Default,,0,0,0,,-ға келгенде оның еленбей қалуы заңды...
Dialogue: 0,0:01:13.34,0:01:15.50,Default,,0,0,0,,Өлтірейік!
Dialogue: 0,0:01:15.50,0:01:18.01,Default,,0,0,0,,Менің ойымша, сіз бірдеңе айттыңыз.
Dialogue: 0,0:01:18.01,0:01:20.61,Default,,0,0,0,,Өлімге мүмкіндік жоқ, Маюри-сама.
Dialogue: 0,0:01:26.01,0:01:28.12,Default,,0,0,0,,Күте тұрыңыз, Зараки!
Dialogue: 0,0:01:31.02,0:01:33.02,Default,,0,0,0,,Сараки….
Dialogue: 0,0:01:33.02,0:01:35.02,Default,,0,0,0,,О, ештеңе.
Dialogue: 0,0:01:37.03,0:01:40.36,Default,,0,0,0,,Тек бір қолы зақымдалған.
Dialogue: 0,0:01:40.36,0:01:43.87,Default,,0,0,0,,Оның орнына мен бейбақтың басын жарып жібердім.
Dialogue: 0,0:01:51.37,0:01:53.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:01.32,0:02:03.82,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:02:10.83,0:02:15.03,Default,,0,0,0,,Бұл сұрақ па? Әлде сіз өзіңізбен сөйлесесіз бе?
Dialogue: 0,0:03:57.03,0:04:01.47,Default,,0,0,0,,Менің басым үлкен болып кетті. Жер бетінде ше?
Dialogue: 0,0:04:01.47,0:04:04.81,Default,,0,0,0,,Бұл өзгеріс шайқас үшін жарамсыз болып көрінеді, бірақ...
Dialogue: 0,0:04:04.81,0:04:08.31,Default,,0,0,0,,Маған бұл не үшін керек. Ол қорқынышты жігіт.
Dialogue: 0,0:04:08.31,0:04:10.31,Default,,0,0,0,,Айтпа.
Dialogue: 0,0:04:10.31,0:04:14.82,Default,,0,0,0,,Бұл кететін уақыт емес. (Юмичика) Идиот! Сізге шығудың қажеті жоқ!
Dialogue: 0,0:04:14.82,0:04:17.49,Default,,0,0,0,,Егер сіз шатассаңыз, қатты ашуланасыз.
Dialogue: 0,0:04:17.49,0:04:19.82,Default,,0,0,0,,Мен де солай ойлаймын.
Dialogue: 0,0:04:19.82,0:04:23.49,Default,,0,0,0,,Өз пікірін білдіретін адам сирек.
Dialogue: 0,0:04:23.49,0:04:28.50,Default,,0,0,0,,Солай ма? Маюри-сама шақырмайынша қозғалма дедім➡
Dialogue: 0,0:04:28.50,0:04:30.83,Default,,0,0,0,,Өйткені ол әрқашан бұйырылады.
Dialogue: 0,0:04:30.83,0:04:33.17,Default,,0,0,0,,Маюри-сама маған көбірек қоңырау шалса➡
Dialogue: 0,0:04:33.17,0:04:36.00,Default,,0,0,0,,Жау мені итермейді деп ойлаймын.
Dialogue: 0,0:04:36.00,0:04:40.01,Default,,0,0,0,,Сіз не айтып тұрсыз? Капитан Заракиге де солай.
Dialogue: 0,0:04:47.02,0:04:49.02,Default,,0,0,0,,Қарғыс атсын! Бұл не? ?
Dialogue: 0,0:04:49.02,0:04:51.02,Default,,0,0,0,,Сынған қол!
Dialogue: 0,0:04:53.02,0:04:55.82,Default,,0,0,0,,Куу...!
Dialogue: 0,0:05:05.47,0:05:08.30,Default,,0,0,0,,Қанға айналғанша бүктелді...
Dialogue: 0,0:05:08.30,0:05:10.64,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:05:10.64,0:05:13.48,Default,,0,0,0,,Жоқ, жоқ, бұл өте қиын.
Dialogue: 0,0:05:13.48,0:05:16.81,Default,,0,0,0,,Қолды тез созу дұрыс шешім болды.
Dialogue: 0,0:05:16.81,0:05:19.31,Default,,0,0,0,,Капитан Зараки күткендей.
Dialogue: 0,0:05:19.31,0:05:24.49,Default,,0,0,0,,Егер сіз бұл шешімді бір сәтте қабылдамаған болсаңыз, қазір бүкіл денеңіз шиеленіскен болар еді➡
Dialogue: 0,0:05:24.49,0:05:29.32,Default,,0,0,0,,Дәмі де, дәмі де жоқ үйілген котлеттер болса керек.
Dialogue: 0,0:05:29.32,0:05:33.33,Default,,0,0,0,,Сіз мені мақтайсыз ба, әлде төбелесіп жатырсыз ба?
Dialogue: 0,0:05:33.33,0:05:35.83,Default,,0,0,0,,Қайсысы деп ойлайсың?
Dialogue: 0,0:05:35.83,0:05:40.84,Default,,0,0,0,,Екеуі де жақсы. Бұл жігіттің қабілеті не болып жатыр...?
Dialogue: 0,0:05:40.84,0:05:45.34,Default,,0,0,0,,Дәл солай, бұл сұрақ па, әлде жеке әңгіме ме, шеше алмаймын.
Dialogue: 0,0:05:45.34,0:05:49.01,Default,,0,0,0,,Бірақ мен екі жолды да білмеймін.
Dialogue: 0,0:05:49.01,0:05:51.18,Default,,0,0,0,,Осы сәтте менің айта алатыным тек➡
Dialogue: 0,0:05:51.18,0:05:54.68,Default,,0,0,0,,Тек оған жақындама.
Dialogue: 0,0:05:54.68,0:05:59.86,Default,,0,0,0,,Тым жақындамаңыз? Нему: Қанды тоқтату үшін мына жігіттің қолдарын байлаңыз.
Dialogue: 0,0:05:59.86,0:06:02.46,Default,,0,0,0,,Иә. Ақымақ болма.
Dialogue: 0,0:06:02.46,0:06:05.46,Default,,0,0,0,,Жақын келмесең, оны қалай өлтіресің?
Dialogue: 0,0:06:05.46,0:06:08.46,Default,,0,0,0,,Эй, менің тағы бір сұрағым бар.
Dialogue: 0,0:06:08.46,0:06:11.63,Default,,0,0,0,,Жекпе-жек тек қана ұрып-соғу емес.
Dialogue: 0,0:06:11.63,0:06:14.80,Default,,0,0,0,,Онымен жақындамай қалай күресуге болады...
Dialogue: 0,0:06:14.80,0:06:17.97,Default,,0,0,0,,Варина. Мен қазір өзіммен сөйлесіп жатырмын.
Dialogue: 0,0:06:17.97,0:06:19.98,Default,,0,0,0,,Сәлем Зараки!
Dialogue: 0,0:06:19.98,0:06:23.81,Default,,0,0,0,,Егер бұл белгісіз күш болса, күш сізге жеткенше➡
Dialogue: 0,0:06:23.81,0:06:26.31,Default,,0,0,0,,Оны екіге бөліңіз!
Dialogue: 0,0:06:26.31,0:06:28.32,Default,,0,0,0,,Чий!
Dialogue: 0,0:06:30.82,0:06:33.32,Default,,0,0,0,,Аа...
Dialogue: 0,0:06:35.66,0:06:38.33,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:06:38.33,0:06:40.33,Default,,0,0,0,,Қайдан бастарын білмеймін.
Dialogue: 0,0:06:40.33,0:06:44.83,Default,,0,0,0,,Уф... уф... уф!
Dialogue: 0,0:06:48.34,0:06:50.34,Default,,0,0,0,,Аһ!
Dialogue: 0,0:06:56.51,0:07:00.45,Default,,0,0,0,,Теме….
Dialogue: 0,0:07:00.45,0:07:05.95,Default,,0,0,0,,Мм, аяқ-қолды тоқтатқанда қалғандары сынып кете ме деп ойлаймын.
Dialogue: 0,0:07:05.95,0:07:08.96,Default,,0,0,0,,Хикисацу Джизо.
Dialogue: 0,0:07:08.96,0:07:11.46,Default,,0,0,0,,Қорқыныштың төрт дәрежесі.
Dialogue: 0,0:07:13.46,0:07:15.46,Default,,0,0,0,,Огия!
Dialogue: 0,0:07:15.46,0:07:17.80,Default,,0,0,0,,Уф! Құлағыңызды жабыңыз.
Dialogue: 0,0:07:17.80,0:07:20.50,Default,,0,0,0,,4 секунд тыңдау жансызданады.
Dialogue: 0,0:07:23.14,0:07:26.64,Default,,0,0,0,,Анестезия жұмыс істеп тұр, бұл жақсы нәрсе.
Dialogue: 0,0:07:28.64,0:07:31.31,Default,,0,0,0,,Бұл жігіттің күші әлі де пайдалы.
Dialogue: 0,0:07:31.31,0:07:35.15,Default,,0,0,0,,Мені осы жерде котлетке айналдырса, әбігер болар еді.
Dialogue: 0,0:07:35.15,0:07:37.99,Default,,0,0,0,,Ал анестезия жұмыс істеді➡
Dialogue: 0,0:07:37.99,0:07:42.16,Default,,0,0,0,,Сіздің күшіңіздің шынайы табиғаты да табиғи түрде бөлінген.
Dialogue: 0,0:07:42.16,0:07:45.49,Default,,0,0,0,,Басқаша айтқанда, бұл жүйке.
Dialogue: 0,0:07:45.49,0:07:49.16,Default,,0,0,0,,Нервтеріңізді жаудың денесіне кіргізесіз➡
Dialogue: 0,0:07:49.16,0:07:52.17,Default,,0,0,0,,Қозғалыс күшпен басқарылады.
Dialogue: 0,0:07:52.17,0:07:54.67,Default,,0,0,0,,Мен болжам жасадым.
Dialogue: 0,0:07:54.67,0:07:58.17,Default,,0,0,0,,Жоюшы тамырына рух құяды➡
Dialogue: 0,0:07:58.17,0:08:00.44,Default,,0,0,0,,Оны өз күшіңізге айналдыра аласыз деп естідім.
Dialogue: 0,0:08:00.44,0:08:05.95,Default,,0,0,0,,Егер солай болса, онда рухани балалармен бірге денелеріндегі басқа нәрселерді басқара алатын адамдардың болуы таңқаларлық емес.
Dialogue: 0,0:08:05.95,0:08:11.45,Default,,0,0,0,,Жарайды, қандай процесс болса да, шынайы тұлға ашылып жатса, одан қорқатын ештеңе жоқ.
Dialogue: 0,0:08:18.63,0:08:21.63,Default,,0,0,0,,Ги!
Dialogue: 0,0:08:21.63,0:08:26.30,Default,,0,0,0,,Бұл ауырады ма? Ашық нервтерді жалайтын қышқыл.
Dialogue: 0,0:08:26.30,0:08:29.47,Default,,0,0,0,,Сіздің күшіңіз өте қызық.
Dialogue: 0,0:08:29.47,0:08:34.81,Default,,0,0,0,,Жігіт-уф-уф....
Dialogue: 0,0:08:34.81,0:08:37.48,Default,,0,0,0,,Ақырын ләззат алайық.
Dialogue: 0,0:08:37.48,0:08:42.65,Default,,0,0,0,,Өйткені жүйкеге әсер ететін дәрілер өте көп.
Dialogue: 0,0:08:42.65,0:08:46.15,Default,,0,0,0,,Әй, мен сені сен үшін пышақтадым.
Dialogue: 0,0:08:46.15,0:08:48.16,Default,,0,0,0,,Мен ештеңе істей алмадым.
Dialogue: 0,0:08:48.16,0:08:53.33,Default,,0,0,0,,Өтінемін, бұлай ренжімеңіз.
Dialogue: 0,0:08:53.33,0:08:57.00,Default,,0,0,0,,Уа, мен сенің көз алмаңды ғана қозғалта алатыныңа сенбеймін.
Dialogue: 0,0:08:57.00,0:08:59.93,Default,,0,0,0,,Бұл құбыжық.
Dialogue: 0,0:08:59.93,0:09:02.94,Default,,0,0,0,,Жоқ, келесі жолы сені пышақтап алғанша➡
Dialogue: 0,0:09:02.94,0:09:07.44,Default,,0,0,0,,Хикисацу Джизоның сал ауруын одан әрі жақсартайық.
Dialogue: 0,0:09:07.44,0:09:13.11,Default,,0,0,0,,Қарсыластың қабілеттерін ғана емес, сонымен қатар Хикисацу Джизоны жақсартуға арналған бөлме➡
Dialogue: 0,0:09:13.11,0:09:15.45,Default,,0,0,0,,Сіз мені түсіндірдіңіз➡
Dialogue: 0,0:09:15.45,0:09:20.96,Default,,0,0,0,,Саған деген екі ауыз сөзім – алғыс.
Dialogue: 0,0:09:20.96,0:09:24.13,Default,,0,0,0,,Бейбақ! Сіз капитанға әдейі кіріп кетуіне жол бердіңіз.
Dialogue: 0,0:09:24.13,0:09:28.13,Default,,0,0,0,,Қарсыластың қабілеттері қызықты көрінеді, сондықтан мен жалғыз соғысқым келеді➡
Dialogue: 0,0:09:28.13,0:09:31.63,Default,,0,0,0,,Сонымен капитан жолға түсті...
Dialogue: 0,0:09:31.63,0:09:35.47,Default,,0,0,0,,Әдеттегідей сол капитан.
Dialogue: 0,0:09:35.47,0:09:38.81,Default,,0,0,0,,Иә, солай деп үміттенемін.
Dialogue: 0,0:09:38.81,0:09:40.81,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:09:42.98,0:09:46.98,Default,,0,0,0,,Жоқ. Бұл дәл айтқандарын білдіреді.
Dialogue: 0,0:09:46.98,0:09:50.15,Default,,0,0,0,,Енді менің сүйікті Готей 13 Корпусы➡
Dialogue: 0,0:09:50.15,0:09:54.16,Default,,0,0,0,,Ол капитандардың бірі ретінде осындай қымбат құрбандық жасады➡
Dialogue: 0,0:09:54.16,0:09:59.33,Default,,0,0,0,,Біз сіздің қабілеттеріңіздің шынайы табиғаты туралы құнды ақпарат алдық.
Dialogue: 0,0:09:59.33,0:10:05.83,Default,,0,0,0,,Бұл нені білдіретінін білесіз бе? Сіз біртүрлі жоюшы.
Dialogue: 0,0:10:05.83,0:10:08.50,Default,,0,0,0,,Жауап жоқ, бірақ жалғастырайық.
Dialogue: 0,0:10:08.50,0:10:10.84,Default,,0,0,0,,Менің айтқым келгені мынау➡
Dialogue: 0,0:10:10.84,0:10:16.68,Default,,0,0,0,,Мен бұл елжірететін құрбандыққа көз жасымды төгудің алдында тұрмын.
Dialogue: 0,0:10:16.68,0:10:21.85,Default,,0,0,0,,Бағалы жеңіс әрқашан қымбат құрбандықпен келеді.
Dialogue: 0,0:10:21.85,0:10:26.19,Default,,0,0,0,,Әлгі бейбақ! Айтуға қалай батылыңыз бар!
Dialogue: 0,0:10:26.19,0:10:31.53,Default,,0,0,0,,Демек, сіз осы әсерлі құрбандықты құрметтейсіз➡
Dialogue: 0,0:10:31.53,0:10:33.53,Default,,0,0,0,,Денені эксперимент нысаны ретінде пайдаланыңыз➡
Dialogue: 0,0:10:33.53,0:10:36.87,Default,,0,0,0,,Сіз оны маған құрбан етуіңіз керек деп жатырсыз!
Dialogue: 0,0:10:36.87,0:10:40.54,Default,,0,0,0,,Уу-у-у-у-у!
Dialogue: 0,0:10:40.54,0:10:43.87,Default,,0,0,0,,Ой, сенбеген сияқтысың.
Dialogue: 0,0:10:43.87,0:10:46.71,Default,,0,0,0,,Романтиканы түсінбейтін түзу жігітке ұқсайды.
Dialogue: 0,0:10:46.71,0:10:48.71,Default,,0,0,0,,Уф!
Dialogue: 0,0:10:58.72,0:11:00.99,Default,,0,0,0,,Шын жүректен осылай сезінемін
Dialogue: 0,0:11:00.99,0:11:05.16,Default,,0,0,0,,Уу... Уу!
Dialogue: 0,0:11:05.16,0:11:07.66,Default,,0,0,0,,Бұл не? ?
Dialogue: 0,0:11:07.66,0:11:11.83,Default,,0,0,0,,Менің ойымша, бұл күтпеген жағдай.
Dialogue: 0,0:11:11.83,0:11:15.54,Default,,0,0,0,,Рух патшасының сол қолы.
Dialogue: 0,0:11:30.35,0:11:33.69,Default,,0,0,0,,...
Dialogue: 0,0:11:33.69,0:11:36.59,Default,,0,0,0,,Вуля!
Dialogue: 0,0:11:40.70,0:11:43.70,Default,,0,0,0,,Бұл құбыжық Рух патшасының сол қолы! ?
Dialogue: 0,0:11:43.70,0:11:47.70,Default,,0,0,0,,Рух патшасы соншалықты ақымақ па? ?
Dialogue: 0,0:11:47.70,0:11:51.04,Default,,0,0,0,,Білмеймін, өйткені мен оны ешқашан кездестірмегенмін➡
Dialogue: 0,0:11:51.04,0:11:56.21,Default,,0,0,0,,Реиацу шынымен де Укитакеден жиналғанмен бірдей.
Dialogue: 0,0:11:56.21,0:11:59.05,Default,,0,0,0,,Укитаке➡-мен келісім-шартқа отырған
Dialogue: 0,0:11:59.05,0:12:02.32,Default,,0,0,0,,Егер ол Рух патшасының оң қолы болса➡
Dialogue: 0,0:12:02.32,0:12:06.15,Default,,0,0,0,,Сол қол Рух патшасынан алыстаса да➡
Dialogue: 0,0:12:06.15,0:12:09.16,Default,,0,0,0,,Ешқандай сұрақ жоқ.
Dialogue: 0,0:12:09.16,0:12:11.66,Default,,0,0,0,,Күмән бар ма?
Dialogue: 0,0:12:11.66,0:12:15.33,Default,,0,0,0,,Оның да қолында жалғыз көзі бар біртүрлі түрі бар➡
Dialogue: 0,0:12:15.33,0:12:17.83,Default,,0,0,0,,Кисуке Урахара айтқандай.
Dialogue: 0,0:12:17.83,0:12:21.00,Default,,0,0,0,,Ал, мен оны монокуляр деп атау керек пе, білмеймін.➡
Dialogue: 0,0:12:21.00,0:12:23.84,Default,,0,0,0,,Пікірлер екіге бөлінген.
Dialogue: 0,0:12:23.84,0:12:26.34,Default,,0,0,0,,Урья!
Dialogue: 0,0:12:26.34,0:12:28.34,Default,,0,0,0,,Фуфуфу! Апыр-ай! ?
Dialogue: 0,0:12:30.35,0:12:33.01,Default,,0,0,0,,Игья! Жалғыз сұрақ➡
Dialogue: 0,0:12:33.01,0:12:37.52,Default,,0,0,0,,Неліктен Рух Патшасының сол қолы Юхабахтың астында?
Dialogue: 0,0:12:37.52,0:12:40.86,Default,,0,0,0,,Бірақ, мұндай сұрақтар➡
Dialogue: 0,0:12:40.86,0:12:44.69,Default,,0,0,0,,Бұл қуанышпен салыстырғанда бұл кішкентай нәрсе.
Dialogue: 0,0:12:44.69,0:12:47.70,Default,,0,0,0,,Йорокоби?
Dialogue: 0,0:12:47.70,0:12:51.37,Default,,0,0,0,,Сіз қарым-қатынас жасай аласыз ба? Бұл да күтпеген жағдай болды.
Dialogue: 0,0:12:51.37,0:12:55.04,Default,,0,0,0,,Дауысты қандай мүше арқылы шығарады?
Dialogue: 0,0:12:55.04,0:12:57.54,Default,,0,0,0,,Менің қызығушылығым шексіз.
Dialogue: 0,0:12:57.54,0:13:00.64,Default,,0,0,0,,Капитан Нирука! Күлдіруді тоқтатыңыз және жүгіріңіз!
Dialogue: 0,0:13:00.64,0:13:03.98,Default,,0,0,0,,Бұл жағдайда не нәрсеге қуаныштысың?
Dialogue: 0,0:13:03.98,0:13:06.81,Default,,0,0,0,,Сізді сонша бақытты ететін не?
Dialogue: 0,0:13:06.81,0:13:09.48,Default,,0,0,0,,Бақылау үшін бұрын ешқашан көрмеген затты табыңыз➡
Dialogue: 0,0:13:09.48,0:13:12.99,Default,,0,0,0,,Бұл біздің күткенімізден бірінен соң бірі асып түседі!
Dialogue: 0,0:13:12.99,0:13:16.82,Default,,0,0,0,,Бұл қуаныш болмаса, онда не болады!
Dialogue: 0,0:13:16.82,0:13:19.13,Default,,0,0,0,,Урия!
Dialogue: 0,0:13:21.50,0:13:25.67,Default,,0,0,0,,Дұрыс, маған көбірек көрсет! Рух патшасының сол қолы!
Dialogue: 0,0:13:25.67,0:13:32.67,Default,,0,0,0,,Хидари... Уде аты... Чиғау.
Dialogue: 0,0:13:32.67,0:13:34.84,Default,,0,0,0,,Иә? Не?
Dialogue: 0,0:13:34.84,0:13:37.85,Default,,0,0,0,,Оны қаттырақ айтыңыз.
Dialogue: 0,0:13:37.85,0:13:41.35,Default,,0,0,0,,Аты... Пернида.
Dialogue: 0,0:13:41.35,0:13:44.19,Default,,0,0,0,,...
Dialogue: 0,0:13:44.19,0:13:49.69,Default,,0,0,0,,Ұзын. Әуелі оны сен емес мен аштым.
Dialogue: 0,0:13:49.69,0:13:52.19,Default,,0,0,0,,Атау құқығы маған тиесілі.
Dialogue: 0,0:13:52.19,0:13:56.03,Default,,0,0,0,,Бірақ, бұл адамның өз өтініші.
Dialogue: 0,0:13:56.03,0:13:59.37,Default,,0,0,0,,Біз бұған ерекше ерекшелік ретінде жол бермейміз.
Dialogue: 0,0:13:59.37,0:14:02.97,Default,,0,0,0,,Сіз мұны реніштен айтып отырсыз. Әрқашан, иә?
Dialogue: 0,0:14:02.97,0:14:06.97,Default,,0,0,0,,Дегенмен емлені шешуге рұқсат етемін.
Dialogue: 0,0:14:06.97,0:14:11.48,Default,,0,0,0,,Итеруими… Вакаранай….
Dialogue: 0,0:14:11.48,0:14:18.49,Default,,0,0,0,,Вакаранайкото дайтай варукучи.
Dialogue: 0,0:14:18.49,0:14:25.83,Default,,0,0,0,,Қош келдіңіз.
Dialogue: 0,0:14:25.83,0:14:29.16,Default,,0,0,0,,Жаман сөз болса не керегі бар?
Dialogue: 0,0:14:29.16,0:14:31.57,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:14:34.84,0:14:37.17,Default,,0,0,0,,О!
Dialogue: 0,0:14:37.17,0:14:40.34,Default,,0,0,0,,Нервтердің бейорганикалық заттар арқылы өтуі мүмкін.
Dialogue: 0,0:14:40.34,0:14:43.68,Default,,0,0,0,,Күтпеген. Жақсы.
Dialogue: 0,0:14:43.68,0:14:53.86,Default,,0,0,0,,♪～
Dialogue: 0,0:14:53.86,0:14:56.52,Default,,0,0,0,,Хун.
Dialogue: 0,0:14:56.52,0:15:13.98,Default,,0,0,0,,♪～
Dialogue: 0,0:15:13.98,0:15:15.98,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:15:27.32,0:15:30.99,Default,,0,0,0,,Хашвальд екеуің бірдейсіңдер, солай емес пе?
Dialogue: 0,0:15:30.99,0:15:33.33,Default,,0,0,0,,Онда баруға болады.
Dialogue: 0,0:15:33.33,0:15:35.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:35.33,0:15:37.50,Default,,0,0,0,,Мәртебелі, біз жасаймыз.
Dialogue: 0,0:15:37.50,0:15:40.50,Default,,0,0,0,,Ха, мен екеуін де жеңемін.
Dialogue: 0,0:15:40.50,0:15:45.51,Default,,0,0,0,,Мәртебелі және Хашвальдтың зомбиі Менің оны көргім келеді.
Dialogue: 0,0:15:45.51,0:15:48.01,Default,,0,0,0,,Кеттік.
Dialogue: 0,0:15:50.01,0:15:52.01,Default,,0,0,0,,Капитан Нирука!
Dialogue: 0,0:15:52.01,0:15:56.02,Default,,0,0,0,,Айқайламаңыз. Бұл жай ғана жарылғыш реактивті бронь.
Dialogue: 0,0:15:56.02,0:16:00.02,Default,,0,0,0,,Түсініктеме берілмейді. Әрқайсысын сөздіктен іздеңіз.
Dialogue: 0,0:16:01.96,0:16:05.79,Default,,0,0,0,,Жоқ, капитан Нируки! Оның нервтері жерде!
Dialogue: 0,0:16:05.79,0:16:07.80,Default,,0,0,0,,Иә.
Dialogue: 0,0:16:09.96,0:16:11.97,Default,,0,0,0,,Хмф! ?
Dialogue: 0,0:16:11.97,0:16:14.47,Default,,0,0,0,,Бұл таныс сияқты ма?
Dialogue: 0,0:16:14.47,0:16:21.81,Default,,0,0,0,,Әрине. Бұл сіз аннигиляторлар қолданатын ауада жүру техникасы.
Dialogue: 0,0:16:21.81,0:16:24.15,Default,,0,0,0,,Дегенмен, бұл Мунэцуру Ишида➡
Dialogue: 0,0:16:24.15,0:16:26.98,Default,,0,0,0,,Бұл Урю Ишида➡ қолданған есім
Dialogue: 0,0:16:26.98,0:16:31.65,Default,,0,0,0,,Бастапқы атау басқа нәрсе болуы мүмкін.
Dialogue: 0,0:16:31.65,0:16:36.16,Default,,0,0,0,,Қалай болғанда да, жүйкеңізді осы жерге таратып жіберсеңіз де➡
Dialogue: 0,0:16:36.16,0:16:40.66,Default,,0,0,0,,Баспасаң, ештеңені білдірмейді!
Dialogue: 0,0:16:40.66,0:16:45.50,Default,,0,0,0,,Уау! Ой... жек көремін!
Dialogue: 0,0:16:45.50,0:16:49.50,Default,,0,0,0,,Енді үлгіні жоспарланғандай алайық.
Dialogue: 0,0:16:51.51,0:16:54.01,Default,,0,0,0,,Не дедің, жауыз бала! (Киришима & Серо) Қайтып келдік.
Dialogue: 0,0:16:56.01,0:16:58.11,Default,,0,0,0,,Қорғаныс сұйықтығы.
Dialogue: 0,0:17:00.11,0:17:05.29,Default,,0,0,0,,Білгің келе ме? Шайқас біткен соң мен резервуар жасаймын➡
Dialogue: 0,0:17:05.29,0:17:08.09,Default,,0,0,0,,Осы уақытқа дейін бұл оның жаңалығын сақтайды.
Dialogue: 0,0:17:10.79,0:17:13.63,Default,,0,0,0,,Не! ?
Dialogue: 0,0:17:13.63,0:17:16.03,Default,,0,0,0,,Уф!
Dialogue: 0,0:17:18.63,0:17:23.14,Default,,0,0,0,,Жүйкелердің, қан тамырларының және бұлшықеттердің орналасуы қайта реттелді.
Dialogue: 0,0:17:23.14,0:17:26.97,Default,,0,0,0,,Менің денемді басқара аламын деп ойлама.
Dialogue: 0,0:17:26.97,0:17:29.48,Default,,0,0,0,,Пернида.
Dialogue: 0,0:17:31.81,0:17:33.98,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:17:33.98,0:17:37.82,Default,,0,0,0,,Бір қолыма операция жасамағаныма біраз болды, сондықтан түйсігім түтіккен шығар.
Dialogue: 0,0:17:37.82,0:17:41.49,Default,,0,0,0,,Бұл ұят.
Dialogue: 0,0:17:41.49,0:17:46.99,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:17:46.99,0:17:49.16,Default,,0,0,0,,Соған ұқсайды ма?
Dialogue: 0,0:17:49.16,0:17:52.17,Default,,0,0,0,,Му шо әсел?
Dialogue: 0,0:17:58.17,0:18:00.68,Default,,0,0,0,,Яаада!
Dialogue: 0,0:18:03.11,0:18:06.61,Default,,0,0,0,,Жыртылған саусақ басқа сол қолға айнала ма?
Dialogue: 0,0:18:06.61,0:18:10.62,Default,,0,0,0,,Мен оны үйге бөлшектеп апара алмаймын деп ойлаймын.
Dialogue: 0,0:18:17.79,0:18:21.80,Default,,0,0,0,,Мусшо Шиасель?
Dialogue: 0,0:18:21.80,0:18:24.80,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:18:24.80,0:18:29.47,Default,,0,0,0,,Әй, көзім қанды, ыстық...
Dialogue: 0,0:18:29.47,0:18:33.31,Default,,0,0,0,,Жас кезімде оқыған бір кітапта бұл бар еді.
Dialogue: 0,0:18:33.31,0:18:39.31,Default,,0,0,0,,Рух патшасының оң қолы қозғалыссыз қалады. Сол қол алға қозғалысты басқарады.
Dialogue: 0,0:18:39.31,0:18:43.15,Default,,0,0,0,,Кітаптан алынған білім негізгі білімнен басқа ештеңе емес.
Dialogue: 0,0:18:43.15,0:18:48.49,Default,,0,0,0,,Мен өз қолыммен дәлелдемейінше сенбеймін.
Dialogue: 0,0:18:48.49,0:18:53.49,Default,,0,0,0,,Екеуін де соншалықты тез сезінемін деп ойламаппын.
Dialogue: 0,0:18:53.49,0:18:58.17,Default,,0,0,0,,Қандай керемет шайқас!
Dialogue: 0,0:18:58.17,0:19:03.07,Default,,0,0,0,,Урия!
Dialogue: 0,0:19:10.78,0:19:13.11,Default,,0,0,0,,Банкай.
Dialogue: 0,0:19:13.11,0:19:15.28,Default,,0,0,0,,Нашар! Бұл алтын өлтіруші Джизо!
Dialogue: 0,0:19:15.28,0:19:18.95,Default,,0,0,0,,Мен бұл аймақты улап, оны улаймын!
Dialogue: 0,0:19:18.95,0:19:20.96,Default,,0,0,0,,Капитан Зараки!
Dialogue: 0,0:19:20.96,0:19:25.56,Default,,0,0,0,,Улану? Осындай ысырапшылдықпен айналысу ысырап па?
Dialogue: 0,0:19:39.81,0:19:42.01,Default,,0,0,0,,Келіңіздер.
Dialogue: 0,0:19:47.48,0:19:49.48,Default,,0,0,0,,Бұл жақын мерзім.
Dialogue: 0,0:19:51.49,0:19:56.82,Default,,0,0,0,,Алтын Бокусацу Джизо жындық жатырдың әсер синдромы денесі!
Dialogue: 0,0:19:56.82,0:19:59.33,Default,,0,0,0,,Хаха…. Бұл не? ?
Dialogue: 0,0:19:59.33,0:20:01.83,Default,,0,0,0,,Бұл өзгертілген Банкай.
Dialogue: 0,0:20:01.83,0:20:04.00,Default,,0,0,0,,Жындық жатыр синдромының денесі ➡
Dialogue: 0,0:20:04.00,0:20:08.67,Default,,0,0,0,,Алтын Хикисацу Джизоны өзгерту арқылы жасаған біртүрлі пішін.
Dialogue: 0,0:20:08.67,0:20:12.51,Default,,0,0,0,,Оның қабілеттері ұрыс кезінде жіберілген ақпаратқа негізделген➡
Dialogue: 0,0:20:12.51,0:20:16.01,Default,,0,0,0,,Жаңа Хикисацу Джизо тудыру.
Dialogue: 0,0:20:16.01,0:20:18.01,Default,,0,0,0,,Ум! ?
Dialogue: 0,0:20:18.01,0:20:20.85,Default,,0,0,0,,Оның мағынасын білмейсіз бе?
Dialogue: 0,0:20:20.85,0:20:25.02,Default,,0,0,0,,Оны көргенде білесің.
Dialogue: 0,0:20:25.02,0:20:33.53,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:20:39.37,0:20:41.37,Default,,0,0,0,,Гах.
Dialogue: 0,0:20:41.37,0:20:46.04,Default,,0,0,0,,Бұл Хикисацу Джизо денесінің бетінде нервтер бар.
Dialogue: 0,0:20:46.04,0:20:49.04,Default,,0,0,0,,Гах! Сондықтан ауаны ұстасаңыз да➡
Dialogue: 0,0:20:49.04,0:20:52.88,Default,,0,0,0,,Мен жерге тисем де, қатты ауырамын➡
Dialogue: 0,0:20:52.88,0:20:56.08,Default,,0,0,0,,Ал, мұны бір жаққа қалдырыңыз.
Dialogue: 0,0:20:58.55,0:21:01.32,Default,,0,0,0,,Маңыздысы дене бетіндегі жүйкелер➡
Dialogue: 0,0:21:01.32,0:21:05.16,Default,,0,0,0,,Ол 70 000 қабатқа бөлінген.
Dialogue: 0,0:21:05.16,0:21:10.16,Default,,0,0,0,,Былайша айтқанда, жігіттер бұл жігітке нервтеріңізді салсаңыздар➡
Dialogue: 0,0:21:10.16,0:21:13.37,Default,,0,0,0,,Бір алдыңғы парақ Бүктеп, аяқтаңыз.
Dialogue: 0,0:21:17.84,0:21:20.67,Default,,0,0,0,,Не дедің, жауыз бала! (Киришима & Серо) Қайтып келдік.
Dialogue: 0,0:21:20.67,0:21:23.01,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:23.01,0:21:27.11,Default,,0,0,0,,Оу!
Dialogue: 0,0:21:29.18,0:21:32.52,Default,,0,0,0,,Оу!
Dialogue: 0,0:21:32.52,0:21:34.52,Default,,0,0,0,,Ах! ?
Dialogue: 0,0:21:34.52,0:21:38.86,Default,,0,0,0,,Не болды? Қарсылық танытқан дұрыс.
Dialogue: 0,0:21:38.86,0:21:44.57,Default,,0,0,0,,Бүкіл денем жұтылып біткенше 70 000 рет жүйкеге тиіп кетсем ғой.
Dialogue: 0,0:21:46.53,0:21:48.54,Default,,0,0,0,,Иә.
Dialogue: 0,0:21:56.71,0:21:58.71,Default,,0,0,0,,(жұтыну дыбысы)
Dialogue: 0,0:21:58.71,0:22:01.15,Default,,0,0,0,,Гефу.
Dialogue: 0,0:22:01.15,0:22:08.66,Default,,0,0,0,,Хехехехе хахахахаха!
Dialogue: 0,0:22:08.66,0:22:11.66,Default,,0,0,0,,Хахахахахаха!
Dialogue: 0,0:22:13.16,0:22:19.16,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
