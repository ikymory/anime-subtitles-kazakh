Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.00,0:00:06.04,Default,,0,0,0,,Мен шайқаса аламын!
Dialogue: 0,0:00:51.46,0:00:52.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:54.51,0:00:56.01,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:00:56.51,0:01:00.72,Default,,0,0,0,,Бұл сұрақ па? Әлде сіз өзіңізбен сөйлесесіз бе?
Dialogue: 0,0:01:01.22,0:01:03.48,Default,,0,0,0,,Жеке сөз болса, мен оны елемеймін.
Dialogue: 0,0:01:03.98,0:01:04.85,Default,,0,0,0,,(Кодай) Босат! (Шода) Оны босатыңдар!
Dialogue: 0,0:01:04.93,0:01:08.77,Default,,0,0,0,,Екеуіміз де бір-бірімізге бірінші рет көрген нәрселер туралы сұрақ қоятындай ақымақпыз.
Dialogue: 0,0:01:08.86,0:01:11.86,Default,,0,0,0,,Менің ойымша, ол 13-ші топта емес.
Dialogue: 0,0:01:11.94,0:01:14.24,Default,,0,0,0,,-ге келгенде, оны елемеу табиғи нәрсе...
Dialogue: 0,0:01:14.32,0:01:16.20,Default,,0,0,0,,Мен оны бәрібір өлтіруім керек пе?
Dialogue: 0,0:01:17.07,0:01:19.37,Default,,0,0,0,,Бірдеңе айтқың келген сияқты, Нему.
Dialogue: 0,0:01:19.45,0:01:21.83,Default,,0,0,0,,Мүлдем емес, Маюри-сама.
Dialogue: 0,0:01:25.25,0:01:26.75,Default,,0,0,0,,-Ах! - (Кенпачи) Әй!
Dialogue: 0,0:01:26.83,0:01:28.25,Default,,0,0,0,,Күте тұрыңыз, Зараки!
Dialogue: 0,0:01:32.25,0:01:33.38,Default,,0,0,0,,Зараки…
Dialogue: 0,0:01:34.01,0:01:35.92,Default,,0,0,0,,О, ештеңе.
Dialogue: 0,0:01:37.80,0:01:40.30,Default,,0,0,0,,Тек бір қолы зақымдалған.
Dialogue: 0,0:01:41.68,0:01:45.23,Default,,0,0,0,,Оның орнына мен бейбақтың басын жарып жібердім.
Dialogue: 0,0:01:52.32,0:01:53.36,Default,,0,0,0,,Хмм!
Dialogue: 0,0:02:02.45,0:02:04.08,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:02:12.13,0:02:16.51,Default,,0,0,0,,Бұл сұрақ па? Әлде сіз өзіңізбен сөйлесесіз бе?
Dialogue: 0,0:02:17.51,0:02:19.51,Default,,0,0,0,,♪～
Dialogue: 0,0:03:44.93,0:03:46.93,Default,,0,0,0,,～♪
Dialogue: 0,0:03:48.06,0:03:50.60,Default,,0,0,0,,Менің басым үлкейіп барады
Dialogue: 0,0:03:50.68,0:03:52.52,Default,,0,0,0,,Не болды?
Dialogue: 0,0:03:52.60,0:03:55.69,Default,,0,0,0,,Бұл өзгеріс шайқас үшін жарамсыз болып көрінеді, бірақ
Dialogue: 0,0:03:55.77,0:03:59.44,Default,,0,0,0,,Бұл не үшін екен деп ойлаймын, ол сұмдық жігіт.
Dialogue: 0,0:03:59.53,0:04:01.19,Default,,0,0,0,,Сіз мұны айтпайсыз ба?
Dialogue: 0,0:04:01.28,0:04:03.49,Default,,0,0,0,,Бұл кететін уақыт емес.
Dialogue: 0,0:04:03.57,0:04:05.62,Default,,0,0,0,,Идиот! Сізге шығудың қажеті жоқ.
Dialogue: 0,0:04:05.70,0:04:08.20,Default,,0,0,0,,Егер сіз шатассаңыз, қатты ашуланасыз.
Dialogue: 0,0:04:08.70,0:04:10.54,Default,,0,0,0,,Өміріме қауіп төндірушілер болуы мүмкін.
Dialogue: 0,0:04:11.33,0:04:14.50,Default,,0,0,0,,Өз пікіріңді білдіру сирек.
Dialogue: 0,0:04:14.58,0:04:15.79,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:04:15.88,0:04:19.55,Default,,0,0,0,,Маюри-сама мені шақырмайынша қозғалма деді.
Dialogue: 0,0:04:19.63,0:04:21.67,Default,,0,0,0,,Өйткені ол әрқашан бұйырылады
Dialogue: 0,0:04:21.76,0:04:26.80,Default,,0,0,0,,Маюри-саманы дұшпан итеріп, мені шақыра алмайды деп ойлаймын.
Dialogue: 0,0:04:26.89,0:04:31.06,Default,,0,0,0,,Сіз не айтып тұрсыз? Тіпті капитан Зараки де солай.
Dialogue: 0,0:04:37.94,0:04:38.86,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:38.94,0:04:40.15,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:04:40.23,0:04:41.23,Default,,0,0,0,,Сынған қол!
Dialogue: 0,0:04:43.44,0:04:44.74,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:04:46.07,0:04:46.61,Default,,0,0,0,,Уф!
Dialogue: 0,0:04:56.71,0:04:59.38,Default,,0,0,0,,Қанға айналғанша бүктелген
Dialogue: 0,0:04:59.46,0:05:01.30,Default,,0,0,0,,Не болып жатыр...
Dialogue: 0,0:05:01.38,0:05:04.51,Default,,0,0,0,,Жоқ, жоқ, бұл аз.
Dialogue: 0,0:05:04.59,0:05:07.89,Default,,0,0,0,,Қолыңызды бірден созу дұрыс шешім болды.
Dialogue: 0,0:05:07.97,0:05:10.60,Default,,0,0,0,,Капитан Зараки күткендей
Dialogue: 0,0:05:10.68,0:05:15.44,Default,,0,0,0,,Егер сіз бұл шешімді бір сәтте қабылдамаған болсаңыз, қазір бүкіл денеңіз шиеленісіп кетер еді.
Dialogue: 0,0:05:15.52,0:05:20.57,Default,,0,0,0,,Дәмсіз, жұмсақ, қанша котлетке айналар еді деп ойлаймын.
Dialogue: 0,0:05:20.65,0:05:24.15,Default,,0,0,0,,Сіз мені мақтайсыз ба, әлде төбелесіп жатырсыз ба?
Dialogue: 0,0:05:24.24,0:05:26.65,Default,,0,0,0,,Қайсысы деп ойлайсың?
Dialogue: 0,0:05:26.74,0:05:28.70,Default,,0,0,0,,Қайсысы да жақсы.
Dialogue: 0,0:05:28.78,0:05:31.37,Default,,0,0,0,,Бұл жігіттің қабілеті не болып жатыр?
Dialogue: 0,0:05:31.45,0:05:36.25,Default,,0,0,0,,Дәл солай, бұл сұрақ па, әлде жеке әңгіме ме, шеше алмаймын.
Dialogue: 0,0:05:36.75,0:05:39.96,Default,,0,0,0,,Бірақ қалай болғанда да, мен білмеймін.
Dialogue: 0,0:05:40.04,0:05:45.59,Default,,0,0,0,,Әзірге тек одан аулақ жүр деп айта аламын.
Dialogue: 0,0:05:45.67,0:05:47.63,Default,,0,0,0,,«Жақын келме»?
Dialogue: 0,0:05:47.72,0:05:51.05,Default,,0,0,0,,Нему Қанды тоқтату үшін бұл жігіттің қолдарын байлаңыз.
Dialogue: 0,0:05:51.14,0:05:51.72,Default,,0,0,0,,Иә
Dialogue: 0,0:05:51.80,0:05:53.51,Default,,0,0,0,,Ақымақ болма.
Dialogue: 0,0:05:53.60,0:05:56.60,Default,,0,0,0,,Мен жақындамасам, сені қалай өлтіремін?
Dialogue: 0,0:05:56.68,0:05:59.65,Default,,0,0,0,,Эй, менің тағы бір сұрағым бар.
Dialogue: 0,0:05:59.73,0:06:02.69,Default,,0,0,0,,Жекпе-жек тек қана ұрып-соғу емес.
Dialogue: 0,0:06:02.77,0:06:05.61,Default,,0,0,0,,Міне, онымен жақындамай-ақ күресуге болады...
Dialogue: 0,0:06:06.11,0:06:08.99,Default,,0,0,0,,Өкінішті, мен қазір өз-өзіммен сөйлесіп жатырмын.
Dialogue: 0,0:06:09.07,0:06:10.28,Default,,0,0,0,,Сәлем Зараки!
Dialogue: 0,0:06:10.37,0:06:12.83,Default,,0,0,0,,Егер бұл тылсым күш болса
Dialogue: 0,0:06:12.91,0:06:17.29,Default,,0,0,0,,Күш бізге жеткенше оны екіге бөліп алсақ болғаны.
Dialogue: 0,0:06:19.04,0:06:20.04,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:06:22.17,0:06:23.04,Default,,0,0,0,,Фу…
Dialogue: 0,0:06:26.51,0:06:27.55,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:29.55,0:06:30.51,Default,,0,0,0,,Қайдан бастарын білмеймін.
Dialogue: 0,0:06:30.59,0:06:33.01,Default,,0,0,0,,Арх! Нуууу...
Dialogue: 0,0:06:33.51,0:06:35.35,Default,,0,0,0,,Гвааах!
Dialogue: 0,0:06:39.10,0:06:40.23,Default,,0,0,0,,Мен шайқаса аламын!
Dialogue: 0,0:06:44.69,0:06:45.23,Default,,0,0,0,,(Құлаған қылыштың дыбысы)
Dialogue: 0,0:06:47.61,0:06:50.82,Default,,0,0,0,,...
Dialogue: 0,0:06:51.32,0:06:52.62,Default,,0,0,0,,Хмм
Dialogue: 0,0:06:52.70,0:06:56.87,Default,,0,0,0,,Әйтеуір, аяқ-қолыңды тоқтатып алсаң, қалғандары сынып кете ме?
Dialogue: 0,0:06:57.75,0:06:59.21,Default,,0,0,0,,Хикисацу Джизо
Dialogue: 0,0:07:00.21,0:07:01.62,Default,,0,0,0,,Қорқыныш 4
Dialogue: 0,0:07:04.17,0:07:06.13,Default,,0,0,0,,Огяаа!
Dialogue: 0,0:07:06.21,0:07:06.96,Default,,0,0,0,,Уф!
Dialogue: 0,0:07:07.05,0:07:08.46,Default,,0,0,0,,Құлағыңызды жабыңыз
Dialogue: 0,0:07:08.55,0:07:10.68,Default,,0,0,0,,4 секунд Оны естігенде мен сал болып қаламын.
Dialogue: 0,0:07:11.51,0:07:12.68,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:13.93,0:07:17.64,Default,,0,0,0,,Анестезияның жұмыс істеп жатқанына қуаныштымын.
Dialogue: 0,0:07:19.73,0:07:22.23,Default,,0,0,0,,Бұл жігіттің күші әлі де пайдалы.
Dialogue: 0,0:07:22.73,0:07:25.77,Default,,0,0,0,,Бұл жерде фрикадельге айналса, ыңғайсыздық тудырар еді.
Dialogue: 0,0:07:25.86,0:07:28.99,Default,,0,0,0,,Ал анестезия жұмыс істеді
Dialogue: 0,0:07:29.07,0:07:32.61,Default,,0,0,0,,Сіздің күшіңіздің шынайы табиғаты табиғи түрде бөлінген.
Dialogue: 0,0:07:33.11,0:07:34.12,Default,,0,0,0,,Яғни...
Dialogue: 0,0:07:34.62,0:07:36.28,Default,,0,0,0,,«Жүйкелер»
Dialogue: 0,0:07:36.78,0:07:40.33,Default,,0,0,0,,Жауыңның денесіне өз жүйкеңмен еніп кетесің.
Dialogue: 0,0:07:40.41,0:07:43.33,Default,,0,0,0,,Қозғалысты күштеп басқару
Dialogue: 0,0:07:43.42,0:07:45.04,Default,,0,0,0,,Мен ойладым.
Dialogue: 0,0:07:45.67,0:07:49.26,Default,,0,0,0,,Квинси тамырына рухты құяды.
Dialogue: 0,0:07:49.34,0:07:51.80,Default,,0,0,0,,Оны өз күшіңізге айналдыра аласыз деп естідім.
Dialogue: 0,0:07:51.88,0:07:56.72,Default,,0,0,0,,Олай болса, рухани балалармен бірге денелеріндегі басқа нәрселерді басқара алатын адамдардың болуы таңқаларлық емес.
Dialogue: 0,0:07:57.31,0:08:02.19,Default,,0,0,0,,Жарайды, қандай процесс болса да, шын тұлғасы ашылса, қорқу жеткіліксіз.
Dialogue: 0,0:08:09.61,0:08:12.53,Default,,0,0,0,,(Түрлі дауыс)
Dialogue: 0,0:08:12.61,0:08:16.95,Default,,0,0,0,,Бұл ауырады ма? Ашық нервтерді жалайтын қышқыл
Dialogue: 0,0:08:17.58,0:08:20.54,Default,,0,0,0,,Сіздің күшіңіз өте қызық.
Dialogue: 0,0:08:21.04,0:08:25.92,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:08:26.00,0:08:28.54,Default,,0,0,0,,Ақырын ләззат алайық.
Dialogue: 0,0:08:29.05,0:08:32.55,Default,,0,0,0,,Өйткені жүйкеге әсер ететін дәрілер өте көп.
Dialogue: 0,0:08:33.93,0:08:37.39,Default,,0,0,0,,Эй, мен сені сен үшін пышақтадым.
Dialogue: 0,0:08:37.47,0:08:39.22,Default,,0,0,0,,Қолдан келетін ештеңе болмады
Dialogue: 0,0:08:39.31,0:08:42.56,Default,,0,0,0,,Өтінемін, бұлай ренжімеңіз.
Dialogue: 0,0:08:44.31,0:08:48.36,Default,,0,0,0,,Ой, мен сіздің көз алмаңызды қозғалта алатыныңызға сене алар емеспін!
Dialogue: 0,0:08:48.44,0:08:50.69,Default,,0,0,0,,Бұл шынымен де ақымақ нәрсе.
Dialogue: 0,0:08:51.19,0:08:53.95,Default,,0,0,0,,Жоқ, мен сені келесі жолы пышақтағанша.
Dialogue: 0,0:08:54.03,0:08:58.49,Default,,0,0,0,,Хикисацу Джизоның сал ауруын одан әрі жақсартайық.
Dialogue: 0,0:08:58.57,0:09:01.74,Default,,0,0,0,,Тек жаудың қабілеті ғана емес
Dialogue: 0,0:09:01.83,0:09:06.42,Default,,0,0,0,,Сіз маған Хикисацу Джизоны жақсарту мүмкіндігін қалай түсіне аласыз?
Dialogue: 0,0:09:06.50,0:09:11.63,Default,,0,0,0,,Саған деген екі ауыз сөзім – алғыс.
Dialogue: 0,0:09:11.71,0:09:15.38,Default,,0,0,0,,Сен бейбақ... капитанға әдейі соқтығысуға жол бердің.
Dialogue: 0,0:09:15.47,0:09:19.14,Default,,0,0,0,,Жаудың қабілеттері қызық көрінеді, сондықтан мен жалғыз соғысқым келеді.
Dialogue: 0,0:09:19.22,0:09:22.47,Default,,0,0,0,,Сонда капитан бұған кедергі болды ма?
Dialogue: 0,0:09:23.14,0:09:26.10,Default,,0,0,0,,Әдеттегідей, сол капитан.
Dialogue: 0,0:09:26.98,0:09:29.61,Default,,0,0,0,,Иә, солай деп үміттенемін.
Dialogue: 0,0:09:30.27,0:09:31.48,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:09:34.44,0:09:35.36,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:09:35.44,0:09:37.45,Default,,0,0,0,,Сөзбе-сөз білдіреді
Dialogue: 0,0:09:37.95,0:09:42.79,Default,,0,0,0,,Енді менің сүйіктім, он үш Готей корпусының капитандарының бірі.
Dialogue: 0,0:09:42.87,0:09:45.25,Default,,0,0,0,,Тым қымбат құрбандық
Dialogue: 0,0:09:45.33,0:09:50.50,Default,,0,0,0,,Біз сіздің қабілеттеріңіздің шынайы табиғаты туралы құнды ақпарат алдық.
Dialogue: 0,0:09:50.59,0:09:53.13,Default,,0,0,0,,Бұл нені білдіретінін білесіз бе?
Dialogue: 0,0:09:53.88,0:09:55.76,Default,,0,0,0,,Біртүрлі Квинси
Dialogue: 0,0:09:56.72,0:09:59.05,Default,,0,0,0,,Жауап жоқ, бірақ жалғастырайық.
Dialogue: 0,0:09:59.55,0:10:01.76,Default,,0,0,0,,Менің айтайын дегенім осы
Dialogue: 0,0:10:01.85,0:10:07.48,Default,,0,0,0,,Мен бұл әсерлі құрбандыққа көз жасымды төгудің алдында тұрмын.
Dialogue: 0,0:10:07.56,0:10:12.86,Default,,0,0,0,,Бағалы жеңіс әрқашан қымбат құрбандықпен келеді.
Dialogue: 0,0:10:12.94,0:10:16.69,Default,,0,0,0,,Әлгі бейбақ... бұлай деуге қалай дәтің бар!
Dialogue: 0,0:10:17.32,0:10:22.45,Default,,0,0,0,,Сонымен, сіз осы әсерлі құрбандықты құрметтейсіз.
Dialogue: 0,0:10:22.53,0:10:27.46,Default,,0,0,0,,Маған тәжірибе ретінде өз денеңді ұсынуың керек дейді.
Dialogue: 0,0:10:27.54,0:10:30.25,Default,,0,0,0,,Уу… Уу…
Dialogue: 0,0:10:30.33,0:10:31.42,Default,,0,0,0,,Жолдан кет! Тәрбиесіз!
Dialogue: 0,0:10:31.50,0:10:35.05,Default,,0,0,0,,Әй, сен келіспейтін сияқтысың.
Dialogue: 0,0:10:35.13,0:10:37.55,Default,,0,0,0,,Романтиканы түсінбейтін түзу адам сияқты.
Dialogue: 0,0:10:37.63,0:10:39.51,Default,,0,0,0,,Жолдан кет! Тәрбиесіз!
Dialogue: 0,0:10:48.93,0:10:51.02,Default,,0,0,0,,Мұнда ешкім жоқ сияқты. (Ұшқыш А) Жоқ, бар.
Dialogue: 0,0:10:51.52,0:10:53.06,Default,,0,0,0,,Оның күші одан сайын артып барады.
Dialogue: 0,0:10:54.52,0:10:56.03,Default,,0,0,0,,Ууу!
Dialogue: 0,0:10:56.53,0:10:58.15,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:10:59.36,0:11:02.16,Default,,0,0,0,,Менің ойымша, бұл күтпеген жағдай.
Dialogue: 0,0:11:02.82,0:11:06.66,Default,,0,0,0,,Рух патшасының сол қолы... Солай ма?
Dialogue: 0,0:11:21.76,0:11:24.10,Default,,0,0,0,,(Перниданың ырылдауы)
Dialogue: 0,0:11:24.68,0:11:27.43,Default,,0,0,0,,Уаа!
Dialogue: 0,0:11:32.10,0:11:34.94,Default,,0,0,0,,Бұл құбыжық Рух патшасының сол қолы...
Dialogue: 0,0:11:35.02,0:11:38.07,Default,,0,0,0,,Рух Патшасы соншалықты үлкен бе?
Dialogue: 0,0:11:38.69,0:11:41.74,Default,,0,0,0,,Білмеймін, өйткені мен сені ешқашан кездестірмегенмін.
Dialogue: 0,0:11:42.24,0:11:43.49,Default,,0,0,0,,Рейацу шынымен де
Dialogue: 0,0:11:43.57,0:11:46.74,Default,,0,0,0,,Үкітакеден жинағанмен бірдей дерлік.
Dialogue: 0,0:11:47.49,0:11:52.75,Default,,0,0,0,,Егер Укитаке келісімшартқа отырған адам Рейудың оң қолы болса.
Dialogue: 0,0:11:53.71,0:11:57.13,Default,,0,0,0,,Сол қол Рух патшасынан алыстаса да
Dialogue: 0,0:11:57.21,0:11:59.88,Default,,0,0,0,,Бұл жерде ешқандай күмән жоқ
Dialogue: 0,0:12:00.46,0:12:02.09,Default,,0,0,0,,... күмән бар
Dialogue: 0,0:12:03.09,0:12:06.30,Default,,0,0,0,,Оның да қолында жалғыз көзі бар біртүрлі түрі бар.
Dialogue: 0,0:12:06.39,0:12:08.43,Default,,0,0,0,,Кисуке Урахара айтқандай.
Dialogue: 0,0:12:08.51,0:12:12.18,Default,,0,0,0,,Ал, мен оны монокуляр деп атау керек пе, білмеймін.
Dialogue: 0,0:12:12.27,0:12:14.31,Default,,0,0,0,,Пікірлер екіге бөлінеді.
Dialogue: 0,0:12:15.69,0:12:17.19,Default,,0,0,0,,Ооо!
Dialogue: 0,0:12:17.27,0:12:18.36,Default,,0,0,0,,- (Иккаку) Қарғыс атсын! -(Юмичика) Уау!
Dialogue: 0,0:12:21.07,0:12:22.57,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:12:22.65,0:12:24.24,Default,,0,0,0,,Жалғыз сұрақ
Dialogue: 0,0:12:24.32,0:12:28.58,Default,,0,0,0,,Неліктен Рух патшасының сол қолы Юхабахтың астында?
Dialogue: 0,0:12:29.20,0:12:35.33,Default,,0,0,0,,Бірақ, бұл қуанышпен салыстырғанда мұндай сұрақтар түк емес.
Dialogue: 0,0:12:36.04,0:12:37.96,Default,,0,0,0,,Йороко... Би?
Dialogue: 0,0:12:39.38,0:12:40.92,Default,,0,0,0,,Біз сөйлесе аламыз ба?
Dialogue: 0,0:12:41.01,0:12:42.30,Default,,0,0,0,,Бұл да күтпеген жағдай
Dialogue: 0,0:12:42.38,0:12:46.34,Default,,0,0,0,,Дауысты қандай мүше арқылы шығарамыз?
Dialogue: 0,0:12:46.43,0:12:48.30,Default,,0,0,0,,Мені шексіз қызықтырады.
Dialogue: 0,0:12:48.39,0:12:51.64,Default,,0,0,0,,Капитан Нирвана, күлуді доғар да, жүгір!
Dialogue: 0,0:12:51.72,0:12:54.44,Default,,0,0,0,,Бұл жағдайда не нәрсеге қуаныштысың?
Dialogue: 0,0:12:55.10,0:12:57.90,Default,,0,0,0,,Сізді сонша бақытты ететін не?
Dialogue: 0,0:12:57.98,0:13:00.61,Default,,0,0,0,,Бақылау үшін бұрын көрмеген затты табыңыз
Dialogue: 0,0:13:00.69,0:13:03.90,Default,,0,0,0,,Бұл біздің күткенімізден бірінен соң бірі асып түседі.
Dialogue: 0,0:13:03.99,0:13:07.11,Default,,0,0,0,,Бұл қуаныш болмаса, онда не болады!
Dialogue: 0,0:13:07.82,0:13:09.99,Default,,0,0,0,,Уаааа!
Dialogue: 0,0:13:12.45,0:13:16.33,Default,,0,0,0,,Дұрыс, маған көбірек көрсетші, Рух патшасының сол қолын.
Dialogue: 0,0:13:16.92,0:13:19.96,Default,,0,0,0,,Гидари...Уде
Dialogue: 0,0:13:20.50,0:13:23.34,Default,,0,0,0,,Аты... Шығау
Dialogue: 0,0:13:23.42,0:13:25.80,Default,,0,0,0,,Иә? Не?
Dialogue: 0,0:13:25.88,0:13:28.55,Default,,0,0,0,,Қаттырақ айтыңыз
Dialogue: 0,0:13:28.64,0:13:32.43,Default,,0,0,0,,Аты... Пернида
Dialogue: 0,0:13:32.52,0:13:35.27,Default,,0,0,0,,...
Dialogue: 0,0:13:35.35,0:13:36.23,Default,,0,0,0,,Бұл ұзақ.
Dialogue: 0,0:13:36.73,0:13:40.56,Default,,0,0,0,,Біріншіден, оны сен емес мен аштым.
Dialogue: 0,0:13:40.65,0:13:43.11,Default,,0,0,0,,Атау құқығы маған тиесілі
Dialogue: 0,0:13:43.61,0:13:46.70,Default,,0,0,0,,Бірақ, бұл адамның өз өтініші.
Dialogue: 0,0:13:46.78,0:13:50.78,Default,,0,0,0,,Біз бұл жолы ерекше ерекшелік ретінде бұған жол бермейміз.
Dialogue: 0,0:13:50.87,0:13:52.49,Default,,0,0,0,,Сіз тым көп айтып отырсыз.
Dialogue: 0,0:13:52.58,0:13:53.83,Default,,0,0,0,,Әрқашан, солай ма?
Dialogue: 0,0:13:53.91,0:13:57.79,Default,,0,0,0,,Дегенмен емлені шешуге рұқсат етемін.
Dialogue: 0,0:13:58.50,0:14:02.29,Default,,0,0,0,,Итеруими Вакаранай
Dialogue: 0,0:14:02.38,0:14:08.38,Default,,0,0,0,,Вакаранайто Дайтай Варукучи
Dialogue: 0,0:14:09.39,0:14:11.14,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:14:11.64,0:14:14.01,Default,,0,0,0,,Техникалық ақпарат
Dialogue: 0,0:14:14.52,0:14:16.68,Default,,0,0,0,,Квинсино Уолкучи
Dialogue: 0,0:14:16.77,0:14:19.31,Default,,0,0,0,,Жаман сөз болса ше?
Dialogue: 0,0:14:19.90,0:14:21.81,Default,,0,0,0,,Юрсанай!
Dialogue: 0,0:14:25.53,0:14:26.49,Default,,0,0,0,,Не!
Dialogue: 0,0:14:27.90,0:14:31.28,Default,,0,0,0,,Бейорганикалық заттар арқылы жүйкелер өте ала ма?
Dialogue: 0,0:14:31.37,0:14:33.99,Default,,0,0,0,,Күтпеген жерден! Ұнайды
Dialogue: 0,0:14:44.46,0:14:45.34,Default,,0,0,0,,Хун
Dialogue: 0,0:15:05.02,0:15:05.69,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:06.19,0:15:07.32,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:15:18.45,0:15:21.87,Default,,0,0,0,,Хашвальд екеуіңнің бір-біріңе қатысы бар, солай емес пе?
Dialogue: 0,0:15:21.96,0:15:23.88,Default,,0,0,0,,Онда баруға болады.
Dialogue: 0,0:15:24.92,0:15:25.79,Default,,0,0,0,,Әй?
Dialogue: 0,0:15:25.88,0:15:28.05,Default,,0,0,0,,Біз ұлы мәртебеліге қамқор боламыз.
Dialogue: 0,0:15:28.13,0:15:31.30,Default,,0,0,0,,Ха, мен екеуін де жеңемін.
Dialogue: 0,0:15:31.38,0:15:34.01,Default,,0,0,0,,Мәртебелі және Хашвальд зомби
Dialogue: 0,0:15:34.09,0:15:36.31,Default,,0,0,0,,Оны көргім келеді~
Dialogue: 0,0:15:38.02,0:15:38.89,Default,,0,0,0,,Сыртқа шығарған ауаңыз сол жақтағы осы бөліктен шығады.
Dialogue: 0,0:15:39.39,0:15:40.81,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:15:40.89,0:15:42.19,Default,,0,0,0,,Капитан Нирука!
Dialogue: 0,0:15:42.81,0:15:46.69,Default,,0,0,0,,Айқайламаңыз, бұл жай ғана жарылғыш реактивті сауыт.
Dialogue: 0,0:15:47.27,0:15:50.95,Default,,0,0,0,,Мен сізге түсініктеме бермеймін. Оны сөздігіңізден іздеңіз.
Dialogue: 0,0:15:52.74,0:15:54.37,Default,,0,0,0,,Жоқ, капитан Нируки!
Dialogue: 0,0:15:54.45,0:15:56.49,Default,,0,0,0,,Оның жүйкесі жерде...
Dialogue: 0,0:15:56.58,0:15:57.62,Default,,0,0,0,,Иә
Dialogue: 0,0:15:57.70,0:15:58.29,Default,,0,0,0,,(қосу дыбысы)
Dialogue: 0,0:16:00.79,0:16:01.54,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:03.17,0:16:04.83,Default,,0,0,0,,Бұл таныс сияқты ма?
Dialogue: 0,0:16:05.50,0:16:06.79,Default,,0,0,0,,Бірнеше Титанға кезігіп қалғаның өкінішті, бірақ
Dialogue: 0,0:16:06.88,0:16:10.09,Default,,0,0,0,,Бұл сіз Квинси қолданатын ауада жүру техникасы.
Dialogue: 0,0:16:10.17,0:16:12.13,Default,,0,0,0,,Бұл Хиренкьяку.
Dialogue: 0,0:16:12.72,0:16:14.05,Default,,0,0,0,,Дегенмен, бұл
Dialogue: 0,0:16:14.13,0:16:18.26,Default,,0,0,0,,Бұл Мунетсугу Ишида мен Урю Ишида қолданған есім.
Dialogue: 0,0:16:18.35,0:16:22.14,Default,,0,0,0,,Бастапқы атау басқа нәрсе болуы мүмкін.
Dialogue: 0,0:16:22.23,0:16:27.15,Default,,0,0,0,,Жүйкеңді осы жерге таратып жіберсең де
Dialogue: 0,0:16:27.23,0:16:31.53,Default,,0,0,0,,Егер сіз оны баспасаңыз, бұл ештеңені білдірмейді.
Dialogue: 0,0:16:31.61,0:16:32.74,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:33.24,0:16:35.78,Default,,0,0,0,,Уф... Мен оны жек көремін!
Dialogue: 0,0:16:37.37,0:16:40.58,Default,,0,0,0,,Енді үлгіні жоспар бойынша алайық.
Dialogue: 0,0:16:42.58,0:16:44.46,Default,,0,0,0,,Өйткені—
Dialogue: 0,0:16:46.79,0:16:48.50,Default,,0,0,0,,Қорғаушы химиялық сұйықтық.
Dialogue: 0,0:16:50.96,0:16:52.55,Default,,0,0,0,,Бұл сізді мазалайды ма?
Dialogue: 0,0:16:53.05,0:16:56.64,Default,,0,0,0,,Шайқас біткен соң мен резервуар жасаймын.
Dialogue: 0,0:16:56.72,0:16:59.14,Default,,0,0,0,,Осы уақытқа дейін бұл оның жаңалығын сақтайды.
Dialogue: 0,0:17:01.68,0:17:02.64,Default,,0,0,0,,(Керс) Тас масканың бұл сүйек инесі адам миын тесіп өтуге қауқарлы.
Dialogue: 0,0:17:05.27,0:17:06.19,Default,,0,0,0,,Уф!
Dialogue: 0,0:17:09.94,0:17:13.44,Default,,0,0,0,,Нервтердің, қан тамырларының және бұлшықеттердің орналасуын қайта біріктірді
Dialogue: 0,0:17:13.94,0:17:17.95,Default,,0,0,0,,Менің денемді оңай басқара аламын деп ойламаңыз.
Dialogue: 0,0:17:18.45,0:17:19.66,Default,,0,0,0,,Пернида
Dialogue: 0,0:17:23.00,0:17:24.37,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:17:24.46,0:17:27.25,Default,,0,0,0,,Мен біраз уақыттан бері бір қолыма операция жасатпадым.
Dialogue: 0,0:17:27.33,0:17:29.17,Default,,0,0,0,,Интуицияңыз түтіккен бе?
Dialogue: 0,0:17:30.67,0:17:32.38,Default,,0,0,0,,Бұл дөрекі.
Dialogue: 0,0:17:32.46,0:17:37.89,Default,,0,0,0,,“Бузама”тте енді Киминокото?
Dialogue: 0,0:17:37.97,0:17:39.76,Default,,0,0,0,,Соған ұқсайды ма?
Dialogue: 0,0:17:39.85,0:17:43.02,Default,,0,0,0,,Мускоши әсел?
Dialogue: 0,0:17:49.06,0:17:50.81,Default,,0,0,0,,Мен оны жек көремін!
Dialogue: 0,0:17:54.57,0:17:57.53,Default,,0,0,0,,Жыртылған саусақ басқа сол қолға айнала ма?
Dialogue: 0,0:17:58.20,0:18:01.45,Default,,0,0,0,,Мен оны үйге бөлшектеп апара алмайтын сияқтымын.
Dialogue: 0,0:18:01.53,0:18:02.49,Default,,0,0,0,,(саусақ сықырлаған дыбыс)
Dialogue: 0,0:18:09.54,0:18:12.29,Default,,0,0,0,,Мускоши әсел?
Dialogue: 0,0:18:13.17,0:18:14.63,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:18:15.63,0:18:18.01,Default,,0,0,0,,Ах, қан...
Dialogue: 0,0:18:18.09,0:18:20.01,Default,,0,0,0,,Итай... Итатат
Dialogue: 0,0:18:20.80,0:18:23.76,Default,,0,0,0,,Жас кезімде көрген бір кітапта бұл бар еді.
Dialogue: 0,0:18:24.60,0:18:30.27,Default,,0,0,0,,«Рух Патшасының оң қолы қозғалмайды, ал сол қолы алға жылжуға жауапты».
Dialogue: 0,0:18:30.35,0:18:34.36,Default,,0,0,0,,Кітаптан алынған білім – бұл жай ғана білім.
Dialogue: 0,0:18:34.44,0:18:38.78,Default,,0,0,0,,Мен өз қолыммен дәлелдемейінше сенбеймін.
Dialogue: 0,0:18:39.61,0:18:44.24,Default,,0,0,0,,Екеуін де соншалықты тез сезінемін деп ойламадым.
Dialogue: 0,0:18:45.24,0:18:48.66,Default,,0,0,0,,Қандай керемет шайқас!
Dialogue: 0,0:18:49.62,0:18:54.04,Default,,0,0,0,,Уаа!
Dialogue: 0,0:19:02.18,0:19:03.14,Default,,0,0,0,,Банкай
Dialogue: 0,0:19:04.18,0:19:06.60,Default,,0,0,0,,Бұл жаман! Бұл алтын өлтіруші Джизо!
Dialogue: 0,0:19:06.68,0:19:09.81,Default,,0,0,0,,Мен бұл жерді улап өлтіремін.
Dialogue: 0,0:19:09.89,0:19:11.35,Default,,0,0,0,,Капитан Зараки!
Dialogue: 0,0:19:11.85,0:19:13.81,Default,,0,0,0,,Улану?
Dialogue: 0,0:19:13.90,0:19:16.82,Default,,0,0,0,,Мұндай ысырапшылдықты кім жасайды?
Dialogue: 0,0:19:31.25,0:19:32.21,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:19:38.63,0:19:40.47,Default,,0,0,0,,Бұл жақын мерзім.
Dialogue: 0,0:19:43.09,0:19:47.47,Default,,0,0,0,,Алтын Бокусацу Джизо жын импрессионизм денесі
Dialogue: 0,0:19:48.77,0:19:50.18,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:19:51.02,0:19:52.81,Default,,0,0,0,,Өзгертілген Банкай
Dialogue: 0,0:19:52.90,0:19:55.06,Default,,0,0,0,,Жынның жатырының денесі
Dialogue: 0,0:19:55.15,0:19:59.32,Default,,0,0,0,,Алтын Хикисацу Джизоны өзгерту арқылы жасаған біртүрлі пішін.
Dialogue: 0,0:19:59.90,0:20:03.57,Default,,0,0,0,,Оның қабілеттері ұрыс кезінде жіберілген ақпаратқа негізделген.
Dialogue: 0,0:20:03.66,0:20:07.03,Default,,0,0,0,,Жаңа Хикисацу Джизоның дүниеге келуі
Dialogue: 0,0:20:07.12,0:20:07.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:09.29,0:20:11.33,Default,,0,0,0,,Оның мағынасын түсінбедіңіз бе?
Dialogue: 0,0:20:12.00,0:20:13.58,Default,,0,0,0,,Оны көргенде білесің
Dialogue: 0,0:20:16.29,0:20:18.63,Default,,0,0,0,,Огяаа!
Dialogue: 0,0:20:18.71,0:20:21.76,Default,,0,0,0,,Огяаа!
Dialogue: 0,0:20:32.02,0:20:35.69,Default,,0,0,0,,Бұл Хикисацу Джизоның денесінің бетінде нервтер бар.
Dialogue: 0,0:20:37.19,0:20:38.19,Default,,0,0,0,,Огяаа!
Dialogue: 0,0:20:38.27,0:20:41.15,Default,,0,0,0,,Сондықтан ауаға немесе жерге тиіп тұрсаңыз да,
Dialogue: 0,0:20:41.24,0:20:43.11,Default,,0,0,0,,Мен қатты ауырсынуды сезінемін
Dialogue: 0,0:20:44.32,0:20:46.37,Default,,0,0,0,,Ал, мұны бір жаққа қалдырыңыз.
Dialogue: 0,0:20:49.33,0:20:55.50,Default,,0,0,0,,Маңыздысы дене бетіндегі жүйкелер 70 000 қабатқа бөлінген.
Dialogue: 0,0:20:56.33,0:20:57.50,Default,,0,0,0,,Хе-хе. Баспалдақтан төмен түсіп кеткенсің ғой?
Dialogue: 0,0:20:57.58,0:21:00.88,Default,,0,0,0,,Жігіттер бұл жігітке нервтеріңді салсаңдар да
Dialogue: 0,0:21:00.96,0:21:04.09,Default,,0,0,0,,Жалғыз алдыңғы парақ Бүктеу және аяқтау
Dialogue: 0,0:21:09.14,0:21:12.81,Default,,0,0,0,,Огяаа! Ой ия!
Dialogue: 0,0:21:14.10,0:21:14.60,Default,,0,0,0,,Уф!
Dialogue: 0,0:21:15.14,0:21:18.27,Default,,0,0,0,,Уваа!
Dialogue: 0,0:21:19.94,0:21:22.94,Default,,0,0,0,,Ууу!
Dialogue: 0,0:21:23.65,0:21:24.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:25.36,0:21:28.78,Default,,0,0,0,,Не болды? Қарсылық көрсету дұрыс па?
Dialogue: 0,0:21:30.12,0:21:35.12,Default,,0,0,0,,Егер сіз бүкіл денеңізді жұтып қойғанша жүйкеңізді 70 000 рет соға алсаңыз.
Dialogue: 0,0:21:37.58,0:21:38.29,Default,,0,0,0,,Иә
Dialogue: 0,0:21:48.34,0:21:49.18,Default,,0,0,0,,(жұтыну дыбысы)
Dialogue: 0,0:21:52.56,0:21:55.02,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,0:21:55.10,0:21:59.98,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:22:00.06,0:22:02.98,Default,,0,0,0,,А~хахахаха!
Dialogue: 0,0:22:06.49,0:22:08.49,Default,,0,0,0,,♪～
Dialogue: 0,0:23:31.74,0:23:33.74,Default,,0,0,0,,～♪
Dialogue: 0,0:23:37.41,0:23:39.12,Default,,0,0,0,,Қызыл және қызыл
Dialogue: 0,0:23:39.75,0:23:43.00,Default,,0,0,0,,Ылғал сахнада қарағай инелері шашылады
Dialogue: 0,0:23:43.83,0:23:48.84,Default,,0,0,0,,100 000 000 жерді кесіп өтіп, тұңғиыққа дейін
Dialogue: 0,0:23:50.34,0:23:56.34,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
