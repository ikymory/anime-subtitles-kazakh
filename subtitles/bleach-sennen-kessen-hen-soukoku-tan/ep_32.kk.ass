Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.12,0:00:06.67,Default,,0,0,0,,Енді барлығың қолдарыңды алыңдар.
Dialogue: 0,0:00:10.92,0:00:13.05,Default,,0,0,0,,Сол моншаққа рейатсу жағыңыз.
Dialogue: 0,0:00:13.55,0:00:14.63,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:30.19,0:00:31.78,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:00:31.86,0:00:33.53,Default,,0,0,0,,Біз жеңілдік.
Dialogue: 0,0:00:33.61,0:00:35.28,Default,,0,0,0,,Уф... аа!
Dialogue: 0,0:00:36.20,0:00:36.99,Default,,0,0,0,,Не!
Dialogue: 0,0:00:37.07,0:00:39.08,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:00:39.83,0:00:41.66,Default,,0,0,0,,Ах! Бұл...
Dialogue: 0,0:00:46.88,0:00:48.79,Default,,0,0,0,,А... не?
Dialogue: 0,0:00:48.88,0:00:51.13,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:00:51.21,0:00:53.21,Default,,0,0,0,,Ол Сейрейтейді қамтыды—
Dialogue: 0,0:00:53.30,0:00:55.88,Default,,0,0,0,,Көрінбейтін империяның (Ванденрейх) пейзажы жойылуда
Dialogue: 0,0:00:58.09,0:01:01.06,Default,,0,0,0,,Неліктен... Неліктен бұл болып жатыр?
Dialogue: 0,0:01:01.56,0:01:04.18,Default,,0,0,0,,Квинсилер не істеуге тырысады?
Dialogue: 0,0:01:04.27,0:01:05.73,Default,,0,0,0,,Не?
Dialogue: 0,0:01:05.81,0:01:07.73,Default,,0,0,0,,Мен қатты тырысамын
Dialogue: 0,0:01:07.81,0:01:10.90,Default,,0,0,0,,Соңында біз қақпалардың бірін салуға дайын болдық.
Dialogue: 0,0:01:10.98,0:01:14.40,Default,,0,0,0,,Жауың саған қанша жасады?
Dialogue: 0,0:01:21.45,0:01:23.58,Default,,0,0,0,,Бұл жаман.
Dialogue: 0,0:01:23.66,0:01:26.08,Default,,0,0,0,,Біз қақпаны аяқтауға асығуымыз керек.
Dialogue: 0,0:01:28.50,0:01:30.50,Default,,0,0,0,,♪～
Dialogue: 0,0:02:55.96,0:02:57.96,Default,,0,0,0,,～♪
Dialogue: 0,0:02:59.55,0:03:00.59,Default,,0,0,0,,Оны ашыңыз.
Dialogue: 0,0:03:02.55,0:03:03.68,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:07.35,0:03:08.31,Default,,0,0,0,,Сіз...
Dialogue: 0,0:03:09.06,0:03:12.31,Default,,0,0,0,,Эй, біраз уақыт болды, Куросаки.
Dialogue: 0,0:03:12.40,0:03:13.98,Default,,0,0,0,,Гриммжоу!
Dialogue: 0,0:03:18.74,0:03:20.57,Default,,0,0,0,,Неше жыл болды?
Dialogue: 0,0:03:20.65,0:03:23.36,Default,,0,0,0,,Менімен соғысқан жараларыңыз жазылып кеткен сияқты.
Dialogue: 0,0:03:23.45,0:03:24.91,Default,,0,0,0,,Бұл болжам.
Dialogue: 0,0:03:25.41,0:03:27.29,Default,,0,0,0,,Сіз жақсы көрінесіз, солай емес пе?
Dialogue: 0,0:03:27.37,0:03:29.83,Default,,0,0,0,,Сен мені өлді деп ойладың ба?
Dialogue: 0,0:03:29.91,0:03:30.54,Default,,0,0,0,,Ха!
Dialogue: 0,0:03:31.58,0:03:32.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:35.46,0:03:38.13,Default,,0,0,0,,Мені өлтірмей өле аласың ба?
Dialogue: 0,0:03:39.05,0:03:41.01,Default,,0,0,0,,Мен күттім.
Dialogue: 0,0:03:41.09,0:03:43.84,Default,,0,0,0,,Бұл...
Dialogue: 0,0:03:46.01,0:03:48.01,Default,,0,0,0,,Ичиго~!
Dialogue: 0,0:03:48.10,0:03:48.89,Default,,0,0,0,,Жоқ...!
Dialogue: 0,0:03:48.97,0:03:51.60,Default,,0,0,0,,Мен сені сағындым, Ичиго!
Dialogue: 0,0:03:54.02,0:03:55.23,Default,,0,0,0,,Урахара мырза.
Dialogue: 0,0:03:55.31,0:03:57.77,Default,,0,0,0,,Бала мен ересек болу арасында еркін ауыса аласыз.
Dialogue: 0,0:03:57.86,0:03:59.94,Default,,0,0,0,,Ол маған білезік жасады.
Dialogue: 0,0:04:00.03,0:04:03.57,Default,,0,0,0,,Осы арқылы мен Ичигоға дұрыс көмектесе аламын.
Dialogue: 0,0:04:03.66,0:04:08.20,Default,,0,0,0,,Бұл білезік менде болғанша, мен ешқашан балалық шаққа орала алмаймын.
Dialogue: 0,0:04:08.70,0:04:09.45,Default,,0,0,0,,Инуэ
Dialogue: 0,0:04:09.95,0:04:13.41,Default,,0,0,0,,Сіз мені қажетсіз нәрселер жасап жатырмын деп ойлайтын шығарсыз, бірақ...
Dialogue: 0,0:04:13.50,0:04:14.29,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:14.37,0:04:17.63,Default,,0,0,0,,Бұл дұрыс емес, Урахара-сан барын салып жатыр.
Dialogue: 0,0:04:17.71,0:04:20.13,Default,,0,0,0,,Жоқ... жоқ, Садо-кун, бұл...
Dialogue: 0,0:04:20.21,0:04:22.51,Default,,0,0,0,,Мен мүлде олай ойламаймын.
Dialogue: 0,0:04:22.59,0:04:25.01,Default,,0,0,0,,Нелли, сен не істеп жатырсың?
Dialogue: 0,0:04:25.09,0:04:26.64,Default,,0,0,0,,Сен менің жолыма түстің, жолдан кет!
Dialogue: 0,0:04:27.30,0:04:28.76,Default,,0,0,0,,Бұл сызық.
Dialogue: 0,0:04:28.85,0:04:32.14,Default,,0,0,0,,Ұрыстың ортасында төбелес бастайтын болсаңыз, артта қалыңыз.
Dialogue: 0,0:04:33.60,0:04:35.77,Default,,0,0,0,,Бірінші орында No3 мен
Dialogue: 0,0:04:35.85,0:04:38.69,Default,,0,0,0,,Жоқ. 6-да не істеу керектігін айтқаның есімде жоқ.
Dialogue: 0,0:04:38.77,0:04:40.27,Default,,0,0,0,,Бұл қоқыс
Dialogue: 0,0:04:40.36,0:04:44.24,Default,,0,0,0,,Қазір индиго бояуы, сандардың мағынасы бар ма?
Dialogue: 0,0:04:44.32,0:04:46.61,Default,,0,0,0,,Неліктен оны қазір көрмейсіз?
Dialogue: 0,0:04:46.70,0:04:48.95,Default,,0,0,0,,Қайсысы жақсы, мен бе, сен бе?
Dialogue: 0,0:04:49.45,0:04:50.49,Default,,0,0,0,,Күте тұрыңыз, Гриммжоу!
Dialogue: 0,0:04:50.58,0:04:52.04,Default,,0,0,0,,Практикалық емтиханға келесі қай команда шығады екен?
Dialogue: 0,0:04:52.12,0:04:53.37,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:04:53.45,0:04:55.79,Default,,0,0,0,,Не, мұнда тек ақымақтар бар ма?
Dialogue: 0,0:04:55.87,0:04:58.54,Default,,0,0,0,,Сіз мұнда ол үшін келген жоқсыз, солай ма?
Dialogue: 0,0:04:58.63,0:05:00.67,Default,,0,0,0,,Иә? Бұл дауыс...
Dialogue: 0,0:05:00.75,0:05:04.01,Default,,0,0,0,,Мен сені табамын, тез кіре аласың ба?
Dialogue: 0,0:05:05.43,0:05:07.05,Default,,0,0,0,,Сол қорап...
Dialogue: 0,0:05:07.55,0:05:10.22,Default,,0,0,0,,Тез кіріңдер дедім!
Dialogue: 0,0:05:10.31,0:05:11.64,Default,,0,0,0,,Рирука!
Dialogue: 0,0:05:12.22,0:05:13.64,Default,,0,0,0,,Мен де осындамын
Dialogue: 0,0:05:13.73,0:05:14.68,Default,,0,0,0,,Юкио!
Dialogue: 0,0:05:14.77,0:05:18.90,Default,,0,0,0,,Дәлірек айтқанда, өздеріңіз көріп отырғандай, бұл менің қабілетім.
Dialogue: 0,0:05:18.98,0:05:21.44,Default,,0,0,0,,Балалар сендер әлі тірі болдыңдар.
Dialogue: 0,0:05:21.52,0:05:24.07,Default,,0,0,0,,Жоқ... неге мұндасың?
Dialogue: 0,0:05:24.15,0:05:26.45,Default,,0,0,0,,Ал, қазір кіріңіз.
Dialogue: 0,0:05:26.53,0:05:28.20,Default,,0,0,0,,Бұл оқиға
Dialogue: 0,0:05:30.24,0:05:31.62,Default,,0,0,0,,(Изуку) Мен үшін ұпайлар аса маңызды емес. (Оқушы) Жоғары ондықтағы біреу…
Dialogue: 0,0:05:31.70,0:05:32.33,Default,,0,0,0,,Қазір...
Dialogue: 0,0:05:32.95,0:05:35.08,Default,,0,0,0,,Қайсысын түсіндіргім келеді? Ичиго
Dialogue: 0,0:05:35.16,0:05:36.46,Default,,0,0,0,,үшін!
Dialogue: 0,0:05:36.54,0:05:38.42,Default,,0,0,0,,Неліктен оның бір бөлігін ғана түсіндіресіз?
Dialogue: 0,0:05:38.50,0:05:39.50,Default,,0,0,0,,Бұл айналды
Dialogue: 0,0:05:39.58,0:05:41.29,Default,,0,0,0,,үшінн түсіндіріңіз
Dialogue: 0,0:05:41.38,0:05:44.38,Default,,0,0,0,,Бәрі жақсы!
Dialogue: 0,0:05:44.46,0:05:45.51,Default,,0,0,0,,Ол әйтеуір бас тарта ма еді?
Dialogue: 0,0:05:45.59,0:05:46.59,Default,,0,0,0,,Эй?
Dialogue: 0,0:05:46.67,0:05:49.72,Default,,0,0,0,,Біз ойдан шығарылған саладамыз...
Dialogue: 0,0:05:49.80,0:05:51.22,Default,,0,0,0,,- (Чадо) Кешіріңіз - (Ичиго) Ах!
Dialogue: 0,0:05:53.22,0:05:56.02,Default,,0,0,0,,А... сол кезде?
Dialogue: 0,0:05:56.10,0:05:58.90,Default,,0,0,0,,Әскери күшке ие болудан артық ештеңе жоқ.
Dialogue: 0,0:05:58.98,0:06:01.98,Default,,0,0,0,,Әуелде ештеңе үйретпеген мен ғанамын...
Dialogue: 0,0:06:02.07,0:06:03.15,Default,,0,0,0,,Күлкілі емес пе?
Dialogue: 0,0:06:03.23,0:06:04.03,Default,,0,0,0,,Әрине
Dialogue: 0,0:06:04.11,0:06:07.40,Default,,0,0,0,,Жарайды, көптен бері бос емессің.
Dialogue: 0,0:06:07.49,0:06:09.66,Default,,0,0,0,,Бұл мазасыз бет не болды?
Dialogue: 0,0:06:09.74,0:06:10.78,Default,,0,0,0,,Оған көмектесу мүмкін емес
Dialogue: 0,0:06:10.87,0:06:13.74,Default,,0,0,0,,Иә? Айтуға жақсы мүмкіндігім болды.
Dialogue: 0,0:06:13.83,0:06:14.99,Default,,0,0,0,,Мұнда келе жатқанда
Dialogue: 0,0:06:15.91,0:06:16.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:17.83,0:06:21.25,Default,,0,0,0,,Тосқауыл Жан қоғамы мен осы әлемді байланыстырады.
Dialogue: 0,0:06:21.33,0:06:22.46,Default,,0,0,0,,Сіз мұны түсінесіз бе?
Dialogue: 0,0:06:22.54,0:06:23.25,Default,,0,0,0,,О
Dialogue: 0,0:06:23.34,0:06:26.01,Default,,0,0,0,,Шлагбаумның айналасында әртүрлі үлкенді-кішілі құрылымдар бар.
Dialogue: 0,0:06:26.09,0:06:30.30,Default,,0,0,0,,Шоутани дейтін адасқан жандардың сырласатын жері көп.
Dialogue: 0,0:06:30.38,0:06:34.64,Default,,0,0,0,,Барлық бос орындарды толтыру үшін қара қуыс бар.
Dialogue: 0,0:06:35.26,0:06:38.60,Default,,0,0,0,,Бұл Гаргантаның ішінде рухани қысым тұрақсыз.
Dialogue: 0,0:06:38.68,0:06:42.06,Default,,0,0,0,,Рухани қысымыңызды үнемі босатып, тұғырыңызды құрмасаңыз.
Dialogue: 0,0:06:42.15,0:06:44.15,Default,,0,0,0,,Мен тіпті тұра алмаймын.
Dialogue: 0,0:06:44.73,0:06:47.74,Default,,0,0,0,,Солардың ішінен тек мен айтқан Шоутани ғана.
Dialogue: 0,0:06:47.82,0:06:49.90,Default,,0,0,0,,Бұл рухани баланың құрылымының айырмашылығына байланысты ма?
Dialogue: 0,0:06:49.99,0:06:53.78,Default,,0,0,0,,Неге екені белгісіз, ол рухани кеңістік ретінде өмір сүре береді.
Dialogue: 0,0:06:53.87,0:06:57.29,Default,,0,0,0,,Кисуке мұны толық пайдалануды ойлады.
Dialogue: 0,0:06:58.54,0:07:01.83,Default,,0,0,0,,Сондықтан мен оларды іздеп, қайтардым.
Dialogue: 0,0:07:02.33,0:07:06.59,Default,,0,0,0,,Жарайды, іздеймін десең іздейсің деген қорқынышты.
Dialogue: 0,0:07:07.17,0:07:11.38,Default,,0,0,0,,Электр қуатын пайдалана отырып, кеңістікті еркін жасай білу
Dialogue: 0,0:07:11.47,0:07:12.93,Default,,0,0,0,,Бұл сәл басқаша.
Dialogue: 0,0:07:13.43,0:07:14.68,Default,,0,0,0,,Жақсы, бірақ маңызды емес.
Dialogue: 0,0:07:14.76,0:07:19.39,Default,,0,0,0,,Рируканың мүмкіндігін пайдаланып, ол кішкентай Шоутаниді қорапқа салып алып жүрді.
Dialogue: 0,0:07:19.48,0:07:22.73,Default,,0,0,0,,Юкионың қабілетімен ол бөлме мен рельске айналды.
Dialogue: 0,0:07:23.31,0:07:26.61,Default,,0,0,0,,Бұл оның дәл қазір аяқталды дегенді білдірмейді.
Dialogue: 0,0:07:26.69,0:07:29.78,Default,,0,0,0,,Ал, мен қаққан қазықты белгі ретінде пайдаланыңыз.
Dialogue: 0,0:07:29.86,0:07:31.82,Default,,0,0,0,,Осы жерден Рух патшасының сарайына дейін аз ғана қашықтық.
Dialogue: 0,0:07:31.90,0:07:34.12,Default,,0,0,0,,Тек қозғала алу
Dialogue: 0,0:07:34.20,0:07:38.70,Default,,0,0,0,,Джага Рейатсуды жібермей жау аумағына басып кірудің артықшылығы өте зор.
Dialogue: 0,0:07:39.20,0:07:41.62,Default,,0,0,0,,Осы арқылы біз оларға тосын шабуыл жасай аламыз.
Dialogue: 0,0:07:42.25,0:07:44.46,Default,,0,0,0,,Мен саған бірден шабуыл жасаймын, Ичиго.
Dialogue: 0,0:07:44.96,0:07:45.63,Default,,0,0,0,,Иә
Dialogue: 0,0:07:51.55,0:07:52.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:55.89,0:07:58.18,Default,,0,0,0,,Эй, бірдеңе дұрыс емес.
Dialogue: 0,0:07:58.26,0:08:00.22,Default,,0,0,0,,Жартылай дайын қақпа жоғалады.
Dialogue: 0,0:08:00.31,0:08:01.77,Default,,0,0,0,,Мен осы дәптерге деген меншік құқығымнан бас тартамын…
Dialogue: 0,0:08:02.39,0:08:04.06,Default,,0,0,0,,Reiatsu жеткіліксіз бе?
Dialogue: 0,0:08:04.15,0:08:05.15,Default,,0,0,0,,(Баяндаушы) Цезарь не болып жатқанын мүлде түсінбеді.
Dialogue: 0,0:08:05.23,0:08:09.36,Default,,0,0,0,,Ол капитандар арасында да керемет Рейатсуға ие болды.
Dialogue: 0,0:08:09.44,0:08:12.28,Default,,0,0,0,,Мүмкін капитан Укитакенің жоқтығы маған әсер етіп жатқан шығар.
Dialogue: 0,0:08:12.36,0:08:14.11,Default,,0,0,0,,Ахахаха! Қандай қызық.
Dialogue: 0,0:08:14.74,0:08:15.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:16.45,0:08:17.99,Default,,0,0,0,,«Бұрынғыдай» дегенді қалай түсінесіңдер?
Dialogue: 0,0:08:18.78,0:08:20.41,Default,,0,0,0,,Бұлай қалуға болмайды.
Dialogue: 0,0:08:21.54,0:08:22.79,Default,,0,0,0,,Ядомару мырза
Dialogue: 0,0:08:23.83,0:08:25.92,Default,,0,0,0,,Мен «Өлім тұманын» кие бастадым
Dialogue: 0,0:08:26.00,0:08:28.92,Default,,0,0,0,,Біздің моншақтар, Хаё Ватари-сан, Кисуке!
Dialogue: 0,0:08:34.93,0:08:38.97,Default,,0,0,0,,Санға қарасаңыз, рухани қысымның жоқтығы байқалады.
Dialogue: 0,0:08:39.06,0:08:43.10,Default,,0,0,0,,Неліктен Reiatsu күшейткішін қоспайсыз?
Dialogue: 0,0:08:49.73,0:08:53.19,Default,,0,0,0,,Егер сізде осындай нәрсе болса, маған хабарлаңыз.
Dialogue: 0,0:08:54.07,0:08:58.62,Default,,0,0,0,,Мен мұндай нәрсе болады деп ешқашан күтпедім.
Dialogue: 0,0:09:16.22,0:09:18.22,Default,,0,0,0,,Мен оны босқа өткізбеймін
Dialogue: 0,0:09:18.30,0:09:19.80,Default,,0,0,0,,Укитаке
Dialogue: 0,0:09:22.68,0:09:26.35,Default,,0,0,0,,Рух патша сарайына дейін жүріп, тосын шабуылды бастаңыз.
Dialogue: 0,0:09:27.14,0:09:29.23,Default,,0,0,0,,Рух Патшасын мөрлеуге әрекет жасағанда
Dialogue: 0,0:09:29.31,0:09:32.86,Default,,0,0,0,,Төменде қағылған қазық Рух Патшасының қасына қағылды.
Dialogue: 0,0:09:32.94,0:09:37.11,Default,,0,0,0,,Егер олар сонда қалса, сіздің алдыңыздан секіре алады.
Dialogue: 0,0:09:37.20,0:09:41.62,Default,,0,0,0,,Сіз бір сәттік олқылықты пайдаланып, ең үлкен Гецуганы әкелесіз.
Dialogue: 0,0:09:41.70,0:09:44.70,Default,,0,0,0,,Ичиго, сен мұны істей аласың.
Dialogue: 0,0:09:45.29,0:09:46.25,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:09:46.33,0:09:48.54,Default,,0,0,0,,Егер басқа адамдар кедергі келтірсе
Dialogue: 0,0:09:48.62,0:09:50.21,Default,,0,0,0,,Біз жол саламыз
Dialogue: 0,0:09:50.29,0:09:52.71,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,0:09:52.80,0:09:54.17,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:09:54.26,0:09:56.72,Default,,0,0,0,,СС мүмкіндіктерін түсінемін, бірақ
Dialogue: 0,0:09:57.22,0:09:59.55,Default,,0,0,0,,Юхабахтың қабілеті қандай?
Dialogue: 0,0:10:00.72,0:10:01.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:03.76,0:10:07.14,Default,,0,0,0,,Мен Ошо мырзадан бұл туралы көбірек сұрауым керек еді.
Dialogue: 0,0:10:07.23,0:10:08.64,Default,,0,0,0,,Уза!
Dialogue: 0,0:10:08.73,0:10:11.23,Default,,0,0,0,,Мен сюжетті анықтай алмаймын.
Dialogue: 0,0:10:11.31,0:10:12.73,Default,,0,0,0,,Мен неге екенін білмеймін
Dialogue: 0,0:10:12.82,0:10:16.53,Default,,0,0,0,,Не болды деп ойлай отырып, бұлай қараңғы болуды қоя аласыз ба?
Dialogue: 0,0:10:17.07,0:10:19.28,Default,,0,0,0,,Ұстап қалсақ, бізге де қараңғы болады.
Dialogue: 0,0:10:19.36,0:10:20.66,Default,,0,0,0,,Бұл ыңғайсыздық.
Dialogue: 0,0:10:21.78,0:10:24.87,Default,,0,0,0,,Дұрыс, рахмет Рирука-чан.
Dialogue: 0,0:10:24.95,0:10:27.00,Default,,0,0,0,,Неліктен бұлай рахмет айтасың?
Dialogue: 0,0:10:27.08,0:10:27.66,Default,,0,0,0,,...
Dialogue: 0,0:10:27.75,0:10:28.54,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:29.17,0:10:30.12,Default,,0,0,0,,Айтып тұрғасын...
Dialogue: 0,0:10:30.21,0:10:33.21,Default,,0,0,0,,Неге біздің жағымызды алдың?
Dialogue: 0,0:10:33.29,0:10:34.09,Default,,0,0,0,,Гриммжоу
Dialogue: 0,0:10:34.17,0:10:37.30,Default,,0,0,0,,А? Кім сенің жаныңда?
Dialogue: 0,0:10:37.38,0:10:39.01,Default,,0,0,0,,Ол миы жоқ бейбақ.
Dialogue: 0,0:10:39.09,0:10:41.97,Default,,0,0,0,,Сол Юхабахты жабайы жіберсем ше?
Dialogue: 0,0:10:42.05,0:10:43.89,Default,,0,0,0,,Менің ойымша, Хуэко Мундо кетіп қалды.
Dialogue: 0,0:10:43.97,0:10:48.43,Default,,0,0,0,,Егер Уэко Мундо кетсе, Темені қайда өлтіремін?
Dialogue: 0,0:10:49.56,0:10:50.35,Default,,0,0,0,,Фу…
Dialogue: 0,0:10:51.69,0:10:53.27,Default,,0,0,0,,Ура!
Dialogue: 0,0:11:11.04,0:11:13.04,Default,,0,0,0,,Менің ұлдарым
Dialogue: 0,0:11:16.88,0:11:17.71,Default,,0,0,0,,Ха!
Dialogue: 0,0:11:18.76,0:11:19.80,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:20.30,0:11:21.55,Default,,0,0,0,,- (Хашвальд) Не болды? - (Кнуклевар) А...
Dialogue: 0,0:11:21.63,0:11:23.34,Default,,0,0,0,,Сабыр ет, Кнуклевар
Dialogue: 0,0:11:23.43,0:11:26.01,Default,,0,0,0,,Бұл не? Бұл не?
Dialogue: 0,0:11:26.10,0:11:28.18,Default,,0,0,0,,Мынандай құбыжық болып кеткен ұлы мәртебеліге қараңыз.
Dialogue: 0,0:11:28.27,0:11:30.35,Default,,0,0,0,,Сіз ештеңе сезбейсіз бе?
Dialogue: 0,0:11:30.43,0:11:32.44,Default,,0,0,0,,Қорқынышты ма?
Dialogue: 0,0:11:32.94,0:11:35.31,Default,,0,0,0,,Одан қорқудың қажеті жоқ.
Dialogue: 0,0:11:35.40,0:11:37.61,Default,,0,0,0,,Ақырында бұл фигураны көруге үйренесіз.
Dialogue: 0,0:11:38.94,0:11:41.36,Default,,0,0,0,,Әй, бәрібір...
Dialogue: 0,0:11:42.03,0:11:46.62,Default,,0,0,0,,Тым көп билікке ие болу деген осы ма?
Dialogue: 0,0:11:51.08,0:11:52.79,Default,,0,0,0,,Ууууах!
Dialogue: 0,0:11:52.87,0:11:54.04,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:12:00.88,0:12:03.43,Default,,0,0,0,,Осы жерден құласаң, өлесің!
Dialogue: 0,0:12:04.01,0:12:06.47,Default,,0,0,0,,Сәлем! Не, сен сабырлысың ба, хашва...
Dialogue: 0,0:12:12.94,0:12:14.35,Default,,0,0,0,,Тағы да әуеніңді бұздың! Қанша рет айтуым керек саған түсіну үшін!—
Dialogue: 0,0:12:15.06,0:12:15.86,Default,,0,0,0,,Әй?
Dialogue: 0,0:12:25.53,0:12:27.62,Default,,0,0,0,,Ұлы күш!
Dialogue: 0,0:12:27.70,0:12:29.58,Default,,0,0,0,,Рух патшасы қайтыс болғаннан кейінгі өмір
Dialogue: 0,0:12:29.66,0:12:32.20,Default,,0,0,0,,Мәртебелі көмексіз мүмкін емес еді.
Dialogue: 0,0:12:33.41,0:12:35.71,Default,,0,0,0,,Нұсқау, Мәртебелі
Dialogue: 0,0:12:36.63,0:12:40.67,Default,,0,0,0,,Хашвальд, менің бірінші ұлым.
Dialogue: 0,0:12:41.17,0:12:45.05,Default,,0,0,0,,Менің артымда тұрып, менің қадамдарымды бақылаңыз.
Dialogue: 0,0:12:45.55,0:12:50.10,Default,,0,0,0,,Алдымен ұлтымызды қайта құрайық.
Dialogue: 0,0:13:14.79,0:13:17.08,Default,,0,0,0,,Уақыт келді. Дайынсыз ба?
Dialogue: 0,0:13:17.17,0:13:18.46,Default,,0,0,0,,О
Dialogue: 0,0:13:18.54,0:13:20.09,Default,,0,0,0,,Тек сенімді болу үшін,
Dialogue: 0,0:13:20.71,0:13:23.46,Default,,0,0,0,,Мен бұл жерден ешқашан қозғалмаймын.
Dialogue: 0,0:13:23.55,0:13:25.09,Default,,0,0,0,,Егер сіз мұны істегіңіз келсе, оны өзіңіз қалағандай жасаңыз.
Dialogue: 0,0:13:25.17,0:13:25.88,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:13:25.97,0:13:27.68,Default,,0,0,0,,Сіз не айтып тұрсыз?
Dialogue: 0,0:13:27.76,0:13:29.80,Default,,0,0,0,,Мен сенің кім екеніңді білмеймін...
Dialogue: 0,0:13:29.89,0:13:32.52,Default,,0,0,0,,Мен де сенің кім екеніңді білмеймін.
Dialogue: 0,0:13:33.10,0:13:36.35,Default,,0,0,0,,Біз бір-бірімізді ертерек таныстырдық.
Dialogue: 0,0:13:36.44,0:13:40.65,Default,,0,0,0,,Иваваси-кун өзін таныстырды, бірақ Юкио-кун оған мән бермеді.
Dialogue: 0,0:13:40.73,0:13:43.57,Default,,0,0,0,,Мен сенің кім екеніңді білмеймін, бірақ мен саған айтамын.
Dialogue: 0,0:13:43.65,0:13:46.15,Default,,0,0,0,,Амалсыз күресіп жатсақ та
Dialogue: 0,0:13:46.24,0:13:48.61,Default,,0,0,0,,Бұл жерден қозғалма! Сізде қандай келісім бар?
Dialogue: 0,0:13:48.70,0:13:51.66,Default,,0,0,0,,Мен оған жаңа ғана түсіп қалдым.
Dialogue: 0,0:13:51.74,0:13:53.70,Default,,0,0,0,,Соншалықты үмітсіз болуға ешқандай себеп жоқ.
Dialogue: 0,0:13:53.79,0:13:57.21,Default,,0,0,0,,Міндеттемеден үмітсіз болу шарасыз болу дегенді білдірмейді!
Dialogue: 0,0:13:57.29,0:13:59.42,Default,,0,0,0,,Мен мұнда тығылсам да, не істесем де.
Dialogue: 0,0:13:59.50,0:14:02.80,Default,,0,0,0,,Егер біз жеңілсек, бұл Гарганта да жоғалады.
Dialogue: 0,0:14:03.71,0:14:04.51,Default,,0,0,0,,Сіз ұтыласыз ба?
Dialogue: 0,0:14:05.67,0:14:06.92,Default,,0,0,0,,Тоқта, Иваваси
Dialogue: 0,0:14:07.42,0:14:10.05,Default,,0,0,0,,Жалпақ табанмен ұсталғаныңыз үшін жоғалтыңыз.
Dialogue: 0,0:14:10.64,0:14:13.01,Default,,0,0,0,,Юкио, осында қалуыңызды өтінемін.
Dialogue: 0,0:14:13.10,0:14:15.56,Default,,0,0,0,,Мен мұны біраздан бері айтқым келеді.
Dialogue: 0,0:14:15.64,0:14:17.23,Default,,0,0,0,,Және Рирука
Dialogue: 0,0:14:17.73,0:14:18.89,Default,,0,0,0,,Сіз де қалуыңыз керек.
Dialogue: 0,0:14:18.98,0:14:19.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:20.27,0:14:24.36,Default,,0,0,0,,Сіздің күшіңіз болса, алдағы шайқас қауіпті болады.
Dialogue: 0,0:14:24.44,0:14:24.94,Default,,0,0,0,,Қалыңыз
Dialogue: 0,0:14:25.03,0:14:26.61,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Жай әзіл...
Dialogue: 0,0:14:26.69,0:14:28.99,Default,,0,0,0,,Мен бір рет Шоутаниге кірдім.
Dialogue: 0,0:14:30.03,0:14:32.32,Default,,0,0,0,,Маған тек сүйкімді нәрселер ұнайды—
Dialogue: 0,0:14:32.41,0:14:34.91,Default,,0,0,0,,Қорапқа тек өзіңізге ұнайтын нәрсені салуға болады.
Dialogue: 0,0:14:35.66,0:14:38.37,Default,,0,0,0,,Сүйкімді өрмекшілер, бірақ айқайлаған алқап қандай.
Dialogue: 0,0:14:38.46,0:14:40.42,Default,,0,0,0,,Мені қорапқа салуға мүмкіндік жоқ.
Dialogue: 0,0:14:41.50,0:14:44.09,Default,,0,0,0,,Сіз мұны біз үшін істеу үшін барын салдыңыз, солай ма?
Dialogue: 0,0:14:44.67,0:14:45.67,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:14:47.30,0:14:49.13,Default,,0,0,0,,Бебебе... Шынымен де емес!
Dialogue: 0,0:14:49.22,0:14:51.43,Default,,0,0,0,,Айтпақшы, біз үшін.
Dialogue: 0,0:14:51.51,0:14:53.18,Default,,0,0,0,,Мен тағы бір нәрсе сұрағаныңызды қалаймын.
Dialogue: 0,0:14:53.97,0:14:55.85,Default,,0,0,0,,Осы жерде Юкиомен бірге болыңыз.
Dialogue: 0,0:14:56.35,0:14:58.93,Default,,0,0,0,,Кез келген уақытта қашып құтыла алатынымызға көз жеткізіңіз.
Dialogue: 0,0:15:00.81,0:15:02.19,Default,,0,0,0,,Заттарыңды үйге әкетуді ұмытып қалғансың ғой…
Dialogue: 0,0:15:04.32,0:15:05.27,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:15:06.82,0:15:08.57,Default,,0,0,0,,- (Иваваси) Йо Ичиго - (Ичиго) Иә?
Dialogue: 0,0:15:09.15,0:15:11.32,Default,,0,0,0,,Сіз есейдіңіз.
Dialogue: 0,0:15:11.41,0:15:13.78,Default,,0,0,0,,Шынымен бе? Бұл қайда?
Dialogue: 0,0:15:15.33,0:15:17.54,Default,,0,0,0,,Жоқ... шынымен емес.
Dialogue: 0,0:15:18.20,0:15:21.12,Default,,0,0,0,,Алғашында солай болған.
Dialogue: 0,0:15:27.38,0:15:29.76,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:15:33.01,0:15:33.93,Default,,0,0,0,,Фу…
Dialogue: 0,0:15:34.60,0:15:35.60,Default,,0,0,0,,Фу…
Dialogue: 0,0:15:36.76,0:15:38.35,Default,,0,0,0,,Орындалды
Dialogue: 0,0:15:44.10,0:15:45.36,Default,,0,0,0,,(Келу дыбысы)
Dialogue: 0,0:15:45.86,0:15:47.02,Default,,0,0,0,,Біз келген сияқтымыз
Dialogue: 0,0:15:48.40,0:15:49.15,Default,,0,0,0,,Кеттік
Dialogue: 0,0:15:49.65,0:15:50.40,Default,,0,0,0,,О
Dialogue: 0,0:15:52.86,0:15:54.11,Default,,0,0,0,,(дыбыс құлпын ашу)
Dialogue: 0,0:16:02.04,0:16:05.71,Default,,0,0,0,,Енді осы қақпадан өтсеңіз, Рух патшасының сарайын табасыз.
Dialogue: 0,0:16:06.84,0:16:09.34,Default,,0,0,0,,үшінңызға рахмет, мен барамын.
Dialogue: 0,0:16:09.84,0:16:11.26,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:12.63,0:16:15.43,Default,,0,0,0,,Қақпалар ашылады. Дайынсыз ба?
Dialogue: 0,0:16:15.51,0:16:16.85,Default,,0,0,0,,- (Басби) О! - (Шинигами) Жүр!
Dialogue: 0,0:16:28.44,0:16:29.98,Default,,0,0,0,,Бұл қай жер...
Dialogue: 0,0:16:30.07,0:16:31.65,Default,,0,0,0,,Рух сарайы емес
Dialogue: 0,0:16:32.15,0:16:34.78,Default,,0,0,0,,Бұл қала пейзажы Квинсилерге тиесілі.
Dialogue: 0,0:16:34.86,0:16:37.49,Default,,0,0,0,,Ей, мына жер қайда?
Dialogue: 0,0:16:41.70,0:16:44.33,Default,,0,0,0,,Жоқ... Бұл не...
Dialogue: 0,0:16:44.42,0:16:46.42,Default,,0,0,0,,Ол Рух Патша сарайына қосылуы керек еді.
Dialogue: 0,0:16:46.50,0:16:48.46,Default,,0,0,0,,Сен неге Квинси қаласындасың?
Dialogue: 0,0:16:48.96,0:16:52.88,Default,,0,0,0,,Не болып жатыр? Кисуке, сен Рейу сарайына келесің бе?
Dialogue: 0,0:16:52.97,0:16:55.93,Default,,0,0,0,,Жоқ, координаталар тікелей Сейрейтейдің үстінде.
Dialogue: 0,0:16:56.01,0:16:57.89,Default,,0,0,0,,Бұл жерде Рух патшасының сарайы болуы керек.
Dialogue: 0,0:16:57.97,0:16:59.18,Default,,0,0,0,,Ақымақ...
Dialogue: 0,0:16:59.26,0:17:02.02,Default,,0,0,0,,Мен қаққан қазық жерге жетпедің бе?
Dialogue: 0,0:17:02.68,0:17:03.43,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:17:06.40,0:17:07.40,Default,,0,0,0,,Ха…
Dialogue: 0,0:17:11.65,0:17:12.36,Default,,0,0,0,,Ичиго
Dialogue: 0,0:17:12.86,0:17:16.78,Default,,0,0,0,,Басқаша айтқанда, біз бұрын Сейрейтейден көтерген қала.
Dialogue: 0,0:17:16.86,0:17:20.20,Default,,0,0,0,,Бұл олардың Рух Патша сарайын қиратып, қайта жинағанын білдірмейді ме?
Dialogue: 0,0:17:20.28,0:17:22.66,Default,,0,0,0,,Ақымақ! Дәл қазір не болды...
Dialogue: 0,0:17:22.75,0:17:23.66,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:17:24.50,0:17:27.88,Default,,0,0,0,,Бұл сіз сонша күшке ие болғаныңызды білдіреді.
Dialogue: 0,0:17:27.96,0:17:29.17,Default,,0,0,0,,Жау
Dialogue: 0,0:17:33.01,0:17:33.63,Default,,0,0,0,,Чи…
Dialogue: 0,0:17:34.63,0:17:36.26,Default,,0,0,0,,- (Йоричи) Ичиго - (Ичиго) Иә?
Dialogue: 0,0:17:37.84,0:17:38.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:40.30,0:17:43.56,Default,,0,0,0,,Бұл жер сөзсіз Рух патшасының сарайы болса керек.
Dialogue: 0,0:17:45.89,0:17:47.23,Default,,0,0,0,,Юхабах
Dialogue: 0,0:17:47.73,0:17:51.44,Default,,0,0,0,,Мен Рух Патшасының сарайын өз үйім етіп қайта құрдым.
Dialogue: 0,0:17:52.94,0:17:56.53,Default,,0,0,0,,Қараңдаршы, қала пейзажының шеттері дөңгелек.
Dialogue: 0,0:17:56.61,0:18:01.28,Default,,0,0,0,,Бұл Рейу сарайындағы 0 нөмірлі сарайлардың бірі болса керек.
Dialogue: 0,0:18:02.03,0:18:06.00,Default,,0,0,0,,Бірақ мен оның үстінде қалқып тұруы керек Рух патшасының сарайын таба алмаймын.
Dialogue: 0,0:18:06.50,0:18:08.04,Default,,0,0,0,,Яғни...
Dialogue: 0,0:18:08.12,0:18:13.30,Default,,0,0,0,,Бұл Рух патшасының сарайы қирап, оның бәрі жау қолына өтті дегенді білдіре ме?
Dialogue: 0,0:18:14.09,0:18:16.30,Default,,0,0,0,,Сонымен... солай болды...
Dialogue: 0,0:18:17.05,0:18:19.76,Default,,0,0,0,,Гаргантаға қатысқанымыз үшін рахмет.
Dialogue: 0,0:18:19.84,0:18:21.93,Default,,0,0,0,,Мен бұған ілінген жоқпын.
Dialogue: 0,0:18:22.47,0:18:24.52,Default,,0,0,0,,Бақытты деп санау керек.
Dialogue: 0,0:18:25.14,0:18:25.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:26.48,0:18:28.14,Default,,0,0,0,,Бұл Нисаманың Рейатсуы!
Dialogue: 0,0:18:28.23,0:18:31.36,Default,,0,0,0,,Бұл реиацу...Юширо
Dialogue: 0,0:18:31.44,0:18:32.23,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:18:32.73,0:18:34.02,Default,,0,0,0,,Шифуин Юсиро
Dialogue: 0,0:18:34.11,0:18:36.82,Default,,0,0,0,,Мен Шифуин отбасынан шығарылғаннан кейін
Dialogue: 0,0:18:36.90,0:18:39.61,Default,,0,0,0,,Менің інім Шифуин әулетінің басшысы болды.
Dialogue: 0,0:18:39.70,0:18:43.16,Default,,0,0,0,,Йоруичи-сан, сенің інің бар ма еді? Бұл менің бірінші рет естуім.
Dialogue: 0,0:18:43.24,0:18:46.91,Default,,0,0,0,,Неліктен мен ініммен таныстырудың қиындығына баруым керек?
Dialogue: 0,0:18:47.00,0:18:48.79,Default,,0,0,0,,Сен менің күйеуімсің бе?
Dialogue: 0,0:18:48.87,0:18:51.83,Default,,0,0,0,,Мен қазір сол жаққа бара жатырмын, қымбаттым!
Dialogue: 0,0:18:52.46,0:18:53.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:53.42,0:18:55.67,Default,,0,0,0,,Ой... Уау!
Dialogue: 0,0:18:56.17,0:18:59.34,Default,,0,0,0,,Ба... сен ақымақ! Сен не істеп жатырсың?
Dialogue: 0,0:18:59.42,0:19:00.84,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:19:00.93,0:19:03.68,Default,,0,0,0,,Неге екені белгісіз... Аяқ таба алмадым.
Dialogue: 0,0:19:03.76,0:19:05.72,Default,,0,0,0,,Шамасы, осында
Dialogue: 0,0:19:05.81,0:19:09.02,Default,,0,0,0,,Рухани балалармен тірек болу қиын сияқты.
Dialogue: 0,0:19:09.10,0:19:10.44,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:19:10.52,0:19:12.81,Default,,0,0,0,,Оны ағам да сезетін шығар.
Dialogue: 0,0:19:13.31,0:19:16.94,Default,,0,0,0,,Рух сарайының атмосферасын толтыратын рухтардың шоғырлануы өте жоғары.
Dialogue: 0,0:19:17.94,0:19:18.94,Default,,0,0,0,,Әрине
Dialogue: 0,0:19:19.78,0:19:21.16,Default,,0,0,0,,Бастапқыда
Dialogue: 0,0:19:21.24,0:19:24.41,Default,,0,0,0,,Осыншама рухани шоғырланумен тірек тұрғызуға мүмкіндік жоқ.
Dialogue: 0,0:19:24.91,0:19:27.70,Default,,0,0,0,,Олай болса орындалмайтын бір себеп бар.
Dialogue: 0,0:19:27.79,0:19:33.33,Default,,0,0,0,,Бұл Аннигилятор жағы осы аймақтағы барлық рухтарды басқарады дегенді білдіреді.
Dialogue: 0,0:19:34.29,0:19:39.13,Default,,0,0,0,,Шабуылдаушы тараптың жауға тиімсіз ұрыс алаңын дайындауы заңдылық.
Dialogue: 0,0:19:39.63,0:19:43.55,Default,,0,0,0,,Егер Квинсидің мәні айналасындағы рухтарды манипуляциялау және пайдалану болса.
Dialogue: 0,0:19:43.64,0:19:45.35,Default,,0,0,0,,Егер сіз басқарма басшысы болсаңыз
Dialogue: 0,0:19:45.43,0:19:47.56,Default,,0,0,0,,Осыны көп жасайық.
Dialogue: 0,0:19:48.56,0:19:51.73,Default,,0,0,0,,Әсіресе, егер адам Рух Патшасын өлтіруге лайық болса.
Dialogue: 0,0:19:51.81,0:19:53.19,Default,,0,0,0,,Шынында да…
Dialogue: 0,0:19:53.69,0:19:58.19,Default,,0,0,0,,Мен Рух Патшасының сарайына кірсем де, Рух Патшасының рухани қысымын мүлдем сезе алмадым.
Dialogue: 0,0:19:58.69,0:20:02.36,Default,,0,0,0,,Сонда Рух патшасы өлтірілді ме?
Dialogue: 0,0:20:02.45,0:20:03.49,Default,,0,0,0,,Енді, енді.
Dialogue: 0,0:20:03.57,0:20:05.28,Default,,0,0,0,,Алыста болса да
Dialogue: 0,0:20:05.37,0:20:08.79,Default,,0,0,0,,Бақытымызға орай, Ичиго мен басқалардың реиацулары сезіледі.
Dialogue: 0,0:20:08.87,0:20:12.50,Default,,0,0,0,,Алдыңғы топтың жойылмағаны жақсы жаңалық.
Dialogue: 0,0:20:13.08,0:20:15.25,Default,,0,0,0,,Рух патшасы жау қолынан өлсе
Dialogue: 0,0:20:15.33,0:20:19.00,Default,,0,0,0,,Жауды жеңіп, жаңа Рух патшасын таңдаңыз.
Dialogue: 0,0:20:19.09,0:20:23.59,Default,,0,0,0,,Егер Үкітаке қазір сөйлей алатын болса, менің ойымша, ол осылай айтар еді.
Dialogue: 0,0:20:25.01,0:20:26.18,Default,,0,0,0,,Кеттік.
Dialogue: 0,0:20:26.68,0:20:31.23,Default,,0,0,0,,Мен Ичигомен және басқалармен кездесе алмағандықтан, жол бар бағытта жүруден басқа амалым жоқ.
Dialogue: 0,0:20:31.31,0:20:33.64,Default,,0,0,0,,Біз, Готей 13 корпус
Dialogue: 0,0:20:34.14,0:20:36.48,Default,,0,0,0,,Соттың мүддесі үшін алға шығайық.
Dialogue: 0,0:20:36.56,0:20:37.73,Default,,0,0,0,,- (Араны ұрып-соғу) Ах! - (Шинигами) Иә!
Dialogue: 0,0:20:38.32,0:20:39.98,Default,,0,0,0,,Біз жеңілдік.
Dialogue: 0,0:20:40.07,0:20:41.78,Default,,0,0,0,,-Уау! -иә?
Dialogue: 0,0:20:42.65,0:20:44.15,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:20:58.59,0:21:00.30,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:21:00.38,0:21:04.76,Default,,0,0,0,,Ештеңе, бұл жаудың штабы ғой, солай ма?
Dialogue: 0,0:21:05.34,0:21:08.01,Default,,0,0,0,,Қашудан да, жасырудан да алыс
Dialogue: 0,0:21:08.10,0:21:10.93,Default,,0,0,0,,Тез кел деп тұрған сияқтысың.
Dialogue: 0,0:21:11.43,0:21:12.77,Default,,0,0,0,,Күміс шашты жарты эльф
Dialogue: 0,0:21:14.14,0:21:15.85,Default,,0,0,0,,Бұл орындалады.
Dialogue: 0,0:21:21.11,0:21:22.73,Default,,0,0,0,,Джухабах мырза
Dialogue: 0,0:21:22.82,0:21:26.70,Default,,0,0,0,,Ичиго Куросакидің бір партиясы және Готей 13 корпусының бір партиясы.
Dialogue: 0,0:21:26.78,0:21:28.91,Default,,0,0,0,,Олар шамамен бір уақытта басып кірген сияқты.
Dialogue: 0,0:21:29.41,0:21:29.95,Default,,0,0,0,,Бұл…
Dialogue: 0,0:21:30.03,0:21:31.54,Default,,0,0,0,,«Нағыз әлем (верт)»
Dialogue: 0,0:21:32.29,0:21:36.79,Default,,0,0,0,,Бұл қамал ақырында жаңа әлемнің негізі болды.
Dialogue: 0,0:21:36.87,0:21:39.79,Default,,0,0,0,,Бір ғана шынайы әлем
Dialogue: 0,0:21:40.42,0:21:43.80,Default,,0,0,0,,Ол «Нағыз әлем сарайы» (Ваалвельт) деп аталады.
Dialogue: 0,0:21:43.88,0:21:45.13,Default,,0,0,0,,Сосын сол жігіттер
Dialogue: 0,0:21:45.22,0:21:47.76,Default,,0,0,0,,Әрбір соңғы сарбазды құртайық.
Dialogue: 0,0:21:48.26,0:21:51.30,Default,,0,0,0,,Мәртебелі алдында болашаққа жету
Dialogue: 0,0:21:51.81,0:21:54.56,Default,,0,0,0,,Бұл жаңа әлемнің негізі болады...
Dialogue: 0,0:21:55.52,0:21:57.02,Default,,0,0,0,,Ваальвельтте
Dialogue: 0,0:22:06.53,0:22:08.53,Default,,0,0,0,,♪～
Dialogue: 0,0:23:31.99,0:23:33.99,Default,,0,0,0,,～♪
Dialogue: 0,0:23:37.74,0:23:40.83,Default,,0,0,0,,Азу тістен тамшылаған от сөнбейді
Dialogue: 0,0:23:41.54,0:23:44.46,Default,,0,0,0,,Өткір өрісті күйдіру
Dialogue: 0,0:23:45.38,0:23:48.76,Default,,0,0,0,,Достың бейнесін шығару
Dialogue: 0,0:23:50.26,0:23:56.26,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
