Dialogue: 0,0:02:04.47,0:02:06.27,Default,,0,0,0,,Оны сөмкеңізге салыңыз
Dialogue: 0,0:02:06.39,0:02:06.89,Default,,0,0,0,,Әдеттегідей, ертеңгідей Әдеттегідей ертең кездескенше
Dialogue: 0,0:02:06.64,0:02:09.06,Default,,0,0,0,,Әдеттегідей, ертеңгідей
Dialogue: 0,0:02:09.06,0:02:09.56,Default,,0,0,0,,Әдеттегідей ертең кездескенше
Dialogue: 0,0:02:09.77,0:02:10.27,Default,,0,0,0,,КЕШЕ қош бол
Dialogue: 0,0:02:09.90,0:02:10.40,Default,,0,0,0,,Қош бол, КЕШЕ
Dialogue: 0,0:02:10.19,0:02:10.69,Default,,0,0,0,,КЕШЕ қош бол
Dialogue: 0,0:02:10.81,0:02:11.31,Default,,0,0,0,,Қош бол, КЕШЕ
Dialogue: 0,0:02:11.11,0:02:14.86,Default,,0,0,0,,365 күндік оқиғалар
Dialogue: 0,0:02:15.11,0:02:16.99,Default,,0,0,0,,Егер сен мені ересек қылсаң
Dialogue: 0,0:02:17.11,0:02:19.95,Default,,0,0,0,,Тіпті көз жасыңды көрсетпе
Dialogue: 0,0:02:20.28,0:02:20.78,Default,,0,0,0,,КЕШЕ қош бол
Dialogue: 0,0:02:20.41,0:02:21.45,Default,,0,0,0,,Қош бол, КЕШЕ
Dialogue: 0,0:02:21.37,0:02:21.87,Default,,0,0,0,,КЕШЕ қош бол
Dialogue: 0,0:02:21.70,0:02:25.75,Default,,0,0,0,,365 күндік естеліктер
Dialogue: 0,0:02:25.87,0:02:28.25,Default,,0,0,0,,Тіпті адам болып кетсем де
Dialogue: 0,0:02:28.21,0:02:30.79,Default,,0,0,0,,Ол аздап өшпейді
Dialogue: 0,0:02:30.79,0:02:31.29,Default,,0,0,0,,Мен ешқандай түс көрсетпеймін Ол мүлдем өшпейді
Dialogue: 0,0:02:38.63,0:02:41.01,Default,,0,0,0,,Құдайдың субтитр жұбы
Dialogue: 0,0:02:45.01,0:02:50.02,Default,,0,0,0,,Бұл субтитр көзі сатып алуға, білім алмасуға қол жетімді және коммерциялық пайдалануға тыйым салынған илаһи субтитрлер жұбы.
Dialogue: 0,0:02:45.87,0:02:47.36,Default,,0,0,0,,Жоспар орындалды.
Dialogue: 0,0:02:47.86,0:02:49.73,Default,,0,0,0,,Енді орындау уақыты келді
Dialogue: 0,0:02:50.08,0:02:52.30,Default,,0,0,0,,Зымыранды тек екі адам басқара алады.
Dialogue: 0,0:02:52.66,0:02:53.51,Default,,0,0,0,,Барғысы келетін адамдар
Dialogue: 0,0:02:53.55,0:02:54.51,Default,,0,0,0,,Иә
Dialogue: 0,0:02:56.72,0:02:57.82,Default,,0,0,0,,Бұл жерде тақды шарлатанға тапсыратын орын да емес қой, иә?
Dialogue: 0,0:02:58.12,0:03:00.57,Default,,0,0,0,,О, бұл бала.
Dialogue: 0,0:03:00.72,0:03:03.87,Default,,0,0,0,,Бұл ешқашан сәтті болмаған сынақ құрылғысы.
Dialogue: 0,0:03:04.42,0:03:06.06,Default,,0,0,0,,Әлі де мінгісі келетін адамдар
Dialogue: 0,0:03:07.81,0:03:09.08,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:03:09.27,0:03:10.96,Default,,0,0,0,,Сонда да мінгім келеді
Dialogue: 0,0:03:11.97,0:03:15.04,Default,,0,0,0,,Зымырандар меха жанкүйерлері үшін міндетті болып табылады.
Dialogue: 0,0:03:15.31,0:03:17.92,Default,,0,0,0,,Бірақ мен оны сізге осы жолы беремін.
Dialogue: 0,0:03:18.18,0:03:19.22,Default,,0,0,0,,Нагиса Джо
Dialogue: 0,0:03:21.32,0:03:25.56,Default,,0,0,0,,Маған басқаларға арқа сүйейтін мұндай қауіпті сынақ ұнамайды.
Dialogue: 0,0:03:25.74,0:03:27.90,Default,,0,0,0,,Терасака мен манекені бортқа салыңыз.
Dialogue: 0,0:03:28.25,0:03:30.45,Default,,0,0,0,,Құлап кетсе де зияны болмайды.
Dialogue: 0,0:03:31.36,0:03:35.82,Default,,0,0,0,,Арандатушылық: Шайқас жұмысы және жан тыныштығы: Қастандық жағажайы?
Dialogue: 0,0:03:36.04,0:03:39.03,Default,,0,0,0,,Ғарыш станциясын басып алу үшін жақсы таңдау болуы мүмкін.
Dialogue: 0,0:03:39.34,0:03:43.07,Default,,0,0,0,,Иә, ақша тауып, өзіміз мінеміз.
Dialogue: 0,0:03:43.46,0:03:46.38,Default,,0,0,0,,Екеуің қатты күрестіңдер.
Dialogue: 0,0:03:46.41,0:03:48.87,Default,,0,0,0,,Менің ойымша, біз де бір болдық.
Dialogue: 0,0:03:48.98,0:03:51.30,Default,,0,0,0,,Жауапкершілікті алыңыз және бірінші болыңыз
Dialogue: 0,0:03:51.39,0:03:52.24,Default,,0,0,0,,Жұмыс
Dialogue: 0,0:03:53.35,0:03:54.54,Default,,0,0,0,,Кеттік
Dialogue: 0,0:03:55.06,0:03:59.63,Default,,0,0,0,,Дипломдық сапар Достарыммен ғарышқа ұшатын болсам, тамаша болар еді.
Dialogue: 0,0:04:01.50,0:04:04.97,Default,,0,0,0,,Иә, иә, мен сенің айтқаныңды тыңдауға уәде беремін.
Dialogue: 0,0:04:05.20,0:04:07.49,Default,,0,0,0,,Иә, шешілді.
Dialogue: 0,0:04:44.01,0:04:45.73,Default,,0,0,0,,Уау, керемет
Dialogue: 0,0:04:45.95,0:04:47.80,Default,,0,0,0,,Бұл зымыран ұшыру орны емес.
Dialogue: 0,0:04:46.65,0:04:47.51,Default,,0,0,0,,Мұнда
Dialogue: 0,0:04:47.80,0:04:50.31,Default,,0,0,0,,Балалар, мұнда қалай келдіңдер?
Dialogue: 0,0:04:50.33,0:04:52.14,Default,,0,0,0,,Тіпті жеке куәлігіңіз де жоқ.
Dialogue: 0,0:04:52.16,0:04:54.41,Default,,0,0,0,,Мен гастрольдік сапарға келгенде адасып қалдым.
Dialogue: 0,0:04:54.46,0:04:57.06,Default,,0,0,0,,Қарттың артынан ергенімде маған бірдеңе болды.
Dialogue: 0,0:04:57.08,0:04:59.87,Default,,0,0,0,,​​Сіз жолдың соңына дейін келгендіктен, кері санауға рұқсат етіңіз.
Dialogue: 0,0:04:59.87,0:05:04.45,Default,,0,0,0,,Ритсу: Бұл басқару бөлмесіндегі компьютер болғандықтан, оны қай компьютерге қойғаныңыз маңызды емес.
Dialogue: 0,0:05:04.45,0:05:05.17,Default,,0,0,0,,Иә
Dialogue: 0,0:05:05.59,0:05:09.33,Default,,0,0,0,,Егер сіз оны осыған қоссаңыз, бірден кетесіз.
Dialogue: 0,0:05:13.66,0:05:16.04,Default,,0,0,0,,Қауіпсіздік талдауы сәтті аяқталды
Dialogue: 0,0:05:16.27,0:05:20.75,Default,,0,0,0,,Қашықтан басқаруға арналған вирус басқару бөлмесіндегі компьютерге еніп кеткен.
Dialogue: 0,0:05:21.30,0:05:26.13,Default,,0,0,0,,Бұдан былай мен басқару орталығы мен орталықтың жүйелерін өз тапсырыстарыммен басқара аламын.
Dialogue: 0,0:05:26.40,0:05:28.05,Default,,0,0,0,,Бірінші кезеңді өшіріңіз
Dialogue: 0,0:05:28.53,0:05:30.14,Default,,0,0,0,,Рицу, бірден.
Dialogue: 0,0:05:30.26,0:05:33.10,Default,,0,0,0,,Инвазия жолының бір бөлігі жер үстінде.
Dialogue: 0,0:05:33.32,0:05:34.81,Default,,0,0,0,,Бірдеңе жасауға болады ма деп ойлаймын
Dialogue: 0,0:05:34.94,0:05:35.92,Default,,0,0,0,,Қосымша күштер! Біз тез арада қорғаныс жасауымыз керек, әйтпесе қайтадан қоршауға алынамыз.
Dialogue: 0,0:05:36.19,0:05:38.23,Default,,0,0,0,,Ағымдағы орынды тексеріңіз
Dialogue: 0,0:05:40.54,0:05:41.40,Default,,0,0,0,,Аяқталды
Dialogue: 0,0:05:41.86,0:05:45.29,Default,,0,0,0,,Сәйкес бекітілген нүктелік камераны 10 секундқа өшіріңіз
Dialogue: 0,0:05:45.40,0:05:46.03,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:05:46.34,0:05:49.66,Default,,0,0,0,,3 2 1 0
Dialogue: 0,0:06:04.42,0:06:05.67,Default,,0,0,0,,Күзетші өтіп бара жатыр
Dialogue: 0,0:06:06.11,0:06:08.13,Default,,0,0,0,,Келесі патруль 10 минуттан кейін болады.
Dialogue: 0,0:06:08.44,0:06:11.11,Default,,0,0,0,,Бақылау камерасының көру бұрышын реттеу аяқталды
Dialogue: 0,0:06:11.44,0:06:14.04,Default,,0,0,0,,Бұл өшірілмейтінін ескеріңіз.
Dialogue: 0,0:06:14.56,0:06:15.20,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:06:25.55,0:06:28.74,Default,,0,0,0,,Зымыран кіреберісіне дейін баспалдақпен 50 м
Dialogue: 0,0:06:30.88,0:06:31.96,Default,,0,0,0,,Коросей
Dialogue: 0,0:06:34.07,0:06:35.83,Default,,0,0,0,,Инспекция Чирибацу
Dialogue: 0,0:06:36.18,0:06:38.46,Default,,0,0,0,,Егер жазатайым оқиға болса, бұл жауапкершілік мәселесі.
Dialogue: 0,0:06:38.51,0:06:40.33,Default,,0,0,0,,Өтінемін, жағымсыз ештеңе айтпаңыз
Dialogue: 0,0:06:40.68,0:06:44.38,Default,,0,0,0,,Біз манекеннің жазылған бейнесін басқару бөлмесіне жібереміз.
Dialogue: 0,0:06:44.61,0:06:47.42,Default,,0,0,0,,Енді оларды адаммен алмастырсаң да, олар білмейді.
Dialogue: 0,0:06:48.30,0:06:50.13,Default,,0,0,0,,Кеттік
Dialogue: 0,0:06:52.82,0:06:59.24,Default,,0,0,0,,100 99 98 97 96 95
Dialogue: 0,0:06:59.58,0:07:06.15,Default,,0,0,0,,94 93 92 91 90 89
Dialogue: 0,0:07:06.17,0:07:09.88,Default,,0,0,0,,Сұйық оттегі сұйық сутегі жүйесі дайын
Dialogue: 0,0:07:10.67,0:07:12.09,Default,,0,0,0,,Аа.
Dialogue: 0,0:07:12.34,0:07:15.28,Default,,0,0,0,,25 24 23
Dialogue: 0,0:07:13.60,0:07:15.30,Default,,0,0,0,,Ұшу режимі қосулы
Dialogue: 0,0:07:15.60,0:07:19.83,Default,,0,0,0,,22 21 20 19
Dialogue: 0,0:07:20.23,0:07:24.82,Default,,0,0,0,,Екеуміз де бұрын осындай шиеленісті бастан өткердік, солай ма?
Dialogue: 0,0:07:26.46,0:07:31.40,Default,,0,0,0,,Бірақ содан бері Нағиса екеуміз аздап өзгерген шығармыз.
Dialogue: 0,0:07:31.76,0:07:37.19,Default,,0,0,0,,5 4 3 2 1
Dialogue: 0,0:07:32.19,0:07:34.02,Default,,0,0,0,,Барлық жүйелер дайын
Dialogue: 0,0:07:35.01,0:07:36.34,Default,,0,0,0,,Негізгі қозғалтқышты тұтандыру
Dialogue: 0,0:07:39.21,0:07:40.66,Default,,0,0,0,,SRB тұтану
Dialogue: 0,0:07:47.08,0:07:48.16,Default,,0,0,0,,Көтерілу
Dialogue: 0,0:08:08.56,0:08:09.96,Default,,0,0,0,,Бұл өте жылдам.
Dialogue: 0,0:08:10.11,0:08:12.30,Default,,0,0,0,,Неге менің артымнан жүрсің, Коро-сенсэй?
Dialogue: 0,0:08:12.52,0:08:15.05,Default,,0,0,0,,Жоқ, мен енді ғана алаңдай бастадым.
Dialogue: 0,0:08:15.48,0:08:18.81,Default,,0,0,0,,Мұғалімнің деректерін алуға тым көп құмар болмаңыз
Dialogue: 0,0:08:18.82,0:08:22.69,Default,,0,0,0,,Оның орнына ғарыш сапарыңыздан ләззат алыңыз.
Dialogue: 0,0:08:26.99,0:08:28.01,Default,,0,0,0,,Коросей
Dialogue: 0,0:08:28.62,0:08:30.45,Default,,0,0,0,,Мен тек осыны айтқым келеді.
Dialogue: 0,0:08:31.12,0:08:36.03,Default,,0,0,0,,Бізге білім алу мүмкіндігін беру үшін өміріңізді толық пайдаланыңыз.
Dialogue: 0,0:08:36.58,0:08:38.62,Default,,0,0,0,,Мен мұны шынымен бағалаймын.
Dialogue: 0,0:08:39.67,0:08:45.64,Default,,0,0,0,,Біз үшін Коро-сенсэйдің өмірі тек оқу материалдарымен аяқталатындай жеңіл емес.
Dialogue: 0,0:08:47.13,0:08:50.40,Default,,0,0,0,,Білемін, қуаныштымын.
Dialogue: 0,0:08:55.56,0:08:57.28,Default,,0,0,0,,Жылдам
Dialogue: 0,0:09:00.29,0:09:04.23,Default,,0,0,0,,Ғарышқа ұшу үшін қажетті жылдамдық - 23 Mach
Dialogue: 0,0:09:05.46,0:09:11.15,Default,,0,0,0,,Бұл күні біз алғаш рет Коросейдің жылдамдығынан асып түстік.
Dialogue: 0,0:10:30.76,0:10:31.73,Default,,0,0,0,,Жарайды
Dialogue: 0,0:10:42.45,0:10:44.35,Default,,0,0,0,,Бұл байланыс мәселесі ме?
Dialogue: 0,0:10:48.02,0:10:49.03,Default,,0,0,0,,Сәлем
Dialogue: 0,0:10:49.29,0:10:52.53,Default,,0,0,0,,Бұл Мизуи мырза. Мен оны теледидардан көрдім.
Dialogue: 0,0:10:57.35,0:10:59.72,Default,,0,0,0,,Жерге реле үзілді.
Dialogue: 0,0:10:59.78,0:11:01.26,Default,,0,0,0,,Ритсуға рахмет
Dialogue: 0,0:11:42.01,0:11:45.33,Default,,0,0,0,,Бұл жаман. Бұл жігіттер тым тез салқындап кетті.
Dialogue: 0,0:11:45.82,0:11:48.23,Default,,0,0,0,,Кәсіби астронавттан күткендей
Dialogue: 0,0:11:49.60,0:11:54.52,Default,,0,0,0,,Алдымен осы екі қорқынышты балаға браво айтайын.
Dialogue: 0,0:11:55.25,0:11:56.32,Default,,0,0,0,,Жапон
Dialogue: 0,0:11:56.79,0:12:00.61,Default,,0,0,0,,Бірақ сіз мұны осы алты адаммен, соның ішінде әскери қызметкерлермен жасауды жоспарлап отырсыз ба?
Dialogue: 0,0:12:01.04,0:12:03.36,Default,,0,0,0,,Бомба тіпті қауіп емес.
Dialogue: 0,0:12:15.89,0:12:17.80,Default,,0,0,0,,Жарайды, пайдасыз ұрыстар.
Dialogue: 0,0:12:18.35,0:12:20.67,Default,,0,0,0,,Бұл жер ұрысты ең жек көреді.
Dialogue: 0,0:12:21.10,0:12:23.00,Default,,0,0,0,,Біз бұл туралы сөйлесеміз, сондықтан мені босатыңыз.
Dialogue: 0,0:12:28.91,0:12:33.17,Default,,0,0,0,,Деректерді ұрласаңыз да, үйге қайтып бара жатқанда не істейсіз?
Dialogue: 0,0:12:33.54,0:12:36.20,Default,,0,0,0,,Ұрлау кезінде ынтымақтастықты сұрайсыз ба?
Dialogue: 0,0:12:36.33,0:12:37.82,Default,,0,0,0,,Мен үйге өз бетіммен бара аламын.
Dialogue: 0,0:12:38.17,0:12:41.94,Default,,0,0,0,,Менің сыныптасым қайту траекториясын тамаша есептеді.
Dialogue: 0,0:12:41.96,0:12:42.56,Default,,0,0,0,,Иә
Dialogue: 0,0:12:43.15,0:12:47.20,Default,,0,0,0,,Нақты түзетулер үшін мұғалім оны ауада итереді.
Dialogue: 0,0:12:49.00,0:12:53.35,Default,,0,0,0,,Жас болғандықтан өмірге тым жеңіл қарайтын шығарсыз.
Dialogue: 0,0:12:54.51,0:12:56.92,Default,,0,0,0,,Мен де келгім келгендіктен келмедім.
Dialogue: 0,0:12:57.44,0:13:00.59,Default,,0,0,0,,Бірақ досым маған баруымды айтты.
Dialogue: 0,0:13:01.76,0:13:02.73,Default,,0,0,0,,Жұмыс
Dialogue: 0,0:13:03.26,0:13:05.33,Default,,0,0,0,,Мен өмір дедім.
Dialogue: 0,0:13:05.61,0:13:08.45,Default,,0,0,0,,Мен соңғы уақытта өмір туралы көп ойлайтын болдым.
Dialogue: 0,0:13:08.82,0:13:12.78,Default,,0,0,0,,Өйткені біз мұғалімді өлтіретін сыныптағы оқушылармыз.
Dialogue: 0,0:13:13.52,0:13:15.91,Default,,0,0,0,,Өмірді өмірмен қарсы алыңыз
Dialogue: 0,0:13:16.71,0:13:18.96,Default,,0,0,0,,Мен мұндай шешімді үйрендім деп ойладым.
Dialogue: 0,0:13:19.61,0:13:21.11,Default,,0,0,0,,Балалар, сендер бірдейсіңдер, солай ма?
Dialogue: 0,0:13:22.47,0:13:26.31,Default,,0,0,0,,Мақсатыңыз жасаған жоспарға шынымен сенетін сияқтысыз.
Dialogue: 0,0:13:28.91,0:13:29.79,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:13:30.30,0:13:32.90,Default,,0,0,0,,Ұрлаушының талаптарын орындау менің міндетім.
Dialogue: 0,0:13:36.02,0:13:40.09,Default,,0,0,0,,Бірақ алдымен маған керек-жарақтарды түсіруге көмектесіңізші.
Dialogue: 0,0:13:40.60,0:13:43.46,Default,,0,0,0,,Тез шығып кетуі үшін оларды жұмысқа алайық.
Dialogue: 0,0:13:48.05,0:13:51.90,Default,,0,0,0,,Кіші орта мектеп оқушыларына сирек тәжірибе берейік
Dialogue: 0,0:13:52.33,0:13:54.39,Default,,0,0,0,,Менің ойымша, бұл жоспар болды.
Dialogue: 0,0:13:57.01,0:13:59.21,Default,,0,0,0,,Бұл мұғалімге көмектесуі мүмкін.
Dialogue: 0,0:13:59.37,0:14:00.45,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:14:00.99,0:14:03.63,Default,,0,0,0,,Бұл Нағисаға жақсы.
Dialogue: 0,0:14:04.19,0:14:05.48,Default,,0,0,0,,Оны өз бетінше қалдыр
Dialogue: 0,0:14:05.61,0:14:06.35,Default,,0,0,0,,Жоқ
Dialogue: 0,0:14:06.54,0:14:09.92,Default,,0,0,0,,Мен барлығының көмектесуге шешім қабылдауына қарсы емеспін.
Dialogue: 0,0:14:10.74,0:14:16.00,Default,,0,0,0,,Менің ойымша, Коро-сенсейдің өзі біздің не істегенімізді қалайды.
Dialogue: 0,0:14:19.82,0:14:24.02,Default,,0,0,0,,Бұл супер жаратылыстың жарылуын болдырмайтын эксперименталды деректер.
Dialogue: 0,0:14:24.24,0:14:25.80,Default,,0,0,0,,Жасандылықтың дәлелі жоқ
Dialogue: 0,0:14:25.90,0:14:28.93,Default,,0,0,0,,Тәжірибе үшін деректердің толы екенін растаңыз.
Dialogue: 0,0:14:29.24,0:14:30.89,Default,,0,0,0,,Мен оны көшіріп алып, қарызға аламын.
Dialogue: 0,0:14:31.35,0:14:32.85,Default,,0,0,0,,Көшіру аяқталды
Dialogue: 0,0:14:33.31,0:14:35.36,Default,,0,0,0,,Үйге барып, тексеріп көрейік.
Dialogue: 0,0:14:35.41,0:14:38.32,Default,,0,0,0,,Иә, тым ұзақ қалдым, кешіріңіз.
Dialogue: 0,0:14:38.66,0:14:39.53,Default,,0,0,0,,Қария
Dialogue: 0,0:14:40.40,0:14:41.93,Default,,0,0,0,,Мен саған мынаны беремін.
Dialogue: 0,0:14:43.92,0:14:46.88,Default,,0,0,0,,Шынымды айтсам, бұл кәдімгі ас үй.
Dialogue: 0,0:14:46.93,0:14:49.15,Default,,0,0,0,,Қанша рет айтсаң да түсінбейтін ақымақтар әрқашан болады.
Dialogue: 0,0:14:49.47,0:14:52.78,Default,,0,0,0,,Мені бомбамен қорқытып, қарсы тұра алмайтындай кейіп таныттым.
Dialogue: 0,0:14:52.80,0:14:55.20,Default,,0,0,0,,Саған қиындық тудырғаным үшін кешірім сұраймын.
Dialogue: 0,0:14:55.26,0:14:57.18,Default,,0,0,0,,​​Бұл зерігуден құтылу болды, солай ма?
Dialogue: 0,0:14:59.37,0:15:02.57,Default,,0,0,0,,Досыңның үйіндегідей нөлдік гравитацияда жүзіңіз
Dialogue: 0,0:15:02.90,0:15:06.21,Default,,0,0,0,,Кәмпит дүкенінде сауда жасау сияқты өте құпия келіссөздер.
Dialogue: 0,0:15:06.92,0:15:10.68,Default,,0,0,0,,Мектептен қайтып келе жатқандай атмосфераға кіру
Dialogue: 0,0:15:11.55,0:15:14.36,Default,,0,0,0,,Кіші мектеп оқушысы болды, ол қатты таң қалды.
Dialogue: 0,0:15:34.60,0:15:37.12,Default,,0,0,0,,Көзді ашып-жұмғанша уақыт өтті, кеңістік
Dialogue: 0,0:15:38.30,0:15:41.72,Default,,0,0,0,,Біз Жерге аман-есен орала аламыз ба?
Dialogue: 0,0:15:41.79,0:15:42.50,Default,,0,0,0,,Ритсу
Dialogue: 0,0:15:43.88,0:15:44.79,Default,,0,0,0,,Ритсу
Dialogue: 0,0:15:45.77,0:15:47.15,Default,,0,0,0,,Мақсаттының екінші ұлы
Dialogue: 0,0:15:47.40,0:15:52.22,Default,,0,0,0,,Жерге қауіпсіз қону үшін көптеген орбиталық есептеулер жүргізілді.
Dialogue: 0,0:15:52.49,0:15:55.95,Default,,0,0,0,,Бұл ғарыш кемесі енді менің денем.
Dialogue: 0,0:15:56.44,0:15:59.73,Default,,0,0,0,,Оның үстіне, маған жүктелген сенсорлардың көп саны
Dialogue: 0,0:15:59.82,0:16:02.91,Default,,0,0,0,,Біз бұрынғыдан да көп нәрсені сеземіз.
Dialogue: 0,0:16:03.37,0:16:07.57,Default,,0,0,0,,Сыртқы температура Ауа қысымы Жылдамдық Көрініс
Dialogue: 0,0:16:08.23,0:16:09.65,Default,,0,0,0,,Нагиса-сан Джо-сан
Dialogue: 0,0:16:10.00,0:16:15.30,Default,,0,0,0,,Сіздің тыныс алуыңыз, сөйлесуіңіз, тамыр соғуыңыз және жылуыңыз анық
Dialogue: 0,0:16:16.03,0:16:20.22,Default,,0,0,0,,Көп ойлан, қозғал, сез
Dialogue: 0,0:16:21.87,0:16:22.79,Default,,0,0,0,,Дұрыс айтпадым ба, Крюгер мырза?
Dialogue: 0,0:16:23.31,0:16:27.72,Default,,0,0,0,,Бұл миссия менің интеллектімді дамытты деп ойлаймын.
Dialogue: 0,0:16:29.26,0:16:31.01,Default,,0,0,0,,Ей, екеуің де.
Dialogue: 0,0:16:32.02,0:16:35.76,Default,,0,0,0,,Мен өз эмоцияларымды алғаш рет түсініп отырмын.
Dialogue: 0,0:16:36.61,0:16:38.27,Default,,0,0,0,,Мен бақыттымын
Dialogue: 0,0:16:38.91,0:16:42.32,Default,,0,0,0,,Мен осы сыныпта болғаныма қуаныштымын.
Dialogue: 0,0:17:09.08,0:17:10.50,Default,,0,0,0,,Уақытында
Dialogue: 0,0:17:10.57,0:17:12.99,Default,,0,0,0,,Ғарыш сапарыңызда екеуіңізге де сәттілік...
Dialogue: 0,0:17:12.99,0:17:13.66,Default,,0,0,0,,Атцу
Dialogue: 0,0:17:14.23,0:17:15.38,Default,,0,0,0,,Коросей
Dialogue: 0,0:17:17.57,0:17:20.74,Default,,0,0,0,,Мұғалімнің келіссөздерге араласуының қажеті жоқ еді.
Dialogue: 0,0:17:20.90,0:17:24.53,Default,,0,0,0,,Ғарыштағы адамдар сөйлегенде таңқаларлықтай сөйлесе алды.
Dialogue: 0,0:17:24.70,0:17:25.80,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:17:26.06,0:17:27.93,Default,,0,0,0,,Қалғанын мұғалім бассын.
Dialogue: 0,0:17:28.06,0:17:29.08,Default,,0,0,0,,Кернеу ыстық
Dialogue: 0,0:17:29.12,0:17:31.15,Default,,0,0,0,,Кернеу, ыстық, ыстық, ыстық
Dialogue: 0,0:17:31.15,0:17:32.83,Default,,0,0,0,,Баратын жер ыстық
Dialogue: 0,0:17:39.52,0:17:41.93,Default,,0,0,0,,Мен оралдым Мен оралдым
Dialogue: 0,0:17:42.68,0:17:44.50,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе.
Dialogue: 0,0:17:44.64,0:17:50.59,Default,,0,0,0,,Барлығы адасып, уайымдап, абдырап, жанжалдасып жүрген ай болды.
Dialogue: 0,0:17:51.18,0:17:54.01,Default,,0,0,0,,Ақырында біз ғарышқа аттандық
Dialogue: 0,0:17:57.18,0:17:59.27,Default,,0,0,0,,«Түстен кейінге дейін тікелей эфир»
Dialogue: 0,0:17:58.01,0:18:09.98,Default,,0,0,0,,Күн сәулесі ағаштар арқылы өтетін үлкен терезенің ішінде
Dialogue: 0,0:18:00.58,0:18:02.22,Default,,0,0,0,,Ол шектен шыққан нәрсе жасады.
Dialogue: 0,0:18:03.20,0:18:06.54,Default,,0,0,0,,Қанша министрлік пен агенттіктен кешірім сұрауға тура келетінін елестете де алмаймын.
Dialogue: 0,0:18:07.04,0:18:10.31,Default,,0,0,0,,Себебі мен студентке барамын деп қорқыттым.
Dialogue: 0,0:18:09.98,0:18:20.58,Default,,0,0,0,,Мен сені кездестірген күнім алыстай сезінді
Dialogue: 0,0:18:10.45,0:18:13.61,Default,,0,0,0,,Бұл жоспар туралы білмегеніңізге жауапты емессіз.
Dialogue: 0,0:18:13.71,0:18:16.91,Default,,0,0,0,,Ал сіз оған салғаныңыздан да көп орасыз.
Dialogue: 0,0:18:17.13,0:18:20.37,Default,,0,0,0,,Манекендердің орнына нақты адамдармен деректер
Dialogue: 0,0:18:20.55,0:18:24.08,Default,,0,0,0,,Осының өзі тағы бір зымыран ұшуына тұрарлық.
Dialogue: 0,0:18:21.95,0:18:27.62,Default,,0,0,0,,Естеліктер біртіндеп реттелген
Dialogue: 0,0:18:24.22,0:18:28.61,Default,,0,0,0,,Сонымен қатар, Рицу ғарышқа тиімдірек жолды ашты.
Dialogue: 0,0:18:27.62,0:18:31.71,Default,,0,0,0,,Мені жылыт
Dialogue: 0,0:18:29.15,0:18:32.05,Default,,0,0,0,,Мен саған мұның бәрін беремін, сәлем айт.
Dialogue: 0,0:18:32.76,0:18:38.89,Default,,0,0,0,,Жүректерді біріктіретін шағын бөлме
Dialogue: 0,0:18:34.09,0:18:35.21,Default,,0,0,0,,Жаман адам
Dialogue: 0,0:18:38.89,0:18:44.48,Default,,0,0,0,,Ол маған ақырын айтты
Dialogue: 0,0:18:42.48,0:18:43.49,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:18:44.48,0:18:50.65,Default,,0,0,0,,Осы маусым келгенде
Dialogue: 0,0:18:50.65,0:18:57.32,Default,,0,0,0,,Мен сені қазірдің өзінде іздеп жүрмін
Dialogue: 0,0:18:57.32,0:19:02.66,Default,,0,0,0,,Сіз мұны істей алмайсыз.
Dialogue: 0,0:19:02.66,0:19:08.21,Default,,0,0,0,,Мен оны ешқашан ұмытпаймын
Dialogue: 0,0:19:08.21,0:19:14.25,Default,,0,0,0,,Мен сені қайтадан көретін күнге дейін...
Dialogue: 0,0:19:28.38,0:19:30.05,Default,,0,0,0,,Бұл қандай деректер?
Dialogue: 0,0:19:30.29,0:19:33.99,Default,,0,0,0,,Мен оны ұрлауға қарсы емеспін, бірақ ол техникалық терминдерге толы және мен оны мүлдем түсінбеймін.
Dialogue: 0,0:19:34.02,0:19:35.22,Default,,0,0,0,,Оны маған қалдырыңыз
Dialogue: 0,0:19:35.47,0:19:37.17,Default,,0,0,0,,Қорытынды:
Dialogue: 0,0:19:37.63,0:19:39.44,Default,,0,0,0,,Ғарыштағы экспериментте
Dialogue: 0,0:19:39.71,0:19:44.73,Default,,0,0,0,,Шатырлы тіршілік иелерінің жарылыс қаупі олардың мөлшеріне кері пропорционалды екені анықталды.
Dialogue: 0,0:19:45.38,0:19:49.96,Default,,0,0,0,,Ол неғұрлым үлкен болса, соғұрлым тұрақты болады, ал кішірек болса, оның жарылу ықтималдығы соғұрлым жоғары болады.
Dialogue: 0,0:19:50.55,0:19:52.48,Default,,0,0,0,,Кішкентай тышқанға ұқсамайды
Dialogue: 0,0:19:52.64,0:19:59.46,Default,,0,0,0,,Адам бойындағы «жігіт» есі шығып кетеді. Оның жарылу ықтималдығы ойлағаннан әлдеқайда төмен.
Dialogue: 0,0:20:00.44,0:20:01.59,Default,,0,0,0,,Бұл дегеніміз…
Dialogue: 0,0:20:01.90,0:20:04.98,Default,,0,0,0,,Сонымен қатар, келесі препараттар енгізілді.
Dialogue: 0,0:20:05.19,0:20:09.06,Default,,0,0,0,,Бүкіл денеге кремний қосылыстарының ағынын жүйелі түрде қамтамасыз етеді
Dialogue: 0,0:20:09.41,0:20:12.49,Default,,0,0,0,,Қарапайым тілмен айтқанда, қаттылығыңызды жеңілдету арқылы
Dialogue: 0,0:20:12.74,0:20:16.11,Default,,0,0,0,,Қашып кету қаупі одан әрі күрт төмендегені анықталды.
Dialogue: 0,0:20:16.37,0:20:17.32,Default,,0,0,0,,Қаттылық
Dialogue: 0,0:20:17.78,0:20:19.62,Default,,0,0,0,,Келесі шарттар орындалғанда:
Dialogue: 0,0:20:19.78,0:20:24.16,Default,,0,0,0,,Жарылыс ықтималдығы ең көбі 1%-дан аз.
Dialogue: 0,0:20:24.49,0:20:25.86,Default,,0,0,0,,1%
Dialogue: 0,0:20:26.97,0:20:31.71,Default,,0,0,0,,Басқа жасушалар жарылыс алдында өмірінің соңына жетуі ықтимал.
Dialogue: 0,0:20:31.93,0:20:35.09,Default,,0,0,0,,90 жыл ішінде ақырын буланады
Dialogue: 0,0:20:35.52,0:20:38.26,Default,,0,0,0,,Сіз бұл препаратты жасай аласыз ба?
Dialogue: 0,0:20:38.31,0:20:39.88,Default,,0,0,0,,Бұл өте оңай
Dialogue: 0,0:20:40.06,0:20:41.47,Default,,0,0,0,,Дәлірек айтқанда, И
Dialogue: 0,0:20:41.57,0:20:45.14,Default,,0,0,0,,Мен бұған дейін дерлік ұқсас препарат жасадым.
Dialogue: 0,0:20:45.19,0:20:46.12,Default,,0,0,0,,Бұл солай ма?
Dialogue: 0,0:20:47.36,0:20:48.31,Default,,0,0,0,,"Жоқ" жағын бөгеп, жоятын есілік балалары
Dialogue: 0,0:20:48.74,0:20:51.85,Default,,0,0,0,,Сонымен, шешімнің түйіні болды ма?
Dialogue: 0,0:20:51.99,0:20:55.25,Default,,0,0,0,,Оны оңай табу дұрыс па?
Dialogue: 0,0:20:55.41,0:20:56.35,Default,,0,0,0,,Жоқ
Dialogue: 0,0:20:56.94,0:20:59.40,Default,,0,0,0,,Менің ойымша, бұл оңай болған жоқ.
Dialogue: 0,0:20:59.54,0:21:00.34,Default,,0,0,0,,Чино
Dialogue: 0,0:21:01.12,0:21:05.99,Default,,0,0,0,,Они-чан өз өмірін қатерге тігіп, Коросейдің жойқын жаратылысқа айналуына жол бермеді.
Dialogue: 0,0:21:06.74,0:21:09.17,Default,,0,0,0,,Короссей өзінің әпкесінен алады.
Dialogue: 0,0:21:09.42,0:21:12.38,Default,,0,0,0,,Өйткені ол өз өмірін қатерге тігіп, бізге сабақ берді.
Dialogue: 0,0:21:13.58,0:21:15.60,Default,,0,0,0,,Әркім өз өміріне қауіп төндірмесе
Dialogue: 0,0:21:16.03,0:21:18.46,Default,,0,0,0,,Медицина тіпті жасалмаған да шығар.
Dialogue: 0,0:21:18.89,0:21:22.85,Default,,0,0,0,,Мен жауап іздеп ғарышқа баратын сыныпта өскен жоқпын.
Dialogue: 0,0:21:24.35,0:21:27.89,Default,,0,0,0,,Қандай жағдай болмасын, ол 1%-дан аз болса да жақсы.
Dialogue: 0,0:21:27.96,0:21:31.39,Default,,0,0,0,,Сіз оларды өлтіре алмасаңыз да, Жер жарылып кетпейді.
Dialogue: 0,0:21:34.71,0:21:35.88,Default,,0,0,0,,О, бұл
Dialogue: 0,0:21:36.12,0:21:37.81,Default,,0,0,0,,Сонда, бәрі, қастандық?
Dialogue: 0,0:21:39.33,0:21:41.61,Default,,0,0,0,,Бірінші семестрден бері жалғасып келе жатқан қастандықтар
Dialogue: 0,0:21:42.25,0:21:45.12,Default,,0,0,0,,Біз оны бір күн деп атай аламыз ба?
Dialogue: 0,0:21:46.12,0:21:48.37,Default,,0,0,0,,Менің ойымша, мұны аяқтаған дұрыс.
Dialogue: 0,0:21:49.04,0:21:49.99,Default,,0,0,0,,Бұл
Dialogue: 0,0:21:53.68,0:21:57.75,Default,,0,0,0,,Нағиса: Оны қалай аяқтадың?
Dialogue: 0,0:21:58.35,0:22:03.42,Default,,0,0,0,,Мүмкіндік қаншалықты төмен болса да, бұл қауіпті тіршілік иесі болса,
Dialogue: 0,0:22:03.61,0:22:06.22,Default,,0,0,0,,Үкімет қастандық жоспарын жоймайды.
Dialogue: 0,0:22:18.96,0:22:23.54,Default,,0,0,0,,Енді біз туннельден өттік, біз әркімнің сезімін бағалағымыз келеді.
Dialogue: 0,0:22:24.63,0:22:26.78,Default,,0,0,0,,Біздің қорытындымыз келесідей.
Dialogue: 0,0:22:27.41,0:22:29.88,Default,,0,0,0,,Наурыз айына дейін оны өлтіре алмасам
Dialogue: 0,0:22:30.25,0:22:34.67,Default,,0,0,0,,Біз қастандықты бітіріп, жай ғана студенттер мен оқытушылар боламыз.
Dialogue: 0,0:22:35.25,0:22:38.81,Default,,0,0,0,,Бірақ белгіленген мерзімге дейін мен өз күшімді сеніммен пайдаланамын.
Dialogue: 0,0:22:39.68,0:22:44.63,Default,,0,0,0,,Өйткені бұл сыныптағы қастандық - мұғаліммен байланыс.
Dialogue: 0,0:22:44.82,0:22:48.32,Default,,0,0,0,,Бұл бізді өсірген Коро-сенсей үшін міндетті пән.
Dialogue: 0,0:22:50.15,0:22:52.73,Default,,0,0,0,,Біз соған дайындалдық.
Dialogue: 0,0:22:56.28,0:22:59.61,Default,,0,0,0,,Жоғалған қысқы демалысыңызды бір сәтте қайтарып алыңыз.
Dialogue: 0,0:22:58.96,0:23:00.45,Default,,0,0,0,,Мен сізге жауап беретін шығармын.
Dialogue: 0,0:22:59.98,0:23:02.08,Default,,0,0,0,,Мен мұны сен айтқанда ғана түсіндім.
Dialogue: 0,0:23:01.19,0:23:03.56,Default,,0,0,0,,Оның ессіздігі қорқынышты
Dialogue: 0,0:23:02.94,0:23:05.88,Default,,0,0,0,,Сонда мен қандай сөздерді қолдануым керек және оны қандай бетке беруім керек?
Dialogue: 0,0:23:04.99,0:23:07.72,Default,,0,0,0,,Бұл жағынан ол Юкимура-сенсейге ұқсайды ма?
Dialogue: 0,0:23:06.57,0:23:08.98,Default,,0,0,0,,Бұл оның өзін-өзі бағалауы төмен болғандықтан.
Dialogue: 0,0:23:09.07,0:23:10.95,Default,,0,0,0,,Мен сізді ең үлкен күлімсіреп қуантамын
Dialogue: 0,0:23:12.45,0:23:17.45,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
