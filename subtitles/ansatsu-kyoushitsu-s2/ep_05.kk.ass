Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,Белгілі бір ақпарат алған біз
Dialogue: 0,0:00:07.02,0:00:08.59,Default,,0,0,0,,Бұл рас
Dialogue: 0,0:00:08.76,0:00:13.30,Default,,0,0,0,,Мен мектептен алыстағы осы кофеханаға қызыққанымнан жасырынып кірдім.
Dialogue: 0,0:00:14.01,0:00:15.76,Default,,0,0,0,,Хмм, ол әдемі.
Dialogue: 0,0:00:18.19,0:00:19.22,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:00:20.37,0:00:21.29,Default,,0,0,0,,Әрқашан рахмет
Dialogue: 0,0:00:21.54,0:00:23.16,Default,,0,0,0,,Харада мырза, Ито мырза
Dialogue: 0,0:00:23.22,0:00:25.02,Default,,0,0,0,,Юма-чан, қалайсың?
Dialogue: 0,0:00:25.11,0:00:28.94,Default,,0,0,0,,Мен осы дүкеннен кофеден гөрі Юма-чанды іздеп жүрмін.
Dialogue: 0,0:00:29.09,0:00:32.92,Default,,0,0,0,,Жоқ, жоқ, олай десең, дүкен меңгерушісі жынданып кетеді.
Dialogue: 0,0:00:33.20,0:00:36.58,Default,,0,0,0,,Харада мырзада мока, ал Ито мырзада дубль эспрессо болды.
Dialogue: 0,0:00:37.18,0:00:40.14,Default,,0,0,0,,Менде бүгін менеджер ұсынған шифон торты бар.
Dialogue: 0,0:00:40.29,0:00:42.41,Default,,0,0,0,,А, онда бұл екі нәрсе.
Dialogue: 0,0:00:42.55,0:00:43.75,Default,,0,0,0,,Рахмет
Dialogue: 0,0:00:44.29,0:00:47.21,Default,,0,0,0,,Көшбасшымыз шынымен де сымбатты.
Dialogue: 0,0:00:47.36,0:00:48.69,Default,,0,0,0,,Мені өлтір.
Dialogue: 0,0:00:49.04,0:00:51.78,Default,,0,0,0,,Балалар, сендер өте табандысыңдар. Бір кесе шай.
Dialogue: 0,0:00:52.10,0:00:53.26,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:00:53.36,0:00:55.89,Default,,0,0,0,,Мен толық емес жұмыс күнімен жұмыс істеймін, өйткені мен мұны үнсіз жасаймын.
Dialogue: 0,0:00:56.04,0:00:58.35,Default,,0,0,0,,Иә, иә, мен сені бопсалаймын.
Dialogue: 0,0:00:58.79,0:00:59.93,Default,,0,0,0,,Бір үзінді
Dialogue: 0,0:01:00.10,0:01:01.27,Default,,0,0,0,,Қосымша шай
Dialogue: 0,0:01:01.30,0:01:02.64,Default,,0,0,0,,Ол әдемі
Dialogue: 0,0:01:03.65,0:01:05.77,Default,,0,0,0,,Мен бірден мұншалықты көтере алатыныма сене алмаймын.
Dialogue: 0,0:01:06.00,0:01:06.98,Default,,0,0,0,,Ол әдемі
Dialogue: 0,0:01:07.24,0:01:10.69,Default,,0,0,0,,Ей, анаң тағы ауырып қалды.
Dialogue: 0,0:01:10.78,0:01:11.78,Default,,0,0,0,,Иә, жақсы
Dialogue: 0,0:01:12.18,0:01:13.78,Default,,0,0,0,,Мен толық емес отбасымын.
Dialogue: 0,0:01:13.89,0:01:16.41,Default,,0,0,0,,Сондай-ақ үй бюджетіне біраз ақша қосу керек.
Dialogue: 0,0:01:16.53,0:01:17.81,Default,,0,0,0,,Ол әдемі
Dialogue: 0,0:01:18.03,0:01:21.07,Default,,0,0,0,,Оның жалғыз кемшілігі – кедей.
Dialogue: 0,0:01:21.15,0:01:23.33,Default,,0,0,0,,Тіпті бұл әдемі жігітке айналады.
Dialogue: 0,0:01:23.69,0:01:27.71,Default,,0,0,0,,Күнделікті киімге келетін болсақ, арзан болып көрінбеңіз және жеңілдік дүкендеріндегі киімдерді киіңіз.
Dialogue: 0,0:01:27.88,0:01:28.92,Default,,0,0,0,,Ол әдемі
Dialogue: 0,0:01:29.31,0:01:32.67,Default,,0,0,0,,Бір күні ол маған фестивальде ұстаған алтын балығын берді.
Dialogue: 0,0:01:32.74,0:01:35.27,Default,,0,0,0,,Оның алтын балықты дайындауы өте жақсы.
Dialogue: 0,0:01:35.34,0:01:36.43,Default,,0,0,0,,Ол әдемі
Dialogue: 0,0:01:36.51,0:01:39.03,Default,,0,0,0,,Ол дәретхананы пайдаланғаннан кейін.
Dialogue: 0,0:01:39.63,0:01:41.68,Default,,0,0,0,,Қағаз үшбұрыш етіп бүктелген.
Dialogue: 0,0:01:41.79,0:01:42.93,Default,,0,0,0,,Ол әдемі
Dialogue: 0,0:01:43.57,0:01:46.69,Default,,0,0,0,,Әй, қағаз болса, мен де үшбұрыш етіп бүктеймін.
Dialogue: 0,0:01:46.81,0:01:48.06,Default,,0,0,0,,Ал мен үшін ол аса маңызды емес.
Dialogue: 0,0:01:48.38,0:01:51.15,Default,,0,0,0,,Мына табиғи ханым өлтірушіге қараңыз.
Dialogue: 0,0:01:51.15,0:01:52.38,Default,,0,0,0,,Ол әдемі
Dialogue: 0,0:01:53.21,0:01:55.82,Default,,0,0,0,,Мені көрші әйел де жиі ойыншық ретінде пайдаланады.
Dialogue: 0,0:01:55.82,0:01:57.05,Default,,0,0,0,,Шан мен Сей
Dialogue: 0,0:01:57.28,0:02:00.29,Default,,0,0,0,,Мен бас мектеп ғимаратындағы қыздардан әлі күнге дейін махаббат хаттарын аламын.
Dialogue: 0,0:02:00.43,0:02:01.62,Default,,0,0,0,,Ол әдемі
Dialogue: 0,0:02:02.37,0:02:04.29,Default,,0,0,0,,Мен де оны әлі алған жоқпын.
Dialogue: 0,0:02:03.27,0:02:04.29,Default,,0,0,0,,Әпке
Dialogue: 0,0:02:04.37,0:02:05.78,Default,,0,0,0,,Бұл жақсы махаббат емес
Dialogue: 0,0:02:05.87,0:02:08.70,Default,,0,0,0,,Әдемі жігіттерге ғана жақсы көрінетін нәрселер бар.
Dialogue: 0,0:02:08.94,0:02:11.53,Default,,0,0,0,,​​Тек Исағай мен ұстазға арналған.
Dialogue: 0,0:02:11.75,0:02:12.77,Default,,0,0,0,,Әдемі…
Dialogue: 0,0:02:13.46,0:02:14.76,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:02:15.09,0:02:17.72,Default,,0,0,0,,Мұнда бал тосттары керемет.
Dialogue: 0,0:02:18.08,0:02:21.94,Default,,0,0,0,,Осы себепті Исағайдың толық емес жұмыс күнін елемеймін.
Dialogue: 0,0:02:23.47,0:02:26.18,Default,,0,0,0,,Бірақ бәрі, ол қаншалықты әдемі болса да,
Dialogue: 0,0:02:26.23,0:02:28.30,Default,,0,0,0,,Сіз соншалықты ашулы емессіз, солай ма?
Dialogue: 0,0:02:30.03,0:02:33.01,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:02:34.09,0:02:36.86,Default,,0,0,0,,Ол жай ғана жақсы жігіт.
Dialogue: 0,0:02:37.22,0:02:37.82,Default,,0,0,0,,Иә
Dialogue: 0,0:02:37.99,0:02:39.70,Default,,0,0,0,,Басқа себеп бар ма?
Dialogue: 0,0:02:40.88,0:02:41.91,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:02:43.03,0:02:45.50,Default,,0,0,0,,О, ой, ой
Dialogue: 0,0:02:45.57,0:02:48.25,Default,,0,0,0,,Ақпаратқа сәйкес, студент толық емес жұмыс күнімен жұмыс істейді.
Dialogue: 0,0:02:49.11,0:02:51.29,Default,,0,0,0,,Бара алмайсың, Исағай-күн.
Dialogue: 0,0:02:51.48,0:02:53.93,Default,,0,0,0,,Бұл мектеп ережелерінің екінші өрескел бұзылуы.
Dialogue: 0,0:02:54.41,0:02:57.09,Default,,0,0,0,,Сағындым, Исағай мырза.
Dialogue: 0,0:02:57.76,0:03:00.36,Default,,0,0,0,,Асано-кун ең нашар
Dialogue: 0,0:03:14.46,0:03:17.21,Default,,0,0,0,,Мен тек сені ойлап жүрмін
Dialogue: 0,0:03:17.21,0:03:19.97,Default,,0,0,0,,Мен басқа ештеңе көре алмаймын
Dialogue: 0,0:03:19.97,0:03:23.89,Default,,0,0,0,,Міндетті түрде сол жүректі жеңіңіз
Dialogue: 0,0:03:23.89,0:03:25.39,Default,,0,0,0,,Ант етемін
Dialogue: 0,0:03:25.39,0:03:28.06,Default,,0,0,0,,Бұл жұмыс істемейтін ескі әңгіме.
Dialogue: 0,0:03:28.06,0:03:30.85,Default,,0,0,0,,Мен көп күш салдым.
Dialogue: 0,0:03:30.85,0:03:34.65,Default,,0,0,0,,Сіз негізсіз деңгейді жоюыңыз керек еді.
Dialogue: 0,0:03:33.60,0:03:34.65,Default,,0,0,0,,Сценарий және Ниппон ... Rain AB Үш
Dialogue: 0,0:03:34.94,0:03:35.98,Default,,0,0,0,,Бұл не? Мен байланғанмын. Аударма ...Казуки Казуки Үш Үш
Dialogue: 0,0:03:36.27,0:03:37.32,Default,,0,0,0,,Сенім Мектеп және күндізгі мектеп ...Маки Кого Үш Үш
Dialogue: 0,0:03:37.61,0:03:38.65,Default,,0,0,0,,Толтыру Уақыт...Waji Yuki Бұрмалау Бұрмалау K.K кадр Үш Үш
Dialogue: 0,0:03:39.03,0:03:41.53,Default,,0,0,0,,Өзіңізді жақсы сезінген кезде
Dialogue: 0,0:03:39.24,0:03:40.28,Default,,0,0,0,,Күйшей...Юки Юки
Dialogue: 0,0:03:39.40,0:03:40.28,Default,,0,0,0,,Өзіңізді жақсы сезінген кезде
Dialogue: 0,0:03:41.53,0:03:46.66,Default,,0,0,0,,Мен әрқашан осылай итеріп отырамын
Dialogue: 0,0:03:46.41,0:03:52.33,Default,,0,0,0,,Қатты және байсалды даусыңыз иіскейді. Қатты да байсалды даусыңыз жанды.
Dialogue: 0,0:03:52.08,0:03:57.46,Default,,0,0,0,,Сезімімді мыңдаған рет, он мыңдаған рет қалыптастыр Сезімімді мың рет, он мың рет қалыптастыр
Dialogue: 0,0:03:57.17,0:04:03.13,Default,,0,0,0,,Мен оны ұрдым, мен оны лақтырамын, бірақ сіз жай ғана қашып кетесіз. Мен оны ұрдым, мен оны лақтырамын, бірақ сіз жай ғана қашып кетіңіз.
Dialogue: 0,0:04:03.13,0:04:06.05,Default,,0,0,0,,СҰРАҚ СҰРАҚ Мен
Dialogue: 0,0:04:06.05,0:04:08.68,Default,,0,0,0,,СҰРАҚ СҰРАҚ
Dialogue: 0,0:04:08.68,0:04:11.43,Default,,0,0,0,,СҰРАҚ СҰРАҚ Кимино
Dialogue: 0,0:04:11.48,0:04:14.10,Default,,0,0,0,,Сіз не білдіңіз?
Dialogue: 0,0:04:14.10,0:04:16.73,Default,,0,0,0,,СҰРАҚ СҰРАҚ Неліктен
Dialogue: 0,0:04:16.73,0:04:19.44,Default,,0,0,0,,СҰРАҚ СҰРАҚ Сіз
Dialogue: 0,0:04:19.44,0:04:22.24,Default,,0,0,0,,СҰРАҚ СҰРАҚ
Dialogue: 0,0:04:22.24,0:04:28.99,Default,,0,0,0,,Бұл жақын, бірақ алыс. Жақын, бірақ алыс.
Dialogue: 0,0:04:28.87,0:04:31.00,Default,,0,0,0,,Құдайдың субтитр жұбы
Dialogue: 0,0:04:35.00,0:04:40.00,Default,,0,0,0,,Бұл субтитр көзі сатып алуға, білім алмасуға қол жетімді және коммерциялық пайдалануға тыйым салынған илаһи субтитрлер жұбы.
Dialogue: 0,0:04:35.97,0:04:38.28,Default,,0,0,0,,Бұған дейін менің толық емес жұмыс күніммен жұмыс істегенім анықталды.
Dialogue: 0,0:04:38.42,0:04:40.74,Default,,0,0,0,,Сіз Е сыныбына түсіп қалдыңыз.
Dialogue: 0,0:04:41.47,0:04:44.54,Default,,0,0,0,,Бірақ содан бері ол бұл туралы ойланбаған сияқты.
Dialogue: 0,0:04:44.65,0:04:47.75,Default,,0,0,0,,Асано, бұл туралы үндемей отырыңыз.
Dialogue: 0,0:04:48.31,0:04:51.09,Default,,0,0,0,,Осы айдың соңына дейін қажетті ақшаны табуға болады.
Dialogue: 0,0:04:52.08,0:04:56.01,Default,,0,0,0,,Иә, мүмкін болса, мен де сізге мүмкіндік бергім келеді.
Dialogue: 0,0:04:57.55,0:05:00.55,Default,,0,0,0,,Асано жаман нәрселер туралы ойлағанда,
Dialogue: 0,0:05:01.24,0:05:03.25,Default,,0,0,0,,Ол шынымен де төрағаға ұқсайды.
Dialogue: 0,0:05:03.71,0:05:06.41,Default,,0,0,0,,Ал, мен саған бір шарт қояйын.
Dialogue: 0,0:05:07.44,0:05:11.73,Default,,0,0,0,,Егер сіз өзіңіздің жауынгерлік рухыңызды көрсете алсаңыз, мен бұл жолы не болғанын көрмеген сияқтымын.
Dialogue: 0,0:05:12.15,0:05:13.02,Default,,0,0,0,,Жауынгерлік рух?
Dialogue: 0,0:05:13.48,0:05:15.11,Default,,0,0,0,,Біздің мектеп рухы
Dialogue: 0,0:05:16.03,0:05:20.73,Default,,0,0,0,,Біз бәрінен бұрын қоғамға шығып, күресуге ерік-жігері бар адамдарды құрметтейміз.
Dialogue: 0,0:05:20.99,0:05:25.05,Default,,0,0,0,,Құқық бұзушылықтарды жою үшін жеткілікті құрметке ие күресуші рух
Dialogue: 0,0:05:25.23,0:05:26.58,Default,,0,0,0,,Соны көрсету үшін
Dialogue: 0,0:05:27.31,0:05:29.68,Default,,0,0,0,,Ботоши спорт фестивалінде
Dialogue: 0,0:05:30.00,0:05:33.52,Default,,0,0,0,,Дұрыс, егер біз А тобын жеңсек, көзіңізді жұмыңыз.
Dialogue: 0,0:05:37.13,0:05:40.55,Default,,0,0,0,,Олардың бізді ұятқа қалдырмақ болғаны анық.
Dialogue: 0,0:05:41.05,0:05:42.32,Default,,0,0,0,,Не істеуім керек?
Dialogue: 0,0:05:42.56,0:05:45.11,Default,,0,0,0,,Алмасаң, Исағай тағы да жазаланады.
Dialogue: 0,0:05:45.23,0:05:47.60,Default,,0,0,0,,Егер сіз нашар оқысаңыз, мектептен шығарылуы мүмкін.
Dialogue: 0,0:05:48.85,0:05:51.60,Default,,0,0,0,,Жоқ, бұлай істеудің қажеті жоқ, балалар.
Dialogue: 0,0:05:52.42,0:05:55.61,Default,,0,0,0,,Бұл Асано туралы болғандықтан, мен оған не болатынын білмедім.
Dialogue: 0,0:05:56.80,0:06:00.21,Default,,0,0,0,,Тұқым сепкен менмін, сондықтан жауапкершілікті өз мойныма аламын.
Dialogue: 0,0:06:00.49,0:06:01.82,Default,,0,0,0,,Мектептен шығару
Dialogue: 0,0:06:02.16,0:06:05.07,Default,,0,0,0,,Мектеп ғимаратының сыртынан қастандық жасауға болады.
Dialogue: 0,0:06:05.46,0:06:07.13,Default,,0,0,0,,Жақсы... жақсы...
Dialogue: 0,0:06:07.93,0:06:10.05,Default,,0,0,0,,Мүлдем емес.
Dialogue: 0,0:06:10.77,0:06:13.11,Default,,0,0,0,,Неге өз-өзіңе мас болдың, ақымақ?
Dialogue: 0,0:06:13.11,0:06:14.23,Default,,0,0,0,,Ахоге кедейлігі
Dialogue: 0,0:06:14.73,0:06:16.84,Default,,0,0,0,,Қатты ойлама, Исағай.
Dialogue: 0,0:06:17.65,0:06:20.72,Default,,0,0,0,,Менің ойымша, А сыныбының арық оқушыларын дөңгелек таяқпен ұрған дұрыс.
Dialogue: 0,0:06:21.65,0:06:22.84,Default,,0,0,0,,Бұл оңай жеңіс емес пе?
Dialogue: 0,0:06:22.90,0:06:24.01,Default,,0,0,0,,Ура!
Dialogue: 0,0:06:24.39,0:06:27.04,Default,,0,0,0,,Олар менің толық емес жұмыс күнім туралы білгені үшін мен бақытты болдым.
Dialogue: 0,0:06:27.08,0:06:30.98,Default,,0,0,0,,Бұл сіздің күнделікті кекіңізді өтеу мүмкіндігіңіз емес пе?
Dialogue: 0,0:06:31.12,0:06:33.81,Default,,0,0,0,,​​Оны жеңудің орнына оны сындырайық.
Dialogue: 0,0:06:33.86,0:06:34.98,Default,,0,0,0,,Әй, әдемі жігіт
Dialogue: 0,0:06:35.41,0:06:36.45,Default,,0,0,0,,Балалар
Dialogue: 0,0:06:37.72,0:06:39.01,Default,,0,0,0,,Жарайды, жасайық.
Dialogue: 0,0:06:40.61,0:06:42.53,Default,,0,0,0,,Бұл қалыпты мінез-құлық.
Dialogue: 0,0:06:43.11,0:06:46.37,Default,,0,0,0,,Өзіңізден гөрі сыныптағы үйлесімділікке басымдық беріңіз
Dialogue: 0,0:06:46.90,0:06:49.58,Default,,0,0,0,,Адамзат қайта-қайта күш салу арқылы алынады.
Dialogue: 0,0:06:49.82,0:06:52.16,Default,,0,0,0,,Бұл басшы үшін ең маңызды қасиет.
Dialogue: 0,0:06:52.71,0:06:56.55,Default,,0,0,0,,Сіз екі жақсы жігітсіз бе? Мен де киімімді шешемін.
Dialogue: 0,0:06:58.40,0:06:59.63,Default,,0,0,0,,Ботошика?
Dialogue: 0,0:07:00.11,0:07:02.30,Default,,0,0,0,,Мен мұны Ұлттық қорғаныс академиясында талай рет жасадым.
Dialogue: 0,0:07:02.93,0:07:05.39,Default,,0,0,0,,Бұл қастандық емес, соғыс болды.
Dialogue: 0,0:07:05.81,0:07:08.56,Default,,0,0,0,,Адамдар санындағы айырмашылық өте үлкен кемістік болып табылады.
Dialogue: 0,0:07:09.39,0:07:11.23,Default,,0,0,0,,Мен оқытылған болсам да
Dialogue: 0,0:07:11.48,0:07:14.34,Default,,0,0,0,,Екі есе дерлік көп адамға қарсы жеңу мүмкін бе?
Dialogue: 0,0:07:28.00,0:07:29.62,Default,,0,0,0,,Салқын Кимура-кун
Dialogue: 0,0:07:29.95,0:07:31.16,Default,,0,0,0,,Көбірек күліп жүгіріңіз
Dialogue: 0,0:07:31.32,0:07:32.75,Default,,0,0,0,,Сонымен әділеттілік
Dialogue: 0,0:07:39.14,0:07:41.32,Default,,0,0,0,,Іш, нан
Dialogue: 0,0:07:41.67,0:07:43.09,Default,,0,0,0,,Какки
Dialogue: 0,0:07:44.45,0:07:49.54,Default,,0,0,0,,Негізгі физикалық күш, тепе-теңдік, динамикалық көру өткірлігі және қашықтығы сезімі өлтіру арқылы дамыды
Dialogue: 0,0:07:49.78,0:07:52.44,Default,,0,0,0,,Төтенше жарыстарда көрсеткен
Dialogue: 0,0:07:50.36,0:07:51.37,Default,,0,0,0,,Сексуалдық қудалау
Dialogue: 0,0:07:52.55,0:07:55.08,Default,,0,0,0,,Бұл кішкентай жігіт желіден өте жылдам өтеді
Dialogue: 0,0:07:55.26,0:07:57.44,Default,,0,0,0,,Өйткені денеде қарсылық жоқ.
Dialogue: 0,0:07:57.80,0:08:00.40,Default,,0,0,0,,Дәл сол сияқты әр адамның жеке даралығы да қару бола алады.
Dialogue: 0,0:08:00.72,0:08:02.69,Default,,0,0,0,,Ботошиді қалай пайдалануға болады
Dialogue: 0,0:08:03.12,0:08:05.77,Default,,0,0,0,,Өзіңе байланысты, Исағай-күн.
Dialogue: 0,0:08:07.05,0:08:08.10,Default,,0,0,0,,Не болды?
Dialogue: 0,0:08:09.01,0:08:13.12,Default,,0,0,0,,Коро-сенсэй Не айтсаң да, Асано керемет жігіт.
Dialogue: 0,0:08:13.94,0:08:15.89,Default,,0,0,0,,Мен әлдеқайда артта қалдым.
Dialogue: 0,0:08:19.61,0:08:23.21,Default,,0,0,0,,Қаншалықты жан-жақты болсаң да,
Dialogue: 0,0:08:23.26,0:08:26.01,Default,,0,0,0,,Қоғамға шықсаң, сенің үстіңде адамдар бар.
Dialogue: 0,0:08:26.51,0:08:27.84,Default,,0,0,0,,Ол сияқты.
Dialogue: 0,0:08:28.26,0:08:29.14,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:08:29.60,0:08:32.18,Default,,0,0,0,,Мен үшін бәрі зардап шексе
Dialogue: 0,0:08:32.73,0:08:37.72,Default,,0,0,0,,Бірақ, қоғамда бір адамның билігінің шегі бар.
Dialogue: 0,0:08:40.08,0:08:42.73,Default,,0,0,0,,Достарыңызды шайқаста басқаратын күш
Dialogue: 0,0:08:43.41,0:08:46.31,Default,,0,0,0,,Бұл жағынан сіз тіпті Асанодан да асып түсе аласыз.
Dialogue: 0,0:08:46.80,0:08:51.73,Default,,0,0,0,,Егер сіз шым-шытырық болсаңыз, бәрі оны бөлісіп, сізге күресуге көмектеседі.
Dialogue: 0,0:08:51.89,0:08:53.76,Default,,0,0,0,,Бұл сенің қасиетің.
Dialogue: 0,0:08:54.59,0:08:59.94,Default,,0,0,0,,Тіпті сіздің мұғаліміңіз болса да, мен Асано-куннан гөрі сіздің сынып мұғалімі болғаныма қуаныштымын.
Dialogue: 0,0:09:02.99,0:09:04.71,Default,,0,0,0,,Жарайсыңдар.
Dialogue: 0,0:09:04.77,0:09:06.97,Default,,0,0,0,,Әдеттегідей мен ынтамен барамын.
Dialogue: 0,0:09:08.99,0:09:10.93,Default,,0,0,0,,Келесі көрме
Dialogue: 0,0:09:10.98,0:09:15.06,Default,,0,0,0,,E тобы А тобына челлендж шығарды!
Dialogue: 0,0:09:15.15,0:09:18.13,Default,,0,0,0,,Біздің мектептің таңдаулылары, берілмеңіздер
Dialogue: 0,0:09:19.19,0:09:20.17,Default,,0,0,0,,Шетелдік
Dialogue: 0,0:09:20.27,0:09:22.17,Default,,0,0,0,,Бұл ережелерге қайшы.
Dialogue: 0,0:09:22.20,0:09:25.86,Default,,0,0,0,,Бұл көрме мәдени алмасу мақсатында жасалған.
Dialogue: 0,0:09:25.95,0:09:28.36,Default,,0,0,0,,Барлық халықаралық студенттер қатысады.
Dialogue: 0,0:09:28.45,0:09:31.03,Default,,0,0,0,,Асаноның жігіті, сен тым көп ойландың.
Dialogue: 0,0:09:31.26,0:09:33.03,Default,,0,0,0,,Сіз соншалықты алысқа барып, жеңгіңіз келе ме?
Dialogue: 0,0:09:35.72,0:09:37.33,Default,,0,0,0,,​​Бұл көруге болатын нәрсе.
Dialogue: 0,0:09:37.46,0:09:40.29,Default,,0,0,0,,Енді E тобы не істеу керек?
Dialogue: 0,0:09:42.92,0:09:48.13,Default,,0,0,0,,Егер Е класы ойыншылардың аз санымен жеңіске жетуді қаласа, олардың қорғаныс пен шабуылды лақтырып тастаудан басқа амалы жоқ.
Dialogue: 0,0:09:48.85,0:09:52.60,Default,,0,0,0,,Осы алынбайтын құраммен шабуыл аймағын жұтып қойыңыз.
Dialogue: 0,0:09:52.91,0:09:54.35,Default,,0,0,0,,Оны ұсақтаңыз
Dialogue: 0,0:09:56.11,0:09:57.81,Default,,0,0,0,,Сіз жеңуге дайынсыз ба? Е тобы
Dialogue: 0,0:09:58.49,0:10:00.56,Default,,0,0,0,,Шабуыл жасайтын ешкім жоқ.
Dialogue: 0,0:10:00.93,0:10:03.02,Default,,0,0,0,,Бұл не? Е тобы
Dialogue: 0,0:10:03.05,0:10:04.86,Default,,0,0,0,,Барлық мүшелердің қатаң қорғанысы
Dialogue: 0,0:10:04.94,0:10:06.98,Default,,0,0,0,,Күш айырмашылығынан қорықтыңыз ба?
Dialogue: 0,0:10:07.87,0:10:10.36,Default,,0,0,0,,Енді соғыс басталсын
Dialogue: 0,0:10:10.97,0:10:12.42,Default,,0,0,0,,Асаноға шабуыл жасаңыз
Dialogue: 0,0:10:12.91,0:10:16.04,Default,,0,0,0,,Сіз мені азғыруға тырысасыз ба? Бұл тәтті.
Dialogue: 0,0:10:16.66,0:10:18.41,Default,,0,0,0,,Шабуыл тобының ЖОСПАРЫ F
Dialogue: 0,0:10:18.64,0:10:19.15,Default,,0,0,0,,Роджер
Dialogue: 0,0:10:21.64,0:10:24.59,Default,,0,0,0,,Біздің мақсатымыз таяқты құлату емес.
Dialogue: 0,0:10:25.25,0:10:28.71,Default,,0,0,0,,Барлығыңыздың жойылғаныңызға көз жеткізу үшін.
Dialogue: 0,0:10:29.50,0:10:30.15,Default,,0,0,0,,келді
Dialogue: 0,0:10:33.47,0:10:34.22,Default,,0,0,0,,Бұл туралы сен бәрінен жақсы білуің керек
Dialogue: 0,0:10:34.44,0:10:36.18,Default,,0,0,0,,Қарсылықсыз жасай аласыз ба?
Dialogue: 0,0:10:42.63,0:10:46.27,Default,,0,0,0,,Алдымен екі адам аудитория орындарына көтерілді.
Dialogue: 0,0:10:47.65,0:10:49.44,Default,,0,0,0,,Жоқ... бұл қауіпті, Коро-сенсэй
Dialogue: 0,0:10:49.54,0:10:53.13,Default,,0,0,0,,Қанша күшті болсақ та, бірінен соң бірі желге ұшса, мағынасыз болады.
Dialogue: 0,0:10:54.37,0:10:55.91,Default,,0,0,0,,Оның орнына неге соғыспайсың?
Dialogue: 0,0:10:56.05,0:10:57.62,Default,,0,0,0,,тасбақалар шоғыры сияқты қорғану?
Dialogue: 0,0:10:58.63,0:11:00.47,Default,,0,0,0,,Бірақ сен мені түсінбейсің ғой
Dialogue: 0,0:11:00.58,0:11:02.00,Default,,0,0,0,,Бәрі жақсы, жігітім
Dialogue: 0,0:11:02.39,0:11:05.13,Default,,0,0,0,,Неге сөйлесудің орнына шабуыл жасамайсыз?
Dialogue: 0,0:11:06.14,0:11:07.52,Default,,0,0,0,,Оны қосыңыз
Dialogue: 0,0:11:09.80,0:11:10.38,Default,,0,0,0,,Енді барлығы
Dialogue: 0,0:11:10.66,0:11:12.00,Default,,0,0,0,,Операция Tentacle
Dialogue: 0,0:11:17.50,0:11:18.59,Default,,0,0,0,,басып тұрыңыз
Dialogue: 0,0:11:19.96,0:11:23.89,Default,,0,0,0,,E тобы Таяқтың салмағы оны қатты етті.
Dialogue: 0,0:11:23.89,0:11:26.44,Default,,0,0,0,,Бұл қиын!
Dialogue: 0,0:11:26.67,0:11:30.03,Default,,0,0,0,,Таяқты қару ретінде қолдануға қарсы ереже жоқ.
Dialogue: 0,0:11:30.03,0:11:32.07,Default,,0,0,0,,Менен кет
Dialogue: 0,0:11:32.10,0:11:32.90,Default,,0,0,0,,Менің қашып кетуіме жол берме
Dialogue: 0,0:11:33.23,0:11:34.74,Default,,0,0,0,,Бұл шебер қорғаныс.
Dialogue: 0,0:11:35.30,0:11:39.76,Default,,0,0,0,,Бірақ жеті адам қорғаныспен айналысып, екеуі ес-түссіз жатқан.
Dialogue: 0,0:11:40.08,0:11:42.33,Default,,0,0,0,,Бұл бізге жақсырақ артықшылық берді.
Dialogue: 0,0:11:43.33,0:11:46.13,Default,,0,0,0,,Қос қанатты партизан күштерінің қолбасшылығы К.
Dialogue: 0,0:11:49.09,0:11:50.58,Default,,0,0,0,,Ортасында саңылау бар
Dialogue: 0,0:11:50.85,0:11:53.90,Default,,0,0,0,,Егер біз шабуыл жасағымыз келсе, қазір шабуыл жасаудың жалғыз уақыты, өйткені жау әскерлері тарап кетті.
Dialogue: 0,0:11:54.54,0:11:55.43,Default,,0,0,0,,Жарайды, мен кетемін.
Dialogue: 0,0:11:55.66,0:11:58.06,Default,,0,0,0,,Attack Force операциясы шырыш
Dialogue: 0,0:12:01.23,0:12:02.64,Default,,0,0,0,,Менің жаным… Ұйықтар алдында әр түн сайын➡
Dialogue: 0,0:12:03.83,0:12:06.94,Default,,0,0,0,,А, Е тобына еріп, қорғанысқа оралыңыз.
Dialogue: 0,0:12:07.83,0:12:09.30,Default,,0,0,0,,Шабуыл жалған ба?
Dialogue: 0,0:12:11.36,0:12:12.69,Default,,0,0,0,,Бұл шахмат ойнау сияқты
Dialogue: 0,0:12:13.35,0:12:15.95,Default,,0,0,0,,Қорғаныс оны өте жақсы ұстағанымен
Dialogue: 0,0:12:16.83,0:12:19.31,Default,,0,0,0,,Соғыс жағдайы барған сайын қолайсыз болып барады.
Dialogue: 0,0:12:28.58,0:12:29.83,Default,,0,0,0,,Бұл туралы не істеуіміз керек?
Dialogue: 0,0:12:30.48,0:12:33.86,Default,,0,0,0,,Қорғаныс министрлігі олардың жарақаттанбауын қалайды.
Dialogue: 0,0:12:35.93,0:12:37.37,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:12:37.52,0:12:40.12,Default,,0,0,0,,​​Мен әлеуметтік зерттеулерді оқып жүргенде кеңес бердім.
Dialogue: 0,0:12:41.37,0:12:43.92,Default,,0,0,0,,Екі есе көп жауды жеңудің жақсы мысалы
Dialogue: 0,0:12:43.96,0:12:47.24,Default,,0,0,0,,Мұғалімге Карфагендік Ганнибал ұнайды.
Dialogue: 0,0:12:47.46,0:12:50.18,Default,,0,0,0,,О, бұл ежелгі Римді азаптады ма?
Dialogue: 0,0:12:50.92,0:12:52.63,Default,,0,0,0,,Жолсыз жолмен жүру
Dialogue: 0,0:12:52.84,0:12:56.35,Default,,0,0,0,,Жау сергек емес жерде кенеттен ұрыс алаңы пайда болады.
Dialogue: 0,0:12:56.70,0:13:00.18,Default,,0,0,0,,Қорғаныс жасау және құпия қаруды енгізу
Dialogue: 0,0:13:00.74,0:13:03.44,Default,,0,0,0,,Барлық стратегияларыңызға дәстүрлі емес идеяларды енгізіңіз
Dialogue: 0,0:13:04.05,0:13:07.77,Default,,0,0,0,,Олар сіз ойлаған барлық айла-амалдарды орындай алады.
Dialogue: 0,0:13:13.26,0:13:16.70,Default,,0,0,0,,Е сыныбының жігіттері қоршалған, қоршалған.
Dialogue: 0,0:13:16.70,0:13:18.82,Default,,0,0,0,,Қазір линч жасау уақыты.
Dialogue: 0,0:13:21.42,0:13:23.31,Default,,0,0,0,,Неге барлығы осында?
Dialogue: 0,0:13:27.37,0:13:30.46,Default,,0,0,0,,Әйтеуір, олар E сыныпты аудиторияға қарай қаша бастады.
Dialogue: 0,0:13:30.52,0:13:32.23,Default,,0,0,0,,Өткізу орнында үлкен дүрбелең болды.
Dialogue: 0,0:13:32.71,0:13:35.18,Default,,0,0,0,,Шекаралар туралы ережелер жоқ
Dialogue: 0,0:13:35.30,0:13:36.18,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:13:36.30,0:13:38.76,Default,,0,0,0,,Бүкіл мектеп ұрыс алаңы
Dialogue: 0,0:13:38.95,0:13:41.56,Default,,0,0,0,,Сіз не істеп жатырсыз? Жылдам қозғалысты тоқтатыңыз.
Dialogue: 0,0:13:42.81,0:13:45.06,Default,,0,0,0,,Бодошидегі ең қауіпті нәрсе
Dialogue: 0,0:13:45.42,0:13:49.27,Default,,0,0,0,,Адам саны аз болса да, алдыңғы шепке құмар болыңыз.
Dialogue: 0,0:13:50.11,0:13:51.32,Default,,0,0,0,,Оны орындауға болады
Dialogue: 0,0:13:52.01,0:13:56.41,Default,,0,0,0,,Әсіресе Акабане, Кимура және Исогайдан сақ болыңыз.
Dialogue: 0,0:13:57.24,0:13:58.66,Default,,0,0,0,,Юма Исагай
Dialogue: 0,0:13:59.14,0:14:01.06,Default,,0,0,0,,Егер E тобы жеңілуді жалғастырса,
Dialogue: 0,0:14:01.39,0:14:04.87,Default,,0,0,0,,Сізді мектеп ережесін бұзды деп айыптап, көшеде қалдыңыз.
Dialogue: 0,0:14:05.29,0:14:08.67,Default,,0,0,0,,Егер бұл сізге ұнамаса, барлығына шабуыл жасауға нұсқау беруден басқа амалыңыз жоқ.
Dialogue: 0,0:14:09.36,0:14:11.46,Default,,0,0,0,,Мен өзім құрдымға кетем бе?
Dialogue: 0,0:14:11.52,0:14:13.80,Default,,0,0,0,,Бүкіл сыныпты өзіммен бірге алып жүруім керек пе?
Dialogue: 0,0:14:13.99,0:14:17.33,Default,,0,0,0,,Таңдау - сіз, Е тобының көшбасшысы.
Dialogue: 0,0:14:17.78,0:14:20.68,Default,,0,0,0,,Исағай: Уақыт келді.
Dialogue: 0,0:14:21.08,0:14:23.85,Default,,0,0,0,,Әй, әзірге бәрі жоспар бойынша жүріп жатыр.
Dialogue: 0,0:14:30.93,0:14:33.32,Default,,0,0,0,,Мен мұны білмей тұрып, Е класының екі мүшесі...
Dialogue: 0,0:14:33.49,0:14:34.94,Default,,0,0,0,,Ол қайдан келді?
Dialogue: 0,0:14:35.43,0:14:37.74,Default,,0,0,0,,Мен көп нәрсені үйрендім, сондықтан мен пассивті болуды жек көремін.
Dialogue: 0,0:14:37.89,0:14:40.81,Default,,0,0,0,,Қиын болған жалғыз нәрсе - аудитория орындарына ұшу әрекеті.
Dialogue: 0,0:14:41.05,0:14:44.23,Default,,0,0,0,,Бастапқы кезеңде желге ұшып кеткендер осылар ма?
Dialogue: 0,0:14:44.33,0:14:45.70,Default,,0,0,0,,Қашу аяқталды.
Dialogue: 0,0:14:45.95,0:14:47.71,Default,,0,0,0,,Everyone Дыбыс жылдамдығы
Dialogue: 0,0:14:47.99,0:14:49.14,Default,,0,0,0,,Өмірдің өткелін белгілейтін ессіз сағат
Dialogue: 0,0:14:50.73,0:14:51.75,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:14:52.30,0:14:54.89,Default,,0,0,0,,Барлығының назары төбелеске ауғандай,
Dialogue: 0,0:14:55.09,0:14:58.09,Default,,0,0,0,,Екі адам жараланғандай кейіп танытып, жасақтан бөлініп шықты.
Dialogue: 0,0:14:58.16,0:14:59.80,Default,,0,0,0,,Сырттан жасырын түрде ішке кірді
Dialogue: 0,0:15:00.18,0:15:03.83,Default,,0,0,0,,Дүрбелеңді пайдаланып, ол А класының негізгі лагеріне кіреді.
Dialogue: 0,0:15:04.41,0:15:05.80,Default,,0,0,0,,Бұл мақсат па?
Dialogue: 0,0:15:06.02,0:15:07.27,Default,,0,0,0,,Бұл мақсат.
Dialogue: 0,0:15:08.58,0:15:10.69,Default,,0,0,0,,Кеудеде
Dialogue: 0,0:15:11.02,0:15:12.40,Default,,0,0,0,,Не болды, Асано?
Dialogue: 0,0:15:12.72,0:15:14.57,Default,,0,0,0,,Қанша адам болса да,
Dialogue: 0,0:15:14.94,0:15:16.23,Default,,0,0,0,,Егер сіз осында көтерілсеңіз
Dialogue: 0,0:15:23.82,0:15:25.78,Default,,0,0,0,,Сіз жекпе-жек өнерін білесіз бе?
Dialogue: 0,0:15:27.08,0:15:30.75,Default,,0,0,0,,Балалар, менімен бір сахнада тұрсыңдар
Dialogue: 0,0:15:32.42,0:15:35.74,Default,,0,0,0,,Менің ойымша, сізді қууға дайынсыз.
Dialogue: 0,0:15:36.90,0:15:38.28,Default,,0,0,0,,Бұл соңғы бастық сезімі
Dialogue: 0,0:15:38.72,0:15:40.55,Default,,0,0,0,,Өйткені, ол директордың ұлы.
Dialogue: 0,0:15:42.68,0:15:44.70,Default,,0,0,0,,Бұл қорқынышты, ол бітеліп барады
Dialogue: 0,0:15:44.73,0:15:47.55,Default,,0,0,0,,Осылай жүре берсек, бізді қоршап алып, линчке алады.
Dialogue: 0,0:15:48.52,0:15:52.56,Default,,0,0,0,,Асано-кун, соғыстың нәтижесін жалғыз өзі шешетін күшті басшы.
Dialogue: 0,0:15:52.97,0:15:56.11,Default,,0,0,0,,Ол қолбасшылықта болғанша, А класы жеңілмейді.
Dialogue: 0,0:15:58.11,0:16:00.91,Default,,0,0,0,,Исағай ешқашан мұндай басшы болмайды.
Dialogue: 0,0:16:01.55,0:16:02.47,Default,,0,0,0,,Ойласам, ол бәріне белгілі нәрсе ғой.
Dialogue: 0,0:16:03.18,0:16:05.99,Default,,0,0,0,,Жалғыз шешім қабылдаудың қажеті жоқ.
Dialogue: 0,0:16:07.10,0:16:08.62,Default,,0,0,0,,Уау не?
Dialogue: 0,0:16:09.49,0:16:12.00,Default,,0,0,0,,Е тобы үшін одан да көп күшейту.
Dialogue: 0,0:16:12.00,0:16:14.77,Default,,0,0,0,,Біраз күте тұрыңыз, бұл жігіттер қорғаныс бөлімі.
Dialogue: 0,0:16:14.83,0:16:15.71,Default,,0,0,0,,онда Әйел Титанның ішіндегі адам қазір
Dialogue: 0,0:16:16.35,0:16:18.51,Default,,0,0,0,,Е тобында екі ғана қорғаушы бар.
Dialogue: 0,0:16:18.52,0:16:20.38,Default,,0,0,0,,Мұны қалай ұстап тұрсыз?
Dialogue: 0,0:16:20.38,0:16:21.87,Default,,0,0,0,,Левередж принципі
Dialogue: 0,0:16:22.18,0:16:25.10,Default,,0,0,0,,Те... рычаг...?
Dialogue: 0,0:16:25.53,0:16:28.72,Default,,0,0,0,,Мен «левередж» деп айтқанда, таңқаларлық, бәрі әрқашан келіседі.
Dialogue: 0,0:16:28.80,0:16:30.36,Default,,0,0,0,,Әрине, бұл ыңғайлы.
Dialogue: 0,0:16:30.93,0:16:33.67,Default,,0,0,0,,Күткендей, екі адамның оны ұстап тұруы мүмкін емес.
Dialogue: 0,0:16:34.19,0:16:34.98,Default,,0,0,0,,Бірақ сендер
Dialogue: 0,0:16:35.11,0:16:38.23,Default,,0,0,0,,бұйрықсыз ештеңе істей алмайды, солай ма?
Dialogue: 0,0:16:38.48,0:16:42.11,Default,,0,0,0,,Бәлкім, оның қолында әлі де бар
Dialogue: 0,0:16:42.24,0:16:45.28,Default,,0,0,0,,Менің ойымша, оның бұйрықтарын күткен дұрыс
Dialogue: 0,0:16:45.41,0:16:47.20,Default,,0,0,0,,кез келген қозғалыс жасамас бұрын
Dialogue: 0,0:16:47.28,0:16:48.86,Default,,0,0,0,,Төрт көзді қарғыс атсын!
Dialogue: 0,0:16:48.92,0:16:51.13,Default,,0,0,0,,Asano нұсқаулары
Dialogue: 0,0:16:51.85,0:16:53.25,Default,,0,0,0,,Нұсқаулар беру мүмкін емес
Dialogue: 0,0:16:54.00,0:16:56.63,Default,,0,0,0,,А тобы да қорғанысқа дайын.
Dialogue: 0,0:16:56.66,0:17:00.30,Default,,0,0,0,,Егер біз бұған төзе алатын болсақ, Е сыныбына қарсы ештеңе істей алмауымыз керек.
Dialogue: 0,0:17:00.35,0:17:01.17,Default,,0,0,0,,Б-Бірақ соншама Титан бар кезде адамды көтеріп ұшу…
Dialogue: 0,0:17:01.30,0:17:02.84,Default,,0,0,0,,Кел, Итона
Dialogue: 0,0:17:03.22,0:17:03.88,Default,,0,0,0,,О
Dialogue: 0,0:17:05.85,0:17:08.81,Default,,0,0,0,,Құпия қару - бұл сіз соңына дейін сақтайтын нәрсе.
Dialogue: 0,0:17:15.96,0:17:16.68,Default,,0,0,0,,Жоғалту
Dialogue: 0,0:17:29.90,0:17:31.16,Default,,0,0,0,,А тобы...
Dialogue: 0,0:17:31.42,0:17:32.50,Default,,0,0,0,,E класы...
Dialogue: 0,0:17:33.08,0:17:34.32,Default,,0,0,0,,Жеңіс!
Dialogue: 0,0:17:36.18,0:17:38.34,Default,,0,0,0,,Салқын Менің балаларым керемет
Dialogue: 0,0:17:38.39,0:17:39.96,Default,,0,0,0,,Маған өз көзқарасыңызды беріңіз.
Dialogue: 0,0:17:43.05,0:17:43.90,Default,,0,0,0,,E тобы
Dialogue: 0,0:17:44.44,0:17:48.60,Default,,0,0,0,,Кез келген адамның көз алдында қолайсыз болған шайқаста керемет жеңіске жетті.
Dialogue: 0,0:17:49.41,0:17:52.97,Default,,0,0,0,,Қысқасы, сендер толықтай жеңілдіңдер.
Dialogue: 0,0:17:53.25,0:17:56.47,Default,,0,0,0,,Исағай сіздің стратегияңызды пайдаланды.
Dialogue: 0,0:17:56.65,0:17:59.52,Default,,0,0,0,,Шайқас жасырын құпия қарумен шешілді.
Dialogue: 0,0:18:00.11,0:18:02.94,Default,,0,0,0,,Сіз ақпараттық соғыста жеңіліп қалдыңыз.
Dialogue: 0,0:18:03.55,0:18:05.32,Default,,0,0,0,,Сіз көшбасшы ретінде дисквалификацияландысыз.
Dialogue: 0,0:18:06.36,0:18:07.57,Default,,0,0,0,,Бас директор
Dialogue: 0,0:18:07.70,0:18:09.95,Default,,0,0,0,,Сіздің ұлыңыз өте қабілетті
Dialogue: 0,0:18:10.06,0:18:10.87,Default,,0,0,0,,Тоқта, Кевин
Dialogue: 0,0:18:10.99,0:18:12.95,Default,,0,0,0,,Әке ретінде оған айту керек
Dialogue: 0,0:18:13.04,0:18:15.66,Default,,0,0,0,,оның жоғалтудан үйренетіні көп
Dialogue: 0,0:18:16.46,0:18:17.82,Default,,0,0,0,,Мен көремін
Dialogue: 0,0:18:18.29,0:18:21.50,Default,,0,0,0,,Сіздің кішкентай пікіріңіз өте әсерлі, Кевин
Dialogue: 0,0:18:22.21,0:18:24.46,Default,,0,0,0,,Маған да үйренуге көмектесе аласыз ба?
Dialogue: 0,0:18:24.58,0:18:26.38,Default,,0,0,0,,Егер мен жеңілетін болсам
Dialogue: 0,0:18:26.68,0:18:30.22,Default,,0,0,0,,Мен бұл жоғалтудан сабақ алатын шығармын
Dialogue: 0,0:18:30.35,0:18:32.97,Default,,0,0,0,,Төртеуі де бірден
Dialogue: 0,0:18:33.35,0:18:34.72,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:18:39.85,0:18:42.99,Default,,0,0,0,,Исағай-сенпай салқын еді
Dialogue: 0,0:18:43.03,0:18:44.18,Default,,0,0,0,,О, рахмет
Dialogue: 0,0:18:44.54,0:18:46.11,Default,,0,0,0,,Оны көшірмеңіз, бұл қауіпті
Dialogue: 0,0:18:46.20,0:18:48.36,Default,,0,0,0,,Қарғыс атсын саған әдемі жігіт
Dialogue: 0,0:18:48.79,0:18:51.87,Default,,0,0,0,,Бірақ атмосферада бір нәрсе өзгерді.
Dialogue: 0,0:18:52.02,0:18:54.70,Default,,0,0,0,,Әсіресе Е сыныбына қарайтын көздер, негізінен төменгі сынып оқушылары.
Dialogue: 0,0:18:54.80,0:18:56.04,Default,,0,0,0,,Әрине
Dialogue: 0,0:18:56.21,0:18:59.25,Default,,0,0,0,,Сондай кемшілікті төңкеріп, жеңдім.
Dialogue: 0,0:18:59.85,0:19:01.00,Default,,0,0,0,,Біз туралы бірдеңе
Dialogue: 0,0:19:01.34,0:19:04.08,Default,,0,0,0,,Асано мен басқалардан да жақсырақ.
Dialogue: 0,0:19:10.31,0:19:12.72,Default,,0,0,0,,Кешіріңіз, кешіріңіз.
Dialogue: 0,0:19:13.24,0:19:14.93,Default,,0,0,0,,Кешірім сұраймын.
Dialogue: 0,0:19:15.72,0:19:19.03,Default,,0,0,0,,Мен каратэден қара белбеу жеңдім.
Dialogue: 0,0:19:19.73,0:19:21.69,Default,,0,0,0,,Бұл каратэ басталғаннан кейінгі үшінші күн болды.
Dialogue: 0,0:19:22.45,0:19:24.65,Default,,0,0,0,,Бірінші күні Көтенпаннан жеңіліп қалдым.
Dialogue: 0,0:19:25.38,0:19:29.11,Default,,0,0,0,,Жасы 30-дан асқан қария құсып, аударылып қалды.
Dialogue: 0,0:19:29.70,0:19:31.61,Default,,0,0,0,,Ақырғы жеңілістің дәмін тат
Dialogue: 0,0:19:32.31,0:19:34.53,Default,,0,0,0,,Сонымен, сіз екінші күні не істедім деп ойлайсыз?
Dialogue: 0,0:19:36.22,0:19:37.37,Default,,0,0,0,,Мен жай ғана қарап тұрдым.
Dialogue: 0,0:19:38.08,0:19:40.99,Default,,0,0,0,,Төтенше қорлықтың жалынына оранып жатқанда
Dialogue: 0,0:19:41.94,0:19:43.59,Default,,0,0,0,,Келесі жолы тағы жеңілсем
Dialogue: 0,0:19:44.19,0:19:49.22,Default,,0,0,0,,Мүмкін мен өз мінезімді сақтай алмай, жынды болып өлетін шығармын.
Dialogue: 0,0:19:51.18,0:19:52.39,Default,,0,0,0,,Ал үшінші күні
Dialogue: 0,0:19:52.91,0:19:55.97,Default,,0,0,0,,Шеберді бір оқ тигізбей жеңді.
Dialogue: 0,0:19:56.86,0:19:59.17,Default,,0,0,0,,Жеңілістен сабақ алу деген осы.
Dialogue: 0,0:20:00.93,0:20:02.35,Default,,0,0,0,,Эй Асано-кун
Dialogue: 0,0:20:03.47,0:20:04.81,Default,,0,0,0,,Жеңілсем де
Dialogue: 0,0:20:05.07,0:20:09.24,Default,,0,0,0,,Неліктен өлгенше өкінбейсің?
Dialogue: 0,0:20:11.28,0:20:12.49,Default,,0,0,0,,Құбыжық
Dialogue: 0,0:20:17.41,0:20:19.00,Default,,0,0,0,,Эй, сәл күте тұрыңыз.
Dialogue: 0,0:20:20.30,0:20:21.58,Default,,0,0,0,,Бұл Асано-кун.
Dialogue: 0,0:20:22.41,0:20:23.55,Default,,0,0,0,,Сәлем Асано
Dialogue: 0,0:20:24.58,0:20:26.17,Default,,0,0,0,,Менің ойымша, бұл жерде қателік жоқ.
Dialogue: 0,0:20:26.55,0:20:28.74,Default,,0,0,0,,Олар бұл мәселеге үндемейді.
Dialogue: 0,0:20:29.57,0:20:31.18,Default,,0,0,0,,Мен өтірік айтпаймын
Dialogue: 0,0:20:32.08,0:20:35.01,Default,,0,0,0,,Өйткені мен сізден айырмашылығым, паллиативтік әдістерді қолданбаймын.
Dialogue: 0,0:20:36.24,0:20:38.22,Default,,0,0,0,,Бірақ келесі жолы бұлай болмайды.
Dialogue: 0,0:20:39.02,0:20:41.17,Default,,0,0,0,,Мен олардың бәрін құрдымға жіберемін.
Dialogue: 0,0:20:42.82,0:20:44.30,Default,,0,0,0,,Жеңілудің ащылығы
Dialogue: 0,0:20:44.38,0:20:45.73,Default,,0,0,0,,(Косей) Сен балалармен тез тіл табысасың ғой, иә?
Dialogue: 0,0:20:45.73,0:20:48.53,Default,,0,0,0,,Мен жеңілгендердің айқайын естімеймін.
Dialogue: 0,0:20:48.68,0:20:49.81,Default,,0,0,0,,Білесің бе, ешкім қарап тұрған жоқ болса да, солай қажырлы еңбек ету.
Dialogue: 0,0:20:50.05,0:20:53.24,Default,,0,0,0,,Ол сіздің қиындықтарыңызды түсінбейді.
Dialogue: 0,0:20:53.72,0:20:55.70,Default,,0,0,0,,Жоқ, бұл мен емес.
Dialogue: 0,0:20:56.24,0:20:58.85,Default,,0,0,0,,Ол жігітпен салыстырғанда мен тіпті еңбекқор емеспін.
Dialogue: 0,0:20:59.43,0:21:01.16,Default,,0,0,0,,Бүгін маған барлығы көмектесті.
Dialogue: 0,0:21:01.95,0:21:03.92,Default,,0,0,0,,Мен кедей болуды жақсы нәрсе деп ойладым.
Dialogue: 0,0:21:05.43,0:21:07.00,Default,,0,0,0,,​​Уайымдама, Асано-кун.
Dialogue: 0,0:21:05.94,0:21:07.96,Default,,0,0,0,,Асано сияқты жарқыраған емес.
Dialogue: 0,0:21:07.00,0:21:09.91,Default,,0,0,0,,Бәріміз бірге әдемі түскі ас ішеміз
Dialogue: 0,0:21:08.51,0:21:11.67,Default,,0,0,0,,Бірақ Исағай-күн не алдында, не жоғарыда.
Dialogue: 0,0:21:11.85,0:21:13.35,Default,,0,0,0,,Білмей тұрып қасымда боласың
Dialogue: 0,0:21:14.92,0:21:16.54,Default,,0,0,0,,Нан жеу жарысынан қалғаны көп.
Dialogue: 0,0:21:16.67,0:21:18.96,Default,,0,0,0,,3 Е сыныбының сынып жетекшісі
Dialogue: 0,0:21:16.86,0:21:19.47,Default,,0,0,0,,Мен мұны аламын ба?
Dialogue: 0,0:21:19.32,0:21:21.77,Default,,0,0,0,,Ол көшбасшы және әдемі өлтіруші.
Dialogue: 0,0:21:20.02,0:21:20.74,Default,,0,0,0,,Шынайы
Dialogue: 0,0:21:20.86,0:21:22.75,Default,,0,0,0,,Жарайды, алтын балық наны.
Dialogue: 0,0:21:35.44,0:21:40.48,Default,,0,0,0,,Түнгі аспанда жүзіп жүрген ай да
Dialogue: 0,0:21:40.98,0:21:45.86,Default,,0,0,0,,Қолымды созсам, мен оған жете аламын
Dialogue: 0,0:21:46.45,0:21:51.95,Default,,0,0,0,,Мен оны ақырын ұстадым, ол жылы болды.
Dialogue: 0,0:21:51.95,0:21:56.50,Default,,0,0,0,,Бірте-бірте сіңіп кетті
Dialogue: 0,0:21:57.29,0:22:02.42,Default,,0,0,0,,Аяқ іздерін ұлғайту
Dialogue: 0,0:22:03.13,0:22:08.01,Default,,0,0,0,,Терезеден көрініс
Dialogue: 0,0:22:08.34,0:22:14.06,Default,,0,0,0,,Мәнерсіз ағып жатыр
Dialogue: 0,0:22:14.06,0:22:18.73,Default,,0,0,0,,Екі қолынан төгілу
Dialogue: 0,0:22:18.73,0:22:22.90,Default,,0,0,0,,Алды-артқа теңселу
Dialogue: 0,0:22:22.90,0:22:25.69,Default,,0,0,0,,Мен білмедім
Dialogue: 0,0:22:25.69,0:22:30.95,Default,,0,0,0,,Қолыммен ұстағанша
Dialogue: 0,0:22:30.95,0:22:36.54,Default,,0,0,0,,Азайып бара жатқан ай астында шашыраңқы заттар
Dialogue: 0,0:22:36.54,0:22:40.46,Default,,0,0,0,,Мен жинап, тексергім келеді.
Dialogue: 0,0:22:40.46,0:22:43.75,Default,,0,0,0,,Мұның бәрі
Dialogue: 0,0:22:55.10,0:22:59.10,Default,,0,0,0,,Рычаг принципі бойынша әсер ету нүктесіне түсірілген күш пен тірек нүктесінен әсер ету нүктесіне дейінгі қашықтыққа көбейтіндісі
Dialogue: 0,0:22:59.15,0:23:02.52,Default,,0,0,0,,Күш нүктесіне түсірілген күш пен тірек нүктесінен күш нүктесіне дейінгі қашықтықтың көбейтіндісіне тең
Dialogue: 0,0:23:02.57,0:23:04.96,Default,,0,0,0,,Басқаша айтқанда, егер біз өзек ұшына жақын күш қолдансақ,
Dialogue: 0,0:23:05.00,0:23:07.89,Default,,0,0,0,,Жауды аз күшпен басуға болады, Такебаяши-кун.
Dialogue: 0,0:23:07.95,0:23:09.80,Default,,0,0,0,,Келесі жолы бұрын және кейін
Dialogue: 0,0:23:11.30,0:23:16.30,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
