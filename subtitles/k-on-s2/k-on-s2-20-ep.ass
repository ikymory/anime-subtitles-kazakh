Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,Бұл тамаша
Dialogue: 0,0:00:05.73,0:00:07.66,Default,,0,0,0,,Бірақ сен жақсы ұйықтап жатырсың~
Dialogue: 0,0:00:08.07,0:00:10.48,Default,,0,0,0,,Мен оның Ромеоны ойнаудан шаршағанына сенімдімін.
Dialogue: 0,0:00:15.04,0:00:15.91,Default,,0,0,0,,Қайырлы таң Мио
Dialogue: 0,0:00:16.13,0:00:17.33,Default,,0,0,0,,Қайырлы таң Мио Чан
Dialogue: 0,0:00:17.88,0:00:19.09,Default,,0,0,0,,Баршаңызға қайырлы таң
Dialogue: 0,0:01:59.30,0:02:00.11,Default,,0,0,0,,Айта
Dialogue: 0,0:02:02.26,0:02:03.85,Default,,0,0,0,,Мио мені ұрды!
Dialogue: 0,0:02:04.08,0:02:05.39,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:02:05.71,0:02:07.96,Default,,0,0,0,,Мен Мио ашуланбайды деп үміттендім.
Dialogue: 0,0:02:08.18,0:02:09.29,Default,,0,0,0,,Бұл тым көп жазу.
Dialogue: 0,0:02:09.53,0:02:11.73,Default,,0,0,0,,Бұл тиімдірек көрінеді.
Dialogue: 0,0:02:11.91,0:02:14.25,Default,,0,0,0,,Мен де өмір сызығын қалыңдаттым.
Dialogue: 0,0:02:33.02,0:02:34.56,Default,,0,0,0,,Жарайды, қазір барайық.
Dialogue: 0,0:02:34.99,0:02:36.58,Default,,0,0,0,,Жарайды, Миочан.
Dialogue: 0,0:02:36.77,0:02:38.34,Default,,0,0,0,,Мен де тиісті дайындықтан өттім.
Dialogue: 0,0:02:38.62,0:02:39.63,Default,,0,0,0,,...Дұрыс.
Dialogue: 0,0:02:39.86,0:02:41.27,Default,,0,0,0,,Әдеттегідей жасайық.
Dialogue: 0,0:02:41.50,0:02:42.14,Default,,0,0,0,,Иә
Dialogue: 0,0:02:42.41,0:02:44.22,Default,,0,0,0,,Жарайды, жасайық!
Dialogue: 0,0:02:44.45,0:02:45.31,Default,,0,0,0,,О!
Dialogue: 0,0:02:45.57,0:02:47.07,Default,,0,0,0,,Біздің өміріміз!
Dialogue: 0,0:02:47.27,0:02:48.27,Default,,0,0,0,,О!
Dialogue: 0,0:02:48.51,0:02:49.66,Default,,0,0,0,,Ең жақсы тікелей шоу!
Dialogue: 0,0:02:49.81,0:02:50.82,Default,,0,0,0,,О!
Dialogue: 0,0:02:50.99,0:02:52.20,Default,,0,0,0,,Торт дайын болған кезде!
Dialogue: 0,0:02:52.33,0:02:53.29,Default,,0,0,0,,О!
Dialogue: 0,0:02:53.38,0:02:54.38,Default,,0,0,0,,...Ой?
Dialogue: 0,0:03:07.86,0:03:09.71,Default,,0,0,0,,Еңбегіңіз үшін рахмет!
Dialogue: 0,0:03:10.79,0:03:12.13,Default,,0,0,0,,Жарайды, кеттік!
Dialogue: 0,0:03:12.38,0:03:13.04,Default,,0,0,0,,Иә!
Dialogue: 0,0:03:20.40,0:03:22.65,Default,,0,0,0,,Жарайды, бәріміз дайынбыз.
Dialogue: 0,0:03:22.91,0:03:26.32,Default,,0,0,0,,Ей, бұл мектеп фестивалі тікелей эфирде үшінші рет.
Dialogue: 0,0:03:26.58,0:03:27.62,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:03:27.96,0:03:30.95,Default,,0,0,0,,Бұл екі жыл бұрын бірінші рет болды, мен қатты қобалжыдым.
Dialogue: 0,0:03:31.16,0:03:32.10,Default,,0,0,0,,2 жыл бұрын...
Dialogue: 0,0:03:32.24,0:03:34.86,Default,,0,0,0,,А... жоқ... бұл менің айтқым келгенім емес...
Dialogue: 0,0:03:35.07,0:03:36.72,Default,,0,0,0,,Қараңыз, бірақ былтыр
Dialogue: 0,0:03:36.88,0:03:40.64,Default,,0,0,0,,Ыстым көтеріліп, Гитаны үйде ұмытып кетіппін...
Dialogue: 0,0:03:40.74,0:03:41.24,Default,,0,0,0,,Ах
Dialogue: 0,0:03:41.23,0:03:44.15,Default,,0,0,0,,Мен сол кез үшін қатты өкінемін...
Dialogue: 0,0:03:43.54,0:03:44.50,Default,,0,0,0,,А, жоқ, жоқ...
Dialogue: 0,0:03:44.64,0:03:46.10,Default,,0,0,0,,Енді бәрі, күте тұрыңдар.
Dialogue: 0,0:03:46.40,0:03:48.18,Default,,0,0,0,,Сакура жоғары фестивалінің маңызды оқиғасы
Dialogue: 0,0:03:48.49,0:03:50.49,Default,,0,0,0,,Сабақтан кейінгі шай уақытындағы қойылым
Dialogue: 0,0:03:50.78,0:03:53.10,Default,,0,0,0,,Штанганы көтерме...
Dialogue: 0,0:03:53.39,0:03:55.55,Default,,0,0,0,,Артық емес, артық емес...
Dialogue: 0,0:03:55.99,0:03:57.68,Default,,0,0,0,,Жарайды, Миочан.
Dialogue: 0,0:03:58.03,0:04:00.55,Default,,0,0,0,,Екі рет болған нәрсе үш рет...
Dialogue: 0,0:04:00.69,0:04:01.75,Default,,0,0,0,,Себебі мен сізді жігерлендірмеймін.
Dialogue: 0,0:04:01.86,0:04:02.36,Default,,0,0,0,,Ах
Dialogue: 0,0:04:02.61,0:04:03.13,Default,,0,0,0,,Юи!
Dialogue: 0,0:04:03.28,0:04:04.08,Default,,0,0,0,,L-дің бұйрығы бойынша тергеу штабынан тыс ешкім — тіпті орынбасар бастықты да қоса алғанда —
Dialogue: 0,0:04:14.78,0:04:15.41,Default,,0,0,0,,Гита
Dialogue: 0,0:04:17.93,0:04:19.71,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:04:26.73,0:04:27.96,Default,,0,0,0,,Неге осы дене функциялары әлі де болады?
Dialogue: 0,0:04:28.27,0:04:30.92,Default,,0,0,0,,Барлығы бізбен бірдей футболка киген.
Dialogue: 0,0:04:31.85,0:04:34.29,Default,,0,0,0,,Кәне, бәріміз, үлкен қошемет көрсетейік!
Dialogue: 0,0:04:34.57,0:04:35.48,Default,,0,0,0,,Кадзу-чан! ?
Dialogue: 0,0:04:35.70,0:04:37.71,Default,,0,0,0,,Эй, сен не істеп жатырсың?
Dialogue: 0,0:04:39.32,0:04:41.14,Default,,0,0,0,,Бірдеңе жетіспейді
Dialogue: 0,0:04:41.43,0:04:44.05,Default,,0,0,0,,Мен Mio фан-клубының президенті қызметін атқардым.
Dialogue: 0,0:04:44.40,0:04:45.32,Default,,0,0,0,,Олай болса
Dialogue: 0,0:04:45.75,0:04:47.56,Default,,0,0,0,,Барлығы қандай футболкалар киеді?
Dialogue: 0,0:04:47.78,0:04:49.08,Default,,0,0,0,,Уа, сабыр ет.
Dialogue: 0,0:04:51.14,0:04:53.75,Default,,0,0,0,,Футболканы Яманака мырза дайындаған.
Dialogue: 0,0:04:54.09,0:04:56.57,Default,,0,0,0,,Концерт алдында барлығына бірге тараттық.
Dialogue: 0,0:04:57.95,0:04:59.78,Default,,0,0,0,,Сава-чанға рахмет!
Dialogue: 0,0:05:00.14,0:05:01.57,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:05:02.21,0:05:03.57,Default,,0,0,0,,Рахмет, мұғалім~
Dialogue: 0,0:05:03.68,0:05:04.40,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:05:04.49,0:05:05.61,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:05:05.83,0:05:07.10,Default,,0,0,0,,Мынау.
Dialogue: 0,0:05:09.66,0:05:12.14,Default,,0,0,0,,Сабақтан кейінгі шай уақыты
Dialogue: 0,0:05:13.76,0:05:14.70,Default,,0,0,0,,Ал...
Dialogue: 0,0:05:15.47,0:05:16.54,Default,,0,0,0,,Сәттілік Юи
Dialogue: 0,0:05:16.63,0:05:17.48,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:05:17.60,0:05:18.95,Default,,0,0,0,,Барлығыңызға рахмет~
Dialogue: 0,0:05:19.73,0:05:23.04,Default,,0,0,0,,Барлығына біз үшін көп нәрсе істеуге мәжбүр еттік.
Dialogue: 0,0:05:24.65,0:05:26.95,Default,,0,0,0,,Жылағым келеді
Dialogue: 0,0:05:27.06,0:05:28.46,Default,,0,0,0,,Сіз жылап жатырсыз, солай емес пе?
Dialogue: 0,0:05:29.16,0:05:30.13,Default,,0,0,0,,Юи~
Dialogue: 0,0:05:32.06,0:05:33.39,Default,,0,0,0,,Ол лас
Dialogue: 0,0:05:33.55,0:05:34.41,Default,,0,0,0,,Жақсы менеджер
Dialogue: 0,0:05:35.74,0:05:37.40,Default,,0,0,0,,Мио да бірдеңе деді
Dialogue: 0,0:05:37.58,0:05:39.03,Default,,0,0,0,,Ах, рахмет...
Dialogue: 0,0:05:42.60,0:05:44.56,Default,,0,0,0,,Олай болса, бірінші әнге көшейік.
Dialogue: 0,0:05:45.56,0:05:46.87,Default,,0,0,0,,«Күріш – гарнир».
Dialogue: 0,0:05:46.98,0:05:47.90,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:05:49.55,0:05:51.49,Default,,0,0,0,,Енді тыңдаңыз.
Dialogue: 0,0:05:53.45,0:05:54.35,Default,,0,0,0,,Кеттік.
Dialogue: 0,0:05:54.81,0:05:56.35,Default,,0,0,0,,Иә
Dialogue: 0,0:05:58.36,0:05:59.14,Default,,0,0,0,,Иә
Dialogue: 0,0:05:59.77,0:06:00.50,Default,,0,0,0,,Иә
Dialogue: 0,0:06:02.89,0:06:04.21,Default,,0,0,0,,Бір екі үш төрт
Dialogue: 0,0:06:14.30,0:06:19.05,Default,,0,0,0,,Тағам керемет. Барлығымен жүреді. Өте ыстық.
Dialogue: 0,0:06:19.28,0:06:24.07,Default,,0,0,0,,Рамен, удон, окономияки, мынау, мынау, мынау
Dialogue: 0,0:06:24.31,0:06:29.43,Default,,0,0,0,,Көмірсулар және көмірсулар
Dialogue: 0,0:06:29.56,0:06:31.03,Default,,0,0,0,,Арман
Dialogue: 0,0:06:31.17,0:06:34.47,Default,,0,0,0,,Ынтымақтастық (ыстық және жылы)
Dialogue: 0,0:06:34.60,0:06:37.04,Default,,0,0,0,,Тамағы ғажап, әйтпесе жалықтым.
Dialogue: 0,0:06:37.13,0:06:39.35,Default,,0,0,0,,Керісінше, күріш гарнир болып табылады.
Dialogue: 0,0:06:39.51,0:06:44.12,Default,,0,0,0,,Егер сіз Кансайдан болсаңыз, сізге окономияки мен күріш керек болады.
Dialogue: 0,0:06:44.22,0:06:46.90,Default,,0,0,0,,Бірақ мен Қансайдан емеспін.
Dialogue: 0,0:06:47.14,0:06:48.13,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:06:52.14,0:06:54.49,Default,,0,0,0,,Бір, бір, бір, бір, бір, ГОХАН!
Dialogue: 0,0:06:57.15,0:06:59.61,Default,,0,0,0,,Бір, екі, үш, үш, ГОХАН!
Dialogue: 0,0:07:02.22,0:07:04.72,Default,,0,0,0,,Тағам ғажап, жоқ болса қиналып қаласың.
Dialogue: 0,0:07:04.83,0:07:07.07,Default,,0,0,0,,Керісінше, күріш гарнир болып табылады.
Dialogue: 0,0:07:07.27,0:07:11.93,Default,,0,0,0,,Егер сіз Кансайдан болсаңыз, сізге окономияки мен күріш керек болады.
Dialogue: 0,0:07:12.06,0:07:14.73,Default,,0,0,0,,Мен бұрынғы өмірімде Қансай болғанмын!
Dialogue: 0,0:07:14.91,0:07:16.08,Default,,0,0,0,,Не болып жатыр!
Dialogue: 0,0:07:20.01,0:07:22.42,Default,,0,0,0,,1, ни, сан, ши, ГОХАН!
Dialogue: 0,0:07:25.00,0:07:26.21,Default,,0,0,0,,Бір, ни, сан, ши,
Dialogue: 0,0:07:26.30,0:07:27.56,Default,,0,0,0,,Әй
Dialogue: 0,0:07:30.03,0:07:32.41,Default,,0,0,0,,1, ни, сан, ши, ГОХАН!
Dialogue: 0,0:07:35.03,0:07:37.53,Default,,0,0,0,,Бір, бір, бір, бір, бір, ГОХАН!
Dialogue: 0,0:07:46.62,0:07:47.59,Default,,0,0,0,,Керемет!
Dialogue: 0,0:07:51.09,0:07:52.62,Default,,0,0,0,,«Күріш гарнир»
Dialogue: 0,0:07:53.12,0:07:55.64,Default,,0,0,0,,Тағы да сабақтан кейінгі шай уақыты.
Dialogue: 0,0:07:58.50,0:08:02.73,Default,,0,0,0,,Біз үшінші курстың барлық мүшелеріміз бір сыныпта оқимыз.
Dialogue: 0,0:08:03.07,0:08:06.13,Default,,0,0,0,,Кеше мен спектакль қойып едім, қиын болды.
Dialogue: 0,0:08:07.39,0:08:09.49,Default,,0,0,0,,Мио-чанның Ромеосын көрдіңіз бе?
Dialogue: 0,0:08:09.81,0:08:11.52,Default,,0,0,0,,Керемет болды, солай емес пе?
Dialogue: 0,0:08:13.08,0:08:14.17,Default,,0,0,0,,(Иида) Ол тым жылдам — ілесе алмаймын!
Dialogue: 0,0:08:14.80,0:08:16.54,Default,,0,0,0,,Мио-чан, бірдеңе істе.
Dialogue: 0,0:08:16.80,0:08:17.50,Default,,0,0,0,,Қый!
Dialogue: 0,0:08:17.76,0:08:19.34,Default,,0,0,0,,Ромеодан бір нәрсе
Dialogue: 0,0:08:20.24,0:08:22.73,Default,,0,0,0,,Ей, ақымақ, мұны істеуге амал жоқ.
Dialogue: 0,0:08:23.02,0:08:24.15,Default,,0,0,0,,Е...
Dialogue: 0,0:08:24.44,0:08:26.30,Default,,0,0,0,,Жарайды, әлі есіңізде, солай ма?
Dialogue: 0,0:08:26.53,0:08:27.60,Default,,0,0,0,,Заңға дейін
Dialogue: 0,0:08:33.92,0:08:36.63,Default,,0,0,0,,О, әдемі Джульетта
Dialogue: 0,0:08:36.86,0:08:40.28,Default,,0,0,0,,Мен сенің өліп, Құдайға жалғыз баруыңа жол бермеймін.
Dialogue: 0,0:08:41.37,0:08:42.62,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:08:42.93,0:08:44.31,Default,,0,0,0,,Мио-сенпай
Dialogue: 0,0:08:45.25,0:08:48.57,Default,,0,0,0,,Ах, демек, Рицу-чан Джульетта болды.
Dialogue: 0,0:08:48.67,0:08:49.78,Default,,0,0,0,,Мен қол бұлғайын ба? ?
Dialogue: 0,0:08:50.02,0:08:51.86,Default,,0,0,0,,Рицу-чан, сен де бірдеңе айтшы.
Dialogue: 0,0:08:52.37,0:08:54.35,Default,,0,0,0,,Мен ұмытып қалдым~
Dialogue: 0,0:08:54.53,0:08:56.14,Default,,0,0,0,,Жалғыз сен ғана қусың, Рицу!
Dialogue: 0,0:08:56.57,0:08:58.27,Default,,0,0,0,,Ой, түсіндім...
Dialogue: 0,0:08:58.49,0:09:00.16,Default,,0,0,0,,Рицу-чан, алға шықшы.
Dialogue: 0,0:09:05.30,0:09:09.46,Default,,0,0,0,,Ромео Сіз неге Ромеосыз?
Dialogue: 0,0:09:14.55,0:09:16.20,Default,,0,0,0,,Ритсу өте сүйкімді~
Dialogue: 0,0:09:16.31,0:09:17.26,Default,,0,0,0,,Заң~!
Dialogue: 0,0:09:17.65,0:09:18.70,Default,,0,0,0,,Сәлем, сәлем
Dialogue: 0,0:09:18.88,0:09:20.37,Default,,0,0,0,,Екеуіңізге де рахмет.
Dialogue: 0,0:09:20.59,0:09:23.74,Default,,0,0,0,,Айтпақшы, мен «Ки Джи» болдым.
Dialogue: 0,0:09:24.16,0:09:26.78,Default,,0,0,0,,Маған үнемі қозғалмау керектігін айтты.
Dialogue: 0,0:09:27.08,0:09:29.46,Default,,0,0,0,,Жолда түшкіре жаздадым.
Dialogue: 0,0:09:30.92,0:09:34.28,Default,,0,0,0,,Бірақ мен өзіме "Мен ағашпын. Мен ағашпын" дегенде.
Dialogue: 0,0:09:34.58,0:09:35.96,Default,,0,0,0,,Ол тоқтады.
Dialogue: 0,0:09:36.15,0:09:39.37,Default,,0,0,0,,Сонымен, көрініс өзгергенде, ол былай болады...
Dialogue: 0,0:09:41.91,0:09:43.07,Default,,0,0,0,,Кешіріңіз Азунян
Dialogue: 0,0:09:43.32,0:09:45.17,Default,,0,0,0,,Қазір жақсысың ба?
Dialogue: 0,0:09:45.59,0:09:48.31,Default,,0,0,0,,Азуса-чан сабақта не істеді?
Dialogue: 0,0:09:48.49,0:09:50.26,Default,,0,0,0,,Е, бұл кофехана.
Dialogue: 0,0:09:50.54,0:09:52.34,Default,,0,0,0,,Жарайды, келесіге өтіңіз.
Dialogue: 0,0:09:52.57,0:09:53.89,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:09:54.51,0:09:56.63,Default,,0,0,0,,Енді келесі әнге көшейік.
Dialogue: 0,0:09:58.30,0:10:00.93,Default,,0,0,0,,Аа, Ромео мен Джульетта бидай...
Dialogue: 0,0:10:01.40,0:10:03.79,Default,,0,0,0,,Котобуки сценарийді жазды
Dialogue: 0,0:10:05.69,0:10:07.60,Default,,0,0,0,,Бірдеңе бүлінген...
Dialogue: 0,0:10:08.07,0:10:09.64,Default,,0,0,0,,Келесі қай ән?
Dialogue: 0,0:10:09.93,0:10:12.93,Default,,0,0,0,,Сондықтан мен саған бір жерге жазып қой дедім.
Dialogue: 0,0:10:13.45,0:10:15.89,Default,,0,0,0,,Мен оны бір жерден жоғалтып алған сияқтымын...
Dialogue: 0,0:10:16.22,0:10:17.23,Default,,0,0,0,,Сіз оны тастадыңыз ба?
Dialogue: 0,0:10:17.51,0:10:19.91,Default,,0,0,0,,Мен оны қалтамға салып қойдым деп ойладым.
Dialogue: 0,0:10:20.12,0:10:22.70,Default,,0,0,0,,А, мен жаңа ғана футболка кидім...
Dialogue: 0,0:10:22.96,0:10:24.13,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:10:24.37,0:10:26.24,Default,,0,0,0,,Мм... м...
Dialogue: 0,0:10:27.97,0:10:29.37,Default,,0,0,0,,Сәттілік, апа!
Dialogue: 0,0:10:32.24,0:10:33.00,Default,,0,0,0,,K-ON! !
Dialogue: 0,0:10:34.92,0:10:37.65,Default,,0,0,0,,Аяғынан шалынған қыздар
Dialogue: 0,0:10:37.87,0:10:39.01,Default,,0,0,0,,Қараңыз және қараңыз
Dialogue: 0,0:10:43.61,0:10:45.34,Default,,0,0,0,,Менеджер болудан басқа.
Dialogue: 0,0:10:45.83,0:10:46.87,Default,,0,0,0,,Оны ала аламын ба?
Dialogue: 0,0:10:47.12,0:10:51.51,Default,,0,0,0,,Иә, қазір мен жасап жатқан тікелей эфирде киіп алсаңыз, қуанар едім.
Dialogue: 0,0:10:51.66,0:10:52.58,Default,,0,0,0,,Рахмет
Dialogue: 0,0:10:59.99,0:11:01.64,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:11:02.28,0:11:05.99,Default,,0,0,0,,Олай болса, мен мұндағы мүшелерді таныстырғым келеді.
Dialogue: 0,0:11:06.69,0:11:08.88,Default,,0,0,0,,Ең алдымен, менің кеңесшім Сава-чан.
Dialogue: 0,0:11:09.02,0:11:10.14,Default,,0,0,0,,Неге мен? ?
Dialogue: 0,0:11:10.36,0:11:12.83,Default,,0,0,0,,Бұл Яманака-сенсей. Яманака-сенсей.
Dialogue: 0,0:11:13.02,0:11:14.92,Default,,0,0,0,,А, бұл профессор Яманака.
Dialogue: 0,0:11:15.13,0:11:16.85,Default,,0,0,0,,Профессор Сава-чан Яманака
Dialogue: 0,0:11:17.25,0:11:18.90,Default,,0,0,0,,«Сава-чан» жақсы емес.
Dialogue: 0,0:11:20.20,0:11:22.41,Default,,0,0,0,,Сава-чан~
Dialogue: 0,0:11:22.51,0:11:24.79,Default,,0,0,0,,Яманака мырза маған әрқашан мейірімді болды.
Dialogue: 0,0:11:25.00,0:11:27.76,Default,,0,0,0,,Олар біздің үйірме жұмыстарына қолдау көрсетеді.
Dialogue: 0,0:11:28.49,0:11:30.26,Default,,0,0,0,,Барлығы жарқырап тұр!
Dialogue: 0,0:11:31.38,0:11:33.03,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:11:35.41,0:11:37.73,Default,,0,0,0,,Келесі орында бассты Мио Чан.
Dialogue: 0,0:11:39.06,0:11:41.21,Default,,0,0,0,,Мио-сенпай~
Dialogue: 0,0:11:41.99,0:11:46.11,Default,,0,0,0,,Кеше мен сынып сағатымызда Ромео рөлін ойнадым.
Dialogue: 0,0:11:46.23,0:11:47.43,Default,,0,0,0,,Мен мұны бұрын айттым.
Dialogue: 0,0:11:47.69,0:11:48.26,Default,,0,0,0,,Ой...
Dialogue: 0,0:11:50.89,0:11:51.74,Default,,0,0,0,,Сәлем
Dialogue: 0,0:11:52.59,0:11:55.93,Default,,0,0,0,,Бүгінгі біздің жанды орындауымызды тыңдағандарыңызға рахмет.
Dialogue: 0,0:11:56.14,0:11:57.36,Default,,0,0,0,,Рахмет
Dialogue: 0,0:11:57.52,0:11:59.09,Default,,0,0,0,,Мио-сенпай~
Dialogue: 0,0:11:59.13,0:12:02.55,Default,,0,0,0,,Мен мұндағы барлық адамдармен топта болғым келеді...
Dialogue: 0,0:12:03.62,0:12:04.81,Default,,0,0,0,,Керемет!
Dialogue: 0,0:12:07.82,0:12:10.69,Default,,0,0,0,,Аа, Мио-чанның да фан-клубы бар.
Dialogue: 0,0:12:11.17,0:12:14.55,Default,,0,0,0,,Егер сіз қосылғыңыз келсе, онда Казу-чанға айтыңыз.
Dialogue: 0,0:12:14.74,0:12:15.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:15.72,0:12:18.61,Default,,0,0,0,,Кадзу-чан менің бала күнгі досым.
Dialogue: 0,0:12:18.90,0:12:21.98,Default,,0,0,0,,Студенттер кеңесінің төрағасы, білімді де зерек
Dialogue: 0,0:12:22.39,0:12:24.75,Default,,0,0,0,,Маған үнемі нені оқу керектігін үйретеді.
Dialogue: 0,0:12:23.03,0:12:23.94,Default,,0,0,0,,Эй Юи...?
Dialogue: 0,0:12:25.66,0:12:27.58,Default,,0,0,0,,Кадзу-чан, бірдеңе айтшы!
Dialogue: 0,0:12:27.74,0:12:28.69,Default,,0,0,0,,Шыгандшинаға баратын жолды іздеуге аттанған Зерттеу корпусы,
Dialogue: 0,0:12:29.53,0:12:32.10,Default,,0,0,0,,Тездетіп, келесіге өтіңіз.
Dialogue: 0,0:12:32.22,0:12:33.18,Default,,0,0,0,,Е...
Dialogue: 0,0:12:33.48,0:12:36.93,Default,,0,0,0,,Содан кейін пернетақтадағы Муги-чан.
Dialogue: 0,0:12:39.09,0:12:40.57,Default,,0,0,0,,Бәріңе сәлем
Dialogue: 0,0:12:41.15,0:12:43.40,Default,,0,0,0,,Ах Муги-чан
Dialogue: 0,0:12:41.77,0:12:46.20,Default,,0,0,0,,Біздің қойылымды тыңдағандарыңызға рахмет!
Dialogue: 0,0:12:46.39,0:12:48.89,Default,,0,0,0,,Сейно Муги~!
Dialogue: 0,0:12:49.81,0:12:51.38,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:12:51.76,0:12:54.01,Default,,0,0,0,,Топта болу өте қызық.
Dialogue: 0,0:12:54.24,0:12:56.22,Default,,0,0,0,,Бұл өте қызық!
Dialogue: 0,0:12:57.13,0:12:58.85,Default,,0,0,0,,Муги-чан, сабыр ет.
Dialogue: 0,0:12:59.98,0:13:03.10,Default,,0,0,0,,Муги-чан жасайтын шай өте дәмді.
Dialogue: 0,0:13:03.36,0:13:05.24,Default,,0,0,0,,Мен оны әрқашан асыға күтемін.
Dialogue: 0,0:13:05.38,0:13:06.57,Default,,0,0,0,,Менің де ішкім келеді!
Dialogue: 0,0:13:07.06,0:13:10.57,Default,,0,0,0,,Кез келген уақытта клуб бөлмесіне келіңіз, сізді өте жақсы қарсы аламыз.
Dialogue: 0,0:13:12.08,0:13:15.45,Default,,0,0,0,,Тон-чан да клуб бөлмесінде, сондықтан оны көруге келіңіз.
Dialogue: 0,0:13:15.69,0:13:16.85,Default,,0,0,0,,Тон-чан деген кім?
Dialogue: 0,0:13:17.37,0:13:18.72,Default,,0,0,0,,Ах, Тон-чан.
Dialogue: 0,0:13:18.89,0:13:20.98,Default,,0,0,0,,Жұмсақ қабықты тасбақа – тасбақа.
Dialogue: 0,0:13:21.27,0:13:23.85,Default,,0,0,0,,Оның шошқа тәрізді мұрны бар және өте сүйкімді~
Dialogue: 0,0:13:24.15,0:13:24.98,Default,,0,0,0,,Сәлем Азунян
Dialogue: 0,0:13:25.10,0:13:26.59,Default,,0,0,0,,А-а... иә
Dialogue: 0,0:13:26.68,0:13:27.95,Default,,0,0,0,,Мен Азунянмын, гитарада ойнаушымын.
Dialogue: 0,0:13:28.42,0:13:29.48,Default,,0,0,0,,Мен бе?
Dialogue: 0,0:13:31.47,0:13:32.38,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:13:32.49,0:13:33.37,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:13:33.50,0:13:35.71,Default,,0,0,0,,Жарайды, кешіріңіз.
Dialogue: 0,0:13:36.48,0:13:40.96,Default,,0,0,0,,Мм... Мен Азуса Наканомын. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:13:41.72,0:13:43.27,Default,,0,0,0,,Азуса-чан! Азуса~!
Dialogue: 0,0:13:43.59,0:13:47.31,Default,,0,0,0,,Азунян екінші курс студенті, бірақ ол гитарада өте жақсы ойнайды.
Dialogue: 0,0:13:47.73,0:13:50.19,Default,,0,0,0,,Мені де оқытып жатыр
Dialogue: 0,0:13:50.63,0:13:52.52,Default,,0,0,0,,Рахмет сізге Азунян
Dialogue: 0,0:13:54.09,0:13:55.83,Default,,0,0,0,,Ах... Рахмет.
Dialogue: 0,0:13:56.13,0:13:58.30,Default,,0,0,0,,Келесіде барабаншы Рицу-чан.
Dialogue: 0,0:13:59.04,0:14:01.26,Default,,0,0,0,,Мен жеңіл музыкалық үйірменің жетекшісімін!
Dialogue: 0,0:14:02.22,0:14:06.38,Default,,0,0,0,,Жарайсыңдар, бүгінгі жеңіл музыкалық клубтың жанды дауыстағы орындауын тыңдаңдар.
Dialogue: 0,0:14:06.61,0:14:07.65,Default,,0,0,0,,Рахмет
Dialogue: 0,0:14:07.77,0:14:08.77,Default,,0,0,0,,Йо Рицу-чан!
Dialogue: 0,0:14:08.88,0:14:10.43,Default,,0,0,0,,Мен қобалжымаймын.
Dialogue: 0,0:14:12.14,0:14:13.49,Default,,0,0,0,,Енді келесі әнге көшейік.
Dialogue: 0,0:14:13.62,0:14:14.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:13.92,0:14:14.71,Default,,0,0,0,,Қысқа
Dialogue: 0,0:14:15.46,0:14:16.16,Default,,0,0,0,,Бір ай бойы бірдей нәрсені естіп жүрсең, ештеңе сезбей қаласың.
Dialogue: 0,0:14:16.31,0:14:16.98,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:14:17.92,0:14:19.08,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:14:19.48,0:14:21.42,Default,,0,0,0,,Міне, келесі ән.
Dialogue: 0,0:14:21.61,0:14:23.65,Default,,0,0,0,,Эй, мен өзімді таныстырған жоқпын.
Dialogue: 0,0:14:23.85,0:14:25.29,Default,,0,0,0,,О, дұрыс.
Dialogue: 0,0:14:25.81,0:14:27.99,Default,,0,0,0,,Соңғысы, бірақ кем дегенде, Юй Чан, гитарашы.
Dialogue: 0,0:14:28.40,0:14:29.58,Default,,0,0,0,,Бұл сенің әпкең.
Dialogue: 0,0:14:31.13,0:14:35.04,Default,,0,0,0,,Юи өзі сияқты жайбарақат және ол мүлдем бей-жай қалды.
Dialogue: 0,0:14:35.45,0:14:38.32,Default,,0,0,0,,Әрқашан қолыңнан келгеннің бәрін істе, барыңды істе
Dialogue: 0,0:14:38.73,0:14:41.35,Default,,0,0,0,,Айналаңыздағылардың барлығына да қуат беріңіз
Dialogue: 0,0:14:42.22,0:14:44.20,Default,,0,0,0,,Ол өте сенімді аға.
Dialogue: 0,0:14:45.19,0:14:47.94,Default,,0,0,0,,Не болды? Не болды?
Dialogue: 0,0:14:48.35,0:14:50.19,Default,,0,0,0,,Әй, тезірек әрі қарай жүр!
Dialogue: 0,0:14:50.41,0:14:51.67,Default,,0,0,0,,Үлкен әпке!
Dialogue: 0,0:14:52.44,0:14:54.38,Default,,0,0,0,,О, қайғы!
Dialogue: 0,0:14:54.51,0:14:55.76,Default,,0,0,0,,Үлкен әпке!
Dialogue: 0,0:14:55.92,0:14:57.32,Default,,0,0,0,,Енді көзіміз түйісті!
Dialogue: 0,0:14:57.60,0:14:59.07,Default,,0,0,0,,Бұл сәйкес келеді.
Dialogue: 0,0:14:59.19,0:15:00.01,Default,,0,0,0,,Юи~!
Dialogue: 0,0:15:00.27,0:15:04.30,Default,,0,0,0,,Сабақтан кейін шай уақыты!
Dialogue: 0,0:15:21.77,0:15:24.12,Default,,0,0,0,,Енді бұл соңғы ән.
Dialogue: 0,0:15:24.29,0:15:27.26,Default,,0,0,0,,Ал, көп жаса!
Dialogue: 0,0:15:27.33,0:15:31.51,Default,,0,0,0,,Мен көбірек ойнағым келеді, бірақ... уақытым таусылып барады.
Dialogue: 0,0:15:29.76,0:15:31.30,Default,,0,0,0,,Сәттілік~
Dialogue: 0,0:15:32.22,0:15:33.17,Default,,0,0,0,,Жақсы шықты
Dialogue: 0,0:15:33.56,0:15:35.81,Default,,0,0,0,,Мектептен кейін~!
Dialogue: 0,0:15:36.11,0:15:37.92,Default,,0,0,0,,Шай уақытына дейін айтыңыз
Dialogue: 0,0:15:42.51,0:15:45.02,Default,,0,0,0,,Бүгінгі күн үшін көп рахмет.
Dialogue: 0,0:15:46.19,0:15:48.97,Default,,0,0,0,,Яманака мырза, футболка үшін рахмет!
Dialogue: 0,0:15:50.05,0:15:52.51,Default,,0,0,0,,Кадзу-чан, әдеттегідей рахмет!
Dialogue: 0,0:15:52.94,0:15:55.56,Default,,0,0,0,,Рахмет, Джун Ю!
Dialogue: 0,0:15:55.90,0:15:57.74,Default,,0,0,0,,Сыныптағы барлығына рахмет!
Dialogue: 0,0:15:57.84,0:15:58.52,Default,,0,0,0,,Юи~!
Dialogue: 0,0:15:58.74,0:15:59.28,Default,,0,0,0,,Физика шекараларын да бағындыратын күш—
Dialogue: 0,0:15:59.41,0:16:00.45,Default,,0,0,0,,Юи~!
Dialogue: 0,0:16:00.63,0:16:01.98,Default,,0,0,0,,Рахмет, Тон-чан!
Dialogue: 0,0:16:02.18,0:16:03.35,Default,,0,0,0,,Клуб бөлмесі Рахмет!
Dialogue: 0,0:16:03.66,0:16:04.98,Default,,0,0,0,,Гитаға рахмет!
Dialogue: 0,0:16:05.21,0:16:08.24,Default,,0,0,0,,Барлығыңызға көп рахмет!
Dialogue: 0,0:16:11.64,0:16:13.18,Default,,0,0,0,,Сабақтан кейінгі шай уақыты
Dialogue: 0,0:16:13.48,0:16:15.58,Default,,0,0,0,,Мәңгі және мәңгі...
Dialogue: 0,0:16:16.39,0:16:17.56,Default,,0,0,0,,Мектеп бітті!
Dialogue: 0,0:16:18.27,0:16:19.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:19.33,0:16:20.55,Default,,0,0,0,,Хааа~
Dialogue: 0,0:16:22.62,0:16:25.32,Default,,0,0,0,,Енді соңғы әнді тыңдаңыз.
Dialogue: 0,0:16:26.40,0:16:27.71,Default,,0,0,0,,«U&I»!
Dialogue: 0,0:16:43.16,0:16:47.44,Default,,0,0,0,,Сенсіз мен ештеңе істей алмаймын.
Dialogue: 0,0:16:47.67,0:16:51.07,Default,,0,0,0,,Мен сенің тамағыңды жегім келеді.
Dialogue: 0,0:16:52.19,0:16:56.59,Default,,0,0,0,,Үйге күлімдеп келсең
Dialogue: 0,0:16:56.81,0:17:00.50,Default,,0,0,0,,Мен сені құшақтаймын
Dialogue: 0,0:17:00.81,0:17:05.54,Default,,0,0,0,,Мен сенсіз кешірім сұрай алмаймын
Dialogue: 0,0:17:05.68,0:17:09.76,Default,,0,0,0,,Даусыңды естігім келеді
Dialogue: 0,0:17:09.96,0:17:14.65,Default,,0,0,0,,Сенің күлкіңді көрсем
Dialogue: 0,0:17:14.84,0:17:18.95,Default,,0,0,0,,Бұл сізге қажет
Dialogue: 0,0:17:19.13,0:17:23.52,Default,,0,0,0,,Сен менің жанымдасың
Dialogue: 0,0:17:23.68,0:17:28.38,Default,,0,0,0,,Маған әрқашан батылдық берді
Dialogue: 0,0:17:28.52,0:17:32.92,Default,,0,0,0,,Мен сенімен мәңгі бірге болғым келеді
Dialogue: 0,0:17:33.08,0:17:37.20,Default,,0,0,0,,Мен осы сезімді жеткізгім келеді
Dialogue: 0,0:17:37.38,0:17:41.82,Default,,0,0,0,,Шуақты күнде де, жаңбырлы күндерде де
Dialogue: 0,0:17:41.97,0:17:46.67,Default,,0,0,0,,Сен менің қасымда болдың
Dialogue: 0,0:17:46.81,0:17:55.04,Default,,0,0,0,,Көзімді жұмсам күлкің жарқырайды
Dialogue: 0,0:18:31.10,0:18:33.53,Default,,0,0,0,,Үлкен жетістік... солай ма?
Dialogue: 0,0:18:34.31,0:18:36.83,Default,,0,0,0,,Мұның бәрі тез болды.
Dialogue: 0,0:18:38.52,0:18:42.12,Default,,0,0,0,,Дұрыс ойнай алғаным есімде жоқ.
Dialogue: 0,0:18:42.49,0:18:46.45,Default,,0,0,0,,Теюка мен кенеттен футболкаға таң қалдым.
Dialogue: 0,0:18:46.58,0:18:49.29,Default,,0,0,0,,Мен де, енді не болып жатқанын білмеймін.
Dialogue: 0,0:18:50.93,0:18:53.96,Default,,0,0,0,,Бірақ... бұл өте қызық болды.
Dialogue: 0,0:18:54.90,0:18:57.07,Default,,0,0,0,,Бұл мен көрген ең жақсы тікелей шоу болды.
Dialogue: 0,0:18:57.68,0:19:00.05,Default,,0,0,0,,Барлығының орындауы бір-біріне керемет сәйкес келді.
Dialogue: 0,0:19:00.39,0:19:02.00,Default,,0,0,0,,Дұрыс болды Дұрыс болды!
Dialogue: 0,0:19:02.41,0:19:04.19,Default,,0,0,0,,Гита да бақытты емес пе?
Dialogue: 0,0:19:04.50,0:19:06.66,Default,,0,0,0,,Иә, Элизабет те.
Dialogue: 0,0:19:06.98,0:19:08.52,Default,,0,0,0,,Элизабет
Dialogue: 0,0:19:08.77,0:19:10.34,Default,,0,0,0,,Ол менің кінәм деді!
Dialogue: 0,0:19:10.46,0:19:13.40,Default,,0,0,0,,Әй, сен Азусаның гитарасы күңгірт дейсің бе?
Dialogue: 0,0:19:13.83,0:19:15.81,Default,,0,0,0,,Менің көңілім қалды, себебі бұл Мустанг болды.
Dialogue: 0,0:19:17.82,0:19:20.21,Default,,0,0,0,,Ей, бұдан кейін не істейсің?
Dialogue: 0,0:19:20.68,0:19:22.75,Default,,0,0,0,,Әзірше мен торт жегім келеді!
Dialogue: 0,0:19:23.00,0:19:24.66,Default,,0,0,0,,Аа, клуб ақысы бар.
Dialogue: 0,0:19:24.85,0:19:27.14,Default,,0,0,0,,Жоқ, мен әкелдім.
Dialogue: 0,0:19:27.33,0:19:31.16,Default,,0,0,0,,Иә! Жарайды, соны жеп алайық, сосын келесіні ойланайық.
Dialogue: 0,0:19:31.67,0:19:34.16,Default,,0,0,0,,Келесі кезекте Рождестволық кеш.
Dialogue: 0,0:19:34.63,0:19:36.52,Default,,0,0,0,,Келесі Жаңа жыл.
Dialogue: 0,0:19:36.82,0:19:38.75,Default,,0,0,0,,Жаңа жылдық қонаққа барайық!
Dialogue: 0,0:19:39.40,0:19:41.97,Default,,0,0,0,,Сосын келесі Шинкан өмір сүре ме?
Dialogue: 0,0:19:42.37,0:19:44.87,Default,,0,0,0,,Сіз тағы да мектепте ұйықтайсыз ба?
Dialogue: 0,0:19:45.08,0:19:47.23,Default,,0,0,0,,Келесі жолы Сава-чанды да шақырайық.
Dialogue: 0,0:19:47.44,0:19:48.92,Default,,0,0,0,,Бұл тамаша!
Dialogue: 0,0:19:49.29,0:19:51.18,Default,,0,0,0,,Тіпті жазда да кондиционер бар.
Dialogue: 0,0:19:51.40,0:19:52.71,Default,,0,0,0,,Оқу-жаттығу жиыны да бар.
Dialogue: 0,0:19:53.02,0:19:55.79,Default,,0,0,0,,Мен оны тағатсыздана күтемін~ Енді не болады...
Dialogue: 0,0:19:56.18,0:19:58.79,Default,,0,0,0,,Ал енді не болады?
Dialogue: 0,0:19:59.14,0:20:01.16,Default,,0,0,0,,Енді не болады?
Dialogue: 0,0:20:01.48,0:20:05.60,Default,,0,0,0,,Келесі жылы мектеп оқушыларының фестивалі бұдан да жақсы болады.
Dialogue: 0,0:20:06.31,0:20:08.00,Default,,0,0,0,,Сіз жылды қайталауды жоспарлап отырсыз ба?
Dialogue: 0,0:20:08.59,0:20:10.99,Default,,0,0,0,,Жоғары мектептерде мектеп фестивалі өткізілмейді.
Dialogue: 0,0:20:11.37,0:20:14.72,Default,,0,0,0,,Түсіндім~ Бұл ұят...
Dialogue: 0,0:20:15.59,0:20:17.11,Default,,0,0,0,,Жоқ, жоқ!
Dialogue: 0,0:20:17.45,0:20:19.98,Default,,0,0,0,,Мүгі-сенпай, өзімшіл болма.
Dialogue: 0,0:20:20.42,0:20:23.87,Default,,0,0,0,,Юй-сенпай, өтінемін, балаша жылама.
Dialogue: 0,0:20:24.16,0:20:25.62,Default,,0,0,0,,Бұл тер...
Dialogue: 0,0:20:28.81,0:20:33.08,Default,,0,0,0,,Ми~о~ Рикопиен
Dialogue: 0,0:20:36.75,0:20:38.51,Default,,0,0,0,,Рицу жылап жатса да
Dialogue: 0,0:20:38.63,0:20:39.91,Default,,0,0,0,,Менікі де терлеп жатыр.
Dialogue: 0,0:20:43.11,0:20:44.80,Default,,0,0,0,,Қарашы, Мүгі-сенпай да.
Dialogue: 0,0:20:45.25,0:20:46.49,Default,,0,0,0,,Азуса-чан
Dialogue: 0,0:20:46.60,0:20:47.29,Default,,0,0,0,,Иә
Dialogue: 0,0:20:47.48,0:20:49.74,Default,,0,0,0,,Азуса-чан, рахмет...
Dialogue: 0,0:20:49.83,0:20:50.48,Default,,0,0,0,,Иә
Dialogue: 0,0:20:53.84,0:20:57.26,Default,,0,0,0,,Мүгі-сенпай, жарайды, сабыр ет.
Dialogue: 0,0:20:59.03,0:21:02.80,Default,,0,0,0,,Бұл жақсы болды. Бұл шынымен жақсы болды.
Dialogue: 0,0:21:03.25,0:21:05.67,Default,,0,0,0,,Иә, өте жақсы болды.
Dialogue: 0,0:21:06.18,0:21:08.83,Default,,0,0,0,,Мен бәріңізбен ойнай алатыныма қуаныштымын.
Dialogue: 0,0:21:10.07,0:21:11.82,Default,,0,0,0,,Барлығына! !
Dialogue: 0,0:21:14.19,0:21:17.29,Default,,0,0,0,,Тоқта, Юй, мұрыннан су ағады, мұрыннан су ағып жатыр.
Dialogue: 0,0:21:17.39,0:21:18.55,Default,,0,0,0,,Муги-чан!
Dialogue: 0,0:21:19.13,0:21:20.14,Default,,0,0,0,,Мұрыннан су ағу
Dialogue: 0,0:21:24.19,0:21:25.08,Default,,0,0,0,,Ликопен
Dialogue: 0,0:21:35.20,0:21:37.82,Default,,0,0,0,,Юи және басқалары шынымен таң қалды.
Dialogue: 0,0:21:39.40,0:21:42.13,Default,,0,0,0,,Еркелік футболка стратегиясы үлкен жетістік
Dialogue: 0,0:21:42.40,0:21:43.36,Default,,0,0,0,,Қазір...
Dialogue: 0,0:21:43.54,0:21:46.13,Default,,0,0,0,,Савако! Савако!
Dialogue: 0,0:21:46.36,0:21:49.24,Default,,0,0,0,,Баршаңызға еңбектеріңіз үшін рахмет!
Dialogue: 0,0:21:48.51,0:21:49.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:49.59,0:21:50.32,Default,,0,0,0,,Әй?
Dialogue: 0,0:21:59.78,0:22:01.35,Default,,0,0,0,,Бақытты жүз
Dialogue: 0,0:23:40.42,0:23:43.27,Default,,0,0,0,,Дипломдық фотосуреттерге арналған шаш үлгілерін зерттеу
Dialogue: 0,0:23:43.56,0:23:45.24,Default,,0,0,0,,Мен топтаманы шешкім келеді.
Dialogue: 0,0:23:45.48,0:23:47.00,Default,,0,0,0,,Ол сенімен мәңгі қалады.
Dialogue: 0,0:23:47.24,0:23:48.79,Default,,0,0,0,,Сен оқымайсың ба?
Dialogue: 0,0:23:49.26,0:23:50.09,Default,,0,0,0,,Шындығында, бұл – бастапқыда бізге жүктелген тапсырма
Dialogue: 0,0:23:50.51,0:23:53.64,Default,,0,0,0,,Бүгін мен әдеттегідей емеспін.
Dialogue: 0,0:23:53.84,0:23:55.71,Default,,0,0,0,,Олай емес, бірақ...
Dialogue: 0,0:23:55.93,0:23:59.75,Default,,0,0,0,,Ах, Кадзу-чан, біз бұрыннан таныспыз.
Dialogue: 0,0:23:59.93,0:24:01.70,Default,,0,0,0,,Dog Dog Dog бұл...
Dialogue: 0,0:24:02.16,0:24:03.34,Default,,0,0,0,,Үлкен әпке
Dialogue: 0,0:24:03.57,0:24:05.55,Default,,0,0,0,,Бастауыш сынып оқушылары күлді.
Dialogue: 0,0:24:05.79,0:24:07.80,Default,,0,0,0,,Мен орта мектепте тым қобалжыдым.
Dialogue: 0,0:24:08.01,0:24:09.56,Default,,0,0,0,,Бұл жолы мен топтық түрде шешемін.
Dialogue: 0,0:24:11.06,0:24:16.06,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
