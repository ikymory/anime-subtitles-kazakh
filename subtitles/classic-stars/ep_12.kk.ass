Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.00,0:00:06.42,Default,,0,0,0,,Мен барамын, мен сізге хабарласамын.
Dialogue: 0,0:00:12.76,0:00:13.80,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:14.84,0:00:16.55,Default,,0,0,0,,Олар не қажет болса да жасайды
Dialogue: 0,0:00:17.64,0:00:18.81,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:00:20.02,0:00:23.98,Default,,0,0,0,,♪～
Dialogue: 0,0:01:45.94,0:01:49.94,Default,,0,0,0,,～♪
Dialogue: 0,0:01:50.52,0:01:53.94,Default,,0,0,0,,(Музыканы бақылау)
Dialogue: 0,0:01:58.45,0:02:03.37,Default,,0,0,0,,Қан кету, барлық жері көгерген, кейбір сүйектердің жыртылған жерлері.
Dialogue: 0,0:02:03.45,0:02:06.79,Default,,0,0,0,,Спонтанды тыныс, пульс қалыпты
Dialogue: 0,0:02:06.87,0:02:09.38,Default,,0,0,0,,Сауығу тез болады дейді.
Dialogue: 0,0:02:09.46,0:02:13.71,Default,,0,0,0,,Мен дәрігердің мұндай физикалық дайын адамды көрмегеніне сенімдімін.
Dialogue: 0,0:02:13.80,0:02:16.84,Default,,0,0,0,,Енді тезірек оянарсың деп үміттенемін.
Dialogue: 0,0:02:16.92,0:02:18.43,Default,,0,0,0,,Мені сүйгің келе ме?
Dialogue: 0,0:02:18.51,0:02:19.76,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:02:20.26,0:02:22.81,Default,,0,0,0,,Ұйқыдағы ару болса жақсы болар еді.
Dialogue: 0,0:02:22.89,0:02:25.35,Default,,0,0,0,,Жолсерікті маған қалдырыңыз.
Dialogue: 0,0:02:25.43,0:02:29.60,Default,,0,0,0,,Балалар, сендер менің міндеттерімнен босатылғандықтан, мен одан әрі жалықтыра алмадым.
Dialogue: 0,0:02:29.69,0:02:31.19,Default,,0,0,0,,Бірақ... (Михараги) Ол оянғанша—
Dialogue: 0,0:02:31.27,0:02:33.40,Default,,0,0,0,,Сіз жай қарап отыра алмайсыз, солай ма?
Dialogue: 0,0:02:33.48,0:02:37.19,Default,,0,0,0,,Балалар, сендерде бір нәрсе істеу керек.
Dialogue: 0,0:02:38.90,0:02:40.95,Default,,0,0,0,,Иә, менің князім...
Dialogue: 0,0:02:41.57,0:02:43.49,Default,,0,0,0,,Мен мұны бәрінен де жақсы білемін
Dialogue: 0,0:02:43.99,0:02:47.79,Default,,0,0,0,,Дәл қазір ол өзін вундеркинд баладан гөрі жын сияқты сезінеді.
Dialogue: 0,0:02:47.87,0:02:50.58,Default,,0,0,0,,Олай болса, ән біткенше тоқтамаймын.
Dialogue: 0,0:02:51.54,0:02:53.38,Default,,0,0,0,,Моцартпен салыстырғанда
Dialogue: 0,0:02:53.46,0:02:56.67,Default,,0,0,0,,Бұл жер алаңсыз, расында.
Dialogue: 0,0:02:53.46,0:02:56.67,Default,,0,0,0,,(Бетховеннің ұйқысы)
Dialogue: 0,0:02:57.72,0:02:58.84,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:02:58.92,0:03:00.05,Default,,0,0,0,,Осы қарқынмен бұл сайыс болады.
Dialogue: 0,0:03:00.13,0:03:02.05,Default,,0,0,0,,Мен кете алмаймын.
Dialogue: 0,0:03:02.14,0:03:04.56,Default,,0,0,0,,Мүлдем... нақты орындауға дейін.
Dialogue: 0,0:03:05.14,0:03:06.47,Default,,0,0,0,,Бұл адам
Dialogue: 0,0:03:06.56,0:03:08.93,Default,,0,0,0,,Мал санын теңестіру үшін деп айтылды.
Dialogue: 0,0:03:09.02,0:03:11.56,Default,,0,0,0,,Сіз бұл рөлді де орындай алмайсыз ба?
Dialogue: 0,0:03:11.65,0:03:13.65,Default,,0,0,0,,Бұл жақсы мазасыздық.
Dialogue: 0,0:03:14.48,0:03:16.82,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:03:17.48,0:03:20.49,Default,,0,0,0,,Бірақ біз де бірдеңе істеуіміз керек.
Dialogue: 0,0:03:20.99,0:03:23.24,Default,,0,0,0,,Қолымыздан келгенді соңына дейін жасайық?
Dialogue: 0,0:03:25.45,0:03:26.49,Default,,0,0,0,,Иә
Dialogue: 0,0:03:27.16,0:03:30.54,Default,,0,0,0,,Олай болса, неге біз біраз уақыттан кейін бірінші рет кездесуге бармасқа?
Dialogue: 0,0:03:33.33,0:03:34.75,Default,,0,0,0,,Жолсерік…
Dialogue: 0,0:03:34.84,0:03:36.63,Default,,0,0,0,,Менің ойымша, сіз мұны істейсіз бе?
Dialogue: 0,0:03:37.13,0:03:40.47,Default,,0,0,0,,Бұл үшін көп рахмет.
Dialogue: 0,0:03:40.55,0:03:41.80,Default,,0,0,0,,Гааааа…
Dialogue: 0,0:03:41.88,0:03:43.26,Default,,0,0,0,,Мұнда...
Dialogue: 0,0:03:43.34,0:03:45.60,Default,,0,0,0,,Әдеттегідей, өтінемін.
Dialogue: 0,0:03:45.68,0:03:46.81,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:03:46.89,0:03:47.77,Default,,0,0,0,,Әдеттегі?
Dialogue: 0,0:03:47.85,0:03:48.81,Default,,0,0,0,,Сососо
Dialogue: 0,0:03:48.89,0:03:51.98,Default,,0,0,0,,Маңызды спектакльдің алдында мен шашымның ұштарын қырқып алуды мақсат етемін.
Dialogue: 0,0:03:52.73,0:03:54.56,Default,,0,0,0,,Түсіндім, Ген актер сияқты...
Dialogue: 0,0:03:54.65,0:03:58.19,Default,,0,0,0,,Генераторлық тасымалдаушы? дәл алдында
Dialogue: 0,0:03:58.28,0:03:59.99,Default,,0,0,0,,Балалар...
Dialogue: 0,0:04:00.07,0:04:03.20,Default,,0,0,0,,Ол оянбайды ма?
Dialogue: 0,0:04:03.28,0:04:05.49,Default,,0,0,0,,Спиральды Апокалипсис
Dialogue: 0,0:04:05.57,0:04:11.00,Default,,0,0,0,,Оума уақыттың мейіріміне ұшырап, күресіп, құлаған аспанға айналады.
Dialogue: 0,0:04:11.08,0:04:12.75,Default,,0,0,0,,Өлген жоқ!
Dialogue: 0,0:04:12.83,0:04:17.09,Default,,0,0,0,,Қоштасу бақытына ие болғаныңыз соншалықты күлкілі.
Dialogue: 0,0:04:17.17,0:04:19.00,Default,,0,0,0,,Пердені өз бетіңізше тартпаңыз
Dialogue: 0,0:04:19.09,0:04:22.17,Default,,0,0,0,,Сіз ұшыру дыбысын естімейінше сахнаны білмейсіз.
Dialogue: 0,0:04:24.51,0:04:26.93,Default,,0,0,0,,Мен сахнаға шыққанда
Dialogue: 0,0:04:27.01,0:04:28.43,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:29.85,0:04:32.43,Default,,0,0,0,,Мен саған ескерту жасасам да.
Dialogue: 0,0:04:32.52,0:04:33.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:33.77,0:04:35.94,Default,,0,0,0,,Жақында кездескенше~
Dialogue: 0,0:04:36.02,0:04:39.57,Default,,0,0,0,,Сот бірінші бола ма, әлде Қасқырдың келуі бірінші орында ма...
Dialogue: 0,0:04:39.65,0:04:42.28,Default,,0,0,0,,Демек, сен өлген жоқсың!
Dialogue: 0,0:04:46.95,0:04:48.58,Default,,0,0,0,,Билет ұтып алдың ба?
Dialogue: 0,0:04:48.66,0:04:51.29,Default,,0,0,0,,Иә, шынымен! Басқару Құдай
Dialogue: 0,0:04:51.37,0:04:54.29,Default,,0,0,0,,Ертең менің қайтыс болған күнім өтеді, сондықтан маған қамқорлық жасаңыз!
Dialogue: 0,0:04:54.37,0:04:57.29,Default,,0,0,0,,Қайсы, ең жақсы қайтыс болған мерейтой?
Dialogue: 0,0:04:57.38,0:04:59.80,Default,,0,0,0,,Иимон Мен сізді тікелей эфирде қолдаймын!
Dialogue: 0,0:04:59.88,0:05:02.67,Default,,0,0,0,,Бірақ ол ешқашан мектепке келмейді.
Dialogue: 0,0:05:02.76,0:05:04.80,Default,,0,0,0,,Бетховен де, Моцарт та
Dialogue: 0,0:05:04.88,0:05:06.76,Default,,0,0,0,,Мен Лист пен Шопеннен сұрағанымда,
Dialogue: 0,0:05:06.84,0:05:09.01,Default,,0,0,0,,Мен сенің оқу-жаттығу жиынында екеніңді естідім.
Dialogue: 0,0:05:09.10,0:05:11.85,Default,,0,0,0,,Жақында көреміз деп үміттенемін!
Dialogue: 0,0:05:13.31,0:05:17.52,Default,,0,0,0,,Жаңа Бетховен әлі оянбаған сияқты.
Dialogue: 0,0:05:17.60,0:05:19.52,Default,,0,0,0,,Dis=Cord пайда болғанда
Dialogue: 0,0:05:19.61,0:05:21.73,Default,,0,0,0,,Не болар екен деп ойладым.
Dialogue: 0,0:05:21.82,0:05:26.03,Default,,0,0,0,,Енді біз қауіпсізбіз, жоспарларымыз түзетілді.
Dialogue: 0,0:05:26.61,0:05:30.49,Default,,0,0,0,,Жоғарыны таңдап, төменгісін кесіңіз.
Dialogue: 0,0:05:30.58,0:05:32.79,Default,,0,0,0,,Барлығы осы.
Dialogue: 0,0:05:32.87,0:05:36.54,Default,,0,0,0,,Эволюция процесінде құрбандықтар сөзсіз.
Dialogue: 0,0:05:36.62,0:05:40.54,Default,,0,0,0,,Қош бол Гранмайстер
Dialogue: 0,0:05:44.63,0:05:45.80,Default,,0,0,0,,Сіздің әніңіз
Dialogue: 0,0:05:45.88,0:05:47.09,Default,,0,0,0,,Маған ұнайды!
Dialogue: 0,0:05:47.18,0:05:49.01,Default,,0,0,0,,Бірақ бұл маған ұнамайды.
Dialogue: 0,0:05:49.09,0:05:51.56,Default,,0,0,0,,Кек алу үшін ән айту өте жағымсыз!
Dialogue: 0,0:06:00.40,0:06:03.57,Default,,0,0,0,,Қыршынның кесірінен оны аяқтауға шыдай алмаймын!
Dialogue: 0,0:06:03.65,0:06:06.90,Default,,0,0,0,,Менің эмоциям! Оларға көретін нәрсе беріңіз!
Dialogue: 0,0:06:06.99,0:06:08.57,Default,,0,0,0,,Көзге арналған эмо!
Dialogue: 0,0:06:09.45,0:06:10.82,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:06:12.62,0:06:14.50,Default,,0,0,0,,Жоқ, әлі жоқ.
Dialogue: 0,0:06:14.58,0:06:16.41,Default,,0,0,0,,Мен мұнымен жақсы болмаймын!
Dialogue: 0,0:06:16.50,0:06:18.12,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:06:18.21,0:06:19.54,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:23.21,0:06:25.38,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:06:28.47,0:06:29.93,Default,,0,0,0,,Сонда бәрі бір сәтте бітеді.
Dialogue: 0,0:06:31.35,0:06:34.52,Default,,0,0,0,,Ей, сен ереже бұзасың ба?
Dialogue: 0,0:06:34.60,0:06:35.64,Default,,0,0,0,,Әй!
Dialogue: 0,0:06:35.72,0:06:36.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:36.73,0:06:39.65,Default,,0,0,0,,Бір адым атсам да, шуылдап қаламын.
Dialogue: 0,0:06:41.94,0:06:46.57,Default,,0,0,0,,Сен Миша деген жігітті әніңмен ұрдың.
Dialogue: 0,0:06:46.65,0:06:48.61,Default,,0,0,0,,Мен мұндай сәйкестіктердің де бар екеніне сенімдімін.
Dialogue: 0,0:06:51.12,0:06:53.41,Default,,0,0,0,,Сіздің соққыңыз жұмыс істеді.
Dialogue: 0,0:06:54.03,0:06:55.12,Default,,0,0,0,,Фу…
Dialogue: 0,0:06:58.50,0:07:00.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:02.04,0:07:03.25,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:07:03.34,0:07:05.25,Default,,0,0,0,,Маған айтпасаң да!
Dialogue: 0,0:07:06.55,0:07:08.26,Default,,0,0,0,,Менің калориям ондай емес.
Dialogue: 0,0:07:08.34,0:07:11.01,Default,,0,0,0,,Менің ал-денте! Aldent техникалық қызмет көрсету болып табылады!
Dialogue: 0,0:07:11.09,0:07:13.76,Default,,0,0,0,,Менің Allegro конфокосым!
Dialogue: 0,0:07:16.47,0:07:17.77,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:18.68,0:07:22.90,Default,,0,0,0,,Ей, тамырды толтырған жақсы, бірақ қалай?
Dialogue: 0,0:07:22.98,0:07:25.36,Default,,0,0,0,,Бір-бірімізді көптен бері көрмедік.
Dialogue: 0,0:07:25.44,0:07:28.90,Default,,0,0,0,,Сіз менің ертеңгі қойылым туралы айтқанымды тыңдап тұрсыз ба?
Dialogue: 0,0:07:32.99,0:07:35.41,Default,,0,0,0,,Дыбыс жоқ... Әйтеуір!
Dialogue: 0,0:07:36.49,0:07:37.33,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:07:40.87,0:07:42.83,Default,,0,0,0,,Мұның бәрін сіз жаздыңыз ба?
Dialogue: 0,0:07:44.42,0:07:46.59,Default,,0,0,0,,Моцарт!
Dialogue: 0,0:07:44.42,0:07:46.59,Default,,0,0,0,,Хаха...
Dialogue: 0,0:07:51.18,0:07:53.09,Default,,0,0,0,,Ммммммм!
Dialogue: 0,0:07:53.89,0:07:56.47,Default,,0,0,0,,Келу уақыты өтті.
Dialogue: 0,0:07:56.56,0:07:59.02,Default,,0,0,0,,А... Мен мұны білемін.
Dialogue: 0,0:07:59.10,0:08:00.73,Default,,0,0,0,,Мен планшетімді ұмытып қалдым...
Dialogue: 0,0:08:00.81,0:08:02.73,Default,,0,0,0,,Арнайы сынып!
Dialogue: 0,0:08:02.81,0:08:04.23,Default,,0,0,0,,Бұл емес пе?
Dialogue: 0,0:08:05.40,0:08:06.98,Default,,0,0,0,,Ушишиши…
Dialogue: 0,0:08:12.32,0:08:15.37,Default,,0,0,0,,Көрдіңіз бе, вундеркиндтер де адам баласы.
Dialogue: 0,0:08:15.45,0:08:18.62,Default,,0,0,0,,Адам болып өмір сүрмесең, күйреуің заңды.
Dialogue: 0,0:08:18.70,0:08:21.16,Default,,0,0,0,,Сонда сіз мұны істей алдыңыз ба?
Dialogue: 0,0:08:21.87,0:08:23.17,Default,,0,0,0,,Парфет!
Dialogue: 0,0:08:28.96,0:08:31.63,Default,,0,0,0,,Сонымен қатар, сіз Dis=Cord функциясын осымен жеңе аласыз.
Dialogue: 0,0:08:31.72,0:08:34.76,Default,,0,0,0,,Біз жындан жаңа мәлімет алдық.
Dialogue: 0,0:08:35.97,0:08:40.89,Default,,0,0,0,,Мектепте де, бізде де тыныштық орнады.
Dialogue: 0,0:08:40.97,0:08:44.10,Default,,0,0,0,,Біраз қозғалған болуы керек.
Dialogue: 0,0:08:44.19,0:08:45.69,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:08:45.77,0:08:48.02,Default,,0,0,0,,Мен жалғыз баламын.
Dialogue: 0,0:08:48.11,0:08:51.03,Default,,0,0,0,,Шулы, қамқор інім жоғалғанда
Dialogue: 0,0:08:51.11,0:08:52.78,Default,,0,0,0,,Мынадай нәрсе шығар
Dialogue: 0,0:08:52.86,0:08:54.57,Default,,0,0,0,,Менің інім...
Dialogue: 0,0:08:54.66,0:08:57.41,Default,,0,0,0,,Биікке шыққанымнан бас тарта алмаймын.
Dialogue: 0,0:08:58.12,0:09:02.45,Default,,0,0,0,,Мен оның мұндай әдеттен тыс бала болады деп күткен жоқпын.
Dialogue: 0,0:09:02.54,0:09:05.29,Default,,0,0,0,,Басында мені жартылай қызықтырды, бірақ...
Dialogue: 0,0:09:05.37,0:09:06.46,Default,,0,0,0,,(Ұялы телефонның діріл дыбысы)
Dialogue: 0,0:09:06.46,0:09:07.42,Default,,0,0,0,,(Ұялы телефонның діріл дыбысы)
Dialogue: 0,0:09:06.46,0:09:07.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:10.00,0:09:12.42,Default,,0,0,0,,Бетховен туралы уайымдау
Dialogue: 0,0:09:12.51,0:09:15.05,Default,,0,0,0,,Сонымен сен маған да қолымнан келгеннің бәрін істе деді.
Dialogue: 0,0:09:15.63,0:09:17.09,Default,,0,0,0,,Бұл менің бірінші рет болды.
Dialogue: 0,0:09:17.18,0:09:20.18,Default,,0,0,0,,Сахна алдында мені шақырды.
Dialogue: 0,0:09:20.76,0:09:22.98,Default,,0,0,0,,Ол Купида.
Dialogue: 0,0:09:23.48,0:09:27.06,Default,,0,0,0,,Мен танысқанымызға өте қуаныштымын...
Dialogue: 0,0:09:27.15,0:09:28.69,Default,,0,0,0,,Ашкөздік шықты
Dialogue: 0,0:09:29.56,0:09:32.15,Default,,0,0,0,,Мен сенімен көбірек ән айтқым келеді
Dialogue: 0,0:09:32.23,0:09:33.19,Default,,0,0,0,,Мен ән айта аламын
Dialogue: 0,0:09:33.28,0:09:36.99,Default,,0,0,0,,Бір аяғыңды табытқа тығысаң да, ақымақ.
Dialogue: 0,0:09:37.07,0:09:39.03,Default,,0,0,0,,Сайысқа келетіндеріңізге сенімдімін.
Dialogue: 0,0:09:39.12,0:09:39.95,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:09:41.62,0:09:43.45,Default,,0,0,0,,Мұны білмей тұрып, сіз...
Dialogue: 0,0:09:47.79,0:09:49.71,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:09:52.46,0:09:53.96,Default,,0,0,0,,(Дабыл дыбысы)
Dialogue: 0,0:09:54.05,0:09:55.55,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:09:55.63,0:09:57.09,Default,,0,0,0,,Бүгін, сайып келгенде, сайыс күні!
Dialogue: 0,0:09:57.09,0:09:57.93,Default,,0,0,0,,Бүгін, сайып келгенде, сайыс күні!
Dialogue: 0,0:09:57.09,0:09:57.93,Default,,0,0,0,,Әй!
Dialogue: 0,0:09:58.01,0:10:00.80,Default,,0,0,0,,Конкурс! Ах...
Dialogue: 0,0:10:02.18,0:10:03.89,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:10:04.39,0:10:08.31,Default,,0,0,0,,(Адамдар сөйлейді)
Dialogue: 0,0:10:16.78,0:10:21.07,Default,,0,0,0,,Кіру, тапсырысқа лотерея, костюмдер және...
Dialogue: 0,0:10:21.16,0:10:24.62,Default,,0,0,0,,Сахна артындағы адамдармен VR параметрлерін тексеріңіз.
Dialogue: 0,0:10:24.70,0:10:26.54,Default,,0,0,0,,Төртеуміз кез келген уақытта бірге баруымыз үшін.
Dialogue: 0,0:10:26.62,0:10:28.42,Default,,0,0,0,,Сізге келісім жасау керек.
Dialogue: 0,0:10:28.50,0:10:30.83,Default,,0,0,0,,Иә, мен соңына дейін берілмеймін.
Dialogue: 0,0:10:32.09,0:10:32.84,Default,,0,0,0,,(Ұялы телефонның діріл дыбысы)
Dialogue: 0,0:10:32.84,0:10:33.84,Default,,0,0,0,,(Ұялы телефонның діріл дыбысы)
Dialogue: 0,0:10:32.84,0:10:33.84,Default,,0,0,0,,Әй!
Dialogue: 0,0:10:33.84,0:10:36.01,Default,,0,0,0,,(Ұялы телефонның діріл дыбысы)
Dialogue: 0,0:10:36.09,0:10:37.84,Default,,0,0,0,,Михараги мырзадан.
Dialogue: 0,0:10:37.92,0:10:38.93,Default,,0,0,0,,Иә
Dialogue: 0,0:10:39.89,0:10:40.72,Default,,0,0,0,,Не!
Dialogue: 0,0:10:40.80,0:10:42.10,Default,,0,0,0,,Ол жоғалып кетті ме?
Dialogue: 0,0:10:42.18,0:10:43.22,Default,,0,0,0,,А...
Dialogue: 0,0:10:43.31,0:10:45.18,Default,,0,0,0,,Мен оның кеткеніне сене алар емеспін...
Dialogue: 0,0:10:45.27,0:10:46.10,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:10:47.64,0:10:48.85,Default,,0,0,0,,Әй!
Dialogue: 0,0:10:49.52,0:10:52.44,Default,,0,0,0,,Екеуің алдымен сахнаға оралуларың керек!
Dialogue: 0,0:10:56.19,0:10:58.11,Default,,0,0,0,,Мұғалім, ол ше?
Dialogue: 0,0:10:58.20,0:11:00.20,Default,,0,0,0,,Көріп отырғаныңыздай...
Dialogue: 0,0:11:01.53,0:11:03.62,Default,,0,0,0,,А... Сіз жасырынып шықтыңыз ба?
Dialogue: 0,0:11:03.70,0:11:04.70,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:11:04.79,0:11:06.24,Default,,0,0,0,,Бұл екінші қабатта ма?
Dialogue: 0,0:11:07.70,0:11:09.75,Default,,0,0,0,,Хмм... Қарғыс атсын!
Dialogue: 0,0:11:10.54,0:11:13.75,Default,,0,0,0,,Мен өтетін жерге бара жатқаныма сене алар емеспін!
Dialogue: 0,0:11:15.96,0:11:18.51,Default,,0,0,0,,Енді ұтыс ойынын ойнайық!
Dialogue: 0,0:11:22.22,0:11:24.14,Default,,0,0,0,,Тоғызыншы...
Dialogue: 0,0:11:24.22,0:11:27.39,Default,,0,0,0,,Қуаныш айқайы бүкіл әлемде жаңғырық.
Dialogue: 0,0:11:28.02,0:11:30.14,Default,,0,0,0,,Жарайды, бұл соңғы!
Dialogue: 0,0:11:30.23,0:11:32.10,Default,,0,0,0,,Сіз біздің қасымыздасыз ба?
Dialogue: 0,0:11:32.19,0:11:35.15,Default,,0,0,0,,Алдын ала жарыстар сияқты бұлыңғыр болады деп шешілді.
Dialogue: 0,0:11:35.23,0:11:38.53,Default,,0,0,0,,Жарайды, оған дейін, төртеуміз бірге болғанша.
Dialogue: 0,0:11:38.61,0:11:40.70,Default,,0,0,0,,Біз сенеміз және күтеміз.
Dialogue: 0,0:11:40.78,0:11:44.28,Default,,0,0,0,,Иә, мен саған шынайы келбетін көрсетемін.
Dialogue: 0,0:11:45.12,0:11:50.54,Default,,0,0,0,,Аян кітабының соңғы беті комедия ма, әлде трагедия ма?
Dialogue: 0,0:11:50.62,0:11:53.29,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:11:56.13,0:11:59.34,Default,,0,0,0,,Дүние жүзіндегі барлық адамдар, күткеніңізге рахмет!
Dialogue: 0,0:11:59.42,0:12:01.97,Default,,0,0,0,,Сайыстың финалы басталады
Dialogue: 0,0:12:02.05,0:12:05.14,Default,,0,0,0,,Сезім дауылы осы бақытсыз аспанды ұшырды.
Dialogue: 0,0:12:05.22,0:12:06.93,Default,,0,0,0,,Ләззат алыңыз!
Dialogue: 0,0:12:07.01,0:12:09.68,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:12:10.93,0:12:13.98,Default,,0,0,0,,Құдай, өтінемін, мені тыңдай аласың ба?
Dialogue: 0,0:12:14.06,0:12:16.82,Default,,0,0,0,,Dis=Cord жеңеді деп үміттенемін.
Dialogue: 0,0:12:16.90,0:12:19.82,Default,,0,0,0,,Мен ақшаны үнемдеуге күш салдым, бұл өте жақсы.
Dialogue: 0,0:12:19.90,0:12:22.95,Default,,0,0,0,,Әй, тезірек барайық. Лотерея өтіп кеткен сияқты.
Dialogue: 0,0:12:23.03,0:12:25.07,Default,,0,0,0,,Эй (Ер/Әйел) Иә?
Dialogue: 0,0:12:25.16,0:12:29.08,Default,,0,0,0,,Сайыс қайда өтеді?
Dialogue: 0,0:12:29.16,0:12:33.08,Default,,0,0,0,,Анашым!
Dialogue: 0,0:12:29.16,0:12:33.08,Default,,0,0,0,,(Әйелдің айғайы)
Dialogue: 0,0:12:33.17,0:12:35.58,Default,,0,0,0,,Неге қашып бара жатырсың?
Dialogue: 0,0:12:35.67,0:12:38.09,Default,,0,0,0,,Мен сізден өтілетін орынды айтуыңызды өтіндім...
Dialogue: 0,0:12:39.13,0:12:40.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:41.05,0:12:43.51,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:43.59,0:12:44.72,Default,,0,0,0,,Қияметсіз...
Dialogue: 0,0:12:44.80,0:12:48.47,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:12:48.56,0:12:52.48,Default,,0,0,0,,(орында музыка)
Dialogue: 0,0:12:52.56,0:12:54.39,Default,,0,0,0,,Уау... (Сайысқа қатысушылар) Ой...
Dialogue: 0,0:12:55.06,0:12:56.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:56.56,0:12:59.32,Default,,0,0,0,,Ауа-райы ашық ауада болудың әлсіз жері.
Dialogue: 0,0:12:59.40,0:13:02.24,Default,,0,0,0,,Ол күшеймейді деп үміттенемін.
Dialogue: 0,0:13:02.32,0:13:06.32,Default,,0,0,0,,Бірақ сахна қойылса да, әртістер сапқа тұрмаса...
Dialogue: 0,0:13:06.41,0:13:08.12,Default,,0,0,0,,Мен келемін...
Dialogue: 0,0:13:08.20,0:13:10.74,Default,,0,0,0,,Олардың екеуі де сөзсіз
Dialogue: 0,0:13:11.70,0:13:14.25,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:13:14.33,0:13:17.75,Default,,0,0,0,,Хаха...
Dialogue: 0,0:13:17.83,0:13:19.75,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:13:19.84,0:13:23.51,Default,,0,0,0,,Мен оянсам, мен ояндым, неге мені алып кетуімді тыныш күтпейсіз!
Dialogue: 0,0:13:23.59,0:13:27.01,Default,,0,0,0,,Жоқ, ол басынан солай болған!
Dialogue: 0,0:13:27.09,0:13:28.51,Default,,0,0,0,,Сіз мені үнемі тітіркендіретінсіз
Dialogue: 0,0:13:28.60,0:13:31.64,Default,,0,0,0,,Әрқашан ойланбастан қиындық туғызу!
Dialogue: 0,0:13:31.72,0:13:33.14,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:13:39.77,0:13:42.78,Default,,0,0,0,,Бұл күлкілі. Қалаған жерге барыңыз!
Dialogue: 0,0:13:42.86,0:13:44.78,Default,,0,0,0,,Мені енді елеме
Dialogue: 0,0:13:44.86,0:13:46.03,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:47.20,0:13:48.41,Default,,0,0,0,,Қарғыс атсын... мм!
Dialogue: 0,0:13:48.49,0:13:50.12,Default,,0,0,0,,Хаха...
Dialogue: 0,0:13:55.00,0:13:56.67,Default,,0,0,0,,(Көрермендердің айқайы)
Dialogue: 0,0:13:56.75,0:13:58.75,Default,,0,0,0,,Сіз осылай ән айта аласыз ба?
Dialogue: 0,0:13:58.83,0:14:01.25,Default,,0,0,0,,Жаңбыр мен күн күркіреп, Әнші дауысымыз
Dialogue: 0,0:14:01.34,0:14:04.46,Default,,0,0,0,,Көрермендерге жететінін білмесем де.
Dialogue: 0,0:14:04.55,0:14:06.09,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:06.17,0:14:07.26,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:14:07.84,0:14:11.26,Default,,0,0,0,,Мен бұл найзағайдан уақытша үзіліс сұраймын!
Dialogue: 0,0:14:11.35,0:14:12.18,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:14:12.76,0:14:15.02,Default,,0,0,0,,Уақыт ұту үшін қолыңыздан келгеннің бәрін пайдаланыңыз!
Dialogue: 0,0:14:15.10,0:14:17.52,Default,,0,0,0,,Насакенай
Dialogue: 0,0:14:17.60,0:14:21.90,Default,,0,0,0,,Сахна әртістері ауа-райынан жиі шошып кетеді.
Dialogue: 0,0:14:22.52,0:14:25.57,Default,,0,0,0,,Әлсіз құстар ешқашан ұшпайды
Dialogue: 0,0:14:25.65,0:14:28.53,Default,,0,0,0,,Жаңбыр жауып қанатыңды атып өлсін.
Dialogue: 0,0:14:28.61,0:14:31.32,Default,,0,0,0,,Неліктен аудиторияны дәлелдеуге тырысу арқылы күту керек?
Dialogue: 0,0:14:31.41,0:14:32.58,Default,,0,0,0,,Әкең сұраса
Dialogue: 0,0:14:32.66,0:14:33.91,Default,,0,0,0,,Сіз не айтар едіңіз?
Dialogue: 0,0:14:33.99,0:14:35.66,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:35.75,0:14:41.54,Default,,0,0,0,,Сол уақыт, сол жер және жиналғандар
Dialogue: 0,0:14:41.63,0:14:44.67,Default,,0,0,0,,Бәрі де тағдырдың еншісінде
Dialogue: 0,0:14:46.55,0:14:48.97,Default,,0,0,0,,Келесі - № 9 жазба
Dialogue: 0,0:14:49.05,0:14:52.18,Default,,0,0,0,,Dis=Cord - жеңіске үміткер!
Dialogue: 0,0:14:52.26,0:14:54.56,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:15:09.53,0:15:10.36,Default,,0,0,0,,оның әні
Dialogue: 0,0:15:10.45,0:15:12.91,Default,,0,0,0,,Мен сізден тағы да сұрағым келді, бірақ...
Dialogue: 0,0:15:14.53,0:15:21.00,Default,,0,0,0,,♪ О, құдай... бұл күнә
Dialogue: 0,0:15:21.08,0:15:28.21,Default,,0,0,0,,♪ Сізден кешірім сұрайын деген ойым жоқ!
Dialogue: 0,0:15:28.30,0:15:33.09,Default,,0,0,0,,♪ …Керемет
Dialogue: 0,0:15:33.18,0:15:37.18,Default,,0,0,0,,♪ «Қарсылық диапазоны»
Dialogue: 0,0:15:46.69,0:15:50.11,Default,,0,0,0,,♪ Қап-қара құсу сияқты
Dialogue: 0,0:15:50.20,0:15:53.07,Default,,0,0,0,,♪ Адамдардың өлімге әкелетін күнәлары
Dialogue: 0,0:15:53.16,0:15:57.12,Default,,0,0,0,,♪ Құдай емес, адамдар соттайды...
Dialogue: 0,0:15:57.20,0:16:00.25,Default,,0,0,0,,♪ Балға
Dialogue: 0,0:16:00.33,0:16:02.37,Default,,0,0,0,,♪ Музыка бар ма?
Dialogue: 0,0:16:02.46,0:16:03.58,Default,,0,0,0,,♪ бәрін бұзады
Dialogue: 0,0:16:03.67,0:16:05.34,Default,,0,0,0,,♪ Музыка бар ма?
Dialogue: 0,0:16:05.42,0:16:07.00,Default,,0,0,0,,♪ қарғыс атсын
Dialogue: 0,0:16:07.09,0:16:13.01,Default,,0,0,0,,♪ Әлем әрқашан күрт өзгеріп отырады
Dialogue: 0,0:16:13.09,0:16:16.55,Default,,0,0,0,,♪ Жүр, қалтырап!
Dialogue: 0,0:16:16.64,0:16:20.43,Default,,0,0,0,,♪ Музыканың киелі ордасы
Dialogue: 0,0:16:20.52,0:16:26.02,Default,,0,0,0,,♪ Жоғалтудан қорықпа
Dialogue: 0,0:16:26.11,0:16:29.11,Default,,0,0,0,,♪ Енді орнымыздан тұрайық
Dialogue: 0,0:16:29.73,0:16:33.49,Default,,0,0,0,,♪ Мен оның дистопияға айналуына жол бермеймін
Dialogue: 0,0:16:33.57,0:16:38.70,Default,,0,0,0,,♪ Өлең болып жалын болып...
Dialogue: 0,0:16:38.79,0:16:43.67,Default,,0,0,0,,♪ Оған сеніңіз.
Dialogue: 0,0:16:45.25,0:16:47.92,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:16:48.00,0:16:49.13,Default,,0,0,0,,Я...
Dialogue: 0,0:16:50.71,0:16:51.92,Default,,0,0,0,,Я...
Dialogue: 0,0:16:52.84,0:16:53.93,Default,,0,0,0,,Я...
Dialogue: 0,0:16:54.01,0:16:57.35,Default,,0,0,0,,№9 жазба Dis=Cord болды!
Dialogue: 0,0:16:57.43,0:16:59.68,Default,,0,0,0,,Содан кейін №10 жазба
Dialogue: 0,0:16:59.76,0:17:01.68,Default,,0,0,0,,Ұлы Мейстер!
Dialogue: 0,0:17:01.77,0:17:03.52,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:17:03.60,0:17:05.52,Default,,0,0,0,,Мен оны уақытында орындамадым ...
Dialogue: 0,0:17:05.60,0:17:09.02,Default,,0,0,0,,Диск＝Сым дискі＝Сым дискі＝Сым…
Dialogue: 0,0:17:09.11,0:17:13.32,Default,,0,0,0,,Ах... Мм, келесі жазба...
Dialogue: 0,0:17:13.95,0:17:15.07,Default,,0,0,0,,Аха…
Dialogue: 0,0:17:16.41,0:17:18.28,Default,,0,0,0,,Бұл не? Бұл...
Dialogue: 0,0:17:19.08,0:17:20.62,Default,,0,0,0,,Тоқтатқыш…
Dialogue: 0,0:17:20.70,0:17:21.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:22.25,0:17:26.37,Default,,0,0,0,,Сахнаның ілгерілеуі аудитория тым толқып кеткендіктен тоқтайды.
Dialogue: 0,0:17:26.46,0:17:28.46,Default,,0,0,0,,Үлкен театрлар, Бродвей және т.б.
Dialogue: 0,0:17:28.54,0:17:29.96,Default,,0,0,0,,Бұл сирек кездеседі
Dialogue: 0,0:17:32.96,0:17:36.84,Default,,0,0,0,,Сахна әртістері уақытты осылай сатып алады, балапан.
Dialogue: 0,0:17:37.72,0:17:38.89,Default,,0,0,0,,Ағай...
Dialogue: 0,0:17:42.06,0:17:46.48,Default,,0,0,0,,Ха... Мен тез баруым керек...
Dialogue: 0,0:17:46.56,0:17:51.69,Default,,0,0,0,,Хаха...
Dialogue: 0,0:17:51.78,0:17:52.94,Default,,0,0,0,,Бетховен!
Dialogue: 0,0:17:53.03,0:17:54.82,Default,,0,0,0,,Ах… Ммм…
Dialogue: 0,0:18:08.42,0:18:09.83,Default,,0,0,0,,Ара… (Бетховен) мо…
Dialogue: 0,0:18:09.92,0:18:11.84,Default,,0,0,0,,Бетховен! (Бетховен) Моцарт!
Dialogue: 0,0:18:16.97,0:18:18.34,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:16.97,0:18:18.34,Default,,0,0,0,,(күн күркіреуі)
Dialogue: 0,0:18:23.26,0:18:24.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:37.11,0:18:38.78,Default,,0,0,0,,Ай…
Dialogue: 0,0:18:47.33,0:18:50.25,Default,,0,0,0,,Бол... Бол...
Dialogue: 0,0:18:51.13,0:18:53.55,Default,,0,0,0,,Бетховен!
Dialogue: 0,0:19:08.77,0:19:11.94,Default,,0,0,0,,Мен не істеп едім...
Dialogue: 0,0:19:12.61,0:19:14.61,Default,,0,0,0,,Айқайлап сегізді ұр.
Dialogue: 0,0:19:15.53,0:19:17.44,Default,,0,0,0,,Мұның бәрі ұрыс туралы болды.
Dialogue: 0,0:19:18.40,0:19:20.82,Default,,0,0,0,,Себебі мен саған үнемі ренжідім.
Dialogue: 0,0:19:21.53,0:19:25.74,Default,,0,0,0,,Жақсы орындасаң, ән салатын дауысың керемет болады.
Dialogue: 0,0:19:25.83,0:19:28.25,Default,,0,0,0,,Мен нені мақтадым, нені мақтадым
Dialogue: 0,0:19:29.00,0:19:31.46,Default,,0,0,0,,Бірде-бір жылы сөз айтқан жоқпын.
Dialogue: 0,0:19:32.17,0:19:33.79,Default,,0,0,0,,Барлығы 1965 жылғы жазға барып тіреледі
Dialogue: 0,0:19:33.88,0:19:36.38,Default,,0,0,0,,Сенің қасымда болуың үйреншікті жағдайға айналды.
Dialogue: 0,0:19:36.46,0:19:37.88,Default,,0,0,0,,Мойындауды қаламау...
Dialogue: 0,0:19:40.51,0:19:43.64,Default,,0,0,0,,Ол байқауда бірінші орынды алуы керек емес пе еді?
Dialogue: 0,0:19:43.72,0:19:47.35,Default,,0,0,0,,Сенсіз әніміз басталмайды.
Dialogue: 0,0:19:47.43,0:19:48.93,Default,,0,0,0,,Сенсіз
Dialogue: 0,0:19:49.02,0:19:50.44,Default,,0,0,0,,Егер бұл сіз болмасаңыз!
Dialogue: 0,0:19:50.52,0:19:51.85,Default,,0,0,0,,Барма!
Dialogue: 0,0:19:51.94,0:19:53.81,Default,,0,0,0,,Мені тастама!
Dialogue: 0,0:19:55.77,0:19:57.40,Default,,0,0,0,,А...
Dialogue: 0,0:19:58.53,0:19:59.90,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:20:01.57,0:20:05.24,Default,,0,0,0,,Менің тағдырым...
Dialogue: 0,0:20:12.00,0:20:13.92,Default,,0,0,0,,Әй!
Dialogue: 0,0:20:26.18,0:20:30.22,Default,,0,0,0,,Бұл жұмыс істеді, сіздің тікелей
Dialogue: 0,0:20:32.48,0:20:33.90,Default,,0,0,0,,Бетховен…
Dialogue: 0,0:20:35.15,0:20:37.98,Default,,0,0,0,,Хехе, «менің тағдырым»?
Dialogue: 0,0:20:38.07,0:20:39.44,Default,,0,0,0,,Жаман емес.
Dialogue: 0,0:20:39.53,0:20:41.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:41.11,0:20:42.45,Default,,0,0,0,,Куу! (Бетховен) О!
Dialogue: 0,0:20:42.53,0:20:46.70,Default,,0,0,0,,Гах... Итте... Ей, ауырып жатырсың!
Dialogue: 0,0:20:46.78,0:20:48.45,Default,,0,0,0,,Ол жарылған!
Dialogue: 0,0:20:49.37,0:20:51.04,Default,,0,0,0,,Сіз...
Dialogue: 0,0:20:51.12,0:20:54.96,Default,,0,0,0,,Біз үшін қаншалықты алаңдауыңыз керек?
Dialogue: 0,0:20:55.04,0:20:56.21,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:20:57.34,0:21:01.17,Default,,0,0,0,,Сен, қара нәсілді жексұрын!
Dialogue: 0,0:21:02.38,0:21:03.63,Default,,0,0,0,,Иә
Dialogue: 0,0:21:09.22,0:21:11.98,Default,,0,0,0,,Мен сенің ырғағыңды естимін
Dialogue: 0,0:21:12.06,0:21:13.98,Default,,0,0,0,,Таримеда
Dialogue: 0,0:21:14.94,0:21:16.02,Default,,0,0,0,,Фу…
Dialogue: 0,0:21:16.10,0:21:18.44,Default,,0,0,0,,Мынау... Маған қиналдым, Миша мырза.
Dialogue: 0,0:21:19.07,0:21:20.61,Default,,0,0,0,,Біраз…
Dialogue: 0,0:21:20.69,0:21:21.78,Default,,0,0,0,,Тоқтатыңыз...
Dialogue: 0,0:21:21.86,0:21:22.90,Default,,0,0,0,,Ах! (Миша) Эй!
Dialogue: 0,0:21:22.99,0:21:24.57,Default,,0,0,0,,Сіз бір жерде тыңдап жатырсыз ба?
Dialogue: 0,0:21:24.65,0:21:26.45,Default,,0,0,0,,Сіз мұны естіген болуыңыз керек. Сіз естіген болуыңыз керек.
Dialogue: 0,0:21:26.53,0:21:28.12,Default,,0,0,0,,Жоқ, қайда болсаңыз да тыңдаңыз!
Dialogue: 0,0:21:28.20,0:21:29.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:29.70,0:21:31.58,Default,,0,0,0,,Бұл Гран-при жеңімпазы
Dialogue: 0,0:21:31.66,0:21:34.12,Default,,0,0,0,,Маған жалғыз қорлық берген саған
Dialogue: 0,0:21:34.21,0:21:35.46,Default,,0,0,0,,Бұл соғыс жариялау!
Dialogue: 0,0:21:35.54,0:21:38.25,Default,,0,0,0,,Мұрын сындыруды асыға күт!
Dialogue: 0,0:21:38.33,0:21:42.13,Default,,0,0,0,,Ол міндетті түрде мұз үстінде...
Dialogue: 0,0:21:43.72,0:21:44.63,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:21:44.72,0:21:46.13,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:53.06,0:21:54.06,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:54.93,0:21:58.94,Default,,0,0,0,,♪～
Dialogue: 0,0:23:19.94,0:23:24.86,Default,,0,0,0,,～♪
Dialogue: 0,0:23:36.20,0:23:39.04,Default,,0,0,0,,Келесі жолы «ЖҰЛДЫЗДАР ӘУЕНІ»
Dialogue: 0,0:23:40.54,0:23:46.54,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory