Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.37,0:00:05.92,Default,,0,0,0,,♪ Дүние жүзіндегі бірінші жұлдыз
Dialogue: 0,0:00:06.59,0:00:08.17,Default,,0,0,0,,♪ Ұшу ♪ Аспанда
Dialogue: 0,0:00:08.25,0:00:10.21,Default,,0,0,0,,♪ Фортеде
Dialogue: 0,0:00:10.30,0:00:12.09,Default,,0,0,0,,♪ Ән сал ♪ Ей, жел
Dialogue: 0,0:00:12.17,0:00:13.88,Default,,0,0,0,,♪ Жақсыға дейін
Dialogue: 0,0:00:13.97,0:00:16.14,Default,,0,0,0,,♪ Мақтанышпен
Dialogue: 0,0:00:16.76,0:00:17.43,Default,,0,0,0,,♪ Мүмкін емес нәрсені қара
Dialogue: 0,0:00:17.43,0:00:20.81,Default,,0,0,0,,♪ Мүмкін емес нәрсені қара
Dialogue: 0,0:00:17.43,0:00:20.81,Default,,0,0,0,,Суасты кемесі ме?
Dialogue: 0,0:00:20.81,0:00:21.43,Default,,0,0,0,,♪ Мүмкін емес нәрсені қара
Dialogue: 0,0:00:22.35,0:00:25.19,Default,,0,0,0,,Не? VR жоғалып кетті ме?
Dialogue: 0,0:00:25.27,0:00:27.40,Default,,0,0,0,,Бұл мәселе бірінші рет пайда болды ма?
Dialogue: 0,0:00:27.48,0:00:29.86,Default,,0,0,0,,Жоқ, менің эмо тым толқып тұр
Dialogue: 0,0:00:29.94,0:00:31.53,Default,,0,0,0,,Ажыратқыш істен шықты...
Dialogue: 0,0:00:31.61,0:00:32.78,Default,,0,0,0,,Егер ақаулық болмаса
Dialogue: 0,0:00:32.86,0:00:37.16,Default,,0,0,0,,Ажыратушы ынталы эмоның әсерінен құлап кеткен сияқты емес.
Dialogue: 0,0:00:37.24,0:00:40.08,Default,,0,0,0,,Керісінше болуы мүмкін.
Dialogue: 0,0:00:40.16,0:00:42.58,Default,,0,0,0,,Біреудің эмосы мен ойлағаннан да нашар...
Dialogue: 0,0:00:42.66,0:00:43.83,Default,,0,0,0,,Бұл менің кінәм (Мибараки) Иә?
Dialogue: 0,0:00:43.91,0:00:45.00,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:48.34,0:00:49.17,Default,,0,0,0,,Неге... (Бетховен) А...
Dialogue: 0,0:00:49.25,0:00:50.34,Default,,0,0,0,,Бетховен!
Dialogue: 0,0:00:58.14,0:00:59.31,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:01:07.98,0:01:11.94,Default,,0,0,0,,♪～
Dialogue: 0,0:02:33.94,0:02:37.95,Default,,0,0,0,,～♪
Dialogue: 0,0:02:38.03,0:02:38.53,Default,,0,0,0,,(душ дыбысы)
Dialogue: 0,0:02:38.53,0:02:39.82,Default,,0,0,0,,(душ дыбысы)
Dialogue: 0,0:02:38.53,0:02:39.82,Default,,0,0,0,,Негізгі жарысқа дейін
Dialogue: 0,0:02:39.82,0:02:39.91,Default,,0,0,0,,(душ дыбысы)
Dialogue: 0,0:02:39.91,0:02:41.70,Default,,0,0,0,,(душ дыбысы)
Dialogue: 0,0:02:39.91,0:02:41.70,Default,,0,0,0,,Бір апта ғана қалды
Dialogue: 0,0:02:41.78,0:02:43.37,Default,,0,0,0,,Моцарттікі жоқ
Dialogue: 0,0:02:43.45,0:02:45.70,Default,,0,0,0,,Тұрақты жүрегімнің өзі тебіренді.
Dialogue: 0,0:02:45.79,0:02:47.16,Default,,0,0,0,,Бұл туралы
Dialogue: 0,0:02:47.25,0:02:49.58,Default,,0,0,0,,Біз ештеңе айта алмасақ та,
Dialogue: 0,0:02:49.67,0:02:52.04,Default,,0,0,0,,Дайындықсыз және дайындықсыз
Dialogue: 0,0:02:52.13,0:02:54.59,Default,,0,0,0,,Dis=Cord-пен тікелей қарсылық.
Dialogue: 0,0:02:54.67,0:02:56.88,Default,,0,0,0,,Сахна мен Кошиен ғана емес
Dialogue: 0,0:02:56.96,0:02:59.72,Default,,0,0,0,,Сайыста құбыжықтар да жасырынып жүр.
Dialogue: 0,0:02:59.80,0:03:01.51,Default,,0,0,0,,Ахаха мен айта аламын
Dialogue: 0,0:03:01.59,0:03:03.05,Default,,0,0,0,,Маңызды тамақ ішетін уақыт келді...
Dialogue: 0,0:03:03.14,0:03:07.06,Default,,0,0,0,,Ей, содан бері ойланып жүрмін.
Dialogue: 0,0:03:07.14,0:03:09.44,Default,,0,0,0,,Моцарт сол жігіт туралы айтып тұрған.
Dialogue: 0,0:03:09.52,0:03:12.02,Default,,0,0,0,,Оны «Бетховен» деп атаған...
Dialogue: 0,0:03:12.52,0:03:13.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:14.02,0:03:15.65,Default,,0,0,0,,Тіпті бізден сұрамай-ақ
Dialogue: 0,0:03:15.73,0:03:18.53,Default,,0,0,0,,Сіз дұрыс жауапқа өз бетіңізше жеткен сияқтысыз.
Dialogue: 0,0:03:18.61,0:03:20.40,Default,,0,0,0,,Ол Бетховен де
Dialogue: 0,0:03:20.49,0:03:23.24,Default,,0,0,0,,Сыйлық сіз мектепке келмес бұрын отырғызылған.
Dialogue: 0,0:03:23.32,0:03:26.33,Default,,0,0,0,,Сонымен, басқа Бетховен
Dialogue: 0,0:03:27.45,0:03:29.00,Default,,0,0,0,,Мен...
Dialogue: 0,0:03:30.41,0:03:33.21,Default,,0,0,0,,Міне, мен солай ойладым.
Dialogue: 0,0:03:34.42,0:03:36.75,Default,,0,0,0,,Сол күні мен емес
Dialogue: 0,0:03:36.84,0:03:39.92,Default,,0,0,0,,Менің артымнан біреу қарап тұрғанына сенімдімін...
Dialogue: 0,0:03:44.09,0:03:45.30,Default,,0,0,0,,(Бетховеннің күрсінуі)
Dialogue: 0,0:03:45.80,0:03:46.64,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:50.89,0:03:53.65,Default,,0,0,0,,Мен не болғанын білмеймін, бірақ
Dialogue: 0,0:03:53.73,0:03:57.11,Default,,0,0,0,,Шашымды артқа қайырып алға жылжи аламын ба?
Dialogue: 0,0:04:04.87,0:04:07.79,Default,,0,0,0,,Уау, Моцарт тоз-тоз болып қалды.
Dialogue: 0,0:04:07.87,0:04:11.79,Default,,0,0,0,,Осындай жансыз күймен басты шайқаста бізбен бәсекеге түсе аласың ба?
Dialogue: 0,0:04:12.41,0:04:15.63,Default,,0,0,0,,Өлім тек ақырет дегенді білдірмейді
Dialogue: 0,0:04:15.71,0:04:20.05,Default,,0,0,0,,Бізді кейінгі ұрпақпен байланыстыратын туу рәсімдері
Dialogue: 0,0:04:20.13,0:04:21.17,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:21.26,0:04:24.39,Default,,0,0,0,,Мен Виваның не айтып тұрғанын әлі түсінбеймін.
Dialogue: 0,0:04:24.47,0:04:27.97,Default,,0,0,0,,Сенің жұмсақ сезімдерің пышақ
Dialogue: 0,0:04:28.06,0:04:30.31,Default,,0,0,0,,Оны бәрінен де ренжітіңіз
Dialogue: 0,0:04:33.14,0:04:34.98,Default,,0,0,0,,Енді Л тергеу мәліметтерінің маған тарағанын түсінгеннен кейін,
Dialogue: 0,0:04:35.06,0:04:37.36,Default,,0,0,0,,Қанша қан төгілсе де
Dialogue: 0,0:04:37.44,0:04:40.07,Default,,0,0,0,,Сахнадан осылай түссең...
Dialogue: 0,0:04:40.15,0:04:42.49,Default,,0,0,0,,Таң қаларлықтай суық.
Dialogue: 0,0:04:42.57,0:04:44.49,Default,,0,0,0,,Айтылатын сөздер қандай?
Dialogue: 0,0:04:44.57,0:04:47.70,Default,,0,0,0,,Күтпеген жерден белгісіз және қарама-қайшы
Dialogue: 0,0:04:47.78,0:04:50.87,Default,,0,0,0,,Уақыт ағымы қайтымсыз
Dialogue: 0,0:04:50.95,0:04:53.21,Default,,0,0,0,,Бірде мен жүгіре бастадым
Dialogue: 0,0:04:53.29,0:04:57.00,Default,,0,0,0,,Біз де бір орында тұра алмаймыз
Dialogue: 0,0:04:59.29,0:05:01.92,Default,,0,0,0,,Тұр!
Dialogue: 0,0:05:02.01,0:05:03.42,Default,,0,0,0,,Біз тез әрекет етуіміз керек
Dialogue: 0,0:05:06.43,0:05:08.72,Default,,0,0,0,,Ұнамайтын жігіт болсам да, ұнатпайтын да.
Dialogue: 0,0:05:08.80,0:05:10.22,Default,,0,0,0,,Тағы да сол жігіт
Dialogue: 0,0:05:11.06,0:05:14.73,Default,,0,0,0,,Ол мені жаңа жолға түсірген жалғыз адам.
Dialogue: 0,0:05:14.81,0:05:19.48,Default,,0,0,0,,Сіз сабаққа қатысамын дедіңіз, бірақ бүгін рұқсатсыз келмейсіз бе?
Dialogue: 0,0:05:19.57,0:05:20.94,Default,,0,0,0,,Қазірдің өзінде үшінші күн.
Dialogue: 0,0:05:21.03,0:05:21.86,Default,,0,0,0,,Ұстаз!
Dialogue: 0,0:05:21.94,0:05:23.03,Default,,0,0,0,,Иә? (Мұғалім) Ой... бұл не?
Dialogue: 0,0:05:23.11,0:05:26.49,Default,,0,0,0,,Менің басым айналып, өзімді жақсы сезінбеймін.
Dialogue: 0,0:05:26.57,0:05:30.12,Default,,0,0,0,,Кешіріңіз, сабақ жаңа басталды, бірақ мен сізді ертерек жіберуге рұқсат етемін.
Dialogue: 0,0:05:30.20,0:05:31.99,Default,,0,0,0,,А-а, мен...
Dialogue: 0,0:05:32.58,0:05:35.04,Default,,0,0,0,,Денеңізді аздап қозғалтып, сергек болыңыз.
Dialogue: 0,0:05:35.12,0:05:38.21,Default,,0,0,0,,Мен қолымнан келгеннің бәрін істеуім керек!
Dialogue: 0,0:05:41.21,0:05:45.01,Default,,0,0,0,,Толқу, қуаныш, шаттық...
Dialogue: 0,0:05:45.09,0:05:49.89,Default,,0,0,0,,Әртүрлі эмоциялар талданатын және сандық өлшемдері бар дүние
Dialogue: 0,0:05:49.97,0:05:53.77,Default,,0,0,0,,Ол EP эмоционалды нүкте деп аталады.
Dialogue: 0,0:05:53.85,0:05:55.60,Default,,0,0,0,,Анықталған EP негізінде
Dialogue: 0,0:05:55.68,0:05:59.56,Default,,0,0,0,,Көрнекілік үшін арнайы құрал-жабдықтар әзірленді
Dialogue: 0,0:05:59.65,0:06:03.48,Default,,0,0,0,,Адамдардың эмоциясы көрінді
Dialogue: 0,0:06:04.74,0:06:07.82,Default,,0,0,0,,Күшті және эмоционалдырақ
Dialogue: 0,0:06:07.91,0:06:10.78,Default,,0,0,0,,Әлемнің ережелері Күштілердің анықтамасы өзгерді
Dialogue: 0,0:06:10.87,0:06:14.50,Default,,0,0,0,,Осы бейбіт, мәдени соғысқа барлық ұлттар бірігеді.
Dialogue: 0,0:06:14.58,0:06:16.79,Default,,0,0,0,,ауыстырылады
Dialogue: 0,0:06:16.87,0:06:19.79,Default,,0,0,0,,Жапония эмоционалды мәдениеттің қайнар көзі ретінде
Dialogue: 0,0:06:19.88,0:06:22.59,Default,,0,0,0,,Жаңадан құрылған Академия қаласы
Dialogue: 0,0:06:22.67,0:06:26.05,Default,,0,0,0,,Орталықта жеке Глория академиясы орналасқан.
Dialogue: 0,0:06:26.13,0:06:29.05,Default,,0,0,0,,Солай емес пе? Михараги мырза
Dialogue: 0,0:06:29.13,0:06:30.84,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:06:30.93,0:06:33.81,Default,,0,0,0,,Мен оны естігеніме біраз уақыт өткен сияқты.
Dialogue: 0,0:06:33.89,0:06:37.02,Default,,0,0,0,,Менің есімде қалғанына сенімдімін.
Dialogue: 0,0:06:37.10,0:06:38.23,Default,,0,0,0,,Хмм…
Dialogue: 0,0:06:38.31,0:06:39.81,Default,,0,0,0,,Моцарт – эйс
Dialogue: 0,0:06:39.90,0:06:41.86,Default,,0,0,0,,Модуляцияны тудырса да.
Dialogue: 0,0:06:41.94,0:06:43.82,Default,,0,0,0,,Бет-әлпетің мен екпінің—
Dialogue: 0,0:06:43.94,0:06:45.82,Default,,0,0,0,,Ендеше, әдепсіздік қайда жасайды.
Dialogue: 0,0:06:45.90,0:06:48.90,Default,,0,0,0,,Ұят болғаны үшін кешірім сұраймын.
Dialogue: 0,0:06:48.99,0:06:51.41,Default,,0,0,0,,Тәжірибеде жоба жетекшісі ретінде
Dialogue: 0,0:06:51.49,0:06:54.62,Default,,0,0,0,,Дағдарыс сезімі Жауапкершілікті сезінбеу мүмкін
Dialogue: 0,0:06:54.70,0:06:58.66,Default,,0,0,0,,Сондықтан мен келесі сайыста сол денеге ие боламын.
Dialogue: 0,0:06:59.25,0:07:00.33,Default,,0,0,0,,Гранмейстер
Dialogue: 0,0:07:00.42,0:07:03.92,Default,,0,0,0,,Бұл аяқталуы тиіс сыйлыққа лайықты адам болғанымен.
Dialogue: 0,0:07:04.00,0:07:07.55,Default,,0,0,0,,Сіз күткен нәтижеге қол жеткізе алмаған сияқтысыз.
Dialogue: 0,0:07:07.63,0:07:08.51,Default,,0,0,0,,Аматсуса
Dialogue: 0,0:07:08.59,0:07:10.76,Default,,0,0,0,,Лақтыру керек болған жоғалған сандарға
Dialogue: 0,0:07:10.84,0:07:13.72,Default,,0,0,0,,Тақырып пен рейтинг шолып шықты.
Dialogue: 0,0:07:13.80,0:07:15.18,Default,,0,0,0,,Өкінішті!
Dialogue: 0,0:07:15.26,0:07:18.43,Default,,0,0,0,,Мен жай ғана Гранмайстерге көзім түскен жоқ.
Dialogue: 0,0:07:18.52,0:07:20.02,Default,,0,0,0,,Мен де соған ақша жұмсадым.
Dialogue: 0,0:07:20.10,0:07:24.44,Default,,0,0,0,,Иә, сондықтан мен шектен шықтым.
Dialogue: 0,0:07:24.52,0:07:25.98,Default,,0,0,0,,Қолыңызды арт жағынан бұрыңыз
Dialogue: 0,0:07:26.07,0:07:28.61,Default,,0,0,0,,Іріктеу кезеңінен өте алмаған Гранд Мейстер
Dialogue: 0,0:07:28.69,0:07:30.15,Default,,0,0,0,,Басты шайқасқа күштеп кірді
Dialogue: 0,0:07:30.24,0:07:32.95,Default,,0,0,0,,Аа, солай деп ойлаймын.
Dialogue: 0,0:07:33.03,0:07:35.74,Default,,0,0,0,,Бұл ыңғайлы даму болды.
Dialogue: 0,0:07:35.83,0:07:38.08,Default,,0,0,0,,Мен бұған көптен бері қызық болдым.
Dialogue: 0,0:07:38.16,0:07:39.08,Default,,0,0,0,,Бүгінгі кешке рахмет
Dialogue: 0,0:07:39.16,0:07:41.33,Default,,0,0,0,,Мен жастықты көтеріп ұйықтай алатындай сезінемін.
Dialogue: 0,0:07:41.42,0:07:43.29,Default,,0,0,0,,Мағынасыз құтқару әрекеттері—
Dialogue: 0,0:07:43.38,0:07:45.34,Default,,0,0,0,,Жоба менеджерінің міндеттері
Dialogue: 0,0:07:45.42,0:07:47.34,Default,,0,0,0,,Сіз оны орындасаңыз, бұл жақсы.
Dialogue: 0,0:07:47.42,0:07:49.97,Default,,0,0,0,,Бұрғылаудың қажеті жоқ.
Dialogue: 0,0:08:09.03,0:08:10.36,Default,,0,0,0,,Бұл Михараги-чан!
Dialogue: 0,0:08:10.44,0:08:11.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:11.36,0:08:14.24,Default,,0,0,0,,Мені таң қалдырмаңыз. Сен не істеп жатырсың?
Dialogue: 0,0:08:14.32,0:08:17.70,Default,,0,0,0,,Жақында мен терең тазалауды ойлап жатырмын.
Dialogue: 0,0:08:17.78,0:08:20.25,Default,,0,0,0,,Мен құралдарды тексердім.
Dialogue: 0,0:08:20.33,0:08:22.41,Default,,0,0,0,,Тазалағыш заттар қорабында?
Dialogue: 0,0:08:22.50,0:08:24.21,Default,,0,0,0,,Айтайын дегенім, жасайық, Мибараки-чан!
Dialogue: 0,0:08:24.29,0:08:25.88,Default,,0,0,0,,Сіз қаншалықты байсалдысыз.
Dialogue: 0,0:08:25.96,0:08:29.00,Default,,0,0,0,,Иә, мен байсалдымын!
Dialogue: 0,0:08:30.84,0:08:33.26,Default,,0,0,0,,Хаха...
Dialogue: 0,0:08:34.05,0:08:37.39,Default,,0,0,0,,Қиямет! Қайда бардың? Сіз қиындық тудырып жатырсыз.
Dialogue: 0,0:08:45.23,0:08:47.15,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:08:47.81,0:08:50.65,Default,,0,0,0,,Ол қазір қайда және не істеп жатыр?
Dialogue: 0,0:08:58.62,0:08:59.91,Default,,0,0,0,,(кеспенің шырылдаған дыбысы)
Dialogue: 0,0:08:59.99,0:09:02.00,Default,,0,0,0,,(Моцарттың жөтелі)
Dialogue: 0,0:09:03.37,0:09:04.67,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:05.54,0:09:06.67,Default,,0,0,0,,Неге...
Dialogue: 0,0:09:08.50,0:09:13.55,Default,,0,0,0,,Неліктен көптеген маңызды нәрселер менің қолымнан өтіп кетеді?
Dialogue: 0,0:09:16.68,0:09:19.68,Default,,0,0,0,,Сол күні мен мектепке кіргеннен кейін көп ұзамай...
Dialogue: 0,0:09:19.76,0:09:20.76,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:23.43,0:09:25.31,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:26.44,0:09:31.15,Default,,0,0,0,,Отбасылық сапарда болған кенеттен жол апаты
Dialogue: 0,0:09:31.23,0:09:35.28,Default,,0,0,0,,Бұл менің сол уақытқа дейін өмір сүру жолымды толығымен өзгертті.
Dialogue: 0,0:09:35.36,0:09:37.20,Default,,0,0,0,,Тек таңғышты алып тастауға болатын болса
Dialogue: 0,0:09:37.28,0:09:40.70,Default,,0,0,0,,Фортепианодағы шеберлігіңді Құдай сүйген дейді.
Dialogue: 0,0:09:40.78,0:09:43.12,Default,,0,0,0,,Ол жақсы жұмыс істеуі керек.
Dialogue: 0,0:09:43.79,0:09:47.25,Default,,0,0,0,,Құттықтаймыз, операциядан кейінгі курс жақсы өтуде.
Dialogue: 0,0:09:47.33,0:09:48.71,Default,,0,0,0,,Қосымша сынақ нәтижелері
Dialogue: 0,0:09:48.79,0:09:52.59,Default,,0,0,0,,Сіздің геномыңыздың сыйлықтармен үйлесімді екендігі расталды.
Dialogue: 0,0:09:52.67,0:09:55.09,Default,,0,0,0,,Сыйлық?
Dialogue: 0,0:09:55.17,0:09:56.01,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:56.09,0:10:00.43,Default,,0,0,0,,Иә! Әкең мен анаң ше? Сіз менімен бірге көлікте болдыңыз ...
Dialogue: 0,0:10:00.51,0:10:01.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:01.43,0:10:05.31,Default,,0,0,0,,Мен мінген көліктен енді ешбір белгі қалмады.
Dialogue: 0,0:10:05.39,0:10:09.60,Default,,0,0,0,,Бірақ сен ғана ғажайып тірісің.
Dialogue: 0,0:10:09.69,0:10:12.32,Default,,0,0,0,,Мен ше?
Dialogue: 0,0:10:12.40,0:10:13.98,Default,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,0:10:14.07,0:10:18.07,Default,,0,0,0,,Жапон классикалық фортепиано әлемінің жас қазынасы жаңа ғана қорғалды ма?
Dialogue: 0,0:10:18.16,0:10:21.83,Default,,0,0,0,,Болашақта одан әрі серпілістерге уәде берілді.
Dialogue: 0,0:10:22.41,0:10:26.41,Default,,0,0,0,,Ватару!
Dialogue: 0,0:10:32.00,0:10:34.71,Default,,0,0,0,,Сіздің шеберлігіңіз күткендей, Моцарт мырза.
Dialogue: 0,0:10:34.80,0:10:35.96,Default,,0,0,0,,(фортепиано дыбысы)
Dialogue: 0,0:10:36.05,0:10:38.68,Default,,0,0,0,,Өтінемін, мені бұл атпен атамаңыз.
Dialogue: 0,0:10:38.76,0:10:40.59,Default,,0,0,0,,Иә, мен сыйлықты қабылдадым.
Dialogue: 0,0:10:40.68,0:10:42.72,Default,,0,0,0,,Бірақ тек біреудің атымен шақырылады
Dialogue: 0,0:10:42.80,0:10:43.76,Default,,0,0,0,,Қабылданбайды!
Dialogue: 0,0:10:43.85,0:10:44.97,Default,,0,0,0,,Бұл былай деді:
Dialogue: 0,0:10:45.06,0:10:47.10,Default,,0,0,0,,Сонымен қатар, мен ұмтылатын нәрсе
Dialogue: 0,0:10:47.18,0:10:48.98,Default,,0,0,0,,Классикалық дәстүрді құрметтеу
Dialogue: 0,0:10:49.06,0:10:51.23,Default,,0,0,0,,Тынымсыз оқуды жалғастыру
Dialogue: 0,0:10:51.31,0:10:52.61,Default,,0,0,0,,Атақты адамдарды басқару туралы не айтасыз?
Dialogue: 0,0:10:52.69,0:10:54.61,Default,,0,0,0,,Басқасын жеңгеніңді қалаймын!
Dialogue: 0,0:10:58.32,0:11:01.70,Default,,0,0,0,,Күнде мұң мен ашу басым
Dialogue: 0,0:11:02.20,0:11:03.87,Default,,0,0,0,,Ол бәрінің ортасында көрінді.
Dialogue: 0,0:11:03.87,0:11:06.50,Default,,0,0,0,,Ол бәрінің ортасында көрінді.
Dialogue: 0,0:11:03.87,0:11:06.50,Default,,0,0,0,,Қорықпа
Dialogue: 0,0:11:06.50,0:11:07.87,Default,,0,0,0,,Қорықпа
Dialogue: 0,0:11:11.67,0:11:12.50,Default,,0,0,0,,Әй?
Dialogue: 0,0:11:14.29,0:11:17.51,Default,,0,0,0,,Таңертең ерте, Моцарт.
Dialogue: 0,0:11:17.59,0:11:18.72,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:19.30,0:11:20.47,Default,,0,0,0,,Мен менмін
Dialogue: 0,0:11:20.55,0:11:21.89,Default,,0,0,0,,Мені бұл атпен атама
Dialogue: 0,0:11:22.76,0:11:24.64,Default,,0,0,0,,Ахаха... Дұрыс.
Dialogue: 0,0:11:24.72,0:11:27.52,Default,,0,0,0,,Абайлаңыз, Моцарт
Dialogue: 0,0:11:27.60,0:11:29.48,Default,,0,0,0,,Мм... Бетховен!
Dialogue: 0,0:11:29.56,0:11:30.39,Default,,0,0,0,,Әй!
Dialogue: 0,0:11:30.48,0:11:32.52,Default,,0,0,0,,Ақыры сен маған қоңырау шалдың.
Dialogue: 0,0:11:32.60,0:11:35.23,Default,,0,0,0,,Бұл жағдайда, сіз ақырында қоңырау шалуға үйренесіз.
Dialogue: 0,0:11:35.98,0:11:37.48,Default,,0,0,0,,Моцарт
Dialogue: 0,0:11:38.32,0:11:39.99,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:40.07,0:11:45.08,Default,,0,0,0,,(Скрипка мен гитарада ойнау)
Dialogue: 0,0:11:50.29,0:11:52.92,Default,,0,0,0,,Шексіз кеңейген қараңғылықта
Dialogue: 0,0:11:53.00,0:11:55.46,Default,,0,0,0,,Мен жұлдыз таптым
Dialogue: 0,0:11:56.59,0:12:00.38,Default,,0,0,0,,Ақырында жұлдыздар саны екіге, сосын үшке дейін артады.
Dialogue: 0,0:12:00.88,0:12:05.35,Default,,0,0,0,,Мен білмей тұрып, жұлдыздардың жарықтығы қараңғылықты алып кетті.
Dialogue: 0,0:12:07.85,0:12:12.85,Default,,0,0,0,,Қорықпа
Dialogue: 0,0:12:17.19,0:12:18.15,Default,,0,0,0,,Неге...
Dialogue: 0,0:12:18.23,0:12:19.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:20.65,0:12:23.49,Default,,0,0,0,,Сіздің музыкаңыз жүздеген жылдар бойы сақталады
Dialogue: 0,0:12:23.57,0:12:27.20,Default,,0,0,0,,Неліктен сонша ыстық? бетховен
Dialogue: 0,0:12:27.28,0:12:28.62,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:12:28.70,0:12:31.16,Default,,0,0,0,,Мұны жүрегіңізден сұраңыз.
Dialogue: 0,0:12:32.00,0:12:35.46,Default,,0,0,0,,Сандық... сыйлыққа ма?
Dialogue: 0,0:12:38.13,0:12:41.92,Default,,0,0,0,,Сіз әлі қорқасыз ба? сыйлықты пайдаланыңыз
Dialogue: 0,0:12:44.22,0:12:45.93,Default,,0,0,0,,Қорқынышты емес
Dialogue: 0,0:12:46.01,0:12:49.56,Default,,0,0,0,,Ұлы ізашарларымыздың таланттарын осылайша сіңіру
Dialogue: 0,0:12:49.64,0:12:52.14,Default,,0,0,0,,Классикалық музыка салған дәстүр
Dialogue: 0,0:12:52.23,0:12:54.98,Default,,0,0,0,,Мен мұны күпірлік деп санамаймын.
Dialogue: 0,0:12:55.06,0:12:56.40,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:12:56.48,0:13:00.07,Default,,0,0,0,,Бірақ сол классикалық дәстүр туралы не деуге болады?
Dialogue: 0,0:13:00.15,0:13:02.40,Default,,0,0,0,,Бұл басынан бері болған жоқ, солай ма?
Dialogue: 0,0:13:03.28,0:13:07.20,Default,,0,0,0,,Бұрынғыларымыз бұрынғы дәстүрлерге байланған емес.
Dialogue: 0,0:13:07.28,0:13:11.33,Default,,0,0,0,,Ол басқа ешкімге ұқсамайтын жаңа музыкалық көкжиектерді ашса керек.
Dialogue: 0,0:13:12.37,0:13:15.96,Default,,0,0,0,,Дәстүрге байланысты емес пе?
Dialogue: 0,0:13:17.79,0:13:18.96,Default,,0,0,0,,Иә.
Dialogue: 0,0:13:19.04,0:13:22.92,Default,,0,0,0,,Музыка дәстүр мен тарихты сақтау емес.
Dialogue: 0,0:13:23.01,0:13:26.05,Default,,0,0,0,,Тарихты жасайтын музыка емес пе?
Dialogue: 0,0:13:26.97,0:13:28.68,Default,,0,0,0,,Жаңасын жасау…
Dialogue: 0,0:13:29.72,0:13:33.31,Default,,0,0,0,,Музыка тарихы, дәстүр...
Dialogue: 0,0:13:33.39,0:13:36.02,Default,,0,0,0,,Михараги мырза айтқан сайыс
Dialogue: 0,0:13:33.39,0:13:36.02,Default,,0,0,0,,Қорықпа
Dialogue: 0,0:13:36.02,0:13:36.10,Default,,0,0,0,,Қорықпа
Dialogue: 0,0:13:36.10,0:13:38.40,Default,,0,0,0,,Қорықпа
Dialogue: 0,0:13:36.10,0:13:38.40,Default,,0,0,0,,Шуман мен Вивальди оған толығымен құмар.
Dialogue: 0,0:13:38.40,0:13:39.36,Default,,0,0,0,,Шуман мен Вивальди оған толығымен құмар.
Dialogue: 0,0:13:39.44,0:13:40.82,Default,,0,0,0,,Әрине мен де.
Dialogue: 0,0:13:42.78,0:13:46.91,Default,,0,0,0,,Менің идеалды музыкамда тағы бір шығарма жетіспейді
Dialogue: 0,0:13:47.57,0:13:49.20,Default,,0,0,0,,Бірге орындаймыз ба?
Dialogue: 0,0:13:49.78,0:13:51.08,Default,,0,0,0,,Мен және...
Dialogue: 0,0:13:51.16,0:13:54.37,Default,,0,0,0,,Бұрын ешкім естімеген музыка
Dialogue: 0,0:13:54.45,0:13:55.83,Default,,0,0,0,,Бірге орындайық
Dialogue: 0,0:13:56.50,0:13:57.83,Default,,0,0,0,,Моцарт
Dialogue: 0,0:14:00.25,0:14:02.88,Default,,0,0,0,,Бетховеннің сұрағына жауап бердім.
Dialogue: 0,0:14:02.96,0:14:05.42,Default,,0,0,0,,Мен бірден жауап бере алмадым.
Dialogue: 0,0:14:06.01,0:14:07.22,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:14:12.85,0:14:14.72,Default,,0,0,0,,Өткен күннің жауабы
Dialogue: 0,0:14:14.81,0:14:16.77,Default,,0,0,0,,Сіз маған хабарлайсыз, солай ма?
Dialogue: 0,0:14:17.77,0:14:20.86,Default,,0,0,0,,Жауап менің ойымда шешіліп қойған.
Dialogue: 0,0:14:20.94,0:14:25.36,Default,,0,0,0,,Бірақ мен қандай сөздерді білдірерімді іздеп, осы күнге жеттім.
Dialogue: 0,0:14:25.44,0:14:28.61,Default,,0,0,0,,Сонымен... сөздерді таптың ба?
Dialogue: 0,0:14:29.20,0:14:30.49,Default,,0,0,0,,Табылмады
Dialogue: 0,0:14:30.99,0:14:34.12,Default,,0,0,0,,Сондықтан мен өз ойымды сөзден де күшті нәрсемен жеткізгім келеді.
Dialogue: 0,0:14:34.62,0:14:35.87,Default,,0,0,0,,Мен сенің тыңдағаныңды қалаймын
Dialogue: 0,0:14:36.37,0:14:38.12,Default,,0,0,0,,Бұл менің жауабым!
Dialogue: 0,0:14:39.00,0:14:45.59,Default,,0,0,0,,♪ Желге қандай ән айтамыз?
Dialogue: 0,0:14:47.38,0:14:51.55,Default,,0,0,0,,♪ «Тіпті заттар қайтымсыз болса да...»
Dialogue: 0,0:15:00.15,0:15:02.11,Default,,0,0,0,,♪ PP сезімдері
Dialogue: 0,0:15:02.19,0:15:04.32,Default,,0,0,0,,♪ Шексіз меланхолия
Dialogue: 0,0:15:04.40,0:15:06.48,Default,,0,0,0,,♪ Құдай бұзған дыбыс
Dialogue: 0,0:15:06.57,0:15:08.45,Default,,0,0,0,,♪ Күнделікті топырақтан іздеу
Dialogue: 0,0:15:08.53,0:15:10.78,Default,,0,0,0,,♪ Провидения кері өзгертілді
Dialogue: 0,0:15:10.86,0:15:12.70,Default,,0,0,0,,♪ Джазға деген махаббат сияқты
Dialogue: 0,0:15:12.78,0:15:19.08,Default,,0,0,0,,♪ ОД мүмкіндігі бар әуен (дозадан асып кету)
Dialogue: 0,0:15:19.16,0:15:23.34,Default,,0,0,0,,♪ Мен сезінемін... Мен жай ғана музыканы сезінемін
Dialogue: 0,0:15:23.42,0:15:27.59,Default,,0,0,0,,♪ Қатыгездіктің ортасында... әрқашан
Dialogue: 0,0:15:27.67,0:15:31.34,Default,,0,0,0,,♪ Мен сені мәңгілікке сағынатын боламын
Dialogue: 0,0:15:31.43,0:15:32.59,Default,,0,0,0,,♪ Қайғы да
Dialogue: 0,0:15:32.68,0:15:38.98,Default,,0,0,0,,♪ Осының бәріне шомылып, ән айт
Dialogue: 0,0:15:39.06,0:15:43.40,Default,,0,0,0,,♪ Кері айналдырылатын қайтымсыз ноталар (Ескерту)
Dialogue: 0,0:15:43.48,0:15:47.73,Default,,0,0,0,,♪ Әлемді құтқару сияқты сезілетін код
Dialogue: 0,0:15:47.82,0:15:51.99,Default,,0,0,0,,♪ Мен сені жақсы көремін...тіпті сол қайшылық
Dialogue: 0,0:15:52.07,0:15:55.99,Default,,0,0,0,,♪ Музыкада мүмкін емес нәрсе жоқ
Dialogue: 0,0:15:56.08,0:16:00.00,Default,,0,0,0,,♪ Енді «уақыттың» өзі махаббат жыры...
Dialogue: 0,0:16:00.08,0:16:03.00,Default,,0,0,0,,♪ Жазыңыз
Dialogue: 0,0:16:06.00,0:16:10.01,Default,,0,0,0,,～♪
Dialogue: 0,0:16:10.09,0:16:11.42,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:16:11.51,0:16:16.26,Default,,0,0,0,,Хаха...
Dialogue: 0,0:16:16.35,0:16:17.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:18.97,0:16:22.10,Default,,0,0,0,,Ешкім естімеген классикалық музыка дегеніміз не?
Dialogue: 0,0:16:22.19,0:16:25.69,Default,,0,0,0,,Менің ойымша, сіз шексіз мүмкіндіктер туралы айтып отырсыз.
Dialogue: 0,0:16:27.19,0:16:30.74,Default,,0,0,0,,Байқау - бұл тек кіріспе
Dialogue: 0,0:16:32.40,0:16:34.45,Default,,0,0,0,,Бірге жүгірейік!
Dialogue: 0,0:16:36.28,0:16:37.62,Default,,0,0,0,,Фу…
Dialogue: 0,0:16:38.54,0:16:40.29,Default,,0,0,0,,Уау...
Dialogue: 0,0:16:44.92,0:16:47.29,Default,,0,0,0,,Ах, дұрыс.
Dialogue: 0,0:16:48.09,0:16:49.34,Default,,0,0,0,,Енді ойлап отырсам
Dialogue: 0,0:16:49.42,0:16:52.22,Default,,0,0,0,,Бетховен күлімсіреп, біраз жалғызсырады.
Dialogue: 0,0:16:52.30,0:16:56.64,Default,,0,0,0,,Мен бір болжам болуы керек еді деп өкінбеймін...
Dialogue: 0,0:16:56.72,0:16:58.64,Default,,0,0,0,,(Endeavour) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,0:16:58.72,0:17:03.14,Default,,0,0,0,,Хаха...
Dialogue: 0,0:17:09.19,0:17:10.53,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:17:12.24,0:17:13.82,Default,,0,0,0,,Моцарт…
Dialogue: 0,0:17:13.90,0:17:15.78,Default,,0,0,0,,Жер бетінде не болды?
Dialogue: 0,0:17:15.86,0:17:18.28,Default,,0,0,0,,Біз мектептен шығамыз
Dialogue: 0,0:17:18.37,0:17:20.20,Default,,0,0,0,,Мен бұдан былай мұнда тұра алмаймын.
Dialogue: 0,0:17:20.29,0:17:22.16,Default,,0,0,0,,Онда мен сізге қосыламын!
Dialogue: 0,0:17:22.25,0:17:23.16,Default,,0,0,0,,Маған мән-жайды кейінірек айта алсаңыз...
Dialogue: 0,0:17:23.16,0:17:24.46,Default,,0,0,0,,Маған мән-жайды кейінірек айта алсаңыз...
Dialogue: 0,0:17:23.16,0:17:24.46,Default,,0,0,0,,Міне! Бұл жерде!
Dialogue: 0,0:17:25.08,0:17:27.00,Default,,0,0,0,,Мен сені өзіммен бірге алып кетпеймін.
Dialogue: 0,0:17:27.08,0:17:28.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:28.59,0:17:30.09,Default,,0,0,0,,Қош бол
Dialogue: 0,0:17:30.59,0:17:33.97,Default,,0,0,0,,А... А...
Dialogue: 0,0:17:34.05,0:17:35.72,Default,,0,0,0,,Бетховен!
Dialogue: 0,0:17:36.93,0:17:39.43,Default,,0,0,0,,Қолымда ұстаған жұлдыздарым төгіліп жатыр
Dialogue: 0,0:17:40.64,0:17:45.69,Default,,0,0,0,,Неліктен көптеген маңызды нәрселер менің қолымнан өтіп кетеді ...
Dialogue: 0,0:17:55.90,0:17:58.41,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:17:58.49,0:18:00.24,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:18:00.33,0:18:02.70,Default,,0,0,0,,Мұғалім Олар ше?
Dialogue: 0,0:18:02.79,0:18:06.29,Default,,0,0,0,,Енді Шопен мен Листтің сыйлықтарымен үйлесімді —
Dialogue: 0,0:18:06.37,0:18:07.42,Default,,0,0,0,,Мен жаңадан келген адаммын.
Dialogue: 0,0:18:07.42,0:18:08.46,Default,,0,0,0,,Мен жаңадан келген адаммын.
Dialogue: 0,0:18:07.42,0:18:08.46,Default,,0,0,0,,Хмм
Dialogue: 0,0:18:08.54,0:18:13.46,Default,,0,0,0,,Мұғалім алдағы жарыстан әлі бас тартқан жоқ.
Dialogue: 0,0:18:13.55,0:18:15.67,Default,,0,0,0,,Және тағы бір жақсы жаңалық.
Dialogue: 0,0:18:15.76,0:18:18.55,Default,,0,0,0,,Бетховенге жаңа кандидат қазірдің өзінде бар...
Dialogue: 0,0:18:18.64,0:18:19.59,Default,,0,0,0,,Ұстаз!
Dialogue: 0,0:18:19.68,0:18:21.85,Default,,0,0,0,,Нана... Бұл не?
Dialogue: 0,0:18:21.93,0:18:24.35,Default,,0,0,0,,Бізге Бетховен енді керек емес.
Dialogue: 0,0:18:24.43,0:18:26.14,Default,,0,0,0,,Қажет емес!
Dialogue: 0,0:18:36.86,0:18:41.53,Default,,0,0,0,,Хаха...
Dialogue: 0,0:18:42.16,0:18:44.62,Default,,0,0,0,,Уайымдамаңыз, менің физикалық күшім шегінде...
Dialogue: 0,0:18:44.70,0:18:45.54,Default,,0,0,0,,Әй, уау!
Dialogue: 0,0:18:46.50,0:18:49.54,Default,,0,0,0,,Не... балалар мұнда неге...
Dialogue: 0,0:18:49.62,0:18:51.92,Default,,0,0,0,,«Неге мұнда» күтпеген жерден.
Dialogue: 0,0:18:52.00,0:18:54.09,Default,,0,0,0,,Бетховен сияқты
Dialogue: 0,0:18:54.09,0:18:54.92,Default,,0,0,0,,Бетховен сияқты
Dialogue: 0,0:18:54.09,0:18:54.92,Default,,0,0,0,,(Шопен канализациясы)
Dialogue: 0,0:18:55.51,0:18:56.67,Default,,0,0,0,,Менімен?
Dialogue: 0,0:18:57.26,0:19:00.05,Default,,0,0,0,,Ешбір жоспарсыз Хараджукуды айналып жүгіру.
Dialogue: 0,0:19:00.13,0:19:02.14,Default,,0,0,0,,Сіздің миыңыз бұлшықет пе?
Dialogue: 0,0:19:02.22,0:19:04.31,Default,,0,0,0,,Сіз білмеуіңіз керек.
Dialogue: 0,0:19:04.39,0:19:07.02,Default,,0,0,0,,Ол қайда баруы мүмкін...
Dialogue: 0,0:19:07.10,0:19:08.52,Default,,0,0,0,,Мүмкін!
Dialogue: 0,0:19:08.60,0:19:11.52,Default,,0,0,0,,Ханзада? Мен соңғы кездері мұнда болмадым.
Dialogue: 0,0:19:11.60,0:19:13.02,Default,,0,0,0,,Шит… шит…
Dialogue: 0,0:19:13.11,0:19:15.02,Default,,0,0,0,,Ах, бірақ (Бетховен және басқалар) Ах...
Dialogue: 0,0:19:15.11,0:19:17.78,Default,,0,0,0,,Шамамен 15 минут бұрын
Dialogue: 0,0:19:17.86,0:19:21.16,Default,,0,0,0,,Мен сені дүкеннің жанынан өтіп бара жатқаныңды көрдім.
Dialogue: 0,0:19:21.24,0:19:22.87,Default,,0,0,0,,Қай жолмен?
Dialogue: 0,0:19:22.95,0:19:24.03,Default,,0,0,0,,Сол жерде
Dialogue: 0,0:19:24.12,0:19:25.41,Default,,0,0,0,,Әлі де алыс емес!
Dialogue: 0,0:19:27.04,0:19:29.25,Default,,0,0,0,,Бауырлар, сендер ханзадамен доссыңдар ма?
Dialogue: 0,0:19:29.33,0:19:30.50,Default,,0,0,0,,Біз дос емеспіз
Dialogue: 0,0:19:30.58,0:19:31.42,Default,,0,0,0,,Әй?
Dialogue: 0,0:19:31.50,0:19:34.92,Default,,0,0,0,,Бірақ біз доспыз!
Dialogue: 0,0:19:40.51,0:19:41.34,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:44.22,0:19:45.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:56.82,0:19:57.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:59.49,0:20:03.41,Default,,0,0,0,,Үш күннен бері қайда жүрдіңіз?
Dialogue: 0,0:20:03.49,0:20:05.70,Default,,0,0,0,,Бірақ мен сенің қауіпсіз болғаныңа қуаныштымын.
Dialogue: 0,0:20:06.66,0:20:09.70,Default,,0,0,0,,Қайтып кел, Моцарт
Dialogue: 0,0:20:10.62,0:20:12.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:16.54,0:20:17.84,Default,,0,0,0,,Балалар...
Dialogue: 0,0:20:19.05,0:20:23.05,Default,,0,0,0,,♪～
Dialogue: 0,0:21:44.05,0:21:48.97,Default,,0,0,0,,～♪
Dialogue: 0,0:21:51.72,0:21:52.81,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:52.89,0:21:54.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:55.27,0:21:56.73,Default,,0,0,0,,Әй!
Dialogue: 0,0:21:57.77,0:21:59.61,Default,,0,0,0,,Бәрін тыңдауға рұқсат етіңіз.
Dialogue: 0,0:21:59.69,0:22:02.90,Default,,0,0,0,,Осы уақытқа дейін не болды, алда не болады
Dialogue: 0,0:22:02.98,0:22:06.61,Default,,0,0,0,,Бір кісідей бас қосып, сайыста жеңіске жетуіміз үшін.
Dialogue: 0,0:22:07.24,0:22:08.28,Default,,0,0,0,,Фу…
Dialogue: 0,0:22:09.41,0:22:10.53,Default,,0,0,0,,Барлығы…
Dialogue: 0,0:22:12.54,0:22:13.37,Default,,0,0,0,,Бұл...
Dialogue: 0,0:22:13.45,0:22:14.91,Default,,0,0,0,,Маған сөйлесуге рұқсат етіңіз
Dialogue: 0,0:22:15.00,0:22:15.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:23.76,0:22:25.92,Default,,0,0,0,,Бетховен! (Бетховен) А...
Dialogue: 0,0:22:30.80,0:22:31.85,Default,,0,0,0,,Эй... не!
Dialogue: 0,0:22:34.39,0:22:36.81,Default,,0,0,0,,Керісінше, қанша адам қарғысқа ұшырап өлетінін болжау мүмкін емес.
Dialogue: 0,0:22:52.91,0:22:54.33,Default,,0,0,0,,Ақымақ, өлесің бе?
Dialogue: 0,0:22:54.41,0:22:55.83,Default,,0,0,0,,Сен өлесің бе?
Dialogue: 0,0:22:55.91,0:22:56.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:56.91,0:22:57.96,Default,,0,0,0,,Маған
Dialogue: 0,0:22:58.04,0:23:01.33,Default,,0,0,0,,Менің өмір сүру және орындау миссиясы бар.
Dialogue: 0,0:23:02.21,0:23:04.63,Default,,0,0,0,,Миссия...?
Dialogue: 0,0:23:11.89,0:23:14.26,Default,,0,0,0,,Миссия болғанша
Dialogue: 0,0:23:14.35,0:23:16.31,Default,,0,0,0,,Тағдыр мені өлтірмейді!
Dialogue: 0,0:23:36.49,0:23:39.62,Default,,0,0,0,,Келесі жолы «Музыканың ырғағы - махаббат»
Dialogue: 0,0:23:41.12,0:23:47.12,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory