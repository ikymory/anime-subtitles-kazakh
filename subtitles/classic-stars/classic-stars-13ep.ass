Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.41,0:00:04.54,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:00:06.50,0:00:09.59,Default,,0,0,0,,Уау~ Ахахха...
Dialogue: 0,0:00:12.01,0:00:13.18,Default,,0,0,0,,Олай болса...
Dialogue: 0,0:00:13.26,0:00:17.10,Default,,0,0,0,,Жаңбыр тоқтады, міне соңғы бірлік!
Dialogue: 0,0:00:17.18,0:00:18.72,Default,,0,0,0,,№ 10...
Dialogue: 0,0:00:18.81,0:00:20.68,Default,,0,0,0,,Сәлем! (Лист Шопен) Ах...
Dialogue: 0,0:00:24.60,0:00:26.61,Default,,0,0,0,,Сіз мені күтуге мәжбүр еттіңіз!
Dialogue: 0,0:00:28.57,0:00:30.19,Default,,0,0,0,,1-аудио үзінді Хигучидің көлігінің ішінен; 2-ші үзінді Сакура TV-ден, өтінемін.
Dialogue: 0,0:00:30.28,0:00:34.53,Default,,0,0,0,,Сайып келгенде, біз Ұлы Мейстерміз!
Dialogue: 0,0:00:35.03,0:00:38.99,Default,,0,0,0,,♪～
Dialogue: 0,0:02:00.91,0:02:04.91,Default,,0,0,0,,～♪
Dialogue: 0,0:02:08.37,0:02:09.92,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:02:10.00,0:02:11.71,Default,,0,0,0,,Мен келдім деп ойлаған кезде
Dialogue: 0,0:02:11.79,0:02:13.17,Default,,0,0,0,,Ол қалай пайда болды...
Dialogue: 0,0:02:13.25,0:02:14.92,Default,,0,0,0,,Авдол мен басқалар… келе жатыр…
Dialogue: 0,0:02:15.01,0:02:17.55,Default,,0,0,0,,Сахнаға дайындық жақын арада аяқталады.
Dialogue: 0,0:02:17.63,0:02:19.55,Default,,0,0,0,,Мен тезірек дайындалуым керек.
Dialogue: 0,0:02:19.64,0:02:23.18,Default,,0,0,0,,А, шынымен де... Мен сені өлді деп ойладым.
Dialogue: 0,0:02:23.26,0:02:26.52,Default,,0,0,0,,Хаха, шын мәнінде солай болуы мүмкін.
Dialogue: 0,0:02:26.60,0:02:27.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:27.85,0:02:32.02,Default,,0,0,0,,Мені оның ыстық жұдырығы артқа тартты.
Dialogue: 0,0:02:32.11,0:02:36.07,Default,,0,0,0,,Толығырақ сұрағым келеді, бірақ дәл қазір уақытым жоқ.
Dialogue: 0,0:02:36.15,0:02:37.95,Default,,0,0,0,,Моцарттың ноталары
Dialogue: 0,0:02:38.03,0:02:40.03,Default,,0,0,0,,Қорытынды растау
Dialogue: 0,0:02:40.11,0:02:41.32,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:42.58,0:02:43.41,Default,,0,0,0,,Әй!
Dialogue: 0,0:02:44.24,0:02:45.79,Default,,0,0,0,,А... не істеп жатырсың!
Dialogue: 0,0:02:49.21,0:02:50.25,Default,,0,0,0,,Сіз мұнымен жеңе алмайсыз
Dialogue: 0,0:02:50.33,0:02:51.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:53.38,0:02:55.30,Default,,0,0,0,,Барлығы бізге өз көмегін бергенін қалаймыз!
Dialogue: 0,0:02:56.59,0:02:59.88,Default,,0,0,0,,Олай болса, сізді ұзақ күттіргенім үшін кешіріңіз.
Dialogue: 0,0:02:59.97,0:03:03.14,Default,,0,0,0,,Біздің шақырушы бақыт құдайы
Dialogue: 0,0:03:03.22,0:03:05.47,Default,,0,0,0,,Оларға күлкі сыйла
Dialogue: 0,0:03:05.56,0:03:08.39,Default,,0,0,0,,Иә? Біз не істедік?
Dialogue: 0,0:03:09.14,0:03:13.15,Default,,0,0,0,,Әндеріңнің құдіретін көрсетші
Dialogue: 0,0:03:13.23,0:03:16.15,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:03:16.23,0:03:19.74,Default,,0,0,0,,Байқау жеңімпазы №10 Гранд Мейстер!
Dialogue: 0,0:03:19.74,0:03:21.78,Default,,0,0,0,,Байқаудың жеңімпазы №10 Гранд Мейстер!
Dialogue: 0,0:03:19.74,0:03:21.78,Default,,0,0,0,,А... ха
Dialogue: 0,0:03:23.74,0:03:25.24,Default,,0,0,0,,Бұл қандай да бір «Гя●ган» ба?!
Dialogue: 0,0:03:25.33,0:03:28.66,Default,,0,0,0,,Гранмейстер байқауға қатыса алмайды емес пе?
Dialogue: 0,0:03:28.75,0:03:32.04,Default,,0,0,0,,Сол апатта ол тым босаңсыған жоқ па?
Dialogue: 0,0:03:32.12,0:03:36.34,Default,,0,0,0,,Мен жоспарларды қайта-қайта өзгертуге мәжбүр болдым.
Dialogue: 0,0:03:36.42,0:03:39.05,Default,,0,0,0,,Бұл жағдайда сіз берген ақша босқа кетеді.
Dialogue: 0,0:03:39.13,0:03:42.76,Default,,0,0,0,,Аа, Гран Мейстер қазірдің өзінде құлаған жұлдыз.
Dialogue: 0,0:03:42.84,0:03:44.30,Default,,0,0,0,,Ол енді қолданылмайды.
Dialogue: 0,0:03:44.39,0:03:49.31,Default,,0,0,0,,Біздің негізгі мақсатымыз үшін біз оны жоғалтуымыз керек.
Dialogue: 0,0:03:49.39,0:03:53.65,Default,,0,0,0,,Адамның сезімдерін бейнелейтін эмоциялар
Dialogue: 0,0:03:53.73,0:03:58.53,Default,,0,0,0,,Адамның мәдени қызметін ілгерілету үшін жасалған технология
Dialogue: 0,0:03:58.61,0:04:04.11,Default,,0,0,0,,Уақыт өте келе ол елдің экономикалық және әскери қуаты сияқты күш-қуатының көрсеткішіне айналды.
Dialogue: 0,0:04:04.20,0:04:06.37,Default,,0,0,0,,қолданысқа енді
Dialogue: 0,0:04:06.45,0:04:09.08,Default,,0,0,0,,Күшті және эмоционалдырақ
Dialogue: 0,0:04:09.16,0:04:14.21,Default,,0,0,0,,Мәдени-бейбіт шаралар жиі айтылады...
Dialogue: 0,0:04:14.29,0:04:18.30,Default,,0,0,0,,Ұлттар арасындағы дау – соғыс.
Dialogue: 0,0:04:18.96,0:04:20.55,Default,,0,0,0,,Әскери билікті сақтамау
Dialogue: 0,0:04:20.63,0:04:23.76,Default,,0,0,0,,Экономикалық өсу әлдеқашан шарықтау шегіне жетті.
Dialogue: 0,0:04:23.84,0:04:27.64,Default,,0,0,0,,Дамыған ел атанғанымыз баяғыда.
Dialogue: 0,0:04:27.72,0:04:31.77,Default,,0,0,0,,Бірақ біздің еліміз әлемнің ұлы державаларымен қатар тұрады.
Dialogue: 0,0:04:31.85,0:04:34.27,Default,,0,0,0,,Бірегей дәуір келді
Dialogue: 0,0:04:34.35,0:04:37.06,Default,,0,0,0,,Granmeister және Dis=Cord екеуі де
Dialogue: 0,0:04:37.15,0:04:40.11,Default,,0,0,0,,Бұл эмоционалды ұлт болудың негізі.
Dialogue: 0,0:04:40.19,0:04:43.28,Default,,0,0,0,,Асыл тәжірибедегі теңіз шошқасы ғана
Dialogue: 0,0:04:45.86,0:04:48.78,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:04:52.87,0:04:53.79,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:53.87,0:04:56.88,Default,,0,0,0,,Қоштасу Гранмейстер
Dialogue: 0,0:04:58.13,0:04:59.38,Default,,0,0,0,,Хмм!
Dialogue: 0,0:04:59.46,0:05:00.80,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:05:00.88,0:05:03.97,Default,,0,0,0,,Үлкендерге ыңғайлы болу үшін балаларға қатысты бірдеңе істеу керек пе?
Dialogue: 0,0:05:04.05,0:05:06.68,Default,,0,0,0,,Тәрбиеші ретінде бұған жол берілмейді.
Dialogue: 0,0:05:06.76,0:05:08.10,Default,,0,0,0,,Үш журнал!
Dialogue: 0,0:05:08.18,0:05:10.06,Default,,0,0,0,,Муф~
Dialogue: 0,0:05:10.14,0:05:12.06,Default,,0,0,0,,Ал көп еңбек еткендерге
Dialogue: 0,0:05:12.14,0:05:15.31,Default,,0,0,0,,Сіз марапатқа лайық емессіз бе?
Dialogue: 0,0:05:15.94,0:05:17.27,Default,,0,0,0,,Білмеймін.
Dialogue: 0,0:05:17.35,0:05:18.48,Default,,0,0,0,,Қалай болғанда да, әдеттегідей—
Dialogue: 0,0:05:18.56,0:05:20.15,Default,,0,0,0,,Маған опасыздық жасайсың ба?
Dialogue: 0,0:05:20.23,0:05:22.15,Default,,0,0,0,,басыңыз
Dialogue: 0,0:05:27.57,0:05:32.37,Default,,0,0,0,,Бетховен мырза Моцарт мырза Шопен мырза Лист мырза
Dialogue: 0,0:05:32.45,0:05:34.79,Default,,0,0,0,,Мұғалімнің сыйы.
Dialogue: 0,0:05:34.87,0:05:36.58,Default,,0,0,0,,Соңғы кезең
Dialogue: 0,0:05:36.67,0:05:39.00,Default,,0,0,0,,Көңіліңізден шыққандай ән айтыңыз
Dialogue: 0,0:05:40.75,0:05:42.30,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:42.38,0:05:46.09,Default,,0,0,0,,Арнайы жасақтарды дереу сахнаға жіберіңіз!
Dialogue: 0,0:05:47.51,0:05:49.30,Default,,0,0,0,,Бәріңіз тыңдаңыздар!
Dialogue: 0,0:05:49.39,0:05:51.31,Default,,0,0,0,,Ең үлкен сахнада—
Dialogue: 0,0:05:51.39,0:05:51.93,Default,,0,0,0,,Фу…
Dialogue: 0,0:05:51.93,0:05:52.39,Default,,0,0,0,,Фу…
Dialogue: 0,0:05:51.93,0:05:52.39,Default,,0,0,0,,Ең жақсы достарыммен ең жақсы қарсыластарым алдында ән айту
Dialogue: 0,0:05:52.39,0:05:53.39,Default,,0,0,0,,Ең жақсы достарыммен ең жақсы қарсыластарым алдында ән айту
Dialogue: 0,0:05:53.39,0:05:54.64,Default,,0,0,0,,Ең жақсы достарыммен ең жақсы қарсыластарымның алдында ән айту
Dialogue: 0,0:05:53.39,0:05:54.64,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:05:54.64,0:05:55.39,Default,,0,0,0,,Ең жақсы достарыммен ең жақсы қарсыластарымның алдында ән айту
Dialogue: 0,0:05:55.39,0:05:56.44,Default,,0,0,0,,Ең жақсы достарыммен ең жақсы қарсыластарымның алдында ән айту
Dialogue: 0,0:05:55.39,0:05:56.44,Default,,0,0,0,,Фу…
Dialogue: 0,0:05:56.44,0:05:57.31,Default,,0,0,0,,Ең жақын достарыммен ең жақсы қарсыластарым алдында ән айту
Dialogue: 0,0:05:57.39,0:05:59.69,Default,,0,0,0,,Керемет ән!
Dialogue: 0,0:06:02.57,0:06:07.70,Default,,0,0,0,,♪ «Симфония★ЖҰЛДЫЗДАР ӘУЕНІ»
Dialogue: 0,0:06:16.79,0:06:20.21,Default,,0,0,0,,♪ Мен бірінші рет қабаттасу күшін білдім
Dialogue: 0,0:06:20.29,0:06:22.84,Default,,0,0,0,,♪ Сенемін, сенемін, сенемін
Dialogue: 0,0:06:23.80,0:06:27.26,Default,,0,0,0,,♪ Жүрек соғулары бір-бірімен байланысып, шексіз сезінеді.
Dialogue: 0,0:06:27.34,0:06:29.22,Default,,0,0,0,,♪ Сенемін, сенемін, сенемін
Dialogue: 0,0:06:30.30,0:06:32.05,Default,,0,0,0,,♪ Гравитация, Мәртебелі,
Dialogue: 0,0:06:32.14,0:06:34.06,Default,,0,0,0,,♪ Бостандықтан тыс
Dialogue: 0,0:06:34.14,0:06:37.23,Default,,0,0,0,,♪ Сиқырдан шыққан жүрек
Dialogue: 0,0:06:37.31,0:06:41.36,Default,,0,0,0,,♪ Шындық, жауыздық, қабыл алайық
Dialogue: 0,0:06:41.44,0:06:44.73,Default,,0,0,0,,♪ Солай болса да, менің жаным айнымас.
Dialogue: 0,0:06:44.82,0:06:48.74,Default,,0,0,0,,♪ Енді бәріміз бірге резонанс тудырайық
Dialogue: 0,0:06:50.07,0:06:51.74,Default,,0,0,0,,​​Есіңіз дұрыс па?
Dialogue: 0,0:06:51.82,0:06:54.24,Default,,0,0,0,,Мен оны ішінара болса да, қазір қайта түсіретініме сене алар емеспін.
Dialogue: 0,0:06:54.33,0:06:55.91,Default,,0,0,0,,Ән жасалса да
Dialogue: 0,0:06:55.99,0:06:59.00,Default,,0,0,0,,Бұл ең үлкен сахнада нағыз жекпе-жек болады...
Dialogue: 0,0:06:59.62,0:07:02.50,Default,,0,0,0,,Мен оны енді ғана түсіндім.
Dialogue: 0,0:07:02.58,0:07:04.04,Default,,0,0,0,,Біз айтатын ән
Dialogue: 0,0:07:04.13,0:07:06.76,Default,,0,0,0,,Оны төртеуміз бірге салуымыз керек еді.
Dialogue: 0,0:07:07.59,0:07:10.22,Default,,0,0,0,,Екпінділігім үшін бітірсем де жақсы емес.
Dialogue: 0,0:07:10.30,0:07:13.85,Default,,0,0,0,,Бұл кезең төртеуміздің ән айтуымызды талап етеді!
Dialogue: 0,0:07:13.93,0:07:14.97,Default,,0,0,0,,(Танжиро) Бірақ құбыжықтар жалғыз жүруі керек еді ғой?
Dialogue: 0,0:07:15.06,0:07:18.10,Default,,0,0,0,,Төртеуміз жасайық
Dialogue: 0,0:07:19.02,0:07:20.19,Default,,0,0,0,,Бетховен…
Dialogue: 0,0:07:20.69,0:07:23.61,Default,,0,0,0,,О! А... Мен бұған көмектесе алмаймын.
Dialogue: 0,0:07:23.69,0:07:27.11,Default,,0,0,0,,Ақымақтардың жұғатыны рас.
Dialogue: 0,0:07:27.19,0:07:28.61,Default,,0,0,0,,Бұл мен жинаған нәрсе емес.
Dialogue: 0,0:07:27.19,0:07:28.61,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:07:28.69,0:07:29.90,Default,,0,0,0,,Фу…
Dialogue: 0,0:07:29.99,0:07:33.57,Default,,0,0,0,,Біз мұны істей аламыз Тек біздің қолымыздан келеді
Dialogue: 0,0:07:33.66,0:07:35.37,Default,,0,0,0,,Ән айту ғана қалды!
Dialogue: 0,0:07:35.99,0:07:38.29,Default,,0,0,0,,Өз әуенім ағып жатқандай
Dialogue: 0,0:07:38.37,0:07:41.37,Default,,0,0,0,,Биде гүл, биде мақтаныш
Dialogue: 0,0:07:41.46,0:07:44.13,Default,,0,0,0,,Әннің жұдырығымен ұр!
Dialogue: 0,0:07:44.21,0:07:47.88,Default,,0,0,0,,Fortissimo Fortissimo!
Dialogue: 0,0:07:48.67,0:07:50.63,Default,,0,0,0,,Біз жұлдызбыз!
Dialogue: 0,0:07:54.51,0:07:57.97,Default,,0,0,0,,♪ Музыка арасындағы делдал
Dialogue: 0,0:07:58.06,0:07:59.89,Default,,0,0,0,,♪ рухани және
Dialogue: 0,0:07:59.98,0:08:01.39,Default,,0,0,0,,♪ сезімтал өмір
Dialogue: 0,0:08:01.48,0:08:05.02,Default,,0,0,0,,♪ Әлемді бірге жасаңыз
Dialogue: 0,0:08:05.11,0:08:08.40,Default,,0,0,0,,♪ Мен өмір сүргенше
Dialogue: 0,0:08:08.48,0:08:11.40,Default,,0,0,0,,♪ Қанша берілсем де
Dialogue: 0,0:08:11.49,0:08:14.66,Default,,0,0,0,,♪ Егер сіз бас тартпасаңыз, болады
Dialogue: 0,0:08:14.74,0:08:17.66,Default,,0,0,0,,♪ Жарық күліп тұруы керек
Dialogue: 0,0:08:17.74,0:08:21.66,Default,,0,0,0,,♪ Адамдардың армандарына сену
Dialogue: 0,0:08:21.75,0:08:24.67,Default,,0,0,0,,♪ Жарқырай бер
Dialogue: 0,0:08:24.75,0:08:30.42,Default,,0,0,0,,♪ Дыбыстан ләззат алыңыз... мәңгілікке
Dialogue: 0,0:08:42.94,0:08:46.94,Default,,0,0,0,,～♪
Dialogue: 0,0:08:48.02,0:08:53.32,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,0:08:54.82,0:08:55.99,Default,,0,0,0,,Фу…
Dialogue: 0,0:08:57.03,0:08:58.58,Default,,0,0,0,,Фу…
Dialogue: 0,0:08:59.74,0:09:04.21,Default,,0,0,0,,Бұл өтірік, солай ма? Мұндай біреу менің назарымды аудара алады дегенге сене алар емеспін...
Dialogue: 0,0:09:04.29,0:09:07.83,Default,,0,0,0,,Шексіз жайылған қара түнек
Dialogue: 0,0:09:07.92,0:09:10.71,Default,,0,0,0,,Жақында сөнетін жұлдыздардың өлуі
Dialogue: 0,0:09:10.80,0:09:14.97,Default,,0,0,0,,Жоқ, туған жұлдыздардың жымыңдауы одан да асып түседі.
Dialogue: 0,0:09:15.05,0:09:16.30,Default,,0,0,0,,Фу…
Dialogue: 0,0:09:16.39,0:09:20.64,Default,,0,0,0,,Сіз жойылудың орнына жаратылысқа қол жеткіздіңіз бе? Гранмейстер
Dialogue: 0,0:09:21.31,0:09:26.35,Default,,0,0,0,,Шынымен бе? Олар сонша күшке ие болды ...
Dialogue: 0,0:09:26.44,0:09:29.56,Default,,0,0,0,,Мұғалім, бұл мені қуантады~
Dialogue: 0,0:09:29.65,0:09:30.86,Default,,0,0,0,,Нфу~
Dialogue: 0,0:09:30.94,0:09:34.86,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,0:09:47.04,0:09:50.38,Default,,0,0,0,,Енді сайыс жеңімпаздарын жариялау уақыты келді.
Dialogue: 0,0:09:51.21,0:09:54.13,Default,,0,0,0,,Мұқият таңдалған және бірегей AI қарастырған
Dialogue: 0,0:09:54.72,0:09:57.76,Default,,0,0,0,,Сонымен бірге біз эмо-ны да өткізілетін жерде өлшедік.
Dialogue: 0,0:09:58.39,0:10:01.81,Default,,0,0,0,,Ең жоғары біріктірілген ұпайлары бар бірлік болады
Dialogue: 0,0:10:01.89,0:10:03.64,Default,,0,0,0,,Жеңімпаз
Dialogue: 0,0:10:04.47,0:10:06.14,Default,,0,0,0,,Мен өзіме қажет нәрсені жасадым.
Dialogue: 0,0:10:06.23,0:10:07.27,Default,,0,0,0,,Дегенмен, енді ғана не болды?
Dialogue: 0,0:10:07.35,0:10:11.02,Default,,0,0,0,,Енді, барлығыңыз, мониторға назар аударыңыз!
Dialogue: 0,0:10:16.90,0:10:17.61,Default,,0,0,0,,(аудитория айқайлауы)
Dialogue: 0,0:10:17.61,0:10:19.28,Default,,0,0,0,,(аудитория айқайлауы)
Dialogue: 0,0:10:17.61,0:10:19.28,Default,,0,0,0,,Бұл өтірік емес пе?
Dialogue: 0,0:10:19.28,0:10:19.36,Default,,0,0,0,,(аудитория айқайлауы)
Dialogue: 0,0:10:19.36,0:10:20.78,Default,,0,0,0,,(аудитория айқайлауы)
Dialogue: 0,0:10:19.36,0:10:20.78,Default,,0,0,0,,Галстук…
Dialogue: 0,0:10:20.87,0:10:22.66,Default,,0,0,0,,Бұл ұтыс ойыны ма?
Dialogue: 0,0:10:23.45,0:10:25.91,Default,,0,0,0,,Жоқ, бұл біздің шығын.
Dialogue: 0,0:10:26.00,0:10:27.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:27.33,0:10:29.67,Default,,0,0,0,,Сайыстағы рейтингтер тең.
Dialogue: 0,0:10:29.75,0:10:32.34,Default,,0,0,0,,Дегенмен, бұл жағдайда турнир ережесіне сәйкес
Dialogue: 0,0:10:32.42,0:10:36.01,Default,,0,0,0,,Ұпайлар біліктілік рейтингтері негізінде қосылады.
Dialogue: 0,0:10:36.09,0:10:38.43,Default,,0,0,0,,Сондықтан бұл байқаудың жеңімпазы...
Dialogue: 0,0:10:40.01,0:10:43.31,Default,,0,0,0,,Сан 9 Dis=Cord!
Dialogue: 0,0:10:40.01,0:10:43.31,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:10:43.31,0:10:43.39,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:10:43.39,0:10:45.43,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:10:43.39,0:10:45.43,Default,,0,0,0,,Құттықтаймыз!
Dialogue: 0,0:10:48.06,0:10:50.19,Default,,0,0,0,,Бұл біршама күрделі~
Dialogue: 0,0:10:50.98,0:10:52.19,Default,,0,0,0,,Жоғалту...
Dialogue: 0,0:10:55.36,0:10:56.19,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:57.99,0:10:59.20,Default,,0,0,0,,Фу…
Dialogue: 0,0:10:59.28,0:11:00.45,Default,,0,0,0,,Фу…
Dialogue: 0,0:11:01.03,0:11:02.12,Default,,0,0,0,,Фу…
Dialogue: 0,0:11:03.87,0:11:04.37,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,0:11:04.37,0:11:06.04,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,0:11:04.37,0:11:06.04,Default,,0,0,0,,О? Ах...
Dialogue: 0,0:11:06.04,0:11:07.20,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,0:11:09.29,0:11:12.79,Default,,0,0,0,,Енді барлық жеңімпаздарға, Dis＝Cord.
Dialogue: 0,0:11:12.88,0:11:15.21,Default,,0,0,0,,Сол қуаныш үні... Ах!
Dialogue: 0,0:11:21.22,0:11:22.89,Default,,0,0,0,,(Бетховеннің жоғалған тыныс дыбысы)
Dialogue: 0,0:11:22.97,0:11:24.47,Default,,0,0,0,,Тыңдаңыз!
Dialogue: 0,0:11:27.10,0:11:29.98,Default,,0,0,0,,Сайыста жеңіске жеткенімді мақтан тұтамын.
Dialogue: 0,0:11:30.06,0:11:33.48,Default,,0,0,0,,Бірақ бұл эмо ойдан шығарылған эмо!
Dialogue: 0,0:11:34.11,0:11:38.24,Default,,0,0,0,,Біздің денемізге ұлы музыканттардың элементтері енгізілген.
Dialogue: 0,0:11:38.32,0:11:40.74,Default,,0,0,0,,Бұл есімді алған болмыс!
Dialogue: 0,0:11:41.32,0:11:46.16,Default,,0,0,0,,Қарапайым адамдардан жоғары шеберлік пен дарынмен жасанды түрде жасалған.
Dialogue: 0,0:11:46.24,0:11:48.58,Default,,0,0,0,,Эмо сапиенс
Dialogue: 0,0:11:49.33,0:11:50.87,Default,,0,0,0,,Бұл Декү.
Dialogue: 0,0:11:50.96,0:11:52.50,Default,,0,0,0,,Ондай нәрсе бар ма?
Dialogue: 0,0:11:52.58,0:11:54.84,Default,,0,0,0,,Ойланып қарасаңыз, ол есім...
Dialogue: 0,0:11:54.92,0:11:57.75,Default,,0,0,0,,А, бұл бұдан артық күдікті болуы мүмкін емес еді.
Dialogue: 0,0:11:57.84,0:11:59.34,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:11:59.42,0:12:00.76,Default,,0,0,0,,Иә? Неліктен?
Dialogue: 0,0:12:01.59,0:12:03.72,Default,,0,0,0,,Ол жеңімпаз
Dialogue: 0,0:12:03.80,0:12:05.64,Default,,0,0,0,,Чемпион өзі істегенін істеуі керек.
Dialogue: 0,0:12:05.72,0:12:07.64,Default,,0,0,0,,Бірақ жағдай осылай жалғаса берсе, біз де...
Dialogue: 0,0:12:07.72,0:12:10.27,Default,,0,0,0,,Ақырында сізге біртүрлі қарауға болады.
Dialogue: 0,0:12:10.35,0:12:12.02,Default,,0,0,0,,Тіпті егер...
Dialogue: 0,0:12:13.56,0:12:14.40,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:14.48,0:12:16.65,Default,,0,0,0,,Бұл ұлттық қастандық
Dialogue: 0,0:12:16.73,0:12:19.61,Default,,0,0,0,,Оның артында үкіметтің жоспары жасырылған.
Dialogue: 0,0:12:19.69,0:12:20.53,Default,,0,0,0,,(қосқышты басқан дыбыс)
Dialogue: 0,0:12:20.61,0:12:22.53,Default,,0,0,0,,(Көрермендердің айқайы)
Dialogue: 0,0:12:26.62,0:12:27.74,Default,,0,0,0,,Қауіпті!
Dialogue: 0,0:12:27.83,0:12:29.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:31.87,0:12:35.67,Default,,0,0,0,,Жоқ... Жоқ! Барлығыңыз асығыңыздар, тынышталыңыз және эвакуацияланыңыз!
Dialogue: 0,0:12:35.75,0:12:37.25,Default,,0,0,0,,Бұл да сахналанған ба?
Dialogue: 0,0:12:37.34,0:12:39.17,Default,,0,0,0,,Жасанды деген не?
Dialogue: 0,0:12:39.25,0:12:40.96,Default,,0,0,0,,Бұл қазірдің өзінде хаос...
Dialogue: 0,0:12:41.05,0:12:42.72,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:12:42.80,0:12:45.93,Default,,0,0,0,,Бұл лас үлкендердің соңғы күресі ме... Әй!
Dialogue: 0,0:12:47.39,0:12:51.81,Default,,0,0,0,,Біздің сахнаға аяқ киіміңді киіп шықпа!
Dialogue: 0,0:12:51.89,0:12:53.19,Default,,0,0,0,,Әй!
Dialogue: 0,0:12:54.02,0:12:55.27,Default,,0,0,0,,Уф... иә?
Dialogue: 0,0:12:55.35,0:12:56.19,Default,,0,0,0,,Иә! (Қара киім) Уа...
Dialogue: 0,0:12:56.27,0:12:57.44,Default,,0,0,0,,(Бірнеше қадам)
Dialogue: 0,0:12:57.44,0:12:58.69,Default,,0,0,0,,(Бірнеше қадам)
Dialogue: 0,0:12:57.44,0:12:58.69,Default,,0,0,0,,Сіз...
Dialogue: 0,0:12:58.69,0:12:59.07,Default,,0,0,0,,(Бірнеше қадам)
Dialogue: 0,0:13:00.53,0:13:01.36,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:05.66,0:13:06.20,Default,,0,0,0,,(Геликоптер ұшып бара жатқан дыбыс)
Dialogue: 0,0:13:06.20,0:13:07.70,Default,,0,0,0,,(Геликоптер ұшып бара жатқан дыбыс)
Dialogue: 0,0:13:06.20,0:13:07.70,Default,,0,0,0,,Фу…
Dialogue: 0,0:13:07.70,0:13:07.78,Default,,0,0,0,,(Геликоптер ұшып бара жатқан дыбыс)
Dialogue: 0,0:13:07.78,0:13:08.62,Default,,0,0,0,,(Геликоптер ұшып бара жатқан дыбыс)
Dialogue: 0,0:13:07.78,0:13:08.62,Default,,0,0,0,,Ой…
Dialogue: 0,0:13:08.70,0:13:10.62,Default,,0,0,0,,Хмм... Ах!
Dialogue: 0,0:13:14.71,0:13:18.38,Default,,0,0,0,,Мен шайқастан келесі жолы кездескенше кетемін.
Dialogue: 0,0:13:18.46,0:13:21.38,Default,,0,0,0,,Бүгінгі ойын сенікі...
Dialogue: 0,0:13:22.46,0:13:23.51,Default,,0,0,0,,Фу…
Dialogue: 0,0:13:24.47,0:13:26.89,Default,,0,0,0,,Өйткені мен оны құптамаймын.
Dialogue: 0,0:13:26.97,0:13:30.06,Default,,0,0,0,,Тағдыр қайда бұрылады
Dialogue: 0,0:13:30.14,0:13:33.27,Default,,0,0,0,,Мүмкін бір жерде тағы кездесерміз
Dialogue: 0,0:13:51.12,0:13:53.58,Default,,0,0,0,,Көмегіңе рахмет, сэр.
Dialogue: 0,0:13:54.12,0:13:55.75,Default,,0,0,0,,Мен көптен бері өлі болсам да
Dialogue: 0,0:14:07.51,0:14:10.01,Default,,0,0,0,,Олар нені ұмытты?
Dialogue: 0,0:14:11.05,0:14:12.97,Default,,0,0,0,,Менің айтайын дегенім, екінші орын алған адам кішкентай ғой, солай ма?
Dialogue: 0,0:14:13.06,0:14:14.31,Default,,0,0,0,,(Панда) Ол екі мектептің аралығындағы бір жерде босап шыққан болар, деп ойлаймын—
Dialogue: 0,0:14:14.39,0:14:15.93,Default,,0,0,0,,Бітті.
Dialogue: 0,0:14:16.56,0:14:19.23,Default,,0,0,0,,Мен неге екенін түсінбейтін сияқтымын...
Dialogue: 0,0:14:20.77,0:14:22.82,Default,,0,0,0,,Кешіріңіз (Бетховен және басқалар) Иә?
Dialogue: 0,0:14:22.90,0:14:24.99,Default,,0,0,0,,Мен жылдамырақ боламын
Dialogue: 0,0:14:25.07,0:14:29.16,Default,,0,0,0,,Егер мен сендермен әнді аяқтайтынымды білсем...
Dialogue: 0,0:14:29.24,0:14:32.41,Default,,0,0,0,,Егер бәріміз бірге жұмыс жасасақ...
Dialogue: 0,0:14:32.99,0:14:34.37,Default,,0,0,0,,Ха... (Моцарт) Ах!
Dialogue: 0,0:14:34.45,0:14:37.79,Default,,0,0,0,,Мұндай жағдайларда кешірім сұрамаңыз.
Dialogue: 0,0:14:37.87,0:14:39.37,Default,,0,0,0,,«Рахмет»
Dialogue: 0,0:14:41.29,0:14:43.75,Default,,0,0,0,,Аа... Дұрыс.
Dialogue: 0,0:14:44.38,0:14:46.13,Default,,0,0,0,,Барша адамның ішінде мен дәл осылай қысылып қалсам…
Dialogue: 0,0:14:46.21,0:14:49.01,Default,,0,0,0,,Бұл сенсің, Моцарт.
Dialogue: 0,0:14:49.09,0:14:52.26,Default,,0,0,0,,Жақсы, жақсы күрестік деп ойлаймын.
Dialogue: 0,0:14:52.85,0:14:56.02,Default,,0,0,0,,Өте жақсы болды, төртеуміз бірге ән айттық
Dialogue: 0,0:14:56.93,0:14:58.52,Default,,0,0,0,,Бетховен…
Dialogue: 0,0:14:58.60,0:15:01.23,Default,,0,0,0,,Аты...
Dialogue: 0,0:15:01.31,0:15:04.02,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:15:05.73,0:15:10.11,Default,,0,0,0,,Бір қарсыластан екі рет жеңіліп қалдық
Dialogue: 0,0:15:10.20,0:15:14.87,Default,,0,0,0,,Бірақ ән айтуды тоқтатпасаңыз, қайта-қайта тырысуға болады!
Dialogue: 0,0:15:15.45,0:15:17.08,Default,,0,0,0,,Бәрінен де ән айтқым келмейді.
Dialogue: 0,0:15:17.16,0:15:18.79,Default,,0,0,0,,Даданы илеп жүрсем де.
Dialogue: 0,0:15:18.87,0:15:21.12,Default,,0,0,0,,Иә, иә, су құймаңыз.
Dialogue: 0,0:15:21.21,0:15:25.13,Default,,0,0,0,,Бұл жолы біз сізді әнімізбен қарсы аламыз
Dialogue: 0,0:15:25.21,0:15:26.55,Default,,0,0,0,,Фу…
Dialogue: 0,0:15:26.63,0:15:29.88,Default,,0,0,0,,Сонымен? Енді не істейсіз?
Dialogue: 0,0:15:29.97,0:15:31.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:31.38,0:15:35.14,Default,,0,0,0,,Ал, әзірге...
Dialogue: 0,0:15:36.51,0:15:39.68,Default,,0,0,0,,Дүниеде өтіріктің тұқымы себілді
Dialogue: 0,0:15:39.77,0:15:43.27,Default,,0,0,0,,Күмән туады ма, жоқ па?
Dialogue: 0,0:15:43.36,0:15:47.53,Default,,0,0,0,,Ақыры мақсатыма жеттім, бірақ түсінбеймін.
Dialogue: 0,0:15:47.61,0:15:48.74,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:15:48.82,0:15:53.99,Default,,0,0,0,,Бұл тек менде емес, сізде де болуы керек.
Dialogue: 0,0:15:54.07,0:15:57.99,Default,,0,0,0,,Кеудемде әлі күнге дейін лаулаған ыстық жалын бар...
Dialogue: 0,0:15:58.08,0:15:59.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:00.08,0:16:01.67,Default,,0,0,0,,Сол соңғы ән...
Dialogue: 0,0:16:01.75,0:16:04.33,Default,,0,0,0,,Олар жеңіске жеткендей болды.
Dialogue: 0,0:16:04.42,0:16:08.46,Default,,0,0,0,,Дүниеде қандай нәтиже болса да, қандай баға болса да
Dialogue: 0,0:16:08.55,0:16:09.84,Default,,0,0,0,,Мен осылай сезіндім
Dialogue: 0,0:16:09.92,0:16:11.55,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:16:11.63,0:16:13.97,Default,,0,0,0,,Ереже бойынша қанша жеңсеңіз де,
Dialogue: 0,0:16:14.05,0:16:17.43,Default,,0,0,0,,Өзімді аянышты сезінемін, мейірім берілгендей.
Dialogue: 0,0:16:17.51,0:16:18.35,Default,,0,0,0,,Иә
Dialogue: 0,0:16:18.43,0:16:21.98,Default,,0,0,0,,Сондықтан мен мәселені шешуім керек...
Dialogue: 0,0:16:22.81,0:16:26.86,Default,,0,0,0,,Дүниеден де, өз кекімізден де артық.
Dialogue: 0,0:16:26.94,0:16:29.73,Default,,0,0,0,,Мен бұған себепкер болған адамды қағып алғым келеді.
Dialogue: 0,0:16:30.53,0:16:32.61,Default,,0,0,0,,Бұл қайталайтыныңызды білдіре ме?
Dialogue: 0,0:16:32.70,0:16:37.28,Default,,0,0,0,,Бұл қалау, құштарлық, тілек
Dialogue: 0,0:16:37.37,0:16:40.62,Default,,0,0,0,,Ешқандай қарсылық немесе қарсылық болуы мүмкін емес...
Dialogue: 0,0:16:40.70,0:16:42.25,Default,,0,0,0,,Эй, күт!
Dialogue: 0,0:16:44.79,0:16:49.34,Default,,0,0,0,,Кеттік. Оның сөзін алсақ, бұл кек алу.
Dialogue: 0,0:16:49.42,0:16:52.34,Default,,0,0,0,,Иә! Олар жылап, жеңілгенін мойындайтыны сонша.
Dialogue: 0,0:16:52.42,0:16:54.76,Default,,0,0,0,,Мен сені өлтіремін
Dialogue: 0,0:16:55.26,0:16:58.64,Default,,0,0,0,,Жеңіс атағы - Карисома
Dialogue: 0,0:16:58.72,0:17:01.10,Default,,0,0,0,,Біздің жолымыз – пұттар
Dialogue: 0,0:17:01.18,0:17:03.02,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:17:03.81,0:17:05.52,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:17:10.07,0:17:11.53,Default,,0,0,0,,Бұл бәрібір дәмді.
Dialogue: 0,0:17:12.61,0:17:13.78,Default,,0,0,0,,Иә? Бұл дұрыс
Dialogue: 0,0:17:13.86,0:17:15.95,Default,,0,0,0,,Раменнен бас тарттыңыз ба?
Dialogue: 0,0:17:16.03,0:17:17.16,Default,,0,0,0,,Қылмыстық құқық бұзушылық…
Dialogue: 0,0:17:17.24,0:17:19.87,Default,,0,0,0,,Әй, күнәнің дәмі.
Dialogue: 0,0:17:20.37,0:17:23.29,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:17:25.87,0:17:28.00,Default,,0,0,0,,(Бетховеннің ұйқысы)
Dialogue: 0,0:17:28.08,0:17:29.29,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:31.05,0:17:34.30,Default,,0,0,0,,Хмм... мм?
Dialogue: 0,0:17:34.38,0:17:37.05,Default,,0,0,0,,Уау, бұл ұзақ болды!
Dialogue: 0,0:17:38.09,0:17:39.26,Default,,0,0,0,,Алдымен барайық
Dialogue: 0,0:17:39.35,0:17:42.14,Default,,0,0,0,,Әй, сен менің оятқышымды тағы да тоқтаттың!
Dialogue: 0,0:17:42.72,0:17:45.06,Default,,0,0,0,,Қоңырау соғып, қатты шықты.
Dialogue: 0,0:17:45.14,0:17:46.77,Default,,0,0,0,,Оянбағаның үшін сен кінәлісің.
Dialogue: 0,0:17:46.85,0:17:49.19,Default,,0,0,0,,Мені оятқаның өте жақсы!
Dialogue: 0,0:17:49.27,0:17:52.57,Default,,0,0,0,,Мені бір рет ояту жеткілікті. Сонда кездескенше.
Dialogue: 0,0:17:52.65,0:17:53.82,Default,,0,0,0,,Эй!
Dialogue: 0,0:17:56.03,0:17:57.41,Default,,0,0,0,,Сәлем, Лист мырза.
Dialogue: 0,0:17:57.49,0:17:59.32,Default,,0,0,0,,Бұл шынымен де тізім болды, солай емес пе?
Dialogue: 0,0:17:59.41,0:18:01.53,Default,,0,0,0,,Сіздің денеңіздің бір бөлігі ғана.
Dialogue: 0,0:18:01.62,0:18:03.20,Default,,0,0,0,,Сіз енді Кабукимен айналыспайсыз ба?
Dialogue: 0,0:18:03.29,0:18:05.87,Default,,0,0,0,,Дүкеннің аты Огуни болды, солай ма?
Dialogue: 0,0:18:05.96,0:18:07.96,Default,,0,0,0,,Мен де Листтің өнерін көргім келеді.
Dialogue: 0,0:18:08.04,0:18:12.17,Default,,0,0,0,,Ахаха... Мен мұны бір күні жасай аламын деп үміттенемін.
Dialogue: 0,0:18:12.25,0:18:16.34,Default,,0,0,0,,Аа, дұрыс. Бүгін бәріміз түскі ас ішеміз бе?
Dialogue: 0,0:18:16.42,0:18:19.09,Default,,0,0,0,,Отоза маған тағы да көп түскі ас қораптарын жасады.
Dialogue: 0,0:18:19.18,0:18:21.10,Default,,0,0,0,,Е, же! Уау~ мен оны жегім келеді!
Dialogue: 0,0:18:21.18,0:18:23.68,Default,,0,0,0,,Әдеттегідей адам...
Dialogue: 0,0:18:24.18,0:18:27.64,Default,,0,0,0,,Бірақ сіздің денсаулығыңыз бұрынғыдан да жақсы ма? Ха...
Dialogue: 0,0:18:31.52,0:18:34.86,Default,,0,0,0,,Содан бері әлемге не болды?
Dialogue: 0,0:18:34.94,0:18:36.61,Default,,0,0,0,,Мен көмектесе алмаймын
Dialogue: 0,0:18:36.69,0:18:40.07,Default,,0,0,0,,Дис＝Кордтың жігіттері жоғалып кетті.
Dialogue: 0,0:18:40.16,0:18:43.70,Default,,0,0,0,,Ғаламторға анда-санда жаңа ән саламын, ол қызу тақырыпқа айналады.
Dialogue: 0,0:18:45.16,0:18:49.33,Default,,0,0,0,,Біз өзіміз өте бос болдық.
Dialogue: 0,0:18:50.08,0:18:54.30,Default,,0,0,0,,Мен байқауда екінші орын алғандықтан ғана назар аударып отырғаным емес.
Dialogue: 0,0:18:54.38,0:18:59.59,Default,,0,0,0,,Бір нәрсе болуы мүмкін, таң қалған адамдарға назар аударыңыз ...
Dialogue: 0,0:18:59.68,0:19:01.59,Default,,0,0,0,,Бұл өте маңызды емес.
Dialogue: 0,0:19:02.39,0:19:07.10,Default,,0,0,0,,Сахна болса, біз сол жерде ән шырқаймыз.
Dialogue: 0,0:19:07.18,0:19:10.85,Default,,0,0,0,,Айналаңыздағылардың әсерінен жағдай өзгерсе де
Dialogue: 0,0:19:10.94,0:19:14.57,Default,,0,0,0,,Негізінде өзгермейтін кейбір нәрселер бар.
Dialogue: 0,0:19:14.65,0:19:15.94,Default,,0,0,0,,Бех
Dialogue: 0,0:19:17.19,0:19:18.53,Default,,0,0,0,,Фу…
Dialogue: 0,0:19:20.07,0:19:22.12,Default,,0,0,0,,Бір үлкен нәрсе
Dialogue: 0,0:19:22.95,0:19:26.12,Default,,0,0,0,,Мибараки мырза біздің алдымызда жоғалып кетті.
Dialogue: 0,0:19:26.79,0:19:28.33,Default,,0,0,0,,Елеусіз—
Dialogue: 0,0:19:28.41,0:19:31.08,Default,,0,0,0,,Ол мен сенетін адам болуы мүмкін, бірақ мен білмедім.
Dialogue: 0,0:19:31.58,0:19:34.17,Default,,0,0,0,,Өйткені, мен кеткенде өзімді жалғыз сезінемін.
Dialogue: 0,0:19:43.47,0:19:47.39,Default,,0,0,0,,Ватару!
Dialogue: 0,0:20:01.99,0:20:05.45,Default,,0,0,0,,Хаха...
Dialogue: 0,0:20:09.12,0:20:11.16,Default,,0,0,0,,Керемет! Бауырым, сен боксшысың ба?
Dialogue: 0,0:20:12.79,0:20:15.46,Default,,0,0,0,,Жоқ, бұл Бетховен!
Dialogue: 0,0:20:16.04,0:20:20.05,Default,,0,0,0,,♪～
Dialogue: 0,0:21:41.05,0:21:45.97,Default,,0,0,0,,～♪
Dialogue: 0,0:21:47.55,0:21:48.72,Default,,0,0,0,,Кеш болды.
Dialogue: 0,0:21:49.55,0:21:52.47,Default,,0,0,0,,Төртеумізбен бірге тікелей эфирде шоу көрмегенімізге көп болды.
Dialogue: 0,0:21:53.31,0:21:56.73,Default,,0,0,0,,Ұлы адамдардың факторлары ғана емес, сіздің денеңізге арналған оятқыш
Dialogue: 0,0:21:56.81,0:21:59.61,Default,,0,0,0,,Оған тек имплант керек.
Dialogue: 0,0:21:59.69,0:22:01.36,Default,,0,0,0,,Иа... сөзсіз.
Dialogue: 0,0:22:01.44,0:22:03.48,Default,,0,0,0,,Айырмашылық болуы керек...
Dialogue: 0,0:22:03.57,0:22:06.15,Default,,0,0,0,,Сіз бір бөлмені бөлісуге де жауаптысыз.
Dialogue: 0,0:22:06.24,0:22:07.99,Default,,0,0,0,,Оны неге жалғыз қалдырасың?
Dialogue: 0,0:22:08.07,0:22:09.49,Default,,0,0,0,,Ал...
Dialogue: 0,0:22:09.49,0:22:10.16,Default,,0,0,0,,Ал...
Dialogue: 0,0:22:09.49,0:22:10.16,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:22:10.16,0:22:10.24,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:22:10.24,0:22:12.08,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:22:10.24,0:22:12.08,Default,,0,0,0,,А, қарашы, мен естідім.
Dialogue: 0,0:22:12.16,0:22:13.49,Default,,0,0,0,,Жаман мен кешігіп қалдым!
Dialogue: 0,0:22:13.58,0:22:15.25,Default,,0,0,0,,Бұлхо! Уф...
Dialogue: 0,0:22:15.33,0:22:18.46,Default,,0,0,0,,Кеш болды. Мен қозғалған сайын киімімді ауыстырамын.
Dialogue: 0,0:22:18.54,0:22:19.79,Default,,0,0,0,,Жалқау болмаңыз
Dialogue: 0,0:22:19.88,0:22:20.84,Default,,0,0,0,,Мм... (Бетховен) Иә?
Dialogue: 0,0:22:20.92,0:22:23.09,Default,,0,0,0,,Жүр, кеттік~
Dialogue: 0,0:22:23.17,0:22:27.26,Default,,0,0,0,,Әй... күт, мені де тыңда.
Dialogue: 0,0:22:27.34,0:22:28.68,Default,,0,0,0,,Ақтау жоқ!
Dialogue: 0,0:22:28.76,0:22:30.68,Default,,0,0,0,,Әнді тыңдау жеткілікті
Dialogue: 0,0:22:30.76,0:22:33.14,Default,,0,0,0,,Аузыңыздан қолдарыңызды және аяқтарыңызды жылжытыңыз.
Dialogue: 0,0:22:33.22,0:22:34.97,Default,,0,0,0,,Әй, киім ауыстырып жүр!
Dialogue: 0,0:22:35.06,0:22:36.68,Default,,0,0,0,,Көп айтпа!
Dialogue: 0,0:22:36.77,0:22:39.40,Default,,0,0,0,,Аха... Сәттілік~
Dialogue: 0,0:22:42.82,0:22:43.40,Default,,0,0,0,,Тізім
Dialogue: 0,0:22:43.40,0:22:43.90,Default,,0,0,0,,Тізім
Dialogue: 0,0:22:43.40,0:22:43.90,Default,,0,0,0,,♪ (Фортепиано: «Қанаттардың тәтті дыбысынан мазасыз...»)
Dialogue: 0,0:22:43.90,0:22:47.40,Default,,0,0,0,,♪ (Фортепиано: «Қанаттардың тәтті дыбысынан мазасыз...»)
Dialogue: 0,0:22:52.49,0:22:54.16,Default,,0,0,0,,Шопен
Dialogue: 0,0:22:54.24,0:22:58.25,Default,,0,0,0,,♪ (Фортепиано: «Этюд эволюциясы»)
Dialogue: 0,0:23:02.75,0:23:04.42,Default,,0,0,0,,Моцарт
Dialogue: 0,0:23:04.50,0:23:08.51,Default,,0,0,0,,♪ (фортепиано: «Kiss and Nachtmusik»)
Dialogue: 0,0:23:13.51,0:23:14.68,Default,,0,0,0,,Бетховен
Dialogue: 0,0:23:14.76,0:23:18.77,Default,,0,0,0,,♪ (Фортепиано: «ТАҒДЫР МЕНІК»)
Dialogue: 0,0:23:25.78,0:23:28.24,Default,,0,0,0,,Менің атым Сальери
Dialogue: 0,0:23:28.32,0:23:31.03,Default,,0,0,0,,Қызғаныш отына бағын
Dialogue: 0,0:23:28.32,0:23:31.03,Default,,0,0,0,,Ватару!
Dialogue: 0,0:23:31.03,0:23:31.11,Default,,0,0,0,,Ватару!
Dialogue: 0,0:23:31.11,0:23:32.32,Default,,0,0,0,,Ватару!
Dialogue: 0,0:23:31.11,0:23:32.32,Default,,0,0,0,,Нағыз кек алу
Dialogue: 0,0:23:32.32,0:23:34.33,Default,,0,0,0,,Нағыз кек алу
Dialogue: 0,0:23:34.87,0:23:36.91,Default,,0,0,0,,Келесі жолы...
Dialogue: 0,0:23:36.99,0:23:38.41,Default,,0,0,0,,Фу…
Dialogue: 0,0:23:39.91,0:23:45.91,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory