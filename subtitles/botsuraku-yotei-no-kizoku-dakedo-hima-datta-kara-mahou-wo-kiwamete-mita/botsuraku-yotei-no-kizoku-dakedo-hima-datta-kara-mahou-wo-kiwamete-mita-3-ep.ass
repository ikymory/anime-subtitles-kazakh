Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.00,0:00:07.84,Default,,0,0,0,,♪～
Dialogue: 0,0:00:07.84,0:00:10.13,Default,,0,0,0,,Бұл соншалықты үлкен мәселе ме?
Dialogue: 0,0:00:10.13,0:00:14.01,Default,,0,0,0,,《Лиам: Мәртебелі Скарлетт Шерри Джамил...》
Dialogue: 0,0:01:49.61,0:01:53.78,Default,,0,0,0,,Менің атым Лиам Гамильтон. (Қызыл) Басыңды көтер.
Dialogue: 0,0:01:53.78,0:01:56.78,Default,,0,0,0,,біреу сол адамға орын береді
Dialogue: 0,0:01:56.78,0:01:58.78,Default,,0,0,0,,Енді көп ұзамай
Dialogue: 0,0:01:58.78,0:02:03.24,Default,,0,0,0,,Карнеба катапиллері мен алып бақаны жеңу оқиғасы.
Dialogue: 0,0:02:03.24,0:02:06.62,Default,,0,0,0,,Сізден естісем болады ма?
Dialogue: 0,0:02:06.62,0:02:09.42,Default,,0,0,0,,《Жарайды, егер солай болса...》
Dialogue: 0,0:02:14.13,0:02:16.26,Default,,0,0,0,,Түсіндім, бұл қызық.
Dialogue: 0,0:02:16.26,0:02:18.26,Default,,0,0,0,,Әсіресе алып бақа
Dialogue: 0,0:02:18.26,0:02:21.80,Default,,0,0,0,,Жетілдірілген сиқырды қолданбай бағындыру туралы бірінші рет естуім.
Dialogue: 0,0:02:21.80,0:02:25.81,Default,,0,0,0,,Сіз ше? (Джеймс) Мен білмеймін.
Dialogue: 0,0:02:25.81,0:02:31.15,Default,,0,0,0,,Бұл жетілдірілген сиқыр және оның бірден жойылуы қалыпты жағдай.
Dialogue: 0,0:02:31.15,0:02:36.28,Default,,0,0,0,,《Жетілдірілген сиқыр! Мен бұл қалай деп ойлаймын. Мен оны бір күні пайдаланғым келеді.
Dialogue: 0,0:02:36.28,0:02:38.99,Default,,0,0,0,,Және таныс келісімшарт
Dialogue: 0,0:02:38.99,0:02:41.66,Default,,0,0,0,,Мен әңгімені естідім.
Dialogue: 0,0:02:41.66,0:02:43.99,Default,,0,0,0,,Маған осы жерден көрсете аласыз ба?
Dialogue: 0,0:02:43.99,0:02:46.83,Default,,0,0,0,,《Мен беделді содан бері сезінемін.
Dialogue: 0,0:02:46.83,0:02:51.29,Default,,0,0,0,,Сіз маған қысым көрсетуге тырысасыз ба?
Dialogue: 0,0:02:51.29,0:02:54.30,Default,,0,0,0,,Одан да...》
Dialogue: 0,0:02:54.30,0:02:57.84,Default,,0,0,0,,Кешіріңіз, бұл мүмкін емес.
Dialogue: 0,0:02:57.84,0:03:00.47,Default,,0,0,0,,Менің өтінішімді тыңдай алмаймын дейсіз бе?
Dialogue: 0,0:03:00.47,0:03:05.18,Default,,0,0,0,,Иә, достарыңды спектакльге айналдыра алмайсың!
Dialogue: 0,0:03:10.48,0:03:14.19,Default,,0,0,0,,Хехехе... Екі жағы бірдей ме?
Dialogue: 0,0:03:14.19,0:03:16.86,Default,,0,0,0,,Не? барған сайын қызықты
Dialogue: 0,0:03:16.86,0:03:20.49,Default,,0,0,0,,Сабанды екі рет қуантқандар көп емес.
Dialogue: 0,0:03:20.49,0:03:23.03,Default,,0,0,0,,Ол үшін мен сені марапаттауым керек.
Dialogue: 0,0:03:23.03,0:03:25.03,Default,,0,0,0,,Екі рет?
Dialogue: 0,0:03:25.03,0:03:27.49,Default,,0,0,0,,Мен Лиамға барон атағын беремін!
Dialogue: 0,0:03:27.49,0:03:30.21,Default,,0,0,0,,Не, барон?
Dialogue: 0,0:03:30.21,0:03:33.71,Default,,0,0,0,,Бірақ мен ештеңе істеген жоқпын, жетістіктер сияқты...
Dialogue: 0,0:03:33.71,0:03:37.50,Default,,0,0,0,,Сабанды екі рет сауықтырса жеткілікті.
Dialogue: 0,0:03:37.50,0:03:41.05,Default,,0,0,0,,Қызыңды ұзатқаннан әлдеқайда жақсы
Dialogue: 0,0:03:43.22,0:03:45.22,Default,,0,0,0,,Олай болса, мұны да жасайық.
Dialogue: 0,0:03:45.22,0:03:48.22,Default,,0,0,0,,Бұл не? (Қызыл) Фамилия
Dialogue: 0,0:03:48.22,0:03:51.06,Default,,0,0,0,,Таныс келісім-шарт емле дәптері
Dialogue: 0,0:03:51.06,0:03:55.06,Default,,0,0,0,,Ха... уау!
Dialogue: 0,0:03:55.06,0:03:57.52,Default,,0,0,0,,Рахмет! рақмет сізге!
Dialogue: 0,0:03:57.52,0:04:02.07,Default,,0,0,0,,Хахахаха... Барондықтан да сиқырлы кітап
Dialogue: 0,0:04:02.07,0:04:04.74,Default,,0,0,0,,Ол өте қызық бала.
Dialogue: 0,0:04:08.54,0:04:11.25,Default,,0,0,0,,Таныс келісім-шарт сиқырлы Familia
Dialogue: 0,0:04:11.25,0:04:13.25,Default,,0,0,0,,Мұны да үйренгенше
Dialogue: 0,0:04:13.25,0:04:17.09,Default,,0,0,0,,Сиқырлы кітапты жіберсем, келісім-шарт бұзыла ма?
Dialogue: 0,0:04:17.09,0:04:19.09,Default,,0,0,0,,(аяқ дыбыстары)
Dialogue: 0,0:04:19.09,0:04:22.93,Default,,0,0,0,,Бұл тағы да сиқыр ма? Бруно-нии-сан, сен неге мұндасың?
Dialogue: 0,0:04:22.93,0:04:25.39,Default,,0,0,0,,Қонаққа келгеніңіз жақсы емес пе?
Dialogue: 0,0:04:25.39,0:04:30.27,Default,,0,0,0,,Мен сізді естідім! Барон болғанын естідім.
Dialogue: 0,0:04:30.27,0:04:35.56,Default,,0,0,0,,Хахаха... Әлбревитодан келген жігіт қазір өкініп жатса керек.
Dialogue: 0,0:04:35.56,0:04:38.11,Default,,0,0,0,,Не? Бірінші орында
Dialogue: 0,0:04:38.11,0:04:42.78,Default,,0,0,0,,Іс жүзінде сіз қазір әкеңізден жоғары қызметтесіз.
Dialogue: 0,0:04:42.78,0:04:44.95,Default,,0,0,0,,Бірақ мен баронмын.
Dialogue: 0,0:04:44.95,0:04:46.95,Default,,0,0,0,,Бұл елдің тектілігі
Dialogue: 0,0:04:46.95,0:04:48.95,Default,,0,0,0,,Өз бетінше із қалдырған алғашқы буын
Dialogue: 0,0:04:48.95,0:04:51.58,Default,,0,0,0,,Бұл тек бізге мұра болып қалған нәрсе және ол басқаларға бөлінеді.
Dialogue: 0,0:04:51.58,0:04:53.79,Default,,0,0,0,,Жетістікке жеткен адамдар жақсырақ
Dialogue: 0,0:04:53.79,0:04:57.13,Default,,0,0,0,,Бұл керемет. Осыны айтып тұрсың ба?
Dialogue: 0,0:04:57.13,0:04:59.13,Default,,0,0,0,,Жарайсың!
Dialogue: 0,0:04:59.13,0:05:01.96,Default,,0,0,0,,Өтінемін, мына сұм әкеден асып түс.
Dialogue: 0,0:05:03.80,0:05:05.80,Default,,0,0,0,,《Лиам: Мен сияқтымын.
Dialogue: 0,0:05:05.80,0:05:09.47,Default,,0,0,0,,Әкесінің дәрежесінен іс жүзінде асып түскендей.
Dialogue: 0,0:05:09.47,0:05:12.81,Default,,0,0,0,,Ах... Қайырлы кеш.
Dialogue: 0,0:05:12.81,0:05:15.81,Default,,0,0,0,,Хмм, қазір қараңыз.
Dialogue: 0,0:05:15.81,0:05:19.48,Default,,0,0,0,,Альбревито-ниисан?
Dialogue: 0,0:05:19.48,0:05:21.48,Default,,0,0,0,,《Бұл қалай болды?
Dialogue: 0,0:05:21.48,0:05:24.49,Default,,0,0,0,,Ол тек бесінші ұл болуы керек еді.
Dialogue: 0,0:05:24.49,0:05:27.66,Default,,0,0,0,,Солай ма, барон? Өзіңізді мазақ етпеңіз! 》
Dialogue: 0,0:05:27.66,0:05:31.12,Default,,0,0,0,,Лиам-саманың соңғы әрекеттері таң қалдырды~
Dialogue: 0,0:05:31.12,0:05:33.83,Default,,0,0,0,,Дұрыс, әсіресе сиқыр.
Dialogue: 0,0:05:33.83,0:05:35.96,Default,,0,0,0,,Сәлем, балалар!
Dialogue: 0,0:05:35.96,0:05:38.83,Default,,0,0,0,,Егер сізге оны қатты ұнатсаңыз, бұл жерден кетіңіз.
Dialogue: 0,0:05:38.83,0:05:42.13,Default,,0,0,0,,Барон Лиам Гамильтонға бару керек!
Dialogue: 0,0:05:42.13,0:05:46.51,Default,,0,0,0,,Құрметті Альбревито мырза…｡ Мен де кешірім сұраймын!
Dialogue: 0,0:05:46.51,0:05:50.14,Default,,0,0,0,,Эй, сен кім жақсы деп ойлайсың, мен бе әлде Лиам ма?
Dialogue: 0,0:05:50.14,0:05:53.85,Default,,0,0,0,,Ах...｡ Графтың ұлы мен барон
Dialogue: 0,0:05:53.85,0:05:56.14,Default,,0,0,0,,Қайсысы жақсы екенін естідім.
Dialogue: 0,0:05:56.14,0:05:58.52,Default,,0,0,0,,Уақыт аса маңызды.
Dialogue: 0,0:05:58.52,0:06:01.52,Default,,0,0,0,,Бұл Альбребит мырза!
Dialogue: 0,0:06:01.52,0:06:04.53,Default,,0,0,0,,Хмф!
Dialogue: 0,0:06:04.53,0:06:06.53,Default,,0,0,0,,《Мен саған еңбегіңді беремін!
Dialogue: 0,0:06:06.53,0:06:09.87,Default,,0,0,0,,Егер ол мұны істей алса, мен мұны істей алмаймын! 》
Dialogue: 0,0:06:15.87,0:06:18.87,Default,,0,0,0,,Ей, анау... Ол сондай әдемі!
Dialogue: 0,0:06:18.87,0:06:20.88,Default,,0,0,0,,(ысқырық)
Dialogue: 0,0:06:23.55,0:06:26.88,Default,,0,0,0,,Үздіксіз қолдау көрсеткеніңіз үшін тағы да рахмет.
Dialogue: 0,0:06:26.88,0:06:28.88,Default,,0,0,0,,Мастер
Dialogue: 0,0:06:28.88,0:06:31.18,Default,,0,0,0,,Иә!? Мастер?
Dialogue: 0,0:06:31.18,0:06:35.18,Default,,0,0,0,,Біз қожайын мен қызметші қарым-қатынасына түскендіктен, сіз менің қожайынымсыз, солай ма?
Dialogue: 0,0:06:35.18,0:06:39.90,Default,,0,0,0,,Аа, жоқ, жарайды, мені әдеттегідей атыммен шақыр.
Dialogue: 0,0:06:39.90,0:06:42.56,Default,,0,0,0,,Хмм, жарайды.
Dialogue: 0,0:06:42.56,0:06:44.90,Default,,0,0,0,,Онда мен сені Лиам-кун деп атаймын.
Dialogue: 0,0:06:44.90,0:06:49.20,Default,,0,0,0,,Yeah, then. (Асуна) Бірақ мен түсінемін.
Dialogue: 0,0:06:49.20,0:06:51.41,Default,,0,0,0,,Соңғы кездері ол әдемі көрінді.
Dialogue: 0,0:06:51.41,0:06:53.41,Default,,0,0,0,,Сіз маған сене аласыз!
Dialogue: 0,0:06:53.41,0:06:58.58,Default,,0,0,0,,Менен кіші болсаң да, Мен сені қожайынымдай сезінемін.
Dialogue: 0,0:06:58.58,0:07:02.92,Default,,0,0,0,,Иә, солай... қасында жүргенде жүрегіңді елжірететін дүниелер.
Dialogue: 0,0:07:05.59,0:07:09.22,Default,,0,0,0,,《Лиам: Ахаха... Менің көзім ауырады》
Dialogue: 0,0:07:09.22,0:07:11.22,Default,,0,0,0,,(жөтел жөтел)\NМен бұл
Dialogue: 0,0:07:11.22,0:07:13.93,Default,,0,0,0,,Бұдан былай бірге той жасаймыз деу дұрыс па?
Dialogue: 0,0:07:13.93,0:07:18.23,Default,,0,0,0,,Әрине! Иә, мен сенімен боламын.
Dialogue: 0,0:07:18.23,0:07:21.44,Default,,0,0,0,,көремін. Сосын тағы.
Dialogue: 0,0:07:21.44,0:07:24.77,Default,,0,0,0,,Nice to meet you. (Джоди) Иә. (Asuna) Yes!
Dialogue: 0,0:07:29.44,0:07:31.45,Default,,0,0,0,,Asuna-chan!
Dialogue: 0,0:07:31.45,0:07:33.45,Default,,0,0,0,,ｵｯｹｰ！
Dialogue: 0,0:07:33.45,0:07:36.24,Default,,0,0,0,,ﾊｯ！
Dialogue: 0,0:07:36.24,0:07:39.79,Default,,0,0,0,,Өйткені, Асунаның қимылдары бұрынғысынан да жақсы.
Dialogue: 0,0:07:39.79,0:07:42.46,Default,,0,0,0,,Эхехе~｡ Бұл керемет.
Dialogue: 0,0:07:42.46,0:07:46.80,Default,,0,0,0,,Мен бұрынғыдан әлдеқайда жақсы көремін. Көру жақсы ма?
Dialogue: 0,0:07:46.80,0:07:49.46,Default,,0,0,0,,Көз – садақшының қаны.
Dialogue: 0,0:07:49.46,0:07:52.97,Default,,0,0,0,,Қарсыласыңды көре алмасаң, бірінші кезекте оны көздей алмайсың.
Dialogue: 0,0:07:52.97,0:07:56.26,Default,,0,0,0,,Бұл сіз неғұрлым көп көре алсаңыз, соғұрлым жақсы дегенді білдіре ме?
Dialogue: 0,0:07:56.26,0:07:58.97,Default,,0,0,0,,Иә, бұл жерде ештеңе жоқ.
Dialogue: 0,0:07:58.97,0:08:00.98,Default,,0,0,0,,Кем дегенде хабарласып қойсаңыз болар еді!
Dialogue: 0,0:08:00.98,0:08:03.27,Default,,0,0,0,,ﾋﾞﾙﾄﾞｱｯﾌﾟ
Dialogue: 0,0:08:03.27,0:08:05.81,Default,,0,0,0,,О! Oh, oh, oh...
Dialogue: 0,0:08:05.81,0:08:10.28,Default,,0,0,0,,Уф…
Dialogue: 0,0:08:10.28,0:08:13.99,Default,,0,0,0,,Мен енді алысты көре аламын.
Dialogue: 0,0:08:13.99,0:08:15.99,Default,,0,0,0,,Сіз не істедіңіз?
Dialogue: 0,0:08:15.99,0:08:18.83,Default,,0,0,0,,Мен оның көзіне күшті сиқырладым.
Dialogue: 0,0:08:18.83,0:08:21.12,Default,,0,0,0,,А, сен мұны істей аласың ба!?
Dialogue: 0,0:08:21.12,0:08:24.00,Default,,0,0,0,,Мұны маған да қолдануға бола ма?
Dialogue: 0,0:08:24.00,0:08:28.30,Default,,0,0,0,,Мен оны Асунаға ұсынбаймын. Е, неге!
Dialogue: 0,0:08:28.30,0:08:30.84,Default,,0,0,0,,Шабуыл күшін арттыру мүмкін болса да
Dialogue: 0,0:08:30.84,0:08:33.51,Default,,0,0,0,,Бұл сіздің денеңізге салмақ түсіреді.
Dialogue: 0,0:08:33.51,0:08:37.14,Default,,0,0,0,,Бірдеңені соғып, өз сүйегі сынған адам
Dialogue: 0,0:08:37.14,0:08:40.14,Default,,0,0,0,,Бұл кейде болады. А, түсіндім.
Dialogue: 0,0:08:40.14,0:08:43.02,Default,,0,0,0,,Бірақ бұл сіздің көру қабілетіңіз болса, онда ешқандай проблема жоқ, солай ма?
Dialogue: 0,0:08:43.02,0:08:45.02,Default,,0,0,0,,Расында!
Dialogue: 0,0:08:47.86,0:08:51.03,Default,,0,0,0,,Мен жеңдім! (Асуна) Уау, бұл керемет!
Dialogue: 0,0:08:51.03,0:08:53.03,Default,,0,0,0,,Бір соққыда осындай қашықтықтан олжаны ұстау!
Dialogue: 0,0:08:53.03,0:08:57.03,Default,,0,0,0,,Лиам-кунның арқасында біз бұрын мұны істей алмадық.
Dialogue: 0,0:08:57.03,0:09:00.70,Default,,0,0,0,,Иә, түсіндім! Лиамға рахмет
Dialogue: 0,0:09:00.70,0:09:02.70,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:09:02.70,0:09:04.71,Default,,0,0,0,,Хахаха…
Dialogue: 0,0:09:06.88,0:09:11.17,Default,,0,0,0,,Қозғалатын адам бар ма! Жарайды, жүр!
Dialogue: 0,0:09:11.17,0:09:13.17,Default,,0,0,0,,Не?
Dialogue: 0,0:09:13.17,0:09:15.18,Default,,0,0,0,,Эй, бірдеңе дұрыс емес пе?
Dialogue: 0,0:09:15.18,0:09:18.18,Default,,0,0,0,,Мұны Гамильтонның үлкен ұлы жасады.
Dialogue: 0,0:09:18.18,0:09:23.06,Default,,0,0,0,,Пломбаны бұзғаннан кейін мен үлкен дәрежеде сәтсіздікке ұшырадым!
Dialogue: 0,0:09:23.06,0:09:26.06,Default,,0,0,0,,Мөр...
Dialogue: 0,0:09:26.06,0:09:28.36,Default,,0,0,0,,)
Dialogue: 0,0:09:28.36,0:09:30.36,Default,,0,0,0,,Әй, Лиам-кун!
Dialogue: 0,0:09:30.36,0:09:32.90,Default,,0,0,0,,《Бұл менің кінәм, мен кетуім керек! 》
Dialogue: 0,0:09:36.07,0:09:48.08,Default,,0,0,0,,♪～
Dialogue: 0,0:09:48.08,0:09:50.38,Default,,0,0,0,,Әй, аға!
Dialogue: 0,0:09:50.38,0:09:52.92,Default,,0,0,0,,ﾘｱﾑ…
Dialogue: 0,0:09:52.92,0:09:56.09,Default,,0,0,0,,Осындай жерде мен...
Dialogue: 0,0:09:56.09,0:09:58.39,Default,,0,0,0,,Мен! Бауырым...
Dialogue: 0,0:09:58.39,0:10:00.60,Default,,0,0,0,,Ухммм… ммм…
Dialogue: 0,0:10:00.60,0:10:05.60,Default,,0,0,0,,Ұстаз! Эй, мені қалаға апар.
Dialogue: 0,0:10:05.60,0:10:08.23,Default,,0,0,0,,Енді монахтың пайдасыз бақталастығы жоқ.
Dialogue: 0,0:10:08.23,0:10:11.11,Default,,0,0,0,,Мен саған ілесе алмаймын
Dialogue: 0,0:10:11.11,0:10:13.78,Default,,0,0,0,,Келдің бе?
Dialogue: 0,0:10:13.78,0:10:15.94,Default,,0,0,0,,Мен де жауаптымын.
Dialogue: 0,0:10:15.94,0:10:19.61,Default,,0,0,0,,Ондай нәрсе жоқ. Эй, жағдай қандай?
Dialogue: 0,0:10:19.61,0:10:21.78,Default,,0,0,0,,Мұның ішінде нақты не бар?
Dialogue: 0,0:10:21.78,0:10:26.25,Default,,0,0,0,,Жын айдаһар Радон осы орманның ішінде мөрленді.
Dialogue: 0,0:10:26.25,0:10:30.13,Default,,0,0,0,,Оны Лиамның арғы атасы, арғы атасы мөрлеген.
Dialogue: 0,0:10:30.13,0:10:32.13,Default,,0,0,0,,Ол шешілді
Dialogue: 0,0:10:32.13,0:10:35.13,Default,,0,0,0,,Жын Айдаһар...
Dialogue: 0,0:10:35.13,0:10:37.42,Default,,0,0,0,,Бруно-ни-сан айтып тұрған құбыжық па?
Dialogue: 0,0:10:42.97,0:10:47.27,Default,,0,0,0,,Біз оны қалай жабу керектігін білеміз. Біз кадрларды жинадық.
Dialogue: 0,0:10:47.27,0:10:51.27,Default,,0,0,0,,Бірақ кедергіге байланысты пломбалауды бастай алмаймын.
Dialogue: 0,0:10:51.27,0:10:56.28,Default,,0,0,0,,Мазасыздық? Radoon Junior - жын айдаһардың баласы.
Dialogue: 0,0:10:56.28,0:10:59.99,Default,,0,0,0,,Бұл қайғы-қасірет олардың барлығына кінәлі.
Dialogue: 0,0:10:59.99,0:11:03.45,Default,,0,0,0,,Жын айдаһарға емес, балаға таң қалар едіңіз.
Dialogue: 0,0:11:03.45,0:11:05.45,Default,,0,0,0,,Міне осылай
Dialogue: 0,0:11:05.45,0:11:07.45,Default,,0,0,0,,Сонда жын айдаһар күштірек пе?
Dialogue: 0,0:11:07.45,0:11:11.00,Default,,0,0,0,,Ах, бірақ ол ұзақ уақыт бойы мөрленіп қалды.
Dialogue: 0,0:11:11.00,0:11:14.00,Default,,0,0,0,,Күшіңізді қалпына келтіру үшін бір апта қажет.
Dialogue: 0,0:11:14.00,0:11:17.84,Default,,0,0,0,,Осы уақытқа дейін мөр басылған болса, проблема болмас еді...
Dialogue: 0,0:11:17.84,0:11:20.84,Default,,0,0,0,,《Мәселе Радонийде ме?》
Dialogue: 0,0:11:20.84,0:11:23.30,Default,,0,0,0,,Сіз екеуіңіз бұрынғы достар едіңіздер деп естідім…
Dialogue: 0,0:11:23.30,0:11:25.31,Default,,0,0,0,,Уф…
Dialogue: 0,0:11:25.31,0:11:27.68,Default,,0,0,0,,Э? Естімеймін.
Dialogue: 0,0:11:27.68,0:11:29.85,Default,,0,0,0,,Міне! Өтірік...
Dialogue: 0,0:11:29.85,0:11:34.02,Default,,0,0,0,,Не болып жатыр өзі…? ➡
Dialogue: 0,0:11:34.02,0:11:37.03,Default,,0,0,0,,Бұл орташа өлшемді иттей ғана болса да...
Dialogue: 0,0:11:37.03,0:11:39.86,Default,,0,0,0,,Байқап көріңіз! (Лиам) Додж, Асуна!
Dialogue: 0,0:11:44.20,0:11:48.04,Default,,0,0,0,,Бұл не!? Бұл керемет жалын.
Dialogue: 0,0:11:48.04,0:11:51.04,Default,,0,0,0,,7 сиқырлы зымырандар!
Dialogue: 0,0:11:55.21,0:11:57.21,Default,,0,0,0,,Сіз өтірік айтасыз!?
Dialogue: 0,0:11:57.21,0:11:59.71,Default,,0,0,0,,Жоқ, мен мұны жеңе алмаймын.
Dialogue: 0,0:11:59.71,0:12:02.34,Default,,0,0,0,,Бұл жерден қашайық, Лиам-кун. Қарғыс атқыр...
Dialogue: 0,0:12:02.34,0:12:04.51,Default,,0,0,0,,《Ол сен ойлағаннан да күшті.
Dialogue: 0,0:12:04.51,0:12:08.06,Default,,0,0,0,,Олардың үшеуі бар... Не істеуім керек? 》
Dialogue: 0,0:12:08.06,0:12:10.06,Default,,0,0,0,,Дұрыс... Асуна!
Dialogue: 0,0:12:10.06,0:12:12.06,Default,,0,0,0,,Джоди-санды алып қашып кет!
Dialogue: 0,0:12:12.06,0:12:14.23,Default,,0,0,0,,Иә! Жылдамдық жұлдызы!
Dialogue: 0,0:12:14.23,0:12:16.23,Default,,0,0,0,,《Бұл жылдамдықта жақсы》
Dialogue: 0,0:12:16.23,0:12:19.07,Default,,0,0,0,,Жарайды, міне, зат қорабы!
Dialogue: 0,0:12:19.07,0:12:21.07,Default,,0,0,0,,Не болып жатыр өзі…? ➡
Dialogue: 0,0:12:21.07,0:12:23.74,Default,,0,0,0,,Амелия Эмилия Клаудия, шық!
Dialogue: 0,0:12:23.74,0:12:26.91,Default,,0,0,0,,ｱﾅｻﾞｰﾜｰﾙﾄﾞ！
Dialogue: 0,0:12:26.91,0:12:35.54,Default,,0,0,0,,♪～
Dialogue: 0,0:12:35.54,0:12:38.25,Default,,0,0,0,,Шығарылды!
Dialogue: 0,0:12:38.25,0:12:42.92,Default,,0,0,0,,Хааааааа... жақсы өтті.
Dialogue: 0,0:12:42.92,0:12:45.26,Default,,0,0,0,,Бұл жұқа сызық болды, бірақ
Dialogue: 0,0:12:45.26,0:12:49.76,Default,,0,0,0,,Radoon Junior... жеңді ме? (Лиам) әйтеуір
Dialogue: 0,0:12:49.76,0:12:53.94,Default,,0,0,0,,Бұл керемет. Radoon Junior-ды жалғыз жеңу...
Dialogue: 0,0:12:53.94,0:12:56.10,Default,,0,0,0,,Және олардың үшеуі бар.
Dialogue: 0,0:12:56.10,0:12:58.40,Default,,0,0,0,,Мен өлемін деп ойладым.
Dialogue: 0,0:13:15.58,0:13:17.58,Default,,0,0,0,,Бұл жын айдаһар...
Dialogue: 0,0:13:17.58,0:13:19.59,Default,,0,0,0,,Лиам! Лиам-кун
Dialogue: 0,0:13:19.59,0:13:21.96,Default,,0,0,0,,Екеуіңіз де жақсы болдыңыз ба?
Dialogue: 0,0:13:21.96,0:13:23.97,Default,,0,0,0,,Иә, қалай болғанда да.
Dialogue: 0,0:13:23.97,0:13:27.59,Default,,0,0,0,,Одан да сиқыр ма? Сіз оны бұрын қолданғансыз, солай ма?
Dialogue: 0,0:13:27.59,0:13:32.14,Default,,0,0,0,,Дұрыс, біз кеңістік құру үшін Басқа әлем деп аталатын сиқырды қолданамыз.
Dialogue: 0,0:13:32.14,0:13:34.60,Default,,0,0,0,,Мен оны ән айту арқылы іске қостым.
Dialogue: 0,0:13:34.60,0:13:37.98,Default,,0,0,0,,Тірі заттар сол кеңістікке кіре алады.
Dialogue: 0,0:13:37.98,0:13:41.61,Default,,0,0,0,,Бұл сіздің сол жерде айдаһарды тұзаққа түсіргеніңізді білдіре ме?
Dialogue: 0,0:13:41.61,0:13:44.32,Default,,0,0,0,,Иә! Сонда ол қайтадан шығады ма?
Dialogue: 0,0:13:44.32,0:13:47.32,Default,,0,0,0,,Жарайды, әлі толық меңгерген жоқпын.
Dialogue: 0,0:13:47.32,0:13:50.62,Default,,0,0,0,,Ішіндегі нәрсе әр жолы жоғалады.
Dialogue: 0,0:13:50.62,0:13:53.33,Default,,0,0,0,,Көрдім, ол жоғалады ма?
Dialogue: 0,0:13:53.33,0:13:56.33,Default,,0,0,0,,Сол сәтте сізде бір идея болды.
Dialogue: 0,0:13:56.33,0:13:58.33,Default,,0,0,0,,Иә. Иә!
Dialogue: 0,0:13:58.33,0:14:01.63,Default,,0,0,0,,Өйткені, Лиам керемет! Бұл шабуылдың сиқыры емес
Dialogue: 0,0:14:01.63,0:14:04.34,Default,,0,0,0,,Сіз оны осылай пайдаланғаныңызға сенбеймін. Ахахаха...
Dialogue: 0,0:14:04.34,0:14:08.18,Default,,0,0,0,,Адам, кішкентай
Dialogue: 0,0:14:10.64,0:14:13.35,Default,,0,0,0,,Бұл қандай дауыс?
Dialogue: 0,0:14:13.35,0:14:19.35,Default,,0,0,0,,Жан дүниесі үлкен адам
Dialogue: 0,0:14:19.35,0:14:21.36,Default,,0,0,0,,Жын айдаһар!?
Dialogue: 0,0:14:21.36,0:14:25.86,Default,,0,0,0,,Демон Айдаһар? Қазір адамдар мені осылай атайды.
Dialogue: 0,0:14:25.86,0:14:28.66,Default,,0,0,0,,Жоқ? адамдық масштаб және т.
Dialogue: 0,0:14:28.66,0:14:30.66,Default,,0,0,0,,Мен тіпті оған мән бермеймін
Dialogue: 0,0:14:30.66,0:14:35.50,Default,,0,0,0,,Бірнеше жүз жылдан кейін ол басқа атпен аталады.
Dialogue: 0,0:14:35.50,0:14:39.87,Default,,0,0,0,,Сен кімсің, ұлы жан адам?
Dialogue: 0,0:14:39.87,0:14:42.38,Default,,0,0,0,,Мен? Мен жай ғана адаммын...
Dialogue: 0,0:14:42.38,0:14:46.88,Default,,0,0,0,,Ондай жағдайда жан мен тән теңдесі жоқ.
Dialogue: 0,0:14:46.88,0:14:51.68,Default,,0,0,0,,《Мен бұл денеге ие болған ересек адам екенімді ешқашан елестете алмас едім...
Dialogue: 0,0:14:51.68,0:14:53.68,Default,,0,0,0,,Оның себебі де...》
Dialogue: 0,0:14:53.68,0:14:57.89,Default,,0,0,0,,Түсінемін, бұл өте өкінішті, бірақ мен себебін білмеймін.
Dialogue: 0,0:14:57.89,0:15:00.69,Default,,0,0,0,,《Менің ойымды оқыдың ба? 》
Dialogue: 0,0:15:00.69,0:15:04.40,Default,,0,0,0,,Мм... Қызық өмір болатын сияқты.
Dialogue: 0,0:15:04.40,0:15:07.24,Default,,0,0,0,,Мені өзіңізбен бірге алып кеткіңіз келе ме?
Dialogue: 0,0:15:07.24,0:15:09.90,Default,,0,0,0,,Маған өз өміріңді көрсетуіңді қалаймын.
Dialogue: 0,0:15:09.90,0:15:12.53,Default,,0,0,0,,Сіз? ештеңе істеме
Dialogue: 0,0:15:12.53,0:15:14.91,Default,,0,0,0,,Керісінше мен саған күшімді беремін.
Dialogue: 0,0:15:14.91,0:15:19.91,Default,,0,0,0,,Бұл сіздің күш-жігеріңіз арқылы салған іргетасқа қосуға болатын күш.
Dialogue: 0,0:15:21.92,0:15:24.09,Default,,0,0,0,,Түсіндім, маған көмектесіңізші.
Dialogue: 0,0:15:24.09,0:15:26.42,Default,,0,0,0,,Мен сенен ешқандай дұшпандық сезінбеймін.
Dialogue: 0,0:15:26.42,0:15:29.72,Default,,0,0,0,,Дәлірек айтсақ, ол қандай да бір жағынан қожайынына ұқсайды.
Dialogue: 0,0:15:29.72,0:15:34.43,Default,,0,0,0,,Әй, онда мен сол үлкен жанды біраз уақытқа қарызға аламын.
Dialogue: 0,0:15:34.43,0:15:36.43,Default,,0,0,0,,Уау...｡ Не!?
Dialogue: 0,0:15:44.73,0:15:47.57,Default,,0,0,0,,Лиам Ханд! Қолдарыңа қараңдар!
Dialogue: 0,0:15:52.07,0:15:55.45,Default,,0,0,0,,Сіз жын айдаһарды қабылдадыңыз деп айттыңыз ба?
Dialogue: 0,0:15:55.45,0:16:01.08,Default,,0,0,0,,《Ғажайып... Мен бүкіл денемде Раддонның күшті күшін сезінемін》
Dialogue: 0,0:16:01.08,0:16:03.08,Default,,0,0,0,,ﾏｼﾞｯｸﾐｻｲﾙ！
Dialogue: 0,0:16:06.63,0:16:08.80,Default,,0,0,0,,11 кітап әнсіз!
Dialogue: 0,0:16:08.80,0:16:13.80,Default,,0,0,0,,Олай болса, Амелия Эмилия Cloudia сиқырлы ракетасы!
Dialogue: 0,0:16:15.80,0:16:19.64,Default,,0,0,0,,17 бөтелке... Және ол толығымен бақылауда.
Dialogue: 0,0:16:23.98,0:16:26.48,Default,,0,0,0,,Не? ше?
Dialogue: 0,0:16:26.48,0:16:28.98,Default,,0,0,0,,《Радон: кері тарту》
Dialogue: 0,0:16:28.98,0:16:31.65,Default,,0,0,0,,Радон?
Dialogue: 0,0:16:31.65,0:16:35.28,Default,,0,0,0,,Артқа тарт... Бұл менің сиқырым ба?!
Dialogue: 0,0:16:37.99,0:16:40.66,Default,,0,0,0,,Бұл Радунның қуатына байланысты болды ма?
Dialogue: 0,0:16:40.66,0:16:43.12,Default,,0,0,0,,Бірақ екеуі жақсы көрінді...
Dialogue: 0,0:16:43.12,0:16:45.13,Default,,0,0,0,,Иә, жақсы!
Dialogue: 0,0:16:45.13,0:16:48.67,Default,,0,0,0,,Менің ойымша, бұл біз Лиам-кунның таныстары болғандықтан шығар.
Dialogue: 0,0:16:48.67,0:16:51.51,Default,,0,0,0,,Жын айдаһардың күшінен күткендей.
Dialogue: 0,0:16:51.51,0:16:54.51,Default,,0,0,0,,Жын айдаһарының қаупін жойғаныңыз үшін рахмет.
Dialogue: 0,0:16:54.51,0:16:58.51,Default,,0,0,0,,Әй, жоқ, сиқырлы ағып кетуіммен сізге қиындық туғызған менмін...
Dialogue: 0,0:16:58.51,0:17:01.68,Default,,0,0,0,,《Жоқ, одан да көп...》
Dialogue: 0,0:17:01.68,0:17:03.69,Default,,0,0,0,,ｱｲﾃﾑﾎﾞｯｸｽ
Dialogue: 0,0:17:03.69,0:17:05.85,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:17:05.85,0:17:08.31,Default,,0,0,0,,10 килограмм алтын бар.
Dialogue: 0,0:17:08.31,0:17:10.69,Default,,0,0,0,,Оны ыңғайсыздық үшін төлем ретінде қабылдаңыз.
Dialogue: 0,0:17:10.69,0:17:13.15,Default,,0,0,0,,Таратыңыз
Dialogue: 0,0:17:13.15,0:17:17.32,Default,,0,0,0,,Жарақат алған адамдар көп, олардың жазылуы ұзаққа созылуы мүмкін адамдарға басымдық беру керек.
Dialogue: 0,0:17:17.32,0:17:22.04,Default,,0,0,0,,Ах... Тағы да рахмет. Рақмет сізге.
Dialogue: 0,0:17:22.04,0:17:24.16,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:17:24.16,0:17:28.33,Default,,0,0,0,,《Егер сіз Альбревитоның орнына Гамильтон отбасының басшысы болсаңыз...》
Dialogue: 0,0:17:33.34,0:17:36.55,Default,,0,0,0,,Егер заттар бұрынғы күйінде қалса, бәрі қорқынышты болар еді.
Dialogue: 0,0:17:36.55,0:17:40.56,Default,,0,0,0,,Альбребиттің бөксесін сүрткеніңіз үшін рахмет.
Dialogue: 0,0:17:40.56,0:17:45.06,Default,,0,0,0,,Ол үшін уайымдамаңыз, әке. Жалғыз қалдыра алмайтын жағдай болды.
Dialogue: 0,0:17:45.06,0:17:48.90,Default,,0,0,0,,Сонда сенің ағаң не болады?
Dialogue: 0,0:17:48.90,0:17:53.57,Default,,0,0,0,,Альбревито біраз уақыт ұсталады. Жағдайға байланысты...
Dialogue: 0,0:17:53.57,0:17:56.20,Default,,0,0,0,,Жоқ, тек сақ болыңыз.
Dialogue: 0,0:17:56.20,0:17:58.20,Default,,0,0,0,,《Гильдия шеберінен
Dialogue: 0,0:17:58.20,0:18:02.08,Default,,0,0,0,,Ең нашар жағдайда, мен мұрагерліктен айырылу мүмкіндігі бар деп естідім...》
Dialogue: 0,0:18:02.08,0:18:06.21,Default,,0,0,0,,Джеймс мырза әлі де осы қалада тұрады.
Dialogue: 0,0:18:06.21,0:18:09.38,Default,,0,0,0,,Бұл оқиға ақыры орталық үкіметке жетеді.
Dialogue: 0,0:18:09.38,0:18:13.92,Default,,0,0,0,,Марапат беруге біреу келеді. Бұл марапат па...
Dialogue: 0,0:18:13.92,0:18:17.93,Default,,0,0,0,,《Альбревитоның ашуына мен де жауаптымын...
Dialogue: 0,0:18:17.93,0:18:21.93,Default,,0,0,0,,Мен бөлмеге келдім, бірақ не айтуым керек? 》
Dialogue: 0,0:18:21.93,0:18:24.10,Default,,0,0,0,,Гамильтондар отбасы үшін бәрі аяқталды!
Dialogue: 0,0:18:24.10,0:18:26.10,Default,,0,0,0,,Қарғыс атсын! (вазаның сынған дыбысы)
Dialogue: 0,0:18:26.10,0:18:29.77,Default,,0,0,0,,Құрметті Альбребит, мен денсаулығыма зиян келтіріп жатырмын!
Dialogue: 0,0:18:29.77,0:18:33.40,Default,,0,0,0,,Қарғыс атсын... Альбребит мырза!
Dialogue: 0,0:18:33.40,0:18:36.40,Default,,0,0,0,,Жын айдаһарды басқа үйдегі Лиам жеңді!
Dialogue: 0,0:18:36.40,0:18:40.11,Default,,0,0,0,,Мен мұны істеуім керек еді! мен...
Dialogue: 0,0:18:42.78,0:18:46.41,Default,,0,0,0,,《Соңында мен Гамильтон отбасын басқалардан гөрі қорғағым келді.
Dialogue: 0,0:18:46.41,0:18:49.12,Default,,0,0,0,,Бұл альбревито...
Dialogue: 0,0:18:49.12,0:18:53.96,Default,,0,0,0,,Сол түні мен түс көрдім
Dialogue: 0,0:18:53.96,0:18:59.13,Default,,0,0,0,,Оянғаннан кейін де анық есімде қалған жұмбақ түс
Dialogue: 0,0:18:59.13,0:19:01.64,Default,,0,0,0,,Мен сиқырмен айналыстым...》
Dialogue: 0,0:19:01.64,0:19:03.64,Default,,0,0,0,,Бұл...
Dialogue: 0,0:19:03.64,0:19:07.43,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:07.43,0:19:09.64,Default,,0,0,0,,Жаңа сиқыр!
Dialogue: 0,0:19:11.81,0:19:14.15,Default,,0,0,0,,Хахаха…
Dialogue: 0,0:19:14.15,0:19:19.99,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:19:19.99,0:19:21.99,Default,,0,0,0,,Екі жаңа сиқыр
Dialogue: 0,0:19:21.99,0:19:24.99,Default,,0,0,0,,Ең алдымен...
Dialogue: 0,0:19:24.99,0:19:27.00,Default,,0,0,0,,Бұл сезім
Dialogue: 0,0:19:27.00,0:19:29.29,Default,,0,0,0,,Басқа әлем сияқты
Dialogue: 0,0:19:29.29,0:19:33.17,Default,,0,0,0,,Егер сіз әдеттегідей жаттығуды жалғастырсаңыз, оны пайдалана аласыз!
Dialogue: 0,0:19:33.17,0:19:39.84,Default,,0,0,0,,♪～
Dialogue: 0,0:19:39.84,0:19:42.18,Default,,0,0,0,,Іске қосылды! (белсендіру дыбысы)
Dialogue: 0,0:19:42.18,0:19:45.31,Default,,0,0,0,,Төменгі айдаһар Лардон Дуниа шақырылды!
Dialogue: 0,0:19:45.31,0:19:51.48,Default,,0,0,0,,Уф…!
Dialogue: 0,0:19:51.48,0:19:54.19,Default,,0,0,0,,Ахаха сондай сүйкімді
Dialogue: 0,0:19:54.19,0:19:58.03,Default,,0,0,0,,Осыны меңгерсең, үлкен күшке айналады.
Dialogue: 0,0:19:58.03,0:20:02.03,Default,,0,0,0,,Қасиетті сиқыр!? Әй, ханшайым!?
Dialogue: 0,0:20:02.03,0:20:05.70,Default,,0,0,0,,《Қасиетті сиқырды қолданатын адамдар бар екеніне сене алмаймын.
Dialogue: 0,0:20:05.70,0:20:08.70,Default,,0,0,0,,Ал мұндай жас балаға...》
Dialogue: 0,0:20:08.70,0:20:11.87,Default,,0,0,0,,Неліктен Мәртебелі мырза мұнда?
Dialogue: 0,0:20:11.87,0:20:14.21,Default,,0,0,0,,Иә? Лорд Гамильтонға...
Dialogue: 0,0:20:14.21,0:20:17.34,Default,,0,0,0,,А, енді сен де лорд Гамильтонсың.
Dialogue: 0,0:20:17.34,0:20:20.34,Default,,0,0,0,,Мен сенің әкеңнен хабар сұрар едім.
Dialogue: 0,0:20:20.34,0:20:22.51,Default,,0,0,0,,А, енді ойлап қарасам, олар келе жатыр...
Dialogue: 0,0:20:22.51,0:20:25.35,Default,,0,0,0,,Ал, бұл қандай кәсіп?
Dialogue: 0,0:20:25.35,0:20:27.89,Default,,0,0,0,,Мм, ең алдымен медаль.
Dialogue: 0,0:20:27.89,0:20:29.89,Default,,0,0,0,,Жын айдаһарды бағындырудың жетістігі үлкен болғанымен.
Dialogue: 0,0:20:29.89,0:20:34.06,Default,,0,0,0,,Аумағы жоқ балаға барон немесе одан жоғары дәреже беру.
Dialogue: 0,0:20:34.06,0:20:36.23,Default,,0,0,0,,Қарттар шулы
Dialogue: 0,0:20:36.23,0:20:41.36,Default,,0,0,0,,Олай болса, өз бастамаммен мен сені үшінші дәрежелі Феникс орденімен марапаттаймын.
Dialogue: 0,0:20:41.36,0:20:43.91,Default,,0,0,0,,Бұл медаль ме?
Dialogue: 0,0:20:43.91,0:20:46.53,Default,,0,0,0,,Оны қабылдаңыз. Халықты тыныштандыру үшін
Dialogue: 0,0:20:46.53,0:20:50.91,Default,,0,0,0,,Бізге жын айдаһардың бағындырылғаны және батырдың болуы керек.
Dialogue: 0,0:20:50.91,0:20:53.25,Default,,0,0,0,,Аа~ түсіндім.
Dialogue: 0,0:20:53.25,0:20:56.08,Default,,0,0,0,,Бұл да асылдың міндеті.
Dialogue: 0,0:20:56.08,0:20:58.25,Default,,0,0,0,,Келесі әңгімені тыңдағым келеді.
Dialogue: 0,0:20:58.25,0:21:00.55,Default,,0,0,0,,Жын айдаһарды қалай бағындырдың?
Dialogue: 0,0:21:00.55,0:21:04.76,Default,,0,0,0,,Кей жағдайда оны батырлық хикаяға айналдыруға тура келеді.
Dialogue: 0,0:21:04.76,0:21:09.76,Default,,0,0,0,,《Әрине, эпизод неғұрлым егжей-тегжейлі болса, адамдар соғұрлым қауіпсіз болады.》
Dialogue: 0,0:21:09.76,0:21:11.77,Default,,0,0,0,,Шынайы сезімдері мен нағыз болмысын жасырып
Dialogue: 0,0:21:16.56,0:21:19.27,Default,,0,0,0,,Әңгіме дұрыс па?
Dialogue: 0,0:21:19.27,0:21:21.57,Default,,0,0,0,,Мм... иә
Dialogue: 0,0:21:21.57,0:21:23.95,Default,,0,0,0,,Бұл ақымақ...
Dialogue: 0,0:21:23.95,0:21:27.57,Default,,0,0,0,,Жоқ, бірақ бұл сөзсіз қасиетті сиқыр болды.
Dialogue: 0,0:21:27.57,0:21:32.12,Default,,0,0,0,,《Сонда менде қорқынышты түсінбеушілік болды ма? 》
Dialogue: 0,0:21:32.12,0:21:35.79,Default,,0,0,0,,Мен қазір не туралы айтып отырмын, сәл үндемей тұра аласыз ба?
Dialogue: 0,0:21:35.79,0:21:37.79,Default,,0,0,0,,Сіз үндемейсіз бе?
Dialogue: 0,0:21:37.79,0:21:41.80,Default,,0,0,0,,Ешкімге айтпа! Мен түсінемін
Dialogue: 0,0:21:44.63,0:21:47.80,Default,,0,0,0,,《Лиам: Келесі күні кенеттен Король Мәртебелі бағыныштылары пайда болды.
Dialogue: 0,0:21:47.80,0:21:50.47,Default,,0,0,0,,Мен 3000 алтын тиын әкелдім.
Dialogue: 0,0:21:50.47,0:21:52.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:52.47,0:21:56.81,Default,,0,0,0,,《Бұл үнсіз ақша шығар...》
Dialogue: 0,0:21:56.81,0:21:59.31,Default,,0,0,0,,Мен бұрын-соңды сонша алтын тиын көрген емеспін!
Dialogue: 0,0:21:59.31,0:22:01.94,Default,,0,0,0,,Құрметті Лиам, керемет!
Dialogue: 0,0:22:01.94,0:22:04.82,Default,,0,0,0,,Ааа аааа аа... аа~
Dialogue: 0,0:22:06.32,0:22:12.32,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory