Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:19.64,0:01:21.57,Default,,0,0,0,,Рика күт
Dialogue: 0,0:01:23.55,0:01:28.41,Default,,0,0,0,,Бүгін сенің туған күнің, солай ма? Өзіңізге ұнайтын нәрсені сатып алыңыз.
Dialogue: 0,0:01:30.53,0:01:33.28,Default,,0,0,0,,Енді маған әкең туралы айтып бер.
Dialogue: 0,0:01:34.50,0:01:38.66,Default,,0,0,0,,Сізде әлі де сол нәрсе бар екеніне сене алмаймын.
Dialogue: 0,0:01:43.26,0:01:46.69,Default,,0,0,0,,Бізді тастап кеткен әкемді қатты сағындым.
Dialogue: 0,0:01:46.90,0:01:48.36,Default,,0,0,0,,Сіз анаңызды тастап кеткенсіз, солай ма?
Dialogue: 0,0:01:49.43,0:01:51.62,Default,,0,0,0,,Неге олай дейсің?
Dialogue: 0,0:01:52.30,0:01:54.63,Default,,0,0,0,,Білесіз бе, Рика әлі түсінбеген шығар.
Dialogue: 0,0:01:54.63,0:01:56.39,Default,,0,0,0,,Ішімдіктің иісі бар.
Dialogue: 0,0:03:27.28,0:03:30.10,Default,,0,0,0,,Лерон кішкентай болса да, кез келген нәрсені жейтін.
Dialogue: 0,0:03:30.10,0:03:31.86,Default,,0,0,0,,Ет жегендей болады.
Dialogue: 0,0:03:32.12,0:03:33.35,Default,,0,0,0,,Бұл бала да жемқор.
Dialogue: 0,0:03:33.35,0:03:34.67,Default,,0,0,0,,Йо
Dialogue: 0,0:03:35.48,0:03:37.35,Default,,0,0,0,,Рика туған күніңмен
Dialogue: 0,0:03:37.35,0:03:38.19,Default,,0,0,0,,Рахмет
Dialogue: 0,0:03:38.36,0:03:39.75,Default,,0,0,0,,Біз тойлауымыз керек.
Dialogue: 0,0:03:39.75,0:03:41.93,Default,,0,0,0,,Сондай-ақ хиккиден құтылу мерекесі ретінде қызмет етеді.
Dialogue: 0,0:03:41.93,0:03:44.15,Default,,0,0,0,,Қандай кенет хабарландыру.
Dialogue: 0,0:03:45.14,0:03:49.12,Default,,0,0,0,,Мен үйде отырып, бірдеңені ойласам да ашылмайтындай сезінемін.
Dialogue: 0,0:03:50.57,0:03:54.66,Default,,0,0,0,,Агония жиіркенішті болып көрінеді.
Dialogue: 0,0:03:54.66,0:03:55.82,Default,,0,0,0,,Менің айтқым келгені бұл емес.
Dialogue: 0,0:03:55.82,0:03:57.36,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:03:58.74,0:04:02.15,Default,,0,0,0,,Бірақ бәрі жақсы болды. Қорқыту болды, солай ма?
Dialogue: 0,0:04:02.39,0:04:05.40,Default,,0,0,0,,Бұл біртүрлі, бірақ жақсы болды.
Dialogue: 0,0:04:06.15,0:04:09.41,Default,,0,0,0,,Мен демалып жатқандықтан болар, мені қайнағандай емдегендей болды.
Dialogue: 0,0:04:09.73,0:04:11.26,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,0:04:11.60,0:04:13.80,Default,,0,0,0,,Иә, барлығына рахмет.
Dialogue: 0,0:04:14.26,0:04:17.57,Default,,0,0,0,,Оқшаулансаңыз да, сыртта үш досыңыз бар.
Dialogue: 0,0:04:17.91,0:04:18.72,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:04:19.11,0:04:19.65,Default,,0,0,0,,На
Dialogue: 0,0:04:20.51,0:04:22.37,Default,,0,0,0,,Сұрақтарыңыз болса, маған хабарлаңыз.
Dialogue: 0,0:04:22.37,0:04:26.67,Default,,0,0,0,,Төтенше жағдайда мен Леонның мені олжалауға жол берсем, бұл қарсылық сияқты болар еді.
Dialogue: 0,0:04:26.67,0:04:27.70,Default,,0,0,0,,Рахмет
Dialogue: 0,0:04:27.70,0:04:28.86,Default,,0,0,0,,Рахмет қажет емес
Dialogue: 0,0:04:29.41,0:04:32.25,Default,,0,0,0,,Ай Достар бәрінен де керемет.
Dialogue: 0,0:04:32.79,0:04:35.06,Default,,0,0,0,,Ликка-чан, егер сізге бірдеңе керек болса, маған хабарлаңыз.
Dialogue: 0,0:04:35.24,0:04:36.49,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:04:36.49,0:04:40.66,Default,,0,0,0,,Бүгін мен барлығынан менің шағымдарыма қосылуын сұраймын.
Dialogue: 0,0:04:41.74,0:04:42.52,Default,,0,0,0,,Шағымдану
Dialogue: 0,0:04:48.83,0:04:50.28,Default,,0,0,0,,Папаның бес картасы
Dialogue: 0,0:04:50.87,0:04:52.65,Default,,0,0,0,,Әкем белсенді емес
Dialogue: 0,0:04:52.71,0:04:53.68,Default,,0,0,0,,Сіз бе?
Dialogue: 0,0:04:53.68,0:04:56.01,Default,,0,0,0,,Менің нағыз әкем осында
Dialogue: 0,0:04:56.01,0:04:58.97,Default,,0,0,0,,Енді нағыз кім?
Dialogue: 0,0:05:00.22,0:05:01.43,Default,,0,0,0,,Ликка-чан
Dialogue: 0,0:05:02.09,0:05:05.11,Default,,0,0,0,,Бұл кісі маған ұқсайды, оның ішінде қасы да.
Dialogue: 0,0:05:06.18,0:05:08.85,Default,,0,0,0,,Мен дұрыс жауапты да білмеймін.
Dialogue: 0,0:05:09.07,0:05:12.37,Default,,0,0,0,,Мен оның әлі де сонда екеніне сенімді емеспін.
Dialogue: 0,0:05:13.04,0:05:14.32,Default,,0,0,0,,Оны өз бетінше қалдыр
Dialogue: 0,0:05:14.96,0:05:20.19,Default,,0,0,0,,Мен бұл қызға әкем орта мектепті бітіргенде кездесуге рұқсат етемін деп уәде бердім.
Dialogue: 0,0:05:20.68,0:05:23.37,Default,,0,0,0,,Мен уәде бердім.
Dialogue: 0,0:05:26.93,0:05:31.39,Default,,0,0,0,,Міне, анам да түсінбейді.
Dialogue: 0,0:05:32.19,0:05:37.17,Default,,0,0,0,,Солардың бірі шығар деп ойлаймын.
Dialogue: 0,0:05:41.02,0:05:43.24,Default,,0,0,0,,Бұл бетті жасама
Dialogue: 0,0:05:43.50,0:05:48.86,Default,,0,0,0,,Рика шынымен анасының ішін ауыртқан қызы.
Dialogue: 0,0:05:49.43,0:05:51.44,Default,,0,0,0,,Бұл сөзсіз
Dialogue: 0,0:05:51.87,0:05:54.05,Default,,0,0,0,,Бұл ең қызықсыз нәрсе.
Dialogue: 0,0:05:57.93,0:05:58.72,Default,,0,0,0,,Ой...
Dialogue: 0,0:06:00.66,0:06:01.87,Default,,0,0,0,,Талап етілмеген елу миллиардты қайтарып алу үшін.
Dialogue: 0,0:06:02.14,0:06:07.23,Default,,0,0,0,,Менің әкесімен кездесіп, онымен танысқаным ол әйелге ұнамайды.
Dialogue: 0,0:06:08.16,0:06:08.82,Default,,0,0,0,,Бұл сенсің ғой, иә?
Dialogue: 0,0:06:09.67,0:06:16.38,Default,,0,0,0,,Мен өзімді бақытты болғаным үшін кешіре алмаймын, өйткені мен параноидтық трагедияның кейіпкерімін.
Dialogue: 0,0:06:16.76,0:06:17.63,Default,,0,0,0,,Тоқта
Dialogue: 0,0:06:19.55,0:06:22.28,Default,,0,0,0,,Анаң туралы жаман айтпаған дұрыс.
Dialogue: 0,0:06:22.97,0:06:25.59,Default,,0,0,0,,Не, сен мен жақта емессің бе?
Dialogue: 0,0:06:25.86,0:06:27.67,Default,,0,0,0,,Мен сенің жағындамын деп айтып отырмын.
Dialogue: 0,0:06:39.88,0:06:43.20,Default,,0,0,0,,Мен де анам туралы жаман сөз айтқым келмейді.
Dialogue: 0,0:06:43.36,0:06:46.94,Default,,0,0,0,,Бірақ ол сенің анаңнан мүлдем басқа.
Dialogue: 0,0:06:47.27,0:06:50.30,Default,,0,0,0,,Жолымды таппасам, ысқырамын
Dialogue: 0,0:06:50.30,0:06:52.86,Default,,0,0,0,,Мен кездейсоқ өтірік айта беремін.
Dialogue: 0,0:06:52.86,0:06:56.33,Default,,0,0,0,,Маған ешқашан кешірім сұраған емес
Dialogue: 0,0:06:57.09,0:07:00.19,Default,,0,0,0,,Ол тек намысшыл, түсінбеген әйел.
Dialogue: 0,0:07:01.68,0:07:04.07,Default,,0,0,0,,Мен бақыттырақ болар едім
Dialogue: 0,0:07:04.45,0:07:08.83,Default,,0,0,0,,Өзім кінәлі болсам да, сен де мені жек көресің.
Dialogue: 0,0:07:09.00,0:07:14.33,Default,,0,0,0,,Мені дүниеге әкелгендіктен бақытты бола алмаған сияқтысың.
Dialogue: 0,0:07:15.96,0:07:18.74,Default,,0,0,0,,Сіздің анаңыздың өз жағдайлары бар екеніне сенімдімін.
Dialogue: 0,0:07:19.77,0:07:21.84,Default,,0,0,0,,Сен де ата-анаңды жек көресің.
Dialogue: 0,0:07:23.55,0:07:25.74,Default,,0,0,0,,Бұл тәуелділік деп аталады, солай ма?
Dialogue: 0,0:07:27.17,0:07:29.62,Default,,0,0,0,,Оны бір жерден үзіп алмасаңыз, ештеңе өзгермейді.
Dialogue: 0,0:07:30.48,0:07:33.33,Default,,0,0,0,,Ақылды адамның не екенін түсінетіндей ақылды болма.
Dialogue: 0,0:07:33.56,0:07:34.46,Default,,0,0,0,,(Присцилла Барриэлл) Бұл мен естіген ең жалықтырарлық, мағынасыз әңгіме.
Dialogue: 0,0:07:35.33,0:07:35.94,Default,,0,0,0,,Рика
Dialogue: 0,0:07:37.30,0:07:38.02,Default,,0,0,0,,Рика
Dialogue: 0,0:07:49.42,0:07:50.43,Default,,0,0,0,,Тоқтатылды
Dialogue: 0,0:08:03.35,0:08:06.50,Default,,0,0,0,,Ай мені қуады деп ойладым.
Dialogue: 0,0:08:07.10,0:08:10.43,Default,,0,0,0,,Рика оны қуғанымды қалады.
Dialogue: 0,0:08:12.07,0:08:12.81,Default,,0,0,0,,Мен сенімен бірге шығамын
Dialogue: 0,0:08:13.55,0:08:14.40,Default,,0,0,0,,Не
Dialogue: 0,0:08:15.79,0:08:17.00,Default,,0,0,0,,Ата-ананы жамандау
Dialogue: 0,0:08:19.22,0:08:20.42,Default,,0,0,0,,Өзіңізді қатты итермеңіз
Dialogue: 0,0:08:21.02,0:08:27.85,Default,,0,0,0,,Менде де көп нәрсе бар, біз толық емес отбасымыз.
Dialogue: 0,0:08:29.86,0:08:31.41,Default,,0,0,0,,Атау мағынасы
Dialogue: 0,0:08:34.26,0:08:34.98,Default,,0,0,0,,Көз
Dialogue: 0,0:08:36.67,0:08:40.25,Default,,0,0,0,,Қазіргі Licca-chan - маңызды нұсқасы.
Dialogue: 0,0:08:40.67,0:08:41.36,Default,,0,0,0,,Сонымен
Dialogue: 0,0:08:43.75,0:08:46.23,Default,,0,0,0,,Сонымен бұрын не болды?
Dialogue: 0,0:08:47.56,0:08:50.36,Default,,0,0,0,,Кенет барлық жаман нәрселер есіме түсті.
Dialogue: 0,0:08:51.56,0:08:58.42,Default,,0,0,0,,Қиын болып барады. Мен де қазір анамды жек көремін.
Dialogue: 0,0:09:00.37,0:09:04.96,Default,,0,0,0,,Соңғы кездері мен де бір күні сондай боламын ба деп ойлап жүрмін.
Dialogue: 0,0:09:05.42,0:09:07.08,Default,,0,0,0,,Бізде бәрі жақсы.
Dialogue: 0,0:09:09.41,0:09:10.27,Default,,0,0,0,,Бұл жерде тақды шарлатанға тапсыратын орын да емес қой, иә?
Dialogue: 0,0:09:12.98,0:09:15.91,Default,,0,0,0,,Үлкендер кейде әртүрлі жаратылыстар сияқты көрінеді
Dialogue: 0,0:09:18.50,0:09:22.18,Default,,0,0,0,,Мен бір-бірімізді сүйгендіктен үйленіп, жыныстық қатынасқа түсуіміз керек деп ойладым.
Dialogue: 0,0:09:26.43,0:09:28.85,Default,,0,0,0,,Бала болғандықтан ба?
Dialogue: 0,0:09:31.33,0:09:35.41,Default,,0,0,0,,Шынымды айтсам, білмеймін.
Dialogue: 0,0:09:44.47,0:09:48.59,Default,,0,0,0,,Дәл қазір бұл Рика. Ол таңқаларлық сау көрінеді.
Dialogue: 0,0:09:49.08,0:09:50.02,Default,,0,0,0,,Кітапханада жәндіктер ұяласып жатыр ма? Бұл өте қорқынышты.
Dialogue: 0,0:09:50.02,0:09:54.41,Default,,0,0,0,,Ештеңе етпейді, ертең әдеттегі Рикаға қайтатыныңызға сенімдімін.
Dialogue: 0,0:09:56.00,0:09:59.48,Default,,0,0,0,,Мүмкін, мен әйелдер қоғамына қосылмаған шығармын.
Dialogue: 0,0:09:59.83,0:10:00.62,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:10:02.66,0:10:07.81,Default,,0,0,0,,Өз ойларыңызды айтыңыз, ұтымды дұрыс деп санайтыныңызды айтыңыз
Dialogue: 0,0:10:09.02,0:10:10.83,Default,,0,0,0,,Ұйқы жақсы, сондықтан
Dialogue: 0,0:10:11.57,0:10:14.75,Default,,0,0,0,,Мұның дұрыс екенін бәрі түсінеді, бұл жиіркенішті.
Dialogue: 0,0:10:15.15,0:10:18.46,Default,,0,0,0,,Мен сіздің ата-анаңызбен қарым-қатынасыңызға алаңдау сезімін түсінбеймін.
Dialogue: 0,0:10:19.13,0:10:21.02,Default,,0,0,0,,Сіз әке-шешеңізбен жақсы қарым-қатынастасыз, солай емес пе?
Dialogue: 0,0:10:22.57,0:10:24.48,Default,,0,0,0,,Басынан бері де емес
Dialogue: 0,0:10:28.28,0:10:31.47,Default,,0,0,0,,Бұл туралы уайымдаудың қажеті жоқ сияқты.
Dialogue: 0,0:10:32.99,0:10:37.37,Default,,0,0,0,,Сол жарықтағы ең кішкентай шам біздің дүкен шығар.
Dialogue: 0,0:10:40.33,0:10:43.23,Default,,0,0,0,,Әкеңізбен қашан кездесіп жүрсіз?
Dialogue: 0,0:10:43.72,0:10:46.16,Default,,0,0,0,,Хмм, айына бір рет.
Dialogue: 0,0:10:47.03,0:10:50.93,Default,,0,0,0,,Әкемді алып кететін ана емес екеніңізге қуаныштымын.
Dialogue: 0,0:10:52.84,0:10:55.98,Default,,0,0,0,,Екеуміз ажырассақ та, сен баланың әкесі боласың.
Dialogue: 0,0:10:58.20,0:11:03.36,Default,,0,0,0,,Мен сені көрмегендіктен көп қиялдаймын.
Dialogue: 0,0:11:04.50,0:11:07.23,Default,,0,0,0,,Әдемі әйелдерге әмиянды алып жүрудің қажеті жоқ
Dialogue: 0,0:11:08.04,0:11:13.89,Default,,0,0,0,,Сол нәзік үн ғана есімде, Жүзіңді есіме түсіре алмаймын.
Dialogue: 0,0:11:15.97,0:11:18.26,Default,,0,0,0,,Мен сені бір күні көремін
Dialogue: 0,0:11:18.76,0:11:24.47,Default,,0,0,0,,Мен сенімен бір күні кездескім келеді.
Dialogue: 0,0:11:31.90,0:11:32.93,Default,,0,0,0,,Ылғалды қабат
Dialogue: 0,0:11:35.63,0:11:38.62,Default,,0,0,0,,Мен алдымен үйге барамын. Рахмет, Ай.
Dialogue: 0,0:11:39.68,0:11:41.82,Default,,0,0,0,,Иә, сау болыңыз
Dialogue: 0,0:11:49.43,0:11:51.49,Default,,0,0,0,,Мен мұны қарсыларға қалдырамын.
Dialogue: 0,0:11:53.98,0:11:54.77,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:11:57.28,0:11:59.22,Default,,0,0,0,,Бүгінгі тақырып осы ма?
Dialogue: 0,0:11:59.99,0:12:05.40,Default,,0,0,0,,Керемет, енді сіз де құтқарыла аласыз.
Dialogue: 0,0:12:11.42,0:12:13.00,Default,,0,0,0,,Ikeda клиникасы
Dialogue: 0,0:12:13.00,0:12:14.68,Default,,0,0,0,,Чиаки-санның жұлдызы бар
Dialogue: 0,0:12:14.68,0:12:16.29,Default,,0,0,0,,О, Ликка-чан, туған күнің құтты болсын
Dialogue: 0,0:12:16.45,0:12:17.36,Default,,0,0,0,,Қайырлы кеш
Dialogue: 0,0:12:19.72,0:12:22.58,Default,,0,0,0,,Рика қош келдіңіз
Dialogue: 0,0:12:22.92,0:12:24.55,Default,,0,0,0,,Алдымен тортты жеп ал
Dialogue: 0,0:12:42.77,0:12:44.92,Default,,0,0,0,,Kisho, die.
Dialogue: 0,0:12:55.33,0:12:58.45,Default,,0,0,0,,Көптеген жылдар бойы дәрігер болып—
Dialogue: 0,0:13:10.51,0:13:13.42,Default,,0,0,0,,Камея Маннен Неби
Dialogue: 0,0:13:17.38,0:13:20.10,Default,,0,0,0,,Nebi, go back.
Dialogue: 0,0:13:20.46,0:13:26.21,Default,,0,0,0,,Барлық уайымдарыңыз жойылады.
Dialogue: 0,0:13:26.63,0:13:28.24,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:13:28.54,0:13:32.43,Default,,0,0,0,,Ұстаз, бізді Ғарыш ақиқатымен байланыстырыңыз.
Dialogue: 0,0:13:32.73,0:13:37.78,Default,,0,0,0,,Бәрін маған тапсыр, сонда құтыласың.
Dialogue: 0,0:13:37.78,0:13:40.11,Default,,0,0,0,,Не айтып тұрсың, қария?
Dialogue: 0,0:13:56.26,0:13:58.34,Default,,0,0,0,,Әлсіз Қорқынышты көрініс
Dialogue: 0,0:13:58.34,0:14:00.82,Default,,0,0,0,,Мұғалімге не істеп жатырсың?
Dialogue: 0,0:14:00.82,0:14:01.61,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:14:01.92,0:14:04.39,Default,,0,0,0,,Махаббат, ғалам және руханилық
Dialogue: 0,0:14:06.17,0:14:09.98,Default,,0,0,0,,Анам әлсіз, ал әкем жұмыста жақсы емес еді.
Dialogue: 0,0:14:10.43,0:14:12.97,Default,,0,0,0,,Мен бұрынғы өмірімдегі карманың қарғысына ұшырадым.
Dialogue: 0,0:14:13.37,0:14:16.78,Default,,0,0,0,,Сондықтан заттар мен заттарға байлануды доғар.
Dialogue: 0,0:14:17.25,0:14:22.02,Default,,0,0,0,,Үйіміз бен ақшамыздан бас тартқан соң, ақыры біз отбасы болып ғаламға қосыла алдық.
Dialogue: 0,0:14:22.71,0:14:26.56,Default,,0,0,0,,Сен ақымақсың ба? Алданған отбасы өз-өзіне қол жұмсаған.
Dialogue: 0,0:14:30.23,0:14:32.08,Default,,0,0,0,,Саған да қиын болуы керек.
Dialogue: 0,0:14:33.21,0:14:39.97,Default,,0,0,0,,Бір қарағанда, бәрі бірдей, бірақ бәрі де қызықсыз, әдемі және ұсқынсыз, артықшылық пен кемшілікке ілінген.
Dialogue: 0,0:14:40.20,0:14:44.52,Default,,0,0,0,,Бар – мақтаншақ, жоқ – қызғаныш
Dialogue: 0,0:14:44.75,0:14:46.94,Default,,0,0,0,,Бұл өзін-өзі дамыту семинары ма?
Dialogue: 0,0:14:47.23,0:14:48.23,Default,,0,0,0,,Осы жерден айналып өтейік…
Dialogue: 0,0:14:48.23,0:14:49.89,Default,,0,0,0,,Мен амка болсам да
Dialogue: 0,0:14:52.30,0:14:54.59,Default,,0,0,0,,Өзіңізді өшіріңіз
Dialogue: 0,0:14:56.11,0:14:59.16,Default,,0,0,0,,Сонда оңайырақ болады
Dialogue: 0,0:15:01.44,0:15:02.78,Default,,0,0,0,,Иә! Міне, сонда.
Dialogue: 0,0:15:04.53,0:15:06.82,Default,,0,0,0,,Ака Рика-чанның жағдайы қалай?
Dialogue: 0,0:15:07.43,0:15:09.66,Default,,0,0,0,,Ұрысыңызға көңіл бөліңіз
Dialogue: 0,0:15:10.76,0:15:12.59,Default,,0,0,0,,Сен жыладың деп уайымдадым.
Dialogue: 0,0:15:12.98,0:15:14.25,Default,,0,0,0,,Бұл нашар болуы мүмкін.
Dialogue: 0,0:15:14.99,0:15:15.98,Default,,0,0,0,,Урака
Dialogue: 0,0:15:15.98,0:15:18.32,Default,,0,0,0,,Өтінемін, не болып жатқанын айтыңызшы.
Dialogue: 0,0:15:19.76,0:15:23.15,Default,,0,0,0,,Рика соғысуды тоқтатты.
Dialogue: 0,0:15:24.07,0:15:30.27,Default,,0,0,0,,Құшағымда ұстағандар ғаламның тылсым сырларына жалғанады.
Dialogue: 0,0:15:30.58,0:15:32.06,Default,,0,0,0,,Әлі де күшті
Dialogue: 0,0:15:35.14,0:15:36.06,Default,,0,0,0,,Жарайды
Dialogue: 0,0:15:38.35,0:15:41.18,Default,,0,0,0,,Қараңыз, ауырмайды.
Dialogue: 0,0:15:43.14,0:15:45.30,Default,,0,0,0,,Ештеңеден қорықпа
Dialogue: 0,0:15:45.62,0:15:50.83,Default,,0,0,0,,Сен, кішкентай, үлкен энергияның бір бөлігіне айналасың.
Dialogue: 0,0:15:51.80,0:15:53.37,Default,,0,0,0,,Кішкентай мен
Dialogue: 0,0:15:53.79,0:15:55.92,Default,,0,0,0,,Мұғаліммен бір болыңыз.
Dialogue: 0,0:15:55.92,0:16:00.74,Default,,0,0,0,,Мен ешкімді қызғанбаймын, жек көрмеймін.
Dialogue: 0,0:16:01.88,0:16:06.07,Default,,0,0,0,,Өз кармаңызды өшіріп, қосылыңыз.
Dialogue: 0,0:16:06.61,0:16:10.30,Default,,0,0,0,,Бұл да жақсы, Бұл жақсы
Dialogue: 0,0:16:11.12,0:16:14.14,Default,,0,0,0,,Ликка-чан, алданба.
Dialogue: 0,0:16:15.33,0:16:16.10,Default,,0,0,0,,Көз
Dialogue: 0,0:16:17.86,0:16:20.48,Default,,0,0,0,,Мен ғана емес, бәрі сонда.
Dialogue: 0,0:16:20.75,0:16:22.87,Default,,0,0,0,,Рика, саған ұқсамайды.
Dialogue: 0,0:16:23.22,0:16:26.24,Default,,0,0,0,,Осылай аяқталса жақсы ма?
Dialogue: 0,0:16:26.90,0:16:29.18,Default,,0,0,0,,Мен болу деген нені білдіреді?
Dialogue: 0,0:16:30.88,0:16:33.12,Default,,0,0,0,,Рика, мықты бол
Dialogue: 0,0:16:33.12,0:16:34.70,Default,,0,0,0,,Рика Рика
Dialogue: 0,0:16:39.59,0:16:41.93,Default,,0,0,0,,Мен шаршадым
Dialogue: 0,0:16:42.76,0:16:46.25,Default,,0,0,0,,Демалыңыз және беріліңіз
Dialogue: 0,0:16:49.42,0:16:53.56,Default,,0,0,0,,Дұрыс, Рика-сан, мен де осылай құтқарылдым.
Dialogue: 0,0:16:54.60,0:17:00.27,Default,,0,0,0,,Иә, менің де құтқарылғым келеді.
Dialogue: 0,0:17:01.01,0:17:03.30,Default,,0,0,0,,Сіз бір адамнан айырыласыз ба?
Dialogue: 0,0:17:03.93,0:17:05.45,Default,,0,0,0,,сияқты
Dialogue: 0,0:17:06.07,0:17:10.08,Default,,0,0,0,,Енді, өмір құшағында!
Dialogue: 0,0:17:12.12,0:17:12.84,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:17:25.99,0:17:26.79,Default,,0,0,0,,Он мың жыл
Dialogue: 0,0:17:28.47,0:17:30.86,Default,,0,0,0,,Мынау не тасбақа, мазалама?
Dialogue: 0,0:17:30.86,0:17:34.46,Default,,0,0,0,,Он миллион жыл, сен қарсысың, солай емес пе?
Dialogue: 0,0:17:38.54,0:17:41.40,Default,,0,0,0,,Түсіндім, өйткені мен оны басып шығардым.
Dialogue: 0,0:17:42.55,0:17:44.11,Default,,0,0,0,,Маған ананы шақырыңыз
Dialogue: 0,0:17:48.59,0:17:51.78,Default,,0,0,0,,Анаңды қорғамасаң
Dialogue: 0,0:17:56.08,0:17:57.11,Default,,0,0,0,,Ликка-чан
Dialogue: 0,0:17:57.61,0:17:58.86,Default,,0,0,0,,Рика сұрауы
Dialogue: 0,0:17:58.86,0:17:59.45,Default,,0,0,0,,Рика қайтып оралды
Dialogue: 0,0:17:59.45,0:18:00.71,Default,,0,0,0,,Барлығы осында
Dialogue: 0,0:18:00.71,0:18:01.54,Default,,0,0,0,,Он мың жыл
Dialogue: 0,0:18:04.58,0:18:09.12,Default,,0,0,0,,Жоқ, мен өзімшіл ана болып кете жаздадым.
Dialogue: 0,0:18:09.87,0:18:12.90,Default,,0,0,0,,Анам маған бір нәрсені дұрыс үйретті.
Dialogue: 0,0:18:13.27,0:18:18.53,Default,,0,0,0,,Әйелдерден ақша сұрайтын еркектердің бәрі жалған.
Dialogue: 0,0:18:24.00,0:18:26.85,Default,,0,0,0,,Бұл шынайы. Мұғалім нағыз.
Dialogue: 0,0:18:27.91,0:18:30.57,Default,,0,0,0,,Ғалам және арналар
Dialogue: 0,0:18:30.57,0:18:32.32,Default,,0,0,0,,Оған сеніңіз
Dialogue: 0,0:18:35.72,0:18:36.82,Default,,0,0,0,,Қайсысы да жақсы.
Dialogue: 0,0:18:37.68,0:18:41.50,Default,,0,0,0,,Біркелкі арналы немесе кальмар сақинасы
Dialogue: 0,0:18:54.65,0:18:56.14,Default,,0,0,0,,Мен мәңгілікке барамын
Dialogue: 0,0:18:58.08,0:19:02.19,Default,,0,0,0,,Жүрегіңе
Dialogue: 0,0:19:19.68,0:19:22.30,Default,,0,0,0,,Ауыр Бұл ауыр
Dialogue: 0,0:19:26.14,0:19:27.46,Default,,0,0,0,,Жарайды, жарайды
Dialogue: 0,0:19:28.08,0:19:30.47,Default,,0,0,0,,Тіпті сен әлсізсің
Dialogue: 0,0:19:31.22,0:19:32.63,Default,,0,0,0,,Мен амка болсам да
Dialogue: 0,0:19:33.42,0:19:34.41,Default,,0,0,0,,Бұл әлсіз
Dialogue: 0,0:19:35.49,0:19:40.72,Default,,0,0,0,,Сондықтан мен мұны маңызды нәрселерді тастамау үшін заттарды теңестіру үшін пайдаландым.
Dialogue: 0,0:19:41.53,0:19:47.14,Default,,0,0,0,,Мен әлсізмін, бірақ мен дәл осындаймын
Dialogue: 0,0:19:48.42,0:19:52.41,Default,,0,0,0,,Өзімді қинасам да өмір сүремін
Dialogue: 0,0:19:57.40,0:19:59.20,Default,,0,0,0,,Ішімдік
Dialogue: 0,0:19:59.57,0:20:01.36,Default,,0,0,0,,Бұл өмірдің құшағында
Dialogue: 0,0:20:06.76,0:20:07.48,Default,,0,0,0,,Рика
Dialogue: 0,0:20:08.67,0:20:09.27,Default,,0,0,0,,Рика
Dialogue: 0,0:20:14.36,0:20:15.30,Default,,0,0,0,,«Оқыттым» деген сөз дәл келмейді—
Dialogue: 0,0:20:19.56,0:20:20.67,Default,,0,0,0,,Сіз де
Dialogue: 0,0:20:23.01,0:20:25.74,Default,,0,0,0,,Ал, бүгін не ойнауымыз керек?
Dialogue: 0,0:20:26.32,0:20:27.83,Default,,0,0,0,,Не істеу керек Не істеу керек
Dialogue: 0,0:20:35.53,0:20:36.76,Default,,0,0,0,,Мен әлі ояу едім.
Dialogue: 0,0:20:37.98,0:20:39.17,Default,,0,0,0,,Менің қарным ашты
Dialogue: 0,0:20:40.59,0:20:42.26,Default,,0,0,0,,Тоңазытқышта торт бар.
Dialogue: 0,0:20:44.76,0:20:47.29,Default,,0,0,0,,Менің ойымша, бұл кремді және жабысқақ.
Dialogue: 0,0:20:48.78,0:20:54.14,Default,,0,0,0,,Көзді ашып-жұмғанша, білмей тұрып әже болдым.
Dialogue: 0,0:20:56.28,0:20:57.51,Default,,0,0,0,,Ол әлі 40-та.
Dialogue: 0,0:20:59.88,0:21:01.10,Default,,0,0,0,,38
Dialogue: 0,0:21:05.04,0:21:07.60,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:21:09.05,0:21:14.07,Default,,0,0,0,,Рика бәрібір мені тастап кетеді, солай ма?
Dialogue: 0,0:21:19.23,0:21:21.12,Default,,0,0,0,,Бірақ қазір емес
Dialogue: 0,0:21:26.03,0:21:26.65,Default,,0,0,0,,Иә
Dialogue: 0,0:21:28.15,0:21:33.15,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
