Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:14.39,0:00:15.79,Default,,0,0,0,,Сәлеметсіз бе, қош келдіңіз
Dialogue: 0,0:00:16.42,0:00:18.17,Default,,0,0,0,,Ғажайып жұмыртқаны қалайсыз ба?
Dialogue: 0,0:00:18.17,0:00:19.01,Default,,0,0,0,,қиын
Dialogue: 0,0:00:21.12,0:00:23.99,Default,,0,0,0,,Не? Әлі де шатастырасыз ба?
Dialogue: 0,0:00:24.48,0:00:25.91,Default,,0,0,0,,Жоғалмаңыз
Dialogue: 0,0:00:26.35,0:00:29.09,Default,,0,0,0,,Батыл болыңыз және өзіңізге сеніңіз
Dialogue: 0,0:00:29.64,0:00:31.62,Default,,0,0,0,,Жұмыртқаны сындырыңыз
Dialogue: 0,0:00:31.94,0:00:32.91,Default,,0,0,0,,Жарайды, осы ғана. Абай бол.
Dialogue: 0,0:00:34.12,0:00:36.34,Default,,0,0,0,,Онда сіз қалаған нәрсе бар
Dialogue: 0,0:00:36.57,0:00:39.18,Default,,0,0,0,,Сіздің қалауыңыз қамтылған
Dialogue: 0,0:00:40.88,0:00:43.54,Default,,0,0,0,,Жұмыртқа әлемінде сол затты сындырсаң
Dialogue: 0,0:00:44.06,0:00:46.65,Default,,0,0,0,,Ал егер сіз тапсырманы орындасаңыз
Dialogue: 0,0:00:48.93,0:00:50.50,Default,,0,0,0,,Аздап жылы
Dialogue: 0,0:00:51.42,0:00:54.15,Default,,0,0,0,,Мүмкін сіз оны қайтара аласыз
Dialogue: 0,0:00:54.50,0:00:55.49,Default,,0,0,0,,Достар
Dialogue: 0,0:00:56.01,0:00:57.20,Default,,0,0,0,,Естеліктер
Dialogue: 0,0:00:57.71,0:00:59.10,Default,,0,0,0,,Маңызды адам
Dialogue: 0,0:01:00.52,0:01:01.95,Default,,0,0,0,,Бірінші рет қызмет көрсету.
Dialogue: 0,0:01:02.28,0:01:04.14,Default,,0,0,0,,Келесі жолы әмияныңызды әкеліңіз.
Dialogue: 0,0:01:04.81,0:01:08.43,Default,,0,0,0,,Иә? Сіз жұмыртқаны қалай жасайсыз?
Dialogue: 0,0:01:08.43,0:01:11.18,Default,,0,0,0,,Бұл коммерциялық құпия.
Dialogue: 0,0:01:11.57,0:01:13.58,Default,,0,0,0,,Мен саған бұлай оңай үйрете алмаймын.
Dialogue: 0,0:01:14.45,0:01:18.28,Default,,0,0,0,,Дұрыс, оның орнына менің тұрақты тұтынушым туралы айтайық.
Dialogue: 0,0:01:18.87,0:01:21.48,Default,,0,0,0,,Өте сүйкімді қыз және төрт адам
Dialogue: 0,0:01:21.98,0:01:25.59,Default,,0,0,0,,Бұл ешкім білмейтін, бізге ғана тән оқиға.
Dialogue: 0,0:01:27.26,0:01:28.63,Default,,0,0,0,,Ешкім білмейді...
Dialogue: 0,0:01:29.76,0:01:30.90,Default,,0,0,0,,Әңгіме
Dialogue: 0,0:01:32.13,0:01:34.92,Default,,0,0,0,,Шешім қабылдамас бұрын әңгімені тыңдаңыз.
Dialogue: 0,0:01:35.96,0:01:38.47,Default,,0,0,0,,Жұмыртқаны үйге апарғыңыз келе ме, жоқ па.
Dialogue: 0,0:01:41.94,0:01:43.02,Default,,0,0,0,,О, дұрыс. Сенде де Хиёри-чаннан сұрағың келетін нәрсе бар емес пе?
Dialogue: 0,0:01:55.83,0:01:56.91,Default,,0,0,0,,Мұнда не бар?
Dialogue: 0,0:01:58.13,0:02:00.80,Default,,0,0,0,,Бұл шындық емес, арман
Dialogue: 0,0:02:01.33,0:02:05.09,Default,,0,0,0,,Менің ойымша, сіз оны жұмыртқалар әлемі деп атауға болады.
Dialogue: 0,0:02:05.33,0:02:08.76,Default,,0,0,0,,Жұмыртқаны сындырған адам ғана қосыла алады.
Dialogue: 0,0:02:08.76,0:02:12.11,Default,,0,0,0,,Психикалық пейзаж күшті бейнеленген әлем
Dialogue: 0,0:02:12.11,0:02:18.41,Default,,0,0,0,,Сонымен қатар, белгілі бір жағдайларда сіз әлемді басқа адамдармен бөлісе аласыз, бұл қызықты болар еді.
Dialogue: 0,0:02:18.65,0:02:19.86,Default,,0,0,0,,Синхрондалған
Dialogue: 0,0:02:20.15,0:02:21.15,Default,,0,0,0,,Синхронизация?
Dialogue: 0,0:02:23.15,0:02:25.93,Default,,0,0,0,,Сіз бір уақытта өте жақын ұйықтадыңыз.
Dialogue: 0,0:02:25.93,0:02:26.78,Default,,0,0,0,,Сонымен
Dialogue: 0,0:02:27.24,0:02:29.95,Default,,0,0,0,,Бірақ неге бұл менің арманым емес?
Dialogue: 0,0:02:30.49,0:02:33.41,Default,,0,0,0,,Мен қатты сезімдерім бар адамға тартамын.
Dialogue: 0,0:02:34.12,0:02:37.29,Default,,0,0,0,,Жұмыртқаны жарыңыз
Dialogue: 0,0:02:37.96,0:02:38.87,Default,,0,0,0,,Жұмыртқа?
Dialogue: 0,0:02:39.33,0:02:40.97,Default,,0,0,0,,Ғажайып жұмыртқа
Dialogue: 0,0:02:41.62,0:02:46.08,Default,,0,0,0,,Ғажайып жұмыртқаны сындырсаң, ішінен бір қыз шығады.
Dialogue: 0,0:02:49.34,0:02:51.77,Default,,0,0,0,,Өлімге өз еркімен жақындау
Dialogue: 0,0:02:51.77,0:02:53.75,Default,,0,0,0,,Бұл дүниеден өткен балалар.
Dialogue: 0,0:02:53.93,0:02:56.03,Default,,0,0,0,,Оларды қорғаңыз
Dialogue: 0,0:02:56.48,0:02:57.79,Default,,0,0,0,,Неден?
Dialogue: 0,0:02:58.05,0:03:01.32,Default,,0,0,0,,Көзіңді жұма, таңқаларлық өлтіруші
Dialogue: 0,0:03:07.27,0:03:08.02,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:03:08.02,0:03:09.16,Default,,0,0,0,,Сіз білесіз
Dialogue: 0,0:03:11.15,0:03:12.56,Default,,0,0,0,,Көзді жұмып ал
Dialogue: 0,0:03:13.90,0:03:14.94,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:03:15.16,0:03:16.20,Default,,0,0,0,,Көргенім, нато мен үшін емес екен
Dialogue: 0,0:03:16.58,0:03:19.72,Default,,0,0,0,,Олай болса, бірден тұрақтылар туралы сөйлесейік.
Dialogue: 0,0:03:20.28,0:03:22.49,Default,,0,0,0,,Оның аты - Ай Ото
Dialogue: 0,0:03:22.91,0:03:25.53,Default,,0,0,0,,14 жаста, оның сол және оң көзінің түсі әртүрлі
Dialogue: 0,0:03:25.75,0:03:27.63,Default,,0,0,0,,Орта мектептің екінші курсындағы қыз
Dialogue: 0,0:03:28.18,0:03:30.67,Default,,0,0,0,,Ай-чан, маған мұғалім керек.
Dialogue: 0,0:03:30.93,0:03:33.87,Default,,0,0,0,,Анашым, сізге телефон соғуға мәжбүрлеудің қажеті жоқ.
Dialogue: 0,0:03:34.80,0:03:37.69,Default,,0,0,0,,Біз кездескен кезде ол мектепке бармады.
Dialogue: 0,0:03:37.87,0:03:40.82,Default,,0,0,0,,Біртүрлі көздері үшін оны қорлады.
Dialogue: 0,0:03:40.82,0:03:45.11,Default,,0,0,0,,Мектепке бармаудың жалғыз себебі бұл емес.
Dialogue: 0,0:03:46.31,0:03:47.31,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:03:48.11,0:03:48.86,Default,,0,0,0,,Ойын
Dialogue: 0,0:03:49.61,0:03:50.79,Default,,0,0,0,,Сізге ойындар ұнайды ма?
Dialogue: 0,0:03:51.70,0:03:53.94,Default,,0,0,0,,Мен Айдың сыныбына ауыстым.
Dialogue: 0,0:03:53.94,0:03:58.72,Default,,0,0,0,,Който Нагасемен кездесу оның тағдырын түбегейлі өзгертті.
Dialogue: 0,0:03:59.03,0:04:00.01,Default,,0,0,0,,мистикалық
Dialogue: 0,0:04:00.78,0:04:02.33,Default,,0,0,0,,Мен сенің жасыратын ештеңең жоқ деп ойлаймын.
Dialogue: 0,0:04:02.92,0:04:06.30,Default,,0,0,0,,Мені үнемі қорлап жүрсе де
Dialogue: 0,0:04:09.38,0:04:10.43,Default,,0,0,0,,Бұл әдемі
Dialogue: 0,0:04:18.27,0:04:20.14,Default,,0,0,0,,Менімен дос бол
Dialogue: 0,0:04:25.09,0:04:26.92,Default,,0,0,0,,Ең жақын дос болайық
Dialogue: 0,0:04:29.81,0:04:32.56,Default,,0,0,0,,Мен бола алсам, бақытты болар едім
Dialogue: 0,0:04:33.74,0:04:34.71,Default,,0,0,0,,Мен де
Dialogue: 0,0:04:36.71,0:04:38.57,Default,,0,0,0,,Ақыры мен жақсы дос таптым.
Dialogue: 0,0:04:38.82,0:04:42.52,Default,,0,0,0,,Бірақ бір күні мен оны кенеттен жоғалтамын.
Dialogue: 0,0:04:45.36,0:04:46.96,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:04:47.80,0:04:49.82,Default,,0,0,0,,Классикалық қудалау.
Dialogue: 0,0:04:50.30,0:04:52.22,Default,,0,0,0,,Който-чан неге бұлай?
Dialogue: 0,0:04:52.75,0:04:54.34,Default,,0,0,0,,Өйткені сен менің досымсың
Dialogue: 0,0:04:54.62,0:04:55.80,Default,,0,0,0,,Қандай қатыгез қимыл…
Dialogue: 0,0:04:56.72,0:04:59.64,Default,,0,0,0,,Саваки-сенсей маған ұнайды.
Dialogue: 0,0:04:59.64,0:05:01.68,Default,,0,0,0,,Қызғаншақ, қызғаншақ сияқтысың.
Dialogue: 0,0:05:03.45,0:05:04.44,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:05:05.01,0:05:06.60,Default,,0,0,0,,Мен қорқып, саған қарай бұрылдым.
Dialogue: 0,0:05:07.49,0:05:09.34,Default,,0,0,0,,Мен шетте қалудан қорқамын
Dialogue: 0,0:05:13.72,0:05:14.79,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:05:21.58,0:05:23.49,Default,,0,0,0,,Бейне түсірдіңіз бе?
Dialogue: 0,0:05:26.11,0:05:28.73,Default,,0,0,0,,Мен қорықтым, кешіріңіз.
Dialogue: 0,0:05:28.97,0:05:29.97,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:05:30.30,0:05:34.05,Default,,0,0,0,,Жарайды, қолыңнан келгеннің бәрін істегеніңді білемін.
Dialogue: 0,0:05:34.05,0:05:35.18,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:05:35.37,0:05:36.75,Default,,0,0,0,,Бұл менің кінәм
Dialogue: 0,0:05:38.60,0:05:41.74,Default,,0,0,0,,Себебі мен саған опасыздық жасадым
Dialogue: 0,0:05:42.52,0:05:44.70,Default,,0,0,0,,Които Нагасе өз-өзіне қол жұмсады
Dialogue: 0,0:05:44.96,0:05:46.27,Default,,0,0,0,,Неге өлдің?
Dialogue: 0,0:05:46.45,0:05:48.37,Default,,0,0,0,,Маған бірдеңе жетіспеді ме?
Dialogue: 0,0:05:48.61,0:05:50.97,Default,,0,0,0,,Койтоны артқа итеріп жіберген кім?
Dialogue: 0,0:05:51.46,0:05:53.90,Default,,0,0,0,,Жоғалған досымды қайтару үшін
Dialogue: 0,0:05:53.90,0:05:55.31,Default,,0,0,0,,Ай төбелесіп жатыр
Dialogue: 0,0:05:55.31,0:05:58.10,Default,,0,0,0,,Мен енді көзімді жұмымаймын
Dialogue: 0,0:05:59.74,0:06:00.67,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:06:01.45,0:06:04.37,Default,,0,0,0,,Жүрегімнің бір жерінде кек сақтадым.
Dialogue: 0,0:06:05.62,0:06:09.30,Default,,0,0,0,,Дос болсақ та, неге бұл туралы менімен сөйлеспедің?
Dialogue: 0,0:06:09.92,0:06:11.02,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:06:11.02,0:06:13.30,Default,,0,0,0,,Менен өзіңмен бірге өлуімді сұрасаң
Dialogue: 0,0:06:14.09,0:06:14.84,Default,,0,0,0,,Мен...
Dialogue: 0,0:06:20.22,0:06:22.97,Default,,0,0,0,,Мен!
Dialogue: 0,0:06:23.36,0:06:26.95,Default,,0,0,0,,Мен Тосакаға келдім.
Dialogue: 0,0:06:30.77,0:06:32.62,Default,,0,0,0,,Миссияның анық болуы да шарт болып табылады
Dialogue: 0,0:06:32.62,0:06:35.23,Default,,0,0,0,,Жұмыртқа балаларының ұрыс-керістері мен құмарлықтары
Dialogue: 0,0:06:35.61,0:06:39.16,Default,,0,0,0,,Defeating the symbol of trauma “Wonder Killer”
Dialogue: 0,0:06:41.57,0:06:44.57,Default,,0,0,0,,Жұмыртқа әлемінде сен өлмейтінсің.
Dialogue: 0,0:06:44.57,0:06:47.95,Default,,0,0,0,,Also, your physical ability will improve dramatically.
Dialogue: 0,0:06:47.95,0:06:50.91,Default,,0,0,0,,Мен Тосакаға келдім.
Dialogue: 0,0:06:53.73,0:06:57.03,Default,,0,0,0,,Even if you say you're immortal, be careful not to get hurt.
Dialogue: 0,0:06:57.03,0:06:59.96,Default,,0,0,0,,If you come home injured, you'll end up like this guy.
Dialogue: 0,0:07:00.30,0:07:01.56,Default,,0,0,0,,Нейру Аонума
Dialogue: 0,0:07:01.56,0:07:03.80,Default,,0,0,0,,Бұл менің байланыс ақпаратым
Dialogue: 0,0:07:04.05,0:07:06.40,Default,,0,0,0,,Егер кестеңізді өзгерткіңіз келсе, бізге хабарласыңыз.
Dialogue: 0,0:07:06.40,0:07:08.07,Default,,0,0,0,,Менің тақ күндерім бар
Dialogue: 0,0:07:08.07,0:07:10.23,Default,,0,0,0,,Жұмыртқаларды жұп күндері сатып аласың
Dialogue: 0,0:07:10.89,0:07:12.98,Default,,0,0,0,,Бір-бірімізді қайта көрудің қажеті жоқ
Dialogue: 0,0:07:12.98,0:07:15.00,Default,,0,0,0,,Нейру 14 жаста
Dialogue: 0,0:07:15.00,0:07:17.86,Default,,0,0,0,,Өз компаниясын басқаратын данышпан қыз
Dialogue: 0,0:07:17.86,0:07:18.86,Default,,0,0,0,,Үлкен
Dialogue: 0,0:07:18.86,0:07:22.20,Default,,0,0,0,,Тыныш және көп нәрсені айтпайды
Dialogue: 0,0:07:22.20,0:07:24.98,Default,,0,0,0,,Not trying to actively interact with people
Dialogue: 0,0:07:26.27,0:07:26.89,Default,,0,0,0,,Иә
Dialogue: 0,0:07:28.67,0:07:29.57,Default,,0,0,0,,Рахмет
Dialogue: 0,0:07:31.36,0:07:33.43,Default,,0,0,0,,Бұл өте жақсы иіс.
Dialogue: 0,0:07:36.30,0:07:37.27,Default,,0,0,0,,Эмма мен басқалары – мен бұрын-соңды көрген де, сөйлескен де алғашқы адамдар еді.
Dialogue: 0,0:07:37.95,0:07:38.55,Default,,0,0,0,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:07:44.43,0:07:47.10,Default,,0,0,0,,Ай адамдарға сену оңай.
Dialogue: 0,0:07:47.48,0:07:48.76,Default,,0,0,0,,Мен сені бірден кешіремін
Dialogue: 0,0:07:49.85,0:07:51.27,Default,,0,0,0,,Істер дұрыс емес жерде
Dialogue: 0,0:07:54.36,0:07:55.65,Default,,0,0,0,,Керемет жер
Dialogue: 0,0:07:57.44,0:07:59.89,Default,,0,0,0,,Жаман, бірақ жақсы орын
Dialogue: 0,0:08:00.36,0:08:02.82,Default,,0,0,0,,Sometimes I need someone like that to be with me.
Dialogue: 0,0:08:02.82,0:08:04.45,Default,,0,0,0,,Біз құтқарылған жоқпыз
Dialogue: 0,0:08:04.99,0:08:07.82,Default,,0,0,0,,She seems to have feelings for Ai, but capable women actually ruin men.
Dialogue: 0,0:08:07.82,0:08:10.57,Default,,0,0,0,,Маған неге қарап тұрсың? It seems like Ai has feelings for me, but capable women actually ruin men. Сіз Рикаға біраз қаталсыз. Неге маған қарап тұрсың?
Dialogue: 0,0:08:12.15,0:08:14.45,Default,,0,0,0,,Анахронист ақымақ әйел
Dialogue: 0,0:08:15.12,0:08:16.59,Default,,0,0,0,,Кім ақымақ?
Dialogue: 0,0:08:16.59,0:08:17.56,Default,,0,0,0,,Тоқта, ақымақ.
Dialogue: 0,0:08:21.34,0:08:22.40,Default,,0,0,0,,Осылай ма?
Dialogue: 0,0:08:23.55,0:08:26.13,Default,,0,0,0,,We're pretty good friends, though, and there's a cute side to us too.
Dialogue: 0,0:08:26.13,0:08:27.56,Default,,0,0,0,,Дұрыс, цундере.
Dialogue: 0,0:08:27.56,0:08:28.35,Default,,0,0,0,,Айырмашылық
Dialogue: 0,0:08:28.91,0:08:31.12,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:08:34.98,0:08:37.68,Default,,0,0,0,,Нейру әпкесінің қайтып оралғанын қалайды
Dialogue: 0,0:08:37.68,0:08:39.52,Default,,0,0,0,,Жұмыртқа сатып алу және төбелесу
Dialogue: 0,0:08:39.52,0:08:42.30,Default,,0,0,0,,Сіз кім үшін күресіп жатырсыз?
Dialogue: 0,0:08:42.52,0:08:44.24,Default,,0,0,0,,Бұл шынымен өзіңіз үшін емес пе?
Dialogue: 0,0:08:44.24,0:08:46.78,Default,,0,0,0,,Мен қазір кім екенімді жек көремін, сондықтан барамын
Dialogue: 0,0:08:47.33,0:08:48.77,Default,,0,0,0,,Мен қорқамын, бірақ тағы барамын
Dialogue: 0,0:08:49.15,0:08:50.91,Default,,0,0,0,,Өйткені мен жек көретін нәрсені өзгерткім келеді
Dialogue: 0,0:08:51.45,0:08:53.66,Default,,0,0,0,,Кешіріңіз, бірақ мен кетуім керек.
Dialogue: 0,0:08:54.09,0:08:55.07,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:08:55.54,0:08:57.45,Default,,0,0,0,,Неліктен өз-өзіне қол жұмсайсың?
Dialogue: 0,0:08:57.45,0:08:59.66,Default,,0,0,0,,Осындай өзімшілдік үшін
Dialogue: 0,0:08:59.66,0:09:02.50,Default,,0,0,0,,Рика Нейру әпкесіне көмектесуге барады
Dialogue: 0,0:09:02.50,0:09:03.25,Default,,0,0,0,,Жоқ
Dialogue: 0,0:09:04.35,0:09:06.10,Default,,0,0,0,,Әпкем мені пышақтап тастады
Dialogue: 0,0:09:07.79,0:09:10.75,Default,,0,0,0,,Сосын қашып, көпірден секірді.
Dialogue: 0,0:09:10.75,0:09:11.63,Default,,0,0,0,,Бұл...
Dialogue: 0,0:09:12.48,0:09:15.71,Default,,0,0,0,,Мен реанимациядан оянып, оқиғаны естідім.
Dialogue: 0,0:09:15.87,0:09:18.29,Default,,0,0,0,,Сонда одан да көп
Dialogue: 0,0:09:18.79,0:09:21.06,Default,,0,0,0,,Жара әлі ауырады, мен ұйықтай алмаймын.
Dialogue: 0,0:09:21.82,0:09:24.90,Default,,0,0,0,,Бірақ мен ол жаққа бара бастағаннан бері
Dialogue: 0,0:09:24.90,0:09:26.20,Default,,0,0,0,,Ол айтарлықтай әлсіреді.
Dialogue: 0,0:09:27.02,0:09:28.61,Default,,0,0,0,,Ұмытуға тырысқанда
Dialogue: 0,0:09:28.87,0:09:31.32,Default,,0,0,0,,Шрамы қарғыс боп ауырады
Dialogue: 0,0:09:31.32,0:09:32.63,Default,,0,0,0,,Сонымен жүр
Dialogue: 0,0:09:33.55,0:09:35.00,Default,,0,0,0,,Басқа себеп жоқ
Dialogue: 0,0:09:36.87,0:09:38.04,Default,,0,0,0,,Өзіңіз үшін
Dialogue: 0,0:09:39.22,0:09:41.09,Default,,0,0,0,,Қыз баладан үлкенге дейін
Dialogue: 0,0:09:41.67,0:09:44.76,Default,,0,0,0,,Көбелекке айналған қуыршақтың ғажайып сұлулығы
Dialogue: 0,0:09:45.29,0:09:46.54,Default,,0,0,0,,Бір сәтке
Dialogue: 0,0:09:49.32,0:09:51.31,Default,,0,0,0,,Сіз де әдемі емессіз
Dialogue: 0,0:09:51.31,0:09:52.94,Default,,0,0,0,,Неге өлмейсің?
Dialogue: 0,0:09:52.94,0:09:57.89,Default,,0,0,0,,Неліктен ең әдемі сәтте өлудің орнына мағынасыз өмірге жабысасың?
Dialogue: 0,0:09:57.89,0:10:00.78,Default,,0,0,0,,Әй, сен неге өлмейсің?
Dialogue: 0,0:10:02.51,0:10:06.95,Default,,0,0,0,,Айна, айна, дүниедегі ең әдемі нәрсе
Dialogue: 0,0:10:09.24,0:10:11.70,Default,,0,0,0,,Мен сенің ойыңды жаралаймын
Dialogue: 0,0:10:14.16,0:10:16.61,Default,,0,0,0,,Неге өлмейсің?
Dialogue: 0,0:10:17.16,0:10:20.41,Default,,0,0,0,,Сен мені өлімге азғырдың.
Dialogue: 0,0:10:24.47,0:10:26.72,Default,,0,0,0,,Жұмыртқа әлемінен алған тәжірибем
Dialogue: 0,0:10:26.72,0:10:29.42,Default,,0,0,0,,Ол шынайы дүниеде сол қалпында бейнеленеді.
Dialogue: 0,0:10:29.67,0:10:32.23,Default,,0,0,0,,Мысалы, жүгіру немесе ұшу кезінде
Dialogue: 0,0:10:32.23,0:10:34.47,Default,,0,0,0,,Сіздің негізгі физикалық күшіңіз жақсарған кезде.
Dialogue: 0,0:10:35.78,0:10:37.23,Default,,0,0,0,,Сол жақтағы шайқас
Dialogue: 0,0:10:37.23,0:10:40.19,Default,,0,0,0,,Бұл біздің денемізге көп күш түсіретін сияқты.
Dialogue: 0,0:10:40.90,0:10:42.96,Default,,0,0,0,,Биік биіктіктегі жаттығулар сияқты
Dialogue: 0,0:10:43.13,0:10:43.91,Default,,0,0,0,,Иә
Dialogue: 0,0:10:44.21,0:10:48.24,Default,,0,0,0,,Қазір ойлап қарасам, ішім жарылып бара жатқандай болды.
Dialogue: 0,0:10:48.62,0:10:50.53,Default,,0,0,0,,Жаралар тез жазылады
Dialogue: 0,0:10:50.53,0:10:52.64,Default,,0,0,0,,Дұрыс емделгеннен кейін оралыңыз.
Dialogue: 0,0:10:58.02,0:11:00.19,Default,,0,0,0,,Алдымен кішкене үлкен өзгеріс
Dialogue: 0,0:11:00.19,0:11:01.79,Default,,0,0,0,,Мәселе сіз үйренгеніңізде.
Dialogue: 0,0:11:02.67,0:11:05.23,Default,,0,0,0,,Мен өзгеремін
Dialogue: 0,0:11:05.88,0:11:09.13,Default,,0,0,0,,Жарайды, сенің де қолыңнан келеді.
Dialogue: 0,0:11:10.27,0:11:14.34,Default,,0,0,0,,Мен сенің ойыңды жаралаймын
Dialogue: 0,0:11:14.89,0:11:16.07,Default,,0,0,0,,Тоқта
Dialogue: 0,0:11:16.69,0:11:20.35,Default,,0,0,0,,Бұлай етпеуім керек, мені жайына қалдыр.
Dialogue: 0,0:11:20.61,0:11:21.23,Default,,0,0,0,,Сонымен
Dialogue: 0,0:11:21.23,0:11:23.12,Default,,0,0,0,,Мына сүйкімді қыз
Dialogue: 0,0:11:23.81,0:11:28.73,Default,,0,0,0,,Бұл біреудің мені тауып, сүйгенін қалайтынымды білдіреді.
Dialogue: 0,0:11:29.68,0:11:31.37,Default,,0,0,0,,Сондықтан мен оны жалғыз қалдыра алмаймын
Dialogue: 0,0:11:32.28,0:11:33.57,Default,,0,0,0,,Мен сені жалғыз қалдыра алмаймын
Dialogue: 0,0:11:36.12,0:11:37.18,Default,,0,0,0,,оны қалай қолдануыңа байланысты адамдарға көмектесе алады.
Dialogue: 0,0:11:37.66,0:11:41.99,Default,,0,0,0,,Бұл тек билікті қудалау.
Dialogue: 0,0:11:42.87,0:11:46.04,Default,,0,0,0,,Мен Тосакаға келдім.
Dialogue: 0,0:11:46.04,0:11:48.59,Default,,0,0,0,,Қош бол мұғалім
Dialogue: 0,0:11:50.04,0:11:52.28,Default,,0,0,0,,Рахмет саған Ай Чан
Dialogue: 0,0:12:08.40,0:12:10.31,Default,,0,0,0,,Бұл балалар Митеминуфури емес.
Dialogue: 0,0:12:10.31,0:12:11.44,Default,,0,0,0,,Anti
Dialogue: 0,0:12:11.44,0:12:14.32,Default,,0,0,0,,Бұл сіздердің бұл дүниеде тым көзге түсетіндеріңізді білдіреді.
Dialogue: 0,0:12:15.14,0:12:16.89,Default,,0,0,0,,Miteminufri ішінен
Dialogue: 0,0:12:16.89,0:12:19.97,Default,,0,0,0,,Қызғаныш пен арандатушылық сізге деген өшпенділік тудырды.
Dialogue: 0,0:12:21.68,0:12:25.27,Default,,0,0,0,,Бетімді көрсетуге батылым жетпейді, бірақ мен жындымын
Dialogue: 0,0:12:25.49,0:12:26.96,Default,,0,0,0,,Клик құру кезінде күшті
Dialogue: 0,0:12:27.23,0:12:29.22,Default,,0,0,0,,Жаман болсаң, бастықтай боласың.
Dialogue: 0,0:12:29.22,0:12:31.07,Default,,0,0,0,,Run away or hide
Dialogue: 0,0:12:31.24,0:12:34.22,Default,,0,0,0,,Нысаналы сіз, Батырлар назарында.
Dialogue: 0,0:12:34.66,0:12:36.86,Default,,0,0,0,,Қоңырау дыбысы шыққанша осында жасырыңыз.
Dialogue: 0,0:12:37.24,0:12:40.26,Default,,0,0,0,,Миссия шайқассыз аяқталмайды
Dialogue: 0,0:12:41.04,0:12:44.11,Default,,0,0,0,,Ал, статус-кво бүгінгі күні өзгеріссіз қалды.
Dialogue: 0,0:12:44.59,0:12:46.13,Default,,0,0,0,,Қарсы шаралар қарастырылды
Dialogue: 0,0:12:46.53,0:12:49.35,Default,,0,0,0,,Бірақ Я Чан мен үшін ренжіді.
Dialogue: 0,0:12:49.35,0:12:50.38,Default,,0,0,0,,Мен Тодомен мүмкіндігінше тезірек кездескім келеді—немесе ең болмағанда Мивамен—бірақ
Dialogue: 0,0:12:50.92,0:12:54.36,Default,,0,0,0,,Жұмыртқаға қайта оралсаңыз, ол ең жылдам жылдамдықпен қалпына келеді.
Dialogue: 0,0:12:56.06,0:12:57.44,Default,,0,0,0,,Сіз оны таптыңыз ба?
Dialogue: 0,0:12:57.94,0:13:00.62,Default,,0,0,0,,Белгіленген уақытқа дейін жұмыртқаны қорғаңыз
Dialogue: 0,0:13:00.62,0:13:01.95,Default,,0,0,0,,Бұл басты басымдық.
Dialogue: 0,0:13:02.55,0:13:04.95,Default,,0,0,0,,Қоғамның негізі – есеп беру.
Dialogue: 0,0:13:05.11,0:13:06.79,Default,,0,0,0,,Share it out loud
Dialogue: 0,0:13:07.17,0:13:09.45,Default,,0,0,0,,Біздің ең үлкен мақсатымыз
Dialogue: 0,0:13:09.87,0:13:10.79,Default,,0,0,0,,Wonder
Dialogue: 0,0:13:11.17,0:13:12.05,Default,,0,0,0,,Жұмыртқа
Dialogue: 0,0:13:13.17,0:13:14.33,Default,,0,0,0,,Priority
Dialogue: 0,0:13:15.13,0:13:16.53,Default,,0,0,0,,Осы қарқынмен… әсіресе «жұма мен сенбі күндері,
Dialogue: 0,0:13:17.88,0:13:19.84,Default,,0,0,0,,Бұл бала Рика Кавай
Dialogue: 0,0:13:20.29,0:13:22.57,Default,,0,0,0,,Бұрынғы кіші кумир қыз
Dialogue: 0,0:13:23.68,0:13:27.44,Default,,0,0,0,,Мені өте сүйкімді Ликка-чанмен есте сақта
Dialogue: 0,0:13:28.51,0:13:30.95,Default,,0,0,0,,Әңгімешіл адам
Dialogue: 0,0:13:30.95,0:13:33.16,Default,,0,0,0,,Ең бастысы, қыңыр
Dialogue: 0,0:13:33.16,0:13:36.49,Default,,0,0,0,,Оның үстіне мен әмиянымды ұмытып кетіппін.
Dialogue: 0,0:13:36.74,0:13:38.82,Default,,0,0,0,,Кешіріңіз, бірақ оны маған қарызға бере аласыз ба?
Dialogue: 0,0:13:39.75,0:13:40.68,Default,,0,0,0,,Рахмет
Dialogue: 0,0:13:43.11,0:13:44.90,Default,,0,0,0,,Риканы қайта көрейік.
Dialogue: 0,0:13:45.57,0:13:46.75,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:13:47.99,0:13:50.74,Default,,0,0,0,,Ол бір қарағанда күшті көрінеді, бірақ
Dialogue: 0,0:13:51.24,0:13:53.06,Default,,0,0,0,,Отбасы ортасы күрделі
Dialogue: 0,0:13:53.27,0:13:56.74,Default,,0,0,0,,Әке, әдемі әйелдерге әмиянды алып жүрудің қажеті жоқ.
Dialogue: 0,0:13:56.74,0:13:59.27,Default,,0,0,0,,Оны маған біреу рұқсатсыз бергендіктен.
Dialogue: 0,0:13:59.78,0:14:01.79,Default,,0,0,0,,Жарайды, мен ажырастым.
Dialogue: 0,0:14:02.79,0:14:05.09,Default,,0,0,0,,Менің нағыз әкем осында
Dialogue: 0,0:14:05.09,0:14:08.14,Default,,0,0,0,,Енді нағыз кім?
Dialogue: 0,0:14:08.14,0:14:10.73,Default,,0,0,0,,Рика өзінің шын әкесін танымайды
Dialogue: 0,0:14:11.13,0:14:13.90,Default,,0,0,0,,Ал мен бұрын-соңды танымайтын әкеммен ынтық болдым.
Dialogue: 0,0:14:14.10,0:14:15.94,Default,,0,0,0,,Мен анамды сағындым
Dialogue: 0,0:14:17.44,0:14:18.75,Default,,0,0,0,,Міне
Dialogue: 0,0:14:19.11,0:14:21.98,Default,,0,0,0,,Анам да түсінбейді.
Dialogue: 0,0:14:22.74,0:14:27.72,Default,,0,0,0,,Солардың бірі шығар деп ойлаймын.
Dialogue: 0,0:14:28.82,0:14:31.20,Default,,0,0,0,,Мен сені бір күні көремін
Dialogue: 0,0:14:31.67,0:14:32.57,Default,,0,0,0,,Бұл — бір сәт бұрынғы Итадори ешқашан жасамайтын қимыл
Dialogue: 0,0:14:33.62,0:14:35.34,Default,,0,0,0,,Мен сені қазір көргім келеді
Dialogue: 0,0:14:36.65,0:14:37.42,Default,,0,0,0,,Үш ойыншы оны құлатып тастады
Dialogue: 0,0:14:43.99,0:14:45.20,Default,,0,0,0,,No
Dialogue: 0,0:14:46.25,0:14:47.26,Default,,0,0,0,,No
Dialogue: 0,0:14:49.61,0:14:51.70,Default,,0,0,0,,Рика қызды құтқарғысы келеді
Dialogue: 0,0:14:52.04,0:14:54.90,Default,,0,0,0,,Фан Чиеми кіші кумир болған кезде
Dialogue: 0,0:14:55.32,0:14:58.65,Default,,0,0,0,,Маған бәрін сатып алған әмияным
Dialogue: 0,0:14:59.44,0:15:01.76,Default,,0,0,0,,Чиеми - ақымақ.
Dialogue: 0,0:15:02.98,0:15:06.61,Default,,0,0,0,,Бұл мен үшін бірнеше рет және жүздеген рет
Dialogue: 0,0:15:07.00,0:15:11.66,Default,,0,0,0,,Күлімсіреп, қалтаңдағы ақшаңды және жаңа жылдық сыйлықты табиғи нәрседей сыйла.
Dialogue: 0,0:15:13.20,0:15:16.70,Default,,0,0,0,,Мен бір байға сендім.
Dialogue: 0,0:15:17.46,0:15:20.24,Default,,0,0,0,,Бір күні көшеде ұрлық жасап жатқан біреуді ұстап қалдым.
Dialogue: 0,0:15:21.46,0:15:23.14,Default,,0,0,0,,Мен оны қолма-қол ақшаға айналдырдым.
Dialogue: 0,0:15:23.39,0:15:23.90,Default,,0,0,0,,Иә
Dialogue: 0,0:15:30.32,0:15:32.53,Default,,0,0,0,,Түсіндім, түсінемін сол сезімді.
Dialogue: 0,0:15:33.13,0:15:35.39,Default,,0,0,0,,Біз де әке болып жұмыс істедік.
Dialogue: 0,0:15:35.39,0:15:37.03,Default,,0,0,0,,Маған ұнамады
Dialogue: 0,0:15:37.63,0:15:40.42,Default,,0,0,0,,Сондықтан жанкүйерлеріңмен дос бола алмайсың.
Dialogue: 0,0:15:40.89,0:15:45.03,Default,,0,0,0,,Біріншіден, семіз адамдар бұл мүмкін емес дейді, өйткені олармен бірге болу ұят болады.
Dialogue: 0,0:15:45.20,0:15:46.65,Default,,0,0,0,,Енді келме
Dialogue: 0,0:15:48.32,0:15:51.12,Default,,0,0,0,,Кейінірек маған тағы бір жанкүйер айтты
Dialogue: 0,0:15:51.12,0:15:52.77,Default,,0,0,0,,Чиеми қайтыс болды.
Dialogue: 0,0:15:53.65,0:15:56.54,Default,,0,0,0,,Тері мен сүйектен тұратын мумия сияқты.
Dialogue: 0,0:15:57.46,0:15:59.55,Default,,0,0,0,,Ұмытқым келсе де, ұмыта алмаймын.
Dialogue: 0,0:16:00.69,0:16:04.05,Default,,0,0,0,,Бұл Чиеми емес.
Dialogue: 0,0:16:04.21,0:16:05.98,Default,,0,0,0,,Өз сөзіммен
Dialogue: 0,0:16:05.98,0:16:09.98,Default,,0,0,0,,Чиемидің өлуіне жол бергеніме өкінемін.
Dialogue: 0,0:16:09.98,0:16:11.93,Default,,0,0,0,,Осылайша ол төбелеседі
Dialogue: 0,0:16:12.29,0:16:14.13,Default,,0,0,0,,Сіздің маңызды нүктелеріңізге
Dialogue: 0,0:16:14.42,0:16:16.23,Default,,0,0,0,,Зуккюнбаккюн
Dialogue: 0,0:16:19.14,0:16:19.65,Default,,0,0,0,,Рика
Dialogue: 0,0:16:21.31,0:16:23.70,Default,,0,0,0,,Сонда да мен қарсымын.
Dialogue: 0,0:16:23.98,0:16:25.77,Default,,0,0,0,,Рұқсатсыз батырдай қарады
Dialogue: 0,0:16:25.77,0:16:28.74,Default,,0,0,0,,Тіпті біз оны ұнататындықтан жасамаймыз.
Dialogue: 0,0:16:28.74,0:16:31.70,Default,,0,0,0,,Мен қарсы шараларды ойладым, солай ма?
Dialogue: 0,0:16:31.70,0:16:33.71,Default,,0,0,0,,Ой, қарағым, мен жаңа ғана келдім.
Dialogue: 0,0:16:34.82,0:16:36.24,Default,,0,0,0,,Майдо
Dialogue: 0,0:16:36.92,0:16:40.33,Default,,0,0,0,,Ішінде сізді қолдайтын бір нәрсе бар.
Dialogue: 0,0:16:40.81,0:16:44.59,Default,,0,0,0,,Бұл негізінен көмекші элемент. Оны
Dialogue: 0,0:16:45.62,0:16:47.61,Default,,0,0,0,,-да қалай қолдануға болады
Dialogue: 0,0:16:47.78,0:16:50.44,Default,,0,0,0,,Біріншіден, бұл дүниеде люк
Dialogue: 0,0:16:50.44,0:16:51.21,Default,,0,0,0,,штрихтау?
Dialogue: 0,0:16:52.04,0:16:53.28,Default,,0,0,0,,Сіз бұл жерде жасай алмайсыз.
Dialogue: 0,0:16:53.28,0:16:56.19,Default,,0,0,0,,Үйге келгенде жалғыз қалғанда киюім керек.
Dialogue: 0,0:16:56.65,0:16:57.65,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:16:58.13,0:16:59.89,Default,,0,0,0,,Маған басып шығару керек
Dialogue: 0,0:17:00.11,0:17:03.15,Default,,0,0,0,,Бірінші көз алмасатын адамды ата-анаңыз деп біліңіз
Dialogue: 0,0:17:03.61,0:17:06.26,Default,,0,0,0,,«Вени» деп айт, жұмыртқа шығады.
Dialogue: 0,0:17:06.26,0:17:08.03,Default,,0,0,0,,Қайтару кезінде «nebi» пайдаланыңыз
Dialogue: 0,0:17:09.51,0:17:10.27,Default,,0,0,0,,Вени
Dialogue: 0,0:17:19.25,0:17:20.04,Default,,0,0,0,,Жылан
Dialogue: 0,0:17:21.78,0:17:23.01,Default,,0,0,0,,О, сигналы келіп жатыр, келіп жатыр
Dialogue: 0,0:17:28.00,0:17:29.70,Default,,0,0,0,,Реакция қиындық туғызады
Dialogue: 0,0:17:30.79,0:17:31.41,Default,,0,0,0,,Вени
Dialogue: 0,0:17:40.23,0:17:41.31,Default,,0,0,0,,Сіз оны жедіңіз бе?
Dialogue: 0,0:17:41.31,0:17:43.67,Default,,0,0,0,,Олар антистарды жақсы көреді.
Dialogue: 0,0:17:43.67,0:17:46.98,Default,,0,0,0,,Қызғаныш пен өшпенділік олардың азығы.
Dialogue: 0,0:17:48.73,0:17:50.11,Default,,0,0,0,,Өтінемін.
Dialogue: 0,0:17:52.67,0:17:55.40,Default,,0,0,0,,Соңында Момо Саваки
Dialogue: 0,0:17:56.37,0:17:58.25,Default,,0,0,0,,Ұзын бойлы сымбатты қыз
Dialogue: 0,0:17:59.05,0:18:00.86,Default,,0,0,0,,Бұл бір күн ғана
Dialogue: 0,0:18:01.04,0:18:02.73,Default,,0,0,0,,Мен саған ғашық болдым
Dialogue: 0,0:18:03.62,0:18:06.24,Default,,0,0,0,,Мен сені кездестіргеніме өте қуаныштымын
Dialogue: 0,0:18:07.04,0:18:08.95,Default,,0,0,0,,Ер адаммен қателесу
Dialogue: 0,0:18:08.95,0:18:11.55,Default,,0,0,0,,Қыздар жиі шағымданады дейді.
Dialogue: 0,0:18:12.45,0:18:15.01,Default,,0,0,0,,Уайымдама, мен сені қорғаймын.
Dialogue: 0,0:18:15.01,0:18:19.60,Default,,0,0,0,,Жарайды, айтқанын орындайтын келбетті жігіт екен.
Dialogue: 0,0:18:23.76,0:18:25.31,Default,,0,0,0,,Кешегі күн, кел
Dialogue: 0,0:18:26.35,0:18:30.11,Default,,0,0,0,,Ол осы төртеуінің ішіндегі ең лайықтысы болуы мүмкін.
Dialogue: 0,0:18:30.56,0:18:31.45,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:18:32.11,0:18:33.25,Default,,0,0,0,,Менің жоғалып кеткім келмейді
Dialogue: 0,0:18:33.78,0:18:36.18,Default,,0,0,0,,Мен сенімен мәңгі бірге болғым келеді
Dialogue: 0,0:18:39.48,0:18:42.26,Default,,0,0,0,,Бұл өте көп, Харука.
Dialogue: 0,0:18:43.32,0:18:45.97,Default,,0,0,0,,Мен сені өзіңдей жақсы көремін
Dialogue: 0,0:18:47.33,0:18:50.72,Default,,0,0,0,,Момоның құтқарғысы келетін баласы - Харука.
Dialogue: 0,0:18:56.12,0:18:58.89,Default,,0,0,0,,Бұл жігіттің де жағдайы өте күрделі.
Dialogue: 0,0:19:00.52,0:19:03.77,Default,,0,0,0,,Харука мені қыз ретінде көрді.
Dialogue: 0,0:19:03.96,0:19:05.19,Default,,0,0,0,,түртіңіз
Dialogue: 0,0:19:06.46,0:19:08.15,Default,,0,0,0,,Өз-өзіне қол жұмсаған дос?
Dialogue: 0,0:19:08.52,0:19:09.18,Default,,0,0,0,,Иә
Dialogue: 0,0:19:10.97,0:19:12.41,Default,,0,0,0,,Бірақ емханада
Dialogue: 0,0:19:12.58,0:19:14.32,Default,,0,0,0,,Кенеттен киімдеріңізді шешіңіз
Dialogue: 0,0:19:14.32,0:19:15.89,Default,,0,0,0,,Маған жақындады.
Dialogue: 0,0:19:17.32,0:19:20.10,Default,,0,0,0,,Мен қорқып, итеріп жібердім
Dialogue: 0,0:19:21.44,0:19:23.11,Default,,0,0,0,,(Кёко Хори) Иә, әлі де өзімді жақсы сезінбеймін.
Dialogue: 0,0:19:23.65,0:19:24.42,Default,,0,0,0,,Сәлем
Dialogue: 0,0:19:24.42,0:19:27.54,Default,,0,0,0,,Әй, сен Саваки-сенсэйсің бе?
Dialogue: 0,0:19:29.32,0:19:31.52,Default,,0,0,0,,Бұл Момо Саваки, менің жиенім.
Dialogue: 0,0:19:31.70,0:19:33.75,Default,,0,0,0,,Қандай әдемі жас ханым.
Dialogue: 0,0:19:34.39,0:19:38.65,Default,,0,0,0,,Ал менің туысым Шуичиро Саваки Айдың сабақ беретін мұғалімі.
Dialogue: 0,0:19:39.71,0:19:41.81,Default,,0,0,0,,Кешеннің қажеті жоқ.
Dialogue: 0,0:19:42.21,0:19:44.62,Default,,0,0,0,,Сенің көздерің өте тартымды болғандықтан.
Dialogue: 0,0:19:44.88,0:19:45.76,Default,,0,0,0,,Иә
Dialogue: 0,0:19:45.76,0:19:48.22,Default,,0,0,0,,Менің көзімнен ол қандай көрінеді?
Dialogue: 0,0:19:49.22,0:19:52.10,Default,,0,0,0,,Ол аяқталғаннан кейін өзіңізді сенімді сезінгеніңізді қалаймын.
Dialogue: 0,0:19:52.73,0:19:55.99,Default,,0,0,0,,Мұғалім келесі көрмені ойлап отырған сияқты.
Dialogue: 0,0:19:55.99,0:19:59.94,Default,,0,0,0,,Мен сыйлық алып, кәсіби суретші ретінде күн көргім келеді.
Dialogue: 0,0:20:00.45,0:20:01.69,Default,,0,0,0,,Менің суретім?
Dialogue: 0,0:20:01.83,0:20:02.98,Default,,0,0,0,,Өзіңізге сенімдісіз бе?
Dialogue: 0,0:20:03.87,0:20:05.90,Default,,0,0,0,,Олай болмаса, бас тартқан дұрыс емес пе?
Dialogue: 0,0:20:06.40,0:20:08.73,Default,,0,0,0,,Мұғалімнің өмірі соған байланысты.
Dialogue: 0,0:20:09.83,0:20:10.70,Default,,0,0,0,,Мен...
Dialogue: 0,0:20:11.08,0:20:13.04,Default,,0,0,0,,Бұл Шуичиро Саваки
Dialogue: 0,0:20:13.04,0:20:15.02,Default,,0,0,0,,Айдың жүрегін алаңдату
Dialogue: 0,0:20:15.25,0:20:17.95,Default,,0,0,0,,Който Нагасемен қарым-қатынас
Dialogue: 0,0:20:19.41,0:20:22.01,Default,,0,0,0,,Анамен қарым-қатынас
Dialogue: 0,0:20:23.67,0:20:25.22,Default,,0,0,0,,Тыныштанып тыңдаңыз.
Dialogue: 0,0:20:27.31,0:20:31.10,Default,,0,0,0,,Аналар, мен сіздермен танысуды ойлап жүрмін.
Dialogue: 0,0:20:34.22,0:20:39.13,Default,,0,0,0,,Әңгіме Който-чанның өз-өзіне қол жұмсауына ағаңыздың қатысы болуы мүмкін.
Dialogue: 0,0:20:39.13,0:20:40.86,Default,,0,0,0,,Сондықтан бұл мүмкін емес
Dialogue: 0,0:20:42.82,0:20:46.23,Default,,0,0,0,,Сайып келгенде, біз Койтоны тірілтпейінше шындықты білмейміз.
Dialogue: 0,0:20:46.23,0:20:47.46,Default,,0,0,0,,Савапи қош бол Ақырында, біз Койтоны өмірге қайтармайынша білмейміз.
Dialogue: 0,0:20:47.46,0:20:47.96,Default,,0,0,0,,Савапи сау бол
Dialogue: 0,0:20:48.40,0:20:49.37,Default,,0,0,0,,Мен күте тұр дедім ғой, иә?
Dialogue: 0,0:20:50.69,0:20:53.59,Default,,0,0,0,,Оқиғаны күрделендіретін элемент бар сияқты.
Dialogue: 0,0:20:53.84,0:20:54.48,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:20:55.12,0:20:56.73,Default,,0,0,0,,Ай да мұғалімді жақсы көреді
Dialogue: 0,0:20:58.55,0:21:02.65,Default,,0,0,0,,Егер шындықты табу оңай болса, ешкімге қиналмас еді.
Dialogue: 0,0:21:03.23,0:21:04.12,Default,,0,0,0,,Адамның жүрегін түсіну қиын.
Dialogue: 0,0:21:04.12,0:21:05.04,Default,,0,0,0,,Не болды? Адамның санасын түсіну қиын.
Dialogue: 0,0:21:05.04,0:21:05.64,Default,,0,0,0,,Адамның жүрегін түсіну қиын.
Dialogue: 0,0:21:06.30,0:21:10.51,Default,,0,0,0,,Ай шындықты іздеуге бел буған сияқты.
Dialogue: 0,0:21:10.81,0:21:12.95,Default,,0,0,0,,Келесі нені көруге болады?
Dialogue: 0,0:21:13.90,0:21:14.87,Default,,0,0,0,,Мен
Dialogue: 0,0:21:21.57,0:21:22.86,Default,,0,0,0,,Мен...
Dialogue: 0,0:21:27.03,0:21:28.56,Default,,0,0,0,,Мен мектепке барамын
Dialogue: 0,0:21:36.91,0:21:40.70,Default,,0,0,0,,Ал, жұмыртқаны осылай пайдаланасың.
Dialogue: 0,0:21:40.70,0:21:43.13,Default,,0,0,0,,Иә? Сіз оған аса құштар емес сияқтысыз.
Dialogue: 0,0:21:44.19,0:21:46.40,Default,,0,0,0,,Олар бізге сенбейтін сияқты.
Dialogue: 0,0:21:46.40,0:21:50.40,Default,,0,0,0,,Ей, сіз оны өте жақсы түсіндіріп бердіңіз.
Dialogue: 0,0:21:50.56,0:21:52.31,Default,,0,0,0,,Хидена
Dialogue: 0,0:21:52.72,0:21:54.22,Default,,0,0,0,,Осы балаларды қорғаңыз
Dialogue: 0,0:21:54.22,0:21:55.68,Default,,0,0,0,,Құбыжықтардан.
Dialogue: 0,0:21:56.85,0:21:59.57,Default,,0,0,0,,Бұл тек әйелдерге арналған көлік.
Dialogue: 0,0:22:00.04,0:22:02.05,Default,,0,0,0,,Мен де қызбын
Dialogue: 0,0:22:02.86,0:22:04.14,Default,,0,0,0,,Бір күн бұрын келіңіз
Dialogue: 0,0:22:06.55,0:22:09.01,Default,,0,0,0,,Мен шаршадым
Dialogue: 0,0:22:09.82,0:22:11.54,Default,,0,0,0,,Менің құтқарылғым келеді
Dialogue: 0,0:22:17.83,0:22:20.97,Default,,0,0,0,,Анаңды қорғамасаң
Dialogue: 0,0:22:21.50,0:22:24.47,Default,,0,0,0,,Жарайды, келесіде біз туралы сөйлесейік.
Dialogue: 0,0:22:24.80,0:22:27.03,Default,,0,0,0,,Біздің бағалар қымбат екенін естідім.
Dialogue: 0,0:22:27.59,0:22:30.03,Default,,0,0,0,,Бірақ бүгін бәрі бітті.
Dialogue: 0,0:22:30.54,0:22:33.72,Default,,0,0,0,,Ертегіні қайта тыңдағыңыз келсе, ойнаңыз
Dialogue: 0,0:22:33.98,0:22:35.34,Default,,0,0,0,,Мен күтемін.
Dialogue: 0,0:22:36.13,0:22:37.65,Default,,0,0,0,,Мен мәңгілікке барамын
Dialogue: 0,0:22:39.53,0:22:43.72,Default,,0,0,0,,Жүрегіңе
Dialogue: 0,0:22:49.92,0:22:52.26,Default,,0,0,0,,Әй, сен неге өзіңді одан сайын қорғамайсың?
Dialogue: 0,0:22:52.26,0:22:53.92,Default,,0,0,0,,Който-чан қайта тіріле ме?
Dialogue: 0,0:22:55.29,0:22:56.54,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:22:58.04,0:23:03.04,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
