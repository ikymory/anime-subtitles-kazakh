Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:22.59,0:01:25.18,Default,,0,0,0,,Бұл дәптерге аты-жөні жазылған адам
Dialogue: 0,0:01:25.88,0:01:26.62,Default,,0,0,0,,Өл!?
Dialogue: 0,0:01:28.78,0:01:30.42,Default,,0,0,0,,Өтінемін... тоқтатыңыз.
Dialogue: 0,0:01:30.42,0:01:31.22,Default,,0,0,0,,Енді...не болады?Өтінемін... тоқтат
Dialogue: 0,0:01:31.22,0:01:32.37,Default,,0,0,0,,Енді... не болады?
Dialogue: 0,0:01:35.49,0:01:37.78,Default,,0,0,0,,Өлім жазбасы...шынайы!!
Dialogue: 0,0:01:43.61,0:01:45.47,Default,,0,0,0,,Өлім жазбасын пайдаланған адам
Dialogue: 0,0:01:46.16,0:01:48.90,Default,,0,0,0,,Мен жәннатқа да, тозаққа да бара алмаймын деп ойлаймын.
Dialogue: 0,0:01:49.92,0:01:51.10,Default,,0,0,0,,Білсін әлем
Dialogue: 0,0:01:51.69,0:01:52.71,Default,,0,0,0,,Менің бар болуым
Dialogue: 0,0:01:53.52,0:01:56.01,Default,,0,0,0,,Әділ үкім шығаратын біреу бар!
Dialogue: 0,0:01:56.95,0:01:57.93,Default,,0,0,0,,Мен де
Dialogue: 0,0:01:59.37,0:02:01.03,Default,,0,0,0,,Жаңа әлемнің құдайы бол!
Dialogue: 0,0:02:04.84,0:02:08.20,Default,,0,0,0,,Сол кезде ол қанағаттанған еді
Dialogue: 0,0:02:08.20,0:02:09.19,Default,,0,0,0,,Мен не ойлағанымды білмеймін, сондықтан мен бас тарттым. Сол кезде ол қанағаттанған
Dialogue: 0,0:02:09.19,0:02:11.09,Default,,0,0,0,,Мен не ойлағанымды білмеймін, сондықтан мен бас тарттым.
Dialogue: 0,0:02:11.12,0:02:12.05,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:02:12.44,0:02:14.42,Default,,0,0,0,,Бұдан кейін қартпен не болды?
Dialogue: 0,0:02:14.56,0:02:15.71,Default,,0,0,0,,Сонымен...Ягами-кун Жасырын түрде... Ягами-кун
Dialogue: 0,0:02:15.71,0:02:16.21,Default,,0,0,0,,Құпия
Dialogue: 0,0:02:16.40,0:02:18.38,Default,,0,0,0,,Ағымдағы сөйлемді жапон тіліне аударыңыз.
Dialogue: 0,0:02:18.86,0:02:19.36,Default,,0,0,0,,Иә
Dialogue: 0,0:02:22.75,0:02:25.17,Default,,0,0,0,,Ол ақырында арманын жүзеге асырды.
Dialogue: 0,0:02:25.75,0:02:27.58,Default,,0,0,0,,Сол арманның толық орындалуы
Dialogue: 0,0:02:28.04,0:02:30.44,Default,,0,0,0,,Мен одан келетін бақытты қуанышқа шомылдым.
Dialogue: 0,0:02:31.50,0:02:32.59,Default,,0,0,0,,Жақсы
Dialogue: 0,0:02:32.97,0:02:34.30,Default,,0,0,0,,Ягами-кун күткендей
Dialogue: 0,0:02:35.03,0:02:36.54,Default,,0,0,0,,Бұл тамаша жауап.
Dialogue: 0,0:02:40.09,0:02:42.79,Default,,0,0,0,,Міне, бүгінгі күннің бәрі осы.
Dialogue: 0,0:02:49.21,0:02:50.41,Default,,0,0,0,,Ақырында аяқталды ма?
Dialogue: 0,0:02:50.89,0:02:53.09,Default,,0,0,0,,Мектеп те қызықсыз.
Dialogue: 0,0:02:54.16,0:02:54.84,Default,,0,0,0,,Ой Цуки
Dialogue: 0,0:02:55.70,0:02:57.43,Default,,0,0,0,,Ай, тыңдап тұрсың ба?
Dialogue: 0,0:02:57.87,0:02:58.87,Default,,0,0,0,,Менімен сөйлеспе
Dialogue: 0,0:02:59.49,0:03:02.69,Default,,0,0,0,,Менің дауысым, Рюктің дауысынан айырмашылығы, басқаларға естиді.
Dialogue: 0,0:03:03.05,0:03:04.70,Default,,0,0,0,,Хмм, бұл қызықсыз.
Dialogue: 0,0:03:05.22,0:03:06.07,Default,,0,0,0,,Ой Цуки
Dialogue: 0,0:03:06.32,0:03:07.43,Default,,0,0,0,,Бұдан былай біз
Dialogue: 0,0:03:07.43,0:03:07.93,Default,,0,0,0,,Бізде қазір нашар жұмыс бар.
Dialogue: 0,0:03:07.69,0:03:08.96,Default,,0,0,0,,Менің бір ісім бар.
Dialogue: 0,0:03:10.58,0:03:12.05,Default,,0,0,0,,Менің ойымша, мұның еш пайдасы жоқ.
Dialogue: 0,0:03:12.55,0:03:15.19,Default,,0,0,0,,Әдеттегідей тіке үйге бармайсың ба?
Dialogue: 0,0:03:15.88,0:03:18.19,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Менің бір ісім бар.
Dialogue: 0,0:03:18.85,0:03:21.61,Default,,0,0,0,,Иә, менде өте маңызды нәрсе бар.
Dialogue: 0,0:03:23.32,0:03:27.04,Default,,0,0,0,,Күдікті Ямада кеше Синджуку округінің Кабукичо қаласындағы мейрамханада болған.
Dialogue: 0,0:03:27.32,0:03:30.02,Default,,0,0,0,,Мен дүкенде болған жүзінің ұзындығы шамамен 12 см болатын пышақты қолдандым.
Dialogue: 0,0:03:30.49,0:03:33.51,Default,,0,0,0,,Кіші қызметкердің ішінің төменгі бөлігіне пышақ салды деген күдік бар
Dialogue: 0,0:03:34.06,0:03:34.56,Default,,0,0,0,,Күдікті Ямада
Dialogue: 0,0:03:34.24,0:03:34.79,Default,,0,0,0,,Эй, күдікті Ямада.
Dialogue: 0,0:03:34.79,0:03:36.17,Default,,0,0,0,,Күдікті Ямада
Dialogue: 0,0:03:36.17,0:03:36.67,Default,,0,0,0,,Эй Цуки, күдікті Ямада
Dialogue: 0,0:03:36.51,0:03:37.05,Default,,0,0,0,,Ой Цуки
Dialogue: 0,0:03:37.69,0:03:38.27,Default,,0,0,0,,Не?
Dialogue: 0,0:03:39.53,0:03:41.35,Default,,0,0,0,,Сіз шынымен қатты жұмыс істеп жатырсыз.
Dialogue: 0,0:03:41.89,0:03:43.67,Default,,0,0,0,,Мен уақытты босқа өткізе алмаймын.
Dialogue: 0,0:03:44.64,0:03:47.34,Default,,0,0,0,,​​Жазу кітапшасына атыңызды жаза алатын уақыт шектеулі.
Dialogue: 0,0:03:48.11,0:03:50.64,Default,,0,0,0,,Мектептен үйге келгеннен бастап, ұйықтауға дейін.
Dialogue: 0,0:03:51.19,0:03:54.13,Default,,0,0,0,,Бағаларыңыздың жоғарғы жағында қалу және жоғарыда қалу маңызды.
Dialogue: 0,0:03:54.77,0:03:56.48,Default,,0,0,0,,Сабақ кезінде тіпті ұйықтай алмаймын.
Dialogue: 0,0:03:57.12,0:03:59.71,Default,,0,0,0,,Үйде және қысқы мектепте көп оқу керек.
Dialogue: 0,0:04:00.51,0:04:02.27,Default,,0,0,0,,Ал ұйқының болмауы да жау.
Dialogue: 0,0:04:02.73,0:04:04.33,Default,,0,0,0,,Денсаулық пен ойлау қабілетін нашарлатады
Dialogue: 0,0:04:05.13,0:04:08.80,Default,,0,0,0,,Өйткені, әлемді зұлымдықсыз идеалды әлемге өзгертіңіз.
Dialogue: 0,0:04:09.20,0:04:11.00,Default,,0,0,0,,Қанша уақыт болса да, ол жеткіліксіз
Dialogue: 0,0:04:13.37,0:04:16.87,Default,,0,0,0,,Әй, аға, есікті неге құлыптап жатырсыз?
Dialogue: 0,0:04:17.45,0:04:18.19,Default,,0,0,0,,Шохиро?
Dialogue: 0,0:04:18.88,0:04:19.38,Default,,0,0,0,,Не?
Dialogue: 0,0:04:19.77,0:04:21.23,Default,,0,0,0,,Маған үй тапсырмасын айт
Dialogue: 0,0:04:22.15,0:04:23.69,Default,,0,0,0,,А...жарайды
Dialogue: 0,0:04:26.99,0:04:29.50,Default,,0,0,0,,Бұл математикадағы квадраттық функция.
Dialogue: 0,0:04:30.07,0:04:32.21,Default,,0,0,0,,Кешіріңіз, мен оқып жатырмын.
Dialogue: 0,0:04:32.55,0:04:35.35,Default,,0,0,0,,Бірақ бұл жай ғана бос сөз.
Dialogue: 0,0:04:35.52,0:04:36.79,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:04:36.95,0:04:37.71,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:04:38.11,0:04:39.69,Default,,0,0,0,,Сақ бол, Ай
Dialogue: 0,0:04:40.59,0:04:43.67,Default,,0,0,0,,Тартпадағы дәптерді жаңа ғана түрткен адамға,
Dialogue: 0,0:04:44.06,0:04:45.70,Default,,0,0,0,,Сіз мені көре аласыз
Dialogue: 0,0:04:47.11,0:04:49.36,Default,,0,0,0,,Қазір осындай маңызды нәрселер туралы ойланатын кез келді.
Dialogue: 0,0:04:49.89,0:04:51.26,Default,,0,0,0,,Бұл өлім құдайы
Dialogue: 0,0:04:51.76,0:04:53.45,Default,,0,0,0,,Не болды, ағайын?
Dialogue: 0,0:04:53.78,0:04:54.59,Default,,0,0,0,,Жоқ
Dialogue: 0,0:04:55.12,0:04:57.89,Default,,0,0,0,,Сонымен?Нені түсінбейсің?
Dialogue: 0,0:04:58.48,0:05:01.34,Default,,0,0,0,,Ал... бәрі, менің ойымша.
Dialogue: 0,0:05:01.70,0:05:02.63,Default,,0,0,0,,ICPO (=Халықаралық қылмыстық полиция ұйымының конференциясы)
Dialogue: 0,0:05:02.63,0:05:05.69,Default,,0,0,0,,Өткен аптада ICPO-да (Интерполдың халықаралық полиция ұйымы) 52 адам анықталды.
Dialogue: 0,0:05:05.69,0:05:06.19,Default,,0,0,0,,Өткен аптада мен 52 адаммен таныстым.
Dialogue: 0,0:05:06.35,0:05:08.41,Default,,0,0,0,,Мұның бәрі жүрек соғысы.
Dialogue: 0,0:05:08.66,0:05:13.64,Default,,0,0,0,,Бұлардың барлығы іздеуде жүрген немесе түрмеде отырған қылмыскерлер.
Dialogue: 0,0:05:14.10,0:05:17.64,Default,,0,0,0,,Өлгені расталмаған қылмыскерлер болуы мүмкін.
Dialogue: 0,0:05:17.96,0:05:20.43,Default,,0,0,0,,Егер солай болса, 100-ден астам адам бар шығар?
Dialogue: 0,0:05:24.77,0:05:26.72,Default,,0,0,0,,Бұл қазірдің өзінде басталды, директор.
Dialogue: 0,0:05:27.25,0:05:29.95,Default,,0,0,0,,Аға, мен штабтан ештеңе естіген жоқпын.
Dialogue: 0,0:05:30.43,0:05:34.62,Default,,0,0,0,,Алайда олардың барлығы өлім жазасына лайық қылмыскерлер.
Dialogue: 0,0:05:34.72,0:05:36.33,Default,,0,0,0,,Бұл шынымен де маңызды емес.
Dialogue: 0,0:05:36.50,0:05:41.27,Default,,0,0,0,,Ақымақ!Үлкен қылмыскер немесе өлім жазасына кесілген адам болсын, біреуді өлтіру - кісі өлтіру.
Dialogue: 0,0:05:41.69,0:05:44.03,Default,,0,0,0,,Бұл кісі өлтіру деп шешілген жоқ деп ойлаймын.
Dialogue: 0,0:05:44.51,0:05:47.41,Default,,0,0,0,,100-ден астам адамның инфаркт болғаны кездейсоқтық па?
Dialogue: 0,0:05:47.85,0:05:49.16,Default,,0,0,0,,Бұл сөзсіз кісі өлтіру!
Dialogue: 0,0:05:49.57,0:05:54.00,Default,,0,0,0,,Осындай кең аумақта бір мезгілде кісі өлтіру мүмкін бе?
Dialogue: 0,0:05:54.29,0:05:58.38,Default,,0,0,0,,Бұл үлкен ұйымның мұқият жоспарлаған кісі өлтіруі деп есептейміз.
Dialogue: 0,0:05:58.77,0:06:00.81,Default,,0,0,0,,Мұндай үлкен ұйым туралы не деуге болады?
Dialogue: 0,0:06:01.01,0:06:04.21,Default,,0,0,0,,Мен тек ФБР немесе ЦРУ қатысы бар деп болжаймын.
Dialogue: 0,0:06:04.67,0:06:06.12,Default,,0,0,0,,Тағы да айт!
Dialogue: 0,0:06:06.36,0:06:08.81,Default,,0,0,0,,Ал, әзілдесуден аулақ болыңыз.
Dialogue: 0,0:06:09.38,0:06:13.22,Default,,0,0,0,,Ең алдымен, бұл кісі өлтіру ме, әлде кездейсоқтық па, соны анықтауымыз керек.
Dialogue: 0,0:06:13.47,0:06:18.18,Default,,0,0,0,,Бірақ аутопсия қорытындысына сәйкес, барлығында түсініксіз жүрек соғысы болды, солай емес пе?
Dialogue: 0,0:06:18.50,0:06:22.83,Default,,0,0,0,,Жүрек соғысын өлім себебі ретінде ескермесеңіз, ештеңе шықпайды.
Dialogue: 0,0:06:23.04,0:06:26.78,Default,,0,0,0,,Мүлдем емес. Ішіне пышақ қадалып қалса, мен оны жууға болатынмын.
Dialogue: 0,0:06:27.91,0:06:31.21,Default,,0,0,0,,Егер бұл орын алса, мәселені қайтадан шешу үшін "L" әрпінен сұраудан басқа амалым қалмайды.
Dialogue: 0,0:06:38.57,0:06:40.88,Default,,0,0,0,,Директор...Бұл не? "L"
Dialogue: 0,0:06:41.21,0:06:44.15,Default,,0,0,0,,А... бұл кездесуге бірінші рет қатысып отырсыз.
Dialogue: 0,0:06:44.83,0:06:49.02,Default,,0,0,0,,«L» оның атын, қайда екенін, тіпті бетін ешкім білмейтінін білдіреді.
Dialogue: 0,0:06:49.79,0:06:53.44,Default,,0,0,0,,Дегенмен, іс қанша қиын болса да, әрқашан шешіледі.
Dialogue: 0,0:06:53.88,0:06:58.78,Default,,0,0,0,,Әлемдегі көптеген лабиринт істерін шешкен осы әлемнің көлеңкесінің шыңы
Dialogue: 0,0:06:58.97,0:07:01.67,Default,,0,0,0,,Соңғы қозыр... міне осы.
Dialogue: 0,0:07:02.83,0:07:03.95,Default,,0,0,0,,Бірақ «L»
Dialogue: 0,0:07:04.21,0:07:08.48,Default,,0,0,0,,Ол өзін қызықтыратын істер бойынша ғана әрекет жасайтын тәкаппар адам дейді.
Dialogue: 0,0:07:08.72,0:07:09.58,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:07:10.00,0:07:12.48,Default,,0,0,0,,Біз тіпті сізбен байланыса алмаймыз.
Dialogue: 0,0:07:13.13,0:07:15.04,Default,,0,0,0,,L қазірдің өзінде қозғалуда
Dialogue: 0,0:07:27.04,0:07:30.55,Default,,0,0,0,,L бұл істі тергеуді бастады.
Dialogue: 0,0:07:31.12,0:07:32.52,Default,,0,0,0,,Wa… “Ватари”
Dialogue: 0,0:07:32.68,0:07:33.89,Default,,0,0,0,,Иә?«Ватари»
Dialogue: 0,0:07:34.47,0:07:37.09,Default,,0,0,0,,Ол Л-мен байланыса алатын жалғыз адам.
Dialogue: 0,0:07:37.72,0:07:40.20,Default,,0,0,0,,Дегенмен, Ватаридің шынайы болмысын ешкім білмейді.
Dialogue: 0,0:07:40.86,0:07:42.19,Default,,0,0,0,,Тыныш болыңыз.
Dialogue: 0,0:07:42.72,0:07:45.07,Default,,0,0,0,,Қазір маған L-ның дауысын естуге рұқсат етіңіз.
Dialogue: 0,0:07:49.40,0:07:51.21,Default,,0,0,0,,Құрметті ICPO
Dialogue: 0,0:07:53.34,0:07:53.98,Default,,0,0,0,,Бұл Л.
Dialogue: 0,0:07:56.00,0:07:58.02,Default,,0,0,0,,Сондай елсіз жерде
Dialogue: 0,0:07:58.22,0:08:01.11,Default,,0,0,0,,Сіз нені жасырып жатырсыз?
Dialogue: 0,0:08:01.71,0:08:05.46,Default,,0,0,0,,Өлім жазбасын ұстаған адамдар Рюкті көре алады, солай ма?
Dialogue: 0,0:08:06.19,0:08:08.97,Default,,0,0,0,,Мен мұндай қауіпті нәрсені алып жүре алмаймын.
Dialogue: 0,0:08:09.91,0:08:12.59,Default,,0,0,0,,Осы уақытқа дейін сіздің дәптеріңізді отбасыңыз көрген болса да,
Dialogue: 0,0:08:13.30,0:08:16.74,Default,,0,0,0,,«Мен детектив болу үшін оқу үшін істердің есебін жүргіздім». Мен [61] жеткілікті деп ойладым.
Dialogue: 0,0:08:17.26,0:08:18.88,Default,,0,0,0,,Мен одан құтыла аламын деп ойладым, бірақ
Dialogue: 0,0:08:19.74,0:08:21.99,Default,,0,0,0,,Мен жіппен жүріп келемін.
Dialogue: 0,0:08:22.79,0:08:25.47,Default,,0,0,0,,Егер мен бірдеңе жамандық жасасам, отбасымды бұзамын.
Dialogue: 0,0:08:26.33,0:08:27.93,Default,,0,0,0,,Мен оны өлтіремін.
Dialogue: 0,0:08:35.67,0:08:38.96,Default,,0,0,0,,Бұл жағдай ауқымы мен қиындығы жағынан бұрын-соңды болмаған оқиға.
Dialogue: 0,0:08:39.71,0:08:44.85,Default,,0,0,0,,Және бұл ешқашан төзуге болмайтын жантүршігерлік кісі өлтіру.
Dialogue: 0,0:08:45.92,0:08:50.14,Default,,0,0,0,,Бұл оқиғаны шешу үшін біз ICPO-дағы барлық адамдар шешеді деп үміттенеміз
Dialogue: 0,0:08:50.66,0:08:53.26,Default,,0,0,0,,Жоқ, әлемдегі барлық мекеме
Dialogue: 0,0:08:53.46,0:08:57.76,Default,,0,0,0,,Осы кездесуде менімен толық ынтымақтасатындығыңызды шешкеніңізді қалаймын.
Dialogue: 0,0:08:58.36,0:09:02.95,Default,,0,0,0,,Біз жапон полициясының ынтымақтастығын қатты сұраймыз.
Dialogue: 0,0:09:04.03,0:09:05.86,Default,,0,0,0,,Неліктен Жапония?
Dialogue: 0,0:09:06.78,0:09:08.88,Default,,0,0,0,,Кінәлілер бірнеше немесе жалғыз болуы мүмкін.
Dialogue: 0,0:09:09.47,0:09:12.02,Default,,0,0,0,,Жапон болуы әбден мүмкін
Dialogue: 0,0:09:13.07,0:09:15.78,Default,,0,0,0,,Жапон болмаса да, ол Жапонияда жасырынып жүр.
Dialogue: 0,0:09:16.49,0:09:17.46,Default,,0,0,0,,Ненің негізінде?
Dialogue: 0,0:09:18.50,0:09:19.81,Default,,0,0,0,,Неліктен Жапония?
Dialogue: 0,0:09:20.61,0:09:24.83,Default,,0,0,0,,Мен мұны сізге жақын арада кінәлімен тікелей бетпе-бет келгенде көрсете аламын деп ойлаймын.
Dialogue: 0,0:09:25.91,0:09:27.39,Default,,0,0,0,,Тікелей қарсыласу?
Dialogue: 0,0:09:27.95,0:09:31.38,Default,,0,0,0,,Қалай болғанда да, мен тергеу штабының Жапонияда орналасқанын қалаймын.
Dialogue: 0,0:09:37.43,0:09:38.96,Default,,0,0,0,,Мұны істеу салыстырмалы түрде оңай болды.
Dialogue: 0,0:09:39.53,0:09:42.24,Default,,0,0,0,,Иә? Бұл дәптерді жасыра алдыңыз дегенді білдіре ме?
Dialogue: 0,0:09:42.79,0:09:45.09,Default,,0,0,0,,О, мына жәшікте.
Dialogue: 0,0:09:46.29,0:09:48.41,Default,,0,0,0,,Бұл оның жасырғанын білдіре ме?
Dialogue: 0,0:09:49.33,0:09:50.79,Default,,0,0,0,,Мен кілтті ашық қалдырдым.
Dialogue: 0,0:09:51.39,0:09:52.22,Default,,0,0,0,,Бұл жақсы
Dialogue: 0,0:09:53.27,0:09:56.36,Default,,0,0,0,,Керісінше, кілтті әдейі көрінетін жерге қойған дұрыс.
Dialogue: 0,0:09:59.38,0:10:01.16,Default,,0,0,0,,Бұл жай күнделік емес пе?
Dialogue: 0,0:10:01.69,0:10:03.27,Default,,0,0,0,,Адамдардың көпшілігі болуы мүмкін
Dialogue: 0,0:10:03.79,0:10:05.74,Default,,0,0,0,,Осы жай күнделікті оқу арқылы
Dialogue: 0,0:10:06.00,0:10:08.08,Default,,0,0,0,,Бұл тартпаның сырына риза
Dialogue: 0,0:10:08.70,0:10:10.84,Default,,0,0,0,,Бірақ нағыз кілт
Dialogue: 0,0:10:11.60,0:10:12.16,Default,,0,0,0,,Мұнда
Dialogue: 0,0:10:12.85,0:10:16.24,Default,,0,0,0,,Егер ол менің үстелімнің айналасында жатса, мен таң қалмас едім.
Dialogue: 0,0:10:16.45,0:10:19.07,Default,,0,0,0,,Бұл жай ғана шарикті қалам, сол қорғасынды пайдаланыңыз.
Dialogue: 0,0:10:19.59,0:10:21.05,Default,,0,0,0,,Бұл кілт пе?
Dialogue: 0,0:10:21.62,0:10:23.53,Default,,0,0,0,,Иә, тартпаның артқы жағында.
Dialogue: 0,0:10:23.93,0:10:26.27,Default,,0,0,0,,Мұқият қарамайынша көрінбейтін кішкентай тесік бар.
Dialogue: 0,0:10:27.15,0:10:28.57,Default,,0,0,0,,Оны сол тесікке салыңыз.
Dialogue: 0,0:10:33.58,0:10:35.72,Default,,0,0,0,,Түсінемін, бұл қос түбі.
Dialogue: 0,0:10:36.40,0:10:39.81,Default,,0,0,0,,Жасанды күнделіктер де бар, сондықтан олар табылмайды.
Dialogue: 0,0:10:40.40,0:10:41.29,Default,,0,0,0,,Бұл бәрі емес
Dialogue: 0,0:10:41.60,0:10:42.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:42.83,0:10:45.03,Default,,0,0,0,,Қос түбі болып шықса да
Dialogue: 0,0:10:45.63,0:10:48.40,Default,,0,0,0,,Мұндай дәптерді қолына алу мүмкін емес.
Dialogue: 0,0:10:50.31,0:10:50.91,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:10:51.60,0:10:54.99,Default,,0,0,0,,Электр тогын өткізбейтін бұл шарикті қаламның өзегі оқшаулағыш қызметін атқарады.
Dialogue: 0,0:10:55.49,0:10:56.86,Default,,0,0,0,,Токты блоктау
Dialogue: 0,0:10:57.69,0:10:59.13,Default,,0,0,0,,Табан жабылған кезде
Dialogue: 0,0:10:59.37,0:11:02.34,Default,,0,0,0,,Бұл резеңке оқшаулағыш ретінде әрекет етеді және ток өтпейді.
Dialogue: 0,0:11:02.75,0:11:06.37,Default,,0,0,0,,Бірақ біреу күштеп түбін алып тастаса
Dialogue: 0,0:11:06.94,0:11:10.58,Default,,0,0,0,,Сол кезде жұқа пластмассаның ішіндегі бензин жанып кетті.
Dialogue: 0,0:11:12.43,0:11:14.14,Default,,0,0,0,,Дәптер жанып кетті
Dialogue: 0,0:11:14.70,0:11:17.82,Default,,0,0,0,,Бұл айғақтарды толығымен жоятын құрылғы.
Dialogue: 0,0:11:20.00,0:11:20.99,Default,,0,0,0,,Оны өртеп жіберген себебім
Dialogue: 0,0:11:21.30,0:11:24.45,Default,,0,0,0,,Ол: «Мен өзімнің шын күнделігімді жасырдым, өйткені оны ешкім көрсін демеймін» дейді.
Dialogue: 0,0:11:24.97,0:11:27.13,Default,,0,0,0,,Мен оны ең гуманистік себеппен түсінемін.
Dialogue: 0,0:11:27.73,0:11:28.93,Default,,0,0,0,,Нысан - жазу кітапшасы.
Dialogue: 0,0:11:30.43,0:11:32.32,Default,,0,0,0,,Адамның қолында Өлім жазбасы болған кезде
Dialogue: 0,0:11:32.71,0:11:36.16,Default,,0,0,0,,Мен ең үлкен мәселе оны жасыратын жер табу деп естідім.
Dialogue: 0,0:11:36.83,0:11:40.85,Default,,0,0,0,,Сіз осы уақытқа дейін жеткен бірінші адам шығарсыз.
Dialogue: 0,0:11:41.56,0:11:44.02,Default,,0,0,0,,Солай болса да, бұл қауіпті айла.
Dialogue: 0,0:11:44.74,0:11:48.33,Default,,0,0,0,,Процедурада сәл қателессеңіз, өзіңізді қатты күйдіріп алуыңыз мүмкін.
Dialogue: 0,0:11:49.00,0:11:51.96,Default,,0,0,0,,Қауіпті ме? Сен тағы біртүрлі нәрсе айтасың, Рюк.
Dialogue: 0,0:11:53.01,0:11:55.33,Default,,0,0,0,,Мен әу бастан тәуекел етіп келемін, солай емес пе?
Dialogue: 0,0:11:56.07,0:11:57.96,Default,,0,0,0,,Өлім жазбасын алған бойда.
Dialogue: 0,0:11:59.12,0:12:02.14,Default,,0,0,0,,Онымен салыстырғанда, мұндай нәрсеге кіру қауіпсіз емес.
Dialogue: 0,0:12:03.04,0:12:05.20,Default,,0,0,0,,Керісінше, бұл мені қауіпсіз етеді.
Dialogue: 0,0:12:06.69,0:12:08.90,Default,,0,0,0,,Үйіңізде кішкентай өрт басталып, өлім жазасына кесіледі.
Dialogue: 0,0:12:09.10,0:12:11.10,Default,,0,0,0,,Қайсысы жақсы?
Dialogue: 0,0:12:30.98,0:12:33.35,Default,,0,0,0,,Кеше түнде Токио Ниши түрмесінде
Dialogue: 0,0:12:33.49,0:12:38.52,Default,,0,0,0,,Тұтқын Наоки Курозукаяма, 32 жаста, қатыгез қарақшы ретінде түрмеге қамалды.
Dialogue: 0,0:12:38.81,0:12:40.83,Default,,0,0,0,,Ол кенет жүрек талмасынан қайтыс болды.
Dialogue: 0,0:12:41.40,0:12:45.29,Default,,0,0,0,,Түрмедегілер жүрек жеткіліксіздігінен тез арада қайтыс болған ерекше жағдайға жауап ретінде,
Dialogue: 0,0:12:45.41,0:12:48.24,Default,,0,0,0,,Бұл таңқаларлық, көптеген жаман адамдар өліп жатыр.
Dialogue: 0,0:12:48.40,0:12:50.70,Default,,0,0,0,,Бұл аздап қорқынышты, бірақ бір жағынан сергітеді.
Dialogue: 0,0:12:50.82,0:12:52.62,Default,,0,0,0,,Бірақ мұндай нәрселер жаман болуы мүмкін емес.
Dialogue: 0,0:12:53.07,0:12:54.92,Default,,0,0,0,,Меніңше... полиция мұны істеп жатыр ма?
Dialogue: 0,0:12:55.20,0:12:57.14,Default,,0,0,0,,Полицияның мұндай күші жоқ.
Dialogue: 0,0:12:57.32,0:12:58.36,Default,,0,0,0,,Сіз білмейсіз бе?
Dialogue: 0,0:12:58.55,0:12:59.74,Default,,0,0,0,,Не?
Dialogue: 0,0:13:00.59,0:13:01.97,Default,,0,0,0,,Бұл Кира Кира
Dialogue: 0,0:13:02.73,0:13:04.65,Default,,0,0,0,,Қызық, енді кім өлтіріледі?
Dialogue: 0,0:13:10.89,0:13:12.20,Default,,0,0,0,,Қараңызшы, Рюк.
Dialogue: 0,0:13:12.59,0:13:13.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:13.80,0:13:15.94,Default,,0,0,0,,Тіпті бізде мұндай басты бет бар.
Dialogue: 0,0:13:17.97,0:13:19.65,Default,,0,0,0,,Құтқарушы Кира аңыз
Dialogue: 0,0:13:20.05,0:13:21.49,Default,,0,0,0,,Керемет емес пе?
Dialogue: 0,0:13:21.80,0:13:22.88,Default,,0,0,0,,Бұл сіз туралы ма?
Dialogue: 0,0:13:23.30,0:13:26.89,Default,,0,0,0,,Әй, бұл кісі өлтіруші дегенді білдіретін «Киллер» сөзінен шыққан сияқты.
Dialogue: 0,0:13:27.39,0:13:28.96,Default,,0,0,0,,Маған бұл аздап ұнамайды.
Dialogue: 0,0:13:29.58,0:13:32.19,Default,,0,0,0,,Мен бүкіл әлем бойынша осы Кира болдым.
Dialogue: 0,0:13:32.97,0:13:36.92,Default,,0,0,0,,Егер сіз жай ғана Кираны іздесеңіз, осыған ұқсас көптеген беттерді табасыз.
Dialogue: 0,0:13:37.83,0:13:39.13,Default,,0,0,0,,Әлі де газеттер мен теледидарда
Dialogue: 0,0:13:39.33,0:13:43.41,Default,,0,0,0,,Көпшілікке жарияланған жалғыз нәрсе – «зорлықшыл қылмыскерлердің оғаш өлімінің сериясы».
Dialogue: 0,0:13:44.12,0:13:47.63,Default,,0,0,0,,Бірақ дүние жүзіндегі адамдар мұны қазірдің өзінде сезінуде.
Dialogue: 0,0:13:47.92,0:13:50.29,Default,,0,0,0,,Әділ судьяның болуы
Dialogue: 0,0:13:51.19,0:13:51.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:52.82,0:13:55.26,Default,,0,0,0,,Адамдар осындай жаратылыстар Рюк.
Dialogue: 0,0:13:55.66,0:13:56.16,Default,,0,0,0,,​​О?
Dialogue: 0,0:13:56.61,0:13:59.09,Default,,0,0,0,,Мысалы, мектеп аудиториясында
Dialogue: 0,0:13:59.29,0:14:03.09,Default,,0,0,0,,``Жаман адамдарды өлтіре аламыз ба?'' Тақырыптың шығуы мүмкін емес.
Dialogue: 0,0:14:03.80,0:14:07.03,Default,,0,0,0,,Бірақ егер бұл орын алса, бәрі жақсы болады.
Dialogue: 0,0:14:07.64,0:14:09.00,Default,,0,0,0,,«Бұл дұрыс емес».
Dialogue: 0,0:14:09.74,0:14:11.03,Default,,0,0,0,,айтарыңызға сенімдімін
Dialogue: 0,0:14:11.61,0:14:14.17,Default,,0,0,0,,Әрине, бұл дұрыс жауап.
Dialogue: 0,0:14:14.53,0:14:19.18,Default,,0,0,0,,Адамдар қоғамдық орындарда сырттай солай болуы керек.
Dialogue: 0,0:14:19.88,0:14:21.28,Default,,0,0,0,,Бірақ шын ниет осы.
Dialogue: 0,0:14:22.08,0:14:26.28,Default,,0,0,0,,Сіз қорқасыз ба? Көпшілік алдында да менің бар екенімді мойындауға тырыспайсың.
Dialogue: 0,0:14:26.74,0:14:29.58,Default,,0,0,0,,Мен оны енді интернетте кім жазғанын білмеймін
Dialogue: 0,0:14:30.03,0:14:31.52,Default,,0,0,0,,«Кира» кең тараған
Dialogue: 0,0:14:32.86,0:14:36.04,Default,,0,0,0,,Оны айтпай-ақ бәрі біледі.
Dialogue: 0,0:14:36.84,0:14:38.92,Default,,0,0,0,,Жаман адамды біреу өшіріп жатыр.
Dialogue: 0,0:14:39.68,0:14:44.65,Default,,0,0,0,,Ал кінәсі жоқ адам жүрегінде: «Кира қолыңнан келгенін істе!» деп айғайлайды.
Dialogue: 0,0:14:45.13,0:14:48.87,Default,,0,0,0,,Кінәлілер өздеріне илаһи азап келеді деп қорқады.
Dialogue: 0,0:14:50.70,0:14:51.63,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:14:52.39,0:14:54.86,Default,,0,0,0,,Істер дәл жоспарланғандай жүріп жатыр.
Dialogue: 0,0:14:57.49,0:14:59.10,Default,,0,0,0,,Эх... бұл шоудың ортасында.
Dialogue: 0,0:14:59.46,0:15:04.53,Default,,0,0,0,,ICPO Интерполының арнайы тікелей трансляциясы бүкіл әлем бойынша бір уақытта өткізіледі.
Dialogue: 0,0:15:04.68,0:15:05.84,Default,,0,0,0,,О?Не?
Dialogue: 0,0:15:06.72,0:15:07.53,Default,,0,0,0,,Интерпол?
Dialogue: 0,0:15:08.47,0:15:09.37,Default,,0,0,0,,бастайық
Dialogue: 0,0:15:11.03,0:15:14.70,Default,,0,0,0,,Мен бүкіл әлемдегі полицияны басқара алатын жалғыз адаммын.
Dialogue: 0,0:15:15.71,0:15:16.69,Default,,0,0,0,,LIND. Л. ТІГІН
Dialogue: 0,0:15:17.80,0:15:19.51,Default,,0,0,0,,Жалпы аты… “L”
Dialogue: 0,0:15:20.33,0:15:22.52,Default,,0,0,0,,Не... бұл не жігіт?
Dialogue: 0,0:15:23.26,0:15:24.64,Default,,0,0,0,,Ол ақырында басталды.
Dialogue: 0,0:15:25.16,0:15:28.08,Default,,0,0,0,,Бірақ сен осы уақытқа дейін бетіңді көрсетпедің.
Dialogue: 0,0:15:28.58,0:15:29.97,Default,,0,0,0,,Неге қазір?
Dialogue: 0,0:15:30.50,0:15:32.32,Default,,0,0,0,,L де байсалды болуы керек.
Dialogue: 0,0:15:33.16,0:15:36.70,Default,,0,0,0,,Келіңіз, L, мен айтқанды істеп жатырмын.
Dialogue: 0,0:15:37.19,0:15:40.12,Default,,0,0,0,,ICPO отырысында айтқанымды дәлелдеуге рұқсат етіңіз.
Dialogue: 0,0:15:41.92,0:15:44.42,Default,,0,0,0,,Қылмыскерлерді бірінен соң бірін нысанаға алған сериялық кісі өлтіру
Dialogue: 0,0:15:45.20,0:15:49.33,Default,,0,0,0,,Бұл тарихтағы ең ауыр қылмыс, оған ешқашан жол беруге болмайды.
Dialogue: 0,0:15:49.92,0:15:51.94,Default,,0,0,0,,Сондықтан бұл қылмысты ұйымдастырушы менмін.
Dialogue: 0,0:15:52.14,0:15:54.94,Default,,0,0,0,,«Кира» деп аталатынды міндетті түрде ұстаңыз.
Dialogue: 0,0:15:55.51,0:15:57.45,Default,,0,0,0,,«Мен сені міндетті түрде ұстаймын»
Dialogue: 0,0:15:58.28,0:15:59.48,Default,,0,0,0,,Хмф, ақымақ.
Dialogue: 0,0:15:59.92,0:16:01.11,Default,,0,0,0,,Менің ұсталуым мүмкін емес.
Dialogue: 0,0:16:01.90,0:16:03.08,Default,,0,0,0,,Бұл Өлім жазбасы!
Dialogue: 0,0:16:03.68,0:16:07.48,Default,,0,0,0,,Осы жазу кітапшасын алмасаңыз, ешқандай дәлел қалмайды.
Dialogue: 0,0:16:07.90,0:16:10.38,Default,,0,0,0,,Оны ұстау мүлдем мүмкін емес...
Dialogue: 0,0:16:12.38,0:16:16.21,Default,,0,0,0,,Полицияның әрекет етуі және осыған ұқсас нәрсенің орын алуы жоспардың бір бөлігі болып табылады.
Dialogue: 0,0:16:17.03,0:16:21.23,Default,,0,0,0,,Кира, сен осындай нәрсені істегенде не ойлайсың?
Dialogue: 0,0:16:21.49,0:16:22.83,Default,,0,0,0,,Мен оны дерлік елестете аламын.
Dialogue: 0,0:16:23.51,0:16:26.84,Default,,0,0,0,,Бірақ сенің істеп жүргенің жаман!
Dialogue: 0,0:16:29.00,0:16:30.91,Default,,0,0,0,,Мен ... зұлыммын.
Dialogue: 0,0:16:33.29,0:16:34.43,Default,,0,0,0,,Мен әділдіктімін!
Dialogue: 0,0:16:35.22,0:16:36.69,Default,,0,0,0,,Жамандықтан қорқатын әлсіздерді сақта
Dialogue: 0,0:16:37.05,0:16:38.92,Default,,0,0,0,,Барлығы армандайтын жаңа әлем
Dialogue: 0,0:16:39.08,0:16:40.24,Default,,0,0,0,,Құдайға айналатын адам!
Dialogue: 0,0:16:40.58,0:16:42.31,Default,,0,0,0,,Және Құдайларына қарсы шыққандар
Dialogue: 0,0:16:42.88,0:16:44.06,Default,,0,0,0,,Бұл жамандық!
Dialogue: 0,0:16:46.40,0:16:48.23,Default,,0,0,0,,Сен тым ақымақсың L
Dialogue: 0,0:16:48.63,0:16:52.71,Default,,0,0,0,,Егер ол аздап ақылдырақ болса, қызықтырақ болар еді.
Dialogue: 0,0:17:07.89,0:17:10.00,Default,,0,0,0,,Маған бағынбасаң не болады?
Dialogue: 0,0:17:11.30,0:17:13.21,Default,,0,0,0,,Бүкіл әлем назар аударуда.
Dialogue: 0,0:17:13.54,0:17:14.05,Default,,0,0,0,,Л
Dialogue: 0,0:17:19.06,0:17:19.96,Default,,0,0,0,,5 секунд қалды
Dialogue: 0,0:17:20.73,0:17:21.25,Default,,0,0,0,,4
Dialogue: 0,0:17:21.84,0:17:22.34,Default,,0,0,0,,3
Dialogue: 0,0:17:22.95,0:17:23.45,Default,,0,0,0,,2
Dialogue: 0,0:17:24.09,0:17:24.70,Default,,0,0,0,,1
Dialogue: 0,0:17:37.31,0:17:39.43,Default,,0,0,0,,Не болып жатыр? Маған қандай да бір жолмен айтыңыз.
Dialogue: 0,0:17:44.67,0:17:46.03,Default,,0,0,0,,Сенгісіз
Dialogue: 0,0:17:46.94,0:17:48.66,Default,,0,0,0,,Мен оны мүмкіндігінше қолданып көрдім.
Dialogue: 0,0:17:48.92,0:17:50.13,Default,,0,0,0,,Мен мұндай нәрсе болады деп күткен жоқпын.
Dialogue: 0,0:17:51.07,0:17:55.40,Default,,0,0,0,,Кира, қолыңды тікелей қолданбай біреуді өлтіре аласың ба?
Dialogue: 0,0:17:56.95,0:17:59.66,Default,,0,0,0,,Мен өз көзіммен көрмейінше сене алмадым.
Dialogue: 0,0:18:00.92,0:18:01.94,Default,,0,0,0,,Мұқият тыңдаңыз Кира
Dialogue: 0,0:18:02.70,0:18:07.52,Default,,0,0,0,,Егер сіз ЛИНДті өлтірсеңіз. Теледидардағы тігінші L.
Dialogue: 0,0:18:08.12,0:18:11.25,Default,,0,0,0,,Бүгін осы сағатта өлім жазасына кесілетін адам осы еді.
Dialogue: 0,0:18:12.16,0:18:13.22,Default,,0,0,0,,Мен емес
Dialogue: 0,0:18:13.66,0:18:14.19,Default,,0,0,0,,Не?
Dialogue: 0,0:18:14.73,0:18:16.78,Default,,0,0,0,,Теледидарда немесе интернетте хабарланбаған
Dialogue: 0,0:18:17.47,0:18:19.90,Default,,0,0,0,,Ол полицияға жасырын түрде ұсталған қылмыскер.
Dialogue: 0,0:18:20.78,0:18:24.94,Default,,0,0,0,,Күтілгендей, сізде бұл қылмыскер туралы ешқандай ақпарат жоқ сияқты.
Dialogue: 0,0:18:27.18,0:18:28.22,Default,,0,0,0,,Мен жеңілдім.
Dialogue: 0,0:18:29.01,0:18:31.82,Default,,0,0,0,,Бірақ мен, Л, бармын.
Dialogue: 0,0:18:32.33,0:18:34.96,Default,,0,0,0,,Жүр, мені өлтіріп көр.
Dialogue: 0,0:18:36.22,0:18:37.88,Default,,0,0,0,,Ко Койтсу
Dialogue: 0,0:18:38.54,0:18:39.22,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:18:39.22,0:18:39.72,Default,,0,0,0,,Бұл не?Не болып жатыр?
Dialogue: 0,0:18:39.33,0:18:39.83,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:18:39.93,0:18:40.43,Default,,0,0,0,,Жылдам көріңіз
Dialogue: 0,0:18:40.18,0:18:40.93,Default,,0,0,0,,Таңғажайып нәрсе болғалы тұр. Тез көріңіз.
Dialogue: 0,0:18:40.93,0:18:41.43,Default,,0,0,0,,Таңғажайып нәрсе болғалы тұр.
Dialogue: 0,0:18:41.37,0:18:42.16,Default,,0,0,0,,Тездетіп, мені өлтір.
Dialogue: 0,0:18:42.16,0:18:43.45,Default,,0,0,0,,​​Сен өлесің бе? Л, тезірек мені өлтір.
Dialogue: 0,0:18:43.45,0:18:43.95,Default,,0,0,0,,Тезірек, мені өлтір.
Dialogue: 0,0:18:43.67,0:18:44.29,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:18:44.62,0:18:45.91,Default,,0,0,0,,Не болды?Сіз жасай алмайсыз ба? Бұл Кира мен Л. Не болды, солай емес пе?
Dialogue: 0,0:18:45.91,0:18:46.41,Default,,0,0,0,,Не болды? Сіз жасай алмайсыз ба?
Dialogue: 0,0:18:46.13,0:18:47.24,Default,,0,0,0,,Бұл тікелей эфир. Мен қазір осындамын.
Dialogue: 0,0:18:47.24,0:18:47.74,Default,,0,0,0,,Бұл тікелей эфир.
Dialogue: 0,0:18:47.63,0:18:48.27,Default,,0,0,0,,Жүр, Кира, мені өлтіруге тырыс.
Dialogue: 0,0:18:48.27,0:18:49.78,Default,,0,0,0,,Е, сен неден қорқасың? Жүр, Кира, мені өлтіруге тырыс.
Dialogue: 0,0:18:49.78,0:18:50.28,Default,,0,0,0,,Жүр, Кира, мені өлтіруге тырыс.
Dialogue: 0,0:18:50.38,0:18:50.88,Default,,0,0,0,,Керемет
Dialogue: 0,0:18:50.66,0:18:51.46,Default,,0,0,0,,Жасай бер Кира
Dialogue: 0,0:18:51.85,0:18:53.43,Default,,0,0,0,,Не болды? Сіз жасай алмайсыз ба?
Dialogue: 0,0:18:58.72,0:19:01.03,Default,,0,0,0,,Мені өлтіру мүмкін емес сияқты.
Dialogue: 0,0:19:03.76,0:19:05.51,Default,,0,0,0,,Кейбір адамдарды өлтіруге болмайды.
Dialogue: 0,0:19:06.74,0:19:08.38,Default,,0,0,0,,Мен жақсы кеңес алдым.
Dialogue: 0,0:19:08.96,0:19:10.26,Default,,0,0,0,,Бір нәрсені қайтару дегенді қалай түсінесіңдер?
Dialogue: 0,0:19:10.93,0:19:12.98,Default,,0,0,0,,Сізге тағы бір жақсы нәрсе айтайын.
Dialogue: 0,0:19:13.89,0:19:17.21,Default,,0,0,0,,Бұл хабар бүкіл әлем бойынша бір уақыттағы хабар ретінде есептелді.
Dialogue: 0,0:19:17.64,0:19:20.42,Default,,0,0,0,,Шын мәнінде, ол Жапонияның Канто аймағында ғана таратылады.
Dialogue: 0,0:19:21.15,0:19:21.65,Default,,0,0,0,,На
Dialogue: 0,0:19:22.05,0:19:25.81,Default,,0,0,0,,Суды әр ауданға әр түрлі уақытта жіберу жоспарланған, бірақ бұл енді қажет емес.
Dialogue: 0,0:19:26.69,0:19:29.37,Default,,0,0,0,,Сіз... қазір Кантодасыз.
Dialogue: 0,0:19:30.95,0:19:32.48,Default,,0,0,0,,Мұны жасама, L жігіті
Dialogue: 0,0:19:33.34,0:19:35.93,Default,,0,0,0,,Бұл полиция назардан тыс қалдырған шағын оқиға болды.
Dialogue: 0,0:19:36.40,0:19:40.22,Default,,0,0,0,,Осы оқиғалар сериясының алғашқы құрбаны Синджукудағы көшедегі бала болды.
Dialogue: 0,0:19:41.17,0:19:43.39,Default,,0,0,0,,Ірі қылмыскерлер жүрек жеткіліксіздігінен өледі
Dialogue: 0,0:19:43.97,0:19:46.10,Default,,0,0,0,,Бұл жынның қылмысы өте жеңіл.
Dialogue: 0,0:19:46.53,0:19:50.46,Default,,0,0,0,,Оның үстіне бұл оқиға Жапонияда ғана хабарланған.
Dialogue: 0,0:19:51.35,0:19:53.51,Default,,0,0,0,,Мұның өзі қорытынды жасауға жеткілікті болды
Dialogue: 0,0:19:54.16,0:19:55.81,Default,,0,0,0,,Сіз Жапониядасыз
Dialogue: 0,0:19:56.31,0:19:58.11,Default,,0,0,0,,Және бұл бірінші құрбан
Dialogue: 0,0:19:58.66,0:20:01.48,Default,,0,0,0,,Мен сенің өлтіргенің үшін теңіз шошқасы болдым.
Dialogue: 0,0:20:04.10,0:20:06.72,Default,,0,0,0,,Ол алғаш рет халық шоғырланған Кантоға жіберілді.
Dialogue: 0,0:20:07.08,0:20:09.32,Default,,0,0,0,,Сенің сонда болғаным үшін бақытым болды.
Dialogue: 0,0:20:10.46,0:20:14.45,Default,,0,0,0,,Шынымды айтсам, мен күткендей мұншалықты алысқа барады деп ойламадым.
Dialogue: 0,0:20:15.10,0:20:19.72,Default,,0,0,0,,Кира, мен сені асуға жібергеніме көп уақыт өтпейді.
Dialogue: 0,0:20:20.07,0:20:22.55,Default,,0,0,0,,күткендей, Л.
Dialogue: 0,0:20:23.12,0:20:26.02,Default,,0,0,0,,Хмм... Кираның бар болуы, өлтіру
Dialogue: 0,0:20:26.42,0:20:28.94,Default,,0,0,0,,Ол тіпті Жапонияда екенін дәлелдеді.
Dialogue: 0,0:20:29.95,0:20:30.56,Default,,0,0,0,,Кира
Dialogue: 0,0:20:31.23,0:20:35.34,Default,,0,0,0,,Мен сенің кісі өлтіруді қалай жасайтыныңа қатты қызығамын.
Dialogue: 0,0:20:36.20,0:20:37.42,Default,,0,0,0,,Бірақ олай емес.
Dialogue: 0,0:20:37.43,0:20:39.94,Default,,0,0,0,,Мен сені ұстаған кезде түсінесің.
Dialogue: 0,0:20:41.13,0:20:43.63,Default,,0,0,0,,Қайта кездескенше Кира
Dialogue: 0,0:20:53.92,0:20:54.66,Default,,0,0,0,,Мен
Dialogue: 0,0:20:56.55,0:20:58.21,Default,,0,0,0,,Оны асуға жібер
Dialogue: 0,0:21:00.18,0:21:01.09,Default,,0,0,0,,Қызықты
Dialogue: 0,0:21:01.94,0:21:03.27,Default,,0,0,0,,Оны қабылдап, орнымыздан тұрайық.
Dialogue: 0,0:21:04.82,0:21:08.96,Default,,0,0,0,,Бір-бірінің жүзін, атын және бәрін білмейтін адамды табу
Dialogue: 0,0:21:09.16,0:21:12.03,Default,,0,0,0,,Ал...табылған адам өледі.
Dialogue: 0,0:21:12.78,0:21:15.62,Default,,0,0,0,,Адамдардың бәрі қызық!
Dialogue: 0,0:21:16.75,0:21:17.32,Default,,0,0,0,,Л
Dialogue: 0,0:21:17.78,0:21:18.31,Default,,0,0,0,,Кира
Dialogue: 0,0:21:19.40,0:21:21.17,Default,,0,0,0,,Мен сені міндетті түрде табамын, мен сені міндетті түрде табамын
Dialogue: 0,0:21:21.59,0:21:22.48,Default,,0,0,0,,Одан құтыл!Одан құтыл!
Dialogue: 0,0:21:22.90,0:21:24.59,Default,,0,0,0,,I
Dialogue: 0,0:21:25.33,0:21:26.06,Default,,0,0,0,,Әділдік!Бұл әділдік!
Dialogue: 0,0:21:27.56,0:21:32.56,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
