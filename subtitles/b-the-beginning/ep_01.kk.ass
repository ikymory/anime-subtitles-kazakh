Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:11.01,Default,,0,0,0,,NETFLIX түпнұсқа сериясы
Dialogue: 0,0:00:14.97,0:00:16.97,Default,,0,0,0,,Ханемохит Цудоэ
Dialogue: 0,0:00:17.05,0:00:18.10,Default,,0,0,0,,Хошино Мацури Китару
Dialogue: 0,0:00:18.18,0:00:19.47,Default,,0,0,0,,Сіз кереметсіз
Dialogue: 0,0:00:19.56,0:00:21.14,Default,,0,0,0,,Келешегі зор жаңадан келген адам
Dialogue: 0,0:00:21.22,0:00:22.06,Default,,0,0,0,,Кит
Dialogue: 0,0:00:22.14,0:00:24.31,Default,,0,0,0,,Сіз мұны түсінбедіңіз бе?
Dialogue: 0,0:00:24.56,0:00:27.98,Default,,0,0,0,,(А әйелдің қатты тыныс алуы)
Dialogue: 0,0:00:34.36,0:00:36.28,Default,,0,0,0,,(Джулианның күлкісі)
Dialogue: 0,0:00:41.70,0:00:43.00,Default,,0,0,0,,(А әйелдің қатты тыныс алуы)
Dialogue: 0,0:00:45.37,0:00:46.79,Default,,0,0,0,,(А әйелдің қатты тыныс алуы)
Dialogue: 0,0:00:51.25,0:00:52.09,Default,,0,0,0,,Олар мені өлтірмекші екені анық
Dialogue: 0,0:00:54.55,0:00:55.43,Default,,0,0,0,,Хмм!
Dialogue: 0,0:00:56.13,0:00:58.72,Default,,0,0,0,,Уау! Гохоу!
Dialogue: 0,0:00:58.85,0:01:01.39,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:01:12.73,0:01:13.65,Default,,0,0,0,,Сіз өлдіңіз бе?
Dialogue: 0,0:01:15.32,0:01:16.24,Default,,0,0,0,,Хмм!
Dialogue: 0,0:01:16.82,0:01:19.03,Default,,0,0,0,,Әлі тірі
Dialogue: 0,0:01:19.37,0:01:21.49,Default,,0,0,0,,Олай болса ертерек бастаңыз~
Dialogue: 0,0:01:22.20,0:01:23.04,Default,,0,0,0,,О
Dialogue: 0,0:01:24.50,0:01:27.12,Default,,0,0,0,,Сонда біз соттаймыз ба?
Dialogue: 0,0:01:28.33,0:01:29.17,Default,,0,0,0,,Хмм!
Dialogue: 0,0:01:29.71,0:01:30.67,Default,,0,0,0,,Хмм!
Dialogue: 0,0:01:31.13,0:01:32.59,Default,,0,0,0,,(Ричард күледі)
Dialogue: 0,0:01:33.51,0:01:34.88,Default,,0,0,0,,(Ричардтың күлкісі)
Dialogue: 0,0:01:39.51,0:01:40.89,Default,,0,0,0,,(ет кесу дыбысы)
Dialogue: 0,0:01:45.23,0:01:46.39,Default,,0,0,0,,Иә!
Dialogue: 0,0:01:47.10,0:01:49.10,Default,,0,0,0,,Генри! Ричард!
Dialogue: 0,0:01:51.52,0:01:52.40,Default,,0,0,0,,Эй!
Dialogue: 0,0:01:52.98,0:01:58.20,Default,,0,0,0,,Хяаааааааааааа!
Dialogue: 0,0:02:00.03,0:02:06.04,Default,,0,0,0,,♪〜
Dialogue: 0,0:02:08.92,0:02:14.92,Default,,0,0,0,,〜♪
Dialogue: 0,0:02:23.01,0:02:26.02,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:02:39.65,0:02:42.41,Default,,0,0,0,,Иә, жаңа піскен анпан
Dialogue: 0,0:02:54.71,0:02:55.88,Default,,0,0,0,,Бұл қауіпті, бұл қауіпті, бұл қауіпті…
Dialogue: 0,0:02:56.59,0:02:57.63,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:02:57.71,0:02:59.63,Default,,0,0,0,,Қайырлы таң, Лили.
Dialogue: 0,0:02:59.72,0:03:00.80,Default,,0,0,0,,Қайырлы таң, Куроба-кун!
Dialogue: 0,0:03:00.88,0:03:01.97,Default,,0,0,0,,Сол нан...
Dialogue: 0,0:03:02.05,0:03:03.64,Default,,0,0,0,,Кешіріңіз, кешігіп қалдым!
Dialogue: 0,0:03:03.76,0:03:05.47,Default,,0,0,0,,Келесі кездескенше!
Dialogue: 0,0:03:07.60,0:03:11.31,Default,,0,0,0,,Бұл жаңа піскен анпан...
Dialogue: 0,0:03:13.94,0:03:14.77,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:20.82,0:03:21.65,Default,,0,0,0,,Қолжазбалар бөлімінің қызметкерлері ғана жеткілікті болар еді, бірақ
Dialogue: 0,0:03:21.74,0:03:23.62,Default,,0,0,0,,Анашым! Мен дәптерімді ұмытып кетіппін!
Dialogue: 0,0:03:23.70,0:03:25.99,Default,,0,0,0,,Не істеп жатырсың, ақымақ?
Dialogue: 0,0:03:31.87,0:03:33.08,Default,,0,0,0,,Мұнда 105
Dialogue: 0,0:03:33.33,0:03:35.67,Default,,0,0,0,,Орман жолынан үйсіз шатыр табылды.
Dialogue: 0,0:03:35.75,0:03:39.17,Default,,0,0,0,,Мұнда 112 Автотұрақта бірнеше қан дақтары табылды
Dialogue: 0,0:03:39.26,0:03:40.09,Default,,0,0,0,,Құрметпен, сот-медициналық топ
Dialogue: 0,0:03:40.63,0:03:41.63,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:03:43.64,0:03:44.59,Default,,0,0,0,,Қайырлы таң!
Dialogue: 0,0:03:44.68,0:03:45.68,Default,,0,0,0,,Тыныш!
Dialogue: 0,0:03:49.85,0:03:51.89,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:03:52.10,0:03:54.19,Default,,0,0,0,,А, кешігіп қалдың~
Dialogue: 0,0:03:54.27,0:03:55.94,Default,,0,0,0,,Жоқ, кешіріңіз.
Dialogue: 0,0:03:56.02,0:03:59.44,Default,,0,0,0,,А, қызыл бұршақ пастасын жегің келе ме? Жаңа пісірілген
Dialogue: 0,0:04:00.03,0:04:03.28,Default,,0,0,0,,Оны сайтта жеуге болады ма? Адал емес
Dialogue: 0,0:04:04.95,0:04:07.24,Default,,0,0,0,,Жәбірленуші шынымен солай ма?
Dialogue: 0,0:04:07.74,0:04:13.92,Default,,0,0,0,,Хм... Біздің юрисдикцияда Марукенге қатысты болып көрінетін бірнеше істер бар.
Dialogue: 0,0:04:14.00,0:04:16.42,Default,,0,0,0,,Сериялық өлтіруші болып табылды...
Dialogue: 0,0:04:18.59,0:04:20.71,Default,,0,0,0,,Мен тұтқындауға ордер алуға әрекеттенген бойда
Dialogue: 0,0:04:20.80,0:04:23.80,Default,,0,0,0,,Түсінбеген жігіт пайда болды!
Dialogue: 0,0:04:25.97,0:04:28.10,Default,,0,0,0,,Өлтіруші...Б
Dialogue: 0,0:04:35.35,0:04:36.60,Default,,0,0,0,,Мм... кешіріңіз, міне...
Dialogue: 0,0:04:36.69,0:04:40.02,Default,,0,0,0,,Жарайды, шулап тұрсың, сол жаққа бар.
Dialogue: 0,0:04:40.11,0:04:40.94,Default,,0,0,0,,Бірақ... иә?
Dialogue: 0,0:04:41.99,0:04:43.99,Default,,0,0,0,,Сәлем! Ол адам кім?
Dialogue: 0,0:04:44.07,0:04:45.66,Default,,0,0,0,,А... жоқ, егер бұл RIS болса...
Dialogue: 0,0:04:45.74,0:04:46.82,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:04:46.91,0:04:48.91,Default,,0,0,0,,Сырттан келген адамды кіргізсек жақсы болмай ма?
Dialogue: 0,0:04:49.78,0:04:50.70,Default,,0,0,0,,Кешіріңіз?
Dialogue: 0,0:04:50.79,0:04:51.74,Default,,0,0,0,,(Балалардың шуы)
Dialogue: 0,0:04:52.70,0:04:57.50,Default,,0,0,0,,Бұл орынға қазір қатысы барлардан басқа кез келген адамға кіруге тыйым салынған.
Dialogue: 0,0:04:58.08,0:04:58.92,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:05:00.34,0:05:03.26,Default,,0,0,0,,Ағай, сіз массыз ба?
Dialogue: 0,0:05:03.38,0:05:05.43,Default,,0,0,0,,Бұл жерде көпшілікке рұқсат етілмейді...
Dialogue: 0,0:05:05.51,0:05:07.34,Default,,0,0,0,,О! Хаха
Dialogue: 0,0:05:08.05,0:05:10.51,Default,,0,0,0,,Жағдайың қалай, Гени?
Dialogue: 0,0:05:10.60,0:05:12.02,Default,,0,0,0,,Біраз уақыт өтті
Dialogue: 0,0:05:12.18,0:05:13.02,Default,,0,0,0,,Geni?
Dialogue: 0,0:05:14.10,0:05:16.98,Default,,0,0,0,,Сізді Эрик пен Жан күтеді.
Dialogue: 0,0:05:17.69,0:05:19.27,Default,,0,0,0,,Тез жүріңіз
Dialogue: 0,0:05:23.11,0:05:23.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:28.74,0:05:29.74,Default,,0,0,0,,«және күн сайын күрсінемін.»
Dialogue: 0,0:05:38.67,0:05:42.96,Default,,0,0,0,,Қазіргі уақытта растауға болатын ақпарат негізінен төмендегідей.
Dialogue: 0,0:05:43.13,0:05:43.96,Default,,0,0,0,,Дегенмен, енді ғана не болды?
Dialogue: 0,0:05:44.09,0:05:48.30,Default,,0,0,0,,Вау, бұл нағыз Кит Флик, Марио.
Dialogue: 0,0:05:52.72,0:05:56.02,Default,,0,0,0,,10 жыл хабарсыз кеткен, ол жай ғана қария емес пе?
Dialogue: 0,0:05:56.81,0:05:58.90,Default,,0,0,0,,Эрик, мен дайынмын.
Dialogue: 0,0:05:58.98,0:05:59.81,Default,,0,0,0,,Жарайды
Dialogue: 0,0:06:01.23,0:06:04.57,Default,,0,0,0,,Тергеу жиналысын бастамас бұрын мен таныстырғым келеді
Dialogue: 0,0:06:04.65,0:06:06.28,Default,,0,0,0,,Барлығыңыз, сағат 2-ге назар аударыңыздар.
Dialogue: 0,0:06:06.57,0:06:07.40,Default,,0,0,0,,О...
Dialogue: 0,0:06:08.91,0:06:11.74,Default,,0,0,0,,Жанның қасында Кит Фрик тұр.
Dialogue: 0,0:06:11.82,0:06:14.54,Default,,0,0,0,,Бүгіннен бастап материалдар бөлімінен оралды.
Dialogue: 0,0:06:14.62,0:06:16.45,Default,,0,0,0,,Барлығыңызға рахмет.
Dialogue: 0,0:06:16.54,0:06:17.75,Default,,0,0,0,,Usu
Dialogue: 0,0:06:18.29,0:06:19.87,Default,,0,0,0,,Ал, Каэла, бастайық.
Dialogue: 0,0:06:22.79,0:06:26.05,Default,,0,0,0,,Бүгін таңертең орманды алқаптан өлтірілген мәйіт табылды.
Dialogue: 0,0:06:26.13,0:06:28.93,Default,,0,0,0,,Құрбандар - Генри Ричардтың ағалары Клаус
Dialogue: 0,0:06:29.55,0:06:31.89,Default,,0,0,0,,Екеуі де өткір пышақпен айуандықпен өлтірілді.
Dialogue: 0,0:06:32.18,0:06:34.01,Default,,0,0,0,,Оқиға орнында ес-түссіз жатқан әйел
Dialogue: 0,0:06:34.10,0:06:36.97,Default,,0,0,0,,Ол ауыр жарақат алса да, оны қорғап, ауруханаға жеткізді.
Dialogue: 0,0:06:37.73,0:06:40.94,Default,,0,0,0,,Оны ағайынды Клаус, оның ішінде үшінші ұлы Джулиан түрмеге қамады.
Dialogue: 0,0:06:41.56,0:06:42.90,Default,,0,0,0,,Шабуыл жасаған...
Dialogue: 0,0:06:42.98,0:06:44.19,Default,,0,0,0,,Басқа психопат?
Dialogue: 0,0:06:44.69,0:06:47.94,Default,,0,0,0,,Айтпақшы, Джулиан Краусс қазір хабарсыз кеткен.
Dialogue: 0,0:06:52.16,0:06:53.16,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:06:54.08,0:06:56.74,Default,,0,0,0,,Сен менің тамағымды кеспей тұрып.
Dialogue: 0,0:06:57.33,0:06:59.54,Default,,0,0,0,,Өлтір, өлтір!
Dialogue: 0,0:07:00.58,0:07:01.54,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:07:03.38,0:07:07.30,Default,,0,0,0,,Өлтір... Өл... Ол жалғыз
Dialogue: 0,0:07:07.38,0:07:09.72,Default,,0,0,0,,Мен сені кездесуге рұқсат етемін.
Dialogue: 0,0:07:10.84,0:07:14.97,Default,,0,0,0,,Маған аз да болса көмектессеңіз.
Dialogue: 0,0:07:16.06,0:07:19.93,Default,,0,0,0,,Сонда бұл қылмыскерді кім өлтірді?
Dialogue: 0,0:07:20.35,0:07:22.65,Default,,0,0,0,,RIS жұмысы үшін осы жерді басыңыз
Dialogue: 0,0:07:23.86,0:07:25.61,Default,,0,0,0,,Әдетте «Киллер В» ретінде белгілі
Dialogue: 0,0:07:25.98,0:07:28.86,Default,,0,0,0,,Ол біз бақылайтын ең маңызды анықтама болып табылады.
Dialogue: 0,0:07:29.90,0:07:33.16,Default,,0,0,0,,Мен оны «түсінбеген шошқа» деп атасам ғой.
Dialogue: 0,0:07:33.24,0:07:34.78,Default,,0,0,0,,Боқ пен шошқаның саны көбейіп барады.
Dialogue: 0,0:07:35.53,0:07:39.91,Default,,0,0,0,,Бірнеше жыл ішінде 15 қылмысқа қатысы бар көрінеді
Dialogue: 0,0:07:40.29,0:07:42.00,Default,,0,0,0,,Марио сұрауының есебі
Dialogue: 0,0:07:44.54,0:07:46.09,Default,,0,0,0,,Бұл алдыңғының қайталануы
Dialogue: 0,0:07:46.17,0:07:49.17,Default,,0,0,0,,Жаңа тұлғалар бар, сондықтан мен басынан бастап түсіндіремін.
Dialogue: 0,0:07:50.51,0:07:55.18,Default,,0,0,0,,Өлтіру әдісі өткір пышақпен бір рет соққы болды, екі жағдайда да қорғаныс белгілері жоқ.
Dialogue: 0,0:07:55.93,0:07:57.89,Default,,0,0,0,,Басқаша айтқанда, үнсіз жорғалау
Dialogue: 0,0:07:57.97,0:08:00.64,Default,,0,0,0,,Нысана дауысын көтермей тұрып, бір сәтте кесіп тастаңыз.
Dialogue: 0,0:08:01.31,0:08:03.69,Default,,0,0,0,,Жартылай қол емес екеніне сенімдімін.
Dialogue: 0,0:08:03.90,0:08:05.73,Default,,0,0,0,,Брэндон профилін жасау?
Dialogue: 0,0:08:05.90,0:08:08.11,Default,,0,0,0,,Аа, мен көп нәрсені істеп жатырмын ...
Dialogue: 0,0:08:08.19,0:08:10.61,Default,,0,0,0,,Тыңдау үшін кілт сөздер жеткіліксіз
Dialogue: 0,0:08:10.69,0:08:13.24,Default,,0,0,0,,Қазіргі жағдай дәлдікті жақсарту мүмкін емес.
Dialogue: 0,0:08:13.32,0:08:14.74,Default,,0,0,0,,Белгілер туралы не деуге болады?
Dialogue: 0,0:08:14.82,0:08:16.78,Default,,0,0,0,,Каэла, сен сонда қызмет ете аласың ба?
Dialogue: 0,0:08:17.07,0:08:18.24,Default,,0,0,0,,Ал...
Dialogue: 0,0:08:19.41,0:08:21.62,Default,,0,0,0,,Ұқсастары сансыз көп.
Dialogue: 0,0:08:21.70,0:08:23.21,Default,,0,0,0,,Өйткені бұл жай ғана «В»
Dialogue: 0,0:08:23.46,0:08:26.13,Default,,0,0,0,,Уау... көзім жыпылықтайды
Dialogue: 0,0:08:28.38,0:08:30.21,Default,,0,0,0,,Жанкүйерлер сайты туралы не деуге болады?
Dialogue: 0,0:08:30.38,0:08:31.59,Default,,0,0,0,,Өте танымал, солай емес пе?
Dialogue: 0,0:08:32.22,0:08:34.30,Default,,0,0,0,,Әлі де аз емес.
Dialogue: 0,0:08:35.72,0:08:36.55,Default,,0,0,0,,Кит
Dialogue: 0,0:08:37.14,0:08:38.01,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:39.06,0:08:42.27,Default,,0,0,0,,Сіз бұған қараған кезде бірдеңе байқадыңыз ба?
Dialogue: 0,0:08:45.02,0:08:46.15,Default,,0,0,0,,Сен ұйықтап қалдың!
Dialogue: 0,0:08:47.44,0:08:48.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:48.90,0:08:50.73,Default,,0,0,0,,Каэла, басқа суретті беріңізші.
Dialogue: 0,0:08:50.82,0:08:52.82,Default,,0,0,0,,А, сіз бәрін бергіңіз келе ме?
Dialogue: 0,0:08:52.90,0:08:55.07,Default,,0,0,0,,Борис жыпылықтамайтын дәрежеде
Dialogue: 0,0:08:55.15,0:08:56.49,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:08:57.11,0:08:58.24,Default,,0,0,0,,А...
Dialogue: 0,0:09:04.83,0:09:06.00,Default,,0,0,0,,(атыс дыбысы)
Dialogue: 0,0:09:07.63,0:09:08.88,Default,,0,0,0,,Не болды? Эй!
Dialogue: 0,0:09:09.46,0:09:10.29,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:09:27.73,0:09:28.94,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:09:31.27,0:09:32.61,Default,,0,0,0,,Қартаясың~
Dialogue: 0,0:09:34.61,0:09:35.61,Default,,0,0,0,,Geni
Dialogue: 0,0:09:37.20,0:09:39.16,Default,,0,0,0,,Күлсалғыш жоғалып кетті.
Dialogue: 0,0:09:39.57,0:09:41.33,Default,,0,0,0,,Қазір барлық жерде темекі шегуге тыйым салынады.
Dialogue: 0,0:09:41.53,0:09:43.91,Default,,0,0,0,,Мен де баяғыда тастадым.
Dialogue: 0,0:09:44.04,0:09:44.87,Default,,0,0,0,,өтіңіз
Dialogue: 0,0:09:47.79,0:09:50.63,Default,,0,0,0,,Аа~ мынау есімде.
Dialogue: 0,0:09:50.71,0:09:51.79,Default,,0,0,0,,Онда ішпеңіз
Dialogue: 0,0:09:57.38,0:10:00.76,Default,,0,0,0,,Қайтыс болғанына жыл толды... Бір жыл ерте.
Dialogue: 0,0:10:01.35,0:10:02.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:08.02,0:10:11.02,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:10:12.90,0:10:15.15,Default,,0,0,0,,Қайтып келгеннен кейін көп ұзамай бос емес сияқтысыз.
Dialogue: 0,0:10:15.36,0:10:18.40,Default,,0,0,0,,Егер сіз жаман кофе ішкіңіз келсе, кез келген уақытта келіңіз.
Dialogue: 0,0:10:18.82,0:10:19.66,Default,,0,0,0,,О
Dialogue: 0,0:10:23.08,0:10:24.74,Default,,0,0,0,,О, мен ұмытып қалдым.
Dialogue: 0,0:10:30.04,0:10:30.88,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:10:38.42,0:10:39.80,Default,,0,0,0,,Сіз білдіңіз бе?
Dialogue: 0,0:10:41.93,0:10:44.81,Default,,0,0,0,,Мен… біраз ойланып алайын.
Dialogue: 0,0:10:45.14,0:10:47.22,Default,,0,0,0,,Армия: қалалық полициядан қолдау сұрау
Dialogue: 0,0:10:47.81,0:10:49.98,Default,,0,0,0,,Біреу әскери көлікке шабуыл жасады.
Dialogue: 0,0:10:50.60,0:10:51.94,Default,,0,0,0,,IFV тонау
Dialogue: 0,0:10:52.06,0:10:55.02,Default,,0,0,0,,Қазіргі уақытта Aqualine астанаға қарай қашып жатыр.
Dialogue: 0,0:10:55.32,0:10:57.28,Default,,0,0,0,,Король әулеті жариялаған әскери жағдай
Dialogue: 0,0:10:57.69,0:10:58.78,Default,,0,0,0,,Генерал Берннің қолбасшылығымен...
Dialogue: 0,0:10:58.86,0:11:00.11,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:11:00.57,0:11:02.24,Default,,0,0,0,,Бұл тіпті революцияда болды ма?
Dialogue: 0,0:11:02.49,0:11:03.87,Default,,0,0,0,,Барлығы оқиға орнына асығады
Dialogue: 0,0:11:03.99,0:11:05.16,Default,,0,0,0,,Марио Сол жерде команданы алыңыз.
Dialogue: 0,0:11:05.24,0:11:06.08,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:11:06.41,0:11:08.70,Default,,0,0,0,,Брэндон Жергілікті полициямен ынтымақтастықты үйлестіру
Dialogue: 0,0:11:08.79,0:11:09.62,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:11:09.71,0:11:11.58,Default,,0,0,0,,Борис, әскерилер өтінемін.
Dialogue: 0,0:11:11.67,0:11:13.46,Default,,0,0,0,,Сондай-ақ орналастыруды көрсетіңіз.
Dialogue: 0,0:11:13.92,0:11:15.13,Default,,0,0,0,,Не, мен мұны істеймін бе?
Dialogue: 0,0:11:15.21,0:11:16.21,Default,,0,0,0,,Жасай бер!
Dialogue: 0,0:11:16.30,0:11:17.25,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:11:17.34,0:11:18.17,Default,,0,0,0,,Кит
Dialogue: 0,0:11:18.26,0:11:19.09,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:11:19.47,0:11:22.01,Default,,0,0,0,,Төтенше жағдай орын алды, мен сізден көмек сұраймын.
Dialogue: 0,0:11:24.64,0:11:25.51,Default,,0,0,0,,(атыс дыбысы)
Dialogue: 0,0:11:33.40,0:11:34.40,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:11:45.41,0:11:47.70,Default,,0,0,0,,Қарғыс атқыр шыбындар!
Dialogue: 0,0:11:50.00,0:11:51.33,Default,,0,0,0,,Күрделі естіледі.
Dialogue: 0,0:11:51.62,0:11:53.58,Default,,0,0,0,,Лили, біз осылай артқа қарай өтеміз.
Dialogue: 0,0:11:54.25,0:11:55.50,Default,,0,0,0,,Сіз алға немесе бүйірге жылжи аласыз ба?
Dialogue: 0,0:11:55.75,0:11:58.21,Default,,0,0,0,,Ем... Парк бұзыңыз!
Dialogue: 0,0:11:58.50,0:11:59.67,Default,,0,0,0,,Түсінікті!
Dialogue: 0,0:12:00.05,0:12:01.30,Default,,0,0,0,,Бір минут күте тұрыңыз, Лили!
Dialogue: 0,0:12:01.51,0:12:02.93,Default,,0,0,0,,Жоқ! аа!
Dialogue: 0,0:12:03.18,0:12:05.51,Default,,0,0,0,,Менің айтқым келгені бұл емес! Ооо!
Dialogue: 0,0:12:05.68,0:12:07.89,Default,,0,0,0,,Жолда жүгір! жол~!
Dialogue: 0,0:12:08.72,0:12:09.77,Default,,0,0,0,,Мақсатқа жету!
Dialogue: 0,0:12:10.77,0:12:11.60,Default,,0,0,0,,Лилия!
Dialogue: 0,0:12:12.94,0:12:13.77,Default,,0,0,0,,шығады!
Dialogue: 0,0:12:20.57,0:12:21.99,Default,,0,0,0,,О, құдайым...!
Dialogue: 0,0:12:26.37,0:12:28.08,Default,,0,0,0,,Лили, сені нысанаға алып жатыр!
Dialogue: 0,0:12:28.16,0:12:29.08,Default,,0,0,0,,Кешіріңіз, мен түсемін!
Dialogue: 0,0:12:30.95,0:12:31.79,Default,,0,0,0,,Лилия!
Dialogue: 0,0:12:35.54,0:12:37.04,Default,,0,0,0,,Сіз бұл көлікпен жақындай алмайсыз!
Dialogue: 0,0:12:37.38,0:12:38.59,Default,,0,0,0,,Алдынан сұрау
Dialogue: 0,0:12:39.00,0:12:41.26,Default,,0,0,0,,Қайда? Шығу!
Dialogue: 0,0:12:41.88,0:12:44.05,Default,,0,0,0,,Өзіңді көрсет!
Dialogue: 0,0:12:44.13,0:12:47.64,Default,,0,0,0,,Құбыжық!
Dialogue: 0,0:12:52.10,0:12:53.81,Default,,0,0,0,,мұнда өркениет бұрыннан-ақ бар еді.
Dialogue: 0,0:12:53.93,0:12:57.19,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:12:57.48,0:13:00.07,Default,,0,0,0,,Өл, өл, өл!
Dialogue: 0,0:13:00.15,0:13:03.03,Default,,0,0,0,,Барлығын жойыңыз!
Dialogue: 0,0:13:03.65,0:13:06.57,Default,,0,0,0,,Бұл тәртіпсіздік. Мақсаты не екенін білмеймін.
Dialogue: 0,0:13:06.66,0:13:08.49,Default,,0,0,0,,Ешқашан қашып кетуіме жол берме!
Dialogue: 0,0:13:10.58,0:13:13.41,Default,,0,0,0,,Джулиан Кешіріңіз, бірақ қызықты жері осында.
Dialogue: 0,0:13:14.41,0:13:15.83,Default,,0,0,0,,Мен суға түсемін
Dialogue: 0,0:13:23.88,0:13:24.88,Default,,0,0,0,,Сәлем Марио!
Dialogue: 0,0:13:24.97,0:13:26.05,Default,,0,0,0,,Датчикке қараңыз!
Dialogue: 0,0:13:28.47,0:13:30.76,Default,,0,0,0,,Түтін экранын қорғауға арналған APS?
Dialogue: 0,0:13:31.39,0:13:33.14,Default,,0,0,0,,Бұл жай ғана IFV емес пе...
Dialogue: 0,0:13:33.22,0:13:35.23,Default,,0,0,0,,Көміртекті талшық бөлшектері болуы мүмкін
Dialogue: 0,0:13:36.06,0:13:39.36,Default,,0,0,0,,Радар толқынын блоктау күйі Бақылау мүмкін емес
Dialogue: 0,0:13:39.44,0:13:40.27,Default,,0,0,0,,Жылу құрылғылары туралы не айтуға болады?
Dialogue: 0,0:13:40.36,0:13:41.19,Default,,0,0,0,,Жауап жоқ
Dialogue: 0,0:13:41.57,0:13:44.15,Default,,0,0,0,,Tsk Әрбір аймақты дереу құлыптаңыз.
Dialogue: 0,0:13:44.53,0:13:46.28,Default,,0,0,0,,Қалай болғанда да, қылмыскерді қоршаңыз
Dialogue: 0,0:13:48.28,0:13:49.37,Default,,0,0,0,,Бұл Альфа!
Dialogue: 0,0:13:49.57,0:13:52.99,Default,,0,0,0,,Эрик! IFV қайда кетті? Маған нұсқау беріңіз!
Dialogue: 0,0:13:57.67,0:13:59.08,Default,,0,0,0,,Hic… tsk…
Dialogue: 0,0:13:59.50,0:14:02.04,Default,,0,0,0,,Олар кімдер?
Dialogue: 0,0:14:12.22,0:14:16.43,Default,,0,0,0,,Не? Эй, оларды қайда апарғың келеді?
Dialogue: 0,0:14:18.60,0:14:20.06,Default,,0,0,0,,Тасымалдау.
Dialogue: 0,0:14:20.60,0:14:23.11,Default,,0,0,0,,Қызық енді басталады
Dialogue: 0,0:14:24.02,0:14:25.28,Default,,0,0,0,,IFV тағдыры қандай?
Dialogue: 0,0:14:25.40,0:14:26.40,Default,,0,0,0,,Ол әлі келген жоқ.
Dialogue: 0,0:14:26.99,0:14:28.28,Default,,0,0,0,,Қайда жоғалып кетті...
Dialogue: 0,0:14:28.36,0:14:30.16,Default,,0,0,0,,Спутниктің сезімталдығын арттыру
Dialogue: 0,0:14:30.91,0:14:31.99,Default,,0,0,0,,Қалдықтар, иә?
Dialogue: 0,0:14:32.07,0:14:33.62,Default,,0,0,0,,Муда
Dialogue: 0,0:14:34.79,0:14:36.91,Default,,0,0,0,,Мен оны таба алмаймын деп ойлаймын.
Dialogue: 0,0:14:37.37,0:14:38.21,Default,,0,0,0,,Егер бұл операция сәтті өтсе,
Dialogue: 0,0:14:39.33,0:14:40.17,Default,,0,0,0,,Каэла
Dialogue: 0,0:14:40.25,0:14:42.25,Default,,0,0,0,,Сіз туннельге кірер алдында IFV бейнесін бере аласыз ба?
Dialogue: 0,0:14:42.33,0:14:43.17,Default,,0,0,0,,Иә
Dialogue: 0,0:14:43.75,0:14:46.13,Default,,0,0,0,,(жүргізуші дыбысы)
Dialogue: 0,0:14:46.26,0:14:47.09,Default,,0,0,0,,Шығып бара жатырсың ба?
Dialogue: 0,0:14:48.55,0:14:49.76,Default,,0,0,0,,Біраз уақыт қайталаңыз.
Dialogue: 0,0:14:49.97,0:14:53.97,Default,,0,0,0,,(жүргізуші дыбысы)
Dialogue: 0,0:14:54.47,0:14:57.47,Default,,0,0,0,,Түсіндім, бұл...
Dialogue: 0,0:14:59.69,0:15:02.48,Default,,0,0,0,,Гибридті IFV көпшілікке жариялау алдында
Dialogue: 0,0:15:03.06,0:15:06.28,Default,,0,0,0,,Бұл қозғалыс дыбысы инвертордан туындаған масалардың шуы.
Dialogue: 0,0:15:06.36,0:15:09.19,Default,,0,0,0,,Содан ол кенеттен термалдардан жоғалып кетті.
Dialogue: 0,0:15:09.61,0:15:13.16,Default,,0,0,0,,Максималды жасырын өнімділігі бар жаңа IFV түрі...
Dialogue: 0,0:15:14.33,0:15:16.45,Default,,0,0,0,,Оны бір құжаттан оқығаным есімде.
Dialogue: 0,0:15:16.54,0:15:19.16,Default,,0,0,0,,Бұл ел әскери жағынан артта қалған ел деп айтылады.
Dialogue: 0,0:15:19.75,0:15:24.71,Default,,0,0,0,,Басқа елдердің араласуынсыз өз бетінше жасалған заманауи жауынгерлік машина
Dialogue: 0,0:15:24.84,0:15:26.67,Default,,0,0,0,,Жалпы есім 50 (Гомал)
Dialogue: 0,0:15:28.51,0:15:32.18,Default,,0,0,0,,Бұл жігіттер құпияларды ешбір оқиғасыз ұрлады.
Dialogue: 0,0:15:32.26,0:15:37.35,Default,,0,0,0,,Балаша әбігерден кейін қабілетін мүлтіксіз пайдаланып, ғайып болды.
Dialogue: 0,0:15:39.18,0:15:41.77,Default,,0,0,0,,Ақылсыздың ақымақтығы немесе ақылдының даналығы...
Dialogue: 0,0:15:43.44,0:15:45.40,Default,,0,0,0,,Қалай болғанда да қиын.
Dialogue: 0,0:15:46.61,0:15:47.52,Default,,0,0,0,,Ал...
Dialogue: 0,0:15:52.28,0:15:53.95,Default,,0,0,0,,Негізгі сызық қайсысы?
Dialogue: 0,0:16:10.30,0:16:12.38,Default,,0,0,0,,Сіз не істеп жатырсыз? Сол адам
Dialogue: 0,0:16:12.47,0:16:13.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:13.55,0:16:15.51,Default,,0,0,0,,Сол біртүрлі шаршылар мен үшбұрыштар ше?
Dialogue: 0,0:16:16.26,0:16:20.06,Default,,0,0,0,,Хмм, мен сенімдімін... Мұның бәрі айнымалыларды бөлу туралы...
Dialogue: 0,0:16:20.22,0:16:21.43,Default,,0,0,0,,Түсінбесеңіз, жақсы.
Dialogue: 0,0:16:22.39,0:16:25.31,Default,,0,0,0,,Мен оны 20 жылдан бері білемін.
Dialogue: 0,0:16:26.15,0:16:28.90,Default,,0,0,0,,Мен не ойлағанымды ешқашан білмедім!
Dialogue: 0,0:16:28.98,0:16:30.65,Default,,0,0,0,,Бұл мақтанатын жер емес.
Dialogue: 0,0:16:30.99,0:16:31.82,Default,,0,0,0,,Тек...
Dialogue: 0,0:16:32.95,0:16:35.74,Default,,0,0,0,,Күтсең, ол сені міндетті түрде шығарып салады.
Dialogue: 0,0:16:36.87,0:16:37.70,Default,,0,0,0,,Қый!
Dialogue: 0,0:16:38.33,0:16:39.24,Default,,0,0,0,,Жауап.
Dialogue: 0,0:16:40.29,0:16:41.12,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:41.83,0:16:45.50,Default,,0,0,0,,Бұл айдап салу ма, әлде бопсалау ма? Жоқ.
Dialogue: 0,0:16:45.58,0:16:47.50,Default,,0,0,0,,Тонау үшін бұрмалау қызметін атқару
Dialogue: 0,0:16:47.88,0:16:51.09,Default,,0,0,0,,Екі жоғарыда Жоғарыда Біреуден жоғарыда
Dialogue: 0,0:16:53.42,0:16:54.30,Default,,0,0,0,,Эрик…
Dialogue: 0,0:16:54.84,0:16:58.22,Default,,0,0,0,,Сәлем! монитор! Бұл монитор! Сәнді зат!
Dialogue: 0,0:17:00.22,0:17:01.77,Default,,0,0,0,,Oris Heavy Industries сайты
Dialogue: 0,0:17:02.81,0:17:05.10,Default,,0,0,0,,Астында не бар...?
Dialogue: 0,0:17:05.48,0:17:08.19,Default,,0,0,0,,Альпі метросының қараусыз қалған желісі...
Dialogue: 0,0:17:08.98,0:17:11.03,Default,,0,0,0,,Біз де еларалық теміржолмен байланыстамыз!
Dialogue: 0,0:17:15.86,0:17:18.62,Default,,0,0,0,,Таудың басындағы терминал станциясы қазіргі уақытта Авиация мұражайы болып табылады.
Dialogue: 0,0:17:31.80,0:17:34.34,Default,,0,0,0,,Альфа Бұрынғы Альпен метросының бастапқы станциясына дейін
Dialogue: 0,0:17:34.88,0:17:37.38,Default,,0,0,0,,Бета шұғыл түрде авиациялық мұражайға
Dialogue: 0,0:17:38.14,0:17:41.93,Default,,0,0,0,,Каэла Аспанды ескерту үшін әскерге хабарлаңыз.
Dialogue: 0,0:17:42.01,0:17:42.85,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:17:49.44,0:17:50.65,Default,,0,0,0,,Жауап беріңіз
Dialogue: 0,0:17:50.90,0:17:53.69,Default,,0,0,0,,№645 вагон Бұл Теміржол полициясы.
Dialogue: 0,0:17:54.36,0:17:55.74,Default,,0,0,0,,Жауап № 645…
Dialogue: 0,0:17:56.20,0:17:57.32,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:17:59.87,0:18:02.28,Default,,0,0,0,,Ол шынымен де келе ме?
Dialogue: 0,0:18:03.79,0:18:05.75,Default,,0,0,0,,Өтірік болса...
Dialogue: 0,0:18:09.33,0:18:10.96,Default,,0,0,0,,Теміржол полициясының қоңырауы
Dialogue: 0,0:18:11.04,0:18:13.67,Default,,0,0,0,,JNR Loop 2-маршрутында жүк көлігі басқарудан шығып кетті
Dialogue: 0,0:18:13.92,0:18:15.26,Default,,0,0,0,,Альфа, менің барғанымды қалайсың ба?
Dialogue: 0,0:18:15.34,0:18:19.34,Default,,0,0,0,,Мені қалдырыңыз, бәрібір полиция мен әскерилер сонда шоғырланады.
Dialogue: 0,0:18:19.97,0:18:22.05,Default,,0,0,0,,IFV жоқ
Dialogue: 0,0:18:22.35,0:18:24.89,Default,,0,0,0,,Жүк вагонында ауыр жұмыс істеп жүрген ақымақ
Dialogue: 0,0:18:24.97,0:18:28.06,Default,,0,0,0,,Оқиға аяқталғаннан кейін сіз қылмыскер ретінде жойыласыз.
Dialogue: 0,0:18:28.69,0:18:30.40,Default,,0,0,0,,Тек оның тоқтағанын күтіңіз
Dialogue: 0,0:18:31.15,0:18:31.98,Default,,0,0,0,,келді
Dialogue: 0,0:18:38.36,0:18:41.07,Default,,0,0,0,,Уау! сен~!
Dialogue: 0,0:18:41.82,0:18:43.24,Default,,0,0,0,,Бұл сен бе!?
Dialogue: 0,0:18:43.45,0:18:45.33,Default,,0,0,0,,Ол шынымен де келді!
Dialogue: 0,0:18:45.70,0:18:46.87,Default,,0,0,0,,Сәлем! Теме...
Dialogue: 0,0:18:50.71,0:18:53.13,Default,,0,0,0,,Иә, еңбектеріңіз үшін рахмет.
Dialogue: 0,0:19:03.97,0:19:05.81,Default,,0,0,0,,Ол пайда болды ма? (Миназуки) Ах
Dialogue: 0,0:19:06.93,0:19:07.77,Default,,0,0,0,,Ол ма?
Dialogue: 0,0:19:08.39,0:19:11.23,Default,,0,0,0,,Куэн қайтып келмесе... бұл расталды.
Dialogue: 0,0:19:19.99,0:19:23.95,Default,,0,0,0,,Мен сізді шақыруға бұйрық алдым.
Dialogue: 0,0:19:25.41,0:19:27.87,Default,,0,0,0,,Бұл сіз өлтіре алатын адам.
Dialogue: 0,0:19:28.16,0:19:29.54,Default,,0,0,0,,Мен өлімші жанмын.
Dialogue: 0,0:19:30.08,0:19:33.75,Default,,0,0,0,,Мен түсіндім, бұл кенеттен болған мәселе және менің өз жағдайларым бар.
Dialogue: 0,0:19:34.13,0:19:36.21,Default,,0,0,0,,Да~ка~ра~
Dialogue: 0,0:19:37.34,0:19:39.72,Default,,0,0,0,,Мен сені өз жолыммен шақырамын.
Dialogue: 0,0:19:40.30,0:19:42.22,Default,,0,0,0,,Күтілгеннен ертерек байқалды
Dialogue: 0,0:19:42.43,0:19:43.55,Default,,0,0,0,,Мен мұны артта қалдырамын.
Dialogue: 0,0:19:43.64,0:19:45.26,Default,,0,0,0,,Иә? Осы уақытқа дейін келдіңіз бе?
Dialogue: 0,0:19:45.89,0:19:47.93,Default,,0,0,0,,Газ ше? Барлығы
Dialogue: 0,0:19:49.14,0:19:50.89,Default,,0,0,0,,В жоспарына өзгерту
Dialogue: 0,0:19:51.31,0:19:52.73,Default,,0,0,0,,Минадзуки Куэн ше?
Dialogue: 0,0:19:53.77,0:19:55.48,Default,,0,0,0,,айтылған В жоспары.
Dialogue: 0,0:19:58.03,0:20:00.36,Default,,0,0,0,,Басқаша айтқанда, Куэнді тастаңыз.
Dialogue: 0,0:20:02.07,0:20:02.91,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:20:05.03,0:20:06.58,Default,,0,0,0,,Қараңдар! Қараңдар! ше?
Dialogue: 0,0:20:06.66,0:20:08.83,Default,,0,0,0,,Маған қабілеттеріңізді көрсетіңіз! Күш!
Dialogue: 0,0:20:08.91,0:20:10.95,Default,,0,0,0,,Нағыз сыртқы көрініс! Қараңдар! Қараңдар! Қараңдар!
Dialogue: 0,0:20:13.50,0:20:14.33,Default,,0,0,0,,Ура!
Dialogue: 0,0:20:16.67,0:20:17.50,Default,,0,0,0,,Әй?
Dialogue: 0,0:20:19.17,0:20:23.38,Default,,0,0,0,,Мейірімді жүрек болмаса, күнәларыңды өліммен өте.
Dialogue: 0,0:20:33.89,0:20:35.27,Default,,0,0,0,,Лохенгрин
Dialogue: 0,0:20:36.77,0:20:38.36,Default,,0,0,0,,Қара қауырсындардың патшасы...
Dialogue: 0,0:20:40.94,0:20:42.36,Default,,0,0,0,,Мен сонда болдым
Dialogue: 0,0:20:44.28,0:20:45.20,Default,,0,0,0,,Ол шынымен де сонда болды!
Dialogue: 0,0:20:45.82,0:20:48.62,Default,,0,0,0,,Миназуки~!
Dialogue: 0,0:20:51.08,0:20:52.37,Default,,0,0,0,,Лилили…
Dialogue: 0,0:20:52.45,0:20:54.37,Default,,0,0,0,,Сөйлессем тілімді тістеймін!
Dialogue: 0,0:20:57.42,0:20:58.92,Default,,0,0,0,,Жоқ! Нуаа!
Dialogue: 0,0:21:00.46,0:21:02.26,Default,,0,0,0,,Уа! Борис Кешіріңіз!
Dialogue: 0,0:21:06.05,0:21:06.89,Default,,0,0,0,,Хигучи расталды.
Dialogue: 0,0:21:07.64,0:21:08.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:15.60,0:21:16.85,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:21:16.94,0:21:17.77,Default,,0,0,0,,Тото... Ах...
Dialogue: 0,0:21:19.98,0:21:23.24,Default,,0,0,0,,Асықпа, көңілді көбірек өткізейік
Dialogue: 0,0:21:23.32,0:21:24.15,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:24.99,0:21:26.36,Default,,0,0,0,,Керемет!
Dialogue: 0,0:21:27.07,0:21:28.12,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:21:28.62,0:21:30.95,Default,,0,0,0,,Тек соқпау керек.
Dialogue: 0,0:21:31.58,0:21:34.12,Default,,0,0,0,,Мен бұл қолды аламын!
Dialogue: 0,0:21:43.67,0:21:47.13,Default,,0,0,0,,Уау!
Dialogue: 0,0:22:28.72,0:22:32.43,Default,,0,0,0,,(Тікұшақ винтінің дыбысы)
Dialogue: 0,0:22:45.28,0:22:47.40,Default,,0,0,0,,Сіз дұрыс түсінбедіңіз...
Dialogue: 0,0:22:49.57,0:22:51.53,Default,,0,0,0,,Бұл негізгі сызық па?
Dialogue: 0,0:23:06.84,0:23:08.92,Default,,0,0,0,,Мәселе шешілді.
Dialogue: 0,0:23:09.67,0:23:10.97,Default,,0,0,0,,Бұл қайда!
Dialogue: 0,0:23:11.30,0:23:13.05,Default,,0,0,0,,Бұлай жалғаса берсе, жүк вагоны аударылады.
Dialogue: 0,0:23:13.14,0:23:16.14,Default,,0,0,0,,IFV жай ғана тауларда қалдырылады!
Dialogue: 0,0:23:16.22,0:23:20.23,Default,,0,0,0,,Дұрыс, осылайша ыңғайлырақ.
Dialogue: 0,0:23:20.31,0:23:21.14,Default,,0,0,0,,Біртүрлі!
Dialogue: 0,0:23:21.44,0:23:22.27,Default,,0,0,0,,Ау, ауырып тұр!
Dialogue: 0,0:23:22.65,0:23:23.98,Default,,0,0,0,,Не істеп жатырсың, Бран?
Dialogue: 0,0:23:24.06,0:23:24.90,Default,,0,0,0,,Мынаны қараңыз!
Dialogue: 0,0:23:27.69,0:23:29.82,Default,,0,0,0,,Бұл... мүмкін емес...
Dialogue: 0,0:23:31.74,0:23:34.16,Default,,0,0,0,,Бұл жай ғана кездейсоқтық екеніне сенімдімін.
Dialogue: 0,0:23:34.32,0:23:36.08,Default,,0,0,0,,Мұндай емес қой. (Миямура) Шынымен бе?
Dialogue: 0,0:23:38.50,0:23:41.50,Default,,0,0,0,,Сіз бұл белгіні байқадыңыз ба?
Dialogue: 0,0:23:45.71,0:23:47.34,Default,,0,0,0,,Мен өлтіруді жалғастырамын
Dialogue: 0,0:23:48.96,0:23:51.38,Default,,0,0,0,,Мені тапқанша
Dialogue: 0,0:23:57.35,0:23:58.47,Default,,0,0,0,,♬ Мен бара жатқан жер — әлі көрінбеген тағдыр
Dialogue: 0,0:24:01.35,0:24:02.77,Default,,0,0,0,,Мен оны табамын.
Dialogue: 0,0:24:04.35,0:24:05.40,Default,,0,0,0,,Өзі ешқашан Ал Майтты басып оза алмайтынын түсінген әкем—
Dialogue: 0,0:24:08.65,0:24:09.65,Default,,0,0,0,,Мен осындамын
Dialogue: 0,0:24:10.36,0:24:16.37,Default,,0,0,0,,♪〜
Dialogue: 0,0:26:01.35,0:26:07.35,Default,,0,0,0,,〜♪
