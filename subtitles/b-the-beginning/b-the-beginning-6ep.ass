Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:11.01,Default,,0,0,0,,NETFLIX түпнұсқа сериясы
Dialogue: 0,0:00:21.60,0:00:23.69,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:00:26.40,0:00:27.94,Default,,0,0,0,,Айтар сөзің болса
Dialogue: 0,0:00:28.11,0:00:29.82,Default,,0,0,0,,Егер мен анық айтсам ше?
Dialogue: 0,0:00:31.03,0:00:32.78,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:00:33.15,0:00:36.99,Default,,0,0,0,,Мен сіз мұны істей аласыз ба деп ойладым.
Dialogue: 0,0:00:39.83,0:00:42.16,Default,,0,0,0,,Оны қазір қолданып көргіңіз келе ме?
Dialogue: 0,0:00:43.83,0:00:46.71,Default,,0,0,0,,Қорқынышты... сәлем эй
Dialogue: 0,0:00:47.13,0:00:51.59,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:00:52.17,0:00:58.18,Default,,0,0,0,,♪〜
Dialogue: 0,0:01:01.01,0:01:07.02,Default,,0,0,0,,〜♪
Dialogue: 0,0:01:07.10,0:01:11.19,Default,,0,0,0,,Мен саған да беремін, Тору.
Dialogue: 0,0:01:19.24,0:01:20.95,Default,,0,0,0,,Қауырсындар ше?
Dialogue: 0,0:01:21.79,0:01:24.12,Default,,0,0,0,,Қазір ол сіздің денеңіздің ішінде ме?
Dialogue: 0,0:01:25.66,0:01:28.00,Default,,0,0,0,,Маған «Канопты түртіңіз» деп айтты
Dialogue: 0,0:01:28.63,0:01:30.29,Default,,0,0,0,,Сондықтан мен сізге хабарластым.
Dialogue: 0,0:01:30.59,0:01:35.09,Default,,0,0,0,,Хмм... нені ұстауым керек? кімге?
Dialogue: 0,0:01:35.59,0:01:36.72,Default,,0,0,0,,Канопус
Dialogue: 0,0:01:37.47,0:01:41.01,Default,,0,0,0,,Бізге жол көрсететін қарияны осылай атаймыз.
Dialogue: 0,0:01:45.10,0:01:49.19,Default,,0,0,0,,Бұл кездейсоқтық. Мен де кісі өлтіруші баланы іздедім.
Dialogue: 0,0:01:53.44,0:01:54.53,Default,,0,0,0,,Юна қайда?
Dialogue: 0,0:01:55.53,0:01:56.40,Default,,0,0,0,,Юна?
Dialogue: 0,0:02:02.83,0:02:06.37,Default,,0,0,0,,Юна бөлінген күш пе?
Dialogue: 0,0:02:09.83,0:02:11.21,Default,,0,0,0,,№ 13
Dialogue: 0,0:02:15.09,0:02:18.76,Default,,0,0,0,,Ол байқады ма? сіздің белгілеуіңізге
Dialogue: 0,0:02:20.47,0:02:23.14,Default,,0,0,0,,Бір қарағанда, әлі жауап жоқ сияқты.
Dialogue: 0,0:02:23.72,0:02:26.02,Default,,0,0,0,,Мен оны өлтіруге қанша тырыссам да...
Dialogue: 0,0:02:27.60,0:02:30.35,Default,,0,0,0,,Ол мүлдем туыс емес пе?
Dialogue: 0,0:02:32.81,0:02:35.90,Default,,0,0,0,,Мен өлімге лайық адамдарды ғана өлтірдім.
Dialogue: 0,0:02:36.53,0:02:40.36,Default,,0,0,0,,Ей, бұл тағы бір керемет нәрсе.
Dialogue: 0,0:02:41.87,0:02:42.95,Default,,0,0,0,,Эй, сен ішкің келе ме?
Dialogue: 0,0:02:47.45,0:02:50.62,Default,,0,0,0,,Бұл эго екенін айта алатын ересек адам
Dialogue: 0,0:02:51.04,0:02:53.21,Default,,0,0,0,,Менің ойымша, ол қасында болмаған.
Dialogue: 0,0:02:55.13,0:02:57.96,Default,,0,0,0,,Сен не білесің?
Dialogue: 0,0:03:01.09,0:03:02.39,Default,,0,0,0,,А, мен түсінбеймін.
Dialogue: 0,0:03:02.97,0:03:06.35,Default,,0,0,0,,Бірақ мен бұл белгінің нені білдіретінін білемін.
Dialogue: 0,0:03:08.27,0:03:10.02,Default,,0,0,0,,Бұл В емес.
Dialogue: 0,0:03:10.64,0:03:15.77,Default,,0,0,0,,Араб цифры 13 және рим цифры 4, ол тек сағаттарда қолданылады.
Dialogue: 0,0:03:17.15,0:03:19.65,Default,,0,0,0,,Екі қабаттасатын сан
Dialogue: 0,0:03:20.86,0:03:24.32,Default,,0,0,0,,13 - сіз және 4 - ол?
Dialogue: 0,0:03:26.62,0:03:30.20,Default,,0,0,0,,Тек екі адам түсінетін кодты тарату үшін шығар.
Dialogue: 0,0:03:31.00,0:03:34.17,Default,,0,0,0,,B өлтірген қылмыскерлерді өлтіруді жалғастырды.
Dialogue: 0,0:03:36.25,0:03:38.71,Default,,0,0,0,,Барлығы жоғалған қыз туралы
Dialogue: 0,0:03:39.30,0:03:41.84,Default,,0,0,0,,Менің тірі екенімді білу үшін
Dialogue: 0,0:03:44.43,0:03:47.31,Default,,0,0,0,,Біреуді өлтірген сайын айқайлайтыныңыз осы емес пе?
Dialogue: 0,0:03:48.72,0:03:50.39,Default,,0,0,0,,«Мен осындамын».
Dialogue: 0,0:03:52.44,0:03:53.81,Default,,0,0,0,,Юна қайда?
Dialogue: 0,0:03:55.10,0:03:59.57,Default,,0,0,0,,Әй... Қазіргі балалар бірдеңені қалайды.
Dialogue: 0,0:03:59.69,0:04:02.11,Default,,0,0,0,,Мен «бер, ал» деген сөзді білмеймін.
Dialogue: 0,0:04:02.95,0:04:07.87,Default,,0,0,0,,Менің ойымша, сіз мені осында әкелдіңіз, өйткені сіздің де сұрағыңыз келген нәрсе бар еді.
Dialogue: 0,0:04:09.41,0:04:11.58,Default,,0,0,0,,Менің де сізден сұрайын дегенім бар.
Dialogue: 0,0:04:13.04,0:04:17.63,Default,,0,0,0,,Менің сенімен сөз ойнайын деген ойым жоқ. Юнаның қайда екенін білсең...
Dialogue: 0,0:04:17.71,0:04:18.75,Default,,0,0,0,,Ертең сағат 10.00-де
Dialogue: 0,0:04:19.75,0:04:21.46,Default,,0,0,0,,Хэянджи храмы Сіз білесіз бе?
Dialogue: 0,0:04:22.55,0:04:25.13,Default,,0,0,0,,Бұл шығыс сәулетінің храмы. Ол 8-ші ауданда орналасқан.
Dialogue: 0,0:04:26.64,0:04:28.60,Default,,0,0,0,,Толығырақ содан кейін айтып беремін.
Dialogue: 0,0:04:29.76,0:04:31.27,Default,,0,0,0,,Сәлем! Мұнда сөйлесіңіз!
Dialogue: 0,0:04:32.14,0:04:34.23,Default,,0,0,0,,Менің саған көрсететін бір нәрсем бар.
Dialogue: 0,0:04:35.52,0:04:38.11,Default,,0,0,0,,Мен оны ертең әкелемін. Кешіктірме.
Dialogue: 0,0:04:39.27,0:04:42.69,Default,,0,0,0,,Мен саған да беремін, Тору.
Dialogue: 0,0:04:52.45,0:04:53.45,Default,,0,0,0,,Хия~
Dialogue: 0,0:04:53.58,0:04:54.75,Default,,0,0,0,,Мұнда не болып жатыр...
Dialogue: 0,0:04:55.37,0:04:56.62,Default,,0,0,0,,Материалдар бөлімі
Dialogue: 0,0:04:58.38,0:05:02.38,Default,,0,0,0,,Ух... хмм
Dialogue: 0,0:05:05.13,0:05:06.22,Default,,0,0,0,,Қап…
Dialogue: 0,0:05:07.72,0:05:09.47,Default,,0,0,0,,Сен мәңгілікке қарғысқа ұшырадың—
Dialogue: 0,0:05:10.97,0:05:11.81,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:13.22,0:05:16.19,Default,,0,0,0,,Ол қайда? Ол қайда... Хмм?
Dialogue: 0,0:05:16.27,0:05:17.31,Default,,0,0,0,,Кит осында ма?
Dialogue: 0,0:05:18.98,0:05:21.32,Default,,0,0,0,,Хмм, 8 жыл...
Dialogue: 0,0:05:22.36,0:05:24.53,Default,,0,0,0,,Жалғыз
Dialogue: 0,0:05:29.24,0:05:30.87,Default,,0,0,0,,Оның себебі неде?
Dialogue: 0,0:05:31.53,0:05:33.37,Default,,0,0,0,,Сізді мұнда не үшін жіберді?
Dialogue: 0,0:05:34.41,0:05:37.37,Default,,0,0,0,,Өлті Кайл сотта
Dialogue: 0,0:05:37.46,0:05:41.34,Default,,0,0,0,,Ауруханадан ұсталып, рұқсатсыз азапталды
Dialogue: 0,0:05:41.67,0:05:43.09,Default,,0,0,0,,О, не?
Dialogue: 0,0:05:44.01,0:05:46.84,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,0:05:47.51,0:05:48.43,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:05:55.68,0:05:56.73,Default,,0,0,0,,Хаа~
Dialogue: 0,0:05:56.93,0:05:57.81,Default,,0,0,0,,және оны осы кезеңде бізге қалдыру қисынсыз болар еді, иә?
Dialogue: 0,0:05:58.64,0:06:01.15,Default,,0,0,0,,Қамауға алу туралы санкцияны қолдану процесі басталды
Dialogue: 0,0:06:01.65,0:06:03.52,Default,,0,0,0,,Біз де Китті тұтқындауға көшеміз.
Dialogue: 0,0:06:04.53,0:06:07.53,Default,,0,0,0,,(нұқу түймесін басыңыз)
Dialogue: 0,0:06:07.65,0:06:08.53,Default,,0,0,0,,Тырнақ
Dialogue: 0,0:06:09.20,0:06:10.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:13.83,0:06:14.95,Default,,0,0,0,,Лили қайда?
Dialogue: 0,0:06:15.24,0:06:16.16,Default,,0,0,0,,Мен ішіндемін.
Dialogue: 0,0:06:25.76,0:06:27.59,Default,,0,0,0,,Жанды аядым.
Dialogue: 0,0:06:29.47,0:06:30.30,Default,,0,0,0,,Иә
Dialogue: 0,0:06:30.68,0:06:32.55,Default,,0,0,0,,Сіз Кит Фрикті айтып тұрсыз ба?
Dialogue: 0,0:06:33.39,0:06:34.72,Default,,0,0,0,,Ол күдікті ме?
Dialogue: 0,0:06:36.77,0:06:37.81,Default,,0,0,0,,Әзірге
Dialogue: 0,0:06:38.43,0:06:39.94,Default,,0,0,0,,Ал... маған?
Dialogue: 0,0:06:40.39,0:06:42.27,Default,,0,0,0,,Бористен иә
Dialogue: 0,0:06:42.73,0:06:45.40,Default,,0,0,0,,Мен мұғалім Киттің ескі досы екенін естідім.
Dialogue: 0,0:06:45.98,0:06:48.53,Default,,0,0,0,,Мен онымен интернаттан бері біргемін.
Dialogue: 0,0:06:50.03,0:06:51.20,Default,,0,0,0,,Сыбайлас жемқорлық
Dialogue: 0,0:06:52.70,0:06:55.49,Default,,0,0,0,,Сіз де қылмысты Кит жасады деп ойлайсыз ба?
Dialogue: 0,0:06:56.41,0:06:57.33,Default,,0,0,0,,'Ол да сондай.'
Dialogue: 0,0:06:57.66,0:06:59.21,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:06:59.62,0:07:00.46,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:07:01.50,0:07:04.59,Default,,0,0,0,,Мм... ол туралы білгеніңше айтып берші...
Dialogue: 0,0:07:04.67,0:07:07.92,Default,,0,0,0,,Мен Кит Фрик деген жігітті білемін.
Dialogue: 0,0:07:08.13,0:07:09.97,Default,,0,0,0,,Ол өте қызықсыз адам.
Dialogue: 0,0:07:11.05,0:07:15.76,Default,,0,0,0,,Алдағы көріністі болжай алатындықтан, біз кездейсоқ әрекет жасай алмаймыз.
Dialogue: 0,0:07:16.06,0:07:18.68,Default,,0,0,0,,Ах... иә, яғни.
Dialogue: 0,0:07:18.81,0:07:23.35,Default,,0,0,0,,Бұл оқиғада алдын ала ойлану болмаған, сондықтан бұл Киттің қылмысы емес.
Dialogue: 0,0:07:23.73,0:07:24.73,Default,,0,0,0,,Осыны айтып тұрсың ба?
Dialogue: 0,0:07:25.69,0:07:30.61,Default,,0,0,0,,Мен егжей-тегжейлі білмеймін, бірақ ол бірдеңеден күдіктенсе.
Dialogue: 0,0:07:30.74,0:07:32.78,Default,,0,0,0,,Менің ойымша, бұл оның кінәсі емес.
Dialogue: 0,0:07:33.49,0:07:35.66,Default,,0,0,0,,Мен мұндай абайсыз әрекеттерге бара алмаймын.
Dialogue: 0,0:07:36.70,0:07:38.70,Default,,0,0,0,,«Оны алмау» орнына?
Dialogue: 0,0:07:39.45,0:07:41.41,Default,,0,0,0,,«Мен оны қабылдай алмаймын.»
Dialogue: 0,0:07:42.50,0:07:44.46,Default,,0,0,0,,Күрсін... Мен түсінемін.
Dialogue: 0,0:07:48.00,0:07:48.96,Default,,0,0,0,,Баяғыдан бері...
Dialogue: 0,0:07:49.63,0:07:50.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:51.01,0:07:55.47,Default,,0,0,0,,Баяғыдан бері оның айналасына ізгі жүректер жиналды.
Dialogue: 0,0:07:56.05,0:07:59.27,Default,,0,0,0,,Маған оның соншалықты дос емес адам болғаны біртүрлі.
Dialogue: 0,0:08:00.68,0:08:02.35,Default,,0,0,0,,Сіз де солардың бірісіз бе?
Dialogue: 0,0:08:03.56,0:08:05.52,Default,,0,0,0,,Е! А, бұл...
Dialogue: 0,0:08:06.11,0:08:09.23,Default,,0,0,0,,Жетеді, рахмет!
Dialogue: 0,0:08:11.57,0:08:12.40,Default,,0,0,0,,Шынында да…
Dialogue: 0,0:08:12.78,0:08:14.41,Default,,0,0,0,,Бұл ұқсас болуы мүмкін.
Dialogue: 0,0:08:15.32,0:08:16.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:20.24,0:08:23.46,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:08:37.35,0:08:38.22,Default,,0,0,0,,Эй!
Dialogue: 0,0:08:38.30,0:08:39.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:39.35,0:08:42.48,Default,,0,0,0,,Мен қашқын болсам да,
Dialogue: 0,0:08:42.64,0:08:45.27,Default,,0,0,0,,Менің бос уақытым көп. Мен жай ғана қашып кеткім келеді.
Dialogue: 0,0:08:45.94,0:08:47.65,Default,,0,0,0,,Әй, әкелдің бе?
Dialogue: 0,0:08:47.73,0:08:50.73,Default,,0,0,0,,Қарасаң, арқаңда екенін білесің.
Dialogue: 0,0:08:51.03,0:08:53.15,Default,,0,0,0,,Бұл жаман~ Әр жолы Әр жолы
Dialogue: 0,0:08:54.70,0:08:57.66,Default,,0,0,0,,Жан өз-өзіне қол жұмсады ма?
Dialogue: 0,0:08:57.87,0:08:58.74,Default,,0,0,0,,О
Dialogue: 0,0:08:58.99,0:08:59.87,Default,,0,0,0,,Сіздің есте сақтау қабілетіңіз ше?
Dialogue: 0,0:09:00.03,0:09:01.12,Default,,0,0,0,,өзгертілді
Dialogue: 0,0:09:01.24,0:09:03.00,Default,,0,0,0,,Оның тамыры терең~
Dialogue: 0,0:09:04.12,0:09:05.75,Default,,0,0,0,,Тым абай болма, жарай ма?
Dialogue: 0,0:09:05.92,0:09:08.63,Default,,0,0,0,,Мен саған мәңгілік көмектесе алмаймын.
Dialogue: 0,0:09:09.21,0:09:11.75,Default,,0,0,0,,Эрик те әлсірейді.
Dialogue: 0,0:09:12.00,0:09:13.92,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:09:14.63,0:09:17.18,Default,,0,0,0,,Бұл жақында бітетін шығар...
Dialogue: 0,0:09:20.30,0:09:21.39,Default,,0,0,0,,Мүмкін...
Dialogue: 0,0:09:45.37,0:09:49.17,Default,,0,0,0,,Мен міндетті түрде Лохенгринді қамтамасыз етемін.
Dialogue: 0,0:09:50.25,0:09:54.71,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:10:05.27,0:10:06.73,Default,,0,0,0,,Мәселе бар ма?
Dialogue: 0,0:10:07.14,0:10:11.02,Default,,0,0,0,,Мен бар екеніне сенімдімін. Бұл жоспарда болмағанына сенімдімін.
Dialogue: 0,0:10:11.94,0:10:12.90,Default,,0,0,0,,бірақ манга суретшісінің үйіне алты минут ерте бару—
Dialogue: 0,0:10:13.69,0:10:16.19,Default,,0,0,0,,Лохенгриннің қабілеттері күтпеген жерден болды.
Dialogue: 0,0:10:16.74,0:10:20.32,Default,,0,0,0,,Сондықтан күтпеген жағдайды күтпеген жолмен шешіңіз.
Dialogue: 0,0:10:20.82,0:10:22.24,Default,,0,0,0,,Өліп қалсаң не істеу керек
Dialogue: 0,0:10:23.66,0:10:25.16,Default,,0,0,0,,Аузыңды жап!
Dialogue: 0,0:10:36.84,0:10:38.26,Default,,0,0,0,,(көліктің жүгіру дыбысы)
Dialogue: 0,0:11:06.74,0:11:07.79,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:11:08.29,0:11:10.37,Default,,0,0,0,,Хмм... О?
Dialogue: 0,0:11:11.96,0:11:12.96,Default,,0,0,0,,Желдей жылдам шабуыл!
Dialogue: 0,0:11:14.29,0:11:15.17,Default,,0,0,0,,Сол түнде толық ай болды
Dialogue: 0,0:11:19.34,0:11:20.97,Default,,0,0,0,,Оның аты бар, солай ма?
Dialogue: 0,0:11:25.05,0:11:26.14,Default,,0,0,0,,Айтыңызшы
Dialogue: 0,0:11:28.39,0:11:29.27,Default,,0,0,0,,Куробане...
Dialogue: 0,0:11:29.85,0:11:30.81,Default,,0,0,0,,Мен Китпін
Dialogue: 0,0:11:31.31,0:11:32.14,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:11:32.48,0:11:33.31,Default,,0,0,0,,Иә
Dialogue: 0,0:11:37.02,0:11:38.90,Default,,0,0,0,,Неден бастау керек?
Dialogue: 0,0:11:39.11,0:11:40.69,Default,,0,0,0,,Юна... (Кейт) Уайымдама.
Dialogue: 0,0:11:41.40,0:11:44.24,Default,,0,0,0,,Сен тірі болсаң, ол да тірі.
Dialogue: 0,0:11:45.16,0:11:46.62,Default,,0,0,0,,Бұл жай ғана болжам емес, солай ма?
Dialogue: 0,0:11:49.04,0:11:52.04,Default,,0,0,0,,Фаура Бланка институты туралы айту
Dialogue: 0,0:11:52.62,0:11:54.71,Default,,0,0,0,,Оның ақиқаты бар ма?
Dialogue: 0,0:11:58.80,0:12:01.22,Default,,0,0,0,,Мұның бәрі ағынды қарадан басталды.
Dialogue: 0,0:12:03.93,0:12:05.30,Default,,0,0,0,,16 ғасырдың соңы
Dialogue: 0,0:12:05.89,0:12:10.10,Default,,0,0,0,,13 тау басындағы қирандылардан тасқа айналған адам сүйектері табылды
Dialogue: 0,0:12:11.81,0:12:16.06,Default,,0,0,0,,Сол кездегі ғалымдар қанатты біртүрлі сүйектерді тапты.
Dialogue: 0,0:12:16.15,0:12:21.36,Default,,0,0,0,,Адамзаттың арғы атасы және ежелгі дәуірде гүлденген құдайдың қазба қалдықтары болып саналады.
Dialogue: 0,0:12:22.99,0:12:25.70,Default,,0,0,0,,Бұл Құдайдың қалпына келтіру жоспарының басы.
Dialogue: 0,0:12:27.32,0:12:31.41,Default,,0,0,0,,Король мен үкімет бұл жоспарды саяси мақсатта пайдалана ала ма деп ойлады.
Dialogue: 0,0:12:33.12,0:12:36.29,Default,,0,0,0,,Және таусылған қаржыны қалпына келтіру шарасы ретінде.
Dialogue: 0,0:12:36.71,0:12:39.80,Default,,0,0,0,,Құдайдың қайта тірілуі үшін қаражат жинау
Dialogue: 0,0:12:40.38,0:12:42.97,Default,,0,0,0,,Үлкен зерттеу нысанын салыңыз
Dialogue: 0,0:12:44.18,0:12:48.72,Default,,0,0,0,,Оның аты - Фаура Бранка Корольдік Ғылым Институты.
Dialogue: 0,0:12:50.64,0:12:54.14,Default,,0,0,0,,Онда құдайларды қайта тірілту үшін тамаша ғалым және
Dialogue: 0,0:12:54.56,0:12:57.98,Default,,0,0,0,,Ол кезде ең озық технология құрастырылған болатын.
Dialogue: 0,0:13:00.57,0:13:03.19,Default,,0,0,0,,сонда болды...
Dialogue: 0,0:13:03.28,0:13:07.57,Default,,0,0,0,,Үлкен қайырымдылыққа батып бара жатқан жемқор зерттеушінің үмітсіз өмірі
Dialogue: 0,0:13:09.74,0:13:12.16,Default,,0,0,0,,Ешбір жоспарсыз жақын туыстардың қайталанатын комбинациялары
Dialogue: 0,0:13:12.95,0:13:17.08,Default,,0,0,0,,«Таңбалар баласы» деп аталатын ақылсыз қылмыскерді жасады
Dialogue: 0,0:13:17.17,0:13:18.21,Default,,0,0,0,,Жою
Dialogue: 0,0:13:19.21,0:13:22.42,Default,,0,0,0,,Бұл зерттеу көлемі бірнеше ғасырлар бойы қайталанды.
Dialogue: 0,0:13:25.05,0:13:29.26,Default,,0,0,0,,Нәтиже бермейтін жоспарлардан бас тарту туралы сыбырлар болған кезде.
Dialogue: 0,0:13:30.43,0:13:34.52,Default,,0,0,0,,Бір зерттеуші патшаға барып, кеңес береді:
Dialogue: 0,0:13:35.43,0:13:38.52,Default,,0,0,0,,«Үйдегі және шетелдегі қорқыныш пен тыныштық арасындағы тепе-теңдік»
Dialogue: 0,0:13:38.77,0:13:41.57,Default,,0,0,0,,«Қасақана манипуляция жасайтын ұйым құру»
Dialogue: 0,0:13:42.65,0:13:44.99,Default,,0,0,0,,«Жобаға қажетті адам ресурстары»
Dialogue: 0,0:13:45.36,0:13:48.11,Default,,0,0,0,,«Мен сені Фаула Бранкада жаттықтырамын...»
Dialogue: 0,0:13:49.53,0:13:54.25,Default,,0,0,0,,Ал сәтсіздікке ұшыраған триллиондардың балалары
Dialogue: 0,0:13:54.87,0:13:58.46,Default,,0,0,0,,Хаос пен тәртіпті тудыратын арнайы барлау агенті ретінде
Dialogue: 0,0:13:58.58,0:14:01.25,Default,,0,0,0,,Ол патша үкіметіне жіберілді.
Dialogue: 0,0:14:01.96,0:14:05.13,Default,,0,0,0,,Содан бастап олар өте тиімді болды.
Dialogue: 0,0:14:06.13,0:14:09.22,Default,,0,0,0,,Әдетте «маркет-мейкер» ретінде белгілі
Dialogue: 0,0:14:11.72,0:14:13.39,Default,,0,0,0,,Бұл институтқа мүмкіндік береді
Dialogue: 0,0:14:13.56,0:14:17.14,Default,,0,0,0,,Үкімет қолдануы үшін өлімге әкелетін қаруды жасау орны ретінде
Dialogue: 0,0:14:17.23,0:14:18.14,Default,,0,0,0,,Аман бол
Dialogue: 0,0:14:19.69,0:14:21.31,Default,,0,0,0,,Бірақ ирониялық
Dialogue: 0,0:14:21.61,0:14:25.32,Default,,0,0,0,,Осы кезде Құдайды зерттеу үлкен қадам жасады.
Dialogue: 0,0:14:26.69,0:14:30.49,Default,,0,0,0,,Жетістікке апарар жолды көрсететін өмір туды.
Dialogue: 0,0:14:33.08,0:14:35.16,Default,,0,0,0,,Дәл сол кезде осылай болды.
Dialogue: 0,0:14:37.20,0:14:41.13,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:14:43.00,0:14:44.63,Default,,0,0,0,,Юна...
Dialogue: 0,0:14:45.59,0:14:47.13,Default,,0,0,0,,Юна...
Dialogue: 0,0:14:47.97,0:14:50.38,Default,,0,0,0,,Юна... Юна!
Dialogue: 0,0:14:50.55,0:14:54.60,Default,,0,0,0,,Юна... Юна! Юна!
Dialogue: 0,0:14:56.31,0:14:59.69,Default,,0,0,0,,Юнар!
Dialogue: 0,0:15:05.27,0:15:09.36,Default,,0,0,0,,Менің есімде қалғаны мылтық даусы мен жанып жатқан тамақтың иісі.
Dialogue: 0,0:15:11.70,0:15:14.62,Default,,0,0,0,,Сен мені не үшін білесің?
Dialogue: 0,0:15:16.79,0:15:18.16,Default,,0,0,0,,Куробане ретінде жазылған
Dialogue: 0,0:15:19.04,0:15:20.54,Default,,0,0,0,,«Кокуу» деп айтылады.
Dialogue: 0,0:15:21.96,0:15:23.92,Default,,0,0,0,,Сол адамға ұқсайды
Dialogue: 0,0:15:25.67,0:15:27.96,Default,,0,0,0,,Сіз қара түсті жазуды білесіз бе?
Dialogue: 0,0:15:28.46,0:15:30.26,Default,,0,0,0,,«Кремона тауының шыңында»
Dialogue: 0,0:15:31.68,0:15:36.51,Default,,0,0,0,,Генетикалық зерттеулердің дамуымен және сол жазудың шифрын ашумен,
Dialogue: 0,0:15:36.81,0:15:39.10,Default,,0,0,0,,Зерттеу секіріс пен шекпен алға жылжыды
Dialogue: 0,0:15:40.39,0:15:45.15,Default,,0,0,0,,Өйткені құдайлардың сүйектерінің қабілеттері мен сыртқы түрі жазуларда жазылған.
Dialogue: 0,0:15:47.73,0:15:50.78,Default,,0,0,0,,Сені және қамқоршыларыңды дүниеге әкелген
Dialogue: 0,0:15:50.95,0:15:54.70,Default,,0,0,0,,Жапониядан жіберілген үш жасушалық биолог
Dialogue: 0,0:15:55.62,0:15:58.83,Default,,0,0,0,,Солардың бірі – доктор Казама.
Dialogue: 0,0:15:59.04,0:16:00.16,Default,,0,0,0,,Га
Dialogue: 0,0:16:00.96,0:16:03.96,Default,,0,0,0,,Шын аты «Хит Казама Фрик»
Dialogue: 0,0:16:07.25,0:16:08.42,Default,,0,0,0,,Ол менің әкем.
Dialogue: 0,0:16:12.68,0:16:13.51,Default,,0,0,0,,Және…
Dialogue: 0,0:16:14.55,0:16:18.31,Default,,0,0,0,,Бұл жазуды алғаш ашқан адам 12 жасар...
Dialogue: 0,0:16:19.72,0:16:20.77,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:16:21.18,0:16:22.14,Default,,0,0,0,,Га
Dialogue: 0,0:16:27.77,0:16:28.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:32.03,0:16:33.90,Default,,0,0,0,,(Ино) Бұл соңғы кезде Шығыс Одақтың жастары арасында өте танымал ғылыми-фантастикалық сахна —
Dialogue: 0,0:16:38.12,0:16:38.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:48.54,0:16:49.50,Default,,0,0,0,,(Суралған қылыштың дыбысы)
Dialogue: 0,0:17:28.67,0:17:32.25,Default,,0,0,0,,Мен ұрлаған қолыммен қанша адамды өлтірдім?
Dialogue: 0,0:17:36.22,0:17:37.05,Default,,0,0,0,,Әй?
Dialogue: 0,0:17:43.02,0:17:46.89,Default,,0,0,0,,Мен ұрланған көздерден қанша қан көрдім?
Dialogue: 0,0:17:55.15,0:17:59.74,Default,,0,0,0,,Сол ұрланған аяқпен қанша күнәдан құтылдың?
Dialogue: 0,0:18:00.95,0:18:02.03,Default,,0,0,0,,Сондықтан мен бақылауға тырысуды тоқтаттым — бұл жүз пайыздық бар күшімді салған шабуыл.
Dialogue: 0,0:18:04.29,0:18:10.38,Default,,0,0,0,,(ғибадатхананың құлаған дыбысы)
Dialogue: 0,0:18:11.84,0:18:13.05,Default,,0,0,0,,Не?
Dialogue: 0,0:18:35.03,0:18:36.82,Default,,0,0,0,,Жоқ... жоқ!
Dialogue: 0,0:18:37.90,0:18:39.03,Default,,0,0,0,,Мені өлтірме, Куроба!
Dialogue: 0,0:18:40.53,0:18:41.57,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:18:41.91,0:18:42.78,Default,,0,0,0,,Га
Dialogue: 0,0:18:51.71,0:18:52.84,Default,,0,0,0,,Бұл...
Dialogue: 0,0:18:54.34,0:18:55.21,Default,,0,0,0,,Ах
Dialogue: 0,0:18:56.42,0:18:57.26,Default,,0,0,0,,Юна...
Dialogue: 0,0:18:57.76,0:18:58.97,Default,,0,0,0,,Маған кездейсоқ қоңырау шалмаңыз!
Dialogue: 0,0:19:04.60,0:19:06.47,Default,,0,0,0,,Өтеу уақыты келді
Dialogue: 0,0:19:09.06,0:19:10.27,Default,,0,0,0,,Эй!
Dialogue: 0,0:19:15.86,0:19:17.03,Default,,0,0,0,,Хаа…
Dialogue: 0,0:19:19.40,0:19:21.53,Default,,0,0,0,,Бұл менмін... Юна
Dialogue: 0,0:19:24.12,0:19:26.45,Default,,0,0,0,,Сіз! Мен өлтірдім!
Dialogue: 0,0:19:27.66,0:19:29.62,Default,,0,0,0,,Екеуің таңдай беріңдер.
Dialogue: 0,0:19:30.62,0:19:36.00,Default,,0,0,0,,Сен менің барлық достарымды, Фаура Бланканың адамдарын өлтірдің.
Dialogue: 0,0:19:36.21,0:19:37.21,Default,,0,0,0,,Га
Dialogue: 0,0:19:37.80,0:19:40.26,Default,,0,0,0,,Сізді сүйіктіңіз өлтіреді ме?
Dialogue: 0,0:19:40.34,0:19:42.43,Default,,0,0,0,,Мен сені ешқашан кешірмеймін!
Dialogue: 0,0:19:42.55,0:19:45.22,Default,,0,0,0,,Сүйіктіңді өлтірер ме едің?
Dialogue: 0,0:19:45.80,0:19:47.31,Default,,0,0,0,,Жоқ, Юна...
Dialogue: 0,0:19:47.47,0:19:48.43,Default,,0,0,0,,Шулы!
Dialogue: 0,0:19:48.56,0:19:49.56,Default,,0,0,0,,Юна...
Dialogue: 0,0:19:53.27,0:19:54.19,Default,,0,0,0,,Уақыт келді
Dialogue: 0,0:19:54.52,0:19:57.11,Default,,0,0,0,,(тақталардың құлаған дыбысы)
Dialogue: 0,0:20:05.37,0:20:06.28,Default,,0,0,0,,Әй?
Dialogue: 0,0:20:06.41,0:20:07.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:14.33,0:20:16.59,Default,,0,0,0,,Бұл соңы
Dialogue: 0,0:20:16.96,0:20:18.80,Default,,0,0,0,,Ах... уф
Dialogue: 0,0:20:22.22,0:20:23.34,Default,,0,0,0,,Юна...
Dialogue: 0,0:20:29.56,0:20:31.48,Default,,0,0,0,,Таптым хаха
Dialogue: 0,0:20:36.94,0:20:40.90,Default,,0,0,0,,«Канопус жарқыраған кезде: Құдайдың уылдырығы»
Dialogue: 0,0:20:41.32,0:20:43.20,Default,,0,0,0,,«Оң жақтағы жаңа бірінші»
Dialogue: 0,0:20:43.99,0:20:48.41,Default,,0,0,0,,«Таза қауырсынның қауырсыны, қазіргі адамдарды құрту».
Dialogue: 0,0:20:48.87,0:20:53.33,Default,,0,0,0,,«Қаңқаның айқайы заңға тәртіп әкеледі».
Dialogue: 0,0:20:55.21,0:20:57.42,Default,,0,0,0,,Ах… Ах…
Dialogue: 0,0:21:04.84,0:21:10.76,Default,,0,0,0,,«Сол жақта басқа күш, зұлым қырғын тізбегі».
Dialogue: 0,0:21:11.31,0:21:14.23,Default,,0,0,0,,«Шураның айы мәңгілік эллипсті салады».
Dialogue: 0,0:21:14.89,0:21:18.48,Default,,0,0,0,,«Жақында сұр айдаһар қанаттарын қағады».
Dialogue: 0,0:21:19.23,0:21:22.73,Default,,0,0,0,,«Қара сүйектер, жиналыңдар!»
Dialogue: 0,0:21:26.28,0:21:29.12,Default,,0,0,0,,Бұл... Куу?
Dialogue: 0,0:21:47.72,0:21:48.68,Default,,0,0,0,,Куробане...
Dialogue: 0,0:21:51.97,0:21:55.68,Default,,0,0,0,,Сіз қайда болдыңыз? Мен күттім...
Dialogue: 0,0:21:56.31,0:21:57.31,Default,,0,0,0,,Ха!
Dialogue: 0,0:22:00.48,0:22:01.36,Default,,0,0,0,,Ах!
Dialogue: 0,0:22:04.36,0:22:05.36,Default,,0,0,0,,Уф...
Dialogue: 0,0:22:14.41,0:22:18.58,Default,,0,0,0,,Ааа... аааа!
Dialogue: 0,0:22:20.29,0:22:23.30,Default,,0,0,0,,Уау!
Dialogue: 0,0:22:24.46,0:22:30.47,Default,,0,0,0,,♪〜
Dialogue: 0,0:24:16.03,0:24:22.04,Default,,0,0,0,,〜♪
Dialogue: 0,0:24:23.54,0:24:29.54,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory