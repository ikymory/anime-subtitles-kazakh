Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:11.01,Default,,0,0,0,,NETFLIX түпнұсқа сериясы
Dialogue: 0,0:00:17.89,0:00:19.47,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:00:25.60,0:00:27.15,Default,,0,0,0,,Балалар сендер кімсіңдер?
Dialogue: 0,0:00:27.44,0:00:28.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:33.53,0:00:36.11,Default,,0,0,0,,Дауысы бар нәрсе, періште сияқты
Dialogue: 0,0:00:36.78,0:00:39.16,Default,,0,0,0,,Қатаң естілетін маған тиесілі
Dialogue: 0,0:00:39.70,0:00:41.87,Default,,0,0,0,,Ешқашан мастық пен қаруды шақырмаңыз
Dialogue: 0,0:00:42.37,0:00:44.04,Default,,0,0,0,,Мың тармақталу есептері
Dialogue: 0,0:00:44.46,0:00:45.71,Default,,0,0,0,,Керемет жеңіл (Куроба) Сіздің де қызыңыз бар ма?
Dialogue: 0,0:00:45.92,0:00:47.25,Default,,0,0,0,,Бұл бұрылысты біліңіз
Dialogue: 0,0:00:47.71,0:00:50.34,Default,,0,0,0,,Толқындар және шөптесін тұқымдастар...
Dialogue: 0,0:00:52.38,0:00:55.55,Default,,0,0,0,,Сосын көктің ұлы сияқты тағы бір дауыс шықты.
Dialogue: 0,0:01:05.98,0:01:11.98,Default,,0,0,0,,♪〜
Dialogue: 0,0:01:14.78,0:01:20.78,Default,,0,0,0,,〜♪
Dialogue: 0,0:01:43.01,0:01:45.48,Default,,0,0,0,,Эй Эрик, өтетін жерде қозғалыс бар...
Dialogue: 0,0:01:45.56,0:01:46.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:46.94,0:01:49.81,Default,,0,0,0,,Сәлем! Не... Не!? Эй, итерме!
Dialogue: 0,0:01:49.90,0:01:52.65,Default,,0,0,0,,Ах! Ауырды...
Dialogue: 0,0:01:53.69,0:01:55.69,Default,,0,0,0,,Сіз қандайсыз! Ах!
Dialogue: 0,0:01:55.94,0:01:58.61,Default,,0,0,0,,Ge... Geni! Сіздің лицензияңыз қайта жазылды...
Dialogue: 0,0:01:58.74,0:02:02.20,Default,,0,0,0,,Ариарарья... Эй! Қайда бара жатырсың?
Dialogue: 0,0:02:02.28,0:02:03.91,Default,,0,0,0,,Сәлем! Қайда...
Dialogue: 0,0:02:12.92,0:02:14.67,Default,,0,0,0,,Егер бұлай болса, менің мұны істеуден басқа амалым жоқ...
Dialogue: 0,0:02:15.17,0:02:18.30,Default,,0,0,0,,Эй, сен не айтып тұрсың? Мұны істеуге ешқандай мүмкіндік жоқ.
Dialogue: 0,0:02:18.38,0:02:19.72,Default,,0,0,0,,Сонымен не істейміз?
Dialogue: 0,0:02:21.09,0:02:22.97,Default,,0,0,0,,Барлығыңыз тынышталыңыздар.
Dialogue: 0,0:02:23.64,0:02:27.02,Default,,0,0,0,,Қазіргі уақытта біз, Корольдік Констабулярлық қауіпті материалдар отряды,
Dialogue: 0,0:02:27.10,0:02:30.69,Default,,0,0,0,,Біз жағдайға жауап бергенше біраз күтіңіз.
Dialogue: 0,0:02:31.31,0:02:33.44,Default,,0,0,0,,Содан бері айтып жүргенің осы ғана!
Dialogue: 0,0:02:33.52,0:02:35.78,Default,,0,0,0,,Не болып жатқанын түсіндіріңіз!
Dialogue: 0,0:02:36.99,0:02:37.82,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:38.78,0:02:40.03,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:02:40.16,0:02:41.91,Default,,0,0,0,,Айтсаңыз да
Dialogue: 0,0:02:42.41,0:02:44.66,Default,,0,0,0,,Бұл жағдайда мен ештеңе істей алмаймын...
Dialogue: 0,0:02:44.74,0:02:47.20,Default,,0,0,0,,Балалар, шынымен де жақсысыңдар деп үміттенемін.
Dialogue: 0,0:02:47.29,0:02:49.37,Default,,0,0,0,,(Қызылдың күлкісі)
Dialogue: 0,0:02:49.46,0:02:51.88,Default,,0,0,0,,шіркін шынымен ұсқынсыз
Dialogue: 0,0:02:51.96,0:02:54.84,Default,,0,0,0,,Өлім барған сайын жақындаса да
Dialogue: 0,0:02:55.59,0:02:57.80,Default,,0,0,0,,Мен сендерден ерекшемін
Dialogue: 0,0:02:58.30,0:02:59.38,Default,,0,0,0,,Бұл ерекше!
Dialogue: 0,0:03:00.43,0:03:03.55,Default,,0,0,0,,Тарихта қорқыныштың белгісі болып қалатын адам
Dialogue: 0,0:03:03.93,0:03:06.64,Default,,0,0,0,,Өлімді мақтанышпен қабылдаңыз!
Dialogue: 0,0:03:06.76,0:03:09.77,Default,,0,0,0,,(Қызылдың күлкісі)
Dialogue: 0,0:03:12.02,0:03:13.35,Default,,0,0,0,,Дәлдіктің болмауы
Dialogue: 0,0:03:13.56,0:03:15.52,Default,,0,0,0,,Код нашар құрастырылған
Dialogue: 0,0:03:15.77,0:03:18.65,Default,,0,0,0,,Техникалық қабілеттілік 1 Техникалық шарттарды плагиат
Dialogue: 0,0:03:19.03,0:03:22.32,Default,,0,0,0,,Маймылдарға еліктеу Нөлдік түпнұсқа
Dialogue: 0,0:03:22.74,0:03:26.20,Default,,0,0,0,,Шабуыл күші мен қорғаныс күші екеуі де 1 Баға D
Dialogue: 0,0:03:27.70,0:03:30.16,Default,,0,0,0,,Үшінші деңгейлі зиянды бағдарлама пайдаланушысы?
Dialogue: 0,0:03:30.29,0:03:32.50,Default,,0,0,0,,Бұл үлкен мәселе емес. Егер бұл ...
Dialogue: 0,0:03:34.79,0:03:36.50,Default,,0,0,0,,2700 секунд қалды
Dialogue: 0,0:03:36.92,0:03:40.26,Default,,0,0,0,,Мен оны үш рет ұрсам да, әлі уақыт бар.
Dialogue: 0,0:03:42.18,0:03:45.60,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:03:55.40,0:03:56.23,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:01.53,0:04:03.53,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:04:05.87,0:04:08.33,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:04:13.50,0:04:16.29,Default,,0,0,0,,Қатаң естілетін маған тиесілі
Dialogue: 0,0:04:17.00,0:04:19.09,Default,,0,0,0,,Және жоқ жерден ән айт
Dialogue: 0,0:04:19.55,0:04:20.67,Default,,0,0,0,,Күлсінгендей
Dialogue: 0,0:04:21.21,0:04:24.01,Default,,0,0,0,,Қатты байдың жалғыздығы
Dialogue: 0,0:04:24.18,0:04:26.72,Default,,0,0,0,,Дүние ізгіліксіз дейсің бе?
Dialogue: 0,0:04:27.80,0:04:29.43,Default,,0,0,0,,Сіз таң қалдыңыз ба?
Dialogue: 0,0:04:46.61,0:04:47.99,Default,,0,0,0,,Король түсті
Dialogue: 0,0:04:48.32,0:04:50.37,Default,,0,0,0,,Әкемнің бейітіне аудитория жинаңыз
Dialogue: 0,0:05:14.73,0:05:16.06,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:17.15,0:05:18.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:18.77,0:05:20.82,Default,,0,0,0,,Уф... ой...!
Dialogue: 0,0:05:23.40,0:05:25.40,Default,,0,0,0,,Уау... аа...
Dialogue: 0,0:05:26.78,0:05:28.36,Default,,0,0,0,,Ах... уф... а...
Dialogue: 0,0:05:29.03,0:05:30.07,Default,,0,0,0,,Эй, бұл жаман.
Dialogue: 0,0:05:30.66,0:05:34.00,Default,,0,0,0,,Әй... өтірік айтасың, қарғыс атсын!
Dialogue: 0,0:05:34.45,0:05:38.92,Default,,0,0,0,,Түсіндім, қара аққу жоспарланғандай ұшып кетті.
Dialogue: 0,0:05:39.33,0:05:42.96,Default,,0,0,0,,Сайқымазақтардың да кетуін сұрайық.
Dialogue: 0,0:05:44.21,0:05:46.59,Default,,0,0,0,,Әй, осылай жүре берсең, шыбын жейді.
Dialogue: 0,0:05:46.97,0:05:49.43,Default,,0,0,0,,Уақыт келді, мұны аяқтай аламыз ба?
Dialogue: 0,0:05:49.76,0:05:50.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:51.30,0:05:53.10,Default,,0,0,0,,Бұл жерде нақты нәрсе.
Dialogue: 0,0:05:53.31,0:05:55.89,Default,,0,0,0,,Мен қазір қашуға дайындалуым керек! Сіз тыңдайсыз ба?
Dialogue: 0,0:05:55.98,0:05:57.81,Default,,0,0,0,,Уау...!
Dialogue: 0,0:05:59.90,0:06:04.28,Default,,0,0,0,,Қауіпті байқай алмау – біздің тірі жаратылыс ретінде нашарлағанымыздың дәлелі.
Dialogue: 0,0:06:05.23,0:06:06.24,Default,,0,0,0,,Қош бол
Dialogue: 0,0:06:06.36,0:06:11.62,Default,,0,0,0,,(Етті аралаудың дыбысы)
Dialogue: 0,0:06:14.16,0:06:14.99,Default,,0,0,0,,Ах...!
Dialogue: 0,0:06:15.87,0:06:16.70,Default,,0,0,0,,тоқтатылды
Dialogue: 0,0:06:20.79,0:06:22.71,Default,,0,0,0,,Қарсы шабуыл тоқтатылды.
Dialogue: 0,0:06:23.88,0:06:26.05,Default,,0,0,0,,Жеңілгенін түсініп, шегінуге дайындалуда?
Dialogue: 0,0:06:26.71,0:06:29.68,Default,,0,0,0,,Жоқ, мен ондай адам емеспін.
Dialogue: 0,0:06:30.34,0:06:33.72,Default,,0,0,0,,Бізді ғимаратқа итермелейтін тұзақ па?
Dialogue: 0,0:06:33.93,0:06:37.85,Default,,0,0,0,,Бұл жай ғана адамдарды шатастырып, баяулататын тактика ма?
Dialogue: 0,0:06:38.35,0:06:41.27,Default,,0,0,0,,Қарсы тарап күтпеген жағдайға тап болды ма?
Dialogue: 0,0:06:42.98,0:06:44.27,Default,,0,0,0,,...
Dialogue: 0,0:06:45.27,0:06:48.28,Default,,0,0,0,,Қалай болғанда да қазіргі жағдайдың таңдауы да, шығу жолы да жоқ.
Dialogue: 0,0:06:48.86,0:06:50.78,Default,,0,0,0,,Жүктегеннен кейін әр жолы өңдеңіз.
Dialogue: 0,0:06:51.41,0:06:53.24,Default,,0,0,0,,Жан, мені өңдеу тобына қос.
Dialogue: 0,0:06:53.32,0:06:54.16,Default,,0,0,0,,О
Dialogue: 0,0:07:14.18,0:07:15.56,Default,,0,0,0,,Ол ашық. (Әйел) Рахмет.
Dialogue: 0,0:07:16.26,0:07:18.02,Default,,0,0,0,,Бұл осында. Маған хабарласыңыз.
Dialogue: 0,0:07:20.89,0:07:23.90,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:07:23.98,0:07:25.73,Default,,0,0,0,,Эрик Каэладан.
Dialogue: 0,0:07:26.02,0:07:27.53,Default,,0,0,0,,Мені шешен етіңіз
Dialogue: 0,0:07:31.82,0:07:32.66,Default,,0,0,0,,Эрик
Dialogue: 0,0:07:32.86,0:07:34.24,Default,,0,0,0,,Каэла Эрик.
Dialogue: 0,0:07:34.62,0:07:35.70,Default,,0,0,0,,Ол динамик ретінде орнатылған.
Dialogue: 0,0:07:36.12,0:07:39.08,Default,,0,0,0,,Бөлмеде Жан мен Эббот Броди.
Dialogue: 0,0:07:39.50,0:07:41.21,Default,,0,0,0,,Мәселе болмаса, тыңдаңыз
Dialogue: 0,0:07:42.04,0:07:44.50,Default,,0,0,0,,Билл жүйесі сәтті қалпына келтірілді
Dialogue: 0,0:07:45.13,0:07:48.17,Default,,0,0,0,,Жақсы жұмыс. Улы газдың қайда екенін білуді жалғастырыңыз.
Dialogue: 0,0:07:48.25,0:07:51.38,Default,,0,0,0,,Мен мұны істеп жатырмын, бірақ мені алаңдататын бір нәрсе бар ...
Dialogue: 0,0:07:51.47,0:07:52.63,Default,,0,0,0,,Иә?Не?
Dialogue: 0,0:07:53.68,0:07:55.68,Default,,0,0,0,,Жүйеге шабуыл жасау кезінде
Dialogue: 0,0:07:55.76,0:07:58.85,Default,,0,0,0,,Қылмыскер бірнеше рет күзетілген.
Dialogue: 0,0:07:59.22,0:08:01.35,Default,,0,0,0,,... кенет тоқтады.
Dialogue: 0,0:08:01.81,0:08:02.89,Default,,0,0,0,,Ол тоқтады ма?
Dialogue: 0,0:08:03.52,0:08:06.23,Default,,0,0,0,,Хмм... Бұл қақпан ба?
Dialogue: 0,0:08:24.67,0:08:26.50,Default,,0,0,0,,Иә! (Адам) Бұл газ!
Dialogue: 0,0:08:27.38,0:08:28.21,Default,,0,0,0,,Қаш!
Dialogue: 0,0:08:29.59,0:08:31.51,Default,,0,0,0,,(Зеницу) Незуко-чан, Танжиро~ (Танжиро) Тоқтат! Зенцу!
Dialogue: 0,0:08:34.59,0:08:35.43,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:08:36.97,0:08:38.72,Default,,0,0,0,,Марио күйінің есебі!
Dialogue: 0,0:08:39.60,0:08:41.35,Default,,0,0,0,,Жауап беріңіз! Кез келген адам жақсы!
Dialogue: 0,0:08:42.18,0:08:45.48,Default,,0,0,0,,Брэндон! Лилия! Ешкім жауап бермейді ме?
Dialogue: 0,0:08:48.90,0:08:50.23,Default,,0,0,0,,О, құдайым...
Dialogue: 0,0:08:50.65,0:08:51.78,Default,,0,0,0,,Қат!
Dialogue: 0,0:08:52.36,0:08:53.69,Default,,0,0,0,,Ах! Каэла!
Dialogue: 0,0:08:54.70,0:08:58.16,Default,,0,0,0,,Егер сіз ауаны баптау жүйесін басқарсаңыз және ауа ағынын басқарсаңыз,
Dialogue: 0,0:08:58.57,0:09:02.12,Default,,0,0,0,,Сіз газды адам тұрмайтын жерге апаруыңыз керек. Жаса!
Dialogue: 0,0:09:02.95,0:09:06.17,Default,,0,0,0,,Ауа өткізбейтін бөлмелер оттегісіз болуы мүмкін
Dialogue: 0,0:09:06.37,0:09:08.46,Default,,0,0,0,,Егер біреу қалса, олар...
Dialogue: 0,0:09:08.63,0:09:12.05,Default,,0,0,0,,Ең алдымен, газ! Мен жауапкершілікті аламын! Әр сәт үшін күрес!
Dialogue: 0,0:09:12.38,0:09:13.21,Default,,0,0,0,,Жүгір!
Dialogue: 0,0:09:13.42,0:09:14.26,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:09:24.06,0:09:24.89,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:26.48,0:09:29.90,Default,,0,0,0,,Дзепполе... Ди... Дзеппе...
Dialogue: 0,0:09:44.20,0:09:47.62,Default,,0,0,0,,Борис, сен қайдасың? Кит де сенімен бірге ме?
Dialogue: 0,0:09:49.83,0:09:52.75,Default,,0,0,0,,Ору! 8-маршрутпен солтүстікке барыңыз!
Dialogue: 0,0:09:53.09,0:09:55.38,Default,,0,0,0,,8-маршрут? Неліктен мұндай орын?
Dialogue: 0,0:09:55.46,0:09:58.22,Default,,0,0,0,,Білмеймін... Мен де білмеймін. Мен Киттен сұраймын...
Dialogue: 0,0:09:58.76,0:10:02.51,Default,,0,0,0,,Иә! Ахх! Апыр-ай!
Dialogue: 0,0:10:07.31,0:10:09.23,Default,,0,0,0,,Кит! Бұл төтенше жағдай
Dialogue: 0,0:10:09.52,0:10:10.94,Default,,0,0,0,,Дереу оралыңыз.
Dialogue: 0,0:10:11.90,0:10:14.03,Default,,0,0,0,,Мұнараның ішінде газ шашыранды
Dialogue: 0,0:10:14.11,0:10:17.07,Default,,0,0,0,,Жоқ! Нанана... Не?!
Dialogue: 0,0:10:17.15,0:10:20.36,Default,,0,0,0,,Біз қазір ішіндегілермен байланыса алмаймыз.
Dialogue: 0,0:10:20.62,0:10:22.24,Default,,0,0,0,,Geni Мен қайтып келдім!
Dialogue: 0,0:10:22.33,0:10:23.45,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:10:23.53,0:10:24.54,Default,,0,0,0,,Сонымен...!
Dialogue: 0,0:10:26.04,0:10:27.62,Default,,0,0,0,,Эрик, бұл жаман, мен мұны саған қалдырамын.
Dialogue: 0,0:10:27.96,0:10:31.08,Default,,0,0,0,,Не айтайын деп тұрсың, ақымақ! Олардың қатарында Лили және басқалары бар...
Dialogue: 0,0:10:31.38,0:10:32.79,Default,,0,0,0,,Егер шашыратылса...
Dialogue: 0,0:10:34.09,0:10:37.59,Default,,0,0,0,,Егер шашылған болса, газ жалған.
Dialogue: 0,0:10:37.97,0:10:39.97,Default,,0,0,0,,Оқиға орнын бұзу үшін босату
Dialogue: 0,0:10:40.55,0:10:42.01,Default,,0,0,0,,Уақытты сатып алу үшін
Dialogue: 0,0:10:42.18,0:10:43.93,Default,,0,0,0,,Мүмкін қашу үшін
Dialogue: 0,0:10:44.60,0:10:45.43,Default,,0,0,0,,Неге негіз болып табылады?
Dialogue: 0,0:10:45.89,0:10:46.72,Default,,0,0,0,,Сіз оны көрдіңіз бе?
Dialogue: 0,0:10:47.10,0:10:50.65,Default,,0,0,0,,Кінәлі – ойы қысқа, әрі жетілмеген нарциссист.
Dialogue: 0,0:10:51.19,0:10:53.52,Default,,0,0,0,,Басқаша айтқанда, нәзік эстетикаға мас болу —
Dialogue: 0,0:10:53.61,0:10:55.36,Default,,0,0,0,,Өзімшілдік
Dialogue: 0,0:10:55.57,0:10:57.44,Default,,0,0,0,,Бұл туралы сөйлесейік.
Dialogue: 0,0:10:57.86,0:11:01.95,Default,,0,0,0,,Өлім де нарциссисттің жеке романындағы маңызды фактор болып табылады.
Dialogue: 0,0:11:03.16,0:11:05.62,Default,,0,0,0,,Эрозиялық модификацияланған газбен күресу
Dialogue: 0,0:11:05.70,0:11:07.75,Default,,0,0,0,,Өртеніп өлді
Dialogue: 0,0:11:09.00,0:11:11.08,Default,,0,0,0,,Олар қабылдайды деп ойлайсыз ба?
Dialogue: 0,0:11:11.46,0:11:14.84,Default,,0,0,0,,Өткен профильге қараңыз... Ешбір.
Dialogue: 0,0:11:16.46,0:11:19.76,Default,,0,0,0,,Мүмкін, бірақ мұның бәрі болжам.
Dialogue: 0,0:11:20.34,0:11:23.68,Default,,0,0,0,,Қазіргі уақытта біз ішіндегі адамдармен байланыса алмаймыз.
Dialogue: 0,0:11:23.76,0:11:26.51,Default,,0,0,0,,Онда бұл гипноздық газ, жарай ма Эрик?
Dialogue: 0,0:11:27.43,0:11:30.73,Default,,0,0,0,,Бұл іс пен IFV тонау ісі бірдей құрылымға ие.
Dialogue: 0,0:11:31.69,0:11:36.36,Default,,0,0,0,,Ақымақ бидің артында күрделі білім басқа мақсатқа қызмет етеді.
Dialogue: 0,0:11:37.15,0:11:43.36,Default,,0,0,0,,Басқаша айтқанда, кездейсоқ қылмыстарды паразиттендіретін және жоспарланған қылмыстарды жасайтын топ бар.
Dialogue: 0,0:11:44.20,0:11:49.04,Default,,0,0,0,,Мүмкін, тіпті кездейсоқ болып көрінетін қылмыстар да жоспарланып, қолдан жасалуы мүмкін.
Dialogue: 0,0:11:49.95,0:11:52.67,Default,,0,0,0,,Бұдан былай болатын жындылық тізбегі
Dialogue: 0,0:11:53.54,0:11:54.79,Default,,0,0,0,,Жауап кестеде жоқ
Dialogue: 0,0:11:55.96,0:11:57.50,Default,,0,0,0,,Әрқашан артқы жағында
Dialogue: 0,0:11:59.00,0:12:02.01,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:12:04.14,0:12:05.18,Default,,0,0,0,,(Серо) «Өте жылдам адам» деген лақап ат тек сән үшін ғана емес қой?
Dialogue: 0,0:12:05.68,0:12:08.68,Default,,0,0,0,,Камуи қоқыс жасауға қатты қуанады.
Dialogue: 0,0:12:09.39,0:12:11.18,Default,,0,0,0,,Олар бақытты
Dialogue: 0,0:12:11.27,0:12:13.06,Default,,0,0,0,,Сол сұмдық өмір
Dialogue: 0,0:12:13.14,0:12:16.56,Default,,0,0,0,,Мен оны өз жұмысым деп аяқтадым.
Dialogue: 0,0:12:17.06,0:12:19.48,Default,,0,0,0,,Соңына дейін ақымақ болып қала бермей ме?
Dialogue: 0,0:12:19.57,0:12:20.40,Default,,0,0,0,,Хмм…
Dialogue: 0,0:12:21.24,0:12:23.95,Default,,0,0,0,,Камуи, сен өз мақсатыңды ұмытпадың.
Dialogue: 0,0:12:24.57,0:12:27.58,Default,,0,0,0,,Әрине, бұл жай ғана ойын-сауық.
Dialogue: 0,0:12:27.70,0:12:30.04,Default,,0,0,0,,Мақсатыма ойдағыдай жеттім.
Dialogue: 0,0:12:33.62,0:12:35.71,Default,,0,0,0,,Ол әлі мұнда емес.
Dialogue: 0,0:12:36.29,0:12:38.42,Default,,0,0,0,,Әңгімені қорытындыламау.
Dialogue: 0,0:12:39.25,0:12:40.38,Default,,0,0,0,,Бұл жаман әдет.
Dialogue: 0,0:12:41.13,0:12:42.30,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:12:42.59,0:12:43.80,Default,,0,0,0,,Сәлем Минадзуки
Dialogue: 0,0:12:44.05,0:12:47.34,Default,,0,0,0,,Қара қауырсындардың патшасын қайтаруымыз керек пе?
Dialogue: 0,0:12:48.01,0:12:49.93,Default,,0,0,0,,Өйткені бұл бұйрық.
Dialogue: 0,0:12:50.89,0:12:53.18,Default,,0,0,0,,Мен өмір сүруім керек пе?
Dialogue: 0,0:12:59.77,0:13:01.61,Default,,0,0,0,,Тірі болсаң жақсы.
Dialogue: 0,0:13:14.16,0:13:17.42,Default,,0,0,0,,Құдайдың күндеріне қош келдіңіз
Dialogue: 0,0:13:18.71,0:13:23.30,Default,,0,0,0,,Қазан айында бірнеше күн бойы Ренан көлі Құдай Патшалығының есігі болады.
Dialogue: 0,0:13:24.26,0:13:26.30,Default,,0,0,0,,Қараңғыда жан билейді
Dialogue: 0,0:13:26.76,0:13:29.76,Default,,0,0,0,,(көлде серуендеу дыбысы)
Dialogue: 0,0:13:34.43,0:13:38.56,Default,,0,0,0,,Оны әдемі деп ойламайсың ба? қараңғыда сансыз жарықтар
Dialogue: 0,0:13:39.98,0:13:41.73,Default,,0,0,0,,Маған бұл жер ұнайды
Dialogue: 0,0:13:42.65,0:13:44.57,Default,,0,0,0,,Аз ғана жарық
Dialogue: 0,0:13:44.82,0:13:47.99,Default,,0,0,0,,Қараңғыда қалтырап, адаспаймын.
Dialogue: 0,0:13:48.66,0:13:50.95,Default,,0,0,0,,Бұл нені білдіретінін білесіз бе?
Dialogue: 0,0:13:52.24,0:13:53.49,Default,,0,0,0,,Жарық – үміт
Dialogue: 0,0:13:54.08,0:13:57.87,Default,,0,0,0,,Мен бос сөзбен айналысқым келмейді. Ол қайда?
Dialogue: 0,0:13:58.08,0:14:00.50,Default,,0,0,0,,Жауап бергің келмесе, мен сені өлтіремін!
Dialogue: 0,0:14:01.42,0:14:03.38,Default,,0,0,0,,Бұл өте қарапайым, солай емес пе?
Dialogue: 0,0:14:04.00,0:14:06.38,Default,,0,0,0,,Ол... жеңіл
Dialogue: 0,0:14:07.05,0:14:10.64,Default,,0,0,0,,Тіпті бұл жады бұлыңғыр, солай емес пе? Мен білемін
Dialogue: 0,0:14:10.80,0:14:13.39,Default,,0,0,0,,Сіз де өзіңізді шынымен түсінбейсіз.
Dialogue: 0,0:14:14.10,0:14:17.52,Default,,0,0,0,,Сол себепті сен қатты айқайлап жатырсың, мен оны естимін
Dialogue: 0,0:14:18.35,0:14:21.73,Default,,0,0,0,,Мен осындамын! Мен мындамын!
Dialogue: 0,0:14:22.31,0:14:25.61,Default,,0,0,0,,Мен тірімін! Біреуді табыңыз!
Dialogue: 0,0:14:28.32,0:14:31.32,Default,,0,0,0,,(Изанамидің күлкісі)
Dialogue: 0,0:14:32.41,0:14:35.41,Default,,0,0,0,,(lol)
Dialogue: 0,0:14:36.37,0:14:40.62,Default,,0,0,0,,Өкінішке орай, бұл жерде біз және өлгендердің рухтары ғана.
Dialogue: 0,0:14:41.67,0:14:46.38,Default,,0,0,0,,Арамызда мен ғана сенімен аз ғана уақыт болдым.
Dialogue: 0,0:14:46.76,0:14:49.13,Default,,0,0,0,,Менің сен үшін өмір сүруге уақытым болды
Dialogue: 0,0:14:51.14,0:14:53.22,Default,,0,0,0,,Біз бұл жарықты бірге көрдік.
Dialogue: 0,0:14:53.85,0:14:58.23,Default,,0,0,0,,Сондықтан мен сізді еске түсіру үшін осында шақырдым.
Dialogue: 0,0:15:11.49,0:15:17.16,Default,,0,0,0,,Ааааааааа, менің әлсіз үмітім үзілді... Шамасы?
Dialogue: 0,0:15:19.16,0:15:20.58,Default,,0,0,0,,Мен ойладым
Dialogue: 0,0:15:20.71,0:15:23.54,Default,,0,0,0,,Қызық, сіздің естеліктеріңізді кім басып тастады?
Dialogue: 0,0:15:32.43,0:15:36.06,Default,,0,0,0,,А... Мен түсіндім.
Dialogue: 0,0:15:38.97,0:15:40.73,Default,,0,0,0,,Ол қайда?
Dialogue: 0,0:15:43.65,0:15:48.11,Default,,0,0,0,,Сіздің естеліктеріңізді ешкім жауып тастаған жоқ.
Dialogue: 0,0:15:49.11,0:15:50.28,Default,,0,0,0,,Сіз өзіңіз.
Dialogue: 0,0:15:51.90,0:15:53.86,Default,,0,0,0,,Сіз ұмытқыңыз келді, солай ма?
Dialogue: 0,0:15:55.32,0:15:57.08,Default,,0,0,0,,Сол күні не болды
Dialogue: 0,0:15:58.58,0:16:00.16,Default,,0,0,0,,Барлығы
Dialogue: 0,0:16:02.08,0:16:02.92,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:16:05.42,0:16:09.30,Default,,0,0,0,,Мен сені ұмытуға жол бермеймін
Dialogue: 0,0:16:10.97,0:16:16.18,Default,,0,0,0,,Мені таңдамағаныңды ешқашан кешірмеймін!
Dialogue: 0,0:16:19.89,0:16:22.31,Default,,0,0,0,,Қайда? Сіз бұл жерді білесіз бе?
Dialogue: 0,0:16:24.73,0:16:27.02,Default,,0,0,0,,Маған айта аласыз ба?
Dialogue: 0,0:16:27.77,0:16:30.40,Default,,0,0,0,,Біз нені қуып келеміз?
Dialogue: 0,0:16:31.86,0:16:33.82,Default,,0,0,0,,Маған қызық, бұл не?
Dialogue: 0,0:16:34.53,0:16:36.91,Default,,0,0,0,,Мен оны қууым керек.
Dialogue: 0,0:16:37.57,0:16:40.24,Default,,0,0,0,,Сонымен бұл не?
Dialogue: 0,0:16:41.45,0:16:43.75,Default,,0,0,0,,Менің де білгім келеді
Dialogue: 0,0:17:38.47,0:17:40.01,Default,,0,0,0,,Хаха...
Dialogue: 0,0:17:50.44,0:17:55.32,Default,,0,0,0,,Сол аяғымды кесіп таста. Ол бір күні пайдалы болады.
Dialogue: 0,0:17:59.20,0:18:04.24,Default,,0,0,0,,Canopus түймесін түртіп,...
Dialogue: 0,0:18:06.33,0:18:07.75,Default,,0,0,0,,Канопус...?
Dialogue: 0,0:18:13.67,0:18:15.30,Default,,0,0,0,,Хмм... мм
Dialogue: 0,0:18:16.42,0:18:17.97,Default,,0,0,0,,Ух... иә...
Dialogue: 0,0:18:18.51,0:18:20.01,Default,,0,0,0,,Маған атыңызды айта аласыз ба?
Dialogue: 0,0:18:20.34,0:18:24.10,Default,,0,0,0,,Сан Джузеппе дзепполесі
Dialogue: 0,0:18:24.18,0:18:25.68,Default,,0,0,0,,Сіз бұл қай жерде екенін білесіз бе?
Dialogue: 0,0:18:27.10,0:18:28.60,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:18:29.73,0:18:31.61,Default,,0,0,0,,Ха! Ахх!
Dialogue: 0,0:18:34.86,0:18:36.99,Default,,0,0,0,,Хаа… хаа…
Dialogue: 0,0:18:38.90,0:18:40.53,Default,,0,0,0,,Кенеттен оянуға болмайды
Dialogue: 0,0:18:40.99,0:18:43.70,Default,,0,0,0,,Сіз өзіңізді жайсыз сезінесіз бе немесе басқаша ыңғайсыз ба?
Dialogue: 0,0:18:44.12,0:18:45.41,Default,,0,0,0,,Мұнан кеттік.
Dialogue: 0,0:18:45.49,0:18:48.79,Default,,0,0,0,,Сол кезде газ бүкіл алаңға тарады...
Dialogue: 0,0:18:48.87,0:18:50.92,Default,,0,0,0,,Бұл жай ғана ұйықтататын газ.
Dialogue: 0,0:18:51.00,0:18:54.13,Default,,0,0,0,,Хаа... Бұл жолы мені толық жеңдіңіз.
Dialogue: 0,0:18:55.55,0:18:59.42,Default,,0,0,0,,Сонымен, бұл кінәлінің блефі болды дегенді білдіре ме?
Dialogue: 0,0:18:59.51,0:19:03.64,Default,,0,0,0,,А... жоқ... олай емес сияқты.
Dialogue: 0,0:19:04.10,0:19:05.06,Default,,0,0,0,,Олар қарт адамды шынымен сынап жатыр
Dialogue: 0,0:19:06.81,0:19:11.27,Default,,0,0,0,,Нағыз газ табылды, ол жай ғана пайдаланылмады.
Dialogue: 0,0:19:11.52,0:19:13.48,Default,,0,0,0,,Бірақ... мм?
Dialogue: 0,0:19:14.61,0:19:17.53,Default,,0,0,0,,Оның табылу жолы ерекше.
Dialogue: 0,0:19:21.86,0:19:23.12,Default,,0,0,0,,Ах... уау...
Dialogue: 0,0:19:36.30,0:19:39.09,Default,,0,0,0,,Мен сәл кешігіп қалдым деп ойлаймын.
Dialogue: 0,0:19:54.77,0:19:58.61,Default,,0,0,0,,Қылмыскерлердің қалдықтары, теріден басқа бөліктері табылды
Dialogue: 0,0:19:58.82,0:19:59.74,Default,,0,0,0,,Қайда?
Dialogue: 0,0:19:59.82,0:20:02.20,Default,,0,0,0,,А... Білмегені дұрыс шығар.
Dialogue: 0,0:20:02.40,0:20:05.78,Default,,0,0,0,,Осыны білсең, біраз уақыт тамақ жей алмайтыныңа сенімдімін.
Dialogue: 0,0:20:07.24,0:20:10.29,Default,,0,0,0,,Мен мұны біраз уақыттан бері сезіндім...
Dialogue: 0,0:20:12.75,0:20:15.75,Default,,0,0,0,,Соңғы оқиғалар біртүрлі ме?
Dialogue: 0,0:20:16.84,0:20:21.26,Default,,0,0,0,,Өйткені жағдайлардың ешқайсысы ештеңені шешпейді, солай емес пе?
Dialogue: 0,0:20:22.51,0:20:25.93,Default,,0,0,0,,Мен осы қалада бірдеңе болып жатқандай сезінемін.
Dialogue: 0,0:20:26.64,0:20:30.64,Default,,0,0,0,,Мен ол ерекше байсалды көрінді деп ойладым. Оның айтқысы келгені осы ма?
Dialogue: 0,0:20:31.73,0:20:34.35,Default,,0,0,0,,Сіздің түйсігіңіз дұрыс деп ойлаймын.
Dialogue: 0,0:20:34.81,0:20:36.19,Default,,0,0,0,,Дұрыс айтасыз.
Dialogue: 0,0:20:37.23,0:20:40.15,Default,,0,0,0,,Түйсік сөзі қате атау.
Dialogue: 0,0:20:40.82,0:20:43.53,Default,,0,0,0,,Әрине, бірдеңе болып жатыр
Dialogue: 0,0:20:44.03,0:20:45.82,Default,,0,0,0,,Білсең, тез...
Dialogue: 0,0:20:45.91,0:20:50.16,Default,,0,0,0,,Мен Кремона Корольдігінің Конституциясын адал қорғаймын.
Dialogue: 0,0:20:50.37,0:20:51.87,Default,,0,0,0,,Патша жарлықтарын орындау
Dialogue: 0,0:20:52.25,0:20:56.71,Default,,0,0,0,,Полиция міндеттерін бірінші кезекте орындауды талап етеді...
Dialogue: 0,0:20:58.92,0:21:00.50,Default,,0,0,0,,Еш нәрсеге кедергісіз
Dialogue: 0,0:21:00.59,0:21:03.59,Default,,0,0,0,,Ештеңеден қорықпа, ештеңені жек көрме
Dialogue: 0,0:21:03.72,0:21:05.01,Default,,0,0,0,,Тек ар-ождан бойынша
Dialogue: 0,0:21:07.05,0:21:10.85,Default,,0,0,0,,Патшалықтың және оның бағыныштыларының бостандықтары мен құқықтарын қорғау
Dialogue: 0,0:21:11.27,0:21:15.23,Default,,0,0,0,,Полиция міндеттерін атқаруға салтанатты түрде ант етемін!
Dialogue: 0,0:21:16.56,0:21:21.90,Default,,0,0,0,,Осы ант қабылдаған сәттен бастап сіз бен біз полиция қызметкеріміз.
Dialogue: 0,0:21:22.73,0:21:26.41,Default,,0,0,0,,Сіз алдарыңыздағы істерді бір-бірден шешсеңіз болғаны.
Dialogue: 0,0:21:27.03,0:21:28.91,Default,,0,0,0,,Дәлірек айтсақ, бұл сіздің қолыңыздан келеді.
Dialogue: 0,0:21:30.83,0:21:34.29,Default,,0,0,0,,Бірақ бұл тривиальды нәрсе болуы мүмкін, бірақ жинақтау
Dialogue: 0,0:21:34.58,0:21:38.17,Default,,0,0,0,,Бұл бірдеңенің анықтамасы болуы керек.
Dialogue: 0,0:21:38.83,0:21:40.34,Default,,0,0,0,,Мен сенемін.
Dialogue: 0,0:21:41.50,0:21:44.38,Default,,0,0,0,,Бірақ бұл не нәрсе?
Dialogue: 0,0:21:44.46,0:21:46.68,Default,,0,0,0,,Мен оны қазір түсінбеймін.
Dialogue: 0,0:21:48.47,0:21:49.30,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:21:49.85,0:21:55.27,Default,,0,0,0,,Сондықтан бұл туралы тым көп ойланудың қажеті жоқ... иә?
Dialogue: 0,0:21:58.27,0:22:02.32,Default,,0,0,0,,Жарайды, мен ойлауды доғарамын!
Dialogue: 0,0:22:03.78,0:22:05.99,Default,,0,0,0,,Жоқ! Мұны тоқтатпа!
Dialogue: 0,0:22:11.24,0:22:17.25,Default,,0,0,0,,♪〜
Dialogue: 0,0:24:02.19,0:24:08.19,Default,,0,0,0,,〜♪
