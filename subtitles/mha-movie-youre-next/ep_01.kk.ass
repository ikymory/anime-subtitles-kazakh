Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:31.61,0:00:35.91,Default,,0,0,0,,«Сиркемен өзін-өзі өлтіру оқиғасы»
Dialogue: 0,0:00:40.24,0:00:43.96,Default,,0,0,0,,Білмедім сенің бұлай шіркінге қарсы тұрғаныңды.
Dialogue: 0,0:00:44.08,0:00:46.08,Default,,0,0,0,,Бұл қате есептеу болды
Dialogue: 0,0:00:52.80,0:00:56.76,Default,,0,0,0,,Бұл оған ұқсамайтын кішкене қулық. Бұл біреудің әсері ме?
Dialogue: 0,0:00:57.47,0:00:58.97,Default,,0,0,0,,Біз оның жайлы өте аз білеміз… Бұл не, мырза Ринатаки?
Dialogue: 0,0:00:59.14,0:01:03.43,Default,,0,0,0,,Жарайды, бұл менің жамбасым болмағандықтан болды!
Dialogue: 0,0:01:03.77,0:01:04.73,Default,,0,0,0,,Міне, таптырмас нәрсе! Керемет!
Dialogue: 0,0:01:05.52,0:01:10.69,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:15.32,0:01:18.99,Default,,0,0,0,,Америка Құрама Штаттары...
Dialogue: 0,0:01:19.20,0:01:22.04,Default,,0,0,0,,Соққы!
Dialogue: 0,0:01:41.43,0:01:44.64,Default,,0,0,0,,Жеңіс! Барлығы мүмкін!
Dialogue: 0,0:01:44.77,0:01:47.39,Default,,0,0,0,,Жеңіс тұр!
Dialogue: 0,0:01:47.85,0:01:50.81,Default,,0,0,0,,Браво! Браво!
Dialogue: 0,0:01:51.98,0:01:54.23,Default,,0,0,0,,О, бұл тамаша
Dialogue: 0,0:01:54.36,0:01:56.78,Default,,0,0,0,,Кез келген қиындықты жеңу—
Dialogue: 0,0:01:56.90,0:01:59.95,Default,,0,0,0,,Өз идеалдарыңызға ұмтылыңыз
Dialogue: 0,0:02:00.24,0:02:03.45,Default,,0,0,0,,Бүкіл Құдірет әлі де ең жақсы
Dialogue: 0,0:02:04.95,0:02:05.95,Default,,0,0,0,,Келесі…
Dialogue: 0,0:02:06.20,0:02:06.87,Default,,0,0,0,,Ха!
Dialogue: 0,0:02:07.91,0:02:09.37,Default,,0,0,0,,Бұл сенсің
Dialogue: 0,0:02:11.46,0:02:14.80,Default,,0,0,0,,Білсем де, Бәрі мүмкін
Dialogue: 0,0:02:15.76,0:02:17.97,Default,,0,0,0,,Мен сенмін...
Dialogue: 0,0:02:18.80,0:02:21.43,Default,,0,0,0,,«Символдарды» мұраға алу
Dialogue: 0,0:02:32.69,0:02:34.73,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:02:35.02,0:02:36.86,Default,,0,0,0,,Мен біреуді іздеп жүрмін.
Dialogue: 0,0:02:36.99,0:02:38.24,Default,,0,0,0,,Сол киімде?
Dialogue: 0,0:02:40.24,0:02:41.99,Default,,0,0,0,,Мен оны таба алмаймын
Dialogue: 0,0:02:42.32,0:02:46.08,Default,,0,0,0,,Әй, бұл ел бұзылды.
Dialogue: 0,0:03:02.34,0:03:04.43,Default,,0,0,0,,
Dialogue: 0,0:03:04.76,0:03:09.18,Default,,0,0,0,,Қазіргі уақытта Батыс ауданында көптеген зұлым адамдар пайда болуда.
Dialogue: 0,0:03:09.73,0:03:11.94,Default,,0,0,0,,Батыр істі шешкенше—
Dialogue: 0,0:03:12.06,0:03:16.11,Default,,0,0,0,,Азаматтарды қауіпсіз жерге көшірулеріңізді сұраймыз.
Dialogue: 0,0:03:16.77,0:03:19.40,Default,,0,0,0,,Эвакуациялау үшін қайда баруым керек?
Dialogue: 0,0:03:29.45,0:03:31.71,Default,,0,0,0,,«Сиркемен өзін-өзі өлтіру оқиғасы»
Dialogue: 0,0:03:31.83,0:03:34.21,Default,,0,0,0,,Жама, джама! Доки Ягаре!
Dialogue: 0,0:03:35.42,0:03:37.71,Default,,0,0,0,,Сіз не қарап тұрсыз? Қанекей мынаны істейік!
Dialogue: 0,0:03:48.89,0:03:51.02,Default,,0,0,0,,Жүріңдер, жүріңдер, жүріңдер!
Dialogue: 0,0:04:06.70,0:04:08.45,Default,,0,0,0,,Үлкен аулау Үлкен аулау!
Dialogue: 0,0:04:08.58,0:04:11.91,Default,,0,0,0,,Енді әзірше көп жеудің қажеті жоқ!
Dialogue: 0,0:04:14.50,0:04:16.71,Default,,0,0,0,,Бірнеше деструкция дыбыстары естіледі
Dialogue: 0,0:04:17.25,0:04:19.21,Default,,0,0,0,,Машинаның жүгірген дыбысы алыстап барады.
Dialogue: 0,0:04:19.34,0:04:21.05,Default,,0,0,0,,- (Осиро Саруо) Қашықтық қанша? -(Джиро) Шамамен 2 км
Dialogue: 0,0:04:21.80,0:04:24.09,Default,,0,0,0,,Сен сол қашықтықта жүре аласың, Мидория.
Dialogue: 0,0:04:25.39,0:04:26.47,Default,,0,0,0,,Иә
Dialogue: 0,0:04:26.93,0:04:28.51,Default,,0,0,0,,Люк ашық
Dialogue: 0,0:04:32.31,0:04:34.56,Default,,0,0,0,,7 «Қалқымалы»
Dialogue: 0,0:04:43.61,0:04:45.95,Default,,0,0,0,,Плюс Әуе күштері
Dialogue: 0,0:04:56.08,0:04:57.46,Default,,0,0,0,,Бірдеңе келе жатыр
Dialogue: 0,0:04:57.58,0:05:01.92,Default,,0,0,0,,Сол жасыл түс жай ғана қауесет...
Dialogue: 0,0:05:02.05,0:05:03.42,Default,,0,0,0,,Дацугоку аң аулау?
Dialogue: 0,0:05:03.84,0:05:04.84,Default,,0,0,0,,«Қара қамшы»!
Dialogue: 0,0:05:04.97,0:05:06.01,Default,,0,0,0,,Біз екеуміздің біреуіміздің қанын сіңіргеннен кейін—
Dialogue: 0,0:05:19.48,0:05:20.15,Default,,0,0,0,,Хи хи
Dialogue: 0,0:05:29.24,0:05:30.37,Default,,0,0,0,,Арх!
Dialogue: 0,0:05:43.46,0:05:45.97,Default,,0,0,0,,Сент-Луис соққысы!
Dialogue: 0,0:05:51.72,0:05:52.76,Default,,0,0,0,,О, жоқ!
Dialogue: 0,0:05:53.47,0:05:54.39,Default,,0,0,0,,Ойлағанымдай, жұдырығыммен тиіп,
Dialogue: 0,0:05:55.02,0:05:56.48,Default,,0,0,0,,Ол Гран Торинодан әлдеқайда жылдам.
Dialogue: 0,0:05:59.44,0:06:00.86,Default,,0,0,0,,Дацугоку қорғалды!
Dialogue: 0,0:06:01.81,0:06:04.57,Default,,0,0,0,,...
Dialogue: 0,0:06:04.90,0:06:07.07,Default,,0,0,0,,Сіз мұны жасадыңыз! Зұлым адам қорғалған!
Dialogue: 0,0:06:07.20,0:06:11.99,Default,,0,0,0,,「･･」
Dialogue: 0,0:06:12.12,0:06:13.20,Default,,0,0,0,,Иә
Dialogue: 0,0:06:13.99,0:06:15.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:34.56,0:06:39.60,Default,,0,0,0,,♪ 「 」
Dialogue: 0,0:06:40.90,0:06:45.78,Default,,0,0,0,,♪
Dialogue: 0,0:06:47.44,0:06:50.41,Default,,0,0,0,,♪ қашу
Dialogue: 0,0:06:50.53,0:06:53.37,Default,,0,0,0,,♪ Мен қазір сенің иығыңды ысқылаймын, қымбаттым.
Dialogue: 0,0:06:53.49,0:06:56.54,Default,,0,0,0,,♪ Безеу жарқырауы → Салдары Қауіпсіз түсінілмеген әдіс
Dialogue: 0,0:06:56.66,0:07:00.29,Default,,0,0,0,,♪ сезім бірақ
Dialogue: 0,0:07:00.62,0:07:03.50,Default,,0,0,0,,♪ Ичи Ни Сан Кибакуджуто Жарайды
Dialogue: 0,0:07:03.75,0:07:06.71,Default,,0,0,0,,♪ Ёнмен ашылуы Жарылыс пен босату аман болсын
Dialogue: 0,0:07:06.84,0:07:10.01,Default,,0,0,0,,♪ Сун Ни Ичи Хай!! Жарылыс, тосқауылдың құлауы
Dialogue: 0,0:07:10.13,0:07:12.84,Default,,0,0,0,,♪
Dialogue: 0,0:07:12.97,0:07:15.97,Default,,0,0,0,,♪
Dialogue: 0,0:07:16.10,0:07:19.06,Default,,0,0,0,,♪ Ашық, бұлтты, белгісіздіктің келуі
Dialogue: 0,0:07:19.18,0:07:22.23,Default,,0,0,0,,♪ Гомункулус желдің көзіне қарай
Dialogue: 0,0:07:22.35,0:07:26.32,Default,,0,0,0,,♪ Алыстау, өз-өзіне күмәндану және өзін-өзі жою
Dialogue: 0,0:08:02.56,0:08:04.19,Default,,0,0,0,,♪ Гомункулус
Dialogue: 0,0:08:06.98,0:08:08.73,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:08:08.86,0:08:10.07,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:08:10.61,0:08:14.07,Default,,0,0,0,,Ａ３ ３
Dialogue: 0,0:08:14.20,0:08:16.24,Default,,0,0,0,,- (Кацуки Бакугоу) Үш адам ғана ма? - (Изуку) Хмм...
Dialogue: 0,0:08:16.62,0:08:19.24,Default,,0,0,0,,Мұнда төрт адам аң аулап жүр.
Dialogue: 0,0:08:19.37,0:08:20.54,Default,,0,0,0,,А тобы, 2-топ
Dialogue: 0,0:08:20.70,0:08:20.95,Default,,0,0,0,,Сондықтан мен ештеңе істемедім дедім.
Dialogue: 0,0:08:20.95,0:08:22.96,Default,,0,0,0,,Сондықтан мен ештеңе істемедім дедім.
Dialogue: 0,0:08:20.95,0:08:22.96,Default,,0,0,0,,6 Дацугоку қорғалды.
Dialogue: 0,0:08:23.29,0:08:25.12,Default,,0,0,0,,Ах!? Сіз мақтанасыз ба?
Dialogue: 0,0:08:25.25,0:08:27.46,Default,,0,0,0,,Біз сандар үшін жарыспаймыз.
Dialogue: 0,0:08:27.59,0:08:30.05,Default,,0,0,0,,Үлкен, жарылғыш, кісі өлтіру, Құдай Динамит-кун
Dialogue: 0,0:08:30.34,0:08:33.17,Default,,0,0,0,,Батыр есімі тым ұзын 2-сынып
Dialogue: 0,0:08:33.30,0:08:35.47,Default,,0,0,0,,«Бакуго» деп айту қалыпты жағдай емес пе?
Dialogue: 0,0:08:35.59,0:08:36.93,Default,,0,0,0,,Жақсы ұйықтаңыз!
Dialogue: 0,0:08:37.14,0:08:38.35,Default,,0,0,0,,Аха…
Dialogue: 0,0:08:38.47,0:08:39.51,Default,,0,0,0,,(Байланыс дыбысы)
Dialogue: 0,0:08:40.01,0:08:43.10,Default,,0,0,0,,Батыс аймақтағы портта зұлым адам пайда болды деген хабар келді.
Dialogue: 0,0:08:43.23,0:08:46.48,Default,,0,0,0,,Куәгердің сөзінен: Дацугоку «Гиндзи Куйю»
Dialogue: 0,0:08:46.60,0:08:48.86,Default,,0,0,0,,Зұлым адамның аты «Гиндзи» ретінде анықталды
Dialogue: 0,0:08:48.98,0:08:52.86,Default,,0,0,0,,«Индивидуалдылық» «Ағаштық» Барлығын аузымен қарынға түсіреді.
Dialogue: 0,0:08:53.15,0:08:54.78,Default,,0,0,0,,Сақ болдым, соғып қалдым.
Dialogue: 0,0:08:54.90,0:08:56.57,Default,,0,0,0,,Батыс аймағындағы порт...
Dialogue: 0,0:08:56.70,0:08:57.95,Default,,0,0,0,,Дәл осы жерде
Dialogue: 0,0:08:58.28,0:08:59.24,Default,,0,0,0,,Кеттік
Dialogue: 0,0:08:59.37,0:09:00.33,Default,,0,0,0,,Біз де барамыз.
Dialogue: 0,0:09:00.87,0:09:03.54,Default,,0,0,0,,А тобы, 2-топ, дереу оқиға орнына асығыңыз.
Dialogue: 0,0:09:10.42,0:09:13.59,Default,,0,0,0,,(Серо) «Өте жылдам адам» деген лақап ат тек сән үшін ғана емес қой?
Dialogue: 0,0:09:14.01,0:09:16.34,Default,,0,0,0,,Ха! Хахаха
Dialogue: 0,0:09:17.13,0:09:20.10,Default,,0,0,0,,Мен оны жеңдім, мен оны алдым!
Dialogue: 0,0:09:20.35,0:09:22.97,Default,,0,0,0,,Менде бұл әйел болса, мен жеңілмейтін боламын!
Dialogue: 0,0:09:23.35,0:09:24.98,Default,,0,0,0,,Уф... өтірікші!
Dialogue: 0,0:09:25.10,0:09:26.94,Default,,0,0,0,,Сіз маған қашып кетуге мүмкіндік беремін дедіңіз.
Dialogue: 0,0:09:27.27,0:09:29.94,Default,,0,0,0,,Ешкімді босатамын деп айтпа.
Dialogue: 0,0:09:31.98,0:09:32.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:33.61,0:09:36.32,Default,,0,0,0,,Бұл көлік Батырдың көлігі!
Dialogue: 0,0:09:42.08,0:09:43.95,Default,,0,0,0,,Дацугокуның бағыты өзгерді
Dialogue: 0,0:09:44.08,0:09:46.29,Default,,0,0,0,,Өкінішті, алда баспана бар.
Dialogue: 0,0:09:46.41,0:09:47.71,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:09:54.63,0:09:55.67,Default,,0,0,0,,бұл... жібер!
Dialogue: 0,0:09:55.80,0:09:57.38,Default,,0,0,0,,Аузыңды жап!
Dialogue: 0,0:09:58.26,0:09:59.47,Default,,0,0,0,,Батыр!
Dialogue: 0,0:09:59.97,0:10:02.05,Default,,0,0,0,,Ақпарат пен сыртқы түрі әртүрлі ме?
Dialogue: 0,0:10:02.51,0:10:03.81,Default,,0,0,0,,Кепіл!?
Dialogue: 0,0:10:11.11,0:10:11.81,Default,,0,0,0,,Мұнда
Dialogue: 0,0:10:12.15,0:10:13.15,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:10:14.15,0:10:15.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:16.78,0:10:18.15,Default,,0,0,0,,Гүлдер!?
Dialogue: 0,0:10:20.91,0:10:21.95,Default,,0,0,0,,бірақ ол да маған күдікпен қарады…
Dialogue: 0,0:10:28.16,0:10:29.42,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:10:29.54,0:10:32.00,Default,,0,0,0,,Бұл қандай ауырсыну?
Dialogue: 0,0:10:32.50,0:10:35.50,Default,,0,0,0,,Ал мына гүл...
Dialogue: 0,0:10:36.84,0:10:39.38,Default,,0,0,0,,Мен... сені құтқаруым керек.
Dialogue: 0,0:10:40.89,0:10:42.97,Default,,0,0,0,,Ах! Бұл жауыз!
Dialogue: 0,0:10:53.11,0:10:55.61,Default,,0,0,0,,Бекер күрес!
Dialogue: 0,0:10:59.86,0:11:04.12,Default,,0,0,0,,Хехехе... Тағы бір барымта!
Dialogue: 0,0:11:05.45,0:11:06.99,Default,,0,0,0,,Уф... не!?
Dialogue: 0,0:11:07.50,0:11:09.29,Default,,0,0,0,,Енді жоқ...
Dialogue: 0,0:11:09.91,0:11:11.87,Default,,0,0,0,,Тоқтамаңыз!
Dialogue: 0,0:11:12.58,0:11:14.04,Default,,0,0,0,,Дауыс өзгертуші екен ғой
Dialogue: 0,0:11:14.42,0:11:17.25,Default,,0,0,0,,Қазір қашыңыз! тез!
Dialogue: 0,0:11:18.55,0:11:20.97,Default,,0,0,0,,(Баяндаушы) Еня әжесін қолға түсіргеннен кейін, Джотаро мен оның серіктері ат арбасын қолға түсірді
Dialogue: 0,0:11:22.55,0:11:24.47,Default,,0,0,0,,Мен… мен істедім! Мен жылдамырақпын! ➡
Dialogue: 0,0:11:27.56,0:11:29.43,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:29.68,0:11:30.64,Default,,0,0,0,,Олар қосымша күш әкелді.
Dialogue: 0,0:11:50.16,0:11:51.71,Default,,0,0,0,,Уау
Dialogue: 0,0:11:52.33,0:11:54.42,Default,,0,0,0,,- (Изуку) Оқ? -Не?
Dialogue: 0,0:11:55.13,0:11:56.17,Default,,0,0,0,,Кепілге алынған адам!
Dialogue: 0,0:11:57.59,0:11:58.92,Default,,0,0,0,,Сіз қуғыншысыз ба?
Dialogue: 0,0:12:00.88,0:12:01.92,Default,,0,0,0,,(Кондуктор) Сабыр сақтап, батырды күтіңіздер…
Dialogue: 0,0:12:16.15,0:12:17.77,Default,,0,0,0,,Ха…
Dialogue: 0,0:12:23.28,0:12:24.82,Default,,0,0,0,,Уақытында емес
Dialogue: 0,0:12:29.41,0:12:30.49,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:12:33.00,0:12:34.50,Default,,0,0,0,,Не?
Dialogue: 0,0:12:35.04,0:12:36.13,Default,,0,0,0,,Ах... иә?
Dialogue: 0,0:12:36.75,0:12:40.30,Default,,0,0,0,,Бұл қауіпті жағдай болды, жас ханым.
Dialogue: 0,0:12:43.51,0:12:44.76,Default,,0,0,0,,Сіз ше?
Dialogue: 0,0:12:44.88,0:12:46.22,Default,,0,0,0,,Күннің соңына сай ән
Dialogue: 0,0:12:47.51,0:12:50.60,Default,,0,0,0,,Белгілі бір кеңістікте қозғалысты тоқтататын «Индивидуалдылық»?
Dialogue: 0,0:12:51.27,0:12:54.56,Default,,0,0,0,,Жоқ, бұл кідіріс, ол баяулайды.
Dialogue: 0,0:13:01.69,0:13:02.69,Default,,0,0,0,,Өтінемін, тоқтаңдар!
Dialogue: 0,0:13:05.65,0:13:07.49,Default,,0,0,0,,«Дағдарыстарды анықтау» жауап бермей ме?
Dialogue: 0,0:13:09.16,0:13:10.70,Default,,0,0,0,,Бұл адам...
Dialogue: 0,0:13:31.89,0:13:32.77,Default,,0,0,0,,меніңше, бұл – нағыз ақымақтық шыңы… Яғни—
Dialogue: 0,0:13:33.02,0:13:34.02,Default,,0,0,0,,Аға… Көмектес маған
Dialogue: 0,0:13:35.02,0:13:37.06,Default,,0,0,0,,Жер бетінде не?
Dialogue: 0,0:13:38.40,0:13:40.27,Default,,0,0,0,,- (Очако) Деку-кун! -(Оджиро) Жағдай қандай?
Dialogue: 0,0:13:40.65,0:13:42.27,Default,,0,0,0,,Бұл маған да қатысты...
Dialogue: 0,0:13:43.15,0:13:44.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:44.19,0:13:45.78,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:13:51.20,0:13:52.20,Default,,0,0,0,,Кеме...
Dialogue: 0,0:13:53.58,0:13:56.08,Default,,0,0,0,,Аспанда кеме ұшып келеді
Dialogue: 0,0:13:56.29,0:13:57.67,Default,,0,0,0,,Тс!
Dialogue: 0,0:14:14.77,0:14:18.98,Default,,0,0,0,,♬ Ора ора ора ора, ора ора ора ора
Dialogue: 0,0:14:25.53,0:14:28.61,Default,,0,0,0,,Жарайды, Анна.
Dialogue: 0,0:14:29.91,0:14:31.78,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:14:37.91,0:14:39.92,Default,,0,0,0,,Мен осындамын!
Dialogue: 0,0:14:40.79,0:14:41.71,Default,,0,0,0,,Бұл...
Dialogue: 0,0:14:42.08,0:14:43.50,Default,,0,0,0,,O… O…
Dialogue: 0,0:14:43.63,0:14:45.84,Default,,0,0,0,,Барлығы мүмкін!?
Dialogue: 0,0:14:46.34,0:14:50.43,Default,,0,0,0,,Жоқ. Бұл ұқсас, бірақ бұл Бүкіл Құдірет емес.
Dialogue: 0,0:14:50.55,0:14:55.18,Default,,0,0,0,,Сонымен қатар, «Дағдарыс сезімі» сізді максималды деңгейде ескертеді.
Dialogue: 0,0:14:56.47,0:14:58.60,Default,,0,0,0,,Ол кісі кім...
Dialogue: 0,0:15:00.73,0:15:01.98,Default,,0,0,0,,Горини
Dialogue: 0,0:15:03.98,0:15:05.44,Default,,0,0,0,,Жоқ! Жіберу!
Dialogue: 0,0:15:06.48,0:15:07.69,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:15:10.95,0:15:14.91,Default,,0,0,0,,Мен сені қорқынышты сезіндірген сияқтымын, Анна.
Dialogue: 0,0:15:15.24,0:15:19.16,Default,,0,0,0,,Көмегіңе рахмет, ағай.
Dialogue: 0,0:15:19.29,0:15:22.67,Default,,0,0,0,,Мені енді ешқашан тастама
Dialogue: 0,0:15:23.13,0:15:26.25,Default,,0,0,0,,Аннаның оралғанына қуаныштымын, Пол.
Dialogue: 0,0:15:26.38,0:15:28.13,Default,,0,0,0,,Мен Бруноға алғыс айтуым керек.
Dialogue: 0,0:15:28.26,0:15:30.67,Default,,0,0,0,,Цк, мен енді қателеспеймін.
Dialogue: 0,0:15:30.80,0:15:32.01,Default,,0,0,0,,Қалпына келтіру
Dialogue: 0,0:15:37.22,0:15:38.39,Default,,0,0,0,,Өтінемін, мені жіберіңізші!
Dialogue: 0,0:15:38.52,0:15:39.56,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:15:39.68,0:15:42.10,Default,,0,0,0,,Бұл сіздің соңғы мүмкіндігіңіз болуы мүмкін.
Dialogue: 0,0:15:45.23,0:15:47.44,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:15:47.57,0:15:48.94,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:15:49.07,0:15:51.03,Default,,0,0,0,,Әзірше Джинжи - зұлым...
Dialogue: 0,0:15:51.45,0:15:52.91,Default,,0,0,0,,...және қаш!
Dialogue: 0,0:16:04.96,0:16:06.21,Default,,0,0,0,,№
Dialogue: 0,0:16:08.46,0:16:09.80,Default,,0,0,0,,Тез қаш!
Dialogue: 0,0:16:10.34,0:16:12.17,Default,,0,0,0,,Құлап кетсін!
Dialogue: 0,0:16:13.68,0:16:15.26,Default,,0,0,0,,Барлығына басшылық!
Dialogue: 0,0:16:16.18,0:16:17.05,Default,,0,0,0,,Мен білемін!
Dialogue: 0,0:16:19.97,0:16:23.31,Default,,0,0,0,,Хехехе... Батыр болу қиын.
Dialogue: 0,0:16:33.57,0:16:35.66,Default,,0,0,0,,Сен тым ақымақсың.
Dialogue: 0,0:16:44.37,0:16:46.71,Default,,0,0,0,,Сен танымалсың, Анна.
Dialogue: 0,0:16:54.43,0:16:56.97,Default,,0,0,0,,Қат! Сол әйел болса ғой...
Dialogue: 0,0:16:57.09,0:17:00.85,Default,,0,0,0,,Әй, қайда барасың?
Dialogue: 0,0:17:01.89,0:17:02.77,Default,,0,0,0,,мен жіпті көремін.
Dialogue: 0,0:17:03.27,0:17:06.77,Default,,0,0,0,,Оны конформист еткенде не қашады?
Dialogue: 0,0:17:06.90,0:17:08.94,Default,,0,0,0,,Ағай, күте тұрыңыз...
Dialogue: 0,0:17:13.11,0:17:14.78,Default,,0,0,0,,Мен ашуланамын!
Dialogue: 0,0:17:18.57,0:17:19.41,Default,,0,0,0,,(Ходжинс) Көріп тұрғаныңыздай, базадағы сарбаздар қуыршақтарға сұраныс жоғары.
Dialogue: 0,0:17:37.47,0:17:38.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:46.69,0:17:48.15,Default,,0,0,0,,Ми… барлығы…
Dialogue: 0,0:17:52.19,0:17:56.03,Default,,0,0,0,,Әй, бұл батырға ұқсайды ма?
Dialogue: 0,0:17:57.57,0:18:01.83,Default,,0,0,0,,Сіз өте жас көрінесіз. Сізге шоколад керек пе?
Dialogue: 0,0:18:03.33,0:18:04.70,Default,,0,0,0,,Сіз мұны жасадыңыз ба?
Dialogue: 0,0:18:05.62,0:18:06.96,Default,,0,0,0,,Шынын айтсам, мен де нақты қашан болатынын білмеймін.
Dialogue: 0,0:18:07.08,0:18:10.21,Default,,0,0,0,,Маған рахмет айтудың қажеті жоқ.
Dialogue: 0,0:18:10.46,0:18:14.84,Default,,0,0,0,,Әлгі жауыз қалқанымен маған шабуыл жасады.
Dialogue: 0,0:18:15.34,0:18:18.63,Default,,0,0,0,,Мен «бейбітшілік символына» айналамын
Dialogue: 0,0:18:18.76,0:18:21.47,Default,,0,0,0,,Бейбітшілік символы?
Dialogue: 0,0:18:21.76,0:18:24.22,Default,,0,0,0,,Иә, бәрі мүмкін.
Dialogue: 0,0:18:24.72,0:18:26.73,Default,,0,0,0,,Не... айт...
Dialogue: 0,0:18:27.10,0:18:32.77,Default,,0,0,0,,Қане, менің асқақ мұраттарымды қарапайым халық түсінбей ме?
Dialogue: 0,0:18:32.90,0:18:38.70,Default,,0,0,0,,Олай болса неге бала түсінетіндей етіп түсіндірмеске?
Dialogue: 0,0:18:43.62,0:18:44.37,Default,,0,0,0,,Хехе
Dialogue: 0,0:19:04.64,0:19:05.93,Default,,0,0,0,,Болашақ ауа-райы...
Dialogue: 0,0:19:07.14,0:19:08.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:15.32,0:19:17.07,Default,,0,0,0,,Бұл сурет...
Dialogue: 0,0:19:19.07,0:19:20.57,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:19:22.53,0:19:24.07,Default,,0,0,0,,Осылайша тәжірибеңіз артады және көпшіліктің назарын аударасыз
Dialogue: 0,0:19:27.95,0:19:29.91,Default,,0,0,0,,Барлығына сәлем
Dialogue: 0,0:19:31.92,0:19:37.38,Default,,0,0,0,,Мен жаңа Құдіретпін, келер ұрпақтың «символына» айналатын адаммын.
Dialogue: 0,0:19:38.13,0:19:41.13,Default,,0,0,0,,New Бүкіл Құдірет?
Dialogue: 0,0:19:41.63,0:19:46.89,Default,,0,0,0,,Неліктен Бүкіл Құдірет «бейбітшілік символы» деп аталды?
Dialogue: 0,0:19:47.56,0:19:49.89,Default,,0,0,0,,Жауап өте қарапайым
Dialogue: 0,0:19:50.56,0:19:52.39,Default,,0,0,0,,Өйткені ол күшті болды
Dialogue: 0,0:19:53.19,0:19:56.11,Default,,0,0,0,,Зұлымдар Құдіретті күшке бас иеді.
Dialogue: 0,0:19:56.69,0:20:00.07,Default,,0,0,0,,Билігі жоқтар оның күшін аңсайды —
Dialogue: 0,0:20:00.65,0:20:05.03,Default,,0,0,0,,Қорқыныш пен қызғаныш үмітке айналып, ақырында «символға» айналды.
Dialogue: 0,0:20:05.87,0:20:08.79,Default,,0,0,0,,Бірақ «символ» жоғалып кетті
Dialogue: 0,0:20:09.20,0:20:11.29,Default,,0,0,0,,Айналаңызға қараңыз
Dialogue: 0,0:20:12.25,0:20:15.29,Default,,0,0,0,,Жауыздан жеңіліп, әлем тастап кетті —
Dialogue: 0,0:20:15.42,0:20:19.96,Default,,0,0,0,,Жапония заңдылық пен тәртіпті жоғалтып, өзінің қарабайыр жағдайына оралды!
Dialogue: 0,0:20:21.17,0:20:25.05,Default,,0,0,0,,Бұл Бүкіл Құдірет күшін жоғалтқандықтан болды.
Dialogue: 0,0:20:26.05,0:20:28.47,Default,,0,0,0,,Себебі қазіргі қаһармандар әлі жетілмеген.
Dialogue: 0,0:20:29.06,0:20:30.39,Default,,0,0,0,,Ант етемін!
Dialogue: 0,0:20:30.52,0:20:33.81,Default,,0,0,0,,Барша құдіреттің туған жері Жапонияда...
Dialogue: 0,0:20:33.94,0:20:35.81,Default,,0,0,0,,Жоқ, осы Жапониядан—
Dialogue: 0,0:20:35.94,0:20:39.48,Default,,0,0,0,,Әлемнің «жаңа символы» болыңыз және ұшыңыз!
Dialogue: 0,0:20:40.07,0:20:43.36,Default,,0,0,0,,Бүкіл Құдірет идеалдарын мұра ету
Dialogue: 0,0:20:44.49,0:20:45.36,Default,,0,0,0,,Иә
Dialogue: 0,0:20:45.91,0:20:49.03,Default,,0,0,0,,Келесі мен!
Dialogue: 0,0:20:51.25,0:20:54.04,Default,,0,0,0,,үшінші курс студенті Цугата — басты фаворит болды —
Dialogue: 0,0:20:54.83,0:20:58.38,Default,,0,0,0,,Мен – әділеттім, мен – символмын!
Dialogue: 0,0:20:58.50,0:21:00.50,Default,,0,0,0,,- (Изуку) Әділдік деген не! -иә?
Dialogue: 0,0:21:00.80,0:21:03.26,Default,,0,0,0,,өзімшіл зорлық-
Dialogue: 0,0:21:03.38,0:21:05.97,Default,,0,0,0,,Туысы жоқ адамдарды қатыстыру?
Dialogue: 0,0:21:06.51,0:21:09.05,Default,,0,0,0,,Бүкіл Құдірет мұны ешқашан жасамас еді!
Dialogue: 0,0:21:09.72,0:21:12.06,Default,,0,0,0,,Бұл дауыс Мидорий бала ма?
Dialogue: 0,0:21:12.60,0:21:15.73,Default,,0,0,0,,Сіз Бүкіл Құдірет емессіз!
Dialogue: 0,0:21:15.94,0:21:18.23,Default,,0,0,0,,Хун
Dialogue: 0,0:21:18.36,0:21:23.15,Default,,0,0,0,,Мен сіздің бас тартуыңызды жою үшін өз күшімді пайдалануға рұқсат етіңіз.
Dialogue: 0,0:21:46.68,0:21:47.72,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:48.05,0:21:52.22,Default,,0,0,0,,Бұл «рәміздерге» айналғандардың күші.
Dialogue: 0,0:21:52.35,0:21:54.10,Default,,0,0,0,,Бұл менің күшім!
Dialogue: 0,0:22:20.33,0:22:22.42,Default,,0,0,0,,Бұл «индивидуалдылық» дегеніміз не?
Dialogue: 0,0:22:25.55,0:22:26.67,Default,,0,0,0,,Ах!
Dialogue: 0,0:22:28.72,0:22:30.30,Default,,0,0,0,,Сіз қазір сақтай аласыз!
Dialogue: 0,0:22:31.01,0:22:33.76,Default,,0,0,0,,Ешқашан... Ешқашан...
Dialogue: 0,0:22:39.56,0:22:40.73,Default,,0,0,0,,Қандай әйелдер ұнайды саған?
Dialogue: 0,0:22:43.73,0:22:45.44,Default,,0,0,0,,Бұл жарық дегеніміз не...
Dialogue: 0,0:22:45.57,0:22:47.53,Default,,0,0,0,,Юэй штаб-пәтерін көре аласыз ба?
Dialogue: 0,0:22:48.28,0:22:51.32,Default,,0,0,0,,Батыс аймағындағы айлақ панасындағы жұмбақ жарық құбылысы
Dialogue: 0,0:22:51.45,0:22:53.24,Default,,0,0,0,,Кеңейтуді жалғастырады
Dialogue: 0,0:22:53.58,0:22:56.37,Default,,0,0,0,,Бұл жарықтың қандай «даралығы» бар?
Dialogue: 0,0:22:56.50,0:22:58.96,Default,,0,0,0,,Осындай «даралығы» бар адам...
Dialogue: 0,0:22:59.08,0:23:01.25,Default,,0,0,0,,«Барлығы бір үшін» тобынан басқа да адамдар болды...
Dialogue: 0,0:23:02.17,0:23:04.46,Default,,0,0,0,,Эвакуацияланғандар мен Мидорий ұлдарының қауіпсіздігі қандай?
Dialogue: 0,0:23:04.59,0:23:07.38,Default,,0,0,0,,Оны жұмбақ люминесценттік құбылыс жұтып қойған сияқты
Dialogue: 0,0:23:07.51,0:23:08.76,Default,,0,0,0,,Өмір немесе өлім белгісіз
Dialogue: 0,0:23:09.05,0:23:11.39,Default,,0,0,0,,Сонымен... бұл...
Dialogue: 0,0:23:13.76,0:23:16.64,Default,,0,0,0,,Бұл жігіт қаншалықты үлкен болады?
Dialogue: 0,0:23:17.02,0:23:18.56,Default,,0,0,0,,Мен оны тоқтатамын
Dialogue: 0,0:23:25.86,0:23:28.11,Default,,0,0,0,,Жарайды, жұтып қойғандарды құтқар!
Dialogue: 0,0:23:31.15,0:23:33.24,Default,,0,0,0,,Жоқ, эвакуациялаңыз!
Dialogue: 0,0:23:36.79,0:23:39.96,Default,,0,0,0,,Сіз неден қашып жүрсіз? Қайтып келу! Бұл кері бұрылу!
Dialogue: 0,0:23:40.08,0:23:41.50,Default,,0,0,0,,Дөрекі болма, адам.
Dialogue: 0,0:23:41.62,0:23:42.50,Default,,0,0,0,,Не!?
Dialogue: 0,0:23:43.25,0:23:44.29,Default,,0,0,0,,Жарық!
Dialogue: 0,0:23:44.71,0:23:46.00,Default,,0,0,0,,Жұтты!
Dialogue: 0,0:24:20.70,0:24:23.00,Default,,0,0,0,,Үлкен нысанның пайда болуын растады
Dialogue: 0,0:24:23.12,0:24:25.75,Default,,0,0,0,,Жарық әлі де кеңейіп жатқан сияқты.
Dialogue: 0,0:24:26.08,0:24:29.92,Default,,0,0,0,,Мұны сол адам жасады дейсіз бе?
Dialogue: 0,0:24:30.05,0:24:33.76,Default,,0,0,0,,Мистер Бүкіл Құдірет, мынаны қараңызшы.
Dialogue: 0,0:24:34.51,0:24:37.51,Default,,0,0,0,,Мен оны бір жерден көрдім деп ойладым.
Dialogue: 0,0:24:38.18,0:24:39.89,Default,,0,0,0,,Олар...
Dialogue: 0,0:24:40.47,0:24:41.81,Default,,0,0,0,,Горини отбасы
Dialogue: 0,0:24:43.10,0:24:44.81,Default,,0,0,0,,Горини отбасы
Dialogue: 0,0:24:46.23,0:24:48.90,Default,,0,0,0,,Негізінен зұлым адамдардан құралған—
Dialogue: 0,0:24:52.15,0:24:55.57,Default,,0,0,0,,Еуропадағы ең ірі қылмыстық ұйым...
Dialogue: 0,0:24:59.33,0:25:01.91,Default,,0,0,0,,Деку-кун Деку-кун
Dialogue: 0,0:25:08.21,0:25:09.29,Default,,0,0,0,,(Камино) Көздері жылтырап, жүзі әдемі, бірақ—
Dialogue: 0,0:25:09.42,0:25:11.80,Default,,0,0,0,,Жақсысың ба, Мидория?
Dialogue: 0,0:25:11.92,0:25:13.55,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:25:14.13,0:25:15.01,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:25:16.18,0:25:18.05,Default,,0,0,0,,Осы тұрғыдан?
Dialogue: 0,0:25:18.85,0:25:20.14,Default,,0,0,0,,Неліктен Джунгли?
Dialogue: 0,0:25:20.56,0:25:21.64,Default,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,0:25:21.77,0:25:24.14,Default,,0,0,0,,Мен оянсам, мен осында болдым.
Dialogue: 0,0:25:24.27,0:25:26.52,Default,,0,0,0,,Сіз бұл джунглиді де қостыңыз ба?
Dialogue: 0,0:25:28.86,0:25:29.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:31.23,0:25:32.69,Default,,0,0,0,,Жоқ
Dialogue: 0,0:25:32.82,0:25:36.61,Default,,0,0,0,,Бұл ағаш еліктеу.
Dialogue: 0,0:25:37.49,0:25:41.08,Default,,0,0,0,,Мұқият қарасаңыз, жануарлар мен жәндіктер жоқ.
Dialogue: 0,0:25:41.62,0:25:45.08,Default,,0,0,0,,Яойорозу-сан сияқты бейорганикалық заттарды тудыратын «Индивидуалдылық»?
Dialogue: 0,0:25:45.75,0:25:49.92,Default,,0,0,0,,Бірақ соншалықты үлкен нәрсені жасау үшін ...
Dialogue: 0,0:25:50.25,0:25:51.46,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:25:51.59,0:25:53.63,Default,,0,0,0,,Жоқ, радиотолқындар бұғатталған.
Dialogue: 0,0:25:54.42,0:25:56.72,Default,,0,0,0,,Мен мұнда да жақын маңдағы шуды ғана естимін.
Dialogue: 0,0:25:57.59,0:25:58.80,Default,,0,0,0,,Қызыл теңіз
Dialogue: 0,0:25:59.72,0:26:03.89,Default,,0,0,0,,Біріншіден, бізбен бірге жұтып қойғандардың қауіпсіздігін растау керек.
Dialogue: 0,0:26:04.31,0:26:06.27,Default,,0,0,0,,Бұл қашу, солай емес пе?
Dialogue: 0,0:26:06.39,0:26:07.69,Default,,0,0,0,,- (Очако) Иә - (Оджиро) Ах
Dialogue: 0,0:26:08.48,0:26:10.52,Default,,0,0,0,,На… на… на…
Dialogue: 0,0:26:11.15,0:26:13.07,Default,,0,0,0,,Бұл қай жер?!
Dialogue: 0,0:26:13.19,0:26:15.49,Default,,0,0,0,,- (Токоями Фукин мен Киришима) Бұл ойын-сауық саябағы - (Бакуго) Түсінемін!
Dialogue: 0,0:26:15.82,0:26:17.36,Default,,0,0,0,,- (Ашидо) Эй, эй - (Бакуго) А?
Dialogue: 0,0:26:17.74,0:26:18.99,Default,,0,0,0,,Бұл жұмыс істейді
Dialogue: 0,0:26:19.11,0:26:20.57,Default,,0,0,0,,Ойнамаңыз!
Dialogue: 0,0:26:24.54,0:26:27.75,Default,,0,0,0,,Мен бұл жарықта мұндай қала болады деп ойламаппын
Dialogue: 0,0:26:28.08,0:26:30.29,Default,,0,0,0,,Ол не үшін жасалған?
Dialogue: 0,0:26:30.42,0:26:32.63,Default,,0,0,0,,Мұны түсіну мүмкін емес.
Dialogue: 0,0:26:33.09,0:26:36.13,Default,,0,0,0,,Барлығың жоғарыдағы шаршыға қараңдар.
Dialogue: 0,0:26:37.17,0:26:40.34,Default,,0,0,0,,Мен мұны ертерек бейнеден көрдім...
Dialogue: 0,0:26:41.09,0:26:43.76,Default,,0,0,0,,Тіпті ескерткіштің өзі Бүкіл Құдірет сияқты?
Dialogue: 0,0:26:44.26,0:26:46.43,Default,,0,0,0,,Бірдеңе болуы мүмкін.
Dialogue: 0,0:26:46.56,0:26:48.56,Default,,0,0,0,,А, кеттік.
Dialogue: 0,0:26:58.32,0:27:00.91,Default,,0,0,0,,Хмм, қалай ойлайсың, Анна?
Dialogue: 0,0:27:01.03,0:27:04.53,Default,,0,0,0,,Мен сізді ойлап жасаған бұл бөлме қаншалықты ыңғайлы?
Dialogue: 0,0:27:05.20,0:27:07.83,Default,,0,0,0,,Өте жақсы, ағай.
Dialogue: 0,0:27:07.95,0:27:10.62,Default,,0,0,0,,Хехехе... Мен сен солай айтасың деп ойладым.
Dialogue: 0,0:27:15.09,0:27:16.42,Default,,0,0,0,,Мистер Бүкіл Құдірет
Dialogue: 0,0:27:16.55,0:27:19.84,Default,,0,0,0,,Бұрын эфирге шыққан сіз сияқты адамнан —
Dialogue: 0,0:27:19.97,0:27:22.97,Default,,0,0,0,,Маған сізбен тікелей сөйлесу үшін хабарласты...
Dialogue: 0,0:27:23.09,0:27:25.14,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,0:27:26.51,0:27:29.43,Default,,0,0,0,,Жоқ, мен өзімнің алдыңғымды іздедім.
Dialogue: 0,0:27:29.56,0:27:32.52,Default,,0,0,0,,Осы есте қаларлық күнде менің алма-матерімде болу
Dialogue: 0,0:27:32.98,0:27:36.15,Default,,0,0,0,,Алып нысан ұстап алған адамдар аман ба?
Dialogue: 0,0:27:36.27,0:27:39.44,Default,,0,0,0,,Әрине, бұл маңызды пән.
Dialogue: 0,0:27:39.57,0:27:40.74,Default,,0,0,0,,Тақырып туралы не айтасыз?
Dialogue: 0,0:27:41.49,0:27:44.32,Default,,0,0,0,,Бүкіл Құдірет, сізге хабарласқан адам:
Dialogue: 0,0:27:44.45,0:27:46.66,Default,,0,0,0,,Қайтадан хабарлау
Dialogue: 0,0:27:47.12,0:27:49.83,Default,,0,0,0,,Сенің орныңда мен күшімнен айырылдым.
Dialogue: 0,0:27:49.95,0:27:51.79,Default,,0,0,0,,Өсиетті мұраға алу -
Dialogue: 0,0:27:51.92,0:27:55.59,Default,,0,0,0,,Тыныштанып, мына елді көрейік.
Dialogue: 0,0:27:56.09,0:27:57.67,Default,,0,0,0,,Егер менің еркім айтсаң—
Dialogue: 0,0:27:57.80,0:28:00.88,Default,,0,0,0,,Ұсталған адамдарды қазір босатыңыз.
Dialogue: 0,0:28:01.22,0:28:02.72,Default,,0,0,0,,Бізбен ынтымақтасуыңызды сұраймыз.
Dialogue: 0,0:28:03.01,0:28:05.89,Default,,0,0,0,,Жарайды, мен сені босатпаймын.
Dialogue: 0,0:28:06.01,0:28:09.39,Default,,0,0,0,,Өйткені олар сіздің еркіңізді орындай алады -
Dialogue: 0,0:28:09.52,0:28:11.60,Default,,0,0,0,,Өйткені ол қажетті болмыс
Dialogue: 0,0:28:13.10,0:28:15.94,Default,,0,0,0,,Бұл менің еркім емес
Dialogue: 0,0:28:16.27,0:28:19.69,Default,,0,0,0,,Сен менің өсиетімді мұра еткен жоқсың.
Dialogue: 0,0:28:20.15,0:28:24.45,Default,,0,0,0,,Өз күш-қуатыңызды көрсетіп, өз қалауыңызды қанағаттандыруға тырысу.
Dialogue: 0,0:28:24.91,0:28:28.12,Default,,0,0,0,,Жарықты емес, қараңғылықты іздейтін жауыз!
Dialogue: 0,0:28:28.45,0:28:29.70,Default,,0,0,0,,Ха…
Dialogue: 0,0:28:29.83,0:28:32.08,Default,,0,0,0,,Хехе...
Dialogue: 0,0:28:32.46,0:28:34.50,Default,,0,0,0,,Жарық емес, қараңғылық!
Dialogue: 0,0:28:34.62,0:28:37.00,Default,,0,0,0,,Онда мен барлық мүмкін емеспін...
Dialogue: 0,0:28:37.13,0:28:39.30,Default,,0,0,0,,Қараңғы кене сияқты нәрсе бар ма?
Dialogue: 0,0:28:39.42,0:28:42.80,Default,,0,0,0,,Керемет естіледі, Қара кене!
Dialogue: 0,0:28:43.84,0:28:45.18,Default,,0,0,0,,Менің идеалдарым
Dialogue: 0,0:28:45.30,0:28:48.76,Default,,0,0,0,,Мен мұндай нәрселерді бұрмалайтын біреу пайда болады деп ешқашан ойламадым ...
Dialogue: 0,0:28:48.93,0:28:49.81,Default,,0,0,0,,Бірақ!
Dialogue: 0,0:28:50.47,0:28:52.81,Default,,0,0,0,,Әрі қарай не істеу сізге байланысты ма?
Dialogue: 0,0:28:53.60,0:28:55.81,Default,,0,0,0,,Мен кімге сеніп тапсырдым...
Dialogue: 0,0:28:56.02,0:28:58.82,Default,,0,0,0,,Жоқ, бізге сеніп тапсырғандар —
Dialogue: 0,0:28:59.48,0:29:02.74,Default,,0,0,0,,Батыр сенің қасыңда!
Dialogue: 0,0:29:03.15,0:29:07.87,Default,,0,0,0,,Жоқ. Олар да жақында “жаңа таңбаға” бас иеді.
Dialogue: 0,0:29:07.99,0:29:11.08,Default,,0,0,0,,Қараңғы кене деп аталатын «жаңа таңба».
Dialogue: 0,0:29:11.20,0:29:14.04,Default,,0,0,0,,Иә, қазірден бастап менің уақытым.
Dialogue: 0,0:29:14.16,0:29:16.92,Default,,0,0,0,,Әлем! Қазір бәрі жақсы!
Dialogue: 0,0:29:17.04,0:29:20.30,Default,,0,0,0,,Мен осындамын! Фуфуфу…
Dialogue: 0,0:29:20.42,0:29:21.80,Default,,0,0,0,,Қайырлы күн!
Dialogue: 0,0:29:37.31,0:29:39.31,Default,,0,0,0,,Осы балалардың кейбірі—
Dialogue: 0,0:29:39.44,0:29:42.94,Default,,0,0,0,,Құдірет кейінгі ұрпақты аманат еткен батыр бар.
Dialogue: 0,0:29:43.07,0:29:44.86,Default,,0,0,0,,Бұл қызық емес пе?
Dialogue: 0,0:29:45.53,0:29:47.49,Default,,0,0,0,,Ол адам...
Dialogue: 0,0:29:47.78,0:29:50.45,Default,,0,0,0,,Мен жас ханымның өмірін мақсат еткен ұрымын.
Dialogue: 0,0:29:50.58,0:29:52.41,Default,,0,0,0,,Бұл бет таныс сияқты.
Dialogue: 0,0:29:52.95,0:29:55.96,Default,,0,0,0,,Бастық, мен ол кісімен айналысамын.
Dialogue: 0,0:29:56.08,0:29:59.58,Default,,0,0,0,,Жарайды, жарайды, бұл кішкентай ғана зат.
Dialogue: 0,0:30:00.13,0:30:02.71,Default,,0,0,0,,Конформисттің қашып кеткен қателігі...
Dialogue: 0,0:30:02.84,0:30:04.55,Default,,0,0,0,,Маған оны қайтаруға рұқсат етіңіз.
Dialogue: 0,0:30:04.92,0:30:09.01,Default,,0,0,0,,Оған көмектесу мүмкін емес, келесі жолы Пол емес.
Dialogue: 0,0:30:09.14,0:30:11.35,Default,,0,0,0,,Сондай-ақ, бұдан былай мені «бастық» демейді...
Dialogue: 0,0:30:11.47,0:30:13.47,Default,,0,0,0,,Оны «Қара кене» деп атаймыз.
Dialogue: 0,0:30:13.93,0:30:14.97,Default,,0,0,0,,Га
Dialogue: 0,0:30:25.15,0:30:26.61,Default,,0,0,0,,Хехе...
Dialogue: 0,0:30:26.86,0:30:29.86,Default,,0,0,0,,Ал, бастайық.
Dialogue: 0,0:30:29.99,0:30:33.66,Default,,0,0,0,,Мен «символға» айналамын—
Dialogue: 0,0:30:35.45,0:30:38.29,Default,,0,0,0,,Қараңғы кене туралы аңыздың басы!
Dialogue: 0,0:30:38.62,0:30:42.42,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,0:30:49.80,0:30:51.18,Default,,0,0,0,,- (Бакуго) Иә? - (Киришима) Не?
Dialogue: 0,0:30:51.72,0:30:52.60,Default,,0,0,0,,Жер сілкінісі?
Dialogue: 0,0:30:53.39,0:30:54.51,Default,,0,0,0,,Жоқ
Dialogue: 0,0:30:54.97,0:30:59.14,Default,,0,0,0,,Бұл біз отырған нысан қозғалуда.
Dialogue: 0,0:31:01.65,0:31:03.73,Default,,0,0,0,,Уау... қаш!
Dialogue: 0,0:31:38.73,0:31:40.94,Default,,0,0,0,,Үлкен қамал қозғала бастады!
Dialogue: 0,0:31:41.23,0:31:43.31,Default,,0,0,0,,Солтүстік-батыс аймақтағы баспанаға да шабуыл жасалды!
Dialogue: 0,0:31:43.94,0:31:47.03,Default,,0,0,0,,Панадағы адамдар да қамалға кіргізілді ме?
Dialogue: 0,0:31:47.15,0:31:50.45,Default,,0,0,0,,Әлгі адам өзін субъекті деп айтты.
Dialogue: 0,0:31:51.20,0:31:54.45,Default,,0,0,0,,Сен не істемексің?
Dialogue: 0,0:31:58.20,0:31:59.16,Default,,0,0,0,,Уф...
Dialogue: 0,0:31:59.66,0:32:00.54,Default,,0,0,0,,Біз кем дегенде сөйлесе аламыз. Ол пайдалы болады деп сенемін
Dialogue: 0,0:32:06.38,0:32:08.88,Default,,0,0,0,,- (Изуку) Бұл қабырға - (Серо) Бұл қулық па?
Dialogue: 0,0:32:09.01,0:32:10.92,Default,,0,0,0,,Бұл тұйыққа тірелген сияқты.
Dialogue: 0,0:32:11.22,0:32:14.30,Default,,0,0,0,,Қараңдар, қараңдар! Қараңызшы, мұнда қақпақ бар.
Dialogue: 0,0:32:19.06,0:32:20.93,Default,,0,0,0,,Қараңғы, мен ештеңе көрмеймін
Dialogue: 0,0:32:21.43,0:32:24.10,Default,,0,0,0,,Бірақ басқа шығулар жоқ...
Dialogue: 0,0:32:24.23,0:32:25.65,Default,,0,0,0,,Менің тергеуден басқа амалым жоқ.
Dialogue: 0,0:32:25.98,0:32:28.65,Default,,0,0,0,,Олай болса, мен және Деку кезегі.
Dialogue: 0,0:32:30.15,0:32:31.95,Default,,0,0,0,,«Салмақсыздық»
Dialogue: 0,0:32:32.86,0:32:34.99,Default,,0,0,0,,7 «Қалқымалы»
Dialogue: 0,0:32:37.12,0:32:38.66,Default,,0,0,0,,Тұзақ болуы мүмкін
Dialogue: 0,0:32:38.79,0:32:41.58,Default,,0,0,0,,Урарака-сан, сәл қашықтықтан кейін артымнан еріңіз.
Dialogue: 0,0:32:41.70,0:32:42.41,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:32:47.42,0:32:49.00,Default,,0,0,0,,Жоқ, өмірден үміт үзбе
Dialogue: 0,0:33:00.01,0:33:03.02,Default,,0,0,0,,Ол қанша уақытқа созылады? Бұл тесік...
Dialogue: 0,0:33:03.35,0:33:05.27,Default,,0,0,0,,«Идеология»
Dialogue: 0,0:33:06.19,0:33:07.06,Default,,0,0,0,,Уау
Dialogue: 0,0:33:07.44,0:33:08.86,Default,,0,0,0,,Уау!
Dialogue: 0,0:33:14.65,0:33:17.62,Default,,0,0,0,,Не? Сіздің «даралығыңыз» кенеттен жоғалып кетті ме?
Dialogue: 0,0:33:17.74,0:33:19.58,Default,,0,0,0,,Не болды, Деку-кун?
Dialogue: 0,0:33:19.70,0:33:22.20,Default,,0,0,0,,Урарака-сан, одан әрі төмен түспе!
Dialogue: 0,0:33:22.33,0:33:24.79,Default,,0,0,0,,Неге екенін білмеймін, бірақ менің "даралығым" жоғалып кетті!
Dialogue: 0,0:33:24.91,0:33:26.00,Default,,0,0,0,,«Индивидуалдылық»?
Dialogue: 0,0:33:26.33,0:33:29.38,Default,,0,0,0,,Артқа қайтып, Сероға таспаны босатуын айт!
Dialogue: 0,0:33:29.50,0:33:31.09,Default,,0,0,0,,Олар үшін де тойып жеңіздер
Dialogue: 0,0:33:31.71,0:33:33.21,Default,,0,0,0,,«Индивидуалдылықты» жою—
Dialogue: 0,0:33:33.34,0:33:36.22,Default,,0,0,0,,Айзава мырза сияқты қабілеті бар адамдар бар ма?
Dialogue: 0,0:33:36.34,0:33:37.97,Default,,0,0,0,,Іске қосу шарттары...
Dialogue: 0,0:33:38.18,0:33:40.18,Default,,0,0,0,,О... уау!
Dialogue: 0,0:33:42.27,0:33:43.93,Default,,0,0,0,,Я...
Dialogue: 0,0:33:44.39,0:33:45.69,Default,,0,0,0,,Уф... Уау...
Dialogue: 0,0:33:50.98,0:33:55.32,Default,,0,0,0,,Уау... менің кеудем!
Dialogue: 0,0:34:00.66,0:34:04.04,Default,,0,0,0,,Уау!
Dialogue: 0,0:34:17.34,0:34:19.14,Default,,0,0,0,,Мидориияның «даралығы» жойылды!?
Dialogue: 0,0:34:19.51,0:34:22.35,Default,,0,0,0,,Білмеймін, бірақ мұндай механизм бар сияқты.
Dialogue: 0,0:34:22.47,0:34:23.35,Default,,0,0,0,,Бұл...
Dialogue: 0,0:34:24.18,0:34:25.85,Default,,0,0,0,,Таспаны созсаңыз—
Dialogue: 0,0:34:25.98,0:34:28.64,Default,,0,0,0,,«Сапаңызды» жолда пайдалана алмасаңыз да, төмен түсуге болады.
Dialogue: 0,0:34:28.77,0:34:30.06,Default,,0,0,0,,Біраз уақыт қажет болды
Dialogue: 0,0:34:30.19,0:34:33.07,Default,,0,0,0,,Иә, бәрібір төмен түсейік.
Dialogue: 0,0:34:39.41,0:34:41.66,Default,,0,0,0,,Мен өлемін деп ойладым
Dialogue: 0,0:34:49.54,0:34:52.21,Default,,0,0,0,,Джунглиден кейінгі тау тұр ма?
Dialogue: 0,0:34:53.96,0:34:55.84,Default,,0,0,0,,«Индивидуалдылық» әлі қолданыла алмайды
Dialogue: 0,0:34:57.30,0:34:59.93,Default,,0,0,0,,Жақын арада барлығымен кездесуім керек.
Dialogue: 0,0:35:02.01,0:35:03.22,Default,,0,0,0,,Ах
Dialogue: 0,0:35:04.89,0:35:06.89,Default,,0,0,0,,Амансың ба!?
Dialogue: 0,0:35:08.27,0:35:10.19,Default,,0,0,0,,Егер мені өлтірсең, сен де менің сияқты қарғыс атқан жанға айналасың.
Dialogue: 0,0:35:10.31,0:35:13.23,Default,,0,0,0,,Аа, сіз жаңа ғана сөзімді бөлдіңіз.
Dialogue: 0,0:35:13.36,0:35:15.07,Default,,0,0,0,,Сіз батыр жігітсіз бе?
Dialogue: 0,0:35:15.40,0:35:16.78,Default,,0,0,0,,Гаки-сама?
Dialogue: 0,0:35:17.40,0:35:19.40,Default,,0,0,0,,Маған шығу қайда екенін айтыңызшы?
Dialogue: 0,0:35:19.70,0:35:20.91,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,0:35:21.03,0:35:23.62,Default,,0,0,0,,Мені де осында түсіріп жіберді.
Dialogue: 0,0:35:24.95,0:35:27.70,Default,,0,0,0,,Сен мүлдем пайдасыз баласың.
Dialogue: 0,0:35:28.00,0:35:30.00,Default,,0,0,0,,Сыпайы түрде қарсы алды
Dialogue: 0,0:35:30.62,0:35:32.50,Default,,0,0,0,,онда ешқандай пайда жоқ
Dialogue: 0,0:35:32.63,0:35:35.80,Default,,0,0,0,,Бір жерге барып өл.
Dialogue: 0,0:35:35.92,0:35:36.63,Default,,0,0,0,,Ум...
Dialogue: 0,0:35:40.05,0:35:42.51,Default,,0,0,0,,Сіз ол әйелді атып тастамақ болдыңыз, солай ма?
Dialogue: 0,0:35:46.18,0:35:47.60,Default,,0,0,0,,Неліктен олай істедің?
Dialogue: 0,0:35:47.72,0:35:49.85,Default,,0,0,0,,Мұның Гаки-самаға еш қатысы жоқ.
Dialogue: 0,0:35:50.73,0:35:52.98,Default,,0,0,0,,Грр... гррр...
Dialogue: 0,0:35:53.40,0:35:55.23,Default,,0,0,0,,-(Изуку) Мені өлтір... -Шоқ оқ.
Dialogue: 0,0:36:01.03,0:36:03.36,Default,,0,0,0,,Бұл адамдар, неге кенеттен?
Dialogue: 0,0:36:03.49,0:36:06.20,Default,,0,0,0,,Батырдың заманы емес пе?
Dialogue: 0,0:36:06.33,0:36:08.83,Default,,0,0,0,,Себебі мен өзімнің жеке даралығымды пайдалана алмаймын...
Dialogue: 0,0:36:09.45,0:36:12.08,Default,,0,0,0,,Сен шынымен де керексіз бала екенсің.
Dialogue: 0,0:36:13.17,0:36:14.79,Default,,0,0,0,,Уау... Уау...
Dialogue: 0,0:36:15.79,0:36:18.25,Default,,0,0,0,,Уф... Уау... Уау!
Dialogue: 0,0:36:25.85,0:36:28.31,Default,,0,0,0,,Енді оны аздап қолдануға болады.
Dialogue: 0,0:36:30.77,0:36:32.73,Default,,0,0,0,,(Шинобу) Мұнда тірі қалғандар жоқ сияқты.
Dialogue: 0,0:36:34.35,0:36:37.36,Default,,0,0,0,,Анна ханым қайда?
Dialogue: 0,0:36:38.48,0:36:39.48,Default,,0,0,0,,Анна?
Dialogue: 0,0:36:39.94,0:36:41.90,Default,,0,0,0,,Мен... білмеймін.
Dialogue: 0,0:36:42.03,0:36:45.32,Default,,0,0,0,,Білсең де, айта алмайсың.
Dialogue: 0,0:36:45.91,0:36:49.70,Default,,0,0,0,,Сіз сол жақпен бірдейсіз бе? Олай болса, саған керегі жоқ.
Dialogue: 0,0:36:49.91,0:36:51.45,Default,,0,0,0,,(миниондардың айқайы)
Dialogue: 0,0:36:51.83,0:36:54.08,Default,,0,0,0,,Сыпайы қатыгез!
Dialogue: 0,0:37:11.77,0:37:13.81,Default,,0,0,0,,Мен ауыр жүкті жақсы көтеремін.
Dialogue: 0,0:37:22.65,0:37:24.07,Default,,0,0,0,,О, бұл не?
Dialogue: 0,0:37:29.20,0:37:31.91,Default,,0,0,0,,Босқындар осында әкелінді ме?
Dialogue: 0,0:37:32.04,0:37:34.50,Default,,0,0,0,,Сіз нақты не істедіңіз?
Dialogue: 0,0:37:35.04,0:37:36.29,Default,,0,0,0,,Сәлем
Dialogue: 0,0:37:38.38,0:37:41.25,Default,,0,0,0,,Бұл кім? Мен босқынға ұқсамаймын, бірақ...
Dialogue: 0,0:37:41.80,0:37:44.84,Default,,0,0,0,,Ах, мен сені кездестірдім.
Dialogue: 0,0:37:45.17,0:37:46.76,Default,,0,0,0,,Мен сені жоғалтқаннан бері...
Dialogue: 0,0:37:46.88,0:37:49.47,Default,,0,0,0,,Мен сенімен әрқашан кездескім келді.
Dialogue: 0,0:37:52.60,0:37:53.89,Default,,0,0,0,,Гуааа…
Dialogue: 0,0:37:55.39,0:37:57.06,Default,,0,0,0,,Бұл әйел не істеді?
Dialogue: 0,0:37:57.19,0:37:58.23,Default,,0,0,0,,Оны сақтауға болады.
Dialogue: 0,0:38:00.82,0:38:03.28,Default,,0,0,0,,О, бұл батылдық емес.
Dialogue: 0,0:38:03.69,0:38:04.57,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:38:12.33,0:38:14.83,Default,,0,0,0,,Кя! Жүзім шырыны!
Dialogue: 0,0:38:14.95,0:38:16.33,Default,,0,0,0,,Зарядтау!
Dialogue: 0,0:38:17.33,0:38:19.04,Default,,0,0,0,,Иә, Китакор!
Dialogue: 0,0:38:19.17,0:38:22.71,Default,,0,0,0,,(Жақсы дауыс)
Dialogue: 0,0:38:25.92,0:38:27.26,Default,,0,0,0,,Мынау не? Менің Қорекқұмарлық Жаным (Шексіз Жұтым)
Dialogue: 0,0:38:27.72,0:38:29.22,Default,,0,0,0,,Футбол ойнайық
Dialogue: 0,0:38:29.51,0:38:31.10,Default,,0,0,0,,Шото Туя-нии!
Dialogue: 0,0:38:31.22,0:38:32.64,Default,,0,0,0,,Міне, міне!
Dialogue: 0,0:38:34.06,0:38:35.31,Default,,0,0,0,,Ажырасудың жоспары болуы керек емес пе деп ойламайсың ба?
Dialogue: 0,0:38:38.27,0:38:39.48,Default,,0,0,0,,Кочи Кокчи
Dialogue: 0,0:38:39.60,0:38:40.56,Default,,0,0,0,,Эй!
Dialogue: 0,0:38:41.73,0:38:43.73,Default,,0,0,0,,Ахаха ахахха...
Dialogue: 0,0:38:45.19,0:38:47.15,Default,,0,0,0,,Роннефельд шай жапырақтары
Dialogue: 0,0:38:47.28,0:38:49.45,Default,,0,0,0,,Ах, қандай жақсы иіс
Dialogue: 0,0:38:51.20,0:38:53.95,Default,,0,0,0,,Қос ингениум, ағайын!
Dialogue: 0,0:38:55.58,0:38:58.33,Default,,0,0,0,,Керо керо керо! Керо керо!
Dialogue: 0,0:39:02.75,0:39:06.09,Default,,0,0,0,,Керокеро Керокеро (Минета мен Каминаридің күлкісі)
Dialogue: 0,0:39:06.21,0:39:08.34,Default,,0,0,0,,Соба түскі асқа жақсы
Dialogue: 0,0:39:08.84,0:39:11.68,Default,,0,0,0,,Түсіңізде біраз уақыт ләззат алыңыз.
Dialogue: 0,0:39:12.14,0:39:14.56,Default,,0,0,0,,Мен оны кейінірек қарастырамын.
Dialogue: 0,0:39:14.68,0:39:16.81,Default,,0,0,0,,Арх!
Dialogue: 0,0:39:17.22,0:39:20.81,Default,,0,0,0,,Солай бола тұра, лайықты адамды табу қиын.
Dialogue: 0,0:39:20.94,0:39:24.94,Default,,0,0,0,,Оған көмектесу мүмкін емес, 20 000 мүшесі бар отбасында...
Dialogue: 0,0:39:25.07,0:39:27.40,Default,,0,0,0,,Бар болғаны сегіз адам болды.
Dialogue: 0,0:39:27.53,0:39:29.20,Default,,0,0,0,,'Бұл не?'
Dialogue: 0,0:39:40.79,0:39:42.88,Default,,0,0,0,,Хехе...
Dialogue: 0,0:39:43.25,0:39:48.80,Default,,0,0,0,,Қош келдіңіздер, осы қираған әлемде күресіп жатқан жас батырлар.
Dialogue: 0,0:39:49.59,0:39:51.51,Default,,0,0,0,,Бүкіл Құдірет's Pachimon жігіті!
Dialogue: 0,0:39:52.05,0:39:53.59,Default,,0,0,0,,Бұл қара кене.
Dialogue: 0,0:39:53.72,0:39:57.43,Default,,0,0,0,,Мен мұны өзім шештім. Жақсы есім емес пе?
Dialogue: 0,0:39:58.18,0:40:01.52,Default,,0,0,0,,Бізді осындай жерге әкеліп, не істемексің?
Dialogue: 0,0:40:01.77,0:40:03.94,Default,,0,0,0,,Неліктен әлемнің түкпір-түкпірінен Бүкіл Құдірет?
Dialogue: 0,0:40:04.06,0:40:05.86,Default,,0,0,0,,Сіз құрметке ие болдыңыз ба?
Dialogue: 0,0:40:05.98,0:40:09.11,Default,,0,0,0,,Сіз бұл туралы шындап ойладыңыз ба?
Dialogue: 0,0:40:09.44,0:40:11.57,Default,,0,0,0,,Адамдар күшке тартылады.
Dialogue: 0,0:40:11.70,0:40:15.62,Default,,0,0,0,,Иә, күш - бұл ойын-сауық
Dialogue: 0,0:40:15.74,0:40:18.58,Default,,0,0,0,,Бұл нысан, жұмақ символы, —
Dialogue: 0,0:40:18.70,0:40:20.54,Default,,0,0,0,,Бейбітшілік белгісі
Dialogue: 0,0:40:20.66,0:40:23.29,Default,,0,0,0,,Сіз бұл жерді қорғайтын рыцарь болуға лайықсыз ба?
Dialogue: 0,0:40:23.42,0:40:24.88,Default,,0,0,0,,Тест орындайық
Dialogue: 0,0:40:25.00,0:40:27.96,Default,,0,0,0,,Егер біз оны тазарта алсақ, онда біз жолдастармыз.
Dialogue: 0,0:40:28.55,0:40:31.72,Default,,0,0,0,,«Рәміз» атанған сәтімді бірге тойлайық.
Dialogue: 0,0:40:31.84,0:40:33.76,Default,,0,0,0,,Тарихты бірге жасайық
Dialogue: 0,0:40:33.88,0:40:36.01,Default,,0,0,0,,Түсінсең қолыңды көтер.
Dialogue: 0,0:40:36.14,0:40:37.18,Default,,0,0,0,,Иә!
Dialogue: 0,0:40:38.47,0:40:41.85,Default,,0,0,0,,Сәлем! Бір-біріне ұқсайтын жалғыз нәрсе ме?
Dialogue: 0,0:40:42.31,0:40:43.73,Default,,0,0,0,,Хмм...
Dialogue: 0,0:40:43.85,0:40:47.36,Default,,0,0,0,,Түсіндім... жоқ!
Dialogue: 0,0:40:47.57,0:40:49.48,Default,,0,0,0,,Бұл шоу уақыты!
Dialogue: 0,0:40:50.99,0:40:53.03,Default,,0,0,0,,(Бакуго мен оның достарының таңданған дауыстары)
Dialogue: 0,0:40:54.74,0:40:55.91,Default,,0,0,0,,Бұл қай жер?
Dialogue: 0,0:40:56.82,0:40:59.29,Default,,0,0,0,,Ойын зынданына қараңыз
Dialogue: 0,0:40:59.66,0:41:01.91,Default,,0,0,0,,Көңіл көтеру деген осы ма?
Dialogue: 0,0:41:02.04,0:41:04.00,Default,,0,0,0,,Бұл адамға бірдеңе дұрыс емес.
Dialogue: 0,0:41:04.12,0:41:05.17,Default,,0,0,0,,Уау!
Dialogue: 0,0:41:06.21,0:41:07.46,Default,,0,0,0,,Бұл құбыжық!
Dialogue: 0,0:41:09.00,0:41:11.63,Default,,0,0,0,,Сіз барлық зындандарды тазаладыңыз ба?
Dialogue: 0,0:41:11.92,0:41:14.01,Default,,0,0,0,,Әзірше мен бұл жерден кетуім керек...
Dialogue: 0,0:41:14.26,0:41:16.09,Default,,0,0,0,,Сөйлесудің қажеті жоқ!
Dialogue: 0,0:41:17.68,0:41:19.39,Default,,0,0,0,,ДжоДжо қарсы Вамуу—
Dialogue: 0,0:41:19.76,0:41:21.52,Default,,0,0,0,,Тодороки, үшінші раундқа өтті!
Dialogue: 0,0:41:23.14,0:41:24.69,Default,,0,0,0,,Ал кеттік, балалар!
Dialogue: 0,0:41:26.81,0:41:28.19,Default,,0,0,0,,Еркін шайқас!
Dialogue: 0,0:41:28.52,0:41:30.94,Default,,0,0,0,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,0:41:34.70,0:41:36.61,Default,,0,0,0,,Хехе...
Dialogue: 0,0:41:37.28,0:41:41.08,Default,,0,0,0,,Енді қанша адам өмір сүре алады?
Dialogue: 0,0:41:43.91,0:41:46.08,Default,,0,0,0,,Маған мінуге рұқсат бергеніңіз үшін рахмет.
Dialogue: 0,0:41:46.21,0:41:47.83,Default,,0,0,0,,Әдептілікке лайық емес
Dialogue: 0,0:41:47.96,0:41:51.42,Default,,0,0,0,,Төтенше жағдайда өзіңізді оқтан қорғау үшін пайдалана аласыз.
Dialogue: 0,0:41:51.71,0:41:53.38,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:41:53.51,0:41:55.42,Default,,0,0,0,,Сонда сіз қайда барасыз?
Dialogue: 0,0:41:56.63,0:41:59.60,Default,,0,0,0,,Мен оны бұрын Зако мырзадан алғанмын.
Dialogue: 0,0:42:00.01,0:42:02.10,Default,,0,0,0,,Егер бұл «жекелікті» қолдануға болмайтын жер болса —
Dialogue: 0,0:42:02.22,0:42:04.77,Default,,0,0,0,,Бір жерде физикалық кіреберіс болуы керек
Dialogue: 0,0:42:09.61,0:42:12.07,Default,,0,0,0,,Бұл бингоға ұқсайды.
Dialogue: 0,0:42:21.03,0:42:23.58,Default,,0,0,0,,Неліктен бізге шабуыл жасалды?
Dialogue: 0,0:42:23.70,0:42:26.08,Default,,0,0,0,,Менің ойымша, бұл біз емес, мен.
Dialogue: 0,0:42:26.21,0:42:27.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:42:27.33,0:42:30.00,Default,,0,0,0,,Мен жас ханымды нысанаға алғанымды білгенде...
Dialogue: 0,0:42:30.13,0:42:31.84,Default,,0,0,0,,Мүмкін олар бұл кедергі деп ойлаған шығар.
Dialogue: 0,0:42:34.55,0:42:35.71,Default,,0,0,0,,Сіз неге...
Dialogue: 0,0:42:35.84,0:42:36.63,Default,,0,0,0,,Ах!
Dialogue: 0,0:42:40.64,0:42:41.80,Default,,0,0,0,,Қазір ғана…
Dialogue: 0,0:42:57.86,0:42:58.82,Default,,0,0,0,,Түсіру
Dialogue: 0,0:43:02.20,0:43:03.33,Default,,0,0,0,,Рух толқыны ма?
Dialogue: 0,0:43:09.87,0:43:11.33,Default,,0,0,0,,«Индивидуалдылықты» пайдалану
Dialogue: 0,0:43:11.83,0:43:13.09,Default,,0,0,0,,Мен бұрын мылтық қолданғанмын...
Dialogue: 0,0:43:13.63,0:43:15.80,Default,,0,0,0,,Мен «индивидуалдылықты» пайдаланбадым
Dialogue: 0,0:43:16.34,0:43:20.01,Default,,0,0,0,,Неліктен бұл адам Аннаның өмірін мақсат етіп отыр?
Dialogue: 0,0:43:20.13,0:43:22.34,Default,,0,0,0,,Мен жас ханымға уәде бердім.
Dialogue: 0,0:43:22.80,0:43:24.51,Default,,0,0,0,,Ханым?
Dialogue: 0,0:43:24.64,0:43:27.22,Default,,0,0,0,,Сіз Шелбиноның қолдарының бірісіз бе?
Dialogue: 0,0:43:27.60,0:43:29.23,Default,,0,0,0,,Шелбино?
Dialogue: 0,0:43:29.85,0:43:33.52,Default,,0,0,0,,Өтінемін, жас ханым енді өзінің «даралығын» пайдаланбасын.
Dialogue: 0,0:43:33.65,0:43:34.98,Default,,0,0,0,,Сіз—
Dialogue: 0,0:43:35.11,0:43:38.44,Default,,0,0,0,,Мен жас ханымның «даралығы» қандай екенін білмеймін.
Dialogue: 0,0:43:38.57,0:43:40.20,Default,,0,0,0,,Ол әлі оралмады ма?
Dialogue: 0,0:43:40.32,0:43:44.28,Default,,0,0,0,,Анна – бастықтың мұраттарын жүзеге асыруға қажетті құрал.
Dialogue: 0,0:43:45.24,0:43:47.70,Default,,0,0,0,,Солай ма? Содан кейін-
Dialogue: 0,0:43:47.83,0:43:50.00,Default,,0,0,0,,Мен күшімді жұмсаймын.
Dialogue: 0,0:43:57.76,0:44:00.05,Default,,0,0,0,,Ол жерден бәрі қозғалмайды.
Dialogue: 0,0:44:00.80,0:44:04.22,Default,,0,0,0,,Егер бұл адам өзінің «даралығын» басып тастаса, онда сөзсіз...
Dialogue: 0,0:44:08.56,0:44:09.98,Default,,0,0,0,,Мен жақсылық жасай аламын ба?
Dialogue: 0,0:44:10.10,0:44:11.06,Default,,0,0,0,,Мен оны жасасам ше?
Dialogue: 0,0:44:11.44,0:44:12.31,Default,,0,0,0,,Жеңіліс
Dialogue: 0,0:44:14.56,0:44:16.52,Default,,0,0,0,,Олай болса жолбарыстың күшігін шығарайық.
Dialogue: 0,0:44:27.91,0:44:28.79,Default,,0,0,0,,Олар қосымша күш әкелді.
Dialogue: 0,0:44:40.09,0:44:41.34,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:44:42.97,0:44:44.01,Default,,0,0,0,,Сіз оны пайдалана аласыз!
Dialogue: 0,0:44:44.55,0:44:45.47,Default,,0,0,0,,Гррр…
Dialogue: 0,0:44:48.26,0:44:49.35,Default,,0,0,0,,Уф... а
Dialogue: 0,0:44:51.23,0:44:52.23,Default,,0,0,0,,Мен ойлағандай.
Dialogue: 0,0:44:53.02,0:44:55.15,Default,,0,0,0,,«Индивидуалдылықты» жарамсыз ететін кеңістік
Dialogue: 0,0:44:55.27,0:44:57.77,Default,,0,0,0,,Бірақ одақтастың «даралығын» белсендіру үшін —
Dialogue: 0,0:44:57.90,0:45:00.36,Default,,0,0,0,,Тек менің айналамдағыларда жоқ
Dialogue: 0,0:45:00.61,0:45:02.07,Default,,0,0,0,,Ооо!
Dialogue: 0,0:45:09.45,0:45:10.62,Default,,0,0,0,,Уф...
Dialogue: 0,0:45:11.83,0:45:13.00,Default,,0,0,0,,Маған қашып кетуге жол берме!
Dialogue: 0,0:45:13.71,0:45:16.58,Default,,0,0,0,,Манчестер соққысы!
Dialogue: 0,0:45:16.71,0:45:18.04,Default,,0,0,0,,Уау!
Dialogue: 0,0:45:23.22,0:45:25.38,Default,,0,0,0,,«Индивидуалдылық» толығымен қайтарылды
Dialogue: 0,0:45:26.09,0:45:27.51,Default,,0,0,0,,Көмегің үшін рахмет...
Dialogue: 0,0:45:27.93,0:45:28.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:45:32.77,0:45:35.02,Default,,0,0,0,,Қайта кездескенше балам
Dialogue: 0,0:45:35.14,0:45:38.81,Default,,0,0,0,,Сізде бірнеше «жеке тұлғалар» бар сияқты.
Dialogue: 0,0:45:38.94,0:45:43.03,Default,,0,0,0,,Менің алдыңғы ағам айтқан «келесі сеніп тапсырылған адам» ...
Dialogue: 0,0:45:43.15,0:45:44.74,Default,,0,0,0,,Мүмкін сіз?
Dialogue: 0,0:45:47.82,0:45:51.74,Default,,0,0,0,,Хехехе... Батыр болсаң да, тосын шабуыл деген не?
Dialogue: 0,0:45:52.12,0:45:56.00,Default,,0,0,0,,Сіз не істемексіз? Сіз не жоспарлап отырсыз?
Dialogue: 0,0:45:56.42,0:46:00.54,Default,,0,0,0,,Жоғарыда айтқанымдай, ол «символға» айналады.
Dialogue: 0,0:46:00.67,0:46:03.76,Default,,0,0,0,,Бұл мен, Қараңғы кене
Dialogue: 0,0:46:04.21,0:46:05.55,Default,,0,0,0,,Қараңғы кене?
Dialogue: 0,0:46:05.67,0:46:09.01,Default,,0,0,0,,Құдіретті асқанның аты
Dialogue: 0,0:46:10.18,0:46:14.89,Default,,0,0,0,,Болонья соққысы!
Dialogue: 0,0:46:15.02,0:46:17.31,Default,,0,0,0,,Қандай...қуат...
Dialogue: 0,0:46:32.70,0:46:33.74,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:46:44.17,0:46:45.34,Default,,0,0,0,,Ах!
Dialogue: 0,0:46:45.46,0:46:47.59,Default,,0,0,0,,А... а... а!
Dialogue: 0,0:46:51.47,0:46:52.85,Default,,0,0,0,,Бастық… Бастық…
Dialogue: 0,0:46:52.97,0:46:56.18,Default,,0,0,0,,Пол, Павел!
Dialogue: 0,0:46:56.31,0:46:58.39,Default,,0,0,0,,Бұл өте өкінішті.
Dialogue: 0,0:46:58.73,0:47:01.52,Default,,0,0,0,,Күте тұрыңыз, бастық, маған тағы бір мүмкіндік беріңіз!
Dialogue: 0,0:47:02.27,0:47:04.32,Default,,0,0,0,,Басын кесіп тастағаныма қарамастан…
Dialogue: 0,0:47:04.44,0:47:08.65,Default,,0,0,0,,Иә, бұл сөздерге сеніп, келесісін кешірдім.
Dialogue: 0,0:47:08.78,0:47:11.41,Default,,0,0,0,,Бұдан басқа не болды деп ойлайсың?
Dialogue: 0,0:47:11.78,0:47:12.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:47:13.33,0:47:16.62,Default,,0,0,0,,Сіз жалқаусыз! Бұл өлімге әкелетін күнәлардың бірі
Dialogue: 0,0:47:17.12,0:47:20.46,Default,,0,0,0,,Қанша ақымақ Голинидің атына кір келтірді?
Dialogue: 0,0:47:20.71,0:47:21.58,Default,,0,0,0,,Уф...
Dialogue: 0,0:47:23.42,0:47:26.71,Default,,0,0,0,,Бүкіл Құдірет ешқашан жеңілген емес.
Dialogue: 0,0:47:27.84,0:47:30.34,Default,,0,0,0,,Мен енді жеңілмеймін! Сәтсіздікке жол бермеңіз!
Dialogue: 0,0:47:30.47,0:47:32.26,Default,,0,0,0,,Әрқашан тапсырманы орындаңыз!
Dialogue: 0,0:47:34.18,0:47:35.43,Default,,0,0,0,,Я...
Dialogue: 0,0:47:35.56,0:47:39.31,Default,,0,0,0,,Мейірімділік таныту да бейбітшілікке қадам ба...
Dialogue: 0,0:47:39.43,0:47:41.02,Default,,0,0,0,,А... Мен жеңілдеп қалдым...
Dialogue: 0,0:47:42.48,0:47:46.07,Default,,0,0,0,,Қайта туып, маған қайта кел
Dialogue: 0,0:47:51.49,0:47:53.91,Default,,0,0,0,,Ой... Уау!
Dialogue: 0,0:47:56.20,0:47:57.58,Default,,0,0,0,,Дио, жүрегім ауыр.
Dialogue: 0,0:47:58.87,0:47:59.75,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:48:00.25,0:48:02.67,Default,,0,0,0,,Мына балаға айтыңыз
Dialogue: 0,0:48:02.79,0:48:08.26,Default,,0,0,0,,Осы «символымның» ұлылығын түсініп, онымен бірге жүруді ұйғарғанша.
Dialogue: 0,0:48:08.38,0:48:11.30,Default,,0,0,0,,Қайталап көріңіз.
Dialogue: 0,0:48:21.69,0:48:22.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:48:25.11,0:48:28.28,Default,,0,0,0,,Бетімді ауыртпа
Dialogue: 0,0:48:30.94,0:48:34.36,Default,,0,0,0,,Біз сені дұрыс тәрбиелеуіміз керек.
Dialogue: 0,0:48:34.82,0:48:37.20,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,0:48:39.66,0:48:40.50,Default,,0,0,0,,(Ватару) Не болып жатыр? Бұл әңгіме… (Ер оқушы) Ол ұялы телефонымен дауласып жатыр.
Dialogue: 0,0:48:41.50,0:48:43.62,Default,,0,0,0,,Джунглиден кейінгі тау тұр ма?
Dialogue: 0,0:48:43.96,0:48:47.42,Default,,0,0,0,,«Индивидуалдылықты» жарамсыз ететін механизм болған жоқ.
Dialogue: 0,0:48:47.54,0:48:49.17,Default,,0,0,0,,Мүмкін Мидория бірдеңе істеген шығар.
Dialogue: 0,0:48:49.55,0:48:51.63,Default,,0,0,0,,Бұл Деку-кун қайда?
Dialogue: 0,0:48:52.51,0:48:56.05,Default,,0,0,0,,үшін? Апыр-ай!
Dialogue: 0,0:49:03.02,0:49:05.48,Default,,0,0,0,,- (Очако) Иә? сурет? - (Серо) Сен қайдасың?
Dialogue: 0,0:49:06.77,0:49:07.65,Default,,0,0,0,,Ах!
Dialogue: 0,0:49:08.57,0:49:10.03,Default,,0,0,0,,Қан жарылысы!
Dialogue: 0,0:49:12.90,0:49:17.45,Default,,0,0,0,,А... мұнда ешкім жете алмады ма?
Dialogue: 0,0:49:17.57,0:49:20.29,Default,,0,0,0,,Костюм дайындауға бар күшімді салып кетсем де...
Dialogue: 0,0:49:23.21,0:49:25.62,Default,,0,0,0,,Теми соңғы бастық па?
Dialogue: 0,0:49:28.50,0:49:30.09,Default,,0,0,0,,Төте жол!?
Dialogue: 0,0:49:30.21,0:49:33.01,Default,,0,0,0,,Сіз ойында адам сенбейтін нәрсе жасадыңыз...
Dialogue: 0,0:49:33.13,0:49:34.93,Default,,0,0,0,,Көңіл көтеру дегенді қалай түсінесіңдер?
Dialogue: 0,0:49:41.60,0:49:43.14,Default,,0,0,0,,Бұл жай қулық
Dialogue: 0,0:49:45.81,0:49:46.69,Default,,0,0,0,,Уау!
Dialogue: 0,0:49:47.35,0:49:49.73,Default,,0,0,0,,Керемет жұмыс!
Dialogue: 0,0:49:49.86,0:49:53.15,Default,,0,0,0,,Бірақ ойын әлі аяқталған жоқ.
Dialogue: 0,0:50:02.08,0:50:03.91,Default,,0,0,0,,Ағамның қабіріне барып болған соң, бірдеңе жейік, Жосуке.
Dialogue: 0,0:50:12.55,0:50:13.88,Default,,0,0,0,,Уф...
Dialogue: 0,0:50:14.38,0:50:16.01,Default,,0,0,0,,Байқадыңыз ба?
Dialogue: 0,0:50:16.55,0:50:18.39,Default,,0,0,0,,Ах... иә?
Dialogue: 0,0:50:18.51,0:50:19.34,Default,,0,0,0,,Ha
Dialogue: 0,0:50:19.72,0:50:22.97,Default,,0,0,0,,Сен мені құтқардың, иә... уф...
Dialogue: 0,0:50:23.10,0:50:27.06,Default,,0,0,0,,Рахмет, мен Изуку Мидориямын.
Dialogue: 0,0:50:27.19,0:50:28.60,Default,,0,0,0,,Батырдың аты «Деку»
Dialogue: 0,0:50:29.27,0:50:31.57,Default,,0,0,0,,Бұл Джулио. Джулио Гандини.
Dialogue: 0,0:50:32.36,0:50:34.48,Default,,0,0,0,,Рахмет, Хулио.
Dialogue: 0,0:50:34.90,0:50:37.24,Default,,0,0,0,,Жақсы ниет мені құтқармады.
Dialogue: 0,0:50:37.36,0:50:39.87,Default,,0,0,0,,Өйткені бұл пайдалы болар деп ойладым.
Dialogue: 0,0:50:39.99,0:50:41.49,Default,,0,0,0,,Сонда да рахмет
Dialogue: 0,0:50:42.83,0:50:45.75,Default,,0,0,0,,Деку... Бұл ерекше есім.
Dialogue: 0,0:50:46.83,0:50:48.50,Default,,0,0,0,,Маған ұнайды.
Dialogue: 0,0:50:53.21,0:50:56.92,Default,,0,0,0,,Уау, мұндай қала бар ма?
Dialogue: 0,0:50:57.72,0:50:59.72,Default,,0,0,0,,-Бұл... -(Изуку) А?
Dialogue: 0,0:51:04.85,0:51:07.52,Default,,0,0,0,,Сәлем... бәріңе!
Dialogue: 0,0:51:09.52,0:51:11.73,Default,,0,0,0,,Рейхи мырза, Рейхи мырза
Dialogue: 0,0:51:13.32,0:51:14.90,Default,,0,0,0,,(Бакуго) Хмм… (Изуку) Ааах!
Dialogue: 0,0:51:21.03,0:51:23.41,Default,,0,0,0,,Жер бетінде не?
Dialogue: 0,0:51:23.91,0:51:28.16,Default,,0,0,0,,Жас келіншектің «тұлғасы» сәйкес келмей, кері байланыс алған шығар.
Dialogue: 0,0:51:28.29,0:51:29.29,Default,,0,0,0,,Жас келіншек...
Dialogue: 0,0:51:30.83,0:51:32.58,Default,,0,0,0,,Анна екеніне сенімдімін
Dialogue: 0,0:51:32.71,0:51:35.55,Default,,0,0,0,,Иә, Анна Щервино.
Dialogue: 0,0:51:35.67,0:51:37.26,Default,,0,0,0,,Аннаның «даралығы» неде?
Dialogue: 0,0:51:37.34,0:51:37.96,Default,,0,0,0,,Бұл...
Dialogue: 0,0:51:38.09,0:51:40.51,Default,,0,0,0,,Арх!
Dialogue: 0,0:51:40.97,0:51:42.34,Default,,0,0,0,,- (Изуку) Оджиро-кун! -Ханым!
Dialogue: 0,0:51:42.76,0:51:45.85,Default,,0,0,0,,Ой, бұл жаңа тақырып па?
Dialogue: 0,0:51:46.18,0:51:47.56,Default,,0,0,0,,Тақырып?
Dialogue: 0,0:51:47.68,0:51:51.77,Default,,0,0,0,,Жас ханымның «даралығына» сәйкес келетін адамдар санын көбейтіп, оларды жеке әскерге айналдырыңыз.
Dialogue: 0,0:51:52.27,0:51:56.86,Default,,0,0,0,,Иә, сіз «символға» айналып, Қараңғы кененің қызметшісі бола аласыз.
Dialogue: 0,0:51:57.19,0:51:58.86,Default,,0,0,0,,Мына балалар сияқты
Dialogue: 0,0:51:59.44,0:52:03.37,Default,,0,0,0,,Сыйыспайтындар да игілікке жұмсалады.
Dialogue: 0,0:52:04.16,0:52:05.70,Default,,0,0,0,,Менің «даралығыммен»
Dialogue: 0,0:52:06.74,0:52:09.37,Default,,0,0,0,,Жас келіншектің миын шайған сен бе?
Dialogue: 0,0:52:09.75,0:52:11.62,Default,,0,0,0,,Бұл миды жуу емес.
Dialogue: 0,0:52:11.75,0:52:14.50,Default,,0,0,0,,Анна тәтті түс көріп жатыр
Dialogue: 0,0:52:14.79,0:52:18.59,Default,,0,0,0,,Менің «индивидуалдылығым» әдетте бір адамға ғана қолданылуы мүмкін.
Dialogue: 0,0:52:18.71,0:52:21.42,Default,,0,0,0,,Осы баланың «даралығымен» үйлесімді болуының арқасында—
Dialogue: 0,0:52:21.55,0:52:24.89,Default,,0,0,0,,Енді сіз армандарды бірнеше адамға көрсете аласыз.
Dialogue: 0,0:52:25.35,0:52:28.93,Default,,0,0,0,,Сондықтан мен саған да көрсетемін.
Dialogue: 0,0:52:29.06,0:52:32.06,Default,,0,0,0,,Менің әлеміме кел
Dialogue: 0,0:52:32.52,0:52:34.02,Default,,0,0,0,,Ах!
Dialogue: 0,0:52:36.98,0:52:37.94,Default,,0,0,0,,Осылайша тәжірибеңіз артады және көпшіліктің назарын аударасыз
Dialogue: 0,0:52:38.57,0:52:39.32,Default,,0,0,0,,Осылайша тәжірибеңіз артады және көпшіліктің назарын аударасыз
Dialogue: 0,0:52:40.03,0:52:41.32,Default,,0,0,0,,Осылайша тәжірибеңіз артады және көпшіліктің назарын аударасыз
Dialogue: 0,0:52:41.78,0:52:44.78,Default,,0,0,0,,Уау, бәрі мүмкін!
Dialogue: 0,0:52:45.07,0:52:48.70,Default,,0,0,0,,Осындай бақытты Мидорий балаға...
Dialogue: 0,0:52:48.83,0:52:51.08,Default,,0,0,0,,Мен осындамын!
Dialogue: 0,0:52:51.20,0:52:54.29,Default,,0,0,0,,Бәрі мүмкін! Бұл шынайы!
Dialogue: 0,0:52:54.58,0:52:57.84,Default,,0,0,0,,Кеттік! Жас Мидория Жоқ, Деку!
Dialogue: 0,0:52:57.96,0:52:59.75,Default,,0,0,0,,Әлемді бірге құтқарайық!
Dialogue: 0,0:52:59.88,0:53:00.55,Default,,0,0,0,,Иә!
Dialogue: 0,0:53:01.42,0:53:02.59,Default,,0,0,0,,Жоқ
Dialogue: 0,0:53:03.55,0:53:06.76,Default,,0,0,0,,Бұл дәл қазір сіз іздеп жүрген нәрсе емес шығар.
Dialogue: 0,0:53:11.56,0:53:12.68,Default,,0,0,0,,Мен әлі де оның өлуін қалаймын!
Dialogue: 0,0:53:13.89,0:53:17.36,Default,,0,0,0,,Бұл былайша айтқанда, психикалық қиял кеңістігі сияқты.
Dialogue: 0,0:53:18.15,0:53:20.90,Default,,0,0,0,,Жаманның «даралығын» алғандардың рухы...
Dialogue: 0,0:53:21.03,0:53:22.57,Default,,0,0,0,,Осы кеңістікте жиналған
Dialogue: 0,0:53:23.45,0:53:26.78,Default,,0,0,0,,Есімді жисам да, бұл жерден шыға алмаймын.
Dialogue: 0,0:53:27.57,0:53:30.16,Default,,0,0,0,,Қашу жолын табыңыз
Dialogue: 0,0:53:32.41,0:53:35.12,Default,,0,0,0,,Сіз қалай іздейсіз?
Dialogue: 0,0:53:36.54,0:53:37.63,Default,,0,0,0,,Ах
Dialogue: 0,0:53:41.13,0:53:43.01,Default,,0,0,0,,Сол адам...
Dialogue: 0,0:53:45.18,0:53:47.80,Default,,0,0,0,,Хулио, менімен бір уақытта шай ішкің келе ме?
Dialogue: 0,0:53:48.47,0:53:52.06,Default,,0,0,0,,Жоқ, мен жай қызметшімін.
Dialogue: 0,0:53:52.18,0:53:54.27,Default,,0,0,0,,Сіз бұрынғыдай скучносыз.
Dialogue: 0,0:53:59.36,0:54:00.27,Default,,0,0,0,,Хехе...
Dialogue: 0,0:54:01.82,0:54:02.53,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:54:04.03,0:54:04.86,Default,,0,0,0,,Ах!
Dialogue: 0,0:54:05.65,0:54:07.66,Default,,0,0,0,,- Уф... - Ханым
Dialogue: 0,0:54:13.08,0:54:14.41,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:54:23.21,0:54:24.55,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:54:25.01,0:54:27.13,Default,,0,0,0,,(Джулионың қатты тыныс алуы)
Dialogue: 0,0:54:27.93,0:54:30.60,Default,,0,0,0,,Хулио, кешіріңіз.
Dialogue: 0,0:54:30.72,0:54:34.27,Default,,0,0,0,,Мен өзімнің «даралығым» үшін сізге қиындық тудырдым...
Dialogue: 0,0:54:34.39,0:54:35.85,Default,,0,0,0,,Үйде байланған...
Dialogue: 0,0:54:38.73,0:54:42.02,Default,,0,0,0,,Жарайды, бұл менің жұмысым.
Dialogue: 0,0:54:42.90,0:54:46.70,Default,,0,0,0,,Мен сенімен бірге болғанда ғана мен «еркінсіз» бола аламын
Dialogue: 0,0:54:46.82,0:54:49.11,Default,,0,0,0,,«Индивидуалдылықтан» зардап шегудің қажеті жоқ
Dialogue: 0,0:54:49.24,0:54:52.33,Default,,0,0,0,,Бірақ сен кеткенде мен...
Dialogue: 0,0:54:52.87,0:54:53.95,Default,,0,0,0,,Мен сенің жаныңда боламын
Dialogue: 0,0:54:55.37,0:54:56.41,Default,,0,0,0,,Хулио
Dialogue: 0,0:54:58.79,0:55:00.67,Default,,0,0,0,,Өйткені бұл менің жұмысым.
Dialogue: 0,0:55:06.55,0:55:08.97,Default,,0,0,0,,Түсіндім, бұл солай.
Dialogue: 0,0:55:09.88,0:55:12.85,Default,,0,0,0,,Мен сіздің мақсатыңызды түсінемін.
Dialogue: 0,0:55:12.97,0:55:16.64,Default,,0,0,0,,Олай болса қызық аяқталды
Dialogue: 0,0:55:18.18,0:55:22.36,Default,,0,0,0,,Гррр... иә... тоқтаңызшы, жас ханым.
Dialogue: 0,0:55:25.86,0:55:26.90,Default,,0,0,0,,Хулио мырза!
Dialogue: 0,0:55:27.32,0:55:29.82,Default,,0,0,0,,Бұл шындық емес, елес.
Dialogue: 0,0:55:29.95,0:55:31.74,Default,,0,0,0,,Сау болыңыз!
Dialogue: 0,0:55:32.41,0:55:33.87,Default,,0,0,0,,Иллюзия?
Dialogue: 0,0:55:34.58,0:55:37.33,Default,,0,0,0,,А... неге қол?
Dialogue: 0,0:55:38.00,0:55:39.46,Default,,0,0,0,,Түсіндім, бұл...
Dialogue: 0,0:55:40.29,0:55:41.37,Default,,0,0,0,,Нақты емес
Dialogue: 0,0:55:44.59,0:55:46.21,Default,,0,0,0,,Шындық бұл...
Dialogue: 0,0:55:46.80,0:55:47.46,Default,,0,0,0,,Бұл – Огимотоя.
Dialogue: 0,0:55:47.76,0:55:49.01,Default,,0,0,0,,Ах!
Dialogue: 0,0:55:51.55,0:55:52.97,Default,,0,0,0,,Иә? Ах!
Dialogue: 0,0:55:53.09,0:55:54.51,Default,,0,0,0,,(Джулионың жөтелі)
Dialogue: 0,0:55:55.31,0:55:57.39,Default,,0,0,0,,Қарғыс атсын... Болды.
Dialogue: 0,0:55:57.52,0:56:01.27,Default,,0,0,0,,Менің «даралығымнан» қашу
Dialogue: 0,0:56:01.52,0:56:02.31,Default,,0,0,0,,Ха!
Dialogue: 0,0:56:03.65,0:56:05.15,Default,,0,0,0,,Хулио?
Dialogue: 0,0:56:06.23,0:56:07.53,Default,,0,0,0,,Ол келді.
Dialogue: 0,0:56:09.53,0:56:10.78,Default,,0,0,0,,Хулио!
Dialogue: 0,0:56:12.78,0:56:13.82,Default,,0,0,0,,Хулио мырза!?
Dialogue: 0,0:56:18.91,0:56:20.66,Default,,0,0,0,,Өтінемін, Хулио
Dialogue: 0,0:56:21.00,0:56:25.38,Default,,0,0,0,,Егер бірдеңе болса... мен әлі мен бола алатын болсам...
Dialogue: 0,0:56:26.59,0:56:27.96,Default,,0,0,0,,Достар...?
Dialogue: 0,0:56:28.59,0:56:29.42,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:56:39.93,0:56:41.43,Default,,0,0,0,,Неге...
Dialogue: 0,0:56:42.64,0:56:43.90,Default,,0,0,0,,Неліктен!?
Dialogue: 0,0:56:44.15,0:56:46.61,Default,,0,0,0,,Сіз жай ғана аузыңызды жауып, көре аласыз...
Dialogue: 0,0:56:46.73,0:56:47.61,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:56:47.98,0:56:50.86,Default,,0,0,0,,(Аннаның айқайы)
Dialogue: 0,0:57:05.67,0:57:06.92,Default,,0,0,0,,- (Изуку) Хулио... -Неге!?
Dialogue: 0,0:57:07.84,0:57:09.55,Default,,0,0,0,,Неге араластың!?
Dialogue: 0,0:57:09.67,0:57:11.46,Default,,0,0,0,,Батыр болып көрінген екіжүзді!
Dialogue: 0,0:57:11.97,0:57:15.68,Default,,0,0,0,,Ештеңені түсінбесең де, мойыныңды шығарасың!
Dialogue: 0,0:57:15.80,0:57:19.72,Default,,0,0,0,,Соңғы... Бұл сіздің соңғы мүмкіндігіңіз болуы мүмкін!
Dialogue: 0,0:57:20.52,0:57:22.60,Default,,0,0,0,,Мен оның мені атқанын қаламадым.
Dialogue: 0,0:57:22.73,0:57:25.23,Default,,0,0,0,,Себебі сен қайғылы көріндің.
Dialogue: 0,0:57:27.40,0:57:31.53,Default,,0,0,0,,Себебі мен оның Аннаны құтқарғысы келетінін сезіндім.
Dialogue: 0,0:57:31.65,0:57:34.40,Default,,0,0,0,,Қарғыс атқыр... мені құтқар!
Dialogue: 0,0:57:34.53,0:57:36.95,Default,,0,0,0,,А, мен сені құтқара алатыныма сенімдімін!
Dialogue: 0,0:57:38.83,0:57:40.54,Default,,0,0,0,,Бірақ бұл енді жақсы емес
Dialogue: 0,0:57:41.41,0:57:43.46,Default,,0,0,0,,Менің сені өлтіруден басқа амалым жоқ.
Dialogue: 0,0:57:44.96,0:57:47.38,Default,,0,0,0,,Неліктен мен оны өлтіруім керек?
Dialogue: 0,0:57:48.08,0:57:51.59,Default,,0,0,0,,Өйткені ол баланың қалауы осы.
Dialogue: 0,0:57:53.13,0:57:58.22,Default,,0,0,0,,Оның «индивидуалдылығы» - үнемі белсендірілетін «индивидуалдылық факторының» «шамадан тыс өзгеруі».
Dialogue: 0,0:57:59.01,0:58:03.02,Default,,0,0,0,,Сіз түртетін адамдарға түрлендіруші «жекелік факторларын» жіберу—
Dialogue: 0,0:58:03.14,0:58:07.23,Default,,0,0,0,,Белгілі бір уақыт аралығында мақсаттың «даралығын» нығайтады және түрлендіреді.
Dialogue: 0,0:58:07.90,0:58:11.77,Default,,0,0,0,,Алайда, егер ол оның «тұлға факторына» сәйкес келмесе...
Dialogue: 0,0:58:11.90,0:58:14.36,Default,,0,0,0,,Азап
Dialogue: 0,0:58:14.99,0:58:18.99,Default,,0,0,0,,Оның осындай «тұлғасы» бар. Ол адамдармен араласудан қорқуы керек.
Dialogue: 0,0:58:19.87,0:58:22.49,Default,,0,0,0,,Біз алғаш кездескен кезде ол...
Dialogue: 0,0:58:22.62,0:58:27.00,Default,,0,0,0,,Мен өз бөлмемде тыныш өмір сүрдім, тынысымды басып.
Dialogue: 0,0:58:27.29,0:58:31.92,Default,,0,0,0,,Эмоция жоқ, күлу жоқ, жылау жоқ...
Dialogue: 0,0:58:32.96,0:58:35.26,Default,,0,0,0,,Уф... мм... мм...
Dialogue: 0,0:58:35.38,0:58:39.01,Default,,0,0,0,,Бірақ егер сіз белгілі бір мөлшерде «индивидуалдылық факторын» босатпасаңыз...
Dialogue: 0,0:58:39.39,0:58:43.39,Default,,0,0,0,,Оның ағзасында ауырсынатын ұстама тудыратын факторлар өзгереді.
Dialogue: 0,0:58:44.14,0:58:47.02,Default,,0,0,0,,Мен оны құтқару үшін жалдандым.
Dialogue: 0,0:58:50.10,0:58:53.27,Default,,0,0,0,,Менің «даралығым» - «факторды жою»
Dialogue: 0,0:58:53.40,0:58:58.15,Default,,0,0,0,,Оң қолыңызбен ұстаған адамның «тұлға факторын» жою үшін өз факторыңызды пайдаланыңыз.
Dialogue: 0,0:58:58.53,0:59:01.91,Default,,0,0,0,,(Джулионың қатты тыныс алуы)
Dialogue: 0,0:59:05.41,0:59:06.58,Default,,0,0,0,,Фу…
Dialogue: 0,0:59:08.75,0:59:11.21,Default,,0,0,0,,Хулио тез, тез
Dialogue: 0,0:59:13.25,0:59:14.38,Default,,0,0,0,,Хехе...
Dialogue: 0,0:59:15.13,0:59:18.72,Default,,0,0,0,,Менің қызым қалыпты өмір сүре алды.
Dialogue: 0,0:59:19.09,0:59:22.60,Default,,0,0,0,,Хулио, егер сізде «даралығыңыз» болса ғана
Dialogue: 0,0:59:22.72,0:59:24.56,Default,,0,0,0,,Мен арманыма қарай жүгіруді жалғастырамын
Dialogue: 0,0:59:25.06,0:59:26.31,Default,,0,0,0,,Жетім-
Dialogue: 0,0:59:26.43,0:59:30.44,Default,,0,0,0,,Осындай пайдасыз «даралығым» болған кезде мені көтеріп алғаныңыз үшін рахмет.
Dialogue: 0,0:59:30.56,0:59:32.36,Default,,0,0,0,,Тек сізді марапаттау.
Dialogue: 0,0:59:32.69,0:59:37.53,Default,,0,0,0,,Бірақ қызыңыз сіздің өміріңізді басқарып отыр дегенді өзгертпейді.
Dialogue: 0,0:59:37.65,0:59:41.07,Default,,0,0,0,,Бұрынғы өміріммен салыстырғанда емі әлдеқайда жақсы.
Dialogue: 0,0:59:41.20,0:59:44.83,Default,,0,0,0,,Мен тамақ ішпеймін, мен жалақы аламын.
Dialogue: 0,0:59:44.95,0:59:47.12,Default,,0,0,0,,Шағымдансаң, барабан таяқ жейді.
Dialogue: 0,0:59:48.54,0:59:51.46,Default,,0,0,0,,Қызымның «даралығы» жылдан жылға күшейіп келеді.
Dialogue: 0,0:59:51.96,0:59:54.84,Default,,0,0,0,,Тіпті сіз оны баса алмауыңыз мүмкін.
Dialogue: 0,0:59:56.00,0:59:59.84,Default,,0,0,0,,Өмірім қалса да басамын
Dialogue: 0,1:00:00.68,1:00:05.60,Default,,0,0,0,,(Аннаның мұңды дауысы)
Dialogue: 0,1:00:14.27,1:00:16.11,Default,,0,0,0,,Сәлем Хулио
Dialogue: 0,1:00:16.94,1:00:21.45,Default,,0,0,0,,Егер менің «индивидуалдылығым» бақылаусыз болып, бақылаудан шығып кетсе ше?
Dialogue: 0,1:00:22.07,1:00:25.62,Default,,0,0,0,,Онда мені өлтір
Dialogue: 0,1:00:27.04,1:00:28.16,Default,,0,0,0,,Ол келді.
Dialogue: 0,1:00:28.29,1:00:32.58,Default,,0,0,0,,Соңғы кездері ұстама болған сайын басым айналады.
Dialogue: 0,1:00:33.00,1:00:37.46,Default,,0,0,0,,Егер менің «даралығым» бақылаудан шығып кетсе, мен енді өзім болмаймын.
Dialogue: 0,1:00:39.84,1:00:43.09,Default,,0,0,0,,Өтінемін, Хулио, бірдеңе болып қалса...
Dialogue: 0,1:00:43.84,1:00:46.60,Default,,0,0,0,,Мен әлі де мен бола аламын ...
Dialogue: 0,1:00:47.31,1:00:48.47,Default,,0,0,0,,Достар...?
Dialogue: 0,1:00:49.10,1:00:50.48,Default,,0,0,0,,Ах...
Dialogue: 0,1:00:51.98,1:00:53.65,Default,,0,0,0,,Бірақ қайдан
Dialogue: 0,1:00:53.77,1:00:57.15,Default,,0,0,0,,Голини отбасы оның «даралығының» сырын білді —
Dialogue: 0,1:00:57.44,1:00:59.28,Default,,0,0,0,,Үйге шабуыл жасаңыз
Dialogue: 0,1:01:00.19,1:01:01.65,Default,,0,0,0,,Менің күйеуім өлтірілді...
Dialogue: 0,1:01:01.99,1:01:04.36,Default,,0,0,0,,Хулио! Хулио!
Dialogue: 0,1:01:04.49,1:01:06.28,Default,,0,0,0,,Ханым…
Dialogue: 0,1:01:06.41,1:01:08.16,Default,,0,0,0,,Мен атама тіл тигізуіңе, тіпті маған тіл тигізуіңе де жол бере алмаймын.
Dialogue: 0,1:01:10.45,1:01:12.87,Default,,0,0,0,,Оны алып кетті
Dialogue: 0,1:01:13.83,1:01:16.92,Default,,0,0,0,,Ал енді мен осындамын
Dialogue: 0,1:01:18.21,1:01:21.59,Default,,0,0,0,,Егер Хулио Аннаны құтқара алса, неге?
Dialogue: 0,1:01:21.92,1:01:23.01,Default,,0,0,0,,Мен алмаймын.
Dialogue: 0,1:01:23.30,1:01:24.22,Default,,0,0,0,,Ах...
Dialogue: 0,1:01:24.80,1:01:27.43,Default,,0,0,0,,«Индивидуалдылық» енді қолданылмайды.
Dialogue: 0,1:01:28.14,1:01:30.39,Default,,0,0,0,,Мен сені құтқарғым келсе де, мүмкін емес.
Dialogue: 0,1:01:30.68,1:01:32.02,Default,,0,0,0,,Бұл...
Dialogue: 0,1:01:32.43,1:01:34.69,Default,,0,0,0,,Егер оның «даралығы» бақылаудан шығып кетсе ше?
Dialogue: 0,1:01:34.85,1:01:37.90,Default,,0,0,0,,Субъект факторлары шексіз өзгере береді...
Dialogue: 0,1:01:38.02,1:01:39.94,Default,,0,0,0,,Ешкім сізді тоқтата алмайды
Dialogue: 0,1:01:40.36,1:01:43.82,Default,,0,0,0,,Оған дейін...
Dialogue: 0,1:01:46.82,1:01:47.82,Default,,0,0,0,,Дәл қазір—
Dialogue: 0,1:01:47.95,1:01:51.37,Default,,0,0,0,,Мен оны зұлым адамның «тұлғасын» алған аянда көрдім.
Dialogue: 0,1:01:51.49,1:01:54.33,Default,,0,0,0,,Мен Джулио мен Аннаның бір-біріне күліп тұрғанын көрдім.
Dialogue: 0,1:01:54.91,1:01:57.00,Default,,0,0,0,,Сенің жүзіңде сол өрнек болды...
Dialogue: 0,1:01:57.13,1:02:00.13,Default,,0,0,0,,Аннаны өлтіру мүмкін емес деп ойлаймын.
Dialogue: 0,1:02:00.63,1:02:03.09,Default,,0,0,0,,Күлуді ұмытып қалдым
Dialogue: 0,1:02:03.21,1:02:04.09,Default,,0,0,0,,Сол күннен бастап
Dialogue: 0,1:02:05.84,1:02:07.80,Default,,0,0,0,,Онда мен сені күлдіремін.
Dialogue: 0,1:02:08.18,1:02:11.10,Default,,0,0,0,,Аннаны сақта мен сені күлдіремін!
Dialogue: 0,1:02:11.72,1:02:13.22,Default,,0,0,0,,Қалай!?
Dialogue: 0,1:02:13.35,1:02:15.98,Default,,0,0,0,,Оны сақтаудың жолы жоқ!
Dialogue: 0,1:02:16.35,1:02:20.06,Default,,0,0,0,,Егер ол бала бақылаудан шығып кетсе, бәріміз араласамыз.
Dialogue: 0,1:02:20.19,1:02:21.82,Default,,0,0,0,,Менің сені өлтіруден басқа амалым жоқ!
Dialogue: 0,1:02:24.69,1:02:27.32,Default,,0,0,0,,Ол да соны қалайды
Dialogue: 0,1:02:33.75,1:02:35.37,Default,,0,0,0,,Аннаны құтқарайық
Dialogue: 0,1:02:38.12,1:02:41.00,Default,,0,0,0,,Мен барлық жағдайды білмесем де.
Dialogue: 0,1:02:41.13,1:02:43.38,Default,,0,0,0,,Сонда да мен Анна есімді әйелді жақсы көремін...
Dialogue: 0,1:02:43.50,1:02:44.96,Default,,0,0,0,,Менің ойымша, оны сақтау керек.
Dialogue: 0,1:02:45.88,1:02:49.09,Default,,0,0,0,,Бала әлі есінен танып кеткен жоқ, солай ма?
Dialogue: 0,1:02:49.51,1:02:52.60,Default,,0,0,0,,«Индивидуалдылықты» басудың бірнеше жолы бар.
Dialogue: 0,1:02:52.72,1:02:56.06,Default,,0,0,0,,Уақытша болса да, сіздің «жеке тұлғаңызды» өшірудің жолы бар.
Dialogue: 0,1:02:56.18,1:02:57.85,Default,,0,0,0,,Мүмкін шешімі бар шығар
Dialogue: 0,1:02:59.56,1:03:01.48,Default,,0,0,0,,Алдымен сол баланы құтқарайық.
Dialogue: 0,1:03:01.61,1:03:03.57,Default,,0,0,0,,Одан кейін не болды!
Dialogue: 0,1:03:03.69,1:03:04.57,Default,,0,0,0,,Иә, иә!
Dialogue: 0,1:03:05.19,1:03:06.99,Default,,0,0,0,,Егер ең кішкентай мүмкіндік болса...
Dialogue: 0,1:03:07.45,1:03:09.36,Default,,0,0,0,,Бас тартуға әлі ерте
Dialogue: 0,1:03:10.07,1:03:11.87,Default,,0,0,0,,Мен де солай ойлаймын.
Dialogue: 0,1:03:14.29,1:03:15.37,Default,,0,0,0,,Ах...
Dialogue: 0,1:03:22.08,1:03:25.09,Default,,0,0,0,,Бәріміз бірге Аннаны құтқарайық.
Dialogue: 0,1:03:31.68,1:03:32.35,Default,,0,0,0,,Ах!
Dialogue: 0,1:03:33.26,1:03:36.77,Default,,0,0,0,,Егер сіз Бүкіл Құдірет's Pachimon-ды жеңгіңіз келсе, мен сізге қол ұшын созамын.
Dialogue: 0,1:03:42.36,1:03:46.19,Default,,0,0,0,,Павел мен Саймон Голинидің атына кір келтірді.
Dialogue: 0,1:03:46.61,1:03:49.78,Default,,0,0,0,,Бұл нені білдіретінін білесіз бе? Дебора
Dialogue: 0,1:03:49.90,1:03:52.78,Default,,0,0,0,,Сондай-ақ… әрине қара кене
Dialogue: 0,1:03:58.37,1:04:01.17,Default,,0,0,0,,Мен сеніп тапсырғандар –
Dialogue: 0,1:04:01.54,1:04:05.29,Default,,0,0,0,,Батыр сенің қасыңда!
Dialogue: 0,1:04:05.63,1:04:08.97,Default,,0,0,0,,Тіптен артқа шегінсе де, сол рух қалады
Dialogue: 0,1:04:09.09,1:04:10.55,Default,,0,0,0,,Керемет
Dialogue: 0,1:04:11.72,1:04:13.01,Default,,0,0,0,,Бірақ енді сіз...
Dialogue: 0,1:04:13.14,1:04:16.97,Default,,0,0,0,,Идеалға ұмтылу күшін жоғалтқан адам ғана.
Dialogue: 0,1:04:17.93,1:04:21.85,Default,,0,0,0,,Жастар, ескі жолға жабыспаңдар.
Dialogue: 0,1:04:22.31,1:04:26.69,Default,,0,0,0,,Не қызмет ету керек? Келесі кім?
Dialogue: 0,1:04:27.19,1:04:32.11,Default,,0,0,0,,Бұл жерде біздің алдыңғыларымыздың өлімімен бірге бүгінгі күнді түсіну жақсы.
Dialogue: 0,1:04:36.87,1:04:39.12,Default,,0,0,0,,Бекініс бағытын өзгертті
Dialogue: 0,1:04:39.75,1:04:41.41,Default,,0,0,0,,Сіз қайда бара жатырсыз?
Dialogue: 0,1:04:41.75,1:04:44.38,Default,,0,0,0,,Егер сол бағытты жалғастырсақ...
Dialogue: 0,1:04:44.50,1:04:46.17,Default,,0,0,0,,Біздің мектепке жету!
Dialogue: 0,1:04:46.79,1:04:48.30,Default,,0,0,0,,Мақсат - Юэй...
Dialogue: 0,1:04:48.42,1:04:50.80,Default,,0,0,0,,Сіз бізді батырларды қоқысқа айналдырғыңыз келе ме?
Dialogue: 0,1:04:51.30,1:04:55.51,Default,,0,0,0,,Қаһарманның қорғаныс жүйесі өлімге қарсы шайқаста тұғыр болып табылады.
Dialogue: 0,1:04:56.05,1:04:58.18,Default,,0,0,0,,Мен оны қазір жоғалта алмаймын.
Dialogue: 0,1:04:58.72,1:04:59.97,Default,,0,0,0,,Мен білемін
Dialogue: 0,1:05:00.56,1:05:05.52,Default,,0,0,0,,Батырларды жинап, бекініске қарсы қорғаныс шебін құру
Dialogue: 0,1:05:11.03,1:05:13.15,Default,,0,0,0,,Барлығыңызға сенімді болыңыз!
Dialogue: 0,1:05:13.70,1:05:16.41,Default,,0,0,0,,Біз міндетті түрде құтылудың жолын табамыз!
Dialogue: 0,1:05:17.37,1:05:20.49,Default,,0,0,0,,Мен басып алынған баспанадан тамақ жинап жатырмын!
Dialogue: 0,1:05:20.62,1:05:21.91,Default,,0,0,0,,) Китазе!
Dialogue: 0,1:05:22.25,1:05:23.00,Default,,0,0,0,,Хой
Dialogue: 0,1:05:23.12,1:05:25.12,Default,,0,0,0,,Дүрбелең емес, көп нәрсе бар
Dialogue: 0,1:05:27.08,1:05:29.38,Default,,0,0,0,,Хехе...
Dialogue: 0,1:05:29.50,1:05:31.59,Default,,0,0,0,,Сіз құтқару жұмыстарында көп жұмыс істеп жатырсыз.
Dialogue: 0,1:05:32.01,1:05:32.97,Default,,0,0,0,,Ол жігіт...
Dialogue: 0,1:05:33.63,1:05:38.72,Default,,0,0,0,,Сізге бір сұрақ қоюға рұқсат етіңіз: Жаңа дәуір құру үшін не қажет деп ойлайсыз?
Dialogue: 0,1:05:38.85,1:05:41.06,Default,,0,0,0,,Иә, жойылу.
Dialogue: 0,1:05:41.35,1:05:44.98,Default,,0,0,0,,Өткен атақ, бұғау, ескіше көзқарас
Dialogue: 0,1:05:45.10,1:05:49.32,Default,,0,0,0,,Олардың барлығын жойып, жаңа тәртіп құру.
Dialogue: 0,1:05:49.94,1:05:51.32,Default,,0,0,0,,Әрине, олардың арасында—
Dialogue: 0,1:05:51.44,1:05:54.90,Default,,0,0,0,,Сондай-ақ Юэй орта мектебі, Бүкіл Құдірет алма-матери кіреді.
Dialogue: 0,1:05:55.03,1:05:55.95,Default,,0,0,0,,Не!?
Dialogue: 0,1:05:56.41,1:05:59.58,Default,,0,0,0,,Тек сындырып, құрастырыңыз!
Dialogue: 0,1:05:59.70,1:06:03.50,Default,,0,0,0,,Теріс мұраны жойып, жаңа аңызды бастаңыз!
Dialogue: 0,1:06:03.62,1:06:06.04,Default,,0,0,0,,Бұл менің аңызым.
Dialogue: 0,1:06:06.17,1:06:09.00,Default,,0,0,0,,Апыр-ай!? (Лорд Джоэстар) С… Сен…
Dialogue: 0,1:06:10.04,1:06:11.67,Default,,0,0,0,,Қандай ұят!
Dialogue: 0,1:06:11.92,1:06:12.80,Default,,0,0,0,,Төрағалар!
Dialogue: 0,1:06:13.21,1:06:16.22,Default,,0,0,0,,Құтқаруға мұқтаж адамдармен бірге қашу жолын табыңыз.
Dialogue: 0,1:06:16.34,1:06:17.55,Default,,0,0,0,,- (Иида) Түсіндім - (Ёёрозу) Түсіндім.
Dialogue: 0,1:06:17.68,1:06:21.68,Default,,0,0,0,,Ашидо Сунато! Шешім мен ақымақ күшті қашу үшін пайдалануға болады.
Dialogue: 0,1:06:21.81,1:06:22.72,Default,,0,0,0,,Төраға үшін!
Dialogue: 0,1:06:23.35,1:06:26.52,Default,,0,0,0,,Киришима Каминари Шоджи! Қандай да бір кедергі болса, оны жойыңыз!
Dialogue: 0,1:06:27.14,1:06:30.19,Default,,0,0,0,,Тодороки Токоями Деку, менімен бірге жүр!
Dialogue: 0,1:06:30.61,1:06:33.40,Default,,0,0,0,,Пачимон жігітін жойыңыз!
Dialogue: 0,1:06:34.94,1:06:35.86,Default,,0,0,0,,Кеттік
Dialogue: 0,1:06:36.45,1:06:37.86,Default,,0,0,0,,Батырларды қорғаңыз...
Dialogue: 0,1:06:38.41,1:06:40.28,Default,,0,0,0,,Мына қамалды тоқтат!
Dialogue: 0,1:06:56.72,1:06:59.22,Default,,0,0,0,,Ескі жолды ұстанғандар
Dialogue: 0,1:07:00.01,1:07:05.52,Default,,0,0,0,,«Жаңа таңба» алдында өзіңіздің осалдығыңызды түсініңіз.
Dialogue: 0,1:07:08.52,1:07:09.69,Default,,0,0,0,,Кимоноым шаңмен кірленді.
Dialogue: 0,1:07:10.10,1:07:12.44,Default,,0,0,0,,Бұл Даркмит бекінісі
Dialogue: 0,1:07:12.57,1:07:14.61,Default,,0,0,0,,Қарасаң шынымен ақымақ...
Dialogue: 0,1:07:14.73,1:07:17.07,Default,,0,0,0,,Үлкен болып кетсе де тоқтау өте қиын
Dialogue: 0,1:07:17.19,1:07:18.49,Default,,0,0,0,,(Әйел) Жолдасым! Арбадағы әйел өліп қалды, бірақ➡
Dialogue: 0,1:07:18.61,1:07:19.78,Default,,0,0,0,,Мен жол жасаймын!
Dialogue: 0,1:07:23.99,1:07:26.66,Default,,0,0,0,,Көрнектілік…
Dialogue: 0,1:07:26.79,1:07:29.04,Default,,0,0,0,,Дабыр!
Dialogue: 0,1:07:30.92,1:07:32.46,Default,,0,0,0,,(Шукуна) Ә, мен бұған мұқтаж емеспін, білесің бе—
Dialogue: 0,1:07:32.59,1:07:34.80,Default,,0,0,0,,Көбірек күйдіріңіз!
Dialogue: 0,1:07:40.47,1:07:42.47,Default,,0,0,0,,Уф!
Dialogue: 0,1:07:42.60,1:07:43.60,Default,,0,0,0,,Қараңдаршы!
Dialogue: 0,1:07:46.43,1:07:48.06,Default,,0,0,0,,Қайта қалпына келтірілсе ше!?
Dialogue: 0,1:07:48.60,1:07:51.15,Default,,0,0,0,,Бұл қарапайым процесс емес пе?
Dialogue: 0,1:07:51.40,1:07:52.44,Default,,0,0,0,,Мистер Хокс
Dialogue: 0,1:07:53.52,1:07:55.65,Default,,0,0,0,,Түсіндім, Бәрі мүмкін.
Dialogue: 0,1:07:55.78,1:07:57.78,Default,,0,0,0,,Мен арнайы біреуді жібердім.
Dialogue: 0,1:07:59.45,1:08:02.16,Default,,0,0,0,,Дүрбелең емес! Өтінемін, сабыр сақтаңыз!
Dialogue: 0,1:08:03.03,1:08:06.33,Default,,0,0,0,,Төраға, мен дәл қазір бүлінген дыбысты естідім.
Dialogue: 0,1:08:06.45,1:08:09.04,Default,,0,0,0,,Менің ойымша, бұл сырттан жасалған шабуыл шығар.
Dialogue: 0,1:08:09.58,1:08:10.92,Default,,0,0,0,,Профессионалды қаһарман болуы керек
Dialogue: 0,1:08:11.04,1:08:12.17,Default,,0,0,0,,О
Dialogue: 0,1:08:12.29,1:08:15.29,Default,,0,0,0,,Джиро-кун, жойылу дыбысының бағытына нұсқау сұраңыз.
Dialogue: 0,1:08:15.59,1:08:18.17,Default,,0,0,0,,Оған жақындамайды.
Dialogue: 0,1:08:18.42,1:08:20.13,Default,,0,0,0,,- (Иида) Тоғата-сенпай! -(Ашидо) Лемиллион!
Dialogue: 0,1:08:20.26,1:08:21.68,Default,,0,0,0,,Өтінемін, оған жұмыстың барлық қырларын және басқа да барлық нәрсені үйретіңіз.
Dialogue: 0,1:08:22.22,1:08:25.76,Default,,0,0,0,,Біз күзетіп жүрген жер неге сонша алыс?
Dialogue: 0,1:08:25.89,1:08:29.27,Default,,0,0,0,,...Біріншіден, адам өмірі қаскөйлерден жоғары тұрады.
Dialogue: 0,1:08:29.39,1:08:30.43,Default,,0,0,0,,Менің артымнан жүр
Dialogue: 0,1:08:30.89,1:08:31.81,Default,,0,0,0,,Иә!
Dialogue: 0,1:08:31.94,1:08:33.19,Default,,0,0,0,,Барлығы осылай!
Dialogue: 0,1:08:33.31,1:08:34.94,Default,,0,0,0,,Осы жолмен! Дүрлікпеңіз!
Dialogue: 0,1:08:35.44,1:08:38.11,Default,,0,0,0,,Осы жолмен! Қадамыңды байқа!
Dialogue: 0,1:08:38.73,1:08:42.11,Default,,0,0,0,,Өзіңді қатты итерме, Мидория-кун, Бакугу-кун.
Dialogue: 0,1:08:42.66,1:08:44.95,Default,,0,0,0,,Тодороки-кун Токоями-кун
Dialogue: 0,1:08:46.03,1:08:47.95,Default,,0,0,0,,Біз мұндай көпірді қашан көрдік...
Dialogue: 0,1:08:48.08,1:08:49.62,Default,,0,0,0,,Сіз сондай-ақ кіреберіске ұқсайтын нәрсені көре аласыз.
Dialogue: 0,1:08:50.04,1:08:51.91,Default,,0,0,0,,Сен мені қуып барасың ба?
Dialogue: 0,1:08:52.04,1:08:54.08,Default,,0,0,0,,Мені әлі де мазақ етеді
Dialogue: 0,1:08:55.84,1:08:56.75,Default,,0,0,0,,Ах
Dialogue: 0,1:08:59.34,1:09:01.72,Default,,0,0,0,,- (Изуку) Хулио мырза!? - (Бакуго) Қайтыңыз, салқын тобыр!
Dialogue: 0,1:09:01.84,1:09:02.88,Default,,0,0,0,,Өлемін деп ойлайтын ешқандай жағдайға тап болған емеспін
Dialogue: 0,1:09:03.22,1:09:04.72,Default,,0,0,0,,Не!
Dialogue: 0,1:09:04.84,1:09:08.93,Default,,0,0,0,,Жас келіншектің «даралығын» көбірек білетін менмін.
Dialogue: 0,1:09:09.06,1:09:10.10,Default,,0,0,0,,Және...
Dialogue: 0,1:09:11.27,1:09:15.44,Default,,0,0,0,,Мені күлдіргің келсе, оны көру үшін жақын болуың керек.
Dialogue: 0,1:09:24.36,1:09:25.87,Default,,0,0,0,,Маған ұнайды
Dialogue: 0,1:09:26.24,1:09:29.33,Default,,0,0,0,,Бұл жағдайда қашпаңыз, оған қарсы тұрыңыз
Dialogue: 0,1:09:29.83,1:09:35.08,Default,,0,0,0,,Келер ұрпақтың іргесін қалар жастар, маған келіңдер!
Dialogue: 0,1:09:38.46,1:09:42.72,Default,,0,0,0,,Жүр, Хадемен танысайық.
Dialogue: 0,1:10:01.61,1:10:02.90,Default,,0,0,0,,Бұл тағы да осы жігіттер!
Dialogue: 0,1:10:07.82,1:10:09.41,Default,,0,0,0,,Тодороки, үшінші раундқа өтті!
Dialogue: 0,1:10:09.53,1:10:11.79,Default,,0,0,0,,айқай)
Dialogue: 0,1:10:12.95,1:10:14.25,Default,,0,0,0,,Мен сені осында тартамын.
Dialogue: 0,1:10:14.62,1:10:17.42,Default,,0,0,0,,Мына қараңғыда Қара Көлеңке екеуіміз жеткілікті.
Dialogue: 0,1:10:17.54,1:10:19.38,Default,,0,0,0,,- (Токоями) Бар! -(Бакуго) Орта мектептің 2 курсы!
Dialogue: 0,1:10:22.55,1:10:24.09,Default,,0,0,0,,Токоями-кун, абай бол.
Dialogue: 0,1:10:24.92,1:10:26.22,Default,,0,0,0,,Бар, Мидория.
Dialogue: 0,1:10:26.76,1:10:27.89,Default,,0,0,0,,Иә
Dialogue: 0,1:10:30.10,1:10:32.39,Default,,0,0,0,,Сен сәл күдікті көрінесің, білесің бе.
Dialogue: 0,1:10:36.39,1:10:39.15,Default,,0,0,0,,Барлығы, міне, төмен түсетін баспалдақтар!
Dialogue: 0,1:10:40.06,1:10:41.15,Default,,0,0,0,,В... Құбыжық!
Dialogue: 0,1:10:47.07,1:10:49.87,Default,,0,0,0,,Тоғата-сенпай, маған жол көрсетші.
Dialogue: 0,1:10:49.99,1:10:51.12,Default,,0,0,0,,Иә?Бірақ...
Dialogue: 0,1:10:51.70,1:10:54.75,Default,,0,0,0,,Жол көрсету тек Тоғата-сенпайдың қолынан келетін іс.
Dialogue: 0,1:10:56.87,1:10:58.25,Default,,0,0,0,,Бірақ бұл менің ойлай алған жалғыз нәрсем еді
Dialogue: 0,1:10:58.54,1:11:01.46,Default,,0,0,0,,Фрогбуки-кун, Кучида-кун, Серо-кун және Хагакуре-кун:
Dialogue: 0,1:11:01.59,1:11:04.80,Default,,0,0,0,,Тогата Сенпайдың басшылығымен эвакуацияланғандарға бағыт беруді жалғастырыңыз.
Dialogue: 0,1:11:04.92,1:11:07.38,Default,,0,0,0,,Басқалардың бәрі оларды тоқтатады!
Dialogue: 0,1:11:07.72,1:11:09.01,Default,,0,0,0,,А сыныбы Кеттік!
Dialogue: 0,1:11:09.13,1:11:10.22,Default,,0,0,0,,О!
Dialogue: 0,1:11:35.41,1:11:36.95,Default,,0,0,0,,Сіз мұны істеуге дайынсыз ба!?
Dialogue: 0,1:11:38.04,1:11:40.50,Default,,0,0,0,,Мен сендерге еш кек сақтамаймын, бірақ...
Dialogue: 0,1:11:41.13,1:11:43.84,Default,,0,0,0,,Бастықтың бұйрықтары абсолютті
Dialogue: 0,1:11:43.96,1:11:45.17,Default,,0,0,0,,Фуфу...
Dialogue: 0,1:11:45.71,1:11:46.59,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,1:11:46.71,1:11:50.01,Default,,0,0,0,,Мидория, мұны бізге қалдыр да, бірінші бар.
Dialogue: 0,1:11:50.13,1:11:51.18,Default,,0,0,0,,Орта мектептің екінші курсы қайтадан!?
Dialogue: 0,1:11:51.51,1:11:52.43,Default,,0,0,0,,Иә
Dialogue: 0,1:11:55.93,1:11:58.02,Default,,0,0,0,,Хулио мырза, кеттік.
Dialogue: 0,1:11:59.48,1:12:00.39,Default,,0,0,0,,Ах
Dialogue: 0,1:12:00.73,1:12:01.69,Default,,0,0,0,,Иә?
Dialogue: 0,1:12:03.98,1:12:05.65,Default,,0,0,0,,Шизуку Каваками, Курона Анку, Наширо
Dialogue: 0,1:12:05.77,1:12:06.90,Default,,0,0,0,,Ах!?
Dialogue: 0,1:12:07.65,1:12:09.99,Default,,0,0,0,,Оны мұзбен ұстаған болуы керек.
Dialogue: 0,1:12:10.32,1:12:11.20,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:12:11.70,1:12:13.95,Default,,0,0,0,,Бұл телепортация ма?
Dialogue: 0,1:12:14.28,1:12:15.70,Default,,0,0,0,,Фуфу...
Dialogue: 0,1:12:20.96,1:12:25.84,Default,,0,0,0,,Хахаха... хехехе...
Dialogue: 0,1:12:26.21,1:12:30.13,Default,,0,0,0,,Менің қымбатты қызымды іздеп жүрсіз бе?
Dialogue: 0,1:12:30.26,1:12:33.18,Default,,0,0,0,,Бірақ мен оны саған бермеймін.
Dialogue: 0,1:12:33.39,1:12:35.10,Default,,0,0,0,,- Ханым! -(Изуку) Хулио-сан!
Dialogue: 0,1:12:38.85,1:12:40.35,Default,,0,0,0,,Кешіктіру орны…
Dialogue: 0,1:12:41.06,1:12:41.73,Default,,0,0,0,,Чи…
Dialogue: 0,1:12:42.06,1:12:43.85,Default,,0,0,0,,«Су төгетін жер»
Dialogue: 0,1:12:48.73,1:12:50.90,Default,,0,0,0,,Мен ғарыштан шыға алдым.
Dialogue: 0,1:12:51.86,1:12:54.28,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,1:13:01.41,1:13:03.54,Default,,0,0,0,,Әй, шегінуіміз керек пе?
Dialogue: 0,1:13:10.96,1:13:11.76,Default,,0,0,0,,Иә?
Dialogue: 0,1:13:13.47,1:13:16.80,Default,,0,0,0,,«Жүзу» «Ұшу» «Әуе күштері»
Dialogue: 0,1:13:16.93,1:13:18.22,Default,,0,0,0,,Бір уақытта қосу!
Dialogue: 0,1:13:22.60,1:13:25.40,Default,,0,0,0,,Үмітсіз жанкешті шабуыл дегеніміз не...
Dialogue: 0,1:13:25.52,1:13:26.23,Default,,0,0,0,,Иә?
Dialogue: 0,1:13:27.82,1:13:28.52,Default,,0,0,0,,Олар қосымша күш әкелді.
Dialogue: 0,1:13:29.02,1:13:30.53,Default,,0,0,0,,Мынау не деген жігіт...
Dialogue: 0,1:13:31.82,1:13:33.03,Default,,0,0,0,,Қандай жылдамдықпен...
Dialogue: 0,1:13:33.15,1:13:34.24,Default,,0,0,0,,Гррр…
Dialogue: 0,1:13:36.91,1:13:37.95,Default,,0,0,0,,Уау
Dialogue: 0,1:13:44.92,1:13:46.79,Default,,0,0,0,,Деку! Деку!
Dialogue: 0,1:13:46.92,1:13:49.88,Default,,0,0,0,,Жарайды. Ал сен ше, Анна?
Dialogue: 0,1:13:50.38,1:13:52.26,Default,,0,0,0,,Оны алып кетті.
Dialogue: 0,1:13:53.84,1:13:55.26,Default,,0,0,0,,Қуып жіберейік
Dialogue: 0,1:14:02.31,1:14:03.89,Default,,0,0,0,,Фуфу...
Dialogue: 0,1:14:07.10,1:14:10.19,Default,,0,0,0,,Муда Муда! Хяххххх...
Dialogue: 0,1:14:10.48,1:14:12.90,Default,,0,0,0,,Чит Чокомакато!
Dialogue: 0,1:14:16.66,1:14:17.78,Default,,0,0,0,,Ақымақ
Dialogue: 0,1:14:18.95,1:14:19.62,Default,,0,0,0,,Хун
Dialogue: 0,1:14:24.37,1:14:25.25,Default,,0,0,0,,Гах...
Dialogue: 0,1:14:25.83,1:14:26.83,Default,,0,0,0,,Практикалық емтихан: Дайын бол, баста!
Dialogue: 0,1:14:27.37,1:14:28.54,Default,,0,0,0,,Чи…
Dialogue: 0,1:14:42.56,1:14:45.23,Default,,0,0,0,,Кук... шексіз шығады.
Dialogue: 0,1:14:47.27,1:14:49.40,Default,,0,0,0,,Жүрек соғуы бұлдыр!
Dialogue: 0,1:14:53.57,1:14:54.82,Default,,0,0,0,,Әрине, оны есінен тандырып тастаған дұрыс қой?
Dialogue: 0,1:15:01.28,1:15:04.50,Default,,0,0,0,,Иә!
Dialogue: 0,1:15:04.75,1:15:06.12,Default,,0,0,0,,Урааа!
Dialogue: 0,1:15:06.54,1:15:08.46,Default,,0,0,0,,Сені тоқтатуды маған қалдыр!
Dialogue: 0,1:15:08.79,1:15:10.46,Default,,0,0,0,,Уф!
Dialogue: 0,1:15:11.92,1:15:12.75,Default,,0,0,0,,13-ші мұғалімнің жаттығу тесті соңына дейін созылып кетті…
Dialogue: 0,1:15:16.42,1:15:19.38,Default,,0,0,0,,(Садо мен Шодзидің қатты дауыстары)
Dialogue: 0,1:15:19.55,1:15:21.51,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,1:15:25.31,1:15:26.18,Default,,0,0,0,,Әй!
Dialogue: 0,1:15:28.39,1:15:31.86,Default,,0,0,0,,Қорғаңыз! Мен оны қорғаймын!
Dialogue: 0,1:15:34.57,1:15:36.49,Default,,0,0,0,,Барлаушылардың есептері бар ма?
Dialogue: 0,1:15:36.82,1:15:39.45,Default,,0,0,0,,Бекініс жақындап қалды!
Dialogue: 0,1:15:39.57,1:15:40.53,Default,,0,0,0,,Мистер Бүкіл Құдірет
Dialogue: 0,1:15:40.99,1:15:43.03,Default,,0,0,0,,Бұл барлаушының қол белгісі.
Dialogue: 0,1:15:44.16,1:15:46.87,Default,,0,0,0,,«Көптеген адамдар құтқаруды қажет етеді»
Dialogue: 0,1:15:47.37,1:15:51.71,Default,,0,0,0,,«Сіз Лемиллион тұрған жерді жойып, оны құтқардыңыз».
Dialogue: 0,1:15:52.88,1:15:53.84,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,1:15:54.29,1:15:56.51,Default,,0,0,0,,Көрсетілген нүктеге шабуыл жасаңыз
Dialogue: 0,1:15:56.63,1:15:58.80,Default,,0,0,0,,Батыр мүмкіндігінше бекініске жақындайды —
Dialogue: 0,1:15:58.92,1:16:01.34,Default,,0,0,0,,Құтқаруға мұқтаж адамдарды құтқару
Dialogue: 0,1:16:03.35,1:16:04.64,Default,,0,0,0,,Өтінемін
Dialogue: 0,1:16:04.76,1:16:06.01,Default,,0,0,0,,Тіпті айтпай-ақ
Dialogue: 0,1:16:10.73,1:16:13.23,Default,,0,0,0,,...
Dialogue: 0,1:16:13.36,1:16:16.73,Default,,0,0,0,,Проминенс Бёрн!
Dialogue: 0,1:16:17.86,1:16:20.20,Default,,0,0,0,,Алау шеңбері!
Dialogue: 0,1:16:22.53,1:16:23.57,Default,,0,0,0,,(Босқындардың айқайы)
Dialogue: 0,1:16:23.70,1:16:25.78,Default,,0,0,0,,Жарайды, тыныштал!
Dialogue: 0,1:16:26.20,1:16:27.83,Default,,0,0,0,,- (Pro Hero) Кеттік! -(Pro heroes) Келіңіздер!
Dialogue: 0,1:16:38.13,1:16:39.97,Default,,0,0,0,,Бұл бала менің соңғы балам болады.
Dialogue: 0,1:16:40.09,1:16:41.30,Default,,0,0,0,,Ішіндегі жағдай қандай?
Dialogue: 0,1:16:41.43,1:16:44.30,Default,,0,0,0,,Батыр сыныбы 1 курс А сыныбы жауға қарсы соғысуда.
Dialogue: 0,1:16:44.43,1:16:46.05,Default,,0,0,0,,Қолдау көрсету бөліміне өтіңіз
Dialogue: 0,1:16:49.35,1:16:51.18,Default,,0,0,0,,Жақсы орындалған Эндевор
Dialogue: 0,1:16:51.56,1:16:54.35,Default,,0,0,0,,Алайда бекіністің ілгерілеуі тоқтаған жоқ.
Dialogue: 0,1:16:55.06,1:16:59.07,Default,,0,0,0,,Содан кейін сіз Prominence-ті қалағаныңызша түсіре аласыз.
Dialogue: 0,1:16:59.19,1:17:02.49,Default,,0,0,0,,Барлығы бекініс шабуыл командасын жинай алады!
Dialogue: 0,1:17:02.99,1:17:05.49,Default,,0,0,0,,Бірақ сіздің денеңіз...
Dialogue: 0,1:17:06.16,1:17:09.91,Default,,0,0,0,,Біз... батырмыз.
Dialogue: 0,1:17:14.33,1:17:15.96,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,1:17:16.08,1:17:17.09,Default,,0,0,0,,Ах
Dialogue: 0,1:17:23.26,1:17:25.39,Default,,0,0,0,,Бұл да «индивидуалдылық» ма?
Dialogue: 0,1:17:25.51,1:17:26.85,Default,,0,0,0,,«Алхимия»
Dialogue: 0,1:17:26.97,1:17:27.76,Default,,0,0,0,,«Алхимия»?
Dialogue: 0,1:17:28.31,1:17:32.35,Default,,0,0,0,,Катализаторлардың көмегімен қажетті заттарды жасауға мүмкіндік беретін «Индивидуалдылық».
Dialogue: 0,1:17:32.48,1:17:33.64,Default,,0,0,0,,Енді мен бетімді өзгерттім.
Dialogue: 0,1:17:34.02,1:17:36.23,Default,,0,0,0,,Олар өздерін Қараңғы кене сияқты заттар деп атайды.
Dialogue: 0,1:17:37.06,1:17:40.32,Default,,0,0,0,,Оның шынайы тұлғасы Еуропадағы ең ірі мафия болып табылады.
Dialogue: 0,1:17:40.44,1:17:43.99,Default,,0,0,0,,Голини отбасының басшысы Бардо Голини
Dialogue: 0,1:17:44.65,1:17:47.45,Default,,0,0,0,,Неліктен ол Бүкіл Құдірет болу үшін бетін өзгертті?
Dialogue: 0,1:17:47.57,1:17:49.74,Default,,0,0,0,,- (Қара кене) Бұл «символ» - (Изуку) Ах.
Dialogue: 0,1:17:50.20,1:17:54.25,Default,,0,0,0,,Себебі мен Құдіреттің орнына «символ» боламын.
Dialogue: 0,1:17:54.79,1:17:57.33,Default,,0,0,0,,Иә, бұл менмін.
Dialogue: 0,1:17:57.46,1:17:59.17,Default,,0,0,0,,Келесі…
Dialogue: 0,1:18:00.25,1:18:01.76,Default,,0,0,0,,оның қан тамырларының қабырғаларынан шығып келе жатқанын—
Dialogue: 0,1:18:02.30,1:18:04.76,Default,,0,0,0,,Солай емес пе, Анна?
Dialogue: 0,1:18:05.18,1:18:05.97,Default,,0,0,0,,Мен атама тіл тигізуіңе, тіпті маған тіл тигізуіңе де жол бере алмаймын.
Dialogue: 0,1:18:14.56,1:18:16.48,Default,,0,0,0,,Ол жүгіруін тоқтатпайды, сүйретіліп бара жатса да
Dialogue: 0,1:18:16.98,1:18:18.44,Default,,0,0,0,,Тоқта!
Dialogue: 0,1:18:18.56,1:18:21.94,Default,,0,0,0,,Осы құдіретпен мен барлық күштерден асып түсемін.
Dialogue: 0,1:18:22.86,1:18:25.82,Default,,0,0,0,,Әлемді өз түсіңізбен бояңыз!
Dialogue: 0,1:18:33.16,1:18:34.37,Default,,0,0,0,,Ухммм… ммм…
Dialogue: 0,1:18:36.00,1:18:39.46,Default,,0,0,0,,Бұл – «рәміздердің» құдіреті!
Dialogue: 0,1:18:41.92,1:18:42.88,Default,,0,0,0,,Аһ!
Dialogue: 0,1:18:44.97,1:18:48.01,Default,,0,0,0,,Сіз қалай ойлайсыз? Сіз оған таңданасыз ба?
Dialogue: 0,1:18:48.89,1:18:49.55,Default,,0,0,0,,Иә?
Dialogue: 0,1:18:53.22,1:18:54.02,Default,,0,0,0,,Әй!
Dialogue: 0,1:18:55.35,1:18:56.44,Default,,0,0,0,,Ажырасудың жоспары болуы керек емес пе деп ойламайсың ба?
Dialogue: 0,1:18:56.73,1:18:57.60,Default,,0,0,0,,Ха!
Dialogue: 0,1:18:59.23,1:19:00.15,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,1:19:05.57,1:19:06.45,Default,,0,0,0,,(Польнарефф) Ә? Бұл не? Бұл жабысқақ не?
Dialogue: 0,1:19:06.57,1:19:08.20,Default,,0,0,0,,Гррр…
Dialogue: 0,1:19:12.28,1:19:13.41,Default,,0,0,0,,Уф...
Dialogue: 0,1:19:14.16,1:19:14.83,Default,,0,0,0,,Ах
Dialogue: 0,1:19:17.33,1:19:18.42,Default,,0,0,0,,Гү!
Dialogue: 0,1:19:18.67,1:19:19.33,Default,,0,0,0,,Ах
Dialogue: 0,1:19:20.71,1:19:23.21,Default,,0,0,0,,Кез келген дағдарысты жеңу
Dialogue: 0,1:19:23.67,1:19:24.46,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,1:19:25.01,1:19:27.30,Default,,0,0,0,,Мен қазірдің өзінде Plus Ultra...
Dialogue: 0,1:19:27.51,1:19:28.38,Default,,0,0,0,,Тоқта!
Dialogue: 0,1:19:28.55,1:19:30.80,Default,,0,0,0,,Иә!
Dialogue: 0,1:19:43.27,1:19:45.78,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,1:19:48.28,1:19:49.15,Default,,0,0,0,,Хмф!
Dialogue: 0,1:19:50.74,1:19:53.12,Default,,0,0,0,,Сіз өте шулысыз!
Dialogue: 0,1:19:56.37,1:19:57.29,Default,,0,0,0,,Әй!
Dialogue: 0,1:19:58.79,1:20:02.21,Default,,0,0,0,,Болашағы нұрлы жігітпен әңгімеге араласып тұрсың.
Dialogue: 0,1:20:07.09,1:20:08.88,Default,,0,0,0,,Сіз сияқты кішкентай адамға —
Dialogue: 0,1:20:09.01,1:20:11.80,Default,,0,0,0,,Мен араласқым келмейді!
Dialogue: 0,1:20:21.60,1:20:26.15,Default,,0,0,0,,Бұл «алхимия»… Бірнеше «тұлға» бар сияқты
Dialogue: 0,1:20:28.40,1:20:29.15,Default,,0,0,0,,(Изуку) Ж-жарайды… егер тура жүріп кетсек, Алл Майт бізді күтіп тұрады.
Dialogue: 0,1:20:31.07,1:20:32.07,Default,,0,0,0,,Бірақ қазір...
Dialogue: 0,1:20:32.78,1:20:33.45,Default,,0,0,0,,Ах...
Dialogue: 0,1:20:34.32,1:20:36.74,Default,,0,0,0,,Аннаны бірінші орынға қойыңыз!
Dialogue: 0,1:20:40.00,1:20:42.79,Default,,0,0,0,,6-шы «Түтін экраны» толығымен ашық!
Dialogue: 0,1:20:45.00,1:20:47.21,Default,,0,0,0,,Кішкентай трюктар
Dialogue: 0,1:20:47.34,1:20:50.05,Default,,0,0,0,,Менің көңілімді қалдырма
Dialogue: 0,1:20:59.14,1:21:00.02,Default,,0,0,0,,Иә?
Dialogue: 0,1:21:02.06,1:21:03.23,Default,,0,0,0,,Хмм…
Dialogue: 0,1:21:04.44,1:21:06.77,Default,,0,0,0,,...
Dialogue: 0,1:21:06.90,1:21:09.11,Default,,0,0,0,,Торино соққысы!
Dialogue: 0,1:21:17.12,1:21:18.37,Default,,0,0,0,,Мен атама тіл тигізуіңе, тіпті маған тіл тигізуіңе де жол бере алмаймын.
Dialogue: 0,1:21:19.91,1:21:21.50,Default,,0,0,0,,Мен атама тіл тигізуіңе, тіпті маған тіл тигізуіңе де жол бере алмаймын.
Dialogue: 0,1:21:25.42,1:21:26.38,Default,,0,0,0,,Гррр…
Dialogue: 0,1:21:34.97,1:21:36.68,Default,,0,0,0,,Хехе...
Dialogue: 0,1:21:38.22,1:21:40.81,Default,,0,0,0,,Мен саған Аннаны бермеймін.
Dialogue: 0,1:21:45.77,1:21:47.56,Default,,0,0,0,,Сондықтан оны ұрмаңыз!
Dialogue: 0,1:21:54.20,1:21:56.41,Default,,0,0,0,,Неліктен бас тартпайсың?
Dialogue: 0,1:21:56.91,1:21:58.37,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,1:21:58.49,1:21:59.99,Default,,0,0,0,,Мен «индивидуалдылықты» түсінемін
Dialogue: 0,1:22:00.12,1:22:01.75,Default,,0,0,0,,Телепорттарды өшіру
Dialogue: 0,1:22:01.87,1:22:03.96,Default,,0,0,0,,Қарт адамның телекинезі бар
Dialogue: 0,1:22:04.25,1:22:05.96,Default,,0,0,0,,Хахахаха!
Dialogue: 0,1:22:06.63,1:22:08.25,Default,,0,0,0,,Мен де заңдылықты оқи алдым.
Dialogue: 0,1:22:08.38,1:22:10.84,Default,,0,0,0,,Телепортация жасай алатын жалғыз адамдар - бұл өздері және—
Dialogue: 0,1:22:11.34,1:22:13.51,Default,,0,0,0,,Тек сіз түртетін нәрсе
Dialogue: 0,1:22:14.88,1:22:19.14,Default,,0,0,0,,Қозғалыс диапазоны жай көзге ғана көрінеді
Dialogue: 0,1:22:22.06,1:22:23.18,Default,,0,0,0,,Егер солай болса...
Dialogue: 0,1:22:23.31,1:22:25.14,Default,,0,0,0,,Барлық диапазон...
Dialogue: 0,1:22:25.44,1:22:26.85,Default,,0,0,0,,Жарылу!
Dialogue: 0,1:22:27.44,1:22:28.94,Default,,0,0,0,,Өртеп жібер!
Dialogue: 0,1:22:29.81,1:22:32.32,Default,,0,0,0,,Ораора Ораораора!
Dialogue: 0,1:22:38.70,1:22:40.53,Default,,0,0,0,,Сен сәл күдікті көрінесің, білесің бе.
Dialogue: 0,1:22:44.87,1:22:46.79,Default,,0,0,0,,- (Бакуго) Мен оны білдім... -Ха!
Dialogue: 0,1:22:46.92,1:22:48.75,Default,,0,0,0,,Мен мұны істеймін!
Dialogue: 0,1:22:49.13,1:22:51.17,Default,,0,0,0,,Гяаа!
Dialogue: 0,1:22:57.72,1:23:00.43,Default,,0,0,0,,Менің уақытымды босқа өткізуге мәжбүр еттіңіз
Dialogue: 0,1:23:04.35,1:23:06.10,Default,,0,0,0,,Ю... Хулио мырза
Dialogue: 0,1:23:09.40,1:23:11.02,Default,,0,0,0,,Ах... Уф...
Dialogue: 0,1:23:11.82,1:23:14.65,Default,,0,0,0,,Анна, ол адамды өлтір.
Dialogue: 0,1:23:16.32,1:23:18.11,Default,,0,0,0,,Иә, әпке.
Dialogue: 0,1:23:20.99,1:23:24.95,Default,,0,0,0,,Хехехе... Көңілді шоудың басы.
Dialogue: 0,1:23:29.83,1:23:32.79,Default,,0,0,0,,Ояныңыз, Хулио мырза.
Dialogue: 0,1:23:32.92,1:23:33.80,Default,,0,0,0,,Хулио мырза!
Dialogue: 0,1:23:34.59,1:23:38.26,Default,,0,0,0,,Сіз енді ештеңе істей алмайсыз. Өсу.
Dialogue: 0,1:23:38.88,1:23:40.51,Default,,0,0,0,,Үмітсіздікті білу -
Dialogue: 0,1:23:40.64,1:23:43.89,Default,,0,0,0,,Мен болатын «таңбаның» қайтарылуын қабылдаңыз.
Dialogue: 0,1:23:44.39,1:23:46.06,Default,,0,0,0,,Осындай бірдеңе...
Dialogue: 0,1:23:48.06,1:23:49.48,Default,,0,0,0,,Анна, жоқ!
Dialogue: 0,1:23:50.52,1:23:52.23,Default,,0,0,0,,Анна!
Dialogue: 0,1:23:55.19,1:23:57.53,Default,,0,0,0,,Орналастыру аяқталды Эндевор-Сан!
Dialogue: 0,1:23:58.03,1:24:01.16,Default,,0,0,0,,Осы жалын сөнгенше!
Dialogue: 0,1:24:07.70,1:24:11.75,Default,,0,0,0,,Проминенс Бёрн!
Dialogue: 0,1:24:16.00,1:24:16.88,Default,,0,0,0,,Ах
Dialogue: 0,1:24:20.76,1:24:23.43,Default,,0,0,0,,Иә, батырлар келді ме?
Dialogue: 0,1:24:23.68,1:24:25.26,Default,,0,0,0,,Бірақ мен үшін...
Dialogue: 0,1:24:25.39,1:24:28.48,Default,,0,0,0,,Сен сәл күдікті көрінесің, білесің бе.
Dialogue: 0,1:24:38.90,1:24:40.99,Default,,0,0,0,,Жу... Хулио-сан
Dialogue: 0,1:24:41.95,1:24:44.20,Default,,0,0,0,,Оян
Dialogue: 0,1:24:44.32,1:24:46.70,Default,,0,0,0,,Хулио-сан!
Dialogue: 0,1:24:51.87,1:24:53.54,Default,,0,0,0,,А... мүмкін емес...
Dialogue: 0,1:24:53.96,1:24:55.84,Default,,0,0,0,,Егер мені танысаң...
Dialogue: 0,1:24:55.96,1:24:58.67,Default,,0,0,0,,Қолдау элементтері енді автоматты түрде қозғалады—
Dialogue: 0,1:24:58.80,1:24:59.92,Default,,0,0,0,,Алдын ала орнату...
Dialogue: 0,1:25:00.42,1:25:01.38,Default,,0,0,0,,Сәлем...
Dialogue: 0,1:25:03.30,1:25:05.97,Default,,0,0,0,,үшін? Оқ бітті ме?
Dialogue: 0,1:25:06.60,1:25:09.02,Default,,0,0,0,,Хаха... Ахахха!
Dialogue: 0,1:25:09.14,1:25:11.27,Default,,0,0,0,,Бұл не? Сіз мені қорқытасыз!
Dialogue: 0,1:25:12.81,1:25:13.48,Default,,0,0,0,,Иә?
Dialogue: 0,1:25:26.70,1:25:27.91,Default,,0,0,0,,Ха…
Dialogue: 0,1:25:30.25,1:25:33.41,Default,,0,0,0,,Мен... Мен... Не?
Dialogue: 0,1:25:35.50,1:25:36.17,Default,,0,0,0,,Ах!
Dialogue: 0,1:25:37.54,1:25:38.67,Default,,0,0,0,,Хулио!
Dialogue: 0,1:25:42.22,1:25:46.89,Default,,0,0,0,,Қайда бара жатырсың? Ағай, өкінішті
Dialogue: 0,1:25:47.22,1:25:49.06,Default,,0,0,0,,Бес тұтқын –
Dialogue: 0,1:25:49.18,1:25:51.39,Default,,0,0,0,,Сізді ешкім құтқара алмайды
Dialogue: 0,1:25:51.89,1:25:55.14,Default,,0,0,0,,Саған керегі ол кісі емес.
Dialogue: 0,1:25:55.73,1:25:57.02,Default,,0,0,0,,Бұл менмін
Dialogue: 0,1:25:57.15,1:25:58.73,Default,,0,0,0,,Ахх...
Dialogue: 0,1:25:59.82,1:26:00.48,Default,,0,0,0,,Хмф!
Dialogue: 0,1:26:01.61,1:26:02.57,Default,,0,0,0,,Ах
Dialogue: 0,1:26:03.95,1:26:05.32,Default,,0,0,0,,Жақсысың ба, Мидория!?
Dialogue: 0,1:26:05.45,1:26:06.45,Default,,0,0,0,,Қашан басталғанын білгім келеді
Dialogue: 0,1:26:07.49,1:26:09.53,Default,,0,0,0,,Алданба, Деку!
Dialogue: 0,1:26:09.66,1:26:10.74,Default,,0,0,0,,Ха~ ха ха ха ха! Қандай бет-әлпет ол?
Dialogue: 0,1:26:11.12,1:26:12.91,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,1:26:13.04,1:26:16.04,Default,,0,0,0,,Осы уақытқа дейін жеткен үш адам бар екеніне сене алар емеспін.
Dialogue: 0,1:26:16.17,1:26:19.96,Default,,0,0,0,,Бүкіл Құдірет студенттері күткендей.
Dialogue: 0,1:26:20.09,1:26:21.13,Default,,0,0,0,,Шу!
Dialogue: 0,1:26:21.25,1:26:24.01,Default,,0,0,0,,Сіз Бүкіл Құдірет туралы айтып тұрған жоқсыз!
Dialogue: 0,1:26:24.42,1:26:27.51,Default,,0,0,0,,Жарайды, сөзден де күштірек.
Dialogue: 0,1:26:27.64,1:26:32.22,Default,,0,0,0,,Дәреженің айырмашылығын мен өзім үйретемін.
Dialogue: 0,1:26:32.35,1:26:33.22,Default,,0,0,0,,Ах...
Dialogue: 0,1:26:37.90,1:26:38.86,Default,,0,0,0,,Анна!
Dialogue: 0,1:26:38.98,1:26:39.90,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,1:26:41.07,1:26:42.28,Default,,0,0,0,,Ура!
Dialogue: 0,1:27:07.55,1:27:09.55,Default,,0,0,0,,Иә... Иә!
Dialogue: 0,1:27:13.85,1:27:18.69,Default,,0,0,0,,Хехе... Жақсы, жақсы, жастар.
Dialogue: 0,1:27:18.94,1:27:21.90,Default,,0,0,0,,Келіңіздер, көбірек көңіл көтерейік!
Dialogue: 0,1:27:25.82,1:27:27.24,Default,,0,0,0,,Хехе...
Dialogue: 0,1:27:28.61,1:27:31.87,Default,,0,0,0,,Шабуыл жасағының барлық мүшелері бекініске кірді.
Dialogue: 0,1:27:31.99,1:27:33.79,Default,,0,0,0,,Мұнда екеніңе сенбеймін
Dialogue: 0,1:27:40.12,1:27:42.17,Default,,0,0,0,,Қарғыс атқыр... осымен бітті ме?
Dialogue: 0,1:27:42.29,1:27:43.80,Default,,0,0,0,,айқай)
Dialogue: 0,1:27:43.92,1:27:45.76,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:27:47.84,1:27:48.51,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,1:27:50.26,1:27:52.47,Default,,0,0,0,,Тағы да…
Dialogue: 0,1:27:53.01,1:27:55.97,Default,,0,0,0,,Олай емес сияқты, солай ма? Цукуйоми-кун
Dialogue: 0,1:27:56.39,1:27:57.98,Default,,0,0,0,,Бүркіттер
Dialogue: 0,1:28:05.23,1:28:06.32,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,1:28:06.90,1:28:07.99,Default,,0,0,0,,Ақымақ
Dialogue: 0,1:28:08.40,1:28:09.53,Default,,0,0,0,,Сен сәл күдікті көрінесің, білесің бе.
Dialogue: 0,1:28:09.65,1:28:10.32,Default,,0,0,0,,Уау
Dialogue: 0,1:28:14.12,1:28:17.45,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,1:28:18.16,1:28:19.62,Default,,0,0,0,,Уау!
Dialogue: 0,1:28:20.46,1:28:22.71,Default,,0,0,0,,Бірақ егер сол адам—
Dialogue: 0,1:28:25.17,1:28:26.67,Default,,0,0,0,,Жарайсың!
Dialogue: 0,1:28:26.80,1:28:28.63,Default,,0,0,0,,Қалғанын бізге қалдырыңыз!
Dialogue: 0,1:28:32.89,1:28:34.01,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:28:35.72,1:28:36.68,Default,,0,0,0,,Ха!
Dialogue: 0,1:28:38.64,1:28:39.52,Default,,0,0,0,,Әй!
Dialogue: 0,1:28:39.98,1:28:41.19,Default,,0,0,0,,Қандай әдемі теңдігімді бұзды!
Dialogue: 0,1:28:41.48,1:28:42.35,Default,,0,0,0,,...
Dialogue: 0,1:28:44.15,1:28:45.02,Default,,0,0,0,,Не?
Dialogue: 0,1:28:46.52,1:28:47.40,Default,,0,0,0,,Иә?
Dialogue: 0,1:29:06.34,1:29:08.05,Default,,0,0,0,,Барлығыңыз, берілмеңіздер!
Dialogue: 0,1:29:08.17,1:29:09.71,Default,,0,0,0,,О!
Dialogue: 0,1:29:14.89,1:29:17.85,Default,,0,0,0,,Ой... жас ханым...
Dialogue: 0,1:29:22.23,1:29:24.90,Default,,0,0,0,,Ой... ой...
Dialogue: 0,1:29:25.06,1:29:26.06,Default,,0,0,0,,Хухаха! бұл!
Dialogue: 0,1:29:28.90,1:29:29.65,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,1:29:29.78,1:29:30.90,Default,,0,0,0,,Тит!
Dialogue: 0,1:29:32.40,1:29:33.24,Default,,0,0,0,,Уау!
Dialogue: 0,1:29:33.36,1:29:34.11,Default,,0,0,0,,Біз тек сүйіскендей боламыз.
Dialogue: 0,1:29:34.36,1:29:35.16,Default,,0,0,0,,Мына жігітке...
Dialogue: 0,1:29:35.28,1:29:35.99,Default,,0,0,0,,Ұнату...
Dialogue: 0,1:29:36.12,1:29:37.08,Default,,0,0,0,,Берме!
Dialogue: 0,1:29:37.20,1:29:38.87,Default,,0,0,0,,Перфорацияланған мұз қабырғасы!
Dialogue: 0,1:29:44.96,1:29:47.79,Default,,0,0,0,,Анау, анау, анау, анау!
Dialogue: 0,1:29:56.01,1:29:57.35,Default,,0,0,0,,Дааа!
Dialogue: 0,1:29:57.76,1:30:00.14,Default,,0,0,0,,Хехе...
Dialogue: 0,1:30:00.26,1:30:01.85,Default,,0,0,0,,Сәттілік батыр
Dialogue: 0,1:30:02.23,1:30:05.10,Default,,0,0,0,,Менің қабырғаларым онша жұқа емес.
Dialogue: 0,1:30:05.44,1:30:07.56,Default,,0,0,0,,Хозаке Пачимон!
Dialogue: 0,1:30:09.27,1:30:10.82,Default,,0,0,0,,Өте рахмет! (Ол Майт) Ахахаха!
Dialogue: 0,1:30:10.94,1:30:12.65,Default,,0,0,0,,Мен келесімін
Dialogue: 0,1:30:13.49,1:30:14.40,Default,,0,0,0,,Фу…
Dialogue: 0,1:30:14.95,1:30:15.95,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,1:30:16.57,1:30:17.45,Default,,0,0,0,,Келесі…
Dialogue: 0,1:30:18.78,1:30:19.95,Default,,0,0,0,,Бұл біз!
Dialogue: 0,1:30:23.66,1:30:24.54,Default,,0,0,0,,Хмф!
Dialogue: 0,1:30:27.00,1:30:28.21,Default,,0,0,0,,-(Тодороки) Уф! -(Қара кене) Ха...
Dialogue: 0,1:30:30.25,1:30:32.00,Default,,0,0,0,,Мен таңданатын «символ» болды...
Dialogue: 0,1:30:33.05,1:30:34.72,Default,,0,0,0,,Барлығына күлкі сыйлады
Dialogue: 0,1:30:35.47,1:30:37.64,Default,,0,0,0,,Маған үміт берді!
Dialogue: 0,1:30:38.72,1:30:40.35,Default,,0,0,0,,Бұл... бұл күш!?
Dialogue: 0,1:30:41.10,1:30:42.85,Default,,0,0,0,,Алып тастау күші емес...
Dialogue: 0,1:30:44.98,1:30:47.98,Default,,0,0,0,,Беруге құдіреті бар адам!
Dialogue: 0,1:30:50.36,1:30:51.82,Default,,0,0,0,,Ой…
Dialogue: 0,1:30:52.73,1:30:53.82,Default,,0,0,0,,Иә!
Dialogue: 0,1:30:57.91,1:31:01.87,Default,,0,0,0,,Мен Бүкіл Құдірет-тің жеңіске жеткеніне таң қалдым.
Dialogue: 0,1:31:02.49,1:31:03.41,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:31:03.79,1:31:04.83,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,1:31:05.71,1:31:08.50,Default,,0,0,0,,Тек жеңу жеткіліксіз!
Dialogue: 0,1:31:09.33,1:31:11.46,Default,,0,0,0,,Өз күшіңізбен...
Dialogue: 0,1:31:11.59,1:31:14.05,Default,,0,0,0,,Мен саған тәнтімін!
Dialogue: 0,1:31:18.93,1:31:20.18,Default,,0,0,0,,Уау!
Dialogue: 0,1:31:20.64,1:31:24.06,Default,,0,0,0,,Немесе… бет! Менің бетім!
Dialogue: 0,1:31:24.18,1:31:26.56,Default,,0,0,0,,«Kaebuki Tsuyu» әріптерін сұрақ қойып шығара алмаймын
Dialogue: 0,1:31:27.31,1:31:29.56,Default,,0,0,0,,Бұл Теменің шынайы тұлғасы ма?
Dialogue: 0,1:31:30.15,1:31:32.94,Default,,0,0,0,,Ол тіпті Бүкіл Құдірет-қа ұқсамайды.
Dialogue: 0,1:31:33.48,1:31:35.61,Default,,0,0,0,,- (Бакуго) Дұрыс емес пе? Деку!? - (Тодороки) Солай емес пе? Мидория!?
Dialogue: 0,1:31:39.36,1:31:42.58,Default,,0,0,0,,Маған Бүкіл Құдірет-тен «қызықтық» мұра болды, бірақ...
Dialogue: 0,1:31:43.49,1:31:46.83,Default,,0,0,0,,Мен ол адамды қуып жеткеніме сене алар емеспін.
Dialogue: 0,1:31:47.71,1:31:48.58,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:31:52.42,1:31:54.38,Default,,0,0,0,,Мен жалғыз емеспін
Dialogue: 0,1:31:55.63,1:31:58.88,Default,,0,0,0,,Менімен төбелесетін достарым бар
Dialogue: 0,1:31:59.01,1:32:00.13,Default,,0,0,0,,Менің достарым бар
Dialogue: 0,1:32:00.93,1:32:03.26,Default,,0,0,0,,Сенуге болатын батырлар бар
Dialogue: 0,1:32:05.77,1:32:07.89,Default,,0,0,0,,Бәріміз бірге жеңеміз.
Dialogue: 0,1:32:08.31,1:32:09.85,Default,,0,0,0,,Барлығымыз
Dialogue: 0,1:32:10.60,1:32:13.19,Default,,0,0,0,,Like Бүкіл Құдірет!
Dialogue: 0,1:32:13.48,1:32:15.73,Default,,0,0,0,,Уф... Уау!
Dialogue: 0,1:32:19.07,1:32:20.20,Default,,0,0,0,,Ах...
Dialogue: 0,1:32:25.91,1:32:27.70,Default,,0,0,0,,Барлығына күлімсіреу—
Dialogue: 0,1:32:27.83,1:32:29.54,Default,,0,0,0,,Оны сақтауға болады!
Dialogue: 0,1:32:30.75,1:32:31.54,Default,,0,0,0,,Детройт!
Dialogue: 0,1:32:31.83,1:32:32.54,Default,,0,0,0,,Техас!
Dialogue: 0,1:32:33.04,1:32:34.13,Default,,0,0,0,,Вайоминг!
Dialogue: 0,1:32:34.42,1:32:35.38,Default,,0,0,0,,Каролина!
Dialogue: 0,1:32:35.71,1:32:36.50,Default,,0,0,0,,Миссури!
Dialogue: 0,1:32:37.13,1:32:38.59,Default,,0,0,0,,Калифорния!
Dialogue: 0,1:32:38.71,1:32:40.22,Default,,0,0,0,,Нью-Гэмпшир!
Dialogue: 0,1:32:40.34,1:32:41.68,Default,,0,0,0,,Оклахома!
Dialogue: 0,1:32:41.80,1:32:44.22,Default,,0,0,0,,Сент-Луис!
Dialogue: 0,1:32:44.35,1:32:48.35,Default,,0,0,0,,Соққы!
Dialogue: 0,1:32:50.39,1:32:51.48,Default,,0,0,0,,Арх!
Dialogue: 0,1:32:57.23,1:33:01.32,Default,,0,0,0,,Бардо, сен билікке жабысасың —
Dialogue: 0,1:33:01.45,1:33:03.74,Default,,0,0,0,,Отбасын біріктіру мүмкін емес
Dialogue: 0,1:33:04.70,1:33:06.99,Default,,0,0,0,,Жалғыз қорқыныш адамды қозғамайды
Dialogue: 0,1:33:07.41,1:33:12.46,Default,,0,0,0,,Сол құдіретімен Бүкіл Құдірет өз мұраттарына жетті.
Dialogue: 0,1:33:12.71,1:33:16.25,Default,,0,0,0,,Ол өз мұраттары үшін билікке ие болғысы келді.
Dialogue: 0,1:33:16.38,1:33:18.21,Default,,0,0,0,,Сіз сияқты емес
Dialogue: 0,1:33:18.34,1:33:19.30,Default,,0,0,0,,Уф...
Dialogue: 0,1:33:19.42,1:33:21.22,Default,,0,0,0,,Шаааах!
Dialogue: 0,1:33:21.34,1:33:22.72,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:33:26.39,1:33:31.31,Default,,0,0,0,,А... Әке... Жоғарыда...
Dialogue: 0,1:33:40.19,1:33:41.82,Default,,0,0,0,,Иә?Ах...
Dialogue: 0,1:33:43.61,1:33:44.82,Default,,0,0,0,,Дегенмен, Дио осы қалада бір жерде болуы тиіс
Dialogue: 0,1:33:46.57,1:33:50.08,Default,,0,0,0,,Біткен сияқты.
Dialogue: 0,1:33:51.91,1:33:54.08,Default,,0,0,0,,Қараңғы кененің «даралығы» жойылды!?
Dialogue: 0,1:33:54.62,1:33:57.38,Default,,0,0,0,,-Дододо... неге? -Оны таптың.
Dialogue: 0,1:33:57.50,1:33:58.17,Default,,0,0,0,,Тұтқындарға арналған екінші жатақхана.
Dialogue: 0,1:33:58.63,1:34:01.46,Default,,0,0,0,,- Күш! -Арх!
Dialogue: 0,1:34:19.40,1:34:23.57,Default,,0,0,0,,Алып бекініс толығымен тоқтады.
Dialogue: 0,1:34:23.69,1:34:25.28,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,1:34:33.33,1:34:35.25,Default,,0,0,0,,Жарайсың
Dialogue: 0,1:34:41.84,1:34:43.42,Default,,0,0,0,,Хулио мырза!
Dialogue: 0,1:34:44.22,1:34:45.38,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,1:34:45.51,1:34:47.18,Default,,0,0,0,,Иә... иә
Dialogue: 0,1:34:47.30,1:34:50.26,Default,,0,0,0,,Сүйегің бірнеше жерден сынған сияқты.
Dialogue: 0,1:34:51.68,1:34:53.68,Default,,0,0,0,,Гррр…
Dialogue: 0,1:34:56.48,1:34:57.85,Default,,0,0,0,,Анна...
Dialogue: 0,1:35:04.19,1:35:05.57,Default,,0,0,0,,Уф...
Dialogue: 0,1:35:06.36,1:35:08.07,Default,,0,0,0,,Мен атама тіл тигізуіңе, тіпті маған тіл тигізуіңе де жол бере алмаймын.
Dialogue: 0,1:35:08.61,1:35:11.03,Default,,0,0,0,,Уф...
Dialogue: 0,1:35:12.58,1:35:15.00,Default,,0,0,0,,Иносукэ, кешір мені. Егер оны ертерек байқап қалсам...
Dialogue: 0,1:35:15.12,1:35:17.58,Default,,0,0,0,,Уау!
Dialogue: 0,1:35:19.92,1:35:21.75,Default,,0,0,0,,-(Тодороки) Уф... -(Бакуго) Бұл не?
Dialogue: 0,1:35:22.25,1:35:23.75,Default,,0,0,0,,Аннаның «индивидуалдылығы» бұл...
Dialogue: 0,1:35:23.92,1:35:26.84,Default,,0,0,0,,-Уф... Ааа! -(Изуку) Қашқын...
Dialogue: 0,1:35:35.89,1:35:37.35,Default,,0,0,0,,Мені ханымға апарыңыз
Dialogue: 0,1:35:37.48,1:35:38.14,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:35:38.64,1:35:39.52,Default,,0,0,0,,Өтінемін!
Dialogue: 0,1:35:41.23,1:35:42.23,Default,,0,0,0,,Иә
Dialogue: 0,1:35:55.20,1:35:56.66,Default,,0,0,0,,Уф...
Dialogue: 0,1:36:01.17,1:36:02.75,Default,,0,0,0,,-(Изуку) Уф... -Деку!
Dialogue: 0,1:36:11.76,1:36:12.76,Default,,0,0,0,,Мен білмейтін қыз…➡
Dialogue: 0,1:36:13.68,1:36:14.60,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:36:24.48,1:36:27.19,Default,,0,0,0,,Бекініс жөнделуде
Dialogue: 0,1:36:28.03,1:36:30.45,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,1:37:11.24,1:37:12.53,Default,,0,0,0,,Бірдеңе шықты
Dialogue: 0,1:37:15.49,1:37:17.91,Default,,0,0,0,,«Символ»
Dialogue: 0,1:37:18.04,1:37:22.71,Default,,0,0,0,,Мен... Мен бүкіл әлеммін
Dialogue: 0,1:37:31.92,1:37:32.93,Default,,0,0,0,,Гррр…
Dialogue: 0,1:37:58.70,1:38:01.62,Default,,0,0,0,,Жоқ, түптеп келгенде, сіз «индивидуалдылықты» пайдалана алмайсыз.
Dialogue: 0,1:38:02.41,1:38:04.50,Default,,0,0,0,,Өтінемін... Өтінемін...
Dialogue: 0,1:38:04.62,1:38:07.00,Default,,0,0,0,,Маған оны пайдалануға рұқсат етіңіз.
Dialogue: 0,1:38:07.88,1:38:11.38,Default,,0,0,0,,«Сапамды» қолдануға рұқсат етіңіз!
Dialogue: 0,1:38:22.68,1:38:25.48,Default,,0,0,0,,О, менің!
Dialogue: 0,1:38:38.45,1:38:42.75,Default,,0,0,0,,Көбірек, көбірек, көбірек күш!
Dialogue: 0,1:38:43.12,1:38:44.50,Default,,0,0,0,,Уф...
Dialogue: 0,1:38:56.30,1:38:56.97,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,1:38:59.72,1:39:00.68,Default,,0,0,0,,Гррр…
Dialogue: 0,1:39:03.35,1:39:04.27,Default,,0,0,0,,Ол келді.
Dialogue: 0,1:39:05.23,1:39:07.06,Default,,0,0,0,,Уф...
Dialogue: 0,1:39:12.73,1:39:13.94,Default,,0,0,0,,Гррр…
Dialogue: 0,1:39:24.75,1:39:26.66,Default,,0,0,0,,Мұның соңы жоқ.
Dialogue: 0,1:39:26.96,1:39:30.21,Default,,0,0,0,,Қарғыс атсын, оян, Деку.
Dialogue: 0,1:39:30.33,1:39:31.54,Default,,0,0,0,,(Изуку) Ж-жарайды… егер тура жүріп кетсек, Алл Майт бізді күтіп тұрады.
Dialogue: 0,1:39:32.54,1:39:34.00,Default,,0,0,0,,Ханым…
Dialogue: 0,1:39:34.92,1:39:35.88,Default,,0,0,0,,Мен атама тіл тигізуіңе, тіпті маған тіл тигізуіңе де жол бере алмаймын.
Dialogue: 0,1:39:40.68,1:39:41.85,Default,,0,0,0,,Бұдан былай...
Dialogue: 0,1:39:42.85,1:39:45.56,Default,,0,0,0,,Бұдан былай мен әрқашан сенің жаныңда боламын.
Dialogue: 0,1:39:46.27,1:39:48.23,Default,,0,0,0,,Мен осында болсам, жас ханым...
Dialogue: 0,1:39:48.35,1:39:51.81,Default,,0,0,0,,Ол аз ғана байыған «тұлғасы жоқ» адам.
Dialogue: 0,1:39:53.48,1:39:54.82,Default,,0,0,0,,Фу…
Dialogue: 0,1:40:25.85,1:40:26.72,Default,,0,0,0,,Уф...
Dialogue: 0,1:42:57.92,1:42:59.21,Default,,0,0,0,,Ах...
Dialogue: 0,1:43:01.80,1:43:02.92,Default,,0,0,0,,Хулио
Dialogue: 0,1:43:05.80,1:43:10.10,Default,,0,0,0,,Хулио? Мықты бол, Хулио, Хулио!
Dialogue: 0,1:43:10.60,1:43:11.89,Default,,0,0,0,,Бұл...
Dialogue: 0,1:43:12.22,1:43:15.52,Default,,0,0,0,,Жоқ! Өтінемін ояныңыз
Dialogue: 0,1:43:17.39,1:43:18.52,Default,,0,0,0,,Хулио
Dialogue: 0,1:43:20.94,1:43:22.36,Default,,0,0,0,,Рұқсатсыз...
Dialogue: 0,1:43:23.86,1:43:26.11,Default,,0,0,0,,Өтінемін, мені өлтірмейсің бе?
Dialogue: 0,1:43:26.24,1:43:27.07,Default,,0,0,0,,Хулио!
Dialogue: 0,1:43:29.99,1:43:34.33,Default,,0,0,0,,Жас ханым өз шегінен асып, өзінің барлық «жекелік факторларын» сыртқа шығарды.
Dialogue: 0,1:43:35.29,1:43:37.71,Default,,0,0,0,,Бәрінен бас тарттыңыз ба?
Dialogue: 0,1:43:37.83,1:43:42.25,Default,,0,0,0,,Ханым факторына жауап ретінде мен оны өзгерген «даралығыммен» толтырдым.
Dialogue: 0,1:43:43.13,1:43:45.21,Default,,0,0,0,,Мұның бәрі кірді немесе шықты...
Dialogue: 0,1:43:45.34,1:43:49.22,Default,,0,0,0,,Шамасы, мен саған тең болдым.
Dialogue: 0,1:43:49.76,1:43:53.18,Default,,0,0,0,,Енді «жекеліктен» зардап шекпейді
Dialogue: 0,1:43:53.64,1:43:57.02,Default,,0,0,0,,Сіз шынымен жас ханымсыз.
Dialogue: 0,1:43:59.85,1:44:02.40,Default,,0,0,0,,Бұл келісім-шарт аяқталды дегенді білдіреді.
Dialogue: 0,1:44:03.15,1:44:07.07,Default,,0,0,0,,Сен енді нысана емессің, мен сенің жаныңда болуым керек емес.
Dialogue: 0,1:44:07.49,1:44:11.37,Default,,0,0,0,,Өзіңізге ұнайтын нәрсені түртіп, қалаған жеріңізге барыңыз
Dialogue: 0,1:44:12.49,1:44:13.70,Default,,0,0,0,,Сіз боссыз.
Dialogue: 0,1:44:20.50,1:44:23.38,Default,,0,0,0,,(Аннаның ізі)
Dialogue: 0,1:44:27.13,1:44:29.72,Default,,0,0,0,,Сіз мені тыңдамайсыз ба?
Dialogue: 0,1:44:29.97,1:44:31.18,Default,,0,0,0,,Мен естідім.
Dialogue: 0,1:44:32.09,1:44:34.43,Default,,0,0,0,,Еңбек шарты аяқталды.
Dialogue: 0,1:44:34.55,1:44:38.14,Default,,0,0,0,,Жақсы, енді біз тең бола аламыз.
Dialogue: 0,1:44:39.69,1:44:40.56,Default,,0,0,0,,Ах...
Dialogue: 0,1:44:41.52,1:44:42.69,Default,,0,0,0,,Ол келді.
Dialogue: 0,1:44:42.81,1:44:44.23,Default,,0,0,0,,Сәлем Анна...
Dialogue: 0,1:44:44.73,1:44:46.11,Default,,0,0,0,,Ах...
Dialogue: 0,1:44:54.91,1:44:55.95,Default,,0,0,0,,Анна…
Dialogue: 0,1:44:58.95,1:45:02.04,Default,,0,0,0,,Хулио мырза, сіз білесіз бе?
Dialogue: 0,1:45:06.34,1:45:07.84,Default,,0,0,0,,Мен күлемін
Dialogue: 0,1:45:07.96,1:45:09.63,Default,,0,0,0,,Хэхе...
Dialogue: 0,1:45:17.39,1:45:21.52,Default,,0,0,0,,Қайтарып алайық, бәріміз бірге жұмыс жасайық
Dialogue: 0,1:45:22.52,1:45:26.40,Default,,0,0,0,,Оны тек өзіміз алатындай етіп қайтарайық
Dialogue: 0,1:45:28.53,1:45:31.65,Default,,0,0,0,,Барлығына күлімдеңдер!
Dialogue: 0,1:45:35.12,1:45:37.24,Default,,0,0,0,,♪ Сол жарықтың
Dialogue: 0,1:45:38.37,1:45:39.79,Default,,0,0,0,,♪ Дауылдар – адамдар
Dialogue: 0,1:45:39.91,1:45:47.59,Default,,0,0,0,,♪ Мен оны өзіммен бірге алып кеттім.
Dialogue: 0,1:45:47.79,1:45:51.76,Default,,0,0,0,,♪ Кенеттен шыққан сөздер
Dialogue: 0,1:45:51.88,1:46:00.18,Default,,0,0,0,,♪ Иә, мен қан әкелдім.
Dialogue: 0,1:46:00.31,1:46:03.44,Default,,0,0,0,,♪ Бір күні біреу
Dialogue: 0,1:46:06.56,1:46:09.90,Default,,0,0,0,,♪ Мен және ауырсыну
Dialogue: 0,1:46:10.03,1:46:13.11,Default,,0,0,0,,♪ Бөліссек
Dialogue: 0,1:46:17.45,1:46:21.83,Default,,0,0,0,,♪ Күнде адамдардың бетіне тиісе беретінмін.
Dialogue: 0,1:46:21.95,1:46:26.92,Default,,0,0,0,,♪ Бұл махаббаттың сыйы
Dialogue: 0,1:46:29.67,1:46:32.55,Default,,0,0,0,,♪ Қышқыл және тәтті
Dialogue: 0,1:46:32.67,1:46:33.63,Default,,0,0,0,,♪ үнемі сүйісу
Dialogue: 0,1:46:33.76,1:46:35.88,Default,,0,0,0,,♪ аа аа аа
Dialogue: 0,1:46:36.01,1:46:39.26,Default,,0,0,0,,♪ Тіпті қазір, сіздің күндеріңізде
Dialogue: 0,1:46:39.39,1:46:42.35,Default,,0,0,0,,♪ Жүрегімде жинақталған сөздер
Dialogue: 0,1:46:42.47,1:46:45.52,Default,,0,0,0,,♪ Бір күні сенің жарығың
Dialogue: 0,1:46:45.64,1:46:47.65,Default,,0,0,0,,♪ Біртіндеп
Dialogue: 0,1:46:47.77,1:46:51.98,Default,,0,0,0,,♪ саған сыйлық, махаббат
Dialogue: 0,1:47:02.83,1:47:07.50,Default,,0,0,0,,♪ Баланың жарқыраған жүрегі
Dialogue: 0,1:47:07.62,1:47:14.21,Default,,0,0,0,,♪ Барлығын өзіммен бірге алып кеттім.
Dialogue: 0,1:47:14.34,1:47:19.97,Default,,0,0,0,,♪ Ал бала анасының нұрын көрді
Dialogue: 0,1:47:20.10,1:47:27.60,Default,,0,0,0,,♪ Мен оны кеудемде алып жатқанымды түсіндім.
Dialogue: 0,1:47:27.94,1:47:32.23,Default,,0,0,0,,♪ Әрқашан біреу бар
Dialogue: 0,1:47:33.86,1:47:36.99,Default,,0,0,0,,♪ Бақыттан менің үлесім
Dialogue: 0,1:47:37.11,1:47:41.20,Default,,0,0,0,,♪ Мен келісімшарт бойынша екенімді білдім.
Dialogue: 0,1:47:44.87,1:47:49.58,Default,,0,0,0,,♪ Адамдардың бетінен тигізе беретінім сондықтан.
Dialogue: 0,1:47:49.71,1:47:52.63,Default,,0,0,0,,♪ Бұл азаптың сыйы
Dialogue: 0,1:47:52.75,1:47:55.38,Default,,0,0,0,,♪ Олар оны «жаңбыр» деп атайды
Dialogue: 0,1:47:55.51,1:47:57.30,Default,,0,0,0,,♪ және олар суланған
Dialogue: 0,1:47:57.42,1:47:59.72,Default,,0,0,0,,♪ әрқашан
Dialogue: 0,1:48:00.72,1:48:03.89,Default,,0,0,0,,♪ Жынданып қалу
Dialogue: 0,1:48:04.47,1:48:10.23,Default,,0,0,0,,♪ Ой, бұл кемпірқосақ
Dialogue: 0,1:48:18.07,1:48:21.57,Default,,0,0,0,,♪ Әрқашан біреу бар
Dialogue: 0,1:48:24.28,1:48:27.37,Default,,0,0,0,,♪ Менің жүрегім
Dialogue: 0,1:48:27.50,1:48:31.63,Default,,0,0,0,,♪ Жерленгенін білдім.
Dialogue: 0,1:48:34.88,1:48:39.63,Default,,0,0,0,,♪ Адамдардың бетінен тигізе беретінім сондықтан.
Dialogue: 0,1:48:39.76,1:48:44.68,Default,,0,0,0,,♪ Бұл махаббаттың сыйы
Dialogue: 0,1:48:47.39,1:48:50.14,Default,,0,0,0,,♪ Ащы және тәтті
Dialogue: 0,1:48:50.27,1:48:51.35,Default,,0,0,0,,♪ үнемі сүйісу
Dialogue: 0,1:48:51.48,1:48:53.65,Default,,0,0,0,,♪ ааа ааа
Dialogue: 0,1:48:53.77,1:48:57.07,Default,,0,0,0,,♪ Әлі де сіздің күндеріңізде
Dialogue: 0,1:48:57.19,1:49:00.15,Default,,0,0,0,,♪ Жүрегімде жинақталған сөздер
Dialogue: 0,1:49:00.28,1:49:03.20,Default,,0,0,0,,♪ Бір күні сіздің жарыңыз
Dialogue: 0,1:49:03.32,1:49:05.33,Default,,0,0,0,,♪ Бірте-бірте
Dialogue: 0,1:49:05.45,1:49:07.70,Default,,0,0,0,,♪ Жаңбырдан сыйлық
Dialogue: 0,1:49:07.83,1:49:10.91,Default,,0,0,0,,♪ Барлығын ұстаңыз
Dialogue: 0,1:49:11.04,1:49:15.04,Default,,0,0,0,,♪ Мама маған «Бәрі осы» деді
Dialogue: 0,1:49:15.84,1:49:19.05,Default,,0,0,0,,♪ Махаббатқа толы
Dialogue: 0,1:49:43.07,1:49:49.83,Default,,0,0,0,,Сен, қара нәсілді жексұрын!
Dialogue: 0,1:49:51.33,1:49:57.33,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory