Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.96,0:00:09.84,Default,,0,0,0,,Оңтүстік галактикадан шыққан бақа ойыншысы
Dialogue: 0,0:00:09.96,0:00:12.26,Default,,0,0,0,,Жартылай финалға өту туралы шешім қабылданды
Dialogue: 0,0:00:12.38,0:00:14.51,Default,,0,0,0,,Жақсы ұрыңыз.
Dialogue: 0,0:00:14.63,0:00:16.34,Default,,0,0,0,,Ол қазірдің өзінде сыпайы.
Dialogue: 0,0:00:16.47,0:00:18.72,Default,,0,0,0,,Пупупп… Шығыстағы Кайу (Шығыстағы Кайу) иә?
Dialogue: 0,0:00:18.85,0:00:20.93,Default,,0,0,0,,Бұл ойыншыңыз әлі де жақсы емес.
Dialogue: 0,0:00:21.06,0:00:23.69,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:00:23.81,0:00:26.73,Default,,0,0,0,,Hmph. Өлген адам болса да, сөйлейтін шебер.
Dialogue: 0,0:00:26.86,0:00:29.23,Default,,0,0,0,,Сүйкімді қария емес
Dialogue: 0,0:00:29.36,0:00:30.98,Default,,0,0,0,,Қарт деген не?
Dialogue: 0,0:00:31.11,0:00:33.49,Default,,0,0,0,,Ах! Не? (Коу но Кай) Не!
Dialogue: 0,0:00:33.61,0:00:35.32,Default,,0,0,0,,Екеуі де.
Dialogue: 0,0:00:35.45,0:00:38.70,Default,,0,0,0,,Дүние жүзіндегі ең үздік жекпе-жек шеберін әлемдегі ең жақсы жекпе-жек шебері анықтайды.
Dialogue: 0,0:00:38.83,0:00:42.58,Default,,0,0,0,,Жеңімпаз - менің галактикадан шыққан бақа.
Dialogue: 0,0:00:42.70,0:00:44.75,Default,,0,0,0,,Бекер ұрысудың қажеті жоқ.
Dialogue: 0,0:00:44.87,0:00:48.71,Default,,0,0,0,,Әйтеуір, Оңтүстік патшасы Кай, ақымақ ештеңе айтпа.
Dialogue: 0,0:00:48.84,0:00:52.01,Default,,0,0,0,,Жеңіске жетсеңіз, жақын арада Гранд Кайдан жаттығу аласыз.
Dialogue: 0,0:00:52.13,0:00:53.59,Default,,0,0,0,,Бұл менің ұлым Гоку.
Dialogue: 0,0:00:53.72,0:00:55.97,Default,,0,0,0,,Бақа! (Солтүстік патшасы) Сон Гоку!
Dialogue: 0,0:00:56.09,0:00:59.51,Default,,0,0,0,,Міне, осы, келесі жартылай финал басталды.
Dialogue: 0,0:00:59.64,0:01:01.06,Default,,0,0,0,,Иә!
Dialogue: 0,0:01:05.14,0:01:06.06,Default,,0,0,0,,Иә!
Dialogue: 0,0:01:06.19,0:01:08.31,Default,,0,0,0,,Солтүстік галактикадан шыққан Сон Гоку
Dialogue: 0,0:01:08.44,0:01:10.32,Default,,0,0,0,,Финалға өту оңай.
Dialogue: 0,0:01:10.44,0:01:12.07,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:01:12.19,0:01:16.91,Default,,0,0,0,,Гоку Жақсы, жақсы, хехехехе...
Dialogue: 0,0:01:17.03,0:01:20.53,Default,,0,0,0,,Мен жеңдім, жеңдім, ия, о...
Dialogue: 0,0:01:23.66,0:01:27.54,Default,,0,0,0,,Батыс Галактикадан келген Пайкухан да мықты және финалға шығады.
Dialogue: 0,0:01:28.54,0:01:29.63,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:01:29.75,0:01:31.34,Default,,0,0,0,,Пайкухан күткендей
Dialogue: 0,0:01:31.46,0:01:34.59,Default,,0,0,0,,Егер бұлай болса, мен Пайкуханды қадағалайтын боламын.
Dialogue: 0,0:01:34.71,0:01:36.13,Default,,0,0,0,,Қарсылас тым әлсіз болды.
Dialogue: 0,0:01:36.26,0:01:38.55,Default,,0,0,0,,Менікі бәрібір тым әлсіз.
Dialogue: 0,0:01:38.68,0:01:41.93,Default,,0,0,0,,Шығыс галактика жойылады.
Dialogue: 0,0:01:42.06,0:01:43.89,Default,,0,0,0,,Мугю…
Dialogue: 0,0:01:44.60,0:01:46.94,Default,,0,0,0,,Күтілгендей, Гоку-чан мен Пайкухан-чан...
Dialogue: 0,0:01:47.06,0:01:48.69,Default,,0,0,0,,Бұл керемет сияқты.
Dialogue: 0,0:01:48.81,0:01:50.94,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:01:51.06,0:01:53.78,Default,,0,0,0,,Гоку, мен бүгін шешемін.
Dialogue: 0,0:01:53.90,0:01:55.53,Default,,0,0,0,,Ора Мода Пайкухан
Dialogue: 0,0:02:01.66,0:02:03.99,Default,,0,0,0,,Ол кезде ақырет өмірінің ережелері...
Dialogue: 0,0:02:04.12,0:02:10.08,Default,,0,0,0,,Барлығын басқаратын Энма патшаның басына бір сұмдық оқиға болайын деп тұр еді.
Dialogue: 0,0:02:22.10,0:02:28.10,Default,,0,0,0,,♪〜
Dialogue: 0,0:04:02.20,0:04:08.20,Default,,0,0,0,,〜♪
Dialogue: 0,0:04:11.91,0:04:15.96,Default,,0,0,0,,Иә, иә, жандарым, дұрыс сапқа тұрыңдар.
Dialogue: 0,0:04:16.08,0:04:20.17,Default,,0,0,0,,Сапқа тұрыңдар, сонда жандар секірмейді.
Dialogue: 0,0:04:21.42,0:04:24.55,Default,,0,0,0,,Аспанға бару Аспанға бару...
Dialogue: 0,0:04:24.68,0:04:28.01,Default,,0,0,0,,Тозаққа бару Тозаққа бару
Dialogue: 0,0:04:28.14,0:04:31.98,Default,,0,0,0,,Тозаққа бару Тозаққа барады
Dialogue: 0,0:04:32.10,0:04:34.27,Default,,0,0,0,,Жұмаққа баратындардың барлығын құттықтаймын
Dialogue: 0,0:04:34.39,0:04:36.81,Default,,0,0,0,,Мен бәріңнің аспанға ұшақпен мінгеніңді қалаймын.
Dialogue: 0,0:04:36.94,0:04:39.02,Default,,0,0,0,,Мұнда басыңыз...
Dialogue: 0,0:04:39.15,0:04:40.65,Default,,0,0,0,,Тозаққа баратындар үшін —
Dialogue: 0,0:04:40.78,0:04:43.53,Default,,0,0,0,,Жаман жүрегіңді тазартуыңды қалаймын.
Dialogue: 0,0:04:43.65,0:04:45.82,Default,,0,0,0,,Әлгі спиртті жууға арналған құрылғы...
Dialogue: 0,0:04:45.95,0:04:47.49,Default,,0,0,0,,Кіріңіз
Dialogue: 0,0:05:06.26,0:05:10.01,Default,,0,0,0,,Ия... иә иә
Dialogue: 0,0:05:11.01,0:05:13.98,Default,,0,0,0,,Тозақ
Dialogue: 0,0:05:14.10,0:05:16.98,Default,,0,0,0,,Бүгінгі Ұлы Патша біраз қатал адам.
Dialogue: 0,0:05:19.94,0:05:22.15,Default,,0,0,0,,Иә...
Dialogue: 0,0:05:22.28,0:05:24.82,Default,,0,0,0,,Әй, танкші, сен неменеге босап тұрсың?
Dialogue: 0,0:05:24.94,0:05:26.99,Default,,0,0,0,,Яй (Көк жын) Эй, танк қызметкері
Dialogue: 0,0:05:27.11,0:05:29.99,Default,,0,0,0,,Ия иә
Dialogue: 0,0:05:30.12,0:05:32.24,Default,,0,0,0,,Бұл дұрыс емес. Мен көп жұмыс істеуім керек.
Dialogue: 0,0:05:32.37,0:05:35.96,Default,,0,0,0,,Король Энмаға есеп беріп, жалақыңызды азайтыңыз.
Dialogue: 0,0:05:36.08,0:05:39.58,Default,,0,0,0,,Егер менің жалақымды одан әрі төмендетсе, менің жалақым бос болады.
Dialogue: 0,0:05:39.71,0:05:42.30,Default,,0,0,0,,Ендеше, еңбек ет, адам.
Dialogue: 0,0:05:43.71,0:05:46.13,Default,,0,0,0,,Аа, резервуарды ауыстырған дұрыс емес пе?
Dialogue: 0,0:05:46.26,0:05:47.59,Default,,0,0,0,,Ия
Dialogue: 0,0:05:47.72,0:05:49.97,Default,,0,0,0,,Ол шынымен бос емес.
Dialogue: 0,0:05:50.09,0:05:52.43,Default,,0,0,0,,Ол жаман адам емес.
Dialogue: 0,0:05:54.06,0:05:56.68,Default,,0,0,0,,Яй иә
Dialogue: 0,0:05:56.81,0:05:58.44,Default,,0,0,0,,(Изуку) Мен үшін ұпайлар аса маңызды емес. (Оқушы) Жоғары ондықтағы біреу…
Dialogue: 0,0:05:58.56,0:06:00.15,Default,,0,0,0,,Ия
Dialogue: 0,0:06:06.94,0:06:08.86,Default,,0,0,0,,Яй (жарылыс дыбысы)
Dialogue: 0,0:06:09.82,0:06:11.45,Default,,0,0,0,,Не! (Акаони) өте жақсы
Dialogue: 0,0:06:11.57,0:06:14.58,Default,,0,0,0,,Спирттік сұйықтықтарды жууға арналған құрылғыда ауытқу орын алды.
Dialogue: 0,0:06:14.70,0:06:16.87,Default,,0,0,0,,Айтып қояйын, жігіттер — дереу сол иттен алыстаңдар.
Dialogue: 0,0:06:18.46,0:06:22.59,Default,,0,0,0,,Мен не істеуім керек? Ол кетпейді.
Dialogue: 0,0:06:23.09,0:06:26.34,Default,,0,0,0,,Не... ақымақ! Мен резервуарды ауыстырған жоқпын.
Dialogue: 0,0:06:31.47,0:06:32.51,Default,,0,0,0,,Ах…
Dialogue: 0,0:06:32.64,0:06:36.27,Default,,0,0,0,,Авававуа…
Dialogue: 0,0:06:37.14,0:06:39.94,Default,,0,0,0,,О, құдайым...
Dialogue: 0,0:06:45.36,0:06:48.07,Default,,0,0,0,,Рухты жуу құралымен жуылған зұлым рух —
Dialogue: 0,0:06:48.19,0:06:50.32,Default,,0,0,0,,Барлығы бірге босатылды.
Dialogue: 0,0:06:50.45,0:06:51.99,Default,,0,0,0,,Бір қорқынышты нәрсе болды!
Dialogue: 0,0:06:52.82,0:06:54.95,Default,,0,0,0,,Мен мұндай нәрсе болады деп күтпедім...
Dialogue: 0,0:06:57.45,0:06:58.96,Default,,0,0,0,,Жанемба Джанемба
Dialogue: 0,0:06:59.08,0:07:02.17,Default,,0,0,0,,Жанемба Джанемба
Dialogue: 0,0:07:02.58,0:07:05.55,Default,,0,0,0,,Энма-сама: Газға шомылу арқылы өзгерген жын...
Dialogue: 0,0:07:07.38,0:07:08.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:09.59,0:07:13.09,Default,,0,0,0,,Энма сарайының айналасына тосқауыл қойған ол ма?
Dialogue: 0,0:07:13.22,0:07:16.22,Default,,0,0,0,,Сізді зұлым рух билеген болуы керек.
Dialogue: 0,0:07:17.35,0:07:20.06,Default,,0,0,0,,Ұлы патша, сен бірдеңе істей алмайсың ба?
Dialogue: 0,0:07:20.18,0:07:24.65,Default,,0,0,0,,Тосқауыл қойған жігітке бірдеңе жасаудан басқа амалымыз жоқ...
Dialogue: 0,0:07:24.77,0:07:27.02,Default,,0,0,0,,Қалай болса да, ол маған берілді—
Dialogue: 0,0:07:27.15,0:07:30.32,Default,,0,0,0,,Өмірден кейінгі өмірді дұрыс басқара алмау
Dialogue: 0,0:07:30.45,0:07:33.36,Default,,0,0,0,,Бұлай болса, осы және басқа дүниелердің заңдары бұзылады.
Dialogue: 0,0:07:33.49,0:07:37.24,Default,,0,0,0,,Өлгендер тіріліп, үлкен шу болады.
Dialogue: 0,0:07:37.37,0:07:39.12,Default,,0,0,0,,Әлгі жігіт...
Dialogue: 0,0:07:41.12,0:07:42.17,Default,,0,0,0,,Ух... Ха!
Dialogue: 0,0:07:43.71,0:07:45.08,Default,,0,0,0,,Не, не? (Солтүстік патшасы) Ах, ах
Dialogue: 0,0:07:45.21,0:07:47.09,Default,,0,0,0,,Не болды?
Dialogue: 0,0:07:54.59,0:07:58.35,Default,,0,0,0,,Кя! Елес! Ах
Dialogue: 0,0:07:58.47,0:08:00.39,Default,,0,0,0,,Атаның аруағы...
Dialogue: 0,0:08:00.52,0:08:05.19,Default,,0,0,0,,Мен бес жыл бұрын қайтыс болғаныма сенемін.
Dialogue: 0,0:08:05.31,0:08:07.61,Default,,0,0,0,,Аяқтары да жақсы.
Dialogue: 0,0:08:07.73,0:08:09.40,Default,,0,0,0,,Бұл елес емес пе?
Dialogue: 0,0:08:09.53,0:08:11.40,Default,,0,0,0,,Джулиано!
Dialogue: 0,0:08:13.03,0:08:15.28,Default,,0,0,0,,Сіз ше? Бұл Ромео
Dialogue: 0,0:08:15.41,0:08:16.74,Default,,0,0,0,,Иә, Джулиано.
Dialogue: 0,0:08:16.87,0:08:19.37,Default,,0,0,0,,Ромео Қарт болып кеттің.
Dialogue: 0,0:08:19.49,0:08:21.29,Default,,0,0,0,,Джулиано, сен қайтыс болғаннан бері...
Dialogue: 0,0:08:21.41,0:08:24.62,Default,,0,0,0,,60 жыл болды, көмектесуге болмайды деп ойлаймын.
Dialogue: 0,0:08:24.75,0:08:27.21,Default,,0,0,0,,О дүниеде қартаймайсың ба?
Dialogue: 0,0:08:27.59,0:08:30.46,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:08:30.59,0:08:32.72,Default,,0,0,0,,Ілгекті алып тастаңыз.
Dialogue: 0,0:08:32.84,0:08:36.64,Default,,0,0,0,,Куиді жұлып алмасаң, өкінесің.
Dialogue: 0,0:08:36.76,0:08:39.43,Default,,0,0,0,,Не болды? Ол мүлде қозғалмайды. А?
Dialogue: 0,0:08:49.69,0:08:53.74,Default,,0,0,0,,Әлем біздікі. Бізге қарсы шыққандарды өлтіріңіз.
Dialogue: 0,0:08:56.45,0:08:58.20,Default,,0,0,0,,Өлгендер қайта тіріледі
Dialogue: 0,0:08:58.32,0:09:00.45,Default,,0,0,0,,Дүние – бейберекет
Dialogue: 0,0:09:00.58,0:09:02.91,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:09:07.08,0:09:09.54,Default,,0,0,0,,Мама, мен қосымша тамақ алғым келеді, өтінемін.
Dialogue: 0,0:09:09.67,0:09:11.42,Default,,0,0,0,,Мен де
Dialogue: 0,0:09:11.55,0:09:14.09,Default,,0,0,0,,Екеуі әлі тамақ ішіп жатыр ма?
Dialogue: 0,0:09:17.51,0:09:19.60,Default,,0,0,0,,Күрсін... Одан кейін жинаймын...
Dialogue: 0,0:09:19.72,0:09:22.01,Default,,0,0,0,,Барлығын мен жасау керек.
Dialogue: 0,0:09:22.14,0:09:23.60,Default,,0,0,0,,Гоку Са жақсы.
Dialogue: 0,0:09:23.72,0:09:25.94,Default,,0,0,0,,Ол қазір о дүниеде демалып жатқан болуы керек.
Dialogue: 0,0:09:26.06,0:09:27.02,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:09:27.14,0:09:28.48,Default,,0,0,0,,Мен де көмектесемін
Dialogue: 0,0:09:28.60,0:09:30.19,Default,,0,0,0,,Видель мырза тапсырыс беруші.
Dialogue: 0,0:09:30.31,0:09:32.40,Default,,0,0,0,,Мен бұған жол бере алмаймын.
Dialogue: 0,0:09:36.53,0:09:40.41,Default,,0,0,0,,Видель-сан, сен өте жақсы істеп жатырсың. Ол жақсы әйел болады деп ойлаймын.
Dialogue: 0,0:09:40.53,0:09:43.58,Default,,0,0,0,,А... Сенің әйелің екеніне сене алар емеспін.
Dialogue: 0,0:09:45.50,0:09:46.50,Default,,0,0,0,,(тақталардың сынған дыбысы)
Dialogue: 0,0:09:46.62,0:09:47.87,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:09:48.00,0:09:52.13,Default,,0,0,0,,Жарайды, жарайды, бір-екі табақ сенің жақсы әйел екеніңді өзгертпейді.
Dialogue: 0,0:09:52.25,0:09:53.55,Default,,0,0,0,,Ах... (тақталардың сынған дыбысы)
Dialogue: 0,0:09:53.67,0:09:54.38,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:09:55.30,0:09:57.38,Default,,0,0,0,,Ах
Dialogue: 0,0:09:57.51,0:09:59.51,Default,,0,0,0,,Иә, мұнда Видель
Dialogue: 0,0:09:59.64,0:10:02.26,Default,,0,0,0,,Өлгендер тіріліп, қала үрейленді.
Dialogue: 0,0:10:02.39,0:10:03.39,Default,,0,0,0,,Өлген адам?
Dialogue: 0,0:10:03.51,0:10:05.14,Default,,0,0,0,,Дереу қозғалыңыз
Dialogue: 0,0:10:05.27,0:10:07.18,Default,,0,0,0,,Ұлы Сайяманға сәлем айт
Dialogue: 0,0:10:07.31,0:10:09.48,Default,,0,0,0,,Түсінікті! Гохан-кун
Dialogue: 0,0:10:09.60,0:10:11.02,Default,,0,0,0,,Иә
Dialogue: 0,0:10:13.94,0:10:14.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:15.15,0:10:15.82,Default,,0,0,0,,Не?
Dialogue: 0,0:10:15.94,0:10:18.53,Default,,0,0,0,,Уа... Тамаша Кай, не болды?
Dialogue: 0,0:10:19.36,0:10:21.70,Default,,0,0,0,,Маен Чанның проблемасы себеп болған сияқты.
Dialogue: 0,0:10:21.82,0:10:22.99,Default,,0,0,0,,Энманың ағасы қайда?
Dialogue: 0,0:10:23.74,0:10:25.54,Default,,0,0,0,,Ол жерге бармайынша білмейсің.
Dialogue: 0,0:10:25.66,0:10:27.46,Default,,0,0,0,,Иә, мен бірден барамын.
Dialogue: 0,0:10:27.58,0:10:31.38,Default,,0,0,0,,Ей, эй, Пайкухан, мен әлі қарым-қатынасыма үйренген жоқпын.
Dialogue: 0,0:10:31.50,0:10:33.25,Default,,0,0,0,,Эй, әдепкі бойынша жеңгенім үшін кешірім сұраймын.
Dialogue: 0,0:10:33.38,0:10:35.34,Default,,0,0,0,,Гоку-чанмен неге бармайсың?
Dialogue: 0,0:10:35.46,0:10:37.34,Default,,0,0,0,,Финалға кейінірек қатыса аласыз.
Dialogue: 0,0:10:37.47,0:10:39.63,Default,,0,0,0,,Жарайды, Пайкухан-чан, Гоку-чан, мен сұрадым.
Dialogue: 0,0:10:39.76,0:10:40.47,Default,,0,0,0,,Иә
Dialogue: 0,0:10:40.59,0:10:42.60,Default,,0,0,0,,Уа... Мен көмектесе алмаймын.
Dialogue: 0,0:10:42.72,0:10:45.72,Default,,0,0,0,,Пайкухан, тез арада жинастырып қайтайық.
Dialogue: 0,0:10:45.85,0:10:47.64,Default,,0,0,0,,Оланың иығынан тез ұстаңыз
Dialogue: 0,0:10:48.27,0:10:51.65,Default,,0,0,0,,Энманың қарт рухы, ол неге әлсіз?
Dialogue: 0,0:10:51.77,0:10:53.56,Default,,0,0,0,,Барсаң көресің.
Dialogue: 0,0:10:57.74,0:11:00.70,Default,,0,0,0,,Бұл Енмакай ма? Ол көп өзгерді.
Dialogue: 0,0:11:01.61,0:11:04.20,Default,,0,0,0,,Ішінде Энманың ағасы бар.
Dialogue: 0,0:11:04.33,0:11:06.45,Default,,0,0,0,,Гоку, рахмет
Dialogue: 0,0:11:06.58,0:11:09.16,Default,,0,0,0,,Енмақай тосқауыл қойды.
Dialogue: 0,0:11:09.29,0:11:13.54,Default,,0,0,0,,Ағай, біз сізді құтқарамыз, уайымдамаңыз.
Dialogue: 0,0:11:13.67,0:11:15.59,Default,,0,0,0,,Пайкухан Мен тосқауылды бұзамын
Dialogue: 0,0:11:15.71,0:11:16.71,Default,,0,0,0,,Жарайды
Dialogue: 0,0:11:23.05,0:11:24.93,Default,,0,0,0,,Энергия жұтылып жатыр
Dialogue: 0,0:11:25.05,0:11:25.93,Default,,0,0,0,,Тағы бір рет
Dialogue: 0,0:11:26.06,0:11:27.64,Default,,0,0,0,,Бәрінің себебі төбеде.
Dialogue: 0,0:11:27.77,0:11:29.64,Default,,0,0,0,,Мына жігітті төбеге жарып жіберіңіз
Dialogue: 0,0:11:29.77,0:11:31.98,Default,,0,0,0,,Әй... төбедегі жігіт?
Dialogue: 0,0:11:36.11,0:11:38.28,Default,,0,0,0,,Уау...
Dialogue: 0,0:11:38.40,0:11:39.65,Default,,0,0,0,,Ах
Dialogue: 0,0:11:40.36,0:11:42.53,Default,,0,0,0,,Ей, сен сондай ақымақсың.
Dialogue: 0,0:11:42.66,0:11:44.32,Default,,0,0,0,,Әлгі жігіт, жарайды, мен!
Dialogue: 0,0:11:44.45,0:11:45.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:45.74,0:11:48.24,Default,,0,0,0,,Ей, тосқауыл қойған сен бе?
Dialogue: 0,0:11:48.37,0:11:49.66,Default,,0,0,0,,Жанемба Джанемба
Dialogue: 0,0:11:49.79,0:11:54.33,Default,,0,0,0,,Жанемба? Сен жақсы қызсың, сондықтан тосқауылды тез арада алып таста.
Dialogue: 0,0:11:56.29,0:11:58.17,Default,,0,0,0,,Ей, қайта-қайта айта берме.
Dialogue: 0,0:11:58.30,0:12:00.21,Default,,0,0,0,,Сізге кедергіні алып тастаған дұрыс.
Dialogue: 0,0:12:00.34,0:12:01.01,Default,,0,0,0,,Жанемба
Dialogue: 0,0:12:01.13,0:12:04.14,Default,,0,0,0,,Эй, сен мені мазақ етіп тұрсың ба...
Dialogue: 0,0:12:05.80,0:12:09.85,Default,,0,0,0,,Пайкухан! Сен сондай күштісің. Сен кімсің?
Dialogue: 0,0:12:09.97,0:12:11.98,Default,,0,0,0,,Гоку, абай бол, ол көрінгеннен де артық...
Dialogue: 0,0:12:12.10,0:12:13.60,Default,,0,0,0,,Жанемба
Dialogue: 0,0:12:14.73,0:12:17.82,Default,,0,0,0,,Уау, мен бірінші рет осындай күшті болып тұрмын.
Dialogue: 0,0:12:17.94,0:12:21.32,Default,,0,0,0,,Пайкухан, финалға өткеніңе қуаныштымын.
Dialogue: 0,0:12:21.44,0:12:23.36,Default,,0,0,0,,Біреумен қарым-қатынас жасау
Dialogue: 0,0:12:23.49,0:12:26.37,Default,,0,0,0,,Сол уақытта сіз Энманың ағасына көмектестіңіз.
Dialogue: 0,0:12:26.49,0:12:30.04,Default,,0,0,0,,Гоку, өзіңді жақсы сезінуге тырыссаң да, ол нәтиже бермейді.
Dialogue: 0,0:12:30.16,0:12:32.04,Default,,0,0,0,,Джанемба Джанемба Джанемба
Dialogue: 0,0:12:32.16,0:12:33.46,Default,,0,0,0,,Ора?
Dialogue: 0,0:12:33.58,0:12:37.67,Default,,0,0,0,,Ол Оламен күресуде керемет. Ол туралы жаман сезінбе. Жақсы.
Dialogue: 0,0:12:39.71,0:12:40.84,Default,,0,0,0,,Тез шығарыңызшы.
Dialogue: 0,0:12:40.96,0:12:43.26,Default,,0,0,0,,А, мен Энманың ағасын ұмытып кетіппін Ах...
Dialogue: 0,0:12:43.38,0:12:44.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:44.93,0:12:47.85,Default,,0,0,0,,Мен бұл жігітті осы жерден алып кетемін.
Dialogue: 0,0:12:47.97,0:12:50.35,Default,,0,0,0,,Осы уақытта бөгетті алып тастаңыз.
Dialogue: 0,0:12:50.47,0:12:51.31,Default,,0,0,0,,Тексеру...
Dialogue: 0,0:12:53.93,0:12:56.77,Default,,0,0,0,,Уа... Иә.
Dialogue: 0,0:12:56.90,0:12:58.11,Default,,0,0,0,,О…
Dialogue: 0,0:13:02.94,0:13:07.03,Default,,0,0,0,,Они-сан, бұл жерде қолдың дыбысы шығады.
Dialogue: 0,0:13:07.82,0:13:10.83,Default,,0,0,0,,Гера Гера Гера Гера…
Dialogue: 0,0:13:13.95,0:13:16.29,Default,,0,0,0,,Осылай, менің артымнан жүр.
Dialogue: 0,0:13:26.38,0:13:29.85,Default,,0,0,0,,Әй, тозақ та қатты өзгерді.
Dialogue: 0,0:13:30.35,0:13:34.23,Default,,0,0,0,,Ааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:13:34.35,0:13:37.48,Default,,0,0,0,,Хаха... Қызық жігіт екен, а?
Dialogue: 0,0:13:39.40,0:13:40.56,Default,,0,0,0,,Жанемба
Dialogue: 0,0:13:44.57,0:13:45.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:46.95,0:13:48.03,Default,,0,0,0,,Джанемба Джанемба…
Dialogue: 0,0:13:48.16,0:13:49.24,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:13:49.37,0:13:55.75,Default,,0,0,0,,Джанемба Джанемба…
Dialogue: 0,0:13:55.87,0:14:01.42,Default,,0,0,0,,Хахаха... Бұл ақымақтық, бірақ сіз керемет нәрсе жасай алдыңыз.
Dialogue: 0,0:14:01.54,0:14:06.05,Default,,0,0,0,,Джанемба Джанемба…
Dialogue: 0,0:14:07.09,0:14:08.55,Default,,0,0,0,,Жанемба
Dialogue: 0,0:14:13.39,0:14:16.98,Default,,0,0,0,,Жанемба Жанемба Жанемба Жанемба Жанемба Жанемба Джанемба Жанемба Жанемба Жанемба
Dialogue: 0,0:14:17.10,0:14:18.89,Default,,0,0,0,,Аля!
Dialogue: 0,0:14:21.65,0:14:24.94,Default,,0,0,0,,Джанемба Джанемба…
Dialogue: 0,0:14:25.07,0:14:26.82,Default,,0,0,0,,Жанемба
Dialogue: 0,0:14:26.94,0:14:28.15,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:14:33.70,0:14:35.79,Default,,0,0,0,,Қазіргі соққың мүлде уақытынан тыс, аянышты болды!
Dialogue: 0,0:14:36.87,0:14:37.87,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:14:43.42,0:14:46.01,Default,,0,0,0,,Гохан-кун, қызық, не болып жатыр?
Dialogue: 0,0:14:46.13,0:14:49.80,Default,,0,0,0,,Кел... Иә, бірақ қандай елес көрінсе де...
Dialogue: 0,0:14:49.93,0:14:52.14,Default,,0,0,0,,Мен және Видель-сан осында болғанша, бәрі жақсы болады.
Dialogue: 0,0:14:52.26,0:14:53.55,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:14:53.68,0:14:56.64,Default,,0,0,0,,Сызбаға қосылмаңдар, екеуің.
Dialogue: 0,0:15:02.86,0:15:05.07,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:15:07.15,0:15:08.03,Default,,0,0,0,,Фриза
Dialogue: 0,0:15:08.15,0:15:10.53,Default,,0,0,0,,Ей, бұл құрмет.
Dialogue: 0,0:15:10.65,0:15:13.87,Default,,0,0,0,,Менің атымды білетініңді де білмеймін.
Dialogue: 0,0:15:13.99,0:15:18.50,Default,,0,0,0,,Мен оны бала кезімде ғана кездестірдім, сондықтан оны есіме түсірмесем, жарайды деп ойлаймын.
Dialogue: 0,0:15:18.62,0:15:20.12,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:15:20.66,0:15:23.33,Default,,0,0,0,,Уф... сен Сон Гокусың
Dialogue: 0,0:15:23.46,0:15:26.38,Default,,0,0,0,,Иә, бұл Сон Гохан.
Dialogue: 0,0:15:28.96,0:15:34.01,Default,,0,0,0,,Мен зұлым ұлы Гоханды ешқашан кешірмеймін
Dialogue: 0,0:15:34.14,0:15:37.26,Default,,0,0,0,,Гохан-кун, сен кереметсің.
Dialogue: 0,0:15:37.39,0:15:40.18,Default,,0,0,0,,Ата-ананың себеп-салдары балаларды марапаттайды.
Dialogue: 0,0:15:40.31,0:15:42.85,Default,,0,0,0,,Саған көп нәрсе берейік.
Dialogue: 0,0:15:42.98,0:15:44.06,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:15:44.19,0:15:45.90,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:15:46.98,0:15:49.78,Default,,0,0,0,,Олар зардап шексін
Dialogue: 0,0:15:51.90,0:15:52.70,Default,,0,0,0,,Ол, бәлкім, бір әйелмен көңіл көтеріп жүрген шығар, иә?
Dialogue: 0,0:15:56.62,0:15:59.45,Default,,0,0,0,,Ой!
Dialogue: 0,0:16:05.54,0:16:08.59,Default,,0,0,0,,Уау...
Dialogue: 0,0:16:12.30,0:16:14.59,Default,,0,0,0,,Ах, сен күткендей, Гохан-кун.
Dialogue: 0,0:16:15.26,0:16:18.10,Default,,0,0,0,,Хе хе хе...
Dialogue: 0,0:16:18.93,0:16:20.39,Default,,0,0,0,,Фуфуфу…
Dialogue: 0,0:16:23.94,0:16:27.31,Default,,0,0,0,,Тойййййййййййййййййййй!
Dialogue: 0,0:16:28.57,0:16:30.28,Default,,0,0,0,,Бұл дүниеде әділдіктің батыры
Dialogue: 0,0:16:30.40,0:16:34.82,Default,,0,0,0,,Шайтан мырза бар болғанша, мен сізге ұнайтын нәрсені істеуге ешқашан рұқсат бермеймін.
Dialogue: 0,0:16:35.57,0:16:38.45,Default,,0,0,0,,БАҚ келмей ме? Сұхбатқа не болды?
Dialogue: 0,0:16:38.58,0:16:40.70,Default,,0,0,0,,Әділдіктің батыры Шайтан мырза...
Dialogue: 0,0:16:40.83,0:16:43.08,Default,,0,0,0,,Мен зұлымдықты жазалаймын, қарғыс атсын!
Dialogue: 0,0:16:43.21,0:16:44.75,Default,,0,0,0,,Кя кя кя…
Dialogue: 0,0:16:45.37,0:16:46.83,Default,,0,0,0,,Тея!
Dialogue: 0,0:16:47.38,0:16:50.84,Default,,0,0,0,,Сізге кейінірек хабарласып, хабарлаудан басқа амалым жоқ.
Dialogue: 0,0:16:52.17,0:16:56.18,Default,,0,0,0,,Ахх...
Dialogue: 0,0:16:56.30,0:17:00.81,Default,,0,0,0,,(радар дыбысы)
Dialogue: 0,0:17:00.93,0:17:02.56,Default,,0,0,0,,Төрт жұлдызды допқа қара (Сушинчу)
Dialogue: 0,0:17:02.73,0:17:07.19,Default,,0,0,0,,Увахахаха... Ия, ия, ия
Dialogue: 0,0:17:08.06,0:17:11.94,Default,,0,0,0,,Қараңдаршы, бұл төрт жұлдызды доп. Кеттік, Готен.
Dialogue: 0,0:17:12.07,0:17:16.32,Default,,0,0,0,,Хаха, енді сізде барлық 7 бөлік бар хаха...
Dialogue: 0,0:17:17.82,0:17:20.24,Default,,0,0,0,,Уау, солай...
Dialogue: 0,0:17:20.37,0:17:25.75,Default,,0,0,0,,Ауырды, ауырады, ауырады, ой, ой...
Dialogue: 0,0:17:25.87,0:17:28.00,Default,,0,0,0,,Готен, асығыңыз.
Dialogue: 0,0:17:28.13,0:17:32.21,Default,,0,0,0,,Күте тұрыңыз, жасырыңыз. Хе хе...
Dialogue: 0,0:17:32.96,0:17:34.76,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:17:34.88,0:17:36.84,Default,,0,0,0,,Бұл менің бірінші тесігім.
Dialogue: 0,0:17:36.97,0:17:39.18,Default,,0,0,0,,Жоқ, менде сақтандыру бар екеніне қуаныштымын.
Dialogue: 0,0:17:45.43,0:17:48.73,Default,,0,0,0,,Жүр, Гохан-кун, Шенронды шақыр.
Dialogue: 0,0:17:56.65,0:17:59.70,Default,,0,0,0,,Кел, Шенрон
Dialogue: 0,0:18:15.09,0:18:16.38,Default,,0,0,0,,Ах…
Dialogue: 0,0:18:18.09,0:18:19.05,Default,,0,0,0,,Ах…
Dialogue: 0,0:18:35.53,0:18:36.86,Default,,0,0,0,,Шенрон
Dialogue: 0,0:18:37.57,0:18:38.36,Default,,0,0,0,,Фу…
Dialogue: 0,0:18:39.07,0:18:40.95,Default,,0,0,0,,Бұл Шенрон
Dialogue: 0,0:18:45.49,0:18:49.58,Default,,0,0,0,,Кез келген үш тілекті орындаймын
Dialogue: 0,0:18:49.71,0:18:51.46,Default,,0,0,0,,Тілек айту
Dialogue: 0,0:18:52.79,0:18:56.80,Default,,0,0,0,,Шенрон! Қазір жер бетінде өлген адамдар қайта тірілуде.
Dialogue: 0,0:18:56.92,0:19:01.93,Default,,0,0,0,,Бұл үлкен тәртіпсіздік. Маған қалыпты жағдайға оралуға көмектесіңіз.
Dialogue: 0,0:19:02.05,0:19:04.10,Default,,0,0,0,,(Деку) Иә. (Яо) Жарайды.
Dialogue: 0,0:19:04.22,0:19:07.56,Default,,0,0,0,,Иә! (күлкі)
Dialogue: 0,0:19:12.06,0:19:17.15,Default,,0,0,0,,Жоқ, менің қазіргі тілегім орындала алмайды.
Dialogue: 0,0:19:17.28,0:19:18.74,Default,,0,0,0,,(Ирис) Анашым, әкешім! Ағам мен апам да!
Dialogue: 0,0:19:18.86,0:19:20.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:20.86,0:19:23.32,Default,,0,0,0,,Шенронның сараңдығы!
Dialogue: 0,0:19:24.87,0:19:30.37,Default,,0,0,0,,Өлгендердің тағдыры толығымен Энма патшаның қолында.
Dialogue: 0,0:19:30.50,0:19:35.42,Default,,0,0,0,,Бұл менің мүмкіндігімнен асып түсетін мәселе.
Dialogue: 0,0:19:37.55,0:19:39.42,Default,,0,0,0,,Не істеу керек? Гохан-кун
Dialogue: 0,0:19:41.84,0:19:43.80,Default,,0,0,0,,Басқа сұрау жоқ па?
Dialogue: 0,0:19:46.93,0:19:47.81,Default,,0,0,0,,Иә.
Dialogue: 0,0:19:53.27,0:19:57.61,Default,,0,0,0,,А-а... у... Тілегің жоқ шығар.
Dialogue: 0,0:19:58.82,0:20:00.15,Default,,0,0,0,,Тах!
Dialogue: 0,0:20:12.96,0:20:16.08,Default,,0,0,0,,Қарғыс атсын... Супер энергетикалық оқтар жұмыс істемейді.
Dialogue: 0,0:20:16.21,0:20:18.63,Default,,0,0,0,,Бұл ақымақ тосқауыл
Dialogue: 0,0:20:21.88,0:20:22.97,Default,,0,0,0,,Әй?
Dialogue: 0,0:20:27.18,0:20:32.64,Default,,0,0,0,,Мен ол туралы жаман сөз айтсам, ол құлап қалатын. Иә, бұл менің ұстанымым емес, бірақ...
Dialogue: 0,0:20:32.77,0:20:38.44,Default,,0,0,0,,Идиот, Отаку Карахенки
Dialogue: 0,0:20:38.57,0:20:42.57,Default,,0,0,0,,Уф... Осы тосқауылды қоздыратын тағы бір сөз бар ма?
Dialogue: 0,0:20:50.45,0:20:52.16,Default,,0,0,0,,Жанемба
Dialogue: 0,0:20:53.96,0:20:54.75,Default,,0,0,0,,О
Dialogue: 0,0:20:58.54,0:20:59.25,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:21:09.64,0:21:10.81,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:21:10.93,0:21:12.18,Default,,0,0,0,,Жанемба
Dialogue: 0,0:21:12.68,0:21:13.60,Default,,0,0,0,,Хмф!
Dialogue: 0,0:21:22.65,0:21:23.90,Default,,0,0,0,,Уу!
Dialogue: 0,0:21:24.03,0:21:27.74,Default,,0,0,0,,Жанемба Джанемба Джанемба Джанемба...
Dialogue: 0,0:21:30.24,0:21:32.54,Default,,0,0,0,,Жанемба Джанемба Джанемба...
Dialogue: 0,0:21:33.66,0:21:34.71,Default,,0,0,0,,Уау...
Dialogue: 0,0:21:38.08,0:21:39.29,Default,,0,0,0,,Уау...
Dialogue: 0,0:21:45.01,0:21:48.76,Default,,0,0,0,,Уау Уау Уау
Dialogue: 0,0:21:54.10,0:21:55.77,Default,,0,0,0,,Мен неге екенін түсінбеймін...
Dialogue: 0,0:21:55.89,0:21:58.77,Default,,0,0,0,,Бұл жігіт менің қимылымнан мүлде бейхабар сияқты.
Dialogue: 0,0:21:58.90,0:22:01.82,Default,,0,0,0,,Қарғыс атсын... Мықты бол, мына жігіт.
Dialogue: 0,0:22:02.32,0:22:04.11,Default,,0,0,0,,Жанемба!
Dialogue: 0,0:22:04.23,0:22:06.45,Default,,0,0,0,,Әй... Уау!
Dialogue: 0,0:22:14.04,0:22:17.62,Default,,0,0,0,,Камехамеха!
Dialogue: 0,0:22:24.46,0:22:25.84,Default,,0,0,0,,Уау...
Dialogue: 0,0:22:36.31,0:22:38.35,Default,,0,0,0,,Сіз сиқыршысыз ба?
Dialogue: 0,0:22:40.31,0:22:42.15,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:22:42.27,0:22:44.40,Default,,0,0,0,,Акт…
Dialogue: 0,0:22:44.52,0:22:47.90,Default,,0,0,0,,Мен ол жігітке ештеңе істей алмаймын. Мен оның басын бірден беремін.
Dialogue: 0,0:22:48.03,0:22:50.53,Default,,0,0,0,,Ха!
Dialogue: 0,0:22:51.91,0:22:53.70,Default,,0,0,0,,Жанемба
Dialogue: 0,0:22:54.74,0:22:55.83,Default,,0,0,0,,О…
Dialogue: 0,0:22:58.83,0:23:01.42,Default,,0,0,0,,Ой... ой!
Dialogue: 0,0:23:07.84,0:23:08.72,Default,,0,0,0,,О…
Dialogue: 0,0:23:19.06,0:23:23.86,Default,,0,0,0,,Ахондара!
Dialogue: 0,0:23:23.98,0:23:26.32,Default,,0,0,0,,Хаха...
Dialogue: 0,0:23:27.65,0:23:30.65,Default,,0,0,0,,Қарғыс атсын... Гоку мұны керемет жасайды.
Dialogue: 0,0:23:31.24,0:23:36.66,Default,,0,0,0,,Уау!
Dialogue: 0,0:23:36.79,0:23:41.67,Default,,0,0,0,,Уау!
Dialogue: 0,0:23:41.79,0:23:46.00,Default,,0,0,0,,Уау!
Dialogue: 0,0:23:46.13,0:23:47.50,Default,,0,0,0,,Ах…
Dialogue: 0,0:23:48.05,0:23:50.22,Default,,0,0,0,,Уау!
Dialogue: 0,0:23:58.89,0:24:05.02,Default,,0,0,0,,Уау!
Dialogue: 0,0:24:05.15,0:24:09.53,Default,,0,0,0,,Уау!
Dialogue: 0,0:24:12.03,0:24:15.28,Default,,0,0,0,,Гоку-чан, сенің көздерің қатты толқыған сияқты.
Dialogue: 0,0:24:16.37,0:24:22.58,Default,,0,0,0,,Уау!
Dialogue: 0,0:24:27.13,0:24:31.51,Default,,0,0,0,,Сіз Оланы осы уақытқа дейін жіберген Маджин Буудан кейінгі екінші адамсыз.
Dialogue: 0,0:24:35.22,0:24:37.18,Default,,0,0,0,,Джанемба Джанемба Джанемба
Dialogue: 0,0:24:37.30,0:24:39.81,Default,,0,0,0,,Шайқас қазір басталады
Dialogue: 0,0:24:43.81,0:24:44.94,Default,,0,0,0,,Ах! Джанемба
Dialogue: 0,0:24:45.65,0:24:46.61,Default,,0,0,0,,Уау!
Dialogue: 0,0:24:48.27,0:24:54.74,Default,,0,0,0,,Атататататататат…
Dialogue: 0,0:25:09.46,0:25:10.84,Default,,0,0,0,,Аля!
Dialogue: 0,0:25:17.22,0:25:19.26,Default,,0,0,0,,Ха!
Dialogue: 0,0:25:23.52,0:25:24.23,Default,,0,0,0,,О…
Dialogue: 0,0:25:24.35,0:25:25.64,Default,,0,0,0,,Аля!
Dialogue: 0,0:25:30.77,0:25:33.15,Default,,0,0,0,,қаңтар!
Dialogue: 0,0:25:34.90,0:25:40.49,Default,,0,0,0,,қаңтар!
Dialogue: 0,0:25:41.62,0:25:44.33,Default,,0,0,0,,Жанемба…
Dialogue: 0,0:25:45.33,0:25:47.50,Default,,0,0,0,,Уф... Ия!
Dialogue: 0,0:25:49.13,0:25:50.04,Default,,0,0,0,,Ол, бәлкім, бір әйелмен көңіл көтеріп жүрген шығар, иә?
Dialogue: 0,0:25:51.50,0:25:53.00,Default,,0,0,0,,Уф…
Dialogue: 0,0:26:20.32,0:26:22.58,Default,,0,0,0,,Қандай жігіт
Dialogue: 0,0:26:30.08,0:26:32.96,Default,,0,0,0,,Хахахаха дүние менікі
Dialogue: 0,0:26:37.26,0:26:38.01,Default,,0,0,0,,Тоқта
Dialogue: 0,0:26:38.13,0:26:40.14,Default,,0,0,0,,Қандай ақымақтық жасадың?
Dialogue: 0,0:26:42.47,0:26:43.22,Default,,0,0,0,,Әрине, оны есінен тандырып тастаған дұрыс қой?
Dialogue: 0,0:26:47.52,0:26:50.90,Default,,0,0,0,,Hit Goten Dodge Dodge соққысы
Dialogue: 0,0:26:51.02,0:26:53.61,Default,,0,0,0,,Алға, ат!
Dialogue: 0,0:26:55.57,0:26:58.49,Default,,0,0,0,,Уау, бұл қорқынышты. Мен зәр шығаратын сияқтымын.
Dialogue: 0,0:26:58.61,0:27:00.99,Default,,0,0,0,,Алға, ат!
Dialogue: 0,0:27:01.11,0:27:03.83,Default,,0,0,0,,Ой, мен жүгіріп бара жатырмын.
Dialogue: 0,0:27:10.29,0:27:12.08,Default,,0,0,0,,Ой!
Dialogue: 0,0:27:12.21,0:27:15.38,Default,,0,0,0,,Көтерілісшілерді өлтір, өлтір, өлтір.
Dialogue: 0,0:27:15.50,0:27:18.92,Default,,0,0,0,,Готен, сенің бізге қарсылас болғаныңа 100 жыл болды.
Dialogue: 0,0:27:19.05,0:27:20.09,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:27:20.22,0:27:23.72,Default,,0,0,0,,Готен, Супер Сайянға айналып, оған кішкене тосын сый жасайық.
Dialogue: 0,0:27:30.02,0:27:35.40,Default,,0,0,0,,А... Шашын бояғаны үшін кәмелетке толмаған қылмыскер ме?
Dialogue: 0,0:27:39.94,0:27:42.32,Default,,0,0,0,,Уаааааааа!
Dialogue: 0,0:27:45.74,0:27:46.70,Default,,0,0,0,,Уау!
Dialogue: 0,0:27:51.04,0:27:52.12,Default,,0,0,0,,Аля!
Dialogue: 0,0:27:53.04,0:27:54.54,Default,,0,0,0,,Уау! Уф!
Dialogue: 0,0:27:55.75,0:27:57.21,Default,,0,0,0,,Бұзылу…
Dialogue: 0,0:28:01.80,0:28:04.18,Default,,0,0,0,,Уау!
Dialogue: 0,0:28:09.14,0:28:10.18,Default,,0,0,0,,Уау!
Dialogue: 0,0:28:12.94,0:28:14.23,Default,,0,0,0,,Аля!
Dialogue: 0,0:28:18.90,0:28:20.44,Default,,0,0,0,,Бұзылу…
Dialogue: 0,0:28:32.66,0:28:35.21,Default,,0,0,0,,Гоку араласты!
Dialogue: 0,0:28:40.09,0:28:44.38,Default,,0,0,0,,Неліктен мына Пайкухан-сама мұндай нәрсені жасай алмайды?
Dialogue: 0,0:28:44.51,0:28:46.68,Default,,0,0,0,,Гокудың Ахондарасы!
Dialogue: 0,0:29:13.58,0:29:15.33,Default,,0,0,0,,Ннн!
Dialogue: 0,0:29:15.46,0:29:16.33,Default,,0,0,0,,Уау...
Dialogue: 0,0:29:23.97,0:29:25.43,Default,,0,0,0,,Уф Аля!
Dialogue: 0,0:29:34.39,0:29:35.60,Default,,0,0,0,,Шетелге, қалағанымша кез келген жерге бара алар едім—
Dialogue: 0,0:29:39.98,0:29:40.86,Default,,0,0,0,,Уау...
Dialogue: 0,0:29:51.87,0:29:53.33,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:29:55.33,0:29:56.33,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:29:57.58,0:29:58.50,Default,,0,0,0,,Ах…
Dialogue: 0,0:30:05.17,0:30:10.01,Default,,0,0,0,,Уа, ау, ау...
Dialogue: 0,0:30:19.44,0:30:20.48,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:30:22.65,0:30:24.78,Default,,0,0,0,,Көкек...
Dialogue: 0,0:30:31.20,0:30:32.37,Default,,0,0,0,,Уау!
Dialogue: 0,0:30:42.92,0:30:44.13,Default,,0,0,0,,Көкек...
Dialogue: 0,0:30:55.10,0:30:57.73,Default,,0,0,0,,Уау!
Dialogue: 0,0:30:57.85,0:30:58.98,Default,,0,0,0,,Уау...
Dialogue: 0,0:31:00.73,0:31:01.86,Default,,0,0,0,,Ол, бәлкім, бір әйелмен көңіл көтеріп жүрген шығар, иә?
Dialogue: 0,0:31:11.95,0:31:13.91,Default,,0,0,0,,Қандай әзіл, Какарот.
Dialogue: 0,0:31:14.03,0:31:16.95,Default,,0,0,0,,Сені жеңетін мен екенімді ұмыттың ба?
Dialogue: 0,0:31:17.08,0:31:19.62,Default,,0,0,0,,Вегета Вегета, сен...
Dialogue: 0,0:31:19.75,0:31:21.17,Default,,0,0,0,,Себебі мені қызықтырмайды.
Dialogue: 0,0:31:21.29,0:31:24.96,Default,,0,0,0,,Менде тек жаным болған кезде, неге денем маған қайтып келгенін білмеймін.
Dialogue: 0,0:31:25.63,0:31:27.84,Default,,0,0,0,,Мен білмей тұрып, осында ұшып келе жатқан.
Dialogue: 0,0:31:27.96,0:31:32.55,Default,,0,0,0,,Ыя, Энманың ағасы қамауға алынғандықтан шығар.
Dialogue: 0,0:31:32.68,0:31:35.81,Default,,0,0,0,,Какарот Мен оны жеңемін.
Dialogue: 0,0:31:35.93,0:31:38.10,Default,,0,0,0,,Қараңызшы, араласудың қажеті жоқ.
Dialogue: 0,0:31:38.22,0:31:40.02,Default,,0,0,0,,Вегета (Вегета) табан…
Dialogue: 0,0:31:41.60,0:31:45.48,Default,,0,0,0,,Құбыжық, мен төбелескеніме көп болды.
Dialogue: 0,0:31:45.61,0:31:46.77,Default,,0,0,0,,Вегета, тоқтат.
Dialogue: 0,0:31:46.90,0:31:49.44,Default,,0,0,0,,Менің тозақта қанша азап шеккенімді білесің.
Dialogue: 0,0:31:49.57,0:31:51.15,Default,,0,0,0,,Сіз түсінбейсіз.
Dialogue: 0,0:31:51.28,0:31:54.37,Default,,0,0,0,,Сол азапты ойласам, мен бәріне төзе аламын.
Dialogue: 0,0:31:55.28,0:31:58.37,Default,,0,0,0,,Ах, аа...
Dialogue: 0,0:32:04.17,0:32:07.17,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:32:18.77,0:32:19.68,Default,,0,0,0,,Дея! Ах...
Dialogue: 0,0:32:21.73,0:32:22.81,Default,,0,0,0,,Ха!
Dialogue: 0,0:32:24.94,0:32:26.65,Default,,0,0,0,,Онда! О...
Dialogue: 0,0:32:26.77,0:32:29.65,Default,,0,0,0,,Дея! Ой...
Dialogue: 0,0:32:32.74,0:32:33.66,Default,,0,0,0,,Вегета
Dialogue: 0,0:32:33.78,0:32:35.24,Default,,0,0,0,,Уау...
Dialogue: 0,0:32:40.37,0:32:41.79,Default,,0,0,0,,Уаау...
Dialogue: 0,0:32:44.62,0:32:46.08,Default,,0,0,0,,Уау!
Dialogue: 0,0:32:52.34,0:32:53.51,Default,,0,0,0,,Уау...
Dialogue: 0,0:32:53.63,0:32:54.84,Default,,0,0,0,,Вегета
Dialogue: 0,0:33:07.98,0:33:13.61,Default,,0,0,0,,Ка... Какарот Бұл қажет емес. Сізден көмек сұрайын деген ойым жоқ.
Dialogue: 0,0:33:13.74,0:33:16.11,Default,,0,0,0,,Бұл қару.
Dialogue: 0,0:33:16.24,0:33:18.62,Default,,0,0,0,,Мен сондай күшті адамды бірінші рет көріп тұрмын.
Dialogue: 0,0:33:20.79,0:33:22.04,Default,,0,0,0,,Жауынгер дірілдеп тұр.
Dialogue: 0,0:33:24.16,0:33:26.58,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:33:29.17,0:33:32.26,Default,,0,0,0,,Екеуміз де жеңе алмасақ...
Dialogue: 0,0:33:35.43,0:33:39.01,Default,,0,0,0,,Жоқ, оны жеңудің бір жолы бар.
Dialogue: 0,0:33:39.14,0:33:40.89,Default,,0,0,0,,Кешіріңіз, кешіріңіз
Dialogue: 0,0:33:43.39,0:33:44.39,Default,,0,0,0,,Біріктіру
Dialogue: 0,0:33:44.98,0:33:47.85,Default,,0,0,0,,Біріктіру Сақтандырғыш үшін?
Dialogue: 0,0:33:47.98,0:33:51.86,Default,,0,0,0,,Иә, Ora-мен біріктіріңіз.
Dialogue: 0,0:33:52.61,0:33:54.94,Default,,0,0,0,,Сізбен? ақымақ
Dialogue: 0,0:33:55.07,0:33:57.45,Default,,0,0,0,,Сіз мұны істей аласыз ба?
Dialogue: 0,0:33:58.32,0:34:00.95,Default,,0,0,0,,Бұл оны жеңудің жалғыз жолы.
Dialogue: 0,0:34:01.08,0:34:05.20,Default,,0,0,0,,Оның қаншалықты күшті екенін түсінген болуыңыз керек.
Dialogue: 0,0:34:06.16,0:34:09.79,Default,,0,0,0,,Қарғыс атқыр... Мен сенімен араласқым келеді.
Dialogue: 0,0:34:10.42,0:34:11.71,Default,,0,0,0,,Мен өлімді таңдаймын
Dialogue: 0,0:34:12.50,0:34:17.51,Default,,0,0,0,,А, Вегета, сен өліп қалдың.
Dialogue: 0,0:34:18.97,0:34:21.55,Default,,0,0,0,,А... иә
Dialogue: 0,0:34:22.60,0:34:23.72,Default,,0,0,0,,Ах
Dialogue: 0,0:34:36.03,0:34:38.74,Default,,0,0,0,,Мен сенімен ешқашан қосыла алмаймын.
Dialogue: 0,0:34:41.41,0:34:42.74,Default,,0,0,0,,Waa… Вегета
Dialogue: 0,0:34:46.45,0:34:47.83,Default,,0,0,0,,О...
Dialogue: 0,0:35:00.05,0:35:02.35,Default,,0,0,0,,Вегета, мықты бол.
Dialogue: 0,0:35:02.47,0:35:03.93,Default,,0,0,0,,Укккк…
Dialogue: 0,0:35:08.06,0:35:11.35,Default,,0,0,0,,Кук кук... Тіпті о дүниеде де...
Dialogue: 0,0:35:11.48,0:35:14.94,Default,,0,0,0,,Әй... Мен Какароттан кеммін бе?
Dialogue: 0,0:35:15.07,0:35:18.99,Default,,0,0,0,,Кук кук даммит...
Dialogue: 0,0:35:19.11,0:35:20.66,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:35:20.78,0:35:26.04,Default,,0,0,0,,Ола ұзақ уақыт бойы өзінің физикалық пішінінде Гранд Каймен жаттығады.
Dialogue: 0,0:35:26.87,0:35:31.00,Default,,0,0,0,,Қазір жәй ғана жан боп кеткен сіз бен менің арамызда айырмашылық болуы заңдылық.
Dialogue: 0,0:35:31.75,0:35:35.50,Default,,0,0,0,,Қарғыс атсын... Маған жұбаныш керек емес.
Dialogue: 0,0:35:36.92,0:35:39.55,Default,,0,0,0,,Біріктіру мүмкін емес пе?
Dialogue: 0,0:35:39.67,0:35:43.55,Default,,0,0,0,,Сайяндардың мақтан тұтатын ханзадасысың.
Dialogue: 0,0:35:49.31,0:35:51.64,Default,,0,0,0,,Вегета Мен түсінемін.
Dialogue: 0,0:35:51.77,0:35:56.02,Default,,0,0,0,,Әйтеуір, осы жерден көшейік. Енді менің қолымнан ұста.
Dialogue: 0,0:35:56.98,0:35:59.86,Default,,0,0,0,,Вегета, тезірек, ол күтпейді.
Dialogue: 0,0:35:59.99,0:36:02.32,Default,,0,0,0,,Сонымен, біз ақыры Үндістанды кесіп өтеміз—
Dialogue: 0,0:36:04.41,0:36:05.99,Default,,0,0,0,,Вегета
Dialogue: 0,0:36:06.12,0:36:07.87,Default,,0,0,0,,Какарот
Dialogue: 0,0:36:08.37,0:36:11.75,Default,,0,0,0,,Какарот, менімен қосыл.
Dialogue: 0,0:36:16.29,0:36:21.17,Default,,0,0,0,,Ки... Саған рақым еткенім артық!
Dialogue: 0,0:36:29.22,0:36:31.06,Default,,0,0,0,,Вегета
Dialogue: 0,0:36:33.52,0:36:34.65,Default,,0,0,0,,Ол, бәлкім, бір әйелмен көңіл көтеріп жүрген шығар, иә?
Dialogue: 0,0:36:35.27,0:36:36.40,Default,,0,0,0,,Уау!
Dialogue: 0,0:36:38.40,0:36:39.69,Default,,0,0,0,,Уф! (Вегета) О...
Dialogue: 0,0:36:45.95,0:36:47.87,Default,,0,0,0,,Уау... Гоку
Dialogue: 0,0:37:06.22,0:37:08.47,Default,,0,0,0,,Гяаааааааааааааааааааааааааааааааааа...
Dialogue: 0,0:37:24.61,0:37:27.91,Default,,0,0,0,,Вегета Бізде көп уақыт жоқ, сондықтан мен сізге тез айтып беремін.
Dialogue: 0,0:37:29.66,0:37:33.75,Default,,0,0,0,,Екі адамның энергиясы бірдей болмаса, бұл әдіс мүмкін емес.
Dialogue: 0,0:37:34.62,0:37:37.08,Default,,0,0,0,,Осыдан кейін мәселе біріктіру позасы болып табылады.
Dialogue: 0,0:37:37.63,0:37:40.21,Default,,0,0,0,,Егер екі адам бірдей позаны алса...
Dialogue: 0,0:37:40.34,0:37:41.75,Default,,0,0,0,,Біріктіру аяқталды
Dialogue: 0,0:37:42.67,0:37:43.55,Default,,0,0,0,,Кідірту?
Dialogue: 0,0:37:44.59,0:37:46.76,Default,,0,0,0,,Енді мен сол позаны қолданып көрейін.
Dialogue: 0,0:37:46.88,0:37:48.55,Default,,0,0,0,,Жақсы есте сақта
Dialogue: 0,0:37:49.22,0:37:52.56,Default,,0,0,0,,Біріншіден, екі адам бір-бірінен белгілі арақашықтықпен қатар тұрады.
Dialogue: 0,0:37:52.68,0:37:54.02,Default,,0,0,0,,Осыны орындаңыз
Dialogue: 0,0:37:54.89,0:37:57.27,Default,,0,0,0,,Қолдың бұрышына мұқият болу керек.
Dialogue: 0,0:37:57.40,0:38:00.11,Default,,0,0,0,,Фу…
Dialogue: 0,0:38:00.23,0:38:05.28,Default,,0,0,0,,Екі адам қолдарын бір-біріне қарама-қарсы қойып бір-біріне жақындағанда, олар аяқтарын үш қадамға жылжытады.
Dialogue: 0,0:38:06.45,0:38:07.24,Default,,0,0,0,,Джон!
Dialogue: 0,0:38:08.70,0:38:12.41,Default,,0,0,0,,Аяғыңыздың бұрышынан сақ болыңыз Ха!
Dialogue: 0,0:38:12.54,0:38:16.96,Default,,0,0,0,,Осылайша біз саусақтарымызды біріктіреміз, қайтадан аяғымыздың бұрышына мұқият боламыз.
Dialogue: 0,0:38:17.08,0:38:19.58,Default,,0,0,0,,Әсіресе сол аяғыңызды созуды ұмытпаңыз.
Dialogue: 0,0:38:19.71,0:38:22.04,Default,,0,0,0,,Мен осылай киінемін бе?
Dialogue: 0,0:38:22.67,0:38:26.09,Default,,0,0,0,,Бұл поза симметриялы ма, түсіндің бе?
Dialogue: 0,0:38:26.22,0:38:27.26,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:38:27.68,0:38:30.68,Default,,0,0,0,,Менің уақытым жоқ. Жүр, бір рет жаттығу жасайық.
Dialogue: 0,0:38:31.26,0:38:34.39,Default,,0,0,0,,Эй, Вегета, сен не үшін уайымдап тұрсың?
Dialogue: 0,0:38:34.52,0:38:37.56,Default,,0,0,0,,Немесе қазіргі түсініктемені түсінбесем дұрыс па?
Dialogue: 0,0:38:42.32,0:38:45.32,Default,,0,0,0,,Гигагага...
Dialogue: 0,0:38:45.44,0:38:48.53,Default,,0,0,0,,Гигагага...
Dialogue: 0,0:38:53.45,0:38:55.75,Default,,0,0,0,,Ха ха ха...
Dialogue: 0,0:38:56.33,0:39:00.71,Default,,0,0,0,,Пайкухан Қараңызшы, сізде тағы бір дем бар. Жалқау болмаңыз және оны тез жасаңыз.
Dialogue: 0,0:39:00.83,0:39:06.88,Default,,0,0,0,,Қарғыс атсын... Энма қарғыс атқыр қарт!
Dialogue: 0,0:39:08.13,0:39:09.88,Default,,0,0,0,,Ат, ат!
Dialogue: 0,0:39:19.89,0:39:22.10,Default,,0,0,0,,Ұр, ұр
Dialogue: 0,0:39:27.19,0:39:28.65,Default,,0,0,0,,Сандықтар-кун
Dialogue: 0,0:39:28.78,0:39:32.70,Default,,0,0,0,,Готен Егер сізде ыңылдауға уақыт болса, мүмкіндігінше көпті жеңіңіз.
Dialogue: 0,0:39:32.82,0:39:34.78,Default,,0,0,0,,Бірақ шектеу жоқ.
Dialogue: 0,0:39:40.83,0:39:43.38,Default,,0,0,0,,Жарайды, енді біз бір беттеміз.
Dialogue: 0,0:39:44.17,0:39:45.38,Default,,0,0,0,,Кеттік, Вегета.
Dialogue: 0,0:39:47.46,0:39:51.22,Default,,0,0,0,,Fusion Ha!
Dialogue: 0,0:39:58.06,0:39:59.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:40:03.15,0:40:05.48,Default,,0,0,0,,Гррррр... Уф
Dialogue: 0,0:40:10.57,0:40:13.32,Default,,0,0,0,,Мен сені тозаққа жіберемін
Dialogue: 0,0:40:16.95,0:40:21.25,Default,,0,0,0,,А, сен сәтсіздікке ұшырадың, Гоку. Сіз сәтсіздікке ұшырадыңыз, Гогета.
Dialogue: 0,0:40:21.37,0:40:23.58,Default,,0,0,0,,Гоку қарсыласының қолы майлы болып қалды.
Dialogue: 0,0:40:23.71,0:40:26.59,Default,,0,0,0,,Бұл Гогета емес, Беку.
Dialogue: 0,0:40:26.71,0:40:28.09,Default,,0,0,0,,Бір оқта жойылып кетпей ме?
Dialogue: 0,0:40:28.21,0:40:30.67,Default,,0,0,0,,Бұл тамаша емес. Неге қайталап көрмеске?
Dialogue: 0,0:40:30.80,0:40:34.39,Default,,0,0,0,,Бұл 30 минуттан аспайтын сияқты. Біз тек жалғастыруымыз керек.
Dialogue: 0,0:40:35.22,0:40:36.85,Default,,0,0,0,,Гоку
Dialogue: 0,0:40:36.97,0:40:39.22,Default,,0,0,0,,Иә!
Dialogue: 0,0:40:55.36,0:40:58.53,Default,,0,0,0,,Біз көп нәрсені жасаймыз, бірақ бұл.
Dialogue: 0,0:40:58.66,0:41:01.45,Default,,0,0,0,,Бұл Гогета-сама мәселені шешеді.
Dialogue: 0,0:41:17.14,0:41:18.51,Default,,0,0,0,,Уау! О...
Dialogue: 0,0:41:22.56,0:41:25.64,Default,,0,0,0,,Уф, ішім ауырып тұр...
Dialogue: 0,0:41:38.41,0:41:40.74,Default,,0,0,0,,Менің ойымша, бұл бата.
Dialogue: 0,0:41:40.87,0:41:45.16,Default,,0,0,0,,Джанемба қарсыласының техникасын көрсетуде шебер, өйткені оның қабілеттері әртүрлі.
Dialogue: 0,0:41:45.29,0:41:50.17,Default,,0,0,0,,Гогетаның қимылдарын оқи алмайтын сияқтымын. Ол 30 минутқа созылуы мүмкін.
Dialogue: 0,0:41:50.29,0:41:53.01,Default,,0,0,0,,Мен солай деп үміттенемін ...
Dialogue: 0,0:41:53.13,0:41:55.01,Default,,0,0,0,,Хо хо хо...
Dialogue: 0,0:42:01.10,0:42:04.23,Default,,0,0,0,,Не дейсің, мен аяқтаймын.
Dialogue: 0,0:42:07.06,0:42:08.02,Default,,0,0,0,,Уау...
Dialogue: 0,0:42:08.15,0:42:10.02,Default,,0,0,0,,Бұл туралы алаңдамаңыз.
Dialogue: 0,0:42:11.77,0:42:13.53,Default,,0,0,0,,Осы уақытқа дейін бұл жай ғана репетиция.
Dialogue: 0,0:42:13.65,0:42:16.15,Default,,0,0,0,,Жақында біз нақты нәрсені бастаймыз.
Dialogue: 0,0:42:16.28,0:42:17.95,Default,,0,0,0,,Уф…
Dialogue: 0,0:42:21.87,0:42:22.95,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:42:23.08,0:42:25.45,Default,,0,0,0,,Әлі 30 минут емес пе?
Dialogue: 0,0:42:25.58,0:42:26.96,Default,,0,0,0,,Бар болғаны 10 минут қалды.
Dialogue: 0,0:42:27.54,0:42:29.08,Default,,0,0,0,,Уау...
Dialogue: 0,0:42:33.30,0:42:34.76,Default,,0,0,0,,Уау...
Dialogue: 0,0:42:36.76,0:42:39.80,Default,,0,0,0,,Ей, сен, мен сені бүгін ғана сағынамын.
Dialogue: 0,0:42:39.93,0:42:42.18,Default,,0,0,0,,Қайта жамандық жасама.
Dialogue: 0,0:42:42.93,0:42:45.14,Default,,0,0,0,,Ннннннн...
Dialogue: 0,0:42:45.27,0:42:46.81,Default,,0,0,0,,(шу)
Dialogue: 0,0:42:49.44,0:42:51.81,Default,,0,0,0,,Ат, ат, ат!
Dialogue: 0,0:43:03.66,0:43:04.41,Default,,0,0,0,,Хмм...
Dialogue: 0,0:43:06.20,0:43:06.87,Default,,0,0,0,,Уф…
Dialogue: 0,0:43:09.50,0:43:10.17,Default,,0,0,0,,Хмф!
Dialogue: 0,0:43:12.54,0:43:13.88,Default,,0,0,0,,Ахх...
Dialogue: 0,0:43:16.30,0:43:17.84,Default,,0,0,0,,Вегета Енді, о...
Dialogue: 0,0:43:18.76,0:43:19.84,Default,,0,0,0,,Тея!
Dialogue: 0,0:43:24.56,0:43:25.43,Default,,0,0,0,,Уф…
Dialogue: 0,0:43:30.98,0:43:33.86,Default,,0,0,0,,Какарот Біріктіру дегеніміз не? Әлсіз сияқты, солай емес пе?
Dialogue: 0,0:43:33.98,0:43:35.02,Default,,0,0,0,,Мені алдадың ба?
Dialogue: 0,0:43:35.15,0:43:36.78,Default,,0,0,0,,Мен осылай дедім
Dialogue: 0,0:43:36.90,0:43:38.74,Default,,0,0,0,,Осылай жеңсең, қиналмайсың.
Dialogue: 0,0:43:38.86,0:43:42.82,Default,,0,0,0,,Гоку: Вегетаның қолдары басқа пішінде болды.
Dialogue: 0,0:43:42.95,0:43:45.12,Default,,0,0,0,,Түсіндім, Вегета дұрыс емес.
Dialogue: 0,0:43:45.24,0:43:47.91,Default,,0,0,0,,Міне! Мен сенің айтқаныңды орындадым.
Dialogue: 0,0:43:49.00,0:43:52.50,Default,,0,0,0,,Вегета Соңында, сұқ саусағыңызды саусағыңызбен созыңыз.
Dialogue: 0,0:43:52.63,0:43:55.42,Default,,0,0,0,,Тағы да осындай жиіркенішті іс жасайсың ба?
Dialogue: 0,0:43:55.54,0:43:56.71,Default,,0,0,0,,Әрине
Dialogue: 0,0:43:56.84,0:43:59.55,Default,,0,0,0,,Бұл оны жеңудің жалғыз жолы. Барайық.
Dialogue: 0,0:43:59.67,0:44:00.97,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:44:01.09,0:44:04.01,Default,,0,0,0,,Fusion Ah
Dialogue: 0,0:44:15.61,0:44:19.36,Default,,0,0,0,,Гоку, мұны маған қалдыр. Тез қосылайық.
Dialogue: 0,0:44:19.49,0:44:24.11,Default,,0,0,0,,Пайкухан өтінемін, Вегета кеттік.
Dialogue: 0,0:44:31.71,0:44:34.46,Default,,0,0,0,,Менің сізге арнаған ерекше қадамым бар.
Dialogue: 0,0:44:34.54,0:44:36.38,Default,,0,0,0,,Мен сізге бұл тармақтан ары өтуге жол бермеймін.
Dialogue: 0,0:44:38.42,0:44:39.59,Default,,0,0,0,,Гагги!
Dialogue: 0,0:44:39.71,0:44:41.26,Default,,0,0,0,,Бұл сәтсіздік!
Dialogue: 0,0:44:45.64,0:44:46.60,Default,,0,0,0,,Тах!
Dialogue: 0,0:44:46.72,0:44:50.31,Default,,0,0,0,,Біріктіру
Dialogue: 0,0:44:51.06,0:44:52.39,Default,,0,0,0,,Ах…
Dialogue: 0,0:44:52.52,0:44:53.64,Default,,0,0,0,,Ха!
Dialogue: 0,0:44:54.44,0:44:55.77,Default,,0,0,0,,Уау...
Dialogue: 0,0:44:59.78,0:45:00.82,Default,,0,0,0,,Ах…
Dialogue: 0,0:45:13.04,0:45:16.17,Default,,0,0,0,,Мен жасадым...
Dialogue: 0,0:45:18.88,0:45:21.38,Default,,0,0,0,,Бұл рух менің әкем.
Dialogue: 0,0:45:21.51,0:45:23.09,Default,,0,0,0,,Бұл әке
Dialogue: 0,0:45:23.80,0:45:26.97,Default,,0,0,0,,Ха Fusion Ha!
Dialogue: 0,0:45:36.10,0:45:39.19,Default,,0,0,0,,Пайкухан жауды алып кетемін.
Dialogue: 0,0:45:43.78,0:45:46.61,Default,,0,0,0,,Гагагага…
Dialogue: 0,0:45:47.70,0:45:52.49,Default,,0,0,0,,Мен Гоку немесе Вегета емеспін, сені жеңетін менмін.
Dialogue: 0,0:45:54.20,0:45:55.00,Default,,0,0,0,,Ха…
Dialogue: 0,0:46:18.40,0:46:19.23,Default,,0,0,0,,Ах…
Dialogue: 0,0:46:28.91,0:46:30.78,Default,,0,0,0,,Уау! (Гогета) Әй!
Dialogue: 0,0:46:31.91,0:46:32.74,Default,,0,0,0,,Ахх...
Dialogue: 0,0:46:45.63,0:46:50.22,Default,,0,0,0,,Аххххх...
Dialogue: 0,0:46:58.77,0:46:59.77,Default,,0,0,0,,Ах
Dialogue: 0,0:47:02.90,0:47:06.74,Default,,0,0,0,,Уаааааааааааа...
Dialogue: 0,0:47:09.40,0:47:10.53,Default,,0,0,0,,Фу…
Dialogue: 0,0:47:13.33,0:47:15.83,Default,,0,0,0,,Super Ghost Камикадзе шабуылы
Dialogue: 0,0:47:15.95,0:47:20.17,Default,,0,0,0,,Ghost 100 адам бірден сапқа тұрады
Dialogue: 0,0:47:21.58,0:47:22.83,Default,,0,0,0,,Майор аман-есен!
Dialogue: 0,0:47:24.71,0:47:25.63,Default,,0,0,0,,Ах…
Dialogue: 0,0:47:35.01,0:47:36.81,Default,,0,0,0,,Бұл қандай зат?
Dialogue: 0,0:47:45.82,0:47:48.11,Default,,0,0,0,,Ия... Вегета
Dialogue: 0,0:47:48.24,0:47:51.61,Default,,0,0,0,,Мен енді ешқашан Kakarot Fusion жасамаймын.
Dialogue: 0,0:47:51.74,0:47:55.12,Default,,0,0,0,,Ха... Вегета, тағы кездескенше.
Dialogue: 0,0:48:09.84,0:48:14.43,Default,,0,0,0,,Енді басқа дүниенің заңдарын қалпына келтірейік.
Dialogue: 0,0:48:22.56,0:48:24.81,Default,,0,0,0,,Бұл біртүрлі күн болды.
Dialogue: 0,0:48:24.94,0:48:26.27,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:48:26.40,0:48:27.69,Default,,0,0,0,,Гохан-ни-чан
Dialogue: 0,0:48:27.82,0:48:31.03,Default,,0,0,0,,Бұл дүрбелеңді кім тоқтатқанын білеміз.
Dialogue: 0,0:48:31.15,0:48:32.49,Default,,0,0,0,,Эй, Транкс-кун
Dialogue: 0,0:48:32.61,0:48:33.61,Default,,0,0,0,,О
Dialogue: 0,0:48:33.74,0:48:34.57,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:48:34.70,0:48:36.41,Default,,0,0,0,,Мен бұл құпия екеніне сенімдімін
Dialogue: 0,0:48:36.53,0:48:37.58,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:48:37.70,0:48:39.29,Default,,0,0,0,,Балалар сендер шынымен білесіңдер ме?
Dialogue: 0,0:48:39.41,0:48:40.54,Default,,0,0,0,,Әрине
Dialogue: 0,0:48:40.66,0:48:42.75,Default,,0,0,0,,Олай болса, маған айтсаң жақсы болмас па еді?
Dialogue: 0,0:48:42.87,0:48:43.79,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:48:43.92,0:48:46.96,Default,,0,0,0,,Екеуің күтіңдер.
Dialogue: 0,0:48:47.09,0:48:48.46,Default,,0,0,0,,барлығын бірге орналастырыңыз.
Dialogue: 0,0:48:48.59,0:48:49.76,Default,,0,0,0,,Мен күтпеймін
Dialogue: 0,0:48:49.88,0:48:53.76,Default,,0,0,0,,Құпия құпия Готен-чан (Гохан) Күте алсаң, екеуің де.
Dialogue: 0,0:48:53.88,0:48:57.10,Default,,0,0,0,,Гохан, күте тұрыңыз.
Dialogue: 0,0:48:57.60,0:49:00.77,Default,,0,0,0,,Менің әлі тілегім бар ма екен?
Dialogue: 0,0:49:00.89,0:49:06.90,Default,,0,0,0,,♪〜
Dialogue: 0,0:50:32.98,0:50:38.99,Default,,0,0,0,,〜♪
