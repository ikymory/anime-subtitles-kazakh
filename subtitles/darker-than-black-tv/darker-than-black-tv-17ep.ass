Dialogue: 0,0:24:07.50,0:24:09.50,Default,,0,0,0,,

Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.35,0:00:04.10,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:00:04.85,0:00:07.07,Default,,0,0,0,,Сериялық жарылыстар үшін жауапкершілікті өз мойнына алды.
Dialogue: 0,0:00:07.94,0:00:10.56,Default,,0,0,0,,Мердігердің бар екенін жария ету
Dialogue: 0,0:00:11.06,0:00:14.44,Default,,0,0,0,,Адам құқықтарын құрметтейтін балалар Өз құқықтарын кеңейтуге ұмтылу
Dialogue: 0,0:00:15.86,0:00:18.53,Default,,0,0,0,,Бұл шынымен де олардың мәлімдемесі ме?
Dialogue: 0,0:00:18.99,0:00:19.78,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:00:20.12,0:00:23.03,Default,,0,0,0,,Бірақ терроризмнің орын алғаны және
Dialogue: 0,0:00:23.24,0:00:27.08,Default,,0,0,0,,Өздерін «Вечерний примула» деп атайтын топтың бар екені даусыз.
Dialogue: 0,0:00:27.58,0:00:29.46,Default,,0,0,0,,Кешкі примула
Dialogue: 0,0:00:34.25,0:00:39.18,Default,,0,0,0,,Бүйірдегі BK-201 олармен қандай да бір қарым-қатынаста ма?
Dialogue: 0,0:00:41.26,0:00:45.22,Default,,0,0,0,,Гор Кирихараның айтқаны құпия болып табылады.
Dialogue: 0,0:00:45.60,0:00:46.60,Default,,0,0,0,,Басқа ештеңе айтудың қажеті жоқ
Dialogue: 0,0:00:47.31,0:00:47.81,Default,,0,0,0,,болып табылады
Dialogue: 0,0:00:48.60,0:00:50.35,Default,,0,0,0,,Бұл лаңкестік топтың басшысы
Dialogue: 0,0:00:50.65,0:00:53.56,Default,,0,0,0,,MI6-ның бұрынғы қызметкері Фабли
Dialogue: 0,0:00:55.40,0:00:55.90,Default,,0,0,0,,Messier коды UB-001
Dialogue: 0,0:00:56.53,0:01:00.49,Default,,0,0,0,,Ол бес жыл бұрын Аспан қақпасындағы ұрыс даласында болған.
Dialogue: 0,0:01:02.99,0:01:06.99,Default,,0,0,0,,Бұл ескі скейтбордқа бару сияқты емес еді.
Dialogue: 0,0:01:07.70,0:01:10.16,Default,,0,0,0,,Ол кек алатын сияқты болды ма?
Dialogue: 0,0:01:12.13,0:01:17.09,Default,,0,0,0,,Жоғарыдағы адамдар күйген металдың өртеніп кететініне күмәнданатын сияқты.
Dialogue: 0,0:01:17.71,0:01:19.01,Default,,0,0,0,,Бұл негізсіз қорқыныш болды.
Dialogue: 0,0:01:19.88,0:01:21.68,Default,,0,0,0,,Күтіп көрейік
Dialogue: 0,0:01:24.55,0:01:27.31,Default,,0,0,0,,Бұл екеуінің арасында не болды?
Dialogue: 0,0:01:27.98,0:01:30.89,Default,,0,0,0,,Жаман нәрселерді білмегеніңіз жақсы.
Dialogue: 0,0:01:33.40,0:01:36.48,Default,,0,0,0,,Саған аздап үйреткеннен басқа амалым жоқ.
Dialogue: 0,0:01:37.78,0:01:38.99,Default,,0,0,0,,Мен опасыздық жасадым
Dialogue: 0,0:01:39.24,0:01:40.11,Default,,0,0,0,,Сол әйелге
Dialogue: 0,0:01:40.74,0:01:43.99,Default,,0,0,0,,Ал қара команда Оңтүстік Америкада жойылды
Dialogue: 0,0:01:46.79,0:01:50.87,Default,,0,0,0,,Онда байқалған бірінші жұлдыз оған тиесілі.
Dialogue: 0,0:01:51.37,0:01:55.00,Default,,0,0,0,,Жауап ретінде көптеген жұлдыздар жарқырай бастады.
Dialogue: 0,0:01:55.25,0:01:57.96,Default,,0,0,0,,БК-201 солардың қатарында.
Dialogue: 0,0:02:00.17,0:02:02.01,Default,,0,0,0,,Содан кейін бірден
Dialogue: 0,0:02:02.63,0:02:05.97,Default,,0,0,0,,Оңтүстік Америкадағы қақпаның айналасындағы радиусы 1500 км аудан.
Dialogue: 0,0:02:06.51,0:02:08.01,Default,,0,0,0,,Жер бетінен жоғалып кетті
Dialogue: 0,0:03:42.57,0:03:43.99,Default,,0,0,0,,Сәлеметсіз бе
Dialogue: 0,0:03:48.24,0:03:50.16,Default,,0,0,0,,Бұл туралы уайымдамаңыз!
Dialogue: 0,0:03:50.74,0:03:53.08,Default,,0,0,0,,Күндіз іше бастасаң, бітті!
Dialogue: 0,0:03:53.70,0:03:55.25,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:03:55.50,0:03:57.25,Default,,0,0,0,,Күндізгі уақыттан бастап ішу~
Dialogue: 0,0:03:57.50,0:04:01.04,Default,,0,0,0,,Бұл сіздің өміріңіздегі ең қызықты күн!
Dialogue: 0,0:04:02.96,0:04:03.59,Default,,0,0,0,,Таку
Dialogue: 0,0:04:04.84,0:04:06.42,Default,,0,0,0,,Эй, сен жұмыс істеп жатырсың ба?
Dialogue: 0,0:04:06.76,0:04:07.34,Default,,0,0,0,,Иә
Dialogue: 0,0:04:07.72,0:04:10.30,Default,,0,0,0,,Жақсы мырза Ли байсалды.
Dialogue: 0,0:04:10.47,0:04:11.01,Default,,0,0,0,,Жоқ
Dialogue: 0,0:04:11.22,0:04:12.14,Default,,0,0,0,,Аға
Dialogue: 0,0:04:12.39,0:04:13.68,Default,,0,0,0,,Қалай? бірге
Dialogue: 0,0:04:14.02,0:04:15.77,Default,,0,0,0,,А, жоқ, мен...
Dialogue: 0,0:04:16.19,0:04:18.06,Default,,0,0,0,,Жарайды, анда-санда.
Dialogue: 0,0:04:18.06,0:04:22.23,Default,,0,0,0,,Эй, байыпты студенттерді қаламайтын жолға сүйреп апарма!
Dialogue: 0,0:04:22.36,0:04:23.61,Default,,0,0,0,,Иә, бардым
Dialogue: 0,0:04:36.58,0:04:38.66,Default,,0,0,0,,Тұтынушы, күте тұрыңыз.
Dialogue: 0,0:04:40.00,0:04:43.75,Default,,0,0,0,,Ақшасын алмай кетсеңіз қиын болады.
Dialogue: 0,0:04:44.09,0:04:46.67,Default,,0,0,0,,Сондықтан сіз әмияныңызды ұмытып қалдыңыз деп айттыңыз.
Dialogue: 0,0:04:46.92,0:04:49.01,Default,,0,0,0,,Мен оны ертең ертең әкелемін
Dialogue: 0,0:04:49.18,0:04:49.97,Default,,0,0,0,,Жоқ, бірақ
Dialogue: 0,0:04:50.43,0:04:51.72,Default,,0,0,0,,Ғрр! Б-бұл жігіт…
Dialogue: 0,0:04:55.31,0:04:56.10,Default,,0,0,0,,Ха… Жылдам ашып көр.
Dialogue: 0,0:05:05.36,0:05:06.78,Default,,0,0,0,,Не? Темеха
Dialogue: 0,0:05:07.65,0:05:09.74,Default,,0,0,0,,Бұл Наказава тобындағы Сакурай.
Dialogue: 0,0:05:09.99,0:05:11.16,Default,,0,0,0,,Наказава тобы?
Dialogue: 0,0:05:11.70,0:05:13.78,Default,,0,0,0,,Ақшаны төлеп, тыныш оралыңыз
Dialogue: 0,0:05:14.45,0:05:17.95,Default,,0,0,0,,Мені ашуландырсаң, мен сені ренжітемін.
Dialogue: 0,0:05:20.75,0:05:22.08,Default,,0,0,0,,Аузыңыздай жақсы емес
Dialogue: 0,0:05:24.25,0:05:25.59,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:05:26.09,0:05:27.17,Default,,0,0,0,,Сіз кедергісіз.
Dialogue: 0,0:05:27.76,0:05:28.63,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:05:31.30,0:05:31.72,Default,,0,0,0,,Сен
Dialogue: 0,0:05:32.89,0:05:34.47,Default,,0,0,0,,Менің жалап отырғаным мынау
Dialogue: 0,0:05:39.31,0:05:40.64,Default,,0,0,0,,(JoJo) Дүрбелең шығарма!
Dialogue: 0,0:05:42.19,0:05:43.35,Default,,0,0,0,,Айналада қыдыру
Dialogue: 0,0:05:46.73,0:05:48.11,Default,,0,0,0,,Тек L өз ықпалындағы біреумен алмастырылған
Dialogue: 0,0:05:50.15,0:05:51.74,Default,,0,0,0,,Мына қарғыс атқыр
Dialogue: 0,0:05:52.28,0:05:54.54,Default,,0,0,0,,Е, эй, тыныштал.
Dialogue: 0,0:05:55.33,0:05:56.28,Default,,0,0,0,,Осы жерде күтіңіз.
Dialogue: 0,0:05:58.50,0:06:00.16,Default,,0,0,0,,Дүкен
Dialogue: 0,0:06:05.13,0:06:05.79,Default,,0,0,0,,Неге тағы ұйықтап қалмақсың!
Dialogue: 0,0:06:11.51,0:06:12.30,Default,,0,0,0,,Сот қажет емес!
Dialogue: 0,0:06:15.18,0:06:15.60,Default,,0,0,0,,Тоқта
Dialogue: 0,0:06:20.27,0:06:22.73,Default,,0,0,0,,Қалайша сені осылай өлтіруге болады?
Dialogue: 0,0:06:27.82,0:06:28.73,Default,,0,0,0,,Тұрақты түрде құрмет көрсет, Анджело.
Dialogue: 0,0:06:29.69,0:06:31.19,Default,,0,0,0,,Уайымдамаңыз, тұтынушылар.
Dialogue: 0,0:06:31.57,0:06:33.78,Default,,0,0,0,,Мен ақшаны дұрыс алуым керек.
Dialogue: 0,0:06:34.16,0:06:35.11,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:06:47.25,0:06:47.92,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:06:52.22,0:06:52.84,Default,,0,0,0,,Сәлем
Dialogue: 0,0:06:54.47,0:06:55.68,Default,,0,0,0,,Бұл мен...
Dialogue: 0,0:06:56.05,0:06:58.64,Default,,0,0,0,,Наказава тобынан Кэндзи Сакурай, солай ма?
Dialogue: 0,0:06:58.89,0:07:00.35,Default,,0,0,0,,Менің атым Ли Шэншунь.
Dialogue: 0,0:07:00.72,0:07:01.64,Default,,0,0,0,,Ли мырза
Dialogue: 0,0:07:02.10,0:07:04.06,Default,,0,0,0,,Сонда сен қытайсың ғой!
Dialogue: 0,0:07:05.23,0:07:06.02,Default,,0,0,0,,Ақыр соңында?
Dialogue: 0,0:07:06.52,0:07:09.36,Default,,0,0,0,,Бұл қытайлық жекпе-жек өнері болуы керек!
Dialogue: 0,0:07:09.86,0:07:12.07,Default,,0,0,0,,Жаулардан жалтарыңыз
Dialogue: 0,0:07:12.40,0:07:16.49,Default,,0,0,0,,Үлкен ағасы келмесе, Ли оны жеңбес пе еді?
Dialogue: 0,0:07:16.70,0:07:18.32,Default,,0,0,0,,Ахо аа!
Dialogue: 0,0:07:18.62,0:07:20.12,Default,,0,0,0,,Жоқ, бұл дұрыс емес...
Dialogue: 0,0:07:20.58,0:07:22.95,Default,,0,0,0,,Тағы да жасыратын ештеңем жоқ.
Dialogue: 0,0:07:23.66,0:07:24.66,Default,,0,0,0,,Кэндзи
Dialogue: 0,0:07:28.59,0:07:29.50,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:07:32.38,0:07:33.51,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:07:35.72,0:07:40.10,Default,,0,0,0,,Кэндзи, сен якудза болсаң, бітті.
Dialogue: 0,0:07:40.56,0:07:41.43,Default,,0,0,0,,Оны басқа жерде көрді, сондықтан ол сонда кетті.
Dialogue: 0,0:07:42.39,0:07:44.31,Default,,0,0,0,,Көмегіңе рахмет, аға.
Dialogue: 0,0:07:44.94,0:07:46.69,Default,,0,0,0,,Жоқ, бұл жұмыс.
Dialogue: 0,0:07:49.40,0:07:51.61,Default,,0,0,0,,Енді менімен бірге дәмді тамақ алып кел.
Dialogue: 0,0:07:54.07,0:07:55.36,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:07:55.74,0:07:56.53,Default,,0,0,0,,(Изуку) U.A. орта мектебі, 1-курс A және B сыныптары—
Dialogue: 0,0:08:06.42,0:08:07.62,Default,,0,0,0,,Еңбегіңіз үшін рахмет!
Dialogue: 0,0:08:13.63,0:08:14.05,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:08:16.26,0:08:18.47,Default,,0,0,0,,Бұл шынымен жақсы ма?
Dialogue: 0,0:08:19.05,0:08:20.18,Default,,0,0,0,,Бұл дәмді.
Dialogue: 0,0:08:21.85,0:08:24.68,Default,,0,0,0,,Жоқ, бірақ мен көп жеймін.
Dialogue: 0,0:08:25.43,0:08:29.15,Default,,0,0,0,,Бұл күштің құпиясы болуы мүмкін бе?
Dialogue: 0,0:08:29.98,0:08:31.94,Default,,0,0,0,,Сондықтан ол басқаша.
Dialogue: 0,0:08:32.23,0:08:34.73,Default,,0,0,0,,Маған сараң болмауды өтінемін.
Dialogue: 0,0:08:38.66,0:08:39.57,Default,,0,0,0,,Мен жай ғана гюдон іше аламын ба?
Dialogue: 0,0:08:41.41,0:08:42.74,Default,,0,0,0,,Менде ақша бар.
Dialogue: 0,0:08:43.04,0:08:45.12,Default,,0,0,0,,Тіпті ойын-сауық индустриясында кез келген нәрсе шатасуы мүмкін.
Dialogue: 0,0:08:46.79,0:08:47.54,Default,,0,0,0,,Жоқ, мен қалысамын.
Dialogue: 0,0:08:48.46,0:08:48.87,Default,,0,0,0,,Әке болу мен агент болуды қатар алып жүру қиын болар
Dialogue: 0,0:08:49.50,0:08:51.88,Default,,0,0,0,,Күштің сыры – әйелдерден аулақ болу.
Dialogue: 0,0:08:52.46,0:08:53.13,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:08:55.26,0:08:55.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:56.72,0:08:57.17,Default,,0,0,0,,Бұл
Dialogue: 0,0:08:57.80,0:09:00.97,Default,,0,0,0,,Уайымдама, мен сені үйіңе апарамын.
Dialogue: 0,0:09:01.55,0:09:02.05,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:09:02.76,0:09:06.27,Default,,0,0,0,,Мен бүгін саған көп қиындық тудырдым, сондықтан мұны істеуім керек.
Dialogue: 0,0:09:12.31,0:09:12.77,Default,,0,0,0,,Бұл
Dialogue: 0,0:09:18.07,0:09:19.65,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:09:29.58,0:09:32.00,Default,,0,0,0,,Жоқ, бұл өте нашар.
Dialogue: 0,0:09:32.13,0:09:32.63,Default,,0,0,0,,Жоқ
Dialogue: 0,0:09:34.13,0:09:36.17,Default,,0,0,0,,Бірақ ештеңе жоқ.
Dialogue: 0,0:09:36.59,0:09:38.34,Default,,0,0,0,,Үйге барып ұйықта.
Dialogue: 0,0:09:38.80,0:09:39.72,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:09:40.63,0:09:43.55,Default,,0,0,0,,Ли мырза, сіз толық емес жұмыс уақытыңыздан басқа бос уақытыңызда не істейсіз?
Dialogue: 0,0:09:44.05,0:09:44.76,Default,,0,0,0,,Бөлек
Dialogue: 0,0:09:45.56,0:09:46.64,Default,,0,0,0,,қоспағанда
Dialogue: 0,0:09:47.06,0:09:49.02,Default,,0,0,0,,Сіз Жапонияға жаттығуға келдіңіз, солай ма?
Dialogue: 0,0:09:49.77,0:09:50.52,Default,,0,0,0,,Олардың жылдамдығы да, күші де бір сәт бұрынғыдан мүлде өзгеше — басқа адам сияқты.
Dialogue: 0,0:09:51.02,0:09:51.89,Default,,0,0,0,,Шетелде оқу
Dialogue: 0,0:09:52.23,0:09:54.40,Default,,0,0,0,,Ха, оқисың ба?
Dialogue: 0,0:09:55.69,0:09:57.98,Default,,0,0,0,,Не? Бұл
Dialogue: 0,0:09:58.53,0:10:00.57,Default,,0,0,0,,А, әдеттегідей.
Dialogue: 0,0:10:00.86,0:10:01.95,Default,,0,0,0,,Әдеттегі...
Dialogue: 0,0:10:02.36,0:10:04.12,Default,,0,0,0,,Бұл керемет естіледі
Dialogue: 0,0:10:04.49,0:10:06.12,Default,,0,0,0,,Таңертең ерте
Dialogue: 0,0:10:06.70,0:10:09.25,Default,,0,0,0,,Менің ойымша, бұл кешеден бері болып жатыр.
Dialogue: 0,0:10:11.29,0:10:13.29,Default,,0,0,0,,Сіз мұнымен оқи аласыз ба?
Dialogue: 0,0:10:13.92,0:10:15.92,Default,,0,0,0,,Үйреніп алсаң, үлкен шаруа емес.
Dialogue: 0,0:10:16.13,0:10:18.17,Default,,0,0,0,,Бұл жай ғана өтірік емес пе?
Dialogue: 0,0:10:25.26,0:10:27.35,Default,,0,0,0,,Мен алмұрт қоямын.
Dialogue: 0,0:10:28.68,0:10:29.35,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:10:36.82,0:10:38.32,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:10:38.32,0:10:39.69,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:10:40.15,0:10:41.86,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:10:41.86,0:10:43.82,Default,,0,0,0,,Бұл Наказава тобындағы Сакурай.
Dialogue: 0,0:10:44.62,0:10:46.07,Default,,0,0,0,,Наказава тобы?
Dialogue: 0,0:10:46.99,0:10:49.49,Default,,0,0,0,,Әй, эй бауырлар~
Dialogue: 0,0:10:49.62,0:10:53.83,Default,,0,0,0,,Мен қабырғалары жұқа, тозығы жеткен пәтерде сондай ақымақ дыбыспен гитарада ойнаймын.
Dialogue: 0,0:10:53.96,0:10:56.04,Default,,0,0,0,,Бұл қандай келісім? !
Dialogue: 0,0:10:59.46,0:11:00.13,Default,,0,0,0,,Бірдеңе істе!
Dialogue: 0,0:11:00.92,0:11:03.22,Default,,0,0,0,,Сізде қандай түсінік бар!
Dialogue: 0,0:11:03.34,0:11:05.26,Default,,0,0,0,,Мен үшін не істей аласың?
Dialogue: 0,0:11:20.11,0:11:21.78,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:11:24.20,0:11:25.74,Default,,0,0,0,,Ал, түскі ас ішейік.
Dialogue: 0,0:11:27.53,0:11:29.91,Default,,0,0,0,,Денеңізді қозғалтсаңыз, қарыныңыз ашылады.
Dialogue: 0,0:11:30.66,0:11:32.33,Default,,0,0,0,,Itadadakimasu
Dialogue: 0,0:11:33.41,0:11:36.29,Default,,0,0,0,,Эй, сен Филиппинненсің бе?
Dialogue: 0,0:11:36.63,0:11:38.75,Default,,0,0,0,,Сіз Жапонияға жұмысқа барасыз ба?
Dialogue: 0,0:11:39.09,0:11:42.17,Default,,0,0,0,,Иә, әке-шешем, інілерім сонда.
Dialogue: 0,0:11:42.51,0:11:44.30,Default,,0,0,0,,Сіз ай сайын ақша жібересіз бе?
Dialogue: 0,0:11:44.76,0:11:45.88,Default,,0,0,0,,Өте дұрыс.
Dialogue: 0,0:11:46.39,0:11:47.59,Default,,0,0,0,,Шынында да.
Dialogue: 0,0:11:47.85,0:11:51.81,Default,,0,0,0,,Өйткені жапондардың бәрі бай, сонымен қатар азғын.
Dialogue: 0,0:11:53.73,0:11:54.93,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:11:55.44,0:11:57.69,Default,,0,0,0,,Роктың ағасы Жапонияға не үшін барды?
Dialogue: 0,0:11:57.90,0:12:03.19,Default,,0,0,0,,Мен рок-евангелистпін және мен рок рухын жеткізу үшін келдім!
Dialogue: 0,0:12:03.36,0:12:04.78,Default,,0,0,0,,О, жаным
Dialogue: 0,0:12:04.78,0:12:05.19,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:12:05.32,0:12:06.11,Default,,0,0,0,,Оның мағынасы жоқ.
Dialogue: 0,0:12:06.20,0:12:07.07,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:12:07.87,0:12:08.91,Default,,0,0,0,,Сонымен, сіз
Dialogue: 0,0:12:09.12,0:12:10.66,Default,,0,0,0,,Мен Израильден келдім
Dialogue: 0,0:12:10.95,0:12:12.74,Default,,0,0,0,,Жапон анимациясын үйреніңіз!
Dialogue: 0,0:12:12.79,0:12:14.50,Default,,0,0,0,,Неліктен бұлай істеуге тырысасыз?
Dialogue: 0,0:12:14.96,0:12:18.29,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Жапондық аниме - әлемдегі ең жақсы
Dialogue: 0,0:12:18.38,0:12:18.88,Default,,0,0,0,,Және...
Dialogue: 0,0:12:19.04,0:12:21.25,Default,,0,0,0,,Иә, иә, бұл ұзаққа созылады, сондықтан мен осы жерден тоқтайын.
Dialogue: 0,0:12:22.30,0:12:25.22,Default,,0,0,0,,Бұл халықаралық пәтерге ұқсайды.
Dialogue: 0,0:12:25.51,0:12:26.22,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:12:27.18,0:12:30.72,Default,,0,0,0,,Сізге рахмет, мен қазірдің өзінде 7 тілде еркін сөйлеймін.
Dialogue: 0,0:12:32.56,0:12:34.77,Default,,0,0,0,,Жоқ, бұл қызықты естіледі.
Dialogue: 0,0:12:35.27,0:12:36.85,Default,,0,0,0,,Мүмкін мен де солай істеуім керек шығар.
Dialogue: 0,0:12:37.06,0:12:38.02,Default,,0,0,0,,Сәлем Ли мырза
Dialogue: 0,0:12:39.40,0:12:39.94,Default,,0,0,0,,Ал сен ше, Хори-сан? Қандай музыка ұнайды?
Dialogue: 0,0:12:40.56,0:12:43.11,Default,,0,0,0,,Мен дәл қазір сиыр етін көп жедім.
Dialogue: 0,0:12:43.40,0:12:45.40,Default,,0,0,0,,Тағы бір толтыруды қалайсыз ба? Ли мырза
Dialogue: 0,0:12:45.57,0:12:46.99,Default,,0,0,0,,A Itadadakimasu
Dialogue: 0,0:12:47.49,0:12:48.61,Default,,0,0,0,,Тамақ ішу
Dialogue: 0,0:12:50.41,0:12:52.03,Default,,0,0,0,,Ас үшін рахмет!
Dialogue: 0,0:12:55.75,0:12:57.96,Default,,0,0,0,,Жарайды, менің ішім ісіп кетті.
Dialogue: 0,0:12:58.21,0:12:59.67,Default,,0,0,0,,Сіз кешкі кешке барасыз ба?
Dialogue: 0,0:13:00.25,0:13:01.71,Default,,0,0,0,,Сіз де ше?
Dialogue: 0,0:13:03.42,0:13:04.55,Default,,0,0,0,,Саке?
Dialogue: 0,0:13:04.84,0:13:06.59,Default,,0,0,0,,Бұл жақсы, Ли мырза.
Dialogue: 0,0:13:06.80,0:13:10.55,Default,,0,0,0,,Жоқ, менің біреумен кездесуге жазылуым бар еді.
Dialogue: 0,0:13:16.48,0:13:18.64,Default,,0,0,0,,Ол адамның қарым-қатынасы нашар.
Dialogue: 0,0:13:19.44,0:13:22.31,Default,,0,0,0,,Бүгінге дейін көп сөйлескен жоқпыз.
Dialogue: 0,0:13:22.65,0:13:24.36,Default,,0,0,0,,Жақсы, солай емес пе?
Dialogue: 0,0:13:24.73,0:13:27.40,Default,,0,0,0,,Кейбір адамдар жалғыз өмір сүре алады
Dialogue: 0,0:13:27.57,0:13:28.65,Default,,0,0,0,,ішу
Dialogue: 0,0:13:29.45,0:13:30.61,Default,,0,0,0,,Менің ойымша.
Dialogue: 0,0:13:30.78,0:13:31.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:31.49,0:13:35.49,Default,,0,0,0,,Ли мырзаның арқасы жалғыз сияқты, солай емес пе?
Dialogue: 0,0:13:44.09,0:13:45.21,Default,,0,0,0,,Хитоцубаши
Dialogue: 0,0:13:46.30,0:13:49.38,Default,,0,0,0,,Мен сен сияқты еркектерді ұнатпаймын.
Dialogue: 0,0:13:50.13,0:13:51.01,Default,,0,0,0,,Мен құрметтімін
Dialogue: 0,0:13:52.05,0:13:56.01,Default,,0,0,0,,Бірақ мен сізге мәселені өз қолыңызға алуға рұқсат етпеймін.
Dialogue: 0,0:13:56.39,0:13:57.72,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:13:57.77,0:13:59.14,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:14:07.19,0:14:10.57,Default,,0,0,0,,Мен сіздің үлкен мәселе тудырғаныңызды білемін.
Dialogue: 0,0:14:11.74,0:14:14.82,Default,,0,0,0,,Уайымдамаңыз, мен жағдайды нашарлатқым келмейді.
Dialogue: 0,0:14:15.41,0:14:20.66,Default,,0,0,0,,Біраз уақыт үндемесең, мен сені лайықты постқа қоямын.
Dialogue: 0,0:14:21.42,0:14:24.83,Default,,0,0,0,,Мен сіздің қабілеттеріңізді жақсы білемін.
Dialogue: 0,0:14:25.71,0:14:26.59,Default,,0,0,0,,Қызымнан күткенімдей.
Dialogue: 0,0:14:29.84,0:14:31.42,Default,,0,0,0,,Мен мұны есте ұстаймын.
Dialogue: 0,0:14:32.38,0:14:33.72,Default,,0,0,0,,Хитоцубаши
Dialogue: 0,0:14:34.09,0:14:36.05,Default,,0,0,0,,Ол дүкенде пайда болды ма?
Dialogue: 0,0:14:36.56,0:14:37.10,Default,,0,0,0,,болып табылады
Dialogue: 0,0:14:38.35,0:14:39.89,Default,,0,0,0,,Дүкенді басқарыңыз.
Dialogue: 0,0:14:40.18,0:14:43.06,Default,,0,0,0,,Қателер бірнеше күннен кейін жұқтырылуы керек.
Dialogue: 0,0:14:43.15,0:14:45.90,Default,,0,0,0,,транзакцияға кедергі жасамаңыз.
Dialogue: 0,0:14:46.27,0:14:47.32,Default,,0,0,0,,Мен сіздерді Азумабито мырзаның резиденциясына апарамын.
Dialogue: 0,0:14:47.69,0:14:50.86,Default,,0,0,0,,Егер транзакцияны жойсаңыз, ақшаңызды жоғалтасыз.
Dialogue: 0,0:14:51.28,0:14:54.24,Default,,0,0,0,,Одан гөрі бұл қандай бала?
Dialogue: 0,0:14:54.57,0:14:55.32,Default,,0,0,0,,Бала?
Dialogue: 0,0:14:56.70,0:14:58.37,Default,,0,0,0,,Ол үшін алаңдаудың қажеті жоқ.
Dialogue: 0,0:14:58.74,0:15:00.29,Default,,0,0,0,,Менің ойымша, бұл рас
Dialogue: 0,0:15:00.41,0:15:03.00,Default,,0,0,0,,Миссия кезінде ешқандай қиындықты қаламаймын.
Dialogue: 0,0:15:05.08,0:15:06.04,Default,,0,0,0,,Мен сіздерді Азумабито мырзаның резиденциясына апарамын.
Dialogue: 0,0:15:12.72,0:15:14.38,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:15:14.97,0:15:15.89,Default,,0,0,0,,Барлығы ше?
Dialogue: 0,0:15:16.47,0:15:17.60,Default,,0,0,0,,Мен ұйықтап жатырмын
Dialogue: 0,0:15:24.90,0:15:25.40,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:15:26.31,0:15:27.73,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:15:28.32,0:15:29.48,Default,,0,0,0,,(Тсубаки) Дегенмен, Косэйдің аяғына зақым келгеніне қуаныштымын—
Dialogue: 0,0:15:29.98,0:15:32.69,Default,,0,0,0,,Сен маған жаңбырдан баспана бердің, солай ма?
Dialogue: 0,0:15:32.86,0:15:33.90,Default,,0,0,0,,Ааа
Dialogue: 0,0:15:34.24,0:15:36.87,Default,,0,0,0,,Мен сол 100 000 иенге такси ұстайтын едім.
Dialogue: 0,0:15:37.12,0:15:39.16,Default,,0,0,0,,Мен бұл туралы ойламадым
Dialogue: 0,0:15:40.79,0:15:43.58,Default,,0,0,0,,Ли мырза біртүрлі адам.
Dialogue: 0,0:15:45.25,0:15:47.54,Default,,0,0,0,,Олай болса, тағы тамақ ішейік.
Dialogue: 0,0:15:47.88,0:15:48.54,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:15:57.14,0:15:58.51,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:15:59.60,0:16:00.97,Default,,0,0,0,,Ах, Ли Кун.
Dialogue: 0,0:16:01.52,0:16:04.18,Default,,0,0,0,,Сізде ұялы телефон жоқ болғандықтан, қиындыққа тап болдыңыз.
Dialogue: 0,0:16:04.52,0:16:05.23,Default,,0,0,0,,Иә
Dialogue: 0,0:16:05.48,0:16:07.56,Default,,0,0,0,,Тосын жаңалық үшін кешіріңіз.
Dialogue: 0,0:16:07.81,0:16:10.44,Default,,0,0,0,,Дүкен бүгіннен бастап шамамен үш күн бойы жұмыс істемейді.
Dialogue: 0,0:16:11.19,0:16:12.53,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:16:12.90,0:16:14.44,Default,,0,0,0,,Құрылыс жұмыстары жүріп жатыр.
Dialogue: 0,0:16:14.61,0:16:17.28,Default,,0,0,0,,Бора, әжетхананың жағдайы нашар еді, солай емес пе?
Dialogue: 0,0:16:17.41,0:16:18.70,Default,,0,0,0,,Э? Иә, иә.
Dialogue: 0,0:16:19.70,0:16:20.83,Default,,0,0,0,,Оның орнына
Dialogue: 0,0:16:20.87,0:16:23.54,Default,,0,0,0,,Мен демалыста болсам да, толық емес жұмыс күнім үшін төлеймін.
Dialogue: 0,0:16:24.29,0:16:25.54,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:16:30.09,0:16:31.17,Default,,0,0,0,,О, ағайын
Dialogue: 0,0:16:31.96,0:16:33.00,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:16:34.09,0:16:36.01,Default,,0,0,0,,Олар топ ауыстыратынын айтты.
Dialogue: 0,0:16:37.05,0:16:37.93,Default,,0,0,0,,Топ...
Dialogue: 0,0:16:38.51,0:16:40.22,Default,,0,0,0,,Мен әкеме қарыздар едім.
Dialogue: 0,0:16:40.89,0:16:42.64,Default,,0,0,0,,Ол кісі де әлсіз еді.
Dialogue: 0,0:16:43.27,0:16:46.98,Default,,0,0,0,,Якудза тұрақтылыққа ұмтыла бастағанда аяқталады.
Dialogue: 0,0:16:48.02,0:16:49.94,Default,,0,0,0,,Маған неге олай айтып тұрсың?
Dialogue: 0,0:16:51.15,0:16:53.65,Default,,0,0,0,,Менің сенің істегеніңді қалайтын жұмысым бар.
Dialogue: 0,0:16:58.82,0:17:01.49,Default,,0,0,0,,Кенджи, менімен бірге жүр.
Dialogue: 0,0:17:09.21,0:17:11.92,Default,,0,0,0,,Әй, аға, бұл не?
Dialogue: 0,0:17:12.75,0:17:13.34,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:17:13.71,0:17:14.25,Default,,0,0,0,,Эй
Dialogue: 0,0:17:26.73,0:17:27.85,Default,,0,0,0,,Сіз таң қалдыңыз ба?
Dialogue: 0,0:17:29.90,0:17:30.69,Default,,0,0,0,,Олар бақытты өмір сүруге құқылы
Dialogue: 0,0:17:47.04,0:17:48.91,Default,,0,0,0,,А, аға, бұл...
Dialogue: 0,0:17:49.21,0:17:50.21,Default,,0,0,0,,Бұл қуыршақ.
Dialogue: 0,0:17:50.42,0:17:52.79,Default,,0,0,0,,Қуыршақ? ! Сен адам емессің бе?
Dialogue: 0,0:17:53.17,0:17:54.21,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:17:54.67,0:17:56.88,Default,,0,0,0,,Не бұйырсаңыз, соны орындаңыз.
Dialogue: 0,0:17:57.01,0:17:58.97,Default,,0,0,0,,Ерекше және әдемі қуыршақ.
Dialogue: 0,0:18:01.84,0:18:05.64,Default,,0,0,0,,Осындай ойыншықтарды алғысы келетін байлар бар.
Dialogue: 0,0:18:07.27,0:18:09.68,Default,,0,0,0,,Сен мына жігітті бірнеше күн бағып ал.
Dialogue: 0,0:18:10.73,0:18:13.15,Default,,0,0,0,,Мені тамақтандырмасаң, көңілім түсер.
Dialogue: 0,0:18:13.40,0:18:15.44,Default,,0,0,0,,Мен де қол астындағыларға қамқорлық жасауым керек.
Dialogue: 0,0:18:16.07,0:18:17.98,Default,,0,0,0,,Бұл маңызды өнім.
Dialogue: 0,0:18:18.94,0:18:20.82,Default,,0,0,0,,Оны таза ұстаңыз
Dialogue: 0,0:18:21.36,0:18:22.28,Default,,0,0,0,,Тауарлар…
Dialogue: 0,0:18:30.83,0:18:32.33,Default,,0,0,0,,Ал, қалғанын саған қалдырамын.
Dialogue: 0,0:18:33.67,0:18:35.00,Default,,0,0,0,,Біртүрлі ештеңе жасамаңыз
Dialogue: 0,0:18:45.35,0:18:47.76,Default,,0,0,0,,Неліктен адамдарды осылай тартасың?
Dialogue: 0,0:18:48.18,0:18:50.23,Default,,0,0,0,,Сен ол жігіт сияқты ақымақ емессің деп үміттенемін.
Dialogue: 0,0:18:50.31,0:18:53.27,Default,,0,0,0,,Өнімге зақым келтіруіңіз мүмкін.
Dialogue: 0,0:18:55.36,0:18:59.23,Default,,0,0,0,,Уайымдама, оның маған опасыздық жасауға батылы жетпейді.
Dialogue: 0,0:19:02.99,0:19:09.83,Default,,0,0,0,,Аа, сіз мұны менің қалаған нәрсем деп айтқаныңыздан кейін, мен оны өлтіруші деп ойладым.
Dialogue: 0,0:19:20.84,0:19:23.34,Default,,0,0,0,,Әй, сен қайдансың?
Dialogue: 0,0:19:24.80,0:19:25.55,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:19:29.14,0:19:30.97,Default,,0,0,0,,Жапон тілін түсінбейтін шығарсыз?
Dialogue: 0,0:19:34.56,0:19:36.10,Default,,0,0,0,,Маған олай қарама.
Dialogue: 0,0:19:46.07,0:19:46.82,Default,,0,0,0,,Сіз...
Dialogue: 0,0:19:47.91,0:19:49.87,Default,,0,0,0,,Ары қарай не болар екен деп ойлаймын.
Dialogue: 0,0:19:51.50,0:19:53.66,Default,,0,0,0,,БК-201 бойынша ақпарат?
Dialogue: 0,0:19:54.29,0:19:56.83,Default,,0,0,0,,Мен мұның бәрін саған беремін.
Dialogue: 0,0:19:57.04,0:19:58.67,Default,,0,0,0,,Менің ойымша.
Dialogue: 0,0:19:58.92,0:20:00.50,Default,,0,0,0,,Бірдеңе дұрыс емес сияқты.
Dialogue: 0,0:20:01.88,0:20:04.05,Default,,0,0,0,,Өзін ЭПР деп атайтын топ
Dialogue: 0,0:20:04.30,0:20:05.72,Default,,0,0,0,,Қылмыс туралы мәлімдеме
Dialogue: 0,0:20:06.39,0:20:08.51,Default,,0,0,0,,және BK-201
Dialogue: 0,0:20:09.64,0:20:11.31,Default,,0,0,0,,Олар жау ма?
Dialogue: 0,0:20:11.60,0:20:13.60,Default,,0,0,0,,Әлде бұл сызат болды ма?
Dialogue: 0,0:20:14.44,0:20:17.23,Default,,0,0,0,,Оның ең бірінші мақсаты қандай?
Dialogue: 0,0:20:17.61,0:20:19.40,Default,,0,0,0,,Біз ештеңе білмейміз
Dialogue: 0,0:20:19.98,0:20:22.19,Default,,0,0,0,,Оларды мұндай күйге түсіруге қалай дәтің бар...
Dialogue: 0,0:20:23.11,0:20:25.74,Default,,0,0,0,,Ей, Хошими-саманың сөздеріне қалай қарайсың?
Dialogue: 0,0:20:25.99,0:20:27.82,Default,,0,0,0,,Жаңа талдаулар болса да...
Dialogue: 0,0:20:27.87,0:20:29.66,Default,,0,0,0,,Аа, енді бұл туралы уайымдамаңыз
Dialogue: 0,0:20:30.08,0:20:32.66,Default,,0,0,0,,Мен осы уақытқа дейін кептелдім.
Dialogue: 0,0:20:33.00,0:20:35.62,Default,,0,0,0,,Үйге келгенше бұл туралы сөйлескім келмейді.
Dialogue: 0,0:20:36.54,0:20:37.29,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:20:37.71,0:20:40.42,Default,,0,0,0,,Мисаки Сен де ертең жұмыстан шығасың.
Dialogue: 0,0:20:40.54,0:20:41.46,Default,,0,0,0,,Иә, бірақ
Dialogue: 0,0:20:42.05,0:20:45.42,Default,,0,0,0,,Менің ойымша, сізде бәрібір жоспар жоқ. Келіңіз, біраз уақыт тұрыңыз.
Dialogue: 0,0:20:45.55,0:20:46.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:59.48,0:21:00.86,Default,,0,0,0,,Бұл не нәрсе...
Dialogue: 0,0:21:03.82,0:21:06.44,Default,,0,0,0,,Балалар, мұны сезген шығарсыңдар, солай ма?
Dialogue: 0,0:21:06.65,0:21:08.15,Default,,0,0,0,,Мен бұлай араласпаймын.
Dialogue: 0,0:21:08.45,0:21:10.45,Default,,0,0,0,,Олай болса қуыршақтарды неге өлтіресің?
Dialogue: 0,0:21:10.66,0:21:13.70,Default,,0,0,0,,Сіз олардың ұрланғанын білесіз бе?
Dialogue: 0,0:21:14.87,0:21:17.91,Default,,0,0,0,,Ұрлық болуы мүмкін бе?
Dialogue: 0,0:21:18.25,0:21:19.33,Default,,0,0,0,,Ұф… сен, кішкентай сорлы.
Dialogue: 0,0:21:19.88,0:21:22.75,Default,,0,0,0,,Наказава тобы дәл қазір әбігерге түсті.
Dialogue: 0,0:21:23.46,0:21:25.42,Default,,0,0,0,,Күмісті қалай табуға болады?
Dialogue: 0,0:21:29.30,0:21:30.18,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:21:31.10,0:21:32.05,Default,,0,0,0,,Қане, қол ұстасайық
Dialogue: 0,0:21:33.81,0:21:35.43,Default,,0,0,0,,Тым тереңге бармаған дұрыс
Dialogue: 0,0:21:37.52,0:21:40.90,Default,,0,0,0,,Миссияны жалғастыру немесе жалғастырмау бізге байланысты емес.
Dialogue: 0,0:21:41.11,0:21:42.69,Default,,0,0,0,,Мен сені көруге шақырамын.
Dialogue: 0,0:21:42.69,0:21:44.15,Default,,0,0,0,,Мен оған дейін күтемін.
Dialogue: 0,0:21:59.96,0:22:02.67,Default,,0,0,0,,Ли мырза! Кешіріңіз!
Dialogue: 0,0:22:03.17,0:22:05.13,Default,,0,0,0,,Сіз мені біраз уақытқа жасыра аласыз ба?
Dialogue: 0,0:23:41.73,0:23:45.40,Default,,0,0,0,,Қолымдағы асыл тастан түссіз мөлдір ұшқын шығады.
Dialogue: 0,0:23:46.19,0:23:48.90,Default,,0,0,0,,Тазалық бұзылудың көлеңкесін тартады
Dialogue: 0,0:23:50.07,0:23:53.24,Default,,0,0,0,,Ешқашан қиылыспауы керек екі дүние
Dialogue: 0,0:23:54.16,0:23:56.03,Default,,0,0,0,,Баратын жер жоқ
Dialogue: 0,0:23:56.45,0:23:58.58,Default,,0,0,0,,Қашу шексіз жалғасады.
Dialogue: 0,0:23:59.95,0:24:03.29,Default,,0,0,0,,Мен одан әрі не бар екенін білгім келмеді.
Dialogue: 0,0:24:04.37,0:24:08.00,Default,,0,0,0,,Ал адам шұңқырда жатыр.
Dialogue: 0,0:24:09.50,0:24:15.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
