Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:28.63,0:00:29.84,Default,,0,0,0,,Ричард Лау.
Dialogue: 0,0:00:31.80,0:00:32.10,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:00:32.76,0:00:35.89,Default,,0,0,0,,Мердігер туралы ақпарат бар екені рас па?
Dialogue: 0,0:00:37.39,0:00:38.14,Default,,0,0,0,,Бұл рас
Dialogue: 0,0:00:38.90,0:00:43.06,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Сондықтан менің қауіпсіздігіме кепілдік беріңізші.
Dialogue: 0,0:00:43.44,0:00:44.98,Default,,0,0,0,,Мазмұнына байланысты
Dialogue: 0,0:00:45.44,0:00:50.16,Default,,0,0,0,,Мен бұл қалада сіз іздеп жүрген адамды білемін.
Dialogue: 0,0:00:50.62,0:00:52.24,Default,,0,0,0,,VI-952?
Dialogue: 0,0:00:52.53,0:00:54.41,Default,,0,0,0,,Дұрыс, сондықтан мен...
Dialogue: 0,0:00:54.66,0:00:57.45,Default,,0,0,0,,Жарайды, жауапкершілікпен қорғайық.
Dialogue: 0,0:00:57.87,0:00:59.54,Default,,0,0,0,,Жаңа отбасы тізілімін дайындаңыз
Dialogue: 0,0:01:00.00,0:01:01.96,Default,,0,0,0,,Бірақ ақпарат бірінші орында.
Dialogue: 0,0:01:02.46,0:01:04.59,Default,,0,0,0,,Мен білемін, оның аты...
Dialogue: 0,0:01:05.25,0:01:07.55,Default,,0,0,0,,Әй, бұл арқа не болды?
Dialogue: 0,0:01:13.51,0:01:15.39,Default,,0,0,0,,Не болды? Сен не істеп жатырсың?
Dialogue: 0,0:01:31.99,0:01:34.03,Default,,0,0,0,,Менеджер, жақсысың ба?
Dialogue: 0,0:01:34.49,0:01:38.29,Default,,0,0,0,,Жарайды. Мүмкіндігінше тезірек менеджерге хабарласыңыз.
Dialogue: 0,0:01:38.62,0:01:41.29,Default,,0,0,0,,Сот-медициналық сараптаманы шақырыңыз және оқиға болған жерді келгенше ұстаңыз.
Dialogue: 0,0:01:41.67,0:01:42.37,Default,,0,0,0,,Иә
Dialogue: 0,0:03:23.31,0:03:26.27,Default,,0,0,0,,Зат тасымалдау қабілетінің бір түрі сияқты.
Dialogue: 0,0:03:26.65,0:03:29.44,Default,,0,0,0,,Оны пайдалану өте қиын.
Dialogue: 0,0:03:29.82,0:03:33.65,Default,,0,0,0,,Бөлім меңгерушісі ойылған жерден қан көргенін айтты.
Dialogue: 0,0:03:33.86,0:03:36.20,Default,,0,0,0,,Кейбір байланыс бар сияқты.
Dialogue: 0,0:03:36.61,0:03:39.91,Default,,0,0,0,,Бұл жүз Ричард Лау болуы керек.
Dialogue: 0,0:03:40.66,0:03:46.16,Default,,0,0,0,,Ван Сяотанның қалталы қылышы атанған адам да ақыры аянышты болды.
Dialogue: 0,0:03:48.84,0:03:49.96,Default,,0,0,0,,Тек L өз ықпалындағы біреумен алмастырылған
Dialogue: 0,0:03:50.42,0:03:51.50,Default,,0,0,0,,Не
Dialogue: 0,0:03:53.80,0:03:55.92,Default,,0,0,0,,Мен оның қорлау екеніне сенімдімін
Dialogue: 0,0:03:57.51,0:03:59.68,Default,,0,0,0,,Әй, қой, бұл жерден кіруге болмайды.
Dialogue: 0,0:04:02.10,0:04:03.52,Default,,0,0,0,,Жоқ, мен...
Dialogue: 0,0:04:03.98,0:04:08.06,Default,,0,0,0,,Дәл қазір бір оқиға болып жатыр, оған қатысы барлардан басқа ешкімді кіргізбейді.
Dialogue: 0,0:04:08.44,0:04:09.81,Default,,0,0,0,,Е, мен...
Dialogue: 0,0:04:10.40,0:04:11.40,Default,,0,0,0,,Әкем
Dialogue: 0,0:04:17.28,0:04:18.16,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:04:18.57,0:04:20.45,Default,,0,0,0,,Жетекші Наоясу Кирихара
Dialogue: 0,0:04:20.83,0:04:22.78,Default,,0,0,0,,Ұлттық полиция агенттігінің Қауіпсіздік бюросының директоры
Dialogue: 0,0:04:25.71,0:04:27.62,Default,,0,0,0,,Менің ойымша, бұл 9-шы болды.
Dialogue: 0,0:04:27.92,0:04:28.42,Default,,0,0,0,,Иә
Dialogue: 0,0:04:28.92,0:04:33.21,Default,,0,0,0,,Барлық құрбандар - Гонконг мафиясының басшылары Чин Лонг Тан.
Dialogue: 0,0:04:33.71,0:04:37.47,Default,,0,0,0,,Бұл ұйымаралық қақтығыс па, әлде ішкі билік үшін күрес пе?
Dialogue: 0,0:04:38.30,0:04:40.05,Default,,0,0,0,,Сонымен...қылмыскердің нысанасы
Dialogue: 0,0:04:40.93,0:04:42.39,Default,,0,0,0,,Адам өлтіру әдісінен
Dialogue: 0,0:04:42.76,0:04:47.23,Default,,0,0,0,,Осы оқиғалардың барлығын бір мердігер жасағаны анықталды.
Dialogue: 0,0:04:47.56,0:04:48.56,Default,,0,0,0,,Messier коды – бұл...
Dialogue: 0,0:04:48.85,0:04:50.48,Default,,0,0,0,,VI-952
Dialogue: 0,0:04:51.52,0:04:54.02,Default,,0,0,0,,Білсеңіз, сұрамаңыз.
Dialogue: 0,0:04:55.15,0:04:58.11,Default,,0,0,0,,Дұрыс, өзіңді басқалар сияқты ұстамасаң, олай істемейсің.
Dialogue: 0,0:04:58.66,0:05:01.07,Default,,0,0,0,,Жұмыс уақыты бітті.
Dialogue: 0,0:05:01.37,0:05:03.24,Default,,0,0,0,,Іс әлі шешілмеген
Dialogue: 0,0:05:05.08,0:05:07.33,Default,,0,0,0,,Біз тамақ алып келсек қайтеді?
Dialogue: 0,0:05:07.50,0:05:08.62,Default,,0,0,0,,Сол адам – бәрінен әлсіз
Dialogue: 0,0:05:08.92,0:05:12.79,Default,,0,0,0,,Қауіпсіздік бастығы ретінде бұйрық беруім керек пе? Бастық Кирихара
Dialogue: 0,0:05:17.59,0:05:20.55,Default,,0,0,0,,Олай болса, орынды таңдауға рұқсат етіңіз.
Dialogue: 0,0:05:20.84,0:05:22.05,Default,,0,0,0,,О, әрине
Dialogue: 0,0:05:32.15,0:05:33.65,Default,,0,0,0,,Не ойнап жүрсің?
Dialogue: 0,0:05:34.73,0:05:36.07,Default,,0,0,0,,Бұл қонақүйді таңдаудың қажеті жоқ
Dialogue: 0,0:05:37.07,0:05:37.86,Default,,0,0,0,,Бірақ бұл дәмді
Dialogue: 0,0:05:38.07,0:05:39.19,Default,,0,0,0,,Анасы: Йор Форджер, жергілікті кеңсенің қызметкері
Dialogue: 0,0:05:39.78,0:05:42.16,Default,,0,0,0,,Бұл Ван Сяотанның қонақ үйі.
Dialogue: 0,0:05:42.41,0:05:43.12,Default,,0,0,0,,Сонымен
Dialogue: 0,0:05:43.57,0:05:46.83,Default,,0,0,0,,Ван туралы айтатын болсақ, ол қонақүй менеджері сияқты.
Dialogue: 0,0:05:47.16,0:05:49.71,Default,,0,0,0,,Ол шын мәнінде Цинлунтанның бастығы емес пе?
Dialogue: 0,0:05:50.00,0:05:52.96,Default,,0,0,0,,Мен сенің Шиндзюкуда сондай бала екеніңді білемін.
Dialogue: 0,0:05:53.67,0:05:54.79,Default,,0,0,0,,Олай болса...
Dialogue: 0,0:05:55.13,0:05:58.80,Default,,0,0,0,,Тергеуге байланысты бұл жерден кеткім келмейді.
Dialogue: 0,0:05:59.26,0:06:01.30,Default,,0,0,0,,Оның үстіне мен жай ғана тамақтанып жатырмын.
Dialogue: 0,0:06:03.80,0:06:05.80,Default,,0,0,0,,Тек абыройлы бол.
Dialogue: 0,0:06:09.18,0:06:10.73,Default,,0,0,0,,Сонымен... оқиға қандай?
Dialogue: 0,0:06:11.23,0:06:14.81,Default,,0,0,0,,Сіз мені күштеп шақырғандықтан, бұл маңызды мәселе болуы керек деп ойлаймын.
Dialogue: 0,0:06:16.23,0:06:18.69,Default,,0,0,0,,Жақында сізге жұмыс ұсынылады.
Dialogue: 0,0:06:18.90,0:06:19.44,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:06:19.78,0:06:23.70,Default,,0,0,0,,Құттықтаймыз Мисаки, сіз ақыры басшы болдыңыз.
Dialogue: 0,0:06:24.70,0:06:27.66,Default,,0,0,0,,Мен біраз уақыт полиция бастығы болып жұмыс істеймін.
Dialogue: 0,0:06:28.08,0:06:30.87,Default,,0,0,0,,Ақырында, мен бас кеңсеге кеңесші болып тағайындаламын.
Dialogue: 0,0:06:31.92,0:06:33.54,Default,,0,0,0,,Неліктен олай етесіз?
Dialogue: 0,0:06:33.83,0:06:35.58,Default,,0,0,0,,Әлі көп жол бар
Dialogue: 0,0:06:35.79,0:06:40.84,Default,,0,0,0,,Сіз полицияның бірінші әйел бастығы боласыз деп күтілуде.
Dialogue: 0,0:06:41.38,0:06:43.38,Default,,0,0,0,,Тұтынушыларды қызықтыратын панда дегеніміз не?
Dialogue: 0,0:06:44.05,0:06:47.68,Default,,0,0,0,,Бұл қиын, мен оны жоққа шығара алмаймын.
Dialogue: 0,0:06:50.06,0:06:52.39,Default,,0,0,0,,Сіз полицияға не үшін келдіңіз?
Dialogue: 0,0:06:52.44,0:06:52.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:53.69,0:06:58.02,Default,,0,0,0,,Сіз полиция қызметкері болып, әлсіздерге көмектескіңіз келетінін айттыңыз.
Dialogue: 0,0:06:59.61,0:07:00.44,Default,,0,0,0,,Иә
Dialogue: 0,0:07:00.82,0:07:03.40,Default,,0,0,0,,Олай болса жоғарылату жаман емес.
Dialogue: 0,0:07:04.20,0:07:08.41,Default,,0,0,0,,Сіз неғұрлым жоғары болсаңыз, соғұрлым көп адамдарды құтқара аласыз.
Dialogue: 0,0:07:09.08,0:07:11.08,Default,,0,0,0,,Бұл рас болуы мүмкін
Dialogue: 0,0:07:11.45,0:07:14.00,Default,,0,0,0,,Ресми шығарылымға дейін әлі уақыт бар
Dialogue: 0,0:07:14.46,0:07:16.33,Default,,0,0,0,,Дайын болыңыз
Dialogue: 0,0:07:21.92,0:07:25.01,Default,,0,0,0,,Жарайды, бұлай бейқам болма.
Dialogue: 0,0:07:25.39,0:07:26.39,Default,,0,0,0,,Мен сіздерді Азумабито мырзаның резиденциясына апарамын.
Dialogue: 0,0:07:44.20,0:07:45.36,Default,,0,0,0,,Мисаки
Dialogue: 0,0:07:46.20,0:07:47.07,Default,,0,0,0,,Алиса
Dialogue: 0,0:07:47.57,0:07:49.91,Default,,0,0,0,,Келгендеріңізге рахмет.
Dialogue: 0,0:07:53.20,0:07:55.37,Default,,0,0,0,,Айырмашылығы неде?
Dialogue: 0,0:07:55.79,0:07:57.46,Default,,0,0,0,,Қандай жұмыс
Dialogue: 0,0:07:57.83,0:07:58.63,Default,,0,0,0,,Иә... иә
Dialogue: 0,0:08:00.38,0:08:02.71,Default,,0,0,0,,Бүгін қай күн екені есімде жоқ.
Dialogue: 0,0:08:03.88,0:08:05.01,Default,,0,0,0,,Бүгін
Dialogue: 0,0:08:05.38,0:08:07.43,Default,,0,0,0,,Иә, менің туған күнім.
Dialogue: 0,0:08:08.14,0:08:10.89,Default,,0,0,0,,Сол үшін келді деп ойладым.
Dialogue: 0,0:08:11.89,0:08:12.72,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:08:13.27,0:08:15.35,Default,,0,0,0,,Жас ханым, уақыт келді
Dialogue: 0,0:08:15.73,0:08:17.10,Default,,0,0,0,,Мисаки есімде
Dialogue: 0,0:08:17.44,0:08:21.44,Default,,0,0,0,,Вэй Цишун, мен орта мектепте оқып жүргенімде менің күзетшім болған.
Dialogue: 0,0:08:22.15,0:08:23.03,Default,,0,0,0,,Иә
Dialogue: 0,0:08:23.69,0:08:25.32,Default,,0,0,0,,Көп уақыт өтті.
Dialogue: 0,0:08:26.40,0:08:28.07,Default,,0,0,0,,Әй, бұл біртүрлі емес пе?
Dialogue: 0,0:08:30.37,0:08:35.20,Default,,0,0,0,,Мен сізге полиция ешқашан кірмейтін жерлерді көрсетемін.
Dialogue: 0,0:09:10.78,0:09:12.45,Default,,0,0,0,,Толығырақ кейінірек
Dialogue: 0,0:09:16.70,0:09:18.08,Default,,0,0,0,,Камера жоқ
Dialogue: 0,0:09:19.00,0:09:23.00,Default,,0,0,0,,Жоғарыда әкем екеуміз тұратын пентхаус.
Dialogue: 0,0:09:23.46,0:09:26.84,Default,,0,0,0,,Ешкім рұқсатсыз кіре алмайтын жеке кеңістік
Dialogue: 0,0:09:27.22,0:09:32.05,Default,,0,0,0,,Сондықтан камералар жоқ, әрине полиция ешқашан ішке кірген емес.
Dialogue: 0,0:09:32.64,0:09:33.60,Default,,0,0,0,,Иә
Dialogue: 0,0:09:34.10,0:09:37.52,Default,,0,0,0,,Эй, төмендегі банкалар дәмді болды, солай ма?
Dialogue: 0,0:09:37.89,0:09:38.81,Default,,0,0,0,,Иә... иә
Dialogue: 0,0:09:39.14,0:09:40.48,Default,,0,0,0,,Сіз тамақ жедіңіз бе?
Dialogue: 0,0:09:41.31,0:09:43.81,Default,,0,0,0,,Маған әлі де майлы тамақ ұнайды.
Dialogue: 0,0:09:44.27,0:09:45.11,Default,,0,0,0,,Сіз салмақ қосасыз
Dialogue: 0,0:09:46.07,0:09:49.11,Default,,0,0,0,,Жарайды, мен күнде денемді қозғалтамын.
Dialogue: 0,0:09:57.54,0:10:00.71,Default,,0,0,0,,Мен бұрын да осындай бірдеңені айтқан сияқтымын.
Dialogue: 0,0:10:03.84,0:10:05.38,Default,,0,0,0,,Ақыры күлдім. Мен қобалжыдым.
Dialogue: 0,0:10:06.17,0:10:10.05,Default,,0,0,0,,Жоқ, мен таң қалдым, себебі бұл кенеттен болды.
Dialogue: 0,0:10:19.06,0:10:21.69,Default,,0,0,0,,Эй...эй, бұл саңылау тым терең емес.
Dialogue: 0,0:10:21.94,0:10:23.85,Default,,0,0,0,,Бұл менің туған күнімді ұмытқаным үшін жаза.
Dialogue: 0,0:10:24.52,0:10:25.56,Default,,0,0,0,,Алиса
Dialogue: 0,0:10:27.61,0:10:31.40,Default,,0,0,0,,Мен сені кешке осылай киініп келуге рұқсат етемін, Мисаки.
Dialogue: 0,0:10:33.95,0:10:35.07,Default,,0,0,0,,Эден мектебіне қабылдау нәтижелері
Dialogue: 0,0:10:36.33,0:10:37.37,Default,,0,0,0,,Біраз
Dialogue: 0,0:10:38.91,0:10:39.66,Default,,0,0,0,,Сізге жақсы көрінеді
Dialogue: 0,0:10:40.54,0:10:41.83,Default,,0,0,0,,Алиса да.
Dialogue: 0,0:10:44.71,0:10:45.38,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:10:45.84,0:10:50.38,Default,,0,0,0,,Ван Сяотанның қызы мен елордалық полиция бөлімінің бастығы бірге.
Dialogue: 0,0:11:13.11,0:11:13.95,Default,,0,0,0,,Мен бір қолымда оқпен жүктелген винтовка ұстап тұрмын
Dialogue: 0,0:11:14.70,0:11:16.20,Default,,0,0,0,,Темекіні тастау.
Dialogue: 0,0:11:17.78,0:11:19.49,Default,,0,0,0,,Бұл сіздің шаруаңыз емес.
Dialogue: 0,0:11:19.79,0:11:21.83,Default,,0,0,0,,Иә, біз сыныптаспыз.
Dialogue: 0,0:11:25.75,0:11:27.08,Default,,0,0,0,,Сіз мені мұны істеуге мәжбүр еттіңіз.
Dialogue: 0,0:11:27.79,0:11:28.71,Default,,0,0,0,,Мұнда не істеп жүрсің өзің?
Dialogue: 0,0:11:29.09,0:11:32.30,Default,,0,0,0,,Мені таппай жақсы жұмыс жасамасаң,
Dialogue: 0,0:11:32.51,0:11:34.26,Default,,0,0,0,,Не істегеніңіз маңызды емес.
Dialogue: 0,0:11:34.38,0:11:35.22,Default,,0,0,0,,Канами
Dialogue: 0,0:11:35.55,0:11:36.55,Default,,0,0,0,,Төраға осылай айтып отыр, мені жалғыз қалдырмайды.
Dialogue: 0,0:11:36.55,0:11:38.97,Default,,0,0,0,,Төраға осылай айтып отыр, мені жалғыз қалдырмайды.
Dialogue: 0,0:11:41.81,0:11:42.81,Default,,0,0,0,,Оны қайтарыңыз
Dialogue: 0,0:11:43.23,0:11:44.14,Default,,0,0,0,,Қайтарылмады
Dialogue: 0,0:11:44.44,0:11:46.60,Default,,0,0,0,,Менің кім екенімді білесің бе?
Dialogue: 0,0:11:46.98,0:11:48.31,Default,,0,0,0,,Алиса Ванг, солай ма?
Dialogue: 0,0:11:48.61,0:11:49.69,Default,,0,0,0,,Оны жібермеуім керек еді....
Dialogue: 0,0:11:49.94,0:11:51.19,Default,,0,0,0,,Менің әкем...
Dialogue: 0,0:11:51.40,0:11:53.19,Default,,0,0,0,,Әке маңызды емес.
Dialogue: 0,0:11:55.82,0:11:58.74,Default,,0,0,0,,Темекі шегетін ересек адам сияқты әрекет еткісі келетін бала ма?
Dialogue: 0,0:11:58.83,0:12:02.24,Default,,0,0,0,,Әлсіз адамдар ғана бір нәрсеге тәуелді болмай өмір сүре алмайды.
Dialogue: 0,0:12:02.70,0:12:05.91,Default,,0,0,0,,Иә, бұл жақсы.
Dialogue: 0,0:12:06.21,0:12:09.59,Default,,0,0,0,,Менің қандай адам болғаным маңызды емес.
Dialogue: 0,0:12:09.79,0:12:10.50,Default,,0,0,0,,Иә
Dialogue: 0,0:12:11.71,0:12:14.09,Default,,0,0,0,,Сіз менің қасымда отырсыз.
Dialogue: 0,0:12:14.34,0:12:16.84,Default,,0,0,0,,Темекі иісі
Dialogue: 0,0:12:17.68,0:12:18.30,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:12:34.40,0:12:36.53,Default,,0,0,0,,Не болды, жас ханым?
Dialogue: 0,0:12:36.74,0:12:37.57,Default,,0,0,0,,Бөлек
Dialogue: 0,0:12:43.83,0:12:44.87,Default,,0,0,0,,Біртүрлі жігіт
Dialogue: 0,0:13:09.02,0:13:11.77,Default,,0,0,0,,Туған күніңмен, жас ханым
Dialogue: 0,0:13:12.86,0:13:13.77,Default,,0,0,0,,Рахмет
Dialogue: 0,0:13:16.95,0:13:19.20,Default,,0,0,0,,Құттықтаймын, жас ханым.
Dialogue: 0,0:13:19.57,0:13:20.49,Default,,0,0,0,,Рахмет
Dialogue: 0,0:13:21.74,0:13:23.91,Default,,0,0,0,,Кел, мен сені әкеммен таныстырамын.
Dialogue: 0,0:13:28.87,0:13:30.46,Default,,0,0,0,,Бұл Мисаки Кирихара.
Dialogue: 0,0:13:31.63,0:13:32.46,Default,,0,0,0,,Бұл Ван Сяотань. Qipao сізге керемет көрінеді.
Dialogue: 0,0:13:36.46,0:13:37.38,Default,,0,0,0,,Qipao
Dialogue: 0,0:13:37.97,0:13:39.51,Default,,0,0,0,,Қытай киімі туралы
Dialogue: 0,0:13:40.76,0:13:42.34,Default,,0,0,0,,Ах, рақмет.
Dialogue: 0,0:13:43.72,0:13:48.85,Default,,0,0,0,,Мен сізді жақсы естимін. Алиса жақсы достармен бата алған сияқты.
Dialogue: 0,0:13:49.02,0:13:50.48,Default,,0,0,0,,Оң қолымен теңдеулерді шешіп отыр
Dialogue: 0,0:13:50.77,0:13:53.90,Default,,0,0,0,,Әкеңізге де жақсы тілектеріңізді білдіріңіз.
Dialogue: 0,0:13:54.40,0:13:55.94,Default,,0,0,0,,Бүгінгі күн сізге ұнады деп үміттенемін.
Dialogue: 0,0:13:56.28,0:13:57.32,Default,,0,0,0,,Рахмет
Dialogue: 0,0:14:01.41,0:14:05.24,Default,,0,0,0,,Мазасыздай көрінетін итті беру туралы не ойлайсыз?
Dialogue: 0,0:14:06.20,0:14:08.45,Default,,0,0,0,,Ол қымбатты дос
Dialogue: 0,0:14:08.66,0:14:09.58,Default,,0,0,0,,Тағдырымыз өріліп-үйлессін
Dialogue: 0,0:14:09.83,0:14:12.33,Default,,0,0,0,,Хмм, бұл қалай көрінеді?
Dialogue: 0,0:14:12.67,0:14:16.17,Default,,0,0,0,,Жапондар ципао киеді, сен батыстың киімін киесің бе?
Dialogue: 0,0:14:17.55,0:14:18.17,Default,,0,0,0,,Бұл сізге жарасады, солай емес пе?
Dialogue: 0,0:14:19.80,0:14:20.92,Default,,0,0,0,,Бөртпе
Dialogue: 0,0:14:21.34,0:14:26.56,Default,,0,0,0,,Полиция туралы айтсам, олар иіскеп жатыр, абай болыңыз.
Dialogue: 0,0:14:26.89,0:14:28.27,Default,,0,0,0,,Әкесі
Dialogue: 0,0:14:31.98,0:14:33.35,Default,,0,0,0,,Мен бір рет көтерілемін
Dialogue: 0,0:14:49.91,0:14:51.87,Default,,0,0,0,,Сіз сусын алғыңыз келе ме?
Dialogue: 0,0:14:53.17,0:14:54.21,Default,,0,0,0,,Сайто
Dialogue: 0,0:14:54.96,0:14:55.83,Default,,0,0,0,,Сіз сәтті кірдіңіз, бастық.
Dialogue: 0,0:14:58.26,0:14:59.42,Default,,0,0,0,,Бұл қалай болады
Dialogue: 0,0:14:59.92,0:15:03.76,Default,,0,0,0,,Дегенмен, бұл тым арандатушылық сияқты емес пе?
Dialogue: 0,0:15:04.05,0:15:05.89,Default,,0,0,0,,Ой... шулы
Dialogue: 0,0:15:07.72,0:15:08.26,Default,,0,0,0,,Ол неге ұқсайды?
Dialogue: 0,0:15:08.89,0:15:13.56,Default,,0,0,0,,Олар басшыларды кім өлтіріп жатқанын білмейтін сияқты.
Dialogue: 0,0:15:14.06,0:15:18.07,Default,,0,0,0,,Бүгін де ресми түрде қызымның туған күні болуы керек.
Dialogue: 0,0:15:18.69,0:15:21.49,Default,,0,0,0,,Шындығында бұл атқарушының шұғыл жиналысы сияқты.
Dialogue: 0,0:15:22.20,0:15:24.66,Default,,0,0,0,,Сіз осы уақытта басшыларды жинадыңыз ба?
Dialogue: 0,0:15:24.86,0:15:26.78,Default,,0,0,0,,Мен сіздің адалдығыңызды сынап жатырмын.
Dialogue: 0,0:15:27.20,0:15:31.12,Default,,0,0,0,,Егер сіз соншалықты қорқатын болсаңыз, сіз басшы болуға жарамайсыз.
Dialogue: 0,0:15:34.83,0:15:36.21,Default,,0,0,0,,Қ-не?
Dialogue: 0,0:15:39.63,0:15:42.09,Default,,0,0,0,,Ли Кун?
Dialogue: 0,0:15:42.51,0:15:45.51,Default,,0,0,0,,Ол осындай денемен таңғажайып тамақтанады.
Dialogue: 0,0:15:45.84,0:15:48.72,Default,,0,0,0,,Мен өзімді сараң немесе басқаша деп айта алмаймын.
Dialogue: 0,0:15:49.01,0:15:50.26,Default,,0,0,0,,Тағы да сен бе?
Dialogue: 0,0:15:50.52,0:15:50.97,Default,,0,0,0,,Сондай-ақ
Dialogue: 0,0:15:51.43,0:15:52.35,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:15:52.60,0:15:56.35,Default,,0,0,0,,Жетеді, артындағы ыдыстарды жу.
Dialogue: 0,0:15:56.65,0:15:57.35,Default,,0,0,0,,Иә
Dialogue: 0,0:16:00.03,0:16:02.90,Default,,0,0,0,,Сонымен...не істеп жатырсың, Сайто?
Dialogue: 0,0:16:03.24,0:16:06.03,Default,,0,0,0,,Сіз жұмыста біреуді алдыңыз ба? Бұл жақсы жағдай.
Dialogue: 0,0:16:06.24,0:16:07.74,Default,,0,0,0,,Бұл олай емес.
Dialogue: 0,0:16:08.03,0:16:10.66,Default,,0,0,0,,Сіз де ыдыс жудыңыз.
Dialogue: 0,0:16:13.91,0:16:18.00,Default,,0,0,0,,Сайто...сен өз аты-жөніңмен кіріп жүрсің бе, ақымақ?
Dialogue: 0,0:16:37.44,0:16:39.94,Default,,0,0,0,,Е, Ли Кун, сен сонда бардың ба?
Dialogue: 0,0:16:40.36,0:16:40.81,Default,,0,0,0,,Иә
Dialogue: 0,0:16:41.94,0:16:46.03,Default,,0,0,0,,Мен жай ғана бұрылдым, бірақ мені қорқынышты адамдар қоршап алды.
Dialogue: 0,0:16:46.40,0:16:48.78,Default,,0,0,0,,Мен оны үйге тірі жеткізбеймін деп ойладым.
Dialogue: 0,0:16:49.16,0:16:53.74,Default,,0,0,0,,Хахахаха, әлгі лифтке тым жақын келгенің үшін сен кінәлісің.
Dialogue: 0,0:16:54.20,0:16:55.83,Default,,0,0,0,,Бұл тікелей жоғарғы қабатқа шығады.
Dialogue: 0,0:16:56.12,0:16:59.17,Default,,0,0,0,,Бұл қонақүйдің иесі мен оның қызы ғана мінеді.
Dialogue: 0,0:16:59.67,0:17:02.55,Default,,0,0,0,,Өте қатаң қауіпсіздік арқасында.
Dialogue: 0,0:17:03.67,0:17:06.67,Default,,0,0,0,,Эй, Сайто мырза, сіз өте білімдісіз.
Dialogue: 0,0:17:07.72,0:17:09.18,Default,,0,0,0,,Жоқ, сәл ғана...
Dialogue: 0,0:17:10.43,0:17:13.01,Default,,0,0,0,,Қанша жусам да кетпейді...ыдыс
Dialogue: 0,0:17:13.56,0:17:14.52,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:17:15.43,0:17:19.40,Default,,0,0,0,,...Міне, бастық, бұл жай ғана сөйлесу үшін істеген.
Dialogue: 0,0:17:19.90,0:17:21.23,Default,,0,0,0,,Сіз бір-біріңізді танисыз ба?
Dialogue: 0,0:17:21.57,0:17:21.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:22.40,0:17:24.48,Default,,0,0,0,,Бұл қытай көйлегін киген әйел.
Dialogue: 0,0:17:25.11,0:17:25.90,Default,,0,0,0,,О
Dialogue: 0,0:17:26.36,0:17:28.07,Default,,0,0,0,,Олар таныс сияқты.
Dialogue: 0,0:17:28.91,0:17:29.78,Default,,0,0,0,,Аз ғана.
Dialogue: 0,0:17:30.28,0:17:31.20,Default,,0,0,0,,Ол әдемі еді.
Dialogue: 0,0:17:31.62,0:17:34.99,Default,,0,0,0,,Жоқ, жоқ, көзқарас алдамшы.
Dialogue: 0,0:17:35.29,0:17:38.29,Default,,0,0,0,,Ол кісі өте қорқынышты.
Dialogue: 0,0:17:39.04,0:17:41.17,Default,,0,0,0,,Иә, солай ма?
Dialogue: 0,0:17:41.33,0:17:42.17,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:17:47.34,0:17:47.72,Default,,0,0,0,,Иә.
Dialogue: 0,0:18:24.13,0:18:25.50,Default,,0,0,0,,Бұл атқарушы орган ба?
Dialogue: 0,0:18:25.84,0:18:26.88,Default,,0,0,0,,Онда жақсылық жоқ
Dialogue: 0,0:18:27.38,0:18:31.80,Default,,0,0,0,,Мисаки қанша істесе де, мен оны сол бөлмеге жақындата алмаймын.
Dialogue: 0,0:18:33.60,0:18:36.18,Default,,0,0,0,,Оның орнына мен сізге ақпарат беремін.
Dialogue: 0,0:18:37.68,0:18:39.68,Default,,0,0,0,,Бұл да бір бөлек.
Dialogue: 0,0:18:40.31,0:18:40.85,Default,,0,0,0,,Менің білгім келмейді
Dialogue: 0,0:18:41.64,0:18:44.06,Default,,0,0,0,,VI-952 сәйкестендіру
Dialogue: 0,0:18:56.12,0:18:57.70,Default,,0,0,0,,Күзетші жоқ
Dialogue: 0,0:19:42.79,0:19:43.50,Default,,0,0,0,,Тас
Dialogue: 0,0:19:44.08,0:19:46.00,Default,,0,0,0,,Иә тас гүл
Dialogue: 0,0:19:46.84,0:19:50.76,Default,,0,0,0,,Бірақ бұл артефакт емес, ол дұрыс өсіп жатыр.
Dialogue: 0,0:19:51.01,0:19:51.92,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:19:52.55,0:19:55.63,Default,,0,0,0,,Иә, бұл қақпадан ағып кету.
Dialogue: 0,0:19:56.05,0:20:02.10,Default,,0,0,0,,Осы тас гүлдің балшырынында өскен аралардың денесінде ерекше заттар түзіледі.
Dialogue: 0,0:20:13.61,0:20:14.70,Default,,0,0,0,,Алиса
Dialogue: 0,0:20:14.78,0:20:18.24,Default,,0,0,0,,Енді қайғы мен қайғы жоғалады
Dialogue: 0,0:20:19.37,0:20:23.37,Default,,0,0,0,,Керемет нұрға толы менің әлемім басталады
Dialogue: 0,0:20:23.87,0:20:25.00,Default,,0,0,0,,Мисаки де мұны істемейді.
Dialogue: 0,0:20:26.63,0:20:27.33,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:20:46.85,0:20:49.06,Default,,0,0,0,,Вэй Боссқа не болды?
Dialogue: 0,0:20:49.56,0:20:51.77,Default,,0,0,0,,Уақыт өтіп кетті ғой, солай емес пе?
Dialogue: 0,0:20:52.53,0:20:55.69,Default,,0,0,0,,Оның үстіне мен ұлымды көре алмаймын.
Dialogue: 0,0:20:57.03,0:20:59.37,Default,,0,0,0,,Неге күлесің? Вэй Цишун
Dialogue: 0,0:21:01.28,0:21:03.74,Default,,0,0,0,,Ван Сяотань болса, мен енді келе алмаймын.
Dialogue: 0,0:21:03.83,0:21:04.50,Default,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:21:04.83,0:21:08.00,Default,,0,0,0,,Цинлунтан жаңа дәуірге қадам басты
Dialogue: 0,0:21:08.38,0:21:09.92,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:21:20.60,0:21:21.72,Default,,0,0,0,,Бұл жара
Dialogue: 0,0:21:22.31,0:21:23.35,Default,,0,0,0,,Вэй мұны жасады
Dialogue: 0,0:21:25.14,0:21:29.23,Default,,0,0,0,,Бұл Вэй Цишун, VI-952.
Dialogue: 0,0:21:41.20,0:21:42.62,Default,,0,0,0,,Алиса, сен...
Dialogue: 0,0:21:43.08,0:21:44.74,Default,,0,0,0,,Қош бол Мисаки
Dialogue: 0,0:21:48.08,0:21:49.08,Default,,0,0,0,,Мен күте тұр дедім ғой, иә?
Dialogue: 0,0:21:55.38,0:21:56.67,Default,,0,0,0,,Мисаки
Dialogue: 0,0:22:05.72,0:22:07.27,Default,,0,0,0,,А... сәлем
Dialogue: 0,0:23:40.99,0:23:42.74,Default,,0,0,0,,Сатқындық сатқындықты тудырады
Dialogue: 0,0:23:43.03,0:23:44.99,Default,,0,0,0,,Қан көбірек қан іздейді
Dialogue: 0,0:23:45.37,0:23:47.87,Default,,0,0,0,,Артында қалған ойлардың баспанасы жоқ
Dialogue: 0,0:23:48.41,0:23:51.12,Default,,0,0,0,,Қалау мен үмітсіздік арасында бұралған
Dialogue: 0,0:23:52.04,0:23:54.54,Default,,0,0,0,,Бұл шынымен де сатқындық болды ма?
Dialogue: 0,0:23:55.33,0:23:57.67,Default,,0,0,0,,Жауапсыз сұрақтар мені тесіп өтеді
Dialogue: 0,0:23:58.05,0:24:00.09,Default,,0,0,0,,Жазықсыз жүрек қанға боялады
Dialogue: 0,0:24:01.09,0:24:03.01,Default,,0,0,0,,Мен олай айтқым келген жоқ.
Dialogue: 0,0:24:03.59,0:24:07.51,Default,,0,0,0,,Қыздың арманы лайда шіриді
