Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.35,0:00:07.40,Default,,0,0,0,,Бір жерге ауылға шегініп, балық аулауды ойлап жүрмін.
Dialogue: 0,0:00:07.52,0:00:08.19,Default,,0,0,0,,Балық аулау?
Dialogue: 0,0:00:08.82,0:00:10.90,Default,,0,0,0,,Мен ол жерге жиі баратынмын.
Dialogue: 0,0:00:11.03,0:00:12.90,Default,,0,0,0,,Мен шпательге маманданамын.
Dialogue: 0,0:00:13.20,0:00:15.32,Default,,0,0,0,,Шөпті тұқы тәрізді мұздары бар.
Dialogue: 0,0:00:15.36,0:00:16.03,Default,,0,0,0,,Шулы
Dialogue: 0,0:00:16.99,0:00:20.83,Default,,0,0,0,,Ағып жатқан суға қарасам, уақытты ұмытамын.
Dialogue: 0,0:00:20.91,0:00:26.12,Default,,0,0,0,,Міне, біздің өміріміз өзеннен ағып жатқан жапырақтар сияқты.
Dialogue: 0,0:00:27.42,0:00:29.34,Default,,0,0,0,,Эй, сен жақсы нәрсе айттың.
Dialogue: 0,0:00:29.42,0:00:30.34,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:00:35.47,0:00:38.55,Default,,0,0,0,,Иә? Не? Сіз от жаға аласыз ба?
Dialogue: 0,0:00:40.97,0:00:42.06,Default,,0,0,0,,Ең алдымен, сен—
Dialogue: 0,0:00:42.72,0:00:44.14,Default,,0,0,0,,Темекіні тастау
Dialogue: 0,0:00:44.73,0:00:46.73,Default,,0,0,0,,Сіз тым ұялшақсыз
Dialogue: 0,0:00:50.82,0:00:51.65,Default,,0,0,0,,Ой
Dialogue: 0,0:01:01.54,0:01:02.54,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:01:09.50,0:01:12.63,Default,,0,0,0,,Нысана әлі күнге дейін Қошу тас жолымен шығысқа қарай жылжиды
Dialogue: 0,0:01:16.84,0:01:18.63,Default,,0,0,0,,Байқаған кезде қорғаныс сұраңыз
Dialogue: 0,0:01:19.26,0:01:21.14,Default,,0,0,0,,Мені мұқият бақылаңыз
Dialogue: 0,0:01:22.10,0:01:25.81,Default,,0,0,0,,Міне, ақыры басталды.
Dialogue: 0,0:01:26.18,0:01:28.39,Default,,0,0,0,,Ҳ? Не айтпақшысың?
Dialogue: 0,0:01:28.69,0:01:31.52,Default,,0,0,0,,Аяқтаудың басы
Dialogue: 0,0:01:36.45,0:01:39.36,Default,,0,0,0,,Бұл Кирихара, 4-ші сыртқы істер бөлімі, қоғамдық қауіпсіздік департаменті.
Dialogue: 0,0:01:39.66,0:01:42.07,Default,,0,0,0,,Мен доктор Роберт Шрейдермен танысқым келеді.
Dialogue: 0,0:01:42.78,0:01:43.70,Default,,0,0,0,,Уәде
Dialogue: 0,0:01:44.16,0:01:45.04,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:01:45.95,0:01:47.04,Default,,0,0,0,,Мен ешкімге оның мағынасыз өлім болғанын айтуға жол бермеймін
Dialogue: 0,0:01:51.13,0:01:52.63,Default,,0,0,0,,Мен сені кездестіретін сияқтымын.
Dialogue: 0,0:02:01.60,0:02:02.43,Default,,0,0,0,,Бұл да
Dialogue: 0,0:02:02.85,0:02:04.06,Default,,0,0,0,,Мен саған қамқор боламын
Dialogue: 0,0:02:07.85,0:02:08.89,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:02:11.15,0:02:13.52,Default,,0,0,0,,Қош келдіңіз суперинтендент Кирихара
Dialogue: 0,0:02:16.11,0:02:19.78,Default,,0,0,0,,Мен доктор Шредермен кездесуді өтінуім керек еді.
Dialogue: 0,0:02:20.20,0:02:23.70,Default,,0,0,0,,Жеке мен екеуміз ғана бақытты болар едім.
Dialogue: 0,0:02:24.12,0:02:26.29,Default,,0,0,0,,Мына кісі талап қояды
Dialogue: 0,0:02:26.91,0:02:31.08,Default,,0,0,0,,Мен әрқашан сенімен сөйлескім келді.
Dialogue: 0,0:02:31.42,0:02:32.96,Default,,0,0,0,,Өкінішке орай, уақытым жоқ
Dialogue: 0,0:02:33.09,0:02:34.92,Default,,0,0,0,,Тез түсіндіріп берейін.
Dialogue: 0,0:02:35.59,0:02:36.80,Default,,0,0,0,,Отырыңыз.
Dialogue: 0,0:02:39.80,0:02:43.89,Default,,0,0,0,,Осыдан бес жыл бұрын Оңтүстік Америкада физикалық қол сұғылмайтын аймақтың құрылуына байланысты,
Dialogue: 0,0:02:44.22,0:02:48.47,Default,,0,0,0,,Біз адамдар, Аспан қақпасына кіру жолын мәңгілікке жоғалттық.
Dialogue: 0,0:02:49.14,0:02:51.89,Default,,0,0,0,,Кең кеңістік және жүздеген миллион адамдар
Dialogue: 0,0:02:52.94,0:02:57.07,Default,,0,0,0,,БК-201 сол жағдайды жасады.
Dialogue: 0,0:02:57.44,0:03:00.95,Default,,0,0,0,,Ол неліктен Оңтүстік Америкадағы қайғылы оқиғаға себепкер болды?
Dialogue: 0,0:03:01.07,0:03:02.70,Default,,0,0,0,,Ол? Жоқ, бұл дұрыс емес.
Dialogue: 0,0:03:03.07,0:03:09.54,Default,,0,0,0,,Мессье коды BK-201 сол кезде басқа әйелді көрсетуі керек еді.
Dialogue: 0,0:03:09.87,0:03:11.04,Default,,0,0,0,,Бұл не? !
Dialogue: 0,0:03:11.50,0:03:15.25,Default,,0,0,0,,Өткен оқиғаларды емес, қазіргі жағдайды түсінгеніңізді қалаймын.
Dialogue: 0,0:03:15.46,0:03:21.05,Default,,0,0,0,,EPR қазір Оңтүстік Америкада дәл осындай құбылысты Токиода тудыруға тырысуда.
Dialogue: 0,0:03:22.63,0:03:24.97,Default,,0,0,0,,Бұл ақпарат қайдан алынды?
Dialogue: 0,0:03:25.47,0:03:28.26,Default,,0,0,0,,Біз олармен мәңгі күресіп келеміз
Dialogue: 0,0:03:28.52,0:03:30.02,Default,,0,0,0,,Білмейтін жол жоқ
Dialogue: 0,0:03:31.06,0:03:34.48,Default,,0,0,0,,Токиодағы жарылыс Біз оны осылай атаймыз
Dialogue: 0,0:03:35.61,0:03:38.65,Default,,0,0,0,,Егер жарылыс Оңтүстік Америкадағыдай масштабта болса
Dialogue: 0,0:03:39.11,0:03:41.99,Default,,0,0,0,,Бүкіл жапон архипелагы қол сұғылмайтын аумаққа жұтылды.
Dialogue: 0,0:03:42.40,0:03:45.32,Default,,0,0,0,,Бар болмыс жұқа ауада жоғалады
Dialogue: 0,0:03:46.49,0:03:48.16,Default,,0,0,0,,Бірақ уайымдамаңыз
Dialogue: 0,0:03:48.49,0:03:50.29,Default,,0,0,0,,Біз бұған жол бермейміз
Dialogue: 0,0:03:51.04,0:03:52.75,Default,,0,0,0,,«Фусегу» сөзін қалай айтасыз?
Dialogue: 0,0:03:53.08,0:03:55.88,Default,,0,0,0,,Біз тозақ қақпасын жойамыз.
Dialogue: 0,0:03:56.42,0:03:58.42,Default,,0,0,0,,Бұл мүмкін бе?
Dialogue: 0,0:03:58.75,0:03:59.55,Default,,0,0,0,,Әрине
Dialogue: 0,0:04:00.09,0:04:02.05,Default,,0,0,0,,Денсаулық ойынын қоршап тұрған қабырға
Dialogue: 0,0:04:02.38,0:04:05.26,Default,,0,0,0,,Зиянкестердің алдын алу үшін ғана емес
Dialogue: 0,0:04:05.93,0:04:09.35,Default,,0,0,0,,Бұл бір нәрсені қорғайтын берік қамал.
Dialogue: 0,0:04:12.31,0:04:13.10,Default,,0,0,0,,Бұл...
Dialogue: 0,0:04:13.52,0:04:15.27,Default,,0,0,0,,Сатурн жүйесі
Dialogue: 0,0:04:19.36,0:04:23.86,Default,,0,0,0,,Менеджер қауіпті нәрсемен айналысуы керек.
Dialogue: 0,0:04:30.04,0:04:31.37,Default,,0,0,0,,Мен менеджерге сенемін!
Dialogue: 0,0:04:32.08,0:04:34.29,Default,,0,0,0,,Жақсы деймін, артымнан жүр.
Dialogue: 0,0:04:37.21,0:04:37.71,Default,,0,0,0,,Иә
Dialogue: 0,0:04:38.13,0:04:39.21,Default,,0,0,0,,Ах, Мацумото-сан.
Dialogue: 0,0:04:40.05,0:04:42.55,Default,,0,0,0,,Иә, Коно да менімен бірге.
Dialogue: 0,0:04:43.05,0:04:43.51,Default,,0,0,0,,Иә
Dialogue: 0,0:04:45.26,0:04:46.30,Default,,0,0,0,,Бұл не? ?
Dialogue: 0,0:04:47.26,0:04:48.89,Default,,0,0,0,,Коно Пандораға барайық!
Dialogue: 0,0:04:49.51,0:04:50.22,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:04:50.68,0:04:52.22,Default,,0,0,0,,Менеджер сонда.
Dialogue: 0,0:04:52.97,0:04:53.81,Default,,0,0,0,,Есептік жазбаны осында қоямын.
Dialogue: 0,0:04:53.81,0:04:54.73,Default,,0,0,0,,Омайдо
Dialogue: 0,0:04:59.23,0:05:01.90,Default,,0,0,0,,Ей, не болып жатыр?
Dialogue: 0,0:05:02.53,0:05:05.90,Default,,0,0,0,,Үлкен қара дақ пайда болғаннан кейін 45-ші күні пайда болады.
Dialogue: 0,0:05:05.99,0:05:09.16,Default,,0,0,0,,Ауданды ұлғайтудың соңғы кезеңіне жақындау
Dialogue: 0,0:05:09.16,0:05:12.03,Default,,0,0,0,,Бұл күйді шамамен 30 минут ұстаңыз
Dialogue: 0,0:05:12.58,0:05:14.29,Default,,0,0,0,,Сол 30 минут ішінде
Dialogue: 0,0:05:14.58,0:05:18.58,Default,,0,0,0,,Сатурн сақинасы тудыратын және үдететін анти-қақпа бөлшектері
Dialogue: 0,0:05:18.63,0:05:21.42,Default,,0,0,0,,Тозақ қақпасының өзегіне оқ атсаң
Dialogue: 0,0:05:21.84,0:05:23.67,Default,,0,0,0,,Гейтс жойылды
Dialogue: 0,0:05:24.30,0:05:28.80,Default,,0,0,0,,Айтпақшы, BK-201 Токиодағы жарылысты да тудыруы мүмкін.
Dialogue: 0,0:05:28.80,0:05:31.10,Default,,0,0,0,,осы соңғы кезеңмен шектеледі
Dialogue: 0,0:05:32.26,0:05:36.73,Default,,0,0,0,,Бұл біз Оңтүстік Америкада алған үлкен білім мен сабақтардың бірі.
Dialogue: 0,0:05:36.98,0:05:38.27,Default,,0,0,0,,Қызық, солай ма?
Dialogue: 0,0:05:38.44,0:05:44.44,Default,,0,0,0,,Соңғы 30 минут ішінде адамдар мен мердігерлер арасындағы шайқас болды.
Dialogue: 0,0:05:45.11,0:05:49.24,Default,,0,0,0,,Ғасыр сәтіне 5 сағат 27 минут қалды
Dialogue: 0,0:05:51.20,0:05:51.74,Default,,0,0,0,,Не болды?
Dialogue: 0,0:05:52.37,0:05:55.74,Default,,0,0,0,,Арнайы күштер Хонмачи 2-чоме, Кита-куда соғысу жағдайына кірді.
Dialogue: 0,0:05:56.20,0:05:57.00,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:05:57.54,0:05:59.50,Default,,0,0,0,,О, бұл тек бастамасы ғана.
Dialogue: 0,0:06:00.00,0:06:01.00,Default,,0,0,0,,Шын жүректен осылай сезінемін
Dialogue: 0,0:06:18.14,0:06:20.19,Default,,0,0,0,,асықты асығыс
Dialogue: 0,0:06:20.60,0:06:25.02,Default,,0,0,0,,Жұлдыздар, жарқырап, жылаңыз
Dialogue: 0,0:06:25.36,0:06:27.40,Default,,0,0,0,,Ағып кету, жоғалу
Dialogue: 0,0:06:30.07,0:06:31.36,Default,,0,0,0,,Көп адамдар түсінбейді
Dialogue: 0,0:06:31.62,0:06:32.95,Default,,0,0,0,,Нақты есеп беріңіз!
Dialogue: 0,0:06:33.16,0:06:35.37,Default,,0,0,0,,Бұл санау мүмкін емес!
Dialogue: 0,0:06:35.83,0:06:36.12,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:06:37.87,0:06:39.04,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:06:43.21,0:06:45.21,Default,,0,0,0,,Астрономиялық бөлімнің деректері сыртқы ма?
Dialogue: 0,0:06:45.59,0:06:48.17,Default,,0,0,0,,Ол нақты уақытта ағып жатыр
Dialogue: 0,0:06:58.10,0:07:00.23,Default,,0,0,0,,Түсіндім, бұрын естігенмін.
Dialogue: 0,0:07:00.52,0:07:04.86,Default,,0,0,0,,Ресми түрде жоқ метро бар.
Dialogue: 0,0:07:05.36,0:07:07.86,Default,,0,0,0,,Қақпаның пайда болуынан туындаған шатасуға байланысты
Dialogue: 0,0:07:07.98,0:07:10.86,Default,,0,0,0,,Осыған қатысты материалдар да жоғалған
Dialogue: 0,0:07:11.24,0:07:13.16,Default,,0,0,0,,Қазір күзетсіз
Dialogue: 0,0:07:14.70,0:07:16.58,Default,,0,0,0,,Әй, жүресің бе?
Dialogue: 0,0:07:16.87,0:07:18.74,Default,,0,0,0,,Электр қуаты өшірілген
Dialogue: 0,0:07:18.83,0:07:23.33,Default,,0,0,0,,Екінші жағынан, тіпті полицияның бақылаушы рухтары да басып кіре алмайды.
Dialogue: 0,0:07:25.46,0:07:26.04,Default,,0,0,0,,Күміс
Dialogue: 0,0:07:28.42,0:07:29.25,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:07:52.95,0:07:57.74,Default,,0,0,0,,Жоқ, қоғамдық қауіпсіздік болсын, басқасы болсын, бұл жерден өте алмайтын жер бар.
Dialogue: 0,0:07:58.08,0:07:58.78,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:07:59.33,0:08:03.46,Default,,0,0,0,,Сайто мырза, бас кеңсеге оралғанымыз дұрыс емес пе?
Dialogue: 0,0:08:03.75,0:08:05.79,Default,,0,0,0,,Қалай қарасаң да мердігерге қатысты...
Dialogue: 0,0:08:05.79,0:08:06.83,Default,,0,0,0,,Күту режимінде екеніңізді естідім.
Dialogue: 0,0:08:06.84,0:08:07.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:07.71,0:08:09.55,Default,,0,0,0,,Сіз жаңа ғана телефон соғу туралы болды.
Dialogue: 0,0:08:09.75,0:08:11.80,Default,,0,0,0,,Бізге күту бұйырылды.
Dialogue: 0,0:08:12.26,0:08:14.97,Default,,0,0,0,,Егер сіз бас кеңсеге қайта барсаңыз, олар сізді бөлмеңізден шығармайды.
Dialogue: 0,0:08:15.43,0:08:16.18,Default,,0,0,0,,Не? ол
Dialogue: 0,0:08:16.34,0:08:16.84,Default,,0,0,0,,біз қайта орала аламыз.
Dialogue: 0,0:08:17.10,0:08:20.22,Default,,0,0,0,,Бұл жағдайда мұндай ақымақ тәртіп бар ма?
Dialogue: 0,0:08:20.52,0:08:22.52,Default,,0,0,0,,Жоғарыдағы адамдар не ойлайды?
Dialogue: 0,0:08:23.10,0:08:25.73,Default,,0,0,0,,Жарқыраған, жылтыр
Dialogue: 0,0:08:26.06,0:08:27.40,Default,,0,0,0,,Құрметті Жұлдыз
Dialogue: 0,0:08:27.98,0:08:34.40,Default,,0,0,0,,Аспан толқынында ұшқындап, Мені сыпырып, қайда барамын?
Dialogue: 0,0:08:34.78,0:08:38.87,Default,,0,0,0,,Мен мұны істемеймін.
Dialogue: 0,0:08:44.54,0:08:45.46,Default,,0,0,0,,Бұл басталды.
Dialogue: 0,0:08:46.25,0:08:46.79,Default,,0,0,0,,Иә
Dialogue: 0,0:08:48.08,0:08:50.21,Default,,0,0,0,,Қалғаны жоспарланғандай болады.
Dialogue: 0,0:08:54.88,0:08:55.67,Default,,0,0,0,,Эмбер ше?
Dialogue: 0,0:08:55.68,0:08:56.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:04.85,0:09:06.31,Default,,0,0,0,,Жұмыртқа бар ма?
Dialogue: 0,0:09:06.94,0:09:07.60,Default,,0,0,0,,Маған беріңіз
Dialogue: 0,0:09:13.23,0:09:15.24,Default,,0,0,0,,Бұл дәл қабырға астында ма?
Dialogue: 0,0:09:15.86,0:09:18.36,Default,,0,0,0,,Олар сізді оңай өткізбейтін сияқты.
Dialogue: 0,0:09:18.78,0:09:19.57,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:09:21.20,0:09:22.33,Default,,0,0,0,,Мұны орындаңыз
Dialogue: 0,0:09:27.46,0:09:28.37,Default,,0,0,0,,Сіз нені айтасыз? !
Dialogue: 0,0:09:28.58,0:09:33.00,Default,,0,0,0,,Менің Эмберге берген уәдем сізге осында басшылық ету.
Dialogue: 0,0:09:33.21,0:09:36.26,Default,,0,0,0,,Одан кейін өзіңізге ұнайтын нәрсені істеу шартымен.
Dialogue: 0,0:09:40.01,0:09:45.56,Default,,0,0,0,,Мен Эмбермен бірге сенімен тағы да төбелесу үшін жұмыс істедім.
Dialogue: 0,0:09:45.85,0:09:49.56,Default,,0,0,0,,Егер мен EPR-да қалсам, сізбен кездесермін деп ойладым.
Dialogue: 0,0:09:50.27,0:09:54.73,Default,,0,0,0,,Бұл билікті алғаннан кейін менің басқа біреуден жеңілуім мүмкін емес еді.
Dialogue: 0,0:09:54.82,0:09:58.24,Default,,0,0,0,,Сіз бұл қорлауды түсінесіз бе?
Dialogue: 0,0:09:58.40,0:09:58.86,Default,,0,0,0,,Жоқ
Dialogue: 0,0:09:59.53,0:10:00.99,Default,,0,0,0,,Мен солай ойлаймын!
Dialogue: 0,0:10:06.96,0:10:08.08,Default,,0,0,0,,Қорлау?
Dialogue: 0,0:10:08.41,0:10:11.75,Default,,0,0,0,,Сіз мердігер болсаңыз да, күлкілі сөздер айтасыз.
Dialogue: 0,0:10:29.85,0:10:34.69,Default,,0,0,0,,Тозақ қақпасы мен Жұмақ қақпасы бір тиынның екі жағы.
Dialogue: 0,0:10:35.90,0:10:39.95,Default,,0,0,0,,Біреуін жойсаң, екіншісін жоя аласың.
Dialogue: 0,0:10:40.91,0:10:44.41,Default,,0,0,0,,Қақпа жоғалып кетсе, мердігерге не болады?
Dialogue: 0,0:10:44.78,0:10:48.50,Default,,0,0,0,,Осы қант сияқты бәрі еріп, жоғалады
Dialogue: 0,0:10:48.79,0:10:51.79,Default,,0,0,0,,Міне! Бұл рас па? Яғни
Dialogue: 0,0:10:52.17,0:10:54.79,Default,,0,0,0,,Рас, мен тәжірибе жасадым.
Dialogue: 0,0:10:54.84,0:10:56.92,Default,,0,0,0,,Ақымақ! Сен ше? !
Dialogue: 0,0:10:57.30,0:11:01.38,Default,,0,0,0,,Тіпті мердігерлер де адам. Олардың бәрі қылмыскер емес!
Dialogue: 0,0:11:01.72,0:11:04.39,Default,,0,0,0,,мыңдаған жазылушыларға арналған
Dialogue: 0,0:11:04.60,0:11:07.47,Default,,0,0,0,,Сіз бізден жүздеген миллион адамдарды құрбан етуді сұрайсыз ба?
Dialogue: 0,0:11:09.68,0:11:12.19,Default,,0,0,0,,Гуманизм туралы айту оңай, бірақ
Dialogue: 0,0:11:12.90,0:11:15.77,Default,,0,0,0,,Шындықты елемеу арқылы қоғамға қауіп төндіру
Dialogue: 0,0:11:15.94,0:11:20.99,Default,,0,0,0,,Бұл полиция қызметкері үшін жарамсыз әрекет деп ойламайсыз ба? Кирихара
Dialogue: 0,0:11:21.53,0:11:22.28,Default,,0,0,0,,Менеджер
Dialogue: 0,0:11:22.91,0:11:26.12,Default,,0,0,0,,Менің қарамағымдағы қызметкер Нишижима мырза менен кешірім сұрады
Dialogue: 0,0:11:26.33,0:11:29.29,Default,,0,0,0,,Жоқ, бұл өте қызықты уақыт болды.
Dialogue: 0,0:11:29.58,0:11:30.83,Default,,0,0,0,,Қалғанын сізге қалдырамын.
Dialogue: 0,0:11:31.29,0:11:33.21,Default,,0,0,0,,Соңғы шеге күтіп тұр
Dialogue: 0,0:11:35.17,0:11:37.13,Default,,0,0,0,,Матана Оджо-чан
Dialogue: 0,0:11:41.67,0:11:46.85,Default,,0,0,0,,Сатурн сақинасын белсендіру біз үшін де қиын шешім.
Dialogue: 0,0:11:47.31,0:11:51.14,Default,,0,0,0,,Сонда сіз де арғы жағында болдыңыз ба?
Dialogue: 0,0:11:53.73,0:11:57.27,Default,,0,0,0,,Pandora – Біріккен Ұлттар Ұйымының Басқару бөлімінің ғылыми-зерттеу институты ғана.
Dialogue: 0,0:11:57.82,0:12:02.69,Default,,0,0,0,,Жүздеген миллион адамдардың өміріне әсер ететін операцияларды өз бетімен орындауға ешкімнің құқы жоқ.
Dialogue: 0,0:12:02.90,0:12:06.37,Default,,0,0,0,,Бұл жерде жасалып жатқан нәрсе билікті бұзу екені анық.
Dialogue: 0,0:12:06.66,0:12:07.57,Default,,0,0,0,,Бұл қылмыс
Dialogue: 0,0:12:08.12,0:12:13.00,Default,,0,0,0,,Ұлы державаның ұлт шеңберінен шығатын ерік-жігері болмаса,
Dialogue: 0,0:12:13.25,0:12:15.46,Default,,0,0,0,,Осы уақытқа дейін оны жасыру мүмкін емес еді.
Dialogue: 0,0:12:16.17,0:12:18.09,Default,,0,0,0,,11 қараша қайда болды?
Dialogue: 0,0:12:18.59,0:12:21.71,Default,,0,0,0,,Бұл зор күшке ие ұйым болды.
Dialogue: 0,0:12:22.34,0:12:24.97,Default,,0,0,0,,Сіз мұны түсінбеуіңіз мүмкін
Dialogue: 0,0:12:25.18,0:12:28.51,Default,,0,0,0,,Сіз ұйымның мүшесісіз.
Dialogue: 0,0:12:28.76,0:12:29.55,Default,,0,0,0,,Мен?
Dialogue: 0,0:12:29.72,0:12:30.47,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:12:31.10,0:12:34.60,Default,,0,0,0,,Әр елдің билігіне, үкіметіне және билік басындағыларға.
Dialogue: 0,0:12:34.60,0:12:36.14,Default,,0,0,0,,Ұйымның қолжетімділігі
Dialogue: 0,0:12:36.65,0:12:38.86,Default,,0,0,0,,Әлемдік тәртіпті қорғау
Dialogue: 0,0:12:39.32,0:12:42.03,Default,,0,0,0,,Мүмкін BK-201 де шығар?
Dialogue: 0,0:12:42.86,0:12:46.53,Default,,0,0,0,,BK-201 Код атауы Эй
Dialogue: 0,0:12:46.86,0:12:48.82,Default,,0,0,0,,Ол да ұйымның мүшесі.
Dialogue: 0,0:12:49.62,0:12:52.37,Default,,0,0,0,,Ол қазір жоғалып кеткенімен.
Dialogue: 0,0:12:52.54,0:12:54.25,Default,,0,0,0,,Жоғалып кетті ме?
Dialogue: 0,0:12:57.71,0:13:00.50,Default,,0,0,0,,Неге енді маған шындықты айттың?
Dialogue: 0,0:13:00.92,0:13:02.92,Default,,0,0,0,,Қараша сияқты...
Dialogue: 0,0:13:03.42,0:13:05.30,Default,,0,0,0,,Өлтіру оңай
Dialogue: 0,0:13:05.43,0:13:09.39,Default,,0,0,0,,Бірақ біз әрқашан талантты адамдарды қалаймыз.
Dialogue: 0,0:13:09.64,0:13:11.30,Default,,0,0,0,,Сіз сияқты
Dialogue: 0,0:13:28.99,0:13:30.07,Default,,0,0,0,,Не болды?
Dialogue: 0,0:13:30.32,0:13:32.87,Default,,0,0,0,,Бұл бәрінен кейін бола ма?
Dialogue: 0,0:13:33.54,0:13:34.58,Default,,0,0,0,,Ұф… сен, кішкентай сорлы.
Dialogue: 0,0:13:35.08,0:13:42.21,Default,,0,0,0,,Егер мен сені өлтіретін болсам, мен саған нұсқау бере алмаймын.
Dialogue: 0,0:13:42.63,0:13:45.88,Default,,0,0,0,,Сіз жеңілетініңізді әу бастан білдіңіз.
Dialogue: 0,0:13:46.55,0:13:51.05,Default,,0,0,0,,Нәтижесін білсем де, төбелеспей тұра алмадым.
Dialogue: 0,0:13:51.35,0:13:54.97,Default,,0,0,0,,Бұл мердігер үшін негізсіз әрекет.
Dialogue: 0,0:13:55.81,0:13:57.39,Default,,0,0,0,,Бұл сенің кінәң
Dialogue: 0,0:13:57.56,0:13:59.23,Default,,0,0,0,,Сізге рахмет
Dialogue: 0,0:14:00.02,0:14:02.31,Default,,0,0,0,,Бұл біртүрлі, сен де.
Dialogue: 0,0:14:02.86,0:14:03.82,Default,,0,0,0,,О
Dialogue: 0,0:14:04.53,0:14:07.07,Default,,0,0,0,,BK-201 өтіңіз
Dialogue: 0,0:14:32.64,0:14:36.85,Default,,0,0,0,,Менің әкем жалғыз болғаны өкінішті.
Dialogue: 0,0:15:00.25,0:15:01.00,Default,,0,0,0,,Күте тұрыңыз
Dialogue: 0,0:15:03.46,0:15:05.21,Default,,0,0,0,,Осындай жерде
Dialogue: 0,0:15:05.67,0:15:08.21,Default,,0,0,0,,Оған көмектесу мүмкін емес, өйткені бұл өтемақы.
Dialogue: 0,0:15:12.93,0:15:14.34,Default,,0,0,0,,Мен оның сол күйінде болғанын қалаймын.
Dialogue: 0,0:15:14.80,0:15:16.18,Default,,0,0,0,,Мен қиындыққа тап болдым
Dialogue: 0,0:15:17.64,0:15:18.52,Default,,0,0,0,,Шинигаминің көздерін алу үшін,
Dialogue: 0,0:15:18.77,0:15:21.43,Default,,0,0,0,,Анау атам осылай жасап жатқан.
Dialogue: 0,0:15:24.06,0:15:25.90,Default,,0,0,0,,Осыны жою мүмкін болса
Dialogue: 0,0:15:45.92,0:15:47.04,Default,,0,0,0,,Кәріптас?
Dialogue: 0,0:15:47.71,0:15:48.59,Default,,0,0,0,,біздің қамқорлығымызға Джудзцу техникалық колледжінде алынады.
Dialogue: 0,0:15:49.46,0:15:50.21,Default,,0,0,0,,Жоқ
Dialogue: 0,0:15:50.88,0:15:53.47,Default,,0,0,0,,Анау атам осылай жасап жатқан.
Dialogue: 0,0:15:59.93,0:16:00.60,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:16:06.73,0:16:08.73,Default,,0,0,0,,Жақсы! сақина бұзылды
Dialogue: 0,0:16:15.45,0:16:17.62,Default,,0,0,0,,Қақпаға қарсы бөлшектер фокусы тоқтады
Dialogue: 0,0:16:17.62,0:16:18.87,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:16:19.24,0:16:23.08,Default,,0,0,0,,Мен үшін не істей аласың? Өмірімнің шедеврі
Dialogue: 0,0:16:30.34,0:16:31.00,Default,,0,0,0,,Британ!
Dialogue: 0,0:16:32.88,0:16:33.67,Default,,0,0,0,,Сақина
Dialogue: 0,0:16:34.26,0:16:35.05,Default,,0,0,0,,Жойылған
Dialogue: 0,0:16:35.64,0:16:36.38,Default,,0,0,0,,Жағдай қалай?
Dialogue: 0,0:16:37.01,0:16:39.97,Default,,0,0,0,,Шабуылға қатысқан мүшелердің барлығы дерлік жойылды.
Dialogue: 0,0:16:40.31,0:16:42.47,Default,,0,0,0,,Тірі қалғандар да қаша бастады
Dialogue: 0,0:16:43.06,0:16:43.77,Default,,0,0,0,,Иә
Dialogue: 0,0:16:44.19,0:16:45.10,Default,,0,0,0,,Жаңбырлы тұман
Dialogue: 0,0:16:47.69,0:16:48.36,Default,,0,0,0,,Не болды?
Dialogue: 0,0:16:48.73,0:16:49.56,Default,,0,0,0,,Қақпа...
Dialogue: 0,0:16:49.90,0:16:51.40,Default,,0,0,0,,Бұл қабырғаның ішінен
Dialogue: 0,0:16:51.90,0:16:53.82,Default,,0,0,0,,Бөлшектердің қақпаға қарсы жаңа реакциясы
Dialogue: 0,0:16:54.28,0:16:56.40,Default,,0,0,0,,Сатурн сақинасы әлі жұмыс істей ме?
Dialogue: 0,0:16:57.24,0:17:00.53,Default,,0,0,0,,Сонда біз ғана айлалы болған жоқпыз ба?
Dialogue: 0,0:17:02.50,0:17:05.96,Default,,0,0,0,,Осы балалар мен Эмберді асыға күту ғана қалды.
Dialogue: 0,0:17:06.75,0:17:08.58,Default,,0,0,0,,Мен мұндай әңгімені естігім келмейді!
Dialogue: 0,0:17:08.75,0:17:11.34,Default,,0,0,0,,Иә, мен сенімен бүгін бірінші рет сөйлестім.
Dialogue: 0,0:17:11.67,0:17:13.84,Default,,0,0,0,,Жойылған сақина, былайша айтқанда, алдамшы.
Dialogue: 0,0:17:14.30,0:17:17.01,Default,,0,0,0,,Запастың бар екені өте құпия болды.
Dialogue: 0,0:17:18.18,0:17:19.18,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:17:19.39,0:17:22.22,Default,,0,0,0,,Менде Юпитердің қосалқы сақинасы болған жоқ.
Dialogue: 0,0:17:22.35,0:17:24.72,Default,,0,0,0,,Мен Оңтүстік Америкада болғанымда, көзім ауырды.
Dialogue: 0,0:17:24.89,0:17:27.14,Default,,0,0,0,,Керемет! Сіз кереметсіз
Dialogue: 0,0:17:36.95,0:17:39.20,Default,,0,0,0,,Бұл қақпаның ішінде ме?
Dialogue: 0,0:17:39.70,0:17:40.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:41.53,0:17:42.53,Default,,0,0,0,,Рухты бақылау?
Dialogue: 0,0:17:43.37,0:17:44.20,Default,,0,0,0,,Оқу
Dialogue: 0,0:17:44.41,0:17:45.58,Default,,0,0,0,,Күте тұр, күміс
Dialogue: 0,0:17:46.12,0:17:47.41,Default,,0,0,0,,Қажетсіз қозғалсаңыз...
Dialogue: 0,0:17:49.58,0:17:50.21,Default,,0,0,0,,Сол жақта.
Dialogue: 0,0:17:52.88,0:17:53.80,Default,,0,0,0,,Ой
Dialogue: 0,0:17:58.43,0:18:00.97,Default,,0,0,0,,Жақсы, жақсы, бәрібір!
Dialogue: 0,0:18:03.06,0:18:03.56,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:18:05.39,0:18:07.06,Default,,0,0,0,,Сенің атың кім?
Dialogue: 0,0:18:10.52,0:18:13.98,Default,,0,0,0,,Бұл қақпа ма? Қызық емес пе?
Dialogue: 0,0:18:17.24,0:18:19.74,Default,,0,0,0,,Асығыңыз, Санзу но Кава және т.б.
Dialogue: 0,0:18:20.36,0:18:24.24,Default,,0,0,0,,Бірақ, жұлдыз, алданба.
Dialogue: 0,0:18:24.62,0:18:28.20,Default,,0,0,0,,Бағыттап отырған балаңнан бөлінбе.
Dialogue: 0,0:18:28.96,0:18:31.50,Default,,0,0,0,,Кейбір үлкен кедергі шуы пайда болады
Dialogue: 0,0:18:32.04,0:18:33.21,Default,,0,0,0,,Интерференциялық шу?
Dialogue: 0,0:18:33.38,0:18:35.71,Default,,0,0,0,,Бір жерде біздікімен бірдей ме?
Dialogue: 0,0:18:35.84,0:18:39.67,Default,,0,0,0,,Жоғары өнімділігі бар бақылау спирттерін белсендіретін жүйелер бар.
Dialogue: 0,0:18:39.88,0:18:43.09,Default,,0,0,0,,Түсіндім, олар қуыршақтарды пайдаланды.
Dialogue: 0,0:18:44.60,0:18:45.01,Default,,0,0,0,,Профессор, шай ішесіз бе?
Dialogue: 0,0:18:45.81,0:18:46.47,Default,,0,0,0,,Не болды?
Dialogue: 0,0:18:47.02,0:18:51.52,Default,,0,0,0,,Мен Пандовтың серверіне кіріп, ескі қағаздарды жинадым.
Dialogue: 0,0:18:51.81,0:18:52.98,Default,,0,0,0,,Мен жалықтым
Dialogue: 0,0:18:53.36,0:18:55.61,Default,,0,0,0,,Бірақ мен қызықты қағаз таптым.
Dialogue: 0,0:18:56.15,0:18:59.07,Default,,0,0,0,,Жалғыз қуыршақ үшін қандай құрал қолданылса да
Dialogue: 0,0:18:59.28,0:19:03.91,Default,,0,0,0,,Бақылаушы рухты қақпаның артқы жағынан еніп кетуі үшін көп азап керек.
Dialogue: 0,0:19:04.53,0:19:07.04,Default,,0,0,0,,Бірақ көптеген қуыршақтарды байланыстыру
Dialogue: 0,0:19:07.24,0:19:11.25,Default,,0,0,0,,Метеор фрагменттері арқылы қабілеттеріңізді күшейтетін жүйе жасасаңыз
Dialogue: 0,0:19:11.67,0:19:17.38,Default,,0,0,0,,Бақылау рухының қақпаның ортасына жақын жерден ену мүмкіндігі бар екені айтылады.
Dialogue: 0,0:19:18.38,0:19:21.63,Default,,0,0,0,,Демек, рингке шабуыл да диверсия болды ма?
Dialogue: 0,0:19:22.34,0:19:25.97,Default,,0,0,0,,BK-201 қақпаға кіріп кетті.
Dialogue: 0,0:19:26.39,0:19:30.81,Default,,0,0,0,,Бірақ егер біз шудың көзін осылай іздейтін болсақ
Dialogue: 0,0:19:34.19,0:19:37.65,Default,,0,0,0,,Жемге сенбейтіндерді жақсы көремін.
Dialogue: 0,0:19:39.99,0:19:43.53,Default,,0,0,0,,Балалар, сендермен болған қызық болды.
Dialogue: 0,0:19:44.20,0:19:44.82,Default,,0,0,0,,мысық
Dialogue: 0,0:19:45.03,0:19:49.91,Default,,0,0,0,,Бір күні маған ұқсайтын мысық қонаққа келсе...
Dialogue: 0,0:19:57.84,0:20:01.34,Default,,0,0,0,,Қанша жұлдыз болса, сонша өмір жоғалады
Dialogue: 0,0:20:01.88,0:20:04.55,Default,,0,0,0,,Барлығы жоғалады
Dialogue: 0,0:20:05.09,0:20:06.85,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:20:07.05,0:20:08.60,Default,,0,0,0,,Құлаған жұлдыз
Dialogue: 0,0:20:09.47,0:20:12.98,Default,,0,0,0,,Мені жалғыз қалдырыңыз
Dialogue: 0,0:20:24.32,0:20:27.37,Default,,0,0,0,,Енді олар адасып қалды.
Dialogue: 0,0:20:27.78,0:20:32.70,Default,,0,0,0,,Сіз енді қақпаның ортасына жете алмайсыз немесе шыға алмайсыз.
Dialogue: 0,0:20:33.50,0:20:34.91,Default,,0,0,0,,Біз жеңеміз.
Dialogue: 0,0:20:36.13,0:20:38.71,Default,,0,0,0,,Адамдар қателесетін жаратылыстар.
Dialogue: 0,0:20:39.67,0:20:42.34,Default,,0,0,0,,Барлығы үшін әділеттілік жоқ.
Dialogue: 0,0:20:43.13,0:20:45.51,Default,,0,0,0,,Қателері аз жолды таңдау
Dialogue: 0,0:20:45.72,0:20:47.72,Default,,0,0,0,,Кейде құрбандық қажет
Dialogue: 0,0:20:48.10,0:20:51.39,Default,,0,0,0,,Олай болса, қолымды кірлетуге батылым бар.
Dialogue: 0,0:20:53.48,0:20:55.77,Default,,0,0,0,,Кирихара Ересек бол
Dialogue: 0,0:20:57.40,0:21:00.86,Default,,0,0,0,,Түнгі аспан бос
Dialogue: 0,0:21:01.94,0:21:05.20,Default,,0,0,0,,Бір үлкен үлкен тесік
Dialogue: 0,0:21:05.82,0:21:09.41,Default,,0,0,0,,Жарық жарқырайды, одан тысқары
Dialogue: 0,0:21:10.62,0:21:17.46,Default,,0,0,0,,Хехехехе...
Dialogue: 0,0:21:17.63,0:21:23.42,Default,,0,0,0,,Екеуі де, екеуі де, екеуі де, екеуі де...
Dialogue: 0,0:21:31.06,0:21:31.72,Default,,0,0,0,,Не болды?
Dialogue: 0,0:21:33.72,0:21:34.35,Default,,0,0,0,,Күміс?
Dialogue: 0,0:21:35.81,0:21:36.27,Default,,0,0,0,,Күміс?
Dialogue: 0,0:21:39.40,0:21:40.06,Default,,0,0,0,,Сол жақта.
Dialogue: 0,0:23:41.94,0:23:43.65,Default,,0,0,0,,Онда ештеңе болған жоқ.
Dialogue: 0,0:23:44.73,0:23:45.69,Default,,0,0,0,,Тозақ қақпасы
Dialogue: 0,0:23:46.19,0:23:48.02,Default,,0,0,0,,Бұл тозақ қақпасының алдында
Dialogue: 0,0:23:48.78,0:23:51.15,Default,,0,0,0,,Жарық көкжиектен естіп тұрмын.
Dialogue: 0,0:23:51.40,0:23:53.61,Default,,0,0,0,,Аспан асты елінен өлгендерді шақыру
Dialogue: 0,0:23:54.62,0:23:56.45,Default,,0,0,0,,Кеудемде нұр жанды
Dialogue: 0,0:23:56.83,0:23:58.95,Default,,0,0,0,,Тозақтың нұры қарадан қарарақ
Dialogue: 0,0:24:00.00,0:24:01.83,Default,,0,0,0,,Мердігерлер ешқашан армандамайды
Dialogue: 0,0:24:02.33,0:24:05.33,Default,,0,0,0,,Рационалды түрде бағалаңыз
Dialogue: 0,0:24:08.30,0:24:09.25,Default,,0,0,0,,Онда ешкім жоқ
Dialogue: 0,0:24:10.75,0:24:16.75,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
