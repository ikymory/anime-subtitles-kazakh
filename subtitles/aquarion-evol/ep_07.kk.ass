Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:40.87,0:00:42.97,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:00:45.71,0:00:48.11,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:00:50.55,0:00:53.35,Default,,0,0,0,,Мен оны ақыры түсіндім
Dialogue: 0,0:00:53.35,0:00:55.85,Default,,0,0,0,,Акварион әуені
Dialogue: 0,0:00:55.85,0:00:59.49,Default,,0,0,0,,Мен іздеген түпкі әуен
Dialogue: 0,0:00:59.49,0:01:02.86,Default,,0,0,0,,Барға жақын... Артық етпеңіз.
Dialogue: 0,0:01:02.86,0:01:06.20,Default,,0,0,0,,Schrade Сіздің денеңіз... маңызды емес.
Dialogue: 0,0:01:06.20,0:01:09.70,Default,,0,0,0,,Сол әуенді қолыммен жасай алсам
Dialogue: 0,0:01:09.70,0:01:12.70,Default,,0,0,0,,Бұл денені шайтан жесе де
Dialogue: 0,0:01:17.44,0:01:19.81,Default,,0,0,0,,Ағызуға арнайы рұқсат
Dialogue: 0,0:01:19.81,0:01:22.71,Default,,0,0,0,,Бірақ сіз не іздеп жүрсіз?
Dialogue: 0,0:01:22.71,0:01:26.42,Default,,0,0,0,,Әрқашан өлім азғыруымен
Dialogue: 0,0:01:26.42,0:01:29.02,Default,,0,0,0,,Мұны есте сақтаңыз
Dialogue: 0,0:01:32.25,0:01:37.25,Default,,0,0,0,,Тіршілік үні өлімнің жанында ғана жаңғырады.
Dialogue: 0,0:03:24.33,0:03:26.87,Default,,0,0,0,,Мырзалар! Оны осылай қалдыру дұрыс па?
Dialogue: 0,0:03:26.87,0:03:29.77,Default,,0,0,0,,Берлиннің құлағанына бір апта болды.
Dialogue: 0,0:03:29.77,0:03:34.41,Default,,0,0,0,,Ерлер мен әйелдердің арамызда әлі көрінбейтін қабырға тұр.
Dialogue: 0,0:03:34.41,0:03:36.41,Default,,0,0,0,,Қазір ерлер мен әйелдер арасындағы кедергілерді жою уақыты
Dialogue: 0,0:03:36.41,0:03:39.25,Default,,0,0,0,,Бір-бірімізге жүрегімізді ашуымыз керек емес пе?
Dialogue: 0,0:03:39.25,0:03:41.18,Default,,0,0,0,,Бұл не туралы?
Dialogue: 0,0:03:41.18,0:03:44.69,Default,,0,0,0,,Біреу кенеттен ақымақ сөйлей бастады.
Dialogue: 0,0:03:44.69,0:03:47.09,Default,,0,0,0,,Эй Энди, бұл туралы.
Dialogue: 0,0:03:47.09,0:03:49.06,Default,,0,0,0,,Ақымақ! Жігіттер!
Dialogue: 0,0:03:49.06,0:03:51.93,Default,,0,0,0,,Осында және қазір апаттық орынды ауыстыруды ұсыныңыз.
Dialogue: 0,0:03:51.93,0:03:55.23,Default,,0,0,0,,Не, орындарды ауыстыру? Қарсылық!
Dialogue: 0,0:03:55.23,0:03:57.17,Default,,0,0,0,,Орындарды ауыстырудың қажеті жоқ
Dialogue: 0,0:03:57.17,0:04:00.60,Default,,0,0,0,,Еркек пен әйелдің бұдан да жақын болуы өте лас болар еді.
Dialogue: 0,0:04:00.60,0:04:03.34,Default,,0,0,0,,Орындарды ауыстыру керек пе? Бұл қызықты естіледі.
Dialogue: 0,0:04:03.34,0:04:06.58,Default,,0,0,0,,Мен келісемін! қызықты
Dialogue: 0,0:04:06.58,0:04:08.88,Default,,0,0,0,,Мен Кайен-саманың қасындағы позициядан бас тарта алмаймын.
Dialogue: 0,0:04:08.88,0:04:11.35,Default,,0,0,0,,Не? Жалпы жақсы қабылдады
Dialogue: 0,0:04:11.35,0:04:15.22,Default,,0,0,0,,Барлығы біртүрлі, кір, кір
Dialogue: 0,0:04:15.22,0:04:18.82,Default,,0,0,0,,Сонымен, сіз қалай шешесіз? Бұл лотерея емес пе?
Dialogue: 0,0:04:18.82,0:04:22.16,Default,,0,0,0,,Иә, иә, онда келмеген Шрейд пен Кайен ше?
Dialogue: 0,0:04:22.16,0:04:24.16,Default,,0,0,0,,Мен сурет саламын
Dialogue: 0,0:04:38.01,0:04:40.44,Default,,0,0,0,,Жарайды, енді маған да.
Dialogue: 0,0:04:40.44,0:04:45.04,Default,,0,0,0,,Қызық...жоқ, қызғылт түсті мектеп өмірі!
Dialogue: 0,0:04:48.18,0:04:50.42,Default,,0,0,0,,Менің атым Морой. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:04:50.42,0:04:52.49,Default,,0,0,0,,А, сіз жалған шайқасқа қатыстыңыз.
Dialogue: 0,0:04:52.49,0:04:55.16,Default,,0,0,0,,Сәлем Ай Чан
Dialogue: 0,0:04:55.16,0:04:57.76,Default,,0,0,0,,Эй, дұрыс. Көңілді сияқты, солай ма?
Dialogue: 0,0:04:57.76,0:05:00.06,Default,,0,0,0,,Неліктен бұл орын алады?
Dialogue: 0,0:05:00.06,0:05:03.00,Default,,0,0,0,,Көру? Хмф!
Dialogue: 0,0:05:03.00,0:05:05.87,Default,,0,0,0,,Айтпақшы, оның қасында тұрғаныма сене алар емеспін.
Dialogue: 0,0:05:05.87,0:05:09.61,Default,,0,0,0,,Үлкен жарылыс
Dialogue: 0,0:05:09.61,0:05:13.14,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:05:13.14,0:05:16.45,Default,,0,0,0,,Танысқаныма қуаныштымын, Амата-кун.
Dialogue: 0,0:05:16.45,0:05:21.08,Default,,0,0,0,,Танысқаныма қуаныштымын, мен қатты толқып тұрмын.
Dialogue: 0,0:05:21.08,0:05:25.89,Default,,0,0,0,,Wow жекпе-жекке қарағанда басқа мағынада.
Dialogue: 0,0:05:25.89,0:05:28.99,Default,,0,0,0,,Қойыңыз! Амата-кун
Dialogue: 0,0:05:33.60,0:05:38.43,Default,,0,0,0,,Ах, мен Кайен-сама мен Шраде-саманың қасында тұрғаныма сене алар емеспін.
Dialogue: 0,0:05:38.43,0:05:41.64,Default,,0,0,0,,Бұл шынымен де Құдайдың кереметі.
Dialogue: 0,0:05:41.64,0:05:44.54,Default,,0,0,0,,Мен қазір бұл туралы бірдеңе жасайтын сияқтымын.
Dialogue: 0,0:05:44.54,0:05:46.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:46.81,0:05:50.78,Default,,0,0,0,,Бірінші рет қатар отырдық. Бұл бірінші және соңғы рет.
Dialogue: 0,0:05:50.78,0:05:54.08,Default,,0,0,0,,Мені алып кетуге келгеніңе қуаныштымын, ең жақын досым.
Dialogue: 0,0:05:54.08,0:05:56.35,Default,,0,0,0,,Мен сені алып кетуге келген жоқпын.
Dialogue: 0,0:05:56.35,0:05:58.65,Default,,0,0,0,,Тек ұрлаушыны іздеуге арналған
Dialogue: 0,0:05:58.65,0:06:00.95,Default,,0,0,0,,Одан бұрын!
Dialogue: 0,0:06:02.93,0:06:06.80,Default,,0,0,0,,Әй, не деген сұмдық какофония.
Dialogue: 0,0:06:06.80,0:06:08.80,Default,,0,0,0,,Сен Кираны асып өлтіремін дедің, ал қазір оны өлтірді деп айтып тұрсың ба? Дәл осыны айтқың келе ме?
Dialogue: 0,0:06:08.80,0:06:11.50,Default,,0,0,0,,Қалжың болсын, досым.
Dialogue: 0,0:06:15.10,0:06:20.38,Default,,0,0,0,,Бұл жай... бәрі жақсы болып кетті.
Dialogue: 0,0:06:20.38,0:06:22.31,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:06:22.31,0:06:25.95,Default,,0,0,0,,Сіз осындай жерге тұлыптар қойдыңыз ба?
Dialogue: 0,0:06:25.95,0:06:29.22,Default,,0,0,0,,Толтырма... Мынау!
Dialogue: 0,0:06:29.22,0:06:31.82,Default,,0,0,0,,Шынымен бе? Ия, шықты!
Dialogue: 0,0:06:31.82,0:06:34.52,Default,,0,0,0,,Қорқынышты тұлып! иә?
Dialogue: 0,0:06:34.52,0:06:37.96,Default,,0,0,0,,Не? Тұлыпқа не болды?
Dialogue: 0,0:06:37.96,0:06:40.96,Default,,0,0,0,,Барлығы біледі ме? Неодиваларға жеткізілді
Dialogue: 0,0:06:40.96,0:06:43.70,Default,,0,0,0,,Жоғалған элементтер туралы қауесет
Dialogue: 0,0:06:43.70,0:06:47.67,Default,,0,0,0,,Бұл не? Бұл бірнеше жыл бұрын болды.
Dialogue: 0,0:06:47.67,0:06:51.34,Default,,0,0,0,,Осы мектепке ауысқан қыз.
Dialogue: 0,0:06:51.34,0:06:54.18,Default,,0,0,0,,Бірақ менің ұялшақ мінезім маған қиындық туғызды.
Dialogue: 0,0:06:54.18,0:06:58.55,Default,,0,0,0,,Қыздың достары болмады.
Dialogue: 0,0:06:58.55,0:07:01.08,Default,,0,0,0,,Жалғыздыққа шыдай алмай қыз...
Dialogue: 0,0:07:01.08,0:07:06.38,Default,,0,0,0,,Бір күні ол осы мектептен кенет жоғалып кетті.
Dialogue: 0,0:07:09.22,0:07:11.19,Default,,0,0,0,,Мен бұған сенбеймін...
Dialogue: 0,0:07:11.19,0:07:14.06,Default,,0,0,0,,Әлемді аралау
Dialogue: 0,0:07:14.06,0:07:17.70,Default,,0,0,0,,Қыздың жалғыз досы болған тұлып
Dialogue: 0,0:07:17.70,0:07:20.70,Default,,0,0,0,,Содан бері мен күнде кешке мектепті аралап жүрмін.
Dialogue: 0,0:07:20.70,0:07:23.97,Default,,0,0,0,,Енді тұлыпты көруге болады.
Dialogue: 0,0:07:23.97,0:07:26.44,Default,,0,0,0,,Қыздың өкінішін жеткізгендей
Dialogue: 0,0:07:26.44,0:07:28.71,Default,,0,0,0,,Әдемі, бірақ мұңды дауыспен
Dialogue: 0,0:07:28.71,0:07:32.38,Default,,0,0,0,,Әлгі тұлып ылғи ән салады.
Dialogue: 0,0:07:32.38,0:07:34.35,Default,,0,0,0,,Бұл күлкілі
Dialogue: 0,0:07:34.35,0:07:37.25,Default,,0,0,0,,Мен де бұл қауесетті естідім.
Dialogue: 0,0:07:37.25,0:07:40.69,Default,,0,0,0,,Берлин құлағаннан кейін ол ұлдар жатақханасынан көрінді.
Dialogue: 0,0:07:40.69,0:07:43.03,Default,,0,0,0,,Егер Моллой солай айтса.
Dialogue: 0,0:07:43.03,0:07:45.93,Default,,0,0,0,,Бұл шын болуы мүмкін. Бұл қорқынышты.
Dialogue: 0,0:07:45.93,0:07:48.23,Default,,0,0,0,,Хмф! Апыр-ай!
Dialogue: 0,0:07:48.23,0:07:51.27,Default,,0,0,0,,Енді тұлып қозғалады! Энди
Dialogue: 0,0:07:51.27,0:07:53.80,Default,,0,0,0,,Өз еркеліктеріңізді байыппен қабылдаңыз.
Dialogue: 0,0:07:53.80,0:07:58.00,Default,,0,0,0,,Жарайды, шынында да қозғалды.
Dialogue: 0,0:08:11.22,0:08:13.72,Default,,0,0,0,,Тапсырма аяқталды
Dialogue: 0,0:08:13.72,0:08:16.93,Default,,0,0,0,,Сен күткендей, Джин.
Dialogue: 0,0:08:16.93,0:08:21.16,Default,,0,0,0,,Бірақ модельдеу тек практикалық мақсаттарға арналған.
Dialogue: 0,0:08:21.16,0:08:24.07,Default,,0,0,0,,Солай ма? Кагура ше?
Dialogue: 0,0:08:24.07,0:08:27.60,Default,,0,0,0,,Бұл уақыттың тоқтатылуы ұзақ уақытқа созылуы мүмкін.
Dialogue: 0,0:08:27.60,0:08:30.94,Default,,0,0,0,,Көрінбейтін есік Болашақ есік
Dialogue: 0,0:08:30.94,0:08:33.84,Default,,0,0,0,,Дүниенің түкпір-түкпіріне ұшу
Dialogue: 0,0:08:36.58,0:08:40.45,Default,,0,0,0,,Есіктің арғы жағына тағы бір қараймын.
Dialogue: 0,0:08:40.45,0:08:45.85,Default,,0,0,0,,Өтінемін, менің соңғы балам Альтея.
Dialogue: 0,0:08:55.96,0:08:59.96,Default,,0,0,0,,А, ақыры аяқталды, иә?
Dialogue: 0,0:09:03.44,0:09:06.07,Default,,0,0,0,,Иә? Мм... Джессика?
Dialogue: 0,0:09:06.07,0:09:08.51,Default,,0,0,0,,О, сен шаршадың. Сіз тазалық қызметіндесіз бе?
Dialogue: 0,0:09:08.51,0:09:10.81,Default,,0,0,0,,Аа, бітті, мен үйге бара жатырмын.
Dialogue: 0,0:09:10.81,0:09:13.65,Default,,0,0,0,,Сонымен... дұрыс, кездейсоқтық!
Dialogue: 0,0:09:13.65,0:09:15.58,Default,,0,0,0,,Мен де үйге қайтайын деп жатырмын.
Dialogue: 0,0:09:15.58,0:09:18.49,Default,,0,0,0,,Эй, менімен үйге барғың келе ме?
Dialogue: 0,0:09:18.49,0:09:21.06,Default,,0,0,0,,Не? Ұстаудың қажеті жоқ
Dialogue: 0,0:09:21.06,0:09:23.56,Default,,0,0,0,,Мен сенімен үйге барамын.
Dialogue: 0,0:09:32.67,0:09:35.67,Default,,0,0,0,,Иә? Өтірік...
Dialogue: 0,0:09:35.67,0:09:39.01,Default,,0,0,0,,ашылмайды ма? Артқы есіктен кері өтуден басқа амалым жоқ.
Dialogue: 0,0:09:39.01,0:09:42.01,Default,,0,0,0,,Сонда ол қарама-қарсы бағытта жүреді, сондықтан мұнда
Dialogue: 0,0:09:42.01,0:09:47.48,Default,,0,0,0,,О, сәл күте тұрыңыз, иә?
Dialogue: 0,0:09:47.48,0:09:50.42,Default,,0,0,0,,Неліктен әйелдер қанатының шығуы арқылы қайтып оралмайсың? а?
Dialogue: 0,0:09:50.42,0:09:53.32,Default,,0,0,0,,Жарайды, бірақ неге?
Dialogue: 0,0:10:05.97,0:10:10.71,Default,,0,0,0,,Джессика? Мм... бірақ жүру қиын.
Dialogue: 0,0:10:10.71,0:10:13.38,Default,,0,0,0,,Сиқыр формуласын ашу
Dialogue: 0,0:10:13.38,0:10:17.25,Default,,0,0,0,,Сіз кездейсоқ... қорқасыз ба?
Dialogue: 0,0:10:17.25,0:10:21.08,Default,,0,0,0,,Ба... Ақымақ болма! Бұл мен
Dialogue: 0,0:10:21.08,0:10:23.02,Default,,0,0,0,,Жүретін тұлып туралы әңгіме
Dialogue: 0,0:10:23.02,0:10:27.76,Default,,0,0,0,,Әнші елес туралы хикая... мен бұған қалай шындап қарасам екен...
Dialogue: 0,0:10:27.76,0:10:30.76,Default,,0,0,0,,О... не?
Dialogue: 0,0:10:32.96,0:10:34.90,Default,,0,0,0,,Мектепке қабылдау сыйы ретінде маған берілген тау велосипеді
Dialogue: 0,0:10:34.90,0:10:37.30,Default,,0,0,0,,Не... мұнда неге келдің?
Dialogue: 0,0:10:46.44,0:10:49.38,Default,,0,0,0,,Өтірік... Бұл ойдан шығарылған, солай ма?
Dialogue: 0,0:10:49.38,0:10:52.48,Default,,0,0,0,,Бұл сөзсіз біреудің еркелігі.
Dialogue: 0,0:10:54.75,0:10:56.95,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:26.75,0:11:30.15,Default,,0,0,0,,Иісі және тәтті
Dialogue: 0,0:11:30.15,0:11:34.86,Default,,0,0,0,,Бұл қорқынышты болды, бірақ мен солай деп ойлаймын.
Dialogue: 0,0:11:34.86,0:11:37.79,Default,,0,0,0,,Мен ол адамды ұмыта алмаймын.
Dialogue: 0,0:11:37.79,0:11:40.00,Default,,0,0,0,,Аяқ киім
Dialogue: 0,0:11:40.00,0:11:42.86,Default,,0,0,0,,Әй, неге екен деп ойлаймын.
Dialogue: 0,0:11:42.86,0:11:44.80,Default,,0,0,0,,Екеуің неге сонда тұрып, аң-таң болып қарап тұрсыңдар?
Dialogue: 0,0:11:44.80,0:11:47.40,Default,,0,0,0,,Уау! Біртүрлі нәрсені ұстамаңыз
Dialogue: 0,0:11:47.40,0:11:51.71,Default,,0,0,0,,Маған ұнамайды, мені тастама!
Dialogue: 0,0:11:51.71,0:11:56.01,Default,,0,0,0,,Міне... Джессика мен Амата-кун
Dialogue: 0,0:12:00.32,0:12:05.82,Default,,0,0,0,,Тоқта, Джин, менің қарғыс атқан әйеліме тиіспе.
Dialogue: 0,0:12:08.06,0:12:12.69,Default,,0,0,0,,Енді нағыз Хауа ана туралы анықтама
Dialogue: 0,0:12:12.69,0:12:15.19,Default,,0,0,0,,Сіз оны таба аласыз ба?
Dialogue: 0,0:12:19.00,0:12:21.00,Default,,0,0,0,,Егер сіз оны шынымен көрген болсаңыз
Dialogue: 0,0:12:21.00,0:12:23.67,Default,,0,0,0,,Толтырылған мысық? Иә
Dialogue: 0,0:12:23.67,0:12:27.04,Default,,0,0,0,,Аматаны түнде дәлізде келе жатқанын көрдіңіз бе?
Dialogue: 0,0:12:27.04,0:12:30.81,Default,,0,0,0,,Бұл жай ғана әзіл екені сөзсіз.
Dialogue: 0,0:12:30.81,0:12:34.18,Default,,0,0,0,,Байыпты болмау керек дегеніңіз осы емес пе?
Dialogue: 0,0:12:34.18,0:12:36.12,Default,,0,0,0,,Мен шынымен жаяу жүрдім.
Dialogue: 0,0:12:36.12,0:12:38.69,Default,,0,0,0,,Ән дауысын мен де естідім, эй эй
Dialogue: 0,0:12:38.69,0:12:42.12,Default,,0,0,0,,Жасөспірімдік кезеңде сіз көре алмайтын нәрселерді көре аласыз.
Dialogue: 0,0:12:42.12,0:12:45.86,Default,,0,0,0,,Сіз жасыңызды өзгертпейсіз бе?
Dialogue: 0,0:12:45.86,0:12:49.50,Default,,0,0,0,,Сол кезде екеуің неге бірге болдыңдар?
Dialogue: 0,0:12:49.50,0:12:52.93,Default,,0,0,0,,Аа, бұл Джессика...
Dialogue: 0,0:12:52.93,0:12:55.57,Default,,0,0,0,,Не? Өйткені бұл ұят
Dialogue: 0,0:12:55.57,0:12:57.91,Default,,0,0,0,,Менің қорқатынымды құпия сақта
Dialogue: 0,0:12:57.91,0:13:00.78,Default,,0,0,0,,Иә? Сен не туралы айтып тұрсың?
Dialogue: 0,0:13:00.78,0:13:04.41,Default,,0,0,0,,Е-е, жоқ, айта алмайтын себебің осы!
Dialogue: 0,0:13:04.41,0:13:08.98,Default,,0,0,0,,Бұл кір! Әйтеуір, сендер киелі мектепте оқисыңдар
Dialogue: 0,0:13:08.98,0:13:12.22,Default,,0,0,0,,Олай емес... Мен көрдім.
Dialogue: 0,0:13:12.22,0:13:16.63,Default,,0,0,0,,Микононы да көрдіңіз бе? Тұлыптар жүрген жерде
Dialogue: 0,0:13:16.63,0:13:20.36,Default,,0,0,0,,Мен аулада Джессика мен Аматаны көрдім.
Dialogue: 0,0:13:20.36,0:13:23.00,Default,,0,0,0,,Олар бір-бірін құшақтап жатыр, иә?
Dialogue: 0,0:13:23.00,0:13:25.90,Default,,0,0,0,,Ал Джессика маған оны тастамау керектігін айтты.
Dialogue: 0,0:13:25.90,0:13:29.57,Default,,0,0,0,,Иә? Мұны сіз зорлау ойыны деп атайсыз ба?
Dialogue: 0,0:13:29.57,0:13:36.28,Default,,0,0,0,,Өйткені, балалар! Сіз дұрыс түсінбедіңіз, Миконо-сан!
Dialogue: 0,0:13:36.28,0:13:38.71,Default,,0,0,0,,Абдуктор Нео Кулон аймағында пайда болады
Dialogue: 0,0:13:38.71,0:13:42.08,Default,,0,0,0,,Әрбір элемент дереу екінші класты кесу позициясына орналастырылуы керек.
Dialogue: 0,0:13:42.08,0:13:46.88,Default,,0,0,0,,Қайталау Әрбір элемент бірден 2-ші түрдегі ұстап алу позициясына орналастырылады.
Dialogue: 0,0:13:51.69,0:13:54.63,Default,,0,0,0,,Талдау аяқталды B үлгісі
Dialogue: 0,0:13:54.63,0:13:57.50,Default,,0,0,0,,Модельдеу бойынша ілгерілеу
Dialogue: 0,0:13:57.50,0:14:00.40,Default,,0,0,0,,Тосқауыл ретінде әрекет ететін ғимараттарды қирату кезінде Абдуктор алға жылжиды.
Dialogue: 0,0:14:00.40,0:14:02.44,Default,,0,0,0,,Жылдамдығы сағатына 60
Dialogue: 0,0:14:02.44,0:14:06.81,Default,,0,0,0,,Бұл біртүрлі. Ұрлау мақсат емес сияқты.
Dialogue: 0,0:14:06.81,0:14:09.31,Default,,0,0,0,,Біз одан да көп зиян келтіре алмаймыз.
Dialogue: 0,0:14:09.31,0:14:11.28,Default,,0,0,0,,Басты Джессика түсінеді
Dialogue: 0,0:14:11.28,0:14:13.75,Default,,0,0,0,,Ал Кайен Амата ұшады!
Dialogue: 0,0:14:13.75,0:14:15.75,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:14:22.49,0:14:26.76,Default,,0,0,0,,Миконо мырза... мүлде дұрыс түсінбедім.
Dialogue: 0,0:14:26.76,0:14:29.16,Default,,0,0,0,,Қарсыластың оптикалық қаруының дәлдігі...
Dialogue: 0,0:14:29.16,0:14:32.17,Default,,0,0,0,,мен диапазонды білмеймін, өте сақ болыңыз.
Dialogue: 0,0:14:32.17,0:14:35.47,Default,,0,0,0,,Түсіндім... Ах! Уау
Dialogue: 0,0:14:35.47,0:14:38.11,Default,,0,0,0,,Бұл күтпеген шабуыл. Қайдан түсіріп жатырсың?
Dialogue: 0,0:14:38.11,0:14:40.48,Default,,0,0,0,,Түсіру қатесі 0,0003
Dialogue: 0,0:14:40.48,0:14:44.15,Default,,0,0,0,,Ақымақ! Атмосфера тікелей әсер ететін оптикалық қару.
Dialogue: 0,0:14:44.15,0:14:46.15,Default,,0,0,0,,Бұл дәл түсіру
Dialogue: 0,0:14:46.15,0:14:50.32,Default,,0,0,0,,Радиус Гунис, берік пе?
Dialogue: 0,0:14:50.32,0:14:53.56,Default,,0,0,0,,Оның көзі мың миль қашықтықтағы тиынға қадалған
Dialogue: 0,0:14:53.56,0:14:58.36,Default,,0,0,0,,Теңдесі жоқ қатыгездіктің жебесімен дәл тесіп өтіңіз
Dialogue: 0,0:14:58.36,0:15:02.00,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:15:02.00,0:15:04.00,Default,,0,0,0,,Оны көргенде білесің
Dialogue: 0,0:15:06.20,0:15:10.07,Default,,0,0,0,,Біріктіріңіз! Егер сіз тікелей соққы алсаңыз, вектор жұмыс істемейді.
Dialogue: 0,0:15:10.07,0:15:12.87,Default,,0,0,0,,Төмен ұшып бара жатқанда жақындау.
Dialogue: 0,0:15:12.87,0:15:17.17,Default,,0,0,0,,Төтенше комбинация Go Aquarion!
Dialogue: 0,0:15:22.48,0:15:25.38,Default,,0,0,0,,Акварион Гепард
Dialogue: 0,0:15:30.59,0:15:33.50,Default,,0,0,0,,Ауданды эвакуациялау аяқталды
Dialogue: 0,0:15:33.50,0:15:36.40,Default,,0,0,0,,Ғимаратты қалқан ретінде пайдалануға рұқсат етіңіз
Dialogue: 0,0:15:36.40,0:15:38.83,Default,,0,0,0,,Бұл жерден шабуылдар әлі келген жоқ.
Dialogue: 0,0:15:38.83,0:15:42.23,Default,,0,0,0,,Соқырды аңдып, жақындап келе жатқан жалғыз жау бар.
Dialogue: 0,0:15:49.48,0:15:51.75,Default,,0,0,0,,Бұл болжауға болатын мінез-құлық.
Dialogue: 0,0:15:51.75,0:15:55.65,Default,,0,0,0,,Мен сізді өте қиын жағдайға душар еткім келеді
Dialogue: 0,0:15:58.05,0:16:01.92,Default,,0,0,0,,Жау кішкентай ұшатын нысанды атқылайды! зымыран?
Dialogue: 0,0:16:01.92,0:16:04.22,Default,,0,0,0,,Уау~
Dialogue: 0,0:16:10.47,0:16:13.67,Default,,0,0,0,,Бұл...
Dialogue: 0,0:16:13.67,0:16:16.37,Default,,0,0,0,,Қат! Осылай қала берсе...
Dialogue: 0,0:16:19.87,0:16:23.34,Default,,0,0,0,,Ауаға шығарылған сфера лазерді көрсетеді
Dialogue: 0,0:16:23.34,0:16:26.11,Default,,0,0,0,,Барлық жағынан шабуыл жасауға мүмкіндік беретін сияқты.
Dialogue: 0,0:16:26.11,0:16:31.11,Default,,0,0,0,,Бұл мәселе. Ешбір қорғаныс жұмыс істемейді.
Dialogue: 0,0:16:37.26,0:16:40.26,Default,,0,0,0,,Бұл бірнеше жаумен күресуден еш айырмашылығы жоқ.
Dialogue: 0,0:16:40.26,0:16:42.66,Default,,0,0,0,,Джессика артта!
Dialogue: 0,0:16:46.47,0:16:48.97,Default,,0,0,0,,Амата!
Dialogue: 0,0:16:51.77,0:16:53.71,Default,,0,0,0,,Vector Zed бойынша лазерлік фокус
Dialogue: 0,0:16:53.71,0:16:56.28,Default,,0,0,0,,Амата Сораның рух деңгейі төмендеді!
Dialogue: 0,0:16:56.28,0:16:59.88,Default,,0,0,0,,Амата-кун... сен өз шегіңдесің. Комбинация жойылады.
Dialogue: 0,0:17:05.85,0:17:08.56,Default,,0,0,0,,Амата! Бұл менің кінәм
Dialogue: 0,0:17:08.56,0:17:12.29,Default,,0,0,0,,Мен Акварионды мұқият жылжытсам болды.
Dialogue: 0,0:17:12.29,0:17:16.93,Default,,0,0,0,,Джессиканың рух деңгейі 50 40 30%-ға төмендеді
Dialogue: 0,0:17:16.93,0:17:19.80,Default,,0,0,0,,Амата шығынды өз мойнына алған.
Dialogue: 0,0:17:19.80,0:17:22.04,Default,,0,0,0,,Джессика...
Dialogue: 0,0:17:22.04,0:17:25.61,Default,,0,0,0,,Адамның жүрегі көрінбейді
Dialogue: 0,0:17:25.61,0:17:29.54,Default,,0,0,0,,Сондықтан түсінбеушілік туындап, үйкеліс пайда болады.
Dialogue: 0,0:17:29.54,0:17:32.38,Default,,0,0,0,,Бірақ Миконо Сузусиро
Dialogue: 0,0:17:32.38,0:17:36.55,Default,,0,0,0,,Біліңіз, бұл дүниеде дәл сіз оларды көре алмайтындықтан қол жеткізуге болатын нәрселер бар.
Dialogue: 0,0:17:36.55,0:17:38.62,Default,,0,0,0,,Не? Қазір уақыт
Dialogue: 0,0:17:38.62,0:17:41.49,Default,,0,0,0,,Көзге көрінбейтін жүрегіңді күшке айналдыратын кез келді
Dialogue: 0,0:17:41.49,0:17:43.79,Default,,0,0,0,,Элементті өзгерту!
Dialogue: 0,0:17:43.79,0:17:47.53,Default,,0,0,0,,Юноха Трур Джессика Вонгтың орнына шықты
Dialogue: 0,0:17:47.53,0:17:50.50,Default,,0,0,0,,Не? Юноха? осылайша
Dialogue: 0,0:17:50.50,0:17:52.50,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:18:02.04,0:18:04.61,Default,,0,0,0,,Бұл тұлып.
Dialogue: 0,0:18:04.61,0:18:07.62,Default,,0,0,0,,Мм... көп рахмет.
Dialogue: 0,0:18:07.62,0:18:11.39,Default,,0,0,0,,Сөйлесті
Dialogue: 0,0:18:11.39,0:18:14.29,Default,,0,0,0,,Амата-сан және Джессика-сан
Dialogue: 0,0:18:14.29,0:18:17.56,Default,,0,0,0,,Кеше сізді таң қалдырғаным үшін кешіріңіз.
Dialogue: 0,0:18:17.56,0:18:20.46,Default,,0,0,0,,Осыған байланысты, тіпті Миконо-санда да қорқынышты түсінбеушілік болды...
Dialogue: 0,0:18:20.46,0:18:23.06,Default,,0,0,0,,Не? иә түсінбеушілік
Dialogue: 0,0:18:23.06,0:18:25.30,Default,,0,0,0,,Түнде қыдырып жүрген осындай нәрсені көрсеңіз
Dialogue: 0,0:18:25.30,0:18:28.80,Default,,0,0,0,,Сіз де үрейленіп жатқан шығарсыз. Мен шынымен кешірім сұраймын.
Dialogue: 0,0:18:28.80,0:18:31.31,Default,,0,0,0,,Бірақ қазір маған сеніңіз
Dialogue: 0,0:18:31.31,0:18:33.88,Default,,0,0,0,,Бірге күресіңіздер, сіз де...
Dialogue: 0,0:18:33.88,0:18:36.78,Default,,0,0,0,,Бұл элемент пе?
Dialogue: 0,0:18:36.78,0:18:39.18,Default,,0,0,0,,Әңгімені кейінге қалдыр, Амата.
Dialogue: 0,0:18:39.18,0:18:43.89,Default,,0,0,0,,Амата-сан, мен осындаймын, сен маған қосыла аласың ба?
Dialogue: 0,0:18:43.89,0:18:46.82,Default,,0,0,0,,Түсіндім, мен саған сенемін.
Dialogue: 0,0:18:46.82,0:18:52.12,Default,,0,0,0,,Божественный Рух комбинациясы Go Aquarion!
Dialogue: 0,0:19:03.57,0:19:06.47,Default,,0,0,0,,Жоқ, мен оны көріп тұрмын.
Dialogue: 0,0:19:06.47,0:19:08.54,Default,,0,0,0,,Оны бәрі көреді
Dialogue: 0,0:19:08.54,0:19:12.11,Default,,0,0,0,,Әй, көрдім, көрдім.
Dialogue: 0,0:19:12.11,0:19:16.02,Default,,0,0,0,,Бұл сіздің шынайы формаңыз
Dialogue: 0,0:19:16.02,0:19:19.55,Default,,0,0,0,,Ой, мен бәрін көрдім, ұят болды.
Dialogue: 0,0:19:19.55,0:19:23.42,Default,,0,0,0,,Бірақ бұл жақсы сезінеді
Dialogue: 0,0:19:23.42,0:19:27.10,Default,,0,0,0,,Aquarion EVOL
Dialogue: 0,0:19:27.10,0:19:29.86,Default,,0,0,0,,Механикалық періштенің тағы бір түрі
Dialogue: 0,0:19:29.86,0:19:34.07,Default,,0,0,0,,Бұл да модельденді.
Dialogue: 0,0:19:34.07,0:19:37.64,Default,,0,0,0,,Жоғалып кеткен студент, мен оны шынымен бар деп ойламадым
Dialogue: 0,0:19:37.64,0:19:41.58,Default,,0,0,0,,Бұл өте сүйкімді.
Dialogue: 0,0:19:41.58,0:19:44.18,Default,,0,0,0,,Мен...
Dialogue: 0,0:19:48.28,0:19:50.89,Default,,0,0,0,,Иә? Сіз оны жойдыңыз ба? О құдайым-ай!
Dialogue: 0,0:19:50.89,0:19:52.89,Default,,0,0,0,,Акварион жоғалып кетті ме?
Dialogue: 0,0:19:55.69,0:19:58.03,Default,,0,0,0,,Егер лазер одан өтіп кетсе ше?
Dialogue: 0,0:19:58.03,0:20:00.93,Default,,0,0,0,,Ұялы жүрек қуатын кеңейтеді.
Dialogue: 0,0:20:00.93,0:20:04.40,Default,,0,0,0,,Толығымен оптикалық мөлдір
Dialogue: 0,0:20:04.40,0:20:09.54,Default,,0,0,0,,Бұл Юноха Трурдың элементарлық қабілеті.
Dialogue: 0,0:20:09.54,0:20:14.38,Default,,0,0,0,,Қыз жүрегінің әдемі, бірақ терең әдістері
Dialogue: 0,0:20:14.38,0:20:16.31,Default,,0,0,0,,Бірақ сақ болыңыз
Dialogue: 0,0:20:16.31,0:20:19.21,Default,,0,0,0,,Акварионның бүкіл денесі мөлдір болу үшін қанша уақыт қажет?
Dialogue: 0,0:20:19.21,0:20:22.52,Default,,0,0,0,,Бұл соншалықты ұзақ емес, бірақ жеткілікті.
Dialogue: 0,0:20:22.52,0:20:26.22,Default,,0,0,0,,Бұл өте керемет, Юноха-сан, мақтауға тұрарлық.
Dialogue: 0,0:20:26.22,0:20:29.32,Default,,0,0,0,,Мен... Мен ұялып тұрмын.
Dialogue: 0,0:20:33.96,0:20:35.90,Default,,0,0,0,,Лазерлер мен сенсорлар жарамсыз ба?
Dialogue: 0,0:20:35.90,0:20:38.20,Default,,0,0,0,,Модельдеуде мұндай жағдай болған жоқ.
Dialogue: 0,0:20:38.20,0:20:40.20,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:20:45.87,0:20:49.61,Default,,0,0,0,,Жаудың қашықтығы: 800 Оның кеудесіне секір!
Dialogue: 0,0:20:49.61,0:20:51.61,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:20:54.02,0:20:57.89,Default,,0,0,0,,Мен көремін. Бұл жай ғана оптикалық көрінбейтін.
Dialogue: 0,0:20:57.89,0:21:01.69,Default,,0,0,0,,Жоғалып кеткендей болса да, негізгі бөлігі сол жерде.
Dialogue: 0,0:21:01.69,0:21:04.79,Default,,0,0,0,,Олай болса, қатты оқты қолданыңыз.
Dialogue: 0,0:21:08.10,0:21:10.90,Default,,0,0,0,,Сіз мұны жасадыңыз ба? Ах!
Dialogue: 0,0:21:21.11,0:21:25.35,Default,,0,0,0,,Бұл қызметші өте қиын жағдайда.
Dialogue: 0,0:21:25.35,0:21:29.05,Default,,0,0,0,,Енді көзге көрінбейтін жұдырық жауға тиеді.
Dialogue: 0,0:21:30.95,0:21:33.85,Default,,0,0,0,,Фантомды жыпылықтайтын жұдырық
Dialogue: 0,0:21:40.36,0:21:43.26,Default,,0,0,0,,Иә! о!
Dialogue: 0,0:21:43.26,0:21:47.20,Default,,0,0,0,,Мен жеңдім... сол аруақтың арқасында?
Dialogue: 0,0:21:47.20,0:21:49.20,Default,,0,0,0,,Хехе
Dialogue: 0,0:21:55.88,0:22:02.25,Default,,0,0,0,,Күрсініңіз, өлшем аралық қашықтан басқару пульті осындай нәрсе.
Dialogue: 0,0:22:02.25,0:22:06.62,Default,,0,0,0,,Жаңа Reaigler деректері алынды.
Dialogue: 0,0:22:06.62,0:22:09.02,Default,,0,0,0,,Көрінбейтін күш...
Dialogue: 0,0:22:14.06,0:22:16.66,Default,,0,0,0,,Амата-кун! Миконо-сан
Dialogue: 0,0:22:16.66,0:22:18.60,Default,,0,0,0,,Джессикадан естіген
Dialogue: 0,0:22:18.60,0:22:21.10,Default,,0,0,0,,Бұл менің жылдам әрекетім болды.
Dialogue: 0,0:22:21.10,0:22:23.77,Default,,0,0,0,,Кешіріңіз, бәрі жақсы.
Dialogue: 0,0:22:23.77,0:22:26.07,Default,,0,0,0,,Сонымен... аа!
Dialogue: 0,0:22:26.07,0:22:30.78,Default,,0,0,0,,Ах, менің жаңа досым... Иә, менің атым Юноха.
Dialogue: 0,0:22:30.78,0:22:32.71,Default,,0,0,0,,Сіз баяғыда өлген элементсіз.
Dialogue: 0,0:22:32.71,0:22:35.02,Default,,0,0,0,,Бұл елес, солай ма?
Dialogue: 0,0:22:35.02,0:22:37.95,Default,,0,0,0,,Бірақ бәрібір, мен енді қорықпаймын
Dialogue: 0,0:22:37.95,0:22:40.76,Default,,0,0,0,,Бұдан былай дос болып бірге жұмыс жасайық.
Dialogue: 0,0:22:40.76,0:22:44.63,Default,,0,0,0,,Эй, сәл күте тұршы, олай емес, Амата-кун. Сол бала...
Dialogue: 0,0:22:44.63,0:22:48.20,Default,,0,0,0,,Мм, сіз бір нәрсені дұрыс түсінбеген сияқтысыз.
Dialogue: 0,0:22:48.20,0:22:53.53,Default,,0,0,0,,Кешіріңіз, мен тірімін...
Dialogue: 0,0:22:53.53,0:22:58.11,Default,,0,0,0,,Юноха Трур Мен де сен сияқты элементтік курсантпын.
Dialogue: 0,0:22:58.11,0:23:00.61,Default,,0,0,0,,Уау! Кешіріңіз...
Dialogue: 0,0:23:00.61,0:23:02.68,Default,,0,0,0,,Уау Уау... Уау!
Dialogue: 0,0:23:02.68,0:23:06.01,Default,,0,0,0,,Уау, қойшы!
Dialogue: 0,0:23:06.01,0:23:08.32,Default,,0,0,0,,Өйткені, Амата-кун...
Dialogue: 0,0:23:08.32,0:23:11.32,Default,,0,0,0,,Қарсылас кім болса да, ол қалқып шығады.
Dialogue: 0,0:24:47.01,0:24:48.98,Default,,0,0,0,,Менің атым Джессика Вонг
Dialogue: 0,0:24:48.98,0:24:52.22,Default,,0,0,0,,Өзін тым көп әшкереледі деген қауесет тараған 17 жастағы жасөспірім
Dialogue: 0,0:24:52.22,0:24:57.59,Default,,0,0,0,,Кеуде жырығы ашық, бірақ жүрек жырығы әркімге құпия!
Dialogue: 0,0:24:57.59,0:25:00.39,Default,,0,0,0,,Келесі жолы Aquarion EVOL «Expose»
Dialogue: 0,0:27:19.37,0:27:22.74,Default,,0,0,0,,«Неге ор қазып жатырсың?»
Dialogue: 0,0:27:22.74,0:27:26.61,Default,,0,0,0,,Осы сұраққа жауап ретінде аңызға айналған тоннель қазу инженері
Dialogue: 0,0:27:26.61,0:27:31.78,Default,,0,0,0,,Алехандра Ведерников былай деп жауап берді:
Dialogue: 0,0:27:31.78,0:27:37.28,Default,,0,0,0,,«Себебі тесіктің ар жағында біз әлі көрмеген дүние бар».
Dialogue: 0,0:27:44.36,0:27:47.76,Default,,0,0,0,,Көрінбейтін әлемге ұмтылу
Dialogue: 0,0:27:49.70,0:27:55.10,Default,,0,0,0,,Күте тұрыңыз, бұл менің қыздарымның киім ауыстыратын бөлмесі.
Dialogue: 0,0:27:57.41,0:28:00.71,Default,,0,0,0,,Джо... Әйелдердің киім ауыстыратын бөлмесі А?
Dialogue: 0,0:28:02.81,0:28:05.11,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:29:48.05,0:29:50.95,Default,,0,0,0,,Иә, бірінші келген, бірінші қызмет етеді.
Dialogue: 0,0:29:50.95,0:29:54.36,Default,,0,0,0,,Әй, өткен күнгі әлеуметтік зерттеулер экскурсиясындағы сурет?
Dialogue: 0,0:29:54.36,0:29:56.66,Default,,0,0,0,,Сіз бұл суретті қашан түсірдіңіз?
Dialogue: 0,0:29:56.66,0:30:01.06,Default,,0,0,0,,Хехе, хоббидің де, пайданың да болуы дәл осы.
Dialogue: 0,0:30:01.06,0:30:03.43,Default,,0,0,0,,I, Шрейд мырза, 1 дана
Dialogue: 0,0:30:03.43,0:30:06.33,Default,,0,0,0,,Иә, әр уақытта! О, жоқ, бұл біртүрлі бет
Dialogue: 0,0:30:06.33,0:30:09.30,Default,,0,0,0,,Хаха, бұл анық көрінеді.
Dialogue: 0,0:30:09.30,0:30:11.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:11.74,0:30:14.34,Default,,0,0,0,,Иә, жақсы көрінеді.
Dialogue: 0,0:30:14.34,0:30:17.55,Default,,0,0,0,,Сіз бұл суретті сатып алғыңыз келе ме? Амата эх...
Dialogue: 0,0:30:17.55,0:30:20.41,Default,,0,0,0,,Нағыз қыздар фотодан жақсы
Dialogue: 0,0:30:20.41,0:30:22.92,Default,,0,0,0,,Менің ойымша, бұл өте жақсы.
Dialogue: 0,0:30:22.92,0:30:25.72,Default,,0,0,0,,Мен... Уау.
Dialogue: 0,0:30:25.72,0:30:29.49,Default,,0,0,0,,Е-е... Ей... Әй, эй! Ах...
Dialogue: 0,0:30:29.49,0:30:31.86,Default,,0,0,0,,Өйткені, кез келген адам жүзе алады, Амата-кун.
Dialogue: 0,0:30:31.86,0:30:34.60,Default,,0,0,0,,Жоқ, бұл дұрыс емес.
Dialogue: 0,0:30:34.60,0:30:36.83,Default,,0,0,0,,А, иә, кешіріңіз.
Dialogue: 0,0:30:36.83,0:30:39.67,Default,,0,0,0,,А?
Dialogue: 0,0:30:39.67,0:30:44.00,Default,,0,0,0,,А, а, а... с...
Dialogue: 0,0:30:44.00,0:30:46.61,Default,,0,0,0,,А... саған ұнап қалған сияқты.
Dialogue: 0,0:30:46.61,0:30:50.28,Default,,0,0,0,,Сексуалды адам, солай емес пе... иә?
Dialogue: 0,0:30:50.28,0:30:53.75,Default,,0,0,0,,А, мына фотоны маған берші, иә?
Dialogue: 0,0:30:53.75,0:30:58.32,Default,,0,0,0,,Бұл? Жарайды, бірақ... 500 кулон.
Dialogue: 0,0:30:58.32,0:31:00.89,Default,,0,0,0,,Не?
Dialogue: 0,0:31:00.89,0:31:03.16,Default,,0,0,0,,Кімнің суреті? О, жоқ
Dialogue: 0,0:31:03.16,0:31:05.46,Default,,0,0,0,,Сараң! Маған көрсет
Dialogue: 0,0:31:05.46,0:31:10.06,Default,,0,0,0,,Амата-кун Амата Энди...
Dialogue: 0,0:31:10.06,0:31:12.37,Default,,0,0,0,,Менде ондай ой болған жоқ.
Dialogue: 0,0:31:12.37,0:31:16.00,Default,,0,0,0,,Иә? мен...
Dialogue: 0,0:31:16.00,0:31:19.31,Default,,0,0,0,,Ей, қазба ағайындар! Ухахаха...
Dialogue: 0,0:31:19.31,0:31:22.58,Default,,0,0,0,,Керемет, таптым!
Dialogue: 0,0:31:22.58,0:31:25.88,Default,,0,0,0,,үшін? иә?
Dialogue: 0,0:31:29.82,0:31:32.19,Default,,0,0,0,,Менің ойым қате болмаса
Dialogue: 0,0:31:32.19,0:31:35.22,Default,,0,0,0,,Бұл «Егіз жұлдызды кітап» деп аталатын нәрсе болуы мүмкін
Dialogue: 0,0:31:35.22,0:31:38.66,Default,,0,0,0,,«Егіз жұлдызды кітап»? Мен ол туралы естідім
Dialogue: 0,0:31:38.66,0:31:41.66,Default,,0,0,0,,Ах... алған адам
Dialogue: 0,0:31:41.66,0:31:45.33,Default,,0,0,0,,Тыйым салынған Акварионды еркін басқаруға болады дейді.
Dialogue: 0,0:31:45.33,0:31:47.27,Default,,0,0,0,,Бұл аңызға айналған кітап, солай емес пе?
Dialogue: 0,0:31:47.27,0:31:49.67,Default,,0,0,0,,Ах... солай...
Dialogue: 0,0:31:49.67,0:31:52.01,Default,,0,0,0,,Жасыл мысық дұрыс айтады.
Dialogue: 0,0:31:52.01,0:31:55.24,Default,,0,0,0,,Шамасы, Neo Diva оны құрылғаннан бері іздеген.
Dialogue: 0,0:31:55.24,0:31:58.28,Default,,0,0,0,,Энди мұндай таңғажайып нәрсені қалай көтере алды?
Dialogue: 0,0:31:58.28,0:32:00.48,Default,,0,0,0,,Оны қайдан таптың?
Dialogue: 0,0:32:00.48,0:32:03.32,Default,,0,0,0,,Мынау тесік... ойбай.
Dialogue: 0,0:32:03.32,0:32:08.66,Default,,0,0,0,,Жоқ, дәл қазір бұл маңызды емес.
Dialogue: 0,0:32:08.66,0:32:11.56,Default,,0,0,0,,Төраға Клэр, шындықты айтатын кез келді.
Dialogue: 0,0:32:11.56,0:32:13.79,Default,,0,0,0,,Маған айтып бере аласыз ба?
Dialogue: 0,0:32:13.79,0:32:15.73,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:32:15.73,0:32:18.10,Default,,0,0,0,,Сапардан қайтқанда нені білдіреді?
Dialogue: 0,0:32:18.10,0:32:20.40,Default,,0,0,0,,Қарастырылып отырған затты таппадың ба?
Dialogue: 0,0:32:20.40,0:32:22.34,Default,,0,0,0,,Мысал туралы не деуге болады?
Dialogue: 0,0:32:22.34,0:32:27.11,Default,,0,0,0,,Аа, мен бұл туралы мүлдем ұмытып кеттім.
Dialogue: 0,0:32:27.11,0:32:30.71,Default,,0,0,0,,Алдамаңыз! Сізге ұнамайды ма?
Dialogue: 0,0:32:30.71,0:32:33.75,Default,,0,0,0,,Жоқ, мәселе бұл емес.
Dialogue: 0,0:32:33.75,0:32:36.38,Default,,0,0,0,,Көзге көрінбейтін
Dialogue: 0,0:32:36.38,0:32:42.49,Default,,0,0,0,,Көрмейтін көз алдында кітап ашылады.
Dialogue: 0,0:32:42.49,0:32:45.53,Default,,0,0,0,,Ал, төменгі екі дан жалғауы
Dialogue: 0,0:32:45.53,0:32:49.26,Default,,0,0,0,,Керо Керо Керо?
Dialogue: 0,0:32:49.26,0:32:52.23,Default,,0,0,0,,болды ма? аа!
Dialogue: 0,0:32:52.23,0:32:55.50,Default,,0,0,0,,Классикалық әдебиет сабағына көбірек көңіл бөлуім керек еді.
Dialogue: 0,0:32:55.50,0:32:58.41,Default,,0,0,0,,Әй, Амата, сен де маған көмектесе аласың.
Dialogue: 0,0:32:58.41,0:33:00.94,Default,,0,0,0,,Ой...
Dialogue: 0,0:33:00.94,0:33:06.34,Default,,0,0,0,,Хо хо хору хору хоре хоре хоре?
Dialogue: 0,0:33:10.35,0:33:14.35,Default,,0,0,0,,Мен ол адамнан кешірім сұрауым керек.
Dialogue: 0,0:33:16.16,0:33:21.06,Default,,0,0,0,,Миконо мырза, кешірім сұрау дегенді қалай түсінесіз?
Dialogue: 0,0:33:26.80,0:33:29.30,Default,,0,0,0,,Жақсы! Бұл тамаша!
Dialogue: 0,0:33:32.04,0:33:33.97,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:33:33.97,0:33:37.34,Default,,0,0,0,,Шұлықтың түсі ақ немесе көкшіл көкпен шектелуі керек.
Dialogue: 0,0:33:37.34,0:33:41.28,Default,,0,0,0,,Иә? Түні бойы ұйықтамай, ақыры шешіп алған сөйлем
Dialogue: 0,0:33:41.28,0:33:45.65,Default,,0,0,0,,Иә, Aquarion қуатын қалай арттыруға болады.
Dialogue: 0,0:33:45.65,0:33:47.72,Default,,0,0,0,,23-тарау 1-бөлім
Dialogue: 0,0:33:47.72,0:33:50.62,Default,,0,0,0,,Шұлықтардың Акварионға қатысы бар ма?
Dialogue: 0,0:33:50.62,0:33:53.93,Default,,0,0,0,,Хе, бұл жай ғана гипотеза.
Dialogue: 0,0:33:53.93,0:33:56.50,Default,,0,0,0,,Ежелгі кәсіпқой күрес жарыстарында да
Dialogue: 0,0:33:56.50,0:33:59.03,Default,,0,0,0,,Аяқ киімі шешілген ойыншылардың күші жойылады деп айтылады.
Dialogue: 0,0:33:59.03,0:34:01.27,Default,,0,0,0,,Бір теория болған сияқты
Dialogue: 0,0:34:01.27,0:34:04.17,Default,,0,0,0,,Аяқ - адамның энергиясын басқаратын ең маңызды нәрсе.
Dialogue: 0,0:34:04.17,0:34:06.24,Default,,0,0,0,,Бұл бөліктердің бірі.
Dialogue: 0,0:34:06.24,0:34:09.11,Default,,0,0,0,,Осындай маңызды жерлерді жабатын матаның түсі де
Dialogue: 0,0:34:09.11,0:34:11.48,Default,,0,0,0,,Бұл маңызды элемент.
Dialogue: 0,0:34:11.48,0:34:15.05,Default,,0,0,0,,Маңызды жерлерді жабатын матаның түсі қандай?
Dialogue: 0,0:34:15.05,0:34:18.72,Default,,0,0,0,,Фуун ашық көк жиек
Dialogue: 0,0:34:18.72,0:34:20.72,Default,,0,0,0,,А...
Dialogue: 0,0:34:20.72,0:34:23.66,Default,,0,0,0,,Уау, уау... Ах...
Dialogue: 0,0:34:23.66,0:34:26.09,Default,,0,0,0,,Мені қандай түсті деп ойлайсыңдар? сурет?
Dialogue: 0,0:34:26.09,0:34:29.46,Default,,0,0,0,,Ой, балалар, мұқият тыңдауларың керек.
Dialogue: 0,0:34:29.46,0:34:32.23,Default,,0,0,0,,Ежелгі құжаттың мазмұны қандай?
Dialogue: 0,0:34:32.23,0:34:35.54,Default,,0,0,0,,Ах... Ах...
Dialogue: 0,0:34:35.54,0:34:38.14,Default,,0,0,0,,Ал, бұл қандай үндеу?
Dialogue: 0,0:34:38.14,0:34:40.21,Default,,0,0,0,,Ежелгі құжаттармен не болды?
Dialogue: 0,0:34:40.21,0:34:42.64,Default,,0,0,0,,Энди оны тапты.
Dialogue: 0,0:34:42.64,0:34:45.55,Default,,0,0,0,,Аа, көрейін...
Dialogue: 0,0:34:45.55,0:34:48.88,Default,,0,0,0,,О, сен MIX оқи аласың ба?
Dialogue: 0,0:34:48.88,0:34:52.42,Default,,0,0,0,,Мен классикалық жапон тілін жақсы білемін, у...
Dialogue: 0,0:34:52.42,0:34:55.32,Default,,0,0,0,,Бірінші түймені дұрыс бекіту керек.
Dialogue: 0,0:34:55.32,0:34:58.09,Default,,0,0,0,,Иә? Бірінші түйме?
Dialogue: 0,0:34:58.09,0:35:00.89,Default,,0,0,0,,Жарылыс қастарды жаппауы керек
Dialogue: 0,0:35:00.89,0:35:04.16,Default,,0,0,0,,Жарылыс? Шашыңызды боямауыңыз керек
Dialogue: 0,0:35:04.16,0:35:07.07,Default,,0,0,0,,Юбкалар тізеден 5 см төмен болуы керек.
Dialogue: 0,0:35:07.07,0:35:10.64,Default,,0,0,0,,Мен дәлізде жүгіре алмаймын, мүмкін
Dialogue: 0,0:35:10.64,0:35:14.04,Default,,0,0,0,,Ендеше, бұл көне мектеп ережесі емес пе?
Dialogue: 0,0:35:14.04,0:35:17.44,Default,,0,0,0,,Студенттік анықтамалық немесе басқа нәрсе туралы не деуге болады?
Dialogue: 0,0:35:19.38,0:35:21.38,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:35:31.73,0:35:35.33,Default,,0,0,0,,Ең күшті Сирек Игларды табу
Dialogue: 0,0:35:35.33,0:35:37.63,Default,,0,0,0,,Мен тағы да Вегаға баруым керек.
Dialogue: 0,0:35:40.07,0:35:43.94,Default,,0,0,0,,Мен осы уақытқа дейін көптеген сирек кездесетін игларларды жинадым.
Dialogue: 0,0:35:43.94,0:35:47.67,Default,,0,0,0,,Олардың барлығы өлшемді тасымалдау процесінде өлді.
Dialogue: 0,0:35:47.67,0:35:51.04,Default,,0,0,0,,Немесе табиғаты бойынша өзгерген.
Dialogue: 0,0:35:51.04,0:35:56.85,Default,,0,0,0,,Маған Алисияның болуы жеткілікті.
Dialogue: 0,0:35:56.85,0:36:01.15,Default,,0,0,0,,Джин, менің Альтейімнің тағдыры қыл үстінде.
Dialogue: 0,0:36:04.22,0:36:06.19,Default,,0,0,0,,Бірінші өзгеріс болды
Dialogue: 0,0:36:06.19,0:36:11.00,Default,,0,0,0,,Жаңа туған қыздар енді бұл планетада дүниеге келмеді.
Dialogue: 0,0:36:11.00,0:36:13.90,Default,,0,0,0,,Ақырында белгісіз ауруға байланысты
Dialogue: 0,0:36:13.90,0:36:16.80,Default,,0,0,0,,Барлық әйелдер қайтыс болды
Dialogue: 0,0:36:16.80,0:36:21.30,Default,,0,0,0,,Алтеа әлемінде тек ер адамдар қалды.
Dialogue: 0,0:36:25.38,0:36:29.25,Default,,0,0,0,,Біздің мақсатымыз Вегаға басып кіру емес.
Dialogue: 0,0:36:29.25,0:36:33.49,Default,,0,0,0,,Тек түрдің өмір сүруін қамтамасыз ету үшін.
Dialogue: 0,0:36:33.49,0:36:37.82,Default,,0,0,0,,Өлшемді тасымалдауға төтеп бере алатын ең күшті сирек Игларды табыңыз.
Dialogue: 0,0:36:37.82,0:36:41.66,Default,,0,0,0,,Біз оны шынайы Хауа ретінде қарсы алуымыз керек.
Dialogue: 0,0:36:41.66,0:36:46.93,Default,,0,0,0,,Менің Альтейімнің кейінгі ұрпағын жасайтын келін ретінде.
Dialogue: 0,0:36:46.93,0:36:48.90,Default,,0,0,0,,Ең күшті сирек кездесетін Иглер
Dialogue: 0,0:36:48.90,0:36:52.30,Default,,0,0,0,,Механикалық періштенің бортында болу мүмкіндігі жоғары
Dialogue: 0,0:36:54.54,0:36:57.54,Default,,0,0,0,,Түсіндім, Бас қолбасшы Изумо.
Dialogue: 0,0:36:57.54,0:37:01.45,Default,,0,0,0,,Бұл жолы қашықтан емес, тікелей барамын.
Dialogue: 0,0:37:01.45,0:37:07.65,Default,,0,0,0,,Мен сенен өтіндім, Джин, Альтейден туған соңғы бала.
Dialogue: 0,0:37:10.32,0:37:13.23,Default,,0,0,0,,Өте күшейтілген оптикалық сенсор
Dialogue: 0,0:37:13.23,0:37:15.20,Default,,0,0,0,,Өткен шайқастан сабақ алу
Dialogue: 0,0:37:15.20,0:37:18.10,Default,,0,0,0,,Қатты оқтарға назар аудару
Dialogue: 0,0:37:18.10,0:37:21.30,Default,,0,0,0,,Иә, инфильтрациялық оқтарды ұмытпаңыз.
Dialogue: 0,0:37:21.30,0:37:24.30,Default,,0,0,0,,Мәре әлі де ауыр сауыт
Dialogue: 0,0:37:24.30,0:37:27.20,Default,,0,0,0,,Керемет темір қалқан
Dialogue: 0,0:37:29.14,0:37:32.31,Default,,0,0,0,,Не? Мен қатты ұялып тұрмын.
Dialogue: 0,0:37:32.31,0:37:35.18,Default,,0,0,0,,Бірақ бұл көне оқушы дәптері.
Dialogue: 0,0:37:35.18,0:37:37.52,Default,,0,0,0,,Бұл керемет жаңалық болуы мүмкін.
Dialogue: 0,0:37:37.52,0:37:41.39,Default,,0,0,0,,Оны Нео Кулон қаласындағы мұражайға сыйға тарту туралы не айтасыз?
Dialogue: 0,0:37:41.39,0:37:45.06,Default,,0,0,0,,Бірақ бұл тек қана тасталған мектеп ережелері.
Dialogue: 0,0:37:45.06,0:37:47.56,Default,,0,0,0,,Шаш үлгісі, белдемше ұзындығы және т.б.
Dialogue: 0,0:37:47.56,0:37:51.23,Default,,0,0,0,,Жақсы! Ескіге барыңыз, жаңаны ашыңыз
Dialogue: 0,0:37:51.23,0:37:54.13,Default,,0,0,0,,Neo Divas да ескі жақсы күндерді ұстанады
Dialogue: 0,0:37:54.13,0:37:56.44,Default,,0,0,0,,Мектеп ережелерін күшейту керек.
Dialogue: 0,0:37:56.44,0:37:59.84,Default,,0,0,0,,Иә? Мен біраздан бері солай ойлап жүрмін
Dialogue: 0,0:37:59.84,0:38:01.78,Default,,0,0,0,,Джессиканың киімі тым ашық
Dialogue: 0,0:38:01.78,0:38:04.48,Default,,0,0,0,,Сіз ұлдардың алдында тым қорғансызсыз.
Dialogue: 0,0:38:04.48,0:38:06.55,Default,,0,0,0,,Иә? Менің ойымша, солай
Dialogue: 0,0:38:06.55,0:38:09.35,Default,,0,0,0,,Ең алдымен қасиетті оқуда
Dialogue: 0,0:38:09.35,0:38:11.65,Default,,0,0,0,,Ішіңнің тұнбасын көрсетудің не кінәсі бар?
Dialogue: 0,0:38:11.65,0:38:14.05,Default,,0,0,0,,Бұл іш киіммен бірдей дерлік.
Dialogue: 0,0:38:14.05,0:38:17.92,Default,,0,0,0,,Іш киім? Хаа
Dialogue: 0,0:38:17.92,0:38:20.63,Default,,0,0,0,,Бірден, тіпті киімге қатысты ережелер
Dialogue: 0,0:38:20.63,0:38:22.63,Default,,0,0,0,,Оны орнатқан дұрыс болар еді.
Dialogue: 0,0:38:22.63,0:38:26.27,Default,,0,0,0,,Жақсы Джессика, болашақта шамадан тыс экспозиция болмайды.
Dialogue: 0,0:38:26.27,0:38:29.70,Default,,0,0,0,,Адамдарды енді эксгибиционист деп атамаңыз.
Dialogue: 0,0:38:29.70,0:38:32.91,Default,,0,0,0,,Әй, Амата, қарнын көрсету жаман ба?
Dialogue: 0,0:38:32.91,0:38:37.61,Default,,0,0,0,,Жарайды, оны іштің түймесі деп атаған жөн.
Dialogue: 0,0:38:37.61,0:38:42.22,Default,,0,0,0,,Ух... уау уау уау!
Dialogue: 0,0:38:42.22,0:38:45.12,Default,,0,0,0,,Шынында да түсінуге оңай.
Dialogue: 0,0:38:45.12,0:38:47.82,Default,,0,0,0,,Шу Шу Хмм!
Dialogue: 0,0:39:08.34,0:39:11.11,Default,,0,0,0,,Эй Шу Шу Шу?
Dialogue: 0,0:39:11.11,0:39:15.72,Default,,0,0,0,,Ақырында, ұлдар батыл киімді ұнатады деп ойлаймын.
Dialogue: 0,0:39:15.72,0:39:20.49,Default,,0,0,0,,Шу, эй, менің де сондай киімім бар еді.
Dialogue: 0,0:39:20.49,0:39:22.92,Default,,0,0,0,,Джессика, қайсысы?
Dialogue: 0,0:39:22.92,0:39:25.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:39:25.26,0:39:27.56,Default,,0,0,0,,Мен сізге көбірек көрсетуім керек пе?
Dialogue: 0,0:39:27.56,0:39:30.26,Default,,0,0,0,,Бұл сізге таңқаларлықтай жақсы көрінбейді ме?
Dialogue: 0,0:39:30.26,0:39:34.90,Default,,0,0,0,,Мен... Мен сенен басқамын!
Dialogue: 0,0:39:34.90,0:39:37.60,Default,,0,0,0,,Абдуктор Нео Кулон аймағында пайда болады
Dialogue: 0,0:39:44.58,0:39:48.15,Default,,0,0,0,,Кел, механикалық періште, шық!
Dialogue: 0,0:39:48.15,0:39:51.45,Default,,0,0,0,,Нео Кулон аймағы қайтадан нысана болып табылады
Dialogue: 0,0:39:51.45,0:39:54.45,Default,,0,0,0,,Мақсат адамдарды ұрлау емес сияқты.
Dialogue: 0,0:39:54.45,0:39:58.63,Default,,0,0,0,,Фудо Олардың мақсаты ма деп ойлаймын
Dialogue: 0,0:39:58.63,0:40:03.23,Default,,0,0,0,,Радиус Гунис Ауыр Сауыт түрі
Dialogue: 0,0:40:03.23,0:40:06.67,Default,,0,0,0,,Акварион сорты! Басы - Амат
Dialogue: 0,0:40:06.67,0:40:09.47,Default,,0,0,0,,Ал Джессика Миконо Миконо?
Dialogue: 0,0:40:09.47,0:40:13.11,Default,,0,0,0,,Бірақ ол мен сияқты...
Dialogue: 0,0:40:13.11,0:40:15.21,Default,,0,0,0,,Бірінші
Dialogue: 0,0:40:30.96,0:40:34.66,Default,,0,0,0,,Вектор Зед ұшады
Dialogue: 0,0:40:34.66,0:40:38.23,Default,,0,0,0,,Векторлық Chiron ұшыру
Dialogue: 0,0:40:38.23,0:40:41.03,Default,,0,0,0,,Векторлық Ix Басталуы
Dialogue: 0,0:40:54.35,0:40:56.65,Default,,0,0,0,,Жаудың ұрлаушысы Ах
Dialogue: 0,0:40:56.65,0:41:00.05,Default,,0,0,0,,Миконо-сан, өзіңізді ұстаңыз Ах...
Dialogue: 0,0:41:00.05,0:41:04.45,Default,,0,0,0,,Go Aquarion қорғаныс комбинациясы
Dialogue: 0,0:41:17.90,0:41:22.18,Default,,0,0,0,,Aquarion EVOL
Dialogue: 0,0:41:22.18,0:41:24.74,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:41:24.74,0:41:27.58,Default,,0,0,0,,Миконо-сан... сіз ұрлаушы.
Dialogue: 0,0:41:27.58,0:41:32.25,Default,,0,0,0,,Мен мәселені асығыс шешемін.
Dialogue: 0,0:41:32.25,0:41:35.25,Default,,0,0,0,,Шексіз соққы
Dialogue: 0,0:41:41.76,0:41:43.70,Default,,0,0,0,,А... қиын
Dialogue: 0,0:41:43.70,0:41:46.63,Default,,0,0,0,,Мен бұл техниканы бұрын да алғанмын.
Dialogue: 0,0:41:46.63,0:41:49.13,Default,,0,0,0,,Мен бір нәрсені екі рет жасамаймын
Dialogue: 0,0:41:56.61,0:41:58.85,Default,,0,0,0,,Бұл сирек кездесетін иглер ме?
Dialogue: 0,0:41:58.85,0:42:02.72,Default,,0,0,0,,Не? Сильфидің аяғына да жақын емес.
Dialogue: 0,0:42:02.72,0:42:06.39,Default,,0,0,0,,Тоқта, тоқта, Джин.
Dialogue: 0,0:42:06.39,0:42:11.22,Default,,0,0,0,,Бұнымен араласпа, бұл менің блять қаншық.
Dialogue: 0,0:42:11.22,0:42:13.69,Default,,0,0,0,,Ах!
Dialogue: 0,0:42:13.69,0:42:17.33,Default,,0,0,0,,О, қандай мұңды дауыс
Dialogue: 0,0:42:17.33,0:42:20.53,Default,,0,0,0,,Жыласаң, қаттырақ сөйле
Dialogue: 0,0:42:20.53,0:42:25.37,Default,,0,0,0,,Мен барған сайын қызғаншақ болып барамын Кагура
Dialogue: 0,0:42:25.37,0:42:28.81,Default,,0,0,0,,Жақын адамынан айырылу қайғысы
Dialogue: 0,0:42:28.81,0:42:31.41,Default,,0,0,0,,Оны барынша дәм татыңыз
Dialogue: 0,0:42:39.29,0:42:42.39,Default,,0,0,0,,Мен Сирек Иглардың күшін сынаймын.
Dialogue: 0,0:42:46.83,0:42:48.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:42:59.14,0:43:02.01,Default,,0,0,0,,Акварионның сыртқы сауытында зақым жоқ.
Dialogue: 0,0:43:02.01,0:43:04.44,Default,,0,0,0,,Бірақ элементтерге әсері
Dialogue: 0,0:43:04.44,0:43:06.98,Default,,0,0,0,,Бұл инфильтрациялық оқ болуы мүмкін бе?
Dialogue: 0,0:43:06.98,0:43:10.72,Default,,0,0,0,,Соққы толқынын Акварионның табиғи жиілігімен резонансты етіңіз
Dialogue: 0,0:43:10.72,0:43:13.22,Default,,0,0,0,,Сіз ішке тікелей шабуыл жасайсыз ба?
Dialogue: 0,0:43:26.20,0:43:29.80,Default,,0,0,0,,Миконо! Коалесценция индексі тез төмендейді
Dialogue: 0,0:43:29.80,0:43:32.30,Default,,0,0,0,,Одақ жойылады
Dialogue: 0,0:43:43.68,0:43:47.99,Default,,0,0,0,,Қарашы, менен көзіңді алма, тіке қара.
Dialogue: 0,0:43:47.99,0:43:52.93,Default,,0,0,0,,Рея Игларыңызды жындар таптап жатқанын қараңыз.
Dialogue: 0,0:43:52.93,0:43:56.83,Default,,0,0,0,,Тоқта, тоқта!
Dialogue: 0,0:44:01.97,0:44:05.00,Default,,0,0,0,,Тым әлсіз Бұл әлсіз адамдар
Dialogue: 0,0:44:05.00,0:44:07.77,Default,,0,0,0,,Бұл нағыз Хауа болуы мүмкін емес.
Dialogue: 0,0:44:07.77,0:44:10.28,Default,,0,0,0,,Элемент костюмі осындай күйде.
Dialogue: 0,0:44:10.28,0:44:14.01,Default,,0,0,0,,Егер сол күйінде қалдырылса, соққы элементтің денесін тікелей зақымдайды.
Dialogue: 0,0:44:14.01,0:44:17.05,Default,,0,0,0,,Миконо! Мен оны енді қарай алмаймын
Dialogue: 0,0:44:17.05,0:44:19.75,Default,,0,0,0,,Мен элементті өзгертуді орындаймын.
Dialogue: 0,0:44:19.75,0:44:23.35,Default,,0,0,0,,Бас қолбасшы! Джессика, қаш!
Dialogue: 0,0:44:33.43,0:44:35.43,Default,,0,0,0,,Ах
Dialogue: 0,0:44:42.98,0:44:45.88,Default,,0,0,0,,Не? Ал қазір ше?
Dialogue: 0,0:44:50.62,0:44:54.52,Default,,0,0,0,,Мен доптың траекториясын дәл қазір терімде сездім.
Dialogue: 0,0:44:57.69,0:45:03.36,Default,,0,0,0,,Джессика машинасының қозғалысы! Фудо Бұл нені білдіреді?
Dialogue: 0,0:45:03.36,0:45:05.63,Default,,0,0,0,,Теріні жалаңаштау арқылы,
Dialogue: 0,0:45:05.63,0:45:07.63,Default,,0,0,0,,Сезім мүшелері өткірленеді
Dialogue: 0,0:45:07.63,0:45:12.11,Default,,0,0,0,,Киімдерің жыртылып, қорғансыз болғаны үшін.
Dialogue: 0,0:45:12.11,0:45:16.58,Default,,0,0,0,,Сіз жаудың шабуылына күрт жауап бере аласыз.
Dialogue: 0,0:45:16.58,0:45:20.45,Default,,0,0,0,,Бұл теріні неғұрлым көп шығарсаңыз, соғұрлым жау шабуылдарынан аулақ бола аласыз дегенді білдіре ме?
Dialogue: 0,0:45:20.45,0:45:23.78,Default,,0,0,0,,Сонымен... сен айтсаң да
Dialogue: 0,0:45:23.78,0:45:26.38,Default,,0,0,0,,Қазір салқын болатын уақыт емес.
Dialogue: 0,0:45:33.06,0:45:35.36,Default,,0,0,0,,Джессика! Ах
Dialogue: 0,0:45:38.36,0:45:40.46,Default,,0,0,0,,Мен де!
Dialogue: 0,0:45:50.38,0:45:52.31,Default,,0,0,0,,Миконо мырзаға
Dialogue: 0,0:45:52.31,0:45:54.95,Default,,0,0,0,,Миконо Джессиканың ақыл-ой деңгейінің жоғарылауы
Dialogue: 0,0:45:54.95,0:45:56.88,Default,,0,0,0,,Біріктіру мүмкін мәнге жетті
Dialogue: 0,0:45:56.88,0:46:01.82,Default,,0,0,0,,Енді қосылатын уақыт. Басы - Джессика Вонг.
Dialogue: 0,0:46:01.82,0:46:06.82,Default,,0,0,0,,Қорғалмаған комбинация Go Aquarion
Dialogue: 0,0:46:18.17,0:46:21.07,Default,,0,0,0,,Жоқ, менің жалаңаш терім сезімтал болып кетті.
Dialogue: 0,0:46:21.07,0:46:24.97,Default,,0,0,0,,Сіздің денеңіздің әрбір мүшесі қызықты!
Dialogue: 0,0:46:28.68,0:46:32.58,Default,,0,0,0,,Акварион спада
Dialogue: 0,0:46:35.32,0:46:39.06,Default,,0,0,0,,Амата-кунның маған деген көзқарасын сеземін. Не істеуім керек?
Dialogue: 0,0:46:39.06,0:46:42.86,Default,,0,0,0,,Микононың ақыл-ойының ұят деңгейі одан әрі артады
Dialogue: 0,0:46:42.86,0:46:46.17,Default,,0,0,0,,Қарама-қарсы жынысты көру дегенді қалай түсінесің?
Dialogue: 0,0:46:46.17,0:46:49.10,Default,,0,0,0,,Денең қызарып кетті, мен айта аламын.
Dialogue: 0,0:46:49.10,0:46:51.54,Default,,0,0,0,,Не? Эх...
Dialogue: 0,0:46:51.54,0:46:55.54,Default,,0,0,0,,Жарайды, ұялатын ештеңе жоқ.
Dialogue: 0,0:46:57.64,0:47:00.58,Default,,0,0,0,,Біз қосылсақ та, жағдай өзгермейді.
Dialogue: 0,0:47:00.58,0:47:02.78,Default,,0,0,0,,Өлетін уақыт жаман ғой, солай емес пе?
Dialogue: 0,0:47:04.92,0:47:08.45,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:47:08.45,0:47:12.33,Default,,0,0,0,,Менің жүйкем ұшталып қалды
Dialogue: 0,0:47:12.33,0:47:14.93,Default,,0,0,0,,Мен бәрін анық сезінемін
Dialogue: 0,0:47:21.80,0:47:24.30,Default,,0,0,0,,Жалтардыңыз ба?
Dialogue: 0,0:47:27.71,0:47:32.15,Default,,0,0,0,,Толығырақ! көбірек! о!
Dialogue: 0,0:47:32.15,0:47:35.68,Default,,0,0,0,,Джессиканың рух деңгейі әзірге ең жоғары
Dialogue: 0,0:47:35.68,0:47:38.59,Default,,0,0,0,,Мен де барамын! Кяах
Dialogue: 0,0:47:38.59,0:47:41.69,Default,,0,0,0,,Бұл ұят, бірақ...
Dialogue: 0,0:47:45.76,0:47:48.33,Default,,0,0,0,,Бұл концерт.
Dialogue: 0,0:47:48.33,0:47:52.63,Default,,0,0,0,,Мен оны шынымен ойнай алмаймын.
Dialogue: 0,0:47:57.50,0:48:02.11,Default,,0,0,0,,Бұл ұят пен бостандық арасындағы кескілескен тартыс.
Dialogue: 0,0:48:02.11,0:48:06.11,Default,,0,0,0,,Теріңізді қызартып, етіңізді кесіңіз.
Dialogue: 0,0:48:13.35,0:48:17.95,Default,,0,0,0,,Қабыл ал, күзетші шабуыл жасама!
Dialogue: 0,0:48:27.87,0:48:31.60,Default,,0,0,0,,Осындай абайсыз стратегия үшін ойын аяқталды
Dialogue: 0,0:48:31.60,0:48:34.20,Default,,0,0,0,,Бұл қызметші...
Dialogue: 0,0:48:37.18,0:48:40.88,Default,,0,0,0,,Иә!
Dialogue: 0,0:48:40.88,0:48:43.78,Default,,0,0,0,,Иә! иә?
Dialogue: 0,0:48:43.78,0:48:45.98,Default,,0,0,0,,Ой, кешіріңіз!
Dialogue: 0,0:48:48.02,0:48:51.52,Default,,0,0,0,,Мен неге сонша толқып тұрмын?
Dialogue: 0,0:48:53.96,0:48:56.73,Default,,0,0,0,,Шабуыл – ең жақсы қорғаныс
Dialogue: 0,0:48:56.73,0:49:00.73,Default,,0,0,0,,Ал қорғансыздық – ең басты қару
Dialogue: 0,0:49:00.73,0:49:03.90,Default,,0,0,0,,Мен мұндай масқара тактикаға шыдай алмаймын.
Dialogue: 0,0:49:03.90,0:49:08.50,Default,,0,0,0,,Барлық адамдар жалаңаш туылады.
Dialogue: 0,0:49:11.04,0:49:13.05,Default,,0,0,0,,Тамаша!
Dialogue: 0,0:49:13.05,0:49:16.35,Default,,0,0,0,,Дегенмен, бұл әдіс екі жүзді қылыш.
Dialogue: 0,0:49:16.35,0:49:18.38,Default,,0,0,0,,Өткір сезімдерге айырбас
Dialogue: 0,0:49:18.38,0:49:21.38,Default,,0,0,0,,Элементтің өзіндік қорғаныс күші нөлге тең болады.
Dialogue: 0,0:49:23.49,0:49:28.09,Default,,0,0,0,,Әзірше оны пайдаланудан бас тартқан дұрыс.
Dialogue: 0,0:49:30.83,0:49:33.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:49:33.50,0:49:36.40,Default,,0,0,0,,Өтірік... Мен мұндай фотоны қашан алдым?
Dialogue: 0,0:49:36.40,0:49:40.87,Default,,0,0,0,,Иә, 500 кулон!
Dialogue: 0,0:49:40.87,0:49:42.81,Default,,0,0,0,,О!
Dialogue: 0,0:49:42.81,0:49:44.81,Default,,0,0,0,,Мүмкін мен де алуым керек шығар. Мен де.
Dialogue: 0,0:49:44.81,0:49:48.31,Default,,0,0,0,,Жоқ! Мұны енді сатпаңыз!
Dialogue: 0,0:49:48.31,0:49:50.88,Default,,0,0,0,,Майдо! Джессика
Dialogue: 0,0:49:50.88,0:49:52.85,Default,,0,0,0,,Ондай жерде не істеп жүрсің?
Dialogue: 0,0:49:52.85,0:49:55.52,Default,,0,0,0,,Атап айтқанда, кез келген нәрсе болыңыз
Dialogue: 0,0:49:55.52,0:49:58.82,Default,,0,0,0,,Иә, жол көрсетуші бар! иә?
Dialogue: 0,0:51:36.49,0:51:40.36,Default,,0,0,0,,«Сен, сен» деп 10 рет айтып көріңіз.
Dialogue: 0,0:51:40.36,0:51:42.40,Default,,0,0,0,,Сен сен сен…
Dialogue: 0,0:51:42.40,0:51:46.17,Default,,0,0,0,,Ах! Мен тесіктерді жек көремін, мен оларды толтырғым келеді!
Dialogue: 0,0:51:46.17,0:51:49.77,Default,,0,0,0,,Next Aquarion EVOL «Ер мен әйел анаграммасы»
Dialogue: 0,0:51:51.27,0:51:57.27,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory