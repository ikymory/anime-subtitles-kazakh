Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.92,0:00:06.29,Default,,0,0,0,,Жауынгерлік кеме круизі!
Dialogue: 0,0:00:06.42,0:00:09.50,Default,,0,0,0,,Біз қазір борттағы Бладерлермен бірге жүземіз.
Dialogue: 0,0:00:13.43,0:00:17.76,Default,,0,0,0,,Сізді супер Цетсудың жарқыраған теңізі күтіп тұр
Dialogue: 0,0:00:17.93,0:00:21.89,Default,,0,0,0,,Алда ең күшті және жеңілмейтін атақ күтіп тұр.
Dialogue: 0,0:00:22.48,0:00:27.19,Default,,0,0,0,,Жүр, Бейблейдпен шытырман оқиғаға барайық.
Dialogue: 0,0:00:27.31,0:00:29.94,Default,,0,0,0,,Super Zetsu-дан басқа!
Dialogue: 0,0:00:31.53,0:00:33.78,Default,,0,0,0,,Аои Балтты жеңу үшін――
Dialogue: 0,0:00:33.86,0:00:35.53,Default,,0,0,0,,Мен арнайы жаттығулар жасауды шештім!
Dialogue: 0,0:00:35.66,0:00:36.53,Default,,0,0,0,,А... (барлығы) Иә?
Dialogue: 0,0:00:38.07,0:00:38.91,Default,,0,0,0,,Ұстаз!
Dialogue: 0,0:00:39.03,0:00:39.91,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:40.54,0:00:42.79,Default,,0,0,0,,Мастер... (Рандзиро Кияма) Әйтеуір...
Dialogue: 0,0:00:42.95,0:00:44.91,Default,,0,0,0,,Жанып жатқан ғибадатхана Кайза!
Dialogue: 0,0:00:45.00,0:00:45.83,Default,,0,0,0,,Хехе
Dialogue: 0,0:00:45.96,0:00:49.25,Default,,0,0,0,,Алдымен күшіңді тексеріп көрейін.
Dialogue: 0,0:00:49.92,0:00:52.01,Default,,0,0,0,,Осы үш адамға қарсы шайқас жасап көріңіз.
Dialogue: 0,0:00:52.21,0:00:54.72,Default,,0,0,0,,бәрібір 100 рет
Dialogue: 0,0:00:59.30,0:01:01.39,Default,,0,0,0,,100-ші рет! Келесі кім!
Dialogue: 0,0:01:02.18,0:01:03.14,Default,,0,0,0,,Мен сенің қарсыласыңмын.
Dialogue: 0,0:01:03.77,0:01:04.60,Default,,0,0,0,,Фу…
Dialogue: 0,0:01:09.94,0:01:10.77,Default,,0,0,0,,Оларды осы жаққа жіберіңізші.
Dialogue: 0,0:01:11.07,0:01:13.74,Default,,0,0,0,,Ааааааа!
Dialogue: 0,0:01:17.20,0:01:21.37,Default,,0,0,0,,Super Z Slash!
Dialogue: 0,0:01:23.08,0:01:25.33,Default,,0,0,0,,Уууу!
Dialogue: 0,0:01:33.00,0:01:36.38,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:01:37.05,0:01:42.10,Default,,0,0,0,,Ал WBBA әлем чемпионы атағы үшін матч ақыры басталады!
Dialogue: 0,0:01:42.89,0:01:43.77,Default,,0,0,0,,Жасайық!
Dialogue: 0,0:01:44.39,0:01:47.52,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:01:47.89,0:01:50.27,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:01:51.19,0:01:54.07,Default,,0,0,0,,Валькирияның жылдамдығы артты!
Dialogue: 0,0:01:54.98,0:01:55.82,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:01:56.24,0:01:59.32,Default,,0,0,0,,Жүр! Валькирия!
Dialogue: 0,0:02:02.49,0:02:05.12,Default,,0,0,0,,Ахиллес!
Dialogue: 0,0:02:05.20,0:02:06.04,Default,,0,0,0,,Уууу!
Dialogue: 0,0:02:06.16,0:02:07.62,Default,,0,0,0,,Уууу!
Dialogue: 0,0:02:07.71,0:02:09.37,Default,,0,0,0,,Ах... (Қызыл жүзді тайга) Ах!
Dialogue: 0,0:02:10.96,0:02:12.13,Default,,0,0,0,,Иә.
Dialogue: 0,0:02:19.01,0:02:19.88,Default,,0,0,0,,Не!
Dialogue: 0,0:02:30.15,0:02:32.19,Default,,0,0,0,,Қызыл жүз Айга бір ұпай!
Dialogue: 0,0:02:32.27,0:02:34.94,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:02:36.28,0:02:37.49,Default,,0,0,0,,Сіз...
Dialogue: 0,0:02:37.61,0:02:38.49,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:40.82,0:02:41.70,Default,,0,0,0,,Әй!
Dialogue: 0,0:02:42.74,0:02:43.70,Default,,0,0,0,,Айга...
Dialogue: 0,0:02:44.49,0:02:45.33,Default,,0,0,0,,Фу…
Dialogue: 0,0:02:46.79,0:02:52.79,Default,,0,0,0,,♪~
Dialogue: 0,0:04:09.12,0:04:15.12,Default,,0,0,0,,~♪
Dialogue: 0,0:04:16.67,0:04:19.30,Default,,0,0,0,,"Бальт Айгаға қарсы!!"
Dialogue: 0,0:04:25.13,0:04:27.18,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:04:27.72,0:04:29.31,Default,,0,0,0,,Сіз...
Dialogue: 0,0:04:30.43,0:04:31.47,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:32.68,0:04:33.52,Default,,0,0,0,,Ха…
Dialogue: 0,0:04:35.19,0:04:36.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:37.94,0:04:39.19,Default,,0,0,0,,Не болды?
Dialogue: 0,0:04:39.32,0:04:40.40,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:04:40.69,0:04:42.07,Default,,0,0,0,,Хмм.
Dialogue: 0,0:04:42.57,0:04:44.86,Default,,0,0,0,,Әй, Айға, ғажап емес пе!
Dialogue: 0,0:04:45.32,0:04:47.41,Default,,0,0,0,,Ах, дұрыс.
Dialogue: 0,0:04:47.53,0:04:48.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:55.54,0:04:57.46,Default,,0,0,0,,Келесі жолы міндетті түрде шешіңіз!
Dialogue: 0,0:04:57.92,0:05:00.59,Default,,0,0,0,,Сіз шынымен де күшейдіңіз.
Dialogue: 0,0:05:00.92,0:05:03.55,Default,,0,0,0,,Әй, бұл әлі олай емес.
Dialogue: 0,0:05:03.67,0:05:05.97,Default,,0,0,0,,Мен одан да күшті боламын!
Dialogue: 0,0:05:06.55,0:05:09.68,Default,,0,0,0,,Біз алғаш танысқанда осылай дедіңіз.
Dialogue: 0,0:05:09.80,0:05:11.97,Default,,0,0,0,,Ең күшті және жеңілмейтін болу
Dialogue: 0,0:05:12.18,0:05:15.35,Default,,0,0,0,,«Супер Цетсу» - ең күшті және жеңілмейтін!
Dialogue: 0,0:05:15.85,0:05:16.73,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:05:16.81,0:05:18.73,Default,,0,0,0,,Бірақ мен жеңемін!
Dialogue: 0,0:05:19.31,0:05:22.98,Default,,0,0,0,,Омені жеңіп, чемпион боламын!
Dialogue: 0,0:05:24.44,0:05:25.61,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:25.82,0:05:29.49,Default,,0,0,0,,Челленджер Red Blade Айга чемпионды арандатуда!
Dialogue: 0,0:05:29.82,0:05:31.83,Default,,0,0,0,,Жарайды! Ұлдар мен қыздар!
Dialogue: 0,0:05:31.95,0:05:33.95,Default,,0,0,0,,Сәлем! көзіңді аш
Dialogue: 0,0:05:34.08,0:05:37.00,Default,,0,0,0,,Балт Аои мен Айга Ред Блейд арасындағы қызу шайқас
Dialogue: 0,0:05:37.08,0:05:39.50,Default,,0,0,0,,Оны көзіңе жағып жібер!
Dialogue: 0,0:05:40.21,0:05:43.21,Default,,0,0,0,,Менің ағам чемпиондық белбеуінен айырылмайды.
Dialogue: 0,0:05:43.34,0:05:46.22,Default,,0,0,0,,Ах, Бал-нии ешқашан жеңілмейді.
Dialogue: 0,0:05:46.34,0:05:49.09,Default,,0,0,0,,Келесі жолы ұпайларыңызды қайтарып алуды ұмытпаңыз!
Dialogue: 0,0:05:49.22,0:05:51.39,Default,,0,0,0,,Үлкен аға төбелес!
Dialogue: 0,0:05:51.72,0:05:53.39,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:05:53.60,0:05:56.60,Default,,0,0,0,,Жарайды, тағы да қорғаныс...
Dialogue: 0,0:05:56.77,0:05:58.64,Default,,0,0,0,,Мммм тағдыр!
Dialogue: 0,0:05:58.73,0:06:01.77,Default,,0,0,0,,Тағдырдың екінші шайқасы басталсын!
Dialogue: 0,0:06:02.15,0:06:04.03,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:06:04.53,0:06:07.70,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:06:08.20,0:06:10.70,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:06:11.07,0:06:11.95,Default,,0,0,0,,(Изуку) Ах! (Гран Торино) Уа!
Dialogue: 0,0:06:12.91,0:06:17.21,Default,,0,0,0,,Енді екеуі де Бейді күшті соққымен сахнаға шығарды!
Dialogue: 0,0:06:17.50,0:06:19.58,Default,,0,0,0,,Z Қорғаныс!
Dialogue: 0,0:06:23.96,0:06:25.63,Default,,0,0,0,,Кеттік, Валькири!
Dialogue: 0,0:06:26.05,0:06:28.13,Default,,0,0,0,,Тез ату!
Dialogue: 0,0:06:28.72,0:06:31.30,Default,,0,0,0,,Сен ғана күшейіп жатқан жоқсың
Dialogue: 0,0:06:31.43,0:06:34.85,Default,,0,0,0,,Тіпті мен мықты жігіттермен күрестім!
Dialogue: 0,0:06:35.39,0:06:39.35,Default,,0,0,0,,Валькирияның үздіксіз шабуылдары! Ахиллес Сіз шыдай аласыз ба?
Dialogue: 0,0:06:39.64,0:06:43.11,Default,,0,0,0,,Мұндай шабуыл Ахиллеске қарсы болмайды!
Dialogue: 0,0:06:47.03,0:06:50.53,Default,,0,0,0,,Ол Валькиридің шабуылын тамаша жеңеді.
Dialogue: 0,0:06:50.66,0:06:52.03,Default,,0,0,0,,Керемет!
Dialogue: 0,0:06:52.16,0:06:53.78,Default,,0,0,0,,Чо Пани!
Dialogue: 0,0:06:53.91,0:06:56.33,Default,,0,0,0,,Айға әрқашан салқын
Dialogue: 0,0:06:56.66,0:06:59.08,Default,,0,0,0,,Менің қарсыласым күткендей.
Dialogue: 0,0:06:59.41,0:07:01.33,Default,,0,0,0,,Хэ, Аои Барто
Dialogue: 0,0:07:01.42,0:07:03.71,Default,,0,0,0,,Оме қаншалықты күшті болса да...
Dialogue: 0,0:07:03.84,0:07:05.84,Default,,0,0,0,,Мен одан да артықпын!
Dialogue: 0,0:07:06.13,0:07:08.46,Default,,0,0,0,,Сіз оны оңай жеңе аласыз ба?
Dialogue: 0,0:07:11.63,0:07:14.43,Default,,0,0,0,,Жеңіс реактивті ату!
Dialogue: 0,0:07:14.60,0:07:17.06,Default,,0,0,0,,Жүр!
Dialogue: 0,0:07:22.31,0:07:23.48,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:26.61,0:07:29.53,Default,,0,0,0,,Valkyrie Burst Finish жеңімпазы
Dialogue: 0,0:07:29.65,0:07:31.07,Default,,0,0,0,,2-1 пункттер!
Dialogue: 0,0:07:31.20,0:07:33.53,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:07:33.99,0:07:36.16,Default,,0,0,0,,Бұл Валькири!
Dialogue: 0,0:07:36.49,0:07:38.91,Default,,0,0,0,,Иә! Алақай!
Dialogue: 0,0:07:39.37,0:07:41.37,Default,,0,0,0,,Бал-нии бұрылды!
Dialogue: 0,0:07:41.50,0:07:44.42,Default,,0,0,0,,Мен саған ешқашан белбеуді бермеймін!
Dialogue: 0,0:07:47.67,0:07:48.75,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:07:48.88,0:07:51.34,Default,,0,0,0,,Керемет! Тревиан!
Dialogue: 0,0:07:51.47,0:07:54.80,Default,,0,0,0,,Балт Аои чемпион ретінде өзінің шынайы рухын көрсетті!
Dialogue: 0,0:07:55.01,0:07:58.43,Default,,0,0,0,,Күткендей, ұлы чемпион
Dialogue: 0,0:08:03.39,0:08:04.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:05.61,0:08:07.02,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:08:08.57,0:08:09.69,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:11.61,0:08:13.65,Default,,0,0,0,,Әрі қарай кеттік!
Dialogue: 0,0:08:14.61,0:08:16.24,Default,,0,0,0,,Гррр…
Dialogue: 0,0:08:23.25,0:08:24.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:24.58,0:08:29.55,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:08:32.72,0:08:35.30,Default,,0,0,0,,Сондай-ақ сиқыр сенің ерніңе де әсер етсін…
Dialogue: 0,0:08:36.93,0:08:38.43,Default,,0,0,0,,Балто! Ах...
Dialogue: 0,0:08:39.39,0:08:41.97,Default,,0,0,0,,Оманы жойыңыз!
Dialogue: 0,0:08:44.98,0:08:47.19,Default,,0,0,0,,Айга сен...
Dialogue: 0,0:08:47.40,0:08:50.69,Default,,0,0,0,,Ууууууу... (Ахиллестің ырылдауы)
Dialogue: 0,0:08:51.53,0:08:52.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:53.53,0:08:55.24,Default,,0,0,0,,Әй... Қызыл жүз Айга
Dialogue: 0,0:08:55.36,0:08:58.32,Default,,0,0,0,,Жауынгерлік рухыңызды ашыңыз және чемпион болуға ұмтылыңыз!
Dialogue: 0,0:08:58.45,0:09:00.54,Default,,0,0,0,,Бұл қорқынышты рух!
Dialogue: 0,0:09:02.04,0:09:04.37,Default,,0,0,0,,Жасайық Валькирия
Dialogue: 0,0:09:06.50,0:09:07.63,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:09:07.71,0:09:10.96,Default,,0,0,0,,Қызу шайқас үшінші шайқасқа енді!
Dialogue: 0,0:09:11.09,0:09:15.59,Default,,0,0,0,,Бұрыштағы қызыл жүз Айга қарсы шығады!
Dialogue: 0,0:09:16.72,0:09:19.76,Default,,0,0,0,,Жеңген мен, Жеңген мен...
Dialogue: 0,0:09:20.26,0:09:22.39,Default,,0,0,0,,Мен жеңген адаммын
Dialogue: 0,0:09:23.47,0:09:24.64,Default,,0,0,0,,Айга...
Dialogue: 0,0:09:29.81,0:09:31.98,Default,,0,0,0,,Бір кадрда шешім қабылдаңыз
Dialogue: 0,0:09:35.07,0:09:38.36,Default,,0,0,0,,Ол шабуыл режимінде жеңіске жетуге тырысады.
Dialogue: 0,0:09:38.91,0:09:42.41,Default,,0,0,0,,Бетпе-бет шайқас, Айғаға ұқсайды
Dialogue: 0,0:09:42.99,0:09:43.83,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:45.50,0:09:47.87,Default,,0,0,0,,Шабуыл режиміндегі бетпе-бет шайқас
Dialogue: 0,0:09:48.00,0:09:50.88,Default,,0,0,0,,Қызық Мен қабылдаймын!
Dialogue: 0,0:09:51.88,0:09:52.88,Default,,0,0,0,,Үшінші шайқас
Dialogue: 0,0:09:55.55,0:09:57.63,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:09:58.22,0:10:01.30,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:10:01.55,0:10:03.97,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:10:07.69,0:10:08.56,Default,,0,0,0,,Шешіңіз!
Dialogue: 0,0:10:10.94,0:10:13.98,Default,,0,0,0,,Шабуыл шабуыл шабуылы!
Dialogue: 0,0:10:14.11,0:10:17.82,Default,,0,0,0,,Бұл екі жақтың да кері қадам жасамайтын шабуылдар алмасуы!
Dialogue: 0,0:10:18.20,0:10:22.16,Default,,0,0,0,,Z Slash!
Dialogue: 0,0:10:28.29,0:10:29.17,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:29.75,0:10:30.67,Default,,0,0,0,,Маған да біреуін оқып бер
Dialogue: 0,0:10:30.83,0:10:33.67,Default,,0,0,0,,Уау! Валькири бір шымшым!
Dialogue: 0,0:10:33.75,0:10:35.42,Default,,0,0,0,,Аяқтап бітіремін бе?
Dialogue: 0,0:10:37.34,0:10:39.18,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:10:41.97,0:10:43.43,Default,,0,0,0,,О, соңғы минут!
Dialogue: 0,0:10:43.60,0:10:46.43,Default,,0,0,0,,Чемпион күткендей! Мен создым.
Dialogue: 0,0:10:47.93,0:10:50.19,Default,,0,0,0,,Жеңіс Slash!
Dialogue: 0,0:10:54.86,0:10:55.82,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:01.41,0:11:02.28,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:11:05.24,0:11:06.87,Default,,0,0,0,,Мен жеңемін (жүрек соғысы)
Dialogue: 0,0:11:06.99,0:11:09.66,Default,,0,0,0,,Мен жеңемін Мен жеңемін
Dialogue: 0,0:11:10.41,0:11:12.88,Default,,0,0,0,,Мен жеңемін Мен жеңемін Ах...
Dialogue: 0,0:11:13.46,0:11:18.26,Default,,0,0,0,,Мен жеңемін жеңемін мен жеңемін...
Dialogue: 0,0:11:18.59,0:11:19.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:20.97,0:11:25.60,Default,,0,0,0,,Мен супер Цетсумын, ең күшті және жеңілмейтінмін!
Dialogue: 0,0:11:29.10,0:11:30.52,Default,,0,0,0,,Бұл қауіпті.
Dialogue: 0,0:11:33.44,0:11:35.98,Default,,0,0,0,,Уууу!
Dialogue: 0,0:11:36.32,0:11:38.53,Default,,0,0,0,,Ахиллес!
Dialogue: 0,0:11:41.36,0:11:42.99,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:43.16,0:11:44.41,Default,,0,0,0,,Уф!
Dialogue: 0,0:11:44.87,0:11:46.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:47.12,0:11:50.58,Default,,0,0,0,,Ол туралы не ойлайсың?
Dialogue: 0,0:11:51.12,0:11:52.75,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:11:52.87,0:11:55.50,Default,,0,0,0,,Ол одан да күшті болады.
Dialogue: 0,0:11:55.63,0:11:56.54,Default,,0,0,0,,Тағы не?
Dialogue: 0,0:11:56.67,0:11:58.05,Default,,0,0,0,,Хмм... тағы не?
Dialogue: 0,0:11:58.88,0:12:02.09,Default,,0,0,0,,болса, мен қарсы болмас едім
Dialogue: 0,0:12:04.43,0:12:07.64,Default,,0,0,0,,Тегін Осыны айтып тұрсыз ба...
Dialogue: 0,0:12:09.31,0:12:12.77,Default,,0,0,0,,Енді 2-ден 1-ге тең ұпаймен үшінші шайқас.
Dialogue: 0,0:12:12.89,0:12:14.15,Default,,0,0,0,,Челленджер Red Blade Aiga - бұл...
Dialogue: 0,0:12:14.27,0:12:16.94,Default,,0,0,0,,Жағдайды қуып жетіп, кері қайтара аламыз ба?
Dialogue: 0,0:12:17.27,0:12:19.40,Default,,0,0,0,,Жеңген адам менмін
Dialogue: 0,0:12:19.61,0:12:21.57,Default,,0,0,0,,Ахиллес!
Dialogue: 0,0:12:22.78,0:12:24.11,Default,,0,0,0,,Ахиллес…
Dialogue: 0,0:12:24.57,0:12:25.70,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:25.95,0:12:27.78,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:12:31.08,0:12:32.83,Default,,0,0,0,,Тыныш, сендер!
Dialogue: 0,0:12:33.00,0:12:35.46,Default,,0,0,0,,Жарқын түсірілімде жеңіске жетті!
Dialogue: 0,0:12:42.26,0:12:44.76,Default,,0,0,0,,Айға... бұл қандай керемет
Dialogue: 0,0:12:44.88,0:12:46.68,Default,,0,0,0,,Қандай керемет рух!
Dialogue: 0,0:12:47.09,0:12:49.76,Default,,0,0,0,,Бұл рух туралы емес.
Dialogue: 0,0:12:53.56,0:12:56.69,Default,,0,0,0,,Түн ортасында әлі де 36 сағат.
Dialogue: 0,0:12:57.31,0:13:00.02,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:00.69,0:13:02.23,Default,,0,0,0,,Жазалау
Dialogue: 0,0:13:07.16,0:13:08.12,Default,,0,0,0,,Ха!
Dialogue: 0,0:13:08.82,0:13:09.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:13.08,0:13:16.62,Default,,0,0,0,,Уууу!
Dialogue: 0,0:13:20.84,0:13:22.46,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:22.71,0:13:24.47,Default,,0,0,0,,Айга~!
Dialogue: 0,0:13:26.47,0:13:29.30,Default,,0,0,0,,Жеңіс реактивті ату!
Dialogue: 0,0:13:29.43,0:13:31.18,Default,,0,0,0,,Жүр!
Dialogue: 0,0:13:37.56,0:13:38.94,Default,,0,0,0,,Уф! Куу...
Dialogue: 0,0:13:39.23,0:13:40.98,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:41.61,0:13:43.36,Default,,0,0,0,,Міне — жер астында.
Dialogue: 0,0:13:46.07,0:13:48.11,Default,,0,0,0,,Куууу…
Dialogue: 0,0:13:49.45,0:13:52.08,Default,,0,0,0,,Уууу!
Dialogue: 0,0:13:55.20,0:13:56.46,Default,,0,0,0,,Әй!
Dialogue: 0,0:14:01.59,0:14:03.67,Default,,0,0,0,,Уууу!
Dialogue: 0,0:14:04.26,0:14:05.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:10.51,0:14:12.30,Default,,0,0,0,,Хо... хо... не?
Dialogue: 0,0:14:12.43,0:14:15.06,Default,,0,0,0,,Уф... не болды?
Dialogue: 0,0:14:15.18,0:14:16.52,Default,,0,0,0,,Валькирия?
Dialogue: 0,0:14:18.10,0:14:20.52,Default,,0,0,0,,Айга сен...
Dialogue: 0,0:14:21.44,0:14:22.77,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:24.48,0:14:29.45,Default,,0,0,0,,Ахиллес өте күшті және жеңілмейтін болды!
Dialogue: 0,0:14:30.41,0:14:33.83,Default,,0,0,0,,Уууу!
Dialogue: 0,0:14:36.04,0:14:37.79,Default,,0,0,0,,Валькирия...
Dialogue: 0,0:14:38.37,0:14:39.21,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:39.33,0:14:41.83,Default,,0,0,0,,Уг! Ууг!
Dialogue: 0,0:14:46.80,0:14:47.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:48.55,0:14:51.22,Default,,0,0,0,,Z Ахиллестің жарылуы аяқталуы
Dialogue: 0,0:14:51.34,0:14:54.85,Default,,0,0,0,,Жеңімпаз: Red Blade Aiga 3-тен 2 ұпайға дейін!
Dialogue: 0,0:14:55.18,0:14:59.35,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:14:59.81,0:15:02.81,Default,,0,0,0,,Бұл жігіт шынымен де солай жасады!
Dialogue: 0,0:15:02.94,0:15:06.11,Default,,0,0,0,,Мен сенің жеңетініңе сендім!
Dialogue: 0,0:15:07.78,0:15:11.16,Default,,0,0,0,,Эй Нару, бақыттырақ бол.
Dialogue: 0,0:15:11.28,0:15:13.16,Default,,0,0,0,,Айга жеңді!
Dialogue: 0,0:15:13.28,0:15:17.29,Default,,0,0,0,,Не? Айга жеңді...
Dialogue: 0,0:15:18.29,0:15:21.58,Default,,0,0,0,,Айга жеңді! Алақай!
Dialogue: 0,0:15:23.83,0:15:25.09,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:15:25.46,0:15:29.84,Default,,0,0,0,,Ұлы жаңа чемпион Айга Акабаненің дүниеге келуі!
Dialogue: 0,0:15:29.97,0:15:32.59,Default,,0,0,0,,Құттықтаймыз!
Dialogue: 0,0:15:36.18,0:15:38.31,Default,,0,0,0,,Жеміс піскен сияқты.
Dialogue: 0,0:15:39.18,0:15:42.35,Default,,0,0,0,,Ал жаңа чемпионды сынауға кімнің құқығы бар?
Dialogue: 0,0:15:42.44,0:15:43.69,Default,,0,0,0,,Сен сонда!
Dialogue: 0,0:15:43.81,0:15:44.94,Default,,0,0,0,,Бұл Phi!
Dialogue: 0,0:15:45.06,0:15:48.03,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:15:48.15,0:15:50.95,Default,,0,0,0,,Не? Ол дауласу құқығынан бас тарта ма?
Dialogue: 0,0:15:51.07,0:15:53.24,Default,,0,0,0,,Неліктен? Фай!
Dialogue: 0,0:15:58.58,0:16:00.45,Default,,0,0,0,,Сіз қалай ойлайсыз? Мен саған айттым!
Dialogue: 0,0:16:00.83,0:16:03.83,Default,,0,0,0,,Мен Супер Цетсумын, ең күшті және жеңілмейтінмін!
Dialogue: 0,0:16:05.50,0:16:08.46,Default,,0,0,0,,Бұл сіздің Бейблейдіңіз бе?
Dialogue: 0,0:16:08.92,0:16:14.01,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:16:19.85,0:16:21.18,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:16:21.39,0:16:22.60,Default,,0,0,0,,Мияу!
Dialogue: 0,0:16:22.73,0:16:24.77,Default,,0,0,0,,Сочо ең жақсысы
Dialogue: 0,0:16:24.85,0:16:26.11,Default,,0,0,0,,Cho Cool
Dialogue: 0,0:16:26.19,0:16:28.19,Default,,0,0,0,,Омені неге қойдыңыз!
Dialogue: 0,0:16:28.32,0:16:29.15,Default,,0,0,0,,А? (Тобисуке) Нанамон
Dialogue: 0,0:16:29.27,0:16:32.99,Default,,0,0,0,,Менің ойымша, бұл сізге Омеден гөрі Сочоның жақсырақ жарасады деп ойлаймын!
Dialogue: 0,0:16:33.07,0:16:34.36,Default,,0,0,0,,Сәлем, Сочо!
Dialogue: 0,0:16:34.82,0:16:37.32,Default,,0,0,0,,Менің ойымша, Цетсу маған жақсырақ көрінеді!
Dialogue: 0,0:16:37.83,0:16:39.20,Default,,0,0,0,,Хмм, жарай…
Dialogue: 0,0:16:39.33,0:16:42.58,Default,,0,0,0,,Мен жақында чемпион боламын.
Dialogue: 0,0:16:42.71,0:16:45.29,Default,,0,0,0,,Бұл құрғақ жүгіру. Бұл құрғақ жүгіру.
Dialogue: 0,0:16:45.42,0:16:47.00,Default,,0,0,0,,Ах... Ахх!
Dialogue: 0,0:16:47.13,0:16:49.50,Default,,0,0,0,,Әй, оны маған берме!
Dialogue: 0,0:16:49.63,0:16:51.38,Default,,0,0,0,,Теме Конояро!
Dialogue: 0,0:16:51.88,0:16:53.01,Default,,0,0,0,,Сен тым сараңсың.
Dialogue: 0,0:16:53.13,0:16:55.05,Default,,0,0,0,,Рұқсатсыз көтерген сол.
Dialogue: 0,0:16:55.18,0:16:56.01,Default,,0,0,0,,Қауіп-қатер сезімінің жоқтығы.
Dialogue: 0,0:16:56.51,0:17:00.14,Default,,0,0,0,,Айға, мен ол белбеуді міндетті түрде аламын.
Dialogue: 0,0:17:00.26,0:17:03.27,Default,,0,0,0,,Сол күнге дейін мен ешкімнен жеңілмеймін!
Dialogue: 0,0:17:03.39,0:17:05.85,Default,,0,0,0,,А, мен оны кез келген уақытта қабылдаймын.
Dialogue: 0,0:17:06.19,0:17:08.69,Default,,0,0,0,,Бірақ мен жеңемін.
Dialogue: 0,0:17:17.87,0:17:18.70,Default,,0,0,0,,Фу…
Dialogue: 0,0:17:18.91,0:17:21.24,Default,,0,0,0,,А? Не болды?
Dialogue: 0,0:17:22.49,0:17:24.83,Default,,0,0,0,,Жоқ... ештеңе.
Dialogue: 0,0:17:24.96,0:17:28.08,Default,,0,0,0,,Фубуки, егер қаласаңыз, оны түртуге болады.
Dialogue: 0,0:17:28.25,0:17:29.63,Default,,0,0,0,,Бас тарту
Dialogue: 0,0:17:30.75,0:17:33.26,Default,,0,0,0,,Мен алған күнге дейін
Dialogue: 0,0:17:33.38,0:17:36.01,Default,,0,0,0,,Ей, ол күн ешқашан келмейді!
Dialogue: 0,0:17:36.13,0:17:38.84,Default,,0,0,0,,Мен ешкімге жеңіле алмаймын.
Dialogue: 0,0:17:39.01,0:17:41.51,Default,,0,0,0,,Эй, Айга, мен саған тиіссем болады ма?
Dialogue: 0,0:17:41.64,0:17:43.02,Default,,0,0,0,,О, жақсы.
Dialogue: 0,0:17:43.14,0:17:44.39,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:44.68,0:17:46.98,Default,,0,0,0,,Уау, бұл өте керемет
Dialogue: 0,0:17:48.81,0:17:51.82,Default,,0,0,0,,Хуаншан, мен ол туралы сұрайын.
Dialogue: 0,0:17:52.40,0:17:54.78,Default,,0,0,0,,А? Сіз не айттыңыз?
Dialogue: 0,0:17:55.65,0:17:59.28,Default,,0,0,0,,Жоқ, мүмкін мен тым көп ойлап тұрған шығармын...
Dialogue: 0,0:17:59.41,0:18:00.66,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:18:01.45,0:18:03.83,Default,,0,0,0,,Бәрібір сұраңыз
Dialogue: 0,0:18:05.87,0:18:09.00,Default,,0,0,0,,Мен шынымен түсінбеймін, бірақ маған қалдырыңыз!
Dialogue: 0,0:18:20.26,0:18:23.26,Default,,0,0,0,,Маған да жасап бер, ең күшті, жеңілмейтін Бей!
Dialogue: 0,0:18:24.89,0:18:26.77,Default,,0,0,0,,Саған әлі ерте
Dialogue: 0,0:18:27.27,0:18:31.02,Default,,0,0,0,,Мен оны Балт үшін жасадым, бірақ Айгаға неге жасамасқа?
Dialogue: 0,0:18:31.65,0:18:34.48,Default,,0,0,0,,Мен Айға үшін алаңдаймын.
Dialogue: 0,0:18:37.24,0:18:40.36,Default,,0,0,0,,Мен бұлай тез шындыққа айналады деп ойламаппын
Dialogue: 0,0:18:46.58,0:18:47.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:48.29,0:18:49.16,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:18:50.04,0:18:52.79,Default,,0,0,0,,Айга-Бей қызық па?
Dialogue: 0,0:18:53.34,0:18:55.50,Default,,0,0,0,,А? Бұл кенеттен не болды?
Dialogue: 0,0:18:56.80,0:18:57.80,Default,,0,0,0,,Мегуми Фушигуро.
Dialogue: 0,0:18:58.17,0:18:59.68,Default,,0,0,0,,Нару да көмектеседі!
Dialogue: 0,0:19:00.18,0:19:01.34,Default,,0,0,0,,Мұздатқыш балмұздақ жақсы-ақ, бірақ бұл да дәмді.
Dialogue: 0,0:19:01.47,0:19:02.30,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:19:04.10,0:19:05.76,Default,,0,0,0,,Бұл өте тез өтті.
Dialogue: 0,0:19:05.89,0:19:08.27,Default,,0,0,0,,Мен өткен күні қайықта отырмын деп ойладым.
Dialogue: 0,0:19:08.39,0:19:10.89,Default,,0,0,0,,Нару жасырын түрде кіріп кетті, солай ма?
Dialogue: 0,0:19:11.02,0:19:12.77,Default,,0,0,0,,Хехехе, дұрыс.
Dialogue: 0,0:19:12.90,0:19:16.28,Default,,0,0,0,,Қоңырау шалғанда мен таң қалдым.
Dialogue: 0,0:19:16.40,0:19:18.19,Default,,0,0,0,,Тым абай болмаңыз
Dialogue: 0,0:19:18.32,0:19:20.65,Default,,0,0,0,,Бірақ менімен бірге келсең дұрыс айтасың.
Dialogue: 0,0:19:21.24,0:19:23.12,Default,,0,0,0,,Бұл өте қызық болды.
Dialogue: 0,0:19:23.57,0:19:26.12,Default,,0,0,0,,Бұл өте қызық болды.
Dialogue: 0,0:19:26.24,0:19:28.12,Default,,0,0,0,,Байатлон қызу өтті
Dialogue: 0,0:19:28.25,0:19:31.08,Default,,0,0,0,,Елсіз аралдағы шытырман оқиға да керемет болды!
Dialogue: 0,0:19:31.62,0:19:35.04,Default,,0,0,0,,Бірақ «Нару» елес кемесі қорқынышты болды.
Dialogue: 0,0:19:35.71,0:19:38.26,Default,,0,0,0,,Мұндай нәрсенің қорқыныштысы неде?
Dialogue: 0,0:19:38.38,0:19:39.55,Default,,0,0,0,,Қорқынышты туралы айту
Dialogue: 0,0:19:39.67,0:19:43.72,Default,,0,0,0,,Айға титулдық кездесуде өте қорқынышты болды
Dialogue: 0,0:19:44.55,0:19:46.43,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,0:19:46.85,0:19:49.14,Default,,0,0,0,,Әй, әке, қорқып кеттің ғой?
Dialogue: 0,0:19:49.68,0:19:51.39,Default,,0,0,0,,Иә? Солай ма?
Dialogue: 0,0:19:51.52,0:19:55.65,Default,,0,0,0,,Бұл Балттың менің күшті күшімнен қорқатынын білдіреді.
Dialogue: 0,0:19:55.98,0:19:59.53,Default,,0,0,0,,Әрине, гахахахаха!
Dialogue: 0,0:20:01.28,0:20:03.91,Default,,0,0,0,,Ал, мен саған кешке дайындалуға көмектесемін.
Dialogue: 0,0:20:04.53,0:20:06.78,Default,,0,0,0,,Андж-сан, қиын болып көрінді.
Dialogue: 0,0:20:06.91,0:20:08.33,Default,,0,0,0,,Андж-сан?
Dialogue: 0,0:20:08.45,0:20:10.91,Default,,0,0,0,,Нару мен басқалары маған қамқорлық жасады.
Dialogue: 0,0:20:11.04,0:20:12.66,Default,,0,0,0,,Рахмет айтуым керек.
Dialogue: 0,0:20:13.04,0:20:15.17,Default,,0,0,0,,Рахмет! Нару әке
Dialogue: 0,0:20:15.54,0:20:16.50,Default,,0,0,0,,О
Dialogue: 0,0:20:16.92,0:20:18.67,Default,,0,0,0,,Тезірек келіңіз~
Dialogue: 0,0:20:18.92,0:20:20.21,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:33.94,0:20:36.65,Default,,0,0,0,,Аа~ Тағы да... Иә?
Dialogue: 0,0:20:36.77,0:20:39.69,Default,,0,0,0,,Фи! Омех
Dialogue: 0,0:20:45.49,0:20:48.91,Default,,0,0,0,,Оме, сен неге менімен ұрыспадың?
Dialogue: 0,0:20:49.28,0:20:52.04,Default,,0,0,0,,Мені титулдық сәйкестіктер қызықтырмайды.
Dialogue: 0,0:20:52.54,0:20:54.04,Default,,0,0,0,,Тағы да солай ма?
Dialogue: 0,0:20:54.67,0:20:59.04,Default,,0,0,0,,Күшті биді жоюдың ең жақсы сәті - жалғыз менің.
Dialogue: 0,0:20:59.17,0:21:01.30,Default,,0,0,0,,Ешкімнің жолыңызға түсуіне жол бермеңіз!
Dialogue: 0,0:21:01.88,0:21:03.01,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:04.51,0:21:05.38,Default,,0,0,0,,Фу…
Dialogue: 0,0:21:05.55,0:21:09.18,Default,,0,0,0,,Жарайсың, жойылуға тұрарлық бек болып өстің.
Dialogue: 0,0:21:09.30,0:21:12.06,Default,,0,0,0,,Феникс те бақытты.
Dialogue: 0,0:21:14.85,0:21:15.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:18.90,0:21:21.32,Default,,0,0,0,,Ахиллес те күрескісі келетін сияқты.
Dialogue: 0,0:21:21.90,0:21:24.57,Default,,0,0,0,,Ахиллес төбелесіп жатқан жалғыз адам емес.
Dialogue: 0,0:21:24.70,0:21:27.07,Default,,0,0,0,,Менің де мотивациям жоғары!
Dialogue: 0,0:21:35.71,0:21:39.21,Default,,0,0,0,,Омемен шайқас Мен сені бұл жолы талқандаймын!
Dialogue: 0,0:21:41.88,0:21:44.21,Default,,0,0,0,,Ахиллеспен қоштас
Dialogue: 0,0:21:44.72,0:21:46.97,Default,,0,0,0,,Ахиллес мызғымас!
Dialogue: 0,0:21:47.59,0:21:53.60,Default,,0,0,0,,Ай!
Dialogue: 0,0:21:55.31,0:22:01.32,Default,,0,0,0,,♪~
Dialogue: 0,0:23:17.10,0:23:23.11,Default,,0,0,0,,~♪
Dialogue: 0,0:23:25.36,0:23:28.15,Default,,0,0,0,,Біз мұны жасадық! Біз әлем чемпионымыз!
Dialogue: 0,0:23:28.44,0:23:32.91,Default,,0,0,0,,Қалай айтасың, Ахиллес, уәде етілгендей, сен ең күшті және жеңілмейтін болдым?
Dialogue: 0,0:23:33.03,0:23:35.08,Default,,0,0,0,,Мен енді, тіпті Фиге де жеңілмеймін
Dialogue: 0,0:23:35.16,0:23:38.45,Default,,0,0,0,,Кез келген адам тапсырманы көтере алады, мен оны қабылдаймын!
Dialogue: 0,0:23:38.54,0:23:40.54,Default,,0,0,0,,Менің ойымша...
Dialogue: 0,0:23:40.66,0:23:42.92,Default,,0,0,0,,Келесі жолы «Beyblade Burst Super Zetsu»
Dialogue: 0,0:23:43.00,0:23:45.50,Default,,0,0,0,,«Аспан асты әлемінің жын патшасы, өлі Адес!»
Dialogue: 0,0:23:45.63,0:23:47.30,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:47.42,0:23:49.34,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:50.84,0:23:56.84,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory