Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.66,0:00:04.04,Default,,0,0,0,,Бейблейд
Dialogue: 0,0:00:04.17,0:00:08.55,Default,,0,0,0,,Мықты болуды мақсат еткен ұлдардың арманының жемісі.
Dialogue: 0,0:00:08.96,0:00:12.42,Default,,0,0,0,,Енді супер Цетсу дәуірі басталады.
Dialogue: 0,0:00:12.55,0:00:16.80,Default,,0,0,0,,Металл сауытыңызды киіңіз де, Беймен шытырман оқиғаға аттаныңыз!
Dialogue: 0,0:00:16.93,0:00:19.26,Default,,0,0,0,,Әлем чемпионы болуды мақсат етіңіз!
Dialogue: 0,0:00:19.39,0:00:23.69,Default,,0,0,0,,Super Zetsu Super Zetsu Super Zetsu!
Dialogue: 0,0:00:24.27,0:00:27.90,Default,,0,0,0,,Ең күшті және жеңілмейтін атағын алатын адам сенсің!
Dialogue: 0,0:00:32.15,0:00:32.99,Default,,0,0,0,,Міне болды!
Dialogue: 0,0:00:33.90,0:00:36.16,Default,,0,0,0,,Суми Фубукимен күресу
Dialogue: 0,0:00:36.24,0:00:38.12,Default,,0,0,0,,Мен Йонекома академиясына келдім...
Dialogue: 0,0:00:39.58,0:00:42.87,Default,,0,0,0,,Мен Bay Club жігіттерімен шайқасқа шықтым.
Dialogue: 0,0:00:45.79,0:00:48.88,Default,,0,0,0,,Z Buster!
Dialogue: 0,0:00:50.67,0:00:51.67,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:52.55,0:00:54.17,Default,,0,0,0,,Қазір 100 адам
Dialogue: 0,0:00:54.63,0:00:56.63,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:00:56.72,0:00:58.18,Default,,0,0,0,,Тоқта! (Ичи) Ә? Мұнда ма?
Dialogue: 0,0:00:58.26,0:01:00.68,Default,,0,0,0,,200 адамды осылай қалдырыңыз!
Dialogue: 0,0:01:02.68,0:01:05.06,Default,,0,0,0,,А... Капитан!
Dialogue: 0,0:01:06.39,0:01:07.98,Default,,0,0,0,,Ол шықты.
Dialogue: 0,0:01:09.31,0:01:11.86,Default,,0,0,0,,Мен көп сөйлейтін адамдарды жек көремін.
Dialogue: 0,0:01:12.69,0:01:15.70,Default,,0,0,0,,Мен бұл сенімді бөлшектеймін!
Dialogue: 0,0:01:20.41,0:01:21.91,Default,,0,0,0,,Z Ату!
Dialogue: 0,0:01:24.83,0:01:25.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:28.92,0:01:29.79,Default,,0,0,0,,(дірілдеген дауыс)
Dialogue: 0,0:01:30.00,0:01:32.67,Default,,0,0,0,,Форнеустан 1 ұпай алдым.
Dialogue: 0,0:01:33.42,0:01:35.63,Default,,0,0,0,,Мен міндетті түрде жеңемін!
Dialogue: 0,0:01:36.47,0:01:42.47,Default,,0,0,0,,♪~
Dialogue: 0,0:02:59.13,0:03:05.14,Default,,0,0,0,,~♪
Dialogue: 0,0:03:06.39,0:03:08.77,Default,,0,0,0,,«Күн бату дуэлі!!»
Dialogue: 0,0:03:11.35,0:03:13.86,Default,,0,0,0,,Қырықша… әрине!
Dialogue: 0,0:03:13.94,0:03:15.32,Default,,0,0,0,,Сіз таң қалдыңыз ба?
Dialogue: 0,0:03:15.44,0:03:17.78,Default,,0,0,0,,Мықтысың, З Ахиллесім
Dialogue: 0,0:03:18.32,0:03:21.03,Default,,0,0,0,,Хахаха хаха... ойбай
Dialogue: 0,0:03:21.20,0:03:22.41,Default,,0,0,0,,Әй... (Акабана Нару) Айга
Dialogue: 0,0:03:22.49,0:03:24.07,Default,,0,0,0,,Сақтықты төмендетпеңіз
Dialogue: 0,0:03:24.16,0:03:24.99,Default,,0,0,0,,О
Dialogue: 0,0:03:25.70,0:03:28.04,Default,,0,0,0,,А, сен мұнда неге келдің?
Dialogue: 0,0:03:28.29,0:03:31.71,Default,,0,0,0,,Қажетсіз нәрселер туралы ойламаңыз. Шоғырлан! Шоғырлан!
Dialogue: 0,0:03:31.79,0:03:33.37,Default,,0,0,0,,Ах, о... ой
Dialogue: 0,0:03:34.21,0:03:36.92,Default,,0,0,0,,Мен келесі жолы шешемін
Dialogue: 0,0:03:38.00,0:03:39.01,Default,,0,0,0,,Әй?
Dialogue: 0,0:03:39.34,0:03:41.67,Default,,0,0,0,,Сіз жүргізушіні жоғарылаттыңыз.
Dialogue: 0,0:03:42.26,0:03:43.43,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:03:45.51,0:03:47.18,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:03:47.51,0:03:50.93,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:03:51.52,0:03:53.69,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:03:53.94,0:03:54.94,Default,,0,0,0,,Ох… Уф~ Мен қатты ашпын.
Dialogue: 0,0:03:57.32,0:03:58.65,Default,,0,0,0,,Жүр! Ахиллес!
Dialogue: 0,0:04:05.95,0:04:06.99,Default,,0,0,0,,Z Ату!
Dialogue: 0,0:04:10.12,0:04:11.41,Default,,0,0,0,,Император гвардиясы!
Dialogue: 0,0:04:16.13,0:04:16.96,Default,,0,0,0,,шықты! Капитанның ерекше қозғалысы!
Dialogue: 0,0:04:16.13,0:04:16.96,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:16.96,0:04:18.04,Default,,0,0,0,,Бұл шықты! Капитанның ерекше қозғалысы!
Dialogue: 0,0:04:21.30,0:04:23.55,Default,,0,0,0,,Жүр! Ахиллес!
Dialogue: 0,0:04:29.35,0:04:31.22,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:04:31.43,0:04:32.43,Default,,0,0,0,,Ох… Уф~ Мен қатты ашпын.
Dialogue: 0,0:04:32.77,0:04:34.94,Default,,0,0,0,,Уау! Форнеус!
Dialogue: 0,0:04:39.02,0:04:40.90,Default,,0,0,0,,(айқай)
Dialogue: 0,0:04:42.69,0:04:44.07,Default,,0,0,0,,Z Buster!
Dialogue: 0,0:04:49.58,0:04:50.45,Default,,0,0,0,,Өмірдің өткелін белгілейтін ессіз сағат
Dialogue: 0,0:04:53.00,0:04:53.71,Default,,0,0,0,,Ах
Dialogue: 0,0:04:54.08,0:04:55.46,Default,,0,0,0,,Император Дрифт!
Dialogue: 0,0:04:59.88,0:05:00.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:01.50,0:05:03.97,Default,,0,0,0,,Император Форнеус аяқталды!
Dialogue: 0,0:05:04.05,0:05:05.51,Default,,0,0,0,,Суми Фубукидің жеңісі
Dialogue: 0,0:05:05.59,0:05:06.72,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:05:07.22,0:05:10.22,Default,,0,0,0,,Ол Фубукимен айналысатындай жақсы жігіт емес еді.
Dialogue: 0,0:05:10.47,0:05:12.27,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:05:12.35,0:05:13.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:14.85,0:05:18.44,Default,,0,0,0,,Мына жігіт 100 адамсыз өз күш-қуатын босқа жұмсап жүрген.
Dialogue: 0,0:05:19.11,0:05:22.15,Default,,0,0,0,,Егер біз тамаша жағдайда шайқасқан болсақ...
Dialogue: 0,0:05:23.32,0:05:24.65,Default,,0,0,0,,Хаа~
Dialogue: 0,0:05:25.28,0:05:26.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:26.95,0:05:27.86,Default,,0,0,0,,Айга!
Dialogue: 0,0:05:28.57,0:05:29.53,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:29.62,0:05:31.74,Default,,0,0,0,,
Dialogue: 0,0:05:32.08,0:05:35.62,Default,,0,0,0,,
Dialogue: 0,0:05:36.00,0:05:38.58,Default,,0,0,0,,Хаа~ Мына жігіт не ұйықтап жатыр?
Dialogue: 0,0:05:38.67,0:05:40.13,Default,,0,0,0,,Қандай қызық жігіт.
Dialogue: 0,0:05:40.63,0:05:42.50,Default,,0,0,0,,Мен уайымдап ақша жоғалттым.
Dialogue: 0,0:05:42.59,0:05:45.76,Default,,0,0,0,,Мені таң қалдырмаңыз. Үйге барайық. Үйге барайық.
Dialogue: 0,0:05:45.84,0:05:47.38,Default,,0,0,0,,Ахиллес…
Dialogue: 0,0:05:51.01,0:05:51.85,Default,,0,0,0,,Ах
Dialogue: 0,0:05:52.89,0:05:54.10,Default,,0,0,0,,Ахиллес
Dialogue: 0,0:05:54.89,0:05:56.98,Default,,0,0,0,,Жарайды, Балтоны жеңейік.
Dialogue: 0,0:05:59.81,0:06:00.98,Default,,0,0,0,,Не болды? Ахиллес
Dialogue: 0,0:06:01.06,0:06:02.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:03.90,0:06:04.94,Default,,0,0,0,,Фубуки
Dialogue: 0,0:06:05.36,0:06:07.70,Default,,0,0,0,,Ахиллес Біздің күшімізді көрсет.
Dialogue: 0,0:06:08.82,0:06:09.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:10.57,0:06:12.41,Default,,0,0,0,,Сіз мені естімейсіз бе?
Dialogue: 0,0:06:13.74,0:06:15.20,Default,,0,0,0,,(айқай)
Dialogue: 0,0:06:15.29,0:06:16.20,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:16.29,0:06:17.08,Default,,0,0,0,,Уау, аа...
Dialogue: 0,0:06:17.08,0:06:18.16,Default,,0,0,0,,Уау, аа...
Dialogue: 0,0:06:17.08,0:06:18.16,Default,,0,0,0,,Айға
Dialogue: 0,0:06:18.16,0:06:18.37,Default,,0,0,0,,Уау, аа...
Dialogue: 0,0:06:18.46,0:06:21.21,Default,,0,0,0,,Уау...
Dialogue: 0,0:06:18.46,0:06:21.21,Default,,0,0,0,,Айға Айғаттеба
Dialogue: 0,0:06:21.58,0:06:22.46,Default,,0,0,0,,Айға!
Dialogue: 0,0:06:23.17,0:06:24.05,Default,,0,0,0,,А...
Dialogue: 0,0:06:24.42,0:06:25.46,Default,,0,0,0,,Ах Нару
Dialogue: 0,0:06:26.63,0:06:28.51,Default,,0,0,0,,Иә? Бұл қайда?
Dialogue: 0,0:06:28.59,0:06:30.64,Default,,0,0,0,,Бұл директордың кабинеті.
Dialogue: 0,0:06:31.93,0:06:33.10,Default,,0,0,0,,Жарық жасыл, Ято-сан.
Dialogue: 0,0:06:33.39,0:06:36.10,Default,,0,0,0,,Фубукиден жеңілген бойда көңілім көтерілді.
Dialogue: 0,0:06:36.47,0:06:37.39,Default,,0,0,0,,Жоғалдың ба?
Dialogue: 0,0:06:37.52,0:06:38.68,Default,,0,0,0,,Менің таңдауым жоқ
Dialogue: 0,0:06:38.77,0:06:41.35,Default,,0,0,0,,100 адамды алып тастағандықтан, басым айналып кетті.
Dialogue: 0,0:06:41.69,0:06:42.94,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:06:44.90,0:06:47.61,Default,,0,0,0,,Сонда Ахиллес те таусылды ма?
Dialogue: 0,0:06:48.40,0:06:50.32,Default,,0,0,0,,Кешіріңіз, Ахиллес
Dialogue: 0,0:06:50.86,0:06:52.62,Default,,0,0,0,,Ал, мен бақыттымын!
Dialogue: 0,0:06:52.91,0:06:53.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:53.87,0:06:56.24,Default,,0,0,0,,Оме неге мұнда?
Dialogue: 0,0:06:56.45,0:06:58.75,Default,,0,0,0,,Нару да Йонекома академиясына ауысты.
Dialogue: 0,0:06:58.87,0:06:59.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:00.25,0:07:03.63,Default,,0,0,0,,Менің анам мен әкем менің ауысуымды рәсімдеп үлгерді.
Dialogue: 0,0:07:04.04,0:07:05.59,Default,,0,0,0,,Сәлем, мектеп директоры.
Dialogue: 0,0:07:05.75,0:07:10.13,Default,,0,0,0,,Аа, балалар бүгіннен бастап Йонекома академиясының студенттерісіздер.
Dialogue: 0,0:07:10.30,0:07:11.84,Default,,0,0,0,,Бір айдан кейін
Dialogue: 0,0:07:11.93,0:07:14.30,Default,,0,0,0,,Айға, сен жалғыз қалуға алаңдамадың ба?
Dialogue: 0,0:07:14.39,0:07:16.18,Default,,0,0,0,,Уайымдау деген нені білдіреді?
Dialogue: 0,0:07:16.26,0:07:17.39,Default,,0,0,0,,Ихихихи (Басшы) Әділ.
Dialogue: 0,0:07:18.14,0:07:21.89,Default,,0,0,0,,Бұдан былай екеуміз Йонекома академиясының жатақханасында тұратын боламыз.
Dialogue: 0,0:07:22.69,0:07:23.73,Default,,0,0,0,,Жатақхана?
Dialogue: 0,0:07:25.27,0:07:26.40,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,0:07:26.86,0:07:29.03,Default,,0,0,0,,Aha hahaha
Dialogue: 0,0:07:29.36,0:07:30.53,Default,,0,0,0,,Осы жатақханада
Dialogue: 0,0:07:30.65,0:07:34.74,Default,,0,0,0,,Өйткені Йонекома академиясына жиналған көпіршіктер бар.
Dialogue: 0,0:07:34.82,0:07:36.53,Default,,0,0,0,,Барлығымен тіл табысыңыз
Dialogue: 0,0:07:37.12,0:07:37.99,Default,,0,0,0,,Иә
Dialogue: 0,0:07:40.66,0:07:43.42,Default,,0,0,0,,Сен осындай жерде қамалып қалуға болмайды ма?
Dialogue: 0,0:07:43.71,0:07:47.38,Default,,0,0,0,,Нарумен?
Dialogue: 0,0:07:48.25,0:07:50.21,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:07:52.22,0:07:53.18,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:07:53.51,0:07:54.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:54.76,0:07:55.68,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:56.47,0:07:57.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:58.10,0:08:00.18,Default,,0,0,0,,Саған әлі де рух жетпейді!
Dialogue: 0,0:08:01.23,0:08:04.23,Default,,0,0,0,,Сондықтан сізді сырттағылар сынап жатыр.
Dialogue: 0,0:08:04.65,0:08:06.86,Default,,0,0,0,,Бірақ Сочо (Рандзиро)?
Dialogue: 0,0:08:07.32,0:08:09.07,Default,,0,0,0,,Мына қызыл жүз Айга жігіті...
Dialogue: 0,0:08:09.15,0:08:10.90,Default,,0,0,0,,Ол өте күшті.
Dialogue: 0,0:08:10.99,0:08:13.61,Default,,0,0,0,,Олар бұл супер Зецубей деді.
Dialogue: 0,0:08:14.32,0:08:15.87,Default,,0,0,0,,Бұл супер цецубей ме?
Dialogue: 0,0:08:16.45,0:08:19.12,Default,,0,0,0,,Сочо, Қызыл жүз Айганы жең.
Dialogue: 0,0:08:19.79,0:08:22.58,Default,,0,0,0,,Өтінемін, оны қызған жерге айналдырыңыз.
Dialogue: 0,0:08:23.37,0:08:24.33,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:08:24.92,0:08:27.38,Default,,0,0,0,,Мен Қызыл Жүз Айғаны талқандаймын
Dialogue: 0,0:08:28.17,0:08:32.09,Default,,0,0,0,,Мен сізге Ранбей тобының сұмдығын еске түсіремін!
Dialogue: 0,0:08:32.59,0:08:33.47,Default,,0,0,0,,Сонымен, осы екі адамның қайсысы Стэнді қолданады?
Dialogue: 0,0:08:34.34,0:08:37.47,Default,,0,0,0,,Барлығы, 100 ату. Жаттығуды жалғастырайық.
Dialogue: 0,0:08:37.93,0:08:38.76,Default,,0,0,0,,О!
Dialogue: 0,0:08:39.51,0:08:40.64,Default,,0,0,0,,Уф
Dialogue: 0,0:08:44.14,0:08:45.27,Default,,0,0,0,,Осы уақытқа дейін Миста өте еркін өмір сүрді
Dialogue: 0,0:08:46.15,0:08:49.52,Default,,0,0,0,,Ағаның жолын қуып, мен де осы күнге жеттім.
Dialogue: 0,0:09:01.16,0:09:02.04,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:03.16,0:09:06.04,Default,,0,0,0,,Ағай, бітті, мен бұл жолы жеңілмеймін.
Dialogue: 0,0:09:13.76,0:09:14.88,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:15.38,0:09:17.13,Default,,0,0,0,,Теме және т.б. тым әлсіз――
Dialogue: 0,0:09:17.22,0:09:18.84,Default,,0,0,0,,Бұл туралы айтудың қажеті жоқ.
Dialogue: 0,0:09:20.01,0:09:22.85,Default,,0,0,0,,Менен күшті адам жоқ па?
Dialogue: 0,0:09:22.97,0:09:24.85,Default,,0,0,0,,Сочо! (Ранджиро) Иә?
Dialogue: 0,0:09:25.02,0:09:25.89,Default,,0,0,0,,Мен бұны киемін… жетімдер үйінде өткізген күндерімді ұмытпау үшін.
Dialogue: 0,0:09:25.98,0:09:29.36,Default,,0,0,0,,Фубуки Суми Super Zetsubei пайдаланып жатқан сияқты.
Dialogue: 0,0:09:29.73,0:09:32.02,Default,,0,0,0,,Super Zetsu... Бұл не?
Dialogue: 0,0:09:32.11,0:09:34.90,Default,,0,0,0,,Металлдан жасалған қабаттар туралы бір нәрсе.
Dialogue: 0,0:09:34.99,0:09:36.49,Default,,0,0,0,,Бұл шынымен күшті деген қауесет бар.
Dialogue: 0,0:09:37.61,0:09:38.99,Default,,0,0,0,,Металл ше?
Dialogue: 0,0:09:39.53,0:09:41.74,Default,,0,0,0,,Мураки-сан Мураки-сан!
Dialogue: 0,0:09:41.83,0:09:44.16,Default,,0,0,0,,Ранжиро-кун
Dialogue: 0,0:09:44.45,0:09:45.58,Default,,0,0,0,,Мураки мырза
Dialogue: 0,0:09:45.71,0:09:48.71,Default,,0,0,0,,Сіз менің Рагнарукымның дамуын арттыра аласыз ба?
Dialogue: 0,0:09:48.79,0:09:49.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:50.29,0:09:53.13,Default,,0,0,0,,Ағаңнан мықты болшы, өтінемін.
Dialogue: 0,0:09:53.63,0:09:54.63,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:09:55.01,0:09:58.13,Default,,0,0,0,,Рантаро-кун да сені сұрады.
Dialogue: 0,0:09:58.34,0:10:00.93,Default,,0,0,0,,Мен Рагнарукты супер Зецубейге айналдырдым.
Dialogue: 0,0:10:01.01,0:10:04.52,Default,,0,0,0,,Жақсы. Қазірден бастап супер Зецубей дәуірі.
Dialogue: 0,0:10:04.64,0:10:06.48,Default,,0,0,0,,Қызықты Келіңіздер, байқап көрейік
Dialogue: 0,0:10:17.49,0:10:19.24,Default,,0,0,0,,Жарайды, орындалды.
Dialogue: 0,0:10:20.07,0:10:21.07,Default,,0,0,0,,О~
Dialogue: 0,0:10:21.95,0:10:24.29,Default,,0,0,0,,Мен ойлап тапқан металл қанат
Dialogue: 0,0:10:24.54,0:10:25.79,Default,,0,0,0,,Бұл тамаша!
Dialogue: 0,0:10:25.91,0:10:26.91,Default,,0,0,0,,Жарайсың, Сочо!
Dialogue: 0,0:10:27.50,0:10:29.50,Default,,0,0,0,,Жарайсыңдар, өнерлеріңді сынап көрейік.
Dialogue: 0,0:10:29.62,0:10:30.58,Default,,0,0,0,,Дегенмен, ол шын мәнінде аристократ. Өте сәнді киінген, иә?
Dialogue: 0,0:10:31.79,0:10:32.88,Default,,0,0,0,,​​О?
Dialogue: 0,0:10:37.67,0:10:39.34,Default,,0,0,0,,Суми Фубуки, шық!
Dialogue: 0,0:10:39.84,0:10:41.22,Default,,0,0,0,,Менімен жарыс
Dialogue: 0,0:10:41.30,0:10:42.85,Default,,0,0,0,,Сен менің жолымдасың, шық.
Dialogue: 0,0:10:43.60,0:10:44.76,Default,,0,0,0,,Мынаны қараңыз
Dialogue: 0,0:10:47.02,0:10:48.48,Default,,0,0,0,,Super Zetsubei?
Dialogue: 0,0:10:48.81,0:10:51.85,Default,,0,0,0,,О, осы Crash Рагнарукпен күрес.
Dialogue: 0,0:10:53.19,0:10:55.32,Default,,0,0,0,,Не болды, қорқып тұрсың ба?
Dialogue: 0,0:10:55.52,0:10:58.57,Default,,0,0,0,,Клуб мүшелерінің алдында ұятқа қалудан қорықпайсың ба?
Dialogue: 0,0:10:58.69,0:10:59.65,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:10:59.82,0:11:01.45,Default,,0,0,0,,Олай болса, жарысайық.
Dialogue: 0,0:11:01.82,0:11:04.45,Default,,0,0,0,,Жақсы, мен байқап көрейін.
Dialogue: 0,0:11:04.83,0:11:06.45,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:11:06.99,0:11:10.21,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:11:10.79,0:11:12.88,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:11:13.13,0:11:14.21,Default,,0,0,0,,Хамф!
Dialogue: 0,0:11:14.59,0:11:16.50,Default,,0,0,0,,Бұл Рагнаруктың ерлігінің шайқасы
Dialogue: 0,0:11:16.96,0:11:18.13,Default,,0,0,0,,О~. Құдай-ай!
Dialogue: 0,0:11:23.26,0:11:25.60,Default,,0,0,0,,Форнеус орталығын алыңыз
Dialogue: 0,0:11:27.97,0:11:29.56,Default,,0,0,0,,Тез кіріңіз!
Dialogue: 0,0:11:32.81,0:11:33.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:36.19,0:11:37.48,Default,,0,0,0,,Жүр!
Dialogue: 0,0:11:41.11,0:11:41.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:42.78,0:11:43.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:44.32,0:11:46.95,Default,,0,0,0,,Жарайсың, Каттоби!
Dialogue: 0,0:11:47.33,0:11:48.45,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:11:49.16,0:11:50.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:53.50,0:11:56.21,Default,,0,0,0,,Маңызды мәселе емес, Bay Club да.
Dialogue: 0,0:11:56.38,0:11:57.55,Default,,0,0,0,,Хе... иә?
Dialogue: 0,0:12:03.38,0:12:04.97,Default,,0,0,0,,Не? Теме және т.б.
Dialogue: 0,0:12:05.64,0:12:08.06,Default,,0,0,0,,Бұл жігіттер Сочомен Бей ойнағысы келеді...
Dialogue: 0,0:12:08.14,0:12:09.56,Default,,0,0,0,,Олар жиналған сияқты.
Dialogue: 0,0:12:10.27,0:12:12.60,Default,,0,0,0,,Ресми шығанақ клубының орнына -
Dialogue: 0,0:12:13.02,0:12:15.31,Default,,0,0,0,,Мен бұл қызықтырақ көрінді деп ойладым.
Dialogue: 0,0:12:16.23,0:12:17.77,Default,,0,0,0,,Сіз мұны білесіз бе?
Dialogue: 0,0:12:18.61,0:12:21.99,Default,,0,0,0,,Сонымен қатар, біз сізбен жақсы команда құра аламыз деп ойлаймын.
Dialogue: 0,0:12:22.95,0:12:24.86,Default,,0,0,0,,Бұл жақсы команда ма?
Dialogue: 0,0:12:26.37,0:12:27.24,Default,,0,0,0,,Сочо
Dialogue: 0,0:12:28.28,0:12:29.37,Default,,0,0,0,,Өмірдің өткелін белгілейтін ессіз сағат
Dialogue: 0,0:12:29.66,0:12:33.00,Default,,0,0,0,,Бүгіннен бастап Ранбей тобының туын осында көтерейік!
Dialogue: 0,0:12:33.46,0:12:34.79,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:12:41.17,0:12:42.13,Default,,0,0,0,,Осы уақытқа дейін Миста өте еркін өмір сүрді
Dialogue: 0,0:12:43.55,0:12:47.43,Default,,0,0,0,,Мен міндетті түрде інімнен асып түсемін.
Dialogue: 0,0:12:47.89,0:12:50.14,Default,,0,0,0,,(Студенттің сөйлейтін дауысы)
Dialogue: 0,0:12:53.56,0:12:57.40,Default,,0,0,0,,Айға қайда кетті?
Dialogue: 0,0:12:57.94,0:13:00.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:01.11,0:13:03.11,Default,,0,0,0,,А, мүмкін
Dialogue: 0,0:13:06.78,0:13:09.28,Default,,0,0,0,,Егер «дәптер» сөзі Death Note-ты білдірсе,
Dialogue: 0,0:13:09.83,0:13:12.83,Default,,0,0,0,,Айға Айғаттеба! Оян!
Dialogue: 0,0:13:12.91,0:13:13.79,Default,,0,0,0,,Әй?
Dialogue: 0,0:13:16.58,0:13:18.29,Default,,0,0,0,,
Dialogue: 0,0:13:19.00,0:13:20.29,Default,,0,0,0,,Мен жақсы ұйықтадым
Dialogue: 0,0:13:21.55,0:13:23.17,Default,,0,0,0,,Хаа~
Dialogue: 0,0:13:23.88,0:13:26.18,Default,,0,0,0,,Иә? (Хисацу) Акаба Айга?
Dialogue: 0,0:13:26.59,0:13:28.76,Default,,0,0,0,,Неге мұндай жерде ұйықтап жатырсың?
Dialogue: 0,0:13:28.84,0:13:31.97,Default,,0,0,0,,Хехе, мен мұнда жақсы ұйықтаймын.
Dialogue: 0,0:13:32.06,0:13:32.93,Default,,0,0,0,,(қой малау)
Dialogue: 0,0:13:33.02,0:13:34.23,Default,,0,0,0,,А? Иә?
Dialogue: 0,0:13:34.81,0:13:36.94,Default,,0,0,0,,Иә? Не болды?
Dialogue: 0,0:13:37.02,0:13:38.10,Default,,0,0,0,,Сәл артқа шегініңіз.
Dialogue: 0,0:13:39.06,0:13:40.69,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:13:41.11,0:13:43.11,Default,,0,0,0,,Уа, ау!
Dialogue: 0,0:13:45.03,0:13:47.15,Default,,0,0,0,,Сіз қой ұстайсыз ба?
Dialogue: 0,0:13:47.28,0:13:50.70,Default,,0,0,0,,Уау~ Түсіндім. Сіз де бақыттысыз ба?
Dialogue: 0,0:13:51.08,0:13:53.12,Default,,0,0,0,,Бұл жігіт керемет
Dialogue: 0,0:13:53.49,0:13:54.33,Default,,0,0,0,,Иә? (мәңгілік жаз) Ах
Dialogue: 0,0:13:55.20,0:13:57.79,Default,,0,0,0,,(Айғаның күлуі)
Dialogue: 0,0:13:57.87,0:13:59.25,Default,,0,0,0,,Әй?
Dialogue: 0,0:13:59.79,0:14:02.34,Default,,0,0,0,,Бұл Теме ме? Red Blade Aiga дегеніміз не?
Dialogue: 0,0:14:02.75,0:14:04.00,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:14:04.96,0:14:08.76,Default,,0,0,0,,Бұл адам Ранжиро Кияма, Ранбей тобының жетекшісі.
Dialogue: 0,0:14:09.26,0:14:12.43,Default,,0,0,0,,Ранбей тобы...Бір жерден естігенмін.
Dialogue: 0,0:14:12.51,0:14:14.27,Default,,0,0,0,,Ақымақ болма.
Dialogue: 0,0:14:14.81,0:14:16.56,Default,,0,0,0,,Иә.
Dialogue: 0,0:14:16.68,0:14:18.39,Default,,0,0,0,,Ол өте әлсіз.
Dialogue: 0,0:14:18.73,0:14:20.94,Default,,0,0,0,,Қалжыңдап тұрмын, Конояро
Dialogue: 0,0:14:21.02,0:14:23.61,Default,,0,0,0,,Ахахха! Өкініштісі тым күшті болды
Dialogue: 0,0:14:23.69,0:14:25.86,Default,,0,0,0,,Не! Уау...
Dialogue: 0,0:14:25.94,0:14:26.82,Default,,0,0,0,,Тақырып
Dialogue: 0,0:14:27.28,0:14:28.07,Default,,0,0,0,,Мәңгі-
Dialogue: 0,0:14:28.15,0:14:29.57,Default,,0,0,0,,Алаңдамаңыз.
Dialogue: 0,0:14:30.49,0:14:31.82,Default,,0,0,0,,Қорықпа
Dialogue: 0,0:14:34.91,0:14:37.00,Default,,0,0,0,,Ах... (Хисацу) Ах~аа
Dialogue: 0,0:14:37.45,0:14:42.00,Default,,0,0,0,,Мен сізге Ранбей тобының қаншалықты күшті екенін айтамын.
Dialogue: 0,0:14:42.29,0:14:44.25,Default,,0,0,0,,Сабақтан кейін өзен арнасына келіңіз
Dialogue: 0,0:14:44.67,0:14:45.84,Default,,0,0,0,,Өзен арнасы?
Dialogue: 0,0:14:46.01,0:14:48.26,Default,,0,0,0,,Кеттік, Тобисуке (Тобисуке) Эй, Сочо
Dialogue: 0,0:14:48.88,0:14:50.22,Default,,0,0,0,,Қашпа
Dialogue: 0,0:14:50.68,0:14:52.18,Default,,0,0,0,,Кім қашады?
Dialogue: 0,0:14:53.18,0:14:54.43,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:14:54.56,0:14:56.39,Default,,0,0,0,,О, бұл ақылсыз!
Dialogue: 0,0:14:56.68,0:14:59.23,Default,,0,0,0,,Сочомен жекпе-жек өткізгіңіз келе ме?
Dialogue: 0,0:14:59.35,0:15:00.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:00.64,0:15:03.73,Default,,0,0,0,,Тоқтағаныңыз жөн, өйткені сіз ұтыласыз.
Dialogue: 0,0:15:04.15,0:15:05.82,Default,,0,0,0,,Менің жеңіліп қалуым мүмкін емес
Dialogue: 0,0:15:05.90,0:15:07.48,Default,,0,0,0,,Сочо күшті
Dialogue: 0,0:15:08.15,0:15:11.16,Default,,0,0,0,,Мүмкін бұл Йонекома академиясының ең мықтысы шығар.
Dialogue: 0,0:15:11.28,0:15:13.16,Default,,0,0,0,,Не айтып тұрсың, Хинацу?
Dialogue: 0,0:15:13.28,0:15:16.04,Default,,0,0,0,,Өйткені Сочо Фубуки-сенпайды да жеңді...
Dialogue: 0,0:15:16.12,0:15:16.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:17.08,0:15:20.16,Default,,0,0,0,,Бұл бір-ақ рет болады, дәл қазір капитан...
Dialogue: 0,0:15:20.25,0:15:22.79,Default,,0,0,0,,Эй, Сочо Фубукиден күшті ме?
Dialogue: 0,0:15:23.29,0:15:26.34,Default,,0,0,0,,А, жоқ, сондықтан мен бір рет жеңдім.
Dialogue: 0,0:15:26.42,0:15:28.67,Default,,0,0,0,,Капитан шеберрек... Түсінемін, қызық екен.
Dialogue: 0,0:15:29.59,0:15:32.13,Default,,0,0,0,,Келіңіздер, жекпе-жек өткізейік.
Dialogue: 0,0:15:35.76,0:15:36.64,Default,,0,0,0,,Дуэль?
Dialogue: 0,0:15:37.01,0:15:38.81,Default,,0,0,0,,Иә, Қызыл жүз Айга...
Dialogue: 0,0:15:38.89,0:15:40.64,Default,,0,0,0,,Оны Сочодан шақырған көрінеді.
Dialogue: 0,0:15:41.02,0:15:42.81,Default,,0,0,0,,Бұл екеуі дуалы ма?
Dialogue: 0,0:15:42.94,0:15:44.31,Default,,0,0,0,,Қызықты көрінеді
Dialogue: 0,0:15:44.40,0:15:46.27,Default,,0,0,0,,Маған қызық емес, иә?
Dialogue: 0,0:15:47.02,0:15:50.28,Default,,0,0,0,,Кімнің жеңгені маңызды емес.
Dialogue: 0,0:15:50.40,0:15:51.28,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:15:51.74,0:15:54.87,Default,,0,0,0,,Бейбіт жекпе-жекті көргеннен жекпе-жек жақсы.
Dialogue: 0,0:15:54.95,0:15:56.53,Default,,0,0,0,,Жаттығу керек емес пе?
Dialogue: 0,0:15:56.95,0:15:58.62,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:15:59.50,0:16:02.25,Default,,0,0,0,,Қызыл жүз Айга Ранжиро Кияма
Dialogue: 0,0:16:02.83,0:16:04.54,Default,,0,0,0,,Мен мұны ақырында түсіндіремін
Dialogue: 0,0:16:05.54,0:16:08.42,Default,,0,0,0,,Кім күшті?
Dialogue: 0,0:16:18.97,0:16:20.52,Default,,0,0,0,,Қолдап тұрғаның үшін рахмет.
Dialogue: 0,0:16:20.64,0:16:22.89,Default,,0,0,0,,Айға уайымдай ма?
Dialogue: 0,0:16:23.02,0:16:24.85,Default,,0,0,0,,Олай емес...
Dialogue: 0,0:16:25.23,0:16:27.61,Default,,0,0,0,,Фубукиді жеңгеніңді естідім.
Dialogue: 0,0:16:28.02,0:16:30.11,Default,,0,0,0,,О, бұл оңай жеңіс.
Dialogue: 0,0:16:30.53,0:16:31.61,Default,,0,0,0,,Егер мен солай істесем, Шукуна оны өзінің Инверсия формуласымен емдей алған болар еді.
Dialogue: 0,0:16:31.69,0:16:35.07,Default,,0,0,0,,Олай болса, бұл Z Ахиллес сені үрлейді.
Dialogue: 0,0:16:35.16,0:16:37.91,Default,,0,0,0,,Сіз бұл Рагнарукты жеңе аласыз деп ойлайсыз ба?
Dialogue: 0,0:16:39.66,0:16:41.37,Default,,0,0,0,,Гумита судьясы
Dialogue: 0,0:16:41.70,0:16:44.16,Default,,0,0,0,,Иә~ Сіз ше?
Dialogue: 0,0:16:44.79,0:16:47.67,Default,,0,0,0,,Тыңдаңыздар, ойын бір реттік ойын.
Dialogue: 0,0:16:48.04,0:16:50.55,Default,,0,0,0,,Біреуің жарылып кетпейінше бітпейді.
Dialogue: 0,0:16:50.63,0:16:52.26,Default,,0,0,0,,Бұл Ранбей тобының ережелері.
Dialogue: 0,0:16:52.34,0:16:54.22,Default,,0,0,0,,Бұл оңайырақ болар еді.
Dialogue: 0,0:16:54.30,0:16:56.34,Default,,0,0,0,,Мен оны бір кадрда жарып жіберемін.
Dialogue: 0,0:16:57.26,0:17:00.06,Default,,0,0,0,,Бұл драйвер төзімділік түрі.
Dialogue: 0,0:17:00.72,0:17:02.73,Default,,0,0,0,,Дискке жақтауды қоясыз ба?
Dialogue: 0,0:17:04.27,0:17:05.64,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:17:06.90,0:17:08.90,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:17:09.19,0:17:12.65,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:17:13.03,0:17:15.36,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:17:15.74,0:17:16.66,Default,,0,0,0,,Хамф!
Dialogue: 0,0:17:21.66,0:17:22.87,Default,,0,0,0,,Рагнарукқа бар!
Dialogue: 0,0:17:23.50,0:17:25.25,Default,,0,0,0,,Орталықты алыңыз!
Dialogue: 0,0:17:26.17,0:17:27.37,Default,,0,0,0,,Ахиллеске шабуыл
Dialogue: 0,0:17:27.71,0:17:30.29,Default,,0,0,0,,Z Ату!
Dialogue: 0,0:17:30.96,0:17:32.71,Default,,0,0,0,,Желді металл қанаттарымен кесіңіз
Dialogue: 0,0:17:33.63,0:17:37.47,Default,,0,0,0,,Рагнарук тайфуны!
Dialogue: 0,0:17:37.93,0:17:38.80,Default,,0,0,0,,Не?
Dialogue: 0,0:17:39.30,0:17:40.93,Default,,0,0,0,,Қабатты металл қанат-
Dialogue: 0,0:17:41.01,0:17:42.93,Default,,0,0,0,,Жоғарғы күшті тудыру
Dialogue: 0,0:17:43.18,0:17:47.02,Default,,0,0,0,,Менің Ахиллесім сені ұшырып жібереді!
Dialogue: 0,0:17:52.57,0:17:54.61,Default,,0,0,0,,А... Рагнарук апатқа ұшырады
Dialogue: 0,0:17:54.69,0:17:56.15,Default,,0,0,0,,Аяқтау
Dialogue: 0,0:17:56.24,0:17:58.07,Default,,0,0,0,,Бұл жарылыс емес пе?
Dialogue: 0,0:17:58.53,0:18:00.45,Default,,0,0,0,,Міне осылай жарылады!
Dialogue: 0,0:18:00.82,0:18:03.45,Default,,0,0,0,,Бұл жолы мен мұны шынымен жасаймын.
Dialogue: 0,0:18:04.04,0:18:07.54,Default,,0,0,0,,Мен мұны міндетті түрде жарып жіберемін.
Dialogue: 0,0:18:09.92,0:18:12.00,Default,,0,0,0,,Сіз жүргізушіні жоғарылаттыңыз ба?
Dialogue: 0,0:18:12.92,0:18:14.46,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:18:15.21,0:18:18.22,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:18:18.80,0:18:20.97,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:18:21.26,0:18:22.22,Default,,0,0,0,,Ох… Уф~ Мен қатты ашпын.
Dialogue: 0,0:18:27.02,0:18:28.60,Default,,0,0,0,,Рагнарук тайфуны!
Dialogue: 0,0:18:33.23,0:18:34.48,Default,,0,0,0,,Z Buster!
Dialogue: 0,0:18:40.32,0:18:41.20,Default,,0,0,0,,Ой…
Dialogue: 0,0:18:44.12,0:18:44.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:45.33,0:18:47.58,Default,,0,0,0,,Гумита, дұрыстап шақыр.
Dialogue: 0,0:18:48.00,0:18:48.83,Default,,0,0,0,,Иә...
Dialogue: 0,0:18:49.54,0:18:52.13,Default,,0,0,0,,Z Ахиллес аяқталды
Dialogue: 0,0:18:53.00,0:18:55.13,Default,,0,0,0,,Хахаха қалай?
Dialogue: 0,0:18:55.96,0:18:57.71,Default,,0,0,0,,Шайқас әлі аяқталған жоқ.
Dialogue: 0,0:18:58.88,0:19:01.64,Default,,0,0,0,,Мен бұл бір оқтық матч деп айттым.
Dialogue: 0,0:19:01.80,0:19:04.85,Default,,0,0,0,,Хмф, келесі жолы мен міндетті түрде жарылып кетемін.
Dialogue: 0,0:19:10.31,0:19:13.31,Default,,0,0,0,,Ахиллеске бар!
Dialogue: 0,0:19:16.86,0:19:19.90,Default,,0,0,0,,Ооо!
Dialogue: 0,0:19:20.32,0:19:23.41,Default,,0,0,0,,Каттөбе Рагнарук!
Dialogue: 0,0:19:27.04,0:19:28.41,Default,,0,0,0,,Z Buster!
Dialogue: 0,0:19:28.87,0:19:30.16,Default,,0,0,0,,Мұны істеме!
Dialogue: 0,0:19:36.92,0:19:38.26,Default,,0,0,0,,Не~! Ха!
Dialogue: 0,0:19:38.63,0:19:40.17,Default,,0,0,0,,О, мм...
Dialogue: 0,0:19:40.84,0:19:43.72,Default,,0,0,0,,Рё...Екеуі де бір уақытта сурет салады
Dialogue: 0,0:19:44.09,0:19:46.26,Default,,0,0,0,,Тек бақытсыздық күшті
Dialogue: 0,0:19:46.35,0:19:47.35,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:19:51.60,0:19:53.65,Default,,0,0,0,,Екеуі де аяқтайды
Dialogue: 0,0:19:53.85,0:19:54.77,Default,,0,0,0,,Матака?
Dialogue: 0,0:19:55.56,0:19:58.28,Default,,0,0,0,,Келесі жолы, міндетті түрде келесі жолы...
Dialogue: 0,0:20:01.70,0:20:03.66,Default,,0,0,0,,Тағы бір мезгілде жарылу...
Dialogue: 0,0:20:04.11,0:20:06.53,Default,,0,0,0,,Бұл Сочомен тең.
Dialogue: 0,0:20:06.70,0:20:08.24,Default,,0,0,0,,Мұны күтпеген жерден жасамаңыз.
Dialogue: 0,0:20:10.08,0:20:11.75,Default,,0,0,0,,Екі серпінді аяқтау
Dialogue: 0,0:20:13.29,0:20:15.17,Default,,0,0,0,,Екеуі де серпінді аяқтау...
Dialogue: 0,0:20:15.79,0:20:17.67,Default,,0,0,0,,Сен қиыншылықтасың, Сочо.
Dialogue: 0,0:20:19.25,0:20:21.13,Default,,0,0,0,,Бұл қыңыр мыңжапырақ.
Dialogue: 0,0:20:21.30,0:20:22.72,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:20:22.93,0:20:25.39,Default,,0,0,0,,Келесі Неше рет? иә?
Dialogue: 0,0:20:26.26,0:20:30.10,Default,,0,0,0,,Ах, 62… 63?
Dialogue: 0,0:20:30.47,0:20:33.48,Default,,0,0,0,,Бұл 66-шы рет. Жеткілікті.
Dialogue: 0,0:20:34.19,0:20:35.85,Default,,0,0,0,,Мен судья боламын.
Dialogue: 0,0:20:36.36,0:20:37.52,Default,,0,0,0,,Дарий... (тамақты тазартады)
Dialogue: 0,0:20:38.86,0:20:41.61,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:20:43.15,0:20:47.12,Default,,0,0,0,,Келесі... 149-шы рет Кеттік
Dialogue: 0,0:20:47.66,0:20:49.24,Default,,0,0,0,,Кел... мұнда кел.
Dialogue: 0,0:20:49.74,0:20:51.62,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:20:52.00,0:20:56.08,Default,,0,0,0,,Үш екі бір…
Dialogue: 0,0:20:56.50,0:20:59.38,Default,,0,0,0,,Түсіріңіз…
Dialogue: 0,0:20:59.46,0:21:00.50,Default,,0,0,0,,Уау, аа...
Dialogue: 0,0:21:00.59,0:21:01.76,Default,,0,0,0,,Ой және...
Dialogue: 0,0:21:01.96,0:21:03.22,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:03.30,0:21:07.01,Default,,0,0,0,,Мен бұны киемін… жетімдер үйінде өткізген күндерімді ұмытпау үшін.
Dialogue: 0,0:21:07.43,0:21:09.26,Default,,0,0,0,,Әй Айға
Dialogue: 0,0:21:12.39,0:21:14.77,Default,,0,0,0,,Уф Уау... Уф
Dialogue: 0,0:21:15.10,0:21:17.44,Default,,0,0,0,,Эй, бұл жақсы емес.
Dialogue: 0,0:21:17.52,0:21:19.23,Default,,0,0,0,,А-а...
Dialogue: 0,0:21:19.31,0:21:21.48,Default,,0,0,0,,Уау... аааааааааа
Dialogue: 0,0:21:23.19,0:21:27.91,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:21:28.87,0:21:31.87,Default,,0,0,0,,Не болды? Бағыну?
Dialogue: 0,0:21:32.87,0:21:37.12,Default,,0,0,0,,Сіз маған шыдай алмайсыз, солай ма?
Dialogue: 0,0:21:38.17,0:21:42.96,Default,,0,0,0,,Мен сендерге бүгін үзіліс беремін. Келесі жолы тағы да жарысатын боламыз.
Dialogue: 0,0:21:43.05,0:21:43.92,Default,,0,0,0,,О
Dialogue: 0,0:21:45.05,0:21:47.38,Default,,0,0,0,,Мен сені кез келген уақытта үрлеймін.
Dialogue: 0,0:21:48.18,0:21:49.14,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:21:50.01,0:21:52.01,Default,,0,0,0,,Қалауыңызша.
Dialogue: 0,0:21:54.77,0:22:00.77,Default,,0,0,0,,♪~
Dialogue: 0,0:23:16.77,0:23:22.77,Default,,0,0,0,,~♪
Dialogue: 0,0:23:24.86,0:23:27.28,Default,,0,0,0,,Барто Аои үшін әлем чемпионы атағы бар ма?
Dialogue: 0,0:23:27.44,0:23:28.99,Default,,0,0,0,,Сіз оны жіберіп алмайсыз.
Dialogue: 0,0:23:29.40,0:23:32.49,Default,,0,0,0,,Бұл Сочо мен Фубуки арасындағы кездесу.
Dialogue: 0,0:23:32.57,0:23:35.16,Default,,0,0,0,,Ku~! Мен де өте ыстықпын
Dialogue: 0,0:23:35.37,0:23:37.16,Default,,0,0,0,,Жеңімпазмен шайқас
Dialogue: 0,0:23:37.24,0:23:41.29,Default,,0,0,0,,Барлығын жеңіп, әлем чемпионы бол!
Dialogue: 0,0:23:41.41,0:23:43.04,Default,,0,0,0,,Келесі жолы «Beyblade Burst Super Zetsu»
Dialogue: 0,0:23:43.50,0:23:45.34,Default,,0,0,0,,"Шешіңіз! Z-Buster!!"
Dialogue: 0,0:23:45.46,0:23:46.96,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:47.09,0:23:48.80,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:50.30,0:23:56.30,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory