Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.71,0:00:04.00,Default,,0,0,0,,Бейблейд
Dialogue: 0,0:00:04.12,0:00:08.50,Default,,0,0,0,,Мықты болуды мақсат еткен ұлдардың арманының жемісі.
Dialogue: 0,0:00:08.92,0:00:12.38,Default,,0,0,0,,Ал қазір супер Цетсу дәуірі қызып келеді.
Dialogue: 0,0:00:12.51,0:00:16.76,Default,,0,0,0,,Металл сауыт киіп, Беймен шытырман оқиғаға барыңыз!
Dialogue: 0,0:00:16.89,0:00:19.22,Default,,0,0,0,,Әлем чемпионы болуды мақсат етіңіз!
Dialogue: 0,0:00:19.35,0:00:23.64,Default,,0,0,0,,Super Zetsu Super Zetsu Super Zetsu!
Dialogue: 0,0:00:24.81,0:00:28.31,Default,,0,0,0,,Ең күшті және жеңілмейтін атағын алатын адам сенсің!
Dialogue: 0,0:00:31.23,0:00:34.24,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:00:34.53,0:00:37.45,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:00:37.99,0:00:38.83,Default,,0,0,0,,Тыныш, сендер!
Dialogue: 0,0:00:40.20,0:00:43.62,Default,,0,0,0,,Шу мен Фай арасындағы тартысты матч басталды.
Dialogue: 0,0:00:44.79,0:00:46.25,Default,,0,0,0,,Соттау уақыты келді
Dialogue: 0,0:00:46.79,0:00:49.00,Default,,0,0,0,,Сотталатын адам сенсің!
Dialogue: 0,0:00:49.13,0:00:53.21,Default,,0,0,0,,Super Spriggan Slash!
Dialogue: 0,0:00:53.80,0:00:55.30,Default,,0,0,0,,Өлі үзіліс!
Dialogue: 0,0:01:07.90,0:01:08.73,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:14.57,0:01:17.11,Default,,0,0,0,,Өлі Стингер Пресс!
Dialogue: 0,0:01:33.05,0:01:34.38,Default,,0,0,0,,Өлі Феникс
Dialogue: 0,0:01:34.51,0:01:37.43,Default,,0,0,0,,Super Z Spriggan's Super Z Awakening құлпын ашыңыз
Dialogue: 0,0:01:37.55,0:01:38.64,Default,,0,0,0,,Сіз оны жойдыңыз!
Dialogue: 0,0:01:40.85,0:01:41.81,Default,,0,0,0,,Уф... (Сочо) Эй!
Dialogue: 0,0:01:42.22,0:01:43.43,Default,,0,0,0,,Күте тұрыңыз, Теме
Dialogue: 0,0:01:43.56,0:01:45.81,Default,,0,0,0,,Сіз не істеп жатырсыз? Мені жіберіңізші!
Dialogue: 0,0:01:45.93,0:01:47.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:48.39,0:01:51.02,Default,,0,0,0,,Бұл менмін! Мен оны жеңемін!
Dialogue: 0,0:01:51.15,0:01:54.15,Default,,0,0,0,,Мен Омені дәл қазір жойып жіберемін.
Dialogue: 0,0:01:54.73,0:01:56.24,Default,,0,0,0,,Қызықты
Dialogue: 0,0:01:57.99,0:02:00.62,Default,,0,0,0,,Оны қалауыңызша жойыңыз
Dialogue: 0,0:02:00.74,0:02:01.62,Default,,0,0,0,,Ах!Уф...
Dialogue: 0,0:02:02.08,0:02:03.49,Default,,0,0,0,,Қызыл жүзді Айга
Dialogue: 0,0:02:03.62,0:02:07.87,Default,,0,0,0,,Мен сіздің супер-З Ахиллесіңізді бөлшектеймін!
Dialogue: 0,0:02:08.41,0:02:09.25,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:11.38,0:02:17.38,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:03:34.67,0:03:40.67,Default,,0,0,0,,~♪
Dialogue: 0,0:03:45.39,0:03:48.26,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:03:48.85,0:03:51.06,Default,,0,0,0,,Кеттік... Айға!
Dialogue: 0,0:03:51.31,0:03:52.48,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:03:52.89,0:03:54.10,Default,,0,0,0,,О!
Dialogue: 0,0:03:54.35,0:03:55.94,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:03:56.52,0:03:57.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:00.44,0:04:01.40,Default,,0,0,0,,Аа...
Dialogue: 0,0:04:01.86,0:04:02.70,Default,,0,0,0,,Уф!
Dialogue: 0,0:04:03.40,0:04:04.70,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:04:05.11,0:04:08.45,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:04:08.66,0:04:11.20,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:04:11.33,0:04:12.37,Default,,0,0,0,,Біз бәріміз бірге отырып, бір шыныаяқ ішкен күн де болар еді.
Dialogue: 0,0:04:18.13,0:04:19.75,Default,,0,0,0,,Ахиллес!
Dialogue: 0,0:04:20.09,0:04:22.01,Default,,0,0,0,,Мен сені үрлеймін!
Dialogue: 0,0:04:24.97,0:04:28.10,Default,,0,0,0,,Эй, сен маған осымен шабуыл жасамақшысың ба?
Dialogue: 0,0:04:28.51,0:04:29.85,Default,,0,0,0,,Рагнарук!
Dialogue: 0,0:04:38.86,0:04:39.86,Default,,0,0,0,,Ахиллес!
Dialogue: 0,0:04:40.48,0:04:42.24,Default,,0,0,0,,Жүр! Рагнарук!
Dialogue: 0,0:04:44.61,0:04:45.66,Default,,0,0,0,,Айга…
Dialogue: 0,0:04:53.75,0:04:54.75,Default,,0,0,0,,Сочо!
Dialogue: 0,0:04:54.87,0:04:56.54,Default,,0,0,0,,Айналдыру аяқталуы ма?
Dialogue: 0,0:04:56.67,0:04:58.50,Default,,0,0,0,,Аяқтаңыз! (Барлығы) Ах...
Dialogue: 0,0:04:58.88,0:05:01.13,Default,,0,0,0,,Super Z Buster!
Dialogue: 0,0:05:06.88,0:05:08.89,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:05:09.01,0:05:11.85,Default,,0,0,0,,Super Z Ахиллес аяқталды
Dialogue: 0,0:05:12.02,0:05:13.02,Default,,0,0,0,,Айга жеңді!
Dialogue: 0,0:05:13.89,0:05:15.77,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:05:15.89,0:05:18.23,Default,,0,0,0,,Ол әлдеқайда жақсы сезіне бастады.
Dialogue: 0,0:05:18.52,0:05:21.77,Default,,0,0,0,,Бірақ сіз Phi-ді осындай нәрсемен жеңе алмайсыз!
Dialogue: 0,0:05:22.44,0:05:23.94,Default,,0,0,0,,Сенің Квиркіңді жоятынын айтқан жігіт—
Dialogue: 0,0:05:24.19,0:05:25.78,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:05:26.20,0:05:27.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:28.36,0:05:30.53,Default,,0,0,0,,Біз сізді «жұмыс тәжірибесінен өту» деп аталатын бағдарламаға жібереміз
Dialogue: 0,0:05:30.66,0:05:31.49,Default,,0,0,0,,О...
Dialogue: 0,0:05:31.87,0:05:33.16,Default,,0,0,0,,Ах! (Бенимару) Сочо!
Dialogue: 0,0:05:33.41,0:05:34.25,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:34.62,0:05:36.25,Default,,0,0,0,,Кешіріңіз Бенимару
Dialogue: 0,0:05:36.37,0:05:37.42,Default,,0,0,0,,Жоқ
Dialogue: 0,0:05:39.13,0:05:41.29,Default,,0,0,0,,Жарайды, тағы бір рет!
Dialogue: 0,0:05:41.79,0:05:42.80,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:44.42,0:05:47.43,Default,,0,0,0,,Аз ғана үзіліс жасаған дұрыс емес пе?
Dialogue: 0,0:05:48.05,0:05:48.93,Default,,0,0,0,,О? Уф...
Dialogue: 0,0:05:49.55,0:05:50.47,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:05:50.60,0:05:53.18,Default,,0,0,0,,Өйткені мен үш сағат бойы жұмыс істеп жатырмын.
Dialogue: 0,0:05:53.56,0:05:55.64,Default,,0,0,0,,Айғаның өзі таусылды...
Dialogue: 0,0:05:55.77,0:05:57.44,Default,,0,0,0,,Маған бәрібір
Dialogue: 0,0:05:57.85,0:05:58.69,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:05:58.81,0:06:02.44,Default,,0,0,0,,Темеге және басқаларға да қараңыз! Фи шайқасы
Dialogue: 0,0:06:02.65,0:06:05.23,Default,,0,0,0,,Өлі Стингер Пресс!
Dialogue: 0,0:06:07.82,0:06:08.65,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:09.41,0:06:11.62,Default,,0,0,0,,Сол мыңжапырақты жеңу үшін
Dialogue: 0,0:06:11.74,0:06:14.33,Default,,0,0,0,,Тіпті 100 сағат Тіпті 200 сағат
Dialogue: 0,0:06:14.45,0:06:16.25,Default,,0,0,0,,Мен құлағанша істеймін!
Dialogue: 0,0:06:16.83,0:06:18.87,Default,,0,0,0,,Бұл тек Айга үшін шайқас емес.
Dialogue: 0,0:06:19.00,0:06:19.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:20.21,0:06:22.00,Default,,0,0,0,,Бұл менің де шайқасым!
Dialogue: 0,0:06:22.13,0:06:23.21,Default,,0,0,0,,Сочо
Dialogue: 0,0:06:23.67,0:06:27.05,Default,,0,0,0,,Айға кеттік, құлағанша жаттықтырамыз!
Dialogue: 0,0:06:27.17,0:06:28.09,Default,,0,0,0,,О!
Dialogue: 0,0:06:28.22,0:06:29.93,Default,,0,0,0,,Екеуің де тоқтаңдар.
Dialogue: 0,0:06:30.09,0:06:32.30,Default,,0,0,0,,А... ары қарай әрекеттенудің қажеті жоқ.
Dialogue: 0,0:06:32.43,0:06:33.35,Default,,0,0,0,,Не?
Dialogue: 0,0:06:33.72,0:06:35.01,Default,,0,0,0,,Фубуки!
Dialogue: 0,0:06:35.14,0:06:37.27,Default,,0,0,0,,Мен сіздің ашуыңызды түсінемін.
Dialogue: 0,0:06:37.77,0:06:42.69,Default,,0,0,0,,Бірақ сен енді Бейге ашуыңды шығарып жатырсың.
Dialogue: 0,0:06:43.11,0:06:44.40,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:44.52,0:06:46.90,Default,,0,0,0,,Ашуыңызды шығару үшін жаттығу жасаңыз, т.б.
Dialogue: 0,0:06:47.40,0:06:49.90,Default,,0,0,0,,Қанша тырыссаң да, Пхиді жеңе алмайсың!
Dialogue: 0,0:06:50.32,0:06:52.66,Default,,0,0,0,,Фубуки... Теме!
Dialogue: 0,0:06:53.12,0:06:56.79,Default,,0,0,0,,Сонда мен оны қалай жеңемін!
Dialogue: 0,0:06:57.41,0:07:00.62,Default,,0,0,0,,Бұл... Мен де білмеймін.
Dialogue: 0,0:07:01.04,0:07:02.54,Default,,0,0,0,,Сіз білмейсіз бе?
Dialogue: 0,0:07:02.92,0:07:05.55,Default,,0,0,0,,Түсінбесеңіз де, сізде қандай керемет...
Dialogue: 0,0:07:06.09,0:07:07.30,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:07:10.26,0:07:12.55,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:12.68,0:07:13.51,Default,,0,0,0,,Уф!
Dialogue: 0,0:07:13.89,0:07:14.85,Default,,0,0,0,,Айга!
Dialogue: 0,0:07:15.22,0:07:16.35,Default,,0,0,0,,Сочо
Dialogue: 0,0:07:16.47,0:07:17.89,Default,,0,0,0,,Шу!
Dialogue: 0,0:07:20.85,0:07:21.69,Default,,0,0,0,,Хмф!
Dialogue: 0,0:07:28.03,0:07:29.61,Default,,0,0,0,,Атмосфера нашар, солай емес пе?
Dialogue: 0,0:07:29.74,0:07:31.57,Default,,0,0,0,,Мен саған айтсам да...
Dialogue: 0,0:07:32.78,0:07:34.57,Default,,0,0,0,,Иә! (Барлығы) иә?
Dialogue: 0,0:07:34.70,0:07:36.99,Default,,0,0,0,,Хинацу, маған планшетіңді қарызға бер.
Dialogue: 0,0:07:38.74,0:07:39.58,Default,,0,0,0,,Иә
Dialogue: 0,0:07:39.91,0:07:41.04,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:07:41.16,0:07:43.58,Default,,0,0,0,,Шу мен Фай арасындағы шайқасқа шолу жасаңыз
Dialogue: 0,0:07:43.71,0:07:44.92,Default,,0,0,0,,Талдау
Dialogue: 0,0:07:45.04,0:07:46.04,Default,,0,0,0,,Талдау?
Dialogue: 0,0:07:46.42,0:07:49.63,Default,,0,0,0,,Қаншалықты күшті болсаң да, әрқашан әлсіздік болады.
Dialogue: 0,0:07:50.01,0:07:52.05,Default,,0,0,0,,Менің ойымша, бұл жақсы идея болуы мүмкін.
Dialogue: 0,0:07:52.18,0:07:53.01,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:53.43,0:07:55.89,Default,,0,0,0,,Егер сіз әлсіздік тапсаңыз...
Dialogue: 0,0:07:56.01,0:07:59.27,Default,,0,0,0,,Біз батырмыз! Үлкен Венера!
Dialogue: 0,0:07:59.77,0:08:02.77,Default,,0,0,0,,Барлығымыз Фидің әлсіз жақтарын іздейік!
Dialogue: 0,0:08:03.14,0:08:04.31,Default,,0,0,0,,О!
Dialogue: 0,0:08:04.85,0:08:05.86,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:08:07.86,0:08:10.23,Default,,0,0,0,,Жарайды, оны мониторға қосамыз!
Dialogue: 0,0:08:11.78,0:08:12.61,Default,,0,0,0,,Эй!
Dialogue: 0,0:08:25.12,0:08:27.63,Default,,0,0,0,,Өлі Феникстің жарылуы аяқталды
Dialogue: 0,0:08:27.75,0:08:31.13,Default,,0,0,0,,Фи 3-тен 1 ұпаймен жеңеді!
Dialogue: 0,0:08:31.51,0:08:33.01,Default,,0,0,0,,Тағы бір рет! (операция дыбысы)
Dialogue: 0,0:08:36.26,0:08:37.55,Default,,0,0,0,,3-1 пункттер...
Dialogue: 0,0:08:37.68,0:08:39.18,Default,,0,0,0,,Тағы бір рет!
Dialogue: 0,0:08:42.52,0:08:45.02,Default,,0,0,0,,Өлі Феникстің жарылуы аяқталды
Dialogue: 0,0:08:45.14,0:08:48.40,Default,,0,0,0,,Фи 3-тен 1 ұпаймен жеңеді!
Dialogue: 0,0:08:49.73,0:08:52.24,Default,,0,0,0,,Тағы бір рет... (Токонацу) Тағы бір рет!
Dialogue: 0,0:08:56.16,0:08:58.28,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:59.03,0:09:01.83,Default,,0,0,0,,Тек ашуды шығаруға жаттығу және т.б.
Dialogue: 0,0:09:01.95,0:09:04.25,Default,,0,0,0,,Қанша тырыссаң да, Пхиді жеңе алмайсың!
Dialogue: 0,0:09:04.75,0:09:08.25,Default,,0,0,0,,Айтпасаң да білем!
Dialogue: 0,0:09:09.54,0:09:11.21,Default,,0,0,0,,Мен білемін, бірақ...
Dialogue: 0,0:09:12.38,0:09:13.26,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:09:13.80,0:09:18.18,Default,,0,0,0,,Мен оны кешіре алмаймын!
Dialogue: 0,0:09:21.10,0:09:24.68,Default,,0,0,0,,Не! Сізде Айга жоқ па?
Dialogue: 0,0:09:25.10,0:09:26.44,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:09:27.31,0:09:30.40,Default,,0,0,0,,Шатырда да, еш жерде де емес...
Dialogue: 0,0:09:30.94,0:09:31.77,Default,,0,0,0,,Фубуки!
Dialogue: 0,0:09:31.90,0:09:34.19,Default,,0,0,0,,Себебі Теме қажетсіз сөздер айтады.
Dialogue: 0,0:09:34.32,0:09:37.20,Default,,0,0,0,,Ешқашан берілмедің және үйге қайттың, солай ма?
Dialogue: 0,0:09:37.32,0:09:38.61,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:09:38.74,0:09:40.20,Default,,0,0,0,,Айға осындай әрекетке барар ма еді?
Dialogue: 0,0:09:40.62,0:09:42.99,Default,,0,0,0,,Әйтеуір, бөлініп, ізденейік.
Dialogue: 0,0:09:43.24,0:09:44.75,Default,,0,0,0,,Бенимару мен Джонси сол жерде.
Dialogue: 0,0:09:44.87,0:09:45.79,Default,,0,0,0,,Иә! (Бенимару) Жарайды!
Dialogue: 0,0:09:46.04,0:09:48.04,Default,,0,0,0,,Бей клубы - анау-мынау...
Dialogue: 0,0:09:48.29,0:09:49.79,Default,,0,0,0,,Айға сонда.
Dialogue: 0,0:09:49.92,0:09:50.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:55.21,0:09:56.59,Default,,0,0,0,,
Dialogue: 0,0:09:59.22,0:10:00.55,Default,,0,0,0,,Уф! Және...
Dialogue: 0,0:10:00.68,0:10:01.85,Default,,0,0,0,,Бар!
Dialogue: 0,0:10:02.47,0:10:04.47,Default,,0,0,0,,Мені ұрма, ауырып тұр!
Dialogue: 0,0:10:04.60,0:10:06.73,Default,,0,0,0,,Әй?
Dialogue: 0,0:10:07.18,0:10:08.35,Default,,0,0,0,,Сүйегім сынды!
Dialogue: 0,0:10:08.48,0:10:09.77,Default,,0,0,0,,Қалай...
Dialogue: 0,0:10:09.90,0:10:12.48,Default,,0,0,0,,Иә? Неге мұндасың?
Dialogue: 0,0:10:12.61,0:10:14.23,Default,,0,0,0,,Хаа…
Dialogue: 0,0:10:15.82,0:10:18.74,Default,,0,0,0,,Жоқ, мен кеше түнде ұйықтай алмадым...
Dialogue: 0,0:10:18.95,0:10:21.99,Default,,0,0,0,,Сәйкестік өте жақын болса да, менің күш-қуатым таусылды.
Dialogue: 0,0:10:22.12,0:10:22.95,Default,,0,0,0,,Фубуки
Dialogue: 0,0:10:23.08,0:10:23.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:24.16,0:10:27.04,Default,,0,0,0,,Кеше маған не болды?
Dialogue: 0,0:10:27.79,0:10:28.79,Default,,0,0,0,,Бұл туралы алаңдамаңыз
Dialogue: 0,0:10:28.91,0:10:32.79,Default,,0,0,0,,Эй, Теме және т.б. Олармен жай ғана татуласпаңыз!
Dialogue: 0,0:10:33.29,0:10:35.55,Default,,0,0,0,,Жарайды, бізде де бүгін арнайы дайындық бар!
Dialogue: 0,0:10:35.67,0:10:37.17,Default,,0,0,0,,Өтінемін, Сочо!
Dialogue: 0,0:10:37.30,0:10:39.05,Default,,0,0,0,,Эй, мен көмектесе алмаймын.
Dialogue: 0,0:10:39.18,0:10:42.05,Default,,0,0,0,,Мен қатты жаттығамын, дайындал!
Dialogue: 0,0:10:42.43,0:10:45.31,Default,,0,0,0,,Оған дейін есеп болады деп ойлаймын.
Dialogue: 0,0:10:45.68,0:10:46.93,Default,,0,0,0,,Есеп беру?
Dialogue: 0,0:10:47.31,0:10:48.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:49.73,0:10:50.56,Default,,0,0,0,,Иә...
Dialogue: 0,0:10:50.94,0:10:54.82,Default,,0,0,0,,Негізі Шу-кун мен Фай арасындағы шайқасқа шолу жасадым.
Dialogue: 0,0:10:54.94,0:10:57.44,Default,,0,0,0,,Әлсіз жері бар ма деп ойладым.
Dialogue: 0,0:10:57.69,0:10:59.03,Default,,0,0,0,,Барлығы?
Dialogue: 0,0:10:59.15,0:11:00.07,Default,,0,0,0,,Иә
Dialogue: 0,0:11:00.40,0:11:02.07,Default,,0,0,0,,Сонда қалай болды?
Dialogue: 0,0:11:02.32,0:11:03.82,Default,,0,0,0,,Бұл таңқаларлық
Dialogue: 0,0:11:04.24,0:11:07.91,Default,,0,0,0,,Деструктивті күш өте жоғары және қорғаныс мінсіз.
Dialogue: 0,0:11:08.20,0:11:11.83,Default,,0,0,0,,Тіпті зақымдануды қуатқа айналдыруға болады, бұл керемет жылдамдық пен төзімділікке әкеледі...
Dialogue: 0,0:11:11.96,0:11:14.71,Default,,0,0,0,,Қысқасы, әлсіз жақтары жоқ.
Dialogue: 0,0:11:17.09,0:11:19.34,Default,,0,0,0,,Бір сөзбен айтқанда...
Dialogue: 0,0:11:19.84,0:11:21.01,Default,,0,0,0,,Барлығыңызға рахмет!
Dialogue: 0,0:11:21.13,0:11:21.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:23.22,0:11:25.51,Default,,0,0,0,,Осыны түсінсеңіз жеткілікті.
Dialogue: 0,0:11:26.43,0:11:30.14,Default,,0,0,0,,Демек, оны бар күшіңмен жоюдан басқа амалың жоқ!
Dialogue: 0,0:11:30.27,0:11:31.56,Default,,0,0,0,,(Барлығы күледі)
Dialogue: 0,0:11:32.06,0:11:32.90,Default,,0,0,0,,Хехе
Dialogue: 0,0:11:33.02,0:11:33.94,Default,,0,0,0,,Сен тым наивсің.
Dialogue: 0,0:11:34.06,0:11:36.27,Default,,0,0,0,,Сонда сіз Фиге қарсы жеңе алмайсыз.
Dialogue: 0,0:11:36.40,0:11:37.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:39.86,0:11:40.74,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:41.28,0:11:43.03,Default,,0,0,0,,Шу мырза! Шу-сенпай!
Dialogue: 0,0:11:45.03,0:11:47.54,Default,,0,0,0,,Шу-сенпай... Шу-сан
Dialogue: 0,0:11:48.87,0:11:50.91,Default,,0,0,0,,Тек қолыңнан келгеннің бәрін істе...
Dialogue: 0,0:11:51.29,0:11:53.46,Default,,0,0,0,,Фи ондай оңай қарсылас емес.
Dialogue: 0,0:11:53.83,0:11:58.59,Default,,0,0,0,,Өлі Феникстің өлі өлілерді сіңірген күші елестету мүмкін емес.
Dialogue: 0,0:11:59.21,0:12:01.97,Default,,0,0,0,,Шынымен шайқасқандар ғана түсінеді.
Dialogue: 0,0:12:03.13,0:12:03.97,Default,,0,0,0,,Фубуки
Dialogue: 0,0:12:05.47,0:12:06.35,Default,,0,0,0,,Ранжиро
Dialogue: 0,0:12:07.51,0:12:10.10,Default,,0,0,0,,Ал Суох, маған күшіңді бер.
Dialogue: 0,0:12:11.10,0:12:13.35,Default,,0,0,0,,Балалар сендермен және мына жігітпен
Dialogue: 0,0:12:13.48,0:12:16.23,Default,,0,0,0,,Айгаға Фи күшін сезінсін
Dialogue: 0,0:12:16.65,0:12:18.57,Default,,0,0,0,,Super Z Spriggan!
Dialogue: 0,0:12:18.69,0:12:20.36,Default,,0,0,0,,Сіз оны жандандырдыңыз ба?
Dialogue: 0,0:12:20.48,0:12:22.99,Default,,0,0,0,,Амал жоқ, мені үйретуге?
Dialogue: 0,0:12:23.36,0:12:25.36,Default,,0,0,0,,Тек сізге емес
Dialogue: 0,0:12:26.12,0:12:28.74,Default,,0,0,0,,Бұл да менің жеке шайқасым.
Dialogue: 0,0:12:29.37,0:12:30.24,Default,,0,0,0,,Шу…
Dialogue: 0,0:12:30.74,0:12:32.04,Default,,0,0,0,,Шу мырза
Dialogue: 0,0:12:34.21,0:12:35.62,Default,,0,0,0,,Өлі Феникс
Dialogue: 0,0:12:35.75,0:12:39.00,Default,,0,0,0,,Сіз абайсызда шабуыл жасасаңыз да, шыдамдылығыңызды жоғалтасыз.
Dialogue: 0,0:12:39.50,0:12:42.88,Default,,0,0,0,,Онымен күресудің бірден-бір жолы - оны мұқият қорғау.
Dialogue: 0,0:12:43.01,0:12:46.72,Default,,0,0,0,,Әрине, олар Super Z оянуын шығаруды мақсат етеді.
Dialogue: 0,0:12:47.01,0:12:51.02,Default,,0,0,0,,Шабуылға төтеп бер, қорға, қорға, қорға.
Dialogue: 0,0:12:51.14,0:12:52.77,Default,,0,0,0,,Жеңістің бір сәттік мүмкіндігін пайдаланыңыз
Dialogue: 0,0:12:53.14,0:12:55.52,Default,,0,0,0,,Бұл Фиді жеңудің жалғыз жолы
Dialogue: 0,0:12:55.85,0:12:56.77,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:12:56.90,0:13:00.40,Default,,0,0,0,,Тек оны қорғаңыз және жеңіске жетудің сәтті мүмкіндігін пайдаланыңыз.
Dialogue: 0,0:13:00.52,0:13:03.90,Default,,0,0,0,,Сонда бұл төмен баланс.
Dialogue: 0,0:13:04.28,0:13:06.28,Default,,0,0,0,,Ранжиро Фубуки Суоу
Dialogue: 0,0:13:06.41,0:13:08.53,Default,,0,0,0,,Сіз байланыстыруды білдіңіз бе?
Dialogue: 0,0:13:08.66,0:13:09.53,Default,,0,0,0,,Иә! (Сочо) О!
Dialogue: 0,0:13:09.91,0:13:12.54,Default,,0,0,0,,4-тен 1-ге дейін төзе аласыз ба?
Dialogue: 0,0:13:12.66,0:13:13.70,Default,,0,0,0,,Айга…
Dialogue: 0,0:13:16.50,0:13:17.58,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:13:17.92,0:13:21.38,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:13:21.55,0:13:24.13,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:13:24.26,0:13:25.30,Default,,0,0,0,,Әй!
Dialogue: 0,0:13:33.27,0:13:35.18,Default,,0,0,0,,Менен бастаңыз!
Dialogue: 0,0:13:35.43,0:13:38.40,Default,,0,0,0,,Желді темір қанаттарымен айналдыр!
Dialogue: 0,0:13:39.27,0:13:42.27,Default,,0,0,0,,Рагнарук дауылы!
Dialogue: 0,0:13:42.65,0:13:44.03,Default,,0,0,0,,Мен келесім!
Dialogue: 0,0:13:44.61,0:13:47.53,Default,,0,0,0,,Император апаты!
Dialogue: 0,0:13:50.78,0:13:53.87,Default,,0,0,0,,Кенран тозақтан құлады!
Dialogue: 0,0:13:57.33,0:13:58.37,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:13:58.75,0:14:01.34,Default,,0,0,0,,Ахиллестің төзімділігі бірден жойылды.
Dialogue: 0,0:14:01.75,0:14:03.50,Default,,0,0,0,,Фубуки! аа!
Dialogue: 0,0:14:03.63,0:14:05.01,Default,,0,0,0,,Жүр!
Dialogue: 0,0:14:05.80,0:14:07.26,Default,,0,0,0,,Өлі Стингер Пресс!
Dialogue: 0,0:14:07.76,0:14:09.51,Default,,0,0,0,,Феникспен бірдей!
Dialogue: 0,0:14:16.85,0:14:18.23,Default,,0,0,0,,Ахиллес!
Dialogue: 0,0:14:18.60,0:14:20.35,Default,,0,0,0,,Тоқта! (Ичи) Ә? Мұнда ма?
Dialogue: 0,0:14:20.48,0:14:21.73,Default,,0,0,0,,Айгаға шыда
Dialogue: 0,0:14:22.44,0:14:24.86,Default,,0,0,0,,Оған төзе білу керек.
Dialogue: 0,0:14:24.98,0:14:29.82,Default,,0,0,0,,Шайтанмен жаңғырсаң да көзіңнен ұшқын кетпеген.
Dialogue: 0,0:14:34.29,0:14:37.75,Default,,0,0,0,,Уууу!
Dialogue: 0,0:14:39.83,0:14:41.46,Default,,0,0,0,,Жарайды, мен шыдадым!
Dialogue: 0,0:14:42.08,0:14:43.21,Default,,0,0,0,,Саламандр!
Dialogue: 0,0:14:43.34,0:14:44.21,Default,,0,0,0,,Форнеус!
Dialogue: 0,0:14:49.22,0:14:51.34,Default,,0,0,0,,Бұл жолы Форнеус пен Саламандермен
Dialogue: 0,0:14:51.47,0:14:53.10,Default,,0,0,0,,Өлі Стингер Пресс!
Dialogue: 0,0:14:53.22,0:14:54.35,Default,,0,0,0,,Пане
Dialogue: 0,0:15:00.69,0:15:01.52,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:15:02.15,0:15:04.90,Default,,0,0,0,,Super Spriggan Slash!
Dialogue: 0,0:15:11.07,0:15:11.95,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:12.41,0:15:13.28,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:14.07,0:15:16.45,Default,,0,0,0,,Ахиллестің жоғалуы…
Dialogue: 0,0:15:16.91,0:15:18.29,Default,,0,0,0,,Ахиллес!
Dialogue: 0,0:15:21.29,0:15:23.00,Default,,0,0,0,,Ахиллестің дауысын көбірек тыңдаңыз!
Dialogue: 0,0:15:23.13,0:15:23.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:24.34,0:15:26.50,Default,,0,0,0,,Оған төзе алатыныңызға сенімдімін.
Dialogue: 0,0:15:29.55,0:15:30.93,Default,,0,0,0,,Моккаида!
Dialogue: 0,0:15:31.80,0:15:34.05,Default,,0,0,0,,Super Spriggan Slash!
Dialogue: 0,0:15:38.97,0:15:39.81,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:15:44.69,0:15:46.61,Default,,0,0,0,,Сондай-ақ жарылыс жоғалту
Dialogue: 0,0:15:47.23,0:15:48.19,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:15:48.32,0:15:49.82,Default,,0,0,0,,Кішкене үзіліс жасайық.
Dialogue: 0,0:15:49.94,0:15:51.45,Default,,0,0,0,,Бәрібір жақсы!
Dialogue: 0,0:15:51.57,0:15:53.45,Default,,0,0,0,,Мен білемін, бірақ...
Dialogue: 0,0:15:53.57,0:15:54.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:55.07,0:15:58.29,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:15:58.41,0:16:01.71,Default,,0,0,0,,Егер сіз Фи шайқасын қайта жасай алмасаңыз, бұл жақсы тәжірибе емес.
Dialogue: 0,0:16:03.58,0:16:06.59,Default,,0,0,0,,Олай болса, сол уақыт ішінде біз сізбен айналысамыз!
Dialogue: 0,0:16:07.13,0:16:07.96,Default,,0,0,0,,Әй?
Dialogue: 0,0:16:08.34,0:16:11.13,Default,,0,0,0,,Фи шайқастарын қайта жасай алмасаңыз да
Dialogue: 0,0:16:11.26,0:16:13.59,Default,,0,0,0,,Шыдамдылықты арттырыңыз Жаттығу үшін жеткілікті болады
Dialogue: 0,0:16:13.72,0:16:14.72,Default,,0,0,0,,Оған сіздер, студенттер де кіресіздер.
Dialogue: 0,0:16:15.09,0:16:17.26,Default,,0,0,0,,Өтінемін, бәріңе!
Dialogue: 0,0:16:17.39,0:16:18.60,Default,,0,0,0,,Хехе
Dialogue: 0,0:16:19.06,0:16:19.89,Default,,0,0,0,,Хехе...
Dialogue: 0,0:16:20.02,0:16:21.98,Default,,0,0,0,,Өзіңізден бастайық!
Dialogue: 0,0:16:22.52,0:16:24.85,Default,,0,0,0,,Жарайды, жүр!
Dialogue: 0,0:16:25.52,0:16:28.86,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:16:29.07,0:16:31.61,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:16:31.82,0:16:33.11,Default,,0,0,0,,(5 адам айғайлайды)
Dialogue: 0,0:16:33.24,0:16:36.62,Default,,0,0,0,,Жылама! Ақымақ, Косей! Енді мен де…
Dialogue: 0,0:16:38.99,0:16:41.91,Default,,0,0,0,,Барлығы Айга үшін...
Dialogue: 0,0:16:42.25,0:16:43.25,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:46.54,0:16:48.59,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:16:56.80,0:17:00.64,Default,,0,0,0,,Сен менің өмірімді құтқардың, Аои Барто.
Dialogue: 0,0:17:00.89,0:17:03.98,Default,,0,0,0,,Бірақ Ахиллестен кейін жойылатын келесісі
Dialogue: 0,0:17:04.39,0:17:06.40,Default,,0,0,0,,Бұл сіздің Валькирияңыз.
Dialogue: 0,0:17:06.81,0:17:08.61,Default,,0,0,0,,Өлі үзіліс!
Dialogue: 0,0:17:17.41,0:17:19.45,Default,,0,0,0,,Күте тұрыңыз, Аои Балт.
Dialogue: 0,0:17:20.08,0:17:23.50,Default,,0,0,0,,Мен саған нағыз үмітсіздіктің дәмін татамын!
Dialogue: 0,0:17:28.21,0:17:29.17,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:17:29.54,0:17:30.79,Default,,0,0,0,,Әлі емес.
Dialogue: 0,0:17:31.30,0:17:33.55,Default,,0,0,0,,Мен Пхиді жеңе алмаймын деп ойлаймын...
Dialogue: 0,0:17:33.67,0:17:35.42,Default,,0,0,0,,Жоқ, білмеймін.
Dialogue: 0,0:17:35.55,0:17:36.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:37.18,0:17:40.43,Default,,0,0,0,,Ахиллестің қорғаныс күші сөзсіз өсті.
Dialogue: 0,0:17:40.80,0:17:44.85,Default,,0,0,0,,Қазіргі шайқаста да мен ақырында шабуыл жасай алмадым.
Dialogue: 0,0:17:45.56,0:17:46.81,Default,,0,0,0,,Моккаида!
Dialogue: 0,0:17:47.81,0:17:50.77,Default,,0,0,0,,Аллаға шүкір, уақытында жасадым!
Dialogue: 0,0:17:51.44,0:17:53.23,Default,,0,0,0,,Кеттік, Ахиллес
Dialogue: 0,0:17:54.49,0:17:55.57,Default,,0,0,0,,Бұл жолы!
Dialogue: 0,0:17:56.20,0:17:59.32,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:17:59.57,0:18:02.08,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:18:02.20,0:18:03.24,Default,,0,0,0,,(4 адам айғайлайды)
Dialogue: 0,0:18:06.79,0:18:08.12,Default,,0,0,0,,Кеттік, Айға!
Dialogue: 0,0:18:08.71,0:18:10.88,Default,,0,0,0,,Рагнарук дауылы!
Dialogue: 0,0:18:11.21,0:18:13.00,Default,,0,0,0,,Император апаты!
Dialogue: 0,0:18:14.25,0:18:16.55,Default,,0,0,0,,Кенран тозақтан құлады!
Dialogue: 0,0:18:21.80,0:18:23.68,Default,,0,0,0,,Ах! Жарайды, мен ұстап тұрмын!
Dialogue: 0,0:18:23.81,0:18:24.81,Default,,0,0,0,,Пане
Dialogue: 0,0:18:28.23,0:18:29.27,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:29.39,0:18:31.06,Default,,0,0,0,,Әлі жоқ!
Dialogue: 0,0:18:36.78,0:18:37.61,Default,,0,0,0,,Келе жатыр!
Dialogue: 0,0:18:38.07,0:18:40.70,Default,,0,0,0,,Super Spriggan Slash!
Dialogue: 0,0:18:45.87,0:18:48.62,Default,,0,0,0,,Super Z Shield!
Dialogue: 0,0:18:54.84,0:18:55.67,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:56.05,0:18:57.67,Default,,0,0,0,,Мен шыдадым!
Dialogue: 0,0:18:57.84,0:19:00.18,Default,,0,0,0,,Уууу!
Dialogue: 0,0:19:00.97,0:19:03.39,Default,,0,0,0,,Ахиллес!
Dialogue: 0,0:19:05.56,0:19:07.89,Default,,0,0,0,,Ооо...
Dialogue: 0,0:19:08.02,0:19:08.93,Default,,0,0,0,,Әй!
Dialogue: 0,0:19:09.43,0:19:10.27,Default,,0,0,0,,Спригган!
Dialogue: 0,0:19:16.86,0:19:18.07,Default,,0,0,0,,(Спригганның ұрыс айқайы)
Dialogue: 0,0:19:18.36,0:19:21.32,Default,,0,0,0,,Super Z қылыш!
Dialogue: 0,0:19:24.91,0:19:27.49,Default,,0,0,0,,Супер қарсы үзіліс!
Dialogue: 0,0:19:36.04,0:19:36.88,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:37.34,0:19:38.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:38.67,0:19:40.42,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:43.30,0:19:45.80,Default,,0,0,0,,Грррр!
Dialogue: 0,0:19:46.01,0:19:48.81,Default,,0,0,0,,Ахиллес!
Dialogue: 0,0:19:50.14,0:19:50.98,Default,,0,0,0,,Ха!
Dialogue: 0,0:19:54.90,0:19:56.11,Default,,0,0,0,,Ти!
Dialogue: 0,0:20:07.62,0:20:10.08,Default,,0,0,0,,Айга жеңді...
Dialogue: 0,0:20:10.20,0:20:12.92,Default,,0,0,0,,Ақыры... Мен мұны істедім!
Dialogue: 0,0:20:13.54,0:20:15.00,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:15.13,0:20:17.50,Default,,0,0,0,,(қуаныш дыбыстары)
Dialogue: 0,0:20:17.63,0:20:22.17,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:20:22.30,0:20:23.26,Default,,0,0,0,,Айға
Dialogue: 0,0:20:24.43,0:20:26.97,Default,,0,0,0,,Сочо! барлығы!
Dialogue: 0,0:20:28.14,0:20:28.97,Default,,0,0,0,,Хехе
Dialogue: 0,0:20:29.47,0:20:32.39,Default,,0,0,0,,Бұл тренингті босқа өткізбеңіз!
Dialogue: 0,0:20:32.98,0:20:34.39,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:20:34.77,0:20:36.40,Default,,0,0,0,,Жарайсың Айга!
Dialogue: 0,0:20:36.52,0:20:37.77,Default,,0,0,0,,О!
Dialogue: 0,0:20:38.32,0:20:39.82,Default,,0,0,0,,А... білесің бе.
Dialogue: 0,0:20:40.40,0:20:43.03,Default,,0,0,0,,Өйткені бәрі Айға үшін аянбай еңбек етуде
Dialogue: 0,0:20:43.15,0:20:45.82,Default,,0,0,0,,Мен Нарудың да қолынан бірдеңе келе ме деп ойладым.
Dialogue: 0,0:20:47.82,0:20:49.91,Default,,0,0,0,,Бұл менің жасағаным.
Dialogue: 0,0:20:50.04,0:20:51.54,Default,,0,0,0,,О!
Dialogue: 0,0:20:52.04,0:20:54.54,Default,,0,0,0,,Әй, тартылған ет котлет сэндвич!
Dialogue: 0,0:20:55.29,0:20:57.54,Default,,0,0,0,,Бұл өте қалың!
Dialogue: 0,0:20:57.92,0:20:59.59,Default,,0,0,0,,тым қалың.
Dialogue: 0,0:20:59.71,0:21:02.21,Default,,0,0,0,,Бұл анамдікіндей дәмді болмауы мүмкін, бірақ...
Dialogue: 0,0:21:03.05,0:21:06.43,Default,,0,0,0,,Фимен шайқас Жеңіске жетіңіз!
Dialogue: 0,0:21:06.80,0:21:07.68,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:07.80,0:21:11.18,Default,,0,0,0,,Фимен шайқас тек маған қатысты емес.
Dialogue: 0,0:21:11.56,0:21:14.48,Default,,0,0,0,,Бұл жерде барлығы үшін шайқас!
Dialogue: 0,0:21:16.23,0:21:20.32,Default,,0,0,0,,Барлығы, мынаны жеп, менімен төбелесіңдер!
Dialogue: 0,0:21:20.48,0:21:21.57,Default,,0,0,0,,О!
Dialogue: 0,0:21:21.73,0:21:22.82,Default,,0,0,0,,Хехехе
Dialogue: 0,0:21:23.19,0:21:24.90,Default,,0,0,0,,Әрине!
Dialogue: 0,0:21:25.57,0:21:26.95,Default,,0,0,0,,Ахх
Dialogue: 0,0:21:28.37,0:21:29.20,Default,,0,0,0,,Дәмді!
Dialogue: 0,0:21:29.57,0:21:31.08,Default,,0,0,0,,Бұл өте жақсы
Dialogue: 0,0:21:31.20,0:21:33.04,Default,,0,0,0,,Мұны шынымен Нару жасады ма?
Dialogue: 0,0:21:33.16,0:21:35.21,Default,,0,0,0,,Көрейік, көрейік, бірақ...
Dialogue: 0,0:21:35.33,0:21:37.00,Default,,0,0,0,,Қалағаныңызша алуға болады!
Dialogue: 0,0:21:37.12,0:21:38.33,Default,,0,0,0,,Мен…
Dialogue: 0,0:21:42.67,0:21:44.76,Default,,0,0,0,,Менде барлығы бар
Dialogue: 0,0:21:45.47,0:21:47.80,Default,,0,0,0,,Мен міндетті түрде жеңемін!
Dialogue: 0,0:21:48.14,0:21:49.51,Default,,0,0,0,,Ахх
Dialogue: 0,0:21:50.14,0:21:53.60,Default,,0,0,0,,Ммммммм!
Dialogue: 0,0:21:54.89,0:22:00.90,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:23:18.39,0:23:24.40,Default,,0,0,0,,~♪
Dialogue: 0,0:23:25.69,0:23:27.11,Default,,0,0,0,,Жарқын матч!
Dialogue: 0,0:23:27.48,0:23:31.20,Default,,0,0,0,,Фи Ахиллесті азаптап, оны жоюды жоспарлайды.
Dialogue: 0,0:23:31.45,0:23:33.57,Default,,0,0,0,,Ахиллес I...
Dialogue: 0,0:23:34.32,0:23:37.16,Default,,0,0,0,,Бірақ бәрі мені қолдап жатыр.
Dialogue: 0,0:23:37.54,0:23:39.33,Default,,0,0,0,,Сөзсіз жеңіңіз!
Dialogue: 0,0:23:40.08,0:23:42.00,Default,,0,0,0,,Келесі жолы «Beyblade Burst Super Zetsu»
Dialogue: 0,0:23:42.29,0:23:44.42,Default,,0,0,0,,“Айга VS Фи!!”
Dialogue: 0,0:23:44.67,0:23:46.17,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:46.29,0:23:48.34,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:49.84,0:23:55.84,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory