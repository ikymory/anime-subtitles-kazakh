Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.62,0:00:04.04,Default,,0,0,0,,Бейблейд
Dialogue: 0,0:00:04.17,0:00:08.09,Default,,0,0,0,,Мықты болуды мақсат еткен ұлдардың арманының жемісі.
Dialogue: 0,0:00:08.75,0:00:12.47,Default,,0,0,0,,Ал қазір супер Цетсу дәуірі қызып келеді.
Dialogue: 0,0:00:12.63,0:00:17.01,Default,,0,0,0,,Металл сауыт киіп, Беймен шытырман оқиғаға барыңыз!
Dialogue: 0,0:00:17.22,0:00:19.51,Default,,0,0,0,,Әлем чемпионы болуды мақсат етіңіз!
Dialogue: 0,0:00:19.64,0:00:24.64,Default,,0,0,0,,Super Zetsu Super Zetsu Super Zetsu!
Dialogue: 0,0:00:24.77,0:00:28.52,Default,,0,0,0,,Ең күшті және жеңілмейтін атағын алатын адам сенсің!
Dialogue: 0,0:00:31.40,0:00:33.65,Default,,0,0,0,,Мен үйдемін!
Dialogue: 0,0:00:36.70,0:00:39.58,Default,,0,0,0,,Мен Куришудан кеңес алдым.
Dialogue: 0,0:00:39.70,0:00:42.37,Default,,0,0,0,,Мен жаңа Ахиллес құруды бастадым.
Dialogue: 0,0:00:42.87,0:00:45.42,Default,,0,0,0,,Бұл менің жаңа Ахиллесім
Dialogue: 0,0:00:45.62,0:00:47.58,Default,,0,0,0,,Super Z Ахиллес!
Dialogue: 0,0:00:47.79,0:00:49.96,Default,,0,0,0,,Менің ойымша, мен Омахпен тағы да күресе аламын.
Dialogue: 0,0:00:50.63,0:00:52.71,Default,,0,0,0,,Бенишуу! О, менің!
Dialogue: 0,0:00:55.97,0:00:58.09,Default,,0,0,0,,Бұл шықты! Super Z қанаты!
Dialogue: 0,0:01:03.68,0:01:06.56,Default,,0,0,0,,Уау! (Гүрілдеу)
Dialogue: 0,0:01:17.28,0:01:18.49,Default,,0,0,0,,Не істеймін… не істеймін!
Dialogue: 0,0:01:18.62,0:01:21.24,Default,,0,0,0,,Шуды жеңдім!
Dialogue: 0,0:01:21.49,0:01:22.99,Default,,0,0,0,,Жарайсың Айга!
Dialogue: 0,0:01:23.12,0:01:24.29,Default,,0,0,0,,О!
Dialogue: 0,0:01:24.41,0:01:25.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:25.54,0:01:26.37,Default,,0,0,0,,Иә
Dialogue: 0,0:01:26.50,0:01:29.04,Default,,0,0,0,,Жарайсың, Super Z ояну
Dialogue: 0,0:01:32.50,0:01:35.59,Default,,0,0,0,,Мен жасадым... Мен жасадым
Dialogue: 0,0:01:36.51,0:01:38.13,Default,,0,0,0,,Ахиллес!
Dialogue: 0,0:01:43.31,0:01:49.31,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:03:06.68,0:03:12.69,Default,,0,0,0,,~♪
Dialogue: 0,0:03:22.66,0:03:23.99,Default,,0,0,0,,Хехе
Dialogue: 0,0:03:24.49,0:03:25.83,Default,,0,0,0,,Сіз бақытты көрінесіз.
Dialogue: 0,0:03:26.20,0:03:30.54,Default,,0,0,0,,Енді бірінші рет шығанақ жасаған кез есіме түсті.
Dialogue: 0,0:03:30.83,0:03:33.54,Default,,0,0,0,,Ой, бұл қызық болды.
Dialogue: 0,0:03:33.67,0:03:37.80,Default,,0,0,0,,Мен үнемі жеңіске жетуді ойладым.
Dialogue: 0,0:03:37.92,0:03:40.42,Default,,0,0,0,,Әрине, егер сізде жеңіске деген ниет болмаса
Dialogue: 0,0:03:40.55,0:03:41.55,Default,,0,0,0,,Күшті бола алмайды
Dialogue: 0,0:03:42.30,0:03:44.72,Default,,0,0,0,,Бірақ ең бастысы
Dialogue: 0,0:03:44.84,0:03:47.43,Default,,0,0,0,,Бұл Beyblade-ден шындап ләззат алу дегенді білдіреді.
Dialogue: 0,0:03:47.81,0:03:48.89,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:03:49.02,0:03:51.68,Default,,0,0,0,,Ахиллеспен қарым-қатынасыңызды қалпына келтіре алмайсыз ба?
Dialogue: 0,0:03:52.06,0:03:54.77,Default,,0,0,0,,Мен бар күшімді бере аламын.
Dialogue: 0,0:03:55.10,0:03:57.69,Default,,0,0,0,,Өз жолыңды өзің белгіле
Dialogue: 0,0:03:58.07,0:04:02.11,Default,,0,0,0,,Осы сәттен бастап мен де сенің қабырғаң боламын.
Dialogue: 0,0:04:02.57,0:04:03.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:14.17,0:04:16.08,Default,,0,0,0,,Жапония?
Dialogue: 0,0:04:16.21,0:04:17.71,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:04:18.09,0:04:20.80,Default,,0,0,0,,Иә, бұл жақсы жел.
Dialogue: 0,0:04:21.26,0:04:22.17,Default,,0,0,0,,(қой малау)
Dialogue: 0,0:04:22.30,0:04:24.63,Default,,0,0,0,,Ей, көп тамақтан.
Dialogue: 0,0:04:24.88,0:04:27.18,Default,,0,0,0,,О, жарайды, жарайды...
Dialogue: 0,0:04:27.30,0:04:28.47,Default,,0,0,0,,Айга! иә?
Dialogue: 0,0:04:28.60,0:04:30.22,Default,,0,0,0,,Bay жаңалықтары басталғалы жатыр
Dialogue: 0,0:04:30.60,0:04:33.69,Default,,0,0,0,,Мен үлкен жаңалық бар деп естідім.
Dialogue: 0,0:04:34.06,0:04:35.69,Default,,0,0,0,,Үлкен жаңалық?
Dialogue: 0,0:04:36.48,0:04:39.02,Default,,0,0,0,,Жарайды! Ұлдар мен қыздар!
Dialogue: 0,0:04:39.15,0:04:42.19,Default,,0,0,0,,Қызыл жүз Айга мен Жүректердің шайқасы шешілді!
Dialogue: 0,0:04:42.82,0:04:44.90,Default,,0,0,0,,Бұрынғы чемпион және бұрынғы чемпион бойынша
Dialogue: 0,0:04:45.03,0:04:46.70,Default,,0,0,0,,Керемет карта!
Dialogue: 0,0:04:47.07,0:04:48.70,Default,,0,0,0,,Жарайсыңдар!
Dialogue: 0,0:04:48.83,0:04:50.58,Default,,0,0,0,,Жарайсың Айга!
Dialogue: 0,0:04:50.70,0:04:52.25,Default,,0,0,0,,Бұл кек алу мүмкіндігі.
Dialogue: 0,0:04:52.37,0:04:53.20,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:53.58,0:04:56.08,Default,,0,0,0,,Жүрек және қызыл жүз Айга
Dialogue: 0,0:04:56.21,0:04:58.96,Default,,0,0,0,,Кім жеңеді? Оны жіберіп алмаңыз!
Dialogue: 0,0:05:00.09,0:05:02.96,Default,,0,0,0,,Ахиллес Жасайық
Dialogue: 0,0:05:03.38,0:05:04.67,Default,,0,0,0,,Әй, Айга?
Dialogue: 0,0:05:04.80,0:05:06.59,Default,,0,0,0,,Жаттығуды бастайық!
Dialogue: 0,0:05:07.09,0:05:08.09,Default,,0,0,0,,О!
Dialogue: 0,0:05:20.77,0:05:22.48,Default,,0,0,0,,Бұл теңдестірілген тип пе?
Dialogue: 0,0:05:23.19,0:05:26.61,Default,,0,0,0,,Бұл ауыр көрінетін диск Double-O дискі.
Dialogue: 0,0:05:26.99,0:05:29.41,Default,,0,0,0,,Бұл өлшем драйвері ме?
Dialogue: 0,0:05:29.91,0:05:34.00,Default,,0,0,0,,Мен тек биіктікті өзгерте алмайтын сияқтымын.
Dialogue: 0,0:05:38.17,0:05:39.08,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:05:39.46,0:05:40.88,Default,,0,0,0,,«Жарайды!» деп айтпаңыз.
Dialogue: 0,0:05:41.00,0:05:41.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:42.21,0:05:44.46,Default,,0,0,0,,Бұл тәжірибе не үшін деп ойлайсыз?
Dialogue: 0,0:05:44.59,0:05:47.47,Default,,0,0,0,,Бұл сөзсіз супер-Z ояту үшін.
Dialogue: 0,0:05:48.05,0:05:49.80,Default,,0,0,0,,Аа, дұрыс...
Dialogue: 0,0:05:50.26,0:05:51.97,Default,,0,0,0,,Кеттік, Айға!
Dialogue: 0,0:05:52.31,0:05:53.31,Default,,0,0,0,,О!
Dialogue: 0,0:05:58.56,0:06:00.73,Default,,0,0,0,,Қарғыс атсын... Мен қайта шыға алмаймын.
Dialogue: 0,0:06:09.11,0:06:10.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:16.33,0:06:19.46,Default,,0,0,0,,Ху~ Бұл өте қымбат болады.
Dialogue: 0,0:06:19.58,0:06:23.21,Default,,0,0,0,,Резеңке білігінің ұшы биіктікке байланысты шығып тұрады немесе тартылады...
Dialogue: 0,0:06:23.59,0:06:25.51,Default,,0,0,0,,Бұл не? Қызық!
Dialogue: 0,0:06:25.63,0:06:28.38,Default,,0,0,0,,Сәлем! Рұқсатсыз не істеп жатырсың?
Dialogue: 0,0:06:28.55,0:06:31.01,Default,,0,0,0,,Сіз Қызыл жүз Айгасыз, солай ма?
Dialogue: 0,0:06:31.22,0:06:33.60,Default,,0,0,0,,Әй, саған менен бірдеңе керек пе?
Dialogue: 0,0:06:34.31,0:06:36.35,Default,,0,0,0,,Мен Балтоның ағасынан көп нәрсені сұрадым.
Dialogue: 0,0:06:36.93,0:06:38.35,Default,,0,0,0,,Мен сенімен танысқым келеді.
Dialogue: 0,0:06:38.48,0:06:40.10,Default,,0,0,0,,Балтоның үлкен ағасы?
Dialogue: 0,0:06:40.48,0:06:43.61,Default,,0,0,0,,Теме Барто Аои не болды?
Dialogue: 0,0:06:43.98,0:06:46.11,Default,,0,0,0,,Мен Кит Лопеспін
Dialogue: 0,0:06:46.48,0:06:48.49,Default,,0,0,0,,Менің ағамның ең жақын досы
Dialogue: 0,0:06:48.74,0:06:49.74,Default,,0,0,0,,Не!
Dialogue: 0,0:06:49.86,0:06:51.49,Default,,0,0,0,,Балтоның ең жақын досы?
Dialogue: 0,0:06:52.91,0:06:54.66,Default,,0,0,0,,Жинақ! иә?
Dialogue: 0,0:06:55.08,0:06:57.54,Default,,0,0,0,,Уау, бұл шынымен де жинақ.
Dialogue: 0,0:06:57.66,0:06:59.66,Default,,0,0,0,,Аха, біраз уақыт өтті!
Dialogue: 0,0:07:00.04,0:07:01.92,Default,,0,0,0,,Келсең келеріңді айт.
Dialogue: 0,0:07:02.54,0:07:04.42,Default,,0,0,0,,Таңқаларлық табыс!
Dialogue: 0,0:07:04.79,0:07:07.05,Default,,0,0,0,,Бойыңыз әлдеқайда өсті.
Dialogue: 0,0:07:07.17,0:07:08.55,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:07:08.67,0:07:10.93,Default,,0,0,0,,Мен қатты таң қалдым.
Dialogue: 0,0:07:11.55,0:07:15.68,Default,,0,0,0,,Жуырда Еуропада жеңіске жеткен BC Sol командасының Кит Лопесі!
Dialogue: 0,0:07:15.81,0:07:19.06,Default,,0,0,0,,Неліктен Кит Лопес рейтингте тез көтерілуде?
Dialogue: 0,0:07:19.48,0:07:20.89,Default,,0,0,0,,Шынымен, Кит?
Dialogue: 0,0:07:21.06,0:07:24.31,Default,,0,0,0,,Сәлем! Сізбен суретке түскенімді қалайсыз ба?
Dialogue: 0,0:07:24.94,0:07:29.32,Default,,0,0,0,,Әй, маған ағаңның аңызы басталған қаланы көрсетші.
Dialogue: 0,0:07:29.78,0:07:31.32,Default,,0,0,0,,Бірақ мен қазір бос емеспін...
Dialogue: 0,0:07:31.45,0:07:32.82,Default,,0,0,0,,Олай болса, жалғастырайық! иә?
Dialogue: 0,0:07:33.20,0:07:35.58,Default,,0,0,0,,Аш болсаң, менің үйіме кел~
Dialogue: 0,0:07:35.87,0:07:37.70,Default,,0,0,0,,Жарайды! Иә…
Dialogue: 0,0:07:37.91,0:07:40.12,Default,,0,0,0,,Оме, бұл итермелеу.
Dialogue: 0,0:07:41.66,0:07:43.08,Default,,0,0,0,,Не істеймін… не істеймін!
Dialogue: 0,0:07:43.33,0:07:47.17,Default,,0,0,0,,Бұл аңызға айналған өзен арнасы! Мен әсер алдым
Dialogue: 0,0:07:47.30,0:07:49.96,Default,,0,0,0,,Аңыз? Бұл қалыпты жағдай емес пе?
Dialogue: 0,0:07:50.09,0:07:51.97,Default,,0,0,0,,Иә? Сен не айтып тұрсың?
Dialogue: 0,0:07:52.09,0:07:54.72,Default,,0,0,0,,Міне, ағам арнайы дайындықтан өтті.
Dialogue: 0,0:07:54.84,0:07:56.72,Default,,0,0,0,,Аа... шынымды айтсам!
Dialogue: 0,0:07:57.10,0:07:58.93,Default,,0,0,0,,Менің ағам осында
Dialogue: 0,0:07:59.72,0:08:01.81,Default,,0,0,0,,Арқада шиналарды ұстап секіру
Dialogue: 0,0:08:01.93,0:08:05.73,Default,,0,0,0,,Қол ұстасып, түтік тарту арқылы денемді жаттықтырдым.
Dialogue: 0,0:08:06.36,0:08:08.73,Default,,0,0,0,,Ең жақсы жер емес пе?
Dialogue: 0,0:08:08.86,0:08:11.28,Default,,0,0,0,,Ху~ Мен мұны білмедім.
Dialogue: 0,0:08:11.53,0:08:12.90,Default,,0,0,0,,Енді келесіде!
Dialogue: 0,0:08:13.03,0:08:13.86,Default,,0,0,0,,Әй, жанымнан кетпе!
Dialogue: 0,0:08:14.28,0:08:17.78,Default,,0,0,0,,Міне, сондықтан да сен сонша итермелейсің!
Dialogue: 0,0:08:19.24,0:08:23.46,Default,,0,0,0,,Үлкен аға мен Куришудың алғашқы шайқасы осы жерде болды.
Dialogue: 0,0:08:23.58,0:08:25.50,Default,,0,0,0,,Иә, солай ма?
Dialogue: 0,0:08:26.00,0:08:29.50,Default,,0,0,0,,Сіз осы қалада тұрсаңыз да, шынымен ештеңе білмейсіз.
Dialogue: 0,0:08:29.63,0:08:32.34,Default,,0,0,0,,Мен ештеңе білмегенім өкінішті!
Dialogue: 0,0:08:33.09,0:08:34.97,Default,,0,0,0,,Екеуі де осы жерден
Dialogue: 0,0:08:35.09,0:08:38.30,Default,,0,0,0,,Дүниеде белсенділік танытатын пышақ болдыңыз.
Dialogue: 0,0:08:39.06,0:08:41.47,Default,,0,0,0,,Аңыз осы жерден басталды, солай ма?
Dialogue: 0,0:08:46.98,0:08:50.15,Default,,0,0,0,,-де? Енді мені қайда апарасың?
Dialogue: 0,0:08:50.69,0:08:54.03,Default,,0,0,0,,Мен саған айналаны көрсетуім керек...
Dialogue: 0,0:08:54.57,0:08:56.32,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:08:56.70,0:08:59.24,Default,,0,0,0,,Бұл қызық!
Dialogue: 0,0:08:59.37,0:09:00.99,Default,,0,0,0,,Әрі қарай кеттік!
Dialogue: 0,0:09:03.00,0:09:04.75,Default,,0,0,0,,Қалғаны осында.
Dialogue: 0,0:09:04.87,0:09:06.25,Default,,0,0,0,,Мұнда...
Dialogue: 0,0:09:06.67,0:09:10.00,Default,,0,0,0,,Не! Сіз мектепке қайтып келдіңіз, солай емес пе?
Dialogue: 0,0:09:10.46,0:09:13.51,Default,,0,0,0,,Хехе, бұл ерекше орын.
Dialogue: 0,0:09:15.13,0:09:20.01,Default,,0,0,0,,Дәл осы жерде сіз достарыңызбен қарым-қатынас орнаттыңыз.
Dialogue: 0,0:09:21.18,0:09:24.39,Default,,0,0,0,,Эй, Балтоның Беймен байланысы бар.
Dialogue: 0,0:09:24.52,0:09:26.39,Default,,0,0,0,,Бұл жерде жасалған ба?
Dialogue: 0,0:09:26.52,0:09:30.69,Default,,0,0,0,,Сіз қалай ойлайсыз? Сіздің ағаңыздың жағдайында, мүмкін, ол мұны шынымен де білмейді.
Dialogue: 0,0:09:31.07,0:09:34.69,Default,,0,0,0,,Мен оның Беймен табиғи байланыс орнатқанын сеземін.
Dialogue: 0,0:09:35.07,0:09:38.16,Default,,0,0,0,,Әрине? Сіз мұны істей аласыз ба?
Dialogue: 0,0:09:38.36,0:09:40.83,Default,,0,0,0,,Аға болғанның кереметі осы.
Dialogue: 0,0:09:40.99,0:09:42.99,Default,,0,0,0,,Бұл әйелдің Қанды Пері Шығармасы ма?
Dialogue: 0,0:09:43.87,0:09:45.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:45.87,0:09:48.17,Default,,0,0,0,,Басымды қолданғаннан кейін қарным ашылды.
Dialogue: 0,0:09:48.29,0:09:49.54,Default,,0,0,0,,Аха…
Dialogue: 0,0:09:51.17,0:09:53.30,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:09:53.92,0:09:55.05,Default,,0,0,0,,Ахх
Dialogue: 0,0:09:57.13,0:09:58.55,Default,,0,0,0,,Уми~!
Dialogue: 0,0:09:58.80,0:09:59.80,Default,,0,0,0,,Ал Батыста Весталис, оны тоқтатуға бел буған
Dialogue: 0,0:10:00.18,0:10:02.51,Default,,0,0,0,,Біз шынымен жақсы доспыз.
Dialogue: 0,0:10:02.68,0:10:04.18,Default,,0,0,0,,Жинаққа ұқсайды.
Dialogue: 0,0:10:04.68,0:10:06.56,Default,,0,0,0,,Балтоның жағдайы жақсы ма?
Dialogue: 0,0:10:06.68,0:10:09.69,Default,,0,0,0,,Ол қыз маған мүлдем хабарласпайды.
Dialogue: 0,0:10:10.06,0:10:13.19,Default,,0,0,0,,«Арнайы дайындық!» деп отырғаныңызға сенімдімін. қазірге дейін.
Dialogue: 0,0:10:13.44,0:10:16.32,Default,,0,0,0,,Үлкен аға тек Бейді ғана ойлайды.
Dialogue: 0,0:10:16.94,0:10:17.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:17.90,0:10:20.41,Default,,0,0,0,,Арнайы дайындық болса, мен де осында жасадым.
Dialogue: 0,0:10:20.91,0:10:22.66,Default,,0,0,0,,Сіз нан қамырын илеп жатқансыз, солай ма?
Dialogue: 0,0:10:22.78,0:10:25.04,Default,,0,0,0,,Иә мен қамыр илеп жаттым
Dialogue: 0,0:10:25.41,0:10:27.41,Default,,0,0,0,,Балт арнайы дайындыққа келді!
Dialogue: 0,0:10:27.79,0:10:29.04,Default,,0,0,0,,Оны қолданып көргіңіз келе ме?
Dialogue: 0,0:10:29.42,0:10:31.54,Default,,0,0,0,,Жарайды, жасап көрейік!
Dialogue: 0,0:10:31.67,0:10:32.75,Default,,0,0,0,,Мен де!
Dialogue: 0,0:10:33.92,0:10:35.21,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:37.55,0:10:39.05,Default,,0,0,0,,Жақсы Жақсы!
Dialogue: 0,0:10:39.18,0:10:41.68,Default,,0,0,0,,Осылайша Балто да күшейді.
Dialogue: 0,0:10:42.05,0:10:44.43,Default,,0,0,0,,Жарайды, мен жеңілмеймін!
Dialogue: 0,0:10:44.64,0:10:47.14,Default,,0,0,0,,Сәттілік! Ұрыс! (қабырғаның соғылған дыбысы)
Dialogue: 0,0:10:47.27,0:10:49.60,Default,,0,0,0,,Екеуі де жақсы.
Dialogue: 0,0:10:49.73,0:10:53.19,Default,,0,0,0,,Жарайсың, мама, сен білмей тұрып, мен саған көмектесемін.
Dialogue: 0,0:10:53.56,0:10:56.40,Default,,0,0,0,,Сіз атқа мінуге өте жақсысыз, солай емес пе?
Dialogue: 0,0:11:00.03,0:11:02.57,Default,,0,0,0,,Ааа~ Сіз осында тұрасыз ба?
Dialogue: 0,0:11:02.70,0:11:03.53,Default,,0,0,0,,О
Dialogue: 0,0:11:03.82,0:11:06.08,Default,,0,0,0,,Бұл кемпингке ұқсайды және көңілді көрінеді.
Dialogue: 0,0:11:06.20,0:11:07.45,Default,,0,0,0,,Сізге ұнады ма?
Dialogue: 0,0:11:07.70,0:11:09.08,Default,,0,0,0,,Бұл жағдайда түнде болыңыз.
Dialogue: 0,0:11:09.37,0:11:10.62,Default,,0,0,0,,А... жақсы ма?
Dialogue: 0,0:11:11.00,0:11:13.17,Default,,0,0,0,,Қош келдіңіз!
Dialogue: 0,0:11:16.88,0:11:18.09,Default,,0,0,0,,Айға қалай болды
Dialogue: 0,0:11:18.21,0:11:20.51,Default,,0,0,0,,Өлі өлкелерді бағындыруды жоспарлайсыз ба?
Dialogue: 0,0:11:20.80,0:11:22.97,Default,,0,0,0,,Стратегия маңызды емес.
Dialogue: 0,0:11:23.14,0:11:26.89,Default,,0,0,0,,Мен Super Z Ахиллесіммен Жүрек жігітін жоямын!
Dialogue: 0,0:11:28.93,0:11:31.27,Default,,0,0,0,,Менің айтайын дегенім...
Dialogue: 0,0:11:31.39,0:11:32.27,Default,,0,0,0,,Бірақ?
Dialogue: 0,0:11:32.65,0:11:35.06,Default,,0,0,0,,Super Z ояту керек
Dialogue: 0,0:11:36.86,0:11:37.98,Default,,0,0,0,,Егер солай болса.
Dialogue: 0,0:11:38.11,0:11:42.99,Default,,0,0,0,,Менің ойымша, Super Z-Awaken қолданбай-ақ жеңіске жету жолын ойластырған дұрыс.
Dialogue: 0,0:11:44.99,0:11:46.83,Default,,0,0,0,,Басқа жолы?
Dialogue: 0,0:11:47.74,0:11:49.37,Default,,0,0,0,,Бұл әйелдің Қанды Пері Шығармасы ма?
Dialogue: 0,0:11:49.58,0:11:52.71,Default,,0,0,0,,(отшашулардың дыбысы)
Dialogue: 0,0:11:55.96,0:11:58.67,Default,,0,0,0,,Жарайды! Ұлдар мен қыздар!
Dialogue: 0,0:11:58.84,0:12:02.88,Default,,0,0,0,,Көптен күткен Neo Bay Arena аяқталды.
Dialogue: 0,0:12:03.01,0:12:04.72,Default,,0,0,0,,Құттықтаймыз!
Dialogue: 0,0:12:05.43,0:12:07.47,Default,,0,0,0,,Осы жерде, ақырында
Dialogue: 0,0:12:07.60,0:12:10.89,Default,,0,0,0,,Қызыл жүз Айга мен Жүректердің шайқасы басталады.
Dialogue: 0,0:12:11.02,0:12:13.77,Default,,0,0,0,,Бұл екеуі үшін де үшінші матч!
Dialogue: 0,0:12:13.89,0:12:15.73,Default,,0,0,0,,Сағынба!
Dialogue: 0,0:12:16.44,0:12:18.73,Default,,0,0,0,,Енді қызыл бұрыштан бастайық.
Dialogue: 0,0:12:18.86,0:12:24.99,Default,,0,0,0,,Ең күшті Super Zetsu, қызыл Super Zetsu баласы Айга Акбаши болуды мақсат етеді!
Dialogue: 0,0:12:25.11,0:12:26.57,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:12:26.70,0:12:28.99,Default,,0,0,0,,Айга~!
Dialogue: 0,0:12:32.71,0:12:34.54,Default,,0,0,0,,және көк бұрыш
Dialogue: 0,0:12:34.67,0:12:39.04,Default,,0,0,0,,Жер асты әлемінің жын-шайтан әміршісі, Жүрек, Demon Castle Өлі Граннан келеді!
Dialogue: 0,0:12:39.17,0:12:42.13,Default,,0,0,0,,Осы Необай Аренаға келу
Dialogue: 0,0:12:42.42,0:12:47.05,Default,,0,0,0,,Жүректер! Жүректер! Жүректер!
Dialogue: 0,0:12:47.39,0:12:49.72,Default,,0,0,0,,Сәлем! Теме және басқалары жеңіліп жатыр!
Dialogue: 0,0:12:50.39,0:12:52.06,Default,,0,0,0,,О... Эй!
Dialogue: 0,0:12:52.35,0:12:54.48,Default,,0,0,0,,Айга! Айга!
Dialogue: 0,0:12:54.85,0:12:56.73,Default,,0,0,0,,Айға! Айга!
Dialogue: 0,0:12:57.10,0:13:00.23,Default,,0,0,0,,Аудиториялар қазірдің өзінде қызып жатыр!
Dialogue: 0,0:13:00.61,0:13:03.32,Default,,0,0,0,,Бұдан былай бұл жер тозаққа айналады!
Dialogue: 0,0:13:03.61,0:13:06.24,Default,,0,0,0,,Тозаққа қош келдіңіз, Қызыл жүз Айга
Dialogue: 0,0:13:06.78,0:13:09.03,Default,,0,0,0,,Сіз бір нәрсені айта бересіз
Dialogue: 0,0:13:09.16,0:13:10.37,Default,,0,0,0,,Мен оны естуден шаршадым!
Dialogue: 0,0:13:13.75,0:13:14.96,Default,,0,0,0,,Айга…
Dialogue: 0,0:13:21.50,0:13:24.26,Default,,0,0,0,,Жаңа шығанақ алған сияқтысыз.
Dialogue: 0,0:13:24.67,0:13:27.51,Default,,0,0,0,,Ах, ең күшті шығанақ.
Dialogue: 0,0:13:27.89,0:13:29.64,Default,,0,0,0,,Осы супер Z Ахиллеспен
Dialogue: 0,0:13:29.76,0:13:31.06,Default,,0,0,0,,Мен сені үрлеймін дейсің бе... (Жүректер) Мені үрлейсің бе?
Dialogue: 0,0:13:31.18,0:13:32.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:32.35,0:13:35.10,Default,,0,0,0,,Мен сенің айтқаныңды білемін.
Dialogue: 0,0:13:35.48,0:13:37.23,Default,,0,0,0,,Мені көшірме!
Dialogue: 0,0:13:37.60,0:13:41.82,Default,,0,0,0,,Super Z-ояту жүйесі? Мен оны асыға күтемін.
Dialogue: 0,0:13:42.27,0:13:46.49,Default,,0,0,0,,Бірақ сіз шынымен Super Z-оятуға қол жеткізе аласыз ба?
Dialogue: 0,0:13:47.03,0:13:48.11,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:13:48.36,0:13:50.24,Default,,0,0,0,,Арандатушылықты пайдаланба!
Dialogue: 0,0:13:50.37,0:13:52.24,Default,,0,0,0,,Иә, шоғырлан!
Dialogue: 0,0:13:52.87,0:13:55.87,Default,,0,0,0,,Super Z ояту жүйесін жеңіңіз
Dialogue: 0,0:13:56.25,0:13:59.96,Default,,0,0,0,,Сіз мен үшін Super Z Valkyrie-ді жеңу үшін баспалдақсыз.
Dialogue: 0,0:14:00.38,0:14:03.75,Default,,0,0,0,,Барлығыңыз Super Z-Оянуды асыға күтесіз бе?
Dialogue: 0,0:14:03.88,0:14:06.26,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:14:06.76,0:14:08.05,Default,,0,0,0,,Осымен
Dialogue: 0,0:14:08.47,0:14:09.51,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:11.01,0:14:12.10,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:14:16.81,0:14:18.52,Default,,0,0,0,,Шабуыл режимі
Dialogue: 0,0:14:19.23,0:14:20.73,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:14:21.31,0:14:24.11,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:14:24.65,0:14:27.65,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:14:27.90,0:14:28.99,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:14:32.99,0:14:33.87,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:34.37,0:14:36.66,Default,,0,0,0,,Super Z-қанаты ашық емес!
Dialogue: 0,0:14:37.00,0:14:38.25,Default,,0,0,0,,Мен бәрі жақсы болатынына сенімдімін
Dialogue: 0,0:14:38.50,0:14:40.37,Default,,0,0,0,,Қай жерде жақсы?
Dialogue: 0,0:14:40.62,0:14:43.63,Default,,0,0,0,,Хехехе... Оны көргенде білесің.
Dialogue: 0,0:14:46.01,0:14:47.59,Default,,0,0,0,,Сіз құлықсызсыз ба?
Dialogue: 0,0:14:47.72,0:14:50.89,Default,,0,0,0,,Немесе Super Z-Awaken әлі мүмкін емес пе?
Dialogue: 0,0:14:51.18,0:14:52.01,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:52.39,0:14:55.89,Default,,0,0,0,,Super Z-Awaken жасай алмайтын сізбен күресудің қажеті жоқ.
Dialogue: 0,0:14:56.52,0:14:58.89,Default,,0,0,0,,Бұл қызықсыз шайқас болатын сияқты
Dialogue: 0,0:15:05.94,0:15:06.78,Default,,0,0,0,,Не!
Dialogue: 0,0:15:07.69,0:15:09.28,Default,,0,0,0,,Уау? Өлі Адес!
Dialogue: 0,0:15:09.65,0:15:13.28,Default,,0,0,0,,Өз салмағы жауға айналып, жабайы жүгіре бастады!
Dialogue: 0,0:15:13.66,0:15:15.78,Default,,0,0,0,,Мен ойлағандай болды!
Dialogue: 0,0:15:16.41,0:15:20.16,Default,,0,0,0,,Эй, Өлі Аидс ең ауыр, солай ма?
Dialogue: 0,0:15:20.54,0:15:23.79,Default,,0,0,0,,А, осы шығанақтың бір ерекшелігі.
Dialogue: 0,0:15:23.92,0:15:27.17,Default,,0,0,0,,Сонда мен бұл салмақты өз пайдам үшін пайдаланамын.
Dialogue: 0,0:15:27.30,0:15:28.67,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:15:29.05,0:15:30.42,Default,,0,0,0,,Ауыр деген нені білдіреді?
Dialogue: 0,0:15:30.55,0:15:33.68,Default,,0,0,0,,Қабырғаға соғылған кездегі соққы күшті болуы керек, солай ма?
Dialogue: 0,0:15:34.05,0:15:35.05,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:15:35.18,0:15:38.97,Default,,0,0,0,,Күшті әсер Хадестің тепе-теңдігін бұзуы мүмкін.
Dialogue: 0,0:15:39.93,0:15:40.81,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:15:41.19,0:15:43.31,Default,,0,0,0,,Айғаның стратегиясымен бірдей.
Dialogue: 0,0:15:46.57,0:15:48.82,Default,,0,0,0,,Өлі импульс!
Dialogue: 0,0:15:52.95,0:15:55.37,Default,,0,0,0,,Қазір! Ахиллес!
Dialogue: 0,0:15:56.49,0:15:58.95,Default,,0,0,0,,Super Z жоғарғы!
Dialogue: 0,0:16:00.37,0:16:01.87,Default,,0,0,0,,Міне!
Dialogue: 0,0:16:04.54,0:16:07.29,Default,,0,0,0,,Super Z Ахиллес аяқталды
Dialogue: 0,0:16:07.42,0:16:08.92,Default,,0,0,0,,1-0 ұпай!
Dialogue: 0,0:16:09.05,0:16:10.21,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:16:10.63,0:16:14.55,Default,,0,0,0,,Мен Super Z-Оянуға қол жеткізе алмаған кезде не болғанын ойлап жатқаныма сене алар емеспін.
Dialogue: 0,0:16:14.68,0:16:16.01,Default,,0,0,0,,Ол қызықсыз.
Dialogue: 0,0:16:16.26,0:16:17.35,Default,,0,0,0,,Не!
Dialogue: 0,0:16:17.72,0:16:21.02,Default,,0,0,0,,Барлығыңызда супер Z-оянған Ахиллес бар.
Dialogue: 0,0:16:21.14,0:16:24.10,Default,,0,0,0,,Мені жеңгеніңді көргім келеді!
Dialogue: 0,0:16:24.23,0:16:27.11,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:16:27.48,0:16:28.98,Default,,0,0,0,,Мен қателестім…
Dialogue: 0,0:16:29.11,0:16:32.36,Default,,0,0,0,,Жүр, мен және мына балалар көңіл көтерейік.
Dialogue: 0,0:16:32.90,0:16:33.95,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:16:35.53,0:16:37.24,Default,,0,0,0,,Бұл жақсы стратегия болды.
Dialogue: 0,0:16:37.83,0:16:41.45,Default,,0,0,0,,Бірақ бір қимыл ешқашан Жүректерге қарсы екі рет жұмыс істемейді.
Dialogue: 0,0:16:41.95,0:16:43.96,Default,,0,0,0,,Не істеу керек? Айга
Dialogue: 0,0:16:44.08,0:16:46.71,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:16:53.22,0:16:54.38,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:16:54.72,0:16:56.93,Default,,0,0,0,,Өлі өлілер аяқталды
Dialogue: 0,0:16:57.05,0:16:58.64,Default,,0,0,0,,1-ден 1-ге дейінгі тармақтар!
Dialogue: 0,0:16:59.01,0:17:01.39,Default,,0,0,0,,Қызыл жүз Айга ұсталды!
Dialogue: 0,0:17:01.52,0:17:03.64,Default,,0,0,0,,Екеуі де бір қадам артқа шегінбейтін шайқас!
Dialogue: 0,0:17:04.02,0:17:07.77,Default,,0,0,0,,Эй, эй, кел, Super Z оятуын шығар.
Dialogue: 0,0:17:08.27,0:17:09.27,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:09.90,0:17:14.03,Default,,0,0,0,,Бар күшіңмен келмесең, оны құртуға болады.
Dialogue: 0,0:17:14.19,0:17:15.03,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:17:15.15,0:17:16.91,Default,,0,0,0,,Айқын ғой, иә! Ақымақ!
Dialogue: 0,0:17:17.03,0:17:20.03,Default,,0,0,0,,Жүректер керемет қорқынышты арандатушылық жасады.
Dialogue: 0,0:17:20.41,0:17:24.41,Default,,0,0,0,,Бұл өтірік, солай ма? Сіз Ахилласты жоймас едіңіз, солай ма?
Dialogue: 0,0:17:24.54,0:17:26.42,Default,,0,0,0,,Жоқ, Жүрек ауыр.
Dialogue: 0,0:17:26.67,0:17:28.88,Default,,0,0,0,,Бұл жақсы емес...
Dialogue: 0,0:17:34.05,0:17:35.42,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:17:35.72,0:17:37.89,Default,,0,0,0,,Айга~!
Dialogue: 0,0:17:40.10,0:17:42.64,Default,,0,0,0,,Мен саған енді ешқашан мұндай сезімге жол бермеймін.
Dialogue: 0,0:17:43.60,0:17:44.64,Default,,0,0,0,,Үшінші шайқас
Dialogue: 0,0:17:48.44,0:17:49.27,Default,,0,0,0,,(Танжиро) Бірақ құбыжықтар жалғыз жүруі керек еді ғой?
Dialogue: 0,0:17:53.69,0:17:54.53,Default,,0,0,0,,Айга!
Dialogue: 0,0:17:55.11,0:17:56.03,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:58.11,0:17:59.41,Default,,0,0,0,,Ахиллес!
Dialogue: 0,0:18:01.28,0:18:03.58,Default,,0,0,0,,Маған қазір қолыңыздағының бәрін беріңіз
Dialogue: 0,0:18:04.62,0:18:06.96,Default,,0,0,0,,Мен саған сенемін
Dialogue: 0,0:18:12.38,0:18:14.51,Default,,0,0,0,,Түсіндім, досым.
Dialogue: 0,0:18:18.93,0:18:21.68,Default,,0,0,0,,Жақсы, жақсы, бұл көздер!
Dialogue: 0,0:18:22.05,0:18:24.18,Default,,0,0,0,,Көңілді болайық!
Dialogue: 0,0:18:24.56,0:18:26.14,Default,,0,0,0,,Ләззат аласың ба?
Dialogue: 0,0:18:26.77,0:18:29.69,Default,,0,0,0,,Занне~н! Бұл жерде!
Dialogue: 0,0:18:30.15,0:18:31.69,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:18:32.06,0:18:35.23,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:18:35.57,0:18:38.28,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:18:38.82,0:18:39.86,Default,,0,0,0,,Онда… жалаңаш қолмен шайқасайық.
Dialogue: 0,0:18:46.16,0:18:48.37,Default,,0,0,0,,Жақсы! Super Z-Wing шықты!
Dialogue: 0,0:18:48.62,0:18:51.13,Default,,0,0,0,,Хаха~! Келді, келді, келді!
Dialogue: 0,0:18:51.83,0:18:54.38,Default,,0,0,0,,Super Z-Ояну... Керемет, Айга!
Dialogue: 0,0:18:54.63,0:18:55.67,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:18:55.88,0:18:58.51,Default,,0,0,0,,Бұл Ахиллестің супер Z оянуы ма?
Dialogue: 0,0:18:59.38,0:19:00.63,Default,,0,0,0,,Күте тұр… Демек, мені соңында ұмытып қалдыңдар ма?
Dialogue: 0,0:19:04.60,0:19:05.56,Default,,0,0,0,,Ах... уф!
Dialogue: 0,0:19:10.06,0:19:10.89,Default,,0,0,0,,Гррр…
Dialogue: 0,0:19:11.19,0:19:13.81,Default,,0,0,0,,Хаха~! Жақсы, жақсы!
Dialogue: 0,0:19:17.07,0:19:20.20,Default,,0,0,0,,Super Z-оянған Ахиллес жарылып кетпейді!
Dialogue: 0,0:19:20.45,0:19:22.45,Default,,0,0,0,,Ал ше!
Dialogue: 0,0:19:23.03,0:19:25.16,Default,,0,0,0,,Қарқынды шабуыл!
Dialogue: 0,0:19:25.28,0:19:27.45,Default,,0,0,0,,Өлі өлілердің шабуылы!
Dialogue: 0,0:19:27.66,0:19:28.70,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:28.87,0:19:33.29,Default,,0,0,0,,Хя~хаха~!
Dialogue: 0,0:19:34.29,0:19:36.59,Default,,0,0,0,,Ажал!
Dialogue: 0,0:19:41.38,0:19:45.01,Default,,0,0,0,,Қарғыс атсын! Өлі гравитация!
Dialogue: 0,0:19:45.89,0:19:49.14,Default,,0,0,0,,Super Z Ахиллес өлі өлі өлкеге ​​жабылды!
Dialogue: 0,0:19:49.27,0:19:51.02,Default,,0,0,0,,Сіз қашып құтыла аласыз ба?
Dialogue: 0,0:19:51.64,0:19:55.15,Default,,0,0,0,,Уууу!
Dialogue: 0,0:19:55.40,0:19:57.52,Default,,0,0,0,,Ахиллес!
Dialogue: 0,0:19:59.23,0:20:01.40,Default,,0,0,0,,Ооо...
Dialogue: 0,0:20:01.61,0:20:02.61,Default,,0,0,0,,Әй!
Dialogue: 0,0:20:06.49,0:20:09.62,Default,,0,0,0,,Жасайық, досым!
Dialogue: 0,0:20:11.87,0:20:14.12,Default,,0,0,0,,Күн ыстық Айга
Dialogue: 0,0:20:14.46,0:20:17.67,Default,,0,0,0,,Super Z-қорғаныс!
Dialogue: 0,0:20:20.59,0:20:23.63,Default,,0,0,0,,Оме не істейтінін болжай аласыз!
Dialogue: 0,0:20:25.39,0:20:26.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:29.14,0:20:31.31,Default,,0,0,0,,Жүр!
Dialogue: 0,0:20:34.39,0:20:36.94,Default,,0,0,0,,Аһ!
Dialogue: 0,0:20:41.24,0:20:43.36,Default,,0,0,0,,Бұл Ахиллес екеуміз.
Dialogue: 0,0:20:45.36,0:20:48.28,Default,,0,0,0,,Super Zetsu!
Dialogue: 0,0:20:49.70,0:20:50.95,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:20:53.96,0:20:57.83,Default,,0,0,0,,Super Z Buster!
Dialogue: 0,0:21:00.92,0:21:03.17,Default,,0,0,0,,Уууу!
Dialogue: 0,0:21:03.30,0:21:05.43,Default,,0,0,0,,Ааааааа!
Dialogue: 0,0:21:12.64,0:21:14.94,Default,,0,0,0,,Губааа~!
Dialogue: 0,0:21:15.69,0:21:18.52,Default,,0,0,0,,Super Z Ахиллестің жарылуы
Dialogue: 0,0:21:18.65,0:21:21.94,Default,,0,0,0,,Red Blade Aiga 3-тен 1 ұпаймен жеңеді!
Dialogue: 0,0:21:22.07,0:21:25.90,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:21:26.03,0:21:28.41,Default,,0,0,0,,Тыныш!
Dialogue: 0,0:21:28.53,0:21:29.37,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:29.49,0:21:31.03,Default,,0,0,0,,Сіз мұны жасадыңыз!
Dialogue: 0,0:21:31.16,0:21:32.66,Default,,0,0,0,,Сіз мұны жасадыңыз!
Dialogue: 0,0:21:33.75,0:21:35.91,Default,,0,0,0,,Айга Ақыры қолыңнан келді.
Dialogue: 0,0:21:39.58,0:21:42.75,Default,,0,0,0,,Мен Айғамен шайқасқым келеді.
Dialogue: 0,0:21:46.68,0:21:49.55,Default,,0,0,0,,Сіз де, солай ма? ауа түні
Dialogue: 0,0:21:54.27,0:22:00.27,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:23:17.72,0:23:23.73,Default,,0,0,0,,~♪
Dialogue: 0,0:23:24.61,0:23:26.73,Default,,0,0,0,,Кит тамаша жігіт.
Dialogue: 0,0:23:26.86,0:23:31.45,Default,,0,0,0,,Мен де мен сияқты супер Цетсу, ең күшті және жеңілмейтін болуды мақсат етіп отырмын.
Dialogue: 0,0:23:31.57,0:23:35.53,Default,,0,0,0,,Бірақ Балтоға қарсы шығу үшін оны жеңуден басқа амалым жоқ.
Dialogue: 0,0:23:35.66,0:23:39.66,Default,,0,0,0,,Табысқа жетудің кілті - Ахиллес екеуміз қарым-қатынас жасай аламыз ба?
Dialogue: 0,0:23:40.33,0:23:42.62,Default,,0,0,0,,Келесі жолы «Beyblade Burst Super Zetsu»
Dialogue: 0,0:23:42.75,0:23:44.88,Default,,0,0,0,,«Жел рыцарь Әуе рыцарь!»
Dialogue: 0,0:23:45.00,0:23:46.67,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:46.80,0:23:48.55,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:50.05,0:23:56.05,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory