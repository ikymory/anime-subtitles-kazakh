Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.79,0:00:04.21,Default,,0,0,0,,Бейблейд
Dialogue: 0,0:00:04.33,0:00:08.13,Default,,0,0,0,,Мықты болуды мақсат еткен ұлдардың арманының жемісі.
Dialogue: 0,0:00:09.05,0:00:12.42,Default,,0,0,0,,Енді супер Цетсу дәуірі басталады.
Dialogue: 0,0:00:12.55,0:00:16.85,Default,,0,0,0,,Металл сауытыңызды киіңіз де, Беймен шытырман оқиғаға аттаныңыз!
Dialogue: 0,0:00:16.97,0:00:19.31,Default,,0,0,0,,Әлем чемпионы болуды мақсат етіңіз!
Dialogue: 0,0:00:19.43,0:00:23.64,Default,,0,0,0,,Super Zetsu Super Zetsu Super Zetsu!
Dialogue: 0,0:00:24.39,0:00:28.15,Default,,0,0,0,,Ең күшті және жеңілмейтін атағын алатын адам сенсің!
Dialogue: 0,0:00:31.57,0:00:32.99,Default,,0,0,0,,Ахиллес
Dialogue: 0,0:00:33.82,0:00:34.70,Default,,0,0,0,,Ах
Dialogue: 0,0:00:42.16,0:00:43.46,Default,,0,0,0,,Ахиллес
Dialogue: 0,0:00:43.58,0:00:44.50,Default,,0,0,0,,Әй?
Dialogue: 0,0:00:45.58,0:00:48.59,Default,,0,0,0,,Сіз төбелесіп жатырсыз
Dialogue: 0,0:00:51.71,0:00:54.01,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:00:54.13,0:00:55.34,Default,,0,0,0,,Мен шешемін!
Dialogue: 0,0:00:55.72,0:00:58.34,Default,,0,0,0,,Айғаның шоғырлануы қайта оралды.
Dialogue: 0,0:00:58.47,0:00:59.35,Default,,0,0,0,,Айға!
Dialogue: 0,0:00:59.89,0:01:00.72,Default,,0,0,0,,Хо…
Dialogue: 0,0:01:03.89,0:01:06.64,Default,,0,0,0,,Z Қорғаныс!
Dialogue: 0,0:01:11.90,0:01:14.78,Default,,0,0,0,,Қаттөбе! Рагнарук!
Dialogue: 0,0:01:24.75,0:01:29.25,Default,,0,0,0,,Z Buster!
Dialogue: 0,0:01:34.92,0:01:37.18,Default,,0,0,0,,Лонгинус кубогының 1/4 финалы
Dialogue: 0,0:01:37.72,0:01:40.55,Default,,0,0,0,,Мен Сочода жеңдім!
Dialogue: 0,0:01:40.68,0:01:41.72,Default,,0,0,0,,Айға
Dialogue: 0,0:01:42.22,0:01:43.10,Default,,0,0,0,,Сочо
Dialogue: 0,0:01:44.77,0:01:45.60,Default,,0,0,0,,Иә
Dialogue: 0,0:01:46.18,0:01:48.98,Default,,0,0,0,,Енді мен сенімен көбірек шайқасқым келеді.
Dialogue: 0,0:01:52.73,0:01:53.65,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:54.15,0:01:56.40,Default,,0,0,0,,Мен мұны кез келген уақытта жасаймын!
Dialogue: 0,0:01:57.61,0:02:03.62,Default,,0,0,0,,♪~
Dialogue: 0,0:03:20.11,0:03:26.12,Default,,0,0,0,,~♪
Dialogue: 0,0:03:27.41,0:03:29.62,Default,,0,0,0,,«Сатқындықтың қиян-кескі шайқасы»
Dialogue: 0,0:03:31.54,0:03:34.00,Default,,0,0,0,,Жарайды! Ұлдар мен қыздар!
Dialogue: 0,0:03:34.13,0:03:37.42,Default,,0,0,0,,Мониторға назар аударыңыз!
Dialogue: 0,0:03:37.55,0:03:42.05,Default,,0,0,0,,Енді Лонгинус кубогының жартылай финалдық жұптары
Dialogue: 0,0:03:42.18,0:03:45.43,Default,,0,0,0,,Шешетін кез келді!
Dialogue: 0,0:03:45.60,0:03:48.89,Default,,0,0,0,,Рулетка басталады!
Dialogue: 0,0:03:53.60,0:03:54.44,Default,,0,0,0,,Шешілді!
Dialogue: 0,0:03:54.56,0:03:56.94,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:03:57.44,0:03:58.27,Default,,0,0,0,,Иә, жарайды!
Dialogue: 0,0:03:58.52,0:03:59.78,Default,,0,0,0,,Суо?
Dialogue: 0,0:04:00.44,0:04:03.70,Default,,0,0,0,,Бірінші матч - Суми Фубуки мен Гошуин Суу
Dialogue: 0,0:04:03.82,0:04:07.78,Default,,0,0,0,,Біз сол Йонекома Гакуэн Бэй клубына жататын блейдерміз!
Dialogue: 0,0:04:08.16,0:04:09.24,Default,,0,0,0,,Капитанмен?
Dialogue: 0,0:04:09.37,0:04:10.41,Default,,0,0,0,,Суу-кун...
Dialogue: 0,0:04:11.54,0:04:15.54,Default,,0,0,0,,Ал екінші матч Оу Хоуи мен Акабане Айга арасында.
Dialogue: 0,0:04:15.67,0:04:16.63,Default,,0,0,0,,Не, мына екі адам
Dialogue: 0,0:04:16.75,0:04:19.42,Default,,0,0,0,,Олар қазір бір шатырда ұйықтап жатқан сияқты.
Dialogue: 0,0:04:19.96,0:04:21.80,Default,,0,0,0,,Айга~! (2 адам) О!
Dialogue: 0,0:04:22.30,0:04:24.30,Default,,0,0,0,,Мен сенімен күрескеніме қуаныштымын.
Dialogue: 0,0:04:24.68,0:04:26.68,Default,,0,0,0,,Бұл бақытты жүз бе?
Dialogue: 0,0:04:27.22,0:04:29.43,Default,,0,0,0,,Эй, мен сені үрлеймін!
Dialogue: 0,0:04:29.56,0:04:30.64,Default,,0,0,0,,Аха…
Dialogue: 0,0:04:30.93,0:04:31.77,Default,,0,0,0,,(Сора) Мен оны біршама болжаған едім, бірақ осыншалықты шектен тыс боларын ойламаппын.
Dialogue: 0,0:04:31.89,0:04:34.81,Default,,0,0,0,,Ең жақсы достар соқтығысатын жартылай финал
Dialogue: 0,0:04:34.94,0:04:37.61,Default,,0,0,0,,Барған сайын көңілім көтеріліп барады!
Dialogue: 0,0:04:38.36,0:04:39.94,Default,,0,0,0,,Суо
Dialogue: 0,0:04:40.86,0:04:41.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:41.82,0:04:43.57,Default,,0,0,0,,Жақсы жекпе-жек өткізейік
Dialogue: 0,0:04:43.70,0:04:44.86,Default,,0,0,0,,Керемет шайқас...
Dialogue: 0,0:04:45.45,0:04:47.99,Default,,0,0,0,,Хехе, жақсы шайқас деген не?
Dialogue: 0,0:04:48.12,0:04:51.33,Default,,0,0,0,,Бар күшіммен сенімен соқтығысқым келеді
Dialogue: 0,0:04:52.54,0:04:53.87,Default,,0,0,0,,Жеңуге ниетіңіз бар ма?
Dialogue: 0,0:04:54.00,0:04:55.67,Default,,0,0,0,,Менің жеңілетін ойым жоқ.
Dialogue: 0,0:04:56.08,0:04:59.59,Default,,0,0,0,,Менің сенімен бар күш-жігеріммен күресетін ойым жоқ.
Dialogue: 0,0:04:59.92,0:05:00.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:01.34,0:05:05.84,Default,,0,0,0,,Мен Луи-санмен шайқаста барымды саламын.
Dialogue: 0,0:05:05.97,0:05:08.80,Default,,0,0,0,,Сізбен алысқа барудың қажеті жоқ.
Dialogue: 0,0:05:09.18,0:05:10.01,Default,,0,0,0,,Не?
Dialogue: 0,0:05:10.43,0:05:12.77,Default,,0,0,0,,Менің сенен ұтылуым мүмкін емес
Dialogue: 0,0:05:12.89,0:05:14.60,Default,,0,0,0,,Суо, сен...
Dialogue: 0,0:05:15.14,0:05:17.73,Default,,0,0,0,,Мүмкін сіз әлі байқамаған боларсыз.
Dialogue: 0,0:05:17.85,0:05:18.81,Default,,0,0,0,,Фубуки
Dialogue: 0,0:05:18.94,0:05:21.23,Default,,0,0,0,,Сіз аяқтадыңыз
Dialogue: 0,0:05:21.36,0:05:22.57,Default,,0,0,0,,Не?
Dialogue: 0,0:05:23.78,0:05:26.15,Default,,0,0,0,,О? Олар не істеп жатыр?
Dialogue: 0,0:05:26.70,0:05:28.95,Default,,0,0,0,,Онда біртүрлі нәрсе бар ма?
Dialogue: 0,0:05:29.07,0:05:31.12,Default,,0,0,0,,Біз шайқас алдында бөлінеміз бе?
Dialogue: 0,0:05:31.49,0:05:34.75,Default,,0,0,0,,Айға Ақабадай бей өнерпаздан жеңілдім.
Dialogue: 0,0:05:34.87,0:05:36.08,Default,,0,0,0,,Бұл жақсы дәлел.
Dialogue: 0,0:05:36.21,0:05:37.67,Default,,0,0,0,,Мен әуесқоймын дейсіз бе?
Dialogue: 0,0:05:37.75,0:05:38.58,Default,,0,0,0,,Иә?Ах...
Dialogue: 0,0:05:38.96,0:05:41.09,Default,,0,0,0,,Конояро! Айтыңызшы!
Dialogue: 0,0:05:41.21,0:05:42.05,Default,,0,0,0,,Ой...
Dialogue: 0,0:05:42.17,0:05:44.92,Default,,0,0,0,,Сіз әуесқойсыз ба? анық
Dialogue: 0,0:05:45.05,0:05:47.51,Default,,0,0,0,,Сіздің шайқастарыңызда ақыл жоқ.
Dialogue: 0,0:05:47.84,0:05:48.84,Default,,0,0,0,,Адамның…
Dialogue: 0,0:05:48.97,0:05:49.97,Default,,0,0,0,,Тоқта, Айға!
Dialogue: 0,0:05:50.97,0:05:52.60,Default,,0,0,0,,Сіз кедергі жасамаңыз
Dialogue: 0,0:05:53.01,0:05:54.10,Default,,0,0,0,,Суоу
Dialogue: 0,0:05:54.22,0:05:56.93,Default,,0,0,0,,Сіз бұрын айтқан сөзіңізді айтқыңыз келді ме?
Dialogue: 0,0:05:57.64,0:05:58.48,Default,,0,0,0,,Иә
Dialogue: 0,0:06:01.27,0:06:02.19,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:06:07.03,0:06:09.66,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:06:13.66,0:06:16.12,Default,,0,0,0,,Менің сенен ұтылуым мүмкін емес
Dialogue: 0,0:06:17.08,0:06:18.16,Default,,0,0,0,,Фубуки
Dialogue: 0,0:06:18.29,0:06:20.37,Default,,0,0,0,,Сіз дайынсыз.
Dialogue: 0,0:06:20.50,0:06:21.79,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:06:23.17,0:06:25.59,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:06:36.97,0:06:40.98,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:06:42.19,0:06:43.23,Default,,0,0,0,,О~. Құдай-ай!
Dialogue: 0,0:06:45.11,0:06:46.23,Default,,0,0,0,,♬~
Dialogue: 0,0:06:48.36,0:06:53.49,Default,,0,0,0,,Командалық жарыстың жеңімпазы Йонекома Гакуэн Бэй клубы болды!
Dialogue: 0,0:06:53.78,0:06:56.62,Default,,0,0,0,,Суми Фубуки мен Гошуин Суу алтын комбинациясы
Dialogue: 0,0:06:56.74,0:06:59.50,Default,,0,0,0,,Клубты керемет түрде жеңіске жеткізді!
Dialogue: 0,0:07:04.13,0:07:05.00,Default,,0,0,0,,Суоу…
Dialogue: 0,0:07:28.65,0:07:29.53,Default,,0,0,0,,Хехе
Dialogue: 0,0:07:32.99,0:07:34.87,Default,,0,0,0,,Буси!
Dialogue: 0,0:07:38.95,0:07:41.96,Default,,0,0,0,,(оятар қоңырауы)
Dialogue: 0,0:07:44.58,0:07:47.00,Default,,0,0,0,,(Дарио) Бала ма!? Қоя бер!
Dialogue: 0,0:07:47.42,0:07:49.26,Default,,0,0,0,,Хуа~!
Dialogue: 0,0:07:49.59,0:07:50.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:51.80,0:07:54.80,Default,,0,0,0,,
Dialogue: 0,0:07:57.72,0:07:58.93,Default,,0,0,0,,♬~
Dialogue: 0,0:07:59.06,0:08:01.73,Default,,0,0,0,,Әй, сен неге менің шатырымдасың?
Dialogue: 0,0:08:01.85,0:08:04.19,Default,,0,0,0,,Иә? О, таң...
Dialogue: 0,0:08:04.31,0:08:06.02,Default,,0,0,0,,Бұл «таң» емес!
Dialogue: 0,0:08:07.15,0:08:10.15,Default,,0,0,0,,(Рантароның гуілдеуі)
Dialogue: 0,0:08:10.65,0:08:13.74,Default,,0,0,0,,Жарайды, солай ғой, иә?
Dialogue: 0,0:08:14.95,0:08:17.07,Default,,0,0,0,,Әлі де ілулі тұр ма?
Dialogue: 0,0:08:17.20,0:08:18.62,Default,,0,0,0,,Не? Шынымен бе?
Dialogue: 0,0:08:18.74,0:08:20.83,Default,,0,0,0,,Ұйқы әдеті қорқынышты.
Dialogue: 0,0:08:20.95,0:08:23.41,Default,,0,0,0,,Жоқ! сен неге шатырдасың
Dialogue: 0,0:08:23.54,0:08:24.83,Default,,0,0,0,,(араластырғыш дыбысы)
Dialogue: 0,0:08:24.96,0:08:25.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:28.13,0:08:31.55,Default,,0,0,0,,Спортшы күткендей, бұл сау емес пе?
Dialogue: 0,0:08:31.67,0:08:32.80,Default,,0,0,0,,Сіз де ішкіңіз келе ме?
Dialogue: 0,0:08:32.92,0:08:34.68,Default,,0,0,0,,Шынайы ма? Іш, іш!
Dialogue: 0,0:08:34.80,0:08:36.09,Default,,0,0,0,,Бұрынғы жауап!
Dialogue: 0,0:08:36.43,0:08:38.68,Default,,0,0,0,,Хоуи Мен үлкен бөлікке тапсырыс беремін.
Dialogue: 0,0:08:38.80,0:08:39.93,Default,,0,0,0,,Ал біз осыншама көп адамды әкелуге сонша күш жұмсадық деп ойласаңшы.➡
Dialogue: 0,0:08:40.77,0:08:44.31,Default,,0,0,0,,Мен көп нәрсе жасадым, сондықтан сіз қалағаныңызша аласыз.
Dialogue: 0,0:08:44.44,0:08:45.94,Default,,0,0,0,,Иә! (Рантаро) О, рахмет
Dialogue: 0,0:08:47.77,0:08:49.19,Default,,0,0,0,,Мен гочи боламын!
Dialogue: 0,0:08:49.32,0:08:51.36,Default,,0,0,0,,Алайық! Мен аламын
Dialogue: 0,0:08:55.61,0:08:56.61,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:00.03,0:09:01.24,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:05.71,0:09:07.46,Default,,0,0,0,,Толық тамақтану!
Dialogue: 0,0:09:08.33,0:09:11.17,Default,,0,0,0,,(шайлау дыбысы)
Dialogue: 0,0:09:11.84,0:09:12.67,Default,,0,0,0,,(Порнарефф) Не дедің!? Жынды! Аузыңды жап!
Dialogue: 0,0:09:13.34,0:09:14.55,Default,,0,0,0,,Пуха~
Dialogue: 0,0:09:14.67,0:09:16.51,Default,,0,0,0,,Мен өлемін деп ойладым.
Dialogue: 0,0:09:16.63,0:09:18.51,Default,,0,0,0,,Мен мұндай нәрсені іше аламын.
Dialogue: 0,0:09:18.97,0:09:19.80,Default,,0,0,0,,Әй?
Dialogue: 0,0:09:19.93,0:09:22.52,Default,,0,0,0,,Сонымен! Сочо неге мұнда?
Dialogue: 0,0:09:22.89,0:09:25.60,Default,,0,0,0,,Мен де шатырда ұйықтаймын.
Dialogue: 0,0:09:25.73,0:09:26.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:26.85,0:09:28.02,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:09:28.15,0:09:29.52,Default,,0,0,0,,(Норияки) Онда Үндістанмен қоштасу уақыты келді
Dialogue: 0,0:09:29.65,0:09:31.48,Default,,0,0,0,,Себебі бұл қызықты көрінеді.
Dialogue: 0,0:09:31.61,0:09:32.53,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:09:32.65,0:09:34.15,Default,,0,0,0,,Қалжыңдамаңыз!
Dialogue: 0,0:09:34.86,0:09:37.66,Default,,0,0,0,,Бұл әлдеқайда жанды болады. (2 адам) Уф~
Dialogue: 0,0:09:38.86,0:09:39.87,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,0:09:47.29,0:09:48.75,Default,,0,0,0,,А? Қазіргі дыбыс...
Dialogue: 0,0:09:48.87,0:09:49.79,Default,,0,0,0,,шығанақ?
Dialogue: 0,0:09:53.42,0:09:56.55,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:09:57.26,0:09:59.26,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:10:02.10,0:10:03.22,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:10:03.64,0:10:04.47,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:10:05.02,0:10:05.85,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:10:11.56,0:10:13.90,Default,,0,0,0,,Әлгі жігіт, шын айтасың ба?
Dialogue: 0,0:10:14.03,0:10:16.28,Default,,0,0,0,,Сіз жақсы соққы жасайсыз, солай емес пе?
Dialogue: 0,0:10:16.40,0:10:17.24,Default,,0,0,0,,Әрине
Dialogue: 0,0:10:17.65,0:10:19.49,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:10:19.91,0:10:22.49,Default,,0,0,0,,Куу~! Менің көңіл-күйім жақсы.
Dialogue: 0,0:10:23.20,0:10:25.12,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:10:26.41,0:10:28.46,Default,,0,0,0,,Судың тозағы Саламандар
Dialogue: 0,0:10:29.00,0:10:31.25,Default,,0,0,0,,Сағат тіліне қарсы айналумен теңдестірілген түрі
Dialogue: 0,0:10:32.17,0:10:34.59,Default,,0,0,0,,Менің көргенім қорғаныс режимі болды
Dialogue: 0,0:10:35.34,0:10:38.38,Default,,0,0,0,,Алайда, оны бақылаудан шығаруға батылдықпен,
Dialogue: 0,0:10:38.97,0:10:41.68,Default,,0,0,0,,Ортасын ұстап тұрған үшбұрышты жоғары аударыңыз
Dialogue: 0,0:10:41.80,0:10:43.26,Default,,0,0,0,,Жарылыс
Dialogue: 0,0:10:43.72,0:10:45.31,Default,,0,0,0,,Бұл керемет техника.
Dialogue: 0,0:10:46.72,0:10:50.69,Default,,0,0,0,,Жеңіске жетудің жалғыз жолы - жаттығу.
Dialogue: 0,0:10:50.85,0:10:53.40,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:10:55.90,0:10:58.11,Default,,0,0,0,,Қарғыс атсын... жоқ.
Dialogue: 0,0:10:59.07,0:11:01.41,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:11:02.70,0:11:05.87,Default,,0,0,0,,Көбірек, күштірек
Dialogue: 0,0:11:06.49,0:11:07.75,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:11:12.54,0:11:13.75,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:11:14.92,0:11:17.80,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:11:18.51,0:11:21.59,Default,,0,0,0,,Бұл жігіт керемет!
Dialogue: 0,0:11:21.72,0:11:23.97,Default,,0,0,0,,Теме де...
Dialogue: 0,0:11:24.10,0:11:24.93,Default,,0,0,0,,Әй?
Dialogue: 0,0:11:25.39,0:11:26.22,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:11:26.35,0:11:28.06,Default,,0,0,0,,(Стадионның көтерілу дыбысы)
Dialogue: 0,0:11:28.18,0:11:29.06,Default,,0,0,0,,Әй?
Dialogue: 0,0:11:32.06,0:11:34.94,Default,,0,0,0,,Хехе, осы стадионды пайдалануға рұқсат етіңіз.
Dialogue: 0,0:11:35.23,0:11:36.61,Default,,0,0,0,,Қалағаныңды істе
Dialogue: 0,0:11:39.94,0:11:42.70,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:11:43.20,0:11:45.32,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:11:45.66,0:11:46.58,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:11:49.04,0:11:50.83,Default,,0,0,0,,Маған да рұқсат етіңіз!
Dialogue: 0,0:11:50.96,0:11:52.21,Default,,0,0,0,,Мен де жасаймын!
Dialogue: 0,0:11:52.67,0:11:54.71,Default,,0,0,0,,Маған бұл ұнайды.
Dialogue: 0,0:11:57.75,0:12:00.71,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:12:01.26,0:12:03.47,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:12:08.85,0:12:11.02,Default,,0,0,0,,Жарайсыңдар ұлдар мен қыздар!
Dialogue: 0,0:12:11.31,0:12:13.52,Default,,0,0,0,,Эй, эй!
Dialogue: 0,0:12:13.64,0:12:16.48,Default,,0,0,0,,Лонгинус кубогының жартылай финалына көшейік!
Dialogue: 0,0:12:16.61,0:12:18.82,Default,,0,0,0,,Барлығы дайынсың ба?
Dialogue: 0,0:12:18.94,0:12:19.78,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:19.94,0:12:23.53,Default,,0,0,0,,Жарайды, келіңдер, Суми Фубуки мен Гошуин Суу
Dialogue: 0,0:12:23.65,0:12:26.07,Default,,0,0,0,,Йонекома Гакуэнді бір кездері алтын дуэт деп атаған.
Dialogue: 0,0:12:26.20,0:12:27.28,Default,,0,0,0,,Бұл екі адам
Dialogue: 0,0:12:27.41,0:12:30.79,Default,,0,0,0,,Бэй Аренада үлкен қақтығыс аяқталды!
Dialogue: 0,0:12:32.46,0:12:37.96,Default,,0,0,0,,Бұл өте қызықты шайқас болатыны сөзсіз!
Dialogue: 0,0:12:38.54,0:12:42.13,Default,,0,0,0,,Фубуки мен Сууға біраз қиналған сияқты.
Dialogue: 0,0:12:42.26,0:12:44.84,Default,,0,0,0,,Олар Bay Club-тың алтын дуэті емес пе?
Dialogue: 0,0:12:45.38,0:12:48.39,Default,,0,0,0,,Күшті типтегі Фубуки және данышпан типті Суу
Dialogue: 0,0:12:48.72,0:12:50.72,Default,,0,0,0,,Менің ойымша, екеуміз де келістік...
Dialogue: 0,0:12:51.14,0:12:53.23,Default,,0,0,0,,Неге ұрысып жатырсың?
Dialogue: 0,0:12:53.35,0:12:55.02,Default,,0,0,0,,Сочо Сіз білесіз бе?
Dialogue: 0,0:12:55.60,0:12:57.10,Default,,0,0,0,,Мен білемін бе?
Dialogue: 0,0:12:57.77,0:13:02.11,Default,,0,0,0,,Төбелестің себебі - қайсысы күшті, олай емес!
Dialogue: 0,0:13:05.91,0:13:07.03,Default,,0,0,0,,Суу
Dialogue: 0,0:13:07.16,0:13:10.37,Default,,0,0,0,,Сіздер менің осы уақытқа дейін бірге соғысқан жолдастарымсыздар.
Dialogue: 0,0:13:10.99,0:13:13.83,Default,,0,0,0,,Бірақ бүгін мен сені жеңемін.
Dialogue: 0,0:13:14.75,0:13:18.88,Default,,0,0,0,,Мен сені мен екеуміздің арасындағы айырмашылықты анық түсіндіріп беремін.
Dialogue: 0,0:13:19.38,0:13:22.17,Default,,0,0,0,,Келіңіздер! Жартылай финалдың бірінші ойыны
Dialogue: 0,0:13:22.30,0:13:23.88,Default,,0,0,0,,Blader-пен таныстыру!
Dialogue: 0,0:13:24.34,0:13:25.80,Default,,0,0,0,,Көк бұрыш
Dialogue: 0,0:13:25.93,0:13:29.30,Default,,0,0,0,,Гүл композициясы әлемінде әйгілі иемото!
Dialogue: 0,0:13:29.43,0:13:31.97,Default,,0,0,0,,Екі беті бар керемет жүзік.
Dialogue: 0,0:13:32.10,0:13:33.60,Default,,0,0,0,,Гошуин Суоу
Dialogue: 0,0:13:33.72,0:13:35.89,Default,,0,0,0,,Бей - тозақтық саламандр
Dialogue: 0,0:13:36.02,0:13:37.14,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:13:37.48,0:13:38.85,Default,,0,0,0,,Қызыл бұрыш
Dialogue: 0,0:13:38.98,0:13:41.44,Default,,0,0,0,,Күшті Йонекома академиясының капитаны
Dialogue: 0,0:13:41.57,0:13:42.86,Default,,0,0,0,,Ақыл-парасат
Dialogue: 0,0:13:42.98,0:13:44.65,Default,,0,0,0,,Суми Фубуки
Dialogue: 0,0:13:44.78,0:13:47.15,Default,,0,0,0,,Бей император Форнеус
Dialogue: 0,0:13:47.28,0:13:49.28,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:13:54.62,0:13:57.46,Default,,0,0,0,,Батырлар курсы: Дэнки Камина!
Dialogue: 0,0:13:58.33,0:13:59.92,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:14:01.84,0:14:04.80,Default,,0,0,0,,Фубуки, мен саған түсіндіремін.
Dialogue: 0,0:14:04.92,0:14:08.01,Default,,0,0,0,,Нағыз данышпан кім?
Dialogue: 0,0:14:08.88,0:14:11.39,Default,,0,0,0,,Мен басқаларға қарағанда көбірек жаттығамын.
Dialogue: 0,0:14:11.51,0:14:15.10,Default,,0,0,0,,Мұны ең жақсы білетін сіз болуыңыз керек.
Dialogue: 0,0:14:16.98,0:14:19.19,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:14:20.35,0:14:21.19,Default,,0,0,0,,(Шығанақтың соғу дыбысы)
Dialogue: 0,0:14:21.98,0:14:22.98,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:23.94,0:14:25.19,Default,,0,0,0,,Білемін, білемін!
Dialogue: 0,0:14:25.69,0:14:28.57,Default,,0,0,0,,Неліктен жақсы емес?
Dialogue: 0,0:14:28.86,0:14:31.12,Default,,0,0,0,,Менің сол қолым бұлыңғыр.
Dialogue: 0,0:14:33.49,0:14:34.33,Default,,0,0,0,,Хехе
Dialogue: 0,0:14:35.37,0:14:37.79,Default,,0,0,0,,Қолыңызды ұшыру құралын тұрақты ұстасаңыз
Dialogue: 0,0:14:37.91,0:14:39.96,Default,,0,0,0,,Шығанақтың траекториясы анықталды
Dialogue: 0,0:14:42.96,0:14:44.09,Default,,0,0,0,,Тек қарап тұр.
Dialogue: 0,0:14:44.55,0:14:46.21,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:14:49.38,0:14:51.22,Default,,0,0,0,,Дұрыс па? таңқаларлық!
Dialogue: 0,0:14:51.47,0:14:53.47,Default,,0,0,0,,Ей, бірге жаттығу жасайық!
Dialogue: 0,0:14:54.01,0:14:55.47,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:14:56.14,0:14:56.97,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:00.35,0:15:01.19,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:15:02.35,0:15:03.98,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:15:04.36,0:15:07.36,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:15:07.86,0:15:10.15,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:15:10.49,0:15:11.32,Default,,0,0,0,,Әй!
Dialogue: 0,0:15:11.66,0:15:13.28,Default,,0,0,0,,Шайқас басталады!
Dialogue: 0,0:15:13.41,0:15:16.62,Default,,0,0,0,,Тозақ Саламандрдың солға айналатын қорғаныс режимі бар.
Dialogue: 0,0:15:16.74,0:15:18.45,Default,,0,0,0,,Бұл мүлдем бақылаудан шықты!
Dialogue: 0,0:15:18.58,0:15:21.25,Default,,0,0,0,,Форнеус орталықты бірінші алады
Dialogue: 0,0:15:21.58,0:15:22.42,Default,,0,0,0,,Жарайды
Dialogue: 0,0:15:22.96,0:15:24.84,Default,,0,0,0,,Ах! Түсірілім қателігі болды ма?
Dialogue: 0,0:15:24.96,0:15:26.09,Default,,0,0,0,,Гошуин Суоу
Dialogue: 0,0:15:26.21,0:15:27.05,Default,,0,0,0,,Иә
Dialogue: 0,0:15:27.50,0:15:28.80,Default,,0,0,0,,Әлгі Су-кун?
Dialogue: 0,0:15:28.92,0:15:30.30,Default,,0,0,0,,Жарайды, мен кете аламын!
Dialogue: 0,0:15:30.76,0:15:34.05,Default,,0,0,0,,Жоқ, бұл сіз менімен шайқасқан кездегідей.
Dialogue: 0,0:15:36.93,0:15:39.98,Default,,0,0,0,,Өрт құйын Гекирин!
Dialogue: 0,0:15:44.86,0:15:46.86,Default,,0,0,0,,Мен сол техниканы қолданатын боламын.
Dialogue: 0,0:15:47.15,0:15:48.36,Default,,0,0,0,,Денсаулық саламандра
Dialogue: 0,0:15:48.48,0:15:50.74,Default,,0,0,0,,Сіз қабырғаға қайта-қайта соғыласыз ба? Ой!
Dialogue: 0,0:15:51.28,0:15:53.57,Default,,0,0,0,,Өрт құйын Гекирин!
Dialogue: 0,0:15:56.62,0:15:58.70,Default,,0,0,0,,Император гвардиясы!
Dialogue: 0,0:16:04.58,0:16:05.67,Default,,0,0,0,,А! Хм?
Dialogue: 0,0:16:06.04,0:16:07.04,Default,,0,0,0,,Капитан!
Dialogue: 0,0:16:07.17,0:16:08.25,Default,,0,0,0,,Фубуки-сенпай
Dialogue: 0,0:16:12.55,0:16:15.47,Default,,0,0,0,,Император Форнеус аяқталды!
Dialogue: 0,0:16:15.76,0:16:17.64,Default,,0,0,0,,1-ден 0-ге дейінгі нүктелер!
Dialogue: 0,0:16:17.76,0:16:19.14,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:16:19.26,0:16:22.43,Default,,0,0,0,,Тозақ Саламандрдың ерекше қозғалысына қарсы тұру
Dialogue: 0,0:16:22.56,0:16:26.56,Default,,0,0,0,,Тірі қалған император Форней болды!
Dialogue: 0,0:16:27.94,0:16:30.11,Default,,0,0,0,,Керемет! (Хикару) Жарайды, мен қолымнан келгеннің бәрін жасадым!
Dialogue: 0,0:16:30.61,0:16:32.86,Default,,0,0,0,,Бұл жігіт шынымен де күшті!
Dialogue: 0,0:16:33.20,0:16:34.41,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:34.95,0:16:36.87,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:16:37.16,0:16:37.99,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:16:38.20,0:16:39.49,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:16:40.83,0:16:41.75,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:16:41.87,0:16:44.54,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:16:45.25,0:16:47.75,Default,,0,0,0,,Ол қайтадан күшейіп келеді.
Dialogue: 0,0:16:47.88,0:16:50.38,Default,,0,0,0,,Онымен тағы шайқас!
Dialogue: 0,0:16:51.63,0:16:52.46,Default,,0,0,0,,Суу
Dialogue: 0,0:16:52.76,0:16:54.38,Default,,0,0,0,,Бұл енді менмін!
Dialogue: 0,0:16:54.72,0:16:57.18,Default,,0,0,0,,Кішкене есейген сияқты
Dialogue: 0,0:16:57.30,0:17:00.39,Default,,0,0,0,,Күткендей, ол еңбекқор данышпан дейді.
Dialogue: 0,0:17:01.27,0:17:02.18,Default,,0,0,0,,Хехе
Dialogue: 0,0:17:02.31,0:17:04.39,Default,,0,0,0,,Сіз әрқашан солай болдыңыз.
Dialogue: 0,0:17:05.56,0:17:06.73,Default,,0,0,0,,Сәлем Суо
Dialogue: 0,0:17:06.85,0:17:09.31,Default,,0,0,0,,Фубуки жігіті соңғы кездері таң қалдырды.
Dialogue: 0,0:17:09.44,0:17:10.40,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:17:11.07,0:17:14.40,Default,,0,0,0,,Оның тәжірибелік әдістері өз жемісін беруде.
Dialogue: 0,0:17:14.78,0:17:18.28,Default,,0,0,0,,Ол сенің ату қабілетіңнен асып түскенін айтты.
Dialogue: 0,0:17:18.95,0:17:19.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:20.41,0:17:23.29,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:17:23.41,0:17:25.79,Default,,0,0,0,,Жақсы! Жарайды, мен қазір солай сезінемін.
Dialogue: 0,0:17:26.42,0:17:27.42,Default,,0,0,0,,Тағы да!
Dialogue: 0,0:17:28.42,0:17:30.50,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:17:31.21,0:17:33.09,Default,,0,0,0,,Суми Фубуки
Dialogue: 0,0:17:33.21,0:17:36.63,Default,,0,0,0,,Мен сіздің күш-жігеріңізден қауіп төнгенін сезіндім.
Dialogue: 0,0:17:37.80,0:17:38.64,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:17:39.47,0:17:41.64,Default,,0,0,0,,Осы денсаулық саламандрын алғаннан кейін,
Dialogue: 0,0:17:41.76,0:17:44.27,Default,,0,0,0,,Сол сезім жоғалып кетті
Dialogue: 0,0:17:45.98,0:17:49.31,Default,,0,0,0,,Тек күш-жігермен жеңе алмайтын кейбір қарсыластар бар екенін есте сақтаңыз.
Dialogue: 0,0:17:49.44,0:17:50.90,Default,,0,0,0,,Мен сізге айтайын
Dialogue: 0,0:17:51.77,0:17:54.36,Default,,0,0,0,,Нағыз данышпан мынау...
Dialogue: 0,0:17:54.49,0:17:56.40,Default,,0,0,0,,Гошуин Суоу
Dialogue: 0,0:17:57.86,0:18:00.74,Default,,0,0,0,,Мен сені тозаққа тамақтандырамын.
Dialogue: 0,0:18:01.53,0:18:02.79,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:18:03.54,0:18:07.25,Default,,0,0,0,,Ешбір ізі жоқ гошуин мөрі Суо қай режимде келеді?
Dialogue: 0,0:18:09.08,0:18:11.17,Default,,0,0,0,,Мен оны дұрыстап аяқтаймын.
Dialogue: 0,0:18:12.04,0:18:13.38,Default,,0,0,0,,Шабуыл режимі
Dialogue: 0,0:18:13.75,0:18:17.38,Default,,0,0,0,,Суоу жігіт, сен қандай шабуыл жасауды жоспарлап отырсың?
Dialogue: 0,0:18:17.72,0:18:19.38,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:18:20.09,0:18:22.97,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:18:23.47,0:18:25.60,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:18:25.93,0:18:26.77,Default,,0,0,0,,Аһ!
Dialogue: 0,0:18:27.23,0:18:30.19,Default,,0,0,0,,Жабайы секіретін саламандр!
Dialogue: 0,0:18:32.06,0:18:34.11,Default,,0,0,0,,Форнеусты қатты сынға алды!
Dialogue: 0,0:18:34.65,0:18:35.98,Default,,0,0,0,,Сол қозғалыста
Dialogue: 0,0:18:36.11,0:18:38.61,Default,,0,0,0,,Шыдамыңыз таусылғанша уақыт мәселесі
Dialogue: 0,0:18:41.91,0:18:44.49,Default,,0,0,0,,Жалтарыңыз! Форнеус!
Dialogue: 0,0:18:44.91,0:18:47.70,Default,,0,0,0,,А, бірақ саламандрдың шабуылы тимейді!
Dialogue: 0,0:18:48.37,0:18:50.29,Default,,0,0,0,,Бұл шайқас тақтасы
Dialogue: 0,0:18:50.42,0:18:51.83,Default,,0,0,0,,Жақсы
Dialogue: 0,0:18:51.96,0:18:54.84,Default,,0,0,0,,Саламандрдың шыдамы таусылатын кез келді ме?
Dialogue: 0,0:18:55.46,0:18:56.46,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:19:00.47,0:19:03.14,Default,,0,0,0,,Әлгі Суу жігіті бірдеңені көздеп отыр.
Dialogue: 0,0:19:03.26,0:19:04.10,Default,,0,0,0,,О
Dialogue: 0,0:19:06.27,0:19:07.60,Default,,0,0,0,,Жүр! Саламандр!
Dialogue: 0,0:19:08.60,0:19:10.98,Default,,0,0,0,,Екі шығанақ соқтығысады!
Dialogue: 0,0:19:12.15,0:19:14.65,Default,,0,0,0,,Уф~ Форнеус!
Dialogue: 0,0:19:21.36,0:19:23.66,Default,,0,0,0,,Император Дрейф!
Dialogue: 0,0:19:29.04,0:19:29.96,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:19:30.08,0:19:30.91,Default,,0,0,0,,Не?
Dialogue: 0,0:19:33.71,0:19:35.79,Default,,0,0,0,,Не болды? Фубуки
Dialogue: 0,0:19:36.09,0:19:37.55,Default,,0,0,0,,Уау! саламандр
Dialogue: 0,0:19:37.67,0:19:39.42,Default,,0,0,0,,Императордың дрейфіне төтеп берді!
Dialogue: 0,0:19:40.05,0:19:41.93,Default,,0,0,0,,Саламандр Өртеп жібер!
Dialogue: 0,0:19:44.60,0:19:45.43,Default,,0,0,0,,Жарайды, барлығыңыз, ережелерді түсіндірейін
Dialogue: 0,0:19:45.68,0:19:49.18,Default,,0,0,0,,Саламандердің секіріп шабуылы!
Dialogue: 0,0:19:50.81,0:19:52.81,Default,,0,0,0,,Шыда! Форнеус!
Dialogue: 0,0:19:54.73,0:19:56.32,Default,,0,0,0,,Соңы
Dialogue: 0,0:19:58.98,0:20:00.78,Default,,0,0,0,,Саламандр!
Dialogue: 0,0:20:11.46,0:20:15.04,Default,,0,0,0,,Кенран тозақтан құлады!
Dialogue: 0,0:20:20.42,0:20:21.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:22.42,0:20:25.01,Default,,0,0,0,,Денсаулық Саламандр жарылысының аяқталуы
Dialogue: 0,0:20:25.30,0:20:29.31,Default,,0,0,0,,Жеңімпаз Гошуин Суо 2-ден 1 ұпайға дейін
Dialogue: 0,0:20:29.43,0:20:34.02,Default,,0,0,0,,Тозақ Саламандр керемет күш көрсетті!
Dialogue: 0,0:20:34.31,0:20:38.02,Default,,0,0,0,,Әлгі жігіт Фубукиді тамаша жеңді.
Dialogue: 0,0:20:38.52,0:20:40.98,Default,,0,0,0,,Фубуки-сенпай жеңілді.
Dialogue: 0,0:20:41.11,0:20:42.49,Default,,0,0,0,,Капитан…
Dialogue: 0,0:20:46.95,0:20:49.03,Default,,0,0,0,,Мен айтқандай болды.
Dialogue: 0,0:20:49.91,0:20:51.12,Default,,0,0,0,,Осы шайқаста
Dialogue: 0,0:20:51.25,0:20:54.04,Default,,0,0,0,,Мен сенен ештеңе алған жоқпын.
Dialogue: 0,0:20:54.29,0:20:55.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:55.71,0:20:59.29,Default,,0,0,0,,Гүлің солып қалды.
Dialogue: 0,0:21:11.97,0:21:15.06,Default,,0,0,0,,Суоу! Жанып жатыр!
Dialogue: 0,0:21:16.19,0:21:17.02,Default,,0,0,0,,…Тоқта, қайда барасың, Зура?
Dialogue: 0,0:21:17.48,0:21:20.02,Default,,0,0,0,,♬~
Dialogue: 0,0:21:20.73,0:21:24.15,Default,,0,0,0,,Енді Гошуин Суудың финалдағы орны анықталды.
Dialogue: 0,0:21:24.53,0:21:27.53,Default,,0,0,0,,Бір ғана билет қалды!
Dialogue: 0,0:21:28.37,0:21:30.87,Default,,0,0,0,,Қайсысы келсе де бірдей
Dialogue: 0,0:21:30.99,0:21:34.12,Default,,0,0,0,,Мен саған бұдан да әдемі шайқас беремін.
Dialogue: 0,0:21:34.45,0:21:35.58,Default,,0,0,0,,Хехехе
Dialogue: 0,0:21:38.17,0:21:40.42,Default,,0,0,0,,Мен оны жеңемін.
Dialogue: 0,0:21:40.54,0:21:44.42,Default,,0,0,0,,Оған дейін, Айға, мен сені жеңемін.
Dialogue: 0,0:21:44.67,0:21:47.97,Default,,0,0,0,,Әрине, мен де Омені ұшырып жіберемін!
Dialogue: 0,0:21:54.60,0:22:00.61,Default,,0,0,0,,♪~
Dialogue: 0,0:23:16.60,0:23:22.60,Default,,0,0,0,,~♪
Dialogue: 0,0:23:25.27,0:23:27.32,Default,,0,0,0,,Лонгинус кубогының жартылай финалы
Dialogue: 0,0:23:27.44,0:23:29.90,Default,,0,0,0,,Менің қарсыласым – Оу Хоуи
Dialogue: 0,0:23:30.03,0:23:33.24,Default,,0,0,0,,Оның шоғырлануы мен күші таң қалдырады.
Dialogue: 0,0:23:33.53,0:23:36.08,Default,,0,0,0,,Жарайды! Мен сені жою үшін барымды саламын!
Dialogue: 0,0:23:36.20,0:23:39.20,Default,,0,0,0,,Концентрациялық концентрат!
Dialogue: 0,0:23:39.70,0:23:41.71,Default,,0,0,0,,Келесі жолы «Beyblade Burst Super Zetsu»
Dialogue: 0,0:23:41.87,0:23:43.29,Default,,0,0,0,,"Қуатты қол! Геркулес!!"
Dialogue: 0,0:23:43.79,0:23:45.75,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:45.88,0:23:48.13,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:49.63,0:23:55.63,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory