Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.54,0:00:04.08,Default,,0,0,0,,Бейблейд
Dialogue: 0,0:00:04.17,0:00:08.13,Default,,0,0,0,,Мықты болуды мақсат еткен ұлдардың арманының жемісі.
Dialogue: 0,0:00:08.96,0:00:12.17,Default,,0,0,0,,Енді супер Цетсу дәуірі басталады.
Dialogue: 0,0:00:12.55,0:00:16.80,Default,,0,0,0,,Металл сауытыңызды киіңіз де, Беймен шытырман оқиғаға аттаныңыз!
Dialogue: 0,0:00:16.93,0:00:19.06,Default,,0,0,0,,Әлем чемпионы болуды мақсат етіңіз!
Dialogue: 0,0:00:19.39,0:00:23.69,Default,,0,0,0,,Super Zetsu Super Zetsu Super Zetsu!
Dialogue: 0,0:00:24.27,0:00:27.90,Default,,0,0,0,,Ең күшті және жеңілмейтін атағын алатын адам сенсің!
Dialogue: 0,0:00:31.15,0:00:34.40,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:00:34.86,0:00:37.16,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:00:37.32,0:00:39.03,Default,,0,0,0,,Ох… Уф~ Мен қатты ашпын.
Dialogue: 0,0:00:39.12,0:00:41.12,Default,,0,0,0,,Фубуки Сумимен көптен күткен шайқас
Dialogue: 0,0:00:41.70,0:00:42.20,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:00:42.33,0:00:43.16,Default,,0,0,0,,Ах
Dialogue: 0,0:00:43.58,0:00:45.54,Default,,0,0,0,,Император Дрейф!
Dialogue: 0,0:00:49.59,0:00:50.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:51.63,0:00:53.67,Default,,0,0,0,,Мен император Форнейден жеңілдім.
Dialogue: 0,0:00:53.80,0:00:55.34,Default,,0,0,0,,Super Zetsu Бұл көңілсіз!
Dialogue: 0,0:00:56.13,0:00:58.85,Default,,0,0,0,,Тыңдаңыздар, ойын бір реттік ойын.
Dialogue: 0,0:00:59.22,0:01:01.77,Default,,0,0,0,,Біреуіміз жарылғанша ол бітпейді
Dialogue: 0,0:01:01.89,0:01:03.39,Default,,0,0,0,,Бұл Ранбей тобының ережелері.
Dialogue: 0,0:01:08.23,0:01:11.57,Default,,0,0,0,,Ранбей тобындағы Сорчомен жекпе-жек өте қызу болды.
Dialogue: 0,0:01:12.82,0:01:14.61,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:01:15.15,0:01:18.95,Default,,0,0,0,,Үш екі бір…
Dialogue: 0,0:01:19.57,0:01:22.20,Default,,0,0,0,,Түсіріңіз…
Dialogue: 0,0:01:22.33,0:01:23.50,Default,,0,0,0,,Уау, аа...
Dialogue: 0,0:01:23.83,0:01:24.70,Default,,0,0,0,,Ой және...
Dialogue: 0,0:01:26.00,0:01:28.67,Default,,0,0,0,,Біз жақсы уақыт өткіздік, бірақ ол тең аяқталды.
Dialogue: 0,0:01:29.50,0:01:31.25,Default,,0,0,0,,Келесі жолы мен сені талқандаймын!
Dialogue: 0,0:01:32.50,0:01:38.51,Default,,0,0,0,,♪~
Dialogue: 0,0:02:55.13,0:03:01.13,Default,,0,0,0,,~♪
Dialogue: 0,0:03:02.14,0:03:04.80,Default,,0,0,0,,"Шешіңіз! Z-Buster!!"
Dialogue: 0,0:03:06.10,0:03:08.93,Default,,0,0,0,,(Тауықтың айқайлауы)
Dialogue: 0,0:03:11.14,0:03:11.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:12.56,0:03:13.98,Default,,0,0,0,,Мен~
Dialogue: 0,0:03:14.48,0:03:17.73,Default,,0,0,0,,Қайырлы таң! Ахахха
Dialogue: 0,0:03:21.24,0:03:23.11,Default,,0,0,0,,(Тауықтың айқайлауы)
Dialogue: 0,0:03:24.03,0:03:25.49,Default,,0,0,0,,(Роко) Иә, әрине. Мұнда өте жайлы екен.
Dialogue: 0,0:03:25.83,0:03:26.99,Default,,0,0,0,,Мен~
Dialogue: 0,0:03:27.54,0:03:28.58,Default,,0,0,0,,Хи хи
Dialogue: 0,0:03:28.91,0:03:31.75,Default,,0,0,0,,Мен Айғаны алдым~
Dialogue: 0,0:03:31.87,0:03:33.50,Default,,0,0,0,,О! рахмет
Dialogue: 0,0:03:34.29,0:03:36.17,Default,,0,0,0,,Қараңдаршы, таңғы ас.
Dialogue: 0,0:03:37.55,0:03:39.80,Default,,0,0,0,,Хахахаха Жақсы ма?
Dialogue: 0,0:03:39.92,0:03:41.63,Default,,0,0,0,,Нару да Нару
Dialogue: 0,0:03:42.22,0:03:45.26,Default,,0,0,0,,(сыбырлау)
Dialogue: 0,0:03:45.51,0:03:46.85,Default,,0,0,0,,Қызыл жүзді Айга
Dialogue: 0,0:03:46.93,0:03:49.31,Default,,0,0,0,,Бұл әлгі жігіт (Бала С) Солай ма?
Dialogue: 0,0:03:50.81,0:03:51.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:51.85,0:03:52.77,Default,,0,0,0,,Осындай нәрсе.
Dialogue: 0,0:03:53.52,0:03:56.56,Default,,0,0,0,,Бэй Клубтан 100 адамға артық ойнағанымыз...
Dialogue: 0,0:03:56.94,0:03:59.98,Default,,0,0,0,,Ранбей тобымен дуэль туралы қауесет бар сияқты.
Dialogue: 0,0:04:00.36,0:04:02.32,Default,,0,0,0,,Хе! Әрине
Dialogue: 0,0:04:02.74,0:04:03.86,Default,,0,0,0,,Әрине бәрі
Dialogue: 0,0:04:03.99,0:04:07.08,Default,,0,0,0,,Айғаның күші маған қызық.
Dialogue: 0,0:04:07.58,0:04:09.08,Default,,0,0,0,,Мұндағы Штрохейм — сен бетпе-бет келетін соңғы қарсыласың.
Dialogue: 0,0:04:09.16,0:04:10.20,Default,,0,0,0,,Сәлем?
Dialogue: 0,0:04:10.29,0:04:12.25,Default,,0,0,0,,Айга да Бей клубына қосыла ма?
Dialogue: 0,0:04:12.33,0:04:13.96,Default,,0,0,0,,Бұл шындық болуы мүмкін емес, солай ма?
Dialogue: 0,0:04:14.46,0:04:16.92,Default,,0,0,0,,Мен оларды құртамын.
Dialogue: 0,0:04:17.00,0:04:17.84,Default,,0,0,0,,Ах
Dialogue: 0,0:04:19.00,0:04:21.26,Default,,0,0,0,,Ах Суми Фубуки
Dialogue: 0,0:04:22.63,0:04:23.47,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:28.47,0:04:31.64,Default,,0,0,0,,Қандай сезім!
Dialogue: 0,0:04:32.14,0:04:33.56,Default,,0,0,0,,Суми Фубуки!
Dialogue: 0,0:04:33.94,0:04:35.77,Default,,0,0,0,,Келесі жолы мен сені талқандаймын!
Dialogue: 0,0:04:48.74,0:04:49.74,Default,,0,0,0,,Не?
Dialogue: 0,0:04:50.45,0:04:52.66,Default,,0,0,0,,Қызықты нәрсе бар ма?
Dialogue: 0,0:04:56.29,0:04:57.13,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:57.67,0:04:59.71,Default,,0,0,0,,Жоқ, жоқ, рұқсатсыз кірдім.
Dialogue: 0,0:04:59.79,0:05:00.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:00.80,0:05:03.46,Default,,0,0,0,,Клубтың мүшесі болмасаңыз, кіре алмайсыз.
Dialogue: 0,0:05:03.55,0:05:05.88,Default,,0,0,0,,Иә! Бұл не?
Dialogue: 0,0:05:06.51,0:05:07.97,Default,,0,0,0,,Сен сондай сараңсың.
Dialogue: 0,0:05:08.97,0:05:10.64,Default,,0,0,0,,Айга! иә?
Dialogue: 0,0:05:11.06,0:05:12.68,Default,,0,0,0,,Олай, былай~
Dialogue: 0,0:05:19.36,0:05:22.07,Default,,0,0,0,,(Фанфар)
Dialogue: 0,0:05:22.19,0:05:25.11,Default,,0,0,0,,Жарайды! ұлдар мен қыздар
Dialogue: 0,0:05:25.24,0:05:26.74,Default,,0,0,0,,Сіз шайқасып жатырсыз ба?
Dialogue: 0,0:05:27.28,0:05:30.33,Default,,0,0,0,,Bay News уақыты келді!
Dialogue: 0,0:05:32.58,0:05:34.58,Default,,0,0,0,,Бүгінгі қызу жаңалық мынау.
Dialogue: 0,0:05:36.33,0:05:37.37,Default,,0,0,0,,Бал-нии!
Dialogue: 0,0:05:37.50,0:05:38.33,Default,,0,0,0,,Бауырым!
Dialogue: 0,0:05:39.33,0:05:41.67,Default,,0,0,0,,Super Beyblade титулының сәйкестігі
Dialogue: 0,0:05:42.21,0:05:44.09,Default,,0,0,0,,Жапонияның мақтан тұтатын тұңғыш әлем чемпионы
Dialogue: 0,0:05:44.17,0:05:47.59,Default,,0,0,0,,Біз Барто Аоидың қорғаныс шайқасын көрсететін боламыз~
Dialogue: 0,0:05:48.13,0:05:50.01,Default,,0,0,0,,О! Алақай!
Dialogue: 0,0:05:50.14,0:05:53.39,Default,,0,0,0,,Чемпион Балт Аоиға кім қарсы шығады?
Dialogue: 0,0:05:53.51,0:05:55.52,Default,,0,0,0,,Әлемдік рейтинг 6-орын
Dialogue: 0,0:05:55.64,0:06:00.15,Default,,0,0,0,,Курц Баратье, «Император» лақап аты бар адам!
Dialogue: 0,0:06:00.52,0:06:02.86,Default,,0,0,0,,Хун, мен сенің белбеуіңді алуға келдім.
Dialogue: 0,0:06:03.52,0:06:07.11,Default,,0,0,0,,Курц, мен сенімен тағы да күрескеніме қуаныштымын.
Dialogue: 0,0:06:07.70,0:06:10.36,Default,,0,0,0,,Эй, мен бұған қалай қатыса аламын?
Dialogue: 0,0:06:10.70,0:06:15.41,Default,,0,0,0,,Ал, мен жоғары рейтингте тек қана блейдерлер болатынына сенімдімін.
Dialogue: 0,0:06:15.54,0:06:18.12,Default,,0,0,0,,Чемпионды сынауға болатынын айтады.
Dialogue: 0,0:06:18.37,0:06:19.79,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:06:19.92,0:06:21.38,Default,,0,0,0,,Рейтингке кіре алмасаңыз...
Dialogue: 0,0:06:21.50,0:06:23.92,Default,,0,0,0,,Балт Аоимен төбелесе алмайсың ба?
Dialogue: 0,0:06:24.05,0:06:25.59,Default,,0,0,0,,Мазасыз~
Dialogue: 0,0:06:25.80,0:06:27.59,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:06:28.05,0:06:30.47,Default,,0,0,0,,Екінші шайқас мәселені шешпейді
Dialogue: 0,0:06:30.93,0:06:33.47,Default,,0,0,0,,Балт Аои, Super Beyblade ше?
Dialogue: 0,0:06:33.60,0:06:36.27,Default,,0,0,0,,Чемпиондық белбеуіңізді қорғай аласыз ба?
Dialogue: 0,0:06:36.68,0:06:38.10,Default,,0,0,0,,Үшінші шайқас
Dialogue: 0,0:06:41.44,0:06:42.27,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:06:42.48,0:06:44.52,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:06:45.15,0:06:48.28,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:06:48.49,0:06:51.16,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:06:51.28,0:06:52.16,Default,,0,0,0,,Тыныш!
Dialogue: 0,0:06:56.49,0:06:58.75,Default,,0,0,0,,Жүр! Валькирия!
Dialogue: 0,0:06:59.75,0:07:01.17,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:01.25,0:07:04.71,Default,,0,0,0,,Валькирияның күшті шабуылын жеңу жарылды!
Dialogue: 0,0:07:05.04,0:07:09.22,Default,,0,0,0,,Hmph, бұл туралы. Тіпті супер Zetsu болса да, бұл үлкен мәселе емес.
Dialogue: 0,0:07:11.26,0:07:12.84,Default,,0,0,0,,Мия мама!
Dialogue: 0,0:07:13.14,0:07:16.60,Default,,0,0,0,,Beat Kukulkan әсерлі жүзі шықты!
Dialogue: 0,0:07:17.10,0:07:18.10,Default,,0,0,0,,Жүгіру!
Dialogue: 0,0:07:19.31,0:07:20.98,Default,,0,0,0,,Уау Уау Уау!
Dialogue: 0,0:07:21.10,0:07:24.48,Default,,0,0,0,,Валькирияның ұту жылдамдығы артады!
Dialogue: 0,0:07:25.23,0:07:28.65,Default,,0,0,0,,Шешіңіз! Валькирия!
Dialogue: 0,0:07:33.74,0:07:35.66,Default,,0,0,0,,
Dialogue: 0,0:07:35.95,0:07:38.08,Default,,0,0,0,,Кукулканды ұрыңыз!
Dialogue: 0,0:07:43.04,0:07:44.67,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:07:47.92,0:07:49.38,Default,,0,0,0,,Шабуылды іске қосыңыз!
Dialogue: 0,0:07:50.63,0:07:52.80,Default,,0,0,0,,Жеңіс Slash!
Dialogue: 0,0:08:01.89,0:08:02.98,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:03.44,0:08:06.31,Default,,0,0,0,,Жеңіс Valkyrie Burst Finish!
Dialogue: 0,0:08:06.44,0:08:08.98,Default,,0,0,0,,Жеңімпаз Барто Аои!
Dialogue: 0,0:08:09.98,0:08:11.57,Default,,0,0,0,,(Лэйди тауы) Хмм? Не айтқың келеді?
Dialogue: 0,0:08:11.99,0:08:13.57,Default,,0,0,0,,Өте жақсы!
Dialogue: 0,0:08:14.07,0:08:17.83,Default,,0,0,0,,Балт Аои белбеуін сәтті қорғады!
Dialogue: 0,0:08:18.53,0:08:20.66,Default,,0,0,0,,Фантастикалық керемет
Dialogue: 0,0:08:20.83,0:08:24.21,Default,,0,0,0,,Ұлдар мен қыздар Ұлы чемпиондарымызға үлкен қошемет
Dialogue: 0,0:08:24.46,0:08:27.96,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:08:31.46,0:08:33.47,Default,,0,0,0,,Бұл таңғажайып шайқас болды.
Dialogue: 0,0:08:33.67,0:08:36.55,Default,,0,0,0,,Сен мықтысың, Аои Барто
Dialogue: 0,0:08:36.68,0:08:39.51,Default,,0,0,0,,Ей, мен мына жігітті құртамын.
Dialogue: 0,0:08:40.01,0:08:42.68,Default,,0,0,0,,Ха~хахахаха!
Dialogue: 0,0:08:42.81,0:08:47.36,Default,,0,0,0,,Мен ең күшті, ең жеңілмейтін супер Цетсу әлем чемпионымын.
Dialogue: 0,0:08:47.69,0:08:49.11,Default,,0,0,0,,Ах
Dialogue: 0,0:08:50.94,0:08:52.28,Default,,0,0,0,,Дари~
Dialogue: 0,0:08:52.53,0:08:53.78,Default,,0,0,0,,Рахмет
Dialogue: 0,0:08:53.86,0:08:56.07,Default,,0,0,0,,Сонда Оме әлем чемпионы ма?
Dialogue: 0,0:08:56.32,0:08:57.16,Default,,0,0,0,,О
Dialogue: 0,0:08:57.37,0:08:58.99,Default,,0,0,0,,Мені күлдірмеңіз
Dialogue: 0,0:08:59.12,0:09:02.08,Default,,0,0,0,,Ақырын, мен Сочомен тең түстім.
Dialogue: 0,0:09:02.20,0:09:04.21,Default,,0,0,0,,Алаңдамаңыз.
Dialogue: 0,0:09:04.87,0:09:06.92,Default,,0,0,0,,Сіз не істеп жатырсыз? Қайтарыңыз!
Dialogue: 0,0:09:07.42,0:09:09.09,Default,,0,0,0,,Бауырым, сен тағы күшейдің.
Dialogue: 0,0:09:09.17,0:09:09.88,Default,,0,0,0,,Сәлем! Нағыз әлем чемпионы
Dialogue: 0,0:09:09.88,0:09:11.34,Default,,0,0,0,,Сәлем! Нағыз әлем чемпионы
Dialogue: 0,0:09:09.88,0:09:11.34,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:09:11.34,0:09:12.55,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:09:15.59,0:09:18.59,Default,,0,0,0,,Оны қайтарғыңыз келсе, тез жетуге тырысыңыз.
Dialogue: 0,0:09:19.22,0:09:20.56,Default,,0,0,0,,Олар...
Dialogue: 0,0:09:22.56,0:09:23.47,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:24.06,0:09:25.35,Default,,0,0,0,,Не?!
Dialogue: 0,0:09:26.35,0:09:28.15,Default,,0,0,0,,Жақсы! (3 адам) Уау!
Dialogue: 0,0:09:28.77,0:09:30.40,Default,,0,0,0,,Енді оны қайтарыңыз.
Dialogue: 0,0:09:31.82,0:09:34.24,Default,,0,0,0,,Бізбен тағы да жарысыңыз
Dialogue: 0,0:09:34.36,0:09:35.90,Default,,0,0,0,,Онда мен оны саған қайтарамын.
Dialogue: 0,0:09:36.45,0:09:38.24,Default,,0,0,0,,Ха, қызық екен.
Dialogue: 0,0:09:38.49,0:09:41.16,Default,,0,0,0,,Қанша тырыссам да, міндетті түрде жеңемін.
Dialogue: 0,0:09:41.28,0:09:43.04,Default,,0,0,0,,Не...
Dialogue: 0,0:09:43.16,0:09:45.33,Default,,0,0,0,,Не істеп жатырсың! (Тобисуке) Иә?
Dialogue: 0,0:09:46.00,0:09:47.62,Default,,0,0,0,,Маңызды емес, артта қал.
Dialogue: 0,0:09:48.29,0:09:49.96,Default,,0,0,0,,Біреудің шығанағын ұрлау үшін...
Dialogue: 0,0:09:50.25,0:09:52.63,Default,,0,0,0,,Жолдас ретінде мен үнсіз қала алмаймын.
Dialogue: 0,0:09:53.21,0:09:55.67,Default,,0,0,0,,Сонымен не істейміз?
Dialogue: 0,0:09:55.80,0:09:57.13,Default,,0,0,0,,Мұндағы Штрохейм — сен бетпе-бет келетін соңғы қарсыласың.
Dialogue: 0,0:10:01.55,0:10:03.51,Default,,0,0,0,,Фубуки-сенпай! Не істеуім керек?
Dialogue: 0,0:10:03.72,0:10:05.39,Default,,0,0,0,,Токонацу және Ранбей тобы...
Dialogue: 0,0:10:06.31,0:10:07.18,Default,,0,0,0,,Не?
Dialogue: 0,0:10:07.64,0:10:10.27,Default,,0,0,0,,(шұңқырлар соқтығысқан дыбыс)
Dialogue: 0,0:10:11.02,0:10:11.90,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:13.23,0:10:16.40,Default,,0,0,0,,Сол үшін айттым ғой, солай ма? Мен жеңемін
Dialogue: 0,0:10:18.95,0:10:20.11,Default,,0,0,0,,Конно~
Dialogue: 0,0:10:21.78,0:10:22.78,Default,,0,0,0,,Не істеп жатырсың!
Dialogue: 0,0:10:22.91,0:10:24.58,Default,,0,0,0,,Сіз оны қайтаруға уәде бересіз.
Dialogue: 0,0:10:24.95,0:10:27.58,Default,,0,0,0,,Шулы! Мұндай шығанақ!
Dialogue: 0,0:10:27.75,0:10:28.58,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:29.37,0:10:30.75,Default,,0,0,0,,Нені шулатып жатырсың?
Dialogue: 0,0:10:30.88,0:10:32.13,Default,,0,0,0,,Уф... Сочо
Dialogue: 0,0:10:32.25,0:10:33.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:36.63,0:10:38.72,Default,,0,0,0,,Мына шығанақпен не істемексің?
Dialogue: 0,0:10:39.18,0:10:40.68,Default,,0,0,0,,Бұл біраз...
Dialogue: 0,0:10:40.76,0:10:42.01,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:10:42.09,0:10:42.80,Default,,0,0,0,,Е...
Dialogue: 0,0:10:43.18,0:10:45.47,Default,,0,0,0,,Енді лас ештеңе жасама!
Dialogue: 0,0:10:45.77,0:10:46.93,Default,,0,0,0,,Иә...
Dialogue: 0,0:10:48.60,0:10:49.73,Default,,0,0,0,,Ято-сама!
Dialogue: 0,0:10:49.85,0:10:50.69,Default,,0,0,0,,О
Dialogue: 0,0:10:53.06,0:10:55.65,Default,,0,0,0,,Мәңгілік жаз! Сенімен бәрі жақсы ма? (мәңгілік жаз) Иә
Dialogue: 0,0:10:56.61,0:10:57.86,Default,,0,0,0,,Бұл не үшін?
Dialogue: 0,0:10:58.44,0:11:01.36,Default,,0,0,0,,Сіз шынымен ақымақ адамдармен жұмыс істеп жатқан болуыңыз керек.
Dialogue: 0,0:11:01.78,0:11:02.87,Default,,0,0,0,,Не?
Dialogue: 0,0:11:03.99,0:11:06.41,Default,,0,0,0,,Балалар, Бейблейдтерді қорлайсыңдар.
Dialogue: 0,0:11:07.08,0:11:08.87,Default,,0,0,0,,Сіз маған айтасыз.
Dialogue: 0,0:11:09.29,0:11:12.33,Default,,0,0,0,,Біз өз жолымызбен күресіп жатырмыз.
Dialogue: 0,0:11:12.58,0:11:14.67,Default,,0,0,0,,Шағымдануға негіз жоқ.
Dialogue: 0,0:11:15.04,0:11:18.09,Default,,0,0,0,,Мен сізді пышақ деп танымаймын.
Dialogue: 0,0:11:18.84,0:11:19.88,Default,,0,0,0,,Не?
Dialogue: 0,0:11:24.14,0:11:25.22,Default,,0,0,0,,Иә
Dialogue: 0,0:11:25.72,0:11:26.68,Default,,0,0,0,,Егер солай болса...
Dialogue: 0,0:11:27.18,0:11:30.98,Default,,0,0,0,,Қайсысы нағыз Блейдер екенін шешейік.
Dialogue: 0,0:11:31.69,0:11:35.19,Default,,0,0,0,,Не істеу керек? Мен қашып кетсем маңызды емес, солай ма?
Dialogue: 0,0:11:35.61,0:11:38.07,Default,,0,0,0,,Біз шайқаста білуіміз керек сияқты.
Dialogue: 0,0:11:38.32,0:11:42.36,Default,,0,0,0,,Алайда, егер мен жеңсем, сенің енді ешқашан Bay Club-қа қатысың болмайды.
Dialogue: 0,0:11:44.57,0:11:45.87,Default,,0,0,0,,Хехехехе
Dialogue: 0,0:11:46.37,0:11:49.45,Default,,0,0,0,,Біз өте қызықты шайқастарды көретін сияқтымыз.
Dialogue: 0,0:12:03.47,0:12:04.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:05.14,0:12:06.22,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:12:10.02,0:12:11.85,Default,,0,0,0,,Мен оны ұшырып жіберемін!
Dialogue: 0,0:12:12.39,0:12:14.85,Default,,0,0,0,,Қолыңыздан келсе, көріңіз!
Dialogue: 0,0:12:15.19,0:12:16.65,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:12:18.07,0:12:19.53,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:12:20.07,0:12:23.28,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:12:23.90,0:12:26.16,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:12:26.28,0:12:27.41,Default,,0,0,0,,Ох… Уф~ Мен қатты ашпын.
Dialogue: 0,0:12:29.83,0:12:31.62,Default,,0,0,0,,Металл қанат?
Dialogue: 0,0:12:38.46,0:12:39.88,Default,,0,0,0,,Жасайық
Dialogue: 0,0:12:40.00,0:12:42.38,Default,,0,0,0,,Бұл капитанның тамаша қорғанысы.
Dialogue: 0,0:12:42.80,0:12:44.72,Default,,0,0,0,,Желді металл қанаттарымен кесіңіз!
Dialogue: 0,0:12:45.34,0:12:48.35,Default,,0,0,0,,Рагнарук тайфуны!
Dialogue: 0,0:12:51.43,0:12:53.85,Default,,0,0,0,,Сочоның ерекше қимылы күшті.
Dialogue: 0,0:12:53.98,0:12:56.27,Default,,0,0,0,,«Рагнарк тайфуны» өтпейді.
Dialogue: 0,0:13:00.57,0:13:02.11,Default,,0,0,0,,Бұл жұмыс істемейді.
Dialogue: 0,0:13:02.49,0:13:04.61,Default,,0,0,0,,Иә, бұл туралы ше?
Dialogue: 0,0:13:09.12,0:13:11.45,Default,,0,0,0,,(Форнеустың айқайы)
Dialogue: 0,0:13:12.29,0:13:13.75,Default,,0,0,0,,Император Дрейф!
Dialogue: 0,0:13:15.29,0:13:18.96,Default,,0,0,0,,Мен оны қабылдаймын, Crash Ragnaruk!
Dialogue: 0,0:13:32.97,0:13:34.85,Default,,0,0,0,,Міне!
Dialogue: 0,0:13:37.85,0:13:38.90,Default,,0,0,0,,Не? Ах
Dialogue: 0,0:13:39.52,0:13:40.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:41.32,0:13:44.69,Default,,0,0,0,,Ах... Император Форней жарылып бітті!
Dialogue: 0,0:13:44.82,0:13:46.99,Default,,0,0,0,,Жеңімпаз Фубуки Сумие!
Dialogue: 0,0:13:47.36,0:13:48.53,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:49.03,0:13:49.95,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:13:50.07,0:13:52.45,Default,,0,0,0,,Сіз өз күшіңізге тым сенімді болдыңыз.
Dialogue: 0,0:13:52.54,0:13:53.45,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:54.16,0:13:56.16,Default,,0,0,0,,Менің ойымша, ол кезде мен болдым.
Dialogue: 0,0:14:00.83,0:14:01.50,Default,,0,0,0,,Ал сосын!
Dialogue: 0,0:14:01.79,0:14:03.88,Default,,0,0,0,,Бұл менің Бейблейдім
Dialogue: 0,0:14:04.42,0:14:05.26,Default,,0,0,0,,Tsk
Dialogue: 0,0:14:11.72,0:14:12.56,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:14:13.31,0:14:16.68,Default,,0,0,0,,Crash Рагнаруктың кадры шабуылдар үшін тиімді, бірақ...
Dialogue: 0,0:14:16.81,0:14:20.02,Default,,0,0,0,,Бұл қарсыластың шабуылын оңай қабылдай алатыныңызды білдіре ме?
Dialogue: 0,0:14:20.52,0:14:21.36,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:14:23.90,0:14:26.28,Default,,0,0,0,,Фубуки-сенпай керемет болды.
Dialogue: 0,0:14:26.40,0:14:29.95,Default,,0,0,0,,Әй, капитан осындай жігіттен жеңіледі.
Dialogue: 0,0:14:30.99,0:14:33.16,Default,,0,0,0,,Ондай нәрсеге қатты қуанбаңыз!
Dialogue: 0,0:14:33.66,0:14:35.87,Default,,0,0,0,,Мен оған айтқан «тым сенімділік» сөзі...
Dialogue: 0,0:14:36.00,0:14:38.58,Default,,0,0,0,,Бұл менің өзіме де, саған да айтқан сөзім.
Dialogue: 0,0:14:38.96,0:14:40.29,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:14:41.25,0:14:42.42,Default,,0,0,0,,Не! Гваааах!
Dialogue: 0,0:14:44.42,0:14:45.75,Default,,0,0,0,,Ранжиро Кияма
Dialogue: 0,0:14:46.46,0:14:48.84,Default,,0,0,0,,Мен одан да күштімін.
Dialogue: 0,0:14:50.43,0:14:51.34,Default,,0,0,0,,Сонда бәрі бір сәтте бітеді.
Dialogue: 0,0:14:52.43,0:14:55.26,Default,,0,0,0,,Фубукидің Яроуы шынымен жиіркенішті.
Dialogue: 0,0:14:55.35,0:14:58.02,Default,,0,0,0,,Әр адамның жаман күндері болады.
Dialogue: 0,0:14:58.10,0:14:59.23,Default,,0,0,0,,Коичи, сен де келесің бе?
Dialogue: 0,0:14:59.31,0:15:01.19,Default,,0,0,0,,Шулы! (2 адам) Келіңіздер!
Dialogue: 0,0:15:06.40,0:15:10.15,Default,,0,0,0,,Әй, қызық болып барады.
Dialogue: 0,0:15:12.87,0:15:13.82,Default,,0,0,0,,(ашу дыбысы)
Dialogue: 0,0:15:14.28,0:15:15.12,Default,,0,0,0,,Иә
Dialogue: 0,0:15:23.67,0:15:25.29,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:15:25.59,0:15:29.01,Default,,0,0,0,,Бұл күштірек болу үшін. Сондай-ақ Теме және басқалар үшін бірдеңе бар.
Dialogue: 0,0:15:29.51,0:15:31.30,Default,,0,0,0,,Жақсы! Мен де қосамын
Dialogue: 0,0:15:31.43,0:15:33.14,Default,,0,0,0,,Мен кенеттен күшейемін
Dialogue: 0,0:15:33.39,0:15:34.64,Default,,0,0,0,,Дари~
Dialogue: 0,0:15:35.26,0:15:37.18,Default,,0,0,0,,Көңіл-күйімізді көтерейік!
Dialogue: 0,0:15:37.51,0:15:38.64,Default,,0,0,0,,О!
Dialogue: 0,0:15:39.10,0:15:40.48,Default,,0,0,0,,Ran Bay тобы!
Dialogue: 0,0:15:41.48,0:15:42.98,Default,,0,0,0,,Ең күшті!
Dialogue: 0,0:16:00.62,0:16:01.46,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:02.21,0:16:03.92,Default,,0,0,0,,Келесі жолы мен міндетті түрде жеңемін!
Dialogue: 0,0:16:05.08,0:16:06.88,Default,,0,0,0,,(қой малау)
Dialogue: 0,0:16:12.09,0:16:12.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:13.43,0:16:15.97,Default,,0,0,0,,Сондықтан жіптің тартылған бұрышын табыңыз...
Dialogue: 0,0:16:16.10,0:16:16.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:20.22,0:16:21.39,Default,,0,0,0,,Сәлем Фубуки!
Dialogue: 0,0:16:21.68,0:16:23.23,Default,,0,0,0,,Менімен тағы да жарысыңыз
Dialogue: 0,0:16:25.77,0:16:26.36,Default,,0,0,0,,Эй!
Dialogue: 0,0:16:26.73,0:16:30.44,Default,,0,0,0,,Блейдерлер қарсыласқанда шайқасады, солай ма?
Dialogue: 0,0:16:30.57,0:16:34.36,Default,,0,0,0,,Әлем чемпионы Балт Аои менімен жұдырықтасуға қуанышты болды.
Dialogue: 0,0:16:34.45,0:16:35.24,Default,,0,0,0,,Га
Dialogue: 0,0:16:35.53,0:16:37.74,Default,,0,0,0,,Иә? Бару-нимен шайқас па?
Dialogue: 0,0:16:38.28,0:16:39.66,Default,,0,0,0,,Ақымақ болма
Dialogue: 0,0:16:40.20,0:16:42.45,Default,,0,0,0,,Өтірік айтпа, ұрыс болдық
Dialogue: 0,0:16:42.87,0:16:43.96,Default,,0,0,0,,Менің әкем-
Dialogue: 0,0:16:44.08,0:16:46.08,Default,,0,0,0,,Мен Balt's Super Zetsubei жасаған кезде.
Dialogue: 0,0:16:46.75,0:16:48.04,Default,,0,0,0,,Мен білмедім
Dialogue: 0,0:16:48.59,0:16:51.63,Default,,0,0,0,,Сол кезде мен Аои Балтты жеңдім...
Dialogue: 0,0:16:51.76,0:16:54.97,Default,,0,0,0,,Мен Super Zetsu-ның ең күшті және жеңілмейтін чемпионы болуды шештім.
Dialogue: 0,0:16:56.68,0:16:58.26,Default,,0,0,0,,Бұл рас сияқты.
Dialogue: 0,0:16:59.30,0:17:00.14,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:17:00.72,0:17:03.18,Default,,0,0,0,,Мен сенің енді ешқашан үлкен мәміле жасамайтыныңа сенімдімін.
Dialogue: 0,0:17:03.52,0:17:05.35,Default,,0,0,0,,Кәне, жасайық.
Dialogue: 0,0:17:08.23,0:17:09.48,Default,,0,0,0,,Сочо!
Dialogue: 0,0:17:10.40,0:17:11.44,Default,,0,0,0,,Бұл қиын
Dialogue: 0,0:17:11.57,0:17:13.74,Default,,0,0,0,,Акабане Айга мен Суми Фубукидің мыңжапырақ...
Dialogue: 0,0:17:14.53,0:17:15.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:20.66,0:17:23.75,Default,,0,0,0,,Сәлем! Ранбей тобы енді бізбен араласпаймын деп уәде берді...
Dialogue: 0,0:17:23.87,0:17:27.88,Default,,0,0,0,,О? Жап, менің Темемен де, басқалармен де шаруам жоқ.
Dialogue: 0,0:17:28.42,0:17:29.33,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:30.29,0:17:33.46,Default,,0,0,0,,Әлгі бейбақ көңіл көтеріп отыр.
Dialogue: 0,0:17:33.63,0:17:35.30,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:17:35.72,0:17:37.51,Default,,0,0,0,,Мен сені үрлеймін
Dialogue: 0,0:17:38.39,0:17:40.01,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:17:40.72,0:17:43.77,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:17:44.02,0:17:46.52,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:17:51.36,0:17:53.03,Default,,0,0,0,,Ахиллесті ұшырып жібер!
Dialogue: 0,0:17:55.82,0:17:57.07,Default,,0,0,0,,Император гвардиясы
Dialogue: 0,0:18:03.41,0:18:05.25,Default,,0,0,0,,Күткендей, Фубуки-сенпай
Dialogue: 0,0:18:08.33,0:18:11.38,Default,,0,0,0,,Император Форней аяқталды
Dialogue: 0,0:18:11.50,0:18:12.88,Default,,0,0,0,,1-ден 0-ге дейінгі нүктелер
Dialogue: 0,0:18:13.30,0:18:14.30,Default,,0,0,0,,Ах~
Dialogue: 0,0:18:17.30,0:18:18.13,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:18:18.97,0:18:19.89,Default,,0,0,0,,Жарайды
Dialogue: 0,0:18:22.64,0:18:23.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:23.93,0:18:26.64,Default,,0,0,0,,Сол кездегідей жоғарыдан шабуыл жасауды жоспарлап отырсыз ба?
Dialogue: 0,0:18:28.94,0:18:30.15,Default,,0,0,0,,Құлап қалмаңыз
Dialogue: 0,0:18:30.98,0:18:32.06,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:18:33.48,0:18:35.03,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:18:35.69,0:18:38.78,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:18:39.03,0:18:41.41,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:18:41.74,0:18:42.74,Default,,0,0,0,,Ох… Уф~ Мен қатты ашпын.
Dialogue: 0,0:18:45.74,0:18:46.58,Default,,0,0,0,,Не?
Dialogue: 0,0:18:47.04,0:18:51.50,Default,,0,0,0,,Z Ахиллестің қозғалысын болжап, орталықтан әдейі ауытқып кеттіңіз бе?
Dialogue: 0,0:18:52.00,0:18:53.42,Default,,0,0,0,,Фубуки күткендей
Dialogue: 0,0:18:54.17,0:18:55.30,Default,,0,0,0,,Буси!
Dialogue: 0,0:19:02.09,0:19:03.93,Default,,0,0,0,,Уау! Форнеус!
Dialogue: 0,0:19:08.06,0:19:09.52,Default,,0,0,0,,(айқай)
Dialogue: 0,0:19:13.19,0:19:15.48,Default,,0,0,0,,Бітті! Қызыл пышақ Айга!
Dialogue: 0,0:19:15.94,0:19:16.94,Default,,0,0,0,,Бұл осы жерден!
Dialogue: 0,0:19:21.24,0:19:24.07,Default,,0,0,0,,♬~
Dialogue: 0,0:19:29.96,0:19:33.21,Default,,0,0,0,,♬~
Dialogue: 0,0:19:34.13,0:19:35.88,Default,,0,0,0,,(Дарио) Бұл нағыз апат. Бұл жігіт те сол жерде-ақ қаза тапты. ➡
Dialogue: 0,0:19:36.46,0:19:37.30,Default,,0,0,0,,Форнеус!
Dialogue: 0,0:19:45.93,0:19:47.31,Default,,0,0,0,,Император Дрифт
Dialogue: 0,0:19:50.81,0:19:52.06,Default,,0,0,0,,Айга қауіпті!
Dialogue: 0,0:19:52.64,0:19:56.57,Default,,0,0,0,,Эй, сен не күтіп тұрғанын көресің!
Dialogue: 0,0:19:57.98,0:19:58.73,Default,,0,0,0,,Ах
Dialogue: 0,0:19:59.53,0:20:03.45,Default,,0,0,0,,Z Buster!
Dialogue: 0,0:20:13.87,0:20:14.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:18.67,0:20:20.01,Default,,0,0,0,,Менің ағам...
Dialogue: 0,0:20:20.30,0:20:22.17,Default,,0,0,0,,Жарылу үшін жасалады
Dialogue: 0,0:20:22.93,0:20:24.89,Default,,0,0,0,,Айга жеңді~!
Dialogue: 0,0:20:25.14,0:20:26.39,Default,,0,0,0,,Сол мыңжапырақ
Dialogue: 0,0:20:27.18,0:20:30.56,Default,,0,0,0,,Сіз шабуыл күшіңіздің ең күшті бөлігімен көздедіңіз бе?
Dialogue: 0,0:20:33.44,0:20:34.77,Default,,0,0,0,,Хехе
Dialogue: 0,0:20:35.44,0:20:37.11,Default,,0,0,0,,Кимел Коул.
Dialogue: 0,0:20:37.23,0:20:38.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:39.02,0:20:41.49,Default,,0,0,0,,Z Ахиллестің жарылуы аяқталуы
Dialogue: 0,0:20:41.74,0:20:44.36,Default,,0,0,0,,Red Blade Aiga 1-ден 2 ұпайға дейін жеңеді.
Dialogue: 0,0:20:46.03,0:20:46.99,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:50.16,0:20:53.54,Default,,0,0,0,,Фубуки мұнымен қайтадан күшейеді.
Dialogue: 0,0:20:54.46,0:20:55.33,Default,,0,0,0,,Ах! (Ранджиро) Ха!
Dialogue: 0,0:20:55.42,0:20:56.42,Default,,0,0,0,,Не болды, Нару?
Dialogue: 0,0:20:56.54,0:20:59.25,Default,,0,0,0,,Ей, бұл жаңалық.
Dialogue: 0,0:21:00.46,0:21:02.84,Default,,0,0,0,,Жарайды! ұлдар мен қыздар
Dialogue: 0,0:21:03.47,0:21:04.97,Default,,0,0,0,,Қалай, не, не!
Dialogue: 0,0:21:05.09,0:21:08.60,Default,,0,0,0,,Әлем чемпионы Барто Аои мен Руи Ширасадиджо...
Dialogue: 0,0:21:08.72,0:21:11.27,Default,,0,0,0,,Титулдық матч анықталды!
Dialogue: 0,0:21:11.77,0:21:13.77,Default,,0,0,0,,Аои Барто титулдық сәйкестігі
Dialogue: 0,0:21:14.31,0:21:15.48,Default,,0,0,0,,Барто Аои…
Dialogue: 0,0:21:16.31,0:21:19.15,Default,,0,0,0,,Бұл әрине қызықты болады.
Dialogue: 0,0:21:19.69,0:21:22.69,Default,,0,0,0,,Сонымен, Луи Ширасаги деген кім?
Dialogue: 0,0:21:22.82,0:21:23.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:24.11,0:21:27.03,Default,,0,0,0,,Жапонияда болғаннан бергі ең күшті қарсыласым.
Dialogue: 0,0:21:27.16,0:21:29.07,Default,,0,0,0,,Ширасадиджо Луиге қарсы...
Dialogue: 0,0:21:29.28,0:21:32.79,Default,,0,0,0,,Балт Аои чемпиондық белбеуін қорғай ала ма?
Dialogue: 0,0:21:33.37,0:21:37.67,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:21:45.42,0:21:49.26,Default,,0,0,0,,Valkyrie VS Bloody Longinus шайқасында жеңіске жету
Dialogue: 0,0:21:49.39,0:21:50.85,Default,,0,0,0,,Оны жіберіп алмаңыз!
Dialogue: 0,0:21:54.56,0:22:00.56,Default,,0,0,0,,♪~
Dialogue: 0,0:23:17.02,0:23:23.02,Default,,0,0,0,,~♪
Dialogue: 0,0:23:24.82,0:23:27.15,Default,,0,0,0,,Балто мен Луи арасындағы саммит аяқталды.
Dialogue: 0,0:23:27.61,0:23:30.03,Default,,0,0,0,,Жеңімпаз жоғарыда!
Dialogue: 0,0:23:30.11,0:23:32.32,Default,,0,0,0,,Мен де шыңды аламын!
Dialogue: 0,0:23:32.74,0:23:37.16,Default,,0,0,0,,Не? Мен біреу мені мазақ етсе, бетін қайтаратын жігіт емеспін.
Dialogue: 0,0:23:37.41,0:23:38.54,Default,,0,0,0,,Ақымақ болма, Луис!
Dialogue: 0,0:23:38.62,0:23:40.66,Default,,0,0,0,,Келесі жолы «Beyblade Burst Super Zetsu»
Dialogue: 0,0:23:41.21,0:23:45.09,Default,,0,0,0,,"Super Zetsu Showdown! Valkyrie VS Longinus!!"
Dialogue: 0,0:23:45.21,0:23:46.96,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:47.09,0:23:48.76,Default,,0,0,0,,Бар, ат!
