Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.50,0:00:04.04,Default,,0,0,0,,Бейблейд
Dialogue: 0,0:00:04.17,0:00:08.13,Default,,0,0,0,,Мықты болуды мақсат еткен ұлдардың арманының жемісі.
Dialogue: 0,0:00:08.96,0:00:12.17,Default,,0,0,0,,Енді супер Цетсу дәуірі басталады.
Dialogue: 0,0:00:12.55,0:00:16.80,Default,,0,0,0,,Металл сауытыңызды киіңіз де, Беймен шытырман оқиғаға аттаныңыз!
Dialogue: 0,0:00:16.93,0:00:19.10,Default,,0,0,0,,Әлем чемпионы болуды мақсат етіңіз!
Dialogue: 0,0:00:19.39,0:00:23.64,Default,,0,0,0,,Super Zetsu Super Zetsu Super Zetsu!
Dialogue: 0,0:00:24.27,0:00:27.90,Default,,0,0,0,,Ең күшті және жеңілмейтін атағын алатын адам сенсің!
Dialogue: 0,0:00:31.19,0:00:33.36,Default,,0,0,0,,Келіңіздер! Ақырында
Dialogue: 0,0:00:33.61,0:00:39.16,Default,,0,0,0,,Ең ыстық екі Блейдер осында!
Dialogue: 0,0:00:41.04,0:00:44.83,Default,,0,0,0,,Біріншіден, «Жаңа жұлдыз» орасан зор алға жылжуын жалғастыруда
Dialogue: 0,0:00:44.96,0:00:48.25,Default,,0,0,0,,Тоймайтын жұлдыз, Айға Айка!
Dialogue: 0,0:00:49.17,0:00:52.42,Default,,0,0,0,,Әлем чемпионы Барто Аоимен...
Dialogue: 0,0:00:52.55,0:00:55.43,Default,,0,0,0,,Біз көптеген кескілескен шайқастарды өткіздік.
Dialogue: 0,0:00:55.55,0:00:59.68,Default,,0,0,0,,«Ақ тиран» Ширасаги сарайы Руи!
Dialogue: 0,0:00:59.89,0:01:02.22,Default,,0,0,0,,Мен Лонгинус кубогына қатыстым
Dialogue: 0,0:01:02.85,0:01:06.39,Default,,0,0,0,,Ширасаги сарайы Луиспен күресетін уақыт келді.
Dialogue: 0,0:01:07.35,0:01:10.19,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:01:10.82,0:01:13.11,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:01:13.49,0:01:14.94,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:01:23.91,0:01:27.12,Default,,0,0,0,,Әй, не күтіп тұрғанын көресің!
Dialogue: 0,0:01:27.29,0:01:28.29,Default,,0,0,0,,Не?
Dialogue: 0,0:01:31.21,0:01:33.67,Default,,0,0,0,,♬~
Dialogue: 0,0:01:33.80,0:01:38.76,Default,,0,0,0,,Алға! Z сүңгу! (Ахиллестің шайқас айқайы)
Dialogue: 0,0:01:42.39,0:01:43.26,Default,,0,0,0,,Оны атамаңыз!
Dialogue: 0,0:01:45.14,0:01:49.69,Default,,0,0,0,,Айдаһар айқайын бөліп тастаңыз!
Dialogue: 0,0:01:56.95,0:01:59.24,Default,,0,0,0,,Ширасаги сарайы Луи шынымен күшті.
Dialogue: 0,0:01:59.99,0:02:03.24,Default,,0,0,0,,Мен абсолютті чемпионның аурасын сезінемін.
Dialogue: 0,0:02:05.66,0:02:11.67,Default,,0,0,0,,♪~
Dialogue: 0,0:03:28.12,0:03:34.13,Default,,0,0,0,,~♪
Dialogue: 0,0:03:35.46,0:03:37.34,Default,,0,0,0,,«Луиді жеңіңіз!»
Dialogue: 0,0:03:39.63,0:03:43.09,Default,,0,0,0,,Хахаха!
Dialogue: 0,0:03:43.30,0:03:46.18,Default,,0,0,0,,Лонгинус кубогының жеңімпазы әлі ме?
Dialogue: 0,0:03:46.55,0:03:48.35,Default,,0,0,0,,Әлсіздігі сонша, күлкілі
Dialogue: 0,0:03:48.47,0:03:50.81,Default,,0,0,0,,Хахаха!
Dialogue: 0,0:03:50.93,0:03:54.19,Default,,0,0,0,,Абсолютті чемпион Ширасадиджо Луи күткендей
Dialogue: 0,0:03:54.44,0:03:57.44,Default,,0,0,0,,Қызыл жүз Айга Намирудың қас жауларын бірінен соң бірі жеңді.
Dialogue: 0,0:03:57.86,0:03:59.44,Default,,0,0,0,,Тіссіз емессің бе?
Dialogue: 0,0:03:59.82,0:04:01.44,Default,,0,0,0,,(қатты дауыс)
Dialogue: 0,0:04:01.57,0:04:03.11,Default,,0,0,0,,Не дедіңіз!
Dialogue: 0,0:04:03.20,0:04:04.45,Default,,0,0,0,,Шайқас қазір басталады.
Dialogue: 0,0:04:04.61,0:04:06.95,Default,,0,0,0,,Иә! Сочо дұрыс айтады.
Dialogue: 0,0:04:07.08,0:04:09.29,Default,,0,0,0,,Бірінші шайқасқа қарап шешім қабылдамаңыз
Dialogue: 0,0:04:09.37,0:04:11.66,Default,,0,0,0,,Сочо үшін бар күшіңізді салыңыз
Dialogue: 0,0:04:12.41,0:04:15.88,Default,,0,0,0,,Қызыл жүз Айга Көңілімді қалдырма
Dialogue: 0,0:04:16.08,0:04:19.63,Default,,0,0,0,,Мен Лонгинус кубогының чемпионымен күресуге келдім.
Dialogue: 0,0:04:20.17,0:04:24.13,Default,,0,0,0,,Бұл мен бұрын көрген Луилерге ұқсамайды. Ол керемет күшті.
Dialogue: 0,0:04:25.01,0:04:27.39,Default,,0,0,0,,Бұл абсолютті патша.
Dialogue: 0,0:04:27.93,0:04:30.64,Default,,0,0,0,,Айға жігіт, өзіңді әлсіз сезініп тұрған жоқсың ба?
Dialogue: 0,0:04:30.77,0:04:35.02,Default,,0,0,0,,Қарсылас – Руи Ширасаги. Айға қанша күшті болса да...
Dialogue: 0,0:04:36.19,0:04:39.11,Default,,0,0,0,,Бұл әлі де алыс екенін білдіре ме?
Dialogue: 0,0:04:41.15,0:04:42.28,Default,,0,0,0,,Айга...
Dialogue: 0,0:04:44.36,0:04:47.57,Default,,0,0,0,,Айга! Шоғырлан!
Dialogue: 0,0:04:48.66,0:04:49.49,Default,,0,0,0,,Нару
Dialogue: 0,0:04:49.91,0:04:51.16,Default,,0,0,0,,Шоғырлану
Dialogue: 0,0:04:51.45,0:04:53.33,Default,,0,0,0,,Қой, Айға!
Dialogue: 0,0:04:53.45,0:05:00.30,Default,,0,0,0,,Фокус! шоғырлану! шоғырлану!
Dialogue: 0,0:05:02.46,0:05:03.59,Default,,0,0,0,,Не керек, Крюгер мырза?
Dialogue: 0,0:05:05.09,0:05:08.55,Default,,0,0,0,,Айғаның жақсы достары көп сияқты.
Dialogue: 0,0:05:10.05,0:05:12.85,Default,,0,0,0,,Дұрыс, мен ойымды жинақтауым керек.
Dialogue: 0,0:05:14.73,0:05:15.56,Default,,0,0,0,,Жарайды, бұл сынақ деп аталғанымен,
Dialogue: 0,0:05:16.23,0:05:17.06,Default,,0,0,0,,Ах
Dialogue: 0,0:05:21.40,0:05:22.65,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:05:40.04,0:05:41.79,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:05:42.38,0:05:45.67,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:05:47.59,0:05:48.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:48.59,0:05:51.05,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:05:51.30,0:05:52.31,Default,,0,0,0,,Жарайды, бұл сынақ деп аталғанымен,
Dialogue: 0,0:05:52.51,0:05:53.35,Default,,0,0,0,,Бұл бітсе, бірдеңе жейміз бе? Егер қаласаң, көңіліңді көтерейін.
Dialogue: 0,0:05:53.47,0:05:56.27,Default,,0,0,0,,Қызыл жүз Айганың ату формасы өзгерді.
Dialogue: 0,0:05:56.60,0:05:58.14,Default,,0,0,0,,Бұл өте жылдам түсіру.
Dialogue: 0,0:05:58.35,0:06:00.15,Default,,0,0,0,,Қарғыс атсын, Ахиллес!
Dialogue: 0,0:06:00.35,0:06:02.82,Default,,0,0,0,,Лонгинустың ашулы қудалауы
Dialogue: 0,0:06:03.44,0:06:04.48,Default,,0,0,0,,<Ал сол адам маған айтты>
Dialogue: 0,0:06:04.69,0:06:07.70,Default,,0,0,0,,Лонгинус, саған қарсы шыққан кез келген адамды қуып жібер.
Dialogue: 0,0:06:09.03,0:06:10.99,Default,,0,0,0,,Лонгинусты ұрыңыз!
Dialogue: 0,0:06:13.66,0:06:16.12,Default,,0,0,0,,Лонгинус Ахиллесті басып алады
Dialogue: 0,0:06:16.58,0:06:17.41,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:17.91,0:06:20.88,Default,,0,0,0,,Бұл абсолютті чемпион Ширасадиджо Луи
Dialogue: 0,0:06:21.00,0:06:22.71,Default,,0,0,0,,Хахаха!
Dialogue: 0,0:06:22.84,0:06:24.88,Default,,0,0,0,,Бар болғаны, Қызыл жүз Айга
Dialogue: 0,0:06:25.46,0:06:27.92,Default,,0,0,0,,Мен мұнда тыныс алуды тоқтатамын.
Dialogue: 0,0:06:29.05,0:06:32.39,Default,,0,0,0,,Әлі жоқ. Ахиллестің күші қалады.
Dialogue: 0,0:06:37.10,0:06:38.02,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:06:40.14,0:06:42.02,Default,,0,0,0,,Z Buster!
Dialogue: 0,0:06:54.37,0:06:55.20,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:07:01.12,0:07:03.54,Default,,0,0,0,,Z Ахиллес аяқталды
Dialogue: 0,0:07:03.67,0:07:05.38,Default,,0,0,0,,Қызыл жүз Айга 1 ұпай
Dialogue: 0,0:07:05.63,0:07:08.13,Default,,0,0,0,,(Лэйди тауы) Хмм? Не айтқың келеді?
Dialogue: 0,0:07:08.42,0:07:12.64,Default,,0,0,0,,Уау! Абсолютті чемпион Ширасадиджо Луиден-
Dialogue: 0,0:07:12.76,0:07:16.10,Default,,0,0,0,,Қызыл жүз Айга 1 ұпайға ие болды.
Dialogue: 0,0:07:16.43,0:07:17.31,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:17.43,0:07:19.14,Default,,0,0,0,,Айга Керемет!
Dialogue: 0,0:07:19.39,0:07:22.15,Default,,0,0,0,,Сен күшейдің, балам.
Dialogue: 0,0:07:22.27,0:07:24.61,Default,,0,0,0,,Бірақ неге ату формасын өзгерттіңіз?
Dialogue: 0,0:07:24.98,0:07:26.57,Default,,0,0,0,,Күшті соққыны қалай ұру керек -
Dialogue: 0,0:07:26.69,0:07:29.49,Default,,0,0,0,,Ақыл мен денені босаңсу керек
Dialogue: 0,0:07:29.94,0:07:32.24,Default,,0,0,0,,Айга Луидің пішініне қарайды...
Dialogue: 0,0:07:33.07,0:07:35.83,Default,,0,0,0,,Мен мұны бейсаналы түрде түсіндім.
Dialogue: 0,0:07:36.33,0:07:37.70,Default,,0,0,0,,Айғаны да істеме.
Dialogue: 0,0:07:37.83,0:07:40.29,Default,,0,0,0,,Сіз Луидің ату формасына қалай еліктейсіз?
Dialogue: 0,0:07:40.54,0:07:41.66,Default,,0,0,0,,Мен оны көшірмедім.
Dialogue: 0,0:07:42.17,0:07:43.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:43.21,0:07:47.67,Default,,0,0,0,,Айға өзінің қарсыластарының жақсы қасиеттерін табиғи түрде пайдалана алады.
Dialogue: 0,0:07:48.25,0:07:50.47,Default,,0,0,0,,Бұл Айғаның күші.
Dialogue: 0,0:07:51.22,0:07:53.13,Default,,0,0,0,,Хмф, мен сені мақтаймын.
Dialogue: 0,0:07:53.26,0:07:55.68,Default,,0,0,0,,Менен бір ұпайды тартып алуға қалай дәтің бар?
Dialogue: 0,0:07:56.14,0:07:58.60,Default,,0,0,0,,Келесі жолы мен оны жарылыспен шешемін.
Dialogue: 0,0:07:58.85,0:08:00.39,Default,,0,0,0,,<Ал сол адам маған айтты>
Dialogue: 0,0:08:01.02,0:08:02.10,Default,,0,0,0,,Қызықты
Dialogue: 0,0:08:02.23,0:08:05.10,Default,,0,0,0,,Міне, мен абсолютті чемпион айтамын.
Dialogue: 0,0:08:05.61,0:08:08.02,Default,,0,0,0,,Мен Super Zetsu, ең күшті және жеңілмейтінмін.
Dialogue: 0,0:08:08.77,0:08:10.99,Default,,0,0,0,,Қайсысы күшті екенін байқау.
Dialogue: 0,0:08:11.90,0:08:12.74,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:08:13.91,0:08:17.07,Default,,0,0,0,,Ақырында, бұл сіріңке сияқты сезіне бастады.
Dialogue: 0,0:08:17.70,0:08:21.08,Default,,0,0,0,,Бірақ Айга Луи-санды жеңе алмайды.
Dialogue: 0,0:08:22.29,0:08:25.17,Default,,0,0,0,,Бұл шайқастың нәтижесі...
Dialogue: 0,0:08:29.17,0:08:29.67,Default,,0,0,0,,Ах
Dialogue: 0,0:08:31.42,0:08:35.18,Default,,0,0,0,,Уау~ Мен оның осылайша құлағанын бірінші рет көруім.
Dialogue: 0,0:08:36.22,0:08:39.31,Default,,0,0,0,,Жаман нәрсе болмайды деп үміттенемін.
Dialogue: 0,0:08:46.48,0:08:50.15,Default,,0,0,0,,Бұл жолы мен бұрынғыдан әлдеқайда жылдам түсіремін.
Dialogue: 0,0:08:51.03,0:08:52.11,Default,,0,0,0,,Үшінші шайқас
Dialogue: 0,0:08:57.87,0:08:59.83,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:09:00.37,0:09:03.37,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:09:03.75,0:09:06.46,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:09:06.71,0:09:07.71,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:09:09.04,0:09:09.88,Default,,0,0,0,,Уф
Dialogue: 0,0:09:28.15,0:09:29.15,Default,,0,0,0,,Иә
Dialogue: 0,0:09:31.36,0:09:33.82,Default,,0,0,0,,Z Buster!
Dialogue: 0,0:09:34.53,0:09:39.70,Default,,0,0,0,,Оны азу тістеріңмен жарып таста, Айдаһар айқай!
Dialogue: 0,0:09:55.42,0:09:55.97,Default,,0,0,0,,Tsk
Dialogue: 0,0:09:56.51,0:09:59.18,Default,,0,0,0,,Бір мезетте жарылыс салу
Dialogue: 0,0:09:59.39,0:10:00.64,Default,,0,0,0,,Сурет салу?
Dialogue: 0,0:10:00.76,0:10:03.51,Default,,0,0,0,,Сәлем Айга! Мен келесі жолы жеңемін
Dialogue: 0,0:10:04.43,0:10:07.23,Default,,0,0,0,,Екеуі де бір-бірінен қайтпайды!
Dialogue: 0,0:10:07.35,0:10:10.90,Default,,0,0,0,,Бізді қандай аяқталу күтіп тұр?
Dialogue: 0,0:10:13.48,0:10:14.32,Default,,0,0,0,,Ах
Dialogue: 0,0:10:14.78,0:10:16.69,Default,,0,0,0,,Иә? Айга?
Dialogue: 0,0:10:16.90,0:10:18.07,Default,,0,0,0,,Хмм?
Dialogue: 0,0:10:20.11,0:10:22.28,Default,,0,0,0,,Неліктен ол жұмыс істемейді?
Dialogue: 0,0:10:24.54,0:10:28.00,Default,,0,0,0,,Уа, не болды? Акабане Айга біртүрлі әрекет етеді.
Dialogue: 0,0:10:28.12,0:10:30.08,Default,,0,0,0,,Жазатайым оқиға болды ма?
Dialogue: 0,0:10:30.46,0:10:33.29,Default,,0,0,0,,Айга уақыты! Асықпа!
Dialogue: 0,0:10:33.96,0:10:37.47,Default,,0,0,0,,Маған уақыт керек емес! Мен мұнымен жақсымын
Dialogue: 0,0:10:40.38,0:10:42.76,Default,,0,0,0,,Уақыт келді. Уақытты алайық.
Dialogue: 0,0:10:42.93,0:10:43.76,Default,,0,0,0,,Ах
Dialogue: 0,0:10:44.64,0:10:45.60,Default,,0,0,0,,Уақыт
Dialogue: 0,0:10:50.94,0:10:53.31,Default,,0,0,0,,Жарақат алған адамды жаншақтағаннан пайда жоқ
Dialogue: 0,0:10:56.40,0:10:57.99,Default,,0,0,0,,Оны тез емдеңіз.
Dialogue: 0,0:11:06.62,0:11:07.70,Default,,0,0,0,,Енді осында
Dialogue: 0,0:11:07.83,0:11:11.25,Default,,0,0,0,,Айга Акаба жарақатын емдеуге байланысты ойыннан уақытша кететін сияқты.
Dialogue: 0,0:11:11.37,0:11:14.34,Default,,0,0,0,,Матчты жалғастыра ала ма?
Dialogue: 0,0:11:14.96,0:11:17.71,Default,,0,0,0,,Бірдеңе болды.
Dialogue: 0,0:11:26.31,0:11:27.14,Default,,0,0,0,,Әй?
Dialogue: 0,0:11:32.73,0:11:33.73,Default,,0,0,0,,Оме
Dialogue: 0,0:11:38.03,0:11:39.65,Default,,0,0,0,,О, мен сенімдімін...
Dialogue: 0,0:11:44.95,0:11:47.66,Default,,0,0,0,,Егер есімде дұрыс болса, сіз phi сияқты бірдеңе айттыңыз.
Dialogue: 0,0:11:50.20,0:11:53.71,Default,,0,0,0,,Иық... Амансың ба?
Dialogue: 0,0:11:57.21,0:11:59.34,Default,,0,0,0,,Бұл маңызды емес, солай ма?
Dialogue: 0,0:12:00.59,0:12:04.14,Default,,0,0,0,,Егер сіз осы жерде бұзылсаңыз, бұл босқа кетеді.
Dialogue: 0,0:12:04.39,0:12:05.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:05.64,0:12:08.43,Default,,0,0,0,,Мен сенің күшті болғаныңды қалаймын.
Dialogue: 0,0:12:08.56,0:12:11.39,Default,,0,0,0,,Сіздің резонанстық күшіңіз қаншалықты күшті болады?
Dialogue: 0,0:12:11.52,0:12:12.73,Default,,0,0,0,,Мен білгім келеді
Dialogue: 0,0:12:13.35,0:12:14.90,Default,,0,0,0,,Резонанстық қуат?
Dialogue: 0,0:12:15.44,0:12:18.36,Default,,0,0,0,,Ахиллеспен резонанс тудырдың.
Dialogue: 0,0:12:18.69,0:12:20.28,Default,,0,0,0,,Не? Резонанс дегеніміз не?
Dialogue: 0,0:12:20.90,0:12:21.74,Default,,0,0,0,,Иә
Dialogue: 0,0:12:22.32,0:12:23.15,Default,,0,0,0,,Эй!
Dialogue: 0,0:12:24.45,0:12:26.32,Default,,0,0,0,,Ахиллестен сұраңыз
Dialogue: 0,0:12:33.46,0:12:34.50,Default,,0,0,0,,Ахиллес
Dialogue: 0,0:12:42.01,0:12:43.05,Default,,0,0,0,,Ахиллес…
Dialogue: 0,0:12:46.55,0:12:50.14,Default,,0,0,0,,Не істеуім керек?
Dialogue: 0,0:12:51.31,0:12:53.10,Default,,0,0,0,,Тым көп ойламаңыз
Dialogue: 0,0:12:54.06,0:12:54.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:56.73,0:12:58.19,Default,,0,0,0,,Тек маған қара
Dialogue: 0,0:13:00.15,0:13:01.28,Default,,0,0,0,,Ахиллес…
Dialogue: 0,0:13:07.03,0:13:08.49,Default,,0,0,0,,Жарайды, түсіндім.
Dialogue: 0,0:13:09.16,0:13:10.58,Default,,0,0,0,,Тек Ome қараңыз
Dialogue: 0,0:13:27.05,0:13:27.89,Default,,0,0,0,,Ах
Dialogue: 0,0:13:29.43,0:13:30.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:31.97,0:13:34.64,Default,,0,0,0,,Бұл не болды? Ол
Dialogue: 0,0:13:38.44,0:13:39.31,Default,,0,0,0,,Ах
Dialogue: 0,0:13:39.65,0:13:41.86,Default,,0,0,0,,Ауырмайды, мен қозғаламын.
Dialogue: 0,0:13:44.40,0:13:45.90,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:13:46.40,0:13:47.49,Default,,0,0,0,,Айға!
Dialogue: 0,0:13:47.57,0:13:49.49,Default,,0,0,0,,Сіз қалай ойлайсыз? Иығың қалай?
Dialogue: 0,0:13:50.20,0:13:51.08,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:13:51.53,0:13:53.33,Default,,0,0,0,,Матч жалғаса ала ма?
Dialogue: 0,0:13:56.12,0:13:57.33,Default,,0,0,0,,Ах... Эй!
Dialogue: 0,0:14:00.29,0:14:01.88,Default,,0,0,0,,Жақсысың ба, ол?
Dialogue: 0,0:14:02.42,0:14:05.38,Default,,0,0,0,,Бірақ иықтар ештеңеге ұқсамайды.
Dialogue: 0,0:14:07.30,0:14:12.14,Default,,0,0,0,,Жарайды! Қызыл жүз Айга шайқас сахнасына қайта оралды.
Dialogue: 0,0:14:12.26,0:14:14.85,Default,,0,0,0,,Жарақат жақсы сияқты.
Dialogue: 0,0:14:15.18,0:14:16.02,Default,,0,0,0,,Желдей жылдам шабуыл!
Dialogue: 0,0:14:16.48,0:14:18.19,Default,,0,0,0,,А, кеттік.
Dialogue: 0,0:14:18.69,0:14:21.69,Default,,0,0,0,,Бар күшіңмен кел, Қызыл жүз Айға
Dialogue: 0,0:14:24.78,0:14:25.86,Default,,0,0,0,,Айға ше?
Dialogue: 0,0:14:26.24,0:14:27.74,Default,,0,0,0,,Жарақат туралы уайымдамаңыз
Dialogue: 0,0:14:28.11,0:14:29.03,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:14:29.41,0:14:32.87,Default,,0,0,0,,Менің ойымша, ол күшті түсіру арқылы иығын бұрап қалды.
Dialogue: 0,0:14:33.16,0:14:35.33,Default,,0,0,0,,Мен енді ауырсынуды сезбейтін сияқтымын.
Dialogue: 0,0:14:37.29,0:14:38.25,Default,,0,0,0,,Иә
Dialogue: 0,0:14:38.66,0:14:42.33,Default,,0,0,0,,Мен алда не болады деп көбірек уайымдаймын.
Dialogue: 0,0:14:42.54,0:14:43.79,Default,,0,0,0,,Енді не болады?
Dialogue: 0,0:14:46.21,0:14:47.38,Default,,0,0,0,,Күшті шайқас
Dialogue: 0,0:14:51.01,0:14:53.47,Default,,0,0,0,,Ахиллес жүргізушісі төмендетілді.
Dialogue: 0,0:14:54.81,0:14:55.89,Default,,0,0,0,,Ахиллес
Dialogue: 0,0:14:57.31,0:14:59.27,Default,,0,0,0,,Тым көп ойламаңыз
Dialogue: 0,0:14:59.98,0:15:00.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:02.23,0:15:03.69,Default,,0,0,0,,Тек маған қара
Dialogue: 0,0:15:05.69,0:15:09.32,Default,,0,0,0,,Концентрат. Көбірек шоғырланыңыз.
Dialogue: 0,0:15:21.00,0:15:23.83,Default,,0,0,0,,Жарайды, кеттік, Ахиллес.
Dialogue: 0,0:15:24.17,0:15:26.09,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:15:26.63,0:15:29.72,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:15:30.30,0:15:32.84,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:15:33.43,0:15:34.09,Default,,0,0,0,,Мен анаммен де, әкеммен де сөйлестім—
Dialogue: 0,0:15:40.14,0:15:41.98,Default,,0,0,0,,Z Қорғаныс
Dialogue: 0,0:15:46.02,0:15:47.73,Default,,0,0,0,,Хахаха!
Dialogue: 0,0:15:47.94,0:15:51.74,Default,,0,0,0,,Лонгинус Бұл қорғанысты бұзыңыз.
Dialogue: 0,0:15:51.86,0:15:53.91,Default,,0,0,0,,Лонгинус Қаһарлы шабуыл!
Dialogue: 0,0:15:54.37,0:15:56.91,Default,,0,0,0,,Ах... қандай күш!
Dialogue: 0,0:15:57.58,0:16:00.04,Default,,0,0,0,,Луи мырза байыпты бола бастады.
Dialogue: 0,0:16:00.50,0:16:02.54,Default,,0,0,0,,Айға да бітті.
Dialogue: 0,0:16:06.96,0:16:09.76,Default,,0,0,0,,Лонгинус кубогының чемпионы әлі ме?
Dialogue: 0,0:16:11.09,0:16:15.34,Default,,0,0,0,,Ахиллес Лонгинустың шабуылынан дәрменсіз қаламын.
Dialogue: 0,0:16:15.47,0:16:18.51,Default,,0,0,0,,Оның жойылуы уақыт мәселесі ме?
Dialogue: 0,0:16:18.64,0:16:21.10,Default,,0,0,0,,Лонгинусты жалмау
Dialogue: 0,0:16:24.98,0:16:26.31,Default,,0,0,0,,Ахиллес!
Dialogue: 0,0:16:30.23,0:16:33.28,Default,,0,0,0,,♬~
Dialogue: 0,0:16:35.41,0:16:38.28,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:16:38.95,0:16:40.49,Default,,0,0,0,,Ох… Уф~ Мен қатты ашпын.
Dialogue: 0,0:16:46.29,0:16:49.21,Default,,0,0,0,,Өртен, Лонгинус!
Dialogue: 0,0:16:51.76,0:16:54.01,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:16:57.18,0:16:58.60,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:16:59.35,0:17:03.27,Default,,0,0,0,,Уау! Бұл үлкен шайқасқа айналды.
Dialogue: 0,0:17:03.39,0:17:06.56,Default,,0,0,0,,Лонгин мен Ахиллес орасан зор күшпен бір-бірімен соқтығысады
Dialogue: 0,0:17:07.15,0:17:11.40,Default,,0,0,0,,Екі тарап та шегінбейді, бұл өлімге әкелетін шайқас!
Dialogue: 0,0:17:11.69,0:17:13.53,Default,,0,0,0,,Бұзыңыз!
Dialogue: 0,0:17:15.65,0:17:16.49,Default,,0,0,0,,Ах
Dialogue: 0,0:17:19.58,0:17:24.71,Default,,0,0,0,,Қанды жаудырыңыз Қанды қоңырау!
Dialogue: 0,0:17:25.08,0:17:27.88,Default,,0,0,0,,Z Slash!
Dialogue: 0,0:17:33.67,0:17:34.59,Default,,0,0,0,,Уф
Dialogue: 0,0:17:35.63,0:17:36.63,Default,,0,0,0,,<Ал сол адам маған айтты>
Dialogue: 0,0:17:44.98,0:17:45.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:45.81,0:17:46.64,Default,,0,0,0,,Ха!
Dialogue: 0,0:17:47.77,0:17:49.69,Default,,0,0,0,,(шығанақтың құлаған дыбысы)
Dialogue: 0,0:17:56.15,0:17:57.03,Default,,0,0,0,,Не?
Dialogue: 0,0:17:57.65,0:18:00.24,Default,,0,0,0,,Z Ахиллестің жарылуы аяқталуы
Dialogue: 0,0:18:00.37,0:18:04.08,Default,,0,0,0,,Жеңімпаз: Қызыл жүз Айга 3-тен 2-ге дейінгі ұпаймен
Dialogue: 0,0:18:07.29,0:18:08.29,Default,,0,0,0,,М-м-мұнда… мұнда… мұнда… осы зат!
Dialogue: 0,0:18:10.50,0:18:13.34,Default,,0,0,0,,Мен Ширасаги Castle Louis командасын жеңдім.
Dialogue: 0,0:18:14.51,0:18:16.84,Default,,0,0,0,,(Лэйди тауы) Хмм? Не айтқың келеді?
Dialogue: 0,0:18:17.76,0:18:20.39,Default,,0,0,0,,Super Zetsu - ең күшті және жеңілмейтін!
Dialogue: 0,0:18:20.51,0:18:23.89,Default,,0,0,0,,(Бұрынғы Патша) Біз, Имантия, осы Дисбордта ең әлсізбіз.
Dialogue: 0,0:18:24.14,0:18:26.35,Default,,0,0,0,,Уау! Мен оны істедім!
Dialogue: 0,0:18:26.85,0:18:28.35,Default,,0,0,0,,Бұл керемет Айга
Dialogue: 0,0:18:28.52,0:18:31.23,Default,,0,0,0,,Айга! Құттықтаймыз!
Dialogue: 0,0:18:31.61,0:18:33.65,Default,,0,0,0,,Айға мен шынымен жеңдім
Dialogue: 0,0:18:33.77,0:18:35.73,Default,,0,0,0,,Бұл жігіт қаншалықты керемет?
Dialogue: 0,0:18:36.57,0:18:39.36,Default,,0,0,0,,Луис мырза... жоғалды.
Dialogue: 0,0:18:40.49,0:18:44.41,Default,,0,0,0,,Жоғалдың ба? Мен абсолютті чемпионмын ба?
Dialogue: 0,0:18:45.04,0:18:47.96,Default,,0,0,0,,Ширасаги Castle Louis, менімен жарыс!
Dialogue: 0,0:18:52.25,0:18:54.75,Default,,0,0,0,,Бұл қызықсыз.
Dialogue: 0,0:18:55.34,0:18:56.34,Default,,0,0,0,,О... не?
Dialogue: 0,0:18:56.71,0:18:58.09,Default,,0,0,0,,Сондай-ақ... тағы бір рет.
Dialogue: 0,0:18:58.30,0:18:59.22,Default,,0,0,0,,Сіз Титантардың бір-бірімен шайқасып жатқанын айтасыз ба?
Dialogue: 0,0:18:59.51,0:19:02.97,Default,,0,0,0,,Сіз бұл супер Zetsubei қолданбасын пайдаланудың қажеті жоқ.
Dialogue: 0,0:19:03.10,0:19:05.01,Default,,0,0,0,,Иә? Бұл нені білдіреді?
Dialogue: 0,0:19:06.43,0:19:07.27,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:19:08.64,0:19:11.27,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:19:13.94,0:19:14.77,Default,,0,0,0,,Луис
Dialogue: 0,0:19:15.61,0:19:19.40,Default,,0,0,0,,Ғажайып жараттың, Айға, мен сені мақтаймын.
Dialogue: 0,0:19:19.82,0:19:20.65,Default,,0,0,0,,Әй?
Dialogue: 0,0:19:21.24,0:19:23.66,Default,,0,0,0,,Мен сізге сыйлық ретінде деңгейлік чип беремін.
Dialogue: 0,0:19:24.99,0:19:25.83,Default,,0,0,0,,Әй?
Dialogue: 0,0:19:33.88,0:19:35.17,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:19:35.59,0:19:37.80,Default,,0,0,0,,Бұл менің сені қабылдағанымның дәлелі.
Dialogue: 0,0:19:38.13,0:19:39.92,Default,,0,0,0,,Бұл Омені жеңгеннің белгісі ме?
Dialogue: 0,0:19:40.22,0:19:42.80,Default,,0,0,0,,Бұл менің супер Цетсу, ең күшті және жеңілмейтінмін дегенді білдіреді.
Dialogue: 0,0:19:45.35,0:19:49.35,Default,,0,0,0,,Алаңдамаңыз. Ғажайып бір рет қана болады.
Dialogue: 0,0:19:50.56,0:19:51.94,Default,,0,0,0,,Бұл керемет емес
Dialogue: 0,0:19:52.56,0:19:55.52,Default,,0,0,0,,Келесі жолы мен де жеңемін!
Dialogue: 0,0:20:04.53,0:20:07.41,Default,,0,0,0,,Мен сені Луиді жеңгенің үшін мақтаймын.
Dialogue: 0,0:20:07.53,0:20:09.87,Default,,0,0,0,,Мені сондықтан шақырдың ба?
Dialogue: 0,0:20:10.54,0:20:12.92,Default,,0,0,0,,Саған телефон соққан мен емес едім.
Dialogue: 0,0:20:14.00,0:20:15.92,Default,,0,0,0,,Фениксті жандандыру
Dialogue: 0,0:20:16.46,0:20:18.13,Default,,0,0,0,,Фениксті тірілту керек пе?
Dialogue: 0,0:20:18.67,0:20:22.59,Default,,0,0,0,,Бұл жігіт күшті билерді жоюды асыға күтеді.
Dialogue: 0,0:20:22.72,0:20:23.55,Default,,0,0,0,,Не?
Dialogue: 0,0:20:24.09,0:20:28.47,Default,,0,0,0,,Лонгинус кубогын жеңіп алды, сонымен қатар Ширасаги Castle Louis командасын жеңді
Dialogue: 0,0:20:28.89,0:20:31.06,Default,,0,0,0,,Ахиллес неғұрлым күшті болса, соғұрлым көп...
Dialogue: 0,0:20:31.43,0:20:33.64,Default,,0,0,0,,Жоюға тұрарлық нәрсе
Dialogue: 0,0:20:34.14,0:20:37.23,Default,,0,0,0,,Ахиллес – ең күшті және жеңілмейтін Би.
Dialogue: 0,0:20:37.48,0:20:39.36,Default,,0,0,0,,Мынау желге қонбайды.
Dialogue: 0,0:20:43.36,0:20:46.62,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:20:46.95,0:20:49.83,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:20:49.95,0:20:51.12,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:20:55.42,0:20:56.79,Default,,0,0,0,,Жүр! Ахиллес!
Dialogue: 0,0:21:02.13,0:21:04.13,Default,,0,0,0,,Ахиллестің шабуылы нәтиже бермейді
Dialogue: 0,0:21:07.05,0:21:10.68,Default,,0,0,0,,Жарайды, мен саған Ахиллестің байыптылығын көрсетемін.
Dialogue: 0,0:21:11.01,0:21:13.81,Default,,0,0,0,,Z Buster!
Dialogue: 0,0:21:16.60,0:21:19.36,Default,,0,0,0,,Жарайсыңдар! Ах
Dialogue: 0,0:21:20.11,0:21:23.53,Default,,0,0,0,,Ол жарылып кетті. Не болып жатыр?
Dialogue: 0,0:21:25.45,0:21:26.36,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:27.20,0:21:29.74,Default,,0,0,0,,Сыртқы қабат жаңа ғана шығып кетті ме?
Dialogue: 0,0:21:34.41,0:21:37.29,Default,,0,0,0,,Феникс үзілісін жандандыру
Dialogue: 0,0:21:46.84,0:21:47.68,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:50.26,0:21:50.97,Default,,0,0,0,,Ha
Dialogue: 0,0:21:54.06,0:22:00.06,Default,,0,0,0,,♪~
Dialogue: 0,0:23:15.85,0:23:21.85,Default,,0,0,0,,~♪
Dialogue: 0,0:23:24.48,0:23:27.23,Default,,0,0,0,,Super Zetsu Awesome турнирі басталғалы тұр!
Dialogue: 0,0:23:27.40,0:23:30.70,Default,,0,0,0,,Үлкен кемеде саяхаттау кезіндегі шайқас.
Dialogue: 0,0:23:31.61,0:23:33.20,Default,,0,0,0,,Slingshock стадионы?
Dialogue: 0,0:23:33.28,0:23:34.74,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:23:35.08,0:23:37.24,Default,,0,0,0,,Жағдайлар ақылға сыймай тұр!
Dialogue: 0,0:23:38.33,0:23:40.41,Default,,0,0,0,,Келесі жолы «Beyblade Burst Super Zetsu»
Dialogue: 0,0:23:40.71,0:23:43.42,Default,,0,0,0,,"Тамаша саяхат! Жауынгерлік кеме круизі!!"
Dialogue: 0,0:23:43.58,0:23:45.54,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:45.84,0:23:47.63,Default,,0,0,0,,Бар, ат!
