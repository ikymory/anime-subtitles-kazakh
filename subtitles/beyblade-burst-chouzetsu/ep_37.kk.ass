Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.13,0:00:07.29,Default,,0,0,0,,Сиқырлы сарай Өлі Гран!
Dialogue: 0,0:00:08.25,0:00:11.38,Default,,0,0,0,,Сіз бұрын-соңды көрмеген супер шайқасқа тап боласыз.
Dialogue: 0,0:00:11.72,0:00:15.89,Default,,0,0,0,,Қорқынышты жау, Күшті би жолыңда тұр.
Dialogue: 0,0:00:17.55,0:00:21.89,Default,,0,0,0,,Challenge Challenge Challenge!
Dialogue: 0,0:00:22.14,0:00:25.98,Default,,0,0,0,,Оны жеңіп, ертең қолға ал
Dialogue: 0,0:00:26.23,0:00:29.98,Default,,0,0,0,,Сіз Бейблейдтің болашағысыз!
Dialogue: 0,0:00:32.90,0:00:36.74,Default,,0,0,0,,Өлі Грандта мен ақыры Жүректермен шайқастым.
Dialogue: 0,0:00:36.91,0:00:39.24,Default,,0,0,0,,Көптен күткен кек алу матчы!
Dialogue: 0,0:00:39.62,0:00:42.37,Default,,0,0,0,,Мен Ахиллеспін!
Dialogue: 0,0:00:42.50,0:00:45.50,Default,,0,0,0,,Уууу!
Dialogue: 0,0:00:45.92,0:00:48.50,Default,,0,0,0,,Міне! Бұл жақсы!
Dialogue: 0,0:00:48.63,0:00:52.63,Default,,0,0,0,,Мен сені және Ахиллесті құртамын!
Dialogue: 0,0:01:00.56,0:01:02.89,Default,,0,0,0,,Бірақ мен жеңілдім!
Dialogue: 0,0:01:03.18,0:01:05.44,Default,,0,0,0,,Бірақ сіз жеңілдіңіз, солай емес пе?
Dialogue: 0,0:01:05.56,0:01:06.94,Default,,0,0,0,,Шу!
Dialogue: 0,0:01:07.06,0:01:10.65,Default,,0,0,0,,Мен және Ахиллес одан сайын күшейе түсті.
Dialogue: 0,0:01:11.36,0:01:14.11,Default,,0,0,0,,Super Zetsu ең күшті және жеңілмейтін болады!
Dialogue: 0,0:01:14.82,0:01:18.99,Default,,0,0,0,,Ал Балто Super Z Valkyrie-мен Hearts-пен күреседі.
Dialogue: 0,0:01:19.16,0:01:22.08,Default,,0,0,0,,Бұл чемпиондық белбеу үшін титулдық матч.
Dialogue: 0,0:01:22.20,0:01:23.04,Default,,0,0,0,,(Танжиро) Бірақ құбыжықтар жалғыз жүруі керек еді ғой?
Dialogue: 0,0:01:25.79,0:01:28.54,Default,,0,0,0,,Уф... Super Z-Wing көрсетілмейді!
Dialogue: 0,0:01:36.72,0:01:38.13,Default,,0,0,0,,Уф!
Dialogue: 0,0:01:40.85,0:01:42.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:42.31,0:01:46.94,Default,,0,0,0,,Эй, эй! Бұл бұрынғы әлем чемпионы ма?
Dialogue: 0,0:01:47.06,0:01:49.06,Default,,0,0,0,,Көбірек көңіл көтерейік
Dialogue: 0,0:01:51.98,0:01:52.94,Default,,0,0,0,,Фу…
Dialogue: 0,0:01:53.07,0:01:54.86,Default,,0,0,0,,Өртеніп жатыр!
Dialogue: 0,0:01:55.86,0:01:58.36,Default,,0,0,0,,Ол... күлді!
Dialogue: 0,0:01:58.86,0:02:00.95,Default,,0,0,0,,Кеттік, жолдасым!
Dialogue: 0,0:02:02.33,0:02:05.45,Default,,0,0,0,,Хе! Мен сені құртамын.
Dialogue: 0,0:02:06.58,0:02:12.59,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:03:29.91,0:03:35.92,Default,,0,0,0,,~♪
Dialogue: 0,0:03:42.05,0:03:45.39,Default,,0,0,0,,Иә! Ұлдар мен қыздар!
Dialogue: 0,0:03:45.51,0:03:46.51,Default,,0,0,0,,Көңіліңіз толқып тұр ма?
Dialogue: 0,0:03:46.64,0:03:49.72,Default,,0,0,0,,Бұл өте қызықты!
Dialogue: 0,0:03:49.97,0:03:52.73,Default,,0,0,0,,Мені жылат! Алақай!
Dialogue: 0,0:03:53.23,0:03:55.98,Default,,0,0,0,,Біріншіден, Жүрек бір ұпаймен алға шығады
Dialogue: 0,0:03:56.11,0:03:57.98,Default,,0,0,0,,Бұл шайқаста үш ұпайлық жүйе бар.
Dialogue: 0,0:03:58.23,0:04:00.24,Default,,0,0,0,,Екінші шайқаста бірден шешім қабылдайсыз ба?
Dialogue: 0,0:04:00.36,0:04:02.11,Default,,0,0,0,,Чемпионның жүректері
Dialogue: 0,0:04:02.24,0:04:05.07,Default,,0,0,0,,Немесе оны үшінші шайқасқа өткізуге болады ма?
Dialogue: 0,0:04:05.20,0:04:07.49,Default,,0,0,0,,Челленджер Аои Балт
Dialogue: 0,0:04:07.91,0:04:11.37,Default,,0,0,0,,Енді осы шайқастың бір секундын жіберіп алмаңыз!
Dialogue: 0,0:04:11.87,0:04:13.67,Default,,0,0,0,,Жоғалтпа, Бар-нии!
Dialogue: 0,0:04:13.87,0:04:15.50,Default,,0,0,0,,Әлі алыс!
Dialogue: 0,0:04:16.79,0:04:17.75,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:04:18.25,0:04:21.51,Default,,0,0,0,,Бұл жолы мен шешемін! Super Z-ояту!
Dialogue: 0,0:04:22.92,0:04:24.34,Default,,0,0,0,,Жұмсақ…
Dialogue: 0,0:04:24.88,0:04:27.30,Default,,0,0,0,,Келесі жолы мен бұл жігітпен ойнаймын.
Dialogue: 0,0:04:28.10,0:04:29.43,Default,,0,0,0,,Қорғаныс режимі!
Dialogue: 0,0:04:29.97,0:04:34.94,Default,,0,0,0,,Super Z оятуын аяқтасаңыз да, әлсіз шабуыл өлімге әкеледі.
Dialogue: 0,0:04:35.40,0:04:36.73,Default,,0,0,0,,Балт-сенпай...
Dialogue: 0,0:04:38.19,0:04:39.23,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:04:39.61,0:04:41.48,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:04:41.99,0:04:45.07,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:04:45.57,0:04:48.45,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:04:48.70,0:04:49.66,Default,,0,0,0,,(Изуку) Ах! (Гран Торино) Уа!
Dialogue: 0,0:04:51.24,0:04:53.12,Default,,0,0,0,,Қарғыс атсын... Super Z-Wing пайда болмайды!
Dialogue: 0,0:04:59.63,0:05:01.59,Default,,0,0,0,,Уф! Куууу...
Dialogue: 0,0:05:03.42,0:05:04.38,Default,,0,0,0,,Аһ!
Dialogue: 0,0:05:06.05,0:05:07.01,Default,,0,0,0,,Біріншіден, қарсыласты гайка кілтесімен есінен тандырарлықтай ұрудың қаталдығы
Dialogue: 0,0:05:07.14,0:05:10.14,Default,,0,0,0,,Super Z Valkyrie екінші шайқаста батыл шабуыл жасайды!
Dialogue: 0,0:05:11.76,0:05:14.27,Default,,0,0,0,,Хаха~! Бұл дәреже ме?
Dialogue: 0,0:05:14.39,0:05:16.14,Default,,0,0,0,,Мені ренжітпе!
Dialogue: 0,0:05:16.60,0:05:17.98,Default,,0,0,0,,Жүр!
Dialogue: 0,0:05:18.10,0:05:20.86,Default,,0,0,0,,Super Valkyrie Slash!
Dialogue: 0,0:05:22.15,0:05:23.82,Default,,0,0,0,,Ааааааа!
Dialogue: 0,0:05:25.15,0:05:26.32,Default,,0,0,0,,Жылы!
Dialogue: 0,0:05:26.45,0:05:29.95,Default,,0,0,0,,Толығырақ! Көбірек!
Dialogue: 0,0:05:30.45,0:05:32.70,Default,,0,0,0,,Бұл қауіпті емес пе? Ол
Dialogue: 0,0:05:32.83,0:05:36.83,Default,,0,0,0,,Жүректер Бейдің мұңын өз дертіндей сезеді.
Dialogue: 0,0:05:37.62,0:05:41.00,Default,,0,0,0,,Неғұрлым ауырса, соғұрлым намыстанады.
Dialogue: 0,0:05:42.21,0:05:45.84,Default,,0,0,0,,Бұл жүректер үшін соңғы резонанс.
Dialogue: 0,0:05:46.84,0:05:47.88,Default,,0,0,0,,Соңғы…
Dialogue: 0,0:05:49.05,0:05:50.22,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:53.56,0:05:57.02,Default,,0,0,0,,Дұрыс айтасыңдар! Көбірек кел!
Dialogue: 0,0:06:01.23,0:06:02.98,Default,,0,0,0,,Мен шешемін.
Dialogue: 0,0:06:03.11,0:06:06.44,Default,,0,0,0,,Супер реактивті түсірілім!
Dialogue: 0,0:06:07.57,0:06:09.36,Default,,0,0,0,,Уф… қабырғаларым мен аяқтарым сынған
Dialogue: 0,0:06:11.49,0:06:13.12,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:06:13.45,0:06:17.12,Default,,0,0,0,,Ояну! Валькирия!
Dialogue: 0,0:06:17.25,0:06:18.66,Default,,0,0,0,,Хе... (Жүректер) Хе.
Dialogue: 0,0:06:21.04,0:06:22.75,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:22.88,0:06:26.13,Default,,0,0,0,,Бұл қайсысы? Бір уақытта дерлік!
Dialogue: 0,0:06:29.93,0:06:32.64,Default,,0,0,0,,Super Z Valkyrie аяқталды
Dialogue: 0,0:06:33.68,0:06:35.60,Default,,0,0,0,,1-1 тармақтар
Dialogue: 0,0:06:35.81,0:06:37.43,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:06:37.56,0:06:39.77,Default,,0,0,0,,Сенгісіз!
Dialogue: 0,0:06:39.89,0:06:42.06,Default,,0,0,0,,Байланыстағы айырмашылыққа байланысты аяқталды!
Dialogue: 0,0:06:42.19,0:06:44.69,Default,,0,0,0,,Барт Аои бұрынғы чемпионның ерік-жігерін көрсетті
Dialogue: 0,0:06:44.82,0:06:45.65,Default,,0,0,0,,Иә
Dialogue: 0,0:06:45.98,0:06:47.15,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:06:47.28,0:06:48.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:48.53,0:06:50.20,Default,,0,0,0,,Балто күткендей
Dialogue: 0,0:06:50.66,0:06:54.12,Default,,0,0,0,,Сіз ұпайларды Super Z оятусыз алдыңыз ба?
Dialogue: 0,0:06:54.24,0:06:55.87,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:06:56.24,0:06:58.37,Default,,0,0,0,,Ия, ағайын!
Dialogue: 0,0:06:58.50,0:06:59.87,Default,,0,0,0,,Балто-сенпай күткендей!
Dialogue: 0,0:07:00.25,0:07:02.00,Default,,0,0,0,,Күткендей, мықты бол!
Dialogue: 0,0:07:02.13,0:07:03.38,Default,,0,0,0,,Чо Пани
Dialogue: 0,0:07:04.00,0:07:07.09,Default,,0,0,0,,Бірақ бұл аз ғана жеңіс болды.
Dialogue: 0,0:07:07.88,0:07:11.63,Default,,0,0,0,,Super Z-Ояну... Бұл жақында қалды!
Dialogue: 0,0:07:12.01,0:07:15.01,Default,,0,0,0,,Әй, қызық болып барады емес пе?
Dialogue: 0,0:07:15.14,0:07:17.01,Default,,0,0,0,,Келесі жолы, соққымен шешіңіз.
Dialogue: 0,0:07:17.68,0:07:18.52,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:19.23,0:07:21.89,Default,,0,0,0,,Тыңдаңдар, балалар!
Dialogue: 0,0:07:22.02,0:07:23.60,Default,,0,0,0,,Менің тарапымнан.
Dialogue: 0,0:07:23.73,0:07:25.98,Default,,0,0,0,,Мен үшін ең керемет шоу
Dialogue: 0,0:07:26.11,0:07:27.90,Default,,0,0,0,,Бұл осы жерден!
Dialogue: 0,0:07:28.03,0:07:29.82,Default,,0,0,0,,Жұмсақ…
Dialogue: 0,0:07:29.94,0:07:33.49,Default,,0,0,0,,Барто Аои Уақыт өте өкінішті!
Dialogue: 0,0:07:33.61,0:07:36.74,Default,,0,0,0,,Мен сені жарқыратып жіберемін!
Dialogue: 0,0:07:37.29,0:07:41.12,Default,,0,0,0,,Я~ Бум!
Dialogue: 0,0:07:41.75,0:07:45.13,Default,,0,0,0,,Үлкен отшашумен аяқтаңыз!
Dialogue: 0,0:07:45.25,0:07:48.13,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:07:48.59,0:07:50.67,Default,,0,0,0,,Даусыңыз төмен!
Dialogue: 0,0:07:50.97,0:07:53.59,Default,,0,0,0,,Балалар, оны көргілерің келеді!
Dialogue: 0,0:07:53.72,0:07:56.47,Default,,0,0,0,,Иә! (2 адам) Жүрек, жүректер!
Dialogue: 0,0:07:56.60,0:08:00.48,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:08:00.60,0:08:02.73,Default,,0,0,0,,Жүректер! Жүректер!
Dialogue: 0,0:08:03.23,0:08:04.48,Default,,0,0,0,,Сіз ұтыласыз ба?
Dialogue: 0,0:08:04.60,0:08:06.61,Default,,0,0,0,,Балто! Балтық!
Dialogue: 0,0:08:06.73,0:08:08.65,Default,,0,0,0,,Сіз мені естисіз деп ойлаймын.
Dialogue: 0,0:08:09.11,0:08:11.61,Default,,0,0,0,,Жоқ. Сенің сезімдерің жеткізілгеніне сенімдімін!
Dialogue: 0,0:08:11.99,0:08:15.11,Default,,0,0,0,,Бірақ сіз шынымен жеңе аласыз ба?
Dialogue: 0,0:08:15.74,0:08:17.58,Default,,0,0,0,,Жеңіске жететінімізге сенімдімін!
Dialogue: 0,0:08:17.74,0:08:18.62,Default,,0,0,0,,О
Dialogue: 0,0:08:18.87,0:08:21.87,Default,,0,0,0,,Барыңыз~ Бал-ни!
Dialogue: 0,0:08:22.16,0:08:24.12,Default,,0,0,0,,Балто! Балтық!
Dialogue: 0,0:08:24.46,0:08:28.13,Default,,0,0,0,,Балто! Балтық! Балтық!
Dialogue: 0,0:08:29.21,0:08:30.21,Default,,0,0,0,,Валькирия
Dialogue: 0,0:08:37.60,0:08:40.64,Default,,0,0,0,,Саған күшімізді көрсетейік!
Dialogue: 0,0:08:42.52,0:08:43.35,Default,,0,0,0,,Хмм
Dialogue: 0,0:08:47.81,0:08:48.65,Default,,0,0,0,,♬ Ора ора ора ора, ора ора ора ора
Dialogue: 0,0:08:49.19,0:08:50.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:50.53,0:08:53.28,Default,,0,0,0,,Ол тағы да күлді.
Dialogue: 0,0:08:54.82,0:08:55.70,Default,,0,0,0,,Үшінші шайқас
Dialogue: 0,0:08:57.95,0:09:00.45,Default,,0,0,0,,Хаха~! махаббат!
Dialogue: 0,0:09:00.83,0:09:03.41,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасаймын, досым!
Dialogue: 0,0:09:03.70,0:09:05.41,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:09:06.00,0:09:09.34,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:09:09.46,0:09:12.05,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:09:12.26,0:09:13.34,Default,,0,0,0,,Хааах!
Dialogue: 0,0:09:15.55,0:09:16.43,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:16.93,0:09:19.68,Default,,0,0,0,,Жақсы! Super Z-Wing шықты!
Dialogue: 0,0:09:24.02,0:09:26.52,Default,,0,0,0,,Бұл керемет Z-ояну!
Dialogue: 0,0:09:26.98,0:09:28.77,Default,,0,0,0,,Әй, бұл қызық.
Dialogue: 0,0:09:30.02,0:09:30.86,Default,,0,0,0,,Біріншіден, қарсыласты гайка кілтесімен есінен тандырарлықтай ұрудың қаталдығы
Dialogue: 0,0:09:31.32,0:09:34.78,Default,,0,0,0,,Super Z Valkyrie тағы да батыл шабуыл жасайды!
Dialogue: 0,0:09:34.99,0:09:36.86,Default,,0,0,0,,Уф! Жоқ!
Dialogue: 0,0:09:37.11,0:09:38.41,Default,,0,0,0,,Міне...
Dialogue: 0,0:09:38.53,0:09:39.62,Default,,0,0,0,,Міне!
Dialogue: 0,0:09:42.20,0:09:45.08,Default,,0,0,0,,Керемет, Барто Аои!
Dialogue: 0,0:09:45.71,0:09:49.08,Default,,0,0,0,,Мен саған осыдан бірнеше есе көп азап беремін.
Dialogue: 0,0:09:49.58,0:09:51.79,Default,,0,0,0,,Жұмсақ…
Dialogue: 0,0:09:51.96,0:09:57.09,Default,,0,0,0,,Мен Аидпын!
Dialogue: 0,0:10:01.68,0:10:03.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:04.02,0:10:04.85,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:09.90,0:10:14.03,Default,,0,0,0,,Ажал! Өлі гравитация!
Dialogue: 0,0:10:14.61,0:10:16.03,Default,,0,0,0,,О, құдайым!
Dialogue: 0,0:10:16.15,0:10:20.32,Default,,0,0,0,,Валькириге Аидтың оқ жаудыруы мүмкін бе?
Dialogue: 0,0:10:20.53,0:10:21.53,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:21.66,0:10:22.83,Default,,0,0,0,,Бұл ақылсыз!
Dialogue: 0,0:10:25.83,0:10:29.12,Default,,0,0,0,,Super Z-ояну? Мені күлдірмеңіз
Dialogue: 0,0:10:29.58,0:10:31.46,Default,,0,0,0,,Валькириді жою
Dialogue: 0,0:10:31.58,0:10:33.34,Default,,0,0,0,,Бұл менмін!
Dialogue: 0,0:10:33.71,0:10:35.21,Default,,0,0,0,,Сізге
Dialogue: 0,0:10:35.34,0:10:38.09,Default,,0,0,0,,Мен жеңілуге ​​шыдай алмаймын!
Dialogue: 0,0:10:38.22,0:10:39.88,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:10:44.47,0:10:45.77,Default,,0,0,0,,(Валкирияның көршісі)
Dialogue: 0,0:10:48.14,0:10:50.06,Default,,0,0,0,,Міне!
Dialogue: 0,0:10:55.57,0:10:56.65,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:56.78,0:10:59.49,Default,,0,0,0,,Маған рұқсат етіңіз!
Dialogue: 0,0:10:59.61,0:11:03.49,Default,,0,0,0,,Керемет түсірілім!
Dialogue: 0,0:11:11.21,0:11:13.92,Default,,0,0,0,,Уууу!
Dialogue: 0,0:11:18.30,0:11:20.17,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:11:20.55,0:11:21.93,Default,,0,0,0,,Ажал!
Dialogue: 0,0:11:31.85,0:11:34.15,Default,,0,0,0,,(Эндевор) Менің ұлым, Шото, All Might-ты басып озуға міндетті.
Dialogue: 0,0:11:34.90,0:11:36.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:45.37,0:11:49.25,Default,,0,0,0,,Күте тұрыңыз... Super Z Valkyrie Burst Finish
Dialogue: 0,0:11:49.70,0:11:51.37,Default,,0,0,0,,3-1 тармақтар
Dialogue: 0,0:11:51.62,0:11:54.13,Default,,0,0,0,,Жеңімпаз Барто Аои!
Dialogue: 0,0:11:54.25,0:11:55.25,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:11:55.38,0:11:58.46,Default,,0,0,0,,Burst Burst Burst~!
Dialogue: 0,0:11:58.59,0:12:01.51,Default,,0,0,0,,Балт Аои чемпионды қайтарып алды!
Dialogue: 0,0:12:02.30,0:12:03.43,Default,,0,0,0,,Уф!
Dialogue: 0,0:12:11.39,0:12:13.64,Default,,0,0,0,,Иә, иә! Бал-ни!
Dialogue: 0,0:12:14.77,0:12:17.15,Default,,0,0,0,,Иә! Бұл чемпион!
Dialogue: 0,0:12:17.52,0:12:19.11,Default,,0,0,0,,Мен жасадым...
Dialogue: 0,0:12:19.23,0:12:20.65,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:20.78,0:12:22.90,Default,,0,0,0,,Не? Ах...
Dialogue: 0,0:12:23.53,0:12:25.45,Default,,0,0,0,,Мұны істеме, Барто
Dialogue: 0,0:12:25.95,0:12:28.62,Default,,0,0,0,,Сәлем! Хаха
Dialogue: 0,0:12:28.74,0:12:32.04,Default,,0,0,0,,Blue Super Wonder Boy Balt Aoi
Dialogue: 0,0:12:32.16,0:12:34.29,Default,,0,0,0,,Бір қызығы, мен чемпиондық белбеуімді қайтарып алдым!
Dialogue: 0,0:12:34.75,0:12:37.25,Default,,0,0,0,,Құттықтаймыз!
Dialogue: 0,0:12:37.38,0:12:39.63,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:12:40.13,0:12:41.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:44.05,0:12:46.51,Default,,0,0,0,,Бұл менің Бейблейдім!
Dialogue: 0,0:12:46.64,0:12:47.51,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:12:48.89,0:12:49.72,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:53.52,0:12:54.35,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:13:00.98,0:13:03.11,Default,,0,0,0,,Жеңіске жетпесем де...
Dialogue: 0,0:13:04.03,0:13:05.32,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:13:05.78,0:13:07.45,Default,,0,0,0,,Көршілер көріп қалса немесе сынып кетсе, апат болар еді.
Dialogue: 0,0:13:13.29,0:13:15.58,Default,,0,0,0,,Неге сонша мұңайып көрінесің?
Dialogue: 0,0:13:15.83,0:13:16.96,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:23.42,0:13:24.88,Default,,0,0,0,,Үш адам болайық
Dialogue: 0,0:13:25.05,0:13:25.88,Default,,0,0,0,,О
Dialogue: 0,0:13:28.89,0:13:30.30,Default,,0,0,0,,Аме-чан сонда ма?
Dialogue: 0,0:13:32.97,0:13:33.97,Default,,0,0,0,,Хаа…
Dialogue: 0,0:13:35.18,0:13:36.10,Default,,0,0,0,,Барт…
Dialogue: 0,0:13:36.23,0:13:37.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:37.31,0:13:40.77,Default,,0,0,0,,Сол сәтте неге күлдің?
Dialogue: 0,0:13:41.94,0:13:43.90,Default,,0,0,0,,Уау, мен шымшып қалдым.
Dialogue: 0,0:13:45.44,0:13:46.32,Default,,0,0,0,,♬ Ора ора ора ора, ора ора ора ора
Dialogue: 0,0:13:47.07,0:13:51.33,Default,,0,0,0,,Міне, бұл қызықты емес пе?
Dialogue: 0,0:13:51.45,0:13:52.58,Default,,0,0,0,,Сәлем? Фубуки
Dialogue: 0,0:13:52.70,0:13:53.54,Default,,0,0,0,,О
Dialogue: 0,0:13:53.83,0:13:55.50,Default,,0,0,0,,Мені де бұрышқа мәжбүрлегенде
Dialogue: 0,0:13:55.70,0:13:58.17,Default,,0,0,0,,Керісінше, жүрегім жиі соғатын сәттер болады.
Dialogue: 0,0:13:58.71,0:14:02.71,Default,,0,0,0,,Кейде мен: «Жасай берейік!» деп ойлайтынмын.
Dialogue: 0,0:14:03.59,0:14:05.59,Default,,0,0,0,,Теме толқып тұрған жоқ па?
Dialogue: 0,0:14:07.22,0:14:10.18,Default,,0,0,0,,Жарайды... Мен оның істеп жатқанына сенімдімін.
Dialogue: 0,0:14:11.47,0:14:15.18,Default,,0,0,0,,Мен олай көрмеймін.
Dialogue: 0,0:14:15.64,0:14:16.73,Default,,0,0,0,,Ха!
Dialogue: 0,0:14:17.23,0:14:20.90,Default,,0,0,0,,Сіз тек қарсыласыңызды жоюды ойладыңыз.
Dialogue: 0,0:14:21.40,0:14:24.44,Default,,0,0,0,,Уууу!
Dialogue: 0,0:14:25.11,0:14:27.40,Default,,0,0,0,,Уууу!
Dialogue: 0,0:14:37.96,0:14:38.87,Default,,0,0,0,,Оны қалай тоқтатамыз?
Dialogue: 0,0:14:40.37,0:14:41.33,Default,,0,0,0,,Не...
Dialogue: 0,0:14:43.13,0:14:44.92,Default,,0,0,0,,Бұл не болды?
Dialogue: 0,0:14:45.05,0:14:45.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:48.88,0:14:51.30,Default,,0,0,0,,Шынымды айтсам, Теме мықты.
Dialogue: 0,0:14:51.47,0:14:53.26,Default,,0,0,0,,Бұл өте тітіркендіргіш
Dialogue: 0,0:14:53.51,0:14:54.35,Default,,0,0,0,,Бірақ…
Dialogue: 0,0:14:55.22,0:14:58.60,Default,,0,0,0,,Сонда да мен Темемен күресуді тоқтата алмаймын.
Dialogue: 0,0:14:59.77,0:15:01.15,Default,,0,0,0,,Неге екенін білесіз бе?
Dialogue: 0,0:15:02.15,0:15:03.65,Default,,0,0,0,,Себебі бұл қызықты.
Dialogue: 0,0:15:04.06,0:15:05.07,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:05.65,0:15:08.03,Default,,0,0,0,,Мен жеңілген кезде қатты күйзелемін.
Dialogue: 0,0:15:08.15,0:15:11.07,Default,,0,0,0,,Сонымен, келесі жолы қалай жеңеміз?
Dialogue: 0,0:15:11.28,0:15:13.20,Default,,0,0,0,,Осы жігітпен ойланыңыз
Dialogue: 0,0:15:13.66,0:15:15.78,Default,,0,0,0,,Бұл өте қызықты!
Dialogue: 0,0:15:17.62,0:15:20.83,Default,,0,0,0,,Теме айттым ғой, солай ма? «Мен Ахиллеспін»
Dialogue: 0,0:15:21.17,0:15:24.29,Default,,0,0,0,,Бірақ әйтеуір менің ойымша, бұл басқаша.
Dialogue: 0,0:15:26.17,0:15:28.05,Default,,0,0,0,,Айырмашылығы неде?
Dialogue: 0,0:15:28.51,0:15:30.26,Default,,0,0,0,,Түсінбейсіз бе?
Dialogue: 0,0:15:30.38,0:15:32.22,Default,,0,0,0,,Мен және Ахиллес біртұтаспыз.
Dialogue: 0,0:15:32.34,0:15:33.68,Default,,0,0,0,,Сондықтан мықты бол!
Dialogue: 0,0:15:34.01,0:15:36.89,Default,,0,0,0,,Бізді Ome et al. қарағанда үлкен резонанс байланыстырады!
Dialogue: 0,0:15:37.89,0:15:38.77,Default,,0,0,0,,Айга!
Dialogue: 0,0:15:39.39,0:15:42.77,Default,,0,0,0,,Шынымен, не болды?
Dialogue: 0,0:15:42.98,0:15:44.81,Default,,0,0,0,,Мен айтамын!
Dialogue: 0,0:15:44.98,0:15:48.23,Default,,0,0,0,,Сочо мен Фубукиді неге түсіне алмаймын?
Dialogue: 0,0:15:50.11,0:15:51.32,Default,,0,0,0,,Қоғамдық махаббат хатынан бері —
Dialogue: 0,0:15:51.45,0:15:53.11,Default,,0,0,0,,А... бұл туралы айтатын ештеңе жоқ!
Dialogue: 0,0:15:53.24,0:15:54.11,Default,,0,0,0,,Айга!
Dialogue: 0,0:16:03.58,0:16:04.83,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:16:05.00,0:16:07.29,Default,,0,0,0,,Неліктен ешкім түсінбейді?
Dialogue: 0,0:16:08.46,0:16:09.30,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:13.68,0:16:14.80,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:15.30,0:16:17.68,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:16:18.56,0:16:19.68,Default,,0,0,0,,Phi!
Dialogue: 0,0:16:21.43,0:16:24.69,Default,,0,0,0,,Сіздің резонанстық қуат осымен шектелген бе?
Dialogue: 0,0:16:25.06,0:16:26.40,Default,,0,0,0,,Не!
Dialogue: 0,0:16:26.90,0:16:29.69,Default,,0,0,0,,Мен оны асыға күттім, бірақ көңілім қалды.
Dialogue: 0,0:16:29.82,0:16:32.07,Default,,0,0,0,,Шулы! Әлі алда!
Dialogue: 0,0:16:32.19,0:16:34.70,Default,,0,0,0,,Мен одан да күшті боламын!
Dialogue: 0,0:16:35.57,0:16:38.66,Default,,0,0,0,,Олай болса соңғы шешімді шығарайық.
Dialogue: 0,0:16:41.29,0:16:43.50,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:05.56,0:17:07.73,Default,,0,0,0,,Жарайды, шабуыл жасайық.
Dialogue: 0,0:17:08.11,0:17:09.11,Default,,0,0,0,,Теме т.б.
Dialogue: 0,0:17:09.23,0:17:11.23,Default,,0,0,0,,Мен сені тағы бір ұрамын!
Dialogue: 0,0:17:22.04,0:17:25.29,Default,,0,0,0,,Менің ойымша, бұл Феникс туралы.
Dialogue: 0,0:17:25.91,0:17:29.21,Default,,0,0,0,,Отбасыма…
Dialogue: 0,0:17:38.09,0:17:39.30,Default,,0,0,0,,Оларды осы жаққа жіберіңізші.
Dialogue: 0,0:17:44.64,0:17:47.98,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:17:48.19,0:17:50.81,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:17:51.48,0:17:52.40,Default,,0,0,0,,Әй!
Dialogue: 0,0:17:56.65,0:17:59.32,Default,,0,0,0,,Жүр! Ахиллес!
Dialogue: 0,0:17:59.74,0:18:00.57,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:02.70,0:18:04.33,Default,,0,0,0,,Қалай болғанда да, бастайық!
Dialogue: 0,0:18:05.25,0:18:08.62,Default,,0,0,0,,Әлі олай емес!
Dialogue: 0,0:18:10.21,0:18:14.00,Default,,0,0,0,,Көбірек, көбірек!
Dialogue: 0,0:18:15.01,0:18:18.13,Default,,0,0,0,,Super Z түсірілімі!
Dialogue: 0,0:18:20.93,0:18:22.76,Default,,0,0,0,,Әлі жоқ!
Dialogue: 0,0:18:26.98,0:18:31.02,Default,,0,0,0,,Дұрыс, маған резонанс күшіңізді көбірек көрсетіңіз.
Dialogue: 0,0:18:31.40,0:18:34.36,Default,,0,0,0,,Уууу!
Dialogue: 0,0:18:38.45,0:18:40.32,Default,,0,0,0,,Ооо...
Dialogue: 0,0:18:41.07,0:18:42.03,Default,,0,0,0,,Әй!
Dialogue: 0,0:18:42.41,0:18:45.79,Default,,0,0,0,,Мен Ахиллеспін!
Dialogue: 0,0:18:47.79,0:18:49.54,Default,,0,0,0,,Бұзыңыз!
Dialogue: 0,0:18:51.17,0:18:52.21,Default,,0,0,0,,Міне — жер астында.
Dialogue: 0,0:19:03.60,0:19:05.72,Default,,0,0,0,,Зеницу, мені ойлама.
Dialogue: 0,0:19:07.02,0:19:09.85,Default,,0,0,0,,Уууу!
Dialogue: 0,0:19:15.73,0:19:16.73,Default,,0,0,0,,Қызықты...
Dialogue: 0,0:19:17.61,0:19:19.53,Default,,0,0,0,,Сіз күткендей қызықсыз.
Dialogue: 0,0:19:21.24,0:19:24.07,Default,,0,0,0,,Уууу!
Dialogue: 0,0:19:25.83,0:19:28.29,Default,,0,0,0,,Уууу!
Dialogue: 0,0:19:28.41,0:19:30.29,Default,,0,0,0,,Маған көбірек көңіл көтеруіңізді өтінемін!
Dialogue: 0,0:19:31.00,0:19:32.00,Default,,0,0,0,,Феникс!
Dialogue: 0,0:19:34.21,0:19:35.13,Default,,0,0,0,,(Феникс Роар)
Dialogue: 0,0:19:43.26,0:19:44.09,Default,,0,0,0,,Әй!
Dialogue: 0,0:19:48.39,0:19:49.98,Default,,0,0,0,,Сотталыңыз!
Dialogue: 0,0:19:50.27,0:19:51.52,Default,,0,0,0,,(Феникс Роар)
Dialogue: 0,0:19:55.86,0:19:58.28,Default,,0,0,0,,Armor Press құралын жандандырыңыз!
Dialogue: 0,0:20:07.08,0:20:08.49,Default,,0,0,0,,Уф! Ааа...
Dialogue: 0,0:20:18.67,0:20:20.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:21.34,0:20:23.88,Default,,0,0,0,,Айга~!
Dialogue: 0,0:20:25.43,0:20:26.26,Default,,0,0,0,,Ха…
Dialogue: 0,0:20:27.47,0:20:29.06,Default,,0,0,0,,(шығанақтың құлаған дыбысы)
Dialogue: 0,0:20:33.69,0:20:36.10,Default,,0,0,0,,Неге... талқандалған
Dialogue: 0,0:20:36.23,0:20:37.06,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:20:42.24,0:20:44.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:48.24,0:20:50.29,Default,,0,0,0,,Мен сенімен ойнауды аяқтадым.
Dialogue: 0,0:21:07.68,0:21:08.85,Default,,0,0,0,,Ахиллес
Dialogue: 0,0:21:27.11,0:21:27.95,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:33.66,0:21:34.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:45.55,0:21:50.30,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:55.43,0:22:01.44,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:23:18.93,0:23:24.94,Default,,0,0,0,,~♪
Dialogue: 0,0:23:26.07,0:23:29.36,Default,,0,0,0,,Мен енді не істерімді білмеймін.
Dialogue: 0,0:23:29.61,0:23:32.57,Default,,0,0,0,,Сондай кездерде Шу маған күш береді.
Dialogue: 0,0:23:32.78,0:23:35.12,Default,,0,0,0,,Егер ол бұзылса, оны жөндей аласыз.
Dialogue: 0,0:23:35.45,0:23:38.95,Default,,0,0,0,,Мен Ахиллеспен қарым-қатынасымды міндетті түрде қалпына келтіремін!
Dialogue: 0,0:23:39.08,0:23:41.12,Default,,0,0,0,,Мен берілмеймін!
Dialogue: 0,0:23:41.25,0:23:43.50,Default,,0,0,0,,Келесі жолы «Beyblade Burst Super Zetsu»
Dialogue: 0,0:23:43.63,0:23:46.29,Default,,0,0,0,,"Жарылғыш туу! Super Z Ахиллес!!"
Dialogue: 0,0:23:46.42,0:23:47.96,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:48.09,0:23:49.71,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:51.21,0:23:57.21,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory