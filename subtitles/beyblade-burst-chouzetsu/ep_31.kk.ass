Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.71,0:00:04.00,Default,,0,0,0,,Бейблейд
Dialogue: 0,0:00:04.12,0:00:08.50,Default,,0,0,0,,Мықты болуды мақсат еткен ұлдардың арманының жемісі.
Dialogue: 0,0:00:08.92,0:00:12.38,Default,,0,0,0,,Енді супер Цетсу дәуірі басталады.
Dialogue: 0,0:00:12.51,0:00:16.76,Default,,0,0,0,,Металл сауытыңызды киіңіз де, Беймен шытырман оқиғаға аттаныңыз!
Dialogue: 0,0:00:16.89,0:00:19.22,Default,,0,0,0,,Әлем чемпионы болуды мақсат етіңіз!
Dialogue: 0,0:00:19.35,0:00:23.60,Default,,0,0,0,,Super Zetsu Super Zetsu Super Zetsu!
Dialogue: 0,0:00:24.23,0:00:27.86,Default,,0,0,0,,Ең күшті және жеңілмейтін атағын алатын адам сенсің!
Dialogue: 0,0:00:33.82,0:00:38.32,Default,,0,0,0,,Аид! Өлі гравитация!
Dialogue: 0,0:00:39.53,0:00:40.62,Default,,0,0,0,,Мен жүректермен біргемін
Dialogue: 0,0:00:40.74,0:00:43.71,Default,,0,0,0,,Әлем чемпионы атағы үшін күресті
Dialogue: 0,0:00:44.04,0:00:46.04,Default,,0,0,0,,Ахиллес~!
Dialogue: 0,0:00:50.04,0:00:50.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:51.59,0:00:52.42,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:00:52.55,0:00:54.05,Default,,0,0,0,,Жүректері күшті болды
Dialogue: 0,0:00:54.30,0:00:57.55,Default,,0,0,0,,Чемпиондық белбеуімді тартып алды.
Dialogue: 0,0:00:58.01,0:00:59.97,Default,,0,0,0,,Мұның соңы осылай бола ма?
Dialogue: 0,0:01:00.18,0:01:02.47,Default,,0,0,0,,Мен қарқынды жаттығуларды бастадым.
Dialogue: 0,0:01:02.60,0:01:06.02,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:01:13.44,0:01:16.24,Default,,0,0,0,,Аа... бәрібір өзгердің.
Dialogue: 0,0:01:16.61,0:01:19.37,Default,,0,0,0,,Иә? Ештеңе өзгерген жоқ.
Dialogue: 0,0:01:19.49,0:01:21.12,Default,,0,0,0,,Тек күшейе түсті
Dialogue: 0,0:01:21.49,0:01:23.37,Default,,0,0,0,,Мен одан да күшті боламын!
Dialogue: 0,0:01:24.50,0:01:26.37,Default,,0,0,0,,Сіз қаншалықты алысқа баруға дайынсыз?
Dialogue: 0,0:01:26.62,0:01:29.17,Default,,0,0,0,,Мен кез келген жерге барамын
Dialogue: 0,0:01:29.92,0:01:34.46,Default,,0,0,0,,Қанша жүрсем де күшейемін!
Dialogue: 0,0:01:35.63,0:01:41.64,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:02:58.30,0:03:04.30,Default,,0,0,0,,~♪
Dialogue: 0,0:03:14.02,0:03:14.86,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:15.77,0:03:17.28,Default,,0,0,0,,Келесі келіңіз
Dialogue: 0,0:03:19.65,0:03:21.57,Default,,0,0,0,,Цк, тағы бір рет... келесі жолы.
Dialogue: 0,0:03:21.70,0:03:22.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:25.95,0:03:26.78,Default,,0,0,0,,Келесі
Dialogue: 0,0:03:28.16,0:03:29.00,Default,,0,0,0,,Келесі
Dialogue: 0,0:03:30.12,0:03:30.96,Default,,0,0,0,,Келесі!
Dialogue: 0,0:03:32.46,0:03:33.46,Default,,0,0,0,,Келесі!
Dialogue: 0,0:03:35.54,0:03:37.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:37.34,0:03:40.38,Default,,0,0,0,,Айга... бұл шынымен де керемет
Dialogue: 0,0:03:40.67,0:03:42.26,Default,,0,0,0,,Бұл өте күшті.
Dialogue: 0,0:03:42.38,0:03:43.59,Default,,0,0,0,,Супер панель
Dialogue: 0,0:03:45.39,0:03:46.93,Default,,0,0,0,,Бұлай болуы мүмкін емес.
Dialogue: 0,0:03:47.43,0:03:49.02,Default,,0,0,0,,Мынадай...
Dialogue: 0,0:03:50.35,0:03:53.10,Default,,0,0,0,,Сол кездегі сезім мүлде келмейді.
Dialogue: 0,0:03:54.94,0:03:59.36,Default,,0,0,0,,Жарайсыңдар, балалар, шындап келіңдер!
Dialogue: 0,0:04:00.61,0:04:03.20,Default,,0,0,0,,Біз әрқашан байсалдымыз!
Dialogue: 0,0:04:03.32,0:04:05.99,Default,,0,0,0,,Айга тым күшті.
Dialogue: 0,0:04:06.24,0:04:07.08,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:04:07.87,0:04:09.99,Default,,0,0,0,,Жарайды, ары қарай жалғастырайық.
Dialogue: 0,0:04:10.12,0:04:11.87,Default,,0,0,0,,Келесі Кім?
Dialogue: 0,0:04:12.50,0:04:13.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:13.92,0:04:15.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:15.38,0:04:17.25,Default,,0,0,0,,Қарғыс атсын... О!
Dialogue: 0,0:04:17.42,0:04:19.50,Default,,0,0,0,,Бұл не, балалар?
Dialogue: 0,0:04:20.17,0:04:23.01,Default,,0,0,0,,Не болды? Ол
Dialogue: 0,0:04:24.38,0:04:27.39,Default,,0,0,0,,Әй, эй, басталғалы тұрған жоқ па?
Dialogue: 0,0:04:28.05,0:04:29.72,Default,,0,0,0,,Hearts баспасөз конференциясы
Dialogue: 0,0:04:29.85,0:04:30.68,Default,,0,0,0,,Гррр…
Dialogue: 0,0:04:36.65,0:04:39.32,Default,,0,0,0,,Жарайсыңдар ұлдар мен қыздар!
Dialogue: 0,0:04:39.44,0:04:40.65,Default,,0,0,0,,Көңілдің ба?
Dialogue: 0,0:04:40.78,0:04:42.53,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:04:42.65,0:04:46.45,Default,,0,0,0,,Біріншіден, әлем біріншілігін бірден жеңіп алған Жүректерге.
Dialogue: 0,0:04:46.57,0:04:47.91,Default,,0,0,0,,Әңгімелесейік... Ах.
Dialogue: 0,0:04:48.45,0:04:49.83,Default,,0,0,0,,Хаха~
Dialogue: 0,0:04:49.95,0:04:52.54,Default,,0,0,0,,Сіз қарап отырсыз ба? Қызыл жүз Айга
Dialogue: 0,0:04:52.87,0:04:53.71,Default,,0,0,0,,Уф
Dialogue: 0,0:04:54.29,0:04:58.00,Default,,0,0,0,,Super Zetsu ең күшті... Солай ма?
Dialogue: 0,0:04:58.13,0:05:00.38,Default,,0,0,0,,Ха, тым жылы.
Dialogue: 0,0:05:00.50,0:05:02.63,Default,,0,0,0,,Бұл тіпті қызық болмады.
Dialogue: 0,0:05:04.30,0:05:07.97,Default,,0,0,0,,Хмм... бааааай!
Dialogue: 0,0:05:08.09,0:05:09.97,Default,,0,0,0,,О~
Dialogue: 0,0:05:10.85,0:05:14.56,Default,,0,0,0,,Сіз Super Zetsu-ның ең әлсізі және ең қабілетсізісіз.
Dialogue: 0,0:05:14.81,0:05:17.15,Default,,0,0,0,,Аняр!
Dialogue: 0,0:05:17.56,0:05:19.02,Default,,0,0,0,,Мен жеңілмеймін
Dialogue: 0,0:05:19.15,0:05:19.98,Default,,0,0,0,,Бұл дәл «қуалап ұстау» ойыны сияқты.
Dialogue: 0,0:05:20.11,0:05:22.82,Default,,0,0,0,,Мен туылғаннан бері шешілді.
Dialogue: 0,0:05:22.94,0:05:24.28,Default,,0,0,0,,Жұмсақ…
Dialogue: 0,0:05:24.40,0:05:25.78,Default,,0,0,0,,Әй?
Dialogue: 0,0:05:26.95,0:05:29.91,Default,,0,0,0,,Сәлем! Оны жоймаңыз, тем
Dialogue: 0,0:05:32.33,0:05:33.41,Default,,0,0,0,,Ахиллес
Dialogue: 0,0:05:34.58,0:05:37.04,Default,,0,0,0,,Келесі жолы мен міндетті түрде жеңемін
Dialogue: 0,0:05:37.87,0:05:38.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:39.42,0:05:41.92,Default,,0,0,0,,Эй... Эй, Айга
Dialogue: 0,0:05:43.17,0:05:44.01,Default,,0,0,0,,Әй?
Dialogue: 0,0:05:44.38,0:05:46.05,Default,,0,0,0,,Не болды?
Dialogue: 0,0:05:46.17,0:05:49.05,Default,,0,0,0,,Бұл біраз уақыттан бері біртүрлі болды.
Dialogue: 0,0:05:49.34,0:05:50.34,Default,,0,0,0,,Мен?
Dialogue: 0,0:05:50.51,0:05:53.51,Default,,0,0,0,,А... Айтпақшы, бұл Айға емес...
Dialogue: 0,0:05:53.85,0:05:55.85,Default,,0,0,0,,О? Сіз не айттыңыз?
Dialogue: 0,0:05:55.98,0:05:57.14,Default,,0,0,0,,Бұл менмін! Ах...
Dialogue: 0,0:05:58.02,0:06:00.90,Default,,0,0,0,,Эй, тыныштал! Не асығып тұрсың?
Dialogue: 0,0:06:01.27,0:06:02.57,Default,,0,0,0,,Шу!
Dialogue: 0,0:06:03.07,0:06:05.07,Default,,0,0,0,,Оның Омеге қатысы жоқ!
Dialogue: 0,0:06:05.65,0:06:06.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:07.65,0:06:08.57,Default,,0,0,0,,Ах
Dialogue: 0,0:06:08.86,0:06:09.70,Default,,0,0,0,,Тақырып
Dialogue: 0,0:06:10.49,0:06:12.12,Default,,0,0,0,,Бұл маңызды емес...
Dialogue: 0,0:06:12.49,0:06:13.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:15.45,0:06:16.62,Default,,0,0,0,,Айга О?
Dialogue: 0,0:06:18.92,0:06:20.00,Default,,0,0,0,,Фубуки
Dialogue: 0,0:06:20.37,0:06:24.13,Default,,0,0,0,,Менің ойымша, сіз тым қобалжығансыз.
Dialogue: 0,0:06:24.55,0:06:27.01,Default,,0,0,0,,Жоқ, бұл дұрыс емес!
Dialogue: 0,0:06:27.13,0:06:32.14,Default,,0,0,0,,Бірақ қазіргі Айгаға жылдамдықты өзгерту қажет болуы мүмкін.
Dialogue: 0,0:06:32.76,0:06:36.18,Default,,0,0,0,,Аа, мүмкін бұл сіздің көңіл-күйіңізді жақсартады.
Dialogue: 0,0:06:36.39,0:06:37.31,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:38.68,0:06:40.14,Default,,0,0,0,,Иә! (Сочо) А...
Dialogue: 0,0:06:40.60,0:06:43.56,Default,,0,0,0,,Эй, егер сіз қарқынды өзгерткіңіз келсе...
Dialogue: 0,0:06:44.73,0:06:47.74,Default,,0,0,0,,Барлығына! Бұл күріш!
Dialogue: 0,0:06:48.15,0:06:48.99,Default,,0,0,0,,(айқай)
Dialogue: 0,0:06:52.82,0:06:54.03,Default,,0,0,0,,(мен~)
Dialogue: 0,0:06:54.37,0:06:56.08,Default,,0,0,0,,(Коккоко~!)
Dialogue: 0,0:06:57.37,0:06:59.21,Default,,0,0,0,,Ой
Dialogue: 0,0:06:59.33,0:07:01.54,Default,,0,0,0,,О, Оме және т.б.
Dialogue: 0,0:07:02.50,0:07:06.63,Default,,0,0,0,,Тоқта, күт, үрейленбе, тамақ көп.
Dialogue: 0,0:07:07.88,0:07:09.63,Default,,0,0,0,,Қазірдің өзінде~ Хахаха!
Dialogue: 0,0:07:09.76,0:07:11.59,Default,,0,0,0,,Айга! Сенімен бәрі жақсы ма?
Dialogue: 0,0:07:12.47,0:07:16.97,Default,,0,0,0,,Ахаха, қытықтап жатыр емес пе? Тоқта!
Dialogue: 0,0:07:17.47,0:07:18.60,Default,,0,0,0,,Айга...
Dialogue: 0,0:07:18.93,0:07:20.14,Default,,0,0,0,,Түсінемін, түсінемін.
Dialogue: 0,0:07:20.27,0:07:21.10,Default,,0,0,0,,Хехе
Dialogue: 0,0:07:23.73,0:07:26.36,Default,,0,0,0,,Қайтарыңыз! Мінеки біз!
Dialogue: 0,0:07:26.73,0:07:29.36,Default,,0,0,0,,Жарайды, жарайды, жарайды...
Dialogue: 0,0:07:30.19,0:07:32.91,Default,,0,0,0,,Өйткені, Айға осылай болуы керек.
Dialogue: 0,0:07:33.03,0:07:34.20,Default,,0,0,0,,Хехе
Dialogue: 0,0:07:39.33,0:07:41.08,Default,,0,0,0,,Көп тамақтаныңыз
Dialogue: 0,0:07:42.46,0:07:43.29,Default,,0,0,0,,Ах
Dialogue: 0,0:07:49.30,0:07:51.72,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:07:55.97,0:07:56.80,Default,,0,0,0,,Эй
Dialogue: 0,0:07:58.22,0:07:59.27,Default,,0,0,0,,Иә.
Dialogue: 0,0:08:00.35,0:08:01.35,Default,,0,0,0,,Осымен
Dialogue: 0,0:08:02.10,0:08:04.90,Default,,0,0,0,,Дәл қазір...
Dialogue: 0,0:08:06.36,0:08:07.77,Default,,0,0,0,,Окабе?
Dialogue: 0,0:08:08.40,0:08:09.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:11.53,0:08:14.03,Default,,0,0,0,,Эй, бұл туралы уайымдама.
Dialogue: 0,0:08:15.74,0:08:16.66,Default,,0,0,0,,Эй
Dialogue: 0,0:08:17.16,0:08:19.16,Default,,0,0,0,,Қанағаттанбаймыз ба?
Dialogue: 0,0:08:19.54,0:08:20.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:22.75,0:08:23.75,Default,,0,0,0,,Таку
Dialogue: 0,0:08:25.00,0:08:27.21,Default,,0,0,0,,Тек айтқыңыз келген нәрсені айтыңыз.
Dialogue: 0,0:08:27.59,0:08:28.42,Default,,0,0,0,,Әй?
Dialogue: 0,0:08:28.67,0:08:31.96,Default,,0,0,0,,Есіңде ме? Шака не айтты
Dialogue: 0,0:08:32.76,0:08:34.01,Default,,0,0,0,,«Ақымақ бол»
Dialogue: 0,0:08:36.64,0:08:38.39,Default,,0,0,0,,Қажетсіз нәрселер туралы ойламаңыз
Dialogue: 0,0:08:39.47,0:08:44.19,Default,,0,0,0,,Менің ойымша, бұл сіздің қалауыңыз бойынша әрекет ете алатыныңызды білдіреді.
Dialogue: 0,0:08:44.35,0:08:45.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:47.36,0:08:50.98,Default,,0,0,0,,Әлде Темені қызықтыратын гала ма?
Dialogue: 0,0:08:51.36,0:08:54.74,Default,,0,0,0,,Біз онша қауіпті емеспіз.
Dialogue: 0,0:08:59.20,0:09:01.41,Default,,0,0,0,,Жүректерден жеңілгенімізбен
Dialogue: 0,0:09:02.08,0:09:05.83,Default,,0,0,0,,Мен жақын арада резонанс деп аталатын нәрсені түсінетін сияқтымын.
Dialogue: 0,0:09:07.00,0:09:08.92,Default,,0,0,0,,Егер ол мінсіз болса
Dialogue: 0,0:09:09.59,0:09:12.34,Default,,0,0,0,,Мен одан да күшті бола алатынымды сезінемін.
Dialogue: 0,0:09:13.30,0:09:14.88,Default,,0,0,0,,Мен жай ғана...
Dialogue: 0,0:09:15.68,0:09:18.14,Default,,0,0,0,,Тек күшті бол!
Dialogue: 0,0:09:23.27,0:09:26.85,Default,,0,0,0,,Бұған ренжіме, Барса!
Dialogue: 0,0:09:28.35,0:09:29.19,Default,,0,0,0,,Әй?
Dialogue: 0,0:09:30.19,0:09:34.65,Default,,0,0,0,,Темені қалай күшейтуге болатынын бірге ойланайық
Dialogue: 0,0:09:34.82,0:09:37.07,Default,,0,0,0,,Мен де күшейемін деп үміттенемін.
Dialogue: 0,0:09:37.66,0:09:39.32,Default,,0,0,0,,Сочо
Dialogue: 0,0:09:39.45,0:09:40.53,Default,,0,0,0,,Қатаң болса да
Dialogue: 0,0:09:41.20,0:09:45.41,Default,,0,0,0,,Мен нақты ештеңе ойлай алмаймын!
Dialogue: 0,0:09:45.54,0:09:47.87,Default,,0,0,0,,Иә? Міне бітті!
Dialogue: 0,0:09:48.96,0:09:52.67,Default,,0,0,0,,Поо! Хахаха...
Dialogue: 0,0:09:52.80,0:09:56.22,Default,,0,0,0,,Ой… Бұл сәл ағаттық болды.
Dialogue: 0,0:09:56.76,0:09:58.47,Default,,0,0,0,,Ах
Dialogue: 0,0:09:58.84,0:10:00.76,Default,,0,0,0,,О, тағы бір толтыруды қалайсыз ба?
Dialogue: 0,0:10:05.22,0:10:07.98,Default,,0,0,0,,Ах Ахиллес
Dialogue: 0,0:10:12.77,0:10:15.11,Default,,0,0,0,,Одан да күшті болайық
Dialogue: 0,0:10:15.32,0:10:16.32,Default,,0,0,0,,Бірге
Dialogue: 0,0:10:16.44,0:10:17.28,Default,,0,0,0,,(айқай)
Dialogue: 0,0:10:17.65,0:10:18.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:20.57,0:10:22.62,Default,,0,0,0,,Күшті бол
Dialogue: 0,0:10:22.83,0:10:25.70,Default,,0,0,0,,Сіз өте күшті болдыңыз!
Dialogue: 0,0:10:26.08,0:10:27.08,Default,,0,0,0,,Мен
Dialogue: 0,0:10:27.29,0:10:29.33,Default,,0,0,0,,(қорыққан жылау)
Dialogue: 0,0:10:29.71,0:10:30.71,Default,,0,0,0,,Сіз...
Dialogue: 0,0:10:35.00,0:10:36.30,Default,,0,0,0,,А... Айга?
Dialogue: 0,0:10:37.01,0:10:37.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:40.43,0:10:41.26,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:44.89,0:10:45.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:47.64,0:10:48.48,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:10:49.14,0:10:50.77,Default,,0,0,0,,Эй!Күте тұрыңыз!
Dialogue: 0,0:10:50.90,0:10:51.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:56.36,0:10:59.24,Default,,0,0,0,,Хуаншан, мен ол туралы сұрайын.
Dialogue: 0,0:10:59.82,0:11:02.07,Default,,0,0,0,,О? Сіз не айттыңыз?
Dialogue: 0,0:11:02.95,0:11:04.37,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:11:04.49,0:11:06.62,Default,,0,0,0,,Мүмкін мен тым көп ойлап тұрған шығармын, бірақ
Dialogue: 0,0:11:07.08,0:11:10.21,Default,,0,0,0,,Осыны айтып тұрсыз ба?
Dialogue: 0,0:11:19.17,0:11:21.97,Default,,0,0,0,,Түсіндім, Айғаның резонанс...
Dialogue: 0,0:11:22.26,0:11:23.09,Default,,0,0,0,,Иә
Dialogue: 0,0:11:23.55,0:11:27.35,Default,,0,0,0,,Шу мырза уайымдаған шығар.
Dialogue: 0,0:11:28.43,0:11:30.14,Default,,0,0,0,,Сіз дұрыс шығарсыз.
Dialogue: 0,0:11:32.19,0:11:33.31,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:11:42.57,0:11:44.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:57.50,0:11:58.63,Default,,0,0,0,,Who?
Dialogue: 0,0:12:00.42,0:12:01.42,Default,,0,0,0,,(айқай)
Dialogue: 0,0:12:02.22,0:12:03.84,Default,,0,0,0,,Хехе
Dialogue: 0,0:12:03.97,0:12:06.64,Default,,0,0,0,,Мен қатысуды өлтірдім деп ойладым.
Dialogue: 0,0:12:07.39,0:12:08.97,Default,,0,0,0,,Тегін Де Ла Хойя
Dialogue: 0,0:12:09.60,0:12:12.35,Default,,0,0,0,,Бұл жерде ақылды ұшқыр ұстайтын не?
Dialogue: 0,0:12:12.77,0:12:16.11,Default,,0,0,0,,Одан да биік белестерді көздеу... солай ма?
Dialogue: 0,0:12:17.11,0:12:20.28,Default,,0,0,0,,Бұл дәл Blader айнасы.
Dialogue: 0,0:12:20.40,0:12:22.61,Default,,0,0,0,,Хехе, түбінің астында.
Dialogue: 0,0:12:23.86,0:12:25.61,Default,,0,0,0,,Кайл Хаким?
Dialogue: 0,0:12:25.74,0:12:27.07,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:12:27.66,0:12:31.95,Default,,0,0,0,,Сәлеметсіз бе, менімен шайқасқыңыз келе ме?
Dialogue: 0,0:12:32.79,0:12:35.46,Default,,0,0,0,,Сен де маған келдің ғой.
Dialogue: 0,0:12:36.00,0:12:38.17,Default,,0,0,0,,Жарайды, жасайық.
Dialogue: 0,0:12:39.88,0:12:41.51,Default,,0,0,0,,Гейстфафнир
Dialogue: 0,0:12:42.13,0:12:45.05,Default,,0,0,0,,Оның шын мәнін анықтаймыз.
Dialogue: 0,0:12:46.34,0:12:47.89,Default,,0,0,0,,Көргіңіз келсе...
Dialogue: 0,0:12:48.93,0:12:50.31,Default,,0,0,0,,Ашық. Кіріңіз.
Dialogue: 0,0:12:55.60,0:12:58.81,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:12:59.44,0:13:01.65,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:13:01.86,0:13:02.74,Default,,0,0,0,,Уф!
Dialogue: 0,0:13:07.82,0:13:08.66,Default,,0,0,0,,Хехехе
Dialogue: 0,0:13:09.37,0:13:11.66,Default,,0,0,0,,Бұл жақсы кадр ма?
Dialogue: 0,0:13:12.24,0:13:16.33,Default,,0,0,0,,Жақсы. Мен деректерді дұрыс аламын.
Dialogue: 0,0:13:22.63,0:13:27.09,Default,,0,0,0,,Сіз шабуылдарды қабылдау арқылы күшіңізді арттыратын типсіз бе? Хехе
Dialogue: 0,0:13:27.55,0:13:30.22,Default,,0,0,0,,Бұл менің шығанағым үшін мағынасыз.
Dialogue: 0,0:13:30.68,0:13:31.51,Default,,0,0,0,,Меніңше... олар әлі өздерін жинастыра алмай, қиналып жатыр.
Dialogue: 0,0:13:32.47,0:13:33.47,Default,,0,0,0,,Cerbeus!
Dialogue: 0,0:13:34.27,0:13:36.64,Default,,0,0,0,,Жүр! Тозақтың күзетшісі!
Dialogue: 0,0:13:37.39,0:13:39.52,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:13:41.94,0:13:43.48,Default,,0,0,0,,Тізбекті қорғау!
Dialogue: 0,0:13:45.36,0:13:49.03,Default,,0,0,0,,Шабуыл серіппе арқылы жойылды ма? Бұл қызық.
Dialogue: 0,0:13:49.53,0:13:51.41,Default,,0,0,0,,Бұл біршама еркіндік.
Dialogue: 0,0:13:51.78,0:13:55.33,Default,,0,0,0,,Ал, енді шешейік.
Dialogue: 0,0:13:57.46,0:13:58.92,Default,,0,0,0,,Қайдағы сөз, сен аман-есенсің.
Dialogue: 0,0:14:03.63,0:14:04.59,Default,,0,0,0,,Не?
Dialogue: 0,0:14:05.05,0:14:07.01,Default,,0,0,0,,Геист есептегіші
Dialogue: 0,0:14:23.44,0:14:26.19,Default,,0,0,0,,Міне, мынандай нәрсе.
Dialogue: 0,0:14:26.57,0:14:29.45,Default,,0,0,0,,Гейстфафнир Бұл үлкен шығанақ сияқты...
Dialogue: 0,0:14:29.57,0:14:31.62,Default,,0,0,0,,Өзіңіз айтқандай...
Dialogue: 0,0:14:32.07,0:14:33.62,Default,,0,0,0,,«Төменгі жағында»
Dialogue: 0,0:14:35.83,0:14:37.29,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:14:37.71,0:14:41.29,Default,,0,0,0,,Бейблейд тек жеңу сияқты жақсы... иә?
Dialogue: 0,0:14:41.83,0:14:44.80,Default,,0,0,0,,Сен, бұл қызық па?
Dialogue: 0,0:14:45.13,0:14:46.13,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:48.63,0:14:49.93,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:14:50.43,0:14:52.09,Default,,0,0,0,,Осылай көп айтылды...
Dialogue: 0,0:14:53.76,0:14:56.27,Default,,0,0,0,,Мен үндемейтін адам емеспін.
Dialogue: 0,0:14:57.14,0:14:58.43,Default,,0,0,0,,Сен асырап алатын балалар санын көбейту керек дедің, бірақ бұл – басты себеп емес шығар?
Dialogue: 0,0:15:03.48,0:15:06.94,Default,,0,0,0,,Мен сені тозаққа шақырайын.
Dialogue: 0,0:15:08.32,0:15:09.53,Default,,0,0,0,,Зұлым орыннан қозғалмайды!
Dialogue: 0,0:15:12.99,0:15:16.33,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:15:16.66,0:15:19.12,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:15:19.25,0:15:20.08,Default,,0,0,0,,Даа!
Dialogue: 0,0:15:24.88,0:15:26.59,Default,,0,0,0,,Үзіліс! Фафнир!
Dialogue: 0,0:15:26.92,0:15:28.59,Default,,0,0,0,,Айқай! Cerbeus!
Dialogue: 0,0:15:37.31,0:15:38.52,Default,,0,0,0,,Хахаха!
Dialogue: 0,0:15:38.64,0:15:41.48,Default,,0,0,0,,Мен сізге мұндай шабуылдың мағынасыз екенін айттым.
Dialogue: 0,0:15:45.56,0:15:48.48,Default,,0,0,0,,Шыдамыңыз таусылған сияқты.
Dialogue: 0,0:15:51.86,0:15:52.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:59.83,0:16:01.04,Default,,0,0,0,,Бұдан былай
Dialogue: 0,0:16:01.50,0:16:03.29,Default,,0,0,0,,Фуфу, батылдық
Dialogue: 0,0:16:07.29,0:16:09.30,Default,,0,0,0,,Ah, айналу күші...
Dialogue: 0,0:16:12.63,0:16:14.97,Default,,0,0,0,,Уф, мен оны қайтарамын!
Dialogue: 0,0:16:19.31,0:16:20.47,Default,,0,0,0,,Не?
Dialogue: 0,0:16:23.85,0:16:26.23,Default,,0,0,0,,Тізбекті үзуден қорғау дегеніміз не?
Dialogue: 0,0:16:26.86,0:16:27.73,Default,,0,0,0,,Иә
Dialogue: 0,0:16:27.98,0:16:31.69,Default,,0,0,0,,Бірақ солай! Cerbeus!
Dialogue: 0,0:16:34.78,0:16:37.07,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:16:39.20,0:16:41.66,Default,,0,0,0,,Жүр! Фафнир!
Dialogue: 0,0:16:45.79,0:16:46.92,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:16:53.26,0:16:55.68,Default,,0,0,0,,Тұңғиыққа құла!
Dialogue: 0,0:16:57.76,0:17:00.56,Default,,0,0,0,,Тізбекті есептегіш!
Dialogue: 0,0:17:07.06,0:17:08.11,Default,,0,0,0,,Мен түсіндім!
Dialogue: 0,0:17:09.02,0:17:09.94,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:17:14.70,0:17:15.53,Default,,0,0,0,,Әй?
Dialogue: 0,0:17:16.11,0:17:19.95,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:21.70,0:17:22.54,Default,,0,0,0,,Эй!
Dialogue: 0,0:17:23.12,0:17:25.46,Default,,0,0,0,,Үзіліс алыңыз!
Dialogue: 0,0:17:34.42,0:17:36.26,Default,,0,0,0,,(шығанақтың құлаған дыбысы)
Dialogue: 0,0:17:44.14,0:17:45.52,Default,,0,0,0,,Әлі жоқ.
Dialogue: 0,0:17:49.90,0:17:51.02,Default,,0,0,0,,Куу…
Dialogue: 0,0:17:53.23,0:17:56.82,Default,,0,0,0,,Тегін Де Ла Хойя
Dialogue: 0,0:18:09.79,0:18:12.09,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:20.22,0:18:21.18,Default,,0,0,0,,Айга...
Dialogue: 0,0:18:22.14,0:18:23.39,Default,,0,0,0,,Тайга шебері! Ах
Dialogue: 0,0:18:25.77,0:18:26.68,Default,,0,0,0,,Барт
Dialogue: 0,0:18:30.35,0:18:32.06,Default,,0,0,0,,Менің қожайыннан бір жақсылығым бар.
Dialogue: 0,0:18:32.56,0:18:33.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:35.86,0:18:39.70,Default,,0,0,0,,Маған және Валькириге күшіңізді беріңіз.
Dialogue: 0,0:18:42.12,0:18:45.83,Default,,0,0,0,,Мен тағы да чемпион болғым келеді.
Dialogue: 0,0:18:47.50,0:18:50.87,Default,,0,0,0,,Жоқ, керек.
Dialogue: 0,0:18:59.68,0:19:01.18,Default,,0,0,0,,Өлі әже?
Dialogue: 0,0:19:01.68,0:19:03.35,Default,,0,0,0,,Келген соң түсінесің.
Dialogue: 0,0:19:04.97,0:19:06.93,Default,,0,0,0,,Онда жүректер күтіп тұр.
Dialogue: 0,0:19:09.31,0:19:10.56,Default,,0,0,0,,Бұл не? Ах
Dialogue: 0,0:19:10.94,0:19:12.19,Default,,0,0,0,,Сочо!
Dialogue: 0,0:19:12.94,0:19:15.90,Default,,0,0,0,,Бұл! Бұл жүректен келген хат емес пе?
Dialogue: 0,0:19:16.28,0:19:19.86,Default,,0,0,0,,Цк, Жүрекке кім барады?
Dialogue: 0,0:19:24.45,0:19:26.74,Default,,0,0,0,,Мен бұл туралы ойладым. Қараңдар!
Dialogue: 0,0:19:28.08,0:19:31.00,Default,,0,0,0,,Валькири менімен бірге өседі.
Dialogue: 0,0:19:31.67,0:19:32.50,Default,,0,0,0,,Хо
Dialogue: 0,0:19:34.17,0:19:35.00,Default,,0,0,0,,Әй?
Dialogue: 0,0:19:41.30,0:19:42.13,Default,,0,0,0,,(Пернені түрту дыбысы)
Dialogue: 0,0:19:42.26,0:19:43.09,Default,,0,0,0,,Ах
Dialogue: 0,0:19:49.52,0:19:53.27,Default,,0,0,0,,Бұл шығанақ сіздің барлық күш-жігеріңізге жауап береді.
Dialogue: 0,0:19:53.94,0:19:56.69,Default,,0,0,0,,Ах... керемет
Dialogue: 0,0:20:02.49,0:20:03.95,Default,,0,0,0,,Айга? Ах
Dialogue: 0,0:20:05.07,0:20:08.33,Default,,0,0,0,,Не? Қайда бара жатырсың?
Dialogue: 0,0:20:11.37,0:20:12.21,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:20:12.71,0:20:13.54,Default,,0,0,0,,Айга?
Dialogue: 0,0:20:14.67,0:20:16.84,Default,,0,0,0,,Ах... Сочо
Dialogue: 0,0:20:26.09,0:20:27.76,Default,,0,0,0,,Көбірек бұрыш қосыңыз.
Dialogue: 0,0:20:27.89,0:20:28.81,Default,,0,0,0,,О
Dialogue: 0,0:20:29.47,0:20:33.06,Default,,0,0,0,,Күте тұр, жолдасым, жақындап қалды.
Dialogue: 0,0:20:40.69,0:20:43.40,Default,,0,0,0,,Хмм, бұл жақсы ма?
Dialogue: 0,0:20:43.99,0:20:44.86,Default,,0,0,0,,Ах
Dialogue: 0,0:20:48.78,0:20:50.58,Default,,0,0,0,,Менің бұл затқа мінгенімді қалайсың ба?
Dialogue: 0,0:21:07.43,0:21:10.85,Default,,0,0,0,,Уф, солай... Сочо!
Dialogue: 0,0:21:10.97,0:21:14.98,Default,,0,0,0,,Оны тек сіз үшін қызықты етейік.
Dialogue: 0,0:21:17.27,0:21:18.81,Default,,0,0,0,,Екеуміз далаға шығайық
Dialogue: 0,0:21:20.23,0:21:21.73,Default,,0,0,0,,Сочо
Dialogue: 0,0:21:24.61,0:21:25.86,Default,,0,0,0,,Орындалды!
Dialogue: 0,0:21:27.49,0:21:28.32,Default,,0,0,0,,Иә
Dialogue: 0,0:21:30.74,0:21:32.66,Default,,0,0,0,,Super Z Valkyrie
Dialogue: 0,0:21:33.16,0:21:34.41,Default,,0,0,0,,Ешкім нәтижелерге сәйкес келмейді.
Dialogue: 0,0:21:34.96,0:21:37.58,Default,,0,0,0,,Кеттік, жолдасым.
Dialogue: 0,0:21:41.42,0:21:44.01,Default,,0,0,0,,Кеттік, Ахиллес!
Dialogue: 0,0:21:54.64,0:22:00.65,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:23:17.18,0:23:23.19,Default,,0,0,0,,~♪
Dialogue: 0,0:23:25.07,0:23:27.78,Default,,0,0,0,,Балто Super Z Valkyrie-ді аяқтағанға дейін
Dialogue: 0,0:23:27.90,0:23:29.74,Default,,0,0,0,,Тегін пайда болады
Dialogue: 0,0:23:29.86,0:23:32.49,Default,,0,0,0,,Біз Өлі Грандқа отырдық.
Dialogue: 0,0:23:32.61,0:23:34.49,Default,,0,0,0,,Тозақтың иттері күтіп тұрды.
Dialogue: 0,0:23:35.20,0:23:37.70,Default,,0,0,0,,Сіз бұл жігітті жеңмейінше, Жүректермен күресе алмайсыз ба?
Dialogue: 0,0:23:38.33,0:23:40.00,Default,,0,0,0,,Жасайық!
Dialogue: 0,0:23:40.12,0:23:42.50,Default,,0,0,0,,Келесі жолы «Beyblade Burst Super Zetsu»
Dialogue: 0,0:23:42.62,0:23:44.46,Default,,0,0,0,,«Мажо Өлі Гран!!»
Dialogue: 0,0:23:44.92,0:23:46.63,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:47.00,0:23:48.96,Default,,0,0,0,,Бар, ат!
