Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.71,0:00:04.00,Default,,0,0,0,,Бейблейд
Dialogue: 0,0:00:04.12,0:00:08.50,Default,,0,0,0,,Мықты болуды мақсат еткен ұлдардың арманының жемісі.
Dialogue: 0,0:00:08.92,0:00:12.38,Default,,0,0,0,,Ал қазір супер Цетсу дәуірі қызып келеді.
Dialogue: 0,0:00:12.51,0:00:16.76,Default,,0,0,0,,Металл сауыт киіп, Беймен шытырман оқиғаға барыңыз!
Dialogue: 0,0:00:17.26,0:00:19.22,Default,,0,0,0,,Әлем чемпионы болуды мақсат етіңіз!
Dialogue: 0,0:00:19.68,0:00:23.60,Default,,0,0,0,,Super Zetsu Super Zetsu Super Zetsu!
Dialogue: 0,0:00:24.81,0:00:28.27,Default,,0,0,0,,Ең күшті және жеңілмейтін атағын алатын адам сенсің!
Dialogue: 0,0:00:37.20,0:00:38.03,Default,,0,0,0,,Желдей жылдам шабуыл!
Dialogue: 0,0:00:47.54,0:00:51.13,Default,,0,0,0,,Бұл Өлі Феникс сені құртқысы келеді.
Dialogue: 0,0:00:52.76,0:00:55.88,Default,,0,0,0,,Спригганды оңай жоя алмайсың деп ойлаймын.
Dialogue: 0,0:01:03.31,0:01:06.77,Default,,0,0,0,,Жарайды! Ұлдар мен қыздар!
Dialogue: 0,0:01:06.90,0:01:08.40,Default,,0,0,0,,Көңіліңіз толқып тұр ма?
Dialogue: 0,0:01:08.77,0:01:11.32,Default,,0,0,0,,Куришу VS Фай!
Dialogue: 0,0:01:11.52,0:01:13.99,Default,,0,0,0,,Әлемнің түкпір-түкпірінен назар аударатын матч
Dialogue: 0,0:01:14.11,0:01:16.40,Default,,0,0,0,,Бастау уақыты келді!
Dialogue: 0,0:01:16.74,0:01:20.62,Default,,0,0,0,,Жою құдайы Фи Бейді қайтадан жоя ма?
Dialogue: 0,0:01:20.74,0:01:24.50,Default,,0,0,0,,Немесе! Аңыз Блейдер Куришуу
Dialogue: 0,0:01:24.62,0:01:26.41,Default,,0,0,0,,Сіз оны тоқтатқыңыз келе ме?
Dialogue: 0,0:01:27.00,0:01:29.25,Default,,0,0,0,,Ооо! Яааа!
Dialogue: 0,0:01:29.38,0:01:34.42,Default,,0,0,0,,Жыпылықтауға уақыт жоқ. Оны жіберіп алмаңыз!
Dialogue: 0,0:01:34.55,0:01:38.43,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:01:42.43,0:01:46.48,Default,,0,0,0,,Жарық немесе қараңғылық, қайсысы күшті?
Dialogue: 0,0:01:48.69,0:01:50.15,Default,,0,0,0,,Қайсысы?
Dialogue: 0,0:01:52.11,0:01:54.15,Default,,0,0,0,,Мен өзімді қараңғылық деп ойлаймын
Dialogue: 0,0:01:57.90,0:02:00.37,Default,,0,0,0,,Қараңғылықты қабылдасаң, күшейесің.
Dialogue: 0,0:02:00.49,0:02:02.83,Default,,0,0,0,,Сіз басқалардан күшті бола аласыз
Dialogue: 0,0:02:03.03,0:02:04.33,Default,,0,0,0,,Қанша?
Dialogue: 0,0:02:04.54,0:02:05.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:06.00,0:02:08.12,Default,,0,0,0,,Қараңғылығыңның тереңдігі
Dialogue: 0,0:02:08.67,0:02:12.29,Default,,0,0,0,,Мен сені дәл қазір оңай жұтып аламын.
Dialogue: 0,0:02:13.55,0:02:14.71,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:02:15.84,0:02:18.55,Default,,0,0,0,,Сіз әлі де жеңемін деп ойлайсыз ба?
Dialogue: 0,0:02:19.51,0:02:20.84,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:02:23.30,0:02:24.60,Default,,0,0,0,,Тегін де Ла Хойя
Dialogue: 0,0:02:24.72,0:02:27.73,Default,,0,0,0,,Сіз «Мен жеңемін» немесе осыған ұқсас нәрсені айттыңыз.
Dialogue: 0,0:02:28.81,0:02:32.27,Default,,0,0,0,,Сіз де маған міндетті түрде бағынасыз.
Dialogue: 0,0:02:36.40,0:02:37.57,Default,,0,0,0,,Шу…
Dialogue: 0,0:02:38.82,0:02:39.65,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:02:42.16,0:02:45.33,Default,,0,0,0,,Мен және Спригган сені талқандаймыз!
Dialogue: 0,0:02:46.45,0:02:52.46,Default,,0,0,0,,♪~
Dialogue: 0,0:04:09.70,0:04:15.71,Default,,0,0,0,,~♪
Dialogue: 0,0:04:20.63,0:04:22.30,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:04:23.05,0:04:26.05,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:04:26.80,0:04:29.47,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:04:29.68,0:04:30.52,Default,,0,0,0,,Тыныш, сендер!
Dialogue: 0,0:04:30.85,0:04:33.69,Default,,0,0,0,,Super Southern Cross Shot!
Dialogue: 0,0:04:35.90,0:04:38.02,Default,,0,0,0,,Уау! Super Z Spriggan
Dialogue: 0,0:04:38.15,0:04:40.57,Default,,0,0,0,,Super Z-ояту бірден іске қосылады!
Dialogue: 0,0:04:40.69,0:04:45.15,Default,,0,0,0,,Қалай! Феникс орталығына үздіксіз шабуыл!
Dialogue: 0,0:04:45.78,0:04:48.16,Default,,0,0,0,,Super Z-Wing осында!
Dialogue: 0,0:04:48.32,0:04:50.33,Default,,0,0,0,,Шуу!
Dialogue: 0,0:04:52.29,0:04:53.91,Default,,0,0,0,,Спригганға барыңыз!
Dialogue: 0,0:04:54.25,0:04:55.83,Default,,0,0,0,,Иә? Не?
Dialogue: 0,0:04:55.96,0:04:59.88,Default,,0,0,0,,Не болды? Өлі Феникске шабуыл жасалуда!
Dialogue: 0,0:05:00.67,0:05:03.92,Default,,0,0,0,,Не, ол сондай тыныш.
Dialogue: 0,0:05:04.05,0:05:06.51,Default,,0,0,0,,Өте тыныш.
Dialogue: 0,0:05:07.18,0:05:11.43,Default,,0,0,0,,Тезірек аяқтасаңыз, Феникс қанағаттанбайды
Dialogue: 0,0:05:11.56,0:05:14.06,Default,,0,0,0,,Әлі ондай емес, солай емес пе?
Dialogue: 0,0:05:18.56,0:05:21.69,Default,,0,0,0,,Маған күшіңді көрсет
Dialogue: 0,0:05:24.19,0:05:25.40,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:05:31.83,0:05:35.96,Default,,0,0,0,,Спригган өте Z-оянған және жарылмайды.
Dialogue: 0,0:05:36.21,0:05:38.04,Default,,0,0,0,,Жеңіске әрқашан мүмкіндік болады
Dialogue: 0,0:05:45.26,0:05:48.76,Default,,0,0,0,,Мен барлық шығанақтарды жоямын
Dialogue: 0,0:05:49.43,0:05:52.68,Default,,0,0,0,,Менің мұны істегенімді қалайсың ба? Мүлдем!
Dialogue: 0,0:05:56.52,0:06:01.61,Default,,0,0,0,,Legend Blader күткендей, ол көңілді болатын сияқты.
Dialogue: 0,0:06:03.86,0:06:05.44,Default,,0,0,0,,Ой... Бұл ше?
Dialogue: 0,0:06:05.57,0:06:08.36,Default,,0,0,0,,Өлі Феникстің шыдамы таусылды!
Dialogue: 0,0:06:08.74,0:06:10.49,Default,,0,0,0,,Басың айналып кетті!
Dialogue: 0,0:06:10.87,0:06:13.74,Default,,0,0,0,,Super Z-Wing шабуылы тиімді.
Dialogue: 0,0:06:14.16,0:06:16.70,Default,,0,0,0,,Тынш! Бұл жұмыс істейді, Шу!
Dialogue: 0,0:06:20.00,0:06:21.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:21.46,0:06:22.29,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:22.92,0:06:24.25,Default,,0,0,0,,Phi жігіті...
Dialogue: 0,0:06:27.63,0:06:30.72,Default,,0,0,0,,Super Z-Wing әдейі шабуылдады
Dialogue: 0,0:06:30.84,0:06:31.68,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:06:34.31,0:06:35.47,Default,,0,0,0,,Фу…
Dialogue: 0,0:06:35.85,0:06:36.68,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:06:37.31,0:06:38.27,Default,,0,0,0,,Спригган!
Dialogue: 0,0:06:42.65,0:06:45.94,Default,,0,0,0,,(Спригганның ұрыс айқайы)
Dialogue: 0,0:06:46.61,0:06:49.78,Default,,0,0,0,,Super Spriggan Slash!
Dialogue: 0,0:06:57.16,0:06:58.91,Default,,0,0,0,,
Dialogue: 0,0:06:59.37,0:07:03.08,Default,,0,0,0,,О! Қандай жарылыс!?
Dialogue: 0,0:07:03.79,0:07:06.13,Default,,0,0,0,,Иә! (Сочо) Жарайды!
Dialogue: 0,0:07:08.21,0:07:09.51,Default,,0,0,0,,Бейне пікір!
Dialogue: 0,0:07:10.01,0:07:12.89,Default,,0,0,0,,
Dialogue: 0,0:07:13.30,0:07:16.39,Default,,0,0,0,,Жарайсыңдар! Мен мұнда бейнебаян бойынша баға беремін.
Dialogue: 0,0:07:17.01,0:07:19.89,Default,,0,0,0,,Қане, бірінші болып мәре?
Dialogue: 0,0:07:20.02,0:07:22.98,Default,,0,0,0,,Артық аяқтау бірінші орында!
Dialogue: 0,0:07:28.19,0:07:29.44,Default,,0,0,0,,Ах! Қарғыс атқыр...
Dialogue: 0,0:07:30.32,0:07:32.91,Default,,0,0,0,,Super Z Spriggan Over Finish
Dialogue: 0,0:07:33.03,0:07:35.03,Default,,0,0,0,,Куришу үшін бір ұпай!
Dialogue: 0,0:07:35.24,0:07:36.91,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:07:37.03,0:07:38.45,Default,,0,0,0,,Өлі Феникс
Dialogue: 0,0:07:38.58,0:07:41.66,Default,,0,0,0,,Ол жарылып кетер алдында жерге тиді!
Dialogue: 0,0:07:42.12,0:07:46.17,Default,,0,0,0,,1-ден 0-ге дейін! Қызу шайқас әлі аяқталған жоқ
Dialogue: 0,0:07:46.54,0:07:48.63,Default,,0,0,0,,Ах! Бұл ұят
Dialogue: 0,0:07:49.01,0:07:52.26,Default,,0,0,0,,Сол Фиге қарсы... керемет!
Dialogue: 0,0:07:53.30,0:07:54.93,Default,,0,0,0,,Сіз бірден шабуыл жасадыңыз.
Dialogue: 0,0:07:55.14,0:07:57.26,Default,,0,0,0,,Нысанаға дәл тидің, Шу.
Dialogue: 0,0:08:01.02,0:08:02.60,Default,,0,0,0,,Феникспен байланыстыру?
Dialogue: 0,0:08:03.06,0:08:04.23,Default,,0,0,0,,О
Dialogue: 0,0:08:04.40,0:08:07.44,Default,,0,0,0,,Феникстің ең үлкен қаруы - бұл сауыт.
Dialogue: 0,0:08:07.57,0:08:11.82,Default,,0,0,0,,Пайдаланбас бұрын барлығын бірден сындырыңыз!
Dialogue: 0,0:08:12.57,0:08:14.07,Default,,0,0,0,,Қызыл көз…
Dialogue: 0,0:08:14.20,0:08:15.62,Default,,0,0,0,,Олай емес...
Dialogue: 0,0:08:16.49,0:08:19.08,Default,,0,0,0,,Қазіргі Шу одан да көп.
Dialogue: 0,0:08:22.83,0:08:24.58,Default,,0,0,0,,Қызық болып барады.
Dialogue: 0,0:08:25.46,0:08:29.46,Default,,0,0,0,,Әйтпесе, бұзғанның қуанышы жоқ.
Dialogue: 0,0:08:30.59,0:08:31.96,Default,,0,0,0,,Сіз әлі де айтасыз ба?
Dialogue: 0,0:08:32.34,0:08:36.47,Default,,0,0,0,,Мен саған айттым, шығанақтың жойылуы бәрі.
Dialogue: 0,0:08:37.01,0:08:39.39,Default,,0,0,0,,Ватт? Мүмкін емес!
Dialogue: 0,0:08:39.56,0:08:42.39,Default,,0,0,0,,Бұл тағы да осында, Фидің жойылу туралы мәлімдемесі.
Dialogue: 0,0:08:42.52,0:08:46.23,Default,,0,0,0,,Super Z Spriggan да Phi-нің құрбаны бола ма?
Dialogue: 0,0:08:46.65,0:08:49.27,Default,,0,0,0,,Мен қызып кеттім! Шу-сенпай!
Dialogue: 0,0:08:49.40,0:08:51.32,Default,,0,0,0,,Бұл ұрыс, Шу-сан!
Dialogue: 0,0:08:51.44,0:08:52.61,Default,,0,0,0,,Шу-сан! Ах...
Dialogue: 0,0:08:53.61,0:08:54.95,Default,,0,0,0,,Оны еш күш жұмсамай шашыраңқы етіп көрсету үшін
Dialogue: 0,0:08:55.57,0:08:57.95,Default,,0,0,0,,Шу! БУТЧИГИР!
Dialogue: 0,0:08:58.37,0:08:59.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:59.95,0:09:02.29,Default,,0,0,0,,Шу! Шуу!
Dialogue: 0,0:09:02.70,0:09:04.96,Default,,0,0,0,,Шу! Шуу!
Dialogue: 0,0:09:05.46,0:09:07.75,Default,,0,0,0,,Шу! Шуу!
Dialogue: 0,0:09:07.88,0:09:10.63,Default,,0,0,0,,Шу! Шуу!
Dialogue: 0,0:09:10.80,0:09:16.18,Default,,0,0,0,,Шу! Шуу! Шуу! Шуу!
Dialogue: 0,0:09:16.84,0:09:17.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:19.30,0:09:23.14,Default,,0,0,0,,Хмм... Сен танымалсың, Куришуу.
Dialogue: 0,0:09:23.31,0:09:25.64,Default,,0,0,0,,Шу! Шуу!
Dialogue: 0,0:09:25.94,0:09:29.40,Default,,0,0,0,,Шу! Шуу! Шуу!
Dialogue: 0,0:09:29.90,0:09:34.65,Default,,0,0,0,,Фаи... Бұл жалғыздыққа қалай шыдаймын?
Dialogue: 0,0:09:39.87,0:09:42.08,Default,,0,0,0,,Phi!
Dialogue: 0,0:09:46.12,0:09:49.17,Default,,0,0,0,,Маған Ажамды қайтар!
Dialogue: 0,0:09:49.75,0:09:51.84,Default,,0,0,0,,Сіз әлі білмейсіз бе?
Dialogue: 0,0:09:52.04,0:09:55.88,Default,,0,0,0,,Бұл жігіт өзінің заңды үйіне оралды.
Dialogue: 0,0:09:57.13,0:09:58.84,Default,,0,0,0,,Барлығы осы.
Dialogue: 0,0:09:59.34,0:10:00.30,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:10:00.76,0:10:02.81,Default,,0,0,0,,Аид қайта туды
Dialogue: 0,0:10:03.01,0:10:05.52,Default,,0,0,0,,Оны Феникске қосу арқылы.
Dialogue: 0,0:10:06.02,0:10:07.35,Default,,0,0,0,,Не!
Dialogue: 0,0:10:08.14,0:10:13.02,Default,,0,0,0,,Барлығын жойып, жаңа құдай бол
Dialogue: 0,0:10:13.73,0:10:14.86,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:24.12,0:10:24.99,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:10:25.49,0:10:30.04,Default,,0,0,0,,Мұндағылардың бәріне терең үмітсіздік әкелейік.
Dialogue: 0,0:10:31.75,0:10:34.75,Default,,0,0,0,,Отбасыма…
Dialogue: 0,0:10:38.01,0:10:39.51,Default,,0,0,0,,Анықтаңыз
Dialogue: 0,0:10:42.39,0:10:44.81,Default,,0,0,0,,Оң жақ айналумен шабуыл режимі!
Dialogue: 0,0:10:45.01,0:10:47.14,Default,,0,0,0,,Шуу!
Dialogue: 0,0:10:47.43,0:10:49.14,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:10:49.77,0:10:52.90,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:10:53.44,0:10:55.48,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:10:56.19,0:10:57.03,Default,,0,0,0,,Әй!
Dialogue: 0,0:10:59.82,0:11:03.53,Default,,0,0,0,,Иә! Екінші шайқаста да екі жақтан да күшті соққылар болды...
Dialogue: 0,0:11:03.66,0:11:07.12,Default,,0,0,0,,Уау! Кенеттен қатты соқтығыс!
Dialogue: 0,0:11:07.62,0:11:10.50,Default,,0,0,0,,Басынан бастап толық дроссель!
Dialogue: 0,0:11:13.79,0:11:15.09,Default,,0,0,0,,Өлі үзіліс!
Dialogue: 0,0:11:20.34,0:11:21.18,Default,,0,0,0,,Уф!
Dialogue: 0,0:11:24.05,0:11:26.35,Default,,0,0,0,,Мен жеңген адаммын!
Dialogue: 0,0:11:26.89,0:11:27.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:28.14,0:11:29.89,Default,,0,0,0,,Кеттік, Шу!
Dialogue: 0,0:11:30.94,0:11:32.35,Default,,0,0,0,,Спригган!
Dialogue: 0,0:11:33.90,0:11:35.23,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:11:35.65,0:11:38.69,Default,,0,0,0,,Супер қарсы үзіліс!
Dialogue: 0,0:11:40.86,0:11:42.03,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:45.78,0:11:46.66,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:11:47.28,0:11:48.12,Default,,0,0,0,,Иә
Dialogue: 0,0:11:49.16,0:11:51.62,Default,,0,0,0,,Өлі Феникс аяқталды
Dialogue: 0,0:11:51.75,0:11:53.42,Default,,0,0,0,,1-ден 1-ге дейінгі тармақтар!
Dialogue: 0,0:11:53.58,0:11:55.29,Default,,0,0,0,,Не, не
Dialogue: 0,0:11:55.42,0:11:57.67,Default,,0,0,0,,Байланыстағы айырмашылыққа байланысты аяқталды!
Dialogue: 0,0:11:58.00,0:12:00.34,Default,,0,0,0,,Есеп 1-1.
Dialogue: 0,0:12:00.46,0:12:03.38,Default,,0,0,0,,Phi Сіз өз шешіміңізді осында көрсеттіңіз!
Dialogue: 0,0:12:03.51,0:12:04.64,Default,,0,0,0,,Шу…
Dialogue: 0,0:12:04.84,0:12:06.60,Default,,0,0,0,,Қарғыс атсын... (Сочо) Шынайы ма?
Dialogue: 0,0:12:07.18,0:12:08.60,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:09.47,0:12:13.60,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:12:14.48,0:12:17.27,Default,,0,0,0,,Жақсы, Куришуу.
Dialogue: 0,0:12:17.48,0:12:20.94,Default,,0,0,0,,Мен сенен мені бұлай байсалды етеді деп күтпедім.
Dialogue: 0,0:12:21.65,0:12:24.66,Default,,0,0,0,,Сондықтан оны жоюға тұрарлық.
Dialogue: 0,0:12:24.99,0:12:26.53,Default,,0,0,0,,Ой, осы белдікті киіп тұрғанда мұны істей алмаймын.
Dialogue: 0,0:12:26.66,0:12:29.99,Default,,0,0,0,,Үшінші шайқасқа барымды беремін.
Dialogue: 0,0:12:30.49,0:12:32.25,Default,,0,0,0,,Оны ұсақтайық!
Dialogue: 0,0:12:33.37,0:12:34.25,Default,,0,0,0,,Үшінші шайқас
Dialogue: 0,0:12:38.88,0:12:42.05,Default,,0,0,0,,Бұл жолы солға айналдырумен төзімділік режимі ме?
Dialogue: 0,0:12:42.42,0:12:45.09,Default,,0,0,0,,Қорғаныс түрі Өлі Феникс
Dialogue: 0,0:12:45.22,0:12:47.05,Default,,0,0,0,,Өйткені төзімділік - артықшылық.
Dialogue: 0,0:12:47.18,0:12:49.05,Default,,0,0,0,,Мен шешім қабылдайтыныма сенімдімін.
Dialogue: 0,0:12:49.39,0:12:51.06,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:12:51.68,0:12:54.56,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:12:55.02,0:12:57.98,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:12:58.19,0:12:59.02,Default,,0,0,0,,Тыныш, сендер!
Dialogue: 0,0:13:00.07,0:13:03.99,Default,,0,0,0,,Енді тағдырлы үшінші шайқас басталады!
Dialogue: 0,0:13:09.62,0:13:11.74,Default,,0,0,0,,Жою, Феникс!
Dialogue: 0,0:13:15.92,0:13:16.96,Default,,0,0,0,,Ха!
Dialogue: 0,0:13:17.54,0:13:20.84,Default,,0,0,0,,Феникстің өлі сауыты ұшып кетті!
Dialogue: 0,0:13:21.42,0:13:24.09,Default,,0,0,0,,Сіз сауытыңызды шешуге келдіңіз бе?
Dialogue: 0,0:13:24.26,0:13:25.09,Default,,0,0,0,,Фу…
Dialogue: 0,0:13:25.59,0:13:27.18,Default,,0,0,0,,Өлі Стингер!
Dialogue: 0,0:13:34.10,0:13:38.90,Default,,0,0,0,,Уууу!
Dialogue: 0,0:13:39.27,0:13:41.02,Default,,0,0,0,,Әлі де шыдайсың ба?
Dialogue: 0,0:13:42.11,0:13:44.36,Default,,0,0,0,,Сіз мені қызықтырасыз.
Dialogue: 0,0:13:45.15,0:13:46.90,Default,,0,0,0,,Мен сені мақтаймын.
Dialogue: 0,0:13:47.45,0:13:48.28,Default,,0,0,0,,Ха…
Dialogue: 0,0:13:48.95,0:13:51.95,Default,,0,0,0,,Бөлшектерге айналғанша құртайық!
Dialogue: 0,0:13:52.08,0:13:53.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:53.54,0:13:55.16,Default,,0,0,0,,Ахх!
Dialogue: 0,0:13:58.04,0:13:58.87,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:13:59.21,0:14:00.08,Default,,0,0,0,,Уф!
Dialogue: 0,0:14:00.21,0:14:03.80,Default,,0,0,0,,Қараңғылығың сені жұтып қояды деп ойладың ба?
Dialogue: 0,0:14:03.92,0:14:05.88,Default,,0,0,0,,Уууу!
Dialogue: 0,0:14:06.59,0:14:07.63,Default,,0,0,0,,Шу…
Dialogue: 0,0:14:12.35,0:14:16.39,Default,,0,0,0,,Ах! Спригган таң қалды!
Dialogue: 0,0:14:18.02,0:14:19.90,Default,,0,0,0,,Өзгеріңіз! шабуыл режимі
Dialogue: 0,0:14:24.32,0:14:26.57,Default,,0,0,0,,Спригган режимін өзгерту!
Dialogue: 0,0:14:29.70,0:14:30.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:30.82,0:14:32.78,Default,,0,0,0,,Мен осы сәтті күттім
Dialogue: 0,0:14:33.12,0:14:35.62,Default,,0,0,0,,Алға! Шуу!
Dialogue: 0,0:14:35.83,0:14:37.96,Default,,0,0,0,,Уф... Спригган!
Dialogue: 0,0:14:39.58,0:14:41.00,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:14:41.46,0:14:42.59,Default,,0,0,0,,Жою.
Dialogue: 0,0:14:43.59,0:14:46.88,Default,,0,0,0,,Түн ортасында әлі де 36 сағат.
Dialogue: 0,0:14:47.38,0:14:48.30,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:48.72,0:14:51.89,Default,,0,0,0,,Ооо... Феникс!
Dialogue: 0,0:14:55.31,0:14:56.85,Default,,0,0,0,,(Феникс Роар)
Dialogue: 0,0:15:00.60,0:15:02.10,Default,,0,0,0,,Соттау уақыты келді
Dialogue: 0,0:15:02.48,0:15:04.98,Default,,0,0,0,,Сотталатын адам сенсің!
Dialogue: 0,0:15:05.11,0:15:08.86,Default,,0,0,0,,Super Spriggan Slash!
Dialogue: 0,0:15:09.61,0:15:10.99,Default,,0,0,0,,Өлі үзіліс!
Dialogue: 0,0:15:28.38,0:15:29.21,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:29.59,0:15:32.05,Default,,0,0,0,,Super Z-ояну жойылды!
Dialogue: 0,0:15:32.18,0:15:33.09,Default,,0,0,0,,Бұл...
Dialogue: 0,0:15:39.02,0:15:41.48,Default,,0,0,0,,Өлі Стингер Пресс!
Dialogue: 0,0:15:42.14,0:15:42.98,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:52.82,0:15:54.16,Default,,0,0,0,,(Көрермендердің айқайы)
Dialogue: 0,0:15:54.62,0:15:55.91,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:04.58,0:16:05.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:11.63,0:16:13.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:14.43,0:16:16.01,Default,,0,0,0,,Шу…
Dialogue: 0,0:16:16.14,0:16:17.18,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:16:17.97,0:16:18.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:20.31,0:16:23.81,Default,,0,0,0,,De… Dead Phoenix Burst Finish
Dialogue: 0,0:16:24.48,0:16:28.40,Default,,0,0,0,,Фи 3-тен 1 ұпаймен жеңеді!
Dialogue: 0,0:16:29.36,0:16:31.32,Default,,0,0,0,,Ах... о, құдай-ау!
Dialogue: 0,0:16:31.44,0:16:35.32,Default,,0,0,0,,Уәде етілгендей мен Super Z Spriggan-ды жойдым!
Dialogue: 0,0:16:35.99,0:16:40.83,Default,,0,0,0,,Жою құдайы Фиді ешкім тоқтата алмайды ма?
Dialogue: 0,0:16:41.58,0:16:44.83,Default,,0,0,0,,Құдайға мойынсұнбаудың не екенін түсіндіңіз бе?
Dialogue: 0,0:16:45.46,0:16:47.29,Default,,0,0,0,,Жарық пен қараңғылық
Dialogue: 0,0:16:47.50,0:16:50.96,Default,,0,0,0,,Күшті деген... қараңғылық.
Dialogue: 0,0:16:51.59,0:16:53.09,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,0:16:53.22,0:16:54.59,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:16:56.01,0:16:58.10,Default,,0,0,0,,Фухахаха!
Dialogue: 0,0:16:59.47,0:17:01.10,Default,,0,0,0,,Хахахаха! Қарғыс атқыр...
Dialogue: 0,0:17:01.85,0:17:03.23,Default,,0,0,0,,Phi! Ах...
Dialogue: 0,0:17:06.15,0:17:06.98,Default,,0,0,0,,Уф!
Dialogue: 0,0:17:07.48,0:17:09.48,Default,,0,0,0,,Барто Аои…
Dialogue: 0,0:17:10.11,0:17:11.11,Default,,0,0,0,,Уф!
Dialogue: 0,0:17:16.28,0:17:18.24,Default,,0,0,0,,Алланың қалауымен
Dialogue: 0,0:17:18.45,0:17:21.24,Default,,0,0,0,,Super Z Valkyrie-ді жойыңыз
Dialogue: 0,0:17:23.87,0:17:25.75,Default,,0,0,0,,Уақыт толы
Dialogue: 0,0:17:26.21,0:17:29.13,Default,,0,0,0,,Соңғы құрбандық – сен!
Dialogue: 0,0:17:31.17,0:17:33.26,Default,,0,0,0,,Мен оны тоқтатамын!
Dialogue: 0,0:17:33.71,0:17:34.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:34.67,0:17:38.22,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:17:38.34,0:17:39.85,Default,,0,0,0,,Уф... (Сочо) Эй!
Dialogue: 0,0:17:39.97,0:17:41.10,Default,,0,0,0,,Күте тұрыңыз, Тем
Dialogue: 0,0:17:41.22,0:17:43.27,Default,,0,0,0,,Сіз не істеп жатырсыз? Мені жіберіңізші!
Dialogue: 0,0:17:43.39,0:17:44.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:46.06,0:17:48.48,Default,,0,0,0,,Бұл менмін! Мен оны жеңемін!
Dialogue: 0,0:17:48.60,0:17:51.61,Default,,0,0,0,,Мен Омені дәл қазір жойып жіберемін.
Dialogue: 0,0:17:54.86,0:17:56.03,Default,,0,0,0,,Айга…
Dialogue: 0,0:17:59.87,0:18:03.58,Default,,0,0,0,,Түсіндім... Сенің де ұрысқың келе ме?
Dialogue: 0,0:18:04.20,0:18:05.33,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:18:05.79,0:18:08.17,Default,,0,0,0,,Барт Маған мұны істеуге рұқсат етіңіз.
Dialogue: 0,0:18:09.29,0:18:10.42,Default,,0,0,0,,Сіз...
Dialogue: 0,0:18:21.85,0:18:23.81,Default,,0,0,0,,Оны бар күшіңізбен жойыңыз!
Dialogue: 0,0:18:24.31,0:18:25.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:26.18,0:18:27.68,Default,,0,0,0,,Балт Сенпай
Dialogue: 0,0:18:28.31,0:18:29.69,Default,,0,0,0,,Жоқ, біз бұлай істей алмаймыз!
Dialogue: 0,0:18:36.32,0:18:37.28,Default,,0,0,0,,О!
Dialogue: 0,0:18:38.07,0:18:39.57,Default,,0,0,0,,Қызықты
Dialogue: 0,0:18:41.45,0:18:43.95,Default,,0,0,0,,Оны қалауыңызша жойыңыз
Dialogue: 0,0:18:44.08,0:18:44.91,Default,,0,0,0,,Ах!Уф...
Dialogue: 0,0:18:45.41,0:18:46.79,Default,,0,0,0,,Қызыл жүзді Айга
Dialogue: 0,0:18:46.91,0:18:51.17,Default,,0,0,0,,Мен сіздің супер-З Ахиллесіңізді бөлшектеймін!
Dialogue: 0,0:18:51.92,0:18:52.84,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:53.79,0:18:56.17,Default,,0,0,0,,Иә… жоқ… жоқ!
Dialogue: 0,0:18:56.30,0:19:01.55,Default,,0,0,0,,Қызыл пышақ Айга жойылу құдайы Файға шақырды!
Dialogue: 0,0:19:01.68,0:19:03.22,Default,,0,0,0,,Бұл танымал карта болады.
Dialogue: 0,0:19:03.35,0:19:07.68,Default,,0,0,0,,Осы екеуінің шайқасын жіберіп алмаңыз!
Dialogue: 0,0:19:13.81,0:19:14.65,Default,,0,0,0,,Phi!
Dialogue: 0,0:19:17.86,0:19:18.99,Default,,0,0,0,,Не?
Dialogue: 0,0:19:21.24,0:19:23.41,Default,,0,0,0,,Сіз қанша қашықтыққа баруды жоспарлайсыз?
Dialogue: 0,0:19:24.53,0:19:27.16,Default,,0,0,0,,Құдай дейсің, т.б.
Dialogue: 0,0:19:27.29,0:19:29.62,Default,,0,0,0,,Сіз мұндай нәрсені жасай алмайсыз.
Dialogue: 0,0:19:31.12,0:19:34.71,Default,,0,0,0,,Менен жеңілгендіктен, ештеңе айтуға хақың жоқ.
Dialogue: 0,0:19:36.13,0:19:39.80,Default,,0,0,0,,Барар жерің жойылудан басқа ештеңе емес!
Dialogue: 0,0:19:41.97,0:19:44.51,Default,,0,0,0,,Құдайдың алдында жойылу жоқ.
Dialogue: 0,0:19:45.05,0:19:46.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:03.70,0:20:07.03,Default,,0,0,0,,Мен Super Z Awakening бұзылғанына сене алмаймын...
Dialogue: 0,0:20:11.62,0:20:12.46,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:12.58,0:20:14.96,Default,,0,0,0,,Сіз сондай мұңайып көрінесіз.
Dialogue: 0,0:20:15.58,0:20:18.71,Default,,0,0,0,,Мүмкін солай шығар? Сіз қорқасыз ба?
Dialogue: 0,0:20:19.13,0:20:21.34,Default,,0,0,0,,О? Сіз мұны істей алмайсыз!
Dialogue: 0,0:20:21.47,0:20:24.47,Default,,0,0,0,,Мен Файды қалай жеңемін деп ойладым.
Dialogue: 0,0:20:25.05,0:20:27.05,Default,,0,0,0,,Біз жеңуіміз керек
Dialogue: 0,0:20:27.35,0:20:29.56,Default,,0,0,0,,Мен одан ешқашан бас тартпаймын!
Dialogue: 0,0:20:31.52,0:20:32.39,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:20:33.31,0:20:35.31,Default,,0,0,0,,Мыңылдасаң да көмектеспейді.
Dialogue: 0,0:20:35.44,0:20:37.06,Default,,0,0,0,,Бізде мұны істеуден басқа амал жоқ!
Dialogue: 0,0:20:37.56,0:20:39.57,Default,,0,0,0,,Ах... Сочо
Dialogue: 0,0:20:40.15,0:20:41.82,Default,,0,0,0,,Тек нақты ұрыс бар.
Dialogue: 0,0:20:42.15,0:20:43.74,Default,,0,0,0,,Мен қысқартпаймын
Dialogue: 0,0:20:44.32,0:20:47.32,Default,,0,0,0,,Фубуки жинағы…
Dialogue: 0,0:20:48.16,0:20:50.49,Default,,0,0,0,,Эй, мен істеймін!
Dialogue: 0,0:20:51.12,0:20:52.45,Default,,0,0,0,,Оларды осы жаққа жіберіңізші.
Dialogue: 0,0:20:52.96,0:20:56.00,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:20:56.25,0:20:59.34,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:20:59.88,0:21:04.51,Default,,0,0,0,,Мен өзімнің қазіргі Айгаммен Фиге қарсы қанша жүре аламын деп ойлаймын...
Dialogue: 0,0:21:06.55,0:21:08.64,Default,,0,0,0,,Бұл қиын шайқас болады.
Dialogue: 0,0:21:08.76,0:21:11.01,Default,,0,0,0,,Жүр! Ахиллес!
Dialogue: 0,0:21:11.47,0:21:15.35,Default,,0,0,0,,Файмен шайқас Айғаға неге бердіңіз?
Dialogue: 0,0:21:16.06,0:21:17.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:17.40,0:21:19.94,Default,,0,0,0,,Хмм, неге...
Dialogue: 0,0:21:20.23,0:21:23.36,Default,,0,0,0,,Бірақ мен оған бірдеңе сезіндім.
Dialogue: 0,0:21:24.99,0:21:27.45,Default,,0,0,0,,Айга күшейе алады
Dialogue: 0,0:21:27.57,0:21:30.37,Default,,0,0,0,,Бірақ әлі де бірдеңе жетіспейді.
Dialogue: 0,0:21:33.08,0:21:35.46,Default,,0,0,0,,Жарайды, бітіріп алайық!
Dialogue: 0,0:21:36.33,0:21:38.71,Default,,0,0,0,,Оған қазір қажет нәрсе
Dialogue: 0,0:21:38.83,0:21:41.38,Default,,0,0,0,,Шу... Мүмкін сен шығарсың.
Dialogue: 0,0:21:41.50,0:21:42.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:44.51,0:21:45.34,Default,,0,0,0,,О
Dialogue: 0,0:21:45.84,0:21:49.09,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:21:49.47,0:21:52.51,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:21:55.31,0:22:01.32,Default,,0,0,0,,♪~
Dialogue: 0,0:23:18.73,0:23:24.73,Default,,0,0,0,,~♪
Dialogue: 0,0:23:26.02,0:23:29.74,Default,,0,0,0,,Мен Фимен жұдырықтасқанша, мен одан да күшті боламын.
Dialogue: 0,0:23:30.15,0:23:33.62,Default,,0,0,0,,Барлығы Socho Fubuki Suou Bay клубында
Dialogue: 0,0:23:33.91,0:23:35.41,Default,,0,0,0,,Ал Шу!
Dialogue: 0,0:23:35.53,0:23:38.62,Default,,0,0,0,,Құмарлық сезімдер мені кері итермелейді
Dialogue: 0,0:23:38.75,0:23:41.46,Default,,0,0,0,,Достарымызбен бірге күресейік!
Dialogue: 0,0:23:41.58,0:23:43.83,Default,,0,0,0,,Келесі жолы «Beyblade Burst Super Zetsu»
Dialogue: 0,0:23:43.96,0:23:45.71,Default,,0,0,0,,«Біздің Бейблейд!»
Dialogue: 0,0:23:45.84,0:23:47.67,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:47.80,0:23:49.46,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:50.96,0:23:56.96,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory