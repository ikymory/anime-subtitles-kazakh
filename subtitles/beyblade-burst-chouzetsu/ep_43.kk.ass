Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.71,0:00:04.00,Default,,0,0,0,,Бейблейд
Dialogue: 0,0:00:04.12,0:00:08.50,Default,,0,0,0,,Мықты болуды мақсат еткен ұлдардың арманының жемісі.
Dialogue: 0,0:00:08.92,0:00:12.38,Default,,0,0,0,,Ал қазір супер Цетсу дәуірі қызып келеді.
Dialogue: 0,0:00:12.51,0:00:16.76,Default,,0,0,0,,Металл сауыт киіп, Беймен шытырман оқиғаға барыңыз!
Dialogue: 0,0:00:16.89,0:00:19.22,Default,,0,0,0,,Әлем чемпионы болуды мақсат етіңіз!
Dialogue: 0,0:00:19.35,0:00:23.60,Default,,0,0,0,,Super Zetsu Super Zetsu Super Zetsu!
Dialogue: 0,0:00:24.69,0:00:27.86,Default,,0,0,0,,Ең күшті және жеңілмейтін атағын алатын адам сенсің!
Dialogue: 0,0:00:46.08,0:00:46.92,Default,,0,0,0,,Әй?
Dialogue: 0,0:00:55.22,0:00:56.05,Default,,0,0,0,,Ах
Dialogue: 0,0:01:00.18,0:01:01.93,Default,,0,0,0,,Тегін Де Ла Хойя
Dialogue: 0,0:01:03.02,0:01:04.77,Default,,0,0,0,,Мен сені көруге келдім
Dialogue: 0,0:01:05.27,0:01:07.15,Default,,0,0,0,,Соғысуға?
Dialogue: 0,0:01:07.56,0:01:08.48,Default,,0,0,0,,Жоқ
Dialogue: 0,0:01:10.94,0:01:12.90,Default,,0,0,0,,Осы Өлі Фениксте
Dialogue: 0,0:01:13.32,0:01:16.99,Default,,0,0,0,,Геистфафнирді жою үшін.
Dialogue: 0,0:01:23.29,0:01:29.29,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:02:46.20,0:02:52.21,Default,,0,0,0,,~♪
Dialogue: 0,0:02:57.71,0:02:59.97,Default,,0,0,0,,
Dialogue: 0,0:03:00.09,0:03:02.09,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:03:02.22,0:03:04.26,Default,,0,0,0,,Өте қиын!
Dialogue: 0,0:03:05.05,0:03:06.35,Default,,0,0,0,,Айга Бұл қиын.
Dialogue: 0,0:03:06.89,0:03:08.98,Default,,0,0,0,,Фри Фимен шайқасқа шығады.
Dialogue: 0,0:03:09.64,0:03:11.14,Default,,0,0,0,,Бұл әйелдің Қанды Пері Шығармасы ма?
Dialogue: 0,0:03:11.39,0:03:13.73,Default,,0,0,0,,Хуа~
Dialogue: 0,0:03:15.48,0:03:17.48,Default,,0,0,0,,Тегін? Не?
Dialogue: 0,0:03:17.86,0:03:19.82,Default,,0,0,0,,Бұл шайқас. Бұл шайқас.
Dialogue: 0,0:03:19.94,0:03:23.20,Default,,0,0,0,,Хмм... кіммен?
Dialogue: 0,0:03:23.78,0:03:26.49,Default,,0,0,0,,Бұл Phi. Тегін және Phi.
Dialogue: 0,0:03:26.66,0:03:28.75,Default,,0,0,0,,Біз шайқасқа барамыз! ау
Dialogue: 0,0:03:29.33,0:03:31.04,Default,,0,0,0,,Тегін және Phi?
Dialogue: 0,0:03:32.87,0:03:37.05,Default,,0,0,0,,Ұлдар мен қыздар Үлкен жаңалық!
Dialogue: 0,0:03:37.17,0:03:38.00,Default,,0,0,0,,ақырында
Dialogue: 0,0:03:38.46,0:03:41.34,Default,,0,0,0,,Өте жұмбақ Blader Phi
Dialogue: 0,0:03:41.47,0:03:44.01,Default,,0,0,0,,Біз әлем чемпионы атануға қадам басудамыз.
Dialogue: 0,0:03:44.64,0:03:46.64,Default,,0,0,0,,Бұл бірінші қарсылас
Dialogue: 0,0:03:46.76,0:03:49.27,Default,,0,0,0,,Құдай-ау, әлгі жалғыз Бладер.
Dialogue: 0,0:03:49.64,0:03:51.77,Default,,0,0,0,,Де Ла Хойя тегін!
Dialogue: 0,0:03:52.39,0:03:53.48,Default,,0,0,0,,Тегін
Dialogue: 0,0:03:53.98,0:03:55.44,Default,,0,0,0,,Ойын ертең
Dialogue: 0,0:03:55.56,0:03:58.61,Default,,0,0,0,,Орналасқан жері Free Home El Santo!
Dialogue: 0,0:03:58.73,0:04:00.99,Default,,0,0,0,,Не? Ой, мұнда Phi.
Dialogue: 0,0:04:01.11,0:04:02.49,Default,,0,0,0,,Сіздің хабарламаңыз келді!
Dialogue: 0,0:04:03.15,0:04:03.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:08.33,0:04:10.50,Default,,0,0,0,,Мен Жоюдың Құдайымын
Dialogue: 0,0:04:13.04,0:04:14.12,Default,,0,0,0,,Менің шығанағым
Dialogue: 0,0:04:14.62,0:04:17.63,Default,,0,0,0,,Өлі Феникс болып қайта туылды
Dialogue: 0,0:04:18.09,0:04:19.80,Default,,0,0,0,,Өлі Феникс?
Dialogue: 0,0:04:19.92,0:04:23.13,Default,,0,0,0,,Мен білмей тұрып, бұл мыңжапырақ жаңа шығанақта болды.
Dialogue: 0,0:04:23.59,0:04:26.34,Default,,0,0,0,,Ең бірінші жою керек
Dialogue: 0,0:04:26.55,0:04:29.51,Default,,0,0,0,,Тегін Де Ла Хойяның Гейстфафнирі
Dialogue: 0,0:04:29.72,0:04:30.56,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:04:30.68,0:04:32.18,Default,,0,0,0,,Жою - бәрі
Dialogue: 0,0:04:32.56,0:04:33.89,Default,,0,0,0,,Жою дегеніміз...
Dialogue: 0,0:04:34.27,0:04:36.02,Default,,0,0,0,,Бұл менің Бейблейдім!
Dialogue: 0,0:04:36.48,0:04:39.15,Default,,0,0,0,,Блейдерлер бүкіл әлем бойынша
Dialogue: 0,0:04:39.44,0:04:42.90,Default,,0,0,0,,Ертеңгі шайқасты асыға күт!
Dialogue: 0,0:04:44.95,0:04:50.08,Default,,0,0,0,,Уау... Қорқынышты Фидің жойылу туралы мәлімдемесі осында!
Dialogue: 0,0:04:50.20,0:04:54.91,Default,,0,0,0,,Күні кеше Фай егіз інісі Жүректерді толығымен басып тастады.
Dialogue: 0,0:04:55.04,0:04:59.09,Default,,0,0,0,,Біз өлі өлілерді бөлшектеп жойдық!
Dialogue: 0,0:04:59.54,0:05:03.55,Default,,0,0,0,,Еркін жойылу тізбегін тоқтата ала ма?
Dialogue: 0,0:05:03.67,0:05:06.09,Default,,0,0,0,,Ертең қиян-кескі ұрыс болады.
Dialogue: 0,0:05:06.47,0:05:11.10,Default,,0,0,0,,«Ертең кездескенше» бағдарламасын жіберіп алмаңыз!
Dialogue: 0,0:05:13.56,0:05:17.31,Default,,0,0,0,,Phi's Yarrow барған сайын таң қалдырады.
Dialogue: 0,0:05:17.44,0:05:19.98,Default,,0,0,0,,Дұрыс... (Сочо) А?
Dialogue: 0,0:05:22.69,0:05:24.69,Default,,0,0,0,,Тем неге қорқады?
Dialogue: 0,0:05:24.82,0:05:26.70,Default,,0,0,0,,Қорқыныш деген жоқ!
Dialogue: 0,0:05:27.82,0:05:29.70,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:05:30.07,0:05:32.41,Default,,0,0,0,,Бұл жүректер сияқты, солай емес пе?
Dialogue: 0,0:05:32.66,0:05:34.00,Default,,0,0,0,,"Дегенмен ол жүгірді."
Dialogue: 0,0:05:34.45,0:05:40.00,Default,,0,0,0,,Фи мен Жүрек егіз ағайынды. Олар қандай да бір жағынан ұқсас болуы мүмкін.
Dialogue: 0,0:05:40.50,0:05:42.30,Default,,0,0,0,,Мүмкін, Фи
Dialogue: 0,0:05:42.42,0:05:45.17,Default,,0,0,0,,Жүректерді жеген шығарсың.
Dialogue: 0,0:05:45.30,0:05:46.88,Default,,0,0,0,,Сіз жүректерді жедіңіз бе?
Dialogue: 0,0:05:47.51,0:05:49.26,Default,,0,0,0,,Өлі Адестің бөліктері
Dialogue: 0,0:05:49.39,0:05:51.60,Default,,0,0,0,,Бұл оның Феникске түсірілгенін білдіреді.
Dialogue: 0,0:05:51.97,0:05:53.89,Default,,0,0,0,,Бұл мүмкін бе?
Dialogue: 0,0:05:54.02,0:05:57.60,Default,,0,0,0,,Жоқ, мүмкін. Пи мұны істей алады.
Dialogue: 0,0:05:58.27,0:06:01.81,Default,,0,0,0,,Сондықтан сіз атын «Өлі Феникс» деп өзгерттіңіз бе?
Dialogue: 0,0:06:02.90,0:06:07.11,Default,,0,0,0,,Егер Аид пен Феникс қосылса, еркін қаншалықты күшті болса да...
Dialogue: 0,0:06:07.53,0:06:11.37,Default,,0,0,0,,Тегін жеңістер! Мен Phi сияқты нәрседен ұтыла аламын ба?
Dialogue: 0,0:06:16.54,0:06:17.37,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:06:17.50,0:06:19.83,Default,,0,0,0,,(Балтоның ауыр тыныс алуы)
Dialogue: 0,0:06:21.29,0:06:22.13,Default,,0,0,0,,Тегін!
Dialogue: 0,0:06:23.25,0:06:24.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:29.09,0:06:30.18,Default,,0,0,0,,Тегін!
Dialogue: 0,0:06:33.01,0:06:35.39,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:06:36.81,0:06:37.89,Default,,0,0,0,,(Дәрігер күрсінеді)
Dialogue: 0,0:06:40.10,0:06:41.90,Default,,0,0,0,,Күрсін
Dialogue: 0,0:06:43.90,0:06:45.02,Default,,0,0,0,,Тегін
Dialogue: 0,0:06:50.91,0:06:52.41,Default,,0,0,0,,Сіз жаттығу жасадыңыз ба?
Dialogue: 0,0:06:52.91,0:06:53.95,Default,,0,0,0,,О
Dialogue: 0,0:06:54.24,0:06:56.45,Default,,0,0,0,,Көрдіңіз бе? Фи хабары
Dialogue: 0,0:06:56.83,0:06:57.87,Default,,0,0,0,,Мен оны көріп тұрдым.
Dialogue: 0,0:06:58.25,0:07:03.00,Default,,0,0,0,,Сіз оның жойылу туралы екеніне таң қаласыз.
Dialogue: 0,0:07:03.29,0:07:05.29,Default,,0,0,0,,Фи байсалды, иә?
Dialogue: 0,0:07:07.09,0:07:09.55,Default,,0,0,0,,Мен Фафнирді жойғым келеді.
Dialogue: 0,0:07:09.92,0:07:10.93,Default,,0,0,0,,Тегін
Dialogue: 0,0:07:13.30,0:07:16.35,Default,,0,0,0,,Неліктен Фи сізбен титулға сәйкес келмеді?
Dialogue: 0,0:07:16.47,0:07:19.73,Default,,0,0,0,,Сіз маған қарсы тұрасыз ба? Түсінесіз бе?
Dialogue: 0,0:07:20.48,0:07:23.06,Default,,0,0,0,,Менің ойымша, Phi бұл тақырыпты қызықтырмайды.
Dialogue: 0,0:07:23.44,0:07:24.94,Default,,0,0,0,,Бұл бәрі емес.
Dialogue: 0,0:07:25.82,0:07:28.61,Default,,0,0,0,,Мен сендерге өзіммен болған шайқасты көрсеткім келеді.
Dialogue: 0,0:07:29.19,0:07:30.07,Default,,0,0,0,,Мен үшін?
Dialogue: 0,0:07:30.49,0:07:35.83,Default,,0,0,0,,Дұрыс, мен сендерге аянышты түрде қалай жеңілетінімді көрсеткім келеді.
Dialogue: 0,0:07:36.33,0:07:37.49,Default,,0,0,0,,Бұл...
Dialogue: 0,0:07:37.91,0:07:41.46,Default,,0,0,0,,Оның қуанышы тек шығанағын бұзуда емес.
Dialogue: 0,0:07:41.75,0:07:43.54,Default,,0,0,0,,Мен үмітсіздікті көргім келеді
Dialogue: 0,0:07:44.13,0:07:46.13,Default,,0,0,0,,Мен және сіз үмітсіз
Dialogue: 0,0:07:46.75,0:07:47.88,Default,,0,0,0,,Үмітсіздік...
Dialogue: 0,0:07:49.67,0:07:51.17,Default,,0,0,0,,Бірақ бәрібір
Dialogue: 0,0:07:51.84,0:07:54.18,Default,,0,0,0,,Өйткені мен Фиден жеңілгенді қаламаймын.
Dialogue: 0,0:07:54.30,0:07:55.14,Default,,0,0,0,,Эй!
Dialogue: 0,0:07:58.89,0:08:01.85,Default,,0,0,0,,Аа, дұрыс, хехе
Dialogue: 0,0:08:04.77,0:08:07.57,Default,,0,0,0,,(отшашулардың дыбысы)
Dialogue: 0,0:08:07.69,0:08:10.86,Default,,0,0,0,,Жарайсыңдар ұлдар мен қыздар!
Dialogue: 0,0:08:10.99,0:08:14.28,Default,,0,0,0,,Ақырында, ең көрнекті шайқас - Free vs. Phi.
Dialogue: 0,0:08:14.41,0:08:20.08,Default,,0,0,0,,Эль-Сантода қызықты шайқас басталады!
Dialogue: 0,0:08:20.79,0:08:24.33,Default,,0,0,0,,Тегін немесе Fi? Жеңіс құдайы жымиды
Dialogue: 0,0:08:25.12,0:08:27.34,Default,,0,0,0,,Бұл қайсысы?
Dialogue: 0,0:08:27.46,0:08:29.92,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:08:31.42,0:08:34.34,Default,,0,0,0,,Енді, Blader кіреді!
Dialogue: 0,0:08:35.47,0:08:37.26,Default,,0,0,0,,Көк бұрыш
Dialogue: 0,0:08:38.18,0:08:41.81,Default,,0,0,0,,Ахиллесті жойыңыз Аидті жойыңыз
Dialogue: 0,0:08:41.93,0:08:44.44,Default,,0,0,0,,Жойылғаннан кейін жойылу
Dialogue: 0,0:08:44.60,0:08:48.15,Default,,0,0,0,,Жою құдайы, Фай!
Dialogue: 0,0:08:49.57,0:08:52.11,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:08:52.65,0:08:55.49,Default,,0,0,0,,Бей - Өлі Феникс
Dialogue: 0,0:08:56.07,0:08:58.74,Default,,0,0,0,,Қызыл бұрышқа қарсы
Dialogue: 0,0:09:02.33,0:09:07.21,Default,,0,0,0,,Көптеген аңызға айналған шайқастарда жеңіске жеткен жалғыз данышпан.
Dialogue: 0,0:09:07.33,0:09:09.96,Default,,0,0,0,,Де Ла Хойя тегін!
Dialogue: 0,0:09:10.09,0:09:12.71,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:09:13.09,0:09:15.68,Default,,0,0,0,,шығанақ – Гейстфафнир
Dialogue: 0,0:09:16.59,0:09:18.30,Default,,0,0,0,,Сәттілік, тегін!
Dialogue: 0,0:09:18.43,0:09:21.43,Default,,0,0,0,,Фи Яроуды ұрып тастаңыз!
Dialogue: 0,0:09:21.56,0:09:23.22,Default,,0,0,0,,Оны құлат!
Dialogue: 0,0:09:23.35,0:09:24.23,Default,,0,0,0,,Оны ұсақтаңыз~
Dialogue: 0,0:09:24.60,0:09:26.23,Default,,0,0,0,,Жылама! Ақымақ, Косей! Енді мен де…
Dialogue: 0,0:09:28.69,0:09:32.73,Default,,0,0,0,,Өлі Феникс? Бұл қара және қорқынышты.
Dialogue: 0,0:09:32.86,0:09:35.53,Default,,0,0,0,,Өзгерген сыртқы түрі ғана емес.
Dialogue: 0,0:09:37.53,0:09:38.66,Default,,0,0,0,,Өлі сауыт бар
Dialogue: 0,0:09:38.78,0:09:40.99,Default,,0,0,0,,Аид металы біріктірілді.
Dialogue: 0,0:09:41.37,0:09:42.49,Default,,0,0,0,,Адад туралы?
Dialogue: 0,0:09:42.91,0:09:43.74,Default,,0,0,0,,Иә
Dialogue: 0,0:09:43.87,0:09:46.62,Default,,0,0,0,,Бұл Revive Phoenix-тен ауыр.
Dialogue: 0,0:09:46.75,0:09:48.50,Default,,0,0,0,,Шабуыл күші артуы керек еді
Dialogue: 0,0:09:48.83,0:09:53.34,Default,,0,0,0,,Еркін сол шығанаққа қандай шайқас көрсетеді?
Dialogue: 0,0:09:53.46,0:09:57.76,Default,,0,0,0,,Бұл қызық, фа фа ~
Dialogue: 0,0:09:58.72,0:10:01.14,Default,,0,0,0,,Бүгінгі шайқас титулдық емес матч
Dialogue: 0,0:10:01.26,0:10:03.10,Default,,0,0,0,,2 баллдық жүйе
Dialogue: 0,0:10:04.22,0:10:07.52,Default,,0,0,0,,Жарияланғандай Фафнирді жойыңыз.
Dialogue: 0,0:10:08.19,0:10:11.61,Default,,0,0,0,,Бұлай болуы мүмкін емес, өйткені мен жеңемін.
Dialogue: 0,0:10:13.48,0:10:14.78,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:10:19.20,0:10:20.78,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:10:21.28,0:10:24.29,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:10:24.54,0:10:27.20,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:10:28.29,0:10:29.12,Default,,0,0,0,,болуы тиіс
Dialogue: 0,0:10:31.13,0:10:34.88,Default,,0,0,0,,Феникс стадионды өте жылдамдықпен жүгіріп өтеді!
Dialogue: 0,0:10:35.00,0:10:38.55,Default,,0,0,0,,Фафнир, керісінше, баяу жылдамдықпен айналады, ол кез келген сәтте тоқтайтын сияқты.
Dialogue: 0,0:10:39.30,0:10:42.80,Default,,0,0,0,,Феникс Қарқынды алдын ала шабуыл!
Dialogue: 0,0:10:48.14,0:10:49.31,Default,,0,0,0,,Иә? Жоқ, бұл...
Dialogue: 0,0:10:49.44,0:10:53.48,Default,,0,0,0,,Fabnir Шабуылдарды сіңіреді және айналу жылдамдығын арттырады!
Dialogue: 0,0:10:53.94,0:10:55.40,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:10:55.52,0:10:57.86,Default,,0,0,0,,Кеттік! Бұл тамаша!
Dialogue: 0,0:10:58.40,0:11:01.36,Default,,0,0,0,,Күтілгендей, бұл еркін қарқын.
Dialogue: 0,0:11:03.41,0:11:04.28,Default,,0,0,0,,(Серо) Тіпті бастауыш сынып оқушысы кенеттен «Қорықпа!» деп айқайлады.
Dialogue: 0,0:11:07.24,0:11:08.66,Default,,0,0,0,,Геист айналдыру!
Dialogue: 0,0:11:14.88,0:11:17.59,Default,,0,0,0,,Феникстің өлі сауыты ұшып кетті!
Dialogue: 0,0:11:20.63,0:11:22.89,Default,,0,0,0,,Dead Armor Press!
Dialogue: 0,0:11:23.93,0:11:25.22,Default,,0,0,0,,Бұл техника!
Dialogue: 0,0:11:29.85,0:11:30.81,Default,,0,0,0,,Шыда!
Dialogue: 0,0:11:33.44,0:11:36.32,Default,,0,0,0,,Үзіліс алыңыз!
Dialogue: 0,0:11:37.73,0:11:38.57,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:11:45.91,0:11:49.50,Default,,0,0,0,,Geistfafnir 1 ұпай артық аяқтау үшін
Dialogue: 0,0:11:49.62,0:11:54.21,Default,,0,0,0,,Керемет! Фафнир найзағайдың жарқырауы!
Dialogue: 0,0:11:54.75,0:11:56.84,Default,,0,0,0,,Жарайды! (қуаныш)
Dialogue: 0,0:11:57.38,0:11:58.92,Default,,0,0,0,,Free Strong!
Dialogue: 0,0:11:59.05,0:12:02.09,Default,,0,0,0,,Көп уақыттың ортасында болғанымнан бері ұзақ уақыт болды.
Dialogue: 0,0:12:02.59,0:12:03.43,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:03.55,0:12:06.35,Default,,0,0,0,,Мен Феникстің ерекше қимылынан жалтардым.
Dialogue: 0,0:12:06.68,0:12:08.35,Default,,0,0,0,,Өлі сауыт баспасөзі
Dialogue: 0,0:12:08.81,0:12:13.27,Default,,0,0,0,,Соққыдан білік ұшы бекітіліп, жоғары жылдамдықпен қозғалады.
Dialogue: 0,0:12:13.39,0:12:15.65,Default,,0,0,0,,Сіз баспасөзден шыға алдыңыз, солай ма?
Dialogue: 0,0:12:15.86,0:12:19.65,Default,,0,0,0,,А, мен сол жерден қарсы шабуылға бел байладым.
Dialogue: 0,0:12:20.61,0:12:22.95,Default,,0,0,0,,Бұл керемет, тегін.
Dialogue: 0,0:12:23.28,0:12:26.28,Default,,0,0,0,,Біз әлі сақтығымызды төмендете алмаймыз. (2 адам) Иә?
Dialogue: 0,0:12:26.41,0:12:30.20,Default,,0,0,0,,Аидті талқандау арқылы жасалған өлі сауыт
Dialogue: 0,0:12:30.33,0:12:33.54,Default,,0,0,0,,Құдірет бұдан былай көрсетіледі.
Dialogue: 0,0:12:37.79,0:12:41.05,Default,,0,0,0,,Ата, қолыңыз босаса, сақтығыңызды түсірмеңіз.
Dialogue: 0,0:12:45.55,0:12:49.93,Default,,0,0,0,,Дәл солай, фа фа фа~
Dialogue: 0,0:12:53.14,0:12:55.94,Default,,0,0,0,,Күрсін
Dialogue: 0,0:12:56.52,0:12:59.44,Default,,0,0,0,,Мен екінші жекпе-жекте тегін таңдауды жоспарлап отырмын.
Dialogue: 0,0:13:02.03,0:13:06.20,Default,,0,0,0,,Ой! Еркіннің келбеті жын сияқты өзгерді!
Dialogue: 0,0:13:10.37,0:13:11.20,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:13:11.74,0:13:14.50,Default,,0,0,0,,Ой! Ал Фаи суық жымиды
Dialogue: 0,0:13:14.62,0:13:16.21,Default,,0,0,0,,Тегін қарау!
Dialogue: 0,0:13:16.58,0:13:18.21,Default,,0,0,0,,Исшики шабыттандырған
Dialogue: 0,0:13:18.33,0:13:21.71,Default,,0,0,0,,Бұл өте қауіпті шайқасқа айналуда!
Dialogue: 0,0:13:22.34,0:13:23.51,Default,,0,0,0,,Тегін!
Dialogue: 0,0:13:25.47,0:13:27.38,Default,,0,0,0,,Жылама! Ақымақ, Косей! Енді мен де…
Dialogue: 0,0:13:27.51,0:13:28.76,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:13:33.27,0:13:34.77,Default,,0,0,0,,Бірден шешіңіз
Dialogue: 0,0:13:35.43,0:13:36.44,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:13:37.10,0:13:40.77,Default,,0,0,0,,Қанша талпынсаң да Құдайды жеңе алмайсың.
Dialogue: 0,0:13:41.07,0:13:42.90,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:13:43.19,0:13:46.53,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:13:46.74,0:13:49.28,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:13:49.70,0:13:50.53,Default,,0,0,0,,Әй!
Dialogue: 0,0:13:54.75,0:13:56.29,Default,,0,0,0,,Үзіліс алыңыз!
Dialogue: 0,0:13:59.21,0:14:00.29,Default,,0,0,0,,Жарайсыңдар!
Dialogue: 0,0:14:00.79,0:14:04.42,Default,,0,0,0,,Күтілгендей, Armor Press құралын бұл жағдайда пайдалана алмайсыз.
Dialogue: 0,0:14:07.93,0:14:08.76,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:09.30,0:14:11.05,Default,,0,0,0,,Өлі Стингер!
Dialogue: 0,0:14:13.97,0:14:15.06,Default,,0,0,0,,Сенгісіз!
Dialogue: 0,0:14:15.35,0:14:17.81,Default,,0,0,0,,Мен ажыратылған сауытты бұрағышпен сипап қойдым!
Dialogue: 0,0:14:20.77,0:14:21.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:22.11,0:14:23.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:23.32,0:14:24.86,Default,,0,0,0,,Не? Қазір...
Dialogue: 0,0:14:27.40,0:14:28.24,Default,,0,0,0,,Иә
Dialogue: 0,0:14:29.07,0:14:31.49,Default,,0,0,0,,Өлі Феникс аяқталды
Dialogue: 0,0:14:31.87,0:14:33.53,Default,,0,0,0,,1-1 тармақтар
Dialogue: 0,0:14:33.66,0:14:34.49,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:14:34.91,0:14:39.37,Default,,0,0,0,,Уау! Феникс, шешілген сауытты сипап өт
Dialogue: 0,0:14:39.50,0:14:41.00,Default,,0,0,0,,Мен Фафнирды ұшырып жібердім.
Dialogue: 0,0:14:41.92,0:14:45.55,Default,,0,0,0,,Бұрын-соңды болмаған Бұл бұрын-соңды болмаған ерекше қадам!
Dialogue: 0,0:14:47.26,0:14:50.51,Default,,0,0,0,,Уау, бұл рас па?
Dialogue: 0,0:14:51.72,0:14:53.43,Default,,0,0,0,,Бұл біртүрлі, иә?
Dialogue: 0,0:14:54.10,0:14:58.81,Default,,0,0,0,,Қазіргі уақытта мен Фафнирді жарып жіберуім керек еді.
Dialogue: 0,0:14:59.69,0:15:02.23,Default,,0,0,0,,Сіз жеңуіңіз керек еді, неге?
Dialogue: 0,0:15:02.90,0:15:05.02,Default,,0,0,0,,Дәл Барто айтқандай.
Dialogue: 0,0:15:05.52,0:15:08.07,Default,,0,0,0,,Фи нақты нені білдіреді?
Dialogue: 0,0:15:08.53,0:15:12.28,Default,,0,0,0,,Фри Фидің ниетінен хабардар.
Dialogue: 0,0:15:13.41,0:15:18.58,Default,,0,0,0,,Сондықтан мен келесі жолы жарылған матчты шешуді жоспарлап отырмын.
Dialogue: 0,0:15:23.42,0:15:26.38,Default,,0,0,0,,Мен барымды беремін, Фафнир.
Dialogue: 0,0:15:26.75,0:15:29.42,Default,,0,0,0,,Келіңіздер! Ұпайлар 1:1
Dialogue: 0,0:15:29.55,0:15:32.51,Default,,0,0,0,,Феникс уәде етілгендей жойыла ма?
Dialogue: 0,0:15:32.64,0:15:35.60,Default,,0,0,0,,Әлде Фафнир кек алады ма?
Dialogue: 0,0:15:36.76,0:15:37.60,Default,,0,0,0,,Үшінші шайқас
Dialogue: 0,0:15:42.02,0:15:44.81,Default,,0,0,0,,Күрсін
Dialogue: 0,0:15:45.06,0:15:47.82,Default,,0,0,0,,болуы тиіс
Dialogue: 0,0:15:51.28,0:15:52.40,Default,,0,0,0,,Ол...
Dialogue: 0,0:15:52.82,0:15:54.32,Default,,0,0,0,,Мүмкін сіз өз шегіңізден асып кеткіңіз келетін шығар
Dialogue: 0,0:15:57.83,0:15:59.20,Default,,0,0,0,,Тегін
Dialogue: 0,0:16:00.00,0:16:01.33,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:16:02.08,0:16:05.08,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:16:05.63,0:16:08.00,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:16:11.17,0:16:14.01,Default,,0,0,0,,Жүр, мен Феникс орталығын алуға келдім.
Dialogue: 0,0:16:16.55,0:16:19.97,Default,,0,0,0,,Уау~ Фафнир!
Dialogue: 0,0:16:22.73,0:16:23.81,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:16:28.57,0:16:30.86,Default,,0,0,0,,Geist Claw!
Dialogue: 0,0:16:32.90,0:16:34.61,Default,,0,0,0,,Геист тырнақтарының жарылысы!
Dialogue: 0,0:16:35.36,0:16:37.57,Default,,0,0,0,,Өлі сауыт қайтадан ұшып кетті!
Dialogue: 0,0:16:38.24,0:16:41.08,Default,,0,0,0,,Күтілгендей, бір ату жеткіліксіз.
Dialogue: 0,0:16:41.66,0:16:43.08,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:16:45.54,0:16:46.83,Default,,0,0,0,,Өлі Стингер!
Dialogue: 0,0:16:48.13,0:16:50.63,Default,,0,0,0,,Тағы бір күшті соққы!
Dialogue: 0,0:16:50.75,0:16:52.76,Default,,0,0,0,,А, Фафнир, мен аяғымнан тұрып қалдым.
Dialogue: 0,0:16:53.01,0:16:55.01,Default,,0,0,0,,Уф... Хаа~
Dialogue: 0,0:16:58.55,0:17:00.39,Default,,0,0,0,,Бұзған жөн.
Dialogue: 0,0:17:01.72,0:17:04.23,Default,,0,0,0,,Өлі Стингер қайтадан жарылды!
Dialogue: 0,0:17:04.44,0:17:07.48,Default,,0,0,0,,Фафнир жойылады ма?
Dialogue: 0,0:17:07.60,0:17:09.06,Default,,0,0,0,,Қашан жою керек?
Dialogue: 0,0:17:10.23,0:17:12.90,Default,,0,0,0,,Құдай бәрін шешеді!
Dialogue: 0,0:17:17.74,0:17:18.57,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:18.99,0:17:19.83,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:20.41,0:17:23.87,Default,,0,0,0,,Вау! Бұл Феникстің үздіксіз шабуылы.
Dialogue: 0,0:17:24.00,0:17:25.66,Default,,0,0,0,,Оған шыдай аласың ба? Фафнир!
Dialogue: 0,0:17:28.17,0:17:30.00,Default,,0,0,0,,Еркін жүгіру!
Dialogue: 0,0:17:30.13,0:17:32.42,Default,,0,0,0,,Ол жерден қаш!
Dialogue: 0,0:17:33.21,0:17:35.72,Default,,0,0,0,,Бұл жұмыс істемейді, Барто.
Dialogue: 0,0:17:36.68,0:17:38.30,Default,,0,0,0,,Ертеңгі ойын
Dialogue: 0,0:17:38.43,0:17:40.93,Default,,0,0,0,,Бұл Фафнир екеуміздің арасындағы шайқас емес.
Dialogue: 0,0:17:41.60,0:17:42.89,Default,,0,0,0,,Егер мен жеңілсем
Dialogue: 0,0:17:43.18,0:17:45.93,Default,,0,0,0,,Біздің Бейблейдтер жеңілді.
Dialogue: 0,0:17:46.39,0:17:47.60,Default,,0,0,0,,Тегін
Dialogue: 0,0:17:48.19,0:17:50.69,Default,,0,0,0,,Бірақ мен саған олай істеуге рұқсат бермеймін.
Dialogue: 0,0:17:51.65,0:17:56.07,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:59.78,0:18:01.58,Default,,0,0,0,,Айналу жылдамдығы артты!
Dialogue: 0,0:18:03.91,0:18:07.08,Default,,0,0,0,,Уау~ Феникс!
Dialogue: 0,0:18:10.42,0:18:12.00,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:18:21.93,0:18:25.31,Default,,0,0,0,,Бұл екі машина арасындағы қызу бәсеке!
Dialogue: 0,0:18:25.81,0:18:28.56,Default,,0,0,0,,Кел, көп кел!
Dialogue: 0,0:18:34.73,0:18:35.57,Default,,0,0,0,,Б-Бірақ соншама Титан бар кезде адамды көтеріп ұшу…
Dialogue: 0,0:18:35.78,0:18:37.40,Default,,0,0,0,,Үзіліс алыңыз!
Dialogue: 0,0:18:41.62,0:18:44.24,Default,,0,0,0,,Абсорбциялық үзілістің бұзылуы?
Dialogue: 0,0:18:44.95,0:18:45.79,Default,,0,0,0,,Ой…
Dialogue: 0,0:18:47.96,0:18:48.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:48.96,0:18:49.79,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:50.87,0:18:52.29,Default,,0,0,0,,Жою.
Dialogue: 0,0:18:52.63,0:18:55.50,Default,,0,0,0,,Өлі Стингер Пресс!
Dialogue: 0,0:19:07.77,0:19:09.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:10.48,0:19:11.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:11.73,0:19:12.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:13.31,0:19:15.98,Default,,0,0,0,,Өлі Феникстің жарылуы аяқталды
Dialogue: 0,0:19:16.36,0:19:19.65,Default,,0,0,0,,Фи 3 ұпайдан 1 ұпайға дейін жеңеді
Dialogue: 0,0:19:21.45,0:19:25.87,Default,,0,0,0,,Қандай керемет аяқталды.
Dialogue: 0,0:19:25.99,0:19:29.45,Default,,0,0,0,,Geistfafnir Ол бөлшектеп жойылды!
Dialogue: 0,0:19:29.96,0:19:34.92,Default,,0,0,0,,Жою құдайы Бұл жойылу Бейблейд!
Dialogue: 0,0:19:36.04,0:19:37.34,Default,,0,0,0,,Тегін!
Dialogue: 0,0:19:41.01,0:19:42.09,Default,,0,0,0,,Фафнир…
Dialogue: 0,0:19:46.35,0:19:48.81,Default,,0,0,0,,(Балтоның ауыр тыныс алуы)
Dialogue: 0,0:19:50.52,0:19:52.31,Default,,0,0,0,,Тегін Жақсы ма?
Dialogue: 0,0:19:52.81,0:19:55.40,Default,,0,0,0,,Ахх...
Dialogue: 0,0:19:55.94,0:19:56.90,Default,,0,0,0,,Тегін
Dialogue: 0,0:19:57.73,0:19:58.57,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:19:58.94,0:20:01.07,Default,,0,0,0,,Бұл Бейблейд емес!
Dialogue: 0,0:20:01.74,0:20:04.87,Default,,0,0,0,,Шығанақты қиратқаның үшін сені ешқашан кешіре алмаймын!
Dialogue: 0,0:20:05.16,0:20:06.58,Default,,0,0,0,,Менімен шайқас!
Dialogue: 0,0:20:09.12,0:20:09.95,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:20:12.33,0:20:13.17,Default,,0,0,0,,Иә
Dialogue: 0,0:20:14.17,0:20:15.71,Default,,0,0,0,,Сіз әлі жоқсыз
Dialogue: 0,0:20:16.25,0:20:17.25,Default,,0,0,0,,Не?
Dialogue: 0,0:20:19.59,0:20:22.34,Default,,0,0,0,,Өйткені сен соңғы олжасың.
Dialogue: 0,0:20:22.80,0:20:23.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:24.38,0:20:25.72,Default,,0,0,0,,Ой чемпион
Dialogue: 0,0:20:25.84,0:20:28.35,Default,,0,0,0,,Сіз жай ғана Аои Балттың кандидатурасынан бас тарттыңыз.
Dialogue: 0,0:20:29.26,0:20:30.10,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:20:30.93,0:20:36.10,Default,,0,0,0,,Жоюшы Құдайдың келесі олжасы кім болады, Фи?
Dialogue: 0,0:20:36.31,0:20:39.11,Default,,0,0,0,,(Шудың ауыр тыныс алуы)
Dialogue: 0,0:20:48.41,0:20:51.29,Default,,0,0,0,,Фи қорқынышты күшті болды.
Dialogue: 0,0:20:51.45,0:20:55.29,Default,,0,0,0,,Мен қазіргідей өзімді ұстай алмайтын шығармын.
Dialogue: 0,0:21:00.55,0:21:01.63,Default,,0,0,0,,Сіз шынымен барасыз ба?
Dialogue: 0,0:21:02.09,0:21:04.34,Default,,0,0,0,,А, мен шешіп қойдым.
Dialogue: 0,0:21:04.68,0:21:06.39,Default,,0,0,0,,Мен жаттығуға барамын
Dialogue: 0,0:21:06.97,0:21:09.39,Default,,0,0,0,,Файді жеңу үшін бе? Бұл дұрыс!
Dialogue: 0,0:21:09.68,0:21:12.39,Default,,0,0,0,,Мен оны жеңуім керек.
Dialogue: 0,0:21:12.60,0:21:15.27,Default,,0,0,0,,Біз міндетті түрде жеңуіміз керек!
Dialogue: 0,0:21:15.98,0:21:18.19,Default,,0,0,0,,Бірақ ол күшті
Dialogue: 0,0:21:18.73,0:21:20.48,Default,,0,0,0,,Фрилансер де жеңілді.
Dialogue: 0,0:21:21.65,0:21:24.78,Default,,0,0,0,,Сондықтан мен одан сайын күшейемін
Dialogue: 0,0:21:25.20,0:21:27.32,Default,,0,0,0,,Мен сол мақсатта жаттығамын.
Dialogue: 0,0:21:28.12,0:21:30.33,Default,,0,0,0,,Жалғыз болған дұрыс па?
Dialogue: 0,0:21:30.95,0:21:33.79,Default,,0,0,0,,Эй, біз келіп, мұны істей аламыз.
Dialogue: 0,0:21:33.91,0:21:34.79,Default,,0,0,0,,О
Dialogue: 0,0:21:35.16,0:21:37.12,Default,,0,0,0,,Мен өзімді бақытты сезінемін.
Dialogue: 0,0:21:37.25,0:21:40.09,Default,,0,0,0,,Бұл жолы мен және Ахиллес.
Dialogue: 0,0:21:40.54,0:21:44.59,Default,,0,0,0,,Мен ең күшті және жеңілмейтін Super Zetsu ретінде ораламын!
Dialogue: 0,0:21:44.72,0:21:45.76,Default,,0,0,0,,Хехе
Dialogue: 0,0:21:46.30,0:21:49.01,Default,,0,0,0,,Ал, кеттік!
Dialogue: 0,0:21:55.35,0:22:01.36,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:23:18.43,0:23:24.44,Default,,0,0,0,,~♪
Dialogue: 0,0:23:26.23,0:23:28.32,Default,,0,0,0,,Мен жаттығуға барамын.
Dialogue: 0,0:23:28.57,0:23:30.32,Default,,0,0,0,,Алдымен Жанның орнына барайық.
Dialogue: 0,0:23:30.99,0:23:32.91,Default,,0,0,0,,Не? осы стадион
Dialogue: 0,0:23:33.03,0:23:34.91,Default,,0,0,0,,концентрацияңызды жақсартыңыз
Dialogue: 0,0:23:35.66,0:23:39.12,Default,,0,0,0,,Қызық! Өте ыстық!
Dialogue: 0,0:23:39.58,0:23:42.17,Default,,0,0,0,,Келесі жолы «Beyblade Burst Super Zetsu»
Dialogue: 0,0:23:42.29,0:23:44.58,Default,,0,0,0,,“Super Zetsu Special Training Kingdom Edition!!”
Dialogue: 0,0:23:44.71,0:23:46.71,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:46.84,0:23:48.88,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:50.38,0:23:56.38,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory