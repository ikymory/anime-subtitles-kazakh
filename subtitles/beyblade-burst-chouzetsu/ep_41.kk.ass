Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.71,0:00:04.00,Default,,0,0,0,,Бейблейд
Dialogue: 0,0:00:04.12,0:00:08.50,Default,,0,0,0,,Мықты болуды мақсат еткен ұлдардың арманының жемісі.
Dialogue: 0,0:00:08.92,0:00:12.38,Default,,0,0,0,,Ал қазір супер Цетсу дәуірі қызып келеді.
Dialogue: 0,0:00:12.51,0:00:16.76,Default,,0,0,0,,Металл сауыт киіп, Беймен шытырман оқиғаға барыңыз!
Dialogue: 0,0:00:16.89,0:00:19.43,Default,,0,0,0,,Әлем чемпионы болуды мақсат етіңіз!
Dialogue: 0,0:00:19.56,0:00:23.64,Default,,0,0,0,,Super Zetsu Super Zetsu Super Zetsu!
Dialogue: 0,0:00:24.23,0:00:27.86,Default,,0,0,0,,Ең күшті және жеңілмейтін атағын алатын адам сенсің!
Dialogue: 0,0:00:31.15,0:00:34.40,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:00:34.78,0:00:37.24,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:00:37.66,0:00:38.83,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:00:44.83,0:00:47.33,Default,,0,0,0,,Жақсы! Бұл шықты, Super Zetsu Wing
Dialogue: 0,0:00:47.54,0:00:50.09,Default,,0,0,0,,Хаха~! Келді, келді, келді!
Dialogue: 0,0:00:55.22,0:00:59.93,Default,,0,0,0,,Қарғыс атсын! Өлі гравитация!
Dialogue: 0,0:01:02.89,0:01:06.44,Default,,0,0,0,,Super Z қорғанысы!
Dialogue: 0,0:01:08.90,0:01:11.86,Default,,0,0,0,,Оме не істейтінін болжай аласыз!
Dialogue: 0,0:01:13.69,0:01:14.53,Default,,0,0,0,,Ах
Dialogue: 0,0:01:17.20,0:01:19.53,Default,,0,0,0,,Жүр!
Dialogue: 0,0:01:22.79,0:01:25.16,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:29.46,0:01:31.59,Default,,0,0,0,,Бұл Ахиллес және мен...
Dialogue: 0,0:01:33.63,0:01:36.42,Default,,0,0,0,,Super Zetsu!
Dialogue: 0,0:01:37.93,0:01:41.72,Default,,0,0,0,,Super Z Buster!
Dialogue: 0,0:01:46.64,0:01:47.85,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:01:49.73,0:01:53.57,Default,,0,0,0,,Менің жеңілуіме ешқандай себеп болмауы керек еді.
Dialogue: 0,0:01:53.69,0:01:55.90,Default,,0,0,0,,Ахиллес Super Zetsu Awakened болса да
Dialogue: 0,0:01:56.03,0:02:00.49,Default,,0,0,0,,Өлі өлілердің жеңіске жету ықтималдығы 80%-дан астам болды.
Dialogue: 0,0:02:02.53,0:02:05.16,Default,,0,0,0,,Сонда не болды?
Dialogue: 0,0:02:06.58,0:02:07.58,Default,,0,0,0,,Куу…
Dialogue: 0,0:02:09.54,0:02:15.55,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:03:32.21,0:03:38.21,Default,,0,0,0,,~♪
Dialogue: 0,0:03:47.68,0:03:50.27,Default,,0,0,0,,Super Z Ахиллес өлі тартылыс күшіне қалай төтеп берді
Dialogue: 0,0:03:50.39,0:03:51.85,Default,,0,0,0,,Бұл есептен тыс болды.
Dialogue: 0,0:03:53.02,0:03:56.27,Default,,0,0,0,,Ол кезде Айға Ахиллеске қосылған.
Dialogue: 0,0:03:56.98,0:04:01.90,Default,,0,0,0,,Бұл Айғаның күш-қуатын күткеннен де жоғарылатуы әбден мүмкін.
Dialogue: 0,0:04:02.03,0:04:03.36,Default,,0,0,0,,Хаха~! а?
Dialogue: 0,0:04:03.82,0:04:07.83,Default,,0,0,0,,Ол мені мәңгілікке қуантатын адам.
Dialogue: 0,0:04:07.95,0:04:09.41,Default,,0,0,0,,Қызыл жүзді Айга
Dialogue: 0,0:04:09.99,0:04:12.87,Default,,0,0,0,,Дайынсыз ба, доктор Айбел?
Dialogue: 0,0:04:13.46,0:04:14.37,Default,,0,0,0,,Иә
Dialogue: 0,0:04:16.25,0:04:19.55,Default,,0,0,0,,Жаңадан жақсартылған Super Z Musou стадионы
Dialogue: 0,0:04:19.96,0:04:22.55,Default,,0,0,0,,Сол Аполлос пен Жарық Артемиданың күші
Dialogue: 0,0:04:22.92,0:04:26.76,Default,,0,0,0,,Super Z Ахиллес және Super Z Valkyrie's
Dialogue: 0,0:04:26.89,0:04:28.68,Default,,0,0,0,,Дәл солай түзетілді
Dialogue: 0,0:04:32.68,0:04:33.94,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:04:36.81,0:04:39.02,Default,,0,0,0,,Оны міндетті түрде жойыңыз!
Dialogue: 0,0:04:47.12,0:04:49.78,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:04:55.79,0:04:57.50,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:57.88,0:04:59.96,Default,,0,0,0,,Міне, мынау!
Dialogue: 0,0:05:00.09,0:05:03.01,Default,,0,0,0,,Бұл нағыз резонанс!
Dialogue: 0,0:05:03.26,0:05:04.47,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:05:14.27,0:05:15.60,Default,,0,0,0,,Феникс
Dialogue: 0,0:05:16.02,0:05:17.77,Default,,0,0,0,,Мен сізге жақында ойнауға рұқсат етемін
Dialogue: 0,0:05:18.44,0:05:20.44,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:05:23.74,0:05:25.78,Default,,0,0,0,,Фи, ойнайық
Dialogue: 0,0:05:26.49,0:05:29.49,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:05:31.99,0:05:33.45,Default,,0,0,0,,Алыңдар, жүректер.
Dialogue: 0,0:05:33.91,0:05:35.96,Default,,0,0,0,,Жарайсыңдар! Хехе
Dialogue: 0,0:05:37.25,0:05:38.08,Default,,0,0,0,,Ах
Dialogue: 0,0:05:38.83,0:05:39.67,Default,,0,0,0,,Ажырасудың жоспары болуы керек емес пе деп ойламайсың ба?
Dialogue: 0,0:05:42.71,0:05:43.55,Default,,0,0,0,,Хехехе
Dialogue: 0,0:05:44.13,0:05:47.34,Default,,0,0,0,,Мен Фай сияқты жақсы болғым келеді.
Dialogue: 0,0:05:47.72,0:05:50.39,Default,,0,0,0,,Менің айтқанымды орындасаң, жақсарасың.
Dialogue: 0,0:05:50.51,0:05:51.35,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:05:51.72,0:05:52.85,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:05:54.68,0:05:55.60,Default,,0,0,0,,Иә
Dialogue: 0,0:05:55.73,0:05:56.85,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:05:59.27,0:06:00.65,Default,,0,0,0,,Құрметті Фай Құрметті жүректер
Dialogue: 0,0:06:00.77,0:06:01.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:02.02,0:06:07.53,Default,,0,0,0,,Екеуің туған күніңе әкелеріңнен сыйлық алдыңдар.
Dialogue: 0,0:06:07.65,0:06:09.24,Default,,0,0,0,,Оны тез ашыңыз.
Dialogue: 0,0:06:09.36,0:06:10.62,Default,,0,0,0,,Біз жас бәсекелестер ақыл-парасатымыз таусылып, әбден таңырқап қаламыз, солай ма~?
Dialogue: 0,0:06:14.70,0:06:15.79,Default,,0,0,0,,Уау! Ах...
Dialogue: 0,0:06:16.58,0:06:19.83,Default,,0,0,0,,Менің әкеңнен хабар бар.
Dialogue: 0,0:06:19.96,0:06:24.25,Default,,0,0,0,,«Phi Hearts мен екеуіңе де Бей сыйлаймын»
Dialogue: 0,0:06:25.05,0:06:27.67,Default,,0,0,0,,«Мен пайдаланатынмын.»
Dialogue: 0,0:06:27.80,0:06:31.39,Default,,0,0,0,,«Сендер мұнымен көңілдерің қалағанша ойнауларың керек».
Dialogue: 0,0:06:31.51,0:06:32.80,Default,,0,0,0,,Мен осылаймын!
Dialogue: 0,0:06:32.93,0:06:35.64,Default,,0,0,0,,Иә! Мен мұны әрқашан қалағанмын
Dialogue: 0,0:06:37.27,0:06:39.27,Default,,0,0,0,,Мен біріншімін (Жүректер) Ах...
Dialogue: 0,0:06:39.56,0:06:41.52,Default,,0,0,0,,Жүректерді қайтару
Dialogue: 0,0:06:42.31,0:06:43.15,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:06:43.44,0:06:44.27,Default,,0,0,0,,Ах
Dialogue: 0,0:06:44.65,0:06:47.49,Default,,0,0,0,,Жоқ! Бұл Жүрек
Dialogue: 0,0:06:47.61,0:06:48.74,Default,,0,0,0,,Оны қайтар!
Dialogue: 0,0:06:48.86,0:06:51.57,Default,,0,0,0,,Сіз әрқашан Фиге ұнайтынын таңдайсыз ба?
Dialogue: 0,0:06:51.70,0:06:53.28,Default,,0,0,0,,Бұл жүректер!
Dialogue: 0,0:06:59.66,0:07:01.54,Default,,0,0,0,,Бұл менікі.
Dialogue: 0,0:07:03.13,0:07:04.88,Default,,0,0,0,,Мен Фиді жек көремін!
Dialogue: 0,0:07:05.25,0:07:07.38,Default,,0,0,0,,Мен де сені жек көремін.
Dialogue: 0,0:07:08.17,0:07:10.30,Default,,0,0,0,,Екеуің де тоқтаңдар.
Dialogue: 0,0:07:10.55,0:07:11.68,Default,,0,0,0,,Екі шығанақ
Dialogue: 0,0:07:11.80,0:07:14.60,Default,,0,0,0,,Әкеңнің қастерлейтіні.
Dialogue: 0,0:07:21.02,0:07:22.77,Default,,0,0,0,,Бұл шығанақты қалай атайды?
Dialogue: 0,0:07:23.35,0:07:25.48,Default,,0,0,0,,Менің атым Феникс.
Dialogue: 0,0:07:26.77,0:07:28.07,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:07:28.36,0:07:29.90,Default,,0,0,0,,Бұл Аид.
Dialogue: 0,0:07:30.03,0:07:31.28,Default,,0,0,0,,Қайсысы күшті?
Dialogue: 0,0:07:31.95,0:07:35.45,Default,,0,0,0,,Бұл сіз қолданатын пышаққа байланысты.
Dialogue: 0,0:07:37.54,0:07:38.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:42.71,0:07:44.54,Default,,0,0,0,,Мұны сізге жасаңыз
Dialogue: 0,0:07:48.75,0:07:51.05,Default,,0,0,0,,Барамыз ба?
Dialogue: 0,0:07:51.17,0:07:53.63,Default,,0,0,0,,Super Zetsubei Фениксті тірілтеді
Dialogue: 0,0:07:54.47,0:07:56.30,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:08:04.19,0:08:06.81,Default,,0,0,0,,Өлі импульс!
Dialogue: 0,0:08:13.91,0:08:14.74,Default,,0,0,0,,Жарайды
Dialogue: 0,0:08:15.70,0:08:16.99,Default,,0,0,0,,Жүректерден күткендей
Dialogue: 0,0:08:18.08,0:08:22.29,Default,,0,0,0,,Екі ұя Super Zetsu Awakening Bay сияқты қуат деңгейіне орнатылған.
Dialogue: 0,0:08:22.41,0:08:23.71,Default,,0,0,0,,Қазірдің өзінде бағындырылды
Dialogue: 0,0:08:24.33,0:08:26.75,Default,,0,0,0,,Тағы бір рет орнатыңыз.
Dialogue: 0,0:08:28.50,0:08:29.34,Default,,0,0,0,,Әй?
Dialogue: 0,0:08:29.50,0:08:30.34,Default,,0,0,0,,Ах
Dialogue: 0,0:08:31.13,0:08:32.51,Default,,0,0,0,,Бұл не үшін?
Dialogue: 0,0:08:32.97,0:08:35.59,Default,,0,0,0,,Жаңа ғана менің үйіме қайтып келдім
Dialogue: 0,0:08:36.05,0:08:37.64,Default,,0,0,0,,Жұмсақ…
Dialogue: 0,0:08:37.76,0:08:41.89,Default,,0,0,0,,Өлі әже – менің сарайым, ол сенің орның емес.
Dialogue: 0,0:08:42.02,0:08:43.31,Default,,0,0,0,,Қазір кет!
Dialogue: 0,0:08:43.64,0:08:46.85,Default,,0,0,0,,Өзгеге тиесілі нәрсені өз меншігіне айналдырғысы келетіндер
Dialogue: 0,0:08:46.98,0:08:48.52,Default,,0,0,0,,Бұл сенің жаман әдетің.
Dialogue: 0,0:08:48.86,0:08:49.69,Default,,0,0,0,,Не!
Dialogue: 0,0:08:50.94,0:08:52.32,Default,,0,0,0,,Қызыл жүзді Айга
Dialogue: 0,0:08:52.57,0:08:53.40,Default,,0,0,0,,Ах
Dialogue: 0,0:08:54.03,0:08:56.20,Default,,0,0,0,,Бұл менің ойыншығым.
Dialogue: 0,0:08:56.32,0:08:59.53,Default,,0,0,0,,Осыны біле тұра, сіз араластыңыз.
Dialogue: 0,0:09:01.33,0:09:04.71,Default,,0,0,0,,Жүректер, сен менің інімсің
Dialogue: 0,0:09:05.29,0:09:07.17,Default,,0,0,0,,Сондықтан менің заттарыммен ойнағаныңды қаламаймын.
Dialogue: 0,0:09:07.29,0:09:08.79,Default,,0,0,0,,Мен кешірдім.
Dialogue: 0,0:09:09.71,0:09:12.59,Default,,0,0,0,,Бірақ мен мұны бүгінге аяқтаймын.
Dialogue: 0,0:09:13.63,0:09:14.76,Default,,0,0,0,,Не?
Dialogue: 0,0:09:15.22,0:09:18.72,Default,,0,0,0,,Қайтарып ал, Саған қалдырғанымды
Dialogue: 0,0:09:19.60,0:09:20.68,Default,,0,0,0,,Барлығы
Dialogue: 0,0:09:21.14,0:09:23.22,Default,,0,0,0,,Уф... қызық
Dialogue: 0,0:09:23.35,0:09:27.14,Default,,0,0,0,,Phi! Мен сенімен біраз уақыттан кейін бірінші рет ойнаймын
Dialogue: 0,0:09:27.27,0:09:29.19,Default,,0,0,0,,Жұмсақ…
Dialogue: 0,0:09:39.41,0:09:41.08,Default,,0,0,0,,Phi және жүректер
Dialogue: 0,0:09:41.45,0:09:44.08,Default,,0,0,0,,Бұл шайқастан жақсы деректер алуға болады.
Dialogue: 0,0:09:45.04,0:09:47.58,Default,,0,0,0,,Ой!
Dialogue: 0,0:09:48.21,0:09:50.84,Default,,0,0,0,,Шулы! Бұл не, Айга?
Dialogue: 0,0:09:51.42,0:09:54.09,Default,,0,0,0,,Шулы! Неге Ахиллес...
Dialogue: 0,0:09:54.21,0:09:55.84,Default,,0,0,0,,Оян!
Dialogue: 0,0:09:56.84,0:09:58.68,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:09:59.89,0:10:01.93,Default,,0,0,0,,Оян!
Dialogue: 0,0:10:03.31,0:10:05.73,Default,,0,0,0,,О, Сочо?
Dialogue: 0,0:10:06.23,0:10:09.65,Default,,0,0,0,,
Dialogue: 0,0:10:10.44,0:10:15.32,Default,,0,0,0,,Ол түсінде Ахиллді Фи қиратқанын айтты.
Dialogue: 0,0:10:15.94,0:10:17.45,Default,,0,0,0,,бірақ мен де, Ято да ақша табуымыз керек қой!
Dialogue: 0,0:10:17.57,0:10:20.07,Default,,0,0,0,,Мен оны көргім келгендіктен ғана қарап отырған жоқпын.
Dialogue: 0,0:10:20.45,0:10:23.37,Default,,0,0,0,,Ей, мынау жылқы марал.
Dialogue: 0,0:10:23.49,0:10:24.66,Default,,0,0,0,,Бұл жарақат.
Dialogue: 0,0:10:24.79,0:10:26.45,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,0:10:26.95,0:10:28.33,Default,,0,0,0,,Фи жігіті
Dialogue: 0,0:10:28.46,0:10:31.33,Default,,0,0,0,,Келесі кездескенімде, мен сені міндетті түрде құртамын.
Dialogue: 0,0:10:31.46,0:10:33.17,Default,,0,0,0,,Сәлем Ахиллес
Dialogue: 0,0:10:34.71,0:10:36.09,Default,,0,0,0,,Айга~! (2 адам) Әй?
Dialogue: 0,0:10:36.21,0:10:37.55,Default,,0,0,0,,Қатты! қиын!
Dialogue: 0,0:10:38.01,0:10:40.09,Default,,0,0,0,,Не болды? Нару
Dialogue: 0,0:10:43.55,0:10:44.93,Default,,0,0,0,,Phi!
Dialogue: 0,0:10:45.06,0:10:49.85,Default,,0,0,0,,Маған тағзым еткеніңді бүкіл әлем көрсін.
Dialogue: 0,0:10:49.98,0:10:52.65,Default,,0,0,0,,Көрсетілім уақыты басталды.
Dialogue: 0,0:10:52.98,0:10:54.61,Default,,0,0,0,,Гухахаха
Dialogue: 0,0:10:54.73,0:10:57.15,Default,,0,0,0,,Жарайсыңдар жаман ұлдар мен қыздар
Dialogue: 0,0:10:57.28,0:10:59.11,Default,,0,0,0,,Назар аударыңыз
Dialogue: 0,0:10:59.24,0:11:00.40,Default,,0,0,0,,Өлі Колизейден
Dialogue: 0,0:11:00.53,0:11:03.74,Default,,0,0,0,,Біз супер шайқасты көрсететін боламыз!
Dialogue: 0,0:11:04.87,0:11:09.21,Default,,0,0,0,,Хаха~! Менің Пасха мерекесіне қош келдіңіз
Dialogue: 0,0:11:09.62,0:11:12.08,Default,,0,0,0,,Бүгінгі құрбандық – осы кісі.
Dialogue: 0,0:11:12.88,0:11:14.34,Default,,0,0,0,,Бұл Phi!
Dialogue: 0,0:11:14.84,0:11:17.59,Default,,0,0,0,,Дәл солай, соңғы рет үргеніңіз.
Dialogue: 0,0:11:17.71,0:11:19.22,Default,,0,0,0,,мұнда тұтқындарды пайдаланып көмір қазылады
Dialogue: 0,0:11:19.76,0:11:23.72,Default,,0,0,0,,Жеңіске жетудің жалғыз жолы - жару. Одан басқа амал жоқ.
Dialogue: 0,0:11:25.85,0:11:27.72,Default,,0,0,0,,
Dialogue: 0,0:11:28.22,0:11:29.35,Default,,0,0,0,,Бұл жігіт...
Dialogue: 0,0:11:29.48,0:11:31.23,Default,,0,0,0,,Бұл тікелей эфирдегі бейне.
Dialogue: 0,0:11:31.35,0:11:32.73,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:11:34.48,0:11:35.90,Default,,0,0,0,,Fi…
Dialogue: 0,0:11:37.07,0:11:40.61,Default,,0,0,0,,Бұл шайқасатын Phi Hearts ағалары.
Dialogue: 0,0:11:41.32,0:11:43.61,Default,,0,0,0,,Фай Өлі Гранда пайда болады
Dialogue: 0,0:11:44.49,0:11:48.12,Default,,0,0,0,,Мен кенеттен Лорд Жүректерді шайқасқа шақырдым.
Dialogue: 0,0:11:49.08,0:11:50.33,Default,,0,0,0,,Phi
Dialogue: 0,0:11:50.45,0:11:54.42,Default,,0,0,0,,Мен сенімен бір күні мәселені шешуім керек деп ойладым.
Dialogue: 0,0:12:00.01,0:12:01.38,Default,,0,0,0,,Сіз кетесіз бе?
Dialogue: 0,0:12:01.76,0:12:03.88,Default,,0,0,0,,Мен енді сенімен ойнай алмаймын.
Dialogue: 0,0:12:04.39,0:12:05.51,Default,,0,0,0,,Неге екен?
Dialogue: 0,0:12:05.64,0:12:07.81,Default,,0,0,0,,Сіз білуіңіз керек.
Dialogue: 0,0:12:08.22,0:12:11.56,Default,,0,0,0,,Мен және Аид резонанс тудырып, күшейгендіктен бе?
Dialogue: 0,0:12:12.06,0:12:12.89,Default,,0,0,0,,Иә
Dialogue: 0,0:12:13.44,0:12:15.94,Default,,0,0,0,,Сіз қызықсыз
Dialogue: 0,0:12:16.36,0:12:18.07,Default,,0,0,0,,Не? Не дейсіз...
Dialogue: 0,0:12:18.19,0:12:19.11,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:12:19.23,0:12:20.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:25.74,0:12:26.74,Default,,0,0,0,,Жылдам… бірақ әлі де менің қашықтығымда.
Dialogue: 0,0:12:30.16,0:12:33.16,Default,,0,0,0,,Фай!
Dialogue: 0,0:12:36.75,0:12:39.84,Default,,0,0,0,,Мен енді ағамды қорлауыңа жол бермеймін.
Dialogue: 0,0:12:42.88,0:12:43.84,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:12:45.09,0:12:48.68,Default,,0,0,0,,Бүгін мен Феникске нүкте қоямын!
Dialogue: 0,0:12:50.56,0:12:52.56,Default,,0,0,0,,Иә, сіз мұны істей аласыз ба?
Dialogue: 0,0:12:53.35,0:12:55.35,Default,,0,0,0,,Эй, мен мұны істей аламын.
Dialogue: 0,0:12:55.94,0:12:57.48,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:12:58.27,0:13:00.98,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:13:01.40,0:13:04.40,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:13:04.70,0:13:05.95,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:13:07.66,0:13:10.66,Default,,0,0,0,,Финикс бірінші орынға шықты!
Dialogue: 0,0:13:11.33,0:13:12.45,Default,,0,0,0,,(Киё) Танжиро-сан, сен барынша тырысып жатырсың. (Суми) Иә!
Dialogue: 0,0:13:13.16,0:13:15.21,Default,,0,0,0,,Бірақ Аид асығыс!
Dialogue: 0,0:13:15.33,0:13:17.96,Default,,0,0,0,,Бұл Феникске шабуыл жасайды!
Dialogue: 0,0:13:18.08,0:13:21.46,Default,,0,0,0,,Уау! Міне осы!
Dialogue: 0,0:13:21.84,0:13:25.72,Default,,0,0,0,,Бұл мен және Өлі Адес арасындағы резонанс!
Dialogue: 0,0:13:26.09,0:13:29.30,Default,,0,0,0,,Бейді осылай биледім деп ойлаймын.
Dialogue: 0,0:13:29.43,0:13:31.18,Default,,0,0,0,,Бұл сіздің тәкаппарлығыңыз.
Dialogue: 0,0:13:31.72,0:13:35.31,Default,,0,0,0,,Шулы! Мен бұл ауызды бірден жабамын
Dialogue: 0,0:13:35.85,0:13:40.06,Default,,0,0,0,,Хя~хаха~!
Dialogue: 0,0:13:41.57,0:13:43.32,Default,,0,0,0,,Ажал!
Dialogue: 0,0:13:48.57,0:13:51.16,Default,,0,0,0,,Өлі импульс!
Dialogue: 0,0:13:58.79,0:14:03.05,Default,,0,0,0,,Өлі өлілердің ерекше қозғалысы Феникс болып шешілді!
Dialogue: 0,0:14:03.30,0:14:04.46,Default,,0,0,0,,Чип… Чип, чип!
Dialogue: 0,0:14:04.84,0:14:06.38,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:14:07.30,0:14:10.18,Default,,0,0,0,,Хаха~! Келесі жолы жарылайық!
Dialogue: 0,0:14:10.72,0:14:12.18,Default,,0,0,0,,
Dialogue: 0,0:14:12.56,0:14:15.02,Default,,0,0,0,,Жүректердің күші артады
Dialogue: 0,0:14:15.14,0:14:17.69,Default,,0,0,0,,Бірақ Фи әлі де аздап босады.
Dialogue: 0,0:14:18.14,0:14:20.65,Default,,0,0,0,,Қайсысы күшті?
Dialogue: 0,0:14:24.19,0:14:28.20,Default,,0,0,0,,Екінші шайқаста Жүрек-саманың шабуылы қайтадан жарылады.
Dialogue: 0,0:14:28.65,0:14:30.70,Default,,0,0,0,,Фениксті басып алу
Dialogue: 0,0:14:33.49,0:14:35.70,Default,,0,0,0,,Жүр! Аян!
Dialogue: 0,0:14:38.83,0:14:40.71,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:44.30,0:14:45.92,Default,,0,0,0,,Шешілді!
Dialogue: 0,0:14:46.05,0:14:48.84,Default,,0,0,0,,Жүректер-саманың құдіреті шексіз!
Dialogue: 0,0:14:49.30,0:14:51.34,Default,,0,0,0,,Феникстен қорықпа
Dialogue: 0,0:14:51.93,0:14:55.22,Default,,0,0,0,,Дегенмен, Phi де жарылысқа қарсы иммунитетке ие.
Dialogue: 0,0:14:57.14,0:14:58.48,Default,,0,0,0,,Хаха~
Dialogue: 0,0:14:58.60,0:15:00.98,Default,,0,0,0,,Егер бұл кәдімгі шайқас болса, ол әлдеқашан аяқталды.
Dialogue: 0,0:15:01.31,0:15:04.32,Default,,0,0,0,,Бұл қарапайым шайқас емес.
Dialogue: 0,0:15:06.15,0:15:07.11,Default,,0,0,0,,Үшінші шайқас
Dialogue: 0,0:15:07.57,0:15:09.61,Default,,0,0,0,,Енді тағы бір рет.
Dialogue: 0,0:15:09.99,0:15:12.36,Default,,0,0,0,,Осы жолы жарып жіберейік!
Dialogue: 0,0:15:12.49,0:15:14.37,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:15:14.95,0:15:18.12,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:15:18.41,0:15:21.54,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:15:22.25,0:15:23.08,Default,,0,0,0,,Әй!
Dialogue: 0,0:15:29.51,0:15:31.43,Default,,0,0,0,,Гуах! Уф!
Dialogue: 0,0:15:40.43,0:15:41.73,Default,,0,0,0,,Шешілді!
Dialogue: 0,0:15:41.85,0:15:44.61,Default,,0,0,0,,Бұл жолы Феникс кеш қонды.
Dialogue: 0,0:15:44.73,0:15:45.56,Default,,0,0,0,,Tsk
Dialogue: 0,0:15:45.86,0:15:49.11,Default,,0,0,0,,Финикс аяқтады
Dialogue: 0,0:15:49.44,0:15:51.32,Default,,0,0,0,,Жарылып кетпеңіз
Dialogue: 0,0:15:51.45,0:15:53.57,Default,,0,0,0,,Енді тағы бір рет.
Dialogue: 0,0:15:56.99,0:15:57.83,Default,,0,0,0,,Гуа!
Dialogue: 0,0:16:00.25,0:16:01.08,Default,,0,0,0,,Уф!
Dialogue: 0,0:16:03.37,0:16:04.58,Default,,0,0,0,,Дио…
Dialogue: 0,0:16:07.59,0:16:09.76,Default,,0,0,0,,Қайтадан аяқтаңыз
Dialogue: 0,0:16:09.88,0:16:12.68,Default,,0,0,0,,Бұл екеуінің шайқасы ешқашан бітпейді.
Dialogue: 0,0:16:13.97,0:16:16.68,Default,,0,0,0,,Менің резонансым күшті болуы керек.
Dialogue: 0,0:16:18.10,0:16:20.02,Default,,0,0,0,,Сіз әлі білмейсіз бе?
Dialogue: 0,0:16:22.18,0:16:23.02,Default,,0,0,0,,Ах
Dialogue: 0,0:16:24.31,0:16:25.15,Default,,0,0,0,,Һм? Бұл не?
Dialogue: 0,0:16:33.28,0:16:35.49,Default,,0,0,0,,Қайта жарылмайды
Dialogue: 0,0:16:35.61,0:16:37.07,Default,,0,0,0,,Неше бөлік бар?
Dialogue: 0,0:16:37.45,0:16:39.70,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:16:40.83,0:16:44.25,Default,,0,0,0,,Неліктен? Неліктен ауырсынуды сезбейсіз?
Dialogue: 0,0:16:45.04,0:16:48.17,Default,,0,0,0,,Сіз бәрін қайтарып аламын деп ойладым.
Dialogue: 0,0:16:48.92,0:16:50.59,Default,,0,0,0,,
Dialogue: 0,0:16:50.96,0:16:53.09,Default,,0,0,0,,Жүректер біртүрлі әрекет етеді.
Dialogue: 0,0:16:53.22,0:16:56.14,Default,,0,0,0,,Бейдің ауырғанын сезбейді.
Dialogue: 0,0:16:56.26,0:16:57.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:57.68,0:17:00.22,Default,,0,0,0,,Фи, сен не істейсің?
Dialogue: 0,0:17:01.18,0:17:04.06,Default,,0,0,0,,Өлі импульс!
Dialogue: 0,0:17:04.77,0:17:08.61,Default,,0,0,0,,Жүрек-саманың шабуылдары бірінен соң бірі келеді!
Dialogue: 0,0:17:08.81,0:17:11.36,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:11.86,0:17:12.86,Default,,0,0,0,,Міне!
Dialogue: 0,0:17:12.99,0:17:14.86,Default,,0,0,0,,Міне, мынау!
Dialogue: 0,0:17:15.57,0:17:18.62,Default,,0,0,0,,Оның мұндай күші әлі де болды ма?
Dialogue: 0,0:17:19.49,0:17:20.58,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:17:24.50,0:17:26.50,Default,,0,0,0,,Көбірек күресу
Dialogue: 0,0:17:31.25,0:17:34.88,Default,,0,0,0,,Ха... Сіз қанша уақытқа дейін жалғастыруды жоспарлайсыз?
Dialogue: 0,0:17:36.80,0:17:40.18,Default,,0,0,0,,Мен сенен бәрін қайтарып алғанша.
Dialogue: 0,0:17:40.47,0:17:43.10,Default,,0,0,0,,Хаа ха
Dialogue: 0,0:17:43.56,0:17:46.19,Default,,0,0,0,,Сіздің мақсатыңыз... Ах.
Dialogue: 0,0:17:46.73,0:17:48.23,Default,,0,0,0,,Бұл жүректер
Dialogue: 0,0:17:52.11,0:17:54.11,Default,,0,0,0,,Бұл менікі.
Dialogue: 0,0:17:56.03,0:17:58.28,Default,,0,0,0,,Ха...хаха~!
Dialogue: 0,0:17:58.41,0:18:00.62,Default,,0,0,0,,Қандай жігіт, Фай!
Dialogue: 0,0:18:00.74,0:18:04.54,Default,,0,0,0,,Мен сіздің табандылығыңызды құрметтеймін!
Dialogue: 0,0:18:05.00,0:18:06.41,Default,,0,0,0,,Рахмет
Dialogue: 0,0:18:10.13,0:18:15.76,Default,,0,0,0,,Мен осы Аидті қолыма ұстағанымда, мен сені бірінші рет жеңгендей болдым.
Dialogue: 0,0:18:15.88,0:18:19.89,Default,,0,0,0,,Сосын сені жеңу мен үшін бәрі болды!
Dialogue: 0,0:18:20.26,0:18:22.05,Default,,0,0,0,,Енді бәрі бітті.
Dialogue: 0,0:18:22.39,0:18:25.27,Default,,0,0,0,,Мен сені жеңемін!
Dialogue: 0,0:18:29.56,0:18:30.65,Default,,0,0,0,,Жетінші шайқас
Dialogue: 0,0:18:31.11,0:18:31.94,Default,,0,0,0,,Хэ хун
Dialogue: 0,0:18:33.90,0:18:35.36,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:18:36.24,0:18:38.86,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:18:39.49,0:18:42.57,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:18:43.08,0:18:43.91,Default,,0,0,0,,Гуах!
Dialogue: 0,0:18:44.66,0:18:46.50,Default,,0,0,0,,Аид пен Феникс
Dialogue: 0,0:18:46.62,0:18:49.71,Default,,0,0,0,,Стадионға екі шығанақ шығарылды!
Dialogue: 0,0:18:49.96,0:18:51.67,Default,,0,0,0,,Бұл бетпе-бет шайқас.
Dialogue: 0,0:18:52.04,0:18:56.05,Default,,0,0,0,,Аид! Өлі гравитация!
Dialogue: 0,0:19:00.51,0:19:03.18,Default,,0,0,0,,Резонансыңызды үзіңіз
Dialogue: 0,0:19:04.76,0:19:05.97,Default,,0,0,0,,Уф
Dialogue: 0,0:19:06.35,0:19:10.85,Default,,0,0,0,,Менің резонансым ең күшті!
Dialogue: 0,0:19:13.15,0:19:16.11,Default,,0,0,0,,Уау! Феникс!
Dialogue: 0,0:19:20.28,0:19:21.36,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:19:36.38,0:19:38.96,Default,,0,0,0,,Armor Press құралын жандандырыңыз!
Dialogue: 0,0:19:51.06,0:19:52.60,Default,,0,0,0,,Ахх (шығанақтың құлаған дыбысы)
Dialogue: 0,0:19:52.98,0:19:54.69,Default,,0,0,0,,Шешілді!
Dialogue: 0,0:19:54.81,0:19:56.61,Default,,0,0,0,,Не, не!
Dialogue: 0,0:19:56.73,0:19:59.48,Default,,0,0,0,,Феникс Аидті жояды!
Dialogue: 0,0:19:59.99,0:20:02.86,Default,,0,0,0,,Өлі өлі өлді!
Dialogue: 0,0:20:03.24,0:20:05.20,Default,,0,0,0,,Мен сенің өлуге жол бермеймін
Dialogue: 0,0:20:05.62,0:20:09.16,Default,,0,0,0,,Аид Фениксте тұрады
Dialogue: 0,0:20:09.54,0:20:12.25,Default,,0,0,0,,болуы тиіс
Dialogue: 0,0:20:12.37,0:20:14.37,Default,,0,0,0,,
Dialogue: 0,0:20:15.29,0:20:16.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:29.35,0:20:32.35,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:36.15,0:20:37.94,Default,,0,0,0,,Айгаға не болды?
Dialogue: 0,0:20:38.07,0:20:39.19,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:20:40.15,0:20:40.98,Default,,0,0,0,,Айга?
Dialogue: 0,0:20:42.44,0:20:43.90,Default,,0,0,0,,Ештеңе
Dialogue: 0,0:20:47.12,0:20:48.74,Default,,0,0,0,,Бұл ештеңе емес.
Dialogue: 0,0:20:51.62,0:20:54.12,Default,,0,0,0,,Менде Ахиллес бар!
Dialogue: 0,0:20:57.83,0:21:01.00,Default,,0,0,0,,Мен мұндай шайқастарды құптамаймын.
Dialogue: 0,0:21:06.55,0:21:09.18,Default,,0,0,0,,Аид Феникспен біртұтас болады
Dialogue: 0,0:21:09.30,0:21:10.85,Default,,0,0,0,,Жандану
Dialogue: 0,0:21:22.40,0:21:23.53,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:21:33.29,0:21:36.21,Default,,0,0,0,,Өлі Феникс аяқталды
Dialogue: 0,0:21:36.67,0:21:38.50,Default,,0,0,0,,Өлі Феникс
Dialogue: 0,0:21:38.67,0:21:41.17,Default,,0,0,0,,Бұл ең күшті шығанақ
Dialogue: 0,0:21:46.01,0:21:51.10,Default,,0,0,0,,Мен – Қиратушы Тәңірмін, Бүкіл Бейді құртамын!
Dialogue: 0,0:21:55.02,0:22:01.02,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:23:17.47,0:23:23.48,Default,,0,0,0,,~♪
Dialogue: 0,0:23:25.44,0:23:28.65,Default,,0,0,0,,Йонекома академиясына екі деңгейлі стадион келді!
Dialogue: 0,0:23:28.78,0:23:30.70,Default,,0,0,0,,Уау! Сіз секіре алмайсыз ба?
Dialogue: 0,0:23:30.82,0:23:32.41,Default,,0,0,0,,Уау!
Dialogue: 0,0:23:32.53,0:23:34.78,Default,,0,0,0,,Жарайды, бірден шайқасайық.
Dialogue: 0,0:23:34.91,0:23:36.79,Default,,0,0,0,,Ахиллеспен бірге бәрін құртамын
Dialogue: 0,0:23:37.45,0:23:40.12,Default,,0,0,0,,дегеніміз не? Бұл мүмкін бе?
Dialogue: 0,0:23:40.25,0:23:42.21,Default,,0,0,0,,Келесі жолы «Beyblade Burst Super Zetsu»
Dialogue: 0,0:23:42.71,0:23:44.96,Default,,0,0,0,,"Батл Royale! Стратегиялық операция!!"
Dialogue: 0,0:23:45.09,0:23:46.59,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:46.84,0:23:48.96,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:50.46,0:23:56.46,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory