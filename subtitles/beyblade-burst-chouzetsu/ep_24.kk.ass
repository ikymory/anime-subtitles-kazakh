Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.92,0:00:06.29,Default,,0,0,0,,Жауынгерлік кеме круизі!
Dialogue: 0,0:00:06.42,0:00:09.50,Default,,0,0,0,,Біз қазір борттағы Бладерлермен бірге жүземіз.
Dialogue: 0,0:00:13.43,0:00:17.76,Default,,0,0,0,,Сізді супер Цетсудың жарқыраған теңізі күтіп тұр
Dialogue: 0,0:00:17.93,0:00:21.89,Default,,0,0,0,,Алда ең күшті және жеңілмейтін атақ күтіп тұр.
Dialogue: 0,0:00:22.48,0:00:27.23,Default,,0,0,0,,Жүр, Бейблейдпен шытырман оқиғаға барайық.
Dialogue: 0,0:00:27.31,0:00:29.94,Default,,0,0,0,,Super Zetsu-дан басқа!
Dialogue: 0,0:00:31.23,0:00:34.24,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:00:34.74,0:00:37.12,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:00:37.45,0:00:38.28,Default,,0,0,0,,Ухё!
Dialogue: 0,0:00:39.78,0:00:42.58,Default,,0,0,0,,Battleship Cruise жеке шайқасы басталды
Dialogue: 0,0:00:44.04,0:00:48.00,Default,,0,0,0,,Мен Лабанмен қызу шайқаста жеңдім!
Dialogue: 0,0:00:49.67,0:00:53.47,Default,,0,0,0,,Ал Фай Кайлды басым күшпен жеңді.
Dialogue: 0,0:00:54.30,0:00:57.14,Default,,0,0,0,,Фубуки мен Суоу арасындағы шайқас...
Dialogue: 0,0:00:57.22,0:00:59.51,Default,,0,0,0,,Фубукидің жеңісімен Суох ойыннан шығады.
Dialogue: 0,0:00:59.80,0:01:00.76,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:01:01.31,0:01:04.02,Default,,0,0,0,,Желді темір қанаттарымен айналдыр!
Dialogue: 0,0:01:04.89,0:01:08.65,Default,,0,0,0,,Рагнарук дауылы!
Dialogue: 0,0:01:08.98,0:01:10.11,Default,,0,0,0,,Ой!
Dialogue: 0,0:01:10.19,0:01:13.61,Default,,0,0,0,,Excalibur Сіз қатты тербеліп жатырсыз!
Dialogue: 0,0:01:14.11,0:01:17.45,Default,,0,0,0,,Бесінші әсер!
Dialogue: 0,0:01:20.41,0:01:22.45,Default,,0,0,0,,Сочо да...
Dialogue: 0,0:01:24.08,0:01:25.71,Default,,0,0,0,,Сочо!
Dialogue: 0,0:01:27.21,0:01:30.08,Default,,0,0,0,,Сочо мен уәде беремін.
Dialogue: 0,0:01:30.21,0:01:34.92,Default,,0,0,0,,Мен Вальт Аоиды жеңіп, ең күшті және жеңілмейтін супер Цетсу боламын.
Dialogue: 0,0:01:35.05,0:01:37.68,Default,,0,0,0,,Өтінемін, мені қадағалаңыз!
Dialogue: 0,0:01:37.80,0:01:40.14,Default,,0,0,0,,Ах! Мен оны көремін!
Dialogue: 0,0:01:40.26,0:01:41.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:42.22,0:01:43.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:43.68,0:01:48.23,Default,,0,0,0,,Теменің жеңісін мен көре алмасам, кім көреді?
Dialogue: 0,0:01:48.56,0:01:50.23,Default,,0,0,0,,Сочо!
Dialogue: 0,0:01:50.65,0:01:51.61,Default,,0,0,0,,Хехе
Dialogue: 0,0:01:52.07,0:01:53.15,Default,,0,0,0,,Айға!
Dialogue: 0,0:01:54.65,0:01:55.90,Default,,0,0,0,,Хи хи
Dialogue: 0,0:01:57.49,0:02:03.49,Default,,0,0,0,,♪~
Dialogue: 0,0:03:20.74,0:03:26.74,Default,,0,0,0,,~♪
Dialogue: 0,0:03:27.45,0:03:30.58,Default,,0,0,0,,“Батырға қарсы батыр!!”
Dialogue: 0,0:03:32.12,0:03:36.09,Default,,0,0,0,,♬~
Dialogue: 0,0:03:36.17,0:03:40.22,Default,,0,0,0,,Уау! мақсат!
Dialogue: 0,0:03:41.47,0:03:43.13,Default,,0,0,0,,Мен біріншімін!
Dialogue: 0,0:03:43.51,0:03:45.22,Default,,0,0,0,,Мен жылдамырақ болдым
Dialogue: 0,0:03:45.43,0:03:47.01,Default,,0,0,0,,Жоқ! Бұл менмін
Dialogue: 0,0:03:47.68,0:03:49.56,Default,,0,0,0,,Жыл бойы шорт киетін ұрғашы горилла ма!?
Dialogue: 0,0:03:49.93,0:03:51.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:52.77,0:03:54.48,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:03:54.73,0:03:56.40,Default,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,0:03:56.77,0:04:00.69,Default,,0,0,0,,Біреу! Ешкім жоқ па?
Dialogue: 0,0:04:01.28,0:04:05.41,Default,,0,0,0,,Эй!
Dialogue: 0,0:04:06.91,0:04:09.24,Default,,0,0,0,,Сочо!
Dialogue: 0,0:04:10.37,0:04:11.91,Default,,0,0,0,,Неге сен Окуцу музыка колледжінің жанындағы орта мектепке өтініш бердің?—
Dialogue: 0,0:04:12.25,0:04:14.29,Default,,0,0,0,,Айға... Айға...
Dialogue: 0,0:04:14.87,0:04:17.21,Default,,0,0,0,,Жан мен Лабанмен теңіз байдаркасында ойнау...
Dialogue: 0,0:04:19.67,0:04:22.76,Default,,0,0,0,,Жүрейік~ Дайын жиынтық
Dialogue: 0,0:04:22.88,0:04:25.89,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:04:26.26,0:04:29.68,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:04:30.35,0:04:32.68,Default,,0,0,0,,Мен Super Zetsu №1мін!
Dialogue: 0,0:04:33.06,0:04:35.65,Default,,0,0,0,,Айга керемет! Тез тез!
Dialogue: 0,0:04:36.10,0:04:38.56,Default,,0,0,0,,Батыр әрқашан жеңеді! О!
Dialogue: 0,0:04:38.65,0:04:39.57,Default,,0,0,0,,Уга~!
Dialogue: 0,0:04:39.65,0:04:41.57,Default,,0,0,0,,Icchi, Icchiban!
Dialogue: 0,0:04:41.94,0:04:43.74,Default,,0,0,0,,♬~
Dialogue: 0,0:04:43.82,0:04:47.20,Default,,0,0,0,,Барлығына! Қайда бара жатырсың?
Dialogue: 0,0:04:48.20,0:04:50.33,Default,,0,0,0,,Тек қайтып келме
Dialogue: 0,0:04:50.91,0:04:52.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:52.50,0:04:55.00,Default,,0,0,0,,Олар не істеп жатыр?
Dialogue: 0,0:04:55.16,0:04:56.08,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:04:56.83,0:04:59.84,Default,,0,0,0,,Мына тұманда оны табу оңай емес.
Dialogue: 0,0:05:00.25,0:05:02.46,Default,,0,0,0,,А... Кеме апатқа ұшырады ма?
Dialogue: 0,0:05:02.55,0:05:04.59,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:05:07.93,0:05:08.72,Default,,0,0,0,,Әй!
Dialogue: 0,0:05:08.80,0:05:09.85,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:05:13.73,0:05:16.02,Default,,0,0,0,,Хэхе~ Бұл өте көп.
Dialogue: 0,0:05:16.19,0:05:18.40,Default,,0,0,0,,Мен біріншімін! Міне бітті!
Dialogue: 0,0:05:18.48,0:05:19.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:19.65,0:05:21.36,Default,,0,0,0,,Мен біріншімін!
Dialogue: 0,0:05:21.44,0:05:23.82,Default,,0,0,0,,Жоқ, мен жылдамырақ болдым.
Dialogue: 0,0:05:24.36,0:05:25.90,Default,,0,0,0,,Әлі де тырысуда
Dialogue: 0,0:05:26.28,0:05:28.78,Default,,0,0,0,,Ал, мен бірінші орында тұрмын.
Dialogue: 0,0:05:29.07,0:05:31.08,Default,,0,0,0,,Әй?
Dialogue: 0,0:05:31.70,0:05:32.83,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:05:33.41,0:05:35.62,Default,,0,0,0,,Сіз осы жерде тұрасыз ба?
Dialogue: 0,0:05:35.79,0:05:36.58,Default,,0,0,0,,Егер Ваму сол затты бірінші қолға алса—
Dialogue: 0,0:05:38.71,0:05:39.58,Default,,0,0,0,,(айқай)
Dialogue: 0,0:05:39.67,0:05:41.84,Default,,0,0,0,,Жақында кездескенше~
Dialogue: 0,0:05:42.34,0:05:43.59,Default,,0,0,0,,Меніңше... олар әлі өздерін жинастыра алмай, қиналып жатыр.
Dialogue: 0,0:05:43.76,0:05:47.09,Default,,0,0,0,,Уф
Dialogue: 0,0:05:47.22,0:05:48.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:52.18,0:05:54.64,Default,,0,0,0,,О! Дәмді көрінеді! О! Дәмді көрінеді!
Dialogue: 0,0:05:55.98,0:05:58.64,Default,,0,0,0,,Мен жедім, жедім! Мейрам мырза
Dialogue: 0,0:05:58.73,0:06:00.27,Default,,0,0,0,,Бұл дәмді болды.
Dialogue: 0,0:06:00.35,0:06:01.36,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:06:01.73,0:06:06.36,Default,,0,0,0,,Тойдым, енді бастайық.
Dialogue: 0,0:06:06.82,0:06:09.82,Default,,0,0,0,,Кемені табу үшін биік жерге шығыңыз
Dialogue: 0,0:06:10.32,0:06:13.33,Default,,0,0,0,,Жоғарыға бірінші жеткен адам жеңеді.
Dialogue: 0,0:06:13.83,0:06:16.16,Default,,0,0,0,,О! Біз жасайық
Dialogue: 0,0:06:16.25,0:06:19.50,Default,,0,0,0,,♬~
Dialogue: 0,0:06:19.92,0:06:21.00,Default,,0,0,0,,Ой!
Dialogue: 0,0:06:21.29,0:06:22.71,Default,,0,0,0,,Мен біріншімін!
Dialogue: 0,0:06:22.79,0:06:24.21,Default,,0,0,0,,Мен бірінші барамын!
Dialogue: 0,0:06:25.63,0:06:26.46,Default,,0,0,0,,Ах
Dialogue: 0,0:06:27.51,0:06:28.51,Default,,0,0,0,,Шын жүректен осылай сезінемін
Dialogue: 0,0:06:28.88,0:06:30.97,Default,,0,0,0,,Омэкки, тоқта!
Dialogue: 0,0:06:31.18,0:06:33.05,Default,,0,0,0,,(Хиёри) Мен қатты қуаныштымын. (Фуюми) Хехе.
Dialogue: 0,0:06:33.26,0:06:35.06,Default,,0,0,0,,Иә?Не?
Dialogue: 0,0:06:35.31,0:06:37.23,Default,,0,0,0,,Құлап қалмаңыз!
Dialogue: 0,0:06:37.68,0:06:41.35,Default,,0,0,0,,Бұл шынымен де құлады! Таку!
Dialogue: 0,0:06:41.52,0:06:43.44,Default,,0,0,0,,(әлсіз найзағай)
Dialogue: 0,0:06:43.69,0:06:45.94,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:48.36,0:06:51.57,Default,,0,0,0,,Теңіз байдаркасының GPS жауабы анықталды
Dialogue: 0,0:06:53.32,0:06:55.24,Default,,0,0,0,,Тез арада көмекке барыңыз!
Dialogue: 0,0:06:55.87,0:06:57.16,Default,,0,0,0,,Айга...
Dialogue: 0,0:06:57.45,0:07:00.25,Default,,0,0,0,,Теме және т.б. Аман болыңыз.
Dialogue: 0,0:07:05.46,0:07:06.71,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:08.05,0:07:10.01,Default,,0,0,0,,Жанып тұрған храм стиліндегі ежелгі жекпе-жек өнері!
Dialogue: 0,0:07:10.68,0:07:12.26,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:07:14.60,0:07:16.68,Default,,0,0,0,,Уау! Ах
Dialogue: 0,0:07:19.48,0:07:20.31,Default,,0,0,0,,Не!
Dialogue: 0,0:07:22.73,0:07:24.77,Default,,0,0,0,,♬~
Dialogue: 0,0:07:25.23,0:07:26.61,Default,,0,0,0,,Уф! Апыр-ай!
Dialogue: 0,0:07:31.20,0:07:33.53,Default,,0,0,0,,Айга, сен...
Dialogue: 0,0:07:34.70,0:07:35.74,Default,,0,0,0,,Бұл — радио гимнастика.
Dialogue: 0,0:07:35.91,0:07:39.75,Default,,0,0,0,,♬~
Dialogue: 0,0:07:42.92,0:07:45.17,Default,,0,0,0,,Кіреберіс толы.
Dialogue: 0,0:07:45.38,0:07:46.79,Default,,0,0,0,,...
Dialogue: 0,0:07:47.00,0:07:48.00,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:07:48.88,0:07:50.01,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:07:50.13,0:07:51.84,Default,,0,0,0,,Осылай болды ма?
Dialogue: 0,0:07:52.05,0:07:55.22,Default,,0,0,0,,Батыр әрқашан шытырман оқиғаға дайындалады.
Dialogue: 0,0:07:57.64,0:07:58.56,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:58.81,0:08:00.68,Default,,0,0,0,,Бізде тереңірек барудан басқа амал жоқ.
Dialogue: 0,0:08:01.35,0:08:03.10,Default,,0,0,0,,Әй?
Dialogue: 0,0:08:03.19,0:08:04.69,Default,,0,0,0,,О? Не?
Dialogue: 0,0:08:05.81,0:08:06.86,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:08:07.52,0:08:09.73,Default,,0,0,0,,Саған не болды?
Dialogue: 0,0:08:10.15,0:08:13.53,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:08:13.78,0:08:17.33,Default,,0,0,0,,Ньянда? Мұнда шығу бар
Dialogue: 0,0:08:17.66,0:08:19.74,Default,,0,0,0,,Жануарлардың тілін түсіне аласың ба?
Dialogue: 0,0:08:20.50,0:08:23.83,Default,,0,0,0,,Өйткені, біз аң патшамыз.
Dialogue: 0,0:08:23.96,0:08:25.08,Default,,0,0,0,,Тіпті ең озық заманауи—
Dialogue: 0,0:08:25.25,0:08:27.59,Default,,0,0,0,,Ғажайып Лабан
Dialogue: 0,0:08:28.46,0:08:31.26,Default,,0,0,0,,Айға Жоғарыда айтқаныма рахмет.
Dialogue: 0,0:08:31.67,0:08:33.30,Default,,0,0,0,,Бұл қандай қулық?
Dialogue: 0,0:08:33.42,0:08:37.47,Default,,0,0,0,,Бұл техника емес, менде кейде солай болады.
Dialogue: 0,0:08:38.01,0:08:40.26,Default,,0,0,0,,Бұл Бейбаттте де болады.
Dialogue: 0,0:08:40.43,0:08:42.23,Default,,0,0,0,,Фубуки «резонанс» дейді...
Dialogue: 0,0:08:42.81,0:08:43.98,Default,,0,0,0,,Резонанс…
Dialogue: 0,0:08:44.06,0:08:45.85,Default,,0,0,0,,Мен түсінбеймін...
Dialogue: 0,0:08:45.94,0:08:49.36,Default,,0,0,0,,Ол шығанақтың максималды қуатын шығарады.
Dialogue: 0,0:08:50.86,0:08:51.73,Default,,0,0,0,,Ах
Dialogue: 0,0:08:52.40,0:08:53.99,Default,,0,0,0,,Қайсысы?
Dialogue: 0,0:08:55.91,0:08:57.37,Default,,0,0,0,,(айқай)
Dialogue: 0,0:08:57.91,0:09:00.37,Default,,0,0,0,,Ня? (Мысық мияулайды)
Dialogue: 0,0:09:00.58,0:09:01.83,Default,,0,0,0,,Не?
Dialogue: 0,0:09:02.12,0:09:03.25,Default,,0,0,0,,Мен өзімді жоғалтқандай сезінемін.
Dialogue: 0,0:09:03.58,0:09:04.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:05.71,0:09:08.29,Default,,0,0,0,,Мен саған сендім.
Dialogue: 0,0:09:08.58,0:09:10.04,Default,,0,0,0,,(айқай)
Dialogue: 0,0:09:10.34,0:09:11.42,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:09:12.30,0:09:13.55,Default,,0,0,0,,Ахиллестен сұраңыз!
Dialogue: 0,0:09:13.92,0:09:15.68,Default,,0,0,0,,Я, мен де істеймін.
Dialogue: 0,0:09:15.88,0:09:17.05,Default,,0,0,0,,Мен де!
Dialogue: 0,0:09:18.84,0:09:21.64,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:09:22.10,0:09:23.89,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:09:30.23,0:09:31.82,Default,,0,0,0,,Мына жерде! Міне бітті!
Dialogue: 0,0:09:32.40,0:09:33.99,Default,,0,0,0,,Олар ыдырап жатқан жоқ па!
Dialogue: 0,0:09:34.28,0:09:36.32,Default,,0,0,0,,Ахиллес айтқан жерге барайық.
Dialogue: 0,0:09:36.40,0:09:38.03,Default,,0,0,0,,Жоқ, бұл Excalibur!
Dialogue: 0,0:09:38.11,0:09:39.99,Default,,0,0,0,,Бұл Барыс! (айқай)
Dialogue: 0,0:09:40.32,0:09:41.41,Default,,0,0,0,,Wait a minute!
Dialogue: 0,0:09:41.70,0:09:45.25,Default,,0,0,0,,Сіз бірдеңе естисіз бе?
Dialogue: 0,0:09:45.83,0:09:46.96,Default,,0,0,0,,Хмм.
Dialogue: 0,0:09:47.16,0:09:50.21,Default,,0,0,0,,Ай!
Dialogue: 0,0:09:50.38,0:09:51.96,Default,,0,0,0,,Толқындардың дыбысы...
Dialogue: 0,0:09:53.50,0:09:54.55,Default,,0,0,0,,Мен мұнда қаламын! Өтінемін, менімен бірге шайқасуға рұқсат ет!
Dialogue: 0,0:09:54.76,0:09:56.42,Default,,0,0,0,,Барайық
Dialogue: 0,0:10:03.43,0:10:04.31,Default,,0,0,0,,(айқай)
Dialogue: 0,0:10:07.44,0:10:09.73,Default,,0,0,0,,Сыртта! Оны қырып тастаңыз!
Dialogue: 0,0:10:09.81,0:10:11.90,Default,,0,0,0,,♬~
Dialogue: 0,0:10:17.15,0:10:18.15,Default,,0,0,0,,Ах! (Барлығы) О?
Dialogue: 0,0:10:18.61,0:10:20.16,Default,,0,0,0,,Бұл Айга!
Dialogue: 0,0:10:20.82,0:10:22.41,Default,,0,0,0,,Оны таптым~
Dialogue: 0,0:10:22.49,0:10:24.54,Default,,0,0,0,,Сен қатты уайымдадың
Dialogue: 0,0:10:30.50,0:10:33.42,Default,,0,0,0,,Уау! Эй эй эй!
Dialogue: 0,0:10:33.50,0:10:36.55,Default,,0,0,0,,Жарайды! ұлдар мен қыздар
Dialogue: 0,0:10:36.88,0:10:40.13,Default,,0,0,0,,Қалақтардың тірі қалу үшін шайқасы...
Dialogue: 0,0:10:40.26,0:10:42.05,Default,,0,0,0,,Жақында басталады!
Dialogue: 0,0:10:42.30,0:10:43.51,Default,,0,0,0,,Ішкі телефон
Dialogue: 0,0:10:43.60,0:10:46.18,Default,,0,0,0,,Бүгінгі қарсыласты жариялаймын~
Dialogue: 0,0:10:46.68,0:10:47.56,Default,,0,0,0,,​​О?
Dialogue: 0,0:10:50.94,0:10:53.56,Default,,0,0,0,,Иә! Бұл комбинация туралы шешім қабылдады!
Dialogue: 0,0:10:54.19,0:10:57.23,Default,,0,0,0,,Фубуки Суми VS Кайл Хаким
Dialogue: 0,0:10:57.86,0:11:00.53,Default,,0,0,0,,Фи VS Лабан Вано
