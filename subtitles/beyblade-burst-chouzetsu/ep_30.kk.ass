Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.75,0:00:04.17,Default,,0,0,0,,Бейблейд
Dialogue: 0,0:00:04.29,0:00:08.17,Default,,0,0,0,,Мықты болуды мақсат еткен ұлдардың арманының жемісі.
Dialogue: 0,0:00:08.96,0:00:12.26,Default,,0,0,0,,Енді супер Цетсу дәуірі басталады.
Dialogue: 0,0:00:12.55,0:00:16.80,Default,,0,0,0,,Металл сауытыңызды киіңіз де, Беймен шытырман оқиғаға аттаныңыз!
Dialogue: 0,0:00:16.89,0:00:19.26,Default,,0,0,0,,Әлем чемпионы болуды мақсат етіңіз!
Dialogue: 0,0:00:19.39,0:00:23.69,Default,,0,0,0,,Super Zetsu Super Zetsu Super Zetsu!
Dialogue: 0,0:00:24.27,0:00:27.90,Default,,0,0,0,,Ең күшті және жеңілмейтін атағын алатын адам сенсің!
Dialogue: 0,0:00:32.69,0:00:34.03,Default,,0,0,0,,Уууу!
Dialogue: 0,0:00:37.53,0:00:40.24,Default,,0,0,0,,Құрыш жойылды... Міне келді!
Dialogue: 0,0:00:40.45,0:00:41.37,Default,,0,0,0,,Біз жарты жолды өтіп қойдық — бізді тежеме, жарай ма?
Dialogue: 0,0:00:41.62,0:00:45.29,Default,,0,0,0,,Үмітсіздігіңізді тыңдауға рұқсат етіңіз
Dialogue: 0,0:00:45.58,0:00:47.79,Default,,0,0,0,,Armor Press құралын жандандырыңыз!
Dialogue: 0,0:00:49.59,0:00:51.80,Default,,0,0,0,,Уууу!
Dialogue: 0,0:00:54.05,0:00:56.51,Default,,0,0,0,,А... шыдадың ба?
Dialogue: 0,0:00:56.76,0:01:00.10,Default,,0,0,0,,Бұзыңыз! Ахиллес!
Dialogue: 0,0:01:13.11,0:01:16.24,Default,,0,0,0,,Мен Балтты жеңіп, жаңа чемпион атандым...
Dialogue: 0,0:01:16.36,0:01:18.91,Default,,0,0,0,,Фимен еркін шайқаста жеңіске жетті...
Dialogue: 0,0:01:19.07,0:01:23.24,Default,,0,0,0,,Мен Z4 мүшелерінің бірі Hearts шақыруын қабылдауды шештім!
Dialogue: 0,0:01:26.79,0:01:28.21,Default,,0,0,0,,Мен сізге алдын ала хабарлаймын.
Dialogue: 0,0:01:28.54,0:01:30.08,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:01:30.17,0:01:32.55,Default,,0,0,0,,Жарық аяқталатын екі ұпай
Dialogue: 0,0:01:32.67,0:01:34.05,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:01:34.17,0:01:36.76,Default,,0,0,0,,Жарық аяқталатын екі ұпай
Dialogue: 0,0:01:37.22,0:01:39.39,Default,,0,0,0,,Сіз 4-0 есебімен жеңілдіңіз.
Dialogue: 0,0:01:39.51,0:01:42.18,Default,,0,0,0,,Тағы бір ұпайға ие болу бонус болып табылады.
Dialogue: 0,0:01:42.76,0:01:45.81,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:01:46.27,0:01:49.23,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:01:49.65,0:01:50.44,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:01:56.40,0:02:00.57,Default,,0,0,0,,Super Z Slash!
Dialogue: 0,0:02:01.24,0:02:04.49,Default,,0,0,0,,Өлі импульс!
Dialogue: 0,0:02:09.67,0:02:12.29,Default,,0,0,0,,Әкеміздің аурудан қайтыс болуы да жаман нәрсе сияқты естіледі.
Dialogue: 0,0:02:13.80,0:02:16.17,Default,,0,0,0,,Хадестің ерекше қимылымен аяқтаңыз!
Dialogue: 0,0:02:16.76,0:02:19.63,Default,,0,0,0,,Мен екі ұпайды тонап кеттім.
Dialogue: 0,0:02:20.05,0:02:21.05,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:02:21.22,0:02:24.31,Default,,0,0,0,,Мен сені өлтіремін!
Dialogue: 0,0:02:25.39,0:02:31.40,Default,,0,0,0,,♪~
Dialogue: 0,0:03:48.68,0:03:54.69,Default,,0,0,0,,~♪
Dialogue: 0,0:03:55.69,0:03:57.94,Default,,0,0,0,,«Айға құтырды!»
Dialogue: 0,0:03:59.48,0:04:04.20,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:04:04.86,0:04:05.82,Default,,0,0,0,,Хаха~!
Dialogue: 0,0:04:06.32,0:04:09.83,Default,,0,0,0,,Көбірек айқайлаңыз! Айқай!
Dialogue: 0,0:04:09.95,0:04:12.91,Default,,0,0,0,,Болжағандай, жарылып кетті!
Dialogue: 0,0:04:13.25,0:04:14.96,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:04:15.21,0:04:17.29,Default,,0,0,0,,Қызыл жүз Айганы көрдіңіз бе?
Dialogue: 0,0:04:17.88,0:04:21.84,Default,,0,0,0,,Бұл Demon Lord Hearts-тің ерекше қозғалысы, Өлі импульс!
Dialogue: 0,0:04:22.38,0:04:24.01,Default,,0,0,0,,Тағы да айтайын.
Dialogue: 0,0:04:24.97,0:04:26.26,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:04:26.34,0:04:28.47,Default,,0,0,0,,Жарық аяқталатын екі ұпай
Dialogue: 0,0:04:28.85,0:04:30.89,Default,,0,0,0,,Сонымен, бұл ойын жинағы.
Dialogue: 0,0:04:31.06,0:04:32.27,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:04:32.35,0:04:35.19,Default,,0,0,0,,Ой! Challenger Hearts
Dialogue: 0,0:04:35.31,0:04:38.65,Default,,0,0,0,,Біз Чемпион Айга Акаблейді мүмкіндігінше итереміз!
Dialogue: 0,0:04:39.11,0:04:42.49,Default,,0,0,0,,Балалар! Көбірек жарылыстарды көргіңіз келе ме?
Dialogue: 0,0:04:42.82,0:04:44.49,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:04:45.03,0:04:47.62,Default,,0,0,0,,Нағыз чемпион кім?
Dialogue: 0,0:04:47.74,0:04:49.62,Default,,0,0,0,,Жүректер!
Dialogue: 0,0:04:49.74,0:04:52.79,Default,,0,0,0,,Иә? Мен сізді жақсы естімеймін.
Dialogue: 0,0:04:52.91,0:04:54.33,Default,,0,0,0,,Жүректер!
Dialogue: 0,0:04:54.46,0:04:55.75,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:04:56.12,0:05:00.25,Default,,0,0,0,,Шоу жалғасуда! Шоу уақыты келді!
Dialogue: 0,0:05:00.38,0:05:01.38,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:05:01.46,0:05:05.84,Default,,0,0,0,,Жүректер! Жүректер! Жүректер!
Dialogue: 0,0:05:06.51,0:05:10.10,Default,,0,0,0,,Қарғыс атсын... бәрі Жүректерді қолдауға бұрылды.
Dialogue: 0,0:05:10.18,0:05:12.39,Default,,0,0,0,,Амансың ба? Айга
Dialogue: 0,0:05:13.06,0:05:15.23,Default,,0,0,0,,Атмосфераға түсіп қалмаңыз
Dialogue: 0,0:05:15.77,0:05:17.65,Default,,0,0,0,,Мен тынышталуым керек
Dialogue: 0,0:05:18.56,0:05:22.78,Default,,0,0,0,,Жүректер! Жүректер! Жүректер!
Dialogue: 0,0:05:24.86,0:05:26.78,Default,,0,0,0,,Мен қалай жеңе аламын?
Dialogue: 0,0:05:27.70,0:05:30.91,Default,,0,0,0,,Не болды, Ахиллес, бірдеңе айтшы!
Dialogue: 0,0:05:31.58,0:05:35.16,Default,,0,0,0,,Айға жігіт Ахиллеспен сөйлесіп жатыр.
Dialogue: 0,0:05:35.58,0:05:37.46,Default,,0,0,0,,Бұл жалғыз нәрсе (2 адам) Иә?
Dialogue: 0,0:05:38.42,0:05:40.92,Default,,0,0,0,,Ахиллеспен резонансыңызды арттырыңыз
Dialogue: 0,0:05:41.34,0:05:42.96,Default,,0,0,0,,Бұл жеңіске жетудің жалғыз жолы
Dialogue: 0,0:05:44.34,0:05:45.34,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:05:48.30,0:05:50.72,Default,,0,0,0,,Ахиллес, сен маған сен.
Dialogue: 0,0:05:51.18,0:05:53.64,Default,,0,0,0,,Ағашты ұшырып жіберейік!
Dialogue: 0,0:05:56.52,0:05:57.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:57.52,0:06:01.31,Default,,0,0,0,,Иә, Ахиллес... Жақсы, көбірек.
Dialogue: 0,0:06:01.73,0:06:03.48,Default,,0,0,0,,Көбірек келіңіз!
Dialogue: 0,0:06:05.19,0:06:06.65,Default,,0,0,0,,(Лэйди тауы) Хмм? Не айтқың келеді?
Dialogue: 0,0:06:07.32,0:06:09.16,Default,,0,0,0,,Мен мұны осы жолы істеймін
Dialogue: 0,0:06:09.28,0:06:11.82,Default,,0,0,0,,Тағы бір рет шабуыл режимінде шайқас!
Dialogue: 0,0:06:11.99,0:06:13.83,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:06:14.12,0:06:17.33,Default,,0,0,0,,Айға! Айга! Айга!
Dialogue: 0,0:06:17.71,0:06:19.58,Default,,0,0,0,,Сәттілік Айға!
Dialogue: 0,0:06:19.71,0:06:21.08,Default,,0,0,0,,Айга~!
Dialogue: 0,0:06:21.96,0:06:24.34,Default,,0,0,0,,Мен оны екінші шайқаста қайтарамын.
Dialogue: 0,0:06:24.46,0:06:27.05,Default,,0,0,0,,Жарық аяқталатын екі ұпай!
Dialogue: 0,0:06:27.47,0:06:30.55,Default,,0,0,0,,Хаха~! Мен оны аламын
Dialogue: 0,0:06:31.05,0:06:33.01,Default,,0,0,0,,Енді екінші шайқас
Dialogue: 0,0:06:33.18,0:06:35.10,Default,,0,0,0,,Жүректер болжағандай тікелей ойындарда жеңе ме?
Dialogue: 0,0:06:35.22,0:06:37.85,Default,,0,0,0,,А... Әлде Қызыл жүз Айға тұра ма?
Dialogue: 0,0:06:38.64,0:06:41.06,Default,,0,0,0,,Сіз Пхиді жеңдіңіз, солай ма?
Dialogue: 0,0:06:44.61,0:06:47.90,Default,,0,0,0,,Ондай жағдайда бізге жақсырақ жекпе-жек көрсетіңіз.
Dialogue: 0,0:06:48.03,0:06:50.57,Default,,0,0,0,,Сіз күштірек болуыңыз керек
Dialogue: 0,0:06:51.49,0:06:52.62,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:06:53.41,0:06:54.41,Default,,0,0,0,,Хэхе~
Dialogue: 0,0:06:55.66,0:06:57.33,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:06:57.95,0:07:01.00,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:07:01.46,0:07:03.96,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:07:04.38,0:07:05.50,Default,,0,0,0,,Хаха!
Dialogue: 0,0:07:10.55,0:07:13.22,Default,,0,0,0,,Қарғыс атсын, Ахиллес!
Dialogue: 0,0:07:13.59,0:07:16.22,Default,,0,0,0,,Super Z түсірілімі!
Dialogue: 0,0:07:20.85,0:07:23.02,Default,,0,0,0,,Қорғаныс режимінде гадес!
Dialogue: 0,0:07:23.15,0:07:25.77,Default,,0,0,0,,Ол Ахиллестің барлық шабуылдарын болдырмайды!
Dialogue: 0,0:07:26.15,0:07:28.99,Default,,0,0,0,,Ахиллес шабуылы... шабуыл!
Dialogue: 0,0:07:31.49,0:07:33.20,Default,,0,0,0,,Қандай салмақ!
Dialogue: 0,0:07:33.41,0:07:34.20,Default,,0,0,0,,Гррр…
Dialogue: 0,0:07:36.58,0:07:39.91,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:07:42.37,0:07:45.92,Default,,0,0,0,,Ха ха ха... (жүрек соғысы)
Dialogue: 0,0:07:46.04,0:07:46.96,Default,,0,0,0,,Уф!
Dialogue: 0,0:07:47.59,0:07:48.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:49.55,0:07:53.72,Default,,0,0,0,,Уууу!
Dialogue: 0,0:07:58.81,0:08:01.27,Default,,0,0,0,,(Ахиллестің айқайы)
Dialogue: 0,0:08:01.98,0:08:03.23,Default,,0,0,0,,Хехе...
Dialogue: 0,0:08:03.64,0:08:06.02,Default,,0,0,0,,Ахиллеске бар!
Dialogue: 0,0:08:06.15,0:08:09.07,Default,,0,0,0,,Аспанды ұшыр!
Dialogue: 0,0:08:12.40,0:08:13.28,Default,,0,0,0,,Гррр…
Dialogue: 0,0:08:13.49,0:08:16.74,Default,,0,0,0,,Ой! Ахиллестің қарсы шабуылы басталды!
Dialogue: 0,0:08:17.20,0:08:19.08,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:20.33,0:08:23.29,Default,,0,0,0,,Ахиллестің тыныссыз үздіксіз шабуылдары
Dialogue: 0,0:08:23.41,0:08:26.04,Default,,0,0,0,,Бұл Аидтың қорғанысын бұзып өтуге жеткілікті күшті!
Dialogue: 0,0:08:26.54,0:08:28.25,Default,,0,0,0,,Жақсы, Айга!
Dialogue: 0,0:08:28.38,0:08:29.75,Default,,0,0,0,,Жүр!
Dialogue: 0,0:08:30.38,0:08:31.55,Default,,0,0,0,,Айга...
Dialogue: 0,0:08:34.34,0:08:36.51,Default,,0,0,0,,Шабуыл жасай бер, Ахиллес!
Dialogue: 0,0:08:38.93,0:08:42.35,Default,,0,0,0,,Жақсы... Жақсы, көбірек!
Dialogue: 0,0:08:43.52,0:08:45.31,Default,,0,0,0,,Көбірек келіңіз
Dialogue: 0,0:08:48.40,0:08:54.03,Default,,0,0,0,,Мен~хаха~!
Dialogue: 0,0:08:54.15,0:08:56.03,Default,,0,0,0,,Ажал!
Dialogue: 0,0:09:08.00,0:09:12.63,Default,,0,0,0,,Аид! Өлі гравитация!
Dialogue: 0,0:09:18.55,0:09:20.18,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:09:24.23,0:09:25.48,Default,,0,0,0,,Ахиллес!
Dialogue: 0,0:09:28.48,0:09:29.86,Default,,0,0,0,,Ахиллес~!
Dialogue: 0,0:09:35.19,0:09:36.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:36.78,0:09:37.66,Default,,0,0,0,,Уф!
Dialogue: 0,0:09:38.53,0:09:39.62,Default,,0,0,0,,Айга!
Dialogue: 0,0:09:40.62,0:09:41.49,Default,,0,0,0,,Фу…
Dialogue: 0,0:09:42.33,0:09:44.87,Default,,0,0,0,,Өлі өлілердің жарылуы аяқталды
Dialogue: 0,0:09:45.41,0:09:47.83,Default,,0,0,0,,Hearts 4-0 есебімен жеңді!
Dialogue: 0,0:09:47.96,0:09:50.59,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:09:50.92,0:09:55.01,Default,,0,0,0,,Соңғы ерекше қозғалыс, Өлі гравитация...
Dialogue: 0,0:09:55.09,0:09:57.26,Default,,0,0,0,,Ахиллестің тынысы тоқтады!
Dialogue: 0,0:09:57.34,0:10:00.55,Default,,0,0,0,,Болжам бойынша, Hearts 4-0 есебімен жеңіске жетті.
Dialogue: 0,0:10:00.72,0:10:03.89,Default,,0,0,0,,Жаңа чемпион дүниеге келді!
Dialogue: 0,0:10:04.06,0:10:06.39,Default,,0,0,0,,Бұл не болды... енді?
Dialogue: 0,0:10:07.06,0:10:08.31,Default,,0,0,0,,Хаха~! Ах...
Dialogue: 0,0:10:08.39,0:10:10.73,Default,,0,0,0,,Бұл қызық болды, Айға Ақаба
Dialogue: 0,0:10:11.11,0:10:13.52,Default,,0,0,0,,Менің көргім келгені осы еді
Dialogue: 0,0:10:13.77,0:10:14.65,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:10:14.73,0:10:17.19,Default,,0,0,0,,Нағыз чемпион кім?
Dialogue: 0,0:10:17.32,0:10:21.95,Default,,0,0,0,,Жүректер! Жүректер! Жүректер!
Dialogue: 0,0:10:24.16,0:10:25.37,Default,,0,0,0,,Айга...
Dialogue: 0,0:10:26.50,0:10:28.75,Default,,0,0,0,,Амансың ба? Ол жігіт...
Dialogue: 0,0:10:29.25,0:10:32.92,Default,,0,0,0,,Жүректер! Жүректер! Жүректер!
Dialogue: 0,0:10:33.96,0:10:34.84,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:10:36.05,0:10:36.96,Default,,0,0,0,,Уф!
Dialogue: 0,0:10:38.17,0:10:39.01,Default,,0,0,0,,Фу…
Dialogue: 0,0:10:42.05,0:10:46.39,Default,,0,0,0,,Жүректер! Жүректер! Жүректер!
Dialogue: 0,0:10:50.27,0:10:51.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:52.90,0:10:53.73,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:10:54.11,0:10:55.69,Default,,0,0,0,,Айга... (Рандзиро) Айга
Dialogue: 0,0:10:55.78,0:10:57.11,Default,,0,0,0,,Уф!
Dialogue: 0,0:10:57.36,0:10:58.24,Default,,0,0,0,,Айга!
Dialogue: 0,0:11:00.40,0:11:01.61,Default,,0,0,0,,Ол...
Dialogue: 0,0:11:06.66,0:11:08.08,Default,,0,0,0,,Неге!
Dialogue: 0,0:11:08.95,0:11:12.38,Default,,0,0,0,,Резонанстық қуат соншалықты артуы керек болса да...
Dialogue: 0,0:11:13.00,0:11:13.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:14.84,0:11:16.21,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:11:17.21,0:11:19.01,Default,,0,0,0,,Мен Эвелмін
Dialogue: 0,0:11:19.72,0:11:22.09,Default,,0,0,0,,Мен жүректерден хабар жеткізуге келдім.
Dialogue: 0,0:11:22.55,0:11:23.93,Default,,0,0,0,,Шын жүректен?
Dialogue: 0,0:11:24.05,0:11:27.97,Default,,0,0,0,,Жүректер сенімен шайқас қызықты өтті дейді.
Dialogue: 0,0:11:28.22,0:11:30.39,Default,,0,0,0,,Бұл мүлдем қызық емес!
Dialogue: 0,0:11:30.98,0:11:33.40,Default,,0,0,0,,Бұл Герцтің ғана пікірі.
Dialogue: 0,0:11:33.94,0:11:35.98,Default,,0,0,0,,Сіздің келісіміңіз сұралмайды.
Dialogue: 0,0:11:36.36,0:11:37.69,Default,,0,0,0,,Не!
Dialogue: 0,0:11:37.82,0:11:41.24,Default,,0,0,0,,Жүрек сіздің күшті бола алатыныңызды айтады.
Dialogue: 0,0:11:41.36,0:11:44.37,Default,,0,0,0,,Бір рет жеңдім деп мақтанба!
Dialogue: 0,0:11:44.87,0:11:48.70,Default,,0,0,0,,Сіз жүректер екеуіңіз бір-біріңізге қарсы ойнағандарыңыз рас.
Dialogue: 0,0:11:48.83,0:11:49.70,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:11:50.33,0:11:53.00,Default,,0,0,0,,Жүректердің ұту көрсеткіші 100%
Dialogue: 0,0:11:53.33,0:11:55.13,Default,,0,0,0,,Сіздің жеңу мүмкіндігіңіз нөлге тең.
Dialogue: 0,0:11:55.42,0:11:56.54,Default,,0,0,0,,Егер ол нөл болса ше?
Dialogue: 0,0:11:57.00,0:12:01.76,Default,,0,0,0,,Бұл менің пікірім емес, бұл жай ғана объективті факт.
Dialogue: 0,0:12:01.88,0:12:03.80,Default,,0,0,0,,Әй, не айтайын!
Dialogue: 0,0:12:04.80,0:12:07.05,Default,,0,0,0,,Егер сіз күшті болғыңыз келсе...
Dialogue: 0,0:12:07.43,0:12:09.89,Default,,0,0,0,,Жүректер Өлі Әжеге келуді айтады.
Dialogue: 0,0:12:10.60,0:12:12.10,Default,,0,0,0,,Өлі әже?
Dialogue: 0,0:12:12.69,0:12:14.40,Default,,0,0,0,,Келген соң түсінесің.
Dialogue: 0,0:12:16.11,0:12:17.90,Default,,0,0,0,,Онда жүректер күтіп тұр.
Dialogue: 0,0:12:19.73,0:12:21.74,Default,,0,0,0,,Не? Ол жігіт...
Dialogue: 0,0:12:22.45,0:12:25.78,Default,,0,0,0,,(қой малау)
Dialogue: 0,0:12:26.16,0:12:27.66,Default,,0,0,0,,Мен~
Dialogue: 0,0:12:31.66,0:12:33.79,Default,,0,0,0,,Айга-күн, қош келдің
Dialogue: 0,0:12:33.91,0:12:37.29,Default,,0,0,0,,Бұл мен, Шинода, мектеп директорымын.
Dialogue: 0,0:12:37.92,0:12:40.25,Default,,0,0,0,,Титулдық матч көңілді қалдырды.
Dialogue: 0,0:12:40.38,0:12:45.05,Default,,0,0,0,,Бірақ ұзақ өмірде бірде жеңесің, бірде жеңілесің.
Dialogue: 0,0:12:45.38,0:12:48.89,Default,,0,0,0,,Қазір ауырса да, бір күні...
Dialogue: 0,0:12:49.01,0:12:50.39,Default,,0,0,0,,Сәлем, директор!
Dialogue: 0,0:12:50.47,0:12:51.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:51.77,0:12:53.27,Default,,0,0,0,,Айга-кун?
Dialogue: 0,0:12:54.56,0:12:56.23,Default,,0,0,0,,Сен онда не істеп жүрсің?
Dialogue: 0,0:12:56.73,0:12:59.61,Default,,0,0,0,,Не істеп жатырсың...
Dialogue: 0,0:12:59.73,0:13:01.44,Default,,0,0,0,,Мен? мен...
Dialogue: 0,0:13:02.07,0:13:03.94,Default,,0,0,0,,Super Zetsu ерекше!
Dialogue: 0,0:13:04.32,0:13:06.49,Default,,0,0,0,,Бұл...
Dialogue: 0,0:13:06.86,0:13:09.41,Default,,0,0,0,,Сол кезде... Иә, сол кезде
Dialogue: 0,0:13:09.53,0:13:11.49,Default,,0,0,0,,Сол кезде!
Dialogue: 0,0:13:11.87,0:13:12.95,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:13:13.04,0:13:15.54,Default,,0,0,0,,Жарайды... Жарайды, Айға-күн!
Dialogue: 0,0:13:16.79,0:13:17.83,Default,,0,0,0,,Оларды осы жаққа жіберіңізші.
Dialogue: 0,0:13:18.17,0:13:19.34,Default,,0,0,0,,Жоқ, жоқ, жоқ...
Dialogue: 0,0:13:19.84,0:13:21.84,Default,,0,0,0,,О, жоқ!
Dialogue: 0,0:13:22.25,0:13:23.38,Default,,0,0,0,,Не?
Dialogue: 0,0:13:27.26,0:13:29.14,Default,,0,0,0,,Директор~!
Dialogue: 0,0:13:30.43,0:13:32.85,Default,,0,0,0,,Ой... Ранжиро балалар.
Dialogue: 0,0:13:33.10,0:13:35.56,Default,,0,0,0,,Барлығының жақсы болғанына қуаныштымын.
Dialogue: 0,0:13:36.06,0:13:38.31,Default,,0,0,0,,Не болды? Сол көзқарас
Dialogue: 0,0:13:38.69,0:13:40.31,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:13:40.44,0:13:43.36,Default,,0,0,0,,Айга-күн қайтадан арнайы жаттығуға кіріскен сияқты.
Dialogue: 0,0:13:43.73,0:13:46.11,Default,,0,0,0,,Уау! (Ранджиро) А?
Dialogue: 0,0:13:46.24,0:13:48.07,Default,,0,0,0,,(шұңқырлар соқтығысқан дыбыс)
Dialogue: 0,0:13:48.36,0:13:50.45,Default,,0,0,0,,Жылама! Ақымақ, Косей! Енді мен де…
Dialogue: 0,0:13:50.82,0:13:51.95,Default,,0,0,0,,О~. Құдай-ай!
Dialogue: 0,0:13:55.37,0:13:56.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:57.83,0:13:58.79,Default,,0,0,0,,Маған бәрібір! Ха!
Dialogue: 0,0:14:01.75,0:14:02.63,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:02.88,0:14:06.72,Default,,0,0,0,,Не болды Не болды? Дегенмен, бұл шығанақ клубы!
Dialogue: 0,0:14:06.84,0:14:08.88,Default,,0,0,0,,Толғағы жоқ жігіттер.
Dialogue: 0,0:14:09.55,0:14:13.68,Default,,0,0,0,,Менімен жарысатын бірде-бір адам жоқ па?
Dialogue: 0,0:14:13.76,0:14:14.68,Default,,0,0,0,,Айга! а?
Dialogue: 0,0:14:15.43,0:14:16.89,Default,,0,0,0,,Мен қарсыласпын
Dialogue: 0,0:14:17.35,0:14:19.44,Default,,0,0,0,,Келіңіздер! (күндізгі жаз) мәңгілік жаз...
Dialogue: 0,0:14:19.77,0:14:21.65,Default,,0,0,0,,Ах (Ранджиро) Әлгі жігіт...
Dialogue: 0,0:14:22.02,0:14:23.65,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:14:24.19,0:14:27.32,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:14:27.65,0:14:30.24,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:14:30.53,0:14:31.49,Default,,0,0,0,,Уф!
Dialogue: 0,0:14:38.25,0:14:40.75,Default,,0,0,0,,Ахиллес! БУТЧИГИР!
Dialogue: 0,0:14:47.84,0:14:48.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:49.47,0:14:50.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:51.93,0:14:54.31,Default,,0,0,0,,Бұрандалы үшбұрыш
Dialogue: 0,0:14:54.60,0:14:56.52,Default,,0,0,0,,Артық бітіру үшін бір ұпай!
Dialogue: 0,0:14:57.14,0:14:59.98,Default,,0,0,0,,Айга жігіт Токонацудан жеңілді!
Dialogue: 0,0:15:00.06,0:15:01.02,Default,,0,0,0,,Сукуна соған тұрарлық.
Dialogue: 0,0:15:01.85,0:15:04.73,Default,,0,0,0,,Ахиллес жабайы болып, құлап қалды.
Dialogue: 0,0:15:04.90,0:15:05.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:05.86,0:15:06.73,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:07.15,0:15:09.74,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:11.57,0:15:13.07,Default,,0,0,0,,Күте тұрыңыз, Айга!
Dialogue: 0,0:15:13.53,0:15:14.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:16.41,0:15:18.83,Default,,0,0,0,,Әлгі жігіт дөрекі.
Dialogue: 0,0:15:19.25,0:15:21.46,Default,,0,0,0,,Сондай-ақ сиқыр сенің ерніңе де әсер етсін…
Dialogue: 0,0:15:25.42,0:15:28.46,Default,,0,0,0,,Қарғыс атсын... Ол күшті болды!
Dialogue: 0,0:15:31.13,0:15:32.76,Default,,0,0,0,,Ах... иә?
Dialogue: 0,0:15:33.47,0:15:34.51,Default,,0,0,0,,Суоу!
Dialogue: 0,0:15:34.60,0:15:36.01,Default,,0,0,0,,Мен оны қарап отырдым.
Dialogue: 0,0:15:36.14,0:15:38.64,Default,,0,0,0,,Жүректермен дөрекі тақырып сәйкестігі
Dialogue: 0,0:15:38.72,0:15:39.77,Default,,0,0,0,,Қандай тітіркендіргіш!
Dialogue: 0,0:15:40.10,0:15:42.48,Default,,0,0,0,,Сіз өзгердіңіз.
Dialogue: 0,0:15:42.90,0:15:43.77,Default,,0,0,0,,Әй?
Dialogue: 0,0:15:44.06,0:15:47.40,Default,,0,0,0,,Жауынгерлік кеме круизінде бірдеңе болған сияқты.
Dialogue: 0,0:15:47.73,0:15:49.65,Default,,0,0,0,,Мен кемеден түскеннен кейін
Dialogue: 0,0:15:50.03,0:15:53.24,Default,,0,0,0,,Ештеңе! Мен үшін ештеңе өзгермейді
Dialogue: 0,0:15:53.49,0:15:54.87,Default,,0,0,0,,Ол күшейе түсті!
Dialogue: 0,0:15:55.32,0:15:57.12,Default,,0,0,0,,Сіз күшейдіңіз бе?
Dialogue: 0,0:15:57.45,0:16:00.29,Default,,0,0,0,,Онда неге өзіңмен күреспеске?
Dialogue: 0,0:16:00.41,0:16:02.04,Default,,0,0,0,,Омемен шайқас?
Dialogue: 0,0:16:02.12,0:16:04.08,Default,,0,0,0,,Атағыңыздан айырылған сізге -
Dialogue: 0,0:16:04.17,0:16:06.92,Default,,0,0,0,,Жеңіске жету үшін қанша секунд қажет екенін көргім келеді.
Dialogue: 0,0:16:07.42,0:16:08.88,Default,,0,0,0,,Не?
Dialogue: 0,0:16:09.00,0:16:11.01,Default,,0,0,0,,Жарайды, мен істеймін!
Dialogue: 0,0:16:17.93,0:16:19.01,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:16:19.56,0:16:23.44,Default,,0,0,0,,Егер Ome шабуыл режимінде болса, онда бұл да шабуыл режимінде!
Dialogue: 0,0:16:24.02,0:16:25.10,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:16:26.77,0:16:29.86,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:16:29.98,0:16:32.36,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:16:32.70,0:16:33.57,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:38.53,0:16:41.33,Default,,0,0,0,,Жабайы жүр! Саламандр!
Dialogue: 0,0:16:43.75,0:16:45.58,Default,,0,0,0,,Артқа серпіліңіз! Ахиллес!
Dialogue: 0,0:16:53.17,0:16:54.05,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:54.38,0:16:56.76,Default,,0,0,0,,Қаттырақ бол, Саламандер!
Dialogue: 0,0:16:59.10,0:17:01.27,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:17:03.73,0:17:08.36,Default,,0,0,0,,Ха ха ха... (жүрек соғысы)
Dialogue: 0,0:17:13.44,0:17:17.61,Default,,0,0,0,,Уууу!
Dialogue: 0,0:17:21.49,0:17:25.16,Default,,0,0,0,,(Ахиллестің айқайы)
Dialogue: 0,0:17:27.42,0:17:29.63,Default,,0,0,0,,Саламандр!
Dialogue: 0,0:17:35.59,0:17:38.14,Default,,0,0,0,,Өрт құйын Гекирин!
Dialogue: 0,0:17:42.43,0:17:44.10,Default,,0,0,0,,Уф! Ах...
Dialogue: 0,0:17:44.85,0:17:46.44,Default,,0,0,0,,Мен Айғаны көрдім
Dialogue: 0,0:17:49.86,0:17:53.53,Default,,0,0,0,,Кенран тозақтан құлады!
Dialogue: 0,0:17:54.11,0:17:58.07,Default,,0,0,0,,Super Z Slash!
Dialogue: 0,0:17:59.95,0:18:03.58,Default,,0,0,0,,Уууу!
Dialogue: 0,0:18:05.91,0:18:07.75,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:13.34,0:18:14.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:15.26,0:18:17.59,Default,,0,0,0,,(Лэйди тауы) Хмм? Не айтқың келеді?
Dialogue: 0,0:18:17.84,0:18:21.47,Default,,0,0,0,,Уууу!
Dialogue: 0,0:18:25.06,0:18:25.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:26.73,0:18:28.85,Default,,0,0,0,,Өйткені, сен өзгердің.
Dialogue: 0,0:18:29.10,0:18:31.90,Default,,0,0,0,,Иә? Ештеңе өзгерген жоқ.
Dialogue: 0,0:18:32.02,0:18:33.69,Default,,0,0,0,,Тек күшейе түсті
Dialogue: 0,0:18:33.98,0:18:35.98,Default,,0,0,0,,Мен одан да күшті боламын!
Dialogue: 0,0:18:37.11,0:18:38.99,Default,,0,0,0,,Сіз қаншалықты алысқа баруға дайынсыз?
Dialogue: 0,0:18:39.32,0:18:41.45,Default,,0,0,0,,Мен кез келген жерге барамын
Dialogue: 0,0:18:42.37,0:18:46.25,Default,,0,0,0,,Қанша жүрсем де күшейемін!
Dialogue: 0,0:18:46.87,0:18:49.75,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:50.67,0:18:53.00,Default,,0,0,0,,Уууу!
Dialogue: 0,0:18:53.09,0:18:54.00,Default,,0,0,0,,Айга! Ах...
Dialogue: 0,0:18:54.50,0:18:56.00,Default,,0,0,0,,плюс отбасылық әулеттік қорқыныш, деп ойлаймын
Dialogue: 0,0:18:56.26,0:18:57.17,Default,,0,0,0,,Айга...
Dialogue: 0,0:18:57.55,0:18:59.59,Default,,0,0,0,,Мен Суохпен ұрысып жатырмын.
Dialogue: 0,0:18:59.72,0:19:01.89,Default,,0,0,0,,Мен саламандрды жарып жібердім!
Dialogue: 0,0:19:02.51,0:19:04.22,Default,,0,0,0,,Теме Ах...
Dialogue: 0,0:19:05.01,0:19:06.47,Default,,0,0,0,,Токонацу қайда орналасқан?
Dialogue: 0,0:19:06.56,0:19:09.64,Default,,0,0,0,,Мен бұрын сәтсіздікке ұшырадым, бірақ қазір бәрі жақсы.
Dialogue: 0,0:19:09.77,0:19:12.65,Default,,0,0,0,,Мен де оның үштұғырын құртамын!
Dialogue: 0,0:19:12.77,0:19:14.40,Default,,0,0,0,,Айға, сабыр ет!
Dialogue: 0,0:19:14.90,0:19:16.94,Default,,0,0,0,,Теме, сен не істей аласың?
Dialogue: 0,0:19:17.11,0:19:18.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:20.11,0:19:22.99,Default,,0,0,0,,Уф... Меніңше, шешілді!
Dialogue: 0,0:19:23.45,0:19:25.28,Default,,0,0,0,,Мен күштірек болуым керек
Dialogue: 0,0:19:25.70,0:19:28.54,Default,,0,0,0,,Сіз қазіргіден де күшті бола аласыз!
Dialogue: 0,0:19:29.00,0:19:32.79,Default,,0,0,0,,Иә, білемін! Бірақ бірдеңе дұрыс емес, Тем.
Dialogue: 0,0:19:32.92,0:19:35.00,Default,,0,0,0,,Бұл жерде ештеңе жоқ!
Dialogue: 0,0:19:35.09,0:19:36.88,Default,,0,0,0,,Түсінбедің, Сочо.
Dialogue: 0,0:19:36.96,0:19:37.84,Default,,0,0,0,,Не!
Dialogue: 0,0:19:38.38,0:19:40.84,Default,,0,0,0,,Мен өте үмітсізмін...
Dialogue: 0,0:19:40.97,0:19:43.05,Default,,0,0,0,,Неге түсінбейсің!
Dialogue: 0,0:19:43.39,0:19:44.51,Default,,0,0,0,,Айга...
Dialogue: 0,0:19:44.68,0:19:47.64,Default,,0,0,0,,Сочоның ақымақ!
Dialogue: 0,0:19:47.76,0:19:48.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:50.89,0:19:52.14,Default,,0,0,0,,Сочо
Dialogue: 0,0:19:52.44,0:19:54.77,Default,,0,0,0,,Бұл ештеңе емес, уайымдама.
Dialogue: 0,0:19:55.44,0:19:56.32,Default,,0,0,0,,Хе
Dialogue: 0,0:20:00.32,0:20:01.57,Default,,0,0,0,,Айгамен шайқас?
Dialogue: 0,0:20:01.99,0:20:03.66,Default,,0,0,0,,Сіз уайымдаған сияқтысыз.
Dialogue: 0,0:20:05.20,0:20:07.70,Default,,0,0,0,,Сізге кімнің жеңгені қызық па?
Dialogue: 0,0:20:08.16,0:20:11.41,Default,,0,0,0,,Одан гөрі мені неге шақырдың?
Dialogue: 0,0:20:11.54,0:20:15.54,Default,,0,0,0,,Сіз де көрдіңіз, солай ма? Жүректерге қарсы титулдық матч
Dialogue: 0,0:20:15.67,0:20:16.84,Default,,0,0,0,,Мұздатқыш балмұздақ жақсы-ақ, бірақ бұл да дәмді.
Dialogue: 0,0:20:17.04,0:20:20.96,Default,,0,0,0,,Мен оның мұндай дөрекілігін бірінші рет көруім.
Dialogue: 0,0:20:21.51,0:20:24.97,Default,,0,0,0,,Чемпион қанша мықты болса да жеңілетін кездер болады.
Dialogue: 0,0:20:25.09,0:20:26.55,Default,,0,0,0,,Айға да солай.
Dialogue: 0,0:20:26.64,0:20:28.31,Default,,0,0,0,,Солай емес пе?
Dialogue: 0,0:20:28.56,0:20:30.43,Default,,0,0,0,,Мысалы, Барто Аои
Dialogue: 0,0:20:30.81,0:20:32.85,Default,,0,0,0,,Мысалы, Ширасаги сарайы Луи
Dialogue: 0,0:20:33.19,0:20:35.44,Default,,0,0,0,,Олар жеңілсе де әдемі
Dialogue: 0,0:20:36.10,0:20:38.27,Default,,0,0,0,,Бұл нағыз чемпион
Dialogue: 0,0:20:38.82,0:20:41.11,Default,,0,0,0,,Айға жеңіліп қалды
Dialogue: 0,0:20:41.40,0:20:43.20,Default,,0,0,0,,Әдемі емес
Dialogue: 0,0:20:44.11,0:20:46.95,Default,,0,0,0,,Мен әдемі шайқасты аяқтаймын
Dialogue: 0,0:20:47.53,0:20:49.20,Default,,0,0,0,,Одан өзгеше
Dialogue: 0,0:20:53.46,0:20:55.79,Default,,0,0,0,,Сіз де көрдіңіз бе? Фубуки
Dialogue: 0,0:20:57.79,0:21:01.84,Default,,0,0,0,,Әуе кемесінің круизінде бірдеңе Айганы өзгертті.
Dialogue: 0,0:21:02.21,0:21:05.68,Default,,0,0,0,,Айға Ахиллеспен жаңғырып, күшейе түсті!
Dialogue: 0,0:21:08.01,0:21:10.18,Default,,0,0,0,,Бір нәрсеге айырбастау
Dialogue: 0,0:21:10.68,0:21:11.81,Default,,0,0,0,,Ол-
Dialogue: 0,0:21:11.89,0:21:15.02,Default,,0,0,0,,Мен қадам баспау керек әлемге қадам бастым.
Dialogue: 0,0:21:15.14,0:21:17.73,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:21:20.36,0:21:23.07,Default,,0,0,0,,Мен қолымнан келгенше жүре беремін.
Dialogue: 0,0:21:23.24,0:21:24.57,Default,,0,0,0,,Жоқ, жоқ!
Dialogue: 0,0:21:24.78,0:21:26.20,Default,,0,0,0,,Олардың қозғалысы туралы қандай да бір мәліметіңіз бар ма?
Dialogue: 0,0:21:26.78,0:21:30.20,Default,,0,0,0,,Ол ешқашан қайтып келмейді
Dialogue: 0,0:21:30.70,0:21:31.91,Default,,0,0,0,,Қайтып кел
Dialogue: 0,0:21:31.99,0:21:34.16,Default,,0,0,0,,Мен оны қайтарамын!
Dialogue: 0,0:21:35.46,0:21:36.42,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:21:40.63,0:21:43.09,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:21:46.72,0:21:48.55,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:21:48.68,0:21:54.10,Default,,0,0,0,,(жүрек соғысы)
Dialogue: 0,0:21:55.14,0:22:01.15,Default,,0,0,0,,♪~
Dialogue: 0,0:23:17.81,0:23:23.81,Default,,0,0,0,,~♪
Dialogue: 0,0:23:25.65,0:23:27.11,Default,,0,0,0,,Сіз мені біртүрлі деп ойлайсыз ба?
Dialogue: 0,0:23:27.48,0:23:30.20,Default,,0,0,0,,Маған тек күштірек болу керек!
Dialogue: 0,0:23:30.70,0:23:32.82,Default,,0,0,0,,Кайл Еркіннің алдында пайда болады
Dialogue: 0,0:23:33.49,0:23:34.87,Default,,0,0,0,,Балто да қозғала бастады!
Dialogue: 0,0:23:35.24,0:23:36.66,Default,,0,0,0,,Ал мен...
Dialogue: 0,0:23:36.79,0:23:38.83,Default,,0,0,0,,Уау! Мен жасаймын!
Dialogue: 0,0:23:39.66,0:23:42.25,Default,,0,0,0,,Келесі жолы «Beyblade Burst Super Zetsu»
Dialogue: 0,0:23:42.37,0:23:44.79,Default,,0,0,0,,"Қайта туылды! Super Z Valkyrie!!"
Dialogue: 0,0:23:45.29,0:23:47.25,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:47.38,0:23:49.30,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:50.80,0:23:56.80,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory