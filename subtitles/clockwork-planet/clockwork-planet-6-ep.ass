Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:32.93,0:01:35.93,Default,,0,0,0,,Абсолютті маневр қанды кісі өлтіру
Dialogue: 0,0:01:37.64,0:01:39.64,Default,,0,0,0,,Додж!
Dialogue: 0,0:01:51.73,0:01:54.23,Default,,0,0,0,,Льюдің секіруі!
Dialogue: 0,0:01:58.89,0:02:02.88,Default,,0,0,0,,Ағай, мен сізге түсіндіруге бір мүмкіндік беремін.
Dialogue: 0,0:02:02.88,0:02:05.38,Default,,0,0,0,,Өйткені мен Наото-самаға азу тістерімді аштым.
Dialogue: 0,0:02:05.38,0:02:08.57,Default,,0,0,0,,Әпкең болса да, жағдайға байланысты...
Dialogue: 0,0:02:08.57,0:02:11.17,Default,,0,0,0,,Мен оны толығымен жоямын.
Dialogue: 0,0:02:13.24,0:02:15.34,Default,,0,0,0,,Чан аға...
Dialogue: 0,0:02:17.39,0:02:19.39,Default,,0,0,0,,Льюдің секіруі!
Dialogue: 0,0:02:21.38,0:02:23.98,Default,,0,0,0,,《Бұл... жоқ...》
Dialogue: 0,0:02:34.71,0:02:38.73,Default,,0,0,0,,《Әпке, тобығыңызды сындырыңыз》
Dialogue: 0,0:02:38.73,0:02:42.33,Default,,0,0,0,,Льюдің әлгі қызы... дұрыс жұмыс істемейді.
Dialogue: 0,0:02:46.57,0:03:25.37,Default,,0,0,0,,♬～
Dialogue: 0,0:05:31.74,0:05:35.22,Default,,0,0,0,,Қыз, сенде жеңетін үміт бар ма?
Dialogue: 0,0:05:35.22,0:05:37.22,Default,,0,0,0,,Тәждің үстіңгі жағы!
Dialogue: 0,0:05:39.21,0:05:43.88,Default,,0,0,0,,Егер сіз Mute Scream қолданбасын пайдалансаңыз, сізде жеңіске жету мүмкіндігі аз болады.
Dialogue: 0,0:05:43.88,0:05:47.05,Default,,0,0,0,,Аз ғана, бұл сенімді.
Dialogue: 0,0:05:47.05,0:05:50.85,Default,,0,0,0,,Халтер? Шу шығармаңыз, ұстаңыз.
Dialogue: 0,0:05:51.89,0:05:53.91,Default,,0,0,0,,Сен өлесің бе?
Dialogue: 0,0:05:53.91,0:05:56.21,Default,,0,0,0,,Ол көп уақыт бұрын қайтыс болды.
Dialogue: 0,0:05:57.73,0:06:00.73,Default,,0,0,0,,Халтер Солға жылжыңыз!
Dialogue: 0,0:06:00.73,0:06:03.03,Default,,0,0,0,,Бұрын!
Dialogue: 0,0:06:06.57,0:06:08.57,Default,,0,0,0,,Тәж
Dialogue: 0,0:06:16.75,0:06:18.75,Default,,0,0,0,,Не?
Dialogue: 0,0:06:24.57,0:06:26.57,Default,,0,0,0,,Кеңістіктік манипуляция!?
Dialogue: 0,0:06:32.06,0:06:34.06,Default,,0,0,0,,Еден!
Dialogue: 0,0:06:38.07,0:06:40.17,Default,,0,0,0,,Халтер!
Dialogue: 0,0:06:50.38,0:06:52.38,Default,,0,0,0,,Хмф!
Dialogue: 0,0:06:55.74,0:06:57.74,Default,,0,0,0,,Соңында
Dialogue: 0,0:07:06.71,0:07:10.71,Default,,0,0,0,,Жарайды, еденнің астында терең жер асты қабаты бар.
Dialogue: 0,0:07:12.07,0:07:15.07,Default,,0,0,0,,Менің оңай оралуым мүмкін емес.
Dialogue: 0,0:07:16.49,0:07:19.29,Default,,0,0,0,,Өтірік!? Үйіндіні тіреу ретінде пайдалану...
Dialogue: 0,0:07:25.35,0:07:27.72,Default,,0,0,0,,Уау, бұл қорқынышты дыбыс
Dialogue: 0,0:07:27.72,0:07:30.05,Default,,0,0,0,,Үштік резонанс сенімдісіз бе!?
Dialogue: 0,0:07:30.05,0:07:34.23,Default,,0,0,0,,Бұл әзіл емес. Оны тек жауынгерлік кемелерге орнатуға болады.
Dialogue: 0,0:07:34.23,0:07:36.58,Default,,0,0,0,,Ірі жойқын қарулар...
Dialogue: 0,0:07:36.58,0:07:40.25,Default,,0,0,0,,Резонанстық ұсақтау зеңбірегі Резонанстық канон!
Dialogue: 0,0:07:40.25,0:07:42.25,Default,,0,0,0,,Льюден қашу!
Dialogue: 0,0:07:48.84,0:07:50.94,Default,,0,0,0,,Ахх, ия!
Dialogue: 0,0:08:04.07,0:08:06.07,Default,,0,0,0,,Қандай күш...
Dialogue: 0,0:08:06.07,0:08:08.39,Default,,0,0,0,,Амансың ба, Мари?
Dialogue: 0,0:08:08.39,0:08:11.05,Default,,0,0,0,,Қария, қаш!
Dialogue: 0,0:08:11.05,0:08:13.55,Default,,0,0,0,,Жоқ, біз оны уақытында орындамаймыз!
Dialogue: 0,0:08:16.23,0:08:18.24,Default,,0,0,0,,Халтер!
Dialogue: 0,0:08:18.24,0:08:20.84,Default,,0,0,0,,Лью мұны тоқтат!
Dialogue: 0,0:08:38.22,0:08:40.82,Default,,0,0,0,,Наото! Лью!
Dialogue: 0,0:08:47.06,0:08:49.06,Default,,0,0,0,,Өтірік...
Dialogue: 0,0:08:52.90,0:08:55.77,Default,,0,0,0,,Мари Күтіңіз, күтіңіз!
Dialogue: 0,0:08:55.77,0:08:57.87,Default,,0,0,0,,Мен оны тартамын
Dialogue: 0,0:09:05.67,0:09:07.90,Default,,0,0,0,,Халтер Эй, күте тұрыңыз.
Dialogue: 0,0:09:07.90,0:09:10.57,Default,,0,0,0,,Тоқта, тоқта! Жақсы емес
Dialogue: 0,0:09:10.57,0:09:12.72,Default,,0,0,0,,Артқа қайтып, екеуіне көмектес!
Dialogue: 0,0:09:12.72,0:09:14.73,Default,,0,0,0,,Бұл ысырапшыл➡
Dialogue: 0,0:09:14.73,0:09:18.56,Default,,0,0,0,,Жер асты терең қабаттарының ғарыш кеңістігінен айырмашылығы жоқ➡
Dialogue: 0,0:09:18.56,0:09:23.38,Default,,0,0,0,,Тірі адамның тірі қалуы мүмкін емес➡
Dialogue: 0,0:09:23.38,0:09:26.48,Default,,0,0,0,,Наото Миура қайтыс болды.
Dialogue: 0,0:09:32.06,0:09:34.66,Default,,0,0,0,,Жерде дерлік
Dialogue: 0,0:09:49.24,0:09:53.84,Default,,0,0,0,,Оны аздап асқазанға салып, содан кейін ыстық душ қабылдаңыз.
Dialogue: 0,0:10:02.72,0:10:05.39,Default,,0,0,0,,Болмауы керек төменгі қабат
Dialogue: 0,0:10:05.39,0:10:08.90,Default,,0,0,0,,Үлкен қару одан әрі төмен
Dialogue: 0,0:10:12.02,0:10:15.32,Default,,0,0,0,,Кім... және қандай мақсатта?
Dialogue: 0,0:10:19.07,0:10:22.07,Default,,0,0,0,,Миенің төбесін жау санау керек пе?
Dialogue: 0,0:10:28.40,0:10:30.40,Default,,0,0,0,,Аға…
Dialogue: 0,0:10:30.40,0:10:34.05,Default,,0,0,0,,Ол Киотодағы Core Tower жертөлесінде болуы керек еді.
Dialogue: 0,0:10:34.05,0:10:37.56,Default,,0,0,0,,Неліктен сен бұл нәрсені күзетіп тұрдың?
Dialogue: 0,0:10:48.24,0:10:50.24,Default,,0,0,0,,Буф!
Dialogue: 0,0:10:57.24,0:10:59.71,Default,,0,0,0,,≪(Халтер) Мари➡
Dialogue: 0,0:10:59.71,0:11:04.57,Default,,0,0,0,,Мен мұны үлкендердің міндеті ретінде айтайын деп ойлаймын.
Dialogue: 0,0:11:04.57,0:11:06.90,Default,,0,0,0,,Не?
Dialogue: 0,0:11:06.90,0:11:10.56,Default,,0,0,0,,Сен баласың, кішкентай қызсың.
Dialogue: 0,0:11:10.56,0:11:13.39,Default,,0,0,0,,Өзіңіз айттыңыз.
Dialogue: 0,0:11:13.39,0:11:16.05,Default,,0,0,0,,Сонымен не?
Dialogue: 0,0:11:16.05,0:11:19.23,Default,,0,0,0,,Кішкентай қыз кішкентай қыздай жыласа да
Dialogue: 0,0:11:19.23,0:11:21.83,Default,,0,0,0,,Ешкім шағымданбайды.
Dialogue: 0,0:11:24.39,0:11:26.39,Default,,0,0,0,,Мен айтайын
Dialogue: 0,0:11:26.39,0:11:31.21,Default,,0,0,0,,Ешкім айтпаса да, мен айтамын.
Dialogue: 0,0:11:31.21,0:11:33.56,Default,,0,0,0,,Кеше… Ах…
Dialogue: 0,0:11:33.56,0:11:36.90,Default,,0,0,0,,Егер мен осы жерде құлап, жылай бастасам, мен...
Dialogue: 0,0:11:36.90,0:11:39.90,Default,,0,0,0,,Мен бүлінемін
Dialogue: 0,0:11:44.93,0:11:47.01,Default,,0,0,0,,Шынымен бе? Оған екеуі неге керек болды?
Dialogue: 0,0:11:47.01,0:11:49.40,Default,,0,0,0,,Оны болжау мүмкін болса да➡
Dialogue: 0,0:11:49.40,0:11:52.05,Default,,0,0,0,,Ұсынылмайды.
Dialogue: 0,0:11:52.05,0:11:54.92,Default,,0,0,0,,Олай болса, сен де мұны білесің.
Dialogue: 0,0:11:54.92,0:11:57.72,Default,,0,0,0,,Менің артқа шегінетін ойым жоқ.
Dialogue: 0,0:12:00.89,0:12:03.88,Default,,0,0,0,,Наотоның орнына алынған өмір
Dialogue: 0,0:12:03.88,0:12:06.38,Default,,0,0,0,,Мен мұның бәрін пайдаланамын
Dialogue: 0,0:13:12.88,0:13:16.28,Default,,0,0,0,,≪(Губернатордың қызы) Иә!? Бүгінгі мейрамхана тоқтатылды ма?
Dialogue: 0,0:13:16.28,0:13:19.24,Default,,0,0,0,,Әкем кенет жұмысқа орналасты.
Dialogue: 0,0:13:19.24,0:13:22.11,Default,,0,0,0,,Біз жалғыз баруымыз керек.
Dialogue: 0,0:13:22.11,0:13:24.89,Default,,0,0,0,,Бұл дұрыс болуы мүмкін емес.
Dialogue: 0,0:13:24.89,0:13:27.69,Default,,0,0,0,,Мен оны асыға күттім.
Dialogue: 0,0:13:29.91,0:13:34.22,Default,,0,0,0,,Отбасыңыздың жиналысын үзгенім үшін кешіріңіз.
Dialogue: 0,0:13:34.22,0:13:36.74,Default,,0,0,0,,Сізге, Мие префектурасының губернаторы
Dialogue: 0,0:13:36.74,0:13:39.84,Default,,0,0,0,,Сізден шынымен сұрағым келетін нәрсе бар ма?
Dialogue: 0,0:13:42.73,0:13:44.73,Default,,0,0,0,,Сен, уау!
Dialogue: 0,0:13:47.56,0:13:51.55,Default,,0,0,0,,Гуах! Ахх
Dialogue: 0,0:13:51.55,0:13:55.22,Default,,0,0,0,,Тек сұрақтарға жауап беріңіз, жылау қажет емес.
Dialogue: 0,0:13:55.22,0:13:57.22,Default,,0,0,0,,Ой...
Dialogue: 0,0:13:57.22,0:14:01.06,Default,,0,0,0,,Мие зауытының түбінде жасалған үлкен қару.
Dialogue: 0,0:14:01.06,0:14:03.21,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:03.21,0:14:08.90,Default,,0,0,0,,Мен оның бар екенін білемін, бірақ толығырақ...➡
Dialogue: 0,0:14:08.90,0:14:11.56,Default,,0,0,0,,Аранжировка соларға қалдыру...➡
Dialogue: 0,0:14:11.56,0:14:13.56,Default,,0,0,0,,Уау! ➡
Dialogue: 0,0:14:13.56,0:14:19.73,Default,,0,0,0,,Бұл рас! Олар бір-біріне кедергі жасамауы керек ...
Dialogue: 0,0:14:19.73,0:14:22.75,Default,,0,0,0,,Мені өлтір ≪(Халтер) Қай жолмен?
Dialogue: 0,0:14:22.75,0:14:24.89,Default,,0,0,0,,Әнді көп айтқан жақсы.
Dialogue: 0,0:14:24.89,0:14:27.22,Default,,0,0,0,,Ия, тоқта...
Dialogue: 0,0:14:27.22,0:14:29.32,Default,,0,0,0,,Тыныш
Dialogue: 0,0:14:34.04,0:14:37.95,Default,,0,0,0,,≪(Әкім) Біз және олар бір лотос өміріміз➡
Dialogue: 0,0:14:37.95,0:14:41.40,Default,,0,0,0,,Бұл қаруды жасыру ғана емес➡
Dialogue: 0,0:14:41.40,0:14:46.39,Default,,0,0,0,,Егер олардың осы Миеде екені анықталса...
Dialogue: 0,0:14:46.39,0:14:49.06,Default,,0,0,0,,Олар кімдер?
Dialogue: 0,0:14:49.06,0:14:53.56,Default,,0,0,0,,Шига әскері, бір кездері тазартылған бөлім.
Dialogue: 0,0:14:56.07,0:15:02.21,Default,,0,0,0,,≪(Губернатор) 30 жыл бұрын Шигада ауқымды апат болды.
Dialogue: 0,0:15:02.21,0:15:04.22,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:15:04.22,0:15:07.54,Default,,0,0,0,,Бұл тәртіпсіздік Жапонияның бүкіл батысына әсер етеді.
Dialogue: 0,0:15:07.54,0:15:10.23,Default,,0,0,0,,Тазарту туралы шешім тез қабылданды.
Dialogue: 0,0:15:10.23,0:15:13.38,Default,,0,0,0,,Гильдия жөндеуді күтпеңіз
Dialogue: 0,0:15:13.38,0:15:17.05,Default,,0,0,0,,Бірақ бұл алдау.
Dialogue: 0,0:15:17.05,0:15:21.73,Default,,0,0,0,,Ол кезде Шигада электромагниттік технология бойынша зерттеулер жүргізіліп жатты.
Dialogue: 0,0:15:21.73,0:15:23.73,Default,,0,0,0,,Электромагниттік технология!?
Dialogue: 0,0:15:23.73,0:15:27.90,Default,,0,0,0,,Енді оны пайдалануға немесе зерттеуге тыйым салу керек, себебі ол берілістерді шатастырады.
Dialogue: 0,0:15:27.90,0:15:32.24,Default,,0,0,0,,Иә... бұл халықаралық келісімдерді бұзу➡
Dialogue: 0,0:15:32.24,0:15:35.72,Default,,0,0,0,,Тәжірибе кезінде ағып кеткен электромагниттік толқындар➡
Dialogue: 0,0:15:35.72,0:15:40.56,Default,,0,0,0,,Қала функцияларын толығымен тоқтатқан апат орын алды➡
Dialogue: 0,0:15:40.56,0:15:45.07,Default,,0,0,0,,Зерттеуге Жапония үкіметі жетекшілік етті➡
Dialogue: 0,0:15:45.07,0:15:51.04,Default,,0,0,0,,Оны жасыру үшін мен Шиганы тазартып, бәрі ешқашан болмағандай кейіп танытамын➡
Dialogue: 0,0:15:51.04,0:15:54.22,Default,,0,0,0,,Осыдан кейін Шига әскері кесілді➡
Dialogue: 0,0:15:54.22,0:15:58.40,Default,,0,0,0,,Инженерлер жер астына кетті➡
Dialogue: 0,0:15:58.40,0:16:01.05,Default,,0,0,0,,Олар Миды сахна сыртынан басқарады.
Dialogue: 0,0:16:01.05,0:16:04.72,Default,,0,0,0,,Шига мен үш сағаттық мұнараның қалдықтарын жалмау
Dialogue: 0,0:16:04.72,0:16:07.59,Default,,0,0,0,,Мен бұл жоспармен жұмыс істеп жатырмын.
Dialogue: 0,0:16:07.59,0:16:11.76,Default,,0,0,0,,азаматтың мемлекеттің тапсырысы бойынша заңсыз зерттеумен айналысқаны анықталды.
Dialogue: 0,0:16:11.76,0:16:14.54,Default,,0,0,0,,үндемеді, бірақ
Dialogue: 0,0:16:14.54,0:16:17.55,Default,,0,0,0,,Неліктен фактілерді жоққа шығармадыңыз?
Dialogue: 0,0:16:17.55,0:16:21.90,Default,,0,0,0,,Бұл жолы... Мие батып кетті➡
Dialogue: 0,0:16:21.90,0:16:26.56,Default,,0,0,0,,Үкіметпен тең келіссөздер жүргізу үшін сізге билік керек➡
Dialogue: 0,0:16:26.56,0:16:30.88,Default,,0,0,0,,Сол үлкен қару бұл мақсатқа тосқауыл болады➡
Dialogue: 0,0:16:30.88,0:16:35.27,Default,,0,0,0,,Үкімет бұл қарудың бар екенін біледі және одан қорқады➡
Dialogue: 0,0:16:35.27,0:16:37.32,Default,,0,0,0,,Mie➡ тазалау мүмкін емес
Dialogue: 0,0:16:37.32,0:16:43.37,Default,,0,0,0,,Бұл біз ешқашан қолданбауымыз керек және бір-бірімізге қадалған күш.
Dialogue: 0,0:16:43.37,0:16:45.89,Default,,0,0,0,,Тежеу, онда.
Dialogue: 0,0:16:45.89,0:16:48.71,Default,,0,0,0,,Неліктен бастауға дайындалуда?
Dialogue: 0,0:16:48.71,0:16:51.58,Default,,0,0,0,,Не!? Біз мұны шынымен көрдік.
Dialogue: 0,0:16:51.58,0:16:55.22,Default,,0,0,0,,Сөз жоқ, хехехе...
Dialogue: 0,0:16:55.22,0:16:57.57,Default,,0,0,0,,Ахахахаха!
Dialogue: 0,0:16:57.57,0:17:00.22,Default,,0,0,0,,Аузыңды жап!
Dialogue: 0,0:17:00.22,0:17:03.23,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,0:17:03.23,0:17:05.73,Default,,0,0,0,,Бұған қалай күлмеуге болады?
Dialogue: 0,0:17:05.73,0:17:10.55,Default,,0,0,0,,Ешқашан қолданбау керек тежеу ​​күші қолданылуда.
Dialogue: 0,0:17:10.55,0:17:14.55,Default,,0,0,0,,Не болып жатқаны анық болуы керек!
Dialogue: 0,0:17:14.55,0:17:19.56,Default,,0,0,0,,Оның үстіне кімнің себепкер болғанын білмейміз➡
Dialogue: 0,0:17:19.56,0:17:21.90,Default,,0,0,0,,Бұл күлкілі.
Dialogue: 0,0:17:21.90,0:17:24.23,Default,,0,0,0,,Сіз себепкерсіз➡
Dialogue: 0,0:17:24.23,0:17:26.73,Default,,0,0,0,,Мари Белле Бреге
Dialogue: 0,0:17:29.72,0:17:33.72,Default,,0,0,0,,(аяқ дыбыстары)
Dialogue: 0,0:17:48.56,0:17:52.23,Default,,0,0,0,,≪(Губернатор) бөлімі/Киото тазарту әрекеті оқиғасы➡
Dialogue: 0,0:17:52.23,0:17:54.71,Default,,0,0,0,,Сіз таратқан ақпаратпен➡
Dialogue: 0,0:17:54.71,0:17:59.40,Default,,0,0,0,,Үкімет қанша шығынға ұшырады және сенімін жоғалтты?➡
Dialogue: 0,0:17:59.40,0:18:01.92,Default,,0,0,0,,Үкіметке қажет➡
Dialogue: 0,0:18:01.92,0:18:06.72,Default,,0,0,0,,Өз өмірінің маңыздылығын дәлелдейтін айқын жаудың болуы
Dialogue: 0,0:18:06.72,0:18:10.26,Default,,0,0,0,,Ол жау біз, Мие!
Dialogue: 0,0:18:10.26,0:18:13.23,Default,,0,0,0,,Үкімет бізді басып, жеңді.
Dialogue: 0,0:18:13.23,0:18:15.90,Default,,0,0,0,,Әділдік жағына оралыңыз! ➡
Dialogue: 0,0:18:15.90,0:18:17.90,Default,,0,0,0,,Бұл сценарий!
Dialogue: 0,0:18:18.89,0:18:23.74,Default,,0,0,0,,Өзіңізді жақсы сезіндіңіз бе? Биліктің зұлымдығын әшкерелеймін➡
Dialogue: 0,0:18:23.74,0:18:25.71,Default,,0,0,0,,Өзіңізді жақсы сезінесіз бе? ➡
Dialogue: 0,0:18:25.71,0:18:30.25,Default,,0,0,0,,Сізді құлатуға тырысқан адамдарды алдаңыз.
Dialogue: 0,0:18:30.25,0:18:34.55,Default,,0,0,0,,Осыған көңіліңіз тола ма? Сіздің жалықтыратын әділдік сезімі
Dialogue: 0,0:18:34.55,0:18:37.55,Default,,0,0,0,,Көбірек адамдарды өлтіріңіз!
Dialogue: 0,0:18:37.55,0:18:40.22,Default,,0,0,0,,Неге тыныш өлмедің? ➡
Dialogue: 0,0:18:40.22,0:18:43.22,Default,,0,0,0,,Батыр боп сөйлеген бөтен бала!
Dialogue: 0,0:18:56.72,0:19:01.73,Default,,0,0,0,,≪Профессор (Халтер) Конрадтың ақпараты Мен дұрыс түсіндім.
Dialogue: 0,0:19:01.73,0:19:05.17,Default,,0,0,0,,《[Телевизия] (Конрад) Киотодағы бастапқы-Y сериясы》
Dialogue: 0,0:19:05.17,0:19:08.55,Default,,0,0,0,,《Теледидар Токиоға бір рет көшкеніне дәлел болды》
Dialogue: 0,0:19:08.55,0:19:11.47,Default,,0,0,0,,《[Телевизия] Және… Токиодағы әскерилер》
Dialogue: 0,0:19:11.47,0:19:16.16,Default,,0,0,0,,《[Телевизия] Әскери күштердің барлығы дерлік бір жерге шоғырланған сияқты》
Dialogue: 0,0:19:16.16,0:19:19.81,Default,,0,0,0,,≪(Халтер) Токио әскері және Жапония үкіметі➡
Dialogue: 0,0:19:19.81,0:19:24.55,Default,,0,0,0,,Олар мені шынымен жұдырықтайды ма?
Dialogue: 0,0:19:24.55,0:19:27.20,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:19:27.20,0:19:29.91,Default,,0,0,0,,Бұл сізді алаңдататын нәрсе емес.
Dialogue: 0,0:19:29.91,0:19:33.28,Default,,0,0,0,,Шиганы суға батырған үкімет кінәлі.
Dialogue: 0,0:19:33.28,0:19:37.93,Default,,0,0,0,,Мен білемін, бірақ...
Dialogue: 0,0:19:37.93,0:19:41.87,Default,,0,0,0,,Бірақ не? Алып қарулар мен Токио әскерлері арасындағы соғыс
Dialogue: 0,0:19:41.87,0:19:45.77,Default,,0,0,0,,Сіз оны тоқтатқыңыз келе ме? Сен маған аузыңды жауып қарап тұр дейсің бе?
Dialogue: 0,0:19:45.77,0:19:49.04,Default,,0,0,0,,Әй, дәрменсіз адамдар
Dialogue: 0,0:19:49.04,0:19:53.58,Default,,0,0,0,,Рұқсатсыз бірін-бірі жарып жіберуге болады.
Dialogue: 0,0:19:53.58,0:19:55.72,Default,,0,0,0,,Егер мен тым егжей-тегжейге тоқталсам,
Dialogue: 0,0:19:55.72,0:19:59.89,Default,,0,0,0,,Мен жай ғана фактілерді айтып отырмын.
Dialogue: 0,0:19:59.89,0:20:04.22,Default,,0,0,0,,Сонымен? Біз не істейміз?
Dialogue: 0,0:20:04.22,0:20:06.22,Default,,0,0,0,,Не істеуім керек...
Dialogue: 0,0:20:08.73,0:20:10.73,Default,,0,0,0,,Қазірдің өзінде...
Dialogue: 0,0:20:11.90,0:20:14.40,Default,,0,0,0,,Маған...
Dialogue: 0,0:20:15.99,0:20:18.59,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:20:18.59,0:20:21.37,Default,,0,0,0,,Мұндай дүние
Dialogue: 0,0:20:21.37,0:20:24.06,Default,,0,0,0,,Оның құны қандай...
Dialogue: 0,0:20:24.06,0:20:27.21,Default,,0,0,0,,Мақтанышпен дұрыс іс жасау
Dialogue: 0,0:20:27.21,0:20:30.72,Default,,0,0,0,,Жеткізу мүмкін емес нәрселер бар екенін түсінемін.
Dialogue: 0,0:20:30.72,0:20:37.57,Default,,0,0,0,,Сонда да мен Наотомен бірге болсам, бәрінен де асып түсетінімді сезіндім.
Dialogue: 0,0:20:37.57,0:20:41.87,Default,,0,0,0,,Мен оның өлуіне рұқсат бердім.
Dialogue: 0,0:20:44.10,0:20:49.10,Default,,0,0,0,,Мен сияқты кішкентай адам не істей алады?
Dialogue: 0,0:20:50.89,0:20:57.19,Default,,0,0,0,,(жылау)
Dialogue: 0,0:21:02.38,0:21:05.05,Default,,0,0,0,,Уау, эй, жаңбыр жауып тұр.
Dialogue: 0,0:21:05.05,0:21:08.05,Default,,0,0,0,,Канализациядан өтсең де, су басады, солай ма?
Dialogue: 0,0:21:08.05,0:21:12.56,Default,,0,0,0,,«Лас-шайып кетеді» деген ойдың өзі алаңдатады емес пе?
Dialogue: 0,0:21:12.56,0:21:15.95,Default,,0,0,0,,Көбінесе бұл жаңбыр нашар күтімге байланысты болса.
Dialogue: 0,0:21:15.95,0:21:19.38,Default,,0,0,0,,Менің киімімді ластау үшін әкімші жауапты болғанын қалаймын.
Dialogue: 0,0:21:19.38,0:21:22.39,Default,,0,0,0,,Мені жерге көмуіңді қалаймын.
Dialogue: 0,0:21:22.39,0:21:27.24,Default,,0,0,0,,Дәлірек айтсақ, ыстық және ылғалды. Жаңбыр жауса, салқынырақ болады, солай ма?
Dialogue: 0,0:21:27.24,0:21:31.73,Default,,0,0,0,,О, бұл Мари. Жоқ, араласпайық...
Dialogue: 0,0:21:31.73,0:21:36.57,Default,,0,0,0,,Құрметті Наото, сіз оқудың озық дағдысын игердіңіз!?
Dialogue: 0,0:21:36.57,0:21:39.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:47.76,0:21:49.71,Default,,0,0,0,,Бреге!
Dialogue: 0,0:21:49.71,0:21:53.72,Default,,0,0,0,,Тет… Таа~ Эй, қалжыңдап тұрсың...
Dialogue: 0,0:21:53.72,0:21:58.30,Default,,0,0,0,,Тірі болмасаң, жүзіңді көрсет!
Dialogue: 0,0:21:58.30,0:22:00.21,Default,,0,0,0,,Наото мырза, сәл күте тұрыңыз.
Dialogue: 0,0:22:00.21,0:22:02.91,Default,,0,0,0,,Мен бұл жынды итті дереу бөлшектеймін.
Dialogue: 0,0:22:02.91,0:22:06.51,Default,,0,0,0,,≪(Халтер) Жарайды, балалар тынышталыңдар.
Dialogue: 0,0:22:08.05,0:22:10.72,Default,,0,0,0,,-де не болды?
Dialogue: 0,0:22:10.72,0:22:15.72,Default,,0,0,0,,Чан ағамен төбелесіп жатқанымда, жер астындағы тіреуіш бар екенін байқадым.
Dialogue: 0,0:22:15.72,0:22:18.56,Default,,0,0,0,,Жарайды... Құлап кетсем жарайды деп ойлаймын.
Dialogue: 0,0:22:18.56,0:22:20.89,Default,,0,0,0,,Дұрыс емес
Dialogue: 0,0:22:20.89,0:22:24.73,Default,,0,0,0,,Мен өмір сүре алатын ортаның болғанына қарамастан.
Dialogue: 0,0:22:24.73,0:22:29.75,Default,,0,0,0,,Нәзік адамдар бар болғаны 10 секундта өлуі мүмкін еді.
Dialogue: 0,0:22:29.75,0:22:34.57,Default,,0,0,0,,Сондықтан мен сол жерде тұратын біртүрлі қариядан лифт жүргізуін өтіндім.
Dialogue: 0,0:22:34.57,0:22:38.40,Default,,0,0,0,,Қайтып келуіңіз құтты болсын.Құтты болсын!
Dialogue: 0,0:22:38.40,0:22:43.05,Default,,0,0,0,,Бір минут күте тұрыңыз, сіз өлуді жоспарлаған жоқсыз ба?
Dialogue: 0,0:22:43.05,0:22:45.22,Default,,0,0,0,,Иә? Сен не туралы айтып тұрсың?
Dialogue: 0,0:22:45.22,0:22:47.70,Default,,0,0,0,,Мен өлсем, Льюес мұңаяды.
Dialogue: 0,0:22:47.70,0:22:50.56,Default,,0,0,0,,Ағай, мен сізге көмектесе алмаймын.
Dialogue: 0,0:22:50.56,0:22:52.89,Default,,0,0,0,,Маған не көмектесті...
Dialogue: 0,0:22:52.89,0:22:56.73,Default,,0,0,0,,Иә? Сіз? Ол туды қайдан таптың?
Dialogue: 0,0:22:56.73,0:23:00.72,Default,,0,0,0,,Мен Чан ағаны тоқтатқым келді.
Dialogue: 0,0:23:00.72,0:23:03.40,Default,,0,0,0,,Мари Сіз кездейсоқ ақымақсыз ба?
Dialogue: 0,0:23:03.40,0:23:05.90,Default,,0,0,0,,Кукуку... Дұрыс айтасыз.
Dialogue: 0,0:23:07.22,0:23:11.21,Default,,0,0,0,,Ағайдың Токиоға кеткені рас па?
Dialogue: 0,0:23:11.21,0:23:14.05,Default,,0,0,0,,Ах, профессор Конрадтың ақпараты.
Dialogue: 0,0:23:14.05,0:23:18.22,Default,,0,0,0,,Хмм, Токиоға барайық, иә?
Dialogue: 0,0:23:18.22,0:23:20.72,Default,,0,0,0,,Чан ағай алып қаруды қорғап тұр
Dialogue: 0,0:23:20.72,0:23:24.21,Default,,0,0,0,,Әлгі алып қару Токиоға бет алды, солай ма?
Dialogue: 0,0:23:24.21,0:23:26.29,Default,,0,0,0,,Қарапайым тілмен айтқанда.
Dialogue: 0,0:23:26.29,0:23:29.23,Default,,0,0,0,,Нақты сұрақ - не істеу керек➡
Dialogue: 0,0:23:29.23,0:23:34.87,Default,,0,0,0,,Токио өз күштерін жинап жатыр, ал Ми үлкен қаруларды іске қосуда➡
Dialogue: 0,0:23:34.87,0:23:38.30,Default,,0,0,0,,Ал, Мие бірінші шабуыл жасайды деп ойлаймын.
Dialogue: 0,0:23:38.30,0:23:40.91,Default,,0,0,0,,Мен қазір сол үлкен қаруды қусам да,
Dialogue: 0,0:23:40.91,0:23:43.23,Default,,0,0,0,,Біз бұл туралы бірдеңе істей аламыз ба?
Dialogue: 0,0:23:43.23,0:23:45.60,Default,,0,0,0,,Олай болса, сені Токиода күтеміз бе?
Dialogue: 0,0:23:45.60,0:23:48.21,Default,,0,0,0,,Егер бұл орын алса, Токио шайқас алаңына айналады.
Dialogue: 0,0:23:48.21,0:23:50.57,Default,,0,0,0,,Зақым айтарлықтай болады.
Dialogue: 0,0:23:50.57,0:23:52.74,Default,,0,0,0,,Сонша шуламаңыз!
Dialogue: 0,0:23:52.74,0:23:57.16,Default,,0,0,0,,Оған қандай дәлел келтірсеңіз де, не істейтініңіз әлдеқашан шешілген!
Dialogue: 0,0:23:57.16,0:23:59.56,Default,,0,0,0,,Мен Чан ағайға көмектесемін
Dialogue: 0,0:23:59.56,0:24:02.06,Default,,0,0,0,,Сонымен, бұл туралы не істеуіміз керек?
Dialogue: 0,0:24:02.06,0:24:05.05,Default,,0,0,0,,Егер мен қаша алмайтын барлық себептерді тізсем,
Dialogue: 0,0:24:05.05,0:24:08.23,Default,,0,0,0,,Тіпті ақымақ адамның қолынан келеді! бұршақ пастасы? Ақымақ...
Dialogue: 0,0:24:08.23,0:24:11.29,Default,,0,0,0,,Мен сенің жалғыз болғаныңды қаламаймын.
Dialogue: 0,0:24:11.29,0:24:15.56,Default,,0,0,0,,«Қолымнан келмейді, қолымнан келмейді» деп ақымақ сияқты қайталап отырсың.
Dialogue: 0,0:24:15.56,0:24:18.21,Default,,0,0,0,,Нақты жоспар болмаса да!
Dialogue: 0,0:24:18.21,0:24:22.23,Default,,0,0,0,,Сіз оны білесіз бе? Мен жай ғана шошып, жылап жатырмын
Dialogue: 0,0:24:22.23,0:24:27.53,Default,,0,0,0,,Жаман жаңалықтарға толы жаяу минашы әйелден жақсы~
Dialogue: 0,0:24:31.21,0:24:33.21,Default,,0,0,0,,Ол сондай адам.
Dialogue: 0,0:24:33.21,0:24:36.55,Default,,0,0,0,,Ол ештеңе мүмкін емес деп ойламайтын әйел.
Dialogue: 0,0:24:36.55,0:24:40.05,Default,,0,0,0,,Дұрыс, әйтпесе сіз...
Dialogue: 0,0:24:40.05,0:24:42.65,Default,,0,0,0,,Тек минаға түскен әйел, солай ма?
Dialogue: 0,0:24:49.89,0:24:53.46,Default,,0,0,0,,Сен ақымақсың. Сен ақымақсың.
Dialogue: 0,0:24:53.46,0:24:57.40,Default,,0,0,0,,Ал сен менен артық ақымақ...
Dialogue: 0,0:24:57.40,0:25:00.39,Default,,0,0,0,,Қысқасы, бұл дүниеде тек ақымақтар ғана бар.
Dialogue: 0,0:25:00.39,0:25:04.56,Default,,0,0,0,,Барлығы ақылсыз, надан.
Dialogue: 0,0:25:04.56,0:25:09.38,Default,,0,0,0,,Өзімшіл жаратылыс, мені әлі жақсы көресің.
Dialogue: 0,0:25:09.38,0:25:14.38,Default,,0,0,0,,Бұл жыртылған дүниеде құны жоқ шығар.
Dialogue: 0,0:25:14.38,0:25:19.04,Default,,0,0,0,,Бірақ оның әлі де мағынасы болды.
Dialogue: 0,0:25:19.04,0:25:22.88,Default,,0,0,0,,Мари, сен жалғыз өзі қанша өлең жазып жатырсың?
Dialogue: 0,0:25:22.88,0:25:25.80,Default,,0,0,0,,Бұл мен естіген ``Chuunibyou'' деп аталатын нәрсе болуы мүмкін.
Dialogue: 0,0:25:25.80,0:25:28.06,Default,,0,0,0,,Сіз өте дөрекісіз!
Dialogue: 0,0:25:28.06,0:25:31.55,Default,,0,0,0,,Әйтеуір ағайға көмектесесіз.
Dialogue: 0,0:25:31.55,0:25:35.71,Default,,0,0,0,,Сондықтан мен әлемді құтқарамын, солай емес пе?\NСіз
Dialogue: 0,0:25:35.71,0:25:39.06,Default,,0,0,0,,-де нақты не істейсіз?
Dialogue: 0,0:25:39.06,0:25:41.41,Default,,0,0,0,,Бұл шешілді, солай ма?
Dialogue: 0,0:25:41.41,0:25:43.71,Default,,0,0,0,,Мен бәрін істеймін
Dialogue: 0,0:25:43.71,0:25:45.73,Default,,0,0,0,,Ең алдымен
Dialogue: 0,0:25:45.73,0:25:49.23,Default,,0,0,0,,Алдымен Токиоға шабуыл жасаймыз.
Dialogue: 0,0:25:51.89,0:26:16.89,Default,,0,0,0,,♬～
Dialogue: 0,0:26:18.39,0:26:24.39,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory