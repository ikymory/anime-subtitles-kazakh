Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:41.80,0:01:43.75,Default,,0,0,0,,Не...
Dialogue: 0,0:01:43.75,0:01:46.43,Default,,0,0,0,,Ескерту Постыңызды қалдырмаңыз!
Dialogue: 0,0:01:46.43,0:01:48.79,Default,,0,0,0,,≪(ﾘｭｰｽﾞ)ｱﾃﾝｼｮﾝ ﾌﾟﾘｰｽﾞ
Dialogue: 0,0:01:48.79,0:01:52.27,Default,,0,0,0,,I Бастапқы-Y сериясы 1-ші машина
Dialogue: 0,0:01:52.27,0:01:54.26,Default,,0,0,0,,Менің атым Льюз.
Dialogue: 0,0:01:54.26,0:01:58.26,Default,,0,0,0,,Бұл Initial-Y сериясы Субанки тобық!
Dialogue: 0,0:01:58.26,0:02:01.08,Default,,0,0,0,,Одан әрі сөзсіз,
Dialogue: 0,0:02:01.08,0:02:04.68,Default,,0,0,0,,Жақсы көңіл-күй...Мен сені ренжітпеймін.
Dialogue: 0,0:02:05.92,0:02:07.92,Default,,0,0,0,,О!
Dialogue: 0,0:02:12.93,0:02:14.93,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:02:19.27,0:02:22.82,Default,,0,0,0,,Алғашқы ауа шамамен 48 сағаттан кейін
Dialogue: 0,0:02:22.82,0:02:25.82,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:02:26.77,0:03:06.27,Default,,0,0,0,,♬～
Dialogue: 0,0:05:08.44,0:05:11.92,Default,,0,0,0,,Әй, әп-сәтте істеп жатырсың~
Dialogue: 0,0:05:11.92,0:05:14.91,Default,,0,0,0,,[ТЕЛ] (Наото) Мен таптым. Сағат 2 бағыты Иә?
Dialogue: 0,0:05:14.91,0:05:17.08,Default,,0,0,0,,[TEL] Біз 5 ұшақтан тұратын құрамдамыз. ≪(Белмот) Жарайды.
Dialogue: 0,0:05:17.08,0:05:20.06,Default,,0,0,0,,[ТЕЛ] (Мари) Сіз шынымен де жасай аласыз, солай ма?
Dialogue: 0,0:05:20.06,0:05:22.13,Default,,0,0,0,,Хе... сенбеңіз.
Dialogue: 0,0:05:22.13,0:05:24.09,Default,,0,0,0,,[ТЕЛ] Сене алмайсың!
Dialogue: 0,0:05:24.09,0:05:27.76,Default,,0,0,0,,Олай болса, жас ханым баптаған мына денеге сенбеңіз.
Dialogue: 0,0:05:27.76,0:05:30.76,Default,,0,0,0,,Сіз тамаша жұмыс жасадыңыз.
Dialogue: 0,0:05:33.08,0:05:35.08,Default,,0,0,0,,Кеттік.
Dialogue: 0,0:05:39.10,0:05:41.10,Default,,0,0,0,,О! Бұл жаман
Dialogue: 0,0:05:42.75,0:05:44.82,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:05:44.82,0:05:46.82,Default,,0,0,0,,Ора, ора, ора!
Dialogue: 0,0:05:48.26,0:05:50.76,Default,,0,0,0,,Уау! Қарқынды емес пе!
Dialogue: 0,0:05:50.76,0:05:54.06,Default,,0,0,0,,Келіңіздер, сізді бірге кондиционер жасайық!
Dialogue: 0,0:05:55.82,0:05:58.09,Default,,0,0,0,,≪(Ұшқыш) Бұл қандай автомат!?➡
Dialogue: 0,0:05:58.09,0:06:01.92,Default,,0,0,0,,Үй жануарларының протездік денесімен армиямызды мазақ ету!
Dialogue: 0,0:06:01.92,0:06:03.91,Default,,0,0,0,,Уф!
Dialogue: 0,0:06:03.91,0:06:06.41,Default,,0,0,0,,≪(Ұшқыш) Вахаха... Блять!
Dialogue: 0,0:06:07.91,0:06:12.07,Default,,0,0,0,,Эй... Эй, есікті ашатын кез келді.
Dialogue: 0,0:06:12.07,0:06:14.42,Default,,0,0,0,,Уф! Ей бала➡
Dialogue: 0,0:06:14.42,0:06:17.81,Default,,0,0,0,,Сіз жақсы көлік жүргізесіз. Біз доспыз, солай ма? ➡
Dialogue: 0,0:06:17.81,0:06:20.93,Default,,0,0,0,,Мына жігітпен темекі айырбастауға қарсысың ба? ➡
Dialogue: 0,0:06:20.93,0:06:23.74,Default,,0,0,0,,«Иә, жақсы.» Бұл жаман➡
Dialogue: 0,0:06:23.74,0:06:27.42,Default,,0,0,0,,Ұшудан алған әсерлеріңізді кейінірек айтыңыз.
Dialogue: 0,0:06:27.42,0:06:29.78,Default,,0,0,0,,Ах! Рақмет сізге!
Dialogue: 0,0:06:29.78,0:06:33.75,Default,,0,0,0,,Дәл «Адам ешкімге зиян тигізбеуі керек»? ➡
Dialogue: 0,0:06:33.75,0:06:37.35,Default,,0,0,0,,Сіз маған оңай айта аласыз, Наото-чан.
Dialogue: 0,0:06:39.58,0:06:44.53,Default,,0,0,0,,Жүр, мен үшін өлуге дайын тұрғандай жамбасыңды қимылда!
Dialogue: 0,0:06:44.53,0:06:47.77,Default,,0,0,0,,《(Мари) Халтердің миын қатты брондалған автоматқа қосыңыз》
Dialogue: 0,0:06:47.77,0:06:49.74,Default,,0,0,0,,《Мені қалжыңдап тұрсың ба!?》
Dialogue: 0,0:06:49.74,0:06:52.74,Default,,0,0,0,,《(Наот) Жоқ, менің ойымша, бұл қарт адамның қолынан келеді》
Dialogue: 0,0:06:52.74,0:06:55.91,Default,,0,0,0,,《Автоматтар адам миына қосылуға арналмаған.》
Dialogue: 0,0:06:55.91,0:06:57.93,Default,,0,0,0,,《Ал, бұл жағдайда》
Dialogue: 0,0:06:57.93,0:07:00.93,Default,,0,0,0,,《Не болса да, мен білмеймін.》
Dialogue: 0,0:07:00.93,0:07:03.95,Default,,0,0,0,,《Оңай болды, бірақ》 《Ол ақымақ сияқты сөйлейді.》
Dialogue: 0,0:07:03.95,0:07:07.76,Default,,0,0,0,,《Ол үшін әдетте прецедент бар...》 《Бар.》
Dialogue: 0,0:07:07.76,0:07:10.76,Default,,0,0,0,,《Не!?》 《Қару мен миды тікелей байланыстыр》
Dialogue: 0,0:07:10.76,0:07:14.31,Default,,0,0,0,,《Бір кездері оны шынымен сәтті жасаған адам➡》
Dialogue: 0,0:07:14.31,0:07:16.76,Default,,0,0,0,,《Ол күйеуінің өзінен басқа ешкім жоқ》
Dialogue: 0,0:07:16.76,0:07:19.42,Default,,0,0,0,,《Өтірік... Міне солай! 》
Dialogue: 0,0:07:19.42,0:07:22.42,Default,,0,0,0,,《Әңгіме шешілді》
Dialogue: 0,0:07:22.42,0:07:25.41,Default,,0,0,0,,《Енді қарияға лайық дене алайық》
Dialogue: 0,0:07:25.41,0:07:29.08,Default,,0,0,0,,《Иә!? Қарсыластың ортасында қатты бронды автомат》
Dialogue: 0,0:07:29.08,0:07:31.25,Default,,0,0,0,,《Оны ыңғайлы түрде түсіріңіз!?》
Dialogue: 0,0:07:31.25,0:07:33.90,Default,,0,0,0,,《Кім ондай нәрсе жасайды...》
Dialogue: 0,0:07:33.90,0:07:36.93,Default,,0,0,0,,《Аа...》 《Тек сенің қолыңнан келеді, солай ма? 》
Dialogue: 0,0:07:36.93,0:07:38.93,Default,,0,0,0,,Хе!
Dialogue: 0,0:07:50.41,0:07:54.59,Default,,0,0,0,,Мен сені сағындым, Генбу-чан.
Dialogue: 0,0:07:54.59,0:07:58.42,Default,,0,0,0,,《Шарт бар: машина Halter желісіне қосылған》
Dialogue: 0,0:07:58.42,0:08:00.42,Default,,0,0,0,,《Не? 》
Dialogue: 0,0:08:00.42,0:08:02.43,Default,,0,0,0,,《HS-FK2 Oberon》
Dialogue: 0,0:08:02.43,0:08:04.60,Default,,0,0,0,,《Ол бұл елде қолданылмайды》
Dialogue: 0,0:08:04.60,0:08:07.40,Default,,0,0,0,,《Оберон...》
Dialogue: 0,0:08:08.40,0:08:11.09,Default,,0,0,0,,《CZ-35 Genbu жақсы》
Dialogue: 0,0:08:11.09,0:08:13.42,Default,,0,0,0,,《Оберон сияқты дизайн тұжырымдамасы》
Dialogue: 0,0:08:13.42,0:08:15.59,Default,,0,0,0,,《Тенмикаширада да орнатылған》
Dialogue: 0,0:08:15.59,0:08:19.76,Default,,0,0,0,,《Сізде әлемдегі барлық қарулардың сызбалары бар ма? 》
Dialogue: 0,0:08:19.76,0:08:23.10,Default,,0,0,0,,《Әрине есімде》
Dialogue: 0,0:08:23.10,0:08:25.43,Default,,0,0,0,,《А... шын ба?》
Dialogue: 0,0:08:25.43,0:08:28.53,Default,,0,0,0,,Хаха! Бұл ең жақсы!
Dialogue: 0,0:08:39.08,0:08:41.10,Default,,0,0,0,,Уф! Ой ой
Dialogue: 0,0:08:41.10,0:08:44.10,Default,,0,0,0,,Сіз қисықсыз ба?
Dialogue: 0,0:08:48.76,0:08:53.36,Default,,0,0,0,,Керісінше, менің өткір кесектерімді жеме!
Dialogue: 0,0:09:02.25,0:09:05.41,Default,,0,0,0,,Бір нәрсені аяқтағаннан кейінгі тыныс алу ерекше~
Dialogue: 0,0:09:05.41,0:09:10.09,Default,,0,0,0,,[ТЕЛ] Аузыңды ашқан сайын тек дөрекі сөздер айтасың!?
Dialogue: 0,0:09:10.09,0:09:12.60,Default,,0,0,0,,Хахаха…➡
Dialogue: 0,0:09:12.60,0:09:15.75,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз, Ауыр автоматтар➡
Dialogue: 0,0:09:15.75,0:09:18.42,Default,,0,0,0,,Генбудің жасанды интеллектін ғана жойыңыз➡
Dialogue: 0,0:09:18.42,0:09:20.82,Default,,0,0,0,,Барлық басқа жауларды жойыңыз➡
Dialogue: 0,0:09:20.82,0:09:23.74,Default,,0,0,0,,Тапсырысыңызға көңіліңіз тола ма?
Dialogue: 0,0:09:23.74,0:09:28.18,Default,,0,0,0,,Сенің мұны шынымен істегеніңе сенбеймін бе?
Dialogue: 0,0:09:28.18,0:09:31.18,Default,,0,0,0,,Енді сіздің кезегіңіз.
Dialogue: 0,0:09:32.35,0:09:35.15,Default,,0,0,0,,Жарайды, міне. Бағасы 12 доллар болады.
Dialogue: 0,0:09:45.45,0:09:47.75,Default,,0,0,0,,Саған жақсы нәрсе айтайын ба?
Dialogue: 0,0:09:48.75,0:09:51.17,Default,,0,0,0,,Солдат дегеніміз не? Ұрыс даласында өмір сүру
Dialogue: 0,0:09:51.17,0:09:54.09,Default,,0,0,0,,Ұрыс даласында өлу үшін жасалған.
Dialogue: 0,0:09:54.09,0:09:57.24,Default,,0,0,0,,Егер Халтердің күйеуі болса
Dialogue: 0,0:09:57.24,0:10:01.26,Default,,0,0,0,,Майданның иісін сезсең, өлсең де оянарсың.
Dialogue: 0,0:10:01.26,0:10:05.07,Default,,0,0,0,,Бұл ең нашар көңіл-күйде.
Dialogue: 0,0:10:05.07,0:10:07.07,Default,,0,0,0,,Мари!
Dialogue: 0,0:10:07.07,0:10:09.07,Default,,0,0,0,,Біз тағы жиналдық
Dialogue: 0,0:10:09.07,0:10:13.42,Default,,0,0,0,,Жұмыс уақыты... 30 секунд
Dialogue: 0,0:10:13.42,0:10:16.29,Default,,0,0,0,,Жақсы ма? Иә
Dialogue: 0,0:10:16.29,0:10:18.79,Default,,0,0,0,,Мен мұны істеймін!
Dialogue: 0,0:10:28.92,0:10:31.52,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:33.74,0:10:35.74,Default,,0,0,0,,Хаа!
Dialogue: 0,0:11:18.34,0:11:20.42,Default,,0,0,0,,Сәлем, Наото-чан.
Dialogue: 0,0:11:20.42,0:11:23.08,Default,,0,0,0,,Бұл әйел шынымен адам ба?
Dialogue: 0,0:11:23.08,0:11:26.68,Default,,0,0,0,,Ах... бұл данышпандық.
Dialogue: 0,0:11:26.68,0:11:28.57,Default,,0,0,0,,Кереметтен де артық!
Dialogue: 0,0:11:28.57,0:11:31.07,Default,,0,0,0,,Анашым, сіз данышпансыз!
Dialogue: 0,0:11:31.07,0:11:33.77,Default,,0,0,0,,Ағатай қате түсінбеңіз
Dialogue: 0,0:11:33.77,0:11:36.77,Default,,0,0,0,,Бұл тек адами шектеулер.
Dialogue: 0,0:11:38.76,0:11:42.08,Default,,0,0,0,,Дәл қазір... әлі жоқ
Dialogue: 0,0:12:22.50,0:12:26.10,Default,,0,0,0,,Оян! Халтер!
Dialogue: 0,0:12:27.21,0:12:29.21,Default,,0,0,0,,Уф! Ха!?
Dialogue: 0,0:12:39.42,0:12:41.92,Default,,0,0,0,,Тәтті➡
Dialogue: 0,0:12:41.92,0:12:45.92,Default,,0,0,0,,Қай бейбақ мылтықты маған бағыттады? Ой
Dialogue: 0,0:12:46.99,0:12:50.11,Default,,0,0,0,,Халтер…
Dialogue: 0,0:12:50.11,0:12:53.40,Default,,0,0,0,,Халтер! Алақай!
Dialogue: 0,0:12:53.40,0:12:56.42,Default,,0,0,0,,О? Жағдай қандай?
Dialogue: 0,0:12:56.42,0:12:59.09,Default,,0,0,0,,Сіз мені автоматикаға қостыңыз ба?
Dialogue: 0,0:12:59.09,0:13:02.74,Default,,0,0,0,,Мен үшін не істеп жатырсың?
Dialogue: 0,0:13:02.74,0:13:06.40,Default,,0,0,0,,Шыдамыңды алайын... Не істеп жүр едің?!
Dialogue: 0,0:13:06.40,0:13:09.42,Default,,0,0,0,,Аа... Кешіріңіз, мен ұйықтап қалдым.
Dialogue: 0,0:13:09.42,0:13:11.74,Default,,0,0,0,,Ұйқы...?
Dialogue: 0,0:13:11.74,0:13:14.09,Default,,0,0,0,,Менің тыныш ұйықтағалы біраз болды.
Dialogue: 0,0:13:14.09,0:13:18.91,Default,,0,0,0,,Жоқ, сезім мүшелерім кесілгенде ұйқым келеді.
Dialogue: 0,0:13:18.91,0:13:20.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:20.91,0:13:22.95,Default,,0,0,0,,Қария, көңіл күйіңіз қалай?
Dialogue: 0,0:13:22.95,0:13:27.12,Default,,0,0,0,,Мәселе жоқ, бұл менің ханшайымымның жұмысы ғой.
Dialogue: 0,0:13:27.12,0:13:29.59,Default,,0,0,0,,Олай болса, мен сенен мұны бірден орындауды сұраймын.
Dialogue: 0,0:13:29.59,0:13:32.09,Default,,0,0,0,,Сіз қазіргі командирсіз бе?
Dialogue: 0,0:13:32.09,0:13:34.74,Default,,0,0,0,,Жарайды, тапсырысыңыз қандай?
Dialogue: 0,0:13:34.74,0:13:39.25,Default,,0,0,0,,Келесі 38 секунд ішінде ешкімді өлтірмеңіз
Dialogue: 0,0:13:39.25,0:13:43.08,Default,,0,0,0,,Қалған 378 жауды жойыңыз, жарай ма?
Dialogue: 0,0:13:43.08,0:13:46.08,Default,,0,0,0,,Не, оңай жеңіс пе?
Dialogue: 0,0:13:53.29,0:13:56.25,Default,,0,0,0,,Уау! Керемет!
Dialogue: 0,0:13:56.25,0:13:58.75,Default,,0,0,0,,Маған 38 секунд қажет емес.
Dialogue: 0,0:13:59.75,0:14:02.92,Default,,0,0,0,,≪(Халтер) Эй, ханшайым➡
Dialogue: 0,0:14:02.92,0:14:06.42,Default,,0,0,0,,Бұл дене сәл ауыр, бірақ оның пішіні жақсы.
Dialogue: 0,0:14:06.42,0:14:09.08,Default,,0,0,0,,Әрине бар.
Dialogue: 0,0:14:09.08,0:14:11.91,Default,,0,0,0,,Түзетулерді кім жасады деп ойлайсың?
Dialogue: 0,0:14:11.91,0:14:16.92,Default,,0,0,0,,Балалар сендерге сәттілік жетіспеді.
Dialogue: 0,0:14:16.92,0:14:20.42,Default,,0,0,0,,Бұл ең жақсы және ең жаман сезім!
Dialogue: 0,0:14:24.16,0:14:26.76,Default,,0,0,0,,≪(Тілші) Сене алар емеспін➡
Dialogue: 0,0:14:26.76,0:14:30.75,Default,,0,0,0,,Аманоми бағанының қауіпсіздігі бірнеше минут ішінде бұзылды➡
Dialogue: 0,0:14:30.75,0:14:35.19,Default,,0,0,0,,Топ басында отырған Акихабараға шабуыл жасады➡
Dialogue: 0,0:14:35.19,0:14:37.19,Default,,0,0,0,,Бұл бала.
Dialogue: 0,0:15:40.45,0:15:44.10,Default,,0,0,0,,[Теледидар] Ханымдар мен мырзалар! Менің дауысым есіңде ме?
Dialogue: 0,0:15:44.10,0:15:47.26,Default,,0,0,0,,[ТД] Менің әріптесім Акихабарада кеш өткізсе де.
Dialogue: 0,0:15:47.26,0:15:49.31,Default,,0,0,0,,[ТД] Оңай жойылу!
Dialogue: 0,0:15:49.31,0:15:52.45,Default,,0,0,0,,[Теледидар] Әскери жігіттер жауап бермейді~
Dialogue: 0,0:15:52.45,0:15:54.53,Default,,0,0,0,,Шига жігіттері!
Dialogue: 0,0:15:54.53,0:15:56.40,Default,,0,0,0,,Ол да сол баламен байланыста болды ма?
Dialogue: 0,0:15:56.40,0:15:59.42,Default,,0,0,0,,[ТД] Ант! 10 сағат ішінде аламыз
Dialogue: 0,0:15:59.42,0:16:03.09,Default,,0,0,0,,[Телевизия] Көп бөлімді аймақ/Токионың бәрі жарқыраған
Dialogue: 0,0:16:03.09,0:16:07.09,Default,,0,0,0,,[ТД] Мен оны құлатуға ант етемін! Алақай!
Dialogue: 0,0:16:07.09,0:16:10.18,Default,,0,0,0,,Не... не?! [ТД] Ой, кешіріңіз.
Dialogue: 0,0:16:10.18,0:16:14.40,Default,,0,0,0,,[Теледидар] Қонақ кім екенін ұмытып қалдым.
Dialogue: 0,0:16:14.40,0:16:17.09,Default,,0,0,0,,[ТД] Әй, кел! (Барлығы) О!
Dialogue: 0,0:16:17.09,0:16:19.07,Default,,0,0,0,,Жоғары мәртебелі Жұлдызды сарай…
Dialogue: 0,0:16:19.07,0:16:22.24,Default,,0,0,0,,[Теледидар] (Хоуко) Тыныштанып тыңдаңыз.
Dialogue: 0,0:16:22.24,0:16:24.41,Default,,0,0,0,,[Телевизия] Токио қаласын бақылау ұйымы.
Dialogue: 0,0:16:24.41,0:16:27.58,Default,,0,0,0,,[Теледидар] Осы елдегі барлық негізгі мұнараларды біріктіріңіз
Dialogue: 0,0:16:27.58,0:16:31.42,Default,,0,0,0,,[Теледидар] Аспан тірегін олар иемденді.
Dialogue: 0,0:16:31.42,0:16:34.91,Default,,0,0,0,,[Теледидар] Бұл хабар барлығына ең жақсы дәлел.
Dialogue: 0,0:16:34.91,0:16:38.74,Default,,0,0,0,,[Теледидар] Азаматтар, сабыр сақтаңыздар.
Dialogue: 0,0:16:38.74,0:16:41.41,Default,,0,0,0,,[ТД] Елордадан дереу эвакуациялаңыз
Dialogue: 0,0:16:41.41,0:16:43.81,Default,,0,0,0,,[Теледидар] өтінемін
Dialogue: 0,0:17:05.40,0:17:08.57,Default,,0,0,0,,Барлық қуатты қаруды негізгі зарядтауға жіберіңіз!
Dialogue: 0,0:17:08.57,0:17:11.26,Default,,0,0,0,,Негізгі мылтықты толтыруға басымдық беріңіз!
Dialogue: 0,0:17:17.25,0:17:23.09,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз, доктор Мэри, менің бір жаман жаңалығым бар➡
Dialogue: 0,0:17:23.09,0:17:25.24,Default,,0,0,0,,Ішке кіріп жатқан Карасава мырзадан➡
Dialogue: 0,0:17:25.24,0:17:28.74,Default,,0,0,0,,Жапон үкіметінің хабары болды
Dialogue: 0,0:17:28.74,0:17:32.36,Default,,0,0,0,,Биік таяқшаны қолданыңыз, иә!?
Dialogue: 0,0:17:32.36,0:17:35.25,Default,,0,0,0,,Ақылы таяқша бүгін тура сағат 14:00-де түсіріледі.
Dialogue: 0,0:17:35.25,0:17:38.25,Default,,0,0,0,,Енді алты сағат 45 минуттан кейін.
Dialogue: 0,0:17:38.25,0:17:40.25,Default,,0,0,0,,Не!?
Dialogue: 0,0:17:44.39,0:17:49.75,Default,,0,0,0,,Ах! Мен осы бақыт үшін өмір сүремін!
Dialogue: 0,0:17:49.75,0:17:53.42,Default,,0,0,0,,Тізедегі жастық – құдайлар да қызғанатын қазына.
Dialogue: 0,0:17:53.42,0:17:56.74,Default,,0,0,0,,Шынымен де ерекше сән-салтанат.
Dialogue: 0,0:17:56.74,0:17:59.57,Default,,0,0,0,,Әке, мен рұқсат алғым келеді.
Dialogue: 0,0:17:59.57,0:18:02.66,Default,,0,0,0,,Иә, иә! Папанның асқазанында
Dialogue: 0,0:18:02.66,0:18:05.08,Default,,0,0,0,,Кіріңіз!
Dialogue: 0,0:18:05.08,0:18:07.73,Default,,0,0,0,,Иә! Эххе...
Dialogue: 0,0:18:07.73,0:18:11.40,Default,,0,0,0,,Әке, күн жылы.
Dialogue: 0,0:18:11.40,0:18:13.75,Default,,0,0,0,,Кача! енді осы сәт
Dialogue: 0,0:18:13.75,0:18:18.96,Default,,0,0,0,,Дүниеде менен асқан бақытты жан жоқ!
Dialogue: 0,0:18:18.96,0:18:21.41,Default,,0,0,0,,Егер сіз Яцузукашинді тоқтатсаңыз
Dialogue: 0,0:18:21.41,0:18:24.80,Default,,0,0,0,,Үкімет сонымен қатар торвонды қолдануды тоқтатады.
Dialogue: 0,0:18:24.80,0:18:27.07,Default,,0,0,0,,Барлығыңыз, дереу жұмысқа кірісіңіздер.
Dialogue: 0,0:18:27.07,0:18:29.07,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:29.07,0:18:32.11,Default,,0,0,0,,Сәл қарсы боласыз ба?
Dialogue: 0,0:18:32.11,0:18:36.11,Default,,0,0,0,,Профессор Конрад, сәл күте тұрыңыз.
Dialogue: 0,0:18:37.08,0:18:40.06,Default,,0,0,0,,≪(Хоуко) Біраз уақыт өтті, Мари.
Dialogue: 0,0:18:40.06,0:18:42.42,Default,,0,0,0,,Сенің жерлеуіңнен бері болды ма?
Dialogue: 0,0:18:42.42,0:18:45.59,Default,,0,0,0,,Бұл табыт бос болды.
Dialogue: 0,0:18:45.59,0:18:50.57,Default,,0,0,0,,Сіз оны әлі де киіп жүрдіңіз, әрине.
Dialogue: 0,0:18:50.57,0:18:53.14,Default,,0,0,0,,Маңызды достардың жұмыстары
Dialogue: 0,0:18:53.14,0:18:56.08,Default,,0,0,0,,Бұл маңызды сыйлық.
Dialogue: 0,0:18:56.08,0:19:00.47,Default,,0,0,0,,Не? Сіз бір-біріңізді танисыз ба? Бұл дұрыс
Dialogue: 0,0:19:00.47,0:19:03.40,Default,,0,0,0,,Еуропада мен шетелде оқыған университетте таныстық.
Dialogue: 0,0:19:03.40,0:19:07.41,Default,,0,0,0,,Алайда Мари бір айда бітірді.
Dialogue: 0,0:19:07.41,0:19:11.08,Default,,0,0,0,,Егер мен Йокомен ойнамағанымда, мен бір аптадан кейін мектепті бітірер едім.
Dialogue: 0,0:19:11.08,0:19:15.12,Default,,0,0,0,,Жарайды, мен кедергі болған сияқты емеспін.
Dialogue: 0,0:19:15.12,0:19:18.07,Default,,0,0,0,,Мен үнемі адамдарды сүйреп жүрсем де.
Dialogue: 0,0:19:18.07,0:19:20.75,Default,,0,0,0,,Маған жақын арада хабарлайсыз ба?
Dialogue: 0,0:19:20.75,0:19:23.76,Default,,0,0,0,,Тенмикаширамен не істеуді жоспарлап отырсыз?
Dialogue: 0,0:19:23.76,0:19:25.76,Default,,0,0,0,,Осы мақсатқа жету үшін бәрін қолданамыз — Титан күшін де, сенің қаруларыңды да. ➡
Dialogue: 0,0:19:26.74,0:19:30.08,Default,,0,0,0,,Акихабарада пайда болған алып қару туралы
Dialogue: 0,0:19:30.08,0:19:32.08,Default,,0,0,0,,Сіз қаншалықты білесіз?
Dialogue: 0,0:19:32.08,0:19:35.09,Default,,0,0,0,,Хабарлама бойынша бұрынғы Шига әскері
Dialogue: 0,0:19:35.09,0:19:38.07,Default,,0,0,0,,Үкіметке қарсы төңкеріс жасау
Dialogue: 0,0:19:38.07,0:19:40.07,Default,,0,0,0,,Және мән-жайларды ескере отырып
Dialogue: 0,0:19:40.07,0:19:43.41,Default,,0,0,0,,Бұл электромагниттік қару болуы керек... немесе солай.
Dialogue: 0,0:19:43.41,0:19:46.41,Default,,0,0,0,,Күтілгендей...
Dialogue: 0,0:19:46.41,0:19:51.50,Default,,0,0,0,,Иә, бұл шабуыл бүкіл Акихабараны магнитке айналдырды.
Dialogue: 0,0:19:51.50,0:19:56.74,Default,,0,0,0,,Бірақ егер біз алып қаруды жойып, оны магнитсіздендірсек...
Dialogue: 0,0:19:56.74,0:20:00.41,Default,,0,0,0,,Жөндеу мүмкін, сондықтан...
Dialogue: 0,0:20:00.41,0:20:02.41,Default,,0,0,0,,Оны қазанда қайнатыңыз
Dialogue: 0,0:20:02.41,0:20:06.75,Default,,0,0,0,,Кәстрөл - Акихабара, температурасы шамамен 2000 градус...
Dialogue: 0,0:20:06.75,0:20:08.75,Default,,0,0,0,,Бұл мүмкін
Dialogue: 0,0:20:08.75,0:20:12.41,Default,,0,0,0,,Тек осы Тенмикашира
Dialogue: 0,0:20:12.41,0:20:15.41,Default,,0,0,0,,Мұның бәрі оның ойлап тапқан нәрсесі.
Dialogue: 0,0:20:18.08,0:20:20.08,Default,,0,0,0,,Бұл қауіпті, мен өлемін...
Dialogue: 0,0:20:20.08,0:20:22.15,Default,,0,0,0,,Мен өлетініме өте қуаныштымын~
Dialogue: 0,0:20:22.15,0:20:24.07,Default,,0,0,0,,Әке, сіз өле алмайсыз!
Dialogue: 0,0:20:24.07,0:20:26.75,Default,,0,0,0,,Ағай осында болса болды.
Dialogue: 0,0:20:26.75,0:20:30.14,Default,,0,0,0,,Папан мүлдем жеңілмейді!
Dialogue: 0,0:20:30.14,0:20:33.79,Default,,0,0,0,,Әке! Аа~ мен өлетін боламын~
Dialogue: 0,0:20:33.79,0:20:37.45,Default,,0,0,0,,Көріп тұрғаныңыздай, сіз өте ақымақсыз.
Dialogue: 0,0:20:37.45,0:20:42.45,Default,,0,0,0,,Бірақ істеймін десең, не болса да істей беретін ақымақсың.
Dialogue: 0,0:20:49.94,0:20:53.41,Default,,0,0,0,,《Жарайды, түсіндім, Мари, жасайық.》
Dialogue: 0,0:20:53.41,0:20:56.42,Default,,0,0,0,,《Иә》
Dialogue: 0,0:20:56.42,0:20:59.85,Default,,0,0,0,,Ол шынымен де осы аспан бағанасын тек дыбыспен жасады.
Dialogue: 0,0:20:59.85,0:21:02.76,Default,,0,0,0,,Түсінесің, ақымақ емес пе?
Dialogue: 0,0:21:02.76,0:21:05.74,Default,,0,0,0,,≪(Йоко) Иә, бірақ➡
Dialogue: 0,0:21:05.74,0:21:09.26,Default,,0,0,0,,Оған сізден басқа ешкім сенбейді.
Dialogue: 0,0:21:09.26,0:21:13.73,Default,,0,0,0,,Мен мұны жек көремін, бірақ оның қатысуы қауіпсіздік мақсатында.
Dialogue: 0,0:21:13.73,0:21:16.09,Default,,0,0,0,,Бұл өте ауыр зиян.
Dialogue: 0,0:21:16.09,0:21:18.26,Default,,0,0,0,,Мен де солай ойлаймын.
Dialogue: 0,0:21:18.26,0:21:21.83,Default,,0,0,0,,Күтпеген жағдай болмай тұрып, оны...
Dialogue: 0,0:21:21.83,0:21:23.74,Default,,0,0,0,,Әй, жақсы!
Dialogue: 0,0:21:23.74,0:21:26.40,Default,,0,0,0,,Суицидтік ойларыңыз болса
Dialogue: 0,0:21:26.40,0:21:30.57,Default,,0,0,0,,Жарты қадам жасай аласыз ба?
Dialogue: 0,0:21:30.57,0:21:34.47,Default,,0,0,0,,Әлемдегі ең ауыртпалықсыз эвтаназияны қамтамасыз ету
Dialogue: 0,0:21:34.47,0:21:36.59,Default,,0,0,0,,Мен уәде беремін
Dialogue: 0,0:21:36.59,0:21:40.58,Default,,0,0,0,,Әкеге бірдеңе жасасам ше... Ха...
Dialogue: 0,0:21:40.58,0:21:45.38,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймын, бірақ төмендете аласыз.
Dialogue: 0,0:21:46.57,0:21:48.65,Default,,0,0,0,,Сәлем, Льюес мырза!
Dialogue: 0,0:21:48.65,0:21:51.92,Default,,0,0,0,,Кенеттен ұшып кетпеңіз. Мен басымды ұрдым!
Dialogue: 0,0:21:51.92,0:21:54.41,Default,,0,0,0,,Бұл үшін кешірім сұраймын, бірақ
Dialogue: 0,0:21:54.41,0:21:56.76,Default,,0,0,0,,Наото-саманың ми жасушалары да нашар
Dialogue: 0,0:21:56.76,0:22:00.13,Default,,0,0,0,,Ол азды-көпті белсенді болуы мүмкін.
Dialogue: 0,0:22:00.13,0:22:02.08,Default,,0,0,0,,Уау!
Dialogue: 0,0:22:02.08,0:22:06.75,Default,,0,0,0,,Ауырды, ауырады, ұшады! Ұшыңыз, ұшып кетіңіз!
Dialogue: 0,0:22:06.75,0:22:09.74,Default,,0,0,0,,Ол біртүрлі адам. Ол жай ғана ақымақ.
Dialogue: 0,0:22:09.74,0:22:13.41,Default,,0,0,0,,Мен де жұмысқа қайта ораламын, Мари.
Dialogue: 0,0:22:13.41,0:22:16.58,Default,,0,0,0,,Неліктен бірге жұмыс істемейді?
Dialogue: 0,0:22:16.58,0:22:19.73,Default,,0,0,0,,Мен осы уақытқа дейін жеткілікті жұмыс жасадым.
Dialogue: 0,0:22:19.73,0:22:22.65,Default,,0,0,0,,Енді менің кезегім
Dialogue: 0,0:22:22.65,0:22:26.45,Default,,0,0,0,,Мен оған жеңілгім келмейді.
Dialogue: 0,0:22:31.24,0:22:34.41,Default,,0,0,0,,Жарайды, бұл дұрыс.
Dialogue: 0,0:22:34.41,0:22:37.42,Default,,0,0,0,,Ағай? Ана
Dialogue: 0,0:22:37.42,0:22:39.42,Default,,0,0,0,,Мені «ана» деп атауды доғарыңыз
Dialogue: 0,0:22:39.42,0:22:42.51,Default,,0,0,0,,Не болды? Наото мен Льюес ше?
Dialogue: 0,0:22:42.51,0:22:46.41,Default,,0,0,0,,Әкесі мен әпкесінің сөйлесетін маңызды нәрсесі бар.
Dialogue: 0,0:22:46.41,0:22:49.10,Default,,0,0,0,,Бұл маңызды тақырып...
Dialogue: 0,0:22:49.10,0:22:51.70,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:23:00.74,0:23:03.58,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:23:03.58,0:23:06.60,Default,,0,0,0,,Ағай, бос уақытыңыз болса, көмектесе аласыз ба?
Dialogue: 0,0:23:06.60,0:23:09.70,Default,,0,0,0,,А... иә!
Dialogue: 0,0:23:12.24,0:23:15.09,Default,,0,0,0,,Уау! Керемет!
Dialogue: 0,0:23:15.09,0:23:18.48,Default,,0,0,0,,Гүлдер! Гүлдер! Ол да шынайы!
Dialogue: 0,0:23:18.48,0:23:23.43,Default,,0,0,0,,Наото-сама, мені осындай жерге әкелгеніңізге сене алар емеспін.
Dialogue: 0,0:23:23.43,0:23:26.03,Default,,0,0,0,,Сіз қалай ойнағыңыз келеді?
Dialogue: 0,0:23:28.42,0:23:30.45,Default,,0,0,0,,Иә? Жақында не?
Dialogue: 0,0:23:30.45,0:23:34.41,Default,,0,0,0,,Мен Льюес маған дұрыс қарамаған сияқтымын.
Dialogue: 0,0:23:34.41,0:23:37.41,Default,,0,0,0,,Ондай нәрсе жоқ
Dialogue: 0,0:23:37.41,0:23:41.08,Default,,0,0,0,,Сізді үнемі бақылап отыратындай әсерде болуыңыз керек.
Dialogue: 0,0:23:41.08,0:23:44.18,Default,,0,0,0,,Наото-саманың өзін-өзі санауы тым көп шығар...
Dialogue: 0,0:23:45.25,0:23:47.25,Default,,0,0,0,,Тәж
Dialogue: 0,0:23:47.25,0:23:50.31,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:23:50.31,0:23:54.11,Default,,0,0,0,,Сәйкес келетін бет жоқ...
Dialogue: 0,0:23:55.25,0:23:58.25,Default,,0,0,0,,Планета тағдыры өз қолыңда...
Dialogue: 0,0:23:58.25,0:24:02.75,Default,,0,0,0,,Мұндай орны толмас зиян...
Dialogue: 0,0:24:02.75,0:24:07.75,Default,,0,0,0,,Кешіріңіз, Наото-сама...
Dialogue: 0,0:24:09.08,0:24:12.13,Default,,0,0,0,,Тәжі қауіпсіз болса, бұл жақсы.
Dialogue: 0,0:24:12.13,0:24:16.08,Default,,0,0,0,,Оны ер адамның медалі деп ойламайсың ба?
Dialogue: 0,0:24:16.08,0:24:18.44,Default,,0,0,0,,Жоқ
Dialogue: 0,0:24:18.44,0:24:23.04,Default,,0,0,0,,Өтінемін, мұндай қабілетсіз қызметшіні жазалаңыз.
Dialogue: 0,0:24:26.41,0:24:29.71,Default,,0,0,0,,Жарайды, көзіңді жұмы.
Dialogue: 0,0:24:34.75,0:24:38.05,Default,,0,0,0,,Сіз көзіңізді аша аласыз.
Dialogue: 0,0:24:40.84,0:24:42.74,Default,,0,0,0,,Иә!?
Dialogue: 0,0:24:42.74,0:24:45.73,Default,,0,0,0,,Наото...сама!?
Dialogue: 0,0:24:45.73,0:24:48.77,Default,,0,0,0,,Бұл жаза ма?
Dialogue: 0,0:24:48.77,0:24:51.42,Default,,0,0,0,,Иә, бұл жаза.
Dialogue: 0,0:24:51.42,0:24:54.07,Default,,0,0,0,,Мен жасаған сақина
Dialogue: 0,0:24:54.07,0:24:58.07,Default,,0,0,0,,Сізге ұнамауы мүмкін, бірақ
Dialogue: 0,0:24:58.07,0:25:01.75,Default,,0,0,0,,Мен оны үнемі киемін...
Dialogue: 0,0:25:01.75,0:25:03.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:25:06.42,0:25:09.47,Default,,0,0,0,,Мен мұндай нәрседен қорқамын
Dialogue: 0,0:25:09.47,0:25:13.24,Default,,0,0,0,,Ол белгілі бір көрініспен бірге жүруі керек деп есептейді.
Dialogue: 0,0:25:13.24,0:25:17.29,Default,,0,0,0,,Алайда ол тек сымбатты еркектермен шектеледі.
Dialogue: 0,0:25:17.29,0:25:20.25,Default,,0,0,0,,А... рақым жоқ~
Dialogue: 0,0:25:20.25,0:25:23.40,Default,,0,0,0,,Мен мұндай нәрсені енді ешқашан жасамауым керек.
Dialogue: 0,0:25:23.40,0:25:27.09,Default,,0,0,0,,Маған уәде беріңізші. Иә, кешіріңіз...
Dialogue: 0,0:25:27.09,0:25:30.09,Default,,0,0,0,,Бұдан былай ештеңе болмайды.
Dialogue: 0,0:25:32.76,0:25:36.36,Default,,0,0,0,,Мен білемін, Льюз.
Dialogue: 0,0:25:51.86,0:26:14.66,Default,,0,0,0,,♬～
Dialogue: 0,0:26:16.16,0:26:22.16,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory