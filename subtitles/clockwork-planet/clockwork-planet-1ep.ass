Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:02:28.59,0:02:32.16,Default,,0,0,0,,Екі үнсіз тікұшақ 9 секундта келеді.
Dialogue: 0,0:02:32.16,0:02:37.08,Default,,0,0,0,,12 жауынгерлік автоматы бар 1 көлік тікұшағы.
Dialogue: 0,0:02:37.08,0:02:41.18,Default,,0,0,0,,3 2 1 нөл
Dialogue: 0,0:02:47.27,0:02:49.27,Default,,0,0,0,,Тоут
Dialogue: 0,0:02:59.18,0:03:01.79,Default,,0,0,0,,Оңтүстік-шығыс жақтан жаудың күшейту күштері.
Dialogue: 0,0:03:01.79,0:03:06.24,Default,,0,0,0,,12 секундтан кейін, оған дейін тазалаңыз, Мари.
Dialogue: 0,0:03:06.24,0:03:09.41,Default,,0,0,0,,Неліктен Наото иегін пайдалануы керек?
Dialogue: 0,0:03:09.41,0:03:12.41,Default,,0,0,0,,Оны бастаған сен болсаң керек, ханшайым.
Dialogue: 0,0:03:12.41,0:03:16.71,Default,,0,0,0,,Сен менің күзетшім болсаң да, мен сені мазақ етіп отырған жоқпын.
Dialogue: 0,0:03:17.75,0:03:19.75,Default,,0,0,0,,О, менің...
Dialogue: 0,0:03:26.08,0:03:28.25,Default,,0,0,0,,Күтілгендей, бұл
Dialogue: 0,0:03:28.25,0:03:30.58,Default,,0,0,0,,Бұл біраз қиындық туғызады.
Dialogue: 0,0:03:30.58,0:03:33.19,Default,,0,0,0,,Енді не істеуіміз керек?
Dialogue: 0,0:03:33.19,0:03:35.40,Default,,0,0,0,,Сәлеметсіз бе.
Dialogue: 0,0:03:35.40,0:03:38.92,Default,,0,0,0,,Бітті, эй, Льюдікі.
Dialogue: 0,0:03:38.92,0:03:41.01,Default,,0,0,0,,Иә, Наото-сама.
Dialogue: 0,0:03:41.01,0:03:46.08,Default,,0,0,0,,Менің қожайынымды талғампаздықтан алшақ станокпен көздеуге қалай дәтің бар?
Dialogue: 0,0:03:46.08,0:03:49.08,Default,,0,0,0,,Бұл мүлдем күлкілі әзіл.
Dialogue: 0,0:03:49.08,0:03:52.74,Default,,0,0,0,,Ең болмаса лайықты темір сынық бол.
Dialogue: 0,0:03:52.74,0:03:56.04,Default,,0,0,0,,Наото-саманың көзінен ғайып болыңыз.
Dialogue: 0,0:04:14.76,0:04:18.06,Default,,0,0,0,,Күткеніңізге рахмет, Наото-сама.
Dialogue: 0,0:04:24.57,0:04:27.57,Default,,0,0,0,,Лью мырзаның «Елеулі Льюі»!
Dialogue: 0,0:04:27.57,0:04:31.16,Default,,0,0,0,,Наото-саманың қадір-қасиеті мен білімі нашар екені белгілі.
Dialogue: 0,0:04:31.16,0:04:34.16,Default,,0,0,0,,Бұл өте дөрекі сөздер.
Dialogue: 0,0:04:52.10,0:05:31.10,Default,,0,0,0,,♬～
Dialogue: 0,0:07:50.08,0:07:55.08,Default,,0,0,0,,(ызылдаған)
Dialogue: 0,0:08:03.07,0:08:05.07,Default,,0,0,0,,Дәл қазір~
Dialogue: 0,0:08:05.07,0:08:08.41,Default,,0,0,0,,Сіз жалғыз болдыңыз ба? барлығы!
Dialogue: 0,0:08:08.41,0:08:10.41,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:08:10.41,0:08:15.08,Default,,0,0,0,,Сағатты да жөндей алмаймын, керексіз болып қалдым
Dialogue: 0,0:08:15.08,0:08:17.89,Default,,0,0,0,,О, өтінемін, мені кешіріңіз.
Dialogue: 0,0:08:17.89,0:08:20.09,Default,,0,0,0,,Бірақ маған сеніңіз.
Dialogue: 0,0:08:20.09,0:08:24.24,Default,,0,0,0,,Менің сендерге деген махаббатым шынайы!
Dialogue: 0,0:08:24.24,0:08:27.13,Default,,0,0,0,,Заттарды міндетті түрде жөндей алатын инженер бол...
Dialogue: 0,0:08:27.13,0:08:29.13,Default,,0,0,0,,Ах
Dialogue: 0,0:08:31.08,0:08:36.08,Default,,0,0,0,,Кешіріңіз, сіздің таңдау құқығыңыз бар, солай ма?
Dialogue: 0,0:08:37.59,0:08:39.76,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:08:39.76,0:08:43.36,Default,,0,0,0,,Сағат механизмінің соңғы автоматтары
Dialogue: 0,0:08:44.41,0:08:47.51,Default,,0,0,0,,Мен бір күні өзім жасағым келеді
Dialogue: 0,0:08:48.58,0:08:51.65,Default,,0,0,0,,А, Құдай әділетсіз.
Dialogue: 0,0:08:51.65,0:08:56.09,Default,,0,0,0,,Автомат немесе талант? Тым болмаса маған беріліс беріңізші.
Dialogue: 0,0:08:56.09,0:08:59.59,Default,,0,0,0,,Иә? Қатты жаңбыр жауды ма?
Dialogue: 0,0:09:01.41,0:09:03.41,Default,,0,0,0,,Эй, эй, эй...
Dialogue: 0,0:09:03.41,0:09:05.41,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:08.75,0:09:13.74,Default,,0,0,0,,Ах! Менің тәтті ғашықтарым
Dialogue: 0,0:09:13.74,0:09:16.06,Default,,0,0,0,,Сіз не айттыңыз?
Dialogue: 0,0:09:16.06,0:09:19.46,Default,,0,0,0,,Чикушо Бұл не?
Dialogue: 0,0:09:19.46,0:09:21.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:48.43,0:09:57.03,Default,,0,0,0,,Боу?
Dialogue: 0,0:10:02.42,0:10:04.42,Default,,0,0,0,,Бұл әдемі
Dialogue: 0,0:10:05.79,0:10:09.08,Default,,0,0,0,,YD-01 контейнерін түсірдіңіз бе?
Dialogue: 0,0:10:09.08,0:10:11.40,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:10:11.40,0:10:16.07,Default,,0,0,0,,Бұл Breguet отбасылық активі және ұлттық қазына класындағы автомат.
Dialogue: 0,0:10:16.07,0:10:19.67,Default,,0,0,0,,Сайт менеджері дереу жойылады.
Dialogue: 0,0:10:27.08,0:10:31.07,Default,,0,0,0,,Халтер, дереу қалпына келтіру тобын осы жерге жіберіңіз.
Dialogue: 0,0:10:31.07,0:10:34.91,Default,,0,0,0,,Мен мұны әлгі қарғыс атқан ақымақтарға тапсыра алмаймын.
Dialogue: 0,0:10:34.91,0:10:37.76,Default,,0,0,0,,Түсіндім, Мари мырза.
Dialogue: 0,0:10:37.76,0:10:41.75,Default,,0,0,0,,Ханым ретінде өзіңізді соған сай ұстаңыз.
Dialogue: 0,0:10:41.75,0:10:44.25,Default,,0,0,0,,Бөлім/Киотодан Мастер Гилдке дейін
Dialogue: 0,0:10:44.25,0:10:48.09,Default,,0,0,0,,Әсіресе бұл жеңілдік туралы ресми өтініш болғандықтан.
Dialogue: 0,0:10:48.09,0:10:51.06,Default,,0,0,0,,«Бұл қолымнан шығып кетті, сондықтан маған көмектесіңізші».
Dialogue: 0,0:10:51.06,0:10:54.03,Default,,0,0,0,,Бұл жай ғана қиыншылықтар сізді мәжбүрлеу емес.
Dialogue: 0,0:10:54.03,0:10:58.75,Default,,0,0,0,,Дегенмен, біз негізгі тіректің нашар жағдайын елемеуге болмайды.
Dialogue: 0,0:10:58.75,0:11:00.78,Default,,0,0,0,,Асығыңыз
Dialogue: 0,0:11:00.78,0:11:03.58,Default,,0,0,0,,Менің сұрағанымды орында, ханшайым.
Dialogue: 0,0:11:09.42,0:11:13.02,Default,,0,0,0,,Бұл жолы да қызық жұмыс болатын сияқты.
Dialogue: 0,0:11:15.41,0:11:20.10,Default,,0,0,0,,Бұл менің идеалым.
Dialogue: 0,0:11:20.10,0:11:23.10,Default,,0,0,0,,Жоқ, бұл одан да көп.
Dialogue: 0,0:11:26.06,0:11:28.08,Default,,0,0,0,,Неге тағы ұйықтап қалмақсың!
Dialogue: 0,0:11:28.08,0:11:32.08,Default,,0,0,0,,Бұл мен бұрын ешқашан естімеген берілістердің тамаша дыбысы.
Dialogue: 0,0:11:35.23,0:11:38.23,Default,,0,0,0,,Өйткені мен тірі жеп қойылудан шын мәнінде қорқамын
Dialogue: 0,0:11:39.59,0:11:43.07,Default,,0,0,0,,Ол әлсіз, бірақ жағымсыз дыбыстармен араласады.
Dialogue: 0,0:11:43.07,0:11:48.08,Default,,0,0,0,,Орталықтағы беріліс тұрақты болып қалады.
Dialogue: 0,0:11:48.08,0:11:53.00,Default,,0,0,0,,Негізгі серіппе қозғалса да іске қосылмауының себебі осы ма?
Dialogue: 0,0:11:53.00,0:11:55.09,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:55.09,0:12:00.07,Default,,0,0,0,,Шынымды айтсам, ол құлағанша 2-3 сағат қана кетеді.
Dialogue: 0,0:12:00.07,0:12:08.07,Default,,0,0,0,,(беріліс дыбысы)
Dialogue: 0,0:12:10.42,0:12:13.02,Default,,0,0,0,,Не? Ах~!
Dialogue: 0,0:12:17.09,0:12:21.09,Default,,0,0,0,,Бұл таңқаларлық және әдемі.
Dialogue: 0,0:12:22.40,0:12:26.08,Default,,0,0,0,,Сағат түзе алмасам да
Dialogue: 0,0:12:26.08,0:12:30.08,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:12:34.41,0:12:36.41,Default,,0,0,0,,Доктор Конрад
Dialogue: 0,0:12:36.41,0:12:39.75,Default,,0,0,0,,Біраз уақыт болды, профессор Мэри.
Dialogue: 0,0:12:39.75,0:12:43.55,Default,,0,0,0,,Осы жолы бас механик болғаныңызға рахмет.
Dialogue: 0,0:12:44.75,0:12:46.79,Default,,0,0,0,,≪(Халтер) Ол әскери адам.
Dialogue: 0,0:12:46.79,0:12:49.09,Default,,0,0,0,,Сонымен, сіз бірден аумақты алуға келдіңіз.
Dialogue: 0,0:12:49.09,0:12:51.08,Default,,0,0,0,,Профессор Бреге.
Dialogue: 0,0:12:51.08,0:12:54.91,Default,,0,0,0,,Бізге де ынтымақтастықта бар күш-жігерімізді аямау бұйырылды.
Dialogue: 0,0:12:54.91,0:12:57.07,Default,,0,0,0,,Иә, алыңыз.
Dialogue: 0,0:12:57.07,0:13:00.08,Default,,0,0,0,,Біз бұл жерді жақсы білеміз.
Dialogue: 0,0:13:00.08,0:13:04.61,Default,,0,0,0,,Сіз оны сіздің ынтымақтастығыңызсыз түзете аламын деп ойласаңыз да... бұл сіздің қолыңыздан келмейді.
Dialogue: 0,0:13:04.61,0:13:07.08,Default,,0,0,0,,Бізді шақырды.
Dialogue: 0,0:13:07.08,0:13:10.08,Default,,0,0,0,,Өтінемін, алыста тұра аласыз ба, әуесқой?
Dialogue: 0,0:13:26.91,0:13:30.06,Default,,0,0,0,,Бірақ бұл маған ұнамайды.
Dialogue: 0,0:13:30.06,0:13:32.06,Default,,0,0,0,,Мынадай дыбыс
Dialogue: 0,0:13:35.25,0:13:37.25,Default,,0,0,0,,Ах
Dialogue: 0,0:13:50.62,0:13:54.42,Default,,0,0,0,,Жақсы, егер сіз осында аласыз
Dialogue: 0,0:14:22.42,0:14:24.74,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:24.74,0:14:26.84,Default,,0,0,0,,Физика шекараларын да бағындыратын күш—
Dialogue: 0,0:14:28.64,0:14:31.58,Default,,0,0,0,,Аа, менің басым екіге бөлінетін сияқты.
Dialogue: 0,0:14:31.58,0:14:34.58,Default,,0,0,0,,Мен енді қозғала алмаймын
Dialogue: 0,0:14:34.58,0:14:36.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:36.58,0:14:39.68,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:47.49,0:14:49.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:08.06,0:15:13.07,Default,,0,0,0,,Менің атым Льюес, Initial-Y сериясындағы бірінші машина.
Dialogue: 0,0:15:13.07,0:15:15.07,Default,,0,0,0,,Мен Наото Миурамын.
Dialogue: 0,0:15:16.90,0:15:22.08,Default,,0,0,0,,Мені жөндегеніңіз үшін көп рахмет.
Dialogue: 0,0:15:22.08,0:15:26.06,Default,,0,0,0,,Сонда да мен мына ақымақ нәрсені түзетемін.
Dialogue: 0,0:15:26.06,0:15:28.13,Default,,0,0,0,,Мен бұлай ұзақ күтемін деп ойламадым.
Dialogue: 0,0:15:28.13,0:15:30.08,Default,,0,0,0,,Адамның интеллектісі
Dialogue: 0,0:15:30.08,0:15:34.07,Default,,0,0,0,,Сіз әлі де бүргеден өте алмаған сияқтысыз.
Dialogue: 0,0:15:34.07,0:15:36.91,Default,,0,0,0,,Менің қожайын болғандар үшін
Dialogue: 0,0:15:36.91,0:15:38.91,Default,,0,0,0,,Кем дегенде жәндіктерден жақсы
Dialogue: 0,0:15:38.91,0:15:41.71,Default,,0,0,0,,Мен оның тірі зат болғанын қалаймын.
Dialogue: 0,0:15:45.58,0:15:47.59,Default,,0,0,0,,Эххе
Dialogue: 0,0:15:47.59,0:15:51.59,Default,,0,0,0,,Жоқ, бұл бәрібір бас ауруы.
Dialogue: 0,0:17:00.74,0:17:03.39,Default,,0,0,0,,Сіз ояусыз ба?
Dialogue: 0,0:17:03.39,0:17:05.69,Default,,0,0,0,,Наото-сама
Dialogue: 0,0:17:09.93,0:17:12.40,Default,,0,0,0,,Иә!?
Dialogue: 0,0:17:12.40,0:17:15.59,Default,,0,0,0,,Құрметті Наото, сізден сұрайтыным бар.
Dialogue: 0,0:17:15.59,0:17:19.58,Default,,0,0,0,,Иә иә? Менің сызбаларым бар ма?
Dialogue: 0,0:17:19.58,0:17:21.58,Default,,0,0,0,,Жоқ, олай емес...
Dialogue: 0,0:17:21.58,0:17:25.40,Default,,0,0,0,,Сонда мені неше беріліс құрайды?
Dialogue: 0,0:17:25.40,0:17:31.57,Default,,0,0,0,,Құдық, 4 207 68643 дана.
Dialogue: 0,0:17:31.57,0:17:36.24,Default,,0,0,0,,Олай болса, сен мені дыбыстан ғана таныдың, мен жөнделдім.
Dialogue: 0,0:17:36.24,0:17:39.91,Default,,0,0,0,,Кез келген жағдайда, сіз оны жөндеу кезінде де таныдыңыз ба?
Dialogue: 0,0:17:39.91,0:17:43.75,Default,,0,0,0,,Иә, дөрекі болғаным үшін кешіріңіз.
Dialogue: 0,0:17:43.75,0:17:48.05,Default,,0,0,0,,Бірақ шынымен жақсы дыбысты бұзған беріліс болды...
Dialogue: 0,0:17:49.19,0:17:52.58,Default,,0,0,0,,Наото-сама – бұзық.
Dialogue: 0,0:17:52.58,0:17:55.43,Default,,0,0,0,,А, иә, кешіріңіз.
Dialogue: 0,0:17:55.43,0:18:00.63,Default,,0,0,0,,-де мен Наото-саманы қожайын ретінде ресми түрде тіркеймін.
Dialogue: 0,0:18:00.63,0:18:04.07,Default,,0,0,0,,Маған қасыңызда отыруға рұқсат бересіз бе?
Dialogue: 0,0:18:04.07,0:18:07.07,Default,,0,0,0,,Иә? Наото қазір
Dialogue: 0,0:18:07.07,0:18:10.75,Default,,0,0,0,,Мен сізді планетадағы ең жақсы сағат жасаушы деп шештім.
Dialogue: 0,0:18:10.75,0:18:13.58,Default,,0,0,0,,Жоқ, жоқ, жоқ, олай болуы мүмкін емес.
Dialogue: 0,0:18:13.58,0:18:17.08,Default,,0,0,0,,Қандай да бір мәселе бар ма?
Dialogue: 0,0:18:17.08,0:18:19.40,Default,,0,0,0,,Мен тым мінсіз және дарындымын
Dialogue: 0,0:18:19.40,0:18:21.74,Default,,0,0,0,,Наотоның митохондриясындай мақтаныш.
Dialogue: 0,0:18:21.74,0:18:24.09,Default,,0,0,0,,Бұл маған зиян тигізе ме?
Dialogue: 0,0:18:24.09,0:18:26.69,Default,,0,0,0,,Олай емес...
Dialogue: 0,0:18:29.06,0:18:31.25,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:18:31.25,0:18:35.42,Default,,0,0,0,,Маған керек емес, солай ма?
Dialogue: 0,0:18:35.42,0:18:37.41,Default,,0,0,0,,Әй...
Dialogue: 0,0:18:59.41,0:19:02.41,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:19:02.41,0:19:06.08,Default,,0,0,0,,Мен бәрін білмеймін.
Dialogue: 0,0:19:06.08,0:19:11.09,Default,,0,0,0,,Мен кішкентай ғана адаммын, бірақ сіздердің қолдауларыңызды күтемін!
Dialogue: 0,0:19:11.09,0:19:13.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:13.07,0:19:15.57,Default,,0,0,0,,Оң қолыңызды шығарыңыз.
Dialogue: 0,0:19:19.91,0:19:22.58,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:19:22.58,0:19:24.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:42.74,0:19:45.59,Default,,0,0,0,,Бастапқы-Y сериялы бірінші машина
Dialogue: 0,0:19:45.59,0:19:48.58,Default,,0,0,0,,«Ілеспе» Льюес
Dialogue: 0,0:19:48.58,0:19:51.26,Default,,0,0,0,,Наото Миураның гарнирі
Dialogue: 0,0:19:51.26,0:19:56.56,Default,,0,0,0,,Мен абсолютті мойынсұнуға және адалдыққа кепілдік беремін.
Dialogue: 0,0:20:05.41,0:20:09.08,Default,,0,0,0,,Біртүрлі тыныш. Бұл не?
Dialogue: 0,0:20:09.08,0:20:12.57,Default,,0,0,0,,Содан бері әскерилер араласқан жоқ.
Dialogue: 0,0:20:12.57,0:20:14.74,Default,,0,0,0,,Артқы жағы болса ше?
Dialogue: 0,0:20:14.74,0:20:18.59,Default,,0,0,0,,≪(Конрад) Осындай жағдайға мінсіз адам бар➡
Dialogue: 0,0:20:18.59,0:20:21.09,Default,,0,0,0,,Карасава-кун (Карасава) Бұл не?
Dialogue: 0,0:20:21.09,0:20:25.23,Default,,0,0,0,,Мұндағы әскерилер бірдеңе жасырып тұрғанын біле аласыз ба?
Dialogue: 0,0:20:25.23,0:20:29.58,Default,,0,0,0,,Мен бұрынғы жұмыс орнымда осындай қара жұмыс үшін жазаландым.
Dialogue: 0,0:20:29.58,0:20:31.57,Default,,0,0,0,,Мен сенен бір жақсылық сұрай аламын ба?
Dialogue: 0,0:20:31.57,0:20:36.07,Default,,0,0,0,,Профессор Маридің өтінішінен бас тарта алмаймын.
Dialogue: 0,0:20:37.66,0:20:41.56,Default,,0,0,0,,Көмегің үшін рахмет. Маған жүктерімді әкелуіңіз керек.
Dialogue: 0,0:20:41.56,0:20:44.06,Default,,0,0,0,,Мен бұзылып кете жаздадым.
Dialogue: 0,0:20:44.06,0:20:47.08,Default,,0,0,0,,Бірақ кешіріңіз, қауіпті жерге баруға рұқсат етіңіз.
Dialogue: 0,0:20:47.08,0:20:50.39,Default,,0,0,0,,Наото-самадан айырмашылығы, ол кедей және осал.
Dialogue: 0,0:20:50.39,0:20:54.09,Default,,0,0,0,,Қабілетті, жан-жақты маған қандай қауіп бар?
Dialogue: 0,0:20:54.09,0:20:58.25,Default,,0,0,0,,Мен аздап қызық болдым, бірақ бұл зиянды тіл ерекшелік пе?
Dialogue: 0,0:20:58.25,0:21:01.12,Default,,0,0,0,,Улы тіл? мен?
Dialogue: 0,0:21:01.12,0:21:03.25,Default,,0,0,0,,Мен мұны түсінбеймін.
Dialogue: 0,0:21:03.25,0:21:06.09,Default,,0,0,0,,Айтпақшы, Наото-сама
Dialogue: 0,0:21:06.09,0:21:09.59,Default,,0,0,0,,Бүгін түнде сонда қалғың келе ме?
Dialogue: 0,0:21:09.59,0:21:11.59,Default,,0,0,0,,Не?!
Dialogue: 0,0:21:12.59,0:21:14.73,Default,,0,0,0,,Бұл махаббат қонақ үйі!
Dialogue: 0,0:21:14.73,0:21:17.82,Default,,0,0,0,,Иә, ең орынды және
Dialogue: 0,0:21:17.82,0:21:20.75,Default,,0,0,0,,Жақсы жабдықталған тұрғын үй.
Dialogue: 0,0:21:20.75,0:21:23.40,Default,,0,0,0,,Бірақ... тағы да Наото-сама.
Dialogue: 0,0:21:23.40,0:21:27.09,Default,,0,0,0,,Мен өзімді қаншалықты ерекше адам сезінсем де,
Dialogue: 0,0:21:27.09,0:21:31.08,Default,,0,0,0,,Барлық нәрсені қабылдау қызметшінің міндеті.
Dialogue: 0,0:21:31.08,0:21:35.17,Default,,0,0,0,,Сіз қалай ойлайсыз? Мен: Қабылдамау, бас тарту, бас тарту!
Dialogue: 0,0:21:35.17,0:21:38.57,Default,,0,0,0,,Қалай болғанда да, мен бүгін кешке манга кафесіне барамын...
Dialogue: 0,0:21:38.57,0:21:41.76,Default,,0,0,0,,Әй, ол шынымен әдемі емес пе?
Dialogue: 0,0:21:41.76,0:21:44.11,Default,,0,0,0,,Иә, білемін
Dialogue: 0,0:21:44.11,0:21:47.70,Default,,0,0,0,,Керемет~ Менімен қыдырғың келе ме?
Dialogue: 0,0:21:47.70,0:21:50.30,Default,,0,0,0,,Сіз не қаласаңыз, онда бәрі жақсы.
Dialogue: 0,0:21:52.92,0:21:54.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:54.94,0:21:58.59,Default,,0,0,0,,≪(A) Сіз не істеп жатырсыз? Ах!
Dialogue: 0,0:21:58.59,0:22:02.39,Default,,0,0,0,,Жоқ, сен сияқтылар қол тигізетіндей адамдар емес!
Dialogue: 0,0:22:03.41,0:22:06.41,Default,,0,0,0,,Не деген сұмдық бала! (B) Мен өлуім керек пе?
Dialogue: 0,0:22:06.41,0:22:09.01,Default,,0,0,0,,Сен бейбақ, Льюес, қаш.
Dialogue: 0,0:22:11.40,0:22:14.59,Default,,0,0,0,,Сіз мені бірінші рет Лейз деп атадыңыз.
Dialogue: 0,0:22:14.59,0:22:17.59,Default,,0,0,0,,Иә? Наото-саманы тану
Dialogue: 0,0:22:17.59,0:22:21.09,Default,,0,0,0,,Мен оны жоғары деңгейге өзгертемін.
Dialogue: 0,0:22:23.41,0:22:25.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:25.42,0:22:28.09,Default,,0,0,0,,Мен сәл артық кеттім бе?
Dialogue: 0,0:22:28.09,0:22:30.74,Default,,0,0,0,,Наото-самаға деген көзқарас
Dialogue: 0,0:22:30.74,0:22:35.04,Default,,0,0,0,,Бұл жәндіктер үшін өте қолайлы жер емес еді.
Dialogue: 0,0:22:36.73,0:22:39.56,Default,,0,0,0,,Хааа~
Dialogue: 0,0:22:39.56,0:22:42.98,Default,,0,0,0,,Көремін, махаббат қонақүйіндегі кең төсектен.
Dialogue: 0,0:22:42.98,0:22:46.07,Default,,0,0,0,,Тар парақ арқылы бір-бірімен тығыз байланыста болу амалы болды ма?
Dialogue: 0,0:22:46.07,0:22:49.41,Default,,0,0,0,,Жоқ, бұл жалғыз ашық жер болды.
Dialogue: 0,0:22:49.41,0:22:52.79,Default,,0,0,0,,Әйтеуір, мен шаршадым~
Dialogue: 0,0:22:52.79,0:22:57.39,Default,,0,0,0,,Льюдің де демалыс күні бар. Бүгін барлығы үшін рахмет.
Dialogue: 0,0:23:01.64,0:23:04.09,Default,,0,0,0,,Ол еленбейді ме? Иә?
Dialogue: 0,0:23:04.09,0:23:06.74,Default,,0,0,0,,Сіз менің тізе жастығымды елемейсіз бе?
Dialogue: 0,0:23:06.74,0:23:09.93,Default,,0,0,0,,Е, жоқ, бірақ... жарайды ма?
Dialogue: 0,0:23:09.93,0:23:12.91,Default,,0,0,0,,Бұрынғы орындықтағы тізе жастығына көңіліңіз толмаса да...
Dialogue: 0,0:23:12.91,0:23:15.71,Default,,0,0,0,,Ештеңе болмады.
Dialogue: 0,0:23:18.07,0:23:20.09,Default,,0,0,0,,Құрметті Наото
Dialogue: 0,0:23:20.09,0:23:22.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:22.16,0:23:24.59,Default,,0,0,0,,Мен автоматпын
Dialogue: 0,0:23:24.59,0:23:27.44,Default,,0,0,0,,Сағаттық қуыршақ
Dialogue: 0,0:23:27.44,0:23:30.91,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:23:30.91,0:23:33.08,Default,,0,0,0,,Неліктен мен?
Dialogue: 0,0:23:33.08,0:23:36.58,Default,,0,0,0,,Сіз маған адам әйелдей қарайсыз ба?
Dialogue: 0,0:23:37.59,0:23:39.89,Default,,0,0,0,,(Ұйқыда)
Dialogue: 0,0:23:42.58,0:23:48.58,Default,,0,0,0,,Наото-сама мен туралы не ойлайды екен.
Dialogue: 0,0:23:59.08,0:24:01.08,Default,,0,0,0,,(шу)
Dialogue: 0,0:24:04.75,0:24:07.05,Default,,0,0,0,,Шулы
Dialogue: 0,0:24:11.57,0:24:15.01,Default,,0,0,0,,Не, ханшайым, қорқынышты түс көрдіңіз бе?
Dialogue: 0,0:24:15.01,0:24:16.91,Default,,0,0,0,,Сізді өлтіргіңіз келе ме?
Dialogue: 0,0:24:16.91,0:24:19.08,Default,,0,0,0,,Қазір топ басшыларын жинаңыз.
Dialogue: 0,0:24:19.08,0:24:23.07,Default,,0,0,0,,Жарайды, о, бұған дейін... Не?
Dialogue: 0,0:24:23.07,0:24:25.67,Default,,0,0,0,,≪(Халтер) Кем дегенде мүмкіндігінше төмен түсіңіз.
Dialogue: 0,0:24:27.15,0:24:29.65,Default,,0,0,0,,Ах!
Dialogue: 0,0:24:31.08,0:24:33.08,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:24:35.08,0:24:38.10,Default,,0,0,0,,Бұрын ауырлық күшінің аномалиясы болған.
Dialogue: 0,0:24:38.10,0:24:40.18,Default,,0,0,0,,Жақсы байқалды.
Dialogue: 0,0:24:40.18,0:24:43.57,Default,,0,0,0,,Бұл сіздің денеңізде сезілетін дірілдей күшті емес шығар.
Dialogue: 0,0:24:43.57,0:24:47.07,Default,,0,0,0,,Алайда, егер ол болашақта жалғасатын болса
Dialogue: 0,0:24:47.07,0:24:51.08,Default,,0,0,0,,Ең нашар жағдайда, бүкіл аудан/Киото күйреуі мүмкін.
Dialogue: 0,0:24:51.08,0:24:53.75,Default,,0,0,0,,Уақыт жоқ
Dialogue: 0,0:24:53.75,0:24:56.58,Default,,0,0,0,,Себеп дереу анықталмаса
Dialogue: 0,0:24:56.58,0:25:00.49,Default,,0,0,0,,Әскерилер басқа жолды таңдаған сияқты.
Dialogue: 0,0:25:00.49,0:25:04.14,Default,,0,0,0,,≪(Конрад) Карасава-кун, мен алған ақпарат бойынша
Dialogue: 0,0:25:04.14,0:25:07.09,Default,,0,0,0,,Ол алдағы бірнеше күнде орындалады.
Dialogue: 0,0:25:07.09,0:25:09.09,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:25:10.08,0:25:13.08,Default,,0,0,0,,≪ Секцияны мәжбүрлі тазарту/Киото
Dialogue: 0,0:25:13.08,0:25:17.05,Default,,0,0,0,,Мүмкін емес. Сонда азаматтар дер кезінде көшіп кете алмас еді.
Dialogue: 0,0:25:17.05,0:25:20.59,Default,,0,0,0,,Мен мұны біле тұра айтқым келеді.
Dialogue: 0,0:25:20.59,0:25:26.09,Default,,0,0,0,,Олар Киотоны 20 миллион халқымен бірге суға батыруды жоспарлап отыр ма?
Dialogue: 0,0:25:52.16,0:26:17.46,Default,,0,0,0,,♬～
Dialogue: 0,0:26:18.96,0:26:24.96,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory