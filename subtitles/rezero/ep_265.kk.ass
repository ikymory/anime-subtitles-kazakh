Dialogue: 0,0:30:35.51,0:30:36.94,Default,,0,0,0,,Жоқ, өмірден үміт үзбе
Dialogue: 0,0:30:37.24,0:30:38.32,Default,,0,0,0,,Бұл шексіз тұйық
Dialogue: 0,0:30:38.64,0:30:40.63,Default,,0,0,0,,Сені күйрететін бұл қайғы
Dialogue: 0,0:30:40.63,0:30:42.17,Default,,0,0,0,,Сондықтан мен сізге үзіліс беремін.
Dialogue: 0,0:30:43.01,0:30:44.69,Default,,0,0,0,,Бір күні аяқталсын
Dialogue: 0,0:30:45.01,0:30:46.88,Default,,0,0,0,,Қазірше сау бол,
Dialogue: 0,0:30:46.97,0:30:48.47,Default,,0,0,0,,Біз өлерміз
Dialogue: 0,0:30:48.47,0:30:51.83,Default,,0,0,0,,Жаңа күнді күтіп
Dialogue: 0,0:30:52.33,0:30:55.14,Default,,0,0,0,,Ешқашан қайталанбасын
Dialogue: 0,0:31:07.05,0:31:09.94,Default,,0,0,0,,Және біз бастаймыз
