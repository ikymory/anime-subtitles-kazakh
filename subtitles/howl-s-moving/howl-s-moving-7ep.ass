Dialogue: 0,2:22:38.07,2:22:48.07,Default,,0000,0000,0000,,Сен
Dialogue: 0,2:22:50.20,2:22:53.20,Default,,0000,0000,0000,,<Келесі аптаны күте алмаймын...>
Dialogue: 0,2:22:55.74,2:22:58.28,Default,,0000,0000,0000,,＜Жазғы демалыста сүйкімді елес Тоторо тұратын әлемге барыңыз →
Dialogue: 0,2:22:58.28,2:23:00.13,Default,,0000,0000,0000,,Біз сізге жол көрсетеміз＞
Dialogue: 0,2:23:00.13,2:23:04.13,Default,,0000,0000,0000,,<Ультра жоғары сапада бірінші трансляция, оны асыға күтіңіз! ＞
Dialogue: 0,2:23:05.18,2:23:07.18,Default,,0000,0000,0000,,<Осында...>
Dialogue: 0,2:23:08.04,2:23:10.04,Default,,0000,0000,0000,,<Фильмнің түпнұсқа кітабы...>
Dialogue: 0,2:23:16.12,2:23:18.12,Default,,0000,0000,0000,,<Ұялы телефоныңыздан өтініш беріңіз>
