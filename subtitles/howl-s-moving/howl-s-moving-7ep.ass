Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:04:25.73,0:04:45.93,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:45.93,0:04:58.90,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:58.90,0:05:03.78,Default,,0000,0000,0000,,～ （）
Dialogue: 0,0:05:03.78,0:05:19.10,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:05:19.10,0:05:21.96,Default,,0000,0000,0000,,Софи.
Dialogue: 0,0:05:21.96,0:05:25.16,Default,,0000,0000,0000,,Дүкен жабылды. Софидің де барғанын қалаймын.
Dialogue: 0,0:05:25.16,0:05:29.86,Default,,0000,0000,0000,,Мен мұны аяқтаймын. Ләззат алыңыз.
Dialogue: 0,0:05:29.86,0:05:31.89,Default,,0000,0000,0000,,Онда мен барамын.
Dialogue: 0,0:05:31.89,0:05:33.91,Default,,0000,0000,0000,,Кеттік. О, күт!
Dialogue: 0,0:05:33.91,0:05:36.11,Default,,0000,0000,0000,,Бұл біртүрлі емес пе? Эй, қара! Хаул сарайы келе жатыр.
Dialogue: 0,0:05:36.11,0:05:38.79,Default,,0000,0000,0000,,Иә!? Айқай! Қай жерде?
Dialogue: 0,0:05:38.79,0:05:40.98,Default,,0000,0000,0000,,Қараңызшы, бұл өте жақын!
Dialogue: 0,0:05:40.98,0:05:44.98,Default,,0000,0000,0000,,...
Dialogue: 0,0:05:51.93,0:05:53.77,Default,,0000,0000,0000,,...
Dialogue: 0,0:05:53.77,0:05:56.80,Default,,0000,0000,0000,,...
Dialogue: 0,0:05:56.80,0:05:59.00,Default,,0000,0000,0000,,→
Dialogue: 0,0:05:59.00,0:06:01.02,Default,,0000,0000,0000,,Мен Хаулдың жүрегімді басып алғанын естідім.
Dialogue: 0,0:06:01.02,0:06:04.88,Default,,0000,0000,0000,,Бұл қорқынышты. Уайымдамаңыз, сізді нысанаға алмайды.
Dialogue: 0,0:06:04.88,0:06:06.07,Default,,0000,0000,0000,,Ой… Бұл сәл ағаттық болды.
Dialogue: 0,0:06:06.07,0:06:09.60,Default,,0000,0000,0000,,Асығыңыз!
Dialogue: 0,0:06:09.60,0:06:13.98,Default,,0000,0000,0000,,～    …
Dialogue: 0,0:06:13.98,0:06:15.98,Default,,0000,0000,0000,,(есік жабылған дыбыс)
Dialogue: 0,0:06:18.86,0:06:22.86,Default,,0000,0000,0000,,(Пойыз ысқырығы)
Dialogue: 0,0:06:34.02,0:06:37.02,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:07:17.95,0:07:19.95,Default,,0000,0000,0000,,(Шығу қоңырауының дыбысы)
Dialogue: 0,0:07:30.24,0:07:35.97,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:07:35.97,0:07:41.85,Default,,0000,0000,0000,,～
Dialogue: 0,0:07:41.85,0:07:55.99,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:07:55.99,0:08:03.99,Default,,0000,0000,0000,,～ （）
Dialogue: 0,0:08:13.85,0:08:17.88,Default,,0000,0000,0000,,Эй, бірдеңе іздеп жүрсің бе? Бала тышқан.
Dialogue: 0,0:08:17.88,0:08:19.07,Default,,0000,0000,0000,,Жоқ, у... уайымдама.
Dialogue: 0,0:08:19.07,0:08:23.94,Default,,0000,0000,0000,,Шай ішуге ше? Сізден маған қосылуыңызды сұрай аламын ба?
Dialogue: 0,0:08:23.94,0:08:27.81,Default,,0000,0000,0000,,Бұл жақсы. Менің бір ісім бар. Ол шынымен тышқанның баласы.
Dialogue: 0,0:08:27.81,0:08:30.34,Default,,0000,0000,0000,,Эй, сен нешедесің? Осы қаладан?
Dialogue: 0,0:08:30.34,0:08:32.86,Default,,0000,0000,0000,,Өтінемін!
Dialogue: 0,0:08:32.86,0:08:35.89,Default,,0000,0000,0000,,Қарашы, бұл сенің сақалды жүзің.
Dialogue: 0,0:08:35.89,0:08:37.75,Default,,0000,0000,0000,,Ол ашуланғанда да сүйкімді емес пе?
Dialogue: 0,0:08:37.75,0:08:41.96,Default,,0000,0000,0000,,Эй, кешір, кешір, мен сені іздедім.
Dialogue: 0,0:08:41.96,0:08:44.98,Default,,0000,0000,0000,,Не? Сіз? Мына қыздың серігі.
Dialogue: 0,0:08:44.98,0:08:48.02,Default,,0000,0000,0000,,Балалар, серуендеуге келіңдер ме?
Dialogue: 0,0:08:48.02,0:08:49.03,Default,,0000,0000,0000,,Иә? Ах!
Dialogue: 0,0:08:49.03,0:08:52.56,Default,,0000,0000,0000,,Сәлем! Не? иә?
Dialogue: 0,0:08:52.56,0:08:54.92,Default,,0000,0000,0000,,Күте тұрыңыз... не? Бұл не болып жатыр!?
Dialogue: 0,0:08:54.92,0:08:58.79,Default,,0000,0000,0000,,Мені кешіріңіз. Олар ақ жүректі адамдар.
Dialogue: 0,0:08:58.79,0:09:02.00,Default,,0000,0000,0000,,Қай жолмен? Мен оны сізге жіберемін.
Dialogue: 0,0:09:02.00,0:09:05.86,Default,,0000,0000,0000,,Жоқ, мен тек Сезаридің дүкеніне бара жатырмын.
Dialogue: 0,0:09:05.86,0:09:07.05,Default,,0000,0000,0000,,Білмейтіндей әрекет ет... Мені қуып жатыр.
Dialogue: 0,0:09:07.05,0:09:09.06,Default,,0000,0000,0000,,Жаяу жүру.
Dialogue: 0,0:09:09.06,0:09:18.99,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:09:18.99,0:09:30.10,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:09:30.10,0:09:31.79,Default,,0000,0000,0000,,Кешіріңіз...Мен сізді қатыстырдым.
Dialogue: 0,0:09:31.79,0:09:33.14,Default,,0000,0000,0000,,～
Dialogue: 0,0:09:33.14,0:09:36.67,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:09:36.67,0:09:37.01,Default,,0000,0000,0000,,～
Dialogue: 0,0:09:37.01,0:09:45.09,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:09:45.09,0:09:46.10,Default,,0000,0000,0000,,～
Dialogue: 0,0:09:46.10,0:09:51.82,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:09:51.82,0:09:54.85,Default,,0000,0000,0000,,～
Dialogue: 0,0:09:54.85,0:09:59.23,Default,,0000,0000,0000,,～ … …
Dialogue: 0,0:09:59.23,0:10:02.76,Default,,0000,0000,0000,,～
Dialogue: 0,0:10:02.76,0:10:16.91,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:10:16.91,0:10:18.93,Default,,0000,0000,0000,,～
Dialogue: 0,0:10:18.93,0:10:33.91,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:10:33.91,0:10:35.93,Default,,0000,0000,0000,,Мен оларды тартамын.
Dialogue: 0,0:10:35.93,0:10:37.78,Default,,0000,0000,0000,,Кетпес бұрын сәл күтіңіз.
Dialogue: 0,0:10:37.78,0:10:39.97,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:10:39.97,0:10:41.99,Default,,0000,0000,0000,,Жақсы.
Dialogue: 0,0:10:41.99,0:10:49.99,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:10:53.94,0:10:55.13,Default,,0000,0000,0000,,Рахмет. Летти шоколады ше?
Dialogue: 0,0:10:55.13,0:10:57.81,Default,,0000,0000,0000,,Мен де соны қалаймын. Мына жаққа қара!
Dialogue: 0,0:10:57.81,0:11:00.81,Default,,0000,0000,0000,,Сатып алған адам ауыстырылсын! Сіздің әпкеңіз!?
Dialogue: 0,0:11:01.02,0:11:04.02,Default,,0000,0000,0000,,Летти, тезірек оралыңыз!
Dialogue: 0,0:11:07.08,0:11:09.43,Default,,0000,0000,0000,,Үлкен әпке!
Dialogue: 0,0:11:09.43,0:11:11.78,Default,,0000,0000,0000,,Летти. Не болды!?
Dialogue: 0,0:11:11.78,0:11:13.81,Default,,0000,0000,0000,,Балконға түскенде періштеге айналдың ба?
Dialogue: 0,0:11:13.81,0:11:16.84,Default,,0000,0000,0000,,Мен өзімді түс көріп жатқандай сезінемін...
Dialogue: 0,0:11:16.84,0:11:19.03,Default,,0000,0000,0000,,Летти, кеңсені пайдалан.
Dialogue: 0,0:11:19.03,0:11:22.03,Default,,0000,0000,0000,,Бірақ мен жұмыстамын... Рахмет.
Dialogue: 0,0:11:23.74,0:11:26.77,Default,,0000,0000,0000,,Ех! Бұл сиқыршы емес пе?
Dialogue: 0,0:11:26.77,0:11:30.47,Default,,0000,0000,0000,,Ол өте жақсы адам еді...
Dialogue: 0,0:11:30.47,0:11:32.83,Default,,0000,0000,0000,,Сіз маған көмектестіңіз.
Dialogue: 0,0:11:32.83,0:11:35.02,Default,,0000,0000,0000,,Бұл сіздің әпкемді қызықтырғаныңызды білдіре ме?
Dialogue: 0,0:11:35.02,0:11:37.88,Default,,0000,0000,0000,,Егер шебер Howl болса→
Dialogue: 0,0:11:37.88,0:11:40.74,Default,,0000,0000,0000,,Әпке, жүрегіңізді жеп жатыр.
Dialogue: 0,0:11:40.74,0:11:43.94,Default,,0000,0000,0000,,Жарайды. Howl тек әдемі әйелдерді нысанаға алады.
Dialogue: 0,0:11:43.94,0:11:45.96,Default,,0000,0000,0000,,Тағы да солай...
Dialogue: 0,0:11:45.96,0:11:48.99,Default,,0000,0000,0000,,Көрдің бе, дүниеде қиыншылық көп.
Dialogue: 0,0:11:48.99,0:11:52.99,Default,,0000,0000,0000,,Тіпті даланың бақсысы да кезіп жүр дейді.
Dialogue: 0,0:11:53.87,0:11:55.90,Default,,0000,0000,0000,,Үлкен әпке? иә?
Dialogue: 0,0:11:55.90,0:11:57.90,Default,,0000,0000,0000,,Бұл жәндік емес.
Dialogue: 0,0:12:00.94,0:12:02.80,Default,,0000,0000,0000,,Летти Мадлен тұрды.
Dialogue: 0,0:12:02.80,0:12:06.80,Default,,0000,0000,0000,,Иә, сәл күте тұрыңыз. Жақсы.
Dialogue: 0,0:12:07.85,0:12:10.04,Default,,0000,0000,0000,,Мен үйге бара жатырмын.
Dialogue: 0,0:12:10.04,0:12:12.04,Default,,0000,0000,0000,,Леттидің жайдары жүзін көргенде жеңілдеп қалдым.
Dialogue: 0,0:12:14.74,0:12:16.94,Default,,0000,0000,0000,,Сәлем Летти. Ерен еңбегіңіз үшін рахмет.
Dialogue: 0,0:12:16.94,0:12:21.98,Default,,0000,0000,0000,,Әй, әпке, сіз шынымен де өміріңіздің соңына дейін сол дүкенде қалуды жоспарлап отырсыз ба?
Dialogue: 0,0:12:21.98,0:12:25.86,Default,,0000,0000,0000,,Бұл әкемнің сүйікті дүкені еді, мен үлкен қызымын, сондықтан...
Dialogue: 0,0:12:25.86,0:12:29.06,Default,,0000,0000,0000,,Жоқ! Сіз шынымен қалпақшы болғыңыз келе ме?
Dialogue: 0,0:12:29.06,0:12:31.08,Default,,0000,0000,0000,,Ал...
Dialogue: 0,0:12:31.08,0:12:33.43,Default,,0000,0000,0000,,Летти жақында кездескенше.
Dialogue: 0,0:12:33.43,0:12:35.79,Default,,0000,0000,0000,,Келесі жолы дүкенге келіңіз. аа.
Dialogue: 0,0:12:35.79,0:12:37.98,Default,,0000,0000,0000,,Мен барамын. Әпке, өзіңіз туралы →
Dialogue: 0,0:12:37.98,0:12:40.98,Default,,0000,0000,0000,,Өзіңіз шешуіңіз керек! Иә.
Dialogue: 0,0:12:55.66,0:12:57.66,Default,,0000,0000,0000,,(төбеге соғылған таяқтың дыбысы)
Dialogue: 0,0:13:04.08,0:13:20.08,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:13:41.62,0:13:44.62,Default,,0000,0000,0000,,(есік қоңырауының дыбысы)
Dialogue: 0,0:13:47.01,0:13:50.04,Default,,0000,0000,0000,,Мм... дүкен жабық.
Dialogue: 0,0:13:50.04,0:13:53.04,Default,,0000,0000,0000,,Кешіріңіз, мен есікті құлыптап алдым деп ойладым, бірақ...
Dialogue: 0,0:13:55.09,0:14:00.98,Default,,0000,0000,0000,,Арзан дүкен Арзан қалпақ.
Dialogue: 0,0:14:00.98,0:14:05.85,Default,,0000,0000,0000,,Сіз де арзансыз.
Dialogue: 0,0:14:05.85,0:14:08.85,Default,,0000,0000,0000,,Бұл қала орталығындағы қарапайым аудандағы қалпақ дүкені.
Dialogue: 0,0:14:13.94,0:14:16.97,Default,,0000,0000,0000,,Оны қайтарыңыз.
Dialogue: 0,0:14:16.97,0:14:21.02,Default,,0000,0000,0000,,Сізде Қалдықтардың ведьмасымен бәсекелесуге жүйкеңіз жетеді.
Dialogue: 0,0:14:21.02,0:14:24.88,Default,,0000,0000,0000,,Шөлдің бақсысы... Ах!
Dialogue: 0,0:14:24.88,0:14:30.94,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:14:30.94,0:14:34.14,Default,,0000,0000,0000,,Ол қарғыс туралы ешкімге айта алмайсың.
Dialogue: 0,0:14:34.14,0:14:38.14,Default,,0000,0000,0000,,Howl-ге сәлем айтыңыз Хэхехе...
Dialogue: 0,0:14:48.29,0:14:50.29,Default,,0000,0000,0000,,Фалько…
Dialogue: 0,0:15:03.94,0:15:05.79,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:15:05.79,0:15:09.79,Default,,0000,0000,0000,,А... аа....
Dialogue: 0,0:15:22.96,0:15:24.98,Default,,0000,0000,0000,,Бұл шынымен мен бе!?
Dialogue: 0,0:15:24.98,0:15:27.98,Default,,0000,0000,0000,,Мен тынышталуым керек...
Dialogue: 0,0:15:41.82,0:15:43.84,Default,,0000,0000,0000,,Хмм...!!
Dialogue: 0,0:15:43.84,0:15:45.02,Default,,0000,0000,0000,,Сабырлану керек...!
Dialogue: 0,0:15:45.02,0:15:50.07,Default,,0000,0000,0000,,Дүрбелең болғаның жаман, Софи...
Dialogue: 0,0:15:50.07,0:15:53.94,Default,,0000,0000,0000,,Ештеңе Ештеңе.
Dialogue: 0,0:15:53.94,0:15:59.94,Default,,0000,0000,0000,,Тыныштауым керек... Тыныштауым керек...
Dialogue: 0,0:18:33.03,0:18:35.03,Default,,0000,0000,0000,,(Пойыз ысқырығы)
Dialogue: 0,0:18:40.77,0:18:42.96,Default,,0000,0000,0000,,Мен үйдемін!
Dialogue: 0,0:18:42.96,0:18:44.82,Default,,0000,0000,0000,,Үйге қош келдіңіз, ханым! (Жаным) Қалай ойлайсың? Бұл→
Dialogue: 0,0:18:44.82,0:18:47.01,Default,,0000,0000,0000,,Ол Кингсбериде танымал бола бастады.
Dialogue: 0,0:18:47.01,0:18:49.86,Default,,0000,0000,0000,,Керемет! Сізге жарасады!
Dialogue: 0,0:18:49.86,0:18:52.05,Default,,0000,0000,0000,,Бұл сөзсіз жұмыс істейді деп ойламайсыз ба?
Dialogue: 0,0:18:52.05,0:18:54.91,Default,,0000,0000,0000,,Софи! Софи! кінә?
Dialogue: 0,0:18:54.91,0:18:57.27,Default,,0000,0000,0000,,...
Dialogue: 0,0:18:57.27,0:19:00.27,Default,,0000,0000,0000,,Қызық, не болды?
Dialogue: 0,0:19:01.99,0:19:03.99,Default,,0000,0000,0000,,Софи!
Dialogue: 0,0:19:05.02,0:19:07.87,Default,,0000,0000,0000,,...
Dialogue: 0,0:19:07.87,0:19:08.89,Default,,0000,0000,0000,,
Dialogue: 0,0:19:08.89,0:19:10.90,Default,,0000,0000,0000,,...
Dialogue: 0,0:19:10.90,0:19:17.30,Default,,0000,0000,0000,,Оны ашпаңыз. Бұл өте қатты суық. Егер сіз оны ұстап алсаңыз, қиындыққа тап боласыз.
Dialogue: 0,0:19:17.30,0:19:21.01,Default,,0000,0000,0000,,Бұл қорқынышты дауыс. 90 жастағы әжеге ұқсайды.
Dialogue: 0,0:19:21.01,0:19:23.03,Default,,0000,0000,0000,,...
Dialogue: 0,0:19:23.03,0:19:27.03,Default,,0000,0000,0000,,Сонымен? Сонда кездескенше.
Dialogue: 0,0:19:28.92,0:19:31.92,Default,,0000,0000,0000,,Жақсы...
Dialogue: 0,0:19:41.88,0:19:44.08,Default,,0000,0000,0000,,Жарайды, әже.
Dialogue: 0,0:19:44.08,0:19:48.95,Default,,0000,0000,0000,,Деніңіз сау, киіміңіз бұрынғыдан да жарасып тұр.
Dialogue: 0,0:19:48.95,0:19:50.97,Default,,0000,0000,0000,,(Балдың күлкісі)
Dialogue: 0,0:19:50.97,0:19:53.97,Default,,0000,0000,0000,,Бірақ мен мұнда қала алмаймын.
Dialogue: 0,0:20:02.93,0:20:05.12,Default,,0000,0000,0000,,Ауырсыну...
Dialogue: 0,0:20:05.12,0:20:08.15,Default,,0000,0000,0000,,Қарт болу қиын.
Dialogue: 0,0:20:08.15,0:20:17.07,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:20:17.07,0:20:19.59,Default,,0000,0000,0000,,Алдағы соғыс... әлдеқайда үлкен →
Dialogue: 0,0:20:19.59,0:20:21.95,Default,,0000,0000,0000,,～
Dialogue: 0,0:20:21.95,0:20:28.18,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:20:28.18,0:20:30.04,Default,,0000,0000,0000,,～ （）
Dialogue: 0,0:20:30.04,0:20:35.08,Default,,0000,0000,0000,,Әже, қол ұшын созсам болады ма?
Dialogue: 0,0:20:35.08,0:20:39.96,Default,,0000,0000,0000,,Мен сенің жақсылығыңды ғана қабылдаймын, рахмет.
Dialogue: 0,0:20:39.96,0:20:42.32,Default,,0000,0000,0000,,Маған бәрібір, әже, қайда барасыз?
Dialogue: 0,0:20:42.32,0:20:45.85,Default,,0000,0000,0000,,Міне, сіз барасыз.
Dialogue: 0,0:20:45.85,0:20:50.06,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:20:50.06,0:20:52.08,Default,,0000,0000,0000,,Тоқта, әже.
Dialogue: 0,0:20:52.08,0:20:55.11,Default,,0000,0000,0000,,Бұл жерде тек сиқыршылар жүреді.
Dialogue: 0,0:20:55.11,0:20:56.97,Default,,0000,0000,0000,,Рахмет.
Dialogue: 0,0:20:56.97,0:21:00.00,Default,,0000,0000,0000,,Сіз қазір Накаориданиге барасыз ба?
Dialogue: 0,0:21:00.00,0:21:02.86,Default,,0000,0000,0000,,Сенің ең кенже қарындасың бар деп естідім.
Dialogue: 0,0:21:02.86,0:21:08.08,Default,,0000,0000,0000,,～   …
Dialogue: 0,0:21:08.08,0:21:16.16,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:21:16.16,0:21:19.16,Default,,0000,0000,0000,,Ха... Мен әлі көп алған жоқпын.
Dialogue: 0,0:21:20.87,0:21:24.87,Default,,0000,0000,0000,,Менің тістерім бұрынғыдай болғанына қуаныштымын.
Dialogue: 0,0:21:31.48,0:21:34.00,Default,,0000,0000,0000,,Таяқ үшін жақсы көрінеді.
Dialogue: 0,0:21:34.00,0:21:38.00,Default,,0000,0000,0000,,Жақсы... О, ауыртпалық...
Dialogue: 0,0:21:41.92,0:21:44.92,Default,,0000,0000,0000,,Менің ойымша, бұл аздап қалың.
Dialogue: 0,0:21:50.17,0:21:54.04,Default,,0000,0000,0000,,Хмм... Аа, бұл ауырды...
Dialogue: 0,0:21:54.04,0:21:58.04,Default,,0000,0000,0000,,Әй... Не деген қыңыр бұтақ.
Dialogue: 0,0:21:59.09,0:22:02.12,Default,,0000,0000,0000,,Софи әжені кемітпеңіз!
Dialogue: 0,0:22:02.12,0:22:06.12,Default,,0000,0000,0000,,Бұл! Хмм….
Dialogue: 0,0:22:09.03,0:22:11.03,Default,,0000,0000,0000,,Конверт пе?
Dialogue: 0,0:22:14.24,0:22:19.79,Default,,0000,0000,0000,,Қорқыт... Мен бұл тағы да бақсының көмекшісі деп ойладым.
Dialogue: 0,0:22:19.79,0:22:23.79,Default,,0000,0000,0000,,Бірақ сен неге жалғыз тұрсың?
Dialogue: 0,0:22:25.18,0:22:27.03,Default,,0000,0000,0000,,Оның шалқанның басы бар.
Dialogue: 0,0:22:27.03,0:22:30.07,Default,,0000,0000,0000,,Мен кішкентай кезімнен шалқанды жек көретінмін.
Dialogue: 0,0:22:30.07,0:22:33.10,Default,,0000,0000,0000,,Төңкерілгеннен жақсы.
Dialogue: 0,0:22:33.10,0:22:35.10,Default,,0000,0000,0000,,Сау болыңыз.
Dialogue: 0,0:22:42.02,0:22:44.87,Default,,0000,0000,0000,,Уау, суық.
Dialogue: 0,0:22:44.87,0:22:47.90,Default,,0000,0000,0000,,Мұндай қалалар әлі де бар.
Dialogue: 0,0:22:47.90,0:22:49.90,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:22:52.95,0:22:54.81,Default,,0000,0000,0000,,Менің артымнан ерме!
Dialogue: 0,0:22:54.81,0:22:57.00,Default,,0000,0000,0000,,Сізге жақсылықты қайтарудың қажеті жоқ!
Dialogue: 0,0:22:57.00,0:22:59.19,Default,,0000,0000,0000,,Сіз де сиқырлы нәрсесіз, солай емес пе?
Dialogue: 0,0:22:59.19,0:23:02.72,Default,,0000,0000,0000,,Бақсылар мен қарғыстар қаншама!
Dialogue: 0,0:23:02.72,0:23:06.72,Default,,0000,0000,0000,,Өзіңізге ұнайтын жерде тұрыңыз!
Dialogue: 0,0:23:13.00,0:23:20.06,Default,,0000,0000,0000,,Ха ха ха ха….
Dialogue: 0,0:23:20.06,0:23:22.06,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:23:27.63,0:23:30.00,Default,,0000,0000,0000,,Бұл тамаша таяқ, рахмет.
Dialogue: 0,0:23:30.00,0:23:33.03,Default,,0000,0000,0000,,Айтпақшы, маған түнейтін үй әкеліп берсеңіз→
Dialogue: 0,0:23:33.03,0:23:35.03,Default,,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:23:45.65,0:23:48.65,Default,,0000,0000,0000,,Жасы ұлғайған сайын қулығы арта түсетін сияқты.
Dialogue: 0,0:23:59.12,0:24:01.12,Default,,0000,0000,0000,,Үлкен әскери кеме….
Dialogue: 0,0:24:03.16,0:24:06.19,Default,,0000,0000,0000,,Әй, қарттар осылай денелерін қозғалта алмайды дегенге сенбеймін→
Dialogue: 0,0:24:06.19,0:24:08.19,Default,,0000,0000,0000,,Мен олай ойламадым...
Dialogue: 0,0:24:12.92,0:24:17.92,Default,,0000,0000,0000,,А... ха.
Dialogue: 0,0:24:22.02,0:24:29.92,Default,,0000,0000,0000,,Иә? Бұл да түтін иісі аңқып тұрған тау лашығы ма деп ойлаймын...
Dialogue: 0,0:24:29.92,0:24:32.92,Default,,0000,0000,0000,,Қайсысы жақсы?
Dialogue: 0,0:24:42.05,0:24:43.05,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:24:48.11,0:24:51.14,Default,,0000,0000,0000,,Шалқан басы Бұл Хаулдың сарайы емес пе?
Dialogue: 0,0:24:51.14,0:24:56.14,Default,,0000,0000,0000,,Сен... Мен саған мені үйге әкел дедім, бірақ күтпедім...!
Dialogue: 0,0:25:06.12,0:25:10.12,Default,,0000,0000,0000,,Бұл не... құлып па?
Dialogue: 0,0:25:29.02,0:25:32.22,Default,,0000,0000,0000,,Бұл кіреберіс пе?
Dialogue: 0,0:25:32.22,0:25:35.92,Default,,0000,0000,0000,,Ха ха ха сәл күте тұрыңыз!
Dialogue: 0,0:25:35.92,0:25:40.30,Default,,0000,0000,0000,,Ха ха ха... Ах! Бұл біраз...
Dialogue: 0,0:25:40.30,0:25:44.00,Default,,0000,0000,0000,,Маған апарасың ба? Сіз оны міне алмайсыз ба? Қалай болғанда да!
Dialogue: 0,0:25:44.00,0:25:45.00,Default,,0000,0000,0000,,Ай!
Dialogue: 0,0:25:48.04,0:25:50.04,Default,,0000,0000,0000,,Иық сөмкесі...
Dialogue: 0,0:26:02.19,0:26:05.71,Default,,0000,0000,0000,,Шалғам Іші жылы көрінеді →
Dialogue: 0,0:26:05.71,0:26:08.24,Default,,0000,0000,0000,,Мен сені бәрібір кіргіземін, рахмет!
Dialogue: 0,0:26:08.24,0:26:10.10,Default,,0000,0000,0000,,Қанша айқайласа да, бұл әжейдің жүрегі →
Dialogue: 0,0:26:10.10,0:26:12.10,Default,,0000,0000,0000,,Сіз оны жемейсіз.
Dialogue: 0,0:26:14.97,0:26:17.16,Default,,0000,0000,0000,,Бұл жолы қош бол!
Dialogue: 0,0:26:17.16,0:26:21.16,Default,,0000,0000,0000,,Сен шалқансың, бірақ сен жақсы шалқан едің! Бақытты бол!
Dialogue: 0,0:26:52.01,0:26:54.01,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:26:58.92,0:27:02.92,Default,,0000,0000,0000,,Жарайды...
Dialogue: 0,0:27:08.51,0:27:13.51,Default,,0000,0000,0000,,Мен оның не екенін білмеймін, бірақ бұл жай ғана шүберек дүкеніне ұқсайды...
Dialogue: 0,0:27:21.98,0:27:26.98,Default,,0000,0000,0000,,Қартаюдың жақсы жағы – таң қалуды доғарғаныңыз.
Dialogue: 0,0:27:35.95,0:27:37.97,Default,,0000,0000,0000,,Бұл шатастыратын қарғыс.
Dialogue: 0,0:27:37.97,0:27:39.99,Default,,0000,0000,0000,,Фалько…
Dialogue: 0,0:27:39.99,0:27:42.99,Default,,0000,0000,0000,,Бұл қарғыс оңайлықпен бұзылмайды.
Dialogue: 0,0:27:43.03,0:27:45.88,Default,,0000,0000,0000,,Өрт сөйледі.
Dialogue: 0,0:27:45.88,0:27:48.07,Default,,0000,0000,0000,,Не керек, адамдармен сөйлесе алмайсың.
Dialogue: 0,0:27:48.07,0:27:51.10,Default,,0000,0000,0000,,Сіз айқайлайсыз ба? Бұл дұрыс емес.
Dialogue: 0,0:27:51.10,0:27:55.64,Default,,0000,0000,0000,,Мен отты жын Калсифермін! Менің айтайын дегенім осы.
Dialogue: 0,0:27:55.64,0:27:59.02,Default,,0000,0000,0000,,Сонымен, Калсифер, сен маған айтылған қарғысты бұза аласың ба?
Dialogue: 0,0:27:59.02,0:28:01.04,Default,,0000,0000,0000,,Қарапайымдылық.
Dialogue: 0,0:28:01.04,0:28:04.07,Default,,0000,0000,0000,,Мені осында байлаған қарғысты бұза алсаң→
Dialogue: 0,0:28:04.07,0:28:07.10,Default,,0000,0000,0000,,Мен сіздің қарғысыңызды бірден алып тастаймын.
Dialogue: 0,0:28:07.10,0:28:09.95,Default,,0000,0000,0000,,Сіз шайтанмен мәміле жасап жатырсыз.
Dialogue: 0,0:28:09.95,0:28:12.98,Default,,0000,0000,0000,,Маған осылай уәде бере аласыз ба?
Dialogue: 0,0:28:12.98,0:28:16.69,Default,,0000,0000,0000,,Шайтан уәде бермейді.
Dialogue: 0,0:28:16.69,0:28:18.88,Default,,0000,0000,0000,,Сіз екіншісін ұрдыңыз.
Dialogue: 0,0:28:18.88,0:28:21.07,Default,,0000,0000,0000,,Ей, бейшара шайтан!
Dialogue: 0,0:28:21.07,0:28:24.10,Default,,0000,0000,0000,,Мен келісім-шарт бойыншамын және оны осында Хаул пайдаланып жатыр!
Dialogue: 0,0:28:24.10,0:28:27.13,Default,,0000,0000,0000,,Тіпті бұл сарайды да мен басқарады!
Dialogue: 0,0:28:27.13,0:28:31.17,Default,,0000,0000,0000,,Иә, қиын...
Dialogue: 0,0:28:31.17,0:28:34.37,Default,,0000,0000,0000,,Хаул мен Оланың келісім-шартының сырын біле алсаңыз→
Dialogue: 0,0:28:34.37,0:28:38.08,Default,,0000,0000,0000,,Қарғысты бұзуға болады! Сонда мен де сенің қарғыңды бұзамын!
Dialogue: 0,0:28:38.08,0:28:43.08,Default,,0000,0000,0000,,Жарайды... бұл мәміле...
Dialogue: 0,0:28:44.97,0:28:48.17,Default,,0000,0000,0000,,
Dialogue: 0,0:28:48.17,0:28:51.20,Default,,0000,0000,0000,,Әже! Әже!
Dialogue: 0,0:28:51.20,0:28:55.75,Default,,0000,0000,0000,,
Dialogue: 0,0:28:55.75,0:28:58.75,Default,,0000,0000,0000,,Эй, жақсысың ба?
Dialogue: 0,0:32:35.11,0:32:39.15,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:32:39.15,0:32:46.15,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:32:54.97,0:32:56.99,Default,,0000,0000,0000,,
Dialogue: 0,0:32:56.99,0:32:58.18,Default,,0000,0000,0000,,
Dialogue: 0,0:32:58.18,0:33:00.18,Default,,0000,0000,0000,,
Dialogue: 0,0:33:02.05,0:33:07.05,Default,,0000,0000,0000,,
Dialogue: 0,0:33:09.11,0:33:11.11,Default,,0000,0000,0000,,
Dialogue: 0,0:33:12.82,0:33:14.00,Default,,0000,0000,0000,,
Dialogue: 0,0:33:14.00,0:33:17.03,Default,,0000,0000,0000,,(аяқ дыбысы)
Dialogue: 0,0:33:17.03,0:33:19.05,Default,,0000,0000,0000,,
Dialogue: 0,0:33:19.05,0:33:22.08,Default,,0000,0000,0000,,
Dialogue: 0,0:33:22.08,0:33:25.11,Default,,0000,0000,0000,,Иә? Ол кім болуы мүмкін? (Кальцифер) Порт қаласы!
Dialogue: 0,0:33:25.11,0:33:28.11,Default,,0000,0000,0000,,Қашан кірді деп ойлаймын.
Dialogue: 0,0:33:32.84,0:33:34.20,Default,,0000,0000,0000,,
Dialogue: 0,0:33:34.20,0:33:36.20,Default,,0000,0000,0000,,Күтіңіз.
Dialogue: 0,0:33:40.10,0:33:42.28,Default,,0000,0000,0000,,Бұл әкім ме?
Dialogue: 0,0:33:42.28,0:33:46.16,Default,,0000,0000,0000,,Күн толық шықты. Дженкинс мырза үйде ме?
Dialogue: 0,0:33:46.16,0:33:52.88,Default,,0000,0000,0000,,Ұстаз жоқ, мен сізге қамқорлық жасаймын.
Dialogue: 0,0:33:52.88,0:33:56.09,Default,,0000,0000,0000,,Бұл Мәртебелі Корольдің шақыруы. Соғыс уақыты келді.
Dialogue: 0,0:33:56.09,0:33:59.12,Default,,0000,0000,0000,,Сиқыршылар, сиқыршылар, тіпті бақсылар →
Dialogue: 0,0:33:59.12,0:34:02.15,Default,,0000,0000,0000,,Бұл әрбір адамды мемлекетпен ынтымақтастыққа шақыру→
Dialogue: 0,0:34:02.15,0:34:05.01,Default,,0000,0000,0000,,Сотқа міндетті түрде келіңіз.
Dialogue: 0,0:34:05.01,0:34:07.20,Default,,0000,0000,0000,,(есік жабылған дыбыс)
Dialogue: 0,0:34:07.20,0:34:10.23,Default,,0000,0000,0000,,Жоқ, соғыс деген жоқ.
Dialogue: 0,0:34:10.23,0:34:13.59,Default,,0000,0000,0000,,Бұл адам кім?
Dialogue: 0,0:34:13.59,0:34:15.11,Default,,0000,0000,0000,,Кальцифер оны сол жерге қойды.
Dialogue: 0,0:34:15.11,0:34:18.31,Default,,0000,0000,0000,,Бұл мен емес. Жаңа ғана елсіз жерден келдім.
Dialogue: 0,0:34:18.31,0:34:21.34,Default,,0000,0000,0000,,Шөл жерден? Бұл біртүрлі.
Dialogue: 0,0:34:21.34,0:34:24.20,Default,,0000,0000,0000,,Оның бақсы емес екеніне сенімдімін.
Dialogue: 0,0:34:24.20,0:34:27.23,Default,,0000,0000,0000,,Егер сіз бақсы болсаңыз, кіре аласыз! (есік қоңырауы)
Dialogue: 0,0:34:27.23,0:34:29.08,Default,,0000,0000,0000,,Тағы бір порт қаласы!
Dialogue: 0,0:34:29.08,0:34:31.08,Default,,0000,0000,0000,,Сіз тұтынушысыз ба?
Dialogue: 0,0:34:32.45,0:34:34.45,Default,,0000,0000,0000,,Күтіңіз.
Dialogue: 0,0:34:37.16,0:34:39.18,Default,,0000,0000,0000,,Бұл не үшін?
Dialogue: 0,0:34:39.18,0:34:41.20,Default,,0000,0000,0000,,Мен анамның орнына келдім.
Dialogue: 0,0:34:41.20,0:34:43.22,Default,,0000,0000,0000,,Бұл тағы да сол ескі заклинание.
Dialogue: 0,0:34:43.22,0:34:45.24,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:34:45.24,0:34:47.24,Default,,0000,0000,0000,,Тыныш болыңыз.
Dialogue: 0,0:34:52.31,0:34:54.31,Default,,0000,0000,0000,,22 мамыр: Біз Аоямада бір-бірімізге дәптерлерімізді көрсетеміз.
Dialogue: 0,0:35:04.10,0:35:06.12,Default,,0000,0000,0000,,Бұл бос жер емес...
Dialogue: 0,0:35:06.12,0:35:09.32,Default,,0000,0000,0000,,Әже Әже де бақсы ма?
Dialogue: 0,0:35:09.32,0:35:13.19,Default,,0000,0000,0000,,Дұрыс, ол бұл елдегі ең қорқынышты бақсы!
Dialogue: 0,0:35:13.19,0:35:17.23,Default,,0000,0000,0000,,Осы ұнтақты шашсаң, қайықта жақсы жел соғады.
Dialogue: 0,0:35:17.23,0:35:18.23,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:35:20.92,0:35:22.11,Default,,0000,0000,0000,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:35:22.11,0:35:24.13,Default,,0000,0000,0000,,(есік жабылған дыбыс)
Dialogue: 0,0:35:24.13,0:35:26.15,Default,,0000,0000,0000,,Уайымдама, бұл бос сөз.
Dialogue: 0,0:35:26.15,0:35:28.17,Default,,0000,0000,0000,,Бұл бетпердені пайдалануды тоқтату керек.
Dialogue: 0,0:35:28.17,0:35:32.05,Default,,0000,0000,0000,,Бұл бетперде емес! Бұл сиқырлы! (есік қоңырауы)
Dialogue: 0,0:35:32.05,0:35:35.08,Default,,0000,0000,0000,,Кингсбери есігі!
Dialogue: 0,0:35:35.08,0:35:38.08,Default,,0000,0000,0000,,Күтіңіз.
Dialogue: 0,0:35:42.31,0:35:46.18,Default,,0000,0000,0000,,Бұл жерде сиқыршы Мастер Пендрагон тұрады ма?
Dialogue: 0,0:35:46.18,0:35:47.03,Default,,0000,0000,0000,,Шынымен.
Dialogue: 0,0:35:47.03,0:35:50.06,Default,,0000,0000,0000,,Бізге Мәртебелі Корольден шақыру хат келді→
Dialogue: 0,0:35:50.06,0:35:55.28,Default,,0000,0000,0000,,Мастер Пендрагонға сарайға міндетті түрде келуді айтыңыз.
Dialogue: 0,0:35:55.28,0:35:58.64,Default,,0000,0000,0000,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:35:58.64,0:36:00.16,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:36:00.16,0:36:12.28,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:36:12.28,0:36:15.31,Default,,0000,0000,0000,,Патшасы бар қала сияқты.
Dialogue: 0,0:36:15.31,0:36:18.31,Default,,0000,0000,0000,,Артқа тартпасаң, мұрныңнан айырыласың.
Dialogue: 0,0:36:22.38,0:36:25.38,Default,,0000,0000,0000,,Енді қыдырма.
Dialogue: 0,0:36:35.01,0:36:37.02,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:36:37.02,0:36:50.02,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:36:53.18,0:36:57.18,Default,,0000,0000,0000,,Осы қарқынмен астық қорын жинаған дұрыс сияқты.
Dialogue: 0,0:37:01.10,0:37:05.30,Default,,0000,0000,0000,,Уайымдама, мен ашуланамын!
Dialogue: 0,0:37:05.30,0:37:07.50,Default,,0000,0000,0000,,Бұл сиқырлы үй.
Dialogue: 0,0:37:07.50,0:37:10.03,Default,,0000,0000,0000,,Қазірдің өзінде... Мына қара бөлік қайда барады?
Dialogue: 0,0:37:10.03,0:37:12.21,Default,,0000,0000,0000,,Тек Хаул мырза біледі!
Dialogue: 0,0:37:12.21,0:37:15.21,Default,,0000,0000,0000,,Мен таңғы ас ішемін.
Dialogue: 0,0:37:24.33,0:37:27.53,Default,,0000,0000,0000,,Бекон мен жұмыртқа да бар.
Dialogue: 0,0:37:27.53,0:37:31.53,Default,,0000,0000,0000,,Улаусыз отты пайдалана алмаймыз.
Dialogue: 0,0:37:32.08,0:37:36.29,Default,,0000,0000,0000,,Хехехе... Саған жасаймын.
Dialogue: 0,0:37:36.29,0:37:38.14,Default,,0000,0000,0000,,Бұл мүмкін емес! Кальцифер - →
Dialogue: 0,0:37:38.14,0:37:41.33,Default,,0000,0000,0000,,Мен Хаул мырзаның айтқанын ғана тыңдаймын.
Dialogue: 0,0:37:41.33,0:37:44.19,Default,,0000,0000,0000,,Дұрыс, мен тамақ пісірмеймін!
Dialogue: 0,0:37:44.19,0:37:50.92,Default,,0000,0000,0000,,Әй, менің қалпағым келді... Жарайды.
Dialogue: 0,0:37:50.92,0:37:53.12,Default,,0000,0000,0000,,Кел, Калсифер, өтінемін.
Dialogue: 0,0:37:53.12,0:37:59.34,Default,,0000,0000,0000,,Жоқ! Мен шайтанмын, ешкімнен бұйрық алмаймын.
Dialogue: 0,0:37:59.34,0:38:02.21,Default,,0000,0000,0000,,Тыңдамасаң, үстіңе су шашамын.
Dialogue: 0,0:38:02.21,0:38:05.08,Default,,0000,0000,0000,,Әлде мен Хоулға келісім туралы айтуым керек пе?
Dialogue: 0,0:38:05.08,0:38:08.60,Default,,0000,0000,0000,,Уф... Эй! Эй!
Dialogue: 0,0:38:08.60,0:38:10.13,Default,,0000,0000,0000,,Мен мұндай әжені кіргізбеуім керек еді!
Dialogue: 0,0:38:10.13,0:38:12.13,Default,,0000,0000,0000,,Енді не істейміз?
Dialogue: 0,0:38:16.01,0:38:19.01,Default,,0000,0000,0000,,Дұрыс, бұл жақсы.
Dialogue: 0,0:38:21.23,0:38:24.09,Default,,0000,0000,0000,,Сәлем! Эй! Беконды күйдірмеңіз!
Dialogue: 0,0:38:24.09,0:38:26.12,Default,,0000,0000,0000,,Мен Калсифердің айтқанын естідім...
Dialogue: 0,0:38:26.12,0:38:29.31,Default,,0000,0000,0000,,Мен де шай алғым келеді. Сізде қазан бар ма?
Dialogue: 0,0:38:29.31,0:38:30.31,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:38:31.50,0:38:35.50,Default,,0000,0000,0000,,Жақсы….
Dialogue: 0,0:38:39.25,0:38:44.29,Default,,0000,0000,0000,,Қош келдіңіз, Хаул мырза. Патшадан хат бар.
Dialogue: 0,0:38:44.29,0:38:47.29,Default,,0000,0000,0000,,Дженкинс те, Пендрагон да емес.
Dialogue: 0,0:38:57.26,0:39:01.13,Default,,0000,0000,0000,,Кальцифер Сізді жиі естимін.
Dialogue: 0,0:39:01.13,0:39:03.15,Default,,0000,0000,0000,,Мен сені қорладым!
Dialogue: 0,0:39:03.15,0:39:06.18,Default,,0000,0000,0000,,Бұл ешкімнің қолынан келетін іс емес.
Dialogue: 0,0:39:06.18,0:39:08.04,Default,,0000,0000,0000,,Сіз кімсіз?
Dialogue: 0,0:39:08.04,0:39:11.23,Default,,0000,0000,0000,,А, мен Софи әжемін.
Dialogue: 0,0:39:11.23,0:39:14.26,Default,,0000,0000,0000,,Қараңызшы, бұл сарайдың жаңа тазалаушы әйелі.
Dialogue: 0,0:39:14.26,0:39:16.45,Default,,0000,0000,0000,,Қарызға беріңіз.
Dialogue: 0,0:39:16.45,0:39:17.45,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:39:19.98,0:39:23.98,Default,,0000,0000,0000,,Сондай-ақ, маған екі тілім бекон және алты жұмыртқа беріңіз.
Dialogue: 0,0:39:43.72,0:39:47.72,Default,,0000,0000,0000,,Дәмді… Дәмді дәмді….
Dialogue: 0,0:39:50.29,0:39:52.29,Default,,0000,0000,0000,,Өте дәмді!
Dialogue: 0,0:39:53.15,0:39:56.35,Default,,0000,0000,0000,,Кімнің тазалықшы екенін кім шешті?
Dialogue: 0,0:39:56.35,0:39:58.03,Default,,0000,0000,0000,,Бұл менмін.
Dialogue: 0,0:39:58.03,0:40:01.06,Default,,0000,0000,0000,,Мұндай лас үйді еш жерден таба алмайсың.
Dialogue: 0,0:40:01.06,0:40:04.06,Default,,0000,0000,0000,,Мм... Маркл тағамы!
Dialogue: 0,0:40:07.13,0:40:10.15,Default,,0000,0000,0000,,Бәріміз қартқа қорлық көрсетейік!
Dialogue: 0,0:40:10.15,0:40:12.15,Default,,0000,0000,0000,,Софи, өтінемін.
Dialogue: 0,0:40:17.06,0:40:19.06,Default,,0000,0000,0000,,Осы жерге отырыңыз.
Dialogue: 0,0:40:34.06,0:40:38.06,Default,,0000,0000,0000,,Таңдаңыз! Бұл кір емес жалғыз.
Dialogue: 0,0:40:40.12,0:40:43.12,Default,,0000,0000,0000,,Жұмыс көп сияқты.
Dialogue: 0,0:40:44.16,0:40:47.16,Default,,0000,0000,0000,,Маркл. иә.
Dialogue: 0,0:40:48.37,0:40:51.37,Default,,0000,0000,0000,,Софи. Ах... рахмет.
Dialogue: 0,0:40:52.08,0:40:55.27,Default,,0000,0000,0000,,Мырзалар, дәмді тамақтанайық.
Dialogue: 0,0:40:55.27,0:40:59.27,Default,,0000,0000,0000,,Дәмді тағам! Мен дұрыс таңғы ас ішкеніме біраз болды.
Dialogue: 0,0:41:05.21,0:41:08.21,Default,,0000,0000,0000,,Маған үйретеріңіз көп сияқты.
Dialogue: 0,0:41:09.41,0:41:13.12,Default,,0000,0000,0000,,...ал қалтаңда не бар?
Dialogue: 0,0:41:13.12,0:41:16.12,Default,,0000,0000,0000,,​​О... не?
Dialogue: 0,0:41:23.22,0:41:25.24,Default,,0000,0000,0000,,Бірдеңе?
Dialogue: 0,0:41:25.24,0:41:27.24,Default,,0000,0000,0000,,Қарыз беру.
Dialogue: 0,0:41:33.32,0:41:36.68,Default,,0000,0000,0000,,О, өртеніп кетті! Мистер Хаул, бұл...!
Dialogue: 0,0:41:36.68,0:41:40.22,Default,,0000,0000,0000,,Бұл өте ескі сиқыр және ол күшті.
Dialogue: 0,0:41:40.22,0:41:42.24,Default,,0000,0000,0000,,Сіз қалдықтардың сиқыршысысыз ба?
Dialogue: 0,0:41:42.24,0:41:48.14,Default,,0000,0000,0000,,«Аққан жұлдызды ұстаған сен, Жүрексіз, жүрегің менікі».
Dialogue: 0,0:41:48.14,0:41:51.14,Default,,0000,0000,0000,,Үстел бұзылды.
Dialogue: 0,0:41:55.54,0:41:57.54,Default,,0000,0000,0000,,Ах! Уау...
Dialogue: 0,0:42:04.13,0:42:06.31,Default,,0000,0000,0000,,Керемет! Жоқ!
Dialogue: 0,0:42:06.31,0:42:09.34,Default,,0000,0000,0000,,Күйік кетсе де, қарғыс кетпейді.
Dialogue: 0,0:42:09.34,0:42:12.04,Default,,0000,0000,0000,,Мырзалар, тамақты жалғастырыңыз.
Dialogue: 0,0:42:12.04,0:42:16.25,Default,,0000,0000,0000,,Калсифер, қамалды шамамен 100 км жылжытыңыз.
Dialogue: 0,0:42:16.25,0:42:19.25,Default,,0000,0000,0000,,Уме Уме...
Dialogue: 0,0:42:21.80,0:42:23.15,Default,,0000,0000,0000,,Сондай-ақ, маған ваннаға ыстық су жіберіңізші.
Dialogue: 0,0:42:23.15,0:42:26.15,Default,,0000,0000,0000,,Е, бұл да!
Dialogue: 0,0:42:27.36,0:42:30.06,Default,,0000,0000,0000,,Софи Қалдықтардың ведьмасының қызметшісі ме?
Dialogue: 0,0:42:30.06,0:42:38.47,Default,,0000,0000,0000,,Ақымақ болма! Мен даланың сиқыршысымын...
Dialogue: 0,0:42:38.47,0:42:44.02,Default,,0000,0000,0000,,Негізі мен... мен... мен...
Dialogue: 0,0:42:44.02,0:42:46.21,Default,,0000,0000,0000,,Қазірдің өзінде!!
Dialogue: 0,0:42:46.21,0:42:49.25,Default,,0000,0000,0000,,Шөлдің сиқыршысы! Келесі кездескенімізде мен сені жалғыз қалдырмаймын!
Dialogue: 0,0:42:49.25,0:42:51.25,Default,,0000,0000,0000,,Тез жеп алайық!
Dialogue: 0,0:45:26.82,0:45:30.82,Default,,0000,0000,0000,,Жәндіктер! Тез қашпасаң, мен сені сыпырып тастаймын!
Dialogue: 0,0:45:32.88,0:45:35.88,Default,,0000,0000,0000,,Барлығы, мына жігіт, адамдарды мазақ етеді!
Dialogue: 0,0:45:41.80,0:45:44.83,Default,,0000,0000,0000,,Мен сізден заклинание сұрағым келеді. Кейінірек қалдырыңыз.
Dialogue: 0,0:45:44.83,0:45:47.83,Default,,0000,0000,0000,,Бақсы ішке кіріп бара жатыр.
Dialogue: 0,0:45:53.92,0:45:55.92,Default,,0000,0000,0000,,Софи!
Dialogue: 0,0:45:57.29,0:45:59.64,Default,,0000,0000,0000,,Софи!
Dialogue: 0,0:45:59.64,0:46:01.99,Default,,0000,0000,0000,,Ол жоғалады!
Dialogue: 0,0:46:01.99,0:46:04.02,Default,,0000,0000,0000,,Отын бермесең өлемін!
Dialogue: 0,0:46:04.02,0:46:06.05,Default,,0000,0000,0000,,Не... не істеп жатырсың!?
Dialogue: 0,0:46:06.05,0:46:10.08,Default,,0000,0000,0000,,Ах! Күз Күз! Бұл қауіпті!
Dialogue: 0,0:46:10.08,0:46:13.95,Default,,0000,0000,0000,,Жақында күлді жағып жіберейік.
Dialogue: 0,0:46:13.95,0:46:17.16,Default,,0000,0000,0000,,Жоқ! Бұл ақылсыз! Ей, бұл қауіпті!
Dialogue: 0,0:46:17.16,0:46:19.51,Default,,0000,0000,0000,,А... бұл қауіпті...
Dialogue: 0,0:46:19.51,0:46:23.05,Default,,0000,0000,0000,,Ол... жоғалады... А...
Dialogue: 0,0:46:23.05,0:46:28.10,Default,,0000,0000,0000,,О, бұл қорқынышты! О... мен құлап жатырмын...
Dialogue: 0,0:46:28.10,0:46:31.80,Default,,0000,0000,0000,,Құлап жатыр... Уф...
Dialogue: 0,0:46:31.80,0:46:35.84,Default,,0000,0000,0000,,Құлау... Қауіпті... Софи Тезірек!
Dialogue: 0,0:46:35.84,0:46:38.84,Default,,0000,0000,0000,,Уау... Уау!
Dialogue: 0,0:46:48.97,0:46:50.15,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:46:50.15,0:46:53.15,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:46:57.06,0:47:01.06,Default,,0000,0000,0000,,Менің досымды қорлауды тоқтата аласыз ба?
Dialogue: 0,0:47:05.64,0:47:08.64,Default,,0000,0000,0000,,Мистер Хаул, сіз шығасыз ба?
Dialogue: 0,0:47:10.85,0:47:13.88,Default,,0000,0000,0000,,Markl Қалағаныңызша тазалаңыз→
Dialogue: 0,0:47:13.88,0:47:15.88,Default,,0000,0000,0000,,Тазалаушы әйелмен бірге болыңыз.
Dialogue: 0,0:47:19.95,0:47:22.97,Default,,0000,0000,0000,,Софи, сен бірдеңе істедің бе?
Dialogue: 0,0:47:22.97,0:47:24.99,Default,,0000,0000,0000,,Мен сені қорладым!
Dialogue: 0,0:47:24.99,0:47:27.69,Default,,0000,0000,0000,,Мен өлсем, Хаул да өледі!
Dialogue: 0,0:47:27.69,0:47:32.69,Default,,0000,0000,0000,,Мен тазалаушы әйелмін! Менің жұмысым тазалау!
Dialogue: 0,0:47:34.09,0:47:35.94,Default,,0000,0000,0000,,Да... жоқ! Екінші қабат жоқ!
Dialogue: 0,0:47:35.94,0:47:39.98,Default,,0000,0000,0000,,Мен болсам, маңызды нәрселерді асығыс тастар едім.
Dialogue: 0,0:47:39.98,0:47:42.98,Default,,0000,0000,0000,,Ах! Маған кейінірек қалдырыңыз!
Dialogue: 0,0:47:44.86,0:47:48.86,Default,,0000,0000,0000,,Хехехе... Ашулансаң көңіліңді көтеретін сияқты.
Dialogue: 0,0:47:51.93,0:47:54.93,Default,,0000,0000,0000,,Қандай ғажап үй...
Dialogue: 0,0:47:58.00,0:48:00.00,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:48:02.03,0:48:04.03,Default,,0000,0000,0000,,Уау….
Dialogue: 0,0:48:11.13,0:48:13.15,Default,,0000,0000,0000,,Ах!!
Dialogue: 0,0:48:13.15,0:48:31.16,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:48:31.16,0:48:35.03,Default,,0000,0000,0000,,Керемет! Кальцифер! Кальцифер!
Dialogue: 0,0:48:35.03,0:48:36.88,Default,,0000,0000,0000,,Сіз бұл сарайды басқарасыз ба?
Dialogue: 0,0:48:36.88,0:48:40.41,Default,,0000,0000,0000,,Шулы. Бұл анық емес пе?
Dialogue: 0,0:48:40.41,0:48:42.77,Default,,0000,0000,0000,,Бұл керемет, Калсифер!
Dialogue: 0,0:48:42.77,0:48:45.77,Default,,0000,0000,0000,,Сіздің сиқырыңыз жоғары деңгейде. Мен оны қайтадан тексердім!
Dialogue: 0,0:48:46.98,0:48:49.17,Default,,0000,0000,0000,,Менің ойымша...
Dialogue: 0,0:48:49.17,0:48:52.17,Default,,0000,0000,0000,,Мен солай ойлаймын!
Dialogue: 0,0:48:57.09,0:48:59.95,Default,,0000,0000,0000,,А, әлі жоқ!
Dialogue: 0,0:48:59.95,0:49:02.47,Default,,0000,0000,0000,,Жақсы….
Dialogue: 0,0:49:02.47,0:49:04.47,Default,,0000,0000,0000,,Жақсы!
Dialogue: 0,0:49:06.01,0:49:09.04,Default,,0000,0000,0000,,Ах! Эй!
Dialogue: 0,0:49:09.04,0:49:19.98,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:49:19.98,0:49:32.10,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:49:32.10,0:49:33.12,Default,,0000,0000,0000,,Бұл әдемі.
Dialogue: 0,0:49:33.12,0:49:37.12,Default,,0000,0000,0000,,Жұлдызды көл деп аталады... Иә?
Dialogue: 0,0:49:40.02,0:49:42.88,Default,,0000,0000,0000,,Тесікке бір нәрсе кептеліп қалды.
Dialogue: 0,0:49:42.88,0:49:46.88,Default,,0000,0000,0000,,О, Маркл, маған қолыңды бер. Иә.
Dialogue: 0,0:49:52.97,0:49:53.99,Default,,0000,0000,0000,,Міне!
Dialogue: 0,0:49:53.99,0:49:55.00,Default,,0000,0000,0000,,Қорқыт!
Dialogue: 0,0:49:55.00,0:49:57.02,Default,,0000,0000,0000,,Оны шалқан бас шалқан дейді.
Dialogue: 0,0:49:57.02,0:50:01.02,Default,,0000,0000,0000,,Сіз төңкерілгенді ұнатасыз.
Dialogue: 0,0:50:02.91,0:50:04.91,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:50:09.64,0:50:13.02,Default,,0000,0000,0000,,Бір қызығы саған ұнады, сен менің артымнан ердің.
Dialogue: 0,0:50:13.02,0:50:16.05,Default,,0000,0000,0000,,Софи шынымен бақсы емес пе?
Dialogue: 0,0:50:16.05,0:50:20.92,Default,,0000,0000,0000,,Дұрыс, ол осы елдегі ең сұлу бақсы.
Dialogue: 0,0:50:20.92,0:50:40.95,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:50:40.95,0:50:49.04,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:50:49.04,0:50:52.04,Default,,0000,0000,0000,,Шалғам! Сіз тым қатты тартып жатырсыз!
Dialogue: 0,0:51:00.82,0:51:03.18,Default,,0000,0000,0000,,Кірді ұнататын сияқтысыз.
Dialogue: 0,0:51:03.18,0:51:06.18,Default,,0000,0000,0000,,Ол тезірек кебеді.
Dialogue: 0,0:51:08.06,0:51:11.09,Default,,0000,0000,0000,,Меніңше, лақтар шайтанның отбасына жатады.
Dialogue: 0,0:51:11.09,0:51:12.94,Default,,0000,0000,0000,,Кальцифер не нәрсеге ашуланбайды.
Dialogue: 0,0:51:12.94,0:51:16.31,Default,,0000,0000,0000,,Бұл өлім құдайы болуы мүмкін.
Dialogue: 0,0:51:16.31,0:51:21.02,Default,,0000,0000,0000,,Бірақ сіз осындай жерге келгеннен бері...
Dialogue: 0,0:51:21.02,0:51:41.06,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:51:41.06,0:51:50.99,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:51:50.99,0:52:03.11,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:52:03.11,0:52:05.97,Default,,0000,0000,0000,,Софи Мен кірді тастадым.
Dialogue: 0,0:52:05.97,0:52:09.17,Default,,0000,0000,0000,,Ах, рахмет. Мен қазір қайтуым керек.
Dialogue: 0,0:52:09.17,0:52:15.17,Default,,0000,0000,0000,,Біртүрлі, мен бірінші рет осылай сабырлы болып тұрмын...
Dialogue: 0,0:52:32.91,0:52:35.91,Default,,0000,0000,0000,,(бомба дыбысы)
Dialogue: 0,0:52:40.98,0:52:45.98,Default,,0000,0000,0000,,(бомба дыбысы)
Dialogue: 0,0:52:55.97,0:52:57.97,Default,,0000,0000,0000,,Гах! Я~!
Dialogue: 0,0:53:31.15,0:53:33.51,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:53:33.51,0:53:38.06,Default,,0000,0000,0000,,Иісі...тірі заттар мен жанып тұрған темірдің иісі.
Dialogue: 0,0:53:38.06,0:53:41.93,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,0:53:41.93,0:53:44.79,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:53:44.79,0:53:50.79,Default,,0000,0000,0000,,Уф... Уф...
Dialogue: 0,0:53:54.72,0:53:56.91,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:53:56.91,0:54:00.91,Default,,0000,0000,0000,,Егер сіз тым алыс ұшсаңыз, қайтып орала алмайсыз.
Dialogue: 0,0:54:04.99,0:54:08.99,Default,,0000,0000,0000,,Бұл таңқаларлық. Софи оны маған қойды.
Dialogue: 0,0:54:10.05,0:54:12.40,Default,,0000,0000,0000,,Бұл сұмдық соғыс.
Dialogue: 0,0:54:12.40,0:54:17.11,Default,,0000,0000,0000,,Оңтүстік теңізден солтүстік шекараға дейін от теңізі болды.
Dialogue: 0,0:54:17.11,0:54:18.97,Default,,0000,0000,0000,,Эй, мен мылтықтың отын жек көремін.
Dialogue: 0,0:54:18.97,0:54:22.00,Default,,0000,0000,0000,,Оларда әдептілік жоқ.
Dialogue: 0,0:54:22.00,0:54:26.04,Default,,0000,0000,0000,,Маған жұмысшы әріптесім шабуыл жасады. Шөлдің сиқыршысы ма?
Dialogue: 0,0:54:26.04,0:54:29.91,Default,,0000,0000,0000,,Жоқ, Мишита құбыжық болып өзгерді.
Dialogue: 0,0:54:29.91,0:54:35.97,Default,,0000,0000,0000,,Кейінірек жылайсың. Біріншіден, адам болып қайта оралуға болмайды.
Dialogue: 0,0:54:35.97,0:54:39.00,Default,,0000,0000,0000,,Уайымдама, мен жылауды ұмытамын.
Dialogue: 0,0:54:39.00,0:54:42.03,Default,,0000,0000,0000,,Хаулды да патша шақырды, солай ма?
Dialogue: 0,0:54:42.03,0:54:45.07,Default,,0000,0000,0000,,Ал... маған ваннаға ыстық су жіберіңізші.
Dialogue: 0,0:54:45.07,0:54:47.07,Default,,0000,0000,0000,,Е, тағы да...
Dialogue: 0,0:54:48.10,0:55:08.96,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:55:08.96,0:55:11.96,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:55:16.38,0:55:18.38,Default,,0000,0000,0000,,Иә! иә?
Dialogue: 0,0:55:20.08,0:55:24.08,Default,,0000,0000,0000,,Айқай? Иә, сіз тым көп ыстық суды пайдаланып жатырсыз.
Dialogue: 0,0:55:29.17,0:55:32.20,Default,,0000,0000,0000,,Мистер Хаул, оны ешқашан жемейді деп ойлаймын.
Dialogue: 0,0:55:32.20,0:55:33.05,Default,,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:55:33.05,0:55:35.05,Default,,0000,0000,0000,,Қайырлы таң. қайырлы таң.
Dialogue: 0,0:55:38.09,0:55:42.30,Default,,0000,0000,0000,,Таңертеңгілік базар жақсы емес. Бұл менің теңізге бірінші рет шығуым.
Dialogue: 0,0:55:42.30,0:55:47.30,Default,,0000,0000,0000,,Бұл әдемі. Жарқырап тұр. Бұл әдеттегідей.
Dialogue: 0,0:55:56.10,0:55:58.12,Default,,0000,0000,0000,,Мен картопты ұнатпаймын.
Dialogue: 0,0:55:58.12,0:56:01.15,Default,,0000,0000,0000,,Төлеңіз... Рахмет.
Dialogue: 0,0:56:01.15,0:56:02.15,Default,,0000,0000,0000,,Майдо!
Dialogue: 0,0:56:03.01,0:56:06.04,Default,,0000,0000,0000,,Олардың барлығы мен жаңа ғана қуырған балықтар.
Dialogue: 0,0:56:06.04,0:56:10.74,Default,,0000,0000,0000,,Бұл дәмді. Мен балықты ұнатпаймын.
Dialogue: 0,0:56:10.74,0:56:13.94,Default,,0000,0000,0000,,Флот қайтып келді! Мен қайтып келдім!
Dialogue: 0,0:56:13.94,0:56:16.14,Default,,0000,0000,0000,,Шамасы, тағы бір шайқас болды.
Dialogue: 0,0:56:16.14,0:56:20.14,Default,,0000,0000,0000,,Шынымен!? Ханым, кейінірек қалдырыңыз. Өртеніп жатқан сияқты.
Dialogue: 0,0:56:24.05,0:56:27.05,Default,,0000,0000,0000,,(Пойыз ысқырығы)
Dialogue: 0,0:56:34.99,0:56:37.99,Default,,0000,0000,0000,,Сәттілік! Іске сәт!
Dialogue: 0,0:56:43.07,0:56:44.93,Default,,0000,0000,0000,,Софи Жақынырақ барайық.
Dialogue: 0,0:56:44.93,0:56:48.13,Default,,0000,0000,0000,,Жоқ, мен мұны істей алмаймын. Қайтейік.
Dialogue: 0,0:56:48.13,0:56:52.13,Default,,0000,0000,0000,,Мен соңғы үлгідегі әскери кемеге бұлай шабуыл жасайды деп ешқашан күтпедім.
Dialogue: 0,0:56:55.03,0:56:58.89,Default,,0000,0000,0000,,Маркл Бір резеңке адам бар. иә?
Dialogue: 0,0:56:58.89,0:57:02.89,Default,,0000,0000,0000,,Қозғалмаңыз! Қалдықтардың ведьмасының қызметшісі.
Dialogue: 0,0:57:07.98,0:57:09.00,Default,,0000,0000,0000,,Мен бардым...
Dialogue: 0,0:57:09.00,0:57:12.70,Default,,0000,0000,0000,,Мұндай елесті басқа адамдар көре алмайды ма деп ойлаймын.
Dialogue: 0,0:57:12.70,0:57:14.89,Default,,0000,0000,0000,,(ұшатын оқ дыбысы)
Dialogue: 0,0:57:14.89,0:57:17.92,Default,,0000,0000,0000,,(бомба дыбысы)
Dialogue: 0,0:57:17.92,0:57:19.94,Default,,0000,0000,0000,,Мына жерде! Міне!
Dialogue: 0,0:57:19.94,0:57:21.12,Default,,0000,0000,0000,,Бұл ол! Ол тастап кетті!
Dialogue: 0,0:57:21.12,0:57:24.12,Default,,0000,0000,0000,,Софи! Бұл жаудың ұшатын әскери кемесі!
Dialogue: 0,0:57:29.20,0:57:32.73,Default,,0000,0000,0000,,Софи Бұл флайер! Софи!
Dialogue: 0,0:57:32.73,0:57:35.73,Default,,0000,0000,0000,,Парақшаларды алмау Жау парақшаларын алма.
Dialogue: 0,0:57:35.94,0:57:38.97,Default,,0000,0000,0000,,Ха ха ха ха….
Dialogue: 0,0:57:38.97,0:57:41.82,Default,,0000,0000,0000,,Софи, жақсысың ба?
Dialogue: 0,0:57:41.82,0:57:47.05,Default,,0000,0000,0000,,Хаа… Хаа… Хаа….
Dialogue: 0,0:57:47.05,0:57:50.05,Default,,0000,0000,0000,,Бір стақан су беріңізші. Иә.
Dialogue: 0,0:57:59.00,0:58:01.02,Default,,0000,0000,0000,,～!! !?
Dialogue: 0,0:58:01.02,0:58:05.90,Default,,0000,0000,0000,,Ах! Аа….
Dialogue: 0,0:58:05.90,0:58:08.93,Default,,0000,0000,0000,,Софи! Жуынатын бөлмедегі сөремен араластыңыз ба?
Dialogue: 0,0:58:08.93,0:58:12.13,Default,,0000,0000,0000,,Қараңыз!! Бұл біртүрлі түс!!
Dialogue: 0,0:58:12.13,0:58:14.49,Default,,0000,0000,0000,,Әдемі шаш.
Dialogue: 0,0:58:14.49,0:58:17.18,Default,,0000,0000,0000,,Мұқият қараңыз!! Софи сөремен айналысады→
Dialogue: 0,0:58:17.18,0:58:19.04,Default,,0000,0000,0000,,Мен сиқырды бұздым!!
Dialogue: 0,0:58:19.04,0:58:23.07,Default,,0000,0000,0000,,Мен ешнәрсеге араласпадым, мен оны тазаладым.
Dialogue: 0,0:58:23.07,0:58:24.93,Default,,0000,0000,0000,,Тазалау Тазалау….
Dialogue: 0,0:58:24.93,0:58:28.29,Default,,0000,0000,0000,,Сондықтан мен саған көп тазалауды айттым!
Dialogue: 0,0:58:28.29,0:58:33.01,Default,,0000,0000,0000,,Үмітсіздік... Не деген қорлық...
Dialogue: 0,0:58:33.01,0:58:34.02,Default,,0000,0000,0000,,《Жоқ, жасама!》
Dialogue: 0,0:58:34.02,0:58:37.05,Default,,0000,0000,0000,,Бұл жаман емес. (жылау)
Dialogue: 0,0:58:37.05,0:58:44.95,Default,,0000,0000,0000,,《Жоқ, жасама!》
Dialogue: 0,0:58:44.95,0:58:48.32,Default,,0000,0000,0000,,Өзінше әдемі деп ойлаймын.
Dialogue: 0,0:58:48.32,0:58:50.68,Default,,0000,0000,0000,,Бітті...
Dialogue: 0,0:58:50.68,0:58:53.68,Default,,0000,0000,0000,,Сұлу болмасаң, өмір сүрудің мәні жоқ.
Dialogue: 0,0:58:54.89,0:58:56.89,Default,,0000,0000,0000,,Фалько…
Dialogue: 0,0:58:57.92,0:58:59.92,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:59:04.99,0:59:07.02,Default,,0000,0000,0000,,Тоқта... Айқай, Тоқта!
Dialogue: 0,0:59:07.02,0:59:11.39,Default,,0000,0000,0000,,Мен қараңғылық рухын шақырамын! Мені бұрын бір қыз тастап кеткен →
Dialogue: 0,0:59:11.39,0:59:13.39,Default,,0000,0000,0000,,Мен оны бұрын жариялағанмын! Е!?
Dialogue: 0,0:59:15.10,0:59:18.13,Default,,0000,0000,0000,,Кел, Уай, тоқтайық.
Dialogue: 0,0:59:18.13,0:59:21.99,Default,,0000,0000,0000,,Егер бұл сіздің шашыңыз болса, оны қайтадан бояуға болады.
Dialogue: 0,0:59:21.99,0:59:23.99,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:59:27.05,0:59:30.05,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:59:32.76,0:59:35.12,Default,,0000,0000,0000,,Сіз Howl арқылы қалағаныңызды жасай аласыз!
Dialogue: 0,0:59:35.12,0:59:38.12,Default,,0000,0000,0000,,Мен ешқашан әдемі болған емеспін!
Dialogue: 0,0:59:39.17,0:59:42.17,Default,,0000,0000,0000,,Маған бұл жер енді ұнамайды!
Dialogue: 0,0:59:53.98,0:59:59.20,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:59:59.20,1:00:11.82,Default,,0000,0000,0000,,～ （）
Dialogue: 0,1:00:11.82,1:00:21.08,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:00:21.08,1:00:24.12,Default,,0000,0000,0000,,Рахмет, Балапан. Сен мейірімді қорқасың.
Dialogue: 0,1:00:24.12,1:00:27.99,Default,,0000,0000,0000,,Софи, қайтып келші! Howl қиыншылықта!
Dialogue: 0,1:00:27.99,1:00:31.02,Default,,0000,0000,0000,,Айқай, тоқта! Ол жоғалады!
Dialogue: 0,1:00:31.02,1:00:34.21,Default,,0000,0000,0000,,Софи!
Dialogue: 0,1:00:34.21,1:00:36.21,Default,,0000,0000,0000,,Тез кел!
Dialogue: 0,1:00:38.09,1:00:41.12,Default,,0000,0000,0000,,Бұл жарқыраған. Ол өлді деп ойлаймын.
Dialogue: 0,1:00:41.12,1:00:44.15,Default,,0000,0000,0000,,Ештеңе жоқ, реніштен ешкім өлген жоқ.
Dialogue: 0,1:00:44.15,1:00:47.15,Default,,0000,0000,0000,,Маркл, маған көмектес. Иә.
Dialogue: 0,1:00:50.21,1:00:53.07,Default,,0000,0000,0000,,Markl Ыстық су көп. Иә.
Dialogue: 0,1:00:53.07,1:00:55.43,Default,,0000,0000,0000,,Қарашы, сен өз аяғыңмен жүресің.
Dialogue: 0,1:00:55.43,1:01:06.88,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:01:06.88,1:01:10.88,Default,,0000,0000,0000,,Маркл Тағы бір нәрсе, өтінемін. Иә.
Dialogue: 0,1:01:11.92,1:01:13.78,Default,,0000,0000,0000,,Мен қайтадан тазалауым керек.
Dialogue: 0,1:01:13.78,1:01:22.70,Default,,0000,0000,0000,,♪~
Dialogue: 0,1:01:22.70,1:01:27.70,Default,,0000,0000,0000,,«Жағалауға қону»... Қараңдар.
Dialogue: 0,1:01:31.79,1:01:33.79,Default,,0000,0000,0000,,
Dialogue: 0,1:01:34.82,1:01:36.84,Default,,0000,0000,0000,,
Dialogue: 0,1:01:36.84,1:01:38.84,Default,,0000,0000,0000,,...
Dialogue: 0,1:01:46.44,1:01:49.44,Default,,0000,0000,0000,,Жылы сүт, оны ішіңіз.
Dialogue: 0,1:01:51.99,1:01:56.99,Default,,0000,0000,0000,,Мен оны осында қалдырамын, суығанша ішіңіз.
Dialogue: 0,1:02:00.07,1:02:03.07,Default,,0000,0000,0000,,Барма, Софи.
Dialogue: 0,1:02:09.84,1:02:12.84,Default,,0000,0000,0000,,Сіз сүт ішесіз бе?
Dialogue: 0,1:02:21.95,1:02:25.95,Default,,0000,0000,0000,,Қоқыс бақсысы менің үйімді іздеп жүр.
Dialogue: 0,1:02:27.01,1:02:30.04,Default,,0000,0000,0000,,А... Мен сіздің адамдарыңызды портта көрдім.
Dialogue: 0,1:02:30.04,1:02:33.40,Default,,0000,0000,0000,,Мен шынымен қорқақпын.
Dialogue: 0,1:02:33.40,1:02:36.94,Default,,0000,0000,0000,,Бұл қоқыс - бұл сиқыршыларды болдырмауға арналған сиқырлар.
Dialogue: 0,1:02:36.94,1:02:39.97,Default,,0000,0000,0000,,Мен қорқамын және қорқамын.
Dialogue: 0,1:02:39.97,1:02:43.85,Default,,0000,0000,0000,,Ей, неліктен Қалдықтардың ведьмасы Хаулды нысанаға алады?
Dialogue: 0,1:02:43.85,1:02:48.05,Default,,0000,0000,0000,,I thought he seemed like an interesting person, so I approached him.
Dialogue: 0,1:02:48.05,1:02:52.43,Default,,0000,0000,0000,,Сөйтіп ол қашып кетті. Ол қорқынышты адам еді...
Dialogue: 0,1:02:52.43,1:02:54.78,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,1:02:54.78,1:02:57.99,Default,,0000,0000,0000,,Содан мені патша соғысқа шақырды.
Dialogue: 0,1:02:57.99,1:03:00.84,Default,,0000,0000,0000,,Дженкинс те, Пендрагон да емес.
Dialogue: 0,1:03:00.84,1:03:03.04,Default,,0000,0000,0000,,Хаулдың неше аты бар?
Dialogue: 0,1:03:03.04,1:03:07.08,Default,,0000,0000,0000,,Еркін өмір сүру үшін сонда болыңыз. Хмм….
Dialogue: 0,1:03:07.08,1:03:10.95,Default,,0000,0000,0000,,Патшаның әңгімесінен бас тарта алмайсың ба? Бұл.
Dialogue: 0,1:03:10.95,1:03:15.95,Default,,0000,0000,0000,,When you enter magic school, you are made to take an oath.
Dialogue: 0,1:03:17.01,1:03:20.04,Default,,0000,0000,0000,,Эй Уол, патшаға бар.
Dialogue: 0,1:03:20.04,1:03:22.06,Default,,0000,0000,0000,,Ә!?
Dialogue: 0,1:03:22.06,1:03:24.92,Default,,0000,0000,0000,,Тек анық айтыңыз.
Dialogue: 0,1:03:24.92,1:03:28.12,Default,,0000,0000,0000,,"Бұл ақымақ соғысты тоқтат. Мен саған көмектесе алмаймын!"
Dialogue: 0,1:03:28.12,1:03:33.51,Default,,0000,0000,0000,,Ха~ Софи ол адамдарды танымайды.
Dialogue: 0,1:03:33.51,1:03:36.03,Default,,0000,0000,0000,,Өйткені, ол патша.
Dialogue: 0,1:03:36.03,1:03:39.90,Default,,0000,0000,0000,,The king is the one who thinks about everyone.
Dialogue: 0,1:03:39.90,1:03:43.11,Default,,0000,0000,0000,,Түсіндім! Оның орнына маған Софи керек!
Dialogue: 0,1:03:43.11,1:03:45.12,Default,,0000,0000,0000,,Ә!?
Dialogue: 0,1:03:45.12,1:03:47.98,Default,,0000,0000,0000,,Пендрагонның анасы.
Dialogue: 0,1:03:47.98,1:03:50.01,Default,,0000,0000,0000,,«Менің ұлым – түкке тұрғысыз бейбақ» →
Dialogue: 0,1:03:50.01,1:03:51.85,Default,,0000,0000,0000,,Барыңыз!
Dialogue: 0,1:03:51.85,1:03:54.22,Default,,0000,0000,0000,,Сәлиман ханым да бас тартуы мүмкін!
Dialogue: 0,1:03:54.22,1:03:56.22,Default,,0000,0000,0000,,Сәлиман ханым?
Dialogue: 0,1:03:59.10,1:04:01.12,Default,,0000,0000,0000,,Сіз бұл қалпақ киіп жүрсіз бе?
Dialogue: 0,1:04:01.12,1:04:03.98,Default,,0000,0000,0000,,Even though I used magic to clean my clothes.
Dialogue: 0,1:04:03.98,1:04:06.00,Default,,0000,0000,0000,,Мен келемін. Иә.
Dialogue: 0,1:04:06.00,1:04:08.00,Default,,0000,0000,0000,,Келіңіздер!
Dialogue: 0,1:04:16.77,1:04:20.77,Default,,0000,0000,0000,,Amulet So that you can go and return safely.
Dialogue: 0,1:04:21.15,1:04:24.02,Default,,0000,0000,0000,,Don't worry, I'll change my appearance and follow you.
Dialogue: 0,1:04:24.02,1:04:26.02,Default,,0000,0000,0000,,Енді кеттік!
Dialogue: 0,1:04:33.94,1:04:36.94,Default,,0000,0000,0000,,I started to feel like things would never go well.
Dialogue: 0,1:04:43.21,1:04:45.89,Default,,0000,0000,0000,,(Қарғаның айқайы)
Dialogue: 0,1:04:45.89,1:04:49.89,Default,,0000,0000,0000,,Watching over me doesn't mean I'm turning into a crow.
Dialogue: 0,1:04:55.16,1:04:59.16,Default,,0000,0000,0000,,Howl could turn into something even more flashy.
Dialogue: 0,1:05:04.08,1:05:06.94,Default,,0000,0000,0000,,Жоқ.
Dialogue: 0,1:05:06.94,1:05:17.04,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:05:17.04,1:05:20.74,Default,,0000,0000,0000,,～ …
Dialogue: 0,1:05:20.74,1:05:29.00,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:05:29.00,1:05:32.03,Default,,0000,0000,0000,,～
Dialogue: 0,1:05:32.03,1:05:52.90,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:05:52.90,1:06:01.82,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:06:01.82,1:06:05.86,Default,,0000,0000,0000,,Айқай? Сіз Howl емессіз, солай ма?
Dialogue: 0,1:06:05.86,1:06:07.86,Default,,0000,0000,0000,,Хин!
Dialogue: 0,1:06:09.56,1:06:13.94,Default,,0000,0000,0000,,Қазірдің өзінде! Кәрі итке айналғаныма сене алар емеспін.
Dialogue: 0,1:06:13.94,1:06:16.94,Default,,0000,0000,0000,,Do you realize how difficult it is for the elderly?
Dialogue: 0,1:06:19.16,1:06:22.86,Default,,0000,0000,0000,,Біраз уақыт өтті. Сіз ол кезде қалпақ дүкені болдыңыз, солай ма?
Dialogue: 0,1:06:22.86,1:06:24.05,Default,,0000,0000,0000,,Шөлдің сиқыршысы!
Dialogue: 0,1:06:24.05,1:06:28.05,Default,,0000,0000,0000,,Хатты Хаулға жеткізгеніңіз үшін рахмет.
Dialogue: 0,1:06:30.44,1:06:32.96,Default,,0000,0000,0000,,Айқай, қалайсың?
Dialogue: 0,1:06:32.96,1:06:34.82,Default,,0000,0000,0000,,Мен қалтырап кеттім.
Dialogue: 0,1:06:34.82,1:06:37.85,Default,,0000,0000,0000,,Сізге рахмет, мен тазалықшы болып жұмыс істеймін.
Dialogue: 0,1:06:37.85,1:06:41.05,Default,,0000,0000,0000,,Хехе... Бұл жақсы.
Dialogue: 0,1:06:41.05,1:06:44.92,Default,,0000,0000,0000,,Айтпақшы, патшаға неге барасыз?
Dialogue: 0,1:06:44.92,1:06:47.95,Default,,0000,0000,0000,,Жұмыс іздеу! Мен Хаулдың орнынан шаршадым!
Dialogue: 0,1:06:47.95,1:06:50.30,Default,,0000,0000,0000,,Сіз кімсіз?
Dialogue: 0,1:06:50.30,1:06:52.83,Default,,0000,0000,0000,,Мені патша шақырады.
Dialogue: 0,1:06:52.83,1:06:57.05,Default,,0000,0000,0000,,Сулиманның ақымақына менің көмегім керек сияқты.
Dialogue: 0,1:06:57.05,1:07:01.92,Default,,0000,0000,0000,,Одан гөрі маған айтқан қарғысыңды алып тасташы.
Dialogue: 0,1:07:01.92,1:07:05.13,Default,,0000,0000,0000,,О, жоқ, мені қарғыс айту мүмкін, бірақ→
Dialogue: 0,1:07:05.13,1:07:10.17,Default,,0000,0000,0000,,Мен шеше алмайтын бақсымын. Кешіріңіз.
Dialogue: 0,1:07:10.17,1:07:14.72,Default,,0000,0000,0000,,Бір минут күтіңіз! Күте тұрыңыз!
Dialogue: 0,1:07:14.72,1:07:17.92,Default,,0000,0000,0000,,Қазірдің өзінде! Сен болмасаң мен сені таяғыммен ұрар едім!
Dialogue: 0,1:07:17.92,1:07:35.59,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:07:35.59,1:07:37.94,Default,,0000,0000,0000,,Балалар сендерге не болды?
Dialogue: 0,1:07:37.94,1:07:40.97,Default,,0000,0000,0000,,Ханым, осыдан кейін тыйым салынған!
Dialogue: 0,1:07:40.97,1:07:42.99,Default,,0000,0000,0000,,Жаяу жүріңіз!
Dialogue: 0,1:07:42.99,1:07:48.99,Default,,0000,0000,0000,,Сәлиман! Сіз сиқырлы алаңды немесе бір нәрсені орнату арқылы мені баспалдақпен көтеруге тырысасыз ба?
Dialogue: 0,1:07:50.07,1:07:51.07,Default,,0000,0000,0000,,
Dialogue: 0,1:07:58.99,1:08:01.99,Default,,0000,0000,0000,,Мен сені қуып жетемін. Мені танымайтындай әрекет ет.
Dialogue: 0,1:08:11.11,1:08:12.11,Default,,0000,0000,0000,,Хин!
Dialogue: 0,1:08:13.30,1:08:16.30,Default,,0000,0000,0000,,Не? қазірдің өзінде….
Dialogue: 0,1:08:20.88,1:08:23.07,Default,,0000,0000,0000,,Сәттілік….
Dialogue: 0,1:08:23.07,1:08:26.94,Default,,0000,0000,0000,,Жақсы, жақсы….
Dialogue: 0,1:08:26.94,1:08:30.97,Default,,0000,0000,0000,,Ауыр... Неге сонша ауыр?
Dialogue: 0,1:08:30.97,1:08:36.20,Default,,0000,0000,0000,,Ха ха ха ха…. Ммммммм жақсы...
Dialogue: 0,1:08:36.20,1:08:38.20,Default,,0000,0000,0000,,Жарайды...
Dialogue: 0,1:08:40.07,1:08:44.11,Default,,0000,0000,0000,,Сіз... сәл күте тұрыңыз.
Dialogue: 0,1:08:44.11,1:08:50.00,Default,,0000,0000,0000,,Не... қарғысты қалай бұзу керектігін де есіңе түсірдің бе?
Dialogue: 0,1:08:50.00,1:08:55.22,Default,,0000,0000,0000,,Сонымен... бұл... білмеймін.
Dialogue: 0,1:08:55.22,1:08:57.08,Default,,0000,0000,0000,,Олай болса, оқиық!
Dialogue: 0,1:08:57.08,1:09:01.78,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,1:09:01.78,1:09:07.17,Default,,0000,0000,0000,,Бұл біртүрлі. Неге сонша көңілдісің?
Dialogue: 0,1:09:07.17,1:09:09.03,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,1:09:09.03,1:09:14.92,Default,,0000,0000,0000,,Ха ха ха ха….
Dialogue: 0,1:09:14.92,1:09:19.96,Default,,0000,0000,0000,,Эй, бір секундқа төмен түс. Хаха...
Dialogue: 0,1:09:19.96,1:09:23.67,Default,,0000,0000,0000,,Жақсы, жақсы….
Dialogue: 0,1:09:23.67,1:09:27.88,Default,,0000,0000,0000,,Бүгін тастасаңыз ше? Бұл мүмкін емес.
Dialogue: 0,1:09:27.88,1:09:32.93,Default,,0000,0000,0000,,Менің бұл жерден қуылғаныма 50 жыл болды.
Dialogue: 0,1:09:32.93,1:09:38.15,Default,,0000,0000,0000,,Бұл күнді елсіз жерде күттім...
Dialogue: 0,1:09:38.15,1:09:39.83,Default,,0000,0000,0000,,Олай болса, бар күшіңді сал.
Dialogue: 0,1:09:39.83,1:09:43.20,Default,,0000,0000,0000,,Қол ұшын созатындай мейірімді емеспін.
Dialogue: 0,1:09:43.20,1:09:46.90,Default,,0000,0000,0000,,Кел, Уай... қазірдің өзінде!
Dialogue: 0,1:09:46.90,1:09:51.12,Default,,0000,0000,0000,,Қандай жүрексіз адам! Келесі жолы мен оны одан да беймаза қыламын!
Dialogue: 0,1:09:51.12,1:09:59.02,Default,,0000,0000,0000,,Ха ха ха, жарайды...
Dialogue: 0,1:09:59.02,1:10:03.07,Default,,0000,0000,0000,,Доккоишотто….
Dialogue: 0,1:10:03.07,1:10:11.82,Default,,0000,0000,0000,,Ха ха ха ха….
Dialogue: 0,1:10:11.82,1:10:14.85,Default,,0000,0000,0000,,Тез кел!
Dialogue: 0,1:10:14.85,1:10:17.88,Default,,0000,0000,0000,,Ханым, мен сізге жол көрсетемін.
Dialogue: 0,1:10:17.88,1:10:20.91,Default,,0000,0000,0000,,Оның орнына сол адамға көмектесіңіз.
Dialogue: 0,1:10:20.91,1:10:23.94,Default,,0000,0000,0000,,Қол ұшын беруге тыйым салынады.
Dialogue: 0,1:10:23.94,1:10:27.30,Default,,0000,0000,0000,,Не? Келген патша емес еді.
Dialogue: 0,1:10:27.30,1:10:30.84,Default,,0000,0000,0000,,Сіз! Іске сәт!
Dialogue: 0,1:10:30.84,1:10:32.86,Default,,0000,0000,0000,,Тағы біраз!
Dialogue: 0,1:10:32.86,1:10:36.06,Default,,0000,0000,0000,,Әлі де сиқыршы!
Dialogue: 0,1:10:36.06,1:10:41.11,Default,,0000,0000,0000,,Шулы хахаха...
Dialogue: 0,1:10:41.11,1:10:43.11,Default,,0000,0000,0000,,Сіз кенеттен қартайдыңыз ба?
Dialogue: 0,1:13:15.99,1:13:18.99,Default,,0000,0000,0000,,...
Dialogue: 0,1:13:19.19,1:13:23.19,Default,,0000,0000,0000,,Мықты болыңыз. Сіз әрқашан осында келгіңіз келді, солай емес пе?
Dialogue: 0,1:13:27.60,1:13:30.30,Default,,0000,0000,0000,,～
Dialogue: 0,1:13:30.30,1:13:34.01,Default,,0000,0000,0000,,Пендрагон? Бұл мен бұрын естіген есім.
Dialogue: 0,1:13:34.01,1:13:38.05,Default,,0000,0000,0000,,Бұл анық, солай ма? Бұл мен жұмыс істеген қалпақ дүкенінің аты.
Dialogue: 0,1:13:38.05,1:13:40.07,Default,,0000,0000,0000,,Мен көремін...
Dialogue: 0,1:13:40.07,1:13:42.07,Default,,0000,0000,0000,,...
Dialogue: 0,1:13:46.13,1:13:52.13,Default,,0000,0000,0000,,Ах, Ису... Бұл менмін...
Dialogue: 0,1:13:56.07,1:13:59.07,Default,,0000,0000,0000,,Аа….
Dialogue: 0,1:14:03.13,1:14:05.13,Default,,0000,0000,0000,,Айқай, мұнда кел.
Dialogue: 0,1:14:13.06,1:14:15.06,Default,,0000,0000,0000,,Әйеліңіз осында.
Dialogue: 0,1:14:28.22,1:14:30.22,Default,,0000,0000,0000,,Уф!
Dialogue: 0,1:14:34.11,1:14:39.16,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:14:39.16,1:14:41.16,Default,,0000,0000,0000,,Аа….
Dialogue: 0,1:15:15.18,1:15:18.21,Default,,0000,0000,0000,,Мен оны Хаулдың анасы деп естідім.
Dialogue: 0,1:15:18.21,1:15:20.07,Default,,0000,0000,0000,,Иә, менің атым Пендрагон.
Dialogue: 0,1:15:20.07,1:15:24.27,Default,,0000,0000,0000,,Сіз шаршаған болуыңыз керек. Ілгері жүру.
Dialogue: 0,1:15:24.27,1:15:25.27,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,1:15:35.05,1:15:39.05,Default,,0000,0000,0000,,Мен Сүлиман, патшаның сиқыршысымын.
Dialogue: 0,1:15:41.11,1:15:43.11,Default,,0000,0000,0000,,Хин.
Dialogue: 0,1:15:43.97,1:15:46.16,Default,,0000,0000,0000,,Сол ит...
Dialogue: 0,1:15:46.16,1:15:48.18,Default,,0000,0000,0000,,Хин ше?
Dialogue: 0,1:15:48.18,1:15:52.18,Default,,0000,0000,0000,,Менің итім, мен саған жол көрсетуге рұқсат етемін.
Dialogue: 0,1:15:53.07,1:15:55.25,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:15:55.25,1:15:58.95,Default,,0000,0000,0000,,Басқаша айтқанда, Хаул келмейді.
Dialogue: 0,1:15:58.95,1:16:02.16,Default,,0000,0000,0000,,Анасын алмастыратын ұл.
Dialogue: 0,1:16:02.16,1:16:06.19,Default,,0000,0000,0000,,Оның патшаға пайдасы жоқ деп ойлаймын.
Dialogue: 0,1:16:06.19,1:16:09.22,Default,,0000,0000,0000,,Мен қиындыққа тап болдым.
Dialogue: 0,1:16:09.22,1:16:13.10,Default,,0000,0000,0000,,Ол кісі менің соңғы шәкіртім...
Dialogue: 0,1:16:13.10,1:16:16.97,Default,,0000,0000,0000,,Ол үлкен талант иесі болған.
Dialogue: 0,1:16:16.97,1:16:23.03,Default,,0000,0000,0000,,Мен өзімнің мұрагерімді тапқаныма шын қуандым.
Dialogue: 0,1:16:23.03,1:16:29.09,Default,,0000,0000,0000,,Алайда әлгі бала шайтанның арбауына түсіп, мені тастап кетті.
Dialogue: 0,1:16:29.09,1:16:33.09,Default,,0000,0000,0000,,Мен сиқырды тек өзім үшін қолдана бастадым.
Dialogue: 0,1:16:34.98,1:16:37.17,Default,,0000,0000,0000,,Ана. иә.
Dialogue: 0,1:16:37.17,1:16:39.03,Default,,0000,0000,0000,,Бұл нәрсе өте қауіпті.
Dialogue: 0,1:16:39.03,1:16:43.03,Default,,0000,0000,0000,,Жүрегімді жоғалтып алсам да, күшім тым көп.
Dialogue: 0,1:16:44.08,1:16:49.12,Default,,0000,0000,0000,,Бұлай жалғаса берсе, Хаул ысырапшы сиқыршыға ұқсайды.
Dialogue: 0,1:16:49.12,1:16:50.12,Default,,0000,0000,0000,,Мұнда.
Dialogue: 0,1:16:55.19,1:16:58.19,Default,,0000,0000,0000,,Саған не болды!?
Dialogue: 0,1:17:00.23,1:17:05.11,Default,,0000,0000,0000,,Мен оны нағыз жасына қайтардым. Ол енді сиқырлы күшке ие емес.
Dialogue: 0,1:17:05.11,1:17:09.33,Default,,0000,0000,0000,,Ол кісі де ертеде өте керемет сиқыршы болған.
Dialogue: 0,1:17:09.33,1:17:11.85,Default,,0000,0000,0000,,Шайтанмен мәміле жаса →
Dialogue: 0,1:17:11.85,1:17:16.22,Default,,0000,0000,0000,,Ұзақ уақыт бойы тән де, жан да жұтылды.
Dialogue: 0,1:17:16.22,1:17:20.10,Default,,0000,0000,0000,,Қазір патшалық көлеңкелі сиқыршылармен және бақсылармен айналысады→
Dialogue: 0,1:17:20.10,1:17:22.12,Default,,0000,0000,0000,,Белгісіз қалдыруға болмайды.
Dialogue: 0,1:17:22.12,1:17:25.99,Default,,0000,0000,0000,,Егер Хаул мұнда патшалыққа қызмет ету үшін келсе→
Dialogue: 0,1:17:25.99,1:17:28.02,Default,,0000,0000,0000,,Мен саған шайтанмен байланысты үзуді үйретемін.
Dialogue: 0,1:17:28.02,1:17:33.90,Default,,0000,0000,0000,,Келмесең, мен де сол әйел сияқты сенің билігіңді тартып аламын.
Dialogue: 0,1:17:33.90,1:17:36.10,Default,,0000,0000,0000,,Сөздеріңізге келсек... Хин!
Dialogue: 0,1:17:36.10,1:17:40.13,Default,,0000,0000,0000,,Енді мен Хаулдың неге мұнда келгісі келмейтінін түсіндім.
Dialogue: 0,1:17:40.13,1:17:44.18,Default,,0000,0000,0000,,Бұл біртүрлі. Шақыру кезінде қарт адамды баспалдақпен көтеру →
Dialogue: 0,1:17:44.18,1:17:47.21,Default,,0000,0000,0000,,Оны бейтаныс бөлмеге апару - тұзақ сияқты.
Dialogue: 0,1:17:47.21,1:17:50.06,Default,,0000,0000,0000,,Улайдың жүрегі жоқ па?
Dialogue: 0,1:17:50.06,1:17:54.94,Default,,0000,0000,0000,,Сенің өзімшіл, қорқақ екенің рас, не ойлайтыныңды білмеймін.
Dialogue: 0,1:17:54.94,1:17:58.14,Default,,0000,0000,0000,,Бірақ ол адам тура айтады. Ол тек еркін өмір сүргісі келеді.
Dialogue: 0,1:17:58.14,1:18:00.17,Default,,0000,0000,0000,,Айқай да келмейді, жын патша да келмейді.
Dialogue: 0,1:18:00.17,1:18:03.03,Default,,0000,0000,0000,,Мен міндетті түрде шайтанмен өзім айналысамын.
Dialogue: 0,1:18:03.03,1:18:06.06,Default,,0000,0000,0000,,Мен сенемін.
Dialogue: 0,1:18:06.06,1:18:09.09,Default,,0000,0000,0000,,Мама, сен Хаулға ғашықсың.
Dialogue: 0,1:18:09.09,1:18:13.46,Default,,0000,0000,0000,,Айқай... Уай келе ме?
Dialogue: 0,1:18:13.46,1:18:16.99,Default,,0000,0000,0000,,Мен Хаулдың жүрегін қалаймын.
Dialogue: 0,1:18:16.99,1:18:20.99,Default,,0000,0000,0000,,Уайымдама, Хаул келмейді.
Dialogue: 0,1:18:21.04,1:18:27.04,Default,,0000,0000,0000,,Айқай келе жатыр. Мен Хаулдың әлсіздігін таптым.
Dialogue: 0,1:18:33.67,1:18:36.03,Default,,0000,0000,0000,,Мәртебелі Король. Жоқ, дәл солай.
Dialogue: 0,1:18:36.03,1:18:39.06,Default,,0000,0000,0000,,Сіз қалай ойлайсыз? Денеңізді қалай сезінесіз? Уақыт бөлгеніңізге рахмет.
Dialogue: 0,1:18:39.06,1:18:43.93,Default,,0000,0000,0000,,Кездесу жай ғана дем алудың қызықсыз жолы болды.
Dialogue: 0,1:18:43.93,1:18:46.96,Default,,0000,0000,0000,,Міне, сол. Бұл адамдар кімдер?
Dialogue: 0,1:18:46.96,1:18:50.96,Default,,0000,0000,0000,,Ол сиқыршы Хаулдың анасы. Оу.
Dialogue: 0,1:18:54.04,1:18:59.26,Default,,0000,0000,0000,,Кешіріңіз, бірақ мен сиқырмен шайқаста жеңгім келмейді.
Dialogue: 0,1:18:59.26,1:19:04.97,Default,,0000,0000,0000,,Расында да, Сүлиманның құдіретінің арқасында бұл патша сарайына жау бомбалары тимейді.
Dialogue: 0,1:19:04.97,1:19:07.17,Default,,0000,0000,0000,,Оның орнына ол айналадағы қалаларға түседі.
Dialogue: 0,1:19:07.17,1:19:10.53,Default,,0000,0000,0000,,Сиқыр деген осы, Сүлиман.
Dialogue: 0,1:19:10.53,1:19:12.06,Default,,0000,0000,0000,,Мәртебелі бүгін өте шешен.
Dialogue: 0,1:19:12.06,1:19:14.24,Default,,0000,0000,0000,,Сәлиман!
Dialogue: 0,1:19:14.24,1:19:16.09,Default,,0000,0000,0000,,Ә!?
Dialogue: 0,1:19:16.09,1:19:21.14,Default,,0000,0000,0000,,Бұл шешуші шайқас! Мен оны бұл жолы талқандаймын!
Dialogue: 0,1:19:21.14,1:19:24.00,Default,,0000,0000,0000,,Осы жолы соңына дейін шайқасамын!
Dialogue: 0,1:19:24.00,1:19:27.03,Default,,0000,0000,0000,,Сүлиман Жаңа Қагемүша жақсы жасалған.
Dialogue: 0,1:19:27.03,1:19:29.56,Default,,0000,0000,0000,,Жақсы жаңалық күтіңіз. Уақыт бөлгеніңізге рахмет.
Dialogue: 0,1:19:29.56,1:19:32.56,Default,,0000,0000,0000,,Генералдар жиналды ма? иә.
Dialogue: 0,1:19:35.28,1:19:38.31,Default,,0000,0000,0000,,Айқайлау Біраз уақыт өтті.
Dialogue: 0,1:19:38.31,1:19:41.17,Default,,0000,0000,0000,,Мұғаліміңіздің де жақсы болғанына қуаныштымын.
Dialogue: 0,1:19:41.17,1:19:43.19,Default,,0000,0000,0000,,Мен оны әу бастан білдім.
Dialogue: 0,1:19:43.19,1:19:45.05,Default,,0000,0000,0000,,Мен берген антымды орындадым.
Dialogue: 0,1:19:45.05,1:19:49.26,Default,,0000,0000,0000,,Мен сенімен ұрысқым келмейді. Мен анамды өзіммен бірге алып кетемін.
Dialogue: 0,1:19:49.26,1:19:52.78,Default,,0000,0000,0000,,Мен сенің қашып кетуіңе жол бермеймін.
Dialogue: 0,1:19:52.78,1:20:07.10,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:20:07.10,1:20:12.15,Default,,0000,0000,0000,,～ ～
Dialogue: 0,1:20:12.15,1:20:15.52,Default,,0000,0000,0000,,～
Dialogue: 0,1:20:15.52,1:20:20.23,Default,,0000,0000,0000,,Анаңа шынайы болмысыңды көрсетейік.
Dialogue: 0,1:20:20.23,1:20:31.01,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:20:31.01,1:20:33.20,Default,,0000,0000,0000,,～ …
Dialogue: 0,1:20:33.20,1:20:53.23,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:20:53.23,1:21:03.00,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:21:03.00,1:21:05.18,Default,,0000,0000,0000,,～ …
Dialogue: 0,1:21:05.18,1:21:08.21,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:21:08.21,1:21:12.08,Default,,0000,0000,0000,,～ ～
Dialogue: 0,1:21:12.08,1:21:14.10,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:21:14.10,1:21:16.13,Default,,0000,0000,0000,,～
Dialogue: 0,1:21:16.13,1:21:22.13,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:21:29.25,1:21:30.25,Default,,0000,0000,0000,,Күте тұрыңыз.
Dialogue: 0,1:21:32.11,1:21:33.11,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:21:38.17,1:21:40.17,Default,,0000,0000,0000,,Софи, алға ұмтыл.
Dialogue: 0,1:21:41.20,1:21:46.92,Default,,0000,0000,0000,,А, Софи барлығын алып келді.
Dialogue: 0,1:21:46.92,1:21:48.11,Default,,0000,0000,0000,,Ит. Хин!
Dialogue: 0,1:21:48.11,1:21:51.14,Default,,0000,0000,0000,,Хмф! Сіз Сәлиманның ұйымдастырушысысыз, солай ма?
Dialogue: 0,1:21:51.14,1:21:54.17,Default,,0000,0000,0000,,Оған көмектесу мүмкін емес. Мен оны қазір түсіре алмаймын.
Dialogue: 0,1:21:54.17,1:21:58.05,Default,,0000,0000,0000,,Софи, рульді қолға ал. Не!? Мен мұны істей алмаймын.
Dialogue: 0,1:21:58.05,1:22:00.05,Default,,0000,0000,0000,,Ол мені қуды.
Dialogue: 0,1:22:05.78,1:22:07.14,Default,,0000,0000,0000,,Мен Софимен → солай айналысамын
Dialogue: 0,1:22:07.14,1:22:10.17,Default,,0000,0000,0000,,Шөл даладағы қамалға ұшыңыз. Аа!? Бұл мүмкін емес!
Dialogue: 0,1:22:10.17,1:22:13.03,Default,,0000,0000,0000,,Уайымдамаңыз, сақина сізге бағытты айтады.
Dialogue: 0,1:22:13.03,1:22:16.05,Default,,0000,0000,0000,,Жүрегіңіздегі Кальциферді шақырыңыз.
Dialogue: 0,1:22:16.05,1:22:18.05,Default,,0000,0000,0000,,Кальцифер?
Dialogue: 0,1:22:21.10,1:22:22.10,Default,,0000,0000,0000,,Жарқ етті!
Dialogue: 0,1:22:23.63,1:22:26.99,Default,,0000,0000,0000,,Жарық түсетін жерге ұшып барыңыз, сонда сіз түнде жетесіз.
Dialogue: 0,1:22:26.99,1:22:30.03,Default,,0000,0000,0000,,Қазірдің өзінде! Егер Хаул келе жатса, мен келмейтін едім!
Dialogue: 0,1:22:30.03,1:22:32.05,Default,,0000,0000,0000,,Мен бара алдым, өйткені Софи сонда болады деп ойладым.
Dialogue: 0,1:22:32.05,1:22:35.08,Default,,0000,0000,0000,,Мұндай қорқынышты адамға жалғыз баруға бола ма?
Dialogue: 0,1:22:35.08,1:22:40.13,Default,,0000,0000,0000,,Сіздің арқаңызда мен құтқарылдым. Бұл дәл қазір өте қауіпті болды.
Dialogue: 0,1:22:40.13,1:22:45.13,Default,,0000,0000,0000,,Ах! Мені жіберме!
Dialogue: 0,1:22:50.23,1:22:52.23,Default,,0000,0000,0000,,Бұл дәмді емес пе! Қайда!
Dialogue: 0,1:22:54.10,1:22:56.29,Default,,0000,0000,0000,,Мен аздап тартып қалдым.
Dialogue: 0,1:22:56.29,1:22:59.29,Default,,0000,0000,0000,,Мен сені 5 минутқа көрінбейтін етіп жасаймын, сол уақыт ішінде бар.
Dialogue: 0,1:23:01.00,1:23:04.00,Default,,0000,0000,0000,,Ех! Айқай!
Dialogue: 0,1:23:07.90,1:23:09.90,Default,,0000,0000,0000,,Жоқ, яғни, ол қайда…
Dialogue: 0,1:23:15.99,1:23:18.17,Default,,0000,0000,0000,,Жоқ, маған керегі жоқ.
Dialogue: 0,1:23:18.17,1:23:20.19,Default,,0000,0000,0000,,Иә, рахмет.
Dialogue: 0,1:23:20.19,1:23:22.05,Default,,0000,0000,0000,,Менің толқығаныма біраз болды.
Dialogue: 0,1:23:22.05,1:23:25.08,Default,,0000,0000,0000,,Уол қашып кеткен болуы керек.
Dialogue: 0,1:23:25.08,1:23:29.28,Default,,0000,0000,0000,,Хехе, ол өте жас ана болатын.
Dialogue: 0,1:23:29.28,1:23:46.12,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:23:46.12,1:23:47.97,Default,,0000,0000,0000,,～
Dialogue: 0,1:23:47.97,1:23:53.97,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:24:10.03,1:24:11.03,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:24:19.12,1:24:22.12,Default,,0000,0000,0000,,Жақында келеді. Бұл мен туған қала.
Dialogue: 0,1:24:23.00,1:24:25.01,Default,,0000,0000,0000,,Хин!
Dialogue: 0,1:24:25.01,1:24:29.01,Default,,0000,0000,0000,,Таныс қылық жасама, мен саған сенбеймін.
Dialogue: 0,1:24:52.12,1:24:55.12,Default,,0000,0000,0000,,Бұл қамал! Ол мені алып кетуге келді! Хин!
Dialogue: 0,1:24:59.35,1:25:02.05,Default,,0000,0000,0000,,Софи!
Dialogue: 0,1:25:02.05,1:25:06.05,Default,,0000,0000,0000,,Markl Керемет! Мен оны қалай тоқтату керектігін білмеймін!
Dialogue: 0,1:25:18.04,1:25:20.06,Default,,0000,0000,0000,,Софи!
Dialogue: 0,1:25:20.06,1:25:22.08,Default,,0000,0000,0000,,Ит.
Dialogue: 0,1:25:22.08,1:25:23.09,Default,,0000,0000,0000,,Хин!
Dialogue: 0,1:25:23.09,1:25:25.11,Default,,0000,0000,0000,,Маркл!
Dialogue: 0,1:25:25.11,1:25:27.97,Default,,0000,0000,0000,,Мен үйдемін!
Dialogue: 0,1:25:27.97,1:25:30.00,Default,,0000,0000,0000,,Софи, сен ауырып қалдың ба? Ой...
Dialogue: 0,1:25:30.00,1:25:34.00,Default,,0000,0000,0000,,Керемет! Мені алып кетуге келгеніңіз үшін рахмет.
Dialogue: 0,1:28:35.85,1:28:43.85,Default,,0000,0000,0000,,
Dialogue: 0,1:28:47.13,1:28:49.13,Default,,0000,0000,0000,,(есік жабылған дыбыс)
Dialogue: 0,1:28:56.89,1:29:00.89,Default,,0000,0000,0000,,Жоқ, бұл тым көп.
Dialogue: 0,1:29:09.01,1:29:16.92,Default,,0000,0000,0000,,(баспалдақпен көтерілу дыбысы)
Dialogue: 0,1:29:16.92,1:29:18.77,Default,,0000,0000,0000,,(есік жабылған дыбыс)
Dialogue: 0,1:29:18.77,1:29:21.77,Default,,0000,0000,0000,,Мен Хаул қайтып келді ме деп ойлаймын...
Dialogue: 0,1:29:24.00,1:29:31.24,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:29:31.24,1:29:33.59,Default,,0000,0000,0000,,～
Dialogue: 0,1:29:33.59,1:29:52.79,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:29:52.79,1:30:03.05,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:30:03.05,1:30:15.84,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:30:15.84,1:30:17.20,Default,,0000,0000,0000,,～
Dialogue: 0,1:30:17.20,1:30:37.06,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:30:37.06,1:30:48.84,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:30:48.84,1:30:54.90,Default,,0000,0000,0000,,～ （）
Dialogue: 0,1:30:54.90,1:30:57.76,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:30:57.76,1:31:04.33,Default,,0000,0000,0000,,～ （）
Dialogue: 0,1:31:04.33,1:31:06.69,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:31:06.69,1:31:19.98,Default,,0000,0000,0000,,～ （）
Dialogue: 0,1:31:19.98,1:31:22.01,Default,,0000,0000,0000,,Айқай? Айқай.
Dialogue: 0,1:31:22.01,1:31:24.03,Default,,0000,0000,0000,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,1:31:24.03,1:31:27.06,Default,,0000,0000,0000,,Бұл ауырады ма? Сіз жарақат алдыңыз.
Dialogue: 0,1:31:27.06,1:31:29.25,Default,,0000,0000,0000,,Келме...
Dialogue: 0,1:31:29.25,1:31:31.60,Default,,0000,0000,0000,,Мен сізге көмектескім келеді.
Dialogue: 0,1:31:31.60,1:31:34.97,Default,,0000,0000,0000,,Мен саған айтылған қарғысты алып тастағым келеді!
Dialogue: 0,1:31:34.97,1:31:38.01,Default,,0000,0000,0000,,Сіз тіпті өз қарғысыңызды бұза алмайсыз.
Dialogue: 0,1:31:38.01,1:31:40.87,Default,,0000,0000,0000,,Себебі мен сені жақсы көремін!
Dialogue: 0,1:31:40.87,1:31:43.06,Default,,0000,0000,0000,,Бетінде бір атмосфера.
Dialogue: 0,1:31:43.06,1:31:45.06,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:31:46.76,1:31:48.76,Default,,0000,0000,0000,,Айқай!
Dialogue: 0,1:32:01.07,1:32:03.92,Default,,0000,0000,0000,,Айқай Сен қайтып келдің.
Dialogue: 0,1:32:03.92,1:32:07.80,Default,,0000,0000,0000,,Софи, Оила мен Хаул арасындағы келісім-шарттың құпиясын тез ашыңыз.
Dialogue: 0,1:32:07.80,1:32:10.99,Default,,0000,0000,0000,,Балалар, бізде енді уақыт жоқ.
Dialogue: 0,1:32:10.99,1:32:13.02,Default,,0000,0000,0000,,Бұл Хоулдың жын патшасы болатынын білдіре ме? Солай ма?
Dialogue: 0,1:32:13.02,1:32:17.02,Default,,0000,0000,0000,,Сіз мұны айта аласыз ба? Сен шайтансың.
Dialogue: 0,1:32:18.91,1:32:21.10,Default,,0000,0000,0000,,Калсифер Сулиман → деді
Dialogue: 0,1:32:21.10,1:32:24.80,Default,,0000,0000,0000,,Хаул сізге маңызды нәрсе берді.
Dialogue: 0,1:32:24.80,1:32:26.99,Default,,0000,0000,0000,,Бұл не? бұл қайда?
Dialogue: 0,1:32:26.99,1:32:29.02,Default,,0000,0000,0000,,Мен келісім-шарттың құпиясы туралы айта алмаймын.
Dialogue: 0,1:32:29.02,1:32:31.87,Default,,0000,0000,0000,,Мен сені сумен қорқытсам ше?
Dialogue: 0,1:32:31.87,1:32:34.87,Default,,0000,0000,0000,,Не болды! Сонда Хаул да өледі!
Dialogue: 0,1:32:54.93,1:32:58.93,Default,,0000,0000,0000,,Қайырлы таң Балапан, сен батыл болуың керек.
Dialogue: 0,1:33:01.67,1:33:04.03,Default,,0000,0000,0000,,Софи Жақсы!
Dialogue: 0,1:33:04.03,1:33:07.90,Default,,0000,0000,0000,,Иә! Калсифер, аузыңды көбірек аш!
Dialogue: 0,1:33:07.90,1:33:11.94,Default,,0000,0000,0000,,Кеттік! Міне бітті!
Dialogue: 0,1:33:11.94,1:33:13.94,Default,,0000,0000,0000,,(Наширо) Рей (Джузо Сузуя) Хм?
Dialogue: 0,1:33:21.70,1:33:27.93,Default,,0000,0000,0000,,У... жүр... к... на... қазірдің өзінде... қазірдің өзінде!
Dialogue: 0,1:33:27.93,1:33:29.93,Default,,0000,0000,0000,,Уа... аааа!
Dialogue: 0,1:33:32.82,1:33:34.82,Default,,0000,0000,0000,,Ой~!
Dialogue: 0,1:33:35.85,1:33:38.85,Default,,0000,0000,0000,,Ой~!
Dialogue: 0,1:33:46.95,1:33:48.98,Default,,0000,0000,0000,,Осы жолы соңына дейін шайқасамын!
Dialogue: 0,1:33:48.98,1:33:52.98,Default,,0000,0000,0000,,Қамалдың ішінен қарасаң, бұл жәй ғана қоқыс жинағы.
Dialogue: 0,1:33:55.04,1:33:58.04,Default,,0000,0000,0000,,Барлығына! Мен оны кешкі асқа аламын!
Dialogue: 0,1:34:04.63,1:34:05.81,Default,,0000,0000,0000,,Иә, әже.
Dialogue: 0,1:34:05.81,1:34:09.85,Default,,0000,0000,0000,,Софи Маған бұл ұнамайды, ол қалдықтардың сиқыршысы.
Dialogue: 0,1:34:09.85,1:34:11.04,Default,,0000,0000,0000,,Қазір бәрі жақсы.
Dialogue: 0,1:34:11.04,1:34:13.89,Default,,0000,0000,0000,,Мен саған қарап тұрмын.
Dialogue: 0,1:34:13.89,1:34:16.89,Default,,0000,0000,0000,,Бұл әдемі от. (Кальцифер) Уф.
Dialogue: 0,1:34:18.94,1:34:21.30,Default,,0000,0000,0000,,Айқай! Бәріңе сәлем!
Dialogue: 0,1:34:21.30,1:34:22.65,Default,,0000,0000,0000,,Қайтадан қош келдіңіз.
Dialogue: 0,1:34:22.65,1:34:24.84,Default,,0000,0000,0000,,Хаул мырза, сіз бұл итті ұстай аласыз, солай ма?
Dialogue: 0,1:34:24.84,1:34:27.87,Default,,0000,0000,0000,,Бақсының әжесіне Сәлиман доктордың иті қандай?
Dialogue: 0,1:34:27.87,1:34:30.90,Default,,0000,0000,0000,,Калсифер Сіз құлыпта жақсы өнер көрсеттіңіз.
Dialogue: 0,1:34:30.90,1:34:34.77,Default,,0000,0000,0000,,Қалжың емес, бүкіл Софи секіріп кетті!
Dialogue: 0,1:34:34.77,1:34:37.96,Default,,0000,0000,0000,,Хахахаха! Хмф.
Dialogue: 0,1:34:37.96,1:34:40.15,Default,,0000,0000,0000,,Сіз мұны тағы да жарқыраған түрде жасадыңыз.
Dialogue: 0,1:34:40.15,1:34:42.15,Default,,0000,0000,0000,,Ей, сен шалқансың.
Dialogue: 0,1:34:43.86,1:34:47.89,Default,,0000,0000,0000,,Хмм, сізде де күрделі қарғыс бар.
Dialogue: 0,1:34:47.89,1:34:50.92,Default,,0000,0000,0000,,Менің отбасым күрделі адамдарға толы.
Dialogue: 0,1:34:50.92,1:34:52.78,Default,,0000,0000,0000,,Ол жақсы жігіт.
Dialogue: 0,1:34:52.78,1:34:56.98,Default,,0000,0000,0000,,Ал, мен бүгін бос емеспін. Мен қозғаламын!
Dialogue: 0,1:34:56.98,1:34:58.00,Default,,0000,0000,0000,,Жылжыту? жақсы.
Dialogue: 0,1:34:58.00,1:35:00.86,Default,,0000,0000,0000,,Сіз тек сарайда ғана дүкен аралай алмайсыз.
Dialogue: 0,1:35:00.86,1:35:04.57,Default,,0000,0000,0000,,Осы жерде қалсаңыз, Сүлиман доктор сізді бірден тауып алады.
Dialogue: 0,1:35:04.57,1:35:09.57,Default,,0000,0000,0000,,Сіз осында қалуыңыз керек. Сіздің сиқырлы күшіңіз тым күшті.
Dialogue: 0,1:35:15.00,1:35:16.86,Default,,0000,0000,0000,,Жарайды, дайын.
Dialogue: 0,1:35:16.86,1:35:19.05,Default,,0000,0000,0000,,Кальцифер жақсы!
Dialogue: 0,1:35:19.05,1:35:33.86,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:35:33.86,1:35:37.86,Default,,0000,0000,0000,,Жарайсың, жарайсың. Біраз уақыт сонда болыңыз.
Dialogue: 0,1:35:40.09,1:35:43.09,Default,,0000,0000,0000,,Мұны тыныш орындаңыз...
Dialogue: 0,1:35:45.98,1:35:47.98,Default,,0000,0000,0000,,бастайық.
Dialogue: 0,1:35:53.89,1:35:56.92,Default,,0000,0000,0000,,Гуаааа!
Dialogue: 0,1:35:56.92,1:35:58.92,Default,,0000,0000,0000,,Ах. Ах.
Dialogue: 0,1:36:00.79,1:36:02.79,Default,,0000,0000,0000,,Ах! Апыр-ай!
Dialogue: 0,1:36:07.02,1:36:09.02,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:36:30.92,1:36:32.94,Default,,0000,0000,0000,,Уау! иә?
Dialogue: 0,1:36:32.94,1:36:35.64,Default,,0000,0000,0000,,Қозғалыс аяқталды. Қазір төмен түсуге болады.
Dialogue: 0,1:36:35.64,1:36:40.02,Default,,0000,0000,0000,,Уау! Уау, ұстаз, өте кең!
Dialogue: 0,1:36:40.02,1:36:42.02,Default,,0000,0000,0000,,Бұл әдемі от.
Dialogue: 0,1:36:45.91,1:36:47.91,Default,,0000,0000,0000,,Капитан Магатоға не деп тұрсың!!
Dialogue: 0,1:36:48.94,1:36:53.94,Default,,0000,0000,0000,,(Пойыз ысқырығы)
Dialogue: 0,1:36:56.68,1:36:57.87,Default,,0000,0000,0000,,Мұнда...
Dialogue: 0,1:36:57.87,1:37:01.74,Default,,0000,0000,0000,,Отбасым көбейгендіктен мен де әжетхана салдым.
Dialogue: 0,1:37:01.74,1:37:05.74,Default,,0000,0000,0000,,Софи, мұнда кел! Софи!
Dialogue: 0,1:37:08.80,1:37:11.80,Default,,0000,0000,0000,,Біз тағы бір бөлме қостық. Ішке кір.
Dialogue: 0,1:37:17.89,1:37:19.89,Default,,0000,0000,0000,,Аа….
Dialogue: 0,1:37:21.77,1:37:23.96,Default,,0000,0000,0000,,Міне... неге?
Dialogue: 0,1:37:23.96,1:37:27.83,Default,,0000,0000,0000,,Софидің бөлмесі туралы не ойлайсың? Ол саған ұнайды ма?
Dialogue: 0,1:37:27.83,1:37:32.04,Default,,0000,0000,0000,,Иә, бұл тазалықшы әйел үшін тамаша бөлме.
Dialogue: 0,1:37:32.04,1:37:35.74,Default,,0000,0000,0000,,Мен де ауыстыратын киім алдым, кейін қараймын... Келесі!
Dialogue: 0,1:37:35.74,1:37:38.94,Default,,0000,0000,0000,,Софи, мұнда кел! тез!
Dialogue: 0,1:37:38.94,1:37:42.81,Default,,0000,0000,0000,,Аула! Хахаха! Дүкендер де бар.
Dialogue: 0,1:37:42.81,1:37:45.84,Default,,0000,0000,0000,,Хин! барайық! Софи!
Dialogue: 0,1:37:45.84,1:37:48.84,Default,,0000,0000,0000,,Есіктің түсі өзгерді, сондықтан бұл жаңа шығу.
Dialogue: 0,1:37:51.90,1:37:54.90,Default,,0000,0000,0000,,Софиге сыйлық.
Dialogue: 0,1:40:09.95,1:40:11.95,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:40:12.98,1:40:27.96,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:40:27.96,1:40:30.15,Default,,0000,0000,0000,,Менің құпия бақшам.
Dialogue: 0,1:40:30.15,1:40:32.15,Default,,0000,0000,0000,,Бұл тамаша...
Dialogue: 0,1:40:34.02,1:40:37.05,Default,,0000,0000,0000,,Бұл да Хаулдың сиқыры ма?
Dialogue: 0,1:40:37.05,1:40:40.05,Default,,0000,0000,0000,,Гүлдерге көмектесу үшін.
Dialogue: 0,1:40:45.80,1:40:47.80,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:40:49.01,1:40:53.05,Default,,0000,0000,0000,,Улау Рахмет! Бұл арман сияқты!
Dialogue: 0,1:40:53.05,1:41:03.32,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:41:03.32,1:41:16.11,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:41:16.11,1:41:17.11,Default,,0000,0000,0000,,Софи.
Dialogue: 0,1:41:18.97,1:41:23.01,Default,,0000,0000,0000,,Бұл біртүрлі. Мен бұрын осында болғандай сезінемін.
Dialogue: 0,1:41:23.01,1:41:25.20,Default,,0000,0000,0000,,Көз жасы ағып кетті.
Dialogue: 0,1:41:25.20,1:41:28.20,Default,,0000,0000,0000,,Келіңіздер. Иә.
Dialogue: 0,1:41:34.97,1:41:37.97,Default,,0000,0000,0000,,Қараңыз. Жақсы!
Dialogue: 0,1:41:41.03,1:41:45.07,Default,,0000,0000,0000,,Шағын үй. Бұл менің қымбат баспанам.
Dialogue: 0,1:41:45.07,1:41:49.07,Default,,0000,0000,0000,,Бала күнімде көп жазда жалғыз тұратынмын.
Dialogue: 0,1:41:51.46,1:41:53.98,Default,,0000,0000,0000,,Жалғыз ба?
Dialogue: 0,1:41:53.98,1:41:57.19,Default,,0000,0000,0000,,Бұл сиқыршы ағам маған жасырын тастап кеткен саятшылық.
Dialogue: 0,1:41:57.19,1:42:00.19,Default,,0000,0000,0000,,Софиді қалауыңызша пайдалана аласыз.
Dialogue: 0,1:42:03.25,1:42:04.93,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,1:42:04.93,1:42:07.29,Default,,0000,0000,0000,,Қорқынышты... Мен саятшылыққа барғанда→
Dialogue: 0,1:42:07.29,1:42:10.29,Default,,0000,0000,0000,,Мен Хаулдың бір жерге бара жатқанын сеземін.
Dialogue: 0,1:42:12.50,1:42:14.03,Default,,0000,0000,0000,,Айқай, маған шындықты айт.
Dialogue: 0,1:42:14.03,1:42:18.03,Default,,0000,0000,0000,,Мен Хаулдың құбыжық екеніне қарсы емеспін.
Dialogue: 0,1:42:22.95,1:42:26.15,Default,,0000,0000,0000,,Мен Софи мен басқалардың бейбіт өмір сүргенін қалаймын.
Dialogue: 0,1:42:26.15,1:42:31.03,Default,,0000,0000,0000,,Сіз осы жерден гүл теріп, гүл дүкенін басқара аласыз ба?
Dialogue: 0,1:42:31.03,1:42:34.06,Default,,0000,0000,0000,,Эй, Софи мұны жақсы істей алады.
Dialogue: 0,1:42:34.06,1:42:36.06,Default,,0000,0000,0000,,Сонда Хаул кете ме?
Dialogue: 0,1:42:38.60,1:42:41.13,Default,,0000,0000,0000,,Мен Хаулға көмектескім келеді.
Dialogue: 0,1:42:41.13,1:42:45.17,Default,,0000,0000,0000,,Мен әдемі емеспін және тек тазалаумен ғана айналыса аламын...
Dialogue: 0,1:42:45.17,1:42:48.17,Default,,0000,0000,0000,,Софи! Софи әдемі!
Dialogue: 0,1:42:52.07,1:42:56.07,Default,,0000,0000,0000,,Қартайғанның жақсы жағы - көп жоғалтпайсың.
Dialogue: 0,1:43:09.24,1:43:11.10,Default,,0000,0000,0000,,Осындай жерден өткеніме сене алар емеспін.
Dialogue: 0,1:43:11.10,1:43:14.96,Default,,0000,0000,0000,,Әскери кеме? Мен қалалар мен адамдарды өртеп жіберемін.
Dialogue: 0,1:43:14.96,1:43:17.96,Default,,0000,0000,0000,,Жау? Одақтас па? Бұл кез келген жағдайда бірдей нәрсе.
Dialogue: 0,1:43:30.29,1:43:32.29,Default,,0000,0000,0000,,Сіз кісі өлтірушілер...
Dialogue: 0,1:43:39.20,1:43:42.20,Default,,0000,0000,0000,,Қараңдаршы, қаншама бомба ілінген.
Dialogue: 0,1:43:53.02,1:43:58.06,Default,,0000,0000,0000,,(Дабыл)
Dialogue: 0,1:43:58.06,1:44:01.09,Default,,0000,0000,0000,,Бұл тоқтады Хаул жасады ма?
Dialogue: 0,1:44:01.09,1:44:04.09,Default,,0000,0000,0000,,Мен онымен аздап араластым, бірақ ол түспейді.
Dialogue: 0,1:44:06.98,1:44:08.33,Default,,0000,0000,0000,,Айқай!
Dialogue: 0,1:44:08.33,1:44:11.86,Default,,0000,0000,0000,,Ой, байқадың ба деп ойлаймын.
Dialogue: 0,1:44:11.86,1:44:20.12,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:44:20.12,1:44:22.14,Default,,0000,0000,0000,,Сәлиман мырзаның астары.
Dialogue: 0,1:44:22.14,1:44:26.14,Default,,0000,0000,0000,,Қайтейік! Жүгір! Аяғыңызды жылжытыңыз!
Dialogue: 0,1:44:27.02,1:44:29.04,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:44:29.04,1:44:40.15,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:44:40.15,1:44:44.02,Default,,0000,0000,0000,,Сол жаққа жүгір! Жоқ, мені жіберме!
Dialogue: 0,1:44:44.02,1:44:50.02,Default,,0000,0000,0000,,Ахх!
Dialogue: 0,1:44:52.11,1:44:54.29,Default,,0000,0000,0000,,Софи, не болды?
Dialogue: 0,1:44:54.29,1:44:57.29,Default,,0000,0000,0000,,Ауырды... Мен бұл үйден кетемін!
Dialogue: 0,1:45:04.05,1:45:05.05,Default,,0000,0000,0000,,
Dialogue: 0,1:45:06.92,1:45:10.92,Default,,0000,0000,0000,,Софи Қайырлы түн. қайырлы түн.
Dialogue: 0,1:45:12.13,1:45:15.16,Default,,0000,0000,0000,,Софи Хоулға алаңдаудың қажеті жоқ.
Dialogue: 0,1:45:15.16,1:45:17.02,Default,,0000,0000,0000,,Өйткені мен бұған дейін көп күн болмағанмын.
Dialogue: 0,1:45:17.02,1:45:20.55,Default,,0000,0000,0000,,Рахмет Маркл.
Dialogue: 0,1:45:20.55,1:45:22.07,Default,,0000,0000,0000,,Дәретхана қайда орналасқан? Жарайды.
Dialogue: 0,1:45:22.07,1:45:24.26,Default,,0000,0000,0000,,Қайырлы түн.
Dialogue: 0,1:45:24.26,1:45:26.26,Default,,0000,0000,0000,,Бұл махаббат.
Dialogue: 0,1:45:27.96,1:45:31.96,Default,,0000,0000,0000,,Біраздан бері күрсініп жүрсің.
Dialogue: 0,1:45:34.02,1:45:36.02,Default,,0000,0000,0000,,Аа...
Dialogue: 0,1:45:43.12,1:45:45.14,Default,,0000,0000,0000,,Бұл жұлдыз.
Dialogue: 0,1:45:45.14,1:45:48.16,Default,,0000,0000,0000,,Әже, сіз ғашық болып көрдіңіз бе?
Dialogue: 0,1:45:48.16,1:45:51.02,Default,,0000,0000,0000,,Дұрыс. Мен әлі де істеп жатырмын.
Dialogue: 0,1:45:51.02,1:45:52.04,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:45:52.04,1:45:58.43,Default,,0000,0000,0000,,Еркек болғасын қолыңнан ештеңе келмейді, Жас жүрек жақсы!
Dialogue: 0,1:45:58.43,1:46:00.79,Default,,0000,0000,0000,,Мен таң қалдым.
Dialogue: 0,1:46:00.79,1:46:02.97,Default,,0000,0000,0000,,Оның үстіне сүйкімді.
Dialogue: 0,1:46:02.97,1:46:06.17,Default,,0000,0000,0000,,
Dialogue: 0,1:46:06.17,1:46:10.05,Default,,0000,0000,0000,,Бірдеңе... Бұл әуе шабуылы туралы ескерту.
Dialogue: 0,1:46:10.05,1:46:12.07,Default,,0000,0000,0000,,Әуе шабуылы?
Dialogue: 0,1:46:12.07,1:46:17.29,Default,,0000,0000,0000,,Бұл қалада емес, бірақ бүгін кешке шықпау керек.
Dialogue: 0,1:46:17.29,1:46:23.29,Default,,0000,0000,0000,,Сүлиманның қолбасшылары бұл үйді әр жерден тінтіп жүр.
Dialogue: 0,1:46:25.03,1:46:30.03,Default,,0000,0000,0000,,Бұл жақсы от. Бұл үйді жақсы жасырады.
Dialogue: 0,1:47:00.55,1:47:02.55,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:47:05.26,1:47:08.26,Default,,0000,0000,0000,,Софи! Біртүрлі адам кіріп келді!
Dialogue: 0,1:47:15.20,1:47:16.21,Default,,0000,0000,0000,,(Хироко) Шынымен бе? (Косэй) Иә.
Dialogue: 0,1:47:16.21,1:47:19.40,Default,,0000,0000,0000,,Софи!!
Dialogue: 0,1:47:19.40,1:47:20.58,Default,,0000,0000,0000,,Уау! Апыр-ай!
Dialogue: 0,1:47:20.58,1:47:24.12,Default,,0000,0000,0000,,Қайда болдың!? Мен сені іздедім!
Dialogue: 0,1:47:24.12,1:47:27.32,Default,,0000,0000,0000,,Міне, мен әже болдым!
Dialogue: 0,1:47:27.32,1:47:31.02,Default,,0000,0000,0000,,Барлығы, мен кінәлімін! Ах!
Dialogue: 0,1:47:31.02,1:47:34.05,Default,,0000,0000,0000,,Кешіріңіз, Софи.
Dialogue: 0,1:47:34.05,1:47:36.24,Default,,0000,0000,0000,,Ана…. Кешіріңіз.
Dialogue: 0,1:47:36.24,1:47:38.43,Default,,0000,0000,0000,,(есіктің ашылған дыбысы)
Dialogue: 0,1:47:38.43,1:47:40.78,Default,,0000,0000,0000,,Сіз толығымен қайта безендірдіңіз.
Dialogue: 0,1:47:40.78,1:47:44.99,Default,,0000,0000,0000,,Бұл адам кім? О, үй иесі.
Dialogue: 0,1:47:44.99,1:47:48.20,Default,,0000,0000,0000,,О, Софи, мен қайта тұрмысқа шықтым! Ха!
Dialogue: 0,1:47:48.20,1:47:51.22,Default,,0000,0000,0000,,Ол өте жақсы адам және бай.
Dialogue: 0,1:47:51.22,1:47:53.08,Default,,0000,0000,0000,,Біз бәріміз қайтадан бірге өмір сүре аламыз.
Dialogue: 0,1:47:53.08,1:47:55.94,Default,,0000,0000,0000,,Эй, сен тазалаушы болудың қажеті жоқ.
Dialogue: 0,1:47:55.94,1:47:59.31,Default,,0000,0000,0000,,Бірақ маған қазіргі өмірім ұнайды.
Dialogue: 0,1:47:59.31,1:48:02.00,Default,,0000,0000,0000,,Сонымен? А, жоқ!
Dialogue: 0,1:48:02.00,1:48:05.03,Default,,0000,0000,0000,,Менің көлігім күтіп тұр. Мен баруым керек.
Dialogue: 0,1:48:05.03,1:48:07.22,Default,,0000,0000,0000,,(аяқ дыбысы)
Dialogue: 0,1:48:07.22,1:48:09.91,Default,,0000,0000,0000,,(есік жабылған дыбыс)
Dialogue: 0,1:48:09.91,1:48:12.94,Default,,0000,0000,0000,,...
Dialogue: 0,1:48:12.94,1:48:15.13,Default,,0000,0000,0000,,...
Dialogue: 0,1:48:15.13,1:48:17.99,Default,,0000,0000,0000,,- Оған дейін сау болыңыз.
Dialogue: 0,1:48:17.99,1:48:18.99,Default,,0000,0000,0000,,Хин!
Dialogue: 0,1:48:23.88,1:48:27.25,Default,,0000,0000,0000,,Тақсыратын Бұг Сулиман да ескі трюкті қолданады.
Dialogue: 0,1:48:27.25,1:48:29.25,Default,,0000,0000,0000,,Каль-чан, өртеп жібер.
Dialogue: 0,1:48:31.12,1:48:33.12,Default,,0000,0000,0000,,Гуах~.
Dialogue: 0,1:48:36.01,1:48:38.03,Default,,0000,0000,0000,,Қалада өмір сүру дегеніміз – көптеген адамдармен кездесу деген сөз
Dialogue: 0,1:48:38.03,1:48:40.22,Default,,0000,0000,0000,,Анашым, бақытты болыңыз.
Dialogue: 0,1:48:40.22,1:48:43.22,Default,,0000,0000,0000,,Саған да рахмет, Софи.
Dialogue: 0,1:48:47.12,1:48:50.15,Default,,0000,0000,0000,,Мен айтқанын орындадым. Мені күйеуіме қайтар.
Dialogue: 0,1:48:50.15,1:48:54.19,Default,,0000,0000,0000,,Иә, Сәлиман профессор өте қуанар еді.
Dialogue: 0,1:48:54.19,1:48:58.19,Default,,0000,0000,0000,,Хмф... Кешіріңіз, Софи.
Dialogue: 0,1:49:01.26,1:49:03.61,Default,,0000,0000,0000,,Қандай керемет адам.
Dialogue: 0,1:49:03.61,1:49:07.15,Default,,0000,0000,0000,,Барлығы қашып кетеді, бүкіл қала қаңырап бос қалады.
Dialogue: 0,1:49:07.15,1:49:09.17,Default,,0000,0000,0000,,Софи де барғысы келеді ме?
Dialogue: 0,1:49:09.17,1:49:10.18,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:49:10.18,1:49:13.04,Default,,0000,0000,0000,,Бұрынғы кісі осылай деді.
Dialogue: 0,1:49:13.04,1:49:16.24,Default,,0000,0000,0000,,Жарайды... Татуласқанымызға қуаныштымын.
Dialogue: 0,1:49:16.24,1:49:19.27,Default,,0000,0000,0000,,Софи, барма!
Dialogue: 0,1:49:19.27,1:49:23.27,Default,,0000,0000,0000,,Мен Софиді жақсы көремін, осында қал.
Dialogue: 0,1:49:24.82,1:49:27.02,Default,,0000,0000,0000,,Мен де Маркл, жарайды, мен бармаймын.
Dialogue: 0,1:49:27.02,1:49:29.04,Default,,0000,0000,0000,,Шынымен бе? иә!
Dialogue: 0,1:49:29.04,1:49:31.23,Default,,0000,0000,0000,,Біз отбасымыз ба?
Dialogue: 0,1:49:31.23,1:49:33.08,Default,,0000,0000,0000,,Иә, отбасы.
Dialogue: 0,1:49:33.08,1:49:35.08,Default,,0000,0000,0000,,Керемет!
Dialogue: 0,1:49:43.51,1:49:46.51,Default,,0000,0000,0000,,Мен Хаулды Сулиманға бермеймін.
Dialogue: 0,1:49:48.06,1:49:50.06,Default,,0000,0000,0000,,Хин….
Dialogue: 0,1:51:52.13,1:51:56.01,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:51:56.01,1:52:03.91,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:52:03.91,1:52:06.10,Default,,0000,0000,0000,,Бірақ «Мен жеңдім» деп жазылған.
Dialogue: 0,1:52:06.10,1:52:10.81,Default,,0000,0000,0000,,Оған тек ақымақтар ғана сенеді. Хмм.
Dialogue: 0,1:52:10.81,1:52:13.01,Default,,0000,0000,0000,,Бұл біртүрлі. Кальцифер мүлде жанбайды.
Dialogue: 0,1:52:13.01,1:52:16.04,Default,,0000,0000,0000,,Әже, мұны тоқтата аласыз ба?
Dialogue: 0,1:52:16.04,1:52:18.06,Default,,0000,0000,0000,,Одан қорқынышты иіс шығады.
Dialogue: 0,1:52:18.06,1:52:21.09,Default,,0000,0000,0000,,Қарттардың қызығын тартып алма.
Dialogue: 0,1:52:21.09,1:52:24.12,Default,,0000,0000,0000,,Markl терезесін ашыңыз. Иә.
Dialogue: 0,1:52:24.12,1:52:27.15,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:52:27.15,1:52:30.85,Default,,0000,0000,0000,,Терезені ашпаған дұрыс деп ойлаймын.
Dialogue: 0,1:52:30.85,1:52:33.88,Default,,0000,0000,0000,,Өйткені Каль-чанның күші әлсірейді.
Dialogue: 0,1:52:33.88,1:52:35.88,Default,,0000,0000,0000,,Олар кіріп келеді.
Dialogue: 0,1:52:37.08,1:52:39.08,Default,,0000,0000,0000,,Маркл!
Dialogue: 0,1:52:42.97,1:52:45.16,Default,,0000,0000,0000,,(бомба дыбысы)
Dialogue: 0,1:52:45.16,1:52:48.16,Default,,0000,0000,0000,,Жоқ, яғни, ол қайда…
Dialogue: 0,1:52:49.37,1:52:51.37,Default,,0000,0000,0000,,Тез жабыңыз!
Dialogue: 0,1:52:57.11,1:52:58.97,Default,,0000,0000,0000,,Маркл әже, өтінемін.
Dialogue: 0,1:52:58.97,1:53:00.99,Default,,0000,0000,0000,,Дүкен Мен қараймын. Иә.
Dialogue: 0,1:53:00.99,1:53:09.90,Default,,0000,0000,0000,,
Dialogue: 0,1:53:09.90,1:53:18.16,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:53:18.16,1:53:19.84,Default,,0000,0000,0000,,～
Dialogue: 0,1:53:19.84,1:53:22.87,Default,,0000,0000,0000,,Осылай уақытың болса... өртті сөндір!
Dialogue: 0,1:53:22.87,1:53:32.13,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:53:32.13,1:53:33.48,Default,,0000,0000,0000,,～
Dialogue: 0,1:53:33.48,1:53:47.95,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:53:47.95,1:53:48.97,Default,,0000,0000,0000,,～ !!
Dialogue: 0,1:53:48.97,1:53:49.98,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:53:49.98,1:53:52.00,Default,,0000,0000,0000,,～ （）
Dialogue: 0,1:53:52.00,1:53:53.01,Default,,0000,0000,0000,,～
Dialogue: 0,1:53:53.01,1:54:01.93,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:54:01.93,1:54:03.95,Default,,0000,0000,0000,,～
Dialogue: 0,1:54:03.95,1:54:06.95,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:54:16.07,1:54:18.07,Default,,0000,0000,0000,,Айқай!
Dialogue: 0,1:54:19.77,1:54:22.13,Default,,0000,0000,0000,,Кешіріңіз, бүгін кешке адамдар тым көп болды.
Dialogue: 0,1:54:22.13,1:54:26.00,Default,,0000,0000,0000,,Айқай... Әй, Айқай.
Dialogue: 0,1:54:26.00,1:54:42.00,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:54:42.00,1:54:45.00,Default,,0000,0000,0000,,Хаул мырза! Софи!
Dialogue: 0,1:54:47.05,1:54:51.05,Default,,0000,0000,0000,,Кальцифер, мықты бол!
Dialogue: 0,1:54:54.96,1:54:59.67,Default,,0000,0000,0000,,Ханым: Бұл доктор Сәлиманның сыйлығы.
Dialogue: 0,1:54:59.67,1:55:03.88,Default,,0000,0000,0000,,Әлгі әжем маған біртүрлі нәрсе жегізді.
Dialogue: 0,1:55:03.88,1:55:06.07,Default,,0000,0000,0000,,О, бұл Хаул емес пе?
Dialogue: 0,1:55:06.07,1:55:10.11,Default,,0000,0000,0000,,Мен сенімен жай сөйлескім келеді.
Dialogue: 0,1:55:10.11,1:55:15.16,Default,,0000,0000,0000,,Мен де, ханым, бірақ қазір уақытым жоқ.
Dialogue: 0,1:55:15.16,1:55:19.37,Default,,0000,0000,0000,,Сенің қашпауың әдеттен тыс.
Сондай-ақ
Dialogue: 0,1:55:19.37,1:55:21.89,Default,,0000,0000,0000,,.
Dialogue: 0,1:55:21.89,1:55:25.09,Default,,0000,0000,0000,,Софи, осында қал. Кальцифер сізді қорғайды.
Dialogue: 0,1:55:25.09,1:55:27.09,Default,,0000,0000,0000,,Мен сыртын қорғаймын.
Dialogue: 0,1:55:28.13,1:55:33.17,Default,,0000,0000,0000,,Күте тұрыңыз! Айқай, кетпе! Осы жерде қал!
Dialogue: 0,1:55:33.17,1:55:37.04,Default,,0000,0000,0000,,Келесі әуе шабуылы келе жатыр. Тіпті Calcifer бомбаларды бұғаттай алмайды.
Dialogue: 0,1:55:37.04,1:55:39.24,Default,,0000,0000,0000,,Қаш, ұрыспа!
Dialogue: 0,1:55:39.24,1:55:42.93,Default,,0000,0000,0000,,Неліктен? Мен қашып кеттім.
Dialogue: 0,1:55:42.93,1:55:45.96,Default,,0000,0000,0000,,Мен қорғауым керек нәрсені таптым.
Dialogue: 0,1:55:45.96,1:55:47.96,Default,,0000,0000,0000,,Бұл сенсің. сурет?
Dialogue: 0,1:55:51.02,1:55:53.04,Default,,0000,0000,0000,,Айқай!
Dialogue: 0,1:55:53.04,1:56:00.04,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:56:32.94,1:56:42.94,Default,,0000,0000,0000,,
Dialogue: 0,1:56:57.85,1:57:01.85,Default,,0000,0000,0000,,Бұл менің соңғы өтінішім
Dialogue: 0,1:57:16.88,1:57:19.88,Default,,0000,0000,0000,,Бұл біз тұратын қала.
Dialogue: 0,1:57:22.94,1:57:24.94,Default,,0000,0000,0000,,Айқайлап жатыр.
Dialogue: 0,1:57:27.82,1:57:28.83,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:57:28.83,1:57:31.83,Default,,0000,0000,0000,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,1:57:34.05,1:57:35.05,Default,,0000,0000,0000,,Айқай!!
Dialogue: 0,1:57:42.96,1:57:45.32,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,1:57:45.32,1:57:47.32,Default,,0000,0000,0000,,Софи!! Шалғам!
Dialogue: 0,1:57:50.04,1:57:52.90,Default,,0000,0000,0000,,Маркл Мұнда келіңіз. иә?
Dialogue: 0,1:57:52.90,1:57:55.93,Default,,0000,0000,0000,,Жылжыту? Бұл ақылсыз! Ол жерде бос!
Dialogue: 0,1:57:55.93,1:57:59.97,Default,,0000,0000,0000,,Жоқ. Біз осында болғанша, Хаул соғысады.
Dialogue: 0,1:57:59.97,1:58:03.17,Default,,0000,0000,0000,,Ол әлсіз. Әже, тұрыңыз.
Dialogue: 0,1:58:03.17,1:58:05.19,Default,,0000,0000,0000,,Сіз серуендеуге барасыз ба?
Dialogue: 0,1:58:05.19,1:58:07.54,Default,,0000,0000,0000,,Өйткені Сүлиман сені бірден табады!
Dialogue: 0,1:58:07.54,1:58:08.89,Default,,0000,0000,0000,,Қазірдің өзінде табылды.
Dialogue: 0,1:58:08.89,1:58:10.92,Default,,0000,0000,0000,,Егер сіз мұны жасасаңыз, ол адам қайтып орала алмайды.
Dialogue: 0,1:58:10.92,1:58:14.95,Default,,0000,0000,0000,,Софи! Қамал тозған. Жарайды!
Dialogue: 0,1:58:14.95,1:58:16.95,Default,,0000,0000,0000,,Маркл әже, өтінемін! Иә.
Dialogue: 0,1:58:19.00,1:58:21.18,Default,,0000,0000,0000,,Сен де барасың, жүр!
Dialogue: 0,1:58:21.18,1:58:25.06,Default,,0000,0000,0000,,Бұл мүмкін емес! Келісім-шартқа байланысты каминнен шыға алмаймын.
Dialogue: 0,1:58:25.06,1:58:28.59,Default,,0000,0000,0000,,Балалар мұны істей алмасаңдар, мен сендерге жасаймын.
Dialogue: 0,1:58:28.59,1:58:30.11,Default,,0000,0000,0000,,Ах! қауіпті!
Dialogue: 0,1:58:30.11,1:58:33.14,Default,,0000,0000,0000,,Тоқта! Тоқта! Тоқта!
Dialogue: 0,1:58:33.14,1:58:36.14,Default,,0000,0000,0000,,Мына жігіт шықса, мына үй құлап қалады. жақсы!
Dialogue: 0,1:58:40.04,1:58:42.06,Default,,0000,0000,0000,,шықты! Алыста.
Dialogue: 0,1:58:42.06,1:58:44.08,Default,,0000,0000,0000,,Майлаушыны соңғы қалдырған дұрыс.
Dialogue: 0,1:58:44.08,1:58:48.08,Default,,0000,0000,0000,,Мен тіпті не болатынын білмеймін.
Dialogue: 0,1:59:16.07,1:59:21.07,Default,,0000,0000,0000,,Сондықтан құлап жатыр... Жаңбыр жауып тұр.
Dialogue: 0,1:59:22.97,1:59:24.99,Default,,0000,0000,0000,,Сіз қалаға барасыз ба?
Dialogue: 0,1:59:24.99,1:59:29.03,Default,,0000,0000,0000,,Маркл әже, өтінемін. Шалғам Ішіне қоятын жерді табыңыз.
Dialogue: 0,1:59:29.03,1:59:32.03,Default,,0000,0000,0000,,Әже, жарайды, мен сізбен бірге боламын.
Dialogue: 0,1:59:34.08,1:59:37.08,Default,,0000,0000,0000,,Markl Осы жерге енгізіңіз.
Dialogue: 0,1:59:46.20,1:59:49.90,Default,,0000,0000,0000,,Ол ағып жатыр. Ол жоғалып кетеді.
Dialogue: 0,1:59:49.90,1:59:51.92,Default,,0000,0000,0000,,Осы жерде күтіңіз.
Dialogue: 0,1:59:51.92,1:59:53.92,Default,,0000,0000,0000,,Бұл жерде дымқыл! Эй!
Dialogue: 0,1:59:59.00,2:00:01.00,Default,,0000,0000,0000,,Асығыңыз.
Dialogue: 0,2:00:02.87,2:00:04.87,Default,,0000,0000,0000,,Ылғалды!
Dialogue: 0,2:00:07.91,2:00:10.10,Default,,0000,0000,0000,,Маркл! Әже, мұнда келіңіз!
Dialogue: 0,2:00:10.10,2:00:11.79,Default,,0000,0000,0000,,Құлып бос.
Dialogue: 0,2:00:11.79,2:00:16.79,Default,,0000,0000,0000,,Егер мен сонда қалғанымда, оны Ойра мен Хаулмен қорғай алар едім.
Dialogue: 0,2:00:18.18,2:00:21.72,Default,,0000,0000,0000,,Кальцифер Өтінемін, мұны тек сіз жасай аласыз.
Dialogue: 0,2:00:21.72,2:00:23.91,Default,,0000,0000,0000,,Мен Хаулдың орнына барып, қамалды жылжытқым келеді.
Dialogue: 0,2:00:23.91,2:00:25.93,Default,,0000,0000,0000,,Иә!
Dialogue: 0,2:00:25.93,2:00:28.96,Default,,0000,0000,0000,,You can do it. Сізде үлкен күш бар.
Dialogue: 0,2:00:28.96,2:00:35.02,Default,,0000,0000,0000,,Бірақ мұнда мұржа жоқ, дымқыл...
Dialogue: 0,2:00:35.02,2:00:39.23,Default,,0000,0000,0000,,Өйткені ''ең жақсы адамдар жер таңдамайды'' деп көптен бері айтылып келеді.
Dialogue: 0,2:00:39.23,2:00:43.94,Default,,0000,0000,0000,,Бұл рас, бірақ... Мен солай ойлаймын.
Dialogue: 0,2:00:43.94,2:00:46.97,Default,,0000,0000,0000,,Каль-чан, сен әдемісің. Әже осында.
Dialogue: 0,2:00:46.97,2:00:50.00,Default,,0000,0000,0000,,Сонымен, сіз маған Софиге бірдеңе бере аласыз ба?
Dialogue: 0,2:00:50.00,2:00:51.02,Default,,0000,0000,0000,,Менікі ме?
Dialogue: 0,2:00:51.02,2:00:53.88,Default,,0000,0000,0000,,It's not enough just to look good...like the eyes.
Dialogue: 0,2:00:53.88,2:00:56.91,Default,,0000,0000,0000,,Eyes? бұл?
Dialogue: 0,2:00:56.91,2:01:11.05,Default,,0000,0000,0000,,Сен
Dialogue: 0,2:01:11.05,2:01:13.07,Default,,0000,0000,0000,,～ !?
Dialogue: 0,2:01:13.07,2:01:19.13,Default,,0000,0000,0000,,Сен
Dialogue: 0,2:01:19.13,2:01:20.98,Default,,0000,0000,0000,,～ …
Dialogue: 0,2:01:20.98,2:01:41.01,Default,,0000,0000,0000,,Сен
Dialogue: 0,2:01:41.01,2:01:46.90,Default,,0000,0000,0000,,Сен
Dialogue: 0,2:01:46.90,2:01:48.09,Default,,0000,0000,0000,,～
Dialogue: 0,2:01:48.09,2:02:02.06,Default,,0000,0000,0000,,Сен
Dialogue: 0,2:02:02.06,2:02:05.09,Default,,0000,0000,0000,,That's amazing, Calcifer! you are top notch!
Dialogue: 0,2:02:05.09,2:02:08.12,Default,,0000,0000,0000,,Маған көз немесе жүрек сыйласаңыз, одан да керемет болар еді!
Dialogue: 0,2:02:08.12,2:02:11.12,Default,,0000,0000,0000,,Heart! Does it have a heart?
Dialogue: 0,2:02:14.01,2:02:16.36,Default,,0000,0000,0000,,Oh!
Dialogue: 0,2:02:16.36,2:02:28.15,Default,,0000,0000,0000,,Сен
Dialogue: 0,2:02:28.15,2:02:31.18,Default,,0000,0000,0000,,Улау сол жерде, қоршауда!
Dialogue: 0,2:02:31.18,2:02:35.06,Default,,0000,0000,0000,,Сен
Dialogue: 0,2:02:35.06,2:02:38.09,Default,,0000,0000,0000,,Calcifer Hurry! Ах!?
Dialogue: 0,2:02:38.09,2:02:40.28,Default,,0000,0000,0000,,Stop!
Dialogue: 0,2:02:40.28,2:02:42.46,Default,,0000,0000,0000,,Grandma!!
Dialogue: 0,2:02:42.46,2:02:44.98,Default,,0000,0000,0000,,Сәлем! Тоқта!
Dialogue: 0,2:02:44.98,2:02:46.00,Default,,0000,0000,0000,,Бұл Хаулдың жүрегі.
Dialogue: 0,2:02:46.00,2:02:50.00,Default,,0000,0000,0000,,Ah, stop it! Grandma, stop it!
Dialogue: 0,2:02:58.12,2:03:00.12,Default,,0000,0000,0000,,Әже!
Dialogue: 0,2:03:02.66,2:03:05.86,Default,,0000,0000,0000,,Ыстық! hot! Жіберу!
Dialogue: 0,2:03:05.86,2:03:07.88,Default,,0000,0000,0000,,You're going to die! Әже!
Dialogue: 0,2:03:07.88,2:03:10.07,Default,,0000,0000,0000,,No, it's hot!
Dialogue: 0,2:03:10.07,2:03:15.07,Default,,0000,0000,0000,,It's hot! hot! Hot!!
Dialogue: 0,2:03:21.35,2:03:23.35,Default,,0000,0000,0000,,Ах!
Dialogue: 0,2:03:24.88,2:03:26.88,Default,,0000,0000,0000,,Ах!
Dialogue: 0,2:03:27.92,2:03:29.93,Default,,0000,0000,0000,,Софи!
Dialogue: 0,2:03:29.93,2:03:30.93,Default,,0000,0000,0000,,Ах!
Dialogue: 0,2:03:32.97,2:03:34.99,Default,,0000,0000,0000,,Sophie!!
Dialogue: 0,2:03:34.99,2:03:38.99,Default,,0000,0000,0000,,Sophie bullied me! Бұл жылы!
Dialogue: 0,2:04:01.92,2:04:02.92,Default,,0000,0000,0000,,Хин!
Dialogue: 0,2:04:11.85,2:04:14.85,Default,,0000,0000,0000,,Хин! Hin hin!
Dialogue: 0,2:04:21.12,2:04:23.98,Default,,0000,0000,0000,,Hin I did something terrible...
Dialogue: 0,2:04:23.98,2:04:26.98,Default,,0000,0000,0000,,I poured water on Calcifer.
Dialogue: 0,2:04:27.85,2:04:30.88,Default,,0000,0000,0000,,Хоул өлсе ше...?
Dialogue: 0,2:04:30.88,2:04:44.85,Default,,0000,0000,0000,,《Жоқ, жасама!》
Dialogue: 0,2:04:44.85,2:04:45.85,Default,,0000,0000,0000,,Хин Хин!
Dialogue: 0,2:04:47.04,2:04:52.04,Default,,0000,0000,0000,,Хин! Хин хин хин!
Dialogue: 0,2:04:57.14,2:05:00.34,Default,,0000,0000,0000,,Қозғалыс... Хаул тірі ме?
Dialogue: 0,2:05:00.34,2:05:02.34,Default,,0000,0000,0000,,Маған Хаулдың қайда екенін айт!
Dialogue: 0,2:05:06.07,2:05:08.07,Default,,0000,0000,0000,,Ах!
Dialogue: 0,2:05:24.91,2:05:26.91,Default,,0000,0000,0000,,Құлып есігі….
Dialogue: 0,2:05:31.98,2:05:51.01,Default,,0000,0000,0000,,(Жел дыбысы)
Dialogue: 0,2:05:51.01,2:05:55.01,Default,,0000,0000,0000,,Хин Хин Хин….
Dialogue: 0,2:05:57.08,2:05:59.08,Default,,0000,0000,0000,,Хин!
Dialogue: 0,2:06:05.16,2:06:25.02,Default,,0000,0000,0000,,Сен
Dialogue: 0,2:06:25.02,2:06:38.99,Default,,0000,0000,0000,,Сен
Dialogue: 0,2:06:38.99,2:06:40.01,Default,,0000,0000,0000,,Ах!
Dialogue: 0,2:06:40.01,2:06:42.86,Default,,0000,0000,0000,,(Есікті тырнап жатқан Хин дыбысы)
Dialogue: 0,2:06:42.86,2:06:44.86,Default,,0000,0000,0000,,Хин.
Dialogue: 0,2:06:46.07,2:06:48.09,Default,,0000,0000,0000,,Хин! Хин!
Dialogue: 0,2:06:48.09,2:07:03.07,Default,,0000,0000,0000,,Сен
Dialogue: 0,2:07:03.07,2:07:05.08,Default,,0000,0000,0000,,～
Dialogue: 0,2:07:05.08,2:07:07.11,Default,,0000,0000,0000,,Сен
Dialogue: 0,2:07:07.11,2:07:09.12,Default,,0000,0000,0000,,～
Dialogue: 0,2:07:09.12,2:07:20.73,Default,,0000,0000,0000,,Сен
Dialogue: 0,2:07:20.73,2:07:21.92,Default,,0000,0000,0000,,～
Dialogue: 0,2:07:21.92,2:07:40.93,Default,,0000,0000,0000,,Сен
Dialogue: 0,2:07:40.93,2:07:42.96,Default,,0000,0000,0000,,Мен қазір Хаулдың балалық шағындамын.
Dialogue: 0,2:07:42.96,2:08:02.99,Default,,0000,0000,0000,,Сен
Dialogue: 0,2:08:02.99,2:08:04.01,Default,,0000,0000,0000,,～
Dialogue: 0,2:08:04.01,2:08:07.04,Default,,0000,0000,0000,,Сен
Dialogue: 0,2:08:07.04,2:08:09.06,Default,,0000,0000,0000,,～ …
Dialogue: 0,2:08:09.06,2:08:24.88,Default,,0000,0000,0000,,Сен
Dialogue: 0,2:08:24.88,2:08:26.06,Default,,0000,0000,0000,,～ !!
Dialogue: 0,2:08:26.06,2:08:29.93,Default,,0000,0000,0000,,～
Dialogue: 0,2:08:29.93,2:08:39.02,Default,,0000,0000,0000,,Сен
Dialogue: 0,2:08:39.02,2:08:40.37,Default,,0000,0000,0000,,～
Dialogue: 0,2:08:40.37,2:08:42.72,Default,,0000,0000,0000,,～
Dialogue: 0,2:08:42.72,2:08:58.89,Default,,0000,0000,0000,,Сен
Dialogue: 0,2:08:58.89,2:09:00.90,Default,,0000,0000,0000,,～
Dialogue: 0,2:09:00.90,2:09:01.08,Default,,0000,0000,0000,,Сен
Dialogue: 0,2:09:01.08,2:09:04.11,Default,,0000,0000,0000,,～
Dialogue: 0,2:09:04.11,2:09:06.46,Default,,0000,0000,0000,,～
Dialogue: 0,2:09:06.46,2:09:10.17,Default,,0000,0000,0000,,～
Dialogue: 0,2:09:10.17,2:09:13.03,Default,,0000,0000,0000,,～
Dialogue: 0,2:09:13.03,2:09:14.04,Default,,0000,0000,0000,,Сен
Dialogue: 0,2:09:14.04,2:09:16.06,Default,,0000,0000,0000,,～
Dialogue: 0,2:09:16.06,2:09:31.05,Default,,0000,0000,0000,,Сен
Dialogue: 0,2:09:31.05,2:09:33.90,Default,,0000,0000,0000,,～
Dialogue: 0,2:09:33.90,2:09:37.95,Default,,0000,0000,0000,,Сен
Dialogue: 0,2:09:37.95,2:09:39.96,Default,,0000,0000,0000,,～
Dialogue: 0,2:09:39.96,2:09:43.00,Default,,0000,0000,0000,,Сен
Dialogue: 0,2:09:43.00,2:09:45.19,Default,,0000,0000,0000,,～
Dialogue: 0,2:09:45.19,2:09:49.89,Default,,0000,0000,0000,,～ …
Dialogue: 0,2:09:49.89,2:09:51.91,Default,,0000,0000,0000,,～
Dialogue: 0,2:09:51.91,2:09:54.91,Default,,0000,0000,0000,,Сен
Dialogue: 0,2:11:56.16,2:11:58.16,Default,,0000,0000,0000,,Хин!
Dialogue: 0,2:12:03.07,2:12:15.01,Default,,0000,0000,0000,,Сен
Dialogue: 0,2:12:15.01,2:12:17.03,Default,,0000,0000,0000,,～
Dialogue: 0,2:12:17.03,2:12:23.09,Default,,0000,0000,0000,,Сен
Dialogue: 0,2:12:23.09,2:12:26.12,Default,,0000,0000,0000,,～ …
Dialogue: 0,2:12:26.12,2:12:29.15,Default,,0000,0000,0000,,Howl has been waiting for me for so long.
Dialogue: 0,2:12:29.15,2:12:33.86,Default,,0000,0000,0000,,Сен
Dialogue: 0,2:12:33.86,2:12:36.06,Default,,0000,0000,0000,,Take me to Calcifer.
Dialogue: 0,2:12:36.06,2:12:40.26,Default,,0000,0000,0000,,Сен
Dialogue: 0,2:12:40.26,2:12:41.95,Default,,0000,0000,0000,,～
Dialogue: 0,2:12:41.95,2:13:02.15,Default,,0000,0000,0000,,Сен
Dialogue: 0,2:13:02.15,2:13:19.83,Default,,0000,0000,0000,,Сен
Dialogue: 0,2:13:19.83,2:13:22.18,Default,,0000,0000,0000,,～ …
Dialogue: 0,2:13:22.18,2:13:39.85,Default,,0000,0000,0000,,Сен
Dialogue: 0,2:13:39.85,2:13:42.85,Default,,0000,0000,0000,,Сіз өлдіңіз бе? Жоқ, жарайды.
Dialogue: 0,2:13:46.26,2:13:47.27,Default,,0000,0000,0000,,Әже.
Dialogue: 0,2:13:47.27,2:13:51.15,Default,,0000,0000,0000,,Мен білмеймін. Менде ештеңе жоқ.
Dialogue: 0,2:13:51.15,2:13:53.15,Default,,0000,0000,0000,,Өтінемін….
Dialogue: 0,2:13:54.18,2:13:57.18,Default,,0000,0000,0000,,Әже….
Dialogue: 0,2:13:59.05,2:14:02.75,Default,,0000,0000,0000,,Сіз мұны соншалықты қалайсыз ба?
Dialogue: 0,2:14:02.75,2:14:03.10,Default,,0000,0000,0000,,Иә.
Dialogue: 0,2:14:03.10,2:14:08.14,Default,,0000,0000,0000,,Оған көмектесу мүмкін емес. Оған қамқорлық жасаңыз.
Dialogue: 0,2:14:08.14,2:14:11.17,Default,,0000,0000,0000,,Иә. Қараңыз.
Dialogue: 0,2:14:11.17,2:14:14.20,Default,,0000,0000,0000,,Рахмет, әже.
Dialogue: 0,2:14:14.20,2:14:29.19,Default,,0000,0000,0000,,Сен
Dialogue: 0,2:14:29.19,2:14:31.04,Default,,0000,0000,0000,,Кальцифер.
Dialogue: 0,2:14:31.04,2:14:35.08,Default,,0000,0000,0000,,Софи Мен шаршадым...
Dialogue: 0,2:14:35.08,2:14:38.28,Default,,0000,0000,0000,,Жүрегіңді Хаулға қайтарсам, өлесің бе?
Dialogue: 0,2:14:38.28,2:14:41.31,Default,,0000,0000,0000,,Софидің жағдайы жақсы шығар.
Dialogue: 0,2:14:41.31,2:14:43.33,Default,,0000,0000,0000,,Майға су себсең де →
Dialogue: 0,2:14:43.33,2:14:46.86,Default,,0000,0000,0000,,Өйткені Ира да, Хаул да өлген жоқ.
Dialogue: 0,2:14:46.86,2:14:48.86,Default,,0000,0000,0000,,Мен жасап көремін.
Dialogue: 0,2:14:51.07,2:14:54.10,Default,,0000,0000,0000,,Кішкентай құстай жылы, қозғалады.
Dialogue: 0,2:14:54.10,2:14:56.97,Default,,0000,0000,0000,,Бала кезімдегідей.
Dialogue: 0,2:14:56.97,2:15:00.17,Default,,0000,0000,0000,,Өтінемін, Кальцифер мың жыл өмір сүреді→
Dialogue: 0,2:15:00.17,2:15:04.20,Default,,0000,0000,0000,,Хаул жүрегін қалпына келтірсін.
Dialogue: 0,2:15:04.20,2:15:09.20,Default,,0000,0000,0000,,Сен
Dialogue: 0,2:15:15.15,2:15:19.15,Default,,0000,0000,0000,,Тірі! Эй, мен боспын!
Dialogue: 0,2:15:23.23,2:15:25.25,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,2:15:25.25,2:15:27.10,Default,,0000,0000,0000,,жылжытылды! Бұл тірі!
Dialogue: 0,2:15:27.10,2:15:29.10,Default,,0000,0000,0000,,Ах! Апыр-ай!
Dialogue: 0,2:15:31.81,2:15:34.81,Default,,0000,0000,0000,,Калсифердің сиқыры бұзылды!
Dialogue: 0,2:15:48.14,2:15:49.14,Default,,0000,0000,0000,,Шалғам!
Dialogue: 0,2:15:52.69,2:15:54.69,Default,,0000,0000,0000,,Ах!
Dialogue: 0,2:16:02.12,2:16:06.12,Default,,0000,0000,0000,,Балапан, жақсысың ба? Мен саған бірден жаңа таяқ тауып беремін.
Dialogue: 0,2:16:08.18,2:16:10.18,Default,,0000,0000,0000,,Балапан Рахмет.
Dialogue: 0,2:16:18.94,2:16:20.97,Default,,0000,0000,0000,,Рахмет, Софи.
Dialogue: 0,2:16:20.97,2:16:25.02,Default,,0000,0000,0000,,Мен көрші елдің ханзадасымын, шалқанның басы бар деп қарғысқа ұшырадым.
Dialogue: 0,2:16:25.02,2:16:29.22,Default,,0000,0000,0000,,Сүйген адамың сүймесе, бұзылмайтын қарғыс.
Dialogue: 0,2:16:29.22,2:16:32.25,Default,,0000,0000,0000,,Дұрыс, егер Софи маған көмектеспесе →
Dialogue: 0,2:16:32.25,2:16:33.93,Default,,0000,0000,0000,,Мен өлетін едім.
Dialogue: 0,2:16:33.93,2:16:39.99,Default,,0000,0000,0000,,Ол жақсы жігіт. Шулы. Не шу?
Dialogue: 0,2:16:39.99,2:16:42.19,Default,,0000,0000,0000,,Уф! Бұл қорқынышты. Менің денем тасқа ұқсайды.
Dialogue: 0,2:16:42.19,2:16:45.22,Default,,0000,0000,0000,,Иә, жүрегім ауыр.
Dialogue: 0,2:16:45.22,2:16:48.92,Default,,0000,0000,0000,,Ах! Софидің шашы жұлдыз жарығында боялған.
Dialogue: 0,2:16:48.92,2:16:51.95,Default,,0000,0000,0000,,Бұл әдемі. Мен Хаулды жақсы көремін!
Dialogue: 0,2:16:51.95,2:16:54.13,Default,,0000,0000,0000,,Керемет! Ол аурады!
Dialogue: 0,2:16:54.13,2:16:55.15,Default,,0000,0000,0000,,Ах... Уф!
Dialogue: 0,2:16:55.15,2:16:57.50,Default,,0000,0000,0000,,Софидің өзін қалай сезінетінін білесіз.
Dialogue: 0,2:16:57.50,2:17:01.04,Default,,0000,0000,0000,,Еліңе қайтып, соғысты тоқтатуың керек.
Dialogue: 0,2:17:01.04,2:17:03.23,Default,,0000,0000,0000,,Мен солай істеймін.
Dialogue: 0,2:17:03.23,2:17:06.26,Default,,0000,0000,0000,,Соғыс біткенде тағы барайық.
Dialogue: 0,2:17:06.26,2:17:09.96,Default,,0000,0000,0000,,Адамның ой-пікірін өзгерту – адам өміріндегі қалыпты жағдай дейді.
Dialogue: 0,2:17:09.96,2:17:15.18,Default,,0000,0000,0000,,О, бұл жақсы нәрсе. Сонда мен сені күтемін.
Dialogue: 0,2:17:15.18,2:17:19.18,Default,,0000,0000,0000,,Хин! Хин хин хин!
Dialogue: 0,2:17:20.06,2:17:22.08,Default,,0000,0000,0000,,Хи хи хи.
Dialogue: 0,2:17:22.08,2:17:28.08,Default,,0000,0000,0000,,Не? Сіз маған осы жолы хабарластыңыз... Не істеп жүрсіз?
Dialogue: 0,2:17:30.17,2:17:35.17,Default,,0000,0000,0000,,Бақытты аяқталатын нәрсе жоқ, алаяқ.
Dialogue: 0,2:17:38.74,2:17:40.09,Default,,0000,0000,0000,,Хин! Хин!
Dialogue: 0,2:17:40.09,2:17:43.13,Default,,0000,0000,0000,,Ха~ Оған көмектесу мүмкін емес.
Dialogue: 0,2:17:43.13,2:17:48.17,Default,,0000,0000,0000,,Премьер-Министрді және Аппарат басшысын шақырыңыз.
Dialogue: 0,2:17:48.17,2:17:52.05,Default,,0000,0000,0000,,Осы ақымақ соғысты доғарайық. иә.
Dialogue: 0,2:17:52.05,2:17:54.24,Default,,0000,0000,0000,,Бұл кальцифер.
Dialogue: 0,2:17:54.24,2:17:57.24,Default,,0000,0000,0000,,Қайтып келмесем екен.
Dialogue: 0,2:18:00.13,2:18:03.16,Default,,0000,0000,0000,,Эй, мен бәріңмен бірге болғым келеді. Жаңбыр жауатын сияқты.
Dialogue: 0,2:18:03.16,2:18:06.19,Default,,0000,0000,0000,,Рахмет, Калсифер.
Dialogue: 0,2:18:06.19,2:18:08.05,Default,,0000,0000,0000,,Ууууууууу….
Dialogue: 0,2:18:08.05,2:18:21.18,Default,,0000,0000,0000,,Сен
