Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.34,0:00:14.76,Default,,0,0,0,,(Рельстен шыққан дыбыс)
Dialogue: 0,0:00:19.18,0:00:20.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:51.50,0:00:52.92,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:01:02.47,0:01:05.48,Default,,0,0,0,,Ха ха—
Dialogue: 0,0:01:14.03,0:01:14.94,Default,,0,0,0,,Хааа
Dialogue: 0,0:01:33.09,0:01:34.09,Default,,0,0,0,,Ах
Dialogue: 0,0:01:58.61,0:02:01.49,Default,,0,0,0,,Пухаа Фу
Dialogue: 0,0:02:22.72,0:02:23.72,Default,,0,0,0,,Джиджидзи…
Dialogue: 0,0:02:46.33,0:02:47.41,Default,,0,0,0,,Мя
Dialogue: 0,0:02:47.83,0:02:48.83,Default,,0,0,0,,Мими!
Dialogue: 0,0:02:49.71,0:02:51.62,Default,,0,0,0,,Қалайсың? Хехе
Dialogue: 0,0:02:51.92,0:02:53.21,Default,,0,0,0,,(Радио дыбысы)
Dialogue: 0,0:02:53.38,0:02:55.50,Default,,0,0,0,,Ах! Ол кірді!
Dialogue: 0,0:02:56.00,0:02:59.76,Default,,0,0,0,,(Әдемі әуен)
Dialogue: 0,0:03:05.14,0:03:06.97,Default,,0,0,0,,Жұмбақ әуен...
Dialogue: 0,0:03:15.98,0:03:22.99,Default,,0,0,0,,♪~
Dialogue: 0,0:04:35.10,0:04:38.31,Default,,0,0,0,,Содан бері ол әнді тыңдай алмадым.
Dialogue: 0,0:04:45.78,0:04:48.28,Default,,0,0,0,,Қайырлы кеш
Dialogue: 0,0:05:00.25,0:05:01.71,Default,,0,0,0,,Мені шығарып салғандарыңызға рахмет.
Dialogue: 0,0:05:01.92,0:05:04.72,Default,,0,0,0,,Мен саған кейін тамақ әкелемін.
Dialogue: 0,0:05:11.31,0:05:12.47,Default,,0,0,0,,Ах… «C» рейтингі
Dialogue: 0,0:05:14.64,0:05:17.65,Default,,0,0,0,,Ана? Бүгін ерте.
Dialogue: 0,0:05:19.02,0:05:22.15,Default,,0,0,0,,Не, өшіруді ұмытып кетіппін.
Dialogue: 0,0:05:28.99,0:05:30.83,Default,,0,0,0,,Мен үйдемін, әке.
Dialogue: 0,0:05:39.42,0:05:41.34,Default,,0,0,0,,Кун кун няа
Dialogue: 0,0:05:41.50,0:05:44.30,Default,,0,0,0,,А, сен қайдан кірдің?
Dialogue: 0,0:05:55.68,0:05:56.56,Default,,0,0,0,,Мен
Dialogue: 0,0:05:58.90,0:05:59.98,Default,,0,0,0,,Кун
Dialogue: 0,0:06:00.15,0:06:02.02,Default,,0,0,0,,Ах! Эй Мими!
Dialogue: 0,0:06:05.90,0:06:07.15,Default,,0,0,0,,Мияу
Dialogue: 0,0:06:10.70,0:06:11.62,Default,,0,0,0,,Мияу
Dialogue: 0,0:06:12.20,0:06:12.99,Default,,0,0,0,,Га—
Dialogue: 0,0:06:13.33,0:06:14.99,Default,,0,0,0,,Itadadakimasu
Dialogue: 0,0:06:27.01,0:06:29.09,Default,,0,0,0,,Бұл біртүрлі ән болды.
Dialogue: 0,0:06:29.26,0:06:31.55,Default,,0,0,0,,Эй, мен оны қайтадан тыңдай аламын ба?
Dialogue: 0,0:06:31.97,0:06:33.22,Default,,0,0,0,,Мияу
Dialogue: 0,0:06:35.97,0:06:37.98,Default,,0,0,0,,Қайырлы түн Мими
Dialogue: 0,0:06:38.48,0:06:39.56,Default,,0,0,0,,Мен
Dialogue: 0,0:06:46.11,0:06:46.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:52.91,0:06:54.20,Default,,0,0,0,,Жарқыраған—
Dialogue: 0,0:06:56.16,0:06:57.95,Default,,0,0,0,,Мүмкін бұл менің қиялым шығар
Dialogue: 0,0:07:20.89,0:07:22.69,Default,,0,0,0,,Келесі Ю Язаки
Dialogue: 0,0:07:23.10,0:07:24.23,Default,,0,0,0,,Дәл солай.
Dialogue: 0,0:07:24.40,0:07:25.36,Default,,0,0,0,,Иә
Dialogue: 0,0:07:25.98,0:07:27.94,Default,,0,0,0,,Келесі Asuna Watase
Dialogue: 0,0:07:28.11,0:07:29.11,Default,,0,0,0,,Иә
Dialogue: 0,0:07:30.28,0:07:32.91,Default,,0,0,0,,Асуна-сан бұл жолы да сыныптағы үздік.
Dialogue: 0,0:07:33.07,0:07:34.41,Default,,0,0,0,,Асуна қайтадан 1-ші нөмірге ие болды ма?
Dialogue: 0,0:07:34.57,0:07:35.45,Default,,0,0,0,,Сіз тамаша жұмыс жасадыңыз.
Dialogue: 0,0:07:35.62,0:07:36.66,Default,,0,0,0,,Күтілгендей, Төраға
Dialogue: 0,0:07:36.78,0:07:39.12,Default,,0,0,0,,Сіз көп оқып жатырсыз.
Dialogue: 0,0:07:41.66,0:07:44.42,Default,,0,0,0,,Соңында, ескерту.
Dialogue: 0,0:07:44.58,0:07:46.50,Default,,0,0,0,,Жақында кейбір студенттер маған айтып берді
Dialogue: 0,0:07:46.67,0:07:50.42,Default,,0,0,0,,Обучи төңірегінде аю тәрізді жануарды көргені туралы хабар келді.
Dialogue: 0,0:07:50.42,0:07:50.97,Default,,0,0,0,,Темір көпірде Обучидің төңірегінде аю тәрізді жануар көрінді деген хабар келді.
Dialogue: 0,0:07:50.97,0:07:51.76,Default,,0,0,0,,Темір көпірде
Dialogue: 0,0:07:51.13,0:07:51.92,Default,,0,0,0,,Кез келген жағдайда айналма жолмен жүрмеңіз
Dialogue: 0,0:07:51.92,0:07:53.59,Default,,0,0,0,,Менің ағам да көргенін айтты. Кез келген жағдайда айналма жолмен жүрмеңіз
Dialogue: 0,0:07:53.59,0:07:55.09,Default,,0,0,0,,Менің ағам да көргенін айтты.
Dialogue: 0,0:07:53.76,0:07:57.10,Default,,0,0,0,,Жақын жерде тұратын достарыңызбен үйге баруға тырысыңыз.
Dialogue: 0,0:07:57.26,0:07:58.06,Default,,0,0,0,,Сәлем
Dialogue: 0,0:07:58.22,0:08:00.31,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:08:01.56,0:08:03.39,Default,,0,0,0,,Қайырлы түн.
Dialogue: 0,0:08:04.73,0:08:07.69,Default,,0,0,0,,Урсуна-чан, менімен үйге барғың келе ме?
Dialogue: 0,0:08:07.86,0:08:09.69,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:08:09.82,0:08:11.99,Default,,0,0,0,,Мен асығуым керек.
Dialogue: 0,0:08:12.49,0:08:14.66,Default,,0,0,0,,Мені шақырғаныңызға көп рахмет.
Dialogue: 0,0:08:14.82,0:08:16.99,Default,,0,0,0,,Иә, келесі кездескенше.
Dialogue: 0,0:08:22.16,0:08:25.17,Default,,0,0,0,,Менің ұстазым да солай айтқан.
Dialogue: 0,0:08:36.68,0:08:38.30,Default,,0,0,0,,5 кг күріш, өтінемін.
Dialogue: 0,0:08:38.47,0:08:40.01,Default,,0,0,0,,Әдеттегідей рахмет
Dialogue: 0,0:08:40.35,0:08:42.73,Default,,0,0,0,,О, жақсысың ба?
Dialogue: 0,0:08:42.89,0:08:44.02,Default,,0,0,0,,Жарайды
Dialogue: 0,0:08:44.48,0:08:45.52,Default,,0,0,0,,Хааа
Dialogue: 0,0:08:48.81,0:08:50.53,Default,,0,0,0,,(Кір жуғыш машинаның дыбысы)
Dialogue: 0,0:08:58.03,0:08:59.16,Default,,0,0,0,,Хаа
Dialogue: 0,0:09:01.37,0:09:03.08,Default,,0,0,0,,жақсы ауа-райы
Dialogue: 0,0:09:28.23,0:09:29.36,Default,,0,0,0,,Әй?
Dialogue: 0,0:09:44.54,0:09:46.25,Default,,0,0,0,,Құстар ән салмайды
Dialogue: 0,0:09:46.75,0:09:47.54,Default,,0,0,0,,Ha
Dialogue: 0,0:09:48.54,0:09:51.17,Default,,0,0,0,,(Ағаш шыңдарының дыбысы)
Dialogue: 0,0:09:54.09,0:09:55.55,Default,,0,0,0,,Ә? Аймақ па?
Dialogue: 0,0:09:55.88,0:09:56.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:57.47,0:10:01.01,Default,,0,0,0,,Гуо гуеее
Dialogue: 0,0:10:03.85,0:10:05.27,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:10:08.39,0:10:09.23,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:10:09.44,0:10:10.44,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:16.99,0:10:18.74,Default,,0,0,0,,Гви…
Dialogue: 0,0:10:22.24,0:10:23.20,Default,,0,0,0,,Ах
Dialogue: 0,0:10:23.74,0:10:25.75,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:10:28.29,0:10:30.08,Default,,0,0,0,,Ха... жоқ!
Dialogue: 0,0:10:30.37,0:10:31.46,Default,,0,0,0,,Кя!
Dialogue: 0,0:10:32.04,0:10:32.79,Default,,0,0,0,,Ах
Dialogue: 0,0:10:34.80,0:10:36.34,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:10:36.80,0:10:37.84,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:41.05,0:10:42.93,Default,,0,0,0,,Хмм...ха
Dialogue: 0,0:10:45.97,0:10:47.60,Default,,0,0,0,,Төмен түсіңіз
Dialogue: 0,0:10:49.98,0:10:50.94,Default,,0,0,0,,Жарайды
Dialogue: 0,0:10:51.69,0:10:52.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:52.98,0:10:54.19,Default,,0,0,0,,Ум...
Dialogue: 0,0:11:02.49,0:11:04.41,Default,,0,0,0,,Гуо
Dialogue: 0,0:11:05.28,0:11:07.54,Default,,0,0,0,,Ә? Аймақ па?
Dialogue: 0,0:11:13.75,0:11:15.00,Default,,0,0,0,,Өмір сүру ұзақтығы
Dialogue: 0,0:11:15.17,0:11:16.63,Default,,0,0,0,,Е! ?
Dialogue: 0,0:11:27.47,0:11:28.27,Default,,0,0,0,,Гуо
Dialogue: 0,0:11:31.52,0:11:32.31,Default,,0,0,0,,Ha
Dialogue: 0,0:11:34.48,0:11:35.31,Default,,0,0,0,,Хамф!
Dialogue: 0,0:11:36.61,0:11:38.65,Default,,0,0,0,,Керемет
Dialogue: 0,0:11:40.03,0:11:40.82,Default,,0,0,0,,Уау
Dialogue: 0,0:11:41.99,0:11:42.82,Default,,0,0,0,,Уф
Dialogue: 0,0:11:44.12,0:11:45.20,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:47.54,0:11:48.54,Default,,0,0,0,,Гуо
Dialogue: 0,0:11:48.70,0:11:50.29,Default,,0,0,0,,(Ұлпалық жоғары нота)
Dialogue: 0,0:11:50.50,0:11:51.62,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:11:57.29,0:11:58.25,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:01.55,0:12:02.30,Default,,0,0,0,,Ha
Dialogue: 0,0:12:02.97,0:12:03.80,Default,,0,0,0,,(Пойыз дыбысы)
Dialogue: 0,0:12:03.97,0:12:04.97,Default,,0,0,0,,Ах
Dialogue: 0,0:12:06.05,0:12:07.85,Default,,0,0,0,,Мен қай жерде жаттығып жүргенімді ойлайсың?
Dialogue: 0,0:12:08.31,0:12:09.35,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:09.56,0:12:12.44,Default,,0,0,0,,Мен қай жерде жаттығып жүргенімді ойлайсың?
Dialogue: 0,0:12:15.90,0:12:17.73,Default,,0,0,0,,Мен толықтай жазылып кеттім! (Косей) Оу!
Dialogue: 0,0:12:22.61,0:12:24.78,Default,,0,0,0,,(жануарлардың пойыз соққан дыбысы)
Dialogue: 0,0:12:30.91,0:12:33.54,Default,,0,0,0,,Сізді қорқытқаным үшін кешіріңіз.
Dialogue: 0,0:12:33.71,0:12:35.08,Default,,0,0,0,,О...
Dialogue: 0,0:12:35.54,0:12:37.08,Default,,0,0,0,,Өйткені бұл соңғы рет
Dialogue: 0,0:12:37.33,0:12:39.09,Default,,0,0,0,,Е, у... сәл ғана.
Dialogue: 0,0:12:39.59,0:12:41.09,Default,,0,0,0,,Маған сенесіз бе?
Dialogue: 0,0:12:43.42,0:12:45.18,Default,,0,0,0,,А, аа!
Dialogue: 0,0:12:45.84,0:12:47.43,Default,,0,0,0,,Кяах!
Dialogue: 0,0:12:47.89,0:12:50.01,Default,,0,0,0,,А! Хм?
Dialogue: 0,0:13:08.07,0:13:10.49,Default,,0,0,0,,(Баланың ән айту дауысы)
Dialogue: 0,0:13:13.45,0:13:17.00,Default,,0,0,0,,Мен сені көруге келгеніме сенімдімін.
Dialogue: 0,0:13:36.56,0:13:37.69,Default,,0,0,0,,Сіз байқадыңыз.
Dialogue: 0,0:13:37.85,0:13:39.10,Default,,0,0,0,,Ұлы соғыс аяқталғаннан бері—
Dialogue: 0,0:13:39.81,0:13:43.11,Default,,0,0,0,,Ешқандай қауіп жоқ, үйге тыныш қайт.
Dialogue: 0,0:13:43.36,0:13:46.24,Default,,0,0,0,,Мм... сен маған көмектестің, солай ма?
Dialogue: 0,0:13:46.90,0:13:47.86,Default,,0,0,0,,Рахмет
Dialogue: 0,0:13:49.53,0:13:52.20,Default,,0,0,0,,Енді бұл тауға жақындамаған дұрыс.
Dialogue: 0,0:13:53.87,0:13:54.66,Default,,0,0,0,,Ах
Dialogue: 0,0:13:57.25,0:13:58.21,Default,,0,0,0,,Мими?
Dialogue: 0,0:14:00.33,0:14:01.42,Default,,0,0,0,,Хаа
Dialogue: 0,0:14:09.80,0:14:12.51,Default,,0,0,0,,(Тікұшақтың дыбысы)
Dialogue: 0,0:14:16.35,0:14:19.85,Default,,0,0,0,,Мен қателеспеймін. Ол жерде міндетті түрде біреу болған.
Dialogue: 0,0:14:20.02,0:14:21.81,Default,,0,0,0,,Осындай бала сияқты
Dialogue: 0,0:14:21.98,0:14:22.90,Default,,0,0,0,,Оған өз күнәларының ауырлығын түсіну үшін—
Dialogue: 0,0:14:23.07,0:14:24.07,Default,,0,0,0,,Подполковник —
Dialogue: 0,0:14:25.19,0:14:26.28,Default,,0,0,0,,Сендер не істеп жатырсыңдар?!
Dialogue: 0,0:14:30.20,0:14:33.33,Default,,0,0,0,,Ватасе мырза? Асуна демалыс күнін алып жатыр ма?
Dialogue: 0,0:14:33.53,0:14:34.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:34.79,0:14:37.37,Default,,0,0,0,,Өзіңізді нашар сезінесіз бе? Мен уайымдап тұрмын.
Dialogue: 0,0:14:38.04,0:14:41.00,Default,,0,0,0,,Бәріңіз, естіген боларсыздар.
Dialogue: 0,0:14:41.17,0:14:43.75,Default,,0,0,0,,Кеше Обучи теміржол көпірінде аю пайда болғанға ұқсайды.
Dialogue: 0,0:14:43.92,0:14:45.42,Default,,0,0,0,,Сіз жүкті соқтыңыз ба?
Dialogue: 0,0:14:45.59,0:14:47.26,Default,,0,0,0,,Полиция тергеп жатыр.
Dialogue: 0,0:14:47.42,0:14:48.84,Default,,0,0,0,,Бірақ ол әлдеқашан өлді.
Dialogue: 0,0:14:49.01,0:14:49.88,Default,,0,0,0,,Қалай болғанда да
Dialogue: 0,0:14:50.05,0:14:54.51,Default,,0,0,0,,Бұл да мектеп бағытына жақын, сондықтан барлығыңыз сақ болыңыз.
Dialogue: 0,0:14:54.68,0:14:55.64,Default,,0,0,0,,Сәлем
Dialogue: 0,0:14:55.81,0:14:58.60,Default,,0,0,0,,Юу-сан, оны да Асуна-санға айт.
Dialogue: 0,0:14:58.77,0:14:59.73,Default,,0,0,0,,Иә
Dialogue: 0,0:14:59.89,0:15:03.36,Default,,0,0,0,,Олай болса, декреттік демалысымда менің орынбасарым...
Dialogue: 0,0:15:03.52,0:15:05.40,Default,,0,0,0,,Мен ертең жұмысты қабылдаймын.
Dialogue: 0,0:15:05.57,0:15:06.36,Default,,0,0,0,,Басқалардың араласуы немесе олардың арасындағы шектеулер соншалықты қарапайым емес.
Dialogue: 0,0:15:06.53,0:15:08.69,Default,,0,0,0,,Мына мұғалім әдемі ме?
Dialogue: 0,0:15:08.86,0:15:10.40,Default,,0,0,0,,Кешіріңіз, жігітім.
Dialogue: 0,0:15:10.57,0:15:11.41,Default,,0,0,0,,Сіз ер адамсыз ба?
Dialogue: 0,0:15:17.29,0:15:18.25,Default,,0,0,0,,Га—
Dialogue: 0,0:15:18.66,0:15:20.21,Default,,0,0,0,,Бәріміз барайық
Dialogue: 0,0:15:23.46,0:15:25.42,Default,,0,0,0,,Тіпті алда темір көпір
Dialogue: 0,0:15:25.75,0:15:26.92,Default,,0,0,0,,Бұл қорқынышты
Dialogue: 0,0:15:27.09,0:15:29.97,Default,,0,0,0,,Бірақ пойыз қайта іске қосылды.
Dialogue: 0,0:15:30.13,0:15:32.43,Default,,0,0,0,,Дұрыс, екі сағат сайын бір.
Dialogue: 0,0:15:34.55,0:15:36.47,Default,,0,0,0,,Сәлем Асуна-чан
Dialogue: 0,0:15:36.64,0:15:37.51,Default,,0,0,0,,Сәлем
Dialogue: 0,0:15:37.68,0:15:39.43,Default,,0,0,0,,Бұл жақсы күн.
Dialogue: 0,0:15:39.60,0:15:41.23,Default,,0,0,0,,Иә Я
Dialogue: 0,0:15:41.39,0:15:42.44,Default,,0,0,0,,Иә
Dialogue: 0,0:15:42.81,0:15:43.98,Default,,0,0,0,,О, Сато мырза
Dialogue: 0,0:15:44.15,0:15:45.23,Default,,0,0,0,,Сәлем
Dialogue: 0,0:16:12.51,0:16:15.47,Default,,0,0,0,,А, мінекей!
Dialogue: 0,0:16:24.10,0:16:25.02,Default,,0,0,0,,Хмм.
Dialogue: 0,0:16:29.02,0:16:30.32,Default,,0,0,0,,Шын жүректен осылай сезінемін
Dialogue: 0,0:16:31.65,0:16:32.99,Default,,0,0,0,,Жас ағаш
Dialogue: 0,0:16:33.15,0:16:34.86,Default,,0,0,0,,Витакуа күші?
Dialogue: 0,0:16:39.03,0:16:40.45,Default,,0,0,0,,Кристалданған
Dialogue: 0,0:16:42.00,0:16:44.87,Default,,0,0,0,,Мүмкін біреу жер бетіне шығып жатқан шығар.
Dialogue: 0,0:16:45.04,0:16:46.13,Default,,0,0,0,,Іздеу!
Dialogue: 0,0:16:49.84,0:16:50.63,Default,,0,0,0,,Ня?
Dialogue: 0,0:16:50.88,0:16:52.51,Default,,0,0,0,,Ол әлі де келе ме?
Dialogue: 0,0:16:52.88,0:16:54.34,Default,,0,0,0,,Мен сізге кеңес берсем де.
Dialogue: 0,0:16:54.51,0:16:55.76,Default,,0,0,0,,Мя
Dialogue: 0,0:16:56.51,0:16:57.85,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:16:58.43,0:17:01.06,Default,,0,0,0,,Негізі мен де соны қалаған едім.
Dialogue: 0,0:17:02.68,0:17:04.48,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:17:05.39,0:17:06.52,Default,,0,0,0,,Хаа
Dialogue: 0,0:17:09.36,0:17:11.69,Default,,0,0,0,,Келмегенің жөн дедім ғой.
Dialogue: 0,0:17:11.86,0:17:13.82,Default,,0,0,0,,Өйткені... Ах! —
Dialogue: 0,0:17:14.03,0:17:15.11,Default,,0,0,0,,Мими!
Dialogue: 0,0:17:15.28,0:17:17.53,Default,,0,0,0,,Мияу мияу
Dialogue: 0,0:17:17.70,0:17:19.53,Default,,0,0,0,,Не, сатқын?
Dialogue: 0,0:17:19.70,0:17:21.83,Default,,0,0,0,,Мен ғана үйренетін әдет
Dialogue: 0,0:17:21.99,0:17:23.87,Default,,0,0,0,,Алдау, тәртіп жоқ! —
Dialogue: 0,0:17:24.50,0:17:25.83,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:17:26.37,0:17:28.38,Default,,0,0,0,,Бастапқыда менің орным
Dialogue: 0,0:17:28.54,0:17:30.84,Default,,0,0,0,,Ешкім маған келме деп айтқанын қаламаймын.
Dialogue: 0,0:17:32.96,0:17:34.34,Default,,0,0,0,,Мен сияқты
Dialogue: 0,0:17:34.59,0:17:35.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:35.55,0:17:37.34,Default,,0,0,0,,Келгім келгендіктен келдім.
Dialogue: 0,0:17:37.89,0:17:39.97,Default,,0,0,0,,Менің атым Шун. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:17:41.31,0:17:43.39,Default,,0,0,0,,Мен... Асуна
Dialogue: 0,0:17:43.56,0:17:45.35,Default,,0,0,0,,А... Әй, мына қолдар! —
Dialogue: 0,0:17:45.77,0:17:48.10,Default,,0,0,0,,Қан шығып жатыр, кешегі шығар...
Dialogue: 0,0:17:48.27,0:17:49.40,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:17:49.56,0:17:51.36,Default,,0,0,0,,Өйткені бұл менің кінәм
Dialogue: 0,0:17:54.74,0:17:55.61,Default,,0,0,0,,Хмм
Dialogue: 0,0:17:59.87,0:18:03.37,Default,,0,0,0,,Сіз ауруханада кейінірек тексерілуіңіз керек.
Dialogue: 0,0:18:03.58,0:18:06.29,Default,,0,0,0,,Менің анам сонда жұмыс істейді.
Dialogue: 0,0:18:06.71,0:18:08.92,Default,,0,0,0,,Бәрі бар, солай емес пе?
Dialogue: 0,0:18:09.08,0:18:11.88,Default,,0,0,0,,Иә, бірақ мен оны бірінші рет пайдалы деп таптым.
Dialogue: 0,0:18:12.04,0:18:16.05,Default,,0,0,0,,Мен өз жерімді қалаймын, сондықтан мен оны аз-аздан көтеріп жүрдім.
Dialogue: 0,0:18:16.22,0:18:17.55,Default,,0,0,0,,Әйтеуір...
Dialogue: 0,0:18:18.22,0:18:21.43,Default,,0,0,0,,Сондай-ақ, бұл радионы қосу үшін ең жақсы орын.
Dialogue: 0,0:18:21.60,0:18:23.01,Default,,0,0,0,,Радио?
Dialogue: 0,0:18:23.85,0:18:25.27,Default,,0,0,0,,Сәлем, аяқталды!
Dialogue: 0,0:18:25.43,0:18:26.18,Default,,0,0,0,,Рахмет
Dialogue: 0,0:18:26.35,0:18:27.48,Default,,0,0,0,,Хе-
Dialogue: 0,0:18:28.73,0:18:29.90,Default,,0,0,0,,Оны тыңдағыңыз келе ме?
Dialogue: 0,0:18:34.53,0:18:37.74,Default,,0,0,0,,Бұл кен диодты ауыстырады.
Dialogue: 0,0:18:38.57,0:18:42.62,Default,,0,0,0,,Қабылдау шарттары уақыт пен ауа райына байланысты өзгереді.
Dialogue: 0,0:18:42.95,0:18:45.16,Default,,0,0,0,,А, эй, анау тас...
Dialogue: 0,0:18:45.33,0:18:46.50,Default,,0,0,0,,(Дарио) Бұл нағыз апат. Бұл жігіт те сол жерде-ақ қаза тапты. ➡
Dialogue: 0,0:18:48.50,0:18:49.50,Default,,0,0,0,,Иә
Dialogue: 0,0:18:51.92,0:18:53.29,Default,,0,0,0,,Бұл музыкалық бағдарлама.
Dialogue: 0,0:18:53.46,0:18:54.63,Default,,0,0,0,,Иә
Dialogue: 0,0:18:59.55,0:19:00.30,Default,,0,0,0,,Тамақтану керек пе?
Dialogue: 0,0:19:00.47,0:19:02.47,Default,,0,0,0,,Рахмет, қарным ашты.
Dialogue: 0,0:19:10.52,0:19:12.27,Default,,0,0,0,,Бұрын, бір рет-
Dialogue: 0,0:19:12.40,0:19:14.69,Default,,0,0,0,,Сіз біртүрлі ән естідіңіз бе?
Dialogue: 0,0:19:14.86,0:19:17.99,Default,,0,0,0,,Мен білетін басқа музыкаға ұқсамайтын ән.
Dialogue: 0,0:19:18.15,0:19:22.45,Default,,0,0,0,,Біреудің жүрегі дыбысқа айналғандай.
Dialogue: 0,0:19:26.24,0:19:30.12,Default,,0,0,0,,Бұл кезде қуаныш пен мұң тоғысқан
Dialogue: 0,0:19:30.29,0:19:32.83,Default,,0,0,0,,Бұл менің жалғыз емес екенімді сезінді
Dialogue: 0,0:19:34.84,0:19:36.84,Default,,0,0,0,,Жүрегімде мәңгі сақталады
Dialogue: 0,0:19:37.30,0:19:40.59,Default,,0,0,0,,Мен мұны қайтадан естігім келеді
Dialogue: 0,0:19:40.76,0:19:41.76,Default,,0,0,0,,Уф
Dialogue: 0,0:19:43.89,0:19:45.85,Default,,0,0,0,,Шун...кун?
Dialogue: 0,0:19:51.69,0:19:55.23,Default,,0,0,0,,(Хигурашидің айқайы)
Dialogue: 0,0:20:02.82,0:20:05.41,Default,,0,0,0,,Асуна менен ештеңе сұрамайды.
Dialogue: 0,0:20:05.57,0:20:06.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:06.58,0:20:08.45,Default,,0,0,0,,Сізде көптеген сұрақтар бар екеніне сенімдімін.
Dialogue: 0,0:20:08.62,0:20:11.04,Default,,0,0,0,,Сіз аю тәрізді мақұлық туралы айтып отырсыз ба?
Dialogue: 0,0:20:11.21,0:20:12.25,Default,,0,0,0,,Иә
Dialogue: 0,0:20:12.54,0:20:14.58,Default,,0,0,0,,Иә, бірақ қазір бәрі жақсы.
Dialogue: 0,0:20:14.75,0:20:16.08,Default,,0,0,0,,Күмәнге толы.
Dialogue: 0,0:20:16.25,0:20:20.26,Default,,0,0,0,,Бұл өте ұзақ болады, сондықтан мен ертең осында боламын.
Dialogue: 0,0:20:26.30,0:20:30.06,Default,,0,0,0,,Мен алыстағы Агарта деген жерден келдім.
Dialogue: 0,0:20:30.22,0:20:31.27,Default,,0,0,0,,Агарта…—
Dialogue: 0,0:20:31.43,0:20:32.81,Default,,0,0,0,,Шетел мемлекеті?
Dialogue: 0,0:20:33.06,0:20:34.06,Default,,0,0,0,,Иә—
Dialogue: 0,0:20:34.39,0:20:36.02,Default,,0,0,0,,Мен көргім келетін нәрсе...
Dialogue: 0,0:20:36.15,0:20:38.32,Default,,0,0,0,,Мен кездескім келген адам болды.
Dialogue: 0,0:20:38.48,0:20:41.57,Default,,0,0,0,,Бірақ есте қалатын ештеңе қалмады
Dialogue: 0,0:20:43.24,0:20:44.91,Default,,0,0,0,,Менің тілегім орындалды.
Dialogue: 0,0:20:45.07,0:20:46.03,Default,,0,0,0,,Иә
Dialogue: 0,0:20:46.45,0:20:48.24,Default,,0,0,0,,Қараңғы түскенше үйге барғаныңыз жөн.
Dialogue: 0,0:20:48.41,0:20:51.75,Default,,0,0,0,,Иә, мен үйге балапандардың шырылдауын қойғанда барамын.
Dialogue: 0,0:20:55.42,0:20:56.25,Default,,0,0,0,,Асуна —
Dialogue: 0,0:20:57.63,0:20:59.25,Default,,0,0,0,,Бата беру
Dialogue: 0,0:20:59.50,0:21:00.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:05.88,0:21:07.09,Default,,0,0,0,,Көзіңізді жабыңыз
Dialogue: 0,0:21:07.26,0:21:08.26,Default,,0,0,0,,Иә
Dialogue: 0,0:21:10.01,0:21:10.81,Default,,0,0,0,,Ha
Dialogue: 0,0:21:12.18,0:21:13.77,Default,,0,0,0,,А... ха
Dialogue: 0,0:21:14.43,0:21:15.77,Default,,0,0,0,,Мен... қазір
Dialogue: 0,0:21:16.10,0:21:17.77,Default,,0,0,0,,Ум... Ки Ки...
Dialogue: 0,0:21:18.06,0:21:19.56,Default,,0,0,0,,Ки... сүй
Dialogue: 0,0:21:19.94,0:21:20.98,Default,,0,0,0,,Асуна
Dialogue: 0,0:21:21.57,0:21:23.78,Default,,0,0,0,,Мен сенің тірі болғаныңды қалаймын.
Dialogue: 0,0:21:24.53,0:21:25.57,Default,,0,0,0,,Бұл сізге қажет
Dialogue: 0,0:21:25.74,0:21:28.53,Default,,0,0,0,,Е, у... м...
Dialogue: 0,0:21:29.16,0:21:30.91,Default,,0,0,0,,Кешіріңіз, ертең кездескенше
Dialogue: 0,0:21:31.79,0:21:32.66,Default,,0,0,0,,Ах
Dialogue: 0,0:21:36.54,0:21:37.96,Default,,0,0,0,,Ертең кездескенше
Dialogue: 0,0:21:39.29,0:21:40.04,Default,,0,0,0,,Мия?
Dialogue: 0,0:21:50.47,0:21:51.97,Default,,0,0,0,,Хаа ха
Dialogue: 0,0:21:53.43,0:21:55.73,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:22:04.07,0:22:07.90,Default,,0,0,0,,(Асунаның жүрек соғысы)
Dialogue: 0,0:22:08.45,0:22:09.82,Default,,0,0,0,,Пухаа
Dialogue: 0,0:22:11.45,0:22:13.58,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:22:15.04,0:22:17.08,Default,,0,0,0,,Шун…кун
Dialogue: 0,0:22:17.87,0:22:19.92,Default,,0,0,0,,Бұл бала еді...
Dialogue: 0,0:22:20.13,0:22:22.59,Default,,0,0,0,,Соңғы әнді тыңдаған адам болды
Dialogue: 0,0:22:24.17,0:22:26.42,Default,,0,0,0,,Сіздің атыңыз Мими.
Dialogue: 0,0:22:26.67,0:22:27.92,Default,,0,0,0,,Менің орнымда
Dialogue: 0,0:22:28.09,0:22:31.55,Default,,0,0,0,,Асунаны жақсырақ жерге апарыңыз.
Dialogue: 0,0:22:31.89,0:22:34.89,Default,,0,0,0,,Now I'm unbearably scared.
Dialogue: 0,0:22:35.06,0:22:38.39,Default,,0,0,0,,Бірақ дәл сондай бақытты
Dialogue: 0,0:22:43.94,0:22:46.44,Default,,0,0,0,,My hand... seems like it's within reach.
Dialogue: 0,0:23:18.85,0:23:19.89,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:23:23.02,0:23:24.36,Default,,0,0,0,,Мен үйдемін, Асуна.
Dialogue: 0,0:23:24.73,0:23:27.11,Default,,0,0,0,,Қош келдіңіз, түнгі ауысымдағы қажырлы еңбегіңіз үшін рахмет.
Dialogue: 0,0:23:27.28,0:23:29.40,Default,,0,0,0,,Иә, о, екі түскі ас қорабы?
Dialogue: 0,0:23:29.57,0:23:31.36,Default,,0,0,0,,Иә, менің досым үшін.
Dialogue: 0,0:23:31.53,0:23:32.28,Default,,0,0,0,,Иә
Dialogue: 0,0:23:32.45,0:23:34.24,Default,,0,0,0,,Анашым, сіз таңғы ас ішесіз, солай ма?
Dialogue: 0,0:23:34.41,0:23:35.16,Default,,0,0,0,,Иә
Dialogue: 0,0:23:35.33,0:23:37.33,Default,,0,0,0,,Мүмкін мен де сенімен бірге тамақтанармын.
Dialogue: 0,0:23:37.49,0:23:39.87,Default,,0,0,0,,Сіз не туралы айтып отырсыз? You've already eaten, haven't you?
Dialogue: 0,0:23:40.04,0:23:43.13,Default,,0,0,0,,Мен тағы бір кесе жей аламын, бірақ әлі аздап ашпын.
Dialogue: 0,0:23:43.29,0:23:47.13,Default,,0,0,0,,Жоқ, мектепке бару керек, кешікпеу керек.
Dialogue: 0,0:23:48.76,0:23:52.13,Default,,0,0,0,,Асуна, бүгін кешке бір жерге түскі асқа барамыз ба?
Dialogue: 0,0:23:52.30,0:23:54.05,Default,,0,0,0,,I have one day off.
Dialogue: 0,0:23:54.22,0:23:55.64,Default,,0,0,0,,Шынымен бе? —
Dialogue: 0,0:23:55.80,0:23:57.60,Default,,0,0,0,,Жарайды, мен сағат 6-да қайтамын.
Dialogue: 0,0:23:57.76,0:23:58.64,Default,,0,0,0,,Сағат алты? —
Dialogue: 0,0:23:58.89,0:24:01.10,Default,,0,0,0,,Бүгін сенбі, солай ма? Қайда бара жатырсың?
Dialogue: 0,0:24:01.27,0:24:03.77,Default,,0,0,0,,I'm going to my friend's place.
Dialogue: 0,0:24:03.94,0:24:05.48,Default,,0,0,0,,Oh, hey, do you have a scarf?
Dialogue: 0,0:24:05.65,0:24:08.44,Default,,0,0,0,,Мен оны жоғалтып алдым. Сатып алу арқылы сатып алыңыз.
Dialogue: 0,0:24:09.78,0:24:11.15,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:24:17.95,0:24:19.62,Default,,0,0,0,,Сіз доссыз ба?
Dialogue: 0,0:24:19.91,0:24:21.87,Default,,0,0,0,,(цикада дауысы)
Dialogue: 0,0:24:32.88,0:24:35.26,Default,,0,0,0,,(телефон қоңырауы)
Dialogue: 0,0:24:42.35,0:24:44.94,Default,,0,0,0,,Не? Бұл сенімді ме? —
Dialogue: 0,0:24:45.10,0:24:50.78,Default,,0,0,0,,Иә, дұрыс, иә, бәрібір мен саған ертең барамын.
Dialogue: 0,0:25:00.16,0:25:02.12,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:25:14.93,0:25:17.14,Default,,0,0,0,,You said see you tomorrow.
Dialogue: 0,0:25:19.43,0:25:21.26,Default,,0,0,0,,Maybe because it's raining
Dialogue: 0,0:25:25.69,0:25:27.06,Default,,0,0,0,,Мен үйдемін -
Dialogue: 0,0:25:27.56,0:25:30.15,Default,,0,0,0,,Sorry mom, can I have a towel?
Dialogue: 0,0:25:30.86,0:25:33.19,Default,,0,0,0,,Well, you're not soaking wet!
Dialogue: 0,0:25:33.36,0:25:34.15,Default,,0,0,0,,Эхехе…
Dialogue: 0,0:25:34.32,0:25:35.78,Default,,0,0,0,,Didn't you have an umbrella?
Dialogue: 0,0:25:35.95,0:25:39.16,Default,,0,0,0,,Yeah, wait... I can wipe it myself.
Dialogue: 0,0:25:42.20,0:25:44.70,Default,,0,0,0,,Ой... о... Анашым?
Dialogue: 0,0:25:49.04,0:25:50.67,Default,,0,0,0,,А... не?
Dialogue: 0,0:25:51.09,0:25:54.63,Default,,0,0,0,,Сіздің орамалыңызды қолына орап алған баланың денесі
Dialogue: 0,0:25:54.80,0:25:57.47,Default,,0,0,0,,Шимонобучи өзенінің жағасынан табылды.
Dialogue: 0,0:25:58.68,0:26:01.18,Default,,0,0,0,,Asuna That child... passed away.
Dialogue: 0,0:26:03.60,0:26:06.27,Default,,0,0,0,,That's... it's the wrong person.
Dialogue: 0,0:26:06.77,0:26:09.19,Default,,0,0,0,,Because it doesn't fall
Dialogue: 0,0:26:09.35,0:26:10.19,Default,,0,0,0,,Асуна
Dialogue: 0,0:26:10.52,0:26:14.03,Default,,0,0,0,,It's okay, it's different, don't worry.
Dialogue: 0,0:26:14.23,0:26:17.53,Default,,0,0,0,,Аа, жаңбыр жауып тұр... Тағы да сыртта тамақтанғыңыз келе ме? —
Dialogue: 0,0:26:17.70,0:26:19.53,Default,,0,0,0,,I'll do my homework.
Dialogue: 0,0:26:19.70,0:26:20.45,Default,,0,0,0,,Асуна
Dialogue: 0,0:26:20.62,0:26:22.08,Default,,0,0,0,,Әйтеуір, оның қандай жақсылығы бар?
Dialogue: 0,0:26:44.93,0:26:46.93,Default,,0,0,0,,Хахаха
Dialogue: 0,0:26:47.39,0:26:49.73,Default,,0,0,0,,Шун-кун! —
Dialogue: 0,0:26:53.19,0:26:55.44,Default,,0,0,0,,Шун-кун! —
Dialogue: 0,0:26:55.94,0:26:58.07,Default,,0,0,0,,Шун-кун!
Dialogue: 0,0:27:12.17,0:27:15.17,Default,,0,0,0,,Dad, aren't you coming back? —
Dialogue: 0,0:27:16.63,0:27:18.26,Default,,0,0,0,,Сәлем анашым
Dialogue: 0,0:27:25.31,0:27:26.64,Default,,0,0,0,,Мен мұны тілеймін -
Dialogue: 0,0:27:26.77,0:27:29.35,Default,,0,0,0,,I'm sure it's something you shouldn't do.
Dialogue: 0,0:27:29.81,0:27:34.15,Default,,0,0,0,,Әкем өлу өмірдің бір бөлшегі деді...
Dialogue: 0,0:27:34.31,0:27:35.32,Default,,0,0,0,,Бірақ...—
Dialogue: 0,0:27:37.07,0:27:38.53,Default,,0,0,0,,Мен...
Dialogue: 0,0:27:39.78,0:27:42.32,Default,,0,0,0,,(Ананың жылағаны)
Dialogue: 0,0:27:48.37,0:27:52.79,Default,,0,0,0,,“And so his wife died”—
Dialogue: 0,0:27:53.92,0:27:55.79,Default,,0,0,0,,“Izanagi was filled with sadness”—
Dialogue: 0,0:27:56.00,0:27:59.88,Default,,0,0,0,,«Жер астындағы тозақ еліне түсуге бел байладым».
Dialogue: 0,0:28:00.05,0:28:04.47,Default,,0,0,0,,«Өлген әйелім Изанамиді тірілту үшін»
Dialogue: 0,0:28:04.84,0:28:09.31,Default,,0,0,0,,«Әйел күйеуіне жер қойнауында қайта қосылғанда осылай дейді».
Dialogue: 0,0:28:09.47,0:28:13.02,Default,,0,0,0,,«Мен өлілер елінің тұрғыны болдым».
Dialogue: 0,0:28:13.19,0:28:15.86,Default,,0,0,0,,«Бірақ тозақ құдайының рұқсатымен»—
Dialogue: 0,0:28:16.02,0:28:18.36,Default,,0,0,0,,““I can return to you””—
Dialogue: 0,0:28:18.73,0:28:21.57,Default,,0,0,0,,«Бұл үшін бір ғана шарт бар».
Dialogue: 0,0:28:21.74,0:28:24.61,Default,,0,0,0,,«Мен Құдаймен сөйлескен кезде»—
Dialogue: 0,0:28:24.78,0:28:28.87,Default,,0,0,0,,““Don’t ever look at me”—
Dialogue: 0,0:28:29.37,0:28:32.29,Default,,0,0,0,,“But Izanagi breaks that promise.”
Dialogue: 0,0:28:32.46,0:28:34.96,Default,,0,0,0,,“I have opened the door to Hades.”
Dialogue: 0,0:28:36.38,0:28:40.17,Default,,0,0,0,,«Менің әйелім ешқашан Изанагиге оралмайды».
Dialogue: 0,0:28:40.84,0:28:44.26,Default,,0,0,0,,Бұл коджикиде жазылған мифтен үзінді.
Dialogue: 0,0:28:45.39,0:28:48.05,Default,,0,0,0,,He goes underground to revive his lover.
Dialogue: 0,0:28:48.22,0:28:52.31,Default,,0,0,0,,Осыған ұқсас мифтер мен аңыздар бүкіл әлемде кездеседі—
Dialogue: 0,0:28:52.89,0:28:53.81,Default,,0,0,0,,Тозақ елі
Dialogue: 0,0:28:54.23,0:28:57.02,Default,,0,0,0,,Hades Shambhala Agartha
Dialogue: 0,0:28:57.31,0:28:58.15,Default,,0,0,0,,Ha
Dialogue: 0,0:29:00.98,0:29:02.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:29:03.70,0:29:05.78,Default,,0,0,0,,Although called differently
Dialogue: 0,0:29:05.91,0:29:08.53,Default,,0,0,0,,Олардың барлығы жер асты әлемінің бар екенін көрсетеді —
Dialogue: 0,0:29:09.37,0:29:11.83,Default,,0,0,0,,Ертеде адамдар жер астында өмір сүрген
Dialogue: 0,0:29:11.95,0:29:15.33,Default,,0,0,0,,Олар адам өлімінің сыры бар деп ойлады.
Dialogue: 0,0:29:18.92,0:29:21.46,Default,,0,0,0,,Бәріңе, мектептен үйге қайтатын уақыт келді.
Dialogue: 0,0:29:21.63,0:29:23.55,Default,,0,0,0,,What's wrong with Asuna?
Dialogue: 0,0:29:23.76,0:29:27.84,Default,,0,0,0,,Жоқ, ол өте ынталы еді, сондықтан мен оның қандай оқушы екеніне таң қалдым.
Dialogue: 0,0:29:28.01,0:29:31.64,Default,,0,0,0,,Yes, he is a quiet and very nice child.
Dialogue: 0,0:29:31.81,0:29:34.43,Default,,0,0,0,,But your father passed away early...
Dialogue: 0,0:29:34.60,0:29:37.35,Default,,0,0,0,,Сенің анаң медбике болып жұмыстан бос емес сияқты.
Dialogue: 0,0:29:37.52,0:29:38.56,Default,,0,0,0,,As long as you are good at hearing—
Dialogue: 0,0:29:38.69,0:29:40.57,Default,,0,0,0,,I think you're pushing yourself too hard.
Dialogue: 0,0:29:40.94,0:29:42.32,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:29:42.61,0:29:43.69,Default,,0,0,0,,Ал бұрын-
Dialogue: 0,0:29:43.82,0:29:47.07,Default,,0,0,0,,Белгісіз баланың денесі табылды, солай ма?
Dialogue: 0,0:29:47.28,0:29:49.07,Default,,0,0,0,,Asuna-chan, are you going home?
Dialogue: 0,0:29:49.24,0:29:50.37,Default,,0,0,0,,Ю-чан
Dialogue: 0,0:29:50.53,0:29:53.79,Default,,0,0,0,,Менің Морисаки мырзадан сұрайын дегенім бар.
Dialogue: 0,0:29:53.95,0:29:56.25,Default,,0,0,0,,Маған ол мұғалім аздап ұнамайды.
Dialogue: 0,0:29:56.37,0:29:58.29,Default,,0,0,0,,Бүгінгі сабақта да қорқынышты болды.
Dialogue: 0,0:29:58.46,0:29:59.21,Default,,0,0,0,,Қорқынышты ма?
Dialogue: 0,0:29:59.46,0:30:01.13,Default,,0,0,0,,Бұл жай ғана өсек
Dialogue: 0,0:30:01.29,0:30:03.71,Default,,0,0,0,,Мұғалімнің әйелі қайтыс болды.
Dialogue: 0,0:30:03.96,0:30:04.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:07.68,0:30:09.14,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:30:09.39,0:30:10.68,Default,,0,0,0,,Дегенмен—
Dialogue: 0,0:30:10.85,0:30:12.47,Default,,0,0,0,,Ол үйіне кетіп қалды.
Dialogue: 0,0:30:14.85,0:30:17.27,Default,,0,0,0,,Ертең кездескенше.
Dialogue: 0,0:30:40.67,0:30:43.46,Default,,0,0,0,,(музыкалық қораптың дыбысы)
Dialogue: 0,0:30:46.71,0:30:48.47,Default,,0,0,0,,(алдыңғы есіктің дыбысы)
Dialogue: 0,0:30:51.01,0:30:52.01,Default,,0,0,0,,Сен…
Dialogue: 0,0:30:52.18,0:30:53.76,Default,,0,0,0,,Осы суретте олар мінсіз жұп сияқты көрінеді, иә?
Dialogue: 0,0:30:53.89,0:30:57.27,Default,,0,0,0,,Мұғалімнен сұрайын дегенім бар.
Dialogue: 0,0:30:58.23,0:31:00.52,Default,,0,0,0,,Сәл күте аласыз ба?
Dialogue: 0,0:31:05.23,0:31:06.69,Default,,0,0,0,,Кофе ішуге бола ма?
Dialogue: 0,0:31:06.86,0:31:10.03,Default,,0,0,0,,Сәлем! Біраз сүт қосыңыз
Dialogue: 0,0:31:11.03,0:31:12.45,Default,,0,0,0,,Рахмет
Dialogue: 0,0:31:12.62,0:31:15.20,Default,,0,0,0,,Мм... Сізді кенеттен бөлгенім үшін кешіріңіз.
Dialogue: 0,0:31:15.37,0:31:17.70,Default,,0,0,0,,Сіз тұратын жердегі Икеда мырзадан тыңдау
Dialogue: 0,0:31:17.87,0:31:21.17,Default,,0,0,0,,Көріп тұрғаныңыздай, мен жалғыз тұрамын. Ұялудың қажеті жоқ.
Dialogue: 0,0:31:21.33,0:31:25.55,Default,,0,0,0,,Мен мұнда жаңа ғана көшіп келдім, менде бірнеше ғана кітаптар бар.
Dialogue: 0,0:31:26.30,0:31:28.51,Default,,0,0,0,,Сонымен не болды?
Dialogue: 0,0:31:28.67,0:31:31.47,Default,,0,0,0,,А, у... бүгінгі сабақ туралы.
Dialogue: 0,0:31:31.63,0:31:34.64,Default,,0,0,0,,Сіз өте мұқият тыңдадыңыз.
Dialogue: 0,0:31:34.80,0:31:36.85,Default,,0,0,0,,Өмірге қайтарғыңыз келетін адам бар ма?
Dialogue: 0,0:31:37.10,0:31:38.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:31:38.73,0:31:41.73,Default,,0,0,0,,Агартандық баланы кездестірдім деген сен бе?
Dialogue: 0,0:31:41.90,0:31:43.27,Default,,0,0,0,,(Шинсоның дем алған дыбысы)
Dialogue: 0,0:31:44.40,0:31:46.15,Default,,0,0,0,,Мынаны қараңыз
Dialogue: 0,0:31:53.82,0:31:54.74,Default,,0,0,0,,Ах!
Dialogue: 0,0:31:54.91,0:31:57.66,Default,,0,0,0,,Біз оны «Кетцаль» деп атаймыз
Dialogue: 0,0:31:58.16,0:32:01.21,Default,,0,0,0,,Агартаға кіретін есікті қорғайтын қақпашы.
Dialogue: 0,0:32:01.66,0:32:04.54,Default,,0,0,0,,Тағы бір нәрсе: Бұл туралы не ойлайсыз?
Dialogue: 0,0:32:06.71,0:32:09.30,Default,,0,0,0,,Бұл алдыңғыға сәл ұқсас.
Dialogue: 0,0:32:09.46,0:32:13.22,Default,,0,0,0,,Бұл 3000 жыл бұрынғы көне шумер құдайының мүсіні.
Dialogue: 0,0:32:13.38,0:32:16.72,Default,,0,0,0,,Бір кездері әлемнің кез келген жерінде осындай құдайлар болған.
Dialogue: 0,0:32:16.89,0:32:19.72,Default,,0,0,0,,Адамзат әлі жас кезінде жол көрсеткен.
Dialogue: 0,0:32:19.89,0:32:22.10,Default,,0,0,0,,Бұл Кецальль
Dialogue: 0,0:32:22.52,0:32:26.61,Default,,0,0,0,,Ақырында адамзат өсіп, құдайлардың бар болуы қажетсіз болып қалады.
Dialogue: 0,0:32:26.77,0:32:29.61,Default,,0,0,0,,Кецальльдер өз рөлінің аяқталғанын түсінді.
Dialogue: 0,0:32:29.78,0:32:31.86,Default,,0,0,0,,Қақпашыны қалдырып, жер астына кетті.
Dialogue: 0,0:32:32.03,0:32:34.07,Default,,0,0,0,,Кейбір кландарға қатысыңыз
Dialogue: 0,0:32:34.24,0:32:35.20,Default,,0,0,0,,Шизоку?
Dialogue: 0,0:32:35.45,0:32:39.66,Default,,0,0,0,,Кветцальмен бірге аздаған адамдар жер астына кеткені айтылады.
Dialogue: 0,0:32:40.04,0:32:42.46,Default,,0,0,0,,Бұл Агартаның жер асты әлемі.
Dialogue: 0,0:32:42.62,0:32:46.21,Default,,0,0,0,,Құдайлардың жоғалған даналығы әлі күнге дейін Агартада сақталған.
Dialogue: 0,0:32:46.38,0:32:49.34,Default,,0,0,0,,Барлық тілек орындалатын жер бар дейді.
Dialogue: 0,0:32:49.50,0:32:51.17,Default,,0,0,0,,Тіпті өлгендердің қайта тірілуі
Dialogue: 0,0:32:51.76,0:32:52.51,Default,,0,0,0,,Ха!
Dialogue: 0,0:32:53.38,0:32:55.01,Default,,0,0,0,,Агарта шынымен ме?
Dialogue: 0,0:32:57.64,0:33:00.64,Default,,0,0,0,,Жарайды, бұл жай ғана аңыз шығар.
Dialogue: 0,0:33:00.85,0:33:05.40,Default,,0,0,0,,Әртүрлі теориялар бар, бірақ мен тек зерттеу жүргізіп жатырмын.
Dialogue: 0,0:33:05.56,0:33:06.90,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:33:05.94,0:33:07.90,Default,,0,0,0,,(радио дыбысы)
Dialogue: 0,0:33:07.90,0:33:08.61,Default,,0,0,0,,Қазір үйге қайт, қараңғы түсті. (радио дыбысы)
Dialogue: 0,0:33:08.61,0:33:10.53,Default,,0,0,0,,Қазір үйге қайт, қараңғы түсті.
Dialogue: 0,0:33:12.07,0:33:13.82,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:33:15.32,0:33:17.20,Default,,0,0,0,,Менің ойымша, бұл өте пайдалы болмады.
Dialogue: 0,0:33:17.37,0:33:19.03,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:33:19.28,0:33:23.66,Default,,0,0,0,,Мұғалім, мен Агарта бар екеніне сенімдімін.
Dialogue: 0,0:33:26.29,0:33:27.83,Default,,0,0,0,,Жақында түн келеді
Dialogue: 0,0:33:28.04,0:33:30.59,Default,,0,0,0,,Айналма жолдарсыз тура үйге барыңыз
Dialogue: 0,0:33:43.56,0:33:44.81,Default,,0,0,0,,Ах! мими
Dialogue: 0,0:33:44.98,0:33:45.73,Default,,0,0,0,,Мияу
Dialogue: 0,0:33:46.69,0:33:48.44,Default,,0,0,0,,Эй, эй Мими
Dialogue: 0,0:33:50.73,0:33:52.11,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:33:54.69,0:33:56.36,Default,,0,0,0,,Мими қайда орналасқан?
Dialogue: 0,0:33:56.70,0:33:57.70,Default,,0,0,0,,Мен оны фортепиано сабағында үйрендім.
Dialogue: 0,0:34:03.33,0:34:04.08,Default,,0,0,0,,Ах… «C» рейтингі
Dialogue: 0,0:34:05.04,0:34:07.04,Default,,0,0,0,,Ха ха ха—
Dialogue: 0,0:34:08.67,0:34:10.63,Default,,0,0,0,,Ха ха ха...—
Dialogue: 0,0:34:13.50,0:34:16.05,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:34:29.40,0:34:31.73,Default,,0,0,0,,Шун-кун Шун-кун! —
Dialogue: 0,0:34:32.23,0:34:33.36,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:34:35.07,0:34:36.90,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:34:37.07,0:34:39.74,Default,,0,0,0,,Ол жер бетіндегі адамдармен байланыста болды ма?
Dialogue: 0,0:34:40.07,0:34:41.49,Default,,0,0,0,,Шун-кун?
Dialogue: 0,0:34:41.66,0:34:45.24,Default,,0,0,0,,Ол кетті. Болғанның бәрін ұмыт.
Dialogue: 0,0:34:45.41,0:34:46.45,Default,,0,0,0,,Е...
Dialogue: 0,0:34:47.00,0:34:48.92,Default,,0,0,0,,(Тікұшақтың дыбысы)
Dialogue: 0,0:34:49.17,0:34:50.42,Default,,0,0,0,,Бұл тек Шигараки Томира басқаратын Зұлымдар Альянсы ғана емес.
Dialogue: 0,0:34:52.25,0:34:55.25,Default,,0,0,0,,Архангели, мен қазір кетемін.
Dialogue: 0,0:34:56.01,0:34:57.09,Default,,0,0,0,,Ах
Dialogue: 0,0:34:59.80,0:35:04.10,Default,,0,0,0,,Маған агарталық бала Клависті беріңізші.
Dialogue: 0,0:35:04.26,0:35:06.60,Default,,0,0,0,,Не? бұл адамдар
Dialogue: 0,0:35:09.48,0:35:10.77,Default,,0,0,0,,Ах!
Dialogue: 0,0:35:11.65,0:35:12.61,Default,,0,0,0,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,0:35:12.94,0:35:13.98,Default,,0,0,0,,Не? —
Dialogue: 0,0:35:17.61,0:35:19.40,Default,,0,0,0,,Кяах!
Dialogue: 0,0:35:25.24,0:35:26.45,Default,,0,0,0,,Болмау.
Dialogue: 0,0:35:26.66,0:35:28.79,Default,,0,0,0,,Мені бұрылыста ұстап, сізге жол көрсетуге рұқсат етіңіз.
Dialogue: 0,0:35:42.22,0:35:43.59,Default,,0,0,0,,Әшекей...
Dialogue: 0,0:35:43.89,0:35:45.18,Default,,0,0,0,,Клавис? —
Dialogue: 0,0:35:45.35,0:35:47.77,Default,,0,0,0,,Мен жерге осыны қайтару үшін келдім.
Dialogue: 0,0:35:47.93,0:35:51.44,Default,,0,0,0,,Енді олар кіре алмайды, таңды күтіп, үйге қайт.
Dialogue: 0,0:35:51.60,0:35:52.60,Default,,0,0,0,,Жер дегеніміз не?
Dialogue: 0,0:35:52.90,0:35:55.19,Default,,0,0,0,,Агарта жер астында жатыр ма?
Dialogue: 0,0:35:55.36,0:35:57.48,Default,,0,0,0,,Сіз бұл туралы сұрап тұрсыз ба?
Dialogue: 0,0:35:57.65,0:36:00.40,Default,,0,0,0,,Шун-кун, мүмкін жадыңды жоғалтқан шығарсың?
Dialogue: 0,0:36:00.57,0:36:01.61,Default,,0,0,0,,Не ойнап жүрсің?
Dialogue: 0,0:36:04.16,0:36:05.41,Default,,0,0,0,,Осының ішінде
Dialogue: 0,0:36:19.46,0:36:21.92,Default,,0,0,0,,Қат! Олар кіріп жатыр.
Dialogue: 0,0:36:35.35,0:36:37.82,Default,,0,0,0,,Эй, қанша...
Dialogue: 0,0:36:38.44,0:36:39.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:36:40.19,0:36:42.24,Default,,0,0,0,,Тез кел, біз сені қуып жетеміз.
Dialogue: 0,0:36:42.40,0:36:44.41,Default,,0,0,0,,Шун-кун, бұл үңгір
Dialogue: 0,0:36:44.57,0:36:46.62,Default,,0,0,0,,Айттым ғой, мен Шун емеспін.
Dialogue: 0,0:36:47.28,0:36:49.62,Default,,0,0,0,,Негізі мен сізге көмектесуге міндетті емеспін.
Dialogue: 0,0:36:49.83,0:36:52.04,Default,,0,0,0,,Не болды? —
Dialogue: 0,0:36:52.21,0:36:54.54,Default,,0,0,0,,Әй, Шун-кун болмаса, ол кім?
Dialogue: 0,0:36:56.17,0:36:58.79,Default,,0,0,0,,Тыныш бол, сен осында қал.
Dialogue: 0,0:36:58.96,0:36:59.71,Default,,0,0,0,,Не?
Dialogue: 0,0:36:59.88,0:37:00.63,Default,,0,0,0,,Қақпашы
Dialogue: 0,0:37:09.72,0:37:10.51,Default,,0,0,0,,Ах
Dialogue: 0,0:37:10.68,0:37:11.93,Default,,0,0,0,,Қақпашы дегеніміз не?
Dialogue: 0,0:37:12.10,0:37:15.27,Default,,0,0,0,,Ертеде ол адамдарға жол көрсетуші болған.
Dialogue: 0,0:37:15.44,0:37:18.48,Default,,0,0,0,,Бірақ жердегі лас атмосфераға байланысты—
Dialogue: 0,0:37:18.65,0:37:20.82,Default,,0,0,0,,Енді мен есінен танып қала жаздадым...
Dialogue: 0,0:37:21.90,0:37:23.90,Default,,0,0,0,,Есіңізде болар деп үміттенемін
Dialogue: 0,0:37:27.82,0:37:28.66,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:37:32.66,0:37:33.41,Default,,0,0,0,,Шун-кун!
Dialogue: 0,0:37:33.58,0:37:34.87,Default,,0,0,0,,Сол жерде болыңыз!
Dialogue: 0,0:37:46.43,0:37:47.39,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:37:47.55,0:37:49.64,Default,,0,0,0,,Әлі біткен жоқ. Крависті ұстаңыз.
Dialogue: 0,0:37:49.80,0:37:50.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:50.76,0:37:52.10,Default,,0,0,0,,Мен сені өлтіргім келмейді...
Dialogue: 0,0:37:52.27,0:37:53.77,Default,,0,0,0,,Әйтеуір, ұйықтайыншы!
Dialogue: 0,0:37:56.39,0:37:58.77,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:38:04.82,0:38:05.61,Default,,0,0,0,,Хамф!
Dialogue: 0,0:38:05.78,0:38:07.15,Default,,0,0,0,,Гауееее...
Dialogue: 0,0:38:09.53,0:38:10.32,Default,,0,0,0,,Хаа!
Dialogue: 0,0:38:19.67,0:38:21.84,Default,,0,0,0,,Ә? Аймақ па?
Dialogue: 0,0:38:22.04,0:38:22.84,Default,,0,0,0,,Ах… «C» рейтингі
Dialogue: 0,0:38:25.42,0:38:26.34,Default,,0,0,0,,Хмм… Дегенмен, егер сол лас—
Dialogue: 0,0:38:26.72,0:38:28.80,Default,,0,0,0,,Шун-кун Шун-кун!
Dialogue: 0,0:38:28.97,0:38:30.22,Default,,0,0,0,,Гвуу…
Dialogue: 0,0:38:33.31,0:38:34.10,Default,,0,0,0,,Уау!
Dialogue: 0,0:38:34.27,0:38:35.56,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:38:35.73,0:38:38.02,Default,,0,0,0,,Гоооооо!
Dialogue: 0,0:38:38.48,0:38:39.56,Default,,0,0,0,,Ах!
Dialogue: 0,0:38:40.86,0:38:44.94,Default,,0,0,0,,Кецаль бар... Өйткені, бұл кіреберіс.
Dialogue: 0,0:38:45.11,0:38:47.36,Default,,0,0,0,,Амансың ба? Қашайық
Dialogue: 0,0:38:47.53,0:38:51.91,Default,,0,0,0,,Бұл жойылды деп болжанған Пакицетус па?
Dialogue: 0,0:38:53.49,0:38:54.29,Default,,0,0,0,,Иә
Dialogue: 0,0:38:54.45,0:38:55.20,Default,,0,0,0,,Бірақ мен Юлий деген адам емеспін.
Dialogue: 0,0:38:55.45,0:38:58.46,Default,,0,0,0,,Бұл 50 миллион жыл бұрынғы көне кит. Өлтір.
Dialogue: 0,0:38:58.62,0:39:01.17,Default,,0,0,0,,Бірақ мен сендерге барлық белгілерді жинаңдар дедім.
Dialogue: 0,0:39:01.33,0:39:03.67,Default,,0,0,0,,Егер мен Клависті ала алсам, мен шағымданбаймын.
Dialogue: 0,0:39:03.84,0:39:04.80,Default,,0,0,0,,Қане — бұл тіпті шамамен есеп те емес, жай ғана ойым
Dialogue: 0,0:39:05.80,0:39:06.71,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:39:16.35,0:39:18.39,Default,,0,0,0,,Клавис қолында осында кел...
Dialogue: 0,0:39:18.64,0:39:20.27,Default,,0,0,0,,Әйтпесе баланы өлтіріңіз
Dialogue: 0,0:39:20.44,0:39:21.19,Default,,0,0,0,,18-ші эпизод: Венецияға!
Dialogue: 0,0:39:22.36,0:39:24.90,Default,,0,0,0,,Сіз екеуін де осы жерде өлтіре аласыз.
Dialogue: 0,0:39:25.36,0:39:26.61,Default,,0,0,0,,Шун-кун
Dialogue: 0,0:39:27.69,0:39:29.03,Default,,0,0,0,,Мүмкіндік туындаған кезде көмек көрсету
Dialogue: 0,0:39:29.20,0:39:30.20,Default,,0,0,0,,Иә
Dialogue: 0,0:39:36.41,0:39:38.00,Default,,0,0,0,,Ах
Dialogue: 0,0:39:38.16,0:39:39.41,Default,,0,0,0,,Тоқтамай кел
Dialogue: 0,0:39:45.88,0:39:47.55,Default,,0,0,0,,Баланы мына жерден бақылаңыз.
Dialogue: 0,0:39:47.71,0:39:49.01,Default,,0,0,0,,Бұл есік пе?
Dialogue: 0,0:39:49.17,0:39:50.42,Default,,0,0,0,,Мүмкін—
Dialogue: 0,0:39:50.59,0:39:54.43,Default,,0,0,0,,Антарктика жағдайында жарылғыш заттар да, балғалар да жұмыс істемеген сияқты.
Dialogue: 0,0:39:54.97,0:39:56.06,Default,,0,0,0,,Хмм
Dialogue: 0,0:40:04.06,0:40:06.73,Default,,0,0,0,,Сол шамды Клависпен түртіңіз—
Dialogue: 0,0:40:09.53,0:40:11.49,Default,,0,0,0,,Не болды? Жаса.
Dialogue: 0,0:40:15.57,0:40:16.70,Default,,0,0,0,,Ах
Dialogue: 0,0:40:19.08,0:40:20.54,Default,,0,0,0,,Бұл теңіз ... арасындағы теңіз.
Dialogue: 0,0:40:20.83,0:40:22.79,Default,,0,0,0,,Соңында қол жеткізуге болады
Dialogue: 0,0:40:24.04,0:40:24.83,Default,,0,0,0,,Ах
Dialogue: 0,0:40:25.21,0:40:26.29,Default,,0,0,0,,Қиындықпен бірге жүреді
Dialogue: 0,0:40:26.46,0:40:28.13,Default,,0,0,0,,Подполковник! Не...
Dialogue: 0,0:40:28.30,0:40:30.80,Default,,0,0,0,,Мен осы жерден өзім барамын...
Dialogue: 0,0:40:31.76,0:40:34.43,Default,,0,0,0,,Еуропаның қарттарына сәлем айт.
Dialogue: 0,0:40:35.80,0:40:36.93,Default,,0,0,0,,Хигучи расталды.
Dialogue: 0,0:40:42.35,0:40:43.44,Default,,0,0,0,,Шун-кун!
Dialogue: 0,0:40:45.44,0:40:46.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:40:54.20,0:40:55.53,Default,,0,0,0,,Не ойнап жүрсің?
Dialogue: 0,0:40:59.03,0:41:00.54,Default,,0,0,0,,Ах, Морисаки мырза
Dialogue: 0,0:41:00.70,0:41:03.96,Default,,0,0,0,,Енді осы уақытқа дейін келген соң, саған дұшпандық көрсетуге еш себеп жоқ.
Dialogue: 0,0:41:04.12,0:41:06.29,Default,,0,0,0,,Мен тек Агартаға барғым келеді.
Dialogue: 0,0:41:06.46,0:41:08.46,Default,,0,0,0,,Агарта — жойылатын жер.
Dialogue: 0,0:41:08.63,0:41:11.71,Default,,0,0,0,,Архангели күткендей ештеңе жоқ.
Dialogue: 0,0:41:11.96,0:41:15.47,Default,,0,0,0,,Мен өлмейтіндіктің құпиясын да, ежелгі даналықты да қаламаймын...
Dialogue: 0,0:41:15.97,0:41:18.80,Default,,0,0,0,,Мен әйелімнің тірі болғанын қалаймын.
Dialogue: 0,0:41:22.81,0:41:24.60,Default,,0,0,0,,Қалағаныңды істе—
Dialogue: 0,0:41:24.77,0:41:27.52,Default,,0,0,0,,Менің рөлім тек Крависті шығарып алу.
Dialogue: 0,0:41:28.65,0:41:30.27,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:41:30.44,0:41:31.32,Default,,0,0,0,,Асуна
Dialogue: 0,0:41:31.73,0:41:34.15,Default,,0,0,0,,Мен Шин Шунның інісімін.
Dialogue: 0,0:41:34.32,0:41:36.78,Default,,0,0,0,,Шин? Сонда Шун ше?
Dialogue: 0,0:41:36.95,0:41:38.16,Default,,0,0,0,,Менің ағам қайтыс болды
Dialogue: 0,0:41:38.53,0:41:40.99,Default,,0,0,0,,Жер бетінде ұзақ өмір сүрмеуге дайын болыңыз.
Dialogue: 0,0:41:41.16,0:41:43.33,Default,,0,0,0,,Ереже бұзып, далаға шықтым.
Dialogue: 0,0:41:44.21,0:41:45.66,Default,,0,0,0,,Мен қазір кетемін
Dialogue: 0,0:41:46.04,0:41:48.50,Default,,0,0,0,,Шығу Клависсіз ашылады
Dialogue: 0,0:41:49.50,0:41:50.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:41:56.01,0:41:57.43,Default,,0,0,0,,Қатысқаныма менің кінәм болды.
Dialogue: 0,0:41:58.18,0:41:59.09,Default,,0,0,0,,Асуна
Dialogue: 0,0:41:59.26,0:42:00.43,Default,,0,0,0,,Шин
Dialogue: 0,0:42:17.11,0:42:19.45,Default,,0,0,0,,Мен саған қорқынышты сезім бердім.
Dialogue: 0,0:42:19.70,0:42:22.08,Default,,0,0,0,,Морисаки Сенсей, неге...
Dialogue: 0,0:42:22.37,0:42:24.45,Default,,0,0,0,,Архангели есімін білесіз бе?
Dialogue: 0,0:42:24.66,0:42:25.54,Default,,0,0,0,,Жоқ
Dialogue: 0,0:42:25.70,0:42:29.00,Default,,0,0,0,,Агартаның бар екенін білетін жалғыз ұйым.
Dialogue: 0,0:42:29.17,0:42:33.55,Default,,0,0,0,,Жер асты әлемінің даналығын алып, адамзатты жақсы жолға салуға ұмтылу.
Dialogue: 0,0:42:34.26,0:42:35.71,Default,,0,0,0,,Мен солардың бірімін
Dialogue: 0,0:42:35.88,0:42:38.63,Default,,0,0,0,,Мен 10 жыл бойы Агартаға кіретін жерді іздедім.
Dialogue: 0,0:42:38.80,0:42:41.35,Default,,0,0,0,,Бірақ менімен бірге болған адамдар
Dialogue: 0,0:42:41.93,0:42:45.60,Default,,0,0,0,,Архангели шын мәнінде бос гностиктердің бір тобы.
Dialogue: 0,0:42:45.77,0:42:49.02,Default,,0,0,0,,Мен Құдайдың да, дүниенің ақиқатына да қызықпаймын.
Dialogue: 0,0:42:49.19,0:42:51.56,Default,,0,0,0,,Бір ғана мақсат – әйелімді тірілту.
Dialogue: 0,0:42:52.82,0:42:56.36,Default,,0,0,0,,Мен Агартаға барып, жол іздеймін.
Dialogue: 0,0:42:57.03,0:43:00.24,Default,,0,0,0,,Сізге қауіп төндіргенім үшін кешіріңіз.
Dialogue: 0,0:43:08.87,0:43:10.71,Default,,0,0,0,,Бұл әлі де Vitaqua.
Dialogue: 0,0:43:11.88,0:43:13.17,Default,,0,0,0,,Мұғалім! —
Dialogue: 0,0:43:18.26,0:43:20.34,Default,,0,0,0,,Мұғалім, мен де барамын!
Dialogue: 0,0:43:20.76,0:43:24.05,Default,,0,0,0,,Неліктен? Қайтыс болған баланы тірілткіңіз келе ме?
Dialogue: 0,0:43:24.22,0:43:25.35,Default,,0,0,0,,Бұл...
Dialogue: 0,0:43:25.68,0:43:27.27,Default,,0,0,0,,Мен білмеймін, бірақ...
Dialogue: 0,0:43:27.43,0:43:28.35,Default,,0,0,0,,Бірақ!
Dialogue: 0,0:43:31.73,0:43:35.61,Default,,0,0,0,,Бұл қауіпті сапар болуы мүмкін және біз қашан оралатынымызды білмейміз.
Dialogue: 0,0:43:35.77,0:43:36.82,Default,,0,0,0,,Иә
Dialogue: 0,0:43:37.07,0:43:38.24,Default,,0,0,0,,Кел
Dialogue: 0,0:43:45.87,0:43:46.70,Default,,0,0,0,,Ах!
Dialogue: 0,0:43:46.87,0:43:49.29,Default,,0,0,0,,Бұл Vitaqua деп аталатын ежелгі сұйықтық.
Dialogue: 0,0:43:49.46,0:43:52.25,Default,,0,0,0,,Қалқыма дерлік жоқ және өкпеңіз толған болса, дем аласыз.
Dialogue: 0,0:43:52.54,0:43:54.46,Default,,0,0,0,,Агарта мұның түбінде
Dialogue: 0,0:43:54.63,0:43:56.63,Default,,0,0,0,,Е... Мұғалім, сәл күте тұрыңыз.
Dialogue: 0,0:43:56.80,0:43:59.26,Default,,0,0,0,,Жарайды, тек су іш, дем аласың.
Dialogue: 0,0:43:59.63,0:44:01.38,Default,,0,0,0,,Маңызды нәрсені қайтару үшін! —
Dialogue: 0,0:44:01.84,0:44:03.47,Default,,0,0,0,,Дайын бол, Асуна!
Dialogue: 0,0:44:03.64,0:44:04.39,Default,,0,0,0,,Ах!
Dialogue: 0,0:45:26.43,0:45:27.09,Default,,0,0,0,,(Жүректің әлсіз соғуы)
Dialogue: 0,0:45:27.09,0:45:28.93,Default,,0,0,0,,Жақында кездескенше (әлсіз жүрек соғысы)
Dialogue: 0,0:45:28.93,0:45:29.43,Default,,0,0,0,,(Жүректің әлсіз соғуы)
Dialogue: 0,0:45:29.10,0:45:33.98,Default,,0,0,0,,Жарайды, бұл баланың өмірі берекеге толы болса екен деймін. (әлсіз жүрек соғысы)
Dialogue: 0,0:45:34.31,0:45:39.90,Default,,0,0,0,,Жарайды, тек дүниеге келгеннің өзі бақытты өмір.
Dialogue: 0,0:45:40.48,0:45:42.48,Default,,0,0,0,,А... дұрыс...
Dialogue: 0,0:45:43.69,0:45:47.03,Default,,0,0,0,,Мен жақында туылуым керек
Dialogue: 0,0:45:59.96,0:46:00.75,Default,,0,0,0,,Жұлдыз…
Dialogue: 0,0:46:00.92,0:46:01.63,Default,,0,0,0,,Мияу
Dialogue: 0,0:46:01.80,0:46:02.59,Default,,0,0,0,,Ha
Dialogue: 0,0:46:04.55,0:46:05.51,Default,,0,0,0,,Мими
Dialogue: 0,0:46:16.44,0:46:17.90,Default,,0,0,0,,Сіз ояусыз ба?
Dialogue: 0,0:46:18.19,0:46:19.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:46:20.65,0:46:23.03,Default,,0,0,0,,Ол сіздің рюкзактарыңыздан шықты—
Dialogue: 0,0:46:23.19,0:46:24.86,Default,,0,0,0,,Оны әкелдің бе?
Dialogue: 0,0:46:25.03,0:46:26.11,Default,,0,0,0,,Жоқ
Dialogue: 0,0:46:26.40,0:46:28.03,Default,,0,0,0,,Сен қашан білдің?
Dialogue: 0,0:46:28.20,0:46:31.16,Default,,0,0,0,,Менде сені соңына дейін жеткізуге мүмкіндігім жоқ шығар.
Dialogue: 0,0:46:31.33,0:46:33.29,Default,,0,0,0,,Мені ал... А!
Dialogue: 0,0:46:33.62,0:46:35.12,Default,,0,0,0,,Мұғалім, бұл...
Dialogue: 0,0:46:35.29,0:46:38.46,Default,,0,0,0,,Біз сол жақтағы баспалдақпен өте алатын сияқтымыз. Барайық.
Dialogue: 0,0:46:47.63,0:46:48.59,Default,,0,0,0,,Сізге не керек?
Dialogue: 0,0:46:48.76,0:46:49.72,Default,,0,0,0,,Ах—
Dialogue: 0,0:46:50.80,0:46:53.81,Default,,0,0,0,,Бәлкім, қақпашы... Кецальтль.
Dialogue: 0,0:46:54.47,0:46:55.81,Default,,0,0,0,,Саған қарап
Dialogue: 0,0:46:55.97,0:46:57.35,Default,,0,0,0,,Жалғыз жол - алдыңғы жақтан.
Dialogue: 0,0:46:58.14,0:46:59.44,Default,,0,0,0,,Әй, Мими!
Dialogue: 0,0:47:02.61,0:47:04.44,Default,,0,0,0,,Гррр…
Dialogue: 0,0:47:06.03,0:47:08.36,Default,,0,0,0,,Ә? Аймақ па?
Dialogue: 0,0:47:09.32,0:47:10.99,Default,,0,0,0,,Ах
Dialogue: 0,0:47:16.45,0:47:19.16,Default,,0,0,0,,Ә? Аймақ па?
Dialogue: 0,0:47:19.33,0:47:20.50,Default,,0,0,0,,Мими, жүр!
Dialogue: 0,0:47:20.67,0:47:21.79,Default,,0,0,0,,Асуна
Dialogue: 0,0:47:22.04,0:47:23.13,Default,,0,0,0,,Мими
Dialogue: 0,0:47:24.00,0:47:25.21,Default,,0,0,0,,Мя
Dialogue: 0,0:47:28.01,0:47:28.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:47:29.30,0:47:32.34,Default,,0,0,0,,(Кветцаль дауысы)
Dialogue: 0,0:47:32.72,0:47:33.76,Default,,0,0,0,,Асуна —
Dialogue: 0,0:47:34.05,0:47:35.01,Default,,0,0,0,,Кеттік
Dialogue: 0,0:47:37.39,0:47:40.10,Default,,0,0,0,,Бұл күтпеген жерден пайдалы болуы мүмкін.
Dialogue: 0,0:47:46.19,0:47:47.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:48:02.87,0:48:04.29,Default,,0,0,0,,Уау
Dialogue: 0,0:48:04.46,0:48:05.71,Default,,0,0,0,,Агарта
Dialogue: 0,0:48:05.88,0:48:06.75,Default,,0,0,0,,Ах… «C» рейтингі
Dialogue: 0,0:48:08.13,0:48:09.84,Default,,0,0,0,,Мұғалім бұл!
Dialogue: 0,0:48:10.30,0:48:14.05,Default,,0,0,0,,(керемет дыбыс)
Dialogue: 0,0:48:15.10,0:48:18.27,Default,,0,0,0,,Шакуна Вимана Қайықты құдайлар мінген деп айтады.
Dialogue: 0,0:48:18.72,0:48:20.10,Default,,0,0,0,,Әдебиеттер бойынша
Dialogue: 0,0:48:20.27,0:48:21.23,Default,,0,0,0,,Құдай…
Dialogue: 0,0:48:22.89,0:48:23.81,Default,,0,0,0,,Ах!
Dialogue: 0,0:48:23.98,0:48:24.77,Default,,0,0,0,,Ах
Dialogue: 0,0:48:25.27,0:48:26.27,Default,,0,0,0,,Ухммм… ммм…
Dialogue: 0,0:48:26.57,0:48:27.73,Default,,0,0,0,,Клавис?
Dialogue: 0,0:48:27.90,0:48:29.53,Default,,0,0,0,,Фрагмент? —
Dialogue: 0,0:48:29.90,0:48:30.78,Default,,0,0,0,,Неге сен?
Dialogue: 0,0:48:31.40,0:48:34.95,Default,,0,0,0,,Бұл радио кені. Бұл әкемнің естелігі.
Dialogue: 0,0:48:35.12,0:48:36.28,Default,,0,0,0,,Естелік?
Dialogue: 0,0:48:40.16,0:48:43.04,Default,,0,0,0,,Клавис латын тілінен аударғанда «кілт» дегенді білдіреді.
Dialogue: 0,0:48:43.21,0:48:46.04,Default,,0,0,0,,Бұл бізге болашақта көмектесуі мүмкін—
Dialogue: 0,0:48:46.21,0:48:47.75,Default,,0,0,0,,Оны қауіпсіз сақтаңыз
Dialogue: 0,0:48:47.92,0:48:48.63,Default,,0,0,0,,Иә
Dialogue: 0,0:48:48.80,0:48:50.88,Default,,0,0,0,,Сол қайық келе жатқан бағытқа қарай жүрейік.
Dialogue: 0,0:48:51.38,0:48:54.89,Default,,0,0,0,,Бір нәрсе, біз іздейтін нәрсе болуы керек.
Dialogue: 0,0:49:13.65,0:49:15.70,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:49:21.16,0:49:21.91,Default,,0,0,0,,Ах!
Dialogue: 0,0:49:33.09,0:49:34.05,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:49:51.11,0:49:53.53,Default,,0,0,0,,Хмм.
Dialogue: 0,0:50:09.33,0:50:11.17,Default,,0,0,0,,Өйткені, ауылдың қалдықтары бар.
Dialogue: 0,0:50:11.34,0:50:13.38,Default,,0,0,0,,Қанша жүрсең де қирандыдан басқа ештеңе жоқ.
Dialogue: 0,0:50:13.55,0:50:16.55,Default,,0,0,0,,Кейбір өрістер қалуы мүмкін. Мен қарап көрейін.
Dialogue: 0,0:50:16.72,0:50:18.14,Default,,0,0,0,,Кел, Мими!
Dialogue: 0,0:50:33.36,0:50:37.24,Default,,0,0,0,,Финис Террадан тыс, өмір мен өлім қақпасы?
Dialogue: 0,0:50:38.70,0:50:40.87,Default,,0,0,0,,Мұғалім, қараңдаршы! —
Dialogue: 0,0:50:42.74,0:50:44.75,Default,,0,0,0,,Бүгін кешке бізде той болуы мүмкін!
Dialogue: 0,0:50:44.95,0:50:45.95,Default,,0,0,0,,Кенеттен келгеніме кешірім өтінемін.
Dialogue: 0,0:50:48.46,0:50:51.38,Default,,0,0,0,,Картоп улы болуы мүмкін, тек...
Dialogue: 0,0:50:51.54,0:50:53.21,Default,,0,0,0,,Уларды сумен кетіріңіз!
Dialogue: 0,0:50:53.38,0:50:54.42,Default,,0,0,0,,Содан кейін киім
Dialogue: 0,0:50:54.59,0:50:56.47,Default,,0,0,0,,Мұғалімдікі де әбден лас.
Dialogue: 0,0:50:56.84,0:50:59.34,Default,,0,0,0,,Киім ауыстыруды әкеліңіз, мен оларды кейін жуамын.
Dialogue: 0,0:50:59.55,0:51:01.39,Default,,0,0,0,,Тәтті картоп!
Dialogue: 0,0:51:22.32,0:51:23.49,Default,,0,0,0,,Сақ бол.
Dialogue: 0,0:51:23.74,0:51:27.66,Default,,0,0,0,,Бір жақсысы, ас үйде тұз қалды.
Dialogue: 0,0:51:29.79,0:51:30.92,Default,,0,0,0,,Хмм.
Dialogue: 0,0:51:34.59,0:51:36.09,Default,,0,0,0,,Бұл таң қалдырды.
Dialogue: 0,0:51:36.25,0:51:37.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:51:38.09,0:51:40.22,Default,,0,0,0,,Сізге бұл саяхат ұнады ма?
Dialogue: 0,0:51:40.38,0:51:41.84,Default,,0,0,0,,(Сузуя) Ал сен неге Гульге айналдың?
Dialogue: 0,0:51:44.60,0:51:45.43,Default,,0,0,0,,I…—
Dialogue: 0,0:51:45.97,0:51:47.85,Default,,0,0,0,,Жалғыз радио тыңдау кезінде—
Dialogue: 0,0:51:48.02,0:51:50.35,Default,,0,0,0,,Мен алыс жерге баруым керек.
Dialogue: 0,0:51:50.48,0:51:51.69,Default,,0,0,0,,Мен бұл туралы ойладым
Dialogue: 0,0:51:52.94,0:51:55.11,Default,,0,0,0,,Бұл мен болғым келетін жер емес.
Dialogue: 0,0:51:55.23,0:51:57.61,Default,,0,0,0,,Бұл мен бұрын көрмеген жер.
Dialogue: 0,0:51:57.78,0:52:00.40,Default,,0,0,0,,Содан мен бір жұмбақ баланы кездестірдім...
Dialogue: 0,0:52:00.53,0:52:02.86,Default,,0,0,0,,Сол адамның соңынан осы жерге барыңыз
Dialogue: 0,0:52:03.62,0:52:06.49,Default,,0,0,0,,Агартаға келгеннен кейін мен өзімді...
Dialogue: 0,0:52:06.66,0:52:08.20,Default,,0,0,0,,Менің жүрегім үнемі соғып тұр...
Dialogue: 0,0:52:08.79,0:52:12.33,Default,,0,0,0,,Сондықтан алда міндетті түрде бірдеңе бар...
Dialogue: 0,0:52:14.88,0:52:16.75,Default,,0,0,0,,(музыкалық қораптың дыбысы)
Dialogue: 0,0:52:16.92,0:52:17.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:52:35.73,0:52:36.77,Default,,0,0,0,,Ум...
Dialogue: 0,0:52:38.07,0:52:41.32,Default,,0,0,0,,Жұлдыздар көрінбейтін түнде бір нәрсе мазасызданады.
Dialogue: 0,0:52:42.03,0:52:44.61,Default,,0,0,0,,Адамдар қаншалықты жалғыз...
Dialogue: 0,0:52:44.78,0:52:46.45,Default,,0,0,0,,Еске саламын
Dialogue: 0,0:52:48.20,0:52:51.33,Default,,0,0,0,,Шин Куанан мақтайды—
Dialogue: 0,0:52:52.62,0:52:56.46,Default,,0,0,0,,Клависті қалпына келтіру Біріншіден, бұл үлкен тапсырма болды.
Dialogue: 0,0:52:56.63,0:52:58.42,Default,,0,0,0,,Бірақ сіз қате жібердіңіз.
Dialogue: 0,0:52:58.59,0:52:59.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:52:59.63,0:53:02.13,Default,,0,0,0,,Жерден келген жігіт пен қыз
Dialogue: 0,0:53:02.30,0:53:05.14,Default,,0,0,0,,Өмір мен өлім қақпасын көздеген қолында Клавис
Dialogue: 0,0:53:05.30,0:53:06.85,Default,,0,0,0,,Бірақ Клавис осында!
Dialogue: 0,0:53:07.01,0:53:08.68,Default,,0,0,0,,Оның тағы бір бөлігі болды.
Dialogue: 0,0:53:08.85,0:53:09.56,Default,,0,0,0,,Ha
Dialogue: 0,0:53:09.72,0:53:13.85,Default,,0,0,0,,Сіз жердегілерді Агартаға шақырдыңыз.
Dialogue: 0,0:53:14.31,0:53:16.35,Default,,0,0,0,,Бұл үлкен қателік.
Dialogue: 0,0:53:16.52,0:53:18.44,Default,,0,0,0,,Бірақ мен қандай рөл алдым?
Dialogue: 0,0:53:18.61,0:53:19.82,Default,,0,0,0,,Түсіндіру қажет емес!
Dialogue: 0,0:53:19.98,0:53:21.74,Default,,0,0,0,,Барлығына айту керек емес пе?
Dialogue: 0,0:53:21.90,0:53:23.86,Default,,0,0,0,,Бұрынғы береке енді алыс
Dialogue: 0,0:53:24.03,0:53:26.57,Default,,0,0,0,,Біз қазір ұзақ ымыртта өмір сүріп жатырмыз.
Dialogue: 0,0:53:26.95,0:53:29.37,Default,,0,0,0,,Аструмда, өмірдің соңы.
Dialogue: 0,0:53:29.49,0:53:31.66,Default,,0,0,0,,Біздің үмітіміз сөнеді.
Dialogue: 0,0:53:31.83,0:53:34.16,Default,,0,0,0,,Бірақ қақпалар ашылғаннан кейін -
Dialogue: 0,0:53:34.33,0:53:36.54,Default,,0,0,0,,Жерлестер тағы да Агартаға қарсы тұр.
Dialogue: 0,0:53:36.71,0:53:39.59,Default,,0,0,0,,Бейбітшілік аласапыранға жұтылады
Dialogue: 0,0:53:41.71,0:53:43.09,Default,,0,0,0,,Шыу!
Dialogue: 0,0:53:45.63,0:53:47.30,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:53:49.47,0:53:55.39,Default,,0,0,0,,Біз бір кездері көрген азапты ұмыта алмаймыз.
Dialogue: 0,0:53:59.06,0:54:00.94,Default,,0,0,0,,Бұл өте өкінішті
Dialogue: 0,0:54:01.11,0:54:02.98,Default,,0,0,0,,Қартаюға дейінгі рәсім
Dialogue: 0,0:54:03.11,0:54:06.24,Default,,0,0,0,,Көздерің әлі ашылған жоқ.
Dialogue: 0,0:54:06.40,0:54:09.82,Default,,0,0,0,,Кветцальдің көзқарасын қарастыру мүмкін емес -
Dialogue: 0,0:54:09.99,0:54:14.16,Default,,0,0,0,,Мен Клавистің тынысын да сезе алмаймын.
Dialogue: 0,0:54:14.33,0:54:16.75,Default,,0,0,0,,Ағаңыздың таланты бар еді...
Dialogue: 0,0:54:16.92,0:54:21.75,Default,,0,0,0,,Карма ауруы менің жерге деген құштарлығымды күшейтті.
Dialogue: 0,0:54:22.34,0:54:28.30,Default,,0,0,0,,Шин Куанан мақтайды Мен сізге жаңа тапсырма беремін.
Dialogue: 0,0:54:37.60,0:54:39.31,Default,,0,0,0,,Ха ха ха—
Dialogue: 0,0:54:40.27,0:54:41.31,Default,,0,0,0,,Шин!
Dialogue: 0,0:54:41.48,0:54:44.03,Default,,0,0,0,,Сери, сен кезекшіліктесің.
Dialogue: 0,0:54:44.28,0:54:46.24,Default,,0,0,0,,Сәл жақсы
Dialogue: 0,0:54:51.91,0:54:53.66,Default,,0,0,0,,Сері Шунға келсек...
Dialogue: 0,0:54:53.83,0:54:55.16,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:54:55.50,0:54:56.41,Default,,0,0,0,,Бұл көңілсіз болды.
Dialogue: 0,0:54:56.58,0:54:59.12,Default,,0,0,0,,Жоқ, ауруды тездетсе де.
Dialogue: 0,0:54:59.29,0:55:02.13,Default,,0,0,0,,Мен Шунның көргісі келгенін көргеніне сенімдімін.
Dialogue: 0,0:55:05.71,0:55:09.13,Default,,0,0,0,,Шин, сенің басқа жұмысың бар, солай ма?
Dialogue: 0,0:55:09.47,0:55:12.30,Default,,0,0,0,,Ах, жер бетіндегі адамдарды іздеп, Клависті басып ал.
Dialogue: 0,0:55:12.47,0:55:13.68,Default,,0,0,0,,Бірақ бұл?
Dialogue: 0,0:55:13.85,0:55:17.56,Default,,0,0,0,,Мен сенен мені өлтіруіңді сұрамаймын, бірақ қажет болса...
Dialogue: 0,0:55:17.73,0:55:20.85,Default,,0,0,0,,Шин осындай қауіпті рөлде жалғыз.
Dialogue: 0,0:55:21.06,0:55:24.82,Default,,0,0,0,,Әке-шешеміз қайтыс болғаннан кейін ауыл бауырларымды өсірді.
Dialogue: 0,0:55:24.98,0:55:26.86,Default,,0,0,0,,Мен бұл жақсылығымды өтеуім керек.
Dialogue: 0,0:55:47.26,0:55:48.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:56:08.03,0:56:09.53,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:56:23.83,0:56:24.79,Default,,0,0,0,,Кушун
Dialogue: 0,0:56:24.96,0:56:25.92,Default,,0,0,0,,Тамақтану
Dialogue: 0,0:56:26.09,0:56:27.05,Default,,0,0,0,,Рахмет
Dialogue: 0,0:56:27.59,0:56:28.96,Default,,0,0,0,,Мен де көже пісірейін бе?
Dialogue: 0,0:56:29.17,0:56:30.63,Default,,0,0,0,,Кункун
Dialogue: 0,0:56:31.88,0:56:33.05,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:56:33.34,0:56:34.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:56:37.43,0:56:38.47,Default,,0,0,0,,Не болды?
Dialogue: 0,0:56:38.64,0:56:40.48,Default,,0,0,0,,Біз білмей тұрып жақсы дос болдық.
Dialogue: 0,0:56:40.64,0:56:43.56,Default,,0,0,0,,Ах, төтенше жағдайда мысықтарды тамақ ретінде пайдалануға болады.
Dialogue: 0,0:56:43.73,0:56:44.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:56:45.69,0:56:46.56,Default,,0,0,0,,Мияу...
Dialogue: 0,0:56:46.73,0:56:48.27,Default,,0,0,0,,Әзіл.
Dialogue: 0,0:56:54.36,0:56:55.57,Default,,0,0,0,,Мұғалім дегеніміз не?
Dialogue: 0,0:56:56.45,0:56:57.78,Default,,0,0,0,,Әкем
Dialogue: 0,0:56:59.16,0:57:00.08,Default,,0,0,0,,... сияқты
Dialogue: 0,0:57:07.42,0:57:09.05,Default,,0,0,0,,Ақымақ болма
Dialogue: 0,0:57:09.38,0:57:11.09,Default,,0,0,0,,(музыкалық қораптың дыбысы)
Dialogue: 0,0:57:14.13,0:57:16.59,Default,,0,0,0,,(музыкалық қораптың дыбысы)
Dialogue: 0,0:57:25.44,0:57:28.86,Default,,0,0,0,,Сіздің дене қызуыңыздың көтерілуі әдеттен тыс.
Dialogue: 0,0:57:29.61,0:57:33.15,Default,,0,0,0,,Әдетте құлау менің рөлім.
Dialogue: 0,0:57:33.32,0:57:34.20,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:57:34.36,0:57:35.82,Default,,0,0,0,,Ухуху—
Dialogue: 0,0:57:36.03,0:57:38.87,Default,,0,0,0,,Егер сіз солай ойласаңыз, маған бір нәрсе уәде ете аласыз ба?
Dialogue: 0,0:57:39.24,0:57:40.37,Default,,0,0,0,,Не?
Dialogue: 0,0:57:40.95,0:57:45.62,Default,,0,0,0,,Мен кеткеннен кейін де дұрыс өмір сүре бересің.
Dialogue: 0,0:57:47.88,0:57:48.96,Default,,0,0,0,,Лиза
Dialogue: 0,0:57:49.17,0:57:51.38,Default,,0,0,0,,Келесі тапсырма жақын арада аяқталады.
Dialogue: 0,0:57:51.63,0:57:54.63,Default,,0,0,0,,Сен қайтқанда еліме бірге барайық.
Dialogue: 0,0:57:54.80,0:57:56.13,Default,,0,0,0,,Олай жасасаң, ауруың...
Dialogue: 0,0:57:56.30,0:57:58.14,Default,,0,0,0,,Мұның мағынасы осы емес пе?
Dialogue: 0,0:57:58.72,0:58:03.39,Default,,0,0,0,,Ей, бәрі бір күні жоғалып кетуі мүмкін.
Dialogue: 0,0:58:04.89,0:58:08.40,Default,,0,0,0,,Жалғыз айырмашылығы - бұл баяу немесе жылдам.
Dialogue: 0,0:58:10.32,0:58:14.40,Default,,0,0,0,,Ал мен сенен сәл жылдаммын...
Dialogue: 0,0:58:16.82,0:58:20.20,Default,,0,0,0,,Бұл қазірдің өзінде шешілді.
Dialogue: 0,0:58:23.62,0:58:25.66,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:58:30.84,0:58:31.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:58:32.71,0:58:33.88,Default,,0,0,0,,Ах!
Dialogue: 0,0:58:39.18,0:58:40.26,Default,,0,0,0,,Лиза
Dialogue: 0,0:58:41.35,0:58:42.76,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:58:43.35,0:58:45.10,Default,,0,0,0,,Сен кетпейсің...
Dialogue: 0,0:58:45.27,0:58:48.02,Default,,0,0,0,,Мен де сенің қасыңнан жоғалмаймын.
Dialogue: 0,0:58:49.35,0:58:51.06,Default,,0,0,0,,Хаа...
Dialogue: 0,0:58:54.28,0:58:58.86,Default,,0,0,0,,Мен... сенің жоқтығың үшін дайындалмаймын.
Dialogue: 0,0:58:59.32,0:59:00.49,Default,,0,0,0,,Ешқашан
Dialogue: 0,0:59:06.62,0:59:08.54,Default,,0,0,0,,Лиза, сен сонда болдың ба?
Dialogue: 0,0:59:08.75,0:59:12.38,Default,,0,0,0,,Мм... Мұғалім, ауырған сияқты.
Dialogue: 0,0:59:13.09,0:59:16.55,Default,,0,0,0,,Асуна Мен бірдеңе дедім бе?
Dialogue: 0,0:59:16.71,0:59:17.76,Default,,0,0,0,,Жоқ
Dialogue: 0,0:59:19.05,0:59:19.88,Default,,0,0,0,,Бұл кемпірқосақ
Dialogue: 0,0:59:20.05,0:59:20.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:59:28.85,0:59:29.94,Default,,0,0,0,,Ах
Dialogue: 0,0:59:38.99,0:59:40.70,Default,,0,0,0,,И тайпасының жеріне қарай бет алу
Dialogue: 0,0:59:43.07,0:59:44.12,Default,,0,0,0,,Тезірек барайық
Dialogue: 0,0:59:57.42,0:59:59.17,Default,,0,0,0,,Ах! енгізілді
Dialogue: 0,1:00:03.01,1:00:03.85,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,1:00:04.05,1:00:06.06,Default,,0,0,0,,(керемет дыбыс)
Dialogue: 0,1:00:06.39,1:00:07.68,Default,,0,0,0,,Ах
Dialogue: 0,1:00:11.27,1:00:12.69,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:00:13.10,1:00:15.94,Default,,0,0,0,,Радио тыңдап отырып көрген табиғат көрінісі
Dialogue: 0,1:00:16.11,1:00:18.28,Default,,0,0,0,,Бұл Агарта болды, солай ма?
Dialogue: 0,1:00:23.11,1:00:26.99,Default,,0,0,0,,Жүр, Асуна, қоштасу үшін саяхатқа.
Dialogue: 0,1:00:29.95,1:00:30.71,Default,,0,0,0,,Ах
Dialogue: 0,1:00:32.37,1:00:34.63,Default,,0,0,0,,Ха! Ха ха ха...
Dialogue: 0,1:00:37.17,1:00:39.05,Default,,0,0,0,,Хаа…
Dialogue: 0,1:00:54.10,1:00:55.15,Default,,0,0,0,,Тұтқындарға арналған екінші жатақхана.
Dialogue: 0,1:00:55.48,1:00:56.31,Default,,0,0,0,,(Сыныптасы) Әй, осындай жалғыздыққа толы сөздер айтпашы.
Dialogue: 0,1:00:57.48,1:00:59.61,Default,,0,0,0,,Фуууууууу!
Dialogue: 0,1:01:06.87,1:01:08.33,Default,,0,0,0,,Гяо
Dialogue: 0,1:01:34.48,1:01:35.69,Default,,0,0,0,,Ах...—
Dialogue: 0,1:01:36.02,1:01:37.11,Default,,0,0,0,,Хмм
Dialogue: 0,1:01:39.52,1:01:40.57,Default,,0,0,0,,Ах!
Dialogue: 0,1:01:41.69,1:01:43.11,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Марқұм патшаның өсиетіне сәйкес, біз—
Dialogue: 0,1:01:44.20,1:01:45.11,Default,,0,0,0,,Ах...
Dialogue: 0,1:01:48.62,1:01:50.74,Default,,0,0,0,,Ах
Dialogue: 0,1:01:53.58,1:01:55.04,Default,,0,0,0,,Жарай бер, сол баланы оқпен тесіп өт!
Dialogue: 0,1:01:56.71,1:01:58.46,Default,,0,0,0,,Ах! Хаа...
Dialogue: 0,1:02:01.84,1:02:05.80,Default,,0,0,0,,Жарайды, жылама, жарай ма? Жарайды
Dialogue: 0,1:02:05.97,1:02:07.18,Default,,0,0,0,,Уау!
Dialogue: 0,1:02:12.35,1:02:14.43,Default,,0,0,0,,(Қыздың жылауы)
Dialogue: 0,1:02:22.40,1:02:23.32,Default,,0,0,0,,Эй!
Dialogue: 0,1:02:33.08,1:02:33.83,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,1:02:34.00,1:02:35.25,Default,,0,0,0,,Жоқ, жоқ, жоқ.
Dialogue: 0,1:02:35.41,1:02:36.58,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,1:02:36.75,1:02:37.87,Default,,0,0,0,,Ах!
Dialogue: 0,1:02:48.76,1:02:50.22,Default,,0,0,0,,Ал профессор Гожо ше?
Dialogue: 0,1:02:53.56,1:02:55.22,Default,,0,0,0,,Не? не болды?
Dialogue: 0,1:02:56.39,1:02:57.14,Default,,0,0,0,,Ах
Dialogue: 0,1:03:01.31,1:03:02.15,Default,,0,0,0,,Ha
Dialogue: 0,1:03:05.90,1:03:07.15,Default,,0,0,0,,Ой...
Dialogue: 0,1:03:07.86,1:03:10.16,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:03:20.83,1:03:22.13,Default,,0,0,0,,Мұнда емес.
Dialogue: 0,1:03:35.14,1:03:37.68,Default,,0,0,0,,Мен оны көріп тұрмын! Бұл Кравис! Ха!
Dialogue: 0,1:03:51.61,1:03:53.99,Default,,0,0,0,,А... Мен көлеңкеден шыға алмаймын.
Dialogue: 0,1:03:54.16,1:03:54.91,Default,,0,0,0,,Ах!
Dialogue: 0,1:03:59.87,1:04:00.83,Default,,0,0,0,,Әй, кел!
Dialogue: 0,1:04:01.00,1:04:01.87,Default,,0,0,0,,А
Dialogue: 0,1:04:02.04,1:04:03.71,Default,,0,0,0,,Жарайды, келіңдер! —
Dialogue: 0,1:04:06.13,1:04:07.51,Default,,0,0,0,,Өрмелеу
Dialogue: 0,1:04:10.68,1:04:12.18,Default,,0,0,0,,Өрмелеңіз!
Dialogue: 0,1:04:17.60,1:04:19.85,Default,,0,0,0,,Өтінемін, бар күшіңізді салыңыз!
Dialogue: 0,1:04:26.02,1:04:27.11,Default,,0,0,0,,Ал профессор Гожо ше?
Dialogue: 0,1:04:27.40,1:04:28.15,Default,,0,0,0,,А…
Dialogue: 0,1:04:28.32,1:04:29.61,Default,,0,0,0,,Құдай-ай.
Dialogue: 0,1:04:30.03,1:04:31.11,Default,,0,0,0,,Асуна!
Dialogue: 0,1:04:42.50,1:04:43.67,Default,,0,0,0,,Сонымен бірге Rohan деген жігіт те—
Dialogue: 0,1:04:46.04,1:04:46.84,Default,,0,0,0,,Ал профессор Гожо ше?
Dialogue: 0,1:04:47.84,1:04:49.34,Default,,0,0,0,,Сіз Шинсіз бе?
Dialogue: 0,1:04:49.80,1:04:52.22,Default,,0,0,0,,Мен бұл жолы қателескен жоқпын.
Dialogue: 0,1:04:52.84,1:04:53.76,Default,,0,0,0,,Ha
Dialogue: 0,1:05:02.10,1:05:03.85,Default,,0,0,0,,Бұл и тайпасының ұясы.
Dialogue: 0,1:05:05.10,1:05:07.48,Default,,0,0,0,,Олар сізді «Кегарета қаны» деп атайды
Dialogue: 0,1:05:07.65,1:05:08.82,Default,,0,0,0,,Тамақ жеп, өлтіргісі келеді—
Dialogue: 0,1:05:08.98,1:05:09.90,Default,,0,0,0,,TDL! Мен TDL-ге барғым келеді!
Dialogue: 0,1:05:10.07,1:05:12.74,Default,,0,0,0,,Шин! Бұл жерді қалай таптың? —
Dialogue: 0,1:05:12.90,1:05:15.57,Default,,0,0,0,,Осыдан кейін мен Шиннің соңынан Агартаға бардым...
Dialogue: 0,1:05:15.74,1:05:17.74,Default,,0,0,0,,Бұл үлкен мазасыздық.
Dialogue: 0,1:05:18.49,1:05:20.41,Default,,0,0,0,,Неге, Шиннен тағы сұрадым...
Dialogue: 0,1:05:20.58,1:05:22.87,Default,,0,0,0,,Сөйлеспей жүгір! Олар менің артымнан келе жатыр.
Dialogue: 0,1:05:23.04,1:05:24.21,Default,,0,0,0,,Жүгіру!
Dialogue: 0,1:05:30.80,1:05:31.71,Default,,0,0,0,,Ха! —
Dialogue: 0,1:05:32.01,1:05:33.72,Default,,0,0,0,,Шин Шин Мен сені қуып келдім!
Dialogue: 0,1:05:37.26,1:05:38.22,Default,,0,0,0,,Asuna Jump!
Dialogue: 0,1:05:38.39,1:05:39.31,Default,,0,0,0,,Не!
Dialogue: 0,1:05:41.06,1:05:42.18,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,1:05:42.43,1:05:43.35,Default,,0,0,0,,Уф
Dialogue: 0,1:05:45.77,1:05:46.73,Default,,0,0,0,,Шин!
Dialogue: 0,1:05:49.77,1:05:51.11,Default,,0,0,0,,Шин!
Dialogue: 0,1:05:51.28,1:05:52.11,Default,,0,0,0,,Ха…
Dialogue: 0,1:05:52.28,1:05:53.49,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,1:05:53.78,1:05:54.99,Default,,0,0,0,,Кеттік!
Dialogue: 0,1:06:02.79,1:06:04.75,Default,,0,0,0,,Хаа ха
Dialogue: 0,1:06:12.17,1:06:13.21,Default,,0,0,0,,Хаа…
Dialogue: 0,1:06:13.63,1:06:15.26,Default,,0,0,0,,Ах!
Dialogue: 0,1:06:21.85,1:06:24.14,Default,,0,0,0,,Асуна, сенде Клавистің бір бөлігі бар.
Dialogue: 0,1:06:24.31,1:06:25.60,Default,,0,0,0,,Иә... иә
Dialogue: 0,1:06:25.77,1:06:26.89,Default,,0,0,0,,Оны маған беруге рұқсат етемін.
Dialogue: 0,1:06:27.06,1:06:27.85,Default,,0,0,0,,Не? —
Dialogue: 0,1:06:30.69,1:06:31.61,Default,,0,0,0,,Ах!
Dialogue: 0,1:06:40.87,1:06:43.49,Default,,0,0,0,,(И тайпасының суда еріген дыбысы)
Dialogue: 0,1:06:52.17,1:06:53.17,Default,,0,0,0,,Шин!
Dialogue: 0,1:07:02.43,1:07:03.18,Default,,0,0,0,,Ха!
Dialogue: 0,1:07:03.35,1:07:04.64,Default,,0,0,0,,(Нанами) Болмайды. Мен саған бүгін таңертең неге екенін айттым ғой, иә?
Dialogue: 0,1:07:07.52,1:07:08.19,Default,,0,0,0,,Ах!
Dialogue: 0,1:07:08.48,1:07:09.56,Default,,0,0,0,,Шин!
Dialogue: 0,1:07:10.56,1:07:13.19,Default,,0,0,0,,Ах! Ах!
Dialogue: 0,1:07:17.24,1:07:18.65,Default,,0,0,0,,Мен көмектесуім керек
Dialogue: 0,1:07:47.98,1:07:49.02,Default,,0,0,0,,Әй, кішкентай бала!
Dialogue: 0,1:07:56.23,1:07:57.03,Default,,0,0,0,,Асуна!
Dialogue: 0,1:08:02.57,1:08:04.12,Default,,0,0,0,,Асуна! Эй
Dialogue: 0,1:08:04.78,1:08:05.53,Default,,0,0,0,,Асуна...
Dialogue: 0,1:08:05.70,1:08:07.54,Default,,0,0,0,,Мияу
Dialogue: 0,1:08:08.25,1:08:09.29,Default,,0,0,0,,Ах… «C» рейтингі (жылқының көрісі)
Dialogue: 0,1:08:09.29,1:08:10.25,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,1:08:14.63,1:08:15.54,Default,,0,0,0,,Жылқы?
Dialogue: 0,1:08:21.18,1:08:21.93,Default,,0,0,0,,Ha
Dialogue: 0,1:08:23.43,1:08:26.31,Default,,0,0,0,,«Маған Клависті бер» деді ме? —
Dialogue: 0,1:08:27.60,1:08:28.64,Default,,0,0,0,,Хмм—
Dialogue: 0,1:08:29.77,1:08:31.56,Default,,0,0,0,,Сізді ұрлап кеткендер
Dialogue: 0,1:08:31.69,1:08:34.73,Default,,0,0,0,,Бізді қарсы алмайтын сияқты.
Dialogue: 0,1:08:34.94,1:08:36.19,Default,,0,0,0,,Бұл баламен не істеуіміз керек?
Dialogue: 0,1:08:36.36,1:08:37.40,Default,,0,0,0,,А…
Dialogue: 0,1:08:40.53,1:08:41.57,Default,,0,0,0,,Ааа
Dialogue: 0,1:08:41.74,1:08:43.11,Default,,0,0,0,,Не болды?
Dialogue: 0,1:08:43.28,1:08:44.57,Default,,0,0,0,,Онда бірдеңе бар ма?
Dialogue: 0,1:08:44.74,1:08:46.20,Default,,0,0,0,,Төменгі ағын...
Dialogue: 0,1:08:46.87,1:08:48.91,Default,,0,0,0,,Уф...
Dialogue: 0,1:08:49.29,1:08:50.62,Default,,0,0,0,,Ах... Шин!
Dialogue: 0,1:08:54.29,1:08:55.71,Default,,0,0,0,,Қаншама тер!
Dialogue: 0,1:08:55.92,1:08:57.25,Default,,0,0,0,,Асуна
Dialogue: 0,1:08:57.42,1:08:58.13,Default,,0,0,0,,Шин!
Dialogue: 0,1:08:58.30,1:08:59.46,Default,,0,0,0,,Сен де жақсысың ба?
Dialogue: 0,1:08:59.63,1:09:00.51,Default,,0,0,0,,Ум!
Dialogue: 0,1:09:00.92,1:09:02.84,Default,,0,0,0,,Байқағаныңызға қуаныштымын.
Dialogue: 0,1:09:03.01,1:09:05.26,Default,,0,0,0,,Түсіндім, бізді сыпырып кетті...
Dialogue: 0,1:09:05.68,1:09:07.39,Default,,0,0,0,,Күте тұрыңыз, енді су беріңіз.
Dialogue: 0,1:09:07.56,1:09:08.64,Default,,0,0,0,,Әй, сен!
Dialogue: 0,1:09:08.81,1:09:09.64,Default,,0,0,0,,Ах!
Dialogue: 0,1:09:09.81,1:09:11.14,Default,,0,0,0,,Архангели!
Dialogue: 0,1:09:12.77,1:09:16.11,Default,,0,0,0,,Сізде Клавис болуы керек. Оны тастап, Агартаны қалдырыңыз!
Dialogue: 0,1:09:16.48,1:09:17.27,Default,,0,0,0,,Бұл сенсің ғой, иә?
Dialogue: 0,1:09:17.44,1:09:20.69,Default,,0,0,0,,Неге екенін білесіз бе? Бұл менің жұмысым.
Dialogue: 0,1:09:21.40,1:09:23.20,Default,,0,0,0,,Маған Клависті беріңіз! —
Dialogue: 0,1:09:23.57,1:09:24.70,Default,,0,0,0,,Сәлем! —
Dialogue: 0,1:09:25.16,1:09:26.07,Default,,0,0,0,,Ах...—
Dialogue: 0,1:09:30.62,1:09:32.08,Default,,0,0,0,,Ах, а...
Dialogue: 0,1:09:35.71,1:09:37.96,Default,,0,0,0,,Бала көрсеткен бағытқа қарай жүрейік.
Dialogue: 0,1:09:38.09,1:09:40.55,Default,,0,0,0,,Ауыл болуы мүмкін
Dialogue: 0,1:09:41.05,1:09:43.30,Default,,0,0,0,,Бұл кісіні де өзіммен бірге алып кетемін.
Dialogue: 0,1:09:44.59,1:09:46.01,Default,,0,0,0,,Қалағаныңды істе
Dialogue: 0,1:09:55.81,1:09:58.06,Default,,0,0,0,,Мя
Dialogue: 0,1:10:06.41,1:10:07.53,Default,,0,0,0,,Ах!
Dialogue: 0,1:10:17.71,1:10:18.88,Default,,0,0,0,,Адамдар бар...
Dialogue: 0,1:10:19.04,1:10:21.09,Default,,0,0,0,,Бұл бірінші тірі ауыл.
Dialogue: 0,1:10:22.13,1:10:23.26,Default,,0,0,0,,Сақтықпен жалғастырыңыз
Dialogue: 0,1:10:26.30,1:10:28.05,Default,,0,0,0,,Сәлем! Алақай! —
Dialogue: 0,1:10:28.22,1:10:29.76,Default,,0,0,0,,Иә?
Dialogue: 0,1:10:30.72,1:10:31.85,Default,,0,0,0,,Ах...
Dialogue: 0,1:10:32.72,1:10:34.56,Default,,0,0,0,,Сендер, тоқтаңдар.
Dialogue: 0,1:10:34.73,1:10:36.73,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,1:10:36.89,1:10:38.23,Default,,0,0,0,,Шамасы, ол жер адамы.
Dialogue: 0,1:10:38.40,1:10:39.19,Default,,0,0,0,,Мистер Столкер
Dialogue: 0,1:10:39.36,1:10:40.19,Default,,0,0,0,,Қайғылы...
Dialogue: 0,1:10:40.36,1:10:41.86,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,1:10:45.82,1:10:47.36,Default,,0,0,0,,Барлығың орындарынан тұрыңдар.
Dialogue: 0,1:10:51.24,1:10:52.79,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,1:10:55.62,1:10:57.87,Default,,0,0,0,,Ал профессор Гожо ше?
Dialogue: 0,1:10:58.67,1:11:00.54,Default,,0,0,0,,Бұл кеше ұрланған жараланған Лего.
Dialogue: 0,1:11:00.71,1:11:02.92,Default,,0,0,0,,Анасы қайтыс болғаннан кейін ол тілсіз қалды.
Dialogue: 0,1:11:03.09,1:11:04.34,Default,,0,0,0,,О? Сіздер әлдеқашан бастадыңыздар ма? Әңгіме
Dialogue: 0,1:11:09.76,1:11:11.30,Default,,0,0,0,,Динаның ұлы?
Dialogue: 0,1:11:11.47,1:11:12.89,Default,,0,0,0,,Сіз үлкейдіңіз.
Dialogue: 0,1:11:14.93,1:11:18.14,Default,,0,0,0,,Ауыл баласын жеткізгеніңіз үшін рахмет айтамын.
Dialogue: 0,1:11:18.31,1:11:20.60,Default,,0,0,0,,Бірақ бәрің де жерлессіңдер.
Dialogue: 0,1:11:21.44,1:11:24.82,Default,,0,0,0,,Аморот ауылы жер бетіндегі адамдарды қабылдай алмайды.
Dialogue: 0,1:11:24.98,1:11:26.28,Default,,0,0,0,,Үйге келіңіз.
Dialogue: 0,1:11:27.61,1:11:29.61,Default,,0,0,0,,А, у... тым болмаса
Dialogue: 0,1:11:30.07,1:11:32.12,Default,,0,0,0,,Сіз бұл адамды жалғыз тексере аласыз ба?
Dialogue: 0,1:11:32.78,1:11:34.99,Default,,0,0,0,,Бұл киімдер Қанахандық па?
Dialogue: 0,1:11:33.16,1:11:35.16,Default,,0,0,0,,Ол жарақат алды. Оның қызуы бар.
Dialogue: 0,1:11:35.16,1:11:36.45,Default,,0,0,0,,Неліктен агартандар жердегілерден ерекшеленеді? Ол жарақат алды. Оның қызуы бар.
Dialogue: 0,1:11:36.45,1:11:37.62,Default,,0,0,0,,Неліктен агартандар жердегілерден ерекшеленеді?
Dialogue: 0,1:11:37.79,1:11:38.96,Default,,0,0,0,,...
Dialogue: 0,1:11:39.46,1:11:40.37,Default,,0,0,0,,Мүмкін ірімшік жетпеді ме?
Dialogue: 0,1:11:43.29,1:11:44.80,Default,,0,0,0,,Қ-Қандай?
Dialogue: 0,1:11:45.13,1:11:48.84,Default,,0,0,0,,Мана жақсы оралды.
Dialogue: 0,1:11:52.97,1:11:54.89,Default,,0,0,0,,Ауылдың сыйламағанын кешіріңіз.
Dialogue: 0,1:11:55.06,1:11:58.06,Default,,0,0,0,,Немеремді құтқарғаныңыз үшін рахмет айта аламын ба?
Dialogue: 0,1:11:58.23,1:11:59.18,Default,,0,0,0,,Гошуро!
Dialogue: 0,1:11:59.35,1:12:02.81,Default,,0,0,0,,Мен үшін бір түнге тұрмайсың ба?
Dialogue: 0,1:12:09.78,1:12:10.95,Default,,0,0,0,,Осы жолмен
Dialogue: 0,1:12:11.11,1:12:14.83,Default,,0,0,0,,Ауылдан өте алмайсың.
Dialogue: 0,1:12:22.83,1:12:24.75,Default,,0,0,0,,Тез арада қызуы басылады.
Dialogue: 0,1:12:25.34,1:12:28.76,Default,,0,0,0,,Мен қозғалғанша біраз уақыт кетуі мүмкін, бірақ...
Dialogue: 0,1:12:29.05,1:12:32.26,Default,,0,0,0,,Мен өлмеймін, көп уайымдама.
Dialogue: 0,1:12:32.55,1:12:34.01,Default,,0,0,0,,Жақсы
Dialogue: 0,1:12:34.18,1:12:35.97,Default,,0,0,0,,Атама рахмет.
Dialogue: 0,1:12:36.18,1:12:38.35,Default,,0,0,0,,Бұл И тайпасының жарасы.
Dialogue: 0,1:12:38.52,1:12:39.64,Default,,0,0,0,,Изоку?
Dialogue: 0,1:12:39.93,1:12:42.77,Default,,0,0,0,,Жарық пен суды жек көретін қарғыс атқан нәсіл.
Dialogue: 0,1:12:43.19,1:12:47.73,Default,,0,0,0,,Дегенмен, ол да дүниенің қазіргі күйін сақтап қалуға тырысатын механизмдерінің бірі.
Dialogue: 0,1:12:47.90,1:12:51.28,Default,,0,0,0,,Сондықтан олар заттардың ортақтастығын жек көреді.
Dialogue: 0,1:12:51.45,1:12:52.86,Default,,0,0,0,,Заттардың алмасуы?
Dialogue: 0,1:12:53.28,1:12:54.87,Default,,0,0,0,,Сонда бұл бала ше?
Dialogue: 0,1:12:55.03,1:12:56.99,Default,,0,0,0,,Мананың әкесі жер адамы.
Dialogue: 0,1:12:57.16,1:12:57.87,Default,,0,0,0,,Ха…
Dialogue: 0,1:12:58.29,1:13:01.87,Default,,0,0,0,,Мұндай жағдай сирек кездеседі
Dialogue: 0,1:13:06.96,1:13:07.88,Default,,0,0,0,,Ах...
Dialogue: 0,1:13:08.30,1:13:09.96,Default,,0,0,0,,Мына ауылдан кет!
Dialogue: 0,1:13:10.13,1:13:10.92,Default,,0,0,0,,Шық!
Dialogue: 0,1:13:11.22,1:13:12.34,Default,,0,0,0,,Ha
Dialogue: 0,1:13:14.34,1:13:16.35,Default,,0,0,0,,Кешіріңіз, жас ханым
Dialogue: 0,1:13:16.51,1:13:18.76,Default,,0,0,0,,Бірақ жердегілердің келуі
Dialogue: 0,1:13:18.89,1:13:21.89,Default,,0,0,0,,Бұл бізге жақсылық әкелмейді.
Dialogue: 0,1:13:22.85,1:13:23.94,Default,,0,0,0,,Асуна
Dialogue: 0,1:13:25.77,1:13:28.27,Default,,0,0,0,,Бір кездері жердің патшалары мен императорлары —
Dialogue: 0,1:13:28.44,1:13:33.95,Default,,0,0,0,,Жүздеген жылдар бойы олар Агартадан байлық пен дағдыларды ұрлап келді.
Dialogue: 0,1:13:34.11,1:13:36.95,Default,,0,0,0,,Патшалар жерді билеу үшін -
Dialogue: 0,1:13:37.12,1:13:40.37,Default,,0,0,0,,Өйткені маған Агартаның білімі мен қазынасы керек еді.
Dialogue: 0,1:13:41.16,1:13:43.87,Default,,0,0,0,,Оның орнына олар әкелді -
Dialogue: 0,1:13:44.00,1:13:45.83,Default,,0,0,0,,Сансыз қақтығыстар болды.
Dialogue: 0,1:13:46.58,1:13:49.71,Default,,0,0,0,,Қала жер бетіндегі басқа жерлерге қарағанда керемет болды.
Dialogue: 0,1:13:49.88,1:13:53.80,Default,,0,0,0,,Бәрі жойылып, туылған балалардың саны бірте-бірте азаяды.
Dialogue: 0,1:13:53.97,1:13:56.64,Default,,0,0,0,,Енді бірнеше ауыл ғана қалды
Dialogue: 0,1:13:57.43,1:14:01.52,Default,,0,0,0,,Сонымен, біз есікті Клависпен жабамыз...
Dialogue: 0,1:14:01.68,1:14:05.35,Default,,0,0,0,,Жерден ешкім кірмейтіндей етіп жабылды.
Dialogue: 0,1:14:06.40,1:14:08.61,Default,,0,0,0,,Сізге кітапханаға апаруға рұқсат етіңіз.
Dialogue: 0,1:14:08.77,1:14:10.65,Default,,0,0,0,,Жас ханым ана жерде.
Dialogue: 0,1:14:10.77,1:14:13.11,Default,,0,0,0,,Маған кешкі ас дайындауға көмектесе аласыз ба?
Dialogue: 0,1:14:13.28,1:14:14.32,Default,,0,0,0,,Иә
Dialogue: 0,1:14:14.70,1:14:15.65,Default,,0,0,0,,Осы жолмен
Dialogue: 0,1:14:20.08,1:14:21.41,Default,,0,0,0,,Мими! Ах
Dialogue: 0,1:14:21.58,1:14:23.00,Default,,0,0,0,,Ах!
Dialogue: 0,1:14:23.54,1:14:24.75,Default,,0,0,0,,Мана…
Dialogue: 0,1:14:31.63,1:14:32.80,Default,,0,0,0,,Ата, енді не болады?
Dialogue: 0,1:14:32.96,1:14:35.30,Default,,0,0,0,,Енді сол шалғамды маған кесіп бере аласыз ба?
Dialogue: 0,1:14:35.47,1:14:36.59,Default,,0,0,0,,Иә
Dialogue: 0,1:14:37.01,1:14:37.97,Default,,0,0,0,,Бұл ма?
Dialogue: 0,1:14:38.14,1:14:39.14,Default,,0,0,0,,О
Dialogue: 0,1:14:42.35,1:14:43.97,Default,,0,0,0,,Шалғам...
Dialogue: 0,1:14:44.64,1:14:46.31,Default,,0,0,0,,Сәлем, Мими!
Dialogue: 0,1:14:46.56,1:14:48.52,Default,,0,0,0,,Ядорико жерлік болады
Dialogue: 0,1:14:48.65,1:14:51.02,Default,,0,0,0,,Сенің бұлай байланғаныңды бірінші рет көруім.
Dialogue: 0,1:14:51.19,1:14:53.32,Default,,0,0,0,,Омела? Сіз мысықтар туралы айтып отырсыз ба?
Dialogue: 0,1:14:53.65,1:14:56.28,Default,,0,0,0,,Құдайдың баласы туылған жануарға қатысты.
Dialogue: 0,1:14:56.45,1:14:59.62,Default,,0,0,0,,Адамдармен бірге өсіп, өз рөліңді орындаған соң...
Dialogue: 0,1:14:59.78,1:15:03.33,Default,,0,0,0,,Кецальттің бір бөлігі болыңыз және мәңгі өмір сүріңіз
Dialogue: 0,1:15:03.49,1:15:04.87,Default,,0,0,0,,Құдай?
Dialogue: 0,1:15:05.04,1:15:06.29,Default,,0,0,0,,Сізге жақсы Мими
Dialogue: 0,1:15:06.41,1:15:09.00,Default,,0,0,0,,Мені сондай керемет жануар деп қателестім.
Dialogue: 0,1:15:09.17,1:15:10.33,Default,,0,0,0,,Қазір—
Dialogue: 0,1:15:11.17,1:15:14.51,Default,,0,0,0,,Мана бітпей тұрып ваннаны бере аласыз ба?
Dialogue: 0,1:15:14.80,1:15:17.01,Default,,0,0,0,,О... ванна! ?
Dialogue: 0,1:15:20.22,1:15:21.35,Default,,0,0,0,,Ах...
Dialogue: 0,1:15:22.72,1:15:25.06,Default,,0,0,0,,Ванналар керемет.
Dialogue: 0,1:15:25.43,1:15:26.48,Default,,0,0,0,,Haah
Dialogue: 0,1:15:26.64,1:15:29.31,Default,,0,0,0,,Ахаха
Dialogue: 0,1:15:29.48,1:15:31.44,Default,,0,0,0,,Міне! Күте тұрыңыз! —
Dialogue: 0,1:15:31.61,1:15:33.52,Default,,0,0,0,,Ах! Мұғалім –
Dialogue: 0,1:15:33.73,1:15:37.53,Default,,0,0,0,,Сіз қалай ойлайсыз? Мен бұл киімді атамнан алғанмын.
Dialogue: 0,1:15:39.15,1:15:41.16,Default,,0,0,0,,Бұл сізге сәйкес келмейді.
Dialogue: 0,1:15:54.25,1:15:55.84,Default,,0,0,0,,Жыламастан тамақ ішіңіз
Dialogue: 0,1:15:56.00,1:15:57.05,Default,,0,0,0,,Өйткені бұл дәмді
Dialogue: 0,1:15:59.47,1:16:00.55,Default,,0,0,0,,Қарт адамдар
Dialogue: 0,1:16:01.22,1:16:04.89,Default,,0,0,0,,Менің алдыңғы сұрағыма жауап бере аласыз ба?
Dialogue: 0,1:16:05.22,1:16:08.14,Default,,0,0,0,,Агартада өлгендердің қайта тірілуіне тыйым салынған.
Dialogue: 0,1:16:08.31,1:16:11.31,Default,,0,0,0,,Тыйым салынған құралдар мүмкін
Dialogue: 0,1:16:13.11,1:16:15.69,Default,,0,0,0,,Онин, өмір де, өлім де.
Dialogue: 0,1:16:15.86,1:16:18.82,Default,,0,0,0,,Үлкен ағынның бір бөлігі ғана
Dialogue: 0,1:16:19.24,1:16:22.82,Default,,0,0,0,,Адамдарға бұл ағынды тоқтатуға рұқсат етілмейді.
Dialogue: 0,1:16:23.07,1:16:24.16,Default,,0,0,0,,Кешірім? —
Dialogue: 0,1:16:24.37,1:16:27.16,Default,,0,0,0,,Неліктен және кімнен кешірім сұрайсыз? —
Dialogue: 0,1:16:27.37,1:16:31.16,Default,,0,0,0,,Қария Жер бетінде мұндай сөздер мен мәтелдер көп.
Dialogue: 0,1:16:31.37,1:16:32.75,Default,,0,0,0,,Менің білгім келетін нәрсе
Dialogue: 0,1:16:32.92,1:16:35.63,Default,,0,0,0,,Жоғалған адаммен қай жерде және қалай қосыламын?
Dialogue: 0,1:16:36.09,1:16:37.34,Default,,0,0,0,,Осымен
Dialogue: 0,1:16:40.92,1:16:43.05,Default,,0,0,0,,Өлгенді жоқтау дұрыс, бірақ...
Dialogue: 0,1:16:43.22,1:16:46.18,Default,,0,0,0,,Өлгенді де, өзін де аяй беру дұрыс емес.
Dialogue: 0,1:16:46.35,1:16:48.39,Default,,0,0,0,,Өзіңіздің адасуыңызда сіз...
Dialogue: 0,1:16:48.56,1:16:51.69,Default,,0,0,0,,Мен жас қызды араласпауым керек еді.
Dialogue: 0,1:16:51.85,1:16:54.10,Default,,0,0,0,,Асунаның еркімен Асуна осында.
Dialogue: 0,1:16:54.27,1:16:55.69,Default,,0,0,0,,Бұл! мен...
Dialogue: 0,1:16:55.86,1:16:57.82,Default,,0,0,0,,Бір нәрсеге жоғары қара
Dialogue: 0,1:16:57.98,1:16:59.28,Default,,0,0,0,,Осылайша сіз...
Dialogue: 0,1:16:59.44,1:17:01.99,Default,,0,0,0,,Мен 2000 жыл бойы үңгірде қамалып отырмын!
Dialogue: 0,1:17:06.28,1:17:10.91,Default,,0,0,0,,Ханым, кешіріңіз, сіз баланың жағдайын тексере аласыз ба?
Dialogue: 0,1:17:11.08,1:17:12.04,Default,,0,0,0,,Жалғастырыңыз
Dialogue: 0,1:17:12.21,1:17:13.33,Default,,0,0,0,,Иә
Dialogue: 0,1:17:20.55,1:17:21.76,Default,,0,0,0,,(шу)
Dialogue: 0,1:17:22.22,1:17:23.30,Default,,0,0,0,,Ах...
Dialogue: 0,1:17:24.26,1:17:26.30,Default,,0,0,0,,Бұл көрініс сізге сәйкес келмейді.
Dialogue: 0,1:17:26.47,1:17:27.18,Default,,0,0,0,,Әй!
Dialogue: 0,1:17:27.55,1:17:29.97,Default,,0,0,0,,Не! оны қалай айту керек
Dialogue: 0,1:17:31.81,1:17:32.85,Default,,0,0,0,,Неге көмектестіңіз?
Dialogue: 0,1:17:33.02,1:17:33.77,Default,,0,0,0,,Иә?
Dialogue: 0,1:17:34.35,1:17:35.81,Default,,0,0,0,,Маған неге көмектестің?
Dialogue: 0,1:17:35.98,1:17:39.11,Default,,0,0,0,,Өйткені Шин де маған көмектесті.
Dialogue: 0,1:17:39.27,1:17:41.82,Default,,0,0,0,,Мені тек ағамның бөксесін сүртуге мәжбүрлеп жатырмын!
Dialogue: 0,1:17:41.99,1:17:43.45,Default,,0,0,0,,Шун-кун?
Dialogue: 0,1:17:43.86,1:17:44.70,Default,,0,0,0,,Куу…
Dialogue: 0,1:17:44.86,1:17:45.78,Default,,0,0,0,,Шин!
Dialogue: 0,1:17:45.95,1:17:46.66,Default,,0,0,0,,Куах
Dialogue: 0,1:17:46.82,1:17:48.28,Default,,0,0,0,,Өзіңізді әлі мәжбүрлемеңіз...
Dialogue: 0,1:17:48.45,1:17:49.99,Default,,0,0,0,,Балалар, бұл жерде болмауың керек.
Dialogue: 0,1:17:50.16,1:17:50.83,Default,,0,0,0,,Иә?
Dialogue: 0,1:17:51.50,1:17:54.58,Default,,0,0,0,,Мен де... И тайпасының сені өлтіруіне рұқсат бергеннен кейін...
Dialogue: 0,1:17:54.71,1:17:56.50,Default,,0,0,0,,Мен Клависті алуым керек еді...
Dialogue: 0,1:17:56.67,1:17:58.63,Default,,0,0,0,,Жоқ, жерде, Архангелимен...
Dialogue: 0,1:17:58.75,1:17:59.84,Default,,0,0,0,,Өлтіру керек еді—
Dialogue: 0,1:18:00.38,1:18:01.59,Default,,0,0,0,,Шығуыңызды өтінемін.
Dialogue: 0,1:18:02.34,1:18:03.22,Default,,0,0,0,,Шин…
Dialogue: 0,1:18:03.38,1:18:04.26,Default,,0,0,0,,Шық кет!
Dialogue: 0,1:18:04.51,1:18:05.43,Default,,0,0,0,,Ha
Dialogue: 0,1:18:10.35,1:18:14.02,Default,,0,0,0,,Мен ертең ерте кетемін. Ерте ұйықта.
Dialogue: 0,1:18:16.73,1:18:18.02,Default,,0,0,0,,Кешіріңіз—
Dialogue: 0,1:18:18.15,1:18:21.27,Default,,0,0,0,,Жердегі адамдарды көпке дейін жасыра алмаймыз.
Dialogue: 0,1:18:21.44,1:18:25.11,Default,,0,0,0,,Мен не айта аламын, мен ол мырзаға айттым.
Dialogue: 0,1:18:25.90,1:18:29.12,Default,,0,0,0,,Тым болмаса бүгін түнде Манамен ұйықта.
Dialogue: 0,1:18:33.04,1:18:34.41,Default,,0,0,0,,Мими
Dialogue: 0,1:18:38.54,1:18:40.75,Default,,0,0,0,,(Асунаның жылағаны)
Dialogue: 0,1:18:43.92,1:18:44.88,Default,,0,0,0,,Ағай...
Dialogue: 0,1:18:49.39,1:18:54.39,Default,,0,0,0,,Барлығы құтқарылу жолында жолға шығады.
Dialogue: 0,1:18:55.06,1:18:57.73,Default,,0,0,0,,Мені кім тоқтата алады?
Dialogue: 0,1:19:08.57,1:19:12.24,Default,,0,0,0,,Қызым қайтып келгендей болды.
Dialogue: 0,1:19:12.41,1:19:13.58,Default,,0,0,0,,Ата…
Dialogue: 0,1:19:14.75,1:19:16.25,Default,,0,0,0,,Аман болыңыз
Dialogue: 0,1:19:16.96,1:19:20.08,Default,,0,0,0,,Қайық көлге шамамен екі күн мен түнде жетеді.
Dialogue: 0,1:19:20.25,1:19:23.00,Default,,0,0,0,,Сол жерден Они және т.б. баратын жер жақын.
Dialogue: 0,1:19:23.17,1:19:25.09,Default,,0,0,0,,Барлығы үшін рахмет...
Dialogue: 0,1:19:25.26,1:19:26.21,Default,,0,0,0,,Асуна
Dialogue: 0,1:19:29.93,1:19:31.43,Default,,0,0,0,,Мими, жүр.
Dialogue: 0,1:19:31.68,1:19:32.72,Default,,0,0,0,,Жүр, кеттік.
Dialogue: 0,1:19:32.89,1:19:33.93,Default,,0,0,0,,Мияу
Dialogue: 0,1:19:34.72,1:19:35.39,Default,,0,0,0,,Ах...
Dialogue: 0,1:19:35.56,1:19:36.56,Default,,0,0,0,,Мими?
Dialogue: 0,1:19:36.93,1:19:40.31,Default,,0,0,0,,Мүмкін бала өз міндетін атқарған шығар.
Dialogue: 0,1:19:40.48,1:19:41.23,Default,,0,0,0,,Иә?
Dialogue: 0,1:19:41.40,1:19:44.57,Default,,0,0,0,,Адамдар Ядорико не істейтінін шеше алмайды.
Dialogue: 0,1:19:44.73,1:19:47.57,Default,,0,0,0,,Міне... біз мәңгі бірге болдық!
Dialogue: 0,1:19:47.74,1:19:49.53,Default,,0,0,0,,Мими!
Dialogue: 0,1:19:49.70,1:19:51.95,Default,,0,0,0,,Асуна: Оны қабылдаудан басқа амалымыз жоқ сияқты.
Dialogue: 0,1:19:52.12,1:19:54.28,Default,,0,0,0,,Қария, өтінемін.
Dialogue: 0,1:19:55.87,1:19:57.58,Default,,0,0,0,,Мими! Ах...
Dialogue: 0,1:19:57.95,1:20:00.08,Default,,0,0,0,,Мұғалім, күте тұрыңыз.
Dialogue: 0,1:20:00.25,1:20:01.42,Default,,0,0,0,,Мими!
Dialogue: 0,1:20:04.34,1:20:05.17,Default,,0,0,0,,А…
Dialogue: 0,1:20:07.34,1:20:09.09,Default,,0,0,0,,Мана Мими өтінемін! —
Dialogue: 0,1:20:09.51,1:20:12.09,Default,,0,0,0,,Мими Мананың айтқанын мұқият тыңда!
Dialogue: 0,1:20:14.76,1:20:15.97,Default,,0,0,0,,(Юки) Уф… (Ишикава) Ха…
Dialogue: 0,1:20:43.33,1:20:44.33,Default,,0,0,0,,Мұғалім –
Dialogue: 0,1:20:44.92,1:20:48.34,Default,,0,0,0,,Бірде сабақта маған айтқан әңгіме есіңде ме? —
Dialogue: 0,1:20:48.51,1:20:50.34,Default,,0,0,0,,Изанаги мен Изанами туралы миф
Dialogue: 0,1:20:50.51,1:20:51.34,Default,,0,0,0,,О
Dialogue: 0,1:20:51.84,1:20:55.80,Default,,0,0,0,,Маған соңы қызық болды, қалғанын кітапханадан оқыдым.
Dialogue: 0,1:20:56.81,1:20:58.93,Default,,0,0,0,,Изанаги жер қойнауында көргені—
Dialogue: 0,1:20:59.10,1:21:03.06,Default,,0,0,0,,Жан түршігерлік кейіпке енген менің әйелім еді.
Dialogue: 0,1:21:04.44,1:21:05.86,Default,,0,0,0,,Әлі-
Dialogue: 0,1:21:06.15,1:21:09.61,Default,,0,0,0,,Өлгендерді тірілту дұрыс па?
Dialogue: 0,1:21:10.40,1:21:12.24,Default,,0,0,0,,Саяхат аяқталуға жақын
Dialogue: 0,1:21:12.53,1:21:17.87,Default,,0,0,0,,Асуна, өмір мен өлімнің қақпасында не қалайтыныңды өзің шеш.
Dialogue: 0,1:21:22.75,1:21:24.04,Default,,0,0,0,,Жарық... адамдар?
Dialogue: 0,1:21:24.21,1:21:25.63,Default,,0,0,0,,Жоқ
Dialogue: 0,1:21:26.79,1:21:27.84,Default,,0,0,0,,И тайпасы!
Dialogue: 0,1:21:28.09,1:21:30.84,Default,,0,0,0,,Ештеңе етпейді, осы уақытқа дейін келе алмау керек.
Dialogue: 0,1:21:42.23,1:21:43.35,Default,,0,0,0,,Ах...
Dialogue: 0,1:21:46.35,1:21:48.36,Default,,0,0,0,,Уау!
Dialogue: 0,1:21:48.73,1:21:51.36,Default,,0,0,0,,(Мананың айқайы)
Dialogue: 0,1:21:57.62,1:21:58.49,Default,,0,0,0,,Ах
Dialogue: 0,1:22:01.41,1:22:06.37,Default,,0,0,0,,Бұл әлемдегі рөліңізді аяқтап, келесі әлемге өту уақыты келді.
Dialogue: 0,1:22:06.83,1:22:08.38,Default,,0,0,0,,Көп жыла
Dialogue: 0,1:22:08.84,1:22:11.34,Default,,0,0,0,,Сол жас ханым үшін де
Dialogue: 0,1:22:22.56,1:22:24.56,Default,,0,0,0,,Хаа ха
Dialogue: 0,1:22:26.85,1:22:27.94,Default,,0,0,0,,Міне!
Dialogue: 0,1:22:28.10,1:22:29.90,Default,,0,0,0,,Ол жақында келеді.
Dialogue: 0,1:22:38.78,1:22:41.41,Default,,0,0,0,,Кецаль? Қанша жаста...
Dialogue: 0,1:22:50.67,1:22:51.59,Default,,0,0,0,,А…
Dialogue: 0,1:23:03.81,1:23:08.94,Default,,0,0,0,,Осылайша өмір үлкен нәрсенің бір бөлігіне айналады.
Dialogue: 0,1:23:11.19,1:23:14.07,Default,,0,0,0,,Асуна да солай ойлай ма?
Dialogue: 0,1:23:14.23,1:23:16.82,Default,,0,0,0,,Мен үшін маңызды адам қайтыс болса да
Dialogue: 0,1:23:17.15,1:23:21.16,Default,,0,0,0,,Қария, Ағарт әлемі – бұл дүниедегі өмірдің өткіншілігі.
Dialogue: 0,1:23:21.32,1:23:23.37,Default,,0,0,0,,Мағынаның жоқтығын тым түсінеді
Dialogue: 0,1:23:23.54,1:23:26.66,Default,,0,0,0,,Сол себепті жойылып жатқан жоқпыз ба?
Dialogue: 0,1:23:27.25,1:23:31.54,Default,,0,0,0,,Сіздің жетілмегендігіңіз сол жердегі адамға қатты ұқсайды.
Dialogue: 0,1:23:31.71,1:23:32.46,Default,,0,0,0,,Жоқ…
Dialogue: 0,1:23:33.92,1:23:34.96,Default,,0,0,0,,Ах
Dialogue: 0,1:23:42.22,1:23:45.14,Default,,0,0,0,,А, ол ұзын бөшке көтеріп жүр!
Dialogue: 0,1:23:46.06,1:23:48.89,Default,,0,0,0,,Жердегі адамдарды өлтірсең де тоқтатасың ба?
Dialogue: 0,1:23:49.10,1:23:51.86,Default,,0,0,0,,Бұл сіздің рөліңіз сияқты...
Dialogue: 0,1:23:55.23,1:23:57.24,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,1:23:57.86,1:23:59.20,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,1:24:00.20,1:24:00.99,Default,,0,0,0,,Бірақ! —
Dialogue: 0,1:24:01.36,1:24:04.37,Default,,0,0,0,,Мен сенің жақсылығыңды міндетті түрде қайтарамын. Ха!
Dialogue: 0,1:24:10.46,1:24:12.75,Default,,0,0,0,,Барлығы кетіп қалады.
Dialogue: 0,1:24:38.82,1:24:43.07,Default,,0,0,0,,Бұл жотаның арғы жағында. И тайпасы кеткенше асығайық.
Dialogue: 0,1:24:44.16,1:24:44.95,Default,,0,0,0,,Ах...
Dialogue: 0,1:24:45.70,1:24:46.74,Default,,0,0,0,,Асуна
Dialogue: 0,1:24:46.91,1:24:49.20,Default,,0,0,0,,Сіз ештеңе естімейсіз бе?
Dialogue: 0,1:24:55.25,1:24:58.05,Default,,0,0,0,,(ат тұяғының дыбысы)
Dialogue: 0,1:24:59.63,1:25:00.38,Default,,0,0,0,,Ha
Dialogue: 0,1:25:02.22,1:25:03.47,Default,,0,0,0,,Аморот солдаты.
Dialogue: 0,1:25:03.64,1:25:04.39,Default,,0,0,0,,Менің шын атым Джеймс Рэтли
Dialogue: 0,1:25:09.18,1:25:11.10,Default,,0,0,0,,Жасыру. Жақында бітеді.
Dialogue: 0,1:25:11.27,1:25:12.56,Default,,0,0,0,,Не? Кя! —
Dialogue: 0,1:25:14.10,1:25:14.81,Default,,0,0,0,,Ұстаз!
Dialogue: 0,1:25:14.98,1:25:17.02,Default,,0,0,0,,Олар бізді де өлтірмекші.
Dialogue: 0,1:25:28.62,1:25:29.58,Default,,0,0,0,,Шин!
Dialogue: 0,1:25:29.74,1:25:30.70,Default,,0,0,0,,Қосымша заттар!
Dialogue: 0,1:25:30.87,1:25:32.12,Default,,0,0,0,,Ешкімді өлтірме -
Dialogue: 0,1:25:32.29,1:25:34.75,Default,,0,0,0,,Бұл тек Агартаның өшпенділігін арттырады.
Dialogue: 0,1:25:42.05,1:25:45.43,Default,,0,0,0,,Сіз Қанахан ауылынансыз ба? Неліктен жер бетіндегі адамдарды қорғайсың?
Dialogue: 0,1:25:45.59,1:25:48.26,Default,,0,0,0,,Осы екеуі ауылыңыздан бір қызды құтқарып қалды.
Dialogue: 0,1:25:48.68,1:25:50.27,Default,,0,0,0,,Алғыс айтудың қарызы болуы керек.
Dialogue: 0,1:25:50.43,1:25:54.48,Default,,0,0,0,,Адамдарды жерде бақылаусыз қалдыру жойылуға әкеледі.
Dialogue: 0,1:25:54.64,1:25:56.60,Default,,0,0,0,,Болашақта қиындықтың тамырын қалдыра алмайды
Dialogue: 0,1:25:56.77,1:25:57.52,Default,,0,0,0,,Жолдан кет!
Dialogue: 0,1:26:07.82,1:26:08.74,Default,,0,0,0,,Ах!
Dialogue: 0,1:26:09.41,1:26:11.54,Default,,0,0,0,,Барып, қарызыңды өте!
Dialogue: 0,1:26:13.91,1:26:15.04,Default,,0,0,0,,Ha
Dialogue: 0,1:26:16.58,1:26:17.46,Default,,0,0,0,,Шин!
Dialogue: 0,1:26:37.23,1:26:38.52,Default,,0,0,0,,Керемет
Dialogue: 0,1:26:38.69,1:26:40.57,Default,,0,0,0,,Хигучиді ұстамас бұрын, оның неге адам өлтіріп жатқанын білуіміз керек.
Dialogue: 0,1:26:45.28,1:26:47.36,Default,,0,0,0,,А...
Dialogue: 0,1:26:51.16,1:26:52.58,Default,,0,0,0,,(Асунаның ауыр тыныс алуы)
Dialogue: 0,1:26:56.79,1:26:59.75,Default,,0,0,0,,Бұл дүниенің соңы - Финис Терра.
Dialogue: 0,1:26:59.92,1:27:02.34,Default,,0,0,0,,Сол жардың түбінде өмір мен өлімнің қақпасы бар.
Dialogue: 0,1:27:08.34,1:27:11.51,Default,,0,0,0,,Асығыңыз, оның ісі босқа кетпесін.
Dialogue: 0,1:27:26.69,1:27:29.20,Default,,0,0,0,,Жарық бол, жардан түсесің.
Dialogue: 0,1:27:29.36,1:27:30.57,Default,,0,0,0,,Не? —
Dialogue: 0,1:27:33.49,1:27:34.37,Default,,0,0,0,,Ha
Dialogue: 0,1:27:36.91,1:27:37.87,Default,,0,0,0,,Міне...
Dialogue: 0,1:27:38.08,1:27:40.08,Default,,0,0,0,,Бұл мүмкін емес! басқа жерден
Dialogue: 0,1:27:40.25,1:27:41.38,Default,,0,0,0,,Менің бұған уақытым жоқ.
Dialogue: 0,1:27:41.67,1:27:43.75,Default,,0,0,0,,Күн батқанда И тайпасы шығады.
Dialogue: 0,1:27:43.92,1:27:45.55,Default,,0,0,0,,Кеттік
Dialogue: 0,1:27:48.51,1:27:49.38,Default,,0,0,0,,Ұстаз!
Dialogue: 0,1:28:07.44,1:28:08.53,Default,,0,0,0,,Ха! —
Dialogue: 0,1:28:10.45,1:28:11.74,Default,,0,0,0,,Уф
Dialogue: 0,1:28:12.57,1:28:13.62,Default,,0,0,0,,Асуна
Dialogue: 0,1:28:26.30,1:28:28.76,Default,,0,0,0,,Ха ха ха
Dialogue: 0,1:28:30.97,1:28:32.14,Default,,0,0,0,,Асуна
Dialogue: 0,1:28:37.93,1:28:39.56,Default,,0,0,0,,Мұқият тыңдаңыз
Dialogue: 0,1:28:39.77,1:28:43.69,Default,,0,0,0,,Сіз саңылаулар теңізінен өтіп, соншалықты әлемге келдіңіз.
Dialogue: 0,1:28:43.86,1:28:46.07,Default,,0,0,0,,Бұл жардан міндетті түрде өте аласыз.
Dialogue: 0,1:28:46.52,1:28:49.07,Default,,0,0,0,,Агартаға не үшін келдің?
Dialogue: 0,1:28:49.24,1:28:51.49,Default,,0,0,0,,Бірақ... Бірақ мұнда!
Dialogue: 0,1:28:52.49,1:28:54.99,Default,,0,0,0,,Мен... мүмкін емес.
Dialogue: 0,1:28:57.16,1:28:58.16,Default,,0,0,0,,Ha
Dialogue: 0,1:29:03.71,1:29:04.50,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:29:14.26,1:29:17.51,Default,,0,0,0,,Енді тоқтатыңыз, сіз Агартадағы орнын жоғалтасыз.
Dialogue: 0,1:29:21.56,1:29:24.02,Default,,0,0,0,,Мені қайда жүргенім қызықтырмайды!
Dialogue: 0,1:29:27.65,1:29:30.61,Default,,0,0,0,,Жарайды, мен жалғыз барамын...
Dialogue: 0,1:29:31.28,1:29:35.24,Default,,0,0,0,,Маған Клависті беріңіз, оның орнына сіз оны аласыз.
Dialogue: 0,1:29:38.70,1:29:41.79,Default,,0,0,0,,Өзенге көтеріліп, қарияны көзде.
Dialogue: 0,1:29:41.95,1:29:45.58,Default,,0,0,0,,Түн түскенде И тайпасынан аулақ болу үшін суға түс.
Dialogue: 0,1:29:46.13,1:29:49.80,Default,,0,0,0,,Асуна, сенің өмір сүргеніңді қалаймын.
Dialogue: 0,1:29:49.96,1:29:51.34,Default,,0,0,0,,Бұл өзімшіл болуы мүмкін, бірақ
Dialogue: 0,1:29:51.51,1:29:54.34,Default,,0,0,0,,Мүмкіндігінше мұны есте сақтаңыз.
Dialogue: 0,1:30:02.89,1:30:04.31,Default,,0,0,0,,Уф
Dialogue: 0,1:30:14.36,1:30:15.28,Default,,0,0,0,,Ах...
Dialogue: 0,1:30:22.41,1:30:25.00,Default,,0,0,0,,Клавис Финис Терраның астында жоғалып кетті.
Dialogue: 0,1:30:25.16,1:30:27.00,Default,,0,0,0,,Мен оны одан әрі жалғастыра алмаймын.
Dialogue: 0,1:30:27.17,1:30:31.63,Default,,0,0,0,,Дегенмен, жердегі адамдар оны бәрібір жардан тірідей түсіруі екіталай.
Dialogue: 0,1:30:31.96,1:30:35.01,Default,,0,0,0,,Кішкентай бала, Ағартқа да, жерге де жете алмайсың.
Dialogue: 0,1:30:35.17,1:30:38.39,Default,,0,0,0,,Бұдан былай менің демалатын жерім қалмайды.
Dialogue: 0,1:30:39.14,1:30:41.89,Default,,0,0,0,,Мәңгілік қаңғыбас өмірді таңдадың.
Dialogue: 0,1:30:42.22,1:30:44.43,Default,,0,0,0,,Өкінуді жалғастырыңыз
Dialogue: 0,1:30:49.36,1:30:50.73,Default,,0,0,0,,Уф...
Dialogue: 0,1:30:51.32,1:30:54.99,Default,,0,0,0,,Өзімді тым алысқа итеріп жібергенім үшін кешіріңіз.
Dialogue: 0,1:30:55.15,1:30:56.20,Default,,0,0,0,,Сіз тұра аласыз ба?
Dialogue: 0,1:30:59.12,1:31:01.20,Default,,0,0,0,,Енді қайда барамыз?
Dialogue: 0,1:31:24.31,1:31:25.77,Default,,0,0,0,,(сыбырлау)
Dialogue: 0,1:31:27.19,1:31:28.19,Default,,0,0,0,,Ха!
Dialogue: 0,1:31:30.40,1:31:31.98,Default,,0,0,0,,Ауылдың қарапайым адамдары көбейіп кеткен сияқты.
Dialogue: 0,1:31:50.04,1:31:50.79,Default,,0,0,0,,Ах!
Dialogue: 0,1:31:51.08,1:31:52.71,Default,,0,0,0,,Пуха! Эхо Эхо
Dialogue: 0,1:31:52.88,1:31:53.63,Default,,0,0,0,,(сыбырлау)
Dialogue: 0,1:31:53.79,1:31:54.63,Default,,0,0,0,,Ha
Dialogue: 0,1:31:59.34,1:32:00.51,Default,,0,0,0,,Уф...
Dialogue: 0,1:32:14.61,1:32:15.90,Default,,0,0,0,,Уф
Dialogue: 0,1:32:18.19,1:32:19.32,Default,,0,0,0,,Ах
Dialogue: 0,1:32:22.16,1:32:23.82,Default,,0,0,0,,Уау
Dialogue: 0,1:32:32.12,1:32:33.92,Default,,0,0,0,,Асуна...!
Dialogue: 0,1:32:39.80,1:32:40.97,Default,,0,0,0,,Уау!
Dialogue: 0,1:32:41.13,1:32:42.47,Default,,0,0,0,,Ах!
Dialogue: 0,1:32:42.97,1:32:43.93,Default,,0,0,0,,Уф!
Dialogue: 0,1:32:50.06,1:32:51.73,Default,,0,0,0,,Уф
Dialogue: 0,1:32:53.06,1:32:53.94,Default,,0,0,0,,Ha
Dialogue: 0,1:32:54.73,1:32:56.77,Default,,0,0,0,,Үйінділер?... Уф.
Dialogue: 0,1:33:04.53,1:33:05.78,Default,,0,0,0,,Хмм.
Dialogue: 0,1:33:06.24,1:33:07.08,Default,,0,0,0,,Сонда бәрі бір сәтте бітеді.
Dialogue: 0,1:33:07.95,1:33:09.12,Default,,0,0,0,,Хаа ха
Dialogue: 0,1:33:44.32,1:33:46.49,Default,,0,0,0,,Кегареда
Dialogue: 0,1:33:46.66,1:33:47.91,Default,,0,0,0,,Colosse квесті
Dialogue: 0,1:33:48.08,1:33:49.62,Default,,0,0,0,,Кегареда…
Dialogue: 0,1:33:49.83,1:33:50.83,Default,,0,0,0,,Que
Dialogue: 0,1:33:51.00,1:33:53.62,Default,,0,0,0,,Colosse квесті
Dialogue: 0,1:34:04.09,1:34:05.13,Default,,0,0,0,,Асуна —
Dialogue: 0,1:34:06.01,1:34:07.60,Default,,0,0,0,,Бата беріңіз
Dialogue: 0,1:34:11.93,1:34:13.18,Default,,0,0,0,,Сол жігіт мүлде есінен танып кетті – адамдар оны ұстап тұруға мәжбүр болды.
Dialogue: 0,1:34:13.98,1:34:15.44,Default,,0,0,0,,Бата дегеніміз не?
Dialogue: 0,1:34:15.60,1:34:16.90,Default,,0,0,0,,Бата?
Dialogue: 0,1:34:17.06,1:34:18.98,Default,,0,0,0,,Мен саған батамды беремін.
Dialogue: 0,1:34:19.27,1:34:20.82,Default,,0,0,0,,Сізге біреу айтты ма?
Dialogue: 0,1:34:20.98,1:34:21.65,Default,,0,0,0,,Ах...
Dialogue: 0,1:34:22.74,1:34:25.65,Default,,0,0,0,,Асунаның дүниеге келгеніне қуаныштымын.
Dialogue: 0,1:34:25.82,1:34:27.37,Default,,0,0,0,,Мен де солай ойлаймын.
Dialogue: 0,1:34:29.33,1:34:31.95,Default,,0,0,0,,Асуна-чан, үйге бірге барайық.
Dialogue: 0,1:34:32.33,1:34:33.16,Default,,0,0,0,,Асуна!
Dialogue: 0,1:34:34.00,1:34:35.66,Default,,0,0,0,,Сізді қатысқаным үшін кешіріңіз.
Dialogue: 0,1:34:35.83,1:34:36.67,Default,,0,0,0,,Асуна
Dialogue: 0,1:34:36.87,1:34:38.00,Default,,0,0,0,,Аа
Dialogue: 0,1:34:38.50,1:34:40.00,Default,,0,0,0,,Маған неге көмектестің?
Dialogue: 0,1:34:40.50,1:34:42.96,Default,,0,0,0,,Адамдар қаншалықты жалғыз
Dialogue: 0,1:34:43.21,1:34:44.47,Default,,0,0,0,,Қарызды өтеңіз!
Dialogue: 0,1:34:44.67,1:34:45.80,Default,,0,0,0,,Асуна
Dialogue: 0,1:34:46.01,1:34:46.97,Default,,0,0,0,,Сен…
Dialogue: 0,1:34:48.18,1:34:51.47,Default,,0,0,0,,Агартаға не үшін келдің?
Dialogue: 0,1:34:59.81,1:35:02.65,Default,,0,0,0,,Мен қандаймын...—
Dialogue: 0,1:35:04.86,1:35:07.53,Default,,0,0,0,,Мен өзімді жалғыз сезіндім.
Dialogue: 0,1:35:09.32,1:35:10.28,Default,,0,0,0,,Ha
Dialogue: 0,1:35:16.12,1:35:17.16,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,1:35:39.77,1:35:40.69,Default,,0,0,0,,Лиза...—
Dialogue: 0,1:35:43.02,1:35:44.53,Default,,0,0,0,,Жақында кездескенше...
Dialogue: 0,1:35:45.40,1:35:46.78,Default,,0,0,0,,Ол не істеп жүр екен…
Dialogue: 0,1:35:47.74,1:35:49.86,Default,,0,0,0,,(И тайпасының дауысы)
Dialogue: 0,1:35:50.61,1:35:51.37,Default,,0,0,0,,Тұтқындарға арналған екінші жатақхана.
Dialogue: 0,1:35:51.66,1:35:52.87,Default,,0,0,0,,Га—
Dialogue: 0,1:35:55.16,1:35:56.37,Default,,0,0,0,,Су тартылып жатыр! —
Dialogue: 0,1:35:56.75,1:35:58.12,Default,,0,0,0,,Ал енді Пенбардан келген соңғы видео бар.
Dialogue: 0,1:36:00.54,1:36:02.88,Default,,0,0,0,,Кегареда…
Dialogue: 0,1:36:04.34,1:36:05.38,Default,,0,0,0,,Колосса…
Dialogue: 0,1:36:05.75,1:36:07.01,Default,,0,0,0,,Ха!
Dialogue: 0,1:36:07.47,1:36:08.67,Default,,0,0,0,,Ах...—
Dialogue: 0,1:36:12.26,1:36:15.35,Default,,0,0,0,,Ей Эй! —
Dialogue: 0,1:36:16.77,1:36:18.56,Default,,0,0,0,,Уф
Dialogue: 0,1:36:21.27,1:36:22.69,Default,,0,0,0,,Уф...
Dialogue: 0,1:36:30.78,1:36:32.20,Default,,0,0,0,,Осы жерде күтіңіз.
Dialogue: 0,1:36:41.37,1:36:42.25,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:36:43.79,1:36:44.54,Default,,0,0,0,,Уф...
Dialogue: 0,1:36:44.71,1:36:48.13,Default,,0,0,0,,(И тайпасының дауысы)
Dialogue: 0,1:36:54.60,1:36:57.93,Default,,0,0,0,,Кегареда тамақтану
Dialogue: 0,1:36:58.31,1:36:59.52,Default,,0,0,0,,Гвар
Dialogue: 0,1:36:59.98,1:37:02.56,Default,,0,0,0,,Кууууууууууууууууууууууууууууу
Dialogue: 0,1:37:04.69,1:37:06.15,Default,,0,0,0,,I…—
Dialogue: 0,1:37:07.90,1:37:11.57,Default,,0,0,0,,Мен өмір сүруім керек...
Dialogue: 0,1:37:11.86,1:37:13.45,Default,,0,0,0,,Уф… Уф…
Dialogue: 0,1:37:17.66,1:37:18.79,Default,,0,0,0,,Асуна! —
Dialogue: 0,1:37:20.87,1:37:22.41,Default,,0,0,0,,Сен, жансыз құрал—
Dialogue: 0,1:37:23.00,1:37:23.71,Default,,0,0,0,,Гх
Dialogue: 0,1:37:23.87,1:37:25.42,Default,,0,0,0,,Ха!
Dialogue: 0,1:37:33.68,1:37:35.18,Default,,0,0,0,,Түн батады
Dialogue: 0,1:37:37.93,1:37:40.18,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,1:37:41.98,1:37:43.73,Default,,0,0,0,,Гвай
Dialogue: 0,1:37:47.06,1:37:49.36,Default,,0,0,0,,Аман-есен болғаныңызға қуаныштымын, Асуна.
Dialogue: 0,1:37:49.53,1:37:50.40,Default,,0,0,0,,Иә
Dialogue: 0,1:37:51.61,1:37:54.86,Default,,0,0,0,,Көмегің үшін рахмет, Шин.
Dialogue: 0,1:37:57.49,1:38:00.58,Default,,0,0,0,,Мен сізге бұрын ешқашан дұрыс алғыс айтқан емеспін.
Dialogue: 0,1:38:00.74,1:38:02.37,Default,,0,0,0,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,1:38:02.58,1:38:06.50,Default,,0,0,0,,Сіздің денеңіз сіз бұл туралы ойланбай тұрып өздігінен қозғалады.
Dialogue: 0,1:38:07.54,1:38:10.09,Default,,0,0,0,,Мен сізге көмектескім келген жоқ.
Dialogue: 0,1:38:11.88,1:38:12.59,Default,,0,0,0,,Ах...
Dialogue: 0,1:38:14.13,1:38:15.51,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:38:15.80,1:38:18.80,Default,,0,0,0,,Оның көзінің түсі Шункундікінен сәл өзгеше.
Dialogue: 0,1:38:18.97,1:38:21.97,Default,,0,0,0,,Әй, менің ағам да ұзынырақ еді.
Dialogue: 0,1:38:22.10,1:38:23.43,Default,,0,0,0,,Шаштың түсі де сәл өзгеше.
Dialogue: 0,1:38:23.60,1:38:25.52,Default,,0,0,0,,Не, сен бала емессің бе?
Dialogue: 0,1:38:25.69,1:38:27.02,Default,,0,0,0,,Сен де баласың!
Dialogue: 0,1:38:29.15,1:38:32.11,Default,,0,0,0,,Өйткені, Шин Шун-кун емес еді.
Dialogue: 0,1:38:32.28,1:38:34.53,Default,,0,0,0,,Сіз бәрібір олай істемейсіз!
Dialogue: 0,1:38:37.57,1:38:38.53,Default,,0,0,0,,(Ватару) Не?! (Цубаки) Бұл тым ерте емес пе?
Dialogue: 0,1:38:39.20,1:38:40.33,Default,,0,0,0,,Өйткені...
Dialogue: 0,1:38:45.71,1:38:47.04,Default,,0,0,0,,Жылама!
Dialogue: 0,1:38:48.58,1:38:49.75,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,1:38:53.09,1:38:54.34,Default,,0,0,0,,Аға
Dialogue: 0,1:38:55.05,1:38:57.05,Default,,0,0,0,,Уау!
Dialogue: 0,1:39:11.07,1:39:13.44,Default,,0,0,0,,(керемет дыбыс)
Dialogue: 0,1:39:15.69,1:39:16.82,Default,,0,0,0,,Ha
Dialogue: 0,1:39:16.99,1:39:18.07,Default,,0,0,0,,Ах
Dialogue: 0,1:39:18.49,1:39:20.28,Default,,0,0,0,,Шакна Вимана —
Dialogue: 0,1:39:20.45,1:39:22.03,Default,,0,0,0,,Өмір мен өлім қақпасына бет бұру
Dialogue: 0,1:39:22.20,1:39:23.70,Default,,0,0,0,,Бұл мұғалім!
Dialogue: 0,1:39:23.87,1:39:26.00,Default,,0,0,0,,Архангели келді ме?
Dialogue: 0,1:39:26.75,1:39:29.12,Default,,0,0,0,,Вимана - өмірді алып бара жатқан қайық!
Dialogue: 0,1:39:39.59,1:39:41.64,Default,,0,0,0,,Finis Terra
Dialogue: 0,1:39:42.30,1:39:44.81,Default,,0,0,0,,Екеуміз ұзақ уақыт бөлек тұрдық деп ойладым.
Dialogue: 0,1:39:44.97,1:39:47.73,Default,,0,0,0,,Мен қараңғыда айналамын.
Dialogue: 0,1:39:47.89,1:39:48.73,Default,,0,0,0,,Ха!
Dialogue: 0,1:39:49.48,1:39:51.31,Default,,0,0,0,,Quetzaltl!
Dialogue: 0,1:40:00.82,1:40:03.12,Default,,0,0,0,,Асуна Бұл Кецальтл...
Dialogue: 0,1:40:08.83,1:40:11.54,Default,,0,0,0,,Бұл жерге өлу үшін келген шығар.
Dialogue: 0,1:40:29.52,1:40:30.81,Default,,0,0,0,,Әй
Dialogue: 0,1:40:33.48,1:40:34.57,Default,,0,0,0,,Уау
Dialogue: 0,1:40:36.86,1:40:37.94,Default,,0,0,0,,Ах...
Dialogue: 0,1:40:40.03,1:40:43.28,Default,,0,0,0,,Бұл Vitaqua. Бұл...
Dialogue: 0,1:40:48.62,1:40:50.75,Default,,0,0,0,,Кецальт зираты?
Dialogue: 0,1:41:04.05,1:41:07.18,Default,,0,0,0,,Бұл... өмір мен өлімнің қақпасы
Dialogue: 0,1:41:07.35,1:41:08.47,Default,,0,0,0,,(әдемі дыбыс)
Dialogue: 0,1:41:08.77,1:41:09.81,Default,,0,0,0,,Ах
Dialogue: 0,1:41:10.48,1:41:11.48,Default,,0,0,0,,Ән?
Dialogue: 0,1:41:11.64,1:41:14.48,Default,,0,0,0,,(Кветаль әні)
Dialogue: 0,1:41:15.56,1:41:18.36,Default,,0,0,0,,(Кветаль әні)
Dialogue: 0,1:41:20.11,1:41:23.03,Default,,0,0,0,,Кецаль өлмес бұрын солай жасады.
Dialogue: 0,1:41:23.20,1:41:26.28,Default,,0,0,0,,Барлық естеліктеріңізді әнде қалдырыңыз
Dialogue: 0,1:41:26.45,1:41:29.75,Default,,0,0,0,,Ән әртүрлі формада мәңгілікке саяхаттайды.
Dialogue: 0,1:41:30.45,1:41:33.00,Default,,0,0,0,,Ауа дірілінде тұқым қуалайды—
Dialogue: 0,1:41:33.33,1:41:36.75,Default,,0,0,0,,Ол біздің денемізге біз байқамай араласады.
Dialogue: 0,1:41:37.38,1:41:40.13,Default,,0,0,0,,Сонымен әлемнің бір жерінде—
Dialogue: 0,1:41:40.30,1:41:42.38,Default,,0,0,0,,Мәңгілік есте қалатын сияқты.
Dialogue: 0,1:41:42.55,1:41:45.43,Default,,0,0,0,,(Әдемі дауыс)
Dialogue: 0,1:41:45.59,1:41:49.39,Default,,0,0,0,,Мен бұл әнді бұрын естігенмін.
Dialogue: 0,1:41:49.89,1:41:53.56,Default,,0,0,0,,Жүрегімде мәңгі сақталады
Dialogue: 0,1:41:57.27,1:41:58.77,Default,,0,0,0,,Ha
Dialogue: 0,1:41:58.94,1:41:59.78,Default,,0,0,0,,Асуна!
Dialogue: 0,1:41:59.94,1:42:02.53,Default,,0,0,0,,Шин Мен мұғалімге баруым керек.
Dialogue: 0,1:42:02.69,1:42:04.86,Default,,0,0,0,,Сіз жалғыз қиындыққа тап болуыңыз мүмкін нәрселер
Dialogue: 0,1:42:05.03,1:42:06.62,Default,,0,0,0,,Бірақ бұл жартас...
Dialogue: 0,1:42:07.62,1:42:09.87,Default,,0,0,0,,Бұл адам мені алып кетеді!
Dialogue: 0,1:42:16.00,1:42:17.17,Default,,0,0,0,,Ха!
Dialogue: 0,1:43:00.00,1:43:02.25,Default,,0,0,0,,(керемет дыбыс)
Dialogue: 0,1:43:26.53,1:43:27.57,Default,,0,0,0,,Ха!
Dialogue: 0,1:43:29.41,1:43:31.12,Default,,0,0,0,,(керемет дыбыс)
Dialogue: 0,1:43:34.08,1:43:35.62,Default,,0,0,0,,Шакна Вимана!
Dialogue: 0,1:43:56.93,1:43:58.19,Default,,0,0,0,,Га—
Dialogue: 0,1:44:01.40,1:44:03.27,Default,,0,0,0,,Бұл Агарта...
Dialogue: 0,1:44:03.73,1:44:04.73,Default,,0,0,0,,Құдай!
Dialogue: 0,1:44:06.44,1:44:08.90,Default,,0,0,0,,(Шакна Вимананың дауысы)
Dialogue: 0,1:44:09.91,1:44:11.74,Default,,0,0,0,,«Тілек айту»?
Dialogue: 0,1:44:16.04,1:44:20.54,Default,,0,0,0,,10 жыл ішінде мен бір сәтті ұмытқан емеспін.
Dialogue: 0,1:44:20.92,1:44:23.59,Default,,0,0,0,,Мен сенің өліміңді жеңуге тырыстым.
Dialogue: 0,1:44:23.75,1:44:25.71,Default,,0,0,0,,Бірақ... бұл жақсы емес.
Dialogue: 0,1:44:25.88,1:44:29.09,Default,,0,0,0,,Мен сенсіз дүниеден мән таба алмаймын
Dialogue: 0,1:44:30.38,1:44:33.30,Default,,0,0,0,,Лиза, маған қайтып келші!
Dialogue: 0,1:44:45.11,1:44:45.94,Default,,0,0,0,,Ах...
Dialogue: 0,1:44:57.95,1:44:59.33,Default,,0,0,0,,Шин! Ах...
Dialogue: 0,1:45:01.79,1:45:03.67,Default,,0,0,0,,Ах...
Dialogue: 0,1:45:04.67,1:45:05.79,Default,,0,0,0,,Жұлдызды аспан!
Dialogue: 0,1:45:05.96,1:45:07.80,Default,,0,0,0,,Бұл жұлдыз ба?
Dialogue: 0,1:45:07.96,1:45:09.72,Default,,0,0,0,,Шин! Бұл
Dialogue: 0,1:45:13.51,1:45:14.51,Default,,0,0,0,,Ұстаз!
Dialogue: 0,1:45:30.49,1:45:32.61,Default,,0,0,0,,Лиза...?
Dialogue: 0,1:45:36.20,1:45:38.08,Default,,0,0,0,,Неге... Ха!
Dialogue: 0,1:45:38.24,1:45:40.50,Default,,0,0,0,,(Шакна Вимананың дауысы)
Dialogue: 0,1:45:41.20,1:45:45.04,Default,,0,0,0,,«Маған жанымды салу үшін ет ыдысын бер»?
Dialogue: 0,1:45:46.04,1:45:47.38,Default,,0,0,0,,Ұстаз!
Dialogue: 0,1:45:56.47,1:45:57.68,Default,,0,0,0,,Асуна
Dialogue: 0,1:45:58.18,1:46:02.39,Default,,0,0,0,,Мен сенің мұнда көрінгеніңді қаламадым.
Dialogue: 0,1:46:04.60,1:46:05.40,Default,,0,0,0,,Иә?
Dialogue: 0,1:46:10.73,1:46:11.74,Default,,0,0,0,,Ах
Dialogue: 0,1:46:13.61,1:46:14.57,Default,,0,0,0,,Асуна! —
Dialogue: 0,1:46:15.41,1:46:17.66,Default,,0,0,0,,Асуна, не болды?
Dialogue: 0,1:46:18.37,1:46:19.08,Default,,0,0,0,,Ha
Dialogue: 0,1:46:21.50,1:46:22.75,Default,,0,0,0,,Ах...
Dialogue: 0,1:46:23.41,1:46:25.92,Default,,0,0,0,,Өлгендердің жаны Асунаның денесіне...
Dialogue: 0,1:46:27.00,1:46:29.71,Default,,0,0,0,,Архангели Сіз оны таңдадыңыз! —
Dialogue: 0,1:46:30.05,1:46:31.09,Default,,0,0,0,,Асуна! —
Dialogue: 0,1:46:31.25,1:46:32.63,Default,,0,0,0,,Жүрегіңді берме! —
Dialogue: 0,1:46:32.80,1:46:33.72,Default,,0,0,0,,Сіз қайтып орала алмайсыз.
Dialogue: 0,1:46:33.97,1:46:35.88,Default,,0,0,0,,Асуна Асуна!
Dialogue: 0,1:46:37.89,1:46:39.51,Default,,0,0,0,,Суық...
Dialogue: 0,1:46:42.27,1:46:43.39,Default,,0,0,0,,Сіз қайдасыз?
Dialogue: 0,1:46:43.85,1:46:45.48,Default,,0,0,0,,Сіз…
Dialogue: 0,1:46:47.10,1:46:48.44,Default,,0,0,0,,Лиза!
Dialogue: 0,1:46:48.73,1:46:49.61,Default,,0,0,0,,Уау! —
Dialogue: 0,1:46:51.27,1:46:52.65,Default,,0,0,0,,Уф...
Dialogue: 0,1:46:55.03,1:46:55.82,Default,,0,0,0,,Уф
Dialogue: 0,1:46:56.53,1:46:57.95,Default,,0,0,0,,Аһ!
Dialogue: 0,1:47:03.62,1:47:05.79,Default,,0,0,0,,Сол қыз жетпей ме?
Dialogue: 0,1:47:06.25,1:47:07.46,Default,,0,0,0,,Ах...
Dialogue: 0,1:47:07.96,1:47:09.00,Default,,0,0,0,,Не керек, Крюгер мырза?
Dialogue: 0,1:47:09.17,1:47:10.00,Default,,0,0,0,,Асуна
Dialogue: 0,1:47:10.17,1:47:11.42,Default,,0,0,0,,Сіз сондасыз ба?
Dialogue: 0,1:47:11.59,1:47:13.38,Default,,0,0,0,,Асуна, мықты бол! —
Dialogue: 0,1:47:18.01,1:47:20.18,Default,,0,0,0,,Архангели! Асунаны қайтар
Dialogue: 0,1:47:21.93,1:47:22.68,Default,,0,0,0,,Ах...
Dialogue: 0,1:47:23.81,1:47:25.48,Default,,0,0,0,,Сенің көзің бар ма?
Dialogue: 0,1:47:25.98,1:47:28.98,Default,,0,0,0,,Кеш болды, бағасы төленді.
Dialogue: 0,1:47:29.81,1:47:30.69,Default,,0,0,0,,Лиза
Dialogue: 0,1:47:31.61,1:47:33.61,Default,,0,0,0,,Мен осындамын
Dialogue: 0,1:47:40.74,1:47:41.70,Default,,0,0,0,,Не керек, Крюгер мырза?
Dialogue: 0,1:47:42.24,1:47:45.20,Default,,0,0,0,,Не болды? Мен аздап қартайып бара жатқан сияқтымын
Dialogue: 0,1:47:47.91,1:47:49.79,Default,,0,0,0,,Кешіріңіз, Лиза
Dialogue: 0,1:47:52.46,1:47:54.42,Default,,0,0,0,,Жоқ, Асуна
Dialogue: 0,1:47:59.72,1:48:00.47,Default,,0,0,0,,Сен, жансыз құрал—
Dialogue: 0,1:48:05.89,1:48:07.81,Default,,0,0,0,,Асуна! Қайтып келу!
Dialogue: 0,1:48:09.94,1:48:11.19,Default,,0,0,0,,Сол қыз...
Dialogue: 0,1:48:11.56,1:48:12.06,Default,,0,0,0,,Асуна! Қайтып келу!
Dialogue: 0,1:48:11.98,1:48:13.69,Default,,0,0,0,,Мен білемін Асуна! Қайтып келу!
Dialogue: 0,1:48:14.36,1:48:14.86,Default,,0,0,0,,Асуна!
Dialogue: 0,1:48:14.69,1:48:16.61,Default,,0,0,0,,Мен таң қаламын неге кеудем... Асуна!
Dialogue: 0,1:48:16.78,1:48:19.03,Default,,0,0,0,,Лиза, сен осындасың...
Dialogue: 0,1:48:21.41,1:48:22.91,Default,,0,0,0,,Мен бірден қайтамын.
Dialogue: 0,1:48:23.99,1:48:25.45,Default,,0,0,0,,Асуна! —
Dialogue: 0,1:48:26.54,1:48:28.12,Default,,0,0,0,,Сен барып қарап кел.
Dialogue: 0,1:48:29.25,1:48:30.37,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:48:31.50,1:48:32.46,Default,,0,0,0,,Асуна! —
Dialogue: 0,1:48:32.96,1:48:34.38,Default,,0,0,0,,Асуна!
Dialogue: 0,1:48:38.42,1:48:39.51,Default,,0,0,0,,Ha
Dialogue: 0,1:48:40.05,1:48:41.55,Default,,0,0,0,,Тоқта! —
Dialogue: 0,1:48:42.30,1:48:44.18,Default,,0,0,0,,Лиза кінәлі емес
Dialogue: 0,1:48:47.47,1:48:50.27,Default,,0,0,0,,Тірі заттар маңызды!
Dialogue: 0,1:48:51.85,1:48:52.90,Default,,0,0,0,,Ha
Dialogue: 0,1:48:56.57,1:48:57.65,Default,,0,0,0,,Шин
Dialogue: 0,1:48:59.24,1:49:00.70,Default,,0,0,0,,Мя
Dialogue: 0,1:49:00.86,1:49:01.82,Default,,0,0,0,,Ах...
Dialogue: 0,1:49:04.99,1:49:06.83,Default,,0,0,0,,Сен барасың, Асуна.
Dialogue: 0,1:49:09.12,1:49:11.75,Default,,0,0,0,,Иә, қош бол
Dialogue: 0,1:49:15.50,1:49:16.50,Default,,0,0,0,,Уау!
Dialogue: 0,1:49:24.39,1:49:25.47,Default,,0,0,0,,Лиза!
Dialogue: 0,1:49:29.35,1:49:30.35,Default,,0,0,0,,Лиза!
Dialogue: 0,1:49:32.69,1:49:35.23,Default,,0,0,0,,Кешіріңіз, қымбаттым.
Dialogue: 0,1:49:35.94,1:49:38.53,Default,,0,0,0,,Мен сені қорғай алмаймын...
Dialogue: 0,1:49:38.78,1:49:40.32,Default,,0,0,0,,Лиза №.
Dialogue: 0,1:49:41.57,1:49:42.53,Default,,0,0,0,,Барма –
Dialogue: 0,1:49:42.70,1:49:43.53,Default,,0,0,0,,Лиза
Dialogue: 0,1:49:43.95,1:49:45.03,Default,,0,0,0,,Ол шынында да түпнұсқа ма?
Dialogue: 0,1:49:45.24,1:49:46.87,Default,,0,0,0,,Мен сені сүйдім!
Dialogue: 0,1:49:50.12,1:49:55.25,Default,,0,0,0,,Бақыт... бірақ... содан кейін...
Dialogue: 0,1:49:59.59,1:50:01.84,Default,,0,0,0,,(Морисакидің жылағаны)
Dialogue: 0,1:50:14.31,1:50:15.15,Default,,0,0,0,,Хмм
Dialogue: 0,1:50:26.28,1:50:27.57,Default,,0,0,0,,Өлтіру—
Dialogue: 0,1:50:28.03,1:50:29.58,Default,,0,0,0,,Мені өлтір
Dialogue: 0,1:50:30.58,1:50:34.25,Default,,0,0,0,,Мен жоғалтқаныма қарамастан өмір сүруімді айтқан дауысты естідім.
Dialogue: 0,1:50:34.58,1:50:36.58,Default,,0,0,0,,Сіз мұны естіген болуыңыз керек
Dialogue: 0,1:50:37.46,1:50:41.05,Default,,0,0,0,,Бұл адамға берілген қарғыс.
Dialogue: 0,1:50:53.31,1:50:54.60,Default,,0,0,0,,Бірақ мен сенімдімін...—
Dialogue: 0,1:50:55.44,1:50:58.52,Default,,0,0,0,,Бұл да бір игілік деп ойлаймын.
Dialogue: 0,1:51:01.36,1:51:05.49,Default,,0,0,0,,♪ Сәлем Қош бол & Сәлем
Dialogue: 0,1:51:05.99,1:51:13.16,Default,,0,0,0,,♪Мен сені кездестірдім, енді сенімен қоштасамын
Dialogue: 0,1:51:13.50,1:51:17.75,Default,,0,0,0,,♪Сәлем Қош бол & Сәлем
Dialogue: 0,1:51:18.00,1:51:25.13,Default,,0,0,0,,♪Сәлем саған сенсіз
Dialogue: 0,1:51:37.02,1:51:48.41,Default,,0,0,0,,♪Шын қоштасуды білмеген кезім
Dialogue: 0,1:51:49.53,1:52:00.96,Default,,0,0,0,,♪Жаралы жүрегім сені іздеді
Dialogue: 0,1:52:01.54,1:52:06.88,Default,,0,0,0,,♪Егер ол сізге жетсе
Dialogue: 0,1:52:07.13,1:52:13.64,Default,,0,0,0,,♪Мен сізге айтқым келген нәрселер өте көп болды.
Dialogue: 0,1:52:13.89,1:52:20.52,Default,,0,0,0,,♪Сенің күлкің менің барлық сезіміммен
Dialogue: 0,1:52:20.73,1:52:27.19,Default,,0,0,0,,♪Мен сенің жаныңда мәңгі болғым келеді деп ант етемін
Dialogue: 0,1:52:27.40,1:52:31.82,Default,,0,0,0,,♪ Сәлем Қош бол & Сәлем
Dialogue: 0,1:52:32.53,1:52:39.46,Default,,0,0,0,,♪Мен сені кездестірдім, енді сенімен қоштасамын
Dialogue: 0,1:52:39.71,1:52:43.96,Default,,0,0,0,,♪Сәлем Қош бол & Сәлем
Dialogue: 0,1:52:44.21,1:52:51.43,Default,,0,0,0,,♪Ал сенсіз бұл әлемге сәлем
Dialogue: 0,1:53:21.92,1:53:24.46,Default,,0,0,0,,Асуна! Ерте кетпесең, кешігіп қаласың.
Dialogue: 0,1:53:24.63,1:53:26.38,Default,,0,0,0,,Бұл мектеп бітіру рәсімі!
Dialogue: 0,1:53:26.54,1:53:27.50,Default,,0,0,0,,Сәлем
Dialogue: 0,1:53:34.55,1:53:35.43,Default,,0,0,0,,Сол жігіт мүлде есінен танып кетті – адамдар оны ұстап тұруға мәжбүр болды.
Dialogue: 0,1:53:36.68,1:53:37.76,Default,,0,0,0,,Кеттік!
Dialogue: 0,1:53:38.64,1:53:43.73,Default,,0,0,0,,♪Мен саған ғашық болғаннан бері
Dialogue: 0,1:53:43.90,1:53:50.74,Default,,0,0,0,,♪Бұл саяхат басталды
Dialogue: 0,1:53:53.66,1:53:58.08,Default,,0,0,0,,♪Сәлем Қош бол & Сәлем
Dialogue: 0,1:53:58.45,1:54:05.67,Default,,0,0,0,,♪Мен сені ешқашан ұмытпаймын
Dialogue: 0,1:54:05.92,1:54:10.17,Default,,0,0,0,,♪Сәлем Қош бол & Сәлем
Dialogue: 0,1:54:10.38,1:54:17.26,Default,,0,0,0,,♪Ал мен осы жолмен жүремін
Dialogue: 0,1:54:26.35,1:54:31.78,Default,,0,0,0,,♪Жеңілгім келмесе екен
Dialogue: 0,1:54:32.15,1:54:38.37,Default,,0,0,0,,♪Мен оны ең алыс жұлдыз деп ойладым
Dialogue: 0,1:54:38.62,1:54:45.29,Default,,0,0,0,,♪Аспан ертеңгідей кеңейеді
Dialogue: 0,1:54:45.54,1:54:53.34,Default,,0,0,0,,♪Бұл шексіз, бірақ мен қолымды созғым келеді
Dialogue: 0,1:54:55.34,1:54:59.55,Default,,0,0,0,,♪Сәлем Қош бол & Сәлем
Dialogue: 0,1:55:00.10,1:55:07.23,Default,,0,0,0,,♪Мен сені кездестірдім, енді сенімен қоштасамын
Dialogue: 0,1:55:07.65,1:55:11.82,Default,,0,0,0,,♪Сәлем Қош бол & Сәлем
Dialogue: 0,1:55:12.03,1:55:19.49,Default,,0,0,0,,♪Ал сенсіз бұл әлемге сәлем
Dialogue: 0,1:55:19.91,1:55:24.33,Default,,0,0,0,,♪Сәлем Қош бол & Сәлем
Dialogue: 0,1:55:24.70,1:55:31.92,Default,,0,0,0,,♪Мен сені кездестірдім, енді сенімен қоштасамын
Dialogue: 0,1:55:32.13,1:55:36.42,Default,,0,0,0,,♪Сәлем Қош бол & Сәлем
Dialogue: 0,1:55:36.63,1:55:43.56,Default,,0,0,0,,♪Ал сенсіз бұл әлемге сәлем
