Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:30.37,0:00:33.38,Default,,0,0,0,,Бұл «I Love Movie Cinema Boy» фильміндегі Сейширо Като.
Dialogue: 0,0:00:33.38,0:00:36.36,Default,,0,0,0,,Бүгінгі фильм осында!
Dialogue: 0,0:00:36.36,0:00:39.88,Default,,0,0,0,,Иә? Тет? Менің Тет жоқ.
Dialogue: 0,0:00:39.88,0:00:41.88,Default,,0,0,0,,Сол жігіт осы сапарға қосыла алмайды!
Dialogue: 0,0:00:52.40,0:00:56.38,Default,,0,0,0,,<Адамның қате таңдауы салдарынан қайталанатын қираулар мен соғыстар→
Dialogue: 0,0:00:56.38,0:00:58.87,Default,,0,0,0,,Жалғыз тұру＞
Dialogue: 0,0:00:58.87,0:01:02.39,Default,,0,0,0,,Атпа! Мені тыңдаңдар!!
Dialogue: 0,0:01:02.39,0:01:07.44,Default,,0,0,0,,<Адамдар бұл дүниеде қалай өмір сүруі керек? ＞
Dialogue: 0,0:01:14.38,0:01:16.87,Default,,0,0,0,,Наусиканың батылдығы керемет!
Dialogue: 0,0:01:16.87,0:01:19.87,Default,,0,0,0,,Фукай туралы ештеңе түсінбейсіз.
Dialogue: 0,0:01:19.87,0:01:23.38,Default,,0,0,0,,Фукай дегеніміз не?
Dialogue: 0,0:01:23.38,0:01:25.40,Default,,0,0,0,,``Жел алқабының Наусикасы''.
Dialogue: 0,0:01:25.40,0:01:27.90,Default,,0,0,0,,Осыдан кейін барлығы қосылып, көңіл көтереді!
Dialogue: 0,0:05:17.34,0:05:23.34,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:06:27.85,0:06:30.85,Default,,0,0,0,,Тағы бір ауыл өлді.
Dialogue: 0,0:06:38.34,0:06:41.84,Default,,0,0,0,,Кеттік! Бұл жер жақын арада шірік теңізіне батады.
Dialogue: 0,0:06:47.85,0:09:19.84,Default,,0,0,0,,♪♪~
Dialogue: 0,0:09:55.34,0:09:57.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:59.84,0:10:02.34,Default,,0,0,0,,Корольдік жәндіктің жолы!
Dialogue: 0,0:10:09.35,0:10:11.35,Default,,0,0,0,,Әлі де жаңа.
Dialogue: 0,0:10:23.35,0:10:25.35,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:27.44,0:10:29.94,Default,,0,0,0,,Король жәндіктің қабығы...!
Dialogue: 0,0:10:41.35,0:10:43.34,Default,,0,0,0,,Мен бұдан әрі жалғастыра алмаймын
Dialogue: 0,0:10:43.34,0:10:46.34,Default,,0,0,0,,Мен толығымен бос қабықты бірінші рет көріп тұрмын.
Dialogue: 0,0:10:52.43,0:10:54.35,Default,,0,0,0,,Кин
Dialogue: 0,0:10:54.35,0:10:57.35,Default,,0,0,0,,Уау, бұл жақсы естіледі.
Dialogue: 0,0:10:57.35,0:11:00.35,Default,,0,0,0,,Кин
Dialogue: 0,0:11:02.84,0:11:06.34,Default,,0,0,0,,Уухоу... Менің керамикалық қылышым сынған.
Dialogue: 0,0:11:06.34,0:11:08.86,Default,,0,0,0,,Алқаптың халқы бақытты болады.
Dialogue: 0,0:11:08.86,0:11:13.36,Default,,0,0,0,,Құрал-саймандарды жасауға арналған материалдар туралы үнемі уайымдаудың қажеті жоқ.
Dialogue: 0,0:11:16.84,0:11:19.36,Default,,0,0,0,,Керемет көздер!
Dialogue: 0,0:11:19.36,0:11:22.36,Default,,0,0,0,,Осылардың біреуімен ғана ұша аламын ба деп ойлаймын.
Dialogue: 0,0:11:33.90,0:11:35.90,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:11:46.37,0:11:47.87,Default,,0,0,0,,Сәлем...!
Dialogue: 0,0:11:50.85,0:11:53.36,Default,,0,0,0,,А, мен түсіндім!
Dialogue: 0,0:11:53.36,0:11:56.34,Default,,0,0,0,,Уау, бұл қандай жеңіл!
Dialogue: 0,0:11:56.34,0:11:58.90,Default,,0,0,0,,Уху-ухху….
Dialogue: 0,0:11:58.90,0:12:09.34,Default,,0,0,0,,♪♪~
Dialogue: 0,0:12:09.34,0:12:12.86,Default,,0,0,0,,Пальма пальмасы түстен кейін спораларын шашады.
Dialogue: 0,0:12:12.86,0:12:30.34,Default,,0,0,0,,♪♪~
Dialogue: 0,0:12:30.34,0:12:32.35,Default,,0,0,0,,Әдемі….
Dialogue: 0,0:12:32.35,0:12:34.33,Default,,0,0,0,,Бетперде тақпасаңыз →
Dialogue: 0,0:12:34.33,0:12:37.85,Default,,0,0,0,,5 минутта өкпеңді шірітетін өлім орманы...
Dialogue: 0,0:12:37.85,0:12:46.35,Default,,0,0,0,,♪♪~
Dialogue: 0,0:12:56.35,0:12:57.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:57.85,0:12:59.85,Default,,0,0,0,,Солай деді. Маған берді — жарты бағасына екен.
Dialogue: 0,0:13:07.85,0:13:09.85,Default,,0,0,0,,Бірдеңе?
Dialogue: 0,0:13:11.38,0:13:13.94,Default,,0,0,0,,Менің жүрегім дүрсілдеп тұр.
Dialogue: 0,0:13:13.94,0:13:16.34,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:16.34,0:13:20.34,Default,,0,0,0,,Бұл қателерден қорғайтын мылтық! Біреуге жәндіктер шабуыл жасайды!
Dialogue: 0,0:13:21.34,0:13:23.34,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:13:25.85,0:13:27.85,Default,,0,0,0,,А, кешіріңіз!
Dialogue: 0,0:13:31.90,0:13:36.90,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:13:40.33,0:13:43.85,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:13:43.85,0:13:45.85,Default,,0,0,0,,Бұл — радио гимнастика.
Dialogue: 0,0:13:45.85,0:13:48.35,Default,,0,0,0,,Таңғажайып споралы түтін.
Dialogue: 0,0:13:49.34,0:13:52.84,Default,,0,0,0,,Патша жәндік! Мен бұл бос қабықтың иесі екеніне сенімдімін.
Dialogue: 0,0:13:52.84,0:13:56.38,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:13:56.38,0:13:58.88,Default,,0,0,0,,Ол жақта қашып құтыла алмайсың!
Dialogue: 0,0:14:00.85,0:14:02.35,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:14:05.84,0:14:07.84,Default,,0,0,0,,Ескерту!
Dialogue: 0,0:14:09.86,0:14:12.36,Default,,0,0,0,,Мен жауап бердім! Мында кел!
Dialogue: 0,0:14:37.34,0:14:39.34,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:14:45.35,0:14:47.35,Default,,0,0,0,,Сол адам...!
Dialogue: 0,0:14:51.85,0:15:04.85,Default,,0,0,0,,♪♪~
Dialogue: 0,0:15:04.85,0:15:07.85,Default,,0,0,0,,♪♪~ Қандай керемет патша жәндігі.
Dialogue: 0,0:15:07.85,0:15:13.34,Default,,0,0,0,,♪♪~
Dialogue: 0,0:15:13.34,0:15:15.84,Default,,0,0,0,,Желге қарсы! ♪♪~ Кешіріңіз!
Dialogue: 0,0:15:15.84,0:15:17.84,Default,,0,0,0,,♪♪~
Dialogue: 0,0:15:17.84,0:15:19.90,Default,,0,0,0,,♪♪~ Омуши, орманға орал!
Dialogue: 0,0:15:19.90,0:15:23.33,Default,,0,0,0,,Бұдан былай ♪♪~ Бұл сіздің әлеміңіз емес!
Dialogue: 0,0:15:23.33,0:15:25.35,Default,,0,0,0,,♪♪~ Ей, сен жақсы қызсың!
Dialogue: 0,0:15:25.35,0:15:26.85,Default,,0,0,0,,♪♪~
Dialogue: 0,0:15:26.85,0:15:30.84,Default,,0,0,0,,Ашуыңмен өзіңді ұмытып бара жатырсың ♪♪~ Мен тынышталуым керек.
Dialogue: 0,0:15:30.84,0:15:37.34,Default,,0,0,0,,♪♪~
Dialogue: 0,0:16:00.34,0:16:03.36,Default,,0,0,0,,Жарықтың жарқылы Оумушидің көзін айналдырды.
Dialogue: 0,0:16:03.36,0:16:06.43,Default,,0,0,0,,Жәндіктердің флейтасы...?
Dialogue: 0,0:16:06.43,0:16:14.35,Default,,0,0,0,,(жәндіктердің флейта дыбысы)
Dialogue: 0,0:16:14.35,0:16:17.85,Default,,0,0,0,,Омуши, оян! Орманға қайтайық. (жәндіктердің флейта дыбысы)
Dialogue: 0,0:16:17.85,0:16:28.38,Default,,0,0,0,,(жәндіктердің флейта дыбысы)
Dialogue: 0,0:16:28.38,0:16:30.38,Default,,0,0,0,,Мен байқадым!
Dialogue: 0,0:16:42.33,0:16:44.33,Default,,0,0,0,,Мұнда ешкім жоқ сияқты. (Ұшқыш А) Жоқ, бар.
Dialogue: 0,0:16:48.33,0:16:51.34,Default,,0,0,0,,Корольдік жәндік орманға қайтады.
Dialogue: 0,0:16:51.34,0:16:55.84,Default,,0,0,0,,Король жәндіктерін тек жеңіл оқ пен қоңыз сыбызғы ғана тыныштандырады деп ойлау...
Dialogue: 0,0:17:37.35,0:17:38.85,Default,,0,0,0,,Құрметті Юпа!
Dialogue: 0,0:17:38.85,0:17:41.85,Default,,0,0,0,,О! Хахаха…. Ахахха!
Dialogue: 0,0:17:41.85,0:17:43.87,Default,,0,0,0,,Наусика мен қате түсіндім.
Dialogue: 0,0:17:43.87,0:17:46.93,Default,,0,0,0,,Бір жарым жыл болды, әкем бақытты.
Dialogue: 0,0:17:46.93,0:17:50.86,Default,,0,0,0,,Мен сізге алғыс айтуым керек. Сіз желдің жақсы пайдаланушысы болдыңыз.
Dialogue: 0,0:17:50.86,0:17:53.35,Default,,0,0,0,,Жоқ, әкем әлі жас.
Dialogue: 0,0:17:53.35,0:17:54.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:54.85,0:17:59.34,Default,,0,0,0,,Дұрыс, мен бұл жігітті мүлде ұмыттым.
Dialogue: 0,0:17:59.34,0:18:02.34,Default,,0,0,0,,Ки~! Ки~!
Dialogue: 0,0:18:02.34,0:18:05.38,Default,,0,0,0,,Ал, түлкі тиін! Менің бірінші рет!
Dialogue: 0,0:18:05.38,0:18:08.95,Default,,0,0,0,,Бұл жігітті ұшатын жәндік ұрлап әкетті, олар оны адам баласы деп ойлап қалды.→
Dialogue: 0,0:18:08.95,0:18:11.35,Default,,0,0,0,,Мен мылтық қолдандым.
Dialogue: 0,0:18:11.35,0:18:13.84,Default,,0,0,0,,Сондықтан патша жәндігі қатты ашуланды.
Dialogue: 0,0:18:13.84,0:18:16.84,Default,,0,0,0,,Ол ес-түссіз жатқандықтан, уды жұтпаған сияқты.
Dialogue: 0,0:18:16.84,0:18:20.34,Default,,0,0,0,,Қолдарыңды ұстағаның дұрыс.Кішкентайлар да қатыгез.
Dialogue: 0,0:18:20.34,0:18:21.84,Default,,0,0,0,,Келіңіздер.
Dialogue: 0,0:18:21.84,0:18:23.35,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:18:23.35,0:18:25.35,Default,,0,0,0,,Ки! Эй, эй.
Dialogue: 0,0:18:26.88,0:18:28.94,Default,,0,0,0,,Қараңызшы, мен қорықпаймын.
Dialogue: 0,0:18:28.94,0:18:32.36,Default,,0,0,0,,Гага! Бұл қорқынышты емес.
Dialogue: 0,0:18:32.36,0:18:33.86,Default,,0,0,0,,Ей, жартылай жұмыс істейтін! Алдыңа шықшы, өтінемін!
Dialogue: 0,0:18:34.84,0:18:36.84,Default,,0,0,0,,Қараңызшы, мен қорықпаймын.
Dialogue: 0,0:18:39.85,0:18:41.35,Default,,0,0,0,,Адам аяғы тимейтін орынды әдейі таңдаған...
Dialogue: 0,0:18:48.90,0:18:51.84,Default,,0,0,0,,Сіз қорқып қалдыңыз.
Dialogue: 0,0:18:51.84,0:18:56.35,Default,,0,0,0,,Уау! Фуфуфуфу….
Dialogue: 0,0:18:56.35,0:18:59.35,Default,,0,0,0,,Құрметті Юпа, маған мынаны беріңізші.
Dialogue: 0,0:18:59.35,0:19:01.37,Default,,0,0,0,,А... Мен қарсы емеспін.
Dialogue: 0,0:19:01.37,0:19:03.34,Default,,0,0,0,,Уау, рахмет!
Dialogue: 0,0:19:03.34,0:19:06.37,Default,,0,0,0,,Кай ни Күй Есіңде ме мені?
Dialogue: 0,0:19:06.37,0:19:09.43,Default,,0,0,0,,Бұл тылсым күш.
Dialogue: 0,0:19:09.43,0:19:13.36,Default,,0,0,0,,Уфуфу... Шаршаған шығарсың. Көп жүгір.
Dialogue: 0,0:19:13.36,0:19:16.37,Default,,0,0,0,,Ухуху...
Dialogue: 0,0:19:16.37,0:19:19.37,Default,,0,0,0,,Барлығы бірдей емес пе?
Dialogue: 0,0:19:21.34,0:19:23.36,Default,,0,0,0,,Не болды?
Dialogue: 0,0:19:23.36,0:19:25.86,Default,,0,0,0,,Менің әкем...
Dialogue: 0,0:19:26.86,0:19:29.41,Default,,0,0,0,,Менің әкем енді ұша алмайды.
Dialogue: 0,0:19:29.41,0:19:34.33,Default,,0,0,0,,Джилл...! Орманда өте көп у бар ...
Dialogue: 0,0:19:34.33,0:19:38.84,Default,,0,0,0,,Иә, Шіріген теңіздің жағасында тұратындардың ережелері...
Dialogue: 0,0:19:38.84,0:19:42.86,Default,,0,0,0,,Мен ертерек баруым керек еді.
Dialogue: 0,0:19:42.86,0:19:48.35,Default,,0,0,0,,Жоқ... Келгендеріңізге көп рахмет.
Dialogue: 0,0:19:48.35,0:19:52.42,Default,,0,0,0,,Мұғалім, мен сенен кейін бір нәрсені көргім келеді.
Dialogue: 0,0:19:52.42,0:19:54.85,Default,,0,0,0,,Менің құпия бөлмем. Апыр-ай.
Dialogue: 0,0:19:54.85,0:19:57.86,Default,,0,0,0,,Барлығына айтпа, қорықпау керек.
Dialogue: 0,0:19:57.86,0:20:00.34,Default,,0,0,0,,Мен сізге хабарлаймын.
Dialogue: 0,0:20:00.34,0:20:02.34,Default,,0,0,0,,Тезірек жүріңіз, ұстаз!
Dialogue: 0,0:20:03.35,0:20:05.35,Default,,0,0,0,,Құрметті Юпа!
Dialogue: 0,0:20:05.35,0:20:07.85,Default,,0,0,0,,Мынаны алып кете аласыз ба?
Dialogue: 0,0:20:07.85,0:20:10.90,Default,,0,0,0,,Ауа ағыны турбулентті, мен жақсы ұша алмаймын.
Dialogue: 0,0:20:10.90,0:20:20.35,Default,,0,0,0,,♪♪~
Dialogue: 0,0:20:20.35,0:20:23.83,Default,,0,0,0,,Хахаха... Солай болса да желді жақсы оқыдым.
Dialogue: 0,0:20:23.83,0:20:25.84,Default,,0,0,0,,Міне, дерлік қалды.
Dialogue: 0,0:20:25.84,0:21:01.39,Default,,0,0,0,,♪♪~
Dialogue: 0,0:21:01.39,0:21:03.94,Default,,0,0,0,,О~ Юпа-сама! қош келдіңіз!
Dialogue: 0,0:21:03.94,0:21:05.84,Default,,0,0,0,,Барлығыңыздың денсаулығыңыз нашар ма?
Dialogue: 0,0:21:05.84,0:21:10.33,Default,,0,0,0,,Хахаха... Су мен жел тыныш, біркелкі.
Dialogue: 0,0:21:10.33,0:21:14.35,Default,,0,0,0,,Мырза Юпа! Ах, бәрі жақсы.
Dialogue: 0,0:21:14.35,0:21:28.85,Default,,0,0,0,,♪♪~
Dialogue: 0,0:21:28.85,0:21:30.85,Default,,0,0,0,,Әй, Юпа-сама!
Dialogue: 0,0:21:32.35,0:21:34.85,Default,,0,0,0,,Біз сені күттік, Юпа-сама!
Dialogue: 0,0:21:34.85,0:21:37.84,Default,,0,0,0,,Юпа-сама қайтып келді!
Dialogue: 0,0:21:37.84,0:21:40.34,Default,,0,0,0,,Ханшайым, келдің.
Dialogue: 0,0:21:40.34,0:21:43.88,Default,,0,0,0,,Тағы да. Юпа-сама~!
Dialogue: 0,0:21:43.88,0:21:46.93,Default,,0,0,0,,Мито ағай Көңіліңізді түсірмеңіз.
Dialogue: 0,0:21:46.93,0:21:51.85,Default,,0,0,0,,Бүгін кешке маған басқа ел туралы тағы бір әңгіме айтып беріңізші!
Dialogue: 0,0:21:51.85,0:21:54.35,Default,,0,0,0,,Жарайды, бұрыңыз.
Dialogue: 0,0:22:04.33,0:22:07.33,Default,,0,0,0,,Жақсы көрінеді. Иә.
Dialogue: 0,0:22:09.96,0:22:12.34,Default,,0,0,0,,О, бұл өте жақсы зат.
Dialogue: 0,0:22:12.34,0:22:16.35,Default,,0,0,0,,Мен оны ертең алу үшін жұмыс күшімді жіберуім керек.
Dialogue: 0,0:22:16.35,0:22:18.86,Default,,0,0,0,,Кел, Тоэто. Иә.
Dialogue: 0,0:22:18.86,0:22:22.33,Default,,0,0,0,,Қымбатты Юпа, мен биылғы жылы туған Тоэтоның баласымын.
Dialogue: 0,0:22:22.33,0:22:24.85,Default,,0,0,0,,Қайсысы...
Dialogue: 0,0:22:24.85,0:22:29.93,Default,,0,0,0,,Ой, сен жақсы қызсың. Бұл маған Наусиканың жас кезін еске түсіреді.
Dialogue: 0,0:22:29.93,0:22:33.35,Default,,0,0,0,,Осы баланың құдасы болыңызшы.
Dialogue: 0,0:22:33.35,0:22:36.35,Default,,0,0,0,,Сол балаға әрқашан жақсы жел соғып тұрсын.
Dialogue: 0,0:22:36.35,0:22:40.34,Default,,0,0,0,,Қабыл алайық. Мен саған жақсы ат қоямын.
Dialogue: 0,0:22:40.34,0:22:45.86,Default,,0,0,0,,Рахмет. Ханшайымдай мықты болып өсесің деп сенемін.
Dialogue: 0,0:22:45.86,0:22:49.91,Default,,0,0,0,,Хм, егер сіз төзімділік туралы айтатын болсаңыз, онда ханшайымда оригами бар.
Dialogue: 0,0:22:49.91,0:22:52.35,Default,,0,0,0,,Алайда, егер ол теңізде ойнауға ұқсайтын болса, бұл проблема болар еді.
Dialogue: 0,0:22:52.35,0:22:55.33,Default,,0,0,0,,Бірақ сіздердің арқаларыңызда мен патша жәндіктерінің қабығын таптым.
Dialogue: 0,0:22:55.33,0:22:58.85,Default,,0,0,0,,Бірақ, өзіңізді Широ ағайдың орнына қойыңыз.
Dialogue: 0,0:22:58.85,0:23:01.86,Default,,0,0,0,,Уайымдап жатқандықтан үрейленбеңіз.
Dialogue: 0,0:23:01.86,0:23:03.83,Default,,0,0,0,,Хахаха... Корольдік жәндіктің қабығына айналса→
Dialogue: 0,0:23:03.83,0:23:06.86,Default,,0,0,0,,Ханшайымның шіріген теңіздегі ойынын ысырап деп атауға болмайды.
Dialogue: 0,0:23:06.86,0:23:10.43,Default,,0,0,0,,Міне, мені де сол құтқарды.
Dialogue: 0,0:23:10.43,0:23:12.35,Default,,0,0,0,,(күлді)
Dialogue: 0,0:23:12.35,0:23:14.85,Default,,0,0,0,,Иә! Алақай!
Dialogue: 0,0:23:14.85,0:23:41.34,Default,,0,0,0,,♪♪~
Dialogue: 0,0:26:13.35,0:26:17.85,Default,,0,0,0,,Хахаха... Көтерген балаң аман қалды ма?
Dialogue: 0,0:26:17.85,0:26:22.36,Default,,0,0,0,,Бұл аңғар әдемі. Мұнда келген сайын өзімді тыныш сезінемін.
Dialogue: 0,0:26:22.36,0:26:25.34,Default,,0,0,0,,Бұл жолғы сапарыңыз қалай өтті?
Dialogue: 0,0:26:25.34,0:26:27.40,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:26:27.40,0:26:31.35,Default,,0,0,0,,Оңтүстікте тағы екі елді Шіріу теңізі жұтып қойды.
Dialogue: 0,0:26:31.35,0:26:34.35,Default,,0,0,0,,Шіріу теңізі тұрақты түрде кеңейіп келеді.
Dialogue: 0,0:26:34.35,0:26:40.34,Default,,0,0,0,,Бірақ мен қайда барсам да, мен соғысқа ашпын және тек қорқынышты көлеңкелерді көремін →
Dialogue: 0,0:26:40.34,0:26:43.83,Default,,0,0,0,,Неліктен біз бұл алқап сияқты өмір сүре алмаймыз?
Dialogue: 0,0:26:43.83,0:26:48.93,Default,,0,0,0,,Бұл жер теңізден соққан желден қорғалған.
Dialogue: 0,0:26:48.93,0:26:52.35,Default,,0,0,0,,Шіріген теңіздің уы да аңғарға жете алмайды.
Dialogue: 0,0:26:52.35,0:26:57.84,Default,,0,0,0,,Қалай ойлайсың, Юпа, тезірек осы алқапқа қоныстанамыз ба?
Dialogue: 0,0:26:57.84,0:27:02.35,Default,,0,0,0,,Мен осы Замамын, бәрі бақытты.
Dialogue: 0,0:27:02.35,0:27:04.83,Default,,0,0,0,,Хехехе... Бұл босқа.
Dialogue: 0,0:27:04.83,0:27:09.83,Default,,0,0,0,,Юпа - ізденуді жалғастыратын адам.
Dialogue: 0,0:27:10.84,0:27:13.36,Default,,0,0,0,,Бұл ... қарастырылған ба?
Dialogue: 0,0:27:13.36,0:27:15.84,Default,,0,0,0,,Ұлы баба, не іздеп жүрсің?
Dialogue: 0,0:27:15.84,0:27:20.35,Default,,0,0,0,,О! Сіз Наусика туралы білмедіңіз бе?
Dialogue: 0,0:27:20.35,0:27:23.85,Default,,0,0,0,,Қараңдаршы, ол сол қабырғадағы туда →
Dialogue: 0,0:27:23.85,0:27:29.85,Default,,0,0,0,,Мен оны енді көре алмаймын, бірақ бұл сол жақ бұрышта.
Dialogue: 0,0:27:30.84,0:27:35.35,Default,,0,0,0,,«Ол адам көк киімді→
Dialogue: 0,0:27:35.35,0:27:38.85,Default,,0,0,0,,Алтын далаға түсіңіз.
Dialogue: 0,0:27:38.85,0:27:43.36,Default,,0,0,0,,Жоғалған жермен байланыс орнату...».
Dialogue: 0,0:27:43.36,0:27:48.43,Default,,0,0,0,,«Ақырында ел-жұртты көк тазалық еліне жетеле».
Dialogue: 0,0:27:48.43,0:27:49.83,Default,,0,0,0,,Юпа-сама→
Dialogue: 0,0:27:49.83,0:27:52.83,Default,,0,0,0,,Мен бұл ескі аңыз деп ойладым.
Dialogue: 0,0:27:52.83,0:27:55.83,Default,,0,0,0,,Баба, мені мазақ қылғым келмейді.
Dialogue: 0,0:27:55.83,0:27:58.84,Default,,0,0,0,,Бұл бірдей нәрсе.
Dialogue: 0,0:27:58.84,0:28:03.34,Default,,0,0,0,,Мен жай ғана Шіріген теңіздің жұмбағын шешкім келеді→
Dialogue: 0,0:28:03.34,0:28:05.88,Default,,0,0,0,,Біз адамдар осылай қаламыз→
Dialogue: 0,0:28:05.88,0:28:09.85,Default,,0,0,0,,Біз ыдыраған теңізге жұтылып, жойылатын нәсілміз бе?→
Dialogue: 0,0:28:09.85,0:28:12.85,Default,,0,0,0,,Менің білгім келетіні осы.
Dialogue: 0,0:28:12.85,0:28:25.90,Default,,0,0,0,,♪♪~
Dialogue: 0,0:28:25.90,0:28:30.90,Default,,0,0,0,,Мен Юпа-самаға көмектессем ғой...
Dialogue: 0,0:28:32.86,0:28:44.36,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:28:46.87,0:28:50.44,Default,,0,0,0,,Ханшайым... Ханшайым.
Dialogue: 0,0:28:50.44,0:28:52.36,Default,,0,0,0,,Не? Мито.
Dialogue: 0,0:28:52.36,0:28:54.84,Default,,0,0,0,,≪Гол жел сасыды≫ дейді
Dialogue: 0,0:28:54.84,0:28:57.85,Default,,0,0,0,,Таң атуға жақын. Мен бірден барамын.
Dialogue: 0,0:28:57.85,0:29:05.37,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:29:05.37,0:29:06.91,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:29:06.91,0:29:10.36,Default,,0,0,0,,Бұл жақсы дауыл, бірақ біртүрлі көрінеді.
Dialogue: 0,0:29:10.36,0:29:25.89,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:29:25.89,0:29:27.39,Default,,0,0,0,,Ха!
Dialogue: 0,0:29:28.44,0:29:29.86,Default,,0,0,0,,Онда!
Dialogue: 0,0:29:29.86,0:29:31.86,Default,,0,0,0,,Қайта кездескенше.
Dialogue: 0,0:29:36.85,0:29:38.35,Default,,0,0,0,,Бұл кеме.
Dialogue: 0,0:29:38.35,0:29:40.85,Default,,0,0,0,,Неліктен мұндай шалғай жерде кеме бар?
Dialogue: 0,0:29:42.34,0:29:45.39,Default,,0,0,0,,Не болып жатыр? Юпа мырза: Бұл кеме.
Dialogue: 0,0:29:45.39,0:29:47.39,Default,,0,0,0,,Кеме? Бұл келе жатыр!
Dialogue: 0,0:29:53.35,0:29:54.85,Default,,0,0,0,,Үлкен!
Dialogue: 0,0:29:57.86,0:29:59.36,Default,,0,0,0,,♬~
Dialogue: 0,0:30:00.84,0:30:02.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:30:03.85,0:30:07.37,Default,,0,0,0,,Торумекиядан шыққан үлкен кеме. Біртүрлі ұшады.
Dialogue: 0,0:30:07.37,0:30:09.40,Default,,0,0,0,,Мәжбүрлеп қонуға әрекет жасау.
Dialogue: 0,0:30:09.40,0:30:11.44,Default,,0,0,0,,Гол, көтер! Аа!?
Dialogue: 0,0:30:11.44,0:30:13.32,Default,,0,0,0,,Ханшайым, бұл ақылсыз!
Dialogue: 0,0:30:13.32,0:30:15.32,Default,,0,0,0,,Жағалау бойынша жол көрсету.
Dialogue: 0,0:30:18.34,0:30:20.35,Default,,0,0,0,,Келді.
Dialogue: 0,0:30:20.35,0:30:22.33,Default,,0,0,0,,Ал, кеттік!
Dialogue: 0,0:30:22.33,0:30:23.83,Default,,0,0,0,,Тет!
Dialogue: 0,0:30:39.85,0:30:41.35,Default,,0,0,0,,Ах!
Dialogue: 0,0:30:41.35,0:30:51.84,Default,,0,0,0,,♪♪~
Dialogue: 0,0:30:51.84,0:30:55.40,Default,,0,0,0,,Не! Мен шірік теңізіне түсіп, жәндіктерді өлтірдім!
Dialogue: 0,0:30:55.40,0:30:56.90,Default,,0,0,0,,Ха!
Dialogue: 0,0:30:57.95,0:31:01.34,Default,,0,0,0,,Рульді тартыңыз! Сіз соқтығысасыз!
Dialogue: 0,0:31:01.34,0:31:03.34,Default,,0,0,0,,Рульді тартыңыз~!!
Dialogue: 0,0:31:06.34,0:31:08.36,Default,,0,0,0,,Руль~!!
Dialogue: 0,0:31:08.36,0:31:09.86,Default,,0,0,0,,Уақыт жұмсауға тұрарлық еді>
Dialogue: 0,0:31:15.85,0:31:18.85,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:31:22.34,0:31:24.34,Default,,0,0,0,,Құлдым! Ханшайым...
Dialogue: 0,0:31:24.34,0:31:27.35,Default,,0,0,0,,Теңіз жағасындағы жартас! барайық!
Dialogue: 0,0:31:27.35,0:31:31.35,Default,,0,0,0,,Қозғала алатындардың бәрі шықсын! Тез жасаңыз!
Dialogue: 0,0:31:55.84,0:31:58.34,Default,,0,0,0,,Бұл бір! Бұл тірі!
Dialogue: 0,0:32:03.40,0:32:04.90,Default,,0,0,0,,Ха!
Dialogue: 0,0:32:17.36,0:32:21.85,Default,,0,0,0,,Ах... міне...? Жел алқабы, сөйлеме.
Dialogue: 0,0:32:21.85,0:32:23.35,Default,,0,0,0,,Ах!
Dialogue: 0,0:32:35.83,0:32:41.84,Default,,0,0,0,,Мен... уф! Уф...! Пежите Ластел….
Dialogue: 0,0:32:41.84,0:32:44.36,Default,,0,0,0,,Жүк... Жүкті өртеп жіберіңіз....
Dialogue: 0,0:32:44.36,0:32:47.36,Default,,0,0,0,,Жүк? Өтінемін... өртеп жіберіңіз...
Dialogue: 0,0:32:47.36,0:32:49.34,Default,,0,0,0,,Жүк мен түсінемін.
Dialogue: 0,0:32:49.34,0:32:51.84,Default,,0,0,0,,Жарайды, бәрі күйіп қалды.
Dialogue: 0,0:32:53.42,0:32:55.33,Default,,0,0,0,,Жақсы….
Dialogue: 0,0:32:55.33,0:32:57.33,Default,,0,0,0,,Ханшайым~!
Dialogue: 0,0:33:06.86,0:33:10.86,Default,,0,0,0,,Бұл адам Пежите қаласының патша әулетінің ханшайымы.
Dialogue: 0,0:33:21.34,0:33:24.34,Default,,0,0,0,,Бұл қате! Ушиабу тірі!
Dialogue: 0,0:33:26.83,0:33:29.84,Default,,0,0,0,,Нашар! Мен достарыма қоңырау шаламын!
Dialogue: 0,0:33:29.84,0:33:32.32,Default,,0,0,0,,Мен жараланып, ұша алмаймын. Мылтық әкел!
Dialogue: 0,0:33:32.32,0:33:34.86,Default,,0,0,0,,Жоқ! Мені атып тастасаң, мен көбірек достар шақырамын!
Dialogue: 0,0:33:34.86,0:33:38.43,Default,,0,0,0,,Лезде өлім! Ушиабу мылтықтан өледі!
Dialogue: 0,0:33:38.43,0:33:40.85,Default,,0,0,0,,Сонда не істейміз!? Күте тұрыңыз!
Dialogue: 0,0:33:40.85,0:33:43.83,Default,,0,0,0,,Маған Мито Меве әкеліңіз. иә.
Dialogue: 0,0:33:43.83,0:33:45.83,Default,,0,0,0,,Ханшайым...!
Dialogue: 0,0:33:52.36,0:34:01.83,Default,,0,0,0,,(жәндіктердің флейта дыбысы)
Dialogue: 0,0:34:01.83,0:34:05.34,Default,,0,0,0,,Орманға оралу Жарайды, мен ұша аламын.
Dialogue: 0,0:34:05.34,0:34:13.35,Default,,0,0,0,,(жәндіктердің флейта дыбысы)
Dialogue: 0,0:34:13.35,0:34:15.85,Default,,0,0,0,,Иә... бұл жақсы.
Dialogue: 0,0:34:17.37,0:34:19.92,Default,,0,0,0,,Ханшайым. рақмет сізге.
Dialogue: 0,0:34:19.92,0:34:28.42,Default,,0,0,0,,(жәндіктердің флейта дыбысы)
Dialogue: 0,0:34:32.35,0:34:39.84,Default,,0,0,0,,♪♪~
Dialogue: 0,0:34:39.84,0:34:42.36,Default,,0,0,0,,Иә! Алақай!
Dialogue: 0,0:34:42.36,0:34:45.43,Default,,0,0,0,,Қуанамын... тіпті біреуін өлтірсем де →
Dialogue: 0,0:34:45.43,0:34:47.85,Default,,0,0,0,,Сіз не болатынын ешқашан білмейсіз.
Dialogue: 0,0:34:47.85,0:35:14.34,Default,,0,0,0,,♪♪~
Dialogue: 0,0:35:14.34,0:35:15.84,Default,,0,0,0,,♪♪~ Ах!
Dialogue: 0,0:35:15.84,0:35:30.84,Default,,0,0,0,,♪♪~
Dialogue: 0,0:35:33.84,0:35:35.34,Default,,0,0,0,,Ха!
Dialogue: 0,0:35:35.34,0:35:44.85,Default,,0,0,0,,♪♪~
Dialogue: 0,0:35:44.85,0:35:47.34,Default,,0,0,0,,♪♪~ Омуши….
Dialogue: 0,0:35:47.34,0:35:55.34,Default,,0,0,0,,♪♪~
Dialogue: 0,0:40:30.86,0:40:33.86,Default,,0,0,0,,Міне болды! Келіңіздер!
Dialogue: 0,0:40:33.86,0:40:35.89,Default,,0,0,0,,Осы жолмен.
Dialogue: 0,0:40:35.89,0:40:38.96,Default,,0,0,0,,Күтілгендей, бұл кемеге споралар бекітілген.
Dialogue: 0,0:40:38.96,0:40:40.96,Default,,0,0,0,,Әзірге у шығарылған жоқ.
Dialogue: 0,0:40:45.35,0:40:49.35,Default,,0,0,0,,Тағы бір рет. Біреуі де артта қалса қиын болар еді.
Dialogue: 0,0:40:56.86,0:40:59.35,Default,,0,0,0,,Не? Бұл кесек.
Dialogue: 0,0:40:59.35,0:41:01.90,Default,,0,0,0,,Ол жалынның өзі жанбайды.
Dialogue: 0,0:41:01.90,0:41:04.86,Default,,0,0,0,,Қане, бәріміз, мына жігітті аңдуды доғарайық.
Dialogue: 0,0:41:04.86,0:41:08.36,Default,,0,0,0,,Маған спораларды жағуға көмектесіңізші.
Dialogue: 0,0:41:08.36,0:41:11.36,Default,,0,0,0,,Өте сақ болыңыз!
Dialogue: 0,0:41:11.36,0:41:14.37,Default,,0,0,0,,Сіз мүлде қиын нәрсе әкелдіңіз...
Dialogue: 0,0:41:14.37,0:41:17.87,Default,,0,0,0,,Мито Мұнда қараңыз. иә?
Dialogue: 0,0:41:22.42,0:41:26.86,Default,,0,0,0,,Жылжы! Тірі келгендей.
Dialogue: 0,0:41:26.86,0:41:29.36,Default,,0,0,0,,Юпа-сама, бұл не?
Dialogue: 0,0:41:29.36,0:41:32.87,Default,,0,0,0,,Саяхат барысында мен қорқынышты қауесеттерді естідім.
Dialogue: 0,0:41:32.87,0:41:35.87,Default,,0,0,0,,Пежите қаласының жертөлесінде ескі дүниеден келген құбыжық ұйықтап жатқан→
Dialogue: 0,0:41:35.87,0:41:38.36,Default,,0,0,0,,Оны қазып алды дейді.
Dialogue: 0,0:41:38.36,0:41:40.88,Default,,0,0,0,,Ескі дүниенің құбыжықтары?
Dialogue: 0,0:41:40.88,0:41:43.43,Default,,0,0,0,,Бұл құдайдың алып сарбазы. Алып құдай солдаты!?
Dialogue: 0,0:41:43.43,0:41:47.37,Default,,0,0,0,,Сол «жеті күндік отта» дүние өртенді дейді...
Dialogue: 0,0:41:47.37,0:41:49.37,Default,,0,0,0,,Бұл жігіт...
Dialogue: 0,0:41:55.37,0:41:59.87,Default,,0,0,0,,Барлық алып құдай сарбаздары қазбаға айналуы керек еді.
Dialogue: 0,0:42:02.90,0:42:08.35,Default,,0,0,0,,Бірақ мың жыл бойы жер астында ұйықтап жатқан біреу болды.
Dialogue: 0,0:42:08.35,0:42:12.36,Default,,0,0,0,,Ойлап қарасам, бұл жігіт те адамға ұқсайды.
Dialogue: 0,0:42:12.36,0:42:16.84,Default,,0,0,0,,Толумекия — қиыр батыстағы жауыз әскери мемлекет.
Dialogue: 0,0:42:16.84,0:42:20.34,Default,,0,0,0,,Мен өлген Пежите тұтқыны туралы қызықтымын.
Dialogue: 0,0:42:23.90,0:42:25.90,Default,,0,0,0,,Сондай-ақ, өтінемін.
Dialogue: 0,0:42:35.88,0:42:37.88,Default,,0,0,0,,Гах! Бірдеңе?
Dialogue: 0,0:42:44.87,0:42:46.37,Default,,0,0,0,,Әй?
Dialogue: 0,0:42:49.41,0:42:51.45,Default,,0,0,0,,Уау!?
Dialogue: 0,0:42:51.45,0:42:54.35,Default,,0,0,0,,Кя~!!
Dialogue: 0,0:42:54.35,0:42:56.85,Default,,0,0,0,,Қашып кет~!!
Dialogue: 0,0:43:00.86,0:43:03.86,Default,,0,0,0,,Бұл Торумекияның кемесі! Барлығын сарайға әкеліңіз!
Dialogue: 0,0:43:03.86,0:43:05.86,Default,,0,0,0,,Кя~!!
Dialogue: 0,0:43:07.85,0:43:09.85,Default,,0,0,0,,Уау!!
Dialogue: 0,0:43:11.42,0:43:13.47,Default,,0,0,0,,Барлығына! Қамалға!
Dialogue: 0,0:43:13.47,0:43:16.85,Default,,0,0,0,,Барлығы қамалға жиналды! Қамалға!
Dialogue: 0,0:43:16.85,0:43:18.86,Default,,0,0,0,,Ах!?
Dialogue: 0,0:43:18.86,0:43:20.36,Default,,0,0,0,,Әке!
Dialogue: 0,0:43:20.36,0:43:30.87,Default,,0,0,0,,♪♪~
Dialogue: 0,0:43:30.87,0:43:35.84,Default,,0,0,0,,Баба, жасырын! Мен мындамын.
Dialogue: 0,0:43:35.84,0:43:51.39,Default,,0,0,0,,♪♪~
Dialogue: 0,0:43:51.39,0:43:53.42,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:43:53.42,0:43:55.42,Default,,0,0,0,,Ханшайым!?
Dialogue: 0,0:44:01.35,0:44:02.85,Default,,0,0,0,,Ха!
Dialogue: 0,0:44:02.85,0:44:08.84,Default,,0,0,0,,♪♪~
Dialogue: 0,0:44:08.84,0:44:10.86,Default,,0,0,0,,Қорқыныш!!
Dialogue: 0,0:44:10.86,0:44:14.86,Default,,0,0,0,,Уау!! Апыр-ай!! Апыр-ай!!
Dialogue: 0,0:44:16.38,0:44:19.38,Default,,0,0,0,,Уау!! Ах!
Dialogue: 0,0:44:22.85,0:44:24.85,Default,,0,0,0,,Ха!! Уф!!
Dialogue: 0,0:44:28.34,0:44:30.34,Default,,0,0,0,,Ха!! Ха!!
Dialogue: 0,0:44:34.35,0:44:36.85,Default,,0,0,0,,Наусика...! Апыр-ай!!
Dialogue: 0,0:44:38.90,0:44:40.44,Default,,0,0,0,,Ха!
Dialogue: 0,0:44:40.44,0:44:45.36,Default,,0,0,0,,Екі жақ, қозғалмаңдар! Қозғалса, патша жәндіктерінің терісінен ойылған →
Dialogue: 0,0:44:45.36,0:44:48.36,Default,,0,0,0,,Бұл қылыш тіпті керамикалық сауытты тесіп те алады!
Dialogue: 0,0:44:48.36,0:44:50.36,Default,,0,0,0,,Бұл адам - ​​Юпа.
Dialogue: 0,0:44:50.36,0:44:52.87,Default,,0,0,0,,Толмекия сарбаздарынан сұраңыз.
Dialogue: 0,0:44:52.87,0:44:57.87,Default,,0,0,0,,Бұл алқаптың халқы кеше түнде сенің кемеңді құтқару үшін аянбай еңбек етті.
Dialogue: 0,0:44:57.87,0:45:01.93,Default,,0,0,0,,Қайтыс болғандар құрметпен жерленді.
Dialogue: 0,0:45:01.93,0:45:06.36,Default,,0,0,0,,Бұл Толмекияның әлгі елге жасаған ілтипаты ма, аз болса да?
Dialogue: 0,0:45:06.36,0:45:10.35,Default,,0,0,0,,Егер сіз соғыс бастағыңыз келсе, оның себебі болуы керек→
Dialogue: 0,0:45:10.35,0:45:13.85,Default,,0,0,0,,Алдымен мәлімдеме жасау үшін хабаршы жіберу керек.
Dialogue: 0,0:45:16.86,0:45:20.38,Default,,0,0,0,,Наусика... Сабыр ет, Наусика→
Dialogue: 0,0:45:20.38,0:45:24.45,Default,,0,0,0,,Қазір шайқассақ, алқаптағылардың бәрі өледі →
Dialogue: 0,0:45:24.45,0:45:27.87,Default,,0,0,0,,Аман болыңыз және өз мүмкіндігіңізді күтіңіз.
Dialogue: 0,0:45:27.87,0:45:31.36,Default,,0,0,0,,Тәтті... кішкентай қыз!
Dialogue: 0,0:45:31.36,0:45:33.36,Default,,0,0,0,,Тоқта, Куротова.
Dialogue: 0,0:45:33.36,0:45:35.84,Default,,0,0,0,,Бірақ….
Dialogue: 0,0:45:35.84,0:45:41.37,Default,,0,0,0,,Әй, қандай жігіт! Ол бәрін өлтірді!
Dialogue: 0,0:45:41.37,0:45:43.92,Default,,0,0,0,,сөгіс Құлағым ауырды.
Dialogue: 0,0:45:43.92,0:45:46.35,Default,,0,0,0,,Шекаралық қылышшы Юпа Миральда кім→
Dialogue: 0,0:45:46.35,0:45:48.36,Default,,0,0,0,,Сіз ше?
Dialogue: 0,0:45:48.36,0:45:54.36,Default,,0,0,0,,Біздің мақсатымыз өлтіру емес. Біз сөйлескіміз келеді. Қылышыңды қынап.
Dialogue: 0,0:45:54.36,0:46:32.85,Default,,0,0,0,,♪♪~
Dialogue: 0,0:46:32.85,0:46:36.35,Default,,0,0,0,,Иә? Бұл ханшайым! Бұл ханшайым! Ханшайым!
Dialogue: 0,0:46:39.87,0:46:41.86,Default,,0,0,0,,Тыңдаңыз!
Dialogue: 0,0:46:41.86,0:46:47.38,Default,,0,0,0,,Бұл Толмекия империясының Шекара экспедициялық әскерлерінің қолбасшысы мәртебелі Кушананың сөздері.
Dialogue: 0,0:46:47.38,0:46:51.45,Default,,0,0,0,,Шекаралас елдерді біріктіреміз→
Dialogue: 0,0:46:51.45,0:46:55.36,Default,,0,0,0,,Мен мұнда патша жұмағын салу үшін келдім.
Dialogue: 0,0:46:55.36,0:46:59.38,Default,,0,0,0,,Шіріген теңіздің кесірінен жойылудың алдында тұрсың.
Dialogue: 0,0:46:59.38,0:47:03.88,Default,,0,0,0,,Бізге жазылыңыз және біздің бизнеске қатысыңыз.
Dialogue: 0,0:47:03.88,0:47:08.37,Default,,0,0,0,,Шіріген теңізді өртеп, жерді қайтадан тірілт!
Dialogue: 0,0:47:08.37,0:47:11.41,Default,,0,0,0,,Шіріу теңізін өртеп жібересіз бе? Бұл мүмкін бе?
Dialogue: 0,0:47:11.41,0:47:14.86,Default,,0,0,0,,Бір кездері адамдар осы жердің қожасы болды→
Dialogue: 0,0:47:14.86,0:47:17.86,Default,,0,0,0,,Ғажайып шеберлік пен құдірет Біз жандандық.
Dialogue: 0,0:47:17.86,0:47:20.38,Default,,0,0,0,,Маған ергендерге→
Dialogue: 0,0:47:20.38,0:47:24.88,Default,,0,0,0,,Орманның уы мен жәндіктерінен қорықпайтын өмір сүруге уәде берейік.
Dialogue: 0,0:47:28.36,0:47:30.86,Default,,0,0,0,,≪ Күте тұрыңыз! ≫
Dialogue: 0,0:47:33.84,0:47:36.85,Default,,0,0,0,,Жемқорлық теңізімен араласпа!
Dialogue: 0,0:47:36.85,0:47:40.35,Default,,0,0,0,,Бұл кәрі қаңбақ не? Эй, мені алып кет!
Dialogue: 0,0:47:40.35,0:47:42.37,Default,,0,0,0,,Мен сізге айтайын.
Dialogue: 0,0:47:42.37,0:47:45.84,Default,,0,0,0,,Фукайдың туғанына мың жыл болды.
Dialogue: 0,0:47:45.84,0:47:50.41,Default,,0,0,0,,Адамдар көп рет Шіріген теңізді өртеуге тырысты.
Dialogue: 0,0:47:50.41,0:47:54.85,Default,,0,0,0,,Әр кезде... патша жәндіктерінің тобы ашудан есінен танып қалады→
Dialogue: 0,0:47:54.85,0:48:00.35,Default,,0,0,0,,Жерді толтырған үлкен толқындармен асығыс келді.
Dialogue: 0,0:48:08.38,0:48:12.45,Default,,0,0,0,,Елді құртып, қаланы жұт →
Dialogue: 0,0:48:12.45,0:48:19.36,Default,,0,0,0,,Патша жәндігі аштықтан өмірі біткенше жүгіре берді.
Dialogue: 0,0:48:19.36,0:48:26.35,Default,,0,0,0,,Ақырында споралар патша жәндіктерінің қабығын тұқым ұясы ретінде пайдаланып, жерге тамыр салады→
Dialogue: 0,0:48:26.35,0:48:30.37,Default,,0,0,0,,Кең аумақтар Шірік теңізіне батып кетті.
Dialogue: 0,0:48:30.37,0:48:33.37,Default,,0,0,0,,Сыбайлас жемқорлық теңізімен араласпаңыз.
Dialogue: 0,0:48:33.37,0:48:36.42,Default,,0,0,0,,Тыныш! Мен мұндай ақымақ сөздерге шыдамаймын.
Dialogue: 0,0:48:36.42,0:48:40.86,Default,,0,0,0,,Эй, не істеуіміз керек? Мені де өлтіресің бе?
Dialogue: 0,0:48:42.36,0:48:47.35,Default,,0,0,0,,Мені өлтір! Мен қарт адаммын. Бұл оңай.
Dialogue: 0,0:48:47.35,0:48:50.35,Default,,0,0,0,,Мен Джилді өлтіргендеймін.
Dialogue: 0,0:48:50.35,0:48:51.86,Default,,0,0,0,,Құрметті Джил!?
Dialogue: 0,0:48:51.86,0:48:54.88,Default,,0,0,0,,Қандай қорқынышты! Джил-сама ауырып жатыр!
Dialogue: 0,0:48:54.88,0:48:57.95,Default,,0,0,0,,Шық! Өлтіруші!
Dialogue: 0,0:48:57.95,0:49:00.85,Default,,0,0,0,,Аузыңды жап! Саған қарсы шыққандарға аяма!
Dialogue: 0,0:49:00.85,0:49:04.85,Default,,0,0,0,,Барлығы, күте тұрыңдар! Мені тыңда!
Dialogue: 0,0:49:07.87,0:49:11.34,Default,,0,0,0,,Мен бұдан былай құрбандық жасағым келмейді.
Dialogue: 0,0:49:11.34,0:49:13.88,Default,,0,0,0,,Өтінемін….
Dialogue: 0,0:49:13.88,0:49:16.38,Default,,0,0,0,,Ханшайым….
Dialogue: 0,0:49:17.42,0:49:22.87,Default,,0,0,0,,Ұлы баба да түсінеді... Осы кісілердің соңынан ерейік.
Dialogue: 0,0:49:22.87,0:49:34.37,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:53:21.34,0:53:42.35,Default,,0,0,0,,♪♪~
Dialogue: 0,0:53:42.35,0:53:46.33,Default,,0,0,0,,Бұл әдемі алқап емес пе? Мен қарсымын.
Dialogue: 0,0:53:46.33,0:53:50.35,Default,,0,0,0,,Біздің елде біз алып құдай сарбаздарын мүмкіндігінше тезірек әкелуді бұйырамыз.
Dialogue: 0,0:53:50.35,0:53:52.91,Default,,0,0,0,,Бұйрық орындалмайды.
Dialogue: 0,0:53:52.91,0:53:56.36,Default,,0,0,0,,Оның салмағына үлкен кемелер де төтеп бере алмай, апатқа ұшырады.
Dialogue: 0,0:53:56.36,0:54:00.35,Default,,0,0,0,,Алайда, мен олар шынымен де осы жерде ұлт құрғысы келеді деп ойламаппын...
Dialogue: 0,0:54:00.35,0:54:03.85,Default,,0,0,0,,Егер солай болса ше? Сіз сол құбыжықсыз →
Dialogue: 0,0:54:03.85,0:54:06.85,Default,,0,0,0,,Оны өз еліміздегі ақымақтардың ойыншығына айналдырайық па?
Dialogue: 0,0:54:06.85,0:54:09.34,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:54:09.34,0:54:13.93,Default,,0,0,0,,Мен жай ғана әскери адаммын, мұндай шешім менің қолымнан келмейді.
Dialogue: 0,0:54:13.93,0:54:16.43,Default,,0,0,0,,Енот ит!
Dialogue: 0,0:54:19.85,0:54:23.35,Default,,0,0,0,,Алып Құдай сарбазының қайта тірілуі үшін алыста жүргенімде Пежитеге қайтамын →
Dialogue: 0,0:54:23.35,0:54:25.34,Default,,0,0,0,,Барыңды бер. Ха.
Dialogue: 0,0:54:25.34,0:54:29.34,Default,,0,0,0,,Бұл қаруды қолдануға бола ма? Иә, бұл табылған зат.
Dialogue: 0,0:54:30.34,0:54:32.36,Default,,0,0,0,,Қате жасамаңыз.
Dialogue: 0,0:54:32.36,0:54:34.88,Default,,0,0,0,,Мен кеңес бермеймін.
Dialogue: 0,0:54:34.88,0:54:37.94,Default,,0,0,0,,Бірақ ханшайымды Пежитеге апару...
Dialogue: 0,0:54:37.94,0:54:40.84,Default,,0,0,0,,Кепілге алынған бес адам мен қару-жараққа тамақ...
Dialogue: 0,0:54:40.84,0:54:45.34,Default,,0,0,0,,Таңдауды сізге қалдырамын. Дайындықтарды ертеңгі таңға дейін аяқтаңыз.
Dialogue: 0,0:54:56.92,0:54:58.84,Default,,0,0,0,,Кепілге алынғандар азап шегуде.
Dialogue: 0,0:54:58.84,0:55:00.86,Default,,0,0,0,,Қалай болғанда да, қараңызшы →
Dialogue: 0,0:55:00.86,0:55:03.86,Default,,0,0,0,,Олар барлығын өздерімен бірге алып кетеді.
Dialogue: 0,0:55:03.86,0:55:08.33,Default,,0,0,0,,Мен бұл жерді тастап, жасырын оралып, мүмкіндікті күтемін.
Dialogue: 0,0:55:08.33,0:55:12.33,Default,,0,0,0,,Біз бұл құбыжықтың қайта тірілуін не болса да тоқтатуымыз керек.
Dialogue: 0,0:55:15.92,0:55:17.92,Default,,0,0,0,,Наусика.
Dialogue: 0,0:55:31.36,0:55:35.36,Default,,0,0,0,,Тет, сенің қожайын қайда?
Dialogue: 0,0:56:15.83,0:56:17.83,Default,,0,0,0,,О.
Dialogue: 0,0:56:27.39,0:56:28.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:56:29.95,0:56:35.85,Default,,0,0,0,,Наусика Бұл нені білдіреді? Бұл шіріген теңізден шыққан өсімдік емес пе?
Dialogue: 0,0:56:35.85,0:56:39.36,Default,,0,0,0,,Спораларды жинап, өсірдім.
Dialogue: 0,0:56:39.36,0:56:41.86,Default,,0,0,0,,Жарайды. Миазма бөлінбейді.
Dialogue: 0,0:56:41.86,0:56:47.86,Default,,0,0,0,,У жоқ па? Бұл жердің ауасы таза екені рас, бірақ...
Dialogue: 0,0:56:48.83,0:56:52.92,Default,,0,0,0,,Неліктен? Өте улы Хисоку гүлдері болса да.
Dialogue: 0,0:56:52.92,0:56:55.82,Default,,0,0,0,,Мұндағы су құлыптың үлкен жел диірменінен келеді→
Dialogue: 0,0:56:55.82,0:56:58.83,Default,,0,0,0,,500 еріген жер астынан көтерілген су.
Dialogue: 0,0:56:58.83,0:57:02.85,Default,,0,0,0,,Сол құдықтың түбінен құм жиналды.
Dialogue: 0,0:57:02.85,0:57:08.34,Default,,0,0,0,,Таза су мен топырақта Хош иісті теңіз ағаштары у шығармайды.
Dialogue: 0,0:57:08.34,0:57:10.85,Default,,0,0,0,,Лас болған топырақ.
Dialogue: 0,0:57:10.85,0:57:13.92,Default,,0,0,0,,Бұл алқаптың топырағы да лас.
Dialogue: 0,0:57:13.92,0:57:19.83,Default,,0,0,0,,Неліктен... әлемді кім осылай жаратты?
Dialogue: 0,0:57:19.83,0:57:22.83,Default,,0,0,0,,Сіз мұны өзіңіз жасадыңыз ба?
Dialogue: 0,0:57:22.83,0:57:27.34,Default,,0,0,0,,Иә... Әкемнің де, өзгенің де дертін емдегім келді.
Dialogue: 0,0:57:27.34,0:57:29.34,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:57:30.84,0:57:33.84,Default,,0,0,0,,Мен бұл жерді қазір жауып жатырмын.
Dialogue: 0,0:57:33.84,0:57:38.84,Default,,0,0,0,,Суды ертерек тоқтатқандықтан, олардың барлығы жақын арада кебеді.
Dialogue: 0,0:57:42.34,0:57:51.33,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:57:51.33,0:57:53.35,Default,,0,0,0,,Наусика….
Dialogue: 0,0:57:53.35,0:57:56.35,Default,,0,0,0,,Мен... Мен өзімнен қорқамын.
Dialogue: 0,0:57:57.37,0:58:01.44,Default,,0,0,0,,Жектіктің жетегінде, Не істерімді білмеймін.
Dialogue: 0,0:58:01.44,0:58:04.84,Default,,0,0,0,,Мен енді ешкімді өлтіргім келмейді...
Dialogue: 0,0:58:04.84,0:58:12.34,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:58:35.34,0:58:38.34,Default,,0,0,0,,Ханшайым!
Dialogue: 0,0:58:38.34,0:58:41.41,Default,,0,0,0,,Мұны бәріміз жинадық. Чико жемісі.
Dialogue: 0,0:58:41.41,0:58:43.41,Default,,0,0,0,,Мен оны ханшайымға беремін.
Dialogue: 0,0:58:44.35,0:58:46.35,Default,,0,0,0,,Барлығы….
Dialogue: 0,0:58:47.35,0:58:51.34,Default,,0,0,0,,Сонша... қиын болған шығар.
Dialogue: 0,0:58:51.34,0:58:55.84,Default,,0,0,0,,Рахмет. Мен абайлап жеймін.
Dialogue: 0,0:58:55.84,0:58:57.84,Default,,0,0,0,,Бейшара ханшайым!
Dialogue: 0,0:58:57.84,0:58:59.88,Default,,0,0,0,,Отырғызуға асығыңыз! Барайық!
Dialogue: 0,0:58:59.88,0:59:03.85,Default,,0,0,0,,Кәне, бәрің, енді жыламаңдар.
Dialogue: 0,0:59:03.85,0:59:07.35,Default,,0,0,0,,Жарайды, мен жақында келемін.
Dialogue: 0,0:59:07.35,0:59:09.34,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:59:09.34,0:59:13.36,Default,,0,0,0,,О, мен өтірік айттым ба? жоқ.
Dialogue: 0,0:59:13.36,0:59:15.85,Default,,0,0,0,,Сәлем. Иә.
Dialogue: 0,0:59:15.85,0:59:17.86,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:59:17.86,0:59:19.38,Default,,0,0,0,,Иә!
Dialogue: 0,0:59:19.38,0:59:22.38,Default,,0,0,0,,Келіңіздер, бұл қауіпті. Иә.
Dialogue: 0,0:59:26.86,0:59:29.36,Default,,0,0,0,,Мен сенімдімін!
Dialogue: 0,0:59:39.34,0:59:42.84,Default,,0,0,0,,Мен ханшайымды сұраймын! Маған кейінірек қарауыңызды өтінемін!
Dialogue: 0,1:00:33.41,1:00:37.84,Default,,0,0,0,,Менде әлі Пежите жоқ. Менің арқам ауырады.
Dialogue: 0,1:00:37.84,1:00:40.33,Default,,0,0,0,,Әй, ханшайым да→
Dialogue: 0,1:00:40.33,1:00:43.83,Default,,0,0,0,,Жомарттарды ғана таңдадым.
Dialogue: 0,1:00:43.83,1:00:46.84,Default,,0,0,0,,Бұл біртүрлі деп ойламайсың ба?
Dialogue: 0,1:00:46.84,1:00:50.36,Default,,0,0,0,,Неліктен олар тығыз ұшады?
Dialogue: 0,1:00:50.36,1:00:53.86,Default,,0,0,0,,Олар шабуылдан қорқатын сияқты.
Dialogue: 0,1:01:08.36,1:01:11.86,Default,,0,0,0,,Бұлттардың астында миазманың құйындары бар.
Dialogue: 0,1:01:17.87,1:01:19.37,Default,,0,0,0,,Ах...!?
Dialogue: 0,1:01:20.92,1:01:22.92,Default,,0,0,0,,Иә? Қозғалма!
Dialogue: 0,1:01:26.36,1:01:28.33,Default,,0,0,0,,Атқыштар!
Dialogue: 0,1:01:28.33,1:01:31.83,Default,,0,0,0,,(бомба дыбысы)
Dialogue: 0,1:01:33.85,1:01:35.35,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:01:35.35,1:01:36.85,Default,,0,0,0,,Уақыт жұмсауға тұрарлық еді>
Dialogue: 0,1:01:36.85,1:01:39.86,Default,,0,0,0,,Жау шабуылы! Екінші кеме жойылды! (дабыл дыбысы)
Dialogue: 0,1:01:39.86,1:01:46.85,Default,,0,0,0,,(Endeavour) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,1:01:46.85,1:01:50.35,Default,,0,0,0,,Мен айтқанымдай! Уау, бұл қорқынышты!
Dialogue: 0,1:01:50.35,1:01:52.35,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:01:55.34,1:01:57.34,Default,,0,0,0,,Қорғаныс шеңбері!
Dialogue: 0,1:01:57.34,1:01:59.36,Default,,0,0,0,,Пежиттік қару. Пежите!?
Dialogue: 0,1:01:59.36,1:02:08.84,Default,,0,0,0,,(бомба дыбысы)
Dialogue: 0,1:02:08.84,1:02:10.84,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:02:10.84,1:02:15.86,Default,,0,0,0,,Шүкір, үшінші кемені де жеп қойды! Корветт не істеп жатыр?
Dialogue: 0,1:02:15.86,1:02:18.36,Default,,0,0,0,,Қандай нәзік кеме.
Dialogue: 0,1:02:23.87,1:02:25.90,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:02:25.90,1:02:28.40,Default,,0,0,0,,Уау! Сингари қатысты!
Dialogue: 0,1:02:29.36,1:02:30.86,Default,,0,0,0,,Уақыт жұмсауға тұрарлық еді>
Dialogue: 0,1:02:33.34,1:02:35.34,Default,,0,0,0,,Баржа сымы!
Dialogue: 0,1:02:40.85,1:02:42.85,Default,,0,0,0,,Тет асығыңыз!
Dialogue: 0,1:02:43.87,1:02:47.87,Default,,0,0,0,,(бомба дыбысы)
Dialogue: 0,1:03:00.85,1:03:04.85,Default,,0,0,0,,Жұмыс істемесе, мынау да құлап қалады! Ханшайым!?
Dialogue: 0,1:03:10.40,1:03:13.40,Default,,0,0,0,,Тоқта! Мені енді өлтірме!!
Dialogue: 0,1:03:20.84,1:03:22.34,Default,,0,0,0,,(бомба дыбысы)
Dialogue: 0,1:03:22.34,1:03:25.34,Default,,0,0,0,,Тоқташы~!! Апыр-ай!
Dialogue: 0,1:03:27.35,1:03:28.85,Default,,0,0,0,,(бомба дыбысы)
Dialogue: 0,1:03:30.35,1:03:31.85,Default,,0,0,0,,Уақыт жұмсауға тұрарлық еді>
Dialogue: 0,1:03:43.35,1:03:46.35,Default,,0,0,0,,Ханшайым... Уау!
Dialogue: 0,1:03:52.86,1:03:57.86,Default,,0,0,0,,Тезірек, Мито! Ачичи... Ханшайым, енді жақсы емес!
Dialogue: 0,1:04:02.83,1:04:05.83,Default,,0,0,0,,Сіз ұша алатын шығарсыз! Не!?
Dialogue: 0,1:04:07.34,1:04:08.84,Default,,0,0,0,,Мито Асығыңыз!
Dialogue: 0,1:04:08.84,1:04:10.34,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,1:04:11.36,1:04:14.86,Default,,0,0,0,,Қозғалтқышты іске қосыңыз! Есікті мылтықпен сындырыңыз! иә!
Dialogue: 0,1:04:17.36,1:04:18.86,Default,,0,0,0,,Ха!
Dialogue: 0,1:04:22.85,1:04:25.85,Default,,0,0,0,,Кел! тез!
Dialogue: 0,1:04:27.82,1:04:30.34,Default,,0,0,0,,Ішке асығыңыз! Мито, бара аласың ба?
Dialogue: 0,1:04:30.34,1:04:31.84,Default,,0,0,0,,Әйтеуір!
Dialogue: 0,1:04:33.83,1:04:36.87,Default,,0,0,0,,Қозғалтқыш жанумен бір уақытта толық ашылады! сізді түсіндім!
Dialogue: 0,1:04:36.87,1:04:38.90,Default,,0,0,0,,Эй, ат!
Dialogue: 0,1:04:38.90,1:04:40.90,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:04:43.86,1:04:45.86,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:04:49.85,1:04:54.35,Default,,0,0,0,,Миазма маскасын киіңіз! Бұлттардың астына түсіп, баржаны құтқарыңыз!
Dialogue: 0,1:04:57.85,1:05:05.33,Default,,0,0,0,,♪♪~
Dialogue: 0,1:05:05.33,1:05:08.33,Default,,0,0,0,,《Жылы... Өлме Тет》
Dialogue: 0,1:05:08.33,1:05:20.88,Default,,0,0,0,,♪♪~
Dialogue: 0,1:05:20.88,1:05:25.35,Default,,0,0,0,,Қандай дүние! Мен бұрын-соңды мұндай қалың миазманы көрген емеспін.
Dialogue: 0,1:05:25.35,1:05:29.34,Default,,0,0,0,,Артқы орындық Оң жақтан сақ болыңыз! Мен жақынмын.
Dialogue: 0,1:05:29.34,1:05:32.84,Default,,0,0,0,,Не? Әлі де ұшуда!
Dialogue: 0,1:05:32.84,1:05:37.34,Default,,0,0,0,,Ах! Бұл рас! Мен шынымен сонда болдым... Уау!
Dialogue: 0,1:05:49.34,1:05:52.34,Default,,0,0,0,,Сәлем, ханшайым! Ханшайым~!
Dialogue: 0,1:05:52.34,1:05:55.35,Default,,0,0,0,,Барлығына сәттілік! Қазір арқанды созыңыз!
Dialogue: 0,1:05:55.35,1:05:59.33,Default,,0,0,0,,Ілмек сынып қалады! Ауада ұстау мүмкін емес!
Dialogue: 0,1:05:59.33,1:06:02.87,Default,,0,0,0,,Мен жерді құлатып, жәндіктерге жем болғым келмейді!
Dialogue: 0,1:06:02.87,1:06:04.92,Default,,0,0,0,,Бір ой мені өлтіреді!
Dialogue: 0,1:06:04.92,1:06:08.34,Default,,0,0,0,,Сабыр ет! Жүктеріңізді тастаңыз!
Dialogue: 0,1:06:08.34,1:06:10.86,Default,,0,0,0,,Сау болыңыз!
Dialogue: 0,1:06:10.86,1:06:13.35,Default,,0,0,0,,Тыңдаңыз! Жүктеріңізді тастаңыз!
Dialogue: 0,1:06:13.35,1:06:16.35,Default,,0,0,0,,Артқы орындық Қозғалтқышты өшіріңіз! Не... не?
Dialogue: 0,1:06:16.35,1:06:19.35,Default,,0,0,0,,Қозғалтқыштың шуы алаңдатады. Асықшы! иә!
Dialogue: 0,1:06:19.35,1:06:20.85,Default,,0,0,0,,А...!?
Dialogue: 0,1:06:24.89,1:06:27.39,Default,,0,0,0,,Ханшайым! Не... не!?
Dialogue: 0,1:06:29.85,1:06:31.87,Default,,0,0,0,,Ханшайым, бетперде ки!
Dialogue: 0,1:06:31.87,1:06:34.35,Default,,0,0,0,,Мен өлемін! Маска тақпа!
Dialogue: 0,1:06:34.35,1:06:38.34,Default,,0,0,0,,Барлығына! Мен міндетті түрде көмектесемін! Маған сеніп, ауыртпалығыңызды тастаңыз!
Dialogue: 0,1:06:38.34,1:06:42.84,Default,,0,0,0,,Жоқ... Мен бәрін істеймін! Өтінемін, асығыңыздар және маска киіңіздер!
Dialogue: 0,1:06:48.45,1:06:51.84,Default,,0,0,0,,Ханшайым күледі... Көмектеседі.
Dialogue: 0,1:06:51.84,1:06:53.85,Default,,0,0,0,,Асығыңыз! Жүгіңді таста!
Dialogue: 0,1:06:53.85,1:06:57.84,Default,,0,0,0,,Мұрын төмен! Қозғалтқыштың тұтануы... Мәжбүрлі қонуды іздеңіз.
Dialogue: 0,1:06:57.84,1:07:00.34,Default,,0,0,0,,Өкпегіме аздап кірді...
Dialogue: 0,1:07:02.85,1:07:06.87,Default,,0,0,0,,Әй, тезірек! Асығыңыз, асығыңыз!
Dialogue: 0,1:07:06.87,1:07:52.36,Default,,0,0,0,,♪♪~
Dialogue: 0,1:08:18.34,1:08:21.87,Default,,0,0,0,,Ханшайым~!! Барлығы қауіпсіз бе?
Dialogue: 0,1:08:21.87,1:08:24.37,Default,,0,0,0,,Қозғалмаңыз! Ах!?
Dialogue: 0,1:08:25.83,1:08:27.85,Default,,0,0,0,,Сіз...!?
Dialogue: 0,1:08:27.85,1:08:30.83,Default,,0,0,0,,Бұрынғы қажырлы еңбегіңіз үшін рахмет.
Dialogue: 0,1:08:30.83,1:08:33.34,Default,,0,0,0,,Ханшайым! Неге мұндай жігіт!
Dialogue: 0,1:08:33.34,1:08:38.34,Default,,0,0,0,,Бұл сондай тәтті... Мен саған сәлем айтамын деп ойладың ба?
Dialogue: 0,1:08:38.34,1:08:41.84,Default,,0,0,0,,Фукай туралы ештеңе түсінбейсіз.
Dialogue: 0,1:08:42.90,1:08:45.33,Default,,0,0,0,,Бұл адам әлемі емес.
Dialogue: 0,1:08:45.33,1:08:49.84,Default,,0,0,0,,Мылтықпен не болатынын ешқашан білмейсіз.
Dialogue: 0,1:08:49.84,1:08:51.84,Default,,0,0,0,,Алдыңғы шайқаста→
Dialogue: 0,1:08:51.84,1:08:54.84,Default,,0,0,0,,Көптеген кемелер орманға құлады, жәндіктер ашуланады.
Dialogue: 0,1:08:54.84,1:08:56.84,Default,,0,0,0,,Жоғарыға қараңыз.
Dialogue: 0,1:09:06.84,1:09:11.34,Default,,0,0,0,,Ұлы патша Янма орманның күзетшісі. Ол басқа жәндіктерді дереу жинайды.
Dialogue: 0,1:09:11.34,1:09:14.34,Default,,0,0,0,,Қазір қашыңыз! Қосалқы арқаныңызды тез алыңыз!
Dialogue: 0,1:09:14.34,1:09:17.35,Default,,0,0,0,,бұл... Иә! Мито! Ілгекті бекітіңіз!
Dialogue: 0,1:09:17.35,1:09:19.35,Default,,0,0,0,,Уау!
Dialogue: 0,1:09:19.35,1:09:22.39,Default,,0,0,0,,Қозғалмаңыз! Мен бұйрық беремін!
Dialogue: 0,1:09:22.39,1:09:26.86,Default,,0,0,0,,Сіз неден қорқасыз? Жоғалған түлкі тиін сияқты.
Dialogue: 0,1:09:26.86,1:09:28.36,Default,,0,0,0,,Не!?
Dialogue: 0,1:09:28.36,1:09:29.86,Default,,0,0,0,,Қорықпа.
Dialogue: 0,1:09:29.86,1:09:33.85,Default,,0,0,0,,Мен сенің еліңе оралуыңды қалаймын.
Dialogue: 0,1:09:33.85,1:09:36.85,Default,,0,0,0,,Сіз! Апыр-ай! Апыр-ай!
Dialogue: 0,1:09:36.85,1:09:40.35,Default,,0,0,0,,Уау! Бұл не!?
Dialogue: 0,1:09:45.84,1:09:47.34,Default,,0,0,0,,Спорт күні керемет өтті, иә?
Dialogue: 0,1:10:00.39,1:10:03.39,Default,,0,0,0,,Ах...! Тыныш бол! Мені ашуландырмаңыз!
Dialogue: 0,1:10:04.34,1:10:06.36,Default,,0,0,0,,Бұл патша жәндіктерінің ұясы!
Dialogue: 0,1:10:06.36,1:10:09.36,Default,,0,0,0,,Немесе… қоршалған….
Dialogue: 0,1:10:21.93,1:10:26.43,Default,,0,0,0,,Демек, бағана келген екен ғой?
Dialogue: 0,1:10:30.35,1:10:32.85,Default,,0,0,0,,Бізді тексеру.
Dialogue: 0,1:10:33.84,1:10:39.36,Default,,0,0,0,,Оумиши: Ұяңды бұзғаным үшін кешір.
Dialogue: 0,1:10:39.36,1:10:43.35,Default,,0,0,0,,Бірақ біз сенің жауларың емес екенімізді түсініңдер.
Dialogue: 0,1:10:43.35,1:11:03.35,Default,,0,0,0,,♪♪~
Dialogue: 0,1:11:03.35,1:11:05.86,Default,,0,0,0,,♪♪~ Сәлем... Ханшайым~!
Dialogue: 0,1:11:05.86,1:12:14.86,Default,,0,0,0,,♪♪~
Dialogue: 0,1:12:14.86,1:12:18.86,Default,,0,0,0,,Ол кісі тірі ме!? Күте тұрыңыз! Король жәндік!
Dialogue: 0,1:12:32.34,1:12:35.85,Default,,0,0,0,,Не болады!? Патша жәндіктің көздері ашық қызыл!
Dialogue: 0,1:12:35.85,1:12:37.35,Default,,0,0,0,,Ой~!
Dialogue: 0,1:12:44.85,1:12:47.91,Default,,0,0,0,,Ханшайым! Мевемен не істеуді жоспарлап отырсыз?
Dialogue: 0,1:12:47.91,1:12:51.33,Default,,0,0,0,,Су тынышталғанда, дереу ұшып, аспанда күтіңіз!
Dialogue: 0,1:12:51.33,1:12:54.33,Default,,0,0,0,,Бір сағаттан кейін қайтып келмесең, аңғарға қайт!
Dialogue: 0,1:12:54.33,1:12:55.83,Default,,0,0,0,,Бірақ….
Dialogue: 0,1:12:55.83,1:12:57.83,Default,,0,0,0,,Ханшайым... Уау!
Dialogue: 0,1:13:13.35,1:13:16.35,Default,,0,0,0,,Ол кетті...
Dialogue: 0,1:13:16.35,1:13:18.35,Default,,0,0,0,,Оны саған берейін.
Dialogue: 0,1:13:21.84,1:13:27.34,Default,,0,0,0,,Енді бәріміз ханшайымның айтқанын орындаңдар.
Dialogue: 0,1:13:29.40,1:13:31.40,Default,,0,0,0,,Ханшайым….
Dialogue: 0,1:13:36.84,1:13:40.84,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:13:51.37,1:13:53.37,Default,,0,0,0,,Ах!
Dialogue: 0,1:13:55.84,1:13:57.34,Default,,0,0,0,,Қап!
Dialogue: 0,1:13:59.35,1:14:02.35,Default,,0,0,0,,Онда оқ жоқ Ах...
Dialogue: 0,1:14:02.35,1:14:04.35,Default,,0,0,0,,♪♪~ Уау!
Dialogue: 0,1:14:04.35,1:14:06.85,Default,,0,0,0,,♪♪~
Dialogue: 0,1:14:06.85,1:14:09.34,Default,,0,0,0,,♪♪~ Ах~!
Dialogue: 0,1:14:09.34,1:14:12.91,Default,,0,0,0,,♪♪~
Dialogue: 0,1:14:12.91,1:14:14.44,Default,,0,0,0,,♪♪~ Ах...!
Dialogue: 0,1:14:14.44,1:14:18.85,Default,,0,0,0,,♪♪~
Dialogue: 0,1:14:18.85,1:14:19.83,Default,,0,0,0,,♪♪~ Ах!
Dialogue: 0,1:14:19.83,1:14:32.86,Default,,0,0,0,,♪♪~
Dialogue: 0,1:14:32.86,1:14:35.41,Default,,0,0,0,,Ал сіз ше!? ♪♪~ Сіз тым көп өлтіресіз!
Dialogue: 0,1:14:35.41,1:14:38.35,Default,,0,0,0,,Жеңіл оқтар мен қате ысқырықтар енді жұмыс істемейді!
Dialogue: 0,1:14:38.35,1:14:47.86,Default,,0,0,0,,♪♪~
Dialogue: 0,1:14:47.86,1:14:49.36,Default,,0,0,0,,♪♪~ Ах!!
Dialogue: 0,1:14:49.36,1:15:02.36,Default,,0,0,0,,♪♪~
Dialogue: 0,1:15:33.34,1:15:34.84,Default,,0,0,0,,​​О?
Dialogue: 0,1:15:37.84,1:15:39.35,Default,,0,0,0,,Ах!
Dialogue: 0,1:15:39.35,1:15:41.35,Default,,0,0,0,,Жылдам құм!
Dialogue: 0,1:15:45.92,1:15:48.42,Default,,0,0,0,,Ку... Шүкір...!
Dialogue: 0,1:15:53.83,1:15:56.33,Default,,0,0,0,,А... аа....
Dialogue: 0,1:16:12.43,1:16:16.85,Default,,0,0,0,,Екі сағат болды. Жәндіктердің саны тек көбейеді.
Dialogue: 0,1:16:16.85,1:16:19.35,Default,,0,0,0,,Ханшайым~!!
Dialogue: 0,1:16:20.35,1:16:23.35,Default,,0,0,0,,Ханшайым~!!
Dialogue: 0,1:16:33.40,1:16:35.84,Default,,0,0,0,,()
Dialogue: 0,1:16:35.84,1:16:38.34,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,1:16:40.34,1:16:42.34,Default,,0,0,0,,()
Dialogue: 0,1:16:44.83,1:16:47.33,Default,,0,0,0,,()
Dialogue: 0,1:16:48.41,1:16:50.41,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,1:17:00.34,1:17:02.84,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,1:17:10.87,1:17:14.87,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,1:17:16.34,1:17:18.84,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,1:17:21.86,1:17:25.86,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,1:17:30.44,1:17:48.87,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,1:17:50.84,1:17:52.84,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,1:17:58.33,1:18:02.33,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,1:18:03.41,1:18:09.86,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,1:18:09.86,1:18:17.90,Default,,0,0,0,,♪♪~
Dialogue: 0,1:18:17.90,1:18:19.90,Default,,0,0,0,,Ки~! Ки~!
Dialogue: 0,1:18:22.84,1:18:24.84,Default,,0,0,0,,Тет….
Dialogue: 0,1:18:28.85,1:18:41.85,Default,,0,0,0,,♪♪~
Dialogue: 0,1:19:25.91,1:19:28.34,Default,,0,0,0,,Біртүрлі жер...
Dialogue: 0,1:19:28.34,1:19:32.33,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,1:19:32.33,1:19:35.85,Default,,0,0,0,,Сәлем! Ақыры таптым.
Dialogue: 0,1:19:35.85,1:19:38.33,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,1:19:38.33,1:19:40.85,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,1:19:40.85,1:19:44.91,Default,,0,0,0,,Алдымен рахмет айтамын. Мен Пежитеден келген Асбелмін.
Dialogue: 0,1:19:44.91,1:19:47.33,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,1:19:47.33,1:19:51.35,Default,,0,0,0,,Мен Жел алқабындағы Наусикамын.
Dialogue: 0,1:19:51.35,1:19:53.85,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,1:19:53.85,1:19:59.84,Default,,0,0,0,,Хахаха... Таңдану табиғи нәрсе. Біз шіріген теңіздің түбінде тұрмыз.
Dialogue: 0,1:19:59.84,1:20:01.86,Default,,0,0,0,,Шіріген теңіз түбі?
Dialogue: 0,1:20:01.86,1:20:05.86,Default,,0,0,0,,Қараңдаршы, ол жерден құммен бірге құлады.
Dialogue: 0,1:20:07.85,1:20:10.35,Default,,0,0,0,,Біз бетперде кимейміз!
Dialogue: 0,1:20:10.35,1:20:13.85,Default,,0,0,0,,Дұрыс, мұнда ауа таза.
Dialogue: 0,1:20:13.85,1:20:18.35,Default,,0,0,0,,Шіріген теңіздің түбінде осындай жер бар екеніне мен де таң қалдым.
Dialogue: 0,1:20:24.93,1:20:26.93,Default,,0,0,0,,Не болды?
Dialogue: 0,1:20:30.84,1:20:32.84,Default,,0,0,0,,Ки~! Ки~!
Dialogue: 0,1:20:32.84,1:20:37.86,Default,,0,0,0,,♪♪~
Dialogue: 0,1:20:37.86,1:20:41.33,Default,,0,0,0,,Наусика! ♪♪~ Алысқа бармаңыз!
Dialogue: 0,1:20:41.33,1:21:01.85,Default,,0,0,0,,♪♪~
Dialogue: 0,1:21:01.85,1:21:04.35,Default,,0,0,0,,♪♪~ Қандай керемет ағаш.
Dialogue: 0,1:21:04.35,1:21:06.84,Default,,0,0,0,,♪♪~
Dialogue: 0,1:21:06.84,1:21:19.35,Default,,0,0,0,,♪♪～ (судың дыбысы)
Dialogue: 0,1:21:19.35,1:21:22.34,Default,,0,0,0,,♪♪~ Ол кеуіп қалса да, оның ішінен су ағады.
Dialogue: 0,1:21:22.34,1:21:56.36,Default,,0,0,0,,♪♪~
Dialogue: 0,1:21:56.36,1:21:59.86,Default,,0,0,0,,♪♪~ Құдық түбіндегі құммен бірдей.
Dialogue: 0,1:21:59.86,1:22:07.37,Default,,0,0,0,,♪♪~
Dialogue: 0,1:22:07.37,1:22:11.89,Default,,0,0,0,,Тасқа айналған ағаштар құлап жатыр ♪♪~ Үйіліп жатыр.
Dialogue: 0,1:22:11.89,1:22:29.86,Default,,0,0,0,,♪♪~
Dialogue: 0,1:22:29.86,1:22:31.84,Default,,0,0,0,,♪♪~ Nausicaä….
Dialogue: 0,1:22:31.84,1:22:35.86,Default,,0,0,0,,♪♪~
Dialogue: 0,1:22:35.86,1:22:37.90,Default,,0,0,0,,♪♪~ Сіз жылап жатырсыз ба?
Dialogue: 0,1:22:37.90,1:22:40.45,Default,,0,0,0,,♪♪~
Dialogue: 0,1:22:40.45,1:22:43.34,Default,,0,0,0,,♪♪~ Иә... Мен бақыттымын.
Dialogue: 0,1:22:43.34,1:22:52.34,Default,,0,0,0,,♪♪~
Dialogue: 0,1:25:01.82,1:25:04.83,Default,,0,0,0,,Ластель менің егіз әпкем.
Dialogue: 0,1:25:04.83,1:25:07.83,Default,,0,0,0,,Мен сенің жаныңда болғым келді.
Dialogue: 0,1:25:07.83,1:25:10.35,Default,,0,0,0,,Кешіріңіз, кешігіп сөйледім.
Dialogue: 0,1:25:10.35,1:25:12.35,Default,,0,0,0,,Жоқ….
Dialogue: 0,1:25:12.35,1:25:14.40,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,1:25:14.40,1:25:17.84,Default,,0,0,0,,Мен әпкемді кіргізген адамды өлтіре жаздадым.
Dialogue: 0,1:25:17.84,1:25:19.83,Default,,0,0,0,,№.
Dialogue: 0,1:25:19.83,1:25:23.33,Default,,0,0,0,,Түсіндім... Ол жел аңғарында ма?
Dialogue: 0,1:25:25.35,1:25:26.85,Default,,0,0,0,,(Оқушы) Қайырлы таң. (Оқушы) Қайырлы таң. Ой, күйіп кеткен екен!
Dialogue: 0,1:25:26.85,1:25:29.85,Default,,0,0,0,,Хмм.
Dialogue: 0,1:25:29.85,1:25:32.87,Default,,0,0,0,,Күлсін... Дәмі біртүрлі жеміс екен.
Dialogue: 0,1:25:32.87,1:25:36.37,Default,,0,0,0,,Чико жаңғағы өте қоректік.
Dialogue: 0,1:25:48.32,1:25:51.84,Default,,0,0,0,,Дәміне қарамастан, көп етік жегім келеді.
Dialogue: 0,1:25:51.84,1:25:53.34,Default,,0,0,0,,Ухуху...
Dialogue: 0,1:26:03.34,1:26:05.85,Default,,0,0,0,,Шірік теңізі осылай туды ма?
Dialogue: 0,1:26:05.85,1:26:08.84,Default,,0,0,0,,Сіз оғаш нәрселер туралы ойлайтын адам сияқтысыз.
Dialogue: 0,1:26:08.84,1:26:12.84,Default,,0,0,0,,Шіріген теңіздің ағаштары бұл дүниені ластаған адамдар→
Dialogue: 0,1:26:12.84,1:26:16.35,Default,,0,0,0,,Мен сұлу болу үшін туғанмын.
Dialogue: 0,1:26:16.35,1:26:19.38,Default,,0,0,0,,Жердің уын денеге қабылдау→
Dialogue: 0,1:26:19.38,1:26:23.86,Default,,0,0,0,,Ол әдемі кристалдарға айналады, содан кейін өледі және құмға айналады.
Dialogue: 0,1:26:23.86,1:26:27.84,Default,,0,0,0,,Бұл жер асты қуысы осылайша пайда болды.
Dialogue: 0,1:26:27.84,1:26:31.83,Default,,0,0,0,,Жәндіктер орманды қорғайды.
Dialogue: 0,1:26:31.83,1:26:34.83,Default,,0,0,0,,Олай болса, құрып кетуден басқа амалымыз жоқ сияқты.
Dialogue: 0,1:26:34.83,1:26:37.35,Default,,0,0,0,,Оған қанша мың жыл қажет екенін білмеймін→
Dialogue: 0,1:26:37.35,1:26:40.85,Default,,0,0,0,,Миазма мен жәндіктерден қорқумен өмір сүру мүмкін емес.
Dialogue: 0,1:26:41.94,1:26:46.35,Default,,0,0,0,,Кем дегенде, бізге сыбайлас жемқорлық теңізінің одан әрі таралуына жол бермеу әдісі қажет.
Dialogue: 0,1:26:46.35,1:26:49.83,Default,,0,0,0,,Сіз де Кушананың сөзін айтасыз.
Dialogue: 0,1:26:49.83,1:26:53.34,Default,,0,0,0,,Жоқ!! Алып құдай сарбаздарын соғыста пайдалану ойымызда жоқ!
Dialogue: 0,1:26:53.34,1:26:55.84,Default,,0,0,0,,Ертең бәріңді көргенде білерсің!
Dialogue: 0,1:26:55.84,1:27:01.89,Default,,0,0,0,,Ұйықтап алайық. Мен ертең көп ұшуым керек...
Dialogue: 0,1:27:01.89,1:27:20.39,Default,,0,0,0,,♪♪~
Dialogue: 0,1:27:24.85,1:27:27.35,Default,,0,0,0,,Ешқандай ауытқулар жоқ! Хмм.
Dialogue: 0,1:27:29.44,1:27:33.44,Default,,0,0,0,,Барлығы жақсы болып жатыр ма? Ха! Менің үстіңгі денем толығымен дерлік мұздатылған.
Dialogue: 0,1:27:56.85,1:28:01.35,Default,,0,0,0,,Қанша қарасам, соншалықты сүйкімді, адам.
Dialogue: 0,1:28:01.35,1:28:03.84,Default,,0,0,0,,Тіпті мен, кедей солдат→
Dialogue: 0,1:28:03.84,1:28:07.34,Default,,0,0,0,,Көптен тот басқан амбициям дірілдеп барады.
Dialogue: 0,1:28:10.36,1:28:12.40,Default,,0,0,0,,Қарғыс атсын! Мен күлемін.
Dialogue: 0,1:28:12.40,1:28:17.35,Default,,0,0,0,,Не болды? Мен ақырзаманға дейін жер астында ұйықтауым керек еді.
Dialogue: 0,1:28:17.35,1:28:21.84,Default,,0,0,0,,Қызметкер! Жоғары мәртебелі құрамға Пежите → қалдықтары шабуыл жасады
Dialogue: 0,1:28:21.84,1:28:24.34,Default,,0,0,0,,Бір корветтен басқасының бәрі жойылды.
Dialogue: 0,1:28:24.34,1:28:26.34,Default,,0,0,0,,Мәртебелімен не болды?
Dialogue: 0,1:28:26.34,1:28:29.34,Default,,0,0,0,,Кеме ауада шашырап кеткен сияқты.
Dialogue: 0,1:28:31.35,1:28:32.85,Default,,0,0,0,,Қызметкер!
Dialogue: 0,1:28:33.90,1:28:36.34,Default,,0,0,0,,Ауыл адамдары әлі байқаған жоқ па?
Dialogue: 0,1:28:36.34,1:28:38.86,Default,,0,0,0,,Иә. Жарайды, мен бірден кетемін.
Dialogue: 0,1:28:38.86,1:28:41.86,Default,,0,0,0,,Қалғандары жұмысын жалғастыру керек. Ха!
Dialogue: 0,1:28:47.83,1:28:52.90,Default,,0,0,0,,Орнынан тұра алмайтын қарапайым адамға тап болғаным бақыт па?
Dialogue: 0,1:28:52.90,1:28:55.90,Default,,0,0,0,,Әлде бұл ақырет тұзағы ма?
Dialogue: 0,1:29:03.85,1:29:06.33,Default,,0,0,0,,Мен қарт Мито мен басқалардың қайтып келгенін естідім.
Dialogue: 0,1:29:06.33,1:29:08.82,Default,,0,0,0,,Мен Юпа-саманы қышқыл көлде күтемін.
Dialogue: 0,1:29:08.82,1:29:29.34,Default,,0,0,0,,♪♪~
Dialogue: 0,1:29:29.34,1:29:32.34,Default,,0,0,0,,Біз ғана қайтып оралғымыз келеді...
Dialogue: 0,1:29:32.34,1:29:35.34,Default,,0,0,0,,Жоқ, мен қауіпсіз болғаныма қуаныштымын.
Dialogue: 0,1:29:38.83,1:29:40.84,Default,,0,0,0,,Шығарылым?
Dialogue: 0,1:29:40.84,1:29:46.32,Default,,0,0,0,,Алып құдай сарбазын қышқыл көлге батырып, еліңізге ораласыз ба?
Dialogue: 0,1:29:46.32,1:29:48.84,Default,,0,0,0,,Аңғарда аз ғана сарбаз қалды.
Dialogue: 0,1:29:48.84,1:29:53.35,Default,,0,0,0,,Қазір күресу оңай, бірақ одан әрі құрбандық мағынасыз.
Dialogue: 0,1:29:53.35,1:29:55.83,Default,,0,0,0,,Оған от та, су да әсер етпейді.
Dialogue: 0,1:29:55.83,1:29:58.84,Default,,0,0,0,,Жүре бастағанша, енді қозғалма.
Dialogue: 0,1:29:58.84,1:30:02.89,Default,,0,0,0,,Түсінбейсіз бе? Енді артқа жол жоқ.
Dialogue: 0,1:30:02.89,1:30:08.83,Default,,0,0,0,,Басқа ел орасан зор күшке ие болады деп қорқып, маған Пежитті ұстау бұйырылды.
Dialogue: 0,1:30:08.83,1:30:11.35,Default,,0,0,0,,Енді оның бар екені белгілі болды→
Dialogue: 0,1:30:11.35,1:30:15.85,Default,,0,0,0,,Ұлы державалар бұл жерге бірінен соң бірі үлкен әскерлер жібереді.
Dialogue: 0,1:30:15.85,1:30:19.84,Default,,0,0,0,,Сізге бір ғана жол қалды.
Dialogue: 0,1:30:19.84,1:30:22.33,Default,,0,0,0,,Алып Құдай Солдатты тірілту→
Dialogue: 0,1:30:22.33,1:30:25.90,Default,,0,0,0,,Ұлы державалардың араласуын жойып, онымен бірге өмір сүр.
Dialogue: 0,1:30:25.90,1:30:27.90,Default,,0,0,0,,Қараңыз.
Dialogue: 0,1:30:32.35,1:30:34.32,Default,,0,0,0,,Жәндіктерге?
Dialogue: 0,1:30:34.32,1:30:38.34,Default,,0,0,0,,Менің болашақ күйеуім одан да сұмдықты көреді.
Dialogue: 0,1:30:38.34,1:30:40.85,Default,,0,0,0,,Шіріген теңізді өртеп, жәндіктерді өлтір→
Dialogue: 0,1:30:40.85,1:30:44.35,Default,,0,0,0,,Неліктен адам әлемін қайтарып алудан тартынасыз?
Dialogue: 0,1:30:44.35,1:30:49.35,Default,,0,0,0,,Менің әскерім Пежитті алғанындай, оны да ал.
Dialogue: 0,1:30:51.86,1:30:55.36,Default,,0,0,0,,Алып құдай сарбаз тірілмейді.
Dialogue: 0,1:30:57.35,1:30:59.35,Default,,0,0,0,,Бұл қиын! Эй! Құпия сөзді айт!
Dialogue: 0,1:30:59.35,1:31:01.33,Default,,0,0,0,,Мен асығыспын! "жел"...
Dialogue: 0,1:31:01.33,1:31:03.34,Default,,0,0,0,,«Алқап»! Жақсы.
Dialogue: 0,1:31:03.34,1:31:05.35,Default,,0,0,0,,Споралар қалды!
Dialogue: 0,1:31:05.35,1:31:06.89,Default,,0,0,0,,(Дарио) Дио, мына жаққа кел. Жөтел, жөтел!
Dialogue: 0,1:31:06.89,1:31:10.39,Default,,0,0,0,,Бұл үлкен миазма шығарады және бүкіл алқап шу болып жатыр!
Dialogue: 0,1:31:18.35,1:31:21.85,Default,,0,0,0,,Оны тапсырыңыз! Асықшы! Маған берші!
Dialogue: 0,1:31:21.85,1:31:24.86,Default,,0,0,0,,Асықпасақ, алқап жойылады!
Dialogue: 0,1:31:24.86,1:31:27.86,Default,,0,0,0,,Маған қол ілгегі мен от бөшкесін беріңіз! Ол тез өсіп жатыр!
Dialogue: 0,1:31:27.86,1:31:31.36,Default,,0,0,0,,Спораларды жағуға арналған құралды қару ретінде де қолдануға болады.
Dialogue: 0,1:31:31.36,1:31:35.45,Default,,0,0,0,,Оған көмектесу мүмкін емес, мылтықтан басқаның бәрін қайтарыңыз. Ха!
Dialogue: 0,1:31:35.45,1:31:38.35,Default,,0,0,0,,Корветте кетіп бара жатыр. Бұл жолы лай емес.
Dialogue: 0,1:31:38.35,1:31:42.84,Default,,0,0,0,,Пежитеде қалған барлық әскерді осы алқапқа шоғырландырыңыз.
Dialogue: 0,1:31:42.84,1:31:46.84,Default,,0,0,0,,Біз қиыншылыққа тап болдық.
Dialogue: 0,1:31:47.85,1:31:49.85,Default,,0,0,0,,Асығыңыз! Асығыңыз!
Dialogue: 0,1:31:52.43,1:31:55.34,Default,,0,0,0,,Ханшайым, өтінемін. Мен алқапты сұраймын →
Dialogue: 0,1:31:55.34,1:31:58.34,Default,,0,0,0,,Мен қайтып келгенше өзіңді күт. иә!
Dialogue: 0,1:32:02.84,1:32:05.34,Default,,0,0,0,,Біз алқапқа барамыз!
Dialogue: 0,1:32:19.86,1:32:22.85,Default,,0,0,0,,Жоқ, мицелий осы жерге дейін жеткен.
Dialogue: 0,1:32:22.85,1:32:24.85,Default,,0,0,0,,Бізге де шабуыл жасалуда!
Dialogue: 0,1:32:26.33,1:32:28.83,Default,,0,0,0,,Кет! Не істеу керек!?
Dialogue: 0,1:32:29.84,1:32:32.34,Default,,0,0,0,,Ах... мұнда да...
Dialogue: 0,1:32:33.36,1:32:35.91,Default,,0,0,0,,Ұлы Баба….
Dialogue: 0,1:32:35.91,1:32:40.33,Default,,0,0,0,,Мына орманды өртеуден басқа амал жоқ. Қазір жақсы емес.
Dialogue: 0,1:32:40.33,1:32:45.34,Default,,0,0,0,,Егер тым кеш болса, алқапты шірік теңізі жұтады.
Dialogue: 0,1:32:45.34,1:32:48.34,Default,,0,0,0,,Бұл қандай да бір жолмен жүзеге аспайды деп үміттенемін.
Dialogue: 0,1:32:48.34,1:32:51.84,Default,,0,0,0,,300 жыл бойы су қоймасын қорғаған орман.
Dialogue: 0,1:32:51.84,1:32:55.34,Default,,0,0,0,,Қарғыс атсын! Олар келмесе...
Dialogue: 0,1:33:02.82,1:33:05.34,Default,,0,0,0,,Бұлай кетпейді.
Dialogue: 0,1:33:05.34,1:33:07.34,Default,,0,0,0,,Біз де барайық.
Dialogue: 0,1:33:20.92,1:33:25.42,Default,,0,0,0,,Мен солай ойлаймын. Мен үшін бұл әдеттегідей көрінеді ...
Dialogue: 0,1:33:26.34,1:33:28.34,Default,,0,0,0,,《Жәндіктер жоқ》
Dialogue: 0,1:33:31.33,1:33:35.35,Default,,0,0,0,,《Қызық, неге? Менің жүрегім қатты соғып тұр》
Dialogue: 0,1:33:35.35,1:33:39.85,Default,,0,0,0,,Бар! Сол таудан өтсем, достарым сонда болады.
Dialogue: 0,1:33:59.83,1:34:03.33,Default,,0,0,0,,Пежите біртүрлі екен... Қызық, бұл не? Сол бұлыңғыр.
Dialogue: 0,1:34:06.89,1:34:09.89,Default,,0,0,0,,Ах! Асбел, маскаңды ки!
Dialogue: 0,1:34:11.84,1:34:14.33,Default,,0,0,0,,Жәндіктер! Өлді...
Dialogue: 0,1:34:14.33,1:34:15.83,Default,,0,0,0,,Пежитеге барыңыз!
Dialogue: 0,1:34:15.83,1:34:19.33,Default,,0,0,0,,Абайлаңыз! Толмекия әскері сонда болуы керек.
Dialogue: 0,1:37:06.38,1:37:45.35,Default,,0,0,0,,♪♪~
Dialogue: 0,1:37:45.35,1:37:46.85,Default,,0,0,0,,♪♪~ Ах...!
Dialogue: 0,1:37:46.85,1:37:56.36,Default,,0,0,0,,♪♪~
Dialogue: 0,1:37:56.36,1:37:58.40,Default,,0,0,0,,Король жәндікке дейін….
Dialogue: 0,1:37:58.40,1:38:01.34,Default,,0,0,0,,Орталық күмбезді жарып...
Dialogue: 0,1:38:01.34,1:38:11.85,Default,,0,0,0,,♪♪~
Dialogue: 0,1:38:11.85,1:38:13.85,Default,,0,0,0,,Пежите аяқталды.
Dialogue: 0,1:38:13.85,1:38:16.88,Default,,0,0,0,,Толмекия әскері жойылса да, бұл...
Dialogue: 0,1:38:16.88,1:38:20.38,Default,,0,0,0,,«жойылды»? Не айтқың келеді? Асбел.
Dialogue: 0,1:38:23.36,1:38:27.86,Default,,0,0,0,,Бриг. Бұл достың кемесі! Түсейік, кеттік!
Dialogue: 0,1:38:39.44,1:38:41.84,Default,,0,0,0,,Асбел! Ол тірі болды ма?
Dialogue: 0,1:38:41.84,1:38:45.35,Default,,0,0,0,,Не істедің! Онымен біз тіпті қалпына келтіре алмаймыз!
Dialogue: 0,1:38:45.35,1:38:47.37,Default,,0,0,0,,Сен қаланы көрдің.
Dialogue: 0,1:38:47.37,1:38:50.84,Default,,0,0,0,,Жарайды. Шірік теңізі сізді жұтып қойса да, оны бірден өртеп жіберуге болады.
Dialogue: 0,1:38:50.84,1:38:53.35,Default,,0,0,0,,Бірақ алып құдай сарбаздары мұнда жоқ.
Dialogue: 0,1:38:53.35,1:38:56.87,Default,,0,0,0,,Мен бұл жел аңғары екенін білемін. Неге олай?
Dialogue: 0,1:38:56.87,1:38:59.93,Default,,0,0,0,,Хахаха... Біз де ойнап жүрген жоқпыз.
Dialogue: 0,1:38:59.93,1:39:02.36,Default,,0,0,0,,Стратегияның екінші кезеңі де іске қосылды →
Dialogue: 0,1:39:02.36,1:39:05.37,Default,,0,0,0,,Жел алқабындағы Толмекия әскері бүгін түнде де жойылады.
Dialogue: 0,1:39:05.37,1:39:06.87,Default,,0,0,0,,Не!?
Dialogue: 0,1:39:06.87,1:39:09.35,Default,,0,0,0,,Аннигиляция не істейді?
Dialogue: 0,1:39:09.35,1:39:11.85,Default,,0,0,0,,Асбел Бұл кім?
Dialogue: 0,1:39:12.86,1:39:16.88,Default,,0,0,0,,Жел алқабындағы Наусика Ол құтқарушы.
Dialogue: 0,1:39:16.88,1:39:18.41,Default,,0,0,0,,Жел аңғары….
Dialogue: 0,1:39:18.41,1:39:20.91,Default,,0,0,0,,Айтыңызшы! Сізде не бар?
Dialogue: 0,1:39:23.85,1:39:27.35,Default,,0,0,0,,Асбел Сіз білесіз бе? маған айт!
Dialogue: 0,1:39:28.86,1:39:31.86,Default,,0,0,0,,Жәндіктер сізге шабуыл жасасын.
Dialogue: 0,1:39:31.86,1:39:35.36,Default,,0,0,0,,Пежитеге шабуыл жасаған сен бе!?
Dialogue: 0,1:39:38.88,1:39:41.38,Default,,0,0,0,,Қандай сұмдық...
Dialogue: 0,1:39:42.95,1:39:45.36,Default,,0,0,0,,Не болса да, тірілмес бұрын →
Dialogue: 0,1:39:45.36,1:39:47.84,Default,,0,0,0,,Біз Алып Құдай сарбазын қайтаруымыз керек.
Dialogue: 0,1:39:47.84,1:39:50.36,Default,,0,0,0,,Бұл әлемді қорғау үшін, түсініңіз.
Dialogue: 0,1:39:50.36,1:39:53.36,Default,,0,0,0,,Сонда сен алқаптағы адамдарды өлтірмексің!?
Dialogue: 0,1:39:53.36,1:39:56.85,Default,,0,0,0,,Тоқта! Енді тоқтат! өтінемін!
Dialogue: 0,1:39:56.85,1:40:01.35,Default,,0,0,0,,Қазірдің өзінде кеш! Сіз жүгіре бастағаннан кейін сізді ешкім тоқтата алмайды.
Dialogue: 0,1:40:03.96,1:40:07.86,Default,,0,0,0,,Толмекия әскерінен қырылып қала жаздадық→
Dialogue: 0,1:40:07.86,1:40:10.36,Default,,0,0,0,,Басқа амал жоқ.
Dialogue: 0,1:40:12.35,1:40:13.85,Default,,0,0,0,,Ұстаңыз!
Dialogue: 0,1:40:17.84,1:40:20.84,Default,,0,0,0,,Жібер! Мені жіберіңізші!!
Dialogue: 0,1:40:24.41,1:40:27.37,Default,,0,0,0,,Қазір қиын болса да, біз алып құдай сарбазын қайтарсақ →
Dialogue: 0,1:40:27.37,1:40:30.35,Default,,0,0,0,,Біз Жемқорлық теңізін өртеп, адам әлемін қалпына келтіре аламыз.
Dialogue: 0,1:40:30.35,1:40:33.35,Default,,0,0,0,,Бұл өтірік! Сендер Толмекия сияқтысыңдар!
Dialogue: 0,1:40:33.35,1:40:36.36,Default,,0,0,0,,Жоқ! Олар оны тек жою үшін пайдаланады.
Dialogue: 0,1:40:36.36,1:40:39.36,Default,,0,0,0,,Бәрің құдықтан су ішесіңдер, солай ма?
Dialogue: 0,1:40:39.36,1:40:42.38,Default,,0,0,0,,Суды кім тазартады деп ойлайсыңдар?
Dialogue: 0,1:40:42.38,1:40:45.95,Default,,0,0,0,,Адамдар көлдер мен өзендерді улы суға айналдырды→
Dialogue: 0,1:40:45.95,1:40:48.84,Default,,0,0,0,,Фукай ағаштары оны таза ұстайды.
Dialogue: 0,1:40:48.84,1:40:50.86,Default,,0,0,0,,Сіз бұл орманды өртеуге тырысасыз ба?
Dialogue: 0,1:40:50.86,1:40:53.84,Default,,0,0,0,,Алып құдай сарбаздарын қазып ала алмайсың!
Dialogue: 0,1:40:53.84,1:40:55.86,Default,,0,0,0,,Сонымен не істеуіміз керек!?
Dialogue: 0,1:40:55.86,1:40:58.35,Default,,0,0,0,,Сіз Торумекияның бұйрығын орындауды жалғастыра бересіз бе?
Dialogue: 0,1:40:58.35,1:41:01.35,Default,,0,0,0,,Жоқ! басқа! Асбел бәріне айт!
Dialogue: 0,1:41:01.35,1:41:05.40,Default,,0,0,0,,Шірік теңізінің пайда болу себебі! Жәндіктер әлемді қорғайды!
Dialogue: 0,1:41:05.40,1:41:07.90,Default,,0,0,0,,Асбел, өтінемін!
Dialogue: 0,1:41:09.36,1:41:11.84,Default,,0,0,0,,Сіз не істейсіз!? Қозғалма!
Dialogue: 0,1:41:11.84,1:41:13.86,Default,,0,0,0,,Мына баланы жібер!
Dialogue: 0,1:41:13.86,1:41:15.85,Default,,0,0,0,,Сабыр ет, Асбел! (мылтық)
Dialogue: 0,1:41:15.85,1:41:18.83,Default,,0,0,0,,Мен байсалдымын! Менен қолдарыңды ал!
Dialogue: 0,1:41:18.83,1:41:21.35,Default,,0,0,0,,Наусика Барлығына айт!
Dialogue: 0,1:41:21.35,1:41:22.85,Default,,0,0,0,,Ах! Ах!!
Dialogue: 0,1:41:26.94,1:41:29.44,Default,,0,0,0,,Асбел! Жіберу!
Dialogue: 0,1:41:39.84,1:41:41.34,Default,,0,0,0,,Ах!
Dialogue: 0,1:41:48.86,1:41:54.86,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:42:01.36,1:42:03.36,Default,,0,0,0,,Ақымақ...
Dialogue: 0,1:42:06.85,1:42:09.37,Default,,0,0,0,,Басталған нәрсеге ештеңе істеуге болмайды.
Dialogue: 0,1:42:09.37,1:42:11.85,Default,,0,0,0,,Бірақ маған абай болу керектігін айтты...
Dialogue: 0,1:42:11.85,1:42:13.35,Default,,0,0,0,,Қобалжымаңыз →
Dialogue: 0,1:42:13.35,1:42:15.39,Default,,0,0,0,,Танктері бар жауынгерлерді құтқарыңыз! Ха!
Dialogue: 0,1:42:15.39,1:42:17.94,Default,,0,0,0,,Қызметкер! Соңғысы жеңілді!
Dialogue: 0,1:42:17.94,1:42:20.34,Default,,0,0,0,,Сіз осында келесіз бе? Мен түсінбедім.
Dialogue: 0,1:42:20.34,1:42:22.35,Default,,0,0,0,,Бүкіл ауыл жиналып жатыр.
Dialogue: 0,1:42:22.35,1:42:26.33,Default,,0,0,0,,Жоқ, бір-екі орманда кісі өлтіретін көңіл-күй бар.
Dialogue: 0,1:42:26.33,1:42:28.35,Default,,0,0,0,,Бұл Пежитенің екінші толқыны... Әй?
Dialogue: 0,1:42:28.35,1:42:30.35,Default,,0,0,0,,Иә?
Dialogue: 0,1:42:30.35,1:42:32.34,Default,,0,0,0,,Урья~! Жақсы.
Dialogue: 0,1:42:32.34,1:42:33.84,Default,,0,0,0,,Уау!!
Dialogue: 0,1:42:34.86,1:42:36.86,Default,,0,0,0,,Уау!!
Dialogue: 0,1:42:38.43,1:42:40.43,Default,,0,0,0,,Мен танкті алдым!
Dialogue: 0,1:42:41.85,1:42:44.85,Default,,0,0,0,,Тез қозғал! Бұл туралы алаңдамаңыз.
Dialogue: 0,1:42:44.85,1:42:47.86,Default,,0,0,0,,Уау! Міне келдік!
Dialogue: 0,1:42:47.86,1:42:49.36,Default,,0,0,0,,Алдыңғы!!
Dialogue: 0,1:42:51.36,1:42:54.36,Default,,0,0,0,,Сәлем, тезірек! Бұл ма?
Dialogue: 0,1:42:55.86,1:42:57.40,Default,,0,0,0,,О, қозғалды!
Dialogue: 0,1:42:57.40,1:42:59.90,Default,,0,0,0,,Сіз қай жолмен барасыз?
Dialogue: 0,1:43:05.34,1:43:09.34,Default,,0,0,0,,Алға! Алға жүр! Мен түссіндім.
Dialogue: 0,1:43:18.84,1:43:21.39,Default,,0,0,0,,Қат! Барлық танктерді шығарыңыз!
Dialogue: 0,1:43:21.39,1:43:22.89,Default,,0,0,0,,Қандай да бір себепті,
Dialogue: 0,1:43:24.46,1:43:27.36,Default,,0,0,0,,А... ол тірі еді.
Dialogue: 0,1:43:27.36,1:43:30.36,Default,,0,0,0,,Бұл қысқа түс еді...
Dialogue: 0,1:43:30.36,1:43:31.86,Default,,0,0,0,,Мәртебелі!
Dialogue: 0,1:43:35.85,1:43:40.86,Default,,0,0,0,,Біз оны тоқтатамыз. Барлығын қышқыл көлге эвакуациялаңыз.
Dialogue: 0,1:43:40.86,1:43:42.36,Default,,0,0,0,,Олар үшін де тойып жеңіздер
Dialogue: 0,1:43:43.93,1:43:47.43,Default,,0,0,0,,Ханшайым оқпен оралғанша шыдамды болыңыз!
Dialogue: 0,1:43:50.85,1:43:53.85,Default,,0,0,0,,Барлығы асығыңыз! Асықшы!
Dialogue: 0,1:43:53.85,1:43:57.85,Default,,0,0,0,,Уайымдамаңыз, сіз де көмектесе аласыз! Менің арқам қатты.
Dialogue: 0,1:43:59.34,1:44:02.34,Default,,0,0,0,,Міне! Танк келді!
Dialogue: 0,1:44:04.87,1:44:08.44,Default,,0,0,0,,Асығыңыз! Түсінемін, бірақ қазір.
Dialogue: 0,1:44:08.44,1:44:10.35,Default,,0,0,0,,(мылтық шуы)
Dialogue: 0,1:44:10.35,1:44:12.35,Default,,0,0,0,,Уау!!
Dialogue: 0,1:44:13.87,1:44:16.37,Default,,0,0,0,,(мылтық шуы)
Dialogue: 0,1:46:59.36,1:47:01.86,Default,,0,0,0,,(Endeavour) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,1:47:01.86,1:47:04.35,Default,,0,0,0,,Сіз сенімдісіз бе? Бриг Пежите.
Dialogue: 0,1:47:04.35,1:47:07.35,Default,,0,0,0,,Мен оны әлгі бұлттардың арғы жағынан көрдім. Жақсы!
Dialogue: 0,1:47:21.36,1:47:24.36,Default,,0,0,0,,≪Сақ болыңыз, ол дәл қазір зорлық көрсетті...≫
Dialogue: 0,1:47:30.87,1:47:32.87,Default,,0,0,0,,Асығыңыз.
Dialogue: 0,1:47:34.38,1:47:36.93,Default,,0,0,0,,Наусика-сан, мен сені бұл жерден алып кетемін.
Dialogue: 0,1:47:36.93,1:47:38.85,Default,,0,0,0,,Барып, аңғарға айт.
Dialogue: 0,1:47:38.85,1:47:41.85,Default,,0,0,0,,Сіздің батпырауық әлі де уақытында жетуі мүмкін→
Dialogue: 0,1:47:41.85,1:47:44.37,Default,,0,0,0,,Дайындалды.
Dialogue: 0,1:47:44.37,1:47:47.37,Default,,0,0,0,,Барлығы Асбелден естіді.
Dialogue: 0,1:47:47.37,1:47:50.37,Default,,0,0,0,,Мен сенің орнын басатын боламын, сондықтан мұны тез істе.
Dialogue: 0,1:47:50.37,1:47:51.86,Default,,0,0,0,,Мен тастап кеткен құралдар—
Dialogue: 0,1:47:51.86,1:47:53.86,Default,,0,0,0,,Ластельдің анасы.
Dialogue: 0,1:47:55.91,1:47:57.95,Default,,0,0,0,,Ана….
Dialogue: 0,1:47:57.95,1:48:00.35,Default,,0,0,0,,Мен шынымен кешірім сұраймын.
Dialogue: 0,1:48:00.35,1:48:03.35,Default,,0,0,0,,Біздің істегеніміздің бәрі қате болды.
Dialogue: 0,1:48:03.35,1:48:04.85,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,1:48:12.36,1:48:15.36,Default,,0,0,0,,Бұл туралы не деуге болады? Жарайды, уайымдама.
Dialogue: 0,1:48:20.85,1:48:24.88,Default,,0,0,0,,Абайлаңыз. Менің қорқынышты емім үшін кешіріңіз.
Dialogue: 0,1:48:24.88,1:48:27.36,Default,,0,0,0,,Наусика Осы жолмен! Кәне!
Dialogue: 0,1:48:27.36,1:48:28.86,Default,,0,0,0,,Жүгір!
Dialogue: 0,1:48:29.85,1:48:32.35,Default,,0,0,0,,Барлығыңызға рахмет.
Dialogue: 0,1:48:34.35,1:48:36.85,Default,,0,0,0,,Кешіріңіз, кешігіп қалдым.
Dialogue: 0,1:48:38.42,1:48:41.42,Default,,0,0,0,,Біз осы жерден ұша аламыз ба? Мен тырысамын.
Dialogue: 0,1:48:48.87,1:48:50.37,Default,,0,0,0,,Корветт!?
Dialogue: 0,1:48:50.37,1:48:53.37,Default,,0,0,0,,Уау!
Dialogue: 0,1:48:53.37,1:48:56.37,Default,,0,0,0,,Эвакуациялаңыз! Бұлттарға асығыңыз!
Dialogue: 0,1:49:00.86,1:49:02.36,Default,,0,0,0,,«Тоқта» қалай атуға болады!
Dialogue: 0,1:49:07.35,1:49:10.85,Default,,0,0,0,,Ақымақ! Бұлттың ішінде турбуленттілік пен электр тогы бар!
Dialogue: 0,1:49:15.88,1:49:18.38,Default,,0,0,0,,Жоқ! Мен басқара алмаймын!!
Dialogue: 0,1:49:19.35,1:49:22.85,Default,,0,0,0,,Уау! Кя~!
Dialogue: 0,1:49:26.85,1:49:28.86,Default,,0,0,0,,Кеме ыдырап кетеді!
Dialogue: 0,1:49:28.86,1:49:32.36,Default,,0,0,0,,Барлығына менің таңдауым жоқ! Бұлттардың арасынан шығып, күресіңіз!
Dialogue: 0,1:49:37.87,1:49:39.87,Default,,0,0,0,,Ах! Мен оны оқып едім!
Dialogue: 0,1:49:48.36,1:49:50.38,Default,,0,0,0,,Қат! Сіз не істеуді жоспарлап отырсыз!?
Dialogue: 0,1:49:50.38,1:49:52.88,Default,,0,0,0,,Бұлттар! Мен өзімді бұлттарға қарсы итеріп, оларға мінгім келеді!
Dialogue: 0,1:50:06.46,1:50:08.86,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:50:08.86,1:50:11.85,Default,,0,0,0,,Олар келе жатыр! Енді секіретін уақыт!
Dialogue: 0,1:50:11.85,1:50:13.87,Default,,0,0,0,,Жоқ, мен де қаламын!
Dialogue: 0,1:50:13.87,1:50:17.37,Default,,0,0,0,,Мен сені жалғыз қалдыра алмаймын, менің орнымды алған анашым!
Dialogue: 0,1:50:17.37,1:50:19.86,Default,,0,0,0,,Тек сен ғана алқап халқын құтқара аласың!
Dialogue: 0,1:50:19.86,1:50:23.38,Default,,0,0,0,,Барыңыз! Бізге барыңыз!
Dialogue: 0,1:50:23.38,1:50:24.90,Default,,0,0,0,,Ах!
Dialogue: 0,1:50:24.90,1:50:29.40,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:50:34.35,1:50:38.35,Default,,0,0,0,,Кемені ал, тұтқынға алма, тамырын кес!
Dialogue: 0,1:50:42.85,1:50:45.85,Default,,0,0,0,,Бар, Наусика! Бар!
Dialogue: 0,1:50:45.85,1:50:47.35,Default,,0,0,0,,Асбел!
Dialogue: 0,1:50:47.35,1:51:44.86,Default,,0,0,0,,♪♪~
Dialogue: 0,1:51:44.86,1:51:46.86,Default,,0,0,0,,Ханшайым~!!
Dialogue: 0,1:51:47.86,1:51:49.36,Default,,0,0,0,,Мито!
Dialogue: 0,1:51:50.35,1:51:51.85,Default,,0,0,0,,(бомба дыбысы)
Dialogue: 0,1:51:51.85,1:51:53.35,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:51:56.85,1:51:58.85,Default,,0,0,0,,Хяхо~!
Dialogue: 0,1:52:03.46,1:52:07.36,Default,,0,0,0,,Мито! Құрметті Юпа! Ханшайым~!
Dialogue: 0,1:52:07.36,1:52:10.35,Default,,0,0,0,,Асығыңыздар, бәріңіз... бәріңіз!
Dialogue: 0,1:52:10.35,1:52:12.85,Default,,0,0,0,,Енді ұстау ілмегін шығарыңыз!
Dialogue: 0,1:52:12.85,1:52:15.35,Default,,0,0,0,,Құрметті Юпа, оң жақтағы қызыл тұтқаны басыңыз!
Dialogue: 0,1:52:20.86,1:52:23.86,Default,,0,0,0,,Бұл жалғыз орын қалды. Асығыңыз!
Dialogue: 0,1:52:28.35,1:52:31.36,Default,,0,0,0,,Есік сынып қалады!
Dialogue: 0,1:52:31.36,1:52:35.36,Default,,0,0,0,,Кез келген уақытта келіңіз! Мен саған Пежитенің мақтанышын көрсетемін!
Dialogue: 0,1:52:37.36,1:52:40.36,Default,,0,0,0,,Бұл не? құс...?
Dialogue: 0,1:52:40.36,1:52:44.36,Default,,0,0,0,,Кеме! Жел алқабының зеңбіректері! Не!?
Dialogue: 0,1:52:47.35,1:52:49.35,Default,,0,0,0,,Иә, мен қазір сонда барамын.
Dialogue: 0,1:52:52.88,1:52:55.38,Default,,0,0,0,,Сен... Уау!!
Dialogue: 0,1:52:57.36,1:52:58.86,Default,,0,0,0,,Уау!!
Dialogue: 0,1:53:01.87,1:53:04.87,Default,,0,0,0,,Бұл Юпа! Оны жеңіп, атын шығар!
Dialogue: 0,1:53:06.86,1:53:08.36,Default,,0,0,0,,О!
Dialogue: 0,1:53:12.85,1:53:16.37,Default,,0,0,0,,Беріңіз! Корвет ешқашан қайтып келмейді.
Dialogue: 0,1:53:16.37,1:53:17.87,Default,,0,0,0,,Бір… күшті….
Dialogue: 0,1:53:21.89,1:53:25.96,Default,,0,0,0,,Ханшайым! Бұл ақылсыз! Қозғалтқыш жарылып кетеді!
Dialogue: 0,1:53:25.96,1:53:28.96,Default,,0,0,0,,Жай ғана аңғарға апарыңыз! Оны 300-ге дейін жеткізіңіз!
Dialogue: 0,1:53:30.85,1:53:35.87,Default,,0,0,0,,Тәңірім, желдің құдайы, бәріңді қорғай көр.
Dialogue: 0,1:53:35.87,1:53:54.37,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,1:53:54.37,1:53:57.37,Default,,0,0,0,,Ол рычагпен де қозғалмайтын сияқты.
Dialogue: 0,1:53:57.37,1:54:00.84,Default,,0,0,0,,Мен сенің қайтуыңды күтемін. қайтару?
Dialogue: 0,1:54:00.84,1:54:03.85,Default,,0,0,0,,Мен ол қыздың мылтықпен оралатынына сенемін.
Dialogue: 0,1:54:03.85,1:54:08.39,Default,,0,0,0,,Атқыштар қиын. Қазір соққы алғыңыз келе ме?
Dialogue: 0,1:54:08.39,1:54:10.94,Default,,0,0,0,,Сіз бұл кеменің не екенін білесіз бе?
Dialogue: 0,1:54:10.94,1:54:13.84,Default,,0,0,0,,Ол «Жеті күндік оттан» бұрын жаратылған ғой, солай ма?
Dialogue: 0,1:54:13.84,1:54:17.86,Default,,0,0,0,,Өтірік пе, рас па білмеймін, бірақ мен оның жұлдыздарға барғанын естідім.
Dialogue: 0,1:54:17.86,1:54:22.37,Default,,0,0,0,,Қиындығы сонша, оған зеңбірек те жұмыс істемейді, бірақ оны шұңқырға соғып кетсең ше...
Dialogue: 0,1:54:22.37,1:54:24.85,Default,,0,0,0,,Менің де күткім келеді. иә?
Dialogue: 0,1:54:24.85,1:54:29.39,Default,,0,0,0,,Шіріген теңіздің тереңінен тірі оралсам ғой...
Dialogue: 0,1:54:29.39,1:54:33.39,Default,,0,0,0,,Мен сол қызбен жайбарақат сөйлескім келді.
Dialogue: 0,1:54:36.35,1:54:38.87,Default,,0,0,0,,Сіз қалай ойлайсыз? Сіз шешім қабылдадыңыз ба?
Dialogue: 0,1:54:38.87,1:54:42.85,Default,,0,0,0,,Барып, берілуін сұрасаң, мен сені жіберемін.
Dialogue: 0,1:54:42.85,1:54:45.86,Default,,0,0,0,,Пежитенің екіншісі болғың келе ме!
Dialogue: 0,1:54:45.86,1:54:51.88,Default,,0,0,0,,Сіз ханшайым болуыңыз мүмкін, бірақ сіз біздікінен мүлдем басқасыз.
Dialogue: 0,1:54:51.88,1:54:56.87,Default,,0,0,0,,Мына қолға қараңдар. Бұл Джил-сама сияқты ауру →
Dialogue: 0,1:54:56.87,1:55:00.85,Default,,0,0,0,,Жарты жылдан кейін тастай бірдей боласың.
Dialogue: 0,1:55:00.85,1:55:06.34,Default,,0,0,0,,Джага Менің ханшайымым мұндай нәрсені ұнататынын айтады.
Dialogue: 0,1:55:06.34,1:55:11.38,Default,,0,0,0,,Қолы әдемі еңбекшім деді.
Dialogue: 0,1:55:11.38,1:55:16.37,Default,,0,0,0,,Шірік теңізінің уы сізді жұқтырған болса да, сіз әлі де онымен өмір сүресіз бе?
Dialogue: 0,1:55:16.37,1:55:18.34,Default,,0,0,0,,Сіз отты пайдаланасыз.
Dialogue: 0,1:55:18.34,1:55:21.34,Default,,0,0,0,,Жарайды, біз де аздап қолданамыз.
Dialogue: 0,1:55:21.34,1:55:27.86,Default,,0,0,0,,Өте көп от ештеңе бермейді; Өрт бір күнде орманды күлге айналдырады.
Dialogue: 0,1:55:27.86,1:55:31.90,Default,,0,0,0,,Су мен жел орманды өсіру үшін жүз жыл қажет.
Dialogue: 0,1:55:31.90,1:55:34.96,Default,,0,0,0,,Біз су мен желді жақсы көреміз.
Dialogue: 0,1:55:34.96,1:55:38.96,Default,,0,0,0,,Ханшайым сол орманды көрсе, мұңаяды.
Dialogue: 0,1:55:40.86,1:55:43.36,Default,,0,0,0,,Бас штаб, сіз әлі бұйрықтарыңызды алдыңыз ба?
Dialogue: 0,1:55:43.36,1:55:45.36,Default,,0,0,0,,Бас тарту. иә.
Dialogue: 0,1:55:49.35,1:55:53.34,Default,,0,0,0,,Не болғанын білмеймін, бірақ өте сүйкімді болып шықты...
Dialogue: 0,1:55:53.34,1:55:56.41,Default,,0,0,0,,Кротова Бұл адамдарды жіберіңіз.
Dialogue: 0,1:55:56.41,1:55:58.96,Default,,0,0,0,,Иә!? Сонымен, күткіңіз келе ме?
Dialogue: 0,1:55:58.96,1:56:02.96,Default,,0,0,0,,Сарбаздарыңызды тамақтандырыңыз. Шабуыл 1 сағаттан кейін басталады.
Dialogue: 0,1:56:05.35,1:56:08.86,Default,,0,0,0,,Эй, сен асықпай жегің келе ме?
Dialogue: 0,1:56:08.86,1:56:10.86,Default,,0,0,0,,Иә? Біреу келе жатыр!
Dialogue: 0,1:56:12.84,1:56:14.34,Default,,0,0,0,,Гол және басқалар.
Dialogue: 0,1:56:15.36,1:56:16.86,Default,,0,0,0,,Иә?
Dialogue: 0,1:56:17.86,1:56:19.87,Default,,0,0,0,,Не болды?
Dialogue: 0,1:56:19.87,1:56:21.90,Default,,0,0,0,,Жел жоқ.
Dialogue: 0,1:56:21.90,1:56:23.40,Default,,0,0,0,,Жел?
Dialogue: 0,1:56:24.45,1:56:27.45,Default,,0,0,0,,Негізі жел тоқтады.
Dialogue: 0,1:56:28.36,1:56:31.36,Default,,0,0,0,,Баба, не болды? Ұлы Баба...
Dialogue: 0,1:56:31.36,1:56:36.36,Default,,0,0,0,,Біреу... біреу мені сыртқа шығарып салшы...
Dialogue: 0,1:56:42.87,1:56:45.37,Default,,0,0,0,,Бұл жел бірінші рет тоқтады.
Dialogue: 0,1:56:49.86,1:56:59.36,Default,,0,0,0,,Ауа кернеулі.
Dialogue: 0,1:56:59.36,1:57:02.36,Default,,0,0,0,,Құрметті Баба, Құлағым ауырды.
Dialogue: 0,1:57:02.36,1:57:06.86,Default,,0,0,0,,Атмосфера... Атмосфера ашуға толы.
Dialogue: 0,1:57:21.85,1:57:23.35,Default,,0,0,0,,Өте жақын!
Dialogue: 0,1:57:23.35,1:57:26.35,Default,,0,0,0,,Шірік теңізі тазартылды! Қышқылды көлге 3 минут!
Dialogue: 0,1:57:26.35,1:57:29.85,Default,,0,0,0,,Қозғалтқыш баяу! Бұлттардың астына түсіңіз!
Dialogue: 0,1:57:38.35,1:57:40.85,Default,,0,0,0,,Не? Бұл жарық.
Dialogue: 0,1:57:42.37,1:57:43.87,Default,,0,0,0,,Король жәндік!
Dialogue: 0,1:58:01.37,1:58:05.36,Default,,0,0,0,,Шірік теңізі толып жатыр! Жел алқабына бару!
Dialogue: 0,1:58:05.36,1:58:07.84,Default,,0,0,0,,Неліктен... патша жәндігін... қалай алдың?
Dialogue: 0,1:58:07.84,1:58:09.34,Default,,0,0,0,,Ха!
Dialogue: 0,1:58:13.85,1:58:16.40,Default,,0,0,0,,Біреу отарды шақырып жатыр.
Dialogue: 0,1:58:16.40,1:58:20.40,Default,,0,0,0,,Мито! Сириусқа қарай ұшыңыз! Ха... Иә!
Dialogue: 0,1:58:47.86,1:58:50.87,Default,,0,0,0,,Міне! Мито жарықтандырғыш оқ!
Dialogue: 0,1:58:50.87,1:58:54.87,Default,,0,0,0,,Эй... ат!
Dialogue: 0,1:58:59.86,1:59:01.86,Default,,0,0,0,,Не? Міне бітті.
Dialogue: 0,1:59:04.43,1:59:05.93,Default,,0,0,0,,Ах!
Dialogue: 0,1:59:12.86,1:59:14.87,Default,,0,0,0,,Қандай сұмдық...
Dialogue: 0,1:59:14.87,1:59:17.86,Default,,0,0,0,,Мен ол жігітті отарды тарту үшін жем ретінде пайдаланып жатырмын.
Dialogue: 0,1:59:17.86,1:59:21.87,Default,,0,0,0,,Тәтті, мен сені құлатамын! Жоқ!!
Dialogue: 0,1:59:21.87,1:59:23.35,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:59:23.35,1:59:25.85,Default,,0,0,0,,Атпа! Мито тоқтат!
Dialogue: 0,1:59:29.92,1:59:32.36,Default,,0,0,0,,Неге? Неге мені атып тастамайсың!
Dialogue: 0,1:59:32.36,1:59:35.36,Default,,0,0,0,,Егер сіз патша жәндіктің баласын өлтірсеңіз, шабуыл ешқашан тоқтамайды!
Dialogue: 0,1:59:35.36,1:59:38.87,Default,,0,0,0,,Мен не істеуім керек! Бұлай жалғаса берсе, алқап жойылады!
Dialogue: 0,1:59:38.87,1:59:42.87,Default,,0,0,0,,Сабыр ет, Мито, жәндік патшаның баласын отарға қайтар! Байқап көріңіз!
Dialogue: 0,1:59:50.44,1:59:52.36,Default,,0,0,0,,Не істеп жатырсың, ханшайым?
Dialogue: 0,1:59:52.36,1:59:54.36,Default,,0,0,0,,Мито бәріне хабарлаңыз!
Dialogue: 0,1:59:55.37,1:59:59.37,Default,,0,0,0,,Ханшайым~! Қарусыз... Ах!
Dialogue: 0,2:00:10.46,2:00:13.37,Default,,0,0,0,,Бұл біздің әскерилер үшін алау емес. Қашықтық қанша?
Dialogue: 0,2:00:13.37,2:00:16.37,Default,,0,0,0,,Шамамен 20 лига Бұл көлдің арғы жағында жатқан сияқты.
Dialogue: 0,2:00:16.37,2:00:19.37,Default,,0,0,0,,Қалай ойлайсың, бұл қару-жарақ па? бәлкім.
Dialogue: 0,2:00:26.86,2:00:30.95,Default,,0,0,0,,Бұл көмек сұрайтын белгі. Ақыр аяғында бұл қару-жарақ.
Dialogue: 0,2:00:30.95,2:00:34.37,Default,,0,0,0,,Бір сағат болды. Барайық. Неге күтпейсің?
Dialogue: 0,2:00:34.37,2:00:36.87,Default,,0,0,0,,Қанды жол.
Dialogue: 0,2:00:38.88,2:00:43.36,Default,,0,0,0,,♪♪~
Dialogue: 0,2:00:43.36,2:00:45.35,Default,,0,0,0,,♪♪~ (Капитан) Бронды жауынгер, алға!
Dialogue: 0,2:00:45.35,2:00:49.90,Default,,0,0,0,,♪♪~
Dialogue: 0,2:00:49.90,2:00:52.86,Default,,0,0,0,,Мәртебелі ішке кіреді. ♪♪~ Бұл жақсы.
Dialogue: 0,2:00:52.86,2:00:59.36,Default,,0,0,0,,♪♪~
Dialogue: 0,2:00:59.36,2:01:01.85,Default,,0,0,0,,♪♪~ Иә? Бұл зеңбірек!
Dialogue: 0,2:01:01.85,2:01:04.37,Default,,0,0,0,,♪♪~
Dialogue: 0,2:01:04.37,2:01:06.35,Default,,0,0,0,,♪♪~ Әуе шабуылы~!
Dialogue: 0,2:01:06.35,2:01:13.85,Default,,0,0,0,,♪♪~
Dialogue: 0,2:01:15.35,2:01:18.85,Default,,0,0,0,,Атпа! Тоқташы... тоқта!
Dialogue: 0,2:01:21.35,2:01:23.87,Default,,0,0,0,,Қат! Ханшайым~!
Dialogue: 0,2:01:23.87,2:01:26.87,Default,,0,0,0,,Осы жерде күтіңіз! От қоймаңыз!
Dialogue: 0,2:01:26.87,2:01:28.37,Default,,0,0,0,,Мәртебелі!?
Dialogue: 0,2:01:32.43,2:01:34.46,Default,,0,0,0,,Ол қызға не болды? Ал ханшайым ше?
Dialogue: 0,2:01:34.46,2:01:36.35,Default,,0,0,0,,Артқы жағында жүрме.
Dialogue: 0,2:01:36.35,2:01:38.84,Default,,0,0,0,,Бұл патша жәндігі! Корольдік жәндіктердің тобы осы жолмен келе жатыр!
Dialogue: 0,2:01:38.84,2:01:41.37,Default,,0,0,0,,Не!? Король Муши!?
Dialogue: 0,2:01:41.37,2:01:44.84,Default,,0,0,0,,Қашқынды тоқтату үшін ханшайым жалғыз қалды →
Dialogue: 0,2:01:44.84,2:01:47.36,Default,,0,0,0,,Соғысқа уақыт жоқ!
Dialogue: 0,2:01:47.36,2:01:50.36,Default,,0,0,0,,Барлығыңыз, жоғарырақ жерге жүгіріңіздер! Асығыңыз!
Dialogue: 0,2:01:53.42,2:01:56.92,Default,,0,0,0,,Әй, Баба, мен қызыл шамды көріп тұрмын.
Dialogue: 0,2:01:59.36,2:02:02.84,Default,,0,0,0,,Барған сайын көбейіп бара жатқан сияқты. Мен осында келе жатырмын.
Dialogue: 0,2:02:02.84,2:02:05.85,Default,,0,0,0,,Бабаны қатты ұстаңыз.
Dialogue: 0,2:02:05.85,2:02:10.35,Default,,0,0,0,,Егер бұл орын алса, оны ешкім тоқтата алмайды.
Dialogue: 0,2:02:11.37,2:02:15.92,Default,,0,0,0,,Дүрбелең емес! Әлі де жақсы!
Dialogue: 0,2:02:15.92,2:02:20.36,Default,,0,0,0,,Мито Егер бәрібір өлетін болсаң, алқапта өлесің.
Dialogue: 0,2:02:20.36,2:02:24.35,Default,,0,0,0,,Жоқ! Ханшайым бас тартпаса, берілме.
Dialogue: 0,2:02:24.35,2:02:28.85,Default,,0,0,0,,Жарайды, маған мүмкіндігінше көп уақыт беріңіз. Мен бірден қайтамын.
Dialogue: 0,2:02:28.85,2:02:32.37,Default,,0,0,0,,Мәртебелі мырза, мен мұндайды күтпедім... Әлі ерте!
Dialogue: 0,2:02:32.37,2:02:36.37,Default,,0,0,0,,Егер сіз оны қазір қолданбасаңыз, оны қашан қолдану керек? Бар!
Dialogue: 0,2:02:37.94,2:02:40.86,Default,,0,0,0,,(оқ ату)
Dialogue: 0,2:02:40.86,2:02:44.37,Default,,0,0,0,,Атпа! Мені тыңдаңдар!! (мылтық)
Dialogue: 0,2:02:44.37,2:02:47.85,Default,,0,0,0,,(оқ ату)
Dialogue: 0,2:02:47.85,2:02:50.85,Default,,0,0,0,,(мылтық шуы)
Dialogue: 0,2:02:57.41,2:02:59.85,Default,,0,0,0,,Қат! Ол құс сияқты.
Dialogue: 0,2:02:59.85,2:03:02.85,Default,,0,0,0,,Ол адам жау емес. Ол бірдеңе деп айғайлап жатты.
Dialogue: 0,2:03:02.85,2:03:05.37,Default,,0,0,0,,Стратегияға кедергі келтіретін адам – жау→
Dialogue: 0,2:03:05.37,2:03:09.37,Default,,0,0,0,,Оториді тез арада аңғарға тастамасақ, бізге қауіп төнеді.
Dialogue: 0,2:03:12.86,2:03:15.86,Default,,0,0,0,,Бұл келе жатыр! Оны жақсылап тартып, содан кейін түсіріңіз.
Dialogue: 0,2:03:19.85,2:03:21.35,Default,,0,0,0,,Капитан Магатоға не деп тұрсың!!
Dialogue: 0,2:03:21.35,2:03:23.84,Default,,0,0,0,,♪♪~
Dialogue: 0,2:03:23.84,2:03:25.86,Default,,0,0,0,,♪♪~ Ах….
Dialogue: 0,2:03:25.86,2:03:28.34,Default,,0,0,0,,♪♪~
Dialogue: 0,2:03:28.34,2:03:31.35,Default,,0,0,0,,Енді ат! ♪♪~ Маған ұнамайды!
Dialogue: 0,2:03:31.35,2:03:33.87,Default,,0,0,0,,Ластель мырза!? ♪♪~ Жолдан кет!
Dialogue: 0,2:03:33.87,2:03:35.90,Default,,0,0,0,,♪♪~
Dialogue: 0,2:03:35.90,2:03:38.45,Default,,0,0,0,,Уф!
Dialogue: 0,2:03:38.45,2:03:39.95,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,2:04:07.87,2:04:09.37,Default,,0,0,0,,Ки~!
Dialogue: 0,2:04:10.35,2:04:12.85,Default,,0,0,0,,Ки~! Ки~!
Dialogue: 0,2:04:14.37,2:04:15.87,Default,,0,0,0,,Ки~!
Dialogue: 0,2:04:20.85,2:04:23.35,Default,,0,0,0,,Король жәндік... Уф!
Dialogue: 0,2:04:48.91,2:04:51.96,Default,,0,0,0,,Ашуланба, қорықпа.
Dialogue: 0,2:04:51.96,2:04:54.46,Default,,0,0,0,,Мен сенің жауың емеспін.
Dialogue: 0,2:04:55.87,2:05:01.85,Default,,0,0,0,,Кешіріңіз... Кешіріңіз. Мен сені кешірдім деп айта алмаймын.
Dialogue: 0,2:05:01.85,2:05:04.35,Default,,0,0,0,,Бұл өте жаман.
Dialogue: 0,2:05:13.95,2:05:17.37,Default,,0,0,0,,Қозғалмаңыз! Дене сұйықтықтары шығады!
Dialogue: 0,2:05:17.37,2:05:19.87,Default,,0,0,0,,Қозғалма, сен жақсы қызсың.
Dialogue: 0,2:05:22.36,2:05:23.86,Default,,0,0,0,,Ах!
Dialogue: 0,2:05:29.35,2:05:32.85,Default,,0,0,0,,Бұл қиын! Табылды! Мында кел!
Dialogue: 0,2:05:34.44,2:05:36.84,Default,,0,0,0,,Жоқ! Егер сіз осындай жарақатпен кірсеңіз...
Dialogue: 0,2:05:36.84,2:05:39.34,Default,,0,0,0,,Бұл көлдің суы жақсы болмаса ше!
Dialogue: 0,2:05:41.34,2:05:43.34,Default,,0,0,0,,— «Закарис құжаттары», ыңғайсыз құпия мәліметтер жиынтығы.
Dialogue: 0,2:05:51.37,2:05:52.87,Default,,0,0,0,,Ки~!
Dialogue: 0,2:05:54.42,2:05:57.42,Default,,0,0,0,,Ki~! Ки~!
Dialogue: 0,2:06:13.36,2:06:15.86,Default,,0,0,0,,Сіз….
Dialogue: 0,2:06:17.38,2:06:21.85,Default,,0,0,0,,♪♪~
Dialogue: 0,2:06:21.85,2:06:35.35,Default,,0,0,0,,♪♪~ (жылап)
Dialogue: 0,2:06:35.35,2:06:42.84,Default,,0,0,0,,♪♪~
Dialogue: 0,2:06:42.84,2:06:46.36,Default,,0,0,0,,Мейірімді қыз... Менде бәрі жақсы.
Dialogue: 0,2:06:46.36,2:06:49.36,Default,,0,0,0,,Қазір бәрі сені алып кетуге келеді.
Dialogue: 0,2:06:55.35,2:06:58.91,Default,,0,0,0,,Кет, бұл жолмен келме.
Dialogue: 0,2:06:58.91,2:07:02.91,Default,,0,0,0,,King insect! Жоқ! Мына жерде алқап бар!
Dialogue: 0,2:07:05.86,2:07:09.85,Default,,0,0,0,,Ашуыңмен өзіңді ұмытып бара жатырсың. Сабырлану керек, Тани...
Dialogue: 0,2:07:09.85,2:07:11.85,Default,,0,0,0,,Ха!
Dialogue: 0,2:07:22.93,2:07:27.37,Default,,0,0,0,,Хахаха... Ақымақ, өзің шақырдың.
Dialogue: 0,2:07:27.37,2:07:31.37,Default,,0,0,0,,Мен құтқарылдым... Енді қашайық. Қозғалтқышты тексеріңіз.
Dialogue: 0,2:07:32.36,2:07:34.36,Default,,0,0,0,,…
Dialogue: 0,2:07:34.36,2:07:36.84,Default,,0,0,0,,бұл... бұл туралы айтсаң түсінесің!
Dialogue: 0,2:07:36.84,2:07:40.86,Default,,0,0,0,,Бізді табынға апарыңыз.
Dialogue: 0,2:07:40.86,2:07:44.95,Default,,0,0,0,,Мұны істеудің қажеті жоқ. Үйір тоқтамайды.
Dialogue: 0,2:07:44.95,2:07:47.35,Default,,0,0,0,,(оқ ату)
Dialogue: 0,2:07:47.35,2:07:52.36,Default,,0,0,0,,Бізді табынның басына түсіріп жібер, алып жүр!
Dialogue: 0,2:07:52.36,2:07:54.36,Default,,0,0,0,,Бірақ сен де өлесің!
Dialogue: 0,2:10:34.35,2:10:37.35,Default,,0,0,0,,(мылтық шуы)
Dialogue: 0,2:10:42.33,2:10:45.33,Default,,0,0,0,,Баба, бәрі өле ме?
Dialogue: 0,2:10:45.33,2:10:49.40,Default,,0,0,0,,Бұл ереже болса, оны орындаудан басқа амалың жоқ.
Dialogue: 0,2:10:49.40,2:10:51.84,Default,,0,0,0,,Бас тартпаңыз. Шегінейік.
Dialogue: 0,2:10:51.84,2:10:55.34,Default,,0,0,0,,Ақымақ! Қашып кетсең де, қайда қашасың?
Dialogue: 0,2:10:59.35,2:11:02.33,Default,,0,0,0,,Қашпа! Күте тұрыңыз... Эй!
Dialogue: 0,2:11:02.33,2:11:07.33,Default,,0,0,0,,Мәртебелі қайтып келгенше күте тұрыңыз! Мәртебелі... Әй, мәртебелі!
Dialogue: 0,2:11:29.34,2:11:32.34,Default,,0,0,0,,О...
Dialogue: 0,2:11:36.83,2:11:39.84,Default,,0,0,0,,Жүр! Жоғал әрі!
Dialogue: 0,2:11:39.84,2:11:41.34,Default,,0,0,0,,Бұл құдайдың алып сарбазы!
Dialogue: 0,2:11:53.92,2:11:56.92,Default,,0,0,0,,Тым ерте шіріп кетті.
Dialogue: 0,2:12:04.33,2:12:06.35,Default,,0,0,0,,Өртеп жібер!
Dialogue: 0,2:12:06.35,2:12:11.35,Default,,0,0,0,,Саған не болды!? Сонда да сен әлемдегі ең зұлым отбасының ұрпағысың!
Dialogue: 0,2:12:16.42,2:12:17.82,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,2:12:17.82,2:12:20.83,Default,,0,0,0,,Уау!
Dialogue: 0,2:12:27.35,2:12:31.34,Default,,0,0,0,,Керемет! Дүние өртенеді.
Dialogue: 0,2:12:31.34,2:12:35.34,Default,,0,0,0,,Мәртебелі Кушана! Ура! Ура!
Dialogue: 0,2:12:45.33,2:12:47.35,Default,,0,0,0,,Оны кесіңіз!
Dialogue: 0,2:12:47.35,2:12:50.85,Default,,0,0,0,,Не болды, құбыжық! Сіз оны тез түсірдіңіз бе?
Dialogue: 0,2:13:02.45,2:13:04.95,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,2:13:10.84,2:13:12.84,Default,,0,0,0,,Уф! Апыр-ай!
Dialogue: 0,2:13:22.84,2:13:25.34,Default,,0,0,0,,Бұл жақсы емес! Жүгіріп кету!
Dialogue: 0,2:13:27.94,2:13:30.35,Default,,0,0,0,,Алып Құдай Солдат қайтыс болды.
Dialogue: 0,2:13:30.35,2:13:32.83,Default,,0,0,0,,Бұл жақсы болар еді.
Dialogue: 0,2:13:32.83,2:13:36.85,Default,,0,0,0,,Патша жәндіктің ашуы – жер ашуы→
Dialogue: 0,2:13:36.85,2:13:41.35,Default,,0,0,0,,Ондай нәрсеге жабысып аман қалудың не керегі бар?
Dialogue: 0,2:13:44.86,2:13:47.36,Default,,0,0,0,,Ханшайым! Ханшайым-не-сама!
Dialogue: 0,2:13:56.84,2:13:58.84,Default,,0,0,0,,Ах! Мұндай жерде!
Dialogue: 0,2:13:58.84,2:14:00.84,Default,,0,0,0,,Бұл ақылсыз! Ханшайым!
Dialogue: 0,2:14:17.84,2:14:19.84,Default,,0,0,0,,О!
Dialogue: 0,2:14:34.39,2:14:40.89,Default,,0,0,0,,(Айқай)
Dialogue: 0,2:15:04.86,2:15:11.33,Default,,0,0,0,,♪♪~
Dialogue: 0,2:15:11.33,2:15:14.83,Default,,0,0,0,,Корольдік жәндіктің шабуыл түсі жоғалады ♪♪~.
Dialogue: 0,2:15:14.83,2:15:21.33,Default,,0,0,0,,♪♪~
Dialogue: 0,2:15:36.36,2:15:39.36,Default,,0,0,0,,Ашу атмосферадан сейілді.
Dialogue: 0,2:15:40.39,2:15:43.89,Default,,0,0,0,,Тоқтады Корольдік жәндік тоқтады.
Dialogue: 0,2:16:00.83,2:16:03.33,Default,,0,0,0,,Ханшайым-не-сама...! О!
Dialogue: 0,2:16:09.36,2:16:12.83,Default,,0,0,0,,Не-сама ханшайым қайтыс болды...
Dialogue: 0,2:16:12.83,2:16:17.85,Default,,0,0,0,,Патша жәндіктің ашуын өз денесімен басады.
Dialogue: 0,2:16:17.85,2:16:21.35,Default,,0,0,0,,Сол бала алқапты қорғады...
Dialogue: 0,2:16:21.35,2:16:31.34,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,2:16:31.34,2:17:20.84,Default,,0,0,0,,♪♪~
Dialogue: 0,2:17:20.84,2:17:23.33,Default,,0,0,0,,Қараңыз. ♪♪~ Аа….
Dialogue: 0,2:17:23.33,2:17:25.35,Default,,0,0,0,,♪♪~
Dialogue: 0,2:17:25.35,2:17:26.88,Default,,0,0,0,,♪♪~ О~….
Dialogue: 0,2:17:26.88,2:17:30.45,Default,,0,0,0,,♪♪~ Не... не? Бұл жарық.
Dialogue: 0,2:17:30.45,2:17:56.33,Default,,0,0,0,,♪♪~
Dialogue: 0,2:17:56.33,2:17:58.35,Default,,0,0,0,,♪♪~ Тет.
Dialogue: 0,2:17:58.35,2:18:13.41,Default,,0,0,0,,♪♪~
Dialogue: 0,2:18:13.41,2:18:15.33,Default,,0,0,0,,♪♪~ Жақсы.
Dialogue: 0,2:18:15.33,2:18:20.34,Default,,0,0,0,,Омуши Рахмет ♪♪~ Рахмет.
Dialogue: 0,2:18:20.34,2:18:38.85,Default,,0,0,0,,♪♪~
Dialogue: 0,2:18:38.85,2:18:41.84,Default,,0,0,0,,Бұл керемет! Бұл керемет!
Dialogue: 0,2:18:41.84,2:18:45.84,Default,,0,0,0,,Қандай жанашырлық пен жолдастық...
Dialogue: 0,2:18:45.84,2:18:49.83,Default,,0,0,0,,Патша жәндіктің жүрегі ашық.
Dialogue: 0,2:18:49.83,2:18:55.92,Default,,0,0,0,,Балалар, менің әдемі көзіме жақсылап қараңдар.
Dialogue: 0,2:18:55.92,2:18:59.84,Default,,0,0,0,,Ханшайым, сен ашық көк түсті шетелдік киім киіп жүрсің.
Dialogue: 0,2:18:59.84,2:19:03.85,Default,,0,0,0,,Алтын шалғында жүргендей.
Dialogue: 0,2:19:03.85,2:19:05.85,Default,,0,0,0,,О...
Dialogue: 0,2:19:05.85,2:19:11.85,Default,,0,0,0,,♪♪~
Dialogue: 0,2:19:11.85,2:19:15.91,Default,,0,0,0,,«Ол адам көк киімді→
Dialogue: 0,2:19:15.91,2:19:19.34,Default,,0,0,0,,Алтын алқаптарға түс».
Dialogue: 0,2:19:19.34,2:19:20.85,Default,,0,0,0,,О...
Dialogue: 0,2:19:20.85,2:19:22.83,Default,,0,0,0,,Баба.
Dialogue: 0,2:19:22.83,2:19:26.85,Default,,0,0,0,,Ескі аңыз рас еді...
Dialogue: 0,2:19:26.85,2:19:29.86,Default,,0,0,0,,Қараңдаршы.
Dialogue: 0,2:19:29.86,2:19:34.89,Default,,0,0,0,,Бұл Меве! Бұл жел! Жел қайтады!
Dialogue: 0,2:19:34.89,2:19:39.85,Default,,0,0,0,,♪♪~
Dialogue: 0,2:19:39.85,2:19:42.84,Default,,0,0,0,,Уау! ♪♪~ Ханшайым~!
Dialogue: 0,2:19:42.84,2:22:05.84,Default,,0,0,0,,♪♪~
Dialogue: 0,2:22:16.87,2:22:18.87,Default,,0,0,0,,<Оны асыға күтіңіздер! ＞
Dialogue: 0,2:22:26.35,2:22:28.83,Default,,0,0,0,,<Бүкіл әлемді баурап алған төрт адам→
Dialogue: 0,2:22:28.83,2:22:30.85,Default,,0,0,0,,«Жұма жол ШОУ! >
Dialogue: 0,2:22:35.34,2:22:36.84,Default,,0,0,0,,<Оны асыға күтіңіздер! ＞
Dialogue: 0,2:22:38.41,2:22:42.33,Default,,0,0,0,,<Сонымен қатар, келесі апта соңғы жұмыстың шығу күніне сәйкес келеді→
Dialogue: 0,2:22:42.33,2:22:44.83,Default,,0,0,0,,«Қара киімді адамдар» хабары＞
Dialogue: 0,2:22:49.34,2:22:52.34,Default,,0,0,0,,Сіз оған кірдіңіз, Наусика, бұл керемет болды.
Dialogue: 0,2:22:53.34,2:22:55.84,Default,,0,0,0,,Бүгінгі фильм туралы естелік...
Dialogue: 0,2:22:58.40,2:22:59.92,Default,,0,0,0,,Дұрыс.
Dialogue: 0,2:22:59.92,2:23:01.83,Default,,0,0,0,,Мен Наусика сияқты күшті болғым келеді.
Dialogue: 0,2:23:01.83,2:23:03.33,Default,,0,0,0,,Келесі аптада кездескенше!
Dialogue: 0,2:23:14.35,2:23:16.87,Default,,0,0,0,,<Және Стэнлидің смартфонының мазмұны →
Dialogue: 0,2:23:16.87,2:23:18.37,Default,,0,0,0,,Тарату басталады! ＞
Dialogue: 0,2:23:19.87,2:23:24.87,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
