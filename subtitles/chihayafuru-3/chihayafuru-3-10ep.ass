Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.09,0:00:10.55,Default,,0,0,0,,Мэйджин турнирі Батыс Жапонияның алдын ала финалы
Dialogue: 0,0:00:11.38,0:00:13.76,Default,,0,0,0,,Шиничи Мурао Арата Ватаяға қарсы
Dialogue: 0,0:00:13.84,0:00:16.55,Default,,0,0,0,,Нагумо-кай клубының кездесуі!
Dialogue: 0,0:00:17.18,0:00:18.93,Default,,0,0,0,,Сіздің қабілетіңізге сәйкес келетін қорытынды карталар
Dialogue: 0,0:00:19.01,0:00:20.89,Default,,0,0,0,,Мурао-кун біраз уақыт көңілсіз болды, бірақ
Dialogue: 0,0:00:20.97,0:00:21.81,Default,,0,0,0,,Мен оны қайтардым.
Dialogue: 0,0:00:21.89,0:00:24.27,Default,,0,0,0,,Шиничи-чан!
Dialogue: 0,0:00:25.27,0:00:29.94,Default,,0,0,0,,Мурао ойыншы ретінде көп тәжірибе жинақтады.
Dialogue: 0,0:00:31.07,0:00:31.94,Default,,0,0,0,,Бірақ—
Dialogue: 0,0:00:32.03,0:00:35.70,Default,,0,0,0,,Мейджин Сухтың қатарынан бес жеңісін тоқтата алатын адам...
Dialogue: 0,0:00:48.04,0:00:53.05,Default,,0,0,0,,♪～
Dialogue: 0,0:01:52.98,0:01:57.99,Default,,0,0,0,,～♪
Dialogue: 0,0:02:01.99,0:02:03.49,Default,,0,0,0,,Есте сақтау уақыты 15 минут.
Dialogue: 0,0:02:04.16,0:02:06.00,Default,,0,0,0,,Ойын 6:10-да басталады
Dialogue: 0,0:02:10.00,0:02:11.00,Default,,0,0,0,,Көрсетемін саған
Dialogue: 0,0:02:11.08,0:02:12.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:13.29,0:02:15.26,Default,,0,0,0,,(Экхарт) Кторигалга басып кірген бейбітшілікке қарсы күштер—
Dialogue: 0,0:02:17.17,0:02:18.55,Default,,0,0,0,,(Дәретхананың ағу дыбысы)
Dialogue: 0,0:02:18.63,0:02:20.09,Default,,0,0,0,,Я...
Dialogue: 0,0:02:20.18,0:02:23.14,Default,,0,0,0,,Мен енді Юудың пісіргенін жемеймін
Dialogue: 0,0:02:23.22,0:02:27.98,Default,,0,0,0,,Не болды, Катсу? Бұл бонито үлпектері ме?
Dialogue: 0,0:02:28.06,0:02:29.23,Default,,0,0,0,,Ах
Dialogue: 0,0:02:30.98,0:02:32.73,Default,,0,0,0,,Я...
Dialogue: 0,0:02:33.65,0:02:36.07,Default,,0,0,0,,Неліктен дәл қазір жеңілдеп қалдың?
Dialogue: 0,0:02:37.03,0:02:39.99,Default,,0,0,0,,Тайчи неге жеңілді?
Dialogue: 0,0:02:40.07,0:02:41.99,Default,,0,0,0,,Уф! Босат! Мені босат!
Dialogue: 0,0:02:44.45,0:02:45.54,Default,,0,0,0,,Тіпті финалда
Dialogue: 0,0:02:46.45,0:02:47.54,Default,,0,0,0,,Мурао мырза әдеттегідей.
Dialogue: 0,0:02:49.58,0:02:50.42,Default,,0,0,0,,Жоспар
Dialogue: 0,0:02:51.21,0:02:53.67,Default,,0,0,0,,Біз әдеттегідей карута ойнаймыз.
Dialogue: 0,0:02:54.29,0:02:55.13,Default,,0,0,0,,Уақыт келді
Dialogue: 0,0:02:57.05,0:02:58.63,Default,,0,0,0,,Әдеттегі...
Dialogue: 0,0:03:02.51,0:03:04.68,Default,,0,0,0,,Сол бөлме...
Dialogue: 0,0:03:06.14,0:03:06.56,Default,,0,0,0,,Ха!
Dialogue: 0,0:03:06.56,0:03:07.60,Default,,0,0,0,,Ха!
Dialogue: 0,0:03:06.56,0:03:07.60,Default,,0,0,0,,Жалғыздық~
Dialogue: 0,0:03:07.60,0:03:07.68,Default,,0,0,0,,Жалғыздық~
Dialogue: 0,0:03:07.68,0:03:09.10,Default,,0,0,0,,Мурао-кун жылдам!
Dialogue: 0,0:03:07.68,0:03:09.10,Default,,0,0,0,,Жалғыздық~
Dialogue: 0,0:03:09.18,0:03:11.35,Default,,0,0,0,,Жау шебін көздедім!
Dialogue: 0,0:03:11.44,0:03:12.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:18.07,0:03:20.24,Default,,0,0,0,,Өз тобының «Уқа» мен «Ура» тобын ажыратты
Dialogue: 0,0:03:20.32,0:03:22.95,Default,,0,0,0,,Жолдарды кесіп өтуге қабілетті жаңа адамдарға қарсы шаралар
Dialogue: 0,0:03:24.16,0:03:26.74,Default,,0,0,0,,Мурао мырза әдеттегідей.
Dialogue: 0,0:03:28.04,0:03:29.75,Default,,0,0,0,,Момошикия~
Dialogue: 0,0:03:29.83,0:03:31.37,Default,,0,0,0,,Бұл жолы~
Dialogue: 0,0:03:32.37,0:03:33.88,Default,,0,0,0,,Бірақ-
Dialogue: 0,0:03:35.50,0:03:37.34,Default,,0,0,0,,Мен неге...
Dialogue: 0,0:03:39.67,0:03:41.42,Default,,0,0,0,,Сакаия Тайчи
Dialogue: 0,0:03:41.51,0:03:43.13,Default,,0,0,0,,Сен неге сондасың?
Dialogue: 0,0:03:45.09,0:03:48.77,Default,,0,0,0,,Тайчи айлакер.
Dialogue: 0,0:03:49.27,0:03:52.02,Default,,0,0,0,,Арнайы Менде Чихая сияқты талант жоқ...
Dialogue: 0,0:03:54.02,0:03:55.19,Default,,0,0,0,,Мен...
Dialogue: 0,0:03:56.69,0:03:58.52,Default,,0,0,0,,Маған менсінбей қарадың ба?
Dialogue: 0,0:03:59.11,0:04:00.69,Default,,0,0,0,,Карутада Тайчи...
Dialogue: 0,0:04:02.40,0:04:03.45,Default,,0,0,0,,Достар...
Dialogue: 0,0:04:10.87,0:04:11.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:11.91,0:04:12.96,Default,,0,0,0,,Асабораке...
Dialogue: 0,0:04:13.04,0:04:14.08,Default,,0,0,0,,Хмм
Dialogue: 0,0:04:15.00,0:04:16.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:16.25,0:04:18.54,Default,,0,0,0,,Шин-кунның қоршауының кешіктірілетініне сене алар емеспін...
Dialogue: 0,0:04:19.25,0:04:20.63,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:21.67,0:04:25.34,Default,,0,0,0,,Не болды? Йошино-кай турнирінен күлкілі
Dialogue: 0,0:04:26.14,0:04:27.51,Default,,0,0,0,,Жаңа...
Dialogue: 0,0:04:28.05,0:04:30.60,Default,,0,0,0,,Мүмкіндік немесе
Dialogue: 0,0:04:30.68,0:04:33.02,Default,,0,0,0,,Жаңа күшке ие болуда
Dialogue: 0,0:04:33.10,0:04:36.06,Default,,0,0,0,,Егер мен тамаша формада келсем, қиын болар еді.
Dialogue: 0,0:04:36.60,0:04:39.98,Default,,0,0,0,,Мен бұл жаман жағдайды жеңе аламын.
Dialogue: 0,0:04:40.07,0:04:41.40,Default,,0,0,0,,Мисебаяна~
Dialogue: 0,0:04:41.48,0:04:42.57,Default,,0,0,0,,Бұл жыл сіздің мүмкіндігіңіз
Dialogue: 0,0:04:45.15,0:04:47.87,Default,,0,0,0,,5 рет қатарынан чемпион болғаннан кейін зейнеткерлікке шығамын.
Dialogue: 0,0:04:48.66,0:04:50.24,Default,,0,0,0,,Алдымен 73-ші сиқыршымен айналысайық па?
Dialogue: 0,0:05:08.26,0:05:09.76,Default,,0,0,0,,Күте тұрыңыз (бетке түрту дыбысы)
Dialogue: 0,0:05:10.85,0:05:11.72,Default,,0,0,0,,Не!
Dialogue: 0,0:05:14.68,0:05:17.06,Default,,0,0,0,,Ямаширо мырзаның құнды оқуы
Dialogue: 0,0:05:17.81,0:05:20.57,Default,,0,0,0,,Жаңадан оралыңыз
Dialogue: 0,0:05:20.65,0:05:24.36,Default,,0,0,0,,А... а...
Dialogue: 0,0:05:46.88,0:05:48.76,Default,,0,0,0,,Ылғалды... (Аратаның ішінің құлаған дыбысы)
Dialogue: 0,0:05:48.84,0:05:50.55,Default,,0,0,0,,Кім? (Көрермендер) Тағы ханшайым?
Dialogue: 0,0:05:50.64,0:05:52.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:52.64,0:05:55.56,Default,,0,0,0,,Жарайды... дәл осы уақытта болғанына сене алмадым...
Dialogue: 0,0:05:55.64,0:05:56.81,Default,,0,0,0,,Шин-кун! ?
Dialogue: 0,0:05:56.89,0:05:58.94,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:05:59.02,0:06:00.44,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:06:00.52,0:06:02.40,Default,,0,0,0,,Тұр! (Көрермендер) Дәретхана?
Dialogue: 0,0:06:02.48,0:06:04.90,Default,,0,0,0,,Сіз ойын кезінде барасыз ба?
Dialogue: 0,0:06:04.98,0:06:07.28,Default,,0,0,0,,Мұғалім, бұл нені білдіреді?
Dialogue: 0,0:06:07.36,0:06:08.74,Default,,0,0,0,,Матч не болады?
Dialogue: 0,0:06:08.82,0:06:10.62,Default,,0,0,0,,Не болса да, не болса да
Dialogue: 0,0:06:10.70,0:06:14.37,Default,,0,0,0,,Басқа адам түсінбесе де, ол жай ғана оқылады...
Dialogue: 0,0:06:14.45,0:06:15.95,Default,,0,0,0,,Алыс кет~
Dialogue: 0,0:06:16.04,0:06:19.29,Default,,0,0,0,,Мүмкін емес! Матч кезінде дәретхана
Dialogue: 0,0:06:16.04,0:06:19.29,Default,,0,0,0,,(дәретхана қағазын шығару дыбысы)
Dialogue: 0,0:06:19.37,0:06:22.25,Default,,0,0,0,,Неше бет оқылады? Асықпаңыз, асықпаңыз
Dialogue: 0,0:06:22.34,0:06:25.34,Default,,0,0,0,,Хонма, мен енді Юудың пісіргенін жемеймін.
Dialogue: 0,0:06:25.42,0:06:27.01,Default,,0,0,0,,Мен оны енді ешқашан жемеймін, Юудың ақымақ!
Dialogue: 0,0:06:27.09,0:06:28.76,Default,,0,0,0,,Идиот!
Dialogue: 0,0:06:28.84,0:06:30.55,Default,,0,0,0,,Анамнан
Dialogue: 0,0:06:30.64,0:06:33.68,Default,,0,0,0,,Мен карута клубына қатыса аламын.
Dialogue: 0,0:06:33.76,0:06:36.31,Default,,0,0,0,,Бұл шағын сыйлық қандай?
Dialogue: 0,0:06:36.39,0:06:38.02,Default,,0,0,0,,Бастық...
Dialogue: 0,0:06:39.85,0:06:41.40,Default,,0,0,0,,Юу кешіріңіз
Dialogue: 0,0:06:41.48,0:06:44.07,Default,,0,0,0,,Мен онша үлкен адам емеспін.
Dialogue: 0,0:06:48.11,0:06:49.70,Default,,0,0,0,,Уф! Босат! Мені босат!
Dialogue: 0,0:06:51.07,0:06:52.28,Default,,0,0,0,,Уф!
Dialogue: 0,0:06:57.37,0:07:01.58,Default,,0,0,0,,Мен дәретханаға отырдым да, 4 билетті жоғалттым, 11 билет айырмашылығы.
Dialogue: 0,0:07:01.67,0:07:02.79,Default,,0,0,0,,Неше бос карточка бар?
Dialogue: 0,0:07:03.46,0:07:04.88,Default,,0,0,0,,Не болды?
Dialogue: 0,0:07:05.96,0:07:09.22,Default,,0,0,0,,11 картаның Мурао мырзаға қарсы айырмашылығы
Dialogue: 0,0:07:11.55,0:07:14.85,Default,,0,0,0,,(Жаңа терең тыныс)
Dialogue: 0,0:07:14.93,0:07:18.02,Default,,0,0,0,,Мен бұл жерден жеңіске жетуді ешқашан елестеткен емеспін.
Dialogue: 0,0:07:18.77,0:07:20.64,Default,,0,0,0,,Бірақ біз не істейміз?
Dialogue: 0,0:07:20.73,0:07:22.23,Default,,0,0,0,,Біз не істейміз?
Dialogue: 0,0:07:22.94,0:07:24.73,Default,,0,0,0,,Жіберсең жаман.
Dialogue: 0,0:07:26.52,0:07:30.24,Default,,0,0,0,,Ұялып қалсам да, Қиын болмаса да
Dialogue: 0,0:07:30.32,0:07:31.61,Default,,0,0,0,,Қашып кетсең қауіпті.
Dialogue: 0,0:07:33.41,0:07:34.82,Default,,0,0,0,,11 парақ айырмашылығы…
Dialogue: 0,0:07:34.91,0:07:37.49,Default,,0,0,0,,Қанша қиын болсаң да, Ватая-кун.
Dialogue: 0,0:07:37.58,0:07:40.79,Default,,0,0,0,,Бұл 11 картаның айырмашылығы ғана емес.
Dialogue: 0,0:07:40.87,0:07:44.63,Default,,0,0,0,,Ереже: үзіліс кезінде не оқылғанын ешкім айта алмайды.
Dialogue: 0,0:07:45.96,0:07:50.05,Default,,0,0,0,,Азайған төрт картадан басқа қанша бос карта оқылды?
Dialogue: 0,0:07:50.13,0:07:53.26,Default,,0,0,0,,Мен тұрақты кейіпкерлердің қалай өзгергенін әлі түсінбеймін.
Dialogue: 0,0:07:54.30,0:07:56.80,Default,,0,0,0,,Бұл парақтар санындағы айырмашылықтан артық гандикап.
Dialogue: 0,0:07:57.81,0:08:00.22,Default,,0,0,0,,Мен Шин-кунның қолынан келгенін жасайтынына сенімдімін, бірақ...
Dialogue: 0,0:08:00.31,0:08:02.31,Default,,0,0,0,,Жеңіс қазірдің өзінде...
Dialogue: 0,0:08:03.02,0:08:04.19,Default,,0,0,0,,Вексельді жылжыту
Dialogue: 0,0:08:08.36,0:08:09.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:13.74,0:08:16.70,Default,,0,0,0,,Жаңа Мен бас тартқан жоқпын
Dialogue: 0,0:08:17.33,0:08:18.70,Default,,0,0,0,,Фу…
Dialogue: 0,0:08:18.78,0:08:22.25,Default,,0,0,0,,Менің орнымнан алыс болған уақытты ескере отырып
Dialogue: 0,0:08:22.33,0:08:24.17,Default,,0,0,0,,2-3 бос карточкалар
Dialogue: 0,0:08:25.00,0:08:26.92,Default,,0,0,0,,Бұл туралы ойлаудың да пайдасы жоқ
Dialogue: 0,0:08:27.00,0:08:28.71,Default,,0,0,0,,Менің білгенімді істеуден басқа амалым жоқ.
Dialogue: 0,0:08:29.63,0:08:31.21,Default,,0,0,0,,Біз шабуыл жасауымыз керек пе?
Dialogue: 0,0:08:31.30,0:08:33.59,Default,,0,0,0,,Бірақ мен дублардан және қолдардан қорқамын.
Dialogue: 0,0:08:33.67,0:08:35.64,Default,,0,0,0,,Менің мұны істеуден басқа амалым жоқ.
Dialogue: 0,0:08:35.72,0:08:37.39,Default,,0,0,0,,Барлығы қарап отыр
Dialogue: 0,0:08:37.47,0:08:39.72,Default,,0,0,0,,Енді ақымақ қателіктер болмайды...
Dialogue: 0,0:08:39.81,0:08:41.47,Default,,0,0,0,,Менің мұны істеуден басқа амалым жоқ.
Dialogue: 0,0:08:42.06,0:08:43.60,Default,,0,0,0,,Фукукарани~ (Жаңа) Уф!
Dialogue: 0,0:08:43.68,0:08:44.60,Default,,0,0,0,,Ах
Dialogue: 0,0:08:45.81,0:08:48.19,Default,,0,0,0,,Осы уақытта сіздің жеке сызық шешілді!
Dialogue: 0,0:08:48.27,0:08:49.23,Default,,0,0,0,,Бақытты
Dialogue: 0,0:08:51.19,0:08:55.32,Default,,0,0,0,,Белгілері бекітілген 28 карта болса жақсы болар еді.
Dialogue: 0,0:08:55.91,0:08:57.41,Default,,0,0,0,,Суо мырза
Dialogue: 0,0:08:57.49,0:09:00.12,Default,,0,0,0,,Ах, 27 дана?
Dialogue: 0,0:09:00.20,0:09:01.12,Default,,0,0,0,,Иә
Dialogue: 0,0:09:04.25,0:09:07.08,Default,,0,0,0,,Тіпті мамандар кездейсоқ нәрселерді айтады
Dialogue: 0,0:09:07.17,0:09:10.46,Default,,0,0,0,,Маған қиналғаным жетеді.
Dialogue: 0,0:09:10.54,0:09:13.05,Default,,0,0,0,,Сіз үшін Харуноға шығыңыз.
Dialogue: 0,0:09:13.05,0:09:13.67,Default,,0,0,0,,Жау лагеріне секіріп, «сен» қоршауына барды.
Dialogue: 0,0:09:13.05,0:09:13.67,Default,,0,0,0,,Сіз үшін Харуноға шығыңыз.
Dialogue: 0,0:09:13.67,0:09:13.76,Default,,0,0,0,,Мен жау лагеріне секірдім де, «сен» қоршауына бардым.
Dialogue: 0,0:09:13.76,0:09:15.38,Default,,0,0,0,,Мен жау лагеріне секіріп, «сіз» қоршауына бардым.
Dialogue: 0,0:09:13.76,0:09:15.38,Default,,0,0,0,,Ваканацуму~
Dialogue: 0,0:09:15.38,0:09:15.47,Default,,0,0,0,,Ваканацуму~
Dialogue: 0,0:09:15.47,0:09:16.97,Default,,0,0,0,,Жоғалмаңыз!
Dialogue: 0,0:09:15.47,0:09:16.97,Default,,0,0,0,,Ваканацуму~
Dialogue: 0,0:09:17.05,0:09:18.80,Default,,0,0,0,,Әдеттегідей Шин-кун.
Dialogue: 0,0:09:19.55,0:09:23.02,Default,,0,0,0,,Бір таңбадан кейін үлкен үйінді ме?
Dialogue: 0,0:09:23.10,0:09:25.39,Default,,0,0,0,,Жаңа бақыт
Dialogue: 0,0:09:25.48,0:09:28.15,Default,,0,0,0,,Күн ыстық, бірақ жалғасы жоқ.
Dialogue: 0,0:09:28.77,0:09:31.11,Default,,0,0,0,,Екі әрі үш әріптен тұратын ережелер ойын болмауы керек.
Dialogue: 0,0:09:32.07,0:09:33.28,Default,,0,0,0,,Юраното~
Dialogue: 0,0:09:33.36,0:09:34.65,Default,,0,0,0,,Мурао-кун жылдам!
Dialogue: 0,0:09:35.99,0:09:38.78,Default,,0,0,0,,Сіз сол бір «Ю» кейіпкері үшін төледіңіз бе?
Dialogue: 0,0:09:40.45,0:09:41.28,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:41.99,0:09:44.00,Default,,0,0,0,,Бос карточкалардың бірі «Ю» немесе
Dialogue: 0,0:09:44.75,0:09:48.67,Default,,0,0,0,,Мен түсінбейтін көп дегенде екі бос карта қалды.
Dialogue: 0,0:09:48.75,0:09:52.38,Default,,0,0,0,,Жаңа сурет
Dialogue: 0,0:09:53.34,0:09:55.46,Default,,0,0,0,,Тег сізге айтып береді
Dialogue: 0,0:09:57.26,0:10:00.68,Default,,0,0,0,,Жеңімпаз суретті салу жолы
Dialogue: 0,0:10:04.64,0:10:06.27,Default,,0,0,0,,Мэйджин турнирінің алдын ала кезеңіне келетін болсақ
Dialogue: 0,0:10:06.35,0:10:07.85,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:10:07.94,0:10:09.48,Default,,0,0,0,,Бұл жерде шешімді Ватая-кун қабылдайды.
Dialogue: 0,0:10:09.56,0:10:11.23,Default,,0,0,0,,Мен ойладым...
Dialogue: 0,0:10:11.31,0:10:13.36,Default,,0,0,0,,Бұл жақын шайқас.
Dialogue: 0,0:10:13.44,0:10:14.44,Default,,0,0,0,,Эму
Dialogue: 0,0:10:14.53,0:10:16.44,Default,,0,0,0,,Юкава мырзамен күресу қиын адам.
Dialogue: 0,0:10:18.99,0:10:20.24,Default,,0,0,0,,Орындау қиын
Dialogue: 0,0:10:21.32,0:10:24.04,Default,,0,0,0,,Сіздің командаңыздың сол жағы біртүрлі жылдам.
Dialogue: 0,0:10:24.12,0:10:25.41,Default,,0,0,0,,Тегті жылжыту
Dialogue: 0,0:10:25.49,0:10:26.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:27.96,0:10:31.29,Default,,0,0,0,,Оң жақтан шоттарды жылжыта беріңіз...
Dialogue: 0,0:10:32.42,0:10:34.38,Default,,0,0,0,,Сіз олардың барлығын сол қанатпен алуды жоспарлап отырсыз ба?
Dialogue: 0,0:10:35.42,0:10:37.88,Default,,0,0,0,,басым солақай оңтүстік табан
Dialogue: 0,0:10:38.51,0:10:43.39,Default,,0,0,0,,А... Уау, Королева сияқты оңтүстік табан ба?
Dialogue: 0,0:10:43.97,0:10:44.89,Default,,0,0,0,,Хмм
Dialogue: 0,0:10:45.93,0:10:47.43,Default,,0,0,0,,Мен жеңіле алмаймын!
Dialogue: 0,0:10:49.35,0:10:51.02,Default,,0,0,0,,Ашибикино～
Dialogue: 0,0:10:51.10,0:10:52.77,Default,,0,0,0,,Конухито~
Dialogue: 0,0:10:52.86,0:10:55.19,Default,,0,0,0,,Егер сіз мақта алқаптарында есіп көрсеңіз~
Dialogue: 0,0:10:55.27,0:10:56.90,Default,,0,0,0,,Фу…
Dialogue: 0,0:10:57.57,0:10:58.40,Default,,0,0,0,,Хмм
Dialogue: 0,0:10:58.49,0:11:01.66,Default,,0,0,0,,11-ден 18-ге дейін Алшақтық қысқарды.
Dialogue: 0,0:11:01.74,0:11:03.78,Default,,0,0,0,,Мурао мырза үрейленбейді.
Dialogue: 0,0:11:03.87,0:11:07.24,Default,,0,0,0,,Парақтардың санында айырмашылық болған кезде, теория бойынша жаудың базасына шабуыл
Dialogue: 0,0:11:07.33,0:11:09.37,Default,,0,0,0,,Бірақ бұл азап, ағайын.
Dialogue: 0,0:11:09.46,0:11:12.12,Default,,0,0,0,,Өрмекшіні ойлап табу
Dialogue: 0,0:11:12.21,0:11:14.00,Default,,0,0,0,,Окицу Ширанами~
Dialogue: 0,0:11:14.00,0:11:18.30,Default,,0,0,0,,Окицу Ширанами~
Dialogue: 0,0:11:14.00,0:11:18.30,Default,,0,0,0,,Иә? Не... уайымдайсыз ба?
Dialogue: 0,0:11:18.38,0:11:19.55,Default,,0,0,0,,Мен ~ ұмытып қалдым
Dialogue: 0,0:11:19.63,0:11:20.59,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:20.67,0:11:23.89,Default,,0,0,0,,«Мен» және «ұмыту» арасындағы әдемі крест шешілді.
Dialogue: 0,0:11:23.97,0:11:27.10,Default,,0,0,0,,«Ұмыту» - Мурао бірінші таймда жіберген тег.
Dialogue: 0,0:11:27.18,0:11:28.97,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:11:29.06,0:11:32.14,Default,,0,0,0,,Синкун екеуіңнің айырмашылығың сенгісіз.
Dialogue: 0,0:11:32.23,0:11:36.73,Default,,0,0,0,,Басынан ортасына дейін мен әдетте жібермейтін карталарды жіберуге мәжбүр болдым.
Dialogue: 0,0:11:37.73,0:11:39.53,Default,,0,0,0,,Өткізуді жақсы білетін жаңа жігітке
Dialogue: 0,0:11:39.61,0:11:41.70,Default,,0,0,0,,«Мен» және «ұмыту» болу үшін…
Dialogue: 0,0:11:42.91,0:11:45.07,Default,,0,0,0,,Мурао-кун, уайымда...
Dialogue: 0,0:11:45.16,0:11:46.95,Default,,0,0,0,,Оның үстіне «Ұмытып қалдым» деп алып кетті.
Dialogue: 0,0:11:48.29,0:11:51.41,Default,,0,0,0,,Күшінде айырмашылығы жоқ қарсыластың арасында үлкен айырмашылық болған кезде және
Dialogue: 0,0:11:51.50,0:11:53.96,Default,,0,0,0,,Жеңіске жетсең де, қиын.
Dialogue: 0,0:11:54.96,0:11:56.88,Default,,0,0,0,,17 11-ге қарсы
Dialogue: 0,0:11:56.96,0:11:57.96,Default,,0,0,0,,6 парақ айырмашылығы
Dialogue: 0,0:11:59.00,0:12:00.63,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:12:00.72,0:12:01.97,Default,,0,0,0,,Қуып жету
Dialogue: 0,0:12:02.05,0:12:04.51,Default,,0,0,0,,Бір-бірден өтіңіз
Dialogue: 0,0:12:04.59,0:12:06.72,Default,,0,0,0,,Имаконто~ (Жаңа) Уку…
Dialogue: 0,0:12:06.80,0:12:08.39,Default,,0,0,0,,Шабуыл аяқталды! (Көрермендер) Тез!
Dialogue: 0,0:12:11.14,0:12:13.85,Default,,0,0,0,,Әрине қиын
Dialogue: 0,0:12:13.94,0:12:16.48,Default,,0,0,0,,Сіз Арата Ватаясыз ба?
Dialogue: 0,0:12:17.48,0:12:19.11,Default,,0,0,0,,10 17-ге қарсы
Dialogue: 0,0:12:19.19,0:12:22.49,Default,,0,0,0,,Жаңа қарсыласқа әлі жеті карта айырмашылығы бар.
Dialogue: 0,0:12:22.57,0:12:24.53,Default,,0,0,0,,Гоножия
Dialogue: 0,0:12:24.61,0:12:25.99,Default,,0,0,0,,Шабуыл
Dialogue: 0,0:12:29.03,0:12:30.12,Default,,0,0,0,,Мурао мырза
Dialogue: 0,0:12:31.12,0:12:32.50,Default,,0,0,0,,Басқа бос карта
Dialogue: 0,0:12:33.87,0:12:35.54,Default,,0,0,0,,«Қазір»?
Dialogue: 0,0:12:39.50,0:12:41.71,Default,,0,0,0,,Маған Мурао-санның карутасы ұнайды.
Dialogue: 0,0:12:43.72,0:12:49.14,Default,,0,0,0,,Ойынның дамуына әсер етпейтін біркелкі және елеулі карута
Dialogue: 0,0:12:49.68,0:12:50.85,Default,,0,0,0,,Йононака... (Мурао)
Dialogue: 0,0:12:50.93,0:12:51.77,Default,,0,0,0,,Ах
Dialogue: 0,0:12:51.85,0:12:53.10,Default,,0,0,0,,Ах
Dialogue: 0,0:12:53.18,0:12:55.23,Default,,0,0,0,,Шин-кун кесіп өтіп, екеуінің ақысын төлеуді жоспарлады.
Dialogue: 0,0:12:55.31,0:12:56.90,Default,,0,0,0,,«Йононакаё» және «Йононакава»
Dialogue: 0,0:12:56.98,0:13:00.86,Default,,0,0,0,,Мен Аратаның қолын маған ұшып кетуіне мықтап бөгеп тастадым.
Dialogue: 0,0:13:01.78,0:13:04.53,Default,,0,0,0,,«Егер екі карта болса, біреуін өзіңіз ұстаңыз».
Dialogue: 0,0:13:04.61,0:13:07.16,Default,,0,0,0,,Мен шешім қабылдай алмаймын немесе қозғала алмаймын.
Dialogue: 0,0:13:07.24,0:13:09.07,Default,,0,0,0,,Мурао-кунның жаңа шаралары!
Dialogue: 0,0:13:11.12,0:13:12.58,Default,,0,0,0,,Күтілгендей, Мурао мырза
Dialogue: 0,0:13:13.37,0:13:15.08,Default,,0,0,0,,Кори-чан
Dialogue: 0,0:13:15.16,0:13:16.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:26.05,0:13:26.88,Default,,0,0,0,,Ха!
Dialogue: 0,0:13:39.02,0:13:40.44,Default,,0,0,0,,Жарайды, жарайды
Dialogue: 0,0:13:40.52,0:13:42.61,Default,,0,0,0,,Қарсыластың позициясы сөзсіз алынды.
Dialogue: 0,0:13:43.19,0:13:45.40,Default,,0,0,0,,Қозғалуға болады.
Dialogue: 0,0:13:45.49,0:13:46.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:48.45,0:13:50.03,Default,,0,0,0,,4 парақ айырмашылығы...
Dialogue: 0,0:13:50.12,0:13:50.95,Default,,0,0,0,,Қазірдің өзінде?
Dialogue: 0,0:13:56.83,0:13:58.46,Default,,0,0,0,,Сауда-саттыққа қатысты мәселелер…
Dialogue: 0,0:13:59.46,0:14:01.59,Default,,0,0,0,,Екеуі де жау лагеріне шабуыл жасайды.
Dialogue: 0,0:14:02.25,0:14:04.76,Default,,0,0,0,,Мурао Кимиджиннің көптеген ұсыныстары бар.
Dialogue: 0,0:14:04.84,0:14:09.93,Default,,0,0,0,,Ықтималдық туралы айтатын болсақ, Шин-кунның лагерінде көбірек ұсыныстар болуы керек.
Dialogue: 0,0:14:10.01,0:14:13.76,Default,,0,0,0,,Дегенмен олар Мурао-кунның лагеріне қорықпай шабуыл жасайды.
Dialogue: 0,0:14:15.02,0:14:18.31,Default,,0,0,0,,10 немесе одан да көп айырмашылық болса
Dialogue: 0,0:14:18.39,0:14:22.77,Default,,0,0,0,,Мурао мырзаның істегені тек жақсы білетін карталарын сақтау болды.
Dialogue: 0,0:14:23.40,0:14:24.23,Default,,0,0,0,,(Каэбуки) Кучида мен Киришима—
Dialogue: 0,0:14:24.32,0:14:25.15,Default,,0,0,0,,Тоқтаймыз~
Dialogue: 0,0:14:25.23,0:14:26.74,Default,,0,0,0,,Дұрыс позиция!
Dialogue: 0,0:14:28.74,0:14:32.49,Default,,0,0,0,,Бастапқыда Шин-кун Карутаны шабуыл мен қорғаныс арасында жақсы тепе-теңдікте ойнайды.
Dialogue: 0,0:14:32.58,0:14:34.99,Default,,0,0,0,,Осындай қатал шабуыл...
Dialogue: 0,0:14:36.12,0:14:37.71,Default,,0,0,0,,Шақыру ағыны
Dialogue: 0,0:14:42.08,0:14:47.76,Default,,0,0,0,,Шығыс Жапониядағы ең жақсы шабуылдаушы ойыншымен қалай күресуге болады
Dialogue: 0,0:14:51.51,0:14:55.14,Default,,0,0,0,,Чихаябуру Камиомоки Казу...
Dialogue: 0,0:14:55.22,0:14:56.93,Default,,0,0,0,,Ой, Мурао-кун да жылдам.
Dialogue: 0,0:14:57.02,0:14:58.18,Default,,0,0,0,,(Көрермендер) Бұл Косей Арима ғой. (Көрермендер) Аизаның кішкентай қарындасымен бе?
Dialogue: 0,0:14:58.27,0:15:00.10,Default,,0,0,0,,Арата да «Чихаға» ұмтылды...
Dialogue: 0,0:15:00.19,0:15:01.98,Default,,0,0,0,,Қаш, Шиничи-чан!
Dialogue: 0,0:15:02.06,0:15:04.40,Default,,0,0,0,,Мен Мэйджин Сууды жеңгім келеді
Dialogue: 0,0:15:05.48,0:15:08.94,Default,,0,0,0,,Жалғыз талант адамды соншалықты төмен түсіреді.
Dialogue: 0,0:15:09.03,0:15:12.32,Default,,0,0,0,,Бұл шеберді күшпен жеңудің соңғы мүмкіндігі.
Dialogue: 0,0:15:13.62,0:15:14.99,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:16.29,0:15:18.29,Default,,0,0,0,,Мурао мырза
Dialogue: 0,0:15:18.37,0:15:21.29,Default,,0,0,0,,Соңғы оқылған бос карта
Dialogue: 0,0:15:21.79,0:15:23.33,Default,,0,0,0,,«Чигирики»?
Dialogue: 0,0:15:24.21,0:15:25.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:28.09,0:15:31.18,Default,,0,0,0,,Талант…
Dialogue: 0,0:15:31.76,0:15:35.05,Default,,0,0,0,,Талант…
Dialogue: 0,0:15:36.51,0:15:37.35,Default,,0,0,0,,Күш…
Dialogue: 0,0:15:39.64,0:15:41.81,Default,,0,0,0,,Дарындылық…
Dialogue: 0,0:15:54.70,0:15:56.53,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:15:58.33,0:16:00.33,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:16:03.75,0:16:05.54,Default,,0,0,0,,Я...
Dialogue: 0,0:16:12.59,0:16:13.47,Default,,0,0,0,,Жаңа
Dialogue: 0,0:16:16.51,0:16:18.18,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:18.26,0:16:19.97,Default,,0,0,0,,Жаңадан күліңіз
Dialogue: 0,0:16:20.06,0:16:24.48,Default,,0,0,0,,Күлмесең, көңілім түспейді.
Dialogue: 0,0:16:24.56,0:16:27.23,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:28.94,0:16:29.78,Default,,0,0,0,,Иә
Dialogue: 0,0:16:29.86,0:16:31.61,Default,,0,0,0,,Ауырды (Мурао) Шын күлме, бөке
Dialogue: 0,0:16:31.69,0:16:33.36,Default,,0,0,0,,Мен одан бетер күйзелдім.
Dialogue: 0,0:16:33.45,0:16:35.36,Default,,0,0,0,,(аудитория күлкі)
Dialogue: 0,0:16:35.45,0:16:39.08,Default,,0,0,0,,Финалды екі карта арқылы Арата Ватая жеңді.
Dialogue: 0,0:16:39.16,0:16:41.25,Default,,0,0,0,,Маған Мурао-сан ұнайды.
Dialogue: 0,0:16:42.29,0:16:45.71,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:16:46.58,0:16:48.96,Default,,0,0,0,,Келіңіз, Аратаны жеңіңіз
Dialogue: 0,0:16:50.63,0:16:55.80,Default,,0,0,0,,Сізде талант та, еңбек те бар.
Dialogue: 0,0:16:58.68,0:16:59.51,Default,,0,0,0,,Егер сіз «бар» деп ойласаңыз
Dialogue: 0,0:16:59.60,0:17:01.68,Default,,0,0,0,,Мен жеңілетін шығармын.
Dialogue: 0,0:17:02.68,0:17:05.02,Default,,0,0,0,,«Жоқ» нәрсені көру үшін барыңыз
Dialogue: 0,0:17:08.19,0:17:10.86,Default,,0,0,0,,Шешуші матч қараша айында өтеді.
Dialogue: 0,0:17:10.94,0:17:14.61,Default,,0,0,0,,Батыс Жапонияның өкілі Арата Ватая, шебер.
Dialogue: 0,0:17:14.70,0:17:16.49,Default,,0,0,0,,Патшайым Эму Осака
Dialogue: 0,0:17:16.57,0:17:20.99,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:17:22.95,0:17:25.50,Default,,0,0,0,,Хехехехехехехе
Dialogue: 0,0:17:25.58,0:17:26.75,Default,,0,0,0,,Революция! (Оқушылар қыздар) Гах!
Dialogue: 0,0:17:26.83,0:17:28.00,Default,,0,0,0,,Революция қайтып келеді! (Чихая) Гах!
Dialogue: 0,0:17:28.08,0:17:29.59,Default,,0,0,0,,Ерте жат!
Dialogue: 0,0:17:29.67,0:17:30.50,Default,,0,0,0,,Не дедің, жауыз бала! (Киришима & Серо) Қайтып келдік.
Dialogue: 0,0:17:31.34,0:17:33.05,Default,,0,0,0,,Бардың ба? Императрица, сіз әлі кеттіңіз бе?
Dialogue: 0,0:17:33.13,0:17:35.84,Default,,0,0,0,,Менің ұйықтауға мүмкіндігім жоқ. Сағат небәрі 11.
Dialogue: 0,0:17:35.92,0:17:37.38,Default,,0,0,0,,Қашу мүмкін бе?
Dialogue: 0,0:17:38.01,0:17:39.05,Default,,0,0,0,,Осы жолы сен жұмсаған күшіңе сай нәтижеге қол жеткіздің—
Dialogue: 0,0:17:39.14,0:17:42.06,Default,,0,0,0,,Біз 3 ойын ойнап, жасырын шығып, дүкенге бардық.
Dialogue: 0,0:17:42.14,0:17:43.89,Default,,0,0,0,,Мені анықтап, дәлізге тіке отырғызды.
Dialogue: 0,0:17:43.97,0:17:45.98,Default,,0,0,0,,Ахаха керемет
Dialogue: 0,0:17:46.06,0:17:47.85,Default,,0,0,0,,Хэхе, ах
Dialogue: 0,0:17:48.73,0:17:49.86,Default,,0,0,0,,Чи-чан, кешіріңіз.
Dialogue: 0,0:17:49.94,0:17:52.73,Default,,0,0,0,,Мен ұялы телефонымның батарея жинағын үнемі ұстадым.
Dialogue: 0,0:17:52.82,0:17:54.03,Default,,0,0,0,,Иә
Dialogue: 0,0:17:54.11,0:17:55.86,Default,,0,0,0,,Хмм... жарайды.
Dialogue: 0,0:17:56.57,0:17:58.45,Default,,0,0,0,,Таңға дейін ұста, Мичиру-чан
Dialogue: 0,0:17:58.53,0:17:59.78,Default,,0,0,0,,Мен қараймын.
Dialogue: 0,0:17:59.87,0:18:01.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:01.78,0:18:03.62,Default,,0,0,0,,Чихая-чан
Dialogue: 0,0:18:03.70,0:18:07.46,Default,,0,0,0,,Мен айналамдағыларға адамдар ойлағаннан гөрі көбірек көңіл бөлемін.
Dialogue: 0,0:18:07.54,0:18:10.17,Default,,0,0,0,,Ол мектептегі саяхатқа назарын аударуға тырысады.
Dialogue: 0,0:18:11.21,0:18:13.67,Default,,0,0,0,,Менде басқа мәселелер бар.
Dialogue: 0,0:18:13.75,0:18:15.01,Default,,0,0,0,,Уф
Dialogue: 0,0:18:15.09,0:18:16.80,Default,,0,0,0,,Сіз ұйықтайсыз ба? Қойбана ше?
Dialogue: 0,0:18:16.88,0:18:18.13,Default,,0,0,0,,Чи-чан~ сұрасаң да
Dialogue: 0,0:18:18.13,0:18:19.22,Default,,0,0,0,,Чи-чан~дан сұрасаң да
Dialogue: 0,0:18:18.13,0:18:19.22,Default,,0,0,0,,Шынымен де, бөлшектерді ауыстырыңыз.
Dialogue: 0,0:18:19.22,0:18:19.30,Default,,0,0,0,,Шынымен де, бөлшектерді ауыстырыңыз.
Dialogue: 0,0:18:19.30,0:18:20.09,Default,,0,0,0,,Рахмет Чихая-чан
Dialogue: 0,0:18:19.30,0:18:20.09,Default,,0,0,0,,Шынымен, бөлшектерді ауыстырыңыз.
Dialogue: 0,0:18:20.09,0:18:20.18,Default,,0,0,0,,Рахмет Чихая-чан
Dialogue: 0,0:18:20.18,0:18:21.26,Default,,0,0,0,,Рахмет Чихая-чан
Dialogue: 0,0:18:20.18,0:18:21.26,Default,,0,0,0,,Бұл ысырап.
Dialogue: 0,0:18:22.10,0:18:23.43,Default,,0,0,0,,Мен саған шай сатып алайын.
Dialogue: 0,0:18:23.51,0:18:25.31,Default,,0,0,0,,Сыртта Мұғалім, сіз сонда тұрған жоқсыз ба?
Dialogue: 0,0:18:25.39,0:18:27.52,Default,,0,0,0,,Сіз мені ұзақ уақытқа жібересіз, солай ма?
Dialogue: 0,0:18:37.19,0:18:38.07,Default,,0,0,0,,Ах
Dialogue: 0,0:18:39.86,0:18:41.20,Default,,0,0,0,,Тат...тут...
Dialogue: 0,0:18:41.28,0:18:42.74,Default,,0,0,0,,Тыныш!
Dialogue: 0,0:18:42.83,0:18:44.16,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:18:44.24,0:18:45.24,Default,,0,0,0,,Хмм
Dialogue: 0,0:18:46.58,0:18:47.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:47.50,0:18:50.08,Default,,0,0,0,,Мен өзімді жақсы сезінгендіктен келдім.
Dialogue: 0,0:18:50.17,0:18:52.42,Default,,0,0,0,,Мектепте қосымша сабақтарды жалғыз орындау?
Dialogue: 0,0:18:53.21,0:18:55.30,Default,,0,0,0,,А... а... а...
Dialogue: 0,0:18:55.38,0:18:56.51,Default,,0,0,0,,Эээх…
Dialogue: 0,0:18:56.59,0:18:59.84,Default,,0,0,0,,Не... не? ашу? қайғы? шатасу?
Dialogue: 0,0:18:59.93,0:19:03.43,Default,,0,0,0,,Ал... әзірге 1-сыныптың ұлдары сол бөлмеде.
Dialogue: 0,0:19:03.51,0:19:04.35,Default,,0,0,0,,Иә
Dialogue: 0,0:19:04.43,0:19:06.47,Default,,0,0,0,,Аясе-сан, ерте жат.
Dialogue: 0,0:19:06.56,0:19:07.72,Default,,0,0,0,,Шай…
Dialogue: 0,0:19:07.81,0:19:11.02,Default,,0,0,0,,Мен оны саған аламын. Өтінемін, бөлмеңе бар.
Dialogue: 0,0:19:11.10,0:19:12.31,Default,,0,0,0,,Кездескенше Чихая
Dialogue: 0,0:19:12.40,0:19:14.11,Default,,0,0,0,,Сіз де ерте жатуыңыз керек.
Dialogue: 0,0:19:17.03,0:19:19.24,Default,,0,0,0,,«Ұйқыға кет» деме!
Dialogue: 0,0:19:19.32,0:19:21.82,Default,,0,0,0,,Дұрыс, Чихая-сенсэй, келгенің үшін ақымақсың.
Dialogue: 0,0:19:21.91,0:19:22.74,Default,,0,0,0,,Тайчи!
Dialogue: 0,0:19:22.82,0:19:25.62,Default,,0,0,0,,Мен қалаймын... Сәлем... Сәлем... Сәлем...
Dialogue: 0,0:19:25.70,0:19:26.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:26.83,0:19:29.45,Default,,0,0,0,,Сәлем... Сәлем... Сәлем... Сәлем...
Dialogue: 0,0:19:29.54,0:19:30.83,Default,,0,0,0,,Бұл Харада Сенсей.
Dialogue: 0,0:19:37.25,0:19:39.42,Default,,0,0,0,,Шығыс Жапонияның өкілдері
Dialogue: 0,0:19:42.97,0:19:44.47,Default,,0,0,0,,Батыс Жапония...
Dialogue: 0,0:19:44.55,0:19:46.14,Default,,0,0,0,,Мичиру-чан, батареяны маған қайтар!
Dialogue: 0,0:19:46.22,0:19:47.31,Default,,0,0,0,,Менің ұялы телефоным қайда?
Dialogue: 0,0:19:47.43,0:19:48.47,Default,,0,0,0,,Иә! ?
Dialogue: 0,0:19:48.56,0:19:50.98,Default,,0,0,0,,Ха ха ха... шынымен бе?
Dialogue: 0,0:19:52.44,0:19:54.44,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:19:54.52,0:19:57.94,Default,,0,0,0,,Хмм... Харада мырза...
Dialogue: 0,0:19:58.03,0:19:59.48,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:20:01.82,0:20:05.99,Default,,0,0,0,,Шешуші матчта кімге қолдау көрсетесіз?
Dialogue: 0,0:20:07.08,0:20:10.20,Default,,0,0,0,,Е-е, қайсысы... Мен Харада-сенсейді шештім...
Dialogue: 0,0:20:11.58,0:20:14.42,Default,,0,0,0,,Бұл жігіт керемет.
Dialogue: 0,0:20:14.50,0:20:16.08,Default,,0,0,0,,Ха!
Dialogue: 0,0:20:16.17,0:20:18.80,Default,,0,0,0,,Батыс Жапонияның өкілі... Арата?
Dialogue: 0,0:20:20.59,0:20:24.68,Default,,0,0,0,,Харада Сенсей мен Арата қарсыласты шешеді ме?
Dialogue: 0,0:20:33.27,0:20:34.90,Default,,0,0,0,,Эй, Машима
Dialogue: 0,0:20:34.98,0:20:36.98,Default,,0,0,0,,Бұрын бұл не туралы болды? Аясе-санмен
Dialogue: 0,0:20:37.06,0:20:40.73,Default,,0,0,0,,Ей, мектептегі саяхатқа кешігіп келу тым көзге түседі...
Dialogue: 0,0:20:40.82,0:20:42.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:42.65,0:20:43.99,Default,,0,0,0,,Жарайды... Маджима!
Dialogue: 0,0:20:44.07,0:20:44.95,Default,,0,0,0,,Эй!
Dialogue: 0,0:20:45.03,0:20:46.99,Default,,0,0,0,,Аа, бәрі жақсы.
Dialogue: 0,0:20:48.28,0:20:50.24,Default,,0,0,0,,Жай ұйықтап жатырмын
Dialogue: 0,0:20:50.33,0:20:54.75,Default,,0,0,0,,Машима: Мен бүгін бізден 100 есе шаршадым.
Dialogue: 0,0:20:54.83,0:20:55.92,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:56.00,0:20:57.38,Default,,0,0,0,,Ах (Комано) Жақсы жұмыс.
Dialogue: 0,0:20:58.34,0:21:00.21,Default,,0,0,0,,Сіз ер адамсыз, Деск мырза.
Dialogue: 0,0:21:00.30,0:21:01.13,Default,,0,0,0,,Мен саған көмектесемін
Dialogue: 0,0:21:01.21,0:21:02.92,Default,,0,0,0,,Футон төсеңіз
Dialogue: 0,0:21:05.01,0:21:06.64,Default,,0,0,0,,Мажима
Dialogue: 0,0:21:06.72,0:21:09.14,Default,,0,0,0,,Жеңіске жеткеніміз жақсы болар еді.
Dialogue: 0,0:21:09.81,0:21:12.10,Default,,0,0,0,,Карута онша тәтті емес
Dialogue: 0,0:21:12.18,0:21:13.02,Default,,0,0,0,,Басқа амал жоқ па?!
Dialogue: 0,0:21:15.98,0:21:19.65,Default,,0,0,0,,Жеңіске жетсек жақсы болар еді.
Dialogue: 0,0:21:45.13,0:21:50.14,Default,,0,0,0,,♪～
Dialogue: 0,0:22:46.90,0:22:51.91,Default,,0,0,0,,～♪
Dialogue: 0,0:22:53.41,0:22:59.41,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory