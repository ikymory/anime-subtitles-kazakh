Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.00,0:00:09.92,Default,,0,0,0,,Әй!
Dialogue: 0,0:00:10.01,0:00:10.92,Default,,0,0,0,,Әй!
Dialogue: 0,0:00:11.88,0:00:15.05,Default,,0,0,0,,Такамацуномия кубогы Мурао жеңді
Dialogue: 0,0:00:15.14,0:00:18.60,Default,,0,0,0,,Бұл қос көзілдіріктің дәуірі деп ойладым.
Dialogue: 0,0:00:18.68,0:00:21.18,Default,,0,0,0,,Жаңа бала, қолға ал
Dialogue: 0,0:00:21.27,0:00:23.64,Default,,0,0,0,,Жастықтың күші қорқынышты
Dialogue: 0,0:00:23.73,0:00:26.40,Default,,0,0,0,,Ұстаз, жүрегімдегінің бәрі көрініп тұр.
Dialogue: 0,0:00:26.48,0:00:27.48,Default,,0,0,0,,Ол ағып жатыр.
Dialogue: 0,0:00:29.40,0:00:30.32,Default,,0,0,0,,Ұф! Ах
Dialogue: 0,0:00:33.40,0:00:35.86,Default,,0,0,0,,Ах, мен жеңіліп қалдым.
Dialogue: 0,0:00:35.95,0:00:38.83,Default,,0,0,0,,Физикалық тұрғыдан менің мүмкіндіктерім таусылып жатыр.
Dialogue: 0,0:00:38.91,0:00:41.87,Default,,0,0,0,,Хаха...
Dialogue: 0,0:00:42.91,0:00:46.21,Default,,0,0,0,,Мен Такамацуномия кубогын жеңіп алдым
Dialogue: 0,0:00:46.29,0:00:49.09,Default,,0,0,0,,Менің ойымша, ешқандай физикалық әлсіздік болмады ...
Dialogue: 0,0:00:51.50,0:00:54.92,Default,,0,0,0,,Одан кейін ауыса алмадым.
Dialogue: 0,0:00:55.88,0:00:57.30,Default,,0,0,0,,Тайчи…
Dialogue: 0,0:00:57.84,0:01:01.18,Default,,0,0,0,,Жаңаны қалай қуып жетемін...
Dialogue: 0,0:01:02.18,0:01:04.23,Default,,0,0,0,,Қалай жеңуге болады...
Dialogue: 0,0:01:06.52,0:01:09.19,Default,,0,0,0,,Мен терең және терең сүңгуге тырыстым.
Dialogue: 0,0:01:13.36,0:01:17.16,Default,,0,0,0,,Ол кезде «чиха» соңында шықпады.
Dialogue: 0,0:01:18.36,0:01:20.37,Default,,0,0,0,,Мен кетсем не болар еді деп ойлаймын.
Dialogue: 0,0:01:21.83,0:01:25.87,Default,,0,0,0,,Тайчи әрқашан менің бірінші мақсатым болды.
Dialogue: 0,0:01:26.96,0:01:30.09,Default,,0,0,0,,Егер мен шыққан болсам, мені қорғауға болар ма еді?
Dialogue: 0,0:01:31.13,0:01:34.21,Default,,0,0,0,,Тайчи оны қабылдағаннан кейін толқын өзгерді деп ойлаймын.
Dialogue: 0,0:01:37.18,0:01:39.01,Default,,0,0,0,,Мен ұрысқым келеді
Dialogue: 0,0:01:39.09,0:01:41.68,Default,,0,0,0,,қайта-қайта
Dialogue: 0,0:01:42.43,0:01:43.81,Default,,0,0,0,,Жаңа аға
Dialogue: 0,0:01:43.89,0:01:46.14,Default,,0,0,0,,Тоқта... қытықтайды...
Dialogue: 0,0:01:46.23,0:01:47.35,Default,,0,0,0,,Хаха...
Dialogue: 0,0:01:47.44,0:01:51.48,Default,,0,0,0,,Шун қазірдің өзінде мектеп оқушысы, бірақ ол әлі бала.
Dialogue: 0,0:01:51.56,0:01:52.57,Default,,0,0,0,,Хаха
Dialogue: 0,0:01:52.65,0:01:54.15,Default,,0,0,0,,Жаңа аға
Dialogue: 0,0:01:54.23,0:01:57.36,Default,,0,0,0,,Мен және Коны Хигаши Фудзиока қабылдады.
Dialogue: 0,0:01:57.45,0:01:59.20,Default,,0,0,0,,Менің кішілерім, бірге.
Dialogue: 0,0:02:00.20,0:02:02.53,Default,,0,0,0,,Карута клубын жасайық!
Dialogue: 0,0:02:03.74,0:02:04.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:04.99,0:02:10.00,Default,,0,0,0,,♪～
Dialogue: 0,0:03:09.89,0:03:14.90,Default,,0,0,0,,～♪
Dialogue: 0,0:03:19.74,0:03:21.07,Default,,0,0,0,,Барлық Жапонияның Карута қауымдастығы —
Dialogue: 0,0:03:21.15,0:03:23.99,Default,,0,0,0,,«Тай кубогы» бейресми турнирі
Dialogue: 0,0:03:24.07,0:03:25.41,Default,,0,0,0,,Қатысу құқығы
Dialogue: 0,0:03:25.49,0:03:30.25,Default,,0,0,0,,Тайчидің туған күнін тойлауға дайын Карута ойыншылары (дәрежесіне қарамастан)
Dialogue: 0,0:03:30.33,0:03:33.50,Default,,0,0,0,,Қатысушылар 36 адам
Dialogue: 0,0:03:34.21,0:03:37.63,Default,,0,0,0,,Неліктен бұлай болды...
Dialogue: 0,0:03:37.71,0:03:40.59,Default,,0,0,0,,Ал, мен ережелерді түсіндіремін.
Dialogue: 0,0:03:40.67,0:03:43.30,Default,,0,0,0,,Біріншіден, бұл жолы үш адамдық Генпей шайқасы.
Dialogue: 0,0:03:43.38,0:03:44.68,Default,,0,0,0,,Генпей соғысы?
Dialogue: 0,0:03:45.30,0:03:48.39,Default,,0,0,0,,Бірақ мақсат тек команданың жеңісі емес.
Dialogue: 0,0:03:48.47,0:03:50.64,Default,,0,0,0,,«Көп картаны өзіңіз алыңыз»
Dialogue: 0,0:03:50.73,0:03:54.44,Default,,0,0,0,,4 ойыннан кейін ең көп картаны алған адам жеңімпаз болады.
Dialogue: 0,0:03:55.48,0:04:00.57,Default,,0,0,0,,Бұл 3-тен 3-ке сәйкестік, бірақ бұл 1-ден 5-ке сәйкестік.
Dialogue: 0,0:04:00.65,0:04:04.70,Default,,0,0,0,,Бірақ егер сіздің әріптестеріңіз тым әлсіз болса, сіз жеңіс ұпайларын ала алмайсыз.
Dialogue: 0,0:04:04.78,0:04:07.41,Default,,0,0,0,,Сонымен қатар, егер сіздің әріптестеріңіз тым күшті болса
Dialogue: 0,0:04:07.49,0:04:09.24,Default,,0,0,0,,Жеке ұпайларды алу мүмкін емес
Dialogue: 0,0:04:09.33,0:04:12.71,Default,,0,0,0,,Бұл қандай сыйлық?
Dialogue: 0,0:04:12.79,0:04:15.63,Default,,0,0,0,,Мен көп нәрсені ойладым, бірақ менде бюджет жоқ ...
Dialogue: 0,0:04:15.71,0:04:17.79,Default,,0,0,0,,Жүлде – Тайчидің сүйісі (Тайчи)...
Dialogue: 0,0:04:17.79,0:04:18.38,Default,,0,0,0,,Жүлде — Тайчидің сүйісі (Тайчи)...
Dialogue: 0,0:04:17.79,0:04:18.38,Default,,0,0,0,,(Әйелдердің қошеметі)
Dialogue: 0,0:04:18.38,0:04:18.46,Default,,0,0,0,,(Әйелдердің қошеметі)
Dialogue: 0,0:04:18.46,0:04:19.59,Default,,0,0,0,,О.
Dialogue: 0,0:04:18.46,0:04:19.59,Default,,0,0,0,,(Әйелдердің қошеметі)
Dialogue: 0,0:04:19.59,0:04:19.67,Default,,0,0,0,,О.
Dialogue: 0,0:04:19.75,0:04:21.34,Default,,0,0,0,,Ал... күте тұрыңыз
Dialogue: 0,0:04:21.42,0:04:22.59,Default,,0,0,0,,О.
Dialogue: 0,0:04:22.67,0:04:24.01,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:04:24.09,0:04:26.59,Default,,0,0,0,,Мен басты кейіпкер емеспін бе?
Dialogue: 0,0:04:26.68,0:04:28.68,Default,,0,0,0,,Жүлдені неге сен беріп жатырсың?
Dialogue: 0,0:04:28.76,0:04:30.72,Default,,0,0,0,,Сүйісу...
Dialogue: 0,0:04:31.22,0:04:35.14,Default,,0,0,0,,Кешіріңіз... Кешіріңіз, Тайчи, бірақ менде ақша қалмады.
Dialogue: 0,0:04:35.23,0:04:37.90,Default,,0,0,0,,Барлығы Тайчиді жақсы көріп, бірге жиналды.
Dialogue: 0,0:04:37.98,0:04:39.65,Default,,0,0,0,,Менің ойымша, сүйіспеншілік те жақсы болар еді.
Dialogue: 0,0:04:39.73,0:04:42.53,Default,,0,0,0,,Жоқ, жоқ, жоқ, сөзсіз әртүрлі адамдар бар.
Dialogue: 0,0:04:42.61,0:04:44.90,Default,,0,0,0,,Чихая-чан, кешіріңіз.
Dialogue: 0,0:04:44.99,0:04:45.95,Default,,0,0,0,,Иә
Dialogue: 0,0:04:46.03,0:04:48.66,Default,,0,0,0,,Қарсы топтың позициясы (Чихая) Бұл...
Dialogue: 0,0:04:50.24,0:04:54.25,Default,,0,0,0,,Бұл команданың аты-жөні.
Dialogue: 0,0:04:54.33,0:04:56.75,Default,,0,0,0,,Уау қолдан жасалған сүйкімді
Dialogue: 0,0:04:56.83,0:04:59.00,Default,,0,0,0,,Чихая-чан үлгерді ме?
Dialogue: 0,0:05:00.17,0:05:03.34,Default,,0,0,0,,Хехе, араластырып шешемін.
Dialogue: 0,0:05:08.85,0:05:10.56,Default,,0,0,0,,Жақсы тепе-теңдік
Dialogue: 0,0:05:10.64,0:05:12.68,Default,,0,0,0,,Мен жалықтым, сондықтан мен сенің соңынан ердім.
Dialogue: 0,0:05:12.77,0:05:14.81,Default,,0,0,0,,Мен жалықтым, сондықтан мен сіздің артыңыздан ердім.
Dialogue: 0,0:05:14.89,0:05:17.19,Default,,0,0,0,,Бізде де жақсы тепе-теңдік бар.
Dialogue: 0,0:05:17.69,0:05:19.56,Default,,0,0,0,,Иә, балалар?
Dialogue: 0,0:05:20.19,0:05:21.57,Default,,0,0,0,,Йорошику!
Dialogue: 0,0:05:22.32,0:05:25.45,Default,,0,0,0,,Сіз қанша жаста болсаңыз да, сіз жаңа қиындықтарды жеңе аласыз.
Dialogue: 0,0:05:25.53,0:05:27.20,Default,,0,0,0,,Шеберлермен байланыс
Dialogue: 0,0:05:27.28,0:05:29.82,Default,,0,0,0,,Не болса да, мен жеңілмеймін (Хироси) Мен жеңілмеймін!
Dialogue: 0,0:05:29.91,0:05:32.20,Default,,0,0,0,,Командаластар ең қатал
Dialogue: 0,0:05:32.29,0:05:34.91,Default,,0,0,0,,Турнирдің бұл түрі – фарс.
Dialogue: 0,0:05:35.00,0:05:37.21,Default,,0,0,0,,Өзіңіздің карутаңыз ыдырап кетпей ме?
Dialogue: 0,0:05:37.29,0:05:38.75,Default,,0,0,0,,Сонымен... Судо мырзаға дейін?
Dialogue: 0,0:05:38.83,0:05:40.42,Default,,0,0,0,,Мен шыға алмаймын!
Dialogue: 0,0:05:40.50,0:05:43.50,Default,,0,0,0,,Менің бұл футболканы кигім келмейді және тойлағым келмейді!
Dialogue: 0,0:05:44.05,0:05:46.38,Default,,0,0,0,,Бірақ Мочида мырза мұны істеуімді өтінді.
Dialogue: 0,0:05:47.68,0:05:50.14,Default,,0,0,0,,Бүгін біз оқырмандарымызды шақырғымыз келеді
Dialogue: 0,0:05:50.22,0:05:53.97,Default,,0,0,0,,Неліктен мұндай үлкен мәселе...
Dialogue: 0,0:05:54.06,0:05:54.89,Default,,0,0,0,,Жұмысты бастау
Dialogue: 0,0:05:55.68,0:05:57.31,Default,,0,0,0,,Нанивадуни~
Dialogue: 0,0:05:57.39,0:06:00.61,Default,,0,0,0,,Сакуяко но Хана ~ Фуюгомоори
Dialogue: 0,0:06:00.69,0:06:03.48,Default,,0,0,0,,Генпейге қарсы 36 адамнан тұратын 12 команда жарысады
Dialogue: 0,0:06:03.48,0:06:05.15,Default,,0,0,0,,Генпейге қарсы 36 адамнан тұратын 12 команда жарысады
Dialogue: 0,0:06:03.48,0:06:05.15,Default,,0,0,0,,Енді Харубето
Dialogue: 0,0:06:05.15,0:06:06.03,Default,,0,0,0,,Енді Харубето
Dialogue: 0,0:06:06.11,0:06:11.16,Default,,0,0,0,,Сакуяко но Хана
Dialogue: 0,0:06:13.49,0:06:16.16,Default,,0,0,0,,Енді Харубето
Dialogue: 0,0:06:16.25,0:06:20.92,Default,,0,0,0,,Сакуяко но Хана
Dialogue: 0,0:06:24.00,0:06:25.80,Default,,0,0,0,,Бұл тым алыс~ (Чихая) А.
Dialogue: 0,0:06:25.88,0:06:27.09,Default,,0,0,0,,Такино деген кім? (Макото)
Dialogue: 0,0:06:27.17,0:06:28.05,Default,,0,0,0,,Хмм
Dialogue: 0,0:06:28.59,0:06:31.05,Default,,0,0,0,,100 парақты жаттау қиын.
Dialogue: 0,0:06:31.14,0:06:32.85,Default,,0,0,0,,Кейбір шоттар қолжетімсіз.
Dialogue: 0,0:06:34.14,0:06:35.72,Default,,0,0,0,,Әдеттегіден мүлде басқаша
Dialogue: 0,0:06:35.81,0:06:37.10,Default,,0,0,0,,Не!
Dialogue: 0,0:06:37.18,0:06:38.77,Default,,0,0,0,,Кеттік...
Dialogue: 0,0:06:38.85,0:06:43.19,Default,,0,0,0,,Бұл әдеттегіден мүлдем басқа, менің одақтасым менің одақтасым немесе басқа нәрсе емес.
Dialogue: 0,0:06:48.36,0:06:49.70,Default,,0,0,0,,Қарсыластармен
Dialogue: 0,0:06:52.41,0:06:55.08,Default,,0,0,0,,Сондай сағыныш (Тайчи) Ах.
Dialogue: 0,0:06:56.29,0:06:59.91,Default,,0,0,0,,Генпей соғысынан бері...
Dialogue: 0,0:07:01.04,0:07:02.96,Default,,0,0,0,,Бұл Хироси! Хироси Кинаши!
Dialogue: 0,0:07:04.04,0:07:05.75,Default,,0,0,0,,Бар болғаны 5 дана...
Dialogue: 0,0:07:05.84,0:07:07.46,Default,,0,0,0,,5 дана...
Dialogue: 0,0:07:08.46,0:07:10.38,Default,,0,0,0,,Сол күннен бастап...
Dialogue: 0,0:07:14.39,0:07:17.35,Default,,0,0,0,,Сол кездегі бөлмеде
Dialogue: 0,0:07:18.77,0:07:21.23,Default,,0,0,0,,Карута ойнайтын адамдармен қоршалған
Dialogue: 0,0:07:22.81,0:07:26.44,Default,,0,0,0,,Мен сол кездегіден күшті болдым ба деп ойлаймын.
Dialogue: 0,0:07:28.82,0:07:32.20,Default,,0,0,0,,Мен бүгін 18-ге толдым.
Dialogue: 0,0:07:32.78,0:07:34.82,Default,,0,0,0,,4 ойын аяқталды
Dialogue: 0,0:07:38.41,0:07:40.50,Default,,0,0,0,,Уау, бұл көңілсіз!
Dialogue: 0,0:07:40.58,0:07:43.83,Default,,0,0,0,,Жеке ұпай жоғары болса да, жеңіс ұпайы төмен болса жаман ба?
Dialogue: 0,0:07:43.92,0:07:45.67,Default,,0,0,0,,1-орынның қорытынды қорытындысы
Dialogue: 0,0:07:45.75,0:07:47.96,Default,,0,0,0,,105 ұпаймен 1 орынға теңестірілді!
Dialogue: 0,0:07:48.05,0:07:49.67,Default,,0,0,0,,Аясе мен Маджима! (Чихая/Тайчи) Иә?
Dialogue: 0,0:07:50.21,0:07:51.42,Default,,0,0,0,,А...
Dialogue: 0,0:07:53.01,0:07:56.47,Default,,0,0,0,,(жүрек соғысы)
Dialogue: 0,0:07:53.01,0:07:56.47,Default,,0,0,0,,Сонымен... онда ұтып алған жүлде...
Dialogue: 0,0:07:57.31,0:08:00.02,Default,,0,0,0,,Бірінші орын үшін галстук болмайды. Тайчи, бізде шешуші матч болады!
Dialogue: 0,0:08:00.52,0:08:02.56,Default,,0,0,0,,Иә, уақыт бітті.
Dialogue: 0,0:08:02.64,0:08:06.23,Default,,0,0,0,,Сіз бұл орынды сағат 4-ке дейін жалға ала аласыз, сондықтан шешуші матчты өз клубыңыздың әрекеттерімен ойнаңыз.
Dialogue: 0,0:08:06.31,0:08:07.90,Default,,0,0,0,,Иә, бас тарт!
Dialogue: 0,0:08:07.98,0:08:08.90,Default,,0,0,0,,(Кёко) Ах…
Dialogue: 0,0:08:08.90,0:08:10.15,Default,,0,0,0,,(Кёко) Ах…
Dialogue: 0,0:08:08.90,0:08:10.15,Default,,0,0,0,,Тайчи-нии-чан күшті болды.
Dialogue: 0,0:08:10.15,0:08:10.23,Default,,0,0,0,,Тайчи-нии-чан күшті болды.
Dialogue: 0,0:08:10.23,0:08:11.44,Default,,0,0,0,,Қарным ашты (қыз) Барлығын жинаймын.
Dialogue: 0,0:08:10.23,0:08:11.44,Default,,0,0,0,,Тайчи-нии-чан күшті болды.
Dialogue: 0,0:08:11.44,0:08:12.53,Default,,0,0,0,,Қарным ашты (қыз) Барлығын жинаймын.
Dialogue: 0,0:08:12.61,0:08:13.91,Default,,0,0,0,,Маған шаңсорғыш әкеліңіз
Dialogue: 0,0:08:13.99,0:08:16.66,Default,,0,0,0,,Менің ойымша, бұл жақсы жылдамдықты өзгерту болды.
Dialogue: 0,0:08:16.74,0:08:18.78,Default,,0,0,0,,Мен көптен бері ойнамадым.
Dialogue: 0,0:08:18.87,0:08:21.62,Default,,0,0,0,,Бірдеңе жегіңіз келе ме? Рион (Хината) кеттік
Dialogue: 0,0:08:21.70,0:08:22.54,Default,,0,0,0,,Сен
Dialogue: 0,0:08:22.62,0:08:24.92,Default,,0,0,0,,Бәріміз шие гүлін тамашалап, үйге қайтайық
Dialogue: 0,0:08:25.00,0:08:26.17,Default,,0,0,0,,Эй, Тайчи-кун да.
Dialogue: 0,0:08:28.25,0:08:30.42,Default,,0,0,0,,Бүгінгі күн үшін барлығыңызға рахмет!
Dialogue: 0,0:08:30.50,0:08:31.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:33.13,0:08:35.51,Default,,0,0,0,,Мұғалімдер маған әрқашан мақсат қою керектігін айтады.
Dialogue: 0,0:08:35.59,0:08:40.64,Default,,0,0,0,,Мен Карутаны қатал деп ойладым, өйткені маған тақырып бар деп айтты.
Dialogue: 0,0:08:40.72,0:08:42.56,Default,,0,0,0,,Бүгінгі күн өте қызық болды.
Dialogue: 0,0:08:42.64,0:08:44.35,Default,,0,0,0,,Бұл қызықты болды!
Dialogue: 0,0:08:44.85,0:08:47.02,Default,,0,0,0,,Карутаның бір түрі ғана емес.
Dialogue: 0,0:08:47.10,0:08:48.94,Default,,0,0,0,,Біртүрлі ережелермен қайталап көрейік
Dialogue: 0,0:08:49.02,0:08:50.52,Default,,0,0,0,,Фотоға түсейік!
Dialogue: 0,0:08:57.62,0:08:58.91,Default,,0,0,0,,Мен...
Dialogue: 0,0:09:00.58,0:09:02.50,Default,,0,0,0,,Күшті болдым ба деп ойлаймын
Dialogue: 0,0:09:03.75,0:09:07.04,Default,,0,0,0,,(Спорт клубы мүшелерінің әндері)
Dialogue: 0,0:09:26.98,0:09:28.60,Default,,0,0,0,,Иә? Тайчи
Dialogue: 0,0:09:30.98,0:09:34.78,Default,,0,0,0,,Не болды? Бүгін сіздің жаттығудан демалысыңыз болды, солай ма?
Dialogue: 0,0:09:34.86,0:09:37.74,Default,,0,0,0,,Жоқ, мен аздап оқимын деп ойладым.
Dialogue: 0,0:09:37.82,0:09:39.87,Default,,0,0,0,,Уау, байсалды
Dialogue: 0,0:09:39.95,0:09:43.24,Default,,0,0,0,,Чихая ше? (Чихая) Мен, хехехе...
Dialogue: 0,0:09:44.08,0:09:46.75,Default,,0,0,0,,Тозған перделерді жаңартыңыз
Dialogue: 0,0:09:50.88,0:09:52.38,Default,,0,0,0,,Ах! (Тайчи) Иә?
Dialogue: 0,0:09:52.46,0:09:54.84,Default,,0,0,0,,Ұзақ! Неліктен не?
Dialogue: 0,0:09:54.92,0:09:58.01,Default,,0,0,0,,Сіз бұл әрекетке дайын болмасаңыз да, сіз мұндай нәрсені жиі жасайсыз.
Dialogue: 0,0:09:58.63,0:10:00.85,Default,,0,0,0,,Өйткені жаңа семестр басталады
Dialogue: 0,0:10:00.93,0:10:02.47,Default,,0,0,0,,Жаңа мүшелер келеді.
Dialogue: 0,0:10:02.56,0:10:05.14,Default,,0,0,0,,Себебі мен клуб бөлмесін жайлы сезінгім келді~
Dialogue: 0,0:10:19.49,0:10:22.45,Default,,0,0,0,,Сіз мұны істейсіз бе? Taichi Cup 1-орын шешуші матч!
Dialogue: 0,0:10:23.16,0:10:24.37,Default,,0,0,0,,Идиот, жарайды.
Dialogue: 0,0:10:24.45,0:10:28.08,Default,,0,0,0,,Неліктен, не үшін? Мен барынша тырыстым~
Dialogue: 0,0:10:28.16,0:10:32.25,Default,,0,0,0,,Бірақ мен Чихая бұл ережемен мықты болады деп ойламадым.
Dialogue: 0,0:10:32.34,0:10:34.17,Default,,0,0,0,,Себебі мен мұны түсіндім
Dialogue: 0,0:10:35.00,0:10:37.38,Default,,0,0,0,,Бұл ереже бойынша бос карталар жоқ, солай ма?
Dialogue: 0,0:10:37.47,0:10:40.93,Default,,0,0,0,,Бар күшіммен секіріп шыққаным жақсы болды деп ойлаймын.
Dialogue: 0,0:10:41.80,0:10:43.85,Default,,0,0,0,,Мен Тайчидің күшті екенін білдім.
Dialogue: 0,0:10:43.93,0:10:47.77,Default,,0,0,0,,Әдетте мен 100 бетті жаттауды көтере алмаймын.
Dialogue: 0,0:10:47.85,0:10:48.68,Default,,0,0,0,,Енді де!
Dialogue: 0,0:10:52.02,0:10:54.11,Default,,0,0,0,,Сол жерде Генпей соғысы
Dialogue: 0,0:10:55.23,0:10:56.86,Default,,0,0,0,,Бірінші команда
Dialogue: 0,0:11:00.28,0:11:01.70,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:03.28,0:11:04.45,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:11:05.33,0:11:07.91,Default,,0,0,0,,Мен 6-сыныпта оқып жүрген кезімде (Чихая) иә?
Dialogue: 0,0:11:08.00,0:11:10.00,Default,,0,0,0,,Бізде мектепте карута бойынша турнир өтті.
Dialogue: 0,0:11:10.08,0:11:15.50,Default,,0,0,0,,Әй, мен жасадым, мен жасадым, бұл сағыныш
Dialogue: 0,0:11:15.59,0:11:18.92,Default,,0,0,0,,Бұл кезде Аратаның көзілдірігі жоқ болатын.
Dialogue: 0,0:11:19.63,0:11:23.72,Default,,0,0,0,,Әй, жоқ болды. Менің ойымша, бұл бәрібір қарға.
Dialogue: 0,0:11:23.80,0:11:25.89,Default,,0,0,0,,Арата оны дәлізден алғанын айтты...
Dialogue: 0,0:11:25.97,0:11:26.93,Default,,0,0,0,,Бұл
Dialogue: 0,0:11:28.27,0:11:31.69,Default,,0,0,0,,Оны алып, жасырған мен едім...
Dialogue: 0,0:11:34.27,0:11:37.27,Default,,0,0,0,,Ха! ? Расында ма?
Dialogue: 0,0:11:37.36,0:11:38.40,Default,,0,0,0,,Иә
Dialogue: 0,0:11:38.48,0:11:40.36,Default,,0,0,0,,Не... неге?
Dialogue: 0,0:11:41.53,0:11:44.37,Default,,0,0,0,,Себебі мен Аратадан жеңілгім келмеді
Dialogue: 0,0:11:45.07,0:11:46.16,Default,,0,0,0,,Ха...
Dialogue: 0,0:11:46.95,0:11:50.29,Default,,0,0,0,,Бұл... Тайчи... Тайчи болды.
Dialogue: 0,0:11:50.37,0:11:52.33,Default,,0,0,0,,Бұл жақсы емес, бұл жасырын
Dialogue: 0,0:11:52.42,0:11:53.25,Default,,0,0,0,,Иә...
Dialogue: 0,0:11:57.09,0:12:00.26,Default,,0,0,0,,Машима, сен... сен сондай керемет жігітсің.
Dialogue: 0,0:12:02.68,0:12:04.97,Default,,0,0,0,,Чихаяға айтпа
Dialogue: 0,0:12:06.39,0:12:09.10,Default,,0,0,0,,Мен Чихаяның мені жек көргенін қаламаймын.
Dialogue: 0,0:12:12.31,0:12:13.35,Default,,0,0,0,,Иә...
Dialogue: 0,0:12:16.52,0:12:17.61,Default,,0,0,0,,<Эрен басынан бері мүлде өзгерген жоқ. ➡
Dialogue: 0,0:12:18.48,0:12:19.69,Default,,0,0,0,,<Эрен басынан бері мүлде өзгерген жоқ. ➡
Dialogue: 0,0:12:20.65,0:12:23.36,Default,,0,0,0,,Мен ергежейлі емес адам болғым келді.
Dialogue: 0,0:12:29.74,0:12:32.87,Default,,0,0,0,,Мен Чихаяны жақсы көремін
Dialogue: 0,0:12:48.10,0:12:49.51,Default,,0,0,0,,Өзіңді тым жоғары қоя бастадың.
Dialogue: 0,0:12:50.72,0:12:53.39,Default,,0,0,0,,Неліктен Тайчи Неге...
Dialogue: 0,0:12:53.48,0:12:56.94,Default,,0,0,0,,Неге үнемі жалғызсың... Неге?
Dialogue: 0,0:12:57.86,0:12:59.44,Default,,0,0,0,,Неге...
Dialogue: 0,0:13:01.82,0:13:04.03,Default,,0,0,0,,Мен Чихаяны жақсы көремін
Dialogue: 0,0:13:13.66,0:13:14.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:15.08,0:13:17.50,Default,,0,0,0,,Бұл өтірік, Чихая.
Dialogue: 0,0:13:18.17,0:13:21.05,Default,,0,0,0,,Бұл өтірік Бұл өтірік
Dialogue: 0,0:13:22.09,0:13:25.26,Default,,0,0,0,,Чихая...
Dialogue: 0,0:13:26.01,0:13:29.09,Default,,0,0,0,,Маған ешқашан өсірілмеген тырнақтар ұнайды.
Dialogue: 0,0:13:29.68,0:13:33.02,Default,,0,0,0,,Саусақтар мен шаштар
Dialogue: 0,0:13:34.68,0:13:37.39,Default,,0,0,0,,Аузы ақымақтай ашылады
Dialogue: 0,0:13:38.10,0:13:39.86,Default,,0,0,0,,Күлімдеген жүз
Dialogue: 0,0:13:42.02,0:13:45.15,Default,,0,0,0,,Кішкентай кезімнен
Dialogue: 0,0:14:02.88,0:14:04.05,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:14:05.38,0:14:06.97,Default,,0,0,0,,Барлығы емес.
Dialogue: 0,0:14:08.93,0:14:11.76,Default,,0,0,0,,Тек Чихая ғана Арата туралы ойлайды...
Dialogue: 0,0:14:13.47,0:14:14.68,Default,,0,0,0,,Жаңа...
Dialogue: 0,0:14:18.14,0:14:19.60,Default,,0,0,0,,Егер сізге ұнаса
Dialogue: 0,0:14:19.69,0:14:21.77,Default,,0,0,0,,Ендеше бірге карутаны ойнайық
Dialogue: 0,0:14:21.86,0:14:23.27,Default,,0,0,0,,Қандай жаңалық бар?
Dialogue: 0,0:14:23.98,0:14:25.32,Default,,0,0,0,,бірге
Dialogue: 0,0:14:27.61,0:14:29.11,Default,,0,0,0,,Тірі бол
Dialogue: 0,0:14:32.58,0:14:37.04,Default,,0,0,0,,(Спорт клубы мүшелерінің әндері)
Dialogue: 0,0:14:44.75,0:14:47.92,Default,,0,0,0,,Ой~ Балалар, тезірек үйге қайтыңдар.
Dialogue: 0,0:15:05.57,0:15:06.53,Default,,0,0,0,,Иә
Dialogue: 0,0:15:15.49,0:15:18.37,Default,,0,0,0,,Мен не істеп жатырмын?
Dialogue: 0,0:15:19.58,0:15:24.34,Default,,0,0,0,,Мен осы уақытқа дейін ешкімнің сезімін қабылдаған емеспін.
Dialogue: 0,0:15:25.67,0:15:27.84,Default,,0,0,0,,Қоңырауға жоғалып кеткендей...
Dialogue: 0,0:15:28.38,0:15:32.34,Default,,0,0,0,,Чихая мұндай кішкентай дауысты шығара алмайды
Dialogue: 0,0:15:33.64,0:15:36.18,Default,,0,0,0,,Мен оны ести алмаймын, өйткені ол нашар «сезінеді».
Dialogue: 0,0:15:40.14,0:15:41.48,Default,,0,0,0,,Барша адамның ішінен… сен бе
Dialogue: 0,0:15:57.03,0:15:58.95,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:16:16.39,0:16:19.06,Default,,0,0,0,,Жаңа семестр басталып, қабілеттілік тесті аяқталғаннан кейін
Dialogue: 0,0:16:19.14,0:16:21.43,Default,,0,0,0,,Жақында қабылдау рәсімі өтеді және жаңа студенттерді бірден қарсы алады.
Dialogue: 0,0:16:21.52,0:16:24.52,Default,,0,0,0,,Осы жылы үйірме жұмыстары туралы не істейсіз?
Dialogue: 0,0:16:24.60,0:16:27.77,Default,,0,0,0,,Республикалық турнирде жеңімпаз атанған мектепті алдыңғы қатарға шығару
Dialogue: 0,0:16:27.86,0:16:31.82,Default,,0,0,0,,Бұл қиын деп ойласаңыз, бұл жеңіліс, бірақ бұл көңілді сияқты.
Dialogue: 0,0:16:31.90,0:16:34.74,Default,,0,0,0,,Адамдарға карутаның қызығын қалай түсінуге болады
Dialogue: 0,0:16:34.82,0:16:36.78,Default,,0,0,0,,Өйткені, әдеби көзқарас та
Dialogue: 0,0:16:36.87,0:16:41.20,Default,,0,0,0,,Кана-чан, көңіліңді түсірме. Сен қырылған бассың. Мен тағы келемін.
Dialogue: 0,0:16:41.29,0:16:43.50,Default,,0,0,0,,Біз Маджиманы бастыққа шығаруымыз керек.
Dialogue: 0,0:16:43.58,0:16:44.83,Default,,0,0,0,,Миха да, онша емес.
Dialogue: 0,0:16:44.92,0:16:47.84,Default,,0,0,0,,Олай болса, әйелдерге тоқталайық...
Dialogue: 0,0:16:48.79,0:16:51.63,Default,,0,0,0,,Бағасын жақсартқандар мен көтермегендер
Dialogue: 0,0:16:52.30,0:16:54.34,Default,,0,0,0,,Бұл жаңа үшінші курс қабілеттілік сынағы
Dialogue: 0,0:16:54.43,0:16:57.22,Default,,0,0,0,,Бұл келесі жылға маңызды нұсқаулық болады.
Dialogue: 0,0:16:57.30,0:17:01.31,Default,,0,0,0,,Мен сіздердің әрбір әлсіз тұстарыңызды анықтап, оларды болашақта пайдалануларыңызды қалаймын.
Dialogue: 0,0:17:06.44,0:17:09.15,Default,,0,0,0,,Қауыннан жасалған үш нан және екі шоколадты бұрау, өтінемін.
Dialogue: 0,0:17:09.23,0:17:11.98,Default,,0,0,0,,Протеинді көбірек жеу керек!
Dialogue: 0,0:17:12.07,0:17:13.53,Default,,0,0,0,,Ах, онда якисоба наны...
Dialogue: 0,0:17:13.61,0:17:15.15,Default,,0,0,0,,Хот-дог иә
Dialogue: 0,0:17:16.41,0:17:18.53,Default,,0,0,0,,Уф... иә?
Dialogue: 0,0:17:19.12,0:17:23.41,Default,,0,0,0,,Біз не істеуіміз керек? Кеңес... Тек Никуман-кунның қолынан келеді.
Dialogue: 0,0:17:24.75,0:17:27.17,Default,,0,0,0,,Жаратылыстану-математика бойынша 1-ші жалпы рейтинг!
Dialogue: 0,0:17:27.25,0:17:29.92,Default,,0,0,0,,Ой, сен істедің, деск-кун!
Dialogue: 0,0:17:30.00,0:17:31.46,Default,,0,0,0,,Уау~ Уау~
Dialogue: 0,0:17:31.55,0:17:32.84,Default,,0,0,0,,Машима, жақсысың ба?
Dialogue: 0,0:17:32.92,0:17:33.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:33.92,0:17:36.18,Default,,0,0,0,,Маджима Жақсысың ба?
Dialogue: 0,0:17:36.26,0:17:39.22,Default,,0,0,0,,Карута клубы: Анам мені жұмыстан шығаруға мәжбүрлей алмайды ма?
Dialogue: 0,0:17:39.22,0:17:40.05,Default,,0,0,0,,Карута клубы: Анам мені жұмыстан шығаруға мәжбүрлей алмайды ма?
Dialogue: 0,0:17:39.22,0:17:40.05,Default,,0,0,0,,А...
Dialogue: 0,0:17:41.10,0:17:43.43,Default,,0,0,0,,Ал... Дұрыс, Деск мырза, егер солай болса.
Dialogue: 0,0:17:43.52,0:17:45.98,Default,,0,0,0,,Мүлдем қарсымын Мүлдем қарсымын
Dialogue: 0,0:17:46.06,0:17:47.85,Default,,0,0,0,,Ереуіл ме, тізе бүгіп...
Dialogue: 0,0:17:47.94,0:17:49.06,Default,,0,0,0,,Олардың екеуі
Dialogue: 0,0:17:50.44,0:17:51.94,Default,,0,0,0,,Жарайсың ба? Консультация
Dialogue: 0,0:17:56.99,0:18:00.28,Default,,0,0,0,,Жарайды. Жай ғана тынышталып, қолжазбадағыдай әрекет етіңіз.
Dialogue: 0,0:18:00.37,0:18:01.20,Default,,0,0,0,,Иә
Dialogue: 0,0:18:04.79,0:18:07.25,Default,,0,0,0,,Иә? Ал Тайчи ше?
Dialogue: 0,0:18:07.33,0:18:08.96,Default,,0,0,0,,Аа, Аясе-сан, кешіріңіз.
Dialogue: 0,0:18:12.80,0:18:16.13,Default,,0,0,0,,Кешіріңіз, осындай уақытта.
Dialogue: 0,0:18:16.63,0:18:18.22,Default,,0,0,0,,Қолжазбаға түзетулер
Dialogue: 0,0:18:22.18,0:18:23.18,Default,,0,0,0,,Га
Dialogue: 0,0:18:27.56,0:18:30.85,Default,,0,0,0,,Мен Машима-куннан жұмыстан кету туралы хабарлама алдым.
Dialogue: 0,0:18:31.36,0:18:33.90,Default,,0,0,0,,Мен қабылдау емтиханына оқуға назар аударғым келеді.
Dialogue: 0,0:18:34.40,0:18:37.32,Default,,0,0,0,,(Жаңа студенттер қолдайды)
Dialogue: 0,0:18:37.40,0:18:39.82,Default,,0,0,0,,Футбол клубымен таныстыру
Dialogue: 0,0:18:39.91,0:18:41.32,Default,,0,0,0,,Біз әйел менеджерлерді қабылдаймыз!
Dialogue: 0,0:18:41.99,0:18:42.57,Default,,0,0,0,,Енді не болады?
Dialogue: 0,0:18:42.57,0:18:43.95,Default,,0,0,0,,Жұмыстан шығу туралы хабарлама…
Dialogue: 0,0:18:42.57,0:18:43.95,Default,,0,0,0,,Енді не болады?
Dialogue: 0,0:18:44.03,0:18:45.12,Default,,0,0,0,,Спорт мерекесінде екінші жыл қатарынан жарыс эстафеталық чемпионатында жеңімпаз атанды.
Dialogue: 0,0:18:45.12,0:18:46.58,Default,,0,0,0,,Машима-сенпай...
Dialogue: 0,0:18:45.12,0:18:46.58,Default,,0,0,0,,Спорт фестивалінде екінші жыл қатарынан жарыс эстафеталық біріншілігін жеңіп алды.
Dialogue: 0,0:18:46.58,0:18:47.87,Default,,0,0,0,,Спорт мерекесінде екінші жыл қатарынан жарыс эстафеталық чемпионатында жеңімпаз атанды.
Dialogue: 0,0:18:47.96,0:18:50.29,Default,,0,0,0,,Біздің мектептің ең үздік әдеби және әскери дағдылары
Dialogue: 0,0:18:50.37,0:18:51.21,Default,,0,0,0,,Бәсекеге қабілетті карута клубымен таныстыру!
Dialogue: 0,0:18:51.21,0:18:53.59,Default,,0,0,0,,Аясе: мен сені ауыстырамын. (Комано) Артында бол.
Dialogue: 0,0:18:51.21,0:18:53.59,Default,,0,0,0,,Бәсекеге қабілетті карута клубымен таныстыру!
Dialogue: 0,0:18:53.67,0:18:56.84,Default,,0,0,0,,О~
Dialogue: 0,0:18:56.92,0:18:58.97,Default,,0,0,0,,Бәсекеге қабілетті Карута клубы
Dialogue: 0,0:18:58.97,0:18:59.47,Default,,0,0,0,,Бәсекеге қабілетті Карута клубы
Dialogue: 0,0:18:58.97,0:18:59.47,Default,,0,0,0,,Өте сүйкімді~
Dialogue: 0,0:18:59.47,0:19:00.34,Default,,0,0,0,,Өте сүйкімді~
Dialogue: 0,0:19:00.34,0:19:01.01,Default,,0,0,0,,Сізді әдеби және жекпе-жек өнерімен таныстырды.
Dialogue: 0,0:19:00.34,0:19:01.01,Default,,0,0,0,,Өте сүйкімді~
Dialogue: 0,0:19:01.01,0:19:02.76,Default,,0,0,0,,Сізді әдеби және жекпе-жек өнерімен таныстырды.
Dialogue: 0,0:19:02.85,0:19:05.47,Default,,0,0,0,,Бірдеңе болса, «мәтін» жетіспейтін сияқты.
Dialogue: 0,0:19:05.47,0:19:05.97,Default,,0,0,0,,Бірдеңе болса, «мәтін» жетіспейтін сияқты.
Dialogue: 0,0:19:05.47,0:19:05.97,Default,,0,0,0,,(Жаңа студенттердің күлкілері)
Dialogue: 0,0:19:05.97,0:19:06.68,Default,,0,0,0,,(Жаңа студенттердің күлкісі)
Dialogue: 0,0:19:06.68,0:19:08.02,Default,,0,0,0,,Бәсекеге қабілетті карута жарылғыш күш пен рефлекстерді қажет етеді.
Dialogue: 0,0:19:06.68,0:19:08.02,Default,,0,0,0,,(Жаңа студенттердің күлкілері)
Dialogue: 0,0:19:08.02,0:19:10.44,Default,,0,0,0,,Бәсекеге қабілетті карута жарылғыш күш пен рефлекстерді қажет етеді.
Dialogue: 0,0:19:10.52,0:19:13.90,Default,,0,0,0,,Өткен жылы республикалық байқауда жеңімпаз атандық.
Dialogue: 0,0:19:13.98,0:19:16.02,Default,,0,0,0,,Уау, керемет
Dialogue: 0,0:19:16.11,0:19:20.36,Default,,0,0,0,,3 және 2 курс клубының 6 мүшесі барын салды...
Dialogue: 0,0:19:30.62,0:19:32.79,Default,,0,0,0,,(микрофонның айқайлаған дыбысы)
Dialogue: 0,0:19:33.29,0:19:38.34,Default,,0,0,0,,(Жаңа оқушылардың шуы)
Dialogue: 0,0:19:41.93,0:19:43.30,Default,,0,0,0,,Жалғастыру
Dialogue: 0,0:19:43.39,0:19:45.72,Default,,0,0,0,,Бәсекеге қабілетті карутаның ең үлкен тартымдылығы
Dialogue: 0,0:19:45.80,0:19:48.81,Default,,0,0,0,,Күтілгендей, Огура Хякунин Исшу орталықта.
Dialogue: 0,0:19:49.35,0:19:54.77,Default,,0,0,0,,Мың жыл өмір сүрген жырлар, Қуаныш, мұң, махаббат жырлары.
Dialogue: 0,0:19:55.69,0:19:59.15,Default,,0,0,0,,Алдыңда тізілген жүз түсті
Dialogue: 0,0:19:59.23,0:20:02.82,Default,,0,0,0,,Ғажайыпты менімен бірге сезсеңіз
Dialogue: 0,0:20:10.37,0:20:11.33,Default,,0,0,0,,Тайчи!
Dialogue: 0,0:20:12.37,0:20:15.13,Default,,0,0,0,,Тайчи! Маған ұнамайды, Тайчи!
Dialogue: 0,0:20:15.21,0:20:18.42,Default,,0,0,0,,Маған ұнамайды. Мен клубтан кеткенді ұнатпаймын. Жоқ, Тайчи!
Dialogue: 0,0:20:19.46,0:20:21.38,Default,,0,0,0,,Тайчи!
Dialogue: 0,0:20:21.47,0:20:25.93,Default,,0,0,0,,(Чихаяның айқайы)
Dialogue: 0,0:20:26.01,0:20:27.22,Default,,0,0,0,,Уф
Dialogue: 0,0:20:46.20,0:20:47.32,Default,,0,0,0,,Чихая
Dialogue: 0,0:20:48.74,0:20:50.33,Default,,0,0,0,,Сен менсің...
Dialogue: 0,0:20:51.87,0:20:54.58,Default,,0,0,0,,Оны тастан жасалған деп ойлайсың ба?
Dialogue: 0,0:21:06.13,0:21:09.85,Default,,0,0,0,,Енді Карутаны ойнама
Dialogue: 0,0:21:12.02,0:21:16.19,Default,,0,0,0,,Барлық 100 сурет тым қара болып көрінеді.
Dialogue: 0,0:21:20.40,0:21:21.90,Default,,0,0,0,,Барлығы…
Dialogue: 0,0:21:24.36,0:21:25.45,Default,,0,0,0,,Барлығы…
Dialogue: 0,0:21:27.86,0:21:28.78,Default,,0,0,0,,Барлығы…
Dialogue: 0,0:21:37.96,0:21:42.96,Default,,0,0,0,,♪～
Dialogue: 0,0:22:46.65,0:22:51.66,Default,,0,0,0,,～♪
