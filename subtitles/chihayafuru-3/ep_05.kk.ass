Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:11.01,Default,,0,0,0,,♪～
Dialogue: 0,0:01:10.94,0:01:15.95,Default,,0,0,0,,～♪
Dialogue: 0,0:01:22.29,0:01:26.41,Default,,0,0,0,,3 картадан 1 картаға дейінгі айырмашылық... Сол жоғары сынып оқушысы қуып жету үшін жақсы жұмыс істейді.
Dialogue: 0,0:01:27.25,0:01:32.17,Default,,0,0,0,,Мен білмеймін, бұл өтінімге байланысты. Инокума мырзаның жеңісі де жеткілікті жылдам.
Dialogue: 0,0:01:32.25,0:01:35.17,Default,,0,0,0,,Бұл күннің ең үлкен жылдамдық шайқасы.
Dialogue: 0,0:01:38.26,0:01:40.72,Default,,0,0,0,,Бұл жақсы сәйкестік болды
Dialogue: 0,0:01:40.80,0:01:42.68,Default,,0,0,0,,«Чиханы» Харука-сан алды.
Dialogue: 0,0:01:42.76,0:01:43.89,Default,,0,0,0,,Себебі соққы бар
Dialogue: 0,0:01:52.32,0:01:54.82,Default,,0,0,0,,Мына бала оны көтеріп көңілді.
Dialogue: 0,0:01:55.36,0:01:57.07,Default,,0,0,0,,Жоқ, егер мен мінсем
Dialogue: 0,0:01:57.15,0:01:58.61,Default,,0,0,0,,Қарқынды бұзу...
Dialogue: 0,0:01:58.70,0:02:00.70,Default,,0,0,0,,Мен саған қызық нәрсені алып тастауға рұқсат бермеймін.
Dialogue: 0,0:02:00.78,0:02:02.45,Default,,0,0,0,,Шуш (Харука) Ха!
Dialogue: 0,0:02:02.53,0:02:05.45,Default,,0,0,0,,（）…
Dialogue: 0,0:02:06.83,0:02:10.67,Default,,0,0,0,,Шуш Шуш Шуш
Dialogue: 0,0:02:10.75,0:02:11.58,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:11.67,0:02:12.84,Default,,0,0,0,,Бұл кеудедегі бір нүкте - аю әке!
Dialogue: 0,0:02:11.67,0:02:12.84,Default,,0,0,0,,Уф
Dialogue: 0,0:02:12.84,0:02:14.59,Default,,0,0,0,,Бұл кеудедегі бір нүкте - аю әке!
Dialogue: 0,0:02:14.67,0:02:15.84,Default,,0,0,0,,Бір орында тұрмасаң, мен шығамын.
Dialogue: 0,0:02:15.92,0:02:16.84,Default,,0,0,0,,（）
Dialogue: 0,0:02:16.92,0:02:18.42,Default,,0,0,0,,Анашым, қызық көрінеді! (Томо) Кешіріңіз.
Dialogue: 0,0:02:18.51,0:02:20.05,Default,,0,0,0,,Мен оны жек көремін! (Томо) Кешіріңіз.
Dialogue: 0,0:02:20.13,0:02:22.85,Default,,0,0,0,,Иә! Алақай! Әке досым! Ах...
Dialogue: 0,0:02:25.68,0:02:28.10,Default,,0,0,0,,Менің ата-анам да карута ойыншылары.
Dialogue: 0,0:02:28.18,0:02:31.56,Default,,0,0,0,,Демалыс күндері мен полигонға басқа жерлерге қарағанда көбірек бардым.
Dialogue: 0,0:02:32.48,0:02:37.07,Default,,0,0,0,,Ол төрт рет патшайым атағын жеңіп алды, екі баласы бар және өте сүйкімді.
Dialogue: 0,0:02:37.78,0:02:40.03,Default,,0,0,0,,Мен жеткілікті дер едім...
Dialogue: 0,0:02:46.70,0:02:51.88,Default,,0,0,0,,Ата-аналар өздерін балалары сияқты маңызды сезіне алады.
Dialogue: 0,0:02:51.96,0:02:53.88,Default,,0,0,0,,мені босатты
Dialogue: 0,0:02:55.04,0:02:57.26,Default,,0,0,0,,Өйткені бала есейеді
Dialogue: 0,0:02:57.34,0:02:59.13,Default,,0,0,0,,Мен карутада жарқырамын
Dialogue: 0,0:03:00.22,0:03:03.18,Default,,0,0,0,,Менің карутам басқалардан артық мен...
Dialogue: 0,0:03:05.51,0:03:06.97,Default,,0,0,0,,Карутайодан рахат алыңыз
Dialogue: 0,0:03:07.81,0:03:09.85,Default,,0,0,0,,Нашио Ваба~
Dialogue: 0,0:03:09.93,0:03:15.90,Default,,0,0,0,,Осакаяманың Санекадурасы
Dialogue: 0,0:03:16.77,0:03:18.69,Default,,0,0,0,,Өз жеріңде «Нагеке» болса да
Dialogue: 0,0:03:18.78,0:03:22.16,Default,,0,0,0,,Еш ойланбастан жаудың «бірдемесіне» бір ауыз сөзбен шабуыл жасадым.
Dialogue: 0,0:03:22.24,0:03:25.28,Default,,0,0,0,,Теория бойынша Аясе жау лагеріне шабуыл жасады.
Dialogue: 0,0:03:25.37,0:03:26.95,Default,,0,0,0,,Оған уақытында жету мүмкін емес
Dialogue: 0,0:03:28.87,0:03:32.79,Default,,0,0,0,,Жоқ, Инокума-сан шабуыл жасаған жоқ.
Dialogue: 0,0:03:34.71,0:03:36.00,Default,,0,0,0,,Мен бұны білгенмін.
Dialogue: 0,0:03:37.55,0:03:39.05,Default,,0,0,0,,Әрине
Dialogue: 0,0:03:39.13,0:03:43.43,Default,,0,0,0,,Ямагучиден шыққан Харука-сан батыстан келген оқырмандарды жақсы көреді.
Dialogue: 0,0:03:44.51,0:03:47.22,Default,,0,0,0,,Жіңішке интонацияларды мүлтіксіз ажырату
Dialogue: 0,0:03:48.01,0:03:52.60,Default,,0,0,0,,Королеваның «сезімі» - бұл сіз еститін нәрсе, өйткені сіз оны естисіз.
Dialogue: 0,0:03:53.85,0:03:55.10,Default,,0,0,0,,мен өліп қалар едім.
Dialogue: 0,0:03:55.19,0:03:58.27,Default,,0,0,0,,Тіпті сол бейкүнә күлкі...
Dialogue: 0,0:04:04.82,0:04:07.62,Default,,0,0,0,,Хитони ~ Ширеде
Dialogue: 0,0:04:07.70,0:04:12.58,Default,,0,0,0,,Куруйоши~Могана~
Dialogue: 0,0:04:14.33,0:04:15.50,Default,,0,0,0,,Бірге~
Dialogue: 0,0:04:15.58,0:04:16.83,Default,,0,0,0,,Бос шот!
Dialogue: 0,0:04:16.92,0:04:19.00,Default,,0,0,0,,Бірақ «Момо» қозғалды (Юми)
Dialogue: 0,0:04:19.75,0:04:21.80,Default,,0,0,0,,Сен қайсысын ұстадың?
Dialogue: 0,0:04:25.72,0:04:27.85,Default,,0,0,0,,Жел қысымы, солай ма?
Dialogue: 0,0:04:27.93,0:04:28.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:29.68,0:04:31.89,Default,,0,0,0,,Хаха (Харука) Хэхе
Dialogue: 0,0:04:39.32,0:04:40.94,Default,,0,0,0,,Мен сені жеңемін!
Dialogue: 0,0:04:41.65,0:04:42.94,Default,,0,0,0,,Аа... Дұрыс.
Dialogue: 0,0:04:44.53,0:04:48.74,Default,,0,0,0,,Бұл иықтарда шынымен де күш болған жоқ.
Dialogue: 0,0:04:50.33,0:04:53.50,Default,,0,0,0,,Мен сені бұрынғы патшайымға қаттырақ итермелейтін шығар деп ойладым.
Dialogue: 0,0:04:54.08,0:04:58.42,Default,,0,0,0,,Басынан аяғына дейін Аясе уайымдамайды.
Dialogue: 0,0:04:59.59,0:05:01.50,Default,,0,0,0,,Ммммммм
Dialogue: 0,0:05:02.01,0:05:04.51,Default,,0,0,0,,Қазір Аясе ханшайымы
Dialogue: 0,0:05:05.93,0:05:08.39,Default,,0,0,0,,Мүмкін бұл жай ғана Шинобу Вакамия шығар
Dialogue: 0,0:05:11.14,0:05:12.81,Default,,0,0,0,,Қанша күшті болсаң да...
Dialogue: 0,0:05:23.15,0:05:25.49,Default,,0,0,0,,Шинобу-чан күштірек
Dialogue: 0,0:05:26.90,0:05:30.58,Default,,0,0,0,,Сіз осындай қатал алмасу арқылы жақсарып жатырсыз ...
Dialogue: 0,0:05:30.66,0:05:32.45,Default,,0,0,0,,Прогресс пен құлдырау
Dialogue: 0,0:05:32.54,0:05:35.37,Default,,0,0,0,,Майданда шыңдалған ардагер Инокума-сан әлі де...
Dialogue: 0,0:05:35.46,0:05:37.58,Default,,0,0,0,,Сол орта мектеп оқушысы...
Dialogue: 0,0:05:38.96,0:05:41.09,Default,,0,0,0,,Хаха...
Dialogue: 0,0:05:42.09,0:05:47.13,Default,,0,0,0,,Вакамияның күшіне сену оны босаңсытады.
Dialogue: 0,0:05:48.63,0:05:49.93,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:05:54.97,0:05:57.81,Default,,0,0,0,,Шинобу Вакамия жеңілмейтін болмаса да
Dialogue: 0,0:06:05.99,0:06:07.03,Default,,0,0,0,,Ха!
Dialogue: 0,0:06:08.28,0:06:10.20,Default,,0,0,0,,Сенім…
Dialogue: 0,0:06:11.95,0:06:12.95,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:06:12.95,0:06:13.41,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:06:12.95,0:06:13.41,Default,,0,0,0,,О? (Нишида) Иә?
Dialogue: 0,0:06:13.41,0:06:13.49,Default,,0,0,0,,А? (Нишида) Иә?
Dialogue: 0,0:06:13.49,0:06:15.12,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:06:13.49,0:06:15.12,Default,,0,0,0,,А? (Нишида) А?
Dialogue: 0,0:06:15.20,0:06:17.08,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:06:17.16,0:06:18.37,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:18.46,0:06:19.83,Default,,0,0,0,,Хироси-кун жеңді!
Dialogue: 0,0:06:19.92,0:06:21.00,Default,,0,0,0,,Цубогучи мырза~!
Dialogue: 0,0:06:23.80,0:06:28.76,Default,,0,0,0,,Қатарынан соңғы 5 карта Цубогучи мырзаның ұсынысы дәл өзі қалағандай болды.
Dialogue: 0,0:06:29.43,0:06:31.18,Default,,0,0,0,,Қарғыстың бір түрі...
Dialogue: 0,0:06:31.93,0:06:33.43,Default,,0,0,0,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,0:06:37.10,0:06:38.18,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:38.27,0:06:40.06,Default,,0,0,0,,Арата жоғалды...
Dialogue: 0,0:06:40.14,0:06:41.56,Default,,0,0,0,,Бұл жаңа...
Dialogue: 0,0:06:42.73,0:06:43.56,Default,,0,0,0,,Осыған байланысты...
Dialogue: 0,0:06:47.78,0:06:49.57,Default,,0,0,0,,Мен Карутаны түсінбеймін
Dialogue: 0,0:06:50.70,0:06:54.62,Default,,0,0,0,,Ха ха ха ха ха
Dialogue: 0,0:06:54.70,0:06:56.12,Default,,0,0,0,,Чигирикина~
Dialogue: 0,0:06:56.20,0:07:02.54,Default,,0,0,0,,Жеңдеріңізді мықтап қысыңыз
Dialogue: 0,0:07:03.21,0:07:04.67,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:07:04.67,0:07:05.13,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:07:04.67,0:07:05.13,Default,,0,0,0,,Га
Dialogue: 0,0:07:05.13,0:07:05.21,Default,,0,0,0,,Га
Dialogue: 0,0:07:05.21,0:07:05.96,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:07:05.21,0:07:05.96,Default,,0,0,0,,Га
Dialogue: 0,0:07:05.96,0:07:07.34,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:07:07.42,0:07:08.34,Default,,0,0,0,,Фу…
Dialogue: 0,0:07:08.42,0:07:09.63,Default,,0,0,0,,Харада мырза...
Dialogue: 0,0:07:09.72,0:07:12.14,Default,,0,0,0,,Мурао мырза жеңді! ?
Dialogue: 0,0:07:12.22,0:07:15.18,Default,,0,0,0,,Әй... 5-ойыннан кейін, сіз әлдеқашан шаршадыңыз, солай емес пе?
Dialogue: 0,0:07:15.26,0:07:16.39,Default,,0,0,0,,Хараданың бірі
Dialogue: 0,0:07:17.01,0:07:18.93,Default,,0,0,0,,Мурао-кун, жарайсың.
Dialogue: 0,0:07:19.02,0:07:22.56,Default,,0,0,0,,Бірақ ортасында 10 картадан 4 картаға дейінгі айырмашылық...
Dialogue: 0,0:07:23.35,0:07:26.27,Default,,0,0,0,,Мурао мырза, көп нәрсе жойылды.
Dialogue: 0,0:07:26.36,0:07:29.49,Default,,0,0,0,,Чикушо Чикушо
Dialogue: 0,0:07:29.57,0:07:31.32,Default,,0,0,0,,Чикушо Чикушо…
Dialogue: 0,0:07:31.40,0:07:34.45,Default,,0,0,0,,Жаңғырту… Кейінірек…
Dialogue: 0,0:07:34.53,0:07:37.12,Default,,0,0,0,,Міне сондықтан Карута қорқынышты
Dialogue: 0,0:07:41.66,0:07:43.17,Default,,0,0,0,,4 дана қалды
Dialogue: 0,0:07:43.79,0:07:47.75,Default,,0,0,0,,Біркелкі сәйкестендірілген екі картаны ұстаңыз...
Dialogue: 0,0:07:49.30,0:07:50.72,Default,,0,0,0,,Не болады...
Dialogue: 0,0:07:50.80,0:07:52.22,Default,,0,0,0,,А... (Харука) А...
Dialogue: 0,0:07:52.30,0:07:54.22,Default,,0,0,0,,Не болады? (Жаным) Не болады! ?
Dialogue: 0,0:07:54.30,0:07:55.72,Default,,0,0,0,,Ху... (Чихая) Иә.
Dialogue: 0,0:07:55.80,0:07:56.97,Default,,0,0,0,,Не болады?
Dialogue: 0,0:08:01.31,0:08:02.48,Default,,0,0,0,,Не болады!
Dialogue: 0,0:08:02.56,0:08:04.15,Default,,0,0,0,,Шабуыл жасаңыз және жеңіңіз!
Dialogue: 0,0:08:02.56,0:08:04.15,Default,,0,0,0,,Йомосугара~
Dialogue: 0,0:08:05.69,0:08:09.40,Default,,0,0,0,,Бұл жағдайда біз Y дыбысы ойынында жау базасына шабуыл жасадық!
Dialogue: 0,0:08:09.48,0:08:11.90,Default,,0,0,0,,Ширанами-кай жігіттері қандай дөрекі!
Dialogue: 0,0:08:11.99,0:08:14.66,Default,,0,0,0,,Кездесуде бізге не айтасыз?
Dialogue: 0,0:08:17.83,0:08:19.74,Default,,0,0,0,,Тіпті жеңсеңіз де, жеңілсеңіз де...
Dialogue: 0,0:08:19.83,0:08:21.62,Default,,0,0,0,,Маған күш бер
Dialogue: 0,0:08:24.96,0:08:27.67,Default,,0,0,0,,Мен де шабуылға шыққанымды айттым.
Dialogue: 0,0:08:27.75,0:08:29.38,Default,,0,0,0,,Аясенің қабылдауы...
Dialogue: 0,0:08:29.46,0:08:33.88,Default,,0,0,0,,Цуренакари~кери~
Dialogue: 0,0:08:38.72,0:08:40.68,Default,,0,0,0,,Шинобуредо~
Dialogue: 0,0:08:40.77,0:08:46.52,Default,,0,0,0,,Ironii Nikeri My Koi~ha~
Dialogue: 0,0:08:52.78,0:08:54.45,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:08:55.36,0:08:56.86,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:08:56.95,0:08:57.70,Default,,0,0,0,,(Чихаяның қорылдауы)
Dialogue: 0,0:08:57.70,0:08:59.53,Default,,0,0,0,,А... Мен ұйықтаймын...
Dialogue: 0,0:08:57.70,0:08:59.53,Default,,0,0,0,,(Чихаяның қорылдауы)
Dialogue: 0,0:08:59.62,0:09:02.62,Default,,0,0,0,,Мен жеңсем де... Чихая-чан, оян~
Dialogue: 0,0:09:02.70,0:09:04.58,Default,,0,0,0,,Мен жеңген болсам да!
Dialogue: 0,0:09:06.46,0:09:07.58,Default,,0,0,0,,Аясенің Ториінен
Dialogue: 0,0:09:09.34,0:09:11.25,Default,,0,0,0,,Дыбыс өшіп барады
Dialogue: 0,0:09:13.38,0:09:15.26,Default,,0,0,0,,Иә?Ах!
Dialogue: 0,0:09:15.34,0:09:16.80,Default,,0,0,0,,Директор! (Нишида) Мажима!
Dialogue: 0,0:09:18.22,0:09:21.60,Default,,0,0,0,,Ой... бұл тағдырдың шайқасы!
Dialogue: 0,0:09:21.68,0:09:26.02,Default,,0,0,0,,Барлығы, мынау, бізге пайдасыз табандылықтан басқа ештеңе көрсетпейді.
Dialogue: 0,0:09:26.10,0:09:28.56,Default,,0,0,0,,Мен сендерге тарту күшін көрсетемін
Dialogue: 0,0:09:29.77,0:09:30.98,Default,,0,0,0,,Я...
Dialogue: 0,0:09:34.78,0:09:36.28,Default,,0,0,0,,Тағдыр шайқасы…
Dialogue: 0,0:09:39.12,0:09:40.58,Default,,0,0,0,,Тағдыр шайқасы…
Dialogue: 0,0:09:40.66,0:09:43.04,Default,,0,0,0,,Заттар мен ойлар
Dialogue: 0,0:09:43.12,0:09:47.92,Default,,0,0,0,,Хитонотоға дейін~
Dialogue: 0,0:09:49.96,0:09:51.34,Default,,0,0,0,,Олай десеңіз~
Dialogue: 0,0:09:51.42,0:09:52.17,Default,,0,0,0,,Бұрыштың Инаба...
Dialogue: 0,0:09:52.17,0:09:53.34,Default,,0,0,0,,Бұрыштың Инаба...
Dialogue: 0,0:09:52.17,0:09:53.34,Default,,0,0,0,,Ха! (Мочида және басқалар) Иә?
Dialogue: 0,0:09:54.01,0:09:55.76,Default,,0,0,0,,Мен ойланбастан жау лагеріне шабуыл жасадым! ?
Dialogue: 0,0:09:55.84,0:09:57.09,Default,,0,0,0,,А...
Dialogue: 0,0:09:57.93,0:09:58.97,Default,,0,0,0,,(Судоның дірілдеген тынысы)
Dialogue: 0,0:09:58.97,0:10:01.68,Default,,0,0,0,,(Судоның дірілдеген тынысы)
Dialogue: 0,0:09:58.97,0:10:01.68,Default,,0,0,0,,Ашино Марояни
Dialogue: 0,0:10:01.68,0:10:01.76,Default,,0,0,0,,(Судоның дірілдеген тынысы)
Dialogue: 0,0:10:01.76,0:10:02.72,Default,,0,0,0,,(Судоның дірілдеген тынысы)
Dialogue: 0,0:10:01.76,0:10:02.72,Default,,0,0,0,,Акикадзезо~Фуку~
Dialogue: 0,0:10:02.72,0:10:02.81,Default,,0,0,0,,Акикадзезо~Фуку~
Dialogue: 0,0:10:02.81,0:10:04.93,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:10:02.81,0:10:04.93,Default,,0,0,0,,Акикадзезо~Фуку~
Dialogue: 0,0:10:04.93,0:10:05.02,Default,,0,0,0,,Акикадзезо~Фуку~
Dialogue: 0,0:10:05.02,0:10:06.85,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:10:05.02,0:10:06.85,Default,,0,0,0,,Акикадзезо~Фуку~
Dialogue: 0,0:10:06.93,0:10:10.69,Default,,0,0,0,,Қарғыс атқыр... карута қалай ойнап жатырсың?
Dialogue: 0,0:10:10.77,0:10:13.32,Default,,0,0,0,,Үмітсіз болмаңыз және өзіңізді қатты итермеңіз.
Dialogue: 0,0:10:13.40,0:10:14.36,Default,,0,0,0,,Фу…
Dialogue: 0,0:10:16.32,0:10:18.36,Default,,0,0,0,,Мен қазірдің өзінде-
Dialogue: 0,0:10:19.66,0:10:23.08,Default,,0,0,0,,Менің командам оқылады деп оптимистік емеспін.
Dialogue: 0,0:10:24.99,0:10:27.71,Default,,0,0,0,,Бұл не... жиіркенішті
Dialogue: 0,0:10:30.12,0:10:34.13,Default,,0,0,0,,Міне, сондықтан Карута өте қызықты
Dialogue: 0,0:10:35.96,0:10:36.80,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:10:36.88,0:10:39.51,Default,,0,0,0,,Иә, жақсы, Читоз-чан.
Dialogue: 0,0:10:39.59,0:10:41.43,Default,,0,0,0,,Сөмке Көбірек көрсету~
Dialogue: 0,0:10:42.30,0:10:44.93,Default,,0,0,0,,Арғы жағындағы келесі мойын О, иә
Dialogue: 0,0:10:46.35,0:10:48.68,Default,,0,0,0,,Иә, үзіліс жасап, киімдеріңізді ауыстырыңыз.
Dialogue: 0,0:10:48.77,0:10:50.73,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:10:51.23,0:10:53.86,Default,,0,0,0,,Аа, анашым (Чиеко) мен сізге ұялы телефонымды әкелдім.
Dialogue: 0,0:10:53.94,0:10:56.98,Default,,0,0,0,,Рахмет, ұмытып кетіппін, өте жаман болды~
Dialogue: 0,0:10:57.07,0:10:59.70,Default,,0,0,0,,Мен толық емес жұмыс күнімнен шықтым.
Dialogue: 0,0:10:59.78,0:11:02.37,Default,,0,0,0,,Чихая әкелсе жақсы болар еді.
Dialogue: 0,0:11:02.45,0:11:05.08,Default,,0,0,0,,Жоқ, ол бүгін турнирде...
Dialogue: 0,0:11:05.16,0:11:08.12,Default,,0,0,0,,Жоқ, үзіліс бітті, сағаттық жалақыңыз шегеріледі.
Dialogue: 0,0:11:08.20,0:11:09.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:09.54,0:11:12.92,Default,,0,0,0,,Кешіріңіз, мен ақша таба алмаймын.
Dialogue: 0,0:11:13.00,0:11:14.54,Default,,0,0,0,,Бұл тек сабақ ақысын құрайды.
Dialogue: 0,0:11:14.63,0:11:15.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:18.34,0:11:21.88,Default,,0,0,0,,Жарайды, маған супермаркеттегі толық емес жұмыс күні ұнайды.
Dialogue: 0,0:11:21.97,0:11:24.80,Default,,0,0,0,,Чихаяның Карутасы онша көп ақшаны қажет етпейді.
Dialogue: 0,0:11:25.76,0:11:26.43,Default,,0,0,0,,(Билет қақпасының түрту дыбысы)
Dialogue: 0,0:11:26.43,0:11:27.22,Default,,0,0,0,,Хакамасиродан басқа
Dialogue: 0,0:11:26.43,0:11:27.22,Default,,0,0,0,,(Билет қақпасының түрту дыбысы)
Dialogue: 0,0:11:27.22,0:11:28.43,Default,,0,0,0,,Хакамасиродан басқа
Dialogue: 0,0:11:30.10,0:11:32.31,Default,,0,0,0,,Ha~ Уақытты сату соңғы минутта
Dialogue: 0,0:11:37.53,0:11:38.94,Default,,0,0,0,,Ах... Кешіріңіз.
Dialogue: 0,0:11:40.11,0:11:40.99,Default,,0,0,0,,Я...
Dialogue: 0,0:11:42.74,0:11:44.49,Default,,0,0,0,,Кеттік
Dialogue: 0,0:11:45.78,0:11:48.29,Default,,0,0,0,,Сен қолыңнан келгеннің бәрін істедің бе, Чихая?
Dialogue: 0,0:11:49.29,0:11:52.54,Default,,0,0,0,,12-несиеде бәрі жақсы деп үміттенемін...
Dialogue: 0,0:11:53.50,0:11:56.46,Default,,0,0,0,,Чихая-чан, оян~
Dialogue: 0,0:11:56.54,0:11:57.50,Default,,0,0,0,,Аясе!
Dialogue: 0,0:11:57.59,0:11:59.46,Default,,0,0,0,,Жеңіске жетсең, келесіде.
Dialogue: 0,0:11:59.55,0:12:01.55,Default,,0,0,0,,Жартылай финалдық кездесулер!
Dialogue: 0,0:12:01.63,0:12:02.80,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:02.88,0:12:04.26,Default,,0,0,0,,Қараңызшы, шықты!
Dialogue: 0,0:12:04.34,0:12:06.05,Default,,0,0,0,,Хироши Цугу Аясемен
Dialogue: 0,0:12:06.85,0:12:07.89,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:10.52,0:12:13.19,Default,,0,0,0,,Кешіріңіз, Цубогучи, мен оны сізге беремін!
Dialogue: 0,0:12:13.27,0:12:15.27,Default,,0,0,0,,Иә! (Хироши) Қош бол жақсы.
Dialogue: 0,0:12:15.35,0:12:17.77,Default,,0,0,0,,Не? Мұғалім, әдепкі бойынша?
Dialogue: 0,0:12:18.61,0:12:20.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:20.32,0:12:23.57,Default,,0,0,0,,Содан кейін А сыныбының жартылай финалында бір ғана матч болады.
Dialogue: 0,0:12:24.49,0:12:27.28,Default,,0,0,0,,Мені ұйықтатпа, Чихая-чан.
Dialogue: 0,0:12:27.37,0:12:29.74,Default,,0,0,0,,Сіз қолыңыздан келгеннің бәрін жасадыңыз
Dialogue: 0,0:12:30.37,0:12:32.54,Default,,0,0,0,,Цубогучи мырза...
Dialogue: 0,0:12:36.63,0:12:41.26,Default,,0,0,0,,Сол жақ қолыңдағы ырғақ артта қалып жатыр
Dialogue: 0,0:12:41.34,0:12:42.47,Default,,0,0,0,,Рақмет, Футаба-сан. Жоқ, кешіріңіз.
Dialogue: 0,0:12:43.34,0:12:46.51,Default,,0,0,0,,Бірақ міне, кірпік-күн.
Dialogue: 0,0:12:47.89,0:12:50.85,Default,,0,0,0,,Мұндағы адамдардың көпшілігі сізді Кірпік-күн деп атайды.
Dialogue: 0,0:12:50.93,0:12:54.23,Default,,0,0,0,,Менің ойымша, ол тек серпінінің арқасында көтерілген жас жігіт.
Dialogue: 0,0:12:54.31,0:12:56.56,Default,,0,0,0,,Жоғары сынып оқушыларына қарсы келесі жартылай финал?
Dialogue: 0,0:12:56.65,0:12:58.61,Default,,0,0,0,,Цубогучи-кун емес екеніне қуаныштымын.
Dialogue: 0,0:12:58.69,0:13:01.11,Default,,0,0,0,,Жарайды, сенің қолыңнан келеді, Мурао-кун.
Dialogue: 0,0:13:01.19,0:13:03.78,Default,,0,0,0,,Бірақ біздің клубтың жігіттері біледі.
Dialogue: 0,0:13:04.74,0:13:07.49,Default,,0,0,0,,Сізде көп серпін немесе сәттілік жоқ.
Dialogue: 0,0:13:08.66,0:13:09.78,Default,,0,0,0,,Қабілет
Dialogue: 0,0:13:09.87,0:13:10.99,Default,,0,0,0,,Ха...
Dialogue: 0,0:13:11.08,0:13:14.12,Default,,0,0,0,,Мұнда өз дағдыларыңызды көрсетіңіз!
Dialogue: 0,0:13:16.62,0:13:21.25,Default,,0,0,0,,Хироши-сан, мұндай қорқынышты сөздер айтпа.
Dialogue: 0,0:13:22.59,0:13:26.55,Default,,0,0,0,,Сізде нақты қабілет жоқ екенін түсінгенде...
Dialogue: 0,0:13:29.09,0:13:33.56,Default,,0,0,0,,Аратаның інісі Мурао мырзаның мықты болатыны сөзсіз.
Dialogue: 0,0:13:39.10,0:13:42.23,Default,,0,0,0,,Мен оны алдым.
Dialogue: 0,0:13:43.48,0:13:44.82,Default,,0,0,0,,Я...
Dialogue: 0,0:13:46.20,0:13:49.78,Default,,0,0,0,,Арата... қарап тұр.
Dialogue: 0,0:13:51.37,0:13:53.45,Default,,0,0,0,,Сакуразава мырза! (Сакуразава) Ах...
Dialogue: 0,0:13:54.12,0:13:58.25,Default,,0,0,0,,Харука-сан... Еңбектеріңіз үшін рахмет. Сіз әлі үйге барасыз ба?
Dialogue: 0,0:13:58.33,0:14:02.17,Default,,0,0,0,,Мен үйге барып, кешкі ас әзірлеп, кір жууым керек.
Dialogue: 0,0:14:03.92,0:14:07.26,Default,,0,0,0,,Сакуразава мырза, ағымдағы байланыс ақпаратыңызды айтыңызшы.
Dialogue: 0,0:14:07.34,0:14:08.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:09.47,0:14:12.18,Default,,0,0,0,,Менімен бірге жаттығу
Dialogue: 0,0:14:12.26,0:14:13.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:13.60,0:14:16.27,Default,,0,0,0,,Мен де өзімнің контактілеріме мұқият қараймын.
Dialogue: 0,0:14:16.35,0:14:18.35,Default,,0,0,0,,Көзілдірік жақсы емес.
Dialogue: 0,0:14:18.44,0:14:22.06,Default,,0,0,0,,Менің балам бар, сондықтан уақыт табу қиын.
Dialogue: 0,0:14:22.94,0:14:26.40,Default,,0,0,0,,Барыңды бермей жеңілу күлкілі.
Dialogue: 0,0:14:26.49,0:14:29.20,Default,,0,0,0,,А... а...
Dialogue: 0,0:14:29.99,0:14:32.24,Default,,0,0,0,,«Чиха» алынып тасталды, көп резонанс тудырған сияқты.
Dialogue: 0,0:14:32.32,0:14:33.16,Default,,0,0,0,,Аһ!
Dialogue: 0,0:14:33.95,0:14:34.91,Default,,0,0,0,,Фу…
Dialogue: 0,0:14:36.16,0:14:37.08,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:37.16,0:14:39.42,Default,,0,0,0,,4-ші жеңіс!
Dialogue: 0,0:14:39.50,0:14:41.67,Default,,0,0,0,,Харука Чихара ханшайымы
Dialogue: 0,0:14:44.71,0:14:48.01,Default,,0,0,0,,Мен Харука Инокумамын!
Dialogue: 0,0:14:58.14,0:15:04.11,Default,,0,0,0,,Жылдам адамдар жылдамдығын бәсеңдете бастағанда, олар одан шаршап, тастайды.
Dialogue: 0,0:15:05.48,0:15:07.28,Default,,0,0,0,,Мен болдым
Dialogue: 0,0:15:07.82,0:15:11.53,Default,,0,0,0,,Барыңды бермей жеңілу өте қиын.
Dialogue: 0,0:15:19.41,0:15:22.12,Default,,0,0,0,,Сенің мүмкіндігің көп, Хироси-кун.
Dialogue: 0,0:15:22.75,0:15:25.46,Default,,0,0,0,,Оны Чихая-чанға бердіңіз бе?
Dialogue: 0,0:15:25.54,0:15:28.26,Default,,0,0,0,,Мұғаліміңіз де солай істеді емес пе?
Dialogue: 0,0:15:28.34,0:15:30.01,Default,,0,0,0,,Нақты орындау екі аптадан кейін болады...
Dialogue: 0,0:15:30.09,0:15:32.38,Default,,0,0,0,,Өйткені мен жас емеспін (Хироси) Ах...
Dialogue: 0,0:15:33.68,0:15:36.22,Default,,0,0,0,,Ойынға шын ниетпен қарасаңыз
Dialogue: 0,0:15:36.31,0:15:40.14,Default,,0,0,0,,Мананың шәкірті болса да, Өлейін деген ниетпен аламын.
Dialogue: 0,0:15:40.73,0:15:43.40,Default,,0,0,0,,Мүмкін біз өсе аламыз
Dialogue: 0,0:15:43.48,0:15:46.77,Default,,0,0,0,,Шебер болу үшін әлі көп жол бар
Dialogue: 0,0:15:46.86,0:15:49.15,Default,,0,0,0,,Мен әлі де...
Dialogue: 0,0:15:49.23,0:15:51.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:52.82,0:15:57.28,Default,,0,0,0,,Қарғыс атсын... Уф... Қарғыс атсын... Қарғыс атсын.
Dialogue: 0,0:15:57.37,0:16:01.79,Default,,0,0,0,,Сонда да Мурао-куннан жеңілуден басқа амалым жоқ.
Dialogue: 0,0:16:01.87,0:16:04.63,Default,,0,0,0,,Аяқтаған кезде бізде қайталау жиналысы болады. Бізге қосыл, Хироси-кун!
Dialogue: 0,0:16:04.71,0:16:06.79,Default,,0,0,0,,Иә! ? (Харада) Шулы, бізге қосыл!
Dialogue: 0,0:16:08.46,0:16:09.59,Default,,0,0,0,,Фу…
Dialogue: 0,0:16:10.92,0:16:13.09,Default,,0,0,0,,Хироси-кун, егер—
Dialogue: 0,0:16:13.72,0:16:16.85,Default,,0,0,0,,Егер сіз Ейлаш-кунды кездестірсеңіз, оған берер ме едіңіз?
Dialogue: 0,0:16:19.77,0:16:21.10,Default,,0,0,0,,Өз дағдыларыңызды пайдаланыңыз!
Dialogue: 0,0:16:23.69,0:16:26.19,Default,,0,0,0,,Иә, жақсы...
Dialogue: 0,0:16:27.86,0:16:29.69,Default,,0,0,0,,Мен оны талқандауға барған болармын.
Dialogue: 0,0:16:31.40,0:16:35.36,Default,,0,0,0,,Мен Ватая-кунмен болғандай қыңыр бол.
Dialogue: 0,0:16:37.49,0:16:39.87,Default,,0,0,0,,Тайчидің бірінші рет кездесуі
Dialogue: 0,0:16:40.83,0:16:42.83,Default,,0,0,0,,Ең таңқаларлық.
Dialogue: 0,0:16:42.91,0:16:46.21,Default,,0,0,0,,Мен карута ойнауды жалғастырып, А деңгейіне жеттім.
Dialogue: 0,0:16:46.79,0:16:49.59,Default,,0,0,0,,Мен тек Карутаны ойнайтын адам емеспін.
Dialogue: 0,0:16:49.67,0:16:51.88,Default,,0,0,0,,Мен сенен аз уақыт ішінде жүгіремін.
Dialogue: 0,0:16:52.55,0:16:53.97,Default,,0,0,0,,Тіркелмеген Арнайы Сынып па?
Dialogue: 0,0:16:54.05,0:16:55.88,Default,,0,0,0,,Не, Арата-кун, жиіркенішті...
Dialogue: 0,0:16:56.76,0:16:57.97,Default,,0,0,0,,Уақыт келді
Dialogue: 0,0:16:58.89,0:17:00.72,Default,,0,0,0,,Бастайық!
Dialogue: 0,0:17:00.81,0:17:02.93,Default,,0,0,0,,Нанивадуни~
Dialogue: 0,0:17:03.02,0:17:08.36,Default,,0,0,0,,Сакуяко но Хана Фуюгомори~
Dialogue: 0,0:17:09.11,0:17:10.44,Default,,0,0,0,,Растау
Dialogue: 0,0:17:11.15,0:17:13.90,Default,,0,0,0,,Растау… Растау…
Dialogue: 0,0:17:13.99,0:17:18.41,Default,,0,0,0,,Бір нүкте... Бір нүкте... Сол бір нүкте.
Dialogue: 0,0:17:18.99,0:17:22.66,Default,,0,0,0,,«Юра» әлі шыққан жоқ. «Ю»-мен абай болыңыз.
Dialogue: 0,0:17:22.75,0:17:27.12,Default,,0,0,0,,Инокума мырза қателеспейді, бірақ ол үнемі «Шино» қабылдайды.
Dialogue: 0,0:17:27.21,0:17:28.79,Default,,0,0,0,,Оны міндетті түрде S дыбысымен бірге алыңыз
Dialogue: 0,0:17:30.42,0:17:34.30,Default,,0,0,0,,Киотодағы мектеп саяхаты? Бұл дұрыс болды
Dialogue: 0,0:17:35.17,0:17:37.76,Default,,0,0,0,,Ямахё патшайымы шайқасы
Dialogue: 0,0:17:38.89,0:17:40.01,Default,,0,0,0,,Костюмде
Dialogue: 0,0:17:40.10,0:17:41.68,Default,,0,0,0,,Костюмде! (ойнау) Кя!
Dialogue: 0,0:17:41.76,0:17:44.27,Default,,0,0,0,,Дододо... Бұл қандай түс, Чихая-чан?
Dialogue: 0,0:17:44.35,0:17:45.98,Default,,0,0,0,,Ха! арман?
Dialogue: 0,0:17:46.06,0:17:48.19,Default,,0,0,0,,Мен барлық уақытта ұйықтадым.
Dialogue: 0,0:17:48.27,0:17:49.90,Default,,0,0,0,,Бұл қандай дақ? ?
Dialogue: 0,0:17:49.98,0:17:51.57,Default,,0,0,0,,Ей... сілекейің ағып жатыр ма?
Dialogue: 0,0:17:51.65,0:17:52.65,Default,,0,0,0,,Дрол! ?
Dialogue: 0,0:17:52.73,0:17:54.07,Default,,0,0,0,,Уау! (ойнау) Жақсы емес, үйкелесең.
Dialogue: 0,0:17:54.15,0:17:57.15,Default,,0,0,0,,Жоқ... Кана-чан, менің кимоном!
Dialogue: 0,0:17:57.24,0:17:59.91,Default,,0,0,0,,Жарайды, мен үйдегі дақты кетіремін.
Dialogue: 0,0:17:59.99,0:18:01.87,Default,,0,0,0,,Мен оны ала аламын ба? Сіз оны ала аласыз ба? Сіз оны ала аласыз ба? (ойнау) Сіз аласыз!
Dialogue: 0,0:18:01.95,0:18:05.66,Default,,0,0,0,,Уф... Уф~ Анашым, кешіріңіз.
Dialogue: 0,0:18:05.75,0:18:07.92,Default,,0,0,0,,Анам…
Dialogue: 0,0:18:10.83,0:18:15.01,Default,,0,0,0,,Уақытымыз бар, оны түзетейік.
Dialogue: 0,0:18:15.55,0:18:19.89,Default,,0,0,0,,Чихая-чан, анам мені қолдауға келсе екен.
Dialogue: 0,0:18:19.97,0:18:21.97,Default,,0,0,0,,Сіздің жаңадан кесілген кимоноңыз...
Dialogue: 0,0:18:22.05,0:18:25.81,Default,,0,0,0,,Хмм, бірақ анам кешке дейін толық емес жұмыс істейді.
Dialogue: 0,0:18:25.89,0:18:28.23,Default,,0,0,0,,Ауылдағы қарияның көңілі жоқ.
Dialogue: 0,0:18:28.31,0:18:30.77,Default,,0,0,0,,Ол: «Менде қант диабеті және басқа да нәрселер бар», - деді.
Dialogue: 0,0:18:30.85,0:18:33.52,Default,,0,0,0,,Госпитализацияға, мейірбикелік күтімге ақша жіберу және т.б.
Dialogue: 0,0:18:33.61,0:18:36.28,Default,,0,0,0,,Мен оны өзім үшін сатып алдым.
Dialogue: 0,0:18:38.07,0:18:41.91,Default,,0,0,0,,Әпкем анасынан біраз нәрсені сұрайды.
Dialogue: 0,0:18:45.58,0:18:49.87,Default,,0,0,0,,Иә? Айтпақшы, менің сәйкестігім ше?
Dialogue: 0,0:18:50.75,0:18:55.88,Default,,0,0,0,,(Тайчидің ауыр тыныс алуы)
Dialogue: 0,0:19:06.77,0:19:08.64,Default,,0,0,0,,Мен Мурао-кунды күтпедім...
Dialogue: 0,0:19:09.35,0:19:12.69,Default,,0,0,0,,5 картаның айырмашылығы бар, оны осылай қалдырайық...
Dialogue: 0,0:19:13.44,0:19:14.48,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:15.48,0:19:16.98,Default,,0,0,0,,Мурао мырза
Dialogue: 0,0:19:18.86,0:19:20.28,Default,,0,0,0,,Жақсы! (Жаңа) Хойя
Dialogue: 0,0:19:21.11,0:19:22.49,Default,,0,0,0,,Агрессивтілік Мурао мырза
Dialogue: 0,0:19:23.78,0:19:27.49,Default,,0,0,0,,Мурао-кунның карутасы адал шабуылға негізделген.
Dialogue: 0,0:19:28.50,0:19:31.79,Default,,0,0,0,,Мұқият тыңдап, біржақты шабуыл жаса
Dialogue: 0,0:19:33.50,0:19:37.96,Default,,0,0,0,,Ширанами-кайда Ейлаш-кунға үйреткенім – шабуыл жасау.
Dialogue: 0,0:19:42.38,0:19:43.34,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:19:44.97,0:19:47.51,Default,,0,0,0,,Не? бұл тыныс алу
Dialogue: 0,0:19:48.47,0:19:50.06,Default,,0,0,0,,Сәл кешігу
Dialogue: 0,0:19:51.60,0:19:54.19,Default,,0,0,0,,Керемет қорғаныс
Dialogue: 0,0:19:54.69,0:19:55.56,Default,,0,0,0,,Я...
Dialogue: 0,0:19:58.15,0:19:59.53,Default,,0,0,0,,Мен оны қолданып көруім керек пе?
Dialogue: 0,0:20:01.49,0:20:02.82,Default,,0,0,0,,Сіз мұны істей аласыз ба?
Dialogue: 0,0:20:03.53,0:20:04.91,Default,,0,0,0,,Уф!
Dialogue: 0,0:20:05.99,0:20:07.49,Default,,0,0,0,,Орындалды!
Dialogue: 0,0:20:07.58,0:20:11.91,Default,,0,0,0,,Бүкіл денемен алға адымдап, кенет тек қолдармен бұрылу (қолды қайтару)
Dialogue: 0,0:20:13.50,0:20:16.17,Default,,0,0,0,,Шабуыл жасау мүмкін емес
Dialogue: 0,0:20:16.25,0:20:19.42,Default,,0,0,0,,Машима: Неге бұл жайсыз өтіп жатыр...
Dialogue: 0,0:20:21.01,0:20:22.84,Default,,0,0,0,,Чихая ол жерде жоқ
Dialogue: 0,0:20:23.59,0:20:25.05,Default,,0,0,0,,Жаңа көруде
Dialogue: 0,0:20:25.59,0:20:26.43,Default,,0,0,0,,Және…
Dialogue: 0,0:20:27.68,0:20:29.93,Default,,0,0,0,,Бортта Харада мырза бар
Dialogue: 0,0:20:31.02,0:20:32.18,Default,,0,0,0,,Әй!
Dialogue: 0,0:20:40.73,0:20:43.03,Default,,0,0,0,,Мурао мырзаның жеңіліп қалуы мүмкін емес.
Dialogue: 0,0:20:46.41,0:20:47.53,Default,,0,0,0,,Мен жеңіле алмаймын
Dialogue: 0,0:20:49.33,0:20:52.79,Default,,0,0,0,,Кірпіктердің өсетін жолы шын мәнінде...
Dialogue: 0,0:20:59.04,0:21:01.55,Default,,0,0,0,,Сіз жай ғана мені қорғамақ болдыңыз ба?
Dialogue: 0,0:21:03.09,0:21:04.51,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:21:05.18,0:21:07.05,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:21:33.83,0:21:35.16,Default,,0,0,0,,Финал…
Dialogue: 0,0:21:37.96,0:21:42.96,Default,,0,0,0,,♪～
Dialogue: 0,0:22:46.86,0:22:51.87,Default,,0,0,0,,～♪
