Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.87,0:00:04.62,Default,,0,0,0,,Ах... бұл қаланың пішіні...
Dialogue: 0,0:00:10.05,0:00:13.22,Default,,0,0,0,,Сондықтан Олдрон-саманы қорқытқандар...
Dialogue: 0,0:00:13.30,0:00:15.34,Default,,0,0,0,,Оны тірі қалдырайық
Dialogue: 0,0:00:15.43,0:00:17.93,Default,,0,0,0,,Мен естідім...
Dialogue: 0,0:00:22.10,0:00:23.56,Default,,0,0,0,,-Ах... -(Люси) А...
Dialogue: 0,0:00:23.64,0:00:25.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:27.44,0:00:33.45,Default,,0,0,0,,♪~
Dialogue: 0,0:01:50.36,0:01:55.61,Default,,0,0,0,,~♪
Dialogue: 0,0:02:05.50,0:02:07.37,Default,,0,0,0,,(Жан) Не…
Dialogue: 0,0:02:11.25,0:02:12.13,Default,,0,0,0,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:02:15.88,0:02:17.42,Default,,0,0,0,,Неліктен барлығы осында?
Dialogue: 0,0:02:21.09,0:02:23.76,Default,,0,0,0,,Тіпті Жерар... не болып жатыр! ?
Dialogue: 0,0:02:26.22,0:02:28.48,Default,,0,0,0,,Шындығында, Олдрон туралы
Dialogue: 0,0:02:28.56,0:02:30.10,Default,,0,0,0,,Маған бәрібір.
Dialogue: 0,0:02:30.19,0:02:32.61,Default,,0,0,0,,Бұл да үлкен «шайтан»
Dialogue: 0,0:02:32.69,0:02:36.07,Default,,0,0,0,,Ақ түспен өшірілуі керек нәрселер...
Dialogue: 0,0:02:36.61,0:02:39.40,Default,,0,0,0,,Бірақ қазір бұл сенсің.
Dialogue: 0,0:02:39.49,0:02:43.78,Default,,0,0,0,,Қалғаны өзіңе, Ертегі менің.
Dialogue: 0,0:02:44.33,0:02:45.49,Default,,0,0,0,,Бұл кім? Сіз
Dialogue: 0,0:02:45.58,0:02:48.08,Default,,0,0,0,,Жоқ, Тука сондай.
Dialogue: 0,0:02:48.16,0:02:49.71,Default,,0,0,0,,«Нацу-сама, Нацу-сама» Мен айттым:
Dialogue: 0,0:02:49.79,0:02:52.50,Default,,0,0,0,,Есіңде жоқ, солай ма?
Dialogue: 0,0:02:52.58,0:02:53.63,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:02:53.71,0:02:54.79,Default,,0,0,0,,Әй?
Dialogue: 0,0:02:55.88,0:02:57.51,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:02:58.34,0:03:00.30,Default,,0,0,0,,Мираджан Бұл нені білдіреді?
Dialogue: 0,0:03:00.38,0:03:01.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:01.51,0:03:04.47,Default,,0,0,0,,Адам аз сияқты.
Dialogue: 0,0:03:04.55,0:03:06.35,Default,,0,0,0,,Мен бұйырғандай орындадым—
Dialogue: 0,0:03:06.43,0:03:07.68,Default,,0,0,0,,Нацуды және басқаларды осында әкеліңіз...
Dialogue: 0,0:03:07.77,0:03:10.98,Default,,0,0,0,,Мен «барлығы осында» деп тапсырыс беруім керек еді
Dialogue: 0,0:03:11.06,0:03:12.81,Default,,0,0,0,,Сондай-ақ… Кешіріңіз.
Dialogue: 0,0:03:12.90,0:03:14.23,Default,,0,0,0,,Ақ сиқыршы
Dialogue: 0,0:03:14.31,0:03:15.69,Default,,0,0,0,,Мира, сен не айтып тұрсың?
Dialogue: 0,0:03:15.77,0:03:18.53,Default,,0,0,0,,Эльфман! Лисанна! Мираджанды жазала!
Dialogue: 0,0:03:20.45,0:03:22.36,Default,,0,0,0,,Ақ сиқыршының бұйрықтары
Dialogue: 0,0:03:22.45,0:03:26.16,Default,,0,0,0,,Тыңдай алмайтын әпкесің!
Dialogue: 0,0:03:26.24,0:03:27.74,Default,,0,0,0,,Мен оны сағындым, Мира-ни!
Dialogue: 0,0:03:27.83,0:03:29.33,Default,,0,0,0,,Ух... Уууу...
Dialogue: 0,0:03:29.41,0:03:31.21,Default,,0,0,0,,Тоқта! Эльфман Лисанна!
Dialogue: 0,0:03:31.29,0:03:32.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:33.08,0:03:35.25,Default,,0,0,0,,Менімен араласпа
Dialogue: 0,0:03:35.34,0:03:37.75,Default,,0,0,0,,Не... не? Бұл
Dialogue: 0,0:03:38.76,0:03:40.22,Default,,0,0,0,,Жерар...
Dialogue: 0,0:03:43.59,0:03:45.72,Default,,0,0,0,,Сіз қорқынышты түс көріп тұрсыз ба?
Dialogue: 0,0:03:48.06,0:03:51.39,Default,,0,0,0,,Адамдардың аздығына Тука кінәлі ме?
Dialogue: 0,0:03:54.94,0:03:58.82,Default,,0,0,0,,Барлығын Ақ сиқыршы басқарады.
Dialogue: 0,0:03:58.90,0:04:00.03,Default,,0,0,0,,Ха…
Dialogue: 0,0:04:00.61,0:04:05.03,Default,,0,0,0,,Ювия - Ақ сиқыршының тағы бір тұлғасы.
Dialogue: 0,0:04:05.11,0:04:08.49,Default,,0,0,0,,Туканың күшімен барлығына хабар жіберіңіз...
Dialogue: 0,0:04:08.58,0:04:11.00,Default,,0,0,0,,Сену қиын, бірақ...
Dialogue: 0,0:04:11.75,0:04:15.46,Default,,0,0,0,,Неге екені белгісіз, бәрі әлі тірі...
Dialogue: 0,0:04:15.54,0:04:17.13,Default,,0,0,0,,Көңіл-күйіне қарай—
Dialogue: 0,0:04:17.21,0:04:19.88,Default,,0,0,0,,Мен кез келген уақытта өлтірілуі мүмкін жағдайдамын.
Dialogue: 0,0:04:20.55,0:04:22.97,Default,,0,0,0,,Біз барлығына тез көмектесуіміз керек...
Dialogue: 0,0:04:23.51,0:04:25.47,Default,,0,0,0,,Өте әсерлі Қвирк қой, иә!➡
Dialogue: 0,0:04:29.93,0:04:31.77,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:04:33.69,0:04:35.40,Default,,0,0,0,,Сен бәріне не істедің?
Dialogue: 0,0:04:35.48,0:04:36.90,Default,,0,0,0,,Фу…
Dialogue: 0,0:04:36.98,0:04:39.36,Default,,0,0,0,,Мен оны ақ түске бояп, қойдым.
Dialogue: 0,0:04:39.82,0:04:40.69,Default,,0,0,0,,Ақ?
Dialogue: 0,0:04:40.78,0:04:42.19,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:04:42.28,0:04:47.20,Default,,0,0,0,,Fairy Tail – менің доктринаға қарсы келетін күшті сиқыры бар гильдия.
Dialogue: 0,0:04:47.87,0:04:51.41,Default,,0,0,0,,Сондықтан мен оны басқаруым керек.
Dialogue: 0,0:04:52.16,0:04:54.37,Default,,0,0,0,,Мен не айтып тұрғаныңызды түсінбедім...
Dialogue: 0,0:04:55.33,0:04:56.42,Default,,0,0,0,,Өте...
Dialogue: 0,0:04:59.67,0:05:04.05,Default,,0,0,0,,Сіз де ақ түске боялған кезде түсінесіз.
Dialogue: 0,0:05:04.63,0:05:05.88,Default,,0,0,0,,Ахх...
Dialogue: 0,0:05:05.97,0:05:07.01,Default,,0,0,0,,Бұл...
Dialogue: 0,0:05:07.09,0:05:09.51,Default,,0,0,0,,Сиқырлы күш жұтылады...
Dialogue: 0,0:05:10.05,0:05:12.93,Default,,0,0,0,,Менің күшім кетті...
Dialogue: 0,0:05:13.02,0:05:16.31,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:05:17.77,0:05:20.27,Default,,0,0,0,,Қалыпты емес күйді жою! Лесе!
Dialogue: 0,0:05:20.36,0:05:22.44,Default,,0,0,0,,-Ха... -(Люси) А...
Dialogue: 0,0:05:22.53,0:05:23.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:26.90,0:05:27.74,Default,,0,0,0,,Венди!
Dialogue: 0,0:05:27.82,0:05:29.37,Default,,0,0,0,,Мұздағы макияж...
Dialogue: 0,0:05:29.45,0:05:30.66,Default,,0,0,0,,Қабырға!
Dialogue: 0,0:05:32.99,0:05:33.83,Default,,0,0,0,,Сұр!
Dialogue: 0,0:05:34.70,0:05:37.62,Default,,0,0,0,,Барлығына! Әзірше артқа шегініңіз!
Dialogue: 0,0:05:37.83,0:05:39.75,Default,,0,0,0,,Барлығын манипуляциялауда!
Dialogue: 0,0:05:39.83,0:05:41.75,Default,,0,0,0,,Ювия! Чарльз да!
Dialogue: 0,0:05:41.84,0:05:44.71,Default,,0,0,0,,Қабырғалары қалың болса, бұл оңай емес...
Dialogue: 0,0:05:44.80,0:05:47.13,Default,,0,0,0,,-Лаксус -Оу
Dialogue: 0,0:05:56.52,0:05:58.06,Default,,0,0,0,,Шынымен!
Dialogue: 0,0:05:58.14,0:05:59.44,Default,,0,0,0,,Өтінемін қашып кет!
Dialogue: 0,0:05:59.52,0:06:00.56,Default,,0,0,0,,Шегін!
Dialogue: 0,0:06:00.65,0:06:02.27,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:06:03.15,0:06:04.69,Default,,0,0,0,,-Мен сені қуамын.
Dialogue: 0,0:06:04.78,0:06:07.28,Default,,0,0,0,,-Жоқ, қарсы емеспін.-(Гаджил Лаксус) Иә?
Dialogue: 0,0:06:07.86,0:06:11.24,Default,,0,0,0,,Маған ұнамаса да арғы жақтан тағы келеді, хаха...
Dialogue: 0,0:06:12.28,0:06:13.70,Default,,0,0,0,,Ах… Бип, бип…
Dialogue: 0,0:06:15.12,0:06:19.04,Default,,0,0,0,,Мен өз жоспарымды сәл бұрмаланған соң қайта жолға қоямын.
Dialogue: 0,0:06:20.42,0:06:23.17,Default,,0,0,0,,Олдронды ақ түске бояйық.
Dialogue: 0,0:06:24.38,0:06:26.26,Default,,0,0,0,,Сіздің көмегіңізбен
Dialogue: 0,0:06:30.22,0:06:32.55,Default,,0,0,0,,Барлығының сиқырлы күшін өшірдіңіз бе? ?
Dialogue: 0,0:06:33.22,0:06:34.93,Default,,0,0,0,,Гильдиядағылардың бәрі?
Dialogue: 0,0:06:35.01,0:06:38.31,Default,,0,0,0,,Мынау ақымақ... Бір қыздың өзінде мұндай күш бар.
Dialogue: 0,0:06:38.94,0:06:41.77,Default,,0,0,0,,Менің ойымша, бәрі сақтықты төмендетті ...
Dialogue: 0,0:06:42.31,0:06:46.53,Default,,0,0,0,,Сол ақ сиқыршы Туканың екі тұлғасы бар.
Dialogue: 0,0:06:46.61,0:06:49.36,Default,,0,0,0,,Жоғарыда айтылғандай, «Бәрін ақ етіңіз»—
Dialogue: 0,0:06:49.45,0:06:52.99,Default,,0,0,0,,Сиқыршылардың сиқырлы күшін өшіретін «ақ сиқыршы».
Dialogue: 0,0:06:53.07,0:06:57.75,Default,,0,0,0,,Ал Нацу-санға ғашық, жүрегі таза Тука-сан.
Dialogue: 0,0:06:57.83,0:07:00.58,Default,,0,0,0,,Маған Нацу ұнамайды.
Dialogue: 0,0:07:00.67,0:07:02.25,Default,,0,0,0,,Мен ондай адамды танымаймын.
Dialogue: 0,0:07:02.79,0:07:06.42,Default,,0,0,0,,Ювия да бір рет манипуляцияланған.
Dialogue: 0,0:07:06.50,0:07:09.01,Default,,0,0,0,,Ақ сиқыршы Тука-санды білмеуі үшін.
Dialogue: 0,0:07:09.09,0:07:11.01,Default,,0,0,0,,Мен тек Ювияны ғана босата алдым.
Dialogue: 0,0:07:11.80,0:07:16.26,Default,,0,0,0,,And all the information we can know is here for you...
Dialogue: 0,0:07:16.35,0:07:17.72,Default,,0,0,0,,Тағы бар ма?
Dialogue: 0,0:07:18.64,0:07:20.43,Default,,0,0,0,,Ақ сиқыршы -
Dialogue: 0,0:07:20.52,0:07:23.44,Default,,0,0,0,,He was also plotting the extinction of the five divine dragons.
Dialogue: 0,0:07:23.52,0:07:25.36,Default,,0,0,0,,Ақтың жойылуы?
Dialogue: 0,0:07:25.44,0:07:27.65,Default,,0,0,0,,Ол «ақ түске боя» деді.
Dialogue: 0,0:07:28.40,0:07:33.41,Default,,0,0,0,,In the White Annihilation state, all magical power is managed by the White Mage.
Dialogue: 0,0:07:33.49,0:07:37.37,Default,,0,0,0,,Ақ сиқыршы қалағандай жоқтан максимумға дейін...
Dialogue: 0,0:07:37.45,0:07:41.87,Default,,0,0,0,,Тіпті эгоды басқаруға болады.
Dialogue: 0,0:07:41.96,0:07:44.83,Default,,0,0,0,,Бес құдайлық айдаһардың ақ жойылу жоспары
Dialogue: 0,0:07:44.92,0:07:48.42,Default,,0,0,0,,Бірінші қадам - су құдайы айдаһар мелкфобия.
Dialogue: 0,0:07:48.50,0:07:49.34,Default,,0,0,0,,Ха…
Dialogue: 0,0:07:49.80,0:07:53.43,Default,,0,0,0,,Карамир ақ сиқыршыдан сұрағанын айтты...
Dialogue: 0,0:07:53.51,0:07:56.05,Default,,0,0,0,,Бұл триггер болуы мүмкін...
Dialogue: 0,0:07:56.14,0:07:58.81,Default,,0,0,0,,Қалай болғанда да, ол жойылды.
Dialogue: 0,0:07:59.35,0:08:02.94,Default,,0,0,0,,Ақ сиқыршы су құдайы Айдаһардың күшін пайдаланады.
Dialogue: 0,0:08:03.02,0:08:06.27,Default,,0,0,0,,The other four were about to be wiped out.
Dialogue: 0,0:08:06.90,0:08:10.49,Default,,0,0,0,,Алайда, Су құдайы Айдаһар жеңілгендіктен...
Dialogue: 0,0:08:10.57,0:08:13.28,Default,,0,0,0,,Біз жоспарларымызды өзгертуге тура келді.
Dialogue: 0,0:08:13.99,0:08:17.07,Default,,0,0,0,,Құдайдың бес айдаһарын жою күші ретінде -
Dialogue: 0,0:08:17.16,0:08:19.66,Default,,0,0,0,,Су құдайы Айдаһардың орнына таңдалған адам:
Dialogue: 0,0:08:19.74,0:08:20.79,Default,,0,0,0,,Ертегі
Dialogue: 0,0:08:21.95,0:08:24.92,Default,,0,0,0,,Сәттілік пе, әлде сәтсіздік пе?
Dialogue: 0,0:08:25.00,0:08:30.34,Default,,0,0,0,,Бастапқыда Ақ сиқыршы барлық ертегілерді жояды.
Dialogue: 0,0:08:30.84,0:08:32.59,Default,,0,0,0,,Сөзбе-сөз өшіру...
Dialogue: 0,0:08:33.13,0:08:34.88,Default,,0,0,0,,Мен сені өлтірмек болдым.
Dialogue: 0,0:08:36.01,0:08:40.81,Default,,0,0,0,,Су құдайы Айдаһарды жеңген ол тірі қалды.
Dialogue: 0,0:08:41.10,0:08:46.69,Default,,0,0,0,,The lives of everyone in the guild are currently in the hands of the White Mage...
Dialogue: 0,0:08:46.77,0:08:48.15,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:48.23,0:08:49.61,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,0:08:49.69,0:08:51.07,Default,,0,0,0,,Ннн…
Dialogue: 0,0:08:51.15,0:08:52.53,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:52.61,0:08:54.49,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,0:08:55.91,0:08:58.45,Default,,0,0,0,,Барлығына көмектесудің жолы бар емес пе?
Dialogue: 0,0:08:58.91,0:09:03.16,Default,,0,0,0,,Егер біз Ақ сиқыршыны жеңе алсақ, көмектесе аламыз...
Dialogue: 0,0:09:03.25,0:09:04.25,Default,,0,0,0,,Егер солай болса...
Dialogue: 0,0:09:04.79,0:09:06.62,Default,,0,0,0,,- Мүмкін емес - Иә?
Dialogue: 0,0:09:06.71,0:09:10.13,Default,,0,0,0,,Айттым ғой, әр адамның өмірі менің қолымда.
Dialogue: 0,0:09:10.21,0:09:13.05,Default,,0,0,0,,Бір ғана сөз, «өл» және мен саған өлуді бұйырамын.
Dialogue: 0,0:09:13.13,0:09:15.22,Default,,0,0,0,,Гильдияның барлық мүшелері...
Dialogue: 0,0:09:15.30,0:09:16.47,Default,,0,0,0,,Бұл...
Dialogue: 0,0:09:16.55,0:09:17.51,Default,,0,0,0,,Ха…
Dialogue: 0,0:09:17.59,0:09:19.18,Default,,0,0,0,,- (Барлығы) Әй... - Не! ?
Dialogue: 0,0:09:19.26,0:09:20.43,Default,,0,0,0,,Тағы да жер!
Dialogue: 0,0:09:20.51,0:09:22.97,Default,,0,0,0,,Әлде бұл белгіленген уақыт емес пе?
Dialogue: 0,0:09:23.06,0:09:24.14,Default,,0,0,0,,Не болып жатыр! ?
Dialogue: 0,0:09:24.23,0:09:25.85,Default,,0,0,0,,Осындай уақытта, Ағаш Құдай Айдаһар!
Dialogue: 0,0:09:25.94,0:09:26.94,Default,,0,0,0,,Бұл...
Dialogue: 0,0:09:35.86,0:09:37.78,Default,,0,0,0,,(сыртылдаған дыбыс)
Dialogue: 0,0:09:40.20,0:09:42.20,Default,,0,0,0,,Бұл оң қол шары
Dialogue: 0,0:09:42.79,0:09:44.66,Default,,0,0,0,,Бұл оң қол шары
Dialogue: 0,0:09:44.75,0:09:46.33,Default,,0,0,0,,А... Ювия?
Dialogue: 0,0:09:46.41,0:09:50.13,Default,,0,0,0,,Сол қол Оң иық Сол иық Артқы
Dialogue: 0,0:09:50.21,0:09:52.88,Default,,0,0,0,,Қалған төрт шардың барлығын жойсаңыз...
Dialogue: 0,0:09:52.96,0:09:55.59,Default,,0,0,0,,Олдрон күшін жоғалтады
Dialogue: 0,0:09:55.67,0:09:58.63,Default,,0,0,0,,Бұл шарды менің күшіммен жою мүмкін емес.
Dialogue: 0,0:09:58.72,0:10:03.10,Default,,0,0,0,,Сіздің көмегіңізбен біз барлық шарларды жоямыз.
Dialogue: 0,0:10:03.18,0:10:05.52,Default,,0,0,0,,О!
Dialogue: 0,0:10:06.81,0:10:09.02,Default,,0,0,0,,Fairy Tail!
Dialogue: 0,0:10:09.10,0:10:12.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:13.07,0:10:13.94,Default,,0,0,0,,Ха…
Dialogue: 0,0:10:14.03,0:10:16.65,Default,,0,0,0,,-Жақсысың ба? Ювия - Қазір...
Dialogue: 0,0:10:16.74,0:10:20.62,Default,,0,0,0,,Бұл Ақ Сиқыршының сөздері. Маған Тука айтты!
Dialogue: 0,0:10:20.70,0:10:24.83,Default,,0,0,0,,Біз достарымызды қаланың шарын жою үшін қолданамыз! ?
Dialogue: 0,0:10:24.91,0:10:26.50,Default,,0,0,0,,Мен бұған жол бермеймін!
Dialogue: 0,0:10:26.58,0:10:29.71,Default,,0,0,0,,Бұл барлығы қалған төрт қалаға барады дегенді білдіре ме?
Dialogue: 0,0:10:29.79,0:10:31.21,Default,,0,0,0,,- (Люси) Бір минут күте тұрыңыз! -Иә?
Dialogue: 0,0:10:31.29,0:10:34.05,Default,,0,0,0,,Мүмкін бұл мүмкіндік шығар...
Dialogue: 0,0:10:34.13,0:10:35.17,Default,,0,0,0,,Мүмкіндік?
Dialogue: 0,0:10:35.88,0:10:38.30,Default,,0,0,0,,Ақ сиқыршыны жеңе алмасаңыз да...
Dialogue: 0,0:10:38.38,0:10:41.39,Default,,0,0,0,,Мүмкін біз әрқайсысын жеке құтқара аламыз.
Dialogue: 0,0:10:41.47,0:10:42.30,Default,,0,0,0,,Не! ?
Dialogue: 0,0:10:42.85,0:10:45.10,Default,,0,0,0,,Вендидің қалпына келтіру сиқырымен...
Dialogue: 0,0:10:45.39,0:10:48.02,Default,,0,0,0,,Манипуляция кезінде жұмыс істемейді
Dialogue: 0,0:10:48.10,0:10:50.73,Default,,0,0,0,,Егер сіз есінен танып қалсаңыз...
Dialogue: 0,0:10:50.81,0:10:52.94,Default,,0,0,0,,Есінен танып қалдыңыз ба? Мен түсінемін.
Dialogue: 0,0:10:53.90,0:10:57.40,Default,,0,0,0,,Сонда сіз достарыңызбен оларға көмектесу үшін ұрысып жатырсыз ба?
Dialogue: 0,0:10:58.36,0:11:02.45,Default,,0,0,0,,Дразельдегі ертегілер шайқасы!
Dialogue: 0,0:11:02.53,0:11:04.58,Default,,0,0,0,,Жанып жатыр!
Dialogue: 0,0:11:04.66,0:11:06.04,Default,,0,0,0,,Жоқ, жоқ, жоқ...
Dialogue: 0,0:11:06.12,0:11:09.46,Default,,0,0,0,,Егер бұлай болса, бұл туралы бірдеңе жасауға болады.
Dialogue: 0,0:11:09.54,0:11:11.04,Default,,0,0,0,,«қаһарман» мамандығы пайда болды
Dialogue: 0,0:11:11.12,0:11:13.38,Default,,0,0,0,,Лаксус пен Мира-чан
Dialogue: 0,0:11:13.46,0:11:16.25,Default,,0,0,0,,Джеллял мен Гаджил сондай азап.
Dialogue: 0,0:11:16.34,0:11:19.26,Default,,0,0,0,,Бұл жерде Гилдартс мырзаның жоқтығы жеңілдетілді.
Dialogue: 0,0:11:19.34,0:11:22.09,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:11:23.34,0:11:24.97,Default,,0,0,0,,Барлығы бірге...
Dialogue: 0,0:11:25.51,0:11:27.52,Default,,0,0,0,,Мен сені жеңемін!
Dialogue: 0,0:11:30.52,0:11:32.90,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:32.98,0:11:34.69,Default,,0,0,0,,Нацу! Күте тұрыңыз!
Dialogue: 0,0:11:34.77,0:11:35.61,Default,,0,0,0,,Нацу-сан!
Dialogue: 0,0:11:35.69,0:11:36.61,Default,,0,0,0,,Ей!
Dialogue: 0,0:11:36.69,0:11:39.19,Default,,0,0,0,,Бір адамның өзі шеше алатын мәселе емес!
Dialogue: 0,0:11:39.28,0:11:40.57,Default,,0,0,0,,Мені міндетті түрде өлтіреді! ➡
Dialogue: 0,0:11:40.65,0:11:43.16,Default,,0,0,0,,Лаксус пен Гаджил, Мира мен Джелал...
Dialogue: 0,0:11:43.24,0:11:45.16,Default,,0,0,0,,Мен олардың бәрін жеңемін!
Dialogue: 0,0:11:45.24,0:11:48.37,Default,,0,0,0,,Бұл жекпе-жек фестивалі! Жанып жатыр!
Dialogue: 0,0:11:48.45,0:11:50.12,Default,,0,0,0,,Айса!
Dialogue: 0,0:11:50.20,0:11:53.67,Default,,0,0,0,,Достарыңмен төбелесуге неге сонша қызықсың?
Dialogue: 0,0:11:53.75,0:11:56.09,Default,,0,0,0,,Нацу үшін бұл жай ғана ұрыс
Dialogue: 0,0:11:56.17,0:11:58.13,Default,,0,0,0,,Менің ойымша, сіз оны күш бәсекесі деп ойлайсыз.
Dialogue: 0,0:11:58.21,0:12:03.13,Default,,0,0,0,,Кеттік! Достарымыз қалған төрт қалаға жол тартады.
Dialogue: 0,0:12:03.47,0:12:08.22,Default,,0,0,0,,Біз достарымызды Ақ сиқыршының жоспарларында пайдалануға рұқсат ете алмаймыз!
Dialogue: 0,0:12:08.31,0:12:09.60,Default,,0,0,0,,Мен ол жігітке ештеңе істей алмаймын
Dialogue: 0,0:12:11.89,0:12:15.77,Default,,0,0,0,,Бірақ неге Жерар біздің гильдияға қосылды?
Dialogue: 0,0:12:16.94,0:12:19.86,Default,,0,0,0,,Жоқ, бұл маған қазір маңызды емес.
Dialogue: 0,0:12:20.32,0:12:23.57,Default,,0,0,0,,Маған осындай қамқорлық көрсеткеніңіз үшін рахмет...
Dialogue: 0,0:12:24.91,0:12:28.91,Default,,0,0,0,,Сіз сенімдісіз бе? Fairy Tail мүшелері
Dialogue: 0,0:12:29.20,0:12:31.70,Default,,0,0,0,,Сіздің екі мақсатыңыз бар.
Dialogue: 0,0:12:31.79,0:12:32.96,Default,,0,0,0,,Бір…
Dialogue: 0,0:12:33.46,0:12:37.96,Default,,0,0,0,,Олдронды жеңу үшін қалған 4 шарды жойыңыз.
Dialogue: 0,0:12:38.42,0:12:39.92,Default,,0,0,0,,Ал екінші нәрсе...
Dialogue: 0,0:12:40.59,0:12:44.09,Default,,0,0,0,,Нацу Люси Грей Эрза Венди
Dialogue: 0,0:12:44.18,0:12:46.14,Default,,0,0,0,,Сонымен қатар, екі мысық
Dialogue: 0,0:12:46.72,0:12:50.51,Default,,0,0,0,,Осы ақ доктринаны бұзғандарды өлім жазасына кесіңіз.
Dialogue: 0,0:13:08.45,0:13:11.29,Default,,0,0,0,,Барлығың жиналыңдар!
Dialogue: 0,0:13:13.70,0:13:17.54,Default,,0,0,0,,Эй, Ювия, сен достарыңды жеке-жеке жеңу туралы айтып тұрсың ғой, солай ма?
Dialogue: 0,0:13:17.63,0:13:19.00,Default,,0,0,0,,Иә
Dialogue: 0,0:13:19.08,0:13:21.05,Default,,0,0,0,,Онда неге менің артымнан келе жатырсың?
Dialogue: 0,0:13:21.13,0:13:24.47,Default,,0,0,0,,Өйткені Грей-самамен оңаша жүргеніме біраз уақыт болды...
Dialogue: 0,0:13:24.55,0:13:27.43,Default,,0,0,0,,Кешіріңіз, бірақ бұл алдайтын уақыт емес.
Dialogue: 0,0:13:27.51,0:13:29.43,Default,,0,0,0,,Хмм... Мен білемін!
Dialogue: 0,0:13:30.64,0:13:33.89,Default,,0,0,0,,Ювия Мен қазір сиқырды қолдана алмаймын.
Dialogue: 0,0:13:33.97,0:13:35.10,Default,,0,0,0,,Не! ?
Dialogue: 0,0:13:35.64,0:13:38.23,Default,,0,0,0,,Мүмкін гипноз бұзылса да—
Dialogue: 0,0:13:38.31,0:13:41.77,Default,,0,0,0,,Сиқырлы күштің өзі Ақ сиқыршының бақылауында қалады.
Dialogue: 0,0:13:41.86,0:13:45.65,Default,,0,0,0,,Ақ сиқыршы әр адамның сиқырлы күшін ажырату үшін қосымша әдісті қолданбаса...
Dialogue: 0,0:13:45.74,0:13:48.03,Default,,0,0,0,,Әр адамның сиқырлы күші де қайтып келмейді.
Dialogue: 0,0:13:48.11,0:13:53.08,Default,,0,0,0,,Бір адамды құтқарған сайын күш-қуатымыз артады деп күтудің мағынасы жоқ па...
Dialogue: 0,0:13:53.58,0:13:57.00,Default,,0,0,0,,Грей-сама, Ювия, мен сиқырды қолдана алмаймын.
Dialogue: 0,0:13:57.08,0:13:58.58,Default,,0,0,0,,Сен мені қорғайсың ба?
Dialogue: 0,0:13:59.17,0:14:00.54,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:00.63,0:14:02.80,Default,,0,0,0,,Мені тастама
Dialogue: 0,0:14:02.88,0:14:04.09,Default,,0,0,0,,Ювен!
Dialogue: 0,0:14:04.17,0:14:06.59,Default,,0,0,0,,Тағы бір рет! Бұл жолды тағы бір рет айтыңыз
Dialogue: 0,0:14:06.67,0:14:08.01,Default,,0,0,0,,Грэй мырза!
Dialogue: 0,0:14:08.09,0:14:10.85,Default,,0,0,0,,Әдеттегідей әлі де сырласу
Dialogue: 0,0:14:10.93,0:14:12.22,Default,,0,0,0,,Мен қызғаншақпын балапан
Dialogue: 0,0:14:12.30,0:14:14.22,Default,,0,0,0,,- (Қуыршақ) Флирт - (Қуыршақ) Мен қызғанамын.
Dialogue: 0,0:14:14.31,0:14:15.31,Default,,0,0,0,,Бикслоу!
Dialogue: 0,0:14:15.39,0:14:17.81,Default,,0,0,0,,Ностальгиялық сұр
Dialogue: 0,0:14:17.89,0:14:19.27,Default,,0,0,0,,Есіңде жоқ па?
Dialogue: 0,0:14:19.73,0:14:22.19,Default,,0,0,0,,Ертегі шайқасы
Dialogue: 0,0:14:22.27,0:14:25.23,Default,,0,0,0,,Мен сені мүлдем құрттым.
Dialogue: 0,0:14:25.82,0:14:27.44,Default,,0,0,0,,Қорқақтықпен
Dialogue: 0,0:14:28.49,0:14:31.41,Default,,0,0,0,,Сіз бұл жолы әділетті түрде жасайсыз ба?
Dialogue: 0,0:14:31.49,0:14:33.66,Default,,0,0,0,,Жоқ, білмеймін...
Dialogue: 0,0:14:33.74,0:14:34.99,Default,,0,0,0,,Ха…
Dialogue: 0,0:14:35.95,0:14:36.91,Default,,0,0,0,,босатылды!
Dialogue: 0,0:14:37.00,0:14:38.91,Default,,0,0,0,,- (Мәңгі жасыл) Сәлем! -Ха...
Dialogue: 0,0:14:39.71,0:14:40.92,Default,,0,0,0,,Мәңгі жасыл!
Dialogue: 0,0:14:41.67,0:14:43.92,Default,,0,0,0,,Ертегі бомбасы Гремлин!
Dialogue: 0,0:14:45.21,0:14:47.09,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:14:47.92,0:14:49.01,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:49.09,0:14:49.97,Default,,0,0,0,,Грей-сама!
Dialogue: 0,0:14:50.05,0:14:51.18,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:51.26,0:14:52.85,Default,,0,0,0,,Ювия! Жасыру!
Dialogue: 0,0:14:52.93,0:14:54.05,Default,,0,0,0,,Ах... Иә!
Dialogue: 0,0:14:55.56,0:14:57.98,Default,,0,0,0,,Ақ ілімді бұзғандар
Dialogue: 0,0:14:58.60,0:15:01.90,Default,,0,0,0,,Біз, найзағай құдайлары, үкім шығарамыз.
Dialogue: 0,0:15:03.02,0:15:05.11,Default,,0,0,0,,Сіз не айтып тұрсыз?
Dialogue: 0,0:15:05.19,0:15:07.44,Default,,0,0,0,,Балалар, сендер Лаксус табынушысыңдар, солай ма?
Dialogue: 0,0:15:09.78,0:15:10.90,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:15:12.16,0:15:12.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:13.07,0:15:15.12,Default,,0,0,0,,Люси қара!
Dialogue: 0,0:15:15.20,0:15:16.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:16.66,0:15:18.25,Default,,0,0,0,,- (Мираджан) Хехе... - (Лисанна) Жалғызсың ба?
Dialogue: 0,0:15:18.33,0:15:19.54,Default,,0,0,0,,Хан!
Dialogue: 0,0:15:19.62,0:15:22.04,Default,,0,0,0,,Мира-сан! ?
Dialogue: 0,0:15:22.12,0:15:23.38,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:15:23.83,0:15:25.88,Default,,0,0,0,,Ең күшті жұлдыз рухы!
Dialogue: 0,0:15:26.38,0:15:29.34,Default,,0,0,0,,Ашық! Арыстанның құрсағындағы есік!
Dialogue: 0,0:15:30.22,0:15:31.26,Default,,0,0,0,,Локи!
Dialogue: 0,0:15:33.22,0:15:35.89,Default,,0,0,0,,Бір қорқынышты нәрсе болатын сияқты.
Dialogue: 0,0:15:36.85,0:15:40.77,Default,,0,0,0,,Бірақ шынымды айтсам, Мира-чанды жеңе алатынымды білмеймін...
Dialogue: 0,0:15:40.85,0:15:42.27,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:15:42.44,0:15:44.23,Default,,0,0,0,,Баргоны да шақырыңыз!
Dialogue: 0,0:15:44.31,0:15:46.36,Default,,0,0,0,,Біраз уақыт болды, ханшайым!
Dialogue: 0,0:15:47.61,0:15:49.74,Default,,0,0,0,,Үшеуміз төбелессек те—
Dialogue: 0,0:15:49.82,0:15:51.95,Default,,0,0,0,,Мен Мираджанды жеңе аламын ба...
Dialogue: 0,0:15:52.03,0:15:53.99,Default,,0,0,0,,- (Люси) Бұл... - Мен келдім.
Dialogue: 0,0:15:54.07,0:15:55.74,Default,,0,0,0,,Бірақ... (түрту дыбысы)
Dialogue: 0,0:15:55.82,0:15:57.20,Default,,0,0,0,,Бізде мұны істеуден басқа амал жоқ!
Dialogue: 0,0:16:01.66,0:16:02.96,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:16:05.00,0:16:06.96,Default,,0,0,0,,Кааааа!
Dialogue: 0,0:16:07.04,0:16:10.80,Default,,0,0,0,,Саған әлі жаттығу жетіспейді, Макао Вакаба!
Dialogue: 0,0:16:10.88,0:16:12.59,Default,,0,0,0,,Қарғыс атсын... Нацу-ни!
Dialogue: 0,0:16:12.68,0:16:13.76,Default,,0,0,0,,Ах…
Dialogue: 0,0:16:13.84,0:16:14.93,Default,,0,0,0,,Уф…
Dialogue: 0,0:16:16.14,0:16:17.97,Default,,0,0,0,,Хехе... Ромео да.
Dialogue: 0,0:16:18.06,0:16:19.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:19.35,0:16:20.43,Default,,0,0,0,,Гихихи!
Dialogue: 0,0:16:20.52,0:16:22.10,Default,,0,0,0,,- (Бақытты) Уау! -Аспаз...
Dialogue: 0,0:16:23.19,0:16:24.02,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:27.06,0:16:28.44,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:28.52,0:16:29.53,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:29.61,0:16:30.78,Default,,0,0,0,,Ха…
Dialogue: 0,0:16:33.20,0:16:34.70,Default,,0,0,0,,Гихи!
Dialogue: 0,0:16:34.78,0:16:38.03,Default,,0,0,0,,Мен сені өлтіремін, Саламандер.
Dialogue: 0,0:16:39.41,0:16:42.87,Default,,0,0,0,,Мен сенімен шындап сөйлескеніме біраз болды.
Dialogue: 0,0:16:43.83,0:16:45.29,Default,,0,0,0,,Гаджил!
Dialogue: 0,0:16:46.92,0:16:48.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:51.00,0:16:53.38,Default,,0,0,0,,Кеттік, Гаджил!
Dialogue: 0,0:16:53.47,0:16:56.05,Default,,0,0,0,,Кел, Саламандер!
Dialogue: 0,0:16:57.72,0:16:59.51,Default,,0,0,0,,Нмм...
Dialogue: 0,0:16:59.60,0:17:00.72,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:17:01.31,0:17:02.39,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:03.02,0:17:04.14,Default,,0,0,0,,Бүгін жаңа мектепке бірінші күнің ғой?
Dialogue: 0,0:17:04.23,0:17:05.27,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:17:08.86,0:17:10.23,Default,,0,0,0,,Хаа!
Dialogue: 0,0:17:13.19,0:17:14.40,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:15.28,0:17:16.70,Default,,0,0,0,,(бас соғу дыбысы)
Dialogue: 0,0:17:16.78,0:17:17.87,Default,,0,0,0,,Гихи…
Dialogue: 0,0:17:17.95,0:17:18.99,Default,,0,0,0,,(бас соғу дыбысы)
Dialogue: 0,0:17:20.91,0:17:25.29,Default,,0,0,0,,Ұмытпа, менің таразысым темірден.
Dialogue: 0,0:17:25.37,0:17:27.21,Default,,0,0,0,,Itte~
Dialogue: 0,0:17:28.04,0:17:30.34,Default,,0,0,0,,Сені де ұмытпа.
Dialogue: 0,0:17:30.88,0:17:32.25,Default,,0,0,0,,Сен ұсқынсыз қатыгезсің!!
Dialogue: 0,0:17:35.72,0:17:38.80,Default,,0,0,0,,Менің жалыным темірді де күйдіреді
Dialogue: 0,0:17:40.55,0:17:41.76,Default,,0,0,0,,Гихи…
Dialogue: 0,0:17:42.93,0:17:44.22,Default,,0,0,0,,Ха…
Dialogue: 0,0:17:46.31,0:17:48.94,Default,,0,0,0,,Темір көлеңкелі айдаһар клубы! (соққы дыбысы)
Dialogue: 0,0:17:49.02,0:17:50.15,Default,,0,0,0,,Нацу!
Dialogue: 0,0:17:50.23,0:17:51.61,Default,,0,0,0,,Ух... ха...
Dialogue: 0,0:17:52.90,0:17:54.28,Default,,0,0,0,,Денем қан-қырынға толды!
Dialogue: 0,0:17:54.36,0:17:55.36,Default,,0,0,0,,Гах…
Dialogue: 0,0:17:55.86,0:17:56.99,Default,,0,0,0,,Айдаһар өлтірушінің құпия техникасы!
Dialogue: 0,0:17:57.07,0:17:57.95,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:58.03,0:17:59.82,Default,,0,0,0,,Иә! Мен оны қабылдауға дайынмын! ?
Dialogue: 0,0:17:59.91,0:18:02.74,Default,,0,0,0,,Карма: Темір құдай қылыш!
Dialogue: 0,0:18:03.12,0:18:04.29,Default,,0,0,0,,73 адам із-түссіз жоғалып кетті
Dialogue: 0,0:18:04.37,0:18:05.45,Default,,0,0,0,,Гррр…
Dialogue: 0,0:18:05.54,0:18:06.75,Default,,0,0,0,,Чи…
Dialogue: 0,0:18:08.37,0:18:09.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:09.96,0:18:11.84,Default,,0,0,0,,Жақсы… Ууууууу…
Dialogue: 0,0:18:12.63,0:18:15.80,Default,,0,0,0,,Бұл соңғы ұрысқанымыздан өзгеше.
Dialogue: 0,0:18:15.88,0:18:17.51,Default,,0,0,0,,(Жер жарылған дыбыс)
Dialogue: 0,0:18:17.59,0:18:19.97,Default,,0,0,0,,О, мен де.
Dialogue: 0,0:18:20.05,0:18:21.97,Default,,0,0,0,,Режим найзағайлы жалын айдаһары!
Dialogue: 0,0:18:24.39,0:18:26.27,Default,,0,0,0,,(ұшқын дыбысы)
Dialogue: 0,0:18:26.77,0:18:29.85,Default,,0,0,0,,Енді байыпты болайық, Саламандер!
Dialogue: 0,0:18:32.40,0:18:34.65,Default,,0,0,0,,Мен сені оятамын
Dialogue: 0,0:18:36.69,0:18:38.24,Default,,0,0,0,,Гихи…
Dialogue: 0,0:18:38.32,0:18:39.82,Default,,0,0,0,,Нацу...
Dialogue: 0,0:18:39.91,0:18:41.70,Default,,0,0,0,,-(Лили) Ио Бақытты -(Бақытты) Эй!
Dialogue: 0,0:18:42.66,0:18:45.45,Default,,0,0,0,,Осыны да шешейік.
Dialogue: 0,0:18:45.54,0:18:47.33,Default,,0,0,0,,Есеп айырысу дегеніміз не?
Dialogue: 0,0:18:47.41,0:18:50.46,Default,,0,0,0,,Сосын Гаджил мен Нацу төбелесіп жатыр.
Dialogue: 0,0:18:50.54,0:18:53.34,Default,,0,0,0,,Біздің серіктестеріміз де бір-бірімізбен соғысуымыз керек емес пе?
Dialogue: 0,0:18:53.42,0:18:54.34,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:18:54.42,0:18:57.09,Default,,0,0,0,,Сіз де ақ ілімді білуіңіз керек.
Dialogue: 0,0:18:57.17,0:18:58.67,Default,,0,0,0,,Барлығын ақ ...
Dialogue: 0,0:18:58.76,0:19:00.09,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:19:00.18,0:19:02.89,Default,,0,0,0,,Лилиді жеңу мүмкін емес!
Dialogue: 0,0:19:03.51,0:19:05.35,Default,,0,0,0,,Хехехе... Иә?
Dialogue: 0,0:19:08.43,0:19:10.89,Default,,0,0,0,,Ммм... Нмм...
Dialogue: 0,0:19:10.98,0:19:12.27,Default,,0,0,0,,Найзағай…
Dialogue: 0,0:19:12.90,0:19:13.86,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:13.94,0:19:16.61,Default,,0,0,0,,Бүгін... Бүгін үшін...
Dialogue: 0,0:19:16.98,0:19:20.40,Default,,0,0,0,,Мен оны қалдырамын ...
Dialogue: 0,0:19:20.90,0:19:22.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:22.95,0:19:27.33,Default,,0,0,0,,(Лилидің үрейлі дауысы)
Dialogue: 0,0:19:27.41,0:19:28.79,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,0:19:28.87,0:19:31.25,Default,,0,0,0,,Кешіріңіз, Лили!
Dialogue: 0,0:19:32.83,0:19:34.71,Default,,0,0,0,,…және балық
Dialogue: 0,0:19:38.09,0:19:40.13,Default,,0,0,0,,Иә! Мен сені есінен танып қалдым!
Dialogue: 0,0:19:40.22,0:19:42.30,Default,,0,0,0,,Нацу! мен оны істедім!
Dialogue: 0,0:19:42.38,0:19:44.60,Default,,0,0,0,,Эй, мен Лилиді жеңдім!
Dialogue: 0,0:19:44.68,0:19:46.43,Default,,0,0,0,,Бұл күтпеген шабуыл болды!
Dialogue: 0,0:19:49.85,0:19:51.27,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:53.23,0:19:54.56,Default,,0,0,0,,Қазір...
Dialogue: 0,0:20:04.99,0:20:07.37,Default,,0,0,0,,Мен сені қалай қорлай аламын?
Dialogue: 0,0:20:07.45,0:20:09.62,Default,,0,0,0,,Егер қорқытқың келсе, маған кел!
Dialogue: 0,0:20:09.70,0:20:12.25,Default,,0,0,0,,Ұстамдылық Мен ұят түрін ұнатамын!
Dialogue: 0,0:20:12.33,0:20:14.54,Default,,0,0,0,,Энн!
Dialogue: 0,0:20:14.63,0:20:16.04,Default,,0,0,0,,Балго!
Dialogue: 0,0:20:16.13,0:20:19.13,Default,,0,0,0,,Толығырақ сұрасам болады ма?
Dialogue: 0,0:20:19.21,0:20:20.88,Default,,0,0,0,,Мираджане-сама
Dialogue: 0,0:20:20.96,0:20:22.13,Default,,0,0,0,,Эй...
Dialogue: 0,0:20:22.22,0:20:23.72,Default,,0,0,0,,-Уау! -(Люси) Эй!
Dialogue: 0,0:20:24.72,0:20:26.35,Default,,0,0,0,,Локи!
Dialogue: 0,0:20:27.01,0:20:28.89,Default,,0,0,0,,Сіздің қарсыласыңыз – мен.
Dialogue: 0,0:20:29.39,0:20:34.48,Default,,0,0,0,,Зодиактың жетекші аспан рухы, Арыстан құрсақтағы арыстан сізді жеңеді!
Dialogue: 0,0:20:34.56,0:20:36.15,Default,,0,0,0,,Әйелім үшін
Dialogue: 0,0:20:36.23,0:20:37.27,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:20:37.36,0:20:40.03,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:20:40.11,0:20:41.32,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:42.24,0:20:43.82,Default,,0,0,0,,Ннн!
Dialogue: 0,0:20:46.16,0:20:47.53,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:47.62,0:20:48.83,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:20:50.04,0:20:51.08,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:51.62,0:20:54.79,Default,,0,0,0,,Эльфман Ол өте күшті болды!
Dialogue: 0,0:20:55.54,0:20:59.80,Default,,0,0,0,,Шын арыстан кім екенін шешейік, Локи
Dialogue: 0,0:20:59.88,0:21:00.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:01.00,0:21:02.01,Default,,0,0,0,,Люси!
Dialogue: 0,0:21:03.30,0:21:04.47,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:05.84,0:21:08.22,Default,,0,0,0,,Уф…
Dialogue: 0,0:21:08.30,0:21:11.18,Default,,0,0,0,,Өтінемін! Оян, Лисанна!
Dialogue: 0,0:21:11.81,0:21:14.98,Default,,0,0,0,,Оянатын сенсің, Люси!
Dialogue: 0,0:21:15.44,0:21:17.31,Default,,0,0,0,,Ах... Ннн...
Dialogue: 0,0:21:17.40,0:21:20.11,Default,,0,0,0,,Ол ақ түске боялған! бірге!
Dialogue: 0,0:21:20.19,0:21:22.07,Default,,0,0,0,,Қазірдің өзінде! Сен не туралы айтып тұрсың?
Dialogue: 0,0:21:22.94,0:21:23.99,Default,,0,0,0,,Иә, аға, сен кереметсің.
Dialogue: 0,0:21:24.07,0:21:25.11,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:27.41,0:21:31.91,Default,,0,0,0,,Бірақ, менде де жаңа ерекше қозғалыс бар!
Dialogue: 0,0:21:32.62,0:21:35.16,Default,,0,0,0,,Біраз ауыруы мүмкін, бірақ кешіріңіз!
Dialogue: 0,0:21:37.21,0:21:39.17,Default,,0,0,0,,Не? оның елтаңбасы
Dialogue: 0,0:22:04.48,0:22:05.69,Default,,0,0,0,,Жұлдызды көйлек (жұлдыздық көйлек)
Dialogue: 0,0:22:06.53,0:22:07.90,Default,,0,0,0,,Синтез
Dialogue: 0,0:22:08.91,0:22:10.91,Default,,0,0,0,,Лео x Варго формасы!
Dialogue: 0,0:22:15.12,0:22:19.46,Default,,0,0,0,,♪~
Dialogue: 0,0:23:39.00,0:23:45.00,Default,,0,0,0,,~♪
Dialogue: 0,0:23:46.50,0:23:52.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory