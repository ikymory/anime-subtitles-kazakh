Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.58,0:00:07.34,Default,,0,0,0,,«Ертегі шегелері»?
Dialogue: 0,0:00:08.04,0:00:10.59,Default,,0,0,0,,Бұл біздің гильдия атауына ұқсайды.
Dialogue: 0,0:00:10.67,0:00:12.47,Default,,0,0,0,,«Ертегі тырнақтары»?
Dialogue: 0,0:00:12.55,0:00:15.43,Default,,0,0,0,,Бұл «Fairy Nail» таланттар гильдиясы
Dialogue: 0,0:00:15.51,0:00:16.76,Default,,0,0,0,,Таланттар гильдиясы?
Dialogue: 0,0:00:16.85,0:00:19.10,Default,,0,0,0,,Бұл актерлерге арналған гильдия ма?
Dialogue: 0,0:00:19.18,0:00:22.27,Default,,0,0,0,,Әншілер, модельдер және әрине актерлер.
Dialogue: 0,0:00:22.35,0:00:25.06,Default,,0,0,0,,Бұл кең ауқымды қызметте белсенділік танытатын дарындылар гильдиясы.
Dialogue: 0,0:00:25.15,0:00:28.02,Default,,0,0,0,,Мұндай кездейсоқтықтар болады, солай емес пе?
Dialogue: 0,0:00:28.11,0:00:31.78,Default,,0,0,0,,Балалар, сендер гильдиядағы таланттарға ұқсайсыңдар.
Dialogue: 0,0:00:31.86,0:00:33.74,Default,,0,0,0,,Шынында да, сен және мен...
Dialogue: 0,0:00:33.82,0:00:36.82,Default,,0,0,0,,Бір-біріне ұқсаймыз десең, менің ойымша, біз ұқсаймыз...
Dialogue: 0,0:00:36.91,0:00:38.28,Default,,0,0,0,,Екі қауын сияқты
Dialogue: 0,0:00:38.37,0:00:41.70,Default,,0,0,0,,Ішіне қарағың келе ме?
Dialogue: 0,0:00:41.79,0:00:43.41,Default,,0,0,0,,Қызық көрінеді!
Dialogue: 0,0:00:43.50,0:00:45.96,Default,,0,0,0,,Менде жағымсыз сезім бар...
Dialogue: 0,0:00:46.46,0:00:52.46,Default,,0,0,0,,♪~
Dialogue: 0,0:02:09.37,0:02:14.63,Default,,0,0,0,,~♪
Dialogue: 0,0:02:20.55,0:02:22.22,Default,,0,0,0,,Мен бірден келдім!
Dialogue: 0,0:02:22.30,0:02:23.81,Default,,0,0,0,,Дәл солай!
Dialogue: 0,0:02:23.89,0:02:26.85,Default,,0,0,0,,Ол адам біздің ең басты жұлдызымыз Нак.
Dialogue: 0,0:02:26.93,0:02:29.85,Default,,0,0,0,,Әй, неміс, неміс, сен қайдасың?
Dialogue: 0,0:02:29.94,0:02:31.86,Default,,0,0,0,,Иә, мұнда!
Dialogue: 0,0:02:31.94,0:02:33.23,Default,,0,0,0,,Мен менеджермін! ?
Dialogue: 0,0:02:33.31,0:02:34.36,Default,,0,0,0,,Бұл Люсия.
Dialogue: 0,0:02:34.44,0:02:36.32,Default,,0,0,0,,Мен мұны үнемі айтамын деп ойлаймын!
Dialogue: 0,0:02:36.40,0:02:38.78,Default,,0,0,0,,Жылы кофе мүлдем кофе емес!
Dialogue: 0,0:02:38.86,0:02:40.66,Default,,0,0,0,,Мен... Кешіріңіз!
Dialogue: 0,0:02:40.74,0:02:44.62,Default,,0,0,0,,Сондай-ақ мен мұндай сұмдық рөлді ойнамас едім.
Dialogue: 0,0:02:44.70,0:02:48.58,Default,,0,0,0,,Сонымен...бірақ біз қазірдің өзінде пайда болу туралы айтып жатырмыз...
Dialogue: 0,0:02:49.25,0:02:51.62,Default,,0,0,0,,Егер мен мұны істемесем, мен мұны істемеймін.
Dialogue: 0,0:02:51.71,0:02:52.54,Default,,0,0,0,,Бірақ... Бірақ...
Dialogue: 0,0:02:52.63,0:02:54.59,Default,,0,0,0,,Ол өте ұялшақ жігіт.
Dialogue: 0,0:02:54.67,0:02:55.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:55.71,0:02:58.05,Default,,0,0,0,,Өтінемін, мені тым көп қорлауды доғара аласыз ба?
Dialogue: 0,0:02:58.13,0:03:00.55,Default,,0,0,0,,Аа, мистер Грей осында.
Dialogue: 0,0:03:00.63,0:03:01.68,Default,,0,0,0,,Ол Гленн
Dialogue: 0,0:03:01.76,0:03:03.43,Default,,0,0,0,,Ура!
Dialogue: 0,0:03:03.51,0:03:04.93,Default,,0,0,0,,Мен сырық билеушімін
Dialogue: 0,0:03:05.01,0:03:07.39,Default,,0,0,0,,Көпшілік алдында жалаңаш жүресің бе?
Dialogue: 0,0:03:07.47,0:03:09.35,Default,,0,0,0,,Неліктен ұялшақсың?
Dialogue: 0,0:03:09.43,0:03:12.40,Default,,0,0,0,,Жалаңаштығыңды көрсету де өнердің бір түрі.
Dialogue: 0,0:03:12.48,0:03:15.11,Default,,0,0,0,,Қараңызшы, Юбина да сонда.
Dialogue: 0,0:03:15.19,0:03:17.44,Default,,0,0,0,,Бұл төбесі жоқ биші.
Dialogue: 0,0:03:17.53,0:03:19.36,Default,,0,0,0,,Гленн, сіз жақсы жұмыс істеп жатқан сияқтысыз.
Dialogue: 0,0:03:19.44,0:03:21.15,Default,,0,0,0,,Джубина-сама сияқты жақсы емес.
Dialogue: 0,0:03:21.24,0:03:22.07,Default,,0,0,0,,Үстсіз…
Dialogue: 0,0:03:22.16,0:03:24.41,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:24.49,0:03:26.16,Default,,0,0,0,,Оны елестетпе!
Dialogue: 0,0:03:26.24,0:03:28.41,Default,,0,0,0,,Неліктен екеуі де «самацуке»?
Dialogue: 0,0:03:29.16,0:03:32.83,Default,,0,0,0,,Мына жақтағы адам Вендил, данышпан бала актер.
Dialogue: 0,0:03:32.92,0:03:34.71,Default,,0,0,0,,Сонымен... сен данышпансың ба? ?
Dialogue: 0,0:03:34.79,0:03:36.46,Default,,0,0,0,,Тынш... Мен оны көріп тұрмын.
Dialogue: 0,0:03:38.05,0:03:39.46,Default,,0,0,0,,Ахахха!
Dialogue: 0,0:03:39.55,0:03:40.67,Default,,0,0,0,,Уау...
Dialogue: 0,0:03:40.76,0:03:41.97,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:42.05,0:03:42.97,Default,,0,0,0,,Гунун…
Dialogue: 0,0:03:43.05,0:03:45.72,Default,,0,0,0,,0,5 секундта әртүрлі мимика жасауға болады
Dialogue: 0,0:03:45.80,0:03:46.80,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:03:46.89,0:03:49.10,Default,,0,0,0,,Майлағыштар жоқ па?
Dialogue: 0,0:03:49.18,0:03:51.35,Default,,0,0,0,,Артығы күткендей.
Dialogue: 0,0:03:52.14,0:03:53.23,Default,,0,0,0,,Тағы да оралып келдім
Dialogue: 0,0:03:53.31,0:03:54.77,Default,,0,0,0,,Шарлотта-чан пұтымен
Dialogue: 0,0:03:54.85,0:03:55.94,Default,,0,0,0,,Мысықты баптаңыз
Dialogue: 0,0:03:56.02,0:03:58.32,Default,,0,0,0,,Хмм, жарайды.
Dialogue: 0,0:03:58.40,0:03:59.32,Default,,0,0,0,,Мияу
Dialogue: 0,0:03:59.40,0:04:01.44,Default,,0,0,0,,Әй, бұл жай ғана мысық!
Dialogue: 0,0:04:01.90,0:04:03.74,Default,,0,0,0,,Сондай-ақ Бибби деген қара мысық бар.
Dialogue: 0,0:04:03.82,0:04:04.66,Default,,0,0,0,,Мияу
Dialogue: 0,0:04:04.74,0:04:06.41,Default,,0,0,0,,Күйеуім екеуміз әзілкешпіз—
Dialogue: 0,0:04:06.49,0:04:07.58,Default,,0,0,0,,Газель мен Лиззи
Dialogue: 0,0:04:07.66,0:04:10.16,Default,,0,0,0,,Бұл менің темір жегім келеді!
Dialogue: 0,0:04:10.25,0:04:11.91,Default,,0,0,0,,Неліктен? (көрермендер күлкі)
Dialogue: 0,0:04:12.00,0:04:13.29,Default,,0,0,0,,Жұп…
Dialogue: 0,0:04:13.37,0:04:15.88,Default,,0,0,0,,Модельдер Мина Джейн мен Лизара
Dialogue: 0,0:04:15.96,0:04:18.54,Default,,0,0,0,,Мира-чан көп өзгерген жоқ.
Dialogue: 0,0:04:18.63,0:04:20.63,Default,,0,0,0,,Эксклюзивті визажист Эльбиман
Dialogue: 0,0:04:20.71,0:04:24.26,Default,,0,0,0,,Мина-ни, соңғы кездері менің терім дөрекі болды.
Dialogue: 0,0:04:24.93,0:04:27.93,Default,,0,0,0,,Танымал рок-топ Lacris and Raioshu
Dialogue: 0,0:04:28.01,0:04:29.01,Default,,0,0,0,,О!
Dialogue: 0,0:04:29.51,0:04:31.02,Default,,0,0,0,,Аяқ соусымен...
Dialogue: 0,0:04:31.68,0:04:33.35,Default,,0,0,0,,Сексуалды актер Рокки
Dialogue: 0,0:04:33.43,0:04:34.60,Default,,0,0,0,,Сексуалды ма?
Dialogue: 0,0:04:34.69,0:04:36.40,Default,,0,0,0,,Жарайды, білмеймін!
Dialogue: 0,0:04:36.48,0:04:38.48,Default,,0,0,0,,Уау...
Dialogue: 0,0:04:38.56,0:04:41.11,Default,,0,0,0,,Барлығы таңқаларлықтай ұқсас
Dialogue: 0,0:04:41.19,0:04:43.36,Default,,0,0,0,,Бұл маған Эдорасты еске түсіреді.
Dialogue: 0,0:04:43.44,0:04:46.41,Default,,0,0,0,,Мира-чан ол жерде де өзгермеді.
Dialogue: 0,0:04:46.49,0:04:48.37,Default,,0,0,0,,...ал сіз?
Dialogue: 0,0:04:48.45,0:04:50.70,Default,,0,0,0,,Мен сахна актерімін
Dialogue: 0,0:04:50.79,0:04:53.37,Default,,0,0,0,,Ол өте танымал болып көрінді.
Dialogue: 0,0:04:53.45,0:04:55.42,Default,,0,0,0,,Қала тұрғындары шу көтерді.
Dialogue: 0,0:04:55.50,0:04:58.54,Default,,0,0,0,,Болды... Мен әлі осындамын.
Dialogue: 0,0:04:58.63,0:05:00.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:00.17,0:05:01.25,Default,,0,0,0,,Мегуми Фушигуро.
Dialogue: 0,0:05:02.09,0:05:06.22,Default,,0,0,0,,Мен өзімнің келесі сахналық рөлімді табуда қиналып жүрмін...
Dialogue: 0,0:05:06.76,0:05:10.85,Default,,0,0,0,,Айтыңызшы, менің актер болудан біраз білімім бар.
Dialogue: 0,0:05:10.93,0:05:11.97,Default,,0,0,0,,Ха! ?
Dialogue: 0,0:05:12.89,0:05:14.31,Default,,0,0,0,,Мен білмеймін...
Dialogue: 0,0:05:14.89,0:05:17.35,Default,,0,0,0,,Ғашық қыздың рөлін сомдайды.
Dialogue: 0,0:05:17.44,0:05:19.81,Default,,0,0,0,,Мен...
Dialogue: 0,0:05:19.90,0:05:21.94,Default,,0,0,0,,Менің махаббатта тәжірибем жоқ.
Dialogue: 0,0:05:22.65,0:05:23.90,Default,,0,0,0,,Махаббат
Dialogue: 0,0:05:24.65,0:05:26.90,Default,,0,0,0,,Уайымдама, неміс!
Dialogue: 0,0:05:26.99,0:05:29.66,Default,,0,0,0,,Мен өзімді кішкентай болса да ақымақ етіп көрсететін рөлді ойнамаймын!
Dialogue: 0,0:05:29.74,0:05:31.45,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:05:31.53,0:05:33.66,Default,,0,0,0,,Сіз аздап жазалауға лайықсыз.
Dialogue: 0,0:05:33.75,0:05:35.20,Default,,0,0,0,,-Кел! -(Люсия) Эй... Эй...
Dialogue: 0,0:05:35.29,0:05:36.46,Default,,0,0,0,,Нак мырза, тоқтаңыз...
Dialogue: 0,0:05:36.54,0:05:37.79,Default,,0,0,0,,Сол жігіт!
Dialogue: 0,0:05:37.87,0:05:41.04,Default,,0,0,0,,Мен енді шыдай алмаймын! Мен сәлем беремін!
Dialogue: 0,0:05:41.71,0:05:43.67,Default,,0,0,0,,Мені қорламаңыз
Dialogue: 0,0:05:43.76,0:05:46.01,Default,,0,0,0,,А... Мм... Тоқтау керек...
Dialogue: 0,0:05:50.72,0:05:51.68,Default,,0,0,0,,Қараңыз...
Dialogue: 0,0:05:51.76,0:05:53.93,Default,,0,0,0,,-Не болды? Люси - (Люси) Мен... білмеймін!
Dialogue: 0,0:05:54.02,0:05:58.77,Default,,0,0,0,,Мына екеуі, о, мен көріп тұрмын... олар керемет.
Dialogue: 0,0:05:58.85,0:06:01.94,Default,,0,0,0,,Кейде гильдияда біз істеуге болмайтын нәрселерді жасаймыз...
Dialogue: 0,0:06:02.02,0:06:03.19,Default,,0,0,0,,Мұны айтудың қажеті жоқ!
Dialogue: 0,0:06:03.98,0:06:05.99,Default,,0,0,0,,Бұл да махаббаттың бір түрі
Dialogue: 0,0:06:06.49,0:06:09.11,Default,,0,0,0,,Мен әртүрлі нәрселер бар екенін білемін, бірақ...
Dialogue: 0,0:06:09.20,0:06:11.20,Default,,0,0,0,,Себебі мен оны ешқашан бастан өткерген емеспін -
Dialogue: 0,0:06:11.28,0:06:13.12,Default,,0,0,0,,Мен білмеймін...
Dialogue: 0,0:06:14.62,0:06:16.66,Default,,0,0,0,,Маған жараса, әңгімеңді тыңдаймын.
Dialogue: 0,0:06:16.75,0:06:18.16,Default,,0,0,0,,Эльза...
Dialogue: 0,0:06:18.41,0:06:21.21,Default,,0,0,0,,Эльза жақсы, Элькис
Dialogue: 0,0:06:21.29,0:06:22.50,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:06:22.59,0:06:25.42,Default,,0,0,0,,Менің тәжірибем аз болса да
Dialogue: 0,0:06:25.51,0:06:26.88,Default,,0,0,0,,Сұр да.
Dialogue: 0,0:06:26.96,0:06:28.22,Default,,0,0,0,,Люси де.
Dialogue: 0,0:06:28.30,0:06:29.59,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:06:29.68,0:06:32.51,Default,,0,0,0,,Махаббатты бәрі біле бермейді.
Dialogue: 0,0:06:34.56,0:06:37.81,Default,,0,0,0,,Аға, қызық жігіттер еді.
Dialogue: 0,0:06:38.10,0:06:41.56,Default,,0,0,0,,Мен ең нашармын, мен жарақат аламын деп ойлаймын...
Dialogue: 0,0:06:41.65,0:06:44.07,Default,,0,0,0,,Мен Ювияның түрін көрмегелі біраз болды...
Dialogue: 0,0:06:44.15,0:06:45.57,Default,,0,0,0,,Оның жағдайы қалай?
Dialogue: 0,0:06:45.65,0:06:47.99,Default,,0,0,0,,Бұрынғы Юбина болатын.
Dialogue: 0,0:06:48.65,0:06:50.45,Default,,0,0,0,,Махаббат...
Dialogue: 0,0:06:50.53,0:06:52.95,Default,,0,0,0,,Грей-сама~!
Dialogue: 0,0:06:53.03,0:06:57.04,Default,,0,0,0,,Айтпақшы, Эльза Элькиспен не туралы сөйлесті?
Dialogue: 0,0:06:57.37,0:06:58.62,Default,,0,0,0,,- Ммм... - (Люси) Иә?
Dialogue: 0,0:06:59.12,0:07:00.58,Default,,0,0,0,,Эльза мырза?
Dialogue: 0,0:07:00.67,0:07:02.83,Default,,0,0,0,,Жоқ... жақсы, бұл...
Dialogue: 0,0:07:02.92,0:07:04.09,Default,,0,0,0,,Әртүрлі
Dialogue: 0,0:07:04.17,0:07:06.55,Default,,0,0,0,,(Пойыз ысқырығы)
Dialogue: 0,0:07:08.59,0:07:10.47,Default,,0,0,0,,Хмм…
Dialogue: 0,0:07:10.55,0:07:11.97,Default,,0,0,0,,Гуха...
Dialogue: 0,0:07:12.05,0:07:13.43,Default,,0,0,0,,Ой... қозғалды...
Dialogue: 0,0:07:13.51,0:07:15.05,Default,,0,0,0,,Жақсы, ол жұмыс істейді.
Dialogue: 0,0:07:15.14,0:07:16.31,Default,,0,0,0,,Бұл басталды
Dialogue: 0,0:07:16.39,0:07:17.43,Default,,0,0,0,,Жоғары…
Dialogue: 0,0:07:17.52,0:07:20.39,Default,,0,0,0,,Ммм...
Dialogue: 0,0:07:20.48,0:07:21.89,Default,,0,0,0,,Бұл мүмкін емес!
Dialogue: 0,0:07:21.98,0:07:23.90,Default,,0,0,0,,(Нацудың ыңырсыуы)
Dialogue: 0,0:07:23.98,0:07:26.36,Default,,0,0,0,,Не… не болды? Эльза
Dialogue: 0,0:07:26.90,0:07:29.40,Default,,0,0,0,,Кешіріңіз, жоқ...
Dialogue: 0,0:07:29.49,0:07:31.07,Default,,0,0,0,,Кешіріңіз (көзілдірік киген дыбыс)
Dialogue: 0,0:07:31.70,0:07:34.28,Default,,0,0,0,,Мен Элкиспін
Dialogue: 0,0:07:34.37,0:07:36.03,Default,,0,0,0,,Нағыз Эльза...
Dialogue: 0,0:07:36.12,0:07:37.08,Default,,0,0,0,,(Эльзаның жылағаны)
Dialogue: 0,0:07:37.16,0:07:40.87,Default,,0,0,0,,Рөлге түсе алмасам, онда ойнаймын...
Dialogue: 0,0:07:40.96,0:07:42.04,Default,,0,0,0,,Бас тарту!
Dialogue: 0,0:07:42.12,0:07:45.92,Default,,0,0,0,,Менің... махаббатым...
Dialogue: 0,0:07:46.00,0:07:47.80,Default,,0,0,0,,Елкис Не болып жатыр! ?
Dialogue: 0,0:07:48.63,0:07:49.46,Default,,0,0,0,,Һм… Ха-ха-ха
Dialogue: 0,0:07:49.55,0:07:52.22,Default,,0,0,0,,Жақсы емес! Маған ақшамды қайтар!
Dialogue: 0,0:07:53.05,0:07:54.68,Default,,0,0,0,,Ум...
Dialogue: 0,0:07:54.76,0:07:56.26,Default,,0,0,0,,Сіз қаншалықты ақымақсыз?
Dialogue: 0,0:07:56.35,0:07:57.85,Default,,0,0,0,,Уууу…
Dialogue: 0,0:07:57.93,0:08:00.10,Default,,0,0,0,,Соңында Эльза мен Элькис...
Dialogue: 0,0:08:00.18,0:08:01.77,Default,,0,0,0,,Бірден ауыстырылды—
Dialogue: 0,0:08:01.85,0:08:04.27,Default,,0,0,0,,Біз бастапқы мүшелерге оралдық—
Dialogue: 0,0:08:04.35,0:08:07.40,Default,,0,0,0,,Келесі күні үлкен Драшиэль қаласына барыңыз.
Dialogue: 0,0:08:07.86,0:08:11.44,Default,,0,0,0,,Пойыз жолда Рейнхилл станциясына келді.
Dialogue: 0,0:08:12.15,0:08:14.78,Default,,0,0,0,,Тоқтау уақыты 2 сағатты құрады!
Dialogue: 0,0:08:14.86,0:08:18.83,Default,,0,0,0,,Біз бүкіл уақыт бойы көліктің ішінде болдық, сондықтан алаңдау үшін сыртқа шықтық.
Dialogue: 0,0:08:18.91,0:08:20.91,Default,,0,0,0,,Эльза жоқ
Dialogue: 0,0:08:21.00,0:08:22.58,Default,,0,0,0,,Және…
Dialogue: 0,0:08:23.21,0:08:25.08,Default,,0,0,0,,Фу…
Dialogue: 0,0:08:25.17,0:08:26.92,Default,,0,0,0,,Ауа бұлтты
Dialogue: 0,0:08:27.63,0:08:29.55,Default,,0,0,0,,Бұл Вендидің тамағы.
Dialogue: 0,0:08:29.63,0:08:30.50,Default,,0,0,0,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:08:33.05,0:08:34.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:35.26,0:08:36.51,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:36.59,0:08:37.60,Default,,0,0,0,,Ювия!
Dialogue: 0,0:08:37.68,0:08:39.26,Default,,0,0,0,,Гленн мырза!
Dialogue: 0,0:08:39.60,0:08:41.27,Default,,0,0,0,,Жоқ, солай.
Dialogue: 0,0:08:41.35,0:08:42.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:42.27,0:08:45.23,Default,,0,0,0,,Текка қаласындағы таланттар гильдиясы...
Dialogue: 0,0:08:45.31,0:08:49.23,Default,,0,0,0,,Юбина, мен сенемін... Грей-сама.
Dialogue: 0,0:08:50.02,0:08:53.78,Default,,0,0,0,,Шынында да, сен Гленнге ұқсайсың.
Dialogue: 0,0:08:53.86,0:08:56.57,Default,,0,0,0,,Сіз мен білетін Ювияға ұқсайсыз.
Dialogue: 0,0:08:56.66,0:08:57.82,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:08:58.91,0:09:00.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:01.70,0:09:04.25,Default,,0,0,0,,Мені «Джубина-сама» деп атаңыз.
Dialogue: 0,0:09:04.33,0:09:06.33,Default,,0,0,0,,Жу... Юбина-сама
Dialogue: 0,0:09:06.87,0:09:08.75,Default,,0,0,0,,Сіз бұл қалаға жұмыс бабымен келдіңіз бе?
Dialogue: 0,0:09:08.83,0:09:12.26,Default,,0,0,0,,Иә, сен Юбинаның шығармашылығы туралы білесің бе?
Dialogue: 0,0:09:12.34,0:09:15.38,Default,,0,0,0,,Иә? Ах... жақсы...
Dialogue: 0,0:09:16.01,0:09:17.80,Default,,0,0,0,,-Оны көргіңіз келе ме? -Не! ?
Dialogue: 0,0:09:17.89,0:09:18.84,Default,,0,0,0,,Ой, жоқ!
Dialogue: 0,0:09:18.93,0:09:22.22,Default,,0,0,0,,Әй... Маған бұл мүлдем маңызды емес...
Dialogue: 0,0:09:22.31,0:09:25.52,Default,,0,0,0,,Қалжың болсын, ақша алмайынша көрсетпеймін.
Dialogue: 0,0:09:25.60,0:09:27.23,Default,,0,0,0,,Таң қалмаңыз
Dialogue: 0,0:09:27.31,0:09:29.23,Default,,0,0,0,,Мен таң қалдым!
Dialogue: 0,0:09:29.31,0:09:30.98,Default,,0,0,0,,Ол жоғалды... Дәл қазір!
Dialogue: 0,0:09:31.07,0:09:34.03,Default,,0,0,0,,Сіз де Гленн мырза сияқты киіміңізді шешкенді ұнатасыз ба?
Dialogue: 0,0:09:34.11,0:09:36.99,Default,,0,0,0,,Жоқ, бұл ескі әдет.
Dialogue: 0,0:09:37.07,0:09:38.28,Default,,0,0,0,,Бітті.
Dialogue: 0,0:09:38.82,0:09:40.62,Default,,0,0,0,,Джубина-сама ше?
Dialogue: 0,0:09:40.70,0:09:43.49,Default,,0,0,0,,Мен әйелмін... Көпшілік алдында...
Dialogue: 0,0:09:43.58,0:09:45.20,Default,,0,0,0,,Ұялмайсың ба?
Dialogue: 0,0:09:45.29,0:09:48.25,Default,,0,0,0,,Бұл менің сүйікті жұмысым болғандықтан емес.
Dialogue: 0,0:09:49.08,0:09:51.00,Default,,0,0,0,,-Мен көремін -Аа...
Dialogue: 0,0:09:51.09,0:09:52.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:52.59,0:09:54.34,Default,,0,0,0,,Не? сол бет
Dialogue: 0,0:09:54.42,0:09:56.51,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:09:56.76,0:09:59.18,Default,,0,0,0,,А, мен түсіндім.
Dialogue: 0,0:09:59.26,0:10:02.10,Default,,0,0,0,,Менің сүйікті Ювия-саманың жалаңаш денесі —
Dialogue: 0,0:10:02.18,0:10:06.06,Default,,0,0,0,,Мен басқа еркектерден көретінім - бұл күрделі.
Dialogue: 0,0:10:06.14,0:10:09.90,Default,,0,0,0,,Бұл дұрыс емес. Олар бір-біріне ұқсайды, бірақ олар басқа адамдар.
Dialogue: 0,0:10:09.98,0:10:12.27,Default,,0,0,0,,«Мен сені сүйемін», сіз оны жоққа шығармайсыз, солай ма?
Dialogue: 0,0:10:12.36,0:10:13.32,Default,,0,0,0,,Буха!
Dialogue: 0,0:10:13.98,0:10:15.78,Default,,0,0,0,,Ювия-сама сіздің сүйіктіңіз бе?
Dialogue: 0,0:10:15.86,0:10:19.24,Default,,0,0,0,,Жоқ, менің айтқым келгені бұл емес...
Dialogue: 0,0:10:19.45,0:10:21.66,Default,,0,0,0,,Сонда Грей-сама тегін бе?
Dialogue: 0,0:10:21.74,0:10:23.20,Default,,0,0,0,,Иә?Ах...
Dialogue: 0,0:10:23.28,0:10:24.45,Default,,0,0,0,,Жубинамен кездесуге барайық!
Dialogue: 0,0:10:24.91,0:10:27.29,Default,,0,0,0,,О... Эй!
Dialogue: 0,0:10:33.67,0:10:37.05,Default,,0,0,0,,...Ал Джубина-сама неге «сама» деп аталады?
Dialogue: 0,0:10:37.13,0:10:39.63,Default,,0,0,0,,Ал, Джубина - жұлдыз.
Dialogue: 0,0:10:39.72,0:10:40.76,Default,,0,0,0,,Я~
Dialogue: 0,0:10:40.84,0:10:43.10,Default,,0,0,0,,Осыдан Джубина мен Гленнің қарым-қатынасы
Dialogue: 0,0:10:43.18,0:10:44.26,Default,,0,0,0,,Саған бәрібір?
Dialogue: 0,0:10:44.35,0:10:46.97,Default,,0,0,0,,-Нақтырақ айтқанда -Не...
Dialogue: 0,0:10:48.68,0:10:51.23,Default,,0,0,0,,Маған бұрылу қиын.
Dialogue: 0,0:10:51.77,0:10:52.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:53.19,0:10:56.07,Default,,0,0,0,,Ол шабуылды жалғастыруда.
Dialogue: 0,0:10:56.65,0:11:00.40,Default,,0,0,0,,Тұзбен керемет үйлесімді.
Dialogue: 0,0:11:00.49,0:11:03.82,Default,,0,0,0,,Жарайды... Соған өкінемін...
Dialogue: 0,0:11:03.91,0:11:06.49,Default,,0,0,0,,Мен Джубинаның қалай сезінетінін білуім керек...
Dialogue: 0,0:11:06.58,0:11:08.12,Default,,0,0,0,,Егер Гленн-сама...
Dialogue: 0,0:11:08.20,0:11:11.12,Default,,0,0,0,,Мен... Кешіріңіз.
Dialogue: 0,0:11:12.25,0:11:13.38,Default,,0,0,0,,Я...
Dialogue: 0,0:11:13.46,0:11:16.50,Default,,0,0,0,,Мен маңызды болған кезде ғана бұлтартамын.
Dialogue: 0,0:11:16.59,0:11:17.55,Default,,0,0,0,,Гах…
Dialogue: 0,0:11:18.13,0:11:21.26,Default,,0,0,0,,Бірақ бәрібір, мен жақсы көргеннен гөрі жақсы көремін.
Dialogue: 0,0:11:21.34,0:11:23.51,Default,,0,0,0,,Өйткені бұл Джубинаның бақыты.
Dialogue: 0,0:11:23.59,0:11:25.81,Default,,0,0,0,,Күткендей, сенімді емес адам...
Dialogue: 0,0:11:25.89,0:11:26.97,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:11:27.06,0:11:28.39,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:11:28.47,0:11:30.69,Default,,0,0,0,,Ұнамаса, ұнамайды дегеніңіз жақсы...
Dialogue: 0,0:11:30.77,0:11:32.23,Default,,0,0,0,,Мен сені жек көрмеймін!
Dialogue: 0,0:11:33.19,0:11:35.02,Default,,0,0,0,,А... жоқ...
Dialogue: 0,0:11:35.23,0:11:36.57,Default,,0,0,0,,Бұл Ювия туралы.
Dialogue: 0,0:11:36.65,0:11:38.82,Default,,0,0,0,,Хмм... түсіндім.
Dialogue: 0,0:11:38.90,0:11:41.45,Default,,0,0,0,,Демек, сіз Гленн-сама сияқтысыз.
Dialogue: 0,0:11:41.53,0:11:44.62,Default,,0,0,0,,Мен Ювияға көңіл бөлемін.
Dialogue: 0,0:11:44.70,0:11:47.99,Default,,0,0,0,,Бірақ мен оны дәл қазір істей алмаймын.
Dialogue: 0,0:11:48.33,0:11:50.41,Default,,0,0,0,,Мен қашан болуым керек?
Dialogue: 0,0:11:50.50,0:11:53.33,Default,,0,0,0,,Ал, Юбина, бұл жұмыс.
Dialogue: 0,0:11:55.04,0:11:56.88,Default,,0,0,0,,Иә? Хмм...
Dialogue: 0,0:12:00.05,0:12:02.22,Default,,0,0,0,,Ах... Гах... Аа...
Dialogue: 0,0:12:03.13,0:12:04.68,Default,,0,0,0,,Қызмет!
Dialogue: 0,0:12:04.76,0:12:06.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:07.01,0:12:08.35,Default,,0,0,0,,Хи хи...
Dialogue: 0,0:12:08.43,0:12:11.93,Default,,0,0,0,,Олар бір-біріне ұқсайды, бірақ олар басқа адамдар, Джубина-сама.
Dialogue: 0,0:12:12.02,0:12:13.14,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:12:14.35,0:12:18.61,Default,,0,0,0,,Ювияның мен жасаған тыртықтары бар...
Dialogue: 0,0:12:18.69,0:12:22.11,Default,,0,0,0,,Сіз мәңгілік күтемін деп ойламауыңыз керек.
Dialogue: 0,0:12:22.19,0:12:23.74,Default,,0,0,0,,Сексуалды адам!
Dialogue: 0,0:12:23.82,0:12:27.37,Default,,0,0,0,,Мен білемін, сондықтан мен өзіме сенімді болғым келеді.
Dialogue: 0,0:12:28.16,0:12:31.79,Default,,0,0,0,,Оны қорғауға жеткілікті адам бол ...
Dialogue: 0,0:12:32.41,0:12:34.92,Default,,0,0,0,,Ювияны міндетті түрде алыңыз
Dialogue: 0,0:12:36.75,0:12:37.84,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:12:37.92,0:12:40.42,Default,,0,0,0,,Ой! Сіз күттіңіз бе? Джубина-сама
Dialogue: 0,0:12:40.50,0:12:41.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:42.05,0:12:44.43,Default,,0,0,0,,-Глен-сама~! -Аа...
Dialogue: 0,0:12:44.97,0:12:46.89,Default,,0,0,0,,Сәлеметсіз бе, қауесет Грей мырза.
Dialogue: 0,0:12:46.97,0:12:49.60,Default,,0,0,0,,Сәлем? Глен, сен маған ұқсайсың.
Dialogue: 0,0:12:49.68,0:12:52.43,Default,,0,0,0,,Әрине, Гленн салқынырақ, бірақ
Dialogue: 0,0:12:52.52,0:12:55.44,Default,,0,0,0,,Әй, менің әйеліме тиіспе, солай ма?
Dialogue: 0,0:12:55.52,0:12:57.65,Default,,0,0,0,,- Иә? -Кешіріңіз.
Dialogue: 0,0:12:57.73,0:13:00.19,Default,,0,0,0,,Негізі Юбина және басқалары кездесіп жүр!
Dialogue: 0,0:13:00.27,0:13:02.19,Default,,0,0,0,,Эй, ол менің әйелім.
Dialogue: 0,0:13:02.28,0:13:04.24,Default,,0,0,0,,-Ха! ? -Ой, қара.
Dialogue: 0,0:13:04.32,0:13:09.16,Default,,0,0,0,,Өткен күні Эльза-сама келгенде, ол сіздің барлық әңгімелеріңізді тыңдады.
Dialogue: 0,0:13:09.24,0:13:13.20,Default,,0,0,0,,Мен... Жувия-саманы аяймын, ал...
Dialogue: 0,0:13:13.29,0:13:14.41,Default,,0,0,0,,73 адам із-түссіз жоғалып кетті
Dialogue: 0,0:13:14.50,0:13:17.54,Default,,0,0,0,,Айтпақшы, Юбина, ол төбесі жоқ биші емес пе?
Dialogue: 0,0:13:17.63,0:13:18.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:18.54,0:13:22.00,Default,,0,0,0,,Жалаңаш әйелімді басқа еркекке көрсете алмаймын.
Dialogue: 0,0:13:22.09,0:13:24.59,Default,,0,0,0,,Бұл сіз купальникпен билейтін мейрамхана...
Dialogue: 0,0:13:24.67,0:13:29.35,Default,,0,0,0,,Қарашы, Елкіс-сама, әзіліңді байыппен қабылдағаның сонша, аңғал екенсің...
Dialogue: 0,0:13:29.43,0:13:30.47,Default,,0,0,0,,Ухуху…
Dialogue: 0,0:13:30.55,0:13:33.06,Default,,0,0,0,,Олай болса... Жарайды онда...
Dialogue: 0,0:13:33.14,0:13:35.06,Default,,0,0,0,,Жоқ... а...
Dialogue: 0,0:13:35.39,0:13:36.85,Default,,0,0,0,,Бұл екеуміздің арамыздағы құпия.
Dialogue: 0,0:13:36.94,0:13:37.77,Default,,0,0,0,,Ннн…
Dialogue: 0,0:13:37.85,0:13:40.69,Default,,0,0,0,,Неге сонша жасырын сөйлейсің, Джубина-сама!
Dialogue: 0,0:13:40.77,0:13:43.19,Default,,0,0,0,,Олай болса, міне, келдік.
Dialogue: 0,0:13:43.28,0:13:45.90,Default,,0,0,0,,Ювия-самаға сәлем айт!
Dialogue: 0,0:13:49.41,0:13:52.28,Default,,0,0,0,,Тыңда, Эльза! Егер бұл Нацу болса
Dialogue: 0,0:13:52.37,0:13:55.16,Default,,0,0,0,,Жақсы емес пе? Бір немесе екі күртеше
Dialogue: 0,0:13:55.25,0:13:57.46,Default,,0,0,0,,Тіпті іш киімім де жанып кетті!
Dialogue: 0,0:13:57.54,0:13:59.50,Default,,0,0,0,,Сіз не істедіңіз? Нацу
Dialogue: 0,0:13:59.58,0:14:01.92,Default,,0,0,0,,Люси-санды көтеріп алған адамдар...
Dialogue: 0,0:14:02.00,0:14:03.34,Default,,0,0,0,,Алып кетуге әрекеттену...
Dialogue: 0,0:14:03.42,0:14:05.30,Default,,0,0,0,,Импульс тым көп...
Dialogue: 0,0:14:05.38,0:14:07.17,Default,,0,0,0,,Олар бізді тіпті өртеп жіберді.
Dialogue: 0,0:14:07.26,0:14:08.59,Default,,0,0,0,,Ка~каккаккак!
Dialogue: 0,0:14:08.68,0:14:10.09,Default,,0,0,0,,Бұл қызық...
Dialogue: 0,0:14:10.18,0:14:12.56,Default,,0,0,0,,(Пойыз ысқырығы)
Dialogue: 0,0:14:12.64,0:14:13.76,Default,,0,0,0,,Гуха...
Dialogue: 0,0:14:13.85,0:14:16.93,Default,,0,0,0,,Сіз бірдеңе айттыңыз ба? Нацу-кун
Dialogue: 0,0:14:17.02,0:14:19.73,Default,,0,0,0,,Кешіріңіз... кешіріңіз... өтінемін...
Dialogue: 0,0:14:19.81,0:14:22.69,Default,,0,0,0,,-Ууууу... -Ой жаным...
Dialogue: 0,0:14:22.77,0:14:23.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:24.61,0:14:27.61,Default,,0,0,0,,Грей Саған да бірдеңе болды ма?
Dialogue: 0,0:14:27.70,0:14:29.57,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:14:29.66,0:14:31.70,Default,,0,0,0,,Ювия, сен жақсысың ба...
Dialogue: 0,0:14:31.78,0:14:32.99,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:14:33.74,0:14:35.87,Default,,0,0,0,,Ювия жақсы.
Dialogue: 0,0:14:35.95,0:14:37.29,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:14:37.71,0:14:39.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:39.42,0:14:41.63,Default,,0,0,0,,Біраз уақыт болды, Грей-сама.
Dialogue: 0,0:14:41.71,0:14:44.09,Default,,0,0,0,,Ювия келді.
Dialogue: 0,0:14:44.17,0:14:46.80,Default,,0,0,0,,Неге... неге Ювия-сама мұнда! ?
Dialogue: 0,0:14:47.92,0:14:49.34,Default,,0,0,0,,Сэм?
Dialogue: 0,0:14:49.43,0:14:51.59,Default,,0,0,0,,А... жоқ...
Dialogue: 0,0:14:51.68,0:14:54.72,Default,,0,0,0,,(Пойыз ысқырығы)
Dialogue: 0,0:14:59.27,0:15:01.65,Default,,0,0,0,,- (Бақытты) Уау! -Тамаша!
Dialogue: 0,0:15:01.73,0:15:04.11,Default,,0,0,0,,Ол крокустан үлкен емес пе?
Dialogue: 0,0:15:04.19,0:15:07.07,Default,,0,0,0,,Алдымен тойып ал! Меши! Меши!
Dialogue: 0,0:15:07.15,0:15:08.61,Default,,0,0,0,,That's right.
Dialogue: 0,0:15:08.69,0:15:12.53,Default,,0,0,0,,Ертең ақпарат жинап, бүгін демалайық.
Dialogue: 0,0:15:13.03,0:15:16.24,Default,,0,0,0,,-Адасып қалма -Не, мен?
Dialogue: 0,0:15:16.33,0:15:20.04,Default,,0,0,0,,Қараңызшы, мистер Грей! Мына жақтағы дүкен сүйкімді!
Dialogue: 0,0:15:20.12,0:15:21.71,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:15:23.21,0:15:25.17,Default,,0,0,0,,Ювия неге мұнда? ?
Dialogue: 0,0:15:25.75,0:15:28.42,Default,,0,0,0,,Мен оның сені қуғанына сенімдімін, солай ма?
Dialogue: 0,0:15:28.51,0:15:30.38,Default,,0,0,0,,Мен бұл мәселені түсіндім.
Dialogue: 0,0:15:30.47,0:15:33.64,Default,,0,0,0,,Ювияның Грей-сама сенсоры керемет!
Dialogue: 0,0:15:33.72,0:15:36.81,Default,,0,0,0,,Не болды, көмектесу мүмкін емес.
Dialogue: 0,0:15:36.89,0:15:38.60,Default,,0,0,0,,Гильдиядағылардың барлығы бірдей болып қала ма?
Dialogue: 0,0:15:39.10,0:15:40.94,Default,,0,0,0,,Гильдиядағылардың бәрі?
Dialogue: 0,0:15:41.56,0:15:43.19,Default,,0,0,0,,Не болды? жувия
Dialogue: 0,0:15:43.85,0:15:46.48,Default,,0,0,0,,Жоқ, бәрі жақсы.
Dialogue: 0,0:15:48.48,0:15:51.57,Default,,0,0,0,,А, мен тым көп жедім.
Dialogue: 0,0:15:51.65,0:15:52.95,Default,,0,0,0,,Мен де...
Dialogue: 0,0:15:53.03,0:15:56.03,Default,,0,0,0,,Иә? Бұл осы қаланың картасы ма?
Dialogue: 0,0:15:56.12,0:15:59.91,Default,,0,0,0,,Иә, оның қызықты пішіні бар.
Dialogue: 0,0:16:00.96,0:16:03.33,Default,,0,0,0,,Бүгінгі күн үшін көп рахмет.
Dialogue: 0,0:16:03.42,0:16:06.38,Default,,0,0,0,,Ювия, мен сенің жұмысыңа араласқым келмейді.
Dialogue: 0,0:16:06.46,0:16:08.84,Default,,0,0,0,,Мен ертең үйге баруды жоспарлап отырмын.
Dialogue: 0,0:16:08.92,0:16:12.68,Default,,0,0,0,,Мен үшін сізбен ұзақ уақыттан кейін танысқаныма қуаныштымын.
Dialogue: 0,0:16:13.05,0:16:17.14,Default,,0,0,0,,Келісімшартымызға байланысты біз квесттің егжей-тегжейлерін талқылай алмаймыз.
Dialogue: 0,0:16:17.22,0:16:19.14,Default,,0,0,0,,Тыныш күтіңіз.
Dialogue: 0,0:16:19.22,0:16:21.52,Default,,0,0,0,,Қайтып ораласыз ба?
Dialogue: 0,0:16:21.60,0:16:23.94,Default,,0,0,0,,Мен бір күні үйге барамын
Dialogue: 0,0:16:24.02,0:16:27.65,Default,,0,0,0,,А... Ювия мен уайымдап, уайымдап тұрмын...
Dialogue: 0,0:16:27.73,0:16:29.11,Default,,0,0,0,,- (Люси) Жарайды - (2 адам) Иә?
Dialogue: 0,0:16:29.19,0:16:31.69,Default,,0,0,0,,Біз біргеміз
Dialogue: 0,0:16:31.78,0:16:35.36,Default,,0,0,0,,Мен Люсидің жақын жерде болғанына қатты алаңдаймын.
Dialogue: 0,0:16:35.45,0:16:38.03,Default,,0,0,0,,Бұл да жақсы.
Dialogue: 0,0:16:39.37,0:16:42.04,Default,,0,0,0,,Сіздің көңіл-күйіңіз өзгерді ме?
Dialogue: 0,0:16:42.12,0:16:44.29,Default,,0,0,0,,Не? Бірдеңе дұрыс емес пе?
Dialogue: 0,0:16:44.37,0:16:49.46,Default,,0,0,0,,Гильдияның күндізгі жағдайын естігенде біраз ойландым.
Dialogue: 0,0:16:49.55,0:16:50.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:51.46,0:16:52.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:53.55,0:16:55.93,Default,,0,0,0,,Гильдияда бірдеңе болды ма?
Dialogue: 0,0:16:56.30,0:16:59.01,Default,,0,0,0,,Гильдияда бірдеңе болды...
Dialogue: 0,0:16:59.47,0:17:02.22,Default,,0,0,0,,Иә? Мен есімде жоқ...
Dialogue: 0,0:17:02.31,0:17:03.14,Default,,0,0,0,,Ювия?
Dialogue: 0,0:17:04.02,0:17:07.77,Default,,0,0,0,,Гильдияға жаңа адам қосылғанына сенімдімін...
Dialogue: 0,0:17:07.86,0:17:10.52,Default,,0,0,0,,Ювия бұл адамнан күдіктенеді...
Dialogue: 0,0:17:10.61,0:17:11.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:11.94,0:17:13.32,Default,,0,0,0,,Ха…
Dialogue: 0,0:17:13.40,0:17:15.78,Default,,0,0,0,,Ақ сиқыршыдан сақ болыңыз!
Dialogue: 0,0:17:15.86,0:17:17.03,Default,,0,0,0,,Ах…
Dialogue: 0,0:17:17.95,0:17:19.45,Default,,0,0,0,,- Ювия! -Джувиа!
Dialogue: 0,0:17:19.53,0:17:21.91,Default,,0,0,0,,Сәлем! Мықты бол, Ювия!
Dialogue: 0,0:17:21.99,0:17:24.12,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:17:24.20,0:17:26.00,Default,,0,0,0,,Ха... Қандай дыбыс! ?
Dialogue: 0,0:17:26.08,0:17:28.33,Default,,0,0,0,,-Уау! -(Люси) Жер!
Dialogue: 0,0:17:28.42,0:17:29.50,Default,,0,0,0,,Жер сілкінісі! ?
Dialogue: 0,0:17:29.59,0:17:31.46,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:17:31.55,0:17:33.42,Default,,0,0,0,,Жер көтеріледі...
Dialogue: 0,0:17:33.96,0:17:37.84,Default,,0,0,0,,Қараңызшы, қалада бәрі жақсы! ?
Dialogue: 0,0:17:38.43,0:17:40.76,Default,,0,0,0,,О, сен саяхатшысың ба?
Dialogue: 0,0:17:40.85,0:17:42.35,Default,,0,0,0,,Бұл не? Бұл
Dialogue: 0,0:17:42.89,0:17:45.93,Default,,0,0,0,,Өйткені біз мұны күн сайын бір уақытта жасаймыз...
Dialogue: 0,0:17:46.02,0:17:48.02,Default,,0,0,0,,Бұл уақыт сигналы ретінде қарастырылады, бірақ...
Dialogue: 0,0:17:48.10,0:17:50.15,Default,,0,0,0,,Сіз бірінші рет таң қаласыз.
Dialogue: 0,0:17:50.23,0:17:52.11,Default,,0,0,0,,- (Люси) А... - Күнде бір уақытта?
Dialogue: 0,0:17:52.19,0:17:54.90,Default,,0,0,0,,Жарайды, жақында тоқтайды.
Dialogue: 0,0:17:54.99,0:17:56.78,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:57.57,0:17:59.24,Default,,0,0,0,,Жер бетінде…
Dialogue: 0,0:18:00.16,0:18:01.70,Default,,0,0,0,,Физикалық тәрбие сабағы басталып кетті.
Dialogue: 0,0:18:01.78,0:18:05.16,Default,,0,0,0,,Үлкен ағаштарға дұға ет...
Dialogue: 0,0:18:05.25,0:18:06.87,Default,,0,0,0,,Ағаштар?
Dialogue: 0,0:18:11.63,0:18:12.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:12.84,0:18:15.34,Default,,0,0,0,,Бұл қаланың пішіні...
Dialogue: 0,0:18:18.22,0:18:19.38,Default,,0,0,0,,Қол!
Dialogue: 0,0:18:19.47,0:18:20.51,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:20.59,0:18:21.43,Default,,0,0,0,,Hand?
Dialogue: 0,0:18:21.51,0:18:23.39,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:18:28.69,0:18:31.56,Default,,0,0,0,,Маған қамқор болған сен бе? Рақмет…
Dialogue: 0,0:18:32.48,0:18:34.48,Default,,0,0,0,,Біз қайдамыз...
Dialogue: 0,0:18:34.57,0:18:39.15,Default,,0,0,0,,Иә, қол, Драшиэльдің оң қолы.
Dialogue: 0,0:18:39.24,0:18:41.32,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:18:42.49,0:18:46.29,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:18:56.09,0:18:57.46,Default,,0,0,0,,Олдрон…
Dialogue: 0,0:18:57.55,0:18:59.42,Default,,0,0,0,,Қала сіздің қолыңызда! ?
Dialogue: 0,0:18:59.51,0:19:01.39,Default,,0,0,0,,Эй, біз...
Dialogue: 0,0:19:01.47,0:19:04.60,Default,,0,0,0,,Сіз Олдронның шыңындасыз ба?
Dialogue: 0,0:19:05.01,0:19:06.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:06.43,0:19:10.14,Default,,0,0,0,,Мен оның үлкен екенін естідім, бірақ ол тым үлкен болуы керек.
Dialogue: 0,0:19:12.06,0:19:14.44,Default,,0,0,0,,Ювия, жақсысың ба...
Dialogue: 0,0:19:14.52,0:19:16.57,Default,,0,0,0,,Бірдеңе дұрыс болмады.
Dialogue: 0,0:19:16.65,0:19:19.90,Default,,0,0,0,,«Ақ сиқыршыдан сақ бол» Ол жиіркенішті нәрсе айтты.
Dialogue: 0,0:19:19.99,0:19:21.57,Default,,0,0,0,,Ақ сиқыршы?
Dialogue: 0,0:19:21.66,0:19:23.49,Default,,0,0,0,,Мен мұны бір жерден естігендей болдым...
Dialogue: 0,0:19:23.57,0:19:25.95,Default,,0,0,0,,Қарамирден естіген сөздерім осы.
Dialogue: 0,0:19:26.03,0:19:30.83,Default,,0,0,0,,Егер есімде дұрыс болса, мен одан су құдайы Айдаһардың күшін басуды сұрауға бардым...
Dialogue: 0,0:19:31.29,0:19:33.17,Default,,0,0,0,,Неге Ювияның аузынан шықты...
Dialogue: 0,0:19:33.25,0:19:35.92,Default,,0,0,0,,Гильдияға бірдеңе болды ма?
Dialogue: 0,0:19:36.00,0:19:37.88,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,0:19:37.96,0:19:39.01,Default,,0,0,0,,Қалай болғанда да—
Dialogue: 0,0:19:39.09,0:19:42.13,Default,,0,0,0,,Ювияға келсек, күте тұрайық.
Dialogue: 0,0:19:42.22,0:19:44.97,Default,,0,0,0,,Егер мен оянсам, мен тағы бір нәрсені білуім мүмкін.
Dialogue: 0,0:19:45.05,0:19:48.56,Default,,0,0,0,,Біз де Олдрон туралы ойлауымыз керек.
Dialogue: 0,0:19:48.64,0:19:51.35,Default,,0,0,0,,Бұл Олдронның үстінде.
Dialogue: 0,0:19:51.44,0:19:55.90,Default,,0,0,0,,Мен іздеген айдаһардың үстінде қала болады деп ойламаппын.
Dialogue: 0,0:19:56.40,0:19:58.48,Default,,0,0,0,,Оның үстіне мұндағыдай көлемдегі қала бар —
Dialogue: 0,0:19:58.57,0:20:01.95,Default,,0,0,0,,Сол қол Артқа Екі иық
Dialogue: 0,0:20:02.20,0:20:03.95,Default,,0,0,0,,Барлығы 5
Dialogue: 0,0:20:04.45,0:20:06.16,Default,,0,0,0,,Масштаб тым үлкен—
Dialogue: 0,0:20:06.24,0:20:08.12,Default,,0,0,0,,Мен неге екенін түсінбеймін.
Dialogue: 0,0:20:08.20,0:20:10.45,Default,,0,0,0,,Мен сені жұдырықтай аламын деп ойлаймын.
Dialogue: 0,0:20:10.54,0:20:11.96,Default,,0,0,0,,Міне.
Dialogue: 0,0:20:12.04,0:20:15.04,Default,,0,0,0,,Бұл жолы айдаһарды қалай мөрлеу керектігі туралы айтпас бұрын—
Dialogue: 0,0:20:15.13,0:20:18.67,Default,,0,0,0,,Ең үлкен сұрақ - оны жабу дұрыс па?
Dialogue: 0,0:20:18.75,0:20:19.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:20.01,0:20:24.68,Default,,0,0,0,,Басқаша айтқанда, бұл қаланың тұрғындары Олдронмен бірге өмір сүреді.
Dialogue: 0,0:20:25.18,0:20:27.80,Default,,0,0,0,,Олдронның мөрленуі арқылы —
Dialogue: 0,0:20:27.89,0:20:32.10,Default,,0,0,0,,Бұл осы бес қалаға да әсер етуі мүмкін дегенді білдіре ме?
Dialogue: 0,0:20:32.18,0:20:35.69,Default,,0,0,0,,Бұл жолы да солай! Бұл жаман айдаһар емес! ?
Dialogue: 0,0:20:35.77,0:20:37.31,Default,,0,0,0,,Жүйе жоқ сияқты.
Dialogue: 0,0:20:38.07,0:20:39.27,Default,,0,0,0,,Біз—
Dialogue: 0,0:20:39.36,0:20:41.78,Default,,0,0,0,,Грей мен басқаларды Ювиаға қамқорлық жасау үшін қалдыру.
Dialogue: 0,0:20:41.86,0:20:44.45,Default,,0,0,0,,Мен ақпарат жинау үшін қалаға бардым.
Dialogue: 0,0:20:44.53,0:20:46.20,Default,,0,0,0,,Күндіз бетіңізді жерге қаратып—
Dialogue: 0,0:20:46.28,0:20:47.53,Default,,0,0,0,,Сіз ұйықтап жатырсыз ба?
Dialogue: 0,0:20:47.62,0:20:49.49,Default,,0,0,0,,Күн сайын белгіленген уақытта не қозғалады?
Dialogue: 0,0:20:49.58,0:20:51.66,Default,,0,0,0,,Бұл «созылу» сияқты ма?
Dialogue: 0,0:20:51.75,0:20:56.12,Default,,0,0,0,,Ал, сенің айдаһардың үстіне қала салуға не себеп болды?
Dialogue: 0,0:20:56.21,0:20:59.46,Default,,0,0,0,,Бұл Олдрон-саманың ниеті.
Dialogue: 0,0:20:59.54,0:21:01.09,Default,,0,0,0,,Мен естідім...
Dialogue: 0,0:21:01.17,0:21:04.13,Default,,0,0,0,,Атамның атасының ата ұрпағы...
Dialogue: 0,0:21:04.22,0:21:06.51,Default,,0,0,0,,300 жылдан астам уақыт бұрын?
Dialogue: 0,0:21:06.59,0:21:09.14,Default,,0,0,0,,Ағаш айдаһар Олдроннан—
Dialogue: 0,0:21:09.22,0:21:13.48,Default,,0,0,0,,«Менің денемде қала тұрғыз» десе керек.
Dialogue: 0,0:21:14.14,0:21:15.98,Default,,0,0,0,,Мен естідім...
Dialogue: 0,0:21:16.06,0:21:17.73,Default,,0,0,0,,​​Не үшін?
Dialogue: 0,0:21:17.81,0:21:19.73,Default,,0,0,0,,Мен онша көп білмеймін.
Dialogue: 0,0:21:19.82,0:21:21.02,Default,,0,0,0,,Мен естідім...
Dialogue: 0,0:21:21.11,0:21:23.24,Default,,0,0,0,,Балалар сендер саяхатшысыңдар.
Dialogue: 0,0:21:23.32,0:21:25.03,Default,,0,0,0,,Ишғардан келген
Dialogue: 0,0:21:25.11,0:21:27.45,Default,,0,0,0,,О... Қайсысы...
Dialogue: 0,0:21:27.53,0:21:30.28,Default,,0,0,0,,Қаланы аралап көрсетейін бе?
Dialogue: 0,0:21:30.37,0:21:31.62,Default,,0,0,0,,Бұл көмектеседі
Dialogue: 0,0:21:31.70,0:21:33.87,Default,,0,0,0,,Не болды? Нацу
Dialogue: 0,0:21:33.95,0:21:37.25,Default,,0,0,0,,Жоқ... анау қарттың иісі.
Dialogue: 0,0:21:37.33,0:21:39.58,Default,,0,0,0,,Бұл қандай сезім...
Dialogue: 0,0:21:39.67,0:21:43.80,Default,,0,0,0,,Бұл сауда ауданы, туристер жиналатын жер
Dialogue: 0,0:21:43.88,0:21:45.09,Default,,0,0,0,,Мен естідім...
Dialogue: 0,0:21:45.17,0:21:47.22,Default,,0,0,0,,А... Осыны естідің бе?
Dialogue: 0,0:21:47.30,0:21:49.72,Default,,0,0,0,,Бұл Олдрон тауарлары
Dialogue: 0,0:21:49.80,0:21:53.22,Default,,0,0,0,,Бұл Олдрон қуыршақ әсіресе танымал.
Dialogue: 0,0:21:53.31,0:21:54.93,Default,,0,0,0,,Мен естідім...
Dialogue: 0,0:21:55.02,0:21:58.52,Default,,0,0,0,,Бұл Олдрон оң жақ ортаңғы саусақ саябағы
Dialogue: 0,0:21:58.60,0:21:59.90,Default,,0,0,0,,Мен естідім...
Dialogue: 0,0:22:00.44,0:22:02.36,Default,,0,0,0,,Сақина саусағы
Dialogue: 0,0:22:02.44,0:22:04.57,Default,,0,0,0,,Қызғылт көл
Dialogue: 0,0:22:04.65,0:22:07.61,Default,,0,0,0,,Ал бұл Драшиелдің орталығы.
Dialogue: 0,0:22:07.70,0:22:10.03,Default,,0,0,0,,Әулие Рейшен шіркеуі
Dialogue: 0,0:22:10.12,0:22:11.16,Default,,0,0,0,,Мен естідім...
Dialogue: 0,0:22:11.24,0:22:13.04,Default,,0,0,0,,Мен… солай болар деп ойлаймын…
Dialogue: 0,0:22:13.87,0:22:16.25,Default,,0,0,0,,Біз, Драшиел халқы...
Dialogue: 0,0:22:16.33,0:22:18.29,Default,,0,0,0,,Барлығы, Жер...
Dialogue: 0,0:22:18.37,0:22:21.96,Default,,0,0,0,,Басқаша айтқанда, лорд Олдронға дұға етуді ұмытпаңыз.
Dialogue: 0,0:22:22.04,0:22:23.96,Default,,0,0,0,,Біз қазір-
Dialogue: 0,0:22:24.05,0:22:28.13,Default,,0,0,0,,Лорд Олдронның бай жеріне байланысты.
Dialogue: 0,0:22:28.22,0:22:30.26,Default,,0,0,0,,Сондықтан...
Dialogue: 0,0:22:30.34,0:22:33.47,Default,,0,0,0,,Сондықтан Олдрон-саманы қорқытқандар...
Dialogue: 0,0:22:33.56,0:22:35.39,Default,,0,0,0,,Оны тірі қалдырайық
Dialogue: 0,0:22:35.47,0:22:36.73,Default,,0,0,0,,(Изунаның ырылы)
Dialogue: 0,0:22:36.81,0:22:37.85,Default,,0,0,0,,Тыңдалған
Dialogue: 0,0:22:37.93,0:22:39.94,Default,,0,0,0,,Ха…
Dialogue: 0,0:22:43.44,0:22:45.15,Default,,0,0,0,,Не... не?! ?
Dialogue: 0,0:22:45.73,0:22:49.07,Default,,0,0,0,,Бұл Ақ сиқыршы шіркеулерінің бірі.
Dialogue: 0,0:22:49.15,0:22:51.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:51.11,0:22:53.20,Default,,0,0,0,,Мен естідім...
Dialogue: 0,0:22:53.28,0:22:57.20,Default,,0,0,0,,Және бәрің екі қылмыс жасадыңдар.
Dialogue: 0,0:22:57.29,0:22:58.50,Default,,0,0,0,,Бір нәрсе…
Dialogue: 0,0:22:58.58,0:23:00.79,Default,,0,0,0,,Ақ сиқыршы шіркеуінің ілімдеріне қайшы —
Dialogue: 0,0:23:00.87,0:23:04.38,Default,,0,0,0,,Тым үлкен сиқырлы күшке ие
Dialogue: 0,0:23:04.46,0:23:05.38,Default,,0,0,0,,Екі…
Dialogue: 0,0:23:05.46,0:23:07.55,Default,,0,0,0,,Олдронды жою үшін
Dialogue: 0,0:23:07.63,0:23:09.59,Default,,0,0,0,,Сіз осында келдіңіз
Dialogue: 0,0:23:09.67,0:23:10.80,Default,,0,0,0,,Неге олай...
Dialogue: 0,0:23:11.72,0:23:13.10,Default,,0,0,0,,Ақ сиқыршы-сама...
Dialogue: 0,0:23:13.18,0:23:15.06,Default,,0,0,0,,Барлығын көр, Эльза
Dialogue: 0,0:23:15.14,0:23:16.06,Default,,0,0,0,,Мира!?
Dialogue: 0,0:23:16.14,0:23:18.02,Default,,0,0,0,,- (Люси) Мира! ? - (Бақытты) Неге?
Dialogue: 0,0:23:18.10,0:23:20.64,Default,,0,0,0,,Бұл иіс Мираның иісі ме?
Dialogue: 0,0:23:23.36,0:23:25.15,Default,,0,0,0,,Хм... не істеп жатырсың!
Dialogue: 0,0:23:25.61,0:23:28.61,Default,,0,0,0,,Бұрынғыдай ойнайық, Эльза
Dialogue: 0,0:23:28.69,0:23:30.74,Default,,0,0,0,,Сіз ше...
Dialogue: 0,0:23:30.82,0:23:33.78,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:23:33.87,0:23:35.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:35.37,0:23:36.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:36.74,0:23:38.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:39.62,0:23:45.62,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory