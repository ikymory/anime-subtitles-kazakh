Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.91,0:00:05.13,Default,,0,0,0,,Бұл дүние қандай шіркін?
Dialogue: 0,0:00:06.25,0:00:08.34,Default,,0,0,0,,Мені тоқтату мүмкін емес
Dialogue: 0,0:00:08.42,0:00:10.71,Default,,0,0,0,,Жалын айдаһар патшасы...
Dialogue: 0,0:00:10.80,0:00:12.67,Default,,0,0,0,,Коукен!
Dialogue: 0,0:00:13.47,0:00:15.39,Default,,0,0,0,,Hyuma Zero no Tachi!
Dialogue: 0,0:00:16.14,0:00:18.10,Default,,0,0,0,,Tenryu's Roar!
Dialogue: 0,0:00:18.68,0:00:20.31,Default,,0,0,0,,Акваметрия!
Dialogue: 0,0:00:20.97,0:00:22.52,Default,,0,0,0,,Бенизакур жарқ!
Dialogue: 0,0:00:23.64,0:00:24.48,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,0:00:27.48,0:00:28.73,Default,,0,0,0,,Бұл жұмыс істемейді! ?
Dialogue: 0,0:00:29.40,0:00:30.73,Default,,0,0,0,,Шабуылыңызды бәсеңдетпеңіз!
Dialogue: 0,0:00:30.82,0:00:33.19,Default,,0,0,0,,О!
Dialogue: 0,0:00:35.61,0:00:37.74,Default,,0,0,0,,Не? бұл жарық
Dialogue: 0,0:00:37.82,0:00:40.45,Default,,0,0,0,,Бұл сиқырлы күштің массасы!
Dialogue: 0,0:00:42.00,0:00:43.83,Default,,0,0,0,,Бұл не!
Dialogue: 0,0:00:43.91,0:00:46.62,Default,,0,0,0,,Менің денем... қозғалмайды!
Dialogue: 0,0:00:46.71,0:00:49.09,Default,,0,0,0,,Ал... Мен сиқырды қолдана алмаймын!
Dialogue: 0,0:00:49.75,0:00:51.42,Default,,0,0,0,,Не болып жатыр! ?
Dialogue: 0,0:00:52.01,0:00:54.55,Default,,0,0,0,,Эфир нано концентрациясы тым жоғары...
Dialogue: 0,0:00:54.63,0:00:55.80,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:00.43,0:01:05.94,Default,,0,0,0,,♪~
Dialogue: 0,0:02:24.43,0:02:29.60,Default,,0,0,0,,~♪
Dialogue: 0,0:02:37.36,0:02:38.65,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:02:39.15,0:02:40.91,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:02:41.41,0:02:44.70,Default,,0,0,0,,Мен сиқырды қолдана алмаймын, өйткені менде сиқырлы күш тым көп.
Dialogue: 0,0:02:44.78,0:02:46.33,Default,,0,0,0,,Не айтып тұрсың!
Dialogue: 0,0:02:46.41,0:02:48.16,Default,,0,0,0,,Бұл біртүрлі!
Dialogue: 0,0:02:49.12,0:02:50.16,Default,,0,0,0,,Сонда бәрі бір сәтте бітеді.
Dialogue: 0,0:02:51.21,0:02:53.00,Default,,0,0,0,,Толып кетті!
Dialogue: 0,0:02:53.08,0:02:54.09,Default,,0,0,0,,Айрин! ?
Dialogue: 0,0:02:54.67,0:02:58.05,Default,,0,0,0,,Өйткені менің сиқырлы күшім шегіне жетті
Dialogue: 0,0:02:58.13,0:03:01.38,Default,,0,0,0,,Менің денем менің сиқырлы күшімнің нөлге жеткенін дұрыс түсінбейді.
Dialogue: 0,0:03:01.47,0:03:02.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:02.39,0:03:03.72,Default,,0,0,0,,Мысалы—
Dialogue: 0,0:03:03.80,0:03:07.68,Default,,0,0,0,,Сізде тек 99-ға дейін көрсете алатын есептегіш бар делік.
Dialogue: 0,0:03:07.77,0:03:11.64,Default,,0,0,0,,Дисплей 100-ге жеткенде не болады?
Dialogue: 0,0:03:11.73,0:03:12.77,Default,,0,0,0,,Нөл!
Dialogue: 0,0:03:12.85,0:03:14.23,Default,,0,0,0,,Иә
Dialogue: 0,0:03:14.31,0:03:19.11,Default,,0,0,0,,Сондықтан менің денем менің сиқырлы күшім нөлге айналды деп қате ойлайды.
Dialogue: 0,0:03:19.19,0:03:21.11,Default,,0,0,0,,Бірақ іс жүзінде бұл басқаша.
Dialogue: 0,0:03:21.78,0:03:23.49,Default,,0,0,0,,Ол жасаған сиқырлы күшпен—
Dialogue: 0,0:03:23.57,0:03:27.04,Default,,0,0,0,,Әр адамның сиқырлы күші оның шегінен тыс күшейе түсті.
Dialogue: 0,0:03:27.99,0:03:32.50,Default,,0,0,0,,Денеңізді еске түсіріңіз
Dialogue: 0,0:03:33.00,0:03:35.59,Default,,0,0,0,,Менің сиқырлы күшім және менің денем...
Dialogue: 0,0:03:35.67,0:03:38.63,Default,,0,0,0,,Қанша қиындықты жеңдіңіз?
Dialogue: 0,0:03:39.30,0:03:40.55,Default,,0,0,0,,Я...
Dialogue: 0,0:03:41.67,0:03:45.22,Default,,0,0,0,,Сонда ғана түсінесің...
Dialogue: 0,0:03:45.80,0:03:46.76,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:47.68,0:03:50.22,Default,,0,0,0,,Менің шегім бұл жерде емес!
Dialogue: 0,0:03:50.31,0:03:51.68,Default,,0,0,0,,Бүгін жаңа мектепке бірінші күнің ғой?
Dialogue: 0,0:03:55.94,0:03:57.40,Default,,0,0,0,,Иә!
Dialogue: 0,0:03:58.27,0:03:59.44,Default,,0,0,0,,Венди! ?
Dialogue: 0,0:03:59.53,0:04:00.90,Default,,0,0,0,,Кенеттен ересек адам болыңыз!
Dialogue: 0,0:04:00.99,0:04:03.15,Default,,0,0,0,,Бұл уақытша!
Dialogue: 0,0:04:03.24,0:04:04.36,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:04:04.86,0:04:08.95,Default,,0,0,0,,Барлығына! Бұл сіздің денеңіздің қателесуі ғана!
Dialogue: 0,0:04:09.04,0:04:11.12,Default,,0,0,0,,Сиқырлы күш нөлге тең емес
Dialogue: 0,0:04:11.20,0:04:13.08,Default,,0,0,0,,Сіз шектен асып кеттіңіз!
Dialogue: 0,0:04:13.96,0:04:15.79,Default,,0,0,0,,Шектен тыс…
Dialogue: 0,0:04:15.88,0:04:18.59,Default,,0,0,0,,Өз күшіңізге сеніңіз!
Dialogue: 0,0:04:18.67,0:04:21.76,Default,,0,0,0,,Біз күрескен жолды есте сақта!
Dialogue: 0,0:04:22.26,0:04:24.01,Default,,0,0,0,,О!
Dialogue: 0,0:04:24.84,0:04:25.89,Default,,0,0,0,,Сиқырлы күш...
Dialogue: 0,0:04:25.97,0:04:27.68,Default,,0,0,0,,Артқа оралу...
Dialogue: 0,0:04:27.76,0:04:29.10,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:04:29.76,0:04:31.81,Default,,0,0,0,,Шектен тыс күш!
Dialogue: 0,0:04:31.89,0:04:34.56,Default,,0,0,0,,Бұл күй ұзаққа бармайды!
Dialogue: 0,0:04:34.64,0:04:36.02,Default,,0,0,0,,Қазір!
Dialogue: 0,0:04:36.73,0:04:38.94,Default,,0,0,0,,-Сәлем! -(Люси) Иә!
Dialogue: 0,0:04:39.02,0:04:41.69,Default,,0,0,0,,Сиқырлы күш күшейді!
Dialogue: 0,0:04:41.78,0:04:43.44,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:04:43.95,0:04:45.28,Default,,0,0,0,,Ұсқынсыз...
Dialogue: 0,0:04:45.36,0:04:48.45,Default,,0,0,0,,Ұсқынсыз ба, әдемі ме, бәрібір!
Dialogue: 0,0:04:48.53,0:04:52.83,Default,,0,0,0,,Кім не десе де, біз өз жолымызды жалғастырамыз!
Dialogue: 0,0:04:52.91,0:04:54.29,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:04:54.37,0:04:55.83,Default,,0,0,0,,Ой, ой… қандай шулы жұрт…
Dialogue: 0,0:04:57.42,0:04:59.71,Default,,0,0,0,,Ол Fairy Tail сиқыршысы!
Dialogue: 0,0:05:00.38,0:05:02.84,Default,,0,0,0,,– деді Джосукэ Хигасиката. Гү…
Dialogue: 0,0:05:07.89,0:05:09.10,Default,,0,0,0,,Я...
Dialogue: 0,0:05:09.18,0:05:10.01,Default,,0,0,0,,Уф…
Dialogue: 0,0:05:10.43,0:05:11.64,Default,,0,0,0,,Тиіп көр!
Dialogue: 0,0:05:11.72,0:05:14.35,Default,,0,0,0,,Бірақ бұл жердің сиқырлы күші әлі де жоғары!
Dialogue: 0,0:05:14.43,0:05:16.19,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:05:16.27,0:05:18.86,Default,,0,0,0,,Кінәлі сияқты бірдеңені құртып жіберсем де.
Dialogue: 0,0:05:18.94,0:05:20.27,Default,,0,0,0,,Нуо!
Dialogue: 0,0:05:20.36,0:05:23.65,Default,,0,0,0,,Егер бұл орын алса, мен барлық толып жатқан сиқырлы күшті жеймін!
Dialogue: 0,0:05:23.74,0:05:24.82,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:05:24.90,0:05:27.70,Default,,0,0,0,,Мен қолымнан келгенін жасадым.
Dialogue: 0,0:05:27.78,0:05:29.28,Default,,0,0,0,,Дегенмен, енді ғана не болды?
Dialogue: 0,0:05:29.37,0:05:31.45,Default,,0,0,0,,Қашу!
Dialogue: 0,0:05:31.53,0:05:34.00,Default,,0,0,0,,...Бірақ жер астында, дәл осы жерде!
Dialogue: 0,0:05:34.08,0:05:36.87,Default,,0,0,0,,Хахаха! Бақытты артта қалдырмауым керек еді.
Dialogue: 0,0:05:36.96,0:05:38.21,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:05:38.29,0:05:41.42,Default,,0,0,0,,Барго жолды жерге қосады!
Dialogue: 0,0:05:41.50,0:05:42.63,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:42.71,0:05:44.96,Default,,0,0,0,,(сыртылдаған дыбыс)
Dialogue: 0,0:05:47.63,0:05:49.18,Default,,0,0,0,,Нацу және басқалар...
Dialogue: 0,0:05:49.26,0:05:51.26,Default,,0,0,0,,Сіз мұны істегеніңізге сенімдімін!
Dialogue: 0,0:05:51.35,0:05:53.22,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:05:53.31,0:05:54.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:54.43,0:05:55.43,Default,,0,0,0,,Ха…
Dialogue: 0,0:05:55.52,0:05:59.10,Default,,0,0,0,,Балалар, мұны дәл қазір сездіңдер! ?
Dialogue: 0,0:05:59.19,0:06:00.56,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,0:06:00.65,0:06:03.40,Default,,0,0,0,,Сиқырлы күштің орасан зор мөлшері жоғалып кетті!
Dialogue: 0,0:06:03.48,0:06:05.36,Default,,0,0,0,,Нацу-сан және басқалар...
Dialogue: 0,0:06:05.44,0:06:08.03,Default,,0,0,0,,Тіпті жойылып бара жатқан ата-бабаларым -
Dialogue: 0,0:06:08.11,0:06:11.37,Default,,0,0,0,,Мен Alta Face-ті әрең басып тастадым.
Dialogue: 0,0:06:11.45,0:06:13.33,Default,,0,0,0,,Мен бұл балаларды ешқашан ойламаппын...
Dialogue: 0,0:06:13.41,0:06:17.66,Default,,0,0,0,,Жоқ, дәл қазір бізге әлемнің сиқырлы күшін тұрақтандыру керек!
Dialogue: 0,0:06:17.75,0:06:18.79,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:18.87,0:06:22.25,Default,,0,0,0,,Барлығы дұға етіп, зейінін жинақтасын!
Dialogue: 0,0:06:22.34,0:06:24.80,Default,,0,0,0,,Біздің жойылуымыздың күшімен -
Dialogue: 0,0:06:24.88,0:06:26.88,Default,,0,0,0,,Әлемдегі үйлесімділік!
Dialogue: 0,0:06:26.96,0:06:28.13,Default,,0,0,0,,Гармония!
Dialogue: 0,0:06:30.18,0:06:32.43,Default,,0,0,0,,Бұл күні Эрентияның сиқырлы күші...
Dialogue: 0,0:06:32.51,0:06:34.89,Default,,0,0,0,,Бірде ол үлкен дәрежеде ісінеді -
Dialogue: 0,0:06:34.97,0:06:37.85,Default,,0,0,0,,Ақырында ол қалыпты жағдайға оралып, тынышталды.
Dialogue: 0,0:06:38.85,0:06:40.94,Default,,0,0,0,,Alta Faith кеткенде...
Dialogue: 0,0:06:41.02,0:06:46.23,Default,,0,0,0,,Бұдан былай сиқырлы күш толып, қиын болады... Ондай болмайды.
Dialogue: 0,0:06:48.28,0:06:51.28,Default,,0,0,0,,Сонда да сиқырдың тұрақтылығы мен үндестігі...
Dialogue: 0,0:06:51.36,0:06:54.45,Default,,0,0,0,,Бізге ақ қырылған ауылдың күші әлі керек сияқты.
Dialogue: 0,0:06:54.53,0:06:57.70,Default,,0,0,0,,Ауылдағылардың бәрі біраз уақыт қолы босамайтын сияқты.
Dialogue: 0,0:06:59.50,0:07:03.08,Default,,0,0,0,,Енді ойлап қарасам, Селеннің кезінде жамандық жасап жүрген адамдар...
Dialogue: 0,0:07:03.17,0:07:05.88,Default,,0,0,0,,Олар бастапқыда Эрентиядан болған.
Dialogue: 0,0:07:06.09,0:07:09.67,Default,,0,0,0,,Эрентия заңдары бойынша сотталып, түрмеге жабылды
Dialogue: 0,0:07:09.76,0:07:12.59,Default,,0,0,0,,Цк... естеріңде болсын, балалар.
Dialogue: 0,0:07:12.68,0:07:17.14,Default,,0,0,0,,Әй... тұтқынға түскенде олар маған не істейді?
Dialogue: 0,0:07:17.22,0:07:18.89,Default,,0,0,0,,Хмм... Люси
Dialogue: 0,0:07:18.98,0:07:20.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:20.10,0:07:22.60,Default,,0,0,0,,Бір күні тағы шайқасайық!
Dialogue: 0,0:07:22.69,0:07:25.73,Default,,0,0,0,,Бұл біраз...
Dialogue: 0,0:07:25.82,0:07:26.69,Default,,0,0,0,,Ақыл-ой сынақтарының атымен—
Dialogue: 0,0:07:26.77,0:07:29.86,Default,,0,0,0,,Ауыл... Дүниені құтқарған батыр!
Dialogue: 0,0:07:29.94,0:07:33.32,Default,,0,0,0,,...Сонымен қонақжайлық дастархан жайылды.
Dialogue: 0,0:07:34.16,0:07:37.91,Default,,0,0,0,,Нацу біз жөндеген ғимаратты тағы да қиратты.
Dialogue: 0,0:07:37.99,0:07:41.87,Default,,0,0,0,,Жалаңаш болу күнәсі Жерден де ауыр.
Dialogue: 0,0:07:41.96,0:07:46.25,Default,,0,0,0,,Эльза оны тоқтатуға тырысады, бірақ соңы үлкен төбелеске ұласты...
Dialogue: 0,0:07:46.67,0:07:49.51,Default,,0,0,0,,Шулы, бірақ жылы түн болды.
Dialogue: 0,0:07:49.59,0:07:50.97,Default,,0,0,0,,Ал, дәл қазір осы жерде бір-біріңді сүйіңдер.
Dialogue: 0,0:07:51.05,0:07:54.09,Default,,0,0,0,,Бірақ бәрі қызық.
Dialogue: 0,0:07:55.05,0:07:57.72,Default,,0,0,0,,Селена мен Созаку жоғалып кетті...
Dialogue: 0,0:07:57.81,0:08:02.48,Default,,0,0,0,,Бізді алаңдататын тағы бір нәрсе болды.
Dialogue: 0,0:08:03.48,0:08:06.69,Default,,0,0,0,,Өйткені мен күтпеген жерден басқа әлемге келдім.
Dialogue: 0,0:08:07.36,0:08:09.90,Default,,0,0,0,,Гильдия достары күтіп тұр...
Dialogue: 0,0:08:10.49,0:08:13.65,Default,,0,0,0,,Ал, үйге кететін уақыт болды.
Dialogue: 0,0:08:13.74,0:08:17.49,Default,,0,0,0,,Е! Сенің осында мәңгі қалуыңа тілектеспін!
Dialogue: 0,0:08:17.58,0:08:19.24,Default,,0,0,0,,Жабысып қалма, әже.
Dialogue: 0,0:08:19.33,0:08:20.75,Default,,0,0,0,,Оны да айта алмайсың.
Dialogue: 0,0:08:20.83,0:08:23.33,Default,,0,0,0,,Бұл дүние енді жақсы болады.
Dialogue: 0,0:08:23.41,0:08:26.54,Default,,0,0,0,,Құрметті Бақытты, мен сені сағынамын.
Dialogue: 0,0:08:26.63,0:08:29.96,Default,,0,0,0,,Дехехехе... Мен сені тағы көремін.
Dialogue: 0,0:08:30.55,0:08:32.67,Default,,0,0,0,,-Чарль да -Аа...
Dialogue: 0,0:08:32.76,0:08:35.64,Default,,0,0,0,,Сізге көп рахмет Бақытты
Dialogue: 0,0:08:35.72,0:08:39.31,Default,,0,0,0,,Бол... Мен оның қамқоршысы емеспін, бірақ мен...
Dialogue: 0,0:08:39.39,0:08:40.31,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,0:08:40.39,0:08:42.85,Default,,0,0,0,,Иә? Фарис мырза?
Dialogue: 0,0:08:42.93,0:08:47.77,Default,,0,0,0,,Мен бәріңе қанша қиындық тудырдым...
Dialogue: 0,0:08:47.86,0:08:50.90,Default,,0,0,0,,Менің ойымша, бұл әлемді құтқару болды.
Dialogue: 0,0:08:50.98,0:08:54.86,Default,,0,0,0,,Мені Селена арбады, уайымдама.
Dialogue: 0,0:08:54.95,0:08:58.32,Default,,0,0,0,,Бірақ мен...
Dialogue: 0,0:08:58.78,0:09:01.95,Default,,0,0,0,,Жарайды, мен сені бір рет ұрайын, сонда болды.
Dialogue: 0,0:09:02.04,0:09:04.96,Default,,0,0,0,,Жоқ! Сіз оны қалай басқаруды білмейсіз.
Dialogue: 0,0:09:05.04,0:09:08.67,Default,,0,0,0,,Сен мені қатты ұрасың, тіпті қыз болса да!
Dialogue: 0,0:09:08.75,0:09:09.79,Default,,0,0,0,,Иә, бірақ
Dialogue: 0,0:09:10.34,0:09:11.67,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:09:11.75,0:09:14.42,Default,,0,0,0,,Жұмыс біткенше мені ұруға болады!
Dialogue: 0,0:09:14.51,0:09:19.89,Default,,0,0,0,,Мен бұл күнәні қалай өтерімді білмеймін.
Dialogue: 0,0:09:19.97,0:09:22.72,Default,,0,0,0,,Жарайды! Жарайды, мен дайынмын.
Dialogue: 0,0:09:22.81,0:09:23.85,Default,,0,0,0,,Ей!
Dialogue: 0,0:09:23.93,0:09:25.81,Default,,0,0,0,,
Dialogue: 0,0:09:25.89,0:09:27.52,Default,,0,0,0,,Сәлем Нацу
Dialogue: 0,0:09:27.60,0:09:29.56,Default,,0,0,0,,Нацу-сан, тоқташы өтінемін!
Dialogue: 0,0:09:30.11,0:09:31.19,Default,,0,0,0,,Ха…
Dialogue: 0,0:09:31.90,0:09:33.53,Default,,0,0,0,,Тістеріңізді қысыңыз!
Dialogue: 0,0:09:33.61,0:09:34.86,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:35.57,0:09:40.95,Default,,0,0,0,,Сіз менің достарымды бір-бірімен ұрыстырып жібердіңіз.
Dialogue: 0,0:09:41.03,0:09:42.41,Default,,0,0,0,,Иә
Dialogue: 0,0:09:42.91,0:09:44.66,Default,,0,0,0,,Бұл...
Dialogue: 0,0:09:45.25,0:09:46.08,Default,,0,0,0,,(түртіп алған дыбыс)
Dialogue: 0,0:09:46.16,0:09:48.62,Default,,0,0,0,,Өте ыстық болды!
Dialogue: 0,0:09:48.71,0:09:50.08,Default,,0,0,0,,Ха…
Dialogue: 0,0:09:50.67,0:09:55.09,Default,,0,0,0,,Біраз уақыттан кейін бірінші рет барлығымен төбелесу өте қызықты болды!
Dialogue: 0,0:09:55.59,0:09:58.13,Default,,0,0,0,,Тағы бір рет жасаңыз!
Dialogue: 0,0:09:58.22,0:10:01.72,Default,,0,0,0,,Ертегілер шайқасы 3-бөлім!
Dialogue: 0,0:10:02.81,0:10:06.10,Default,,0,0,0,,...Мені көп ұрмайсың ба?
Dialogue: 0,0:10:06.18,0:10:08.64,Default,,0,0,0,,Мен сені қатты ұратын едім.
Dialogue: 0,0:10:08.73,0:10:10.40,Default,,0,0,0,,(Фарис айқайы)
Dialogue: 0,0:10:10.48,0:10:13.69,Default,,0,0,0,,Жүрегіңізде «Рахмет»!
Dialogue: 0,0:10:14.28,0:10:17.49,Default,,0,0,0,,Сізге не үшін алғыс айтылады? Мен
Dialogue: 0,0:10:17.57,0:10:20.53,Default,,0,0,0,,Мен түсінбеймін...
Dialogue: 0,0:10:20.62,0:10:22.53,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:10:22.62,0:10:24.54,Default,,0,0,0,,Бұл Нацу, солай ма?
Dialogue: 0,0:10:25.79,0:10:30.00,Default,,0,0,0,,Содан кейін біз Жерге ораламыз.
Dialogue: 0,0:10:32.04,0:10:33.29,Default,,0,0,0,,Біз—
Dialogue: 0,0:10:33.38,0:10:35.63,Default,,0,0,0,,Бастапқы әлемге оралды
Dialogue: 0,0:10:36.76,0:10:38.22,Default,,0,0,0,,Гильдиядағы барлық адамдар -
Dialogue: 0,0:10:38.30,0:10:42.30,Default,,0,0,0,,Біз кенет жоғалып кеткенімізде ол бізді қатты уайымдаса керек.
Dialogue: 0,0:10:42.39,0:10:46.31,Default,,0,0,0,,Бұл дүниеге астральды рухтар әлемі арқылы келген Локи...
Dialogue: 0,0:10:46.39,0:10:49.06,Default,,0,0,0,,Жақсы түсіндіріп берген сияқтысыз.
Dialogue: 0,0:10:50.02,0:10:51.56,Default,,0,0,0,,Мен үйдемін!
Dialogue: 0,0:10:51.65,0:10:53.36,Default,,0,0,0,,Барлығы, біраз уақыт өтті!
Dialogue: 0,0:10:53.44,0:10:55.61,Default,,0,0,0,,Сізді қайта көргеніме қуаныштымын
Dialogue: 0,0:10:55.69,0:10:57.07,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:10:57.15,0:10:58.82,Default,,0,0,0,,Грей-сама~!
Dialogue: 0,0:10:59.61,0:11:00.65,Default,,0,0,0,,Ювия
Dialogue: 0,0:11:01.11,0:11:03.41,Default,,0,0,0,,Сіз бір жерде жарақат алдыңыз ба?
Dialogue: 0,0:11:03.49,0:11:06.29,Default,,0,0,0,,Ювия сізді тексереді. Жүр, киімдеріңді шешіңдер!
Dialogue: 0,0:11:06.37,0:11:09.16,Default,,0,0,0,,Менде бәрі жақсы. Жақсы болдыңыз ба?
Dialogue: 0,0:11:09.25,0:11:12.25,Default,,0,0,0,,Бұл қазірдің өзінде алаңдатады және алаңдатады ...
Dialogue: 0,0:11:12.33,0:11:15.54,Default,,0,0,0,,Мен көптеген сұр-сама қуыршақтарын жасадым!
Dialogue: 0,0:11:15.63,0:11:16.88,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:11:16.96,0:11:18.71,Default,,0,0,0,,Сұр түсті нәрсе.
Dialogue: 0,0:11:18.80,0:11:20.63,Default,,0,0,0,,Сіздің Ювияға берген жауабыңыз өзгерді ме?
Dialogue: 0,0:11:20.72,0:11:21.88,Default,,0,0,0,,Жоқ-қ-қ-қ-қ…
Dialogue: 0,0:11:21.97,0:11:24.14,Default,,0,0,0,,Лу-чан, қош келдіңіз!
Dialogue: 0,0:11:24.22,0:11:27.14,Default,,0,0,0,,Леви-чан! Денеңізді қалай сезінесіз?
Dialogue: 0,0:11:27.22,0:11:28.85,Default,,0,0,0,,Бұл өте жақсы.
Dialogue: 0,0:11:29.31,0:11:30.77,Default,,0,0,0,,Жұмыртқа туды ма?
Dialogue: 0,0:11:30.85,0:11:33.31,Default,,0,0,0,,Нацу: Бұл жұмыртқа емес.
Dialogue: 0,0:11:33.40,0:11:35.36,Default,,0,0,0,,Қалай қатысуға болатыны таңқаларлық емес.
Dialogue: 0,0:11:35.44,0:11:36.57,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:11:36.65,0:11:40.70,Default,,0,0,0,,О? Не істеп жатырсың, Гаджил? Жанып жатыр!
Dialogue: 0,0:11:40.78,0:11:42.36,Default,,0,0,0,,Мен бала емеспін.
Dialogue: 0,0:11:42.45,0:11:45.20,Default,,0,0,0,,Біз әр ақымақ нәрсе үшін ұрысамыз ба?
Dialogue: 0,0:11:45.74,0:11:49.12,Default,,0,0,0,,Не болды? Гаджил кенет ересек адам сияқты әрекет етеді.
Dialogue: 0,0:11:49.20,0:11:53.08,Default,,0,0,0,,Менің ойымша, ол өзінше бірте-бірте өсіп келеді.
Dialogue: 0,0:11:53.71,0:11:56.54,Default,,0,0,0,,О? Неге мұны жасамайсың, Гаджил-сан?
Dialogue: 0,0:11:56.63,0:11:59.05,Default,,0,0,0,,- Қараңдар! Қара, қара, қара... -Гах... Мен бала емеспін.
Dialogue: 0,0:11:59.13,0:12:01.51,Default,,0,0,0,,Хорехо!
Dialogue: 0,0:12:03.30,0:12:06.39,Default,,0,0,0,,Саламандр! Жүр, мен сені өлтіремін!
Dialogue: 0,0:12:06.85,0:12:08.35,Default,,0,0,0,,Жарайды, келіңдер!
Dialogue: 0,0:12:09.27,0:12:11.23,Default,,0,0,0,,Өсу...
Dialogue: 0,0:12:11.31,0:12:13.06,Default,,0,0,0,,Кешіріңіз, Бас тарту
Dialogue: 0,0:12:13.14,0:12:13.98,Default,,0,0,0,,Мұнда және мұнда
Dialogue: 0,0:12:14.06,0:12:15.77,Default,,0,0,0,,Ол жігіттер өзгермейді.
Dialogue: 0,0:12:15.86,0:12:17.02,Default,,0,0,0,,Жоқ-қ-қ-қ-қ…
Dialogue: 0,0:12:17.11,0:12:19.02,Default,,0,0,0,,Бақытты Чарльз
Dialogue: 0,0:12:19.11,0:12:20.65,Default,,0,0,0,,Тукаға не болды?
Dialogue: 0,0:12:20.74,0:12:22.95,Default,,0,0,0,,Мен Эрентияда қалдым.
Dialogue: 0,0:12:23.03,0:12:25.07,Default,,0,0,0,,Бұл ұят.
Dialogue: 0,0:12:25.16,0:12:26.12,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:12:26.20,0:12:31.08,Default,,0,0,0,,Мен ол Лаксустың серіктесі болуы мүмкін деп үміттендім, өйткені оның Exceed бағдарламасы жоқ.
Dialogue: 0,0:12:31.16,0:12:33.21,Default,,0,0,0,,Маған мысық керек емес
Dialogue: 0,0:12:33.29,0:12:34.62,Default,,0,0,0,,Лаксустың серіктесі —
Dialogue: 0,0:12:34.71,0:12:36.83,Default,,0,0,0,,Бізге жетеді
Dialogue: 0,0:12:36.92,0:12:39.04,Default,,0,0,0,,Бірдеңе болса, мен мысық боламын.
Dialogue: 0,0:12:39.13,0:12:41.13,Default,,0,0,0,,Freed Сізге жақсы көрінеді.
Dialogue: 0,0:12:41.21,0:12:43.22,Default,,0,0,0,,(Жан) Эй, Джотаро, сол Какёин жігіт туралы не ойлайсың?
Dialogue: 0,0:12:43.30,0:12:45.72,Default,,0,0,0,,Ойланып қарасам, сен де Эдоласке бардың ғой, солай ма?
Dialogue: 0,0:12:46.18,0:12:48.85,Default,,0,0,0,,Эдоласта барлығы қалай болды?
Dialogue: 0,0:12:48.93,0:12:51.47,Default,,0,0,0,,Мен олардың барлығын кездестірмедім, бірақ...
Dialogue: 0,0:12:51.56,0:12:53.18,Default,,0,0,0,,Ол жақсы көрінді.
Dialogue: 0,0:12:53.35,0:12:55.35,Default,,0,0,0,,Сиқырлы күш болмаса,
Dialogue: 0,0:12:55.44,0:12:57.86,Default,,0,0,0,,Әр адам өз өмірін өз ақыл-ойына шоғырландыру арқылы өткізетін сияқты.
Dialogue: 0,0:12:57.94,0:13:00.77,Default,,0,0,0,,Ханзада... Мыстоған ше?
Dialogue: 0,0:13:00.86,0:13:03.24,Default,,0,0,0,,Ол жақсы патша болар еді.
Dialogue: 0,0:13:03.78,0:13:07.32,Default,,0,0,0,,Оның орнына мені тыңда! Сол Эльза...
Dialogue: 0,0:13:07.41,0:13:09.66,Default,,0,0,0,,Ертегі аңшысы Эльзаға не болды?
Dialogue: 0,0:13:09.74,0:13:12.62,Default,,0,0,0,,Гуфуфу... Қызметшіге...
Dialogue: 0,0:13:12.70,0:13:15.37,Default,,0,0,0,,Мен сіздің әлі бұл қалада екеніңізді білмедім.
Dialogue: 0,0:13:15.46,0:13:18.46,Default,,0,0,0,,Мен сенің аман екеніңді көрмейінше.
Dialogue: 0,0:13:18.54,0:13:20.79,Default,,0,0,0,,Мен сені тастап кете алмаймын
Dialogue: 0,0:13:20.88,0:13:22.13,Default,,0,0,0,,Және-
Dialogue: 0,0:13:22.21,0:13:25.51,Default,,0,0,0,,Біз қуып келе жатқан Ақ сиқыршы әбігері жойылды.
Dialogue: 0,0:13:25.59,0:13:28.68,Default,,0,0,0,,Бұған келсек, Фаристің айтуы бойынша...
Dialogue: 0,0:13:28.76,0:13:32.26,Default,,0,0,0,,Нағыз ақ сиқыршы тағы бір адам бар сияқты.
Dialogue: 0,0:13:32.72,0:13:34.39,Default,,0,0,0,,Ол жоғалып кеткен сияқты.
Dialogue: 0,0:13:34.48,0:13:35.89,Default,,0,0,0,,Маған бәрібір
Dialogue: 0,0:13:35.98,0:13:39.48,Default,,0,0,0,,Мен қуған адам Фарис деген кісі болатын.
Dialogue: 0,0:13:39.65,0:13:42.48,Default,,0,0,0,,Фарис те өзінің бастапқы әлеміне оралды.
Dialogue: 0,0:13:42.57,0:13:44.19,Default,,0,0,0,,Енді зұлымдық жоқ деп ойлаймын.
Dialogue: 0,0:13:44.28,0:13:45.74,Default,,0,0,0,,That's right.
Dialogue: 0,0:13:47.32,0:13:50.66,Default,,0,0,0,,Жерар, енді не істейсің?
Dialogue: 0,0:13:50.99,0:13:54.75,Default,,0,0,0,,Сиқыршылар әлемінің әлі де қараңғылық басқан көптеген бөліктері бар.
Dialogue: 0,0:13:54.83,0:13:56.08,Default,,0,0,0,,Мен...
Dialogue: 0,0:13:56.16,0:13:59.04,Default,,0,0,0,,Арқаңа мұнша көп жүк көтерудің қажеті жоқ.
Dialogue: 0,0:13:59.12,0:14:01.75,Default,,0,0,0,,Қанша кешірім жасалса да —
Dialogue: 0,0:14:02.17,0:14:03.92,Default,,0,0,0,,Мені кім кешірсе де...
Dialogue: 0,0:14:04.38,0:14:08.88,Default,,0,0,0,,Бұл дүниеде қараңғылық болғанша, мен күресуді жалғастырамын
Dialogue: 0,0:14:08.97,0:14:12.68,Default,,0,0,0,,Сіз өзіңізді жазалауды доғардыңыз ба?
Dialogue: 0,0:14:12.93,0:14:14.35,Default,,0,0,0,,Бұл жаза емес.
Dialogue: 0,0:14:15.52,0:14:17.31,Default,,0,0,0,,Бұл өмір салты
Dialogue: 0,0:14:17.85,0:14:19.27,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:14:20.40,0:14:21.73,Default,,0,0,0,,Сәлем Джерард
Dialogue: 0,0:14:21.81,0:14:26.74,Default,,0,0,0,,Менсіз осылай өмір сүре аласың ба?
Dialogue: 0,0:14:26.82,0:14:27.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:29.57,0:14:32.20,Default,,0,0,0,,Сіз Fairy Tail-ге қосылғыңыз келе ме?
Dialogue: 0,0:14:32.74,0:14:34.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:34.74,0:14:36.58,Default,,0,0,0,,Әрине Мереди де.
Dialogue: 0,0:14:36.66,0:14:39.62,Default,,0,0,0,,Жоқ, бірақ бұл...
Dialogue: 0,0:14:40.17,0:14:42.46,Default,,0,0,0,,Бірден жауап берудің қажеті жоқ
Dialogue: 0,0:14:42.92,0:14:44.59,Default,,0,0,0,,Сіз бұл туралы ойланыңыз ба?
Dialogue: 0,0:14:45.17,0:14:48.55,Default,,0,0,0,,Аа... Ойланып көрейін.
Dialogue: 0,0:14:51.72,0:14:54.64,Default,,0,0,0,,Бұл Ай құдайы Айдаһар Селена ма?
Dialogue: 0,0:14:54.72,0:14:56.77,Default,,0,0,0,,Әдемі...
Dialogue: 0,0:14:56.85,0:15:00.52,Default,,0,0,0,,Сіз Құдайдың бес айдаһарының бірін шынымен жеңдіңіз бе?
Dialogue: 0,0:15:00.60,0:15:02.73,Default,,0,0,0,,Ал... Күткендей!
Dialogue: 0,0:15:02.81,0:15:04.82,Default,,0,0,0,,Дұрыс, Созаку!
Dialogue: 0,0:15:04.90,0:15:06.48,Default,,0,0,0,,Қаһарлы жау
Dialogue: 0,0:15:06.57,0:15:09.74,Default,,0,0,0,,Өйткені мен ешқашан мұндай адаммен араласпадым...
Dialogue: 0,0:15:09.82,0:15:11.70,Default,,0,0,0,,Менің денем осындай...
Dialogue: 0,0:15:11.78,0:15:17.12,Default,,0,0,0,,Егер мен осы нәрсені жесем, өлшемдерден асатын күш менікі болады...
Dialogue: 0,0:15:17.20,0:15:19.58,Default,,0,0,0,,-Ngh! - Күте тұрыңыз
Dialogue: 0,0:15:19.66,0:15:23.21,Default,,0,0,0,,Сіз қалай ойлайсыз? Мен өзімді адам ұстап алғандай сезінемін
Dialogue: 0,0:15:23.29,0:15:25.09,Default,,0,0,0,,Гахахаха!
Dialogue: 0,0:15:25.17,0:15:27.88,Default,,0,0,0,,Курунугиді өлтірген сен бе?
Dialogue: 0,0:15:27.96,0:15:30.51,Default,,0,0,0,,О? Бұл не? Бұл дұрыс
Dialogue: 0,0:15:30.59,0:15:31.80,Default,,0,0,0,,Бекіту
Dialogue: 0,0:15:31.88,0:15:36.64,Default,,0,0,0,,Өйткені Георг Курнугиді өлтірді, мен оның еті мен қанын алдым.
Dialogue: 0,0:15:37.56,0:15:40.48,Default,,0,0,0,,Сіз Курунуги Селенаның ұлы дедіңіз.
Dialogue: 0,0:15:40.56,0:15:43.10,Default,,0,0,0,,Гахахаха! Бұл жақсы
Dialogue: 0,0:15:43.19,0:15:46.57,Default,,0,0,0,,Баладан кейін ата-анасын жеймін.
Dialogue: 0,0:15:47.40,0:15:49.57,Default,,0,0,0,,Мұндай көріністі жеме!
Dialogue: 0,0:15:49.65,0:15:52.32,Default,,0,0,0,,Құбыжық пішініңізге тез оралыңыз!
Dialogue: 0,0:15:52.91,0:15:56.37,Default,,0,0,0,,Мен саған адамдардың қандай қорқынышты екенін көрсетемін!
Dialogue: 0,0:15:57.53,0:15:58.66,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:15:58.74,0:16:01.71,Default,,0,0,0,,Ұстаз! Арандатуды доғарыңыз!
Dialogue: 0,0:16:01.79,0:16:05.46,Default,,0,0,0,,Уайымдама, ол Созакудан жеңілді!
Dialogue: 0,0:16:05.54,0:16:07.96,Default,,0,0,0,,Мен Георг-саманы жеңе алмаймын.
Dialogue: 0,0:16:08.05,0:16:09.34,Default,,0,0,0,,Бекіту
Dialogue: 0,0:16:09.42,0:16:12.17,Default,,0,0,0,,Георгтың күші менікінен әлдеқайда жоғары.
Dialogue: 0,0:16:12.68,0:16:15.64,Default,,0,0,0,,Сенің жеңуге мүмкіндігің жоқ, Селена.
Dialogue: 0,0:16:15.72,0:16:20.60,Default,,0,0,0,,Керемет! Мен де біраз уақыттан кейін алғаш рет жабайы болғым келді.
Dialogue: 0,0:16:20.68,0:16:24.02,Default,,0,0,0,,Мен саған төрт аң айдаһарының айдаһар өлтіруші сиқырын көрсетемін...
Dialogue: 0,0:16:24.10,0:16:25.48,Default,,0,0,0,,(ұсақтау дыбысы)
Dialogue: 0,0:16:25.56,0:16:26.94,Default,,0,0,0,,Ах…
Dialogue: 0,0:16:27.02,0:16:28.52,Default,,0,0,0,,Ол кішкентайынан бері All Might-ты еліктеп,
Dialogue: 0,0:16:28.61,0:16:30.40,Default,,0,0,0,,Не болды!?
Dialogue: 0,0:16:30.48,0:16:32.28,Default,,0,0,0,,Мен көре алмадым...
Dialogue: 0,0:16:32.36,0:16:34.99,Default,,0,0,0,,Ол кедей бала еді, бірақ...
Dialogue: 0,0:16:35.07,0:16:38.16,Default,,0,0,0,,Ол мен жақсы көретін адамдардың бірі болды
Dialogue: 0,0:16:38.24,0:16:40.49,Default,,0,0,0,,Жау Курунуги жеңді
Dialogue: 0,0:16:40.58,0:16:42.04,Default,,0,0,0,,Күмән...
Dialogue: 0,0:16:42.12,0:16:45.46,Default,,0,0,0,,Жоқ, мен Георгпен кездесу үшін әдейі жеңіліп қалдым...
Dialogue: 0,0:16:45.54,0:16:49.96,Default,,0,0,0,,Бағыт берудегі қажырлы еңбегіңіз үшін рахмет, Созаку.
Dialogue: 0,0:16:50.05,0:16:51.42,Default,,0,0,0,,Шағым…
Dialogue: 0,0:16:51.51,0:16:54.34,Default,,0,0,0,,Менімен төбелес Сен байыпты емес пе едің?
Dialogue: 0,0:16:54.88,0:16:58.35,Default,,0,0,0,,Жоқ, мен белгілі бір дәрежеде байсалды болдым.
Dialogue: 0,0:16:58.43,0:17:02.81,Default,,0,0,0,,Мен сізге адам кейпінде сәйкес емеспін, мойындаймын.
Dialogue: 0,0:17:02.89,0:17:06.73,Default,,0,0,0,,Сонымен қатар, сізді менің баламның бір бөлігі деп санауға болады.
Dialogue: 0,0:17:07.48,0:17:12.36,Default,,0,0,0,,Сіз адамдар айдаһарларды жеңе алады деп ойладыңыз ба?
Dialogue: 0,0:17:12.44,0:17:14.32,Default,,0,0,0,,Ахахха!
Dialogue: 0,0:17:14.40,0:17:17.32,Default,,0,0,0,,Ұстаздың жауы мұнда және қазір...
Dialogue: 0,0:17:17.41,0:17:18.78,Default,,0,0,0,,Йосе
Dialogue: 0,0:17:18.87,0:17:24.12,Default,,0,0,0,,Сіздің калибріңізден біреу менің күш-қуатымды осы пішінде көре алады.
Dialogue: 0,0:17:24.20,0:17:29.25,Default,,0,0,0,,Сонымен қатар, жоғарыда айтқанымдай, мен сенің құдіретіңді мойындаймын.
Dialogue: 0,0:17:29.79,0:17:31.59,Default,,0,0,0,,Өлтіру өте жаман
Dialogue: 0,0:17:31.67,0:17:35.88,Default,,0,0,0,,Осы гильдияда Сузаку сияқты басқа адамдар бар ма?
Dialogue: 0,0:17:35.97,0:17:38.26,Default,,0,0,0,,А... шамамен үш адам...
Dialogue: 0,0:17:38.34,0:17:41.31,Default,,0,0,0,,Үш адам да... Хахахаха!
Dialogue: 0,0:17:41.39,0:17:46.77,Default,,0,0,0,,Айдаһардың қаны мен етін жеген адам шынымен қорқынышты.
Dialogue: 0,0:17:46.85,0:17:52.23,Default,,0,0,0,,Жарайды... Мен бұл гильдияның жаңа шебері боламын.
Dialogue: 0,0:17:54.03,0:17:55.44,Default,,0,0,0,,Терістеу
Dialogue: 0,0:17:55.53,0:17:57.91,Default,,0,0,0,,Сіз менің гильдиямды мазақ еткіңіз келе ме?
Dialogue: 0,0:17:58.41,0:18:00.62,Default,,0,0,0,,А... тізерлеп отырыңыз.
Dialogue: 0,0:18:00.70,0:18:01.87,Default,,0,0,0,,Адамдар!
Dialogue: 0,0:18:01.95,0:18:03.62,Default,,0,0,0,,Уууу…
Dialogue: 0,0:18:03.70,0:18:05.25,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:18:05.33,0:18:08.08,Default,,0,0,0,,Бұл қалжың емес, Селена.
Dialogue: 0,0:18:08.75,0:18:10.83,Default,,0,0,0,,Біздің гильдия
Dialogue: 0,0:18:10.92,0:18:14.00,Default,,0,0,0,,Бұл айдаһарды аулауға маманданған гильдия!
Dialogue: 0,0:18:14.09,0:18:15.59,Default,,0,0,0,,Кел, Кирия!
Dialogue: 0,0:18:17.13,0:18:18.26,Default,,0,0,0,,Не! ?
Dialogue: 0,0:18:18.34,0:18:20.05,Default,,0,0,0,,Гильдиядағы Ай?
Dialogue: 0,0:18:22.14,0:18:23.56,Default,,0,0,0,,Кирия!
Dialogue: 0,0:18:24.14,0:18:25.52,Default,,0,0,0,,Ол жоғалып кетті...
Dialogue: 0,0:18:25.60,0:18:26.73,Default,,0,0,0,,Ендеше, мен де саған сенемін
Dialogue: 0,0:18:26.81,0:18:31.15,Default,,0,0,0,,Мен сені өлтірген жоқпын, мен сені басқа өлшемге жібердім.
Dialogue: 0,0:18:31.81,0:18:36.11,Default,,0,0,0,,Мен де ондай жүйрік қызды жек көрмеймін.
Dialogue: 0,0:18:36.19,0:18:38.11,Default,,0,0,0,,Кирияны қайтарыңыз!
Dialogue: 0,0:18:38.20,0:18:40.57,Default,,0,0,0,,Бұл сіздің жауабыңызға байланысты.
Dialogue: 0,0:18:41.11,0:18:45.04,Default,,0,0,0,,Мені осы гильдияның шебері ретінде қабылдаңыз.
Dialogue: 0,0:18:45.12,0:18:46.50,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:18:46.95,0:18:49.71,Default,,0,0,0,,Бұл жаман оқиға емес екеніне сенімдімін.
Dialogue: 0,0:18:49.79,0:18:54.17,Default,,0,0,0,,Менде сіз іздеген айдаһар туралы мәлімет бар.
Dialogue: 0,0:18:54.50,0:18:57.97,Default,,0,0,0,,Мен сізге көмектесуге тырысамын.
Dialogue: 0,0:18:58.05,0:18:59.30,Default,,0,0,0,,Не?
Dialogue: 0,0:18:59.38,0:19:01.93,Default,,0,0,0,,Сіздің мақсатыңыз қандай? ?
Dialogue: 0,0:19:02.01,0:19:03.72,Default,,0,0,0,,Бұрмалау
Dialogue: 0,0:19:03.80,0:19:05.18,Default,,0,0,0,,Бұрмалау?
Dialogue: 0,0:19:05.26,0:19:08.43,Default,,0,0,0,,Бұрмалау қуатты тудырады
Dialogue: 0,0:19:08.52,0:19:13.52,Default,,0,0,0,,Айдаһар жегіш пен айдаһар көбірек айдаһарларды жеңу үшін күш біріктіреді.
Dialogue: 0,0:19:13.61,0:19:17.40,Default,,0,0,0,,Сол бұрмалау дүниенің күшіне айналады
Dialogue: 0,0:19:17.48,0:19:21.03,Default,,0,0,0,,Сіздің мақсатыңыз да айдаһарды жеңу ме?
Dialogue: 0,0:19:21.11,0:19:25.49,Default,,0,0,0,,Бұл дүниеде тітіркендіргіш төрт айдаһар бар.
Dialogue: 0,0:19:25.66,0:19:30.25,Default,,0,0,0,,Ағаш айдаһар Олдрон Бұл жігіт өткен күні қайтыс болды.
Dialogue: 0,0:19:30.33,0:19:33.13,Default,,0,0,0,,Су құдайы Айдаһар Мелкфобия
Dialogue: 0,0:19:33.21,0:19:36.88,Default,,0,0,0,,Құдіретінен айырылып, адам болды.
Dialogue: 0,0:19:36.96,0:19:38.71,Default,,0,0,0,,Кейінге қалдыруға болады
Dialogue: 0,0:19:38.80,0:19:42.47,Default,,0,0,0,,Мәселе - Алтын Айдаһар Виернес
Dialogue: 0,0:19:43.14,0:19:45.05,Default,,0,0,0,,Жалын айдаһар Игня
Dialogue: 0,0:19:45.80,0:19:51.19,Default,,0,0,0,,Осы екеуін өлтірмейінше менің әлемім толық болмайды.
Dialogue: 0,0:19:51.27,0:19:54.61,Default,,0,0,0,,Басқаша айтқанда, айдаһарсыз әлем
Dialogue: 0,0:19:54.90,0:19:57.15,Default,,0,0,0,,Бұл тек адамдарға арналған дүние.
Dialogue: 0,0:19:57.57,0:19:59.82,Default,,0,0,0,,Сізде қандай артықшылық бар?
Dialogue: 0,0:20:00.11,0:20:03.61,Default,,0,0,0,,Мен бұл дүниеде адам болып өмір сүремін
Dialogue: 0,0:20:03.70,0:20:07.37,Default,,0,0,0,,Ең күшті күш иесі ретінде
Dialogue: 0,0:20:07.45,0:20:09.79,Default,,0,0,0,,Адам болғың келе ме?
Dialogue: 0,0:20:09.87,0:20:12.25,Default,,0,0,0,,Мен болғым келмейді
Dialogue: 0,0:20:12.66,0:20:15.83,Default,,0,0,0,,Бұл тек осы заманның болжамы.
Dialogue: 0,0:20:16.38,0:20:20.01,Default,,0,0,0,,Айдаһарлар дәуірі 400 жыл бұрын аяқталды.
Dialogue: 0,0:20:20.09,0:20:25.39,Default,,0,0,0,,Акнология және бес құдайлық айдаһар соңы 400 жылға кешіктірілді.
Dialogue: 0,0:20:25.47,0:20:29.81,Default,,0,0,0,,Енді айдаһарлар дәуірін шынымен аяқтайтын уақыт.
Dialogue: 0,0:20:30.27,0:20:32.27,Default,,0,0,0,,400 жыл…
Dialogue: 0,0:20:32.35,0:20:36.69,Default,,0,0,0,,Дүниені бұрмалай отырып, бесеуміз бір-бірімізді бақылауда ұстадық.
Dialogue: 0,0:20:37.19,0:20:39.48,Default,,0,0,0,,Күштер теңестірілгендіктен—
Dialogue: 0,0:20:39.57,0:20:44.20,Default,,0,0,0,,Егер олар соқтығысса, ең нашар жағдайда екеуі де жойылады.
Dialogue: 0,0:20:44.28,0:20:48.37,Default,,0,0,0,,Оның үстіне біреу балықшыларды пайдаланып қалуға тырысуы мүмкін.
Dialogue: 0,0:20:48.45,0:20:50.54,Default,,0,0,0,,Жағдай осылай болды.
Dialogue: 0,0:20:50.62,0:20:54.75,Default,,0,0,0,,Бірақ мен ақыры түсіндім
Dialogue: 0,0:20:54.83,0:20:58.00,Default,,0,0,0,,Бұл шайқаста жеңіске жетудің кілті...
Dialogue: 0,0:20:58.59,0:21:00.63,Default,,0,0,0,,Бұл адам
Dialogue: 0,0:21:01.13,0:21:05.72,Default,,0,0,0,,Өз күшіңізбен Виернес пен Игнияны жеңе аласыз.
Dialogue: 0,0:21:06.13,0:21:09.60,Default,,0,0,0,,Олар адам күшіне сенбейді.
Dialogue: 0,0:21:09.81,0:21:11.93,Default,,0,0,0,,Бірақ мен олай емеспін
Dialogue: 0,0:21:12.02,0:21:15.94,Default,,0,0,0,,Созақудың құдіретіне куә болған соң көзім жетті.
Dialogue: 0,0:21:16.60,0:21:20.90,Default,,0,0,0,,Сен екеуміз бірге жұмыс жасасақ, әлемді өзгерте аламыз.
Dialogue: 0,0:21:20.98,0:21:21.98,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:22.07,0:21:23.11,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:21:23.19,0:21:26.11,Default,,0,0,0,,Өйткені сен қожайынның жауысың
Dialogue: 0,0:21:26.20,0:21:29.95,Default,,0,0,0,,Олай десеңіз, баламның жауы.
Dialogue: 0,0:21:30.62,0:21:34.50,Default,,0,0,0,,Менің табаным таптаған адамға —
Dialogue: 0,0:21:34.58,0:21:36.50,Default,,0,0,0,,Қандай өкінішіңіз бар?
Dialogue: 0,0:21:36.58,0:21:39.92,Default,,0,0,0,,Мен сіздің дәрежеңіздегі адамдарды біріктіретін кеме емеспін.
Dialogue: 0,0:21:41.88,0:21:42.92,Default,,0,0,0,,Кирия!
Dialogue: 0,0:21:43.38,0:21:46.38,Default,,0,0,0,,Вирнес пен Игнияны жеңгеннен кейін
Dialogue: 0,0:21:46.47,0:21:51.35,Default,,0,0,0,,Әлі де сол адамның жауынан кек алғыңыз келсе, онымен қалағаныңызша соғыса аласыз.
Dialogue: 0,0:21:51.43,0:21:55.06,Default,,0,0,0,,Оған дейін біз доспыз.
Dialogue: 0,0:21:55.48,0:21:56.94,Default,,0,0,0,,Мақтан тұт
Dialogue: 0,0:21:57.02,0:22:00.31,Default,,0,0,0,,Артыңызда айдаһар тұрғанда өзін жоғары сезіну
Dialogue: 0,0:22:00.40,0:22:01.36,Default,,0,0,0,,Ха!
Dialogue: 0,0:22:01.44,0:22:03.23,Default,,0,0,0,,Мен... түсіндім.
Dialogue: 0,0:22:03.69,0:22:05.94,Default,,0,0,0,,Енді менде бағынудан басқа амал жоқ...
Dialogue: 0,0:22:06.45,0:22:08.03,Default,,0,0,0,,Мен түсіндім...
Dialogue: 0,0:22:08.53,0:22:09.49,Default,,0,0,0,,Фу…
Dialogue: 0,0:22:09.57,0:22:13.87,Default,,0,0,0,,Алдымен Созакумен бірдей дәрежедегі адамдарды жинаңыз.
Dialogue: 0,0:22:13.95,0:22:15.54,Default,,0,0,0,,Қара айдаһар рыцарлары?
Dialogue: 0,0:22:15.62,0:22:18.92,Default,,0,0,0,,Бастау үшін Элефтерияны өлтіріңіз
Dialogue: 0,0:22:19.46,0:22:21.08,Default,,0,0,0,,Элефтерия?
Dialogue: 0,0:22:21.17,0:22:23.88,Default,,0,0,0,,Айдаһарға айналған адам
Dialogue: 0,0:22:24.46,0:22:26.92,Default,,0,0,0,,Акнологияға жақын болмыс.
Dialogue: 0,0:22:27.51,0:22:31.85,Default,,0,0,0,,Шынымды айтсам, мен оны өзім өлтіре аламын.
Dialogue: 0,0:22:31.93,0:22:34.39,Default,,0,0,0,,Мен сенің күшіңді көргім келеді.
Dialogue: 0,0:22:35.22,0:22:36.43,Default,,0,0,0,,Хмм...
Dialogue: 0,0:22:37.60,0:22:39.52,Default,,0,0,0,,Сіз кетіп қалдыңыз ба?
Dialogue: 0,0:22:39.60,0:22:43.36,Default,,0,0,0,,Мұнда гильдияны көруге болады.
Dialogue: 0,0:22:43.44,0:22:45.73,Default,,0,0,0,,Егер сіз тым ұзақ тұрсаңыз, сіз қоштасқаныңызға өкінесіз
Dialogue: 0,0:22:45.82,0:22:46.74,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:22:46.82,0:22:49.57,Default,,0,0,0,,Бұл жолақ үйдей сезінеді
Dialogue: 0,0:22:49.65,0:22:52.37,Default,,0,0,0,,If we do some more sightseeing...
Dialogue: 0,0:22:52.45,0:22:54.20,Default,,0,0,0,,Магнолияға қайтуым керек.
Dialogue: 0,0:22:54.62,0:22:58.12,Default,,0,0,0,,Мистер Грей, өтінемін, кетпеңіз!
Dialogue: 0,0:22:58.21,0:23:01.96,Default,,0,0,0,,Бұған көмектесу мүмкін емес, бұл маңызды жұмыс.
Dialogue: 0,0:23:02.04,0:23:04.42,Default,,0,0,0,,Ювия, мен саған жасырын түрде еремін!
Dialogue: 0,0:23:04.50,0:23:05.71,Default,,0,0,0,,Егер сіз мұны мәлімдесеңіз -
Dialogue: 0,0:23:05.80,0:23:07.46,Default,,0,0,0,,Сіз енді жасырын бола алмайсыз.
Dialogue: 0,0:23:07.55,0:23:09.97,Default,,0,0,0,,Souvenir story I'm looking forward to it.
Dialogue: 0,0:23:10.05,0:23:11.09,Default,,0,0,0,,Әй!
Dialogue: 0,0:23:11.18,0:23:12.22,Default,,0,0,0,,Венди
Dialogue: 0,0:23:12.30,0:23:14.51,Default,,0,0,0,,Мен көрмеген уақытта ол үлкейіп кетті.
Dialogue: 0,0:23:14.60,0:23:16.85,Default,,0,0,0,,Хань патшалығының өсу кезеңі қандай?
Dialogue: 0,0:23:16.93,0:23:18.93,Default,,0,0,0,,Жоқ, ол өзгерген жоқ.
Dialogue: 0,0:23:19.02,0:23:22.06,Default,,0,0,0,,Аа, бірақ аз ғана уақытқа...
Dialogue: 0,0:23:22.15,0:23:24.56,Default,,0,0,0,,Жүр, кеттік, Венди.
Dialogue: 0,0:23:24.65,0:23:27.53,Default,,0,0,0,,Сондықтан бәрі, тағы да кездескенше!
Dialogue: 0,0:23:28.36,0:23:30.49,Default,,0,0,0,,Келесі жолы гильдияда кездескенше!
Dialogue: 0,0:23:30.57,0:23:32.32,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:23:32.41,0:23:33.45,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:23:33.53,0:23:35.66,Default,,0,0,0,,...және кетті...
Dialogue: 0,0:23:35.74,0:23:37.95,Default,,0,0,0,,Селена да жоқ
Dialogue: 0,0:23:38.04,0:23:41.25,Default,,0,0,0,,Басқа айдаһарлардың орны белгісіз.
Dialogue: 0,0:23:41.42,0:23:43.25,Default,,0,0,0,,Сонымен, біз—
Dialogue: 0,0:23:43.33,0:23:45.96,Default,,0,0,0,,Мен Элефтерияға оралуды шештім.
Dialogue: 0,0:23:46.04,0:23:50.01,Default,,0,0,0,,Алдыңғы есептер және анықтамалар алу
Dialogue: 0,0:23:51.51,0:23:57.51,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory