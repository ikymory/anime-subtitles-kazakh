Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.63,0:00:09.30,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:00:10.46,0:00:14.80,Default,,0,0,0,,Иә? Вэнди, не болды? Осындай жерде
Dialogue: 0,0:00:15.26,0:00:16.80,Default,,0,0,0,,Чарльз~!
Dialogue: 0,0:00:16.89,0:00:19.64,Default,,0,0,0,,Не? Сіз ақырзаманға ұқсайсыз ...
Dialogue: 0,0:00:20.10,0:00:22.18,Default,,0,0,0,,Бөлмеде жәндіктер бар...
Dialogue: 0,0:00:22.27,0:00:24.94,Default,,0,0,0,,Не? Сіз асыра айтып жатырсыз, бұл жай ғана қате.
Dialogue: 0,0:00:25.02,0:00:27.02,Default,,0,0,0,,Өйткені, өйткені!
Dialogue: 0,0:00:27.11,0:00:30.82,Default,,0,0,0,,...Бұл өте аянышты, түсіндім.
Dialogue: 0,0:00:30.90,0:00:32.78,Default,,0,0,0,,Мен сені ұстаймын!
Dialogue: 0,0:00:32.86,0:00:35.57,Default,,0,0,0,,Ах... Чарльз, рахмет!
Dialogue: 0,0:00:35.66,0:00:37.53,Default,,0,0,0,,Мынадай нәрсе...
Dialogue: 0,0:00:38.83,0:00:40.08,Default,,0,0,0,,Кішкене...
Dialogue: 0,0:00:40.87,0:00:42.33,Default,,0,0,0,,Бір сәт...
Dialogue: 0,0:00:42.41,0:00:44.37,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,0:00:44.46,0:00:46.62,Default,,0,0,0,,Сәлем! Бұл не жігіт?
Dialogue: 0,0:00:46.71,0:00:48.84,Default,,0,0,0,,Жылдамдық керемет!
Dialogue: 0,0:00:48.92,0:00:52.21,Default,,0,0,0,,Сондай-ақ, ол мені мазақ еткендей қозғалады! Мен қатты ашуландым!
Dialogue: 0,0:00:52.30,0:00:53.92,Default,,0,0,0,,Чарльз асығыңыз!
Dialogue: 0,0:00:54.01,0:00:56.43,Default,,0,0,0,,Венди! Маған нониус қойыңыз!
Dialogue: 0,0:00:57.22,0:01:00.35,Default,,0,0,0,,Жоқ... Мен мүлде ұсталмаймын.
Dialogue: 0,0:01:00.85,0:01:02.89,Default,,0,0,0,,Сізге әйтеуір қиналып жатқан сияқтысыз.
Dialogue: 0,0:01:03.68,0:01:05.44,Default,,0,0,0,,Е... Эльза-сан!
Dialogue: 0,0:01:05.52,0:01:07.52,Default,,0,0,0,,Жалпы әңгімені түсіндім.
Dialogue: 0,0:01:07.60,0:01:08.86,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,0:01:09.44,0:01:10.32,Default,,0,0,0,,Маған үш дана беріңіз.
Dialogue: 0,0:01:11.07,0:01:15.28,Default,,0,0,0,,Мен сені күшейе түсті деп ойладым, бірақ сен әлі баласың, Венди.
Dialogue: 0,0:01:15.36,0:01:16.49,Default,,0,0,0,,(тықылдаған дыбыс)
Dialogue: 0,0:01:17.36,0:01:18.45,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,0:01:18.53,0:01:19.66,Default,,0,0,0,,Хаа!
Dialogue: 0,0:01:19.74,0:01:20.87,Default,,0,0,0,,Хмф!
Dialogue: 0,0:01:22.91,0:01:24.45,Default,,0,0,0,,Хо…
Dialogue: 0,0:01:24.54,0:01:26.62,Default,,0,0,0,,А... а... Эльза?
Dialogue: 0,0:01:26.71,0:01:27.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:31.34,0:01:34.55,Default,,0,0,0,,Жетесің, мына жәндіктер!
Dialogue: 0,0:01:34.63,0:01:35.97,Default,,0,0,0,,Тоқта, Эльза!
Dialogue: 0,0:01:36.05,0:01:38.22,Default,,0,0,0,,Уау! Бөлме...
Dialogue: 0,0:01:38.30,0:01:40.93,Default,,0,0,0,,Жатақхана ~!
Dialogue: 0,0:01:41.39,0:01:46.89,Default,,0,0,0,,♪~
Dialogue: 0,0:03:05.39,0:03:10.56,Default,,0,0,0,,~♪
Dialogue: 0,0:03:10.98,0:03:12.15,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:03:12.23,0:03:13.27,Default,,0,0,0,,Бұл өте үлкен!
Dialogue: 0,0:03:13.35,0:03:16.40,Default,,0,0,0,,Бұл сезім шар сынған кездегідей!
Dialogue: 0,0:03:16.48,0:03:19.61,Default,,0,0,0,,Асығыңыз! Ақ сиқыршыға барыңыз!
Dialogue: 0,0:03:20.11,0:03:22.66,Default,,0,0,0,,Мұнда соңғы бір шар бар.
Dialogue: 0,0:03:22.74,0:03:23.57,Default,,0,0,0,,Ха…
Dialogue: 0,0:03:24.03,0:03:25.53,Default,,0,0,0,,Оны қазір жойыңыз!
Dialogue: 0,0:03:26.16,0:03:30.00,Default,,0,0,0,,Мен Ағаш Айдаһар Олдронның барлық күшін өшіремін!
Dialogue: 0,0:03:30.08,0:03:32.21,Default,,0,0,0,,Бұл шар сынған кезде
Dialogue: 0,0:03:32.29,0:03:35.17,Default,,0,0,0,,Олдрон бес қаламен бірге жойылады.
Dialogue: 0,0:03:35.25,0:03:40.01,Default,,0,0,0,,Күшті сиқырлы күшке арналған балға! Әлемге ақ бейбітшілік уақыты!
Dialogue: 0,0:03:40.09,0:03:41.38,Default,,0,0,0,,Цезарь жастығын да, болашағын да босқа өткізді
Dialogue: 0,0:03:44.39,0:03:47.26,Default,,0,0,0,,Жүр, құрып кет, Ағаш айдаһар Олдрон!
Dialogue: 0,0:03:47.35,0:03:50.56,Default,,0,0,0,,Ал маған күшіңді бер!
Dialogue: 0,0:03:59.03,0:04:01.90,Default,,0,0,0,,(жығылған дыбыс)
Dialogue: 0,0:04:16.79,0:04:19.67,Default,,0,0,0,,-Анау...қала... -Аа...
Dialogue: 0,0:04:20.13,0:04:21.59,Default,,0,0,0,,Бұл өтірік болар еді...
Dialogue: 0,0:04:24.18,0:04:26.55,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:04:26.64,0:04:28.39,Default,,0,0,0,,Барлық қаладағы адамдар...
Dialogue: 0,0:04:28.47,0:04:31.35,Default,,0,0,0,,Уайымдайтын ештеңе жоқ.
Dialogue: 0,0:04:31.43,0:04:32.68,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:04:32.77,0:04:34.10,Default,,0,0,0,,Біз—
Dialogue: 0,0:04:34.19,0:04:37.02,Default,,0,0,0,,Мен бұл күнді күттім
Dialogue: 0,0:04:37.11,0:04:38.48,Default,,0,0,0,,Не! ?
Dialogue: 0,0:04:38.56,0:04:41.86,Default,,0,0,0,,Біз лорд Олдронның бір бөлігіміз.
Dialogue: 0,0:04:44.07,0:04:47.78,Default,,0,0,0,,Бастапқыда мен сенен басқа адаммын.
Dialogue: 0,0:04:47.87,0:04:50.24,Default,,0,0,0,,(Жан) Не…
Dialogue: 0,0:04:50.33,0:04:51.45,Default,,0,0,0,,Мистер Олдрон
Dialogue: 0,0:04:51.54,0:04:56.12,Default,,0,0,0,,Көптеген ұзақ жылдардан кейін мен денемді демалуға мүмкіндік бердім.
Dialogue: 0,0:04:56.75,0:05:00.04,Default,,0,0,0,,Бес шарды денеңізбен байланыстырыңыз—
Dialogue: 0,0:05:00.13,0:05:02.42,Default,,0,0,0,,Мен қозғалмауға батылым бардым.
Dialogue: 0,0:05:02.51,0:05:03.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:03.67,0:05:08.76,Default,,0,0,0,,Ал біз «түрлер» осы елде туып, осы өлкеде өлдік.
Dialogue: 0,0:05:08.85,0:05:11.26,Default,,0,0,0,,Лорд Олдронның бір бөлігі болу
Dialogue: 0,0:05:11.35,0:05:12.47,Default,,0,0,0,,Түрлер?
Dialogue: 0,0:05:12.56,0:05:13.68,Default,,0,0,0,,Иә
Dialogue: 0,0:05:13.77,0:05:18.48,Default,,0,0,0,,Біз Олдрон-саманың жарасын емдеу үшін нәрміз.
Dialogue: 0,0:05:18.56,0:05:21.52,Default,,0,0,0,,Сіз бұрын не айттыңыз?
Dialogue: 0,0:05:21.61,0:05:23.86,Default,,0,0,0,,Мен қайда және кім екенін білмеймін ...
Dialogue: 0,0:05:23.94,0:05:27.86,Default,,0,0,0,,Лорд Олдронды жеңу үшін бес шарды жойды.
Dialogue: 0,0:05:27.95,0:05:30.24,Default,,0,0,0,,Бұл қате.
Dialogue: 0,0:05:30.32,0:05:34.50,Default,,0,0,0,,Шар сынған кезде қаңқасы шығып кетті...
Dialogue: 0,0:05:34.58,0:05:37.29,Default,,0,0,0,,-Ха... -(Әйел) Қайта тіріледі!
Dialogue: 0,0:05:39.33,0:05:44.17,Default,,0,0,0,,Біздің патшамыз! Үлкен ағаштарға дұға етіңіз!
Dialogue: 0,0:05:44.26,0:05:45.17,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:45.84,0:05:46.88,Default,,0,0,0,,Қауіпті!
Dialogue: 0,0:05:47.51,0:05:48.84,Default,,0,0,0,,Уақытша эвакуация!
Dialogue: 0,0:05:48.93,0:05:51.14,Default,,0,0,0,,Бірақ басқа қалаларда барлығы...
Dialogue: 0,0:05:51.22,0:05:55.10,Default,,0,0,0,,Мен қазір барлығының қауіпсіздігі үшін дұға етуден басқа ештеңе істей алмаймын!
Dialogue: 0,0:05:55.89,0:05:59.06,Default,,0,0,0,,(Олдронның айқайы)
Dialogue: 0,0:06:05.94,0:06:08.11,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:06:10.91,0:06:14.08,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:06:14.16,0:06:16.54,Default,,0,0,0,,-Ааа! -(Люси) Менің құлағым!
Dialogue: 0,0:06:16.62,0:06:19.00,Default,,0,0,0,,- Шулы! -Эй!
Dialogue: 0,0:06:19.08,0:06:20.88,Default,,0,0,0,,Осындай кездерде Ювияның сиқырымен...
Dialogue: 0,0:06:20.96,0:06:23.71,Default,,0,0,0,,Грэй-саманың құлағын жауып алсам ғой!
Dialogue: 0,0:06:24.34,0:06:25.17,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:25.76,0:06:27.51,Default,,0,0,0,,Не? Дыбыс тынышталды!
Dialogue: 0,0:06:27.59,0:06:28.63,Default,,0,0,0,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:06:28.72,0:06:31.51,Default,,0,0,0,,Ювия! Мен енді сиқырды қолдана аламын! ?
Dialogue: 0,0:06:31.59,0:06:33.01,Default,,0,0,0,,Тек екеуміз…
Dialogue: 0,0:06:33.10,0:06:35.22,Default,,0,0,0,,Мен білмеймін, бірақ...
Dialogue: 0,0:06:35.31,0:06:37.43,Default,,0,0,0,,Сиқыр қайта оралды!
Dialogue: 0,0:06:37.52,0:06:39.10,Default,,0,0,0,,Бұл болуы мүмкін бе
Dialogue: 0,0:06:39.19,0:06:42.02,Default,,0,0,0,,Қалғандары да жойылудан қайтып келді! ?
Dialogue: 0,0:06:44.61,0:06:47.07,Default,,0,0,0,,Біз осындай жерде не істеп жатырмыз? ?
Dialogue: 0,0:06:47.15,0:06:48.19,Default,,0,0,0,,Мен білмеймін!
Dialogue: 0,0:06:48.28,0:06:49.86,Default,,0,0,0,,Бұл қай жерде?
Dialogue: 0,0:06:49.95,0:06:51.07,Default,,0,0,0,,Мен білмеймін!
Dialogue: 0,0:06:51.16,0:06:52.99,Default,,0,0,0,,Мен шынымен түсінбеймін, бірақ мен қашып бара жатырмын!
Dialogue: 0,0:06:53.07,0:06:55.41,Default,,0,0,0,,- Қалай? -Мен білмеймін!
Dialogue: 0,0:06:55.91,0:06:57.62,Default,,0,0,0,,Не болады? ?
Dialogue: 0,0:06:57.70,0:06:59.91,Default,,0,0,0,,Эльза, сен ауырып қалдың!
Dialogue: 0,0:07:00.00,0:07:01.75,Default,,0,0,0,,Сен кімсің...
Dialogue: 0,0:07:02.17,0:07:07.00,Default,,0,0,0,,Эльзаны бастан кешкен мына бейбақ кім?
Dialogue: 0,0:07:07.09,0:07:09.01,Default,,0,0,0,,(жығылған дыбыс)
Dialogue: 0,0:07:11.30,0:07:12.93,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:07:14.97,0:07:17.77,Default,,0,0,0,,Бұл ел бітті ғой, иә?
Dialogue: 0,0:07:17.85,0:07:20.14,Default,,0,0,0,,Олдрон қайта жанданды...
Dialogue: 0,0:07:20.23,0:07:22.90,Default,,0,0,0,,Ойласам, мен күлге ұқсас иісті сезбеппін
Dialogue: 0,0:07:22.98,0:07:24.48,Default,,0,0,0,,Егер сіз шарды жойсаңыз -
Dialogue: 0,0:07:24.56,0:07:28.61,Default,,0,0,0,,Егер Олдронның күшін өндіру мүмкін болса, ол адам...
Dialogue: 0,0:07:29.40,0:07:32.20,Default,,0,0,0,,Сен бізге не істедің? Сіз
Dialogue: 0,0:07:32.28,0:07:34.66,Default,,0,0,0,,Бұл қайда? не болып жатыр?
Dialogue: 0,0:07:34.74,0:07:37.12,Default,,0,0,0,,Ақтың жойылуы шешілді! ?
Dialogue: 0,0:07:37.20,0:07:40.12,Default,,0,0,0,,Неліктен? Не айтқың келеді! ?
Dialogue: 0,0:07:40.37,0:07:41.87,Default,,0,0,0,,Дұрыс, бұл сызық!
Dialogue: 0,0:07:41.96,0:07:44.33,Default,,0,0,0,,Ах... Ха...
Dialogue: 0,0:07:46.92,0:07:48.80,Default,,0,0,0,,Нацу! Венди!
Dialogue: 0,0:07:48.88,0:07:50.34,Default,,0,0,0,,Месут мырза!
Dialogue: 0,0:07:50.42,0:07:52.13,Default,,0,0,0,,Сені де айла-шарғы жасап жатыр ма, Мест?
Dialogue: 0,0:07:53.01,0:07:55.09,Default,,0,0,0,,Нацу! Шар сынған!
Dialogue: 0,0:07:55.18,0:07:58.06,Default,,0,0,0,,Манипуляцияланған ба? Амал жоқ...
Dialogue: 0,0:07:58.39,0:08:00.10,Default,,0,0,0,,Өз естеліктеріңізді «көріңіз»!
Dialogue: 0,0:08:01.27,0:08:02.56,Default,,0,0,0,,О, құдайым...
Dialogue: 0,0:08:03.02,0:08:05.40,Default,,0,0,0,,Мүмкін сізді манипуляциялап жатқан жоқсыз ба?
Dialogue: 0,0:08:05.48,0:08:10.28,Default,,0,0,0,,Жоқ... Дәлірек айтсақ, ол айла-шарғы жасап жатыр еді, бірақ заклинание бұзылған сияқты.
Dialogue: 0,0:08:10.78,0:08:14.03,Default,,0,0,0,,Қат! Мен жалпы жағдайды түсінемін
Dialogue: 0,0:08:14.11,0:08:16.62,Default,,0,0,0,,Бұл үлкен мәміле болады.
Dialogue: 0,0:08:16.70,0:08:19.37,Default,,0,0,0,,Сіз өз күшіңізді барлығын біріктіру үшін пайдалана аласыз ба?
Dialogue: 0,0:08:19.45,0:08:21.70,Default,,0,0,0,,Дұрыс, маған қалдырыңыз!
Dialogue: 0,0:08:21.79,0:08:24.21,Default,,0,0,0,,Нацу! Сақ болыңыз, бұл ...
Dialogue: 0,0:08:24.29,0:08:25.54,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:08:26.96,0:08:28.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:28.34,0:08:31.38,Default,,0,0,0,,Олдрон қозғала бастады, бірақ ол да нашар.
Dialogue: 0,0:08:31.46,0:08:32.76,Default,,0,0,0,,Ол сізден басталады.
Dialogue: 0,0:08:33.63,0:08:35.76,Default,,0,0,0,,Мен Тука-сан екеуіңді ажыратамын.
Dialogue: 0,0:08:35.84,0:08:39.06,Default,,0,0,0,,Қуат жоқ... Қуат жоқ...
Dialogue: 0,0:08:39.14,0:08:43.27,Default,,0,0,0,,Бәрі алданып қалды... анау жігіт...
Dialogue: 0,0:08:43.35,0:08:45.73,Default,,0,0,0,,Бұл әйел кінәлі!
Dialogue: 0,0:08:58.16,0:08:59.74,Default,,0,0,0,,Драшиел…
Dialogue: 0,0:08:59.83,0:09:01.99,Default,,0,0,0,,Айдаһарды мөр
Dialogue: 0,0:09:02.08,0:09:04.66,Default,,0,0,0,,, яғни мөрленген қала
Dialogue: 0,0:09:05.79,0:09:10.00,Default,,0,0,0,,Сіз оны Ақ сиқыршы қаланың атынан білуіңіз керек еді.
Dialogue: 0,0:09:11.84,0:09:14.59,Default,,0,0,0,,Сіздің рөліңіз осы жерде аяқталады.
Dialogue: 0,0:09:16.43,0:09:20.55,Default,,0,0,0,,Енді, Альдо-чан да қайта жанданды...
Dialogue: 0,0:09:20.89,0:09:22.85,Default,,0,0,0,,Әрі қарай не істеуім керек?
Dialogue: 0,0:09:27.44,0:09:29.27,Default,,0,0,0,,Осы мақсатқа жету үшін бәрін қолданамыз — Титан күшін де, сенің қаруларыңды да. ➡
Dialogue: 0,0:09:29.36,0:09:31.48,Default,,0,0,0,,Оны көбірек бұрмалау керек.
Dialogue: 0,0:09:31.57,0:09:34.36,Default,,0,0,0,,Айдың тамаша шеңбері ерекшеленуі үшін
Dialogue: 0,0:09:36.15,0:09:39.66,Default,,0,0,0,,Бұл дүние шіркін, бұрмаланған.
Dialogue: 0,0:09:40.49,0:09:43.41,Default,,0,0,0,,Ай сәулесі түскенде...
Dialogue: 0,0:09:47.37,0:09:50.25,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:09:50.33,0:09:52.71,Default,,0,0,0,,Хахахахахаха…
Dialogue: 0,0:09:52.80,0:09:54.67,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:09:54.76,0:09:56.63,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:59.18,0:10:01.10,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:10:06.85,0:10:07.89,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:07.98,0:10:08.81,Default,,0,0,0,,Бұл!
Dialogue: 0,0:10:08.89,0:10:12.57,Default,,0,0,0,,Ақ сиқыршы басқаратын барлық адамдар қалыпты жағдайға оралды ма?
Dialogue: 0,0:10:12.65,0:10:15.74,Default,,0,0,0,,Оның сиқыры әйтеуір бұзылған сияқты.
Dialogue: 0,0:10:16.49,0:10:17.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:18.32,0:10:19.82,Default,,0,0,0,,Әлі де...
Dialogue: 0,0:10:19.91,0:10:21.20,Default,,0,0,0,,Жоқ, мен әйеліммен ұрсысып қалдым.
Dialogue: 0,0:10:23.83,0:10:26.62,Default,,0,0,0,,Ақ сиқыршы мен Тука-санды ажыратыңыз
Dialogue: 0,0:10:26.91,0:10:27.79,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:28.50,0:10:30.25,Default,,0,0,0,,Бөлу сиқыры!
Dialogue: 0,0:10:30.88,0:10:31.83,Default,,0,0,0,,Ха…
Dialogue: 0,0:10:32.38,0:10:33.21,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:33.29,0:10:35.17,Default,,0,0,0,,Ннн!
Dialogue: 0,0:10:35.88,0:10:37.63,Default,,0,0,0,,Ух... Уууу...
Dialogue: 0,0:10:37.72,0:10:41.09,Default,,0,0,0,,Айрин мырза, маған көмектесіңізші!
Dialogue: 0,0:10:41.18,0:10:42.47,Default,,0,0,0,,Айрин?
Dialogue: 0,0:10:42.55,0:10:44.56,Default,,0,0,0,,Жоқ, бұл ештеңе емес!
Dialogue: 0,0:10:45.56,0:10:47.02,Default,,0,0,0,,Бүгін жаңа мектепке бірінші күнің ғой?
Dialogue: 0,0:10:47.10,0:10:50.85,Default,,0,0,0,,және оларды туған жерім Италияның асханасына енгіздім.
Dialogue: 0,0:10:55.57,0:10:56.40,Default,,0,0,0,,Ах…
Dialogue: 0,0:10:56.48,0:10:58.44,Default,,0,0,0,,Екіге бөл!
Dialogue: 0,0:10:58.53,0:11:00.36,Default,,0,0,0,,Жарайсың Венди!
Dialogue: 0,0:11:00.45,0:11:03.32,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:11:03.82,0:11:04.78,Default,,0,0,0,,Я...
Dialogue: 0,0:11:04.87,0:11:06.79,Default,,0,0,0,,Ха…
Dialogue: 0,0:11:10.66,0:11:12.29,Default,,0,0,0,,Бұл жер де құлағалы тұр!
Dialogue: 0,0:11:12.38,0:11:14.42,Default,,0,0,0,,Тез Туканы алып қашайық!
Dialogue: 0,0:11:19.26,0:11:20.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:20.47,0:11:22.97,Default,,0,0,0,,Нацу! Оны да әкелесің бе?
Dialogue: 0,0:11:23.76,0:11:25.39,Default,,0,0,0,,Бұл соншалықты сергітпейді!
Dialogue: 0,0:11:25.47,0:11:27.35,Default,,0,0,0,,Мен де бұл жігіттің мақсатын түсінбеймін!
Dialogue: 0,0:11:27.43,0:11:30.02,Default,,0,0,0,,Ағаш айдаһар Альдронды жабу үшін—
Dialogue: 0,0:11:30.10,0:11:32.14,Default,,0,0,0,,Сіз шарды жоямын дедіңіз —
Dialogue: 0,0:11:32.23,0:11:35.52,Default,,0,0,0,,Шарды жойғаннан кейін Олдрон оянды!
Dialogue: 0,0:11:36.48,0:11:38.78,Default,,0,0,0,,(жығылған дыбыс)
Dialogue: 0,0:11:43.11,0:11:44.32,Default,,0,0,0,,Бақытты Чарльз!
Dialogue: 0,0:11:44.87,0:11:47.33,Default,,0,0,0,,Тука мен Ақ сиқыршыны мүмкіндігінше алысқа жылжытыңыз!
Dialogue: 0,0:11:47.41,0:11:50.79,Default,,0,0,0,,Вэнди бар күшін жұмсаған болуы керек, менімен бірге жүр.
Dialogue: 0,0:11:51.29,0:11:52.42,Default,,0,0,0,,Нацу ше?
Dialogue: 0,0:11:53.04,0:11:55.04,Default,,0,0,0,,Енді бұл менің жұмысым.
Dialogue: 0,0:11:56.21,0:11:58.05,Default,,0,0,0,,Айдаһарды жеңу!
Dialogue: 0,0:12:03.30,0:12:04.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:11.77,0:12:13.64,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:12:14.15,0:12:17.11,Default,,0,0,0,,Ежелгі құбыжық ақыры оянды ма?
Dialogue: 0,0:12:17.82,0:12:19.57,Default,,0,0,0,,Шабуыл жасауға рұқсат берілді.
Dialogue: 0,0:12:20.07,0:12:21.15,Default,,0,0,0,,Осыдан-
Dialogue: 0,0:12:21.24,0:12:23.95,Default,,0,0,0,,Ағаш құдайы айдаһарды бағындыру операциясын бастаңыз
Dialogue: 0,0:12:24.03,0:12:25.03,Default,,0,0,0,,Іске қосуға дайын!
Dialogue: 0,0:12:25.53,0:12:27.16,Default,,0,0,0,,Іске қосуға дайын!
Dialogue: 0,0:12:31.04,0:12:32.91,Default,,0,0,0,,Не... Ах...
Dialogue: 0,0:12:33.00,0:12:35.21,Default,,0,0,0,,Не? Бұл сиқырлы күш!
Dialogue: 0,0:12:35.29,0:12:37.38,Default,,0,0,0,,- (Уоррен) Анау жарық... - Эй!
Dialogue: 0,0:12:37.46,0:12:39.92,Default,,0,0,0,,Юпитердің сиқырлы зеңбірегі! ?
Dialogue: 0,0:12:40.00,0:12:41.84,Default,,0,0,0,,Енді сиқырлы күш жоқ!
Dialogue: 0,0:12:41.92,0:12:44.30,Default,,0,0,0,,Мұндайлар өте көп...
Dialogue: 0,0:12:44.88,0:12:46.93,Default,,0,0,0,,Уранның сиқырлы зеңбірегі
Dialogue: 0,0:12:47.51,0:12:49.26,Default,,0,0,0,,Барлық мылтық сыни нүкте!
Dialogue: 0,0:12:49.35,0:12:50.47,Default,,0,0,0,,Түсіру
Dialogue: 0,0:12:55.85,0:12:57.23,Default,,0,0,0,,Не... не?! ?
Dialogue: 0,0:12:57.31,0:12:58.69,Default,,0,0,0,,Барлығың, жатыңдар!
Dialogue: 0,0:12:58.77,0:13:00.65,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:13:02.69,0:13:04.57,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:13:05.40,0:13:06.95,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,0:13:07.03,0:13:08.03,Default,,0,0,0,,Иә! ?
Dialogue: 0,0:13:16.62,0:13:17.67,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:23.88,0:13:25.01,Default,,0,0,0,,Ағаш! ?
Dialogue: 0,0:13:25.09,0:13:27.59,Default,,0,0,0,,Жерден осы биік аспанға дейінгі ағаштар!
Dialogue: 0,0:13:27.68,0:13:29.09,Default,,0,0,0,,7-ші кеме жойылды!
Dialogue: 0,0:13:29.18,0:13:30.85,Default,,0,0,0,,12 13 Үлкен апат!
Dialogue: 0,0:13:31.43,0:13:33.81,Default,,0,0,0,,Не... Бұл не?
Dialogue: 0,0:13:42.78,0:13:45.15,Default,,0,0,0,,Жақсы... жойылды...
Dialogue: 0,0:13:45.24,0:13:47.11,Default,,0,0,0,,(Жан) Не…
Dialogue: 0,0:13:52.12,0:13:53.87,Default,,0,0,0,,Құдайдың айдаһарына -
Dialogue: 0,0:13:53.95,0:13:56.50,Default,,0,0,0,,Адам қаруы жұмыс істемейді.
Dialogue: 0,0:13:57.08,0:14:00.46,Default,,0,0,0,,Сен ашулысың, Альдо-чан.
Dialogue: 0,0:14:00.96,0:14:04.55,Default,,0,0,0,,Жақсы, мен саған бұл дүниені беремін.
Dialogue: 0,0:14:04.63,0:14:07.09,Default,,0,0,0,,Барлығын ұсақтап тастаңыз.
Dialogue: 0,0:14:12.01,0:14:13.81,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:14:13.89,0:14:18.31,Default,,0,0,0,,Мен шынымен түсінбеймін, бірақ барлық кемелер жойылды.
Dialogue: 0,0:14:18.39,0:14:19.77,Default,,0,0,0,,Бұл керемет күш.
Dialogue: 0,0:14:20.27,0:14:22.31,Default,,0,0,0,,Бірақ бұл болды.
Dialogue: 0,0:14:22.40,0:14:25.19,Default,,0,0,0,,Мен бұл үлкен жігітті қалай жеңемін?
Dialogue: 0,0:14:25.28,0:14:28.11,Default,,0,0,0,,Айтпақшы, қала тұрғындары, олар қайда кетті?
Dialogue: 0,0:14:28.20,0:14:29.74,Default,,0,0,0,,Барлығы қашып құтыла алды ма?
Dialogue: 0,0:14:30.28,0:14:32.70,Default,,0,0,0,,Тек орындаңыз!
Dialogue: 0,0:14:33.37,0:14:35.16,Default,,0,0,0,,Кеттік, Олдрон!
Dialogue: 0,0:14:35.24,0:14:37.50,Default,,0,0,0,,Жалын айдаһар патшасы...
Dialogue: 0,0:14:37.58,0:14:39.83,Default,,0,0,0,,Коукен!
Dialogue: 0,0:14:43.34,0:14:46.76,Default,,0,0,0,,О!
Dialogue: 0,0:14:54.68,0:14:55.85,Default,,0,0,0,,Фу…
Dialogue: 0,0:14:55.93,0:14:59.06,Default,,0,0,0,,Жоқ, ешқандай зақым келтірмеңіз.
Dialogue: 0,0:15:00.10,0:15:02.02,Default,,0,0,0,,-1 -Ой?
Dialogue: 0,0:15:02.48,0:15:03.86,Default,,0,0,0,,Сіз Олдронға -
Dialogue: 0,0:15:03.94,0:15:06.48,Default,,0,0,0,,1 балл зиян келтірді.
Dialogue: 0,0:15:06.57,0:15:07.90,Default,,0,0,0,,1?
Dialogue: 0,0:15:08.57,0:15:10.74,Default,,0,0,0,,Алайда Олдронның физикалық күші...
Dialogue: 0,0:15:10.82,0:15:12.41,Default,,0,0,0,,100 миллион ұпай.
Dialogue: 0,0:15:12.49,0:15:18.87,Default,,0,0,0,,Егер мен сол әдісті тағы 99,999,999 рет қолдана алсам, мен оны жеңе аламын.
Dialogue: 0,0:15:19.50,0:15:21.58,Default,,0,0,0,,Тек артқы бөлігі
Dialogue: 0,0:15:21.67,0:15:22.71,Default,,0,0,0,,(Итадори) Медуза шикигами! Ішке кірсе, соққылар әсер етпейді ме?
Dialogue: 0,0:15:22.79,0:15:25.59,Default,,0,0,0,,Балалар, сіз қарсы алуға тырысып жатқан нәрсе:
Dialogue: 0,0:15:25.67,0:15:27.67,Default,,0,0,0,,Міне солай.
Dialogue: 0,0:15:27.76,0:15:30.13,Default,,0,0,0,,Бүршік адам кейпіне енеді!
Dialogue: 0,0:15:30.72,0:15:34.68,Default,,0,0,0,,Мен Ағаш Айдаһар Олдронының бөлігімін...
Dialogue: 0,0:15:36.60,0:15:39.52,Default,,0,0,0,,құдай тұқымы Вольфен
Dialogue: 0,0:15:40.14,0:15:41.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:41.77,0:15:44.94,Default,,0,0,0,,Бұдан былай Ағаш Құдай Айдаһардың бөлігі болмағандар...
Dialogue: 0,0:15:45.02,0:15:46.15,Default,,0,0,0,,алып тастаңыз
Dialogue: 0,0:15:46.23,0:15:47.61,Default,,0,0,0,,Уф!
Dialogue: 0,0:15:47.69,0:15:49.40,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:15:49.74,0:15:50.57,Default,,0,0,0,,Неге?! Неге?!
Dialogue: 0,0:15:50.65,0:15:52.53,Default,,0,0,0,,Өртен!
Dialogue: 0,0:15:53.57,0:15:55.62,Default,,0,0,0,,Мен оны оқыдым.
Dialogue: 0,0:15:58.16,0:15:59.91,Default,,0,0,0,,Бұл қандай балалар?
Dialogue: 0,0:16:00.00,0:16:01.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:02.21,0:16:03.96,Default,,0,0,0,,Ағаш адам?
Dialogue: 0,0:16:05.08,0:16:06.46,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:06.54,0:16:07.54,Default,,0,0,0,,Кана-сан!
Dialogue: 0,0:16:07.63,0:16:10.01,Default,,0,0,0,,Кет... мынау!
Dialogue: 0,0:16:11.55,0:16:12.97,Default,,0,0,0,,Мен оны оқыдым.
Dialogue: 0,0:16:13.05,0:16:14.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:15.55,0:16:19.39,Default,,0,0,0,,Ең күшті деп санайтынның күші
Dialogue: 0,0:16:21.93,0:16:23.81,Default,,0,0,0,,-Ах... -Нх...
Dialogue: 0,0:16:23.89,0:16:26.02,Default,,0,0,0,,Не? Бұл
Dialogue: 0,0:16:26.11,0:16:27.77,Default,,0,0,0,,Оның келбеті өзгереді!
Dialogue: 0,0:16:35.16,0:16:36.20,Default,,0,0,0,,Гилдартс! ?
Dialogue: 0,0:16:36.28,0:16:38.03,Default,,0,0,0,,Неліктен ол әкеге ұқсайды? ?
Dialogue: 0,0:16:40.08,0:16:41.95,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:16:42.04,0:16:43.41,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:16:45.00,0:16:48.09,Default,,0,0,0,,Шынымен! Гилдарттың сиқырын пайдалана аласыз ба?
Dialogue: 0,0:16:48.59,0:16:50.05,Default,,0,0,0,,Бұл балалар...
Dialogue: 0,0:16:50.13,0:16:54.01,Default,,0,0,0,,Біз өз естеліктерімізден жауынгерлер жасай аламыз! ?
Dialogue: 0,0:16:54.09,0:16:56.89,Default,,0,0,0,,Неліктен мен Гилдартс туралы ойладым! ?
Dialogue: 0,0:16:56.97,0:17:00.43,Default,,0,0,0,,Бұл туралы ойламаңыз! Менің ойымды рұқсатсыз оқыды!
Dialogue: 0,0:17:01.47,0:17:05.31,Default,,0,0,0,,Бұл жаман. Менің жағдайымда Уру немесе Рион шығуы мүмкін.
Dialogue: 0,0:17:05.39,0:17:07.73,Default,,0,0,0,,Тіпті Гилдарттың өзі проблема болып табылады...
Dialogue: 0,0:17:10.69,0:17:12.40,Default,,0,0,0,,Мен қазір қашып кетемін.
Dialogue: 0,0:17:12.48,0:17:14.65,Default,,0,0,0,,Бұл жалған болса да, бұл Гилдартс!
Dialogue: 0,0:17:14.74,0:17:18.12,Default,,0,0,0,,Барлығына! Ағашқа түсіп қалудан сақ болыңыз!
Dialogue: 0,0:17:25.75,0:17:28.63,Default,,0,0,0,,Бұл не? Бұл интрузивті филиал адамдары!
Dialogue: 0,0:17:31.71,0:17:34.05,Default,,0,0,0,,Эльза, қайдасың! ?
Dialogue: 0,0:17:34.13,0:17:36.26,Default,,0,0,0,,Хе!
Dialogue: 0,0:17:36.34,0:17:40.22,Default,,0,0,0,,Неліктен Мастерлер көптеп шабуыл жасайды? ?
Dialogue: 0,0:17:40.30,0:17:41.72,Default,,0,0,0,,Мен білмеймін!
Dialogue: 0,0:17:41.81,0:17:45.52,Default,,0,0,0,,Барлығын ертерек ұстаған кезде олардың сыртқы түрі өзгерді.
Dialogue: 0,0:17:45.60,0:17:47.19,Default,,0,0,0,,Тек қаш!
Dialogue: 0,0:17:49.73,0:17:54.99,Default,,0,0,0,,Мен сен ең күшті деп ойлағанның күшін оқыдым.
Dialogue: 0,0:17:55.69,0:17:58.57,Default,,0,0,0,,Не? Сіздің сыртқы келбетіңіз өзгереді!
Dialogue: 0,0:17:58.66,0:18:00.49,Default,,0,0,0,,Құдай тұқымы —
Dialogue: 0,0:18:00.57,0:18:05.75,Default,,0,0,0,,Жою керек адамдардың естеліктерінде «күштілердің күшін» бейнелеу —
Dialogue: 0,0:18:05.83,0:18:07.54,Default,,0,0,0,,Адамды алып тастаңыз
Dialogue: 0,0:18:07.62,0:18:11.71,Default,,0,0,0,,Дұрыс, сен мен ешқашан жеңе алмайтын қарсылас боласың.
Dialogue: 0,0:18:11.79,0:18:13.71,Default,,0,0,0,,Міндетті түрде өлтіріңіз
Dialogue: 0,0:18:14.46,0:18:15.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:16.80,0:18:18.30,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:18:18.38,0:18:20.68,Default,,0,0,0,,Жоқ, сіз қателеспейсіз.
Dialogue: 0,0:18:20.76,0:18:22.47,Default,,0,0,0,,Көп нәрсе дұрыс емес!
Dialogue: 0,0:18:22.55,0:18:25.43,Default,,0,0,0,,Одан да күшті біреу болуы керек!
Dialogue: 0,0:18:25.52,0:18:27.94,Default,,0,0,0,,Өмір мен өлім күресі өтті...
Dialogue: 0,0:18:28.48,0:18:30.65,Default,,0,0,0,,Өйткені мен әрқашан Бақытпен бірге болдым.
Dialogue: 0,0:18:30.73,0:18:34.07,Default,,0,0,0,,Бұл жігіттің басында не болып жатыр? ?
Dialogue: 0,0:18:34.15,0:18:36.86,Default,,0,0,0,,Бүгін Happy-ді екінші рет ұрып тұрмын (буынның жарылған дыбысы).
Dialogue: 0,0:18:36.94,0:18:37.90,Default,,0,0,0,,(Шинобу) Мұнда кездейсоқ біреуді білетін адам бар ма?
Dialogue: 0,0:18:37.99,0:18:39.15,Default,,0,0,0,,Уф…
Dialogue: 0,0:18:40.32,0:18:42.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:42.28,0:18:43.66,Default,,0,0,0,,Кешіріңіз! (соққы дыбысы)
Dialogue: 0,0:18:46.70,0:18:48.58,Default,,0,0,0,,-Иә? -(Големс) Жою...
Dialogue: 0,0:18:48.66,0:18:51.08,Default,,0,0,0,,Бұл жігіттер көп пе?
Dialogue: 0,0:18:51.17,0:18:52.54,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,0:18:54.59,0:18:59.13,Default,,0,0,0,,Бірақ қараңдаршы, балалар, маған түсінік бердіңіздер.
Dialogue: 0,0:18:59.55,0:19:03.68,Default,,0,0,0,,Мен Олдронды жеңудің жолын таптым.
Dialogue: 0,0:19:06.22,0:19:07.35,Default,,0,0,0,,Хаа!
Dialogue: 0,0:19:07.43,0:19:08.56,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:09.31,0:19:10.56,Default,,0,0,0,,Қандай сан!
Dialogue: 0,0:19:10.64,0:19:13.52,Default,,0,0,0,,Жеңсең де, жеңбесең де, жерден өседі!
Dialogue: 0,0:19:14.06,0:19:15.98,Default,,0,0,0,,Су кескіш!
Dialogue: 0,0:19:16.07,0:19:20.07,Default,,0,0,0,,Иә! Джувиа енді сиқырды қолдана алады...
Dialogue: 0,0:19:20.15,0:19:21.45,Default,,0,0,0,,Басқалар да!
Dialogue: 0,0:19:22.53,0:19:25.20,Default,,0,0,0,,Жақсы! Барлығын картадан шығарыңыз!
Dialogue: 0,0:19:25.28,0:19:27.16,Default,,0,0,0,,Қартты жайына қалдыр!
Dialogue: 0,0:19:27.24,0:19:28.91,Default,,0,0,0,,Күресетін денем жоқ.
Dialogue: 0,0:19:29.00,0:19:30.71,Default,,0,0,0,,«Бұл мүлдем керісінше! Менің жайымды қарашы!»
Dialogue: 0,0:19:33.71,0:19:36.30,Default,,0,0,0,,-Мына жігіт... -Иә? біз...
Dialogue: 0,0:19:36.38,0:19:37.63,Default,,0,0,0,,Бұл жер қай жер?
Dialogue: 0,0:19:37.71,0:19:39.88,Default,,0,0,0,,Мира не? киім
Dialogue: 0,0:19:39.97,0:19:42.72,Default,,0,0,0,,Иә? Мен астына ештеңе кимеймін.
Dialogue: 0,0:19:42.80,0:19:44.34,Default,,0,0,0,,Тоқта, апа!
Dialogue: 0,0:19:44.43,0:19:47.31,Default,,0,0,0,,Люси әпке! Жер бетінде не болып жатыр?
Dialogue: 0,0:19:47.39,0:19:50.27,Default,,0,0,0,,Түсіндірме кейінірек! Енді маған қол ұшын бере аласыз ба?
Dialogue: 0,0:19:52.31,0:19:55.06,Default,,0,0,0,,-Не? Бұл жігіт! - Бейкемоно!
Dialogue: 0,0:19:55.52,0:19:56.82,Default,,0,0,0,,Хаа!
Dialogue: 0,0:19:57.61,0:20:00.57,Default,,0,0,0,,Қысқасы, жабайы болу керек!
Dialogue: 0,0:20:00.65,0:20:01.49,Default,,0,0,0,,Гихи!
Dialogue: 0,0:20:01.57,0:20:03.95,Default,,0,0,0,,Бар күшіңізді салыңыз, Гаджил-кун!
Dialogue: 0,0:20:04.03,0:20:06.91,Default,,0,0,0,,- (Лизанна) Егер солай болса! -Оу!
Dialogue: 0,0:20:09.54,0:20:10.83,Default,,0,0,0,,Хан...
Dialogue: 0,0:20:10.91,0:20:12.29,Default,,0,0,0,,Теккен!
Dialogue: 0,0:20:12.37,0:20:14.75,Default,,0,0,0,,Жануарлардың жаны!
Dialogue: 0,0:20:19.80,0:20:21.42,Default,,0,0,0,,Шайтанның жарылуы!
Dialogue: 0,0:20:21.51,0:20:23.01,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:23.09,0:20:26.43,Default,,0,0,0,,Эй... Мира-чан одақтас ретінде сенімді екені сөзсіз.
Dialogue: 0,0:20:26.51,0:20:27.39,Default,,0,0,0,,Керемет!
Dialogue: 0,0:20:27.85,0:20:32.10,Default,,0,0,0,,Мен Грейден ұрып-соғуды армандайтын сияқтымын.
Dialogue: 0,0:20:32.18,0:20:33.35,Default,,0,0,0,,Бұл менің қиялым ғана!
Dialogue: 0,0:20:33.44,0:20:35.31,Default,,0,0,0,,Айтпақшы, Лаксус ше?
Dialogue: 0,0:20:35.40,0:20:38.23,Default,,0,0,0,,-Білмеймін - (Бикслоу) Жақсысың деп үміттенемін.
Dialogue: 0,0:20:38.32,0:20:40.36,Default,,0,0,0,,Бұл қандай киім?
Dialogue: 0,0:20:40.44,0:20:42.28,Default,,0,0,0,,О... міне...
Dialogue: 0,0:20:42.36,0:20:43.82,Default,,0,0,0,,Қарама!
Dialogue: 0,0:20:43.90,0:20:46.78,Default,,0,0,0,,Мына жігіттердің қолына түсіп қалмау үшін абай бол!
Dialogue: 0,0:20:46.87,0:20:51.50,Default,,0,0,0,,Егер сізді ұстап алсаңыз, сіз өзіңізді «мықтымын» деп санайтын адамға айналасыз!
Dialogue: 0,0:20:59.92,0:21:02.01,Default,,0,0,0,,Хмм! иә!
Dialogue: 0,0:21:02.42,0:21:03.80,Default,,0,0,0,,Хаа!
Dialogue: 0,0:21:04.76,0:21:08.01,Default,,0,0,0,,Олдронды қалай жеңуге болады, бұл идеяны ұсынғаныңызға қуаныштымын...
Dialogue: 0,0:21:08.10,0:21:09.55,Default,,0,0,0,,Бұл жігіттер...
Dialogue: 0,0:21:09.64,0:21:11.77,Default,,0,0,0,,Бұл сан ыңғайсыздық тудырады!
Dialogue: 0,0:21:11.85,0:21:14.52,Default,,0,0,0,,Мен олардың бәрін бірге өртеп жіберемін!
Dialogue: 0,0:21:14.98,0:21:16.23,Default,,0,0,0,,От айдаһар...
Dialogue: 0,0:21:16.31,0:21:17.69,Default,,0,0,0,,Айқай!
Dialogue: 0,0:21:35.00,0:21:36.12,Default,,0,0,0,,Ха…
Dialogue: 0,0:21:36.21,0:21:37.58,Default,,0,0,0,,Сенің жұлының далаға лақтырылып, шіріп кетті, тіпті шыбындар да тимейді—
Dialogue: 0,0:21:38.17,0:21:40.54,Default,,0,0,0,,Өз ойыңызды оқыңыз
Dialogue: 0,0:21:40.63,0:21:42.00,Default,,0,0,0,,Мен өлсем бола ма?
Dialogue: 0,0:21:42.09,0:21:45.51,Default,,0,0,0,,Басқалар келмей тұрып мұқият оқып шығыңыз.
Dialogue: 0,0:21:46.09,0:21:47.47,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,0:21:47.55,0:21:49.47,Default,,0,0,0,,Бұл жұмыс істей ме?
Dialogue: 0,0:21:49.55,0:21:51.35,Default,,0,0,0,,Мен оны оқыдым.
Dialogue: 0,0:21:52.47,0:21:54.35,Default,,0,0,0,,Ақымақтар
Dialogue: 0,0:21:54.43,0:21:58.35,Default,,0,0,0,,Мен сондай зор сиқырлы күшке ие біреу туралы ойладым...
Dialogue: 0,0:22:01.27,0:22:03.69,Default,,0,0,0,,Енді жеңу мүмкіндігіңіз жоқ.
Dialogue: 0,0:22:03.78,0:22:05.03,Default,,0,0,0,,Нацу
Dialogue: 0,0:22:06.40,0:22:07.99,Default,,0,0,0,,Біраз уақыт өтті
Dialogue: 0,0:22:08.91,0:22:10.32,Default,,0,0,0,,Ах… Аман-есен екеніңе қатты қуаныштымын.
Dialogue: 0,0:22:10.99,0:22:17.00,Default,,0,0,0,,♪~
Dialogue: 0,0:23:36.83,0:23:42.83,Default,,0,0,0,,~♪
Dialogue: 0,0:23:44.33,0:23:50.33,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory