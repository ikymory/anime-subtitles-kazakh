Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.71,0:00:06.84,Default,,0,0,0,,-Мм... -Мына жігіт...
Dialogue: 0,0:00:06.92,0:00:09.96,Default,,0,0,0,,Ол шеңбер бойымен қозғалса да... қозғалды.
Dialogue: 0,0:00:10.05,0:00:11.92,Default,,0,0,0,,Венди…
Dialogue: 0,0:00:12.01,0:00:14.34,Default,,0,0,0,,Сіз қандай айдаһарсыз?
Dialogue: 0,0:00:14.43,0:00:15.89,Default,,0,0,0,,Мен Тенрюмін
Dialogue: 0,0:00:16.59,0:00:18.81,Default,,0,0,0,,Аспандағы айдаһар өлтіруші!
Dialogue: 0,0:00:18.89,0:00:20.93,Default,,0,0,0,,Жоқ... бұл Майю Айдаһар.
Dialogue: 0,0:00:21.02,0:00:22.06,Default,,0,0,0,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:00:22.14,0:00:23.56,Default,,0,0,0,,Маю Маю~
Dialogue: 0,0:00:23.64,0:00:24.94,Default,,0,0,0,,Бұл Венди!
Dialogue: 0,0:00:25.02,0:00:27.40,Default,,0,0,0,,Қайтадан айналдыр!
Dialogue: 0,0:00:27.48,0:00:30.19,Default,,0,0,0,,Бір қимылды қайта-қайта жасама!
Dialogue: 0,0:00:31.69,0:00:33.74,Default,,0,0,0,,Домаланған Маюмаю
Dialogue: 0,0:00:33.82,0:00:35.24,Default,,0,0,0,,(Жан) Не…
Dialogue: 0,0:00:35.78,0:00:37.12,Default,,0,0,0,,Nnnnnnn…
Dialogue: 0,0:00:37.91,0:00:39.08,Default,,0,0,0,,Тенрюдің...
Dialogue: 0,0:00:39.16,0:00:40.54,Default,,0,0,0,,Тырнақтар!
Dialogue: 0,0:00:40.62,0:00:41.49,Default,,0,0,0,,Уууу…
Dialogue: 0,0:00:44.50,0:00:45.37,Default,,0,0,0,,Мен олардың үмітін ақтағым келеді
Dialogue: 0,0:00:48.25,0:00:49.25,Default,,0,0,0,,Ха…
Dialogue: 0,0:00:50.59,0:00:51.42,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:51.50,0:00:52.55,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:52.63,0:00:56.38,Default,,0,0,0,,Маю Маю Қызық екен, енді жемеймін.
Dialogue: 0,0:00:56.47,0:00:59.18,Default,,0,0,0,,Шынайы мақсатты орындау
Dialogue: 0,0:00:59.26,0:01:00.35,Default,,0,0,0,,Я...
Dialogue: 0,0:01:00.43,0:01:01.35,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:01:01.43,0:01:02.85,Default,,0,0,0,,Гуру Гуру…
Dialogue: 0,0:01:02.93,0:01:03.89,Default,,0,0,0,,Орб!
Dialogue: 0,0:01:03.98,0:01:05.35,Default,,0,0,0,,Бум!
Dialogue: 0,0:01:05.44,0:01:06.81,Default,,0,0,0,,Ах…
Dialogue: 0,0:01:06.90,0:01:08.27,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:01:08.35,0:01:10.23,Default,,0,0,0,,Хи хи хи...
Dialogue: 0,0:01:10.32,0:01:12.69,Default,,0,0,0,,Біз жеңілдік.
Dialogue: 0,0:01:12.78,0:01:14.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:15.11,0:01:17.91,Default,,0,0,0,,Екінші шар жойылды.
Dialogue: 0,0:01:18.66,0:01:20.37,Default,,0,0,0,,Үш нәрсе қалды
Dialogue: 0,0:01:20.45,0:01:23.75,Default,,0,0,0,,Ағаш айдаһар Олдрон күшін жоғалтқанға дейін—
Dialogue: 0,0:01:24.50,0:01:26.21,Default,,0,0,0,,Тағы үш...
Dialogue: 0,0:01:27.42,0:01:33.42,Default,,0,0,0,,♪~
Dialogue: 0,0:02:50.33,0:02:55.59,Default,,0,0,0,,~♪
Dialogue: 0,0:03:05.72,0:03:07.68,Default,,0,0,0,,Қазір дүмпу қандай?
Dialogue: 0,0:03:07.77,0:03:09.39,Default,,0,0,0,,Шар жойылды ма?
Dialogue: 0,0:03:10.06,0:03:13.35,Default,,0,0,0,,Енді үш шар ғана қалды.
Dialogue: 0,0:03:13.44,0:03:15.32,Default,,0,0,0,,Солардың бірі осында...
Dialogue: 0,0:03:15.40,0:03:16.77,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,0:03:16.86,0:03:21.24,Default,,0,0,0,,Балалар, Олдронды әлсірету үшін не істеуді жоспарлап отырсыңдар?
Dialogue: 0,0:03:21.32,0:03:23.87,Default,,0,0,0,,Басқа бес құдайлық айдаһармен күресу —
Dialogue: 0,0:03:23.95,0:03:25.74,Default,,0,0,0,,Оны жоғалтыңыз
Dialogue: 0,0:03:26.53,0:03:30.37,Default,,0,0,0,,Ақ сиқыршы Ағаш Айдаһардың күшін ұрламақшы.
Dialogue: 0,0:03:30.46,0:03:31.87,Default,,0,0,0,,Төзе бер, шыдай бер!
Dialogue: 0,0:03:31.96,0:03:35.34,Default,,0,0,0,,Біздің мақсатымыз Олдронды әлсіретіп, оны жеу.
Dialogue: 0,0:03:35.42,0:03:36.92,Default,,0,0,0,,Мақсаты басқа болса да—
Dialogue: 0,0:03:37.00,0:03:41.47,Default,,0,0,0,,Шарды жою процесіне дейін бірдей.
Dialogue: 0,0:03:41.55,0:03:42.80,Default,,0,0,0,,Солай көрінеді.
Dialogue: 0,0:03:42.88,0:03:46.05,Default,,0,0,0,,Олай болса, орбита алдында соғысып жатқан біз...
Dialogue: 0,0:03:46.14,0:03:47.56,Default,,0,0,0,,Мен бұл не туралы екеніне таң қаламын.
Dialogue: 0,0:03:48.10,0:03:50.52,Default,,0,0,0,,Менің ойымша, Тем оны орнатты.
Dialogue: 0,0:03:50.60,0:03:52.31,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:03:52.39,0:03:54.98,Default,,0,0,0,,Өйткені сіз өте жақсы көріндіңіз
Dialogue: 0,0:03:55.06,0:03:56.44,Default,,0,0,0,,(тілді жалау дыбысы)
Dialogue: 0,0:03:56.52,0:03:59.40,Default,,0,0,0,,Ащы тағамдарға өте ыңғайлы
Dialogue: 0,0:04:01.44,0:04:04.53,Default,,0,0,0,,Қазір Лаксус пен Кирияның төбелесіп жатқан кезі...
Dialogue: 0,0:04:04.61,0:04:06.74,Default,,0,0,0,,Шарды ұрлаудың ең үлкен мүмкіндігі
Dialogue: 0,0:04:06.82,0:04:08.28,Default,,0,0,0,,Ал дегенмен!
Dialogue: 0,0:04:10.04,0:04:11.66,Default,,0,0,0,,Бұл жағдай!
Dialogue: 0,0:04:12.54,0:04:13.62,Default,,0,0,0,,Уф…
Dialogue: 0,0:04:13.71,0:04:17.88,Default,,0,0,0,,Эльза, мен сені қазір ақ түске бояймын.
Dialogue: 0,0:04:17.96,0:04:20.17,Default,,0,0,0,,- Жабыңыз! -(Джерард) Қорықпа.
Dialogue: 0,0:04:20.25,0:04:21.59,Default,,0,0,0,,Тоқта.
Dialogue: 0,0:04:22.55,0:04:26.34,Default,,0,0,0,,Өзіңді маған тапсыр, бәрі.
Dialogue: 0,0:04:26.43,0:04:27.55,Default,,0,0,0,,Жерар
Dialogue: 0,0:04:28.14,0:04:30.31,Default,,0,0,0,,Шектеулерді босатыңыз.
Dialogue: 0,0:04:30.68,0:04:32.52,Default,,0,0,0,,Менің есімде бір жағымсыз нәрсе...
Dialogue: 0,0:04:32.60,0:04:33.98,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:34.77,0:04:37.90,Default,,0,0,0,,Мен сенің иығыңа қолымды созғым келеді
Dialogue: 0,0:04:38.48,0:04:40.44,Default,,0,0,0,,Мен сенің бетіңе тигізгім келеді...
Dialogue: 0,0:04:41.19,0:04:42.40,Default,,0,0,0,,Эльза...
Dialogue: 0,0:04:44.61,0:04:46.61,Default,,0,0,0,,Мен... Кешіріңіз.
Dialogue: 0,0:04:46.70,0:04:48.37,Default,,0,0,0,,Мен мұны енді қайталамаймын.
Dialogue: 0,0:04:48.45,0:04:50.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:53.75,0:04:55.83,Default,,0,0,0,,Не... не! ? Эльза?
Dialogue: 0,0:04:56.42,0:04:57.79,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:57.88,0:05:00.21,Default,,0,0,0,,Енді сізді ұстайды!
Dialogue: 0,0:05:00.30,0:05:01.25,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:01.34,0:05:05.09,Default,,0,0,0,,Жақсы, мен сізде бар нәрсені қабылдаймын.
Dialogue: 0,0:05:05.17,0:05:07.18,Default,,0,0,0,,Кез келген уақытта келіңіз!
Dialogue: 0,0:05:07.26,0:05:08.72,Default,,0,0,0,,Жоқ, бұл дұрыс емес!
Dialogue: 0,0:05:08.80,0:05:10.60,Default,,0,0,0,,Біраз уақыт осылай бол!
Dialogue: 0,0:05:10.68,0:05:13.68,Default,,0,0,0,,Түсіндім, мені мазақтап жатқан шығар.
Dialogue: 0,0:05:14.56,0:05:16.52,Default,,0,0,0,,Мен шіркеуге асығуым керек...
Dialogue: 0,0:05:19.69,0:05:23.36,Default,,0,0,0,,Ойлап қарасам, атаммен ешқашан қатты ұрысып көрмеппін.
Dialogue: 0,0:05:23.44,0:05:26.74,Default,,0,0,0,,Мен сені таныс деп санамауым керек.
Dialogue: 0,0:05:27.61,0:05:30.83,Default,,0,0,0,,Осы қария екеуміздің сиқырлы күшімізді...
Dialogue: 0,0:05:30.91,0:05:33.24,Default,,0,0,0,,Жеңілмейтін күш дүниеге келді.
Dialogue: 0,0:05:34.00,0:05:35.37,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:05:35.46,0:05:36.29,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:36.37,0:05:37.42,Default,,0,0,0,,Дио, жүрегім ауыр.
Dialogue: 0,0:05:39.25,0:05:40.88,Default,,0,0,0,,Itte~
Dialogue: 0,0:05:40.96,0:05:43.84,Default,,0,0,0,,Енді мен қабырғадан өте алдым...
Dialogue: 0,0:05:43.92,0:05:44.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:45.42,0:05:49.18,Default,,0,0,0,,Ойлап қарасам, мен елес болсам, неге қол көтересің? ?
Dialogue: 0,0:05:49.26,0:05:52.10,Default,,0,0,0,,Менің денем саған шабуыл жасай алмайды!
Dialogue: 0,0:05:52.18,0:05:56.23,Default,,0,0,0,,Біріншіден, сіз бен бізде әртүрлі қасиеттер бар.
Dialogue: 0,0:05:56.89,0:06:00.69,Default,,0,0,0,,Мен елесмін, ал сен қатаң түрде ойлау объектісісің.
Dialogue: 0,0:06:00.77,0:06:04.48,Default,,0,0,0,,Затпен соқтығысу туралы шешім менің субъективті пікіріммен анықталады.
Dialogue: 0,0:06:04.57,0:06:08.11,Default,,0,0,0,,Мен түсінбеймін, бірақ бұл Zurii дегенді білдіреді.
Dialogue: 0,0:06:08.20,0:06:09.70,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:06:09.78,0:06:13.58,Default,,0,0,0,,Сіз де бейсаналық түрде соққыны анықтауды субъективті түрде шешесіз.
Dialogue: 0,0:06:14.33,0:06:17.83,Default,,0,0,0,,Бастапқыда елес дене заттарға қол тигізе алмайды.
Dialogue: 0,0:06:17.91,0:06:21.42,Default,,0,0,0,,Бірақ сен мендегі мысықты ұрдың...
Dialogue: 0,0:06:21.50,0:06:24.80,Default,,0,0,0,,Қаласам мына қарияны да ұрып алар едім.
Dialogue: 0,0:06:25.25,0:06:29.01,Default,,0,0,0,,Елестер ыңғайлы ма, ыңғайсыз ба білмеймін.
Dialogue: 0,0:06:29.09,0:06:33.01,Default,,0,0,0,,Әйтеуір, бұл қария кім?
Dialogue: 0,0:06:33.64,0:06:35.77,Default,,0,0,0,,Синхрондау жылдамдығы бұрын-соңды болмаған.
Dialogue: 0,0:06:36.22,0:06:39.23,Default,,0,0,0,,Сол қария менің гильдиямның қожайыны.
Dialogue: 0,0:06:39.77,0:06:43.77,Default,,0,0,0,,Гильдия шебері Сондықтан, қуатты сиқырлы күш...
Dialogue: 0,0:06:43.86,0:06:48.11,Default,,0,0,0,,Жас бойынша қорытынды жасауға болатын кейбір өмірлік тәжірибелер:
Dialogue: 0,0:06:48.95,0:06:52.07,Default,,0,0,0,,Өлім аузында адасып кеткен шығарсың.
Dialogue: 0,0:06:52.16,0:06:56.37,Default,,0,0,0,,Дегенмен, осы нүктеге дейінгі синхрондау жылдамдығы...
Dialogue: 0,0:06:56.87,0:06:59.00,Default,,0,0,0,,Ха... мүмкін емес...
Dialogue: 0,0:06:59.08,0:07:01.33,Default,,0,0,0,,Үшінші шарт да қолданылады ма? ?
Dialogue: 0,0:07:01.42,0:07:03.04,Default,,0,0,0,,Қан туыстары?
Dialogue: 0,0:07:03.38,0:07:06.80,Default,,0,0,0,,Бұл қарттың маған қатысы бар...
Dialogue: 0,0:07:06.88,0:07:07.96,Default,,0,0,0,,Гунун…
Dialogue: 0,0:07:08.05,0:07:11.13,Default,,0,0,0,,Бақытқа қосылу, Джикчанға қосылу...
Dialogue: 0,0:07:11.63,0:07:14.85,Default,,0,0,0,,Менің өмірім есімде жоқ.
Dialogue: 0,0:07:14.93,0:07:20.85,Default,,0,0,0,,Сондықтан мені өлтіргендерді тауып, жауапқа тарту арқылы...
Dialogue: 0,0:07:20.94,0:07:23.40,Default,,0,0,0,,Мүмкін мен есте сақтау қабілетімді қалпына келтірермін
Dialogue: 0,0:07:23.48,0:07:26.65,Default,,0,0,0,,Менің достарым сенің ыдысың емес!
Dialogue: 0,0:07:27.44,0:07:31.11,Default,,0,0,0,,Мен дос деп айтатын адам болды ма?
Dialogue: 0,0:07:31.70,0:07:34.32,Default,,0,0,0,,Жоқ, одан да көп, қазір...
Dialogue: 0,0:07:35.66,0:07:36.95,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:07:37.03,0:07:38.91,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:07:39.00,0:07:40.37,Default,,0,0,0,,73 адам із-түссіз жоғалып кетті
Dialogue: 0,0:07:40.45,0:07:41.83,Default,,0,0,0,,Нихи...
Dialogue: 0,0:07:43.29,0:07:45.21,Default,,0,0,0,,Бұл керемет күш.
Dialogue: 0,0:07:45.50,0:07:48.59,Default,,0,0,0,,Бұл қарттың сиқырлы күші!
Dialogue: 0,0:07:49.71,0:07:50.59,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:07:53.38,0:07:55.76,Default,,0,0,0,,Қарт адам күткендей
Dialogue: 0,0:07:55.85,0:07:57.22,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:07:58.89,0:08:01.81,Default,,0,0,0,,Нағыз ата күштірек!
Dialogue: 0,0:08:01.89,0:08:03.27,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:08:03.77,0:08:07.23,Default,,0,0,0,,Кешіріңіз, ата, мен шындап барамын!
Dialogue: 0,0:08:07.82,0:08:09.69,Default,,0,0,0,,Жалын айдаһар патшасы...
Dialogue: 0,0:08:09.78,0:08:12.11,Default,,0,0,0,,Коукен!
Dialogue: 0,0:08:12.20,0:08:15.95,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:08:17.41,0:08:21.91,Default,,0,0,0,,Мынау... тіпті осы сиқырлы күштен де асып түсетін құдіреті бар ма! ?
Dialogue: 0,0:08:22.41,0:08:26.88,Default,,0,0,0,,Сиқырлы күшіңіз қаншалықты жоғары болса да, сіздің денеңіз әлі де қартаюда...
Dialogue: 0,0:08:26.96,0:08:28.84,Default,,0,0,0,,Шынымен...
Dialogue: 0,0:08:29.88,0:08:31.09,Default,,0,0,0,,Қарт адамдарға қараудың несі оғаш?
Dialogue: 0,0:08:31.17,0:08:32.30,Default,,0,0,0,,Олай айтпа.
Dialogue: 0,0:08:32.38,0:08:34.55,Default,,0,0,0,,Ха... бұл...
Dialogue: 0,0:08:34.63,0:08:38.26,Default,,0,0,0,,Маған енді шайқас көру қиын.
Dialogue: 0,0:08:38.35,0:08:41.06,Default,,0,0,0,,Сен әлсіз екенсің.
Dialogue: 0,0:08:41.14,0:08:43.39,Default,,0,0,0,,Олай айтпа, Голдмин.
Dialogue: 0,0:08:44.14,0:08:46.85,Default,,0,0,0,,Мына қарияның естелігі?
Dialogue: 0,0:08:46.94,0:08:51.61,Default,,0,0,0,,Гильдиядан шық. Мүмкін мен кеңеске кіруім керек.
Dialogue: 0,0:08:51.69,0:08:55.86,Default,,0,0,0,,Сен бізге жау болмайтын шығарсың.
Dialogue: 0,0:08:55.95,0:09:00.12,Default,,0,0,0,,Мен де тәуелсіз болуды ойлап жүрмін.
Dialogue: 0,0:09:00.20,0:09:01.24,Default,,0,0,0,,Маған үш дана беріңіз.
Dialogue: 0,0:09:01.33,0:09:05.25,Default,,0,0,0,,Боб Сіз Fairy Tail-тен қашуды жоспарлап отырсыз ба?
Dialogue: 0,0:09:05.33,0:09:06.87,Default,,0,0,0,,Жақсы емес пе?
Dialogue: 0,0:09:06.96,0:09:08.38,Default,,0,0,0,,Тым көп адам
Dialogue: 0,0:09:08.46,0:09:11.00,Default,,0,0,0,,Сиқырды қолдана алмасаңыз да...
Dialogue: 0,0:09:11.09,0:09:12.71,Default,,0,0,0,,Неліктен гильдиядасың? ?
Dialogue: 0,0:09:13.26,0:09:17.09,Default,,0,0,0,,Менің дәрім қанша адамның өмірін сақтап қалды деп ойлайсың?
Dialogue: 0,0:09:17.18,0:09:18.89,Default,,0,0,0,,Жұбайыңызбен ұрыспаңыз
Dialogue: 0,0:09:18.97,0:09:20.60,Default,,0,0,0,,Біз жақсы доспыз, солай емес пе?
Dialogue: 0,0:09:21.31,0:09:22.52,Default,,0,0,0,,Жұп емес!
Dialogue: 0,0:09:22.60,0:09:24.56,Default,,0,0,0,,Бұл адам кім?
Dialogue: 0,0:09:24.64,0:09:27.52,Default,,0,0,0,,-Бетіңіз ашық қызыл. -Тезірек үйлен.
Dialogue: 0,0:09:27.60,0:09:28.69,Default,,0,0,0,,Әзіл емес!
Dialogue: 0,0:09:28.77,0:09:30.77,Default,,0,0,0,,Міне, мен адамдарды жек көремін!
Dialogue: 0,0:09:30.86,0:09:31.86,Default,,0,0,0,,Жүгір!
Dialogue: 0,0:09:31.94,0:09:33.99,Default,,0,0,0,,- (Сиқыршы) Жолды аш! -Не болып жатыр? ?
Dialogue: 0,0:09:34.74,0:09:35.86,Default,,0,0,0,,Ол жарақат алды!
Dialogue: 0,0:09:35.95,0:09:37.57,Default,,0,0,0,,Жұмыстағы құбыжықтар тобы —
Dialogue: 0,0:09:37.66,0:09:38.95,Default,,0,0,0,,Маған шабуыл жасалды...
Dialogue: 0,0:09:39.49,0:09:42.70,Default,,0,0,0,,Порлюсика, өтінемін! Өтінемін маған көмектесіңіз!
Dialogue: 0,0:09:42.79,0:09:43.83,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:09:43.91,0:09:45.87,Default,,0,0,0,,Уа... жараланып қалдың ғой!
Dialogue: 0,0:09:45.96,0:09:47.67,Default,,0,0,0,,Сәлем! Мүлдем жалқау!
Dialogue: 0,0:09:48.21,0:09:50.63,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:09:50.71,0:09:52.25,Default,,0,0,0,,Бұл...
Dialogue: 0,0:09:53.05,0:09:54.30,Default,,0,0,0,,Өзі ешқашан Ал Майтты басып оза алмайтынын түсінген әкем—
Dialogue: 0,0:09:54.38,0:09:56.59,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:09:56.67,0:10:01.01,Default,,0,0,0,,Мен енді құтқара алмаймын ба деп ойлаймын...
Dialogue: 0,0:10:01.64,0:10:02.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:03.06,0:10:05.93,Default,,0,0,0,,Ақымақ болма! Бұл міндетті түрде көмектеседі!
Dialogue: 0,0:10:06.02,0:10:07.98,Default,,0,0,0,,Дұрыс? Порлюсика!
Dialogue: 0,0:10:08.44,0:10:11.44,Default,,0,0,0,,- (Порлюсица) Жоқ... -Маған көмектесіңізші!
Dialogue: 0,0:10:12.02,0:10:13.52,Default,,0,0,0,,Макаров
Dialogue: 0,0:10:13.61,0:10:17.82,Default,,0,0,0,,Неге сонша үмітсізсің...
Dialogue: 0,0:10:17.90,0:10:21.82,Default,,0,0,0,,Біз сонша жақын едік...
Dialogue: 0,0:10:22.53,0:10:25.04,Default,,0,0,0,,Бұл маңызды емес!
Dialogue: 0,0:10:25.12,0:10:26.79,Default,,0,0,0,,Олар дос болуы керек!
Dialogue: 0,0:10:27.12,0:10:29.29,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:10:29.37,0:10:31.67,Default,,0,0,0,,Өлме, Урейт!
Dialogue: 0,0:10:31.75,0:10:35.21,Default,,0,0,0,,Сіз менің атымды білесіз...
Dialogue: 0,0:10:36.30,0:10:38.17,Default,,0,0,0,,Бұл таңқаларлық...
Dialogue: 0,0:10:38.72,0:10:41.14,Default,,0,0,0,,Не дедіңіз!
Dialogue: 0,0:10:41.22,0:10:44.39,Default,,0,0,0,,Олар бір Fairy Tail тобының мүшелері шығар!
Dialogue: 0,0:10:44.47,0:10:48.35,Default,,0,0,0,,Біз отбасымыз! Барлығымыз!
Dialogue: 0,0:10:49.64,0:10:51.10,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:10:53.61,0:10:54.94,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:10:55.02,0:10:56.90,Default,,0,0,0,,Бір мүйізбен осындай күш.
Dialogue: 0,0:10:56.98,0:10:59.86,Default,,0,0,0,,(Барлығы жылайды)
Dialogue: 0,0:11:01.91,0:11:06.41,Default,,0,0,0,,Мен ертегідегі сиқыршы болдым ба?
Dialogue: 0,0:11:07.08,0:11:12.54,Default,,0,0,0,,Гильдияның қаннан да күшті байланыстары синхрондау жылдамдығын осы уақытқа дейін жасады...
Dialogue: 0,0:11:13.50,0:11:15.38,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,0:11:21.47,0:11:22.76,Default,,0,0,0,,Бұл менің жоғалтуым
Dialogue: 0,0:11:22.84,0:11:24.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:24.26,0:11:26.64,Default,,0,0,0,,Бәрі есімде
Dialogue: 0,0:11:26.72,0:11:30.48,Default,,0,0,0,,Мен енді саған қарсы бола алмаймын.
Dialogue: 0,0:11:31.27,0:11:33.48,Default,,0,0,0,,Сіз де отбасысыз.
Dialogue: 0,0:11:33.73,0:11:35.90,Default,,0,0,0,,Сіздің денеңіз...
Dialogue: 0,0:11:36.77,0:11:40.07,Default,,0,0,0,,А... Мен үйге бара аламын.
Dialogue: 0,0:11:40.49,0:11:43.36,Default,,0,0,0,,Мені тапқаныңызға рахмет
Dialogue: 0,0:11:44.45,0:11:45.91,Default,,0,0,0,,Wraith…
Dialogue: 0,0:11:46.49,0:11:47.33,Default,,0,0,0,,Ха…
Dialogue: 0,0:11:47.79,0:11:50.29,Default,,0,0,0,,Сағыныш
Dialogue: 0,0:11:50.37,0:11:53.33,Default,,0,0,0,,Мен де Макаров
Dialogue: 0,0:11:58.17,0:12:00.76,Default,,0,0,0,,А... не болып жатыр? Не деген...
Dialogue: 0,0:12:01.26,0:12:04.72,Default,,0,0,0,,Жарайды, мен де атамды жеңдім.
Dialogue: 0,0:12:05.93,0:12:07.18,Default,,0,0,0,,(Бақытты жылау)
Dialogue: 0,0:12:07.26,0:12:10.56,Default,,0,0,0,,Сондықтан мен денеме оралдым.
Dialogue: 0,0:12:10.64,0:12:12.06,Default,,0,0,0,,Нацу~!
Dialogue: 0,0:12:12.14,0:12:14.98,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:17.06,0:12:19.57,Default,,0,0,0,,Бұрынғы дүмпу қандай болды?
Dialogue: 0,0:12:19.65,0:12:22.95,Default,,0,0,0,,Шарлардың бірі жойылған болуы мүмкін.
Dialogue: 0,0:12:23.03,0:12:25.57,Default,,0,0,0,,Егер сіз дірілдеп жатсаңыз.
Dialogue: 0,0:12:25.66,0:12:27.41,Default,,0,0,0,,-Жоқ, жоқ, жоқ -n...
Dialogue: 0,0:12:27.49,0:12:29.87,Default,,0,0,0,,Оңай алайық
Dialogue: 0,0:12:30.49,0:12:32.20,Default,,0,0,0,,Не? Ықылық…
Dialogue: 0,0:12:32.29,0:12:34.00,Default,,0,0,0,,Кана-сан!
Dialogue: 0,0:12:34.08,0:12:38.17,Default,,0,0,0,,Бұл жігіт айла-шарғы жасаса да ішіп жүр ме?
Dialogue: 0,0:12:38.25,0:12:40.13,Default,,0,0,0,,Нфуфуфуфу…
Dialogue: 0,0:12:40.80,0:12:44.51,Default,,0,0,0,,Райчиншуларға қарағанда оңай жұмыс болатын сияқты.
Dialogue: 0,0:12:44.59,0:12:47.09,Default,,0,0,0,,Грэй мырза, абай болыңыз.
Dialogue: 0,0:12:47.18,0:12:49.81,Default,,0,0,0,,Кешіріңіз, мен мұны бір кадрда жасаймын.
Dialogue: 0,0:12:50.64,0:12:52.48,Default,,0,0,0,,Хи хи...
Dialogue: 0,0:12:53.73,0:12:54.73,Default,,0,0,0,,Иә! ?
Dialogue: 0,0:12:54.81,0:12:57.98,Default,,0,0,0,,Иә? сұр төңкерілген
Dialogue: 0,0:12:58.61,0:12:59.98,Default,,0,0,0,,Сіз мас екенсіз!
Dialogue: 0,0:13:00.44,0:13:01.61,Default,,0,0,0,,Нихи!
Dialogue: 0,0:13:01.69,0:13:05.78,Default,,0,0,0,,Жинал! Перілер басқаратын жарық өзен!
Dialogue: 0,0:13:05.86,0:13:09.20,Default,,0,0,0,,Жарқыра! Зұлым азуларды жою үшін!
Dialogue: 0,0:13:09.74,0:13:11.33,Default,,0,0,0,,Ертегі жылтырлығы! ?
Dialogue: 0,0:13:11.83,0:13:14.79,Default,,0,0,0,,Осындай қалада! ? Есіңіз дұрыс па?
Dialogue: 0,0:13:14.87,0:13:16.79,Default,,0,0,0,,Ертегі…
Dialogue: 0,0:13:16.87,0:13:18.50,Default,,0,0,0,,Мухофф…
Dialogue: 0,0:13:19.34,0:13:20.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:20.79,0:13:22.21,Default,,0,0,0,,- (Люси) Сіз мұны уақытында орындадыңыз! -Иә?
Dialogue: 0,0:13:22.30,0:13:24.67,Default,,0,0,0,,Овен ерекше үлпілдек
Dialogue: 0,0:13:24.76,0:13:27.68,Default,,0,0,0,,Осы арқылы ән айтуды қажет ететін сиқырдың алдын алуға болады.
Dialogue: 0,0:13:27.76,0:13:29.14,Default,,0,0,0,,Люси
Dialogue: 0,0:13:29.22,0:13:31.14,Default,,0,0,0,,Үлпілдек дегеніміз не?
Dialogue: 0,0:13:31.22,0:13:35.35,Default,,0,0,0,,Грей Ювия, мен Кананы іздеп жүр едім.
Dialogue: 0,0:13:35.43,0:13:37.10,Default,,0,0,0,,Оны табу жақсы жұмыс.
Dialogue: 0,0:13:37.19,0:13:39.86,Default,,0,0,0,,Прюдің жалғыз қабілеті
Dialogue: 0,0:13:40.06,0:13:41.82,Default,,0,0,0,,Нацу сияқты жақсы мұрын!
Dialogue: 0,0:13:41.90,0:13:43.07,Default,,0,0,0,,Пун
Dialogue: 0,0:13:43.61,0:13:47.15,Default,,0,0,0,,Сіздің мұрныңыз осындай бұрғылау сияқты ма?
Dialogue: 0,0:13:47.24,0:13:49.78,Default,,0,0,0,,Бұрғыға ұқсайтын шығар.
Dialogue: 0,0:13:49.87,0:13:51.20,Default,,0,0,0,,Шалшық
Dialogue: 0,0:13:51.28,0:13:53.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:54.16,0:13:56.87,Default,,0,0,0,,Егер бұл Кана болса, оны әрқашан өзіңізбен бірге алып жүруіңіз керек...
Dialogue: 0,0:13:56.96,0:13:58.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:58.92,0:14:02.75,Default,,0,0,0,,Шудың астында кеуделеріңізге тиіп жатқанына сенімдімін.
Dialogue: 0,0:14:02.84,0:14:03.96,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,0:14:04.05,0:14:06.34,Default,,0,0,0,,Грей-сама да көптің арасында адасып кете ме?
Dialogue: 0,0:14:06.42,0:14:07.47,Default,,0,0,0,,Мұны істеме!
Dialogue: 0,0:14:07.55,0:14:08.72,Default,,0,0,0,,Міне болды!
Dialogue: 0,0:14:08.80,0:14:10.93,Default,,0,0,0,,Бұл! Сиқырлы карталар!
Dialogue: 0,0:14:11.47,0:14:14.18,Default,,0,0,0,,Бұл Кана үнемі қолданатын карта емес пе?
Dialogue: 0,0:14:14.27,0:14:15.31,Default,,0,0,0,,Бұл дәл «қуалап ұстау» ойыны сияқты.
Dialogue: 0,0:14:15.39,0:14:18.89,Default,,0,0,0,,Бұл шын мәнінде адамдарды тұзаққа түсіретін күшке ие!
Dialogue: 0,0:14:18.98,0:14:20.35,Default,,0,0,0,,Ал...
Dialogue: 0,0:14:20.65,0:14:21.90,Default,,0,0,0,,Осыны пайдалану —
Dialogue: 0,0:14:21.98,0:14:25.36,Default,,0,0,0,,Барлығын жинап, барлығын бір уақытта қорғаңыз!
Dialogue: 0,0:14:25.44,0:14:28.15,Default,,0,0,0,,Бірақ бұл Кананың сиқыры болса керек.
Dialogue: 0,0:14:28.24,0:14:30.74,Default,,0,0,0,,Өйткені олар бірдей ұстаушы типті сиқыршылар.
Dialogue: 0,0:14:30.82,0:14:34.49,Default,,0,0,0,,Мен кана сияқты жақсы емеспін, бірақ мен оны пайдалана аламын деп ойлаймын.
Dialogue: 0,0:14:34.58,0:14:36.12,Default,,0,0,0,,Бұл карта –
Dialogue: 0,0:14:36.20,0:14:39.00,Default,,0,0,0,,Аспан рухының кілтінен айырмашылығы, ешқандай келісім-шарт қажет емес.
Dialogue: 0,0:14:39.58,0:14:42.88,Default,,0,0,0,,Енді біз барлығын қалыпты жағдайға қайтара аламыз!
Dialogue: 0,0:14:42.96,0:14:46.17,Default,,0,0,0,,Оны қайтаруға бола ма, жоқ па ол басқа әңгіме...
Dialogue: 0,0:14:46.26,0:14:48.67,Default,,0,0,0,,Біз қазір барлығын қорғай алуымыз керек.
Dialogue: 0,0:14:48.76,0:14:51.34,Default,,0,0,0,,О! Сіз ақылдысыз
Dialogue: 0,0:14:51.43,0:14:53.80,Default,,0,0,0,,Кананы дереу картаға салыңыз
Dialogue: 0,0:14:53.89,0:14:54.81,Default,,0,0,0,,Қамау!
Dialogue: 0,0:14:56.43,0:14:57.27,Default,,0,0,0,,А...
Dialogue: 0,0:14:57.35,0:14:58.73,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:59.39,0:15:01.10,Default,,0,0,0,,Неге~! ?
Dialogue: 0,0:15:01.19,0:15:02.35,Default,,0,0,0,,біз қайта орала аламыз.
Dialogue: 0,0:15:02.44,0:15:04.61,Default,,0,0,0,,Мен картадамын...
Dialogue: 0,0:15:05.19,0:15:06.82,Default,,0,0,0,,Есептегіш
Dialogue: 0,0:15:06.90,0:15:10.07,Default,,0,0,0,,Оның сиқыры дұрыс пайдаланбау үшін Кана...
Dialogue: 0,0:15:10.15,0:15:11.36,Default,,0,0,0,,Тұзақ орнату...
Dialogue: 0,0:15:11.45,0:15:14.07,Default,,0,0,0,,-Олай емес - (Грей Ювия) Иә?
Dialogue: 0,0:15:14.66,0:15:17.37,Default,,0,0,0,,Картаның коммерциялық қол жетімді екені рас...
Dialogue: 0,0:15:17.45,0:15:19.62,Default,,0,0,0,,Бұл кез келген адам пайдалана алатын карта, бірақ...
Dialogue: 0,0:15:19.71,0:15:23.54,Default,,0,0,0,,Адамдарды тұзаққа түсіретін сиқырға келетін болсақ, ол біраз шеберлікті қажет етеді.
Dialogue: 0,0:15:24.17,0:15:25.21,Default,,0,0,0,,Кана…
Dialogue: 0,0:15:25.29,0:15:26.67,Default,,0,0,0,,Қараңыз! (Саусақтарды сермеу дыбысы)
Dialogue: 0,0:15:29.21,0:15:30.59,Default,,0,0,0,,Жақсы! (Саусақтарды сермеу дыбысы)
Dialogue: 0,0:15:33.18,0:15:34.72,Default,,0,0,0,,Не?
Dialogue: 0,0:15:35.18,0:15:37.47,Default,,0,0,0,,Кана-сан, неге...
Dialogue: 0,0:15:37.56,0:15:39.77,Default,,0,0,0,,Гипноз бұзылады деп ешқашан ойламаппын...
Dialogue: 0,0:15:39.85,0:15:41.94,Default,,0,0,0,,Жоқ, олай болуы мүмкін емес.
Dialogue: 0,0:15:42.02,0:15:45.94,Default,,0,0,0,,Гипноз бұзылса да, сіз сиқырды пайдалана алмайсыз.
Dialogue: 0,0:15:46.02,0:15:47.27,Default,,0,0,0,,Ювия Митейни
Dialogue: 0,0:15:47.36,0:15:48.98,Default,,0,0,0,,Гипноз?
Dialogue: 0,0:15:49.07,0:15:52.53,Default,,0,0,0,,А... Айтайын дегенім, мен неге сонша әдемі көрінемін?
Dialogue: 0,0:15:53.07,0:15:54.41,Default,,0,0,0,,Дасс!
Dialogue: 0,0:15:55.07,0:15:58.54,Default,,0,0,0,,Сәлем! Ол толығымен киіммен жабылған жоқ па?
Dialogue: 0,0:15:59.08,0:16:00.66,Default,,0,0,0,,Мүмкін—
Dialogue: 0,0:16:00.75,0:16:04.46,Default,,0,0,0,,Сіз басынан бастап ішімдікке байланысты гипнозға ұшырамадыңыз ба?
Dialogue: 0,0:16:05.25,0:16:06.46,Default,,0,0,0,,Сен ұсқынсыз қатыгезсің!!
Dialogue: 0,0:16:06.54,0:16:10.09,Default,,0,0,0,,Ендеше, бұл ертегі жылтырлығы қандай?
Dialogue: 0,0:16:10.17,0:16:11.80,Default,,0,0,0,,Сіз массыз ба? ?
Dialogue: 0,0:16:11.88,0:16:12.93,Default,,0,0,0,,Қорқынышты!
Dialogue: 0,0:16:13.01,0:16:14.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:14.39,0:16:15.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:15.97,0:16:18.64,Default,,0,0,0,,Бірақ жақсы!
Dialogue: 0,0:16:18.72,0:16:21.48,Default,,0,0,0,,Жоқ, жоқ... не болып жатыр?
Dialogue: 0,0:16:22.18,0:16:24.94,Default,,0,0,0,,Бұл барлығын құтқара алады.
Dialogue: 0,0:16:25.02,0:16:26.77,Default,,0,0,0,,Барлығымызды іздейік
Dialogue: 0,0:16:28.15,0:16:29.40,Default,,0,0,0,,ал біз батырлармыз.
Dialogue: 0,0:16:29.48,0:16:33.32,Default,,0,0,0,,Найзағай айдаһарын жейтін уақыт келді ме?
Dialogue: 0,0:16:33.40,0:16:38.41,Default,,0,0,0,,Мен сенің кім екеніңді білмеймін, бірақ мен сенің күшіңді білемін.
Dialogue: 0,0:16:38.49,0:16:39.91,Default,,0,0,0,,Сіз мені жеңе алмайсыз
Dialogue: 0,0:16:39.99,0:16:42.37,Default,,0,0,0,,Мен бұл туралы таң қалдым!
Dialogue: 0,0:16:42.45,0:16:43.50,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:45.71,0:16:47.79,Default,,0,0,0,,Мен сіздің «күшіңізді» кесіп тастадым
Dialogue: 0,0:16:48.25,0:16:50.75,Default,,0,0,0,,Кел, менің ойыншығым бол!
Dialogue: 0,0:16:52.80,0:16:54.01,Default,,0,0,0,,Ха…
Dialogue: 0,0:16:54.09,0:16:58.35,Default,,0,0,0,,Күш? Кешіріңіз, бірақ менде ондай ештеңе жоқ.
Dialogue: 0,0:16:58.43,0:16:59.47,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:16:59.56,0:17:02.47,Default,,0,0,0,,Мен гильдиядамын, өйткені мен әлсізмін.
Dialogue: 0,0:17:02.56,0:17:05.44,Default,,0,0,0,,Бірақ бұл да жаман емес деп ойлаймын.
Dialogue: 0,0:17:05.52,0:17:06.81,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:17:07.98,0:17:11.07,Default,,0,0,0,,-Наруми найзағай! -Гах!
Dialogue: 0,0:17:13.94,0:17:16.32,Default,,0,0,0,,Достарыңыздың алдында әлсіз болғаныңыз дұрыс
Dialogue: 0,0:17:17.28,0:17:19.28,Default,,0,0,0,,Өзіңізді мәжбүрлеудің қажеті жоқ
Dialogue: 0,0:17:19.83,0:17:23.25,Default,,0,0,0,,Бұл Эльзаға қиын болар еді.
Dialogue: 0,0:17:24.46,0:17:27.29,Default,,0,0,0,,Мұндай күшке қарамастан -
Dialogue: 0,0:17:27.37,0:17:29.71,Default,,0,0,0,,Жүрегі әлсіз адам...
Dialogue: 0,0:17:30.84,0:17:33.17,Default,,0,0,0,,Сіз ақылсыз болуыңыз мүмкін еді!
Dialogue: 0,0:17:33.26,0:17:35.59,Default,,0,0,0,,Мм... Мынау не піллә?
Dialogue: 0,0:17:35.67,0:17:37.84,Default,,0,0,0,,Мен оны мүлдем ала алмаймын!
Dialogue: 0,0:17:37.93,0:17:40.85,Default,,0,0,0,,Мен үшін уайымдама, бұрынғы жігіттің соңынан ер!
Dialogue: 0,0:17:40.93,0:17:42.43,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:17:42.85,0:17:44.81,Default,,0,0,0,,Оның басқа қалалардан келген шарлары болуы керек.
Dialogue: 0,0:17:44.89,0:17:46.48,Default,,0,0,0,,Мен оны жоюға бардым.
Dialogue: 0,0:17:46.56,0:17:48.19,Default,,0,0,0,,Мұны тоқтату керек!
Dialogue: 0,0:17:48.85,0:17:52.15,Default,,0,0,0,,Егер сіз оны жеңсеңіз, бұл коконды алуыңыз керек!
Dialogue: 0,0:17:53.53,0:17:54.69,Default,,0,0,0,,Иә
Dialogue: 0,0:17:55.69,0:17:58.07,Default,,0,0,0,,Мен міндетті түрде қайтамын!
Dialogue: 0,0:18:03.24,0:18:04.29,Default,,0,0,0,,(Цубаки мен Ватару) Оның мойын арты! Қандай аппақ тері! (Медбике) Есікті алдымен қағып ал!
Dialogue: 0,0:18:04.37,0:18:05.50,Default,,0,0,0,,Мен сенің қашып кетуіңе жол бермеймін!
Dialogue: 0,0:18:05.58,0:18:06.96,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:18:09.00,0:18:09.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:10.58,0:18:11.79,Default,,0,0,0,,Маю Маю!
Dialogue: 0,0:18:11.88,0:18:13.21,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:13.71,0:18:14.88,Default,,0,0,0,,Ақыры ұстадым сені, Дио!
Dialogue: 0,0:18:14.96,0:18:16.34,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:18.72,0:18:20.18,Default,,0,0,0,,Ннн…
Dialogue: 0,0:18:20.72,0:18:21.60,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:22.05,0:18:25.97,Default,,0,0,0,,Сенің қызық болғаның сонша, мен оны елемедім.
Dialogue: 0,0:18:26.06,0:18:30.52,Default,,0,0,0,,Бірақ сіз өзіңізден келдіңіз бе?
Dialogue: 0,0:18:30.60,0:18:34.23,Default,,0,0,0,,Мен сені тоқтатуға келдім.
Dialogue: 0,0:18:34.32,0:18:35.86,Default,,0,0,0,,Дайын болыңыз!
Dialogue: 0,0:18:35.94,0:18:38.70,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:18:38.78,0:18:41.20,Default,,0,0,0,,А... (тамақтану дыбысы)
Dialogue: 0,0:18:42.20,0:18:44.03,Default,,0,0,0,,Сағыз? (жұтыну дыбысы)\NСіз
Dialogue: 0,0:18:44.70,0:18:46.04,Default,,0,0,0,,жұтып жатырсыз ба? ?
Dialogue: 0,0:18:46.12,0:18:48.54,Default,,0,0,0,,Мен сағыз жеймін.
Dialogue: 0,0:18:48.83,0:18:50.42,Default,,0,0,0,,Қуат қосылды!
Dialogue: 0,0:18:50.50,0:18:51.58,Default,,0,0,0,,Ха…
Dialogue: 0,0:18:51.67,0:18:52.79,Default,,0,0,0,,Хаа!
Dialogue: 0,0:18:54.38,0:18:56.42,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:57.46,0:18:59.51,Default,,0,0,0,,Сіз жейсіз
Dialogue: 0,0:18:59.59,0:19:01.47,Default,,0,0,0,,Ах... Ах...
Dialogue: 0,0:19:02.22,0:19:04.93,Default,,0,0,0,,Макао, Вакаба және Ромеоны алыңыз!
Dialogue: 0,0:19:05.56,0:19:07.39,Default,,0,0,0,,Мұны кім жасады?
Dialogue: 0,0:19:07.47,0:19:09.85,Default,,0,0,0,,Бұл жарамен Нацу шығар.
Dialogue: 0,0:19:09.94,0:19:11.90,Default,,0,0,0,,Мен әлі алда болатынына сенімдімін...
Dialogue: 0,0:19:13.02,0:19:14.36,Default,,0,0,0,,Э? Не болып жатыр? Неге!?
Dialogue: 0,0:19:14.44,0:19:15.98,Default,,0,0,0,,Лисанна!
Dialogue: 0,0:19:16.07,0:19:17.82,Default,,0,0,0,,Лизаннаны алыңыз!
Dialogue: 0,0:19:18.49,0:19:20.78,Default,,0,0,0,,Ха... бұл сиқырлы күш...
Dialogue: 0,0:19:21.32,0:19:23.53,Default,,0,0,0,,Маңайдағы Мира мен Эльфман
Dialogue: 0,0:19:23.62,0:19:26.45,Default,,0,0,0,,Міне, Диаболос жігіттері.
Dialogue: 0,0:19:26.54,0:19:27.74,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,0:19:28.45,0:19:31.71,Default,,0,0,0,,Мира-чан мен жау болып кеткен сол жігіт, солай ма?
Dialogue: 0,0:19:31.79,0:19:35.46,Default,,0,0,0,,Олардың барлығын Кана-санның карталарымен құлыптасақ...
Dialogue: 0,0:19:35.92,0:19:38.67,Default,,0,0,0,,Бұл өте дұшпандық танытатын адамдарда жұмыс істемейді.
Dialogue: 0,0:19:38.76,0:19:41.30,Default,,0,0,0,,Сондықтан біз оны нокаутқа түсіруіміз керек.
Dialogue: 0,0:19:41.88,0:19:45.80,Default,,0,0,0,,Ойлануым керек... Бір жолы болу керек.
Dialogue: 0,0:19:50.18,0:19:54.10,Default,,0,0,0,,Егер есімде дұрыс болса, бұйырма осы затты жою болатын.
Dialogue: 0,0:19:55.44,0:19:56.57,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:19:58.48,0:19:59.53,Default,,0,0,0,,Эльза
Dialogue: 0,0:20:00.36,0:20:02.49,Default,,0,0,0,,Мен саған тиісуге рұқсат бермеймін.
Dialogue: 0,0:20:06.53,0:20:07.41,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:08.08,0:20:12.62,Default,,0,0,0,,Лаксус оны жеңді ме? сондай күшті жау
Dialogue: 0,0:20:12.71,0:20:14.21,Default,,0,0,0,,Әлі де күшті
Dialogue: 0,0:20:14.67,0:20:17.17,Default,,0,0,0,,Тіпті Ақ сиқыршының бақылауында да...
Dialogue: 0,0:20:17.84,0:20:20.88,Default,,0,0,0,,Лаксус мүлде серпіліс таба алмайтын жалғыз адам.
Dialogue: 0,0:20:21.84,0:20:25.34,Default,,0,0,0,,Кем дегенде, егер Нацу немесе Грей сонда болса...
Dialogue: 0,0:20:26.30,0:20:28.10,Default,,0,0,0,,Араласпаңыз
Dialogue: 0,0:20:32.06,0:20:34.52,Default,,0,0,0,,Мен Лаксусты тоқтатуым керек!
Dialogue: 0,0:20:36.27,0:20:40.28,Default,,0,0,0,,Нацу, сен неге менің арқамдағы қалаға барасың?
Dialogue: 0,0:20:40.36,0:20:42.61,Default,,0,0,0,,Мен солай деп ойлаймын.
Dialogue: 0,0:20:42.69,0:20:44.32,Default,,0,0,0,,Барлығы бес қала бар —
Dialogue: 0,0:20:44.40,0:20:46.57,Default,,0,0,0,,Артқы жағы ортада.
Dialogue: 0,0:20:46.66,0:20:47.70,Default,,0,0,0,,...және?
Dialogue: 0,0:20:47.78,0:20:50.95,Default,,0,0,0,,Ортаға шықсаң, мықты жігіт шығады. Әдетте
Dialogue: 0,0:20:51.04,0:20:52.29,Default,,0,0,0,,Не? Солай ма?
Dialogue: 0,0:20:52.37,0:20:54.75,Default,,0,0,0,,Мен Лаксус немесе Мира бар екеніне сенімдімін.
Dialogue: 0,0:20:54.83,0:20:56.71,Default,,0,0,0,,Бұл керемет ойлау қабілеті.
Dialogue: 0,0:20:56.79,0:20:59.25,Default,,0,0,0,,Тіпті Жерардың өзі жақсы!
Dialogue: 0,0:20:59.34,0:21:03.72,Default,,0,0,0,,Эльза, сен мені қашанға дейін мазақ етуді жоспарлап жүрсің...
Dialogue: 0,0:21:05.30,0:21:06.34,Default,,0,0,0,,Әй?
Dialogue: 0,0:21:06.89,0:21:09.10,Default,,0,0,0,,Жарық бағанасы бар.
Dialogue: 0,0:21:09.18,0:21:10.81,Default,,0,0,0,,Мұнда бір нәрсе бар
Dialogue: 0,0:21:10.89,0:21:13.27,Default,,0,0,0,,Бұл шардың орналасқан жері ме?
Dialogue: 0,0:21:13.35,0:21:14.77,Default,,0,0,0,,Кеттік, Бақытты!
Dialogue: 0,0:21:14.85,0:21:16.73,Default,,0,0,0,,Айса!
Dialogue: 0,0:21:23.19,0:21:24.99,Default,,0,0,0,,Әй, біреу бар!
Dialogue: 0,0:21:26.32,0:21:28.62,Default,,0,0,0,,Ха... мына жігіт...
Dialogue: 0,0:21:29.49,0:21:31.08,Default,,0,0,0,,Ақ сиқыршы! ?
Dialogue: 0,0:21:31.16,0:21:34.08,Default,,0,0,0,,Неге мұндай жерде құлап жатырсың?
Dialogue: 0,0:21:34.16,0:21:35.54,Default,,0,0,0,,Happy Orb туралы не деуге болады?
Dialogue: 0,0:21:36.42,0:21:38.50,Default,,0,0,0,,Ха... Аман қалған сияқтысың.
Dialogue: 0,0:21:38.58,0:21:41.13,Default,,0,0,0,,Ха... не болып жатыр? Бірге
Dialogue: 0,0:21:41.21,0:21:43.76,Default,,0,0,0,,Енді мына жігітті ұрғың келе ме?
Dialogue: 0,0:21:43.84,0:21:47.26,Default,,0,0,0,,Есі жоқ жігітті ұрып-соғасың ба? ?
Dialogue: 0,0:21:47.34,0:21:49.39,Default,,0,0,0,,Күтілгендей, бұл тең ойын.
Dialogue: 0,0:21:49.47,0:21:51.72,Default,,0,0,0,,Сәлем! Дайын бол!
Dialogue: 0,0:21:51.81,0:21:53.35,Default,,0,0,0,,Жанып жатыр! ?
Dialogue: 0,0:21:53.81,0:21:57.31,Default,,0,0,0,,Мен ұйықтаймын ба, әйелмін бе, бәрібір.
Dialogue: 0,0:21:57.39,0:21:59.86,Default,,0,0,0,,Бұл жігіт гильдияның жауы.
Dialogue: 0,0:22:00.23,0:22:03.78,Default,,0,0,0,,Мен гильдия үшін бәрін жасаймын.
Dialogue: 0,0:22:03.86,0:22:06.40,Default,,0,0,0,,Хмм... аа...
Dialogue: 0,0:22:06.49,0:22:07.74,Default,,0,0,0,,Нацу-сама...
Dialogue: 0,0:22:07.82,0:22:09.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:09.24,0:22:10.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:11.20,0:22:13.41,Default,,0,0,0,,-Хмм... -Көмектесші...
Dialogue: 0,0:22:15.08,0:22:19.42,Default,,0,0,0,,♪~
Dialogue: 0,0:23:38.95,0:23:44.96,Default,,0,0,0,,~♪
Dialogue: 0,0:23:46.46,0:23:52.46,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory