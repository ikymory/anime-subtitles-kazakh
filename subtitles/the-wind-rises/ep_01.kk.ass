Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:21.00,0:00:27.06,Default,,0,0,0,,♪~
Dialogue: 0,0:03:05.00,0:03:11.05,Default,,0,0,0,,~♪
Dialogue: 0,0:05:04.05,0:05:05.04,Default,,0,0,0,,Эй, міне, осы.
Dialogue: 0,0:05:11.02,0:05:12.06,Default,,0,0,0,,Мен оны қарызға аламын ба?
Dialogue: 0,0:05:13.02,0:05:14.02,Default,,0,0,0,,Бұл ағылшын тілі.
Dialogue: 0,0:05:14.03,0:05:15.07,Default,,0,0,0,,Мен ағамның сөздігін алам.
Dialogue: 0,0:05:15.08,0:05:17.02,Default,,0,0,0,,Жарайды, байқап көріңіз.
Dialogue: 0,0:05:17.03,0:05:18.01,Default,,0,0,0,,Иә
Dialogue: 0,0:05:36.07,0:05:37.07,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:05:37.07,0:05:39.04,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:05:39.05,0:05:40.07,Default,,0,0,0,,Сен бар.
Dialogue: 0,0:05:40.08,0:05:43.02,Default,,0,0,0,,Джиро...!
Dialogue: 0,0:05:43.03,0:05:45.08,Default,,0,0,0,,Төменгі сыныптағыларды қорлама (Такаяма) Ей, бейбақ
Dialogue: 0,0:05:46.01,0:05:47.03,Default,,0,0,0,,(айқайлау)
Dialogue: 0,0:05:47.04,0:05:48.04,Default,,0,0,0,,Коннуу!
Dialogue: 0,0:06:02.07,0:06:05.02,Default,,0,0,0,,Міне, бұл батыл тұлға.
Dialogue: 0,0:06:05.09,0:06:07.06,Default,,0,0,0,,Мен абайсызда құлап қалдым.
Dialogue: 0,0:06:08.05,0:06:10.02,Default,,0,0,0,,Ешқандай ұрыс болмайды.
Dialogue: 0,0:06:10.02,0:06:11.01,Default,,0,0,0,,Иә
Dialogue: 0,0:06:12.06,0:06:14.03,Default,,0,0,0,,Әдеттегі жерде тамақ бар.
Dialogue: 0,0:06:15.02,0:06:16.02,Default,,0,0,0,,Иә
Dialogue: 0,0:06:18.06,0:06:20.07,Default,,0,0,0,,Әй, Нии-ниисама!
Dialogue: 0,0:06:21.01,0:06:22.00,Default,,0,0,0,,Қолымды ұсташы, өтінемін. Әрқашан істейтіндей.
Dialogue: 0,0:06:22.00,0:06:25.09,Default,,0,0,0,,Нии-ниисама, шөп алайық.
Dialogue: 0,0:06:27.04,0:06:29.06,Default,,0,0,0,,Нии-ниисама
Dialogue: 0,0:06:32.02,0:06:34.02,Default,,0,0,0,,Шөп терейік
Dialogue: 0,0:06:39.05,0:06:41.09,Default,,0,0,0,,Мен шөп алуға уәде бердім.
Dialogue: 0,0:06:41.09,0:06:42.08,Default,,0,0,0,,Оқу
Dialogue: 0,0:06:49.07,0:06:51.03,Default,,0,0,0,,Сабақ оқымайды
Dialogue: 0,0:06:51.04,0:06:52.06,Default,,0,0,0,,Ағылшын журналы
Dialogue: 0,0:06:56.04,0:06:57.06,Default,,0,0,0,,Біртүрлі сақал
Dialogue: 0,0:06:58.03,0:07:00.06,Default,,0,0,0,,Атақты итальяндық дизайнер
Dialogue: 0,0:07:01.02,0:07:02.08,Default,,0,0,0,,Оның аты - Капрони.
Dialogue: 0,0:07:04.01,0:07:05.06,Default,,0,0,0,,Ол граф.
Dialogue: 0,0:07:05.09,0:07:07.08,Default,,0,0,0,,Әй, Нии-ниисама, ысқылап жатыр!
Dialogue: 0,0:07:07.08,0:07:08.07,Default,,0,0,0,,Сен бұны түсінесің бе!?
Dialogue: 0,0:07:09.05,0:07:12.02,Default,,0,0,0,,Қызыл реңкті қолданайық. Мен оны саған беремін.
Dialogue: 0,0:07:12.03,0:07:14.00,Default,,0,0,0,,Тыныш отырыңыз
Dialogue: 0,0:07:24.06,0:07:27.02,Default,,0,0,0,,Нии-ниисама, не істеп жатырсың?
Dialogue: 0,0:07:27.03,0:07:29.01,Default,,0,0,0,,Кайоның келуіне рұқсат жоқ.
Dialogue: 0,0:07:29.01,0:07:30.07,Default,,0,0,0,,Көзілдірік тағуға болмайды
Dialogue: 0,0:07:30.07,0:07:32.01,Default,,0,0,0,,Мен жұлдыздарға қараймын
Dialogue: 0,0:07:32.05,0:07:35.00,Default,,0,0,0,,Алыстағы заттарды көргенде көру қабілеті жақсарады.
Dialogue: 0,0:07:35.07,0:07:36.07,Default,,0,0,0,,Хмм.
Dialogue: 0,0:07:36.08,0:07:38.00,Default,,0,0,0,,Анаң саған ұрысады.
Dialogue: 0,0:07:38.01,0:07:39.06,Default,,0,0,0,,А, аққан жұлдыз!
Dialogue: 0,0:07:41.02,0:07:42.07,Default,,0,0,0,,Тағы кездескенше!
Dialogue: 0,0:07:44.00,0:07:47.02,Default,,0,0,0,,Әдемі, дәл солай.
Dialogue: 0,0:07:48.03,0:07:50.09,Default,,0,0,0,,О, сонда да.
Dialogue: 0,0:08:06.09,0:08:10.00,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:08:28.03,0:08:29.08,Default,,0,0,0,,Жапон баласы
Dialogue: 0,0:08:30.01,0:08:32.00,Default,,0,0,0,,<Жапон баласы? 〉
Dialogue: 0,0:08:32.03,0:08:34.04,Default,,0,0,0,,〈Неге келдің? 〉
Dialogue: 0,0:08:35.02,0:08:38.01,Default,,0,0,0,,Бұл арман. Менің арманым деп ойлаймын.
Dialogue: 0,0:08:38.02,0:08:42.07,Default,,0,0,0,,<Арман? Онда қал
Dialogue: 0,0:08:55.00,0:08:57.06,Default,,0,0,0,,Бұл жер менің түсімде болса керек
Dialogue: 0,0:08:57.07,0:08:59.02,Default,,0,0,0,,Бұл менің де арманым
Dialogue: 0,0:08:59.07,0:09:02.05,Default,,0,0,0,,Сіздің арманыңыз? Жапон баласы
Dialogue: 0,0:09:02.06,0:09:05.04,Default,,0,0,0,,Біздің армандарымыз байланысты дейсіз бе?
Dialogue: 0,0:09:06.01,0:09:09.07,Default,,0,0,0,,Бұл біртүрлі. Сіз граф Капронисыз.
Dialogue: 0,0:09:09.08,0:09:11.03,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:09:11.07,0:09:13.09,Default,,0,0,0,,Хехе қызық
Dialogue: 0,0:09:14.00,0:09:16.09,Default,,0,0,0,,Бұл арман болуы керек. Бұл дүние арман.
Dialogue: 0,0:09:17.06,0:09:19.02,Default,,0,0,0,,Менің патшалығыма қош келдіңіз
Dialogue: 0,0:09:19.03,0:09:20.04,Default,,0,0,0,,Мен құрметтімін
Dialogue: 0,0:09:22.03,0:09:23.05,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:09:29.02,0:09:31.01,Default,,0,0,0,,Оның жартысы да қайтып келмейді.
Dialogue: 0,0:09:31.02,0:09:32.09,Default,,0,0,0,,Барып, жаудың қаласын өртеп жібер.
Dialogue: 0,0:09:40.01,0:09:42.02,Default,,0,0,0,,Бірақ соғыс жақын арада аяқталады
Dialogue: 0,0:09:51.00,0:09:53.00,Default,,0,0,0,,Жапон баласына мініңіз
Dialogue: 0,0:09:55.03,0:09:57.03,Default,,0,0,0,,Бұл менің арманым
Dialogue: 0,0:09:57.03,0:09:59.07,Default,,0,0,0,,Соғыс біткенде, мына нәрсені құрастыр.
Dialogue: 0,0:10:01.08,0:10:03.06,Default,,0,0,0,,Сән-салтанат болса да, өтінемін.
Dialogue: 0,0:10:05.02,0:10:06.02,Default,,0,0,0,,Ұшайық
Dialogue: 0,0:10:09.07,0:10:12.06,Default,,0,0,0,,Бомбаның орнына жолаушыны алып жүріңіз.
Dialogue: 0,0:10:22.02,0:10:26.00,Default,,0,0,0,,Ондай жерде тесік жоқ, бірақ арман пайдалы.
Dialogue: 0,0:10:26.01,0:10:27.05,Default,,0,0,0,,Сіз кез келген жерге бара аласыз
Dialogue: 0,0:10:35.04,0:10:38.07,Default,,0,0,0,,Кел, арқалықтармен жүр.
Dialogue: 0,0:10:43.06,0:10:45.01,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:10:49.08,0:10:50.06,Default,,0,0,0,,Не?!
Dialogue: 0,0:10:51.01,0:10:53.07,Default,,0,0,0,,(эпикалық музыка)
Dialogue: 0,0:11:20.05,0:11:22.04,Default,,0,0,0,,Өтінемін, бұл әдемі.
Dialogue: 0,0:11:22.05,0:11:24.02,Default,,0,0,0,,Иә, керемет
Dialogue: 0,0:11:28.08,0:11:32.03,Default,,0,0,0,,Бортында 100 жолаушымен Атлант мұхитынан өтіңіз.
Dialogue: 0,0:11:34.06,0:11:36.06,Default,,0,0,0,,Капрони мырза, менің сұрағым бар.
Dialogue: 0,0:11:38.07,0:11:41.01,Default,,0,0,0,,Сіз жақыннан көрмейтін болсаңыз да ұшақ құрастыра аласыз ба?
Dialogue: 0,0:11:43.09,0:11:46.06,Default,,0,0,0,,Мен жақыннан көрмеймін, ұшақты ұша алмаймын.
Dialogue: 0,0:11:48.04,0:11:50.07,Default,,0,0,0,,Тыңда, жапон баласы.
Dialogue: 0,0:11:50.08,0:11:53.07,Default,,0,0,0,,Мен ұшақтарды ұшпаймын, жоқ, мен ұша алмаймын.
Dialogue: 0,0:11:53.09,0:11:55.02,Default,,0,0,0,,Ухахаха
Dialogue: 0,0:11:55.03,0:11:56.06,Default,,0,0,0,,Кім ұшқыш болуға жарамды?
Dialogue: 0,0:11:56.07,0:11:57.08,Default,,0,0,0,,Басқа да көп
Dialogue: 0,0:11:58.04,0:12:00.08,Default,,0,0,0,,Мен ұшақ жасайтын адаммын.
Dialogue: 0,0:12:00.09,0:12:02.07,Default,,0,0,0,,Мен дизайнермін.
Dialogue: 0,0:12:03.02,0:12:04.00,Default,,0,0,0,,Иә
Dialogue: 0,0:12:04.06,0:12:06.08,Default,,0,0,0,,Тыңда, жапон баласы.
Dialogue: 0,0:12:06.09,0:12:09.00,Default,,0,0,0,,Ұшақтар соғыс құралы болып табылады
Dialogue: 0,0:12:09.01,0:12:10.09,Default,,0,0,0,,Бұл тіпті коммерциялық қулық емес.
Dialogue: 0,0:12:11.06,0:12:14.00,Default,,0,0,0,,Ұшақтар - әдемі арман
Dialogue: 0,0:12:14.01,0:12:16.09,Default,,0,0,0,,Дизайнерлер армандарға пішін береді.
Dialogue: 0,0:12:17.06,0:12:18.04,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:18.08,0:12:21.09,Default,,0,0,0,,Қош бол, тағы кездескенше
Dialogue: 0,0:12:36.00,0:12:38.08,Default,,0,0,0,,Джиро-сан, төсекте демал.
Dialogue: 0,0:12:40.01,0:12:41.09,Default,,0,0,0,,Сіз армандағансыз, солай емес пе?
Dialogue: 0,0:12:42.00,0:12:44.06,Default,,0,0,0,,Мен таң қалдым, өйткені ол қатты дауыспен жауап берді.
Dialogue: 0,0:12:45.07,0:12:48.01,Default,,0,0,0,,Анашым, мен ұшақ конструкторы боламын.
Dialogue: 0,0:12:48.06,0:12:51.01,Default,,0,0,0,,Иә, бұл тамаша түс.
Dialogue: 0,0:12:51.09,0:12:55.00,Default,,0,0,0,,Ұшудың әдемі арман екенін айтты.
Dialogue: 0,0:12:55.05,0:12:57.05,Default,,0,0,0,,Мен әдемі ұшақ жасағым келеді
Dialogue: 0,0:13:26.09,0:13:29.00,Default,,0,0,0,,Ол кісі, осында отырыңыз.
Dialogue: 0,0:13:29.01,0:13:30.01,Default,,0,0,0,,Аздап кешіріңіз.
Dialogue: 0,0:13:30.06,0:13:31.04,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:14:05.09,0:14:09.07,Default,,0,0,0,,Уау, жақсы сезіледі
Dialogue: 0,0:14:10.03,0:14:12.08,Default,,0,0,0,,Қызым, қалпағың ұшып кетеді.
Dialogue: 0,0:14:12.09,0:14:13.07,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:14:13.08,0:14:17.02,Default,,0,0,0,,(Пойыз дыбысы)
Dialogue: 0,0:14:22.08,0:14:23.09,Default,,0,0,0,,Қауіпті! (Жібек) Ханым!
Dialogue: 0,0:14:27.03,0:14:28.04,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:14:28.07,0:14:29.07,Default,,0,0,0,,Қауіпсіз
Dialogue: 0,0:14:30.06,0:14:31.07,Default,,0,0,0,,Керемет ойын
Dialogue: 0,0:14:32.09,0:14:33.08,Default,,0,0,0,,Рахмет
Dialogue: 0,0:14:34.04,0:14:35.07,Default,,0,0,0,,«Ле фон Слейв»
Dialogue: 0,0:14:38.04,0:14:40.00,Default,,0,0,0,,«Il fo tonte de vivre»
Dialogue: 0,0:15:04.06,0:15:08.02,Default,,0,0,0,,«Le von ce leve il fo tonte de vivre»
Dialogue: 0,0:15:09.01,0:15:12.06,Default,,0,0,0,,«Жел көтеріледі, біз өмір сүруге тырысуымыз керек».
Dialogue: 0,0:15:43.01,0:15:45.08,Default,,0,0,0,,(бөлу дыбысы)
Dialogue: 0,0:16:06.00,0:16:06.50,Default,,0,0,0,,Бұл жер сілкінісі.
Dialogue: 0,0:16:46.00,0:16:49.08,Default,,0,0,0,,(нәресте жылады)
Dialogue: 0,0:16:56.01,0:16:58.00,Default,,0,0,0,,«Пендлтон отбасының жалғыз қызы Элина үйленеді!»
Dialogue: 0,0:16:59.04,0:17:01.01,Default,,0,0,0,,Паровоз жарылады!
Dialogue: 0,0:17:11.06,0:17:13.04,Default,,0,0,0,,Не болды? (Нахоко) аяқтары
Dialogue: 0,0:17:13.07,0:17:14.06,Default,,0,0,0,,Маған көрсет
Dialogue: 0,0:17:15.02,0:17:16.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:17.00,0:17:18.00,Default,,0,0,0,,Itata…
Dialogue: 0,0:17:18.03,0:17:19.07,Default,,0,0,0,,Жібек қатты
Dialogue: 0,0:17:19.08,0:17:22.01,Default,,0,0,0,,Сүйектерім сынды. Мен мұнымен жүре алмаймын.
Dialogue: 0,0:17:22.07,0:17:24.06,Default,,0,0,0,,Ханым, пойыз жарылады.
Dialogue: 0,0:17:24.07,0:17:25.08,Default,,0,0,0,,Тез қаш...
Dialogue: 0,0:17:25.09,0:17:27.02,Default,,0,0,0,,Ақымақ нәрсе
Dialogue: 0,0:17:28.09,0:17:30.09,Default,,0,0,0,,Локомотивтер жарылмайды.
Dialogue: 0,0:17:33.04,0:17:34.05,Default,,0,0,0,,Магистраль
Dialogue: 0,0:17:41.01,0:17:43.03,Default,,0,0,0,,Демалыңыз және...
Dialogue: 0,0:17:43.03,0:17:44.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:48.06,0:17:51.02,Default,,0,0,0,,Мен жүре алмаймын. Үй қайда?
Dialogue: 0,0:17:51.03,0:17:52.02,Default,,0,0,0,,Бұл Уэно.
Dialogue: 0,0:17:52.03,0:17:53.04,Default,,0,0,0,,Сол жерге жіберейік.
Dialogue: 0,0:17:53.09,0:17:55.04,Default,,0,0,0,,(алыстағы соғу)
Dialogue: 0,0:18:06.04,0:18:08.00,Default,,0,0,0,,Өрт... (Джиро) Кеттік.
Dialogue: 0,0:18:23.08,0:18:25.02,Default,,0,0,0,,Сіздің багажыңыз ше?
Dialogue: 0,0:18:25.03,0:18:26.02,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:18:46.05,0:18:47.05,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:49.06,0:18:51.06,Default,,0,0,0,,Кешіріңіз, кешіріңіз (Джиро) Кешіріңіз, ауыртты ма?
Dialogue: 0,0:18:51.07,0:18:52.09,Default,,0,0,0,,Мықты
Dialogue: 0,0:19:03.03,0:19:04.04,Default,,0,0,0,,Кеттік
Dialogue: 0,0:19:30.07,0:19:32.06,Default,,0,0,0,,(шыңдаған дыбыс)
Dialogue: 0,0:19:40.08,0:19:41.06,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:42.05,0:19:43.04,Default,,0,0,0,,Апарып бара жатып тайып кеттім
Dialogue: 0,0:19:48.08,0:19:51.06,Default,,0,0,0,,Бұл менің анам тіккен жаңа көйлегім.
Dialogue: 0,0:19:51.09,0:19:53.02,Default,,0,0,0,,Аузыңды аш
Dialogue: 0,0:19:57.08,0:20:00.00,Default,,0,0,0,,Ұңғыманың суы төгілді. Сен ше?
Dialogue: 0,0:20:00.06,0:20:01.05,Default,,0,0,0,,Иә
Dialogue: 0,0:20:07.06,0:20:09.08,Default,,0,0,0,,Хирокоджиде от жоқ.
Dialogue: 0,0:20:09.09,0:20:12.02,Default,,0,0,0,,Мен Хонгодағы мектепке барамын. Сен ше?
Dialogue: 0,0:20:12.05,0:20:14.02,Default,,0,0,0,,Мен отбасыма қоңырау шаламын.
Dialogue: 0,0:20:15.04,0:20:16.06,Default,,0,0,0,,Бірге барайық.
Dialogue: 0,0:20:17.02,0:20:19.05,Default,,0,0,0,,Жібек мырза, мынаны беріңізші. (Жібек) Иә.
Dialogue: 0,0:20:20.00,0:20:22.00,Default,,0,0,0,,Мен міндетті түрде қайтамын, уайымдама
Dialogue: 0,0:20:22.05,0:20:24.02,Default,,0,0,0,,Иә (Джиро) Маған сандық алғым келеді, өтінемін.
Dialogue: 0,0:20:24.03,0:20:25.01,Default,,0,0,0,,Иә
Dialogue: 0,0:20:25.02,0:20:28.07,Default,,0,0,0,,(оттың дыбысы)
Dialogue: 0,0:20:53.04,0:20:57.00,Default,,0,0,0,,(Топтың шуы)
Dialogue: 0,0:21:17.04,0:21:18.03,Default,,0,0,0,,Ах
Dialogue: 0,0:21:20.09,0:21:22.07,Default,,0,0,0,,Маңызы бар деп саналатын бір куәгерлік көрсету бар
Dialogue: 0,0:21:45.08,0:21:47.02,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:21:47.03,0:21:48.07,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:21:49.01,0:21:50.05,Default,,0,0,0,,Тіпті бұл атау
Dialogue: 0,0:21:55.06,0:21:57.09,Default,,0,0,0,,Ол жақсы адам емес пе?
Dialogue: 0,0:22:16.04,0:22:18.07,Default,,0,0,0,,Джиро емес пе? Жаман күндерге оралды.
Dialogue: 0,0:22:19.00,0:22:20.05,Default,,0,0,0,,Аэронавигациялық зерттеу институты ше?
Dialogue: 0,0:22:20.07,0:22:22.09,Default,,0,0,0,,Мен білмеймін. Фукагава - от теңізі.
Dialogue: 0,0:22:25.03,0:22:27.04,Default,,0,0,0,,Қолымнан келгенше алдым.
Dialogue: 0,0:22:27.08,0:22:28.08,Default,,0,0,0,,Сізде темекі бар ма?
Dialogue: 0,0:22:30.08,0:22:34.01,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:22:34.05,0:22:37.03,Default,,0,0,0,,Бұл үлкен есік немесе басқа нәрсе.
Dialogue: 0,0:22:37.03,0:22:40.04,Default,,0,0,0,,Өрт тарайды, Токио жойылады.
Dialogue: 0,0:22:54.08,0:22:56.07,Default,,0,0,0,,Өйткені мен мұны шынымен жасадым.
Dialogue: 0,0:22:56.08,0:22:58.07,Default,,0,0,0,,Капрони мырзаның армандары үлкен.
Dialogue: 0,0:24:00.00,0:24:01.05,Default,,0,0,0,,Суретке түспеңіз!
Dialogue: 0,0:24:10.00,0:24:12.03,Default,,0,0,0,,Жел өзгерді, от осы жақтан келе жатыр.
Dialogue: 0,0:24:15.07,0:24:19.01,Default,,0,0,0,,Жел әлі соғып тұр ма, жапон баласы?
Dialogue: 0,0:24:19.08,0:24:22.04,Default,,0,0,0,,Иә, қатты жел соғып тұр.
Dialogue: 0,0:24:23.02,0:24:25.00,Default,,0,0,0,,Сонда өмір сүру керек
Dialogue: 0,0:24:25.01,0:24:26.02,Default,,0,0,0,,«Ле фон Слейв»
Dialogue: 0,0:24:26.06,0:24:28.08,Default,,0,0,0,,«Il fo tonte de vivre»
Dialogue: 0,0:25:24.07,0:25:27.07,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:25:28.07,0:25:29.08,Default,,0,0,0,,Джиро, барасың ба?
Dialogue: 0,0:25:29.09,0:25:30.07,Default,,0,0,0,,Иә
Dialogue: 0,0:25:33.02,0:25:35.09,Default,,0,0,0,,Бұл ескірген. Ештеңе мүлде өзгерген жоқ.
Dialogue: 0,0:25:36.08,0:25:38.04,Default,,0,0,0,,Жол сәл кеңейді.
Dialogue: 0,0:25:38.08,0:25:40.06,Default,,0,0,0,,Ұшатын заттар бірдей
Dialogue: 0,0:25:43.02,0:25:44.03,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:25:49.04,0:25:51.01,Default,,0,0,0,,Джиро: Тағы да скумбрия?
Dialogue: 0,0:25:51.02,0:25:52.06,Default,,0,0,0,,Скумбрия дәмді.
Dialogue: 0,0:25:52.08,0:25:55.07,Default,,0,0,0,,Бұл әдептілік. Бұл университеттегі дәрістермен бірдей.
Dialogue: 0,0:25:55.08,0:25:57.00,Default,,0,0,0,,Кими-чан, үстіне жұмыртқа сал.
Dialogue: 0,0:25:57.01,0:25:58.01,Default,,0,0,0,,Дегенмен, ол шын мәнінде аристократ. Өте сәнді киінген, иә?
Dialogue: 0,0:25:58.05,0:26:00.09,Default,,0,0,0,,Ұлы державалар дюралюминий дәуірінде.
Dialogue: 0,0:26:02.01,0:26:03.05,Default,,0,0,0,,Ет пен тофуды анда-санда жеп қойыңыз.
Dialogue: 0,0:26:04.03,0:26:06.04,Default,,0,0,0,,Біз 10 жылдан астам артта қалдық.
Dialogue: 0,0:26:08.00,0:26:09.01,Default,,0,0,0,,Не?
Dialogue: 0,0:26:09.05,0:26:10.04,Default,,0,0,0,,Бұл әдемі болар еді
Dialogue: 0,0:26:11.06,0:26:13.04,Default,,0,0,0,,Бұл керемет қисық деп ойламайсыз ба?
Dialogue: 0,0:26:13.09,0:26:16.05,Default,,0,0,0,,Сүйегін көру үшін скумбрия жейсің бе?
Dialogue: 0,0:26:17.05,0:26:20.03,Default,,0,0,0,,Жарайды, тез тамақтанып ал. Кофеге барайық.
Dialogue: 0,0:26:32.04,0:26:34.07,Default,,0,0,0,,Джиро мырза, сіз өте ынталысыз.
Dialogue: 0,0:26:34.08,0:26:36.03,Default,,0,0,0,,Скумбрия сүйектері
Dialogue: 0,0:26:36.09,0:26:39.00,Default,,0,0,0,,Хорикоши мырза қайтып келді ме?
Dialogue: 0,0:26:39.01,0:26:40.00,Default,,0,0,0,,Джиро
Dialogue: 0,0:26:40.06,0:26:42.06,Default,,0,0,0,,Хонджо Мен аукционды таптым!
Dialogue: 0,0:26:43.01,0:26:44.09,Default,,0,0,0,,Қанаттың қимасы скумбрия сүйегімен бірдей.
Dialogue: 0,0:26:45.00,0:26:47.00,Default,,0,0,0,,Бұл NACA стандарттарында.
Dialogue: 0,0:26:47.03,0:26:49.00,Default,,0,0,0,,Америкалықтар да скумбрия жей ме?
Dialogue: 0,0:26:49.01,0:26:51.00,Default,,0,0,0,,Джиро, сіз тұтынушысыз.
Dialogue: 0,0:26:51.06,0:26:52.03,Default,,0,0,0,,Иә
Dialogue: 0,0:26:52.04,0:26:55.09,Default,,0,0,0,,Бұрын жас қыз мұны Хорикоши мырзаға берген.
Dialogue: 0,0:26:56.01,0:26:58.05,Default,,0,0,0,,Сен жоқ болғандықтан, мен оны жаныңда ұстадым.
Dialogue: 0,0:26:58.06,0:27:00.08,Default,,0,0,0,,Сол үшін рахмет.
Dialogue: 0,0:27:02.07,0:27:05.03,Default,,0,0,0,,Джиро мырза, бұл Либенің сыйлығы ма?
Dialogue: 0,0:27:05.04,0:27:08.01,Default,,0,0,0,,Сізде темекі бар ма? Маған біреуін беріңіз.
Dialogue: 0,0:27:24.09,0:27:26.04,Default,,0,0,0,,Джиро-сан (Хонджо) Оны жайына қалдыр
Dialogue: 0,0:27:51.03,0:27:52.05,Default,,0,0,0,,Қолымды ұсташы, өтінемін. Әрқашан істейтіндей.
Dialogue: 0,0:27:52.06,0:27:53.07,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:27:53.07,0:27:56.01,Default,,0,0,0,,Мен тұтынушыны бөлмесіне апардым.
Dialogue: 0,0:27:56.02,0:27:57.07,Default,,0,0,0,,Бұл әйел.
Dialogue: 0,0:27:58.00,0:27:59.04,Default,,0,0,0,,Е... Иә.
Dialogue: 0,0:28:09.01,0:28:10.04,Default,,0,0,0,,Нии-ниидің ақымақ
Dialogue: 0,0:28:11.05,0:28:12.09,Default,,0,0,0,,Кайо... Кешіріңіз.
Dialogue: 0,0:28:14.00,0:28:15.04,Default,,0,0,0,,Мен мүлдем ұмытып кеттім
Dialogue: 0,0:28:15.05,0:28:16.05,Default,,0,0,0,,Қазірдің өзінде...
Dialogue: 0,0:28:17.02,0:28:19.05,Default,,0,0,0,,Сенің анаң ше? (Каё) Ағаның орны
Dialogue: 0,0:28:19.07,0:28:20.06,Default,,0,0,0,,Сіз түнемейсіз бе?
Dialogue: 0,0:28:20.09,0:28:22.03,Default,,0,0,0,,Бір түнге ғана
Dialogue: 0,0:28:23.01,0:28:26.07,Default,,0,0,0,,Кайо Сен есейдің, әдемі болып кеттің.
Dialogue: 0,0:28:27.02,0:28:31.02,Default,,0,0,0,,Нии-нии қайтып оралмағандықтан жүрексіз адам.
Dialogue: 0,0:28:35.00,0:28:37.08,Default,,0,0,0,,А, өте кеш.
Dialogue: 0,0:28:37.09,0:28:40.02,Default,,0,0,0,,Мен оны сізге жіберемін. Мен кешірім сұраймын.
Dialogue: 0,0:28:40.08,0:28:42.03,Default,,0,0,0,,Бір сен бумен барайық
Dialogue: 0,0:28:44.06,0:28:47.02,Default,,0,0,0,,Ол кісі Нии-ниді ұнатса керек.
Dialogue: 0,0:28:47.03,0:28:49.05,Default,,0,0,0,,Жоқ... екі жыл бұрын болған.
Dialogue: 0,0:28:50.01,0:28:52.06,Default,,0,0,0,,Осыдан кейін менің үйіме бармадың ба?
Dialogue: 0,0:28:52.08,0:28:55.01,Default,,0,0,0,,Мен өрт басылған соң бір рет бардым.
Dialogue: 0,0:29:07.04,0:29:09.01,Default,,0,0,0,,Өрт сол аллеяда тоқтаған сияқты.
Dialogue: 0,0:29:09.02,0:29:10.01,Default,,0,0,0,,Иә
Dialogue: 0,0:29:10.05,0:29:11.05,Default,,0,0,0,,Қараңызшы, мінеки.
Dialogue: 0,0:29:25.03,0:29:26.03,Default,,0,0,0,,Суық емес пе?
Dialogue: 0,0:29:26.04,0:29:27.03,Default,,0,0,0,,Мен жақсымын
Dialogue: 0,0:29:27.04,0:29:30.01,Default,,0,0,0,,Мен Токионың мұншалықты қалпына келетінін ешқашан күтпедім.
Dialogue: 0,0:29:34.09,0:29:37.02,Default,,0,0,0,,Мен Нии-нидің бөлмесінде тұруым керек пе?
Dialogue: 0,0:29:37.09,0:29:40.06,Default,,0,0,0,,Әкем Токиоға жалғыз баруға рұқсат бермейді.
Dialogue: 0,0:29:41.00,0:29:44.09,Default,,0,0,0,,Сол жерде... Мен оған дейін Нагояда болатын шығармын.
Dialogue: 0,0:29:44.09,0:29:46.07,Default,,0,0,0,,Ұшақ компаниясы? (Джиро) Иә.
Dialogue: 0,0:29:47.03,0:29:48.08,Default,,0,0,0,,Жақсы адам...
Dialogue: 0,0:29:49.03,0:29:52.04,Default,,0,0,0,,Мен университетке түсіп, медицина саласын оқығым келеді.
Dialogue: 0,0:29:53.02,0:29:55.09,Default,,0,0,0,,Мүмкін дәрігер немесе Кайо жақсы болар еді.
Dialogue: 0,0:29:56.06,0:29:57.09,Default,,0,0,0,,Иә, солай деп ойлаймын.
Dialogue: 0,0:29:58.04,0:30:01.02,Default,,0,0,0,,Жаңа жылда үйге барамын, сондықтан әкеме айтамын.
Dialogue: 0,0:30:01.03,0:30:03.04,Default,,0,0,0,,Мен бақыттымын, өтінемін.
Dialogue: 0,0:30:36.02,0:30:38.08,Default,,0,0,0,,Мен қай жерде жаттығып жүргенімді ойлайсың?
Dialogue: 0,0:31:09.09,0:31:10.07,Default,,0,0,0,,Джиро!
Dialogue: 0,0:31:13.05,0:31:14.07,Default,,0,0,0,,Йо (Джиро) Сәлем
Dialogue: 0,0:31:14.08,0:31:16.03,Default,,0,0,0,,Келдің (Джиро) Иә, келдің.
Dialogue: 0,0:31:16.04,0:31:18.07,Default,,0,0,0,,Ақыры келді (Джиро) Иә, ақыры келді.
Dialogue: 0,0:31:37.03,0:31:40.06,Default,,0,0,0,,Олар қалаға жұмыс іздеп келетіндер ғой.
Dialogue: 0,0:31:40.07,0:31:42.01,Default,,0,0,0,,Мен көп жүрдім.
Dialogue: 0,0:31:42.04,0:31:44.00,Default,,0,0,0,,Мен лагерьде жүргенде келдім.
Dialogue: 0,0:31:45.05,0:31:48.01,Default,,0,0,0,,Асығыңыз, асығыңыз, асығыңыз! (Әйел) Бұл аздап қауіпті.
Dialogue: 0,0:31:48.09,0:31:52.01,Default,,0,0,0,,Тағы да, бұл жолы Камехачи банкі.
Dialogue: 0,0:31:52.07,0:31:54.07,Default,,0,0,0,,(сыбдырлаған адамдардың дауысы)
Dialogue: 0,0:31:54.08,0:31:57.00,Default,,0,0,0,,Маған ақшамды қайтарыңыз! Оны ашыңыз!
Dialogue: 0,0:31:57.07,0:31:59.01,Default,,0,0,0,,Орнату? (Хонджо) Дұрыс.
Dialogue: 0,0:31:59.07,0:32:01.07,Default,,0,0,0,,өсек-аяң болды.
Dialogue: 0,0:32:03.00,0:32:04.05,Default,,0,0,0,,Әлем рецессияда.
Dialogue: 0,0:32:04.09,0:32:07.01,Default,,0,0,0,,Біз жұмыс істейтін компания да рецессияда.
Dialogue: 0,0:32:26.01,0:32:29.04,Default,,0,0,0,,Осы қарбалас уақытта бүгін қандай күн деп ойлайсыңдар?
Dialogue: 0,0:32:30.01,0:32:32.05,Default,,0,0,0,,Маған сәуірдің кез келген уақыты жақсы екенін айтты.
Dialogue: 0,0:32:32.07,0:32:34.06,Default,,0,0,0,,Солай болса да Наурызда бетін көрсетеді.
Dialogue: 0,0:32:34.07,0:32:35.07,Default,,0,0,0,,Иә
Dialogue: 0,0:32:35.09,0:32:38.00,Default,,0,0,0,,Бұл асығыс. Нақты өндіріске бірден кірісейік.
Dialogue: 0,0:32:38.01,0:32:39.03,Default,,0,0,0,,Иә
Dialogue: 0,0:32:39.04,0:32:42.00,Default,,0,0,0,,Бұл қанаттың негізгі қондырмасы. Менде барлық деректер бар.
Dialogue: 0,0:32:42.01,0:32:43.09,Default,,0,0,0,,Иә (Курокава) Мен оны бірден сызып аламын.
Dialogue: 0,0:32:44.00,0:32:46.02,Default,,0,0,0,,Инженерлік бөлімде уақыт таусылып бара жатқан сияқты (Джиро) Иә.
Dialogue: 0,0:32:50.08,0:32:51.06,Default,,0,0,0,,Міне, осы жерде.
Dialogue: 0,0:32:53.07,0:32:55.07,Default,,0,0,0,,Әй, сәл күте тұрыңыз.
Dialogue: 0,0:32:55.08,0:32:56.08,Default,,0,0,0,,Мұнда кел
Dialogue: 0,0:33:04.09,0:33:06.04,Default,,0,0,0,,Бұл сіздің үстеліңіз.
Dialogue: 0,0:33:06.05,0:33:08.07,Default,,0,0,0,,Мен оны импорттауға тырыстым, бірақ оны ешкім пайдаланбайды.
Dialogue: 0,0:33:08.08,0:33:10.00,Default,,0,0,0,,Оны пайдаланып көріңіз (Джиро) Иә.
Dialogue: 0,0:33:10.01,0:33:12.05,Default,,0,0,0,,Деректер осында, қалпақ сонда (Джиро) Иә.
Dialogue: 0,0:33:12.06,0:33:15.06,Default,,0,0,0,,Ханымдар мен мырзалар, Жаңадан келген адамды таныстыру
Dialogue: 0,0:33:16.06,0:33:19.06,Default,,0,0,0,,Біздің Хаябуса тобына қауесет данышпан келді.
Dialogue: 0,0:33:20.04,0:33:21.03,Default,,0,0,0,,Сәлемдесу
Dialogue: 0,0:33:21.04,0:33:23.05,Default,,0,0,0,,Мен Хорикошимін. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:33:23.05,0:33:25.05,Default,,0,0,0,,Жұмысқа кіріс (Джиро) Иә.
Dialogue: 0,0:35:02.08,0:35:04.02,Default,,0,0,0,,Джиро Эй
Dialogue: 0,0:35:05.07,0:35:07.01,Default,,0,0,0,,Мешида кеттік
Dialogue: 0,0:35:07.09,0:35:08.08,Default,,0,0,0,,О
Dialogue: 0,0:35:09.04,0:35:10.07,Default,,0,0,0,,Құрастыру зауыты?
Dialogue: 0,0:35:10.08,0:35:12.09,Default,,0,0,0,,Иә, мен бір қарап алғым келеді.
Dialogue: 0,0:35:13.08,0:35:15.06,Default,,0,0,0,,Бұл, әрине, біртүрлі.
Dialogue: 0,0:35:15.07,0:35:19.00,Default,,0,0,0,,Арматура бүгін ғана келген жаңадан келген адамға дөрекі.
Dialogue: 0,0:35:19.04,0:35:20.00,Default,,0,0,0,,Екі.
Dialogue: 0,0:35:20.09,0:35:24.00,Default,,0,0,0,,Сәлеметсіз бе, мен сізден бір жақсылық сұрайын деп едім.
Dialogue: 0,0:35:24.02,0:35:26.07,Default,,0,0,0,,Уау, сен ұзақ жолдан өттің.
Dialogue: 0,0:35:26.09,0:35:29.09,Default,,0,0,0,,Кешіріңіз, үзіліс уақыты.
Dialogue: 0,0:35:30.02,0:35:33.08,Default,,0,0,0,,Жоқ, жас дизайнерлердің келгеніне қуаныштымын.
Dialogue: 0,0:35:34.06,0:35:37.04,Default,,0,0,0,,Хонджо: Орнату жабдығы әлдеқашан жасалған.
Dialogue: 0,0:35:38.00,0:35:41.03,Default,,0,0,0,,Өйткені, олар жаңадан келген адамға мұны істеуге мүмкіндік бермейді.
Dialogue: 0,0:35:41.04,0:35:43.02,Default,,0,0,0,,Қайсысы жақсы, сіздікі?
Dialogue: 0,0:35:43.04,0:35:45.07,Default,,0,0,0,,Бұл Курокава-санның жаңа қызметкерді оқыту тәсілі.
Dialogue: 0,0:35:46.06,0:35:49.02,Default,,0,0,0,,Хонджо, кел де осы жерге қара.
Dialogue: 0,0:35:49.07,0:35:51.03,Default,,0,0,0,,Маған өз пікіріңізді айтыңыз
Dialogue: 0,0:35:57.03,0:35:59.08,Default,,0,0,0,,Сіз қалай ойлайсыз? (Хонджо) Бұл қатты дизайн.
Dialogue: 0,0:35:59.09,0:36:01.01,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:36:01.02,0:36:03.02,Default,,0,0,0,,Мен ойлағандай
Dialogue: 0,0:36:03.03,0:36:04.08,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:36:05.04,0:36:07.04,Default,,0,0,0,,Бригадир, үзіліс аяқталды.
Dialogue: 0,0:36:07.05,0:36:08.07,Default,,0,0,0,,Тыныш болыңыз
Dialogue: 0,0:36:09.03,0:36:12.03,Default,,0,0,0,,Қызық! Ұшақтар қызық
Dialogue: 0,0:36:12.04,0:36:14.02,Default,,0,0,0,,Қызық, бірақ кешігіп қалдыңыз.
Dialogue: 0,0:36:23.06,0:36:24.06,Default,,0,0,0,,Бұл Хаттори.
Dialogue: 0,0:36:29.01,0:36:31.01,Default,,0,0,0,,Бұл дизайн бөлімінің бастығы Хаттори.
Dialogue: 0,0:36:31.05,0:36:33.02,Default,,0,0,0,,Бұл сіздің бірінші жұмысыңыз ба?
Dialogue: 0,0:36:33.03,0:36:35.03,Default,,0,0,0,,Hayabusa орнату кронштейні
Dialogue: 0,0:36:35.06,0:36:36.07,Default,,0,0,0,,Бұл басқаша.
Dialogue: 0,0:36:36.08,0:36:38.09,Default,,0,0,0,,Не? (Хаттори) Түсіндіріңізші.
Dialogue: 0,0:36:39.00,0:36:41.02,Default,,0,0,0,,Иә Металл арматураның қаттылығын арттыру үшін
Dialogue: 0,0:36:41.03,0:36:42.07,Default,,0,0,0,,Болат жапырақты серіппелерді қолданыңыз
Dialogue: 0,0:36:43.06,0:36:46.01,Default,,0,0,0,,Сымды кеңейту және қысқарту арқылы қысымды сіңіру.
Dialogue: 0,0:36:46.02,0:36:48.02,Default,,0,0,0,,Сымды тірек арқылы өткізіңіз
Dialogue: 0,0:36:48.02,0:36:50.02,Default,,0,0,0,,Торс қаңқасына бекітілген
Dialogue: 0,0:36:50.07,0:36:52.08,Default,,0,0,0,,Енді негізгі қанат жақтауының өзін қарастырайық...
Dialogue: 0,0:36:52.09,0:36:53.09,Default,,0,0,0,,Өзгерту қажет
Dialogue: 0,0:36:54.04,0:36:56.09,Default,,0,0,0,,Дұрыс, мен оны әлі есептеген жоқпын.
Dialogue: 0,0:36:57.04,0:36:58.08,Default,,0,0,0,,Уақытты босқа кетіру
Dialogue: 0,0:36:58.09,0:37:01.04,Default,,0,0,0,,Мен берген тапсырма не болды?
Dialogue: 0,0:37:01.05,0:37:02.06,Default,,0,0,0,,Орындалды
Dialogue: 0,0:37:07.07,0:37:11.01,Default,,0,0,0,,Өтінемін, таза сызық сызбаңыз.
Dialogue: 0,0:37:13.00,0:37:14.01,Default,,0,0,0,,Керемет
Dialogue: 0,0:37:14.08,0:37:16.05,Default,,0,0,0,,Дайын өнімді дереу қоқысқа тастаңыз.
Dialogue: 0,0:37:16.06,0:37:17.05,Default,,0,0,0,,Иә
Dialogue: 0,0:37:20.01,0:37:22.00,Default,,0,0,0,,Эй, мен үйге бара жатырмын.
Dialogue: 0,0:37:22.01,0:37:23.01,Default,,0,0,0,,Мен де үйге барамын
Dialogue: 0,0:37:23.04,0:37:26.02,Default,,0,0,0,,Жарайды, Курокава мырза, үй тапсырмасы қандай?
Dialogue: 0,0:37:26.03,0:37:27.04,Default,,0,0,0,,Қазір аяқталды
Dialogue: 0,0:37:32.04,0:37:33.05,Default,,0,0,0,,Сиыр бар
Dialogue: 0,0:37:33.09,0:37:35.07,Default,,0,0,0,,Жаңа өнімді аэродромға тасымалдау.
Dialogue: 0,0:37:36.05,0:37:38.07,Default,,0,0,0,,3км/сағ жылдамдықпен екі күн өтті.
Dialogue: 0,0:37:38.08,0:37:40.05,Default,,0,0,0,,Бұл өте артта қалды.
Dialogue: 0,0:37:40.08,0:37:42.02,Default,,0,0,0,,Бірақ мен сиырларды жақсы көремін.
Dialogue: 0,0:38:47.08,0:38:48.08,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:38:50.02,0:38:51.01,Default,,0,0,0,,Ол келе жатыр
Dialogue: 0,0:38:54.00,0:38:55.05,Default,,0,0,0,,Өлшеу ОК
Dialogue: 0,0:38:58.00,0:38:59.00,Default,,0,0,0,,Тек бір сәттек ойыңмен одан көшіп кету...
Dialogue: 0,0:39:01.08,0:39:03.00,Default,,0,0,0,,Ах!
Dialogue: 0,0:39:04.01,0:39:05.01,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:39:15.00,0:39:18.07,Default,,0,0,0,,Сіз оны алдыңыз ба? 13,3 секунд 270 км/сағ
Dialogue: 0,0:39:18.08,0:39:21.06,Default,,0,0,0,,Бұл баяу, мен тағы 15 км шығуым керек.
Dialogue: 0,0:39:21.06,0:39:24.06,Default,,0,0,0,,Биіктік тым төмен және қозғалтқыш жұмыс істемеді.
Dialogue: 0,0:39:25.02,0:39:26.01,Default,,0,0,0,,Эй
Dialogue: 0,0:39:26.07,0:39:28.01,Default,,0,0,0,,Курокава-кун (Курокава) Иә.
Dialogue: 0,0:39:28.02,0:39:30.01,Default,,0,0,0,,Армия қызметкерлері келе жатыр.
Dialogue: 0,0:39:30.02,0:39:31.02,Default,,0,0,0,,Иә
Dialogue: 0,0:39:31.02,0:39:33.02,Default,,0,0,0,,Сәлеметсіз бе, құтты болсын (В солдат) Ерлік
Dialogue: 0,0:39:33.03,0:39:35.07,Default,,0,0,0,,Mitsubishi-ден күткендей, сіз ұйымдастыруға өте шеберсіз.
Dialogue: 0,0:39:35.08,0:39:37.06,Default,,0,0,0,,Вахахахаха
Dialogue: 0,0:39:39.04,0:39:41.06,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:39:54.00,0:39:56.09,Default,,0,0,0,,Күшті түсу. 400 км/сағ жылдамдыққа жетуге тырысуда.
Dialogue: 0,0:40:21.01,0:40:22.00,Default,,0,0,0,,Парашют!
Dialogue: 0,0:40:22.00,0:40:23.01,Default,,0,0,0,,Бұл көлік.
Dialogue: 0,0:40:38.06,0:40:39.05,Default,,0,0,0,,Курокава мырза
Dialogue: 0,0:40:39.09,0:40:43.03,Default,,0,0,0,,Ұшақты қалпына келтірмес бұрын ауа райының қалпына келуін күту туралы шешім қабылданды.
Dialogue: 0,0:40:43.07,0:40:45.05,Default,,0,0,0,,Ұшқыш туралы не деуге болады? (Джиро) Жарайды.
Dialogue: 0,0:40:45.08,0:40:46.07,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:40:47.08,0:40:51.01,Default,,0,0,0,,Курокава мырза, қайтайық. Артқа оралып, 2 блокты құрастырайық.
Dialogue: 0,0:40:52.02,0:40:54.00,Default,,0,0,0,,Ауаның ыдырауына сіз себепкерсіз бе?
Dialogue: 0,0:40:54.01,0:40:55.02,Default,,0,0,0,,Бұл монтаждау кронштейні деп ойлайсыз ба?
Dialogue: 0,0:40:55.09,0:40:59.02,Default,,0,0,0,,Жоқ Мәселе тереңірек және кеңірек.
Dialogue: 0,0:40:59.02,0:41:00.07,Default,,0,0,0,,Менің ойымша, бұл алыс
Dialogue: 0,0:41:01.02,0:41:03.07,Default,,0,0,0,,Бүгін маған қатты әсер етті.
Dialogue: 0,0:41:04.03,0:41:07.02,Default,,0,0,0,,Алдымнан шексіз жол ашылғандай әсер қалдырады.
Dialogue: 0,0:41:09.00,0:41:10.07,Default,,0,0,0,,Хаябусада 2-бөлім жоқ
Dialogue: 0,0:41:11.02,0:41:14.02,Default,,0,0,0,,Армия жойғыш ұшақтарды басқа компания шығарады деп шешіп қойған.
Dialogue: 0,0:41:16.03,0:41:19.02,Default,,0,0,0,,Бүгін мұны өзгертуге бір реттік мүмкіндік болды.
Dialogue: 0,0:41:20.02,0:41:22.00,Default,,0,0,0,,Біздің компания Юнкерс, Германиядан.
Dialogue: 0,0:41:22.01,0:41:24.00,Default,,0,0,0,,Бомбардировка жасау керек.
Dialogue: 0,0:41:24.06,0:41:26.03,Default,,0,0,0,,Біраз уақытқа дейін шағын ұшақ болмайды.
Dialogue: 0,0:41:28.09,0:41:32.03,Default,,0,0,0,,Бұл менің Германияға бару мүмкіндігім. Мен сізге кеңес бердім.
Dialogue: 0,0:41:48.02,0:41:50.07,Default,,0,0,0,,(Тормоз дыбысы)
Dialogue: 0,0:42:08.03,0:42:10.03,Default,,0,0,0,,Сіз әлі де жақсысыз ба? (Дүкенші) Әй, қош келдіңіз.
Dialogue: 0,0:42:10.09,0:42:12.09,Default,,0,0,0,,Бүгін түн өте кеш.
Dialogue: 0,0:42:13.04,0:42:14.08,Default,,0,0,0,,Екі сібірді қалдыр.
Dialogue: 0,0:42:14.09,0:42:15.09,Default,,0,0,0,,Иә.
Dialogue: 0,0:42:23.02,0:42:24.02,Default,,0,0,0,,Эй, күте тұрыңыз.
Dialogue: 0,0:42:25.04,0:42:26.06,Default,,0,0,0,,Ал балалар ше?
Dialogue: 0,0:42:27.05,0:42:29.08,Default,,0,0,0,,Ата-анам үйге кеш келді.
Dialogue: 0,0:42:29.09,0:42:32.01,Default,,0,0,0,,Мен үнемі осылай күтемін.
Dialogue: 0,0:42:32.04,0:42:35.00,Default,,0,0,0,,Мен де дүкенімді жабуға қиналамын.
Dialogue: 0,0:42:35.00,0:42:36.09,Default,,0,0,0,,Кешіріңіз. Ой, ей!
Dialogue: 0,0:42:37.00,0:42:38.00,Default,,0,0,0,,Сәлем Майдо
Dialogue: 0,0:42:45.04,0:42:48.04,Default,,0,0,0,,Балалар, сендерде проблема жоқ па? мынаны же
Dialogue: 0,0:42:49.04,0:42:51.04,Default,,0,0,0,,Бұл Сібір, мен оны сол жердегі дүкеннен жаңа ғана сатып алдым.
Dialogue: 0,0:43:04.02,0:43:05.07,Default,,0,0,0,,Енді алыңыз.
Dialogue: 0,0:43:06.05,0:43:07.05,Default,,0,0,0,,Кеттік! (аға) А...
Dialogue: 0,0:43:24.01,0:43:25.00,Default,,0,0,0,,Ирука
Dialogue: 0,0:43:27.06,0:43:31.00,Default,,0,0,0,,Хаябуса: Бұл ұят. Әзірлеу тоқтатылды ма?
Dialogue: 0,0:43:32.09,0:43:35.08,Default,,0,0,0,,Сібір оғаш нәрселерді жейді.
Dialogue: 0,0:43:47.00,0:43:48.04,Default,,0,0,0,,Бұл екіжүзділік
Dialogue: 0,0:43:49.02,0:43:52.06,Default,,0,0,0,,Қыз күлімдеп, рахмет айтады деп ойладың ба?
Dialogue: 0,0:43:53.04,0:43:54.03,Default,,0,0,0,,Жоқ
Dialogue: 0,0:43:55.03,0:43:57.09,Default,,0,0,0,,Жоқ, мүмкін.
Dialogue: 0,0:43:59.00,0:44:01.01,Default,,0,0,0,,Баланың қарны ашса
Dialogue: 0,0:44:01.02,0:44:03.08,Default,,0,0,0,,Бір ғана осы аллеяда ондаған адам бар.
Dialogue: 0,0:44:04.08,0:44:07.04,Default,,0,0,0,,Сұңқарға арналған алтын тіреуіштің бір бөлігі
Dialogue: 0,0:44:07.05,0:44:09.07,Default,,0,0,0,,Ол қыздың үйінде бір ай тұруға болады.
Dialogue: 0,0:44:10.07,0:44:13.01,Default,,0,0,0,,Бұл ел неге сонша кедей?
Dialogue: 0,0:44:13.08,0:44:18.09,Default,,0,0,0,,Джиро, осы технологияны енгізгені үшін Юнкерске қанша ақша төлейтінімізді білесің бе?
Dialogue: 0,0:44:19.00,0:44:21.00,Default,,0,0,0,,Бүкіл Жапониядағы балаларға арналған сіңір және Сібір
Dialogue: 0,0:44:21.01,0:44:23.06,Default,,0,0,0,,Күн сайын тамақтандырсаңыз да, бұл сізге өзгеретін сома.
Dialogue: 0,0:44:24.03,0:44:25.03,Default,,0,0,0,,Дегенмен, мен-
Dialogue: 0,0:44:25.04,0:44:27.07,Default,,0,0,0,,Маған берілген мүмкіндікті босқа өткізбеймін.
Dialogue: 0,0:44:28.06,0:44:29.07,Default,,0,0,0,,Мен де Хонджоға бара аламын ба?
Dialogue: 0,0:44:30.01,0:44:31.04,Default,,0,0,0,,Бүгін шешім қабылданды
Dialogue: 0,0:44:31.05,0:44:33.00,Default,,0,0,0,,Ұф… Хмм… Уу…
Dialogue: 0,0:44:33.07,0:44:36.01,Default,,0,0,0,,Кедей елдер ұшақтарға ие болғысы келеді
Dialogue: 0,0:44:36.05,0:44:39.07,Default,,0,0,0,,Сонымен біз ұшақтар жасай аламыз. Бұл қайшылық.
Dialogue: 0,0:44:41.02,0:44:44.03,Default,,0,0,0,,Мен ертең Токиоға әйел алу үшін барамын.
Dialogue: 0,0:44:44.06,0:44:45.06,Default,,0,0,0,,Әйелі?
Dialogue: 0,0:44:45.09,0:44:48.09,Default,,0,0,0,,Байыпты жұмыс істеу үшін отбасын құру
Dialogue: 0,0:44:49.00,0:44:50.03,Default,,0,0,0,,Бұл да қайшылық
Dialogue: 0,0:44:51.01,0:44:52.01,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:44:59.08,0:45:02.03,Default,,0,0,0,,«Пендлтон отбасының жалғыз қызы Элина үйленеді!»
Dialogue: 0,0:45:27.05,0:45:29.02,Default,,0,0,0,,Немістер сараң
Dialogue: 0,0:45:29.03,0:45:32.06,Default,,0,0,0,,Жол бойы қонаққа келсем де, маған зауытқа кіруге тыйым салынғанын айтты.
Dialogue: 0,0:45:33.03,0:45:34.06,Default,,0,0,0,,Сиыр жоқ.
Dialogue: 0,0:45:35.01,0:45:37.02,Default,,0,0,0,,Өйткені әуежай зауыттың жанында.
Dialogue: 0,0:45:37.03,0:45:39.00,Default,,0,0,0,,Ол кең.
Dialogue: 0,0:46:01.06,0:46:04.05,Default,,0,0,0,,G38 емес пе? Мен осындай нәрсені сатып алуым керек пе?
Dialogue: 0,0:46:04.06,0:46:07.07,Default,,0,0,0,,бомбалаушы нұсқасы Жапонияда жасалады. Бұл өте құпия.
Dialogue: 0,0:46:08.03,0:46:11.02,Default,,0,0,0,,Әскер кіммен соғыспақшы?
Dialogue: 0,0:46:11.06,0:46:13.08,Default,,0,0,0,,Мүмкін Америка.
Dialogue: 0,0:46:16.03,0:46:18.05,Default,,0,0,0,,Сонда да жақсы орындалды.
Dialogue: 0,0:46:19.00,0:46:20.03,Default,,0,0,0,,Керемет
Dialogue: 0,0:46:20.09,0:46:24.02,Default,,0,0,0,,Оны бомбалаушы жасау ұят, өйткені оның қанатында бақылау бөлмесі бар.
Dialogue: 0,0:46:25.01,0:46:29.03,Default,,0,0,0,,Неліктен мұны металл өңдеу әдістерін үйрену мүмкіндігі ретінде қабылдамасқа?
Dialogue: 0,0:46:33.07,0:46:36.02,Default,,0,0,0,,Не, ішіндегісін көрсетпейсің бе?
Dialogue: 0,0:47:04.09,0:47:06.02,Default,,0,0,0,,Әдемі...
Dialogue: 0,0:47:10.07,0:47:12.08,Default,,0,0,0,,〈Сенің орның сол жақта. Тез қайт.〉
Dialogue: 0,0:47:12.09,0:47:15.01,Default,,0,0,0,,Ол кісіге тиіспе.
Dialogue: 0,0:47:15.07,0:47:18.01,Default,,0,0,0,,Немістер тұтынушыларға осылай қарай ма?
Dialogue: 0,0:47:18.02,0:47:20.01,Default,,0,0,0,,Жапондықтар тез еліктейді
Dialogue: 0,0:47:20.02,0:47:22.05,Default,,0,0,0,,Технология - біздің неміс меншігі.
Dialogue: 0,0:47:22.05,0:47:23.08,Default,,0,0,0,,Бастық болмаңыз
Dialogue: 0,0:47:23.09,0:47:26.03,Default,,0,0,0,,Жапонияда мұндай ескі машиналар көп.
Dialogue: 0,0:47:26.04,0:47:27.05,Default,,0,0,0,,Хонджо, жеткілікті.
Dialogue: 0,0:47:28.04,0:47:31.08,Default,,0,0,0,,Біз бұл зауытқа техникалық ынтымақтастық үшін бардық.
Dialogue: 0,0:47:32.09,0:47:35.01,Default,,0,0,0,,Біз бұл ангарға кірдік
Dialogue: 0,0:47:35.02,0:47:37.06,Default,,0,0,0,,Бұл шартқа негізделген заңды әрекет.
Dialogue: 0,0:47:37.07,0:47:39.04,Default,,0,0,0,,Сіздің бастығыңыз - біз
Dialogue: 0,0:47:39.05,0:47:41.00,Default,,0,0,0,,Бұл ұшаққа жақындамаңыз.
Dialogue: 0,0:47:41.01,0:47:42.04,Default,,0,0,0,,Нұсқауларды бермеу
Dialogue: 0,0:47:43.04,0:47:46.04,Default,,0,0,0,,Сіздің миссияңызға адал болатыныңызға күмәнім жоқ.
Dialogue: 0,0:47:46.05,0:47:49.04,Default,,0,0,0,,Алайда олар тең келісуші тараптар болып табылады.
Dialogue: 0,0:47:49.05,0:47:51.06,Default,,0,0,0,,Бізді қорлауға рұқсат етілмейді.
Dialogue: 0,0:47:52.05,0:47:56.02,Default,,0,0,0,,Бізге жапондықтарды қыдыртпау бұйырылды.
Dialogue: 0,0:47:56.02,0:47:57.05,Default,,0,0,0,,〈Ой-кун〉
Dialogue: 0,0:48:14.06,0:48:16.01,Default,,0,0,0,,Бұл доктор Юнкерс.
Dialogue: 0,0:48:16.02,0:48:18.00,Default,,0,0,0,,Иә, бұл тамаша.
Dialogue: 0,0:48:20.07,0:48:23.02,Default,,0,0,0,,Дәрігердің рұқсаты берілді. Мен саған осы жерді көрсетемін.
Dialogue: 0,0:48:36.06,0:48:38.08,Default,,0,0,0,,Мен оны мінемін деп ешқашан ойламаппын.
Dialogue: 0,0:48:38.09,0:48:40.07,Default,,0,0,0,,Мен күткеннен де көп діріл бар.
Dialogue: 0,0:48:42.00,0:48:43.07,Default,,0,0,0,,Үлкендер көңілді
Dialogue: 0,0:48:44.05,0:48:47.02,Default,,0,0,0,,Балалар, әскерді ауыстырыңдар.
Dialogue: 0,0:48:47.03,0:48:48.05,Default,,0,0,0,,Иә
Dialogue: 0,0:48:52.00,0:48:53.02,Default,,0,0,0,,Қазір өзгертіңіз
Dialogue: 0,0:48:53.06,0:48:56.01,Default,,0,0,0,,Керемет емес пе?
Dialogue: 0,0:48:56.02,0:48:57.09,Default,,0,0,0,,(механикалық дыбыс)
Dialogue: 0,0:48:58.00,0:49:00.05,Default,,0,0,0,,Әй, бұл қанаттағы өткел.
Dialogue: 0,0:49:02.08,0:49:04.00,Default,,0,0,0,,Бұл таңқаларлық
Dialogue: 0,0:49:06.04,0:49:08.00,Default,,0,0,0,,Бұл зауытта болғандай.
Dialogue: 0,0:49:09.06,0:49:12.07,Default,,0,0,0,,〈Бұл кім! Мұнда кіруге тыйым салынады! 〉
Dialogue: 0,0:49:12.08,0:49:13.09,Default,,0,0,0,,Гутентаг
Dialogue: 0,0:49:13.09,0:49:16.05,Default,,0,0,0,,Доктор Юнкерстен экскурсияға рұқсат алынды.
Dialogue: 0,0:49:16.06,0:49:18.09,Default,,0,0,0,,Маған жұмыс орныңызды көрсетіңіз
Dialogue: 0,0:49:18.09,0:49:20.04,Default,,0,0,0,,Бұл инженердің лауазымы.
Dialogue: 0,0:49:21.03,0:49:22.09,Default,,0,0,0,,Бұл керемет ұшақ.
Dialogue: 0,0:49:25.00,0:49:27.04,Default,,0,0,0,,Жапондар Бұл жерден әріге бармаңыз.
Dialogue: 0,0:49:27.08,0:49:29.00,Default,,0,0,0,,〈Өмірге енді қауіп төніп тұр〉
Dialogue: 0,0:49:29.07,0:49:31.03,Default,,0,0,0,,Түсіндім, аға.
Dialogue: 0,0:49:31.09,0:49:34.05,Default,,0,0,0,,Бұл таңқаларлық (Джиро) Иә, бұл керемет.
Dialogue: 0,0:49:35.04,0:49:37.09,Default,,0,0,0,,Неміс өнеркәсіптік технологиясының шедеврі
Dialogue: 0,0:50:09.05,0:50:11.02,Default,,0,0,0,,Доктор Юнкерс тамаша, бірақ
Dialogue: 0,0:50:11.03,0:50:13.05,Default,,0,0,0,,Юнкерстің адамдары сараң.
Dialogue: 0,0:50:15.07,0:50:17.00,Default,,0,0,0,,Джиро, сенің темекің бар ма?
Dialogue: 0,0:50:18.07,0:50:19.07,Default,,0,0,0,,Джиро
Dialogue: 0,0:50:20.07,0:50:21.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:50:22.00,0:50:23.01,Default,,0,0,0,,Қосымша уақыт.
Dialogue: 0,0:50:23.05,0:50:25.03,Default,,0,0,0,,Аяқталмаған
Dialogue: 0,0:50:42.04,0:50:45.05,Default,,0,0,0,,Сыртта суық сияқты, бірақ бұл бөлме жылы.
Dialogue: 0,0:50:47.01,0:50:49.00,Default,,0,0,0,,Бәріміз бұл камин деп ойладық.
Dialogue: 0,0:50:50.01,0:50:51.08,Default,,0,0,0,,Қызық, мұны да Юнкерс жасайды ма?
Dialogue: 0,0:50:51.09,0:50:54.00,Default,,0,0,0,,Қалай ойлайсыз, ол бүгін біз көрген ұшаққа ұқсамайды ма?
Dialogue: 0,0:50:54.08,0:50:55.06,Default,,0,0,0,,Бұл әдемі
Dialogue: 0,0:50:55.07,0:50:57.00,Default,,0,0,0,,Түсіндім, түсіндім.
Dialogue: 0,0:50:57.01,0:51:00.00,Default,,0,0,0,,Сіз бізде технология негіздері жоқ деп отырған шығарсыз.
Dialogue: 0,0:51:00.05,0:51:02.07,Default,,0,0,0,,Мен котацу мен қоғамдық моншамен жақсымын.
Dialogue: 0,0:51:02.08,0:51:05.01,Default,,0,0,0,,Ұшақ пен котацуды қосамыз.
Dialogue: 0,0:51:06.06,0:51:09.06,Default,,0,0,0,,Бүгін алған бұл деректер әдемі екен.
Dialogue: 0,0:51:10.00,0:51:12.08,Default,,0,0,0,,Бір ғажабы, ол тек сол алып ұшақ туралы жазады.
Dialogue: 0,0:51:13.09,0:51:16.04,Default,,0,0,0,,«Технология – біздің неміс меншігі»
Dialogue: 0,0:51:17.06,0:51:20.06,Default,,0,0,0,,Хонджо Котацу және ұшақтар қосылуы мүмкін
Dialogue: 0,0:51:21.00,0:51:23.05,Default,,0,0,0,,Ағаш металлмен де бәсекелесе алады
Dialogue: 0,0:51:23.07,0:51:27.09,Default,,0,0,0,,Бұл уақытында орындалмайды. 20 жыл кешігіп қалдық.
Dialogue: 0,0:51:33.02,0:51:34.02,Default,,0,0,0,,Жүрейік
Dialogue: 0,0:51:35.08,0:51:37.05,Default,,0,0,0,,Менің миым қайнап кететін сияқты
Dialogue: 0,0:51:46.05,0:51:49.09,Default,,0,0,0,,Біз 20 жылдан кейін тасбақаны қуып келе жатқан Ахиллеспіз.
Dialogue: 0,0:51:51.07,0:51:55.03,Default,,0,0,0,,20 жылдық айырмашылық 5 жылда жетеді, бірақ тасбақа 5 жыл алда.
Dialogue: 0,0:51:55.04,0:51:58.00,Default,,0,0,0,,1 жылда 5 жылды қуып жетеміз
Dialogue: 0,0:51:59.01,0:52:01.05,Default,,0,0,0,,Сонда мен сені үнемі қуып жүремін.
Dialogue: 0,0:52:01.06,0:52:03.08,Default,,0,0,0,,Менің қазір мұны істеуден басқа амалым жоқ.
Dialogue: 0,0:52:03.09,0:52:06.01,Default,,0,0,0,,Бір күні қуып жетемін де, озамын
Dialogue: 0,0:52:07.04,0:52:10.02,Default,,0,0,0,,Кішкентай болса да тасбақа болудың жолы бар емес пе?
Dialogue: 0,0:52:10.03,0:52:12.09,Default,,0,0,0,,(Патефоннан музыка)
Dialogue: 0,0:52:17.00,0:52:18.00,Default,,0,0,0,,Не болды?
Dialogue: 0,0:52:21.09,0:52:23.00,Default,,0,0,0,,Патефон қосулы
Dialogue: 0,0:52:23.01,0:52:27.01,Default,,0,0,0,,(♪ «Қысқы саяхат»)
Dialogue: 0,0:52:28.06,0:52:31.08,Default,,0,0,0,,«Қысқы саяхат» біз үшін тамаша ән.
Dialogue: 0,0:52:41.03,0:52:42.05,Default,,0,0,0,,〈Бұл жапондық! 〉
Dialogue: 0,0:52:42.06,0:52:43.07,Default,,0,0,0,,〈Онда! 〉
Dialogue: 0,0:52:55.06,0:52:56.05,Default,,0,0,0,,Бұл тест
Dialogue: 0,0:52:56.05,0:52:58.07,Default,,0,0,0,,Дәл қазір ол ангарда болған.
Dialogue: 0,0:53:02.04,0:53:03.08,Default,,0,0,0,,(Заттарға сәйкес келетін дыбыстар)
Dialogue: 0,0:53:17.03,0:53:20.05,Default,,0,0,0,,(Тормоз дыбысы)
Dialogue: 0,0:53:25.02,0:53:27.07,Default,,0,0,0,,«Пендлтон отбасының жалғыз қызы Элина үйленеді!»
Dialogue: 0,0:53:58.06,0:53:59.06,Default,,0,0,0,,Джиро
Dialogue: 0,0:54:00.07,0:54:03.05,Default,,0,0,0,,Эй, мен шықтым. Ванна қабылдаңыз.
Dialogue: 0,0:54:08.00,0:54:09.03,Default,,0,0,0,,Сіз ұйықтап қалдыңыз ба?
Dialogue: 0,0:54:10.01,0:54:11.02,Default,,0,0,0,,Жапон ұшағында жалғыз ұшу
Dialogue: 0,0:54:11.03,0:54:14.00,Default,,0,0,0,,Мұңды жүзбен (есік қағу)
Dialogue: 0,0:54:17.09,0:54:19.06,Default,,0,0,0,,Бас кеңседен жеделхат келді.
Dialogue: 0,0:54:19.08,0:54:21.05,Default,,0,0,0,,Өтінемін (қызметкер) Бұл жақсы.
Dialogue: 0,0:54:21.08,0:54:24.00,Default,,0,0,0,,Артымда бірнеше адамды тастап, Жапонияға қайтуды жөн көрдім.
Dialogue: 0,0:54:24.01,0:54:25.05,Default,,0,0,0,,Хонджо-кун қалады
Dialogue: 0,0:54:26.09,0:54:29.03,Default,,0,0,0,,Джиро-кун үйіне батыс жолымен оралады
Dialogue: 0,0:54:29.05,0:54:30.04,Default,,0,0,0,,Батысқа қарай?
Dialogue: 0,0:54:30.05,0:54:32.05,Default,,0,0,0,,Келіңіз және әлемді көріңіз.
Dialogue: 0,0:54:32.06,0:54:33.09,Default,,0,0,0,,Сіз жалғыз жүрсіз бе?
Dialogue: 0,0:55:00.07,0:55:01.09,Default,,0,0,0,,Капрони мырза
Dialogue: 0,0:55:02.00,0:55:03.09,Default,,0,0,0,,Жел әлі соғып тұр ма?
Dialogue: 0,0:55:05.00,0:55:06.05,Default,,0,0,0,,Иә үрлеу
Dialogue: 0,0:55:07.03,0:55:11.02,Default,,0,0,0,,Енді мен сізді зейнеткерлікке шығуға шақырамын. Кел.
Dialogue: 0,0:55:11.08,0:55:13.05,Default,,0,0,0,,Сіз зейнетке шығасыз ба?
Dialogue: 0,0:55:15.02,0:55:16.06,Default,,0,0,0,,Барынша қатты секіріңіз
Dialogue: 0,0:55:21.03,0:55:23.01,Default,,0,0,0,,Секір! (Джиро) Уф
Dialogue: 0,0:55:29.06,0:55:31.08,Default,,0,0,0,,Олар Суттоны ертіп әкелді.
Dialogue: 0,0:55:31.09,0:55:34.02,Default,,0,0,0,,Тезірек, ұшасың!
Dialogue: 0,0:55:35.02,0:55:38.02,Default,,0,0,0,,Төменде. Іштің астында есік бар.
Dialogue: 0,0:55:38.08,0:55:40.06,Default,,0,0,0,,Тезірек (Джиро) Иә.
Dialogue: 0,0:55:40.07,0:55:41.07,Default,,0,0,0,,Маған бір сәт өтіп кетейін.
Dialogue: 0,0:55:42.00,0:55:43.00,Default,,0,0,0,,Денемде болмасам да, әлі де заттарды ұстай аламын ғой, ә?
Dialogue: 0,0:55:51.03,0:55:53.08,Default,,0,0,0,,Ұш! (Қыздар) Жүр! Бар!
Dialogue: 0,0:56:01.06,0:56:04.03,Default,,0,0,0,,Олардың барлығы қолөнершілердің отбасы мүшелері мен туыстары.
Dialogue: 0,0:56:04.04,0:56:05.09,Default,,0,0,0,,Бүкіл ауыл.
Dialogue: 0,0:56:06.09,0:56:08.09,Default,,0,0,0,,Бірақ бұл биліктен құпия.
Dialogue: 0,0:56:09.00,0:56:12.04,Default,,0,0,0,,Өйткені, бұл әлі жеткізілмеген бомбалаушы.
Dialogue: 0,0:56:12.05,0:56:14.09,Default,,0,0,0,,Уау
Dialogue: 0,0:56:18.05,0:56:19.07,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:56:19.07,0:56:20.07,Default,,0,0,0,,Керемет
Dialogue: 0,0:56:22.03,0:56:24.04,Default,,0,0,0,,Ежелгі Рим сәулетіне ұқсайды
Dialogue: 0,0:56:25.01,0:56:28.03,Default,,0,0,0,,Олар биліктің блефингке деген сүйіспеншілігін пайдаланды.
Dialogue: 0,0:56:28.04,0:56:30.05,Default,,0,0,0,,Бұндай затты соғыста қолдануға болмайды.
Dialogue: 0,0:56:31.06,0:56:33.04,Default,,0,0,0,,Біздің ел кедей
Dialogue: 0,0:56:34.01,0:56:37.06,Default,,0,0,0,,Технология мұндай нәрсені жасау үшін тым жетілмеген.
Dialogue: 0,0:56:38.03,0:56:40.07,Default,,0,0,0,,Дизайндағы маңызды нәрсе - сезім.
Dialogue: 0,0:56:41.03,0:56:43.01,Default,,0,0,0,,Сезім заманнан озып кетті
Dialogue: 0,0:56:43.02,0:56:45.04,Default,,0,0,0,,Технология кейінірек болады.
Dialogue: 0,0:56:48.05,0:56:49.09,Default,,0,0,0,,Менің әйелім.
Dialogue: 0,0:56:50.08,0:56:54.09,Default,,0,0,0,,Кедей болсақ, еліміз бір, баламыз көп.
Dialogue: 0,0:57:00.05,0:57:04.04,Default,,0,0,0,,Ей, қатты шуласаң, түбі шығып кетеді!
Dialogue: 0,0:57:05.04,0:57:06.04,Default,,0,0,0,,Келіңіздер.
Dialogue: 0,0:57:10.00,0:57:12.00,Default,,0,0,0,,Басыңызды бақылаңыз
Dialogue: 0,0:57:12.01,0:57:15.01,Default,,0,0,0,,Түсімде де басым ұшып кетеді.
Dialogue: 0,0:57:24.03,0:57:27.00,Default,,0,0,0,,Сіз пирамидалар әлеміндесіз.
Dialogue: 0,0:57:27.01,0:57:29.07,Default,,0,0,0,,Сіз пирамидасыз әлемді қалайсыз?
Dialogue: 0,0:57:29.08,0:57:31.00,Default,,0,0,0,,Бұл пирамида ма?
Dialogue: 0,0:57:31.06,0:57:34.01,Default,,0,0,0,,Адамзаттың көкте ұшу арманы
Dialogue: 0,0:57:34.02,0:57:35.09,Default,,0,0,0,,Бұл да қарғыс атқан түс
Dialogue: 0,0:57:36.04,0:57:38.09,Default,,0,0,0,,Ұшақтар сою және жою құралына айналады.
Dialogue: 0,0:57:39.00,0:57:41.00,Default,,0,0,0,,Тағдырды иығымызда көтереміз.
Dialogue: 0,0:57:41.01,0:57:42.00,Default,,0,0,0,,Иә
Dialogue: 0,0:57:42.06,0:57:46.04,Default,,0,0,0,,Сонда да мен пирамидалары бар әлемді таңдадым.
Dialogue: 0,0:57:47.07,0:57:49.04,Default,,0,0,0,,Сіз қайсысын таңдайсыз?
Dialogue: 0,0:57:50.00,0:57:53.02,Default,,0,0,0,,Мен әдемі ұшақ жасағым келеді.
Dialogue: 0,0:57:53.05,0:57:54.06,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:58:10.01,0:58:12.04,Default,,0,0,0,,Иә, бұл жақсы сезінеді.
Dialogue: 0,0:58:12.05,0:58:14.03,Default,,0,0,0,,Жоқ, әлі жоқ.
Dialogue: 0,0:58:14.04,0:58:16.06,Default,,0,0,0,,Қозғалтқыш пен тіпті кабинаның пішіні әлі жасалмаған.
Dialogue: 0,0:58:25.08,0:58:30.00,Default,,0,0,0,,Браво, бұл әдемі түс.
Dialogue: 0,0:58:37.07,0:58:41.01,Default,,0,0,0,,Мен осы рейстен кейін зейнетке шығамын.
Dialogue: 0,0:58:41.06,0:58:44.05,Default,,0,0,0,,Шығармашылық өмір 10 жылға созылады.
Dialogue: 0,0:58:45.01,0:58:47.06,Default,,0,0,0,,Суретшілер мен дизайнерлер бірдей
Dialogue: 0,0:58:48.07,0:58:53.00,Default,,0,0,0,,10 жылыңызды толық өмір сүріңіз
Dialogue: 0,0:59:09.08,0:59:11.09,Default,,0,0,0,,Джиро, бір сәт Фриарға кел.
Dialogue: 0,0:59:12.00,0:59:13.09,Default,,0,0,0,,Менің кездесуім алда... (Курокава) Оны кейінге қалдырыңыз.
Dialogue: 0,0:59:30.06,0:59:32.01,Default,,0,0,0,,Бұл шамадан тыс сұрау.
Dialogue: 0,0:59:32.02,0:59:33.08,Default,,0,0,0,,Әрқашан солай
Dialogue: 0,0:59:34.01,0:59:35.09,Default,,0,0,0,,Джиро мұнда қанша жыл болды?
Dialogue: 0,0:59:37.08,0:59:39.00,Default,,0,0,0,,Джиро ше?
Dialogue: 0,0:59:39.02,0:59:41.02,Default,,0,0,0,,Сіз компанияға неше жыл қостыңыз? (Джиро) 5 жыл болды.
Dialogue: 0,0:59:41.09,0:59:43.02,Default,,0,0,0,,Бұл жеткілікті.
Dialogue: 0,0:59:43.03,0:59:45.03,Default,,0,0,0,,Оның дизайн бастығы болыңыз.
Dialogue: 0,0:59:45.06,0:59:48.09,Default,,0,0,0,,Әскери-теңіз күштерінің прототипі тасымалдаушы негізіндегі истребитель 1930 ж.
Dialogue: 0,0:59:49.03,0:59:50.02,Default,,0,0,0,,Керемет жұмыс!
Dialogue: 0,0:59:53.06,0:59:54.07,Default,,0,0,0,,Сәлем Джиро
Dialogue: 0,1:00:06.08,1:00:07.08,Default,,0,0,0,,Бұл шынымен де…
Dialogue: 0,1:00:08.03,1:00:09.03,Default,,0,0,0,,Мен мұны істеймін.
Dialogue: 0,1:00:09.09,1:00:11.00,Default,,0,0,0,,Жарайды
Dialogue: 0,1:00:11.04,1:00:13.03,Default,,0,0,0,,Сіз қызметкерлерге Хонджо бере аласыз ба?
Dialogue: 0,1:00:13.04,1:00:14.03,Default,,0,0,0,,Мүмкін оның мақсаты – Эренді жеп қою.
Dialogue: 0,1:00:15.01,1:00:18.05,Default,,0,0,0,,Құрбыларың – қарсылас. Бірлессең достығыңнан айырылады.
Dialogue: 0,1:00:19.03,1:00:20.07,Default,,0,0,0,,Сабыр етіңіз
Dialogue: 0,1:00:21.07,1:00:23.02,Default,,0,0,0,,Кими-чан вексель
Dialogue: 0,1:00:24.01,1:00:26.03,Default,,0,0,0,,Менің де Хонджоға бірдеңе жасауым бар.
Dialogue: 0,1:01:13.01,1:01:14.09,Default,,0,0,0,,Бұл отандық қозғалтқыш.
Dialogue: 0,1:01:25.09,1:01:27.08,Default,,0,0,0,,Бұл ұшақ тасығыш
Dialogue: 0,1:01:32.08,1:01:34.03,Default,,0,0,0,,Мен ауыстыратын киім дайындадым.
Dialogue: 0,1:01:34.03,1:01:36.01,Default,,0,0,0,,Ах... Рахмет.
Dialogue: 0,1:01:48.04,1:01:49.09,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,1:01:50.00,1:01:51.00,Default,,0,0,0,,Жоқ, бұл сізге сәйкес келеді.
Dialogue: 0,1:02:08.02,1:02:10.07,Default,,0,0,0,,Мұндай шалқып жатқан шөлде мотоцикліммен келе жатқанда —
Dialogue: 0,1:02:16.03,1:02:18.02,Default,,0,0,0,,（）
Dialogue: 0,1:02:18.03,1:02:20.00,Default,,0,0,0,,Іске қосуды тоқтатыңыз!
Dialogue: 0,1:03:12.09,1:03:14.02,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,1:03:26.06,1:03:30.03,Default,,0,0,0,,(механикалық дыбыс)
Dialogue: 0,1:04:16.06,1:04:17.08,Default,,0,0,0,,Мен мұны істедім, жасадым
Dialogue: 0,1:04:17.09,1:04:19.03,Default,,0,0,0,,Ал, қалай ойлайсың, Армин?
Dialogue: 0,1:05:25.02,1:05:26.08,Default,,0,0,0,,Әке
Dialogue: 0,1:05:41.06,1:05:42.04,Default,,0,0,0,,Ах
Dialogue: 0,1:05:55.04,1:05:56.03,Default,,0,0,0,,Уау
Dialogue: 0,1:05:56.09,1:05:58.05,Default,,0,0,0,,Уф... Уф
Dialogue: 0,1:06:13.02,1:06:16.02,Default,,0,0,0,,Браво жақсы аулау
Dialogue: 0,1:06:20.05,1:06:23.03,Default,,0,0,0,,Сәлем, кешіріңіз, кешіріңіз, ауырып қалдыңыз ба?
Dialogue: 0,1:06:23.04,1:06:24.07,Default,,0,0,0,,Араларыңыздан сатқын кіріп, қашып кетуі мүмкін.
Dialogue: 0,1:06:25.03,1:06:26.05,Default,,0,0,0,,Рахмет
Dialogue: 0,1:06:26.06,1:06:28.02,Default,,0,0,0,,Қарызға алған нәрсемнен айырылып қала жаздадым.
Dialogue: 0,1:06:28.03,1:06:29.04,Default,,0,0,0,,Онда, осымен бітті.
Dialogue: 0,1:06:42.09,1:06:46.01,Default,,0,0,0,,Әке, мен дөрекі сөз айттым.
Dialogue: 0,1:06:46.04,1:06:48.03,Default,,0,0,0,,Қандай жақсы жігіт.
Dialogue: 0,1:06:48.07,1:06:51.03,Default,,0,0,0,,Екеуміз бір қонақүйде болғандықтан, рахметімді айтуға мүмкіндігім бар.
Dialogue: 0,1:07:15.01,1:07:16.04,Default,,0,0,0,,(Бірнеше адам қолдайды)
Dialogue: 0,1:07:24.09,1:07:27.05,Default,,0,0,0,,Сәлем
Dialogue: 0,1:07:35.05,1:07:36.04,Default,,0,0,0,,(теннис допының дыбысы)
Dialogue: 0,1:07:39.00,1:07:40.00,Default,,0,0,0,,(теннис допының дыбысы)
Dialogue: 0,1:07:42.05,1:07:43.05,Default,,0,0,0,,(теннис допының дыбысы)
Dialogue: 0,1:09:36.06,1:09:37.05,Default,,0,0,0,,Қарт әже, кіріп келемін.
Dialogue: 0,1:09:38.02,1:09:41.09,Default,,0,0,0,,Жоқ, қараңдаршы, қолшатырды ұстаған адам.
Dialogue: 0,1:09:42.01,1:09:44.08,Default,,0,0,0,,Аа, сенің серігің жоқ шығар.
Dialogue: 0,1:10:56.02,1:10:58.01,Default,,0,0,0,,Мм... Мен қайтып барамын.
Dialogue: 0,1:10:59.08,1:11:01.02,Default,,0,0,0,,Барма
Dialogue: 0,1:11:01.09,1:11:03.09,Default,,0,0,0,,Мен Имайзумиге алғыс айттым.
Dialogue: 0,1:11:05.00,1:11:07.00,Default,,0,0,0,,Осында келуге рұқсат етіңіз
Dialogue: 0,1:11:07.00,1:11:08.02,Default,,0,0,0,,Мен оны сұрадым.
Dialogue: 0,1:11:12.01,1:11:14.08,Default,,0,0,0,,Сіз мүлде өзгерген жоқсыз.
Dialogue: 0,1:11:15.02,1:11:16.05,Default,,0,0,0,,Сол кездегідей
Dialogue: 0,1:11:17.06,1:11:21.00,Default,,0,0,0,,Жер сілкінісі болған кезде көп рахмет
Dialogue: 0,1:11:21.04,1:11:24.01,Default,,0,0,0,,Мен әрқашан сізбен кездесіп, рахмет айтқым келді.
Dialogue: 0,1:11:24.06,1:11:26.05,Default,,0,0,0,,Әй, сол кезде...
Dialogue: 0,1:11:27.02,1:11:29.04,Default,,0,0,0,,Менің атым Нахоко Сатоми.
Dialogue: 0,1:11:30.08,1:11:32.02,Default,,0,0,0,,Бұл Джиро Хорикоши.
Dialogue: 0,1:11:54.05,1:11:55.06,Default,,0,0,0,,Тек L өз ықпалындағы біреумен алмастырылған
Dialogue: 0,1:11:56.03,1:11:57.03,Default,,0,0,0,,Иә
Dialogue: 0,1:11:59.01,1:12:01.03,Default,,0,0,0,,Сіздің тұрған жеріңіз қазір белгілі
Dialogue: 0,1:12:01.04,1:12:03.07,Default,,0,0,0,,Тұрмысқа шыққаныма екі күн болды.
Dialogue: 0,1:12:05.01,1:12:07.03,Default,,0,0,0,,Жібек Қуаныштан жыладым
Dialogue: 0,1:12:08.01,1:12:11.01,Default,,0,0,0,,Джиро мырза жібек пен мен ханзадасы едік.
Dialogue: 0,1:12:11.04,1:12:12.04,Default,,0,0,0,,Ханзада?
Dialogue: 0,1:12:12.05,1:12:15.05,Default,,0,0,0,,Иә, ақ боз ат мінген ханзадаға ұқсайды.
Dialogue: 0,1:12:16.06,1:12:18.04,Default,,0,0,0,,Бұл қолшатыр ағып жатыр.
Dialogue: 0,1:12:19.02,1:12:22.01,Default,,0,0,0,,Жарайды, мен Окинуға айтуым керек.
Dialogue: 0,1:12:22.07,1:12:25.06,Default,,0,0,0,,Ол жаңа ғана екінші сәбиін дүниеге әкелді.
Dialogue: 0,1:12:26.04,1:12:27.06,Default,,0,0,0,,Өте сүйкімді балақай
Dialogue: 0,1:12:31.08,1:12:33.03,Default,,0,0,0,,Сурет суланып қалды.
Dialogue: 0,1:12:33.08,1:12:36.09,Default,,0,0,0,,Иә, мен оны естелік ретінде сақтаймын.
Dialogue: 0,1:12:37.00,1:12:39.00,Default,,0,0,0,,Қараңдаршы, аспан жарқырай түсті.
Dialogue: 0,1:12:40.00,1:12:40.50,Default,,0,0,0,,Уау
Dialogue: 0,1:12:43.06,1:12:44.06,Default,,0,0,0,,Ах
Dialogue: 0,1:12:46.05,1:12:47.07,Default,,0,0,0,,құрғақ
Dialogue: 0,1:12:49.07,1:12:51.04,Default,,0,0,0,,Қараңдар, қараңдар.
Dialogue: 0,1:13:00.00,1:13:01.09,Default,,0,0,0,,Мен кемпірқосақ туралы мүлде ұмыттым.
Dialogue: 0,1:13:02.06,1:13:04.05,Default,,0,0,0,,Тірі болған қандай керемет.
Dialogue: 0,1:13:06.02,1:13:09.00,Default,,0,0,0,,Кеттік. Әкемнің қатты уайымдағанына сенімдімін.
Dialogue: 0,1:13:14.01,1:13:15.01,Default,,0,0,0,,Менің әкем
Dialogue: 0,1:13:15.05,1:13:17.06,Default,,0,0,0,,Әке!
Dialogue: 0,1:13:18.04,1:13:20.08,Default,,0,0,0,,Келіңіз, мен сізді әкеммен таныстырамын.
Dialogue: 0,1:13:20.08,1:13:21.07,Default,,0,0,0,,Иә
Dialogue: 0,1:13:24.01,1:13:25.04,Default,,0,0,0,,Ылғал емес пе?
Dialogue: 0,1:13:25.05,1:13:26.06,Default,,0,0,0,,Менде бәрі жақсы
Dialogue: 0,1:13:26.06,1:13:29.01,Default,,0,0,0,,Бұл адам маған көмектесті.
Dialogue: 0,1:13:29.01,1:13:30.04,Default,,0,0,0,,Бұл Хорикоши мырза.
Dialogue: 0,1:13:30.08,1:13:31.08,Default,,0,0,0,,Бұл Хорикоши.
Dialogue: 0,1:13:32.02,1:13:33.02,Default,,0,0,0,,Бұл Сатоми.
Dialogue: 0,1:13:33.07,1:13:36.04,Default,,0,0,0,,Менің қызым тағы да қиындық туғызды.
Dialogue: 0,1:14:22.02,1:14:23.08,Default,,0,0,0,,Коко Айдесука?
Dialogue: 0,1:14:25.09,1:14:26.08,Default,,0,0,0,,Өтінемін
Dialogue: 0,1:14:43.08,1:14:47.08,Default,,0,0,0,,German Tobacco Kore Saigo Kanashii
Dialogue: 0,1:14:48.08,1:14:49.09,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,1:14:50.00,1:14:53.01,Default,,0,0,0,,Менде де осындай жағдай болды.
Dialogue: 0,1:14:53.08,1:14:56.03,Default,,0,0,0,,Сіз Германия Икимашитане
Dialogue: 0,1:14:56.04,1:14:57.08,Default,,0,0,0,,Десу Десшо?
Dialogue: 0,1:14:59.02,1:15:01.03,Default,,0,0,0,,Сіз Шерлок Холмссыз ба?
Dialogue: 0,1:15:01.08,1:15:03.09,Default,,0,0,0,,Сіз инженерсіз
Dialogue: 0,1:15:04.03,1:15:08.05,Default,,0,0,0,,Ицумо Германо Хикокино Заши Митемасу
Dialogue: 0,1:15:08.05,1:15:12.00,Default,,0,0,0,,Жапон инженері Минна Дессу Ику
Dialogue: 0,1:15:12.09,1:15:14.02,Default,,0,0,0,,Қоштасудың бір ауыз сөзін айтпай-ақ,
Dialogue: 0,1:15:14.09,1:15:16.00,Default,,0,0,0,,Керемет
Dialogue: 0,1:15:17.06,1:15:19.07,Default,,0,0,0,,Доктор Юнкерс
Dialogue: 0,1:15:20.08,1:15:21.09,Default,,0,0,0,,Сіз суға батып бара жатырсыз ба?
Dialogue: 0,1:15:23.09,1:15:27.01,Default,,0,0,0,,Қауіпсіз Кенкашитеру Харецуру
Dialogue: 0,1:15:27.09,1:15:29.05,Default,,0,0,0,,Гитлер режимімен?
Dialogue: 0,1:15:30.06,1:15:33.03,Default,,0,0,0,,Мынау бір топ арамзалар.
Dialogue: 0,1:15:34.00,1:15:36.02,Default,,0,0,0,,Кокохай Иитокородесне
Dialogue: 0,1:15:36.03,1:15:38.09,Default,,0,0,0,,Маса Инаи Ацукунай
Dialogue: 0,1:15:39.00,1:15:40.08,Default,,0,0,0,,Су кресі дәмді
Dialogue: 0,1:15:41.00,1:15:43.05,Default,,0,0,0,,Iyanakoto waslernii
Dialogue: 0,1:15:44.03,1:15:46.04,Default,,0,0,0,,Сізге қалай ұнайды? Жапондық темекі
Dialogue: 0,1:15:46.05,1:15:47.05,Default,,0,0,0,,Аригато
Dialogue: 0,1:15:53.03,1:15:57.06,Default,,0,0,0,,Iijordes Cocoha «Der Zauberberg»
Dialogue: 0,1:15:57.07,1:15:59.07,Default,,0,0,0,,«Сиқырлы тау» Томас Манн?
Dialogue: 0,1:15:59.08,1:16:02.00,Default,,0,0,0,,Waslerni Iitokorodes
Dialogue: 0,1:16:02.08,1:16:05.07,Default,,0,0,0,,Чинат Сенсу Шител Васлер
Dialogue: 0,1:16:06.02,1:16:08.07,Default,,0,0,0,,Маншукоку Цукатта Васлер
Dialogue: 0,1:16:09.05,1:16:12.04,Default,,0,0,0,,Коку Сирен Мэй Нукета Васрел
Dialogue: 0,1:16:12.05,1:16:14.09,Default,,0,0,0,,Секайво Текинисуру Васрел
Dialogue: 0,1:16:15.09,1:16:17.08,Default,,0,0,0,,Нихон Харецсуру
Dialogue: 0,1:16:18.08,1:16:20.07,Default,,0,0,0,,Неміс Мохарецур
Dialogue: 0,1:16:21.04,1:16:23.03,Default,,0,0,0,,Германия қайтадан соғысқа кірісе ме?
Dialogue: 0,1:16:23.04,1:16:25.04,Default,,0,0,0,,Соу Томенакереба
Dialogue: 0,1:16:26.09,1:16:29.05,Default,,0,0,0,,Сізді ұзақ күттіргенім үшін кешіріңіз.
Dialogue: 0,1:16:30.02,1:16:32.06,Default,,0,0,0,,Нахоконың қызуы көтеріліп тұр.
Dialogue: 0,1:16:32.07,1:16:35.02,Default,,0,0,0,,Бүгінгі кешкі астан бас тартуға рұқсат етіңіз.
Dialogue: 0,1:16:35.09,1:16:37.05,Default,,0,0,0,,Әр бұрылыста сезімдеріңе ерік беріп жүру ме?
Dialogue: 0,1:16:37.06,1:16:39.03,Default,,0,0,0,,Маған сізге қамқорлық жасауды өтінемін.
Dialogue: 0,1:16:40.02,1:16:42.07,Default,,0,0,0,,Жақында дәрігер келеді, осылай істеңіз.
Dialogue: 0,1:18:39.02,1:18:41.02,Default,,0,0,0,,«Желді кім көрді?»
Dialogue: 0,1:18:42.05,1:18:44.06,Default,,0,0,0,,«Мен де, сен де көрмейсің».
Dialogue: 0,1:18:45.04,1:18:47.08,Default,,0,0,0,,«Бірақ жапырақтар дірілсін»
Dialogue: 0,1:18:47.09,1:18:49.09,Default,,0,0,0,,«Жел өтеді»
Dialogue: 0,1:18:50.00,1:18:52.00,Default,,0,0,0,,«Аэронавтика»
Dialogue: 0,1:18:55.03,1:18:57.04,Default,,0,0,0,,Жел, қанаттарың қалтырап
Dialogue: 0,1:18:58.09,1:19:00.06,Default,,0,0,0,,Сізге жетсін
Dialogue: 0,1:19:10.01,1:19:13.08,Default,,0,0,0,,(Құстардың сайрауы)
Dialogue: 0,1:19:37.02,1:19:38.02,Default,,0,0,0,,Джиро мырза...
Dialogue: 0,1:19:38.07,1:19:39.06,Default,,0,0,0,,Нахоко-сан
Dialogue: 0,1:19:45.04,1:19:46.04,Default,,0,0,0,,А... у...
Dialogue: 0,1:20:00.02,1:20:01.05,Default,,0,0,0,,Мықты
Dialogue: 0,1:20:35.00,1:20:35.50,Default,,0,0,0,,О
Dialogue: 0,1:21:20.01,1:21:21.00,Default,,0,0,0,,О...
Dialogue: 0,1:21:22.08,1:21:24.09,Default,,0,0,0,,Ахахаха ахаха
Dialogue: 0,1:21:49.00,1:21:50.05,Default,,0,0,0,,Ах... Ах!
Dialogue: 0,1:21:51.08,1:21:52.09,Default,,0,0,0,,Ха!
Dialogue: 0,1:21:59.05,1:22:01.04,Default,,0,0,0,,Хехе...
Dialogue: 0,1:22:01.04,1:22:02.05,Default,,0,0,0,,(Оқушы) 15 минут па? (Изуку) Мен үшін ұпайлар аса маңызды емес.
Dialogue: 0,1:22:19.07,1:22:22.07,Default,,0,0,0,,♪ «Das Gibt's nur einmal»
Dialogue: 0,1:22:39.00,1:22:53.01,Default,,0,0,0,,(Ән айтатын дауыс: неміс)
Dialogue: 0,1:23:08.00,1:23:11.00,Default,,0,0,0,,~♪
Dialogue: 0,1:23:14.01,1:23:16.08,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,1:23:18.06,1:23:19.07,Default,,0,0,0,,Браво
Dialogue: 0,1:23:20.01,1:23:22.04,Default,,0,0,0,,Ханым, емделдің бе?
Dialogue: 0,1:23:23.01,1:23:25.01,Default,,0,0,0,,Сіздің арқаңызда жағдай жақсарды.
Dialogue: 0,1:23:25.02,1:23:26.02,Default,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,1:23:27.03,1:23:30.00,Default,,0,0,0,,Бұл шайтанның тауы, бәрі жазылады.
Dialogue: 0,1:23:31.01,1:23:32.02,Default,,0,0,0,,Зұлымдар Альянсының көлеңкесі – біздің ең үлкен алаңдаушылығымыз
Dialogue: 0,1:23:33.02,1:23:37.02,Default,,0,0,0,,Бұл жігіт келгенінде қатты күйзелді.
Dialogue: 0,1:23:37.06,1:23:39.02,Default,,0,0,0,,Енді Суккари Генки
Dialogue: 0,1:23:40.01,1:23:41.04,Default,,0,0,0,,тұқы
Dialogue: 0,1:23:42.07,1:23:43.06,Default,,0,0,0,,Иә
Dialogue: 0,1:23:45.00,1:23:47.06,Default,,0,0,0,,Хишочидің тұқысы бірден овару.
Dialogue: 0,1:23:47.08,1:23:51.02,Default,,0,0,0,,Төменге оралу Тауларды ұмыту
Dialogue: 0,1:23:52.03,1:23:53.04,Default,,0,0,0,,Мен емес
Dialogue: 0,1:23:54.05,1:23:58.04,Default,,0,0,0,,Ол кісі менің қызым болады деп күтпедім...
Dialogue: 0,1:23:58.07,1:24:00.07,Default,,0,0,0,,Иә, бұл Нахоко.
Dialogue: 0,1:24:00.08,1:24:02.00,Default,,0,0,0,,О!
Dialogue: 0,1:24:02.07,1:24:04.09,Default,,0,0,0,,Қызыңызбен қарым-қатынасымды қабыл алыңыз.
Dialogue: 0,1:24:05.07,1:24:08.00,Default,,0,0,0,,Хмм... жоқ... бірақ
Dialogue: 0,1:24:08.00,1:24:09.02,Default,,0,0,0,,Әке
Dialogue: 0,1:24:10.07,1:24:13.00,Default,,0,0,0,,Мен бұл туралы естігім келеді.
Dialogue: 0,1:24:13.09,1:24:15.04,Default,,0,0,0,,Буси!
Dialogue: 0,1:24:19.00,1:24:22.02,Default,,0,0,0,,Бұған дейін менің саған айтар сөзім бар.
Dialogue: 0,1:24:22.03,1:24:23.03,Default,,0,0,0,,Иә
Dialogue: 0,1:24:23.05,1:24:25.05,Default,,0,0,0,,Мен анамнан екі жыл бұрын айырылдым.
Dialogue: 0,1:24:25.08,1:24:27.00,Default,,0,0,0,,Бұл туберкулез болды.
Dialogue: 0,1:24:27.09,1:24:29.09,Default,,0,0,0,,Менде де осындай ауру бар.
Dialogue: 0,1:24:30.08,1:24:32.03,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,1:24:33.01,1:24:34.07,Default,,0,0,0,,Менің қалпағымды қабылдаған сәттен бастап
Dialogue: 0,1:24:35.07,1:24:39.03,Default,,0,0,0,,Мен де сені маған жел алып келгеннен бері.
Dialogue: 0,1:24:40.01,1:24:41.07,Default,,0,0,0,,Маған тұрмысқа шығуыңызды өтінемін
Dialogue: 0,1:24:42.01,1:24:45.03,Default,,0,0,0,,Иә, бірақ мен ауруды міндетті түрде емдеймін.
Dialogue: 0,1:24:45.04,1:24:47.03,Default,,0,0,0,,Оған дейін күте аласыз ба?
Dialogue: 0,1:24:47.04,1:24:50.01,Default,,0,0,0,,Әрине мен 100 жыл күтемін.
Dialogue: 0,1:24:51.01,1:24:54.03,Default,,0,0,0,,Құтты болсын, жақсы жігіт екен.
Dialogue: 0,1:24:54.04,1:24:56.08,Default,,0,0,0,,Жас ханымның да жағдайы жақсы.
Dialogue: 0,1:24:58.03,1:25:00.08,Default,,0,0,0,,Коно жазы Бұл жақсы жаз
Dialogue: 0,1:25:23.05,1:25:25.00,Default,,0,0,0,,Джиро осында.
Dialogue: 0,1:25:25.05,1:25:26.05,Default,,0,0,0,,Хонджо
Dialogue: 0,1:25:26.06,1:25:27.04,Default,,0,0,0,,Сіз қашан оралдыңыз?
Dialogue: 0,1:25:27.05,1:25:28.05,Default,,0,0,0,,Кешегі күн
Dialogue: 0,1:25:29.00,1:25:30.04,Default,,0,0,0,,Бұл жерде ыстық
Dialogue: 0,1:25:33.03,1:25:34.09,Default,,0,0,0,,Қараңдаршы.
Dialogue: 0,1:25:39.08,1:25:41.02,Default,,0,0,0,,Бұл әдемі.
Dialogue: 0,1:25:42.00,1:25:43.03,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,1:25:47.00,1:25:49.00,Default,,0,0,0,,Бұл эксперименталды машина сияқты.
Dialogue: 0,1:25:49.06,1:25:50.09,Default,,0,0,0,,Өзіңізге ұнайтын нәрсені жасаңыз
Dialogue: 0,1:25:52.02,1:25:54.00,Default,,0,0,0,,Сіз оны қолданып көрмейінше білмейсіз
Dialogue: 0,1:25:54.09,1:25:58.01,Default,,0,0,0,,А, мынау ұшып барады, жел соғып тұр
Dialogue: 0,1:26:19.04,1:26:21.03,Default,,0,0,0,,Хонджо — Жапонияның Ахиллесі
Dialogue: 0,1:26:21.03,1:26:23.01,Default,,0,0,0,,20 жыл өтті
Dialogue: 0,1:26:24.01,1:26:25.08,Default,,0,0,0,,Менікі қалайы үйрек болды
Dialogue: 0,1:26:26.03,1:26:27.07,Default,,0,0,0,,Мен мұны пайдалана аламын ба?
Dialogue: 0,1:26:28.06,1:26:30.03,Default,,0,0,0,,Менің үйрегім уақытында жетпеді.
Dialogue: 0,1:26:33.03,1:26:35.08,Default,,0,0,0,,Тексеру саңылауын жабу үшін бұралмалы бұранданы пайдаланыңыз.
Dialogue: 0,1:26:36.02,1:26:37.05,Default,,0,0,0,,Ауа кедергісінің төмендеуі
Dialogue: 0,1:26:38.00,1:26:39.01,Default,,0,0,0,,Жанармай бүрку тесігі де
Dialogue: 0,1:26:39.06,1:26:42.04,Default,,0,0,0,,Топсаны бір жағынан бекітсеңіз, жұмыс істеу оңайырақ болады.
Dialogue: 0,1:26:47.04,1:26:50.04,Default,,0,0,0,,Серіппенің серпімділігі жеткілікті деп ойлаймын.
Dialogue: 0,1:26:50.07,1:26:52.04,Default,,0,0,0,,Джиро, бұл жақсы идея.
Dialogue: 0,1:26:52.05,1:26:54.04,Default,,0,0,0,,Бұл Колумбтың жұмыртқасы.
Dialogue: 0,1:26:54.05,1:26:55.04,Default,,0,0,0,,Оны пайдаланыңыз.
Dialogue: 0,1:26:56.05,1:26:58.01,Default,,0,0,0,,Рахмет, бірақ мен оны енді қолданбаймын.
Dialogue: 0,1:27:00.03,1:27:01.08,Default,,0,0,0,,Мен бұл суретті алдым.
Dialogue: 0,1:27:01.09,1:27:03.07,Default,,0,0,0,,Джиро оны келесі үйректе қолданғаннан кейін
Dialogue: 0,1:27:03.08,1:27:04.09,Default,,0,0,0,,Мен сізге де оны пайдалануға рұқсат етемін.
Dialogue: 0,1:27:06.03,1:27:07.02,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,1:27:07.07,1:27:09.07,Default,,0,0,0,,Тез қолданыңыз, мен сізді күтемін.
Dialogue: 0,1:27:10.08,1:27:12.08,Default,,0,0,0,,Джиро, сен осындасың ба?
Dialogue: 0,1:27:13.06,1:27:16.01,Default,,0,0,0,,Курокава Джиро мырза (Джиро) Иә.
Dialogue: 0,1:27:16.02,1:27:17.01,Default,,0,0,0,,Қазір оралу
Dialogue: 0,1:27:17.02,1:27:18.07,Default,,0,0,0,,Иә, онда рахмет
Dialogue: 0,1:27:18.08,1:27:20.04,Default,,0,0,0,,Келесі жолы маған қонаққа кел (Джиро) Иә.
Dialogue: 0,1:27:21.00,1:27:22.01,Default,,0,0,0,,Джиро Коге
Dialogue: 0,1:27:27.07,1:27:29.09,Default,,0,0,0,,Токко Джироны тексеруге келеді.
Dialogue: 0,1:27:29.09,1:27:30.08,Default,,0,0,0,,Иә?
Dialogue: 0,1:27:30.09,1:27:33.02,Default,,0,0,0,,Ойланатын қылмыстарға маманданған құпия полиция.
Dialogue: 0,1:27:34.00,1:27:35.03,Default,,0,0,0,,Мен?
Dialogue: 0,1:27:35.04,1:27:37.07,Default,,0,0,0,,Сіз іссапарға шықпауды шештіңіз (Джиро) Уау!
Dialogue: 0,1:27:48.09,1:27:51.06,Default,,0,0,0,,Сіз оны құтқарып қалдым деп кейіп танытып, оны пайдаланғыңыз келе ме?
Dialogue: 0,1:27:51.09,1:27:54.04,Default,,0,0,0,,Джиро, бүгін осында бол. Мен сізге жұмысты орындауға рұқсат етемін.
Dialogue: 0,1:27:54.08,1:27:57.03,Default,,0,0,0,,Түсіндіріңіз. Бұл есімде жоқ.
Dialogue: 0,1:27:58.01,1:28:01.00,Default,,0,0,0,,Менің көптеген достарымды арнайы орта мектептер өлтірді.
Dialogue: 0,1:28:01.01,1:28:03.09,Default,,0,0,0,,Жұмбақты бәрі жаттай алмады.
Dialogue: 0,1:28:04.07,1:28:05.06,Default,,0,0,0,,Қою
Dialogue: 0,1:28:05.07,1:28:06.08,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:28:09.02,1:28:10.07,Default,,0,0,0,,Бұған шыдаңыз.
Dialogue: 0,1:28:11.02,1:28:12.03,Default,,0,0,0,,Сізге тағы не керек?
Dialogue: 0,1:28:12.09,1:28:14.03,Default,,0,0,0,,Егер сіз оны сол жерде қалдырсаңыз, дереу оралыңыз.
Dialogue: 0,1:28:14.04,1:28:15.07,Default,,0,0,0,,Джиро мырза осында.
Dialogue: 0,1:28:15.08,1:28:17.03,Default,,0,0,0,,Бұл фланецтің сынақ түсірілімі.
Dialogue: 0,1:28:28.00,1:28:29.03,Default,,0,0,0,,Жақсы көрінеді.
Dialogue: 0,1:28:29.06,1:28:31.06,Default,,0,0,0,,Мен мұны бір жыл бұрын орындасам ғой.
Dialogue: 0,1:28:31.07,1:28:32.09,Default,,0,0,0,,Сіз қалай ойлайсыз, Джиро мырза?
Dialogue: 0,1:28:33.09,1:28:35.08,Default,,0,0,0,,Келесі жолы бұл үйрек емес
Dialogue: 0,1:28:35.09,1:28:37.04,Default,,0,0,0,,Мен үйректей жақсы боламын деп ойлаймын.
Dialogue: 0,1:28:37.08,1:28:38.08,Default,,0,0,0,,Тағы бір… үкі ме?
Dialogue: 0,1:28:38.09,1:28:41.01,Default,,0,0,0,,Бұл толығымен металдан жасалған каму.
Dialogue: 0,1:28:41.01,1:28:42.04,Default,,0,0,0,,Курокава мырза, сіз қалай ойлайсыз?
Dialogue: 0,1:28:43.03,1:28:44.04,Default,,0,0,0,,Бұл жарық.
Dialogue: 0,1:28:44.05,1:28:47.04,Default,,0,0,0,,Дюралюминий экструзиялары - бұл сән-салтанат.
Dialogue: 0,1:28:47.04,1:28:48.08,Default,,0,0,0,,Жүріңдер, бәрі қайтсын.
Dialogue: 0,1:29:01.00,1:29:02.02,Default,,0,0,0,,Ол тіркелмеген.
Dialogue: 0,1:29:02.03,1:29:03.03,Default,,0,0,0,,Жетеді.
Dialogue: 0,1:29:04.02,1:29:05.00,Default,,0,0,0,,Ол «Fool» картасының белгісін арқалаған Стэнді қолданушы
Dialogue: 0,1:29:05.05,1:29:08.00,Default,,0,0,0,,Сақтық үшін бірнеше күн бойы жасырыныңыз.
Dialogue: 0,1:29:08.04,1:29:10.03,Default,,0,0,0,,Осы уақытта қолыңызды жоғарыдан бұрыңыз.
Dialogue: 0,1:29:10.05,1:29:12.02,Default,,0,0,0,,Менің үйіме кел. Шаруашылық ғимараты бар.
Dialogue: 0,1:29:12.03,1:29:14.00,Default,,0,0,0,,Маған бір рет пансионатқа баруға рұқсат етіңіз.
Dialogue: 0,1:29:14.01,1:29:15.00,Default,,0,0,0,,Хат келеді.
Dialogue: 0,1:29:16.02,1:29:17.05,Default,,0,0,0,,Көрсе жаман хат па?
Dialogue: 0,1:29:18.00,1:29:19.06,Default,,0,0,0,,Иә, бұл өте қиын.
Dialogue: 0,1:29:19.06,1:29:21.08,Default,,0,0,0,,Токуко сіздің жеке поштаңызды еш ойланбастан ашады.
Dialogue: 0,1:29:21.09,1:29:23.00,Default,,0,0,0,,Күйеуімнің хаты
Dialogue: 0,1:29:23.06,1:29:24.09,Default,,0,0,0,,Бұл күпірлік
Dialogue: 0,1:29:25.00,1:29:26.08,Default,,0,0,0,,Бұл қазіргі елдерде болып жатқан нақты оқиға.
Dialogue: 0,1:29:26.09,1:29:30.05,Default,,0,0,0,,Ахахахха, сен құдасың ба?
Dialogue: 0,1:29:31.04,1:29:33.05,Default,,0,0,0,,Джиро да адам болды ма? (Хаттори) Бақытты
Dialogue: 0,1:29:33.06,1:29:35.09,Default,,0,0,0,,Сіз Жапонияны заманауи мемлекет деп ойладыңыз ба?
Dialogue: 0,1:29:35.09,1:29:37.01,Default,,0,0,0,,Бұл күлкі емес
Dialogue: 0,1:29:37.07,1:29:38.07,Default,,0,0,0,,Әрине
Dialogue: 0,1:29:38.08,1:29:41.00,Default,,0,0,0,,Арнайы орта мектептер интернат үйлеріне бекітілген.
Dialogue: 0,1:29:41.02,1:29:43.01,Default,,0,0,0,,Қалағаныңызша махаббат хаттарын оқуға рұқсат етіңіз.
Dialogue: 0,1:29:43.08,1:29:46.07,Default,,0,0,0,,Келесі Әскери-теңіз күштерінің ұшағы келе жатыр, сіз мұны жасайсыз.
Dialogue: 0,1:29:47.05,1:29:49.05,Default,,0,0,0,,Компания сізді қорғау үшін барын салады.
Dialogue: 0,1:29:49.05,1:29:52.01,Default,,0,0,0,,Пайдалы адам болғанша
Dialogue: 0,1:29:52.07,1:29:54.03,Default,,0,0,0,,Қазір жұмысқа назар аударыңыз.
Dialogue: 0,1:29:59.06,1:30:02.08,Default,,0,0,0,,Сонда да қоштасу кенет болды.
Dialogue: 0,1:30:15.01,1:30:17.02,Default,,0,0,0,,Ол қазір қауіпсіз...
Dialogue: 0,1:30:17.03,1:30:19.09,Default,,0,0,0,,Сіз елден қашып үлгердіңіз деп үміттенемін.
Dialogue: 0,1:30:28.03,1:30:31.04,Default,,0,0,0,,Оңтүстік Италиядағы Неаполис қаласы.
Dialogue: 0,1:30:37.05,1:30:38.09,Default,,0,0,0,,Джиро-сан, сен телефонмен сөйлесіп тұрсың.
Dialogue: 0,1:30:40.00,1:30:40.50,Default,,0,0,0,,Иә
Dialogue: 0,1:30:41.06,1:30:42.03,Default,,0,0,0,,Сендер не істеп жатырсыңдар?!
Dialogue: 0,1:30:42.04,1:30:43.07,Default,,0,0,0,,Рахмет
Dialogue: 0,1:30:46.01,1:30:47.01,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,1:30:47.02,1:30:49.04,Default,,0,0,0,,Джиро, бұл менмін, саған телеграмма келді.
Dialogue: 0,1:30:49.09,1:30:50.08,Default,,0,0,0,,Иә
Dialogue: 0,1:30:50.09,1:30:53.04,Default,,0,0,0,,Пәтер менеджері уайымдап, маған әкелді.
Dialogue: 0,1:30:53.05,1:30:55.03,Default,,0,0,0,,Екі күн бұрын келген көрінеді.
Dialogue: 0,1:30:55.08,1:30:57.02,Default,,0,0,0,,Онда оқыңыз
Dialogue: 0,1:30:57.02,1:30:58.04,Default,,0,0,0,,Жарайды ма? (Джиро) Иә.
Dialogue: 0,1:31:00.05,1:31:04.09,Default,,0,0,0,,“Нахо кокатсубутчи…чи”
Dialogue: 0,1:31:05.02,1:31:07.04,Default,,0,0,0,,«Нахоко какецу чичи»
Dialogue: 0,1:31:14.08,1:31:16.03,Default,,0,0,0,,Сәлеметсіз бе, тыңдап жатырсыз ба?
Dialogue: 0,1:31:17.03,1:31:19.02,Default,,0,0,0,,Иә, рақмет.
Dialogue: 0,1:31:19.04,1:31:20.09,Default,,0,0,0,,Сәл күте тұрыңыз, эй...
Dialogue: 0,1:31:23.07,1:31:24.07,Default,,0,0,0,,Ум...
Dialogue: 0,1:31:26.03,1:31:28.08,Default,,0,0,0,,Токиоға жетудің ең жылдам жолын айтыңызшы.
Dialogue: 0,1:31:29.04,1:31:30.07,Default,,0,0,0,,Токиоға барасыз ба?
Dialogue: 0,1:31:30.08,1:31:33.05,Default,,0,0,0,,Иә, мен тезірек баруым керек.
Dialogue: 0,1:31:33.06,1:31:34.08,Default,,0,0,0,,Мен ешкімге оның мағынасыз өлім болғанын айтуға жол бермеймін
Dialogue: 0,1:31:35.06,1:31:37.01,Default,,0,0,0,,Жақында түстен кейінгі автобус өтеді.
Dialogue: 0,1:31:37.02,1:31:39.06,Default,,0,0,0,,Сонда сіз сағат 1-де жүретін жедел пойызға үлгересіз.
Dialogue: 0,1:31:39.07,1:31:41.09,Default,,0,0,0,,Автобусты біреу күтіп алайық. Дайын бол.
Dialogue: 0,1:31:41.09,1:31:42.09,Default,,0,0,0,,Иә
Dialogue: 0,1:31:43.03,1:31:44.02,Default,,0,0,0,,Джия Джия
Dialogue: 0,1:33:31.08,1:33:32.08,Default,,0,0,0,,Сен!
Dialogue: 0,1:33:43.02,1:33:44.07,Default,,0,0,0,,Кешіктіргенім үшін кешіріңіз.
Dialogue: 0,1:33:50.09,1:33:52.01,Default,,0,0,0,,Тасымалдау
Dialogue: 0,1:33:52.07,1:33:53.07,Default,,0,0,0,,Бұл әдемі
Dialogue: 0,1:33:54.09,1:33:55.09,Default,,0,0,0,,Мен оны жақсы көремін
Dialogue: 0,1:33:58.06,1:34:00.01,Default,,0,0,0,,Джиро-кун бақтан келеді...
Dialogue: 0,1:34:07.07,1:34:09.07,Default,,0,0,0,,Хехе...
Dialogue: 0,1:34:10.00,1:34:11.01,Default,,0,0,0,,Иә, өтінемін
Dialogue: 0,1:34:13.01,1:34:15.09,Default,,0,0,0,,Джиро әке келді.
Dialogue: 0,1:34:16.03,1:34:18.06,Default,,0,0,0,,Бірақ мен тезірек оралуым керек.
Dialogue: 0,1:34:19.01,1:34:21.06,Default,,0,0,0,,Келесі жолы мен күндізгі уақытта алдыңғы есіктен кіремін.
Dialogue: 0,1:34:21.07,1:34:23.00,Default,,0,0,0,,Бақшадан жақсырақ
Dialogue: 0,1:34:23.08,1:34:25.00,Default,,0,0,0,,Онда мен мұны істеймін.
Dialogue: 0,1:34:25.07,1:34:27.07,Default,,0,0,0,,Сау болыңыз
Dialogue: 0,1:34:28.03,1:34:29.04,Default,,0,0,0,,Нахоко да.
Dialogue: 0,1:34:30.09,1:34:32.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:34:32.05,1:34:33.04,Default,,0,0,0,,Жіберейік
Dialogue: 0,1:34:39.01,1:34:41.08,Default,,0,0,0,,Соңғы пойыз? Сосын асығыңыз
Dialogue: 0,1:34:43.09,1:34:44.09,Default,,0,0,0,,Шынында да солай ма…
Dialogue: 0,1:34:45.07,1:34:47.08,Default,,0,0,0,,Мен сенімен бірге жүрсем ғой.
Dialogue: 0,1:34:48.00,1:34:49.03,Default,,0,0,0,,Сіздің жұмысыңыз бар.
Dialogue: 0,1:34:49.04,1:34:51.03,Default,,0,0,0,,Адам өз ісімен ғана жақсы.
Dialogue: 0,1:34:51.04,1:34:52.08,Default,,0,0,0,,Енді барыңыз.
Dialogue: 0,1:35:00.05,1:35:01.08,Default,,0,0,0,,Сіз үйдесіз.
Dialogue: 0,1:35:03.01,1:35:04.09,Default,,0,0,0,,Сіз жылап жатырсыз ба?
Dialogue: 0,1:35:07.06,1:35:08.07,Default,,0,0,0,,Әке
Dialogue: 0,1:35:08.08,1:35:10.07,Default,,0,0,0,,Дәрігердің ұсынысы...
Dialogue: 0,1:35:10.08,1:35:12.02,Default,,0,0,0,,Мен Такахара ауруханасына барамын.
Dialogue: 0,1:35:12.07,1:35:13.07,Default,,0,0,0,,Өйткені сен
Dialogue: 0,1:35:13.08,1:35:16.00,Default,,0,0,0,,Осындай оңаша жерде жалғыз...
Dialogue: 0,1:35:16.09,1:35:18.02,Default,,0,0,0,,Менің емделгім келеді.
Dialogue: 0,1:35:18.08,1:35:20.07,Default,,0,0,0,,Мен Джиро-санмен бірге тұрғым келеді.
Dialogue: 0,1:35:26.03,1:35:27.08,Default,,0,0,0,,Қалай болғанда да, мен оны уақытында орындағаныма қуаныштымын.
Dialogue: 0,1:35:27.08,1:35:29.06,Default,,0,0,0,,Сізді басшылар күтуде
Dialogue: 0,1:35:35.05,1:35:38.00,Default,,0,0,0,,Кохон... ол туралы ше?
Dialogue: 0,1:35:39.03,1:35:40.05,Default,,0,0,0,,Біз бар күшімізді саламыз
Dialogue: 0,1:35:41.01,1:35:43.05,Default,,0,0,0,,Келесі кезекте Әскери-теңіз күштері, оған тапсырыс берген адам.
Dialogue: 0,1:35:43.07,1:35:45.08,Default,,0,0,0,,Менің ойымша... (Біріккен дауыстар)
Dialogue: 0,1:35:45.08,1:35:48.01,Default,,0,0,0,,(Бірлесіп сөйлейтін дауыстар) (Біріккен дауыстар) Әскери-теңіз күштері...!
Dialogue: 0,1:35:48.02,1:35:49.05,Default,,0,0,0,,Міндетті екенін айту керек...
Dialogue: 0,1:35:49.06,1:35:51.05,Default,,0,0,0,,Мұнда...
Dialogue: 0,1:35:51.06,1:35:53.06,Default,,0,0,0,,Бұл жылдамдық, бұл от күші, бұл гүл жолы.
Dialogue: 0,1:35:54.08,1:35:56.00,Default,,0,0,0,,Біз бар күшімізді саламыз
Dialogue: 0,1:35:56.04,1:35:58.08,Default,,0,0,0,,Сіз естіген жоқсыз. (Джиро) Иә.
Dialogue: 0,1:35:59.02,1:36:01.06,Default,,0,0,0,,Вахахахаха
Dialogue: 0,1:36:01.07,1:36:03.03,Default,,0,0,0,,Бұл идеядан бас тартылды.
Dialogue: 0,1:36:03.04,1:36:04.04,Default,,0,0,0,,Ахахахаха
Dialogue: 0,1:36:05.07,1:36:06.09,Default,,0,0,0,,Кеш болды.
Dialogue: 0,1:36:07.00,1:36:09.08,Default,,0,0,0,,Менеджер: Бұл ерікті оқу тобы сияқты.
Dialogue: 0,1:36:09.08,1:36:10.08,Default,,0,0,0,,Жарайды, кел.
Dialogue: 0,1:36:12.02,1:36:15.03,Default,,0,0,0,,Келесі - соңғы авиациялық технологияларды біріктіретін жоспар
Dialogue: 0,1:36:16.00,1:36:17.00,Default,,0,0,0,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,1:36:17.01,1:36:18.06,Default,,0,0,0,,Бұл тартылатын аяқ.
Dialogue: 0,1:36:18.07,1:36:20.09,Default,,0,0,0,,270 түйін жасау үшін сізге бұл керек.
Dialogue: 0,1:36:21.06,1:36:24.04,Default,,0,0,0,,270 түйін 500 км/сағ!
Dialogue: 0,1:36:25.01,1:36:27.02,Default,,0,0,0,,Әскери-теңіз күштеріне 220 түйін қажет пе?
Dialogue: 0,1:36:28.01,1:36:29.09,Default,,0,0,0,,Сонда сіз көп ұзамай уақыттан артта қаласыз.
Dialogue: 0,1:36:30.00,1:36:31.01,Default,,0,0,0,,О
Dialogue: 0,1:36:31.02,1:36:33.02,Default,,0,0,0,,Қанат жүктемесі 120 кг м2
Dialogue: 0,1:36:33.02,1:36:34.01,Default,,0,0,0,,Қазіргі соққың мүлде уақытынан тыс, аянышты болды!
Dialogue: 0,1:36:34.02,1:36:35.07,Default,,0,0,0,,Зиянды қарсылықты жою
Dialogue: 0,1:36:35.08,1:36:38.04,Default,,0,0,0,,Жаңа технологияны батыл енгізу
Dialogue: 0,1:36:39.00,1:36:41.05,Default,,0,0,0,,Бөлінетін қақпақтар, сондай-ақ қанат ұштары
Dialogue: 0,1:36:58.02,1:36:59.03,Default,,0,0,0,,Жарайды, жасайық.
Dialogue: 0,1:36:59.03,1:37:00.05,Default,,0,0,0,,♬ Құдайлардың мұнда алданған бейнелері
Dialogue: 0,1:37:00.06,1:37:03.03,Default,,0,0,0,,Өзіміз жасайық (D қызметкері) Жарайды, жасайық.
Dialogue: 0,1:37:03.04,1:37:05.02,Default,,0,0,0,,Бұл сәл ғана ауырлау.
Dialogue: 0,1:37:08.07,1:37:11.07,Default,,0,0,0,,Автоматты тақпасаң, жақсы болады.
Dialogue: 0,1:37:12.09,1:37:17.06,Default,,0,0,0,,Вахахахаха
Dialogue: 0,1:37:18.00,1:37:21.00,Default,,0,0,0,,Сондықтан мен бұл идеяны басқа уақытқа қалдыруды жөн көрдім.
Dialogue: 0,1:37:22.04,1:37:24.04,Default,,0,0,0,,Бұл қызық, түсінікті
Dialogue: 0,1:37:24.07,1:37:25.06,Default,,0,0,0,,Қандай ұят.
Dialogue: 0,1:37:26.05,1:37:28.05,Default,,0,0,0,,Біздің қозғалтқыш әлсіз.
Dialogue: 0,1:37:28.06,1:37:31.03,Default,,0,0,0,,Біздің жұмысымыз – жеңіл және төзімді ұшақ жасау.
Dialogue: 0,1:37:31.08,1:37:33.01,Default,,0,0,0,,Барынша қайраңыз.
Dialogue: 0,1:37:33.02,1:37:35.08,Default,,0,0,0,,Ауа кедергісін азайту үшін бетті тегістеңіз
Dialogue: 0,1:37:36.01,1:37:37.09,Default,,0,0,0,,Суккараканның толық металы
Dialogue: 0,1:37:38.00,1:37:39.06,Default,,0,0,0,,Дүние жүзінде ұшақтар жоқ.
Dialogue: 0,1:37:39.07,1:37:40.08,Default,,0,0,0,,Бұл біздің ұшақ.
Dialogue: 0,1:37:41.00,1:37:42.00,Default,,0,0,0,,Иә сұрақ
Dialogue: 0,1:37:42.01,1:37:43.06,Default,,0,0,0,,Сұрақ сұрақ
Dialogue: 0,1:37:43.07,1:37:45.00,Default,,0,0,0,,Хираяма мырза, өтінемін
Dialogue: 0,1:37:46.03,1:37:49.04,Default,,0,0,0,,Құрылыс бөлімінен инженер Хираяма келді.
Dialogue: 0,1:37:49.09,1:37:50.09,Default,,0,0,0,,Бұл Хираяма.
Dialogue: 0,1:37:52.09,1:37:55.08,Default,,0,0,0,,Жаңа Био туралы айтып беріңізші.
Dialogue: 0,1:37:56.07,1:37:59.09,Default,,0,0,0,,Қайыңның басын тегістеу арқылы бірдей күшті сақтау мүмкін емес.
Dialogue: 0,1:38:00.00,1:38:01.09,Default,,0,0,0,,Техникалық мүмкін емес
Dialogue: 0,1:38:02.05,1:38:03.06,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,1:38:04.03,1:38:05.04,Default,,0,0,0,,Бұл жастық басы.
Dialogue: 0,1:38:06.00,1:38:07.02,Default,,0,0,0,,Жастық басы әлдеқашан
Dialogue: 0,1:38:07.03,1:38:09.02,Default,,0,0,0,,Дүние жүзінде сыналған
Dialogue: 0,1:38:09.03,1:38:11.03,Default,,0,0,0,,Мен оны толық пайдаланамын.
Dialogue: 0,1:38:11.04,1:38:13.04,Default,,0,0,0,,Иә Сұрақ Иә Иә Иә
Dialogue: 0,1:38:16.03,1:38:18.03,Default,,0,0,0,,Бұл қызық болды.
Dialogue: 0,1:38:18.07,1:38:19.09,Default,,0,0,0,,Маған қатты әсер етті.
Dialogue: 0,1:38:40.07,1:38:42.04,Default,,0,0,0,,Сатоми мырза, бұл пошта.
Dialogue: 0,1:38:43.00,1:38:44.02,Default,,0,0,0,,«Мен, Демегава, ақыры құдайдай Кираны ұстауға тырысқан зұлым ұйымның жасырын базасын тауып алдым,
Dialogue: 0,1:40:04.02,1:40:05.06,Default,,0,0,0,,Бастық, бұл телефон.
Dialogue: 0,1:40:06.00,1:40:07.04,Default,,0,0,0,,Оны кейінірек қалдыра аласыз ба?
Dialogue: 0,1:40:07.05,1:40:08.07,Default,,0,0,0,,Бұл шұғыл мәселе сияқты.
Dialogue: 0,1:40:09.02,1:40:12.02,Default,,0,0,0,,Сәлеметсіз бе, көп болды.
Dialogue: 0,1:40:12.03,1:40:14.02,Default,,0,0,0,,Иә Иә? иә!
Dialogue: 0,1:41:27.04,1:41:29.04,Default,,0,0,0,,Джиро-сан Джиро-сан
Dialogue: 0,1:41:29.07,1:41:30.07,Default,,0,0,0,,Жақсы
Dialogue: 0,1:41:30.08,1:41:33.00,Default,,0,0,0,,Таба алмасам не істер едім деп ойладым.
Dialogue: 0,1:41:35.00,1:41:37.06,Default,,0,0,0,,Қазір бәрі жақсы. Сіз жүре аласыз ба?
Dialogue: 0,1:41:37.07,1:41:38.05,Default,,0,0,0,,Иә
Dialogue: 0,1:41:39.01,1:41:40.00,Default,,0,0,0,,Кеттік
Dialogue: 0,1:41:47.01,1:41:50.03,Default,,0,0,0,,Мен сені көргеннен кейін кетуді жоспарладым.
Dialogue: 0,1:41:50.06,1:41:51.07,Default,,0,0,0,,Үйге барма
Dialogue: 0,1:41:55.02,1:41:56.07,Default,,0,0,0,,Осында бірге тұрайық
Dialogue: 0,1:42:09.07,1:42:11.01,Default,,0,0,0,,Ал, сүйкімді серігім.
Dialogue: 0,1:42:11.02,1:42:12.04,Default,,0,0,0,,Менің атым Нахоко.
Dialogue: 0,1:42:12.05,1:42:13.08,Default,,0,0,0,,Сіз Нахокосыз.
Dialogue: 0,1:42:13.09,1:42:14.08,Default,,0,0,0,,Джиро?
Dialogue: 0,1:42:15.02,1:42:17.01,Default,,0,0,0,,Мен сенен жақсылық сұрауға келдім.
Dialogue: 0,1:42:17.05,1:42:18.04,Default,,0,0,0,,Хмм.
Dialogue: 0,1:42:18.05,1:42:20.06,Default,,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,1:42:20.07,1:42:22.03,Default,,0,0,0,,Мен үйді жалға алуға қарсы емеспін.
Dialogue: 0,1:42:22.04,1:42:25.01,Default,,0,0,0,,Бірақ тіпті үйленбеген ерлер мен әйелдер
Dialogue: 0,1:42:25.02,1:42:27.05,Default,,0,0,0,,Түнеу сияқты әдепсіз әрекеттерге жол берілмейді.
Dialogue: 0,1:42:28.03,1:42:29.08,Default,,0,0,0,,Қазір үйлен
Dialogue: 0,1:42:29.09,1:42:32.06,Default,,0,0,0,,Курокава мырза, матч ретінде әрекет етіңіз.
Dialogue: 0,1:42:33.01,1:42:34.06,Default,,0,0,0,,Дәл қазір, бүгін түнде!
Dialogue: 0,1:42:34.07,1:42:36.07,Default,,0,0,0,,Сіз сүйкімді емессіз бе?
Dialogue: 0,1:42:36.08,1:42:39.09,Default,,0,0,0,,Махаббаттан таудан шыққан сенің ерлігің.
Dialogue: 0,1:42:40.06,1:42:42.03,Default,,0,0,0,,Әкем де түсінді.
Dialogue: 0,1:42:43.00,1:42:44.08,Default,,0,0,0,,Мен де ауруханаға хабарластым.
Dialogue: 0,1:42:44.09,1:42:46.00,Default,,0,0,0,,Өтінемін
Dialogue: 0,1:42:48.09,1:42:51.08,Default,,0,0,0,,Шешілсе, әйелдің өз дайындығы бар.
Dialogue: 0,1:42:52.03,1:42:53.07,Default,,0,0,0,,Қош келдіңіз, Нахоко-сан.
Dialogue: 0,1:42:59.08,1:43:02.04,Default,,0,0,0,,Уайымдама, халқым қашанда солай.
Dialogue: 0,1:43:06.05,1:43:08.03,Default,,0,0,0,,Егер сіз оның денесі туралы ойласаңыз
Dialogue: 0,1:43:08.03,1:43:11.01,Default,,0,0,0,,Біз оны тезірек тауға қайтаруымыз керек.
Dialogue: 0,1:43:12.03,1:43:15.04,Default,,0,0,0,,Мен ұшуды тоқтатып, саған еріп жүруім керек.
Dialogue: 0,1:43:15.05,1:43:16.05,Default,,0,0,0,,Мен мұны істей алмаймын
Dialogue: 0,1:43:17.01,1:43:20.00,Default,,0,0,0,,Сіздікі махаббат емес, эгоизм емес пе?
Dialogue: 0,1:43:21.02,1:43:24.01,Default,,0,0,0,,Бізде уақыт жоқ. Мен дайынмын.
Dialogue: 0,1:43:25.06,1:43:26.07,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:43:27.07,1:43:29.09,Default,,0,0,0,,Жарайды, үлкен тойлайық.
Dialogue: 0,1:43:54.09,1:43:56.01,Default,,0,0,0,,келді
Dialogue: 0,1:43:57.07,1:43:58.06,Default,,0,0,0,,Міне, келдік
Dialogue: 0,1:44:18.01,1:44:21.09,Default,,0,0,0,,«Жеті қазынаны таста» деймін.
Dialogue: 0,1:44:22.00,1:44:25.01,Default,,0,0,0,,Бір денемен таудан түсу
Dialogue: 0,1:44:25.02,1:44:28.06,Default,,0,0,0,,Қандай әдемі қыз
Dialogue: 0,1:44:29.03,1:44:32.05,Default,,0,0,0,,Жаңбыр мен шықтан қорғайтын шатыр жоқ.
Dialogue: 0,1:44:32.06,1:44:34.08,Default,,0,0,0,,Ол сезімсіз ақымақ...
Dialogue: 0,1:44:34.09,1:44:38.00,Default,,0,0,0,,Қарсы болмасаңыз, кіріңіз.
Dialogue: 0,1:44:38.05,1:44:41.08,Default,,0,0,0,,Қазір неке байланысының уақыты.
Dialogue: 0,1:45:04.05,1:45:05.07,Default,,0,0,0,,Бұл әдемі
Dialogue: 0,1:45:42.06,1:45:44.08,Default,,0,0,0,,Курокава ханым
Dialogue: 0,1:45:45.01,1:45:48.00,Default,,0,0,0,,Баршамызға деген ыстық жанашырлық
Dialogue: 0,1:45:48.01,1:45:50.00,Default,,0,0,0,,Алғыс сөздері жоқ.
Dialogue: 0,1:45:50.05,1:45:52.07,Default,,0,0,0,,Мен бұл жақсылықты өмір бойы ұмытпаймын.
Dialogue: 0,1:45:55.05,1:45:56.04,Default,,0,0,0,,Жарайды.
Dialogue: 0,1:45:56.05,1:45:58.08,Default,,0,0,0,,Джиро-сан сияқты жақсы адамдар
Dialogue: 0,1:45:58.09,1:46:01.07,Default,,0,0,0,,Біз бақыттымыз, қымбаттым.
Dialogue: 0,1:46:01.08,1:46:05.07,Default,,0,0,0,,Иә, иә, саусың. Құттықтаймын. Құттықтаймыз.
Dialogue: 0,1:46:22.00,1:46:23.02,Default,,0,0,0,,Мен шаршадым
Dialogue: 0,1:46:23.07,1:46:26.00,Default,,0,0,0,,Мәңгі арманда жүргендеймін
Dialogue: 0,1:46:26.00,1:46:27.04,Default,,0,0,0,,Бұл дірілдеп тұр.
Dialogue: 0,1:46:28.02,1:46:29.08,Default,,0,0,0,,Жеңіл демалыңыз және демалыңыз
Dialogue: 0,1:46:31.04,1:46:32.05,Default,,0,0,0,,Келіңіз
Dialogue: 0,1:46:32.08,1:46:34.00,Default,,0,0,0,,Бірақ сіз...
Dialogue: 0,1:46:36.02,1:46:37.01,Default,,0,0,0,,Келіңіз
Dialogue: 0,1:47:19.02,1:47:21.04,Default,,0,0,0,,Нии-нии әрқашан осылай баяу ма?
Dialogue: 0,1:47:21.08,1:47:23.02,Default,,0,0,0,,Мен Кайоның келе жатқанын мүлде ұмыттым.
Dialogue: 0,1:47:23.08,1:47:25.06,Default,,0,0,0,,Жүрексіз
Dialogue: 0,1:47:27.05,1:47:30.01,Default,,0,0,0,,Құттықтаймын, дәрігер болдың.
Dialogue: 0,1:47:30.01,1:47:33.01,Default,,0,0,0,,Нии-нии-саманы үйленуіңізбен құттықтаймыз.
Dialogue: 0,1:47:33.04,1:47:35.02,Default,,0,0,0,,Курокава мырзаға қалай алғыс айту керек
Dialogue: 0,1:47:35.03,1:47:37.01,Default,,0,0,0,,Мен ата-анамның атынан сұрадым.
Dialogue: 0,1:47:37.02,1:47:38.05,Default,,0,0,0,,Курокава мырза ше?
Dialogue: 0,1:47:38.06,1:47:40.02,Default,,0,0,0,,Мен үзіліс жасадым.
Dialogue: 0,1:47:40.04,1:47:42.03,Default,,0,0,0,,Нахокомен кездестіңіз бе? (Каё) Иә.
Dialogue: 0,1:47:46.04,1:47:48.08,Default,,0,0,0,,Нии-ни, Наоко-санмен не істеуді жоспарлап отырсың?
Dialogue: 0,1:47:48.09,1:47:51.00,Default,,0,0,0,,Маған бөлек бөлмеде жалғыз ұйықтауға рұқсат етіңіз.
Dialogue: 0,1:47:51.08,1:47:55.03,Default,,0,0,0,,Наоконың ауруы Нии-ни ойлағаннан әлдеқайда ауыр.
Dialogue: 0,1:47:55.04,1:47:58.02,Default,,0,0,0,,Мен әлі де ізденуші дәрігермін, сондықтан аздап түсіндім.
Dialogue: 0,1:47:58.08,1:48:00.08,Default,,0,0,0,,Наоко-сан Нии-ниді сендіргісі келді.
Dialogue: 0,1:48:00.09,1:48:02.07,Default,,0,0,0,,Күн сайын таңертең макияжды жағып, қызаруды жағасыз ба?
Dialogue: 0,1:48:02.08,1:48:04.01,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,1:48:05.06,1:48:09.01,Default,,0,0,0,,Мен Наоконы жақсы көремін, ол өте жақсы адам.
Dialogue: 0,1:48:09.03,1:48:11.01,Default,,0,0,0,,Мен сені осылай аяймын.
Dialogue: 0,1:48:15.09,1:48:18.02,Default,,0,0,0,,Тау ауруханасына қайта оралу мүмкін емес пе?
Dialogue: 0,1:48:18.03,1:48:19.02,Default,,0,0,0,,Иә
Dialogue: 0,1:48:20.04,1:48:24.06,Default,,0,0,0,,Біз қазір әр күнді үлкен мәнмен өткізіп жатырмыз.
Dialogue: 0,1:48:27.02,1:48:30.01,Default,,0,0,0,,Қайырлы түн, келгеніңізге қуаныштымын.
Dialogue: 0,1:48:40.06,1:48:42.03,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,1:48:45.06,1:48:46.06,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,1:48:47.00,1:48:48.08,Default,,0,0,0,,Қош келдіңіз (Джиро) Ұйқы.
Dialogue: 0,1:48:55.05,1:48:56.06,Default,,0,0,0,,Амансың ба?
Dialogue: 0,1:48:56.07,1:48:58.04,Default,,0,0,0,,Кайо-сан келді.
Dialogue: 0,1:48:58.04,1:48:59.04,Default,,0,0,0,,О
Dialogue: 0,1:48:59.05,1:49:01.08,Default,,0,0,0,,Біз тез дос болдық.
Dialogue: 0,1:49:02.09,1:49:04.08,Default,,0,0,0,,Жарқыраған және болашаққа толы.
Dialogue: 0,1:49:04.09,1:49:06.07,Default,,0,0,0,,Ол Охисама сияқты.
Dialogue: 0,1:49:07.02,1:49:08.08,Default,,0,0,0,,Келесі жолы үзіліс жасаңыз.
Dialogue: 0,1:49:08.09,1:49:11.02,Default,,0,0,0,,Оның дәрігер болып келетінін естідім.
Dialogue: 0,1:49:12.07,1:49:14.08,Default,,0,0,0,,Оның үстіне анаң айтты
Dialogue: 0,1:49:14.09,1:49:17.04,Default,,0,0,0,,Менің іш киімім мен түнгі көйлегімді тіктіңіз.
Dialogue: 0,1:49:17.09,1:49:19.04,Default,,0,0,0,,Бұл өте жылы.
Dialogue: 0,1:49:20.08,1:49:21.06,Default,,0,0,0,,Бұл таң қалдырады емес пе?
Dialogue: 0,1:49:22.08,1:49:23.06,Default,,0,0,0,,Үй ойынынан біраз жалығып кеттім ғой, иә?
Dialogue: 0,1:49:26.01,1:49:28.03,Default,,0,0,0,,Мен ертеңге дейін шешуім керек.
Dialogue: 0,1:49:28.08,1:49:29.08,Default,,0,0,0,,Скумбрия сүйегі?
Dialogue: 0,1:49:29.08,1:49:31.07,Default,,0,0,0,,Хаха, есіңе түсті.
Dialogue: 0,1:49:32.08,1:49:35.02,Default,,0,0,0,,Біраз күш жұмсап, оны сәл жеңілдетуге болады деп ойлаймын.
Dialogue: 0,1:49:37.09,1:49:39.03,Default,,0,0,0,,Жақын кел
Dialogue: 0,1:49:40.04,1:49:41.02,Default,,0,0,0,,Иә?
Dialogue: 0,1:49:42.00,1:49:42.50,Default,,0,0,0,,Иә
Dialogue: 0,1:49:49.00,1:49:50.03,Default,,0,0,0,,Маған қолыңды бер
Dialogue: 0,1:49:53.08,1:49:55.00,Default,,0,0,0,,Жұмыс кезінде...
Dialogue: 0,1:49:55.00,1:49:57.07,Default,,0,0,0,,Маған Джиро-санның бетіне қараған ұнайды.
Dialogue: 0,1:49:58.06,1:50:01.03,Default,,0,0,0,,Слайд ережесін бір қолмен қолдану сайысы болса
Dialogue: 0,1:50:01.04,1:50:03.02,Default,,0,0,0,,Мен 1-ші болатыныма сенімдімін
Dialogue: 0,1:50:04.05,1:50:05.07,Default,,0,0,0,,Бұл жұмыс істейтін сияқты.
Dialogue: 0,1:50:05.08,1:50:07.07,Default,,0,0,0,,Бұл шамамен 5 фунт жеңілірек болатын сияқты.
Dialogue: 0,1:50:07.08,1:50:09.06,Default,,0,0,0,,Иә, бұл жақсы болды.
Dialogue: 0,1:50:09.08,1:50:12.01,Default,,0,0,0,,30 бөтелке үшін 150 монмеда
Dialogue: 0,1:50:12.01,1:50:13.02,Default,,0,0,0,,Тым көп.
Dialogue: 0,1:50:14.01,1:50:16.02,Default,,0,0,0,,Екі адамға арналған болса, оның жартысы жақсы.
Dialogue: 0,1:50:16.09,1:50:18.00,Default,,0,0,0,,Өйткені бұл сүйек.
Dialogue: 0,1:50:18.06,1:50:21.02,Default,,0,0,0,,Скумбрия болса, сонша жеуге болар еді.
Dialogue: 0,1:50:27.00,1:50:29.03,Default,,0,0,0,,Мен мұны саған жасаймын, сосын ұйықтай аласың.
Dialogue: 0,1:50:29.05,1:50:30.07,Default,,0,0,0,,Мені жібермейсіз бе?
Dialogue: 0,1:50:30.07,1:50:32.04,Default,,0,0,0,,Иә, мен сені жібермеймін.
Dialogue: 0,1:50:35.01,1:50:38.05,Default,,0,0,0,,Мен темекі тартқым келеді. Неге біраз уақытқа жібермейсіз?
Dialogue: 0,1:50:38.09,1:50:41.00,Default,,0,0,0,,Жоқ, мұнда темекі шегеді.
Dialogue: 0,1:50:41.06,1:50:43.05,Default,,0,0,0,,Жоқ (Нахоко) Жарайды.
Dialogue: 0,1:51:03.03,1:51:04.06,Default,,0,0,0,,Сәлем Хонджо
Dialogue: 0,1:51:05.01,1:51:06.02,Default,,0,0,0,,Мен оны қарай аламын ба? (Джиро) Иә.
Dialogue: 0,1:51:06.08,1:51:08.04,Default,,0,0,0,,Хонджо ұшақтары жақсы беделге ие.
Dialogue: 0,1:51:08.05,1:51:09.04,Default,,0,0,0,,Жақсы
Dialogue: 0,1:51:10.00,1:51:11.08,Default,,0,0,0,,Бұл авангард.
Dialogue: 0,1:51:12.05,1:51:13.07,Default,,0,0,0,,Бұл өте қиын.
Dialogue: 0,1:51:17.02,1:51:19.04,Default,,0,0,0,,Бұл өсек-жастық басы ма?
Dialogue: 0,1:51:20.06,1:51:22.00,Default,,0,0,0,,Барлық жерде
Dialogue: 0,1:51:23.05,1:51:25.02,Default,,0,0,0,,Мен әлі де қолөнермен айналысамын.
Dialogue: 0,1:51:25.05,1:51:27.01,Default,,0,0,0,,Джиро сияқты.
Dialogue: 0,1:51:27.06,1:51:30.02,Default,,0,0,0,,Сізде мен сияқты Юнкерс бөртпесі жоқ.
Dialogue: 0,1:51:32.08,1:51:35.00,Default,,0,0,0,,Мұның бәрі скумбрия сүйектері.
Dialogue: 0,1:51:35.07,1:51:36.08,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,1:51:39.04,1:51:42.04,Default,,0,0,0,,Джиро Жастық басы byyou Маған да қолдануға рұқсат етіңіз.
Dialogue: 0,1:51:42.05,1:51:44.06,Default,,0,0,0,,Сондай-ақ бұл тексеру тесігі люк.
Dialogue: 0,1:51:44.08,1:51:46.03,Default,,0,0,0,,Иә, жарайды.
Dialogue: 0,1:51:46.09,1:51:47.09,Default,,0,0,0,,бомбалаушы?
Dialogue: 0,1:51:48.00,1:51:50.02,Default,,0,0,0,,Мен сізге жаңасын құрастыруға рұқсат етіңіз дедім.
Dialogue: 0,1:51:50.03,1:51:51.09,Default,,0,0,0,,Маған тек денені өзгертуді айтыңыз.
Dialogue: 0,1:51:52.06,1:51:54.02,Default,,0,0,0,,Сіз сол негізгі қанатты әлі де пайдаланасыз ба?
Dialogue: 0,1:51:54.03,1:51:57.01,Default,,0,0,0,,Оның көп бөлігі жанармай багы. 2-3 ату өртті тудырады.
Dialogue: 0,1:51:58.00,1:51:59.07,Default,,0,0,0,,Бұл ең оқ өткізбейтін танк.
Dialogue: 0,1:51:59.08,1:52:01.06,Default,,0,0,0,,Мен бұл туралы ешқандай зерттеу жүргізген жоқпын.
Dialogue: 0,1:52:01.07,1:52:03.02,Default,,0,0,0,,Әскери-теңіз флоты Жапониядағы бірінші.
Dialogue: 0,1:52:03.03,1:52:05.05,Default,,0,0,0,,Мен дұрыс ұшатын ұшақ жасағаныма қатты қуандым.
Dialogue: 0,1:52:07.07,1:52:09.05,Default,,0,0,0,,Ашық бомбаларды ілу
Dialogue: 0,1:52:09.05,1:52:11.06,Default,,0,0,0,,Мылтық мұнарасы бекітілген 3000 километрге ұшу.
Dialogue: 0,1:52:12.01,1:52:14.05,Default,,0,0,0,,Қуатты аздап қосу уақытында орындалмайды
Dialogue: 0,1:52:18.03,1:52:19.08,Default,,0,0,0,,(Мылтық дыбысы)
Dialogue: 0,1:52:27.09,1:52:29.06,Default,,0,0,0,,Біз кіммен соғысамыз?
Dialogue: 0,1:52:29.07,1:52:33.09,Default,,0,0,0,,Қытай Кеңес Одағы Ұлыбритания Нидерланды Америка Құрама Штаттары
Dialogue: 0,1:52:33.09,1:52:35.01,Default,,0,0,0,,Бұл харецу.
Dialogue: 0,1:52:36.02,1:52:38.03,Default,,0,0,0,,Біз қару сатушы емеспіз
Dialogue: 0,1:52:38.04,1:52:40.02,Default,,0,0,0,,Мен жақсы ұшақтар жасағым келеді.
Dialogue: 0,1:52:40.03,1:52:41.03,Default,,0,0,0,,That's right.
Dialogue: 0,1:52:41.04,1:52:43.03,Default,,0,0,0,,Олай болса, біраз ұйықтау керек.
Dialogue: 0,1:52:43.04,1:52:44.09,Default,,0,0,0,,Ах Хонджо Мона
Dialogue: 0,1:52:46.06,1:52:48.00,Default,,0,0,0,,Алдын ала кешіріңіз.
Dialogue: 0,1:52:48.01,1:52:49.02,Default,,0,0,0,,Мейірім көрсетпе.
Dialogue: 0,1:52:49.08,1:52:50.07,Default,,0,0,0,,Иә
Dialogue: 0,1:53:16.04,1:53:17.04,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,1:53:18.02,1:53:20.09,Default,,0,0,0,,Орындалды, тек қана ұшып кетсін
Dialogue: 0,1:53:21.06,1:53:24.04,Default,,0,0,0,,Еңбекқорлығыңыз үшін құттықтаймыз
Dialogue: 0,1:53:25.04,1:53:27.07,Default,,0,0,0,,Сиыр тартып алған аэродромға бардым.
Dialogue: 0,1:53:28.04,1:53:30.08,Default,,0,0,0,,Мен сонда біраз уақыт қалатын сияқтымын.
Dialogue: 0,1:53:31.08,1:53:33.02,Default,,0,0,0,,Сіз шаршаған болуыңыз керек.
Dialogue: 0,1:53:35.08,1:53:37.01,Default,,0,0,0,,Аз ғана.
Dialogue: 0,1:53:37.05,1:53:39.05,Default,,0,0,0,,Оның жақсы ұшатынына сенімдімін.
Dialogue: 0,1:53:40.01,1:53:42.01,Default,,0,0,0,,Иә, ұшады.
Dialogue: 0,1:53:43.06,1:53:45.07,Default,,0,0,0,,Нахокоға осында болғаныңыз үшін рахмет.
Dialogue: 0,1:53:46.04,1:53:48.03,Default,,0,0,0,,Мен Джиро-санды жақсы көремін
Dialogue: 0,1:53:49.01,1:53:50.02,Default,,0,0,0,,Нахоко...
Dialogue: 0,1:54:43.08,1:54:45.01,Default,,0,0,0,,Жүректеріңізді құрбан етіңіздер!! Жүректеріңізді құрбан етіңіздер!! (Әскери полиция) Хич
Dialogue: 0,1:54:45.02,1:54:46.04,Default,,0,0,0,,Сәттілік
Dialogue: 0,1:55:13.00,1:55:14.04,Default,,0,0,0,,О, Наоко-сан
Dialogue: 0,1:55:15.02,1:55:17.08,Default,,0,0,0,,Әпке, мен бүгін таңертең өзімді жақсы сезінемін, сондықтан...
Dialogue: 0,1:55:17.09,1:55:19.09,Default,,0,0,0,,Мен осы жерде біраз серуендеймін.
Dialogue: 0,1:55:20.02,1:55:22.06,Default,,0,0,0,,Иә, өзіңізді қатты итермеңіз.
Dialogue: 0,1:55:22.07,1:55:23.05,Default,,0,0,0,,Иә
Dialogue: 0,1:55:24.02,1:55:26.00,Default,,0,0,0,,Сіз бөлмеңізді әбігерге түсірдіңіз.
Dialogue: 0,1:55:26.05,1:55:28.00,Default,,0,0,0,,Мен қайтып келгенде тазалаймын.
Dialogue: 0,1:55:28.08,1:55:30.08,Default,,0,0,0,,Түсіндім, келіңдер.
Dialogue: 0,1:55:31.02,1:55:33.05,Default,,0,0,0,,Бүгін Кайо-сан келетін күн. Мен оны асыға күтемін.
Dialogue: 0,1:55:34.01,1:55:35.09,Default,,0,0,0,,Иә, барамын.
Dialogue: 0,1:56:17.05,1:56:19.02,Default,,0,0,0,,Келіңіз.
Dialogue: 0,1:56:25.08,1:56:27.03,Default,,0,0,0,,Бәрін тек қана жап-жасырып қойдың ба?
Dialogue: 0,1:56:36.03,1:56:37.09,Default,,0,0,0,,Әпке, маған хат келді!
Dialogue: 0,1:56:38.00,1:56:39.02,Default,,0,0,0,,Кейбіреулері маған бағытталған
Dialogue: 0,1:56:45.04,1:56:48.00,Default,,0,0,0,,Үлкен әпкесі Нахоко тауға қайтады.
Dialogue: 0,1:56:48.01,1:56:49.07,Default,,0,0,0,,Мен сізге қайта қоңырау шаламын.
Dialogue: 0,1:56:49.08,1:56:51.07,Default,,0,0,0,,Жоқ, мені қума!
Dialogue: 0,1:56:54.02,1:56:56.00,Default,,0,0,0,,Нахоко пойызға мінгенше
Dialogue: 0,1:56:56.01,1:56:57.07,Default,,0,0,0,,Оны жайына қалдырайық
Dialogue: 0,1:56:59.03,1:57:00.07,Default,,0,0,0,,Тек әдемі жерлер―
Dialogue: 0,1:57:00.08,1:57:02.09,Default,,0,0,0,,Сізге ұнайтын адам болды ма?
Dialogue: 0,1:57:08.01,1:57:11.06,Default,,0,0,0,,Ууууууууу...
Dialogue: 0,1:57:49.09,1:57:51.05,Default,,0,0,0,,Бұл жақсы
Dialogue: 0,1:57:51.06,1:57:53.08,Default,,0,0,0,,Мен өзімді шет елде жүргендей сезінемін.
Dialogue: 0,1:57:53.09,1:57:55.07,Default,,0,0,0,,Сіз қанша жылдамдық алдыңыз?
Dialogue: 0,1:57:56.02,1:57:59.03,Default,,0,0,0,,Кешіріңіз, мен есептеуді қайта жасап жатырмын, бұл өте жылдам.
Dialogue: 0,1:57:59.08,1:58:01.01,Default,,0,0,0,,Қанша түйін бар?
Dialogue: 0,1:58:01.01,1:58:02.07,Default,,0,0,0,,240 түйін
Dialogue: 0,1:58:02.07,1:58:04.02,Default,,0,0,0,,240!
Dialogue: 0,1:58:36.09,1:58:39.02,Default,,0,0,0,,«Түстен кейінге дейін тікелей эфир»
Dialogue: 0,1:58:39.06,1:58:40.06,Default,,0,0,0,,Иә! Алақай!
Dialogue: 0,1:58:40.07,1:58:42.02,Default,,0,0,0,,(Қарғыс атқан рухтың айқайы)
Dialogue: 0,1:58:42.07,1:58:43.08,Default,,0,0,0,,Банзай!
Dialogue: 0,1:58:43.09,1:58:44.09,Default,,0,0,0,,Сәлем Джиро
Dialogue: 0,1:58:45.07,1:58:46.07,Default,,0,0,0,,Джиро
Dialogue: 0,1:58:50.09,1:58:53.04,Default,,0,0,0,,Құттықтаймыз! Құттықтаймыз!
Dialogue: 0,1:58:54.08,1:58:57.04,Default,,0,0,0,,Бұл керемет ұшақ. Рақмет сізге.
Dialogue: 0,1:58:58.08,1:59:00.00,Default,,0,0,0,,«Түстен кейінге дейін тікелей эфир»
Dialogue: 0,1:59:02.04,1:59:03.08,Default,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,1:59:04.05,1:59:05.08,Default,,0,0,0,,Жылдамдық көрсетілсе, тере аласың ба?
Dialogue: 0,1:59:06.06,1:59:07.09,Default,,0,0,0,,Жылдамдық көрсетілсе, тере аласың ба?
Dialogue: 0,2:00:10.04,2:00:13.06,Default,,0,0,0,,Сәлем, жапон баласы
Dialogue: 0,2:00:15.00,2:00:16.02,Default,,0,0,0,,Капрони мырза
Dialogue: 0,2:00:20.00,2:00:23.02,Default,,0,0,0,,Бұл біздің ең алғаш танысқан жеріміз.
Dialogue: 0,2:00:23.02,2:00:25.06,Default,,0,0,0,,Біздің армандарымыздың патшалығы
Dialogue: 0,2:00:25.09,2:00:27.09,Default,,0,0,0,,Мен бұл тозақ деп ойладым
Dialogue: 0,2:00:28.00,2:00:30.08,Default,,0,0,0,,Бұл сәл басқаша, бірақ менің ойымша, бұл ұқсас ...
Dialogue: 0,2:00:31.04,2:00:33.03,Default,,0,0,0,,Сіздің 10 жылыңыз қалай өтті?
Dialogue: 0,2:00:33.03,2:00:35.00,Default,,0,0,0,,Сіз қолыңыздан келгеннің бәрін жасадыңыз ба?
Dialogue: 0,2:00:35.03,2:00:38.01,Default,,0,0,0,,Иә, соңы бейберекет болды.
Dialogue: 0,2:00:38.05,2:00:40.05,Default,,0,0,0,,Өйткені олар елді ойрандады.
Dialogue: 0,2:00:41.00,2:00:43.04,Default,,0,0,0,,Дұрыс, сіздің нөліңіз
Dialogue: 0,2:01:21.01,2:01:23.09,Default,,0,0,0,,Әдемі, жақсы жұмыс
Dialogue: 0,2:01:24.03,2:01:26.03,Default,,0,0,0,,Бірде-бір ұшақ оралмады.
Dialogue: 0,2:01:26.07,2:01:29.00,Default,,0,0,0,,Жеңетін және қайтатын ештеңе жоқ
Dialogue: 0,2:01:29.06,2:01:32.03,Default,,0,0,0,,Ұшақтар - әдемі, бірақ қарғыс атқан арман.
Dialogue: 0,2:01:32.07,2:01:34.09,Default,,0,0,0,,Аспан бәрін жұтады
Dialogue: 0,2:01:36.07,2:01:38.04,Default,,0,0,0,,Сізді біреу күтіп тұр
Dialogue: 0,2:01:53.07,2:01:54.07,Default,,0,0,0,,Нахоко...
Dialogue: 0,2:01:55.00,2:01:57.09,Default,,0,0,0,,Мен сенің келуіңді осында күттім.
Dialogue: 0,2:01:58.07,2:02:01.00,Default,,0,0,0,,Сен тірісің
Dialogue: 0,2:02:05.03,2:02:06.04,Default,,0,0,0,,Тікелей эфир
Dialogue: 0,2:02:07.09,2:02:09.06,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,2:02:28.09,2:02:30.08,Default,,0,0,0,,Ол кетті.
Dialogue: 0,2:02:32.02,2:02:34.04,Default,,0,0,0,,Ол әдемі жел сияқты.
Dialogue: 0,2:02:36.00,2:02:37.00,Default,,0,0,0,,Рахмет
Dialogue: 0,2:02:38.05,2:02:39.06,Default,,0,0,0,,Рахмет
Dialogue: 0,2:02:41.03,2:02:43.02,Default,,0,0,0,,Сіз өмір сүруіңіз керек
Dialogue: 0,2:02:43.08,2:02:45.08,Default,,0,0,0,,Оған дейін неге тоқтамайсың?
Dialogue: 0,2:02:45.09,2:02:47.09,Default,,0,0,0,,Жақсы шарап бар
Dialogue: 0,2:03:10.08,2:03:15.00,Default,,0,0,0,,♪ «Ұшақ бұлты»
Dialogue: 0,2:03:19.01,2:03:23.06,Default,,0,0,0,,♪ Ақ беткей
Dialogue: 0,2:03:25.01,2:03:30.01,Default,,0,0,0,,♪ Аспанға дейін жалғасты
Dialogue: 0,2:03:30.07,2:03:34.09,Default,,0,0,0,,♪ Тербелген көлеңке
Dialogue: 0,2:03:36.01,2:03:40.02,Default,,0,0,0,,♪ Сол баланы ораңыз
Dialogue: 0,2:03:40.08,2:03:46.03,Default,,0,0,0,,♪ Ешкім байқамайды, біреу ғана
Dialogue: 0,2:03:47.04,2:03:52.03,Default,,0,0,0,,♪ Сол бала өсіп келеді
Dialogue: 0,2:03:52.09,2:03:57.04,Default,,0,0,0,,♪ Ештеңеден қорықпа
Dialogue: 0,2:03:58.00,2:04:03.02,Default,,0,0,0,,♪ Ал қалықтаңыз
Dialogue: 0,2:04:03.07,2:04:08.06,Default,,0,0,0,,♪ Аспанға тамсану
Dialogue: 0,2:04:09.02,2:04:14.04,Default,,0,0,0,,♪ Аспаннан өту
Dialogue: 0,2:04:15.01,2:04:20.04,Default,,0,0,0,,♪ Ол баланың өмірі
Dialogue: 0,2:04:20.04,2:04:24.09,Default,,0,0,0,,♪ Ұшақ бұлты
Dialogue: 0,2:04:26.02,2:04:30.05,Default,,0,0,0,,♪ Сол биік терезе
Dialogue: 0,2:04:32.01,2:04:37.01,Default,,0,0,0,,♪ Ол бала өлмес бұрын да
Dialogue: 0,2:04:37.06,2:04:41.09,Default,,0,0,0,,♪ Аспанға қарап тұрдым
Dialogue: 0,2:04:43.01,2:04:47.02,Default,,0,0,0,,♪ Мен қазір білмеймін
Dialogue: 0,2:04:48.01,2:04:53.01,Default,,0,0,0,,♪ Басқалар түсінбейді
Dialogue: 0,2:04:54.06,2:05:00.00,Default,,0,0,0,,♪ Тым жас
Dialogue: 0,2:05:00.01,2:05:04.06,Default,,0,0,0,,♪ Тек ойлау
Dialogue: 0,2:05:05.06,2:05:10.02,Default,,0,0,0,,♪ Бірақ бақыт
Dialogue: 0,2:05:10.09,2:05:15.09,Default,,0,0,0,,♪ Аспанға тамсану
Dialogue: 0,2:05:16.05,2:05:21.09,Default,,0,0,0,,♪ Аспаннан өту
Dialogue: 0,2:05:22.05,2:05:27.07,Default,,0,0,0,,♪ Ол баланың өмірі
Dialogue: 0,2:05:27.08,2:05:32.01,Default,,0,0,0,,♪ Ұшақ бұлты
Dialogue: 0,2:05:33.03,2:05:38.02,Default,,0,0,0,,♪ Аспанға тамсану
Dialogue: 0,2:05:38.08,2:05:43.09,Default,,0,0,0,,♪ Аспаннан өту
Dialogue: 0,2:05:44.08,2:05:50.01,Default,,0,0,0,,♪ Ол баланың өмірі
Dialogue: 0,2:05:50.02,2:05:56.01,Default,,0,0,0,,♪ Ұшақ бұлты
