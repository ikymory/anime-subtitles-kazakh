Dialogue: 0,0:01:32.99,0:01:35.99,Staff,,0,0,0,,Аударма: InsWan Arlastor мектебі: Rhéy шағын бизнес \h\h\h\h\h\h\h\h\h\h\h Уақыт: Ioroid EastonYuu Ерекшеліктер: InsWan жүйесі: Chanter аудармасы: Aki
Dialogue: 4,0:01:41.11,0:01:44.61,Default - CN,,0,0,0,,Жаңбырдың салдарынан үй ішінде де аз мөлшерде су бар.
Dialogue: 4,0:01:46.58,0:01:49.63,Default - CN,,0,0,0,,Кешенді станцияның ішкі курсы және қалалық бекітілген аяқталуы
Dialogue: 4,0:01:50.09,0:01:52.44,Default - CN,,0,0,0,,Сондай-ақ, әдемі жерге қашуға болатын аймақ.
Dialogue: 4,0:01:53.14,0:01:55.16,Default - CN,,0,0,0,,Қала сол кезде жойылады деп шешілді.
Dialogue: 4,0:01:56.01,0:02:00.35,Default - CN,,0,0,0,,Кіру орны, айналадағы декорация, үстел орны, жарық
Dialogue: 4,0:02:01.05,0:02:03.56,Default - CN,,0,0,0,,Өзіндік рефлексия мен көріністі жан-жақты қарастыру
Dialogue: 4,0:02:04.91,0:02:07.16,Default - CN,,0,0,0,,Теңіз мильіндегі терең теңіз көрінісін қайта түсіріңіз
Dialogue: 4,0:02:14.17,0:02:16.13,Default - CN,,0,0,0,,Мәліметтерді сығу
Dialogue: 4,0:02:16.13,0:02:17.60,Default - CN,,0,0,0,,Мүсіннің таққа отыруы
Dialogue: 4,0:02:17.82,0:02:18.87,Default - CN,,0,0,0,,Жарықтандыру OK
Dialogue: 4,0:02:19.06,0:02:20.26,Default - CN,,0,0,0,,Арпа желінің ақауы
Dialogue: 4,0:02:21.06,0:02:23.29,Default - CN,,0,0,0,,6-көрініс №51
Dialogue: 4,0:02:23.56,0:02:24.34,Default - CN,,0,0,0,,Дайындық
Dialogue: 4,0:02:24.97,0:02:25.47,Default - CN,,0,0,0,,Басталуы
Dialogue: 4,0:02:27.67,0:02:29.79,Default - CN,,0,0,0,,Жазу тақтасындағы таза дауыс
Dialogue: 4,0:02:30.13,0:02:31.59,Default - CN,,0,0,0,,Шотен машинасының ашу жүйесі
Dialogue: 4,0:02:32.41,0:02:35.15,Default - CN,,0,0,0,,Мен ауамен қоршалғанмын.
Dialogue: 4,0:02:35.70,0:02:38.54,Default - CN,,0,0,0,,Будда қаласындағы бір жылдық жарық
Dialogue: 4,0:02:38.81,0:02:40.95,Default - CN,,0,0,0,,Уақыттың маңызды үрдісі
Dialogue: 4,0:02:42.01,0:02:45.96,Default - CN,,0,0,0,,Жалпы Будда өмірінің қысқа сәті
Dialogue: 4,0:02:48.25,0:02:50.20,Default - CN,,0,0,0,,Менің фамилиям Кана Арима.
Dialogue: 4,0:02:50.65,0:02:54.45,Default - CN,,0,0,0,,Данышпан ретінде құрметке ие.
Dialogue: 4,0:02:54.93,0:02:56.51,Default - CN,,0,0,0,,Ол телефонда қайтадан пайда болады.
Dialogue: 4,0:02:56.51,0:02:58.20,Default - CN,,0,0,0,,Кана Йорикай
Dialogue: 4,0:02:58.49,0:02:59.44,Default - CN,,0,0,0,,Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр
Dialogue: 4,0:03:02.24,0:03:02.89,Default - CN,,0,0,0,,Бұл рөл де біраз қиын екен…
Dialogue: 4,0:03:04.24,0:03:06.96,Default - CN,,0,0,0,,Менің талантымның қандай екенін білмеймін.
Dialogue: 4,0:03:07.50,0:03:10.08,Default - CN,,0,0,0,,Белгілі бір адамның қазіргі күш-жігері негізгі болып табылады.
Dialogue: 4,0:03:11.11,0:03:14.20,Default - CN,,0,0,0,,Мен ұйымда адамдардың бар екенін білмеймін.
Dialogue: 4,0:03:15.41,0:03:18.55,Default - CN,,0,0,0,,Қазіргі уақытта мен «Өлім шақыру жұлдызы» деген атпен жұмыс істеймін.
Dialogue: 4,0:03:23.01,0:03:26.77,Default - CN,,0,0,0,,Бастауыш мектепте оқып жүрген кезімде мен мектепте болдым.
Dialogue: 4,0:03:27.56,0:03:32.15,Default - CN,,0,0,0,,Өнеркәсіптегі өзін-өзі күтудің негізгі бұрышы
Dialogue: 4,0:03:32.66,0:03:34.73,Default - CN,,0,0,0,,Ең жақсы туындылардың бірі
Dialogue: 4,0:03:35.62,0:03:37.84,Default - CN,,0,0,0,,Бұл шығарма шөп пен қоғамның тамырына негізделген.
Dialogue: 4,0:03:40.30,0:03:41.61,Default - CN,,0,0,0,,Гачидоның дауысы
Dialogue: 4,0:03:41.61,0:03:44.05,Default - CN,,0,0,0,,Бұл ешкім құтқара алмайтын құтқару жұмысы; менің табиғатым даналық.
Dialogue: 4,0:03:45.03,0:03:46.64,Default - CN,,0,0,0,,Қолжетімсіз өнімділік
Dialogue: 4,0:03:47.35,0:03:51.37,Default - CN,,0,0,0,,Жаңартылған 4-эпизод: Көңілсіздік
Dialogue: 4,0:03:51.90,0:03:53.85,Default - CN,,0,0,0,,Сәтсіз жұмыс ретінде белгіленген
Dialogue: 4,0:03:55.01,0:03:57.39,Default - CN,,0,0,0,,Әйтсе де, келіңіз де, жеңілдік алыңыз.
Dialogue: 4,0:03:58.19,0:04:00.77,Default - CN,,0,0,0,,Бұл көрініс түпнұсқа шығармадағы әйгілі көрініс.
Dialogue: 4,0:04:01.34,0:04:03.23,Default - CN,,0,0,0,,Батырдың жоғалуы маньяктың шешімі
Dialogue: 4,0:04:03.97,0:04:07.24,Default - CN,,0,0,0,,Махаббат туралы ештеңе білмейтін қыз, бірінші қорғаушы
Dialogue: 4,0:04:07.54,0:04:08.72,Default - CN,,0,0,0,,Эмоциялық көз жасын төгу
Dialogue: 4,0:04:09.61,0:04:12.04,Default - CN,,0,0,0,,Манга оқиғасы: Ауылға жететін уақыт келгенде, жиналыс түседі.
Dialogue: 4,0:04:12.38,0:04:14.92,Default - CN,,0,0,0,,Бұл мен көрген ең қуанышты көрініс.
Dialogue: 4,0:04:16.28,0:04:19.41,Default - CN,,0,0,0,,Жақсы бағыт пен жақсы бағыттың қосындысы
Dialogue: 4,0:04:19.41,0:04:21.19,Default - CN,,0,0,0,,Ең көрнекті спектакль оқиғасы
Dialogue: 4,0:04:21.78,0:04:22.74,Default - CN,,0,0,0,,Белгілі бір пайда мен пайда
Dialogue: 4,0:04:23.37,0:04:25.99,Default UP Small - CN,,0,0,0,,Бірнеше мәселе
Dialogue: 4,0:04:26.94,0:04:29.08,Default UP Small - CN,,0,0,0,,Бұл сіз ойлаған нәрсе.
Dialogue: 4,0:04:29.82,0:04:31.14,Default - CN,,0,0,0,,Біріктірілген альтруистік өнімділік
Dialogue: 4,0:04:31.77,0:04:32.21,Default UP Small - CN,,0,0,0,,Енді олар жай ғана кішігірім бандиттер тобы
Dialogue: 4,0:04:32.21,0:04:34.00,Default UP Small - CN,,0,0,0,,Мен сенімен кездескім келмейді.
Dialogue: 4,0:04:35.71,0:04:37.17,Default - CN,,0,0,0,,Адал теріс қылық
Dialogue: 4,0:04:37.17,0:04:38.59,Default - CN,,0,0,0,,Заңның тамыры
Dialogue: 4,0:04:39.21,0:04:42.39,Default - CN,,0,0,0,,Осы салада ойнайтын басқа актерлерді көру жақсы.
Dialogue: 4,0:04:42.88,0:04:45.10,Default - CN,,0,0,0,,Бұл дұрыс емес екені рас.
Dialogue: 4,0:04:45.10,0:04:48.04,Default - CN,,0,0,0,,Жаңа өмірден таң қалдыратын көрініс
Dialogue: 4,0:04:48.90,0:04:51.45,Default - CN,,0,0,0,,Шынайы өмірде әрекет ету
Dialogue: 4,0:04:52.44,0:04:53.65,Default - CN,,0,0,0,,Қосымша оқу…
Dialogue: 4,0:05:05.30,0:05:07.88,Default - CN,,0,0,0,,Судың даусы да естілді.
Dialogue: 4,0:05:08.14,0:05:09.13,Default - CN,,0,0,0,,Міндетті тоқтату
Dialogue: 4,0:05:09.13,0:05:09.65,Default - CN,,0,0,0,,Пайдаланылмаған
Dialogue: 4,0:05:11.54,0:05:13.16,Default - CN,,0,0,0,,Картаны ұстаңыз
Dialogue: 4,0:05:16.21,0:05:19.61,Default UP Small - CN,,0,0,0,,Бұл әйел негізінен әдепсіз.
Dialogue: 4,0:05:20.45,0:05:24.59,Default UP Small - CN,,0,0,0,,Өзі кім болса да, кім болса да, ең жақсысы.
Dialogue: 4,0:05:25.56,0:05:29.16,Default UP Small - CN,,0,0,0,,Наясукевага - дәл сол адам
Dialogue: 4,0:05:23.00,0:05:23.61,Default - CN,,0,0,0,,Осы жағдайды ескерсек, алдымен мейрамханаға кіріп алсақ па?
Dialogue: 4,0:05:24.27,0:05:27.15,Default - CN,,0,0,0,,Бұрын қойылымды көру мүмкін болмады.
Dialogue: 4,0:05:28.01,0:05:30.37,Default - CN,,0,0,0,,Аяқтардың уақыт фазасының қатынасы әсерлі.
Dialogue: 4,0:05:31.86,0:05:34.06,Default - CN,,0,0,0,,Менде Айнадай талант бар
Dialogue: 4,0:05:34.65,0:05:36.91,Default - CN,,0,0,0,,Аттракционды тамашалауға болмайтын жер
Dialogue: 4,0:05:37.21,0:05:38.86,Default - CN,,0,0,0,,Актерлік шеберлік те жақсы.
Dialogue: 4,0:05:39.91,0:05:42.66,Default - CN,,0,0,0,,Шығыс және Батыс Капиталдың практикалық қолданылуына байланысты
Dialogue: 4,0:05:43.74,0:05:47.12,Default - CN,,0,0,0,,Тапсырмалар: Бейнелеуші, жарық, орындаушылар
Dialogue: 4,0:05:47.90,0:05:49.36,Default - CN,,0,0,0,,Барлығы Токио пайдалану үшін
Dialogue: 4,0:05:49.80,0:05:51.25,Default - CN,,0,0,0,,Құлаған заңның мүсіні, Айнаса
Dialogue: 4,0:05:55.93,0:05:56.70,Default - CN,,0,0,0,,Сені жақсы көремін
Dialogue: 4,0:05:57.15,0:05:58.86,Default - CN,,0,0,0,,Мен жақын арада шындықты көре аламын.
Dialogue: 4,0:06:00.11,0:06:01.94,Default - CN,,0,0,0,,Қайтыс болғаннан кейінгі кезеңге қалай дайындалу керектігі туралы әңгіме.
Dialogue: 4,0:06:04.79,0:06:06.54,Default - CN,,0,0,0,,Жарайды, бұл тек менің жеке пікірім ғана.
Dialogue: 4,0:06:11.29,0:06:13.08,Default UP Small - CN,,0,0,0,,Сен өлгенде
Dialogue: 4,0:06:13.08,0:06:15.65,Default UP Small - CN,,0,0,0,,Менің әңгімем, әйелдің негізгі мәртебесі сақтандырумен қамтылмаған.
Dialogue: 4,0:06:15.97,0:06:20.00,Default - CN,,0,0,0,,Кішкентай жын, жапон тілінің станциясы және Токиодағы еркін агент.
Dialogue: 4,0:06:20.27,0:06:21.10,Default - CN,,0,0,0,,Пайдаланылмаған аялдама
Dialogue: 4,0:06:21.60,0:06:22.76,Default - CN,,0,0,0,,№2 парта да келеді
Dialogue: 4,0:06:23.29,0:06:24.63,Default - CN,,0,0,0,,Жарықтың бір нүктесі
Dialogue: 4,0:06:25.78,0:06:28.35,Default UP Small - CN,,0,0,0,,Бұл менің маңызды досым.
Dialogue: 4,0:06:29.07,0:06:29.71,Default - CN,,0,0,0,,Әрине, бөлек.
Dialogue: 4,0:06:30.62,0:06:31.40,Default - CN,,0,0,0,,Рұқсат етілген
Dialogue: 4,0:06:32.42,0:06:34.12,Default - CN,,0,0,0,,Өте ерекше әсер
Dialogue: 4,0:06:35.44,0:06:37.20,Default - CN,,0,0,0,,Бұл түпнұсқа шығармадағы әйгілі орын
Dialogue: 4,0:06:37.93,0:06:40.46,Default - CN,,0,0,0,,Директордың идеясы
Dialogue: 4,0:06:41.05,0:06:42.30,Default - CN,,0,0,0,,Бүкіл қала мағыналы
Dialogue: 4,0:06:43.75,0:06:47.76,Default - CN,,0,0,0,,Автордың ниетіне бұрынғы талдау
Dialogue: 4,0:06:48.81,0:06:51.99,Default - CN,,0,0,0,,Дұрыс түсіндірмесі бар шедевр
Dialogue: 4,0:06:53.04,0:06:55.09,Default - CN,,0,0,0,,Аяқталған кезең дайындықтары аяқталды
Dialogue: 4,0:06:55.54,0:06:56.82,Default - CN,,0,0,0,,Youya's Thoughtful Exhibition анықтамалығы
Dialogue: 4,0:06:57.42,0:06:59.98,Default - CN,,0,0,0,,Кана Арима
Dialogue: 4,0:07:03.86,0:07:05.54,Default - CN,,0,0,0,,Өлгің келе ме?
Dialogue: 4,0:07:06.14,0:07:07.01,Default - CN,,0,0,0,,Жергілікті көрініс
Dialogue: 4,0:07:07.59,0:07:09.87,Default - CN,,0,0,0,,Ең үлкен нүкте – әйел қожайынның көз жасы.
Dialogue: 4,0:07:10.66,0:07:12.70,Default - CN,,0,0,0,,Бір жарық нүктесі
Dialogue: 4,0:07:13.32,0:07:15.03,Default - CN,,0,0,0,,Қара қараңғылық
Dialogue: 4,0:07:19.11,0:07:21.21,Default - CN,,0,0,0,,Қосылғанда немесе өлгенде
Dialogue: 4,0:07:22.43,0:07:23.20,Default - CN,,0,0,0,,Қорқыныш
Dialogue: 4,0:07:24.04,0:07:24.80,Default - CN,,0,0,0,,Камакана
Dialogue: 4,0:07:31.04,0:07:33.69,Default UP Small - CN,,0,0,0,,Керек емес адамдардың суреттері
Dialogue: 4,0:07:33.92,0:07:36.19,Default UP Small - CN,,0,0,0,,Өзін-өзі тану мен оятудың бір нүктесі
Dialogue: 4,0:07:36.19,0:07:37.94,Default UP Small - CN,,0,0,0,,Тағы бір әдемі түс
Dialogue: 4,0:07:38.19,0:07:40.30,Default UP Small - CN,,0,0,0,,Қол жеткізуге болатын нәрселер
Dialogue: 4,0:07:40.62,0:07:43.41,Default UP Small - CN,,0,0,0,,Қараңғыдағы өміріңіздің бір бөлігі
Dialogue: 4,0:07:48.18,0:07:49.07,Default - CN,,0,0,0,,Жақсы — қысқа шөптер де жеткілікті
Dialogue: 4,0:07:49.92,0:07:52.06,Default - CN,,0,0,0,,Тек қана Кананың жылай алатын қабілеті болуы керек.
Dialogue: 4,0:07:55.28,0:07:56.26,Default UP Small - CN,,0,0,0,,Мұнда тікелей хабаршы
Dialogue: 4,0:07:57.61,0:07:58.55,Default UP Small - CN,,0,0,0,,Мұнда тікелей хабаршы
Dialogue: 4,0:07:59.00,0:08:00.46,Default UP Small - CN,,0,0,0,,Жарық шоғы – болмыс
Dialogue: 4,0:08:06.92,0:08:09.55,Default - CN,,0,0,0,,Әңгіменің шығу тегі Бұл сіздің сүйікті ойнау тәсілі
Dialogue: 4,0:08:17.33,0:08:18.14,Default - CN,,0,0,0,,Кешір мені.
Dialogue: 4,0:08:19.04,0:08:20.49,Default - CN,,0,0,0,,Жұдырықпен шабуыл сіз аяқтағаннан кейін келді.
Dialogue: 4,0:08:20.88,0:08:22.05,Default - CN,,0,0,0,,Йорикита Такерё
Dialogue: 4,0:08:22.39,0:08:23.77,Default - CN,,0,0,0,,Пайдаланылмаған жол
Dialogue: 4,0:08:24.11,0:08:25.96,Default - CN,,0,0,0,,Мен саған әдейі шабуыл жасап жатырмын.
Dialogue: 4,0:08:26.92,0:08:29.46,Default - CN,,0,0,0,,Табиғи актерлік - эмоцияның негізгі нүктесі.
Dialogue: 4,0:08:29.81,0:08:30.90,Default - CN,,0,0,0,,Дарынды адамдар
Dialogue: 4,0:08:31.63,0:08:34.24,Default - CN,,0,0,0,,Сенің осында екенің рас.
Dialogue: 4,0:08:36.53,0:08:39.89,Default - CN,,0,0,0,,Нагано Козико Тайранның келгені шындық.
Dialogue: 4,0:08:40.46,0:08:43.63,Default - CN,,0,0,0,,Келесі өндіріс жоспарланып, үлкен қылыш пен балта негізі өзгертілді.
Dialogue: 4,0:08:44.21,0:08:45.50,Default - CN,,0,0,0,,...
Dialogue: 4,0:08:46.22,0:08:48.07,Default - CN,,0,0,0,,Досей Казутаның келбеті
Dialogue: 4,0:08:48.07,0:08:50.95,Default - CN,,0,0,0,,Бұл кітаптың түпнұсқа нұсқасы.
Dialogue: 4,0:08:51.32,0:08:53.15,Default - CN,,0,0,0,,Бұл жылдағы адамдар жүретін жол.
Dialogue: 4,0:08:53.15,0:08:54.54,Default - CN,,0,0,0,,Бұл да мүмкін.
Dialogue: 4,0:08:56.32,0:09:00.09,Default - CN,,0,0,0,,Каная кездесуінің жоғары өнімділігі
Dialogue: 4,0:09:03.46,0:09:05.87,Default - CN,,0,0,0,,Кананың соңғы көрінісі
Dialogue: 4,0:09:06.95,0:09:07.73,Default - CN,,0,0,0,,Кана?
Dialogue: 4,0:09:08.11,0:09:09.30,Default - CN,,0,0,0,,Осымен
Dialogue: 4,0:09:09.95,0:09:12.07,Default - CN,,0,0,0,,7-көрініс №310
Dialogue: 4,0:09:12.51,0:09:13.31,Default - CN,,0,0,0,,Дайындық
Dialogue: 4,0:09:13.78,0:09:14.41,Default - CN,,0,0,0,,Басталуы
Dialogue: 4,0:09:30.43,0:09:33.09,Default - CN,,0,0,0,,Йошиёши Хаяками
Dialogue: 4,0:09:33.24,0:09:35.49,Default - CN,,0,0,0,,Төсекте ұйықтау
Dialogue: 4,0:09:35.49,0:09:37.11,Default - CN,,0,0,0,,Маған белім ұнамайды.
Dialogue: 4,0:09:39.65,0:09:42.28,Default - CN,,0,0,0,,Едендегі әңгіме
Dialogue: 4,0:09:42.28,0:09:45.92,Default - CN,,0,0,0,,Ұйқыдағы жер оқиғасы 4 сағат оянғаннан кейін солға және оңға
Dialogue: 4,0:09:45.92,0:09:47.84,Default - CN,,0,0,0,,Шындық – денсаулыққа зиянсыз, аз білім...
Dialogue: 4,0:09:49.32,0:09:50.77,Default - CN,,0,0,0,,Қазіргі уақытта жұмыс істейді
Dialogue: 4,0:09:51.02,0:09:55.76,Default - CN,,0,0,0,,23
Dialogue: 4,0:09:55.76,0:09:56.83,Default - CN,,0,0,0,,Сізге көп рахмет
Dialogue: 4,0:09:57.66,0:09:59.48,Default - CN,,0,0,0,,“Има Тиан” бейнесін қараңыз
Dialogue: 4,0:09:59.48,0:10:01.74,Default - CN,,0,0,0,,Сен қуансаң, мен тағы айқайлаймын.
Dialogue: 4,0:10:02.79,0:10:05.05,Default - CN,,0,0,0,,Қарт қожайын қуып келеді
Dialogue: 4,0:10:05.31,0:10:06.87,Default - CN,,0,0,0,,Сен өлдің
Dialogue: 4,0:10:06.87,0:10:08.40,Default - CN,,0,0,0,,Басынан кейін бір нүкте
Dialogue: 4,0:10:08.40,0:10:10.05,Default - CN,,0,0,0,,Ене және екінші эпизод
Dialogue: 4,0:10:10.74,0:10:12.55,Default - CN,,0,0,0,,Капиталдың ұлғаюы
Dialogue: 4,0:10:12.81,0:10:15.10,Default - CN,,0,0,0,,Сондай-ақ, қажетсіз оқу және өзін-өзі күту
Dialogue: 4,0:10:15.69,0:10:18.80,Default - CN,,0,0,0,,Мингминг – қарт шебердің жүрегін тебірентетін қанға толы туындысы
Dialogue: 4,0:10:18.80,0:10:21.42,Default - CN,,0,0,0,,Бұл ойнатылған бейне.
Dialogue: 4,0:10:22.14,0:10:24.80,Default - CN,,0,0,0,,Қалаға көңілім толмайды.
Dialogue: 4,0:10:25.06,0:10:26.13,Default - CN,,0,0,0,,ха ха ха
Dialogue: 4,0:10:26.52,0:10:28.36,Default - CN,,0,0,0,,Еңбек жолымды ағартушылық жолында бастадым.
Dialogue: 4,0:10:29.18,0:10:33.04,Default - CN,,0,0,0,,Ішінара аяқталған, заңсыз күтулер, ұзартылған әсерлер, манга тәрізді визуализация
Dialogue: 4,0:10:33.52,0:10:36.05,Default - CN,,0,0,0,,Жұмыс күшіне кіру мүмкіндігі аяқталды.
Dialogue: 4,0:10:36.32,0:10:38.40,Default - CN,,0,0,0,,Маған да ұнамайды.
Dialogue: 4,0:10:39.30,0:10:42.09,Default - CN,,0,0,0,,Өз жұмысын медиа ретінде пайдаланып келе жатқан манга суретшісі
Dialogue: 4,0:10:42.41,0:10:44.67,Default - CN,,0,0,0,,«Арута Дай Татеки Мокуяны қажетсіз құшақтау»
Dialogue: 4,0:10:45.41,0:10:47.14,Default - CN,,0,0,0,,Әрбір манга суретшісі алдымен идеяны ойлап тапты.
Dialogue: 4,0:10:47.14,0:10:49.38,Default - CN,,0,0,0,,«Бұл ойнауға ең жақсы уақыт.»
Dialogue: 4,0:10:49.38,0:10:50.91,Default - CN,,0,0,0,,Күлкілі бейнесі бар иллюзиондық костюм
Dialogue: 4,0:10:51.46,0:10:54.05,Default - CN,,0,0,0,,Дегенмен, соңғы өрнек төменде болды.
Dialogue: 4,0:10:54.72,0:10:58.63,Default - CN,,0,0,0,,Бұл оны бұқаралық ақпарат құралдарына айналдырудың жолы… Токио аяқталды
Dialogue: 4,0:10:59.19,0:11:00.18,Default - CN,,0,0,0,,Бұл жерде тікелей хабаршы
Dialogue: 4,0:11:00.64,0:11:01.90,Default - CN,,0,0,0,,Жарық – бұл болмыс
Dialogue: 4,0:11:06.72,0:11:07.70,Default - CN,,0,0,0,,Ескі шебер?
Dialogue: 4,0:11:08.86,0:11:12.59,Default - CN,,0,0,0,,Мен қазір бұл манганы және оны теледидардан көріп жатырмын.
Dialogue: 4,0:11:14.03,0:11:16.48,Default - CN,,0,0,0,,Үй иесі Қайқан соңғы әңгіме
Dialogue: 4,0:11:16.48,0:11:17.86,Default - CN,,0,0,0,,Бұл «қазір тәтті».
Dialogue: 4,0:11:21.60,0:11:23.87,Default - CN,,0,0,0,,Адамдардың көпшілігі кездесуді көрді.
Dialogue: 4,0:11:24.35,0:11:25.49,Default - CN,,0,0,0,,Тадаридің бастапқы өзегі ұнтағы
Dialogue: 4,0:11:25.49,0:11:28.25,Default - CN,,0,0,0,,Актерлердің айналасындағы жағдайларға байланысты,
Dialogue: 4,0:11:28.60,0:11:30.19,Default - CN,,0,0,0,,«Иматен» фильмінің соңғы бөлімі
Dialogue: 4,0:11:30.82,0:11:33.91,Default - CN,,0,0,0,,Жылыту процесіне қосқан үлесі
Dialogue: 4,0:11:34.66,0:11:35.95,Default - CN,,0,0,0,,Тадаширазай Коганшири
Dialogue: 4,0:11:36.20,0:11:38.45,Default - CN,,0,0,0,,Қатты марапатқа қол жеткізді
Dialogue: 4,0:11:46.89,0:11:49.44,Default - CN,,0,0,0,,Әртістер де келген кезде
Dialogue: 4,0:11:50.29,0:11:51.63,Default - CN,,0,0,0,,Ичикан
Dialogue: 4,0:11:51.63,0:11:54.44,Default - CN,,0,0,0,,Келесі жұмыс бірнеше адамға негізделген.
Dialogue: 4,0:11:54.75,0:11:59.64,Default - CN,,0,0,0,,Бұл біздің жеке спектакль, ол көп адам негізінде құрылған.
Dialogue: 4,0:12:00.14,0:12:01.85,Default - CN,,0,0,0,,Міндетті ұпай саны
Dialogue: 4,0:12:02.09,0:12:04.16,Default - CN,,0,0,0,,Әңгімелесу кезінде жұмыс орнын өзгерту қажеттілігінен босату
Dialogue: 4,0:12:05.44,0:12:08.04,Default - CN,,0,0,0,,Әңгіменің түп төркіні – сен менің досымсың.
Dialogue: 4,0:12:08.38,0:12:10.39,Default - CN,,0,0,0,,Менде талант жоқ, бірақ оны қалай тыңдайтынымды білмеймін.
Dialogue: 4,0:12:10.82,0:12:11.35,Default - CN,,0,0,0,,Аралдағы шағын ауылда тұратын бір священник сәбиді асырап алды.
Dialogue: 4,0:12:15.23,0:12:17.30,Default - CN,,0,0,0,,Оны жеңу қиын
Dialogue: 4,0:12:17.30,0:12:18.95,Default - CN,,0,0,0,,Қарт ұстаз
Dialogue: 4,0:12:23.65,0:12:24.78,Default - CN,,0,0,0,,Әрі қарайғы жұмыстар
Dialogue: 4,0:12:25.01,0:12:27.91,Default - CN,,0,0,0,,Мен жас ханымның әрекетін түсінемін
Dialogue: 4,0:12:29.74,0:12:31.09,Default - CN,,0,0,0,,Сізге көп рахмет
Dialogue: 4,0:12:36.21,0:12:38.10,Default - CN,,0,0,0,,Арнайы жинақ
Dialogue: 4,0:12:38.44,0:12:41.91,Default - CN,,0,0,0,,Егер сіз Фуккинкайдың мүшесі болсаңыз, ертерек қойылымды тексеріңіз.
Dialogue: 4,0:12:43.84,0:12:45.37,Default - CN,,0,0,0,,Гоку Агоя-кун
Dialogue: 4,0:12:45.87,0:12:47.87,Default - CN,,0,0,0,,Жақсы суреттердің ең соңғы жинағы
Dialogue: 4,0:12:48.52,0:12:49.71,Default - CN,,0,0,0,,көпбұрыш
Dialogue: 4,0:12:50.14,0:12:52.99,Default - CN,,0,0,0,,Бұл жұмыстың пайдасы үшін қолайлы жағдай емес.
Dialogue: 4,0:12:52.99,0:12:54.44,Default - CN,,0,0,0,,Талантты және талантты адам
Dialogue: 4,0:12:54.44,0:12:56.70,Default - CN,,0,0,0,,Берілген жалғыз мүмкіндік - бастапқы мақсат.
Dialogue: 4,0:12:56.70,0:12:59.15,Default - CN,,0,0,0,,​​Есептеу сәтті болды ма?
Dialogue: 4,0:13:00.00,0:13:03.19,Default - CN,,0,0,0,,Отты жою туралы шешімнің нәтижесі бұрынғы генерал шеніндегі П
Dialogue: 4,0:13:03.81,0:13:06.45,Default - CN,,0,0,0,,Барлық қанымды жоғалтқанымды растады.
Dialogue: 4,0:13:06.77,0:13:08.15,Default - CN,,0,0,0,,Белгілі бір ниеттің барына көңілім толды.
Dialogue: 4,0:13:08.82,0:13:09.36,Default - CN,,0,0,0,,Енді олар жай ғана кішігірім бандиттер тобы
Dialogue: 4,0:13:09.61,0:13:12.02,Default - CN,,0,0,0,,Мен Ichigo Pro мүшесімін.
Dialogue: 4,0:13:12.93,0:13:17.40,Default - CN,,0,0,0,,Ұзақ уақыт ләззат алатын махаббаттың шағын бейнесі
Dialogue: 4,0:13:18.90,0:13:20.16,Default - CN,,0,0,0,,Неке куәлігі: Ллойд Фогель, Джоэл Фогель
Dialogue: 4,0:13:20.16,0:13:24.43,Default - CN,,0,0,0,,Мен көп ақша жоғалттым.
Dialogue: 4,0:13:24.43,0:13:25.49,Default - CN,,0,0,0,,Сізбен кездеспедім
Dialogue: 4,0:13:26.25,0:13:28.30,Default - CN,,0,0,0,,бет
Dialogue: 4,0:13:29.44,0:13:32.25,Default - CN,,0,0,0,,Махаббат пен махаббаттың арасы
Dialogue: 4,0:13:33.35,0:13:36.80,Default - CN,,0,0,0,,Бұрын мен арнайы ақпарат құралдарында жұмыс істеп жүргенімде, мен онымен жұмыс істей бастадым.
Dialogue: 4,0:13:37.20,0:13:41.60,Default - CN,,0,0,0,,Одан кейін жою және араласу жұмыстарынан басқа
Dialogue: 4,0:13:42.18,0:13:44.24,Default - CN,,0,0,0,,Exclusion from the customer service
Dialogue: 4,0:13:44.24,0:13:47.00,Default - CN,,0,0,0,,Мен кеңседе басқа баланы көрген уақыт
Dialogue: 4,0:13:47.00,0:13:48.89,Default - CN,,0,0,0,,Бұл дүкенді де ұсына аласыз
Dialogue: 4,0:13:50.51,0:13:52.20,Default - CN,,0,0,0,,Кім не істеу керектігін біледі?
Dialogue: 4,0:13:52.58,0:13:53.31,Default - CN,,0,0,0,,Иә?
Dialogue: 4,0:13:54.05,0:13:56.30,Default - CN,,0,0,0,,Менімен кездеспесеңіз, ұнтақты жақсы көресіз.
Dialogue: 4,0:13:56.71,0:13:58.80,Default - CN,,0,0,0,,Бұрынғы пұттарды тыңдауға қызығасыз ба?
Dialogue: 4,0:13:59.81,0:14:00.59,Default - CN,,0,0,0,,Мүмкін
Dialogue: 4,0:14:01.43,0:14:02.60,Default - CN,,0,0,0,,Әр адамның ешкімге көрсетпейтін бір жағы бар
Dialogue: 4,0:14:05.35,0:14:07.09,Default - CN,,0,0,0,,Хабарландыруды сұрау
Dialogue: 4,0:14:07.36,0:14:09.50,Default - CN,,0,0,0,,Дегенмен, жұмыс алмасу үшін жағдайлар бар.
Dialogue: 4,0:14:10.31,0:14:13.72,Default - CN,,0,0,0,,Ұлы сұлулығыңның бейнесін сүй.
Dialogue: 4,0:14:15.83,0:14:19.06,Default - CN,,0,0,0,,Hideo Masato starring Yuki Shurai
Dialogue: 4,0:14:22.73,0:14:25.00,Default - CN,,0,0,0,,...
Dialogue: 4,0:14:25.36,0:14:28.53,Default - CN,,0,0,0,,Шындық сәл басқаша.
Dialogue: 4,0:14:28.53,0:14:31.50,Default - CN,,0,0,0,,This uniform may be worn, but it is true.
Dialogue: 4,0:14:32.20,0:14:33.64,Default - CN,,0,0,0,,Шынайы махаббат
Dialogue: 4,0:14:34.03,0:14:36.40,Default - CN,,0,0,0,,The first heavenly attainment is possible.
Dialogue: 4,0:14:38.39,0:14:40.07,Default - CN,,0,0,0,,Қысқа жең
Dialogue: 4,0:14:40.07,0:14:42.93,Default - CN,,0,0,0,,Ойын басталмас бұрын өлім тақтасы болды.
Dialogue: 4,0:14:43.81,0:14:44.85,Default - CN,,0,0,0,,...
Dialogue: 4,0:14:45.91,0:14:47.75,Default - CN,,0,0,0,,...
Dialogue: 4,0:14:58.49,0:15:01.69,Default - CN,,0,0,0,,Менің қазіргі болғаныма үш жыл толғанда...
Dialogue: 4,0:15:04.23,0:15:06.29,Default - CN,,0,0,0,,Performance course F class
Dialogue: 4,0:15:06.29,0:15:08.21,Default - CN,,0,0,0,,Uh, I started running before the classroom.
Dialogue: 4,0:15:09.82,0:15:11.60,Default - CN,,0,0,0,,Кьюки Агояға кіреді
Dialogue: 4,0:15:11.91,0:15:12.76,Default - CN,,0,0,0,,Рюхи
Dialogue: 4,0:15:13.21,0:15:18.44,Default - CN,,0,0,0,,Оқушылардың Шығыс Азиядағы және басқа мектептердегі орта мектепке бару еркіндігінің бір нүктесі бар.
Dialogue: 4,0:15:18.44,0:15:22.90,Default - CN,,0,0,0,,Дегенмен, нәтиже сәтті болмаса, сабаққа қатысу деңгейінің жетіспеушілігі бар.
Dialogue: 4,0:15:22.90,0:15:25.11,Default - CN,,0,0,0,,Курстар мен басқа мектептер арасында көптеген айырмашылықтар бар.
Dialogue: 4,0:15:25.50,0:15:26.16,Default - CN,,0,0,0,,Ақылға қонымсыз!
Dialogue: 4,0:15:26.91,0:15:27.95,Default - CN,,0,0,0,,Тұлға - актер
Dialogue: 4,0:15:28.60,0:15:31.16,Default - CN,,0,0,0,,It is like a head idol group.
Dialogue: 4,0:15:31.74,0:15:34.25,Default - CN,,0,0,0,,Naka's big breasts are photo idols
Dialogue: 4,0:15:34.80,0:15:38.18,Default - CN,,0,0,0,,Сол кездегі ерекше дауысты әнші
Dialogue: 4,0:15:38.46,0:15:41.21,Default - CN,,0,0,0,,Кабуки орындаушысы және еденде отырған әйел көлеңке жұлдыз
Dialogue: 4,0:15:42.81,0:15:44.39,Default - CN,,0,0,0,,Оято - ер адам
Dialogue: 4,0:15:45.21,0:15:49.68,Default - CN,,0,0,0,,Бұл Жапонияның түкпір-түкпірінен келген жоғары сынып оқушыларының жинағы.
Dialogue: 4,0:15:50.35,0:15:52.34,Default - CN,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 4,0:15:53.15,0:15:54.95,Default - CN,,0,0,0,,King's arrival performance theater
Dialogue: 4,0:16:00.28,0:16:02.03,Default - CN,,0,0,0,,Gato Kosuke has arrived
Dialogue: 4,0:16:02.03,0:16:03.53,Default - CN,,0,0,0,,Жоғалған уақыт
Dialogue: 4,0:16:03.97,0:16:06.46,Default - CN,,0,0,0,,This is the place where you are raised.
Dialogue: 4,0:16:06.46,0:16:08.22,Default - CN,,0,0,0,,It's just a normal school.
Dialogue: 4,0:16:08.22,0:16:09.89,Default - CN,,0,0,0,,Қалыпты көңіл күйі енді жұмысқа орналасу үшін қол жетімді.
Dialogue: 4,0:16:17.51,0:16:18.75,Default - CN,,0,0,0,,гүрілдеу
Dialogue: 4,0:16:21.71,0:16:23.10,Default - CN,,0,0,0,,Әдемі әйелге көзқарас
Dialogue: 4,0:16:23.10,0:16:24.60,Default - CN,,0,0,0,,Бүкіл дүниенің анық көрінісі
Dialogue: 4,0:16:24.88,0:16:28.30,Default - CN,,0,0,0,,Ескі отбасының орта мектебінің тағы бір бөлігі
Dialogue: 4,0:16:29.61,0:16:30.72,Default - CN,,0,0,0,,Осыны айт
Dialogue: 4,0:16:30.72,0:16:32.92,Default - CN,,0,0,0,,Мен мәселенің негізгі себебі екенімді түсінемін.
Dialogue: 4,0:16:32.92,0:16:35.20,Default - CN,,0,0,0,,Егер сізде сұрақтар немесе алаңдаушылықтар болса, бізге хабарласыңыз.
Dialogue: 4,0:16:38.53,0:16:40.20,Default - CN,,0,0,0,,Жоғары көтерілу мүмкін емес!
Dialogue: 4,0:16:43.31,0:16:44.89,Default - CN,,0,0,0,,Қолжетімсіз адам
Dialogue: 4,0:16:47.31,0:16:50.65,Default - CN,,0,0,0,,Оған қараңыз.
Dialogue: 4,0:16:51.22,0:16:53.30,Default - CN,,0,0,0,,Мен «Шын сұлу әйел» киемін...
Dialogue: 4,0:16:53.49,0:16:56.04,Default - CN,,0,0,0,,Кепілдендірілген өнімділік курсы
Dialogue: 4,0:16:56.50,0:16:58.30,Default - CN,,0,0,0,,Сіз…
Dialogue: 4,0:16:58.75,0:16:59.70,Default - CN,,0,0,0,,Сіз ерекшесіз
Dialogue: 4,0:16:59.92,0:17:02.25,Default - CN,,0,0,0,,Менің енем және оның күйеуі
Dialogue: 4,0:17:02.80,0:17:06.45,Default - CN,,0,0,0,,Минами Такайоши
Dialogue: 4,0:17:06.90,0:17:08.71,Default - CN,,0,0,0,,Минами Котобуки…
Dialogue: 4,0:17:08.99,0:17:11.07,Default - CN,,0,0,0,,Апыр-ай! Бұл фото кумир
Dialogue: 4,0:17:11.07,0:17:14.10,Default - CN,,0,0,0,,Шетелдіктің бетіндегі Маетани Ута шынымен қатыгез бе?
Dialogue: 4,0:17:14.31,0:17:17.27,Default - CN,,0,0,0,,G кесе лас адам
Dialogue: 4,0:17:17.27,0:17:18.40,Default - CN,,0,0,0,,Қашан жүкті болды екен бұл?
Dialogue: 4,0:17:18.40,0:17:20.54,Default - CN,,0,0,0,,Мен ақиқатқа бірінші жеткен адаммын.
Dialogue: 4,0:17:20.54,0:17:21.53,Default - CN,,0,0,0,,Сіз Осака тұрғынысыз ба?
Dialogue: 4,0:17:21.79,0:17:24.89,Default - CN,,0,0,0,,Мен Канагавадамын
Dialogue: 4,0:17:24.89,0:17:26.94,Default - CN,,0,0,0,,Әңгіме стиліндегі әңгіме
Dialogue: 4,0:17:27.28,0:17:27.75,Default - CN,,0,0,0,,Мейірбикелік сезімдер?
Dialogue: 4,0:17:27.75,0:17:29.39,Default - CN,,0,0,0,,Батыс үңгір! ?
Dialogue: 4,0:17:29.87,0:17:32.44,Default - CN,,0,0,0,,Сондықтан мен өзімнің досыммын.
Dialogue: 4,0:17:32.44,0:17:33.66,Default - CN,,0,0,0,,Орынбасар ретінде қызмет ету
Dialogue: 4,0:17:34.05,0:17:35.15,Default - CN,,0,0,0,,Сәлем
Dialogue: 4,0:17:35.56,0:17:38.16,Default - CN,,0,0,0,,...
Dialogue: 4,0:17:38.54,0:17:40.16,Default - CN,,0,0,0,,Достарыңды шақыр
Dialogue: 4,0:17:42.29,0:17:46.04,Default - CN,,0,0,0,,Осы мектептен бері достарыммен араласуға рұқсат етілмейді.
Dialogue: 4,0:17:46.62,0:17:48.84,Default - CN,,0,0,0,,Досымды көргенде онымен байланысым үзілді.
Dialogue: 4,0:17:49.53,0:17:51.60,Default - CN,,0,0,0,,Сұрақ қоймаңыз
Dialogue: 4,0:17:51.60,0:17:54.02,Default - CN,,0,0,0,,Бұл сыныптағы тағы бір тәжірибе.
Dialogue: 4,0:17:54.02,0:17:56.25,Default - CN,,0,0,0,,Дәл осыны айтуға болады!
Dialogue: 4,0:17:56.56,0:17:59.19,Default - CN,,0,0,0,,Кенет дос болып кеткен бала
Dialogue: 4,0:17:59.51,0:18:02.31,Default - CN,,0,0,0,,Жалпы зерттеулерді қайта оқыңыз.
Dialogue: 4,0:18:02.31,0:18:04.32,Default - CN,,0,0,0,,Белгілі бір дәрежеде достық орнады.
Dialogue: 4,0:18:04.32,0:18:06.56,Default - CN,,0,0,0,,Ойлар кез келген уақытта араласуы мүмкін.
Dialogue: 4,0:18:06.56,0:18:08.91,Default - CN,,0,0,0,,Содан бері мен мектепке қабылданған жоқпын.
Dialogue: 4,0:18:09.38,0:18:12.11,Default - CN,,0,0,0,,Қақпаны ашқаннан кейін модель толық емес.
Dialogue: 4,0:18:12.62,0:18:15.86,Default - CN,,0,0,0,,Нами Коминами
Dialogue: 4,0:18:15.86,0:18:17.84,Default - CN,,0,0,0,,...
Dialogue: 4,0:18:17.84,0:18:19.55,Default - CN,,0,0,0,,Достармен достық
Dialogue: 4,0:18:20.31,0:18:22.57,Default - CN,,0,0,0,,Маған ұнайды.
Dialogue: 4,0:18:22.96,0:18:25.21,Default - CN,,0,0,0,,Сіздің ортаңыз да ерекше.
Dialogue: 4,0:18:25.57,0:18:27.21,Default - CN,,0,0,0,,Бұл рас
Dialogue: 4,0:18:27.51,0:18:29.46,Default - CN,,0,0,0,,Айналадағы қалаға бір ой салады
Dialogue: 4,0:18:29.46,0:18:32.00,Default - CN,,0,0,0,,3-ші орын
Dialogue: 4,0:18:32.00,0:18:33.72,Default - CN,,0,0,0,,Қажет адам
Dialogue: 4,0:18:34.05,0:18:36.53,Default - CN,,0,0,0,,Бұл балаңызды өсіретін жер.
Dialogue: 4,0:18:36.53,0:18:38.28,Default - CN,,0,0,0,,Бұл қарапайым мектеп.
Dialogue: 4,0:18:38.28,0:18:39.95,Default - CN,,0,0,0,,Қалыпты көңіл күйі енді жұмысқа орналасу үшін қол жетімді.
Dialogue: 4,0:18:40.42,0:18:41.71,Default - CN,,0,0,0,,Корохи
Dialogue: 4,0:18:41.71,0:18:43.95,Default - CN,,0,0,0,,Жақсы адамның жақсы бейнесі
Dialogue: 4,0:18:44.91,0:18:47.32,Default - CN,,0,0,0,,Кіру салтанатына бару
Dialogue: 4,0:18:47.32,0:18:49.56,Default - CN,,0,0,0,,Сырт келбеті әділ екені рас.
Dialogue: 4,0:18:49.56,0:18:52.24,Default - CN,,0,0,0,,Ол ешбір бар ортада көрсетілмеген.
Dialogue: 4,0:18:52.24,0:18:54.03,Default - CN,,0,0,0,,Сондықтан жүзеге асыру қажет
Dialogue: 4,0:18:54.29,0:18:55.11,Default - CN,,0,0,0,,Кодтық аты: Принцесса Торн
Dialogue: 4,0:18:55.90,0:18:58.24,Default - CN,,0,0,0,,Зиянды адамдар бар.
Dialogue: 4,0:18:59.40,0:19:03.59,Default - CN,,0,0,0,,Нана. Барлық түскен сұраныс бойынша сатып алуға болатын кешенді оқу материалдары...
Dialogue: 4,0:19:05.18,0:19:06.16,Default - CN,,0,0,0,,Кешір
Dialogue: 4,0:19:07.10,0:19:09.39,Default - CN,,0,0,0,,Арнайы жарнаманы тікелей тарату қазір қол жетімді
Dialogue: 4,0:19:09.83,0:19:12.00,Default - CN,,0,0,0,,Бастапқыда ең аз қатысумен кіру рәсімі ретінде арналған.
Dialogue: 4,0:19:12.97,0:19:14.59,Default - CN,,0,0,0,,Ширануи Фуриро…
Dialogue: 4,0:19:15.05,0:19:16.64,Default - CN,,0,0,0,,Бұл Фури Ширануи...
Dialogue: 4,0:19:17.28,0:19:18.85,Default - CN,,0,0,0,,...
Dialogue: 4,0:19:20.24,0:19:22.35,Default - CN,,0,0,0,,Менің командам осында!
Dialogue: 4,0:19:23.23,0:19:25.02,Default - CN,,0,0,0,,Әр түнде 9 нүктелік экран болғандықтан
Dialogue: 4,0:19:25.02,0:19:27.76,Default - CN,,0,0,0,,Но әндері мен билерін жақсы орындайтын құдіретті орындаушы!
Dialogue: 4,0:19:28.03,0:19:32.44,Default - CN,,0,0,0,,Қала тұрғындарының көпшілігін еске түсіретін сұлу қыз - Фури Ширануй!
Dialogue: 4,0:19:32.91,0:19:34.55,Default - CN,,0,0,0,,Мен не істеу керектігін білмеймін.
Dialogue: 4,0:19:35.01,0:19:37.16,Default - CN,,0,0,0,,Сен маған ғашықсың
Dialogue: 4,0:19:37.16,0:19:38.45,Default - CN,,0,0,0,,Қазіргі уақытта мен ең жақсы ставкамын.
Dialogue: 4,0:19:39.01,0:19:40.00,Default - CN,,0,0,0,,——
Dialogue: 4,0:19:40.00,0:19:43.23,Default - CN,,0,0,0,,Бұл Ширануи Фури Роар
Dialogue: 4,0:19:43.23,0:19:44.18,Default - CN,,0,0,0,,Қызықсыз
Dialogue: 4,0:19:44.50,0:19:47.66,Default - CN,,0,0,0,,Басынан аяғына дейін мен сені бәрінен де жақсы көремін.
Dialogue: 4,0:19:48.73,0:19:50.93,Default - CN,,0,0,0,,Әрине, мен де біржақтымын.
Dialogue: 4,0:19:50.93,0:19:53.02,Default - CN,,0,0,0,,Бұл бір реттік оқиға болды.
Dialogue: 4,0:19:53.36,0:19:55.91,Default - CN,,0,0,0,,Ақиқат – ақиқат сонда.
Dialogue: 4,0:19:56.62,0:19:59.64,Default - CN,,0,0,0,,...
Dialogue: 4,0:19:59.64,0:20:01.18,Default - CN,,0,0,0,,Ұнтақты пайдалануға рұқсат етілмейді.
Dialogue: 4,0:20:01.41,0:20:02.81,Default - CN,,0,0,0,,Сіз сол студентсіз.
Dialogue: 4,0:20:02.81,0:20:04.15,Default - CN,,0,0,0,,Кім айқайлайды...
Dialogue: 4,0:20:06.14,0:20:07.73,Default - CN,,0,0,0,,Йоши Ширануи Дугаку
Dialogue: 4,0:20:09.23,0:20:11.65,Default - CN,,0,0,0,,Қарындасым, әпкем, сен бір ұжымсың.
Dialogue: 4,0:20:12.01,0:20:13.25,Default - CN,,0,0,0,,Сіз бір-біріңізбен жақсы араласа аласыз деп үміттенемін
Dialogue: 4,0:20:13.76,0:20:15.42,Default - CN,,0,0,0,,...
Dialogue: 4,0:20:16.05,0:20:17.25,Default - CN,,0,0,0,,Мен сені түсінемін
Dialogue: 4,0:20:17.66,0:20:19.04,Default - CN,,0,0,0,,Сіз осындасыз «Қазір тәтті»
Dialogue: 4,0:20:19.32,0:20:20.34,Default - CN,,0,0,0,,Сен данышпан, ғұламасың.
Dialogue: 4,0:20:20.61,0:20:22.44,Default - CN,,0,0,0,,Түсініксіз және жеңіл шығармалар
Dialogue: 4,0:20:22.74,0:20:25.89,Default - CN,,0,0,0,,Оқиға орнында мен басқа адамның көзінше отты бақылап отырдым.
Dialogue: 4,0:20:26.94,0:20:27.79,Default - CN,,0,0,0,,Бұрын-соңды болмаған
Dialogue: 4,0:20:29.52,0:20:30.39,Default - CN,,0,0,0,,Татон
Dialogue: 4,0:20:31.42,0:20:34.59,Default - CN,,0,0,0,,Мен сізді Middle JUMP-тің жабық мұқабасында көрдім.
Dialogue: 4,0:20:34.96,0:20:36.35,Default - CN,,0,0,0,,​​Бұл Минами Коджидің өлімі.
Dialogue: 4,0:20:36.35,0:20:36.99,Default - CN,,0,0,0,,Иә!
Dialogue: 4,0:20:37.62,0:20:38.50,Default - CN,,0,0,0,,Йосуке…
Dialogue: 4,0:20:38.98,0:20:41.94,Default - CN,,0,0,0,,Басқалардың бәрі Фури Ширануиді біледі!
Dialogue: 4,0:20:42.62,0:20:43.51,Default - CN,,0,0,0,,Ол осылайша жанды шығарып алады ма?
Dialogue: 4,0:20:44.32,0:20:45.09,Default - CN,,0,0,0,,Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр
Dialogue: 4,0:20:45.66,0:20:48.25,Default - CN,,0,0,0,,Оны қабылдаңыз.
Dialogue: 4,0:20:48.56,0:20:50.44,Default - CN,,0,0,0,,Мен...Нана...
Dialogue: 4,0:20:51.09,0:20:53.73,Default - CN,,0,0,0,,Дереу жоғалту бар…
Dialogue: 4,0:20:54.07,0:20:54.80,Default - CN,,0,0,0,,Неке куәлігі: Ллойд Фогель, Джоэл Фогель
Dialogue: 4,0:20:55.55,0:20:56.51,Default - CN,,0,0,0,,Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр
Dialogue: 4,0:20:57.16,0:20:58.01,Default - CN,,0,0,0,,Май қосылды ма?
Dialogue: 4,0:20:58.77,0:21:00.55,Default - CN,,0,0,0,,Киото арман!
Dialogue: 4,0:21:00.55,0:21:03.03,Default - CN,,0,0,0,,Ең жақсы жағы - мен кумирмін.
Dialogue: 4,0:21:03.21,0:21:04.99,Default - CN,,0,0,0,,Тағы бір сапар кенеттен қызу болды.
Dialogue: 4,0:21:05.25,0:21:09.16,Default - CN,,0,0,0,,Мүсін салуға жарамсыз.
Dialogue: 4,0:21:09.68,0:21:11.17,Default - CN,,0,0,0,,Дегенмен, бұл төмендегі оқиға ...
Dialogue: 4,0:21:11.72,0:21:14.31,Default - CN,,0,0,0,,Кескіні жақсы адам қайтыс болды.
Dialogue: 4,0:21:14.31,0:21:15.92,Default - CN,,0,0,0,,Яғни, мен шетелге кеткен жоқпын.
Dialogue: 4,0:21:16.13,0:21:18.52,Default - CN,,0,0,0,,Шетелдіктің жақсы бейнесі келді.
Dialogue: 4,0:21:18.52,0:21:20.43,Default - CN,,0,0,0,,Жұлдызды қуу мүмкін емес.
Dialogue: 4,0:21:21.12,0:21:23.13,Default - CN,,0,0,0,,Үйден шыққанда
Dialogue: 4,0:21:23.65,0:21:25.65,Default - CN,,0,0,0,,Негізгі құрылымдағы пұт мүсінінің оқиғасы
Dialogue: 4,0:21:25.65,0:21:28.78,Default - CN,,0,0,0,,Жұмысты қажет етпейтін жұлдызды іздеудің әртүрлі түрлері бар.
Dialogue: 4,0:21:29.03,0:21:31.71,Default - CN,,0,0,0,,Konaeko жақсы емес.
Dialogue: 4,0:21:32.53,0:21:36.24,Default - CN,,0,0,0,,Маңызды тілектер мен жақын арада астанаға негізгі шақыру
Dialogue: 4,0:21:36.53,0:21:39.13,Default - CN,,0,0,0,,Біздің орындау бөлімі Мина Миёши.
Dialogue: 4,0:21:39.13,0:21:41.39,Default - CN,,0,0,0,,Кеудедей және сүйкімді адамдар
Dialogue: 4,0:21:41.39,0:21:43.74,Default - CN,,0,0,0,,Бұзықтық!
Dialogue: 4,0:21:44.36,0:21:46.21,Default - CN,,0,0,0,,Бұл еркін адамның сүйікті әңгімесі.
Dialogue: 4,0:21:46.59,0:21:48.94,Default - CN,,0,0,0,,Үй жұмысын қалдыру керек болса, оны маған қалдырыңыз.
Dialogue: 4,0:21:51.85,0:21:53.60,Default - CN,,0,0,0,,Еркін адамның сөзі
Dialogue: 4,0:21:54.83,0:21:58.50,Default - CN,,0,0,0,,Бірегей беделі бар еркін адам, сонымен бірге айлалы адам.
Dialogue: 4,0:21:59.71,0:22:00.90,Default - CN,,0,0,0,,Ұзақ өмір сүретін және сүйікті отбасылық сыйлық
Dialogue: 4,0:22:04.97,0:22:10.98,Title,,0,0,0,,Орындаушылар
Dialogue: 3,0:01:41.11,0:01:44.61,Default - JP,,0,0,0,,Жаңбырдың салдарынан үйге су кіріп кетті.
Dialogue: 3,0:01:46.58,0:01:49.63,Default - JP,,0,0,0,,Спектакль сахнасы, оның ішінде тұру орындары бекітілген.
Dialogue: 3,0:01:50.09,0:01:52.44,Default - JP,,0,0,0,,Шалшықтары бар орындар мұқият жойылды.
Dialogue: 3,0:01:53.14,0:01:55.16,Default - JP,,0,0,0,,Бұл репетицияда расталды.
Dialogue: 3,0:01:56.01,0:02:00.35,Default - JP,,0,0,0,,Кіру орны Айналадағы жиынтық және камера жағдайы Жарықтандыру
Dialogue: 3,0:02:01.05,0:02:03.56,Default - JP,,0,0,0,,Мен қалай көрінемін, соның ішінде артыма қараған кезде?
Dialogue: 3,0:02:04.91,0:02:07.16,Default - JP,,0,0,0,,Сахнаны қайтадан басыңызға салыңыз
Dialogue: 3,0:02:14.17,0:02:16.13,Default - JP,,0,0,0,,Түсіру жалғасады
Dialogue: 3,0:02:16.13,0:02:17.60,Default - JP,,0,0,0,,Камераны дайындау ОК.
Dialogue: 3,0:02:17.82,0:02:18.87,Default - JP,,0,0,0,,Жарықтандыру OK
Dialogue: 3,0:02:19.06,0:02:20.26,Default - JP,,0,0,0,,Майктың жағдайы жақсы.
Dialogue: 3,0:02:21.06,0:02:23.29,Default - JP,,0,0,0,,6-көрініс 51-кесу
Dialogue: 3,0:02:23.56,0:02:24.34,Default - JP,,0,0,0,,Жақсы
Dialogue: 3,0:02:24.97,0:02:25.47,Default - JP,,0,0,0,,Stud
Dialogue: 3,0:02:27.67,0:02:29.79,Default - JP,,0,0,0,,Тақтаның дыбысы қатты жаңғырықты.
Dialogue: 3,0:02:30.13,0:02:31.59,Default - JP,,0,0,0,,Камера айнала бастайды
Dialogue: 3,0:02:32.41,0:02:35.15,Default - JP,,0,0,0,,Аймақты қалың, ауыр ауа толтырады.
Dialogue: 3,0:02:35.70,0:02:38.54,Default - JP,,0,0,0,,Жылдың барлық уақыты қысқартылған сияқты.
Dialogue: 3,0:02:38.81,0:02:40.95,Default - JP,,0,0,0,,Ауыр және күшті уақыт өтеді
Dialogue: 3,0:02:42.01,0:02:45.96,Default - JP,,0,0,0,,Өмірдің өзі сұралғандай ұзақ уақыт
Dialogue: 3,0:02:48.25,0:02:50.20,Default - JP,,0,0,0,,Менің атым Арима ма?
Dialogue: 3,0:02:50.65,0:02:54.45,Default - JP,,0,0,0,,Кішкентай кезімде мені данышпан деп атайтын және бәрі мені таңдайтын.
Dialogue: 3,0:02:54.93,0:02:56.51,Default - JP,,0,0,0,,Сіз қайтадан теледидарда болдыңыз.
Dialogue: 3,0:02:56.51,0:02:58.20,Default - JP,,0,0,0,,Кана-чан керемет
Dialogue: 3,0:02:58.49,0:02:59.44,Default - JP,,0,0,0,,Кешіріңізші!
Dialogue: 3,0:03:02.24,0:03:02.89,Default - JP,,0,0,0,,Бірақ
Dialogue: 3,0:03:04.24,0:03:06.96,Default - JP,,0,0,0,,Бұл талант па, әлде қоғамның қыңырлығы ма?
Dialogue: 3,0:03:07.50,0:03:10.08,Default - JP,,0,0,0,,Немесе мен көбірек тырысуым керек пе еді?
Dialogue: 3,0:03:11.11,0:03:14.20,Default - JP,,0,0,0,,Не жесең де, бір күні одан шаршайсың.
Dialogue: 3,0:03:15.41,0:03:18.55,Default - JP,,0,0,0,,Қазіргі уақытта оны интернетте «Овакон балалар актері» деп атайды.
Dialogue: 3,0:03:23.01,0:03:26.77,Default - JP,,0,0,0,,Мен оны бастауыш мектепте оқып жүргенімде бітірдім.
Dialogue: 3,0:03:27.56,0:03:32.15,Default - JP,,0,0,0,,Осы салаға табанды түрде жабысқаннан кейін мен көптен күткен басты рөлді алдым.
Dialogue: 3,0:03:32.66,0:03:34.73,Default - JP,,0,0,0,,Қандай жағдай болмасын жақсы жұмыс жасағым келеді.
Dialogue: 3,0:03:35.62,0:03:37.84,Default - JP,,0,0,0,,Ол үшін мен кез келген сабанға жабысамын.
Dialogue: 3,0:03:40.30,0:03:41.61,Default - JP,,0,0,0,,Мен білемін.
Dialogue: 3,0:03:41.61,0:03:44.05,Default - JP,,0,0,0,,Мен бұл өте жаман жұмыс екенін білемін.
Dialogue: 3,0:03:45.03,0:03:46.64,Default - JP,,0,0,0,,Негізгі білімсіз әрекет ету
Dialogue: 3,0:03:47.35,0:03:51.37,Default - JP,,0,0,0,,Төрт эпизодқа дейін шығарылды және көрермендердің көпшілігінің көңілі қалды.
Dialogue: 3,0:03:51.90,0:03:53.85,Default - JP,,0,0,0,,Бұл сәтсіздік ретінде белгіленеді.
Dialogue: 3,0:03:55.01,0:03:57.39,Default - JP,,0,0,0,,Бірақ әлі де кеш емес
Dialogue: 3,0:03:58.19,0:04:00.77,Default - JP,,0,0,0,,Бұл көрініс түпнұсқадағы ең танымал көріністердің бірі.
Dialogue: 3,0:04:01.34,0:04:03.23,Default - JP,,0,0,0,,Қаһарман мен аңдыушы арасындағы текетірес
Dialogue: 3,0:04:03.97,0:04:07.24,Default - JP,,0,0,0,,Махаббатты ешқашан білмеген қызды бірінші рет біреу қорғайды.
Dialogue: 3,0:04:07.54,0:04:08.72,Default - JP,,0,0,0,,көз жасын төкті
Dialogue: 3,0:04:09.61,0:04:12.04,Default - JP,,0,0,0,,Манганың осы бөлігін оқығанда мен үнемі жылаймын.
Dialogue: 3,0:04:12.38,0:04:14.92,Default - JP,,0,0,0,,Маған қатты ұнайтын көрініс, мен оны қайта-қайта оқимын
Dialogue: 3,0:04:16.28,0:04:19.41,Default - JP,,0,0,0,,Осы кезде серіктесіңізбен синхронды түрде серіктесіңіздің тынысын қадағалаңыз.
Dialogue: 3,0:04:19.41,0:04:21.19,Default - JP,,0,0,0,,Ең жақсы өнімділікті көрсете алсаңыз
Dialogue: 3,0:04:21.78,0:04:22.74,Default - JP,,0,0,0,,Әлбетте жоқ
Dialogue: 3,0:04:23.37,0:04:25.99,Default UP Small - JP,,0,0,0,,Мені қалдыр, рұқсатсыз артымнан ер
Dialogue: 3,0:04:26.94,0:04:29.08,Default UP Small - JP,,0,0,0,,Сіз осылай ойлайсыз.
Dialogue: 3,0:04:29.82,0:04:31.14,Default - JP,,0,0,0,,Бір ауыздан дем алыңыз
Dialogue: 3,0:04:31.77,0:04:32.21,Default UP Small - JP,,0,0,0,,Бірақ...
Dialogue: 3,0:04:32.21,0:04:34.00,Default UP Small - JP,,0,0,0,,Мені жалғыз қалдырмаңыз
Dialogue: 3,0:04:35.71,0:04:37.17,Default - JP,,0,0,0,,Бұл мүмкін емес.
Dialogue: 3,0:04:37.17,0:04:38.59,Default - JP,,0,0,0,,Ұстау жеткіліксіз
Dialogue: 3,0:04:39.21,0:04:42.39,Default - JP,,0,0,0,,Неліктен режиссерлер мұндай әрекетті дұрыс деп санайды?
Dialogue: 3,0:04:42.88,0:04:45.10,Default - JP,,0,0,0,,Бұл жерде жеделдік сезімі көбірек.
Dialogue: 3,0:04:45.10,0:04:48.04,Default - JP,,0,0,0,,Бұл қорқынышты және қорқынышты көрініс емес пе?
Dialogue: 3,0:04:48.90,0:04:51.45,Default - JP,,0,0,0,,Актерлік өнер маңызды емес.
Dialogue: 3,0:04:52.44,0:04:53.65,Default - JP,,0,0,0,,Толығырақ осында...
Dialogue: 3,0:05:05.30,0:05:07.88,Default - JP,,0,0,0,,Шалшықтағы микрофоннан аяқ дыбыстары естіледі
Dialogue: 3,0:05:08.14,0:05:09.13,Default - JP,,0,0,0,,Тоқтағыңыз келе ме?
Dialogue: 3,0:05:09.13,0:05:09.65,Default - JP,,0,0,0,,Янн
Dialogue: 3,0:05:11.54,0:05:13.16,Default - JP,,0,0,0,,Мен оны тірі сезінемін
Dialogue: 3,0:05:16.21,0:05:19.61,Default UP Small - JP,,0,0,0,,Бұл әйел сіз ойлағандай адам емес.
Dialogue: 3,0:05:20.45,0:05:24.59,Default UP Small - JP,,0,0,0,,Мен сен сияқты флирт адаммен үйлеспеймін.
Dialogue: 3,0:05:25.56,0:05:29.16,Default UP Small - JP,,0,0,0,,Ол адам мен сияқты адам.
Dialogue: 3,0:05:23.00,0:05:23.61,Default - JP,,0,0,0,,Бұл
Dialogue: 3,0:05:24.27,0:05:27.15,Default - JP,,0,0,0,,Мен сені дәл қазір онша жақсы емес деп ойладым.
Dialogue: 3,0:05:28.01,0:05:30.37,Default - JP,,0,0,0,,Мен қазір репетицияға қарағанда жақсы сезінемін.
Dialogue: 3,0:05:31.86,0:05:34.06,Default - JP,,0,0,0,,Менде Айдай талант жоқ.
Dialogue: 3,0:05:34.65,0:05:36.91,Default - JP,,0,0,0,,Көзді жаулап алатын аура жоқ.
Dialogue: 3,0:05:37.21,0:05:38.86,Default - JP,,0,0,0,,Бұл менің актерлік шеберлігім емес.
Dialogue: 3,0:05:39.91,0:05:42.66,Default - JP,,0,0,0,,Сондықтан қолыңыздан келгеннің бәрін пайдаланыңыз
Dialogue: 3,0:05:43.74,0:05:47.12,Default - JP,,0,0,0,,Камераны жарықтандыратын актер
Dialogue: 3,0:05:47.90,0:05:49.36,Default - JP,,0,0,0,,Мен мұның бәрін пайдалансам да
Dialogue: 3,0:05:49.80,0:05:51.25,Default - JP,,0,0,0,,Мен Ай сияқты боламын
Dialogue: 3,0:05:55.93,0:05:56.70,Default - CN,,0,0,0,,Алып тасташы, өтінемін...?
Dialogue: 3,0:05:57.15,0:05:58.86,Default - JP,,0,0,0,,Қасыңдағы жүзіңді көрсем, шіркін.
Dialogue: 3,0:06:00.11,0:06:01.94,Default - JP,,0,0,0,,Өңдеусіз солай ма?
Dialogue: 3,0:06:04.79,0:06:06.54,Default - JP,,0,0,0,,Бұл не?
Dialogue: 3,0:06:11.29,0:06:13.08,Default UP Small - JP,,0,0,0,,Сіз естіген жоқсыз ба?
Dialogue: 3,0:06:13.08,0:06:15.65,Default UP Small - JP,,0,0,0,,Мен мұндай әйелді қорғауға тұрарлық емес дедім.
Dialogue: 3,0:06:15.97,0:06:20.00,Default - JP,,0,0,0,,Бұл бала, сценарий мен позиция жарнамаланған.
Dialogue: 3,0:06:20.27,0:06:21.10,Default - JP,,0,0,0,,Тоқтаудың қажеті жоқ
Dialogue: 3,0:06:21.60,0:06:22.76,Default - JP,,0,0,0,,Оған екі камерамен жүріңіз
Dialogue: 3,0:06:23.29,0:06:24.63,Default - JP,,0,0,0,,Жарықтандыруды аздап күшейтіңіз
Dialogue: 3,0:06:25.78,0:06:28.35,Default UP Small - JP,,0,0,0,,Бұл қыз менің сүйікті досым.
Dialogue: 3,0:06:29.07,0:06:29.71,Default - JP,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 3,0:06:30.62,0:06:31.40,Default - JP,,0,0,0,,(Ер адам) Аа… тоқта… Уа! (Әйелдің айқайы)
Dialogue: 3,0:06:32.42,0:06:34.12,Default - JP,,0,0,0,,Түпнұсқаға өте ұқсас
Dialogue: 3,0:06:35.44,0:06:37.20,Default - JP,,0,0,0,,Бұл түпнұсқа шығармадағы әйгілі көрініс
Dialogue: 3,0:06:37.93,0:06:40.46,Default - JP,,0,0,0,,Бағыт ниеті Композиция қарқыны
Dialogue: 3,0:06:41.05,0:06:42.30,Default - JP,,0,0,0,,Әр нәрсенің мағынасы бар
Dialogue: 3,0:06:43.75,0:06:47.76,Default - JP,,0,0,0,,Мен әрқашан автордың сезімі туралы ойлануды сұрайтын сұрақтарға жақсы жауап бердім.
Dialogue: 3,0:06:48.81,0:06:51.99,Default - JP,,0,0,0,,Шедеврді дұрыс жазсаңыз, өту бағасын аласыз.
Dialogue: 3,0:06:53.04,0:06:55.09,Default - JP,,0,0,0,,Қараңызшы, мен орын жасадым.
Dialogue: 3,0:06:55.54,0:06:56.82,Default - JP,,0,0,0,,Сіз мұны істегіңіз келді, солай ма?
Dialogue: 3,0:06:57.42,0:06:59.98,Default - JP,,0,0,0,,Байыптап көріңіз, Арима.
Dialogue: 3,0:07:03.86,0:07:05.54,Default - JP,,0,0,0,,Не істесем де, пайдасыз.
Dialogue: 3,0:07:06.14,0:07:07.01,Default - JP,,0,0,0,,Бұл көрініс
Dialogue: 3,0:07:07.59,0:07:09.87,Default - JP,,0,0,0,,Бастысы кейіпкердің көз жасы.
Dialogue: 3,0:07:10.66,0:07:12.70,Default - JP,,0,0,0,,Сол бір нүкте жарқырай берсін
Dialogue: 3,0:07:13.32,0:07:15.03,Default - JP,,0,0,0,,Мен қараңғылықты басқарамын
Dialogue: 3,0:07:19.11,0:07:21.21,Default - JP,,0,0,0,,Беріліңіз және өзіңізді алып кетіңіз.
Dialogue: 3,0:07:22.43,0:07:23.20,Default - JP,,0,0,0,,Қорқынышты
Dialogue: 3,0:07:24.04,0:07:24.80,Default - JP,,0,0,0,,Қорқынышты
Dialogue: 3,0:07:31.04,0:07:33.69,Default UP Small - JP,,0,0,0,,Сен ешкімге керек емессің
Dialogue: 3,0:07:33.92,0:07:36.19,Default UP Small - JP,,0,0,0,,Өзін-өзі танумен өмір сүр
Dialogue: 3,0:07:36.19,0:07:37.94,Default UP Small - JP,,0,0,0,,Армандамаңыз
Dialogue: 3,0:07:38.19,0:07:40.30,Default UP Small - JP,,0,0,0,,Бұдан былай ешнәрсе дұрыс болмайды.
Dialogue: 3,0:07:40.62,0:07:43.41,Default UP Small - JP,,0,0,0,,Сіздің өміріңіз тым қараңғылық.
Dialogue: 3,0:07:48.18,0:07:49.07,Default - JP,,0,0,0,,Аяқтау
Dialogue: 3,0:07:49.92,0:07:52.06,Default - JP,,0,0,0,,Егер Кана Арима жақсы жылай алса
Dialogue: 3,0:07:55.28,0:07:56.26,Default UP Small - JP,,0,0,0,,Кисаның маған басын айналдыра ғашық болуын қамтамасыз етуім керек
Dialogue: 3,0:07:57.61,0:07:58.55,Default UP Small - JP,,0,0,0,,Кисаның маған басын айналдыра ғашық болуын қамтамасыз етуім керек
Dialogue: 3,0:07:59.00,0:08:00.46,Default UP Small - JP,,0,0,0,,Өйткені жарық бар
Dialogue: 3,0:08:06.92,0:08:09.55,Default - JP,,0,0,0,,Бұл жақсы қадам болды.
Dialogue: 3,0:08:17.33,0:08:18.14,Default - JP,,0,0,0,,Нашар
Dialogue: 3,0:08:19.04,0:08:20.49,Default - JP,,0,0,0,,Ол маған жұдырығыммен тиді.
Dialogue: 3,0:08:20.88,0:08:22.05,Default - JP,,0,0,0,,Рикичиматт
Dialogue: 3,0:08:22.39,0:08:23.77,Default - JP,,0,0,0,,сыныпта өз орнын таба алмайтынын айтты.
Dialogue: 3,0:08:24.11,0:08:25.96,Default - JP,,0,0,0,,Мен оны әдейі ұрдым.
Dialogue: 3,0:08:26.92,0:08:29.46,Default - JP,,0,0,0,,Ақыр соңында, актерлік іс-әрекеттің барлығы эмоцияға байланысты.
Dialogue: 3,0:08:29.81,0:08:30.90,Default - JP,,0,0,0,,Бұл жақсы ойын болды.
Dialogue: 3,0:08:31.63,0:08:34.24,Default - JP,,0,0,0,,Менің ойымша, Арима соның арқасында байыпты бола алды.
Dialogue: 3,0:08:36.53,0:08:39.89,Default - JP,,0,0,0,,Сол жас қыз мені шатастырды.
Dialogue: 3,0:08:40.46,0:08:43.63,Default - JP,,0,0,0,,Өндіріс жоспарымен айналысуға тура келеді.
Dialogue: 3,0:08:44.21,0:08:45.50,Default - JP,,0,0,0,,Бұл жақсы.
Dialogue: 3,0:08:46.22,0:08:48.07,Default - JP,,0,0,0,,Мысалы, балалар актерлері көп болатын ортада.
Dialogue: 3,0:08:48.07,0:08:50.95,Default - JP,,0,0,0,,Сценарийді сол жерде қайта жазуға тура келді.
Dialogue: 3,0:08:51.32,0:08:53.15,Default - JP,,0,0,0,,Мен жастармен айналысамын.
Dialogue: 3,0:08:53.15,0:08:54.54,Default - JP,,0,0,0,,Ол қазірдің өзінде қосылды.
Dialogue: 3,0:08:56.32,0:09:00.09,Default - JP,,0,0,0,,Бұл тамаша көрініс болатын сияқты, мен Кана-чанның да бақытты болатынына сенімдімін.
Dialogue: 3,0:09:03.46,0:09:05.87,Default - JP,,0,0,0,,Кана-чан, соңғы көрініс дайын
Dialogue: 3,0:09:06.95,0:09:07.73,Default - JP,,0,0,0,,Кана-чан?
Dialogue: 3,0:09:08.11,0:09:09.30,Default - JP,,0,0,0,,Иә
Dialogue: 3,0:09:09.95,0:09:12.07,Default - JP,,0,0,0,,7-көрініс 310 кесінді
Dialogue: 3,0:09:12.51,0:09:13.31,Default - JP,,0,0,0,,Жақсы
Dialogue: 3,0:09:13.78,0:09:14.41,Default - JP,,0,0,0,,Stud
Dialogue: 3,0:09:30.43,0:09:33.09,Default - JP,,0,0,0,,Қайырлы таң Марс
Dialogue: 3,0:09:33.24,0:09:35.49,Default - JP,,0,0,0,,Ұйқың келсе төсекте ұйықта.
Dialogue: 3,0:09:35.49,0:09:37.11,Default - JP,,0,0,0,,Бұл сіздің арқаңызды нашарлатады.
Dialogue: 3,0:09:39.65,0:09:42.28,Default - JP,,0,0,0,,Мен төсекте қатты ұйықтаймын.
Dialogue: 3,0:09:42.28,0:09:45.92,Default - JP,,0,0,0,,Ағаш едендермен шамамен 4 сағатта оянуға болады.
Dialogue: 3,0:09:45.92,0:09:47.84,Default - JP,,0,0,0,,Денсаулыққа зиян тигізетін ұсақ-түйектер…
Dialogue: 3,0:09:49.32,0:09:50.77,Default - JP,,0,0,0,,Менің жұмысым бар.
Dialogue: 3,0:09:51.02,0:09:55.76,Default - JP,,0,0,0,,Әзірге мен есіктің фонын 2 және 1-де және 2-де 3-те көрсеттім.
Dialogue: 3,0:09:55.76,0:09:56.83,Default - JP,,0,0,0,,Сәлем
Dialogue: 3,0:09:57.66,0:09:59.48,Default - JP,,0,0,0,,Мен "Бүгін Ама" драмасын көріп жатырмын
Dialogue: 3,0:09:59.48,0:10:01.74,Default - JP,,0,0,0,,Аяқтауға жақын болғанда маған қоңырау шалыңыз.
Dialogue: 3,0:10:02.79,0:10:05.05,Default - JP,,0,0,0,,Мен оны жаңарту күнінде көремін.
Dialogue: 3,0:10:05.31,0:10:06.87,Default - JP,,0,0,0,,Екеуің көрген жоқсыңдар.
Dialogue: 3,0:10:06.87,0:10:08.40,Default - JP,,0,0,0,,Бастапқыда сәл ғана
Dialogue: 3,0:10:08.40,0:10:10.05,Default - JP,,0,0,0,,2 эпизодқа дейін
Dialogue: 3,0:10:10.74,0:10:12.55,Default - JP,,0,0,0,,Сіз зейнеткерсіз, солай емес пе?
Dialogue: 3,0:10:12.81,0:10:15.10,Default - JP,,0,0,0,,Оны көруге өзіңізді мәжбүрлеудің қажеті жоқ деп ойлаймын.
Dialogue: 3,0:10:15.69,0:10:18.80,Default - JP,,0,0,0,,Ұстаздың тоз-тоз болып жүргенде салған жұмысы
Dialogue: 3,0:10:18.80,0:10:21.42,Default - JP,,0,0,0,,Осындай кездейсоқ және келемеждік драма үшін
Dialogue: 3,0:10:22.14,0:10:24.80,Default - JP,,0,0,0,,Мен оны көре алмаймын деп ренжідім.
Dialogue: 3,0:10:25.06,0:10:26.13,Default - JP,,0,0,0,,Ахаха
Dialogue: 3,0:10:26.52,0:10:28.36,Default - JP,,0,0,0,,Мен оны әу бастан білдім.
Dialogue: 3,0:10:29.18,0:10:33.04,Default - JP,,0,0,0,,Манга қазірдің өзінде аяқталды және бұқаралық ақпарат құралдарында өседі деп күтілмейді.
Dialogue: 3,0:10:33.52,0:10:36.05,Default - JP,,0,0,0,,Мен кейбір қозғалыс үшін ризамын.
Dialogue: 3,0:10:36.32,0:10:38.40,Default - JP,,0,0,0,,Бұл менің шағымданатын жерім емес.
Dialogue: 3,0:10:39.30,0:10:42.09,Default - JP,,0,0,0,,Медиа өндірісінде тәжірибесі бар барлық манга суретшілері осылай дейді.
Dialogue: 3,0:10:42.41,0:10:44.67,Default - JP,,0,0,0,,«Ешқашан артық үміт күтпе».
Dialogue: 3,0:10:45.41,0:10:47.14,Default - JP,,0,0,0,,Бастапқыда әрбір манга суретшісі
Dialogue: 3,0:10:47.14,0:10:49.38,Default - JP,,0,0,0,,«Осылай болғанын қалаймын». «Осылай болса, мен бақытты болар едім».
Dialogue: 3,0:10:49.38,0:10:50.91,Default - JP,,0,0,0,,Мен алдандым және күлемін
Dialogue: 3,0:10:51.46,0:10:54.05,Default - JP,,0,0,0,,Аяқтаған кезде көңілсіз болып көрінесіз.
Dialogue: 3,0:10:54.72,0:10:58.63,Default - JP,,0,0,0,,Делдалдық деген осы...
Dialogue: 3,0:10:59.19,0:11:00.18,Default - JP,,0,0,0,,Кисаның маған басын айналдыра ғашық болуын қамтамасыз етуім керек
Dialogue: 3,0:11:00.64,0:11:01.90,Default - JP,,0,0,0,,Өйткені жарық бар
Dialogue: 3,0:11:06.72,0:11:07.70,Default - JP,,0,0,0,,Мұғалім?
Dialogue: 3,0:11:08.86,0:11:12.59,Default - JP,,0,0,0,,Оның драмаға айналғанына қуандым.
Dialogue: 3,0:11:14.03,0:11:16.48,Default - JP,,0,0,0,,Барлығы, соңғы эпизодты қараңыз.
Dialogue: 3,0:11:16.48,0:11:17.86,Default - JP,,0,0,0,,Бұл «Бүгінгі Ама»
Dialogue: 3,0:11:21.60,0:11:23.87,Default - JP,,0,0,0,,Көрермендердің көпшілігі қазірдің өзінде зейнеткер.
Dialogue: 3,0:11:24.35,0:11:25.49,Default - JP,,0,0,0,,Түпнұсқа жұмыстың негізгі жанкүйерлері
Dialogue: 3,0:11:25.49,0:11:28.25,Default - JP,,0,0,0,,Тек актердің жанкүйерлері көруді жалғастыратын мазмұн
Dialogue: 3,0:11:28.60,0:11:30.19,Default - JP,,0,0,0,,«Бүгінгі Ама» соңғы бөлімі
Dialogue: 3,0:11:30.82,0:11:33.91,Default - JP,,0,0,0,,Үлкен шу немесе тақырып болған жоқ.
Dialogue: 3,0:11:34.66,0:11:35.95,Default - JP,,0,0,0,,Тар ауданда
Dialogue: 3,0:11:36.20,0:11:38.45,Default - JP,,0,0,0,,Тыныш түрде ынталы мақтауларға ие болды.
Dialogue: 3,0:11:46.89,0:11:49.44,Default - JP,,0,0,0,,О, әлгі актер де оның ішінде болды ма?
Dialogue: 3,0:11:50.29,0:11:51.63,Default - JP,,0,0,0,,Оған былай қарау
Dialogue: 3,0:11:51.63,0:11:54.44,Default - JP,,0,0,0,,Тағы да, менің ойымша, көптеген адамдар қатысады.
Dialogue: 3,0:11:54.75,0:11:59.64,Default - JP,,0,0,0,,Иә, біздің қойылымымызға көптеген адамдардың еңбегі қатысады.
Dialogue: 3,0:12:00.14,0:12:01.85,Default - JP,,0,0,0,,Біз нәтиже шығаруымыз керек.
Dialogue: 3,0:12:02.09,0:12:04.16,Default - JP,,0,0,0,,Жанжалдардан басқа
Dialogue: 3,0:12:05.44,0:12:08.04,Default - JP,,0,0,0,,Айтпақшы, сіздің қызыңыз бар ма?
Dialogue: 3,0:12:08.38,0:12:10.39,Default - JP,,0,0,0,,Ешқандай жанжал да, түк те жоқ.
Dialogue: 3,0:12:10.82,0:12:11.35,Default - JP,,0,0,0,,Жоқ. Сенің мақсатың не екенін білмеймін, бірақ бұл күмәнді.
Dialogue: 3,0:12:15.23,0:12:17.30,Default - JP,,0,0,0,,Түсірілімге тынымсыз еңбек еткеніңіз үшін рахмет.
Dialogue: 3,0:12:17.30,0:12:18.95,Default - JP,,0,0,0,,О, ұстаз
Dialogue: 3,0:12:23.65,0:12:24.78,Default - JP,,0,0,0,,Бұл жұмыс
Dialogue: 3,0:12:25.01,0:12:27.91,Default - JP,,0,0,0,,Менің ойымша, оны Арима-санның актерлік шеберлігі қолдады.
Dialogue: 3,0:12:29.74,0:12:31.09,Default - JP,,0,0,0,,Сізге көп рахмет
Dialogue: 3,0:12:36.21,0:12:38.10,Default - JP,,0,0,0,,Әсіресе соңғы эпизод
Dialogue: 3,0:12:38.44,0:12:41.91,Default - JP,,0,0,0,,Мен бұл сезімді тезірек сезінгенімді қалаймын.
Dialogue: 3,0:12:43.84,0:12:45.37,Default - JP,,0,0,0,,Эй, Аква-кун
Dialogue: 3,0:12:45.87,0:12:47.87,Default - JP,,0,0,0,,Соңғы эпизод жақсы қабылданды.
Dialogue: 3,0:12:48.52,0:12:49.71,Default - JP,,0,0,0,,Рахмет
Dialogue: 3,0:12:50.14,0:12:52.99,Default - JP,,0,0,0,,Жұмыстан түсетін пайда жағынан қиын болғанымен.
Dialogue: 3,0:12:52.99,0:12:54.44,Default - JP,,0,0,0,,Сендей талантқа
Dialogue: 3,0:12:54.44,0:12:56.70,Default - JP,,0,0,0,,Мақсат - мүмкіндіктер беру.
Dialogue: 3,0:12:56.70,0:12:59.15,Default - JP,,0,0,0,,Бұған қол жеткізілді ме?
Dialogue: 3,0:13:00.00,0:13:03.19,Default - JP,,0,0,0,,Осы P темекі тұқылын сынау нәтижелері
Dialogue: 3,0:13:03.81,0:13:06.45,Default - JP,,0,0,0,,Мен мүлде бейтаныс адам екенімді түсіндім.
Dialogue: 3,0:13:06.77,0:13:08.15,Default - JP,,0,0,0,,Мен бір жағынан жеңілдеп қалдым.
Dialogue: 3,0:13:08.82,0:13:09.36,Default - JP,,0,0,0,,Жануар демі: жетінші форма
Dialogue: 3,0:13:09.61,0:13:12.02,Default - JP,,0,0,0,,Кимиичиго - кәсіпқой бала.
Dialogue: 3,0:13:12.93,0:13:17.40,Default - JP,,0,0,0,,Ол Айкунға ұқсайды.
Dialogue: 3,0:13:18.90,0:13:20.16,Default - JP,,0,0,0,,Солай ма?
Dialogue: 3,0:13:20.16,0:13:24.43,Default - JP,,0,0,0,,О, мен оның бетін жақыннан көрдім.
Dialogue: 3,0:13:24.43,0:13:25.49,Default - JP,,0,0,0,,Неге? Хм?
Dialogue: 3,0:13:26.25,0:13:28.30,Default - JP,,0,0,0,,Жақын?
Dialogue: 3,0:13:29.44,0:13:32.25,Default - JP,,0,0,0,,Аймен қандай қарым-қатынаста болдыңыз?
Dialogue: 3,0:13:33.35,0:13:36.80,Default - JP,,0,0,0,,Менімен сән журналдарына арналған модельдерге делдал болып жұмыс істеңіз.
Dialogue: 3,0:13:37.20,0:13:41.60,Default - JP,,0,0,0,,Содан бері мен саған жұмыс беріп қана қоймай, жан-жақты қамқорлық жасадым.
Dialogue: 3,0:13:42.18,0:13:44.24,Default - JP,,0,0,0,,Жақсы іскер серіктестерді таныстыру
Dialogue: 3,0:13:44.24,0:13:47.00,Default - JP,,0,0,0,,Кеңсеге айтпай бір бала кездескенде.
Dialogue: 3,0:13:47.00,0:13:48.89,Default - JP,,0,0,0,,Мен сізге жақсы мейрамханалар туралы айтып беремін.
Dialogue: 3,0:13:50.51,0:13:52.20,Default - JP,,0,0,0,,Сіз кіммен кездескеніңізді білесіз бе?
Dialogue: 3,0:13:52.58,0:13:53.31,Default - JP,,0,0,0,,Хмм?
Dialogue: 3,0:13:54.05,0:13:56.30,Default - JP,,0,0,0,,Сіз Ай-кунның жанкүйерісіз бе?
Dialogue: 3,0:13:56.71,0:13:58.80,Default - JP,,0,0,0,,Марқұмның ғайбатына қызықсың ба?
Dialogue: 3,0:13:59.81,0:14:00.59,Default - JP,,0,0,0,,Ширауды одан сайын тартыңыз!
Dialogue: 3,0:14:01.43,0:14:02.60,Default - JP,,0,0,0,,Бұл дұрыс.
Dialogue: 3,0:14:05.35,0:14:07.09,Default - JP,,0,0,0,,Мен сізге айта аламын.
Dialogue: 3,0:14:07.36,0:14:09.50,Default - JP,,0,0,0,,Мұны алмасу шарты деп атаймыз.
Dialogue: 3,0:14:10.31,0:14:13.72,Default - JP,,0,0,0,,Сіздің жүзіңіз Айкүнге ұқсайды және әдемі.
Dialogue: 3,0:14:15.83,0:14:19.06,Default - JP,,0,0,0,,Мен махаббат реалити-шоуларына қызығамын.
Dialogue: 3,0:14:22.73,0:14:25.00,Default - JP,,0,0,0,,Эй, сен әлі күтіп тұрсың ба, Руби?
Dialogue: 3,0:14:25.36,0:14:28.53,Default - JP,,0,0,0,,Тағы сәл күте тұрыңыз, ағайын.
Dialogue: 3,0:14:28.53,0:14:31.50,Default - JP,,0,0,0,,Бұл форма сүйкімді, бірақ күрделі.
Dialogue: 3,0:14:32.20,0:14:33.64,Default - JP,,0,0,0,,Бірақ бұл шынымен сүйкімді
Dialogue: 3,0:14:34.03,0:14:36.40,Default - JP,,0,0,0,,Бірінші күннен кешіккенім үшін кешірім сұраймын.
Dialogue: 3,0:14:38.39,0:14:40.07,Default - JP,,0,0,0,,Юбка тым қысқа емес пе?
Dialogue: 3,0:14:40.07,0:14:42.93,Default - JP,,0,0,0,,Үлкен аға әрқашан қарттың иісін аңқыған.
Dialogue: 3,0:14:43.81,0:14:44.85,Default - JP,,0,0,0,,Хигучи, қолыңды көтер де, көліктен шық.
Dialogue: 3,0:14:45.91,0:14:47.75,Default - JP,,0,0,0,,Мама, мен келе жатырмын.
Dialogue: 3,0:14:58.49,0:15:01.69,Default - JP,,0,0,0,,Алдағы үш жылда бір-біріміз...
Dialogue: 3,0:15:04.23,0:15:06.29,Default - JP,,0,0,0,,Сіз ойын-сауық бөлімінде F сыныбындасыз ба?
Dialogue: 3,0:15:06.29,0:15:08.21,Default - JP,,0,0,0,,Иә, мен сенімен жарты жолда барамын.
Dialogue: 3,0:15:09.82,0:15:11.60,Default - JP,,0,0,0,,Aqua бағдарламасына қабылдауыңызбен құттықтаймыз
Dialogue: 3,0:15:11.91,0:15:12.76,Default - JP,,0,0,0,,Және Руби
Dialogue: 3,0:15:13.21,0:15:18.44,Default - JP,,0,0,0,,Мұнда Йото орта мектебінде сабақ кестесі басқа орта мектептерге қарағанда икемді.
Dialogue: 3,0:15:18.44,0:15:22.90,Default - JP,,0,0,0,,Егер қызыл баға алсаңыз немесе жеткілікті күн бармасаңыз, бағаны қайталайсыз.
Dialogue: 3,0:15:22.90,0:15:25.11,Default - JP,,0,0,0,,Оқу бағдарламасы басқаша емес.
Dialogue: 3,0:15:25.50,0:15:26.16,Default - JP,,0,0,0,,Бірақ!
Dialogue: 3,0:15:26.91,0:15:27.95,Default - JP,,0,0,0,,Бұл бала актер
Dialogue: 3,0:15:28.60,0:15:31.16,Default - JP,,0,0,0,,Бұл екеуі ең үлкен пұт тобынан
Dialogue: 3,0:15:31.74,0:15:34.25,Default - JP,,0,0,0,,Үлкен кеуделі қыз - гравюралық модель
Dialogue: 3,0:15:34.80,0:15:38.18,Default - JP,,0,0,0,,Бұл дауыс актері, стример, сән үлгісі және әнші.
Dialogue: 3,0:15:38.46,0:15:41.21,Default - JP,,0,0,0,,Кабуки актерлері мен актрисалары орындықта отырады.
Dialogue: 3,0:15:42.81,0:15:44.39,Default - JP,,0,0,0,,Барлығы атақты адамдар
Dialogue: 3,0:15:45.21,0:15:49.68,Default - JP,,0,0,0,,Бұл сонымен қатар Жапонияда ең көп адам бақыланатын орта мектеп.
Dialogue: 3,0:15:50.35,0:15:52.34,Default - JP,,0,0,0,,Қош келдің, кенже.
Dialogue: 3,0:15:53.15,0:15:54.95,Default - JP,,0,0,0,,Ойын-сауық әлеміне қош келдіңіз
Dialogue: 3,0:16:00.28,0:16:02.03,Default - JP,,0,0,0,,Мен қобалжыдым.
Dialogue: 3,0:16:02.03,0:16:03.53,Default - JP,,0,0,0,,Мұның қажеті жоқ.
Dialogue: 3,0:16:03.97,0:16:06.46,Default - JP,,0,0,0,,Бұл оқу мектебі немесе фотостудия емес.
Dialogue: 3,0:16:06.46,0:16:08.22,Default - JP,,0,0,0,,Бұл қалыпты мектеп.
Dialogue: 3,0:16:08.22,0:16:09.89,Default - JP,,0,0,0,,Оны қалыпты күйде сақтаңыз.
Dialogue: 3,0:16:17.51,0:16:18.75,Default - JP,,0,0,0,,Уау
Dialogue: 3,0:16:21.71,0:16:23.10,Default - JP,,0,0,0,,Оң жаққа қарасаңыз, әдемі әйелді көресіз
Dialogue: 3,0:16:23.10,0:16:24.60,Default - JP,,0,0,0,,Сол жаққа қарасаңыз, әдемі жігітті көресіз
Dialogue: 3,0:16:24.88,0:16:28.30,Default - JP,,0,0,0,,Жергілікті орта мектептен айырмашылығы анық
Dialogue: 3,0:16:29.61,0:16:30.72,Default - JP,,0,0,0,,Дегенмен
Dialogue: 3,0:16:30.72,0:16:32.92,Default - JP,,0,0,0,,Мен де анамның гендерін мұра еттім.
Dialogue: 3,0:16:32.92,0:16:35.20,Default - JP,,0,0,0,,Жүзімнен жеңілген жоқпын.
Dialogue: 3,0:16:38.53,0:16:40.20,Default - JP,,0,0,0,,Жұтатын нәрсе ме?
Dialogue: 3,0:16:43.31,0:16:44.89,Default - JP,,0,0,0,,Керемет балалар бар
Dialogue: 3,0:16:47.31,0:16:50.65,Default - JP,,0,0,0,,Ой, кешіріңіз, мен сізге қарап тұра бердім.
Dialogue: 3,0:16:51.22,0:16:53.30,Default - JP,,0,0,0,,Мен сені өте әдемі деп ойладым...
Dialogue: 3,0:16:53.49,0:16:56.04,Default - JP,,0,0,0,,Өйткені ойын-сауық бөлімі керемет.
Dialogue: 3,0:16:56.50,0:16:58.30,Default - JP,,0,0,0,,Жоқ, жоқ, сен де...
Dialogue: 3,0:16:58.75,0:16:59.70,Default - JP,,0,0,0,,Үлгі
Dialogue: 3,0:16:59.92,0:17:02.25,Default - JP,,0,0,0,,А, менің ойымша, бәрі жақсы.
Dialogue: 3,0:17:02.80,0:17:06.45,Default - JP,,0,0,0,,Менің атым Минами Учисато.
Dialogue: 3,0:17:06.90,0:17:08.71,Default - JP,,0,0,0,,Минами Котобуки…
Dialogue: 3,0:17:08.99,0:17:11.07,Default - JP,,0,0,0,,Ах! Мен гравюра пұттарымен айналысамын
Dialogue: 3,0:17:11.07,0:17:14.10,Default - JP,,0,0,0,,Сіздің алдыңызда Google-ге кіру адамгершілікке жатпайды емес пе?
Dialogue: 3,0:17:14.31,0:17:17.27,Default - JP,,0,0,0,,Сәлем Г Эчиечижан
Dialogue: 3,0:17:17.27,0:17:18.40,Default - JP,,0,0,0,,Тоқта!
Dialogue: 3,0:17:18.40,0:17:20.54,Default - JP,,0,0,0,,Нағыз Қансай диалектісін бірінші рет естідім.
Dialogue: 3,0:17:20.54,0:17:21.53,Default - JP,,0,0,0,,Сіз Осакадансыз ба?
Dialogue: 3,0:17:21.79,0:17:24.89,Default - JP,,0,0,0,,Ах, мен Канагавада туып-өстім.
Dialogue: 3,0:17:24.89,0:17:26.94,Default - JP,,0,0,0,,Оны қалай айтасыз?
Dialogue: 3,0:17:27.28,0:17:27.75,Default - JP,,0,0,0,,Нори?
Dialogue: 3,0:17:27.75,0:17:29.39,Default - JP,,0,0,0,,Бұл жалған қансай диалектісі еді! ?
Dialogue: 3,0:17:29.87,0:17:32.44,Default - JP,,0,0,0,,Осылайша мен Минами-чанмен дос болдым.
Dialogue: 3,0:17:32.44,0:17:33.66,Default - JP,,0,0,0,,Бұл қандай сезімде?
Dialogue: 3,0:17:34.05,0:17:35.15,Default - JP,,0,0,0,,Сәлем
Dialogue: 3,0:17:35.56,0:17:38.16,Default - JP,,0,0,0,,Мен достар тапқаныма қуаныштымын.
Dialogue: 3,0:17:38.54,0:17:40.16,Default - JP,,0,0,0,,Менің ағам дос болды.
Dialogue: 3,0:17:42.29,0:17:46.04,Default - JP,,0,0,0,,Жоқ, мен бұл мектепке достасу үшін келген жоқпын.
Dialogue: 3,0:17:46.62,0:17:48.84,Default - JP,,0,0,0,,Әй, бұл орындалмайтын нәрсе.
Dialogue: 3,0:17:49.53,0:17:51.60,Default - JP,,0,0,0,,Осындай ауыртпалықты естігеніме өкінемін.
Dialogue: 3,0:17:51.60,0:17:54.02,Default - JP,,0,0,0,,​​Бізге енді сыныпта сөйлесудің қажеті жоқ.
Dialogue: 3,0:17:54.02,0:17:56.25,Default - JP,,0,0,0,,Ақыры мен сөйлесетін адамды таптым!
Dialogue: 3,0:17:56.56,0:17:59.19,Default - JP,,0,0,0,,Ұлдар сізді кенеттен дос ретінде қабылдамайды.
Dialogue: 3,0:17:59.51,0:18:02.31,Default - JP,,0,0,0,,Әрине, жалпы оқу пәндері одан ерекшеленеді, өйткені олар орта және жоғары мектеппен біріктірілген.
Dialogue: 3,0:18:02.31,0:18:04.32,Default - JP,,0,0,0,,Біздің достығымыз белгілі бір дәрежеде аяқталды.
Dialogue: 3,0:18:04.32,0:18:06.56,Default - JP,,0,0,0,,Достықты тереңдету үшін уақыт қажет.
Dialogue: 3,0:18:06.56,0:18:08.91,Default - JP,,0,0,0,,Мен мектепте жалғыз қалғандай емеспін, түсінемін.
Dialogue: 3,0:18:09.38,0:18:12.11,Default - JP,,0,0,0,,Аква өте сөйлеп тұр.
Dialogue: 3,0:18:12.62,0:18:15.86,Default - JP,,0,0,0,,Минами-чан, Аквамен де дос бол.
Dialogue: 3,0:18:15.86,0:18:17.84,Default - JP,,0,0,0,,Ахаха, иә.
Dialogue: 3,0:18:17.84,0:18:19.55,Default - JP,,0,0,0,,Достарыңызды бөлмеңіз
Dialogue: 3,0:18:20.31,0:18:22.57,Default - JP,,0,0,0,,Мен жақсымын, сондықтан өзіңді уайымда.
Dialogue: 3,0:18:22.96,0:18:25.21,Default - JP,,0,0,0,,Бұл ерекше орта және сіздің қалауларыңыз басқаша.
Dialogue: 3,0:18:25.57,0:18:27.21,Default - JP,,0,0,0,,Бұл дұрыс, солай емес пе?
Dialogue: 3,0:18:27.51,0:18:29.46,Default - JP,,0,0,0,,Менің айналамдағы адамдар да кәсіби мамандар деп ойлаймын.
Dialogue: 3,0:18:29.46,0:18:32.00,Default - JP,,0,0,0,,Мен қатты қобалжыдым.
Dialogue: 3,0:18:32.00,0:18:33.72,Default - JP,,0,0,0,,Мұның қажеті жоқ.
Dialogue: 3,0:18:34.05,0:18:36.53,Default - JP,,0,0,0,,Бұл оқу мектебі немесе фотостудия емес.
Dialogue: 3,0:18:36.53,0:18:38.28,Default - JP,,0,0,0,,Бұл қалыпты мектеп.
Dialogue: 3,0:18:38.28,0:18:39.95,Default - JP,,0,0,0,,Оны қалыпты күйде сақтаңыз.
Dialogue: 3,0:18:40.42,0:18:41.71,Default - JP,,0,0,0,,Руби-чан
Dialogue: 3,0:18:41.71,0:18:43.95,Default - JP,,0,0,0,,Мен бір жерден дәл осы сызықты естідім.
Dialogue: 3,0:18:44.91,0:18:47.32,Default - JP,,0,0,0,,Бұл кіру рәсіміне ұқсайды
Dialogue: 3,0:18:47.32,0:18:49.56,Default - JP,,0,0,0,,Түрі жақсы адамдар көп.
Dialogue: 3,0:18:49.56,0:18:52.24,Default - JP,,0,0,0,,Оны бұқаралық ақпарат құралдарынан ешкім дерлік көрмеген.
Dialogue: 3,0:18:52.24,0:18:54.03,Default - JP,,0,0,0,,Менің ойымша, қобалжудың қажеті жоқ.
Dialogue: 3,0:18:54.29,0:18:55.11,Default - JP,,0,0,0,,Жоқ
Dialogue: 3,0:18:55.90,0:18:58.24,Default - JP,,0,0,0,,Қандай керемет адам болған
Dialogue: 3,0:18:59.40,0:19:03.59,Default - JP,,0,0,0,,Олай болса, бізге оқу материалдары сияқты материалдарды сатып алу керек болады...
Dialogue: 3,0:19:05.18,0:19:06.16,Default - JP,,0,0,0,,Кешіріңіз
Dialogue: 3,0:19:07.10,0:19:09.39,Default - JP,,0,0,0,,Kyouban Sen арнасында таңғы тікелей эфир болды.
Dialogue: 3,0:19:09.83,0:19:12.00,Default - JP,,0,0,0,,Мен ең болмағанда кіру салтанатында көрінгім келді.
Dialogue: 3,0:19:12.97,0:19:14.59,Default - JP,,0,0,0,,Shiranui Frill…
Dialogue: 3,0:19:15.05,0:19:16.64,Default - JP,,0,0,0,,Shiranui Frill...
Dialogue: 3,0:19:17.28,0:19:18.85,Default - JP,,0,0,0,,Уау
Dialogue: 3,0:19:20.24,0:19:22.35,Default - JP,,0,0,0,,Фрилл Ширануи болды!
Dialogue: 3,0:19:23.23,0:19:25.02,Default - JP,,0,0,0,,9 қыркүйекте драмада үлкен хит болды
Dialogue: 3,0:19:25.02,0:19:27.76,Default - JP,,0,0,0,,Ән айта алатын, билейтін және ойнай алатын көп талантты!
Dialogue: 3,0:19:28.03,0:19:32.44,Default - JP,,0,0,0,,Адамдардың көпшілігі әдемі қыздар туралы ойлағанда, бірінші ойға Ширануи бұйралары келеді!
Dialogue: 3,0:19:32.91,0:19:34.55,Default - JP,,0,0,0,,Жоқ, әрине білемін.
Dialogue: 3,0:19:35.01,0:19:37.16,Default - JP,,0,0,0,,Сіз сондай құмар болдыңыз ба?
Dialogue: 3,0:19:37.16,0:19:38.45,Default - JP,,0,0,0,,Дәл қазір бұл менің сүйікті.
Dialogue: 3,0:19:39.01,0:19:40.00,Default - JP,,0,0,0,,Хмм——
Dialogue: 3,0:19:40.00,0:19:43.23,Default - JP,,0,0,0,,Бұл Ширануи бүйрегі.
Dialogue: 3,0:19:43.23,0:19:44.18,Default - JP,,0,0,0,,Қызық емес
Dialogue: 3,0:19:44.50,0:19:47.66,Default - JP,,0,0,0,,Менің сүйікті және әрқашан Ай.
Dialogue: 3,0:19:48.73,0:19:50.93,Default - JP,,0,0,0,,Мен де солай.
Dialogue: 3,0:19:50.93,0:19:53.02,Default - JP,,0,0,0,,Міне, мынау.
Dialogue: 3,0:19:53.36,0:19:55.91,Default - JP,,0,0,0,,А, қараңдаршы, мына жерде шын нәрсе бар.
Dialogue: 3,0:19:56.62,0:19:59.64,Default - JP,,0,0,0,,Ха, тіпті алыстан сүйкімді
Dialogue: 3,0:19:59.64,0:20:01.18,Default - JP,,0,0,0,,Шынымды айтсам, мен жай ғана жанкүйермін.
Dialogue: 3,0:20:01.41,0:20:02.81,Default - JP,,0,0,0,,Олар сыныптастар.
Dialogue: 3,0:20:02.81,0:20:04.15,Default - JP,,0,0,0,,Өйткені...
Dialogue: 3,0:20:06.14,0:20:07.73,Default - JP,,0,0,0,,Сәлем Ширануй-сан
Dialogue: 3,0:20:09.23,0:20:11.65,Default - JP,,0,0,0,,Менің әпкем сізбен бір сыныпта оқиды.
Dialogue: 3,0:20:12.01,0:20:13.25,Default - JP,,0,0,0,,​​Маған мейірімді болыңыз.
Dialogue: 3,0:20:13.76,0:20:15.42,Default - JP,,0,0,0,,Сәлем бауырым
Dialogue: 3,0:20:16.05,0:20:17.25,Default - JP,,0,0,0,,Сіз білесіз
Dialogue: 3,0:20:17.66,0:20:19.04,Default - JP,,0,0,0,,"Today Ama" бағдарламасында пайда болған адамдар
Dialogue: 3,0:20:19.32,0:20:20.34,Default - JP,,0,0,0,,Сіз мені өте жақсы білесіз.
Dialogue: 3,0:20:20.61,0:20:22.44,Default - JP,,0,0,0,,Бұл тіпті талқылау тақырыбы да емес еді.
Dialogue: 3,0:20:22.74,0:20:25.89,Default - JP,,0,0,0,,Мен өткен күні оқиға орнында бұл туралы айтылып жатқанын көрдім.
Dialogue: 3,0:20:26.94,0:20:27.79,Default - JP,,0,0,0,,Жақсы
Dialogue: 3,0:20:29.52,0:20:30.39,Default - JP,,0,0,0,,Рахмет
Dialogue: 3,0:20:31.42,0:20:34.59,Default - JP,,0,0,0,,Мен оны Миджанның мұқабасынан көрдім.
Dialogue: 3,0:20:34.96,0:20:36.35,Default - JP,,0,0,0,,Бұл Минами болды ма?
Dialogue: 3,0:20:36.35,0:20:36.99,Default - JP,,0,0,0,,Иә!
Dialogue: 3,0:20:37.62,0:20:38.50,Default - JP,,0,0,0,,Бірінші болып Айс Фриз!
Dialogue: 3,0:20:38.98,0:20:41.94,Default - JP,,0,0,0,,Олардың екеуін де Ширануи Фрилл таниды!
Dialogue: 3,0:20:42.62,0:20:43.51,Default - JP,,0,0,0,,Өлімдік күнәлардың кардиналына тән нәрсе деп айтуға болатын шығар.
Dialogue: 3,0:20:44.32,0:20:45.09,Default - JP,,0,0,0,,Ал...
Dialogue: 3,0:20:45.66,0:20:48.25,Default - JP,,0,0,0,,Кешіріңіз, сіз не істеп жатырсыз?
Dialogue: 3,0:20:48.56,0:20:50.44,Default - JP,,0,0,0,,Мен… бұл…
Dialogue: 3,0:20:51.09,0:20:53.73,Default - JP,,0,0,0,,Әсіресе қазір...
Dialogue: 3,0:20:54.07,0:20:54.80,Default - JP,,0,0,0,,Иә
Dialogue: 3,0:20:55.55,0:20:56.51,Default - JP,,0,0,0,,Ал...
Dialogue: 3,0:20:57.16,0:20:58.01,Default - JP,,0,0,0,,Сәттілік пе?
Dialogue: 3,0:20:58.77,0:21:00.55,Default - JP,,0,0,0,,Мияэмо!
Dialogue: 3,0:21:00.55,0:21:03.03,Default - JP,,0,0,0,,Тезірек мені пұтқа айналдыр
Dialogue: 3,0:21:03.21,0:21:04.99,Default - JP,,0,0,0,,Мені асықпа
Dialogue: 3,0:21:05.25,0:21:09.16,Default - JP,,0,0,0,,Мен айдол тобын құрғалы жатырмын, бірақ мен жай ғана тыңдаумен айналыса алмаймын.
Dialogue: 3,0:21:09.68,0:21:11.17,Default - JP,,0,0,0,,Бірақ бұл осылай қала берсе...
Dialogue: 3,0:21:11.72,0:21:14.31,Default - JP,,0,0,0,,Бұл баланың арнайы жұмысы жоқ сияқты.
Dialogue: 3,0:21:14.31,0:21:15.92,Default - JP,,0,0,0,,О, сен қарапайым адамсың.
Dialogue: 3,0:21:16.13,0:21:18.52,Default - JP,,0,0,0,,Неге екені белгісіз, қарапайым халық араласып кеткен.
Dialogue: 3,0:21:18.52,0:21:20.43,Default - JP,,0,0,0,,Бұл қиын Миха
Dialogue: 3,0:21:21.12,0:21:23.13,Default - JP,,0,0,0,,Бұлай жалғаса берсе, мені қорқытады
Dialogue: 3,0:21:23.65,0:21:25.65,Default - JP,,0,0,0,,Тиісті топты қалай құруға болады
Dialogue: 3,0:21:25.65,0:21:28.78,Default - JP,,0,0,0,,Скаутты жалдау үшін тиісті процедуралардан өту керек.
Dialogue: 3,0:21:29.03,0:21:31.71,Default - JP,,0,0,0,,Сүйкімді қыздарды таба алмайсың.
Dialogue: 3,0:21:32.53,0:21:36.24,Default - JP,,0,0,0,,Мотивацияланған балалар әрқашан дерлік ірі тыңдауларға жіберіледі.
Dialogue: 3,0:21:36.53,0:21:39.13,Default - JP,,0,0,0,,Ойын-сауық бөліміндегі менің атым Минами Котобуки.
Dialogue: 3,0:21:39.13,0:21:41.39,Default - JP,,0,0,0,,Күлкілі үлкен кеудесі бар сүйкімді қыз бар.
Dialogue: 3,0:21:41.39,0:21:43.74,Default - JP,,0,0,0,,Ол басқа агенттіктен, солай ма? Жоқ!
Dialogue: 3,0:21:44.36,0:21:46.21,Default - JP,,0,0,0,,Тегін бала болса жақсы болар еді.
Dialogue: 3,0:21:46.59,0:21:48.94,Default - JP,,0,0,0,,Кеңселер арасындағы қақтығыс үшін кешіріңіз.
Dialogue: 3,0:21:51.85,0:21:53.60,Default - JP,,0,0,0,,Тегін болса, ол бар.
Dialogue: 3,0:21:54.83,0:21:58.50,Default - JP,,0,0,0,,Менің атым фрилансер ретінде танымал болса да, менің жұмысым жоқ.
Dialogue: 3,0:21:59.71,0:22:00.90,Default - JP,,0,0,0,,Сүйкімді жүзді қыз
