Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:53.88,0:00:58.85,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:01:05.10,0:01:08.10,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:01:10.69,0:01:13.03,Default,,0,0,0,,прапорщик! Ол жоғарыда! жоғарыда!
Dialogue: 0,0:01:13.11,0:01:14.19,Default,,0,0,0,,Уф! ?
Dialogue: 0,0:01:16.74,0:01:18.16,Default,,0,0,0,,А-а-а-а!
Dialogue: 0,0:01:21.41,0:01:23.45,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:24.08,0:01:25.29,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:01:31.80,0:01:32.92,Default,,0,0,0,,Уф
Dialogue: 0,0:01:33.00,0:01:35.17,Default,,0,0,0,,Уау...
Dialogue: 0,0:01:35.26,0:01:38.72,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:01:59.86,0:02:01.91,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:02:07.71,0:02:09.71,Default,,0,0,0,,-(Бала) Бітті. -(Бала) Доан жеңді.
Dialogue: 0,0:02:09.79,0:02:11.58,Default,,0,0,0,,- (Бала) Шешілді! -(Бала) Доан сен мықтысың!
Dialogue: 0,0:02:11.67,0:02:14.84,Default,,0,0,0,,Енді бәрің үндеріңді жауып, ұйықтаңдар!
Dialogue: 0,0:02:14.92,0:02:18.84,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:03:01.30,0:03:04.01,Default,,0,0,0,,Бұл маңызды миссия
Dialogue: 0,0:03:04.10,0:03:05.89,Default,,0,0,0,,Гибралтарды басып алғанға дейін —
Dialogue: 0,0:03:05.97,0:03:10.89,Default,,0,0,0,,Барлық ықтимал кедергілерді жою керек!
Dialogue: 0,0:03:10.98,0:03:13.15,Default,,0,0,0,,Жақында бұл Лас-Пальмас —
Dialogue: 0,0:03:13.23,0:03:16.44,Default,,0,0,0,,Маршал Гоптың атасы өтті.
Dialogue: 0,0:03:16.52,0:03:19.40,Default,,0,0,0,,Мұндай кезде... бұл!
Dialogue: 0,0:03:19.49,0:03:23.03,Default,,0,0,0,,Алегранца аралы сияқты ештеңе болмауы керек!
Dialogue: 0,0:03:23.82,0:03:25.37,Default,,0,0,0,,Бұл аралда...
Dialogue: 0,0:03:25.45,0:03:27.41,Default,,0,0,0,,Қалған тыңшылар бар ма?
Dialogue: 0,0:03:27.79,0:03:29.95,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:03:30.04,0:03:35.79,Default,,0,0,0,,Күні кеше ғана осы аралда жасырынған жаулар екі спорт залын қиратты.
Dialogue: 0,0:03:36.21,0:03:38.55,Default,,0,0,0,,Бұл енді қалдық жау емес —
Dialogue: 0,0:03:38.63,0:03:41.93,Default,,0,0,0,,Оларды арнайы миссиясы бар қалған тыңшылар ретінде қарастыру керек.
Dialogue: 0,0:03:42.01,0:03:43.05,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:45.64,0:03:47.06,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:03:47.60,0:03:51.06,Default,,0,0,0,,Сіз шуақты жолмен келе жатырсыз.
Dialogue: 0,0:03:51.14,0:03:56.19,Default,,0,0,0,,Ол бұл үшін тағы бір рет танылды және ерекше екінші дәрежелі арнайы жоғарылатылды.
Dialogue: 0,0:03:57.15,0:04:00.82,Default,,0,0,0,,Менің ойымша, бұл басқа біреуді алмастыра алмайтыныңызды білдіреді.
Dialogue: 0,0:04:00.90,0:04:04.07,Default,,0,0,0,,Бірақ күн сайын жағдай өзгеруде.
Dialogue: 0,0:04:04.78,0:04:06.87,Default,,0,0,0,,Жылдам әңгіме, сіз жеткіздіңіз.
Dialogue: 0,0:04:06.95,0:04:10.79,Default,,0,0,0,,Мен «Гундам» мобильді костюмінің прототипін жасадым.
Dialogue: 0,0:04:10.87,0:04:13.37,Default,,0,0,0,,Қазір спорт залдарының жаппай өндірісі жолға қойылған...
Dialogue: 0,0:04:13.46,0:04:15.71,Default,,0,0,0,,Тек жеке адам
Dialogue: 0,0:04:15.79,0:04:18.96,Default,,0,0,0,,Олай болса, бұл миссия да басқа бөлімшеге жіберіледі...
Dialogue: 0,0:04:19.46,0:04:21.97,Default,,0,0,0,,Әскер негізінен бөлімшелерде ұйымдастырылған!
Dialogue: 0,0:04:22.76,0:04:29.51,Default,,0,0,0,,Осы кеме сияқты тәуелсіз күш жеке мақсаттарға оңай жауап бере алады.
Dialogue: 0,0:04:32.02,0:04:34.44,Default,,0,0,0,,Бас штабтың бұйрықтарын жіберіңіз!
Dialogue: 0,0:04:35.19,0:04:40.32,Default,,0,0,0,,Сіздің кемеңіз Алегранца аралында қалған жауларды жеңу үшін өз күшін пайдаланады.
Dialogue: 0,0:04:40.40,0:04:42.24,Default,,0,0,0,,Тазарту керек!
Dialogue: 0,0:04:43.82,0:04:46.61,Default,,0,0,0,,Алегранца аралында қалған тыңшыларды жойыңыз
Dialogue: 0,0:04:47.24,0:04:49.33,Default,,0,0,0,,Бұл маңызды тапсырма
Dialogue: 0,0:04:50.24,0:04:53.62,Default,,0,0,0,,Арал Канар аралдарының ең солтүстік бөлігінде орналасқан.
Dialogue: 0,0:04:53.71,0:04:55.62,Default,,0,0,0,,Бұл кішкентай арал.
Dialogue: 0,0:04:55.71,0:04:57.58,Default,,0,0,0,,Диаметрі шамамен 5 км
Dialogue: 0,0:04:58.50,0:05:01.13,Default,,0,0,0,,О, маяк бар ма?
Dialogue: 0,0:05:01.50,0:05:02.88,Default,,0,0,0,,Бұл ескі.
Dialogue: 0,0:05:03.21,0:05:06.55,Default,,0,0,0,,Жабдық бұзылған және жылдар бойы пайдаланылмаған.
Dialogue: 0,0:05:06.63,0:05:08.14,Default,,0,0,0,,Маған үш дана беріңіз.
Dialogue: 0,0:05:08.22,0:05:10.64,Default,,0,0,0,,Елсіз аралды тазарту дегеніміз не?
Dialogue: 0,0:05:10.72,0:05:13.52,Default,,0,0,0,,Мен кішкене жұмысты орындауға мәжбүр болдым.
Dialogue: 0,0:05:13.89,0:05:15.52,Default,,0,0,0,,Жеке сөйлеспеңіз!
Dialogue: 0,0:05:19.23,0:05:21.27,Default,,0,0,0,,Лейтенант Слеггер жоқ.
Dialogue: 0,0:05:22.28,0:05:24.78,Default,,0,0,0,,Взвод мүшелерімен сусын ішуге шығу...
Dialogue: 0,0:05:24.86,0:05:27.78,Default,,0,0,0,,(Шукуна) Ә, мен бұған мұқтаж емеспін, білесің бе—
Dialogue: 0,0:05:28.57,0:05:29.87,Default,,0,0,0,,Қалай алмұрт
Dialogue: 0,0:05:29.95,0:05:32.16,Default,,0,0,0,,Бүгін менің көңіл-күйім өте нашар.
Dialogue: 0,0:05:32.24,0:05:35.79,Default,,0,0,0,,Ефрейтор Кай Шиден! Мылтық зеңбірекпен орналастырыңыз
Dialogue: 0,0:05:36.25,0:05:38.33,Default,,0,0,0,,Және прапорщик Амуро!
Dialogue: 0,0:05:38.42,0:05:39.29,Default,,0,0,0,,Э…?—
Dialogue: 0,0:05:39.67,0:05:41.09,Default,,0,0,0,,Гундаммен бірге шығыңыз
Dialogue: 0,0:05:41.17,0:05:42.80,Default,,0,0,0,,Сержант Джоб – «Гунперридің» капитаны!
Dialogue: 0,0:05:42.88,0:05:43.71,Default,,0,0,0,,Ха!
Dialogue: 0,0:05:43.80,0:05:45.17,Default,,0,0,0,,Ефрейтор Хаято - зеңбірекші!
Dialogue: 0,0:05:45.26,0:05:47.05,Default,,0,0,0,,- Иә! -Жақсы!
Dialogue: 0,0:05:47.51,0:05:48.55,Default,,0,0,0,,Ум...
Dialogue: 0,0:05:49.18,0:05:50.18,Default,,0,0,0,,Не! ?
Dialogue: 0,0:05:50.64,0:05:52.68,Default,,0,0,0,,Мен де келемін бе?
Dialogue: 0,0:05:52.76,0:05:53.85,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:53.93,0:05:56.52,Default,,0,0,0,,Бұл мәңгілік прототип емес!
Dialogue: 0,0:05:56.60,0:05:59.15,Default,,0,0,0,,Менің ойымша, сізге ерекше күтім көрсетіледі.
Dialogue: 0,0:06:00.65,0:06:01.69,Default,,0,0,0,,Әй!
Dialogue: 0,0:06:10.53,0:06:12.20,Default,,0,0,0,,Ах Амуро
Dialogue: 0,0:06:12.58,0:06:14.08,Default,,0,0,0,,Әр сынып үшін түрлі жарыстарға іріктеу кезеңдері өткізіледі—
Dialogue: 0,0:06:14.16,0:06:15.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:16.29,0:06:17.33,Default,,0,0,0,,О
Dialogue: 0,0:06:18.16,0:06:19.42,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:06:20.88,0:06:22.25,Default,,0,0,0,,Сен Құбыжықтарды жоюшылар корпусының мүшесі емессің бе?
Dialogue: 0,0:06:22.34,0:06:24.59,Default,,0,0,0,,Менде жағымсыз сезім бар.
Dialogue: 0,0:06:25.00,0:06:27.55,Default,,0,0,0,,Жарайды, Сайла-сан.
Dialogue: 0,0:06:31.76,0:06:34.35,Default,,0,0,0,,Қызық... ол сондай болды ма екен.
Dialogue: 0,0:06:34.43,0:06:36.27,Default,,0,0,0,,Майор?
Dialogue: 0,0:06:36.35,0:06:38.98,Default,,0,0,0,,Хун, мұрныңа қой
Dialogue: 0,0:06:39.06,0:06:42.86,Default,,0,0,0,,Бұл асыра сілтеу. Ол кісі де қиналып жүр.
Dialogue: 0,0:06:43.15,0:06:45.07,Default,,0,0,0,,Мен олай ойламаймын
Dialogue: 0,0:06:45.15,0:06:47.94,Default,,0,0,0,,Аа, дұрыс, солай деді.
Dialogue: 0,0:06:48.03,0:06:50.74,Default,,0,0,0,,«Занчичоша» дегеніміз не?
Dialogue: 0,0:06:50.82,0:06:52.57,Default,,0,0,0,,Қалған шпион дегеніміз не?
Dialogue: 0,0:06:52.66,0:06:57.87,Default,,0,0,0,,Әскерилер диверсиялық барлау жұмыстарын жүргізу үшін шегінгеннен кейін артта қалуға батылы бар адам.
Dialogue: 0,0:06:57.95,0:07:01.33,Default,,0,0,0,,Хмм, жоқ, бұл рөл.
Dialogue: 0,0:07:02.33,0:07:05.75,Default,,0,0,0,,Сержант, жағымсыз бұлт пайда болды.
Dialogue: 0,0:07:06.09,0:07:07.76,Default,,0,0,0,,Бұл боран ма?
Dialogue: 0,0:07:07.84,0:07:09.67,Default,,0,0,0,,Жоқ, бұл үлкенірек бұлт.
Dialogue: 0,0:07:10.30,0:07:12.97,Default,,0,0,0,,Бұл жылдың осы мезгілі үшін әдеттен тыс.
Dialogue: 0,0:07:18.52,0:07:19.73,Default,,0,0,0,,
Dialogue: 0,0:07:19.81,0:07:20.81,Default,,0,0,0,,Қою
Dialogue: 0,0:07:23.44,0:07:24.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:24.52,0:07:27.19,Default,,0,0,0,,Кофе алғыңыз келе ме?
Dialogue: 0,0:07:27.57,0:07:29.69,Default,,0,0,0,,А? Ах...
Dialogue: 0,0:07:31.78,0:07:34.45,Default,,0,0,0,,Менің ойымша, бұл жаман болды ...
Dialogue: 0,0:07:34.95,0:07:36.49,Default,,0,0,0,,Иә.
Dialogue: 0,0:07:40.12,0:07:45.88,Default,,0,0,0,,Ол осал бала, сондықтан оған көбірек көңіл бөлуіміз керек.
Dialogue: 0,0:07:47.92,0:07:49.21,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:07:54.59,0:07:58.22,Default,,0,0,0,,Орналасқан жер туралы ақпарат біз аралдың үстінде екенімізді айтады, бірақ көріну...
Dialogue: 0,0:07:58.31,0:07:59.97,Default,,0,0,0,,Биіктікті одан әрі төмендетіңіз.
Dialogue: 0,0:08:00.56,0:08:02.31,Default,,0,0,0,,Жердегі радар, өтінемін.
Dialogue: 0,0:08:02.56,0:08:03.64,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:08:04.94,0:08:05.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:09.07,0:08:10.32,Default,,0,0,0,,Мен оны көрдім!
Dialogue: 0,0:08:10.40,0:08:12.15,Default,,0,0,0,,Бұл аралдың дәл үстінде.
Dialogue: 0,0:08:15.24,0:08:17.16,Default,,0,0,0,,Айқай~
Dialogue: 0,0:08:27.42,0:08:29.38,Default,,0,0,0,,Gunpery-ден қосылыңыз
Dialogue: 0,0:08:30.05,0:08:31.71,Default,,0,0,0,,Бейне де келеді
Dialogue: 0,0:08:32.13,0:08:34.72,Default,,0,0,0,,Жарайды, негізгі нәрсеге көшіңіз.
Dialogue: 0,0:08:39.93,0:08:41.22,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:44.48,0:08:46.40,Default,,0,0,0,,Бұл шағын арал.
Dialogue: 0,0:08:47.73,0:08:49.48,Default,,0,0,0,,Бұл маяк па?
Dialogue: 0,0:08:50.48,0:08:52.24,Default,,0,0,0,,Чичи
Dialogue: 0,0:08:53.28,0:08:56.57,Default,,0,0,0,,Деректер бойынша ескі маяк.
Dialogue: 0,0:08:56.66,0:08:58.95,Default,,0,0,0,,Ах! Gunpery табылды!
Dialogue: 0,0:09:01.70,0:09:03.00,Default,,0,0,0,,Әй!
Dialogue: 0,0:09:05.54,0:09:10.21,Default,,0,0,0,,Мен жаттығу залын көре алмаймын, бірақ ұрыс қалдықтары сияқты күйік іздері бар.
Dialogue: 0,0:09:11.09,0:09:13.59,Default,,0,0,0,,Құрлық және күш барлау!
Dialogue: 0,0:09:13.67,0:09:14.72,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:09:22.85,0:09:26.02,Default,,0,0,0,,Сәлем... бұл жақсы емес.
Dialogue: 0,0:09:39.82,0:09:42.03,Default,,0,0,0,,Люк 90 градусқа ашық
Dialogue: 0,0:09:44.70,0:09:46.12,Default,,0,0,0,,Белдік ілмегі шығарылды!
Dialogue: 0,0:09:46.21,0:09:47.25,Default,,0,0,0,,-Иә! -Түсінікті
Dialogue: 0,0:09:47.58,0:09:50.54,Default,,0,0,0,,Жауды көре алмайсың, бірақ сақ бол
Dialogue: 0,0:09:50.63,0:09:51.92,Default,,0,0,0,,Иә, Джоб мырза.
Dialogue: 0,0:10:13.82,0:10:16.78,Default,,0,0,0,,Бөлініп іздеген дұрыс емес пе?
Dialogue: 0,0:10:17.24,0:10:19.45,Default,,0,0,0,,Сіз батыс жағын сұрайсыз
Dialogue: 0,0:10:19.53,0:10:20.53,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:10:20.91,0:10:24.99,Default,,0,0,0,,Мен шығыс жағындамын, өйткені мен сол маяктың иісін сеземін.
Dialogue: 0,0:10:32.13,0:10:33.17,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:00.49,0:11:02.87,Default,,0,0,0,,Сен тағы кіммен төбелеспексің?
Dialogue: 0,0:11:03.49,0:11:05.24,Default,,0,0,0,,Осындай жерде...
Dialogue: 0,0:11:07.91,0:11:11.92,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:11:15.59,0:11:18.92,Default,,0,0,0,,Анау маяк күдікті ғой.
Dialogue: 0,0:11:19.80,0:11:22.22,Default,,0,0,0,,Мен сенімдімін
Dialogue: 0,0:11:22.59,0:11:26.10,Default,,0,0,0,,Сіз мобильді костюмді жасырып тұрған сияқтысыз...
Dialogue: 0,0:11:26.18,0:11:28.77,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,0:11:29.85,0:11:33.02,Default,,0,0,0,,Өріс... қалай қарасаң да
Dialogue: 0,0:11:33.10,0:11:34.31,Default,,0,0,0,,Ефрейтор Кай, сіз қалай ойлайсыз?
Dialogue: 0,0:11:34.40,0:11:35.23,Default,,0,0,0,,Иә
Dialogue: 0,0:11:35.31,0:11:37.23,Default,,0,0,0,,Маған жағдайды хабарлаңыз!
Dialogue: 0,0:11:37.57,0:11:39.74,Default,,0,0,0,,Иә, бұл… қазір…
Dialogue: 0,0:11:41.20,0:11:43.49,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:11:43.57,0:11:46.99,Default,,0,0,0,,-Мына жігіт! - Уф...
Dialogue: 0,0:11:47.08,0:11:48.99,Default,,0,0,0,,Не?
Dialogue: 0,0:11:49.29,0:11:51.87,Default,,0,0,0,,Ефрейтор! Ефрейтор Кай!
Dialogue: 0,0:11:53.79,0:11:55.00,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:11:55.08,0:11:56.42,Default,,0,0,0,,-Шығыңыз! -Иә!
Dialogue: 0,0:11:58.21,0:11:59.92,Default,,0,0,0,,-Уау -Аа...
Dialogue: 0,0:12:03.09,0:12:04.76,Default,,0,0,0,,Балалар! ?
Dialogue: 0,0:12:05.14,0:12:07.26,Default,,0,0,0,,Бұл елсіз арал емес пе еді?
Dialogue: 0,0:12:07.81,0:12:09.06,Default,,0,0,0,,- (Бала) Шығыңыз! -(Бала) Мына жаққа бар!
Dialogue: 0,0:12:09.14,0:12:11.27,Default,,0,0,0,,- (Бала) Келме! -(Бала) Эй, эй!
Dialogue: 0,0:12:11.60,0:12:14.27,Default,,0,0,0,,-Солдат, мен сені жек көремін! - (Гепард) Онда жүр!
Dialogue: 0,0:12:14.35,0:12:16.73,Default,,0,0,0,,- (Бала) Қанішер! -(Бала) Мен сені қатты жақсы көремін!
Dialogue: 0,0:12:17.52,0:12:19.53,Default,,0,0,0,,Қауіп, жолдан кет!
Dialogue: 0,0:12:20.23,0:12:23.28,Default,,0,0,0,,Не болды, қарт әже?
Dialogue: 0,0:12:23.36,0:12:26.28,Default,,0,0,0,,-(Бала) Мен қорқамын -(Бала) Мен оны жек көремін! Мен оны жек көремін!
Dialogue: 0,0:12:26.66,0:12:28.58,Default,,0,0,0,,Мұны істеме~
Dialogue: 0,0:12:28.66,0:12:30.70,Default,,0,0,0,,Сәлем Амрот
Dialogue: 0,0:12:32.33,0:12:33.96,Default,,0,0,0,,Закудың ізі!
Dialogue: 0,0:12:34.42,0:12:36.46,Default,,0,0,0,,Бұл біртүрлі. Енді не болады...
Dialogue: 0,0:12:39.59,0:12:41.17,Default,,0,0,0,,Амуро!
Dialogue: 0,0:12:41.26,0:12:43.17,Default,,0,0,0,,Кешіріңіз~ Сіз еркесіз... (ажыраған дыбыс)
Dialogue: 0,0:12:43.26,0:12:45.22,Default,,0,0,0,,Бұл тұйық жол емес пе?
Dialogue: 0,0:13:02.65,0:13:05.03,Default,,0,0,0,,Бұл тығырыққа тірелген соң.
Dialogue: 0,0:13:05.11,0:13:07.99,Default,,0,0,0,,Осы уақытқа дейін не істедің?
Dialogue: 0,0:13:13.75,0:13:14.79,Default,,0,0,0,,Ха!
Dialogue: 0,0:13:16.25,0:13:17.42,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:13:23.71,0:13:25.51,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:13:27.72,0:13:29.26,Default,,0,0,0,,Негізгі дене қайда өзі?
Dialogue: 0,0:13:45.61,0:13:46.53,Default,,0,0,0,,Уф
Dialogue: 0,0:13:56.08,0:13:57.00,Default,,0,0,0,,Иә, аға, сен кереметсің.
Dialogue: 0,0:13:58.58,0:13:59.79,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:00.71,0:14:02.84,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:14:04.34,0:14:05.76,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:18.48,0:14:20.40,Default,,0,0,0,,Арх!
Dialogue: 0,0:14:32.41,0:14:36.00,Default,,0,0,0,,Ааааааааааааааааааа!
Dialogue: 0,0:14:46.30,0:14:49.30,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:14:52.14,0:14:53.05,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:14:53.14,0:14:54.72,Default,,0,0,0,,Өтінемін…
Dialogue: 0,0:14:55.10,0:14:58.56,Default,,0,0,0,,Маған бұл ұнамайды. Мен бұған жақсы емеспін... Ах.
Dialogue: 0,0:15:02.44,0:15:03.69,Default,,0,0,0,,Иә
Dialogue: 0,0:15:05.19,0:15:07.44,Default,,0,0,0,,Тек ақымақ балалар болды!
Dialogue: 0,0:15:07.53,0:15:09.95,Default,,0,0,0,,Бұл елсіз арал емес!
Dialogue: 0,0:15:10.40,0:15:13.20,Default,,0,0,0,,Ефрейтор Кай Амуромен байланысу мүмкін емес.
Dialogue: 0,0:15:13.53,0:15:15.08,Default,,0,0,0,,Мен де
Dialogue: 0,0:15:15.16,0:15:16.95,Default,,0,0,0,,Мен онымен қосыла алмаймын!
Dialogue: 0,0:15:17.24,0:15:19.58,Default,,0,0,0,,Мен старшина Амуромен байланыса алмаймын! ?
Dialogue: 0,0:15:19.66,0:15:21.21,Default,,0,0,0,,Иә, біраз уақыт бұрын
Dialogue: 0,0:15:21.71,0:15:23.71,Default,,0,0,0,,Мен мұнда да қосыла алмаймын.
Dialogue: 0,0:15:24.25,0:15:25.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:26.80,0:15:28.67,Default,,0,0,0,,Бірдеңе болды ма деп ойлаймын...
Dialogue: 0,0:15:28.76,0:15:30.72,Default,,0,0,0,,Ах
Dialogue: 0,0:15:30.80,0:15:34.14,Default,,0,0,0,,Эй, эй, мен баспалдақпен көтерілдім...
Dialogue: 0,0:15:34.22,0:15:35.35,Default,,0,0,0,,Хе хе хе хе хе
Dialogue: 0,0:15:35.43,0:15:36.93,Default,,0,0,0,,Ах
Dialogue: 0,0:15:37.31,0:15:41.60,Default,,0,0,0,,Сәлем капитан, қалыңыз қалай...
Dialogue: 0,0:15:41.69,0:15:43.85,Default,,0,0,0,,О... иә?
Dialogue: 0,0:15:43.94,0:15:45.69,Default,,0,0,0,,Амуро жігіттері...
Dialogue: 0,0:15:48.48,0:15:49.74,Default,,0,0,0,,Мені алаңдатқаны — Кираны оның отбасы байқап қалуы мүмкін —
Dialogue: 0,0:15:52.74,0:15:53.86,Default,,0,0,0,,Амуро!
Dialogue: 0,0:15:53.95,0:15:55.87,Default,,0,0,0,,Амуро! өтінемін, жауап беріңіз!
Dialogue: 0,0:15:56.37,0:15:59.50,Default,,0,0,0,,Амуро! Мені тыңда! ? Амуро!
Dialogue: 0,0:15:59.58,0:16:00.87,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:00.96,0:16:03.75,Default,,0,0,0,,Ордер Амуро! Амуро-кун, жауап бер!
Dialogue: 0,0:16:03.83,0:16:05.38,Default,,0,0,0,,Уф
Dialogue: 0,0:16:05.46,0:16:07.88,Default,,0,0,0,,Сержант Джоб Джон! Енді бұл ненің дыбысы? ?
Dialogue: 0,0:16:08.21,0:16:10.67,Default,,0,0,0,,Бұл найзағай! Бұл қазір керемет
Dialogue: 0,0:16:10.76,0:16:11.76,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:16:11.84,0:16:14.76,Default,,0,0,0,,Джоб-сан, түсуім керек пе?
Dialogue: 0,0:16:14.84,0:16:16.26,Default,,0,0,0,,Шығу
Dialogue: 0,0:16:16.35,0:16:18.14,Default,,0,0,0,,Не? не?
Dialogue: 0,0:16:18.43,0:16:20.52,Default,,0,0,0,,Шығарыңыз! бірден!
Dialogue: 0,0:16:20.60,0:16:21.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:21.60,0:16:23.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:23.35,0:16:25.23,Default,,0,0,0,,Е! ? Сіз бас тартасыз ба? ?
Dialogue: 0,0:16:25.31,0:16:26.77,Default,,0,0,0,,Амуроны жайына қалдырыңыз! ?
Dialogue: 0,0:16:27.31,0:16:29.40,Default,,0,0,0,,Кейінірек қайта іздеңіз
Dialogue: 0,0:16:29.48,0:16:32.28,Default,,0,0,0,,Эвакуациялау уақыты келді. Асығыңыз!
Dialogue: 0,0:16:32.90,0:16:35.28,Default,,0,0,0,,Бөлініңіз, мен және ол... болды...
Dialogue: 0,0:16:35.36,0:16:36.78,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:16:37.57,0:16:39.28,Default,,0,0,0,,Кай-сан, тезірек!
Dialogue: 0,0:16:39.87,0:16:41.54,Default,,0,0,0,,Кешір мені, Амуро.
Dialogue: 0,0:16:41.54,0:16:41.95,Default,,0,0,0,,Кешір мені, Амуро.
Dialogue: 0,0:16:41.54,0:16:41.95,Default,,0,0,0,,Контейнер асығыс
Dialogue: 0,0:16:41.95,0:16:42.04,Default,,0,0,0,,Контейнер асығыс
Dialogue: 0,0:16:42.04,0:16:43.25,Default,,0,0,0,,Контейнер асығыс
Dialogue: 0,0:16:42.04,0:16:43.25,Default,,0,0,0,,Мен сені міндетті түрде тағы іздеймін.
Dialogue: 0,0:16:43.25,0:16:45.00,Default,,0,0,0,,Мен сені міндетті түрде тағы іздеймін.
Dialogue: 0,0:16:45.37,0:16:48.17,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:16:51.13,0:16:55.26,Default,,0,0,0,,Ефрейтор Кайдың «Гунканнон» қаруы ұсталып, ұшып кетті.
Dialogue: 0,0:16:58.01,0:17:00.56,Default,,0,0,0,,Лейтенант өтінемін
Dialogue: 0,0:17:01.10,0:17:04.31,Default,,0,0,0,,Барып мені ізде.
Dialogue: 0,0:17:04.73,0:17:05.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:07.10,0:17:08.48,Default,,0,0,0,,Әй!
Dialogue: 0,0:17:20.83,0:17:23.87,Default,,0,0,0,,Уау... Уау!
Dialogue: 0,0:17:23.95,0:17:27.00,Default,,0,0,0,,Кяаааааааааааааааа...
Dialogue: 0,0:17:29.59,0:17:32.50,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:17:32.59,0:17:33.92,Default,,0,0,0,,Иә! Ха!
Dialogue: 0,0:17:38.59,0:17:41.47,Default,,0,0,0,,-Аа -басқаны атып.
Dialogue: 0,0:17:41.93,0:17:44.73,Default,,0,0,0,,Мылтық сілтеп, атуға қалай дәтің бар!
Dialogue: 0,0:17:45.18,0:17:46.73,Default,,0,0,0,,Өйткені ана
Dialogue: 0,0:17:48.02,0:17:49.98,Default,,0,0,0,,Қазір соғыс!
Dialogue: 0,0:17:50.69,0:17:53.03,Default,,0,0,0,,Мұны саған әкең үйретті ме?
Dialogue: 0,0:17:53.11,0:17:55.36,Default,,0,0,0,,Мейірімді бала болса да...
Dialogue: 0,0:17:55.44,0:17:58.82,Default,,0,0,0,,Қандай аянышты бала!
Dialogue: 0,0:17:58.91,0:18:00.41,Default,,0,0,0,,Шайқас, Амуро!
Dialogue: 0,0:18:00.49,0:18:03.33,Default,,0,0,0,,Әкең салған Гундамға мін!
Dialogue: 0,0:18:03.41,0:18:05.91,Default,,0,0,0,,Гундам керемет!
Dialogue: 0,0:18:06.00,0:18:09.54,Default,,0,0,0,,Иә! Бұл дұрыс! Бұл дұрыс!
Dialogue: 0,0:18:09.63,0:18:12.00,Default,,0,0,0,,Гундам босқындардың алдына келеді!
Dialogue: 0,0:18:12.09,0:18:13.59,Default,,0,0,0,,Тез шығарыңыз!
Dialogue: 0,0:18:13.67,0:18:14.67,Default,,0,0,0,,Сенде ондай мақсат болса да…
Dialogue: 0,0:18:14.92,0:18:16.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:16.55,0:18:19.30,Default,,0,0,0,,Әкем мені де, анамды да ойламайды!
Dialogue: 0,0:18:19.38,0:18:21.05,Default,,0,0,0,,Уау
Dialogue: 0,0:18:26.02,0:18:28.23,Default,,0,0,0,,Хахахахаха
Dialogue: 0,0:18:28.85,0:18:31.19,Default,,0,0,0,,Гундам осылай болды
Dialogue: 0,0:18:31.27,0:18:32.77,Default,,0,0,0,,Осы үш кадрды қайтадан қатар қойып көрсетіңізші.
Dialogue: 0,0:18:39.61,0:18:42.53,Default,,0,0,0,,Күте тұрыңыз! Күте тұрыңыз!
Dialogue: 0,0:18:42.62,0:18:44.03,Default,,0,0,0,,Мираи-сан!
Dialogue: 0,0:18:44.12,0:18:45.54,Default,,0,0,0,,Рау!
Dialogue: 0,0:18:45.62,0:18:47.33,Default,,0,0,0,,Сайла!
Dialogue: 0,0:18:52.63,0:18:54.04,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:54.13,0:18:55.30,Default,,0,0,0,,Ах
Dialogue: 0,0:18:56.21,0:18:57.84,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:59.51,0:19:00.55,Default,,0,0,0,,Ыстық...
Dialogue: 0,0:19:13.73,0:19:15.23,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:15.32,0:19:17.07,Default,,0,0,0,,Ол қайда?мұнда
Dialogue: 0,0:19:31.04,0:19:32.08,Default,,0,0,0,,Ах!?
Dialogue: 0,0:19:43.26,0:19:45.85,Default,,0,0,0,,Ах... Ха...
Dialogue: 0,0:19:45.93,0:19:46.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:57.57,0:19:59.74,Default,,0,0,0,,Ахаааааааааааааааааааааааааааааааааа
Dialogue: 0,0:19:59.82,0:20:01.70,Default,,0,0,0,,Хе хехе хехе
Dialogue: 0,0:20:01.78,0:20:03.49,Default,,0,0,0,,Хахахахаха...
Dialogue: 0,0:20:05.07,0:20:06.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:06.20,0:20:09.29,Default,,0,0,0,,Кара, мұны қайда апаруым керек?
Dialogue: 0,0:20:09.37,0:20:11.25,Default,,0,0,0,,Күте тұрыңыз, қазір жүріңіз
Dialogue: 0,0:20:11.71,0:20:13.75,Default,,0,0,0,,Амадо Хосе Енді кеттік
Dialogue: 0,0:20:13.83,0:20:14.88,Default,,0,0,0,,Хосе, жарай ма?
Dialogue: 0,0:20:15.58,0:20:18.50,Default,,0,0,0,,Матео Бланка сізді күтуде.
Dialogue: 0,0:20:25.84,0:20:26.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:27.51,0:20:29.64,Default,,0,0,0,,Оны кішірейт, Джулиан.
Dialogue: 0,0:20:29.72,0:20:31.23,Default,,0,0,0,,Сіз мұны істей аласыз.
Dialogue: 0,0:20:39.61,0:20:40.53,Default,,0,0,0,,(Ешкі дыбысы)
Dialogue: 0,0:20:40.61,0:20:42.07,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:20:43.03,0:20:45.36,Default,,0,0,0,,Не? ?
Dialogue: 0,0:20:45.45,0:20:47.03,Default,,0,0,0,,Бланка
Dialogue: 0,0:20:47.70,0:20:50.12,Default,,0,0,0,,Енді сүтті сауайық.
Dialogue: 0,0:20:50.20,0:20:52.33,Default,,0,0,0,,Арқан, мықтап ұстаңыз.
Dialogue: 0,0:20:52.41,0:20:54.04,Default,,0,0,0,,-Иә -Уау!
Dialogue: 0,0:20:56.12,0:20:58.34,Default,,0,0,0,,Уах уа уа...
Dialogue: 0,0:20:58.42,0:21:00.55,Default,,0,0,0,,Увааааааааааааааааааааааааа
Dialogue: 0,0:21:00.63,0:21:02.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:03.13,0:21:04.05,Default,,0,0,0,,Әй!
Dialogue: 0,0:21:06.72,0:21:08.47,Default,,0,0,0,,Бум! Ол жігіт...
Dialogue: 0,0:21:20.94,0:21:22.78,Default,,0,0,0,,Біраз демалыңыз!
Dialogue: 0,0:21:22.86,0:21:24.15,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:33.37,0:21:35.29,Default,,0,0,0,,(Оқушылар) Э-э… Мүмкін емес! Мүмкін емес!
Dialogue: 0,0:21:36.79,0:21:38.79,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:40.09,0:21:42.25,Default,,0,0,0,,Түн ортасында әлі де 36 сағат.
Dialogue: 0,0:21:46.34,0:21:47.80,Default,,0,0,0,,Сіз менісіз бе?
Dialogue: 0,0:21:47.88,0:21:49.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:50.22,0:21:51.56,Default,,0,0,0,,Гундам...
Dialogue: 0,0:21:52.56,0:21:55.18,Default,,0,0,0,,Мен мінген жылжымалы костюммен не істедің? ?
Dialogue: 0,0:21:57.89,0:21:59.94,Default,,0,0,0,,Неліктен солдаттар...
Dialogue: 0,0:22:00.27,0:22:02.69,Default,,0,0,0,,Мен солдаттарға көмектеспеуім керек еді.
Dialogue: 0,0:22:03.15,0:22:04.28,Default,,0,0,0,,Өл!
Dialogue: 0,0:22:04.36,0:22:05.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:05.61,0:22:06.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:07.03,0:22:09.53,Default,,0,0,0,,Солдат, мен сені жек көремін!
Dialogue: 0,0:22:15.08,0:22:16.29,Default,,0,0,0,,Уф...
Dialogue: 0,0:22:16.75,0:22:17.79,Default,,0,0,0,,Хмм...
Dialogue: 0,0:22:17.87,0:22:19.58,Default,,0,0,0,,Хмм...
Dialogue: 0,0:22:23.71,0:22:25.13,Default,,0,0,0,,Хмм...
Dialogue: 0,0:22:41.77,0:22:43.02,Default,,0,0,0,,Иә!
Dialogue: 0,0:22:46.36,0:22:47.94,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:22:48.49,0:22:50.95,Default,,0,0,0,,Менің ұялы костюмімді іздеп жүрмін!
Dialogue: 0,0:22:53.83,0:22:55.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:56.62,0:22:58.46,Default,,0,0,0,,Доан Сол бала...
Dialogue: 0,0:23:00.08,0:23:01.46,Default,,0,0,0,,Оны жай қалдырыңыз
Dialogue: 0,0:23:04.09,0:23:06.71,Default,,0,0,0,,Кеш болса да...
Dialogue: 0,0:23:15.93,0:23:19.85,Default,,0,0,0,,Хаа һаа һаа һаа…
Dialogue: 0,0:23:38.12,0:23:39.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:45.46,0:23:51.72,Default,,0,0,0,,Хаа һаа һаа һаа…
Dialogue: 0,0:23:59.98,0:24:01.39,Default,,0,0,0,,Уау!
Dialogue: 0,0:24:05.15,0:24:07.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:24:09.11,0:24:10.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:24:28.00,0:24:29.80,Default,,0,0,0,,Ас болсын!!
Dialogue: 0,0:24:29.88,0:24:32.38,Default,,0,0,0,,-(Бала) Қарным ашты. -(Бала) Мен де соны мақсат еттім.
Dialogue: 0,0:24:32.47,0:24:34.43,Default,,0,0,0,,-Иә -Рахмет
Dialogue: 0,0:24:37.97,0:24:39.56,Default,,0,0,0,,Бұл — сүт, жұмыртқа сарысы, банан және нан —
Dialogue: 0,0:24:40.72,0:24:43.35,Default,,0,0,0,,Мынау және мынау Матеоның көзілдірігі~
Dialogue: 0,0:24:43.44,0:24:44.39,Default,,0,0,0,,Әй, мынау мен ұстадым.
Dialogue: 0,0:24:44.39,0:24:45.44,Default,,0,0,0,,Әй, мынау мен ұстадым.
Dialogue: 0,0:24:44.39,0:24:45.44,Default,,0,0,0,,Мен балмұздақ жегім келеді
Dialogue: 0,0:24:45.44,0:24:45.52,Default,,0,0,0,,Мен балмұздақ жегім келеді
Dialogue: 0,0:24:45.52,0:24:46.65,Default,,0,0,0,,Мен балмұздақ жегім келеді
Dialogue: 0,0:24:45.52,0:24:46.65,Default,,0,0,0,,Әй, тоқтат.
Dialogue: 0,0:24:46.73,0:24:48.52,Default,,0,0,0,,Сәбізді ұнатпайды
Dialogue: 0,0:24:46.73,0:24:48.52,Default,,0,0,0,,Балмұздақ жоқ.
Dialogue: 0,0:24:48.61,0:24:48.94,Default,,0,0,0,,Жоқ, мен жеуім керек.
Dialogue: 0,0:24:48.94,0:24:50.32,Default,,0,0,0,,Жоқ, мен жеуім керек.
Dialogue: 0,0:24:48.94,0:24:50.32,Default,,0,0,0,,Менің де балмұздақ жегім келеді
Dialogue: 0,0:24:50.65,0:24:53.99,Default,,0,0,0,,Дарио, қарама және тамақ ішпе.
Dialogue: 0,0:24:54.32,0:24:55.82,Default,,0,0,0,,Пуха~
Dialogue: 0,0:24:55.91,0:24:58.66,Default,,0,0,0,,Әй, енді жоқ па? Бланка сүті
Dialogue: 0,0:24:58.74,0:25:00.33,Default,,0,0,0,,Бүгінгі күннің бәрі осы
Dialogue: 0,0:25:00.74,0:25:02.91,Default,,0,0,0,,Сізді тағы да төңкеріп жіберді, солай емес пе?
Dialogue: 0,0:25:03.00,0:25:04.96,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:25:05.87,0:25:09.00,Default,,0,0,0,,Себебі Арқан оны дұрыс ұстамайды.
Dialogue: 0,0:25:09.09,0:25:11.50,Default,,0,0,0,,-Уау -Уау...Аа...
Dialogue: 0,0:25:11.59,0:25:12.96,Default,,0,0,0,,Жылама!
Dialogue: 0,0:25:13.38,0:25:15.55,Default,,0,0,0,,Сіз мені жылаттыңыз, солай ма?
Dialogue: 0,0:25:18.01,0:25:20.22,Default,,0,0,0,,-Сен қызықсың ба?-(Қара) А?
Dialogue: 0,0:25:20.68,0:25:22.39,Default,,0,0,0,,Сол жігіт туралы
Dialogue: 0,0:25:23.81,0:25:26.10,Default,,0,0,0,,Мені жалғыз қалдырыңыз! Сол жігіт
Dialogue: 0,0:25:26.19,0:25:27.23,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:25:28.27,0:25:29.48,Default,,0,0,0,,Кетіңіз
Dialogue: 0,0:25:29.56,0:25:31.32,Default,,0,0,0,,Ммм! ?
Dialogue: 0,0:25:32.07,0:25:34.57,Default,,0,0,0,,-Абайлаңыз - (Қара) Иә!
Dialogue: 0,0:25:34.65,0:25:37.41,Default,,0,0,0,,Инес, өтінемін, балаларға қамқор бол.
Dialogue: 0,0:25:37.49,0:25:39.37,Default,,0,0,0,,Не? иә
Dialogue: 0,0:25:41.83,0:25:46.75,Default,,0,0,0,,Хаа һаа һаа һаа…
Dialogue: 0,0:25:58.59,0:25:59.76,Default,,0,0,0,,Ах
Dialogue: 0,0:26:00.72,0:26:02.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:26:05.56,0:26:10.77,Default,,0,0,0,,Хаа һаа һаа һаа…
Dialogue: 0,0:26:14.65,0:26:16.78,Default,,0,0,0,,Уф...
Dialogue: 0,0:26:18.61,0:26:21.78,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:26:21.87,0:26:23.41,Default,,0,0,0,,Сізге бірдеңе керек пе?
Dialogue: 0,0:26:24.24,0:26:25.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:26:26.71,0:26:28.87,Default,,0,0,0,,Кел, мені тексер.
Dialogue: 0,0:26:34.38,0:26:35.42,Default,,0,0,0,,Ах!
Dialogue: 0,0:26:35.51,0:26:36.80,Default,,0,0,0,,Ах!
Dialogue: 0,0:26:42.43,0:26:44.56,Default,,0,0,0,,Сіз қанша жерге келдіңіз?
Dialogue: 0,0:26:45.18,0:26:46.60,Default,,0,0,0,,Пуха~
Dialogue: 0,0:26:48.27,0:26:50.56,Default,,0,0,0,,Үлкен кратердің жиегі...
Dialogue: 0,0:26:50.65,0:26:52.36,Default,,0,0,0,,Ондай жерге! ?
Dialogue: 0,0:26:53.94,0:26:56.86,Default,,0,0,0,,Саған да кешкі ас бар.
Dialogue: 0,0:26:58.28,0:26:59.99,Default,,0,0,0,,Жоқ, мен емес...
Dialogue: 0,0:27:00.07,0:27:02.12,Default,,0,0,0,,Хмм...
Dialogue: 0,0:27:03.49,0:27:06.20,Default,,0,0,0,,-(Карла) Хехехехе... -Хмм~
Dialogue: 0,0:27:07.08,0:27:10.87,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:27:21.18,0:27:22.30,Default,,0,0,0,,Не болды?
Dialogue: 0,0:27:22.39,0:27:25.10,Default,,0,0,0,,Ой... сіз оны ала алмайсыз ба? Бұл
Dialogue: 0,0:27:25.18,0:27:28.27,Default,,0,0,0,,О, генератор бұзылған.
Dialogue: 0,0:27:28.89,0:27:32.27,Default,,0,0,0,,Мен оны жөндегеніңізді қалаймын, бірақ Доан да бос емес...
Dialogue: 0,0:27:32.73,0:27:34.52,Default,,0,0,0,,Доан бұл жігіт пе?
Dialogue: 0,0:27:35.69,0:27:37.53,Default,,0,0,0,,Иә Доан
Dialogue: 0,0:27:38.40,0:27:40.11,Default,,0,0,0,,Кукуррус Доан
Dialogue: 0,0:27:40.82,0:27:44.70,Default,,0,0,0,,Эй Доан, ертең Джулианның туған күні.
Dialogue: 0,0:27:44.78,0:27:47.66,Default,,0,0,0,,Жасың нешеде?
Dialogue: 0,0:27:47.74,0:27:48.79,Default,,0,0,0,,7 жаста!
Dialogue: 0,0:27:48.87,0:27:51.21,Default,,0,0,0,,Олай болса тойлайық.
Dialogue: 0,0:27:51.29,0:27:52.50,Default,,0,0,0,,Иә!
Dialogue: 0,0:27:52.58,0:27:55.88,Default,,0,0,0,,Мерекелік мереке! Туылған күніңмен!
Dialogue: 0,0:27:56.29,0:27:58.80,Default,,0,0,0,,Балық! Мен үлкен балық аулаймын!
Dialogue: 0,0:27:58.88,0:28:00.30,Default,,0,0,0,,Кішкентай қыз!
Dialogue: 0,0:28:00.38,0:28:01.88,Default,,0,0,0,,Сіз бе?
Dialogue: 0,0:28:01.97,0:28:03.05,Default,,0,0,0,,Ақылға қонымсыз
Dialogue: 0,0:28:03.13,0:28:04.09,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:28:04.18,0:28:07.47,Default,,0,0,0,,Өткен күні мен оны осылай жібердім.
Dialogue: 0,0:28:07.56,0:28:08.81,Default,,0,0,0,,-Эй -Кукккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккк
Dialogue: 0,0:28:08.93,0:28:12.23,Default,,0,0,0,,Russee! Сіздерден де дәмді!
Dialogue: 0,0:28:12.31,0:28:13.35,Default,,0,0,0,,Аға, неге әрдайым кешірім сұрайсың?
Dialogue: 0,0:28:13.44,0:28:14.81,Default,,0,0,0,,Дайын~
Dialogue: 0,0:28:15.69,0:28:18.19,Default,,0,0,0,,Иә, бұл дәмді торт~
Dialogue: 0,0:28:18.27,0:28:21.28,Default,,0,0,0,,Е, жеуге болатын торт жақсы!
Dialogue: 0,0:28:21.36,0:28:23.66,Default,,0,0,0,,Мереке Сіз не қалайсыз? Джулиан
Dialogue: 0,0:28:24.20,0:28:25.37,Default,,0,0,0,,Маяк!
Dialogue: 0,0:28:25.45,0:28:26.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:28:26.53,0:28:28.33,Default,,0,0,0,,Маяк, түзет, Доан.
Dialogue: 0,0:28:28.41,0:28:30.12,Default,,0,0,0,,Шамдарды қосыңыз!
Dialogue: 0,0:28:30.20,0:28:31.71,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:28:31.79,0:28:33.12,Default,,0,0,0,,Электр энергиясы
Dialogue: 0,0:28:33.21,0:28:35.13,Default,,0,0,0,,- (Бала) Тағы кездескенше - Жарайды.
Dialogue: 0,0:28:35.21,0:28:38.13,Default,,0,0,0,,-(Бала) Иә, шамдар жанып тұрса жақсы болар еді. -(Бала) Әдемі болар еді.
Dialogue: 0,0:28:38.21,0:28:40.96,Default,,0,0,0,,Тоқ қосылса, тоңазытқышты пайдалануға болады.
Dialogue: 0,0:28:41.05,0:28:41.88,Default,,0,0,0,,Эй!
Dialogue: 0,0:28:42.47,0:28:46.26,Default,,0,0,0,,Сонда бланка сүтімен балмұздақ жасауға болады.
Dialogue: 0,0:28:46.64,0:28:48.26,Default,,0,0,0,,Мен балмұздақ жегім келеді
Dialogue: 0,0:28:48.72,0:28:50.52,Default,,0,0,0,,Осыны ғана айта аласыз.
Dialogue: 0,0:28:50.85,0:28:53.27,Default,,0,0,0,,Сәлем Доан, жарай ма?
Dialogue: 0,0:28:53.35,0:28:55.35,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,0:28:55.44,0:28:56.60,Default,,0,0,0,,Иә~
Dialogue: 0,0:28:56.69,0:28:58.15,Default,,0,0,0,,- (Бала) Неге? -(Гепард) Мұз~
Dialogue: 0,0:28:58.15,0:28:58.77,Default,,0,0,0,,- (Бала) Неліктен? -(Гепард) Мұз~
Dialogue: 0,0:28:58.15,0:28:58.77,Default,,0,0,0,,- (Бала) Жарайсың ба? -(Бала) Доан өтінемін
Dialogue: 0,0:28:58.77,0:28:58.86,Default,,0,0,0,,- (Бала) Жарайды, солай ма? -(Бала) Доан өтінемін
Dialogue: 0,0:28:58.86,0:29:00.61,Default,,0,0,0,,- (Бала) Жарайды, солай ма? -(Бала) Доан өтінемін
Dialogue: 0,0:28:58.86,0:29:00.61,Default,,0,0,0,,- Карла - (Балалар) Карлаға қош келдіңіздер
Dialogue: 0,0:29:00.61,0:29:01.44,Default,,0,0,0,,- Карла - (Балалар) Карлаға қош келдіңіздер
Dialogue: 0,0:29:01.53,0:29:03.45,Default,,0,0,0,,Қайтадан қош келдіңіз~
Dialogue: 0,0:29:03.53,0:29:04.82,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:29:04.90,0:29:06.57,Default,,0,0,0,,Кіріңіз.
Dialogue: 0,0:29:07.37,0:29:08.70,Default,,0,0,0,,Хмм...
Dialogue: 0,0:29:09.33,0:29:11.37,Default,,0,0,0,,- (Балалар) Ах! -Цк
Dialogue: 0,0:29:11.45,0:29:13.00,Default,,0,0,0,,Сіз қанша жүрдіңіз?
Dialogue: 0,0:29:13.41,0:29:15.58,Default,,0,0,0,,Мен Осурибачиге бардым
Dialogue: 0,0:29:15.67,0:29:18.63,Default,,0,0,0,,Уау, сіз өте көп жұмыс істедіңіз.
Dialogue: 0,0:29:18.71,0:29:20.00,Default,,0,0,0,,Саған хабарлап қояйын, бәлкім қажет болады.
Dialogue: 0,0:29:20.96,0:29:22.01,Default,,0,0,0,,Хмм...
Dialogue: 0,0:29:23.13,0:29:24.26,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:29:28.18,0:29:29.47,Default,,0,0,0,,Хмм...
Dialogue: 0,0:29:29.55,0:29:30.85,Default,,0,0,0,,Хмм...
Dialogue: 0,0:29:32.93,0:29:34.02,Default,,0,0,0,,Уау
Dialogue: 0,0:29:34.10,0:29:36.90,Default,,0,0,0,,Ол жерге барсам да ештеңе жоқ.
Dialogue: 0,0:29:36.98,0:29:38.02,Default,,0,0,0,,Маған бәрібір! Ха!
Dialogue: 0,0:29:38.10,0:29:40.52,Default,,0,0,0,,- Сәлем Амадо! - Сіз көмектесе алмайсыз!
Dialogue: 0,0:29:40.61,0:29:42.53,Default,,0,0,0,,Жарайды, орныңызға оралыңыз!
Dialogue: 0,0:29:42.61,0:29:44.11,Default,,0,0,0,,Жоқ, жоқ!
Dialogue: 0,0:29:45.99,0:29:47.53,Default,,0,0,0,,-Иә! -Карла!
Dialogue: 0,0:29:47.61,0:29:49.16,Default,,0,0,0,,Ондай адамға...
Dialogue: 0,0:29:49.24,0:29:50.91,Default,,0,0,0,,Оларға тамақ беріңіз! ?
Dialogue: 0,0:29:51.45,0:29:54.54,Default,,0,0,0,,Жұмыс істемейтін адамдар тамақ ішпеуі керек.
Dialogue: 0,0:29:54.62,0:29:56.16,Default,,0,0,0,,Хмм...
Dialogue: 0,0:29:57.37,0:29:58.96,Default,,0,0,0,,және өзімнің ашуымнан адасуда болдым.
Dialogue: 0,0:29:59.04,0:30:01.29,Default,,0,0,0,,Мен ертеңнен бастап жұмысқа кірісемін.
Dialogue: 0,0:30:04.96,0:30:06.47,Default,,0,0,0,,Бұл субтитрлер ДжоДжо's Bizarre Adventure форумы, Yuhari Subtitles және Gods Subtitles Group бірлесіп дайындады
Dialogue: 0,0:30:16.64,0:30:18.56,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:30:22.52,0:30:23.57,Default,,0,0,0,,Амуро…
Dialogue: 0,0:30:23.65,0:30:25.07,Default,,0,0,0,,Бұл Амуро Рэй.
Dialogue: 0,0:30:25.53,0:30:27.15,Default,,0,0,0,,Амуро-кун?
Dialogue: 0,0:30:27.24,0:30:28.99,Default,,0,0,0,,Мен Доанмын
Dialogue: 0,0:30:29.07,0:30:31.70,Default,,0,0,0,,Ол киіммен қозғалу қиын болар еді.
Dialogue: 0,0:30:31.78,0:30:33.83,Default,,0,0,0,,Маркос, маған шалбарыңды қарызға бер.
Dialogue: 0,0:30:33.91,0:30:36.08,Default,,0,0,0,,Күрсін! ? Неге мен?
Dialogue: 0,0:30:36.16,0:30:37.87,Default,,0,0,0,,Басқа ешкім жоқ, солай ма?
Dialogue: 0,0:30:38.67,0:30:40.33,Default,,0,0,0,,Аға, неге әрдайым кешірім сұрайсың?
Dialogue: 0,0:30:43.17,0:30:45.13,Default,,0,0,0,,Ой... Иххихихихи...
Dialogue: 0,0:30:45.21,0:30:47.72,Default,,0,0,0,,Тексеріңіз, оған көмектесу мүмкін емес.
Dialogue: 0,0:30:47.80,0:30:51.72,Default,,0,0,0,,Кәне, бәріміз, тістеріңді тазалап, ұйықтайтын кез келді.
Dialogue: 0,0:30:51.80,0:30:55.27,Default,,0,0,0,,Бұған дейін Доанмен «ертеңгі күнге уәде» берейік!
Dialogue: 0,0:30:55.35,0:30:56.72,Default,,0,0,0,,Иә
Dialogue: 0,0:30:57.60,0:30:59.60,Default,,0,0,0,,Мен бәрімен тіл табысамын!
Dialogue: 0,0:30:59.89,0:31:03.52,Default,,0,0,0,,Бір-бірімізге көмектесіп, өз жұмысымызды жасайық!
Dialogue: 0,0:31:03.61,0:31:06.86,Default,,0,0,0,,Таңдамай жеймін!
Dialogue: 0,0:31:07.19,0:31:09.95,Default,,0,0,0,,Суды абайлап пайдаланыңыз
Dialogue: 0,0:31:10.03,0:31:12.62,Default,,0,0,0,,Үлкен балалар кішкентайларды қорғайды!
Dialogue: 0,0:31:12.70,0:31:14.45,Default,,0,0,0,,Өзімшіл болма!
Dialogue: 0,0:31:14.53,0:31:16.41,Default,,0,0,0,,Бөлмеңізді таза ұстаңыз!
Dialogue: 0,0:31:16.49,0:31:18.50,Default,,0,0,0,,Өзімді жалғыз сезінсем де, жыламаймын!
Dialogue: 0,0:31:19.21,0:31:21.75,Default,,0,0,0,,Рахмет! Кукурус Доан!
Dialogue: 0,0:31:21.83,0:31:23.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:31:33.34,0:31:35.43,Default,,0,0,0,,Қарашы, Ерлан-күн.
Dialogue: 0,0:31:35.51,0:31:38.64,Default,,0,0,0,,Үлкен Трейдің екінші кемесі «Молтке»
Dialogue: 0,0:31:38.73,0:31:42.56,Default,,0,0,0,,Уау, бұл өте жақсы нәрсе.
Dialogue: 0,0:31:42.65,0:31:44.27,Default,,0,0,0,,Амфибия
Dialogue: 0,0:31:44.36,0:31:47.65,Default,,0,0,0,,Құпиясы - бұл ұшатын кеме.
Dialogue: 0,0:31:48.07,0:31:49.82,Default,,0,0,0,,Осы Белфасттан -
Dialogue: 0,0:31:49.90,0:31:54.32,Default,,0,0,0,,Ұлыбритания мен Солтүстік теңізді кесіп өтіп, Данцигке қонды
Dialogue: 0,0:31:54.41,0:31:57.74,Default,,0,0,0,,Содан кейін біз Поляк жазығы арқылы оңтүстікке қарай бет алдық.
Dialogue: 0,0:31:57.83,0:31:59.66,Default,,0,0,0,,Одессаны жаулап алу
Dialogue: 0,0:31:59.75,0:32:01.41,Default,,0,0,0,,Хмм! Хмм!
Dialogue: 0,0:32:02.21,0:32:04.92,Default,,0,0,0,,Мен Ақ базаны осында шақырамын.
Dialogue: 0,0:32:05.34,0:32:07.67,Default,,0,0,0,,Ақ негіз...?
Dialogue: 0,0:32:08.05,0:32:09.84,Default,,0,0,0,,Хахахахаха…
Dialogue: 0,0:32:09.92,0:32:12.18,Default,,0,0,0,,Мысалдағыдай «Тербелі ат».
Dialogue: 0,0:32:12.76,0:32:17.06,Default,,0,0,0,,Олар қазір маршал Гоптың қол астында болса да, олар әлі де...
Dialogue: 0,0:32:17.72,0:32:21.02,Default,,0,0,0,,Себебі мен сенің қасымда жұмыс істегеніңді қалаймын.
Dialogue: 0,0:32:21.73,0:32:24.77,Default,,0,0,0,,Солтүстік армияға ауыстырылды! ? Бұл не?
Dialogue: 0,0:32:24.85,0:32:27.32,Default,,0,0,0,,Бұл жоғарғы әскери биліктің шешімі.
Dialogue: 0,0:32:27.40,0:32:31.19,Default,,0,0,0,,Қалай болғанда да, сіздің кемеңіз бірден Белфастқа бет алды.
Dialogue: 0,0:32:31.95,0:32:34.61,Default,,0,0,0,,Алегранса аралында қалған жауларды жою миссиясы...
Dialogue: 0,0:32:34.70,0:32:35.95,Default,,0,0,0,,Не болады!
Dialogue: 0,0:32:36.03,0:32:38.70,Default,,0,0,0,,Бұл... басқаларға...
Dialogue: 0,0:32:38.99,0:32:42.21,Default,,0,0,0,,Сізге оны басқа бөлімдерден жібере алмайтыныңызды айтты.
Dialogue: 0,0:32:42.54,0:32:44.96,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:32:45.04,0:32:46.71,Default,,0,0,0,,Әскерилердің жоғарғы еркі бойынша...
Dialogue: 0,0:32:47.21,0:32:49.21,Default,,0,0,0,,Өз міндеттерінде
Dialogue: 0,0:32:49.30,0:32:52.72,Default,,0,0,0,,Құрбандар болуы мүмкін.
Dialogue: 0,0:32:55.22,0:32:56.72,Default,,0,0,0,,Аа...
Dialogue: 0,0:33:00.64,0:33:01.89,Default,,0,0,0,,Уф
Dialogue: 0,0:33:01.98,0:33:03.39,Default,,0,0,0,,Уф...
Dialogue: 0,0:33:03.73,0:33:05.90,Default,,0,0,0,,Сіз мені ұрдыңыз, мистер Брайт!
Dialogue: 0,0:33:06.40,0:33:07.81,Default,,0,0,0,,Уф
Dialogue: 0,0:33:08.44,0:33:09.44,Default,,0,0,0,,Уф...
Dialogue: 0,0:33:09.52,0:33:11.11,Default,,0,0,0,,Мен сені екі рет ұрдым!
Dialogue: 0,0:33:11.19,0:33:14.15,Default,,0,0,0,,Тіпті әкем де мені ұрмаған!
Dialogue: 0,0:33:14.78,0:33:16.24,Default,,0,0,0,,Керісінше...
Dialogue: 0,0:33:20.03,0:33:23.08,Default,,0,0,0,,Ол қашып кетсе жақсы болар еді...
Dialogue: 0,0:33:23.16,0:33:24.21,Default,,0,0,0,,Әй!
Dialogue: 0,0:33:27.88,0:33:30.13,Default,,0,0,0,,Мен Белфастқа бара жатырмын!
Dialogue: 0,0:33:30.42,0:33:32.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:33:33.34,0:33:36.38,Default,,0,0,0,,Бұл старшина Амуроны іздеу емес пе еді?
Dialogue: 0,0:33:36.47,0:33:38.97,Default,,0,0,0,,Сіз Амуроны артта қалдырасыз ба? ?
Dialogue: 0,0:33:40.26,0:33:42.31,Default,,0,0,0,,Бұл әскерилердің жоғарғы эшелонынан келген бұйрық!
Dialogue: 0,0:33:42.68,0:33:44.85,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:33:44.93,0:33:47.56,Default,,0,0,0,,Олай болса, жоғарыдағы басшылыққа өз пікіріңізді айту керек!
Dialogue: 0,0:33:47.65,0:33:48.52,Default,,0,0,0,,Иә!
Dialogue: 0,0:33:48.86,0:33:52.15,Default,,0,0,0,,Сұрақтарыңыз болса, Маршал Гоптан тікелей сұраңыз...
Dialogue: 0,0:33:52.23,0:33:53.44,Default,,0,0,0,,Уф...
Dialogue: 0,0:33:53.53,0:33:56.03,Default,,0,0,0,,Әйтеуір, басқа өмір болғанша күт!
Dialogue: 0,0:33:56.11,0:33:57.32,Default,,0,0,0,,Міне!
Dialogue: 0,0:33:58.74,0:34:01.66,Default,,0,0,0,,(Фраудың айқайы)
Dialogue: 0,0:34:01.74,0:34:02.83,Default,,0,0,0,,Тс!
Dialogue: 0,0:34:02.91,0:34:03.87,Default,,0,0,0,,Балам
Dialogue: 0,0:34:03.95,0:34:05.16,Default,,0,0,0,,Жоқ, ол қалай болғанда да қашып құтыла алмайды.
Dialogue: 0,0:34:05.75,0:34:08.42,Default,,0,0,0,,Әскери сотта қарағыңыз келе ме?
Dialogue: 0,0:34:10.00,0:34:12.05,Default,,0,0,0,,Ах!
Dialogue: 0,0:34:12.13,0:34:13.67,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:34:16.17,0:34:19.59,Default,,0,0,0,,Көп уақыт болды, генерал Ма Кубе.
Dialogue: 0,0:34:19.68,0:34:24.06,Default,,0,0,0,,Кездесуге қандай өтінішіңіз бар?
Dialogue: 0,0:34:24.14,0:34:27.56,Default,,0,0,0,,бұл қандай әңгіме?
Dialogue: 0,0:34:27.64,0:34:30.10,Default,,0,0,0,,Маған тікелей сөзге көшейін.
Dialogue: 0,0:34:30.19,0:34:34.07,Default,,0,0,0,,Гибралтарды басып алу операциясынан бас тартуыңызды қалаймын.
Dialogue: 0,0:34:34.15,0:34:39.36,Default,,0,0,0,,Берілу туралы ұсынысты қарастыру дұрыс па?
Dialogue: 0,0:34:40.07,0:34:43.87,Default,,0,0,0,,Тиісті дайындықтар да бар...
Dialogue: 0,0:34:44.33,0:34:45.87,Default,,0,0,0,,Хооо
Dialogue: 0,0:34:46.25,0:34:48.87,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:34:52.46,0:34:55.17,Default,,0,0,0,,Егер бұл талап орындалмаса
Dialogue: 0,0:34:55.25,0:34:58.38,Default,,0,0,0,,Вашингтон Нью-Йорк Лондон Париж…
Dialogue: 0,0:34:58.80,0:35:02.26,Default,,0,0,0,,Көптеген қалалар жойылады
Dialogue: 0,0:35:02.35,0:35:05.14,Default,,0,0,0,,Антарктика келісімін ұмыттыңыз ба?
Dialogue: 0,0:35:06.39,0:35:08.77,Default,,0,0,0,,Шарт – бұл шарт
Dialogue: 0,0:35:08.85,0:35:12.23,Default,,0,0,0,,«Париж өртеніп жатыр ма?»
Dialogue: 0,0:35:12.31,0:35:14.48,Default,,0,0,0,,Өткен ғасырдағы Гитлер
Dialogue: 0,0:35:14.57,0:35:16.28,Default,,0,0,0,,Өздеріңіз жақсы білесіздер
Dialogue: 0,0:35:16.36,0:35:19.28,Default,,0,0,0,,Бірақ Париж өртенген жоқ.
Dialogue: 0,0:35:19.36,0:35:24.28,Default,,0,0,0,,Себебі оның қарамағындағылар оның бұйрығын орындамаған.
Dialogue: 0,0:35:24.37,0:35:25.54,Default,,0,0,0,,Бірақ—
Dialogue: 0,0:35:25.62,0:35:30.54,Default,,0,0,0,,Менің қарамағымдағылар арасында мұндай сәтсіздікке ұшыраған бірде-бір адам жоқ!
Dialogue: 0,0:35:30.96,0:35:32.29,Default,,0,0,0,,Хмм...
Dialogue: 0,0:35:32.71,0:35:37.05,Default,,0,0,0,,Мен өркениеттің одан әрі жойылғанын қаламаймын.
Dialogue: 0,0:35:37.13,0:35:40.42,Default,,0,0,0,,Біз сенің дана пікіріңді күтеміз.
Dialogue: 0,0:35:46.10,0:35:47.56,Default,,0,0,0,,Иә
Dialogue: 0,0:35:50.06,0:35:51.23,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:35:51.31,0:35:52.81,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:35:55.90,0:35:59.19,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:36:03.41,0:36:07.70,Default,,0,0,0,,(иттің үруі)
Dialogue: 0,0:36:07.79,0:36:08.83,Default,,0,0,0,,(айқай)
Dialogue: 0,0:36:09.25,0:36:11.33,Default,,0,0,0,,Алдағы жауды тексеріңіз
Dialogue: 0,0:36:11.41,0:36:13.50,Default,,0,0,0,,Барлық мүшелердің шабуылы басталады!
Dialogue: 0,0:36:13.58,0:36:14.58,Default,,0,0,0,,- Түсінікті! -сізді түсіндім!
Dialogue: 0,0:36:14.92,0:36:17.30,Default,,0,0,0,,Рёукай~
Dialogue: 0,0:36:30.64,0:36:32.60,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:36:35.61,0:36:38.07,Default,,0,0,0,,Келдің бе...!
Dialogue: 0,0:36:39.28,0:36:42.74,Default,,0,0,0,,Қоңыр… Оңтүстік крест…!
Dialogue: 0,0:36:57.59,0:36:59.34,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:37:01.34,0:37:03.17,Default,,0,0,0,,Сіз кешіктіңіз, Вальдо!
Dialogue: 0,0:37:03.26,0:37:06.43,Default,,0,0,0,,Бұл екі үтір ме? капитан
Dialogue: 0,0:37:07.09,0:37:09.43,Default,,0,0,0,,Ораораора~
Dialogue: 0,0:37:09.51,0:37:10.93,Default,,0,0,0,,Джоэстар әулеті
Dialogue: 0,0:37:13.73,0:37:15.39,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:37:17.31,0:37:19.07,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:37:21.69,0:37:23.49,Default,,0,0,0,,Келесі! Сағат 23 бағыты!
Dialogue: 0,0:37:23.95,0:37:25.07,Default,,0,0,0,,Айо
Dialogue: 0,0:37:35.08,0:37:37.58,Default,,0,0,0,,Хи хи ха ха ха...
Dialogue: 0,0:37:40.96,0:37:43.67,Default,,0,0,0,,Міне!
Dialogue: 0,0:37:43.76,0:37:46.59,Default,,0,0,0,,Маған көбірек көңіл көтеруіңізді өтінемін.
Dialogue: 0,0:37:47.84,0:37:49.64,Default,,0,0,0,,Бұл не? Сол жігіттер...
Dialogue: 0,0:37:50.81,0:37:53.22,Default,,0,0,0,,Қоңыр оңтүстік крест...
Dialogue: 0,0:37:53.31,0:37:57.10,Default,,0,0,0,,Олар осы майданның иесі сияқты.
Dialogue: 0,0:38:04.32,0:38:07.07,Default,,0,0,0,,Сәлем! Лейтенант Вальдо!
Dialogue: 0,0:38:07.82,0:38:09.87,Default,,0,0,0,,Ұрлыққа болмайды!
Dialogue: 0,0:38:09.95,0:38:11.83,Default,,0,0,0,,Ұрлық туралы не айтасыз?
Dialogue: 0,0:38:12.12,0:38:15.83,Default,,0,0,0,,Мен саған көмектестім, себебі қолыңда ақша көп болды.
Dialogue: 0,0:38:15.91,0:38:19.00,Default,,0,0,0,,Ха! Мен айтайын. Бұл рас.
Dialogue: 0,0:38:19.08,0:38:21.09,Default,,0,0,0,,Бұл сыпайылық сияқты жақсы емес.
Dialogue: 0,0:38:22.88,0:38:24.09,Default,,0,0,0,,Жақсы қол.
Dialogue: 0,0:38:26.01,0:38:28.68,Default,,0,0,0,,Мен мұнда ерікті түрде келдім.
Dialogue: 0,0:38:29.09,0:38:33.68,Default,,0,0,0,,Жоқ, мені капитан Кукурус Доан қызықтырды.
Dialogue: 0,0:38:34.06,0:38:35.56,Default,,0,0,0,,Ой...
Dialogue: 0,0:38:35.64,0:38:36.73,Default,,0,0,0,,Сәлем! Дананг!
Dialogue: 0,0:38:36.81,0:38:38.69,Default,,0,0,0,,Мен қауесеттерді естідім.
Dialogue: 0,0:38:38.77,0:38:43.82,Default,,0,0,0,,Мен оның қаншалықты күшті екенін және қалай күресетінін жақыннан көргім келді.
Dialogue: 0,0:38:43.90,0:38:47.32,Default,,0,0,0,,Қызыл комета немесе Доан?
Dialogue: 0,0:38:50.78,0:38:52.45,Default,,0,0,0,,Капитан...
Dialogue: 0,0:38:52.95,0:38:54.95,Default,,0,0,0,,Есте сақта
Dialogue: 0,0:38:55.29,0:38:57.20,Default,,0,0,0,,Бұл жігіт - Зеон...
Dialogue: 0,0:38:57.29,0:38:59.79,Default,,0,0,0,,Бізге опасыздық жасады
Dialogue: 0,0:38:59.87,0:39:02.96,Default,,0,0,0,,Бұл есімді енді ешқашан айтпа.
Dialogue: 0,0:39:03.42,0:39:07.17,Default,,0,0,0,,Мен дәл қазір осы Оңтүстік Крест отрядын басқаратын адаммын.
Dialogue: 0,0:39:07.55,0:39:10.34,Default,,0,0,0,,Эгба Атла!
Dialogue: 0,0:39:16.68,0:39:20.19,Default,,0,0,0,,(Лопаның айқайы)
Dialogue: 0,0:39:21.69,0:39:25.19,Default,,0,0,0,,Жарайды, Лопе, қорықпа.
Dialogue: 0,0:39:25.27,0:39:27.82,Default,,0,0,0,,Лопе Лопе, бәрі жақсы.
Dialogue: 0,0:39:27.90,0:39:29.20,Default,,0,0,0,,Себебі мен осындамын
Dialogue: 0,0:39:29.28,0:39:33.20,Default,,0,0,0,,Бұл қорқынышты ~ Қараңғы ~
Dialogue: 0,0:39:33.28,0:39:35.20,Default,,0,0,0,,Қараңызшы, қазір бәрі жақсы.
Dialogue: 0,0:39:35.74,0:39:37.66,Default,,0,0,0,,Шулы
Dialogue: 0,0:39:38.29,0:39:40.21,Default,,0,0,0,,Әр түн.
Dialogue: 0,0:39:40.54,0:39:42.29,Default,,0,0,0,,Ерте жатыңыз
Dialogue: 0,0:39:42.38,0:39:45.21,Default,,0,0,0,,Мен ертең ерте балық аулауға барамын.
Dialogue: 0,0:39:46.38,0:39:47.71,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:39:48.55,0:39:52.22,Default,,0,0,0,,Қараңғы~ Қорқынышты~ (есіктің ашылған дыбысы)
Dialogue: 0,0:39:54.64,0:39:56.26,Default,,0,0,0,,Рахмет Хисера
Dialogue: 0,0:39:56.35,0:39:59.48,Default,,0,0,0,,Жүр, Хисера-оне-сан жағдайды жарқыратып жіберді.
Dialogue: 0,0:39:59.89,0:40:01.69,Default,,0,0,0,,Қазір ұйықтайық.
Dialogue: 0,0:40:03.56,0:40:09.49,Default,,0,0,0,,(Лопаның айқайы)
Dialogue: 0,0:40:14.20,0:40:16.20,Default,,0,0,0,,Хмм...
Dialogue: 0,0:40:20.20,0:40:25.00,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:40:27.59,0:40:29.76,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:40:29.84,0:40:35.76,Default,,0,0,0,,(Лопаның айқайы)
Dialogue: 0,0:40:36.10,0:40:38.14,Default,,0,0,0,,Капитан! Не болды?
Dialogue: 0,0:40:38.22,0:40:40.18,Default,,0,0,0,,Біз алға жылжып келеміз, капитан!
Dialogue: 0,0:40:40.64,0:40:42.06,Default,,0,0,0,,Қайдан бастарын білмеймін.
Dialogue: 0,0:40:43.35,0:40:44.65,Default,,0,0,0,,
Dialogue: 0,0:40:45.27,0:40:46.31,Default,,0,0,0,,Хмм...
Dialogue: 0,0:40:47.86,0:40:49.65,Default,,0,0,0,,Кара? кіріңіз
Dialogue: 0,0:40:54.36,0:40:56.16,Default,,0,0,0,,Лопе ұйықтады ма?
Dialogue: 0,0:40:56.62,0:40:57.95,Default,,0,0,0,,Иә
Dialogue: 0,0:40:58.03,0:41:00.70,Default,,0,0,0,,Сол бала қараңғыдан қорқады...
Dialogue: 0,0:41:01.70,0:41:02.83,Default,,0,0,0,,Хмм...
Dialogue: 0,0:41:03.58,0:41:08.59,Default,,0,0,0,,Бөлмеде шам жанып тұрды, сондықтан мен ол әлі жұмыс істеп жатыр деп ойладым.
Dialogue: 0,0:41:09.17,0:41:10.30,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:41:11.76,0:41:12.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:41:13.47,0:41:16.34,Default,,0,0,0,,Мен сені тек қиналып жатырмын...
Dialogue: 0,0:41:17.43,0:41:18.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:41:18.97,0:41:20.35,Default,,0,0,0,,Жоқ
Dialogue: 0,0:41:20.43,0:41:23.68,Default,,0,0,0,,Мен... көмектесе алмаймын...
Dialogue: 0,0:41:23.77,0:41:25.14,Default,,0,0,0,,Доанның...
Dialogue: 0,0:41:25.23,0:41:27.44,Default,,0,0,0,,Маған көмек болса да.
Dialogue: 0,0:41:27.90,0:41:30.07,Default,,0,0,0,,Кішкене шыдамды болыңыз.
Dialogue: 0,0:41:30.15,0:41:34.11,Default,,0,0,0,,Соғыс бітсе, бұл қолайсыз өмір бітеді.
Dialogue: 0,0:41:34.82,0:41:39.28,Default,,0,0,0,,Оған дейін мен сені міндетті түрде қорғаймын.
Dialogue: 0,0:41:46.46,0:41:47.79,Default,,0,0,0,,Бум!
Dialogue: 0,0:41:49.17,0:41:51.46,Default,,0,0,0,,Өлме!
Dialogue: 0,0:41:51.92,0:41:52.96,Default,,0,0,0,,Хмм...
Dialogue: 0,0:41:53.42,0:41:56.47,Default,,0,0,0,,Доан өлсе, мен...
Dialogue: 0,0:41:56.55,0:41:59.89,Default,,0,0,0,,Біз… барлығымыз…
Dialogue: 0,0:42:07.10,0:42:08.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:42:15.74,0:42:17.99,Default,,0,0,0,,Кәне, дұрысырақ жу!
Dialogue: 0,0:42:18.07,0:42:19.62,Default,,0,0,0,,Бірақ~
Dialogue: 0,0:42:19.70,0:42:22.74,Default,,0,0,0,,Суық! Марко маған су сеуіп жіберді~
Dialogue: 0,0:42:22.83,0:42:23.99,Default,,0,0,0,,Корат Марко!
Dialogue: 0,0:42:24.66,0:42:26.75,Default,,0,0,0,,Джулиан, сен не істеп жатырсың?
Dialogue: 0,0:42:28.96,0:42:30.00,Default,,0,0,0,,Кя~
Dialogue: 0,0:42:31.13,0:42:32.80,Default,,0,0,0,,Қара, қара, қара.
Dialogue: 0,0:42:32.88,0:42:34.63,Default,,0,0,0,,Эй, эй, эй
Dialogue: 0,0:42:34.71,0:42:36.22,Default,,0,0,0,,Корат Фуриан!
Dialogue: 0,0:42:36.30,0:42:37.88,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:42:39.26,0:42:41.18,Default,,0,0,0,,Хосе, оны қаттырақ ұста.
Dialogue: 0,0:42:46.14,0:42:47.94,Default,,0,0,0,,Мен жеткілікті болдым
Dialogue: 0,0:42:49.90,0:42:52.15,Default,,0,0,0,,Жарайды, жақсы.
Dialogue: 0,0:42:52.69,0:42:54.07,Default,,0,0,0,,Оны өзіңізбен бірге алыңыз.
Dialogue: 0,0:42:55.73,0:42:57.32,Default,,0,0,0,,Ойнамаңыз!
Dialogue: 0,0:42:57.70,0:43:00.20,Default,,0,0,0,,Суды абайлап пайдаланыңыз
Dialogue: 0,0:43:00.28,0:43:01.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:43:05.20,0:43:07.08,Default,,0,0,0,,Ақыры ояндың
Dialogue: 0,0:43:07.16,0:43:08.66,Default,,0,0,0,,Таңертең ұйықтап кеттің.
Dialogue: 0,0:43:12.13,0:43:13.42,Default,,0,0,0,,Ах
Dialogue: 0,0:43:18.13,0:43:19.84,Default,,0,0,0,,Ас үшін рахмет
Dialogue: 0,0:43:21.39,0:43:22.22,Default,,0,0,0,,Тс!
Dialogue: 0,0:43:22.85,0:43:24.72,Default,,0,0,0,,Кеше түнде жақсы ұйықтадың ба?
Dialogue: 0,0:43:25.31,0:43:26.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:43:26.60,0:43:27.81,Default,,0,0,0,,Иә...
Dialogue: 0,0:43:28.23,0:43:29.69,Default,,0,0,0,,Бұл өтірік~
Dialogue: 0,0:43:29.77,0:43:31.06,Default,,0,0,0,,Енді Лопе...
Dialogue: 0,0:43:31.48,0:43:34.44,Default,,0,0,0,,Сіз қалай ойлайсыз? Сіз де жасап көргіңіз келе ме?
Dialogue: 0,0:43:36.48,0:43:37.74,Default,,0,0,0,,Иә
Dialogue: 0,0:43:39.15,0:43:40.20,Default,,0,0,0,,Хмм...
Dialogue: 0,0:43:41.16,0:43:42.49,Default,,0,0,0,,Ха!
Dialogue: 0,0:43:46.04,0:43:47.45,Default,,0,0,0,,Хмм
Dialogue: 0,0:43:48.91,0:43:49.96,Default,,0,0,0,,Хмм
Dialogue: 0,0:43:51.37,0:43:53.58,Default,,0,0,0,,Хухахахаха... Ахахахаха...
Dialogue: 0,0:43:53.67,0:43:55.09,Default,,0,0,0,,Хи хи хи...
Dialogue: 0,0:43:58.67,0:44:00.05,Default,,0,0,0,,Хмм...
Dialogue: 0,0:44:01.05,0:44:03.97,Default,,0,0,0,,Болды, анау, анау.
Dialogue: 0,0:44:10.06,0:44:11.98,Default,,0,0,0,,Уа... цк
Dialogue: 0,0:44:14.06,0:44:15.52,Default,,0,0,0,,Ей
Dialogue: 0,0:44:15.61,0:44:16.61,Default,,0,0,0,,Ах
Dialogue: 0,0:44:18.98,0:44:21.36,Default,,0,0,0,,Астындағы топырақ қара, солай емес пе?
Dialogue: 0,0:44:21.45,0:44:23.61,Default,,0,0,0,,Мен жақсы нәрсені байқадым.
Dialogue: 0,0:44:24.24,0:44:27.12,Default,,0,0,0,,Жанған жанартау күлі де қара топыраққа айналады.
Dialogue: 0,0:44:27.62,0:44:30.50,Default,,0,0,0,,Ал одан да өскін шығады.
Dialogue: 0,0:44:33.33,0:44:37.13,Default,,0,0,0,,Бұл үлкен нәрсе, табиғаттың құдіреті...
Dialogue: 0,0:44:40.01,0:44:42.72,Default,,0,0,0,,Күте тұрыңыз, Бланкер!
Dialogue: 0,0:44:43.93,0:44:46.22,Default,,0,0,0,,Біреу мені ұстап алсын!
Dialogue: 0,0:44:46.80,0:44:48.56,Default,,0,0,0,,-Йоша -Йо
Dialogue: 0,0:44:48.85,0:44:50.22,Default,,0,0,0,,-Ояаа -Ацуцу
Dialogue: 0,0:44:50.64,0:44:52.69,Default,,0,0,0,,Сізді қайтадан аударды ма?
Dialogue: 0,0:44:52.77,0:44:55.44,Default,,0,0,0,,Иә, Арқан осында...
Dialogue: 0,0:44:56.06,0:44:58.27,Default,,0,0,0,,Тыңдаңыз, дұрыс ұстаңыз.
Dialogue: 0,0:44:58.36,0:44:59.73,Default,,0,0,0,,Иә...
Dialogue: 0,0:45:00.48,0:45:02.99,Default,,0,0,0,,Тыныш қал, Бланка.
Dialogue: 0,0:45:08.66,0:45:09.99,Default,,0,0,0,,Уау! Ах
Dialogue: 0,0:45:10.08,0:45:12.12,Default,,0,0,0,,Ах~
Dialogue: 0,0:45:12.66,0:45:15.29,Default,,0,0,0,,Уф, у, у...
Dialogue: 0,0:45:15.37,0:45:16.83,Default,,0,0,0,,Жылама!
Dialogue: 0,0:45:17.38,0:45:19.84,Default,,0,0,0,,Бланка Лопе үшін мүмкін емес.
Dialogue: 0,0:45:19.92,0:45:24.72,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:45:24.80,0:45:26.59,Default,,0,0,0,,Әзірге үш минут
Dialogue: 0,0:45:28.85,0:45:31.93,Default,,0,0,0,,Бланка Ропты жақсы көреді.
Dialogue: 0,0:45:32.02,0:45:34.52,Default,,0,0,0,,Олай болса, бұл «ешкі жігіт» шығар.
Dialogue: 0,0:45:34.60,0:45:36.44,Default,,0,0,0,,Теке мырза жақсы екен.
Dialogue: 0,0:45:36.52,0:45:39.31,Default,,0,0,0,,Мен мұны Матео үшін жасаймын деп ойлаймын.
Dialogue: 0,0:45:39.40,0:45:41.02,Default,,0,0,0,,Мен де жасадым!
Dialogue: 0,0:45:41.53,0:45:44.99,Default,,0,0,0,,Жоқ, мен ешкіге жауаптымын.
Dialogue: 0,0:45:45.07,0:45:47.78,Default,,0,0,0,,А, бұл жолы Матео жылап тұр.
Dialogue: 0,0:45:48.32,0:45:50.83,Default,,0,0,0,,Қысу әдісі дұрыс емес пе?
Dialogue: 0,0:45:51.62,0:45:54.50,Default,,0,0,0,,Тыңда, саусағыңды былай қой.
Dialogue: 0,0:45:54.58,0:45:58.58,Default,,0,0,0,,Сұқ саусағыңызбен жайлап қысым жасаңыз.
Dialogue: 0,0:45:58.67,0:45:59.96,Default,,0,0,0,,Міне
Dialogue: 0,0:46:00.04,0:46:01.21,Default,,0,0,0,,Байқап көріңіз
Dialogue: 0,0:46:01.30,0:46:02.50,Default,,0,0,0,,Иә!
Dialogue: 0,0:46:03.63,0:46:06.80,Default,,0,0,0,,Иә, онда ретімен...
Dialogue: 0,0:46:06.88,0:46:09.68,Default,,0,0,0,,Дұрыс, ақырында сақина саусақ...
Dialogue: 0,0:46:10.14,0:46:12.01,Default,,0,0,0,,(айқай)
Dialogue: 0,0:46:12.10,0:46:14.18,Default,,0,0,0,,«Уми» себебі
Dialogue: 0,0:46:15.89,0:46:17.90,Default,,0,0,0,,Сізге жақсы, Матео.
Dialogue: 0,0:46:17.98,0:46:20.06,Default,,0,0,0,,Доанның қолынан бәрі келеді, солай ма?
Dialogue: 0,0:46:20.15,0:46:22.82,Default,,0,0,0,,- (Гепард) Эй - Мен де солай жасағым келеді.
Dialogue: 0,0:46:23.48,0:46:24.94,Default,,0,0,0,,Доаан! Мен керемет балық ұстадым!
Dialogue: 0,0:46:25.03,0:46:26.57,Default,,0,0,0,,Доаан!
Dialogue: 0,0:46:26.65,0:46:29.57,Default,,0,0,0,,Доан Мынаны қара!
Dialogue: 0,0:46:29.91,0:46:31.33,Default,,0,0,0,,- (Бала) Уау - (Бала) Бұл не?
Dialogue: 0,0:46:31.41,0:46:33.99,Default,,0,0,0,,-(Бала) Қорқынышты~ Мені жеп қояр деп ойлаймын -(Бала) Өте үлкен!
Dialogue: 0,0:46:34.08,0:46:35.20,Default,,0,0,0,,Дельфин балығы
Dialogue: 0,0:46:35.29,0:46:36.58,Default,,0,0,0,,Дельфин балығы?
Dialogue: 0,0:46:36.91,0:46:39.42,Default,,0,0,0,,Бұл әлі де кішігірім жағында
Dialogue: 0,0:46:39.50,0:46:42.34,Default,,0,0,0,,Үлкені осылай болады!
Dialogue: 0,0:46:42.75,0:46:45.13,Default,,0,0,0,,Иә, мен оны ұстаймын!
Dialogue: 0,0:46:45.21,0:46:47.51,Default,,0,0,0,,Бұл дәмді ме? бұл балық
Dialogue: 0,0:46:47.59,0:46:50.30,Default,,0,0,0,,Бұл дәмді! Мейлі қуырылған, мейлі пісірілген
Dialogue: 0,0:46:50.39,0:46:51.72,Default,,0,0,0,,Меньер!
Dialogue: 0,0:46:51.80,0:46:55.14,Default,,0,0,0,,Енді Джулианның туған күні шешілді.
Dialogue: 0,0:46:55.22,0:46:57.10,Default,,0,0,0,,Иә!
Dialogue: 0,0:46:59.27,0:47:02.19,Default,,0,0,0,,Бүгін тағы да мобильді костюмдерді іздейсіз бе?
Dialogue: 0,0:47:02.82,0:47:03.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:47:04.32,0:47:05.36,Default,,0,0,0,,Иә
Dialogue: 0,0:47:05.65,0:47:08.36,Default,,0,0,0,,Сонда ыстық сені өлтіреді.
Dialogue: 0,0:47:08.78,0:47:10.49,Default,,0,0,0,,Оны киіңіз
Dialogue: 0,0:47:10.70,0:47:12.95,Default,,0,0,0,,Не? үй
Dialogue: 0,0:47:13.20,0:47:14.87,Default,,0,0,0,,Және... бұл
Dialogue: 0,0:47:15.87,0:47:17.12,Default,,0,0,0,,Оны өзіңізбен бірге алыңыз.
Dialogue: 0,0:47:17.20,0:47:18.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:47:19.75,0:47:22.46,Default,,0,0,0,,Таба алмасаң, ерте қайт.
Dialogue: 0,0:47:22.54,0:47:24.38,Default,,0,0,0,,Қараңғы түскенге дейін
Dialogue: 0,0:47:25.00,0:47:27.38,Default,,0,0,0,,Шынымен оны табу оңай ма?
Dialogue: 0,0:47:27.76,0:47:28.92,Default,,0,0,0,,Хмм...
Dialogue: 0,0:47:29.01,0:47:31.18,Default,,0,0,0,,О, досым! Осы жеңісті тойлайық
Dialogue: 0,0:47:34.76,0:47:35.97,Default,,0,0,0,,Хмм...
Dialogue: 0,0:47:37.47,0:47:38.77,Default,,0,0,0,,(Есікті қағу)
Dialogue: 0,0:47:38.85,0:47:41.90,Default,,0,0,0,,Котлет! Қанекей мынаны істейік! Кикка!
Dialogue: 0,0:47:41.98,0:47:44.98,Default,,0,0,0,,Ашық! Жаман балалар!
Dialogue: 0,0:47:45.07,0:47:47.48,Default,,0,0,0,,-Шықпа! - гало гало
Dialogue: 0,0:47:47.57,0:47:50.61,Default,,0,0,0,,Амуро-нии-чанды іздемеу қорқынышты.
Dialogue: 0,0:47:50.70,0:47:53.32,Default,,0,0,0,,Мен саған көмектесемін демейінше шықпаймын!
Dialogue: 0,0:47:53.41,0:47:54.49,Default,,0,0,0,,Денаизо
Dialogue: 0,0:47:54.58,0:47:57.74,Default,,0,0,0,,Мен күрішті де жемеймін!
Dialogue: 0,0:47:57.83,0:47:58.91,Default,,0,0,0,,Уф...
Dialogue: 0,0:47:59.00,0:48:00.75,Default,,0,0,0,,Бұл, әрине, мағынасы бар.
Dialogue: 0,0:48:01.25,0:48:03.25,Default,,0,0,0,,Бірге күрескен достар...
Dialogue: 0,0:48:03.33,0:48:06.34,Default,,0,0,0,,Жоғарыдан келген бұйрық бойынша біреуді тастап кету...
Dialogue: 0,0:48:06.42,0:48:09.80,Default,,0,0,0,,Иә, сіз мұны әлі істеп жатырсыз ба? Кішкентай жігіттер
Dialogue: 0,0:48:11.80,0:48:14.51,Default,,0,0,0,,«Мен күріш немесе ештеңе жемеймін»…
Dialogue: 0,0:48:14.85,0:48:17.39,Default,,0,0,0,,Бұл ұят болды.
Dialogue: 0,0:48:17.47,0:48:19.56,Default,,0,0,0,,Канар аралдарының мамандығы —
Dialogue: 0,0:48:19.64,0:48:22.27,Default,,0,0,0,,Мен бал балмұздақ сатып алдым.
Dialogue: 0,0:48:22.35,0:48:24.65,Default,,0,0,0,,Қызық, еріп кете ме?
Dialogue: 0,0:48:24.73,0:48:26.52,Default,,0,0,0,,Е, балмұздақ! ?
Dialogue: 0,0:48:26.98,0:48:28.44,Default,,0,0,0,,Әй, балмұздақ!
Dialogue: 0,0:48:28.53,0:48:28.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:48:28.90,0:48:29.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:48:28.90,0:48:29.65,Default,,0,0,0,,Дамеда Кикка
Dialogue: 0,0:48:29.65,0:48:29.74,Default,,0,0,0,,Дамеда Кикка
Dialogue: 0,0:48:29.74,0:48:30.78,Default,,0,0,0,,Дамеда Кикка
Dialogue: 0,0:48:29.74,0:48:30.78,Default,,0,0,0,,- Кикка! Жоқ! -Ах!
Dialogue: 0,0:48:30.78,0:48:31.49,Default,,0,0,0,,- Кикка! Жоқ! -Ах!
Dialogue: 0,0:48:31.57,0:48:32.61,Default,,0,0,0,,Балмұздақ қайда? ?
Dialogue: 0,0:48:32.70,0:48:34.78,Default,,0,0,0,,-А, ә, ә? -(Слеггер) Йотто
Dialogue: 0,0:48:34.87,0:48:35.57,Default,,0,0,0,,-Ах~ -Му~
Dialogue: 0,0:48:35.57,0:48:36.95,Default,,0,0,0,,-Ах~ -Му~
Dialogue: 0,0:48:35.57,0:48:36.95,Default,,0,0,0,,...
Dialogue: 0,0:48:36.95,0:48:37.87,Default,,0,0,0,,-Ах~ -Му~
Dialogue: 0,0:48:37.95,0:48:40.50,Default,,0,0,0,,Әй, бал балмұздақ қайда?
Dialogue: 0,0:48:40.58,0:48:41.62,Default,,0,0,0,,-Міне, міне -Ей
Dialogue: 0,0:48:41.71,0:48:43.75,Default,,0,0,0,,Меніңше... олар әлі өздерін жинастыра алмай, қиналып жатыр.
Dialogue: 0,0:48:44.92,0:48:48.25,Default,,0,0,0,,Бір әскери сот, мырзалар.
Dialogue: 0,0:48:48.71,0:48:50.67,Default,,0,0,0,,Хмм...
Dialogue: 0,0:48:51.76,0:48:53.93,Default,,0,0,0,,3 мобильді костюммен шықты!
Dialogue: 0,0:48:54.01,0:48:56.01,Default,,0,0,0,,Ефрейтор Кай және ефрейтор Хаято
Dialogue: 0,0:48:56.26,0:48:57.51,Default,,0,0,0,,Сіз ше, лейтенант?
Dialogue: 0,0:48:57.60,0:48:59.89,Default,,0,0,0,,Әрине, мен спортзалға келемін.
Dialogue: 0,0:48:59.97,0:49:01.39,Default,,0,0,0,,Енді ештеңені жоғалтпау үшін
Dialogue: 0,0:49:01.48,0:49:04.90,Default,,0,0,0,,Ганперридің жүк көтергіштігі екі мобильді костюм.
Dialogue: 0,0:49:05.23,0:49:06.40,Default,,0,0,0,,Міне!
Dialogue: 0,0:49:07.15,0:49:09.02,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:49:10.73,0:49:14.40,Default,,0,0,0,,Я, Өзек Booster деген бірдеңе болды.
Dialogue: 0,0:49:15.28,0:49:17.41,Default,,0,0,0,,Негізгі күшейткішті басқару?
Dialogue: 0,0:49:17.49,0:49:19.66,Default,,0,0,0,,Иә, мүмкін.
Dialogue: 0,0:49:20.37,0:49:23.16,Default,,0,0,0,,Егер солай болса, онда бұл кеңес.
Dialogue: 0,0:49:23.91,0:49:26.42,Default,,0,0,0,,Мен сенің арқаңда...
Dialogue: 0,0:49:26.50,0:49:27.42,Default,,0,0,0,,Хмм...
Dialogue: 0,0:49:29.25,0:49:31.55,Default,,0,0,0,,Ухё~
Dialogue: 0,0:49:32.63,0:49:35.05,Default,,0,0,0,,Белфастқа дейінгі қашықтыққа шектеу бар.
Dialogue: 0,0:49:35.13,0:49:37.05,Default,,0,0,0,,Іс-шара ертең сағат 15:00-де өтеді!
Dialogue: 0,0:49:37.43,0:49:40.14,Default,,0,0,0,,Осы уақытқа дейін екі зеңбіректі Гунперриге салыңыз.
Dialogue: 0,0:49:40.22,0:49:41.06,Default,,0,0,0,,Иә
Dialogue: 0,0:49:41.35,0:49:43.98,Default,,0,0,0,,Мен негізгі күшейткішпен кетемін
Dialogue: 0,0:49:44.06,0:49:46.48,Default,,0,0,0,,Жол ақысы қымбат болды...
Dialogue: 0,0:49:53.44,0:49:55.45,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:50:03.33,0:50:05.00,Default,,0,0,0,,Бұл Гундам!
Dialogue: 0,0:50:23.56,0:50:26.56,Default,,0,0,0,,Мен бұл көріністі бұрын көргенмін...
Dialogue: 0,0:50:26.89,0:50:28.10,Default,,0,0,0,,Хмм...
Dialogue: 0,0:50:29.19,0:50:30.36,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:50:31.65,0:50:32.48,Default,,0,0,0,,Ха!
Dialogue: 0,0:50:32.82,0:50:34.36,Default,,0,0,0,,Міне, уақыты!
Dialogue: 0,0:50:34.44,0:50:36.32,Default,,0,0,0,,Міне, мен!
Dialogue: 0,0:50:50.71,0:50:52.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:50:52.50,0:50:54.13,Default,,0,0,0,,Ах!
Dialogue: 0,0:50:57.22,0:50:58.26,Default,,0,0,0,,Міне...
Dialogue: 0,0:51:00.05,0:51:03.76,Default,,0,0,0,,Міне, мен Доан есімді адаммен біргемін...
Dialogue: 0,0:51:04.47,0:51:06.06,Default,,0,0,0,,Хмм...
Dialogue: 0,0:51:09.14,0:51:10.60,Default,,0,0,0,,Хмм...
Dialogue: 0,0:51:15.86,0:51:17.11,Default,,0,0,0,,Уау
Dialogue: 0,0:51:17.19,0:51:18.28,Default,,0,0,0,,Уф...
Dialogue: 0,0:51:21.11,0:51:23.16,Default,,0,0,0,,Уф...
Dialogue: 0,0:51:23.24,0:51:26.04,Default,,0,0,0,,Уф...
Dialogue: 0,0:51:27.62,0:51:29.62,Default,,0,0,0,,Хаа…
Dialogue: 0,0:51:30.75,0:51:33.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:51:38.55,0:51:40.72,Default,,0,0,0,,Дауыл келе жатыр
Dialogue: 0,0:51:46.89,0:51:48.52,Default,,0,0,0,,Уф...
Dialogue: 0,0:51:48.60,0:51:49.89,Default,,0,0,0,,Уау~
Dialogue: 0,0:51:52.35,0:51:54.52,Default,,0,0,0,,Уау~
Dialogue: 0,0:51:55.44,0:51:57.53,Default,,0,0,0,,Яй, жаңбыр жауды, жаңбыр жауды
Dialogue: 0,0:52:08.75,0:52:10.21,Default,,0,0,0,,Иә!
Dialogue: 0,0:52:10.41,0:52:11.75,Default,,0,0,0,,Жақсы сезінеді~
Dialogue: 0,0:52:11.83,0:52:13.75,Default,,0,0,0,,(көңілді дауыс)
Dialogue: 0,0:52:13.83,0:52:18.26,Default,,0,0,0,,(көңілді дауыс)
Dialogue: 0,0:52:23.39,0:52:25.97,Default,,0,0,0,,Қараңызшы, мен көп жинадым.
Dialogue: 0,0:52:26.81,0:52:29.89,Default,,0,0,0,,Бұл су Ол су
Dialogue: 0,0:52:30.18,0:52:31.23,Default,,0,0,0,,Уау!
Dialogue: 0,0:52:31.31,0:52:32.81,Default,,0,0,0,,(Марко жылайды)
Dialogue: 0,0:52:32.89,0:52:35.15,Default,,0,0,0,,Төгілме, Барса.
Dialogue: 0,0:52:41.74,0:52:43.11,Default,,0,0,0,,Керемет Керемет
Dialogue: 0,0:52:43.70,0:52:45.53,Default,,0,0,0,,Толық.
Dialogue: 0,0:52:45.62,0:52:47.37,Default,,0,0,0,,- (Карла) Маркос - Иә?
Dialogue: 0,0:52:47.62,0:52:50.08,Default,,0,0,0,,Құдықтан су жоқ.
Dialogue: 0,0:52:50.16,0:52:51.66,Default,,0,0,0,,Иә! ?
Dialogue: 0,0:52:53.67,0:52:55.33,Default,,0,0,0,,Бұл рас…
Dialogue: 0,0:52:55.79,0:52:57.67,Default,,0,0,0,,Ағаларыңа құрмет көрсет!
Dialogue: 0,0:53:04.51,0:53:05.68,Default,,0,0,0,,Ах!
Dialogue: 0,0:53:06.68,0:53:10.10,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:53:10.18,0:53:11.56,Default,,0,0,0,,Бум! (есіктің ашылған дыбысы)
Dialogue: 0,0:53:11.64,0:53:12.85,Default,,0,0,0,,-Кел! -Иә?
Dialogue: 0,0:53:13.35,0:53:15.60,Default,,0,0,0,,Су ағуын тоқтатты
Dialogue: 0,0:53:16.19,0:53:18.02,Default,,0,0,0,,Су енді келмейді ме?
Dialogue: 0,0:53:18.11,0:53:19.86,Default,,0,0,0,,Ол кетті ме?
Dialogue: 0,0:53:19.94,0:53:22.36,Default,,0,0,0,,Ертең Джулианның туған күні болса да...
Dialogue: 0,0:53:22.82,0:53:25.03,Default,,0,0,0,,Мен туған күнімді тойлай алмаймын!
Dialogue: 0,0:53:25.28,0:53:27.12,Default,,0,0,0,,Бұл бәрі емес.
Dialogue: 0,0:53:27.20,0:53:28.70,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:53:28.78,0:53:30.83,Default,,0,0,0,,Уайымдама, Джулиан.
Dialogue: 0,0:53:30.91,0:53:32.79,Default,,0,0,0,,Сіз су іше алмайсыз ба?
Dialogue: 0,0:53:32.87,0:53:34.29,Default,,0,0,0,,Не болды?
Dialogue: 0,0:53:34.37,0:53:36.79,Default,,0,0,0,,Менің суым таусылды.
Dialogue: 0,0:53:38.25,0:53:39.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:53:39.79,0:53:42.42,Default,,0,0,0,,Жаңбыр суын ішу керек емес пе?
Dialogue: 0,0:53:42.51,0:53:44.42,Default,,0,0,0,,Бұл сіздің асқазаныңызды ауыртады!
Dialogue: 0,0:53:45.30,0:53:46.13,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:53:46.22,0:53:47.59,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:53:49.01,0:53:51.06,Default,,0,0,0,,Құбыр босап қалды.
Dialogue: 0,0:53:51.14,0:53:53.43,Default,,0,0,0,,Маркосты жөндеуге барайық
Dialogue: 0,0:53:53.52,0:53:54.52,Default,,0,0,0,,Иә
Dialogue: 0,0:53:54.60,0:53:56.94,Default,,0,0,0,,-Мен де барамын. -Аа...
Dialogue: 0,0:53:59.81,0:54:02.69,Default,,0,0,0,,Дұрыс, сен де.
Dialogue: 0,0:54:03.15,0:54:05.99,Default,,0,0,0,,Хмм… мм…
Dialogue: 0,0:54:11.53,0:54:14.91,Default,,0,0,0,,Онда B сыныбында да осындай адамдар бар екен ғой.
Dialogue: 0,0:54:18.12,0:54:19.38,Default,,0,0,0,,Жақсы емес.
Dialogue: 0,0:54:19.46,0:54:22.09,Default,,0,0,0,,Мен қозғалтқыштың шуын естимін.
Dialogue: 0,0:54:22.17,0:54:25.63,Default,,0,0,0,,Жолдағы тастардың арасы өте тар, мен өте алмаймын.
Dialogue: 0,0:54:27.13,0:54:30.18,Default,,0,0,0,,Мүмкін сіздің денеңіз оны жеңе алады.
Dialogue: 0,0:54:30.51,0:54:31.76,Default,,0,0,0,,А...
Dialogue: 0,0:54:31.85,0:54:33.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:54:39.02,0:54:40.94,Default,,0,0,0,,Ах~ Ух...
Dialogue: 0,0:54:41.52,0:54:43.28,Default,,0,0,0,,Маркос не болды?
Dialogue: 0,0:54:43.36,0:54:44.90,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:54:45.44,0:54:46.95,Default,,0,0,0,,Мен мұны істеймін
Dialogue: 0,0:54:47.61,0:54:48.45,Default,,0,0,0,,​​О?
Dialogue: 0,0:54:50.53,0:54:51.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:54:51.45,0:54:53.99,Default,,0,0,0,,Түсіндім, сосын саған.
Dialogue: 0,0:54:55.91,0:54:56.96,Default,,0,0,0,,Әй!
Dialogue: 0,0:54:57.66,0:54:59.00,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:54:59.08,0:55:00.38,Default,,0,0,0,,Иә
Dialogue: 0,0:55:01.50,0:55:02.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:55:09.22,0:55:10.64,Default,,0,0,0,,Хмм...
Dialogue: 0,0:55:11.39,0:55:12.68,Default,,0,0,0,,Хмм...
Dialogue: 0,0:55:13.26,0:55:14.64,Default,,0,0,0,,Хмм...
Dialogue: 0,0:55:21.81,0:55:22.94,Default,,0,0,0,,Ах!
Dialogue: 0,0:55:23.36,0:55:24.69,Default,,0,0,0,,Уф...
Dialogue: 0,0:55:28.90,0:55:30.74,Default,,0,0,0,,Уф...
Dialogue: 0,0:55:31.66,0:55:33.16,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:55:33.24,0:55:34.74,Default,,0,0,0,,Құбыр шығып кетті.
Dialogue: 0,0:55:35.16,0:55:36.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:55:37.79,0:55:39.75,Default,,0,0,0,,Суасты сорғы да тірі
Dialogue: 0,0:55:40.33,0:55:43.50,Default,,0,0,0,,Қазір құбырларды қосуды бастайық!
Dialogue: 0,0:55:51.30,0:55:52.76,Default,,0,0,0,,Уау!
Dialogue: 0,0:55:53.09,0:55:54.14,Default,,0,0,0,,Су бітті!
Dialogue: 0,0:55:54.22,0:55:55.56,Default,,0,0,0,,Иә!
Dialogue: 0,0:55:55.64,0:55:57.22,Default,,0,0,0,,шықты
Dialogue: 0,0:55:58.64,0:56:00.14,Default,,0,0,0,,А, бум!
Dialogue: 0,0:56:04.06,0:56:05.98,Default,,0,0,0,,Доан Рахмет!
Dialogue: 0,0:56:06.07,0:56:07.98,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:56:09.32,0:56:11.32,Default,,0,0,0,,Күтілгендей, Доан керемет!
Dialogue: 0,0:56:11.40,0:56:12.95,Default,,0,0,0,,Ғажайып таңғажайып
Dialogue: 0,0:56:13.03,0:56:14.78,Default,,0,0,0,,Рахмет сізге Доан
Dialogue: 0,0:56:15.53,0:56:17.87,Default,,0,0,0,,Амуро оны маған жөндеп берді.
Dialogue: 0,0:56:17.95,0:56:18.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:56:19.33,0:56:20.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:56:22.04,0:56:24.29,Default,,0,0,0,,Рахмет Амуро
Dialogue: 0,0:56:24.54,0:56:26.59,Default,,0,0,0,,Және қалағаныңа қол жеткізе алмасаң—
Dialogue: 0,0:56:28.38,0:56:29.71,Default,,0,0,0,,Маркосқа қош келдіңіз
Dialogue: 0,0:56:29.80,0:56:30.63,Default,,0,0,0,,Рахмет
Dialogue: 0,0:56:30.72,0:56:32.18,Default,,0,0,0,,Шулы!
Dialogue: 0,0:56:38.81,0:56:41.43,Default,,0,0,0,,- (Карла) Сен де бүгін жұмыс істейсің бе? -Ой
Dialogue: 0,0:56:42.52,0:56:45.44,Default,,0,0,0,,- (Қара) Мен қызықпын - Иә?
Dialogue: 0,0:56:45.90,0:56:50.82,Default,,0,0,0,,Сіз де кеше кешіккен сияқтысыз. Сіздің жұмысыңыз шынымен соншалықты ауыр ма?
Dialogue: 0,0:56:51.53,0:56:53.57,Default,,0,0,0,,Бұл үлкен мәселе емес.
Dialogue: 0,0:56:53.66,0:56:57.45,Default,,0,0,0,,Жақында бітеді, уайымдама.
Dialogue: 0,0:57:00.16,0:57:02.83,Default,,0,0,0,,А, Доан, келші!
Dialogue: 0,0:57:02.91,0:57:05.96,Default,,0,0,0,,Бүгін кешке менің туған күнім.
Dialogue: 0,0:57:06.04,0:57:08.92,Default,,0,0,0,,А, мен үйге ерте келемін.
Dialogue: 0,0:57:22.60,0:57:24.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:57:28.61,0:57:30.53,Default,,0,0,0,,Қайда бара жатырсың? Маркос
Dialogue: 0,0:57:37.99,0:57:39.28,Default,,0,0,0,,Хмм...
Dialogue: 0,0:57:47.50,0:57:49.09,Default,,0,0,0,,(айқай)
Dialogue: 0,0:57:51.42,0:57:54.01,Default,,0,0,0,,Ой... сен де барасың ба?
Dialogue: 0,0:57:54.09,0:57:55.34,Default,,0,0,0,,Иә
Dialogue: 0,0:57:56.09,0:57:57.80,Default,,0,0,0,,Сіз бұл туралы не істейсіз?
Dialogue: 0,0:58:03.77,0:58:04.98,Default,,0,0,0,,О!
Dialogue: 0,0:58:05.27,0:58:06.81,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:58:07.48,0:58:08.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:58:09.44,0:58:11.32,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:58:13.15,0:58:15.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:58:19.28,0:58:21.33,Default,,0,0,0,,Иә, бұл арқан.
Dialogue: 0,0:58:22.49,0:58:24.45,Default,,0,0,0,,Сізге тек арқан керек!
Dialogue: 0,0:58:50.86,0:58:55.49,Default,,0,0,0,,Хаа һаа һаа һаа…
Dialogue: 0,0:59:01.45,0:59:02.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:59:05.33,0:59:07.62,Default,,0,0,0,,(Оқушылар) Э-э… Мүмкін емес! Мүмкін емес!
Dialogue: 0,0:59:42.82,0:59:44.08,Default,,0,0,0,,Уф!
Dialogue: 0,0:59:50.71,0:59:53.17,Default,,0,0,0,,А-а-а-а...
Dialogue: 0,1:00:30.46,1:00:31.87,Default,,0,0,0,,Хмм...
Dialogue: 0,1:00:53.90,1:00:55.65,Default,,0,0,0,,Хмм... Ха!
Dialogue: 0,1:01:00.74,1:01:02.74,Default,,0,0,0,,- Бум! -Уф
Dialogue: 0,1:01:03.61,1:01:06.16,Default,,0,0,0,,Не болды? Мұнда келме...
Dialogue: 0,1:01:06.70,1:01:09.41,Default,,0,0,0,,Маған... мына ақты бер!
Dialogue: 0,1:01:09.49,1:01:10.70,Default,,0,0,0,,Иә?
Dialogue: 0,1:01:10.79,1:01:11.66,Default,,0,0,0,,Ах!
Dialogue: 0,1:01:11.95,1:01:14.46,Default,,0,0,0,,Мен жылжымалы костюм мінгім келеді!
Dialogue: 0,1:01:14.54,1:01:16.54,Default,,0,0,0,,Мен де бәрін қорғай аламын!
Dialogue: 0,1:01:17.21,1:01:20.38,Default,,0,0,0,,Мен Доан сияқты шайқасқым келеді!
Dialogue: 0,1:01:20.63,1:01:23.13,Default,,0,0,0,,Жекпе-жек жалғыз күш емес
Dialogue: 0,1:01:23.22,1:01:24.18,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:01:24.26,1:01:27.39,Default,,0,0,0,,Үйге қайт! Ешқашан мұнда енді келме!
Dialogue: 0,1:01:28.01,1:01:29.39,Default,,0,0,0,,Есік…
Dialogue: 0,1:01:29.64,1:01:31.89,Default,,0,0,0,,Үйге қайт! Хмм...
Dialogue: 0,1:01:31.97,1:01:34.39,Default,,0,0,0,,Спидвагон керемет шығып кетті.
Dialogue: 0,1:01:35.10,1:01:38.06,Default,,0,0,0,,Гундам осында, солай ма?
Dialogue: 0,1:01:38.48,1:01:40.40,Default,,0,0,0,,Ах! Ах...
Dialogue: 0,1:01:41.53,1:01:44.90,Default,,0,0,0,,Бұл менікі, қайтарыңызшы.
Dialogue: 0,1:01:45.70,1:01:47.99,Default,,0,0,0,,Сіз оны үнемі сынап көрдіңіз бе?
Dialogue: 0,1:01:48.37,1:01:49.58,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,1:01:49.66,1:01:51.99,Default,,0,0,0,,7 жағынан
Dialogue: 0,1:01:53.04,1:01:55.21,Default,,0,0,0,,Мен сене алмадым...
Dialogue: 0,1:01:56.29,1:01:58.75,Default,,0,0,0,,«Федерацияның ақ жігіті»
Dialogue: 0,1:01:59.04,1:02:01.00,Default,,0,0,0,,Қанша Зеон жауынгері...
Dialogue: 0,1:02:01.55,1:02:05.76,Default,,0,0,0,,Ол мені жерлеген шығар...
Dialogue: 0,1:02:11.26,1:02:13.31,Default,,0,0,0,,(Найзағай)
Dialogue: 0,1:02:14.68,1:02:16.23,Default,,0,0,0,,Ууууууу!
Dialogue: 0,1:02:16.48,1:02:18.15,Default,,0,0,0,,Уау... Ахх
Dialogue: 0,1:02:20.65,1:02:21.82,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,1:02:28.16,1:02:29.91,Default,,0,0,0,,Мен мұнда отырып ауа оғын атып, оны дәл тигізе алар едім
Dialogue: 0,1:02:36.54,1:02:37.58,Default,,0,0,0,,Гррр…
Dialogue: 0,1:02:40.13,1:02:41.59,Default,,0,0,0,,Тоқта, Маркос!
Dialogue: 0,1:02:41.67,1:02:42.59,Default,,0,0,0,,Тоқта!
Dialogue: 0,1:02:43.50,1:02:45.13,Default,,0,0,0,,Ах...
Dialogue: 0,1:02:46.63,1:02:48.30,Default,,0,0,0,,Доан
Dialogue: 0,1:02:48.38,1:02:50.26,Default,,0,0,0,,Мен сенен күштімін!
Dialogue: 0,1:02:50.34,1:02:52.60,Default,,0,0,0,,Маған мына ақ жігітті берші...
Dialogue: 0,1:02:52.68,1:02:54.52,Default,,0,0,0,,Мен саған тоқтауыңды айтып тұрмын.
Dialogue: 0,1:02:55.64,1:02:56.85,Default,,0,0,0,,(Жедел жүзген қайықтың дыбысы)
Dialogue: 0,1:02:57.27,1:02:59.35,Default,,0,0,0,,Менің маңызды жұмысым бар.
Dialogue: 0,1:03:00.15,1:03:01.61,Default,,0,0,0,,Екеуің үйге қайтыңдар!
Dialogue: 0,1:03:01.69,1:03:03.11,Default,,0,0,0,,-Оның... -Ах...
Dialogue: 0,1:03:03.69,1:03:04.86,Default,,0,0,0,,(Жедел жүзген қайықтың дыбысы)
Dialogue: 0,1:03:05.28,1:03:06.86,Default,,0,0,0,,Ах...
Dialogue: 0,1:03:08.57,1:03:15.24,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,1:04:06.00,1:04:09.26,Default,,0,0,0,,П.Ц.А. жауап бермейді.
Dialogue: 0,1:04:09.34,1:04:10.76,Default,,0,0,0,,Неге! ?
Dialogue: 0,1:04:10.84,1:04:13.05,Default,,0,0,0,,Миновский бөлшектерінің Mi…
Dialogue: 0,1:04:13.14,1:04:14.55,Default,,0,0,0,,Ұстап қалу себебі ме?
Dialogue: 0,1:04:14.64,1:04:16.89,Default,,0,0,0,,Олай емес!
Dialogue: 0,1:04:17.14,1:04:21.14,Default,,0,0,0,,Қарым-қатынасқа біреу кедергі келтіруі мүмкін бе?
Dialogue: 0,1:04:21.39,1:04:23.35,Default,,0,0,0,,Ойламау мүмкін емес!
Dialogue: 0,1:04:23.44,1:04:29.49,Default,,0,0,0,,Біздің әскерилер осы аймақта қалдырған тыңшылар федералды әскердің іздеу әрекеттерін бірнеше рет жеңді.
Dialogue: 0,1:04:29.57,1:04:32.15,Default,,0,0,0,,Егер сіз P.C.A-ны қорғасаңыз...
Dialogue: 0,1:04:32.32,1:04:36.78,Default,,0,0,0,,Сіз бұл адамның диверсант емес екеніне сенімдісіз бе?
Dialogue: 0,1:04:36.87,1:04:38.20,Default,,0,0,0,,Ха!
Dialogue: 0,1:04:38.66,1:04:41.37,Default,,0,0,0,,Маған қамқор болған сен бе? Рақмет…
Dialogue: 0,1:04:41.96,1:04:44.25,Default,,0,0,0,,Іздеу тобын дереу жіберіңіз!
Dialogue: 0,1:04:44.33,1:04:46.38,Default,,0,0,0,,Бізде уақыт жоқ!
Dialogue: 0,1:04:47.84,1:04:50.76,Default,,0,0,0,,P.C.A.-мен байланыс. үзілді.
Dialogue: 0,1:04:51.17,1:04:53.13,Default,,0,0,0,,Диверсант бар сияқты
Dialogue: 0,1:04:53.22,1:04:56.68,Default,,0,0,0,,Бұны жойып, функционалдылықты тез қалпына келтіріңіз
Dialogue: 0,1:04:56.76,1:04:59.77,Default,,0,0,0,,Қолмен жұмыс жасау арқылы өрт! Міне бітті!
Dialogue: 0,1:05:02.48,1:05:06.27,Default,,0,0,0,,Тексеріңіз, бұл қызықсыз! Бұл сұмдық миссия!
Dialogue: 0,1:05:06.56,1:05:08.77,Default,,0,0,0,,Солай ма? Ефрейтор Данан
Dialogue: 0,1:05:08.98,1:05:11.15,Default,,0,0,0,,Егер бөгетші...
Dialogue: 0,1:05:12.49,1:05:13.78,Default,,0,0,0,,Ал егер?
Dialogue: 0,1:05:14.74,1:05:17.45,Default,,0,0,0,,Ал егер? Лейтенант Вальдо
Dialogue: 0,1:05:17.53,1:05:19.08,Default,,0,0,0,,-Аа... -Иә?
Dialogue: 0,1:05:20.95,1:05:23.04,Default,,0,0,0,,Бұл Cucurrus Doan болса ше?
Dialogue: 0,1:05:23.12,1:05:24.29,Default,,0,0,0,,Уф!
Dialogue: 0,1:05:24.37,1:05:25.37,Default,,0,0,0,,Жоқ…
Dialogue: 0,1:05:25.46,1:05:27.04,Default,,0,0,0,,Доан сонда! ?
Dialogue: 0,1:05:27.13,1:05:28.88,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,1:05:28.96,1:05:32.80,Default,,0,0,0,,Күте тұрыңыз, жоқ, бұл мүмкін емес...
Dialogue: 0,1:05:32.88,1:05:34.80,Default,,0,0,0,,...
Dialogue: 0,1:05:35.38,1:05:38.72,Default,,0,0,0,,Доан осында! ? Бұл ең жақсы!
Dialogue: 0,1:05:38.80,1:05:40.60,Default,,0,0,0,,Вахахаха...
Dialogue: 0,1:05:40.68,1:05:41.81,Default,,0,0,0,,Құп-қисынсыз! Мен анық-ақ жоғарыға көтерілдім.
Dialogue: 0,1:05:41.89,1:05:43.31,Default,,0,0,0,,Уф...
Dialogue: 0,1:05:43.39,1:05:45.06,Default,,0,0,0,,Аһ!
Dialogue: 0,1:05:47.10,1:05:48.56,Default,,0,0,0,,Сіз!
Dialogue: 0,1:05:48.81,1:05:51.15,Default,,0,0,0,,Неге сонша ашуланасың!
Dialogue: 0,1:05:52.36,1:05:53.57,Default,,0,0,0,,Қаш, Данан!
Dialogue: 0,1:05:53.99,1:05:55.91,Default,,0,0,0,,Cucurrus Doan дегеніміз не?
Dialogue: 0,1:05:55.99,1:05:58.41,Default,,0,0,0,,А? Сен сатқын!
Dialogue: 0,1:05:59.12,1:06:01.04,Default,,0,0,0,,(Тодороки) Мен сол жігіттен барынша көп нәрсе үйренгім келеді
Dialogue: 0,1:06:01.83,1:06:05.00,Default,,0,0,0,,Доан... бар ма?
Dialogue: 0,1:06:05.92,1:06:07.33,Default,,0,0,0,,Хмм...
Dialogue: 0,1:06:10.42,1:06:11.67,Default,,0,0,0,,Сәлем! Уф...
Dialogue: 0,1:06:11.75,1:06:13.26,Default,,0,0,0,,Төмен қарама!
Dialogue: 0,1:06:13.96,1:06:15.88,Default,,0,0,0,,Сіз жақындап қалдыңыз, сондықтан бар күшіңізді салыңыз!
Dialogue: 0,1:06:15.97,1:06:19.64,Default,,0,0,0,,Сіз осы жерденсіз бе?
Dialogue: 0,1:06:22.18,1:06:23.64,Default,,0,0,0,,Хмм...
Dialogue: 0,1:06:24.35,1:06:26.64,Default,,0,0,0,,-Хаа ха... -Аа
Dialogue: 0,1:06:28.73,1:06:33.15,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,1:06:33.69,1:06:36.78,Default,,0,0,0,,Бұл қауіпті. Тезірек үйге қайтайық.
Dialogue: 0,1:06:43.41,1:06:45.66,Default,,0,0,0,,Белдік ілгегі орнатылған!
Dialogue: 0,1:06:46.21,1:06:48.42,Default,,0,0,0,,Жарылыс болтының қауіпсіздігін растау
Dialogue: 0,1:06:48.87,1:06:50.46,Default,,0,0,0,,Қозғалтқышты іске қосу
Dialogue: 0,1:06:55.09,1:06:57.68,Default,,0,0,0,,Менің орныма корреспондент бола аласыз ба?
Dialogue: 0,1:06:57.97,1:07:00.01,Default,,0,0,0,,А? иә
Dialogue: 0,1:07:01.64,1:07:03.89,Default,,0,0,0,,О, қай жолмен?
Dialogue: 0,1:07:05.27,1:07:06.68,Default,,0,0,0,,Уху…
Dialogue: 0,1:07:08.23,1:07:09.69,Default,,0,0,0,,Уху…
Dialogue: 0,1:07:16.28,1:07:18.40,Default,,0,0,0,,Гунперри ұшыру!
Dialogue: 0,1:07:25.79,1:07:28.71,Default,,0,0,0,,-Уау! -Сәлеметсіз бе гало гало гало...
Dialogue: 0,1:07:35.42,1:07:38.72,Default,,0,0,0,,Капитан, штабтан хабар келе жатыр.
Dialogue: 0,1:07:38.92,1:07:40.13,Default,,0,0,0,,Бұрылыс
Dialogue: 0,1:07:43.14,1:07:45.72,Default,,0,0,0,,Тез арада жүзіңіз, капитан Брайт!
Dialogue: 0,1:07:46.02,1:07:49.44,Default,,0,0,0,,Мәртебелі Ревилл сізді Белфастта күтуде!
Dialogue: 0,1:07:50.48,1:07:52.19,Default,,0,0,0,,Генерал Ревилль?
Dialogue: 0,1:07:52.27,1:07:53.73,Default,,0,0,0,,Иә!
Dialogue: 0,1:07:53.81,1:07:57.23,Default,,0,0,0,,Түсіндім... Бұл солай ма?
Dialogue: 0,1:07:57.32,1:07:59.20,Default,,0,0,0,,Енді ше? капитан
Dialogue: 0,1:07:59.28,1:08:00.95,Default,,0,0,0,,Жоқ Иә
Dialogue: 0,1:08:01.57,1:08:03.95,Default,,0,0,0,,Желкені дереу жіберіңіз
Dialogue: 0,1:08:04.83,1:08:07.70,Default,,0,0,0,,･
Dialogue: 0,1:08:08.00,1:08:09.41,Default,,0,0,0,,Ұшқыш туралы не деуге болады?
Dialogue: 0,1:08:09.50,1:08:10.83,Default,,0,0,0,,Әзірге ұшқыш жоқ! ?
Dialogue: 0,1:08:10.92,1:08:12.58,Default,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,1:08:13.21,1:08:14.59,Default,,0,0,0,,Сайла! ?
Dialogue: 0,1:08:15.50,1:08:17.59,Default,,0,0,0,,Бортта лейтенант Слеггер емес пе?
Dialogue: 0,1:08:18.01,1:08:20.59,Default,,0,0,0,,...
Dialogue: 0,1:08:21.30,1:08:22.76,Default,,0,0,0,,Міне
Dialogue: 0,1:08:24.68,1:08:27.18,Default,,0,0,0,,Бұзық қылма
Dialogue: 0,1:08:32.85,1:08:34.77,Default,,0,0,0,,Сіз кешігіп қалдыңыз, капитан!
Dialogue: 0,1:08:34.86,1:08:36.11,Default,,0,0,0,,Қанша уақыт...
Dialogue: 0,1:08:36.98,1:08:38.78,Default,,0,0,0,,Ах! Не?
Dialogue: 0,1:08:39.15,1:08:40.40,Default,,0,0,0,,Не!
Dialogue: 0,1:08:40.49,1:08:41.49,Default,,0,0,0,,...
Dialogue: 0,1:08:41.57,1:08:43.36,Default,,0,0,0,,Не? иә!
Dialogue: 0,1:08:43.61,1:08:46.62,Default,,0,0,0,,...
Dialogue: 0,1:08:46.70,1:08:48.99,Default,,0,0,0,,Жоқ...
Dialogue: 0,1:08:49.08,1:08:50.12,Default,,0,0,0,,Иә?
Dialogue: 0,1:08:59.42,1:09:02.26,Default,,0,0,0,,Тексеру Асығыңыз, уақыт жоқ!
Dialogue: 0,1:09:02.34,1:09:04.64,Default,,0,0,0,,ＣＩＣ
Dialogue: 0,1:09:04.72,1:09:06.55,Default,,0,0,0,,Кеш басталады!
Dialogue: 0,1:09:07.76,1:09:11.31,Default,,0,0,0,,...
Dialogue: 0,1:09:11.56,1:09:13.77,Default,,0,0,0,,...
Dialogue: 0,1:09:16.15,1:09:18.98,Default,,0,0,0,,Не? Синхронды қозғалтқышы да нашар ма?
Dialogue: 0,1:09:19.07,1:09:20.53,Default,,0,0,0,,Сіз қалай ойлайсыз? Мирай
Dialogue: 0,1:09:21.69,1:09:23.20,Default,,0,0,0,,Уху…
Dialogue: 0,1:09:23.28,1:09:24.53,Default,,0,0,0,,Хмм.
Dialogue: 0,1:09:24.99,1:09:26.03,Default,,0,0,0,,Фу…
Dialogue: 0,1:09:26.32,1:09:29.03,Default,,0,0,0,,～
Dialogue: 0,1:09:29.12,1:09:30.95,Default,,0,0,0,,Бұл дегеніміз
Dialogue: 0,1:09:31.04,1:09:34.54,Default,,0,0,0,,...
Dialogue: 0,1:09:34.62,1:09:36.25,Default,,0,0,0,,Иә! ? Ах...
Dialogue: 0,1:09:39.75,1:09:40.80,Default,,0,0,0,,Хаа…
Dialogue: 0,1:09:41.26,1:09:42.30,Default,,0,0,0,,Дұрыс. Соның арқасында мен ұтылдым.
Dialogue: 0,1:09:42.92,1:09:44.30,Default,,0,0,0,,Не?
Dialogue: 0,1:09:44.59,1:09:46.80,Default,,0,0,0,,Жоқ, олай емес...
Dialogue: 0,1:09:46.89,1:09:48.30,Default,,0,0,0,,Капитан!
Dialogue: 0,1:09:48.51,1:09:50.93,Default,,0,0,0,,...
Dialogue: 0,1:09:51.02,1:09:52.06,Default,,0,0,0,,Жақындау!
Dialogue: 0,1:09:52.31,1:09:53.52,Default,,0,0,0,,(Каори) Жоқ, бірақ... (Косей) Ақыл-жастарың ұқсас болғандықтан ба?
Dialogue: 0,1:09:54.73,1:09:56.40,Default,,0,0,0,,Семіз ағай...?
Dialogue: 0,1:09:56.48,1:09:58.06,Default,,0,0,0,,…
Dialogue: 0,1:09:58.36,1:09:59.57,Default,,0,0,0,,...
Dialogue: 0,1:10:00.19,1:10:02.03,Default,,0,0,0,,Канар аралдарына қарай!
Dialogue: 0,1:10:02.11,1:10:04.19,Default,,0,0,0,,Мүмкін Алегранца аралына бара жатырмын.
Dialogue: 0,1:10:04.28,1:10:05.32,Default,,0,0,0,,Ха!
Dialogue: 0,1:10:06.36,1:10:08.82,Default,,0,0,0,,Куууу…
Dialogue: 0,1:10:16.17,1:10:19.42,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,1:10:22.46,1:10:24.22,Default,,0,0,0,,(Ер адам) Қатты кісі келе жатыр! (Әйел) Көмектесіңіз! Мені өлтірмекші!
Dialogue: 0,1:10:28.26,1:10:29.80,Default,,0,0,0,,(Вампирлердің соғыс айғайы)
Dialogue: 0,1:10:29.89,1:10:30.80,Default,,0,0,0,,Қорқынышты...
Dialogue: 0,1:10:31.93,1:10:33.31,Default,,0,0,0,,(Найзағай)
Dialogue: 0,1:10:33.85,1:10:36.31,Default,,0,0,0,,...
Dialogue: 0,1:10:37.10,1:10:39.81,Default,,0,0,0,,Менің туған күнім болса да~
Dialogue: 0,1:10:41.07,1:10:43.82,Default,,0,0,0,,Мен оны жек көремін!
Dialogue: 0,1:10:43.90,1:10:47.20,Default,,0,0,0,,Қараңғы! Бұл қорқынышты!
Dialogue: 0,1:10:47.91,1:10:50.70,Default,,0,0,0,,Жарайды, жарайды, жарайды~
Dialogue: 0,1:10:51.37,1:10:53.70,Default,,0,0,0,,(Аданың айқайы)
Dialogue: 0,1:10:54.37,1:10:56.58,Default,,0,0,0,,...
Dialogue: 0,1:10:56.96,1:10:59.50,Default,,0,0,0,,...
Dialogue: 0,1:11:03.42,1:11:04.59,Default,,0,0,0,,Ум...
Dialogue: 0,1:11:05.09,1:11:06.09,Default,,0,0,0,,Не! ?
Dialogue: 0,1:11:06.55,1:11:08.47,Default,,0,0,0,,Бұл электр энергиясы қайдан келеді?
Dialogue: 0,1:11:08.55,1:11:11.10,Default,,0,0,0,,…
Dialogue: 0,1:11:11.43,1:11:13.35,Default,,0,0,0,,Амадо! Маған көрсет!
Dialogue: 0,1:11:13.76,1:11:15.43,Default,,0,0,0,,Міне.
Dialogue: 0,1:11:15.52,1:11:16.56,Default,,0,0,0,,Қараңыз
Dialogue: 0,1:11:16.64,1:11:18.60,Default,,0,0,0,,Иә?
Dialogue: 0,1:11:18.98,1:11:20.10,Default,,0,0,0,,Иә?
Dialogue: 0,1:11:22.40,1:11:23.86,Default,,0,0,0,,Батарея қайда?
Dialogue: 0,1:11:23.94,1:11:25.69,Default,,0,0,0,,Батарея?
Dialogue: 0,1:11:26.90,1:11:28.24,Default,,0,0,0,,Қойма туралы не деуге болады?
Dialogue: 0,1:11:28.32,1:11:29.70,Default,,0,0,0,,Баспалдақтың астында!
Dialogue: 0,1:11:29.78,1:11:33.20,Default,,0,0,0,,Бірақ рұқсатсыз кіруге болмайды.
Dialogue: 0,1:11:39.29,1:11:40.75,Default,,0,0,0,,Міне болды!
Dialogue: 0,1:11:41.50,1:11:43.21,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,1:11:45.09,1:11:46.21,Default,,0,0,0,,Ах
Dialogue: 0,1:11:46.80,1:11:49.26,Default,,0,0,0,,А, электр жарығы қосылды!
Dialogue: 0,1:11:50.63,1:11:51.68,Default,,0,0,0,,Ах~
Dialogue: 0,1:11:51.76,1:11:53.35,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,1:11:53.85,1:11:57.02,Default,,0,0,0,,Ол батареяны жөндеді!
Dialogue: 0,1:12:02.06,1:12:04.82,Default,,0,0,0,,Сіз мұны түзеттіңіз бе?
Dialogue: 0,1:12:04.90,1:12:07.23,Default,,0,0,0,,Мен оны жөндедім деп ойлаймын...
Dialogue: 0,1:12:08.15,1:12:11.07,Default,,0,0,0,,Менің ойымша, бұл маякты жарқырататын шығар.
Dialogue: 0,1:12:11.45,1:12:12.82,Default,,0,0,0,,Не!
Dialogue: 0,1:12:13.70,1:12:15.83,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:12:21.87,1:12:24.63,Default,,0,0,0,,Мен сенімдімін...
Dialogue: 0,1:12:26.71,1:12:30.26,Default,,0,0,0,,(жұмыс дыбысы)
Dialogue: 0,1:12:30.34,1:12:31.93,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,1:12:38.72,1:12:40.64,Default,,0,0,0,,Иә!
Dialogue: 0,1:12:48.86,1:12:49.90,Default,,0,0,0,,Ах...
Dialogue: 0,1:12:53.61,1:12:55.12,Default,,0,0,0,,Ақымақ!
Dialogue: 0,1:12:55.87,1:12:58.24,Default,,0,0,0,,Иә! Электр жарығы қосылды!
Dialogue: 0,1:12:58.33,1:13:00.25,Default,,0,0,0,,Енді тоңазытқышты пайдалануға болады!
Dialogue: 0,1:13:00.33,1:13:02.83,Default,,0,0,0,,Балмұздақ жасауға болады!
Dialogue: 0,1:13:02.92,1:13:05.33,Default,,0,0,0,,Қараңдар! Маяк та келді!
Dialogue: 0,1:13:05.42,1:13:06.84,Default,,0,0,0,,Эх!
Dialogue: 0,1:13:11.17,1:13:13.01,Default,,0,0,0,,-(Бала) Уау~ -(Бала) Керемет!
Dialogue: 0,1:13:14.72,1:13:16.68,Default,,0,0,0,,- (Бала) Уау! Бұл керемет! -(Бала) Керемет!
Dialogue: 0,1:13:17.60,1:13:18.97,Default,,0,0,0,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,1:13:19.68,1:13:21.18,Default,,0,0,0,,Иә?Ах...
Dialogue: 0,1:13:22.35,1:13:23.98,Default,,0,0,0,,Рақмет.
Dialogue: 0,1:13:24.35,1:13:25.85,Default,,0,0,0,,Ах...
Dialogue: 0,1:13:29.15,1:13:30.19,Default,,0,0,0,,Иә
Dialogue: 0,1:13:30.40,1:13:32.11,Default,,0,0,0,,Әй, Доан!
Dialogue: 0,1:13:32.19,1:13:33.86,Default,,0,0,0,,Доан қайтып келді!
Dialogue: 0,1:13:33.95,1:13:35.53,Default,,0,0,0,,Доаан!
Dialogue: 0,1:13:35.61,1:13:38.41,Default,,0,0,0,,Бум! Амуро электр жарығын жөндеді!
Dialogue: 0,1:13:38.49,1:13:40.20,Default,,0,0,0,,Маякты да жөндедім.
Dialogue: 0,1:13:41.33,1:13:43.79,Default,,0,0,0,,Амуро керемет, Доан!
Dialogue: 0,1:13:48.84,1:13:50.21,Default,,0,0,0,,- Иә? -Аа...
Dialogue: 0,1:13:51.05,1:13:52.84,Default,,0,0,0,,Қосымша заттар!
Dialogue: 0,1:13:52.92,1:13:54.26,Default,,0,0,0,,Иә?
Dialogue: 0,1:13:56.39,1:13:58.76,Default,,0,0,0,,Бұл не? (Ұшу дыбысы)
Dialogue: 0,1:13:59.05,1:14:00.01,Default,,0,0,0,,Гунпери!
Dialogue: 0,1:14:00.26,1:14:01.31,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,1:14:01.39,1:14:03.39,Default,,0,0,0,,Эй, эй, бұл не?
Dialogue: 0,1:14:03.48,1:14:04.35,Default,,0,0,0,,-Бұл маяк -Әдемі.
Dialogue: 0,1:14:04.35,1:14:06.65,Default,,0,0,0,,-Бұл маяк -Әдемі.
Dialogue: 0,1:14:04.35,1:14:06.65,Default,,0,0,0,,Гало гало гало...
Dialogue: 0,1:14:06.90,1:14:08.73,Default,,0,0,0,,Кай-сан, бар!
Dialogue: 0,1:14:08.81,1:14:10.65,Default,,0,0,0,,Келесі жолы мен сізге еремін!
Dialogue: 0,1:14:10.73,1:14:12.03,Default,,0,0,0,,Біз қонуға барамыз.
Dialogue: 0,1:14:12.11,1:14:13.74,Default,,0,0,0,,Тақтаға отырыңыз және күтіңіз!
Dialogue: 0,1:14:14.61,1:14:16.66,Default,,0,0,0,,- (Бала) Уау - (Бала) Кя
Dialogue: 0,1:14:19.53,1:14:21.20,Default,,0,0,0,,Бұл тағы да бұрынғы күн!
Dialogue: 0,1:14:21.29,1:14:22.16,Default,,0,0,0,,Бум!
Dialogue: 0,1:14:22.24,1:14:23.54,Default,,0,0,0,,Оны жең!
Dialogue: 0,1:14:24.04,1:14:26.12,Default,,0,0,0,,Мен сені іздеп келдім бе?
Dialogue: 0,1:14:26.21,1:14:28.46,Default,,0,0,0,,Әдемі достық
Dialogue: 0,1:14:28.54,1:14:29.54,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:14:31.00,1:14:32.88,Default,,0,0,0,,Жою!
Dialogue: 0,1:14:33.30,1:14:36.01,Default,,0,0,0,,(Ұшу дыбысы)
Dialogue: 0,1:14:36.63,1:14:38.51,Default,,0,0,0,,Хмм... Ах!
Dialogue: 0,1:14:41.39,1:14:42.22,Default,,0,0,0,,Ха…
Dialogue: 0,1:14:48.15,1:14:50.19,Default,,0,0,0,,Оңтүстік крест…
Dialogue: 0,1:14:51.15,1:14:54.11,Default,,0,0,0,,Біз бұрынғыдан қашып құтыла аламыз ба?
Dialogue: 0,1:14:54.69,1:14:57.91,Default,,0,0,0,,Егер біз оны шешпесек...
Dialogue: 0,1:14:58.20,1:14:59.24,Default,,0,0,0,,Маркос!
Dialogue: 0,1:14:59.32,1:15:00.49,Default,,0,0,0,,Ах...
Dialogue: 0,1:15:00.95,1:15:02.41,Default,,0,0,0,,Менімен бірге жүр
Dialogue: 0,1:15:02.49,1:15:04.50,Default,,0,0,0,,- Иә! -(Карла) Доан!
Dialogue: 0,1:15:09.37,1:15:12.50,Default,,0,0,0,,Қара, мен балаларды сұрайын.
Dialogue: 0,1:15:15.59,1:15:19.18,Default,,0,0,0,,Лопе Ештеңеден қорқудың қажеті жоқ.
Dialogue: 0,1:15:20.09,1:15:21.26,Default,,0,0,0,,Матео
Dialogue: 0,1:15:21.76,1:15:24.52,Default,,0,0,0,,Бланкаға жақсы көңіл бөл.
Dialogue: 0,1:15:25.52,1:15:26.77,Default,,0,0,0,,Иә
Dialogue: 0,1:15:28.02,1:15:30.52,Default,,0,0,0,,Жарайды, мен барамын.
Dialogue: 0,1:15:31.27,1:15:32.56,Default,,0,0,0,,Мен де барамын!
Dialogue: 0,1:15:32.65,1:15:33.94,Default,,0,0,0,,Иә?
Dialogue: 0,1:15:40.49,1:15:44.16,Default,,0,0,0,,Сіз бұл балалар үшін күресе аласыз ба?
Dialogue: 0,1:15:44.66,1:15:45.99,Default,,0,0,0,,Иә
Dialogue: 0,1:15:47.16,1:15:49.16,Default,,0,0,0,,Достарыңызбен?
Dialogue: 0,1:15:49.25,1:15:50.62,Default,,0,0,0,,Ах...
Dialogue: 0,1:15:52.17,1:15:53.50,Default,,0,0,0,,Фу…
Dialogue: 0,1:15:59.30,1:16:01.26,Default,,0,0,0,,Кай-сан! Бұл Зеон!
Dialogue: 0,1:16:01.34,1:16:05.18,Default,,0,0,0,,Тәтті, бұл шынында да қауіпті оқиға!
Dialogue: 0,1:16:08.27,1:16:11.02,Default,,0,0,0,,Хэхехехе... Федералдық әскерлер?
Dialogue: 0,1:16:11.35,1:16:13.23,Default,,0,0,0,,Мен бұл жігіттерді өлтіремін.
Dialogue: 0,1:16:13.31,1:16:15.94,Default,,0,0,0,,Уолд пен Сангхо арнайы тапсырмаға барады!
Dialogue: 0,1:16:16.02,1:16:17.03,Default,,0,0,0,,Польнарефф?
Dialogue: 0,1:16:31.50,1:16:32.54,Default,,0,0,0,,Ах
Dialogue: 0,1:16:33.63,1:16:35.34,Default,,0,0,0,,...
Dialogue: 0,1:16:38.26,1:16:39.84,Default,,0,0,0,,Лейтенант-сан, бар!
Dialogue: 0,1:16:41.59,1:16:42.93,Default,,0,0,0,,Не?
Dialogue: 0,1:16:43.30,1:16:44.68,Default,,0,0,0,,Ругун! ?
Dialogue: 0,1:16:45.68,1:16:46.93,Default,,0,0,0,,Оны атып тастаңыз!
Dialogue: 0,1:16:47.26,1:16:48.72,Default,,0,0,0,,Жарайды, міне келдік!
Dialogue: 0,1:16:52.85,1:16:53.94,Default,,0,0,0,,Уау!
Dialogue: 0,1:16:54.02,1:16:56.44,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,1:16:56.65,1:16:58.44,Default,,0,0,0,,Жақсы көздеңіз, лейтенант!
Dialogue: 0,1:16:58.69,1:17:00.19,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,1:17:05.45,1:17:06.99,Default,,0,0,0,,Санг-хо, секірейік!
Dialogue: 0,1:17:07.08,1:17:07.91,Default,,0,0,0,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,1:17:07.99,1:17:11.08,Default,,0,0,0,,Су тайыз, жағада жүруге болады.
Dialogue: 0,1:17:12.87,1:17:14.21,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,1:17:20.21,1:17:21.34,Default,,0,0,0,,Ах!
Dialogue: 0,1:17:23.93,1:17:25.30,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:17:27.47,1:17:28.85,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:17:35.40,1:17:36.90,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:17:41.53,1:17:42.57,Default,,0,0,0,,Эй
Dialogue: 0,1:17:42.65,1:17:43.57,Default,,0,0,0,,Иә?
Dialogue: 0,1:17:44.15,1:17:46.16,Default,,0,0,0,,Сіз жүзе аласыз, солай ма?
Dialogue: 0,1:17:46.24,1:17:50.58,Default,,0,0,0,,Жартастың астына сүңгу. Бұл аздап ауырады.
Dialogue: 0,1:17:51.29,1:17:52.58,Default,,0,0,0,,Иә
Dialogue: 0,1:18:14.14,1:18:15.27,Default,,0,0,0,,Пу...
Dialogue: 0,1:18:15.77,1:18:17.27,Default,,0,0,0,,Хмм...
Dialogue: 0,1:18:22.61,1:18:23.78,Default,,0,0,0,,Буха…
Dialogue: 0,1:18:25.65,1:18:27.24,Default,,0,0,0,,Ха!
Dialogue: 0,1:18:31.87,1:18:34.79,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:18:36.87,1:18:39.79,Default,,0,0,0,,Уау... бұл үлкен мәселе.
Dialogue: 0,1:18:39.88,1:18:42.17,Default,,0,0,0,,Уф, мен мұны бәрібір істеуім керек!
Dialogue: 0,1:18:42.84,1:18:44.17,Default,,0,0,0,,- Бұл жерде қауіпті! -Сәлеметсіз бе
Dialogue: 0,1:18:44.26,1:18:45.17,Default,,0,0,0,,Түсіңіз!
Dialogue: 0,1:18:45.26,1:18:47.22,Default,,0,0,0,,-Асығыңыз! Асығыңыз! -Сәлеметсіз бе
Dialogue: 0,1:18:50.01,1:18:51.43,Default,,0,0,0,,Эй
Dialogue: 0,1:18:51.51,1:18:53.43,Default,,0,0,0,,Мықты болыңыз!
Dialogue: 0,1:18:53.52,1:18:55.39,Default,,0,0,0,,Оян
Dialogue: 0,1:18:55.48,1:18:56.73,Default,,0,0,0,,Эй!
Dialogue: 0,1:18:56.81,1:18:58.69,Default,,0,0,0,,Ах...
Dialogue: 0,1:19:04.69,1:19:06.11,Default,,0,0,0,,Ах...
Dialogue: 0,1:19:27.09,1:19:28.68,Default,,0,0,0,,Қақпақ, соға алмайсың!
Dialogue: 0,1:19:28.76,1:19:30.68,Default,,0,0,0,,Дегенмен, патшаңыздың қазір есінен адасқаны анық.
Dialogue: 0,1:19:31.47,1:19:33.47,Default,,0,0,0,,Хайахахаха!
Dialogue: 0,1:19:39.14,1:19:40.52,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:19:41.06,1:19:42.81,Default,,0,0,0,,Бір мүйізбен осындай күш.
Dialogue: 0,1:19:42.90,1:19:43.73,Default,,0,0,0,,Ах!
Dialogue: 0,1:19:46.03,1:19:48.49,Default,,0,0,0,,Мен сізді күттім, лейтенант!
Dialogue: 0,1:19:48.57,1:19:50.28,Default,,0,0,0,,Біз шұғыл қонуға бара жатырмыз!
Dialogue: 0,1:19:50.36,1:19:51.62,Default,,0,0,0,,Иә? Шынайы ма?
Dialogue: 0,1:19:52.28,1:19:55.41,Default,,0,0,0,,Сіз әуе шайқасында бұрын соққы алған сияқтысыз.
Dialogue: 0,1:19:56.08,1:19:58.04,Default,,0,0,0,,Соққыдан қорғау!
Dialogue: 0,1:20:11.09,1:20:13.01,Default,,0,0,0,,Куаааааааааааааааааааааааааааааааа...
Dialogue: 0,1:20:13.72,1:20:16.43,Default,,0,0,0,,Ойын осында аяқталады!
Dialogue: 0,1:20:17.72,1:20:18.56,Default,,0,0,0,,Ура
Dialogue: 0,1:20:18.64,1:20:20.10,Default,,0,0,0,,Уау!
Dialogue: 0,1:20:20.19,1:20:22.77,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:20:24.48,1:20:25.69,Default,,0,0,0,,Уау!
Dialogue: 0,1:20:25.98,1:20:26.94,Default,,0,0,0,,Хаято!
Dialogue: 0,1:20:28.28,1:20:29.61,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,1:20:34.28,1:20:35.20,Default,,0,0,0,,Кай-сан!
Dialogue: 0,1:20:35.45,1:20:36.45,Default,,0,0,0,,Кай!
Dialogue: 0,1:20:36.54,1:20:38.54,Default,,0,0,0,,Жарайды!
Dialogue: 0,1:20:38.62,1:20:39.96,Default,,0,0,0,,Иә?
Dialogue: 0,1:20:40.04,1:20:41.21,Default,,0,0,0,,Хмм...
Dialogue: 0,1:20:42.67,1:20:43.71,Default,,0,0,0,,Хмм…
Dialogue: 0,1:20:46.29,1:20:47.21,Default,,0,0,0,,Уф
Dialogue: 0,1:20:53.89,1:20:56.72,Default,,0,0,0,,
Dialogue: 0,1:20:56.81,1:20:58.60,Default,,0,0,0,,Ах...
Dialogue: 0,1:20:59.52,1:21:00.73,Default,,0,0,0,,Хааахх
Dialogue: 0,1:21:03.90,1:21:06.52,Default,,0,0,0,,
Dialogue: 0,1:21:15.16,1:21:16.53,Default,,0,0,0,,Ах...
Dialogue: 0,1:21:16.95,1:21:19.29,Default,,0,0,0,,А, а, а...
Dialogue: 0,1:21:26.08,1:21:27.09,Default,,0,0,0,,Сержант Сангхо
Dialogue: 0,1:21:27.38,1:21:29.80,Default,,0,0,0,,Мен арнайы тапсырманы орындаймын.
Dialogue: 0,1:21:29.88,1:21:31.63,Default,,0,0,0,,Мына жерден қарау керек.
Dialogue: 0,1:21:31.72,1:21:32.59,Default,,0,0,0,,Түсінікті
Dialogue: 0,1:21:32.67,1:21:34.34,Default,,0,0,0,,(люктің ашылған дыбысы)
Dialogue: 0,1:21:52.15,1:21:53.49,Default,,0,0,0,,Жоқ! ?
Dialogue: 0,1:21:53.70,1:21:54.99,Default,,0,0,0,,Мен – Шығыс Одақтың Элькияға тағайындаған екінші елшісі Ино Хацусе.
Dialogue: 0,1:21:55.07,1:21:56.82,Default,,0,0,0,,Ах, а...
Dialogue: 0,1:21:57.62,1:21:58.87,Default,,0,0,0,,Хмм...
Dialogue: 0,1:21:59.58,1:22:01.04,Default,,0,0,0,,Шығу
Dialogue: 0,1:22:01.49,1:22:03.25,Default,,0,0,0,,Не?
Dialogue: 0,1:22:04.37,1:22:07.75,Default,,0,0,0,,Мен сенімен ұрысқым келмейді
Dialogue: 0,1:22:08.59,1:22:10.92,Default,,0,0,0,,Қозаке, сатқын!
Dialogue: 0,1:22:11.00,1:22:14.13,Default,,0,0,0,,Тірі екеніңізге қуаныштымын, Доан.
Dialogue: 0,1:22:14.22,1:22:17.51,Default,,0,0,0,,Осы қолдармен мен сіздің тыныс алуыңызды тоқтата аламын.
Dialogue: 0,1:22:17.59,1:22:18.68,Default,,0,0,0,,Доан?
Dialogue: 0,1:22:18.76,1:22:20.22,Default,,0,0,0,,Кукурус Доан! ?
Dialogue: 0,1:22:20.31,1:22:22.47,Default,,0,0,0,,Әй, шын!
Dialogue: 0,1:22:22.56,1:22:25.39,Default,,0,0,0,,Мен мұндай жерде кездесеміз деп ойламаппын.
Dialogue: 0,1:22:26.77,1:22:29.15,Default,,0,0,0,,Маған қашып кетейін бе?
Dialogue: 0,1:22:31.73,1:22:35.90,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:22:36.24,1:22:37.86,Default,,0,0,0,,Керемет
Dialogue: 0,1:22:37.95,1:22:40.41,Default,,0,0,0,,Сіз ұтқырлығы жоғары Закумен бәсекелесе аласыз ба?
Dialogue: 0,1:22:43.12,1:22:45.54,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:22:48.50,1:22:50.17,Default,,0,0,0,,Идиот! Дананг!
Dialogue: 0,1:22:53.42,1:22:56.59,Default,,0,0,0,,Мен қазір Доанмен күресіп жатырмын!
Dialogue: 0,1:22:56.68,1:22:59.09,Default,,0,0,0,,Сол Кукурлус Доанмен!
Dialogue: 0,1:22:59.59,1:23:00.72,Default,,0,0,0,,Онда неге сол тікұшақ келді?
Dialogue: 0,1:23:06.39,1:23:07.44,Default,,0,0,0,,Уф...
Dialogue: 0,1:23:07.52,1:23:09.35,Default,,0,0,0,,Ха, күшті бол!
Dialogue: 0,1:23:09.44,1:23:11.31,Default,,0,0,0,,Мен мұны істеймін деп ойлаймын!
Dialogue: 0,1:23:24.41,1:23:25.58,Default,,0,0,0,,Хмм...
Dialogue: 0,1:23:25.66,1:23:26.58,Default,,0,0,0,,Деяаааххх
Dialogue: 0,1:23:33.80,1:23:36.80,Default,,0,0,0,,Сіз ең жақсысыз.
Dialogue: 0,1:23:36.88,1:23:39.80,Default,,0,0,0,,Кукуррус Доан
Dialogue: 0,1:23:40.84,1:23:45.35,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:23:45.43,1:23:49.85,Default,,0,0,0,,Функционалдылықты дереу қалпына келтіріңіз және қолмен өрттендіріңіз!
Dialogue: 0,1:23:56.78,1:23:59.15,Default,,0,0,0,,(Изуку) Мен үшін ұпайлар аса маңызды емес. (Оқушы) Жоғары ондықтағы біреу…
Dialogue: 0,1:23:59.95,1:24:05.12,Default,,0,0,0,,(Дабыл дыбысы)
Dialogue: 0,1:24:05.99,1:24:09.25,Default,,0,0,0,,Ия, тапсырма орындалды.
Dialogue: 0,1:24:27.14,1:24:30.31,Default,,0,0,0,,Хмм... Сіз кешігіп қалдыңыз, лейтенант-доно...
Dialogue: 0,1:24:33.35,1:24:34.86,Default,,0,0,0,,-Мм... -Иә
Dialogue: 0,1:24:38.57,1:24:39.57,Default,,0,0,0,,Иә?
Dialogue: 0,1:24:40.74,1:24:41.91,Default,,0,0,0,,Әй?
Dialogue: 0,1:24:42.16,1:24:43.66,Default,,0,0,0,,Қазір мен ваннада шомылып жатырмын, шамамен 30 минуттан кейін бар.
Dialogue: 0,1:24:44.07,1:24:47.49,Default,,0,0,0,,Мұнда тіпті үлкен егеуқұйрықтар бар ма?
Dialogue: 0,1:24:59.76,1:25:02.76,Default,,0,0,0,,Мұздатқыш балмұздақ жақсы-ақ, бірақ бұл да дәмді.
Dialogue: 0,1:25:10.48,1:25:12.35,Default,,0,0,0,,Иә? Хмм...
Dialogue: 0,1:25:14.48,1:25:16.06,Default,,0,0,0,,Хмм...
Dialogue: 0,1:25:21.44,1:25:22.78,Default,,0,0,0,,Уф...
Dialogue: 0,1:25:26.16,1:25:27.53,Default,,0,0,0,,Ах...
Dialogue: 0,1:25:31.62,1:25:33.16,Default,,0,0,0,,Ха…
Dialogue: 0,1:25:34.08,1:25:35.42,Default,,0,0,0,,Ах...
Dialogue: 0,1:25:42.26,1:25:43.55,Default,,0,0,0,,Уау!
Dialogue: 0,1:25:52.48,1:25:53.77,Default,,0,0,0,,Уау
Dialogue: 0,1:25:57.06,1:25:58.48,Default,,0,0,0,,Бұл не? Сен... неге мені қуалап жүрсің?
Dialogue: 0,1:26:03.57,1:26:06.41,Default,,0,0,0,,Ах, а...
Dialogue: 0,1:26:15.58,1:26:18.46,Default,,0,0,0,,(Китамура) Жарайды, Сатору, енді уақыты келген сияқты.
Dialogue: 0,1:26:18.54,1:26:20.50,Default,,0,0,0,,Неге тағы ұйықтап қалмақсың!
Dialogue: 0,1:26:21.00,1:26:22.42,Default,,0,0,0,,Қандай дыбыс! ?
Dialogue: 0,1:26:23.46,1:26:24.51,Default,,0,0,0,,Ах...
Dialogue: 0,1:26:29.26,1:26:31.39,Default,,0,0,0,,Уф...
Dialogue: 0,1:26:42.03,1:26:43.57,Default,,0,0,0,,Ах...
Dialogue: 0,1:26:43.65,1:26:45.19,Default,,0,0,0,,Хмм...
Dialogue: 0,1:26:45.28,1:26:48.07,Default,,0,0,0,,Уф-а-а-а-а-а!
Dialogue: 0,1:26:49.70,1:26:52.16,Default,,0,0,0,,Уф...
Dialogue: 0,1:26:52.66,1:26:54.45,Default,,0,0,0,,Ах...
Dialogue: 0,1:26:54.54,1:26:56.46,Default,,0,0,0,,(Дабыл дыбысы)
Dialogue: 0,1:27:11.26,1:27:14.97,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,1:27:35.75,1:27:37.21,Default,,0,0,0,,Доан…
Dialogue: 0,1:27:42.67,1:27:44.17,Default,,0,0,0,,Неліктен?
Dialogue: 0,1:27:45.96,1:27:47.09,Default,,0,0,0,,Хмм...
Dialogue: 0,1:27:54.10,1:27:56.56,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:27:59.60,1:28:01.65,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:28:01.73,1:28:03.90,Default,,0,0,0,,Менің кезегім!
Dialogue: 0,1:28:03.98,1:28:06.36,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:28:06.99,1:28:08.90,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:28:09.65,1:28:11.91,Default,,0,0,0,,-Жоқ~ -(Гепард) Қорқынышты~
Dialogue: 0,1:28:12.20,1:28:14.91,Default,,0,0,0,,Барлығына! Жертөлеге жүгір!
Dialogue: 0,1:28:15.24,1:28:16.41,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,1:28:16.49,1:28:18.12,Default,,0,0,0,,Не ойнап жүрсің осылайша кішкентай баланы таптап!
Dialogue: 0,1:28:18.50,1:28:19.91,Default,,0,0,0,,Хисера өтінемін
Dialogue: 0,1:28:20.21,1:28:21.92,Default,,0,0,0,,-Асығыңыз, асығыңыз! -Осылай, асығыңыз.
Dialogue: 0,1:28:22.29,1:28:24.42,Default,,0,0,0,,- Дүрбелең емес! -Йо
Dialogue: 0,1:28:25.00,1:28:26.17,Default,,0,0,0,,(Ешкі дыбысы)
Dialogue: 0,1:28:26.25,1:28:27.92,Default,,0,0,0,,Қарашы, Бланка!
Dialogue: 0,1:28:28.51,1:28:30.38,Default,,0,0,0,,Сіз де қосыла аласыз.
Dialogue: 0,1:28:31.88,1:28:33.43,Default,,0,0,0,,Қ-қарай берсең де, мен жылап тұрғаным жоқ
Dialogue: 0,1:28:36.60,1:28:38.85,Default,,0,0,0,,Бланка қашып кетті!
Dialogue: 0,1:28:38.93,1:28:41.19,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:28:41.27,1:28:44.69,Default,,0,0,0,,Мен не істеуім керек? Мен Доанға уәде бердім.
Dialogue: 0,1:28:45.77,1:28:47.15,Default,,0,0,0,,Арқан~
Dialogue: 0,1:28:47.53,1:28:49.49,Default,,0,0,0,,(айқай)
Dialogue: 0,1:28:49.57,1:28:51.40,Default,,0,0,0,,Бланкер
Dialogue: 0,1:28:53.82,1:28:55.74,Default,,0,0,0,,Күтіңіз~
Dialogue: 0,1:28:56.33,1:28:57.58,Default,,0,0,0,,Бланкер
Dialogue: 0,1:28:57.66,1:28:59.37,Default,,0,0,0,,Күтіңіз~
Dialogue: 0,1:29:05.96,1:29:06.96,Default,,0,0,0,,Гррр…
Dialogue: 0,1:29:07.34,1:29:08.96,Default,,0,0,0,,-Кай-сан! -Уау~
Dialogue: 0,1:29:09.42,1:29:11.72,Default,,0,0,0,,Мен өзімді өлді деп ойладым...
Dialogue: 0,1:29:11.80,1:29:13.72,Default,,0,0,0,,Иә?
Dialogue: 0,1:29:17.22,1:29:18.60,Default,,0,0,0,,А...
Dialogue: 0,1:29:18.68,1:29:19.72,Default,,0,0,0,,Иә?
Dialogue: 0,1:29:24.81,1:29:26.23,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууу...
Dialogue: 0,1:29:26.61,1:29:27.98,Default,,0,0,0,,- Иә? -Эй!
Dialogue: 0,1:29:28.07,1:29:30.49,Default,,0,0,0,,(айқай)
Dialogue: 0,1:29:30.57,1:29:32.99,Default,,0,0,0,,Мені ұстаңыз!
Dialogue: 0,1:29:34.11,1:29:36.12,Default,,0,0,0,,Алдау екенін біліп тұрып, не болып жатқанын маған неге айтпадың?
Dialogue: 0,1:29:36.95,1:29:37.99,Default,,0,0,0,,Дио, жүрегім ауыр.
Dialogue: 0,1:29:38.08,1:29:39.79,Default,,0,0,0,,(айқай)
Dialogue: 0,1:29:42.25,1:29:43.92,Default,,0,0,0,,…ол үстем болатынына сенді.
Dialogue: 0,1:29:44.33,1:29:46.25,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,1:29:46.58,1:29:48.67,Default,,0,0,0,,Гунууууу
Dialogue: 0,1:29:53.22,1:29:54.26,Default,,0,0,0,,Уф...
Dialogue: 0,1:29:54.34,1:29:56.59,Default,,0,0,0,,(айқай)
Dialogue: 0,1:29:57.10,1:29:59.14,Default,,0,0,0,,Уау, уфххх...
Dialogue: 0,1:29:59.22,1:30:01.89,Default,,0,0,0,,(Катсу мен Рецудың күлкісі)
Dialogue: 0,1:30:01.97,1:30:03.14,Default,,0,0,0,,Хмм...
Dialogue: 0,1:30:03.23,1:30:05.56,Default,,0,0,0,,Хаа ха...
Dialogue: 0,1:30:05.65,1:30:08.15,Default,,0,0,0,,Рахмет... Иә?
Dialogue: 0,1:30:10.11,1:30:12.90,Default,,0,0,0,,Барлығы сонда ма? Сенімен бәрі жақсы ма?
Dialogue: 0,1:30:12.99,1:30:14.70,Default,,0,0,0,,Ах...
Dialogue: 0,1:30:15.11,1:30:17.66,Default,,0,0,0,,Бұл аздап көп сияқты.
Dialogue: 0,1:30:18.41,1:30:20.03,Default,,0,0,0,,Сіз қайдансыз?
Dialogue: 0,1:30:20.12,1:30:22.08,Default,,0,0,0,,Бұл Ақ база баласы!
Dialogue: 0,1:30:22.16,1:30:24.79,Default,,0,0,0,,Мен Амуро-нии-чанды іздеуге келдім!
Dialogue: 0,1:30:25.08,1:30:26.54,Default,,0,0,0,,Амуро! ?
Dialogue: 0,1:30:26.62,1:30:27.46,Default,,0,0,0,,Ах...
Dialogue: 0,1:30:27.54,1:30:29.46,Default,,0,0,0,,...
Dialogue: 0,1:30:31.21,1:30:32.55,Default,,0,0,0,,Хмм...
Dialogue: 0,1:30:33.51,1:30:35.55,Default,,0,0,0,,Амуро іздеп жүрсіз бе?
Dialogue: 0,1:30:35.93,1:30:37.55,Default,,0,0,0,,Амуро-кун! ?
Dialogue: 0,1:30:37.80,1:30:40.01,Default,,0,0,0,,Сіз Амуроны білесіз бе?
Dialogue: 0,1:30:45.39,1:30:48.73,Default,,0,0,0,,Ууууууууу
Dialogue: 0,1:31:01.16,1:31:05.16,Default,,0,0,0,,Хаа һаа һаа һаа…
Dialogue: 0,1:31:08.42,1:31:10.59,Default,,0,0,0,,Қараңдар! Тезірек!
Dialogue: 0,1:31:11.04,1:31:15.09,Default,,0,0,0,,Бұл менің зеңбірекімді таспен ұрған жігіт емес пе?
Dialogue: 0,1:31:23.56,1:31:25.10,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,1:31:31.44,1:31:32.61,Default,,0,0,0,,Гррр…
Dialogue: 0,1:31:33.48,1:31:34.32,Default,,0,0,0,,Уф...
Dialogue: 0,1:31:36.32,1:31:38.57,Default,,0,0,0,,Ах! Бұл Доан!
Dialogue: 0,1:31:42.45,1:31:43.45,Default,,0,0,0,,Бум!
Dialogue: 0,1:31:43.53,1:31:45.83,Default,,0,0,0,,Сәттілік Доан!
Dialogue: 0,1:31:46.16,1:31:48.66,Default,,0,0,0,,Ха! Уф...
Dialogue: 0,1:32:06.39,1:32:08.81,Default,,0,0,0,,Ах...
Dialogue: 0,1:32:08.89,1:32:10.31,Default,,0,0,0,,Фу…
Dialogue: 0,1:32:15.57,1:32:16.82,Default,,0,0,0,,Ах, а...
Dialogue: 0,1:32:16.90,1:32:19.32,Default,,0,0,0,,Ха…
Dialogue: 0,1:32:19.53,1:32:21.78,Default,,0,0,0,,Бұл сіздің де соңыңыз!
Dialogue: 0,1:32:34.67,1:32:37.55,Default,,0,0,0,,Бұл өте жағымсыз, Кукурус Доан!
Dialogue: 0,1:32:37.63,1:32:41.26,Default,,0,0,0,,Ах...
Dialogue: 0,1:32:41.72,1:32:42.76,Default,,0,0,0,,Ах!
Dialogue: 0,1:32:42.84,1:32:45.14,Default,,0,0,0,,Ойлан!
Dialogue: 0,1:32:45.22,1:32:46.26,Default,,0,0,0,,Уф!
Dialogue: 0,1:32:46.35,1:32:49.27,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:32:53.35,1:32:55.52,Default,,0,0,0,,Ууууууууууууууу!
Dialogue: 0,1:33:04.12,1:33:07.66,Default,,0,0,0,,«Федерацияның ақ жігіті» иә! ?
Dialogue: 0,1:33:10.75,1:33:13.21,Default,,0,0,0,,Кай-сан, бұл Гундам!
Dialogue: 0,1:33:13.29,1:33:15.67,Default,,0,0,0,,Ақыры шықтың, Амуро!
Dialogue: 0,1:33:16.13,1:33:17.50,Default,,0,0,0,,Бұл Гундам!
Dialogue: 0,1:33:17.59,1:33:19.17,Default,,0,0,0,,Амуро-нии-чан!
Dialogue: 0,1:33:19.46,1:33:22.38,Default,,0,0,0,,Амуро Осой Осой
Dialogue: 0,1:33:24.59,1:33:25.68,Default,,0,0,0,,Ах...
Dialogue: 0,1:33:34.02,1:33:38.07,Default,,0,0,0,,Хаа һаа һаа һаа…
Dialogue: 0,1:33:39.98,1:33:42.45,Default,,0,0,0,,Хаа…
Dialogue: 0,1:33:42.53,1:33:44.57,Default,,0,0,0,,Қалауыңызша!
Dialogue: 0,1:34:05.26,1:34:06.30,Default,,0,0,0,,Иә
Dialogue: 0,1:34:13.10,1:34:14.81,Default,,0,0,0,,Қашпа!
Dialogue: 0,1:34:25.91,1:34:27.32,Default,,0,0,0,,Гах...
Dialogue: 0,1:34:30.41,1:34:32.54,Default,,0,0,0,,Ах, а...
Dialogue: 0,1:34:38.29,1:34:39.34,Default,,0,0,0,,Хмм...
Dialogue: 0,1:34:39.42,1:34:41.25,Default,,0,0,0,,Ах...
Dialogue: 0,1:34:41.34,1:34:42.38,Default,,0,0,0,,Ах...
Dialogue: 0,1:34:47.34,1:34:51.76,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:34:51.85,1:34:53.93,Default,,0,0,0,,Ууууууууууууу!
Dialogue: 0,1:34:54.02,1:34:55.14,Default,,0,0,0,,Бұл – Огимотоя.
Dialogue: 0,1:35:01.15,1:35:05.65,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууу...
Dialogue: 0,1:35:10.16,1:35:13.12,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:35:25.05,1:35:26.92,Default,,0,0,0,,Ах...
Dialogue: 0,1:35:46.32,1:35:47.49,Default,,0,0,0,,Жоқ…
Dialogue: 0,1:35:54.95,1:35:55.87,Default,,0,0,0,,Ах...
Dialogue: 0,1:35:55.95,1:35:56.87,Default,,0,0,0,,Не! ?
Dialogue: 0,1:36:02.96,1:36:04.88,Default,,0,0,0,,Дегенмен, патшаңыздың қазір есінен адасқаны анық.
Dialogue: 0,1:36:06.71,1:36:08.88,Default,,0,0,0,,Баллистикалық зымыран ұшырылды
Dialogue: 0,1:36:09.51,1:36:11.34,Default,,0,0,0,,Мен жасадым!
Dialogue: 0,1:36:12.43,1:36:15.39,Default,,0,0,0,,Бұл сіз қалаған соң.
Dialogue: 0,1:36:15.47,1:36:17.39,Default,,0,0,0,,Маршал Гоп
Dialogue: 0,1:36:17.68,1:36:19.73,Default,,0,0,0,,Үлкен зымыран ұшырылды.
Dialogue: 0,1:36:19.81,1:36:22.40,Default,,0,0,0,,Алегранца аралының жанында!
Dialogue: 0,1:36:22.73,1:36:25.02,Default,,0,0,0,,Сондай жақын жерден...
Dialogue: 0,1:36:25.11,1:36:26.40,Default,,0,0,0,,Оны атып тастаңыз!
Dialogue: 0,1:36:26.48,1:36:28.28,Default,,0,0,0,,Әрбір кеме зымырандарды ұшырды!
Dialogue: 0,1:36:50.55,1:36:52.72,Default,,0,0,0,,Оқ 6 бөлікке бөлінген!
Dialogue: 0,1:36:52.80,1:36:55.05,Default,,0,0,0,,Біз жақында Карман сызығына жетеміз!
Dialogue: 0,1:36:55.35,1:36:56.97,Default,,0,0,0,,Бақылау мүмкін емес!
Dialogue: 0,1:37:00.14,1:37:02.81,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,1:37:05.56,1:37:07.23,Default,,0,0,0,,Хмм...
Dialogue: 0,1:37:10.15,1:37:11.20,Default,,0,0,0,,Хмм...
Dialogue: 0,1:37:15.16,1:37:17.16,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:37:19.41,1:37:20.45,Default,,0,0,0,,Ах!
Dialogue: 0,1:37:20.54,1:37:22.54,Default,,0,0,0,,-Бұл не? ? -Иә?
Dialogue: 0,1:37:22.62,1:37:24.00,Default,,0,0,0,,Не?
Dialogue: 0,1:37:24.08,1:37:25.71,Default,,0,0,0,,Бұл жұлдыз ма?
Dialogue: 0,1:37:26.92,1:37:29.71,Default,,0,0,0,,Төрт бес алты…
Dialogue: 0,1:37:30.21,1:37:31.72,Default,,0,0,0,,Кире~
Dialogue: 0,1:37:31.80,1:37:34.72,Default,,0,0,0,,-(Бала) Уау, тамаша. -(Бала) Керемет.
Dialogue: 0,1:37:37.47,1:37:38.72,Default,,0,0,0,,Есік…
Dialogue: 0,1:37:39.10,1:37:42.02,Default,,0,0,0,,Сіздің маңызды жұмысыңыз қандай?
Dialogue: 0,1:37:42.10,1:37:43.35,Default,,0,0,0,,Бұл?
Dialogue: 0,1:37:47.52,1:37:49.32,Default,,0,0,0,,Хаа…
Dialogue: 0,1:37:51.40,1:37:53.28,Default,,0,0,0,,Ах...
Dialogue: 0,1:37:55.11,1:37:56.62,Default,,0,0,0,,Зымыранның жоғалуы
Dialogue: 0,1:37:56.70,1:37:59.12,Default,,0,0,0,,Атмосфера сыртында жарылған сияқты.
Dialogue: 0,1:37:59.70,1:38:01.87,Default,,0,0,0,,О, о...
Dialogue: 0,1:38:04.54,1:38:07.88,Default,,0,0,0,,Сәттілік осында болған сияқты.
Dialogue: 0,1:38:07.96,1:38:10.09,Default,,0,0,0,,Ах, а...
Dialogue: 0,1:38:10.96,1:38:12.76,Default,,0,0,0,,(2-қыз) О, өтінемін, өзіңізді міндетті сезінбеңіз, ханым
Dialogue: 0,1:38:12.84,1:38:14.30,Default,,0,0,0,,Ұраған
Dialogue: 0,1:38:16.64,1:38:19.14,Default,,0,0,0,,Париж өртеніп жатыр ма?
Dialogue: 0,1:38:19.85,1:38:21.14,Default,,0,0,0,,Иә?
Dialogue: 0,1:38:21.43,1:38:23.48,Default,,0,0,0,,Бұл жанып тұрған жоқ, солай ма?
Dialogue: 0,1:38:23.56,1:38:25.98,Default,,0,0,0,,Париж де, Лондон да
Dialogue: 0,1:38:26.06,1:38:27.90,Default,,0,0,0,,Нью-Йорк те
Dialogue: 0,1:38:28.15,1:38:30.90,Default,,0,0,0,,Ха ха ха... иә
Dialogue: 0,1:38:32.03,1:38:33.78,Default,,0,0,0,,Хаха хаф
Dialogue: 0,1:38:33.86,1:38:35.90,Default,,0,0,0,,Ахахахаха…
Dialogue: 0,1:38:36.36,1:38:37.41,Default,,0,0,0,,Иә?
Dialogue: 0,1:38:37.49,1:38:39.20,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,1:38:39.28,1:38:40.74,Default,,0,0,0,,Сондай-ақ менің қарамағындағыларға —
Dialogue: 0,1:38:40.83,1:38:44.58,Default,,0,0,0,,Бұл мәдениетті жақсы көретін адамдар болды дегенді білдіре ме?
Dialogue: 0,1:38:44.83,1:38:47.42,Default,,0,0,0,,Фухахахаха...
Dialogue: 0,1:38:47.50,1:38:49.04,Default,,0,0,0,,Аххххх
Dialogue: 0,1:38:49.34,1:38:55.55,Default,,0,0,0,,(Ма Кубенің күлкісі)
Dialogue: 0,1:39:03.93,1:39:06.64,Default,,0,0,0,,(Фраудың айқайы)
Dialogue: 0,1:39:06.73,1:39:08.31,Default,,0,0,0,,Кешіріңіз, Фрау.
Dialogue: 0,1:39:08.52,1:39:10.44,Default,,0,0,0,,Сіз мені алаңдатты.
Dialogue: 0,1:39:12.73,1:39:14.32,Default,,0,0,0,,Ха…
Dialogue: 0,1:39:14.40,1:39:17.36,Default,,0,0,0,,Бұл адам ба?
Dialogue: 0,1:39:17.45,1:39:18.78,Default,,0,0,0,,Иә
Dialogue: 0,1:39:19.41,1:39:21.28,Default,,0,0,0,,Бұл таңқаларлық.
Dialogue: 0,1:39:24.95,1:39:26.91,Default,,0,0,0,,Хмм...
Dialogue: 0,1:39:28.71,1:39:30.08,Default,,0,0,0,,Рахмет
Dialogue: 0,1:39:30.17,1:39:33.59,Default,,0,0,0,,Сіз шынымен де күшті едіңіз, солай емес пе?
Dialogue: 0,1:39:33.67,1:39:36.80,Default,,0,0,0,,-(Балалар) Доан -Бәрі аман-есен болғанына қуаныштымын.
Dialogue: 0,1:39:36.88,1:39:38.59,Default,,0,0,0,,Сіз жарақат алдыңыз ба? Доан
Dialogue: 0,1:39:39.05,1:39:40.59,Default,,0,0,0,,Бұл күшті болды, Доан!
Dialogue: 0,1:39:40.68,1:39:42.72,Default,,0,0,0,,Амуро да өте күшті болды!
Dialogue: 0,1:39:42.81,1:39:46.48,Default,,0,0,0,,Егер Доан мен Амуро осында болса, соғыс енді қорқынышты болмайды!
Dialogue: 0,1:39:46.56,1:39:48.60,Default,,0,0,0,,Иә, мен қорықпаймын!
Dialogue: 0,1:39:49.02,1:39:52.65,Default,,0,0,0,,Бұл дұрыс емес. Соғыс қорқынышты.
Dialogue: 0,1:39:52.73,1:39:54.44,Default,,0,0,0,,Кукуррус Доан
Dialogue: 0,1:39:56.28,1:39:59.78,Default,,0,0,0,,Денеңе соғыс иісі сіңген.
Dialogue: 0,1:39:59.86,1:40:02.99,Default,,0,0,0,,Бұл төбелес емес пе?
Dialogue: 0,1:40:04.08,1:40:05.33,Default,,0,0,0,,Иә?
Dialogue: 0,1:40:06.20,1:40:10.12,Default,,0,0,0,,Маған оны өшіруге рұқсат етіңіз, Доан.
Dialogue: 0,1:40:26.39,1:40:28.81,Default,,0,0,0,,Ах...
Dialogue: 0,1:40:30.39,1:40:32.31,Default,,0,0,0,,-Иә - (Слеггер) Әй...
Dialogue: 0,1:40:32.40,1:40:34.31,Default,,0,0,0,,Ах...
Dialogue: 0,1:40:58.38,1:40:59.42,Default,,0,0,0,,Әй!
Dialogue: 0,1:41:13.02,1:41:14.19,Default,,0,0,0,,Ах!
Dialogue: 0,1:41:14.77,1:41:16.86,Default,,0,0,0,,Ах, жылап жібергім келеді!! Егер білгенімде➡
Dialogue: 0,1:41:17.69,1:41:19.53,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:41:19.94,1:41:20.94,Default,,0,0,0,,Бум!
Dialogue: 0,1:41:21.03,1:41:22.82,Default,,0,0,0,,Әлгі жігіт Доанның Закуы!
Dialogue: 0,1:41:22.91,1:41:24.53,Default,,0,0,0,,Жарайды ма? Доан
Dialogue: 0,1:41:25.12,1:41:26.78,Default,,0,0,0,,Өкінішті, бірақ…
Dialogue: 0,1:41:26.87,1:41:30.79,Default,,0,0,0,,Амуро-кун өте жақсы іс жасады.
Dialogue: 0,1:41:32.54,1:41:34.29,Default,,0,0,0,,Иә?
Dialogue: 0,1:41:34.75,1:41:37.67,Default,,0,0,0,,Джулиан, жылама.
Dialogue: 0,1:41:39.00,1:41:40.38,Default,,0,0,0,,Ах...
Dialogue: 0,1:41:50.43,1:41:51.85,Default,,0,0,0,,Ұшыңыз!
Dialogue: 0,1:41:51.93,1:41:53.81,Default,,0,0,0,,Белфастқа барыңыз!
Dialogue: 0,1:42:08.12,1:42:10.08,Default,,0,0,0,,Ах! Қараңдар!
Dialogue: 0,1:42:10.83,1:42:12.66,Default,,0,0,0,,Үлкен ұшақ!
Dialogue: 0,1:42:13.87,1:42:15.79,Default,,0,0,0,,Айқай~
Dialogue: 0,1:42:15.87,1:42:17.88,Default,,0,0,0,,Үлкен
Dialogue: 0,1:42:17.96,1:42:20.59,Default,,0,0,0,,Бортта Амуро болуы мүмкін.
Dialogue: 0,1:42:21.34,1:42:22.59,Default,,0,0,0,,А...
Dialogue: 0,1:42:23.09,1:42:24.84,Default,,0,0,0,,-(Бала) Бұл не? -(Бала) Не?
Dialogue: 0,1:42:24.93,1:42:26.05,Default,,0,0,0,,Қорқынышты
Dialogue: 0,1:42:26.14,1:42:29.22,Default,,0,0,0,,Бұл Амуро мінген ұшақ!
Dialogue: 0,1:42:29.85,1:42:31.22,Default,,0,0,0,,Иә?
Dialogue: 0,1:42:31.31,1:42:34.64,Default,,0,0,0,,♪~
Dialogue: 0,1:42:37.81,1:42:40.32,Default,,0,0,0,,Уау Бланка~
Dialogue: 0,1:42:51.58,1:42:54.58,Default,,0,0,0,,Ахахахаха…
Dialogue: 0,1:42:54.66,1:42:56.83,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:42:57.12,1:43:00.34,Default,,0,0,0,,-Уау -Ахахахаха...
Dialogue: 0,1:43:08.43,1:43:10.35,Default,,0,0,0,,Уау
Dialogue: 0,1:43:13.35,1:43:15.60,Default,,0,0,0,,Матана Матана
Dialogue: 0,1:43:15.68,1:43:17.56,Default,,0,0,0,,...
Dialogue: 0,1:48:32.13,1:48:34.13,Default,,0,0,0,,~♪
Dialogue: 0,1:48:35.63,1:48:41.63,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
