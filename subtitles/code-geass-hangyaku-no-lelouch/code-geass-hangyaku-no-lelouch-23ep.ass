Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.20,0:00:03.10,Default,,0,0,0,,Мен
Dialogue: 0,0:00:03.20,0:00:05.63,Default,,0,0,0,,Euphemia li Britannia атымен
Dialogue: 0,0:00:05.73,0:00:07.50,Default,,0,0,0,,Мен сізге бұйрық беремін.
Dialogue: 0,0:00:08.27,0:00:12.24,Default,,0,0,0,,Өздерін жапон деп атайтын адамдарды өлтіріңіз.
Dialogue: 0,0:00:12.54,0:00:15.34,Default,,0,0,0,,Бірде-бір адам артта қалмауы керек.
Dialogue: 0,0:00:15.41,0:00:21.42,Default,,0,0,0,,♪～
Dialogue: 0,0:00:23.32,0:00:27.16,Default,,0,0,0,,♪Мен армандаған арман
Dialogue: 0,0:00:27.26,0:00:31.06,Default,,0,0,0,,♪Шексіз және алыс
Dialogue: 0,0:00:31.16,0:00:37.50,Default,,0,0,0,,♪Құрғақ күндерде көк аспан, Қолымда
Dialogue: 0,0:00:39.10,0:00:42.57,Default,,0,0,0,,♪Дыбыстағы біркелкі сынама және қателік
Dialogue: 0,0:00:42.67,0:00:48.08,Default,,0,0,0,,♪Уақытсыз және интервалсыз кеңістік
Dialogue: 0,0:00:49.54,0:00:51.78,Default,,0,0,0,,♪Өмірлік өлшем шу шығарады
Dialogue: 0,0:00:52.08,0:00:54.62,Default,,0,0,0,,♪Мен өз бетімді жасаймын
Dialogue: 0,0:00:54.72,0:00:58.15,Default,,0,0,0,,♪ Тек бір жағын тазалаңыз
Dialogue: 0,0:00:58.72,0:01:02.62,Default,,0,0,0,,♪Қолыма түсті
Dialogue: 0,0:01:02.72,0:01:06.49,Default,,0,0,0,,♪Шіріген алма
Dialogue: 0,0:01:06.59,0:01:10.53,Default,,0,0,0,,♪Айнада бейнеленген
Dialogue: 0,0:01:10.63,0:01:14.50,Default,,0,0,0,,♪Біздің арғы жағымызға
Dialogue: 0,0:01:14.60,0:01:18.31,Default,,0,0,0,,♪Дистанциялық сезім Адамдар арасындағы сынақ пен қателік
Dialogue: 0,0:01:18.41,0:01:23.48,Default,,0,0,0,,♪Уақыт пен сезімсіз кеңістік
Dialogue: 0,0:01:25.21,0:01:27.48,Default,,0,0,0,,♪Бас пен дене тырнақтарын жоғары көтеріп тұру
Dialogue: 0,0:01:27.58,0:01:30.42,Default,,0,0,0,,♪Бетімді қырып алайын деп жатырмын
Dialogue: 0,0:01:30.52,0:01:36.22,Default,,0,0,0,,♪ Тек бір жағын тазалаңыз
Dialogue: 0,0:01:37.73,0:01:44.73,Default,,0,0,0,,♪-Қашықтық сезімі
Dialogue: 0,0:01:50.81,0:01:52.77,Default,,0,0,0,,Эфемия бізге опасыздық жасады
Dialogue: 0,0:01:52.87,0:01:54.84,Default,,0,0,0,,Барлық әскерлер салтанатты жиын өтетін жерге асығады! ―
Dialogue: 0,0:01:55.14,0:01:57.28,Default,,0,0,0,,Британияны талқандаймыз.
Dialogue: 0,0:02:02.12,0:02:04.69,Default,,0,0,0,,Эфемия!Қандай алдау!
Dialogue: 0,0:02:08.72,0:02:10.22,Default,,0,0,0,,Он бір!
Dialogue: 0,0:02:10.29,0:02:11.16,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:02:11.26,0:02:13.53,Default,,0,0,0,,Сіз шынымен де осылай айтып отырсыз ба?
Dialogue: 0,0:02:17.13,0:02:20.20,Default,,0,0,0,,Қара рыцарьлар! Британияны жойыңыз!
Dialogue: 0,0:02:22.57,0:02:24.87,Default,,0,0,0,,Қайда? Юффи қайда? ―
Dialogue: 0,0:02:27.41,0:02:30.68,Default,,0,0,0,,Тоқта! Менің дәл қазір сендер үшін уайымдайтын уақытым жоқ!
Dialogue: 0,0:02:30.78,0:02:33.45,Default,,0,0,0,,Уау, не болып жатыр?
Dialogue: 0,0:02:37.72,0:02:38.89,Default,,0,0,0,,) рұқсат етілмейді
Dialogue: 0,0:02:39.19,0:02:42.49,Default,,0,0,0,,Әркімнің сезімін таптау... Эфемия!
Dialogue: 0,0:02:42.59,0:02:44.29,Default,,0,0,0,,Жүгір!
Dialogue: 0,0:02:45.73,0:02:47.33,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:02:47.70,0:02:48.66,Default,,0,0,0,,Ия
Dialogue: 0,0:02:48.76,0:02:51.43,Default,,0,0,0,,Сіз жапонсыз ба? Бұл дөрекі емес пе?
Dialogue: 0,0:02:51.53,0:02:54.27,Default,,0,0,0,,Мен Эфемия Ли Британиямын, солай ма?
Dialogue: 0,0:02:54.37,0:02:55.24,Default,,0,0,0,,Не!
Dialogue: 0,0:02:55.34,0:02:59.24,Default,,0,0,0,,Түсіндім, сен осында болдың, қуыршақ ханшайым.
Dialogue: 0,0:02:59.44,0:03:01.78,Default,,0,0,0,,О, сен сол аралда едің...
Dialogue: 0,0:03:01.88,0:03:04.75,Default,,0,0,0,,Әй, мұнда бәрінің жауы...
Dialogue: 0,0:03:04.85,0:03:05.48,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:03:05.48,0:03:05.71,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:03:05.48,0:03:05.71,Default,,0,0,0,,Ах
Dialogue: 0,0:03:05.71,0:03:06.35,Default,,0,0,0,,Ах
Dialogue: 0,0:03:06.78,0:03:08.85,Default,,0,0,0,,Мен оған қамқор боламын
Dialogue: 0,0:03:11.42,0:03:12.72,Default,,0,0,0,,Мен жапон болсам да
Dialogue: 0,0:03:19.63,0:03:21.76,Default,,0,0,0,,Сіз не істегіңіз келеді?Нөл түсірілді ме?
Dialogue: 0,0:03:21.86,0:03:23.57,Default,,0,0,0,,Бұл пайдасыз...
Dialogue: 0,0:03:24.43,0:03:28.84,Default,,0,0,0,,Бұл геноцид. Барлық жапондықтар жойылды.
Dialogue: 0,0:03:28.94,0:03:30.20,Default,,0,0,0,,Хмм
Dialogue: 0,0:03:35.71,0:03:38.35,Default,,0,0,0,,Неліктен? тез тез
Dialogue: 0,0:03:41.68,0:03:43.32,Default,,0,0,0,,Мен сенімдімін...
Dialogue: 0,0:03:44.25,0:03:46.25,Default,,0,0,0,,бұл... Ах! ―
Dialogue: 0,0:03:47.22,0:03:49.89,Default,,0,0,0,,О, мен сені жапон деп ойладым.
Dialogue: 0,0:03:49.99,0:03:55.26,Default,,0,0,0,,Ей, мен Жапонияны арнайы әкімшілік аймақ деп жариялауды ойладым...
Dialogue: 0,0:03:55.36,0:03:56.80,Default,,0,0,0,,Әй?Жапония…
Dialogue: 0,0:03:57.00,0:04:00.54,Default,,0,0,0,,Аа, мен мүмкін болар едім.
Dialogue: 0,0:04:01.87,0:04:03.00,Default,,0,0,0,,Сізбен бірге
Dialogue: 0,0:04:04.44,0:04:05.34,Default,,0,0,0,,Ах
Dialogue: 0,0:04:06.87,0:04:07.74,Default,,0,0,0,,Юффи
Dialogue: 0,0:04:09.38,0:04:10.25,Default,,0,0,0,,Ах
Dialogue: 0,0:04:10.98,0:04:12.31,Default,,0,0,0,,Ах-
Dialogue: 0,0:04:13.62,0:04:16.68,Default,,0,0,0,,Неліктен?лелуш
Dialogue: 0,0:04:16.95,0:04:22.02,Default,,0,0,0,,Қош бол Юффи. Бұл менің алғашқы махаббатым болса керек...
Dialogue: 0,0:04:25.99,0:04:27.70,Default,,0,0,0,,О, бұл…
Dialogue: 0,0:04:27.80,0:04:29.66,Default,,0,0,0,,Не, Созаку?
Dialogue: 0,0:04:29.76,0:04:30.73,Default,,0,0,0,,) Осындай кездерде!
Dialogue: 0,0:04:33.87,0:04:36.84,Default,,0,0,0,,Қарғыс атсын... Мен адрон зеңбірегіне қарсы тұра алмаймын.
Dialogue: 0,0:04:40.41,0:04:42.38,Default,,0,0,0,,Мен саған Лелушты өлтіруге рұқсат бере алмаймын!
Dialogue: 0,0:04:45.41,0:04:47.48,Default,,0,0,0,,Созаку! Маған кедергі жасама!
Dialogue: 0,0:04:54.32,0:04:55.46,Default,,0,0,0,,Уф, бұл!
Dialogue: 0,0:04:57.53,0:04:58.39,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:05.03,0:05:06.03,Default,,0,0,0,,Ах (Сесил Крами)
Dialogue: 0,0:05:06.40,0:05:08.90,Default,,0,0,0,,Өтінемін, Юффи...
Dialogue: 0,0:05:09.00,0:05:10.64,Default,,0,0,0,,Юффиге көмектесіңіз!
Dialogue: 0,0:05:12.81,0:05:14.84,Default,,0,0,0,,Сіз Далтонмен әлі де байланыса алмайсыз ба?
Dialogue: 0,0:05:14.94,0:05:18.55,Default,,0,0,0,,Иә, оның жарақат алғаны хабарланды, бірақ одан да көп...
Dialogue: 0,0:05:18.78,0:05:21.58,Default,,0,0,0,,Губернатор Корнелия Авалоннан жедел қоңырау алды.
Dialogue: 0,0:05:21.75,0:05:22.65,Default,,0,0,0,,Авалоннан?
Dialogue: 0,0:05:22.75,0:05:24.75,Default,,0,0,0,,Иә, қара рыцарлар жазған
Dialogue: 0,0:05:24.85,0:05:26.72,Default,,0,0,0,,Фудзидің арнайы әкімшілік аймағы жойылды.
Dialogue: 0,0:05:26.95,0:05:27.86,Default,,0,0,0,,Не?
Dialogue: 0,0:05:27.96,0:05:30.79,Default,,0,0,0,,Қара рыцарьлар тосқауыл қоюға дайындалуда.
Dialogue: 0,0:05:30.89,0:05:31.93,Default,,0,0,0,,Және…
Dialogue: 0,0:05:33.09,0:05:34.56,Default,,0,0,0,,Эфемия-сама...
Dialogue: 0,0:05:40.70,0:05:42.47,Default,,0,0,0,,Ооо...
Dialogue: 0,0:05:42.57,0:05:43.44,Default,,0,0,0,,Хмм
Dialogue: 0,0:05:43.57,0:05:45.87,Default,,0,0,0,,Теңдік дегеніміз не? Бұл ерекше әкімшілік аудан! ―
Dialogue: 0,0:05:46.51,0:05:49.98,Default,,0,0,0,,Сен бізді алдап өлтірдің. Мен сені енді кешірмеймін.
Dialogue: 0,0:05:50.08,0:05:52.08,Default,,0,0,0,,Мен сені ешқашан кешірмеймін!
Dialogue: 0,0:05:52.35,0:05:53.88,Default,,0,0,0,,Иә! (Еркек) Британияны кешірме!
Dialogue: 0,0:05:53.98,0:05:55.48,Default,,0,0,0,,Біз жапонбыз!
Dialogue: 0,0:05:55.58,0:05:56.85,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:05:56.95,0:06:00.39,Default,,0,0,0,,Бұл салтанатты жерде фильмдер мен жабдықтар сақталады.
Dialogue: 0,0:06:00.49,0:06:02.72,Default,,0,0,0,,Аа, өңдегеннен кейін интернетке орналастырыңыз.
Dialogue: 0,0:06:02.82,0:06:04.86,Default,,0,0,0,,Мен оны бүкіл әлемге көрсетемін.
Dialogue: 0,0:06:04.96,0:06:07.63,Default,,0,0,0,,Әділдіктің қайсысы екенін оңай түсініңіз
Dialogue: 0,0:06:07.76,0:06:09.13,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:06:09.43,0:06:11.97,Default,,0,0,0,,Шынында да, сізде Британияға деген адалдық жоқ.
Dialogue: 0,0:06:12.07,0:06:13.80,Default,,0,0,0,,Адалдық? (Ракшата) Иә.
Dialogue: 0,0:06:14.14,0:06:16.57,Default,,0,0,0,,Британия - дайын материал.
Dialogue: 0,0:06:16.67,0:06:18.67,Default,,0,0,0,,Өзіңді осындай нәрсеге арнағанның мәні неде?
Dialogue: 0,0:06:18.81,0:06:22.04,Default,,0,0,0,,Ахаха сен мен ойлағаннан да адал адам екенсің.
Dialogue: 0,0:06:22.14,0:06:23.95,Default,,0,0,0,,Енді не істейсіз?
Dialogue: 0,0:06:24.05,0:06:25.45,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:06:25.55,0:06:27.72,Default,,0,0,0,,Мен жай ғана деректер алғым келеді...
Dialogue: 0,0:06:27.98,0:06:30.59,Default,,0,0,0,,Сені тастап кеткенім жаман...
Dialogue: 0,0:06:30.69,0:06:33.62,Default,,0,0,0,,Нөл қызық жігіт.
Dialogue: 0,0:06:34.56,0:06:36.16,Default,,0,0,0,,) Ақыры мен сені кездестірдім.
Dialogue: 0,0:06:36.99,0:06:38.09,Default,,0,0,0,,Бұл әйел-
Dialogue: 0,0:06:38.69,0:06:40.86,Default,,0,0,0,,Мен сенімдімін Созаку туысы...
Dialogue: 0,0:06:41.53,0:06:44.77,Default,,0,0,0,,Нөл, бұдан былай біздің астымызда...
Dialogue: 0,0:06:44.87,0:06:46.17,Default,,0,0,0,,Керісінше! (Кирихара) Иә?
Dialogue: 0,0:06:46.93,0:06:47.97,Default,,0,0,0,,Енді осылай...
Dialogue: 0,0:06:48.07,0:06:51.67,Default,,0,0,0,,Киото алты отбасының мүшелері менің қол астында болады.
Dialogue: 0,0:06:51.77,0:06:52.91,Default,,0,0,0,,Бас тартуға жол берілмейді.
Dialogue: 0,0:06:53.44,0:06:55.88,Default,,0,0,0,,Тірі қалудың басқа жолы бар ма?
Dialogue: 0,0:06:56.11,0:06:57.61,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:07:02.15,0:07:03.85,Default,,0,0,0,,Губернатор Корнелияға...
Dialogue: 0,0:07:04.19,0:07:06.59,Default,,0,0,0,,Біз сізге осы жерде хабарласамыз.
Dialogue: 0,0:07:06.69,0:07:09.02,Default,,0,0,0,,Мен мемлекеттік кеңсеге қайтып келгенше...
Dialogue: 0,0:07:09.12,0:07:10.86,Default,,0,0,0,,Бұл ұзаққа созылмайды.
Dialogue: 0,0:07:10.96,0:07:13.03,Default,,0,0,0,,Мәртебелі Шнайзелге, мына жерді басыңыз -
Dialogue: 0,0:07:13.13,0:07:14.46,Default,,0,0,0,,Сонымен
Dialogue: 0,0:07:20.47,0:07:21.74,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:07:22.10,0:07:24.01,Default,,0,0,0,,Созаку... аа...-
Dialogue: 0,0:07:24.14,0:07:25.54,Default,,0,0,0,,Юффи…
Dialogue: 0,0:07:38.62,0:07:41.62,Default,,0,0,0,,Юффи, маған айтыңызшы.
Dialogue: 0,0:07:41.96,0:07:44.96,Default,,0,0,0,,Неліктен мұндай бұйрық бердіңіз?
Dialogue: 0,0:07:45.06,0:07:46.56,Default,,0,0,0,,Бұйрық?
Dialogue: 0,0:07:47.53,0:07:49.56,Default,,0,0,0,,Сіз нені айтасыз? иә?
Dialogue: 0,0:07:50.50,0:07:55.74,Default,,0,0,0,,Соған қарағанда, Сузаку жапондық еді... солай ма?
Dialogue: 0,0:07:55.84,0:07:57.51,Default,,0,0,0,,Э? О, иә.
Dialogue: 0,0:07:57.61,0:07:58.51,Default,,0,0,0,,Уф
Dialogue: 0,0:07:58.57,0:07:59.47,Default,,0,0,0,,Юффи
Dialogue: 0,0:07:59.57,0:08:00.98,Default,,0,0,0,,Жоқ, не?
Dialogue: 0,0:08:01.48,0:08:03.85,Default,,0,0,0,,Жоқ... жоқ...
Dialogue: 0,0:08:04.11,0:08:08.62,Default,,0,0,0,,Бұл туралы ойламаңыз...
Dialogue: 0,0:08:09.92,0:08:11.95,Default,,0,0,0,,Созаку? Бұл не?
Dialogue: 0,0:08:12.82,0:08:13.99,Default,,0,0,0,,Рәсім...
Dialogue: 0,0:08:15.06,0:08:18.99,Default,,0,0,0,,Жапонияға не болды?
Dialogue: 0,0:08:19.69,0:08:22.63,Default,,0,0,0,,Юффи есіңде жоқ па?
Dialogue: 0,0:08:22.70,0:08:26.70,Default,,0,0,0,,(Адамдар қолдайды)
Dialogue: 0,0:08:30.14,0:08:31.91,Default,,0,0,0,,Жапон тілі! ―
Dialogue: 0,0:08:32.01,0:08:35.84,Default,,0,0,0,,Британдық қысым көрген барлық халық! ―
Dialogue: 0,0:08:36.04,0:08:37.98,Default,,0,0,0,,Мен көптен күттім! ―
Dialogue: 0,0:08:38.55,0:08:41.02,Default,,0,0,0,,Британдық әділетсіздіктерді көлеңкеден түзету...
Dialogue: 0,0:08:41.12,0:08:43.82,Default,,0,0,0,,Өздері туралы ойланатын уақыт келеді деп сенемін...
Dialogue: 0,0:08:44.79,0:08:48.09,Default,,0,0,0,,Бірақ... біздің үмітіміз ақталды.
Dialogue: 0,0:08:48.19,0:08:50.16,Default,,0,0,0,,Қырғынның айуандығымен!
Dialogue: 0,0:08:50.89,0:08:54.86,Default,,0,0,0,,Жапон халқы бақытты болды ма?
Dialogue: 0,0:08:54.96,0:08:56.86,Default,,0,0,0,,Евфемияны кешірме. (Әйел) Қорқақсың!
Dialogue: 0,0:08:56.96,0:08:58.20,Default,,0,0,0,,Бақсы (еркек) өтірікші
Dialogue: 0,0:08:59.67,0:09:03.77,Default,,0,0,0,,Иә! Эфемия - Британияның екіжүзділігінің символы.
Dialogue: 0,0:09:03.87,0:09:07.17,Default,,0,0,0,,Ол – ұлт атын жамылған қанішер.
Dialogue: 0,0:09:07.71,0:09:11.98,Default,,0,0,0,,Мен жақсы орындадым ба?
Dialogue: 0,0:09:12.08,0:09:13.85,Default,,0,0,0,,Тозаққа кет, Эфемия!
Dialogue: 0,0:09:13.95,0:09:16.65,Default,,0,0,0,,Сіз енді алданбайсыз! (Әйел) Британияға өлім!
Dialogue: 0,0:09:16.85,0:09:19.85,Default,,0,0,0,,Юффи арнайы әкімшілік ауданы
Dialogue: 0,0:09:23.76,0:09:25.66,Default,,0,0,0,,Керемет табыс!
Dialogue: 0,0:09:25.76,0:09:29.33,Default,,0,0,0,,Барлығы Жапонияға келгеніне өте қуанышты болды.
Dialogue: 0,0:09:31.20,0:09:32.57,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:09:32.80,0:09:34.17,Default,,0,0,0,,Мен қазір осындамын...
Dialogue: 0,0:09:34.27,0:09:36.84,Default,,0,0,0,,Британиядан тәуелсіздігін жариялау.
Dialogue: 0,0:09:36.94,0:09:40.24,Default,,0,0,0,,Алайда бұл Жапонияның бұрынғыдай қайта жандануын білдірмейді.
Dialogue: 0,0:09:40.34,0:09:43.31,Default,,0,0,0,,Мен тарихтың инесін кері қайтаратын ақымақтық жасамаймын.
Dialogue: 0,0:09:44.01,0:09:46.35,Default,,0,0,0,,Біз қазірден бастап жасайтын жаңа Жапония...
Dialogue: 0,0:09:46.65,0:09:50.12,Default,,0,0,0,,Барлық нәсілдер мен тарихшылдықтарды қабылдаудың кеңдігі.
Dialogue: 0,0:09:50.22,0:09:53.99,Default,,0,0,0,,Күштілері әлсізге қысым көрсетпей, игілігін көретін халық.
Dialogue: 0,0:09:54.09,0:09:56.76,Default,,0,0,0,,Оның аты Жапония Құрама Штаттары!
Dialogue: 0,0:09:56.86,0:09:59.06,Default,,0,0,0,,(Адамдар қолдайды)
Dialogue: 0,0:09:59.16,0:10:01.80,Default,,0,0,0,,Иә, қазір ұлтымыздың негізі қаланған кез.
Dialogue: 0,0:10:02.80,0:10:07.77,Default,,0,0,0,,Бұл біртүрлі. Мен сенің жүзіңді көре алмаймын.
Dialogue: 0,0:10:07.97,0:10:08.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:16.08,0:10:19.61,Default,,0,0,0,,Мектепке бару
Dialogue: 0,0:10:19.71,0:10:25.19,Default,,0,0,0,,Өйткені... мен тоқтадым... жарты жолда...
Dialogue: 0,0:10:25.29,0:10:27.72,Default,,0,0,0,,Юффи, сен қазір бара аласың.
Dialogue: 0,0:10:28.02,0:10:31.63,Default,,0,0,0,,Дұрыс!Эшфорд академиясына бірге барайық.
Dialogue: 0,0:10:31.73,0:10:35.00,Default,,0,0,0,,Біз сіздермен қызықты студенттік кеңес отырысын өткізіп жатырмыз...
Dialogue: 0,0:10:36.66,0:10:40.90,Default,,0,0,0,,Менің… минутыма дейін… солай ма?
Dialogue: 0,0:10:41.24,0:10:43.64,Default,,0,0,0,,Жоқ! Юффи Жоқ!
Dialogue: 0,0:10:43.87,0:10:46.64,Default,,0,0,0,,Ах... Созаку...
Dialogue: 0,0:10:46.74,0:10:50.65,Default,,0,0,0,,Танысқаныма қуаныштымын... аа...
Dialogue: 0,0:10:51.08,0:10:53.71,Default,,0,0,0,,(электрокардиограмма дыбысы)
Dialogue: 0,0:10:53.81,0:10:57.32,Default,,0,0,0,,Нөл нөл нөл нөл...―
Dialogue: 0,0:10:57.42,0:11:01.72,Default,,0,0,0,,Нөл Нөл Нөл Нөл Нөл Нөл Нөл Нөл
Dialogue: 0,0:11:01.82,0:11:06.13,Default,,0,0,0,,Нөл Нөл Нөл Нөл Нөл Нөл Нөл Нөл Нөл
Dialogue: 0,0:11:06.19,0:11:10.30,Default,,0,0,0,,Нөл Нөл Нөл Нөл Нөл Нөл Нөл Нөл Нөл
Dialogue: 0,0:11:10.36,0:11:13.67,Default,,0,0,0,,Нөл нөл нөл нөл…
Dialogue: 0,0:11:13.77,0:11:15.04,Default,,0,0,0,,Бұл...
Dialogue: 0,0:11:20.07,0:11:23.81,Default,,0,0,0,,Фукусима Бякко аймағы Ибаракиге дейін
Dialogue: 0,0:11:23.91,0:11:27.72,Default,,0,0,0,,Тама Хибсон аймағында министрлік емес баррикада жұмыстары жалғасуда
Dialogue: 0,0:11:28.28,0:11:30.32,Default,,0,0,0,,Токио концессиясына басып кіруді жоспарлап отырсыз ба?
Dialogue: 0,0:11:30.38,0:11:33.45,Default,,0,0,0,,А, қазір ең үлкен мүмкіндік...
Dialogue: 0,0:11:33.75,0:11:34.46,Default,,0,0,0,,Ах
Dialogue: 0,0:11:35.26,0:11:38.23,Default,,0,0,0,,Ештеңе емес, Гисс маған жұмыс істемейді.
Dialogue: 0,0:11:38.33,0:11:39.36,Default,,0,0,0,,Сіз мұны білесіз бе?
Dialogue: 0,0:11:40.13,0:11:42.30,Default,,0,0,0,,Дұрыс, иә.
Dialogue: 0,0:11:42.40,0:11:46.07,Default,,0,0,0,,Енді мен Гиссті басқара алмағандықтан, бәрімен қоштасуым керек шығар.
Dialogue: 0,0:11:46.17,0:11:47.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:49.74,0:11:50.74,Default,,0,0,0,,Нуннальды
Dialogue: 0,0:11:50.84,0:11:55.38,Default,,0,0,0,,Брат, уф... Мен Юффи апамен сөйлескім келеді.
Dialogue: 0,0:11:55.44,0:11:56.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:56.71,0:11:59.95,Default,,0,0,0,,Мен, ағам және үшеуміз мектеп мерекесін өткіздік...
Dialogue: 0,0:12:00.05,0:12:02.98,Default,,0,0,0,,Қараңдаршы, Мирей-сан үзген мектеп мерекесі...
Dialogue: 0,0:12:03.08,0:12:05.32,Default,,0,0,0,,Сіз мұны қайталайтыныңызды айттыңыз.
Dialogue: 0,0:12:05.79,0:12:09.19,Default,,0,0,0,,Сонда мен неге жиналмасқа деп ойладым.
Dialogue: 0,0:12:09.29,0:12:14.03,Default,,0,0,0,,Кешіріңіз, мен сізді енді көрмеймін дедім...
Dialogue: 0,0:12:14.13,0:12:18.50,Default,,0,0,0,,Бірақ тағы бір рет кездесе алатынымыз маңызды емес.
Dialogue: 0,0:12:18.90,0:12:21.84,Default,,0,0,0,,Нуннал, тыңдап тұрған жоқсың ба?жаңалықтар
Dialogue: 0,0:12:22.14,0:12:25.51,Default,,0,0,0,,Радио хабар таратудың ортасында аяқталды.
Dialogue: 0,0:12:26.14,0:12:27.44,Default,,0,0,0,,Өзімді жаңарғандай сезінемін, өзімді жаңарғандай сезінемін! Хехехехе
Dialogue: 0,0:12:27.74,0:12:30.18,Default,,0,0,0,,Жоқ... бұл жақсы.
Dialogue: 0,0:12:30.28,0:12:35.25,Default,,0,0,0,,Кешіріңіз, мен ертең қайтамын, ол туралы сөйлесейік.
Dialogue: 0,0:12:36.08,0:12:37.12,Default,,0,0,0,,Иә
Dialogue: 0,0:12:39.02,0:12:41.42,Default,,0,0,0,,Берілістерді ауыстыра алмаудан басқа
Dialogue: 0,0:12:41.52,0:12:42.76,Default,,0,0,0,,Өзгерістер бар ма?
Dialogue: 0,0:12:42.92,0:12:44.93,Default,,0,0,0,,Шынымен емес... жай-
Dialogue: 0,0:12:47.06,0:12:52.30,Default,,0,0,0,,Юффи менің Гиастың бұйрығына бағынбауға тырысты...
Dialogue: 0,0:12:53.00,0:12:55.77,Default,,0,0,0,,Менің қабілетім төмендеп кеткен шығар деп ойладым...
Dialogue: 0,0:12:55.87,0:12:57.47,Default,,0,0,0,,Бұл...
Dialogue: 0,0:12:57.77,0:13:00.77,Default,,0,0,0,,Ол кешіре алмайтын нәрсе...
Dialogue: 0,0:13:01.21,0:13:03.84,Default,,0,0,0,,Бұл өте табиғи.
Dialogue: 0,0:13:03.94,0:13:04.81,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:13:05.38,0:13:09.55,Default,,0,0,0,,Міне... мүмкін...
Dialogue: 0,0:13:15.29,0:13:20.49,Default,,0,0,0,,Біз келісім-шарт жасадық. Мен сенің жаныңда болсам, жалғыз мен...
Dialogue: 0,0:13:22.96,0:13:24.27,Default,,0,0,0,,Мен қисық сызықтың артында болдым.
Dialogue: 0,0:13:24.37,0:13:26.17,Default,,0,0,0,,Интернет ақпараты үзілгенімен...
Dialogue: 0,0:13:26.27,0:13:29.54,Default,,0,0,0,,Бірнеше сағаттың ішінде барлық жерде тәртіпсіздіктер басталды.
Dialogue: 0,0:13:29.84,0:13:32.34,Default,,0,0,0,,Ең ірі қарулы күш, Қара рыцарьлар...
Dialogue: 0,0:13:32.44,0:13:34.28,Default,,0,0,0,,Жалпы жұртшылықты сіңіре отырып-
Dialogue: 0,0:13:34.38,0:13:36.88,Default,,0,0,0,,Біз Токио концессиясына қарай жүреміз!
Dialogue: 0,0:13:36.98,0:13:38.95,Default,,0,0,0,,Қалған блоктар қорғаныста.
Dialogue: 0,0:13:39.05,0:13:40.51,Default,,0,0,0,,Күшейтуді сұрауға болмайды
Dialogue: 0,0:13:40.81,0:13:44.12,Default,,0,0,0,,Жау күштері, соның ішінде құрметті британдықтарды аударды...
Dialogue: 0,0:13:44.22,0:13:47.12,Default,,0,0,0,,Олардың саны ондаған мыңнан асады. (Солдат) Лорд Гилдфорд
Dialogue: 0,0:13:47.22,0:13:48.36,Default,,0,0,0,,Қорықпа.
Dialogue: 0,0:13:48.46,0:13:50.49,Default,,0,0,0,,Мен Мәртебелі әмірінсіз қозғала алмаймын.
Dialogue: 0,0:13:50.59,0:13:54.30,Default,,0,0,0,,Бірақ! Губернаторға шабуылды тоқтату туралы бұйрық берілгеннен кейін,
Dialogue: 0,0:13:54.40,0:13:56.46,Default,,0,0,0,,Мен Евфемия ханымның бөлмесінде жатырмын...
Dialogue: 0,0:13:56.93,0:13:59.90,Default,,0,0,0,,Генерал Далтон да хабарсыз кеткен.
Dialogue: 0,0:14:00.00,0:14:00.87,Default,,0,0,0,,Хмм.
Dialogue: 0,0:14:13.98,0:14:15.52,Default,,0,0,0,,А... а...
Dialogue: 0,0:14:15.58,0:14:18.55,Default,,0,0,0,,А... аа!
Dialogue: 0,0:14:18.62,0:14:21.19,Default,,0,0,0,,Бұл Тояма отряды, 23 мүше, бізге қосылыңыз.
Dialogue: 0,0:14:21.29,0:14:23.26,Default,,0,0,0,,Түсінді. Сіз қарусызсыз ба?
Dialogue: 0,0:14:23.36,0:14:25.36,Default,,0,0,0,,Жарылғыш заттар Окаямадан сатып алынды.
Dialogue: 0,0:14:25.46,0:14:28.00,Default,,0,0,0,,Бізде көлік жетіспейді. Біз сапарды бірнеше адаммен бөлісе аламыз ба?
Dialogue: 0,0:14:28.10,0:14:30.60,Default,,0,0,0,,Тек жүк вагоны қолжетімді. Бұл жақсы ма?
Dialogue: 0,0:14:31.07,0:14:33.47,Default,,0,0,0,,Яманаши тобы да бізге қосылады.
Dialogue: 0,0:14:33.57,0:14:36.24,Default,,0,0,0,,Самурай қанынан аман қалған адамдардан да естідік.
Dialogue: 0,0:14:36.34,0:14:37.94,Default,,0,0,0,,Үлкен сан болады.
Dialogue: 0,0:14:38.07,0:14:41.34,Default,,0,0,0,,Студенттер кеңесіндегілердің бәрі... Қашып кеттіңдер деп үміттенемін.
Dialogue: 0,0:14:42.34,0:14:46.28,Default,,0,0,0,,Бұл дұрыс емес. Мен бақыттымын.
Dialogue: 0,0:14:46.91,0:14:52.19,Default,,0,0,0,,А, мен мейірімділікті ұмытып кетіппін, Марианна.
Dialogue: 0,0:14:53.35,0:14:55.59,Default,,0,0,0,,Канам мырзаның жағдайы жақсы ма? ―
Dialogue: 0,0:14:55.89,0:14:58.03,Default,,0,0,0,,Егер есімде дұрыс болса, ол Шидзуокада жұмыс істейді.
Dialogue: 0,0:14:58.26,0:15:00.46,Default,,0,0,0,,Әй, бұл әйтеуір...
Dialogue: 0,0:15:00.59,0:15:03.60,Default,,0,0,0,,Эй, Чигуса, мен қайтып оралғанда айтатын маңызды нәрсем бар.
Dialogue: 0,0:15:03.90,0:15:04.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:05.03,0:15:06.30,Default,,0,0,0,,Иә?what up?
Dialogue: 0,0:15:06.37,0:15:09.14,Default,,0,0,0,,Сіз мені бірінші рет осылай атадыңыз.
Dialogue: 0,0:15:09.24,0:15:11.57,Default,,0,0,0,,А... Кешіріңіз, бұл біртүрлі болды ма?
Dialogue: 0,0:15:11.67,0:15:14.54,Default,,0,0,0,,Жоқ, мен күтемін.
Dialogue: 0,0:15:14.64,0:15:16.44,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:17.01,0:15:18.91,Default,,0,0,0,,Міне болды!Бұл қалайы әйел!
Dialogue: 0,0:15:19.01,0:15:20.25,Default,,0,0,0,,Сіз бұрын сыртқа қараған болуыңыз керек.
Dialogue: 0,0:15:20.35,0:15:23.12,Default,,0,0,0,,Шпион! Сіз шпионсыз ба? (Вилетта) Ха...
Dialogue: 0,0:15:23.22,0:15:24.92,Default,,0,0,0,,Көтерілісші күштердің жақындауына байланысты
Dialogue: 0,0:15:25.02,0:15:26.95,Default,,0,0,0,,Геттодағы қауіпсіздік нашарлап барады.
Dialogue: 0,0:15:27.05,0:15:29.56,Default,,0,0,0,,Үкіметтің қосымша хабарламасына дейін азаматтар...
Dialogue: 0,0:15:29.66,0:15:31.96,Default,,0,0,0,,Үйден шықпауыңызды өтінемін.
Dialogue: 0,0:15:32.53,0:15:35.10,Default,,0,0,0,,Бұл да ұрыс алаңына айнала ма...
Dialogue: 0,0:15:35.33,0:15:36.63,Default,,0,0,0,,Ал... Олай емес.
Dialogue: 0,0:15:36.93,0:15:40.33,Default,,0,0,0,,Губернатор Корнелияның тұрақты әскері сонда, солай ма? Жоқ, жоқ
Dialogue: 0,0:15:40.43,0:15:41.40,Default,,0,0,0,,Менің ойымша, солай
Dialogue: 0,0:15:42.10,0:15:45.14,Default,,0,0,0,,Ондай сөздерді айтпа. Бұл қорқынышты, солай ма?
Dialogue: 0,0:15:45.24,0:15:47.94,Default,,0,0,0,,Нуннали, сен әлі оралмадың ба? Лелуш
Dialogue: 0,0:15:48.14,0:15:49.34,Default,,0,0,0,,Лелуч... Лелуч?
Dialogue: 0,0:15:49.44,0:15:50.48,Default,,0,0,0,,Не болды?
Dialogue: 0,0:15:50.58,0:15:52.08,Default,,0,0,0,,А... шынымен емес.
Dialogue: 0,0:15:52.41,0:15:56.45,Default,,0,0,0,,Эй, уайымдама, мені Лулу деп ата, жарасамыз.
Dialogue: 0,0:15:56.58,0:16:00.39,Default,,0,0,0,,Лулу?Мені осылай атадың ба?
Dialogue: 0,0:16:00.49,0:16:03.16,Default,,0,0,0,,Мұны тағы да айтыңыз
Dialogue: 0,0:16:04.19,0:16:05.36,Default,,0,0,0,,Лулу
Dialogue: 0,0:16:06.99,0:16:09.13,Default,,0,0,0,,Нина, мектеп қабатына қайт! ―
Dialogue: 0,0:16:09.23,0:16:11.27,Default,,0,0,0,,Көтерілісшілер әскері Токиоға жақындап қалды?
Dialogue: 0,0:16:11.63,0:16:14.67,Default,,0,0,0,,Мен нөлдің келе жатқанын білемін, солай ма?
Dialogue: 0,0:16:16.14,0:16:18.64,Default,,0,0,0,,Күте тұрыңыз, Эфемия-сама.
Dialogue: 0,0:16:18.74,0:16:21.71,Default,,0,0,0,,Мен міндетті түрде жауды өлтіремін.
Dialogue: 0,0:16:22.64,0:16:26.35,Default,,0,0,0,,Юффи мен білмеймін
Dialogue: 0,0:16:26.45,0:16:28.45,Default,,0,0,0,,Неге олай істедің...
Dialogue: 0,0:16:28.55,0:16:29.65,Default,,0,0,0,,) Айтайын ба?
Dialogue: 0,0:16:29.75,0:16:30.62,Default,,0,0,0,,Ах-
Dialogue: 0,0:16:31.39,0:16:33.39,Default,,0,0,0,,Не? бала? ―
Dialogue: 0,0:16:33.49,0:16:35.19,Default,,0,0,0,,Неліктен Avalon?
Dialogue: 0,0:16:35.46,0:16:38.46,Default,,0,0,0,,Танысқаныма қуаныштымын Сузаку Куруруги
Dialogue: 0,0:16:38.66,0:16:40.39,Default,,0,0,0,,Менің атым В.В.
Dialogue: 0,0:16:41.60,0:16:42.50,Default,,0,0,0,,Ｖ.Ｖ.？
Dialogue: 0,0:16:50.70,0:16:52.34,Default,,0,0,0,,Ацуги сызығы да бұзылды.
Dialogue: 0,0:16:52.44,0:16:53.67,Default,,0,0,0,,Отандық күштер
Dialogue: 0,0:16:53.77,0:16:55.28,Default,,0,0,0,,Қазірдің өзінде уақыт келді
Dialogue: 0,0:16:55.38,0:16:57.28,Default,,0,0,0,,Ендеше бұл аймақты әзірге тастап көрейік.
Dialogue: 0,0:16:57.38,0:16:59.25,Default,,0,0,0,,Дүрбелең емес! (Сарбаздар) А.
Dialogue: 0,0:17:00.18,0:17:02.32,Default,,0,0,0,,Корнелия...
Dialogue: 0,0:17:02.58,0:17:05.02,Default,,0,0,0,,Graston Knights күту режиміне қойылды.
Dialogue: 0,0:17:05.12,0:17:07.55,Default,,0,0,0,,Барлық күштер Токио концессиясының сыртқы шетінде лагерь құрды!
Dialogue: 0,0:17:07.65,0:17:11.32,Default,,0,0,0,,Нөл Қара рыцарларды талқандағанша, көтеріліс басылады!
Dialogue: 0,0:17:11.43,0:17:14.26,Default,,0,0,0,,Корнелияны жеңе алсақ, біз жеңеміз.
Dialogue: 0,0:17:14.36,0:17:17.56,Default,,0,0,0,,Барлық әскерлер! Стратегия картасын орындаңыз және күтіңіз.
Dialogue: 0,0:17:18.40,0:17:21.10,Default,,0,0,0,,Диетард Алдыңғы қатар - Тодо-
Dialogue: 0,0:17:21.20,0:17:23.04,Default,,0,0,0,,Мен мұны сізге қалдырамын.
Dialogue: 0,0:17:23.37,0:17:24.24,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:17:24.71,0:17:25.67,Default,,0,0,0,,Ах-
Dialogue: 0,0:17:25.77,0:17:27.17,Default,,0,0,0,,Императордың…
Dialogue: 0,0:17:27.27,0:17:29.18,Default,,0,0,0,,Жақсы, мен оны уақытында жасадым.
Dialogue: 0,0:17:29.54,0:17:33.38,Default,,0,0,0,,Сіз мені тастап, шайқасқа кеткеніңіз қорқынышты.
Dialogue: 0,0:17:33.48,0:17:37.32,Default,,0,0,0,,Мен сенің дебютіңнен бері жанкүйермін.
Dialogue: 0,0:17:37.42,0:17:40.45,Default,,0,0,0,,Мен ақыры дұрыс сөйлесе аламыз деп ойладым.
Dialogue: 0,0:17:40.55,0:17:42.66,Default,,0,0,0,,Бойыңыз: Сіз таңқаларлықтай ұзынсыз.
Dialogue: 0,0:17:42.76,0:17:45.49,Default,,0,0,0,,Бірақ уайымдамаңыз, біз жақында жетеміз.
Dialogue: 0,0:17:45.59,0:17:47.16,Default,,0,0,0,,Немесе... Кагурая-сама...
Dialogue: 0,0:17:47.26,0:17:50.10,Default,,0,0,0,,Алты үйдің мүшелері Фудзиде қалуы керек емес пе еді?
Dialogue: 0,0:17:50.50,0:17:54.20,Default,,0,0,0,,Күйеуімнің қалай ұрысқанын көрейін деп артынан қудым.
Dialogue: 0,0:17:54.30,0:17:55.27,Default,,0,0,0,,Не? (C.C.) Иә?
Dialogue: 0,0:17:55.37,0:17:56.40,Default,,0,0,0,,Көңілді болыңыз
Dialogue: 0,0:17:56.47,0:18:00.64,Default,,0,0,0,,Бұл шайқаста жеңсек, маған бір күні әйел керек болар, солай ма?
Dialogue: 0,0:18:00.74,0:18:03.34,Default,,0,0,0,,Шын бетіңізді көрсете алмасаңыз
Dialogue: 0,0:18:03.44,0:18:06.08,Default,,0,0,0,,Менің ойымша, мұның орнын толтыратын адам бар ма?
Dialogue: 0,0:18:06.45,0:18:09.25,Default,,0,0,0,,Сіз жеңе аламын деп ойлайсыз ба? бұл шайқас
Dialogue: 0,0:18:09.48,0:18:12.45,Default,,0,0,0,,Иә, мен жеңістің құдайымын.
Dialogue: 0,0:18:12.69,0:18:14.29,Default,,0,0,0,,Бұл сенімді.
Dialogue: 0,0:18:14.39,0:18:18.43,Default,,0,0,0,,Бірақ, өкінішке орай, мен шайтанмен мәміле жасап қойғанмын.
Dialogue: 0,0:18:18.53,0:18:19.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:20.66,0:18:24.16,Default,,0,0,0,,Мен қазір Құдаймен тіл табыса алмаймын.
Dialogue: 0,0:18:28.40,0:18:31.47,Default,,0,0,0,,Асығыңыз!Жапонияға тәжірибе жасауға жарамды тірі ағзаларды әкелу
Dialogue: 0,0:18:31.57,0:18:32.71,Default,,0,0,0,,Қысым! (Батли) Ах.
Dialogue: 0,0:18:33.24,0:18:35.38,Default,,0,0,0,,Ішкі қысым көтерілуде...
Dialogue: 0,0:18:35.71,0:18:37.11,Default,,0,0,0,,Уау, аа!
Dialogue: 0,0:18:40.58,0:18:42.78,Default,,0,0,0,,Уф... Осындай кездері
Dialogue: 0,0:18:49.36,0:18:51.53,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:18:53.76,0:18:55.90,Default,,0,0,0,,Тыңда, Британия.
Dialogue: 0,0:18:56.20,0:18:57.50,Default,,0,0,0,,Менің атым – Нөл.
Dialogue: 0,0:18:58.30,0:19:01.14,Default,,0,0,0,,Күштілерге қарсы бүлікші болу.
Dialogue: 0,0:19:01.67,0:19:05.34,Default,,0,0,0,,Сағат 0-ге дейін күтіп, берілейік және өз қақпамызға түсейік.
Dialogue: 0,0:19:05.61,0:19:10.84,Default,,0,0,0,,Бұл ультиматум. Түн ортасына дейін күтіңіз. Менің қақпама түс.
Dialogue: 0,0:19:15.35,0:19:15.92,Default,,0,0,0,,Нуу…
Dialogue: 0,0:19:16.22,0:19:18.49,Default,,0,0,0,,Генерал Далтон: Бұл мүмкін емес.
Dialogue: 0,0:19:18.59,0:19:22.22,Default,,0,0,0,,Маған бәрібір, ханшайымды... ханшайымға апар...
Dialogue: 0,0:19:22.69,0:19:24.93,Default,,0,0,0,,Бұл пайдасыз қауіп, Нөл.
Dialogue: 0,0:19:25.23,0:19:27.69,Default,,0,0,0,,Токио концессиясы да бекіністі қала болып табылады.
Dialogue: 0,0:19:29.93,0:19:32.30,Default,,0,0,0,,Сіз әлі де орала аласыз, солай ма?
Dialogue: 0,0:19:32.87,0:19:35.47,Default,,0,0,0,,Егер бәрі осылай жалғаса берсе, 11-аймақ жеткіліксіз болады.
Dialogue: 0,0:19:36.17,0:19:40.41,Default,,0,0,0,,Бүкіл әлем, сіздің өміріңіз шайқасқа толы.
Dialogue: 0,0:19:40.61,0:19:43.31,Default,,0,0,0,,Мен білемін, бірақ мен...
Dialogue: 0,0:19:43.41,0:19:44.71,Default,,0,0,0,,Иә? ―
Dialogue: 0,0:19:46.21,0:19:46.88,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:47.58,0:19:50.62,Default,,0,0,0,,Юффи? Ақымақ...оның нөмірі...
Dialogue: 0,0:19:50.88,0:19:53.55,Default,,0,0,0,,Жоқ, қатып қалған біреу бар.
Dialogue: 0,0:19:55.29,0:19:56.26,Default,,0,0,0,,Цк
Dialogue: 0,0:19:58.43,0:20:00.66,Default,,0,0,0,,Лелух Бұл менмін
Dialogue: 0,0:20:00.76,0:20:03.76,Default,,0,0,0,,Созакуда не болды? Осындай кездерде
Dialogue: 0,0:20:04.30,0:20:06.47,Default,,0,0,0,,Лелуш қазір мектепте ме?
Dialogue: 0,0:20:06.70,0:20:09.67,Default,,0,0,0,,Жоқ, бірақ мен жақында үйде боламын.
Dialogue: 0,0:20:09.77,0:20:10.64,Default,,0,0,0,,Иә-
Dialogue: 0,0:20:10.74,0:20:13.84,Default,,0,0,0,,Мен барлығына айтқым келген бірдеңе болғандықтан қоңырау шалдым.
Dialogue: 0,0:20:14.34,0:20:16.28,Default,,0,0,0,,Не? Осындай кездерде
Dialogue: 0,0:20:16.38,0:20:19.41,Default,,0,0,0,,Аспанға қара... Мен сенің аспанға қарағаныңды қаламаймын.
Dialogue: 0,0:20:19.51,0:20:20.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:20.91,0:20:22.75,Default,,0,0,0,,Лелуш
Dialogue: 0,0:20:22.85,0:20:26.62,Default,,0,0,0,,Сіз біреуді жек көретіндіктен, оны өлтіргіңіз келеді ме?
Dialogue: 0,0:20:27.92,0:20:29.56,Default,,0,0,0,,О, мен бармын
Dialogue: 0,0:20:30.36,0:20:32.99,Default,,0,0,0,,Мен олай ойламауым керек деп ойладым.
Dialogue: 0,0:20:33.53,0:20:37.73,Default,,0,0,0,,Ережеге сай ұрыспасаң, адамдарды өлтіресің...
Dialogue: 0,0:20:38.90,0:20:42.37,Default,,0,0,0,,Бірақ қазір мені жек көрушілік билейді...
Dialogue: 0,0:20:43.00,0:20:45.94,Default,,0,0,0,,Біреуді өлтіру үшін күресуге әрекеттену
Dialogue: 0,0:20:47.57,0:20:50.78,Default,,0,0,0,,Барлығы бар Токио аспанындағы кісі өлтіру...
Dialogue: 0,0:20:51.45,0:20:52.28,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:20:52.28,0:20:52.65,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:20:52.28,0:20:52.65,Default,,0,0,0,,Жек көру дұрыс емес
Dialogue: 0,0:20:52.65,0:20:52.75,Default,,0,0,0,,Жек көру дұрыс емес
Dialogue: 0,0:20:52.75,0:20:53.45,Default,,0,0,0,,Жек көру дұрыс емес
Dialogue: 0,0:20:52.75,0:20:53.45,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:53.45,0:20:53.61,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:53.85,0:20:55.28,Default,,0,0,0,,Бұл Юффиге арналған, солай ма?
Dialogue: 0,0:20:55.38,0:20:58.29,Default,,0,0,0,,Оның үстіне, мен баяғыда шешім қабылдадым.
Dialogue: 0,0:20:58.39,0:21:00.52,Default,,0,0,0,,Менің кері қайтуға ниетім жоқ.
Dialogue: 0,0:21:00.62,0:21:01.72,Default,,0,0,0,,Nunnally үшін?
Dialogue: 0,0:21:01.82,0:21:02.62,Default,,0,0,0,,Ах-
Dialogue: 0,0:21:03.66,0:21:04.96,Default,,0,0,0,,Оны кесіп алайық. Уақыт келді.
Dialogue: 0,0:21:05.39,0:21:06.93,Default,,0,0,0,,Рахмет Лелуч
Dialogue: 0,0:21:07.03,0:21:10.93,Default,,0,0,0,,Уайымдама, біз доспыз, солай ма?
Dialogue: 0,0:21:11.03,0:21:12.73,Default,,0,0,0,,Осыдан 7 жыл бұрын
Dialogue: 0,0:21:12.83,0:21:14.70,Default,,0,0,0,,О, кездескенше
Dialogue: 0,0:21:14.80,0:21:16.84,Default,,0,0,0,,Олай болса, кейінірек.
Dialogue: 0,0:21:23.31,0:21:23.98,Default,,0,0,0,,Не!
Dialogue: 0,0:21:33.05,0:21:36.89,Default,,0,0,0,,Созаку, менің қолым лас.
Dialogue: 0,0:21:36.99,0:21:39.73,Default,,0,0,0,,Маған әлі келсеңіз, маған бәрібір.
Dialogue: 0,0:21:39.83,0:21:44.46,Default,,0,0,0,,Қош келдіңіздер, біз доспыз.
Dialogue: 0,0:21:44.56,0:21:46.73,Default,,0,0,0,,Хехе...
Dialogue: 0,0:21:46.83,0:21:49.47,Default,,0,0,0,,Хаха...
Dialogue: 0,0:21:49.54,0:21:53.54,Default,,0,0,0,,(Лелуштың күлкісі)
Dialogue: 0,0:21:55.88,0:21:59.95,Default,,0,0,0,,Бәлкім, мен оны сол күннен бері қалаған шығармын.
Dialogue: 0,0:22:00.05,0:22:02.62,Default,,0,0,0,,Барлық жойылу мен жоғалту -
Dialogue: 0,0:22:02.72,0:22:06.42,Default,,0,0,0,,Иә, жаратылғанға дейін жойылу керек.
Dialogue: 0,0:22:06.52,0:22:11.49,Default,,0,0,0,,Осы себепті сіздің ойыңыз кедергі болса, оны өшіріп тастаңыз.
Dialogue: 0,0:22:11.59,0:22:12.86,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:22:13.09,0:22:15.60,Default,,0,0,0,,Менің ары қарай қозғалудан басқа амалым жоқ.
Dialogue: 0,0:22:16.00,0:22:17.36,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:22:18.03,0:22:21.70,Default,,0,0,0,,♪Мозаикалық бөлік бір-бірден
Dialogue: 0,0:22:21.80,0:22:25.51,Default,,0,0,0,,♪Қосыңыз және сызыңыз
Dialogue: 0,0:22:25.61,0:22:32.61,Default,,0,0,0,,♪Сен маған сыйлаған кездесулер мен қоштасулар
Dialogue: 0,0:22:41.12,0:22:48.13,Default,,0,0,0,,♪Бұлай болуы мүмкін емес,-деп ойланып, ұйқыға кеттім
Dialogue: 0,0:22:48.63,0:22:51.90,Default,,0,0,0,,♪Мен оянсам, әдеттегідей
Dialogue: 0,0:22:52.00,0:22:56.40,Default,,0,0,0,,♪ Өзгеріссіз бос жүріс
Dialogue: 0,0:22:56.50,0:23:01.68,Default,,0,0,0,,♪ Мағынасыз қайталанады
Dialogue: 0,0:23:02.54,0:23:06.55,Default,,0,0,0,,♪Мозаикалық үзінділер жанды түрде бейнеленген
Dialogue: 0,0:23:06.65,0:23:09.72,Default,,0,0,0,,♪Бұрынғы өтірік пен қателіктер
Dialogue: 0,0:23:09.82,0:23:16.82,Default,,0,0,0,,♪Оны өшіргім келген сайын, ол туралы көбірек ойлаймын
Dialogue: 0,0:23:17.39,0:23:18.63,Default,,0,0,0,,♪Артқа қарап
Dialogue: 0,0:23:18.73,0:23:21.93,Default,,0,0,0,,♪Бастау сызығы бар
Dialogue: 0,0:23:22.03,0:23:24.53,Default,,0,0,0,,♪Әлі прогресс жоқ
Dialogue: 0,0:23:24.63,0:23:31.64,Default,,0,0,0,,♪Тағыда армандарымызды жинайық
Dialogue: 0,0:23:32.01,0:23:35.58,Default,,0,0,0,,♪Мозаикалық бөлік бір-бірден
Dialogue: 0,0:23:35.68,0:23:39.18,Default,,0,0,0,,♪Қосыңыз және сызыңыз
Dialogue: 0,0:23:39.48,0:23:46.49,Default,,0,0,0,,♪Сен маған сыйлаған кездесулер мен қоштасулар
Dialogue: 0,0:23:49.86,0:23:51.16,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:23:51.46,0:23:53.89,Default,,0,0,0,,Алға ұмтылу – менің жалғыз өтеуім.
Dialogue: 0,0:23:53.99,0:23:57.00,Default,,0,0,0,,Қарсылас дүние жүзіндегі ең үлкен империя болса да...
Dialogue: 0,0:23:57.10,0:24:00.20,Default,,0,0,0,,Енді менің артыма қарауға жол жоқ.
Dialogue: 0,0:24:00.53,0:24:02.94,Default,,0,0,0,,Барлық жоспарлар аяқталды.
Dialogue: 0,0:24:03.04,0:24:06.51,Default,,0,0,0,,Қазір ескіні үзетін уақыт
Dialogue: 0,0:24:08.01,0:24:14.01,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory