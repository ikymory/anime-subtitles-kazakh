Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.30,0:00:09.24,Default,,0,0,0,,Қасиетті Британ империясы
Dialogue: 0,0:00:09.34,0:00:13.61,Default,,0,0,0,,Тақтың он жетінші мұрагері Лелух ви Британия-
Dialogue: 0,0:00:13.71,0:00:15.04,Default,,0,0,0,,Келу
Dialogue: 0,0:00:17.28,0:00:18.35,Default,,0,0,0,,Императрица Марианна...
Dialogue: 0,0:00:18.45,0:00:20.52,Default,,0,0,0,,Мен оның Британ сарайында өлтірілгенін естідім.
Dialogue: 0,0:00:20.62,0:00:24.02,Default,,0,0,0,,Бұл лаңкестердің кіруі оңай жер емес.
Dialogue: 0,0:00:24.12,0:00:26.19,Default,,0,0,0,,Демек, Макотоның кінәсі
Dialogue: 0,0:00:26.29,0:00:30.29,Default,,0,0,0,,Қорқынышты, қорқынышты, осындай оқиғалар, тіпті оларды зерттеу қорқынышты.
Dialogue: 0,0:00:30.39,0:00:32.69,Default,,0,0,0,,Бірақ анасы өлтірілсе де...
Dialogue: 0,0:00:32.79,0:00:34.26,Default,,0,0,0,,Сіз беріксіз.
Dialogue: 0,0:00:34.36,0:00:36.63,Default,,0,0,0,,Бірақ Лелуш-саманың бүршіктері енді жоқ.
Dialogue: 0,0:00:36.73,0:00:39.43,Default,,0,0,0,,Мені қолдаған Эшфорд отбасы да бітті.
Dialogue: 0,0:00:39.53,0:00:40.70,Default,,0,0,0,,Сіздің қарындасыңыз ханшайым ше?
Dialogue: 0,0:00:40.80,0:00:42.14,Default,,0,0,0,,Ол аяғына оқ тиген.
Dialogue: 0,0:00:42.24,0:00:43.41,Default,,0,0,0,,Соқырлық
Dialogue: 0,0:00:43.51,0:00:45.54,Default,,0,0,0,,Мен мұны психикалық ауру деп естідім.
Dialogue: 0,0:00:45.64,0:00:49.38,Default,,0,0,0,,Дәл сол нәрсе, саясатқа қолдануға болмайтын дене.
Dialogue: 0,0:00:50.78,0:00:53.78,Default,,0,0,0,,Мәртебелі император, менің анам жүкті.
Dialogue: 0,0:00:54.08,0:00:55.45,Default,,0,0,0,,ертең оны үйіңізге әкеліп береміз.
Dialogue: 0,0:00:55.55,0:00:56.68,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:00:56.79,0:00:58.75,Default,,0,0,0,,Мұны айту үшін сіз...
Dialogue: 0,0:00:59.05,0:01:01.56,Default,,0,0,0,,Британ императорымен аудиторияны сұрадыңыз ба?
Dialogue: 0,0:01:02.16,0:01:04.73,Default,,0,0,0,,Келесі адамды жұбатуға уақытым жоқ.
Dialogue: 0,0:01:04.83,0:01:05.69,Default,,0,0,0,,Әке!
Dialogue: 0,0:01:08.46,0:01:09.76,Default,,0,0,0,,Мәртебелі Иса
Dialogue: 0,0:01:10.07,0:01:12.10,Default,,0,0,0,,Сен неге анаңды қорғамадың? ―
Dialogue: 0,0:01:12.47,0:01:15.74,Default,,0,0,0,,Император, солай ма? Ол осы елдің ең ұлысы, солай ма? ―
Dialogue: 0,0:01:15.84,0:01:17.41,Default,,0,0,0,,Оны қорғауға болар еді.
Dialogue: 0,0:01:17.51,0:01:19.67,Default,,0,0,0,,Кем дегенде ол Нанналлидің орнында бетін көрсетеді...
Dialogue: 0,0:01:19.77,0:01:21.34,Default,,0,0,0,,Әлсізге пайда жоқ
Dialogue: 0,0:01:22.11,0:01:22.84,Default,,0,0,0,,Әлсіз бе?
Dialogue: 0,0:01:23.14,0:01:26.15,Default,,0,0,0,,Императорлық отбасының бәрі осы.
Dialogue: 0,0:01:26.25,0:01:28.25,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:28.35,0:01:31.65,Default,,0,0,0,,Олай болса маған тағы мұрагер болу құқығының керегі жоқ.
Dialogue: 0,0:01:31.75,0:01:33.46,Default,,0,0,0,,О...
Dialogue: 0,0:01:33.56,0:01:34.82,Default,,0,0,0,,Сіздің ізіңізбен жүру
Dialogue: 0,0:01:35.12,0:01:37.73,Default,,0,0,0,,Ұрыс-керіске шыдадым.
Dialogue: 0,0:01:37.83,0:01:39.59,Default,,0,0,0,,Өлі (Лелух) Уф
Dialogue: 0,0:01:39.69,0:01:43.30,Default,,0,0,0,,Сен туылғаннан бері өлдің.
Dialogue: 0,0:01:43.40,0:01:45.73,Default,,0,0,0,,Киген киіміңді саған кім берді? ―
Dialogue: 0,0:01:46.30,0:01:50.54,Default,,0,0,0,,Үй де, тамақ та, тіпті өмір де маған берілген.
Dialogue: 0,0:01:50.84,0:01:54.24,Default,,0,0,0,,Демек, сіз ешқашан өмір сүрмегенсіз.
Dialogue: 0,0:01:54.34,0:01:56.85,Default,,0,0,0,,Бірақ қандай ақымақтық!
Dialogue: 0,0:01:57.15,0:01:58.85,Default,,0,0,0,,Әй, уау
Dialogue: 0,0:01:59.15,0:02:00.75,Default,,0,0,0,,Лелуш
Dialogue: 0,0:02:00.85,0:02:06.19,Default,,0,0,0,,Өлгеннен бері сіздің құқығыңыз жоқ. Nunnally-мен Жапонияға барыңыз.
Dialogue: 0,0:02:06.29,0:02:10.46,Default,,0,0,0,,Ханзада мен ханшайым - жақсы сауда-саттық материалдары.
Dialogue: 0,0:02:10.79,0:02:16.80,Default,,0,0,0,,♪～
Dialogue: 0,0:02:19.13,0:02:22.84,Default,,0,0,0,,♪Өзім, тіпті әлем
Dialogue: 0,0:02:23.14,0:02:26.41,Default,,0,0,0,,♪Мен оны өзгерте аламын деп ойлаймын.
Dialogue: 0,0:02:26.51,0:02:32.28,Default,,0,0,0,,♪Сәт әрқашан жаныңда...
Dialogue: 0,0:02:34.32,0:02:40.62,Default,,0,0,0,,♪Жасырынбаған тітіркену
Dialogue: 0,0:02:41.36,0:02:47.63,Default,,0,0,0,,♪ Бір орында тұрып өзіңе қара
Dialogue: 0,0:02:47.73,0:02:51.23,Default,,0,0,0,,♪ойланып отырып, уайымдап
Dialogue: 0,0:02:51.33,0:02:54.64,Default,,0,0,0,,♪Өкінішпен шешім қабылдау керек.
Dialogue: 0,0:02:54.74,0:02:58.24,Default,,0,0,0,,♪Сен маған берген бір сөз
Dialogue: 0,0:02:58.34,0:03:01.88,Default,,0,0,0,,♪Менің шатасуым жоғалады
Dialogue: 0,0:03:02.18,0:03:08.38,Default,,0,0,0,,♪Бос бөлмеме жарық түсті.
Dialogue: 0,0:03:08.72,0:03:11.92,Default,,0,0,0,,♪Мен қараған аспан
Dialogue: 0,0:03:12.25,0:03:15.79,Default,,0,0,0,,♪Ашық және көк болып барады
Dialogue: 0,0:03:15.89,0:03:22.36,Default,,0,0,0,,♪Мен жабық терезені ашуды шештім.
Dialogue: 0,0:03:22.60,0:03:26.47,Default,,0,0,0,,♪Өзім, тіпті әлем
Dialogue: 0,0:03:26.57,0:03:29.60,Default,,0,0,0,,♪Мен оны өзгерте аламын деп ойлаймын.
Dialogue: 0,0:03:29.97,0:03:36.48,Default,,0,0,0,,♪Сәтті сезін, осында және қазір...
Dialogue: 0,0:03:48.42,0:03:50.73,Default,,0,0,0,,Жетінші ұрпақ түнгі кадр...
Dialogue: 0,0:03:50.83,0:03:52.49,Default,,0,0,0,,Оның қабілеті қалыпты...
Dialogue: 0,0:03:52.59,0:03:55.53,Default,,0,0,0,,Мен Ланселот ұшқышының он бір екенін естідім.
Dialogue: 0,0:03:55.73,0:03:58.47,Default,,0,0,0,,Иә, мен құрметті британдықпын, бірақ...
Dialogue: 0,0:03:58.77,0:04:02.84,Default,,0,0,0,,Мен қатардағы офицерден прапорщикке дейін көтерілдім, сондықтан оған қанағаттаныңыз.
Dialogue: 0,0:04:02.94,0:04:06.01,Default,,0,0,0,,Сандарға сенбесем де, жеңе алатынымды көрсетемін.
Dialogue: 0,0:04:07.01,0:04:09.34,Default,,0,0,0,,Өйткені біз өз өміріміз үшін күресеміз...
Dialogue: 0,0:04:09.44,0:04:10.88,Default,,0,0,0,,Басқаруға жарамды -
Dialogue: 0,0:04:10.98,0:04:13.95,Default,,0,0,0,,Мен логиканы түсіндім, апа.
Dialogue: 0,0:04:14.25,0:04:14.92,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:04:17.32,0:04:19.65,Default,,0,0,0,,Кешіріңіз, мен сізден үй тапсырмасын тексеруді сұрауым керек еді.
Dialogue: 0,0:04:19.75,0:04:20.76,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:04:20.86,0:04:23.29,Default,,0,0,0,,Мен қарапайым мектепте оқымадым.
Dialogue: 0,0:04:23.39,0:04:24.29,Default,,0,0,0,,Менің таңдауым жоқ.
Dialogue: 0,0:04:24.49,0:04:26.83,Default,,0,0,0,,Мұны маған студенттік кеңес мүшелері де айтты.
Dialogue: 0,0:04:26.93,0:04:27.80,Default,,0,0,0,,Өте...
Dialogue: 0,0:04:27.90,0:04:29.00,Default,,0,0,0,,Кристалда жарық жүздеген миллион рет шағылады—
Dialogue: 0,0:04:29.30,0:04:32.00,Default,,0,0,0,,Шынымды айтсам, біраз уайымдадым.
Dialogue: 0,0:04:32.30,0:04:35.77,Default,,0,0,0,,Ашық мектеп болса да, мен оған сыймаймын деп ойлаймын.
Dialogue: 0,0:04:35.87,0:04:37.74,Default,,0,0,0,,Мен де дайындалдым.
Dialogue: 0,0:04:37.84,0:04:41.51,Default,,0,0,0,,Бірақ кездейсоқ менің ескі досым болды және ол мені шабыттандырды ...
Dialogue: 0,0:04:41.61,0:04:43.95,Default,,0,0,0,,Сол досыңа қамқор бол.
Dialogue: 0,0:04:44.05,0:04:48.58,Default,,0,0,0,,Достығымыз жалғаса берсе, бас қосуымыз кездейсоқтық емес, қажеттілік болады.
Dialogue: 0,0:04:48.68,0:04:50.79,Default,,0,0,0,,Иә, оны жеп көріңіз.
Dialogue: 0,0:04:50.95,0:04:53.52,Default,,0,0,0,,Аа, көп рахмет.
Dialogue: 0,0:04:54.69,0:04:56.56,Default,,0,0,0,,Мен сіздің әсерлеріңізді тыңдағым келеді.
Dialogue: 0,0:04:56.66,0:04:57.59,Default,,0,0,0,,Кептеліс пе?
Dialogue: 0,0:04:58.06,0:05:00.30,Default,,0,0,0,,Мен әдемі көкжидек алдым.
Dialogue: 0,0:05:00.40,0:05:01.60,Default,,0,0,0,,Иә
Dialogue: 0,0:05:01.70,0:05:04.53,Default,,0,0,0,,Еріту Еріту!Бүгін кезек жоқ!
Dialogue: 0,0:05:04.63,0:05:07.40,Default,,0,0,0,,Сәлем! ―
Dialogue: 0,0:05:07.50,0:05:09.07,Default,,0,0,0,,Бітті!Күрсін
Dialogue: 0,0:05:09.60,0:05:10.84,Default,,0,0,0,,Ал...
Dialogue: 0,0:05:10.94,0:05:11.81,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:12.37,0:05:13.98,Default,,0,0,0,,Мектеп, жүр.
Dialogue: 0,0:05:14.08,0:05:15.71,Default,,0,0,0,,Бүгінгі сабақ аяқталды, бірақ-
Dialogue: 0,0:05:15.81,0:05:18.51,Default,,0,0,0,,Достармен кездесу де маңызды.
Dialogue: 0,0:05:18.91,0:05:21.68,Default,,0,0,0,,Эй, мен сенен маңызды нәрсе сұрасам болады ма?
Dialogue: 0,0:05:21.78,0:05:22.95,Default,,0,0,0,,Не?
Dialogue: 0,0:05:23.95,0:05:26.49,Default,,0,0,0,,Карен, сен бізден бірдеңе жасырып тұрсың ба?
Dialogue: 0,0:05:26.59,0:05:27.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:27.59,0:05:29.32,Default,,0,0,0,,Жарайды, оны жасырудың қажеті жоқ.
Dialogue: 0,0:05:29.42,0:05:31.33,Default,,0,0,0,,Ал, сен не туралы айтып тұрсың?
Dialogue: 0,0:05:31.86,0:05:35.10,Default,,0,0,0,,Айтыңызшы, мен таң қалмаймын.
Dialogue: 0,0:05:35.40,0:05:37.53,Default,,0,0,0,,Мен оны басқа күні көрдім.
Dialogue: 0,0:05:37.73,0:05:38.67,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:38.80,0:05:39.77,Default,,0,0,0,,(Мысықтың мияулауы)
Dialogue: 0,0:05:40.47,0:05:41.74,Default,,0,0,0,,Сіз Лулумен кездесесіз бе?
Dialogue: 0,0:05:41.84,0:05:42.70,Default,,0,0,0,,Лулу?
Dialogue: 0,0:05:43.07,0:05:45.04,Default,,0,0,0,,Өйткені өткен күні мектеп ауласында...
Dialogue: 0,0:05:46.37,0:05:49.08,Default,,0,0,0,,Жоқ, жоқ, күте тұрыңыз, олар мұны өз бетімен жасады ...
Dialogue: 0,0:05:49.38,0:05:50.04,Default,,0,0,0,,Лулудан?
Dialogue: 0,0:05:50.34,0:05:51.95,Default,,0,0,0,,Жоқ, олай емес...
Dialogue: 0,0:05:52.05,0:05:54.65,Default,,0,0,0,,Бірақ бір күні мен сол мысықты ұстамақ болдым.
Dialogue: 0,0:05:54.75,0:05:56.35,Default,,0,0,0,,Бұл басқаша, солай емес пе?
Dialogue: 0,0:05:56.45,0:05:57.72,Default,,0,0,0,,Және жай ғана сүйісу...
Dialogue: 0,0:05:57.82,0:06:00.49,Default,,0,0,0,,Сонымен, бұл одан да көп пе?
Dialogue: 0,0:06:00.59,0:06:02.59,Default,,0,0,0,,Ей, жоқ, біртүрлі нәрсені елестетуді доғар!
Dialogue: 0,0:06:02.69,0:06:04.39,Default,,0,0,0,,Айналаңызды көре алмайсыз!
Dialogue: 0,0:06:07.50,0:06:09.56,Default,,0,0,0,,Сонымен келіскен неке туралы...
Dialogue: 0,0:06:09.66,0:06:13.90,Default,,0,0,0,,Мен сіз Эшфорд отбасын қайта құрғыңыз келетінін түсінемін.
Dialogue: 0,0:06:14.60,0:06:15.84,Default,,0,0,0,,Бірақ, анашым.
Dialogue: 0,0:06:18.07,0:06:20.07,Default,,0,0,0,,(Пернетақтаны түрту дыбысы)
Dialogue: 0,0:06:20.37,0:06:21.84,Default,,0,0,0,,Әй, бөлінді!
Dialogue: 0,0:06:25.15,0:06:26.65,Default,,0,0,0,,Сайтама геттосын қоршау -
Dialogue: 0,0:06:26.75,0:06:27.65,Default,,0,0,0,,Орындалды -
Dialogue: 0,0:06:28.45,0:06:30.72,Default,,0,0,0,,Ямато альянсының жасырынуы осы аймақтың ішінде.
Dialogue: 0,0:06:31.42,0:06:35.66,Default,,0,0,0,,Маңайдағы тұрғындардың жартысынан көбі олардың серіктестері. Егер бұлай болса...
Dialogue: 0,0:06:35.92,0:06:37.89,Default,,0,0,0,,Жалпы өндіріске әсері қандай?
Dialogue: 0,0:06:37.99,0:06:41.00,Default,,0,0,0,,１ 0.2
Dialogue: 0,0:06:41.10,0:06:43.53,Default,,0,0,0,,Ол күтілетін ауқымда ма? Жақсы.
Dialogue: 0,0:06:44.10,0:06:45.07,Default,,0,0,0,,Балалар
Dialogue: 0,0:06:45.17,0:06:47.67,Default,,0,0,0,,Сіз Синдзюку оқиғасына қатыстыңыз, солай ма?
Dialogue: 0,0:06:47.84,0:06:50.81,Default,,0,0,0,,Рақымыңыз үшін рахмет, Мәртебелі Корнелия.
Dialogue: 0,0:06:50.91,0:06:52.84,Default,,0,0,0,,Бұлай емес.
Dialogue: 0,0:06:53.01,0:06:55.01,Default,,0,0,0,,Сіз оларды ұқсас деп ойламайсыз ба? (Көмекші рөлі)?
Dialogue: 0,0:06:55.54,0:06:56.94,Default,,0,0,0,,Синджуку жағдайы
Dialogue: 0,0:06:57.04,0:06:59.11,Default,,0,0,0,,Әскерилер террористерді қорғайды
Dialogue: 0,0:06:59.41,0:07:00.95,Default,,0,0,0,,Сайтама геттосына қарсы
Dialogue: 0,0:07:01.05,0:07:02.58,Default,,0,0,0,,Біз қоршау операциясын жүргізіп жатырмыз.
Dialogue: 0,0:07:03.05,0:07:07.16,Default,,0,0,0,,Губернатор Корнелия да аймаққа кірді, сондықтан кіруге шектеулер қойылды.
Dialogue: 0,0:07:07.46,0:07:08.46,Default,,0,0,0,,) Хехехе
Dialogue: 0,0:07:08.56,0:07:09.72,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:07:10.93,0:07:14.13,Default,,0,0,0,,Иә?Сонша қорқынышты көрінуіңе не болды?
Dialogue: 0,0:07:14.43,0:07:17.67,Default,,0,0,0,,Екі сағаттан кейін толық масштабты шабуыл басталатын сияқты.
Dialogue: 0,0:07:17.77,0:07:19.50,Default,,0,0,0,,Осымен келесі аймақ ...
Dialogue: 0,0:07:19.60,0:07:21.97,Default,,0,0,0,,Неліктен оларға уақыт бойынша есеп беруге рұқсат бересіз?
Dialogue: 0,0:07:22.07,0:07:24.11,Default,,0,0,0,,Сіз нөлді арандатып жатырсыз.
Dialogue: 0,0:07:24.94,0:07:27.04,Default,,0,0,0,,―
Dialogue: 0,0:07:27.71,0:07:28.88,Default,,0,0,0,,―
Dialogue: 0,0:07:28.98,0:07:31.78,Default,,0,0,0,,Мен Синджуку сияқты жағдайды жасауға батылдық жасадым.
Dialogue: 0,0:07:32.65,0:07:36.55,Default,,0,0,0,,Өзіне тым сенімді адам болса, келіп мені өлтіретін шығар.
Dialogue: 0,0:07:36.65,0:07:39.79,Default,,0,0,0,,Губернатор! Сонда губернатордың өмірі болады
Dialogue: 0,0:07:40.52,0:07:43.86,Default,,0,0,0,,Соғыс - мақтаныш пен өмір үшін күрес.
Dialogue: 0,0:07:44.89,0:07:47.63,Default,,0,0,0,,...
Dialogue: 0,0:07:47.80,0:07:49.86,Default,,0,0,0,,Ол мені шақыру үшін барын салды.
Dialogue: 0,0:07:50.10,0:07:53.20,Default,,0,0,0,,Сонымен қатар, мен Корнелиядан бір нәрсе сұрағым келеді.
Dialogue: 0,0:07:53.50,0:07:57.67,Default,,0,0,0,,Британияны жою және анамды өлтірген қылмыскерді табу.
Dialogue: 0,0:07:57.77,0:07:59.61,Default,,0,0,0,,Сіз үшін қайсысы маңызды?
Dialogue: 0,0:07:59.71,0:08:01.58,Default,,0,0,0,,２―
Dialogue: 0,0:08:01.68,0:08:02.98,Default,,0,0,0,,―
Dialogue: 0,0:08:03.08,0:08:06.11,Default,,0,0,0,,Келесі император кім болатыны үшін үнемі күресу.
Dialogue: 0,0:08:06.21,0:08:10.79,Default,,0,0,0,,Жоқ, мен үшін ол кісі төбелесіп жатыр.
Dialogue: 0,0:08:10.89,0:08:14.52,Default,,0,0,0,,Бірақ бұл Британияның күші.
Dialogue: 0,0:08:14.62,0:08:17.19,Default,,0,0,0,,Содан кейін аман қалған ең дарынды адам
Dialogue: 0,0:08:17.49,0:08:19.19,Default,,0,0,0,,...
Dialogue: 0,0:08:19.49,0:08:22.93,Default,,0,0,0,,Дұрыс, әлсіздер бәрінен айырылып, өседі...
Dialogue: 0,0:08:23.03,0:08:25.07,Default,,0,0,0,,Британия осындай ел.
Dialogue: 0,0:08:25.17,0:08:26.80,Default,,0,0,0,,Бұл дүние
Dialogue: 0,0:08:26.90,0:08:29.27,Default,,0,0,0,,Ең қолайлы - негізгі ереже.
Dialogue: 0,0:08:29.57,0:08:31.24,Default,,0,0,0,,Олай болса, Нуналлимен не болады?
Dialogue: 0,0:08:32.04,0:08:34.74,Default,,0,0,0,,Мен әлсіз болғандықтан бас тартуым керек пе? ―
Dialogue: 0,0:08:34.84,0:08:36.91,Default,,0,0,0,,Тек мен оны ешқашан мойындамаймын.
Dialogue: 0,0:08:37.11,0:08:40.62,Default,,0,0,0,,Мен ол дүниені өшіремін... Ах.
Dialogue: 0,0:08:43.05,0:08:47.05,Default,,0,0,0,,(Созакудың гуілі)
Dialogue: 0,0:08:49.12,0:08:51.89,Default,,0,0,0,,Әйтеуір, Лелуш екеуміздің бір-бірімізге еш қатысымыз жоқ.
Dialogue: 0,0:08:51.99,0:08:54.13,Default,,0,0,0,,Ах Лелуч?
Dialogue: 0,0:08:54.23,0:08:56.06,Default,,0,0,0,,Олай болса, болды
Dialogue: 0,0:08:56.16,0:08:57.30,Default,,0,0,0,,Бұл ештеңе емес
Dialogue: 0,0:08:57.60,0:08:58.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:59.03,0:09:00.74,Default,,0,0,0,,Лелуч ше?
Dialogue: 0,0:09:00.84,0:09:03.07,Default,,0,0,0,,Бұл адамның білуі мүмкін емес!
Dialogue: 0,0:09:03.17,0:09:04.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:04.71,0:09:06.14,Default,,0,0,0,,Барма, Лелуч
Dialogue: 0,0:09:06.24,0:09:10.01,Default,,0,0,0,,Менімен келісіміңді орындамай тұрып өлгеніңді қаламас едім.
Dialogue: 0,0:09:10.11,0:09:13.21,Default,,0,0,0,,Сіздің айтқаныңыз бен істегеніңіз басқа емес пе?
Dialogue: 0,0:09:13.31,0:09:17.15,Default,,0,0,0,,Мен сені өлтірмеймін, мен сені аяғыңа атып тастаймын және сені тыныштандырамын.
Dialogue: 0,0:09:17.72,0:09:20.86,Default,,0,0,0,,Түсіндім, сіз Geass қолданбасын пайдалана алмайсыз.
Dialogue: 0,0:09:20.96,0:09:21.89,Default,,0,0,0,,Уф
Dialogue: 0,0:09:22.26,0:09:24.69,Default,,0,0,0,,Мен мұны күттім.
Dialogue: 0,0:09:24.79,0:09:27.96,Default,,0,0,0,,Егер сіз мұны өзіңіз жасай алсаңыз, менен мұны сұрамас едіңіз.
Dialogue: 0,0:09:29.73,0:09:32.07,Default,,0,0,0,,Мен мылтықтан қорқамын деп ойлайсың ба?
Dialogue: 0,0:09:32.27,0:09:34.17,Default,,0,0,0,,Мен қорқамын
Dialogue: 0,0:09:36.80,0:09:38.01,Default,,0,0,0,,Ха...
Dialogue: 0,0:09:38.71,0:09:40.58,Default,,0,0,0,,Мен сені кездестіргенге дейін-
Dialogue: 0,0:09:40.68,0:09:42.34,Default,,0,0,0,,Оның қайтыс болғанына көп болды.
Dialogue: 0,0:09:42.64,0:09:44.18,Default,,0,0,0,,Сен дәрменсіз өлік болсаң да-
Dialogue: 0,0:09:44.28,0:09:46.61,Default,,0,0,0,,Тірімін деп өтірік айту
Dialogue: 0,0:09:46.71,0:09:50.59,Default,,0,0,0,,Ештеңе істемейтін өмір - бұл жай ғана өмір сүру.
Dialogue: 0,0:09:50.69,0:09:52.95,Default,,0,0,0,,Бұл баяу өлім сияқты.
Dialogue: 0,0:09:53.05,0:09:55.66,Default,,0,0,0,,Егер бұрынғыдай болса...
Dialogue: 0,0:09:55.76,0:09:56.92,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:09:57.36,0:09:58.29,Default,,0,0,0,,Иә
Dialogue: 0,0:09:58.93,0:10:03.23,Default,,0,0,0,,Әрине, мұндай өмірдің мағынасы жоқ.
Dialogue: 0,0:10:04.10,0:10:05.87,Default,,0,0,0,,Уау (адам) Қарғыс атсын!
Dialogue: 0,0:10:06.07,0:10:08.67,Default,,0,0,0,,Неліктен?Мұнда балалар да бар
Dialogue: 0,0:10:08.77,0:10:10.61,Default,,0,0,0,,Біз ештеңе істеген жоқпыз!
Dialogue: 0,0:10:10.84,0:10:12.14,Default,,0,0,0,,Сондықтан! ―
Dialogue: 0,0:10:12.24,0:10:16.91,Default,,0,0,0,,Бұл гетто тұрғындары лаңкестердің бар екендігі туралы хабарламады, керісінше оларды жасырды.
Dialogue: 0,0:10:17.21,0:10:19.75,Default,,0,0,0,,Бұл сюзеренге жасалған опасыздық.
Dialogue: 0,0:10:19.85,0:10:20.98,Default,,0,0,0,,Уф
Dialogue: 0,0:10:22.05,0:10:24.82,Default,,0,0,0,,Жауапты адамдар тазалауды аяқтаған сияқты.
Dialogue: 0,0:10:24.92,0:10:28.06,Default,,0,0,0,,Иә, менің біраз уақытым бар. Бастауым керек пе?
Dialogue: 0,0:10:28.16,0:10:29.02,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:29.82,0:10:30.96,Default,,0,0,0,,Барлық әскерлерге айтыңыз.
Dialogue: 0,0:10:31.06,0:10:33.96,Default,,0,0,0,,Біз қазір Сайтама геттосын жою операциясын бастаймыз.
Dialogue: 0,0:10:36.36,0:10:39.97,Default,,0,0,0,,Барлық әскерлер!Бірінші жауынгерлік позицияға ауысыңыз
Dialogue: 0,0:10:49.81,0:10:51.11,Default,,0,0,0,,Неліктен Мәртебелі Корнелия?
Dialogue: 0,0:10:51.21,0:10:53.91,Default,,0,0,0,,Бізге де сұрыптауға бұйрық бермейсіз бе?
Dialogue: 0,0:10:54.22,0:10:55.42,Default,,0,0,0,,Өйткені апельсин бар
Dialogue: 0,0:10:55.72,0:10:56.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:56.68,0:10:59.12,Default,,0,0,0,,Сізді кәдеге жаратпайтынына риза болыңыз.
Dialogue: 0,0:10:59.69,0:11:02.89,Default,,0,0,0,,Сенің кесіріңнен жолымыз жабылды.
Dialogue: 0,0:11:02.99,0:11:05.09,Default,,0,0,0,,Бірақ бұл нөл дегенді білдіреді...
Dialogue: 0,0:11:05.19,0:11:07.70,Default,,0,0,0,,Тағы да солай ма?
Dialogue: 0,0:11:07.80,0:11:11.03,Default,,0,0,0,,Нөл... Студенттер әріптестер ме?
Dialogue: 0,0:11:11.13,0:11:12.87,Default,,0,0,0,,Қаланың 4-ші бөлімі бағындырылды.
Dialogue: 0,0:11:13.20,0:11:14.27,Default,,0,0,0,,Уау
Dialogue: 0,0:11:15.34,0:11:16.87,Default,,0,0,0,,Жақсарып келеді.
Dialogue: 0,0:11:17.97,0:11:19.14,Default,,0,0,0,,Дәл солай.
Dialogue: 0,0:11:19.24,0:11:21.21,Default,,0,0,0,,Тіпті Хловис Корнелияға айналса да...
Dialogue: 0,0:11:21.31,0:11:22.81,Default,,0,0,0,,Британия өзгермейді
Dialogue: 0,0:11:24.45,0:11:28.15,Default,,0,0,0,,ＩＤ
Dialogue: 0,0:11:28.68,0:11:31.82,Default,,0,0,0,,Бұл 3-барлау ротасының Дарио Торрес.
Dialogue: 0,0:11:31.92,0:11:34.16,Default,,0,0,0,,Біз бұл заттарды лаңкестерден тәркілеп алдық.
Dialogue: 0,0:11:34.26,0:11:36.09,Default,,0,0,0,,Сіз оны штабқа жібере аласыз ба?
Dialogue: 0,0:11:37.99,0:11:38.96,Default,,0,0,0,,Диск?
Dialogue: 0,0:11:39.06,0:11:41.23,Default,,0,0,0,,Бірақ бұған дейін жеке куәлігіңізді растауға рұқсат етіңіз.
Dialogue: 0,0:11:41.73,0:11:44.70,Default,,0,0,0,,Жарайды, бірақ бұған дейін...
Dialogue: 0,0:11:44.80,0:11:47.37,Default,,0,0,0,,Мен Сазерлендіңізді алғым келеді...
Dialogue: 0,0:11:52.71,0:11:53.37,Default,,0,0,0,,Уф
Dialogue: 0,0:11:53.47,0:11:55.91,Default,,0,0,0,,Түсінікті, мұқият пайдаланыңыз.
Dialogue: 0,0:11:56.44,0:11:58.05,Default,,0,0,0,,Рахмет
Dialogue: 0,0:12:03.48,0:12:04.82,Default,,0,0,0,,Сыртқы сақина жоқ
Dialogue: 0,0:12:04.92,0:12:06.82,Default,,0,0,0,,Сайкё желісі бұзып өте алады ма?
Dialogue: 0,0:12:06.92,0:12:08.19,Default,,0,0,0,,Бронды пойыз бөгеп тұр...
Dialogue: 0,0:12:08.29,0:12:09.46,Default,,0,0,0,,Шаруашылық жолдарын да пайдалануға болмайды.
Dialogue: 0,0:12:09.76,0:12:11.19,Default,,0,0,0,,Акабане немесе Джуджудан келген күшейтулер?
Dialogue: 0,0:12:11.29,0:12:13.13,Default,,0,0,0,,Бір адам үшін жақсы, бірақ топ үшін емес.
Dialogue: 0,0:12:13.23,0:12:14.43,Default,,0,0,0,,Изуми мырза!
Dialogue: 0,0:12:14.73,0:12:17.10,Default,,0,0,0,,Қалай болды? Тода және Кавагучи ауданы
Dialogue: 0,0:12:17.20,0:12:19.10,Default,,0,0,0,,Тағы не бар? (Изуми)
Dialogue: 0,0:12:21.90,0:12:23.80,Default,,0,0,0,,Мен нөлмін
Dialogue: 0,0:12:23.90,0:12:25.07,Default,,0,0,0,,Иә? Нөл?
Dialogue: 0,0:12:25.17,0:12:26.24,Default,,0,0,0,,Нөл дегеніміз...
Dialogue: 0,0:12:26.34,0:12:27.44,Default,,0,0,0,,Синдзюку оқиғасына қатысты...
Dialogue: 0,0:12:27.74,0:12:29.04,Default,,0,0,0,,Сіз мұны естіген болуыңыз керек.
Dialogue: 0,0:12:29.14,0:12:31.78,Default,,0,0,0,,Менің артымнан жүр, мен саған көмектесемін.
Dialogue: 0,0:12:31.88,0:12:33.51,Default,,0,0,0,,О...
Dialogue: 0,0:12:34.08,0:12:35.28,Default,,0,0,0,,Ｂ12
Dialogue: 0,0:12:35.38,0:12:36.78,Default,,0,0,0,,Ｆ７
Dialogue: 0,0:12:36.88,0:12:37.85,Default,,0,0,0,,D24 (жиырма төрт)…
Dialogue: 0,0:12:37.95,0:12:40.45,Default,,0,0,0,,Поидон отряды, 516-ға ауыстырыңыз.
Dialogue: 0,0:12:40.75,0:12:43.82,Default,,0,0,0,,Иса менің Раббыма жіберілді 516
Dialogue: 0,0:12:44.39,0:12:47.53,Default,,0,0,0,,Жауап жоқ, олар келген жоқ па? Нөл?
Dialogue: 0,0:12:47.83,0:12:50.36,Default,,0,0,0,,Өйткені, ол жай ғана террорист.
Dialogue: 0,0:12:51.83,0:12:53.40,Default,,0,0,0,,Міне! Бұл шынымен келді!
Dialogue: 0,0:12:53.50,0:12:54.87,Default,,0,0,0,,Нөл айтқандай.
Dialogue: 0,0:12:59.91,0:13:04.41,Default,,0,0,0,,Енді мен Корнелияны жұлып алуым керек пе, әлде оған саңылау жасауға рұқсат беруім керек пе?
Dialogue: 0,0:13:05.35,0:13:08.02,Default,,0,0,0,,R1 R2 (екі) жай ғана шегініңіз
Dialogue: 0,0:13:08.12,0:13:10.55,Default,,0,0,0,,Қарсыласты N2 орналасқан жерге апарыңыз.
Dialogue: 0,0:13:10.85,0:13:13.05,Default,,0,0,0,,B7 сағат 2-де өрттер -
Dialogue: 0,0:13:14.29,0:13:16.19,Default,,0,0,0,,P5 командасы оқтан атуды бастайды
Dialogue: 0,0:13:18.53,0:13:20.09,Default,,0,0,0,,Гестер тобының байланысы жоғалды
Dialogue: 0,0:13:20.19,0:13:22.13,Default,,0,0,0,,G47 (Төрт жеті) бағытында расталған жаудың көлеңкесі
Dialogue: 0,0:13:22.23,0:13:24.80,Default,,0,0,0,,Кашискийдің отряды соғысқа кірісті, буксирленген болуы мүмкін.
Dialogue: 0,0:13:25.00,0:13:26.50,Default,,0,0,0,,Жау – біздің Сутерланд...
Dialogue: 0,0:13:26.80,0:13:28.34,Default,,0,0,0,,Егін жинағаннан кейін пайдаланып жатқан сияқты.
Dialogue: 0,0:13:28.44,0:13:30.34,Default,,0,0,0,,Синджуку сияқты.
Dialogue: 0,0:13:30.44,0:13:32.27,Default,,0,0,0,,Нөл пайда болды ма?
Dialogue: 0,0:13:33.97,0:13:35.94,Default,,0,0,0,,Ｎ２
Dialogue: 0,0:13:37.08,0:13:38.11,Default,,0,0,0,,Ｒ４
Dialogue: 0,0:13:39.28,0:13:40.92,Default,,0,0,0,,Ｎ１
Dialogue: 0,0:13:41.88,0:13:44.59,Default,,0,0,0,,Жарайды P3 (Үш) Көпірді түсіріп, жолды кесіңіз.
Dialogue: 0,0:13:52.33,0:13:54.16,Default,,0,0,0,,17-тармақ алынып тасталды -
Dialogue: 0,0:13:54.26,0:13:55.53,Default,,0,0,0,,Гарри командасы байланысын жоғалтты
Dialogue: 0,0:13:55.83,0:13:56.93,Default,,0,0,0,,Барлығы ...
Dialogue: 0,0:13:57.23,0:14:00.97,Default,,0,0,0,,Барлық бөлімшелерге шегінуге нұсқау беру; одан әрі зақымдану мағынасыз.
Dialogue: 0,0:14:01.07,0:14:01.97,Default,,0,0,0,,Шегіну?
Dialogue: 0,0:14:02.07,0:14:03.60,Default,,0,0,0,,Мен әлі де қорқынышпен күресе аламын.
Dialogue: 0,0:14:04.07,0:14:05.94,Default,,0,0,0,,Мен бұлай күресе алмаймын.
Dialogue: 0,0:14:06.37,0:14:10.04,Default,,0,0,0,,Барлық әскерлерге дереу геттоның сыртқы шетіне шегінуін айт.
Dialogue: 0,0:14:10.14,0:14:13.21,Default,,0,0,0,,Маған сенің қайда екенің маңызды емес, тез геттоның сыртқы шетіне көш.
Dialogue: 0,0:14:13.88,0:14:15.98,Default,,0,0,0,,Бәсекелестік неткен жетіспейді.
Dialogue: 0,0:14:16.08,0:14:21.06,Default,,0,0,0,,Егер сіз шегініп жатқан әскерлермен аралассаңыз, Корнелия, сіз өте жақын боласыз.
Dialogue: 0,0:14:21.16,0:14:23.16,Default,,0,0,0,,Шарттар әлдеқашан тазартылды ма?
Dialogue: 0,0:14:25.03,0:14:26.33,Default,,0,0,0,,Хехехе
Dialogue: 0,0:14:26.43,0:14:28.43,Default,,0,0,0,,Қан үшін күресуге болмайды.
Dialogue: 0,0:14:28.53,0:14:33.50,Default,,0,0,0,,Бірақ бұл түрі қауіпті. Сіз қай жолды таңдайсыз...?
Dialogue: 0,0:14:35.54,0:14:36.60,Default,,0,0,0,,Егер олар тым жылдам қозғалса (оу, вей, оу)
Dialogue: 0,0:14:37.20,0:14:39.57,Default,,0,0,0,,Сіз мені кім деп ойлайсыз?
Dialogue: 0,0:14:41.24,0:14:42.98,Default,,0,0,0,,Мм, Лулу...
Dialogue: 0,0:14:43.08,0:14:45.91,Default,,0,0,0,,Мен осы аймақ құрылғанға дейін осындамын.
Dialogue: 0,0:14:46.01,0:14:46.98,Default,,0,0,0,,Жақын жерде болды ма?
Dialogue: 0,0:14:47.08,0:14:48.42,Default,,0,0,0,,Сіз ше? Ах...
Dialogue: 0,0:14:48.52,0:14:52.05,Default,,0,0,0,,Мен? Бұл ұқсас нәрсе ме?
Dialogue: 0,0:14:52.29,0:14:54.19,Default,,0,0,0,,Лулу бір түрлі намыссыз.
Dialogue: 0,0:14:54.29,0:14:57.09,Default,,0,0,0,,Мен олардың күш-жігер сияқты нәрселерге күлетінін сезінемін.
Dialogue: 0,0:14:57.19,0:14:59.63,Default,,0,0,0,,Шынымды айтсам, басында ұнамады...
Dialogue: 0,0:15:00.36,0:15:03.96,Default,,0,0,0,,Бірақ мен орта мектептің бірінші курсында оқып жүргенімде жол-көлік оқиғасын көрдім...
Dialogue: 0,0:15:05.33,0:15:08.44,Default,,0,0,0,,Қалай қарасаң да, артыңнан ұрған кінәлі.
Dialogue: 0,0:15:08.54,0:15:11.07,Default,,0,0,0,,Бірақ ешкім көмектесуге тырыспады...
Dialogue: 0,0:15:11.17,0:15:12.47,Default,,0,0,0,,Сол кезде...
Dialogue: 0,0:15:15.54,0:15:20.01,Default,,0,0,0,,Лулу бұған мақтанбайды, күлмейді де...
Dialogue: 0,0:15:20.11,0:15:22.55,Default,,0,0,0,,Әдеттегідей жалықтырасың...
Dialogue: 0,0:15:22.65,0:15:24.25,Default,,0,0,0,,Мен ойладым...
Dialogue: 0,0:15:24.35,0:15:27.69,Default,,0,0,0,,Ол не ойлап отыр? Сіз не істегіңіз келеді? Болды
Dialogue: 0,0:15:27.99,0:15:31.69,Default,,0,0,0,,Мен білгім келді, содан кейін...
Dialogue: 0,0:15:32.16,0:15:33.29,Default,,0,0,0,,Мен саған ғашық болдым
Dialogue: 0,0:15:33.39,0:15:38.27,Default,,0,0,0,,А-а, бұлай бола ма екен...
Dialogue: 0,0:15:38.50,0:15:41.00,Default,,0,0,0,,Жарайды, махаббат
Dialogue: 0,0:15:41.10,0:15:42.40,Default,,0,0,0,,Киотодан келген вице-канцлер де сол жоғары лауазымды тұлғалардың бірі ғой, иә?
Dialogue: 0,0:15:44.41,0:15:47.64,Default,,0,0,0,,Корнелия, сен жеңілгенсің.
Dialogue: 0,0:15:48.48,0:15:50.11,Default,,0,0,0,,Мен жеңген адаммын
Dialogue: 0,0:15:50.21,0:15:52.01,Default,,0,0,0,,Иә? (Дальтон) Иә.
Dialogue: 0,0:15:52.11,0:15:54.45,Default,,0,0,0,,Әкім жеңіс құдайы болса
Dialogue: 0,0:15:54.65,0:15:57.25,Default,,0,0,0,,Біз барамыз ба?Менің рыцарь Гилфорд
Dialogue: 0,0:15:57.35,0:15:59.59,Default,,0,0,0,,Сұрағаныңыз үшін рахмет.
Dialogue: 0,0:16:00.19,0:16:02.66,Default,,0,0,0,,Я, қанша Геас болса да...
Dialogue: 0,0:16:02.96,0:16:06.39,Default,,0,0,0,,Қалыпты қауіпсіздік жағдайында кіру тым қауіпті.
Dialogue: 0,0:16:06.49,0:16:10.03,Default,,0,0,0,,Кловис сияқты, маған ашу жасауға рұқсат етіңіз...
Dialogue: 0,0:16:10.13,0:16:12.40,Default,,0,0,0,,Иә? Студенттік кеңес бөлмесі?
Dialogue: 0,0:16:13.07,0:16:15.54,Default,,0,0,0,,Мысықтар фестиваліне арналған жиналыс ертең болуы керек.
Dialogue: 0,0:16:16.10,0:16:18.14,Default,,0,0,0,,Карен бұл басқаша дейді...
Dialogue: 0,0:16:18.24,0:16:21.14,Default,,0,0,0,,Бір нәрсені бүркемелеуге ашуланған сияқты.
Dialogue: 0,0:16:21.31,0:16:25.18,Default,,0,0,0,,Сондықтан мұндай нәрсе туралы тікелей адамнан сұраған дұрыс.
Dialogue: 0,0:16:25.28,0:16:27.21,Default,,0,0,0,,Мен сізден мен туралы не ойлайтыныңызды сұраймын.
Dialogue: 0,0:16:27.45,0:16:28.98,Default,,0,0,0,,Иә?Сол дәрежеде?
Dialogue: 0,0:16:29.22,0:16:30.38,Default,,0,0,0,,Жарайды, мен жақсы істеймін.
Dialogue: 0,0:16:30.48,0:16:32.12,Default,,0,0,0,,О, бұл жақсы емес.
Dialogue: 0,0:16:33.29,0:16:35.36,Default,,0,0,0,,Иә? Жарайды
Dialogue: 0,0:16:35.56,0:16:37.66,Default,,0,0,0,,Маған қалдырыңыз, мен мұны істеймін ...
Dialogue: 0,0:16:37.76,0:16:39.16,Default,,0,0,0,,Маған ұнамайды!
Dialogue: 0,0:16:39.26,0:16:41.10,Default,,0,0,0,,Мен мұны жақсы істеймін, сондықтан мен оны жақсы істеймін ... Уау!
Dialogue: 0,0:16:41.33,0:16:42.46,Default,,0,0,0,,(Мысықтың мияулауы)
Dialogue: 0,0:16:42.56,0:16:43.73,Default,,0,0,0,,Сиқыр формуласын ашу
Dialogue: 0,0:16:44.03,0:16:45.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:46.53,0:16:47.40,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:47.50,0:16:48.37,Default,,0,0,0,,(Мысықтың мияулауы)
Dialogue: 0,0:16:48.37,0:16:49.30,Default,,0,0,0,,(Мысықтың мияулауы)
Dialogue: 0,0:16:48.37,0:16:49.30,Default,,0,0,0,,Ум... ауырды ма?
Dialogue: 0,0:16:49.30,0:16:50.60,Default,,0,0,0,,Ум... ауырды ма?
Dialogue: 0,0:16:50.70,0:16:51.57,Default,,0,0,0,,Біраз
Dialogue: 0,0:16:54.64,0:16:56.28,Default,,0,0,0,,Үмітсізсің, Корнелия.
Dialogue: 0,0:16:56.61,0:16:58.75,Default,,0,0,0,,SS-мен бірдеңе жасауға тырысу
Dialogue: 0,0:16:59.78,0:17:03.28,Default,,0,0,0,,Ｎ１
Dialogue: 0,0:17:03.38,0:17:05.12,Default,,0,0,0,,Britannia машинасы ретінде әрекет ету
Dialogue: 0,0:17:05.22,0:17:06.32,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:17:07.02,0:17:08.29,Default,,0,0,0,,Алаяқ ретінде
Dialogue: 0,0:17:09.09,0:17:11.09,Default,,0,0,0,,One Nightmare сигнал береді.
Dialogue: 0,0:17:11.19,0:17:12.73,Default,,0,0,0,,Қалада қалды
Dialogue: 0,0:17:13.09,0:17:14.23,Default,,0,0,0,,Қарым-қатынас жасай алмайсыз ба?
Dialogue: 0,0:17:14.33,0:17:15.30,Default,,0,0,0,,Құтқару тобы...
Dialogue: 0,0:17:15.40,0:17:17.30,Default,,0,0,0,,Бұзыңыз (көмекші) Болды!
Dialogue: 0,0:17:17.40,0:17:19.30,Default,,0,0,0,,Мүмкін сені жау тұтқынында ұстаған шығар...
Dialogue: 0,0:17:19.40,0:17:21.50,Default,,0,0,0,,Мен саған түсуді бұйырдым.
Dialogue: 0,0:17:21.60,0:17:24.41,Default,,0,0,0,,Маған бұйрықты орындай алмайтын сарбаздар керек емес.
Dialogue: 0,0:17:24.51,0:17:26.41,Default,,0,0,0,,Міне (көмекші) Бірақ!
Dialogue: 0,0:17:26.77,0:17:29.28,Default,,0,0,0,,Өз өміріңізді құрбан етсеңіз де, миссияңызды орындаңыз.
Dialogue: 0,0:17:29.61,0:17:31.61,Default,,0,0,0,,Бұл менің қарамағындағылар үшін қалыпты жағдай.
Dialogue: 0,0:17:32.15,0:17:33.41,Default,,0,0,0,,Мәртебелі Иса
Dialogue: 0,0:17:35.15,0:17:38.55,Default,,0,0,0,,Эй, эй!Сіз сәйкестендіру сигналын білмейсіз бе?Сіз мен жағындасыз!
Dialogue: 0,0:17:40.35,0:17:42.09,Default,,0,0,0,,Цк, қарғыс атсын!
Dialogue: 0,0:17:43.36,0:17:44.39,Default,,0,0,0,,Уф
Dialogue: 0,0:17:51.70,0:17:54.17,Default,,0,0,0,,Неліктен тексермеске?Содан кейін...
Dialogue: 0,0:17:54.27,0:17:57.60,Default,,0,0,0,,N2 сигналын жіберіп, аурухана алаңына шегініңіз
Dialogue: 0,0:17:57.70,0:18:00.57,Default,,0,0,0,,Ｒ１ Ｒ２
Dialogue: 0,0:18:00.77,0:18:03.68,Default,,0,0,0,,Бұл қайтадан сигнал ма?
Dialogue: 0,0:18:03.78,0:18:07.85,Default,,0,0,0,,Алда буксирлеу бар. Глостерді күшейтіп, оны қоршап алыңыз.
Dialogue: 0,0:18:08.32,0:18:10.78,Default,,0,0,0,,Менің соңымнан келмейсің бе?жаман!
Dialogue: 0,0:18:11.09,0:18:13.59,Default,,0,0,0,,Ｒ１ Ｒ２
Dialogue: 0,0:18:15.72,0:18:17.72,Default,,0,0,0,,Глостер Белгіленген аумаққа келу-
Dialogue: 0,0:18:17.83,0:18:19.33,Default,,0,0,0,,Жау көлеңкесі табылмады
Dialogue: 0,0:18:19.59,0:18:21.40,Default,,0,0,0,,Сіз бұл қолды оқыдыңыз ба?
Dialogue: 0,0:18:21.50,0:18:24.20,Default,,0,0,0,,Мүмкін біз шынымен нөлмен айналысатын шығармыз.
Dialogue: 0,0:18:24.60,0:18:26.63,Default,,0,0,0,,П2 N3 Жаудың артына өтіңіз.
Dialogue: 0,0:18:27.40,0:18:31.24,Default,,0,0,0,,Не болды? Жауап P2 N3! ―
Dialogue: 0,0:18:31.34,0:18:34.11,Default,,0,0,0,,Қарғыс атсын B1 B5, барасыңдар
Dialogue: 0,0:18:34.21,0:18:35.31,Default,,0,0,0,,Әзіл емес!
Dialogue: 0,0:18:35.41,0:18:38.48,Default,,0,0,0,,Корнелия күзетшісін жеңу мүмкін емес.
Dialogue: 0,0:18:41.65,0:18:43.18,Default,,0,0,0,,Ей, беріл.
Dialogue: 0,0:18:43.42,0:18:44.38,Default,,0,0,0,,Мен қарсылық көрсетпеймін
Dialogue: 0,0:18:44.49,0:18:45.52,Default,,0,0,0,,Жоқ, жасама!
Dialogue: 0,0:18:45.75,0:18:46.62,Default,,0,0,0,,Бұл – тұзақ екенінің дәлелі.
Dialogue: 0,0:18:47.75,0:18:48.69,Default,,0,0,0,,Уау
Dialogue: 0,0:18:49.32,0:18:50.36,Default,,0,0,0,,Уау
Dialogue: 0,0:18:50.62,0:18:52.36,Default,,0,0,0,,Ｐ６ Ｐ８
Dialogue: 0,0:18:52.46,0:18:55.13,Default,,0,0,0,,Қарғыс атсын...B7 N4 қақпағын бер!
Dialogue: 0,0:18:55.46,0:18:57.66,Default,,0,0,0,,Бұл В7 Мен басқа олжа таптым.
Dialogue: 0,0:18:57.76,0:18:58.87,Default,,0,0,0,,Алдымен мұны орындаңыз
Dialogue: 0,0:18:59.17,0:19:00.67,Default,,0,0,0,,Жоқ! Бұл алдау-
Dialogue: 0,0:19:00.83,0:19:02.34,Default,,0,0,0,,B7 бұйрықтарын орындаңыз
Dialogue: 0,0:19:02.57,0:19:04.87,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Біз мұны осында істеуіміз керек ...
Dialogue: 0,0:19:05.17,0:19:07.74,Default,,0,0,0,,Ｂ７
Dialogue: 0,0:19:07.84,0:19:09.91,Default,,0,0,0,,Ха!
Dialogue: 0,0:19:11.48,0:19:15.35,Default,,0,0,0,,Ｂ８
Dialogue: 0,0:19:15.45,0:19:17.82,Default,,0,0,0,,Жағдай мен ештеңе... Уау!
Dialogue: 0,0:19:17.92,0:19:18.79,Default,,0,0,0,,Ｂ８！
Dialogue: 0,0:19:18.89,0:19:21.66,Default,,0,0,0,,Tsk! Қалғандар: Р санынан бастап есеп беру.
Dialogue: 0,0:19:21.66,0:19:21.89,Default,,0,0,0,,Tsk! Қалғандар: Р санынан бастап есеп беру.
Dialogue: 0,0:19:21.66,0:19:21.89,Default,,0,0,0,,(сигнал үні)
Dialogue: 0,0:19:21.89,0:19:22.19,Default,,0,0,0,,(сигнал үні)
Dialogue: 0,0:19:22.19,0:19:22.86,Default,,0,0,0,,(сигнал үні)
Dialogue: 0,0:19:22.19,0:19:22.86,Default,,0,0,0,,О
Dialogue: 0,0:19:23.46,0:19:26.49,Default,,0,0,0,,Операция аяқталды, барлық әскерлер 4-ші құрамаға ауысады
Dialogue: 0,0:19:26.79,0:19:29.86,Default,,0,0,0,,Басылған... оңай
Dialogue: 0,0:19:30.66,0:19:32.37,Default,,0,0,0,,Бұл тіпті ойын емес.
Dialogue: 0,0:19:32.87,0:19:33.93,Default,,0,0,0,,Шиндзюку сияқты емес-
Dialogue: 0,0:19:34.23,0:19:36.27,Default,,0,0,0,,Бұл жұмыс істемеді, Нөл.
Dialogue: 0,0:19:36.37,0:19:40.31,Default,,0,0,0,,Әлде көшіріп алдың ба? Жарайды, жақында түсінесіз
Dialogue: 0,0:19:40.67,0:19:42.41,Default,,0,0,0,,Бұл ұйым...
Dialogue: 0,0:19:42.51,0:19:43.81,Default,,0,0,0,,Тым басқа
Dialogue: 0,0:19:43.91,0:19:44.85,Default,,0,0,0,,Барлық қорқынышты-
Dialogue: 0,0:19:44.95,0:19:46.55,Default,,0,0,0,,Ұшқышқа айтыңыз -
Dialogue: 0,0:19:46.65,0:19:48.42,Default,,0,0,0,,Люкті ашып, маған шынайы бет-бейнесін көрсет
Dialogue: 0,0:19:48.52,0:19:49.52,Default,,0,0,0,,Ха! ―
Dialogue: 0,0:19:49.62,0:19:51.22,Default,,0,0,0,,Корнелия!
Dialogue: 0,0:19:51.32,0:19:52.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:52.62,0:19:53.89,Default,,0,0,0,,Қайталау -
Dialogue: 0,0:19:54.19,0:19:56.92,Default,,0,0,0,,Барлық ұшқыштар, люктерді ашып, шынайы жүздеріңізді көрсетіңіздер.
Dialogue: 0,0:19:57.32,0:19:59.66,Default,,0,0,0,,Не болады? Мені көруді сұраса...
Dialogue: 0,0:20:01.33,0:20:04.50,Default,,0,0,0,,Нөл маскасы болмаса да, менің шынайы болмысым ашылады.
Dialogue: 0,0:20:04.60,0:20:05.60,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:20:07.20,0:20:09.24,Default,,0,0,0,,Geass пайдалану... Ақымақ...
Dialogue: 0,0:20:09.54,0:20:12.27,Default,,0,0,0,,Ол басқа адамды тікелей көрмейінше жұмыс істемейді.
Dialogue: 0,0:20:12.37,0:20:13.81,Default,,0,0,0,,Жау түнгі түн болса...
Dialogue: 0,0:20:13.91,0:20:16.28,Default,,0,0,0,,Егер бұл жаяу әскер немесе басқа ұшқыш болса...
Dialogue: 0,0:20:16.51,0:20:18.65,Default,,0,0,0,,Бұл мүмкін емес. Қарсыластар өте көп...
Dialogue: 0,0:20:18.75,0:20:20.55,Default,,0,0,0,,Мені қалай айналдырасың? ―
Dialogue: 0,0:20:20.65,0:20:23.78,Default,,0,0,0,,Жоқ. Бұл мүмкін бе? Егер сіз өзіңізді нөл деп атасаңыз ...
Dialogue: 0,0:20:23.88,0:20:25.62,Default,,0,0,0,,Бірақ түнгі түн...
Dialogue: 0,0:20:25.72,0:20:28.62,Default,,0,0,0,,Содан кейін алдын ала шабуыл жасап, серпіліс жасаңыз.
Dialogue: 0,0:20:28.72,0:20:32.76,Default,,0,0,0,,Бұл мүмкін емес, бұл Корнелия СС-ке қарсы суицид.
Dialogue: 0,0:20:32.86,0:20:34.60,Default,,0,0,0,,Люкті ашыңыз, сіздің кезегіңіз.
Dialogue: 0,0:20:34.70,0:20:35.56,Default,,0,0,0,,Ах
Dialogue: 0,0:20:36.26,0:20:37.86,Default,,0,0,0,,Не болды? Шұңқырды тез ашыңыз
Dialogue: 0,0:20:37.97,0:20:40.97,Default,,0,0,0,,Бұл... бұрын шайқаста люк істен шыққан.
Dialogue: 0,0:20:41.27,0:20:42.94,Default,,0,0,0,,Жарайды, оны осы жерден ашайық.
Dialogue: 0,0:20:43.24,0:20:43.90,Default,,0,0,0,,Ах
Dialogue: 0,0:20:44.34,0:20:45.74,Default,,0,0,0,,Артыңызды бұрыңыз.
Dialogue: 0,0:20:46.94,0:20:47.84,Default,,0,0,0,,Тезірек шыққыңыз келе ме?
Dialogue: 0,0:20:49.31,0:20:52.25,Default,,0,0,0,,Жарайды, қазір.
Dialogue: 0,0:20:52.35,0:20:53.51,Default,,0,0,0,,Бұл нөл! Нөл табылды!
Dialogue: 0,0:20:53.61,0:20:54.78,Default,,0,0,0,,Жоқ! (Гильфорд) Ах.
Dialogue: 0,0:20:59.59,0:21:02.76,Default,,0,0,0,,Хмм, менің ойымша, Нөлдің мінезі осындай.
Dialogue: 0,0:21:02.86,0:21:03.76,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:21:03.86,0:21:06.46,Default,,0,0,0,,３ ５
Dialogue: 0,0:21:06.56,0:21:08.70,Default,,0,0,0,,12…
Dialogue: 0,0:21:08.96,0:21:10.53,Default,,0,0,0,,Менің мұнда мінуден басқа амалым жоқ.
Dialogue: 0,0:21:10.73,0:21:12.83,Default,,0,0,0,,Ғимаратты қоршап, артқы жағына өтіңіз.
Dialogue: 0,0:21:12.93,0:21:14.00,Default,,0,0,0,,Мергендер тобы ату!
Dialogue: 0,0:21:15.67,0:21:17.04,Default,,0,0,0,,О! (Жоғарғы) Құлды!
Dialogue: 0,0:21:17.54,0:21:19.37,Default,,0,0,0,,Ханшайым, саған қалай ұнайды?
Dialogue: 0,0:21:19.61,0:21:21.94,Default,,0,0,0,,Хмм, оның тұзақ болу мүмкіндігі қандай?
Dialogue: 0,0:21:22.04,0:21:25.71,Default,,0,0,0,,Бұл мүмкін. Ол ма, жоқ па, білмеймін.
Dialogue: 0,0:21:25.81,0:21:28.32,Default,,0,0,0,,Губернатордың талдауы бойынша -
Dialogue: 0,0:21:28.42,0:21:30.55,Default,,0,0,0,,Тәкаппарлығы жоғары адам...
Dialogue: 0,0:21:30.65,0:21:32.52,Default,,0,0,0,,Олай болса, оны қудалаудың қажеті жоқ па?
Dialogue: 0,0:21:32.82,0:21:34.59,Default,,0,0,0,,Иә, мен жаудың штабына бардым.
Dialogue: 0,0:21:34.69,0:21:36.52,Default,,0,0,0,,Пайда болған деген нені білдіреді?
Dialogue: 0,0:21:36.62,0:21:38.69,Default,,0,0,0,,Мен олар қашу жолын қамтамасыз етті ме деп ойлаймын.
Dialogue: 0,0:21:38.79,0:21:41.63,Default,,0,0,0,,Сіз өзіңізді сақтай аласыз ба?
Dialogue: 0,0:21:42.70,0:21:46.43,Default,,0,0,0,,Ол Хловистен басқа деңгейде. Бұл Корнелия ма?
Dialogue: 0,0:21:46.53,0:21:47.40,Default,,0,0,0,,Не!
Dialogue: 0,0:21:53.74,0:21:55.54,Default,,0,0,0,,Неге көмектестіңіз?
Dialogue: 0,0:21:56.61,0:21:59.68,Default,,0,0,0,,Сондықтан мен өлсем проблема болады дедім.
Dialogue: 0,0:21:59.88,0:22:02.08,Default,,0,0,0,,Шарттар бірдей болса, мен жеңілмес едім.
Dialogue: 0,0:22:02.38,0:22:03.85,Default,,0,0,0,,Мен жеңілгеніме өкінемін.
Dialogue: 0,0:22:03.95,0:22:07.42,Default,,0,0,0,,Бұл шарттарды орындау біздің қолымыздан келеді.
Dialogue: 0,0:22:07.92,0:22:09.96,Default,,0,0,0,,Ондай жағдайда мен оны сізге реттеп беремін.
Dialogue: 0,0:22:12.36,0:22:13.43,Default,,0,0,0,,Британиядан жеңіліп қалмаңыз
Dialogue: 0,0:22:13.53,0:22:17.63,Default,,0,0,0,,Әскерім, халқым, елім!
Dialogue: 0,0:22:17.73,0:22:21.40,Default,,0,0,0,,♪～
Dialogue: 0,0:22:21.50,0:22:25.04,Default,,0,0,0,,♪Мен жаяу жүрмін, бірақ мен арыстан мен жолбарыстың арылдаған жолмен жүріп келемін
Dialogue: 0,0:22:25.34,0:22:28.91,Default,,0,0,0,,♪Қызыл аспанның арғы жағында, Махороба
Dialogue: 0,0:22:29.01,0:22:32.71,Default,,0,0,0,,♪Тұтқынның оңашалығында қаңғыған жас
Dialogue: 0,0:22:32.81,0:22:36.55,Default,,0,0,0,,♪Әлсіздік пен ашу көзге көрінбейтін жау ма?
Dialogue: 0,0:22:36.65,0:22:42.02,Default,,0,0,0,,♪Әке, мен өзімді әлі білмеймін.
Dialogue: 0,0:22:44.06,0:22:48.10,Default,,0,0,0,,♪Алдыңғы ағайындар
Dialogue: 0,0:22:48.40,0:22:51.80,Default,,0,0,0,,♪Көзге көрінбейтін арқаңмен жүрсең
Dialogue: 0,0:22:51.90,0:22:58.87,Default,,0,0,0,,♪Таңғы жұлдыз сізді адасқан түнге шақырады
Dialogue: 0,0:22:59.54,0:23:02.98,Default,,0,0,0,,♪Өліммен бітпейді
Dialogue: 0,0:23:03.08,0:23:06.78,Default,,0,0,0,,♪Арманымды аңсасам да
Dialogue: 0,0:23:06.88,0:23:10.62,Default,,0,0,0,,♪Сіз сенімді адамсыз
Dialogue: 0,0:23:10.72,0:23:14.59,Default,,0,0,0,,♪Менің өмірім
Dialogue: 0,0:23:14.69,0:23:18.49,Default,,0,0,0,,♪Қатты жел айдалада, Көбелек пен гүлдей өмір сүремін.
Dialogue: 0,0:23:18.59,0:23:22.16,Default,,0,0,0,,♪Мәңгілік көктемде гүлдеген дәмді елес
Dialogue: 0,0:23:22.46,0:23:26.00,Default,,0,0,0,,♪Бұл дененің лас болса да лайдың тазалығы
Dialogue: 0,0:23:26.10,0:23:29.87,Default,,0,0,0,,♪Жүрегіңіздің сырына сеніңіз
Dialogue: 0,0:23:29.97,0:23:35.58,Default,,0,0,0,,♪Анашым, көз жасымды көрсетпесем де.
Dialogue: 0,0:23:35.74,0:23:40.41,Default,,0,0,0,,♪Аяғымның астындағы шөпте
Dialogue: 0,0:23:40.51,0:23:45.85,Default,,0,0,0,,♪Шық ешқашан жоғалмайды
Dialogue: 0,0:23:50.09,0:23:51.12,Default,,0,0,0,,Онда кім бар?
Dialogue: 0,0:23:51.42,0:23:53.73,Default,,0,0,0,,Менің әскерім ретінде әрекет ете алатындар...
Dialogue: 0,0:23:53.89,0:23:56.13,Default,,0,0,0,,Осындай кездерде Созаку осында болса...
Dialogue: 0,0:23:56.56,0:23:57.80,Default,,0,0,0,,Жоқ, артыңа қарама.
Dialogue: 0,0:23:58.13,0:23:59.80,Default,,0,0,0,,Ол британдық сарбаз.
Dialogue: 0,0:24:00.17,0:24:03.20,Default,,0,0,0,,Шайқаста көрінбесе де, ол менің жауым жағында.
Dialogue: 0,0:24:04.44,0:24:07.51,Default,,0,0,0,,Сонда таңдау керек жауап...
Dialogue: 0,0:24:09.01,0:24:15.01,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory