Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.56,0:00:04.57,Default,,0,0,0,,Лелуч, Британдық бала...
Dialogue: 0,0:00:04.67,0:00:06.67,Default,,0,0,0,,Екі өкілеттігі бар.
Dialogue: 0,0:00:06.77,0:00:08.47,Default,,0,0,0,,Бірі – Геасс-
Dialogue: 0,0:00:08.57,0:00:12.64,Default,,0,0,0,,Кез келген қарсыласқа пәрмен беруге мүмкіндік беретін абсолютті бағыну күші.
Dialogue: 0,0:00:13.11,0:00:14.71,Default,,0,0,0,,Бірі - Қара рыцарьлар.
Dialogue: 0,0:00:15.28,0:00:20.05,Default,,0,0,0,,Әкесі басқарған Британ империясын жою үшін оның әскері.
Dialogue: 0,0:00:20.68,0:00:24.15,Default,,0,0,0,,Zero кодтық атауын пайдаланып, Лелуш қозғала бастайды.
Dialogue: 0,0:00:24.79,0:00:26.72,Default,,0,0,0,,Анамның жауынан кек алу үшін...
Dialogue: 0,0:00:27.02,0:00:31.26,Default,,0,0,0,,Менің сіңілім Нуналли бақытты өмір сүретін жер жасау үшін...
Dialogue: 0,0:00:32.23,0:00:36.03,Default,,0,0,0,,Бұл әрекет қандай нәтиже береді? ―
Dialogue: 0,0:00:36.23,0:00:38.37,Default,,0,0,0,,Әлі ешкім білмейді
Dialogue: 0,0:00:38.73,0:00:44.74,Default,,0,0,0,,♪～
Dialogue: 0,0:00:47.18,0:00:51.08,Default,,0,0,0,,♪Өзім, тіпті әлем
Dialogue: 0,0:00:51.18,0:00:54.45,Default,,0,0,0,,♪Мен оны өзгерте аламын деп ойлаймын.
Dialogue: 0,0:00:54.55,0:01:00.32,Default,,0,0,0,,♪Сәт әрқашан жаныңда...
Dialogue: 0,0:01:02.36,0:01:08.66,Default,,0,0,0,,♪ Тітіркенуді жасыра алмайды
Dialogue: 0,0:01:09.40,0:01:15.67,Default,,0,0,0,,♪ Бір орында тұрып өзіңе қара
Dialogue: 0,0:01:15.84,0:01:19.27,Default,,0,0,0,,♪ойланып отырып, уайымдап
Dialogue: 0,0:01:19.41,0:01:22.68,Default,,0,0,0,,♪Өкінішпен шешім қабылдау керек.
Dialogue: 0,0:01:22.81,0:01:26.28,Default,,0,0,0,,♪Сен маған берген бір сөз
Dialogue: 0,0:01:26.38,0:01:30.19,Default,,0,0,0,,♪Менің шатасуым жоғалады
Dialogue: 0,0:01:30.29,0:01:36.22,Default,,0,0,0,,♪Бос бөлмеме нұр түсті.
Dialogue: 0,0:01:36.69,0:01:39.69,Default,,0,0,0,,♪Мен қараған аспан
Dialogue: 0,0:01:39.79,0:01:43.83,Default,,0,0,0,,♪Ашық және көгілдір болып барады
Dialogue: 0,0:01:44.13,0:01:50.41,Default,,0,0,0,,♪Мен жабық терезені ашуды жөн көрдім.
Dialogue: 0,0:01:50.64,0:01:54.51,Default,,0,0,0,,♪Өзім, тіпті әлем
Dialogue: 0,0:01:54.61,0:01:57.65,Default,,0,0,0,,♪Мен оны өзгерте аламын деп ойлаймын.
Dialogue: 0,0:01:58.28,0:02:04.52,Default,,0,0,0,,♪Сәтті сезін, осында және қазір...
Dialogue: 0,0:02:13.43,0:02:15.73,Default,,0,0,0,,Kawaguchiko Convention Center қонақүйінде-
Dialogue: 0,0:02:15.83,0:02:18.23,Default,,0,0,0,,Жою жұмыстары ақырында басталып жатқан сияқты.
Dialogue: 0,0:02:18.33,0:02:19.90,Default,,0,0,0,,Нөл қара рыцарларды жариялағаннан кейін...
Dialogue: 0,0:02:20.20,0:02:21.37,Default,,0,0,0,,2 аптадан астам -
Dialogue: 0,0:02:21.47,0:02:23.84,Default,,0,0,0,,Ақырында ешқандай нақты дәлел табылған жоқ.
Dialogue: 0,0:02:24.14,0:02:26.17,Default,,0,0,0,,Қашу жолыңызды қысқарта алдыңыз ба?
Dialogue: 0,0:02:26.41,0:02:29.34,Default,,0,0,0,,Хмм... мм
Dialogue: 0,0:02:29.48,0:02:30.55,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:02:30.55,0:02:31.51,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:02:30.55,0:02:31.51,Default,,0,0,0,,Тыныш, сендер!
Dialogue: 0,0:02:34.18,0:02:34.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:36.32,0:02:37.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:38.22,0:02:39.52,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:02:40.72,0:02:42.26,Default,,0,0,0,,О, Карен!
Dialogue: 0,0:02:42.36,0:02:43.63,Default,,0,0,0,,Ах, жас ханым.
Dialogue: 0,0:02:43.73,0:02:45.79,Default,,0,0,0,,Сізді оятқаным үшін кешіріңіз.
Dialogue: 0,0:02:45.89,0:02:46.79,Default,,0,0,0,,Мен де, әпкем де осы жерде күтеміз.
Dialogue: 0,0:02:46.90,0:02:50.33,Default,,0,0,0,,Кешіріңіз, баспалдақ осы уақытта құлап кетті.
Dialogue: 0,0:02:50.43,0:02:51.77,Default,,0,0,0,,Тез тазалаңыз
Dialogue: 0,0:02:51.87,0:02:53.70,Default,,0,0,0,,Мектепке баратын уақыт таяп қалды.
Dialogue: 0,0:02:53.94,0:02:57.34,Default,,0,0,0,,Ханым, сіз соңғы уақытта мектепке көп барасыз.
Dialogue: 0,0:02:57.44,0:02:58.41,Default,,0,0,0,,Достар...
Dialogue: 0,0:02:58.61,0:03:00.71,Default,,0,0,0,,Оның сізге еш қатысы жоқ, солай ма?
Dialogue: 0,0:03:04.48,0:03:06.48,Default,,0,0,0,,Қазір кет...
Dialogue: 0,0:03:15.36,0:03:17.86,Default,,0,0,0,,Амандық болса да, Он бірге беру...
Dialogue: 0,0:03:17.96,0:03:18.96,Default,,0,0,0,,Қандай ұят.
Dialogue: 0,0:03:19.26,0:03:21.50,Default,,0,0,0,,Сол себепті ағып жатқан шығар.
Dialogue: 0,0:03:21.60,0:03:24.50,Default,,0,0,0,,Он бір санын аздап қысқартқан дұрыс.
Dialogue: 0,0:03:26.33,0:03:28.90,Default,,0,0,0,,Сыйақы әйеліңіздің есебіне түседі.
Dialogue: 0,0:03:31.34,0:03:33.27,Default,,0,0,0,,Мәртебелі Корнелия - жауынгер.
Dialogue: 0,0:03:33.37,0:03:36.31,Default,,0,0,0,,Сен бұл нәрселерден бейхабарсың.
Dialogue: 0,0:03:36.41,0:03:37.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:36.41,0:03:37.28,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:03:37.28,0:03:38.21,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:03:38.21,0:03:39.51,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:03:38.21,0:03:39.51,Default,,0,0,0,,О! (Байқау) Уау!
Dialogue: 0,0:03:39.51,0:03:39.75,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:03:39.75,0:03:40.42,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:03:39.75,0:03:40.42,Default,,0,0,0,,Жарық! Жарық!
Dialogue: 0,0:03:40.42,0:03:41.28,Default,,0,0,0,,Жарық! Жарық!
Dialogue: 0,0:03:41.45,0:03:42.78,Default,,0,0,0,,Хаха...
Dialogue: 0,0:03:42.95,0:03:44.29,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:45.49,0:03:46.92,Default,,0,0,0,,Әй, сен!
Dialogue: 0,0:03:48.92,0:03:50.46,Default,,0,0,0,,Қара рыцарьлар!
Dialogue: 0,0:03:50.56,0:03:51.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:52.69,0:03:54.53,Default,,0,0,0,,Әй?
Dialogue: 0,0:03:54.63,0:03:56.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:57.33,0:03:59.87,Default,,0,0,0,,Кареннің ұйықтап кетуі әдеттен тыс жағдай.
Dialogue: 0,0:04:00.27,0:04:01.80,Default,,0,0,0,,Иә, сәл ғана.
Dialogue: 0,0:04:01.90,0:04:03.84,Default,,0,0,0,,Мен Лелуштың шәкірті болсам ше? ―
Dialogue: 0,0:04:03.94,0:04:05.97,Default,,0,0,0,,Ол ұйықтап қалудың маманы.
Dialogue: 0,0:04:06.27,0:04:07.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:07.58,0:04:08.81,Default,,0,0,0,,Сіз ұйықтап жатырсыз ба?
Dialogue: 0,0:04:09.28,0:04:11.58,Default,,0,0,0,,Күнде түнде не істейтініңді білмеймін.
Dialogue: 0,0:04:11.68,0:04:13.98,Default,,0,0,0,,Ол сыныптың жартысын ұйықтайды.
Dialogue: 0,0:04:14.28,0:04:15.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:16.92,0:04:18.25,Default,,0,0,0,,Ел Аламейн майданында...
Dialogue: 0,0:04:18.35,0:04:20.39,Default,,0,0,0,,ЕО шабуылда.
Dialogue: 0,0:04:20.49,0:04:21.69,Default,,0,0,0,,Бізге келетін болсақ-
Dialogue: 0,0:04:21.79,0:04:23.32,Default,,0,0,0,,Мәңгі осы аймақта 11-
Dialogue: 0,0:04:23.42,0:04:25.59,Default,,0,0,0,,Мен тығырыққа тірелмеймін.
Dialogue: 0,0:04:25.79,0:04:28.70,Default,,0,0,0,,Мен отандық әкімшілікті нығайтып, оны спутниктік аймаққа көтергім келеді.
Dialogue: 0,0:04:29.43,0:04:32.43,Default,,0,0,0,,Осы мақсатта лаңкестік ұйымдарды жою кезек күттірмейтін қажеттілік болып табылады...
Dialogue: 0,0:04:32.53,0:04:34.87,Default,,0,0,0,,Он бірдің ішінде кең тараған есірткі
Dialogue: 0,0:04:34.97,0:04:37.34,Default,,0,0,0,,Рефрендер мәселесі де күрделі.
Dialogue: 0,0:04:37.54,0:04:38.97,Default,,0,0,0,,Осыған байланысты өнімділік төмендейді.
Dialogue: 0,0:04:40.01,0:04:41.71,Default,,0,0,0,,Міне, Қытай Федерациясының кюсю жолы.
Dialogue: 0,0:04:41.81,0:04:43.38,Default,,0,0,0,,Ұру керек.
Dialogue: 0,0:04:43.48,0:04:44.35,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:04:44.45,0:04:46.28,Default,,0,0,0,,Иә, абай болыңыз.
Dialogue: 0,0:04:46.38,0:04:48.85,Default,,0,0,0,,Концессиядан енді ешқашан шығуға болмайды.
Dialogue: 0,0:04:48.95,0:04:51.82,Default,,0,0,0,,Әпке, Қара рыцарьлар туралы...
Dialogue: 0,0:04:52.35,0:04:54.32,Default,,0,0,0,,Мен сізге тағы біраз жүзуге рұқсат етемін.
Dialogue: 0,0:04:54.42,0:04:56.72,Default,,0,0,0,,Мені құтқарғаны үшін мен де саған қарыздармын.
Dialogue: 0,0:04:56.89,0:04:59.06,Default,,0,0,0,,Бірақ мен қайтып келгенде...
Dialogue: 0,0:05:02.63,0:05:06.00,Default,,0,0,0,,Мен бұл жерді тазалап, сізге тапсырамын.
Dialogue: 0,0:05:06.30,0:05:08.44,Default,,0,0,0,,Сондықтан қауіпті нәрсе туралы ойламаңыз.
Dialogue: 0,0:05:08.67,0:05:09.97,Default,,0,0,0,,Юффи
Dialogue: 0,0:05:10.74,0:05:11.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:12.64,0:05:15.68,Default,,0,0,0,,Өйткені бұл адам Британ императорының ұлы.
Dialogue: 0,0:05:15.78,0:05:16.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:16.91,0:05:19.98,Default,,0,0,0,,Ойлап қарасам, сен де солай болғансың.
Dialogue: 0,0:05:21.85,0:05:24.09,Default,,0,0,0,,Бірақ қазір...
Dialogue: 0,0:05:25.09,0:05:27.89,Default,,0,0,0,,Сол кезде Нөл не деді?
Dialogue: 0,0:05:27.99,0:05:30.76,Default,,0,0,0,,Бұл алда әлі көп нәрсе бар дегенді білдіре ме? ―
Dialogue: 0,0:05:31.09,0:05:33.93,Default,,0,0,0,,Созаку, сен қалай ойлайсың? ―
Dialogue: 0,0:05:34.03,0:05:35.90,Default,,0,0,0,,Нөлдің істері -
Dialogue: 0,0:05:36.00,0:05:38.07,Default,,0,0,0,,Онда B сыныбында да осындай адамдар бар екен ғой.
Dialogue: 0,0:05:43.00,0:05:45.81,Default,,0,0,0,,Екі жақты өмір сүру өте қиын.
Dialogue: 0,0:05:46.01,0:05:47.74,Default,,0,0,0,,Қарашы, Созаку, ана жақта!
Dialogue: 0,0:05:47.84,0:05:48.78,Default,,0,0,0,,Тоқта, ақымақ!Сузаку!
Dialogue: 0,0:05:48.88,0:05:49.74,Default,,0,0,0,,Хмм?
Dialogue: 0,0:05:50.11,0:05:51.68,Default,,0,0,0,,Тоқта, тоқта!
Dialogue: 0,0:05:51.78,0:05:54.08,Default,,0,0,0,,Кешіріңіз, Лелуш, бұл төрағаның бұйрығы.
Dialogue: 0,0:05:54.55,0:05:56.12,Default,,0,0,0,,Сіздің жүзіңіз күлімдеп тұр!Эй!
Dialogue: 0,0:05:56.42,0:05:57.59,Default,,0,0,0,,Ол қозғалмайды! (есік жабылған дыбыс)
Dialogue: 0,0:05:57.69,0:05:58.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:58.82,0:05:59.79,Default,,0,0,0,,Қайырлы таң nyan
Dialogue: 0,0:06:00.02,0:06:01.96,Default,,0,0,0,,Қайырлы таң... Қайырлы таң.
Dialogue: 0,0:06:02.06,0:06:03.02,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:03.12,0:06:04.43,Default,,0,0,0,,Не? Бұл
Dialogue: 0,0:06:04.53,0:06:06.13,Default,,0,0,0,,Сен мұны айтпадың ба? ―
Dialogue: 0,0:06:06.56,0:06:08.53,Default,,0,0,0,,Артурды қарсы алу кеші
Dialogue: 0,0:06:08.76,0:06:09.80,Default,,0,0,0,,Бейбіт, солай емес пе?
Dialogue: 0,0:06:09.90,0:06:13.00,Default,,0,0,0,,Уухо, мүмкіндігінше мораторийден ләззат алайық!
Dialogue: 0,0:06:13.10,0:06:15.67,Default,,0,0,0,,Мен Каренге бірдеңе дайындадым, мінекей.
Dialogue: 0,0:06:15.97,0:06:17.94,Default,,0,0,0,,Мен өткен күні біртүрлі нәрсе айттым. Мен кешірім сұрамын.
Dialogue: 0,0:06:18.04,0:06:20.58,Default,,0,0,0,,Қайсысы? Не, мен де?
Dialogue: 0,0:06:20.81,0:06:22.84,Default,,0,0,0,,Сізге Карен керек емес, солай ма? иә?
Dialogue: 0,0:06:22.94,0:06:24.88,Default,,0,0,0,,Ол қазірдің өзінде қамтылған жоқ па?
Dialogue: 0,0:06:24.98,0:06:25.98,Default,,0,0,0,,Хмм
Dialogue: 0,0:06:26.08,0:06:29.62,Default,,0,0,0,,Теледидардан көрінгіңіз келе ме? Сіз танымал бола аласыз.
Dialogue: 0,0:06:29.85,0:06:31.59,Default,,0,0,0,,Сіз қалай ойлайсыз?тележұлдыз
Dialogue: 0,0:06:31.69,0:06:33.09,Default,,0,0,0,,Әй, солай бұрыл.
Dialogue: 0,0:06:33.49,0:06:35.42,Default,,0,0,0,,Күрсін, бұлай қалжыңдауды доғар! ―
Dialogue: 0,0:06:35.89,0:06:37.76,Default,,0,0,0,,Одан кейін қиын болды...
Dialogue: 0,0:06:37.93,0:06:40.86,Default,,0,0,0,,Үнемі артынан қуып, сұрақтармен жаулап алу.
Dialogue: 0,0:06:40.96,0:06:42.83,Default,,0,0,0,,Тіпті ваннаның ішінде!
Dialogue: 0,0:06:43.00,0:06:46.57,Default,,0,0,0,,Мен соңғы аптада мектептен шыға алмадым.
Dialogue: 0,0:06:46.80,0:06:50.07,Default,,0,0,0,,Неліктен бізге сыртқа шығуға рұқсат етілмейді?
Dialogue: 0,0:06:50.17,0:06:52.17,Default,,0,0,0,,Иә, бұл достық деп аталады, солай емес пе?
Dialogue: 0,0:06:52.47,0:06:56.18,Default,,0,0,0,,Дүниеге келгенімізде әртүрлі болуымыз мүмкін, бірақ өлгенде бірдей боламыз деп үміттенемін.
Dialogue: 0,0:06:56.48,0:06:57.75,Default,,0,0,0,,Ｂｙ
Dialogue: 0,0:06:57.85,0:06:59.11,Default,,0,0,0,,Бұл ұсыныс па?
Dialogue: 0,0:06:59.58,0:07:01.42,Default,,0,0,0,,Егер мен өлетін болсам, бәрін өзіммен бірге ала келдім.
Dialogue: 0,0:07:01.52,0:07:04.19,Default,,0,0,0,,Жасырын, иә? Созаку А?
Dialogue: 0,0:07:04.92,0:07:06.79,Default,,0,0,0,,Жақсы (қарсылас) Иә?
Dialogue: 0,0:07:07.42,0:07:10.02,Default,,0,0,0,,Қайтадан бірге болғанымызға өте қуаныштымын.
Dialogue: 0,0:07:10.46,0:07:11.93,Default,,0,0,0,,Әй... Ой!
Dialogue: 0,0:07:12.03,0:07:14.06,Default,,0,0,0,,Не, мынау күлетін жер!
Dialogue: 0,0:07:14.16,0:07:15.80,Default,,0,0,0,,Ах! (Лелух) А...
Dialogue: 0,0:07:15.90,0:07:17.63,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:07:17.73,0:07:19.83,Default,,0,0,0,,Бірақ бұл Созакудың жақсы жағы.
Dialogue: 0,0:07:19.93,0:07:22.80,Default,,0,0,0,,Жарайды, кейде атмосфераны оқығым келеді.
Dialogue: 0,0:07:22.90,0:07:24.57,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:07:24.67,0:07:25.97,Default,,0,0,0,,Сіз бұл туралы айтып жатырсыз, солай емес пе?
Dialogue: 0,0:07:26.07,0:07:27.88,Default,,0,0,0,,(Барлығы күледі)
Dialogue: 0,0:07:27.98,0:07:30.88,Default,,0,0,0,,Түсіндім, барлығына көмектестім.
Dialogue: 0,0:07:32.51,0:07:35.15,Default,,0,0,0,,Қонақ үйді ұрлау оқиғасындағы керемет көріністен бастап -
Dialogue: 0,0:07:35.45,0:07:38.22,Default,,0,0,0,,Дүниені қара рыцарьлар бояйды.
Dialogue: 0,0:07:38.72,0:07:42.72,Default,,0,0,0,,Нөл мәлімдегендей, Қара рыцарьлар әлсіздер жағында болды.
Dialogue: 0,0:07:42.82,0:07:44.79,Default,,0,0,0,,Бейбіт тұрғындарды қамтитын терроризм
Dialogue: 0,0:07:44.89,0:07:50.20,Default,,0,0,0,,Үстемшіл әскерилер, тіпті жемқор саясаткерлер, пайдаға бағытталған компаниялар, қылмыстық ұйымдар және т.б.
Dialogue: 0,0:07:50.50,0:07:53.23,Default,,0,0,0,,Ол заңмен бағаланбайтын зұлымдықты біржақты айыптады.
Dialogue: 0,0:07:55.57,0:07:58.47,Default,,0,0,0,,Әп-сәтте батыр атандық.
Dialogue: 0,0:07:58.57,0:07:59.91,Default,,0,0,0,,Бірлескен жұмысшылар саны артты
Dialogue: 0,0:08:00.01,0:08:02.74,Default,,0,0,0,,Мен Nightmare-ді қайтадан ала алдым.
Dialogue: 0,0:08:02.84,0:08:05.11,Default,,0,0,0,,Әрине, бұл жалпыға ортақ әңгіме емес...
Dialogue: 0,0:08:05.21,0:08:06.68,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:08:06.78,0:08:08.82,Default,,0,0,0,,Тоқта, қара рыцарлар...
Dialogue: 0,0:08:08.92,0:08:09.85,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:08:10.25,0:08:12.89,Default,,0,0,0,,Британия туралы жаман сөз айтпа.
Dialogue: 0,0:08:12.99,0:08:15.16,Default,,0,0,0,,Біз он бірміз
Dialogue: 0,0:08:15.49,0:08:16.52,Default,,0,0,0,,Көшбасшы нөл -
Dialogue: 0,0:08:16.62,0:08:19.09,Default,,0,0,0,,Князь Хловисті өлтіргені үшін...
Dialogue: 0,0:08:19.19,0:08:22.66,Default,,0,0,0,,Достарының арасында да оның шынайы жүзін білгісі келетіндер көп.
Dialogue: 0,0:08:22.76,0:08:24.53,Default,,0,0,0,,Мен де солай істеймін.
Dialogue: 0,0:08:24.63,0:08:28.67,Default,,0,0,0,,Бірақ мен оны күштеп салсам, ол жоғалып кететін сияқты...
Dialogue: 0,0:08:28.84,0:08:33.01,Default,,0,0,0,,Мүмкін біз енді онсыз жүре алмайтын шығармыз.
Dialogue: 0,0:08:33.11,0:08:35.01,Default,,0,0,0,,Жақында...
Dialogue: 0,0:08:35.74,0:08:37.61,Default,,0,0,0,,Сіздің қарым-қатынасыңыз нашар емес пе?
Dialogue: 0,0:08:37.71,0:08:39.08,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:08:39.28,0:08:40.55,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:08:40.65,0:08:42.88,Default,,0,0,0,,(Пернетақтаны түрту дыбысы)
Dialogue: 0,0:08:45.65,0:08:47.09,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:08:48.76,0:08:50.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:51.03,0:08:52.96,Default,,0,0,0,,Евфемияға көмектескендерге
Dialogue: 0,0:08:53.06,0:08:55.03,Default,,0,0,0,,Адамдар неліктен ынтымақтасады?
Dialogue: 0,0:08:55.13,0:08:57.23,Default,,0,0,0,,Тіпті Киото да Қара рыцарларға қосылады.
Dialogue: 0,0:08:57.53,0:08:59.17,Default,,0,0,0,,Ол Гурен 2 рәсімін айналдыратынын айтты.
Dialogue: 0,0:08:59.27,0:09:00.77,Default,,0,0,0,,Сіз сондай ұры болып көрінесіз бе?
Dialogue: 0,0:09:00.87,0:09:02.54,Default,,0,0,0,,Олар қарсылық емес-
Dialogue: 0,0:09:02.64,0:09:04.77,Default,,0,0,0,,Оған дәлел ретінде қолбасшы Құсақабені өлтірді.
Dialogue: 0,0:09:04.87,0:09:06.91,Default,,0,0,0,,Подполковник өз-өзіне қол жұмсады, солай ма?
Dialogue: 0,0:09:07.01,0:09:09.11,Default,,0,0,0,,Оны тоқтатпады деген қауесеттер де бар.
Dialogue: 0,0:09:09.21,0:09:12.58,Default,,0,0,0,,Подполковник Тодо Қалай болғанда да, осылайша,
Dialogue: 0,0:09:18.32,0:09:21.26,Default,,0,0,0,,Карен Леди Карен Леди
Dialogue: 0,0:09:22.72,0:09:23.66,Default,,0,0,0,,Мен онымен екеуміз ғана, бір рет болса да сөйлескенді қатты қалаймын. Хехе.
Dialogue: 0,0:09:23.76,0:09:25.63,Default,,0,0,0,,Мен сізге бір нәрсе бергім келеді.
Dialogue: 0,0:09:25.73,0:09:26.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:28.03,0:09:30.03,Default,,0,0,0,,Оны қайсысына беруім керек?
Dialogue: 0,0:09:30.13,0:09:31.23,Default,,0,0,0,,Бұл қонақ бөлмесі ме, әлде...
Dialogue: 0,0:09:31.33,0:09:32.70,Default,,0,0,0,,Менің бөлмемде
Dialogue: 0,0:09:32.80,0:09:34.24,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:09:34.34,0:09:35.70,Default,,0,0,0,,О, ха!
Dialogue: 0,0:09:35.80,0:09:38.57,Default,,0,0,0,,Сіз менің досым деп айтқандықтан, мен оны жігіт деп ойладым...
Dialogue: 0,0:09:38.74,0:09:42.71,Default,,0,0,0,,Таңертең үйге қайтып келе жатқанда мектепке бармайды, геттоға кіріп-шығатын сияқты.
Dialogue: 0,0:09:42.98,0:09:45.78,Default,,0,0,0,,Әкеңнің еліңде болғанына қуаныштымын.
Dialogue: 0,0:09:46.28,0:09:47.88,Default,,0,0,0,,Қан үшін күресуге болмайды.
Dialogue: 0,0:09:47.98,0:09:49.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:50.08,0:09:53.05,Default,,0,0,0,,Әкеңнің жоқтығына рахаттанып жүрген сен болсаң керек!
Dialogue: 0,0:09:53.15,0:09:54.02,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:54.59,0:09:56.06,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:56.66,0:09:59.36,Default,,0,0,0,,Ах... Не істеуіміз керек? Біз не істеуіміз керек?
Dialogue: 0,0:09:59.66,0:10:01.70,Default,,0,0,0,,Не істеп жатырсың!сен!
Dialogue: 0,0:10:01.80,0:10:02.90,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:10:03.00,0:10:03.93,Default,,0,0,0,,Кешіріңіз, ханым.
Dialogue: 0,0:10:04.27,0:10:06.27,Default,,0,0,0,,Оны шынымен пайдалану мүмкін емес.
Dialogue: 0,0:10:06.63,0:10:08.60,Default,,0,0,0,,Әйелдерді сатудан басқа амалым жоқ.
Dialogue: 0,0:10:09.74,0:10:12.77,Default,,0,0,0,,Өте күрделі отбасы сияқты.
Dialogue: 0,0:10:12.87,0:10:14.38,Default,,0,0,0,,Сіз не бергіңіз келеді?
Dialogue: 0,0:10:14.74,0:10:16.74,Default,,0,0,0,,Иә, атам сұрады.
Dialogue: 0,0:10:16.84,0:10:17.85,Default,,0,0,0,,Мектеп директорына?
Dialogue: 0,0:10:18.65,0:10:20.75,Default,,0,0,0,,Кіші орта мектептен транскрипт
Dialogue: 0,0:10:20.85,0:10:22.02,Default,,0,0,0,,Ах
Dialogue: 0,0:10:22.12,0:10:25.25,Default,,0,0,0,,Мектепте саған бермегенім дұрыс деп ойладым.
Dialogue: 0,0:10:25.35,0:10:27.39,Default,,0,0,0,,Бұл ұсталды дегенді білдіреді.
Dialogue: 0,0:10:27.69,0:10:31.63,Default,,0,0,0,,Мен жартылай британдықпын және жартысы он бірмін
Dialogue: 0,0:10:33.69,0:10:35.26,Default,,0,0,0,,Бұл менің өгей шешем.
Dialogue: 0,0:10:35.96,0:10:39.37,Default,,0,0,0,,Менің нағыз анам вазаны қағып алған ебедейсіз қызметші.
Dialogue: 0,0:10:41.34,0:10:44.84,Default,,0,0,0,,Сіздің әкеңіз... Штадтфельдтер отбасының басшысы ма?
Dialogue: 0,0:10:45.41,0:10:47.38,Default,,0,0,0,,Менің анам ақымақ.
Dialogue: 0,0:10:47.74,0:10:49.21,Default,,0,0,0,,Ақырында маған қызметші ретінде қарады.
Dialogue: 0,0:10:49.91,0:10:51.75,Default,,0,0,0,,Мен көп жұмыс істей алмаймын...
Dialogue: 0,0:10:51.85,0:10:52.88,Default,,0,0,0,,Мені қанша мазақ етсең де...
Dialogue: 0,0:10:52.98,0:10:55.92,Default,,0,0,0,,Менің қолымнан келетіні - дауыстап күлу...
Dialogue: 0,0:10:56.02,0:10:58.99,Default,,0,0,0,,Мен осы үйде өмір сүрудің қиыншылығын көрмесем ғой.
Dialogue: 0,0:10:59.09,0:11:01.96,Default,,0,0,0,,Қысқасы, мен бұрынғы адамға жабысып жатырмын.
Dialogue: 0,0:11:02.72,0:11:04.19,Default,,0,0,0,,Мен сені жек көремін, анашым.
Dialogue: 0,0:11:04.86,0:11:05.93,Default,,0,0,0,,Бұл жай ғана тітіркендіргіш.
Dialogue: 0,0:11:06.26,0:11:08.06,Default,,0,0,0,,Бұл ауыр оқиға.
Dialogue: 0,0:11:08.73,0:11:12.20,Default,,0,0,0,,Заңды әйелім, қалыңдығым және оның қызының бірге тұратынына сене алмаймын.
Dialogue: 0,0:11:12.30,0:11:13.87,Default,,0,0,0,,Шын мәнінде емес.
Dialogue: 0,0:11:13.97,0:11:15.80,Default,,0,0,0,,Тамақтың, киім-кешек пен баспананың қажеті жоқ.
Dialogue: 0,0:11:16.27,0:11:19.44,Default,,0,0,0,,Мен бұған шыдай алмаймын деген сөз емес.
Dialogue: 0,0:11:19.74,0:11:21.04,Default,,0,0,0,,Иә? ―
Dialogue: 0,0:11:21.38,0:11:22.71,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:11:22.81,0:11:25.21,Default,,0,0,0,,Әр нәрсеге шыдай алатын нәрсе болса да...
Dialogue: 0,0:11:25.31,0:11:28.72,Default,,0,0,0,,Егер сіз заттарды үйіп тастасаңыз, олар ақырында тозады.
Dialogue: 0,0:11:29.88,0:11:31.15,Default,,0,0,0,,Жарайды
Dialogue: 0,0:11:31.25,0:11:35.69,Default,,0,0,0,,Мен басқалардың құпиясын білгісі келетін адаммын, бірақ оларға айту хоббиім жоқ.
Dialogue: 0,0:11:41.80,0:11:43.20,Default,,0,0,0,,Ой...
Dialogue: 0,0:11:43.86,0:11:46.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:46.77,0:11:48.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:53.44,0:11:55.24,Default,,0,0,0,,Ондай жерде жылама.
Dialogue: 0,0:11:55.34,0:11:56.38,Default,,0,0,0,,Ұят
Dialogue: 0,0:11:56.48,0:11:57.81,Default,,0,0,0,,Шынымды айт.
Dialogue: 0,0:11:57.91,0:11:58.78,Default,,0,0,0,,Уф!
Dialogue: 0,0:11:58.98,0:12:00.75,Default,,0,0,0,,Барлығы құтқарылды, өйткені...
Dialogue: 0,0:12:00.85,0:12:01.92,Default,,0,0,0,,Бұл жақсы болды...
Dialogue: 0,0:12:02.02,0:12:04.15,Default,,0,0,0,,Қара рыцарьлар
Dialogue: 0,0:12:04.25,0:12:05.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:06.75,0:12:10.22,Default,,0,0,0,,Қылмыскерлерді қудалағыңыз келсе, полицияға қосылыңыз.
Dialogue: 0,0:12:10.32,0:12:12.86,Default,,0,0,0,,Неліктен олар мұны істемейді?
Dialogue: 0,0:12:13.46,0:12:17.16,Default,,0,0,0,,Менің ойымша, сіз полиция мұны істей алмайды деп ойладыңыз ...
Dialogue: 0,0:12:17.43,0:12:21.30,Default,,0,0,0,,Қазір жұмыс істемесе де, сіз полицияға қосылып, оны өзгерте аласыз.
Dialogue: 0,0:12:21.77,0:12:22.94,Default,,0,0,0,,Өзгерту процесінде -
Dialogue: 0,0:12:23.04,0:12:25.84,Default,,0,0,0,,Соңында сіз әртүрлі шектеулерге тап боласыз.
Dialogue: 0,0:12:26.01,0:12:26.87,Default,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:12:26.97,0:12:30.11,Default,,0,0,0,,Мен мұны соңғы мүмкіндігінше өзгертуге күш салған соң ғана айта аламын.
Dialogue: 0,0:12:30.21,0:12:33.38,Default,,0,0,0,,Егер олар мұны жасамаса, олардың дәлелдері өзін-өзі ақтаудан басқа ештеңе емес.
Dialogue: 0,0:12:34.05,0:12:35.12,Default,,0,0,0,,Өзін-өзі ақтау?
Dialogue: 0,0:12:35.22,0:12:37.22,Default,,0,0,0,,Олар қандай жамандық айтады? ―
Dialogue: 0,0:12:37.32,0:12:40.15,Default,,0,0,0,,Сіз стандарттың қандай екенін де білмейсіз.
Dialogue: 0,0:12:40.25,0:12:42.22,Default,,0,0,0,,Бұл бір жақты өзін-өзі қанағаттандыру.
Dialogue: 0,0:12:42.22,0:12:42.86,Default,,0,0,0,,Бұл бір жақты өзін-өзі қанағаттандыру.
Dialogue: 0,0:12:42.22,0:12:42.86,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:12:42.86,0:12:43.29,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:12:43.39,0:12:44.26,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:44.46,0:12:46.86,Default,,0,0,0,,Бұл тек екеуің бе?
Dialogue: 0,0:12:47.96,0:12:51.47,Default,,0,0,0,,Жарайды, мен әскерге қайта баруым керек.
Dialogue: 0,0:12:51.77,0:12:52.47,Default,,0,0,0,,Ширли кездескенше
Dialogue: 0,0:12:52.77,0:12:53.53,Default,,0,0,0,,… …
Dialogue: 0,0:12:54.20,0:12:55.84,Default,,0,0,0,,Хехе, кездескенше
Dialogue: 0,0:12:57.87,0:12:58.54,Default,,0,0,0,,Хун
Dialogue: 0,0:13:00.01,0:13:01.08,Default,,0,0,0,,Иә
Dialogue: 0,0:13:06.35,0:13:08.08,Default,,0,0,0,,Сәлем Лулу
Dialogue: 0,0:13:08.42,0:13:10.42,Default,,0,0,0,,… …
Dialogue: 0,0:13:10.82,0:13:13.15,Default,,0,0,0,,Уақыт болса, жақсы болар еді, бірақ менімен...
Dialogue: 0,0:13:13.25,0:13:16.12,Default,,0,0,0,,Ол әскерге қайта бару керектігін айтты.
Dialogue: 0,0:13:16.22,0:13:17.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:17.83,0:13:18.89,Default,,0,0,0,,«Артқа»…—
Dialogue: 0,0:13:18.99,0:13:21.26,Default,,0,0,0,,Бұл сіздің тиесілі жеріңізді білдіре ме?
Dialogue: 0,0:13:21.86,0:13:22.83,Default,,0,0,0,,Тоқтау керек пе?
Dialogue: 0,0:13:22.93,0:13:24.06,Default,,0,0,0,,) Есірткі
Dialogue: 0,0:13:24.17,0:13:26.43,Default,,0,0,0,,Уақытты кері қайтарғандай сезім тудыратын қасиет пе?
Dialogue: 0,0:13:26.53,0:13:29.04,Default,,0,0,0,,Менің ойымша, бұл әсіресе жапондықтар арасында жақсы сатылады.
Dialogue: 0,0:13:29.14,0:13:33.57,Default,,0,0,0,,Барлығы Жапонияны Британия басып алғанға дейін оны ностальгиямен сезінеді.
Dialogue: 0,0:13:33.87,0:13:34.94,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:35.04,0:13:37.34,Default,,0,0,0,,Бұл жапондықтарға арналған препарат.
Dialogue: 0,0:13:37.44,0:13:39.31,Default,,0,0,0,,Мен сені жалғыз қалдыра алмаймын.
Dialogue: 0,0:13:39.88,0:13:42.25,Default,,0,0,0,,Сұраныссыз керек-жарақтар келген бойда біз бірден қозғаламыз.
Dialogue: 0,0:13:42.58,0:13:43.95,Default,,0,0,0,,Жабдықтар да көбейді...
Dialogue: 0,0:13:44.05,0:13:47.19,Default,,0,0,0,,Дос болғысы келетіндер көп деп естідім.
Dialogue: 0,0:13:47.29,0:13:49.16,Default,,0,0,0,,Қара рыцарьлар танымал.
Dialogue: 0,0:13:49.26,0:13:51.96,Default,,0,0,0,,Өйткені мен әділдіктің одақтасымын.
Dialogue: 0,0:13:52.06,0:13:53.83,Default,,0,0,0,,Оқ-дәрі келгенде мен сізге қайта хабарласамын.
Dialogue: 0,0:13:56.20,0:13:57.83,Default,,0,0,0,,Бірдеңе айт! Он бір!
Dialogue: 0,0:13:57.93,0:13:59.53,Default,,0,0,0,,Иә? (Жас жігіт) Кешірім сұра. Кешіріңіз.
Dialogue: 0,0:13:59.83,0:14:02.04,Default,,0,0,0,,Он бір басын төмен ұстауға шебер болуы керек!
Dialogue: 0,0:14:02.27,0:14:04.31,Default,,0,0,0,,Он бір... хмм
Dialogue: 0,0:14:04.41,0:14:05.57,Default,,0,0,0,,Ха! ―
Dialogue: 0,0:14:06.07,0:14:07.07,Default,,0,0,0,,Лелуш!
Dialogue: 0,0:14:07.17,0:14:08.44,Default,,0,0,0,,5 қарсылас бар.
Dialogue: 0,0:14:08.54,0:14:09.61,Default,,0,0,0,,Жеңіске жетудің жолы жоқ, солай ма?
Dialogue: 0,0:14:10.21,0:14:11.55,Default,,0,0,0,,Бұл сіз оны жалғыз қалдыра аласыз дегенді білдіре ме?
Dialogue: 0,0:14:11.85,0:14:13.95,Default,,0,0,0,,Он бірге шабуыл жасап жатқанын мұқият қараңыз.
Dialogue: 0,0:14:14.05,0:14:15.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:15.38,0:14:17.02,Default,,0,0,0,,Жарайды... хмм
Dialogue: 0,0:14:17.12,0:14:19.59,Default,,0,0,0,,Оларға көмектесуге және оларды жеңуге тырысыңыз.
Dialogue: 0,0:14:19.89,0:14:22.92,Default,,0,0,0,,Ертеңнен бастап он бір бұдан былай мұнда бизнес жасай алмайды.
Dialogue: 0,0:14:23.29,0:14:26.06,Default,,0,0,0,,Ол Британияның құлын өзі таңдады.
Dialogue: 0,0:14:26.43,0:14:29.13,Default,,0,0,0,,Концессияда жұмыс істеу деген осы емес пе?
Dialogue: 0,0:14:29.23,0:14:30.20,Default,,0,0,0,,Сол себепті!
Dialogue: 0,0:14:30.30,0:14:32.07,Default,,0,0,0,,Сіз шағымданасыз ба?Осылайша
Dialogue: 0,0:14:32.33,0:14:34.13,Default,,0,0,0,,Он бірді аяйсыз ба?
Dialogue: 0,0:14:34.24,0:14:37.04,Default,,0,0,0,,Жоқ, сіз бізге қосылғыңыз келеді, солай ма?
Dialogue: 0,0:14:37.30,0:14:38.64,Default,,0,0,0,,Мүмкін емес—
Dialogue: 0,0:14:40.31,0:14:42.28,Default,,0,0,0,,Сіз одан шаршадыңыз ба? ―
Dialogue: 0,0:14:42.38,0:14:44.01,Default,,0,0,0,,Он бір қорқыту
Dialogue: 0,0:14:47.62,0:14:49.52,Default,,0,0,0,,Бұл қызықсыз.
Dialogue: 0,0:14:49.62,0:14:50.58,Default,,0,0,0,,Аркадаға барғыңыз келе ме?
Dialogue: 0,0:14:50.89,0:14:52.12,Default,,0,0,0,,Эй, ақша жоқ.
Dialogue: 0,0:14:52.22,0:14:53.25,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:53.35,0:14:55.36,Default,,0,0,0,,Олар жалықтыратын адамдар.
Dialogue: 0,0:14:56.02,0:14:58.23,Default,,0,0,0,,… …
Dialogue: 0,0:14:58.33,0:15:00.53,Default,,0,0,0,,Амансың ба? (Еркек) Ух... аааа
Dialogue: 0,0:15:00.63,0:15:03.43,Default,,0,0,0,,Ах, Британдық студент.
Dialogue: 0,0:15:03.53,0:15:05.27,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:15:05.37,0:15:07.40,Default,,0,0,0,,Хмм, Калифорния док туралы не деуге болады?
Dialogue: 0,0:15:07.50,0:15:08.40,Default,,0,0,0,,Не? (Еркек) Ах! ―
Dialogue: 0,0:15:09.00,0:15:10.20,Default,,0,0,0,,Сіз ғашықсыз ба? ―
Dialogue: 0,0:15:10.30,0:15:11.94,Default,,0,0,0,,Қаласаңыз, екеуіңіз қош келдіңіздер! ―
Dialogue: 0,0:15:12.27,0:15:14.28,Default,,0,0,0,,Бізде балмұздақ бар.
Dialogue: 0,0:15:14.91,0:15:16.04,Default,,0,0,0,,11-аудан
Dialogue: 0,0:15:16.14,0:15:19.58,Default,,0,0,0,,Жапонияда болғанмен салыстырғанда жағдай жақсарды деп айтуға болады.
Dialogue: 0,0:15:19.68,0:15:22.22,Default,,0,0,0,,Британияның колония аймағына кіру мүмкіндігінің арқасында-
Dialogue: 0,0:15:22.32,0:15:25.22,Default,,0,0,0,,Әскери және экономика әлдеқайда тұрақты болды.
Dialogue: 0,0:15:25.32,0:15:27.22,Default,,0,0,0,,Азаматтық та бар.
Dialogue: 0,0:15:27.32,0:15:29.09,Default,,0,0,0,,Егер сіз мемлекеттік мекемеге барып, процедураларды орындасаңыз...
Dialogue: 0,0:15:29.19,0:15:31.43,Default,,0,0,0,,Сіз құрметті британдық бола аласыз.
Dialogue: 0,0:15:31.53,0:15:33.29,Default,,0,0,0,,Қалғаны мақтаныш.
Dialogue: 0,0:15:33.39,0:15:36.43,Default,,0,0,0,,Мен мұнымен айналысқым келетінін түсінемін.
Dialogue: 0,0:15:36.96,0:15:38.47,Default,,0,0,0,,Сонымен? (Лелух) Иә?
Dialogue: 0,0:15:38.57,0:15:40.17,Default,,0,0,0,,Мен түсінемін...
Dialogue: 0,0:15:40.27,0:15:42.70,Default,,0,0,0,,Лелуш Ламперуж не ойлайды? ―
Dialogue: 0,0:15:43.00,0:15:44.14,Default,,0,0,0,,Сіз не істегіңіз келеді?
Dialogue: 0,0:15:44.24,0:15:45.27,Default,,0,0,0,,Бөлек
Dialogue: 0,0:15:45.47,0:15:49.21,Default,,0,0,0,,Сіз өте ақылды сияқтысыз, бірақ ұстанбаңыз.
Dialogue: 0,0:15:49.31,0:15:50.68,Default,,0,0,0,,Ширли жоқтап жатты.
Dialogue: 0,0:15:50.98,0:15:54.21,Default,,0,0,0,,Лулу ақылды болса да көп тырыспайды.
Dialogue: 0,0:15:54.45,0:15:55.95,Default,,0,0,0,,Сондықтан сіз ештеңе істемейсіз.
Dialogue: 0,0:15:56.05,0:15:57.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:57.22,0:15:59.35,Default,,0,0,0,,Мен бұрынғыдан он бір екенін білемін.
Dialogue: 0,0:15:59.45,0:16:02.72,Default,,0,0,0,,Британдықтарға бас исең, жақсы өмір сүре аласың дейді.
Dialogue: 0,0:16:03.02,0:16:03.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:06.03,0:16:06.99,Default,,0,0,0,,Уф!
Dialogue: 0,0:16:07.09,0:16:08.13,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:08.50,0:16:09.96,Default,,0,0,0,,Бұл керемет деп ойлайсыз ба?
Dialogue: 0,0:16:10.06,0:16:13.23,Default,,0,0,0,,Ондай сыншы дүниеге қиғаш қырынан қарайды!
Dialogue: 0,0:16:14.70,0:16:17.54,Default,,0,0,0,,Мен тіпті ең кішкентай үміттерге ие болу үшін ақымақ болдым.
Dialogue: 0,0:16:17.64,0:16:20.27,Default,,0,0,0,,Мен оны сәл жақсырақ адам деп ойладым.
Dialogue: 0,0:16:23.18,0:16:24.04,Default,,0,0,0,,Иә
Dialogue: 0,0:16:27.28,0:16:28.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:30.32,0:16:31.65,Default,,0,0,0,,Қызғылт сары оқиға...
Dialogue: 0,0:16:31.75,0:16:34.56,Default,,0,0,0,,Ух (Вилетта) Кешіріңіз.
Dialogue: 0,0:16:34.66,0:16:37.49,Default,,0,0,0,,Созаку Куруруги ұрлық оқиғасы кезінде
Dialogue: 0,0:16:37.59,0:16:40.03,Default,,0,0,0,,Раббыңыз туралы естелік жоқ деген рас па?
Dialogue: 0,0:16:40.13,0:16:42.06,Default,,0,0,0,,Маған сенгеніңді қаламаймын.
Dialogue: 0,0:16:42.16,0:16:43.16,Default,,0,0,0,,Жоқ
Dialogue: 0,0:16:43.26,0:16:47.57,Default,,0,0,0,,Шындығында, мен де Синджуку оқиғасы кезінде есте сақтау қабілетін жоғалттым.
Dialogue: 0,0:16:47.67,0:16:48.54,Default,,0,0,0,,Не?
Dialogue: 0,0:16:48.67,0:16:52.54,Default,,0,0,0,,Мен ес жиған кезде, Сазерленд менің қолымнан алынды.
Dialogue: 0,0:16:52.64,0:16:57.28,Default,,0,0,0,,Жадым жоғалар алдында мен мектеп формасын киген баланы кездестірдім.
Dialogue: 0,0:16:57.48,0:16:59.08,Default,,0,0,0,,Бұл студент ше?
Dialogue: 0,0:16:59.31,0:17:00.71,Default,,0,0,0,,Бетіңізді есіме түсіре алмаймын.
Dialogue: 0,0:17:01.02,0:17:03.78,Default,,0,0,0,,Бірақ оны зерттеуге тұрарлық па?
Dialogue: 0,0:17:05.15,0:17:07.42,Default,,0,0,0,,Нөл не ойлады?
Dialogue: 0,0:17:07.52,0:17:09.42,Default,,0,0,0,,Сіз Британияны жеңемін десеңіз де.
Dialogue: 0,0:17:09.66,0:17:12.46,Default,,0,0,0,,Сіздің істеп жатқаныңыз полицияға көмектесу емес пе?
Dialogue: 0,0:17:12.56,0:17:15.40,Default,,0,0,0,,Бірақ біреудің бағалағаны жаман емес.
Dialogue: 0,0:17:15.50,0:17:17.60,Default,,0,0,0,,Дұрыс, мен интернеттегі кейіпкермін.
Dialogue: 0,0:17:17.70,0:17:18.56,Default,,0,0,0,,Оқиға
Dialogue: 0,0:17:19.23,0:17:21.80,Default,,0,0,0,,Бізде бұл жақсы, солай ма?
Dialogue: 0,0:17:22.40,0:17:23.30,Default,,0,0,0,,Карен
Dialogue: 0,0:17:25.67,0:17:27.17,Default,,0,0,0,,Бұл нөлден келетін сигнал.
Dialogue: 0,0:17:27.57,0:17:28.78,Default,,0,0,0,,Сіз оны жақсылап қойдыңыз.
Dialogue: 0,0:17:29.08,0:17:31.58,Default,,0,0,0,,Әр жолы қандай сиқырлы амалдарды қолдандыңыз?
Dialogue: 0,0:17:36.75,0:17:38.49,Default,,0,0,0,,Нагояның бөлігі аяқталды ма?
Dialogue: 0,0:17:38.59,0:17:40.55,Default,,0,0,0,,Бұл концессия ішінде қауіпсіз.
Dialogue: 0,0:17:41.59,0:17:43.39,Default,,0,0,0,,(Ерлердің айқайы)
Dialogue: 0,0:17:43.62,0:17:44.76,Default,,0,0,0,,Дория
Dialogue: 0,0:17:45.19,0:17:47.46,Default,,0,0,0,,Қара рыцарьлар келді!
Dialogue: 0,0:17:47.66,0:17:48.83,Default,,0,0,0,,Зиянкес!
Dialogue: 0,0:17:51.30,0:17:52.43,Default,,0,0,0,,Қорқыныш! (Еркек) Міне!
Dialogue: 0,0:17:52.53,0:17:53.43,Default,,0,0,0,,Мен қалжыңдамаймын!
Dialogue: 0,0:17:53.53,0:17:54.84,Default,,0,0,0,,(Ерлердің айқайы)
Dialogue: 0,0:17:58.07,0:18:01.51,Default,,0,0,0,,Қошмар таңғажайып!Бір ғана машинамен таң қалдырады
Dialogue: 0,0:18:06.55,0:18:07.48,Default,,0,0,0,,Ах
Dialogue: 0,0:18:09.42,0:18:11.19,Default,,0,0,0,,Жапония!Жапония!
Dialogue: 0,0:18:11.29,0:18:13.29,Default,,0,0,0,,Иә, мен келесі айда үйленемін!
Dialogue: 0,0:18:13.39,0:18:15.59,Default,,0,0,0,,Өркендеу уақыты келді!Бұл жолы Париж филиалы.
Dialogue: 0,0:18:15.69,0:18:17.62,Default,,0,0,0,,Келесі аптадағы отшашу, сіз менімен бірге барасыз, солай ма?
Dialogue: 0,0:18:17.72,0:18:21.13,Default,,0,0,0,,Оны бізге қалдырыңыз! Жапонияның технологиясы әлемдегі ең жақсы!
Dialogue: 0,0:18:21.23,0:18:22.26,Default,,0,0,0,,Тоқта
Dialogue: 0,0:18:22.60,0:18:24.10,Default,,0,0,0,,Шешілді! Шетелде оқу
Dialogue: 0,0:18:24.20,0:18:25.53,Default,,0,0,0,,Мен мұны істеймін!
Dialogue: 0,0:18:25.67,0:18:26.53,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:26.63,0:18:27.73,Default,,0,0,0,,Егер сіз...
Dialogue: 0,0:18:27.84,0:18:30.17,Default,,0,0,0,,Бір күні тозады
Dialogue: 0,0:18:30.27,0:18:32.54,Default,,0,0,0,,Дұрыс, сондықтан мен!
Dialogue: 0,0:18:32.64,0:18:34.81,Default,,0,0,0,,Қараңызшы, егер сіз жүгірсеңіз қауіпті.
Dialogue: 0,0:18:35.11,0:18:36.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:39.28,0:18:40.55,Default,,0,0,0,,Ана? (Кареннің анасы) Ах!
Dialogue: 0,0:18:40.65,0:18:41.65,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:46.59,0:18:47.86,Default,,0,0,0,,Сәлем Наото!
Dialogue: 0,0:18:48.16,0:18:50.42,Default,,0,0,0,,Сіз Каренді бақылап отыруыңыз керек.
Dialogue: 0,0:18:51.86,0:18:54.50,Default,,0,0,0,,Сен қаншалықты әлсізсің, әйел?
Dialogue: 0,0:18:54.60,0:18:56.83,Default,,0,0,0,,Британияға жабысыңыз Ер адамға жабысыңыз
Dialogue: 0,0:18:57.13,0:18:58.27,Default,,0,0,0,,Бұл жолы медицина!
Dialogue: 0,0:18:58.37,0:18:59.90,Default,,0,0,0,,Менің ағам енді жоқ.
Dialogue: 0,0:19:00.20,0:19:01.20,Default,,0,0,0,,Енді жоқ!
Dialogue: 0,0:19:01.30,0:19:02.47,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:03.87,0:19:04.87,Default,,0,0,0,,Не? ―
Dialogue: 0,0:19:05.17,0:19:06.74,Default,,0,0,0,,Түнгі полиция?
Dialogue: 0,0:19:09.61,0:19:10.71,Default,,0,0,0,,Бұл полиция, солай емес пе?
Dialogue: 0,0:19:10.81,0:19:12.55,Default,,0,0,0,,Гуру дейсіз бе? Тамаки!
Dialogue: 0,0:19:12.65,0:19:15.38,Default,,0,0,0,,Мен білмеймін! Мен оған қарасам, бұл шындық болды ...
Dialogue: 0,0:19:15.85,0:19:17.52,Default,,0,0,0,,Бұл шірік
Dialogue: 0,0:19:27.36,0:19:28.50,Default,,0,0,0,,Уф
Dialogue: 0,0:19:28.76,0:19:30.43,Default,,0,0,0,,Уф, бұл мазасыздық!
Dialogue: 0,0:19:33.33,0:19:34.33,Default,,0,0,0,,Неге...
Dialogue: 0,0:19:34.43,0:19:36.24,Default,,0,0,0,,Маған керек емес...
Dialogue: 0,0:19:36.70,0:19:37.80,Default,,0,0,0,,Бұл маған қажет емес!
Dialogue: 0,0:19:42.91,0:19:44.44,Default,,0,0,0,,Уф аа
Dialogue: 0,0:19:46.35,0:19:48.45,Default,,0,0,0,,Карен… Наото
Dialogue: 0,0:19:49.92,0:19:51.19,Default,,0,0,0,,Га
Dialogue: 0,0:19:52.25,0:19:53.42,Default,,0,0,0,,Осыншама өмірді сақтап жүргенде…
Dialogue: 0,0:19:57.42,0:19:58.66,Default,,0,0,0,,Түнгі түнге қарсы...
Dialogue: 0,0:20:03.73,0:20:05.43,Default,,0,0,0,,Қаш... Ро...
Dialogue: 0,0:20:06.63,0:20:07.90,Default,,0,0,0,,Қаш!Ақымақ!
Dialogue: 0,0:20:09.30,0:20:10.90,Default,,0,0,0,,Өйткені бар, ха!
Dialogue: 0,0:20:11.47,0:20:15.51,Default,,0,0,0,,Өйткені мен әрқашан жаныңда боламын...Карен Мен сенің жаныңда боламын.
Dialogue: 0,0:20:15.61,0:20:16.48,Default,,0,0,0,,Райден Нет AB Гранд Чемпионаты
Dialogue: 0,0:20:19.25,0:20:19.91,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:20:20.28,0:20:22.32,Default,,0,0,0,,Сонда... сен менің үйімде осылай тұрдың ба?
Dialogue: 0,0:20:22.68,0:20:25.69,Default,,0,0,0,,Ондай нәрсе үшін ақымақ болма!
Dialogue: 0,0:20:25.79,0:20:26.65,Default,,0,0,0,,Уф!
Dialogue: 0,0:20:34.86,0:20:35.96,Default,,0,0,0,,Идиоттар...
Dialogue: 0,0:20:36.26,0:20:37.83,Default,,0,0,0,,Бұл менмін!
Dialogue: 0,0:20:51.35,0:20:52.41,Default,,0,0,0,,Карен!
Dialogue: 0,0:20:53.01,0:20:55.02,Default,,0,0,0,,А... қарғыс атсын...
Dialogue: 0,0:20:55.82,0:20:56.68,Default,,0,0,0,,Га
Dialogue: 0,0:20:58.85,0:21:00.69,Default,,0,0,0,,Сізге жақсы Карен
Dialogue: 0,0:21:00.79,0:21:03.29,Default,,0,0,0,,Сіз британдық бола аласыз.
Dialogue: 0,0:21:03.59,0:21:06.69,Default,,0,0,0,,Егер бұлай болса, сізді тағы ұрмайды.
Dialogue: 0,0:21:06.79,0:21:09.93,Default,,0,0,0,,Сіз телефон соғуға және еркін саяхаттауға болады.
Dialogue: 0,0:21:10.56,0:21:13.27,Default,,0,0,0,,Ана... болды ма?
Dialogue: 0,0:21:14.50,0:21:17.80,Default,,0,0,0,,) Жалған көз жас адамды жаралайды.
Dialogue: 0,0:21:18.41,0:21:20.74,Default,,0,0,0,,Өтірік күлімсіреу сізді...
Dialogue: 0,0:21:24.95,0:21:28.58,Default,,0,0,0,,Бұл препараттың кейінгі әсері. Мен әрең сөйлей аламын.
Dialogue: 0,0:21:28.98,0:21:32.32,Default,,0,0,0,,Мен сауығып кетсем де, уақыт керек деп ойлаймын...
Dialogue: 0,0:21:33.62,0:21:37.52,Default,,0,0,0,,20
Dialogue: 0,0:21:40.29,0:21:41.30,Default,,0,0,0,,Каранэс ауданына оралу.
Dialogue: 0,0:21:41.40,0:21:44.46,Default,,0,0,0,,Анаң келгенше өзгертемін.
Dialogue: 0,0:21:45.00,0:21:48.40,Default,,0,0,0,,Анам екеуміз қалыпты өмір сүре алатын әлемде.
Dialogue: 0,0:21:48.64,0:21:51.84,Default,,0,0,0,,… …
Dialogue: 0,0:21:52.34,0:21:53.47,Default,,0,0,0,,Га
Dialogue: 0,0:21:54.71,0:21:55.58,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:21:55.74,0:21:56.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:57.51,0:22:00.75,Default,,0,0,0,,Сәттілік Карен қызым
Dialogue: 0,0:22:00.85,0:22:01.72,Default,,0,0,0,,Ах ха…
Dialogue: 0,0:22:06.69,0:22:08.79,Default,,0,0,0,,Иә, мен қолымнан келгеннің бәрін жасаймын.
Dialogue: 0,0:22:13.86,0:22:16.40,Default,,0,0,0,,Мен бар күшімді саламын
Dialogue: 0,0:22:17.73,0:22:21.40,Default,,0,0,0,,♪～
Dialogue: 0,0:22:21.50,0:22:25.04,Default,,0,0,0,,♪Мен жүрмін, бірақ мен арыстан мен жолбарыстың арылдаған жолмен жүріп келемін
Dialogue: 0,0:22:25.34,0:22:28.91,Default,,0,0,0,,♪Қызыл аспанның арғы жағында, Махороба
Dialogue: 0,0:22:29.01,0:22:32.71,Default,,0,0,0,,♪Тұтқынның оңашалығында қаңғыған жас
Dialogue: 0,0:22:32.81,0:22:36.55,Default,,0,0,0,,♪Әлсіздік пен ашу көзге көрінбейтін жау ма?
Dialogue: 0,0:22:36.65,0:22:42.02,Default,,0,0,0,,♪Әке, мен өзімді әлі білмеймін.
Dialogue: 0,0:22:44.06,0:22:48.10,Default,,0,0,0,,♪Алдыңғы ағайындар
Dialogue: 0,0:22:48.40,0:22:51.80,Default,,0,0,0,,♪Көрінбейтін арқаңа ерсең
Dialogue: 0,0:22:51.90,0:22:58.87,Default,,0,0,0,,♪Таң жұлдызы сізді адасқан түнге шақырады
Dialogue: 0,0:22:59.54,0:23:02.98,Default,,0,0,0,,♪Өліммен бітпейді
Dialogue: 0,0:23:03.08,0:23:06.78,Default,,0,0,0,,♪Арманымды аңсасам да
Dialogue: 0,0:23:06.88,0:23:10.62,Default,,0,0,0,,♪Сенімді адам сенсің
Dialogue: 0,0:23:10.72,0:23:14.59,Default,,0,0,0,,♪Менің өмірім
Dialogue: 0,0:23:14.69,0:23:18.49,Default,,0,0,0,,♪Қатты жел айдалада, Көбелектер мен гүлдермен өмір сүремін.
Dialogue: 0,0:23:18.59,0:23:22.16,Default,,0,0,0,,♪Мәңгілік көктемде гүлдеген дәмді елес
Dialogue: 0,0:23:22.46,0:23:26.00,Default,,0,0,0,,♪Бұл денені кірлетсе де, бұлыңғырлықтың тазалығы
Dialogue: 0,0:23:26.10,0:23:29.87,Default,,0,0,0,,♪Жүрегіңіздің сырына сеніңіз
Dialogue: 0,0:23:29.97,0:23:35.58,Default,,0,0,0,,♪Көз жасымды көрсетпесем де, анашым
Dialogue: 0,0:23:35.74,0:23:40.41,Default,,0,0,0,,♪Аяғымның астындағы шөпте
Dialogue: 0,0:23:40.51,0:23:45.85,Default,,0,0,0,,♪Шық ешқашан жоғалмайды
Dialogue: 0,0:23:48.99,0:23:50.52,Default,,0,0,0,,Өткен күннен естелік? ―
Dialogue: 0,0:23:50.69,0:23:53.19,Default,,0,0,0,,Осындай нәрселерге бойлай алатындар бақытты.
Dialogue: 0,0:23:53.49,0:23:55.66,Default,,0,0,0,,Себебі ертең міндетті түрде келетініне сенемін...
Dialogue: 0,0:23:56.16,0:23:59.63,Default,,0,0,0,,Бірақ бұған кім уәде берді? ―
Dialogue: 0,0:23:59.73,0:24:00.57,Default,,0,0,0,,Карен мұны жасады-
Dialogue: 0,0:24:00.67,0:24:01.90,Default,,0,0,0,,Егер сіз жеңуге тырыссаңыз...
Dialogue: 0,0:24:02.00,0:24:03.47,Default,,0,0,0,,Сенуге болады.
Dialogue: 0,0:24:03.64,0:24:04.74,Default,,0,0,0,,Иә-
Dialogue: 0,0:24:04.84,0:24:07.67,Default,,0,0,0,,Өйткені бізде қазіргі уақытта өмір сүруден басқа амал жоқ.
Dialogue: 0,0:24:09.17,0:24:15.17,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory