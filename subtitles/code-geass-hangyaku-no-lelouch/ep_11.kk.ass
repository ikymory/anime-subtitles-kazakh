Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.76,0:00:03.67,Default,,0,0,0,,Жапония азат ету майданы-
Dialogue: 0,0:00:04.13,0:00:07.60,Default,,0,0,0,,11-аймақтағы ең үлкен қарулы топты талқандау
Dialogue: 0,0:00:07.70,0:00:11.64,Default,,0,0,0,,Губернатор Корнелия Нарита тауларында қоршау операциясын бастады.
Dialogue: 0,0:00:12.47,0:00:15.44,Default,,0,0,0,,Британ армиясы бақылау күшіне ие...
Dialogue: 0,0:00:15.54,0:00:18.58,Default,,0,0,0,,Көптеген адамдар шешім қабылдағандай көрінгенде...
Dialogue: 0,0:00:18.68,0:00:20.68,Default,,0,0,0,,Қара рыцарьлар қозғала бастады.
Dialogue: 0,0:00:22.02,0:00:24.02,Default,,0,0,0,,Гюреннің сәулелену толқынын пайдалану 2-
Dialogue: 0,0:00:24.12,0:00:27.52,Default,,0,0,0,,Таудың басынан кенеттен су венасы жарылды.
Dialogue: 0,0:00:28.02,0:00:29.69,Default,,0,0,0,,Тау құлады.
Dialogue: 0,0:00:30.29,0:00:33.63,Default,,0,0,0,,Жапонияның азат ету майданы да, Британның негізгі күштері де...
Dialogue: 0,0:00:33.80,0:00:36.50,Default,,0,0,0,,Балшық пен су ағынына түсіп қалу.
Dialogue: 0,0:00:37.27,0:00:40.77,Default,,0,0,0,,Корнелия бөлімшесі негізгі күшін жоғалтып, оқшауланады.
Dialogue: 0,0:00:41.07,0:00:42.50,Default,,0,0,0,,Нөл толқынды өзгертуді мақсат етеді...
Dialogue: 0,0:00:42.60,0:00:46.24,Default,,0,0,0,,Мен Қара рыцарларды Корнелияға қарай жетелеймін...
Dialogue: 0,0:00:49.61,0:00:56.18,Default,,0,0,0,,Әркім өз жеңісіне сенгісі келеді.
Dialogue: 0,0:00:56.28,0:00:58.69,Default,,0,0,0,,Алайда уақыт пен тағдырдың алдында...
Dialogue: 0,0:00:58.79,0:01:03.39,Default,,0,0,0,,Сену әрекеті соншалықты бос және өткінші
Dialogue: 0,0:01:03.69,0:01:09.70,Default,,0,0,0,,♪～
Dialogue: 0,0:01:12.27,0:01:16.17,Default,,0,0,0,,♪Өзім, тіпті әлем
Dialogue: 0,0:01:16.27,0:01:19.54,Default,,0,0,0,,♪Мен оны өзгерте аламын деп ойлаймын.
Dialogue: 0,0:01:19.64,0:01:25.41,Default,,0,0,0,,♪Сәт әрқашан жаныңда...
Dialogue: 0,0:01:27.45,0:01:33.76,Default,,0,0,0,,♪ Тітіркенуді жасыра алмайды
Dialogue: 0,0:01:34.49,0:01:40.76,Default,,0,0,0,,♪ Бір орында тұрып өзіңе қара
Dialogue: 0,0:01:40.86,0:01:44.33,Default,,0,0,0,,♪ойланып отырып, уайымдап
Dialogue: 0,0:01:44.43,0:01:47.77,Default,,0,0,0,,♪Өкініп отырып шешім қабылдау керек.
Dialogue: 0,0:01:47.87,0:01:51.37,Default,,0,0,0,,♪Сен маған берген бір сөз
Dialogue: 0,0:01:51.47,0:01:55.21,Default,,0,0,0,,♪Менің шатасуым жоғалады
Dialogue: 0,0:01:55.31,0:02:01.52,Default,,0,0,0,,♪Бос бөлмеме жарық түсті.
Dialogue: 0,0:02:01.72,0:02:04.72,Default,,0,0,0,,♪Мен қараған аспан
Dialogue: 0,0:02:04.82,0:02:09.12,Default,,0,0,0,,♪Ашық және көгілдір болып барады
Dialogue: 0,0:02:09.22,0:02:15.50,Default,,0,0,0,,♪Мен жабық терезені ашуды жөн көрдім.
Dialogue: 0,0:02:15.60,0:02:19.60,Default,,0,0,0,,♪Өзім, тіпті әлем
Dialogue: 0,0:02:19.70,0:02:22.74,Default,,0,0,0,,♪Мен оны өзгерте аламын деп ойлаймын.
Dialogue: 0,0:02:23.30,0:02:29.61,Default,,0,0,0,,♪Сәтті сезін, осында және қазір...
Dialogue: 0,0:02:39.25,0:02:40.29,Default,,0,0,0,,Біздің әскерге қандай зиян келді?
Dialogue: 0,0:02:40.39,0:02:42.66,Default,,0,0,0,,20％
Dialogue: 0,0:02:42.76,0:02:43.79,Default,,0,0,0,,20％…
Dialogue: 0,0:02:44.26,0:02:46.29,Default,,0,0,0,,Бұл командалар тізбегін орнатпайды.
Dialogue: 0,0:02:46.73,0:02:47.83,Default,,0,0,0,,Бұл Марсо командасы.
Dialogue: 0,0:02:47.93,0:02:50.23,Default,,0,0,0,,Мен генерал Алекспен байланыса алмаймын.
Dialogue: 0,0:02:50.33,0:02:52.23,Default,,0,0,0,,２…
Dialogue: 0,0:02:52.70,0:02:53.80,Default,,0,0,0,,Ллойд мырза, бұл не?
Dialogue: 0,0:02:53.90,0:02:56.24,Default,,0,0,0,,Иә, өте табиғи емес.
Dialogue: 0,0:02:56.34,0:02:57.21,Default,,0,0,0,,Табиғи емес
Dialogue: 0,0:02:57.37,0:03:00.94,Default,,0,0,0,,Расталмаса да, Қара рыцарьлар пайда болды деген ақпарат бар.
Dialogue: 0,0:03:01.24,0:03:01.91,Default,,0,0,0,,Нөл…
Dialogue: 0,0:03:02.21,0:03:04.61,Default,,0,0,0,,Құттықтаймыз, сіздің кезегіңіз болуы мүмкін.
Dialogue: 0,0:03:04.71,0:03:06.68,Default,,0,0,0,,Ллойд мырза! (Сесил Круми) Бұл әдепсіз.
Dialogue: 0,0:03:06.78,0:03:08.38,Default,,0,0,0,,Иә?Неліктен?
Dialogue: 0,0:03:08.48,0:03:10.29,Default,,0,0,0,,Саған айтайын ба?
Dialogue: 0,0:03:10.39,0:03:12.19,Default,,0,0,0,,Жоқ, мен бұлай істеуден аулақпын.
Dialogue: 0,0:03:12.29,0:03:15.76,Default,,0,0,0,,Әйтеуір, Бас штаб ақпарат жинай салысымен...
Dialogue: 0,0:03:15.86,0:03:18.53,Default,,0,0,0,,Мұнымен де қалай күресу керектігін шешуден басқа амалымыз жоқ.
Dialogue: 0,0:03:18.86,0:03:20.43,Default,,0,0,0,,Губернатор аман ба?
Dialogue: 0,0:03:20.53,0:03:22.63,Default,,0,0,0,,Бұл ағынның сыртында, сондықтан ешқандай проблема жоқ.
Dialogue: 0,0:03:22.73,0:03:26.27,Default,,0,0,0,,Алайда дайындық жұмыстары жүргізілгендіктен, ол дерлік оқшауланып қалды...
Dialogue: 0,0:03:26.37,0:03:28.34,Default,,0,0,0,,Сіз не істеп жатырсыз?Таза қандылар!
Dialogue: 0,0:03:30.47,0:03:31.64,Default,,0,0,0,,Уф! ―
Dialogue: 0,0:03:32.94,0:03:34.74,Default,,0,0,0,,Иә
Dialogue: 0,0:03:34.84,0:03:36.44,Default,,0,0,0,,Эй!Жылжыту!
Dialogue: 0,0:03:36.78,0:03:40.32,Default,,0,0,0,,Мақтаныш Британия Eleven командасынан жеңілді!
Dialogue: 0,0:03:41.82,0:03:42.68,Default,,0,0,0,,Лорд Кьюэлл!
Dialogue: 0,0:03:42.95,0:03:44.95,Default,,0,0,0,,Жарайды!Гүрен жоспарланған орнына барады
Dialogue: 0,0:03:45.25,0:03:47.66,Default,,0,0,0,,Қалғандары осы жерден өтіп, Корнелияны көздейді.
Dialogue: 0,0:03:47.76,0:03:48.76,Default,,0,0,0,,Иә
Dialogue: 0,0:03:47.76,0:03:48.76,Default,,0,0,0,,) Түсіндім.
Dialogue: 0,0:03:48.86,0:03:50.23,Default,,0,0,0,,Біз бара аламыз.
Dialogue: 0,0:03:50.53,0:03:52.36,Default,,0,0,0,,Мен бұл жерді өлгенше қорғаймын!
Dialogue: 0,0:03:52.79,0:03:53.90,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:55.26,0:03:57.37,Default,,0,0,0,,Сугияма!Сен тірісің бе?
Dialogue: 0,0:03:57.47,0:03:58.30,Default,,0,0,0,,О
Dialogue: 0,0:03:58.40,0:03:59.27,Default,,0,0,0,,(мүшелердің ыңырануы)
Dialogue: 0,0:03:59.73,0:04:00.60,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:00.80,0:04:02.30,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:02.40,0:04:03.74,Default,,0,0,0,,Қиямет!Жаса!
Dialogue: 0,0:04:04.34,0:04:05.84,Default,,0,0,0,,Иә, жылжытыңыз.
Dialogue: 0,0:04:05.94,0:04:09.64,Default,,0,0,0,,Егер сіз бұл шайқастан аман өтсеңіз, сіз жауынгер бола аласыз.
Dialogue: 0,0:04:09.74,0:04:11.38,Default,,0,0,0,,Бұдан басқа...
Dialogue: 0,0:04:11.48,0:04:13.31,Default,,0,0,0,,Таза қандылар оны ұстап тұр ма?
Dialogue: 0,0:04:13.41,0:04:14.92,Default,,0,0,0,,Иә, лорд Виллеттаның басшылығымен.
Dialogue: 0,0:04:15.42,0:04:16.52,Default,,0,0,0,,Олай болса, қазір уақыт.
Dialogue: 0,0:04:16.62,0:04:19.02,Default,,0,0,0,,Губернаторға бар болғаны артта қалу болды! әуе күштерін қолдау
Dialogue: 0,0:04:19.32,0:04:22.86,Default,,0,0,0,,Күте тұрыңыз!Губернатордың артынан бірдеңе келе жатыр.
Dialogue: 0,0:04:23.32,0:04:25.66,Default,,0,0,0,,Әрбір машина дайын ба? (Төрт қасиетті қылыш) Иә!
Dialogue: 0,0:04:25.83,0:04:27.93,Default,,0,0,0,,Жарайды, Бурай Кай, кел
Dialogue: 0,0:04:28.03,0:04:29.26,Default,,0,0,0,,Мен кетіп бара жатырмын!
Dialogue: 0,0:04:30.37,0:04:33.37,Default,,0,0,0,,Тыңдаңыздар, егер бұл көшкін жасанды болса...
Dialogue: 0,0:04:33.47,0:04:35.67,Default,,0,0,0,,Біз Корнелияға еруіміз керек.
Dialogue: 0,0:04:36.34,0:04:37.77,Default,,0,0,0,,Корнелияны түсіру
Dialogue: 0,0:04:37.87,0:04:39.94,Default,,0,0,0,,Енді 7 жыл бұрынғы қарызды қайтаратын кез!
Dialogue: 0,0:04:40.04,0:04:43.38,Default,,0,0,0,,Иә! Біз оны Төрт Қасиетті Қылышының мақтанышына бөлеміз!
Dialogue: 0,0:04:43.54,0:04:44.58,Default,,0,0,0,,(Каори) Жоқ, бірақ... (Косей) Ақыл-жастарың ұқсас болғандықтан ба?
Dialogue: 0,0:04:45.31,0:04:46.91,Default,,0,0,0,,Мәртебесін қорға!
Dialogue: 0,0:04:51.02,0:04:52.35,Default,,0,0,0,,Оны қоршаңыз!
Dialogue: 0,0:04:52.55,0:04:54.02,Default,,0,0,0,,Жапон азаттық майданы?
Dialogue: 0,0:04:55.36,0:04:57.39,Default,,0,0,0,,Қоршауды кесу (Төрт қасиетті қылыш) Түсіндім!
Dialogue: 0,0:04:59.59,0:05:01.40,Default,,0,0,0,,Мені жай ғана бәйбіше деп ойламаңыз.
Dialogue: 0,0:05:01.70,0:05:03.56,Default,,0,0,0,,Жеті жыл бұрын есімде.
Dialogue: 0,0:05:03.83,0:05:05.40,Default,,0,0,0,,Ол кездегіден басқаша
Dialogue: 0,0:05:05.50,0:05:07.50,Default,,0,0,0,,Мұнда да қорқынышты түс бар.
Dialogue: 0,0:05:07.80,0:05:09.70,Default,,0,0,0,,Мәртебелі! мұны бізге қалдырыңыз
Dialogue: 0,0:05:09.80,0:05:10.97,Default,,0,0,0,,Қазір бас тартыңыз!
Dialogue: 0,0:05:12.94,0:05:15.54,Default,,0,0,0,,Егер бұл жақсы болса, мен мұны басқа жолмен істеймін.
Dialogue: 0,0:05:15.64,0:05:16.74,Default,,0,0,0,,Гилдфорд
Dialogue: 0,0:05:16.94,0:05:19.61,Default,,0,0,0,,Қиындықтан өткеннен кейін 9-тармаққа келіңіз.
Dialogue: 0,0:05:20.32,0:05:21.42,Default,,0,0,0,,９？
Dialogue: 0,0:05:21.52,0:05:22.38,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:05:22.48,0:05:23.89,Default,,0,0,0,,Корнелия!
Dialogue: 0,0:05:24.99,0:05:26.52,Default,,0,0,0,,Әлсіздер!
Dialogue: 0,0:05:26.92,0:05:28.02,Default,,0,0,0,,Хун
Dialogue: 0,0:05:29.82,0:05:31.99,Default,,0,0,0,,Жақсы! Тек нөлді ұстаныңыз!
Dialogue: 0,0:05:32.53,0:05:34.70,Default,,0,0,0,,Эй, Карен қайтып келсе жақсы болар еді...
Dialogue: 0,0:05:34.80,0:05:36.43,Default,,0,0,0,,Жоқ! Егер мен орналасуды қазір өзгертсем...
Dialogue: 0,0:05:36.53,0:05:37.93,Default,,0,0,0,,Стратегия бұзылады
Dialogue: 0,0:05:38.57,0:05:40.03,Default,,0,0,0,,Дегенмен, бұл жақсы емес.
Dialogue: 0,0:05:40.33,0:05:42.94,Default,,0,0,0,,Осы қарқынмен біз тіпті SS-пен күресуге тура келеді.
Dialogue: 0,0:05:43.04,0:05:45.74,Default,,0,0,0,,Нөл: Корнелияға төменнен шабуыл жасалды.
Dialogue: 0,0:05:45.84,0:05:47.71,Default,,0,0,0,,Не? Қай команда көшті?
Dialogue: 0,0:05:47.81,0:05:49.88,Default,,0,0,0,,Бұл біз емес, азаттық майданы сияқты.
Dialogue: 0,0:05:50.04,0:05:52.78,Default,,0,0,0,,Менің көздегенімді біреу оқыды ма?
Dialogue: 0,0:05:52.88,0:05:54.12,Default,,0,0,0,,Бұл өте жақсы.
Dialogue: 0,0:05:54.42,0:05:56.85,Default,,0,0,0,,Олай болса, олар СС-ті тоқтата алуы керек.
Dialogue: 0,0:05:57.45,0:05:59.39,Default,,0,0,0,,Жоғары мәртебелі генерал-майор, сіз кешігіп қалдыңыз.
Dialogue: 0,0:05:59.72,0:06:01.39,Default,,0,0,0,,Todo Мен сені күттім!
Dialogue: 0,0:06:01.56,0:06:04.76,Default,,0,0,0,,Жоғары мәртебелі, барлық күштеріңізді осында орналастырыңыз.
Dialogue: 0,0:06:04.86,0:06:06.49,Default,,0,0,0,,Сіз жеңе аласыз ба? Оларға
Dialogue: 0,0:06:06.59,0:06:08.73,Default,,0,0,0,,Егер біз Британияның негізгі күшін тоқтата алсақ, біз жеңе аламыз.
Dialogue: 0,0:06:09.06,0:06:11.80,Default,,0,0,0,,Қазір соғыс толқынын өзгерту үшін тамаша мүмкіндік!
Dialogue: 0,0:06:12.90,0:06:14.00,Default,,0,0,0,,11-аудан да-
Dialogue: 0,0:06:14.10,0:06:16.70,Default,,0,0,0,,Мен генерал мен рыцарьдік қабілеті бар адамдар бар деп естідім.
Dialogue: 0,0:06:17.51,0:06:19.94,Default,,0,0,0,,Бұл Todo болуы мүмкін бе?
Dialogue: 0,0:06:20.04,0:06:21.81,Default,,0,0,0,,Бірақ менімен бірге!
Dialogue: 0,0:06:23.95,0:06:25.75,Default,,0,0,0,,Міне, осындай уақытта!
Dialogue: 0,0:06:25.85,0:06:26.78,Default,,0,0,0,,Сіз не істегіңіз келеді?
Dialogue: 0,0:06:26.88,0:06:28.02,Default,,0,0,0,,Аудару! ―
Dialogue: 0,0:06:28.38,0:06:30.75,Default,,0,0,0,,Қандай жағдай болмасын, мен губернатор Корнелиямен кездесемін.
Dialogue: 0,0:06:30.85,0:06:33.15,Default,,0,0,0,,Бірақ жаудың базасы дәл алдымызда! ―
Dialogue: 0,0:06:33.45,0:06:35.76,Default,,0,0,0,,Ал егер артыңыздан шабуыл жасалса, ауыр зиян шегесіз...
Dialogue: 0,0:06:35.86,0:06:38.46,Default,,0,0,0,,Ақымақ! Егер сіз ханшайымыңызды жоғалтсаңыз
Dialogue: 0,0:06:38.56,0:06:40.50,Default,,0,0,0,,Бұл шайқастың өзі аяқталады!
Dialogue: 0,0:06:40.60,0:06:41.76,Default,,0,0,0,,Иә! ―
Dialogue: 0,0:06:41.86,0:06:43.13,Default,,0,0,0,,Уау!Апыр-ай!
Dialogue: 0,0:06:43.53,0:06:46.83,Default,,0,0,0,,Лейтенант Губернатор Эфемия G-1-ді тездетейік.
Dialogue: 0,0:06:46.93,0:06:48.50,Default,,0,0,0,,Губернатор! (эвфемия)
Dialogue: 0,0:06:48.60,0:06:51.54,Default,,0,0,0,,Бірақ... Капитан Гилфорд қозғала алмайды.
Dialogue: 0,0:06:51.64,0:06:52.97,Default,,0,0,0,,Губернатор Корнелияның бұйрықтары
Dialogue: 0,0:06:53.14,0:06:54.54,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:06:54.64,0:06:57.61,Default,,0,0,0,,Далалық аурухана да осында орналасқан.
Dialogue: 0,0:06:57.71,0:06:59.95,Default,,0,0,0,,Маңайдағы кейбір тұрғындар эвакуацияланды.
Dialogue: 0,0:07:00.15,0:07:03.79,Default,,0,0,0,,Сондай-ақ, бұл G-1 базасы штабтың символы болып табылады.
Dialogue: 0,0:07:03.89,0:07:06.65,Default,,0,0,0,,Губернатордың қандай болса да қозғалмау туралы қатаң бұйрығы.
Dialogue: 0,0:07:06.75,0:07:08.42,Default,,0,0,0,,Сондықтан... Сондықтан...
Dialogue: 0,0:07:08.99,0:07:10.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:10.12,0:07:14.43,Default,,0,0,0,,Сәлеметсіз бе, бұл арнайы диспетчерлік нұсқаулық технологиясы бөлімі.
Dialogue: 0,0:07:14.53,0:07:16.66,Default,,0,0,0,,Дөрекі! (Штаб офицері) Жаңа ғана әскери қызметте.
Dialogue: 0,0:07:16.76,0:07:18.43,Default,,0,0,0,,Тәртіпсіз адамдар тыныш болуы керек!
Dialogue: 0,0:07:18.67,0:07:21.00,Default,,0,0,0,,…  …
Dialogue: 0,0:07:21.10,0:07:23.77,Default,,0,0,0,,Саған рахмет, мен қиыншылыққа ұшырадым. Менің ішім пысты.
Dialogue: 0,0:07:23.94,0:07:25.07,Default,,0,0,0,,Ах
Dialogue: 0,0:07:26.17,0:07:27.71,Default,,0,0,0,,Лейтенант губернатор Эфемия
Dialogue: 0,0:07:28.04,0:07:30.75,Default,,0,0,0,,Өтінемін! диспетчерге бұйрық береді
Dialogue: 0,0:07:30.98,0:07:34.92,Default,,0,0,0,,Шираджи губернаторды құтқарғаны үшін алғыс алғысы келетін сияқты.
Dialogue: 0,0:07:35.02,0:07:37.99,Default,,0,0,0,,Егер бір ғана машина жағдайды өзгерте алса, ешкім зардап шекпейді.
Dialogue: 0,0:07:38.09,0:07:39.79,Default,,0,0,0,,Және сандар және т.б.
Dialogue: 0,0:07:39.89,0:07:41.19,Default,,0,0,0,,Жоқ, жоқ, сондықтан-
Dialogue: 0,0:07:41.49,0:07:43.46,Default,,0,0,0,,Неліктен қолданып көрмеске?
Dialogue: 0,0:07:43.56,0:07:44.23,Default,,0,0,0,,Сәтсіздікке ұшырасаңыз да...
Dialogue: 0,0:07:44.53,0:07:46.13,Default,,0,0,0,,Бұл сіздің шығыныңыз емес, солай ма?
Dialogue: 0,0:07:46.23,0:07:47.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:47.20,0:07:48.23,Default,,0,0,0,,Эй, тыңдап тұрсың ба?
Dialogue: 0,0:07:48.53,0:07:49.60,Default,,0,0,0,,Юффи…
Dialogue: 0,0:07:50.13,0:07:51.93,Default,,0,0,0,,Түсінікті, өтінемін.
Dialogue: 0,0:07:52.03,0:07:52.90,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:53.00,0:07:54.47,Default,,0,0,0,,Рахмет
Dialogue: 0,0:07:54.57,0:07:56.00,Default,,0,0,0,,Иә, әрине
Dialogue: 0,0:07:58.01,0:07:59.71,Default,,0,0,0,,Мұны жасамаңыз
Dialogue: 0,0:08:01.61,0:08:02.48,Default,,0,0,0,,Шашылыңдар!
Dialogue: 0,0:08:04.25,0:08:06.55,Default,,0,0,0,,Қолбасшы Корнелия не істейді?
Dialogue: 0,0:08:06.65,0:08:09.55,Default,,0,0,0,,Егер нөл күткендей болса, ол әрекет жасауы керек еді.
Dialogue: 0,0:08:09.65,0:08:11.62,Default,,0,0,0,,Осы кезде оған сенуден басқа амалың жоқ!
Dialogue: 0,0:08:12.55,0:08:14.26,Default,,0,0,0,,Не?Zero аударылды ма?
Dialogue: 0,0:08:14.56,0:08:17.73,Default,,0,0,0,,Иә, біз сізге қолдау көрсетуді жалғастырамыз.
Dialogue: 0,0:08:17.89,0:08:20.19,Default,,0,0,0,,Бұл нөлге ұқсайды!Орналасқан жеріңіз туралы ақпаратты жіберіңіз!
Dialogue: 0,0:08:21.10,0:08:23.97,Default,,0,0,0,,Иә, бұл нөлдердің болжамды бағыты.
Dialogue: 0,0:08:24.13,0:08:25.00,Default,,0,0,0,,Бұл жаман.
Dialogue: 0,0:08:25.70,0:08:28.94,Default,,0,0,0,,Қара рыцарлар Тодо мен оның достарын азғыруға тиіс жерде...
Dialogue: 0,0:08:29.80,0:08:32.04,Default,,0,0,0,,Мәртебелі Корнелия!
Dialogue: 0,0:08:32.14,0:08:34.98,Default,,0,0,0,,Мен сізді тыңдаймын, Гилфорд.
Dialogue: 0,0:08:38.95,0:08:41.25,Default,,0,0,0,,Z-01 бағыттаушы қару (G Zero One) Ланселот -
Dialogue: 0,0:08:41.55,0:08:42.78,Default,,0,0,0,,Құмды тақтаны пайдалану -
Dialogue: 0,0:08:42.88,0:08:46.82,Default,,0,0,0,,Сұйықтық еңіспен максималды жылдамдықпен көтеріліп, Губернаторды құтқарыңыз.
Dialogue: 0,0:08:46.92,0:08:48.09,Default,,0,0,0,,Иеміз Иса
Dialogue: 0,0:08:49.99,0:08:52.89,Default,,0,0,0,,Сузаку-кун, мен сенен бір нәрсе сұрайын деп едім.
Dialogue: 0,0:08:52.99,0:08:54.00,Default,,0,0,0,,Не?
Dialogue: 0,0:08:54.10,0:08:56.86,Default,,0,0,0,,Сіз адамдардың өлгенін қатты жек көресіз, солай емес пе?
Dialogue: 0,0:08:56.96,0:08:59.93,Default,,0,0,0,,Бірақ сіз әскери қызметтесіз. Неліктен?
Dialogue: 0,0:09:00.03,0:09:02.24,Default,,0,0,0,,Мен әскердемін, себебі сенің өлгеніңді қаламаймын.
Dialogue: 0,0:09:02.67,0:09:05.64,Default,,0,0,0,,Бұл қайшылық сені бір күні өлтіреді.
Dialogue: 0,0:09:05.74,0:09:07.71,Default,,0,0,0,,Аа, кешіріңіз, кешіріңіз...
Dialogue: 0,0:09:09.54,0:09:11.31,Default,,0,0,0,,Ланселот ұшады
Dialogue: 0,0:09:15.78,0:09:16.72,Default,,0,0,0,,Корнелия!
Dialogue: 0,0:09:17.18,0:09:18.65,Default,,0,0,0,,Болжаудың алдында!
Dialogue: 0,0:09:20.62,0:09:21.79,Default,,0,0,0,,Уф!
Dialogue: 0,0:09:22.62,0:09:23.69,Default,,0,0,0,,Не?
Dialogue: 0,0:09:23.79,0:09:25.26,Default,,0,0,0,,Бұл жай ғана арнайы құрылғы сияқты емес, бірақ...
Dialogue: 0,0:09:25.26,0:09:26.56,Default,,0,0,0,,Бұл жай ғана арнайы құрылғы сияқты емес, бірақ...
Dialogue: 0,0:09:25.26,0:09:26.56,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:09:29.30,0:09:33.80,Default,,0,0,0,,Сіз мені тыңдап тұрсыз ба? Корнелия, бұл мат.
Dialogue: 0,0:09:33.90,0:09:35.60,Default,,0,0,0,,Нөл? (Лелух) А...
Dialogue: 0,0:09:35.70,0:09:37.27,Default,,0,0,0,,Біз кездесуімізді тойлауымыз керек пе?
Dialogue: 0,0:09:37.77,0:09:41.61,Default,,0,0,0,,Бірақ бұған дейін бізге бағынуыңызды қалаймыз.
Dialogue: 0,0:09:41.71,0:09:43.74,Default,,0,0,0,,Мен сізден бір нәрсе сұрайын деп едім...
Dialogue: 0,0:09:45.11,0:09:47.35,Default,,0,0,0,,Айтпақшы, күшейту уақытында келмейді.
Dialogue: 0,0:09:47.65,0:09:50.59,Default,,0,0,0,,Бұл менің жеңісім, Корнелия.
Dialogue: 0,0:09:52.05,0:09:53.62,Default,,0,0,0,,Ақымақ нөл
Dialogue: 0,0:09:54.02,0:09:58.06,Default,,0,0,0,,Мен бұл жігітті жеңе алсам, шығудың жолы ашық болады!
Dialogue: 0,0:10:01.73,0:10:03.06,Default,,0,0,0,,Қандай епті жігіт!
Dialogue: 0,0:10:04.33,0:10:05.37,Default,,0,0,0,,Уф!
Dialogue: 0,0:10:06.67,0:10:07.67,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:10.10,0:10:11.37,Default,,0,0,0,,Уф!
Dialogue: 0,0:10:14.38,0:10:16.68,Default,,0,0,0,,Қорқақ!Артынан ату!
Dialogue: 0,0:10:16.88,0:10:20.88,Default,,0,0,0,,Сонымен, сіздің стратегияңыз қорқақ емес пе?
Dialogue: 0,0:10:23.85,0:10:26.92,Default,,0,0,0,,Жүйені орнатқанға дейін қысқыш шабуыл дегеніміз не?
Dialogue: 0,0:10:27.39,0:10:29.86,Default,,0,0,0,,Осымен мен ханшайымға жете алмаймын...
Dialogue: 0,0:10:31.13,0:10:32.03,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:35.80,0:10:38.00,Default,,0,0,0,,Подполковник I жаудың қосымша күштеріне шабуыл жасады.
Dialogue: 0,0:10:38.10,0:10:41.14,Default,,0,0,0,,Жарайды! Айналмалы шабуылға ауысыңыз!
Dialogue: 0,0:10:41.64,0:10:42.94,Default,,0,0,0,,Құдай-ай, бұл жігіт шынымен де соған батып кетті ғой, иә?
Dialogue: 0,0:10:43.87,0:10:45.27,Default,,0,0,0,,Иә, осы қарқынмен...
Dialogue: 0,0:10:45.37,0:10:46.31,Default,,0,0,0,,Мәртебелі Корнелия
Dialogue: 0,0:10:46.41,0:10:47.27,Default,,0,0,0,,Гилдфорд
Dialogue: 0,0:10:47.38,0:10:48.41,Default,,0,0,0,,Уф!
Dialogue: 0,0:10:48.71,0:10:50.75,Default,,0,0,0,,Менің рыцарь Гилфорд.
Dialogue: 0,0:10:50.98,0:10:53.35,Default,,0,0,0,,Мен Юффиге Далтонмен көмектесуіңізді қалаймын.
Dialogue: 0,0:10:53.65,0:10:54.88,Default,,0,0,0,,Мәртебелі!
Dialogue: 0,0:10:55.22,0:10:56.92,Default,,0,0,0,,Мен берілмеймін
Dialogue: 0,0:11:00.29,0:11:02.72,Default,,0,0,0,,Ханшайым ретінде мен тек соңына дейін күресемін!
Dialogue: 0,0:11:02.82,0:11:05.76,Default,,0,0,0,,Ко... Құрметті Корнелия!
Dialogue: 0,0:11:05.86,0:11:08.33,Default,,0,0,0,,Ғұнның қызықсыз таңдауы
Dialogue: 0,0:11:10.16,0:11:11.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:12.27,0:11:13.70,Default,,0,0,0,,Иә
Dialogue: 0,0:11:17.20,0:11:18.14,Default,,0,0,0,,Уау...
Dialogue: 0,0:11:18.24,0:11:19.97,Default,,0,0,0,,Сіз бұрынғыдай абайсыздасыз.
Dialogue: 0,0:11:20.44,0:11:23.14,Default,,0,0,0,,Валис арамыздағы кедергілерден қалай өте алады?
Dialogue: 0,0:11:27.01,0:11:28.88,Default,,0,0,0,,Губернатор, амансың ба?
Dialogue: 0,0:11:28.98,0:11:30.05,Default,,0,0,0,,Мен көмекке келдім.
Dialogue: 0,0:11:30.79,0:11:32.45,Default,,0,0,0,,Бұл арнайы есеп пе?Кімнің рұқсатымен?
Dialogue: 0,0:11:32.99,0:11:35.96,Default,,0,0,0,,Бірақ егер бұл Ланселот құтқарылса...
Dialogue: 0,0:11:36.26,0:11:38.26,Default,,0,0,0,,Ей, болмайды, бұл түнгі түн
Dialogue: 0,0:11:38.36,0:11:41.10,Default,,0,0,0,,Ах, Шиндзюку немесе Кавагучи көліндегі.
Dialogue: 0,0:11:41.26,0:11:43.93,Default,,0,0,0,,Бұл қайтадан ол… Бұл қайтадан ол!
Dialogue: 0,0:11:47.30,0:11:51.04,Default,,0,0,0,,Гурен Нишикидің Ақ дулығасын жойыңыз!Бұл жігіттің серпіліс күші - бір мазасыздық!
Dialogue: 0,0:11:51.31,0:11:52.34,Default,,0,0,0,,Иә
Dialogue: 0,0:11:56.31,0:11:57.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:59.95,0:12:03.02,Default,,0,0,0,,Мен мұны сізге қалдырамын! Мен нөлге жеттім!
Dialogue: 0,0:12:05.02,0:12:06.45,Default,,0,0,0,,Синдзюкудың қарызы осында!
Dialogue: 0,0:12:09.86,0:12:12.03,Default,,0,0,0,,Жоқ... ол Ланселот сияқты жылдам ма?
Dialogue: 0,0:12:14.46,0:12:15.93,Default,,0,0,0,,Осы жігітті жеңе алсам ғой!
Dialogue: 0,0:12:25.11,0:12:26.41,Default,,0,0,0,,Мұндай қару!
Dialogue: 0,0:12:26.51,0:12:27.48,Default,,0,0,0,,Бұл… түс.
Dialogue: 0,0:12:36.45,0:12:37.32,Default,,0,0,0,,Тоқтады!
Dialogue: 0,0:12:40.32,0:12:41.82,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:48.23,0:12:49.93,Default,,0,0,0,,Егер ойыңды өзгертсең, маған хабарла
Dialogue: 0,0:12:50.03,0:12:51.20,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:12:51.30,0:12:52.87,Default,,0,0,0,,Оуги Гурен ше?
Dialogue: 0,0:12:53.80,0:12:55.54,Default,,0,0,0,,Менің оң қолым жарамсыз. Мен оны түзетуім керек!
Dialogue: 0,0:12:55.84,0:12:58.87,Default,,0,0,0,,Уф... мен тартамын!
Dialogue: 0,0:12:58.97,0:12:59.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:59.54,0:13:01.78,Default,,0,0,0,,Барлық әскерлерді қашу нүктесіне жылжытыңыз! ―
Dialogue: 0,0:13:01.88,0:13:04.78,Default,,0,0,0,,Бұдан артық кез келген тозған соғыс болады.Шегіну!
Dialogue: 0,0:13:08.25,0:13:09.12,Default,,0,0,0,,Губернатор
Dialogue: 0,0:13:09.22,0:13:10.28,Default,,0,0,0,,Нөлді қуу керек
Dialogue: 0,0:13:10.38,0:13:11.25,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:13:11.35,0:13:13.52,Default,,0,0,0,,Сізде қуат толтырғыш таусылды. Бар!
Dialogue: 0,0:13:13.82,0:13:14.82,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:13:17.93,0:13:20.43,Default,,0,0,0,,Эй, сіз шынымен артқа тартқыңыз келе ме?
Dialogue: 0,0:13:20.53,0:13:22.80,Default,,0,0,0,,Жеңгеніміз рас, енді болмайды...
Dialogue: 0,0:13:23.23,0:13:26.43,Default,,0,0,0,,Демек, Жапонияны азат ету майданын жем ретінде пайдаланып, қашудан басқа амалымыз жоқ па?
Dialogue: 0,0:13:27.07,0:13:29.17,Default,,0,0,0,,Мен мұны айтқанды жек көремін.
Dialogue: 0,0:13:29.40,0:13:30.54,Default,,0,0,0,,О
Dialogue: 0,0:13:30.97,0:13:33.17,Default,,0,0,0,,Адам ойында пешка емес.
Dialogue: 0,0:13:34.04,0:13:36.94,Default,,0,0,0,,Мен тіпті Нөлдің де бұлай ойламайтынына сенімдімін.
Dialogue: 0,0:13:37.11,0:13:39.01,Default,,0,0,0,,Әйтпесе, тіпті біз...
Dialogue: 0,0:13:39.11,0:13:41.32,Default,,0,0,0,,Соңында сіз пешке ретінде қолданыласыз.
Dialogue: 0,0:13:42.48,0:13:44.05,Default,,0,0,0,,Бірақ бұл мүмкін емес.
Dialogue: 0,0:13:44.15,0:13:46.59,Default,,0,0,0,,Оның Британияға деген ашуы шынайы.
Dialogue: 0,0:13:48.06,0:13:52.09,Default,,0,0,0,,Ашуды білетін адамдар қайғыны да білуі керек.
Dialogue: 0,0:13:55.90,0:13:56.86,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:57.87,0:14:02.17,Default,,0,0,0,,Арнайы басты тіркемеге Zero табылды және енді бекітіледі.
Dialogue: 0,0:14:10.58,0:14:13.11,Default,,0,0,0,,Нөл Мен сізге қарыздармын.
Dialogue: 0,0:14:13.21,0:14:15.95,Default,,0,0,0,,Сіздің әрекеттеріңіздің арқасында біреу құтқарылды.
Dialogue: 0,0:14:16.05,0:14:19.85,Default,,0,0,0,,Мен көптеген Elevens тобының сахна артында жұмыс істейтінін білемін.
Dialogue: 0,0:14:19.95,0:14:22.46,Default,,0,0,0,,Бірақ... сіздің әдісіңіз...
Dialogue: 0,0:14:23.22,0:14:24.19,Default,,0,0,0,,Қате
Dialogue: 0,0:14:25.16,0:14:26.86,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:26.96,0:14:27.60,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:27.90,0:14:30.93,Default,,0,0,0,,А, а... бұл не? ―
Dialogue: 0,0:14:31.57,0:14:33.50,Default,,0,0,0,,Жоқ... Синдзюкудікі ме? ―
Dialogue: 0,0:14:33.60,0:14:34.47,Default,,0,0,0,,Капсула?
Dialogue: 0,0:14:35.10,0:14:37.61,Default,,0,0,0,,) Тоқта! Бұл адамға тиіспе!
Dialogue: 0,0:14:37.91,0:14:38.94,Default,,0,0,0,,Ｃ.Ｃ.
Dialogue: 0,0:14:39.11,0:14:41.14,Default,,0,0,0,,Ол... Нөлдің досы ма?
Dialogue: 0,0:14:43.98,0:14:45.45,Default,,0,0,0,,Сәлем! Сіз не істемексіз? ―
Dialogue: 0,0:14:45.55,0:14:46.88,Default,,0,0,0,,Қарсылас - Nightmare!
Dialogue: 0,0:14:47.92,0:14:50.08,Default,,0,0,0,,Мен сенің өлгеніңді қаламас едім.
Dialogue: 0,0:14:50.18,0:14:53.49,Default,,0,0,0,,Бұл жанама байланыс, бірақ байқап көруге тұрарлық.
Dialogue: 0,0:14:54.49,0:14:55.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:57.26,0:14:58.96,Default,,0,0,0,,Ах... Ах? ―
Dialogue: 0,0:15:01.23,0:15:02.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:11.14,0:15:15.48,Default,,0,0,0,,…  …
Dialogue: 0,0:15:21.92,0:15:24.49,Default,,0,0,0,,Жоқ!Бұл менің ниетім емес...
Dialogue: 0,0:15:24.59,0:15:27.15,Default,,0,0,0,,… …
Dialogue: 0,0:15:29.19,0:15:31.56,Default,,0,0,0,,Эй!Мен ұшқыш Геассты пайдаланады деп ешқашан күткен емеспін!
Dialogue: 0,0:15:31.66,0:15:34.16,Default,,0,0,0,,Мен сізге таң қалдыратын суретті көрсетіп отырмын.
Dialogue: 0,0:15:34.26,0:15:36.96,Default,,0,0,0,,Мен сенің не қарап тұрғаныңды білмеймін...
Dialogue: 0,0:15:37.06,0:15:39.03,Default,,0,0,0,,Қазір қашып кеткен жөн.
Dialogue: 0,0:15:39.13,0:15:40.17,Default,,0,0,0,,Сіз не істейсіз?
Dialogue: 0,0:15:40.27,0:15:42.47,Default,,0,0,0,,Мен қазір қозғала алмаймын, жүре бер.
Dialogue: 0,0:15:42.57,0:15:45.54,Default,,0,0,0,,Бұл қалжың емес, мен саған әлі де қарызмын...
Dialogue: 0,0:15:45.97,0:15:46.64,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:47.07,0:15:49.14,Default,,0,0,0,,Ха, қазір тоқтат!
Dialogue: 0,0:15:49.24,0:15:50.11,Default,,0,0,0,,Уф!
Dialogue: 0,0:15:50.58,0:15:52.28,Default,,0,0,0,,FB… FB!
Dialogue: 0,0:15:56.22,0:15:58.72,Default,,0,0,0,,(Адамдардың айқайы)
Dialogue: 0,0:16:00.02,0:16:02.56,Default,,0,0,0,,Не? Бұрынғыдан басқаша...
Dialogue: 0,0:16:10.06,0:16:11.53,Default,,0,0,0,,Эй, Изуна.
Dialogue: 0,0:16:12.00,0:16:13.60,Default,,0,0,0,,Ой... тоқтат...
Dialogue: 0,0:16:14.20,0:16:16.37,Default,,0,0,0,,Келме... маған!
Dialogue: 0,0:16:16.57,0:16:17.64,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:16:18.27,0:16:19.57,Default,,0,0,0,,Суда шын мәнінде өз мүмкіндігін көрсететін техникалар бар!
Dialogue: 0,0:16:19.67,0:16:21.18,Default,,0,0,0,,Неге...
Dialogue: 0,0:16:21.28,0:16:22.41,Default,,0,0,0,,Ой...
Dialogue: 0,0:16:24.45,0:16:26.05,Default,,0,0,0,,Ел көлеміндегі ең ізденетін Зұлымдар Альянсы
Dialogue: 0,0:16:26.45,0:16:28.32,Default,,0,0,0,,Ашылған…
Dialogue: 0,0:16:29.75,0:16:32.15,Default,,0,0,0,,Менің мұны істеуден басқа амалым болмады!
Dialogue: 0,0:16:32.25,0:16:33.19,Default,,0,0,0,,Уф
Dialogue: 0,0:16:34.72,0:16:39.73,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:16:46.13,0:16:47.37,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:47.47,0:16:48.34,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:49.50,0:16:50.60,Default,,0,0,0,,Уф.
Dialogue: 0,0:16:52.54,0:16:54.41,Default,,0,0,0,,Не? Қазір не болып жатыр?
Dialogue: 0,0:16:54.51,0:16:56.51,Default,,0,0,0,,Идиот!Қазір қашып кет!
Dialogue: 0,0:16:56.68,0:16:57.75,Default,,0,0,0,,Спидвагон керемет шығып кетті.
Dialogue: 0,0:16:58.05,0:16:58.71,Default,,0,0,0,,Ｃ.Ｃ.！
Dialogue: 0,0:17:00.38,0:17:02.58,Default,,0,0,0,,Тез... қаш! ―
Dialogue: 0,0:17:03.12,0:17:04.18,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:05.42,0:17:06.62,Default,,0,0,0,,Сәлем! (Тодо) Мені қума! ―
Dialogue: 0,0:17:07.42,0:17:09.36,Default,,0,0,0,,Нөлдің қозғалысы түсініксіз.
Dialogue: 0,0:17:09.46,0:17:13.13,Default,,0,0,0,,Біз генерал-майорға қосылып, оның қашып кетуіне көмектесеміз.
Dialogue: 0,0:17:14.23,0:17:16.16,Default,,0,0,0,,Мәртебелі!Мен қазір келемін!
Dialogue: 0,0:17:16.26,0:17:19.70,Default,,0,0,0,,Гилфорд: Барлық әскерлерге шегінуге дайындалып жатқанымызды айтыңыз.
Dialogue: 0,0:17:19.80,0:17:20.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:21.20,0:17:24.51,Default,,0,0,0,,Енді біздің жауынгерлердің өмірін қатерге тігуге негіз жоқ.
Dialogue: 0,0:17:24.60,0:17:28.18,Default,,0,0,0,,Жауынгерлік күйді сақтай отырып, баяу шегініңіз
Dialogue: 0,0:17:29.38,0:17:33.21,Default,,0,0,0,,Мойындауымыз керек, бұл жолы жеңіліп қалдық.
Dialogue: 0,0:17:33.31,0:17:37.05,Default,,0,0,0,,(Топ мүшелерінің қошеметтері)
Dialogue: 0,0:17:37.38,0:17:39.25,Default,,0,0,0,,Қараңызшы, Британия
Dialogue: 0,0:17:39.35,0:17:41.82,Default,,0,0,0,,Азаттық майданымен жұмыс істеу өте көп.
Dialogue: 0,0:17:42.26,0:17:43.36,Default,,0,0,0,,О
Dialogue: 0,0:17:43.46,0:17:46.13,Default,,0,0,0,,Қашып кететін бос жер болғаны рас, бірақ
Dialogue: 0,0:17:46.23,0:17:47.76,Default,,0,0,0,,Эй, Нөл туралы ше?
Dialogue: 0,0:17:48.20,0:17:49.66,Default,,0,0,0,,Бураймен байланыспайды.
Dialogue: 0,0:17:50.60,0:17:52.73,Default,,0,0,0,,Мен оның ұсталғанына сене алмадым...
Dialogue: 0,0:17:56.37,0:17:59.31,Default,,0,0,0,,Бұл әйел адам емес пе? ―
Dialogue: 0,0:17:59.44,0:18:01.81,Default,,0,0,0,,Жараның қалпына келу жылдамдығы әдеттен тыс.
Dialogue: 0,0:18:02.11,0:18:05.15,Default,,0,0,0,,Шиндзюку міндетті түрде маңдайына оқ тиген...
Dialogue: 0,0:18:05.48,0:18:07.68,Default,,0,0,0,,Өйткені Хловис өз бетімен зерттеу жүргізді.
Dialogue: 0,0:18:07.78,0:18:09.85,Default,,0,0,0,,Оның Британияға еш қатысы болмауы керек...
Dialogue: 0,0:18:10.72,0:18:12.42,Default,,0,0,0,,Өмірлік заттар адаммен бірдей.
Dialogue: 0,0:18:12.52,0:18:16.76,Default,,0,0,0,,Қан үлгісін кейінірек зерттей алу үшін жараны суретке түсіруім керек пе?
Dialogue: 0,0:18:16.86,0:18:17.79,Default,,0,0,0,,Ах
Dialogue: 0,0:18:18.16,0:18:19.46,Default,,0,0,0,,меніңше, бұл – нағыз ақымақтық шыңы… Яғни—
Dialogue: 0,0:18:19.63,0:18:20.56,Default,,0,0,0,,Не...
Dialogue: 0,0:18:21.16,0:18:22.10,Default,,0,0,0,,Не?
Dialogue: 0,0:18:26.80,0:18:27.87,Default,,0,0,0,,Ах
Dialogue: 0,0:18:28.77,0:18:32.37,Default,,0,0,0,,Ақыры менің атымды атадың...
Dialogue: 0,0:18:38.88,0:18:41.25,Default,,0,0,0,,Соңында нөл түсірілмей қалады.
Dialogue: 0,0:18:41.62,0:18:42.82,Default,,0,0,0,,Жапон азаттық майданы...
Dialogue: 0,0:18:43.12,0:18:44.82,Default,,0,0,0,,Өйткені біз қорғаныс шебін жоғары көтеріп жатырмыз...
Dialogue: 0,0:18:45.12,0:18:46.32,Default,,0,0,0,,Мен оның ішінде адасып қалдым деп ойлаймын.
Dialogue: 0,0:18:46.42,0:18:49.66,Default,,0,0,0,,Маған ұнамайды. Мен әрқашан өзімді қорғау үшін бір нәрсені қалқан ретінде қолданамын.
Dialogue: 0,0:18:50.42,0:18:52.43,Default,,0,0,0,,Сонымен, Куруругиге не болды?
Dialogue: 0,0:18:52.53,0:18:53.76,Default,,0,0,0,,Ол жиналды.
Dialogue: 0,0:18:53.86,0:18:56.43,Default,,0,0,0,,Себебі мен қуат толтырғыштың бітуін және тоқтағанын күттім――
Dialogue: 0,0:18:56.53,0:18:57.87,Default,,0,0,0,,Біраз уақыт қажет болды, бірақ
Dialogue: 0,0:18:58.17,0:19:00.73,Default,,0,0,0,,«Күту» нені білдіреді? Бұл ұшақта ақау бар ма?
Dialogue: 0,0:19:00.83,0:19:04.51,Default,,0,0,0,,Мүмкін, өйткені ол бақылаудан шығып кеткен сияқты.
Dialogue: 0,0:19:04.81,0:19:07.47,Default,,0,0,0,,Бұл менің ағамның бөлімшесіне сәйкес келмейтін өрескел қателік.
Dialogue: 0,0:19:07.57,0:19:08.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:10.91,0:19:14.35,Default,,0,0,0,,Мен сынықтарды алып, жараны жудым.
Dialogue: 0,0:19:14.45,0:19:15.82,Default,,0,0,0,,Мұндағы Окаринді
Dialogue: 0,0:19:15.92,0:19:17.42,Default,,0,0,0,,Олардың тәрбиесіне байланысты
Dialogue: 0,0:19:17.52,0:19:20.52,Default,,0,0,0,,Сондықтан маған көмектесудің қажеті жоқ еді.
Dialogue: 0,0:19:20.62,0:19:23.72,Default,,0,0,0,,Көңілсіз жерлерде сіз әрқашан мақтанышыңызды сақтайсыз
Dialogue: 0,0:19:23.82,0:19:24.83,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:26.16,0:19:28.50,Default,,0,0,0,,Сіздің арқаңызда мен жақсы нәрсе үйрендім.
Dialogue: 0,0:19:28.80,0:19:29.66,Default,,0,0,0,,Хун
Dialogue: 0,0:19:29.76,0:19:31.20,Default,,0,0,0,,(су тамшылары құлаған дыбыс)
Dialogue: 0,0:19:31.40,0:19:32.53,Default,,0,0,0,,Ах
Dialogue: 0,0:19:32.63,0:19:34.54,Default,,0,0,0,,Бұл сіздің атыңыз ба?
Dialogue: 0,0:19:34.64,0:19:37.50,Default,,0,0,0,,Тыңдау - жағымсыз дәм.
Dialogue: 0,0:19:37.80,0:19:41.81,Default,,0,0,0,,Бұл жақсы есім емес пе? C.C.-ге қарағанда адамға әлдеқайда ұқсас.
Dialogue: 0,0:19:41.91,0:19:45.78,Default,,0,0,0,,Менің адам болғаным күлкілі...
Dialogue: 0,0:19:46.45,0:19:48.45,Default,,0,0,0,,Қалай болғанда да, мен...
Dialogue: 0,0:19:48.55,0:19:49.45,Default,,0,0,0,,Маған...
Dialogue: 0,0:19:49.65,0:19:50.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:50.92,0:19:53.49,Default,,0,0,0,,Мен... бәрін ұмыттым.
Dialogue: 0,0:19:53.89,0:19:55.42,Default,,0,0,0,,Барлығы...
Dialogue: 0,0:19:56.39,0:19:57.93,Default,,0,0,0,,Қазір аты кім?
Dialogue: 0,0:19:58.69,0:20:00.53,Default,,0,0,0,,… …
Dialogue: 0,0:20:06.30,0:20:08.50,Default,,0,0,0,,Бұл жақсы мүмкіндік, сондықтан мен сізге айтайын.
Dialogue: 0,0:20:08.90,0:20:11.41,Default,,0,0,0,,Иә, мен ертерек құтқарылдым.
Dialogue: 0,0:20:13.24,0:20:13.91,Default,,0,0,0,,Осы уақытқа дейін...
Dialogue: 0,0:20:14.34,0:20:16.94,Default,,0,0,0,,Сондай-ақ, Геасс туралы...
Dialogue: 0,0:20:17.24,0:20:18.35,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:20:19.41,0:20:21.22,Default,,0,0,0,,Мен мұны тек бір рет айтамын.
Dialogue: 0,0:20:23.42,0:20:24.38,Default,,0,0,0,,Рахмет
Dialogue: 0,0:20:27.25,0:20:30.52,Default,,0,0,0,,Бірінші рет алғыс алып отырмын.
Dialogue: 0,0:20:31.39,0:20:33.93,Default,,0,0,0,,Енді алғысымды қайтарғанымды қалайсың ба?
Dialogue: 0,0:20:34.33,0:20:35.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:35.63,0:20:38.27,Default,,0,0,0,,Маған бұрынғыдай қайта қоңырау шалыңыз.
Dialogue: 0,0:20:38.37,0:20:39.33,Default,,0,0,0,,Уф.
Dialogue: 0,0:20:39.43,0:20:41.24,Default,,0,0,0,,А, бұл атау?
Dialogue: 0,0:20:41.34,0:20:42.67,Default,,0,0,0,,Тек бір рет-
Dialogue: 0,0:20:42.77,0:20:45.67,Default,,0,0,0,,Қадірлеңіз, мейірімді және шын жүректен болыңыз.
Dialogue: 0,0:20:48.01,0:20:49.48,Default,,0,0,0,,Менің таңдауым жоқ.
Dialogue: 0,0:20:54.82,0:20:56.72,Default,,0,0,0,,(су тамшылары құлаған дыбыс)
Dialogue: 0,0:20:59.52,0:21:00.72,Default,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:21:00.82,0:21:02.99,Default,,0,0,0,,Жақсы емес, мүлде жақсы емес.
Dialogue: 0,0:21:03.29,0:21:04.63,Default,,0,0,0,,Мейірімділік жеткіліксіз
Dialogue: 0,0:21:04.73,0:21:06.96,Default,,0,0,0,,Адалдық пен қамқор жүрек.
Dialogue: 0,0:21:07.26,0:21:10.73,Default,,0,0,0,,Айтылуы күмәнді, ең бастысы, оған жылулық жетіспейді.
Dialogue: 0,0:21:11.27,0:21:12.67,Default,,0,0,0,,Ол өзімшіл әйел.
Dialogue: 0,0:21:12.83,0:21:16.47,Default,,0,0,0,,Ал, мен C.C.
Dialogue: 0,0:21:25.85,0:21:27.98,Default,,0,0,0,,Цк, сен тағы да солдатсың ба?
Dialogue: 0,0:21:28.28,0:21:30.72,Default,,0,0,0,,Бірлік қанша құлады.
Dialogue: 0,0:21:31.62,0:21:34.42,Default,,0,0,0,,Бұл қызғылт сары емес...
Dialogue: 0,0:21:34.52,0:21:37.32,Default,,0,0,0,,Нөл!
Dialogue: 0,0:21:40.49,0:21:42.03,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:21:44.43,0:21:45.97,Default,,0,0,0,,Біреу сені алып кетуге келген сияқты.
Dialogue: 0,0:21:47.47,0:21:50.80,Default,,0,0,0,,Нөл жақсысың ба? Басқа мүшелер алдымен...
Dialogue: 0,0:21:50.90,0:21:52.37,Default,,0,0,0,,А, бұл кім?
Dialogue: 0,0:21:52.77,0:21:55.01,Default,,0,0,0,,А, уайымдама...
Dialogue: 0,0:21:55.31,0:21:57.58,Default,,0,0,0,,Ол менің маңызды серігім.
Dialogue: 0,0:21:57.68,0:21:59.58,Default,,0,0,0,,Не?
Dialogue: 0,0:21:59.68,0:22:00.91,Default,,0,0,0,,Ｃ.Ｃ.―
Dialogue: 0,0:22:01.01,0:22:04.08,Default,,0,0,0,,Қардың неге ақ екенін білмеймін.
Dialogue: 0,0:22:04.58,0:22:05.49,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:22:06.05,0:22:10.86,Default,,0,0,0,,Менің ойымша, ақ қар әдемі. Мен оны жек көрмеймін.
Dialogue: 0,0:22:10.96,0:22:12.53,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:22:13.03,0:22:13.99,Default,,0,0,0,,Хмм...
Dialogue: 0,0:22:17.73,0:22:21.40,Default,,0,0,0,,♪～
Dialogue: 0,0:22:21.50,0:22:25.04,Default,,0,0,0,,♪Мен жүрмін, бірақ мен арыстан мен жолбарыстың арылдаған жолмен жүріп келемін
Dialogue: 0,0:22:25.34,0:22:28.91,Default,,0,0,0,,♪Қызыл аспанның арғы жағында, Махороба
Dialogue: 0,0:22:29.01,0:22:32.71,Default,,0,0,0,,♪Тұтқынның оңашалығында қаңғыған жас
Dialogue: 0,0:22:32.81,0:22:36.55,Default,,0,0,0,,♪Әлсіздік пен ашу көзге көрінбейтін жау ма?
Dialogue: 0,0:22:36.65,0:22:42.02,Default,,0,0,0,,♪Әке, мен өзімді әлі білмеймін.
Dialogue: 0,0:22:44.06,0:22:48.10,Default,,0,0,0,,♪Алдыңғы ағайындар
Dialogue: 0,0:22:48.40,0:22:51.80,Default,,0,0,0,,♪Көрінбейтін арқаңа ерсең
Dialogue: 0,0:22:51.90,0:22:58.87,Default,,0,0,0,,♪Таң жұлдызы сізді адасқан түнге шақырады
Dialogue: 0,0:22:59.54,0:23:02.98,Default,,0,0,0,,♪Өліммен бітпейді
Dialogue: 0,0:23:03.08,0:23:06.78,Default,,0,0,0,,♪Арманға ұмтылсам да
Dialogue: 0,0:23:06.88,0:23:10.62,Default,,0,0,0,,♪Сіз сенімді адамсыз
Dialogue: 0,0:23:10.72,0:23:14.59,Default,,0,0,0,,♪Менің өмірім
Dialogue: 0,0:23:14.69,0:23:18.49,Default,,0,0,0,,♪Қатты жел айдалада, Көбелектер мен гүлдердей өмір сүремін.
Dialogue: 0,0:23:18.59,0:23:22.16,Default,,0,0,0,,♪Мәңгілік көктемде гүлдеген дәмді елес
Dialogue: 0,0:23:22.46,0:23:26.00,Default,,0,0,0,,♪Бұл денені кірлетсе де, бұлыңғырлықтың тазалығы
Dialogue: 0,0:23:26.10,0:23:29.87,Default,,0,0,0,,♪Жүрегіңіздің сырына сеніңізші
Dialogue: 0,0:23:29.97,0:23:35.58,Default,,0,0,0,,♪Анашым, көз жасымды көрсетпесем де
Dialogue: 0,0:23:35.74,0:23:40.41,Default,,0,0,0,,♪Аяғымның астындағы шөпте
Dialogue: 0,0:23:40.51,0:23:45.85,Default,,0,0,0,,♪Шық ешқашан жоғалмайды
Dialogue: 0,0:23:49.16,0:23:50.82,Default,,0,0,0,,Әлі де жеткіліксіз! ―
Dialogue: 0,0:23:50.92,0:23:53.19,Default,,0,0,0,,Корнелияны бұрып тұрған бірдеңе...
Dialogue: 0,0:23:53.53,0:23:56.63,Default,,0,0,0,,Бұл олқылықтың орнын толтыру үшін мен...
Dialogue: 0,0:23:56.73,0:23:59.17,Default,,0,0,0,,Мен бір нәрсені жеңуім керек деп ойлаймын.
Dialogue: 0,0:23:59.47,0:24:00.67,Default,,0,0,0,,Және қара рыцарлар-
Dialogue: 0,0:24:00.77,0:24:01.67,Default,,0,0,0,,Әрі қарай не болуы керек?
Dialogue: 0,0:24:01.77,0:24:03.50,Default,,0,0,0,,Менің кетуім керек.
Dialogue: 0,0:24:03.60,0:24:07.77,Default,,0,0,0,,Иә, ол үшін қажет болса, мен...
Dialogue: 0,0:24:09.27,0:24:15.27,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory