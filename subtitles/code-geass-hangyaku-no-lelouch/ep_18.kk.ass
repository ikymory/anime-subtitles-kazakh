Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.33,0:00:05.63,Default,,0,0,0,,Лелуч, Британдық бала...
Dialogue: 0,0:00:05.73,0:00:07.70,Default,,0,0,0,,Екі жол бар.
Dialogue: 0,0:00:08.44,0:00:12.64,Default,,0,0,0,,Бірі – анамның жауын іздеп өткенге жол.
Dialogue: 0,0:00:12.74,0:00:17.65,Default,,0,0,0,,Басқасы – сіңілім Нуналлидің бақытты болуы үшін орын жасау.
Dialogue: 0,0:00:18.01,0:00:19.45,Default,,0,0,0,,Болашаққа жол
Dialogue: 0,0:00:20.52,0:00:23.45,Default,,0,0,0,,Лелуш өткенге және болашаққа қараған кезде...
Dialogue: 0,0:00:23.55,0:00:26.32,Default,,0,0,0,,Тек ол таңдай алатын ағымдағы жол...
Dialogue: 0,0:00:26.42,0:00:30.36,Default,,0,0,0,,Дүниенің жойылуы немесе дүниенің құрылысы?
Dialogue: 0,0:00:30.43,0:00:36.43,Default,,0,0,0,,♪～
Dialogue: 0,0:00:38.20,0:00:42.04,Default,,0,0,0,,♪Мен армандаған арман
Dialogue: 0,0:00:42.14,0:00:45.74,Default,,0,0,0,,♪Шексіз және алыс
Dialogue: 0,0:00:46.04,0:00:52.38,Default,,0,0,0,,♪Құрғақ күндерде көк аспан, Қолымда
Dialogue: 0,0:00:53.78,0:00:57.45,Default,,0,0,0,,♪Дыбыстағы біркелкі сынама және қателік
Dialogue: 0,0:00:57.55,0:01:02.76,Default,,0,0,0,,♪Уақытсыз және интервалсыз кеңістік
Dialogue: 0,0:01:04.43,0:01:06.66,Default,,0,0,0,,♪Өмірлік өлшем шу шығарады
Dialogue: 0,0:01:06.76,0:01:09.50,Default,,0,0,0,,♪Мен өз бетімді жасаймын
Dialogue: 0,0:01:09.60,0:01:12.83,Default,,0,0,0,,♪ Тек бір жағын тазалаңыз
Dialogue: 0,0:01:13.60,0:01:17.51,Default,,0,0,0,,♪Қолыма түсті
Dialogue: 0,0:01:17.61,0:01:21.38,Default,,0,0,0,,♪Шіріген алма
Dialogue: 0,0:01:21.48,0:01:25.41,Default,,0,0,0,,♪Айнада бейнеленген
Dialogue: 0,0:01:25.51,0:01:29.38,Default,,0,0,0,,♪Біздің арғы жағымызға
Dialogue: 0,0:01:29.48,0:01:33.19,Default,,0,0,0,,♪Дистанциялық сезім Адамдар арасындағы сынақ пен қателік
Dialogue: 0,0:01:33.29,0:01:38.36,Default,,0,0,0,,♪Уақытсыз және сезімсіз кеңістік
Dialogue: 0,0:01:40.09,0:01:42.36,Default,,0,0,0,,♪Бас пен дене тырнақтарын жоғары көтеріп тұру
Dialogue: 0,0:01:42.46,0:01:45.30,Default,,0,0,0,,♪Бетімді қырып алайын деп жатырмын
Dialogue: 0,0:01:45.40,0:01:51.11,Default,,0,0,0,,♪ Тек бір жағын тазалаңыз
Dialogue: 0,0:01:52.61,0:01:59.61,Default,,0,0,0,,♪-Қашықтық сезімі
Dialogue: 0,0:02:15.53,0:02:20.24,Default,,0,0,0,,Бір мотоцикл, сүңгуір қайық сатып алу көп қиындықты қажет етсе де?
Dialogue: 0,0:02:20.34,0:02:23.20,Default,,0,0,0,,Үндістанның әскери аймағы екенін білсе, қауіпті болар еді.
Dialogue: 0,0:02:23.30,0:02:25.91,Default,,0,0,0,,Қызық, олар қандай жолды пайдаланды?сол әйел
Dialogue: 0,0:02:26.31,0:02:31.31,Default,,0,0,0,,Енді мен қайта құруға байланысты Қара рыцарьлардың жаңа ұйымдық кестесін жария еткім келеді.
Dialogue: 0,0:02:31.41,0:02:34.45,Default,,0,0,0,,Кагасиро Тодо әскери басшы (мүшелер) ретінде О...
Dialogue: 0,0:02:34.52,0:02:35.58,Default,,0,0,0,,Иә
Dialogue: 0,0:02:35.92,0:02:38.65,Default,,0,0,0,,Жалпы ақпарат Қоғаммен байланыс Интеллект
Dialogue: 0,0:02:38.75,0:02:41.62,Default,,0,0,0,,Диетард Рид сыртқы байланыстардың бас менеджері ретінде
Dialogue: 0,0:02:42.19,0:02:43.59,Default,,0,0,0,,Бұл британдық па?
Dialogue: 0,0:02:43.69,0:02:45.46,Default,,0,0,0,,Ол БАҚ қызметкері.
Dialogue: 0,0:02:45.73,0:02:48.56,Default,,0,0,0,,Нөл Мен ұлтқа қатысты ерекше болғым келмейді.
Dialogue: 0,0:02:48.66,0:02:51.47,Default,,0,0,0,,Неліктен британдықтарды пайдалану қиынға соқты?
Dialogue: 0,0:02:51.57,0:02:52.73,Default,,0,0,0,,Себеп? ―
Dialogue: 0,0:02:52.83,0:02:54.94,Default,,0,0,0,,Маған не болады? (Асахина) Ой...
Dialogue: 0,0:02:55.24,0:02:58.24,Default,,0,0,0,,Өздеріңіз білетіндей, мен де жапон емеспін.
Dialogue: 0,0:02:58.34,0:03:01.31,Default,,0,0,0,,Қажетті нәрсе – нәтиже шығара білу.
Dialogue: 0,0:03:01.41,0:03:04.38,Default,,0,0,0,,Нәсіл, өткен және құралдар маңызды емес.
Dialogue: 0,0:03:04.48,0:03:05.78,Default,,0,0,0,,Енді нақты орналасқан жеріне қара.
Dialogue: 0,0:03:07.28,0:03:08.75,Default,,0,0,0,,Командирдің орынбасары - Канам Оуги.
Dialogue: 0,0:03:08.95,0:03:10.75,Default,,0,0,0,,Мен? (Лелуш) Сіз көңіліңізден шықпайсыз ба?
Dialogue: 0,0:03:10.85,0:03:12.25,Default,,0,0,0,,… …
Dialogue: 0,0:03:12.35,0:03:14.76,Default,,0,0,0,,Бастапқы көшбасшы Оуидаши болды.
Dialogue: 0,0:03:14.86,0:03:16.52,Default,,0,0,0,,Мен жаңадан келген адаммын.
Dialogue: 0,0:03:16.96,0:03:19.26,Default,,0,0,0,,Ракшата технологияны дамытуға жауапты
Dialogue: 0,0:03:19.36,0:03:20.56,Default,,0,0,0,,1-деңгей—тіпті танк те толықтай қауіпсіз сезілмейді.
Dialogue: 0,0:03:20.66,0:03:22.80,Default,,0,0,0,,Нөлдік отряд капитаны Карен Акацуки
Dialogue: 0,0:03:22.90,0:03:23.77,Default,,0,0,0,,Нөлдік топ?
Dialogue: 0,0:03:24.23,0:03:26.83,Default,,0,0,0,,Менің тікелей бақылауымда тек «Нөлдік отряд» болады.
Dialogue: 0,0:03:26.94,0:03:29.24,Default,,0,0,0,,Сіз оны SS деп ойлай аласыз.
Dialogue: 0,0:03:29.34,0:03:31.61,Default,,0,0,0,,SS... Нөлдік
Dialogue: 0,0:03:32.21,0:03:34.64,Default,,0,0,0,,Бірінші отряд капитаны Шого Асахина
Dialogue: 0,0:03:34.74,0:03:36.91,Default,,0,0,0,,Екінші дивизия командирі Сенба Рюга
Dialogue: 0,0:03:37.21,0:03:39.65,Default,,0,0,0,,Үшінші дивизияның капитаны Кизаки Кизуна
Dialogue: 0,0:03:44.45,0:03:47.32,Default,,0,0,0,,Екінші арнайы жасақ капитаны Шиничиро Тамаширо
Dialogue: 0,0:03:47.42,0:03:48.72,Default,,0,0,0,,Міне (Тамаки) Жарайды!
Dialogue: 0,0:03:48.79,0:03:50.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:50.39,0:03:52.46,Default,,0,0,0,,C.C. орны жоқ па?
Dialogue: 0,0:03:55.00,0:03:57.00,Default,,0,0,0,,Нөл бір Сіз сенімдісіз бе?
Dialogue: 0,0:03:57.30,0:03:57.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:58.23,0:04:01.44,Default,,0,0,0,,Бізде кейінірек талқылайтын тақырып бар.
Dialogue: 0,0:04:02.27,0:04:05.77,Default,,0,0,0,,Ол құрметті британдық болса да, Eleven рыцарь болады.
Dialogue: 0,0:04:05.87,0:04:07.64,Default,,0,0,0,,Телевизиялық хабар таратуға да рұқсат етілді.
Dialogue: 0,0:04:07.74,0:04:09.48,Default,,0,0,0,,Сіз оған қалай кірдіңіз?
Dialogue: 0,0:04:09.54,0:04:12.51,Default,,0,0,0,,Қараңызшы, Евфемия-сама да сол жас шамасында.
Dialogue: 0,0:04:12.78,0:04:14.35,Default,,0,0,0,,Хехе...
Dialogue: 0,0:04:16.25,0:04:16.95,Default,,0,0,0,,Мен қайықты тексеріп бітірдім.
Dialogue: 0,0:04:17.25,0:04:18.52,Default,,0,0,0,,Бұл мүмкін емес, солай ма?
Dialogue: 0,0:04:18.59,0:04:20.82,Default,,0,0,0,,Ал он бір - майор.
Dialogue: 0,0:04:20.92,0:04:22.26,Default,,0,0,0,,Сузаку Куруруги
Dialogue: 0,0:04:22.56,0:04:25.49,Default,,0,0,0,,Осымен сіз рыцарьлық ант бересіз.
Dialogue: 0,0:04:25.59,0:04:28.43,Default,,0,0,0,,Британдық рыцарь ретінде соғысқыңыз келе ме?
Dialogue: 0,0:04:28.50,0:04:30.03,Default,,0,0,0,,Мәртебелі Иса
Dialogue: 0,0:04:30.30,0:04:33.97,Default,,0,0,0,,Өзіңнің өзімшілдігіңді тастап, үлкен әділеттілік үшін.
Dialogue: 0,0:04:34.27,0:04:36.70,Default,,0,0,0,,Қылыш пен қалқан болғың келе ме?
Dialogue: 0,0:04:37.01,0:04:39.37,Default,,0,0,0,,Мәртебелі Иса
Dialogue: 0,0:04:40.31,0:04:46.31,Default,,0,0,0,,♪～
Dialogue: 0,0:04:53.35,0:04:55.92,Default,,0,0,0,,I, Euphemia li Britannia,
Dialogue: 0,0:04:56.02,0:04:59.43,Default,,0,0,0,,Сіз Сузаку Куруругиді рыцарь ретінде танисыз.
Dialogue: 0,0:04:59.49,0:05:00.36,Default,,0,0,0,,Батылдық…
Dialogue: 0,0:05:00.46,0:05:02.40,Default,,0,0,0,,Қатысу қиындайды.
Dialogue: 0,0:05:02.50,0:05:04.73,Default,,0,0,0,,Ллойд мырза өз ойын жеткізген сияқты.
Dialogue: 0,0:05:04.83,0:05:05.90,Default,,0,0,0,,Сол адамға?
Dialogue: 0,0:05:06.00,0:05:08.90,Default,,0,0,0,,Иә, мен де сені кездестірген емеспін.
Dialogue: 0,0:05:33.33,0:05:36.73,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:05:39.47,0:05:41.00,Default,,0,0,0,,А... а...
Dialogue: 0,0:05:51.51,0:05:52.91,Default,,0,0,0,,Сузаку Куруруги
Dialogue: 0,0:05:53.01,0:05:57.09,Default,,0,0,0,,Ол он бірдің мойынсұнғыш фракциясының туы бола алады.
Dialogue: 0,0:05:57.35,0:05:59.45,Default,,0,0,0,,Мен өлтіруді ұсынамын
Dialogue: 0,0:05:59.69,0:06:01.72,Default,,0,0,0,,Қастандық?Куруруги?
Dialogue: 0,0:06:01.82,0:06:03.39,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:06:03.49,0:06:05.59,Default,,0,0,0,,Оппозицияда Нөл атты жұлдыз бар.
Dialogue: 0,0:06:05.69,0:06:08.10,Default,,0,0,0,,Ол Киодзюн фракциясының мүшесі емес еді.
Dialogue: 0,0:06:08.40,0:06:11.03,Default,,0,0,0,,Адамдар тек өз принциптеріне сүйене отырып қозғалмайды.
Dialogue: 0,0:06:11.13,0:06:14.97,Default,,0,0,0,,Енді Британия жағында символ ретінде қызмет ете алатын адам пайда болды.
Dialogue: 0,0:06:15.07,0:06:18.04,Default,,0,0,0,,Ең практикалық нұсқа - қастандық.
Dialogue: 0,0:06:18.14,0:06:19.41,Default,,0,0,0,,Мен қарсымын. (Диетард) Иә?
Dialogue: 0,0:06:19.47,0:06:22.91,Default,,0,0,0,,Мұндай қорқақ көзқарас жапон халқының қолдауына ие бола алмайды.
Dialogue: 0,0:06:23.14,0:06:27.42,Default,,0,0,0,,Иә! Біз, Қара рыцарьлар, қарусыз ешкімді өлтірмейміз! ―
Dialogue: 0,0:06:27.78,0:06:32.09,Default,,0,0,0,,Қастандық дегеніміз жеке адамға қаруы жоқ кезде нысанаға алу деген сөз, солай емес пе?
Dialogue: 0,0:06:32.39,0:06:34.59,Default,,0,0,0,,Мен сенімдімін...
Dialogue: 0,0:06:34.69,0:06:37.43,Default,,0,0,0,,Мен жаңа ғана тәуекелділігі төмен әдісті айттым.
Dialogue: 0,0:06:37.53,0:06:39.86,Default,,0,0,0,,Нөл шешеді.
Dialogue: 0,0:06:40.16,0:06:44.17,Default,,0,0,0,,Бұл оңай, солай ма? Geass қолданбасын Сузаку Куруругиде қолдануға болады.
Dialogue: 0,0:06:44.47,0:06:45.13,Default,,0,0,0,,Миссия аяқталған соң маған үйлен.
Dialogue: 0,0:06:45.43,0:06:49.97,Default,,0,0,0,,Неліктен? Бұл қыңырлық па, әлде достық па? Мақтаныш па?
Dialogue: 0,0:06:50.04,0:06:51.04,Default,,0,0,0,,Уф!
Dialogue: 0,0:06:51.97,0:06:52.87,Default,,0,0,0,,Барлығы.
Dialogue: 0,0:06:52.97,0:06:55.51,Default,,0,0,0,,Өлтіру деген сөз болса да...?
Dialogue: 0,0:06:56.51,0:06:57.55,Default,,0,0,0,,Жылдам… бірақ әлі де менің қашықтығымда.
Dialogue: 0,0:06:58.01,0:07:00.65,Default,,0,0,0,,Ештеңе айтпай маған ештеңе бермейсің.
Dialogue: 0,0:07:00.75,0:07:03.52,Default,,0,0,0,,Рыцарь атағын тағайындау императорлық отбасының артықшылығы болып табылады.
Dialogue: 0,0:07:03.62,0:07:06.49,Default,,0,0,0,,Тіпті губернатордың да сөйлеуге құқығы жоқ.
Dialogue: 0,0:07:06.59,0:07:09.72,Default,,0,0,0,,Сузаку Куруруги - құрметті британдық.
Dialogue: 0,0:07:09.82,0:07:13.59,Default,,0,0,0,,Бұл қабілет рыцарь болуға лайық, сіздің әпкеңіз де...
Dialogue: 0,0:07:13.66,0:07:14.53,Default,,0,0,0,,Бұл губернатор.
Dialogue: 0,0:07:14.60,0:07:18.47,Default,,0,0,0,,А... губернатор өз көзімен көрген болар.
Dialogue: 0,0:07:18.57,0:07:21.60,Default,,0,0,0,,Сандарды ажырату Британияның ұлттық саясаты.
Dialogue: 0,0:07:21.70,0:07:23.67,Default,,0,0,0,,Мен оны өзгертемін.
Dialogue: 0,0:07:23.74,0:07:24.74,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:25.74,0:07:28.01,Default,,0,0,0,,Түсіндің бе? Губернатор лейтенанты -
Dialogue: 0,0:07:28.48,0:07:31.08,Default,,0,0,0,,Бұл император болуды білдіреді.
Dialogue: 0,0:07:34.12,0:07:38.19,Default,,0,0,0,,«Ой лифтінің» құрылысы кесте бойынша жүргізілуде.
Dialogue: 0,0:07:38.49,0:07:41.02,Default,,0,0,0,,А, мен білемін
Dialogue: 0,0:07:44.19,0:07:45.66,Default,,0,0,0,,Шнайзел?
Dialogue: 0,0:07:45.76,0:07:47.66,Default,,0,0,0,,Иә, мұны қалайсыз?
Dialogue: 0,0:07:48.86,0:07:53.60,Default,,0,0,0,,Қалағанымызды істейік.Өзіңізге сенімді болсаңыз, бізді шақырыңыз.
Dialogue: 0,0:07:53.67,0:07:54.57,Default,,0,0,0,,Олай болса
Dialogue: 0,0:07:54.67,0:07:57.57,Default,,0,0,0,,Менің Эшфорд академиясының студенттік кеңесінің моральдық комитетінің мүшесі
Dialogue: 0,0:07:57.67,0:08:00.54,Default,,0,0,0,,Сузаку Куруругидің рыцарь атағымен құттықтаймыз
Dialogue: 0,0:08:00.81,0:08:02.68,Default,,0,0,0,,Құттықтау кеші басталады!
Dialogue: 0,0:08:02.74,0:08:04.11,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:08:04.21,0:08:06.01,Default,,0,0,0,,Уау, бұл таңқаларлық.
Dialogue: 0,0:08:06.11,0:08:08.02,Default,,0,0,0,,Құттықтаймыз!Сузаку-кун!
Dialogue: 0,0:08:08.08,0:08:10.59,Default,,0,0,0,,Nunnally жоспарлауға жауапты.
Dialogue: 0,0:08:10.69,0:08:12.85,Default,,0,0,0,,Сіз көп тойлағаныңызға сенімдімін.
Dialogue: 0,0:08:12.95,0:08:15.02,Default,,0,0,0,,Біздікін де ала аласыз ба?
Dialogue: 0,0:08:15.12,0:08:17.23,Default,,0,0,0,,Әрине!Мен сондай бақыттымын
Dialogue: 0,0:08:22.63,0:08:26.77,Default,,0,0,0,,Мен не істеуім керек... Құрметті Эфемия...
Dialogue: 0,0:08:26.87,0:08:27.67,Default,,0,0,0,,Сәлем
Dialogue: 0,0:08:27.67,0:08:28.54,Default,,0,0,0,,Сәлем
Dialogue: 0,0:08:27.67,0:08:28.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:28.54,0:08:28.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:28.90,0:08:32.94,Default,,0,0,0,,Эй, сен ше, майор Сузаку Куруруги? Сіз осындасыз... Иә? ―
Dialogue: 0,0:08:33.61,0:08:36.28,Default,,0,0,0,,Хмм, сіз қызықты нәрсе істеп жатырсыз.
Dialogue: 0,0:08:36.54,0:08:37.68,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:08:37.78,0:08:40.58,Default,,0,0,0,,235
Dialogue: 0,0:08:40.68,0:08:42.25,Default,,0,0,0,,Иә!Бұл дұрыс!
Dialogue: 0,0:08:42.55,0:08:45.69,Default,,0,0,0,,235
Dialogue: 0,0:08:45.79,0:08:49.22,Default,,0,0,0,,Ол екі ядроға және жылдам нейтронға бөлінеді.
Dialogue: 0,0:08:49.29,0:08:52.19,Default,,0,0,0,,Бірақ мәселе мынада: отын ретінде пайдалануға болатын уран-235...
Dialogue: 0,0:08:52.29,0:08:55.66,Default,,0,0,0,,Табиғи уранның небәрі 0,7%-ы бар.
Dialogue: 0,0:08:55.76,0:08:58.23,Default,,0,0,0,,Біз оны бөлуге қанша құрылғы дайындасақ та...
Dialogue: 0,0:08:58.53,0:09:00.90,Default,,0,0,0,,Біз мұндай эксперименттер жасай алмаймыз, сондықтан...
Dialogue: 0,0:09:01.57,0:09:03.00,Default,,0,0,0,,Төраға Нина ше?
Dialogue: 0,0:09:03.10,0:09:04.84,Default,,0,0,0,,Иә, мен сені шақырдым, бірақ...
Dialogue: 0,0:09:08.04,0:09:09.04,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:14.72,0:09:15.72,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:18.02,0:09:21.62,Default,,0,0,0,,О, Карен!Маған пиццаны ұйымдастыруға көмектес!
Dialogue: 0,0:09:23.19,0:09:24.19,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:28.00,0:09:30.00,Default,,0,0,0,,Эй, сен мені естисің бе?
Dialogue: 0,0:09:30.33,0:09:32.70,Default,,0,0,0,,Нөл үшін, Карен.
Dialogue: 0,0:09:33.57,0:09:35.20,Default,,0,0,0,,Мен сені осы жерде өлтіруім керек...
Dialogue: 0,0:09:35.84,0:09:37.84,Default,,0,0,0,,Ах! Ха!
Dialogue: 0,0:09:37.94,0:09:40.21,Default,,0,0,0,,Ширли сіздің көмегіңізді қалайды.
Dialogue: 0,0:09:40.31,0:09:43.71,Default,,0,0,0,,Кешіріңіз, менде қазір маңызды нәрсе бар.
Dialogue: 0,0:09:43.81,0:09:45.61,Default,,0,0,0,,Не? Бұл не тапсырма?
Dialogue: 0,0:09:45.68,0:09:47.15,Default,,0,0,0,,Ах! иә?
Dialogue: 0,0:09:47.25,0:09:49.25,Default,,0,0,0,,Хмм (Лелуш) Кешігіп қалғаным өкінішті.
Dialogue: 0,0:09:49.32,0:09:51.19,Default,,0,0,0,,О, мүмкін емес!
Dialogue: 0,0:09:51.62,0:09:54.02,Default,,0,0,0,,Келгеніңізге қуаныштымын! (Лелух) Иә?
Dialogue: 0,0:09:54.12,0:09:58.13,Default,,0,0,0,,Иә! Өткен күн туралы... Қараңдар, мен саған маңызды бір нәрсе айтамын.
Dialogue: 0,0:09:58.23,0:10:01.83,Default,,0,0,0,,А... міне... осы да жетеді.
Dialogue: 0,0:10:01.90,0:10:02.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:03.13,0:10:04.63,Default,,0,0,0,,Өте өкінішті!
Dialogue: 0,0:10:05.07,0:10:07.64,Default,,0,0,0,,Сенің көп жұмысың бар, Созаку-кун.
Dialogue: 0,0:10:07.70,0:10:09.10,Default,,0,0,0,,Ах… Хаа
Dialogue: 0,0:10:09.20,0:10:11.37,Default,,0,0,0,,Кім? менің бастығым
Dialogue: 0,0:10:11.81,0:10:13.61,Default,,0,0,0,,Ллойд мырза, бірдеңе?
Dialogue: 0,0:10:13.71,0:10:15.84,Default,,0,0,0,,Иә? Мирейді танитындар бар ма?
Dialogue: 0,0:10:15.94,0:10:17.31,Default,,0,0,0,,Ол менің қалыңдығым (Нина) иә?
Dialogue: 0,0:10:17.38,0:10:18.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:19.28,0:10:20.82,Default,,0,0,0,,Бұл жақсы, солай ма?
Dialogue: 0,0:10:20.92,0:10:22.82,Default,,0,0,0,,… …
Dialogue: 0,0:10:22.88,0:10:24.02,Default,,0,0,0,,Мен айттым
Dialogue: 0,0:10:24.12,0:10:26.05,Default,,0,0,0,,Сіз білесіз бе? Иә
Dialogue: 0,0:10:27.36,0:10:28.76,Default,,0,0,0,,Аз ғана
Dialogue: 0,0:10:28.86,0:10:31.03,Default,,0,0,0,,А, сонда сен бе? Хм... Сенің атың кім?
Dialogue: 0,0:10:31.13,0:10:32.89,Default,,0,0,0,,Эрл Ллойд (қарсылас)?
Dialogue: 0,0:10:32.99,0:10:35.66,Default,,0,0,0,,Ай... а... Эрл? Бұл...
Dialogue: 0,0:10:35.76,0:10:37.80,Default,,0,0,0,,Екеуіңіздің қарым-қатынастарыңыз қандай?
Dialogue: 0,0:10:37.90,0:10:39.03,Default,,0,0,0,,Сонымен күйеу жігіт
Dialogue: 0,0:10:39.10,0:10:41.07,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:10:41.14,0:10:42.84,Default,,0,0,0,,Мен байыпты болдым.
Dialogue: 0,0:10:42.94,0:10:45.31,Default,,0,0,0,,Мм... сен әскерде жүрген шығарсың?
Dialogue: 0,0:10:45.37,0:10:48.84,Default,,0,0,0,,Біздің кемеде маңызды тұтынушымыз бар.
Dialogue: 0,0:10:48.94,0:10:50.24,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:10:50.34,0:10:53.85,Default,,0,0,0,,Әрине, Ланселот пен Евфемия ханшайымымен бірге.
Dialogue: 0,0:10:53.91,0:10:55.92,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:56.02,0:10:56.98,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:02.86,0:11:04.89,Default,,0,0,0,,Неліктен Шикинедзима? ―
Dialogue: 0,0:11:04.99,0:11:07.06,Default,,0,0,0,,Токио концессиясы қауіпсіз
Dialogue: 0,0:11:07.16,0:11:09.13,Default,,0,0,0,,Мен де білгім келеді.
Dialogue: 0,0:11:09.20,0:11:11.70,Default,,0,0,0,,Не? Сен білмейсің бе, Сесиль?
Dialogue: 0,0:11:11.80,0:11:13.17,Default,,0,0,0,,Мен де?
Dialogue: 0,0:11:13.27,0:11:15.27,Default,,0,0,0,,Бұл тым аңғал емес пе?
Dialogue: 0,0:11:15.37,0:11:18.27,Default,,0,0,0,,Іс-шаралар жоспары интернетте жарияланған сияқты.
Dialogue: 0,0:11:18.37,0:11:21.71,Default,,0,0,0,,Бір қызық қыз болды, сондықтан мен оған қызмет еттім.
Dialogue: 0,0:11:22.31,0:11:24.91,Default,,0,0,0,,Евфемия өз елінен ақсүйектерге сәлем беруге келеді.
Dialogue: 0,0:11:25.01,0:11:26.88,Default,,0,0,0,,Бұл аралға келу-
Dialogue: 0,0:11:26.98,0:11:30.02,Default,,0,0,0,,Рыцарь Сузаку Куруруги де бізбен бірге болуы керек.
Dialogue: 0,0:11:30.12,0:11:33.69,Default,,0,0,0,,Бұл стратегиялық база болмағандықтан, жау күштері шектеулі.
Dialogue: 0,0:11:33.79,0:11:35.19,Default,,0,0,0,,Бұл сіздің мүмкіндігіңіз! ―
Dialogue: 0,0:11:35.26,0:11:39.39,Default,,0,0,0,,Операцияның мақсаты Сузаку Куруруги мен Ланселотты қолға түсіру болды.
Dialogue: 0,0:11:39.69,0:11:42.23,Default,,0,0,0,,Майдандағы жеңіс және тұтқындарды ашық түрде алу
Dialogue: 0,0:11:42.30,0:11:43.20,Default,,0,0,0,,Иә
Dialogue: 0,0:11:43.26,0:11:44.27,Default,,0,0,0,,Иә
Dialogue: 0,0:11:44.80,0:11:46.13,Default,,0,0,0,,Сен мені тұтқын ретінде не істейсің?
Dialogue: 0,0:11:46.23,0:11:49.10,Default,,0,0,0,,Оны маған қалдырыңыз.
Dialogue: 0,0:11:53.01,0:11:54.84,Default,,0,0,0,,Осы жерде шығар
Dialogue: 0,0:11:54.91,0:11:56.41,Default,,0,0,0,,Бұл жұмыс істейді деп ойлайсыз ба?
Dialogue: 0,0:11:56.71,0:11:57.88,Default,,0,0,0,,Жарайды, солай ма?
Dialogue: 0,0:11:57.98,0:12:01.08,Default,,0,0,0,,жасырын қосымша өнім де жұмыс істеп тұрған сияқты.
Dialogue: 0,0:12:01.18,0:12:02.38,Default,,0,0,0,,Сіз қайдан білесіз?
Dialogue: 0,0:12:02.48,0:12:06.15,Default,,0,0,0,,Себебі Британия бізді таппады.
Dialogue: 0,0:12:06.25,0:12:07.32,Default,,0,0,0,,Ендеше!
Dialogue: 0,0:12:07.76,0:12:10.32,Default,,0,0,0,,Дегенмен бірінші қадам ғана.
Dialogue: 0,0:12:10.42,0:12:13.93,Default,,0,0,0,,Диетард Каренге нені сіңірді?
Dialogue: 0,0:12:14.03,0:12:16.96,Default,,0,0,0,,Мен жай ғана Сузаку Куруругиден маған тыңшылық жасауын өтіндім.
Dialogue: 0,0:12:17.06,0:12:19.13,Default,,0,0,0,,Кішкене дөңес бергеніммен.
Dialogue: 0,0:12:19.43,0:12:23.87,Default,,0,0,0,,Өзіңізге ұнайтын нәрсені істемеңіз. Қастандыққа тапсырыс бергенім есімде жоқ.
Dialogue: 0,0:12:24.37,0:12:27.14,Default,,0,0,0,,Нәтижесі жексұрын қастандық емес еді.
Dialogue: 0,0:12:27.24,0:12:30.74,Default,,0,0,0,,Халық оны әділеттің балғасы деп түсінсе, жақсы емес пе?
Dialogue: 0,0:12:30.85,0:12:33.11,Default,,0,0,0,,Ақпарат құралдарының көмегімен шындықты жасыруға болады.
Dialogue: 0,0:12:34.18,0:12:37.85,Default,,0,0,0,,Дүниені суретке түсіру үшін жай ғана әдемі болу ғана емес.
Dialogue: 0,0:12:37.95,0:12:39.05,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:12:39.82,0:12:43.02,Default,,0,0,0,,Диетард Сіздің мақсатыңыз қандай? ―
Dialogue: 0,0:12:43.12,0:12:46.33,Default,,0,0,0,,Сіз төмендетілген болсаңыз да, сіз әлі де британдықсыз.
Dialogue: 0,0:12:46.43,0:12:50.33,Default,,0,0,0,,Қара рыцарьларға қосылып, әлемді өзгертудің қажеті жоқ.
Dialogue: 0,0:12:50.76,0:12:55.97,Default,,0,0,0,,Мен сізді алғаш рет Сузаку Куруруги ұрлық оқиғасы кезінде көрдім.
Dialogue: 0,0:12:56.37,0:12:58.04,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:12:58.14,0:13:01.54,Default,,0,0,0,,Адамдар бейнесінде жаңа дәуір пайда болды.
Dialogue: 0,0:13:02.18,0:13:03.88,Default,,0,0,0,,Мен сені суретке түсіргім келеді-
Dialogue: 0,0:13:04.21,0:13:06.31,Default,,0,0,0,,Бір ғана адам ұйым құрды
Dialogue: 0,0:13:06.41,0:13:09.52,Default,,0,0,0,,Ұлтты құлатып, ақырында әлемді билеу
Dialogue: 0,0:13:09.82,0:13:13.05,Default,,0,0,0,,Мен бұл тарихты ең жақын жерден жазып аламын.
Dialogue: 0,0:13:13.42,0:13:15.79,Default,,0,0,0,,Мен ешқашан бұлай толқыған емеспін
Dialogue: 0,0:13:15.89,0:13:16.96,Default,,0,0,0,,Жазбалар? ―
Dialogue: 0,0:13:17.06,0:13:20.86,Default,,0,0,0,,Оқиғаға өзіңіз аралассаңыз, бұл ойдан шығарылған нәрсе.
Dialogue: 0,0:13:20.96,0:13:23.23,Default,,0,0,0,,Субъективтілігі жоқ ақпарат жоқ.
Dialogue: 0,0:13:23.33,0:13:28.00,Default,,0,0,0,,Нөлдік журналистика, түптеп келгенде, адамдардың қалауымен жасалған нәрсе.
Dialogue: 0,0:13:28.10,0:13:30.57,Default,,0,0,0,,Сіздің жауапкершілігіңіз әскери емес.
Dialogue: 0,0:13:30.87,0:13:32.81,Default,,0,0,0,,Мен бұл туралы білемін.
Dialogue: 0,0:13:33.47,0:13:35.54,Default,,0,0,0,,Келу уақыты жоспарланғандай -
Dialogue: 0,0:13:35.84,0:13:38.08,Default,,0,0,0,,Мен сізге штабта алдыңғы палата дайындадым, бірақ...
Dialogue: 0,0:13:38.18,0:13:39.05,Default,,0,0,0,,Сізге қалай ұнайды?
Dialogue: 0,0:13:39.41,0:13:42.05,Default,,0,0,0,,Мен мұнда кеме шақырады деп естідім.
Dialogue: 0,0:13:42.15,0:13:43.88,Default,,0,0,0,,Иә Өзгерістер жоқ
Dialogue: 0,0:13:43.98,0:13:45.12,Default,,0,0,0,,Күтейік.
Dialogue: 0,0:13:45.22,0:13:46.55,Default,,0,0,0,,Жарайды, қауіпсіздікке жауапты адам... Иә?
Dialogue: 0,0:13:46.55,0:13:48.19,Default,,0,0,0,,Түсінді. Қауіпсіздікке жауапты адам... А?
Dialogue: 0,0:13:46.55,0:13:48.19,Default,,0,0,0,,(Байланыс құрылғысының шуы)
Dialogue: 0,0:13:50.99,0:13:53.03,Default,,0,0,0,,Террористер?Мұнда қалай келдіңіз?
Dialogue: 0,0:13:57.06,0:13:59.13,Default,,0,0,0,,Бірінші блок алға қарай жалғасады
Dialogue: 0,0:13:59.23,0:14:01.54,Default,,0,0,0,,Zero Squad флангтардан Бірінші команданы қолдауы керек.
Dialogue: 0,0:14:01.60,0:14:02.87,Default,,0,0,0,,Он бір келді!
Dialogue: 0,0:14:08.58,0:14:10.21,Default,,0,0,0,,Бұл бала таңқаларлықтай жақсы жұмыс істейді
Dialogue: 0,0:14:14.22,0:14:15.85,Default,,0,0,0,,Todo күткендей.
Dialogue: 0,0:14:15.95,0:14:19.35,Default,,0,0,0,,Бір кездері Британ әскері Nightmare жоқ тек топырақпен жабылған.
Dialogue: 0,0:14:20.09,0:14:23.26,Default,,0,0,0,,Енді маған бұл ақпаратты Евфемияға жеткізу ғана қалды.
Dialogue: 0,0:14:23.96,0:14:26.29,Default,,0,0,0,,Штабқа біреулер шабуыл жасап жатқан сияқты.
Dialogue: 0,0:14:26.36,0:14:29.16,Default,,0,0,0,,Не? концессияға қайта оралайық
Dialogue: 0,0:14:29.26,0:14:31.27,Default,,0,0,0,,Сіз эскорт күшін ұйымдастыра аласыз ба?
Dialogue: 0,0:14:31.37,0:14:33.17,Default,,0,0,0,,Бұл шын мәнінде қауіпті болуы мүмкін.
Dialogue: 0,0:14:33.27,0:14:36.54,Default,,0,0,0,,Кең аумақта таяз кептеліс бар сияқты.
Dialogue: 0,0:14:36.64,0:14:38.17,Default,,0,0,0,,Сенімді болыңыз
Dialogue: 0,0:14:38.27,0:14:41.01,Default,,0,0,0,,Мен Эфемия-саманы қорғаймын.
Dialogue: 0,0:14:41.11,0:14:43.88,Default,,0,0,0,,Жоқ, көмек алу үшін штабқа бару керек.
Dialogue: 0,0:14:43.98,0:14:44.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:45.15,0:14:47.62,Default,,0,0,0,,Лейтенант Губернатор Ол құрметті британдық.
Dialogue: 0,0:14:48.45,0:14:51.25,Default,,0,0,0,,Жау қара рыцарь болуы мүмкін.
Dialogue: 0,0:14:51.35,0:14:53.02,Default,,0,0,0,,Егер Ланселот екеуміз бір-бірімізге опасыздық жасасақ...
Dialogue: 0,0:14:53.12,0:14:56.59,Default,,0,0,0,,Мм, түсіндің бе? Бұл корольдік әулеттің сыны.
Dialogue: 0,0:14:56.99,0:15:00.03,Default,,0,0,0,,А, жоқ, бұл менің айтқым келгенім емес...
Dialogue: 0,0:15:00.46,0:15:04.37,Default,,0,0,0,,Сузаку Куруруги Бұл жерде сіз өз күшіңізді көрсетесіз.
Dialogue: 0,0:15:04.47,0:15:07.17,Default,,0,0,0,,Егер мұны істесеңіз, шу ақырында жоғалады.
Dialogue: 0,0:15:07.23,0:15:08.20,Default,,0,0,0,,Иә
Dialogue: 0,0:15:12.27,0:15:13.44,Default,,0,0,0,,Өйткені, олар қорғаныс бөлімшесі!
Dialogue: 0,0:15:16.58,0:15:18.11,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:15:18.21,0:15:19.41,Default,,0,0,0,,Ах! Гах! Гах!
Dialogue: 0,0:15:25.09,0:15:26.09,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:15:28.06,0:15:30.09,Default,,0,0,0,,Нөл... күткендей
Dialogue: 0,0:15:30.36,0:15:32.69,Default,,0,0,0,,Келіңіздер!Кел, Созаку!
Dialogue: 0,0:15:34.36,0:15:35.36,Default,,0,0,0,,Мақсатты тексеру -
Dialogue: 0,0:15:35.66,0:15:38.30,Default,,0,0,0,,Әрбір ұшақ үшінші құрамды алып, шегініңіз.
Dialogue: 0,0:15:38.67,0:15:40.07,Default,,0,0,0,,Нысанаға қол тигізбеңіз.
Dialogue: 0,0:15:40.17,0:15:42.27,Default,,0,0,0,,Қайталау Мақсатқа қол тигізбеңіз!
Dialogue: 0,0:15:42.47,0:15:44.61,Default,,0,0,0,,Иә, тілшіге рахмет...
Dialogue: 0,0:15:44.71,0:15:47.41,Default,,0,0,0,,Уф, бірақ содан кейін...
Dialogue: 0,0:15:48.21,0:15:49.94,Default,,0,0,0,,Иә, Мәртебелі!
Dialogue: 0,0:15:56.05,0:15:58.52,Default,,0,0,0,,Еш құралсыз құмға секіру...
Dialogue: 0,0:15:58.62,0:16:01.42,Default,,0,0,0,,Немесе сіз Ланселотты қоршауды жоспарлап отырсыз ба? ―
Dialogue: 0,0:16:01.52,0:16:02.69,Default,,0,0,0,,Өзіңді жемге айналдыр.
Dialogue: 0,0:16:02.96,0:16:03.69,Default,,0,0,0,,Бірақ!
Dialogue: 0,0:16:10.13,0:16:11.40,Default,,0,0,0,,Нөл!Осымен!
Dialogue: 0,0:16:11.47,0:16:13.07,Default,,0,0,0,,Сіз! (Рақшата) ұсталды
Dialogue: 0,0:16:21.01,0:16:22.64,Default,,0,0,0,,Не? Ку…
Dialogue: 0,0:16:25.05,0:16:26.05,Default,,0,0,0,,Қозғалмайсыз ба?
Dialogue: 0,0:16:30.68,0:16:31.55,Default,,0,0,0,,Жақсы емес пе?
Dialogue: 0,0:16:31.65,0:16:34.22,Default,,0,0,0,,Сузаку Куруруги туралы айтатыным бар.
Dialogue: 0,0:16:35.06,0:16:36.49,Default,,0,0,0,,Сіз шыға аласыз ба? ―
Dialogue: 0,0:16:36.66,0:16:39.46,Default,,0,0,0,,Бірінші жетек жүйесінен басқаның барлығы қозғалуы керек.
Dialogue: 0,0:16:39.56,0:16:42.53,Default,,0,0,0,,Әскери тұтқындарға қатынас халықаралық құқыққа сәйкес.
Dialogue: 0,0:16:42.63,0:16:44.30,Default,,0,0,0,,Талқылауға қатыспасаңыз -
Dialogue: 0,0:16:44.40,0:16:47.00,Default,,0,0,0,,Сізге жан-жақтан оқ жаудыра ма?
Dialogue: 0,0:16:47.07,0:16:48.07,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:16:48.60,0:16:52.24,Default,,0,0,0,,Мәселе жоқ!Созақуға айтшы, шықсын.
Dialogue: 0,0:16:52.34,0:16:55.14,Default,,0,0,0,,Бұған қоса, Ланселот неге қозғалмайды?
Dialogue: 0,0:16:55.21,0:16:58.41,Default,,0,0,0,,Сакурадит Nightmare's жетек жүйесінде қолданылады
Dialogue: 0,0:16:58.51,0:17:00.28,Default,,0,0,0,,Қандай да бір кедергі бар...
Dialogue: 0,0:17:00.38,0:17:01.78,Default,,0,0,0,,Gefion Disturber
Dialogue: 0,0:17:02.08,0:17:02.75,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:17:03.05,0:17:05.49,Default,,0,0,0,,Бірақ кептелу де жартылай жұмыс істейді...
Dialogue: 0,0:17:06.05,0:17:08.59,Default,,0,0,0,,Мен бұл жай ғана теория деп ойладым, бірақ мен аңғал едім.
Dialogue: 0,0:17:09.22,0:17:10.59,Default,,0,0,0,,Бұл сен бе? ―
Dialogue: 0,0:17:10.69,0:17:11.66,Default,,0,0,0,,Ракшата
Dialogue: 0,0:17:11.73,0:17:14.80,Default,,0,0,0,,Қызық, тиімді диапазон мен ұзақтығы әлі ұзақ па?
Dialogue: 0,0:17:17.50,0:17:20.60,Default,,0,0,0,,Сузаку Куруруги Мен мұны тура айтайын.
Dialogue: 0,0:17:20.70,0:17:22.74,Default,,0,0,0,,Мен сенің менің досым болғаныңды қалаймын.
Dialogue: 0,0:17:23.04,0:17:24.17,Default,,0,0,0,,Бұл қауіп пе?
Dialogue: 0,0:17:24.54,0:17:26.24,Default,,0,0,0,,Сонда да мен бас тартамын.
Dialogue: 0,0:17:26.34,0:17:27.64,Default,,0,0,0,,Мен мұны бұрын да айттым!
Dialogue: 0,0:17:27.74,0:17:30.64,Default,,0,0,0,,Қате әдіс арқылы алынған нәтижелердің мағынасы жоқ.
Dialogue: 0,0:17:30.71,0:17:32.28,Default,,0,0,0,,Енді тыңдайық.
Dialogue: 0,0:17:32.38,0:17:34.42,Default,,0,0,0,,Қазіргі бейбітшілікте мән жоқ па?
Dialogue: 0,0:17:34.48,0:17:35.45,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:35.55,0:17:38.75,Default,,0,0,0,,Жеті жыл бұрын, егер Жапония толық ауқымды қарсылықты таңдаса...
Dialogue: 0,0:17:39.05,0:17:40.69,Default,,0,0,0,,Сіздің ойыңызша не болар еді? ―
Dialogue: 0,0:17:41.22,0:17:43.49,Default,,0,0,0,,Қытай Федерациясы мен ЕО араласуы-
Dialogue: 0,0:17:43.59,0:17:47.80,Default,,0,0,0,,Жапония үш бөлікке бөлініп, әлі де соғысып жатқан болар еді.
Dialogue: 0,0:17:48.10,0:17:52.50,Default,,0,0,0,,Басқаша айтқанда, қазіргі бейбітшілік мүмкіндігінше тезірек шешілген сөзсіз берілудің арқасында.
Dialogue: 0,0:17:52.57,0:17:53.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:54.13,0:17:55.34,Default,,0,0,0,,Иә.
Dialogue: 0,0:17:55.44,0:17:59.51,Default,,0,0,0,,Мен әкем құрған тыныштықты бұзбау үшін күресемін.
Dialogue: 0,0:17:59.77,0:18:02.51,Default,,0,0,0,,Жоқ, қателесесіз.
Dialogue: 0,0:18:02.61,0:18:06.18,Default,,0,0,0,,Бағыну - бұл сайланған премьер-министр Куруруги емес...
Dialogue: 0,0:18:06.28,0:18:08.72,Default,,0,0,0,,Оны кім өлтірсе, соны шешті.
Dialogue: 0,0:18:08.78,0:18:09.78,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:10.15,0:18:12.42,Default,,0,0,0,,Үзіліс басқарудың басқару тізбегінде орын алады.
Dialogue: 0,0:18:12.52,0:18:14.86,Default,,0,0,0,,Менің берілуден басқа амалым қалмады.
Dialogue: 0,0:18:15.26,0:18:16.36,Default,,0,0,0,,Түсіндің бе? ―
Dialogue: 0,0:18:16.46,0:18:18.46,Default,,0,0,0,,Халықтың қалауы алынды.
Dialogue: 0,0:18:18.56,0:18:22.13,Default,,0,0,0,,Ереже бұзған қылмыскер!
Dialogue: 0,0:18:22.36,0:18:23.40,Default,,0,0,0,,Сіз мені ести аласыз ба?
Dialogue: 0,0:18:23.50,0:18:25.57,Default,,0,0,0,,Микрофон шуы тым қатты...
Dialogue: 0,0:18:26.10,0:18:28.77,Default,,0,0,0,,…  …
Dialogue: 0,0:18:29.17,0:18:31.54,Default,,0,0,0,,Біреуді жазалаудың бір ғана жолы бар.
Dialogue: 0,0:18:31.64,0:18:32.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:32.84,0:18:35.74,Default,,0,0,0,,Сол кездегі жапондықтар таңдай алмаған нұсқалар...
Dialogue: 0,0:18:35.84,0:18:38.15,Default,,0,0,0,,Өзіңізді таныстырыңыз.
Dialogue: 0,0:18:38.25,0:18:41.55,Default,,0,0,0,,Жеті жыл бұрын ұрланған Британиямен күрес жолы
Dialogue: 0,0:18:41.82,0:18:43.68,Default,,0,0,0,,Ұрыс... Бұл тағы да!
Dialogue: 0,0:18:44.55,0:18:46.49,Default,,0,0,0,,Бұл да бір жол.
Dialogue: 0,0:18:46.59,0:18:48.12,Default,,0,0,0,,Сіз өз эго-
Dialogue: 0,0:18:48.22,0:18:51.83,Default,,0,0,0,,Сіз мұны көптеген адамдарға мәңгілікке таңуға ниетіңіз бар ма? ―
Dialogue: 0,0:18:52.13,0:18:53.63,Default,,0,0,0,,Сен мұны бейбітшілік деп атайсың ба?
Dialogue: 0,0:18:53.86,0:18:54.86,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:55.66,0:18:56.56,Default,,0,0,0,,Жауап беру.
Dialogue: 0,0:18:56.66,0:18:59.37,Default,,0,0,0,,Сіз мені естисіз бе? Майор Куруруги, жауап беріңіз.
Dialogue: 0,0:18:59.47,0:19:01.37,Default,,0,0,0,,Бұл жақсы ма? (Лелуш) Өзіңе ұнайтын нәрсені істе.
Dialogue: 0,0:19:01.90,0:19:05.61,Default,,0,0,0,,Бұл британдық армияның Шикинедзима базасының командирі подполковник Пейер.
Dialogue: 0,0:19:05.71,0:19:08.71,Default,,0,0,0,,Бұдан былай лаңкестерге жер-жер зымырандарымен атқылайтын боламыз.
Dialogue: 0,0:19:08.78,0:19:11.65,Default,,0,0,0,,Майор Куруруги, ол тұрған жерде Нөлді тоқтат!
Dialogue: 0,0:19:11.85,0:19:14.45,Default,,0,0,0,,Не!Қол астындағыларға өлуге бұйрық бересің бе?
Dialogue: 0,0:19:15.28,0:19:16.42,Default,,0,0,0,,Ну... ку! ―
Dialogue: 0,0:19:17.62,0:19:19.15,Default,,0,0,0,,Kururugi!Сіз...
Dialogue: 0,0:19:19.39,0:19:21.62,Default,,0,0,0,,Мен сіздің әдісіңізбен келіспеймін.
Dialogue: 0,0:19:21.72,0:19:23.62,Default,,0,0,0,,Енді не істей аласыз!
Dialogue: 0,0:19:23.69,0:19:24.63,Default,,0,0,0,,Сол жігіт!
Dialogue: 0,0:19:24.73,0:19:26.76,Default,,0,0,0,,Қозғалмаңыз, сізге күш өрісі кедергі болады.
Dialogue: 0,0:19:26.86,0:19:27.73,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:19:30.33,0:19:33.40,Default,,0,0,0,,Мен Портманды мені күзетуге тағайындаймын. Лейтенант губернатор мұны алады...
Dialogue: 0,0:19:33.50,0:19:34.40,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:19:34.50,0:19:36.40,Default,,0,0,0,,Сіз Ланселотты жоюды жоспарлап отырсыз ба?
Dialogue: 0,0:19:37.44,0:19:39.17,Default,,0,0,0,,Майор Куруруги кептеліп қалды.
Dialogue: 0,0:19:39.54,0:19:41.51,Default,,0,0,0,,Енді мен нөлді жеңе аламын.
Dialogue: 0,0:19:41.61,0:19:45.61,Default,,0,0,0,,Мұндай стратегияны кім жоспарлайды?Сузаку Куруруги менің рыцарым, солай ма?
Dialogue: 0,0:19:46.31,0:19:48.32,Default,,0,0,0,,Бұл квази-бірінші сынып пәрмені.
Dialogue: 0,0:19:48.42,0:19:50.42,Default,,0,0,0,,Бұйрықтың күшін жоя алатын генерал-губернатордан артық па?
Dialogue: 0,0:19:50.52,0:19:53.82,Default,,0,0,0,,Бұл үш немесе одан да көп генерал офицерлердің келісімімен ғана жасалуы мүмкін.
Dialogue: 0,0:19:53.89,0:19:56.62,Default,,0,0,0,,Сонда бұл нұсқауларды кім берді?
Dialogue: 0,0:19:56.72,0:19:58.43,Default,,0,0,0,,Мені желіге қосыңыз
Dialogue: 0,0:19:58.66,0:20:01.46,Default,,0,0,0,,Бұл бірінші дәрежелі бұйрық, лейтенант губернатор Эфемия.
Dialogue: 0,0:20:02.60,0:20:03.66,Default,,0,0,0,,Мм... (Солдат) Уау!
Dialogue: 0,0:20:03.86,0:20:04.73,Default,,0,0,0,,Қорқыныш! (Солдат) Уау!
Dialogue: 0,0:20:04.80,0:20:05.77,Default,,0,0,0,,Лейтенант губернатор!
Dialogue: 0,0:20:06.43,0:20:10.20,Default,,0,0,0,,Негізді айт! Қатысып қаламын ба деген қауіп бар
Dialogue: 0,0:20:10.30,0:20:11.94,Default,,0,0,0,,Мен әлі де ұшыру туралы бұйрық бере аламын ба?
Dialogue: 0,0:20:12.37,0:20:14.51,Default,,0,0,0,,Мен сенің де өзімшіл болғаныңды қалаймын!
Dialogue: 0,0:20:14.61,0:20:16.64,Default,,0,0,0,,Мм... Эфемия-сама...
Dialogue: 0,0:20:16.74,0:20:18.88,Default,,0,0,0,,Бұл жақсы емес пе? Әлі де...
Dialogue: 0,0:20:18.95,0:20:20.71,Default,,0,0,0,,Жақындап келе жатқан зымыранды растаңыз!
Dialogue: 0,0:20:20.78,0:20:21.65,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:24.92,0:20:26.35,Default,,0,0,0,,Нөл!Қазір көмектес!
Dialogue: 0,0:20:27.79,0:20:28.82,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:20:28.89,0:20:31.53,Default,,0,0,0,,Қарғыс атсын! Осы қарқынмен сен де өлесің! ―
Dialogue: 0,0:20:31.63,0:20:33.29,Default,,0,0,0,,Бұл шынымен жақсы ма?
Dialogue: 0,0:20:33.53,0:20:34.53,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:34.76,0:20:36.86,Default,,0,0,0,,Майор Куруруги Бұл босқа кеткен өлім емес.
Dialogue: 0,0:20:36.96,0:20:37.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:38.23,0:20:41.94,Default,,0,0,0,,Біз опасыздықтың ұлы қылмыскері Нөлді міндетті түрде жерлей аламыз.
Dialogue: 0,0:20:42.24,0:20:45.24,Default,,0,0,0,,Әскери ерліктерің ұрпақтан-ұрпаққа жалғасады.
Dialogue: 0,0:20:45.34,0:20:46.01,Default,,0,0,0,,(Рютаки) Мен сені Финалдық іріктеуге жіберуге еш ниеттенген емеспін
Dialogue: 0,0:20:46.27,0:20:49.48,Default,,0,0,0,,Барлық қорқынышты армандар! Келген зымырандарға қарсы тосқауыл қойыңыз! ―
Dialogue: 0,0:20:49.54,0:20:51.35,Default,,0,0,0,,Барлық оқтарды атқаныңыз маңызды емес!
Dialogue: 0,0:20:55.38,0:20:58.02,Default,,0,0,0,,Созаку! Нөлді шығарыңыз! мен...
Dialogue: 0,0:20:58.32,0:21:01.89,Default,,0,0,0,,Мен студенттік кеңестен Карен Штадтфельдтемін!
Dialogue: 0,0:21:01.96,0:21:03.29,Default,,0,0,0,,Ол кеңсе қызметкері және үйленбеген.
Dialogue: 0,0:21:06.49,0:21:08.63,Default,,0,0,0,,Созаку әлі өлмеуі керек
Dialogue: 0,0:21:08.86,0:21:11.53,Default,,0,0,0,,Сарбаздар бұйрықты орындауы керек!
Dialogue: 0,0:21:11.63,0:21:15.37,Default,,0,0,0,,Хмф! Басқаларға еру оңайырақ!
Dialogue: 0,0:21:15.44,0:21:16.04,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:16.34,0:21:17.60,Default,,0,0,0,,Өзіңіз ше!
Dialogue: 0,0:21:17.70,0:21:20.54,Default,,0,0,0,,Жоқ! Бұл мен шешкен ережем.
Dialogue: 0,0:21:20.64,0:21:21.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:23.68,0:21:24.68,Default,,0,0,0,,Ах! ―
Dialogue: 0,0:21:25.48,0:21:26.48,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:30.88,0:21:34.32,Default,,0,0,0,,Қалқымалы жүйе жойылды.
Dialogue: 0,0:21:35.59,0:21:36.59,Default,,0,0,0,,Ах! ―
Dialogue: 0,0:21:37.49,0:21:38.56,Default,,0,0,0,,Бұл...
Dialogue: 0,0:21:38.66,0:21:40.76,Default,,0,0,0,,Үлкен ағасы Авалон...
Dialogue: 0,0:21:49.97,0:21:50.97,Default,,0,0,0,,Не... не?
Dialogue: 0,0:21:53.94,0:21:56.58,Default,,0,0,0,,Сузаку!Бұлай жалғаса берсе мен өлемін!
Dialogue: 0,0:21:56.68,0:21:57.98,Default,,0,0,0,,Ережені бұзғаннан жақсы!
Dialogue: 0,0:21:58.05,0:22:00.08,Default,,0,0,0,,Надан адам!
Dialogue: 0,0:22:00.35,0:22:01.01,Default,,0,0,0,,Ах!
Dialogue: 0,0:22:18.03,0:22:21.70,Default,,0,0,0,,♪Мозаикалық бөлік бір-бірден
Dialogue: 0,0:22:21.80,0:22:25.51,Default,,0,0,0,,♪Қосыңыз және сызыңыз
Dialogue: 0,0:22:25.61,0:22:32.61,Default,,0,0,0,,♪Сен маған сыйлаған кездесулер мен қоштасулар
Dialogue: 0,0:22:41.12,0:22:48.13,Default,,0,0,0,,♪Бұлай болуы мүмкін емес,-деп ойланып ұйықтап қалдым
Dialogue: 0,0:22:48.63,0:22:51.90,Default,,0,0,0,,♪Мен оянсам, әдеттегідей
Dialogue: 0,0:22:52.00,0:22:56.40,Default,,0,0,0,,♪ Өзгеріссіз бос жүріс
Dialogue: 0,0:22:56.50,0:23:01.68,Default,,0,0,0,,♪ Мағынасыз қайталанады
Dialogue: 0,0:23:02.54,0:23:06.55,Default,,0,0,0,,♪Мозаикалық үзінділер жанды түрде бейнеленген
Dialogue: 0,0:23:06.65,0:23:09.72,Default,,0,0,0,,♪Бұрынғы өтірік пен қателіктер
Dialogue: 0,0:23:09.82,0:23:16.82,Default,,0,0,0,,♪Оны өшіргім келген сайын, ол туралы көбірек ойлаймын
Dialogue: 0,0:23:17.39,0:23:18.63,Default,,0,0,0,,♪Артқа қарап
Dialogue: 0,0:23:18.73,0:23:21.93,Default,,0,0,0,,♪Бастау сызығы бар
Dialogue: 0,0:23:22.03,0:23:24.53,Default,,0,0,0,,♪Әлі прогресс жоқ
Dialogue: 0,0:23:24.63,0:23:31.64,Default,,0,0,0,,♪Қане армандарымызды қайта жинап алайық
Dialogue: 0,0:23:32.01,0:23:35.58,Default,,0,0,0,,♪Мозаикалық бөлік бір-бірден
Dialogue: 0,0:23:35.68,0:23:39.18,Default,,0,0,0,,♪Қосыңыз және сызыңыз
Dialogue: 0,0:23:39.48,0:23:46.49,Default,,0,0,0,,♪Сіз маған сыйлаған кездесулер мен қоштасулар
Dialogue: 0,0:23:49.49,0:23:51.86,Default,,0,0,0,,Менің Геассим - бұл бұйрық беру күші.
Dialogue: 0,0:23:52.09,0:23:54.03,Default,,0,0,0,,Маған ешкім қарсы шыға алмайды.
Dialogue: 0,0:23:54.80,0:23:57.10,Default,,0,0,0,,Ал тапсырыс берілген адам-
Dialogue: 0,0:23:57.70,0:24:02.50,Default,,0,0,0,,Этикам, ойым, сезімім тапталады.
Dialogue: 0,0:24:02.60,0:24:04.77,Default,,0,0,0,,Мұның бәрін білгеннен кейін...
Dialogue: 0,0:24:05.67,0:24:07.21,Default,,0,0,0,,Мен Созакумын...
Dialogue: 0,0:24:08.71,0:24:14.71,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory