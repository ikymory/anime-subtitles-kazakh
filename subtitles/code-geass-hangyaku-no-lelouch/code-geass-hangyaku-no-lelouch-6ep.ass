Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.33,0:00:05.33,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:00:09.50,0:00:12.17,Default,,0,0,0,,Мәртебелі, мәйіт келді.
Dialogue: 0,0:00:12.77,0:00:15.54,Default,,0,0,0,,Мен жаңа ғана Хловиспен сөйлестім.
Dialogue: 0,0:00:15.74,0:00:16.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:16.54,0:00:20.32,Default,,0,0,0,,Мен тезірек жоспар құруым керек.
Dialogue: 0,0:00:20.42,0:00:26.42,Default,,0,0,0,,♪～
Dialogue: 0,0:00:29.02,0:00:32.73,Default,,0,0,0,,♪Өзім, тіпті әлем
Dialogue: 0,0:00:33.03,0:00:36.30,Default,,0,0,0,,♪Мен оны өзгерте аламын деп ойлаймын.
Dialogue: 0,0:00:36.40,0:00:42.17,Default,,0,0,0,,♪Сәт әрқашан жаныңда...
Dialogue: 0,0:00:44.21,0:00:50.51,Default,,0,0,0,,♪ Тітіркенуді жасыра алмайды
Dialogue: 0,0:00:51.25,0:00:57.52,Default,,0,0,0,,♪ Бір орында тұрып өзіңе қара
Dialogue: 0,0:00:57.62,0:01:01.12,Default,,0,0,0,,♪ойланып отырып, уайымдағанда
Dialogue: 0,0:01:01.22,0:01:04.53,Default,,0,0,0,,♪Өкінішпен шешім қабылдау керек.
Dialogue: 0,0:01:04.63,0:01:08.13,Default,,0,0,0,,♪Сен маған берген бір сөз
Dialogue: 0,0:01:08.23,0:01:11.77,Default,,0,0,0,,♪Шатасу жоғалады
Dialogue: 0,0:01:12.07,0:01:18.27,Default,,0,0,0,,♪Бос бөлмеме нұр түсті
Dialogue: 0,0:01:18.61,0:01:21.81,Default,,0,0,0,,♪Мен қараған аспан
Dialogue: 0,0:01:22.14,0:01:25.68,Default,,0,0,0,,♪Көк түс анық және айқын болады
Dialogue: 0,0:01:25.78,0:01:32.25,Default,,0,0,0,,♪Мен жабық терезені ашуды шештім.
Dialogue: 0,0:01:32.49,0:01:36.36,Default,,0,0,0,,♪Өзім, тіпті әлем
Dialogue: 0,0:01:36.46,0:01:39.49,Default,,0,0,0,,♪Мен оны өзгерте аламын деп ойлаймын.
Dialogue: 0,0:01:39.86,0:01:46.37,Default,,0,0,0,,♪Сәтті сезін, осында және қазір...
Dialogue: 0,0:01:57.21,0:01:58.58,Default,,0,0,0,,Сіз оны көрдіңіз бе? (Оқушы) Неліктен он бір?
Dialogue: 0,0:01:58.68,0:02:00.82,Default,,0,0,0,,Ол күдікті болды, солай емес пе? Мәртебелі Хловис.
Dialogue: 0,0:02:01.35,0:02:02.78,Default,,0,0,0,,Мұғалім қателікпен ұсталғанын айтты.
Dialogue: 0,0:02:02.88,0:02:05.29,Default,,0,0,0,,Бірақ ол күдікті нәрсе болғандықтан қамауға алынды, солай ма?
Dialogue: 0,0:02:05.45,0:02:07.59,Default,,0,0,0,,Мен сіздің террорист емес екеніңізге сенімдімін.
Dialogue: 0,0:02:07.69,0:02:09.46,Default,,0,0,0,,Иә
Dialogue: 0,0:02:09.56,0:02:13.26,Default,,0,0,0,,Дұрыс, тек мектеп екенін растаңыз.
Dialogue: 0,0:02:13.36,0:02:14.60,Default,,0,0,0,,Он бір
Dialogue: 0,0:02:14.70,0:02:16.46,Default,,0,0,0,,Құрметті британдық
Dialogue: 0,0:02:16.56,0:02:18.47,Default,,0,0,0,,Өйткені бұл бірдей нәрсе...
Dialogue: 0,0:02:18.57,0:02:20.60,Default,,0,0,0,,Тек қорқу жеткіліксіз
Dialogue: 0,0:02:20.70,0:02:22.50,Default,,0,0,0,,Онымен сөйлескенде ол қандай адам...
Dialogue: 0,0:02:22.60,0:02:23.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:23.71,0:02:25.64,Default,,0,0,0,,Сізде тым көп энергия бар
Dialogue: 0,0:02:30.38,0:02:31.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:36.62,0:02:37.35,Default,,0,0,0,,Га
Dialogue: 0,0:02:55.47,0:02:58.44,Default,,0,0,0,,Мен бұл белгіні 7 жылда алғаш рет қолдандым.
Dialogue: 0,0:02:58.64,0:03:00.38,Default,,0,0,0,,Шатырда сөйлесейік
Dialogue: 0,0:03:00.48,0:03:01.51,Default,,0,0,0,,О
Dialogue: 0,0:03:01.61,0:03:03.88,Default,,0,0,0,,Көңілім босады, аманмын.
Dialogue: 0,0:03:04.48,0:03:07.32,Default,,0,0,0,,Мұның бәрі сіздің арқаңызда...
Dialogue: 0,0:03:07.55,0:03:09.25,Default,,0,0,0,,Сен мені қорғауың керек
Dialogue: 0,0:03:09.78,0:03:12.62,Default,,0,0,0,,Мен 7 жыл бұрын қарызымды қайтардым
Dialogue: 0,0:03:13.35,0:03:14.36,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:15.36,0:03:18.29,Default,,0,0,0,,Ой, мына бала ше? Қараңызшы, капсула.
Dialogue: 0,0:03:18.63,0:03:21.63,Default,,0,0,0,,Қиын шайқаспен бөлінген
Dialogue: 0,0:03:21.90,0:03:23.63,Default,,0,0,0,,Сіз мұны жақсы түсінбейсіз бе?
Dialogue: 0,0:03:23.77,0:03:28.57,Default,,0,0,0,,Жоқ, СС-тен басқа ешкім білмейтін сияқты.
Dialogue: 0,0:03:28.87,0:03:30.24,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:03:30.51,0:03:33.27,Default,,0,0,0,,Мен сені Лелуш деп атай аламын ба?
Dialogue: 0,0:03:33.37,0:03:36.84,Default,,0,0,0,,Алдыңғы мен жазбаларға сәйкес өлі деп айтылады.
Dialogue: 0,0:03:37.31,0:03:40.58,Default,,0,0,0,,Лелуш Ламперуж, ол қазір өзін осылай атайды.
Dialogue: 0,0:03:40.68,0:03:41.85,Default,,0,0,0,,Иә
Dialogue: 0,0:03:42.25,0:03:44.92,Default,,0,0,0,,Әскери трибуналмен не болды? ―
Dialogue: 0,0:03:45.25,0:03:46.89,Default,,0,0,0,,Сонымен қатар, мен осында тіркелдім.
Dialogue: 0,0:03:47.26,0:03:51.43,Default,,0,0,0,,Мен де Лелуштың сонда болғанына таң қалдым.
Dialogue: 0,0:03:51.53,0:03:56.36,Default,,0,0,0,,Тергеудің дұрыс жүргізілгеніне көз жеткізген адам болды.
Dialogue: 0,0:03:56.46,0:04:00.47,Default,,0,0,0,,Егер адам 17 жаста болса, мектепке бару керек.
Dialogue: 0,0:04:06.57,0:04:09.61,Default,,0,0,0,,Осының бәрін Хловис-сама салды ма?
Dialogue: 0,0:04:09.71,0:04:10.45,Default,,0,0,0,,Иә
Dialogue: 0,0:04:13.41,0:04:17.69,Default,,0,0,0,,Жұмсақ түстер... Бұл менің ағам еді.
Dialogue: 0,0:04:20.29,0:04:21.99,Default,,0,0,0,,Партизандарды әшкерелеуге қол жеткіздік.
Dialogue: 0,0:04:22.29,0:04:24.86,Default,,0,0,0,,Жарайды, жасырынатын жерді тап.
Dialogue: 0,0:04:24.96,0:04:26.53,Default,,0,0,0,,Губернаторға ақпарат жіберу
Dialogue: 0,0:04:26.63,0:04:27.86,Default,,0,0,0,,Иеміз Иса
Dialogue: 0,0:04:39.61,0:04:40.94,Default,,0,0,0,,Бұл (солдат) Корнелия болуы мүмкін бе?
Dialogue: 0,0:04:43.31,0:04:44.85,Default,,0,0,0,,Бұрынғы дәуірдің жәдігерлері
Dialogue: 0,0:04:59.66,0:05:01.30,Default,,0,0,0,,Далтон Бұл артқы жақта ма?
Dialogue: 0,0:05:01.40,0:05:03.73,Default,,0,0,0,,Иә, сізге қалай ұнайды? Біз де...
Dialogue: 0,0:05:04.00,0:05:05.63,Default,,0,0,0,,Бұл күш айырмашылығымен бұл қажет емес.
Dialogue: 0,0:05:05.73,0:05:06.97,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:05:09.00,0:05:11.64,Default,,0,0,0,,Беріңдер, ақымақ он бірлер.
Dialogue: 0,0:05:11.81,0:05:12.91,Default,,0,0,0,,Қалайы жігіт!
Dialogue: 0,0:05:15.91,0:05:17.75,Default,,0,0,0,,Нөл жоқ сияқты.
Dialogue: 0,0:05:18.35,0:05:21.68,Default,,0,0,0,,Бірінен соң бірін жаншып алсам да, мәселе ашылмайды. Хмм.
Dialogue: 0,0:05:21.88,0:05:24.55,Default,,0,0,0,,Осы жерде шіріп кетесің.
Dialogue: 0,0:05:27.49,0:05:29.09,Default,,0,0,0,,Мен үйдемін, аға.
Dialogue: 0,0:05:29.49,0:05:32.53,Default,,0,0,0,,Нуналли Сакийоко қош келдіңіз
Dialogue: 0,0:05:32.63,0:05:34.66,Default,,0,0,0,,Бүгін менің сендерге сыйлығым бар.
Dialogue: 0,0:05:34.76,0:05:36.43,Default,,0,0,0,,Бірдеңе
Dialogue: 0,0:05:36.90,0:05:37.80,Default,,0,0,0,,Иә
Dialogue: 0,0:05:40.44,0:05:41.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:01.99,0:06:02.96,Default,,0,0,0,,Ах-
Dialogue: 0,0:06:04.66,0:06:05.53,Default,,0,0,0,,Ах! ―
Dialogue: 0,0:06:08.10,0:06:09.03,Default,,0,0,0,,Осылайша...
Dialogue: 0,0:06:10.80,0:06:15.60,Default,,0,0,0,,Сенің аман қалғаныңа қуаныштымын.
Dialogue: 0,0:06:16.07,0:06:18.81,Default,,0,0,0,,Біраз уақыт өтті, Нунналли.
Dialogue: 0,0:06:19.84,0:06:20.71,Default,,0,0,0,,Созаку-сан
Dialogue: 0,0:06:20.81,0:06:22.44,Default,,0,0,0,,Бүгін түнеуге бола ма?
Dialogue: 0,0:06:22.81,0:06:25.45,Default,,0,0,0,,Созаку қазірдің өзінде осы мектептің оқушысы.
Dialogue: 0,0:06:25.55,0:06:27.42,Default,,0,0,0,,Сондықтан біз кез келген уақытта кездесе аламыз.
Dialogue: 0,0:06:27.52,0:06:28.58,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:06:28.68,0:06:32.39,Default,,0,0,0,,Менің әскери жұмысым бар, сондықтан мен оны күнде істей алмаймын.
Dialogue: 0,0:06:32.62,0:06:35.02,Default,,0,0,0,,Армия Сіз жалғастырасыз ба?
Dialogue: 0,0:06:35.42,0:06:38.79,Default,,0,0,0,,Жарайды, инженерлік бөлім мені басқа жерге ауыстырды.
Dialogue: 0,0:06:38.89,0:06:40.46,Default,,0,0,0,,Бұл соншалықты қауіпті емес.
Dialogue: 0,0:06:40.60,0:06:42.93,Default,,0,0,0,,Түсінемін, инженерлік бөлімі?
Dialogue: 0,0:06:44.57,0:06:45.73,Default,,0,0,0,,А, мен саған көмектесемін.
Dialogue: 0,0:06:46.43,0:06:50.51,Default,,0,0,0,,Отырыңыз. Жеті жыл бұрынғыдай емес, мен жүргізушімін.
Dialogue: 0,0:06:50.61,0:06:52.47,Default,,0,0,0,,Ұлы соғыс аяқталғаннан бері—
Dialogue: 0,0:06:52.71,0:06:55.51,Default,,0,0,0,,Сіз үнсіз қалдыңыз.
Dialogue: 0,0:06:55.74,0:06:57.41,Default,,0,0,0,,Сіз ысырап болдыңыз
Dialogue: 0,0:06:57.51,0:06:58.75,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:06:59.88,0:07:00.82,Default,,0,0,0,,Әй!
Dialogue: 0,0:07:01.88,0:07:03.42,Default,,0,0,0,,Мен саған бөлмеңде қал дедім.
Dialogue: 0,0:07:03.58,0:07:08.56,Default,,0,0,0,,) Бұл адам мен Синджукуда кездестірген британдық сарбаз болуы керек. Бұл жақсы ма?
Dialogue: 0,0:07:08.86,0:07:11.76,Default,,0,0,0,,Ол жақсы, бұл...
Dialogue: 0,0:07:12.19,0:07:13.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:13.59,0:07:16.00,Default,,0,0,0,,Достар... Не?
Dialogue: 0,0:07:17.47,0:07:18.97,Default,,0,0,0,,Шық, Еремия.
Dialogue: 0,0:07:19.07,0:07:20.20,Default,,0,0,0,,Лорд Гилдфорд-
Dialogue: 0,0:07:20.50,0:07:21.94,Default,,0,0,0,,Сіз түсінесіз деп үміттенемін.
Dialogue: 0,0:07:22.14,0:07:25.51,Default,,0,0,0,,Көтеріліске күдіктенетін болсақ, Оранж-күн.
Dialogue: 0,0:07:25.61,0:07:26.14,Default,,0,0,0,,Ах
Dialogue: 0,0:07:26.87,0:07:31.75,Default,,0,0,0,,Сондай-ақ, таза қандылар Нөлді сағынғандарыңыз бар.
Dialogue: 0,0:07:32.08,0:07:34.78,Default,,0,0,0,,Мен өз дәрежесін шамамен 3 сатыға төмендетуді шештім...
Dialogue: 0,0:07:34.88,0:07:36.98,Default,,0,0,0,,Сізде екі таңдау бар -
Dialogue: 0,0:07:37.08,0:07:41.02,Default,,0,0,0,,Бір ұшқышпен басынан бастаңыз немесе апельсин тоғайын өсіріңіз
Dialogue: 0,0:07:41.12,0:07:41.99,Default,,0,0,0,,Уау
Dialogue: 0,0:07:43.16,0:07:45.86,Default,,0,0,0,,Қайта кел, Нуналли де бақытты болады.
Dialogue: 0,0:07:45.96,0:07:48.73,Default,,0,0,0,,Иә, бірақ (Лелух) Иә?
Dialogue: 0,0:07:48.93,0:07:52.07,Default,,0,0,0,,Лелуш Мектепте бөтен болайық.
Dialogue: 0,0:07:52.50,0:07:53.20,Default,,0,0,0,,Өзіңді тым жоғары қоя бастадың.
Dialogue: 0,0:07:53.57,0:07:55.50,Default,,0,0,0,,Оны қалай түсіндіресіз?
Dialogue: 0,0:07:55.60,0:08:00.11,Default,,0,0,0,,Егер сіз құрметті британдықпен дос болсаңыз, олар сіздің жақсы емес екеніңізді анықтайды.
Dialogue: 0,0:08:00.21,0:08:01.81,Default,,0,0,0,,Сіздің ханзада болғаныңыз туралы
Dialogue: 0,0:08:01.91,0:08:02.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:03.18,0:08:06.88,Default,,0,0,0,,Дәл солай Нунеллиге де қатысты, бұдан былай балалар, сендерге кедергі болады...
Dialogue: 0,0:08:07.18,0:08:08.92,Default,,0,0,0,,Сіз өткен күні басқа біреудің ыңғайында болдыңыз...
Dialogue: 0,0:08:09.02,0:08:11.75,Default,,0,0,0,,Бұған дейін? (Лелуш) Жоқ.
Dialogue: 0,0:08:11.92,0:08:12.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:13.05,0:08:17.53,Default,,0,0,0,,Бүгінгі күн үшін рахмет. Бұл көңілді болды. Ертең кездескенше.
Dialogue: 0,0:08:17.66,0:08:18.66,Default,,0,0,0,,О
Dialogue: 0,0:08:19.06,0:08:20.73,Default,,0,0,0,,Мені бір нәрсе қуантады.
Dialogue: 0,0:08:20.83,0:08:21.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:21.93,0:08:25.67,Default,,0,0,0,,Өйткені мен мұндай нәрсені айтатын уақыт келеді деп ойламадым.
Dialogue: 0,0:08:32.81,0:08:35.98,Default,,0,0,0,,Эй, кеше саған бірдеңе болды ма?
Dialogue: 0,0:08:36.08,0:08:38.04,Default,,0,0,0,,Ол тіпті студенттік кеңеске де келмейді.
Dialogue: 0,0:08:38.21,0:08:40.25,Default,,0,0,0,,Дүниежүзілік тарихтан алған тестім нашар болды.
Dialogue: 0,0:08:40.55,0:08:43.12,Default,,0,0,0,,Әзірше...
Dialogue: 0,0:08:43.22,0:08:44.15,Default,,0,0,0,,Ах
Dialogue: 0,0:08:45.72,0:08:46.75,Default,,0,0,0,,Ах
Dialogue: 0,0:08:53.03,0:08:55.13,Default,,0,0,0,,) Әлі жаңалық жасамаса да...
Dialogue: 0,0:08:55.23,0:08:57.30,Default,,0,0,0,,«Самурай қанын» Корнелия басып тастады.
Dialogue: 0,0:08:58.53,0:09:01.30,Default,,0,0,0,,Бұл Чубудағы ең үлкен топ болса да, әп-сәтте...
Dialogue: 0,0:09:01.60,0:09:04.31,Default,,0,0,0,,Эй, нөл, осылай жалғастырсақ...
Dialogue: 0,0:09:04.64,0:09:06.61,Default,,0,0,0,,Асықпаңыз, мүмкіндікті күтіңіз
Dialogue: 0,0:09:06.71,0:09:07.61,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:09:07.71,0:09:09.78,Default,,0,0,0,,Келесі жолы мен сізге хабарласамын.
Dialogue: 0,0:09:09.91,0:09:10.78,Default,,0,0,0,,(Қоңырауды аяқтау дыбысы)
Dialogue: 0,0:09:10.88,0:09:13.55,Default,,0,0,0,,Хмф, бұл таныс жігіт.
Dialogue: 0,0:09:13.65,0:09:15.78,Default,,0,0,0,,Бұл аймақ кесілген жоқ.
Dialogue: 0,0:09:15.88,0:09:16.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:23.02,0:09:24.29,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:30.20,0:09:31.67,Default,,0,0,0,,Нина? (Нина Эйнштейн) Ха
Dialogue: 0,0:09:32.00,0:09:33.63,Default,,0,0,0,,Кешіріңіз, тым қатты болды ма?
Dialogue: 0,0:09:33.73,0:09:36.77,Default,,0,0,0,,Жоқ, бұл жақсы, бірақ мектеп ше?
Dialogue: 0,0:09:36.87,0:09:37.94,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:38.04,0:09:38.97,Default,,0,0,0,,Не?
Dialogue: 0,0:09:39.07,0:09:43.31,Default,,0,0,0,,Бұл қорқынышты (Нанелли) Сіз қорқасыз ба?
Dialogue: 0,0:09:43.74,0:09:46.18,Default,,0,0,0,,Менің сыныбыма ауысқан студент келді.
Dialogue: 0,0:09:46.28,0:09:49.25,Default,,0,0,0,,Князь Хловистің өліміне күдікті болған адам.
Dialogue: 0,0:09:49.35,0:09:50.65,Default,,0,0,0,,Қазір он бір.
Dialogue: 0,0:09:50.79,0:09:52.02,Default,,0,0,0,,Ах
Dialogue: 0,0:09:58.06,0:10:01.00,Default,,0,0,0,,Аа, әдеттегідей рахмет.
Dialogue: 0,0:10:01.10,0:10:03.30,Default,,0,0,0,,Ақшаны алу үшін есеп ер адамның атында.
Dialogue: 0,0:10:03.60,0:10:04.70,Default,,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,0:10:12.97,0:10:15.64,Default,,0,0,0,,Иә? Бұл маска жасырылған жер бе?
Dialogue: 0,0:10:15.81,0:10:19.81,Default,,0,0,0,,Геасстен айырмашылығы, бұл заттай дәлелдеме береді.
Dialogue: 0,0:10:19.81,0:10:20.08,Default,,0,0,0,,Геасстен айырмашылығы, бұл заттай дәлелдеме береді.
Dialogue: 0,0:10:20.82,0:10:21.32,Default,,0,0,0,,Әй!
Dialogue: 0,0:10:22.18,0:10:28.12,Default,,0,0,0,,Ағай, мен шай қойдым. О? Бұл иіс тағы да пицца ма?
Dialogue: 0,0:10:28.66,0:10:32.23,Default,,0,0,0,,Мен ұпай жинап жатырмын, жақында төменге түсемін.
Dialogue: 0,0:10:32.33,0:10:34.06,Default,,0,0,0,,Аға? (Лелух) Иә?
Dialogue: 0,0:10:34.66,0:10:37.10,Default,,0,0,0,,Соңғы кездері өзіңізді немқұрайлы сезінген жоқсыз ба? ―
Dialogue: 0,0:10:37.20,0:10:38.90,Default,,0,0,0,,Жоғарғы қолдар және т.б.
Dialogue: 0,0:10:39.07,0:10:40.70,Default,,0,0,0,,Оны ешқашан ұстамаңыз!
Dialogue: 0,0:10:40.80,0:10:41.97,Default,,0,0,0,,Бұл қорқынышты
Dialogue: 0,0:10:42.07,0:10:42.97,Default,,0,0,0,,Аха…
Dialogue: 0,0:10:43.07,0:10:45.01,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:45.84,0:10:47.24,Default,,0,0,0,,Ах
Dialogue: 0,0:10:53.88,0:10:56.12,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:10:56.98,0:11:01.26,Default,,0,0,0,,Иә, мен күткенім осы болды.
Dialogue: 0,0:11:01.36,0:11:03.32,Default,,0,0,0,,Созаку-сан қиын болып жатыр...
Dialogue: 0,0:11:03.42,0:11:05.09,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:11:05.29,0:11:09.36,Default,,0,0,0,,А... мұндай нәрселер уақытты алады.
Dialogue: 0,0:11:09.83,0:11:13.00,Default,,0,0,0,,Біз бұл туралы бірдеңе істей алмаймыз ба?Сіз дос болуыңыз керек
Dialogue: 0,0:11:13.10,0:11:13.97,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:15.34,0:11:16.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:18.41,0:11:19.44,Default,,0,0,0,,(Мысықтың мияулауы)
Dialogue: 0,0:11:19.87,0:11:21.34,Default,,0,0,0,,Уау (Нуннальды) Иә?
Dialogue: 0,0:11:23.38,0:11:25.21,Default,,0,0,0,,Жүр, қайтар!
Dialogue: 0,0:11:25.68,0:11:27.68,Default,,0,0,0,,Жақсы
Dialogue: 0,0:11:28.15,0:11:31.82,Default,,0,0,0,,(Мысықтың мияулауы)
Dialogue: 0,0:11:31.92,0:11:33.19,Default,,0,0,0,,Ах-
Dialogue: 0,0:11:33.29,0:11:38.19,Default,,0,0,0,,Бұл мысыққа әзіл емес.
Dialogue: 0,0:11:38.43,0:11:41.06,Default,,0,0,0,,Мен соншалықты ақымақ нәрсе үшін табылғаныма шыдай алмаймын.
Dialogue: 0,0:11:42.23,0:11:42.96,Default,,0,0,0,,Иә? ―
Dialogue: 0,0:11:43.40,0:11:44.47,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:11:44.90,0:11:48.70,Default,,0,0,0,,Жоқ, мен оған тиіскен жоқпын. Иә.
Dialogue: 0,0:11:54.74,0:11:56.21,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:11:56.31,0:11:59.35,Default,,0,0,0,,Маңызды нәрсені мысық алып кеткен сияқты.
Dialogue: 0,0:11:59.45,0:12:00.92,Default,,0,0,0,,Не маңызды?
Dialogue: 0,0:12:01.02,0:12:02.82,Default,,0,0,0,,Мен шынымен түсінбеймін.
Dialogue: 0,0:12:02.92,0:12:05.95,Default,,0,0,0,,Бірақ бұл өте маңызды нәрсе болуы керек.
Dialogue: 0,0:12:06.05,0:12:09.32,Default,,0,0,0,,Сенің ағаңның даусы сондай сабырлы болғандықтан.
Dialogue: 0,0:12:09.42,0:12:11.06,Default,,0,0,0,,Бірінші рет естігенім
Dialogue: 0,0:12:11.29,0:12:13.83,Default,,0,0,0,,Не? Лелуш үшін не маңызды?
Dialogue: 0,0:12:13.93,0:12:15.26,Default,,0,0,0,,Ах... махаббат хаты
Dialogue: 0,0:12:15.36,0:12:16.93,Default,,0,0,0,,Ұят фотолар
Dialogue: 0,0:12:17.23,0:12:18.30,Default,,0,0,0,,Өлең дәптері
Dialogue: 0,0:12:18.47,0:12:20.20,Default,,0,0,0,,Өлең? (Миллай қарсыласы) Гуфуфу
Dialogue: 0,0:12:20.30,0:12:21.74,Default,,0,0,0,,Маған қалдырыңыз~
Dialogue: 0,0:12:21.84,0:12:26.11,Default,,0,0,0,,Мен оны Лелуштан бұрын міндетті түрде қайтарамын, сондықтан алдымен!
Dialogue: 0,0:12:28.04,0:12:30.74,Default,,0,0,0,,Иә, осындай уақытта террористер болса...
Dialogue: 0,0:12:30.85,0:12:32.51,Default,,0,0,0,,Біз қоршау операцияларын жүргізе алатын болсақ та.
Dialogue: 0,0:12:32.81,0:12:33.78,Default,,0,0,0,,Карен
Dialogue: 0,0:12:33.91,0:12:36.92,Default,,0,0,0,,Жоқ, бұл жақсы емес. Оған күмәндануға бұдан артық негіз жоқ.
Dialogue: 0,0:12:37.42,0:12:38.49,Default,,0,0,0,,Уау! ―
Dialogue: 0,0:12:38.79,0:12:41.29,Default,,0,0,0,,Ааа...
Dialogue: 0,0:12:43.42,0:12:46.49,Default,,0,0,0,,Уф, бұл жиіркенішті.
Dialogue: 0,0:12:47.06,0:12:49.16,Default,,0,0,0,,Сондықтан мен айттым.
Dialogue: 0,0:12:49.26,0:12:50.50,Default,,0,0,0,,Иә, солай ма?
Dialogue: 0,0:12:50.80,0:12:52.17,Default,,0,0,0,,Олай болса, барасың.
Dialogue: 0,0:12:52.33,0:12:54.44,Default,,0,0,0,,Иә? (Оқушы) Не? бұл мысық
Dialogue: 0,0:12:54.54,0:12:57.17,Default,,0,0,0,,Бұл маска емес пе? Нөл
Dialogue: 0,0:12:57.27,0:12:58.94,Default,,0,0,0,,Мен мұндай жерде болады деп ешқашан күтпедім...
Dialogue: 0,0:12:59.07,0:13:00.01,Default,,0,0,0,,Ах
Dialogue: 0,0:13:00.51,0:13:01.54,Default,,0,0,0,,Қараңдар! (Оқушы) А?
Dialogue: 0,0:13:01.91,0:13:03.84,Default,,0,0,0,,Оны ұмыт! Жаңа көргенім
Dialogue: 0,0:13:07.48,0:13:09.22,Default,,0,0,0,,Иә, түсінемін.
Dialogue: 0,0:13:09.32,0:13:10.22,Default,,0,0,0,,Жарайды
Dialogue: 0,0:13:11.49,0:13:14.46,Default,,0,0,0,,Бұл Миллей Эшфорд, студенттік кеңестің президенті.
Dialogue: 0,0:13:14.56,0:13:15.79,Default,,0,0,0,,Бұл мысық! Бұл мысық!
Dialogue: 0,0:13:15.89,0:13:17.19,Default,,0,0,0,,А, мысық?
Dialogue: 0,0:13:17.83,0:13:20.36,Default,,0,0,0,,Мектептен қашып бара жатқан мысықты ұстаңыз
Dialogue: 0,0:13:20.46,0:13:24.57,Default,,0,0,0,,Клуб қызметі уақытша тоқтатылады. Ынтымақтастық жасаған клубтар өз бюджеттерінен жеңілдіктер алады.
Dialogue: 0,0:13:24.97,0:13:27.00,Default,,0,0,0,,Ал мысықты ұстаған адамға...
Dialogue: 0,0:13:27.10,0:13:29.00,Default,,0,0,0,,Өте сәтті мүмкіндік
Dialogue: 0,0:13:29.10,0:13:31.31,Default,,0,0,0,,Студенттік кеңес мүшелерінің сүйісу сыйы.
Dialogue: 0,0:13:31.41,0:13:32.81,Default,,0,0,0,,Сәлем! Уау, аа-
Dialogue: 0,0:13:32.94,0:13:34.54,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:32.94,0:13:34.54,Default,,0,0,0,,(Миллейдің күлкісі)
Dialogue: 0,0:13:34.54,0:13:36.08,Default,,0,0,0,,(Мирайдың күлуі)
Dialogue: 0,0:13:36.51,0:13:38.51,Default,,0,0,0,,Студенттік кеңес, мен де?
Dialogue: 0,0:13:38.91,0:13:40.45,Default,,0,0,0,,Дұрыс! Уф!
Dialogue: 0,0:13:40.85,0:13:42.28,Default,,0,0,0,,Ол студенттік кеңеске қатысады.
Dialogue: 0,0:13:42.38,0:13:43.98,Default,,0,0,0,,Ханымның ерні
Dialogue: 0,0:13:44.08,0:13:46.32,Default,,0,0,0,,Бұл щекке немесе басқаларға қатысты емес.
Dialogue: 0,0:13:46.42,0:13:48.16,Default,,0,0,0,,Жоқ, бұл жағдайда сіз тек щекке қолыңызды тигізе аласыз.
Dialogue: 0,0:13:48.26,0:13:50.16,Default,,0,0,0,,Е, мен орынды көрсетемін бе? ―
Dialogue: 0,0:13:50.26,0:13:51.19,Default,,0,0,0,,(Изуку) Ка… Качан! Бұл емтиханда мұғалім жаман кейіпкер рөлін сомдап отыр,
Dialogue: 0,0:13:51.33,0:13:52.19,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:52.29,0:13:53.26,Default,,0,0,0,,Жарайсыңдар! ―
Dialogue: 0,0:13:53.36,0:13:55.00,Default,,0,0,0,,Оны табыңыз!
Dialogue: 0,0:13:56.83,0:13:59.07,Default,,0,0,0,,Тоқта, бұл менің бірінші рет.
Dialogue: 0,0:13:59.53,0:14:01.04,Default,,0,0,0,,Студенттер кеңесінің мүшесі болу деген нені білдіреді?
Dialogue: 0,0:14:01.14,0:14:02.97,Default,,0,0,0,,Лелуш, сен де жақсысың ба? (Оқушылар) Кя~
Dialogue: 0,0:14:03.07,0:14:04.57,Default,,0,0,0,,Маған Милле ұнайды.
Dialogue: 0,0:14:04.87,0:14:06.07,Default,,0,0,0,,А... (Оқушы) Мынадай жерде...
Dialogue: 0,0:14:06.17,0:14:07.27,Default,,0,0,0,,Шықпа
Dialogue: 0,0:14:07.37,0:14:09.31,Default,,0,0,0,,Жекпе-жек!
Dialogue: 0,0:14:09.51,0:14:11.38,Default,,0,0,0,,Ұтқырлық жағынан бұл жақсырақ.
Dialogue: 0,0:14:12.45,0:14:13.91,Default,,0,0,0,,Мататабиді іздеңіз
Dialogue: 0,0:14:14.01,0:14:15.15,Default,,0,0,0,,Ғылым жеңеді
Dialogue: 0,0:14:15.25,0:14:18.19,Default,,0,0,0,,Мысық! Егер мен мысық ұстасам, мен оның иесімін ...
Dialogue: 0,0:14:18.29,0:14:20.55,Default,,0,0,0,,Оны маған беріңіз...
Dialogue: 0,0:14:20.86,0:14:23.46,Default,,0,0,0,,Иә, төраға, қажетсіз нәрселер.
Dialogue: 0,0:14:23.56,0:14:27.26,Default,,0,0,0,,Адамдарды сыйлық ретінде алу, сондықтан оны Британия деп атайды.
Dialogue: 0,0:14:27.36,0:14:28.50,Default,,0,0,0,,Уф! Ах!
Dialogue: 0,0:14:28.60,0:14:29.56,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:14:29.86,0:14:31.53,Default,,0,0,0,,Шынымен, шынымен таңқаларлық, солай ма?
Dialogue: 0,0:14:31.63,0:14:34.03,Default,,0,0,0,,Мен бұған сене алмаймын
Dialogue: 0,0:14:34.30,0:14:37.27,Default,,0,0,0,,Олар мені ауыртпаса немесе ауыртпаса екен!
Dialogue: 0,0:14:37.57,0:14:38.87,Default,,0,0,0,,Апарып бара жатып тайып кеттім
Dialogue: 0,0:14:39.21,0:14:41.34,Default,,0,0,0,,Бұл үшін кешіріңіз... күрсініңіз...
Dialogue: 0,0:14:42.18,0:14:44.48,Default,,0,0,0,,Сен кімге ұқсайсың, Ширли?
Dialogue: 0,0:14:44.58,0:14:47.92,Default,,0,0,0,,Өйткені біздің сүйіспеншілікке қауіп төніп тұр.
Dialogue: 0,0:14:48.02,0:14:49.88,Default,,0,0,0,,Ах... Мен келісемін.
Dialogue: 0,0:14:50.05,0:14:53.49,Default,,0,0,0,,Nunnally: Сізде ерекше мінездер жоқ па?мысықтық
Dialogue: 0,0:14:53.59,0:14:59.39,Default,,0,0,0,,Менің аяғым нашар деп ойлаймын, өйткені аяқ дыбыстары сәл оғаш естілді.
Dialogue: 0,0:14:59.59,0:15:04.47,Default,,0,0,0,,Ал, мына мысық осылай мияулайды...
Dialogue: 0,0:15:05.40,0:15:06.67,Default,,0,0,0,,Тағы да оралып келдім
Dialogue: 0,0:15:06.97,0:15:08.57,Default,,0,0,0,,Олар жай ғана кішігірім адамдар.
Dialogue: 0,0:15:09.00,0:15:13.51,Default,,0,0,0,,Жоқтаса да алаңсыз мектеп.
Dialogue: 0,0:15:13.61,0:15:15.44,Default,,0,0,0,,Жақсысың ба, Сузаку-кун?
Dialogue: 0,0:15:15.61,0:15:18.18,Default,,0,0,0,,Одан гөрі осы университет
Dialogue: 0,0:15:18.28,0:15:20.45,Default,,0,0,0,,Әй, мен сізге оқиғаны айтып бердім.
Dialogue: 0,0:15:20.55,0:15:21.38,Default,,0,0,0,,Иә-
Dialogue: 0,0:15:21.48,0:15:24.99,Default,,0,0,0,,Мен Ланселотты қуып шыққан жоқпын.
Dialogue: 0,0:15:25.09,0:15:28.69,Default,,0,0,0,,Дұрыс, олар сандарды түкке тұрғысыз деп айтса да.
Dialogue: 0,0:15:29.12,0:15:30.02,Default,,0,0,0,,О, күте тұрыңыз!
Dialogue: 0,0:15:31.63,0:15:35.70,Default,,0,0,0,,Әй, біз, студенттік кеңес оны ұстасақ та, жалақы аламыз, солай ма?
Dialogue: 0,0:15:36.70,0:15:39.23,Default,,0,0,0,,Поцелу туралы не деуге болады? Әрине!
Dialogue: 0,0:15:39.33,0:15:40.07,Default,,0,0,0,,Бұрын… пышақ еді.
Dialogue: 0,0:15:41.10,0:15:44.31,Default,,0,0,0,,Оны анда-санда қолданып көргіңіз келе ме? Шын айтасың ба?
Dialogue: 0,0:15:48.11,0:15:50.24,Default,,0,0,0,,Жүр, мектеп аумағына жүгірейік.
Dialogue: 0,0:15:50.34,0:15:52.35,Default,,0,0,0,,(Мысықтың мияулауы)
Dialogue: 0,0:15:54.11,0:15:58.22,Default,,0,0,0,,Енді біздің сүйіспеншілік қауіпсіз, Ширли, артқа кетші.
Dialogue: 0,0:16:00.19,0:16:00.72,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:16:01.59,0:16:02.46,Default,,0,0,0,,Не?
Dialogue: 0,0:16:02.56,0:16:06.23,Default,,0,0,0,,Ей, Карен сүйу құқығын кім пайдаланады?
Dialogue: 0,0:16:06.33,0:16:07.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:07.26,0:16:08.43,Default,,0,0,0,,Мүмкін Лулу?
Dialogue: 0,0:16:08.53,0:16:10.63,Default,,0,0,0,,Неліктен бұл болып жатыр?
Dialogue: 0,0:16:11.03,0:16:14.10,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:16:18.17,0:16:19.71,Default,,0,0,0,,Бұл... Ах!
Dialogue: 0,0:16:21.98,0:16:23.58,Default,,0,0,0,,Ах! (Лелух) Ах! Сузаку!
Dialogue: 0,0:16:24.01,0:16:26.51,Default,,0,0,0,,Лелуч, сенің де мысық бар ма?
Dialogue: 0,0:16:26.61,0:16:29.32,Default,,0,0,0,,Ах
Dialogue: 0,0:16:29.42,0:16:30.32,Default,,0,0,0,,Жоғарыда ма?
Dialogue: 0,0:16:30.42,0:16:31.99,Default,,0,0,0,,Күте тұр, Созаку.
Dialogue: 0,0:16:33.02,0:16:33.72,Default,,0,0,0,,Сен үйге бара бер!
Dialogue: 0,0:16:34.15,0:16:36.19,Default,,0,0,0,,Бірақ студенттік кеңестің президенті маған оны ұстауымды айтты.
Dialogue: 0,0:16:36.42,0:16:38.29,Default,,0,0,0,,Жарайды, үйге қайт. Мен мысықпын.
Dialogue: 0,0:16:38.39,0:16:40.56,Default,,0,0,0,,Мен денемді қимылдатқанда жақсымын.
Dialogue: 0,0:16:40.66,0:16:42.20,Default,,0,0,0,,Бұрын да кішкентай құс қашып кеткенде
Dialogue: 0,0:16:42.30,0:16:44.10,Default,,0,0,0,,Ескі әңгімелерді қозғамаңыз
Dialogue: 0,0:16:44.20,0:16:45.73,Default,,0,0,0,,Тек 7 жыл бұрын
Dialogue: 0,0:16:46.03,0:16:51.24,Default,,0,0,0,,Жарайды... Мен әлі күнге дейін физикалық күшім туралы ақымақпын.
Dialogue: 0,0:16:53.31,0:16:54.71,Default,,0,0,0,,Сіз мені бұрышқа түсіргеніңізге сенімдісіз бе? ―
Dialogue: 0,0:16:55.08,0:16:56.48,Default,,0,0,0,,Оны кім тапты?
Dialogue: 0,0:16:56.58,0:16:57.28,Default,,0,0,0,,Онда!
Dialogue: 0,0:17:00.18,0:17:01.12,Default,,0,0,0,,Сузаку-кун
Dialogue: 0,0:17:01.32,0:17:03.42,Default,,0,0,0,,Жарайды, мен қорықпаймын.
Dialogue: 0,0:17:03.52,0:17:04.52,Default,,0,0,0,,Созаку, жүр!
Dialogue: 0,0:17:04.75,0:17:06.55,Default,,0,0,0,,Жарайды, маған қалдырыңыз.
Dialogue: 0,0:17:08.76,0:17:12.49,Default,,0,0,0,,Ол бұрын индивидуалды болған.
Dialogue: 0,0:17:12.59,0:17:13.66,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:17:14.06,0:17:16.03,Default,,0,0,0,,Ах! ааа-
Dialogue: 0,0:17:16.20,0:17:17.03,Default,,0,0,0,,Лелуш!
Dialogue: 0,0:17:18.06,0:17:18.56,Default,,0,0,0,,Құт
Dialogue: 0,0:17:20.73,0:17:21.44,Default,,0,0,0,,Ах
Dialogue: 0,0:17:21.57,0:17:23.27,Default,,0,0,0,,Ах кутсу
Dialogue: 0,0:17:23.37,0:17:25.34,Default,,0,0,0,,Жақсысың ба?лелуш
Dialogue: 0,0:17:25.44,0:17:27.04,Default,,0,0,0,,Ах, оо
Dialogue: 0,0:17:27.34,0:17:29.28,Default,,0,0,0,,Сол екеуі...
Dialogue: 0,0:17:29.48,0:17:30.61,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:31.08,0:17:32.08,Default,,0,0,0,,О
Dialogue: 0,0:17:32.31,0:17:33.18,Default,,0,0,0,,Ах
Dialogue: 0,0:17:36.75,0:17:38.09,Default,,0,0,0,,Га
Dialogue: 0,0:17:38.19,0:17:41.09,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:17:41.19,0:17:42.72,Default,,0,0,0,,Аа... Ах.
Dialogue: 0,0:17:43.76,0:17:46.29,Default,,0,0,0,,Сіз тым қауіпсіз сезінесіз.
Dialogue: 0,0:17:46.39,0:17:48.80,Default,,0,0,0,,Әйтеуір күш-қуатымды жоғалттым.
Dialogue: 0,0:17:49.10,0:17:50.30,Default,,0,0,0,,(От-шағал жәндігінің дыбысы)
Dialogue: 0,0:17:50.40,0:17:51.67,Default,,0,0,0,,(Хироко) Һм? О…
Dialogue: 0,0:17:51.77,0:17:54.84,Default,,0,0,0,,Трансфер студенті Лелучты шымшудан құтқарды.
Dialogue: 0,0:17:55.17,0:17:57.37,Default,,0,0,0,,Ах, оо
Dialogue: 0,0:17:58.11,0:18:00.51,Default,,0,0,0,,Бұрынғы мысық па еді?
Dialogue: 0,0:18:02.48,0:18:03.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:05.11,0:18:06.11,Default,,0,0,0,,Ах
Dialogue: 0,0:18:08.65,0:18:09.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:11.22,0:18:12.19,Default,,0,0,0,,Уау
Dialogue: 0,0:18:12.55,0:18:14.82,Default,,0,0,0,,Лулуға көмектескеніңіз үшін рахмет.
Dialogue: 0,0:18:15.12,0:18:16.69,Default,,0,0,0,,Яружан трансфер студенті
Dialogue: 0,0:18:16.86,0:18:19.13,Default,,0,0,0,,Бұл мысықта бірдеңе болды, солай ма?
Dialogue: 0,0:18:19.23,0:18:23.56,Default,,0,0,0,,Ол бірдеңе киген сияқты болды, бірақ мен оны анық көре алмадым.
Dialogue: 0,0:18:23.66,0:18:25.43,Default,,0,0,0,,Мен білмей тұрып, ол жоғалып кетті.
Dialogue: 0,0:18:25.53,0:18:26.57,Default,,0,0,0,,Эй, Лулу ше?
Dialogue: 0,0:18:26.67,0:18:27.60,Default,,0,0,0,,Ах, оо
Dialogue: 0,0:18:27.70,0:18:29.87,Default,,0,0,0,,Мен бір нәрсені ұмытып қалдым, сондықтан алдымен барыңыз.
Dialogue: 0,0:18:30.17,0:18:33.37,Default,,0,0,0,,Міне! Оның ұят құпиясы (Ширли) Иә?
Dialogue: 0,0:18:33.47,0:18:35.21,Default,,0,0,0,,Солай ма, төраға?
Dialogue: 0,0:18:35.31,0:18:35.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:38.21,0:18:41.88,Default,,0,0,0,,А, мен сенің әлсіздігіңді түсінемін деп ойладым~
Dialogue: 0,0:18:42.18,0:18:44.18,Default,,0,0,0,,Өйткені Лулу керемет
Dialogue: 0,0:18:45.15,0:18:46.12,Default,,0,0,0,,Иә
Dialogue: 0,0:18:48.19,0:18:51.29,Default,,0,0,0,,Эй, екеуің бір-біріңді танисыңдар ма? (2 адам) Ах!
Dialogue: 0,0:18:51.43,0:18:53.33,Default,,0,0,0,,Өйткені... он бірмен
Dialogue: 0,0:18:53.43,0:18:54.46,Default,,0,0,0,,Ах
Dialogue: 0,0:18:57.13,0:18:58.47,Default,,0,0,0,,Жоқ, мен...
Dialogue: 0,0:18:58.57,0:18:59.67,Default,,0,0,0,,Біз доспыз, иә?
Dialogue: 0,0:19:00.47,0:19:03.57,Default,,0,0,0,,Президент, осы жігітті студенттер кеңесінің құрамына енгізе аласыз ба?
Dialogue: 0,0:19:03.67,0:19:04.51,Default,,0,0,0,,Не!
Dialogue: 0,0:19:04.61,0:19:05.77,Default,,0,0,0,,Менің мектебім
Dialogue: 0,0:19:05.87,0:19:09.91,Default,,0,0,0,,Бір жерде клубқа кіру керек, бірақ...
Dialogue: 0,0:19:10.31,0:19:11.48,Default,,0,0,0,,Хмм.
Dialogue: 0,0:19:13.75,0:19:16.72,Default,,0,0,0,,Мен вице-президенттің өтініші бойынша ештеңе істей алмаймын.
Dialogue: 0,0:19:17.18,0:19:17.85,Default,,0,0,0,,Уау
Dialogue: 0,0:19:18.45,0:19:22.46,Default,,0,0,0,,Енді мәселе шешілді, екеуің де тыңдаңдар.
Dialogue: 0,0:19:22.79,0:19:23.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:29.46,0:19:30.60,Default,,0,0,0,,Эхх (2 адам) Ах.
Dialogue: 0,0:19:30.70,0:19:31.90,Default,,0,0,0,,Нуннал?
Dialogue: 0,0:19:32.33,0:19:34.77,Default,,0,0,0,,Бұл Миллей уәде еткен сый.
Dialogue: 0,0:19:34.87,0:19:39.84,Default,,0,0,0,,Бұл екеуміз ғана, сондықтан менің жарты адам болғаныма шыдаңыз.
Dialogue: 0,0:19:40.21,0:19:44.91,Default,,0,0,0,,Жарайды, бұл мысықты ұстау мерекесі. Әрине, бұл жаңадан келгендер үшін қуаныш.
Dialogue: 0,0:19:45.21,0:19:46.75,Default,,0,0,0,,Таруна!
Dialogue: 0,0:19:46.88,0:19:48.78,Default,,0,0,0,,Мен Шерлимін, танысқаныма қуаныштымын.
Dialogue: 0,0:19:48.88,0:19:50.38,Default,,0,0,0,,А, мен қарсыласпын
Dialogue: 0,0:19:50.48,0:19:52.69,Default,,0,0,0,,Студенттік кеңестің президенті Миллей Эшфорд
Dialogue: 0,0:19:54.86,0:19:55.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:56.19,0:19:57.46,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:20:19.91,0:20:22.28,Default,,0,0,0,,Қасиетті Британ империясы
Dialogue: 0,0:20:22.38,0:20:26.75,Default,,0,0,0,,Мәртебелі 98-ші император Евицтің сөздері
Dialogue: 0,0:20:30.29,0:20:31.36,Default,,0,0,0,,Аһ!
Dialogue: 0,0:20:31.56,0:20:34.70,Default,,0,0,0,,Адамдар тең емес
Dialogue: 0,0:20:35.50,0:20:39.40,Default,,0,0,0,,Жылдам туылған, әдемі
Dialogue: 0,0:20:39.50,0:20:44.30,Default,,0,0,0,,Ата-анасы кедей, денесі ауырғандар
Dialogue: 0,0:20:44.40,0:20:50.54,Default,,0,0,0,,Барлық адамдар туылуы, тәрбиесі, таланты жағынан әр түрлі.
Dialogue: 0,0:20:50.94,0:20:55.32,Default,,0,0,0,,Иә, адамдарды кемсітуге арналған.
Dialogue: 0,0:20:55.42,0:21:00.69,Default,,0,0,0,,Сондықтан адамдар күресіп, жарысады, прогрестің туатын жері.
Dialogue: 0,0:21:01.36,0:21:04.36,Default,,0,0,0,,Теңсіздік жаман нәрсе емес.
Dialogue: 0,0:21:04.46,0:21:05.89,Default,,0,0,0,,Теңдік – жамандық.
Dialogue: 0,0:21:06.83,0:21:09.83,Default,,0,0,0,,Құқықтарды тең еткен ЕО ше? ―
Dialogue: 0,0:21:10.43,0:21:13.57,Default,,0,0,0,,Ол халықтық саясатқа түсті.
Dialogue: 0,0:21:13.70,0:21:17.90,Default,,0,0,0,,Байлықты тең еткен Қытай Федерациясы жалқауларға толы.
Dialogue: 0,0:21:18.97,0:21:22.34,Default,,0,0,0,,Бірақ менің Британиям ондай емес.
Dialogue: 0,0:21:22.44,0:21:26.45,Default,,0,0,0,,Конфликт, бәсеке, үнемі дамып отыратын
Dialogue: 0,0:21:26.58,0:21:29.38,Default,,0,0,0,,Эволюция - жақсы сөз.
Dialogue: 0,0:21:29.58,0:21:34.89,Default,,0,0,0,,Тек Британия ғана алға, болашаққа қарай жылжиды.
Dialogue: 0,0:21:34.99,0:21:37.49,Default,,0,0,0,,Менің ұлым Хловистің де өлімі...
Dialogue: 0,0:21:37.82,0:21:41.60,Default,,0,0,0,,Британияның дамуын жалғастыруының дәлелі.
Dialogue: 0,0:21:42.53,0:21:44.03,Default,,0,0,0,,Ұрыс!
Dialogue: 0,0:21:44.33,0:21:50.90,Default,,0,0,0,,Бәсекелесу, ұрлау, иемдену және үстемдік етудің соңында болашақ бар!
Dialogue: 0,0:21:51.00,0:21:53.94,Default,,0,0,0,,Сәлем Британия!
Dialogue: 0,0:21:54.34,0:21:56.64,Default,,0,0,0,,Баршаңызға сәлем Британия! ―
Dialogue: 0,0:21:56.74,0:21:58.71,Default,,0,0,0,,Сәлем Британия! ―
Dialogue: 0,0:21:58.81,0:22:00.95,Default,,0,0,0,,Сәлем Британия! ―
Dialogue: 0,0:22:01.05,0:22:03.05,Default,,0,0,0,,Сәлем Британия! ―
Dialogue: 0,0:22:03.35,0:22:05.55,Default,,0,0,0,,Сәлем Британия! ―
Dialogue: 0,0:22:05.65,0:22:07.69,Default,,0,0,0,,Сәлем Британия! ―
Dialogue: 0,0:22:07.79,0:22:09.92,Default,,0,0,0,,Сәлем Британия!
Dialogue: 0,0:22:10.02,0:22:12.46,Default,,0,0,0,,Лелуштың жауы...?
Dialogue: 0,0:22:12.56,0:22:14.70,Default,,0,0,0,,Сәлем Британия! ―
Dialogue: 0,0:22:14.80,0:22:17.63,Default,,0,0,0,,Сәлем Британия!
Dialogue: 0,0:22:17.73,0:22:21.40,Default,,0,0,0,,♪～
Dialogue: 0,0:22:21.50,0:22:25.04,Default,,0,0,0,,♪Мен жаяу жүрмін, бірақ мен арыстан мен жолбарыстың арылдаған жолмен жүріп келемін
Dialogue: 0,0:22:25.34,0:22:28.91,Default,,0,0,0,,♪Қызыл аспанның арғы жағында, Махороба
Dialogue: 0,0:22:29.01,0:22:32.71,Default,,0,0,0,,♪Тұтқынның оңашалығында қаңғыған жас
Dialogue: 0,0:22:32.81,0:22:36.55,Default,,0,0,0,,♪Әлсіздік пен ашу көзге көрінбейтін жау ма?
Dialogue: 0,0:22:36.65,0:22:42.02,Default,,0,0,0,,♪Әке, мен өзімді әлі білмеймін.
Dialogue: 0,0:22:44.06,0:22:48.10,Default,,0,0,0,,♪Алдыңғы ағайындар
Dialogue: 0,0:22:48.40,0:22:51.80,Default,,0,0,0,,♪Көзге көрінбейтін артқа ерсең
Dialogue: 0,0:22:51.90,0:22:58.87,Default,,0,0,0,,♪Таң жұлдызы сізді адасқан түнге шақырады
Dialogue: 0,0:22:59.54,0:23:02.98,Default,,0,0,0,,♪Өліммен бітпейді
Dialogue: 0,0:23:03.08,0:23:06.78,Default,,0,0,0,,♪Арманға ұмтылсам да
Dialogue: 0,0:23:06.88,0:23:10.62,Default,,0,0,0,,♪Сіз сенімдісіз
Dialogue: 0,0:23:10.72,0:23:14.59,Default,,0,0,0,,♪Менің өмірім
Dialogue: 0,0:23:14.69,0:23:18.49,Default,,0,0,0,,♪Қатты жел айдалада, Көбелектер мен гүлдермен өмір сүремін.
Dialogue: 0,0:23:18.59,0:23:22.16,Default,,0,0,0,,♪Мәңгілік көктемде гүлдеген дәмді елес
Dialogue: 0,0:23:22.46,0:23:26.00,Default,,0,0,0,,♪Бұл дененің лас болса да лайдың тазалығы
Dialogue: 0,0:23:26.10,0:23:29.87,Default,,0,0,0,,♪Жүрегіңіздің сырына сеніңізші
Dialogue: 0,0:23:29.97,0:23:35.58,Default,,0,0,0,,♪Анашым, көз жасымды көрсетпесем де.
Dialogue: 0,0:23:35.74,0:23:40.41,Default,,0,0,0,,♪Аяғымның астындағы шөпте
Dialogue: 0,0:23:40.51,0:23:45.85,Default,,0,0,0,,♪Шық жоғалады
Dialogue: 0,0:23:49.16,0:23:51.59,Default,,0,0,0,,Болымсыздықтың өзі де жылы.
Dialogue: 0,0:23:51.73,0:23:53.06,Default,,0,0,0,,Менің әкем... ол кісі...
Dialogue: 0,0:23:53.16,0:23:55.73,Default,,0,0,0,,Егер ол Британияның символы болса, ол жойылғанша...
Dialogue: 0,0:23:55.86,0:23:57.50,Default,,0,0,0,,Сол сапарда апа...
Dialogue: 0,0:23:57.60,0:23:59.47,Default,,0,0,0,,Корнелия осында болса, дәл солай.
Dialogue: 0,0:23:59.90,0:24:01.54,Default,,0,0,0,,Сіз әлі білмесеңіз де...
Dialogue: 0,0:24:01.87,0:24:03.74,Default,,0,0,0,,Менің күшім бар.
Dialogue: 0,0:24:04.00,0:24:07.84,Default,,0,0,0,,Менде Геасс болғанша, мен жалғыз боламын!
