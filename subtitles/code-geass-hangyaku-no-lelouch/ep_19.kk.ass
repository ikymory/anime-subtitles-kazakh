Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.40,0:00:10.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:11.71,0:00:13.34,Default,,0,0,0,,Ланселот…
Dialogue: 0,0:00:18.41,0:00:20.25,Default,,0,0,0,,А, нөл!
Dialogue: 0,0:00:22.45,0:00:25.05,Default,,0,0,0,,Жоқ, мен ештеңе есімде жоқ.
Dialogue: 0,0:00:29.26,0:00:30.36,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:00:30.43,0:00:36.43,Default,,0,0,0,,♪～
Dialogue: 0,0:00:38.33,0:00:42.17,Default,,0,0,0,,♪Мен армандаған арман
Dialogue: 0,0:00:42.27,0:00:46.07,Default,,0,0,0,,♪Шексіз және алыс
Dialogue: 0,0:00:46.17,0:00:52.51,Default,,0,0,0,,♪Құрғақ күндерде көк аспан, Қолымда
Dialogue: 0,0:00:54.12,0:00:57.59,Default,,0,0,0,,♪Дыбыстағы біркелкі сынау және қателік
Dialogue: 0,0:00:57.69,0:01:03.09,Default,,0,0,0,,♪Уақытсыз немесе интервалсыз кеңістік
Dialogue: 0,0:01:04.56,0:01:06.80,Default,,0,0,0,,♪Өмірлік өлшем шу шығарады
Dialogue: 0,0:01:07.10,0:01:09.63,Default,,0,0,0,,♪Мен өз бетімді жасаймын
Dialogue: 0,0:01:09.73,0:01:13.17,Default,,0,0,0,,♪ Тек бір жағын тазалаңыз
Dialogue: 0,0:01:13.74,0:01:17.64,Default,,0,0,0,,♪Менің қолыма түсті
Dialogue: 0,0:01:17.74,0:01:21.51,Default,,0,0,0,,♪Шіріген алма
Dialogue: 0,0:01:21.61,0:01:25.55,Default,,0,0,0,,♪Айнада бейнеленген
Dialogue: 0,0:01:25.65,0:01:29.52,Default,,0,0,0,,♪Біздің арғы жағымызға
Dialogue: 0,0:01:29.62,0:01:33.32,Default,,0,0,0,,♪Дистанциялық сезім Адамдар арасындағы сынақ пен қателік
Dialogue: 0,0:01:33.42,0:01:38.49,Default,,0,0,0,,♪Уақытсыз және сезімсіз кеңістік
Dialogue: 0,0:01:40.23,0:01:42.50,Default,,0,0,0,,♪Бас пен дене тырнақтарын жоғары көтеріп тұру
Dialogue: 0,0:01:42.60,0:01:45.43,Default,,0,0,0,,♪Бетімді қырып алайын деп жатырмын
Dialogue: 0,0:01:45.53,0:01:51.24,Default,,0,0,0,,♪ Тек бір жағын тазалаңыз
Dialogue: 0,0:01:52.74,0:01:59.75,Default,,0,0,0,,♪-Қашықтық сезімі
Dialogue: 0,0:02:10.39,0:02:13.33,Default,,0,0,0,,Бұл басқа арал ма?
Dialogue: 0,0:02:13.39,0:02:16.70,Default,,0,0,0,,Өсімдіктер мен температура Шикинедзимамен бірдей.
Dialogue: 0,0:02:16.80,0:02:18.50,Default,,0,0,0,,Бұл өте алыс арал емес.
Dialogue: 0,0:02:18.77,0:02:21.57,Default,,0,0,0,,Мен табысымнан айырылдым, сондықтан менде байланыс жоқ.
Dialogue: 0,0:02:21.67,0:02:23.44,Default,,0,0,0,,Алдымен су көзін бекітіңіз.
Dialogue: 0,0:02:23.54,0:02:26.24,Default,,0,0,0,,Мен бивуак жасай аламын ба?
Dialogue: 0,0:02:27.64,0:02:28.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:29.91,0:02:32.28,Default,,0,0,0,,Карен? Амал жоқ...-
Dialogue: 0,0:02:32.38,0:02:33.45,Default,,0,0,0,,Ум...
Dialogue: 0,0:02:34.48,0:02:35.68,Default,,0,0,0,,Сузаку?
Dialogue: 0,0:02:35.78,0:02:37.15,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:38.52,0:02:41.26,Default,,0,0,0,,Ах! Бұл киімдер Қара рыцарьларға тиесілі...
Dialogue: 0,0:02:42.22,0:02:43.22,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:43.32,0:02:44.83,Default,,0,0,0,,Бұл шынымен сен бе?
Dialogue: 0,0:02:44.89,0:02:46.33,Default,,0,0,0,,Уф
Dialogue: 0,0:02:47.20,0:02:48.33,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:48.40,0:02:49.26,Default,,0,0,0,,Уау! ―
Dialogue: 0,0:02:49.36,0:02:50.27,Default,,0,0,0,,Ой! ―
Dialogue: 0,0:02:50.37,0:02:51.37,Default,,0,0,0,,Уф! ―
Dialogue: 0,0:02:51.47,0:02:52.33,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:52.40,0:02:53.33,Default,,0,0,0,,Карен!
Dialogue: 0,0:02:53.43,0:02:55.40,Default,,0,0,0,,Карен Штадтфельдт Сіз...
Dialogue: 0,0:02:55.47,0:02:56.94,Default,,0,0,0,,Мені олай атама!
Dialogue: 0,0:02:57.24,0:02:59.54,Default,,0,0,0,,Мен Карен Акацукимін, мен жапонмын!
Dialogue: 0,0:02:59.61,0:03:01.58,Default,,0,0,0,,Ах! Сонда шынымен бе?
Dialogue: 0,0:03:01.68,0:03:04.91,Default,,0,0,0,,Мен Қара Рыцарьмын, енді оны жасырайын деген ойым жоқ.
Dialogue: 0,0:03:05.21,0:03:08.38,Default,,0,0,0,,Сонымен, Карен Акацуки, мен сені ұстаймын.
Dialogue: 0,0:03:08.48,0:03:11.22,Default,,0,0,0,,Бұл айып Британияға опасыздық жасады.
Dialogue: 0,0:03:11.49,0:03:12.59,Default,,0,0,0,,Цк
Dialogue: 0,0:03:12.75,0:03:15.59,Default,,0,0,0,,Оугимен және басқалармен байланысу қиын.
Dialogue: 0,0:03:15.69,0:03:18.33,Default,,0,0,0,,Бірақ қарапайым адам болып көріну...
Dialogue: 0,0:03:18.43,0:03:20.70,Default,,0,0,0,,Британ армиясынан көмек сұрасам да...
Dialogue: 0,0:03:20.80,0:03:21.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:25.33,0:03:26.57,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:03:26.67,0:03:28.94,Default,,0,0,0,,Тіпті сіз не болғанын білмейсіз.
Dialogue: 0,0:03:29.24,0:03:31.54,Default,,0,0,0,,Мен білмей тұрып, осы аралда мені су шайып кетті.
Dialogue: 0,0:03:31.64,0:03:32.57,Default,,0,0,0,,Солай емес пе?
Dialogue: 0,0:03:32.67,0:03:34.94,Default,,0,0,0,,Әй, сен де кеме апатқа ұшырадың.
Dialogue: 0,0:03:35.24,0:03:35.94,Default,,0,0,0,,Жақсы сезінеді.
Dialogue: 0,0:03:36.58,0:03:40.25,Default,,0,0,0,,Егер менің достарым келсе, сен тұтқынға түсесің.
Dialogue: 0,0:03:40.35,0:03:41.68,Default,,0,0,0,,Нөл көмекке келсе ше?
Dialogue: 0,0:03:41.78,0:03:42.75,Default,,0,0,0,,Міндетті түрде.
Dialogue: 0,0:03:42.82,0:03:45.55,Default,,0,0,0,,Одан бұрын мен сізге бір нәрсе айтайын.
Dialogue: 0,0:03:45.65,0:03:46.75,Default,,0,0,0,,Нөлдің шынайы тұлғасы
Dialogue: 0,0:03:47.66,0:03:49.52,Default,,0,0,0,,Неге оны өзіңіз тексермеске?
Dialogue: 0,0:03:49.62,0:03:51.79,Default,,0,0,0,,Түсінемін, сен де білмейсің.
Dialogue: 0,0:03:51.89,0:03:53.56,Default,,0,0,0,,А... неге?
Dialogue: 0,0:03:53.90,0:03:56.23,Default,,0,0,0,,Сіз оны ұстадыңыз ба?
Dialogue: 0,0:03:56.33,0:03:58.37,Default,,0,0,0,,Өзіңіздің шынайы болмысыңызды жасырғаннан жақсы.
Dialogue: 0,0:03:59.00,0:04:00.97,Default,,0,0,0,,Неліктен Нөлге еріп жүрсіз?
Dialogue: 0,0:04:01.27,0:04:03.50,Default,,0,0,0,,Келіңіздер, неге бұл туралы өзіңіз ойламайсыз?
Dialogue: 0,0:04:08.81,0:04:09.68,Default,,0,0,0,,Лелуш
Dialogue: 0,0:04:09.74,0:04:10.85,Default,,0,0,0,,Уф!
Dialogue: 0,0:04:10.95,0:04:12.28,Default,,0,0,0,,Бұл Лелуч, солай ма?
Dialogue: 0,0:04:12.51,0:04:13.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:13.48,0:04:15.32,Default,,0,0,0,,Мен ешкімге айтқан жоқпын
Dialogue: 0,0:04:15.42,0:04:16.72,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:04:16.82,0:04:20.59,Default,,0,0,0,,Сондықтан мені атпас бұрын, тым болмаса...
Dialogue: 0,0:04:22.92,0:04:23.96,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:33.00,0:04:33.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:38.74,0:04:40.34,Default,,0,0,0,,Лелуш
Dialogue: 0,0:04:48.05,0:04:49.62,Default,,0,0,0,,Ғарыштық радарлар тобы –
Dialogue: 0,0:04:49.72,0:04:51.39,Default,,0,0,0,,D бөлімінен F бөліміне өту.
Dialogue: 0,0:04:51.49,0:04:52.42,Default,,0,0,0,,Тыныш интервал...
Dialogue: 0,0:04:52.52,0:04:53.92,Default,,0,0,0,,Іздеу! Не болса да -
Dialogue: 0,0:04:54.02,0:04:55.92,Default,,0,0,0,,Эфемия-саманы табыңыз!
Dialogue: 0,0:04:58.06,0:05:02.33,Default,,0,0,0,,Бұл жай ғана лейтенант-губернаторға арналған әшекей болса, ол вице-губернаторға ұқсайтын болса, бұл жақсы.
Dialogue: 0,0:05:02.46,0:05:05.83,Default,,0,0,0,,Корнелияның құлағына осындай нәрсе келсе...
Dialogue: 0,0:05:07.94,0:05:12.31,Default,,0,0,0,,Мен оның жүзбелі дирижабль екеніне сене алар емеспін.
Dialogue: 0,0:05:12.37,0:05:13.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:13.34,0:05:14.98,Default,,0,0,0,,Практикалық қолдану деректер жиналғаннан кейін келеді.
Dialogue: 0,0:05:15.08,0:05:16.54,Default,,0,0,0,,Сен мұны айтпадың ба?
Dialogue: 0,0:05:16.71,0:05:17.81,Default,,0,0,0,,Сіз не жасайсыз
Dialogue: 0,0:05:17.91,0:05:21.88,Default,,0,0,0,,Барлығының қызық болғаны сонша, мен оны жүзеге асырғым келеді.
Dialogue: 0,0:05:21.98,0:05:23.52,Default,,0,0,0,,Ал адрон зеңбірегі?
Dialogue: 0,0:05:23.62,0:05:25.72,Default,,0,0,0,,Алдымен сынап көру керек.
Dialogue: 0,0:05:26.02,0:05:29.02,Default,,0,0,0,,Мен сізбен бір рет кездескім келді, Сесил Крами мырза.
Dialogue: 0,0:05:29.32,0:05:31.46,Default,,0,0,0,,Мен... Мәртебелі Шнайзел!
Dialogue: 0,0:05:31.53,0:05:32.59,Default,,0,0,0,,Ендеше, мен де саған сенемін
Dialogue: 0,0:05:32.69,0:05:35.36,Default,,0,0,0,,Мәртебелі Екінші Ханзадаға төмен қарау дөрекі болар еді!
Dialogue: 0,0:05:35.63,0:05:37.90,Default,,0,0,0,,Генерал Батли! аа!
Dialogue: 0,0:05:38.53,0:05:41.40,Default,,0,0,0,,О? Ittata...
Dialogue: 0,0:05:41.74,0:05:42.64,Default,,0,0,0,,Сіз жарақат алдыңыз ба?
Dialogue: 0,0:05:42.74,0:05:43.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:43.67,0:05:46.37,Default,,0,0,0,,Бұл Шнайзел Эль-Британия.
Dialogue: 0,0:05:46.47,0:05:47.98,Default,,0,0,0,,Маған қолыңызды беріңізші.
Dialogue: 0,0:05:48.04,0:05:50.68,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:05:50.75,0:05:52.48,Default,,0,0,0,,Тым... ысырап
Dialogue: 0,0:05:52.58,0:05:55.58,Default,,0,0,0,,Сіз өте адалсыз, генерал.
Dialogue: 0,0:05:55.68,0:05:59.79,Default,,0,0,0,,Бастапқыда мені қазірге дейін Тамбл аралында терең жер астында шынжырмен байлау керек еді.
Dialogue: 0,0:05:59.89,0:06:01.59,Default,,0,0,0,,Ол мені құтқарды.
Dialogue: 0,0:06:01.96,0:06:04.69,Default,,0,0,0,,Сіз соншалықты қатал болмайсыз ба?
Dialogue: 0,0:06:04.79,0:06:08.56,Default,,0,0,0,,Бұл істің барлығы сізге, сонымен қатар Хловистің арқасы.
Dialogue: 0,0:06:08.66,0:06:10.36,Default,,0,0,0,,Мен рахмет айту керек адаммын
Dialogue: 0,0:06:10.47,0:06:11.77,Default,,0,0,0,,Мен... мырзам
Dialogue: 0,0:06:11.87,0:06:13.50,Default,,0,0,0,,Батле -
Dialogue: 0,0:06:13.80,0:06:16.74,Default,,0,0,0,,Енді, Мисс Сесил, кешіріңіз... Мәртебелі.
Dialogue: 0,0:06:18.14,0:06:20.07,Default,,0,0,0,,Ал, сіз базада күтіңіз.
Dialogue: 0,0:06:20.48,0:06:21.74,Default,,0,0,0,,Иә?Қай жолмен?
Dialogue: 0,0:06:21.84,0:06:22.84,Default,,0,0,0,,Ногуё-
Dialogue: 0,0:06:22.94,0:06:26.61,Default,,0,0,0,,Мен де осы Авалоннан Сузаку-кунды іздеймін...
Dialogue: 0,0:06:26.68,0:06:28.78,Default,,0,0,0,,Өйткені ол алу қиын Девайзер...
Dialogue: 0,0:06:28.88,0:06:30.95,Default,,0,0,0,,Әсіресе оның кешегідей өнер көрсеткенін көргенде.
Dialogue: 0,0:06:31.02,0:06:34.49,Default,,0,0,0,,Ах! Күте тұрыңыз, жоғары мәртебелі кеше бұйрық берді ме?
Dialogue: 0,0:06:34.69,0:06:38.09,Default,,0,0,0,,Ұстаңыз. Одан артық нәрсе - бұл керемет.
Dialogue: 0,0:06:38.39,0:06:41.43,Default,,0,0,0,,Бұл мен, Сесиль және адрон зеңбірегі.
Dialogue: 0,0:06:42.16,0:06:45.80,Default,,0,0,0,,Бұл жағдайда біз ұмытпауымыз керек нәрсе - басымдықтар.
Dialogue: 0,0:06:45.90,0:06:49.77,Default,,0,0,0,,Ал егер тәртіпсіздік орын алса, оны құтқару мүмкіндігі болды.
Dialogue: 0,0:06:49.87,0:06:51.41,Default,,0,0,0,,Мен бұған бәс тігемін.
Dialogue: 0,0:06:51.51,0:06:54.78,Default,,0,0,0,,Юффидің сері және арнайы миссияның маңызды ұшқышы.
Dialogue: 0,0:06:54.88,0:06:55.98,Default,,0,0,0,,Сузаку Куруругиге
Dialogue: 0,0:06:56.04,0:06:58.71,Default,,0,0,0,,А... иә, түсінемін.
Dialogue: 0,0:06:58.81,0:07:02.12,Default,,0,0,0,,Дөрекілік үшін кешірім сұраймыз және тиісті жазаны аламыз.
Dialogue: 0,0:07:02.65,0:07:06.79,Default,,0,0,0,,Әйтеуір... Қол астындағыларды қорғай алмағаным кінәлі.
Dialogue: 0,0:07:06.92,0:07:08.66,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:12.93,0:07:14.66,Default,,0,0,0,,Сіз мұны қашан түсіндіңіз?
Dialogue: 0,0:07:14.76,0:07:16.16,Default,,0,0,0,,Қонақ үйді аулау кезінде
Dialogue: 0,0:07:16.46,0:07:17.70,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:07:17.80,0:07:19.83,Default,,0,0,0,,Сол кезде мен тым көп айтпай тұра алмадым.
Dialogue: 0,0:07:19.93,0:07:22.00,Default,,0,0,0,,Бірақ мен қазір ғана сенімді болдым.
Dialogue: 0,0:07:22.10,0:07:24.17,Default,,0,0,0,,Иә, бұл тәтті. Мен де.
Dialogue: 0,0:07:24.47,0:07:27.71,Default,,0,0,0,,Бірақ неге Корнелиямен кеңеспедің?
Dialogue: 0,0:07:27.81,0:07:30.75,Default,,0,0,0,,Әпкем менің не айтсам бәрібір...
Dialogue: 0,0:07:30.85,0:07:34.92,Default,,0,0,0,,Және одан да қайғылы
Dialogue: 0,0:07:36.62,0:07:38.82,Default,,0,0,0,,Нәресте... қалдарыңыз қалай?
Dialogue: 0,0:07:38.92,0:07:42.46,Default,,0,0,0,,Біз бірге тұрамыз, бірақ денеміз әлі де...
Dialogue: 0,0:07:42.56,0:07:43.96,Default,,0,0,0,,Сіз мені жек көресіз деп ойлаймын.
Dialogue: 0,0:07:46.76,0:07:48.53,Default,,0,0,0,,Маған бір нәрсе айтыңызшы.
Dialogue: 0,0:07:48.63,0:07:52.47,Default,,0,0,0,,Анаң өлтірілген оқиға туралы не айттың...
Dialogue: 0,0:07:52.80,0:07:54.47,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:54.77,0:07:57.94,Default,,0,0,0,,Бірақ сіздің апаңыз көп ізденіп жатқан сияқты.
Dialogue: 0,0:07:58.04,0:08:01.78,Default,,0,0,0,,Марианна-сама менің үлкен әпкемнің таңданысы болды.
Dialogue: 0,0:08:02.21,0:08:03.14,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:03.68,0:08:05.55,Default,,0,0,0,,Мен де сұрай аламын ба?
Dialogue: 0,0:08:05.65,0:08:06.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:07.52,0:08:09.88,Default,,0,0,0,,Сіз нөлсіз бе? ―
Dialogue: 0,0:08:10.62,0:08:12.05,Default,,0,0,0,,Ей! Польнареф!
Dialogue: 0,0:08:12.62,0:08:13.59,Default,,0,0,0,,Бұл Лелуш
Dialogue: 0,0:08:14.49,0:08:16.49,Default,,0,0,0,,А, мен қазір осындамын.
Dialogue: 0,0:08:16.59,0:08:19.26,Default,,0,0,0,,Бұл сіз білетін Лелуш, Юффи.
Dialogue: 0,0:08:20.60,0:08:23.00,Default,,0,0,0,,Лелуш... Лелуш
Dialogue: 0,0:08:25.67,0:08:26.53,Default,,0,0,0,,(Іштің ырылдаған дыбысы)
Dialogue: 0,0:08:26.70,0:08:27.64,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:28.50,0:08:31.01,Default,,0,0,0,,Өзімді жеңіл сезінгеннен кейін қарным ашылды.
Dialogue: 0,0:08:32.61,0:08:34.24,Default,,0,0,0,,Бұл шынымен жақсы ма?
Dialogue: 0,0:08:34.54,0:08:39.05,Default,,0,0,0,,Сынықтар мен аяқ іздерінен бұл жабайы табиғат ізі екенін айта аламыз.
Dialogue: 0,0:08:39.78,0:08:42.72,Default,,0,0,0,,Қарғыс атсын... Орта ғасырдан қалған тұзақ... Мм.
Dialogue: 0,0:08:42.82,0:08:45.62,Default,,0,0,0,,Біраз аранжировка қосуға мүмкіндік бар (Эфемия) Ах...
Dialogue: 0,0:08:47.15,0:08:48.66,Default,,0,0,0,,Ой
Dialogue: 0,0:08:48.72,0:08:51.29,Default,,0,0,0,,Эй, бұл дәмді.
Dialogue: 0,0:08:52.13,0:08:54.00,Default,,0,0,0,,Сіз де қолданып көргіңіз келе ме? ―
Dialogue: 0,0:08:54.10,0:08:57.53,Default,,0,0,0,,Егер бізге азық-түлік алуға көмектессең, мен сені шектеулеріңнен босатамын.
Dialogue: 0,0:08:57.63,0:08:58.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:58.60,0:09:00.77,Default,,0,0,0,,Мен сізді тыныштандыруға тырыссам да, оны пайдаланбаймын.
Dialogue: 0,0:09:00.87,0:09:02.27,Default,,0,0,0,,Бұл қыңыр.
Dialogue: 0,0:09:02.57,0:09:05.04,Default,,0,0,0,,Бұл менің мектепте оқып жүрген кезімнен мүлде басқаша.
Dialogue: 0,0:09:08.08,0:09:09.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:09.11,0:09:11.58,Default,,0,0,0,,Тіпті тұтқаны пайдалансаңыз да...
Dialogue: 0,0:09:11.68,0:09:13.11,Default,,0,0,0,,Мен де саған көмектесемін.
Dialogue: 0,0:09:13.18,0:09:14.12,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:09:14.58,0:09:17.65,Default,,0,0,0,,Мәртебелі ханшайым үшін... Дене еңбегі...
Dialogue: 0,0:09:17.75,0:09:18.62,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:09:18.72,0:09:20.69,Default,,0,0,0,,Жүйе… тамаша…
Dialogue: 0,0:09:20.79,0:09:22.19,Default,,0,0,0,,Ум...
Dialogue: 0,0:09:22.29,0:09:25.66,Default,,0,0,0,,Ал, мен барып жеміс-жидек тауып алайын.
Dialogue: 0,0:09:25.93,0:09:27.06,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:09:27.26,0:09:28.66,Default,,0,0,0,,Иә
Dialogue: 0,0:09:43.21,0:09:44.98,Default,,0,0,0,,Қарсыластың шайқасы өтті
Dialogue: 0,0:09:45.08,0:09:46.88,Default,,0,0,0,,) Аа... (Шиничиро Тамаширо) Таку-
Dialogue: 0,0:09:46.98,0:09:49.92,Default,,0,0,0,,Әуеде тоқтай алатын әскери кеме әзіл емес.
Dialogue: 0,0:09:50.02,0:09:53.09,Default,,0,0,0,,Бұл аймақта бұдан әрі қалу қауіпті.
Dialogue: 0,0:09:53.19,0:09:54.89,Default,,0,0,0,,Артқа бұрылайық (желдеткіш) Ах
Dialogue: 0,0:09:55.12,0:09:57.09,Default,,0,0,0,,Жоқ, осында қал.
Dialogue: 0,0:09:57.19,0:09:58.59,Default,,0,0,0,,Нөлді іздеу керек
Dialogue: 0,0:09:59.03,0:10:00.09,Default,,0,0,0,,Әрине
Dialogue: 0,0:10:00.19,0:10:02.83,Default,,0,0,0,,Бірақ біз тіпті іздеу тобын жібере алмайтын жағдайдамыз.
Dialogue: 0,0:10:03.30,0:10:06.03,Default,,0,0,0,,Ракшатаның арқасында жасырынып қалсам да...
Dialogue: 0,0:10:06.27,0:10:09.34,Default,,0,0,0,,Нөл немесе Карен әлі тірі екеніне кепілдік жоқ.
Dialogue: 0,0:10:09.64,0:10:11.97,Default,,0,0,0,,Бір қате қадам ұйымның өмір сүруіне әсер етуі мүмкін.
Dialogue: 0,0:10:12.07,0:10:13.27,Default,,0,0,0,,Сіз не айтасыз?
Dialogue: 0,0:10:13.77,0:10:16.78,Default,,0,0,0,,Бұл керісінше. Біз нөлге тең адамдармыз.
Dialogue: 0,0:10:16.88,0:10:19.08,Default,,0,0,0,,Тек Нөлмен ұйым болуы мүмкін.
Dialogue: 0,0:10:19.15,0:10:21.08,Default,,0,0,0,,Ұйым тек адамдар арқылы мүмкін болады.
Dialogue: 0,0:10:21.18,0:10:24.02,Default,,0,0,0,,Сіздің сөйлеу мәнеріңіз британдықтарға ұқсайды.
Dialogue: 0,0:10:24.22,0:10:25.89,Default,,0,0,0,,Ал... мен сенен бірнәрсе сұрайын деп едім...
Dialogue: 0,0:10:26.29,0:10:29.96,Default,,0,0,0,,Мұнда әртүрлі сенімдегі адамдар жиналған.
Dialogue: 0,0:10:30.06,0:10:31.63,Default,,0,0,0,,Бірақ тіпті иілуде де...
Dialogue: 0,0:10:31.73,0:10:34.20,Default,,0,0,0,,Неліктен топтастырылған? ―
Dialogue: 0,0:10:34.30,0:10:36.06,Default,,0,0,0,,Нәтижелер көрсетіп тұрғандықтан ба? ―
Dialogue: 0,0:10:36.16,0:10:39.33,Default,,0,0,0,,Ал нәтижелерді кім шығарады?
Dialogue: 0,0:10:40.13,0:10:41.40,Default,,0,0,0,,Нәтижелерді қабылдаймыз.
Dialogue: 0,0:10:41.70,0:10:44.37,Default,,0,0,0,,Бірақ... оны әркімнің өмірімен салыстыруға бола ма?
Dialogue: 0,0:10:44.64,0:10:47.98,Default,,0,0,0,,Кейде бір адамның өмірі миллиард адамнан маңыздырақ.
Dialogue: 0,0:10:48.08,0:10:50.21,Default,,0,0,0,,Бұл бұрынғы әскери қызметшілер үшін дұрыс түсінік болуы керек.
Dialogue: 0,0:10:50.28,0:10:51.35,Default,,0,0,0,,Сіз бұл жерде айтасыз ба?
Dialogue: 0,0:10:51.65,0:10:53.25,Default,,0,0,0,,Ой...
Dialogue: 0,0:10:53.35,0:10:56.08,Default,,0,0,0,,) Қолымнан келмейді, айтамын.
Dialogue: 0,0:10:56.18,0:10:57.65,Default,,0,0,0,,Ол тірі.
Dialogue: 0,0:10:57.75,0:10:59.05,Default,,0,0,0,,Тілектеріңді тыңдауға уақытым жоқ...
Dialogue: 0,0:10:59.15,0:11:01.72,Default,,0,0,0,,Бұл расталған ақпарат. Мен түссіндім.
Dialogue: 0,0:11:01.89,0:11:03.69,Default,,0,0,0,,Сен пайғамбарсың ба?
Dialogue: 0,0:11:03.79,0:11:06.16,Default,,0,0,0,,Мен саған оның орнына Nightmare жаттығуын айтпадым ба?
Dialogue: 0,0:11:06.26,0:11:07.16,Default,,0,0,0,,Бұл есік хо!
Dialogue: 0,0:11:07.36,0:11:08.23,Default,,0,0,0,,Есік үй? ―
Dialogue: 0,0:11:08.33,0:11:13.03,Default,,0,0,0,,Менімен бұлай сөйлескеніне біраз болды.
Dialogue: 0,0:11:13.13,0:11:15.90,Default,,0,0,0,,Не? Сіз нөлдің иесі болғандықтан бастық болсаңыз да
Dialogue: 0,0:11:15.97,0:11:19.84,Default,,0,0,0,,Мен жоқ дедім, солай ма?Ол тек дөрекі түрде ойлайтын адам.
Dialogue: 0,0:11:20.24,0:11:22.91,Default,,0,0,0,,Менің айтайын дегенім басшыларға!
Dialogue: 0,0:11:22.98,0:11:24.01,Default,,0,0,0,,Бір минут күтіңіз!
Dialogue: 0,0:11:24.11,0:11:25.85,Default,,0,0,0,,Бұл тақырыптан тыс!
Dialogue: 0,0:11:25.95,0:11:27.82,Default,,0,0,0,,Қалай болғанда да, мұны істейік
Dialogue: 0,0:11:27.92,0:11:31.29,Default,,0,0,0,,Britannia қауіпсіздік желісінің сыртында, қауіпсіз судың шетінде
Dialogue: 0,0:11:31.39,0:11:34.09,Default,,0,0,0,,Ертеңге дейін күту дегенді қалай түсінесіңдер?
Dialogue: 0,0:11:34.19,0:11:35.46,Default,,0,0,0,,Уақыт шегін орнатсаңыз
Dialogue: 0,0:11:36.86,0:11:37.73,Default,,0,0,0,,«Сенді ергеніме өкінемін».
Dialogue: 0,0:11:38.09,0:11:39.69,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:11:39.96,0:11:40.96,Default,,0,0,0,,Хмм.
Dialogue: 0,0:11:41.73,0:11:42.43,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:11:42.86,0:11:46.80,Default,,0,0,0,,Сіздің еркелігіңіздің кесірінен мен бір ер адаммен қызықсыз әңгіме айттым...
Dialogue: 0,0:11:48.10,0:11:50.37,Default,,0,0,0,,Тіпті Карен сол аралда ма?
Dialogue: 0,0:11:50.81,0:11:54.04,Default,,0,0,0,,Сіздің дәміңіз нашар. Сіз бақылаушы болып көрінесіз.
Dialogue: 0,0:12:01.25,0:12:03.22,Default,,0,0,0,,Не болды? Дәмді болса да
Dialogue: 0,0:12:03.72,0:12:04.72,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:06.19,0:12:09.29,Default,,0,0,0,,Мен мұны ертең Pitfall жасай аламын деп ойлаймын
Dialogue: 0,0:12:09.39,0:12:10.26,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:10.83,0:12:12.19,Default,,0,0,0,,А, мен тоқпын.
Dialogue: 0,0:12:12.83,0:12:13.89,Default,,0,0,0,,Мен тым көп жедім
Dialogue: 0,0:12:14.13,0:12:15.96,Default,,0,0,0,,Қазір шынымен де осы ма?
Dialogue: 0,0:12:16.16,0:12:17.83,Default,,0,0,0,,Иә, шағымыңыз бар ма?
Dialogue: 0,0:12:17.93,0:12:21.87,Default,,0,0,0,,Жоқ, бұл мектепте болғаннан әлдеқайда жанды және тартымды.
Dialogue: 0,0:12:21.97,0:12:23.34,Default,,0,0,0,,Ах... Хмм.
Dialogue: 0,0:12:25.51,0:12:28.24,Default,,0,0,0,,Карен, Рыцарларды қалдыр.
Dialogue: 0,0:12:29.74,0:12:31.15,Default,,0,0,0,,Қазір емес...
Dialogue: 0,0:12:32.05,0:12:34.45,Default,,0,0,0,,Ұсталған лаңкестердің тағдыры қайғылы.
Dialogue: 0,0:12:34.85,0:12:37.79,Default,,0,0,0,,Егер сіз оны өте жылы деп ойласаңыз, бұл шынымен де рас па?
Dialogue: 0,0:12:37.89,0:12:41.36,Default,,0,0,0,,Өкінішке орай, мен капитан Нөлдің күзетшісімін.
Dialogue: 0,0:12:41.46,0:12:43.32,Default,,0,0,0,,Мен де сенімен Nightmare ойынында соғыстым.
Dialogue: 0,0:12:43.86,0:12:44.93,Default,,0,0,0,,Мына қызыл?
Dialogue: 0,0:12:45.03,0:12:47.19,Default,,0,0,0,,Дұрыс, мен сені дұрыс емес жерден пышақтап алсам да...
Dialogue: 0,0:12:47.29,0:12:50.30,Default,,0,0,0,,Бір күні мен сенің Ақ дулығаңды өлтіріп, саған көрсетемін.
Dialogue: 0,0:12:50.40,0:12:53.40,Default,,0,0,0,,Ол жасағандай болашақ жоқ.
Dialogue: 0,0:12:53.87,0:12:55.30,Default,,0,0,0,,Сонда сіздің болашағыңыз ше?
Dialogue: 0,0:12:55.40,0:12:58.14,Default,,0,0,0,,Мекеменің иті болыңыз және аман қалыңыз
Dialogue: 0,0:12:58.54,0:13:01.84,Default,,0,0,0,,Құрметті британдық?Үшінші рыцарь ханшайымы?
Dialogue: 0,0:13:01.94,0:13:03.01,Default,,0,0,0,,Ha
Dialogue: 0,0:13:03.11,0:13:06.45,Default,,0,0,0,,Соңғы самурай Генбу Куруруги есімі мені жылатады!
Dialogue: 0,0:13:07.01,0:13:10.32,Default,,0,0,0,,Мен емес! Мен бұл қате әлемді өзгертемін
Dialogue: 0,0:13:10.42,0:13:11.92,Default,,0,0,0,,Әйтпесе...
Dialogue: 0,0:13:12.02,0:13:15.19,Default,,0,0,0,,Әйтпесе... ағамның қамқорлығы болмайды.
Dialogue: 0,0:13:15.29,0:13:16.52,Default,,0,0,0,,Сондықтан мен ұрысамын! ―
Dialogue: 0,0:13:17.26,0:13:19.79,Default,,0,0,0,,Мен жеңу үшін қолымнан келгеннің бәрін жасаймын!
Dialogue: 0,0:13:20.03,0:13:20.93,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:22.10,0:13:24.30,Default,,0,0,0,,Карен I...
Dialogue: 0,0:13:25.80,0:13:27.03,Default,,0,0,0,,Мен әкемді өлтірдім.
Dialogue: 0,0:13:27.10,0:13:28.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:28.44,0:13:30.17,Default,,0,0,0,,Менің әкем өз-өзіне қол жұмсамады.
Dialogue: 0,0:13:31.54,0:13:33.31,Default,,0,0,0,,Мен оны өлтірдім.
Dialogue: 0,0:13:34.07,0:13:34.98,Default,,0,0,0,,Осы қолдармен
Dialogue: 0,0:13:39.55,0:13:43.02,Default,,0,0,0,,Жұлдыздар өзгермейді, сол кездегідей қалады.
Dialogue: 0,0:13:45.35,0:13:48.56,Default,,0,0,0,,Сол жұлдызды аспанға бәріміз баяғыда қарағанбыз
Dialogue: 0,0:13:49.89,0:13:53.49,Default,,0,0,0,,Сол кездегі қалпымызда қалғанымыз қандай жақсы болар еді.
Dialogue: 0,0:13:56.20,0:13:57.43,Default,,0,0,0,,Қайту мүмкін емес пе?
Dialogue: 0,0:14:00.57,0:14:02.04,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:14:02.14,0:14:03.17,Default,,0,0,0,,Егер мен қайта оралсам...
Dialogue: 0,0:14:03.27,0:14:05.24,Default,,0,0,0,,Бұл қаншалықты жақсы болар еді?
Dialogue: 0,0:14:05.44,0:14:07.58,Default,,0,0,0,,Нөл менің әкем сияқты.
Dialogue: 0,0:14:07.88,0:14:11.28,Default,,0,0,0,,Әлем менің айналамда айналады деп есептеймін.
Dialogue: 0,0:14:11.38,0:14:14.01,Default,,0,0,0,,Сондықтан көптің қаны төгілетінін біліп...
Dialogue: 0,0:14:14.11,0:14:16.08,Default,,0,0,0,,Сонымен, сыйлықты қабылдайсыз ба? ―
Dialogue: 0,0:14:16.18,0:14:17.18,Default,,0,0,0,,Бейбітшілік деген осы ма?
Dialogue: 0,0:14:17.92,0:14:19.92,Default,,0,0,0,,Өмірден де маңызды нәрселер бар, солай ма?
Dialogue: 0,0:14:20.12,0:14:22.46,Default,,0,0,0,,Мен сізге бас тарту керек деп тұрған жоқпын.
Dialogue: 0,0:14:23.22,0:14:25.29,Default,,0,0,0,,Бірақ мен білемін
Dialogue: 0,0:14:25.39,0:14:29.00,Default,,0,0,0,,Дұрыс емес әрекеттің салдары қандай?
Dialogue: 0,0:14:29.30,0:14:32.27,Default,,0,0,0,,Барар жері жоқ тек бостық пен өкініш
Dialogue: 0,0:14:34.13,0:14:35.34,Default,,0,0,0,,Я...
Dialogue: 0,0:14:35.44,0:14:37.54,Default,,0,0,0,,Онда маған айт.
Dialogue: 0,0:14:37.97,0:14:40.01,Default,,0,0,0,,Ағаңның тірі болуының мәні неде?
Dialogue: 0,0:14:40.07,0:14:41.61,Default,,0,0,0,,Ах! Бұл дұрыс емес пе?
Dialogue: 0,0:14:41.91,0:14:43.21,Default,,0,0,0,,Бұл дұрыс па?
Dialogue: 0,0:14:43.31,0:14:45.15,Default,,0,0,0,,Кім шешеді?
Dialogue: 0,0:14:54.39,0:14:58.49,Default,,0,0,0,,Мен Юффимін... Өзімнің аман қалуым үшін...
Dialogue: 0,0:14:59.39,0:15:03.36,Default,,0,0,0,,Шіркін және күрескен, өмірдің мәнін іздеген.
Dialogue: 0,0:15:03.60,0:15:06.03,Default,,0,0,0,,Шіркін, мен...
Dialogue: 0,0:15:06.13,0:15:07.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:12.51,0:15:14.54,Default,,0,0,0,,Куруруги тірі болса...
Dialogue: 0,0:15:14.64,0:15:17.01,Default,,0,0,0,,Бұл Камин аралында шайып кетуі керек еді.
Dialogue: 0,0:15:17.11,0:15:19.18,Default,,0,0,0,,Біз ертең таңертең іздеу тобын жібереміз.
Dialogue: 0,0:15:19.45,0:15:21.68,Default,,0,0,0,,Иә, бұл мысал ма?
Dialogue: 0,0:15:21.98,0:15:24.95,Default,,0,0,0,,Иә, Шиндзюку оқиғасы қазба кезінде болды...
Dialogue: 0,0:15:25.05,0:15:25.92,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:26.52,0:15:29.96,Default,,0,0,0,,Менің ойымша, Хловис осындай нәрсеге лайық болды.
Dialogue: 0,0:15:39.03,0:15:42.07,Default,,0,0,0,,Эй, сен шынымен де сол жарықты көрдің бе?
Dialogue: 0,0:15:42.17,0:15:43.17,Default,,0,0,0,,О
Dialogue: 0,0:15:43.24,0:15:45.11,Default,,0,0,0,,Іздеу тобы шығар.
Dialogue: 0,0:15:45.21,0:15:47.21,Default,,0,0,0,,Келіңіздер, растап, содан кейін жауапты шешейік.
Dialogue: 0,0:15:47.68,0:15:48.94,Default,,0,0,0,,Корреспонденция…
Dialogue: 0,0:15:52.48,0:15:55.12,Default,,0,0,0,,Ойлау лифті...
Dialogue: 0,0:15:55.22,0:15:57.38,Default,,0,0,0,,Археология – менің мамандығым емес...
Dialogue: 0,0:15:57.48,0:15:59.32,Default,,0,0,0,,Әсіресе «супер» деп белгіленуі мүмкін...
Dialogue: 0,0:15:59.42,0:16:01.16,Default,,0,0,0,,Сен!Бұл дөрекі болар еді!
Dialogue: 0,0:16:01.26,0:16:04.73,Default,,0,0,0,,Бірақ, бұл менің мамандығымнан тым бөлек...
Dialogue: 0,0:16:05.03,0:16:07.26,Default,,0,0,0,,Егер солай болса, мен Сесил-куннан сұрауым керек еді.
Dialogue: 0,0:16:07.36,0:16:09.53,Default,,0,0,0,,Өтінемін, мені қатты жек көрме.
Dialogue: 0,0:16:09.63,0:16:12.47,Default,,0,0,0,,Сіздің әкеңіз де мұндай нәрсеге құмар сияқты.
Dialogue: 0,0:16:13.23,0:16:14.54,Default,,0,0,0,,Солай емес пе?шайқас
Dialogue: 0,0:16:14.64,0:16:18.41,Default,,0,0,0,,Иә, ұқсастары әлемнің бірнеше жерінен табылған...
Dialogue: 0,0:16:18.47,0:16:22.74,Default,,0,0,0,,Мен ашқан мына жерден басқаның бәрі Тенрио болып саналады.
Dialogue: 0,0:16:23.04,0:16:26.65,Default,,0,0,0,,Бұл болжам, бірақ әр елдің басып алу жоспарлары...
Dialogue: 0,0:16:26.75,0:16:30.12,Default,,0,0,0,,Осы тармақтарға сәйкес орындалып жатыр ма?
Dialogue: 0,0:16:30.18,0:16:33.15,Default,,0,0,0,,Ммм, осындай жасырын деректерді талдау...
Dialogue: 0,0:16:33.25,0:16:36.06,Default,,0,0,0,,Сіз Гавайнның друид жүйесін пайдаланасыз ба? ―
Dialogue: 0,0:16:36.16,0:16:38.33,Default,,0,0,0,,Әлі реттелмеген прототиптік машина...
Dialogue: 0,0:16:38.43,0:16:40.26,Default,,0,0,0,,Сондықтан мен сені шақырдым.
Dialogue: 0,0:16:40.33,0:16:41.30,Default,,0,0,0,,Ахха~
Dialogue: 0,0:16:45.37,0:16:47.37,Default,,0,0,0,,Менің ойымша, бұл осы жерде.
Dialogue: 0,0:16:47.47,0:16:48.47,Default,,0,0,0,,Лелуш
Dialogue: 0,0:16:48.57,0:16:51.37,Default,,0,0,0,,Егер іздеу тобы болса, бұл уақыт біте ме?
Dialogue: 0,0:16:52.21,0:16:53.24,Default,,0,0,0,,Мен бұған көмектесе алмаймын
Dialogue: 0,0:16:53.31,0:16:54.34,Default,,0,0,0,,Иә
Dialogue: 0,0:16:54.44,0:16:58.18,Default,,0,0,0,,Мұндай сенімсіз рыцарь менің серігім, тіпті тамақ емес.
Dialogue: 0,0:16:58.31,0:16:59.18,Default,,0,0,0,,Уау
Dialogue: 0,0:16:59.48,0:17:02.18,Default,,0,0,0,,Және Сузаку Куруруги
Dialogue: 0,0:17:02.28,0:17:05.02,Default,,0,0,0,,Сіздің нағыз рыцарыңыз да соған ұқсайды.
Dialogue: 0,0:17:05.12,0:17:06.19,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:06.35,0:17:09.79,Default,,0,0,0,,Мен сұрасам бола ма?Неліктен құрметті британдық?
Dialogue: 0,0:17:10.46,0:17:12.26,Default,,0,0,0,,Бұл... (шу)
Dialogue: 0,0:17:12.36,0:17:13.23,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:19.30,0:17:20.17,Default,,0,0,0,,Уф! ―
Dialogue: 0,0:17:20.27,0:17:21.47,Default,,0,0,0,,Неліктен бұл екеуі?
Dialogue: 0,0:17:22.04,0:17:23.67,Default,,0,0,0,,Созаку! сурет?
Dialogue: 0,0:17:23.77,0:17:25.04,Default,,0,0,0,,Құрметті Эфемия!
Dialogue: 0,0:17:25.10,0:17:27.64,Default,,0,0,0,,Қозғалмаңыз!ол менің тұтқыным
Dialogue: 0,0:17:28.11,0:17:28.78,Default,,0,0,0,,Басынан бастап осы тапаншамен атып тастауым керек еді! ➡
Dialogue: 0,0:17:29.18,0:17:31.38,Default,,0,0,0,,Мені осында тыңда (Эфемия) А...
Dialogue: 0,0:17:31.48,0:17:34.08,Default,,0,0,0,,Мен адамдарымды сонда қайтарамын...
Dialogue: 0,0:17:34.18,0:17:35.28,Default,,0,0,0,,Кепілмен алмасу
Dialogue: 0,0:17:35.35,0:17:36.82,Default,,0,0,0,,Сізге қайтадан нөл!
Dialogue: 0,0:17:37.08,0:17:38.49,Default,,0,0,0,,Жақын келме! ―
Dialogue: 0,0:17:38.82,0:17:41.36,Default,,0,0,0,,Хмм, бұл қорқақтық дейсіз бе? ―
Dialogue: 0,0:17:42.36,0:17:44.09,Default,,0,0,0,,Хехехе
Dialogue: 0,0:17:44.19,0:17:47.23,Default,,0,0,0,,Террористерді кез келген жағдайда жою.
Dialogue: 0,0:17:48.16,0:17:51.43,Default,,0,0,0,,Сіз де осы ережені ұстанып, Ұстазды тастап кетесіз бе? ―
Dialogue: 0,0:17:51.70,0:17:54.80,Default,,0,0,0,,Тіпті бұл ілім қазір бұзылған болса да.
Dialogue: 0,0:17:55.27,0:17:56.14,Default,,0,0,0,,Эй!
Dialogue: 0,0:17:56.20,0:17:57.57,Default,,0,0,0,,Ха!Тоқта!
Dialogue: 0,0:17:57.74,0:18:01.68,Default,,0,0,0,,Тыныш, қуыршақ ханшайым!Сіз жалғыз ештеңе істей алмайсыз!
Dialogue: 0,0:18:01.74,0:18:03.84,Default,,0,0,0,,Жоқ! Мәселе жоқ, Созаку! ―
Dialogue: 0,0:18:04.14,0:18:06.35,Default,,0,0,0,,Мен үшін алаңдамай күрес!
Dialogue: 0,0:18:06.45,0:18:07.31,Default,,0,0,0,,Мәртебелі ханшайым!
Dialogue: 0,0:18:07.38,0:18:09.15,Default,,0,0,0,,Қазір! (Эфемия) Уау!
Dialogue: 0,0:18:09.55,0:18:11.19,Default,,0,0,0,,Мына тас бас! ―
Dialogue: 0,0:18:12.35,0:18:13.75,Default,,0,0,0,,Не! а!
Dialogue: 0,0:18:13.85,0:18:14.72,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:16.66,0:18:18.53,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:18:22.33,0:18:23.70,Default,,0,0,0,,Уау~
Dialogue: 0,0:18:27.63,0:18:29.54,Default,,0,0,0,,Өтінемін... артқа тұрыңыз! Мырзам!
Dialogue: 0,0:18:34.31,0:18:36.44,Default,,0,0,0,,Майор Куруруги! Және мүмкін емес ...
Dialogue: 0,0:18:37.38,0:18:38.71,Default,,0,0,0,,Нөл! (Лелух) Қазір!
Dialogue: 0,0:18:39.85,0:18:41.12,Default,,0,0,0,,В... Идиот!
Dialogue: 0,0:18:41.22,0:18:42.48,Default,,0,0,0,,Лорд Эфемия да осында!
Dialogue: 0,0:18:42.58,0:18:44.15,Default,,0,0,0,,Оны қорғаңыз!Оны қорғаңыз!
Dialogue: 0,0:18:44.22,0:18:44.89,Default,,0,0,0,,Цк
Dialogue: 0,0:18:45.19,0:18:47.19,Default,,0,0,0,,Нөл!Қорқыныш сонда!
Dialogue: 0,0:18:47.29,0:18:49.39,Default,,0,0,0,,Жақсы! Мен мұны пайдалануым керек пе? Барайық!
Dialogue: 0,0:18:49.49,0:18:50.66,Default,,0,0,0,,Иә! Ах...
Dialogue: 0,0:18:50.86,0:18:52.23,Default,,0,0,0,,Созаку
Dialogue: 0,0:18:52.79,0:18:55.20,Default,,0,0,0,,Уау! Не! (Солдат) О!
Dialogue: 0,0:18:57.23,0:18:58.73,Default,,0,0,0,,Сузаку, не болды?
Dialogue: 0,0:19:00.67,0:19:01.57,Default,,0,0,0,,Рахмет-
Dialogue: 0,0:19:01.67,0:19:03.70,Default,,0,0,0,,Ол сондай-ақ қараусыз жерде іске қосылады.
Dialogue: 0,0:19:04.57,0:19:06.81,Default,,0,0,0,,Қабырға!Евфемия-саманың алдына қабырға қойыңыз!
Dialogue: 0,0:19:10.71,0:19:12.25,Default,,0,0,0,,Бұл түнгі түн деген не? ―
Dialogue: 0,0:19:12.35,0:19:15.38,Default,,0,0,0,,Хахаха мен твиттер жазып жатырмын Ах...
Dialogue: 0,0:19:17.58,0:19:19.29,Default,,0,0,0,,Шнайзел!
Dialogue: 0,0:19:19.45,0:19:21.36,Default,,0,0,0,,Ол... Нөл ме?
Dialogue: 0,0:19:21.59,0:19:23.69,Default,,0,0,0,,Ах!Гавайн...
Dialogue: 0,0:19:24.49,0:19:25.83,Default,,0,0,0,,Қайтарыңыз!
Dialogue: 0,0:19:25.93,0:19:28.66,Default,,0,0,0,,Бұл машинаны Zero сияқты біреуге бермеңіз!
Dialogue: 0,0:19:28.73,0:19:30.60,Default,,0,0,0,,Сәлем Шнайзел! ―
Dialogue: 0,0:19:30.70,0:19:31.57,Default,,0,0,0,,(Иида) Турбо Герой Ингениумды білесің бе?
Dialogue: 0,0:19:33.53,0:19:36.20,Default,,0,0,0,,Сазерленд шыға берісте! (Лелуш) Мені ұстаңыз!
Dialogue: 0,0:19:36.30,0:19:37.60,Default,,0,0,0,,Тек итеруді жалғастырыңыз! Иә?
Dialogue: 0,0:19:42.38,0:19:43.51,Default,,0,0,0,,Жоғал
Dialogue: 0,0:19:44.75,0:19:46.28,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:48.35,0:19:50.42,Default,,0,0,0,,Tsk, қару аяқталмаған!
Dialogue: 0,0:19:51.95,0:19:52.82,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:55.29,0:19:56.39,Default,,0,0,0,,Нөл!Жаңадан!
Dialogue: 0,0:19:57.49,0:20:00.29,Default,,0,0,0,,Уайымдамаңыз, екіншісі жұмыс істейді.
Dialogue: 0,0:20:03.83,0:20:05.30,Default,,0,0,0,,Ах! Ұшты ма? ―
Dialogue: 0,0:20:05.80,0:20:07.77,Default,,0,0,0,,Қорқыныш... аспан!
Dialogue: 0,0:20:07.83,0:20:10.50,Default,,0,0,0,,Хаха...
Dialogue: 0,0:20:13.27,0:20:15.64,Default,,0,0,0,,Гавайн... Біздің Гавайн...
Dialogue: 0,0:20:15.74,0:20:18.38,Default,,0,0,0,,Жақсы. Бұл тәжірибелік машина.
Dialogue: 0,0:20:18.48,0:20:20.61,Default,,0,0,0,,Оның орнына осы екеуінің қауіпсіздігін тойлайық.
Dialogue: 0,0:20:21.25,0:20:21.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:23.55,0:20:25.82,Default,,0,0,0,,Шнайзел аға
Dialogue: 0,0:20:25.89,0:20:28.46,Default,,0,0,0,,Юффи, кешігіп қалғаным үшін кешіріңіз.
Dialogue: 0,0:20:28.56,0:20:29.69,Default,,0,0,0,,Осындай бірдеңе...
Dialogue: 0,0:20:29.89,0:20:31.83,Default,,0,0,0,,Мәртебелі, жоспарлағандай.
Dialogue: 0,0:20:31.93,0:20:33.43,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:20:33.49,0:20:34.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:34.63,0:20:36.30,Default,,0,0,0,,Майор Сузаку Куруруги
Dialogue: 0,0:20:36.40,0:20:38.73,Default,,0,0,0,,Мен сізді әскери тәртіпті екінші дәрежелі бұзды деген күдікпен тұтқындаймын.
Dialogue: 0,0:20:38.83,0:20:40.47,Default,,0,0,0,,Не? Күте тұрыңыз!
Dialogue: 0,0:20:40.80,0:20:43.24,Default,,0,0,0,,Ол менің рыцарьым!Бірдеңе...
Dialogue: 0,0:20:43.34,0:20:44.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:44.34,0:20:48.28,Default,,0,0,0,,Мен бұл туралы кейінірек бірдеңе істеймін, бірақ әзірге...
Dialogue: 0,0:20:48.48,0:20:49.74,Default,,0,0,0,,Ум... не?
Dialogue: 0,0:20:50.38,0:20:53.95,Default,,0,0,0,,Біз Огимен байланыс орнаттық. Біз ашық мұхитта кездесуді жалғастырамыз.
Dialogue: 0,0:20:54.25,0:20:56.28,Default,,0,0,0,,Иә! Ах... бұл және...
Dialogue: 0,0:20:56.62,0:20:57.55,Default,,0,0,0,,Екінші Гурен стилі туралы не деуге болады?
Dialogue: 0,0:20:57.65,0:20:58.89,Default,,0,0,0,,Ол жиналды.
Dialogue: 0,0:20:58.99,0:21:00.89,Default,,0,0,0,,Асахина мен Чибаға рахмет.
Dialogue: 0,0:21:00.99,0:21:02.32,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:02.62,0:21:04.46,Default,,0,0,0,,Созаку, кешіріңіз.
Dialogue: 0,0:21:04.96,0:21:07.39,Default,,0,0,0,,Мен оны тек сен үшін пайдаланғым келмеді, бірақ...
Dialogue: 0,0:21:10.60,0:21:11.47,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:11.73,0:21:13.87,Default,,0,0,0,,Тірі!
Dialogue: 0,0:21:19.67,0:21:20.54,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:21:23.48,0:21:24.81,Default,,0,0,0,,Майор Куруруги ордені!
Dialogue: 0,0:21:24.91,0:21:27.55,Default,,0,0,0,,Шулы! Сіз мұны білдіңіз бе? ―
Dialogue: 0,0:21:27.65,0:21:29.75,Default,,0,0,0,,Мен өмір сүруім керек!
Dialogue: 0,0:21:29.85,0:21:33.29,Default,,0,0,0,,Мен оның Ланселоттан қалай шыққанын білмеймін.
Dialogue: 0,0:21:33.39,0:21:35.92,Default,,0,0,0,,Нөлді жою үшін өмірде бір рет болатын мүмкіндік
Dialogue: 0,0:21:36.02,0:21:38.53,Default,,0,0,0,,Өміріме өкініп, өмірден айырылдым.
Dialogue: 0,0:21:38.76,0:21:40.76,Default,,0,0,0,,Сіз қорғауға дайынсыз ба?
Dialogue: 0,0:21:40.86,0:21:43.43,Default,,0,0,0,,Шынымен... өзім бе?
Dialogue: 0,0:21:43.53,0:21:45.57,Default,,0,0,0,,Бұл бұйрықтарды өрескел бұзу!
Dialogue: 0,0:21:46.30,0:21:47.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:48.40,0:21:49.37,Default,,0,0,0,,Куруруги?
Dialogue: 0,0:21:49.47,0:21:51.61,Default,,0,0,0,,Иә, мәліметтер белгісіз
Dialogue: 0,0:21:51.71,0:21:52.67,Default,,0,0,0,,Мүлдем емес...
Dialogue: 0,0:21:52.77,0:21:55.38,Default,,0,0,0,,Мен Исикаваны жеңді деп ойлаған кезде
Dialogue: 0,0:21:55.48,0:21:56.34,Default,,0,0,0,,Мәртебелі
Dialogue: 0,0:21:56.44,0:21:57.84,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:21:58.35,0:22:00.78,Default,,0,0,0,,Кюсю блогындағы Канмон Охаши көпірі қирады.
Dialogue: 0,0:22:00.85,0:22:01.72,Default,,0,0,0,,Не?
Dialogue: 0,0:22:01.95,0:22:03.68,Default,,0,0,0,,Басқа 4 құрлық жолы бар...
Dialogue: 0,0:22:03.78,0:22:07.59,Default,,0,0,0,,Сонымен қатар, көптеген амфибиялық шабуылдаушы кемелер Генкай теңізіне басып кіруде.
Dialogue: 0,0:22:07.69,0:22:11.39,Default,,0,0,0,,Ах! Бұл Қытай Федерациясы ма? Бірақ соғыс жариялау...
Dialogue: 0,0:22:11.46,0:22:13.06,Default,,0,0,0,,Жоқ, бұл корпустар...
Dialogue: 0,0:22:13.36,0:22:14.90,Default,,0,0,0,,Жапон туы!
Dialogue: 0,0:22:18.03,0:22:21.70,Default,,0,0,0,,♪Мозаикалық бөлік бір-бірден
Dialogue: 0,0:22:21.80,0:22:25.51,Default,,0,0,0,,♪Қосыңыз және сызыңыз
Dialogue: 0,0:22:25.61,0:22:32.61,Default,,0,0,0,,♪Сіз маған сыйлаған кездесулер мен қоштасулар
Dialogue: 0,0:22:41.12,0:22:48.13,Default,,0,0,0,,♪Бұлай болуы мүмкін емес,-деп ойланып ұйықтап қалдым
Dialogue: 0,0:22:48.63,0:22:51.90,Default,,0,0,0,,♪Мен оянсам, әдеттегідей
Dialogue: 0,0:22:52.00,0:22:56.40,Default,,0,0,0,,♪ Өзгеріссіз бос жүріс
Dialogue: 0,0:22:56.50,0:23:01.68,Default,,0,0,0,,♪ Мағынасыз қайталанады
Dialogue: 0,0:23:02.54,0:23:06.55,Default,,0,0,0,,♪Мозаикалық үзінділер жанды түрде бейнеленген
Dialogue: 0,0:23:06.65,0:23:09.72,Default,,0,0,0,,♪Бұрынғы өтірік пен қателіктер
Dialogue: 0,0:23:09.82,0:23:16.82,Default,,0,0,0,,♪Оны өшіргім келген сайын, ол туралы көбірек ойлаймын
Dialogue: 0,0:23:17.39,0:23:18.63,Default,,0,0,0,,♪Артқа қарап
Dialogue: 0,0:23:18.73,0:23:21.93,Default,,0,0,0,,♪Бастау сызығы бар
Dialogue: 0,0:23:22.03,0:23:24.53,Default,,0,0,0,,♪Әлі прогресс жоқ
Dialogue: 0,0:23:24.63,0:23:31.64,Default,,0,0,0,,♪Тағыда армандарымызды жинайық
Dialogue: 0,0:23:32.01,0:23:35.58,Default,,0,0,0,,♪Мозаикалық бөлік бір-бірден
Dialogue: 0,0:23:35.68,0:23:39.18,Default,,0,0,0,,♪Қосыңыз және сызыңыз
Dialogue: 0,0:23:39.48,0:23:46.49,Default,,0,0,0,,♪Сіз маған сыйлаған кездесулер мен қоштасулар
Dialogue: 0,0:23:49.92,0:23:51.83,Default,,0,0,0,,Шнайзел неге бұл аралда болды? ―
Dialogue: 0,0:23:52.06,0:23:54.59,Default,,0,0,0,,Ол жерде не жасырылған? ―
Dialogue: 0,0:23:54.69,0:23:55.96,Default,,0,0,0,,Және Юффи
Dialogue: 0,0:23:56.03,0:23:57.90,Default,,0,0,0,,Мен сізге біраз уақыт сене алуым керек...
Dialogue: 0,0:23:58.00,0:23:59.73,Default,,0,0,0,,Карен мен Сузаку туралы да бірдеңе бар.
Dialogue: 0,0:23:59.83,0:24:00.77,Default,,0,0,0,,Жоқ, қазір емес-
Dialogue: 0,0:24:00.87,0:24:02.44,Default,,0,0,0,,Алдымен кюсюмен айналысу.
Dialogue: 0,0:24:02.64,0:24:04.50,Default,,0,0,0,,Осылайша, Қара рыцарлар...
Dialogue: 0,0:24:04.60,0:24:07.84,Default,,0,0,0,,Менің болашағым шешілді.
Dialogue: 0,0:24:09.34,0:24:15.34,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory