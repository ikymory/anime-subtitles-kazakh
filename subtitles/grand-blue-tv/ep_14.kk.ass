Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.61,0:00:10.61,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:00:07.61,0:00:10.61,Default,,0,0,0,,Қайта оралуыңмен!
Dialogue: 0,0:00:10.61,0:00:12.61,Default,,0,0,0,,Обу!
Dialogue: 0,0:00:12.61,0:00:14.95,Default,,0,0,0,,Не болды? Иори
Dialogue: 0,0:00:12.61,0:00:14.95,Default,,0,0,0,,Сіз аштықтасыз ба?
Dialogue: 0,0:00:14.95,0:00:18.62,Default,,0,0,0,,Құсығыңыз келсе, дәретханаға барыңыз.
Dialogue: 0,0:00:14.95,0:00:18.62,Default,,0,0,0,,Бұл сіздің сыртқы түріңізге байланысты!
Dialogue: 0,0:00:18.62,0:00:21.45,Default,,0,0,0,,Иә? Ахахаха...!
Dialogue: 0,0:00:21.45,0:00:23.46,Default,,0,0,0,,Аа, солай ма?
Dialogue: 0,0:00:23.46,0:00:26.13,Default,,0,0,0,,Мен осыдан кейін суға түсемін.
Dialogue: 0,0:00:23.46,0:00:26.13,Default,,0,0,0,,Мен оны дайындадым.
Dialogue: 0,0:00:26.13,0:00:28.46,Default,,0,0,0,,Дұрыс астына
Dialogue: 0,0:00:26.13,0:00:28.46,Default,,0,0,0,,Өйткені мен купальник киемін
Dialogue: 0,0:00:28.46,0:00:31.30,Default,,0,0,0,,Не? Солай ма?
Dialogue: 0,0:00:31.30,0:00:34.30,Default,,0,0,0,,Үшеуіңіз жақсы ма?
Dialogue: 0,0:00:34.30,0:00:36.30,Default,,0,0,0,,Бұл ақылсыз!
Dialogue: 0,0:02:07.43,0:02:10.26,Default,,0,0,0,,Бүгінгі күн
Dialogue: 0,0:02:07.43,0:02:10.26,Default,,0,0,0,,Мен тұтынушымын...
Dialogue: 0,0:02:10.26,0:02:12.27,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:02:12.27,0:02:15.77,Default,,0,0,0,,А, Нанака-сан.
Dialogue: 0,0:02:12.27,0:02:15.77,Default,,0,0,0,,Сіз киім киіп жүрсіз бе?
Dialogue: 0,0:02:15.77,0:02:17.77,Default,,0,0,0,,Не болды?
Dialogue: 0,0:02:17.77,0:02:20.27,Default,,0,0,0,,Тұтынушы, шұғыл бизнес.
Dialogue: 0,0:02:17.77,0:02:20.27,Default,,0,0,0,,Мен оны кейінге қалдыруыңызды қалаймын.
Dialogue: 0,0:02:20.27,0:02:23.94,Default,,0,0,0,,Бұл ұят.
Dialogue: 0,0:02:20.27,0:02:23.94,Default,,0,0,0,,Бұл оның бүгін жойылғанын білдіре ме?
Dialogue: 0,0:02:23.94,0:02:26.78,Default,,0,0,0,,Менің таңдауым жоқ
Dialogue: 0,0:02:23.94,0:02:26.78,Default,,0,0,0,,Сіз кейде киім киесіз бе?
Dialogue: 0,0:02:26.78,0:02:29.95,Default,,0,0,0,,Әдетте
Dialogue: 0,0:02:26.78,0:02:29.95,Default,,0,0,0,,Мен оны үнемі киемін.
Dialogue: 0,0:02:29.95,0:02:34.29,Default,,0,0,0,,Иә, онда...
Dialogue: 0,0:02:29.95,0:02:34.29,Default,,0,0,0,,Itadadakimasu!
Dialogue: 0,0:02:34.29,0:02:37.46,Default,,0,0,0,,Жарайды, мен ішу тойына дейін боспын.
Dialogue: 0,0:02:37.46,0:02:39.46,Default,,0,0,0,,Ах, дұрыс.
Dialogue: 0,0:02:39.46,0:02:42.13,Default,,0,0,0,,Иори түнге дейін не істейсің?
Dialogue: 0,0:02:42.13,0:02:44.30,Default,,0,0,0,,Онда неге маған қарсы әрекет етесің?
Dialogue: 0,0:02:44.30,0:02:46.47,Default,,0,0,0,,Олай болса сенің тағы бір ісің бар ма?
Dialogue: 0,0:02:46.47,0:02:49.14,Default,,0,0,0,,Мен бүгін ішімдік кешіне қатыспаймын.
Dialogue: 0,0:02:46.47,0:02:49.14,Default,,0,0,0,,айтамын
Dialogue: 0,0:02:49.14,0:02:51.64,Default,,0,0,0,,Яғни… өз санаңды біреудің санасымен алмастыру—
Dialogue: 0,0:02:49.14,0:02:51.64,Default,,0,0,0,,Сіз қандай үйірмеге қосылуды жоспарлап отырсыз!?
Dialogue: 0,0:02:51.64,0:02:53.81,Default,,0,0,0,,Не!? Бұл суға түсу емес пе?
Dialogue: 0,0:02:53.81,0:02:57.24,Default,,0,0,0,,Иори-кун
Dialogue: 0,0:02:53.81,0:02:57.24,Default,,0,0,0,,Иә
Dialogue: 0,0:02:57.24,0:03:00.58,Default,,0,0,0,,Менің үйіме Иори-кун келді.
Dialogue: 0,0:02:57.24,0:03:00.58,Default,,0,0,0,,Үшінші күн, білесің бе?
Dialogue: 0,0:03:00.58,0:03:03.08,Default,,0,0,0,,Не?
Dialogue: 0,0:03:03.08,0:03:05.38,Default,,0,0,0,,Менің бөлмем қайда?
Dialogue: 0,0:03:07.42,0:03:10.42,Default,,0,0,0,,Менен сұрасаңыз
Dialogue: 0,0:03:07.42,0:03:10.42,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:03:10.42,0:03:13.59,Default,,0,0,0,,Университет студенті болу
Dialogue: 0,0:03:10.42,0:03:13.59,Default,,0,0,0,,Мен көңіл көтеру сезімін түсінемін, дегенмен➡︎
Dialogue: 0,0:03:13.59,0:03:15.93,Default,,0,0,0,,Үш күн қатарынан түнде шығу жақсы емес.
Dialogue: 0,0:03:15.93,0:03:19.43,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:03:15.93,0:03:19.43,Default,,0,0,0,,Нанака дұрыс айтады.
Dialogue: 0,0:03:19.43,0:03:22.77,Default,,0,0,0,,Сондықтан мен бүгін кешке қатыспаймын.
Dialogue: 0,0:03:22.77,0:03:26.61,Default,,0,0,0,,Менің таңдауым жоқ.
Dialogue: 0,0:03:22.77,0:03:26.61,Default,,0,0,0,,Иори қатыспады ма?
Dialogue: 0,0:03:26.61,0:03:29.44,Default,,0,0,0,,Жоқ, кешіріңіз.
Dialogue: 0,0:03:29.44,0:03:34.11,Default,,0,0,0,,На~ни жақсы
Dialogue: 0,0:03:29.44,0:03:34.11,Default,,0,0,0,,Бәрібір адам жететін шығар.
Dialogue: 0,0:03:34.11,0:03:38.31,Default,,0,0,0,,Бүгінгі ішу тойы
Dialogue: 0,0:03:34.11,0:03:38.31,Default,,0,0,0,,Бұл Аоми әйелдер университетімен алмасу іс-шарасы.
Dialogue: 0,0:03:40.79,0:03:43.59,Default,,0,0,0,,《Әйелдер колледжі...? 》
Dialogue: 0,0:03:45.63,0:03:48.46,Default,,0,0,0,,Ішуге дейін не істеуіміз керек?
Dialogue: 0,0:03:45.63,0:03:48.46,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:03:48.46,0:03:50.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:50.46,0:03:53.97,Default,,0,0,0,,Тіпті осы уақытқа дейін
Dialogue: 0,0:03:50.46,0:03:53.97,Default,,0,0,0,,Сіз мені кешіре аласыз ба!?
Dialogue: 0,0:03:53.97,0:03:56.40,Default,,0,0,0,,Эй, Иори, не болды?
Dialogue: 0,0:03:56.40,0:04:00.57,Default,,0,0,0,,есіме түсті
Dialogue: 0,0:03:56.40,0:04:00.57,Default,,0,0,0,,Қандай үйірмеге қосылдың?
Dialogue: 0,0:04:00.57,0:04:02.58,Default,,0,0,0,,Дайвинг, солай ма?
Dialogue: 0,0:04:00.57,0:04:02.58,Default,,0,0,0,,Бұл Музан мырза…
Dialogue: 0,0:04:02.58,0:04:05.08,Default,,0,0,0,,Мұндай нәрсеге кіргенім есімде.
Dialogue: 0,0:04:02.58,0:04:05.08,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:04:05.08,0:04:07.41,Default,,0,0,0,,Бұл керемет кері қайтару.
Dialogue: 0,0:04:07.41,0:04:09.75,Default,,0,0,0,,Білегім жұлынғалы тұр.
Dialogue: 0,0:04:09.75,0:04:11.92,Default,,0,0,0,,Өтінемін! Нанака-сан!
Dialogue: 0,0:04:11.92,0:04:15.42,Default,,0,0,0,,Ал, әзірге.
Dialogue: 0,0:04:11.92,0:04:15.42,Default,,0,0,0,,Жоғары қараңдаршы, киінеміз бе?
Dialogue: 0,0:04:15.42,0:04:17.92,Default,,0,0,0,,Сен неге киіміңді шешесің?
Dialogue: 0,0:04:17.92,0:04:20.59,Default,,0,0,0,,Шынайы болу үшін!
Dialogue: 0,0:04:20.59,0:04:23.76,Default,,0,0,0,,Мен сенің ойнағың келетінін білемін, бірақ...
Dialogue: 0,0:04:20.59,0:04:23.76,Default,,0,0,0,,Бірақ, генерал!
Dialogue: 0,0:04:23.76,0:04:26.10,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:04:23.76,0:04:26.10,Default,,0,0,0,,Бұл туралы бірдеңе жасаңыз!
Dialogue: 0,0:04:26.10,0:04:28.43,Default,,0,0,0,,Жақсы нәрсе жоқ!
Dialogue: 0,0:04:26.10,0:04:28.43,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:28.43,0:04:31.60,Default,,0,0,0,,Мектептен шығарылу үшін қажет найзағайлар: 7 қалды
Dialogue: 0,0:04:28.43,0:04:31.60,Default,,0,0,0,,Рұқсат беріледі деп ойлайсыз ба?
Dialogue: 0,0:04:31.60,0:04:34.27,Default,,0,0,0,,Осыншама көп айтсаң
Dialogue: 0,0:04:31.60,0:04:34.27,Default,,0,0,0,,Бас тарту
Dialogue: 0,0:04:34.27,0:04:36.78,Default,,0,0,0,,Маған ұнамайды! Мен берілмеймін!
Dialogue: 0,0:04:36.78,0:04:40.28,Default,,0,0,0,,Саған не болып жатыр?
Dialogue: 0,0:04:36.78,0:04:40.28,Default,,0,0,0,,Сіз қатты итеріп жатырсыз ба?
Dialogue: 0,0:04:40.28,0:04:44.12,Default,,0,0,0,,Мен жыныстық құштарлық бар деп айтуға ұяламын.
Dialogue: 0,0:04:40.28,0:04:44.12,Default,,0,0,0,,Бұл өте ұят.
Dialogue: 0,0:04:44.12,0:04:47.29,Default,,0,0,0,,Одан гөрі Нанака-сан.
Dialogue: 0,0:04:44.12,0:04:47.29,Default,,0,0,0,,Қалай көндіруге болады!
Dialogue: 0,0:04:47.29,0:04:49.29,Default,,0,0,0,,Хмм.
Dialogue: 0,0:04:47.29,0:04:49.29,Default,,0,0,0,,О...
Dialogue: 0,0:04:49.29,0:04:51.79,Default,,0,0,0,,Әзірге қаптаманы ашуды аяқтаңыз.
Dialogue: 0,0:04:51.79,0:04:54.79,Default,,0,0,0,,Бірақ бұл бәрі...
Dialogue: 0,0:04:51.79,0:04:54.79,Default,,0,0,0,,Жетіспеушілік бар ма?
Dialogue: 0,0:04:54.79,0:05:00.07,Default,,0,0,0,,Сонда сен тәуелсіз адамсың.
Dialogue: 0,0:04:54.79,0:05:00.07,Default,,0,0,0,,Сізге ұнайтын бөлме жасаңыз
Dialogue: 0,0:05:00.07,0:05:03.24,Default,,0,0,0,,Не айтсаң да...
Dialogue: 0,0:05:00.07,0:05:03.24,Default,,0,0,0,,Менің таңдауым жоқ
Dialogue: 0,0:05:03.24,0:05:06.41,Default,,0,0,0,,Менің сүйкімді кенже балам үшін
Dialogue: 0,0:05:03.24,0:05:06.41,Default,,0,0,0,,Демалайық!
Dialogue: 0,0:05:06.41,0:05:08.74,Default,,0,0,0,,Иори - ересек адам➡︎
Dialogue: 0,0:05:08.74,0:05:11.58,Default,,0,0,0,,Бір қарағанда
Dialogue: 0,0:05:08.74,0:05:11.58,Default,,0,0,0,,Мен бөлме жасаймын
Dialogue: 0,0:05:11.58,0:05:14.75,Default,,0,0,0,,Не? Қаптаманы ашу уақыты келді
Dialogue: 0,0:05:11.58,0:05:14.75,Default,,0,0,0,,Бітірдің бе?
Dialogue: 0,0:05:14.75,0:05:19.09,Default,,0,0,0,,Иә. Мен де.
Dialogue: 0,0:05:14.75,0:05:19.09,Default,,0,0,0,,Ол толық тәуелсіз ересек адам!
Dialogue: 0,0:05:19.09,0:05:32.27,Default,,0,0,0,,♬︎〜
Dialogue: 0,0:05:32.27,0:05:35.60,Default,,0,0,0,,Ха! Бұл дұрыс емес, Нанака-сан!
Dialogue: 0,0:05:32.27,0:05:35.60,Default,,0,0,0,,Бұл...
Dialogue: 0,0:05:35.60,0:05:38.94,Default,,0,0,0,,А... Мен... Иори-кун да➡︎
Dialogue: 0,0:05:38.94,0:05:41.77,Default,,0,0,0,,Бұл бала...
Dialogue: 0,0:05:38.94,0:05:41.77,Default,,0,0,0,,Жоқ... а...
Dialogue: 0,0:05:41.77,0:05:43.78,Default,,0,0,0,,А...
Dialogue: 0,0:05:43.78,0:05:46.28,Default,,0,0,0,,Қалай болды? Иори
Dialogue: 0,0:05:43.78,0:05:46.28,Default,,0,0,0,,Өте жақсы, солай ма?
Dialogue: 0,0:05:46.28,0:05:50.28,Default,,0,0,0,,Ей, бейбақтар!
Dialogue: 0,0:05:46.28,0:05:50.28,Default,,0,0,0,,Бұл сәтсіз болды ма?
Dialogue: 0,0:05:50.28,0:05:53.45,Default,,0,0,0,,неліктен
Dialogue: 0,0:05:50.28,0:05:53.45,Default,,0,0,0,,Бұл сәтті болады деп ойлайсыз ба?
Dialogue: 0,0:05:53.45,0:05:55.39,Default,,0,0,0,,Эротикалық кітаптарды жиі табатын аналар ➡︎
Dialogue: 0,0:05:55.39,0:05:57.89,Default,,0,0,0,,«Сен есейдің».
Dialogue: 0,0:05:55.39,0:05:57.89,Default,,0,0,0,,Сіздің реакцияңыз солай емес пе?
Dialogue: 0,0:05:57.89,0:06:00.06,Default,,0,0,0,,Мағынасы мүлде басқа!
Dialogue: 0,0:06:00.06,0:06:02.06,Default,,0,0,0,,Сонымен не қалайсыз?
Dialogue: 0,0:06:02.06,0:06:04.06,Default,,0,0,0,,Қалыпты - жақсы!
Dialogue: 0,0:06:04.06,0:06:07.73,Default,,0,0,0,,Бірінші рет жалғыз тұру
Dialogue: 0,0:06:04.06,0:06:07.73,Default,,0,0,0,,Университет студенттері жасаған кәдімгі бөлмеде!
Dialogue: 0,0:06:07.73,0:06:09.90,Default,,0,0,0,,Бұл жақсы нәрсе ме?
Dialogue: 0,0:06:09.90,0:06:12.07,Default,,0,0,0,,Содан кейін алдымен иә деп айтыңыз.
Dialogue: 0,0:06:12.07,0:06:14.57,Default,,0,0,0,,Күрсін, саған арқа сүйеген ақымақ болдым.
Dialogue: 0,0:06:14.57,0:06:18.58,Default,,0,0,0,,Қалғанын өзім істеймін.
Dialogue: 0,0:06:14.57,0:06:18.58,Default,,0,0,0,,Мынаны үйге апарыңыз.
Dialogue: 0,0:06:18.58,0:06:22.08,Default,,0,0,0,,Иә? Мен оны тазалай аламын ба?
Dialogue: 0,0:06:18.58,0:06:22.08,Default,,0,0,0,,Бұл анық емес пе?
Dialogue: 0,0:06:22.08,0:06:24.08,Default,,0,0,0,,Жоқ, Котобуки➡︎
Dialogue: 0,0:06:24.08,0:06:28.42,Default,,0,0,0,,Кіру сыйлығы үшін сізге не ұнайды
Dialogue: 0,0:06:24.08,0:06:28.42,Default,,0,0,0,,Біреуін сыйлыққа беру ойымда бар.
Dialogue: 0,0:06:28.42,0:06:30.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:32.93,0:06:35.93,Default,,0,0,0,,Iori this
Dialogue: 0,0:06:32.93,0:06:35.93,Default,,0,0,0,,Мен оны лақтырамын, бірақ қарсы болмасаңыз...
Dialogue: 0,0:06:35.93,0:06:38.93,Default,,0,0,0,,Иә! О! Иә, иә!
Dialogue: 0,0:06:38.93,0:06:41.27,Default,,0,0,0,,Өте жақсы 78 ұпай
Dialogue: 0,0:06:41.27,0:06:44.94,Default,,0,0,0,,Хмм, бұл сенімділікті арттырды.
Dialogue: 0,0:06:44.94,0:06:49.44,Default,,0,0,0,,📓Sessibone! Сессия!
Dialogue: 0,0:06:49.44,0:06:51.78,Default,,0,0,0,,Рахмет
Dialogue: 0,0:06:49.44,0:06:51.78,Default,,0,0,0,,Мені қатты қате түсінді.
Dialogue: 0,0:06:51.78,0:06:53.78,Default,,0,0,0,,Бұл түсініспеушілік емес еді.
Dialogue: 0,0:06:51.78,0:06:53.78,Default,,0,0,0,,Менің ойымша
Dialogue: 0,0:06:53.78,0:06:55.88,Default,,0,0,0,,Әдетте орнында
Dialogue: 0,0:06:53.78,0:06:55.88,Default,,0,0,0,,"Менімен бірге көргің келе ме?"➡︎ нені білдіреді
Dialogue: 0,0:06:55.88,0:06:58.72,Default,,0,0,0,,Сіз оны айтпайсыз.
Dialogue: 0,0:06:55.88,0:06:58.72,Default,,0,0,0,,Қазір үйге қайтыңыз.
Dialogue: 0,0:06:58.72,0:07:00.72,Default,,0,0,0,,Мерекелік бөтелке қалдырыңыз
Dialogue: 0,0:07:00.72,0:07:04.39,Default,,0,0,0,,Иориді күтіңіз
Dialogue: 0,0:07:00.72,0:07:04.39,Default,,0,0,0,,Хаа… Хаа… Хаа…
Dialogue: 0,0:07:00.72,0:07:04.39,Default,,0,0,0,,Біздің ойынға қатысты
Dialogue: 0,0:07:04.39,0:07:08.39,Default,,0,0,0,,Жоқ, жеткілікті.
Dialogue: 0,0:07:04.39,0:07:08.39,Default,,0,0,0,,Тағы бір шөлмек ше?
Dialogue: 0,0:07:08.39,0:07:10.40,Default,,0,0,0,,Үлкендеріңізге сеніңіз
Dialogue: 0,0:07:10.40,0:07:12.40,Default,,0,0,0,,Маған қалдырыңыз!
Dialogue: 0,0:07:12.40,0:07:14.40,Default,,0,0,0,,Жаңадан келген оқушы сияқты.
Dialogue: 0,0:07:12.40,0:07:14.40,Default,,0,0,0,,Керемет бөлме жасаңыз
Dialogue: 0,0:07:14.40,0:07:16.40,Default,,0,0,0,,Өтінемін!
Dialogue: 0,0:07:16.40,0:07:19.24,Default,,0,0,0,,О Иори
Dialogue: 0,0:07:19.24,0:07:22.41,Default,,0,0,0,,Чиса бұрын қатты ашуланған болатын.
Dialogue: 0,0:07:19.24,0:07:22.41,Default,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,0:07:22.41,0:07:25.08,Default,,0,0,0,,Мен ғана ағамын
Dialogue: 0,0:07:22.41,0:07:25.08,Default,,0,0,0,,Мен қоныс тойына сыйлық алдым➡︎
Dialogue: 0,0:07:25.08,0:07:27.08,Default,,0,0,0,,Бұл жақсы болмаған сияқты...
Dialogue: 0,0:07:27.08,0:07:29.92,Default,,0,0,0,,Бұл сізді ашуландырады ма?
Dialogue: 0,0:07:27.08,0:07:29.92,Default,,0,0,0,,Ол әлі бала емес пе?
Dialogue: 0,0:07:29.92,0:07:32.92,Default,,0,0,0,,Қаласаң менімен бірге жүр.
Dialogue: 0,0:07:29.92,0:07:32.92,Default,,0,0,0,,Мен сізді шақыруға тырыстым.
Dialogue: 0,0:07:32.92,0:07:34.92,Default,,0,0,0,,Ах, Иори-кун
Dialogue: 0,0:07:34.92,0:07:37.26,Default,,0,0,0,,Ах Нанака-сан
Dialogue: 0,0:07:34.92,0:07:37.26,Default,,0,0,0,,Түсіндірейін!
Dialogue: 0,0:07:37.26,0:07:39.59,Default,,0,0,0,,Жарайды, маған бәрібір.
Dialogue: 0,0:07:39.59,0:07:42.26,Default,,0,0,0,,Қой, қой. Қазір ең бастысы – Римге аман-есен жету.
Dialogue: 0,0:07:39.59,0:07:42.26,Default,,0,0,0,,Досыңыздан телефон арқылы сұрасаңыз➡︎
Dialogue: 0,0:07:42.26,0:07:45.26,Default,,0,0,0,,Иори-кун сияқты бала болса.
Dialogue: 0,0:07:42.26,0:07:45.26,Default,,0,0,0,,Бұл қалыпты жағдай
Dialogue: 0,0:07:45.26,0:07:48.27,Default,,0,0,0,,Бұл менің абыройсыздығым.
Dialogue: 0,0:07:45.26,0:07:48.27,Default,,0,0,0,,Ол тараған жоқ па?
Dialogue: 0,0:07:48.27,0:07:51.60,Default,,0,0,0,,Бұл менің үлкендерімнің қалжыңы!
Dialogue: 0,0:07:48.27,0:07:51.60,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:07:51.60,0:07:54.27,Default,,0,0,0,,Иә. Қазір мен қалыпты бөлмедемін...
Dialogue: 0,0:07:54.27,0:07:57.38,Default,,0,0,0,,Менеджер виолончель таспасы
Dialogue: 0,0:07:54.27,0:07:57.38,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:07:57.38,0:07:59.38,Default,,0,0,0,,О
Dialogue: 0,0:07:57.38,0:07:59.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:04.88,0:08:07.22,Default,,0,0,0,,(ызылдаған)
Dialogue: 0,0:08:07.22,0:08:11.89,Default,,0,0,0,,О, қалай?
Dialogue: 0,0:08:07.22,0:08:11.89,Default,,0,0,0,,Менің продюсерімнің ыңғайлы бөлмесі
Dialogue: 0,0:08:11.89,0:08:14.39,Default,,0,0,0,,Неге мұндасың!?
Dialogue: 0,0:08:11.89,0:08:14.39,Default,,0,0,0,,Жоқ!?
Dialogue: 0,0:08:14.39,0:08:18.23,Default,,0,0,0,,Сіз! Жарайды, мен мұны мақтан тұтамын
Dialogue: 0,0:08:14.39,0:08:18.23,Default,,0,0,0,,Жалғыз тұруға арналған стартер жинағы!
Dialogue: 0,0:08:18.23,0:08:21.90,Default,,0,0,0,,Аузыңды жап! Біреудің бөлмесін рұқсатсыз алыңыз
Dialogue: 0,0:08:18.23,0:08:21.90,Default,,0,0,0,,Оны өз түсіңізге боядым!
Dialogue: 0,0:08:21.90,0:08:25.40,Default,,0,0,0,,Адамдар көп күш жұмсады
Dialogue: 0,0:08:21.90,0:08:25.40,Default,,0,0,0,,Сіз көшірген постер...
Dialogue: 0,0:08:25.40,0:08:27.57,Default,,0,0,0,,Мен сені соңына дейін қарғаймын
Dialogue: 0,0:08:27.57,0:08:31.91,Default,,0,0,0,,Көшірмені сындырсаң ғана қарғысқа ұшырайсың.
Dialogue: 0,0:08:27.57,0:08:31.91,Default,,0,0,0,,Менің ұрпақтарым тым үлкен.
Dialogue: 0,0:08:31.91,0:08:34.58,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл уақыт тамаша емес пе?
Dialogue: 0,0:08:34.58,0:08:38.58,Default,,0,0,0,,Жаңадан келген студентке тән бөлме болса.
Dialogue: 0,0:08:34.58,0:08:38.58,Default,,0,0,0,,Өйткені оны жаңадан келген студенттер жасағаны дұрыс.
Dialogue: 0,0:08:38.58,0:08:40.75,Default,,0,0,0,,Бұл туралы айтудың қажеті жоқ!
Dialogue: 0,0:08:40.75,0:08:43.42,Default,,0,0,0,,Сонымен, қандай бөлме?
Dialogue: 0,0:08:40.75,0:08:43.42,Default,,0,0,0,,Жақсы болды дейсіз бе!?
Dialogue: 0,0:08:43.42,0:08:46.09,Default,,0,0,0,,Бұл дәл қарама-қарсы бөлме!
Dialogue: 0,0:08:46.09,0:08:49.10,Default,,0,0,0,,А... бұл не?
Dialogue: 0,0:08:49.10,0:08:51.10,Default,,0,0,0,,Олай болса, алдымен иә деп айт.
Dialogue: 0,0:08:51.10,0:08:53.10,Default,,0,0,0,,Мен айтпасам, түсінбей қаласың.
Dialogue: 0,0:08:53.10,0:08:55.53,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:08:53.10,0:08:55.53,Default,,0,0,0,,Мен дәл қазір осындай бөлме жасаймын.
Dialogue: 0,0:08:55.53,0:08:58.04,Default,,0,0,0,,Жоқ, мен мұны өзім жасаймын.
Dialogue: 0,0:08:55.53,0:08:58.04,Default,,0,0,0,,Виолетке түскен өтініштер саны да артты.
Dialogue: 0,0:08:58.04,0:09:00.04,Default,,0,0,0,,Ол мені үлкен ағамдай жақсы көреді➡︎
Dialogue: 0,0:09:00.04,0:09:02.21,Default,,0,0,0,,Кіші сынып оқушыларының алдында
Dialogue: 0,0:09:00.04,0:09:02.21,Default,,0,0,0,,Үйге бара аламын ба?
Dialogue: 0,0:09:02.21,0:09:04.88,Default,,0,0,0,,Қандай жемді қолдандың?
Dialogue: 0,0:09:02.21,0:09:04.88,Default,,0,0,0,,Сізді шақырды!?
Dialogue: 0,0:09:04.88,0:09:07.21,Default,,0,0,0,,Сәлем Иори!
Dialogue: 0,0:09:04.88,0:09:07.21,Default,,0,0,0,,Әкем полицияда қызмет етеді.
Dialogue: 0,0:09:07.21,0:09:09.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:07.21,0:09:09.55,Default,,0,0,0,,Жоспар
Dialogue: 0,0:09:09.55,0:09:12.22,Default,,0,0,0,,Егер сіз тегін жүктеуші болсаңыз, көмек маңызды.
Dialogue: 0,0:09:12.22,0:09:14.89,Default,,0,0,0,,Егер бұл бөлме болса
Dialogue: 0,0:09:12.22,0:09:14.89,Default,,0,0,0,,Қалағаныңды орындаймын.
Dialogue: 0,0:09:14.89,0:09:17.39,Default,,0,0,0,,Мен уайымдап тұрмын, бірақ көмектесе алмаймын
Dialogue: 0,0:09:19.89,0:09:23.59,Default,,0,0,0,,Сәлем Кохеи
Dialogue: 0,0:09:19.89,0:09:23.59,Default,,0,0,0,,Бұл шынымен жақсы ма?
Dialogue: 0,0:09:25.90,0:09:29.90,Default,,0,0,0,,Иә, егер сен маған мүлдем қарама-қарсы болсаң.
Dialogue: 0,0:09:25.90,0:09:29.90,Default,,0,0,0,,Бұл сөзсіз дұрыс
Dialogue: 0,0:09:29.90,0:09:33.40,Default,,0,0,0,,Иә? ше? Иори Китахара
Dialogue: 0,0:09:35.57,0:09:41.41,Default,,0,0,0,,Сен, кел! Енді маған зорлық көрсет...
Dialogue: 0,0:09:35.57,0:09:41.41,Default,,0,0,0,,Иә!? Апыр-ай!
Dialogue: 0,0:09:41.41,0:09:43.75,Default,,0,0,0,,Бұрынғыдан
Dialogue: 0,0:09:41.41,0:09:43.75,Default,,0,0,0,,Барған сайын нашарлап барады!
Dialogue: 0,0:09:43.75,0:09:46.25,Default,,0,0,0,,Бұл DVD дегеніміз не?
Dialogue: 0,0:09:43.75,0:09:46.25,Default,,0,0,0,,Мен оны ойнап көруім керек пе?
Dialogue: 0,0:09:46.25,0:09:49.09,Default,,0,0,0,,Басқаларды тыңда!
Dialogue: 0,0:09:46.25,0:09:49.09,Default,,0,0,0,,(қағу)
Dialogue: 0,0:09:49.09,0:09:51.26,Default,,0,0,0,,Иори-кун?
Dialogue: 0,0:09:49.09,0:09:51.26,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:09:51.26,0:09:54.59,Default,,0,0,0,,Аа, додо…
Dialogue: 0,0:09:51.26,0:09:54.59,Default,,0,0,0,,Не болды? Нанака-сан
Dialogue: 0,0:09:54.59,0:09:58.10,Default,,0,0,0,,Мен көмектескім келді
Dialogue: 0,0:09:54.59,0:09:58.10,Default,,0,0,0,,А, қазір жақсы.
Dialogue: 0,0:09:58.10,0:10:00.27,Default,,0,0,0,,Егер бұл бұрын болған оқиға туралы болса, бәрі жақсы.
Dialogue: 0,0:10:00.27,0:10:03.60,Default,,0,0,0,,📺Еркек болсаң маған бәрібір
Dialogue: 0,0:10:03.60,0:10:06.94,Default,,0,0,0,,📺Мен түсіндім.
Dialogue: 0,0:10:03.60,0:10:06.94,Default,,0,0,0,,Негізі мен де сені ойлаймын...
Dialogue: 0,0:10:06.94,0:10:09.11,Default,,0,0,0,,О~ О~
Dialogue: 0,0:10:09.11,0:10:11.78,Default,,0,0,0,,Бұл Нанака-сан...
Dialogue: 0,0:10:11.78,0:10:14.95,Default,,0,0,0,,Е, аа, кешіріңіз, Иори-кун.
Dialogue: 0,0:10:14.95,0:10:19.12,Default,,0,0,0,,Мен аздап
Dialogue: 0,0:10:14.95,0:10:19.12,Default,,0,0,0,,Досыңызға қоңырау шалмасаңыз...
Dialogue: 0,0:10:19.12,0:10:21.62,Default,,0,0,0,,📺Тактикалық…
Dialogue: 0,0:10:19.12,0:10:21.62,Default,,0,0,0,,📺Юсуке…
Dialogue: 0,0:10:21.62,0:10:26.13,Default,,0,0,0,,Ең жақсы бөлмені жасаңыз
Dialogue: 0,0:10:21.62,0:10:26.13,Default,,0,0,0,,Кешке барайық!
Dialogue: 0,0:10:26.13,0:10:28.46,Default,,0,0,0,,О, о...
Ол
Dialogue: 0,0:10:28.46,0:10:30.80,Default,,0,0,0,,әйтеуір
Dialogue: 0,0:10:28.46,0:10:30.80,Default,,0,0,0,,Нанаканың сүйікті бөлмесі➡︎
Dialogue: 0,0:10:30.80,0:10:32.80,Default,,0,0,0,,Жасалу керек!
Dialogue: 0,0:10:32.80,0:10:34.80,Default,,0,0,0,,Идеяларыңыз бар ма?
Dialogue: 0,0:10:34.80,0:10:38.47,Default,,0,0,0,,Жарайсың ба? Нанака-сан
Dialogue: 0,0:10:34.80,0:10:38.47,Default,,0,0,0,,Ол өзінің сіңлісі Чисаны жақсы көреді!
Dialogue: 0,0:10:38.47,0:10:40.47,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:10:40.47,0:10:42.81,Default,,0,0,0,,Басқаша айтқанда, Нанака-сан
Dialogue: 0,0:10:40.47,0:10:42.81,Default,,0,0,0,,Сіздің сүйікті бөлмеңіз қандай?
Dialogue: 0,0:10:42.81,0:10:47.31,Default,,0,0,0,,Қара…
Dialogue: 0,0:10:42.81,0:10:47.31,Default,,0,0,0,,Менің ойымша, бұл сөзсіз басқаша.
Dialogue: 0,0:10:47.31,0:10:50.15,Default,,0,0,0,,Бос сөйлеме
Dialogue: 0,0:10:47.31,0:10:50.15,Default,,0,0,0,,Қолдарыңызды жылжытыңыз!
Dialogue: 0,0:10:50.15,0:10:53.49,Default,,0,0,0,,Бұл толығымен
Dialogue: 0,0:10:50.15,0:10:53.49,Default,,0,0,0,,Бұл аңдушының бөлмесі емес пе?
Dialogue: 0,0:10:53.49,0:10:57.59,Default,,0,0,0,,Сенпай, уақыт болды
Dialogue: 0,0:10:53.49,0:10:57.59,Default,,0,0,0,,Ішетін кештің уақыты келді ме?
Dialogue: 0,0:10:57.59,0:10:59.59,Default,,0,0,0,,Уа, мен оны айтуды ұмытып кетіппін.
Dialogue: 0,0:10:59.59,0:11:03.43,Default,,0,0,0,,Байланыс және басқа тараптың ыңғайлылығы болды
Dialogue: 0,0:10:59.59,0:11:03.43,Default,,0,0,0,,Мен оны кейінге қалдыруды қалаймын.
Dialogue: 0,0:11:03.43,0:11:06.10,Default,,0,0,0,,Иә? Кейінге қалдырылды ма?
Dialogue: 0,0:11:06.10,0:11:08.10,Default,,0,0,0,,Кейінге қалдыру
Dialogue: 0,0:11:08.10,0:11:11.27,Default,,0,0,0,,Бүгін емес пе?
Dialogue: 0,0:11:08.10,0:11:11.27,Default,,0,0,0,,Бүгін емес
Dialogue: 0,0:11:11.27,0:11:13.27,Default,,0,0,0,,Басты жүргізуші Кадзухико Хиби дәл сағат 18:00-де жүрек талмасынан өліп қалады.
Dialogue: 0,0:11:13.27,0:11:15.77,Default,,0,0,0,,онда Әйел Титанның ішіндегі адам қазір
Dialogue: 0,0:11:13.27,0:11:15.77,Default,,0,0,0,,Біздің істеп жатқанымыз...
Dialogue: 0,0:11:15.77,0:11:17.77,Default,,0,0,0,,Иори шайы…
Dialogue: 0,0:11:33.13,0:11:35.13,Default,,0,0,0,,Саған жақсы, Иори.
Dialogue: 0,0:11:35.13,0:11:37.96,Default,,0,0,0,,Сіз өзіңіз армандаған тәуелсіз өмір сүре аласыз.
Dialogue: 0,0:11:35.13,0:11:37.96,Default,,0,0,0,,Бұл бөлме емес пе?
Dialogue: 0,0:11:37.96,0:11:42.36,Default,,0,0,0,,Мен мұндай аяқталуды қаламаймын!
Dialogue: 0,0:11:44.80,0:11:46.80,Default,,0,0,0,,(Дабыл)
Dialogue: 0,0:11:48.81,0:11:52.31,Default,,0,0,0,,Олай болса, мен және Котобуки
Dialogue: 0,0:11:48.81,0:11:52.31,Default,,0,0,0,,Жаңа студенттерге қамқорлық...
Dialogue: 0,0:11:52.31,0:11:56.08,Default,,0,0,0,,Неге менің бөлмеме жиналып жатырсыңдар!?
Dialogue: 0,0:11:56.08,0:11:59.08,Default,,0,0,0,,Осы уақытқа дейін сонда
Dialogue: 0,0:11:56.08,0:11:59.08,Default,,0,0,0,,Өйткені бұл біздің клуб бөлмесі болатын.
Dialogue: 0,0:11:59.08,0:12:02.25,Default,,0,0,0,,Енді сіздің қалауыңыз бойынша
Dialogue: 0,0:11:59.08,0:12:02.25,Default,,0,0,0,,Орынды өзгерту мүмкін емес
Dialogue: 0,0:12:02.25,0:12:05.93,Default,,0,0,0,,Менің бөлмем менің қолымда.
Dialogue: 0,0:12:02.25,0:12:05.93,Default,,0,0,0,,Мен бос болғым келеді.
Dialogue: 0,0:12:05.93,0:12:07.93,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:12:07.93,0:12:11.93,Default,,0,0,0,,О
Dialogue: 0,0:12:07.93,0:12:11.93,Default,,0,0,0,,Қайырлы таң, Иори-кун
Dialogue: 0,0:12:11.93,0:12:13.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:13.93,0:12:16.77,Default,,0,0,0,,Сен бүгін киім киіп жүрсің ғой, солай ма?
Dialogue: 0,0:12:13.93,0:12:16.77,Default,,0,0,0,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:12:16.77,0:12:19.10,Default,,0,0,0,,Бұл өте қажет емес комплимент.
Dialogue: 0,0:12:19.10,0:12:24.28,Default,,0,0,0,,Бұл үйірме әрекеті ме?
Dialogue: 0,0:12:19.10,0:12:24.28,Default,,0,0,0,,Иә, мен жаңадан келген студенттермен жеңіл істегім келді.
Dialogue: 0,0:12:24.28,0:12:26.78,Default,,0,0,0,,Қанша жаңа оқушы кірді?
Dialogue: 0,0:12:26.78,0:12:29.95,Default,,0,0,0,,Әзірге 3 адам бар.
Dialogue: 0,0:12:29.95,0:12:31.95,Default,,0,0,0,,Жаңа студенттер!
Dialogue: 0,0:12:31.95,0:12:33.95,Default,,0,0,0,,Бүгін жақсы жиналдыңдар.
Dialogue: 0,0:12:33.95,0:12:36.12,Default,,0,0,0,,Бұл үшеуің бе?
Dialogue: 0,0:12:36.12,0:12:38.79,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:12:36.12,0:12:38.79,Default,,0,0,0,,Кохэй шындап қатысып жатыр ма?
Dialogue: 0,0:12:38.79,0:12:40.96,Default,,0,0,0,,Мен ағамнан шұғыл шақыру қағазын алдым.
Dialogue: 0,0:12:40.96,0:12:42.96,Default,,0,0,0,,Керемет!
Dialogue: 0,0:12:42.96,0:12:44.96,Default,,0,0,0,,Мен мұның жақсы екеніне сенімдімін.
Dialogue: 0,0:12:44.96,0:12:46.97,Default,,0,0,0,,Шынымен!?
Dialogue: 0,0:12:44.96,0:12:46.97,Default,,0,0,0,,Хмм, бұл тамаша.
Dialogue: 0,0:12:46.97,0:12:50.47,Default,,0,0,0,,Эй, эй, бәрібір.
Dialogue: 0,0:12:46.97,0:12:50.47,Default,,0,0,0,,Мұндай бос сөзге алданып қалмаңыз
Dialogue: 0,0:12:50.47,0:12:54.14,Default,,0,0,0,,♬~
Dialogue: 0,0:12:50.47,0:12:54.14,Default,,0,0,0,,Иә! Шынымен жылап жатырсың ба!? Сол жаста!
Dialogue: 0,0:12:54.14,0:12:58.41,Default,,0,0,0,,Кая-чан соңғы кездері бос емес сияқты.
Dialogue: 0,0:12:54.14,0:12:58.41,Default,,0,0,0,,Біраз уақыт келе алмайсың.
Dialogue: 0,0:12:58.41,0:13:01.08,Default,,0,0,0,,Осылайша
Dialogue: 0,0:12:58.41,0:13:01.08,Default,,0,0,0,,Сіз мұнда жиі келетін сияқтысыз...
Dialogue: 0,0:13:01.08,0:13:03.92,Default,,0,0,0,,Иә, келдім.
Dialogue: 0,0:13:01.08,0:13:03.92,Default,,0,0,0,,Шынымен!?
Dialogue: 0,0:13:03.92,0:13:06.92,Default,,0,0,0,,Иә, шынымен
Dialogue: 0,0:13:03.92,0:13:06.92,Default,,0,0,0,,Мұнда атақты адамдар да жиі келеді.
Dialogue: 0,0:13:06.92,0:13:09.59,Default,,0,0,0,,Айтыңыз
Dialogue: 0,0:13:06.92,0:13:09.59,Default,,0,0,0,,Сіз мені тағы да алдамақшы болған шығарсыз!
Dialogue: 0,0:13:09.59,0:13:12.09,Default,,0,0,0,,Уууу... Өтірік айтпаймын.
Dialogue: 0,0:13:12.09,0:13:14.59,Default,,0,0,0,,Дәлелсіз сенуге болмайды
Dialogue: 0,0:13:14.59,0:13:17.60,Default,,0,0,0,,Егер бұл оның дымқыл костюмі болса
Dialogue: 0,0:13:14.59,0:13:17.60,Default,,0,0,0,,Мына жерде.
Dialogue: 0,0:13:17.60,0:13:19.77,Default,,0,0,0,,Хмм... Бұл суға арналған киім бе?
Dialogue: 0,0:13:19.77,0:13:22.27,Default,,0,0,0,,Сіз дәм татқыңыз келе ме?
Dialogue: 0,0:13:22.27,0:13:25.60,Default,,0,0,0,,Уау...
Dialogue: 0,0:13:22.27,0:13:25.60,Default,,0,0,0,,Еш ойланбастан бұрмалау туралы мәлімдеме.
Dialogue: 0,0:13:25.60,0:13:27.61,Default,,0,0,0,,Мен өзімді жігерлендіріп отырмын!
Dialogue: 0,0:13:27.61,0:13:31.28,Default,,0,0,0,,Маған дайвинг туралы айтып беріңізші!
Dialogue: 0,0:13:27.61,0:13:31.28,Default,,0,0,0,,Хмм, маған қалдырыңыз!
Dialogue: 0,0:13:31.28,0:13:33.95,Default,,0,0,0,,Мен де қатысуым керек пе?
Dialogue: 0,0:13:33.95,0:13:37.45,Default,,0,0,0,,Чиса-чан тәжірибелі адам қажет емес пе?
Dialogue: 0,0:13:37.45,0:13:39.45,Default,,0,0,0,,Ондай жағдайда мен қатыспаймын.
Dialogue: 0,0:13:39.45,0:13:41.45,Default,,0,0,0,,Чиса да қатысуы керек.
Dialogue: 0,0:13:41.45,0:13:43.96,Default,,0,0,0,,Жаңадан бастағандардың мінез-құлқын зерттеу
Dialogue: 0,0:13:41.45,0:13:43.96,Default,,0,0,0,,Бұл маңызды.
Dialogue: 0,0:13:43.96,0:13:47.63,Default,,0,0,0,,Е...
Dialogue: 0,0:13:43.96,0:13:47.63,Default,,0,0,0,,Мен экскурсия жасай аламын ба?
Dialogue: 0,0:13:47.63,0:13:50.80,Default,,0,0,0,,Не? Жағдайың нашар ма?
Dialogue: 0,0:13:47.63,0:13:50.80,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:13:50.80,0:13:53.80,Default,,0,0,0,,О, соны айтып тұрсың ба?
Dialogue: 0,0:13:53.80,0:13:57.07,Default,,0,0,0,,Мен жүзе алмаймын. Сол себепті...
Dialogue: 0,0:13:57.07,0:14:00.41,Default,,0,0,0,,Don't worry about that.
Dialogue: 0,0:13:57.07,0:14:00.41,Default,,0,0,0,,Маған бәрібір!
Dialogue: 0,0:14:00.41,0:14:04.58,Default,,0,0,0,,Тіпті жүзе алмайтын сүңгуірлер де бар.
Dialogue: 0,0:14:00.41,0:14:04.58,Default,,0,0,0,,Жоқ, бірақ...
Dialogue: 0,0:14:04.58,0:14:07.75,Default,,0,0,0,,Сіз оны қолданбай тұрып
Dialogue: 0,0:14:04.58,0:14:07.75,Default,,0,0,0,,Оны көп жоққа шығармаңыз.
Dialogue: 0,0:14:07.75,0:14:09.75,Default,,0,0,0,,Бұл ысырап
Dialogue: 0,0:14:09.75,0:14:12.25,Default,,0,0,0,,Осыншама көп айтсаң
Dialogue: 0,0:14:14.25,0:14:16.76,Default,,0,0,0,,Сонымен бүгін
Dialogue: 0,0:14:14.25,0:14:16.76,Default,,0,0,0,,Сонымен қатар демалыс➡︎ ретінде де қызмет етеді
Dialogue: 0,0:14:16.76,0:14:18.92,Default,,0,0,0,,Жүзуді жаттықтыру
Dialogue: 0,0:14:16.76,0:14:18.92,Default,,0,0,0,,Не? Дәл қазір ➡︎
Dialogue: 0,0:14:18.92,0:14:21.26,Default,,0,0,0,,“You don’t have to be able to swim.”
Dialogue: 0,0:14:18.92,0:14:21.26,Default,,0,0,0,,Мен айттым...
Dialogue: 0,0:14:21.26,0:14:24.26,Default,,0,0,0,,Жүзу техникасының өзі
Dialogue: 0,0:14:21.26,0:14:24.26,Default,,0,0,0,,Not very important
Dialogue: 0,0:14:24.26,0:14:26.43,Default,,0,0,0,,Суға үйрену маңызды.
Dialogue: 0,0:14:26.43,0:14:31.10,Default,,0,0,0,,А...
Dialogue: 0,0:14:26.43,0:14:31.10,Default,,0,0,0,,Okay, let's get into our swimsuits!
Dialogue: 0,0:14:31.10,0:14:33.27,Default,,0,0,0,,Do I change my clothes too?
Dialogue: 0,0:14:33.27,0:14:35.77,Default,,0,0,0,,Мен солай ойлаймын.
Dialogue: 0,0:14:35.77,0:14:37.78,Default,,0,0,0,,Қысқасы➡︎
Dialogue: 0,0:14:37.78,0:14:41.11,Default,,0,0,0,,Those who can't swim
Dialogue: 0,0:14:37.78,0:14:41.11,Default,,0,0,0,,Мен судан қорқамын.
Dialogue: 0,0:14:41.11,0:14:43.28,Default,,0,0,0,,Дайвингте
Dialogue: 0,0:14:41.11,0:14:43.28,Default,,0,0,0,,Бұл жаман нәрсе.
Dialogue: 0,0:14:43.28,0:14:46.62,Default,,0,0,0,,I can't understand the story.
Dialogue: 0,0:14:43.28,0:14:46.62,Default,,0,0,0,,Аяқ киіміңізді киіп бере аласыз ба?
Dialogue: 0,0:14:46.62,0:14:51.12,Default,,0,0,0,,If you have a fear of water
Dialogue: 0,0:14:46.62,0:14:51.12,Default,,0,0,0,,Easy to panic when faced with trouble
Dialogue: 0,0:14:51.12,0:14:55.56,Default,,0,0,0,,Then you won't be able to breathe efficiently.
Dialogue: 0,0:14:51.12,0:14:55.56,Default,,0,0,0,,Ауа шығыны артады.
Dialogue: 0,0:14:55.56,0:14:59.40,Default,,0,0,0,,This is also related to safety.
Dialogue: 0,0:14:55.56,0:14:59.40,Default,,0,0,0,,Мен сізге дұрыс жаттығуды беремін.
Dialogue: 0,0:14:59.40,0:15:03.40,Default,,0,0,0,,Мен таң қалдым
Dialogue: 0,0:14:59.40,0:15:03.40,Default,,0,0,0,,You're serious about diving.
Dialogue: 0,0:15:03.40,0:15:07.57,Default,,0,0,0,,If you understand, quickly change your clothes.
Dialogue: 0,0:15:03.40,0:15:07.57,Default,,0,0,0,,А...
Dialogue: 0,0:15:07.57,0:15:10.41,Default,,0,0,0,,Okay, let's get started.
Dialogue: 0,0:15:10.41,0:15:15.41,Default,,0,0,0,,Iori, you are the basic of basics.
Dialogue: 0,0:15:10.41,0:15:15.41,Default,,0,0,0,,Су астында көзді ашуға жаттығу.
Dialogue: 0,0:15:15.41,0:15:17.58,Default,,0,0,0,,Eyes underwater...
Dialogue: 0,0:15:17.58,0:15:20.75,Default,,0,0,0,,This is where you can rest your feet.
Dialogue: 0,0:15:17.58,0:15:20.75,Default,,0,0,0,,Оны сенімді түрде қолданып көріңіз
Dialogue: 0,0:15:20.75,0:15:22.75,Default,,0,0,0,,Шынайы сезімдері мен нағыз болмысын жасырып
Dialogue: 0,0:15:26.59,0:15:30.29,Default,,0,0,0,,《Жарайды, көзімді аша алмаймын.
Dialogue: 0,0:15:26.59,0:15:30.29,Default,,0,0,0,,Isn’t it easy》
Dialogue: 0,0:15:33.10,0:15:35.60,Default,,0,0,0,,Буха! Хахаха...
Dialogue: 0,0:15:35.60,0:15:38.27,Default,,0,0,0,,No good?
Dialogue: 0,0:15:35.60,0:15:38.27,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:15:38.27,0:15:40.27,Default,,0,0,0,,Содан кейін осыны пайдаланып көріңіз.
Dialogue: 0,0:15:42.94,0:15:46.78,Default,,0,0,0,,Сіз де жабдықты пайдаланып жаттығыңыз келе ме?
Dialogue: 0,0:15:42.94,0:15:46.78,Default,,0,0,0,,Иә
Dialogue: 0,0:15:46.78,0:15:49.62,Default,,0,0,0,,Сонда қорқыныш сезімі
Dialogue: 0,0:15:46.78,0:15:49.62,Default,,0,0,0,,Ол қатты өшеді, солай ма?
Dialogue: 0,0:15:49.62,0:15:51.62,Default,,0,0,0,,Иә
Dialogue: 0,0:15:54.79,0:15:57.06,Default,,0,0,0,,《Мен бейтаныс дыбысты естимін.
Dialogue: 0,0:15:57.06,0:15:59.89,Default,,0,0,0,,Тыныс ала алмай, қозғалуы қиын
Dialogue: 0,0:15:59.89,0:16:02.39,Default,,0,0,0,,Бірақ көздер қысымда емес.
Dialogue: 0,0:16:02.39,0:16:04.56,Default,,0,0,0,,Ішке су кірген жоқ.
Dialogue: 0,0:16:04.56,0:16:07.06,Default,,0,0,0,,Осы арқылы сіз көзіңізді аша аласыз...》
Dialogue: 0,0:16:13.74,0:16:16.91,Default,,0,0,0,,Чип… Чип, чип!
Dialogue: 0,0:16:13.74,0:16:16.91,Default,,0,0,0,,Су асты табиғаты тамаша емес пе?
Dialogue: 0,0:16:16.91,0:16:21.25,Default,,0,0,0,,I have a lifetime
Dialogue: 0,0:16:16.91,0:16:21.25,Default,,0,0,0,,Су астында ол жұмыс істемеуі мүмкін
Dialogue: 0,0:16:21.25,0:16:23.58,Default,,0,0,0,,Сіз кенеттен не істеп жатырсыз?
Dialogue: 0,0:16:23.58,0:16:26.08,Default,,0,0,0,,Жабдық өшіп қалса да
Dialogue: 0,0:16:23.58,0:16:26.08,Default,,0,0,0,,Дүрбелеңге түспеу үшін жаттығу жасаңыз!
Dialogue: 0,0:16:26.08,0:16:28.09,Default,,0,0,0,,Егер мен оны алып тастасам, бұл Goggle болар еді!
Dialogue: 0,0:16:28.09,0:16:30.76,Default,,0,0,0,,Жарайды, мұны істейік.
Dialogue: 0,0:16:30.76,0:16:32.76,Default,,0,0,0,,Сіз ваннаны қабылдағаныңыз жақсы, солай ма?
Dialogue: 0,0:16:32.76,0:16:36.06,Default,,0,0,0,,Иә
Dialogue: 0,0:16:32.76,0:16:36.06,Default,,0,0,0,,Маған ұнайды.
Dialogue: 0,0:16:41.43,0:16:45.33,Default,,0,0,0,,《Егер ол бәрібір сүңгуір болса
Dialogue: 0,0:16:41.43,0:16:45.33,Default,,0,0,0,,Бассейндегі шомылу костюмі...》
Dialogue: 0,0:16:52.44,0:16:54.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:58.05,0:17:00.05,Default,,0,0,0,,Сіз қалай ойлайсыз? Иори
Dialogue: 0,0:17:00.05,0:17:03.75,Default,,0,0,0,,Хм, ештеңе... а
Dialogue: 0,0:17:05.72,0:17:07.73,Default,,0,0,0,,Жоқ, күте тұрыңыз, олай емес!
Dialogue: 0,0:17:07.73,0:17:10.90,Default,,0,0,0,,This is training!
Dialogue: 0,0:17:07.73,0:17:10.90,Default,,0,0,0,,, right? аға!
Dialogue: 0,0:17:10.90,0:17:12.90,Default,,0,0,0,,But you too
Dialogue: 0,0:17:10.90,0:17:12.90,Default,,0,0,0,,Киіміңізді шешкенді ұнатасыз.
Dialogue: 0,0:17:12.90,0:17:14.90,Default,,0,0,0,,Сенпай!?
Dialogue: 0,0:17:14.90,0:17:16.90,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:17:19.07,0:17:21.07,Default,,0,0,0,,Менде экспозицияның дәмі жоқ!
Dialogue: 0,0:17:21.07,0:17:23.08,Default,,0,0,0,,Түсінесіз бе? Чиса!
Dialogue: 0,0:17:23.08,0:17:25.08,Default,,0,0,0,,Сонымен не істеп жатырсың?
Dialogue: 0,0:17:25.08,0:17:27.25,Default,,0,0,0,,Иориді суға дағдыландыру үшін арнайы дайындық.
Dialogue: 0,0:17:27.25,0:17:29.75,Default,,0,0,0,,Бұл сенсің ғой, иә?
Dialogue: 0,0:17:27.25,0:17:29.75,Default,,0,0,0,,Сіз мені тыңдамайсыз!?
Dialogue: 0,0:17:29.75,0:17:33.09,Default,,0,0,0,,For now, I
Dialogue: 0,0:17:29.75,0:17:33.09,Default,,0,0,0,,Мен ол жақта экскурсия жасап жатырмын.
Dialogue: 0,0:17:33.09,0:17:35.09,Default,,0,0,0,,Мен бұзық емеспін...
Dialogue: 0,0:17:35.09,0:17:37.42,Default,,0,0,0,,Жүр, Иори, жалғастырайық.
Dialogue: 0,0:17:37.42,0:17:40.09,Default,,0,0,0,,Судан ләззат алу
Dialogue: 0,0:17:37.42,0:17:40.09,Default,,0,0,0,,Барымызды салайық!
Dialogue: 0,0:17:40.09,0:17:42.09,Default,,0,0,0,,Суда…
Dialogue: 0,0:17:44.76,0:17:49.86,Default,,0,0,0,,Жоқ, шынымды айтсам, мен су астындамын.
Dialogue: 0,0:17:44.76,0:17:49.86,Default,,0,0,0,,Мен қызығушылық жоғалтты деп ойлаймын...
Dialogue: 0,0:17:56.54,0:18:00.71,Default,,0,0,0,,Сіз қалай ойлайсыз? Иори-кун
Dialogue: 0,0:17:56.54,0:18:00.71,Default,,0,0,0,,Сіз суда болудан ләззат аламын деп ойлайсыз ба?
Dialogue: 0,0:18:00.71,0:18:02.71,Default,,0,0,0,,Жоқ, мүлде емес.
Dialogue: 0,0:18:02.71,0:18:05.55,Default,,0,0,0,,Менімен бірге
Dialogue: 0,0:18:02.71,0:18:05.55,Default,,0,0,0,,Біраз уақытқа далаға шыққыңыз келе ме?
Dialogue: 0,0:18:05.55,0:18:07.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:07.89,0:18:10.89,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:18:10.89,0:18:14.23,Default,,0,0,0,,Ой, түнде аквариум дегеніміз не?
Dialogue: 0,0:18:10.89,0:18:14.23,Default,,0,0,0,,Керемет емес пе?
Dialogue: 0,0:18:14.23,0:18:16.73,Default,,0,0,0,,Бұл жұмбақ сияқты.
Dialogue: 0,0:18:16.73,0:18:20.73,Default,,0,0,0,,Бірақ жабылу уақыты өтіп кетті.
Dialogue: 0,0:18:16.73,0:18:20.73,Default,,0,0,0,,Мені қалай кіргіздің?
Dialogue: 0,0:18:20.73,0:18:23.90,Default,,0,0,0,,Чиса-чан кейде
Dialogue: 0,0:18:20.73,0:18:23.90,Default,,0,0,0,,Мен сізге көмектесуге келдім.
Dialogue: 0,0:18:23.90,0:18:26.60,Default,,0,0,0,,Көмек керек пе?
Dialogue: 0,0:18:23.90,0:18:26.60,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:18:29.41,0:18:32.81,Default,,0,0,0,,Эй, Чиза, сен осылай істейсің.
Dialogue: 0,0:18:36.58,0:18:38.75,Default,,0,0,0,,Бейне мүлде басқа.
Dialogue: 0,0:18:38.75,0:18:42.42,Default,,0,0,0,,О, бұл Иори-кун.
Dialogue: 0,0:18:38.75,0:18:42.42,Default,,0,0,0,,Бір ғажабы, көретін көзің жоқ.
Dialogue: 0,0:18:42.42,0:18:45.82,Default,,0,0,0,,Чиса-чан
Dialogue: 0,0:18:42.42,0:18:45.82,Default,,0,0,0,,Бұл өте танымал
Dialogue: 0,0:18:48.26,0:18:50.60,Default,,0,0,0,,М хоббиі бар адамдар
Dialogue: 0,0:18:48.26,0:18:50.60,Default,,0,0,0,,Олар өте көп.
Dialogue: 0,0:18:50.60,0:18:52.93,Default,,0,0,0,,Менің айтайын дегенім бұл емес...
Dialogue: 0,0:18:52.93,0:18:54.93,Default,,0,0,0,,Чиса-чан жақсы қыз.
Dialogue: 0,0:18:54.93,0:18:57.37,Default,,0,0,0,,Мен шыншыл емеспін.
Dialogue: 0,0:18:54.93,0:18:57.37,Default,,0,0,0,,Мен ыңғайсызмын➡︎
Dialogue: 0,0:18:57.37,0:19:01.71,Default,,0,0,0,,Сүйкімді және мейірімді
Dialogue: 0,0:18:57.37,0:19:01.71,Default,,0,0,0,,Жұмсақ, иісі жақсы.
Dialogue: 0,0:19:01.71,0:19:04.21,Default,,0,0,0,,Мұның бәрі мен білмейтін нәрселер.
Dialogue: 0,0:19:06.21,0:19:10.55,Default,,0,0,0,,Мүмкін мен де балықты зерттеп көруім керек шығар.
Dialogue: 0,0:19:06.21,0:19:10.55,Default,,0,0,0,,Сізге ұнады ма?
Dialogue: 0,0:19:10.55,0:19:14.72,Default,,0,0,0,,Жоқ
Dialogue: 0,0:19:10.55,0:19:14.72,Default,,0,0,0,,Менің ойымша, суда болу қызықты болады.
Dialogue: 0,0:19:14.72,0:19:19.06,Default,,0,0,0,,Аа, бұл солай. Хмм...
Dialogue: 0,0:19:19.06,0:19:22.76,Default,,0,0,0,,Иори-кун
Dialogue: 0,0:19:19.06,0:19:22.76,Default,,0,0,0,,Менің ойымша, сіз тым қатты ойлап отырсыз.
Dialogue: 0,0:19:24.73,0:19:26.73,Default,,0,0,0,,Бұл дәл өткен жолымен бірдей, кішкентай сорлы!
Dialogue: 0,0:19:26.73,0:19:29.74,Default,,0,0,0,,Бұл дұрыс емес, мен және Чиса Чан.
Dialogue: 0,0:19:26.73,0:19:29.74,Default,,0,0,0,,Мен ешқашан ойламаған нәрселер
Dialogue: 0,0:19:29.74,0:19:33.24,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:19:29.74,0:19:33.24,Default,,0,0,0,,Екеуі де жүзуді және балық аулауды жақсы біледі...
Dialogue: 0,0:19:33.24,0:19:36.58,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:19:33.24,0:19:36.58,Default,,0,0,0,,Алдымен әркім жүзе алмайды➡︎
Dialogue: 0,0:19:36.58,0:19:38.58,Default,,0,0,0,,Балық туралы сіз білмейтін нәрселер
Dialogue: 0,0:19:38.58,0:19:41.91,Default,,0,0,0,,Сонымен, ең алдымен
Dialogue: 0,0:19:38.58,0:19:41.91,Default,,0,0,0,,Мен мұны қарапайым сезінгеніңізді қалаймын.
Dialogue: 0,0:19:41.91,0:19:44.42,Default,,0,0,0,,Сіз оны сезе аласыз ба? Не?
Dialogue: 0,0:19:44.42,0:19:47.59,Default,,0,0,0,,Не болса да
Dialogue: 0,0:19:44.42,0:19:47.59,Default,,0,0,0,,Қиын деп ойламаңыз➡︎
Dialogue: 0,0:19:47.59,0:19:53.79,Default,,0,0,0,,Басыңызды тазалаңыз
Dialogue: 0,0:19:47.59,0:19:53.79,Default,,0,0,0,,Мұндай су асты әлемі...
Dialogue: 0,0:19:59.26,0:20:02.77,Default,,0,0,0,,А...
Dialogue: 0,0:19:59.26,0:20:02.77,Default,,0,0,0,,Бұл таңқаларлық емес пе?
Dialogue: 0,0:20:02.77,0:20:06.10,Default,,0,0,0,,Бұл су астындағы әлем
Dialogue: 0,0:20:06.10,0:20:09.61,Default,,0,0,0,,Жоқ
Dialogue: 0,0:20:06.10,0:20:09.61,Default,,0,0,0,,Бұл әлі су астында жатқан әлем.
Dialogue: 0,0:20:09.61,0:20:11.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:11.61,0:20:13.78,Default,,0,0,0,,Осы жерден әлемге
Dialogue: 0,0:20:11.61,0:20:13.78,Default,,0,0,0,,Тағы да таңғажайып пейзаж➡︎
Dialogue: 0,0:20:13.78,0:20:16.62,Default,,0,0,0,,Бүкіл денеңмен сезінетін жер
Dialogue: 0,0:20:13.78,0:20:16.62,Default,,0,0,0,,Өйткені бар
Dialogue: 0,0:20:16.62,0:20:19.79,Default,,0,0,0,,Толығырақ осы жерден...
Dialogue: 0,0:20:19.79,0:20:24.12,Default,,0,0,0,,Негізі, Иори-кун осында.
Dialogue: 0,0:20:19.79,0:20:24.12,Default,,0,0,0,,Оны алып кетуімді сұраған адам➡︎ болды
Dialogue: 0,0:20:24.12,0:20:28.13,Default,,0,0,0,,Бұл Чиса Чан.
Dialogue: 0,0:20:24.12,0:20:28.13,Default,,0,0,0,,Не, Чиса? Неліктен?
Dialogue: 0,0:20:28.13,0:20:32.30,Default,,0,0,0,,Дайвингті жақсы көреді
Dialogue: 0,0:20:28.13,0:20:32.30,Default,,0,0,0,,Оның болғанын қалағандықтан емес пе?
Dialogue: 0,0:20:32.30,0:20:34.30,Default,,0,0,0,,Неліктен олай істедің?
Dialogue: 0,0:20:34.30,0:20:36.80,Default,,0,0,0,,Себебі мен мұны білгеніңізді қалаймын.
Dialogue: 0,0:20:36.80,0:20:39.64,Default,,0,0,0,,Суда Иори жақсы емес нәрселер бар➡︎
Dialogue: 0,0:20:39.64,0:20:42.81,Default,,0,0,0,,Өте көп
Dialogue: 0,0:20:39.64,0:20:42.81,Default,,0,0,0,,Керемет дүние бар
Dialogue: 0,0:20:42.81,0:20:45.81,Default,,0,0,0,,Токита-кун мен Котобуки-кун да солай.
Dialogue: 0,0:20:45.81,0:20:49.15,Default,,0,0,0,,Сондықтан да көп
Dialogue: 0,0:20:45.81,0:20:49.15,Default,,0,0,0,,Мен қатты сүңгуді ұсынамын.
Dialogue: 0,0:20:49.15,0:20:51.15,Default,,0,0,0,,《Мен түсіндім.
Dialogue: 0,0:20:51.15,0:20:55.75,Default,,0,0,0,,Әркім өзіне ұнайтын нәрсені ұнатады.
Dialogue: 0,0:20:51.15,0:20:55.75,Default,,0,0,0,,Мені басқалардың қабылдамауын қаламаймын
Dialogue: 0,0:20:55.75,0:20:57.76,Default,,0,0,0,,Мен толқуымды бөліскім келеді
Dialogue: 0,0:20:57.76,0:21:01.59,Default,,0,0,0,,Мұндай достар
Dialogue: 0,0:20:57.76,0:21:01.59,Default,,0,0,0,,Кем дегенде бір адам жақсырақ
Dialogue: 0,0:21:01.59,0:21:05.60,Default,,0,0,0,,Бұл мен үшін қызық, басқа адамға да қызық.
Dialogue: 0,0:21:05.60,0:21:09.10,Default,,0,0,0,,Мен де, Иори-кун.
Dialogue: 0,0:21:05.60,0:21:09.10,Default,,0,0,0,,Су қорқынышты болса да➡︎
Dialogue: 0,0:21:09.10,0:21:11.77,Default,,0,0,0,,Бұл бәрі емес
Dialogue: 0,0:21:09.10,0:21:11.77,Default,,0,0,0,,Сіз түсінесіз деп үміттенемін.
Dialogue: 0,0:21:11.77,0:21:14.11,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:21:14.11,0:21:18.11,Default,,0,0,0,,Мен аздап қызығушылық таныта бастадым.
Dialogue: 0,0:21:18.11,0:21:22.91,Default,,0,0,0,,Мен көремін. Бұл да мені қуантады.
Dialogue: 0,0:21:27.79,0:21:31.29,Default,,0,0,0,,Киса
Dialogue: 0,0:21:27.79,0:21:31.29,Default,,0,0,0,,Не?
Dialogue: 0,0:21:31.29,0:21:33.46,Default,,0,0,0,,Иә. Бұл кәдесый.
Dialogue: 0,0:21:33.46,0:21:37.80,Default,,0,0,0,,Мен ол аквариумға неше рет бардым?
Dialogue: 0,0:21:33.46,0:21:37.80,Default,,0,0,0,,Сіз өттім деп ойлайсыз ба?
Dialogue: 0,0:21:37.80,0:21:41.80,Default,,0,0,0,,Мен ризамын.
Dialogue: 0,0:21:37.80,0:21:41.80,Default,,0,0,0,,Тек күресуге арналған құрал.
Dialogue: 0,0:21:41.80,0:21:43.80,Default,,0,0,0,,Мені сонда➡︎ апарыңыз
Dialogue: 0,0:21:43.80,0:21:46.14,Default,,0,0,0,,Нанака-санға
Dialogue: 0,0:21:43.80,0:21:46.14,Default,,0,0,0,,Сіз мұны сұрадыңыз, солай ма?
Dialogue: 0,0:21:46.14,0:21:49.98,Default,,0,0,0,,Суға түсу кезінде суға түсу
Dialogue: 0,0:21:46.14,0:21:49.98,Default,,0,0,0,,Өйткені бұл мүйізтұмсық
Dialogue: 0,0:21:49.98,0:21:52.31,Default,,0,0,0,,көремін. Мен мұны бәрібір жасаймын.
Dialogue: 0,0:21:52.31,0:21:55.25,Default,,0,0,0,,Хмм
Dialogue: 0,0:21:52.31,0:21:55.25,Default,,0,0,0,,А, дұрыс. Мен қалаған DVD бүгін шықты.
Dialogue: 0,0:21:55.25,0:21:57.75,Default,,0,0,0,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,0:21:55.25,0:21:57.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:57.75,0:21:59.75,Default,,0,0,0,,Сонда қалай болды?
Dialogue: 0,0:21:59.75,0:22:02.75,Default,,0,0,0,,Не?
Dialogue: 0,0:21:59.75,0:22:02.75,Default,,0,0,0,,Суда
Dialogue: 0,0:22:02.75,0:22:04.76,Default,,0,0,0,,Хмм... Солай деп ойлаймын.
Dialogue: 0,0:22:04.76,0:22:07.43,Default,,0,0,0,,Мен өзімді әлі де жақсы емес сияқты сезінемін➡︎
Dialogue: 0,0:22:07.43,0:22:10.26,Default,,0,0,0,,Сізде туған күніңізді растайтын құжат бар ма?
Dialogue: 0,0:22:07.43,0:22:10.26,Default,,0,0,0,,Толығырақ қарағыңыз келе ме?
Dialogue: 0,0:22:10.26,0:22:12.26,Default,,0,0,0,,Ахсо
Dialogue: 0,0:22:12.26,0:22:14.27,Default,,0,0,0,,Сондықтан бұл сыйлық
Dialogue: 0,0:22:14.27,0:22:16.77,Default,,0,0,0,,Рахмет, Чиса
Dialogue: 0,0:22:16.77,0:22:18.77,Default,,0,0,0,,А... сәл күте тұрыңыз.
Dialogue: 0,0:22:22.27,0:22:26.27,Default,,0,0,0,,Сонда одан да сүйкімді нәрсе
Dialogue: 0,0:22:22.27,0:22:26.27,Default,,0,0,0,,Оны маған бер, ақымақ.
Dialogue: 0,0:22:27.77,0:22:33.77,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
