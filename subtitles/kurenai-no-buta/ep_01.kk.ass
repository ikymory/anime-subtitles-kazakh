Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:46.37,0:00:49.21,Default,,0,0,0,,Бұл жұмыс оңай емес, білесің бе!
Dialogue: 0,0:01:23.24,0:01:25.87,Default,,0,0,0,,(Толқындардың дыбысы)
Dialogue: 0,0:01:27.41,0:01:30.92,Default,,0,0,0,,(радиодан музыка)
Dialogue: 0,0:01:55.23,0:01:58.03,Default,,0,0,0,,«Кино»
Dialogue: 0,0:02:00.11,0:02:01.78,Default,,0,0,0,,Оңтүстік Италиядағы Неаполис қаласы.
Dialogue: 0,0:02:14.21,0:02:15.04,Default,,0,0,0,,…Жоғары
Dialogue: 0,0:02:15.25,0:02:18.59,Default,,0,0,0,,Порко Россо! Қазір ұшып кетіңіз, Маммаюто тобы келді.
Dialogue: 0,0:02:18.67,0:02:22.51,Default,,0,0,0,,Маммут? Арзан жұмыс жасамаңыз
Dialogue: 0,0:02:23.01,0:02:26.81,Default,,0,0,0,,Тау-кен өндіруші компанияның жалақысын алып жүрген Венециядан жалдамалы кеме нысанаға алынды.
Dialogue: 0,0:02:26.89,0:02:27.85,Default,,0,0,0,,Барлығы осы ма?
Dialogue: 0,0:02:27.93,0:02:29.77,Default,,0,0,0,,Не? Жоқ, бұл...
Dialogue: 0,0:02:30.39,0:02:32.81,Default,,0,0,0,,Қыздар мектебінің демалыста жүрген оқушылары бортта.
Dialogue: 0,0:02:33.98,0:02:35.56,Default,,0,0,0,,Бұл біраз қымбат.
Dialogue: 0,0:02:35.86,0:02:37.61,Default,,0,0,0,,Шарттың 14-бабының 3-тармағы қолданылады.
Dialogue: 0,0:02:37.69,0:02:39.03,Default,,0,0,0,,4-параграф.
Dialogue: 0,0:02:39.11,0:02:40.53,Default,,0,0,0,,(Шыншыл музыка)
Dialogue: 0,0:02:40.61,0:02:41.74,Default,,0,0,0,,Оу!
Dialogue: 0,0:02:42.53,0:02:43.45,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:02:43.99,0:02:46.45,Default,,0,0,0,,Тоқтатпасаң, мен сені суға батырамын! Тоқта!
Dialogue: 0,0:02:46.53,0:02:47.99,Default,,0,0,0,,Ұрланған
Dialogue: 0,0:02:48.08,0:02:48.83,Default,,0,0,0,,Бұл қарақшы
Dialogue: 0,0:02:48.91,0:02:51.33,Default,,0,0,0,,Олар қарақшылар емес, олар аспан қарақшылары.
Dialogue: 0,0:03:04.80,0:03:07.31,Default,,0,0,0,,(қозғалтқыштың айналу дыбысы)
Dialogue: 0,0:03:15.61,0:03:16.48,Default,,0,0,0,,(Порко жөтел дыбысы)
Dialogue: 0,0:03:17.19,0:03:20.53,Default,,0,0,0,,Хехе, күрделі жөндеудің уақыты келді деп ойлаймын.
Dialogue: 0,0:03:53.02,0:03:54.56,Default,,0,0,0,,Сіз зұлым адамдарсыз ба?
Dialogue: 0,0:03:54.64,0:03:55.69,Default,,0,0,0,,Мисс Бекки қамалда тұрады
Dialogue: 0,0:03:55.77,0:03:58.27,Default,,0,0,0,,Біз кепілміз. (мүше) Дұрыс.
Dialogue: 0,0:03:58.36,0:03:59.82,Default,,0,0,0,,Оны аспан қарақшысы деп атайды.
Dialogue: 0,0:03:59.90,0:04:00.73,Default,,0,0,0,,Сіз өте жақсы білесіз.
Dialogue: 0,0:04:01.23,0:04:02.49,Default,,0,0,0,,Қаңқа! (2-қыз) Өте керемет
Dialogue: 0,0:04:02.57,0:04:03.32,Default,,0,0,0,,Сен жақсысың.
Dialogue: 0,0:04:03.40,0:04:05.03,Default,,0,0,0,,Тез кел
Dialogue: 0,0:04:05.53,0:04:07.12,Default,,0,0,0,,Ол қазірдің өзінде бос емес.
Dialogue: 0,0:04:07.78,0:04:10.49,Default,,0,0,0,,15 адам бар, бірақ барлығын әкелесің бе?
Dialogue: 0,0:04:10.58,0:04:13.04,Default,,0,0,0,,Біреуді елден шығарғаныңыз үшін ренжімейсіз бе?
Dialogue: 0,0:04:28.60,0:04:31.18,Default,,0,0,0,,Маңызы бар деп саналатын бір куәгерлік көрсету бар
Dialogue: 0,0:04:32.22,0:04:33.02,Default,,0,0,0,,Тым кеш!
Dialogue: 0,0:04:33.68,0:04:36.44,Default,,0,0,0,,Қызды және алтын теңгелерді ұрлап кетті!
Dialogue: 0,0:04:36.52,0:04:38.31,Default,,0,0,0,,Қайтарыңыз!
Dialogue: 0,0:04:39.02,0:04:41.11,Default,,0,0,0,,Ол жерде кетті!
Dialogue: 0,0:04:49.62,0:04:52.33,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:04:53.45,0:04:54.70,Default,,0,0,0,,Сіз қателесе алмайсыз.
Dialogue: 0,0:04:54.79,0:04:56.25,Default,,0,0,0,,Мен олардың айлаларын білемін
Dialogue: 0,0:04:56.66,0:04:59.42,Default,,0,0,0,,Оны көрмейінше ұшыңыз, содан кейін бірден бағытты өзгертіңіз.
Dialogue: 0,0:04:59.83,0:05:03.67,Default,,0,0,0,,Олар кедей және сараң болғандықтан, олар жанармайдың ақысын құлықсыз төлеп, осы маңдағы аралға кетті...
Dialogue: 0,0:05:06.34,0:05:07.18,Default,,0,0,0,,Бұл жолы атаның намысын қорғауға қалдырайын.
Dialogue: 0,0:05:07.38,0:05:08.30,Default,,0,0,0,,Барма.
Dialogue: 0,0:05:16.68,0:05:17.69,Default,,0,0,0,,Бұл!
Dialogue: 0,0:05:31.95,0:05:33.70,Default,,0,0,0,,Менің уақытым көп емес шығар...
Dialogue: 0,0:05:38.83,0:05:39.87,Default,,0,0,0,,Мен оны жек көремін!
Dialogue: 0,0:05:54.10,0:05:57.35,Default,,0,0,0,,Бұл не? Бұл аралға секіруге арналған көрікті қайық емес пе?
Dialogue: 0,0:05:57.60,0:05:58.27,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:05:58.69,0:06:00.65,Default,,0,0,0,,Шошқалар! Эй шошқа!
Dialogue: 0,0:06:00.73,0:06:02.90,Default,,0,0,0,,Шошқа! Сүйкімді!
Dialogue: 0,0:06:03.44,0:06:05.48,Default,,0,0,0,,Сіз осындай жерде ойнаған кезде...
Dialogue: 0,0:06:05.57,0:06:07.65,Default,,0,0,0,,Сізді бір топ ұрлап әкетеді!
Dialogue: 0,0:06:11.07,0:06:13.03,Default,,0,0,0,,Керемет!
Dialogue: 0,0:06:20.67,0:06:23.71,Default,,0,0,0,,(Балалардың сыбдырлаған дыбыстары)
Dialogue: 0,0:06:26.30,0:06:28.55,Default,,0,0,0,,Шулы
Dialogue: 0,0:06:28.63,0:06:29.92,Default,,0,0,0,,Ұшу!
Dialogue: 0,0:06:30.01,0:06:30.88,Default,,0,0,0,,Маған көрсет Маған көрсет
Dialogue: 0,0:06:30.97,0:06:32.43,Default,,0,0,0,,Эй, жоқ!
Dialogue: 0,0:06:32.51,0:06:33.18,Default,,0,0,0,,Қорқынышты!
Dialogue: 0,0:06:33.26,0:06:35.85,Default,,0,0,0,,Тыныш, тыныш бол!
Dialogue: 0,0:06:36.14,0:06:37.22,Default,,0,0,0,,Эй, бірдеңе істе.
Dialogue: 0,0:06:37.64,0:06:41.94,Default,,0,0,0,,Сондықтан мен бәрін өзіңізбен бірге алып кетесіз бе деп сұрадым... А...
Dialogue: 0,0:06:42.94,0:06:44.11,Default,,0,0,0,,Кішкене ғана.
Dialogue: 0,0:06:44.69,0:06:46.07,Default,,0,0,0,,Өйткені сіз шынымен де жасамауыңыз керек.
Dialogue: 0,0:06:47.02,0:06:48.23,Default,,0,0,0,,Бұл әдемі.
Dialogue: 0,0:06:48.69,0:06:51.28,Default,,0,0,0,,Қараңдаршы, қызыл ұшақ!
Dialogue: 0,0:06:51.90,0:06:53.57,Default,,0,0,0,,Қай жерде?
Dialogue: 0,0:06:53.66,0:06:54.66,Default,,0,0,0,,Ол сонда болды.
Dialogue: 0,0:06:54.99,0:06:55.78,Default,,0,0,0,,Сәлем
Dialogue: 0,0:07:00.66,0:07:02.12,Default,,0,0,0,,Мен енді өзімді ұстамаймын
Dialogue: 0,0:07:04.42,0:07:05.50,Default,,0,0,0,,Бұл Койл деген жігіт шын мәнінде пайдалы ма?
Dialogue: 0,0:07:06.59,0:07:08.50,Default,,0,0,0,,Бұл Порко Россо! (Қыздар) Мен көрмеймін
Dialogue: 0,0:07:13.72,0:07:15.64,Default,,0,0,0,,А, жоқ!
Dialogue: 0,0:07:15.72,0:07:16.55,Default,,0,0,0,,Ол тоқтады.
Dialogue: 0,0:07:16.64,0:07:17.76,Default,,0,0,0,,Күз!
Dialogue: 0,0:07:17.85,0:07:19.64,Default,,0,0,0,,Құлап қалмаңыз! Тағы бір ату бар
Dialogue: 0,0:07:23.69,0:07:25.77,Default,,0,0,0,,Ештеңе, не деген.
Dialogue: 0,0:07:25.86,0:07:27.61,Default,,0,0,0,,Уте Уте! Орналыңыз!
Dialogue: 0,0:07:27.69,0:07:29.86,Default,,0,0,0,,Бұл күшті, қызыл ұшақ
Dialogue: 0,0:07:34.20,0:07:35.07,Default,,0,0,0,,Дұрыс емес.
Dialogue: 0,0:07:35.16,0:07:36.20,Default,,0,0,0,,Бұл кедергі емес.
Dialogue: 0,0:07:43.50,0:07:46.13,Default,,0,0,0,,«Омае но Некеда» шошқасының сигналы
Dialogue: 0,0:07:46.21,0:07:47.17,Default,,0,0,0,,«Ертегіні тыңда»
Dialogue: 0,0:07:47.25,0:07:47.92,Default,,0,0,0,,Шу!
Dialogue: 0,0:07:52.17,0:07:54.80,Default,,0,0,0,,Кел, кел, мұнда кел, басыңды и!
Dialogue: 0,0:07:57.47,0:07:58.68,Default,,0,0,0,,Қайда бардың?
Dialogue: 0,0:07:58.76,0:08:00.10,Default,,0,0,0,,А, бұл жасырын.
Dialogue: 0,0:08:01.22,0:08:02.18,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:06.52,0:08:07.27,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:11.40,0:08:12.94,Default,,0,0,0,,Кя, мен құладым!
Dialogue: 0,0:08:13.03,0:08:15.36,Default,,0,0,0,,Ол батып бара жатыр! Батып бара жатыр!
Dialogue: 0,0:08:15.45,0:08:16.11,Default,,0,0,0,,Ик!
Dialogue: 0,0:08:16.20,0:08:18.53,Default,,0,0,0,,Бұл суға батпайтын ұшатын қайық!
Dialogue: 0,0:08:19.41,0:08:21.08,Default,,0,0,0,,О, ау!
Dialogue: 0,0:08:24.46,0:08:26.12,Default,,0,0,0,,Уау! Батып бара жатыр!
Dialogue: 0,0:08:26.75,0:08:27.71,Default,,0,0,0,,О, тоқтат.
Dialogue: 0,0:08:27.79,0:08:28.96,Default,,0,0,0,,Қауіпті! (Теңізші) Ол суға батпайды.
Dialogue: 0,0:08:29.34,0:08:31.63,Default,,0,0,0,,Тоқта! Ол маңызды кепіл.
Dialogue: 0,0:08:31.71,0:08:32.92,Default,,0,0,0,,Қарсымын!
Dialogue: 0,0:08:33.01,0:08:35.38,Default,,0,0,0,,Өйткені біз жүзу үйірмесінің мүшесіміз.
Dialogue: 0,0:08:35.47,0:08:36.84,Default,,0,0,0,,Бұл басқаша.
Dialogue: 0,0:08:36.93,0:08:38.01,Default,,0,0,0,,Мен де
Dialogue: 0,0:08:38.09,0:08:40.18,Default,,0,0,0,,Шошқадан тағы да байланыс!
Dialogue: 0,0:08:41.01,0:08:43.27,Default,,0,0,0,,«Жарты алтын монета»
Dialogue: 0,0:08:43.35,0:08:46.19,Default,,0,0,0,,«Кепілге алынғандардың қалғандары артта қалды».
Dialogue: 0,0:08:46.77,0:08:49.19,Default,,0,0,0,,Әйтпесе бәріңді өлтіремін.
Dialogue: 0,0:08:49.56,0:08:50.65,Default,,0,0,0,,Онда былай делінген...
Dialogue: 0,0:08:50.73,0:08:52.65,Default,,0,0,0,,Жарты алтын тиын? (Маммут Босс) Шу!
Dialogue: 0,0:08:53.28,0:08:55.99,Default,,0,0,0,,Кел, шошқа! Бұл соңғы шайқас!
Dialogue: 0,0:09:01.70,0:09:02.66,Default,,0,0,0,,Бұл кішкентай вакуумдық торнадоның соңғы әсері!
Dialogue: 0,0:09:03.37,0:09:04.04,Default,,0,0,0,,Бұл
Dialogue: 0,0:09:05.37,0:09:06.62,Default,,0,0,0,,Сынған
Dialogue: 0,0:09:06.71,0:09:08.08,Default,,0,0,0,,Қосан Даа Қосан
Dialogue: 0,0:09:09.21,0:09:09.92,Default,,0,0,0,,Бұл Коу-сан.
Dialogue: 0,0:09:15.05,0:09:18.26,Default,,0,0,0,,Қош бол, ертең кездескенше
Dialogue: 0,0:09:18.34,0:09:20.14,Default,,0,0,0,,Сайонара
Dialogue: 0,0:09:20.22,0:09:22.64,Default,,0,0,0,,Бұл жақсы. Менде әлі жөндеуге ақша қалды.
Dialogue: 0,0:09:22.72,0:09:25.06,Default,,0,0,0,,Бакааро, жүрегің үлкенірек
Dialogue: 0,0:09:25.14,0:09:26.35,Default,,0,0,0,,Жақында кездескенше
Dialogue: 0,0:09:26.43,0:09:28.69,Default,,0,0,0,,Қош бол, сау бол
Dialogue: 0,0:09:31.98,0:09:32.82,Default,,0,0,0,,Мүмкін мен де байқап көрермін.
Dialogue: 0,0:09:33.44,0:09:34.82,Default,,0,0,0,,Тыныш бол!
Dialogue: 0,0:09:36.57,0:09:38.95,Default,,0,0,0,,Әй, ол жаққа тартпа, сынып қалады.
Dialogue: 0,0:09:42.62,0:09:44.12,Default,,0,0,0,,Қауіпті Пропеллерге жақындамаңыз
Dialogue: 0,0:09:44.24,0:09:45.79,Default,,0,0,0,,Піс. Қандай зәр?
Dialogue: 0,0:09:45.91,0:09:47.46,Default,,0,0,0,,Сол жерде жасаңыз!
Dialogue: 0,0:09:48.16,0:09:50.75,Default,,0,0,0,,«Порко Россоның жеңіс әнұраны қайтадан»
Dialogue: 0,0:09:51.96,0:09:54.46,Default,,0,0,0,,Манмают балалар, бүгін келе алмайсыңдар.
Dialogue: 0,0:09:54.55,0:09:58.84,Default,,0,0,0,,Шүкір, сен сондай батыр екенсің, жүлдені алғансың!
Dialogue: 0,0:09:59.22,0:10:02.26,Default,,0,0,0,,Бірақ екінші адам американдық шығар.
Dialogue: 0,0:10:02.35,0:10:04.43,Default,,0,0,0,,Америкалықтардан көмек сұрау...
Dialogue: 0,0:10:04.51,0:10:06.60,Default,,0,0,0,,Бұл Адрианың ұшатын қайығына масқара.
Dialogue: 0,0:10:06.68,0:10:10.52,Default,,0,0,0,,Оның әжесі 1/4 итальяндық.
Dialogue: 0,0:10:10.60,0:10:13.77,Default,,0,0,0,,Қалай болғанда да, егер Порко туралы бірдеңе жасамасақ, бәріңіз де қиыншылықта боласыз...
Dialogue: 0,0:10:13.86,0:10:14.69,Default,,0,0,0,,(Қол дыбысы)
Dialogue: 0,0:10:14.77,0:10:16.94,Default,,0,0,0,,Бірақ 10% шектен тыс (Кертис)
Dialogue: 0,0:10:17.53,0:10:19.24,Default,,0,0,0,,(фортепиано дыбысы)
Dialogue: 0,0:10:20.15,0:10:24.95,Default,,0,0,0,,♪~
Dialogue: 0,0:10:38.97,0:10:40.55,Default,,0,0,0,,(сыбырлаған дауыс)
Dialogue: 0,0:10:40.63,0:10:41.72,Default,,0,0,0,,Әдемі...
Dialogue: 0,0:11:21.05,0:11:23.47,Default,,0,0,0,,«Адриана қонақ үйі»
Dialogue: 0,0:11:48.87,0:11:49.95,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:11:50.62,0:11:55.62,Default,,0,0,0,,~♪
Dialogue: 0,0:12:01.21,0:12:02.17,Default,,0,0,0,,келді
Dialogue: 0,0:12:02.59,0:12:04.51,Default,,0,0,0,,Жасайық. Бұл жаман нәрсе.
Dialogue: 0,0:12:04.59,0:12:06.68,Default,,0,0,0,,Керемет жігіт (Кертис)
Dialogue: 0,0:12:08.64,0:12:13.35,Default,,0,0,0,,♪~
Dialogue: 0,0:12:17.23,0:12:19.82,Default,,0,0,0,,~♪
Dialogue: 0,0:12:20.40,0:12:22.94,Default,,0,0,0,,Порко Россо мырза, Нептун тілшісі.
Dialogue: 0,0:12:23.28,0:12:25.28,Default,,0,0,0,,Бұл жолы да жақсы орындадың.
Dialogue: 0,0:12:25.36,0:12:28.03,Default,,0,0,0,,Маммут тобы біраз уақытқа дейін қалпына келе алмайды.
Dialogue: 0,0:12:28.12,0:12:31.12,Default,,0,0,0,,Айтпақшы, биылғы жалпы жүлде қоры туралы болжамдар қандай?
Dialogue: 0,0:12:31.20,0:12:33.29,Default,,0,0,0,,Менің ойымша, бұл өткен жылғыдан сәл артық болады...
Dialogue: 0,0:12:33.37,0:12:35.87,Default,,0,0,0,,Жарайды, мені жіберіңізші...
Dialogue: 0,0:12:36.29,0:12:37.79,Default,,0,0,0,,Әттең! Уф!
Dialogue: 0,0:12:38.71,0:12:40.13,Default,,0,0,0,,Ән тыныш естіледі
Dialogue: 0,0:12:40.21,0:12:41.09,Default,,0,0,0,,Көзге тию
Dialogue: 0,0:12:41.17,0:12:43.80,Default,,0,0,0,,(Қол дыбысы)
Dialogue: 0,0:12:49.97,0:12:51.39,Default,,0,0,0,,Ол керемет адам.
Dialogue: 0,0:12:52.31,0:12:54.23,Default,,0,0,0,,Адриано қонақ үйіндегі Джина ханым...
Dialogue: 0,0:12:54.31,0:12:57.06,Default,,0,0,0,,Бұл елдегі ұшатын қайықтар арасында да танымал.
Dialogue: 0,0:12:57.48,0:13:00.69,Default,,0,0,0,,Онда аспандағы қарақшылар мен аңшылар жақсы балалар екен.
Dialogue: 0,0:13:01.36,0:13:03.03,Default,,0,0,0,,Алдыңғыдағы Кертис жақсы адам ма?
Dialogue: 0,0:13:03.69,0:13:07.24,Default,,0,0,0,,Әй, атақ пен ақша әкелетін бақытты жылан.
Dialogue: 0,0:13:08.07,0:13:11.62,Default,,0,0,0,,Шнайдер кубогында екі жыл қатарынан итальяндық қайықтарды жеңген қайық.
Dialogue: 0,0:13:12.20,0:13:15.16,Default,,0,0,0,,Бұл жылдамдықта ғана емес, әуедегі ұрыста да күшті.
Dialogue: 0,0:13:16.04,0:13:17.79,Default,,0,0,0,,Бұл жерде ол Порко Россо деп аталады.
Dialogue: 0,0:13:17.87,0:13:19.92,Default,,0,0,0,,Шошқа өз атын сатып жатқан жоқ па?
Dialogue: 0,0:13:20.79,0:13:23.46,Default,,0,0,0,,Егер сіз аспан қарақшыларымен бірігетін болсаңыз, абай болыңыз.
Dialogue: 0,0:13:24.21,0:13:25.88,Default,,0,0,0,,Олар сараң, кедей.
Dialogue: 0,0:13:26.38,0:13:28.22,Default,,0,0,0,,Мен тіпті еденге қосыла алмаймын, сондықтан ұят.
Dialogue: 0,0:13:28.43,0:13:30.51,Default,,0,0,0,,Хи хи, әрине
Dialogue: 0,0:13:30.93,0:13:33.43,Default,,0,0,0,,Не! Кусаре шошқа етін жасайық!
Dialogue: 0,0:13:33.51,0:13:36.18,Default,,0,0,0,,Ей, бүгін түнде мұнда тамаша адамдар көп.
Dialogue: 0,0:13:36.27,0:13:38.06,Default,,0,0,0,,Сізде тағы да жақсылық жоқ па?
Dialogue: 0,0:13:39.19,0:13:40.02,Default,,0,0,0,,Дегенмен, меніңше, Кира осы екі нәрсенің бірін білмейді.
Dialogue: 0,0:13:40.73,0:13:43.94,Default,,0,0,0,,Сенің келгеніңе қуаныштымын, бірақ соғыс деп есіңді жима.
Dialogue: 0,0:13:44.53,0:13:46.15,Default,,0,0,0,,Мен білемін, Джина.
Dialogue: 0,0:13:46.24,0:13:48.95,Default,,0,0,0,,Мен бұл дүкеннен 50 шақырым жерде жұмыс істемеймін.
Dialogue: 0,0:13:49.36,0:13:51.70,Default,,0,0,0,,Ол тіпті шошқалармен жақсы тіл табысады.
Dialogue: 0,0:13:51.78,0:13:52.49,Default,,0,0,0,,Иә?О
Dialogue: 0,0:13:54.49,0:13:55.49,Default,,0,0,0,,Барлығы жақсы бала.
Dialogue: 0,0:13:56.00,0:13:57.08,Default,,0,0,0,,Қайта кездескенше
Dialogue: 0,0:14:05.63,0:14:07.42,Default,,0,0,0,,Әй, Темее! (Аспан қарақшыларының айқайлаған дыбысы)
Dialogue: 0,0:14:07.51,0:14:09.76,Default,,0,0,0,,Порко, маған ертегі айтып берші
Dialogue: 0,0:14:09.84,0:14:11.39,Default,,0,0,0,,Келесі жолы біз жалғыз боламыз
Dialogue: 0,0:14:17.22,0:14:18.35,Default,,0,0,0,,Ай!
Dialogue: 0,0:14:21.02,0:14:22.77,Default,,0,0,0,,Бұл американдық біртүрлі.
Dialogue: 0,0:14:24.48,0:14:26.69,Default,,0,0,0,,Ол менің бетімді көре сала: «Өтінемін, мені тепсеңші» деді.
Dialogue: 0,0:14:27.69,0:14:29.28,Default,,0,0,0,,Сондықтан мен саған айттым.
Dialogue: 0,0:14:29.36,0:14:31.70,Default,,0,0,0,,Мен ұшатын қайықпен үш рет соғыстым.
Dialogue: 0,0:14:32.24,0:14:34.91,Default,,0,0,0,,Біреуі соғыста, бірі Атлант мұхитында
Dialogue: 0,0:14:34.99,0:14:36.95,Default,,0,0,0,,Азияда соңғы адам қайтыс болды...
Dialogue: 0,0:14:41.54,0:14:42.46,Default,,0,0,0,,Түсіндіңіз бе?
Dialogue: 0,0:14:44.08,0:14:45.42,Default,,0,0,0,,Бүгін саяхат болды.
Dialogue: 0,0:14:46.00,0:14:48.63,Default,,0,0,0,,Бенгал жерінен ұлу табылды дейді.
Dialogue: 0,0:14:56.35,0:14:57.60,Default,,0,0,0,,Мен үш жыл күттім.
Dialogue: 0,0:14:57.97,0:14:59.56,Default,,0,0,0,,Ол құрғақ
Dialogue: 0,0:14:59.64,0:15:01.23,Default,,0,0,0,,(тыныш музыка)
Dialogue: 0,0:15:01.31,0:15:02.98,Default,,0,0,0,,Жақсы жігіттердің бәрі өледі
Dialogue: 0,0:15:04.40,0:15:05.06,Default,,0,0,0,,Менің досыма...
Dialogue: 0,0:15:06.82,0:15:09.44,Default,,0,0,0,,Марко, әрқашан жанымда болғаныңыз үшін рахмет.
Dialogue: 0,0:15:16.83,0:15:19.50,Default,,0,0,0,,Енді сен жалғыз ескі доссың...
Dialogue: 0,0:15:21.79,0:15:23.79,Default,,0,0,0,,Бұл дүкенде маған ұнамайтын бір нәрсе
Dialogue: 0,0:15:24.58,0:15:26.00,Default,,0,0,0,,Бұл фотосуретті жоймаңыз.
Dialogue: 0,0:15:27.21,0:15:28.50,Default,,0,0,0,,Жоқ, оны жыртып алмаңыз.
Dialogue: 0,0:15:28.80,0:15:32.68,Default,,0,0,0,,Бұл Марконың адам болған кездегі жалғыз суреті.
Dialogue: 0,0:15:36.10,0:15:39.89,Default,,0,0,0,,Саған жасалған сиқырды қалай жоюға болады деп ойлаймын.
Dialogue: 0,0:16:00.41,0:16:03.33,Default,,0,0,0,,Осылай жасайық Америка, бұл жақсы нәрсе...
Dialogue: 0,0:16:14.05,0:16:16.43,Default,,0,0,0,,(Музыкалық топтың орындауы)
Dialogue: 0,0:16:32.36,0:16:33.32,Default,,0,0,0,,Мен қызғанамын
Dialogue: 0,0:16:33.82,0:16:36.28,Default,,0,0,0,,Мен де осыншама ақшаны жұмсағым келеді.
Dialogue: 0,0:16:37.36,0:16:38.28,Default,,0,0,0,,Осы айдағы ас
Dialogue: 0,0:16:38.95,0:16:41.24,Default,,0,0,0,,Ұшатын қайық несиесі аяқталды
Dialogue: 0,0:16:41.49,0:16:42.33,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:16:42.54,0:16:46.12,Default,,0,0,0,,Патриоттық несие сұрап елге үлес қоспаңыз, т.б.
Dialogue: 0,0:16:46.71,0:16:49.25,Default,,0,0,0,,Олай емес, адамдар арасында.
Dialogue: 0,0:16:50.50,0:16:53.26,Default,,0,0,0,,(Халықтың айқайы)
Dialogue: 0,0:17:02.39,0:17:03.89,Default,,0,0,0,,(берілістердің айналуының механикалық дыбысы)
Dialogue: 0,0:17:06.27,0:17:08.44,Default,,0,0,0,,Қош келдіңіз, Порко Россо мырза, ол дайын.
Dialogue: 0,0:17:09.02,0:17:10.48,Default,,0,0,0,,Маған 60 доп беріңіз
Dialogue: 0,0:17:10.56,0:17:11.36,Default,,0,0,0,,Иә
Dialogue: 0,0:17:13.53,0:17:14.99,Default,,0,0,0,,Бұл жерде өте көңілсіз.
Dialogue: 0,0:17:15.65,0:17:16.65,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:17:17.20,0:17:18.95,Default,,0,0,0,,Үкімет қайтадан ауысады ма?
Dialogue: 0,0:17:19.03,0:17:22.62,Default,,0,0,0,,Олай болса, сіз де жақында заңды боласыз.
Dialogue: 0,0:17:23.54,0:17:25.12,Default,,0,0,0,,Шошқалардың елі немесе заңдары жоқ.
Dialogue: 0,0:17:25.66,0:17:29.67,Default,,0,0,0,,Хи хи хи, бұл маңызды емес, меңдермен бірдей Хи хи
Dialogue: 0,0:17:32.38,0:17:33.71,Default,,0,0,0,,Жай ғана әдеттегіні пайдалану дұрыс па?
Dialogue: 0,0:17:33.96,0:17:36.59,Default,,0,0,0,,Біздің қоймада сонымен қатар жоғары өнімді тұтандырғыш және броньды тесіп өтетін оқтар бар.
Dialogue: 0,0:17:36.67,0:17:39.84,Default,,0,0,0,,Садақтар: Біз соғысып жатқан жоқпыз.
Dialogue: 0,0:17:40.05,0:17:41.05,Default,,0,0,0,,Біз бұны Ятоға да қолдана аламыз—
Dialogue: 0,0:17:41.76,0:17:42.72,Default,,0,0,0,,Майдо!
Dialogue: 0,0:17:45.22,0:17:46.10,Default,,0,0,0,,Мастер
Dialogue: 0,0:17:46.52,0:17:48.69,Default,,0,0,0,,Соғыс пен жүлде алудың айырмашылығы неде?
Dialogue: 0,0:17:48.94,0:17:52.15,Default,,0,0,0,,Әй, соғыста ақша тапқандар жауыз.
Dialogue: 0,0:17:52.23,0:17:55.32,Default,,0,0,0,,Жүлде ақшасымен ақша таба алмайтындар қабілетсіз.
Dialogue: 0,0:17:57.19,0:18:00.41,Default,,0,0,0,,Несиені ұрлаған аспан қарақшысы тіпті сурет емес.
Dialogue: 0,0:18:00.49,0:18:01.57,Default,,0,0,0,,Мен көмектесе алмаймын.
Dialogue: 0,0:18:02.07,0:18:04.12,Default,,0,0,0,,Жөндеу шығындары жоғары болды.
Dialogue: 0,0:18:04.74,0:18:06.50,Default,,0,0,0,,Бұл одақтың қайығы!
Dialogue: 0,0:18:13.54,0:18:14.55,Default,,0,0,0,,Таку!
Dialogue: 0,0:18:14.63,0:18:17.84,Default,,0,0,0,,Мен неге мұндай ақымақ адамдармен араласа алмаймын?
Dialogue: 0,0:18:17.92,0:18:19.59,Default,,0,0,0,,Бұл шошқаның кінәсі. Шошқа...
Dialogue: 0,0:18:20.38,0:18:23.30,Default,,0,0,0,,Бұл не? Маммаюто жігіттері, бояуға да ақша төлемейсіңдер ме?
Dialogue: 0,0:18:24.10,0:18:25.43,Default,,0,0,0,,Бұл болмас еді...
Dialogue: 0,0:18:26.56,0:18:28.48,Default,,0,0,0,,Соңында барлығы бітті.
Dialogue: 0,0:18:29.18,0:18:31.81,Default,,0,0,0,,Эй, сенің артыңда не бар? Америкаға келесіз бе?
Dialogue: 0,0:18:32.69,0:18:34.27,Default,,0,0,0,,Қазір күнде
Dialogue: 0,0:18:34.48,0:18:36.57,Default,,0,0,0,,Мен теорияны ұстанамын.
Dialogue: 0,0:18:43.49,0:18:44.83,Default,,0,0,0,,(морзе кодын жіберетін машина дыбысы)
Dialogue: 0,0:18:44.91,0:18:46.20,Default,,0,0,0,,Мақсат табылды!
Dialogue: 0,0:18:46.49,0:18:48.41,Default,,0,0,0,,«Жерорта теңізінің патшайымы»
Dialogue: 0,0:18:48.91,0:18:51.04,Default,,0,0,0,,Сіз соншалықты үлкен нәрсе жасайсыз ба?
Dialogue: 0,0:18:51.46,0:18:54.13,Default,,0,0,0,,Топ құрғаныңыздың себебі осы емес пе? Қорықпа.
Dialogue: 0,0:18:54.96,0:18:56.71,Default,,0,0,0,,Қозғалтқыш ақаулығы
Dialogue: 0,0:18:56.80,0:18:58.63,Default,,0,0,0,,Энгосул бірінші Никакере
Dialogue: 0,0:18:58.71,0:19:00.34,Default,,0,0,0,,Темее, сен қу екенсің.
Dialogue: 0,0:19:00.42,0:19:01.63,Default,,0,0,0,,Не шешсеңіз, соны жасаңыз!
Dialogue: 0,0:19:02.63,0:19:05.14,Default,,0,0,0,,Егер ол зақымдалса, жөндеу шығындары соған тұрарлық.
Dialogue: 0,0:19:05.80,0:19:07.68,Default,,0,0,0,,Бұл қызықсыз болуы керек.
Dialogue: 0,0:19:07.77,0:19:09.64,Default,,0,0,0,,Менің ойымша, сіз оны өзіңіз төлеуіңіз керек!
Dialogue: 0,0:19:10.10,0:19:11.31,Default,,0,0,0,,Сіз экспозицияға жауаптысыз ба?
Dialogue: 0,0:19:11.31,0:19:11.89,Default,,0,0,0,,Қозғалтқыштың ақаулығы Қозғалтқыштың дұрыс жұмыс істемеуі (Әуе қарақшылары одағының басшысы E) Экспозиция үшін өзіңіз төлейсіз бе?
Dialogue: 0,0:19:11.89,0:19:11.98,Default,,0,0,0,,Қозғалтқыш ақаулығы Қозғалтқыштың дұрыс жұмыс істемеуі
Dialogue: 0,0:19:11.98,0:19:14.40,Default,,0,0,0,,Бұл анық (Әуе қарақшылары одағының басшысы F) Нашар қозғалтқыш Қозғалтқыштың дұрыс жұмыс істемеуі
Dialogue: 0,0:19:14.40,0:19:14.48,Default,,0,0,0,,Қозғалтқыш ақаулығы Қозғалтқыштың дұрыс жұмыс істемеуі
Dialogue: 0,0:19:14.48,0:19:15.27,Default,,0,0,0,,Бұл туралы естігеніңізге сенімдімін (Әуе қарақшылары одағының бастығы В) Сіз арзан конькисіз. (Әуе қарақшылары одағының басшысы F) Қозғалтқышты қарғыс атсын. Қозғалтқыштың дұрыс жұмыс істемеуі.
Dialogue: 0,0:19:15.27,0:19:16.32,Default,,0,0,0,,Бұл оқиға сонда болуы керек (Әуе қарақшылары одағының басшысы B) Сіз сараң болуыңыз керек.
Dialogue: 0,0:19:16.40,0:19:18.44,Default,,0,0,0,,Олай болмаса, құлап қалады.
Dialogue: 0,0:19:18.53,0:19:21.15,Default,,0,0,0,,Шулы, шулы!
Dialogue: 0,0:19:21.24,0:19:22.74,Default,,0,0,0,,(жолаушылар шуы)
Dialogue: 0,0:19:25.78,0:19:27.33,Default,,0,0,0,,Біз сізге хабарлаймыз
Dialogue: 0,0:19:27.41,0:19:29.08,Default,,0,0,0,,Біз сізге хабарлаймыз
Dialogue: 0,0:19:29.16,0:19:31.50,Default,,0,0,0,,Әуе қарақшылары кемені нысанаға алады
Dialogue: 0,0:19:31.58,0:19:32.96,Default,,0,0,0,,Бірақ уайымдамаңыз.
Dialogue: 0,0:19:33.75,0:19:37.00,Default,,0,0,0,,Бұл кеме классикалық әскери кемемен жабдықталған.
Dialogue: 0,0:19:37.50,0:19:40.84,Default,,0,0,0,,Екі ержүрек ұшқышты қарсы алайық.
Dialogue: 0,0:19:43.26,0:19:45.72,Default,,0,0,0,,№1 қайық Қара эстальон
Dialogue: 0,0:19:45.80,0:19:47.22,Default,,0,0,0,,Синьор Баракка
Dialogue: 0,0:19:48.60,0:19:50.72,Default,,0,0,0,,2-қайық: Тибр қасқыры
Dialogue: 0,0:19:50.81,0:19:52.35,Default,,0,0,0,,Лейтенант Висконти
Dialogue: 0,0:20:03.82,0:20:05.28,Default,,0,0,0,,Ол өзімен бірге сақшыны алып келді.
Dialogue: 0,0:20:05.36,0:20:07.20,Default,,0,0,0,,Бұны тыңдама!
Dialogue: 0,0:20:14.62,0:20:16.92,Default,,0,0,0,,А, мен оны шығарып алдым, жарайды.
Dialogue: 0,0:20:17.17,0:20:19.71,Default,,0,0,0,,Мұнда келме, Кертис!
Dialogue: 0,0:20:20.75,0:20:22.46,Default,,0,0,0,,Жарайды, күте тұрыңыз!
Dialogue: 0,0:20:36.73,0:20:37.90,Default,,0,0,0,,Бұл жолы атаның намысын қорғауға қалдырайын.
Dialogue: 0,0:20:39.98,0:20:41.73,Default,,0,0,0,,Міне, ақыры келді.
Dialogue: 0,0:20:44.24,0:20:46.49,Default,,0,0,0,,Әйтеуір, оны Миланға апарудан басқа амалым жоқ.
Dialogue: 0,0:20:52.49,0:20:54.04,Default,,0,0,0,,... атып түсірілді, бірақ
Dialogue: 0,0:20:54.12,0:20:56.46,Default,,0,0,0,,Парашютпен сәтті ұшырылды
Dialogue: 0,0:20:57.25,0:20:58.25,Default,,0,0,0,,Сол кемедегі алтын бұйымдар...
Dialogue: 0,0:20:58.33,0:21:00.29,Default,,0,0,0,,Арразарайды басып алған әуе қарақшылары альянсы...
Dialogue: 0,0:21:00.38,0:21:02.09,Default,,0,0,0,,Келесі хабарламаны қалдыру
Dialogue: 0,0:21:02.96,0:21:04.34,Default,,0,0,0,,Келесі - Оми.
Dialogue: 0,0:21:05.22,0:21:06.93,Default,,0,0,0,,Шошқа, шық!
Dialogue: 0,0:21:08.26,0:21:08.93,Default,,0,0,0,,Қайталау
Dialogue: 0,0:21:09.80,0:21:11.72,Default,,0,0,0,,«Келесі сенсің, шошқа, шық».
Dialogue: 0,0:21:12.35,0:21:13.43,Default,,0,0,0,,Осы шабуылға қатысты...
Dialogue: 0,0:21:14.35,0:21:16.52,Default,,0,0,0,,Бұлай етпе, бұл қоқыс.
Dialogue: 0,0:21:18.52,0:21:21.44,Default,,0,0,0,,Вахахаха
Dialogue: 0,0:21:22.27,0:21:24.19,Default,,0,0,0,,Кешіріңіз, мен демалыстамын.
Dialogue: 0,0:21:24.94,0:21:26.65,Default,,0,0,0,,(латын стиліндегі көңілді музыка)
Dialogue: 0,0:21:26.74,0:21:31.53,Default,,0,0,0,,Таза ақ жаймалар, сұлу келіншектер...
Dialogue: 0,0:21:38.08,0:21:40.75,Default,,0,0,0,,Мені Миланға апарыңыз, Мотор-чан.
Dialogue: 0,0:22:05.23,0:22:07.61,Default,,0,0,0,,Ауа райы қолайсыз болып кетті.
Dialogue: 0,0:22:08.03,0:22:09.95,Default,,0,0,0,,Бұлт астына өтуден басқа амалым жоқ
Dialogue: 0,0:22:17.62,0:22:19.00,Default,,0,0,0,,(мазасыз музыка)
Dialogue: 0,0:23:05.34,0:23:07.42,Default,,0,0,0,,Сен жақсы қызсың.
Dialogue: 0,0:23:11.80,0:23:14.01,Default,,0,0,0,,Дұрыс, сен жақсы қызсың, Engine-чан.
Dialogue: 0,0:23:26.02,0:23:27.65,Default,,0,0,0,,Бутта!
Dialogue: 0,0:23:35.99,0:23:37.83,Default,,0,0,0,,Бұл бір-бірден. Ұрыс!
Dialogue: 0,0:23:38.33,0:23:39.91,Default,,0,0,0,,Қазір емес.
Dialogue: 0,0:23:48.84,0:23:51.47,Default,,0,0,0,,Уайымдама, мен бәріне таратамын.
Dialogue: 0,0:23:52.01,0:23:54.01,Default,,0,0,0,,Тағы кездесейік, Американы жасайық
Dialogue: 0,0:23:54.09,0:23:56.22,Default,,0,0,0,,Вахахаха
Dialogue: 0,0:23:57.05,0:23:58.64,Default,,0,0,0,,Бар, шықты.
Dialogue: 0,0:24:01.48,0:24:02.64,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:24:03.85,0:24:04.52,Default,,0,0,0,,Мен дұрыс түсіндім.
Dialogue: 0,0:24:05.10,0:24:07.52,Default,,0,0,0,,Теменің доптарын соғуға болмайды. Бұл бұрыш.
Dialogue: 0,0:24:19.33,0:24:21.95,Default,,0,0,0,,Иә! Қазір мен де атақтымын
Dialogue: 0,0:24:22.37,0:24:23.37,Default,,0,0,0,,...
Dialogue: 0,0:24:40.68,0:24:43.81,Default,,0,0,0,,Қолым бос болса да оларға сенбеймін.
Dialogue: 0,0:24:43.89,0:24:46.23,Default,,0,0,0,,Шокоға бірдеңе болды... Ой!
Dialogue: 0,0:24:52.57,0:24:53.28,Default,,0,0,0,,болды
Dialogue: 0,0:25:11.04,0:25:13.80,Default,,0,0,0,,Бұл сөзсіз қызыл.
Dialogue: 0,0:25:15.30,0:25:18.26,Default,,0,0,0,,Мен Алабамадағы анама жақсы кәдесый жасадым.
Dialogue: 0,0:25:18.34,0:25:19.64,Default,,0,0,0,,Жооооо
Dialogue: 0,0:26:02.43,0:26:03.51,Default,,0,0,0,,Асығыңыз
Dialogue: 0,0:26:09.06,0:26:10.31,Default,,0,0,0,,Оку-сама
Dialogue: 0,0:26:11.69,0:26:14.52,Default,,0,0,0,,Құрметті Оку, мен телефондамын. Мен жақсымын.
Dialogue: 0,0:26:14.61,0:26:15.82,Default,,0,0,0,,Ол тірі болды
Dialogue: 0,0:26:15.90,0:26:16.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:26:18.07,0:26:19.74,Default,,0,0,0,,Қабылдау бөліміне қоңырау шалыңыз.
Dialogue: 0,0:26:28.20,0:26:29.58,Default,,0,0,0,,Марко Бұл сіз бе?
Dialogue: 0,0:26:29.66,0:26:32.00,Default,,0,0,0,,Жарақаттар туралы не деуге болады? Мен оны қайықпен іздеп шығайын деп едім.
Dialogue: 0,0:26:33.75,0:26:35.84,Default,,0,0,0,,Шындығында мен Хори ханымға біраз уақыттан бері ғашықпын.
Dialogue: 0,0:26:36.13,0:26:37.84,Default,,0,0,0,,Мен біраз салмақ тастадым.
Dialogue: 0,0:26:37.92,0:26:40.01,Default,,0,0,0,,Мен екі күнге жуық елсіз аралда болдым.
Dialogue: 0,0:26:40.55,0:26:43.26,Default,,0,0,0,,Мен Миланға қайықты жөндеуге барғалы жатырмын.
Dialogue: 0,0:26:44.01,0:26:47.02,Default,,0,0,0,,Егер сол американдық жігіт дүкенге келсе, маған хабарлай аласыз ба?
Dialogue: 0,0:26:47.52,0:26:49.31,Default,,0,0,0,,Келесі жолы тағы кездесейік.
Dialogue: 0,0:26:50.02,0:26:53.02,Default,,0,0,0,,Қалай ойлайсыз, адамдар хабарлар тақтасы сияқты ма?
Dialogue: 0,0:26:53.77,0:26:56.19,Default,,0,0,0,,Қанша уайымдасаңыз да, дирижабльдегі жігіттер...
Dialogue: 0,0:26:56.48,0:26:59.53,Default,,0,0,0,,Сіз әйелдерді самбашидің металл фитингтерінен басқа ештеңе деп ойлайтын шығарсыз.
Dialogue: 0,0:27:01.57,0:27:02.41,Default,,0,0,0,,Марко
Dialogue: 0,0:27:03.03,0:27:04.91,Default,,0,0,0,,Қуырылған шошқа етіне айналғалы жатыр...
Dialogue: 0,0:27:05.20,0:27:07.04,Default,,0,0,0,,Мен мұны істегім келмейді.
Dialogue: 0,0:27:09.37,0:27:11.21,Default,,0,0,0,,Ұшпайтын шошқа жай шошқа...
Dialogue: 0,0:27:11.46,0:27:12.37,Default,,0,0,0,,Идиот!
Dialogue: 0,0:27:25.85,0:27:28.77,Default,,0,0,0,,«Порко Россоның зақымдалған қызыл қанаттары: өмір немесе өлім»
Dialogue: 0,0:28:06.89,0:28:09.89,Default,,0,0,0,,Бүгін түнде келеді деп ойлап, күттім.
Dialogue: 0,0:28:09.97,0:28:11.35,Default,,0,0,0,,Бұл қайтадан қиын болады.
Dialogue: 0,0:28:11.81,0:28:13.52,Default,,0,0,0,,Сізге тағы да қатты соққы болды.
Dialogue: 0,0:28:14.44,0:28:16.81,Default,,0,0,0,,Жаңасын алу тезірек емес пе?
Dialogue: 0,0:28:17.15,0:28:18.40,Default,,0,0,0,,Бұны артта қалдырыңыз.
Dialogue: 0,0:28:19.15,0:28:20.44,Default,,0,0,0,,Мен сенің сезіміңді білемін.
Dialogue: 0,0:28:22.15,0:28:24.07,Default,,0,0,0,,Артқа шегініп, оны арқамен салыңыз.
Dialogue: 0,0:28:28.16,0:28:30.16,Default,,0,0,0,,Мына сүйкімді қыз кім?
Dialogue: 0,0:28:30.62,0:28:32.45,Default,,0,0,0,,Бұл менің Америкаға кеткен немерем.
Dialogue: 0,0:28:35.33,0:28:37.71,Default,,0,0,0,,Жарайды Жарайды
Dialogue: 0,0:28:56.69,0:28:58.35,Default,,0,0,0,,Уау, әдемі қайық
Dialogue: 0,0:28:58.73,0:28:59.90,Default,,0,0,0,,Ата, сіз әдемісіз.
Dialogue: 0,0:29:00.73,0:29:01.65,Default,,0,0,0,,Жақсы сызық
Dialogue: 0,0:29:02.36,0:29:05.78,Default,,0,0,0,,Қазір мұндай жұмысты жасайтын шеберлер жоқ.
Dialogue: 0,0:29:06.07,0:29:07.41,Default,,0,0,0,,Олар бір-біріне ұқсамайды.
Dialogue: 0,0:29:07.49,0:29:08.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:08.53,0:29:10.53,Default,,0,0,0,,Ол шынымен де қарияның немересі ме?
Dialogue: 0,0:29:10.95,0:29:12.66,Default,,0,0,0,,Маған тиіспе, а?
Dialogue: 0,0:29:16.29,0:29:17.50,Default,,0,0,0,,Фио Мен кейінірек көңіл көтеремін.
Dialogue: 0,0:29:17.58,0:29:19.08,Default,,0,0,0,,Иә, ақырында
Dialogue: 0,0:29:20.54,0:29:23.55,Default,,0,0,0,,Менің қарсыласым - Кертис. Маған тағы 15 түйін керек.
Dialogue: 0,0:29:23.96,0:29:26.67,Default,,0,0,0,,Кертис... қандай сағыныш.
Dialogue: 0,0:29:32.31,0:29:33.22,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:29:33.31,0:29:35.02,Default,,0,0,0,,Бұл Фолгор емес пе?
Dialogue: 0,0:29:35.39,0:29:36.27,Default,,0,0,0,,Менен дерек көзін сұрамаңыз
Dialogue: 0,0:29:37.10,0:29:39.77,Default,,0,0,0,,1927 жылғы Шнайдер кубогында
Dialogue: 0,0:29:39.85,0:29:42.77,Default,,0,0,0,,Бұл қайығы бар итальяндық қайық Кертистен жеңіліп қалды.
Dialogue: 0,0:29:43.44,0:29:44.98,Default,,0,0,0,,Бірақ бұл оның кінәсі емес.
Dialogue: 0,0:29:45.07,0:29:46.78,Default,,0,0,0,,Себебі механик ақымақ болды.
Dialogue: 0,0:29:48.70,0:29:50.32,Default,,0,0,0,,Мен қанды сеземін
Dialogue: 0,0:29:50.41,0:29:52.87,Default,,0,0,0,,Тым нәзік күйге келтірмеңіз
Dialogue: 0,0:29:52.95,0:29:54.41,Default,,0,0,0,,Бұл жарыс емес.
Dialogue: 0,0:29:54.87,0:29:56.00,Default,,0,0,0,,Мұндай нәрсе.
Dialogue: 0,0:29:56.08,0:29:59.17,Default,,0,0,0,,Азияда «Будда ілімін уағыздау» деп аталады.
Dialogue: 0,0:30:03.29,0:30:05.42,Default,,0,0,0,,Сізде бар ақшаны алғыңыз келе ме?
Dialogue: 0,0:30:06.05,0:30:10.68,Default,,0,0,0,,Бұл күндері менде бар нәрсе - қағаз қиындыларына ұқсайтын бір бума шоттар.
Dialogue: 0,0:30:10.97,0:30:14.56,Default,,0,0,0,,Пропеллерге, бояуға және т.б. шығындарды төлемеңіз...
Dialogue: 0,0:30:14.64,0:30:16.18,Default,,0,0,0,,Бұл үлкен шығын.
Dialogue: 0,0:30:16.27,0:30:18.35,Default,,0,0,0,,Қонақ үй шығындары, тамақтану шығындары және т.б.
Dialogue: 0,0:30:18.44,0:30:21.65,Default,,0,0,0,,Осы жерде қалуыңызға болады. Тамақтың ақысын төлеп, оны арзандатамын.
Dialogue: 0,0:30:24.23,0:30:27.19,Default,,0,0,0,,Ұлымның бетін көрмеймін. Сіз сарапшысыз ба?
Dialogue: 0,0:30:27.28,0:30:28.95,Default,,0,0,0,,Үшеуі де шықты.
Dialogue: 0,0:30:29.28,0:30:31.16,Default,,0,0,0,,Сонда жобаны кім жасайды?
Dialogue: 0,0:30:31.57,0:30:32.41,Default,,0,0,0,,Фио мұны жасайды
Dialogue: 0,0:30:33.07,0:30:33.83,Default,,0,0,0,,Фио?
Dialogue: 0,0:30:34.53,0:30:35.41,Default,,0,0,0,,Бұрынғы қызы?
Dialogue: 0,0:30:35.99,0:30:37.25,Default,,0,0,0,,Жыл жапон тілі
Dialogue: 0,0:30:37.58,0:30:40.33,Default,,0,0,0,,Фиода менің баламда жоқ нәрсе бар.
Dialogue: 0,0:30:44.54,0:30:47.17,Default,,0,0,0,,Қария, біз бұрыннан таныспыз.
Dialogue: 0,0:30:47.46,0:30:49.88,Default,,0,0,0,,Келесі жұмысты басқа біреуге тапсырамын.
Dialogue: 0,0:30:51.59,0:30:52.47,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:30:58.64,0:31:00.52,Default,,0,0,0,,Мен әйел болғандықтан уайымдап тұрсың ба?
Dialogue: 0,0:31:00.77,0:31:01.85,Default,,0,0,0,,Әлде тым анық па?
Dialogue: 0,0:31:02.69,0:31:03.90,Default,,0,0,0,,Екеуі де, қария.
Dialogue: 0,0:31:04.65,0:31:06.40,Default,,0,0,0,,Иә, әрине.
Dialogue: 0,0:31:07.11,0:31:10.90,Default,,0,0,0,,Хмм... Әй, маған жақсы ұшқыштың бірінші сабағын айтшы.
Dialogue: 0,0:31:11.65,0:31:12.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:31:12.70,0:31:13.70,Default,,0,0,0,,Тәжірибе?
Dialogue: 0,0:31:13.78,0:31:15.66,Default,,0,0,0,,Жоқ, бұл шабыт.
Dialogue: 0,0:31:16.45,0:31:18.75,Default,,0,0,0,,Маған бұл тәжірибе болды деп айтпағанына қуаныштымын...
Dialogue: 0,0:31:19.20,0:31:20.87,Default,,0,0,0,,Әй, мен атамнан сұрадым.
Dialogue: 0,0:31:20.96,0:31:23.67,Default,,0,0,0,,Сіздің жеке ұшуыңыз өте жылдам болғанын естідім.
Dialogue: 0,0:31:24.83,0:31:26.67,Default,,0,0,0,,Содан бері ол өте жақсы болды...
Dialogue: 0,0:31:27.59,0:31:30.88,Default,,0,0,0,,Бұл 1910 жыл. Мен 17 жаста едім...
Dialogue: 0,0:31:31.72,0:31:34.43,Default,,0,0,0,,17 жаста! Қазір мен сияқты
Dialogue: 0,0:31:35.39,0:31:37.39,Default,,0,0,0,,Мен әйел болуды тоқтата алмаймын, бірақ
Dialogue: 0,0:31:37.68,0:31:39.68,Default,,0,0,0,,Маған мұны істеуге рұқсат бересіз бе? Бұрынғы сызбалар да бар.
Dialogue: 0,0:31:40.35,0:31:43.69,Default,,0,0,0,,Іс дұрыс болмаса, маған ақша керек емес, ата.
Dialogue: 0,0:31:44.40,0:31:46.52,Default,,0,0,0,,Ол менің немерем, жақсы болады.
Dialogue: 0,0:31:47.15,0:31:50.19,Default,,0,0,0,,Мен қозғалтқышты 12 жасымда бөлшектедім.
Dialogue: 0,0:31:50.99,0:31:51.99,Default,,0,0,0,,Бүгін түнде осында ұйықта
Dialogue: 0,0:31:52.07,0:31:54.28,Default,,0,0,0,,Мен ертең төсегімді жинаймын, сондықтан таңғы ас 7-де болады.
Dialogue: 0,0:31:54.36,0:31:55.66,Default,,0,0,0,,Душ Ыстық су бар, сүлгі бар.
Dialogue: 0,0:31:56.03,0:31:56.91,Default,,0,0,0,,Жарайды, тікелей іске кірісейік. Шинигамиңді Мисакиге де көрсет.
Dialogue: 0,0:32:00.16,0:32:03.12,Default,,0,0,0,,Менде ақша жетпейді, бірақ бұл өткеннен жақсы нәрсе.
Dialogue: 0,0:32:03.21,0:32:05.17,Default,,0,0,0,,Қалғанын қарыз ретінде қалдырамын.
Dialogue: 0,0:32:35.70,0:32:36.61,Default,,0,0,0,,Я...
Dialogue: 0,0:32:45.12,0:32:46.00,Default,,0,0,0,,Фу
Dialogue: 0,0:32:47.17,0:32:48.54,Default,,0,0,0,,Fa~
Dialogue: 0,0:32:50.42,0:32:52.42,Default,,0,0,0,,Қайырлы таң, ұйықтадың ба?
Dialogue: 0,0:32:52.51,0:32:53.76,Default,,0,0,0,,Салқынсың ба?
Dialogue: 0,0:32:54.22,0:32:55.72,Default,,0,0,0,,Бұл дөрекі жоспар, бірақ сіз қалай ойлайсыз?
Dialogue: 0,0:32:56.38,0:32:58.30,Default,,0,0,0,,Жазық пішінді сол күйінде қалдырыңыз.
Dialogue: 0,0:32:58.39,0:33:00.39,Default,,0,0,0,,Мен жаңа масканы қолданғым келеді
Dialogue: 0,0:33:01.10,0:33:03.56,Default,,0,0,0,,Осының өзі оны 5 түйінге жылдамырақ етеді.
Dialogue: 0,0:33:04.14,0:33:06.27,Default,,0,0,0,,Мен алдыңғы сызбаны көргенде таң қалдым.
Dialogue: 0,0:33:06.73,0:33:08.73,Default,,0,0,0,,Қанаттар да ағаштан жасалған.
Dialogue: 0,0:33:09.23,0:33:10.98,Default,,0,0,0,,Бұл есептеу парағы керемет
Dialogue: 0,0:33:11.44,0:33:14.74,Default,,0,0,0,,Бұл қанатты жасаған адам шынымен ағаштардың мағынасын біледі.
Dialogue: 0,0:33:15.61,0:33:16.86,Default,,0,0,0,,Маған қатты әсер етті.
Dialogue: 0,0:33:17.36,0:33:20.66,Default,,0,0,0,,Бір ғана қайық жасалды.
Dialogue: 0,0:33:20.74,0:33:22.54,Default,,0,0,0,,Ұшу өте қауіпті.
Dialogue: 0,0:33:23.75,0:33:25.46,Default,,0,0,0,,Қоймада шаң жиналды.
Dialogue: 0,0:33:25.83,0:33:26.91,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:33:27.79,0:33:31.21,Default,,0,0,0,,Осындай қараңғы параметрмен судан оңай құтылуға болады.
Dialogue: 0,0:33:31.84,0:33:34.46,Default,,0,0,0,,Жалғыз қиындық суға түскенде.
Dialogue: 0,0:33:34.71,0:33:37.05,Default,,0,0,0,,Жылдамдыққа жетсең, қанаттары жабысады.
Dialogue: 0,0:33:37.97,0:33:41.85,Default,,0,0,0,,Қанаттардың бекіту бұрышын сызбадан 0,5 градусқа арттырыңыз.
Dialogue: 0,0:33:42.43,0:33:44.35,Default,,0,0,0,,Сіз сол күйінде жалғастыра аласыз.
Dialogue: 0,0:33:44.43,0:33:45.77,Default,,0,0,0,,Сіз маған мұны істеуге рұқсат бересіз!
Dialogue: 0,0:33:45.85,0:33:47.98,Default,,0,0,0,,Рахмет, мен өмір бойы барымды саламын.
Dialogue: 0,0:33:50.02,0:33:52.48,Default,,0,0,0,,Бірақ, Оджо-сан, бір ғана тапсырма бар.
Dialogue: 0,0:33:54.40,0:33:57.82,Default,,0,0,0,,Жалқау болмаңыз. Ресурстардың жетіспеушілігі - жақсы жұмыстың кілті.
Dialogue: 0,0:33:58.53,0:33:59.99,Default,,0,0,0,,Ал бұл сұлулық үшін жақсы емес.
Dialogue: 0,0:34:00.49,0:34:02.62,Default,,0,0,0,,Хехе... Мен мұны істеймін.
Dialogue: 0,0:34:03.91,0:34:06.33,Default,,0,0,0,,Білесің бе, жүрегім лүпілдеп тұр.
Dialogue: 0,0:34:06.41,0:34:07.87,Default,,0,0,0,,Мен ұйықтай алмадым.
Dialogue: 0,0:34:07.96,0:34:08.96,Default,,0,0,0,,Шындықты айту
Dialogue: 0,0:34:09.04,0:34:11.21,Default,,0,0,0,,Маған бұл жұмысқа рұқсат бермейді деп қорқамын.
Dialogue: 0,0:34:11.29,0:34:12.13,Default,,0,0,0,,Мен уайымдадым...
Dialogue: 0,0:34:12.21,0:34:14.55,Default,,0,0,0,,Сондықтан мен өте қуаныштымын! Мен кофе дайындаймын!
Dialogue: 0,0:34:17.34,0:34:20.59,Default,,0,0,0,,Сіз мұны өзіңіз жасай алмайсыз деп ойлаймын...
Dialogue: 0,0:34:29.31,0:34:30.94,Default,,0,0,0,,Келесі менің жиенім Моника Сейзу.
Dialogue: 0,0:34:31.02,0:34:31.90,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:34:31.98,0:34:34.61,Default,,0,0,0,,Үлкен Сильвананы аяқтау
Dialogue: 0,0:34:34.82,0:34:36.03,Default,,0,0,0,,Нағашымның қыздары
Dialogue: 0,0:34:36.11,0:34:38.44,Default,,0,0,0,,София Лаура Констанс Валентина
Dialogue: 0,0:34:39.20,0:34:40.66,Default,,0,0,0,,Фионың әпкесі Гириора
Dialogue: 0,0:34:40.74,0:34:43.03,Default,,0,0,0,,Сандра да келді ме? Кузен.
Dialogue: 0,0:34:43.12,0:34:44.66,Default,,0,0,0,,Мариетта, сен қазір әдемі көрінесің.
Dialogue: 0,0:34:45.03,0:34:46.49,Default,,0,0,0,,Баламның дұғасы
Dialogue: 0,0:34:46.58,0:34:49.66,Default,,0,0,0,,Мария Тина Анна және оның әпкесі Миретта
Dialogue: 0,0:34:50.25,0:34:51.42,Default,,0,0,0,,Порчеллино!
Dialogue: 0,0:34:51.92,0:34:53.42,Default,,0,0,0,,Баа-чан!
Dialogue: 0,0:34:54.46,0:34:55.96,Default,,0,0,0,,Мені алып кетуге әлі келген жоқсың ба?
Dialogue: 0,0:34:56.05,0:34:57.84,Default,,0,0,0,,Тағы бір… үкі ме?
Dialogue: 0,0:34:57.92,0:35:00.68,Default,,0,0,0,,Сен де жақсы адам болып кеттің.
Dialogue: 0,0:35:03.97,0:35:05.51,Default,,0,0,0,,Әжелер де жұмыс істей ме?
Dialogue: 0,0:35:05.93,0:35:07.10,Default,,0,0,0,,Иә
Dialogue: 0,0:35:07.18,0:35:09.02,Default,,0,0,0,,Мен шөбереме көмектескім келді.
Dialogue: 0,0:35:09.10,0:35:11.02,Default,,0,0,0,,Қоштасудың бір ауыз сөзін айтпай-ақ,
Dialogue: 0,0:35:15.19,0:35:17.28,Default,,0,0,0,,Бірде-бір адам жоқ.
Dialogue: 0,0:35:17.53,0:35:18.65,Default,,0,0,0,,О
Dialogue: 0,0:35:19.19,0:35:20.74,Default,,0,0,0,,Олардың барлығы әке отбасының мүшелері ме?
Dialogue: 0,0:35:21.03,0:35:23.87,Default,,0,0,0,,Дұрыс, соңғы кездері жұмысым болған жоқ.
Dialogue: 0,0:35:23.95,0:35:26.70,Default,,0,0,0,,Барлық адамдар тамақ іздеуге шықты.
Dialogue: 0,0:35:28.29,0:35:30.08,Default,,0,0,0,,Бүгінгі әлем қандай?
Dialogue: 0,0:35:30.79,0:35:35.17,Default,,0,0,0,,Уайымдама, әйелдер жақсы. Олар тынымсыз еңбек етеді, табанды.
Dialogue: 0,0:35:35.88,0:35:38.46,Default,,0,0,0,,Мен құймақ жасамаймын.
Dialogue: 0,0:35:41.55,0:35:42.84,Default,,0,0,0,,(Кенеттен бәрі тынышталып қалады)
Dialogue: 0,0:35:46.97,0:35:49.10,Default,,0,0,0,,Көктегі Құдайымыз
Dialogue: 0,0:35:49.18,0:35:53.39,Default,,0,0,0,,Мен босанғанша отбасыма нан беріп, жұмыс жасадың.
Dialogue: 0,0:35:53.48,0:35:55.40,Default,,0,0,0,,Әйелдің көмегімен жауынгерлік қайықты құрастыру
Dialogue: 0,0:35:55.48,0:35:58.48,Default,,0,0,0,,Жақсылығыңыз үшін кешіріңіз.
Dialogue: 0,0:35:58.57,0:35:59.23,Default,,0,0,0,,Аумин
Dialogue: 0,0:36:00.28,0:36:01.74,Default,,0,0,0,,(Әйелдің күлкісі)
Dialogue: 0,0:36:02.53,0:36:05.62,Default,,0,0,0,,Кел, жақсы тамақтанып, еңбектенейік!
Dialogue: 0,0:36:06.78,0:36:07.83,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:36:07.91,0:36:09.66,Default,,0,0,0,,(Қозғалтқыштың дірілдеуінен кабинаның дыбысы)
Dialogue: 0,0:36:15.96,0:36:18.92,Default,,0,0,0,,Бұл жақсы естіледі. Бұл қозғалтқыш хит.
Dialogue: 0,0:36:26.14,0:36:28.43,Default,,0,0,0,,Сіз қалай ойлайсыз? Менің ойымша, бұл жақсы айналады.
Dialogue: 0,0:36:28.51,0:36:30.18,Default,,0,0,0,,Бұл туралы алаңдамаңыз
Dialogue: 0,0:36:30.26,0:36:31.93,Default,,0,0,0,,Саятшылық ұшып кетеді
Dialogue: 0,0:36:32.73,0:36:36.15,Default,,0,0,0,,О? Мен Кертиске мән бермеймін.
Dialogue: 0,0:37:04.59,0:37:07.01,Default,,0,0,0,,«Біз несие алмаймыз!»
Dialogue: 0,0:37:07.09,0:37:09.30,Default,,0,0,0,,Умм, бұл сөзсіз жақсы идея.
Dialogue: 0,0:37:09.39,0:37:11.10,Default,,0,0,0,,Өтінемін!
Dialogue: 0,0:37:11.89,0:37:13.02,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:37:13.77,0:37:15.89,Default,,0,0,0,,Бұл қымбат.
Dialogue: 0,0:37:16.48,0:37:20.06,Default,,0,0,0,,Маған көптеген сұраулар келіп түсті, себебі менде бюджет артық.
Dialogue: 0,0:37:20.36,0:37:22.02,Default,,0,0,0,,Спонсорым болса екен...
Dialogue: 0,0:37:24.36,0:37:25.03,Default,,0,0,0,,Порко…
Dialogue: 0,0:37:27.78,0:37:31.28,Default,,0,0,0,,Жарайды, олай адамдарға қарама. Қалағаныңды істе.
Dialogue: 0,0:37:31.95,0:37:32.91,Default,,0,0,0,,Иә!
Dialogue: 0,0:37:32.99,0:37:35.66,Default,,0,0,0,,Мен зауытпен сөйлесіп қойдым және бірден тапсырыс беремін.
Dialogue: 0,0:37:36.37,0:37:37.79,Default,,0,0,0,,Мен Порконы жақсы көремін!
Dialogue: 0,0:37:42.17,0:37:44.13,Default,,0,0,0,,Әйтеуір 3 ай күтемін.
Dialogue: 0,0:37:44.51,0:37:46.63,Default,,0,0,0,,Сіз аспан қарақшысы болу үшін жұмысыңызды өзгертесіз бе?
Dialogue: 0,0:37:47.17,0:37:49.09,Default,,0,0,0,,Сен жақсы қызсың ғой, солай ма?
Dialogue: 0,0:37:49.34,0:37:50.47,Default,,0,0,0,,Маған тиіспе
Dialogue: 0,0:37:51.30,0:37:54.02,Default,,0,0,0,,Тіпті бөксесімдегі түкті алып тастапты, тіпті мұрным да қанбайды!
Dialogue: 0,0:38:24.71,0:38:26.21,Default,,0,0,0,,(Жүргізушінің механикалық дыбысы)
Dialogue: 0,0:38:51.07,0:38:52.87,Default,,0,0,0,,(бұранданың жабылу дыбысы)
Dialogue: 0,0:38:53.20,0:38:55.08,Default,,0,0,0,,(көшірме машинасының айналу дыбысы)
Dialogue: 0,0:39:01.96,0:39:03.38,Default,,0,0,0,,Ах
Dialogue: 0,0:39:08.55,0:39:10.72,Default,,0,0,0,,Майор, сіз жоғарылатылдыңыз, Феррарин.
Dialogue: 0,0:39:10.80,0:39:12.89,Default,,0,0,0,,Ақымақ неге қайтып келді?
Dialogue: 0,0:39:13.64,0:39:15.72,Default,,0,0,0,,Мен қайда барғым келсе, соған барамын.
Dialogue: 0,0:39:16.51,0:39:18.72,Default,,0,0,0,,Бұл жолы да билік оны назардан тыс қалдырмайды.
Dialogue: 0,0:39:19.48,0:39:20.48,Default,,0,0,0,,Орындалмады ма?
Dialogue: 0,0:39:20.56,0:39:21.64,Default,,0,0,0,,Ия, мен жеңдім! Мен оны шашып жібердім
Dialogue: 0,0:39:22.60,0:39:24.48,Default,,0,0,0,,Сіз мемлекетке қарсы әрекеттеспеушілік үшін кінәлісіз.
Dialogue: 0,0:39:24.56,0:39:26.90,Default,,0,0,0,,Мицу иммиграциялық Тайхай ойы
Dialogue: 0,0:39:26.98,0:39:28.94,Default,,0,0,0,,Цуми - ұятсыз және үлкен шошқа.
Dialogue: 0,0:39:29.24,0:39:31.86,Default,,0,0,0,,Тайхо тәрізді әдепсіз тізбек қатарында берілген.
Dialogue: 0,0:39:33.61,0:39:35.16,Default,,0,0,0,,Күлгенде солай ма?
Dialogue: 0,0:39:36.53,0:39:39.16,Default,,0,0,0,,Жауынгерлік қайығыңды да тәркілеймін дейді.
Dialogue: 0,0:39:40.29,0:39:42.04,Default,,0,0,0,,Бұл әдемі сурет емес пе?
Dialogue: 0,0:39:42.83,0:39:45.13,Default,,0,0,0,,Эй Марко, неге Әуе күштеріне қосылмасқа?
Dialogue: 0,0:39:45.38,0:39:47.96,Default,,0,0,0,,Енді біз өз күшімізбен бірдеңе істей аламыз.
Dialogue: 0,0:39:48.80,0:39:51.34,Default,,0,0,0,,Фашист болғанша шошқа болған артық
Dialogue: 0,0:39:51.55,0:39:53.63,Default,,0,0,0,,Шытырман оқиғалы ұшқыштардың дәуірі аяқталды.
Dialogue: 0,0:39:54.01,0:39:55.05,Default,,0,0,0,,Ұлт немесе этникалық
Dialogue: 0,0:39:55.14,0:39:57.93,Default,,0,0,0,,Сол ақымақ демеушілерді лақтырып, ұшып кетсе болғаны.
Dialogue: 0,0:39:59.43,0:40:01.43,Default,,0,0,0,,Мен өз қылышыммен ғана ұша аламын
Dialogue: 0,0:40:01.52,0:40:03.02,Default,,0,0,0,,(Балалардың күлкісі)
Dialogue: 0,0:40:03.35,0:40:05.48,Default,,0,0,0,,Шошқа ұшса да шошқа болып қалады
Dialogue: 0,0:40:06.81,0:40:08.11,Default,,0,0,0,,Рахмет, Феррарин.
Dialogue: 0,0:40:08.65,0:40:10.03,Default,,0,0,0,,Барлығына сәлем
Dialogue: 0,0:40:11.74,0:40:12.99,Default,,0,0,0,,Жоқ, бұл жақсы сурет емес пе?
Dialogue: 0,0:40:13.78,0:40:17.24,Default,,0,0,0,,Абайлаңыз, олар шошқаларды өлтіргісі келмейді.
Dialogue: 0,0:40:17.58,0:40:18.41,Default,,0,0,0,,О
Dialogue: 0,0:40:19.41,0:40:20.62,Default,,0,0,0,,Абайо жолдас
Dialogue: 0,0:40:29.00,0:40:31.09,Default,,0,0,0,,(Алыстан сыңғырлаған қоңыраудың дыбысы)
Dialogue: 0,0:40:39.60,0:40:40.56,Default,,0,0,0,,Порко, сіз мінгіңіз келе ме?
Dialogue: 0,0:40:46.15,0:40:47.52,Default,,0,0,0,,Жарайды, мен құтқарылдым.
Dialogue: 0,0:40:53.90,0:40:56.53,Default,,0,0,0,,Мен ертең көлге апару үшін қайықты қарызға алдым.
Dialogue: 0,0:40:57.32,0:40:58.87,Default,,0,0,0,,Сынақ ұшуының уақыты келді.
Dialogue: 0,0:40:59.37,0:41:01.58,Default,,0,0,0,,Сынақ жоқ, бірден ұшып кету керек.
Dialogue: 0,0:41:03.04,0:41:04.37,Default,,0,0,0,,Ақылсыз сөздер айтпа
Dialogue: 0,0:41:04.46,0:41:06.50,Default,,0,0,0,,Мен сені сынақсыз бермеймін.
Dialogue: 0,0:41:06.83,0:41:10.09,Default,,0,0,0,,Ал оны бөлшектеп, көлге жеткізу үшін бір күн қажет.
Dialogue: 0,0:41:10.63,0:41:14.01,Default,,0,0,0,,Уақыт жоқ. Сол терезе арқылы артыңа қара.
Dialogue: 0,0:41:14.38,0:41:15.30,Default,,0,0,0,,Жұмсақ
Dialogue: 0,0:41:17.01,0:41:18.43,Default,,0,0,0,,Бұл фашистік құпия полиция.
Dialogue: 0,0:41:20.35,0:41:21.43,Default,,0,0,0,,Мен Фио киіп жүрдім.
Dialogue: 0,0:41:22.56,0:41:24.73,Default,,0,0,0,,Мен? неге
Dialogue: 0,0:41:25.18,0:41:27.23,Default,,0,0,0,,Себебі мен сызығымды бұздым.
Dialogue: 0,0:41:27.44,0:41:30.48,Default,,0,0,0,,Ал Фио менің дирижабльмен араласып жатыр.
Dialogue: 0,0:41:33.73,0:41:36.03,Default,,0,0,0,,Эй, Порко шынымен тыңшы ма?
Dialogue: 0,0:41:39.57,0:41:43.54,Default,,0,0,0,,Хахаха Мен шпионмын ба? Хахаха...
Dialogue: 0,0:41:44.45,0:41:47.79,Default,,0,0,0,,Шпион деген жоқ, бұл жігерлі адам жасайтын нәрсе.
Dialogue: 0,0:41:48.50,0:41:51.00,Default,,0,0,0,,Бірақ сіз соғыс кезінде батыр болдыңыз, солай ма?
Dialogue: 0,0:41:51.67,0:41:53.63,Default,,0,0,0,,Біртүрлі, өйткені сіз ештеңе істемейсіз.
Dialogue: 0,0:41:54.17,0:41:56.34,Default,,0,0,0,,Мен де солай ойлаймын.
Dialogue: 0,0:42:00.72,0:42:02.18,Default,,0,0,0,,Ой, олай емес.
Dialogue: 0,0:42:14.86,0:42:17.03,Default,,0,0,0,,Олар ештеңе істемейтін сияқты.
Dialogue: 0,0:42:17.99,0:42:20.07,Default,,0,0,0,,Жүріңдер, жұмыс істейік.
Dialogue: 0,0:42:49.73,0:42:50.85,Default,,0,0,0,,Сіз кез келген уақытта ұша аласыз
Dialogue: 0,0:42:50.94,0:42:54.61,Default,,0,0,0,,Артында екі адам тығылып тұр, бірақ алдында үш адам.
Dialogue: 0,0:42:54.69,0:42:56.57,Default,,0,0,0,,Бұл қызықты.
Dialogue: 0,0:42:57.28,0:42:59.24,Default,,0,0,0,,Баа-чан, көп қыдырма.
Dialogue: 0,0:43:02.20,0:43:03.53,Default,,0,0,0,,Мен барамын (әйел) сақ болыңыз.
Dialogue: 0,0:43:03.62,0:43:04.37,Default,,0,0,0,,Кешіріңізші!
Dialogue: 0,0:43:15.96,0:43:17.21,Default,,0,0,0,,Фио Сіз неге еліктейсіз?
Dialogue: 0,0:43:18.13,0:43:21.09,Default,,0,0,0,,Мен де барамын. 5 минут күтіңіз, мен мінетін орын дайындаймын.
Dialogue: 0,0:43:22.34,0:43:23.84,Default,,0,0,0,,Жұмыс емес
Dialogue: 0,0:43:23.93,0:43:25.47,Default,,0,0,0,,Сіз не туралы айтып тұрғаныңызды білесіз бе?
Dialogue: 0,0:43:26.31,0:43:28.68,Default,,0,0,0,,Тынш, қатты дыбыс шығарма.
Dialogue: 0,0:43:29.06,0:43:30.77,Default,,0,0,0,,Фио Сіз білесіз...
Dialogue: 0,0:43:32.94,0:43:35.06,Default,,0,0,0,,Сен катагидің қызысың.
Dialogue: 0,0:43:35.15,0:43:36.90,Default,,0,0,0,,Оның үстіне ол бұрынғы күйінде болды және...
Dialogue: 0,0:43:36.98,0:43:38.57,Default,,0,0,0,,Сіз оны ала аласыз. Иә.
Dialogue: 0,0:43:39.94,0:43:42.82,Default,,0,0,0,,Рахмет. Мен мұны асығыс жасадым. Қараңдар!
Dialogue: 0,0:43:47.33,0:43:48.37,Default,,0,0,0,,Керемет!
Dialogue: 0,0:43:49.79,0:43:50.75,Default,,0,0,0,,Сіз мені сонда ұстай аласыз ба?
Dialogue: 0,0:43:51.91,0:43:54.08,Default,,0,0,0,,Ух... Оджо-сан.
Dialogue: 0,0:43:54.42,0:43:56.88,Default,,0,0,0,,Мен бүгінгі сыйлықтың кассирімін.
Dialogue: 0,0:43:57.29,0:43:58.50,Default,,0,0,0,,Көңілді рейске бармаңыз
Dialogue: 0,0:44:00.17,0:44:01.72,Default,,0,0,0,,Кешіріңіз, бірақ
Dialogue: 0,0:44:01.80,0:44:04.01,Default,,0,0,0,,Бұл менің бірінші жұмысым, сондықтан оны дұрыс орындағым келеді.
Dialogue: 0,0:44:04.09,0:44:05.51,Default,,0,0,0,,Бір рет ұшқаннан кейін түзетулер енгізу керек.
Dialogue: 0,0:44:06.30,0:44:08.85,Default,,0,0,0,,Бірақ ол артқы жағындағы канализациядан ұшады.
Dialogue: 0,0:44:09.39,0:44:11.52,Default,,0,0,0,,Мен аман-есен көтеріле алатынымды да білмеймін.
Dialogue: 0,0:44:12.02,0:44:13.44,Default,,0,0,0,,Тағы да
Dialogue: 0,0:44:13.64,0:44:16.77,Default,,0,0,0,,Ал егер сіз Кертиспен айналысатын болсаңыз, сізге лайықты төреші керек болады.
Dialogue: 0,0:44:17.52,0:44:19.78,Default,,0,0,0,,Білесің бе, мен ер адаммын.
Dialogue: 0,0:44:19.86,0:44:22.57,Default,,0,0,0,,Екеуміз ғана қаңырап бос аралда тұрамыз.
Dialogue: 0,0:44:22.65,0:44:24.57,Default,,0,0,0,,Жарайды, мен кемпингті жақсы көремін.
Dialogue: 0,0:44:24.86,0:44:26.70,Default,,0,0,0,,Бұл мағынаны білдірмейді.
Dialogue: 0,0:44:28.03,0:44:29.24,Default,,0,0,0,,Мені өзіңізбен бірге алыңыз.
Dialogue: 0,0:44:29.45,0:44:32.20,Default,,0,0,0,,Кертис жеңіске жетпесе, әлі көп жұмыс істеу керек.
Dialogue: 0,0:44:33.04,0:44:35.50,Default,,0,0,0,,Егер шешілмей қалса, біздің компания қиыншылыққа ұшырайды.
Dialogue: 0,0:44:35.87,0:44:37.21,Default,,0,0,0,,...
Dialogue: 0,0:44:37.84,0:44:39.46,Default,,0,0,0,,Мен жалақымды қалдырамын.
Dialogue: 0,0:44:39.67,0:44:41.71,Default,,0,0,0,,Ал Холле, мен сөйлейтін түтікшені де қосамын.
Dialogue: 0,0:44:42.72,0:44:44.97,Default,,0,0,0,,Менің ойымша, сіз немереңізді қонаққа айналдырғыңыз келеді.
Dialogue: 0,0:44:45.43,0:44:46.30,Default,,0,0,0,,Жоқ
Dialogue: 0,0:44:46.39,0:44:48.51,Default,,0,0,0,,Мен Порконың кепілі боламын
Dialogue: 0,0:44:48.60,0:44:51.60,Default,,0,0,0,,Сондықтан зауыттағылардың барлығында ынтымақтастықтан басқа амал қалмады.
Dialogue: 0,0:44:51.68,0:44:53.35,Default,,0,0,0,,Билікте ешқандай ақтау болмайды.
Dialogue: 0,0:44:54.77,0:44:56.69,Default,,0,0,0,,Өтінемін, мені алып кетші...
Dialogue: 0,0:44:57.35,0:44:58.31,Default,,0,0,0,,Бұл пайдалы болғандықтан...
Dialogue: 0,0:45:01.78,0:45:03.53,Default,,0,0,0,,Оң жақтағы қозғалтқышты толығымен алып тастаңыз.
Dialogue: 0,0:45:03.74,0:45:04.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:45:04.90,0:45:07.91,Default,,0,0,0,,Құйрық қаншалықты кішкентай болса да, қозғалтқыштағы кеңістік тым тар.
Dialogue: 0,0:45:08.24,0:45:09.03,Default,,0,0,0,,Оны шелекпен үккіштен өткізіңіз.
Dialogue: 0,0:45:09.62,0:45:10.62,Default,,0,0,0,,Керемет!
Dialogue: 0,0:45:10.70,0:45:13.75,Default,,0,0,0,,Менің бөксем көрінгеннен үлкен. Мен оны бір минуттан кейін шешемін.
Dialogue: 0,0:45:15.58,0:45:16.71,Default,,0,0,0,,Мен қазір кетемін.
Dialogue: 0,0:45:16.79,0:45:19.21,Default,,0,0,0,,Сырттай көрсең, Баа-чан сенің соңынан еретін шығар.
Dialogue: 0,0:45:19.59,0:45:21.71,Default,,0,0,0,,Түсіндім! Бұл да мүмкін болды.
Dialogue: 0,0:45:21.80,0:45:22.55,Default,,0,0,0,,Хехе…
Dialogue: 0,0:45:24.38,0:45:25.55,Default,,0,0,0,,Баа-чан, тез, тезірек
Dialogue: 0,0:45:26.09,0:45:28.14,Default,,0,0,0,,Фио сувенирлері жақсы.
Dialogue: 0,0:45:37.19,0:45:39.10,Default,,0,0,0,,Байланыс!
Dialogue: 0,0:45:48.41,0:45:49.87,Default,,0,0,0,,Оны ашыңыз!
Dialogue: 0,0:45:56.33,0:45:57.37,Default,,0,0,0,,(ысқырықпен берілген дыбыс)
Dialogue: 0,0:45:58.12,0:45:59.04,Default,,0,0,0,,Сөйле!
Dialogue: 0,0:46:01.21,0:46:05.01,Default,,0,0,0,,(Жақсы қарқынмен шиеленісті музыка)
Dialogue: 0,0:46:19.60,0:46:23.07,Default,,0,0,0,,Адамдарды ұрлады, ақша ұрлады!
Dialogue: 0,0:46:31.70,0:46:33.12,Default,,0,0,0,,Каджи, Порко ше?
Dialogue: 0,0:46:33.62,0:46:37.12,Default,,0,0,0,,Бұл да сен сияқты Жажа атты. Одан да ессіз болып кетті!
Dialogue: 0,0:46:40.87,0:46:42.84,Default,,0,0,0,,Бір рет тоқтатыңыз! Мен параметрлерді өзгертемін
Dialogue: 0,0:46:43.34,0:46:45.84,Default,,0,0,0,,Менің бұған уақытым жоқ. Мен оны қандай да бір жолмен көтеруге тырысамын.
Dialogue: 0,0:46:50.05,0:46:51.39,Default,,0,0,0,,Су жабысып тұр
Dialogue: 0,0:46:52.76,0:46:54.30,Default,,0,0,0,,Майданнан кеме! Ммм!
Dialogue: 0,0:46:57.81,0:46:58.81,Default,,0,0,0,,Ұшайық!
Dialogue: 0,0:47:02.60,0:47:03.61,Default,,0,0,0,,Модор Джажаума
Dialogue: 0,0:47:04.40,0:47:06.61,Default,,0,0,0,,Айнерлер сумен соғылуда.
Dialogue: 0,0:47:07.19,0:47:08.69,Default,,0,0,0,,Қойынды? Жаңасы
Dialogue: 0,0:47:10.45,0:47:11.11,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:47:24.50,0:47:27.05,Default,,0,0,0,,Керемет, сіз кенеттен мойынсұнғыш болып кеттіңіз!
Dialogue: 0,0:47:46.48,0:47:48.11,Default,,0,0,0,,(тыныш және жұмсақ музыка)
Dialogue: 0,0:48:02.54,0:48:05.42,Default,,0,0,0,,Әдемі... Дүние шынымен де әдемі...
Dialogue: 0,0:48:09.96,0:48:10.96,Default,,0,0,0,,Сіз қуғыншысыз ба?
Dialogue: 0,0:48:11.51,0:48:13.18,Default,,0,0,0,,Егер сіз оны шабуыл ретінде қолдансаңыз, басқаша көрінеді.
Dialogue: 0,0:48:14.51,0:48:16.85,Default,,0,0,0,,Италияның әуе күштері осы жерде кіреді.
Dialogue: 0,0:48:18.10,0:48:19.64,Default,,0,0,0,,Менің ойымша, Феррарин мұны жасайды.
Dialogue: 0,0:48:25.81,0:48:26.65,Default,,0,0,0,,Сіз бір-біріңізді танисыз ба?
Dialogue: 0,0:48:27.02,0:48:29.19,Default,,0,0,0,,Әуе күштері біздің алдымызда торын жайып жатыр.
Dialogue: 0,0:48:29.61,0:48:30.94,Default,,0,0,0,,Маған шығудың жолын көрсетсеңіз.
Dialogue: 0,0:48:50.50,0:48:53.26,Default,,0,0,0,,Мен саған төмен тұрып, Адриатика теңізіне тайып кетуіңді айтып тұрмын.
Dialogue: 0,0:48:53.84,0:48:54.93,Default,,0,0,0,,Рахмет, жолдас
Dialogue: 0,0:48:56.09,0:48:57.64,Default,,0,0,0,,Рахмет
Dialogue: 0,0:49:05.69,0:49:08.69,Default,,0,0,0,,Ол Фиоға қарап, бұл шошқа екенін айтты.
Dialogue: 0,0:49:51.61,0:49:54.69,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:50:15.71,0:50:16.88,Default,,0,0,0,,Әдемі...
Dialogue: 0,0:50:17.97,0:50:21.60,Default,,0,0,0,,Құпия бақта гүлдеген жалғыз раушан
Dialogue: 0,0:50:25.64,0:50:26.68,Default,,0,0,0,,Рұқсат етпеу керек адамдар
Dialogue: 0,0:50:27.02,0:50:28.60,Default,,0,0,0,,Бұл жеке бақша.
Dialogue: 0,0:50:29.23,0:50:31.02,Default,,0,0,0,,Мен сенің мұны көргеніңді қалаймын.
Dialogue: 0,0:50:37.94,0:50:39.57,Default,,0,0,0,,Голливудтан.
Dialogue: 0,0:50:40.16,0:50:43.28,Default,,0,0,0,,Киден жіберген сценарийдің сызбасы мен сыртқы түріне қатысты...
Dialogue: 0,0:50:43.99,0:50:47.12,Default,,0,0,0,,Біз қазір бұл мәселені белсенді түрде қарастырып жатырмыз, сондықтан келтірілген қолайсыздық үшін кешірім сұраймыз...
Dialogue: 0,0:50:48.12,0:50:50.87,Default,,0,0,0,,Тақырыбы ``Адриатика теңізінің букеті''.
Dialogue: 0,0:50:51.42,0:50:52.13,Default,,0,0,0,,Жақсы емес
Dialogue: 0,0:50:52.21,0:50:54.21,Default,,0,0,0,,Шынымен бе? Сосын шешілді.
Dialogue: 0,0:50:54.71,0:50:56.76,Default,,0,0,0,,Джина, Голливудқа бірге барайық.
Dialogue: 0,0:50:59.42,0:51:00.88,Default,,0,0,0,,Аспан қарақшыларынан сақ болыңыз
Dialogue: 0,0:51:00.97,0:51:03.39,Default,,0,0,0,,Ақша мен атаққа бір ғана қадам
Dialogue: 0,0:51:04.14,0:51:06.10,Default,,0,0,0,,Келесі - үлкен Голливуд жұлдызы.
Dialogue: 0,0:51:06.89,0:51:07.60,Default,,0,0,0,,Әрі қарай не болады?
Dialogue: 0,0:51:08.64,0:51:09.60,Default,,0,0,0,,Оторио
Dialogue: 0,0:51:10.35,0:51:13.11,Default,,0,0,0,,Жоқ! Ахахахаха…
Dialogue: 0,0:51:17.57,0:51:18.90,Default,,0,0,0,,Мен байсалдымын
Dialogue: 0,0:51:19.57,0:51:22.45,Default,,0,0,0,,Джинаны керемет ханымға айналдырыңыз
Dialogue: 0,0:51:23.20,0:51:24.20,Default,,0,0,0,,Джина
Dialogue: 0,0:51:25.41,0:51:28.16,Default,,0,0,0,,Маған сенің мұндай ақымақтық ұнайды.
Dialogue: 0,0:51:28.25,0:51:29.12,Default,,0,0,0,,Рас!
Dialogue: 0,0:51:30.71,0:51:31.71,Default,,0,0,0,,Бірақ жоқ
Dialogue: 0,0:51:32.33,0:51:34.13,Default,,0,0,0,,Мен қазір қоңырау шалып жатырмын.
Dialogue: 0,0:51:34.21,0:51:35.75,Default,,0,0,0,,(Жылдам, көңілді музыка)
Dialogue: 0,0:51:37.30,0:51:40.80,Default,,0,0,0,,Осы бақшада жүргенімде маған қонаққа адам келсе
Dialogue: 0,0:51:41.26,0:51:43.34,Default,,0,0,0,,Мен саған бұл жолы мені жақсы көр деп жатырмын
Dialogue: 0,0:51:44.55,0:51:47.81,Default,,0,0,0,,Бірақ ол ақымақ мейрамханаға түнде ғана келеді.
Dialogue: 0,0:51:48.47,0:51:50.77,Default,,0,0,0,,Күн сәулесіне мүлдем түспейді.
Dialogue: 0,0:51:54.31,0:51:56.02,Default,,0,0,0,,(дирижабль қозғалтқышының дыбысы)
Dialogue: 0,0:52:33.52,0:52:35.35,Default,,0,0,0,,Ол қайтып келді!
Dialogue: 0,0:53:36.00,0:53:36.96,Default,,0,0,0,,Тыңдап тұрсың ба?
Dialogue: 0,0:53:46.97,0:53:48.80,Default,,0,0,0,,Мен келмей кетіп қалдым.
Dialogue: 0,0:53:48.89,0:53:50.30,Default,,0,0,0,,Мен тағы да ұтылдым.
Dialogue: 0,0:53:50.68,0:53:53.52,Default,,0,0,0,,Кез келген жағдайда... сіз бұл туралы айтып отырсыз ба?
Dialogue: 0,0:53:54.10,0:53:55.02,Default,,0,0,0,,Менде «B» рейтингі бар!
Dialogue: 0,0:53:56.18,0:53:59.73,Default,,0,0,0,,Сіздің елге қарағанда мұнда өмір біршама күрделірек.
Dialogue: 0,0:54:00.23,0:54:02.15,Default,,0,0,0,,Егер бұл махаббат болса, мен оны кез келген уақытта істей аламын, бірақ...
Dialogue: 0,0:54:03.44,0:54:06.11,Default,,0,0,0,,Голливудқа өзім барамын.
Dialogue: 0,0:54:06.44,0:54:07.70,Default,,0,0,0,,Мен?
Dialogue: 0,0:54:12.24,0:54:13.95,Default,,0,0,0,,Кенеттен орындалатын акробатика
Dialogue: 0,0:54:14.04,0:54:15.50,Default,,0,0,0,,Мен басымды соқтым.
Dialogue: 0,0:54:16.08,0:54:17.91,Default,,0,0,0,,Мен ескі досыма сәлем бердім.
Dialogue: 0,0:54:18.21,0:54:19.71,Default,,0,0,0,,Адриано қонақ үйіндегі Джина?
Dialogue: 0,0:54:21.71,0:54:24.13,Default,,0,0,0,,Бұрын террасада болған ақ киімді адам.
Dialogue: 0,0:54:24.55,0:54:26.13,Default,,0,0,0,,Мұны маған атам үйретті
Dialogue: 0,0:54:26.21,0:54:29.47,Default,,0,0,0,,Адриатикадағы барлық дирижабль жүргізушілері Синаға ғашық болады дейді.
Dialogue: 0,0:54:30.09,0:54:31.26,Default,,0,0,0,,Қария, қажетсіз заттар...
Dialogue: 0,0:54:33.18,0:54:36.27,Default,,0,0,0,,Әй, Джина қандай адам? Сіз де Поркоға ғашық болдыңыз ба?
Dialogue: 0,0:54:36.98,0:54:38.18,Default,,0,0,0,,Мен жанармай құюға бара жатырмын.
Dialogue: 0,0:54:38.27,0:54:39.77,Default,,0,0,0,,Сөзіңді тоқтатпасаң, тіліңді тістеймін.
Dialogue: 0,0:54:40.15,0:54:41.73,Default,,0,0,0,,Уа, күте тұрыңыз! Ахх
Dialogue: 0,0:54:45.48,0:54:47.61,Default,,0,0,0,,(жәндіктердің ұшатын дыбысы)
Dialogue: 0,0:54:50.74,0:54:52.32,Default,,0,0,0,,Иә
Dialogue: 0,0:54:56.08,0:54:57.04,Default,,0,0,0,,Я...
Dialogue: 0,0:55:05.55,0:55:06.46,Default,,0,0,0,,Уф
Dialogue: 0,0:55:06.88,0:55:09.26,Default,,0,0,0,,Жауынгерлік қайықта бір қыз бар
Dialogue: 0,0:55:10.88,0:55:11.84,Default,,0,0,0,,Порко ше?
Dialogue: 0,0:55:12.51,0:55:14.26,Default,,0,0,0,,Мен әкеммен қиын әңгіме айтып жатырмын.
Dialogue: 0,0:55:14.72,0:55:16.81,Default,,0,0,0,,Уақытша үкімет ғана емес
Dialogue: 0,0:55:16.89,0:55:18.77,Default,,0,0,0,,Тіпті патша Тоха жігіттері де сонда.
Dialogue: 0,0:55:19.27,0:55:23.02,Default,,0,0,0,,Айтуларынша, олар әуе қарақшылары альянсына кіруге тырысады.
Dialogue: 0,0:55:23.10,0:55:26.78,Default,,0,0,0,,Аспан қарақшылары тырысса да, олар бүгін бір тиын таппас еді.
Dialogue: 0,0:55:26.86,0:55:28.53,Default,,0,0,0,,Орындалды, кешіріңіз.
Dialogue: 0,0:55:29.40,0:55:31.66,Default,,0,0,0,,Жоқ, барлық әңгіме рецессия туралы.
Dialogue: 0,0:55:31.91,0:55:35.28,Default,,0,0,0,,Не? Неліктен сіз Поркоды біреуге сатпайсыз?
Dialogue: 0,0:55:35.99,0:55:38.79,Default,,0,0,0,,Мен сенің қолыңа жақсы ақша төлейтін едім.
Dialogue: 0,0:55:38.87,0:55:40.12,Default,,0,0,0,,Сізде темекі бар ма?
Dialogue: 0,0:55:40.21,0:55:43.04,Default,,0,0,0,,Кертис жақында Америкаға қайтады.
Dialogue: 0,0:55:43.50,0:55:45.42,Default,,0,0,0,,Мен Америкаға баруым керек
Dialogue: 0,0:55:45.50,0:55:47.05,Default,,0,0,0,,Бұл біз.
Dialogue: 0,0:55:48.25,0:55:51.93,Default,,0,0,0,,Адриатика теңізіндегі еркіндік пен бейбітшілік күндерімен қоштасу.
Dialogue: 0,0:55:52.43,0:55:53.64,Default,,0,0,0,,Бұл Байрон ма?
Dialogue: 0,0:55:53.72,0:55:55.39,Default,,0,0,0,,Жоқ, бұл қайтадан менмін.
Dialogue: 0,0:55:55.47,0:55:56.60,Default,,0,0,0,,Мен шын мәнінде айта алмаймын.
Dialogue: 0,0:55:57.64,0:55:59.60,Default,,0,0,0,,(май айдау дыбысы)
Dialogue: 0,0:56:00.35,0:56:01.60,Default,,0,0,0,,Порко Бұл қорқынышты.
Dialogue: 0,0:56:02.60,0:56:05.40,Default,,0,0,0,,Бензиннің Италиядағыдан үш есе қымбат екені ессіз.
Dialogue: 0,0:56:07.82,0:56:09.40,Default,,0,0,0,,Аяғыңызға қарамаңыз.
Dialogue: 0,0:56:10.36,0:56:12.24,Default,,0,0,0,,Менікі қоспасыз.
Dialogue: 0,0:56:12.53,0:56:13.61,Default,,0,0,0,,Сондықтан мен әйелдерді ұнатпаймын
Dialogue: 0,0:56:14.61,0:56:16.12,Default,,0,0,0,,Күйеу, бірдеңе айтыңызшы.
Dialogue: 0,0:56:16.99,0:56:18.45,Default,,0,0,0,,Оны алып кет, Фио.
Dialogue: 0,0:56:18.95,0:56:21.16,Default,,0,0,0,,Осыдан кейін бөксесі көрінгеннен үлкенірек.
Dialogue: 0,0:56:21.25,0:56:23.12,Default,,0,0,0,,Оны қозғалтқыштағы бос орындарда сақтаңыз.
Dialogue: 0,0:56:23.75,0:56:24.96,Default,,0,0,0,,Жасыратын жерге ұшып барайық
Dialogue: 0,0:56:25.50,0:56:28.55,Default,,0,0,0,,Мен газ төлемін салық декларациясына қосуды қамтамасыз етемін.
Dialogue: 0,0:56:34.43,0:56:37.51,Default,,0,0,0,,Мен алдамаймын, мен бірдеңені ұстап тұрмын.
Dialogue: 0,0:56:38.85,0:56:40.93,Default,,0,0,0,,Теңіз де, құрлық та әдемі көрінеді.
Dialogue: 0,0:56:41.18,0:56:43.02,Default,,0,0,0,,Бұл жерде ақылсыз.
Dialogue: 0,0:56:43.31,0:56:44.23,Default,,0,0,0,,Хмм.
Dialogue: 0,0:56:45.85,0:56:47.69,Default,,0,0,0,,Мен бұл аралды көріп тұрмын.
Dialogue: 0,0:57:04.41,0:57:05.29,Default,,0,0,0,,Уау
Dialogue: 0,0:57:08.46,0:57:09.29,Default,,0,0,0,,Сен әзілдескің келгенін түсіндім—
Dialogue: 0,0:57:26.52,0:57:27.98,Default,,0,0,0,,Жақсы жасырыну.
Dialogue: 0,0:57:29.61,0:57:32.69,Default,,0,0,0,,Әй, менің бөксем қатып қалды.
Dialogue: 0,0:57:41.49,0:57:43.54,Default,,0,0,0,,Бутта!
Dialogue: 0,0:57:47.12,0:57:48.37,Default,,0,0,0,,Қозғалмаңыз!
Dialogue: 0,0:57:49.71,0:57:52.71,Default,,0,0,0,,Қайтадан келгендер көп болды.
Dialogue: 0,0:57:52.80,0:57:55.51,Default,,0,0,0,,Мен бастықты ұстадым.
Dialogue: 0,0:57:55.59,0:57:57.88,Default,,0,0,0,,Бітім, сен адамдарды басып жатырсың.
Dialogue: 0,0:57:57.97,0:57:58.97,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:57:59.72,0:58:02.01,Default,,0,0,0,,Мен сені күттім, шошқа.
Dialogue: 0,0:58:02.10,0:58:03.72,Default,,0,0,0,,Мен сенің келетініңді білдім.
Dialogue: 0,0:58:03.81,0:58:05.10,Default,,0,0,0,,Мен Темеге көп қарыздармын.
Dialogue: 0,0:58:05.18,0:58:06.31,Default,,0,0,0,,Уууух! Ах, бұл кактус екен!
Dialogue: 0,0:58:07.06,0:58:10.56,Default,,0,0,0,,Бұл қыз. Мен қыз алып жүрмін. (Әуе қарақшылары одағының басшысы F) Ол сүйкімді.
Dialogue: 0,0:58:11.15,0:58:15.11,Default,,0,0,0,,Шулы! Әйелдерге не болды? Әлемнің жартысы әйелдер.
Dialogue: 0,0:58:15.57,0:58:18.15,Default,,0,0,0,,Сәлем! Ол бала жай қызы емес.
Dialogue: 0,0:58:18.57,0:58:19.82,Default,,0,0,0,,Пикколо құрастырған
Dialogue: 0,0:58:20.32,0:58:23.79,Default,,0,0,0,,Ех! Ол соншалықты түсінікті және сүйкімді болса да?
Dialogue: 0,0:58:24.45,0:58:25.54,Default,,0,0,0,,Бұл әйел. Бұл рас па?
Dialogue: 0,0:58:26.04,0:58:29.25,Default,,0,0,0,,Мен өз қайығымды бұрынғыдан әлдеқайда жақсы қайық еттім.
Dialogue: 0,0:58:29.71,0:58:31.08,Default,,0,0,0,,Жас жігіт айқайлап жатыр
Dialogue: 0,0:58:31.71,0:58:32.96,Default,,0,0,0,,О
Dialogue: 0,0:58:33.04,0:58:34.09,Default,,0,0,0,,Шынымен бе? Порко
Dialogue: 0,0:58:35.09,0:58:37.26,Default,,0,0,0,,Ұшатын қайықтар туралы өтірік айтпа
Dialogue: 0,0:58:37.55,0:58:39.09,Default,,0,0,0,,Сыпайылықпен қарау
Dialogue: 0,0:58:39.18,0:58:41.09,Default,,0,0,0,,Өндіріп алушы артымнан ерді.
Dialogue: 0,0:58:43.14,0:58:45.89,Default,,0,0,0,,Теменің де несиесі бар ма?
Dialogue: 0,0:58:45.97,0:58:48.89,Default,,0,0,0,,Әй, мына жігіт ұятсыз, қызыл қайық айдап барады.
Dialogue: 0,0:58:48.98,0:58:50.85,Default,,0,0,0,,Қарызды ғана қалдырыңыз және оны үзіңіз!
Dialogue: 0,0:58:52.90,0:58:55.61,Default,,0,0,0,,Сіз мен жасаған қайықты жоймақшысыз ба?
Dialogue: 0,0:58:56.65,0:58:58.82,Default,,0,0,0,,Осындай әдемі қайықты балтамен бұзуға қалай дәтің бар?
Dialogue: 0,0:58:58.90,0:58:59.90,Default,,0,0,0,,Мм... ммм...
Dialogue: 0,0:58:59.99,0:59:02.62,Default,,0,0,0,,Оджо-сан, мұның астарында терең себеп бар.
Dialogue: 0,0:59:03.16,0:59:03.83,Default,,0,0,0,,Сіз оны бұзасыз.
Dialogue: 0,0:59:04.16,0:59:06.04,Default,,0,0,0,,Уф, сондықтан...
Dialogue: 0,0:59:06.12,0:59:08.66,Default,,0,0,0,,Балалар, сендер әлі де қайықпен ұшасыңдар ма?
Dialogue: 0,0:59:08.91,0:59:10.75,Default,,0,0,0,,Кет! Менің аяқ киімім!
Dialogue: 0,0:59:19.63,0:59:21.47,Default,,0,0,0,,Мен, кішкентай кезімнен.
Dialogue: 0,0:59:21.55,0:59:23.55,Default,,0,0,0,,Мен ұшатын қайықтар туралы әңгімелерді естіп өстім.
Dialogue: 0,0:59:24.60,0:59:27.77,Default,,0,0,0,,Олар дирижабльдегі жігіттерден жақсы жігіттер жоқ дейді.
Dialogue: 0,0:59:27.85,0:59:29.52,Default,,0,0,0,,Атам үнемі солай айтатын
Dialogue: 0,0:59:30.02,0:59:33.73,Default,,0,0,0,,Себебі теңіз де, аспан да жүректерін ашады.
Dialogue: 0,0:59:34.98,0:59:37.57,Default,,0,0,0,,Демек, дирижабль мінген адам теңізшіге қарағанда батыл.
Dialogue: 0,0:59:38.40,0:59:40.82,Default,,0,0,0,,Ол құрлықтағы ұшақ ұшқышынан мақтаншақ.
Dialogue: 0,0:59:40.90,0:59:42.57,Default,,0,0,0,,Иә!
Dialogue: 0,0:59:43.11,0:59:46.37,Default,,0,0,0,,Айтудың қажеті жоқ, ұшатын қайықпен жүру деген осы.
Dialogue: 0,0:59:47.33,0:59:50.75,Default,,0,0,0,,Олар үшін ең маңыздысы ақша да, әйел де емес.
Dialogue: 0,0:59:51.33,0:59:52.12,Default,,0,0,0,,Менің атым!
Dialogue: 0,0:59:52.54,0:59:53.96,Default,,0,0,0,,Иә, дұрыс!
Dialogue: 0,0:59:54.04,0:59:54.83,Default,,0,0,0,,Әпке, тамаша!
Dialogue: 0,0:59:55.54,0:59:57.17,Default,,0,0,0,,Банзай дирижабльде!
Dialogue: 0,0:59:58.76,1:00:00.84,Default,,0,0,0,,Қандай шектен шыққан қыз!
Dialogue: 0,1:00:01.38,1:00:02.97,Default,,0,0,0,,Мен әңгімені түсіндім.
Dialogue: 0,1:00:03.22,1:00:06.35,Default,,0,0,0,,Мен сіз жасаған дирижабльді жою үшін балта қолдануды қойдым.
Dialogue: 0,1:00:06.55,1:00:09.97,Default,,0,0,0,,Бірақ біз кері шегінуді жалғастыра берсек, біз аспан қарақшылары ретіндегі беделімізді қорғай алмаймыз.
Dialogue: 0,1:00:10.89,1:00:12.64,Default,,0,0,0,,Мен шошқаны фаршқа айналдырамын
Dialogue: 0,1:00:12.73,1:00:15.73,Default,,0,0,0,,Иә! Шошқа ұрды!
Dialogue: 0,1:00:16.40,1:00:17.73,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,1:00:18.57,1:00:19.90,Default,,0,0,0,,Сіз мүлде түсінбейсіз!
Dialogue: 0,1:00:19.98,1:00:22.11,Default,,0,0,0,,Балалар, ұялмайсыңдар ма?
Dialogue: 0,1:00:22.82,1:00:25.45,Default,,0,0,0,,Мен Америкадан келген Кертистің көмегімен жақсымын.
Dialogue: 0,1:00:25.87,1:00:27.99,Default,,0,0,0,,Анаң мұны естісе, жылайтын шығар!
Dialogue: 0,1:00:28.08,1:00:29.45,Default,,0,0,0,,Неге шомылмайсың?
Dialogue: 0,1:00:30.16,1:00:32.54,Default,,0,0,0,,Порко Адриатика теңізінде ұшатын қайықта ұшқыш болған.
Dialogue: 0,1:00:32.62,1:00:34.21,Default,,0,0,0,,Аты мен мақтанышы үшін
Dialogue: 0,1:00:34.54,1:00:38.13,Default,,0,0,0,,Мен мұнда Кертиспен жеке кездесу өткізу үшін келдім.
Dialogue: 0,1:00:38.25,1:00:41.97,Default,,0,0,0,,Ешқандай ерік-жігері жоқ адам - ​​ең жаман. Батыл күрес!
Dialogue: 0,1:00:44.01,1:00:46.97,Default,,0,0,0,,Сондықтан мен Кертиске қарсы шықтым.
Dialogue: 0,1:00:47.05,1:00:49.68,Default,,0,0,0,,Бұл ұят болуы керек. Одан бірден құтылыңыз.
Dialogue: 0,1:00:50.22,1:00:51.64,Default,,0,0,0,,Бастық, не істеуіміз керек?
Dialogue: 0,1:00:51.72,1:00:53.60,Default,,0,0,0,,Бұл нанымды.
Dialogue: 0,1:00:53.69,1:00:56.23,Default,,0,0,0,,Мұнда екі беті тік тұрған бір ғана орын бар.
Dialogue: 0,1:00:56.31,1:00:58.27,Default,,0,0,0,,Кертис Ярудан сұрауым керек пе?
Dialogue: 0,1:00:58.52,1:01:01.07,Default,,0,0,0,,Сіз мені тағы да шошқалармен жарысуды сұрайсыз ба?
Dialogue: 0,1:01:01.15,1:01:03.28,Default,,0,0,0,,Келісімшарттың мерзімі аяқталды, солай ма?
Dialogue: 0,1:01:04.11,1:01:05.70,Default,,0,0,0,,Мен ұялып тұрмын...
Dialogue: 0,1:01:06.11,1:01:09.58,Default,,0,0,0,,Ахахаха... хахахаха
Dialogue: 0,1:01:10.03,1:01:11.45,Default,,0,0,0,,Жасайық Кертис!
Dialogue: 0,1:01:11.54,1:01:14.21,Default,,0,0,0,,Бұл Кертис. Бұл Кертис.
Dialogue: 0,1:01:14.96,1:01:16.37,Default,,0,0,0,,Мен ертегіні естідім.
Dialogue: 0,1:01:16.75,1:01:18.71,Default,,0,0,0,,Мен жасырмаймын немесе жасырмаймын.
Dialogue: 0,1:01:20.63,1:01:21.80,Default,,0,0,0,,Ақымақ пен ақымақ
Dialogue: 0,1:01:21.88,1:01:23.84,Default,,0,0,0,,Ол жерге жол салуға қалай дәтің бар...
Dialogue: 0,1:01:26.47,1:01:28.05,Default,,0,0,0,,О
Dialogue: 0,1:01:35.35,1:01:36.64,Default,,0,0,0,,Сәлем, Азукаттл
Dialogue: 0,1:01:41.57,1:01:43.65,Default,,0,0,0,,Қысқасы, сіз жауап матчын өткізгіңіз келеді деп ойлаймын.
Dialogue: 0,1:01:44.28,1:01:46.70,Default,,0,0,0,,Бірақ бұл бір рет жеңген шайқас.
Dialogue: 0,1:01:47.07,1:01:49.66,Default,,0,0,0,,Оның үстіне мен енді бұл жігіттерді іздемеймін.
Dialogue: 0,1:01:50.37,1:01:52.41,Default,,0,0,0,,Бұл сіз мұны тегін жасамайсыз дегенді білдіре ме? Сіздің жұмысыңыз ше?
Dialogue: 0,1:01:54.79,1:01:55.54,Default,,0,0,0,,Иә?
Dialogue: 0,1:02:03.46,1:02:04.76,Default,,0,0,0,,Әдемі...
Dialogue: 0,1:02:06.17,1:02:07.93,Default,,0,0,0,,Мен жеңсем, менімен төбелесесіңдер ме?
Dialogue: 0,1:02:09.26,1:02:09.93,Default,,0,0,0,,Ым?
Dialogue: 0,1:02:12.18,1:02:13.35,Default,,0,0,0,,Мен байсалдымын
Dialogue: 0,1:02:13.68,1:02:16.10,Default,,0,0,0,,Жарайды, егер Порко жеңсе.
Dialogue: 0,1:02:16.18,1:02:18.10,Default,,0,0,0,,Бұл шотты төлеу сізге байланысты!
Dialogue: 0,1:02:18.90,1:02:19.85,Default,,0,0,0,,Күте тұрыңыз, Фио!
Dialogue: 0,1:02:20.48,1:02:21.61,Default,,0,0,0,,Темее аузыңды жап!
Dialogue: 0,1:02:21.69,1:02:23.86,Default,,0,0,0,,Тыныш отырыңыз.
Dialogue: 0,1:02:26.19,1:02:28.91,Default,,0,0,0,,Фио мырза, егер сіз одан бас тартқыңыз келсе, дәл қазір уақыт.
Dialogue: 0,1:02:28.99,1:02:30.66,Default,,0,0,0,,Сұрағыңыз келсе мына кісіден сұраңыз.
Dialogue: 0,1:02:30.74,1:02:32.58,Default,,0,0,0,,Бұл сәл қымбат.
Dialogue: 0,1:02:32.66,1:02:33.83,Default,,0,0,0,,Бұл арзан
Dialogue: 0,1:02:34.16,1:02:35.45,Default,,0,0,0,,Мұны істеу керек пе, жоқ па?
Dialogue: 0,1:02:36.54,1:02:39.17,Default,,0,0,0,,Мен сүйген адамдарым үшін қуана күресемін.
Dialogue: 0,1:02:39.25,1:02:40.12,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,1:02:41.25,1:02:42.71,Default,,0,0,0,,Барлығыңызды тыңдаңыз!
Dialogue: 0,1:02:42.92,1:02:45.59,Default,,0,0,0,,Мен Фиоджоның рухына ғашық болдым!
Dialogue: 0,1:02:45.67,1:02:49.01,Default,,0,0,0,,Бұл шешуші шайқаста менің Маммаюто тобым төрағалық етеді!
Dialogue: 0,1:02:49.09,1:02:50.39,Default,,0,0,0,,О
Dialogue: 0,1:02:50.47,1:02:52.39,Default,,0,0,0,,Әуе қарақшылары альянсына атсалысайық.
Dialogue: 0,1:02:52.47,1:02:54.14,Default,,0,0,0,,Иә! Ой
Dialogue: 0,1:02:54.68,1:02:56.64,Default,,0,0,0,,Мұздатқыш балмұздақ жақсы-ақ, бірақ бұл да дәмді.
Dialogue: 0,1:02:57.23,1:03:00.31,Default,,0,0,0,,Фио-сан, мен сені күтемін.
Dialogue: 0,1:03:02.61,1:03:03.36,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,1:03:03.94,1:03:06.32,Default,,0,0,0,,Қашпа, шошқа.
Dialogue: 0,1:03:06.94,1:03:10.32,Default,,0,0,0,,Асығыңыз! Асықшы!
Dialogue: 0,1:03:11.20,1:03:12.20,Default,,0,0,0,,Сол сұм Боинго! Ең болмағанда қазір! Мылтығым➡
Dialogue: 0,1:03:16.04,1:03:18.96,Default,,0,0,0,,Біртүрлі нәрсе болды.
Dialogue: 0,1:03:19.50,1:03:20.46,Default,,0,0,0,,Жалпы айтқанда, сіз...
Dialogue: 0,1:03:21.21,1:03:22.13,Default,,0,0,0,,Бұрын… пышақ еді.
Dialogue: 0,1:03:23.54,1:03:25.46,Default,,0,0,0,,Мен де ақымақ екенімді білемін...
Dialogue: 0,1:03:31.80,1:03:32.64,Default,,0,0,0,,Фио
Dialogue: 0,1:03:33.51,1:03:36.43,Default,,0,0,0,,Мен сізге алғыс айтуым керек сияқты.
Dialogue: 0,1:03:37.35,1:03:38.72,Default,,0,0,0,,Сіз маған мүмкіндік бердіңіз
Dialogue: 0,1:03:39.64,1:03:43.23,Default,,0,0,0,,Рахмет, тағдырымыз ортақ.
Dialogue: 0,1:03:44.06,1:03:45.44,Default,,0,0,0,,Біз серіктеспіз.
Dialogue: 0,1:03:47.73,1:03:49.49,Default,,0,0,0,,Бұл 50-50 шайқас.
Dialogue: 0,1:03:50.90,1:03:52.41,Default,,0,0,0,,Мен Поркоға сенемін.
Dialogue: 0,1:03:54.07,1:03:55.16,Default,,0,0,0,,«Сенемін»?
Dialogue: 0,1:03:55.74,1:03:57.16,Default,,0,0,0,,Мен бұл сөздерді жек көремін, бірақ
Dialogue: 0,1:03:57.24,1:03:59.45,Default,,0,0,0,,Айтқанда басқаша естіледі.
Dialogue: 0,1:04:05.25,1:04:07.88,Default,,0,0,0,,Не болды? Жағдайың нашар ма?
Dialogue: 0,1:04:08.55,1:04:09.30,Default,,0,0,0,,Фио…
Dialogue: 0,1:04:09.59,1:04:10.51,Default,,0,0,0,,Жарайды
Dialogue: 0,1:04:11.63,1:04:14.93,Default,,0,0,0,,Қазір кенет жүрегім дүрсілдеп, ауырып тұр.
Dialogue: 0,1:04:15.47,1:04:17.18,Default,,0,0,0,,Мен қатты қорықтым.
Dialogue: 0,1:04:18.10,1:04:20.64,Default,,0,0,0,,Қиналдым, тізем дірілдеп.
Dialogue: 0,1:04:24.15,1:04:25.27,Default,,0,0,0,,қатты алданып қалады
Dialogue: 0,1:04:25.98,1:04:26.98,Default,,0,0,0,,Мен жүземін!
Dialogue: 0,1:04:46.63,1:04:48.67,Default,,0,0,0,,Порко Үлкен сәтсіздік!
Dialogue: 0,1:04:48.75,1:04:49.67,Default,,0,0,0,,Не болды?
Dialogue: 0,1:04:50.80,1:04:53.93,Default,,0,0,0,,Мен кеңес сұрауды ертерек қалдыруым керек еді.
Dialogue: 0,1:04:54.59,1:04:56.22,Default,,0,0,0,,Мен мұны істедім.
Dialogue: 0,1:05:00.10,1:05:01.22,Default,,0,0,0,,Жоқ
Dialogue: 0,1:05:43.60,1:05:46.52,Default,,0,0,0,,(эпикалық музыка)
Dialogue: 0,1:05:55.44,1:05:56.40,Default,,0,0,0,,Порко…
Dialogue: 0,1:05:56.90,1:05:57.74,Default,,0,0,0,,Фалько…
Dialogue: 0,1:05:58.53,1:05:59.41,Default,,0,0,0,,Ұйықтау мүмкін емес пе?
Dialogue: 0,1:06:01.16,1:06:02.16,Default,,0,0,0,,Енді...
Dialogue: 0,1:06:04.08,1:06:05.41,Default,,0,0,0,,Ол «Fool» картасының белгісін арқалаған Стэнді қолданушы
Dialogue: 0,1:06:06.87,1:06:09.75,Default,,0,0,0,,Уайымдама, ертең ерте келеміз.
Dialogue: 0,1:06:11.34,1:06:12.84,Default,,0,0,0,,Порко О?
Dialogue: 0,1:06:12.92,1:06:15.26,Default,,0,0,0,,Порко неліктен шошқаға айналды?
Dialogue: 0,1:06:15.72,1:06:17.01,Default,,0,0,0,,Келіңіздер...
Dialogue: 0,1:06:18.68,1:06:21.89,Default,,0,0,0,,Мен капитан Марко Паготто туралы көп білемін.
Dialogue: 0,1:06:22.18,1:06:23.93,Default,,0,0,0,,Менің әкем де сол бөлімшеде болған.
Dialogue: 0,1:06:24.72,1:06:26.73,Default,,0,0,0,,Капитан дауыл теңізіне түсті.
Dialogue: 0,1:06:26.81,1:06:29.31,Default,,0,0,0,,Ұшқышты құтқарған уақытым туралы әңгіме
Dialogue: 0,1:06:29.40,1:06:31.36,Default,,0,0,0,,Маған ұнады, талай рет тыңдадым.
Dialogue: 0,1:06:36.49,1:06:38.24,Default,,0,0,0,,Порко, мен сені сүйсем бе?
Dialogue: 0,1:06:39.07,1:06:39.74,Default,,0,0,0,,Иә!?
Dialogue: 0,1:06:40.32,1:06:43.45,Default,,0,0,0,,Қараңдар, ханзада ханшайым сүйген бақаға айналды.
Dialogue: 0,1:06:43.53,1:06:45.24,Default,,0,0,0,,Адамға қайта оралу туралы әңгіме бар.
Dialogue: 0,1:06:45.87,1:06:49.79,Default,,0,0,0,,Ей, ақымақ, бұл заттарды ең маңызды кезде сақта.
Dialogue: 0,1:06:51.83,1:06:53.13,Default,,0,0,0,,Мүмкін мен мұны істей алмаймын.
Dialogue: 0,1:06:55.17,1:06:57.47,Default,,0,0,0,,Хехе... Сен жақсы қызсың.
Dialogue: 0,1:06:57.92,1:06:59.22,Default,,0,0,0,,Фиоға қарап
Dialogue: 0,1:06:59.59,1:07:02.51,Default,,0,0,0,,Адамды да тастамау керек деген ой туды.
Dialogue: 0,1:07:03.14,1:07:04.97,Default,,0,0,0,,Жүр, сен жақсы қызсың, ұйықтай бер.
Dialogue: 0,1:07:05.26,1:07:07.77,Default,,0,0,0,,Маған бірдеңе айт, сосын мен саған хабарласамын.
Dialogue: 0,1:07:09.44,1:07:10.65,Default,,0,0,0,,Әңгіме...?
Dialogue: 0,1:07:13.02,1:07:14.23,Default,,0,0,0,,Дұрыс...
Dialogue: 0,1:07:16.61,1:07:19.40,Default,,0,0,0,,Ай!
Dialogue: 0,1:07:23.16,1:07:25.66,Default,,0,0,0,,Бұл соғыстың соңғы жазы болатын.
Dialogue: 0,1:07:27.08,1:07:29.12,Default,,0,0,0,,Біз әдеттегідей патрульдеміз.
Dialogue: 0,1:07:29.79,1:07:32.92,Default,,0,0,0,,Истрияны көздеп, Адриатика теңізіне шықтым.
Dialogue: 0,1:07:38.46,1:07:41.13,Default,,0,0,0,,Қасымда берлиндік жігіт ұшып бара жатты.
Dialogue: 0,1:07:41.88,1:07:42.97,Default,,0,0,0,,Ескі дос
Dialogue: 0,1:07:43.55,1:07:46.06,Default,,0,0,0,,Якко-сан, екі күн бұрын ғана тепкі алдық.
Dialogue: 0,1:07:47.35,1:07:50.02,Default,,0,0,0,,Салтанат менімен куәгер ретінде өтті...
Dialogue: 0,1:07:50.98,1:07:52.44,Default,,0,0,0,,Менің демалысым жеткіліксіз...
Dialogue: 0,1:07:52.52,1:07:54.86,Default,,0,0,0,,Сол аяқпен мен инеліктей майдан даласына оралдым.
Dialogue: 0,1:08:15.58,1:08:18.84,Default,,0,0,0,,Жан-жағыма жау мен одақтас шыбын болып құлады.
Dialogue: 0,1:08:19.51,1:08:21.84,Default,,0,0,0,,Мені үш білікті ұшақ қуып бара жатты.
Dialogue: 0,1:08:22.84,1:08:24.89,Default,,0,0,0,,Достарыма көңіл бөлуге уақытым болмады.
Dialogue: 0,1:08:25.51,1:08:28.06,Default,,0,0,0,,Көп ұзамай мен жалғыз одақтас болдым.
Dialogue: 0,1:08:28.51,1:08:30.52,Default,,0,0,0,,Олар әлі де тоқтамайды
Dialogue: 0,1:08:31.18,1:08:33.23,Default,,0,0,0,,Шарасыз жүгірдім
Dialogue: 0,1:08:33.81,1:08:35.48,Default,,0,0,0,,Қол-аяғым жансызданды.
Dialogue: 0,1:08:35.56,1:08:38.98,Default,,0,0,0,,Менің көзім соқыр болды, бұл жақсы емес деп ойладым.
Dialogue: 0,1:08:39.36,1:08:40.28,Default,,0,0,0,,Уақыт келді
Dialogue: 0,1:08:40.99,1:08:43.40,Default,,0,0,0,,Кенет менің көз алдымда бәрі ағарып кетті.
Dialogue: 0,1:08:43.82,1:08:44.78,Default,,0,0,0,,Таза ақ?
Dialogue: 0,1:08:45.03,1:08:47.58,Default,,0,0,0,,А-а, жарықта айту керек.
Dialogue: 0,1:08:49.62,1:08:52.29,Default,,0,0,0,,Біртүрлі жарық болды, мен бұлттардың ішінде екенімді түсінген кезде...
Dialogue: 0,1:08:52.37,1:08:54.04,Default,,0,0,0,,Бұл көп уақытты алды.
Dialogue: 0,1:08:55.12,1:08:56.79,Default,,0,0,0,,Мен шаршадым...
Dialogue: 0,1:08:56.88,1:08:59.17,Default,,0,0,0,,Менде мұны істеуге күшім қалмады.
Dialogue: 0,1:08:59.63,1:09:02.59,Default,,0,0,0,,Сонда да қайық өздігінен ұшып кетеді.
Dialogue: 0,1:09:03.01,1:09:06.39,Default,,0,0,0,,(Ғылыми музыка)
Dialogue: 0,1:09:29.12,1:09:30.45,Default,,0,0,0,,Бұлттардың жазықтары?
Dialogue: 0,1:09:31.12,1:09:34.33,Default,,0,0,0,,А... өте тыныш.
Dialogue: 0,1:09:34.62,1:09:36.75,Default,,0,0,0,,Аспан шынымен де әдемі
Dialogue: 0,1:09:37.33,1:09:42.25,Default,,0,0,0,,Жоғарыда жұмбақ бұлт қалқып тұрды.
Dialogue: 0,1:10:09.91,1:10:11.91,Default,,0,0,0,,Берлини! Жақсы болды ма?
Dialogue: 0,1:10:15.91,1:10:18.17,Default,,0,0,0,,Берлини Күтіңіз, қайда барасыз!
Dialogue: 0,1:10:20.29,1:10:22.59,Default,,0,0,0,,(Ғылыми музыка)
Dialogue: 0,1:10:31.18,1:10:34.64,Default,,0,0,0,,Берлини, барма. Сен Джинамен не істемексің?
Dialogue: 0,1:10:35.02,1:10:36.31,Default,,0,0,0,,Мен оның орнына барамын.
Dialogue: 0,1:11:16.97,1:11:19.85,Default,,0,0,0,,Теңіз беті тайғақ екенін байқадым...
Dialogue: 0,1:11:19.94,1:11:21.69,Default,,0,0,0,,Мен жалғыз ұшатынмын...
Dialogue: 0,1:11:25.32,1:11:27.86,Default,,0,0,0,,Құдай маған әлі келме деді.
Dialogue: 0,1:11:29.28,1:11:30.15,Default,,0,0,0,,(Танжиро) Бірақ құбыжықтар жалғыз жүруі керек еді ғой?
Dialogue: 0,1:11:30.24,1:11:32.53,Default,,0,0,0,,Мен үшін сен әрқашан осылай жалғыз болдың.
Dialogue: 0,1:11:32.62,1:11:34.49,Default,,0,0,0,,Маған ұшуды бұйырғандай болдым.
Dialogue: 0,1:11:35.12,1:11:37.33,Default,,0,0,0,,Бұл шындық болуы мүмкін емес. Порко жақсы жігіт.
Dialogue: 0,1:11:38.16,1:11:39.91,Default,,0,0,0,,Жақсы жігіт өлген жігітпен тең
Dialogue: 0,1:11:40.75,1:11:43.33,Default,,0,0,0,,Оның үстіне бұл жер тозақ болуы мүмкін.
Dialogue: 0,1:11:43.88,1:11:46.67,Default,,0,0,0,,Енді осымен әңгіме аяқталды. Өтінемін ұйықта.
Dialogue: 0,1:11:49.30,1:11:52.05,Default,,0,0,0,,Бұл қоқыс дүкені. Бұл тот басқан нәрсе.
Dialogue: 0,1:11:52.64,1:11:53.39,Default,,0,0,0,,Иә?
Dialogue: 0,1:11:54.18,1:11:57.22,Default,,0,0,0,,Порконың тірі оралғанына қуаныштымын.
Dialogue: 0,1:11:57.31,1:11:59.02,Default,,0,0,0,,Порконың маған ұнайтыны
Dialogue: 0,1:12:00.68,1:12:01.69,Default,,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,1:12:07.65,1:12:11.32,Default,,0,0,0,,(Жақсы қарқынмен көңілді музыка)
Dialogue: 0,1:12:26.00,1:12:27.75,Default,,0,0,0,,Бұл әуе қарақшылары одағының Totocalcio.
Dialogue: 0,1:12:27.75,1:12:29.63,Default,,0,0,0,,8-ден 7-ге дейін 8-ден 7-ге дейін (1-мүше) Бұл әуе қарақшылары альянсының Тото Кальсио.
Dialogue: 0,1:12:29.71,1:12:31.97,Default,,0,0,0,,Ер болсаң, мықты бол!
Dialogue: 0,1:12:32.05,1:12:34.22,Default,,0,0,0,,Балмұздақ алғыңыз келе ме? Қатты көріңіз!
Dialogue: 0,1:12:43.81,1:12:46.90,Default,,0,0,0,,Идиоттар оны мерекеге айналдырды
Dialogue: 0,1:12:46.98,1:12:49.02,Default,,0,0,0,,Бұл адамдардың барлығы аспан қарақшылары ма?
Dialogue: 0,1:12:49.11,1:12:50.82,Default,,0,0,0,,Жерорта теңізіндегі қоқыс
Dialogue: 0,1:12:51.28,1:12:53.57,Default,,0,0,0,,...
Dialogue: 0,1:12:53.99,1:12:57.07,Default,,0,0,0,,Шпионның киімі аз болса да араласып кеткен бе деп ойлаймын.
Dialogue: 0,1:12:57.74,1:13:01.33,Default,,0,0,0,,Хехехе... Бұл менің атақ-даңғымды одан сайын арттырады.
Dialogue: 0,1:13:02.20,1:13:05.12,Default,,0,0,0,,Басталуға 10 минут қалғанда 10 минут бұрын
Dialogue: 0,1:13:06.00,1:13:07.13,Default,,0,0,0,,Осыдан
Dialogue: 0,1:13:07.21,1:13:11.13,Default,,0,0,0,,Порко Россо мен Дональд Кертис арасындағы тартыс басталады.
Dialogue: 0,1:13:11.96,1:13:13.42,Default,,0,0,0,,Арнайы ережелер жоқ.
Dialogue: 0,1:13:13.51,1:13:17.64,Default,,0,0,0,,Бірақ қанаттыға еліктеген адамды жұртшылық жек көреді.
Dialogue: 0,1:13:18.10,1:13:19.68,Default,,0,0,0,,Жазу жақсы, ерте баста.
Dialogue: 0,1:13:19.76,1:13:21.85,Default,,0,0,0,,Хиккоме, мен мұнда жалған теорияны есту үшін келген жоқпын.
Dialogue: 0,1:13:25.35,1:13:29.19,Default,,0,0,0,,Менімен араласпа! Мен сені өлтіремін!
Dialogue: 0,1:13:29.44,1:13:30.98,Default,,0,0,0,,(аудитория сыбдыры)
Dialogue: 0,1:13:38.45,1:13:40.53,Default,,0,0,0,,10 тонна бомба лақтырған дұрыс.
Dialogue: 0,1:13:41.20,1:13:42.62,Default,,0,0,0,,Біздің махаббатымыз
Dialogue: 0,1:13:42.70,1:13:45.75,Default,,0,0,0,,Мисс Фио Пикколоның тағдыры шешіледі.
Dialogue: 0,1:13:45.83,1:13:47.54,Default,,0,0,0,,Сені қыбырлатып жіберуге рұқсат етпе.
Dialogue: 0,1:13:48.29,1:13:49.38,Default,,0,0,0,,Түсіндіңіз бе?
Dialogue: 0,1:13:49.46,1:13:52.50,Default,,0,0,0,,Түсінсең, шеш! Алыңыз!
Dialogue: 0,1:13:54.55,1:13:56.01,Default,,0,0,0,,Бастайық!
Dialogue: 0,1:13:56.09,1:13:59.30,Default,,0,0,0,,Бұл тітіркендіргіш. Бұл Кеджиме.
Dialogue: 0,1:14:00.10,1:14:03.39,Default,,0,0,0,,Содан кейін екі тарап те ставкаларын қоюы керек.
Dialogue: 0,1:14:08.27,1:14:08.98,Default,,0,0,0,,Өтінемін
Dialogue: 0,1:14:09.06,1:14:09.98,Default,,0,0,0,,Рахмет
Dialogue: 0,1:14:10.90,1:14:12.11,Default,,0,0,0,,Оны тез қойыңыз
Dialogue: 0,1:14:15.53,1:14:17.32,Default,,0,0,0,,Екі тараптың да шағымдары жоқ.
Dialogue: 0,1:14:17.70,1:14:19.62,Default,,0,0,0,,Олай болса, бастамас бұрын назар аударайық.
Dialogue: 0,1:14:19.95,1:14:22.79,Default,,0,0,0,,Жоқ, мен тазалықты жақсы көремін.
Dialogue: 0,1:14:25.08,1:14:27.83,Default,,0,0,0,,Тексеріңіз, сіз доссыз болуыңыз керек.
Dialogue: 0,1:14:28.25,1:14:30.79,Default,,0,0,0,,Фио Мен біткен бойда шіркеуге барамын.
Dialogue: 0,1:14:31.84,1:14:35.92,Default,,0,0,0,,Уайымдама, көңілі қалғанша анаңның әңгімесіне үйреніп алған жақсы.
Dialogue: 0,1:14:37.63,1:14:38.38,Default,,0,0,0,,Ара
Dialogue: 0,1:14:41.10,1:14:43.39,Default,,0,0,0,,Менімен суретке түсе аласыз ба?
Dialogue: 0,1:14:43.47,1:14:44.31,Default,,0,0,0,,Мен еденге келдім.
Dialogue: 0,1:14:44.64,1:14:46.31,Default,,0,0,0,,Барлығы күліп тұр!
Dialogue: 0,1:14:46.98,1:14:48.10,Default,,0,0,0,,Күлкілі
Dialogue: 0,1:14:48.19,1:14:49.39,Default,,0,0,0,,Жоғары
Dialogue: 0,1:14:52.52,1:14:55.32,Default,,0,0,0,,(Барлығының құлаған дыбысы)
Dialogue: 0,1:15:10.37,1:15:13.09,Default,,0,0,0,,Ойын 3 минутта жеңсе, Қараның артықшылығы бар!
Dialogue: 0,1:15:13.59,1:15:16.59,Default,,0,0,0,,Керемет! Сіз мұны ай сайын жасай аласыз ба деп ойлаймын ...
Dialogue: 0,1:15:20.05,1:15:22.09,Default,,0,0,0,,Ұшудан 15 секунд бұрын
Dialogue: 0,1:15:26.52,1:15:27.98,Default,,0,0,0,,Бұл керемет.
Dialogue: 0,1:15:28.06,1:15:28.73,Default,,0,0,0,,Вум
Dialogue: 0,1:15:29.56,1:15:30.23,Default,,0,0,0,,сол себепті мені өзінің батлері ретінде қасында ұстады.
Dialogue: 0,1:15:30.81,1:15:32.23,Default,,0,0,0,,4… 3…
Dialogue: 0,1:15:32.77,1:15:34.06,Default,,0,0,0,,2… 1…
Dialogue: 0,1:15:34.27,1:15:34.94,Default,,0,0,0,,0
Dialogue: 0,1:15:36.65,1:15:38.69,Default,,0,0,0,,(Шыншыл музыка)
Dialogue: 0,1:15:43.91,1:15:45.12,Default,,0,0,0,,Кертис жеңді!
Dialogue: 0,1:16:03.22,1:16:05.26,Default,,0,0,0,,Жарайды, бұл біржақты іс болып барады.
Dialogue: 0,1:16:05.35,1:16:06.05,Default,,0,0,0,,...
Dialogue: 0,1:16:13.06,1:16:15.61,Default,,0,0,0,,Порко, сен не істеп жатырсың? Биіктікке жету.
Dialogue: 0,1:16:15.69,1:16:17.69,Default,,0,0,0,,Қазір басыңды көтерсең, доп соғылады.
Dialogue: 0,1:16:18.28,1:16:20.19,Default,,0,0,0,,Су беті тайғақ болса, оны бұзу қиынырақ.
Dialogue: 0,1:16:26.95,1:16:29.49,Default,,0,0,0,,Пайдасы жоқ, ән айтайын десем де, қолыңа ұстатпаймын.
Dialogue: 0,1:16:45.89,1:16:48.39,Default,,0,0,0,,Қандай бұралу! Шошқа артқы орындыққа жайғасты.
Dialogue: 0,1:16:48.64,1:16:49.31,Default,,0,0,0,,Твист?
Dialogue: 0,1:16:49.93,1:16:52.85,Default,,0,0,0,,Бұл трюк шошқаны Адриатика теңізінің атына айналдырды.
Dialogue: 0,1:16:58.07,1:16:59.07,Default,,0,0,0,,Ақымақ
Dialogue: 0,1:17:05.20,1:17:05.99,Default,,0,0,0,,Уцузо!
Dialogue: 0,1:17:10.99,1:17:12.00,Default,,0,0,0,,Ән айтпа
Dialogue: 0,1:17:12.08,1:17:13.04,Default,,0,0,0,,Қозғалтқыштың бәріне бұрыш па?
Dialogue: 0,1:17:14.37,1:17:15.46,Default,,0,0,0,,Мен оны оқыдым.
Dialogue: 0,1:17:15.75,1:17:17.79,Default,,0,0,0,,Соңына дейін ән айту ойымда жоқ.
Dialogue: 0,1:17:17.88,1:17:18.63,Default,,0,0,0,,Иә?
Dialogue: 0,1:17:18.84,1:17:20.50,Default,,0,0,0,,Шошқалар өлтірмейді.
Dialogue: 0,1:17:21.21,1:17:23.47,Default,,0,0,0,,Америка Құрама Штаттары дәл қазір дүрбелеңде болуы мүмкін.
Dialogue: 0,1:17:23.55,1:17:24.80,Default,,0,0,0,,Міне!
Dialogue: 0,1:17:25.38,1:17:26.72,Default,,0,0,0,,Әй, мен ән айта алмаймын.
Dialogue: 0,1:17:26.80,1:17:28.39,Default,,0,0,0,,Мен айтқанымдай.
Dialogue: 0,1:17:29.51,1:17:32.02,Default,,0,0,0,,Егер сіз дәл қазір Америкадағы депрессия туралы айтуға тырыссаңыз, сіз дұрыс боласыз.
Dialogue: 0,1:17:32.10,1:17:33.68,Default,,0,0,0,,Басқа адам бұрылып, тынышталғаннан кейін...
Dialogue: 0,1:17:33.77,1:17:36.44,Default,,0,0,0,,Мен қозғалтқышты аяқтау үшін екі-үш атуды жоспарлап отырмын.
Dialogue: 0,1:17:36.81,1:17:40.02,Default,,0,0,0,,Мен соғыс немесе басқа нәрсе болғанын қаламаймын.
Dialogue: 0,1:17:40.11,1:17:41.11,Default,,0,0,0,,Порко…
Dialogue: 0,1:17:42.23,1:17:45.03,Default,,0,0,0,,Темее, сен маған келейін деп жатырсың ба? Кәне!
Dialogue: 0,1:17:46.57,1:17:49.12,Default,,0,0,0,,Ал, пулемет жынды екен.
Dialogue: 0,1:17:49.20,1:17:50.62,Default,,0,0,0,,Замамиро!
Dialogue: 0,1:17:56.25,1:17:57.37,Default,,0,0,0,,Мұнда кел!
Dialogue: 0,1:18:00.50,1:18:02.88,Default,,0,0,0,,Менің артымнан жүр, шошқа.
Dialogue: 0,1:18:08.30,1:18:10.30,Default,,0,0,0,,Мына жолмен келе жатыр! Ооо!
Dialogue: 0,1:18:10.76,1:18:12.10,Default,,0,0,0,,Мен шошқаны соқтым!
Dialogue: 0,1:18:13.39,1:18:14.52,Default,,0,0,0,,Уау Ориро
Dialogue: 0,1:18:17.94,1:18:19.65,Default,,0,0,0,,Уау
Dialogue: 0,1:18:25.19,1:18:26.32,Default,,0,0,0,,Сол жерде орындаңыз.
Dialogue: 0,1:18:32.03,1:18:34.20,Default,,0,0,0,,Керемет! шошқа бұлтты ұстады
Dialogue: 0,1:18:40.96,1:18:42.25,Default,,0,0,0,,Мұндай әуе шайқасы
Dialogue: 0,1:18:42.34,1:18:44.55,Default,,0,0,0,,Сен менімен өмірде бір-ақ рет кездесе аласың.
Dialogue: 0,1:18:44.71,1:18:45.88,Default,,0,0,0,,Мен таң қалдым...
Dialogue: 0,1:18:48.34,1:18:51.64,Default,,0,0,0,,Уау
Dialogue: 0,1:18:55.93,1:18:59.14,Default,,0,0,0,,Біз дайындап қойсақ та, асықпасақ бітеді.
Dialogue: 0,1:18:59.23,1:19:01.94,Default,,0,0,0,,Дәл осы кезде мен бөлмеге кірдім.
Dialogue: 0,1:19:02.02,1:19:03.82,Default,,0,0,0,,Сіз барасыз ба? Әлде сен емес пе?
Dialogue: 0,1:19:04.15,1:19:05.53,Default,,0,0,0,,Тіпті мен оны көргім келеді
Dialogue: 0,1:19:06.40,1:19:08.53,Default,,0,0,0,,(Морзе кодын қабылдау дыбысы)
Dialogue: 0,1:19:17.00,1:19:19.75,Default,,0,0,0,,Жүрек № G To Buta Коумен байланысу үшін
Dialogue: 0,1:19:20.00,1:19:23.13,Default,,0,0,0,,Әуе күштері Гакагитсукета Бакасаваги Вооямаро
Dialogue: 0,1:19:23.67,1:19:25.80,Default,,0,0,0,,F... Бұл Феррарин.
Dialogue: 0,1:19:28.84,1:19:29.76,Default,,0,0,0,,Асығу керек
Dialogue: 0,1:19:49.03,1:19:52.36,Default,,0,0,0,,Сонда да екеуі де қатал.
Dialogue: 0,1:19:52.45,1:19:54.49,Default,,0,0,0,,Әлі алда.
Dialogue: 0,1:19:56.41,1:19:58.45,Default,,0,0,0,,Сәттілік Порко!
Dialogue: 0,1:19:59.20,1:20:01.46,Default,,0,0,0,,Куку…
Dialogue: 0,1:20:01.96,1:20:04.46,Default,,0,0,0,,Уннуну, менің ойымша, бұл шошқа...
Dialogue: 0,1:20:10.30,1:20:12.84,Default,,0,0,0,,Сіз Temee сияқты нәрсеге Фио жасай аласыз ба?
Dialogue: 0,1:20:18.52,1:20:20.52,Default,,0,0,0,,Ей, сенің артыңда шошқа!
Dialogue: 0,1:20:21.14,1:20:22.27,Default,,0,0,0,,Бұл финал!
Dialogue: 0,1:20:26.31,1:20:27.15,Default,,0,0,0,,Иә?
Dialogue: 0,1:20:29.53,1:20:30.53,Default,,0,0,0,,Кептеліс болды.
Dialogue: 0,1:20:34.74,1:20:35.82,Default,,0,0,0,,Аяқтау
Dialogue: 0,1:20:39.08,1:20:40.70,Default,,0,0,0,,Иә? иә?
Dialogue: 0,1:20:41.25,1:20:42.58,Default,,0,0,0,,Сонымен болды ма?
Dialogue: 0,1:20:43.75,1:20:46.88,Default,,0,0,0,,Бакаяру Омие - тамагири.
Dialogue: 0,1:20:47.09,1:20:49.96,Default,,0,0,0,,Жарайды, сынды, Фионың бөксесінің кесірінен.
Dialogue: 0,1:20:49.96,1:20:50.80,Default,,0,0,0,,Жарайды, сынды, Фионың бөксесінің кесірінен.
Dialogue: 0,1:20:53.18,1:20:55.97,Default,,0,0,0,,Бұл тең ойын болмайды.
Dialogue: 0,1:20:57.97,1:21:01.10,Default,,0,0,0,,Мен Батысқа ессіз емеспін. Бұл рас па?
Dialogue: 0,1:21:01.18,1:21:02.14,Default,,0,0,0,,(Доптың соғу дыбысы)
Dialogue: 0,1:21:03.64,1:21:04.73,Default,,0,0,0,,Теми!
Dialogue: 0,1:21:07.19,1:21:10.73,Default,,0,0,0,,Мен осындай нәрсені аламын ба? Сәлем Күміс!
Dialogue: 0,1:21:19.12,1:21:20.83,Default,,0,0,0,,Мынау жиіркенішті шошқа!
Dialogue: 0,1:21:22.29,1:21:22.95,Default,,0,0,0,,...
Dialogue: 0,1:21:23.04,1:21:24.66,Default,,0,0,0,,Хаха Саған жетеді ме? Иә!
Dialogue: 0,1:21:24.75,1:21:26.08,Default,,0,0,0,,Вахахаха
Dialogue: 0,1:21:26.17,1:21:27.21,Default,,0,0,0,,Мына тауықты жасайық
Dialogue: 0,1:21:27.29,1:21:28.38,Default,,0,0,0,,Жарайсың!
Dialogue: 0,1:21:28.46,1:21:29.79,Default,,0,0,0,,Махаббат үшін бұл не?
Dialogue: 0,1:21:29.88,1:21:30.67,Default,,0,0,0,,Имобута ханым!
Dialogue: 0,1:21:32.17,1:21:33.97,Default,,0,0,0,,Бұл жерде біртүрлі нәрсе бар.
Dialogue: 0,1:21:34.05,1:21:35.01,Default,,0,0,0,,А, келе жатыр!
Dialogue: 0,1:21:44.23,1:21:45.19,Default,,0,0,0,,Мен қайтып келдім!
Dialogue: 0,1:21:45.39,1:21:48.44,Default,,0,0,0,,Күте тұрыңыз! Мен жүлденің жоғалғанын қаламаймын.
Dialogue: 0,1:21:49.02,1:21:51.78,Default,,0,0,0,,Оған көмектесу мүмкін емес, күте тұрыңыз, Temee т.б.
Dialogue: 0,1:21:51.86,1:21:54.11,Default,,0,0,0,,(аудитория шулары)
Dialogue: 0,1:21:57.82,1:21:59.45,Default,,0,0,0,,Шошқаны артық жеу
Dialogue: 0,1:22:01.49,1:22:03.25,Default,,0,0,0,,Ковбой?
Dialogue: 0,1:22:09.17,1:22:10.42,Default,,0,0,0,,Генкоцумен бірге кел
Dialogue: 0,1:22:10.96,1:22:12.71,Default,,0,0,0,,Сиырларға оралу
Dialogue: 0,1:22:17.93,1:22:19.64,Default,,0,0,0,,Керемет! (Көрермендер) Барыңыз!
Dialogue: 0,1:22:19.72,1:22:21.18,Default,,0,0,0,,Порко, қолыңнан келгеннің бәрін істе
Dialogue: 0,1:22:22.35,1:22:25.18,Default,,0,0,0,,Хехе, тұр, шошқа жасайық.
Dialogue: 0,1:22:26.18,1:22:27.19,Default,,0,0,0,,Уау
Dialogue: 0,1:22:29.06,1:22:29.73,Default,,0,0,0,,Бірақ
Dialogue: 0,1:22:29.81,1:22:30.61,Default,,0,0,0,,Теми, жүр.
Dialogue: 0,1:22:31.27,1:22:32.02,Default,,0,0,0,,Сені махаббат сиқырымен баурап алатын боламын.
Dialogue: 0,1:22:37.57,1:22:38.66,Default,,0,0,0,,(Кертистің су түкірген дыбысы)
Dialogue: 0,1:22:55.26,1:22:58.34,Default,,0,0,0,,Жоғарғы жоғарғы блок! блок блогы
Dialogue: 0,1:22:58.43,1:22:59.80,Default,,0,0,0,,Жүр! Жақсы, жақсы
Dialogue: 0,1:23:00.39,1:23:02.76,Default,,0,0,0,,Жақсы, мен баруға дайынмын.
Dialogue: 0,1:23:02.85,1:23:04.64,Default,,0,0,0,,Одақ қалай пайда болады?
Dialogue: 0,1:23:04.72,1:23:06.31,Default,,0,0,0,,Гонг жоқ! Гонг!
Dialogue: 0,1:23:10.56,1:23:11.77,Default,,0,0,0,,Сіз көбірек жылдамдық ала алмайсыз ба?
Dialogue: 0,1:23:11.86,1:23:13.82,Default,,0,0,0,,Бұл мүмкін емес. Қозғалтқыш жанып кетеді.
Dialogue: 0,1:23:15.03,1:23:17.28,Default,,0,0,0,,дирижабль мінгендердің бәрі шынымен де ақымақ.
Dialogue: 0,1:23:18.90,1:23:21.28,Default,,0,0,0,,(қабырғаның соғылған дыбысы)
Dialogue: 0,1:23:23.49,1:23:26.95,Default,,0,0,0,,Фио, дәл қазір менің соққымды көрдіңіз бе?
Dialogue: 0,1:23:31.42,1:23:33.71,Default,,0,0,0,,Мен оның орнын келесі жолы толтырамын (Табаның соғылған дыбысы)
Dialogue: 0,1:23:34.67,1:23:37.55,Default,,0,0,0,,Мен сені бұл жолы маған бұруға мәжбүр етемін, Порко, мықтап.
Dialogue: 0,1:23:37.63,1:23:38.72,Default,,0,0,0,,Сәттілік!
Dialogue: 0,1:23:39.09,1:23:40.88,Default,,0,0,0,,Мен сені қабан шошқаға айналдырамын
Dialogue: 0,1:23:43.26,1:23:44.93,Default,,0,0,0,,Келіңіздер! Түсті бояйық
Dialogue: 0,1:23:45.97,1:23:48.18,Default,,0,0,0,,Ирома - Теми
Dialogue: 0,1:23:49.93,1:23:52.06,Default,,0,0,0,,Кездейсоқ және қайталап
Dialogue: 0,1:23:52.15,1:23:53.44,Default,,0,0,0,,Бұл Теми!
Dialogue: 0,1:23:53.81,1:23:56.19,Default,,0,0,0,,Джина немесе Фио.
Dialogue: 0,1:23:56.52,1:23:57.90,Default,,0,0,0,,Не?
Dialogue: 0,1:24:00.74,1:24:02.45,Default,,0,0,0,,Жалғыз қалмаңыз!
Dialogue: 0,1:24:04.91,1:24:06.08,Default,,0,0,0,,Джина ше?
Dialogue: 0,1:24:08.54,1:24:11.54,Default,,0,0,0,,Джина Мені жайбарақат Джина деп атама.
Dialogue: 0,1:24:12.83,1:24:14.46,Default,,0,0,0,,Джинадан Темиге
Dialogue: 0,1:24:14.75,1:24:16.80,Default,,0,0,0,,Мен сені жақсы көремін...
Dialogue: 0,1:24:20.47,1:24:22.80,Default,,0,0,0,,Оның келуін күтіп отыр
Dialogue: 0,1:24:26.14,1:24:27.51,Default,,0,0,0,,Әрқашан бақшада
Dialogue: 0,1:24:29.39,1:24:31.69,Default,,0,0,0,,Мен көптен күттім.
Dialogue: 0,1:24:34.65,1:24:35.86,Default,,0,0,0,,Гуах... (аудитория айқайлайды)
Dialogue: 0,1:24:36.69,1:24:37.82,Default,,0,0,0,,(қабырғаның соғылған дыбысы)
Dialogue: 0,1:24:39.48,1:24:40.32,Default,,0,0,0,,Порко!
Dialogue: 0,1:24:40.40,1:24:43.07,Default,,0,0,0,,Бұл гонг! (Кертис) Санап көр.
Dialogue: 0,1:24:44.11,1:24:45.24,Default,,0,0,0,,Өйткені, қара!
Dialogue: 0,1:24:51.20,1:24:53.37,Default,,0,0,0,,Қарасам, итальян әскері әлі келген жоқ.
Dialogue: 0,1:25:03.55,1:25:04.22,Default,,0,0,0,,(қабырғаның соғылған дыбысы)
Dialogue: 0,1:25:04.93,1:25:08.26,Default,,0,0,0,,Сіз жалған қауесет таратып жатырсыз...
Dialogue: 0,1:25:12.14,1:25:14.35,Default,,0,0,0,,Мен түсінбедім, ақымақ...
Dialogue: 0,1:25:15.15,1:25:17.40,Default,,0,0,0,,Бұл өтірік емес!
Dialogue: 0,1:25:20.07,1:25:21.82,Default,,0,0,0,,Фио мұны істемейді.
Dialogue: 0,1:25:23.32,1:25:24.07,Default,,0,0,0,,Бұл Джинаның қайығы!
Dialogue: 0,1:25:27.53,1:25:28.70,Default,,0,0,0,,Бұл үнемдеу сигналы!
Dialogue: 0,1:25:28.78,1:25:29.74,Default,,0,0,0,,(Тоқсу дыбысы)
Dialogue: 0,1:25:40.75,1:25:42.67,Default,,0,0,0,,Бір! Екі!
Dialogue: 0,1:25:43.30,1:25:45.18,Default,,0,0,0,,Кім бірінші тұрса, сол жеңеді (Әуе қарақшылары одағының басшысы C) Үш
Dialogue: 0,1:25:45.26,1:25:46.18,Default,,0,0,0,,Төрт
Dialogue: 0,1:25:46.26,1:25:47.97,Default,,0,0,0,,Барлығы, жолды босатыңдар (Аспан қарақшылары одағының басшысы C) Бес
Dialogue: 0,1:25:48.05,1:25:49.05,Default,,0,0,0,,Алты
Dialogue: 0,1:25:49.76,1:25:50.85,Default,,0,0,0,,Жеті!
Dialogue: 0,1:25:51.26,1:25:53.14,Default,,0,0,0,,Джина, жоқ.
Dialogue: 0,1:25:53.35,1:25:54.68,Default,,0,0,0,,Сегіз!
Dialogue: 0,1:25:56.77,1:25:58.56,Default,,0,0,0,,Марко Марко, тыңдап тұрсың ба?
Dialogue: 0,1:26:01.90,1:26:04.57,Default,,0,0,0,,Сіз басқа қызды бақытсыз еткіңіз келе ме?
Dialogue: 0,1:26:09.99,1:26:11.08,Default,,0,0,0,,Тоғыз!
Dialogue: 0,1:26:12.29,1:26:13.12,Default,,0,0,0,,Те…
Dialogue: 0,1:26:13.79,1:26:15.37,Default,,0,0,0,,Порко!
Dialogue: 0,1:26:18.12,1:26:19.38,Default,,0,0,0,,Порку!
Dialogue: 0,1:26:19.46,1:26:20.71,Default,,0,0,0,,Рахмет сізге Порко
Dialogue: 0,1:26:21.13,1:26:23.34,Default,,0,0,0,,Эй, жарық.
Dialogue: 0,1:26:30.89,1:26:32.51,Default,,0,0,0,,Міне, фестиваль аяқталды.
Dialogue: 0,1:26:32.60,1:26:34.43,Default,,0,0,0,,Италияның әуе күштері осында келеді.
Dialogue: 0,1:26:35.31,1:26:36.94,Default,,0,0,0,,Барлығыңыз тезірек қашыңыз.
Dialogue: 0,1:26:37.69,1:26:39.98,Default,,0,0,0,,Оның орнына менің дүкеніме келіңіз.
Dialogue: 0,1:26:40.31,1:26:41.44,Default,,0,0,0,,Мен сізге жақсы қызмет көрсетемін.
Dialogue: 0,1:26:41.86,1:26:43.44,Default,,0,0,0,,Уау, тамаша.
Dialogue: 0,1:26:43.53,1:26:45.15,Default,,0,0,0,,Балалар, тартыңдар!
Dialogue: 0,1:26:45.24,1:26:46.44,Default,,0,0,0,,О
Dialogue: 0,1:26:56.62,1:26:57.71,Default,,0,0,0,,Ауыл ақсақалы иығымнан қақты, міне, міндет орындалды
Dialogue: 0,1:26:59.96,1:27:03.09,Default,,0,0,0,,Бастық, асығыңыз! Асықшы!
Dialogue: 0,1:27:03.17,1:27:05.00,Default,,0,0,0,,Шу, Кежиме, Кежиме
Dialogue: 0,1:27:07.34,1:27:09.63,Default,,0,0,0,,Мен шошқаларды жек көремін, бірақ мен сені жақсы көремін
Dialogue: 0,1:27:10.18,1:27:12.43,Default,,0,0,0,,Жақсы ұшатын қайық жасаушы болыңыз, сау болыңыз!
Dialogue: 0,1:27:13.26,1:27:16.14,Default,,0,0,0,,Рахмет, кейде еденге келіңіз.
Dialogue: 0,1:27:16.98,1:27:19.77,Default,,0,0,0,,Сізге де рахмет, Кертис мырза.
Dialogue: 0,1:27:19.85,1:27:22.77,Default,,0,0,0,,Келесі жолы мен құмар ойнамаймын, бірақ ресми түрде өтініш беремін.
Dialogue: 0,1:27:23.65,1:27:26.32,Default,,0,0,0,,Жақсы, бірақ мен шешіп қойдым.
Dialogue: 0,1:27:26.86,1:27:29.45,Default,,0,0,0,,Сіз Джинаның қайығында боласыз.
Dialogue: 0,1:27:29.53,1:27:30.78,Default,,0,0,0,,Жоқ, жоқ!
Dialogue: 0,1:27:31.36,1:27:34.66,Default,,0,0,0,,Порконың қайығына мініңіз! Мен саған серіктес екенімізді айттым.
Dialogue: 0,1:27:34.74,1:27:35.66,Default,,0,0,0,,Кя!
Dialogue: 0,1:27:36.45,1:27:37.29,Default,,0,0,0,,Джина
Dialogue: 0,1:27:37.37,1:27:39.91,Default,,0,0,0,,Мына жігітті Катаги әлеміне қайтаруыңызды өтінемін.
Dialogue: 0,1:27:42.21,1:27:44.92,Default,,0,0,0,,Айлакер адамдар әрқашан солай жасайды.
Dialogue: 0,1:27:47.42,1:27:49.92,Default,,0,0,0,,Кешіріңіз, өтінемін.
Dialogue: 0,1:27:55.26,1:27:55.93,Default,,0,0,0,,Оны алыңыз
Dialogue: 0,1:28:28.46,1:28:30.42,Default,,0,0,0,,Италияның әуе күштері осында.
Dialogue: 0,1:28:30.72,1:28:31.84,Default,,0,0,0,,Мен сізге көмектесе аламын ба?
Dialogue: 0,1:28:32.09,1:28:34.14,Default,,0,0,0,,Оларды бір жаққа тартыңыз.
Dialogue: 0,1:28:34.80,1:28:37.10,Default,,0,0,0,,Ах! О, күтіңіз, бұл бет! Эй!
Dialogue: 0,1:28:38.14,1:28:39.64,Default,,0,0,0,,Маған бетіңізді көрсетіңіз!
Dialogue: 0,1:28:39.72,1:28:41.06,Default,,0,0,0,,Бұл сенің қайығың шығар.
Dialogue: 0,1:28:41.14,1:28:42.10,Default,,0,0,0,,Кішкене ғана
Dialogue: 0,1:28:46.69,1:28:50.11,Default,,0,0,0,,(Дирегалы қозғалтқыштың дыбысы)
Dialogue: 0,1:28:51.36,1:28:54.45,Default,,0,0,0,,Италия әуе күштерін орналастыру нәтижесіз аяқталды...
Dialogue: 0,1:28:55.24,1:28:57.53,Default,,0,0,0,,Миланға қайтатын күнім келсе де...
Dialogue: 0,1:28:58.28,1:29:00.58,Default,,0,0,0,,Порко келмеді.
Dialogue: 0,1:29:02.21,1:29:03.79,Default,,0,0,0,,Бірақ оның орнына...
Dialogue: 0,1:29:03.87,1:29:06.88,Default,,0,0,0,,Мен Джинамен өте жақсы дос болдым.
Dialogue: 0,1:29:08.75,1:29:12.67,Default,,0,0,0,,Содан бері көптеген ірі соғыстар мен сәтсіздіктер болды...
Dialogue: 0,1:29:13.34,1:29:16.01,Default,,0,0,0,,Сол достық күні бүгінге дейін жалғасып келеді.
Dialogue: 0,1:29:18.47,1:29:20.14,Default,,0,0,0,,Пикколоға қосылғаннан кейін де...
Dialogue: 0,1:29:20.22,1:29:23.56,Default,,0,0,0,,Жазғы демалысыңызды Adriano қонақүйінде өткізу...
Dialogue: 0,1:29:23.64,1:29:25.65,Default,,0,0,0,,Менің маңызды ережелерім
Dialogue: 0,1:29:27.11,1:29:29.77,Default,,0,0,0,,Джина барған сайын әдемі болып барады...
Dialogue: 0,1:29:30.07,1:29:31.78,Default,,0,0,0,,Ескі достар да келеді
Dialogue: 0,1:29:34.65,1:29:37.62,Default,,0,0,0,,Дұрыс, ол әлі алыпқа айналған жоқ...
Dialogue: 0,1:29:38.07,1:29:40.62,Default,,0,0,0,,Кертис мырза да маған анда-санда хат жазып тұрады.
Dialogue: 0,1:29:40.70,1:29:41.54,Default,,0,0,0,,«Үш махаббат»
Dialogue: 0,1:29:41.62,1:29:44.16,Default,,0,0,0,,Мен Адриатикалық жазды сағындым...
Dialogue: 0,1:29:46.58,1:29:48.84,Default,,0,0,0,,Джинаның шығармасына не болды?
Dialogue: 0,1:29:49.34,1:29:51.34,Default,,0,0,0,,Біздің жалғыз құпиямыз...
Dialogue: 0,1:30:08.52,1:30:14.61,Default,,0,0,0,,♪~
Dialogue: 0,1:33:33.89,1:33:35.48,Default,,0,0,0,,~♪
