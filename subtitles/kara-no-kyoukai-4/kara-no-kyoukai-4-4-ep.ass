Dialogue: 0,0:00:01.55,0:00:07.55,CNsub,NTP,0,0,0,,КамиГами
Dialogue: 0,0:45:14.65,0:45:19.65,CNsub,NTP,0,0,0,,＠/···
Dialogue: 0,0:05:17.87,0:05:24.33,EDJ,NTP,0000,0000,0000,,Жоғары қарасаң, құрметке бөленесің.
Dialogue: 0,0:05:24.70,0:05:31.32,EDJ,NTP,0000,0000,0000,,Менің ұстазымның рақымы
Dialogue: 0,0:05:17.87,0:05:24.33,EDC,NTP,0000,0000,0000,,Вагабобуваның киімі
Dialogue: 0,0:05:24.70,0:05:31.32,EDC,NTP,0000,0000,0000,,Қарт шебердің мейірімділігі
Dialogue: 0,0:37:31.32,0:37:35.32,EDJ,NTP,0000,0000,0000,,Арман фрагменті
Dialogue: 0,0:37:37.01,0:37:41.18,EDJ,NTP,0000,0000,0000,,Сіз оны маған бердіңіз
Dialogue: 0,0:37:42.74,0:37:51.09,EDJ,NTP,0000,0000,0000,,Түксіз түнде жасырынып
Dialogue: 0,0:37:54.37,0:37:58.80,EDJ,NTP,0000,0000,0000,,Ұя бастаған жұлдыз
Dialogue: 0,0:38:00.30,0:38:05.21,EDJ,NTP,0000,0000,0000,,Бір нәрсе жоғалады
Dialogue: 0,0:38:06.02,0:38:16.96,EDJ,NTP,0000,0000,0000,,Таң атқандағы АРИЯ жаңғырықты
Dialogue: 0,0:38:17.20,0:38:22.57,EDJ,NTP,0000,0000,0000,,Осы бітпейтін жаңбырда
Dialogue: 0,0:38:22.91,0:38:28.34,EDJ,NTP,0000,0000,0000,,Кешегі күннен қорықпа
Dialogue: 0,0:38:28.71,0:38:34.48,EDJ,NTP,0000,0000,0000,,Мен сені қазір жоғалтқан болашақ
Dialogue: 0,0:38:34.97,0:38:42.73,EDJ,NTP,0000,0000,0000,,Басы ғана
Dialogue: 0,0:38:43.25,0:38:48.62,EDJ,NTP,0000,0000,0000,,Шексіз қараңғылықта
Dialogue: 0,0:38:48.97,0:38:54.49,EDJ,NTP,0000,0000,0000,,Сіз маған берген отты
Dialogue: 0,0:38:54.80,0:39:00.25,EDJ,NTP,0000,0000,0000,,Ғибадатхананың осы кеудесінде
Dialogue: 0,0:39:00.58,0:39:04.73,EDJ,NTP,0000,0000,0000,,Өмір туды
Dialogue: 0,0:39:05.02,0:39:11.67,EDJ,NTP,0000,0000,0000,,Жарықтандыру
Dialogue: 0,0:39:24.53,0:39:29.73,EDJ,NTP,0000,0000,0000,,Не жоғалып кетті
Dialogue: 0,0:39:30.23,0:39:35.46,EDJ,NTP,0000,0000,0000,,Не өзгеріссіз қалады
Dialogue: 0,0:39:35.96,0:39:44.82,EDJ,NTP,0000,0000,0000,,Қайғылы аспан жарқырайды
Dialogue: 0,0:39:47.66,0:39:53.01,EDJ,NTP,0000,0000,0000,,Қоштасу
Dialogue: 0,0:39:53.51,0:39:58.76,EDJ,NTP,0000,0000,0000,,Бір-біріңе күлімдеңдер
Dialogue: 0,0:39:59.19,0:40:10.97,EDJ,NTP,0000,0000,0000,,Жалғыздық АРИЯ
Dialogue: 0,0:40:33.58,0:40:39.12,EDJ,NTP,0000,0000,0000,,Әй, адамдар қанша уақыт жалғыз бола алады?
Dialogue: 0,0:40:39.42,0:40:44.85,EDJ,NTP,0000,0000,0000,,Ол екеуіңе ғашық болса керек.
Dialogue: 0,0:40:45.17,0:40:51.11,EDJ,NTP,0000,0000,0000,,Сіздің әдемі болашағыңыз әлі де қалады
Dialogue: 0,0:40:51.47,0:40:59.81,EDJ,NTP,0000,0000,0000,,Жаңа ғана басталды……
Dialogue: 0,0:41:05.65,0:41:10.86,EDJ,NTP,0000,0000,0000,,Мейірімділікті білмейді
Dialogue: 0,0:41:11.23,0:41:16.82,EDJ,NTP,0000,0000,0000,,Маған жасаған жақсылығың
Dialogue: 0,0:41:17.14,0:41:22.40,EDJ,NTP,0000,0000,0000,,Ғибадатхананың осы кеудесінде
Dialogue: 0,0:41:22.79,0:41:27.01,EDJ,NTP,0000,0000,0000,,Аты жоқ жарық
Dialogue: 0,0:41:27.31,0:41:29.51,EDJ,NTP,0000,0000,0000,,жарық
Dialogue: 0,0:41:29.58,0:41:34.11,EDJ,NTP,0000,0000,0000,,Жалғыздықтың қайығында есу
Dialogue: 0,0:41:34.48,0:41:40.02,EDJ,NTP,0000,0000,0000,,Жалын аза тұтады.
Dialogue: 0,0:41:40.40,0:41:45.76,EDJ,NTP,0000,0000,0000,,Гаран әлемінде
Dialogue: 0,0:41:46.19,0:41:57.65,EDJ,NTP,0000,0000,0000,,Көптеген ARIA-лар жаңғыруда
Dialogue: 0,0:37:31.32,0:37:35.32,EDC,NTP,0000,0000,0000,,Арман бөліктері
Dialogue: 0,0:37:37.01,0:37:41.18,EDC,NTP,0000,0000,0000,,Міне, келдіңіз.
Dialogue: 0,0:37:42.74,0:37:51.09,EDC,NTP,0000,0000,0000,,Өлім таңы
Dialogue: 0,0:37:54.37,0:37:58.80,EDC,NTP,0000,0000,0000,,Бастапқы жіптің жұлдызы
Dialogue: 0,0:38:00.30,0:38:05.21,EDC,NTP,0000,0000,0000,,Бас тартудың бірінші кезеңі
Dialogue: 0,0:38:06.02,0:38:16.96,EDC,NTP,0000,0000,0000,,...
Dialogue: 0,0:38:17.20,0:38:22.57,EDC,NTP,0000,0000,0000,,Толассыз жауған жаңбырда қайта кездеспеу
Dialogue: 0,0:38:22.91,0:38:28.34,EDC,NTP,0000,0000,0000,,Өткеннен қорқу
Dialogue: 0,0:38:28.71,0:38:34.48,EDC,NTP,0000,0000,0000,,Енді болашағыңызды қалай жоғалтуға болады
Dialogue: 0,0:38:34.97,0:38:42.73,EDC,NTP,0000,0000,0000,,Ағымдағы таланттың басталуы
Dialogue: 0,0:38:43.25,0:38:48.62,EDC,NTP,0000,0000,0000,,Таусылған қара түнек
Dialogue: 0,0:38:48.97,0:38:54.49,EDC,NTP,0000,0000,0000,,Бұл менің алауым.
Dialogue: 0,0:38:54.80,0:39:00.25,EDC,NTP,0000,0000,0000,,Мен қайдамын
Dialogue: 0,0:39:00.58,0:39:04.73,EDC,NTP,0000,0000,0000,,Ичичо Теруйоның келуі
Dialogue: 0,0:39:05.02,0:39:11.67,EDC,NTP,0000,0000,0000,,Туғаннан кейінгі өмір
Dialogue: 0,0:39:24.53,0:39:29.73,EDC,NTP,0000,0000,0000,,Жоғалған адам
Dialogue: 0,0:39:30.23,0:39:35.46,EDC,NTP,0000,0000,0000,,Ванасыз құқық реформасының фактілері
Dialogue: 0,0:39:35.96,0:39:44.82,EDC,NTP,0000,0000,0000,,Қатал өтірік
Dialogue: 0,0:39:47.66,0:39:53.01,EDC,NTP,0000,0000,0000,,Мойындау
Dialogue: 0,0:39:53.51,0:39:58.76,EDC,NTP,0000,0000,0000,,Өзара күлімсіреу
Dialogue: 0,0:39:59.19,0:40:10.97,EDC,NTP,0000,0000,0000,,Көп қатпарлы жалғыз әуен
Dialogue: 0,0:40:33.58,0:40:39.12,EDC,NTP,0000,0000,0000,,Өйткені адамдар жалғыз
Dialogue: 0,0:40:39.42,0:40:44.85,EDC,NTP,0000,0000,0000,,...
Dialogue: 0,0:40:45.17,0:40:51.11,EDC,NTP,0000,0000,0000,,Абайсызда әдемі болашақ
Dialogue: 0,0:40:51.47,0:40:59.81,EDC,NTP,0000,0000,0000,,Қазіргі таланттың бастауы......
Dialogue: 0,0:41:05.65,0:41:10.86,EDC,NTP,0000,0000,0000,,Ширанука жұмсақтық
Dialogue: 0,0:41:11.23,0:41:16.82,EDC,NTP,0000,0000,0000,,Сіздің жұмсақтығыңыз
Dialogue: 0,0:41:17.14,0:41:22.40,EDC,NTP,0000,0000,0000,,Мен қайдамын
Dialogue: 0,0:41:22.79,0:41:27.01,EDC,NTP,0000,0000,0000,,...
Dialogue: 0,0:41:27.31,0:41:29.51,EDC,NTP,0000,0000,0000,,Анонимді жарық
Dialogue: 0,0:41:29.58,0:41:34.11,EDC,NTP,0000,0000,0000,,Жалғыз жалпақ қайық
Dialogue: 0,0:41:34.48,0:41:40.02,EDC,NTP,0000,0000,0000,,Трагедияның алау жинағы
Dialogue: 0,0:41:40.40,0:41:45.76,EDC,NTP,0000,0000,0000,,Дүние қайда?
Dialogue: 0,0:41:46.19,0:41:57.65,EDC,NTP,0000,0000,0000,,Қайта белсендіру саны жоқ
Dialogue: 0,0:00:49.77,0:00:50.53,JPsub,NTP,0000,0000,0000,,қуыршақтай еді.
Dialogue: 0,0:01:00.94,0:01:01.61,JPsub,NTP,0000,0000,0000,,адамзат алғаш рет Титаннан жерді қайтарып алуға қол жеткізеді.
Dialogue: 0,0:01:01.98,0:01:03.59,JPsub,NTP,0000,0000,0000,,Сана – JCS-3
Dialogue: 0,0:01:03.89,0:01:05.92,JPsub,NTP,0000,0000,0000,,Қарап тексергенде АҚ 60.
Dialogue: 0,0:01:06.16,0:01:07.36,JPsub,NTP,0000,0000,0000,,Инфузия желісін бекітіңіз
Dialogue: 0,0:01:07.69,0:01:08.63,JPsub,NTP,0000,0000,0000,,Электрокардиограмма мониторы
Dialogue: 0,0:01:08.82,0:01:09.25,JPsub,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:01:09.37,0:01:11.64,JPsub,NTP,0000,0000,0000,,Риоги мырза Түсінесіз бе, Риоги мырза?
Dialogue: 0,0:01:12.24,0:01:15.04,JPsub,NTP,0000,0000,0000,,Кешіріңіз. Менімен бірге жүрсеңіз, осында күтіңіз.
Dialogue: 0,0:01:20.86,0:01:22.28,JPsub,NTP,0000,0000,0000,,1, 2, 3
Dialogue: 0,0:01:26.03,0:01:26.92,JPsub,NTP,0000,0000,0000,,Сызықты мықтап ұстаңыз
Dialogue: 0,0:01:27.30,0:01:28.06,JPsub,NTP,0000,0000,0000,,Өмірлік маңызы бар
Dialogue: 0,0:01:28.32,0:01:30.70,JPsub,NTP,0000,0000,0000,,Қан қысымы төмен, бірақ сыртта тұрақты.
Dialogue: 0,0:01:30.89,0:01:31.58,JPsub,NTP,0000,0000,0000,,Айқас
Dialogue: 0,0:01:31.94,0:01:32.59,JPsub,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:01:35.11,0:01:36.12,JPsub,NTP,0000,0000,0000,,Сәтті интубация
Dialogue: 0,0:01:36.24,0:01:37.29,JPsub,NTP,0000,0000,0000,,Операция алдындағы емді орындау
Dialogue: 0,0:01:37.65,0:01:39.33,JPsub,NTP,0000,0000,0000,,Рёги мырза, мен сіздің кимоноңызды кесіп беремін.
Dialogue: 0,0:01:41.47,0:01:42.69,JPsub,NTP,0000,0000,0000,,Қан көп ағып жатыр.
Dialogue: 0,0:01:42.87,0:01:44.19,JPsub,NTP,0000,0000,0000,,Should I use the blood transfusion bag as a belt?
Dialogue: 0,0:01:44.35,0:01:44.74,JPsub,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:04:03.14,0:04:05.82,JPsub,NTP,0000,0000,0000,,Соңы болмады
Dialogue: 0,0:04:15.47,0:04:16.02,JPsub,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:04:16.40,0:04:17.95,JPsub,NTP,0000,0000,0000,,Келесі аяқ
Dialogue: 0,0:05:14.35,0:05:16.52,JPsub,NTP,0000,0000,0000,,Бұл өлім
Dialogue: 0,0:05:33.92,0:05:35.72,JPsub,NTP,0000,0000,0000,,Танысқаныма қуаныштымын, Микия-кун
Dialogue: 0,0:05:36.35,0:05:38.47,JPsub,NTP,0000,0000,0000,,Yes Director Aosaki
Dialogue: 0,0:05:40.44,0:05:41.65,JPsub,NTP,0000,0000,0000,,Иә, не болды?
Dialogue: 0,0:05:42.01,0:05:46.04,JPsub,NTP,0000,0000,0000,,No, the atmosphere was different from that one on the phone.
Dialogue: 0,0:05:47.87,0:05:48.71,JPsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:05:49.53,0:05:51.70,JPsub,NTP,0000,0000,0000,,Иә, онда
Dialogue: 0,0:05:52.31,0:05:57.30,JPsub,NTP,0000,0000,0000,,When you're in a business like this, there are times when you need to use different tools.
Dialogue: 0,0:05:57.95,0:06:02.07,JPsub,NTP,0000,0000,0000,,Are you switching your personality based on the presence or absence of a simple cursed vision?
Dialogue: 0,0:06:03.11,0:06:09.58,JPsub,NTP,0000,0000,0000,,So, are you wearing a box? Сіз оған мысық киіп жүрсіз бе?
Dialogue: 0,0:06:11.23,0:06:13.46,JPsub,NTP,0000,0000,0000,,I'll leave it to your imagination.
Dialogue: 0,0:07:43.29,0:07:44.37,JPsub,NTP,0000,0000,0000,,Қара
Dialogue: 0,0:08:23.47,0:08:24.38,JPsub,NTP,0000,0000,0000,,Ах.
Dialogue: 0,0:08:25.58,0:08:27.43,JPsub,NTP,0000,0000,0000,,Мұғалім, тез келіңізші.
Dialogue: 0,0:08:27.83,0:08:30.15,JPsub,NTP,0000,0000,0000,,Mr. Ryogi is Mr. Ryogi...
Dialogue: 0,0:08:33.18,0:08:35.15,JPsub,NTP,0000,0000,0000,,Mr. Ryogi, how about Okagen?
Dialogue: 0,0:08:36.12,0:08:38.11,JPsub,NTP,0000,0000,0000,,Сізде ауырсыну бар ма?
Dialogue: 0,0:08:39.20,0:08:41.34,JPsub,NTP,0000,0000,0000,,Such cases are rare.
Dialogue: 0,0:08:41.81,0:08:45.23,JPsub,NTP,0000,0000,0000,,Бірақ есін жию – ғажайып.
Dialogue: 0,0:08:45.64,0:08:46.72,JPsub,NTP,0000,0000,0000,,It was really good
Dialogue: 0,0:08:46.94,0:08:48.64,JPsub,NTP,0000,0000,0000,,Маған тамыр соғуыңызды тексеруге рұқсат етіңіз.
Dialogue: 0,0:08:51.24,0:08:54.36,JPsub,NTP,0000,0000,0000,,Look at the results of the detailed examination and make a rehabilitation plan.
Dialogue: 0,0:08:55.03,0:08:57.15,JPsub,NTP,0000,0000,0000,,Please contact your family for now.
Dialogue: 0,0:09:18.06,0:09:18.78,JPsub,NTP,0000,0000,0000,,Курогири мырза
Dialogue: 0,0:09:22.50,0:09:25.10,JPsub,NTP,0000,0000,0000,,Рёги мырза есін жиды.
Dialogue: 0,0:09:27.42,0:09:27.92,JPsub,NTP,0000,0000,0000,,Тек...
Dialogue: 0,0:09:28.29,0:09:35.16,JPsub,NTP,0000,0000,0000,,Since he has just woken up and is confused, we ask that he refrain from having anyone other than his family visit him.
Dialogue: 0,0:09:48.41,0:09:49.64,JPsub,NTP,0000,0000,0000,,Эй, мен естідім.
Dialogue: 0,0:09:51.01,0:09:53.96,JPsub,NTP,0000,0000,0000,,A new counselor is coming from today.
Dialogue: 0,0:09:54.41,0:09:56.61,JPsub,NTP,0000,0000,0000,,He's Araya sensei's successor.
Dialogue: 0,0:09:56.92,0:09:57.87,JPsub,NTP,0000,0000,0000,,Бүгіннен бастап?
Dialogue: 0,0:09:58.34,0:10:00.20,JPsub,NTP,0000,0000,0000,,Ха, мен қобалжыдым.
Dialogue: 0,0:10:00.85,0:10:02.57,JPsub,NTP,0000,0000,0000,,I hope he's a kind person.
Dialogue: 0,0:10:02.88,0:10:06.42,JPsub,NTP,0000,0000,0000,,She's probably in charge of that girl. Қазір оның көздері жақсы.
Dialogue: 0,0:10:06.79,0:10:10.69,JPsub,NTP,0000,0000,0000,,Көздеріңізді жоғалтпай, алға жылжып, бірте-бірте тыныштық орнаған сияқтысыз.
Dialogue: 0,0:10:11.13,0:10:13.44,JPsub,NTP,0000,0000,0000,,Well, I'll see you soon, little dog.
Dialogue: 0,0:10:13.89,0:10:18.01,JPsub,NTP,0000,0000,0000,,Ah, that little dog, I'm curious too.
Dialogue: 0,0:10:18.66,0:10:22.60,JPsub,NTP,0000,0000,0000,,Because it's been two years. Ол екі жыл өмір сүрді.
Dialogue: 0,0:10:22.82,0:10:24.63,JPsub,NTP,0000,0000,0000,,She's happy, isn't she?
Dialogue: 0,0:10:25.09,0:10:28.99,JPsub,NTP,0000,0000,0000,,Эй, мен де солай ойлайтын адамды қалаймын.
Dialogue: 0,0:10:40.60,0:10:42.86,JPsub,NTP,0000,0000,0000,,Бұл Аосаки, сөйлеу және мінез-құлық терапевті.
Dialogue: 0,0:10:43.35,0:10:46.02,JPsub,NTP,0000,0000,0000,,The hospital room is over there.
Dialogue: 0,0:10:54.25,0:10:56.37,JPsub,NTP,0000,0000,0000,,Сәлем, қалайсың?
Dialogue: 0,0:11:00.18,0:11:05.05,JPsub,NTP,0000,0000,0000,,Иә, мен сізді сараң көрінді деп ойладым, бірақ теріңіз өте жылтыр және әдемі.
Dialogue: 0,0:11:07.40,0:11:12.11,JPsub,NTP,0000,0000,0000,,Әңгімені естігенде көз алдыма тал астындағы елес сияқты бірдеңе елестеді.
Dialogue: 0,0:11:12.40,0:11:14.27,JPsub,NTP,0000,0000,0000,,I wasn't too keen on it though.
Dialogue: 0,0:11:14.73,0:11:18.05,JPsub,NTP,0000,0000,0000,,Иә, мен бақыттымын, ол маған ұнайтын сүйкімді қыз.
Dialogue: 0,0:11:20.57,0:11:24.38,JPsub,NTP,0000,0000,0000,,Танысқаныма қуаныштымын, мен Тоуко Аозаки, логопед және мінез-құлық терапевтімін.
Dialogue: 0,0:11:26.78,0:11:30.29,JPsub,NTP,0000,0000,0000,,Мен сізге афазиядан арылуға көмектесу үшін келдім.
Dialogue: 0,0:11:30.77,0:11:31.62,JPsub,NTP,0000,0000,0000,,Танысқаныма қуаныштымын.
Dialogue: 0,0:11:34.27,0:11:36.28,JPsub,NTP,0000,0000,0000,,Афазия деген кім?
Dialogue: 0,0:11:36.75,0:11:38.81,JPsub,NTP,0000,0000,0000,,It's okay, I understand.
Dialogue: 0,0:11:39.47,0:11:43.10,JPsub,NTP,0000,0000,0000,,Бұл қате диагноз болуы мүмкін немесе сіз тым жалқау болуыңыз мүмкін.
Dialogue: 0,0:11:43.83,0:11:46.25,JPsub,NTP,0000,0000,0000,,But you're not good either.
Dialogue: 0,0:11:46.68,0:11:52.58,JPsub,NTP,0000,0000,0000,,Оқиға салдарынан миым зақымданды, сондықтан үндемей қалсам, адамдар мені афазия деп ойлайтын.
Dialogue: 0,0:11:53.32,0:11:56.30,JPsub,NTP,0000,0000,0000,,Олай болса мен мұнда не үшін келдім?
Dialogue: 0,0:11:56.46,0:11:58.23,JPsub,NTP,0000,0000,0000,,Мен бұл туралы неғұрлым көп айтсам, соғұрлым ол ұзарады.
Dialogue: 0,0:12:01.15,0:12:04.48,JPsub,NTP,0000,0000,0000,,Қауіп, Қауіп, бір минутта жұмысымнан айырылып қала жаздадым.
Dialogue: 0,0:12:06.36,0:12:07.16,JPsub,NTP,0000,0000,0000,,Сіз
Dialogue: 0,0:12:07.77,0:12:08.36,JPsub,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:12:09.11,0:12:10.80,JPsub,NTP,0000,0000,0000,,You're not a doctor, are you?
Dialogue: 0,0:12:11.89,0:12:15.00,JPsub,NTP,0000,0000,0000,,Yes, I'm a magician by trade.
Dialogue: 0,0:12:16.03,0:12:17.77,JPsub,NTP,0000,0000,0000,,There's no use for magicians
Dialogue: 0,0:12:19.04,0:12:23.80,JPsub,NTP,0000,0000,0000,,Бұл дұрыс. Жүрегіңдегі тесікті сиқыршы толтыра алмайды.
Dialogue: 0,0:12:24.23,0:12:26.79,JPsub,NTP,0000,0000,0000,,Only ordinary people can be buried.
Dialogue: 0,0:12:27.72,0:12:28.76,JPsub,NTP,0000,0000,0000,,Кеудедегі тесік
Dialogue: 0,0:12:30.03,0:12:32.12,JPsub,NTP,0000,0000,0000,,Yeah, I guess you realize that.
Dialogue: 0,0:12:32.32,0:12:35.47,JPsub,NTP,0000,0000,0000,,That you're already alone
Dialogue: 0,0:12:38.42,0:12:41.64,JPsub,NTP,0000,0000,0000,,Әлі ерте сияқты, сондықтан бүгінге дейін.
Dialogue: 0,0:12:42.36,0:12:44.10,JPsub,NTP,0000,0000,0000,,It's still tomorrow bye
Dialogue: 0,0:13:07.69,0:13:09.12,JPsub,NTP,0000,0000,0000,,Is the ceremony safe?
Dialogue: 0,0:13:10.55,0:13:12.45,JPsub,NTP,0000,0000,0000,,Иә, әзірге.
Dialogue: 0,0:13:12.79,0:13:14.84,JPsub,NTP,0000,0000,0000,,What do you mean for now?
Dialogue: 0,0:13:16.40,0:13:17.59,JPsub,NTP,0000,0000,0000,,Барлығы дүрбелеңде.
Dialogue: 0,0:13:19.00,0:13:20.12,JPsub,NTP,0000,0000,0000,,Let's have some tea upstairs.
Dialogue: 0,0:13:23.83,0:13:25.38,JPsub,NTP,0000,0000,0000,,Мына Тооко-сан
Dialogue: 0,0:13:42.25,0:13:43.38,JPsub,NTP,0000,0000,0000,,Сіз байқағаныңызға сенімдімін.
Dialogue: 0,0:13:44.01,0:13:47.08,JPsub,NTP,0000,0000,0000,,That you're already alone
Dialogue: 0,0:13:56.58,0:13:59.44,JPsub,NTP,0000,0000,0000,,Бұл өз өміріңді жоғалту немесе сол сияқты нәрселер туралы емес.
Dialogue: 0,0:14:04.43,0:14:06.25,JPsub,NTP,0000,0000,0000,,Біз әлі кездеспеуіміз керек.
Dialogue: 0,0:14:07.38,0:14:08.67,JPsub,NTP,0000,0000,0000,,Жарайды, солай емес пе?
Dialogue: 0,0:14:11.24,0:14:12.01,JPsub,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:15:09.21,0:15:10.47,JPsub,NTP,0000,0000,0000,,Мен кіремін.
Dialogue: 0,0:16:09.18,0:16:11.27,JPsub,NTP,0000,0000,0000,,It's very beautiful here
Dialogue: 0,0:16:12.95,0:16:19.17,JPsub,NTP,0000,0000,0000,,Біз бақытты болсақ та, адамдар жалғыз.
Dialogue: 0,0:16:25.03,0:16:28.04,JPsub,NTP,0000,0000,0000,,Please give this to Mr. Ryogi.
Dialogue: 0,0:16:28.37,0:16:29.34,JPsub,NTP,0000,0000,0000,,I apologize for the inconvenience.
Dialogue: 0,0:16:36.35,0:16:40.25,JPsub,NTP,0000,0000,0000,,Өзін кеңесші деп атаған әйел күнде келетін.
Dialogue: 0,0:16:41.66,0:16:46.19,JPsub,NTP,0000,0000,0000,,Байқау үшін ол онымен әңгімелесуге сүйенген сияқты болды.
Dialogue: 0,0:16:47.87,0:16:57.44,JPsub,NTP,0000,0000,0000,,Мен көремін. Ори-кунның физикалық бастамасы болмады, ол оны пайдаланбады.
Dialogue: 0,0:16:57.65,0:16:59.98,JPsub,NTP,0000,0000,0000,,Балалар сендер қызық болып бара жатырсыңдар.
Dialogue: 0,0:17:01.42,0:17:03.82,JPsub,NTP,0000,0000,0000,,Қос тұлғаның қызық ештеңесі жоқ.
Dialogue: 0,0:17:05.21,0:17:06.46,JPsub,NTP,0000,0000,0000,,Балалар?
Dialogue: 0,0:17:06.78,0:17:09.51,JPsub,NTP,0000,0000,0000,,Қос тұлға сүйкімді емес.
Dialogue: 0,0:17:10.17,0:17:16.53,JPsub,NTP,0000,0000,0000,,Бір уақытта бар, әрқайсысының ерік-жігері берік, бірақ өз әрекеттерінде біріктірілген
Dialogue: 0,0:17:18.05,0:17:21.18,JPsub,NTP,0000,0000,0000,,Мұндай күрделі де оғаш тұлғадан басқа мысал жоқ.
Dialogue: 0,0:17:23.57,0:17:25.68,JPsub,NTP,0000,0000,0000,,Оны «күрделі жеке тұлға» деп атаған жөн.
Dialogue: 0,0:17:26.20,0:17:28.67,JPsub,NTP,0000,0000,0000,,Күрделі жеке тұлға
Dialogue: 0,0:17:29.04,0:17:32.10,JPsub,NTP,0000,0000,0000,,Иә, бірақ менде әлі де күмән бар.
Dialogue: 0,0:17:32.67,0:17:37.35,JPsub,NTP,0000,0000,0000,,Күрделі жеке тұлға болса, Өрікүннің ұйықтап жатуының қажеті жоқ.
Dialogue: 0,0:17:38.93,0:17:43.41,JPsub,NTP,0000,0000,0000,,Ол үнемі ұйықтап жатқан сияқты, бірақ бұл аз.
Dialogue: 0,0:17:50.87,0:17:54.37,JPsub,NTP,0000,0000,0000,,Менің есімде жоқ жалғыз нәрсе - оның аты.
Dialogue: 0,0:17:57.66,0:17:59.14,JPsub,NTP,0000,0000,0000,,Ол бос
Dialogue: 0,0:17:59.70,0:18:03.15,JPsub,NTP,0000,0000,0000,,Кеудем тесілгендей бос.
Dialogue: 0,0:18:04.87,0:18:12.97,JPsub,NTP,0000,0000,0000,,Бірақ ол өзі туралы қаншалықты аз сезінсе де, ол екіұшты адам.
Dialogue: 0,0:18:20.29,0:18:23.32,JPsub,NTP,0000,0000,0000,,Сізде дәл қазір шындықты сезіну де жоқ.
Dialogue: 0,0:18:24.39,0:18:29.04,JPsub,NTP,0000,0000,0000,,Ол өзін формула ретінде танитын уақыт келеді.
Dialogue: 0,0:18:29.74,0:18:31.65,JPsub,NTP,0000,0000,0000,,Раушан гүлдер раушан болып туады
Dialogue: 0,0:18:32.88,0:18:38.00,JPsub,NTP,0000,0000,0000,,Оның өскен топырағы мен суы өзгергендіктен, ол басқа гүлге айналмайды.
Dialogue: 0,0:18:39.66,0:18:40.66,JPsub,NTP,0000,0000,0000,,Тооко-сан
Dialogue: 0,0:18:42.46,0:18:46.35,JPsub,NTP,0000,0000,0000,,Ақырында бос тесікті бір нәрсемен толтырудан басқа амалымыз жоқ.
Dialogue: 0,0:18:47.61,0:18:52.86,JPsub,NTP,0000,0000,0000,,Жаңа өзін қалыптастыру үшін естеліктерді емес, қазіргіні жинақтаудан басқа амалымыз жоқ.
Dialogue: 0,0:18:53.50,0:18:57.36,JPsub,NTP,0000,0000,0000,,Бұл ғибадатхана ғимараты, оған ешкім көмектесе алмайды.
Dialogue: 0,0:18:58.67,0:19:03.40,JPsub,NTP,0000,0000,0000,,Сондықтан сізге тек оған бұрынғыдай қарау керек.
Dialogue: 0,0:19:06.46,0:19:13.47,JPsub,NTP,0000,0000,0000,,Иә, енді ол кеткен соң, жадыңыздағы олқылықты қалпына келтіру мүмкін емес.
Dialogue: 0,0:19:14.59,0:19:19.39,JPsub,NTP,0000,0000,0000,,Екі жыл бұрын жын өлтіру мен екі рәсімнің арасында қандай байланыс болды?
Dialogue: 0,0:19:19.89,0:19:22.93,JPsub,NTP,0000,0000,0000,,Енді мен шынымен қараңғылыққа сіңіп кеттім.
Dialogue: 0,0:19:25.68,0:19:29.39,JPsub,NTP,0000,0000,0000,,Бірақ Орикунның жоғалып кетуіне ешқандай себеп жоқ еді.
Dialogue: 0,0:19:29.82,0:19:30.39,JPsub,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:19:31.17,0:19:36.27,JPsub,NTP,0000,0000,0000,,Өйткені үндемей қалсаң, сен, Шикісан, жоқ болып кетер едің.
Dialogue: 0,0:19:36.78,0:19:40.74,JPsub,NTP,0000,0000,0000,,Неліктен ол жоғалып кеткісі келді?
Dialogue: 0,0:19:41.59,0:19:42.61,JPsub,NTP,0000,0000,0000,,Көргенім, нато мен үшін емес екен
Dialogue: 0,0:19:43.20,0:19:44.63,JPsub,NTP,0000,0000,0000,,Оның орнына қайшы
Dialogue: 0,0:19:45.72,0:19:47.22,JPsub,NTP,0000,0000,0000,,Өйткені, бұл жақсы емес.
Dialogue: 0,0:19:47.63,0:19:51.01,JPsub,NTP,0000,0000,0000,,Сізде соттылық бар болғандықтан, пышақ қолдануға қатаң тыйым салынады.
Dialogue: 0,0:19:53.52,0:19:56.31,JPsub,NTP,0000,0000,0000,,Айтпақшы, қайшы не үшін керек?
Dialogue: 0,0:19:57.62,0:19:59.76,JPsub,NTP,0000,0000,0000,,Өйткені мен шашымды алғым келді
Dialogue: 0,0:20:00.26,0:20:03.18,JPsub,NTP,0000,0000,0000,,Ондай жағдайда шаштараз шақыруым керек пе?
Dialogue: 0,0:20:03.51,0:20:07.34,JPsub,NTP,0000,0000,0000,,Бұл сіздің сауығып кетуіңіздің мерекесі, сондықтан мен жақсы өнері бар біреуді әкелемін.
Dialogue: 0,0:20:07.61,0:20:08.24,JPsub,NTP,0000,0000,0000,,(Ер адам) Аа… тоқта… Уа! (Әйелдің айқайы)
Dialogue: 0,0:20:08.88,0:20:12.52,JPsub,NTP,0000,0000,0000,,Менің шашыма басқа біреудің қолдары тиіп тұрғанын елестеткім де келмейді.
Dialogue: 0,0:20:14.08,0:20:15.83,JPsub,NTP,0000,0000,0000,,Сіз өте әдемісіз
Dialogue: 0,0:20:19.81,0:20:21.62,JPsub,NTP,0000,0000,0000,,Сонда мен осылай істеймін
Dialogue: 0,0:20:26.73,0:20:31.95,JPsub,NTP,0000,0000,0000,,Мен ертең басқа адаммен келуім мүмкін, сондықтан маған қамқорлық жасаңыз.
Dialogue: 0,0:21:39.36,0:21:42.92,JPsub,NTP,0000,0000,0000,,Сіздің төзімділігіңіз шынымен таң қалдырады және таң қалдырады.
Dialogue: 0,0:21:43.97,0:21:47.18,JPsub,NTP,0000,0000,0000,,Жарайды, ертең ауруханадан шығуға болады.
Dialogue: 0,0:21:47.65,0:21:49.34,JPsub,NTP,0000,0000,0000,,Құттықтаймыз Рёги мырза
Dialogue: 0,0:21:51.58,0:21:57.39,JPsub,NTP,0000,0000,0000,,Сондай-ақ көздегі таңғыш ертең таңертең алынады, сондықтан бүгін күн.
Dialogue: 0,0:21:53.25,0:21:54.22,JPsub,NTP,0000,0000,0000,,жақында жолымыз қиылысар.
Dialogue: 0,0:21:57.68,0:21:58.51,JPsub,NTP,0000,0000,0000,,жақында жолымыз қиылысар.
Dialogue: 0,0:21:59.73,0:22:00.46,JPsub,NTP,0000,0000,0000,,жақында жолымыз қиылысар.
Dialogue: 0,0:22:05.06,0:22:06.08,JPsub,NTP,0000,0000,0000,,жақында жолымыз қиылысар.
Dialogue: 0,0:22:07.97,0:22:08.86,JPsub,NTP,0000,0000,0000,,жақында жолымыз қиылысар.
Dialogue: 0,0:22:09.38,0:22:11.67,JPsub,NTP,0000,0000,0000,,Мен мұндай әлемді енді ешқашан көргім келмейді
Dialogue: 0,0:22:22.35,0:22:25.95,JPsub,NTP,0000,0000,0000,,Сол қараңғылыққа түссең кешір.
Dialogue: 0,0:22:26.93,0:22:30.28,JPsub,NTP,0000,0000,0000,,Күте тұрыңыз, сіз тым батылсыз.
Dialogue: 0,0:22:34.77,0:22:36.07,JPsub,NTP,0000,0000,0000,,Не көрдің?
Dialogue: 0,0:22:42.73,0:22:44.32,JPsub,NTP,0000,0000,0000,,Тікелей өлімнің жаман көзі?
Dialogue: 0,0:22:44.60,0:22:48.20,JPsub,NTP,0000,0000,0000,,Оны жоғалтып алу ысырап болар еді.
Dialogue: 0,0:22:48.82,0:22:53.97,JPsub,NTP,0000,0000,0000,,Ең алдымен, сіз оны жаншып алсаңыз да көре аласыз.
Dialogue: 0,0:22:56.13,0:22:57.84,JPsub,NTP,0000,0000,0000,,Сіз адамсыз ба?
Dialogue: 0,0:23:00.67,0:23:02.14,JPsub,NTP,0000,0000,0000,,Мен сиқыршымын
Dialogue: 0,0:23:02.51,0:23:03.31,JPsub,NTP,0000,0000,0000,,Апельсин?
Dialogue: 0,0:23:03.71,0:23:10.43,JPsub,NTP,0000,0000,0000,,Мен бұл көздерді қалай пайдалану керектігін көрсетемін деп ойладым.
Dialogue: 0,0:23:12.89,0:23:15.12,JPsub,NTP,0000,0000,0000,,Әр нәрсенің кемшілігі бар.
Dialogue: 0,0:23:15.63,0:23:21.39,JPsub,NTP,0000,0000,0000,,Бірде-бір зат мінсіз болмағандықтан, әрбір адам жойылып, нөлден қайта құрылғысы келеді.
Dialogue: 0,0:23:23.44,0:23:28.26,JPsub,NTP,0000,0000,0000,,Екі жыл бұрын болған апатқа байланысты мен қазір сенің көздеріңдегі жарықтарды көріп тұрмын.
Dialogue: 0,0:23:29.20,0:23:31.68,JPsub,NTP,0000,0000,0000,,Біз көре алмайтын сызықтарды көреміз.
Dialogue: 0,0:23:32.17,0:23:37.12,JPsub,NTP,0000,0000,0000,,Ал егер сіз ұзақ уақыт өлімге ұшырасаңыз, сіздің миыңыз оның не екенін түсінеді.
Dialogue: 0,0:23:37.32,0:23:40.13,JPsub,NTP,0000,0000,0000,,Нәтижесінде өлім көрінеді.
Dialogue: 0,0:23:42.22,0:23:45.37,JPsub,NTP,0000,0000,0000,,Бұл ғана емес, оған қол тигізу керек.
Dialogue: 0,0:23:53.52,0:23:57.14,JPsub,NTP,0000,0000,0000,,Дұрыс, оянып, екі рәсімді де орында.
Dialogue: 0,0:23:57.68,0:24:00.50,JPsub,NTP,0000,0000,0000,,Сен менің тарапымнансың.
Dialogue: 0,0:24:01.17,0:24:05.50,JPsub,NTP,0000,0000,0000,,Өзгелер сияқты өмір сүруді армандама
Dialogue: 0,0:24:08.13,0:24:11.13,JPsub,NTP,0000,0000,0000,,Менің өмір сүруге ерік-жігерім жоқ
Dialogue: 0,0:24:12.95,0:24:14.66,JPsub,NTP,0000,0000,0000,,Менің жүрегім бос болғандықтан ба?
Dialogue: 0,0:24:15.39,0:24:19.79,JPsub,NTP,0000,0000,0000,,Тоқымды жоғалтып, басқа адам болып қайта туылғаннан кейінгі ыңғайсыздықты түсінемін.
Dialogue: 0,0:24:20.30,0:24:23.47,JPsub,NTP,0000,0000,0000,,Бірақ мұның бәрі бар.
Dialogue: 0,0:24:24.25,0:24:25.52,JPsub,NTP,0000,0000,0000,,Бірақ сіз
Dialogue: 0,0:24:26.59,0:24:30.56,JPsub,NTP,0000,0000,0000,,Өмір сүруге ерік-жігері болмаса да, өлгім келмейді дейді.
Dialogue: 0,0:24:31.63,0:24:35.82,JPsub,NTP,0000,0000,0000,,Өмір сүруге себеп болмаса да, мен өлуден қорқамын.
Dialogue: 0,0:24:36.55,0:24:40.93,JPsub,NTP,0000,0000,0000,,Өмір мен өлімді таңдай алмай, шекарада жіппен жүру
Dialogue: 0,0:24:42.83,0:24:44.82,JPsub,NTP,0000,0000,0000,,Менің жүрегім Гарандо сияқты болады
Dialogue: 0,0:24:46.39,0:24:48.13,JPsub,NTP,0000,0000,0000,,Өзіңіз білетіндей сөйлеңіз
Dialogue: 0,0:24:52.72,0:24:53.71,JPsub,NTP,0000,0000,0000,,Сіз оны көрдіңіз бе?
Dialogue: 0,0:24:54.23,0:24:56.93,JPsub,NTP,0000,0000,0000,,Ашу бар болғандықтан, мен сол байланыс деңгейімен қозғалдым.
Dialogue: 0,0:24:57.94,0:25:03.39,JPsub,NTP,0000,0000,0000,,Осы аурухананың төңірегінде қалықтап жүрген ойларға сендердің денелерің – ерекше ыдыс.
Dialogue: 0,0:25:03.98,0:25:07.39,JPsub,NTP,0000,0000,0000,,Оянбасаң, сені өлтіреді.
Dialogue: 0,0:25:08.24,0:25:14.10,JPsub,NTP,0000,0000,0000,,Маған бәрібір. Егер бұл менің ішімдегі нәрсені білдірсе, бұл жақсы.
Dialogue: 0,0:25:16.23,0:25:17.49,JPsub,NTP,0000,0000,0000,,Қандай ұят.
Dialogue: 0,0:25:19.75,0:25:22.08,JPsub,NTP,0000,0000,0000,,Рунды қорғау да мағынасыз.
Dialogue: 0,0:25:22.84,0:25:24.02,JPsub,NTP,0000,0000,0000,,Қалғанын қалауыңызша орындаңыз
Dialogue: 0,0:25:28.38,0:25:33.20,JPsub,NTP,0000,0000,0000,,Бірақ Орикун шынымен бекер өлді ме?
Dialogue: 0,0:25:46.18,0:25:50.00,JPsub,NTP,0000,0000,0000,,Орикун шынымен бекер өлді ме?
Dialogue: 0,0:26:11.92,0:26:14.33,JPsub,NTP,0000,0000,0000,,Мен кіремін.
Dialogue: 0,0:26:36.23,0:26:38.94,JPsub,NTP,0000,0000,0000,,Бос тесікті бір нәрсемен толтыру керек.
Dialogue: 0,0:26:39.81,0:26:45.82,JPsub,NTP,0000,0000,0000,,Жаңа өзін қалыптастыру үшін естеліктерді емес, қазіргіні жинақтаудан басқа амалымыз жоқ.
Dialogue: 0,0:26:47.84,0:26:51.59,JPsub,NTP,0000,0000,0000,,Бұл ешкім көмектесе алмайтын ғибадатхана ғимараты.
Dialogue: 0,0:26:53.33,0:26:58.76,JPsub,NTP,0000,0000,0000,,Сондықтан сізге тек оған бұрынғыдай қарау керек.
Dialogue: 0,0:28:02.13,0:28:06.38,JPsub,NTP,0000,0000,0000,,Орикун шынымен бекер өлді ме?
Dialogue: 0,0:28:12.99,0:28:14.12,JPsub,NTP,0000,0000,0000,,Солай болуы керек.
Dialogue: 0,0:28:15.47,0:28:19.26,JPsub,NTP,0000,0000,0000,,Өйткені өлім соншалықты жалғыз және түкке тұрғысыз.
Dialogue: 0,0:28:20.37,0:28:23.54,JPsub,NTP,0000,0000,0000,,Өлім соншалықты қара және қорқынышты
Dialogue: 0,0:28:24.52,0:28:27.78,JPsub,NTP,0000,0000,0000,,Өлім бәрінен де қорқынышты болды.
Dialogue: 0,0:28:29.80,0:28:30.71,JPsub,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:28:31.42,0:28:34.26,JPsub,NTP,0000,0000,0000,,Мен ол жерге құлағым келмейді.
Dialogue: 0,0:28:59.40,0:29:00.09,JPsub,NTP,0000,0000,0000,,Жоғалмаңыз
Dialogue: 0,0:29:28.42,0:29:31.54,JPsub,NTP,0000,0000,0000,,Қарапайым нәрсе
Dialogue: 0,0:29:31.77,0:29:34.08,JPsub,NTP,0000,0000,0000,,Сіз таңданған мысықсыз ба?
Dialogue: 0,0:29:35.24,0:29:36.07,JPsub,NTP,0000,0000,0000,,Апельсин?
Dialogue: 0,0:29:37.33,0:29:40.20,JPsub,NTP,0000,0000,0000,,Аурухана бөлмесіне аруақтардың кіруіне жол бермеу үшін тосқауыл қойылды.
Dialogue: 0,0:29:40.81,0:29:43.21,JPsub,NTP,0000,0000,0000,,Денені сындыру үшін?
Dialogue: 0,0:29:50.15,0:29:53.22,JPsub,NTP,0000,0000,0000,,Әдетте оларда мұндай даналық жоқ.
Dialogue: 0,0:29:53.72,0:29:55.34,JPsub,NTP,0000,0000,0000,,Бұл менің қателігім.
Dialogue: 0,0:29:55.67,0:29:57.64,JPsub,NTP,0000,0000,0000,,Олай болса, бірдеңе істеу керек.
Dialogue: 0,0:29:58.99,0:29:59.64,JPsub,NTP,0000,0000,0000,,Растау
Dialogue: 0,0:30:01.93,0:30:03.84,JPsub,NTP,0000,0000,0000,,Феху Урурз Турисарз
Dialogue: 0,0:30:14.69,0:30:17.88,JPsub,NTP,0000,0000,0000,,Мендегі F(Ansuz) тым әлсіз болды ма?
Dialogue: 0,0:30:23.17,0:30:24.68,JPsub,NTP,0000,0000,0000,,Эй, алаяқ
Dialogue: 0,0:30:25.02,0:30:26.71,JPsub,NTP,0000,0000,0000,,Мұндай нәрсе қиын.
Dialogue: 0,0:30:27.85,0:30:30.45,JPsub,NTP,0000,0000,0000,,Тірі болсаң, жүрегіңді өртеп жібер, сонда бітерсің.
Dialogue: 0,0:30:30.93,0:30:32.28,JPsub,NTP,0000,0000,0000,,Өлгендерде олай емес.
Dialogue: 0,0:30:33.45,0:30:37.69,JPsub,NTP,0000,0000,0000,,Өлген соң, қолыңнан айырылдың ба, бастың басы маңызды емес.
Dialogue: 0,0:30:38.21,0:30:41.14,JPsub,NTP,0000,0000,0000,,Егер сіз бұл нәрсені тоқтатқыңыз келсе, крематорийдің от күшін пайдаланыңыз.
Dialogue: 0,0:30:41.38,0:30:43.53,JPsub,NTP,0000,0000,0000,,Әдепті монахтың да оны әкелуден басқа амалы жоқ.
Dialogue: 0,0:30:43.59,0:30:44.90,JPsub,NTP,0000,0000,0000,,Дәптер жақсы.
Dialogue: 0,0:30:45.12,0:30:46.95,JPsub,NTP,0000,0000,0000,,Мәселе мынада, сіз мұны істей алмайсыз.
Dialogue: 0,0:30:47.69,0:30:48.93,JPsub,NTP,0000,0000,0000,,Тіпті сенің де қолыңнан келмейді.
Dialogue: 0,0:30:49.61,0:30:51.93,JPsub,NTP,0000,0000,0000,,Өлгендерді өлтіруге болмайды, өйткені олар әлдеқашан өлген.
Dialogue: 0,0:30:52.59,0:30:53.98,JPsub,NTP,0000,0000,0000,,Бұл жерден қашайық.
Dialogue: 0,0:30:54.49,0:30:58.84,JPsub,NTP,0000,0000,0000,,Өлді ме, жоқ па, бәрібір «тірі» өлік.
Dialogue: 0,0:30:59.13,0:30:59.81,JPsub,NTP,0000,0000,0000,,Егер
Dialogue: 0,0:31:09.13,0:31:11.82,JPsub,NTP,0000,0000,0000,,Мен сені не болса да өлтіремін.
Dialogue: 0,0:31:52.02,0:31:52.85,JPsub,NTP,0000,0000,0000,,Формула
Dialogue: 0,0:32:02.55,0:32:03.38,JPsub,NTP,0000,0000,0000,,Олар – аң, ал біз – аңшылар!
Dialogue: 0,0:32:22.31,0:32:23.75,JPsub,NTP,0000,0000,0000,,Өлім массасы
Dialogue: 0,0:32:25.67,0:32:27.71,JPsub,NTP,0000,0000,0000,,Менің алдымда тұрма
Dialogue: 0,0:33:01.34,0:33:03.81,JPsub,NTP,0000,0000,0000,,Егер сіз толтыруда қателессеңіз
Dialogue: 0,0:33:19.54,0:33:20.87,JPsub,NTP,0000,0000,0000,,Енді қашып кетуге жол бермеймін
Dialogue: 0,0:33:22.42,0:33:24.56,JPsub,NTP,0000,0000,0000,,Мен әлсіздерді өлтіремін
Dialogue: 0,0:33:25.68,0:33:28.96,JPsub,NTP,0000,0000,0000,,Екеуіңді де салмаймын.
Dialogue: 0,0:34:04.11,0:34:05.01,JPsub,NTP,0000,0000,0000,,Сіз мұны жасадыңыз ба?
Dialogue: 0,0:34:11.46,0:34:13.18,JPsub,NTP,0000,0000,0000,,Сіз айттыңыз.
Dialogue: 0,0:34:14.16,0:34:17.40,JPsub,NTP,0000,0000,0000,,Ол маған осы көздерді қалай пайдалану керектігін үйретемін деді.
Dialogue: 0,0:34:18.26,0:34:20.39,JPsub,NTP,0000,0000,0000,,Иә, шартпен.
Dialogue: 0,0:34:21.63,0:34:24.40,JPsub,NTP,0000,0000,0000,,Тікелей өлімді қалай қолдану керектігін үйретемін
Dialogue: 0,0:34:25.19,0:34:28.25,JPsub,NTP,0000,0000,0000,,Менің жұмысыма көмектесіңіз
Dialogue: 0,0:34:28.60,0:34:30.41,JPsub,NTP,0000,0000,0000,,Мен танысымды жоғалтып алдым.
Dialogue: 0,0:34:31.22,0:34:33.55,JPsub,NTP,0000,0000,0000,,Дәл осы жерде мен дұрыс аяқ-қолды қалаймын.
Dialogue: 0,0:34:34.70,0:34:35.44,JPsub,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:34:35.57,0:34:37.26,JPsub,NTP,0000,0000,0000,,Ол адамдарды өлтіруі мүмкін.
Dialogue: 0,0:34:38.36,0:34:39.98,JPsub,NTP,0000,0000,0000,,О, әрине.
Dialogue: 0,0:34:40.54,0:34:41.65,JPsub,NTP,0000,0000,0000,,Мен мұны істеймін
Dialogue: 0,0:34:41.86,0:34:42.83,JPsub,NTP,0000,0000,0000,,Оны қалауыңызша пайдаланыңыз
Dialogue: 0,0:34:44.04,0:34:44.83,JPsub,NTP,0000,0000,0000,,Қалай болғанда да
Dialogue: 0,0:34:45.30,0:34:47.51,JPsub,NTP,0000,0000,0000,,Одан басқа мақсат жоқ.
Dialogue: 0,0:34:58.63,0:35:00.46,JPsub,NTP,0000,0000,0000,,Мақсат жоқ па?
Dialogue: 0,0:35:00.59,0:35:01.85,JPsub,NTP,0000,0000,0000,,Бұл да қайғылы.
Dialogue: 0,0:35:02.90,0:35:04.73,JPsub,NTP,0000,0000,0000,,Сіз әлі қателесесіз.
Dialogue: 0,0:35:09.04,0:35:14.12,JPsub,NTP,0000,0000,0000,,Оның Garan-do болуы сіз қалағаныңызша кіре алатыныңызды білдіреді.
Dialogue: 0,0:35:18.97,0:35:20.43,JPsub,NTP,0000,0000,0000,,Сен бақыттысың
Dialogue: 0,0:35:20.87,0:35:24.27,JPsub,NTP,0000,0000,0000,,Бұдан асқан болашақ қайда?
Dialogue: 0,0:35:28.38,0:35:33.84,JPsub,NTP,0000,0000,0000,,Ол не үшін жоғалып кетті және нені қорғады?
Dialogue: 0,0:35:35.12,0:35:36.88,JPsub,NTP,0000,0000,0000,,Жоғалған Ори
Dialogue: 0,0:35:37.75,0:35:41.19,JPsub,NTP,0000,0000,0000,,Өз арманын қорғау үшін шығар
Dialogue: 0,0:35:42.48,0:35:44.99,JPsub,NTP,0000,0000,0000,,Бақытты өмір сүруді армандаған
Dialogue: 0,0:35:46.13,0:35:50.21,JPsub,NTP,0000,0000,0000,,Мені сондай терең жалғыздықпен қалдырып
Dialogue: 0,0:35:58.24,0:36:00.48,JPsub,NTP,0000,0000,0000,,Себебі сен маған ұнайсың
Dialogue: 0,0:36:00.66,0:36:03.51,JPsub,NTP,0000,0000,0000,,Жақында тағы кездесеміз, Курогири.
Dialogue: 0,0:36:09.67,0:36:11.28,JPsub,NTP,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:36:21.68,0:36:23.79,JPsub,NTP,0000,0000,0000,,Мені түсін
Dialogue: 0,0:36:26.32,0:36:28.61,JPsub,NTP,0000,0000,0000,,А, мен білдім.
Dialogue: 0,0:36:29.87,0:36:32.99,JPsub,NTP,0000,0000,0000,,Тек сен мені күттің
Dialogue: 0,0:36:34.08,0:36:38.63,JPsub,NTP,0000,0000,0000,,Осы уақыт бойы мені қорғаған жалғыз сен болғаның
Dialogue: 0,0:36:43.59,0:36:45.02,JPsub,NTP,0000,0000,0000,,Микия Курогири
Dialogue: 0,0:36:47.99,0:36:49.97,JPsub,NTP,0000,0000,0000,,Француз ақынына ұқсайды
Dialogue: 0,0:36:54.51,0:36:55.91,JPsub,NTP,0000,0000,0000,,Күннің ашық болғанына қуаныштымын
Dialogue: 0,0:36:59.55,0:37:01.53,JPsub,NTP,0000,0000,0000,,Ауруханадан шығуға өте ыңғайлы
Dialogue: 0,0:37:06.57,0:37:10.57,JPsub,NTP,0000,0000,0000,,Әй, ешқашан кетпейтін нәрселер бар ма?
Dialogue: 0,0:42:28.20,0:42:30.45,JPsub,NTP,0000,0000,0000,,Сіз Кири Мияджосыз ба?
Dialogue: 0,0:42:32.27,0:42:35.64,JPsub,NTP,0000,0000,0000,,Сен менің әкемнің досысың ба?
Dialogue: 0,0:42:37.13,0:42:39.75,JPsub,NTP,0000,0000,0000,,Мен сенің тілегіңді орындау үшін келдім.
Dialogue: 0,0:42:43.95,0:42:46.60,JPsub,NTP,0000,0000,0000,,Еркін болу үшін басқа дене
Dialogue: 0,0:42:46.99,0:42:48.45,JPsub,NTP,0000,0000,0000,,Қаламайсың ба?
Dialogue: 0,0:42:51.92,0:42:54.45,JPsub,NTP,0000,0000,0000,,Сіз кімсіз?
Dialogue: 0,0:42:58.74,0:43:02.61,JPsub,NTP,0000,0000,0000,,Мен не істеуім керек? Мен бұлай үйге бара алмаймын.
Dialogue: 0,0:43:03.29,0:43:05.64,JPsub,NTP,0000,0000,0000,,Мен не істеуім керек?
Dialogue: 0,0:43:14.41,0:43:16.55,JPsub,NTP,0000,0000,0000,,Сіз Фуджино Асагамисыз ба?
Dialogue: 0,0:43:18.31,0:43:19.89,JPsub,NTP,0000,0000,0000,,Сіз емделгіңіз келе ме?
Dialogue: 0,0:43:22.95,0:43:24.21,JPsub,NTP,0000,0000,0000,,Келісілді
Dialogue: 0,0:43:25.08,0:43:28.06,JPsub,NTP,0000,0000,0000,,Денеңіздің ауытқуларын емдейміз
Dialogue: 0,0:43:34.17,0:43:36.47,JPsub,NTP,0000,0000,0000,,Сіз кімсіз?
Dialogue: 0,0:43:42.03,0:43:44.55,JPsub,NTP,0000,0000,0000,,Сіз кімсіз?
Dialogue: 0,0:43:48.38,0:43:49.70,JPsub,NTP,0000,0000,0000,,Сиқыршы
Dialogue: 0,0:43:50.90,0:43:52.48,JPsub,NTP,0000,0000,0000,,Сорен Арая
Dialogue: 0,0:44:05.57,0:44:08.58,JPsub,NTP,0000,0000,0000,,Мен сенің бұл күйіңе шыдай алмаймын.
Dialogue: 0,0:44:11.48,0:44:13.73,JPsub,NTP,0000,0000,0000,,Мен біреуді өлтірдім.
Dialogue: 0,0:44:14.73,0:44:15.69,JPsub,NTP,0000,0000,0000,,Паррицид
Dialogue: 0,0:44:16.84,0:44:17.65,JPsub,NTP,0000,0000,0000,,Қара пауловния
Dialogue: 0,0:44:17.96,0:44:20.19,JPsub,NTP,0000,0000,0000,,Сіз Чимихама Огава пәтерін білесіз бе?
Dialogue: 0,0:44:20.32,0:44:25.40,JPsub,NTP,0000,0000,0000,,Огава сарайы бір-біріне жақын орналасқан жарты ай тәрізді он қабатты тұрғын үй.
Dialogue: 0,0:44:26.16,0:44:27.19,JPsub,NTP,0000,0000,0000,,Ол өзгерді.
Dialogue: 0,0:44:28.71,0:44:31.37,JPsub,NTP,0000,0000,0000,,Сіз тіпті қайтыс болған отбасы мүшелеріне де барасыз ба?
Dialogue: 0,0:44:31.93,0:44:33.41,JPsub,NTP,0000,0000,0000,,Мен оны өлтірдім.
Dialogue: 0,0:44:33.80,0:44:35.95,JPsub,NTP,0000,0000,0000,,Тірі бар – қателескен.
Dialogue: 0,0:44:36.66,0:44:38.31,JPsub,NTP,0000,0000,0000,,Неге барып тексермейсіз?
Dialogue: 0,0:44:38.56,0:44:40.14,JPsub,NTP,0000,0000,0000,,Мына қараңғылықты қарашы
Dialogue: 0,0:44:40.87,0:44:44.15,JPsub,NTP,0000,0000,0000,,Ал өз атыңызды есте сақтаңыз
Dialogue: 0,0:44:44.26,0:44:45.46,JPsub,NTP,0000,0000,0000,,Өрнекті не істедің?
Dialogue: 0,0:44:45.61,0:44:47.13,JPsub,NTP,0000,0000,0000,,Тайджи
Dialogue: 0,0:44:47.39,0:44:49.98,JPsub,NTP,0000,0000,0000,,Тайджиді біріктіру үшін, Тайджи...
Dialogue: 0,0:44:50.07,0:44:51.42,JPsub,NTP,0000,0000,0000,,Тайджиді қосу
Dialogue: 0,0:44:51.55,0:44:52.12,JPsub,NTP,0000,0000,0000,,Тайджи
Dialogue: 0,0:44:52.35,0:44:53.20,JPsub,NTP,0000,0000,0000,,Қазір
Dialogue: 0,0:44:53.46,0:44:55.93,JPsub,NTP,0000,0000,0000,,Аосаки
Dialogue: 0,0:45:06.79,0:45:08.01,JPsub,NTP,0000,0000,0000,,Бұл спираль
Dialogue: 0,0:45:08.29,0:45:10.16,JPsub,NTP,0000,0000,0000,,Қарама-қайшылық болғанын қалаймын.
Dialogue: 0,0:00:49.77,0:00:50.53,CNsub,NTP,0000,0000,0000,,Мен көлікті аштым.
Dialogue: 0,0:01:00.94,0:01:01.61,CNsub,NTP,0000,0000,0000,,Жағдайлар қандай?
Dialogue: 0,0:01:01.98,0:01:03.59,CNsub,NTP,0000,0000,0000,,Ниет көлденең JCSIII-3
Dialogue: 0,0:01:03.89,0:01:05.92,CNsub,NTP,0000,0000,0000,,Қанға тию 60
Dialogue: 0,0:01:06.16,0:01:07.36,CNsub,NTP,0000,0000,0000,,Дайындау сұйықтығы құбыры
Dialogue: 0,0:01:07.69,0:01:08.63,CNsub,NTP,0000,0000,0000,,Электронды монитор дайындалды
Dialogue: 0,0:01:08.82,0:01:09.25,CNsub,NTP,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:01:09.37,0:01:11.64,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:01:12.24,0:01:15.04,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:01:20.86,0:01:22.28,CNsub,NTP,0000,0000,0000,,1 2 3
Dialogue: 0,0:01:26.03,0:01:26.92,CNsub,NTP,0000,0000,0000,,Сұйықтық құбырына жету
Dialogue: 0,0:01:27.30,0:01:28.06,CNsub,NTP,0000,0000,0000,,Өмір қандай?
Dialogue: 0,0:01:28.32,0:01:30.70,CNsub,NTP,0000,0000,0000,,Қан қысымы төмен.
Dialogue: 0,0:01:30.89,0:01:31.58,CNsub,NTP,0000,0000,0000,,Прогрессивті кросс-сәйкестік сынағы
Dialogue: 0,0:01:31.94,0:01:32.59,CNsub,NTP,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:01:35.11,0:01:36.12,CNsub,NTP,0000,0000,0000,,Шығу келісімі
Dialogue: 0,0:01:36.24,0:01:37.29,CNsub,NTP,0000,0000,0000,,Жалғастыруға дейінгі процедура
Dialogue: 0,0:01:37.65,0:01:39.33,CNsub,NTP,0000,0000,0000,,Мен қазір кесуді қажет ететін киімдерді киіп жүрмін.
Dialogue: 0,0:01:41.47,0:01:42.69,CNsub,NTP,0000,0000,0000,,Қан көп шықты
Dialogue: 0,0:01:42.87,0:01:44.19,CNsub,NTP,0000,0000,0000,,Кіші көмекші студент
Dialogue: 0,0:01:44.35,0:01:44.74,CNsub,NTP,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:04:03.14,0:04:05.82,CNsub,NTP,0000,0000,0000,,Жоғалған... жойылу
Dialogue: 0,0:04:15.47,0:04:16.02,CNsub,NTP,0000,0000,0000,,Қазірге дейін
Dialogue: 0,0:04:16.40,0:04:17.95,CNsub,NTP,0000,0000,0000,,Аяққа жақындау
Dialogue: 0,0:05:14.35,0:05:16.52,CNsub,NTP,0000,0000,0000,,Бұл... өлім бе?
Dialogue: 0,0:05:33.92,0:05:35.72,CNsub,NTP,0000,0000,0000,,Кения-кун
Dialogue: 0,0:05:36.35,0:05:38.47,CNsub,NTP,0000,0000,0000,,Бұл Токоро Козаки.
Dialogue: 0,0:05:40.44,0:05:41.65,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:05:42.01,0:05:46.04,CNsub,NTP,0000,0000,0000,,Жеке адамдар...Жапондық телефон қоңыраулары әртүрлі сезімдерге ие...
Dialogue: 0,0:05:47.87,0:05:48.71,CNsub,NTP,0000,0000,0000,,Бұл баратын жер
Dialogue: 0,0:05:49.53,0:05:51.70,CNsub,NTP,0000,0000,0000,,Бұл...
Dialogue: 0,0:05:52.31,0:05:57.30,CNsub,NTP,0000,0000,0000,,Менде әртүрлі талаптар бар.
Dialogue: 0,0:05:57.95,0:06:02.07,CNsub,NTP,0000,0000,0000,,Шағын бақылау Сипаттама
Dialogue: 0,0:06:03.11,0:06:09.58,CNsub,NTP,0000,0000,0000,,Бұл есеп өзіне-өзі қызмет көрсетуге арналған.
Dialogue: 0,0:06:11.23,0:06:13.46,CNsub,NTP,0000,0000,0000,,Өзіңіз туралы ойлау
Dialogue: 0,0:07:43.29,0:07:44.37,CNsub,NTP,0000,0000,0000,,Қара…
Dialogue: 0,0:08:23.47,0:08:24.38,CNsub,NTP,0000,0000,0000,,Мұнда емес
Dialogue: 0,0:08:25.58,0:08:27.43,CNsub,NTP,0000,0000,0000,,Медициналық студенттің тәжірибесі
Dialogue: 0,0:08:27.83,0:08:30.15,CNsub,NTP,0000,0000,0000,,Екі кішкентай апа…екі кішкентай апа…
Dialogue: 0,0:08:33.18,0:08:35.15,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:08:36.12,0:08:38.11,CNsub,NTP,0000,0000,0000,,Бұл ауырады ма?
Dialogue: 0,0:08:39.20,0:08:41.34,CNsub,NTP,0000,0000,0000,,Ең жиі кездесетін жағдайларды қарастырайық.
Dialogue: 0,0:08:41.81,0:08:45.23,CNsub,NTP,0000,0000,0000,,Бұл қарапайым және ғажайып.
Dialogue: 0,0:08:45.64,0:08:46.72,CNsub,NTP,0000,0000,0000,,Қандай шындық?
Dialogue: 0,0:08:46.94,0:08:48.64,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:08:51.24,0:08:54.36,CNsub,NTP,0000,0000,0000,,Мәліметтерді қарап шыққаннан кейін нәтижелер белгіленеді.
Dialogue: 0,0:08:55.03,0:08:57.15,CNsub,NTP,0000,0000,0000,,Бұрын қосылған отбасы мүшесі
Dialogue: 0,0:09:18.06,0:09:18.78,CNsub,NTP,0000,0000,0000,,Куротоу мырза
Dialogue: 0,0:09:22.50,0:09:25.10,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:09:27.42,0:09:27.92,CNsub,NTP,0000,0000,0000,,Тадаши…
Dialogue: 0,0:09:28.29,0:09:35.16,CNsub,NTP,0000,0000,0000,,Оянғаннан бері адамның өзі де, отбасы да абдырап қалады.
Dialogue: 0,0:09:48.41,0:09:49.64,CNsub,NTP,0000,0000,0000,,Сіз оны оқи аласыз
Dialogue: 0,0:09:51.01,0:09:53.96,CNsub,NTP,0000,0000,0000,,Қазіргі өмір тарихы
Dialogue: 0,0:09:54.41,0:09:56.61,CNsub,NTP,0000,0000,0000,,Бұл Араяның медицина факультетінің студенті ретіндегі жазбасы.
Dialogue: 0,0:09:56.92,0:09:57.87,CNsub,NTP,0000,0000,0000,,Бұл енді көкке келеді
Dialogue: 0,0:09:58.34,0:10:00.20,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:10:00.85,0:10:02.57,CNsub,NTP,0000,0000,0000,,Адамдармен жақсы әңгімелесу.
Dialogue: 0,0:10:02.88,0:10:06.42,CNsub,NTP,0000,0000,0000,,Қыздың көзін сатып алу жақсы.
Dialogue: 0,0:10:06.79,0:10:10.69,CNsub,NTP,0000,0000,0000,,Қозоның бейнесі өлі және соқыр, ал адам тәкаппар, сабырлы.
Dialogue: 0,0:10:11.13,0:10:13.44,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:10:13.89,0:10:18.01,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:10:18.66,0:10:22.60,CNsub,NTP,0000,0000,0000,,Елорданың келгеніне екі жыл болды.
Dialogue: 0,0:10:22.82,0:10:24.63,CNsub,NTP,0000,0000,0000,,Туған күнің құтты болсын
Dialogue: 0,0:10:25.09,0:10:28.99,CNsub,NTP,0000,0000,0000,,Мен де өзіме, ойыма маңызды адаммын
Dialogue: 0,0:10:40.60,0:10:42.86,CNsub,NTP,0000,0000,0000,,Мен тіл заңгерімін.
Dialogue: 0,0:10:43.35,0:10:46.02,CNsub,NTP,0000,0000,0000,,Ауруханадан шығуға тым кеш болды.
Dialogue: 0,0:10:54.25,0:10:56.37,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:11:00.18,0:11:05.05,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:11:07.40,0:11:12.11,CNsub,NTP,0000,0000,0000,,Жағдайды естігенде Шығыс пен Батысты көргендей ойға қалдым.
Dialogue: 0,0:11:12.40,0:11:14.27,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:11:14.73,0:11:18.05,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:11:20.57,0:11:24.38,CNsub,NTP,0000,0000,0000,,Бірінші көрініс Мен Тоуко Косакимін
Dialogue: 0,0:11:26.78,0:11:30.29,CNsub,NTP,0000,0000,0000,,Мен сізге ауруыңызды емдеуге көмектесу үшін келдім.
Dialogue: 0,0:11:30.77,0:11:31.62,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:11:34.27,0:11:36.28,CNsub,NTP,0000,0000,0000,,Кім қате айтты?
Dialogue: 0,0:11:36.75,0:11:38.81,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:11:39.47,0:11:43.10,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:11:43.83,0:11:46.25,CNsub,NTP,0000,0000,0000,,Өткізіп алмау керек
Dialogue: 0,0:11:46.68,0:11:52.58,CNsub,NTP,0000,0000,0000,,Апат кезінде апат орын алды.
Dialogue: 0,0:11:53.32,0:11:56.30,CNsub,NTP,0000,0000,0000,,Нана
Dialogue: 0,0:11:56.46,0:11:58.23,CNsub,NTP,0000,0000,0000,,Әңгіме осылай жалғасты...
Dialogue: 0,0:12:01.15,0:12:04.48,CNsub,NTP,0000,0000,0000,,Шындық жақсы, мен айырмашылық нүктесіне жеттім, мен бір минутта сәтсіздікке ұшырадым.
Dialogue: 0,0:12:06.36,0:12:07.16,CNsub,NTP,0000,0000,0000,,Марио Зкро
Dialogue: 0,0:12:07.77,0:12:08.36,CNsub,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:12:09.11,0:12:10.80,CNsub,NTP,0000,0000,0000,,Сіз медициналық студент емессіз.
Dialogue: 0,0:12:11.89,0:12:15.00,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:12:16.03,0:12:17.77,CNsub,NTP,0000,0000,0000,,Менің де қызығушылығым жоғалып кетті.
Dialogue: 0,0:12:19.04,0:12:23.80,CNsub,NTP,0000,0000,0000,,Сиқыршы кеудесінде бос.
Dialogue: 0,0:12:24.23,0:12:26.79,CNsub,NTP,0000,0000,0000,,Қарапайым халықтың талантын толықтыру
Dialogue: 0,0:12:27.72,0:12:28.76,CNsub,NTP,0000,0000,0000,,Кеуде қуысында?
Dialogue: 0,0:12:30.03,0:12:32.12,CNsub,NTP,0000,0000,0000,,Ойланып қарасаң, оны да көруге болады.
Dialogue: 0,0:12:32.32,0:12:35.47,CNsub,NTP,0000,0000,0000,,Жалғыз болу - жалғыз болу.
Dialogue: 0,0:12:38.42,0:12:41.64,CNsub,NTP,0000,0000,0000,,Қазір аспанға қалай келгеніңізді бақылаңыз және осы жерде тоқтаңыз
Dialogue: 0,0:12:42.36,0:12:44.10,CNsub,NTP,0000,0000,0000,,Meiten Rewatch Hoku
Dialogue: 0,0:13:07.69,0:13:09.12,CNsub,NTP,0000,0000,0000,,Салтанатты рәсім
Dialogue: 0,0:13:10.55,0:13:12.45,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:13:12.79,0:13:14.84,CNsub,NTP,0000,0000,0000,,«Қазір келді» айқайы
Dialogue: 0,0:13:16.40,0:13:17.59,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:13:19.00,0:13:20.12,CNsub,NTP,0000,0000,0000,,Кейін
Dialogue: 0,0:13:23.83,0:13:25.38,CNsub,NTP,0000,0000,0000,,Нана…Миссис. Апельсин
Dialogue: 0,0:13:42.25,0:13:43.38,CNsub,NTP,0000,0000,0000,,Ойланып қарасаң, оны да көруге болады.
Dialogue: 0,0:13:44.01,0:13:47.08,CNsub,NTP,0000,0000,0000,,Жалғыз болу - жалғыз болу.
Dialogue: 0,0:13:56.58,0:13:59.44,CNsub,NTP,0000,0000,0000,,Олай емес.
Dialogue: 0,0:14:04.43,0:14:06.25,CNsub,NTP,0000,0000,0000,,Қазіргі уақытта жоқ
Dialogue: 0,0:14:07.38,0:14:08.67,CNsub,NTP,0000,0000,0000,,Убукай төтенше жағдай 2
Dialogue: 0,0:14:11.24,0:14:12.01,CNsub,NTP,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:15:09.21,0:15:10.47,CNsub,NTP,0000,0000,0000,,Қайдан келдің?
Dialogue: 0,0:16:09.18,0:16:11.27,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:16:12.95,0:16:19.17,CNsub,NTP,0000,0000,0000,,Бақыт күндей анық.
Dialogue: 0,0:16:25.03,0:16:28.04,CNsub,NTP,0000,0000,0000,,Бұл менің өтуім
Dialogue: 0,0:16:28.37,0:16:29.34,CNsub,NTP,0000,0000,0000,,бірақ істерді тым күрделендіру жүректе қорқыныш тудырады, ал Миста бұны жақсы нәрсе деп санамайды
Dialogue: 0,0:16:36.35,0:16:40.25,CNsub,NTP,0000,0000,0000,,Өмірдің қамын ойлайтын, өзін-өзі атайтын әйел
Dialogue: 0,0:16:41.66,0:16:46.19,CNsub,NTP,0000,0000,0000,,Мен сұраудың қорытындысына келгенде,
Dialogue: 0,0:16:47.87,0:16:57.44,CNsub,NTP,0000,0000,0000,,Түпнұсқаның шығу тегі төмендегідей.
Dialogue: 0,0:16:57.65,0:16:59.98,CNsub,NTP,0000,0000,0000,,Қош келдіңіздер.
Dialogue: 0,0:17:01.42,0:17:03.82,CNsub,NTP,0000,0000,0000,,Қос тұлға, бірақ қызықты
Dialogue: 0,0:17:05.21,0:17:06.46,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:17:06.78,0:17:09.51,CNsub,NTP,0000,0000,0000,,Қос тұлғаның болуы мүмкін бе, жоқ па?
Dialogue: 0,0:17:10.17,0:17:16.53,CNsub,NTP,0000,0000,0000,,Бір мезгілде өмір сүру, әрқайсысының өз еркі және бірге әрекет ету және әрекет ету мүмкіндігі.
Dialogue: 0,0:17:18.05,0:17:21.18,CNsub,NTP,0000,0000,0000,,Бұл мысалда көрсетілгендей, прецеденті жоқ біртүрлі тұлға.
Dialogue: 0,0:17:23.57,0:17:25.68,CNsub,NTP,0000,0000,0000,,Екі сөз жеке тұлғалар.
Dialogue: 0,0:17:26.20,0:17:28.67,CNsub,NTP,0000,0000,0000,,Біріктірілген жеке тұлғалар?
Dialogue: 0,0:17:29.04,0:17:32.10,CNsub,NTP,0000,0000,0000,,Оның бар-жоғы күмәнді.
Dialogue: 0,0:17:32.67,0:17:37.35,CNsub,NTP,0000,0000,0000,,Жастар жеке тұлғалық әңгімелермен үйлеседі.
Dialogue: 0,0:17:38.93,0:17:43.41,CNsub,NTP,0000,0000,0000,,Қай жерде екеніңізге байланысты, сіз қай жерде екеніңізді көре алатын басқа да нүктелер бар...
Dialogue: 0,0:17:50.87,0:17:54.37,CNsub,NTP,0000,0000,0000,,Бірегей және бірегей тегі
Dialogue: 0,0:17:57.66,0:17:59.14,CNsub,NTP,0000,0000,0000,,Бұл бос бейіт
Dialogue: 0,0:17:59.70,0:18:03.15,CNsub,NTP,0000,0000,0000,,Кеуде қуысының суреті толтырылмаған үңгір
Dialogue: 0,0:18:04.87,0:18:12.97,CNsub,NTP,0000,0000,0000,,Егер сіз өзіңізді қайта сезінбесеңіз, оны қайтадан жасай алуыңыз керек.
Dialogue: 0,0:18:20.29,0:18:23.32,CNsub,NTP,0000,0000,0000,,Бар шындық
Dialogue: 0,0:18:24.39,0:18:29.04,CNsub,NTP,0000,0000,0000,,Өзін-өзі сертификаттау рәсімі
Dialogue: 0,0:18:29.74,0:18:31.65,CNsub,NTP,0000,0000,0000,,Раушан жаралып, раушан туды.
Dialogue: 0,0:18:32.88,0:18:38.00,CNsub,NTP,0000,0000,0000,,Топырақ, су, туу, өзгеру, табыс, басқа гүлдердің себебін кездестірмеу.
Dialogue: 0,0:18:39.66,0:18:40.66,CNsub,NTP,0000,0000,0000,,Кішкентай апа Тооко...
Dialogue: 0,0:18:42.46,0:18:46.35,CNsub,NTP,0000,0000,0000,,Қажетті қуысты толтыру шығыстан батысқа қарай
Dialogue: 0,0:18:47.61,0:18:52.86,CNsub,NTP,0000,0000,0000,,Жаңа ғана құрылған және қазір қалыптасып жатқан мүлде жаңа эго.
Dialogue: 0,0:18:53.50,0:18:57.36,CNsub,NTP,0000,0000,0000,,Ешқандай заң көмегінсіз көмектесе алатын адам кім?
Dialogue: 0,0:18:58.67,0:19:03.40,CNsub,NTP,0000,0000,0000,,Әңгіменің түбі мынада: сіз өткен жерге саяхатты жаңа ғана аяқтадыңыз.
Dialogue: 0,0:19:06.46,0:19:13.47,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:19:14.59,0:19:19.39,CNsub,NTP,0000,0000,0000,,Екі жыл бұрын болған қастандық оқиғасының соңғы тергеуі.
Dialogue: 0,0:19:19.89,0:19:22.93,CNsub,NTP,0000,0000,0000,,Бұл нүкте қараңғыда мүлде жоғалып кетті.
Dialogue: 0,0:19:25.68,0:19:29.39,CNsub,NTP,0000,0000,0000,,Сәтсіздіктің себебі
Dialogue: 0,0:19:29.82,0:19:30.39,CNsub,NTP,0000,0000,0000,,\h Мен ашпын.
Dialogue: 0,0:19:31.17,0:19:36.27,CNsub,NTP,0000,0000,0000,,Нәтижесінде дауыстың сол уақытта қозғалмайтыны рас.
Dialogue: 0,0:19:36.78,0:19:40.74,CNsub,NTP,0000,0000,0000,,Басқа шығындарға байланысты өзін жоғалту
Dialogue: 0,0:19:41.59,0:19:42.61,CNsub,NTP,0000,0000,0000,,Шираничи
Dialogue: 0,0:19:43.20,0:19:44.63,CNsub,NTP,0000,0000,0000,,Қайшы қайтып келді ме?
Dialogue: 0,0:19:45.72,0:19:47.22,CNsub,NTP,0000,0000,0000,,Әрекет ету дұрыс емес
Dialogue: 0,0:19:47.63,0:19:51.01,CNsub,NTP,0000,0000,0000,,Сіздің соттылығыңыз бар болғандықтан, қылыш пен құралдарды пайдалану шектелген.
Dialogue: 0,0:19:53.52,0:19:56.31,CNsub,NTP,0000,0000,0000,,Қайшыны қолдану керек пе?
Dialogue: 0,0:19:57.62,0:19:59.76,CNsub,NTP,0000,0000,0000,,Бұл туралы ойланыңыз.
Dialogue: 0,0:20:00.26,0:20:03.18,CNsub,NTP,0000,0000,0000,,Оқиға: Мен сұлулық салонымын
Dialogue: 0,0:20:03.51,0:20:07.34,CNsub,NTP,0000,0000,0000,,Баталарыңыз құтты болсын.
Dialogue: 0,0:20:07.61,0:20:08.24,CNsub,NTP,0000,0000,0000,,Қажет емес
Dialogue: 0,0:20:08.88,0:20:12.52,CNsub,NTP,0000,0000,0000,,Басқа адамның басы астанаға жалғанған
Dialogue: 0,0:20:14.08,0:20:15.83,CNsub,NTP,0000,0000,0000,,Сіз шыншыл бола аласыз.
Dialogue: 0,0:20:19.81,0:20:21.62,CNsub,NTP,0000,0000,0000,,Нана Мен қашып кеттім
Dialogue: 0,0:20:26.73,0:20:31.95,CNsub,NTP,0000,0000,0000,,Күн шыққанда басқа адам келеді.
Dialogue: 0,0:21:39.36,0:21:42.92,CNsub,NTP,0000,0000,0000,,Ақысыз екенің рас.
Dialogue: 0,0:21:43.97,0:21:47.18,CNsub,NTP,0000,0000,0000,,Өлім орын алып, науқас ауруханадан шығарылды.
Dialogue: 0,0:21:47.65,0:21:49.34,CNsub,NTP,0000,0000,0000,,Кішкентай әпкеңізді құттықтаймыз.
Dialogue: 0,0:21:51.58,0:21:57.39,CNsub,NTP,0000,0000,0000,,…
Dialogue: 0,0:21:53.25,0:21:54.22,CNsub,NTP,0000,0000,0000,,Міндетті емес
Dialogue: 0,0:21:57.68,0:21:58.51,CNsub,NTP,0000,0000,0000,,Міндетті емес
Dialogue: 0,0:21:59.73,0:22:00.46,CNsub,NTP,0000,0000,0000,,Міндетті емес
Dialogue: 0,0:22:05.06,0:22:06.08,CNsub,NTP,0000,0000,0000,,Не істеп жатырсыңдар өзің? Бір сәттен бері құлақ тұндырардай шу болып тұр
Dialogue: 0,0:22:07.97,0:22:08.86,CNsub,NTP,0000,0000,0000,,Не істеп жатырсыңдар өзің? Бір сәттен бері құлақ тұндырардай шу болып тұр
Dialogue: 0,0:22:09.38,0:22:11.67,CNsub,NTP,0000,0000,0000,,Қайта-қайта көретін дүние
Dialogue: 0,0:22:22.35,0:22:25.95,CNsub,NTP,0000,0000,0000,,Мен жалғызбын, қараңғылыққа түскім келмейді.
Dialogue: 0,0:22:26.93,0:22:30.28,CNsub,NTP,0000,0000,0000,,Табандылық
Dialogue: 0,0:22:34.77,0:22:36.07,CNsub,NTP,0000,0000,0000,,Қараңыз
Dialogue: 0,0:22:42.73,0:22:44.32,CNsub,NTP,0000,0000,0000,,Тікелей өлімнің жын көзі
Dialogue: 0,0:22:44.60,0:22:48.20,CNsub,NTP,0000,0000,0000,,Сіздің жоғалғаныңызды естігеніме кешірім сұраймын.
Dialogue: 0,0:22:48.82,0:22:53.97,CNsub,NTP,0000,0000,0000,,Ең бастысы Шығыс пен Батысты екі көзбен көруге болады.
Dialogue: 0,0:22:56.13,0:22:57.84,CNsub,NTP,0000,0000,0000,,Сіз адамсыз.
Dialogue: 0,0:23:00.67,0:23:02.14,CNsub,NTP,0000,0000,0000,,Мен сиқыршымын
Dialogue: 0,0:23:02.51,0:23:03.31,CNsub,NTP,0000,0000,0000,,Апельсин бұрышы
Dialogue: 0,0:23:03.71,0:23:10.43,CNsub,NTP,0000,0000,0000,,Дүрбіні қалай пайдалану керек
Dialogue: 0,0:23:12.89,0:23:15.12,CNsub,NTP,0000,0000,0000,,Барлық заттардың жойылуы
Dialogue: 0,0:23:15.63,0:23:21.39,CNsub,NTP,0000,0000,0000,,Шығыс пен Батыста толық сұлулықтың болуына байланысты толық және тұтас дененің болуы қайта құруға ұмтылу болып табылады.
Dialogue: 0,0:23:23.44,0:23:28.26,CNsub,NTP,0000,0000,0000,,Екі жыл бұрын болған апат.
Dialogue: 0,0:23:29.20,0:23:31.68,CNsub,NTP,0000,0000,0000,,Біз заңсыз көретін сызықты көре білу
Dialogue: 0,0:23:32.17,0:23:37.12,CNsub,NTP,0000,0000,0000,,Сізбен ұзақ қарым-қатынаста болған «өлім» нені білдіреді?
Dialogue: 0,0:23:37.32,0:23:40.13,CNsub,NTP,0000,0000,0000,,Дефекация функциясының соңында «өлім» аяқталады.
Dialogue: 0,0:23:42.22,0:23:45.37,CNsub,NTP,0000,0000,0000,,Осы жерде тоқтап қалмаңыз
Dialogue: 0,0:23:53.52,0:23:57.14,CNsub,NTP,0000,0000,0000,,Менің оянуымның екінші рәсімі
Dialogue: 0,0:23:57.68,0:24:00.50,CNsub,NTP,0000,0000,0000,,Сіз қай жердесіз?
Dialogue: 0,0:24:01.17,0:24:05.50,CNsub,NTP,0000,0000,0000,,Табиғи бақыт, қалыпты адамның қарапайым өмірінің бейнесі, қарапайым адамның тағы бір арманы
Dialogue: 0,0:24:08.13,0:24:11.13,CNsub,NTP,0000,0000,0000,,Менің негізгі мақсатым - өмір сүру және өлу.
Dialogue: 0,0:24:12.95,0:24:14.66,CNsub,NTP,0000,0000,0000,,Себебі менің жүрегім бос.
Dialogue: 0,0:24:15.39,0:24:19.79,CNsub,NTP,0000,0000,0000,,Мен де өз түсінігімнен айырылған соң, менде адам ретінде сәйкессіздік сезімі бар екенін түсіндім.
Dialogue: 0,0:24:20.30,0:24:23.47,CNsub,NTP,0000,0000,0000,,Болмауы керек еді, бірақ бір рет болуы керек еді.
Dialogue: 0,0:24:24.25,0:24:25.52,CNsub,NTP,0000,0000,0000,,Сіз мұны істей аласыз ба?
Dialogue: 0,0:24:26.59,0:24:30.56,CNsub,NTP,0000,0000,0000,,Тірі болу және өлу мағынасы
Dialogue: 0,0:24:31.63,0:24:35.82,CNsub,NTP,0000,0000,0000,,Өлім себебі
Dialogue: 0,0:24:36.55,0:24:40.93,CNsub,NTP,0000,0000,0000,,Өмір мен өлімді өзара таңдау
Dialogue: 0,0:24:42.83,0:24:44.82,CNsub,NTP,0000,0000,0000,,Табиғаттың жүрек қауымдастығы Чантоку One Piece Blank
Dialogue: 0,0:24:46.39,0:24:48.13,CNsub,NTP,0000,0000,0000,,Жеке сатып алуды алыңыз
Dialogue: 0,0:24:52.72,0:24:53.71,CNsub,NTP,0000,0000,0000,,Қараңыз
Dialogue: 0,0:24:54.23,0:24:56.93,CNsub,NTP,0000,0000,0000,,Талантты иеленуге қабілетті болғандықтан, бір тілде жұмыс жасайсыз.
Dialogue: 0,0:24:57.94,0:25:03.39,CNsub,NTP,0000,0000,0000,,Ауруханаға барған кезде сіздің денеңіз ең жақсы ыдыс.
Dialogue: 0,0:25:03.98,0:25:07.39,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:25:08.24,0:25:14.10,CNsub,NTP,0000,0000,0000,,Ваказена-кайдың ішкі әңгімесі Шуна Тояко
Dialogue: 0,0:25:16.23,0:25:17.49,CNsub,NTP,0000,0000,0000,,Шынайы бақылау
Dialogue: 0,0:25:19.75,0:25:22.08,CNsub,NTP,0000,0000,0000,,Бұл жазуды жазуға ниет жоқ.
Dialogue: 0,0:25:22.84,0:25:24.02,CNsub,NTP,0000,0000,0000,,Сіз өзіңізді табысты етуіңіз керек.
Dialogue: 0,0:25:28.38,0:25:33.20,CNsub,NTP,0000,0000,0000,,Өлім мен сәтсіздіктің абсолютті шынайы мағынасы.
Dialogue: 0,0:25:46.18,0:25:50.00,CNsub,NTP,0000,0000,0000,,Өлім мен сәтсіздіктің шынайы мағынасы.
Dialogue: 0,0:26:11.92,0:26:14.33,CNsub,NTP,0000,0000,0000,,Юга кетіп қалады
Dialogue: 0,0:26:36.23,0:26:38.94,CNsub,NTP,0000,0000,0000,,Шығыс пен Батысты толтыру үшін қажетті қуыс
Dialogue: 0,0:26:39.81,0:26:45.82,CNsub,NTP,0000,0000,0000,,Виртуалды емес жады, қазіргі кезде қалыптасып жатқан мүлде жаңа эго
Dialogue: 0,0:26:47.84,0:26:51.59,CNsub,NTP,0000,0000,0000,,``Гарьендан-зукури'' заңсыз кез келген адамға және кез келген адамға көмек көрсету нысаны.
Dialogue: 0,0:26:53.33,0:26:58.76,CNsub,NTP,0000,0000,0000,,Сондай-ақ, сіз алдыңғы орынға саяхатты жаңа ғана аяқтағаныңызды атап өткен жөн.
Dialogue: 0,0:27:18.19,0:27:22.50,CNsub,NTP,0000,0000,0000,,Жаңбырда ән айтып жатырмын
Dialogue: 0,0:27:23.10,0:27:26.68,CNsub,NTP,0000,0000,0000,,Жаңбыр астында ән айту
Dialogue: 0,0:27:27.28,0:27:31.30,CNsub,NTP,0000,0000,0000,,Қандай керемет сезім
Dialogue: 0,0:27:31.42,0:27:35.47,CNsub,NTP,0000,0000,0000,,Мен тағы да бақыттымын
Dialogue: 0,0:27:37.00,0:27:39.79,CNsub,NTP,0000,0000,0000,,Мен бұлттарға күлемін
Dialogue: 0,0:27:40.36,0:27:44.05,CNsub,NTP,0000,0000,0000,,Жоғарыда қараңғы
Dialogue: 0,0:27:45.36,0:27:48.40,CNsub,NTP,0000,0000,0000,,Күн менің жүрегімде
Dialogue: 0,0:27:48.71,0:27:52.67,CNsub,NTP,0000,0000,0000,,Ал мен махаббатқа дайынмын
Dialogue: 0,0:27:54.17,0:27:57.96,CNsub,NTP,0000,0000,0000,,Дауылды бұлттар қуып жетсін
Dialogue: 0,0:27:58.50,0:28:01.95,CNsub,NTP,0000,0000,0000,,Барлығы сол жерден
Dialogue: 0,0:28:05.19,0:28:07.52,zhushi,NTP,0000,0000,0000,,Жаңбырмен келіңдер
Dialogue: 0,0:28:07.87,0:28:12.25,zhushi,NTP,0000,0000,0000,,Жүзімде күлкі бар
Dialogue: 0,0:28:12.99,0:28:16.34,zhushi,NTP,0000,0000,0000,,Мен жолақпен жүремін
Dialogue: 0,0:28:17.03,0:28:20.40,zhushi,NTP,0000,0000,0000,,Қуанышты сөзбен
Dialogue: 0,0:28:21.47,0:28:28.00,zhushi,NTP,0000,0000,0000,,Жаңбырда ән шырқап, ән салады
Dialogue: 0,0:28:34.80,0:28:37.96,zhushi,NTP,0000,0000,0000,,La...
Dialogue: 0,0:28:39.67,0:28:41.90,zhushi,NTP,0000,0000,0000,,Мен тағы да бақыттымын
Dialogue: 0,0:28:44.31,0:28:50.83,zhushi,NTP,0000,0000,0000,,Жаңбырда ән айтып, билеп жатырмын
Dialogue: 0,0:28:52.18,0:28:58.54,zhushi,NTP,0000,0000,0000,,Жаңбырда билеп, ән айтамын
Dialogue: 0,0:28:02.13,0:28:06.38,CNsub,NTP,0000,0000,0000,,Өлім мен сәтсіздіктің шынайы мағынасы.
Dialogue: 0,0:28:12.99,0:28:14.12,CNsub,NTP,0000,0000,0000,,Мүмкін...
Dialogue: 0,0:28:15.47,0:28:19.26,CNsub,NTP,0000,0000,0000,,Өлім себебі - жалғыздық пен еркіндік
Dialogue: 0,0:28:20.37,0:28:23.54,CNsub,NTP,0000,0000,0000,,Өлім – қаралық, адамдарға зиян.
Dialogue: 0,0:28:24.52,0:28:27.78,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:28:29.80,0:28:30.71,CNsub,NTP,0000,0000,0000,,Қажет емес
Dialogue: 0,0:28:31.42,0:28:34.26,CNsub,NTP,0000,0000,0000,,Жалғыз қалғым келмейді.
Dialogue: 0,0:28:59.40,0:29:00.09,CNsub,NTP,0000,0000,0000,,Қажетсіз шатасу
Dialogue: 0,0:29:28.42,0:29:31.54,CNsub,NTP,0000,0000,0000,,Жұмысты бастау оңай...
Dialogue: 0,0:29:31.77,0:29:34.08,CNsub,NTP,0000,0000,0000,,Сен мысықсың.
Dialogue: 0,0:29:35.24,0:29:36.07,CNsub,NTP,0000,0000,0000,,Апельсин бұрышы
Dialogue: 0,0:29:37.33,0:29:40.20,CNsub,NTP,0000,0000,0000,,Заңға қолың жетпесе, мен ауруханада ауырып жатырмын.
Dialogue: 0,0:29:40.81,0:29:43.21,CNsub,NTP,0000,0000,0000,,Жиналыс аяқталған соң мәйіт жойылды.
Dialogue: 0,0:29:50.15,0:29:53.22,CNsub,NTP,0000,0000,0000,,Жалпы кіріспе: Қарастырылмаған даналық, даналық, даналық түрлері бар.
Dialogue: 0,0:29:53.72,0:29:55.34,CNsub,NTP,0000,0000,0000,,Бұл менің қателігім
Dialogue: 0,0:29:55.67,0:29:57.64,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:29:58.99,0:29:59.64,CNsub,NTP,0000,0000,0000,,Оның өміріне ешқашан көрмеген әкесі үшін қауіп төндіріліп отыр.
Dialogue: 0,0:30:01.93,0:30:03.84,CNsub,NTP,0000,0000,0000,,Феху Урурз Турисарз
Dialogue: 0,0:30:14.69,0:30:17.88,CNsub,NTP,0000,0000,0000,,Ортаның қолмен ұсталатын түрін кесіңіз
Dialogue: 0,0:30:23.17,0:30:24.68,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:30:25.02,0:30:26.71,CNsub,NTP,0000,0000,0000,,Мұндай нәрсе қиын.
Dialogue: 0,0:30:27.85,0:30:30.45,CNsub,NTP,0000,0000,0000,,Қазіргі жағдайдың тарихын түсіну маңызды.
Dialogue: 0,0:30:30.93,0:30:32.28,CNsub,NTP,0000,0000,0000,,Алайда, қызмет қайтыс болуына байланысты тоқтатылды.
Dialogue: 0,0:30:33.45,0:30:37.69,CNsub,NTP,0000,0000,0000,,Дұрыс себеп қайтыс болды.
Dialogue: 0,0:30:38.21,0:30:41.14,CNsub,NTP,0000,0000,0000,,Шығыс пен Батыстағы әрекеттерді тоқтату үшін қажет.
Dialogue: 0,0:30:41.38,0:30:43.53,CNsub,NTP,0000,0000,0000,,Кейбір адамдар заң күші мен терең күшке енді ғана ие болды.
Dialogue: 0,0:30:43.59,0:30:44.90,CNsub,NTP,0000,0000,0000,,Тағы бір қайталау
Dialogue: 0,0:30:45.12,0:30:46.95,CNsub,NTP,0000,0000,0000,,Қысқаша кіріспе
Dialogue: 0,0:30:47.69,0:30:48.93,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:30:49.61,0:30:51.93,CNsub,NTP,0000,0000,0000,,Өлім себебі - марқұмның өлімі.
Dialogue: 0,0:30:52.59,0:30:53.98,CNsub,NTP,0000,0000,0000,,Мен бас тартпас бұрын
Dialogue: 0,0:30:54.49,0:30:58.84,CNsub,NTP,0000,0000,0000,,Басқару – өлім – өмір.
Dialogue: 0,0:30:59.13,0:30:59.81,CNsub,NTP,0000,0000,0000,,Нана...
Dialogue: 0,0:31:09.13,0:31:11.82,CNsub,NTP,0000,0000,0000,,Мен не істерімді білмеймін.
Dialogue: 0,0:31:52.02,0:31:52.85,CNsub,NTP,0000,0000,0000,,Формула
Dialogue: 0,0:32:02.55,0:32:03.38,CNsub,NTP,0000,0000,0000,,Шынайы фактілер
Dialogue: 0,0:32:22.31,0:32:23.75,CNsub,NTP,0000,0000,0000,,Сізді өлтіргенде...
Dialogue: 0,0:32:25.67,0:32:27.71,CNsub,NTP,0000,0000,0000,,Менің алдымда қажетсіз бекет
Dialogue: 0,0:33:01.34,0:33:03.81,CNsub,NTP,0000,0000,0000,,Соңғысы – жоғалған қол.
Dialogue: 0,0:33:19.54,0:33:20.87,CNsub,NTP,0000,0000,0000,,Бұлай емес.
Dialogue: 0,0:33:22.42,0:33:24.56,CNsub,NTP,0000,0000,0000,,Гайошу ``Мен әлсізмін.''
Dialogue: 0,0:33:25.68,0:33:28.96,CNsub,NTP,0000,0000,0000,,Бізде «екі түрлі түрдің» тіркесімі бар
Dialogue: 0,0:34:04.11,0:34:05.01,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:34:11.46,0:34:13.18,CNsub,NTP,0000,0000,0000,,Сіздің алдыңғы әңгімеңіз
Dialogue: 0,0:34:14.16,0:34:17.40,CNsub,NTP,0000,0000,0000,,Дүрбіні пайдалану жөніндегі нұсқаулық
Dialogue: 0,0:34:18.26,0:34:20.39,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:34:21.63,0:34:24.40,CNsub,NTP,0000,0000,0000,,«Тікелей өлім» қалай қолданылады
Dialogue: 0,0:34:25.19,0:34:28.25,CNsub,NTP,0000,0000,0000,,Жұмыс алмасу
Dialogue: 0,0:34:28.60,0:34:30.41,CNsub,NTP,0000,0000,0000,,Мен өз міндетімнен айырылдым.
Dialogue: 0,0:34:31.22,0:34:33.55,CNsub,NTP,0000,0000,0000,,Көмек сұрату
Dialogue: 0,0:34:34.70,0:34:35.44,CNsub,NTP,0000,0000,0000,,Неке куәлігі: Ллойд Фогель, Джоэл Фогель
Dialogue: 0,0:34:35.57,0:34:37.26,CNsub,NTP,0000,0000,0000,,«Нана» біреуді өлтіру қабілеті
Dialogue: 0,0:34:38.36,0:34:39.98,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:34:40.54,0:34:41.65,CNsub,NTP,0000,0000,0000,,Наганың келісімі
Dialogue: 0,0:34:41.86,0:34:42.83,CNsub,NTP,0000,0000,0000,,Өзіңізге ыңғайлы болу үшін пайдаланыңыз
Dialogue: 0,0:34:44.04,0:34:44.83,CNsub,NTP,0000,0000,0000,,Түзетуге қарсы
Dialogue: 0,0:34:45.30,0:34:47.51,CNsub,NTP,0000,0000,0000,,Осы басқа мақсатты қоспағанда.
Dialogue: 0,0:34:58.63,0:35:00.46,CNsub,NTP,0000,0000,0000,,Мақсаты жоқ
Dialogue: 0,0:35:00.59,0:35:01.85,CNsub,NTP,0000,0000,0000,,Наята трагедиялық соңғы нүкте 3
Dialogue: 0,0:35:02.90,0:35:04.73,CNsub,NTP,0000,0000,0000,,Дегенмен, ол өте танымал.
Dialogue: 0,0:35:09.04,0:35:14.12,CNsub,NTP,0000,0000,0000,,«Гарион үңгірін» басқаша қолдануға болады.
Dialogue: 0,0:35:18.97,0:35:20.43,CNsub,NTP,0000,0000,0000,,Сіздің бақытты кішкентай басыңыз
Dialogue: 0,0:35:20.87,0:35:24.27,CNsub,NTP,0000,0000,0000,,Миёши Хинасараның болашағы міндетті түрде орындалады.
Dialogue: 0,0:35:28.38,0:35:33.84,CNsub,NTP,0000,0000,0000,,Одан басқа, оны пайдалану қауіпсіз, бірақ ол жоғалады.
Dialogue: 0,0:35:35.12,0:35:36.88,CNsub,NTP,0000,0000,0000,,Жоғалу
Dialogue: 0,0:35:37.75,0:35:41.19,CNsub,NTP,0000,0000,0000,,Көбінесе бұл өз арманы
Dialogue: 0,0:35:42.48,0:35:44.99,CNsub,NTP,0000,0000,0000,,Басқа адамдардың өмірдегі бақыт туралы армандары
Dialogue: 0,0:35:46.13,0:35:50.21,CNsub,NTP,0000,0000,0000,,Бұл терең жалғыздық
Dialogue: 0,0:35:58.24,0:36:00.48,CNsub,NTP,0000,0000,0000,,Позитивті себеп – менің айтайын дегенім.
Dialogue: 0,0:36:00.66,0:36:03.51,CNsub,NTP,0000,0000,0000,,Бұдан әрі Қара Тунг қараңыз
Dialogue: 0,0:36:09.67,0:36:11.28,CNsub,NTP,0000,0000,0000,,Йоши Хаяками стилі
Dialogue: 0,0:36:21.68,0:36:23.79,CNsub,NTP,0000,0000,0000,,Ақпаратты жазу
Dialogue: 0,0:36:26.32,0:36:28.61,CNsub,NTP,0000,0000,0000,,Мен не білдім
Dialogue: 0,0:36:29.87,0:36:32.99,CNsub,NTP,0000,0000,0000,,Ақпаратты алуыңызды күтемін.
Dialogue: 0,0:36:34.08,0:36:38.63,CNsub,NTP,0000,0000,0000,,Тек сізде бар.
Dialogue: 0,0:36:43.59,0:36:45.02,CNsub,NTP,0000,0000,0000,,Каня Куротоу
Dialogue: 0,0:36:47.99,0:36:49.97,CNsub,NTP,0000,0000,0000,,Заңды елде қолданылатын тегі
Dialogue: 0,0:36:54.51,0:36:55.91,CNsub,NTP,0000,0000,0000,,Бүгінгі ауа райы ашық, күн ашық.
Dialogue: 0,0:36:59.55,0:37:01.53,CNsub,NTP,0000,0000,0000,,Ауа райының бұл түрі ауруханадан шығуға қолайлы.
Dialogue: 0,0:37:06.57,0:37:10.57,CNsub,NTP,0000,0000,0000,,Шығыс пен Батысты тастап кеткенімде
Dialogue: 0,0:42:28.20,0:42:30.45,CNsub,NTP,0000,0000,0000,,Сіз діни қызметкерсіз.
Dialogue: 0,0:42:32.27,0:42:35.64,CNsub,NTP,0000,0000,0000,,Сен менің әкемнің досысың...
Dialogue: 0,0:42:37.13,0:42:39.75,CNsub,NTP,0000,0000,0000,,Мен сені көргім келеді.
Dialogue: 0,0:42:43.95,0:42:46.60,CNsub,NTP,0000,0000,0000,,Өзінің қосалқы денесін иемдену мүмкіндігі мен еркіндігі
Dialogue: 0,0:42:46.99,0:42:48.45,CNsub,NTP,0000,0000,0000,,Сіз қалай ойлайсыз?
Dialogue: 0,0:42:51.92,0:42:54.45,CNsub,NTP,0000,0000,0000,,Сіз... адамсыз ба?
Dialogue: 0,0:42:58.74,0:43:02.61,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:43:03.29,0:43:05.64,CNsub,NTP,0000,0000,0000,,Мен не айтуым керек?
Dialogue: 0,0:43:14.41,0:43:16.55,CNsub,NTP,0000,0000,0000,,Сіз Асагами Фудзи но Усыз
Dialogue: 0,0:43:18.31,0:43:19.89,CNsub,NTP,0000,0000,0000,,Ойлар мен пікірлер
Dialogue: 0,0:43:22.95,0:43:24.21,CNsub,NTP,0000,0000,0000,,Түсінемін
Dialogue: 0,0:43:25.08,0:43:28.06,CNsub,NTP,0000,0000,0000,,Егер сіз физикалық жағынан басқа болсаңыз, маған хабарлаңыз.
Dialogue: 0,0:43:34.17,0:43:36.47,CNsub,NTP,0000,0000,0000,,Сіздің түпкі мақсатыңыз...сіз адамсыз ба?
Dialogue: 0,0:43:42.03,0:43:44.55,CNsub,NTP,0000,0000,0000,,Сіз осындасыз... Сіз адамсыз ба?
Dialogue: 0,0:43:48.38,0:43:49.70,CNsub,NTP,0000,0000,0000,,Сиқыршы
Dialogue: 0,0:43:50.90,0:43:52.48,CNsub,NTP,0000,0000,0000,,Соен Арая
Dialogue: 0,0:44:05.57,0:44:08.58,CNsub,NTP,0000,0000,0000,,Мен ғана шыдаймын.
Dialogue: 0,0:44:11.48,0:44:13.73,CNsub,NTP,0000,0000,0000,,Мен өлдім
Dialogue: 0,0:44:14.73,0:44:15.69,CNsub,NTP,0000,0000,0000,,Егіз ата-ананы өлтіру?
Dialogue: 0,0:44:16.84,0:44:17.65,CNsub,NTP,0000,0000,0000,,Қара пауловния
Dialogue: 0,0:44:17.96,0:44:20.19,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:44:20.32,0:44:25.40,CNsub,NTP,0000,0000,0000,,Огава Коге - жарты ай тәрізді он деңгейлі Когенің бастапқы құрылысы
Dialogue: 0,0:44:26.16,0:44:27.19,CNsub,NTP,0000,0000,0000,,Өте біртүрлі
Dialogue: 0,0:44:28.71,0:44:31.37,CNsub,NTP,0000,0000,0000,,Балаңыздың өлімін қалдырудың қажеті жоқ.
Dialogue: 0,0:44:31.93,0:44:33.41,CNsub,NTP,0000,0000,0000,,Мен сені өлтіретініме сенімдімін.
Dialogue: 0,0:44:33.80,0:44:35.95,CNsub,NTP,0000,0000,0000,,Бұл тұрарлық емес.
Dialogue: 0,0:44:36.66,0:44:38.31,CNsub,NTP,0000,0000,0000,,Растау қабылданбайды.
Dialogue: 0,0:44:38.56,0:44:40.14,CNsub,NTP,0000,0000,0000,,Қараңғылыққа бой алдырған
Dialogue: 0,0:44:40.87,0:44:44.15,CNsub,NTP,0000,0000,0000,,Өз тегіңізді еске түсіргеннен кейін
Dialogue: 0,0:44:44.26,0:44:45.46,CNsub,NTP,0000,0000,0000,,Сіздің стиліңіз қандай?
Dialogue: 0,0:44:45.61,0:44:47.13,CNsub,NTP,0000,0000,0000,,Бұл маңызды ...
Dialogue: 0,0:44:47.39,0:44:49.98,CNsub,NTP,0000,0000,0000,,Егер сіз нақты жағдайға жауапты болсаңыз...
Dialogue: 0,0:44:50.07,0:44:51.42,CNsub,NTP,0000,0000,0000,,Мен өзім басқардым...
Dialogue: 0,0:44:51.55,0:44:52.12,CNsub,NTP,0000,0000,0000,,Тайшо…
Dialogue: 0,0:44:52.35,0:44:53.20,CNsub,NTP,0000,0000,0000,,Ағымдағы оқиға…
Dialogue: 0,0:44:53.46,0:44:55.93,CNsub,NTP,0000,0000,0000,,Косаки! !
Dialogue: 0,0:45:06.79,0:45:08.01,CNsub,NTP,0000,0000,0000,,Спираль
Dialogue: 0,0:45:08.29,0:45:10.16,CNsub,NTP,0000,0000,0000,,қарама-қайшы болуы керек
Dialogue: 0,0:45:21.15,0:45:27.15,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
