Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.00,0:00:04.04,Default,,0,0,0,,Уф...
Dialogue: 0,0:00:04.83,0:00:05.54,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:00:05.63,0:00:09.30,Default,,0,0,0,,Гецуга Теншо мен Кью но Флэш патшасының бірігуі (Гран Рей Серо)
Dialogue: 0,0:00:09.80,0:00:15.22,Default,,0,0,0,,Барлық нәрсенің қосындысынан туған саған лайық құдірет.
Dialogue: 0,0:00:16.22,0:00:18.89,Default,,0,0,0,,Бірақ бәрібір
Dialogue: 0,0:00:19.39,0:00:21.39,Default,,0,0,0,,Бұл маған жетпейді
Dialogue: 0,0:00:23.89,0:00:24.39,Default,,0,0,0,,Әй!
Dialogue: 0,0:00:25.56,0:00:26.31,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:00:27.48,0:00:27.98,Default,,0,0,0,,Гах...
Dialogue: 0,0:00:38.53,0:00:40.54,Default,,0,0,0,,♪～
Dialogue: 0,0:02:05.91,0:02:07.91,Default,,0,0,0,,～♪
Dialogue: 0,0:02:09.71,0:02:12.59,Default,,0,0,0,,Ібілістің сол қолы (Braso Izquierda del Diablo)
Dialogue: 0,0:02:13.29,0:02:14.46,Default,,0,0,0,,Шайтанның соққысы (La Muerte)!
Dialogue: 0,0:02:16.55,0:02:18.22,Default,,0,0,0,,Хааа~
Dialogue: 0,0:02:18.30,0:02:20.93,Default,,0,0,0,,Осы қарқынмен қалғандары жылдам жүреді!
Dialogue: 0,0:02:24.14,0:02:25.27,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:02:27.14,0:02:28.14,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:02:31.40,0:02:31.94,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:32.02,0:02:34.48,Default,,0,0,0,,Не, сен жалғызсың ба?
Dialogue: 0,0:02:34.57,0:02:35.86,Default,,0,0,0,,Ичиго ше?
Dialogue: 0,0:02:35.94,0:02:38.36,Default,,0,0,0,,Мен Инуэ мен Юхабахқа бет алдым.
Dialogue: 0,0:02:39.15,0:02:40.11,Default,,0,0,0,,Гааах!
Dialogue: 0,0:02:40.20,0:02:42.74,Default,,0,0,0,,Жалғыз жүгіріп жүргенің дұрыс па?
Dialogue: 0,0:02:42.82,0:02:44.70,Default,,0,0,0,,Ах... Ренжи
Dialogue: 0,0:02:44.78,0:02:48.12,Default,,0,0,0,,Алға, Руқия, мен мұны істеймін.
Dialogue: 0,0:02:49.04,0:02:49.91,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:02:50.00,0:02:50.92,Default,,0,0,0,,Әй!
Dialogue: 0,0:02:57.46,0:02:59.17,Default,,0,0,0,,Сіз түсінбейтін сияқтысыз...
Dialogue: 0,0:02:59.97,0:03:03.64,Default,,0,0,0,,Бәрің де менің тістеген иттерімсіңдер.
Dialogue: 0,0:03:08.64,0:03:09.73,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:03:12.15,0:03:14.69,Default,,0,0,0,,Сіз жай ғана қашып бара жатырсыз ба? Урю Ишида
Dialogue: 0,0:03:15.40,0:03:15.90,Default,,0,0,0,,Аһ!
Dialogue: 0,0:03:24.12,0:03:24.87,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:03:32.25,0:03:36.63,Default,,0,0,0,,Енді садақыңызды бекітіңіз, соңғы жоюшы (Квинси)
Dialogue: 0,0:03:37.50,0:03:39.38,Default,,0,0,0,,Мен жебені кесемін
Dialogue: 0,0:03:40.42,0:03:43.13,Default,,0,0,0,,Мен сен туралы бәрін ашамын
Dialogue: 0,0:03:48.06,0:03:49.35,Default,,0,0,0,,Байқап көріңіз
Dialogue: 0,0:03:49.93,0:03:51.94,Default,,0,0,0,,Қылышың маған жетсе
Dialogue: 0,0:04:05.11,0:04:06.24,Default,,0,0,0,,Қандай әдемі теңдігімді бұзды!
Dialogue: 0,0:04:06.32,0:04:09.49,Default,,0,0,0,,Теңдесі жоқ хаос құйындысы
Dialogue: 0,0:04:09.58,0:04:11.20,Default,,0,0,0,,Міне...
Dialogue: 0,0:04:12.33,0:04:14.17,Default,,0,0,0,,Бұл Рух Патшасының күші.
Dialogue: 0,0:04:15.25,0:04:16.04,Default,,0,0,0,,Аһ!
Dialogue: 0,0:04:17.42,0:04:18.84,Default,,0,0,0,,Алдын алу мүмкін емес
Dialogue: 0,0:04:18.92,0:04:19.67,Default,,0,0,0,,Аһ!
Dialogue: 0,0:04:20.84,0:04:21.34,Default,,0,0,0,,Ха!
Dialogue: 0,0:04:22.47,0:04:23.88,Default,,0,0,0,,Төрт аспандық қарсылық қалқаны!
Dialogue: 0,0:04:26.84,0:04:28.01,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:32.89,0:04:33.52,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:37.36,0:04:40.98,Default,,0,0,0,,Ичиго, күш дегеніміз не?
Dialogue: 0,0:04:41.07,0:04:42.78,Default,,0,0,0,,Бұл не үшін?
Dialogue: 0,0:04:43.28,0:04:45.61,Default,,0,0,0,,Сіз жауап бересіз
Dialogue: 0,0:04:45.70,0:04:47.03,Default,,0,0,0,,«Қорғау»
Dialogue: 0,0:04:48.24,0:04:52.00,Default,,0,0,0,,Бірақ ол күш әлсіз күш.
Dialogue: 0,0:04:52.08,0:04:53.25,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:55.04,0:04:56.46,Default,,0,0,0,,Арх! Гах...
Dialogue: 0,0:04:56.54,0:04:58.33,Default,,0,0,0,,Күшті күш дегеніміз не?
Dialogue: 0,0:04:58.42,0:05:01.84,Default,,0,0,0,,Халықтың көңілін түсіріп, дүниені тізе бүктір
Dialogue: 0,0:05:01.92,0:05:05.13,Default,,0,0,0,,Бұл дүниеде бәрін ұстап тұрған күш.
Dialogue: 0,0:05:05.84,0:05:08.89,Default,,0,0,0,,Мені жеңгіңіз келсе
Dialogue: 0,0:05:09.64,0:05:12.60,Default,,0,0,0,,Бұл күш
Dialogue: 0,0:05:13.10,0:05:15.73,Default,,0,0,0,,«Қорғау» - алдау.
Dialogue: 0,0:05:15.81,0:05:18.90,Default,,0,0,0,,Батыр болма, Ичиго
Dialogue: 0,0:05:19.52,0:05:20.65,Default,,0,0,0,,…
Dialogue: 0,0:05:22.11,0:05:25.61,Default,,0,0,0,,Мен Куросаки-кунды қорғағым келеді.
Dialogue: 0,0:05:27.11,0:05:29.82,Default,,0,0,0,,Өйткені менің күшім әлсіз
Dialogue: 0,0:05:30.66,0:05:34.37,Default,,0,0,0,,Менің күш-қуатым артық болса...
Dialogue: 0,0:05:37.33,0:05:38.29,Default,,0,0,0,,Аһ!
Dialogue: 0,0:05:50.39,0:05:51.80,Default,,0,0,0,,Күрделі
Dialogue: 0,0:05:51.89,0:05:52.60,Default,,0,0,0,,Уф!
Dialogue: 0,0:05:52.68,0:05:54.10,Default,,0,0,0,,Мен бас тартамын!
Dialogue: 0,0:06:01.73,0:06:03.07,Default,,0,0,0,,Бас тартыңыз!
Dialogue: 0,0:06:04.11,0:06:04.94,Default,,0,0,0,,Гаха!
Dialogue: 0,0:06:07.40,0:06:08.82,Default,,0,0,0,,Гехо…
Dialogue: 0,0:06:08.91,0:06:09.41,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:13.74,0:06:14.79,Default,,0,0,0,,Ал ең бастысы, Иносукэ, өзің қалайсың?
Dialogue: 0,0:06:15.29,0:06:16.20,Default,,0,0,0,,Инау!
Dialogue: 0,0:06:17.37,0:06:21.08,Default,,0,0,0,,Сізде басқаларға қамқорлық жасауға күш жеткілікті ме?
Dialogue: 0,0:06:21.96,0:06:23.17,Default,,0,0,0,,Гах...
Dialogue: 0,0:06:34.26,0:06:35.56,Default,,0,0,0,,«Сенді ергеніме өкінемін».
Dialogue: 0,0:06:35.64,0:06:37.06,Default,,0,0,0,,Жалғастырыңыз.
Dialogue: 0,0:06:38.02,0:06:40.73,Default,,0,0,0,,Күшіңіз таусылғанша
Dialogue: 0,0:06:47.03,0:06:48.19,Default,,0,0,0,,Кио…
Dialogue: 0,0:06:48.86,0:06:51.20,Default,,0,0,0,,Бас тарту...
Dialogue: 0,0:06:55.20,0:06:58.87,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:07:04.17,0:07:05.21,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:06.09,0:07:07.84,Default,,0,0,0,,Ino... Ue...
Dialogue: 0,0:07:09.22,0:07:11.22,Default,,0,0,0,,Тоқта... Ро...
Dialogue: 0,0:07:12.55,0:07:15.43,Default,,0,0,0,,Кио… Цэцу…
Dialogue: 0,0:07:16.51,0:07:17.22,Default,,0,0,0,,Жасау…
Dialogue: 0,0:07:18.22,0:07:19.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:20.77,0:07:23.56,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:07:24.48,0:07:27.86,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:07:27.94,0:07:29.90,Default,,0,0,0,,- (Ичиго) Жетер, Иноуэ! -(Юхбах) Тым қатты.
Dialogue: 0,0:07:29.99,0:07:31.03,Default,,0,0,0,,Бас тартыңыз!
Dialogue: 0,0:07:34.70,0:07:36.74,Default,,0,0,0,,Ах... уф...
Dialogue: 0,0:07:37.41,0:07:38.54,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:39.20,0:07:43.00,Default,,0,0,0,,Соңғы қуатымды Ичигода қолдануым керек пе?
Dialogue: 0,0:07:43.08,0:07:46.21,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:07:46.71,0:07:50.26,Default,,0,0,0,,Бірақ бұл туралы не деуге болады?
Dialogue: 0,0:07:52.84,0:07:54.14,Default,,0,0,0,,Менің күшім...
Dialogue: 0,0:07:57.43,0:08:00.27,Default,,0,0,0,,Егер ол үлкенірек болса...
Dialogue: 0,0:08:04.81,0:08:05.61,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:05.69,0:08:06.94,Default,,0,0,0,,Ха!
Dialogue: 0,0:08:07.02,0:08:08.82,Default,,0,0,0,,Сен жақсы шыдадың.
Dialogue: 0,0:08:09.69,0:08:10.65,Default,,0,0,0,,Inoue
Dialogue: 0,0:08:11.15,0:08:12.74,Default,,0,0,0,,Кучики мырза...
Dialogue: 0,0:08:13.24,0:08:15.11,Default,,0,0,0,,Әй... Руқия
Dialogue: 0,0:08:16.20,0:08:18.45,Default,,0,0,0,,Мен көмектесуге келдім, Ичиго.
Dialogue: 0,0:08:23.62,0:08:25.58,Default,,0,0,0,,Амансың ба? Инуэ!
Dialogue: 0,0:08:26.08,0:08:26.96,Default,,0,0,0,,Иә
Dialogue: 0,0:08:27.04,0:08:29.30,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,0:08:30.38,0:08:32.09,Default,,0,0,0,,Қалғанын маған қалдырыңыз.
Dialogue: 0,0:08:38.89,0:08:41.72,Default,,0,0,0,,Мен сені көптен бері көрмедім, көп нәрсе өзгерді.
Dialogue: 0,0:08:42.56,0:08:45.39,Default,,0,0,0,,Қара футонға оранған, Мүйізге дейін өскен
Dialogue: 0,0:08:45.48,0:08:46.90,Default,,0,0,0,,Ух... өте шулы!
Dialogue: 0,0:08:46.98,0:08:50.48,Default,,0,0,0,,Мен танумаки болмадым, өйткені ол маған ұнады, бірақ мүйіздері салқын болар еді!
Dialogue: 0,0:08:50.57,0:08:51.44,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:08:51.53,0:08:52.99,Default,,0,0,0,,Кенеттен келіп, әй, мынау!
Dialogue: 0,0:08:53.07,0:08:54.07,Default,,0,0,0,,Не!
Dialogue: 0,0:08:54.15,0:08:56.20,Default,,0,0,0,,Сізге көмектескен адамға айтасыз ба?
Dialogue: 0,0:08:56.28,0:08:57.57,Default,,0,0,0,,Менен көмек сұрама!
Dialogue: 0,0:08:57.66,0:08:59.87,Default,,0,0,0,,Бамбук арқанмен ұрып өлтірген адам
Dialogue: 0,0:08:59.95,0:09:00.45,Default,,0,0,0,,Мен мұны жиі айтамын.
Dialogue: 0,0:09:00.53,0:09:03.33,Default,,0,0,0,,Мен тек қарсы күресуді ойлап жүр едім!
Dialogue: 0,0:09:03.41,0:09:05.33,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:05.96,0:09:06.58,Default,,0,0,0,,Иә
Dialogue: 0,0:09:06.67,0:09:09.46,Default,,0,0,0,,Сіз ақымақ емес сияқтысыз.
Dialogue: 0,0:09:09.96,0:09:11.30,Default,,0,0,0,,Бұл болжам.
Dialogue: 0,0:09:11.38,0:09:13.34,Default,,0,0,0,,Рукия Кучики
Dialogue: 0,0:09:13.42,0:09:16.84,Default,,0,0,0,,Ичигоға басшылық еткен Шинигами болды ма?
Dialogue: 0,0:09:18.84,0:09:23.18,Default,,0,0,0,,Егер мен өлім құдайына алғыс айтсам, ол сен болар едің.
Dialogue: 0,0:09:23.27,0:09:26.77,Default,,0,0,0,,Ичиго ояту үшін триггерді басты.
Dialogue: 0,0:09:27.81,0:09:30.77,Default,,0,0,0,,Олай болса дөрекілік үшін кешірім сұраудың қажеті жоқ.
Dialogue: 0,0:09:32.15,0:09:35.78,Default,,0,0,0,,Мен және мына адам сені жеңеді.
Dialogue: 0,0:09:39.78,0:09:41.24,Default,,0,0,0,,Рукия кеттік
Dialogue: 0,0:09:41.33,0:09:42.24,Default,,0,0,0,,О
Dialogue: 0,0:09:45.20,0:09:47.71,Default,,0,0,0,,Не болды? Сізде талант жоқ.
Dialogue: 0,0:09:53.71,0:09:54.46,Default,,0,0,0,,１
Dialogue: 0,0:09:55.63,0:09:56.13,Default,,0,0,0,,２
Dialogue: 0,0:09:58.55,0:09:59.05,Default,,0,0,0,,３！
Dialogue: 0,0:10:00.09,0:10:01.22,Default,,0,0,0,,Мен оны көріп тұрмын.
Dialogue: 0,0:10:01.30,0:10:02.31,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:03.22,0:10:06.68,Default,,0,0,0,,Соңғы Квинси арқасын қылышпен көздейді.
Dialogue: 0,0:10:06.77,0:10:07.98,Default,,0,0,0,,Бұл көрсеткі
Dialogue: 0,0:10:08.48,0:10:11.86,Default,,0,0,0,,Менің сөзімді де болжаңыз, Ұлы Мастер!
Dialogue: 0,0:10:14.40,0:10:16.28,Default,,0,0,0,,Егер келесі...
Dialogue: 0,0:10:18.78,0:10:20.32,Default,,0,0,0,,Қарғыс атсын... Ха!
Dialogue: 0,0:10:25.49,0:10:27.16,Default,,0,0,0,,Бұл сұрықсыз көрініс.
Dialogue: 0,0:10:27.96,0:10:29.79,Default,,0,0,0,,Бірақ бұл орынды.
Dialogue: 0,0:10:30.42,0:10:31.79,Default,,0,0,0,,Урю Ишида
Dialogue: 0,0:10:31.88,0:10:32.59,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:35.67,0:10:36.34,Default,,0,0,0,,Әй!
Dialogue: 0,0:10:40.09,0:10:40.76,Default,,0,0,0,,Әй!
Dialogue: 0,0:10:42.35,0:10:43.18,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:10:45.97,0:10:46.93,Default,,0,0,0,,Әй!
Dialogue: 0,0:10:47.81,0:10:48.77,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:10:49.69,0:10:51.44,Default,,0,0,0,,-(Ичиго) Ух... -Ха!
Dialogue: 0,0:10:52.73,0:10:54.36,Default,,0,0,0,,Қызықты күш
Dialogue: 0,0:10:55.07,0:10:58.82,Default,,0,0,0,,Достарыммен бірге төбелесуге бұғау болған сияқты.
Dialogue: 0,0:10:59.74,0:11:01.61,Default,,0,0,0,,Тезірек, Рукия.
Dialogue: 0,0:11:02.45,0:11:03.82,Default,,0,0,0,,Оны жеңіңіз
Dialogue: 0,0:11:03.91,0:11:06.37,Default,,0,0,0,,Аа, айтудың қажеті жоқ.
Dialogue: 0,0:11:17.88,0:11:18.67,Default,,0,0,0,,Ха!
Dialogue: 0,0:11:18.76,0:11:20.63,Default,,0,0,0,,Қандай әдемі теңдігімді бұзды!
Dialogue: 0,0:11:20.72,0:11:23.43,Default,,0,0,0,,Ахх!
Dialogue: 0,0:11:25.97,0:11:27.52,Default,,0,0,0,,Ууууах!
Dialogue: 0,0:11:27.60,0:11:29.14,Default,,0,0,0,,Ууууах!
Dialogue: 0,0:11:31.98,0:11:33.06,Default,,0,0,0,,Хун
Dialogue: 0,0:11:40.19,0:11:40.86,Default,,0,0,0,,Аһ!
Dialogue: 0,0:11:40.95,0:11:42.24,Default,,0,0,0,,Уф!
Dialogue: 0,0:11:42.32,0:11:43.74,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:49.12,0:11:52.75,Default,,0,0,0,,Менің күшім болса...
Dialogue: 0,0:11:53.67,0:11:56.79,Default,,0,0,0,,Куросаки-кун мен Кучики-сан да
Dialogue: 0,0:11:56.88,0:11:59.21,Default,,0,0,0,,Мен бұлай жарақат алмасам екен.
Dialogue: 0,0:12:00.76,0:12:02.88,Default,,0,0,0,,Өйткені менің күшім әлсіз
Dialogue: 0,0:12:04.01,0:12:08.18,Default,,0,0,0,,Сондықтан Куросаки мен Кучики қиналып жатыр.
Dialogue: 0,0:12:09.89,0:12:13.89,Default,,0,0,0,,Менің күшім арта береді
Dialogue: 0,0:12:14.81,0:12:15.90,Default,,0,0,0,,Егер ол үлкенірек болса...
Dialogue: 0,0:12:19.98,0:12:21.24,Default,,0,0,0,,Фалкооо!! Қайдасыңңң!!
Dialogue: 0,0:12:23.11,0:12:23.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:30.20,0:12:34.42,Default,,0,0,0,,Ештеңеге оралма, ей, әлсіз күш.
Dialogue: 0,0:12:44.88,0:12:48.30,Default,,0,0,0,,Қош бол, балам.
Dialogue: 0,0:12:54.85,0:12:55.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:02.07,0:13:05.07,Default,,0,0,0,,Ай...?
Dialogue: 0,0:13:05.82,0:13:06.82,Default,,0,0,0,,Манджи…
Dialogue: 0,0:13:11.83,0:13:12.79,Default,,0,0,0,,Шешімі
Dialogue: 0,0:13:20.00,0:13:22.17,Default,,0,0,0,,Сен маған көрсетесің бе?
Dialogue: 0,0:13:23.17,0:13:25.93,Default,,0,0,0,,Сіздің Банкай
Dialogue: 0,0:13:43.15,0:13:44.69,Default,,0,0,0,,Куросаки-кун...
Dialogue: 0,0:13:44.78,0:13:48.66,Default,,0,0,0,,Түсіндім, бұл сіздің Зангецуыңыз.
Dialogue: 0,0:13:55.50,0:13:58.92,Default,,0,0,0,,Сізде бар күш
Dialogue: 0,0:13:59.71,0:14:02.29,Default,,0,0,0,,Оны тізе бүктірейік
Dialogue: 0,0:14:06.55,0:14:07.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:07.34,0:14:08.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:13.31,0:14:14.85,Default,,0,0,0,,Бұл қуат
Dialogue: 0,0:14:15.93,0:14:19.27,Default,,0,0,0,,Барлығын сенен қорғау үшін
Dialogue: 0,0:14:20.23,0:14:22.02,Default,,0,0,0,,Қажетті қуат
Dialogue: 0,0:14:23.73,0:14:25.61,Default,,0,0,0,,Ичиго жылы.
Dialogue: 0,0:14:25.69,0:14:28.20,Default,,0,0,0,,Кеттік, Юхабах
Dialogue: 0,0:14:28.70,0:14:29.28,Default,,0,0,0,,Ха!
Dialogue: 0,0:14:34.41,0:14:37.37,Default,,0,0,0,,Не? Слеш кешіктірілді ме?
Dialogue: 0,0:14:38.04,0:14:41.04,Default,,0,0,0,,Бірақ... оны өшіргенше!
Dialogue: 0,0:14:44.00,0:14:45.80,Default,,0,0,0,,Жауап болды.
Dialogue: 0,0:14:46.30,0:14:47.88,Default,,0,0,0,,Сен неге сондасың?
Dialogue: 0,0:14:47.97,0:14:50.01,Default,,0,0,0,,Ууууах!
Dialogue: 0,0:14:52.09,0:14:52.89,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:54.85,0:14:55.81,Default,,0,0,0,,(Баяндаушы) Цезарь не болып жатқанын мүлде түсінбеді.
Dialogue: 0,0:14:55.89,0:14:56.68,Default,,0,0,0,,Әй!
Dialogue: 0,0:14:57.31,0:14:58.10,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:58.64,0:14:59.14,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:01.60,0:15:04.15,Default,,0,0,0,,Қарғыс атсын саған Рейацу!
Dialogue: 0,0:15:37.60,0:15:40.81,Default,,0,0,0,,Бұл өлім құдайының күші.
Dialogue: 0,0:15:40.89,0:15:44.36,Default,,0,0,0,,Бірақ мен жылы дедім, Ичиго!
Dialogue: 0,0:15:47.15,0:15:47.90,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:52.24,0:15:55.82,Default,,0,0,0,,Дос керек емес деген сияқты.
Dialogue: 0,0:16:00.54,0:16:01.08,Default,,0,0,0,,Қандай әдемі теңдігімді бұзды!
Dialogue: 0,0:16:09.46,0:16:10.46,Default,,0,0,0,,Гецуга...
Dialogue: 0,0:16:19.68,0:16:23.73,Default,,0,0,0,,Теншо!
Dialogue: 0,0:16:44.83,0:16:45.96,Default,,0,0,0,,Куросаки-кун...
Dialogue: 0,0:17:04.94,0:17:06.73,Default,,0,0,0,,«Мен өзімді кінәлаймын...»
Dialogue: 0,0:17:07.77,0:17:10.11,Default,,0,0,0,,«Осы сәтте жеңілу»
Dialogue: 0,0:17:10.19,0:17:12.11,Default,,0,0,0,,Менің ойымша, сіз осылай ойладыңыз.
Dialogue: 0,0:17:12.19,0:17:13.32,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:13.40,0:17:15.57,Default,,0,0,0,,Мен оны атамаймын.
Dialogue: 0,0:17:16.16,0:17:19.32,Default,,0,0,0,,Сені жеу үшін мен білуім керек еді.
Dialogue: 0,0:17:19.41,0:17:20.95,Default,,0,0,0,,Ичигоны өлтіріңіз! Қазір!
Dialogue: 0,0:17:21.03,0:17:23.87,Default,,0,0,0,,Сол кезде...
Dialogue: 0,0:17:23.95,0:17:24.83,Default,,0,0,0,,Гецуга...
Dialogue: 0,0:17:25.41,0:17:27.33,Default,,0,0,0,,Енді бітті!
Dialogue: 0,0:17:27.83,0:17:28.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:28.58,0:17:29.92,Default,,0,0,0,,Бұл не өзі?!
Dialogue: 0,0:17:36.18,0:17:37.05,Default,,0,0,0,,Куросаки-кун!
Dialogue: 0,0:17:43.22,0:17:45.18,Default,,0,0,0,,Соңғы қараушы
Dialogue: 0,0:17:45.98,0:17:47.90,Default,,0,0,0,,Сен бұл дүниеденсің
Dialogue: 0,0:17:47.98,0:17:52.19,Default,,0,0,0,,Ештеңені қорғай алмау, ештеңе қалдырмау, ештеңе істей алмай қалу
Dialogue: 0,0:17:52.27,0:17:55.32,Default,,0,0,0,,Оның жоғалып кетуін қараңыз
Dialogue: 0,0:17:56.32,0:18:00.82,Default,,0,0,0,,Мен Куросаки-кунды қорғаймын...
Dialogue: 0,0:18:00.91,0:18:04.33,Default,,0,0,0,,Мықты ерік-жігеріңді мақтаймын.
Dialogue: 0,0:18:04.41,0:18:08.96,Default,,0,0,0,,Бірақ өз күшіңізбен Ичигоны да қорғай алмайсыз.
Dialogue: 0,0:18:09.04,0:18:12.21,Default,,0,0,0,,Бірге соғысудан алыс
Dialogue: 0,0:18:12.29,0:18:14.38,Default,,0,0,0,,Сіз осындасыз.
Dialogue: 0,0:18:14.46,0:18:17.30,Default,,0,0,0,,Ичигоның пісіп-жетілмегендігінен ол өзінің тәттілігін жібере алмайды.
Dialogue: 0,0:18:17.38,0:18:18.76,Default,,0,0,0,,Юхабах!
Dialogue: 0,0:18:26.31,0:18:31.15,Default,,0,0,0,,Әй, ол әйел сенің әлсіздігің болған және солай болған.
Dialogue: 0,0:18:31.77,0:18:35.23,Default,,0,0,0,,Төбелесіңе кедергі болу ұят.
Dialogue: 0,0:18:35.32,0:18:40.24,Default,,0,0,0,,Пышақты ұстаудың себебі - қорғауға деген ұмтылыс.
Dialogue: 0,0:18:41.66,0:18:45.41,Default,,0,0,0,,Күресетіндіктен, жеңіліске ұшырайсың.
Dialogue: 0,0:18:46.37,0:18:47.50,Default,,0,0,0,,Ичиго!
Dialogue: 0,0:18:47.58,0:18:48.41,Default,,0,0,0,,Ха…
Dialogue: 0,0:18:55.00,0:18:55.50,Default,,0,0,0,,Әй!
Dialogue: 0,0:19:06.60,0:19:08.48,Default,,0,0,0,,Қандай әдемі теңдігімді бұзды!
Dialogue: 0,0:19:12.94,0:19:13.98,Default,,0,0,0,,Банкай
Dialogue: 0,0:19:15.27,0:19:16.07,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:19:19.65,0:19:21.20,Default,,0,0,0,,Ақ тұман
Dialogue: 0,0:19:27.79,0:19:31.04,Default,,0,0,0,,Гецуга Теншо!
Dialogue: 0,0:19:43.89,0:19:44.47,Default,,0,0,0,,Ха!
Dialogue: 0,0:19:52.81,0:19:53.90,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:05.28,0:20:06.07,Default,,0,0,0,,Кучики...
Dialogue: 0,0:20:09.91,0:20:10.95,Default,,0,0,0,,Ха!
Dialogue: 0,0:20:11.04,0:20:13.21,Default,,0,0,0,,Бұл қуат
Dialogue: 0,0:20:14.92,0:20:16.67,Default,,0,0,0,,Бұл ақымақтық болды.
Dialogue: 0,0:20:18.92,0:20:20.34,Default,,0,0,0,,Ичиго.
Dialogue: 0,0:20:22.30,0:20:26.72,Default,,0,0,0,,Осымен сіз айтып отырған «қорғау күші» аяқталды.
Dialogue: 0,0:20:27.55,0:20:33.48,Default,,0,0,0,,Бұл мен айтып отырған «құдіретті күштің» дәлелі.
Dialogue: 0,0:20:34.90,0:20:36.77,Default,,0,0,0,,Менің күшім
Dialogue: 0,0:20:37.90,0:20:40.98,Default,,0,0,0,,әлдеқайда көп
Dialogue: 0,0:20:42.32,0:20:43.82,Default,,0,0,0,,Үлкенірек болса...
Dialogue: 0,0:20:49.95,0:20:53.46,Default,,0,0,0,,Шаң болып жоғалып кетіңіз Урю Ишида
Dialogue: 0,0:20:55.12,0:20:58.54,Default,,0,0,0,,Хахахаха Урю Ишиданы көргендей болдым
Dialogue: 0,0:20:59.04,0:21:00.30,Default,,0,0,0,,Сіздің құпия қолыңыз
Dialogue: 0,0:21:01.46,0:21:03.30,Default,,0,0,0,,Азап қолғаптары
Dialogue: 0,0:21:03.38,0:21:06.59,Default,,0,0,0,,Енді мен келесі қадамымды көре аламын.
Dialogue: 0,0:21:07.22,0:21:10.31,Default,,0,0,0,,Мәртебелі Юхабахтың күші
Dialogue: 0,0:21:10.39,0:21:13.31,Default,,0,0,0,,Кездейсоқ пайдаланбаған дұрыс емес пе?
Dialogue: 0,0:21:14.18,0:21:15.52,Default,,0,0,0,,Ашылу болады.
Dialogue: 0,0:21:15.60,0:21:16.98,Default,,0,0,0,,Алшақтық?
Dialogue: 0,0:21:17.77,0:21:22.32,Default,,0,0,0,,Менің арқамнан алдың деп айтып тұрсың ба?
Dialogue: 0,0:21:22.40,0:21:23.36,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:21:26.36,0:21:27.74,Default,,0,0,0,,Шунзакура
Dialogue: 0,0:21:33.33,0:21:34.58,Default,,0,0,0,,Цубаки Они
Dialogue: 0,0:21:37.12,0:21:38.25,Default,,0,0,0,,Аяме
Dialogue: 0,0:21:39.17,0:21:40.46,Default,,0,0,0,,Химугику
Dialogue: 0,0:21:43.92,0:21:45.05,Default,,0,0,0,,Байгон
Dialogue: 0,0:21:45.63,0:21:46.72,Default,,0,0,0,,Лилия
Dialogue: 0,0:22:05.28,0:22:07.70,Default,,0,0,0,,Мен неге әлсізмін?
Dialogue: 0,0:22:10.28,0:22:13.58,Default,,0,0,0,,Менің күшім неге соншалықты аз?
Dialogue: 0,0:22:17.08,0:22:17.79,Default,,0,0,0,,Уф...
Dialogue: 0,0:22:18.83,0:22:20.17,Default,,0,0,0,,Жұлдызды шаң (Sternenstaub)!
Dialogue: 0,0:22:21.00,0:22:22.34,Default,,0,0,0,,Көрінетін
Dialogue: 0,0:22:24.76,0:22:25.76,Default,,0,0,0,,Уф!
Dialogue: 0,0:22:25.84,0:22:28.26,Default,,0,0,0,,- (Хашвальд) Сіз... - (Исида) 3 секунд.
Dialogue: 0,0:22:28.34,0:22:31.09,Default,,0,0,0,,Мені қашып бара жатқандай көрсең
Dialogue: 0,0:22:31.18,0:22:33.31,Default,,0,0,0,,Сондықтан сіз жеңілдіңіз.
Dialogue: 0,0:22:33.39,0:22:37.68,Default,,0,0,0,,Болашақты көру мүмкіндігін пайдаланғаннан кейін, сіз бұл қуатты 3 секунд бойы пайдалана алмайсыз.
Dialogue: 0,0:22:38.27,0:22:41.15,Default,,0,0,0,,Бар болғаны 3 секундта жеңу мүмкіндігіңіз жоқ!
Dialogue: 0,0:22:41.23,0:22:41.94,Default,,0,0,0,,Ха!
Dialogue: 0,0:22:44.02,0:22:45.90,Default,,0,0,0,,Бірақ бұл небәрі 3 секунд.
Dialogue: 0,0:22:50.16,0:22:52.16,Default,,0,0,0,,♪～
Dialogue: 0,0:22:53.41,0:22:56.12,Default,,0,0,0,,Менің күшім болса
Dialogue: 0,0:22:57.33,0:23:00.50,Default,,0,0,0,,Егер ол әлдеқайда үлкен болса...
Dialogue: 0,0:23:02.58,0:23:05.09,Default,,0,0,0,,Менің қолымнан келгеннен де көп
Dialogue: 0,0:23:05.96,0:23:08.22,Default,,0,0,0,,Егер ол шексіз үлкен болса...
Dialogue: 0,0:23:13.22,0:23:16.35,Default,,0,0,0,,Бүкіл әлемді қоршап алу
Dialogue: 0,0:23:16.93,0:23:21.27,Default,,0,0,0,,Шайқас, азап және азап
Dialogue: 0,0:23:22.65,0:23:26.78,Default,,0,0,0,,Мен ештеңе болмағандай кейіп танытуым мүмкін еді.
Dialogue: 0,0:23:40.21,0:23:43.42,Default,,0,0,0,,Сондықтан мен...
Dialogue: 0,0:23:44.50,0:23:48.17,Default,,0,0,0,,Орихиме Иноуэ, сен өз өміріңді тастайсың ба?
Dialogue: 0,0:23:58.18,0:23:59.35,Default,,0,0,0,,Осындай нәрсемен...!
Dialogue: 0,0:23:59.43,0:24:03.15,Default,,0,0,0,,Осындай нәрсемен сіздің күшіңіз жоғалады!
Dialogue: 0,0:24:14.24,0:24:15.16,Default,,0,0,0,,Күтіңіз...
Dialogue: 0,0:24:17.45,0:24:18.41,Default,,0,0,0,,Инау!
Dialogue: 0,0:24:18.99,0:24:21.25,Default,,0,0,0,,Ino... Ue...
Dialogue: 0,0:24:50.48,0:24:52.49,Default,,0,0,0,,～♪
Dialogue: 0,0:25:10.59,0:25:12.71,Default,,0,0,0,,Сау бол Куросаки-кун
Dialogue: 0,0:25:13.26,0:25:16.64,Default,,0,0,0,,Мен бәрін қабылдаймын.
Dialogue: 0,0:25:18.14,0:25:24.14,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
