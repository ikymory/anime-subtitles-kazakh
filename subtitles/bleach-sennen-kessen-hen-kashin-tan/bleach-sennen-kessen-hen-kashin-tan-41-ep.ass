Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.50,0:00:03.50,Default,,0,0,0,,♪～
Dialogue: 0,0:00:25.81,0:00:27.81,Default,,0,0,0,,～♪
Dialogue: 0,0:00:30.98,0:00:32.40,Default,,0,0,0,,Таң ба?
Dialogue: 0,0:00:33.40,0:00:35.16,Default,,0,0,0,,Бұл жақсы арман
Dialogue: 0,0:00:42.08,0:00:46.17,Default,,0,0,0,,Түстер қорқынышты түс сияқты керемет
Dialogue: 0,0:00:48.17,0:00:49.71,Default,,0,0,0,,Көрінетін
Dialogue: 0,0:00:50.80,0:00:54.30,Default,,0,0,0,,Мен сенің қиналғаныңды көріп тұрмын.
Dialogue: 0,0:00:55.18,0:00:59.10,Default,,0,0,0,,Бұл менің жоғалтым... Гюго
Dialogue: 0,0:01:00.01,0:01:03.52,Default,,0,0,0,,Мен сенің адалдығыңды көремін.
Dialogue: 0,0:01:04.10,0:01:07.85,Default,,0,0,0,,Қараңғыда туған балам.
Dialogue: 0,0:01:09.90,0:01:11.36,Default,,0,0,0,,Кел
Dialogue: 0,0:01:14.24,0:01:18.24,Default,,0,0,0,,Мені ешкім тоқтата алмайды
Dialogue: 0,0:01:20.49,0:01:22.49,Default,,0,0,0,,♪～
Dialogue: 0,0:02:47.95,0:02:49.96,Default,,0,0,0,,～♪
Dialogue: 0,0:03:23.03,0:03:24.91,Default,,0,0,0,,Оның күші
Dialogue: 0,0:03:24.99,0:03:27.62,Default,,0,0,0,,Жухабах ұйықтап жатқанда ғана ауыстырылады
Dialogue: 0,0:03:27.70,0:03:28.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:28.70,0:03:29.45,Default,,0,0,0,,Иә.
Dialogue: 0,0:03:29.54,0:03:33.12,Default,,0,0,0,,Енді Юхабахтың «бәрін білу» күші жоқ.
Dialogue: 0,0:03:33.63,0:03:36.04,Default,,0,0,0,,Юхабах Нағыз әлем сарайының (Вахлвельт) шыңында.
Dialogue: 0,0:03:36.54,0:03:38.46,Default,,0,0,0,,Куросакиді жоғары көтеріңіз
Dialogue: 0,0:03:38.55,0:03:39.84,Default,,0,0,0,,Ишида…
Dialogue: 0,0:03:39.92,0:03:42.80,Default,,0,0,0,,Сіз әлі де осындасыз ба?
Dialogue: 0,0:03:42.88,0:03:45.72,Default,,0,0,0,,Бірақ оның Юхабах күші болмаса
Dialogue: 0,0:03:45.80,0:03:47.56,Default,,0,0,0,,- (Ичиго) Әсіресе... - (Ишида) Көп сөйлеме.
Dialogue: 0,0:03:47.64,0:03:48.97,Default,,0,0,0,,Бізге Токио ұнайды! (Фушигуро) Ә?
Dialogue: 0,0:03:50.10,0:03:52.19,Default,,0,0,0,,Бұл менің соңғы сөзім емес.
Dialogue: 0,0:04:15.96,0:04:17.00,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:17.59,0:04:18.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:18.63,0:04:20.63,Default,,0,0,0,,Амансың ба? Инуэ
Dialogue: 0,0:04:20.71,0:04:21.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:21.59,0:04:23.63,Default,,0,0,0,,Иә, бәрібір
Dialogue: 0,0:04:23.72,0:04:27.35,Default,,0,0,0,,Мен бұл туралы біраз жеңілдеп қалдым.
Dialogue: 0,0:04:27.43,0:04:28.26,Default,,0,0,0,,Жан тыныштығы?
Dialogue: 0,0:04:29.60,0:04:31.72,Default,,0,0,0,,Иә, мен...
Dialogue: 0,0:04:32.43,0:04:35.77,Default,,0,0,0,,Ишида-кунның шынымен Квинсиге барғанына сене алар емеспін.
Dialogue: 0,0:04:35.85,0:04:37.86,Default,,0,0,0,,Бұл мен ойлағандай емес...
Dialogue: 0,0:04:39.02,0:04:43.95,Default,,0,0,0,,Бірақ оны Ишида-кунның аузынан естіп, жеңілдеп қалдым.
Dialogue: 0,0:04:44.03,0:04:49.53,Default,,0,0,0,,А, мен ойладым, Ишида-кун Ишида-кун болды ғой...
Dialogue: 0,0:04:52.95,0:04:54.00,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:04:54.08,0:04:54.87,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:55.58,0:04:56.25,Default,,0,0,0,,Әй!
Dialogue: 0,0:04:56.75,0:04:58.13,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:05:00.59,0:05:01.21,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:02.55,0:05:04.13,Default,,0,0,0,,Хе... Хе!
Dialogue: 0,0:05:12.14,0:05:13.52,Default,,0,0,0,,- (Ичиго) Чад! -(Орихиме) Садо-кун!
Dialogue: 0,0:05:13.60,0:05:16.02,Default,,0,0,0,,Менде бәрі жақсы. Бар!
Dialogue: 0,0:05:18.52,0:05:19.27,Default,,0,0,0,,Иә
Dialogue: 0,0:05:23.36,0:05:25.78,Default,,0,0,0,,Енді... орындаймыз ба?
Dialogue: 0,0:05:27.20,0:05:28.87,Default,,0,0,0,,Құмға түс!
Dialogue: 0,0:05:28.95,0:05:29.57,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:31.12,0:05:33.20,Default,,0,0,0,,Қайда болдың, Иваваси?
Dialogue: 0,0:05:33.29,0:05:35.25,Default,,0,0,0,,«Қайда болдың?» емес.
Dialogue: 0,0:05:35.33,0:05:37.42,Default,,0,0,0,,Мені сонда қалдырған сол.
Dialogue: 0,0:05:37.50,0:05:39.96,Default,,0,0,0,,Мен бөлектеніп, адасып қалдым.
Dialogue: 0,0:05:40.04,0:05:43.67,Default,,0,0,0,,Сол кезде мен мына бір жан түршігерлік көрініске тап болдым.
Dialogue: 0,0:05:43.76,0:05:46.05,Default,,0,0,0,,Тас мүсіндер қандай топқа жатады?
Dialogue: 0,0:05:46.13,0:05:48.47,Default,,0,0,0,,Тас толқыным күркіреді
Dialogue: 0,0:05:48.55,0:05:50.64,Default,,0,0,0,,Тыңдаңыз!
Dialogue: 0,0:05:50.72,0:05:51.43,Default,,0,0,0,,Мен тыңдаймын
Dialogue: 0,0:05:51.51,0:05:52.93,Default,,0,0,0,,Сіз тыңдап жатырсыз ба?
Dialogue: 0,0:05:53.01,0:05:55.68,Default,,0,0,0,,Олай болса маған реакция беріңізші!
Dialogue: 0,0:05:55.77,0:05:56.77,Default,,0,0,0,,Иә
Dialogue: 0,0:05:57.64,0:06:00.65,Default,,0,0,0,,Қара жұмысты ұнатасың ба? Иваваси
Dialogue: 0,0:06:01.27,0:06:01.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:03.27,0:06:05.99,Default,,0,0,0,,Ичиго тек алға қарай жолды көреді.
Dialogue: 0,0:06:06.49,0:06:07.40,Default,,0,0,0,,Ол сондай жігіт.
Dialogue: 0,0:06:08.53,0:06:12.87,Default,,0,0,0,,Біздің жұмысымыз қамалдың ішін тазалау.
Dialogue: 0,0:06:12.95,0:06:15.50,Default,,0,0,0,,Ичигоның үйіне баратын жолын дайында.
Dialogue: 0,0:06:16.00,0:06:17.12,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:06:31.18,0:06:35.60,Default,,0,0,0,,Хашвальд болашақты толық болжай алмайды.
Dialogue: 0,0:06:35.68,0:06:38.89,Default,,0,0,0,,Мен таң қалдым Урю Ишида
Dialogue: 0,0:06:38.98,0:06:41.60,Default,,0,0,0,,Бұрынғыдан басқа адам сияқты.
Dialogue: 0,0:06:42.15,0:06:45.90,Default,,0,0,0,,Сіз дәл қазір өте үмітті көрінесіз.
Dialogue: 0,0:06:46.40,0:06:47.49,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:06:47.99,0:06:51.57,Default,,0,0,0,,Шындық, үмітке толы ма, жоқ па,
Dialogue: 0,0:06:52.16,0:06:54.58,Default,,0,0,0,,Сонда сіз мұны көргенде таң қалдыңыз ба?
Dialogue: 0,0:06:55.08,0:06:59.21,Default,,0,0,0,,Үмітке толы болғаным сонша, көре алмадым.
Dialogue: 0,0:07:01.54,0:07:05.67,Default,,0,0,0,,Ол кезде ол растаған да, жоққа шығарған да жоқ.
Dialogue: 0,0:07:10.68,0:07:12.55,Default,,0,0,0,,Мен айтар едім
Dialogue: 0,0:07:13.05,0:07:15.35,Default,,0,0,0,,Мен бәрін көремін
Dialogue: 0,0:07:23.65,0:07:25.86,Default,,0,0,0,,Олай болса, сіз қаншалықты алысты көре аласыз?
Dialogue: 0,0:07:25.94,0:07:28.07,Default,,0,0,0,,Тек көз жеткізіңіз
Dialogue: 0,0:07:42.87,0:07:43.37,Default,,0,0,0,,Ха!
Dialogue: 0,0:07:47.75,0:07:51.55,Default,,0,0,0,,Дұрыс емес Сіз әлі де бәрін көре аласыз ба?
Dialogue: 0,0:07:57.93,0:08:03.69,Default,,0,0,0,,Арқаңызды қабырғаға немесе төбеге қойып, менің шабуылымның ауқымын қысқартып жатқан сияқтысыз.
Dialogue: 0,0:08:04.19,0:08:07.06,Default,,0,0,0,,Тек алда болатын нәрсеге назар аудару керек екені рас.
Dialogue: 0,0:08:07.57,0:08:11.69,Default,,0,0,0,,Мен сені Урю Ишидамен ойланып, күрескенің үшін мақтаймын
Dialogue: 0,0:08:11.78,0:08:15.24,Default,,0,0,0,,Күтілгендей, тек ең жоғары дәрежелі (Гранд Мастер) жасай алатын нәрселер бар.
Dialogue: 0,0:08:15.32,0:08:18.28,Default,,0,0,0,,Бірақ мені мақтаса да риза емеспін.
Dialogue: 0,0:08:28.75,0:08:29.50,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:30.13,0:08:33.05,Default,,0,0,0,,Сенің өмірің менің қолымда.
Dialogue: 0,0:08:37.18,0:08:37.72,Default,,0,0,0,,Уф!
Dialogue: 0,0:08:47.81,0:08:48.81,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:08:49.52,0:08:53.86,Default,,0,0,0,,Енді мен ұлы мәртебелі құдіретке толдым.
Dialogue: 0,0:08:53.95,0:08:57.41,Default,,0,0,0,,Менен бұл күшті тартып алу мүмкін емес.
Dialogue: 0,0:08:57.49,0:08:58.32,Default,,0,0,0,,Аһ!
Dialogue: 0,0:08:58.41,0:09:02.58,Default,,0,0,0,,Урю Ишида Сен мен бола алмайсың
Dialogue: 0,0:09:02.66,0:09:04.75,Default,,0,0,0,,Мен ұлы мәртебелілердің екінші жартысымын.
Dialogue: 0,0:09:04.83,0:09:08.33,Default,,0,0,0,,Мен Мәртебелімен бірге болу үшін туған Квинсимін.
Dialogue: 0,0:09:08.42,0:09:12.76,Default,,0,0,0,,Сондықтан ұлы мәртебелі өз билігін маған сеніп тапсырды.
Dialogue: 0,0:09:12.84,0:09:14.59,Default,,0,0,0,,Уф... уф...
Dialogue: 0,0:09:15.55,0:09:19.26,Default,,0,0,0,,Сіз оны көре аласыз ба? енді не болмақ
Dialogue: 0,0:09:21.76,0:09:22.60,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:23.10,0:09:25.60,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:09:26.69,0:09:29.06,Default,,0,0,0,,Бұл ұлы мәртебелі шын тілегі.
Dialogue: 0,0:09:30.65,0:09:32.15,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:09:32.23,0:09:35.53,Default,,0,0,0,,Джинта үйге жүгірді!
Dialogue: 0,0:09:40.12,0:09:43.66,Default,,0,0,0,,Бұл не? Сол жарықшақ кетіп қалды
Dialogue: 0,0:09:44.25,0:09:47.92,Default,,0,0,0,,Бұл Кисуке зерттеген «бұрмалау» сияқты.
Dialogue: 0,0:09:48.50,0:09:49.50,Default,,0,0,0,,Бір минут күтіңіз.
Dialogue: 0,0:09:49.58,0:09:52.80,Default,,0,0,0,,Бұрмалау - бұл ақылсыз энергияның шоғыры.
Dialogue: 0,0:09:52.88,0:09:55.46,Default,,0,0,0,,Дүкен басшылары түзетпеді ме?
Dialogue: 0,0:09:55.55,0:09:58.51,Default,,0,0,0,,Бұл болуы керек... бірақ...
Dialogue: 0,0:09:58.59,0:10:01.43,Default,,0,0,0,,Бұл жынды емес пе? осы қала
Dialogue: 0,0:10:01.51,0:10:03.01,Default,,0,0,0,,Не, мына дүние?
Dialogue: 0,0:10:03.10,0:10:04.22,Default,,0,0,0,,Сәлем? Тессай
Dialogue: 0,0:10:05.93,0:10:07.23,Default,,0,0,0,,Ах… Уф…
Dialogue: 0,0:10:09.94,0:10:12.36,Default,,0,0,0,,Адалдық... сонда?
Dialogue: 0,0:10:12.44,0:10:16.03,Default,,0,0,0,,үшін ұлы мәртебелі жоспар бойынша жүріп жатыр.
Dialogue: 0,0:10:16.11,0:10:19.32,Default,,0,0,0,,Біз Жан қоғамына басып кіргеннен бері.
Dialogue: 0,0:10:19.82,0:10:25.49,Default,,0,0,0,,Бұл дүниедегі бос орындардың көп мөлшерін жою және жанның тепе-теңдігін айтарлықтай бұзу
Dialogue: 0,0:10:26.33,0:10:30.42,Default,,0,0,0,,Көптеген Шинигами біздің шабуылымызға алданып қалды.
Dialogue: 0,0:10:30.50,0:10:34.71,Default,,0,0,0,,Генрюсай Ямамото және одан кейінгі нөлдік отрядтың қайтыс болуымен
Dialogue: 0,0:10:34.80,0:10:39.68,Default,,0,0,0,,Бұл дүниенің тепе-теңдігі қатты және қатты шайқалды.
Dialogue: 0,0:10:40.26,0:10:45.60,Default,,0,0,0,,Және де үш әлемнің сынасы болған Рух патшасы ұлы мәртебелі құдіретінің бір бөлігі болды.
Dialogue: 0,0:10:46.60,0:10:50.85,Default,,0,0,0,,Бұл алауыздық үш дүниенің жойылуының алғышарттары болады.
Dialogue: 0,0:10:51.48,0:10:53.36,Default,,0,0,0,,Әлемнің жойылуы…
Dialogue: 0,0:10:55.15,0:10:57.53,Default,,0,0,0,,Сен не істемексің?
Dialogue: 0,0:10:58.03,0:10:59.82,Default,,0,0,0,,Сіз де естіген боларсыз.
Dialogue: 0,0:11:00.91,0:11:01.82,Default,,0,0,0,,Әлем (верт)
Dialogue: 0,0:11:03.91,0:11:06.29,Default,,0,0,0,,Шынайы дүниенің құрылуы
Dialogue: 0,0:11:06.87,0:11:08.66,Default,,0,0,0,,Үш әлемді де құрту
Dialogue: 0,0:11:08.75,0:11:12.58,Default,,0,0,0,,Квинси үшін және сол жерде патшалық құрыңыз
Dialogue: 0,0:11:13.08,0:11:15.46,Default,,0,0,0,,Бұл Ұлы мәртебелілердің шынайы тілегі.
Dialogue: 0,0:11:15.54,0:11:19.17,Default,,0,0,0,,Жұлдызды крест рыцарларының (Sternritter) өз отандастарына өнер көрсету міндеті.
Dialogue: 0,0:11:20.93,0:11:24.93,Default,,0,0,0,,Мен сені көргенде сен жоқсың
Dialogue: 0,0:11:27.89,0:11:29.93,Default,,0,0,0,,Сатқындарды жазалау...
Dialogue: 0,0:11:31.64,0:11:33.48,Default,,0,0,0,,Бұл менің рөлім.
Dialogue: 0,0:11:36.57,0:11:37.44,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:11:42.86,0:11:45.83,Default,,0,0,0,,Сіз Мәртебелі үшін сөйлеп тұрған сияқтысыз.
Dialogue: 0,0:11:47.91,0:11:52.58,Default,,0,0,0,,Сіздің айтқаныңызды естігеннен кейін, менде көп жұмыс бар.
Dialogue: 0,0:11:53.21,0:11:57.63,Default,,0,0,0,,Бірі - сені жеңіп, бәрін білу мен құдіретті жою.
Dialogue: 0,0:11:58.13,0:12:02.13,Default,,0,0,0,,Басқа нәрсе - бұл алшақтықты жою.
Dialogue: 0,0:12:02.68,0:12:04.93,Default,,0,0,0,,Үш дүниені қорғау
Dialogue: 0,0:12:18.23,0:12:20.07,Default,,0,0,0,,Аа...
Dialogue: 0,0:12:20.15,0:12:23.65,Default,,0,0,0,,Маған қашуға да тура келмеді...
Dialogue: 0,0:12:31.25,0:12:33.41,Default,,0,0,0,,Өлме
Dialogue: 0,0:12:33.91,0:12:35.58,Default,,0,0,0,,Бұл тым қауіпті. Соған қарамастан, шкафта жасырынғаным дұрыс
Dialogue: 0,0:12:35.67,0:12:38.84,Default,,0,0,0,,Мен өлімнен алыстап бара жатқандай сезінемін.
Dialogue: 0,0:12:38.92,0:12:43.51,Default,,0,0,0,,Егер «иммунитет» өлімнен сақтанудың соңғы жолы болса
Dialogue: 0,0:12:43.59,0:12:46.84,Default,,0,0,0,,Қызық, бұл да иммунитетке байланысты ма?
Dialogue: 0,0:12:47.97,0:12:49.56,Default,,0,0,0,,Мен іздегенім – қан емес.
Dialogue: 0,0:12:50.14,0:12:52.31,Default,,0,0,0,,Шикаэдейн Йоруичи
Dialogue: 0,0:12:53.89,0:12:55.60,Default,,0,0,0,,Ой, кешіріңіз.
Dialogue: 0,0:12:56.10,0:12:58.77,Default,,0,0,0,,Мен тыңдамадым, өйткені ол өз-өзімен сөйлеседі деп ойладым.
Dialogue: 0,0:12:58.86,0:13:02.03,Default,,0,0,0,,«Мен оны ести алмадым» қате, солай ма?
Dialogue: 0,0:13:02.11,0:13:06.07,Default,,0,0,0,,Сізде, Рейко, оттегі мен азоттан тұратын гибридті улы шар (сыйлық доп) бар.
Dialogue: 0,0:13:06.16,0:13:07.32,Default,,0,0,0,,Мен оны лақтырдым.
Dialogue: 0,0:13:07.82,0:13:11.62,Default,,0,0,0,,Мағынасыз монологтарды тыңдауға мүмкіндігім жоқ.
Dialogue: 0,0:13:11.70,0:13:12.54,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:13:13.12,0:13:16.92,Default,,0,0,0,,Шынымды айтсам, ол мұндай күйде өлмейді деп ойлаймын.
Dialogue: 0,0:13:17.00,0:13:18.42,Default,,0,0,0,,Сіз солсыз
Dialogue: 0,0:13:18.92,0:13:21.80,Default,,0,0,0,,«Өлімге әкелетін дозамен» сонша айналыса отырып,
Dialogue: 0,0:13:21.88,0:13:25.34,Default,,0,0,0,,Өмір мен өлім қауіпсіздігіне түзету дегеніміз не?
Dialogue: 0,0:13:25.84,0:13:27.89,Default,,0,0,0,,Шынымды айтсам, олай ойламаймын.
Dialogue: 0,0:13:27.97,0:13:30.01,Default,,0,0,0,,Бұл басқаша.
Dialogue: 0,0:13:30.10,0:13:32.56,Default,,0,0,0,,Мен қолымнан келгеннің бәрін істеп жатырмын.
Dialogue: 0,0:13:32.64,0:13:35.23,Default,,0,0,0,,Сен болмасаң, баяғыда өліп кетер едім.
Dialogue: 0,0:13:36.81,0:13:39.73,Default,,0,0,0,,Мен құбыжықпын, сөреге қойыңыз
Dialogue: 0,0:13:39.81,0:13:41.65,Default,,0,0,0,,Мен жылым деп айтасың.
Dialogue: 0,0:13:41.73,0:13:43.73,Default,,0,0,0,,Сіз тоқтайсыз ба?
Dialogue: 0,0:13:43.82,0:13:45.07,Default,,0,0,0,,Ауырады
Dialogue: 0,0:13:47.66,0:13:50.83,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:13:52.95,0:13:55.79,Default,,0,0,0,,Юуширо ол сияқты ұзаққа бармайды.
Dialogue: 0,0:13:56.29,0:14:00.00,Default,,0,0,0,,Жага, бұл күйімде мен сені өз күшіммен де емдей алмаймын.
Dialogue: 0,0:14:00.08,0:14:00.96,Default,,0,0,0,,Мен шайқаса аламын!
Dialogue: 0,0:14:01.04,0:14:02.46,Default,,0,0,0,,Мұндай уақыт бірлігі қалай?
Dialogue: 0,0:14:03.13,0:14:03.96,Default,,0,0,0,,Бұл ысырап.
Dialogue: 0,0:14:04.05,0:14:04.67,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:14:05.17,0:14:08.13,Default,,0,0,0,,Мен не жоспарлап отырғаныңызды білмеймін.
Dialogue: 0,0:14:08.22,0:14:12.85,Default,,0,0,0,,Сіз өлімге жақынсыз, осы уақытқа дейін әрекет ете алмайсыз.
Dialogue: 0,0:14:14.43,0:14:16.98,Default,,0,0,0,,Қазір не істесеңіз де
Dialogue: 0,0:14:17.06,0:14:19.44,Default,,0,0,0,,Мен бірінші қадамды жасай алатыныма сенімдімін.
Dialogue: 0,0:14:19.52,0:14:22.48,Default,,0,0,0,,Бұл өлімге әкеледі деп ойламайсыз ба?
Dialogue: 0,0:14:22.57,0:14:24.90,Default,,0,0,0,,Сәлем? Йоруичи Шикаэдейн
Dialogue: 0,0:14:24.98,0:14:25.82,Default,,0,0,0,,Әрине
Dialogue: 0,0:14:25.90,0:14:26.61,Default,,0,0,0,,Әй!
Dialogue: 0,0:14:26.69,0:14:29.20,Default,,0,0,0,,Бұл өлімге әкелетін тістеу, Йоруичи-сан.
Dialogue: 0,0:14:29.28,0:14:31.24,Default,,0,0,0,,Гах... менің иегім ауырып тұр!
Dialogue: 0,0:14:31.32,0:14:33.87,Default,,0,0,0,,Мен саған көмектесуге келгеніммен неге мені тептің?
Dialogue: 0,0:14:33.95,0:14:36.12,Default,,0,0,0,,Неліктен өзіңізді теппеймін деп ойладыңыз?
Dialogue: 0,0:14:36.20,0:14:38.54,Default,,0,0,0,,Мынаны қара! Менің есегімнен көзіңді ал!
Dialogue: 0,0:14:38.62,0:14:40.21,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:14:40.29,0:14:43.59,Default,,0,0,0,,«Тістеп» деген сөзіңіз дөрекі болғаны рас.
Dialogue: 0,0:14:43.67,0:14:45.50,Default,,0,0,0,,Мен сені тепкенім үшін емес!
Dialogue: 0,0:14:45.59,0:14:47.38,Default,,0,0,0,,Кешірім сұрап жатқанда бөксесіме тиіспе!
Dialogue: 0,0:14:47.46,0:14:52.14,Default,,0,0,0,,Кисуке Урахара, тағы бір қиыншылық болды.
Dialogue: 0,0:14:52.97,0:14:54.93,Default,,0,0,0,,О, сен білесің.
Dialogue: 0,0:14:55.01,0:14:56.35,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:14:56.43,0:15:00.10,Default,,0,0,0,,Мен бұл туралы ештеңе білмеймін.
Dialogue: 0,0:15:00.19,0:15:04.44,Default,,0,0,0,,Сіз ұлы мәртебелі әмір берген арнайы жасақтың бірісіз.
Dialogue: 0,0:15:04.52,0:15:07.57,Default,,0,0,0,,Мені осындай үлкен орынға қойғаныңыз үшін рахмет.
Dialogue: 0,0:15:07.65,0:15:09.19,Default,,0,0,0,,Мен осындамын.
Dialogue: 0,0:15:09.70,0:15:12.16,Default,,0,0,0,,Абыроймын, бірақ мен оны сатып аламын.
Dialogue: 0,0:15:12.66,0:15:15.12,Default,,0,0,0,,Сәлем? Йоруичи-сан
Dialogue: 0,0:15:18.08,0:15:19.25,Default,,0,0,0,,(Керс) Тас масканың бұл сүйек инесі адам миын тесіп өтуге қауқарлы.
Dialogue: 0,0:15:21.25,0:15:23.54,Default,,0,0,0,,Сіз не істедіңіз?
Dialogue: 0,0:15:23.63,0:15:26.09,Default,,0,0,0,,Неліктен Йоруичи Шикаэдейн қозғала алады?
Dialogue: 0,0:15:26.17,0:15:28.42,Default,,0,0,0,,Менің «өлтіретін дозамды» алып тастадыңыз ба?
Dialogue: 0,0:15:28.51,0:15:29.80,Default,,0,0,0,,Бұл тек бұршақ мылтық, бірақ… Марли әскерінің қарсы шабуылының сигналы
Dialogue: 0,0:15:31.88,0:15:34.80,Default,,0,0,0,,Жоқ, дәл мен естігенімдей.
Dialogue: 0,0:15:35.72,0:15:39.35,Default,,0,0,0,,Бес арнайы жасақ «белгісіз» ретінде таңдалды.
Dialogue: 0,0:15:39.43,0:15:41.77,Default,,0,0,0,,Ичиго Куросакиде «әлеует» бар
Dialogue: 0,0:15:42.35,0:15:44.48,Default,,0,0,0,,Кенпачи Зараки «жауынгерлік күшке» ие
Dialogue: 0,0:15:44.56,0:15:47.15,Default,,0,0,0,,Хёшубу Ичибей – «даналық»
Dialogue: 0,0:15:47.23,0:15:49.86,Default,,0,0,0,,Сосуке Айзеннің «Рейацу» бар
Dialogue: 0,0:15:50.36,0:15:55.03,Default,,0,0,0,,Ал Кисуке Урахара - белгісіз «құралдар»
Dialogue: 0,0:15:55.12,0:15:59.83,Default,,0,0,0,,Қанша тырыссақ та, біз әрқашан сізден озамыз.
Dialogue: 0,0:15:59.91,0:16:02.54,Default,,0,0,0,,Тегіс шығу үшін схемалар саны
Dialogue: 0,0:16:03.17,0:16:06.54,Default,,0,0,0,,А, бұл мен ғанамын...
Dialogue: 0,0:16:06.63,0:16:09.55,Default,,0,0,0,,Бұл соншалықты қиын болса да, бәрібір болады.
Dialogue: 0,0:16:16.43,0:16:18.14,Default,,0,0,0,,Бөксеге не салдыңыз?
Dialogue: 0,0:16:18.22,0:16:19.22,Default,,0,0,0,,О...
Dialogue: 0,0:16:19.89,0:16:21.39,Default,,0,0,0,,Сенімсіз
Dialogue: 0,0:16:21.48,0:16:24.35,Default,,0,0,0,,Мен мұны көбіне ертегіні тыңдап отырып жасырын жасадым.
Dialogue: 0,0:16:24.44,0:16:27.65,Default,,0,0,0,,Иммунитетті күшейтетін құрал... Менің ойымша, бұл осындай нәрсе.
Dialogue: 0,0:16:27.73,0:16:31.03,Default,,0,0,0,,Йоруичи-сан күткендей, сіз тез түсінесіз.
Dialogue: 0,0:16:31.11,0:16:34.03,Default,,0,0,0,,Ол асығыс жасалғандықтан, әсері қысқа.
Dialogue: 0,0:16:34.11,0:16:34.91,Default,,0,0,0,,Қанша?
Dialogue: 0,0:16:35.82,0:16:37.41,Default,,0,0,0,,Шамамен 5 минут.
Dialogue: 0,0:16:38.16,0:16:38.91,Default,,0,0,0,,Жеткілікті
Dialogue: 0,0:16:38.99,0:16:40.33,Default,,0,0,0,,Шункан!
Dialogue: 0,0:16:40.95,0:16:43.33,Default,,0,0,0,,- (Йоичи) Райджин Сенгата... - (Урахара) Күте тұрыңыз, Йоруичи-сан.
Dialogue: 0,0:16:43.41,0:16:46.00,Default,,0,0,0,,Уау! Сонымен, сізге әлі де бір нәрсе керек пе?
Dialogue: 0,0:16:46.63,0:16:48.34,Default,,0,0,0,,Мұны істейік
Dialogue: 0,0:16:48.42,0:16:49.59,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:16:49.67,0:16:51.71,Default,,0,0,0,,Бұл бірден жауап емес пе?
Dialogue: 0,0:16:51.80,0:16:55.18,Default,,0,0,0,,Маған көбірек түсіндіруге немесе келіссөздер жүргізуге рұқсат етіңіз.
Dialogue: 0,0:16:55.76,0:16:58.76,Default,,0,0,0,,Мұндай жарымжан, сұмдық түр.
Dialogue: 0,0:16:58.85,0:16:59.76,Default,,0,0,0,,Бұл қайталана ма?
Dialogue: 0,0:16:59.85,0:17:02.56,Default,,0,0,0,,Түсіндім... Өте өкінішті.
Dialogue: 0,0:17:03.06,0:17:05.35,Default,,0,0,0,,Жарайды, мен мұны қаламаймын, бірақ мен өзімді...
Dialogue: 0,0:17:08.48,0:17:10.65,Default,,0,0,0,,Ой, кешіріңіз, сіз оны жойдыңыз ба?
Dialogue: 0,0:17:12.99,0:17:13.99,Default,,0,0,0,,Әй!
Dialogue: 0,0:17:14.82,0:17:15.95,Default,,0,0,0,,Міне
Dialogue: 0,0:17:16.45,0:17:18.95,Default,,0,0,0,,Қозғалыс жасай білу
Dialogue: 0,0:17:19.03,0:17:20.91,Default,,0,0,0,,Көңіл көтеру жақсы!
Dialogue: 0,0:17:20.99,0:17:22.08,Default,,0,0,0,,Уф!
Dialogue: 0,0:17:22.16,0:17:23.12,Default,,0,0,0,,Гррр…
Dialogue: 0,0:17:25.87,0:17:27.42,Default,,0,0,0,,Сізге тамаша жағдайда
Dialogue: 0,0:17:27.50,0:17:29.46,Default,,0,0,0,,Сыйлық тақтасы Оны лақтырған маған
Dialogue: 0,0:17:29.54,0:17:31.34,Default,,0,0,0,,Қанша сауығып кетсеңіз де
Dialogue: 0,0:17:31.42,0:17:34.84,Default,,0,0,0,,Енді жеңу мүмкін емес деп ойлайсыз ба?
Dialogue: 0,0:17:34.92,0:17:37.38,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:17:37.47,0:17:39.43,Default,,0,0,0,,Йоруичи-сан
Dialogue: 0,0:17:42.85,0:17:44.06,Default,,0,0,0,,Хехехе
Dialogue: 0,0:17:44.56,0:17:45.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:51.15,0:17:53.36,Default,,0,0,0,,Уф! Гехо Гехо...
Dialogue: 0,0:17:53.44,0:17:55.36,Default,,0,0,0,,Не? Не болды?
Dialogue: 0,0:17:57.45,0:17:58.61,Default,,0,0,0,,Уф!
Dialogue: 0,0:18:03.70,0:18:07.12,Default,,0,0,0,,Жоқ... бұл қандай көрініс?
Dialogue: 0,0:18:07.21,0:18:09.63,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:18:09.71,0:18:12.63,Default,,0,0,0,,Не деген... елеусіз қалдырмаңыз
Dialogue: 0,0:18:13.46,0:18:15.63,Default,,0,0,0,,Шункан Райджу шайқас формасы
Dialogue: 0,0:18:15.71,0:18:18.01,Default,,0,0,0,,Шунпо Қара мысық Сенки
Dialogue: 0,0:18:18.55,0:18:19.22,Default,,0,0,0,,...шығарылым
Dialogue: 0,0:18:20.51,0:18:22.47,Default,,0,0,0,,“ssu” емес…
Dialogue: 0,0:18:22.55,0:18:24.47,Default,,0,0,0,,Неге жауап бермейсің?
Dialogue: 0,0:18:25.06,0:18:26.48,Default,,0,0,0,,<Ал сол адам маған айтты>
Dialogue: 0,0:18:26.56,0:18:28.27,Default,,0,0,0,,А? Мүмкін...
Dialogue: 0,0:18:28.77,0:18:31.48,Default,,0,0,0,,Қазір ол адаммен сөйлесе алмайсыз ба?
Dialogue: 0,0:18:31.56,0:18:32.98,Default,,0,0,0,,Ха…
Dialogue: 0,0:18:33.07,0:18:34.36,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:18:42.53,0:18:44.54,Default,,0,0,0,,Бұл өтірік!
Dialogue: 0,0:18:44.62,0:18:45.95,Default,,0,0,0,,Тынш!
Dialogue: 0,0:18:52.79,0:18:54.29,Default,,0,0,0,,Неге!
Dialogue: 0,0:18:54.38,0:18:57.84,Default,,0,0,0,,Оның рейатсу иммунитетке ие болуы керек еді.
Dialogue: 0,0:18:57.92,0:19:01.39,Default,,0,0,0,,Сол Шинигамидің рейатсуының жарты жолда өзгеруі мүмкін емес.
Dialogue: 0,0:19:01.47,0:19:02.85,Default,,0,0,0,,Не айтып тұрсың!
Dialogue: 0,0:19:02.93,0:19:04.26,Default,,0,0,0,,Маған ұнайды
Dialogue: 0,0:19:04.35,0:19:04.85,Default,,0,0,0,,Әй?
Dialogue: 0,0:19:04.93,0:19:08.48,Default,,0,0,0,,Адамдар мысықтарды көңілсіз деп жиі айтады, солай ма?
Dialogue: 0,0:19:08.56,0:19:12.86,Default,,0,0,0,,Қара мысық жауынгер ханшайымындағы Йоруичи өзінің Рейатсуында осындай нәрсе бар.
Dialogue: 0,0:19:12.94,0:19:15.86,Default,,0,0,0,,Қарашы, сен қазір мені қуып жүрген жоқсың.
Dialogue: 0,0:19:15.94,0:19:17.90,Default,,0,0,0,,Мен осылай сезінемін
Dialogue: 0,0:19:18.40,0:19:20.99,Default,,0,0,0,,Йоруичи әдетте көңілсіз.
Dialogue: 0,0:19:21.07,0:19:23.82,Default,,0,0,0,,Олай қарасаң, одан бетер дірілдейді
Dialogue: 0,0:19:23.91,0:19:28.66,Default,,0,0,0,,Рейацу оған тікелей әсер етіп, дірілдейді.
Dialogue: 0,0:19:29.37,0:19:32.50,Default,,0,0,0,,Басқа біреудің реиацусы сияқты.
Dialogue: 0,0:19:33.54,0:19:34.17,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:35.71,0:19:38.01,Default,,0,0,0,,Біз жыл сайын тұмаумен ауырамыз, солай ма?
Dialogue: 0,0:19:38.80,0:19:42.51,Default,,0,0,0,,Бұл жаңа модель болмаса да, антигендіктің шамалы ғана өзгеруі
Dialogue: 0,0:19:42.59,0:19:45.01,Default,,0,0,0,,Өткен жылдағыдай А түрі басым.
Dialogue: 0,0:19:45.51,0:19:47.14,Default,,0,0,0,,Соған ұқсайды
Dialogue: 0,0:19:47.22,0:19:50.10,Default,,0,0,0,,Ағза иммунитетті жасайды ма, жоқ па
Dialogue: 0,0:19:50.18,0:19:52.69,Default,,0,0,0,,Кішкене өзгеріс бәрін жақсы етеді
Dialogue: 0,0:19:53.19,0:19:59.11,Default,,0,0,0,,Әрине, иммунитетті алу жылдамдығы өте жылдам болуы мүмкін.
Dialogue: 0,0:19:59.19,0:20:01.70,Default,,0,0,0,,Жау сізге шабуыл жасағанда
Dialogue: 0,0:20:01.78,0:20:03.74,Default,,0,0,0,,Рейацуды рефлексия арқылы талдау
Dialogue: 0,0:20:03.82,0:20:07.08,Default,,0,0,0,,Иммунитетті қорқынышты жылдамдықпен жасаңыз
Dialogue: 0,0:20:08.08,0:20:12.00,Default,,0,0,0,,Кез келген шабуыл бір минут ішінде жойылады.
Dialogue: 0,0:20:12.08,0:20:14.04,Default,,0,0,0,,Бірақ бәрібір бұл жеткіліксіз
Dialogue: 0,0:20:14.54,0:20:20.17,Default,,0,0,0,,Қара мысық жауынгер ханшайым Йоруичидің реятсу секундына 48 рет өзгереді.
Dialogue: 0,0:20:23.05,0:20:24.55,Default,,0,0,0,,Уф!
Dialogue: 0,0:20:26.60,0:20:28.47,Default,,0,0,0,,Ой!
Dialogue: 0,0:20:30.81,0:20:32.60,Default,,0,0,0,,Арх! Ах...
Dialogue: 0,0:20:40.15,0:20:41.61,Default,,0,0,0,,Фу~фу~фу~
Dialogue: 0,0:20:41.69,0:20:42.65,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:44.66,0:20:48.41,Default,,0,0,0,,Йоруичи-сан, бұл Йормата.
Dialogue: 0,0:20:48.49,0:20:49.83,Default,,0,0,0,,Міне, міне!
Dialogue: 0,0:20:49.91,0:20:52.00,Default,,0,0,0,,Мияу мияу!
Dialogue: 0,0:20:52.58,0:20:54.12,Default,,0,0,0,,- (Йоричи) Мяу - (Урахара) Ауырды!
Dialogue: 0,0:20:57.04,0:20:59.04,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:20:59.13,0:21:00.30,Default,,0,0,0,,Мияу
Dialogue: 0,0:21:00.38,0:21:03.55,Default,,0,0,0,,Хахахаха жарайды, жарайды, жарайды
Dialogue: 0,0:21:04.30,0:21:05.01,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:21:05.63,0:21:08.18,Default,,0,0,0,,Оны басқара алатын мен ғанамын
Dialogue: 0,0:21:08.26,0:21:11.60,Default,,0,0,0,,Менің көңіл-күйіме байланысты ғана қалыпты жағдайға оралуым кемшілік деп ойлаймын.
Dialogue: 0,0:21:12.60,0:21:16.65,Default,,0,0,0,,Йоруичи-сан өзінің шын пішінінде де сүйкімді.
Dialogue: 0,0:21:16.73,0:21:19.02,Default,,0,0,0,,Маған бәрібір.
Dialogue: 0,0:21:19.11,0:21:22.28,Default,,0,0,0,,О, түсіндім. 5 минутқа жуықтап қалды.
Dialogue: 0,0:21:22.78,0:21:25.03,Default,,0,0,0,,Иммундық агенттің әсері жойылады.
Dialogue: 0,0:21:25.61,0:21:27.45,Default,,0,0,0,,Ерен еңбегіңіз үшін рахмет, Йоруичи-сан
Dialogue: 0,0:21:27.95,0:21:30.49,Default,,0,0,0,,Енді уды ақырын шығарайық.
Dialogue: 0,0:21:31.08,0:21:34.33,Default,,0,0,0,,Мен мәйітті іздеп, оны аяқтаймын.
Dialogue: 0,0:21:36.83,0:21:37.83,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:21:38.33,0:21:39.17,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:44.88,0:21:46.68,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:21:47.76,0:21:49.68,Default,,0,0,0,,Керемет уланған доп (сыйлық бар люкс)
Dialogue: 0,0:21:49.76,0:21:50.60,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:21:50.68,0:21:53.72,Default,,0,0,0,,Мен жасай алатын ең үлкен сыйлық тақтасы
Dialogue: 0,0:21:53.81,0:21:54.81,Default,,0,0,0,,Ой
Dialogue: 0,0:21:54.89,0:21:57.31,Default,,0,0,0,,Бұл солай емес пе?
Dialogue: 0,0:21:57.39,0:22:00.23,Default,,0,0,0,,Менің сыртқы келбетім сізді көбірек қызықтырады ма?
Dialogue: 0,0:22:00.31,0:22:02.44,Default,,0,0,0,,«Құдайдың улануы» деп аталады
Dialogue: 0,0:22:03.03,0:22:05.53,Default,,0,0,0,,Қандай есім, солай ма?
Dialogue: 0,0:22:06.53,0:22:08.53,Default,,0,0,0,,♪～
Dialogue: 0,0:23:32.53,0:23:34.53,Default,,0,0,0,,～♪
Dialogue: 0,0:23:39.54,0:23:41.87,Default,,0,0,0,,Улы,
Dialogue: 0,0:23:43.13,0:23:45.50,Default,,0,0,0,,Бұл таң қалдырады, солай емес пе?
Dialogue: 0,0:23:47.00,0:23:53.00,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
