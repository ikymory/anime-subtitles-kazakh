Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:02:13.06,0:02:34.58,Default,,0,0,0,,♬～
Dialogue: 0,0:02:42.69,0:02:49.03,Default,,0,0,0,,♬～
Dialogue: 0,0:02:49.03,0:02:53.37,Default,,0,0,0,,Не болды? Неге сонша таң қалдыңыз?
Dialogue: 0,0:02:53.37,0:02:55.54,Default,,0,0,0,,Джуширо?
Dialogue: 0,0:02:55.54,0:02:58.04,Default,,0,0,0,,Одан басқа кім көре алады?
Dialogue: 0,0:02:58.04,0:03:01.21,Default,,0,0,0,,Мен көремін. Бұл дұрыс.
Dialogue: 0,0:03:01.21,0:03:03.21,Default,,0,0,0,,Осы жолы соңына дейін шайқасамын!
Dialogue: 0,0:03:03.21,0:03:06.72,Default,,0,0,0,,Сонда сен мені көруге келдің бе?
Dialogue: 0,0:03:06.72,0:03:10.22,Default,,0,0,0,,Юхабах үш әлемді жояды.
Dialogue: 0,0:03:10.22,0:03:13.22,Default,,0,0,0,,Әрең дегенде, Рух патшасының оң қолының күшімен➡
Dialogue: 0,0:03:13.22,0:03:15.72,Default,,0,0,0,,Коллапстың барысы тоқтатылады➡
Dialogue: 0,0:03:15.72,0:03:19.23,Default,,0,0,0,,Бұл менің өмірім аяқталатын уақытта аяқталады.
Dialogue: 0,0:03:19.23,0:03:21.56,Default,,0,0,0,,Міне осылай болады.
Dialogue: 0,0:03:21.56,0:03:25.73,Default,,0,0,0,,Сондықтан мен саған соңғы өмірімді тігуге дайынмын.
Dialogue: 0,0:03:25.73,0:03:27.74,Default,,0,0,0,,Осы әлем үшін.
Dialogue: 0,0:03:27.74,0:03:31.91,Default,,0,0,0,,Сатып алғаныңызға қуаныштымын, бірақ жеңу мүмкіндігіңіз бар ма?
Dialogue: 0,0:03:31.91,0:03:33.84,Default,,0,0,0,,Сіз және капитан Унохана➡
Dialogue: 0,0:03:33.84,0:03:36.51,Default,,0,0,0,,Ашық кездесуге мүмкіндік бар.
Dialogue: 0,0:03:36.51,0:03:39.35,Default,,0,0,0,,Бұл мүмкін емес пе?
Dialogue: 0,0:03:39.35,0:03:43.35,Default,,0,0,0,,Хахахаха Дұрыс.
Dialogue: 0,0:03:43.35,0:03:48.69,Default,,0,0,0,,Осы дүниені қорғайық. Мен өмірімді саған сеніп тапсырамын.
Dialogue: 0,0:03:48.69,0:03:52.53,Default,,0,0,0,,Бұл менің стилім емес.
Dialogue: 0,0:03:52.53,0:03:54.53,Default,,0,0,0,,Бірақ мұны істеуден басқа амалымыз жоқ, солай ма?
Dialogue: 0,0:03:54.53,0:03:59.03,Default,,0,0,0,,Өйткені, сіз қазір Готей 13-тің қолбасшысысыз.
Dialogue: 0,0:03:59.03,0:04:02.20,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:04:02.20,0:04:04.21,Default,,0,0,0,,Қазір бізге керегі➡
Dialogue: 0,0:04:04.21,0:04:08.71,Default,,0,0,0,,Әркімнің ойымен санаса отырып, жауапкершілікті өз мойнына алу даналығы ➡
Dialogue: 0,0:04:08.71,0:04:12.38,Default,,0,0,0,,Мен бұл ауыртпалықты көтеруге дайынмын.
Dialogue: 0,0:04:12.38,0:04:14.38,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:04:14.38,0:04:18.69,Default,,0,0,0,,Сізде бәрінен де маңызды нәрсе бар.
Dialogue: 0,0:04:24.56,0:04:27.16,Default,,0,0,0,,Мен келе жатырмын, Үкітаке.
Dialogue: 0,0:04:29.23,0:04:32.73,Default,,0,0,0,,Хахаха! Өтінемін, Жоғарғы Бас қолбасшы!
Dialogue: 0,0:04:37.34,0:04:39.34,Default,,0,0,0,,Капитан.
Dialogue: 0,0:04:42.84,0:04:45.35,Default,,0,0,0,,Барамыз ба, Нанао-чан?
Dialogue: 0,0:04:59.03,0:05:02.03,Default,,0,0,0,,Әзірге...
Dialogue: 0,0:05:02.03,0:05:07.20,Default,,0,0,0,,Куросаки….
Dialogue: 0,0:05:07.20,0:05:09.60,Default,,0,0,0,,Мен мұны сұрадым.
Dialogue: 0,0:05:15.04,0:05:32.66,Default,,0,0,0,,♬～
Dialogue: 0,0:05:32.66,0:05:36.67,Default,,0,0,0,,Энергия көптеген қабаттарда айналады.
Dialogue: 0,0:05:36.67,0:05:39.83,Default,,0,0,0,,Бұл негізгі бұрмалаудың қатынасы емес пе?
Dialogue: 0,0:05:39.83,0:05:42.50,Default,,0,0,0,,Қожайын жазғандай.
Dialogue: 0,0:05:42.50,0:05:46.17,Default,,0,0,0,,Бұл қандай бөлме? Және Янс.
Dialogue: 0,0:05:46.17,0:05:48.18,Default,,0,0,0,,Балалар!
Dialogue: 0,0:05:48.18,0:05:51.35,Default,,0,0,0,,Әй, Урю Ишида! Неге мұндасың? ?
Dialogue: 0,0:05:51.35,0:05:54.35,Default,,0,0,0,,Бұл дүниеде қалу керек еді. Және Янс.
Dialogue: 0,0:05:54.35,0:05:57.69,Default,,0,0,0,,Балалар мұнда не істеп жүрсіңдер?
Dialogue: 0,0:05:57.69,0:05:59.69,Default,,0,0,0,,Көп нәрсе болды.
Dialogue: 0,0:05:59.69,0:06:01.69,Default,,0,0,0,,Жағдайды көрейін деп далаға шыққанда➡
Dialogue: 0,0:06:01.69,0:06:05.36,Default,,0,0,0,,Қара көзге ілініп, білмей тұрып, осында болдым.
Dialogue: 0,0:06:05.36,0:06:07.70,Default,,0,0,0,,Сосын мен тентіреп жүргенімде не болды!
Dialogue: 0,0:06:07.70,0:06:11.03,Default,,0,0,0,,Сіз бізге қосыла алдыңыз.
Dialogue: 0,0:06:11.03,0:06:13.70,Default,,0,0,0,,Балалар!
Dialogue: 0,0:06:13.70,0:06:16.54,Default,,0,0,0,,Гаррибель-саманың құтқарылуы өте сәтті болды!
Dialogue: 0,0:06:16.54,0:06:18.71,Default,,0,0,0,,Операция сәтті өтті! Янс!
Dialogue: 0,0:06:18.71,0:06:23.71,Default,,0,0,0,,Тиа Харрибель және әлгі маска... бұл Нелл Чан ба?
Dialogue: 0,0:06:23.71,0:06:26.88,Default,,0,0,0,,Мен сені бірінші рет көріп тұрмын, Урю Ишида.
Dialogue: 0,0:06:26.88,0:06:28.88,Default,,0,0,0,,Сіз таң қалдыңыз ба?
Dialogue: 0,0:06:28.88,0:06:31.55,Default,,0,0,0,,Жоқ, мен сәл абдырап қалдым.
Dialogue: 0,0:06:31.55,0:06:35.16,Default,,0,0,0,,Адал бол! Неллиэль-сама оған тамсанған болуы керек!
Dialogue: 0,0:06:35.16,0:06:37.66,Default,,0,0,0,,Біртүрлі айыптаулар жасамаңыз!
Dialogue: 0,0:06:37.66,0:06:41.83,Default,,0,0,0,,Урю Ишида өзіңізді жойғыш деп атасаңыз, жауап беріңіз.
Dialogue: 0,0:06:41.83,0:06:46.84,Default,,0,0,0,,Сіз кім үшін келдіңіз және не іздеп жүрсіз?
Dialogue: 0,0:06:46.84,0:06:51.84,Default,,0,0,0,,Ол өте көп.
Dialogue: 0,0:06:51.84,0:06:57.68,Default,,0,0,0,,Бұл тағы бір сирек банкет болатын сияқты.
Dialogue: 0,0:06:57.68,0:07:18.53,Default,,0,0,0,,♬～
Dialogue: 0,0:07:18.53,0:07:21.37,Default,,0,0,0,,Қақпа жабылды! (Ақын) Шекараның бұзылу дәрежесі қандай?
Dialogue: 0,0:07:21.37,0:07:25.87,Default,,0,0,0,,Минус 0,1-ге дейін азайтылды. Бұрмалаудың кеңеюі баяулайды!
Dialogue: 0,0:07:25.87,0:07:28.54,Default,,0,0,0,,Жарайды, бұл мінсіз емес, бірақ...
Dialogue: 0,0:07:28.54,0:07:31.05,Default,,0,0,0,,Рыконгайдағы Холлоу келтірген зиян туралы көптеген хабарламалар болды.
Dialogue: 0,0:07:31.05,0:07:32.98,Default,,0,0,0,,Бұл туралы не істеуіміз керек? ?
Dialogue: 0,0:07:32.98,0:07:36.48,Default,,0,0,0,,Мен көмектесе алмаймын. Соншалықты жауапсыздық!
Dialogue: 0,0:07:36.48,0:07:39.65,Default,,0,0,0,,Әлемнің күйреуін болдырмау – біздің басты міндетіміз!
Dialogue: 0,0:07:39.65,0:07:43.66,Default,,0,0,0,,Енді тезірек Рух патшасының оң қолын талдап көрейік.
Dialogue: 0,0:07:43.66,0:07:47.50,Default,,0,0,0,,Капитан Укитаке өлсе де, біз жалғастыра алатын болсақ, бұл жақсы.
Dialogue: 0,0:07:47.50,0:07:49.50,Default,,0,0,0,,Мен өлсем де...
Dialogue: 0,0:07:49.50,0:07:51.83,Default,,0,0,0,,Бұл капитан Укитаке үшін шығар.
Dialogue: 0,0:07:51.83,0:07:57.34,Default,,0,0,0,,Бұл жақсы да, жаман да емес. Біз Шинигами тепе-теңдікті сақтаушылармыз, ұмытпаңыз.
Dialogue: 0,0:07:57.34,0:08:00.68,Default,,0,0,0,,Иә, түсіндім.
Dialogue: 0,0:08:00.68,0:08:05.35,Default,,0,0,0,,Рықонғайдан бас тарту Сейрейтейді қорғаудың құралы болады...
Dialogue: 0,0:08:05.35,0:08:08.35,Default,,0,0,0,,Бәлкім, мұндай кездер үшін Рюконгай болған шығар.
Dialogue: 0,0:08:13.02,0:08:15.69,Default,,0,0,0,,Жарылған бет!
Dialogue: 0,0:08:15.69,0:08:19.69,Default,,0,0,0,,Дүрбелеңге салынбаңыз. Дүрлікпеңіз. Банкет дедіңіз бе?
Dialogue: 0,0:08:19.69,0:08:22.20,Default,,0,0,0,,Әй, біраз уақыт болды.
Dialogue: 0,0:08:22.20,0:08:25.03,Default,,0,0,0,,Мен сіздің жүзіңізді енді көремін деп ойламадым➡
Dialogue: 0,0:08:25.03,0:08:27.04,Default,,0,0,0,,Мен олай ойламадым.
Dialogue: 0,0:08:27.04,0:08:29.04,Default,,0,0,0,,Бұл сызық, Қылмыскер.
Dialogue: 0,0:08:29.04,0:08:32.14,Default,,0,0,0,,Бірақ бір сұмдық нәрсе де болды.
Dialogue: 0,0:08:32.14,0:08:34.14,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:08:34.14,0:08:39.31,Default,,0,0,0,,Бұл бүкіл әлемді құрбан ететін құйын сияқты нәрсе болар еді.
Dialogue: 0,0:08:39.31,0:08:45.49,Default,,0,0,0,,Мен көремін. Үш патшалықта пайда болған бұрмалаушылықтың бастауы осы.
Dialogue: 0,0:08:45.49,0:08:49.32,Default,,0,0,0,,Бұл сіз жоюшылардың➡ түпкі мақсаты
Dialogue: 0,0:08:49.32,0:08:51.66,Default,,0,0,0,,Бұл рас па деп ойлаймын, Урю-кун.
Dialogue: 0,0:08:51.66,0:08:53.66,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:08:53.66,0:08:57.17,Default,,0,0,0,,Юхабах мұны соғысты бастамас бұрын да жоспарлаған➡
Dialogue: 0,0:08:57.17,0:08:59.83,Default,,0,0,0,,Әлемді жоюға арналған жебе.
Dialogue: 0,0:08:59.83,0:09:03.17,Default,,0,0,0,,Ал бұл бұрмалауды жоюдың жолы –➡
Dialogue: 0,0:09:03.17,0:09:05.67,Default,,0,0,0,,Бұл менің соңғы жоюшы ретіндегі міндетім.
Dialogue: 0,0:09:07.68,0:09:11.35,Default,,0,0,0,,((Мунэцу: Мен рөл ойнадым.
Dialogue: 0,0:09:11.35,0:09:14.52,Default,,0,0,0,,Жою иесі расталған дүние тілеу➡
Dialogue: 0,0:09:14.52,0:09:19.02,Default,,0,0,0,,Билікті аңсау Мен зерттеуімнің соңына жеттім.
Dialogue: 0,0:09:19.02,0:09:24.36,Default,,0,0,0,,Әр түрдің жанын біріктіріп, тепе-теңдігін бұзу арқылы➡
Dialogue: 0,0:09:24.36,0:09:28.36,Default,,0,0,0,,Жоғары өлшемді жандарды жасау күші.
Dialogue: 0,0:09:28.36,0:09:34.14,Default,,0,0,0,,Алайда бұл билікті басқару мүмкін емес және Үш патшалықтың жойылуына әкеледі.
Dialogue: 0,0:09:34.14,0:09:37.64,Default,,0,0,0,,Мен түсіндім. Бұл жойылу тұқымы
Dialogue: 0,0:09:37.64,0:09:41.31,Default,,0,0,0,,Жоюшылардың патшасы осылай қалаған.
Dialogue: 0,0:09:41.31,0:09:44.48,Default,,0,0,0,,Бір рет жойылу тұқымы пайда болады ➡
Dialogue: 0,0:09:44.48,0:09:46.48,Default,,0,0,0,,Қолдан келетін ештеңе жоқ.
Dialogue: 0,0:09:46.48,0:09:49.15,Default,,0,0,0,,Жалғыз мүмкіндік –➡
Dialogue: 0,0:09:49.15,0:09:53.15,Default,,0,0,0,,Дүниенің интерфейсінде пайда болатын бұрмалау орталығы ➡
Dialogue: 0,0:09:53.15,0:09:57.83,Default,,0,0,0,,Жою тұқымын ұру жойылуды тудыруы мүмкін.
Dialogue: 0,0:09:57.83,0:10:01.66,Default,,0,0,0,,Алайда, жойылу нәтижесінде пайда болған күштің салдары➡
Dialogue: 0,0:10:01.66,0:10:04.00,Default,,0,0,0,,Бұл елестету мүмкін емес болып қалады.
Dialogue: 0,0:10:04.00,0:10:07.50,Default,,0,0,0,,Сонда да осы дүниеде өмір сүретін адам ретінде➡
Dialogue: 0,0:10:07.50,0:10:10.31,Default,,0,0,0,,Біреу істеу керек))
Dialogue: 0,0:10:12.34,0:10:14.34,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:10:14.34,0:10:16.85,Default,,0,0,0,,Қалай болғанда да, бұл Жою Тұқымы➡
Dialogue: 0,0:10:16.85,0:10:21.68,Default,,0,0,0,,Төменде таралатын бұрмалаумен соқтығыссаңыз, оны жоюға болады.
Dialogue: 0,0:10:21.68,0:10:24.69,Default,,0,0,0,,Юхабахтың жоспары... Демек, бұл дегеніміз?
Dialogue: 0,0:10:24.69,0:10:26.69,Default,,0,0,0,,Бұл өте қарапайым!
Dialogue: 0,0:10:26.69,0:10:28.69,Default,,0,0,0,,Бұл өте қарапайым.
Dialogue: 0,0:10:28.69,0:10:31.69,Default,,0,0,0,,Егер біз мұны істей алсақ, біз әлемді құтқара аламыз, солай ма?
Dialogue: 0,0:10:31.69,0:10:34.70,Default,,0,0,0,,Мен әңгімені түсіндім. Бірақ мен не істеуім керек?
Dialogue: 0,0:10:34.70,0:10:38.70,Default,,0,0,0,,Сіз дұрыс ойлайсыз ба? Қалайсың, Урю Ишида!
Dialogue: 0,0:10:38.70,0:10:41.54,Default,,0,0,0,,Сіз соғуға болады! ?
Dialogue: 0,0:10:41.54,0:10:43.54,Default,,0,0,0,,Сіз бүкіл қамалды қиратуды жоспарлап отырсыз ба?
Dialogue: 0,0:10:45.54,0:10:47.88,Default,,0,0,0,,Бірақ бұл массасы бар нәрсе.
Dialogue: 0,0:10:47.88,0:10:51.38,Default,,0,0,0,,Ол бастапқыда рухани балалардан құралған. Мен саған көрсетемін.
Dialogue: 0,0:10:51.38,0:10:54.72,Default,,0,0,0,,Сіз мұны өзіңіз жасай аласыз ба?
Dialogue: 0,0:10:54.72,0:10:59.05,Default,,0,0,0,,Дүниенің күйреуі жалғыз сенің проблемаң емес дейді.
Dialogue: 0,0:10:59.05,0:11:01.56,Default,,0,0,0,,Бұл аздап айналма жол, Гаррибель.
Dialogue: 0,0:11:01.56,0:11:03.89,Default,,0,0,0,,Сіз мұнда жалғыз емессіз.
Dialogue: 0,0:11:03.89,0:11:06.73,Default,,0,0,0,,Біз саған көмектесеміз, сен осылай айтып тұрсың.
Dialogue: 0,0:11:06.73,0:11:08.90,Default,,0,0,0,,Ал сендер ше?
Dialogue: 0,0:11:08.90,0:11:11.07,Default,,0,0,0,,Сіз Ичигоның досысыз, солай ма?
Dialogue: 0,0:11:11.07,0:11:13.40,Default,,0,0,0,,Қамалды қирату жеткіліксіз.
Dialogue: 0,0:11:13.40,0:11:17.57,Default,,0,0,0,,Ең нашар жағдайда, сіз Юхабахпен тікелей төбелесуіңіз мүмкін.
Dialogue: 0,0:11:17.57,0:11:20.41,Default,,0,0,0,,Оның күшіне мен ғана қарсы тұрамын.\NӘсіресе
Dialogue: 0,0:11:20.41,0:11:22.41,Default,,0,0,0,,болса.
Dialogue: 0,0:11:22.41,0:11:26.25,Default,,0,0,0,,Бұл күш Ичигоға көмектесу үшін пайдаланылуы керек.
Dialogue: 0,0:11:26.25,0:11:29.25,Default,,0,0,0,,Өмірге кепілдік беруге болмайды.
Dialogue: 0,0:11:29.25,0:11:31.75,Default,,0,0,0,,Мен мұндайды ешқашан сұраған емеспін.
Dialogue: 0,0:11:31.75,0:11:35.69,Default,,0,0,0,,Хе-е-е-е-е-е-е, бұл сөзіңнің беті жарылған адамға айтудың қажеті жоқ.
Dialogue: 0,0:11:35.69,0:11:37.69,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:11:37.69,0:11:41.20,Default,,0,0,0,,Мен сенің күшіңді ойланбастан пайдаланамын.
Dialogue: 0,0:11:41.20,0:11:44.87,Default,,0,0,0,,Әрине, біз де ынтымақтасамыз.
Dialogue: 0,0:11:44.87,0:11:48.04,Default,,0,0,0,,Толығымен Шинигами, Аннигилатор және Шұңқыр➡
Dialogue: 0,0:11:48.04,0:11:51.04,Default,,0,0,0,,Дүниені қорғауға тырысатын күннің келетініне сене алар емеспін.
Dialogue: 0,0:11:51.04,0:11:53.37,Default,,0,0,0,,Урю Ишида өсті.
Dialogue: 0,0:11:53.37,0:11:55.54,Default,,0,0,0,,Янс қатты әсер етті.
Dialogue: 0,0:11:55.54,0:11:57.55,Default,,0,0,0,,Не істеймін… не істеймін!
Dialogue: 0,0:11:57.55,0:12:00.72,Default,,0,0,0,,Құлағандар - қазір Рух патшасының сарайында шайқасып жатқан адамдар...
Dialogue: 0,0:12:00.72,0:12:04.72,Default,,0,0,0,,Тек осы орталық ғимарат құлайды.
Dialogue: 0,0:12:04.72,0:12:06.72,Default,,0,0,0,,Шабуыл
Dialogue: 0,0:12:06.72,0:12:08.72,Default,,0,0,0,,Аннигилатордың құпия техникасымен жасалған➡
Dialogue: 0,0:12:08.72,0:12:13.73,Default,,0,0,0,,Рухтарды ыдыратып, тарата алатын рух сынықтары.
Dialogue: 0,0:12:13.73,0:12:17.07,Default,,0,0,0,,Қарапайым тілмен айтқанда, бұл бомба.
Dialogue: 0,0:12:17.07,0:12:20.74,Default,,0,0,0,,Осы орталық ғимараттан шығатын бес көпірді жарып жіберіңіз➡
Dialogue: 0,0:12:20.74,0:12:22.74,Default,,0,0,0,,Отрядты бөлу.
Dialogue: 0,0:12:22.74,0:12:25.74,Default,,0,0,0,,Әу бастан солай айтқыңыз келді ме?
Dialogue: 0,0:12:25.74,0:12:29.08,Default,,0,0,0,,А, менің артық зиян келтіргім келмейді.
Dialogue: 0,0:12:29.08,0:12:32.68,Default,,0,0,0,,Қандай жағдай болмасын, табысқа жетуге көз жеткізіңіз.
Dialogue: 0,0:12:36.18,0:12:38.19,Default,,0,0,0,,Маған қалдырыңыз.
Dialogue: 0,0:12:42.52,0:12:47.53,Default,,0,0,0,,Біздің міндетіміз – осы әлемді қорғау.
Dialogue: 0,0:12:47.53,0:12:51.03,Default,,0,0,0,,Мен Нанао-чанның уайымын түсінемін, бірақ бәрібір.
Dialogue: 0,0:12:51.03,0:12:54.54,Default,,0,0,0,,Бірдеңені жай ғана жасамаңыз. Бірдеңе жасаңыз.
Dialogue: 0,0:12:56.54,0:12:58.54,Default,,0,0,0,,Капитан? Мен оны сізге қалдырамын.
Dialogue: 0,0:12:58.54,0:13:01.04,Default,,0,0,0,,Менің басқа жұмысым бар.
Dialogue: 0,0:13:03.04,0:13:05.05,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:13:08.38,0:13:12.09,Default,,0,0,0,,Енді садағыңызды тартыңыз.
Dialogue: 0,0:13:17.06,0:13:19.86,Default,,0,0,0,,Сен әлі бас тарттың ба, Ичиго?
Dialogue: 0,0:13:24.40,0:13:26.70,Default,,0,0,0,,Тіпті сен сияқты емес.
Dialogue: 0,0:13:29.07,0:13:32.34,Default,,0,0,0,,《Ичиго: Менің семсерім оған ене алмайды.
Dialogue: 0,0:13:32.34,0:13:34.34,Default,,0,0,0,,Инуэнің де күші➡
Dialogue: 0,0:13:34.34,0:13:37.15,Default,,0,0,0,,Тіпті әркімнің күші де жұмыс істемейді.
Dialogue: 0,0:13:43.02,0:13:45.85,Default,,0,0,0,,《Бітті》
Dialogue: 0,0:13:45.85,0:13:48.86,Default,,0,0,0,,Осы уақытқа дейін? Қызықсыз.
Dialogue: 0,0:13:48.86,0:13:53.19,Default,,0,0,0,,Жоқ, маған ұнады деп айту керек пе?
Dialogue: 0,0:13:53.19,0:13:58.70,Default,,0,0,0,,Енді бұл сіздің соңғы миссияңыз.
Dialogue: 0,0:13:58.70,0:14:05.04,Default,,0,0,0,,Саған берген билікті қайтаруыңды сұраймын.
Dialogue: 0,0:14:05.04,0:14:24.23,Default,,0,0,0,,♬～
Dialogue: 0,0:14:24.23,0:14:26.63,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:30.73,0:14:32.67,Default,,0,0,0,,Бұл...
Dialogue: 0,0:14:32.67,0:14:34.67,Default,,0,0,0,,Мынау... мынау несі! ?
Dialogue: 0,0:14:34.67,0:14:37.84,Default,,0,0,0,,Әлі де бірдеңе бола ма? Бұл сияқты...
Dialogue: 0,0:14:37.84,0:14:40.64,Default,,0,0,0,,Бұл ақырзаман сияқты.
Dialogue: 0,0:14:44.85,0:14:46.85,Default,,0,0,0,,Куросаки!
Dialogue: 0,0:14:46.85,0:14:50.35,Default,,0,0,0,,Кек алатын кез келді, Ичиго Куросаки.
Dialogue: 0,0:14:50.35,0:14:55.02,Default,,0,0,0,,Үмітсіздік жұтқан өлім.
Dialogue: 0,0:14:55.02,0:15:24.39,Default,,0,0,0,,♬～
Dialogue: 0,0:15:24.39,0:15:26.39,Default,,0,0,0,,Капитан Укитаке!
Dialogue: 0,0:15:41.50,0:15:44.34,Default,,0,0,0,,Қарап тұрсың ба, Үкітаке?
Dialogue: 0,0:15:44.34,0:15:48.51,Default,,0,0,0,,Енді соңғы шайқас.
Dialogue: 0,0:15:48.51,0:15:52.68,Default,,0,0,0,,《Аа, жоғалып кетті.
Dialogue: 0,0:15:52.68,0:15:56.02,Default,,0,0,0,,Менің ішімдегі жойғыштың күші.
Dialogue: 0,0:15:56.02,0:16:00.02,Default,,0,0,0,,Оған қиялдық күш араласты.
Dialogue: 0,0:16:00.02,0:16:05.03,Default,,0,0,0,,Жоғалу Жоғалу.
Dialogue: 0,0:16:05.03,0:16:07.70,Default,,0,0,0,,Таза ақ
Dialogue: 0,0:16:07.70,0:16:24.55,Default,,0,0,0,,♬～
Dialogue: 0,0:16:24.55,0:16:29.55,Default,,0,0,0,,Ескі дүниенің тынымсыз қарбаласы.
Dialogue: 0,0:16:29.55,0:16:33.15,Default,,0,0,0,,Тұқым гүлдейді.
Dialogue: 0,0:16:33.15,0:16:37.66,Default,,0,0,0,,Бейбітшілікке дайын болыңыз.
Dialogue: 0,0:16:58.51,0:17:01.02,Default,,0,0,0,,Не болды, Урю?
Dialogue: 0,0:17:01.02,0:17:04.02,Default,,0,0,0,,Маған көрсетемін деген болашақ осы ма?
Dialogue: 0,0:17:04.02,0:17:06.02,Default,,0,0,0,,Иә.
Dialogue: 0,0:17:06.02,0:17:11.03,Default,,0,0,0,,Сұрамаңыз. Ичиго Куросакимен не істедің?
Dialogue: 0,0:17:11.03,0:17:13.03,Default,,0,0,0,,Өйткені бұл қажет емес.
Dialogue: 0,0:17:13.03,0:17:17.63,Default,,0,0,0,,Көптен бері жүрегімді көре алмаған сияқтысың.
Dialogue: 0,0:17:20.70,0:17:22.70,Default,,0,0,0,,Аа...
Dialogue: 0,0:17:25.71,0:17:28.04,Default,,0,0,0,,Бауэр!
Dialogue: 0,0:17:28.04,0:17:31.05,Default,,0,0,0,,Енді барлық қарыз бітті.
Dialogue: 0,0:17:31.05,0:17:35.55,Default,,0,0,0,,Керісінше, бұл несие, Ичиго Куросаки! Және Янс!
Dialogue: 0,0:17:42.49,0:17:46.66,Default,,0,0,0,,Ақылды көрудің мәні неде?
Dialogue: 0,0:17:46.66,0:17:56.67,Default,,0,0,0,,♬～
Dialogue: 0,0:17:56.67,0:17:58.67,Default,,0,0,0,,Супер жеделдету!
Dialogue: 0,0:18:15.02,0:18:22.03,Default,,0,0,0,,Үмітсіздіктің өзі жеткіліксіз болатын алшақтықтан айырылып қалдыңыз ба, уа, Сынған бет патшасы?
Dialogue: 0,0:18:22.03,0:18:24.87,Default,,0,0,0,,Мен саған патша емеспін дедім.
Dialogue: 0,0:18:24.87,0:18:26.87,Default,,0,0,0,,Құлау.
Dialogue: 0,0:18:35.14,0:18:37.81,Default,,0,0,0,,Спектакль аяқталды.
Dialogue: 0,0:18:37.81,0:18:41.82,Default,,0,0,0,,Кешіріңіз, бірақ... менімен тағы біраз араласуыңызды өтінемін.
Dialogue: 0,0:18:44.65,0:18:48.16,Default,,0,0,0,,Бұл Фадер Цвингер қолданбасы.
Dialogue: 0,0:18:48.16,0:18:50.66,Default,,0,0,0,,Жұту бағытын өзгерту➡
Dialogue: 0,0:18:50.66,0:18:57.33,Default,,0,0,0,,Осы шынайы әлемдік құлыпта үлкен көлемдегі рухтарды бөлшектеп, қайта біріктіріңіз.
Dialogue: 0,0:18:57.33,0:19:00.33,Default,,0,0,0,,Тіпті бұл көрсеткіні елемеуге болмайды.
Dialogue: 0,0:19:00.33,0:19:03.34,Default,,0,0,0,,Жасыл... найза ату!
Dialogue: 0,0:19:03.34,0:19:06.51,Default,,0,0,0,,Бітті.
Dialogue: 0,0:19:06.51,0:19:10.01,Default,,0,0,0,,Сіз таңдаған үміт осы ма?
Dialogue: 0,0:19:10.01,0:19:12.01,Default,,0,0,0,,Мен оны әлі таңдаған жоқпын.
Dialogue: 0,0:19:17.18,0:19:19.19,Default,,0,0,0,,Хмм….
Dialogue: 0,0:19:23.02,0:19:28.86,Default,,0,0,0,,Ақымақ. Менің құдіреттілігім мен құдіреттілігімнің алдында бәрі мағынасыз.
Dialogue: 0,0:19:28.86,0:19:32.30,Default,,0,0,0,,Сіз атқан үміттің тағы бір жебесі➡
Dialogue: 0,0:19:32.30,0:19:34.30,Default,,0,0,0,,Бүктелген!
Dialogue: 0,0:19:36.30,0:19:40.81,Default,,0,0,0,,Мен сіздің болашақты таңдайтыныңызды білдім.
Dialogue: 0,0:19:40.81,0:19:44.51,Default,,0,0,0,,Сондықтан мен оны бұзылмайтын болашаққа ауыстырдым.
Dialogue: 0,0:19:52.99,0:19:56.82,Default,,0,0,0,,Сіз менің күш-қуатымды соншалықты арттырдыңыз.
Dialogue: 0,0:19:56.82,0:20:01.66,Default,,0,0,0,,Дегенмен, Тұқым мен бұрмаланудың соқтығысуы нәтижесінде пайда болатын қуат жарылысы➡
Dialogue: 0,0:20:01.66,0:20:06.00,Default,,0,0,0,,Рейу сарайы ғана емес, Сейрейтей де қатысады.
Dialogue: 0,0:20:06.00,0:20:08.00,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:20:08.00,0:20:12.31,Default,,0,0,0,,Демек, бұл мен жалғыз қол жеткізе алмайтын жеңіс.
Dialogue: 0,0:20:17.51,0:20:19.51,Default,,0,0,0,,Мен сізден өтінемін!
Dialogue: 0,0:20:21.52,0:20:23.52,Default,,0,0,0,,Толық қарсылық.
Dialogue: 0,0:20:23.52,0:21:16.74,Default,,0,0,0,,♬～
Dialogue: 0,0:21:16.74,0:21:19.14,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:35.19,0:21:40.86,Default,,0,0,0,,Ха ха ха ха….
Dialogue: 0,0:21:40.86,0:21:43.36,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:21:53.87,0:21:59.38,Default,,0,0,0,,Бұл соғыс аяқталды дегенді білдіре ме?
Dialogue: 0,0:22:06.72,0:22:10.22,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:22:10.22,0:22:15.06,Default,,0,0,0,,Урю, сен маған өз күшіңді көрсеттің.
Dialogue: 0,0:22:15.06,0:22:20.73,Default,,0,0,0,,Бірақ мен жасайтын болашақ өзгермейді.
Dialogue: 0,0:22:20.73,0:22:26.91,Default,,0,0,0,,Барлық қасиетті әріптер барлық ғылым мен құдіреттілікке көтерілді.
Dialogue: 0,0:22:26.91,0:22:29.91,Default,,0,0,0,,Дүние біткен тоғыз күн.
Dialogue: 0,0:22:29.91,0:22:32.51,Default,,0,0,0,,Шеңберге бара жатқан жолда➡
Dialogue: 0,0:22:32.51,0:22:36.62,Default,,0,0,0,,Бұл ақиқат дүниенің басталуымен бірдей тармақ.
Dialogue: 0,0:22:41.02,0:22:44.33,Default,,0,0,0,,Барлығы көрінеді.
Dialogue: 0,0:22:45.83,0:22:51.83,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
