Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:19.81,0:00:23.60,Default,,0,0,0,,Үйде қайырлы таң. Саған ақылы жоқ бала екен деп айтпа.
Dialogue: 0,0:00:28.11,0:00:29.69,Default,,0,0,0,,(Қайықшы) Эй
Dialogue: 0,0:00:29.82,0:00:32.28,Default,,0,0,0,,Қайда бара жатырсың? ‬
Dialogue: 0,0:00:33.61,0:00:35.36,Default,,0,0,0,,Накадзима Хонмачидегі «Футабаға».
Dialogue: 0,0:00:35.49,0:00:37.37,Default,,0,0,0,,Желімді жеткізіңіз
Dialogue: 0,0:00:37.49,0:00:40.95,Default,,0,0,0,,Бастапқыда бұл ағамның рөлі еді, бірақ суық тигендіктен.
Dialogue: 0,0:00:41.08,0:00:45.50,Default,,0,0,0,,Мен...
Dialogue: 0,0:00:45.62,0:00:48.88,Default,,0,0,0,,Маған тәнті болды, бірақ тоқта, тоқта.
Dialogue: 0,0:00:49.00,0:00:52.59,Default,,0,0,0,,Қиыршық қайықтың қайтып оралуы шашыранды.
Dialogue: 0,0:00:52.71,0:00:57.34,Default,,0,0,0,,Мен балдырларды жеткізгеннен кейін үйге барып, ағам мен әпкеме кәдесыйлар сатып аламын.
Dialogue: 0,0:00:58.43,0:00:59.97,Default,,0,0,0,,(Қайықшы) Хохоу
Dialogue: 0,0:01:11.11,0:01:13.36,Default,,0,0,0,,(Қайықшы) Эй, уф...
Dialogue: 0,0:01:13.49,0:01:15.65,Default,,0,0,0,,Мен жақындап қалдым
Dialogue: 0,0:01:16.32,0:01:19.91,Default,,0,0,0,,Ей, мен ойсызмын.
Dialogue: 0,0:01:29.92,0:01:31.09,Default,,0,0,0,,Жақсы жаңалық
Dialogue: 0,0:01:39.97,0:01:45.35,Default,,0,0,0,,(Қаладағы дүрбелең)
Dialogue: 0,0:01:46.85,0:01:50.15,Default,,0,0,0,,Шоколад 10 сен Карамель қорабы 10 сен
Dialogue: 0,0:01:50.27,0:01:52.61,Default,,0,0,0,,Кіші қорап 5 сен, йо-йо 10 сен
Dialogue: 0,0:01:52.73,0:01:54.40,Default,,0,0,0,,(Бала) Иә, жақсы, жақсы.
Dialogue: 0,0:01:56.99,0:01:58.78,Default,,0,0,0,,(Қала тұрғыны) Маған қызыл түсті ұнайды.
Dialogue: 0,0:01:58.91,0:02:01.78,Default,,0,0,0,,(қала тұрғыны) Әлі де өте жанды. (Қала тұрғыны) Бұл рас.
Dialogue: 0,0:02:02.58,0:02:04.95,Default,,0,0,0,,(Саудагер) Сізге көп рахмет.
Dialogue: 0,0:02:05.08,0:02:06.79,Default,,0,0,0,,Қадам басқанда абай болыңыз
Dialogue: 0,0:02:09.00,0:02:13.96,Default,,0,0,0,,‪♪～‬
Dialogue: 0,0:03:37.38,0:03:42.34,Default,,0,0,0,,‪～♪‬
Dialogue: 0,0:03:42.47,0:03:45.51,Default,,0,0,0,,Егер сол жерде адасып қалсаңыз
Dialogue: 0,0:03:45.64,0:03:48.01,Default,,0,0,0,,Осы Утан қартпен кездесу
Dialogue: 0,0:03:50.10,0:03:53.69,Default,,0,0,0,,Сузу-чан, бұл не? ол
Dialogue: 0,0:03:53.81,0:03:55.61,Default,,0,0,0,,«Бэйкемон» иә? ‬
Dialogue: 0,0:03:55.73,0:03:57.19,Default,,0,0,0,,деді
Dialogue: 0,0:03:57.32,0:04:01.53,Default,,0,0,0,,Ол маған мынаны пайдаланып жол табуды және телескоп арқылы қарауға рұқсат етті.
Dialogue: 0,0:04:03.36,0:04:06.57,Default,,0,0,0,,Уау! Бұл солай көрінеді
Dialogue: 0,0:04:06.70,0:04:07.66,Default,,0,0,0,,Уау! ‬
Dialogue: 0,0:04:08.66,0:04:12.33,Default,,0,0,0,,Құлаған қоржынның ішінде белгісіз адам пайда болды.
Dialogue: 0,0:04:12.46,0:04:16.08,Default,,0,0,0,,(Бала) Ол ұрлаушы, біз ұрланған адамдармыз.
Dialogue: 0,0:04:16.21,0:04:17.29,Default,,0,0,0,,Иә!?
Dialogue: 0,0:04:17.88,0:04:19.80,Default,,0,0,0,,Сіз әлсізсіз.
Dialogue: 0,0:04:19.92,0:04:23.97,Default,,0,0,0,,Мен кешке тауықтарды тамақтандыру үшін үйге баруым керек.
Dialogue: 0,0:04:24.09,0:04:27.43,Default,,0,0,0,,Мен де әкеммен бірге үйге пойызбен баруым керек.
Dialogue: 0,0:04:27.55,0:04:29.47,Default,,0,0,0,,Мен де Мен
Dialogue: 0,0:04:29.60,0:04:31.98,Default,,0,0,0,,Кеш батқанша үйге бармасаң, қиналып қаласың.
Dialogue: 0,0:04:31.98,0:04:33.52,Default,,0,0,0,,Кеш батқанша үйге бармасаң, қиналып қаласың.
Dialogue: 0,0:04:31.98,0:04:33.52,Default,,0,0,0,,Анашым, не қызық? Орынсару
Dialogue: 0,0:04:33.52,0:04:33.64,Default,,0,0,0,,Анашым, не қызық? Орынсару
Dialogue: 0,0:04:33.64,0:04:34.06,Default,,0,0,0,,Анашым, не қызық? Орынсару
Dialogue: 0,0:04:33.64,0:04:34.06,Default,,0,0,0,,Бұл үлкен мәселе бола ма деп ойлаймын.
Dialogue: 0,0:04:34.06,0:04:35.65,Default,,0,0,0,,Бұл үлкен мәселе бола ма деп ойлаймын.
Dialogue: 0,0:04:35.77,0:04:37.61,Default,,0,0,0,,Ал, Миторинсай
Dialogue: 0,0:04:43.53,0:04:45.41,Default,,0,0,0,,Қария қария Айтат Айтат
Dialogue: 0,0:04:45.95,0:04:48.41,Default,,0,0,0,,Бұл не? Қараңыз
Dialogue: 0,0:04:48.53,0:04:51.58,Default,,0,0,0,,Иә? қайсысы
Dialogue: 0,0:04:52.29,0:04:53.79,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:04:53.91,0:04:56.29,Default,,0,0,0,,‪‬
Dialogue: 0,0:04:56.42,0:04:59.92,Default,,0,0,0,,Түнде ұйықтайсың деген сөз.
Dialogue: 0,0:05:00.80,0:05:03.26,Default,,0,0,0,,(Бала) Мен оны аяймын, өйткені оның кешкі асы ыңылдап жатыр.
Dialogue: 0,0:05:05.26,0:05:07.47,Default,,0,0,0,,Ангатона Сузу Урано
Dialogue: 0,0:05:07.59,0:05:10.18,Default,,0,0,0,,Иә, мен білмей тұрып, менің атым болды
Dialogue: 0,0:05:10.31,0:05:12.35,Default,,0,0,0,,(бұрышта күлкі)
Dialogue: 0,0:05:12.47,0:05:14.89,Default,,0,0,0,,«Ангатона Сузу Урано» Ахахха! ‬
Dialogue: 0,0:05:15.02,0:05:17.23,Default,,0,0,0,,(№1 кілт) Міне! шулы
Dialogue: 0,0:05:17.35,0:05:18.27,Default,,0,0,0,,Хехе...
Dialogue: 0,0:05:18.40,0:05:20.57,Default,,0,0,0,,Біз ойсызбыз
Dialogue: 0,0:05:20.69,0:05:25.99,Default,,0,0,0,,Джейк, бұл күн менің күндізгі арманым болғанына сенімдімін.
Dialogue: 0,0:05:31.66,0:05:34.33,Default,,0,0,0,,Юмбе теңізі Мынадай болды
Dialogue: 0,0:05:35.46,0:05:37.83,Default,,0,0,0,,Бұл таңертең көктемгі толқында болған оқиға.
Dialogue: 0,0:05:37.96,0:05:39.67,Default,,0,0,0,,Ахаха! ‬
Dialogue: 0,0:05:39.79,0:05:44.09,Default,,0,0,0,,Балалық шағында мұхитты жалғыз кешіп өту бірінші рет қызық.
Dialogue: 0,0:05:44.21,0:05:46.17,Default,,0,0,0,,(Йоичи) Иә, «Кусацудағы ағай мен апай»
Dialogue: 0,0:05:46.30,0:05:48.93,Default,,0,0,0,,«Әже, қайырлы таң» - деймін.
Dialogue: 0,0:05:49.05,0:05:52.10,Default,,0,0,0,,«Әкелер қалаға кешігіп келді».
Dialogue: 0,0:05:52.22,0:05:53.81,Default,,0,0,0,,«Қарбыз өтінемін»
Dialogue: 0,0:05:54.31,0:05:56.68,Default,,0,0,0,,А, бұрышта қарбыз бар.
Dialogue: 0,0:05:56.81,0:05:59.31,Default,,0,0,0,,‪（）‬ ‪（･）‬
Dialogue: 0,0:05:59.44,0:06:01.61,Default,,0,0,0,,(1-түйінді сөз) Қараңдаршы, менің ойнауға уақытым жоқ.
Dialogue: 0,0:06:01.73,0:06:04.73,Default,,0,0,0,,Менің ағам өте қатал адам еді.
Dialogue: 0,0:06:04.86,0:06:06.74,Default,,0,0,0,,Күте тұрыңыз...
Dialogue: 0,0:06:07.74,0:06:09.66,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:06:09.78,0:06:13.79,Default,,0,0,0,,Менің әкем мен анам... у...
Dialogue: 0,0:06:13.91,0:06:15.12,Default,,0,0,0,,Sui... Cap
Dialogue: 0,0:06:16.00,0:06:17.50,Default,,0,0,0,,Қарбыз, өтінемін (Морита) Хаа...
Dialogue: 0,0:06:17.62,0:06:20.00,Default,,0,0,0,,Рахмет. Құрбандық жасайық.
Dialogue: 0,0:06:20.12,0:06:23.54,Default,,0,0,0,,Хохо Беппин-санджа
Dialogue: 0,0:06:20.12,0:06:23.54,Default,,0,0,0,,(бұрышта ызылдау)
Dialogue: 0,0:06:23.54,0:06:23.67,Default,,0,0,0,,(бұрышта ызылдау)
Dialogue: 0,0:06:23.67,0:06:25.13,Default,,0,0,0,,(бұрышта ызылдау)
Dialogue: 0,0:06:23.67,0:06:25.13,Default,,0,0,0,,Әже жыл сайын⸺
Dialogue: 0,0:06:25.13,0:06:25.25,Default,,0,0,0,,(бұрышта ызылдау)
Dialogue: 0,0:06:25.25,0:06:26.34,Default,,0,0,0,,(бұрышта ызылдау)
Dialogue: 0,0:06:25.25,0:06:26.34,Default,,0,0,0,,Ол маған жаңа кимоно жасап, мені күтті.
Dialogue: 0,0:06:26.34,0:06:26.46,Default,,0,0,0,,Ол маған жаңа кимоно жасап, мені күтті.
Dialogue: 0,0:06:26.46,0:06:27.38,Default,,0,0,0,,Ол маған жаңа кимоно жасап, мені күтті.
Dialogue: 0,0:06:26.46,0:06:27.38,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:27.38,0:06:27.51,Default,,0,0,0,,Ол маған жаңа кимоно жасап, мені күтті.
Dialogue: 0,0:06:27.51,0:06:29.51,Default,,0,0,0,,Ол маған жаңа кимоно жасап, мені күтті.
Dialogue: 0,0:06:27.51,0:06:29.51,Default,,0,0,0,,Сәлем, мен үйдемін (Джуро)
Dialogue: 0,0:06:29.63,0:06:33.51,Default,,0,0,0,,Әкем мен шешем дүкен аралап шыққан соң, мен бейітті зиярат еттім.
Dialogue: 0,0:06:35.60,0:06:36.85,Default,,0,0,0,,Сіз қалай ойлайсыз? Энами
Dialogue: 0,0:06:37.43,0:06:41.52,Default,,0,0,0,,(Джуро) Жарайды, қиын. Біз порт салып жатқандықтан...
Dialogue: 0,0:06:41.65,0:06:43.06,Default,,0,0,0,,(Морита) Солай ма?
Dialogue: 0,0:06:43.73,0:06:46.73,Default,,0,0,0,,(1-кілт) Хмм~ Ууууу~
Dialogue: 0,0:06:46.86,0:06:48.61,Default,,0,0,0,,Мм.
Dialogue: 0,0:06:49.32,0:06:51.03,Default,,0,0,0,,Әртүрлі
Dialogue: 0,0:06:53.45,0:06:56.49,Default,,0,0,0,,Бала болғанның айыбы жоқ.
Dialogue: 0,0:06:56.62,0:06:58.16,Default,,0,0,0,,Мен көп нәрсені көре алатындай сезінемін.
Dialogue: 0,0:06:58.16,0:06:59.25,Default,,0,0,0,,Мен көп нәрсені көре алатындай сезінемін.
Dialogue: 0,0:06:58.16,0:06:59.25,Default,,0,0,0,,(тақтаны ашу дыбысы)
Dialogue: 0,0:07:03.71,0:07:05.04,Default,,0,0,0,,Ха…
Dialogue: 0,0:07:06.59,0:07:07.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:17.85,0:07:20.60,Default,,0,0,0,,Сәлем... Сәлем...
Dialogue: 0,0:07:23.69,0:07:24.56,Default,,0,0,0,,Ах
Dialogue: 0,0:07:25.90,0:07:27.32,Default,,0,0,0,,Мм...
Dialogue: 0,0:07:28.40,0:07:31.28,Default,,0,0,0,,Тағы да аламыз ба? ‬
Dialogue: 0,0:07:35.07,0:07:36.74,Default,,0,0,0,,Ана
Dialogue: 0,0:07:39.00,0:07:42.42,Default,,0,0,0,,(Джуро) Қараңдаршы, толқын азайып барады.
Dialogue: 0,0:07:42.87,0:07:44.54,Default,,0,0,0,,(Джуро) Міне, дайындал (Йоичи) Ух... хмм.
Dialogue: 0,0:07:45.54,0:07:47.38,Default,,0,0,0,,Сумимоны қараңыз
Dialogue: 0,0:07:48.59,0:07:49.59,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:07:51.34,0:07:55.43,Default,,0,0,0,,Мені жалғыз қалдырсаң, тамақты кейінірек кел.
Dialogue: 0,0:07:55.55,0:07:57.64,Default,,0,0,0,,Иә Хотара
Dialogue: 0,0:07:58.22,0:08:00.89,Default,,0,0,0,,Кимоноңды тастап кетсем, неге келмейсің? ‬
Dialogue: 0,0:08:02.10,0:08:05.40,Default,,0,0,0,,Сузу-чан сондай мейірімді.
Dialogue: 0,0:08:06.06,0:08:08.77,Default,,0,0,0,,«Мектептегі мұғалімім айтты⸺»
Dialogue: 0,0:08:08.90,0:08:10.90,Default,,0,0,0,,«Бұл Зашики Вараси болуы керек».
Dialogue: 0,0:08:11.03,0:08:13.74,Default,,0,0,0,,Сол күні кешке ағам айтты.
Dialogue: 0,0:08:13.86,0:08:17.41,Default,,0,0,0,,Табиғат пен адамдар жұмсақ әрі бұлыңғыр болып көрінді.
Dialogue: 0,0:08:18.33,0:08:21.62,Default,,0,0,0,,(Йоичи) Иә!? Кимоноңызды Кусацуда қалдырдыңыз ба? ‬
Dialogue: 0,0:08:21.75,0:08:24.58,Default,,0,0,0,,Қазір барып ал, жүз, ақымақ! ‬
Dialogue: 0,0:08:24.71,0:08:25.50,Default,,0,0,0,,Ой! ‬
Dialogue: 0,0:08:26.71,0:08:30.05,Default,,0,0,0,,«Они-чанның» қорқынышты екенін де ұмытып кетіппін.
Dialogue: 0,0:08:31.76,0:08:33.51,Default,,0,0,0,,Уау
Dialogue: 0,0:08:35.72,0:08:39.72,Default,,0,0,0,,(1-кілт) Сузу төмен ілулі, жел бар
Dialogue: 0,0:08:39.85,0:08:40.89,Default,,0,0,0,,Иә
Dialogue: 0,0:08:41.60,0:08:44.06,Default,,0,0,0,,Әй, анашым, маған 2 сен беріңізші.
Dialogue: 0,0:08:44.19,0:08:45.73,Default,,0,0,0,,Мен қарындашымды тастадым.
Dialogue: 0,0:08:45.85,0:08:47.15,Default,,0,0,0,,(Негізгі тармақ 1) Қалтаңыздың ақшасын алғанша ұстамаңыз.
Dialogue: 0,0:08:48.77,0:08:51.53,Default,,0,0,0,,Дудл жасамасаңыз, жақсы болады.
Dialogue: 0,0:08:54.20,0:08:56.49,Default,,0,0,0,,Суми-чан, қарындашты ауыстырайын ба?
Dialogue: 0,0:08:56.61,0:08:57.45,Default,,0,0,0,,Жақсы
Dialogue: 0,0:08:57.57,0:09:01.41,Default,,0,0,0,,Мизухарадан келген Сузу Тецу-кун, ол күнде мектепке келе ме? ‬
Dialogue: 0,0:09:01.54,0:09:03.16,Default,,0,0,0,,Ал, мен келемін.
Dialogue: 0,0:09:03.29,0:09:03.96,Default,,0,0,0,,(Сузуми) Ахаха...
Dialogue: 0,0:09:03.96,0:09:05.92,Default,,0,0,0,,(Сузуми) Ахаха...
Dialogue: 0,0:09:03.96,0:09:05.92,Default,,0,0,0,,Шынымен суық.
Dialogue: 0,0:09:08.17,0:09:10.34,Default,,0,0,0,,Эй, суық~ О, суық~
Dialogue: 0,0:09:14.34,0:09:15.51,Default,,0,0,0,,Иә
Dialogue: 0,0:09:29.19,0:09:30.44,Default,,0,0,0,,Иә
Dialogue: 0,0:09:31.69,0:09:32.98,Default,,0,0,0,,‪（･）‬
Dialogue: 0,0:09:33.78,0:09:36.24,Default,,0,0,0,,Осы апта осымен бітті
Dialogue: 0,0:09:36.36,0:09:38.53,Default,,0,0,0,,Бұл жолы оны тастамауға тырысыңыз.
Dialogue: 0,0:09:39.07,0:09:40.16,Default,,0,0,0,,Ах
Dialogue: 0,0:09:40.41,0:09:41.49,Default,,0,0,0,,Не? ‬
Dialogue: 0,0:09:42.95,0:09:44.79,Default,,0,0,0,,(Тетсу) Хмм, ол қайда?
Dialogue: 0,0:09:44.91,0:09:45.71,Default,,0,0,0,,Ах
Dialogue: 0,0:09:45.83,0:09:47.50,Default,,0,0,0,,(Оқушылардың таңданған дауыстары)
Dialogue: 0,0:09:50.04,0:09:52.75,Default,,0,0,0,,(Философия)
Dialogue: 0,0:09:52.88,0:09:56.09,Default,,0,0,0,,Ах... анау Мизухара-сан.
Dialogue: 0,0:09:57.84,0:09:59.76,Default,,0,0,0,,Менің анам
Dialogue: 0,0:09:59.89,0:10:00.97,Default,,0,0,0,,Бұл...
Dialogue: 0,0:10:01.89,0:10:04.72,Default,,0,0,0,,Мен сізге бір нәрсемен көмектесе аламын ба?
Dialogue: 0,0:10:05.14,0:10:06.81,Default,,0,0,0,,Апайға айтыңыз...
Dialogue: 0,0:10:08.60,0:10:10.73,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:10:17.65,0:10:20.20,Default,,0,0,0,,(Оқушылар) Ой... Әй! ‬
Dialogue: 0,0:10:20.32,0:10:21.24,Default,,0,0,0,,(Оқушы) А? (Студент) Иә...
Dialogue: 0,0:10:21.37,0:10:23.28,Default,,0,0,0,,А... Иә? ‬
Dialogue: 0,0:10:24.04,0:10:24.62,Default,,0,0,0,,(Тэцу) Жарайды, бұл алмастырушы.
Dialogue: 0,0:10:24.62,0:10:25.58,Default,,0,0,0,,(Тэцу) Жарайды, бұл алмастырғыш.
Dialogue: 0,0:10:24.62,0:10:25.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:25.58,0:10:26.20,Default,,0,0,0,,(Тэцу) Жарайды, бұл алмастырғыш.
Dialogue: 0,0:10:26.20,0:10:26.66,Default,,0,0,0,,(Тецу) Жарайды, бұл алмастырғыш.
Dialogue: 0,0:10:26.20,0:10:26.66,Default,,0,0,0,,Әй, қайтар!
Dialogue: 0,0:10:26.66,0:10:26.79,Default,,0,0,0,,Әй, қайтар!
Dialogue: 0,0:10:26.79,0:10:28.62,Default,,0,0,0,,Әй, қайтар!
Dialogue: 0,0:10:26.79,0:10:28.62,Default,,0,0,0,,Бұл «U» бірінші негіз «А» қос
Dialogue: 0,0:10:28.62,0:10:28.75,Default,,0,0,0,,Бұл «U» бірінші негіз «А» қос
Dialogue: 0,0:10:28.75,0:10:29.17,Default,,0,0,0,,Бұл «U» бірінші негіз «А» қос
Dialogue: 0,0:10:28.75,0:10:29.17,Default,,0,0,0,,Қайрау үшін қиналсам да!
Dialogue: 0,0:10:29.17,0:10:29.29,Default,,0,0,0,,Мен оны қайрау үшін қиналсам да!
Dialogue: 0,0:10:29.29,0:10:30.08,Default,,0,0,0,,Мен оны қайрау үшін қиналсам да!
Dialogue: 0,0:10:29.29,0:10:30.08,Default,,0,0,0,,(бала) Эй
Dialogue: 0,0:10:30.08,0:10:30.21,Default,,0,0,0,,Мен оны қайрау үшін қиналсам да!
Dialogue: 0,0:10:30.21,0:10:30.88,Default,,0,0,0,,Қайрау үшін қиналсам да!
Dialogue: 0,0:10:30.21,0:10:30.88,Default,,0,0,0,,(Бала) Мизухара Кез келген нәрсе
Dialogue: 0,0:10:30.88,0:10:31.83,Default,,0,0,0,,(Бала) Мизухара Кез келген нәрсе
Dialogue: 0,0:10:31.96,0:10:34.80,Default,,0,0,0,,Мен не істеуім керек? ‬
Dialogue: 0,0:10:34.92,0:10:35.71,Default,,0,0,0,,Ах
Dialogue: 0,0:10:36.34,0:10:38.22,Default,,0,0,0,,Ах! (Оқушылар) Иә.
Dialogue: 0,0:10:38.34,0:10:42.14,Default,,0,0,0,,А, мен бір күн бұрын қарындашымды осында түсіріп алдым! ‬
Dialogue: 0,0:10:42.26,0:10:43.93,Default,,0,0,0,,Бейшара Сузу-чан
Dialogue: 0,0:10:44.06,0:10:47.06,Default,,0,0,0,,Ах... ах~ (Тецу) Цк
Dialogue: 0,0:10:48.52,0:10:50.23,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:10:50.35,0:10:52.98,Default,,0,0,0,,Егер сіз байсалды болсаңыз, оны белгілеңіз.
Dialogue: 0,0:10:53.11,0:10:54.19,Default,,0,0,0,,Eye ta ta ta ta
Dialogue: 0,0:10:54.32,0:10:56.69,Default,,0,0,0,,(Ұлдар) Мизухара тоқтаңдар, қыздар.
Dialogue: 0,0:10:56.82,0:10:57.78,Default,,0,0,0,,(Ұлдар) Мен шыдай алмаймын.
Dialogue: 0,0:10:57.90,0:10:59.90,Default,,0,0,0,,Хмм.
Dialogue: 0,0:11:00.03,0:11:05.28,Default,,0,0,0,,Сувонды көргенде тезірек қашып кет. Мен қыздарға арналған ережелерді ұмытып кеттім.
Dialogue: 0,0:11:05.41,0:11:08.87,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:11:09.00,0:11:11.29,Default,,0,0,0,,(Мұғалім) Бүгінгі сурет – еркін сурет.
Dialogue: 0,0:11:11.42,0:11:13.63,Default,,0,0,0,,Оны жіберген адамнан қайтаруыңызды сұраймыз.
Dialogue: 0,0:11:13.75,0:11:14.79,Default,,0,0,0,,(Оқушылар) Иә.
Dialogue: 0,0:11:14.92,0:11:17.92,Default,,0,0,0,,Қай жерде сурет салу керек? Эй
Dialogue: 0,0:11:18.71,0:11:20.34,Default,,0,0,0,,(Мұғалім) Иә, иә.
Dialogue: 0,0:11:20.47,0:11:22.55,Default,,0,0,0,,Урано Янудан күткендей
Dialogue: 0,0:11:22.68,0:11:24.35,Default,,0,0,0,,Ал, Сузу-чан, бұл жақсы.
Dialogue: 0,0:11:24.47,0:11:25.26,Default,,0,0,0,,Эхехе
Dialogue: 0,0:11:25.39,0:11:28.18,Default,,0,0,0,,Мен таңертең ұйықтап қалдым.
Dialogue: 0,0:11:31.19,0:11:33.10,Default,,0,0,0,,Дәл қазір
Dialogue: 0,0:11:35.15,0:11:37.44,Default,,0,0,0,,Жүр, мен кокубаны алып кетейін.
Dialogue: 0,0:11:37.57,0:11:39.07,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:11:47.83,0:11:48.62,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:11:51.87,0:11:52.96,Default,,0,0,0,,га
Dialogue: 0,0:11:55.46,0:11:56.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:57.63,0:12:03.43,Default,,0,0,0,,Мизухара-сан, мен Изуру-санмен ешқашан үйге бара алмаймын.
Dialogue: 0,0:12:03.55,0:12:04.80,Default,,0,0,0,,(Философия) Артқа қайтпайды
Dialogue: 0,0:12:05.43,0:12:09.35,Default,,0,0,0,,Әкесі мен анасы теңіз балдырларын маринадтап, оны ішті.
Dialogue: 0,0:12:09.47,0:12:10.77,Default,,0,0,0,,Мен теңізді жек көремін
Dialogue: 0,0:12:11.52,0:12:12.89,Default,,0,0,0,,(Тетсу) Мен оны сала алмаймын...
Dialogue: 0,0:12:13.02,0:12:15.23,Default,,0,0,0,,(Тетсу) Урано, сен маған көмектесе аласың ба? ‬
Dialogue: 0,0:12:19.07,0:12:20.32,Default,,0,0,0,,Не? (Философия) мұны істе
Dialogue: 0,0:12:22.65,0:12:24.03,Default,,0,0,0,,Е, гейдемо
Dialogue: 0,0:12:24.16,0:12:27.12,Default,,0,0,0,,Менің ағамның үйі.
Dialogue: 0,0:12:27.74,0:12:29.66,Default,,0,0,0,,Қоян жоғары-төмен секіреді.
Dialogue: 0,0:12:29.79,0:12:33.62,Default,,0,0,0,,Жаңа жылдық апатта теңіз осылай болды.
Dialogue: 0,0:12:33.75,0:12:36.00,Default,,0,0,0,,Мен оны салғым келсе, сіз оны салыңыз.
Dialogue: 0,0:12:36.13,0:12:38.09,Default,,0,0,0,,Тіпті мына қызықсыз теңізде де
Dialogue: 0,0:12:40.71,0:12:44.05,Default,,0,0,0,,Мизухара мырза, бұл нені білдіреді? ‬
Dialogue: 0,0:12:44.18,0:12:46.30,Default,,0,0,0,,(Тетсу) Иә? О
Dialogue: 0,0:12:46.89,0:12:49.72,Default,,0,0,0,,Ақ толқындар секірген қоян тәрізді.
Dialogue: 0,0:12:50.43,0:12:53.02,Default,,0,0,0,,Мизухара-сан, саған ағаңды беруім керек пе? ‬
Dialogue: 0,0:12:53.14,0:12:54.06,Default,,0,0,0,,(Философия) Қажет емес
Dialogue: 0,0:12:54.94,0:12:56.19,Default,,0,0,0,,Мен Ураноның ағасын көргенде
Dialogue: 0,0:12:56.31,0:12:59.69,Default,,0,0,0,,Ерлердің бар жылдамдықпен қашатын заңы бар.
Dialogue: 0,0:13:01.82,0:13:03.07,Default,,0,0,0,,Хойде
Dialogue: 0,0:13:03.78,0:13:08.78,Default,,0,0,0,,Әскери-теңіз мектебінде оқып, теңізде батып кеткен ақымақтан жақсысың.
Dialogue: 0,0:13:09.78,0:13:13.75,Default,,0,0,0,,Бұл дұрыс емес, ақ қоян сияқты.
Dialogue: 0,0:13:15.04,0:13:17.08,Default,,0,0,0,,Иә, мен мұны істедім.
Dialogue: 0,0:13:17.21,0:13:20.00,Default,,0,0,0,,(Тетсу) Оны жинағаныңызға рахмет.
Dialogue: 0,0:13:21.25,0:13:23.76,Default,,0,0,0,,Ах... (Тэцу) Жарайды, мен ештеңе істемеймін.
Dialogue: 0,0:13:24.30,0:13:27.09,Default,,0,0,0,,Егер қолымнан келсе, үйге барудың қажеті болмас еді.
Dialogue: 0,0:13:27.64,0:13:31.72,Default,,0,0,0,,Қараңғы суреттерге қарасаң теңізді жек көре алмайсың.
Dialogue: 0,0:13:38.15,0:13:42.23,Default,,0,0,0,,(Радио: Ер) Тынық мұхитының шығысында әрекет ететін Император Әскери-теңіз күштері...
Dialogue: 0,0:13:42.36,0:13:46.74,Default,,0,0,0,,(Халық) Аман болсын, аман болсын...
Dialogue: 0,0:13:48.24,0:13:51.66,Default,,0,0,0,,(Еркек) Моританың немере қарындасы Бұл жерде қызған дұрыс.
Dialogue: 0,0:13:51.78,0:13:52.58,Default,,0,0,0,,Ай
Dialogue: 0,0:13:54.50,0:13:57.92,Default,,0,0,0,,О, бұл әдемі жауынгерлік киім.
Dialogue: 0,0:13:58.04,0:14:00.08,Default,,0,0,0,,Хмм, хехе...
Dialogue: 0,0:14:00.21,0:14:03.09,Default,,0,0,0,,(Чизуко/Суми) Уау~ Суық~
Dialogue: 0,0:14:03.88,0:14:05.17,Default,,0,0,0,,Хаах
Dialogue: 0,0:14:12.89,0:14:16.52,Default,,0,0,0,,Иә, жақсарып келеді.
Dialogue: 0,0:14:16.64,0:14:18.52,Default,,0,0,0,,Әй, түскі асты сол жерде ішейік.
Dialogue: 0,0:14:18.64,0:14:20.73,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:21.65,0:14:22.73,Default,,0,0,0,,(Чизуко) Алыста! ‬
Dialogue: 0,0:14:22.86,0:14:24.11,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:14:24.23,0:14:27.28,Default,,0,0,0,,(Чизуко) Сузу-ни-чан, үйлену үшін алысқа бару керек.
Dialogue: 0,0:14:27.40,0:14:28.70,Default,,0,0,0,,Хонан? ‬
Dialogue: 0,0:14:28.82,0:14:30.45,Default,,0,0,0,,Сумини-чан жақын.
Dialogue: 0,0:14:30.57,0:14:36.00,Default,,0,0,0,,Таяқтарды алыс ұстаған бала үйлену үшін алысқа кетуі керек.
Dialogue: 0,0:14:36.12,0:14:37.79,Default,,0,0,0,,(Сузуми) Иә...
Dialogue: 0,0:14:37.91,0:14:39.92,Default,,0,0,0,,Сенің әжең қайдан шыққан? ‬
Dialogue: 0,0:14:40.04,0:14:43.71,Default,,0,0,0,,Иә? Менің атым Фуру.
Dialogue: 0,0:14:43.84,0:14:46.51,Default,,0,0,0,,Көрші Фуруден Кусацуға дейін
Dialogue: 0,0:14:46.63,0:14:50.51,Default,,0,0,0,,Егер сіз Маньчжурияда немесе басқа жерде болған болсаңыз, тіпті таяқшалар да жеткіліксіз.
Dialogue: 0,0:14:50.63,0:14:54.68,Default,,0,0,0,,Суми Урано мұны айтып тұрғанда таяқшаларын алды.
Dialogue: 0,0:14:54.81,0:14:57.93,Default,,0,0,0,,Тым жақын болса, арман жоқ.
Dialogue: 0,0:14:58.06,0:14:59.31,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:14:59.44,0:15:00.64,Default,,0,0,0,,Иә? иә? ‬
Dialogue: 0,0:15:00.77,0:15:03.61,Default,,0,0,0,,Ха! Сузу-чан жақында үйге келеді
Dialogue: 0,0:15:03.73,0:15:06.40,Default,,0,0,0,,Мен қазір телефонға қоңырау шалған бірдеңені ойласам ше?
Dialogue: 0,0:15:06.53,0:15:09.82,Default,,0,0,0,,Біреу әйеліңе кел деді.
Dialogue: 0,0:15:09.95,0:15:11.32,Default,,0,0,0,,Күреден бастап
Dialogue: 0,0:15:11.45,0:15:12.36,Default,,0,0,0,,Ву? ‬
Dialogue: 0,0:15:12.49,0:15:15.83,Default,,0,0,0,,Сузу-чан, сен нешедесің? ‬
Dialogue: 0,0:15:15.95,0:15:20.37,Default,,0,0,0,,19… 18-ге толы
Dialogue: 0,0:15:20.50,0:15:24.38,Default,,0,0,0,,Ұнамаса, жоқ деп айта алмайсың. Келіңіз, менімен танысыңыз.
Dialogue: 0,0:15:24.50,0:15:27.30,Default,,0,0,0,,Сузу-чан, бір сәт осында кел
Dialogue: 0,0:15:28.55,0:15:32.38,Default,,0,0,0,,Бір күні сен үйленгенде ойланамын.
Dialogue: 0,0:15:32.51,0:15:34.47,Default,,0,0,0,,Мен оны жөндедім.
Dialogue: 0,0:15:34.60,0:15:37.77,Default,,0,0,0,,Шешім болса, жарайды.
Dialogue: 0,0:15:39.81,0:15:41.31,Default,,0,0,0,,Рахмет
Dialogue: 0,0:15:42.10,0:15:46.61,Default,,0,0,0,,Олай болса ана жақтағы үйде тойлайық.
Dialogue: 0,0:15:46.73,0:15:47.73,Default,,0,0,0,,Иә
Dialogue: 0,0:15:47.86,0:15:49.82,Default,,0,0,0,,Сол түн, күйеу балам
Dialogue: 0,0:15:49.94,0:15:53.11,Default,,0,0,0,,«Сіз қолшатыр әкелдіңіз бе?»
Dialogue: 0,0:15:53.24,0:15:54.07,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:15:54.20,0:15:59.12,Default,,0,0,0,,Біреуін сұрағанымда: «Мен саған жаңасын әкелдім» дедім.
Dialogue: 0,0:15:59.24,0:16:02.75,Default,,0,0,0,,«Мен оны қосуға болады ма?» деп сұрағанда.
Dialogue: 0,0:16:02.87,0:16:05.50,Default,,0,0,0,,«Өтінемін» деңіз Жарайды? ‬
Dialogue: 0,0:16:05.63,0:16:08.21,Default,,0,0,0,,Иә? Неліктен? Бәрі болады
Dialogue: 0,0:16:08.34,0:16:11.05,Default,,0,0,0,,Шамасы, біз өсетін боламыз.
Dialogue: 0,0:16:11.59,0:16:15.43,Default,,0,0,0,,Куреутара әскери порты орналасқан жерде.
Dialogue: 0,0:16:15.55,0:16:18.10,Default,,0,0,0,,Теңізші кетіп бара жатты
Dialogue: 0,0:16:19.10,0:16:19.89,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:16:20.68,0:16:23.52,Default,,0,0,0,,Иә? Иә? ‬
Dialogue: 0,0:16:23.64,0:16:24.90,Default,,0,0,0,,Мизухара мырза? ‬
Dialogue: 0,0:16:26.73,0:16:28.27,Default,,0,0,0,,Көптен бері көрмеген
Dialogue: 0,0:16:28.40,0:16:30.61,Default,,0,0,0,,(Тэцу) Тезірек үйге қайт, иә? ‬
Dialogue: 0,0:16:30.73,0:16:33.99,Default,,0,0,0,,(Тэцу) Анаң қатты шу шығарды.
Dialogue: 0,0:16:34.11,0:16:35.91,Default,,0,0,0,,Маңайдағылардың бәрі біледі
Dialogue: 0,0:16:37.03,0:16:39.41,Default,,0,0,0,,Ах! Мен асығыс болдым
Dialogue: 0,0:16:39.54,0:16:41.45,Default,,0,0,0,,Сіздің менің қарсыласым екеніңізге сенімдімін...
Dialogue: 0,0:16:41.58,0:16:42.96,Default,,0,0,0,,Сен ақымақсың ба? ‬
Dialogue: 0,0:16:43.54,0:16:47.50,Default,,0,0,0,,Ағамның қайтыс болғанына жеті жыл толғанда салтанатты түрде елге оралдым.
Dialogue: 0,0:16:47.63,0:16:49.55,Default,,0,0,0,,Ах... у...
Dialogue: 0,0:16:49.67,0:16:52.88,Default,,0,0,0,,Сіз басқа адамды танисыз ба?
Dialogue: 0,0:16:53.01,0:16:54.38,Default,,0,0,0,,Мүлде жоқ
Dialogue: 0,0:16:54.51,0:16:57.39,Default,,0,0,0,,Мен Суми Чан деп қателескен шығармын.
Dialogue: 0,0:16:58.05,0:17:00.43,Default,,0,0,0,,Суми-чан одан әдемі емес
Dialogue: 0,0:17:01.31,0:17:03.93,Default,,0,0,0,,(Философия) Мен олай ойламаймын.
Dialogue: 0,0:17:04.06,0:17:06.94,Default,,0,0,0,,(Энтаро) Міне, мен осы мектепке бара бастадым.
Dialogue: 0,0:17:07.06,0:17:09.61,Default,,0,0,0,,Мен оны алғаш рет бір жерден көрдім деп ойлаймын.
Dialogue: 0,0:17:09.73,0:17:13.82,Default,,0,0,0,,Үйіңді іздеу үлкен мәселе болды.
Dialogue: 0,0:17:13.94,0:17:17.36,Default,,0,0,0,,(Джуро) Біз де осыдан үш жыл бұрын Еба жағалауындағы мелиорацияға қатысқанбыз.
Dialogue: 0,0:17:17.49,0:17:19.82,Default,,0,0,0,,Мен желім қолдануды тоқтаттым.
Dialogue: 0,0:17:20.87,0:17:23.00,Default,,0,0,0,,Менің ойымша, ол жақында оралады.
Dialogue: 0,0:17:23.12,0:17:24.12,Default,,0,0,0,,Хаа
Dialogue: 0,0:17:24.25,0:17:26.08,Default,,0,0,0,,Иә, бұл әңгіме ме, жоқ па білмедім.
Dialogue: 0,0:17:26.08,0:17:27.25,Default,,0,0,0,,Иә, бұл әңгіме ме, жоқ па білмедім.
Dialogue: 0,0:17:26.08,0:17:27.25,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:17:27.37,0:17:31.30,Default,,0,0,0,,Аузыма карамель дәмі тарағанын сездім.
Dialogue: 0,0:17:31.42,0:17:32.88,Default,,0,0,0,,Қызық, неге?
Dialogue: 0,0:17:33.01,0:17:34.30,Default,,0,0,0,,О, Сабу...
Dialogue: 0,0:17:35.13,0:17:37.01,Default,,0,0,0,,Мен қиындыққа тап болдым.
Dialogue: 0,0:17:37.68,0:17:40.68,Default,,0,0,0,,Ұнамаса, жоқ деп айт.
Dialogue: 0,0:17:40.80,0:17:43.47,Default,,0,0,0,,Оны жек көретінін де, жек көрмейтінін де білмеді.
Dialogue: 0,0:17:43.60,0:17:44.89,Default,,0,0,0,,(Шусаку) Мм...
Dialogue: 0,0:17:45.77,0:17:46.69,Default,,0,0,0,,Иә
Dialogue: 0,0:17:48.60,0:17:50.81,Default,,0,0,0,,Мен адасып кете алмаймын.
Dialogue: 0,0:17:50.94,0:17:52.73,Default,,0,0,0,,(Шусаку) Қай трамвай аялдамасы? ‬
Dialogue: 0,0:17:52.86,0:17:55.32,Default,,0,0,0,,Осылай (Шусаку) Кешіріңіз.
Dialogue: 0,0:17:55.44,0:17:59.16,Default,,0,0,0,,Мен мейірімді теңізшіге айта алар едім.
Dialogue: 0,0:17:59.28,0:18:02.83,Default,,0,0,0,,А... дұрыс, ол біртүрлі адам екен.
Dialogue: 0,0:18:03.45,0:18:06.33,Default,,0,0,0,,Бейтаныс әйелдің жетегінде тауда болдым.
Dialogue: 0,0:18:06.46,0:18:08.25,Default,,0,0,0,,Үйге аман-есен жеткен сияқтысыз.
Dialogue: 0,0:18:08.37,0:18:09.29,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:18:12.59,0:18:16.30,Default,,0,0,0,,Менің ойымша, біз мүлдем бей-жай қалдық.
Dialogue: 0,0:18:17.30,0:18:20.68,Default,,0,0,0,,Қызық, бұл қашан болды?
Dialogue: 0,0:18:30.44,0:18:31.52,Default,,0,0,0,,Doganakane? Иә
Dialogue: 0,0:18:31.65,0:18:36.82,Default,,0,0,0,,(Әскери полиция) Қазірден бастап теңіз жағындағы жапқыштарды жабыңыз.
Dialogue: 0,0:18:42.70,0:18:45.99,Default,,0,0,0,,(Жолаушылар жөтеліп жатыр)
Dialogue: 0,0:18:46.12,0:18:47.87,Default,,0,0,0,,Бір жерде терезені ашыңыз
Dialogue: 0,0:18:52.17,0:18:55.75,Default,,0,0,0,,(Станция хабарландыруы) Күре~ Күре~
Dialogue: 0,0:18:55.88,0:18:57.30,Default,,0,0,0,,(оқ ату) Уф! ‬
Dialogue: 0,0:18:57.42,0:18:59.88,Default,,0,0,0,,(Джуро) Бұл теңіз флотының аккумуляторлық жаттығулары.
Dialogue: 0,0:19:00.01,0:19:01.68,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:19:14.31,0:19:16.73,Default,,0,0,0,,(дирижер) Кешіріңіз. Кешіріңіз.
Dialogue: 0,0:19:16.86,0:19:19.70,Default,,0,0,0,,(Джуро және басқалар) Ха ха ха...
Dialogue: 0,0:19:19.82,0:19:22.66,Default,,0,0,0,,(Кобаяшидің әйелі) Көмір автобусы келмес еді.
Dialogue: 0,0:19:22.78,0:19:25.70,Default,,0,0,0,,Аа, Кобаяши мырза (Джуро) О, сәлем.
Dialogue: 0,0:19:25.83,0:19:29.00,Default,,0,0,0,,Кобаяши мырза, бүгінгі көмегіңіз үшін рахмет.
Dialogue: 0,0:19:29.12,0:19:31.71,Default,,0,0,0,,(Кобаяшидің әйелі) Ауа райы жақсы.
Dialogue: 0,0:19:32.79,0:19:35.21,Default,,0,0,0,,Суенага, көмегіңіз үшін рахмет.
Dialogue: 0,0:19:35.34,0:19:37.50,Default,,0,0,0,,Кішкентай болсам да, саған перзент боламын.
Dialogue: 0,0:19:37.63,0:19:40.38,Default,,0,0,0,,Бұл Шусакудың Кобаяши апасы.
Dialogue: 0,0:19:40.51,0:19:42.68,Default,,0,0,0,,Мен матч ретінде қызмет етемін.
Dialogue: 0,0:19:42.80,0:19:45.39,Default,,0,0,0,,(Джуро) Сіз үйленетін адамның фамилиясын есіңізде сақтайсыз деп үміттенемін. ‬
Dialogue: 0,0:19:45.51,0:19:47.97,Default,,0,0,0,,Шынымен екеуі ғана болғаны дұрыс па?
Dialogue: 0,0:19:55.11,0:19:59.44,Default,,0,0,0,,Хмм, бұл шынымен де пайда болды.
Dialogue: 0,0:19:59.57,0:20:01.95,Default,,0,0,0,,Бұл ең жақсы бұрыш.
Dialogue: 0,0:20:02.07,0:20:03.49,Default,,0,0,0,,(Кобаяшидің әйелі) Міне, осы.
Dialogue: 0,0:20:03.61,0:20:05.99,Default,,0,0,0,,Ол келді.
Dialogue: 0,0:20:06.12,0:20:09.45,Default,,0,0,0,,(Энтаро) Бұл заманда бәрі оңай болғанына өкінемін.
Dialogue: 0,0:20:09.58,0:20:11.00,Default,,0,0,0,,(Джуро) Менің баламда бөртпе синдромы бар.
Dialogue: 0,0:20:11.00,0:20:11.37,Default,,0,0,0,,(Джуро) Менің баламда бөртпе синдромы бар.
Dialogue: 0,0:20:11.00,0:20:11.37,Default,,0,0,0,,Сузу-чан
Dialogue: 0,0:20:11.37,0:20:11.50,Default,,0,0,0,,Сузу-чан
Dialogue: 0,0:20:11.50,0:20:12.00,Default,,0,0,0,,Сузу-чан
Dialogue: 0,0:20:11.50,0:20:12.00,Default,,0,0,0,,Бұл өте дұрыс.
Dialogue: 0,0:20:12.00,0:20:12.62,Default,,0,0,0,,Бұл өте дұрыс.
Dialogue: 0,0:20:12.62,0:20:13.79,Default,,0,0,0,,Бұл өте дұрыс.
Dialogue: 0,0:20:12.62,0:20:13.79,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:20:13.92,0:20:15.54,Default,,0,0,0,,(Энтаро) Жарайды, менің балам да.
Dialogue: 0,0:20:13.92,0:20:15.54,Default,,0,0,0,,Бұл жерде сіздің ең жақсы киіміңіз босқа кетеді.
Dialogue: 0,0:20:15.54,0:20:16.50,Default,,0,0,0,,Бұл жерде сіздің ең жақсы киіміңіз босқа кетеді.
Dialogue: 0,0:20:17.38,0:20:19.46,Default,,0,0,0,,Ах! Бұл Сузу! ‬
Dialogue: 0,0:20:19.59,0:20:21.84,Default,,0,0,0,,Киімді қай жерде шешуім керек?
Dialogue: 0,0:20:21.97,0:20:27.64,Default,,0,0,0,,(Сутра оқу)
Dialogue: 0,0:20:28.64,0:20:30.52,Default,,0,0,0,,(Кобаяши) Бұл тағы бір үлкен мереке.
Dialogue: 0,0:20:30.64,0:20:33.52,Default,,0,0,0,,Шынымен, мына баланың ағасы келе алмайтыны ұят.
Dialogue: 0,0:20:33.64,0:20:36.40,Default,,0,0,0,,(Джуро) Сіз шынымен де осы заттардың барлығын жинадыңыз.
Dialogue: 0,0:20:36.52,0:20:38.19,Default,,0,0,0,,(Кобаяшидің әйелі) Жақсы тамақтан!
Dialogue: 0,0:20:38.32,0:20:40.73,Default,,0,0,0,,Бәріміз осы үйде кешке төлейік.
Dialogue: 0,0:20:40.73,0:20:41.65,Default,,0,0,0,,Барлығымыз осы үйде кешке төлейік.
Dialogue: 0,0:20:40.73,0:20:41.65,Default,,0,0,0,,Аха…
Dialogue: 0,0:20:41.78,0:20:44.32,Default,,0,0,0,,(Джуро) Бұл бұқтырды да қайнатады.
Dialogue: 0,0:20:45.61,0:20:48.83,Default,,0,0,0,,Сіз тыныш адам екенсіз.
Dialogue: 0,0:20:48.95,0:20:51.04,Default,,0,0,0,,Бұндай жерде ешкім шу шығармайды деп ойлаймын.
Dialogue: 0,0:20:51.16,0:20:53.83,Default,,0,0,0,,(Джуро) Сен көп жұмыс жасадың. Сіз көп жұмыс жасадыңыз.
Dialogue: 0,0:20:54.46,0:20:57.04,Default,,0,0,0,,Сәлем, мен үйге барғанда.
Dialogue: 0,0:20:57.17,0:20:59.54,Default,,0,0,0,,Сәлем
Dialogue: 0,0:21:01.13,0:21:02.59,Default,,0,0,0,,(Мейко) Мен қайта ораламын.
Dialogue: 0,0:21:07.09,0:21:10.93,Default,,0,0,0,,Ал, бұл кім болды? ‬
Dialogue: 0,0:21:11.06,0:21:12.22,Default,,0,0,0,,(Энтаро) Менің әйелім де келді.
Dialogue: 0,0:21:12.81,0:21:16.31,Default,,0,0,0,,Үйдегінің бәрін маған қалдырып, тыныш ұйықта.
Dialogue: 0,0:21:16.44,0:21:17.56,Default,,0,0,0,,Иә
Dialogue: 0,0:21:18.90,0:21:23.19,Default,,0,0,0,,Қайын ата, ене, Көмек көрсеткендеріңізге көп рахмет.
Dialogue: 0,0:21:23.32,0:21:25.11,Default,,0,0,0,,Сәлем, Ину.
Dialogue: 0,0:21:25.82,0:21:28.70,Default,,0,0,0,,Мен аяғымды ауырттым.
Dialogue: 0,0:21:28.82,0:21:31.45,Default,,0,0,0,,Танысқаныма қуаныштымын, Сузу-сан
Dialogue: 0,0:21:31.58,0:21:32.49,Default,,0,0,0,,Иә
Dialogue: 0,0:21:33.50,0:21:34.87,Default,,0,0,0,,(Entaro) Кешіріңіз.
Dialogue: 0,0:21:35.00,0:21:37.62,Default,,0,0,0,,Қазанға пісірсең, ол үнемі жанып тұрады.
Dialogue: 0,0:21:37.75,0:21:38.67,Default,,0,0,0,,Хаа
Dialogue: 0,0:21:38.79,0:21:41.84,Default,,0,0,0,,Саған үйленуге кеткен жеңгең бе?
Dialogue: 0,0:21:55.39,0:21:58.81,Default,,0,0,0,,Иә? Ах...
Dialogue: 0,0:22:00.69,0:22:03.07,Default,,0,0,0,,(Шусаку) Әскери кеменің сәулеленуіне дайындық Вау.
Dialogue: 0,0:22:04.57,0:22:07.65,Default,,0,0,0,,Қызық, бәріміз қайдан келдік?
Dialogue: 0,0:22:08.53,0:22:09.99,Default,,0,0,0,,Ха...
Dialogue: 0,0:22:10.53,0:22:14.29,Default,,0,0,0,,(Шусакудың гуілдеуі)
Dialogue: 0,0:22:14.41,0:22:17.87,Default,,0,0,0,,Футон үшін рахмет
Dialogue: 0,0:22:18.00,0:22:19.00,Default,,0,0,0,,(Шусаку) Иә.
Dialogue: 0,0:22:20.17,0:22:23.50,Default,,0,0,0,,(сыбырлау)
Dialogue: 0,0:22:23.63,0:22:24.88,Default,,0,0,0,,(Шусаку) О, Сузу-сан
Dialogue: 0,0:22:25.01,0:22:26.30,Default,,0,0,0,,Иә
Dialogue: 0,0:22:26.88,0:22:29.51,Default,,0,0,0,,(Шусаку) Қолшатыр әкелгің келе ме? ‬
Dialogue: 0,0:22:33.47,0:22:35.52,Default,,0,0,0,,Иә... жаңа.
Dialogue: 0,0:22:36.39,0:22:37.68,Default,,0,0,0,,Бір бөтелке…
Dialogue: 0,0:22:38.56,0:22:40.44,Default,,0,0,0,,(Шусаку) Маған аздап қарыз беріңізші.
Dialogue: 0,0:22:44.57,0:22:45.86,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:22:47.32,0:22:48.61,Default,,0,0,0,,Көрдіңіз бе?
Dialogue: 0,0:22:48.74,0:22:52.16,Default,,0,0,0,,Жарайды, қарным ашты.
Dialogue: 0,0:22:55.83,0:22:58.29,Default,,0,0,0,,Неліктен әлі күнге дейін құлықсыз? ‬
Dialogue: 0,0:22:59.54,0:23:02.83,Default,,0,0,0,,Сіз күндіз ештеңе жеген жоқсыз.
Dialogue: 0,0:23:02.96,0:23:05.42,Default,,0,0,0,,Аузыңыздан тамақ ішпеңіз. Мен жеңілдеп қалдым.
Dialogue: 0,0:23:05.55,0:23:06.92,Default,,0,0,0,,(Шусаку) Арх! ‬
Dialogue: 0,0:23:07.05,0:23:10.88,Default,,0,0,0,,А... Уайымдама, уайымдама, мен жаңа ғана тұқымын іштім.
Dialogue: 0,0:23:11.55,0:23:13.10,Default,,0,0,0,,Дұрыс ауызша
Dialogue: 0,0:23:14.89,0:23:18.73,Default,,0,0,0,,Мм... біз бұрын бір жерде кездестік пе? ‬
Dialogue: 0,0:23:18.85,0:23:21.48,Default,,0,0,0,,(Шусаку) Иә, танысайық.
Dialogue: 0,0:23:21.60,0:23:23.11,Default,,0,0,0,,Есіңде жоқ па?
Dialogue: 0,0:23:23.23,0:23:24.23,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:23:24.36,0:23:27.23,Default,,0,0,0,,Үйде біз әдеттен тыс жұмыс істейміз.
Dialogue: 0,0:23:27.36,0:23:29.61,Default,,0,0,0,,(Шусаку) Ежелден ымырт болатын.
Dialogue: 0,0:23:31.45,0:23:34.57,Default,,0,0,0,,Бұл жерде баяғыда мең болған.
Dialogue: 0,0:24:07.32,0:24:11.70,Default,,0,0,0,,Құдықтың астында коммуналдық шатыр бар, келіңіздер...
Dialogue: 0,0:24:37.43,0:24:42.98,Default,,0,0,0,,Ходжо…
Dialogue: 0,0:24:48.86,0:24:49.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:24:49.82,0:24:51.03,Default,,0,0,0,,Мм...
Dialogue: 0,0:24:51.65,0:24:57.07,Default,,0,0,0,,Бұл Күре қаласындағы қандай қала және нөмір? ‬
Dialogue: 0,0:24:57.20,0:24:58.16,Default,,0,0,0,,(Энтаро/Шусаку) Иә? иә? ‬
Dialogue: 0,0:24:58.74,0:24:59.66,Default,,0,0,0,,Иә
Dialogue: 0,0:24:59.78,0:25:01.08,Default,,0,0,0,,(Энтаро) Хойджану
Dialogue: 0,0:25:01.20,0:25:02.16,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:25:04.16,0:25:08.54,Default,,0,0,0,,Осы жердегілердің бәрі Әскери-теңіз флотында жұмыс істей ме деп ойлаймын.
Dialogue: 0,0:25:14.34,0:25:15.43,Default,,0,0,0,,Ха...
Dialogue: 0,0:25:18.43,0:25:20.35,Default,,0,0,0,,(Домото) Ходжо мырза
Dialogue: 0,0:25:23.39,0:25:24.52,Default,,0,0,0,,Ходжо мырза
Dialogue: 0,0:25:24.64,0:25:25.81,Default,,0,0,0,,Иә
Dialogue: 0,0:25:25.94,0:25:27.27,Default,,0,0,0,,Тарату баж салығы?
Dialogue: 0,0:25:27.40,0:25:32.07,Default,,0,0,0,,Бұл жерде және мұнда әрқашан солай болады.
Dialogue: 0,0:25:32.19,0:25:34.07,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,0:25:34.19,0:25:36.45,Default,,0,0,0,,(Чита) Бұл Чита. (Қария) Бұл Қария.
Dialogue: 0,0:25:41.28,0:25:42.58,Default,,0,0,0,,(Чита) Қайтадан қараңыз
Dialogue: 0,0:25:42.70,0:25:44.45,Default,,0,0,0,,(Қария) Дұрыс өлшемейсің бе?
Dialogue: 0,0:25:44.58,0:25:46.87,Default,,0,0,0,,Егер сіз көз өлшемдері туралы айтып жатсаңыз, сіздікі не?
Dialogue: 0,0:25:47.00,0:25:48.79,Default,,0,0,0,,(Қария) Жоқ, (Чита) Бұл әділетсіздік болар еді.
Dialogue: 0,0:25:48.92,0:25:49.96,Default,,0,0,0,,(Қария) Нанан
Dialogue: 0,0:25:50.09,0:25:52.42,Default,,0,0,0,,(Чита) Дәл (Кария) Не? ‬
Dialogue: 0,0:25:52.55,0:25:55.13,Default,,0,0,0,,Маған сенің мұндай мінезің ұнамайды.
Dialogue: 0,0:25:55.26,0:25:56.47,Default,,0,0,0,,(Қария) Қайда?
Dialogue: 0,0:25:56.59,0:25:58.59,Default,,0,0,0,,Ахах... жас жас
Dialogue: 0,0:25:58.72,0:26:00.30,Default,,0,0,0,,Сіз құлап қалдыңыз.
Dialogue: 0,0:26:00.43,0:26:02.47,Default,,0,0,0,,Уау
Dialogue: 0,0:26:02.60,0:26:03.64,Default,,0,0,0,,Иә
Dialogue: 0,0:26:04.43,0:26:05.68,Default,,0,0,0,,Уау
Dialogue: 0,0:26:06.10,0:26:08.48,Default,,0,0,0,,(Чита) Айтата... Кешіріңіз.
Dialogue: 0,0:26:08.60,0:26:09.98,Default,,0,0,0,,Бұл өте маңызды.
Dialogue: 0,0:26:10.11,0:26:12.32,Default,,0,0,0,,Айта алмаймын
Dialogue: 0,0:26:12.44,0:26:14.78,Default,,0,0,0,,Егер тұтандырғыш бомба түссе
Dialogue: 0,0:26:14.90,0:26:19.16,Default,,0,0,0,,Ең алдымен әдепті әрекет керек...
Dialogue: 0,0:26:19.28,0:26:21.83,Default,,0,0,0,,(Домото) Жақын кел!
Dialogue: 0,0:26:21.95,0:26:24.04,Default,,0,0,0,,Мына орындық суық, солай емес пе?
Dialogue: 0,0:26:24.16,0:26:26.20,Default,,0,0,0,,(Чита/Кария) Иә, иә.
Dialogue: 0,0:26:27.41,0:26:30.50,Default,,0,0,0,,Бұл менің күнделікті өміріме айналды.
Dialogue: 0,0:26:30.63,0:26:34.38,Default,,0,0,0,,(қашықтан ұшып бара жатқан ұшақтардың дыбысы)
Dialogue: 0,0:26:41.51,0:26:45.27,Default,,0,0,0,,Әй, бұл Кейко қызының киімдері.
Dialogue: 0,0:26:45.39,0:26:47.39,Default,,0,0,0,,Бұл да қойма.
Dialogue: 0,0:26:47.52,0:26:50.94,Default,,0,0,0,,Мен оны киіп, күйеу баламды ертіп кетіп қалдым.
Dialogue: 0,0:26:50.94,0:26:52.19,Default,,0,0,0,,Мен оны киіп, күйеу баламмен кетіп қалдым.
Dialogue: 0,0:26:50.94,0:26:52.19,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:26:52.31,0:26:57.24,Default,,0,0,0,,Кино көру, батыс мейрамханаларына бару, эксполарға бару.
Dialogue: 0,0:26:57.78,0:27:02.45,Default,,0,0,0,,Уау, Мога еді, жеңгем.
Dialogue: 0,0:27:02.57,0:27:06.49,Default,,0,0,0,,Бұл әлі де әлем еді, солай емес пе?
Dialogue: 0,0:27:06.62,0:27:08.71,Default,,0,0,0,,Шусаку 4 жаста болғанда
Dialogue: 0,0:27:08.83,0:27:13.34,Default,,0,0,0,,Бейбітшілік үшін қарусыздану соғыс кемелерін жасау мүмкін болмады.
Dialogue: 0,0:27:13.46,0:27:17.76,Default,,0,0,0,,Менің халқым да осы жерде жұмыссыз.
Dialogue: 0,0:27:17.88,0:27:20.05,Default,,0,0,0,,Бұл үлкен мәселе болды.
Dialogue: 0,0:27:20.18,0:27:22.26,Default,,0,0,0,,Кейко дәл осындай қыз.
Dialogue: 0,0:27:22.39,0:27:26.56,Default,,0,0,0,,Өзіңіздің жұмысыңызды шешіп, күйеуіңізді өзіңіз табыңыз.
Dialogue: 0,0:27:26.68,0:27:30.85,Default,,0,0,0,,Жарайды, егер бізді қаласаң, жеңіліп қалмас үшін көп жұмыс істеу керек.
Dialogue: 0,0:27:32.81,0:27:36.32,Default,,0,0,0,,Ол кезде мен бұл үлкен мәселе деп ойлайтынмын.
Dialogue: 0,0:27:36.44,0:27:37.48,Default,,0,0,0,,(Тұрғындар) Аман болсын! ‬
Dialogue: 0,0:27:37.61,0:27:41.32,Default,,0,0,0,,Қиындық сияқты көрінген күндерді сағындым.
Dialogue: 0,0:27:45.49,0:27:47.29,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:27:49.70,0:27:51.71,Default,,0,0,0,,Сәлем.
Dialogue: 0,0:27:52.42,0:27:53.54,Default,,0,0,0,,Дәл қазір
Dialogue: 0,0:27:53.67,0:27:56.63,Default,,0,0,0,,Әй, қош келдің, жеңге.
Dialogue: 0,0:27:56.75,0:27:57.96,Default,,0,0,0,,Ах! ‬
Dialogue: 0,0:27:58.92,0:28:00.38,Default,,0,0,0,,Хаа... Саен
Dialogue: 0,0:28:00.51,0:28:01.68,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:28:02.93,0:28:06.85,Default,,0,0,0,,Күріш бүгінде бағалы тауар емес пе?
Dialogue: 0,0:28:06.97,0:28:08.22,Default,,0,0,0,,(Кейзи) Бұл сен туралы.
Dialogue: 0,0:28:08.93,0:28:12.77,Default,,0,0,0,,Хиросималық бала сондай жарқын болар деп ойладым.
Dialogue: 0,0:28:12.89,0:28:15.23,Default,,0,0,0,,Цугихагиге толы Монпеде не бар? ‬
Dialogue: 0,0:28:16.02,0:28:17.11,Default,,0,0,0,,Мүлдем!
Dialogue: 0,0:28:16.02,0:28:17.11,Default,,0,0,0,,(Харуми) Бұршақ қуырылған ба? ‬
Dialogue: 0,0:28:17.11,0:28:17.23,Default,,0,0,0,,(Харуми) Бұршақ қуырылған ба? ‬
Dialogue: 0,0:28:17.23,0:28:18.02,Default,,0,0,0,,(Харуми) Бұршақ қуырылған ба? ‬
Dialogue: 0,0:28:17.23,0:28:18.02,Default,,0,0,0,,Мен қызымды үнемі батыс киімінде көремін.
Dialogue: 0,0:28:18.02,0:28:18.15,Default,,0,0,0,,Мен қызымды үнемі батыстық киіммен көремін.
Dialogue: 0,0:28:18.15,0:28:19.90,Default,,0,0,0,,Мен қызымды үнемі батыс киімінде көремін.
Dialogue: 0,0:28:18.15,0:28:19.90,Default,,0,0,0,,Жарайды, Харуми-чан, қош келдіңіз.
Dialogue: 0,0:28:19.90,0:28:20.03,Default,,0,0,0,,Жарайды, Харуми-чан, қош келдіңіз.
Dialogue: 0,0:28:20.03,0:28:20.57,Default,,0,0,0,,Жарайды, Харуми-чан, қош келдіңіз.
Dialogue: 0,0:28:20.03,0:28:20.57,Default,,0,0,0,,Ұялатын адам – Шусаку-сан.
Dialogue: 0,0:28:20.57,0:28:20.69,Default,,0,0,0,,Ұят болатын адам – Шусаку.
Dialogue: 0,0:28:20.69,0:28:21.95,Default,,0,0,0,,Өзін ұятқа қалдыратын Шусаку-сан болуы керек.
Dialogue: 0,0:28:20.69,0:28:21.95,Default,,0,0,0,,Анашым, көңіл-күйіңіз нашар ма?
Dialogue: 0,0:28:21.95,0:28:22.07,Default,,0,0,0,,Мама, көңіл-күйіңіз нашар ма?
Dialogue: 0,0:28:22.07,0:28:24.07,Default,,0,0,0,,Анашым, көңіл-күйіңіз нашар ма?
Dialogue: 0,0:28:22.07,0:28:24.07,Default,,0,0,0,,Дұрыс дұрыс!
Dialogue: 0,0:28:24.20,0:28:25.70,Default,,0,0,0,,Харуми ересек Шушиторун
Dialogue: 0,0:28:25.70,0:28:25.91,Default,,0,0,0,,Харуми ересек Шушиторун
Dialogue: 0,0:28:25.70,0:28:25.91,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:28:25.91,0:28:26.03,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:28:26.03,0:28:26.83,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:28:26.03,0:28:26.83,Default,,0,0,0,,Жақсы көр
Dialogue: 0,0:28:26.83,0:28:27.24,Default,,0,0,0,,Даңқ
Dialogue: 0,0:28:27.37,0:28:28.99,Default,,0,0,0,,Қазір бізде осы ғана
Dialogue: 0,0:28:29.12,0:28:30.83,Default,,0,0,0,,Жаса! дәл қазір
Dialogue: 0,0:28:34.71,0:28:37.04,Default,,0,0,0,,Сондай-ақ, ол күріш кәдесыйдан ерекшеленеді.
Dialogue: 0,0:28:37.17,0:28:39.38,Default,,0,0,0,,Бұл маған және қызыма арналған! ‬
Dialogue: 0,0:28:40.92,0:28:44.18,Default,,0,0,0,,Хойде? Диази: мені тыңда анашым.
Dialogue: 0,0:28:44.30,0:28:47.26,Default,,0,0,0,,Сен әлсіреп қалдың.
Dialogue: 0,0:28:48.81,0:28:49.76,Default,,0,0,0,,Ой! ‬
Dialogue: 0,0:28:49.89,0:28:52.27,Default,,0,0,0,,Жоқ, жоқ, жоқ.
Dialogue: 0,0:28:52.39,0:28:56.31,Default,,0,0,0,,Сен сондай жаман болсаң, маған үйленбе.
Dialogue: 0,0:28:56.44,0:28:58.27,Default,,0,0,0,,Иә, мен бармаймын.
Dialogue: 0,0:29:00.02,0:29:02.07,Default,,0,0,0,,Хмм...
Dialogue: 0,0:29:02.49,0:29:03.78,Default,,0,0,0,,Уау
Dialogue: 0,0:29:05.66,0:29:09.03,Default,,0,0,0,,Ал, бел туралы...
Dialogue: 0,0:29:09.91,0:29:11.62,Default,,0,0,0,,Түсіндім.
Dialogue: 0,0:29:15.87,0:29:17.88,Default,,0,0,0,,Мм.
Dialogue: 0,0:29:22.71,0:29:23.92,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:29:26.80,0:29:31.22,Default,,0,0,0,,Оны шешіп, қайта бағалаңыз
Dialogue: 0,0:29:31.35,0:29:34.06,Default,,0,0,0,,Бірге тігу
Dialogue: 0,0:29:34.68,0:29:38.56,Default,,0,0,0,,Оның ішінен резеңкеден өткізіп, жұмыс бітті!
Dialogue: 0,0:29:42.03,0:29:43.61,Default,,0,0,0,,Бұл Харуми Куромура
Dialogue: 0,0:29:43.74,0:29:46.45,Default,,0,0,0,,Сәлеметсіз бе, бұл Сузу Ходжо.
Dialogue: 0,0:29:47.03,0:29:49.03,Default,,0,0,0,,Сузу-сан, маған жіпті бер
Dialogue: 0,0:29:49.16,0:29:51.74,Default,,0,0,0,,А, бұл жақсы ма? ‬
Dialogue: 0,0:30:06.05,0:30:07.13,Default,,0,0,0,,(Нацуо) Жоқ, «шектеу» дегеніміз – ақыр соңында адам өз-өзіне қоятын нәрсе.
Dialogue: 0,0:30:07.13,0:30:08.47,Default,,0,0,0,,(Нацуо) Жоқ, «шектеу» дегеніміз – ақыр соңында адам өз-өзіне қоятын нәрсе.
Dialogue: 0,0:30:07.13,0:30:08.47,Default,,0,0,0,,Ой
Dialogue: 0,0:30:08.59,0:30:10.97,Default,,0,0,0,,(Кайко) Сузу-сан, сен жұмыс істеп жатырсың ба? ‬
Dialogue: 0,0:30:11.10,0:30:13.14,Default,,0,0,0,,Тарату орталығына иә
Dialogue: 0,0:30:13.26,0:30:17.19,Default,,0,0,0,,Кеттік, мен саған рацион билеті мен әмиянды қарызға беремін.
Dialogue: 0,0:30:17.31,0:30:19.52,Default,,0,0,0,,Иә, өтінемін.
Dialogue: 0,0:30:31.95,0:30:33.95,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:30:34.08,0:30:34.87,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:30:40.50,0:30:42.79,Default,,0,0,0,,Иә, мен мұны істеймін.
Dialogue: 0,0:30:43.46,0:30:44.25,Default,,0,0,0,,ше? ‬
Dialogue: 0,0:30:51.72,0:30:53.51,Default,,0,0,0,,Сәлем анашым
Dialogue: 0,0:30:54.72,0:30:57.89,Default,,0,0,0,,Келіңіздер... иә иә
Dialogue: 0,0:30:58.02,0:31:00.40,Default,,0,0,0,,Не? (Кейко) Бұл сорпа жемісі.
Dialogue: 0,0:31:05.94,0:31:06.90,Default,,0,0,0,,(Судзу мен Харумидің күрсінуі)
Dialogue: 0,0:31:16.20,0:31:17.83,Default,,0,0,0,,‪‬
Dialogue: 0,0:31:18.83,0:31:23.25,Default,,0,0,0,,(Энтаро) Ой, Кейко мен Харуми келе ме? Әлде екі?
Dialogue: 0,0:31:23.38,0:31:24.79,Default,,0,0,0,,(Мейко) Қош келдіңіз, әке.
Dialogue: 0,0:31:24.92,0:31:26.67,Default,,0,0,0,,(Энтаро) Жарайды, сабыр етіңіз.
Dialogue: 0,0:31:26.80,0:31:27.71,Default,,0,0,0,,(диази) иә
Dialogue: 0,0:31:28.46,0:31:30.51,Default,,0,0,0,,Сирек
Dialogue: 0,0:31:30.63,0:31:33.51,Default,,0,0,0,,Әпкемнің дайындаған тамағы көп күйіп кетпеді.
Dialogue: 0,0:31:33.64,0:31:35.60,Default,,0,0,0,,(Мейко) Бұл Шусаку (Шусаку) Итатата
Dialogue: 0,0:31:35.72,0:31:38.02,Default,,0,0,0,,Сол балдыз
Dialogue: 0,0:31:38.14,0:31:41.31,Default,,0,0,0,,Сіздің арқаңызда кимононы дәл осылай жөндеп алдым.
Dialogue: 0,0:31:41.44,0:31:42.35,Default,,0,0,0,,(Шусаку) Ах~
Dialogue: 0,0:31:42.48,0:31:44.48,Default,,0,0,0,,(Мейко) Иә? Жоқ
Dialogue: 0,0:31:44.61,0:31:47.23,Default,,0,0,0,,Анамның аяғы ауыр.
Dialogue: 0,0:31:47.36,0:31:51.61,Default,,0,0,0,,Мен білмеген елге сендей баланы алып келдім.
Dialogue: 0,0:31:51.74,0:31:55.33,Default,,0,0,0,,Мен осында қалғаным жақсы болар еді.
Dialogue: 0,0:31:56.08,0:32:00.00,Default,,0,0,0,,Сузу-сан, Хиросимаға қайтуға қалай болады? ‬
Dialogue: 0,0:32:01.12,0:32:02.50,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:32:02.62,0:32:04.13,Default,,0,0,0,,(Entaro) Дұрыс.
Dialogue: 0,0:32:04.25,0:32:05.46,Default,,0,0,0,,Иә...
Dialogue: 0,0:32:07.50,0:32:09.01,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:32:09.13,0:32:10.72,Default,,0,0,0,,Дәл қазір
Dialogue: 0,0:32:10.84,0:32:12.51,Default,,0,0,0,,шаршадым
Dialogue: 0,0:32:12.63,0:32:13.93,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:32:14.64,0:32:16.60,Default,,0,0,0,,Аа, сағат 8 болып қалды.
Dialogue: 0,0:32:16.72,0:32:19.02,Default,,0,0,0,,Бүгінгі таңда одан да көп.
Dialogue: 0,0:32:19.14,0:32:21.60,Default,,0,0,0,,О? Мұның бәрі мың ине ме?
Dialogue: 0,0:32:21.73,0:32:24.40,Default,,0,0,0,,Эй, Суми, кейінге сақтап қой.
Dialogue: 0,0:32:24.52,0:32:25.36,Default,,0,0,0,,Иә
Dialogue: 0,0:32:25.90,0:32:27.86,Default,,0,0,0,,Міне! Сузу оян
Dialogue: 0,0:32:28.52,0:32:29.98,Default,,0,0,0,,бұл... Иә! ‬
Dialogue: 0,0:32:32.07,0:32:34.07,Default,,0,0,0,,Жүр, түскі ас ішейік.
Dialogue: 0,0:32:34.78,0:32:39.33,Default,,0,0,0,,А, мен үрейлендім. Күреге үйленемін деп армандадым.
Dialogue: 0,0:32:39.45,0:32:40.54,Default,,0,0,0,,Ахаха...
Dialogue: 0,0:32:40.66,0:32:41.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:32:41.62,0:32:43.50,Default,,0,0,0,,Сіз ояусыз ба? Иә.
Dialogue: 0,0:32:43.62,0:32:47.75,Default,,0,0,0,,Жүр, менің жеңгем Хиросимаға қайтуды айтты.
Dialogue: 0,0:32:47.88,0:32:48.88,Default,,0,0,0,,Иә
Dialogue: 0,0:32:49.00,0:32:50.51,Default,,0,0,0,,Сіз не айтып жатырсыз деп қызық болдым...
Dialogue: 0,0:32:51.34,0:32:53.05,Default,,0,0,0,,Ах! Үйге оралу (Кайко) А? ‬
Dialogue: 0,0:32:53.17,0:32:56.14,Default,,0,0,0,,Хотара, қайын ата, ене де
Dialogue: 0,0:32:56.26,0:32:59.43,Default,,0,0,0,,«Осы уақытқа дейін мұқият болғаным үшін менің кінәм болды».
Dialogue: 0,0:32:59.56,0:33:03.02,Default,,0,0,0,,«Бірнеше күн тынышталыңыз.»
Dialogue: 0,0:33:03.14,0:33:04.52,Default,,0,0,0,,Жездем де
Dialogue: 0,0:33:05.48,0:33:08.48,Default,,0,0,0,,Егер сіз мұнымен жақсы болсаңыз, онда бұл жақсы.
Dialogue: 0,0:33:08.61,0:33:09.73,Default,,0,0,0,,‪‬
Dialogue: 0,0:33:09.86,0:33:12.28,Default,,0,0,0,,(Джуро) Айтпақшы, сен Йоичиге ашық хат жібердің бе? ‬
Dialogue: 0,0:33:12.40,0:33:14.28,Default,,0,0,0,,Үй? шығару
Dialogue: 0,0:33:14.40,0:33:17.07,Default,,0,0,0,,Әлі жауап жоқ...
Dialogue: 0,0:33:17.62,0:33:19.49,Default,,0,0,0,,Үйде ме? Иә
Dialogue: 0,0:33:21.49,0:33:22.66,Default,,0,0,0,,Ал, бұл алыс.
Dialogue: 0,0:33:22.79,0:33:25.29,Default,,0,0,0,,Онии-чан - жалқау жазушы
Dialogue: 0,0:33:25.42,0:33:28.17,Default,,0,0,0,,Сузу адресат болып табылады. Мен қателескен шығармын.
Dialogue: 0,0:33:28.29,0:33:29.25,Default,,0,0,0,,(Суми/Кисено) Иә, иә
Dialogue: 0,0:33:29.38,0:33:31.50,Default,,0,0,0,,(2 адам) Монша
Dialogue: 0,0:33:31.63,0:33:33.63,Default,,0,0,0,,Суми-чан, еріктілер корпусы қандай? ‬
Dialogue: 0,0:33:33.76,0:33:35.22,Default,,0,0,0,,Мен бұған әбден үйреніп қалдым
Dialogue: 0,0:33:35.34,0:33:37.55,Default,,0,0,0,,Машина майының иісі бар.
Dialogue: 0,0:33:37.68,0:33:41.06,Default,,0,0,0,,Бұл қауіпті жұмыс па? Бұл қиын
Dialogue: 0,0:33:41.18,0:33:45.52,Default,,0,0,0,,Желімдеу жұмысы сияқты суық емес, сондықтан кейде жақсы болады.
Dialogue: 0,0:33:45.64,0:33:50.48,Default,,0,0,0,,Әдемі әскери офицер маған жасырын түрде асханаға билет берді.
Dialogue: 0,0:33:50.61,0:33:51.65,Default,,0,0,0,,Иә
Dialogue: 0,0:33:51.77,0:33:54.86,Default,,0,0,0,,Мен күтпеген жерден әскер құпиясын білдім.
Dialogue: 0,0:33:54.99,0:33:58.57,Default,,0,0,0,,Сузу-чан ше? Ву қайда? ‬
Dialogue: 0,0:33:58.70,0:34:02.70,Default,,0,0,0,,Хмм, әлі есімде көп нәрсе бар.
Dialogue: 0,0:34:02.83,0:34:04.29,Default,,0,0,0,,Ах! сурет? ‬
Dialogue: 0,0:34:04.41,0:34:06.46,Default,,0,0,0,,Енді...
Dialogue: 0,0:34:06.58,0:34:11.17,Default,,0,0,0,,Мен абайсызда теңіз құпиясына тап болған сияқтымын.
Dialogue: 0,0:34:11.29,0:34:12.92,Default,,0,0,0,,Не... не? Қазір ұйықта
Dialogue: 0,0:34:15.26,0:34:17.42,Default,,0,0,0,,Сузу-чан? ‬
Dialogue: 0,0:34:18.01,0:34:20.43,Default,,0,0,0,,Сізде тақырлар пайда болады.
Dialogue: 0,0:34:20.55,0:34:21.43,Default,,0,0,0,,Иә!?
Dialogue: 0,0:34:22.97,0:34:26.68,Default,,0,0,0,,Көріскенше, Сузу-чан, мен барамын.
Dialogue: 0,0:34:26.81,0:34:28.90,Default,,0,0,0,,(Джуро) Шешуші ұрыстағы төтенше шаралар!
Dialogue: 0,0:34:29.02,0:34:33.02,Default,,0,0,0,,Ай өзгерсе, тіпті қысқа сапарлар да шектеледі.
Dialogue: 0,0:34:33.15,0:34:34.15,Default,,0,0,0,,Қалайсың?
Dialogue: 0,0:34:34.28,0:34:35.48,Default,,0,0,0,,Иә
Dialogue: 0,0:34:35.61,0:34:38.49,Default,,0,0,0,,Енді мен әйелдер қауымдастығына жұмысқа баруым керек.
Dialogue: 0,0:34:38.61,0:34:41.20,Default,,0,0,0,,А-а, сенің де анаң шығып жатыр ма? ‬
Dialogue: 0,0:34:56.09,0:34:59.22,Default,,0,0,0,,Әкем маған қалта ақшасын берді.
Dialogue: 0,0:35:31.21,0:35:32.63,Default,,0,0,0,,Қош бол
Dialogue: 0,0:35:34.09,0:35:35.96,Default,,0,0,0,,Қош бол Хиросима
Dialogue: 0,0:35:41.09,0:35:42.01,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:35:42.55,0:35:44.76,Default,,0,0,0,,(Джуро) Эй, қайтып келдің!?
Dialogue: 0,0:35:44.89,0:35:47.43,Default,,0,0,0,,Мен ол жақтағыларды аяй бастадым.
Dialogue: 0,0:35:47.56,0:35:48.43,Default,,0,0,0,,Куу~
Dialogue: 0,0:35:55.40,0:35:57.15,Default,,0,0,0,,А, мен үйдемін.
Dialogue: 0,0:35:59.28,0:36:01.45,Default,,0,0,0,,Менің жеңгем үнемі осында.
Dialogue: 0,0:36:05.49,0:36:09.04,Default,,0,0,0,,(Харуми) Анашым, эй, қоңырауыңды қарызға берші.
Dialogue: 0,0:36:09.16,0:36:10.96,Default,,0,0,0,,(Мейко) Бұл не, Харуми?
Dialogue: 0,0:36:11.08,0:36:13.37,Default,,0,0,0,,(Харуми) Эй, оны маған қарызға бер.
Dialogue: 0,0:36:13.50,0:36:17.13,Default,,0,0,0,,(Кейко) Эй... Сузу-сан, Харумиге не дедің?
Dialogue: 0,0:36:18.80,0:36:22.09,Default,,0,0,0,,Циркуляциялық тақта, қазір айналдыра аламын ба?
Dialogue: 0,0:36:22.22,0:36:23.34,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:36:24.59,0:36:26.01,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:36:26.14,0:36:30.10,Default,,0,0,0,,Мен Хиросимадан оралғаннан бері өзімді...
Dialogue: 0,0:36:30.22,0:36:32.10,Default,,0,0,0,,Босатқанда әлі бала екенсің
Dialogue: 0,0:36:32.23,0:36:34.85,Default,,0,0,0,,Эй, көп рахмет.
Dialogue: 0,0:36:35.44,0:36:36.48,Default,,0,0,0,,(Харуми) Эй, сәлем
Dialogue: 0,0:36:36.61,0:36:38.32,Default,,0,0,0,,(Киязи) Жоқ десең,
Dialogue: 0,0:36:38.44,0:36:40.03,Default,,0,0,0,,(Харуми) Эй, оны маған қарызға бер. Эй, эй.
Dialogue: 0,0:36:40.15,0:36:42.70,Default,,0,0,0,,(Мейко) Сен маған керек емессің.
Dialogue: 0,0:37:06.14,0:37:08.51,Default,,0,0,0,,Ах... қош келдіңіз
Dialogue: 0,0:37:09.89,0:37:12.02,Default,,0,0,0,,(Шусаку) Бұл Кусацуми болды ма?
Dialogue: 0,0:37:12.14,0:37:15.77,Default,,0,0,0,,Күрсін, мен оны кешкі асқа гарнир деп ойлаймын.
Dialogue: 0,0:37:15.90,0:37:17.44,Default,,0,0,0,,(Шусаку) Мм.
Dialogue: 0,0:37:17.56,0:37:20.65,Default,,0,0,0,,Бұл жердегі одуванчиктердің бәрі ақ түсті.
Dialogue: 0,0:37:20.78,0:37:23.07,Default,,0,0,0,,(Шусаку) Энами басқаша ма? ‬
Dialogue: 0,0:37:23.19,0:37:24.99,Default,,0,0,0,,Әй, сарысы да бар.
Dialogue: 0,0:37:25.11,0:37:27.07,Default,,0,0,0,,А (Шусаку) Иә? ‬
Dialogue: 0,0:37:28.32,0:37:30.91,Default,,0,0,0,,Олар алыстан келген шығар.
Dialogue: 0,0:37:32.54,0:37:37.50,Default,,0,0,0,,Неге, мен өзімді жақсы сезінбеймін деп ойладым, бірақ қазір Хиросимаға ғашық болып қалдым.
Dialogue: 0,0:37:37.63,0:37:39.17,Default,,0,0,0,,Наторан
Dialogue: 0,0:37:39.29,0:37:40.75,Default,,0,0,0,,Уф... (Шусаку) А.
Dialogue: 0,0:37:45.17,0:37:49.26,Default,,0,0,0,,Қараңдаршы, бүгін ұшақ тасығыш бар.
Dialogue: 0,0:37:49.39,0:37:51.31,Default,,0,0,0,,Хитака және Хаятака Кано
Dialogue: 0,0:37:51.43,0:37:52.72,Default,,0,0,0,,Үлкен
Dialogue: 0,0:37:53.89,0:37:56.56,Default,,0,0,0,,(Шусаку) Акорано Комайнья — жойғыш
Dialogue: 0,0:37:56.69,0:37:58.94,Default,,0,0,0,,Германиядан келген су қайықтары да бар.
Dialogue: 0,0:37:59.06,0:38:02.57,Default,,0,0,0,,Бұл кәдімгі кеме тәрізді нәрсе суасты қайықтарының тендері...
Dialogue: 0,0:38:07.15,0:38:09.20,Default,,0,0,0,,Қараңдаршы, ақ көз ұшып келеді
Dialogue: 0,0:38:09.32,0:38:10.16,Default,,0,0,0,,Хаа
Dialogue: 0,0:38:10.28,0:38:12.20,Default,,0,0,0,,(Шусаку) Міне, солай.
Dialogue: 0,0:38:12.33,0:38:14.08,Default,,0,0,0,,(Шусаку) Қараңдар, мен қараймын.
Dialogue: 0,0:38:14.20,0:38:15.96,Default,,0,0,0,,Ух... (Шусаку) А...
Dialogue: 0,0:38:16.08,0:38:19.54,Default,,0,0,0,,А, Шусаку-сан, бұл не? ‬
Dialogue: 0,0:38:19.67,0:38:20.96,Default,,0,0,0,,Бұл кеме ме? ‬
Dialogue: 0,0:38:21.09,0:38:22.92,Default,,0,0,0,,Ямато Джа
Dialogue: 0,0:38:23.46,0:38:26.92,Default,,0,0,0,,Дүние жүзіндегі ең үлкен әскери кеме Шығыстағы ең үлкен әскери портта дүниеге келді.
Dialogue: 0,0:38:27.84,0:38:30.97,Default,,0,0,0,,Күрсін... Оны да адамдар алып жатыр ма? ‬
Dialogue: 0,0:38:31.10,0:38:32.05,Default,,0,0,0,,(Шусаку) О
Dialogue: 0,0:38:33.35,0:38:34.18,Default,,0,0,0,,Анкерлік тізбек жақсы
Dialogue: 0,0:38:34.31,0:38:34.85,Default,,0,0,0,,Хикае-саке мені, дайын.
Dialogue: 0,0:38:34.85,0:38:36.43,Default,,0,0,0,,Мен дайынмын, мен дайынмын
Dialogue: 0,0:38:34.85,0:38:36.43,Default,,0,0,0,,Шамамен 2700 адам
Dialogue: 0,0:38:36.43,0:38:36.56,Default,,0,0,0,,Шамамен 2700 адам
Dialogue: 0,0:38:36.56,0:38:36.93,Default,,0,0,0,,Шамамен 2700 адам
Dialogue: 0,0:38:36.56,0:38:36.93,Default,,0,0,0,,Артқа жылжуға дайындалыңыз
Dialogue: 0,0:38:36.93,0:38:37.52,Default,,0,0,0,,Артқа жылжуға дайындалыңыз
Dialogue: 0,0:38:37.64,0:38:39.27,Default,,0,0,0,,Артқа жылжуға дайындалыңыз
Dialogue: 0,0:38:39.77,0:38:43.07,Default,,0,0,0,,2700 адам…
Dialogue: 0,0:38:43.19,0:38:46.99,Default,,0,0,0,,Олай болса, Сузу-сан, Күреге қайтып келші.
Dialogue: 0,0:38:47.11,0:38:49.28,Default,,0,0,0,,күрсіну~
Dialogue: 0,0:38:49.41,0:38:52.12,Default,,0,0,0,,Тыныш жерде, қиналған адамдарға⸺
Dialogue: 0,0:38:52.24,0:38:54.16,Default,,0,0,0,,Сіз күнде тамақ жасайсыз ба? (Шусаку) Сузу-сан
Dialogue: 0,0:38:54.29,0:38:56.91,Default,,0,0,0,,Кірге келетін болсақ... Ах! (Шусаку) Әй, уау!
Dialogue: 0,0:38:57.04,0:38:58.71,Default,,0,0,0,,(құлау дыбысы)
Dialogue: 0,0:38:58.83,0:39:00.50,Default,,0,0,0,,Ой...
Dialogue: 0,0:39:00.62,0:39:03.54,Default,,0,0,0,,Кешіріңіз. Сенімен бәрі жақсы ма? ‬
Dialogue: 0,0:39:03.67,0:39:08.47,Default,,0,0,0,,Жоқ. Сіз жарақат алдыңыз ба? Ахх
Dialogue: 0,0:39:08.59,0:39:09.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:39:16.27,0:39:17.81,Default,,0,0,0,,Сузу Ноу
Dialogue: 0,0:39:17.93,0:39:20.90,Default,,0,0,0,,Осыны уайымдасаң, тақырлығың нашарлайды.
Dialogue: 0,0:39:21.02,0:39:22.73,Default,,0,0,0,,Сіз ұсталдыңыз ба?
Dialogue: 0,0:39:22.86,0:39:28.07,Default,,0,0,0,,Эй, қылқаламыңды маған бер, мен Сузу-санның басын сиямен бояйын.
Dialogue: 0,0:39:28.19,0:39:29.65,Default,,0,0,0,,Икенчуутара
Dialogue: 0,0:39:29.78,0:39:31.82,Default,,0,0,0,,Сіз бәрін қара етесіз, бірақ сіз
Dialogue: 0,0:39:31.95,0:39:33.41,Default,,0,0,0,,(Харуми) Эй~
Dialogue: 0,0:39:41.87,0:39:45.46,Default,,0,0,0,,(Коджи) Мен тарату станциясында өліп жатыр едім.
Dialogue: 0,0:39:45.59,0:39:46.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:39:47.05,0:39:48.80,Default,,0,0,0,,Токиодан келген көкөністер
Dialogue: 0,0:39:48.92,0:39:49.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:39:49.84,0:39:51.59,Default,,0,0,0,,Өскіндер кез келген жерде көктеп шығатын сияқты.
Dialogue: 0,0:39:51.72,0:39:52.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:39:53.09,0:39:57.85,Default,,0,0,0,,Сен мұндай лас жұмысқа шеберсің, Сузу-сан.
Dialogue: 0,0:39:57.97,0:39:59.10,Default,,0,0,0,,Иә
Dialogue: 0,0:39:59.23,0:40:00.02,Default,,0,0,0,,Сондай-ақ...
Dialogue: 0,0:40:01.77,0:40:03.90,Default,,0,0,0,,Енді себейік
Dialogue: 0,0:40:05.19,0:40:11.32,Default,,0,0,0,,♪ «Жеңіс күніне дейін»
Dialogue: 0,0:40:12.95,0:40:14.20,Default,,0,0,0,,Харуми-сан да өтінемін
Dialogue: 0,0:40:22.12,0:40:23.58,Default,,0,0,0,,Иә? О...
Dialogue: 0,0:40:24.83,0:40:26.17,Default,,0,0,0,,О! ‬
Dialogue: 0,0:40:28.75,0:40:29.76,Default,,0,0,0,,Фуфун
Dialogue: 0,0:40:31.26,0:40:32.42,Default,,0,0,0,,(Рухани канализация)
Dialogue: 0,0:40:34.05,0:40:35.26,Default,,0,0,0,,(Харуми) Ах...
Dialogue: 0,0:40:39.06,0:40:39.85,Default,,0,0,0,,(Харуми) Ах...
Dialogue: 0,0:40:39.97,0:40:44.40,Default,,0,0,0,,(Джиазидің ыңылдауы)
Dialogue: 0,0:40:39.97,0:40:44.40,Default,,0,0,0,,Ал... Енді сынақ өсіру үшін осының бәрі.
Dialogue: 0,0:40:44.40,0:40:44.52,Default,,0,0,0,,Ал... Жарайды, мұның бәрі сынақ өсіру үшін.
Dialogue: 0,0:40:44.52,0:40:45.02,Default,,0,0,0,,Ал... Енді, мұның бәрі сынақ өсіру үшін.
Dialogue: 0,0:40:44.52,0:40:45.02,Default,,0,0,0,,Иә, үлкен адам 6 жасар баламен көңіл көтеруде.
Dialogue: 0,0:40:45.02,0:40:45.15,Default,,0,0,0,,Иә, үлкен адам 6 жасар баламен көңіл көтеруде.
Dialogue: 0,0:40:45.15,0:40:47.06,Default,,0,0,0,,Иә, үлкен адам 6 жасар баламен көңіл көтеріп отыр.
Dialogue: 0,0:40:45.15,0:40:47.06,Default,,0,0,0,,Егісте өсіру жоспарын жасаймыз ба?
Dialogue: 0,0:40:47.06,0:40:47.19,Default,,0,0,0,,Егісте өсіру жоспарын жасаймыз ба?
Dialogue: 0,0:40:47.19,0:40:48.52,Default,,0,0,0,,Егісте өсіру жоспарын жасаймыз ба?
Dialogue: 0,0:40:47.19,0:40:48.52,Default,,0,0,0,,Ұят-күн — Шусаку.
Dialogue: 0,0:40:48.52,0:40:49.44,Default,,0,0,0,,Ұят-күн – Шусаку.
Dialogue: 0,0:40:49.57,0:40:52.70,Default,,0,0,0,,(Харуми) Ямато ана осында.
Dialogue: 0,0:40:52.82,0:40:56.53,Default,,0,0,0,,Сол жерде діни қызметкердің мұржасы Хаятака.
Dialogue: 0,0:40:56.66,0:40:58.49,Default,,0,0,0,,Сондай-ақ крейсерлер де бар.
Dialogue: 0,0:40:58.62,0:41:01.45,Default,,0,0,0,,Атаго мүмкін бе? Майя ма? ‬
Dialogue: 0,0:41:01.58,0:41:02.87,Default,,0,0,0,,Ал...
Dialogue: 0,0:41:03.00,0:41:06.54,Default,,0,0,0,,(бу ысқырығы)
Dialogue: 0,0:41:06.67,0:41:07.84,Default,,0,0,0,,(Кайко) Харуми
Dialogue: 0,0:41:10.38,0:41:11.34,Default,,0,0,0,,(Харуми) Иә.
Dialogue: 0,0:41:12.55,0:41:15.30,Default,,0,0,0,,(Кейко) Үйге қайтайық? Харуми
Dialogue: 0,0:41:17.09,0:41:18.55,Default,,0,0,0,,Менің жеңгем кенеттен
Dialogue: 0,0:41:18.68,0:41:20.97,Default,,0,0,0,,Сіз некеге оралған кезде,
Dialogue: 0,0:41:21.72,0:41:23.39,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:41:23.52,0:41:25.06,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:41:25.19,0:41:29.19,Default,,0,0,0,,Әпкеңнің күйеуі әскери кемелерді айдап әкететін адам ма?
Dialogue: 0,0:41:30.02,0:41:32.86,Default,,0,0,0,,Мүмкін сіз Ринге кенет ғашық болып қалған шығарсыз?
Dialogue: 0,0:41:33.74,0:41:35.91,Default,,0,0,0,,Хэхе... хехе...
Dialogue: 0,0:41:37.03,0:41:39.74,Default,,0,0,0,,Кәне, біз де бар күшімізді салайық.
Dialogue: 0,0:41:39.87,0:41:41.99,Default,,0,0,0,,Тамақты дайындағыңыз келе ме?
Dialogue: 0,0:41:42.12,0:41:43.79,Default,,0,0,0,,(Труба дыбысы)
Dialogue: 0,0:41:43.79,0:41:44.75,Default,,0,0,0,,(Труба дыбысы)
Dialogue: 0,0:41:43.79,0:41:44.75,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:41:44.75,0:41:46.04,Default,,0,0,0,,(Труба дыбысы)
Dialogue: 0,0:41:46.04,0:41:47.25,Default,,0,0,0,,(Труба дыбысы)
Dialogue: 0,0:41:46.04,0:41:47.25,Default,,0,0,0,,Оран…
Dialogue: 0,0:41:47.37,0:41:52.55,Default,,0,0,0,,(жалғасы керней дыбысы)
Dialogue: 0,0:41:52.71,0:41:56.09,Default,,0,0,0,,Мен тамақ дайындау туралы ойлаған кезде
Dialogue: 0,0:41:56.22,0:41:58.30,Default,,0,0,0,,Рацион айтарлықтай төмендеді.
Dialogue: 0,0:41:58.43,0:42:03.14,Default,,0,0,0,,Төрт кептірілген сардина төрт адамнан тұратын отбасына үш мезгіл тамақ береді.
Dialogue: 0,0:42:04.31,0:42:06.64,Default,,0,0,0,,Жасыл жапырақтары бар күннен жақсы.
Dialogue: 0,0:42:06.77,0:42:10.69,Default,,0,0,0,,Егер сіз Көкейді сапқа тұрғызсаңыз, сіз қоян гүлдерін де сатып ала аласыз.
Dialogue: 0,0:42:06.77,0:42:10.69,Default,,0,0,0,,(Тофу дүкенінің кернейі)
Dialogue: 0,0:42:10.81,0:42:13.15,Default,,0,0,0,,А, мен түсіндім, а
Dialogue: 0,0:42:14.07,0:42:18.16,Default,,0,0,0,,Күлгін балапан жылқықұйрығы
Dialogue: 0,0:42:18.28,0:42:22.83,Default,,0,0,0,,Одуванчик оксалис кептірілген сардин Унохана
Dialogue: 0,0:42:22.95,0:42:27.21,Default,,0,0,0,,Картоп Картоп ұны Умебоши тұқымы
Dialogue: 0,0:42:27.33,0:42:28.96,Default,,0,0,0,,Мм.
Dialogue: 0,0:42:29.54,0:42:32.38,Default,,0,0,0,,Тәтті картопты турап, бумен пісіріңіз
Dialogue: 0,0:42:32.50,0:42:35.80,Default,,0,0,0,,Жылқы құйрығын аздап қайнатып, суға салып, тураңыз.
Dialogue: 0,0:42:35.92,0:42:39.93,Default,,0,0,0,,Ұнды тәтті картоп пен қырықбуынмен араластырып, жалпақ шарға айналдырыңыз.
Dialogue: 0,0:42:40.05,0:42:41.72,Default,,0,0,0,,Түскі ас дайын
Dialogue: 0,0:42:41.85,0:42:43.93,Default,,0,0,0,,Кейко және басқаларсыз тыныш.
Dialogue: 0,0:42:44.06,0:42:47.06,Default,,0,0,0,,Қалдықтарды кептіру арқылы сақтау керек.
Dialogue: 0,0:42:48.27,0:42:50.23,Default,,0,0,0,,Келіңіздер, әлі жоқ
Dialogue: 0,0:42:50.35,0:42:53.40,Default,,0,0,0,,Күрішті 5 рет сумен сұйылтып, ботқа ретінде қолданыңыз.
Dialogue: 0,0:42:54.48,0:42:58.40,Default,,0,0,0,,Туралған картопты қосып, тағы 10 минут пісіріңіз
Dialogue: 0,0:42:58.53,0:43:00.86,Default,,0,0,0,,Туралған балапандарды қосыңыз
Dialogue: 0,0:43:00.99,0:43:03.91,Default,,0,0,0,,Шалғам қабығы Одуванчик тамыры
Dialogue: 0,0:43:04.03,0:43:07.41,Default,,0,0,0,,Жолақтарға кесіп, қант пен соя соусымен қайнатыңыз.
Dialogue: 0,0:43:07.54,0:43:11.92,Default,,0,0,0,,Туралған одуванчика жапырақтарын қосып, Уноханамен араластырыңыз және одан әрі пісіріңіз.
Dialogue: 0,0:43:14.30,0:43:18.72,Default,,0,0,0,,Шалғамды жұқалап турап, оны тұзбен сүртіңіз, Оксалиспен араластырыңыз.
Dialogue: 0,0:43:20.05,0:43:25.43,Default,,0,0,0,,Умебоши тұқымын және суды кәстрөлге салыңыз, қайнатыңыз, содан кейін кептірілген сардина қосыңыз.
Dialogue: 0,0:43:25.56,0:43:28.27,Default,,0,0,0,,Сорпаны үстіне құйып, бетін ашпай қайнатыңыз.
Dialogue: 0,0:43:28.39,0:43:30.14,Default,,0,0,0,,Дәміне қарай тұзбен аяқтаңыз
Dialogue: 0,0:43:30.27,0:43:33.90,Default,,0,0,0,,Жарайды, бұл туралы Қария-санға айта алмайсың.
Dialogue: 0,0:43:34.02,0:43:38.36,Default,,0,0,0,,Күріш рационы тек жартысы ғана болды, ал күріш ботқасында тәтті картоп көп болды.
Dialogue: 0,0:43:38.49,0:43:39.40,Default,,0,0,0,,Не?
Dialogue: 0,0:43:39.53,0:43:41.41,Default,,0,0,0,,Ертең маған қалдырыңызшы.
Dialogue: 0,0:43:42.41,0:43:45.37,Default,,0,0,0,,Адал қорғаушы лорд Кусуноки саңырау қамалға төтеп беруі үшін.
Dialogue: 0,0:43:45.49,0:43:48.70,Default,,0,0,0,,Азық-түлікті көбейту әдісін ойлап тапты
Dialogue: 0,0:43:50.16,0:43:53.75,Default,,0,0,0,,Алдымен күрішті жақсылап қуырамыз.
Dialogue: 0,0:43:53.88,0:43:58.01,Default,,0,0,0,,3 есе көп су құйып, баяу отта баяу пісіріңіз.
Dialogue: 0,0:43:59.42,0:44:03.39,Default,,0,0,0,,Күрішті үнемдеу жалықтырады, егер отынды ысырап етсең.
Dialogue: 0,0:44:03.51,0:44:08.56,Default,,0,0,0,,Бұл Жапон империясының қолайлығы. Оны отсыз пешке қалдырыңыз.
Dialogue: 0,0:44:09.48,0:44:11.02,Default,,0,0,0,,Таңды күту
Dialogue: 0,0:44:13.85,0:44:17.48,Default,,0,0,0,,Қалған қайнатылған балық сорпасына шегіргүлді қосыңыз.
Dialogue: 0,0:44:17.61,0:44:19.19,Default,,0,0,0,,Мисо қосып, қайнатыңыз
Dialogue: 0,0:44:20.07,0:44:23.20,Default,,0,0,0,,Күрішті қайтадан отқа қойып, қайнатыңыз.
Dialogue: 0,0:44:23.32,0:44:25.28,Default,,0,0,0,,Аяқтау
Dialogue: 0,0:44:25.41,0:44:28.58,Default,,0,0,0,,Бұл Кусуноки-кохан, ол Кусуноки-коға қатысты.
Dialogue: 0,0:44:29.50,0:44:31.87,Default,,0,0,0,,Бұл әкемнің түскі асына арналған.
Dialogue: 0,0:44:32.67,0:44:36.75,Default,,0,0,0,,(Шусаку) Әй... Бүгін таңертең мен көп дәмді тамақ алдым.
Dialogue: 0,0:44:36.88,0:44:38.21,Default,,0,0,0,,Меши дәндері ісінеді
Dialogue: 0,0:44:38.34,0:44:40.80,Default,,0,0,0,,Оны дайындаудың әдемі тәсілі бар.
Dialogue: 0,0:44:40.92,0:44:43.80,Default,,0,0,0,,Иә (барлығы) Мен қабылдаймын.
Dialogue: 0,0:44:50.52,0:44:52.06,Default,,0,0,0,,(Барлығы) Хмм? ‬
Dialogue: 0,0:44:53.77,0:44:55.35,Default,,0,0,0,,(Шусаку) Мен барамын... Кешіріңіз.
Dialogue: 0,0:44:55.48,0:44:58.73,Default,,0,0,0,,Лорд Кусуноки бұған ләззат алады.
Dialogue: 0,0:44:58.86,0:45:02.11,Default,,0,0,0,,Ол нағыз батыр болуы керек.
Dialogue: 0,0:45:02.24,0:45:04.36,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:45:04.49,0:45:06.07,Default,,0,0,0,,Хмм...
Dialogue: 0,0:45:08.24,0:45:09.74,Default,,0,0,0,,Ах Қара...
Dialogue: 0,0:45:11.20,0:45:12.00,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:45:12.45,0:45:13.75,Default,,0,0,0,,Карри ұнтағы? ‬
Dialogue: 0,0:45:21.51,0:45:22.46,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:45:22.59,0:45:23.51,Default,,0,0,0,,(Дабыл)
Dialogue: 0,0:45:23.51,0:45:24.34,Default,,0,0,0,,(Дабыл)
Dialogue: 0,0:45:23.51,0:45:24.34,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:45:24.34,0:45:25.84,Default,,0,0,0,,(Дабыл)
Dialogue: 0,0:45:26.47,0:45:30.14,Default,,0,0,0,,(Ер) Ескерту ескертуі шығарылды
Dialogue: 0,0:45:30.26,0:45:31.39,Default,,0,0,0,,(Дабыл)
Dialogue: 0,0:45:31.52,0:45:34.85,Default,,0,0,0,,(Ерлер) Әуе шабуылы туралы ескерту берілді
Dialogue: 0,0:45:41.32,0:45:43.61,Default,,0,0,0,,Эфирде ештеңе айтпаңыз
Dialogue: 0,0:45:43.74,0:45:45.90,Default,,0,0,0,,Шусаку жұмысқа кетті ме? ‬
Dialogue: 0,0:45:46.03,0:45:46.82,Default,,0,0,0,,Иә
Dialogue: 0,0:45:46.95,0:45:52.70,Default,,0,0,0,,Қарсыластың күтілетін крейсерлік күшін ескерсек, Кюсю алғаш рет ең жақсы жер.
Dialogue: 0,0:45:52.83,0:45:55.71,Default,,0,0,0,,Мен бұл жерде үрейленіп, тауға жүгіремін... А.
Dialogue: 0,0:45:55.83,0:45:57.00,Default,,0,0,0,,Сәлем
Dialogue: 0,0:45:57.12,0:45:59.59,Default,,0,0,0,,(Entaro) Бұл жай ғана электр қуатының үзілуі.
Dialogue: 0,0:46:01.75,0:46:04.21,Default,,0,0,0,,(Әйел) Сіз сәтсіздікке ұшырайсыз.
Dialogue: 0,0:46:04.34,0:46:07.09,Default,,0,0,0,,(Шусаку) Ғимаратты эвакуациялау Кану
Dialogue: 0,0:46:07.22,0:46:09.97,Default,,0,0,0,,Бүкіл қалаға таралатын өрт сөндіру алаңын жасаңыз.
Dialogue: 0,0:46:10.10,0:46:10.97,Default,,0,0,0,,Хаа
Dialogue: 0,0:46:11.10,0:46:14.35,Default,,0,0,0,,(Шусаку) Менің ойымша, бұл жер туралы алаңдаудың қажеті жоқ.
Dialogue: 0,0:46:14.48,0:46:16.27,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,0:46:16.39,0:46:19.44,Default,,0,0,0,,Қызық, бәрі көшетін жер таба ма?
Dialogue: 0,0:46:19.56,0:46:21.27,Default,,0,0,0,,Ах... Кешіріңіз.
Dialogue: 0,0:46:21.98,0:46:23.82,Default,,0,0,0,,(Кейзи) Қош келдіңіз, иә? ‬
Dialogue: 0,0:46:24.78,0:46:27.24,Default,,0,0,0,,Отынның кез келген түрі жарайды.
Dialogue: 0,0:46:27.36,0:46:29.82,Default,,0,0,0,,Менің үйім де бұзылды.
Dialogue: 0,0:46:29.95,0:46:30.82,Default,,0,0,0,,Иә.
Dialogue: 0,0:46:31.49,0:46:34.33,Default,,0,0,0,,Мен бүкіл үймен Шимоносэкиге барамын.
Dialogue: 0,0:46:34.45,0:46:35.25,Default,,0,0,0,,(Энтаро және басқалар) Иә? ‬
Dialogue: 0,0:46:35.37,0:46:37.16,Default,,0,0,0,,Иә, мен онымен ажырасу мүмкіндігін пайдаландым.
Dialogue: 0,0:46:37.29,0:46:38.83,Default,,0,0,0,,(Энтаро және т.б.) Иә!?
Dialogue: 0,0:46:38.96,0:46:42.34,Default,,0,0,0,,Уайымдама, тек жұмыс тауып, жұмысқа бар.
Dialogue: 0,0:46:43.25,0:46:46.17,Default,,0,0,0,,(Entaro) Кірушілер саны көбейді.
Dialogue: 0,0:46:46.30,0:46:48.01,Default,,0,0,0,,Иә, солай ма? ‬
Dialogue: 0,0:46:48.13,0:46:49.34,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:46:51.64,0:46:53.85,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:46:53.97,0:46:57.14,Default,,0,0,0,,(Чита) Кеше Хайгаминнің басында шырылдады.
Dialogue: 0,0:46:57.27,0:46:59.94,Default,,0,0,0,,(Қария) Мұнда да зеңбіректер келді.
Dialogue: 0,0:47:00.06,0:47:01.94,Default,,0,0,0,,(Домото) Ақыры күшейіп барады.
Dialogue: 0,0:47:02.48,0:47:04.40,Default,,0,0,0,,Рахмет
Dialogue: 0,0:47:05.07,0:47:08.95,Default,,0,0,0,,Әуе шабуылына қарсы пана аяқталды.
Dialogue: 0,0:47:09.07,0:47:11.11,Default,,0,0,0,,Иә (Шусаку) Жарайды.
Dialogue: 0,0:47:11.24,0:47:14.37,Default,,0,0,0,,Сіз артық жұмыс істеуге қатты қуанған болуыңыз керек.
Dialogue: 0,0:47:15.45,0:47:20.08,Default,,0,0,0,,Менің әпкем құтқарылды, өйткені оның бағаналары мен татами төсеніштері болды.
Dialogue: 0,0:47:22.33,0:47:26.17,Default,,0,0,0,,Шусаку Сіз осындасыз ба? ‬
Dialogue: 0,0:47:26.30,0:47:28.34,Default,,0,0,0,,(Шусаку) Не? Бұл ештеңе емес
Dialogue: 0,0:47:29.30,0:47:32.09,Default,,0,0,0,,Енді дастарханды жинап алайық.
Dialogue: 0,0:47:32.68,0:47:33.76,Default,,0,0,0,,Жақсы ату
Dialogue: 0,0:47:33.89,0:47:39.23,Default,,0,0,0,,Шусаку-сан, мен бұл топырақты Читоның егісіне апарсам болады ма? ‬
Dialogue: 0,0:47:39.35,0:47:42.73,Default,,0,0,0,,(Шусаку) Ал, ал, абай бол.
Dialogue: 0,0:47:43.61,0:47:46.32,Default,,0,0,0,,Иә, мұнда кел.
Dialogue: 0,0:47:46.44,0:47:48.69,Default,,0,0,0,,Иә, мен қайықты көрдім.
Dialogue: 0,0:47:49.32,0:47:51.49,Default,,0,0,0,,Жарайды хаха...
Dialogue: 0,0:47:51.61,0:47:53.70,Default,,0,0,0,,Бүгін қайта жіберіп алмаңыз.
Dialogue: 0,0:47:53.82,0:47:55.20,Default,,0,0,0,,Екі Ямато бар.
Dialogue: 0,0:47:56.37,0:47:58.16,Default,,0,0,0,,Бірі – Мусаши
Dialogue: 0,0:47:58.29,0:48:02.42,Default,,0,0,0,,Соғыс кемелері бар, бірақ ұшақ тасығыштары жоқ.
Dialogue: 0,0:48:02.54,0:48:03.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:48:03.58,0:48:07.67,Default,,0,0,0,,А, бұл Тон. Оның артында мұнара жоқ.
Dialogue: 0,0:48:07.80,0:48:09.63,Default,,0,0,0,,Авиациялық крейсер
Dialogue: 0,0:48:09.76,0:48:14.18,Default,,0,0,0,,Уау, бұл керемет.
Dialogue: 0,0:48:14.30,0:48:17.68,Default,,0,0,0,,Иә, ағаңызға айтыңызшы.
Dialogue: 0,0:48:17.81,0:48:20.85,Default,,0,0,0,,Түсіндім, біз де аздап үйрендік.
Dialogue: 0,0:48:21.94,0:48:23.65,Default,,0,0,0,,Жоюшы (Харуми) Иә
Dialogue: 0,0:48:23.77,0:48:25.36,Default,,0,0,0,,А, бірдеңе келе жатыр.
Dialogue: 0,0:48:26.52,0:48:27.86,Default,,0,0,0,,(Харуми) Бұл отты қайық.
Dialogue: 0,0:48:28.53,0:48:31.86,Default,,0,0,0,,Әй, эй, саған да рахмет.
Dialogue: 0,0:48:32.61,0:48:35.24,Default,,0,0,0,,Бұл үлкен бұлт (Харуми) Иә.
Dialogue: 0,0:48:35.37,0:48:38.58,Default,,0,0,0,,Канатоко бұлттары (Харуми) Иә.
Dialogue: 0,0:48:38.70,0:48:41.12,Default,,0,0,0,,Қатты жаңбыр жауады. Ха... (Харуми) Ха! ‬
Dialogue: 0,0:48:43.75,0:48:45.17,Default,,0,0,0,,Эй, Шусаку-сан
Dialogue: 0,0:48:45.29,0:48:48.13,Default,,0,0,0,,(Шусаку) Әзірше мен ол заттарды окопқа апарамын.
Dialogue: 0,0:48:49.59,0:48:51.34,Default,,0,0,0,,(2 адам) Ааа.
Dialogue: 0,0:48:57.05,0:48:59.10,Default,,0,0,0,,(Шусаку) Ой, кешіріңіз, кешіріңіз
Dialogue: 0,0:48:59.22,0:49:00.14,Default,,0,0,0,,Ха...
Dialogue: 0,0:49:03.19,0:49:04.77,Default,,0,0,0,,Хаах
Dialogue: 0,0:49:04.90,0:49:07.77,Default,,0,0,0,,А, мен мұны істеймін, мен мұны істеймін.
Dialogue: 0,0:49:08.94,0:49:11.69,Default,,0,0,0,,Сізге әскери кемелер ұнайды, солай ма? (Шусаку) Иә? ‬
Dialogue: 0,0:49:11.82,0:49:13.61,Default,,0,0,0,,Харуми-саннан естіген
Dialogue: 0,0:49:13.74,0:49:15.03,Default,,0,0,0,,О
Dialogue: 0,0:49:15.16,0:49:18.91,Default,,0,0,0,,Харумиге сабақ берген мен емес, Хибо болды.
Dialogue: 0,0:49:19.03,0:49:21.37,Default,,0,0,0,,Сәлеметсіз бе? (Шусаку) Иә.
Dialogue: 0,0:49:21.50,0:49:25.62,Default,,0,0,0,,Мен әскери кемені жақсы көремін, сондықтан мен Сузу-санды бір күні кездестіремін.
Dialogue: 0,0:49:26.46,0:49:30.30,Default,,0,0,0,,Бұл Хисао ма? ‬
Dialogue: 0,0:49:30.42,0:49:31.38,Default,,0,0,0,,(Шусаку) Иә.
Dialogue: 0,0:49:33.05,0:49:34.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:49:36.64,0:49:37.55,Default,,0,0,0,,Ах
Dialogue: 0,0:49:42.06,0:49:45.73,Default,,0,0,0,,Мен бұл адаммен осындай әрекет жасадым.
Dialogue: 0,0:49:50.27,0:49:53.53,Default,,0,0,0,,(Энтаро) Жарайды, аздап жаңбыр жауа бастады.
Dialogue: 0,0:49:53.65,0:49:55.53,Default,,0,0,0,,Енді үйге қайтайық.
Dialogue: 0,0:49:55.65,0:49:57.03,Default,,0,0,0,,(Шусаку) Мм...
Dialogue: 0,0:49:57.16,0:50:01.54,Default,,0,0,0,,Біз ерлі-зайыптымыз, сондықтан жақсы қарым-қатынаста болғанымыз дұрыс.
Dialogue: 0,0:50:01.66,0:50:04.83,Default,,0,0,0,,(Мейко) Иә, иә, ерлі-зайыпты болу үлкен мәселе емес.
Dialogue: 0,0:50:04.96,0:50:06.04,Default,,0,0,0,,2 жиын
Dialogue: 0,0:50:06.16,0:50:07.54,Default,,0,0,0,,(Энтаро) Кейши...
Dialogue: 0,0:50:10.54,0:50:16.05,Default,,0,0,0,,(Шусаку) Отбасы жиналып, айырмашылықтарын салыстырды.
Dialogue: 0,0:50:16.17,0:50:21.35,Default,,0,0,0,,Әлгі жеңгесінің күйеуі...
Dialogue: 0,0:50:21.47,0:50:25.98,Default,,0,0,0,,Әскерге барсам да, арық болды.
Dialogue: 0,0:50:26.10,0:50:27.56,Default,,0,0,0,,Тым жұқа ма?
Dialogue: 0,0:50:29.06,0:50:32.48,Default,,0,0,0,,Әкем қайтадан зауытқа жұмысқа тұрғанда.
Dialogue: 0,0:50:32.61,0:50:35.86,Default,,0,0,0,,Әпке, тойлауға барыңыз, сағат сатып алыңыз.
Dialogue: 0,0:50:35.99,0:50:38.53,Default,,0,0,0,,Мен сол жерде жас жігітпен танысып, онымен таныстым.
Dialogue: 0,0:50:39.36,0:50:44.83,Default,,0,0,0,,Мен әйеліме бардым, ал екі жас жұп жаңа киім алуға дүкенге барды.
Dialogue: 0,0:50:44.95,0:50:48.71,Default,,0,0,0,,Ей, Кейкода сондай мінез бар.
Dialogue: 0,0:50:48.83,0:50:51.71,Default,,0,0,0,,Ата-анаңмен келісімге кел.
Dialogue: 0,0:50:51.84,0:50:54.00,Default,,0,0,0,,Күйеу баласы ырылдаған соң
Dialogue: 0,0:50:54.13,0:50:57.80,Default,,0,0,0,,Дүкенмен не істеу керектігін шеше алмай қиналдым.
Dialogue: 0,0:50:57.92,0:51:03.01,Default,,0,0,0,,Соңында ғимаратты эвакуациялауға байланысты ештеңе болған жоқ.
Dialogue: 0,0:51:04.60,0:51:08.10,Default,,0,0,0,,Хисао - Куромураның мұрагері.
Dialogue: 0,0:51:08.23,0:51:14.02,Default,,0,0,0,,Оны Шимоносэкиге апарды, ол жақсы жауап берген сияқты.
Dialogue: 0,0:51:14.86,0:51:19.03,Default,,0,0,0,,Бəрінің күліп жүргенімен өмір сүрсем ғой.
Dialogue: 0,0:51:19.15,0:51:21.03,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:51:22.24,0:51:23.16,Default,,0,0,0,,Га
Dialogue: 0,0:51:29.58,0:51:31.37,Default,,0,0,0,,Көкөністерді қарастырайық.
Dialogue: 0,0:51:36.17,0:51:38.97,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:51:45.14,0:51:50.19,Default,,0,0,0,,Мұның солай екенін түсіну үшін бізге айлар қажет болды.
Dialogue: 0,0:51:50.31,0:51:52.27,Default,,0,0,0,,Шынымен, мен жай ғана ойсызмын.
Dialogue: 0,0:51:57.23,0:51:58.82,Default,,0,0,0,,Бұл Ямато
Dialogue: 0,0:51:59.99,0:52:01.57,Default,,0,0,0,,Бұл Тон
Dialogue: 0,0:52:04.20,0:52:06.70,Default,,0,0,0,,Эй, аа...
Dialogue: 0,0:52:06.83,0:52:09.83,Default,,0,0,0,,Ах... Мм... Мм, Учиха...
Dialogue: 0,0:52:11.00,0:52:15.00,Default,,0,0,0,,Алыста кеткен балама қайықтың суретін жібергім келді...
Dialogue: 0,0:52:15.13,0:52:16.92,Default,,0,0,0,,(Әскери полиция) Мына әйелдің үйі осында ма? ‬
Dialogue: 0,0:52:17.05,0:52:19.42,Default,,0,0,0,,Кэ... Әскери полиция (Кэйджи) Иә!?
Dialogue: 0,0:52:19.55,0:52:22.55,Default,,0,0,0,,Мен жағалау сызығы мен кеменің сұлбасын сыздым.
Dialogue: 0,0:52:22.68,0:52:25.64,Default,,0,0,0,,Шпиондық әрекетте сізде сондай қара жүз бар.
Dialogue: 0,0:52:25.76,0:52:29.35,Default,,0,0,0,,Мен сіздің жоспарыңыздың қаншалықты қу және қу екенін білмеймін.
Dialogue: 0,0:52:29.35,0:52:29.93,Default,,0,0,0,,Мен сіздің жоспарыңыздың қаншалықты қу және қу екенін білмеймін.
Dialogue: 0,0:52:29.35,0:52:29.93,Default,,0,0,0,,Уф...
Dialogue: 0,0:52:29.93,0:52:31.02,Default,,0,0,0,,Уф...
Dialogue: 0,0:52:31.14,0:52:33.10,Default,,0,0,0,,(Әскери полиция) Бұл әйелдің күйеуі
Dialogue: 0,0:52:33.23,0:52:36.69,Default,,0,0,0,,Әскери-теңіз сотының жазбасы
Dialogue: 0,0:52:36.82,0:52:40.36,Default,,0,0,0,,Әйелдің мүмкіндігін пайдаланып, әскери құпияларды оқуы мүмкін емес пе? ‬
Dialogue: 0,0:52:40.36,0:52:41.28,Default,,0,0,0,,Әйелдің мүмкіндігін пайдаланып, әскери құпияларды оқуы мүмкін емес пе? ‬
Dialogue: 0,0:52:40.36,0:52:41.28,Default,,0,0,0,,Уф... ой...
Dialogue: 0,0:52:41.28,0:52:41.40,Default,,0,0,0,,Уф... ой...
Dialogue: 0,0:52:41.40,0:52:42.15,Default,,0,0,0,,Уф... ой...
Dialogue: 0,0:52:41.40,0:52:42.15,Default,,0,0,0,,Шифрланған байланыстың белгісі бар ма? ‬
Dialogue: 0,0:52:42.15,0:52:43.91,Default,,0,0,0,,Шифрланған байланыстың белгісі бар ма? ‬
Dialogue: 0,0:52:44.03,0:52:46.91,Default,,0,0,0,,Әйел затынан кездейсоқ сандар кестесін көрдіңіз бе? ‬
Dialogue: 0,0:52:47.03,0:52:50.45,Default,,0,0,0,,Фонға не нұсқайды? Иә? Өтінемін? ‬
Dialogue: 0,0:52:52.29,0:52:55.04,Default,,0,0,0,,(Әскери полиция) Мен бұл жолы бір істі қамауға алудан аулақ боламын.
Dialogue: 0,0:52:55.17,0:52:57.25,Default,,0,0,0,,Сағатқа көз салыңыз
Dialogue: 0,0:52:57.38,0:52:59.46,Default,,0,0,0,,Әйелім десең де, ол бәрібір бөтен.
Dialogue: 0,0:53:02.80,0:53:03.88,Default,,0,0,0,,Иә
Dialogue: 0,0:53:08.51,0:53:11.39,Default,,0,0,0,,(Сағат қоңырауының дыбысы)
Dialogue: 0,0:53:11.52,0:53:13.64,Default,,0,0,0,,(Шусаку) Мен үйдемін
Dialogue: 0,0:53:13.77,0:53:17.15,Default,,0,0,0,,Не? Кір кептіруге қалды
Dialogue: 0,0:53:17.27,0:53:18.90,Default,,0,0,0,,А, Шусаку, бұл...
Dialogue: 0,0:53:19.02,0:53:21.90,Default,,0,0,0,,Сузу-сан әскери полицияға (Шусаку) иә? ‬
Dialogue: 0,0:53:24.53,0:53:26.82,Default,,0,0,0,,Сузу-сан, бір сәт осында келші.
Dialogue: 0,0:53:33.37,0:53:34.33,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:53:34.46,0:53:37.79,Default,,0,0,0,,Егер ол соншалықты кішкентай болса, сіз тіпті жағалау сызығын сала алмайсыз.
Dialogue: 0,0:53:39.67,0:53:42.92,Default,,0,0,0,,Сузу-сан, сурет салғанды ​​ұнатасың ба?
Dialogue: 0,0:53:43.05,0:53:46.22,Default,,0,0,0,,Маған тағы бір рет сурет сала аласыз ба?
Dialogue: 0,0:53:46.34,0:53:48.01,Default,,0,0,0,,Бұл...
Dialogue: 0,0:53:48.14,0:53:50.68,Default,,0,0,0,,Ол дұрыс салынбауы мүмкін.
Dialogue: 0,0:53:50.81,0:53:52.35,Default,,0,0,0,,(Шусаку) Ха...
Dialogue: 0,0:53:52.93,0:53:55.19,Default,,0,0,0,,Сузу-сан тыңшы...
Dialogue: 0,0:53:56.35,0:53:59.19,Default,,0,0,0,,(Кейко) Шусаку: Дұрыс айтасың.
Dialogue: 0,0:53:59.31,0:54:02.78,Default,,0,0,0,,Әскери полициядан кешірім сұраймыз.
Dialogue: 0,0:54:02.90,0:54:04.86,Default,,0,0,0,,Күлу қиын
Dialogue: 0,0:54:04.99,0:54:07.20,Default,,0,0,0,,Егер сіз ұстанатын болсаңыз, сізге көбірек қиындықтар қажет болады.
Dialogue: 0,0:54:07.32,0:54:10.70,Default,,0,0,0,,(Шусаку және т.б.) Ахахха! ‬
Dialogue: 0,0:54:10.83,0:54:12.70,Default,,0,0,0,,Көріп тұрғаныңыздай, көңіліңіз көтерілсе
Dialogue: 0,0:54:12.83,0:54:16.04,Default,,0,0,0,,Ол айналаны бірден көре алмайтын бала.
Dialogue: 0,0:54:16.16,0:54:20.46,Default,,0,0,0,,Жұмбақ болуға талпынсаң да, данышпанға ұқсамайсың.
Dialogue: 0,0:54:20.59,0:54:25.05,Default,,0,0,0,,(Шусаку) Бұл адам үйіне сағат 6-да бару керек. Оны Рокуджи деп ойлаған ол еді.
Dialogue: 0,0:54:25.17,0:54:28.68,Default,,0,0,0,,Армияның ақымақ әскери полициясы қандай құпияларды көздейді?
Dialogue: 0,0:54:28.80,0:54:32.31,Default,,0,0,0,,Неге екенін білмеймін, бірақ ашулана бастадым.
Dialogue: 0,0:54:32.43,0:54:35.18,Default,,0,0,0,,(күлді)
Dialogue: 0,0:54:35.31,0:54:39.19,Default,,0,0,0,,Бəрінің күліп тұрғанын қалаймын.
Dialogue: 0,0:54:39.31,0:54:41.02,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:54:41.15,0:54:42.44,Default,,0,0,0,,(Энтаро) Мен үйдемін
Dialogue: 0,0:54:42.57,0:54:45.69,Default,,0,0,0,,(Кайко) Әй, әке, сен де әкеңе тыңдауың керек еді.
Dialogue: 0,0:54:45.82,0:54:46.74,Default,,0,0,0,,(күлді)
Dialogue: 0,0:54:46.86,0:54:49.70,Default,,0,0,0,,Адал күле алмайтын мен ғана ма?
Dialogue: 0,0:54:49.82,0:54:53.49,Default,,0,0,0,,(Энтаро) Хоу Хоу
Dialogue: 0,0:54:56.16,0:54:58.92,Default,,0,0,0,,Соғыс болса да, цикадалар ән салады
Dialogue: 0,0:54:59.04,0:55:00.25,Default,,0,0,0,,Көбелектер де ұшады
Dialogue: 0,0:55:00.38,0:55:02.79,Default,,0,0,0,,(Әйел) Хаа... бірақ ыстық.
Dialogue: 0,0:55:04.59,0:55:06.17,Default,,0,0,0,,Иә, қант та.
Dialogue: 0,0:55:07.55,0:55:10.14,Default,,0,0,0,,Маусымдағы әуе шабуылы кезінде,
Dialogue: 0,0:55:10.26,0:55:12.93,Default,,0,0,0,,Көз алдымда соғыс болады деп ойладым.
Dialogue: 0,0:55:14.06,0:55:16.93,Default,,0,0,0,,Біз қазір қайдамыз? Біз не істеуіміз керек?
Dialogue: 0,0:55:17.06,0:55:18.98,Default,,0,0,0,,(Харуми) А, мінеки! О
Dialogue: 0,0:55:19.64,0:55:21.15,Default,,0,0,0,,(Харуми) Итата...
Dialogue: 0,0:55:21.27,0:55:22.98,Default,,0,0,0,,Харуми-сан, кешіріңіз, кешіріңіз.
Dialogue: 0,0:55:23.11,0:55:26.69,Default,,0,0,0,,Жарайды, Арико-сан, мен саған қарап тұрмын.
Dialogue: 0,0:55:26.82,0:55:28.11,Default,,0,0,0,,Хо
Dialogue: 0,0:55:28.24,0:55:30.86,Default,,0,0,0,,Бұл қанша уақытқа созылады деп ойлаймын
Dialogue: 0,0:55:33.32,0:55:35.24,Default,,0,0,0,,Иә...? Иә... (Харуми) Иә.
Dialogue: 0,0:55:36.08,0:55:39.75,Default,,0,0,0,,Иә, иә, иә... (Харуми) Иә...? ‬
Dialogue: 0,0:55:40.12,0:55:41.75,Default,,0,0,0,,Иә...? ‬
Dialogue: 0,0:55:43.13,0:55:43.92,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:55:50.97,0:55:51.93,Default,,0,0,0,,Ах! Қант қазір бағалы тауарға айналды.
Dialogue: 0,0:55:51.93,0:55:54.39,Default,,0,0,0,,Ах! Қант қазір бағалы тауарға айналды.
Dialogue: 0,0:55:51.93,0:55:54.39,Default,,0,0,0,,Ах! Иә!
Dialogue: 0,0:55:54.39,0:55:55.39,Default,,0,0,0,,Ах! Қант қазір бағалы тауарға айналды.
Dialogue: 0,0:55:55.51,0:55:59.31,Default,,0,0,0,,Уау, аа, а...
Dialogue: 0,0:55:59.43,0:56:00.64,Default,,0,0,0,,Ах (Харуми) Уау!
Dialogue: 0,0:56:02.31,0:56:05.48,Default,,0,0,0,,Арико таба алмайтын нәрсені жасырыңыз.
Dialogue: 0,0:56:05.61,0:56:09.19,Default,,0,0,0,,Жарайды, бірақ қайда? ‬
Dialogue: 0,0:56:11.03,0:56:13.11,Default,,0,0,0,,Иә? Хмм...
Dialogue: 0,0:56:13.24,0:56:15.33,Default,,0,0,0,,Не… не болды? ‬
Dialogue: 0,0:56:15.45,0:56:20.96,Default,,0,0,0,,Арико суда болса, маған жақындай алмайды деп ойладым.
Dialogue: 0,0:56:21.08,0:56:22.12,Default,,0,0,0,,(Харуми/Сузу) Уау! ‬
Dialogue: 0,0:56:29.38,0:56:33.22,Default,,0,0,0,,Мұны қара базардан сатып алу қиын.
Dialogue: 0,0:56:37.01,0:56:39.10,Default,,0,0,0,,Әдеттегіден басқа жол
Dialogue: 0,0:56:42.14,0:56:43.10,Default,,0,0,0,,(Балалар) Ләззат алыңыз.
Dialogue: 0,0:56:48.65,0:56:51.15,Default,,0,0,0,,Сатылатын ештеңе болмауы керек.
Dialogue: 0,0:56:51.28,0:56:53.61,Default,,0,0,0,,Неліктен адамдар көп...
Dialogue: 0,0:56:53.74,0:56:57.62,Default,,0,0,0,,Иә? Иә... иә
Dialogue: 0,0:56:57.74,0:57:01.58,Default,,0,0,0,,(Әйел) Бұл Тайвань күріші.
Dialogue: 0,0:57:01.70,0:57:02.62,Default,,0,0,0,,(қонақ) нәжіс
Dialogue: 0,0:57:02.75,0:57:04.50,Default,,0,0,0,,Мен ішкі күрішті ұйымдастыра алсам...
Dialogue: 0,0:57:04.50,0:57:06.13,Default,,0,0,0,,Мен ішкі күрішті ұйымдастыра алсам...
Dialogue: 0,0:57:04.50,0:57:06.13,Default,,0,0,0,,О~
Dialogue: 0,0:57:06.25,0:57:10.63,Default,,0,0,0,,Иә, егістікте қарбызға тыйым салу керек.
Dialogue: 0,0:57:11.59,0:57:14.72,Default,,0,0,0,,Күрсін, бәрі де болады.
Dialogue: 0,0:57:16.97,0:57:22.02,Default,,0,0,0,,Хаха, соғыс алдындағы жазғы демалыс сияқты.
Dialogue: 0,0:57:22.14,0:57:24.56,Default,,0,0,0,,(Дүкенші) бір бөлке қантқа 20 иен
Dialogue: 0,0:57:24.69,0:57:28.19,Default,,0,0,0,,... рационнан 50 есе артық? ‬
Dialogue: 0,0:57:28.31,0:57:31.32,Default,,0,0,0,,Қазір алмасам, бәрібір қымбат болады.
Dialogue: 0,0:57:31.44,0:57:36.41,Default,,0,0,0,,Ененің қарны мен осы айдағы күнкөріс шығыны барлығы 25 иен
Dialogue: 0,0:57:36.53,0:57:39.58,Default,,0,0,0,,Устрица тұқымдары
Dialogue: 0,0:57:42.58,0:57:46.96,Default,,0,0,0,,Қант қазір шамамен 150 иен тұрады.
Dialogue: 0,0:57:47.08,0:57:50.38,Default,,0,0,0,,Мен бұдан былай 100 иенге карамель немесе басқа ештеңе сатып ала алмаймын.
Dialogue: 0,0:57:50.50,0:57:51.92,Default,,0,0,0,,Шұлықтар
Dialogue: 0,0:57:52.05,0:57:55.47,Default,,0,0,0,,Егер сіз 3 жұп сатып алсаңыз, оның құны 1000 иен емес пе?
Dialogue: 0,0:57:56.55,0:58:00.31,Default,,0,0,0,,Мұндай елде тұруға бола ма?
Dialogue: 0,0:58:00.97,0:58:01.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:58:03.85,0:58:08.94,Default,,0,0,0,,Иә? Эй, бұл қайда? Бірге
Dialogue: 0,0:58:09.06,0:58:12.69,Default,,0,0,0,,(Әйел) Иә? Наганоки? Теңіз зираты бар ма? ‬
Dialogue: 0,0:58:12.82,0:58:14.44,Default,,0,0,0,,А... иә, Нагасако.
Dialogue: 0,0:58:14.57,0:58:17.45,Default,,0,0,0,,(Әйел) О, ана жақта (әйел) Міне, солай ма? ‬
Dialogue: 0,0:58:18.99,0:58:20.07,Default,,0,0,0,,Ха...
Dialogue: 0,0:58:32.55,0:58:34.38,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:58:38.26,0:58:39.05,Default,,0,0,0,,Жоқ
Dialogue: 0,0:58:40.35,0:58:42.85,Default,,0,0,0,,Қарбыз? Хаа
Dialogue: 0,0:58:42.97,0:58:45.31,Default,,0,0,0,,Карамель хаа
Dialogue: 0,0:58:45.43,0:58:47.44,Default,,0,0,0,,Бала жоғалды ма? Хаа
Dialogue: 0,0:58:48.19,0:58:52.15,Default,,0,0,0,,Сіз ересек болсаңыз да? Қайдан келдің? ‬
Dialogue: 0,0:58:52.27,0:58:53.40,Default,,0,0,0,,Наганоки
Dialogue: 0,0:58:54.19,0:58:58.07,Default,,0,0,0,,Апа, үйге баратын жолды ешкім айтпайды.
Dialogue: 0,0:58:58.20,0:59:03.28,Default,,0,0,0,,Бәрің, иіскеп көрейін. Бұл Рюгу сарайы ма? ‬
Dialogue: 0,0:59:03.41,0:59:09.50,Default,,0,0,0,,Егер сіз Наганокиде болсаңыз, бұрыштан бұрылып, пошта бөлімшесіне түсіңіз.
Dialogue: 0,0:59:09.62,0:59:11.13,Default,,0,0,0,,Мені күт.
Dialogue: 0,0:59:12.34,0:59:14.96,Default,,0,0,0,,Әпке, айтыңызшы.
Dialogue: 0,0:59:17.13,0:59:19.47,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:59:20.01,0:59:22.64,Default,,0,0,0,,Мына жерге барыңыз, мынаны қалдырыңыз
Dialogue: 0,0:59:22.76,0:59:26.81,Default,,0,0,0,,Алға барып, пошта бөлімшесінің жанындағы бұрышта оңға бұрылыңыз.
Dialogue: 0,0:59:26.93,0:59:28.77,Default,,0,0,0,,Рахмет
Dialogue: 0,0:59:29.56,0:59:33.36,Default,,0,0,0,,Айналадағылардың бәрі түсініксіз болуы керек.
Dialogue: 0,0:59:33.48,0:59:38.07,Default,,0,0,0,,Олардың көпшілігі аутсайдер, тіпті бұл қақпадан шықпайды.
Dialogue: 0,0:59:38.19,0:59:42.49,Default,,0,0,0,,Сіз де Хиросиманың оңтүстігінде... теңіз жағасындасыз ба? ‬
Dialogue: 0,0:59:42.62,0:59:44.99,Default,,0,0,0,,Иә, бірақ неге? ‬
Dialogue: 0,0:59:45.12,0:59:45.99,Default,,0,0,0,,Сөзбен
Dialogue: 0,0:59:46.12,0:59:48.37,Default,,0,0,0,,Еба немесе сол сияқты
Dialogue: 0,0:59:48.50,0:59:50.33,Default,,0,0,0,,Иә, Кусацу т.б.
Dialogue: 0,0:59:50.46,0:59:52.21,Default,,0,0,0,,Кусацу
Dialogue: 0,0:59:52.33,0:59:55.92,Default,,0,0,0,,Әжем жыл сайын бізбен бірге қарбыз жейтін.
Dialogue: 0,0:59:56.05,0:59:58.01,Default,,0,0,0,,Өйткені біз кедей едік
Dialogue: 0,0:59:58.13,1:00:00.88,Default,,0,0,0,,Адамдардың жеген терісінің бәрі жабысқақ болды.
Dialogue: 0,1:00:01.59,1:00:06.89,Default,,0,0,0,,Мен саған жақсылық жасауға тырыстым, қызылды жедім.
Dialogue: 0,1:00:07.56,1:00:10.02,Default,,0,0,0,,Бұл көп уақыт бұрын болды.
Dialogue: 0,1:00:10.14,1:00:14.77,Default,,0,0,0,,Суретіңізге қарасаңыз, жақсы екенсіз.
Dialogue: 0,1:00:15.52,1:00:16.52,Default,,0,0,0,,Мм...
Dialogue: 0,1:00:17.53,1:00:21.57,Default,,0,0,0,,Егер сізде басқа арзан заттар болса, маған хабарлаңыз.
Dialogue: 0,1:00:21.70,1:00:23.99,Default,,0,0,0,,Жалбыз қант вараби мочи
Dialogue: 0,1:00:24.12,1:00:25.58,Default,,0,0,0,,Жалбыз қант
Dialogue: 0,1:00:25.70,1:00:30.04,Default,,0,0,0,,Сосын балмұздақ вафлиі...
Dialogue: 0,1:00:30.16,1:00:31.21,Default,,0,0,0,,Вафель? ‬
Dialogue: 0,1:00:31.33,1:00:33.92,Default,,0,0,0,,Білмейсіз бе? Сіз Kiccha дүкенінде ешқашан болғансыз ба? ‬
Dialogue: 0,1:00:34.04,1:00:34.92,Default,,0,0,0,,(Әйел) Рин! ‬
Dialogue: 0,1:00:35.04,1:00:37.42,Default,,0,0,0,,Мұнай сатушы көп емес.
Dialogue: 0,1:00:37.55,1:00:40.30,Default,,0,0,0,,Кешіріңіз, мен қазір кетуім керек.
Dialogue: 0,1:00:40.42,1:00:42.80,Default,,0,0,0,,Ой, эй, келесі жолы сурет саламын.
Dialogue: 0,1:00:44.97,1:00:48.81,Default,,0,0,0,,Иә, мен мұндай жерге ешқашан келмеймін.
Dialogue: 0,1:00:48.93,1:00:50.18,Default,,0,0,0,,Иә?
Dialogue: 0,1:00:50.31,1:00:54.81,Default,,0,0,0,,Хехехе... Тағы адасып қалармын.
Dialogue: 0,1:00:59.94,1:01:03.91,Default,,0,0,0,,(жел үні)
Dialogue: 0,1:01:15.21,1:01:20.51,Default,,0,0,0,,(Мейко) Кеш болды. Мен базарға барғым келді. Үйге келе жатып, қателескен шығармын деп ойладым.
Dialogue: 0,1:01:20.63,1:01:21.71,Default,,0,0,0,,Хаа
Dialogue: 0,1:01:21.84,1:01:23.05,Default,,0,0,0,,Қайын апа
Dialogue: 0,1:01:23.17,1:01:26.80,Default,,0,0,0,,Кича дүкені вафли қосылған балмұздақ утара
Dialogue: 0,1:01:26.93,1:01:28.18,Default,,0,0,0,,Бұл қандай? ‬
Dialogue: 0,1:01:28.30,1:01:29.60,Default,,0,0,0,,Неліктен білмейсің?
Dialogue: 0,1:01:30.68,1:01:33.43,Default,,0,0,0,,Дұрыс, сен сондай тәтті және суықсың.
Dialogue: 0,1:01:33.56,1:01:36.60,Default,,0,0,0,,Бұл қытырлақ күріш крекеріне ұқсайды, сондықтан оны жинап жеп қойыңыз.
Dialogue: 0,1:01:37.23,1:01:38.40,Default,,0,0,0,,Аа, солай.
Dialogue: 0,1:01:38.52,1:01:40.78,Default,,0,0,0,,А, бұл...
Dialogue: 0,1:01:42.07,1:01:43.61,Default,,0,0,0,,Ахх
Dialogue: 0,1:01:43.74,1:01:46.36,Default,,0,0,0,,Біз тәттілер туралы сөйлескенімізге біраз болды.
Dialogue: 0,1:01:46.49,1:01:49.08,Default,,0,0,0,,Жай судың өзі тәтті көрінеді.
Dialogue: 0,1:01:49.20,1:01:50.54,Default,,0,0,0,,Ах...
Dialogue: 0,1:01:56.50,1:01:57.96,Default,,0,0,0,,Әлі ыстық
Dialogue: 0,1:01:59.50,1:02:03.26,Default,,0,0,0,,(Чита) Ходжоның әйелі, сізге қоңырау шалыңыз.
Dialogue: 0,1:02:04.30,1:02:07.01,Default,,0,0,0,,Иә, үйде ме? ‬
Dialogue: 0,1:02:10.22,1:02:11.68,Default,,0,0,0,,Мынау мынау
Dialogue: 0,1:02:13.02,1:02:14.56,Default,,0,0,0,,Хаа... ыстық, ыстық
Dialogue: 0,1:02:14.68,1:02:16.19,Default,,0,0,0,,Бұл Шусакуды ұятқа қалдыру керек.
Dialogue: 0,1:02:16.31,1:02:17.56,Default,,0,0,0,,Солай киініп шықсаң...
Dialogue: 0,1:02:23.94,1:02:25.40,Default,,0,0,0,,(бу ысқырығы)
Dialogue: 0,1:02:27.95,1:02:30.32,Default,,0,0,0,,(подполковник) Жарайды, раундқа дейін аздап жүрейік.
Dialogue: 0,1:02:30.45,1:02:33.83,Default,,0,0,0,,Сонымен, GKF қалай болды?
Dialogue: 0,1:02:33.95,1:02:35.33,Default,,0,0,0,,(майор) Босаңсыды.
Dialogue: 0,1:02:35.46,1:02:38.83,Default,,0,0,0,,(Солдат) Ал, алдымен салқын сыра ішейік.
Dialogue: 0,1:02:53.06,1:02:53.85,Default,,0,0,0,,Ах
Dialogue: 0,1:02:54.72,1:02:58.31,Default,,0,0,0,,Шот тапсыруға Шусаку мырза келді.
Dialogue: 0,1:02:58.44,1:03:00.35,Default,,0,0,0,,(Шусаку) Иә? Ах...
Dialogue: 0,1:03:00.94,1:03:02.06,Default,,0,0,0,,Хэхе...
Dialogue: 0,1:03:02.19,1:03:05.36,Default,,0,0,0,,Ах... Ах! Сузу-сан
Dialogue: 0,1:03:05.49,1:03:07.78,Default,,0,0,0,,Бұл өте ақ, бірақ жақсы ма? ‬
Dialogue: 0,1:03:08.45,1:03:10.53,Default,,0,0,0,,өтіңіз...Бұл біртүрлі емес пе?
Dialogue: 0,1:03:11.12,1:03:13.70,Default,,0,0,0,,Жоқ, жақсы болсаң, иә.
Dialogue: 0,1:03:13.83,1:03:15.29,Default,,0,0,0,,Эй, барамыз ба?
Dialogue: 0,1:03:15.83,1:03:18.08,Default,,0,0,0,,Не? Сіздің жұмысыңыз...
Dialogue: 0,1:03:18.21,1:03:21.71,Default,,0,0,0,,(Шусаку) Шұғыл болмаса да, есепшотты әдейі ала келдің.
Dialogue: 0,1:03:22.50,1:03:25.71,Default,,0,0,0,,Мен қалада дүкен аралап көңілді болдым деп ойладым.
Dialogue: 0,1:03:26.96,1:03:28.30,Default,,0,0,0,,Хмм…
Dialogue: 0,1:03:29.05,1:03:32.43,Default,,0,0,0,,Иә? Не болды? Мен өзімді нашар сезінемін...
Dialogue: 0,1:03:32.55,1:03:34.89,Default,,0,0,0,,Мен қатты күлемін.
Dialogue: 0,1:03:36.89,1:03:38.52,Default,,0,0,0,,О...
Dialogue: 0,1:03:40.52,1:03:42.44,Default,,0,0,0,,(Шусаку) Мен де фильм шығар деп ойладым.
Dialogue: 0,1:03:42.56,1:03:43.90,Default,,0,0,0,,(2 адам) Ха...
Dialogue: 0,1:03:44.86,1:03:47.90,Default,,0,0,0,,(Шусаку) Үлкен кеме қайтып келгенде не болды?
Dialogue: 0,1:03:49.95,1:03:51.41,Default,,0,0,0,,Жарайды, мен бұл жерде берілмеймін.
Dialogue: 0,1:03:52.57,1:03:55.03,Default,,0,0,0,,Өкінішке орай, мен мұны қайталаймын.
Dialogue: 0,1:03:58.04,1:03:59.46,Default,,0,0,0,,Сузу-сан? ‬
Dialogue: 0,1:03:59.58,1:04:04.71,Default,,0,0,0,,Бастауыш мектепте матрос болған бір сыныптасым бар еді.
Dialogue: 0,1:04:04.84,1:04:07.26,Default,,0,0,0,,Біз кездескенде не істеуіміз керек деп ойлайсыңдар?
Dialogue: 0,1:04:07.38,1:04:09.92,Default,,0,0,0,,Мен жай ғана амандассам жақсы болар еді.
Dialogue: 0,1:04:10.72,1:04:13.55,Default,,0,0,0,,Егер мен бұрыннан таныс адаммен қазір кездессем ше?
Dialogue: 0,1:04:13.68,1:04:17.85,Default,,0,0,0,,Түсіңізден оянамын деп ойлайсыз ба?
Dialogue: 0,1:04:17.97,1:04:19.06,Default,,0,0,0,,(Шусаку) Арман? ‬
Dialogue: 0,1:04:19.18,1:04:22.44,Default,,0,0,0,,Тұратын жеріңізді өзгерту, фамилияңызды өзгерту қиыншылыққа толы.
Dialogue: 0,1:04:23.23,1:04:26.48,Default,,0,0,0,,Шусаку-санға мейірімді болыңыз.
Dialogue: 0,1:04:26.61,1:04:28.44,Default,,0,0,0,,Мен де достар таптым.
Dialogue: 0,1:04:29.07,1:04:32.49,Default,,0,0,0,,Иә, қазір оянсам қызық болмас еді.
Dialogue: 0,1:04:32.61,1:04:35.53,Default,,0,0,0,,Егер қазіргі жағдай рас болса, мен солай ойлаймын.
Dialogue: 0,1:04:35.66,1:04:37.08,Default,,0,0,0,,(Шусаку) Түсіндім.
Dialogue: 0,1:04:38.08,1:04:41.29,Default,,0,0,0,,Не өтті, мен таңдамаған жол
Dialogue: 0,1:04:41.41,1:04:44.79,Default,,0,0,0,,Оянған түстен айырмашылығы жоқ
Dialogue: 0,1:04:44.92,1:04:47.46,Default,,0,0,0,,Сузу-сан, мен сені таңдадым.
Dialogue: 0,1:04:47.59,1:04:50.51,Default,,0,0,0,,Мен үшін ең жақсы таңдау шығар.
Dialogue: 0,1:04:52.17,1:04:55.18,Default,,0,0,0,,Сіз аздап арықтаған сияқтысыз, бірақ мен уайымдап тұрмын.
Dialogue: 0,1:04:55.76,1:04:59.89,Default,,0,0,0,,Айтпақшы, мен бұл күндері көп тамақ жемейтін сияқтымын.
Dialogue: 0,1:05:00.02,1:05:01.06,Default,,0,0,0,,(Шусаку) Хо
Dialogue: 0,1:05:01.18,1:05:03.39,Default,,0,0,0,,Ах... Ах! ‬
Dialogue: 0,1:05:03.52,1:05:04.31,Default,,0,0,0,,(Шусаку) Иә? ‬
Dialogue: 0,1:05:04.44,1:05:05.94,Default,,0,0,0,,Ах! (Шусаку) Ах! ‬
Dialogue: 0,1:05:06.81,1:05:08.27,Default,,0,0,0,,(Киязи) Иә, 2 адамға.
Dialogue: 0,1:05:08.40,1:05:09.19,Default,,0,0,0,,Ах...
Dialogue: 0,1:05:21.58,1:05:23.21,Default,,0,0,0,,Иә?
Dialogue: 0,1:05:23.87,1:05:25.75,Default,,0,0,0,,Сен жақсысың.
Dialogue: 0,1:05:26.79,1:05:28.79,Default,,0,0,0,,Жолыңыздан шыққаныңыз үшін рахмет
Dialogue: 0,1:05:28.92,1:05:30.84,Default,,0,0,0,,Күрсін... жақсы.
Dialogue: 0,1:05:31.80,1:05:34.34,Default,,0,0,0,,Ауруханаға барғаннан кейін.
Dialogue: 0,1:05:34.47,1:05:37.43,Default,,0,0,0,,Аурухана? Не болды? ‬
Dialogue: 0,1:05:37.55,1:05:39.18,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,1:05:40.06,1:05:42.02,Default,,0,0,0,,жақсы болар еді
Dialogue: 0,1:05:42.14,1:05:44.44,Default,,0,0,0,,Қарбызды жақсы жейсің.
Dialogue: 0,1:05:44.56,1:05:47.77,Default,,0,0,0,,Вараби мочи және жалбыз қант
Dialogue: 0,1:05:47.90,1:05:48.69,Default,,0,0,0,,Хэхе...
Dialogue: 0,1:05:49.61,1:05:52.03,Default,,0,0,0,,Иә? бұл не? ‬
Dialogue: 0,1:05:52.57,1:05:56.70,Default,,0,0,0,,Ах... хехе
Dialogue: 0,1:05:57.70,1:06:00.74,Default,,0,0,0,,(күлді)
Dialogue: 0,1:06:02.83,1:06:06.12,Default,,0,0,0,,Мм... Дұрыс, балмұздақ.
Dialogue: 0,1:06:06.25,1:06:09.00,Default,,0,0,0,,Иә! Бұл балмұздақ па? ‬
Dialogue: 0,1:06:09.13,1:06:12.25,Default,,0,0,0,,Ах~ кешіріңіз
Dialogue: 0,1:06:12.38,1:06:14.84,Default,,0,0,0,,Мен неге екенін түсінбеймін
Dialogue: 0,1:06:15.88,1:06:17.89,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,1:06:18.01,1:06:20.51,Default,,0,0,0,,Таки Джинджоға жарты жылға барады.
Dialogue: 0,1:06:20.64,1:06:23.56,Default,,0,0,0,,Мен Катакананы оңай түсінемін.
Dialogue: 0,1:06:24.18,1:06:26.73,Default,,0,0,0,,Мен Хирагананы оқи алмаймын...
Dialogue: 0,1:06:28.98,1:06:33.36,Default,,0,0,0,,Әй, жеке куәлік жазу қиын.
Dialogue: 0,1:06:33.48,1:06:35.24,Default,,0,0,0,,Жарайды
Dialogue: 0,1:06:35.36,1:06:38.20,Default,,0,0,0,,Иә, оны маған тапсырыс беруші жазды.
Dialogue: 0,1:06:40.12,1:06:41.66,Default,,0,0,0,,Бұл жақсы
Dialogue: 0,1:06:42.74,1:06:43.66,Default,,0,0,0,,Дұрыс? ‬
Dialogue: 0,1:06:43.79,1:06:45.12,Default,,0,0,0,,Иә?
Dialogue: 0,1:06:45.25,1:06:47.29,Default,,0,0,0,,Шираки Рин-сан, сен солай айтасың.
Dialogue: 0,1:06:47.42,1:06:48.21,Default,,0,0,0,,Иә
Dialogue: 0,1:06:49.54,1:06:54.09,Default,,0,0,0,,Эй, мен өзімді сәл кешіктіріп таныстырғым келеді...
Dialogue: 0,1:06:56.26,1:06:57.30,Default,,0,0,0,,Иә? ‬
Dialogue: 0,1:07:02.97,1:07:04.72,Default,,0,0,0,,Ал...
Dialogue: 0,1:07:06.35,1:07:07.64,Default,,0,0,0,,«Хо»
Dialogue: 0,1:07:07.77,1:07:09.85,Default,,0,0,0,,Джи… «Джо»
Dialogue: 0,1:07:21.82,1:07:23.24,Default,,0,0,0,,Бұл Сузу-сан! Сәлем!
Dialogue: 0,1:07:23.37,1:07:24.87,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,1:07:26.00,1:07:27.54,Default,,0,0,0,,Хэхехе ахах...
Dialogue: 0,1:07:27.66,1:07:30.37,Default,,0,0,0,,Рахмет, Сузу-сан, сурет
Dialogue: 0,1:07:30.50,1:07:32.63,Default,,0,0,0,,Мен оны жақсы күтемін.
Dialogue: 0,1:07:32.75,1:07:34.34,Default,,0,0,0,,Дұрыс.
Dialogue: 0,1:07:35.59,1:07:38.51,Default,,0,0,0,,(Риннің гуілдеуі)
Dialogue: 0,1:07:38.63,1:07:42.09,Default,,0,0,0,,♪ «Қалайсың?»
Dialogue: 0,1:07:43.26,1:07:45.97,Default,,0,0,0,,Білесің бе, Рин-сан?
Dialogue: 0,1:07:46.10,1:07:46.89,Default,,0,0,0,,Иә? ‬
Dialogue: 0,1:07:47.89,1:07:52.40,Default,,0,0,0,,Менің акушерім гинекологиялық тексеруден өтуімді ұсынды.
Dialogue: 0,1:07:52.52,1:07:55.57,Default,,0,0,0,,Сіз жүктісіз бе?
Dialogue: 0,1:07:56.28,1:07:57.86,Default,,0,0,0,,Егер сіз ойласаңыз
Dialogue: 0,1:07:57.99,1:08:01.07,Default,,0,0,0,,Тағамдық жетіспеушіліктер мен қоршаған ортаның өзгеруіне байланысты
Dialogue: 0,1:08:01.20,1:08:04.03,Default,,0,0,0,,Тек айдың айналымы нашар.
Dialogue: 0,1:08:04.16,1:08:05.70,Default,,0,0,0,,О
Dialogue: 0,1:08:05.83,1:08:09.08,Default,,0,0,0,,Ондай адамдарды осында да қарсы алыңыздар.
Dialogue: 0,1:08:09.21,1:08:11.58,Default,,0,0,0,,Мен қызғанамын
Dialogue: 0,1:08:11.71,1:08:16.50,Default,,0,0,0,,Тек сіңіргіш мақта мен мата ғана емес, тіпті қағаз да құнды.
Dialogue: 0,1:08:16.63,1:08:18.96,Default,,0,0,0,,Әрине
Dialogue: 0,1:08:19.51,1:08:23.09,Default,,0,0,0,,Тіпті Шусаку мен үйдегілер.
Dialogue: 0,1:08:23.22,1:08:25.43,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,1:08:26.39,1:08:28.39,Default,,0,0,0,,Шусаку мырза? ‬
Dialogue: 0,1:08:28.52,1:08:31.02,Default,,0,0,0,,Әй, күйеуім.
Dialogue: 0,1:08:31.14,1:08:33.48,Default,,0,0,0,,Сіз де оны асыға күтесіз бе? ‬
Dialogue: 0,1:08:33.60,1:08:34.69,Default,,0,0,0,,Ал...
Dialogue: 0,1:08:36.15,1:08:40.28,Default,,0,0,0,,Анам босанған сайын тісі түсіп қалатын.
Dialogue: 0,1:08:40.95,1:08:41.90,Default,,0,0,0,,Уф
Dialogue: 0,1:08:42.78,1:08:45.28,Default,,0,0,0,,Ақыры босанып өлдім.
Dialogue: 0,1:08:45.41,1:08:46.37,Default,,0,0,0,,Уф...
Dialogue: 0,1:08:46.49,1:08:48.74,Default,,0,0,0,,Бұл әлі қызық емес пе? ‬
Dialogue: 0,1:08:48.87,1:08:50.29,Default,,0,0,0,,Ой...
Dialogue: 0,1:08:52.16,1:08:55.92,Default,,0,0,0,,Қорқынышты нәрселер қорқынышты.
Dialogue: 0,1:08:56.04,1:08:57.55,Default,,0,0,0,,Жоқ, жақсы.
Dialogue: 0,1:08:57.67,1:09:00.71,Default,,0,0,0,,Ерлер ұрыс даласында өз өмірлерін қатерге тігеді.
Dialogue: 0,1:09:00.84,1:09:04.22,Default,,0,0,0,,Иә, мен де өз міндетімді орындаймын.
Dialogue: 0,1:09:04.34,1:09:05.64,Default,,0,0,0,,Міндеттеме? ‬
Dialogue: 0,1:09:07.60,1:09:11.60,Default,,0,0,0,,Артына мұрагер қалдыру әйелдің міндеті ғой.
Dialogue: 0,1:09:11.72,1:09:14.31,Default,,0,0,0,,Бұл міндетті түрде адам туады деген сөз емес...
Dialogue: 0,1:09:14.44,1:09:18.31,Default,,0,0,0,,Хмм... Босанғанша босанатын шығармын.
Dialogue: 0,1:09:18.44,1:09:21.28,Default,,0,0,0,,Нәтиже жақсы болатынына кепілдік жоқ.
Dialogue: 0,1:09:21.40,1:09:23.86,Default,,0,0,0,,Менің ойымша, олардың резерві көбірек болады.
Dialogue: 0,1:09:23.99,1:09:26.78,Default,,0,0,0,,Хмм, бұл жеткіліксіз.
Dialogue: 0,1:09:26.91,1:09:30.24,Default,,0,0,0,,Иә... бұл рас.
Dialogue: 0,1:09:31.33,1:09:35.83,Default,,0,0,0,,Әйелдің міндеттері бір жерде орындалмай қалса не болады? ‬
Dialogue: 0,1:09:36.63,1:09:38.46,Default,,0,0,0,,Үйге оралды
Dialogue: 0,1:09:38.59,1:09:40.00,Default,,0,0,0,,Қайтып келгенде не болады? ‬
Dialogue: 0,1:09:40.13,1:09:42.30,Default,,0,0,0,,Ал...
Dialogue: 0,1:09:43.47,1:09:45.84,Default,,0,0,0,,Мен Онии-чанның мені жеңетініне сенімдімін.
Dialogue: 0,1:09:45.97,1:09:47.80,Default,,0,0,0,,Мен тапсырмадамын.
Dialogue: 0,1:09:47.93,1:09:51.89,Default,,0,0,0,,Ана мен әке үшін де солай шығар.
Dialogue: 0,1:09:52.02,1:09:54.69,Default,,0,0,0,,Сіз еріктілер корпусына қосыла аласыз деп ойлаймын.
Dialogue: 0,1:09:54.81,1:09:56.81,Default,,0,0,0,,Мен Суми Чанмен біргемін.
Dialogue: 0,1:09:56.94,1:10:00.32,Default,,0,0,0,,Бұл шынымен де қорқынышты ма? ‬
Dialogue: 0,1:10:00.44,1:10:02.61,Default,,0,0,0,,Хмм...
Dialogue: 0,1:10:02.74,1:10:06.53,Default,,0,0,0,,Мм.
Dialogue: 0,1:10:07.45,1:10:08.99,Default,,0,0,0,,О
Dialogue: 0,1:10:09.12,1:10:12.91,Default,,0,0,0,,Бірақ балалы болсаң, үлкен тірек болады.
Dialogue: 0,1:10:13.04,1:10:16.75,Default,,0,0,0,,Уа... ау, қандай сүйкімді.
Dialogue: 0,1:10:16.87,1:10:18.75,Default,,0,0,0,,Қиындыққа тап болсаңыз, оны сата аласыз.
Dialogue: 0,1:10:18.88,1:10:19.84,Default,,0,0,0,,Иә?
Dialogue: 0,1:10:20.79,1:10:25.01,Default,,0,0,0,,Әйелдер қымбатырақ, бірақ мұрагер бола алмасаңыз да жақсы.
Dialogue: 0,1:10:25.13,1:10:28.01,Default,,0,0,0,,Иә, мен мұны қазір істей аламын.
Dialogue: 0,1:10:29.51,1:10:30.68,Default,,0,0,0,,А...
Dialogue: 0,1:10:30.80,1:10:34.43,Default,,0,0,0,,Мен бір нәрсеге алаңдаймын, бірақ мен өзімді ақымақ сияқты сезіне бастадым.
Dialogue: 0,1:10:35.06,1:10:37.14,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,1:10:38.06,1:10:39.15,Default,,0,0,0,,А...
Dialogue: 0,1:10:42.78,1:10:44.03,Default,,0,0,0,,Анна
Dialogue: 0,1:10:44.15,1:10:47.61,Default,,0,0,0,,Тіпті сатылған балалар да белгілі бір дәрежеде өмір сүре алады.
Dialogue: 0,1:10:48.99,1:10:53.24,Default,,0,0,0,,Маған бұл дүниеде орын жоқ, өксіре берме.
Dialogue: 0,1:10:53.37,1:10:55.29,Default,,0,0,0,,Дұрыс па? Сузу-сан
Dialogue: 0,1:10:57.12,1:10:59.54,Default,,0,0,0,,Рахмет, Лин
Dialogue: 0,1:11:06.88,1:11:10.76,Default,,0,0,0,,(Рин Сузу) Хэхе... хехехе
Dialogue: 0,1:11:10.89,1:11:16.18,Default,,0,0,0,,Мен таңертең қосымша тамақтандым, сондықтан бұл жеткілікті.
Dialogue: 0,1:11:16.31,1:11:17.27,Default,,0,0,0,,күрсіну...
Dialogue: 0,1:11:18.31,1:11:20.19,Default,,0,0,0,,Майсыздандырылған күріш ботқасы
Dialogue: 0,1:11:20.31,1:11:22.77,Default,,0,0,0,,(Ескерту)
Dialogue: 0,1:11:22.90,1:11:24.57,Default,,0,0,0,,Күзгі жел соғады
Dialogue: 0,1:11:24.69,1:11:28.65,Default,,0,0,0,,Дабылдар жиілеп барады.
Dialogue: 0,1:11:28.78,1:11:32.49,Default,,0,0,0,,Күз келсе, жазғы футон киетін кез.
Dialogue: 0,1:11:32.62,1:11:34.54,Default,,0,0,0,,Қысқы киімдерді шеш
Dialogue: 0,1:11:34.66,1:11:39.16,Default,,0,0,0,,Осы кезде біз де Кобаяши ағасының жүкті эвакуациялауын қабылдадық.
Dialogue: 0,1:11:41.96,1:11:44.13,Default,,0,0,0,,Ху... (Кобаяшидің әйелі) Еңбегіңізге рахмет.
Dialogue: 0,1:11:44.25,1:11:46.55,Default,,0,0,0,,Сузу-сан, біз де шай ішейік.
Dialogue: 0,1:11:46.67,1:11:47.80,Default,,0,0,0,,Иә
Dialogue: 0,1:11:49.80,1:11:50.76,Default,,0,0,0,,Ах...
Dialogue: 0,1:11:51.72,1:11:52.89,Default,,0,0,0,,(Кобаяши) Коидемо⸺
Dialogue: 0,1:11:53.01,1:11:56.85,Default,,0,0,0,,Үйім өртеніп кетсе де, менің тікелей күн көрісім үшін уайымдамаймын.
Dialogue: 0,1:11:56.97,1:12:00.06,Default,,0,0,0,,Тіс щеткасы да, сарумата да ыдыста және ыдыста.
Dialogue: 0,1:12:00.19,1:12:01.90,Default,,0,0,0,,Мм... иә? ‬
Dialogue: 0,1:12:02.69,1:12:05.40,Default,,0,0,0,,Жүр, бұл менікі емес.
Dialogue: 0,1:12:05.52,1:12:07.15,Default,,0,0,0,,Мен де білмеймін
Dialogue: 0,1:12:07.99,1:12:08.99,Default,,0,0,0,,Ах...
Dialogue: 0,1:12:09.11,1:12:10.32,Default,,0,0,0,,Бұл сіз туралы.
Dialogue: 0,1:12:10.45,1:12:13.16,Default,,0,0,0,,Сенің сыйыңды ұмытпа.
Dialogue: 0,1:12:13.28,1:12:15.03,Default,,0,0,0,,Менің ойымша...
Dialogue: 0,1:12:19.91,1:12:21.37,Default,,0,0,0,,Хехе...
Dialogue: 0,1:12:21.50,1:12:24.50,Default,,0,0,0,,Сузу-сан менің әйелім емес.
Dialogue: 0,1:12:24.63,1:12:25.63,Default,,0,0,0,,(Кёси/Сузу) Иә? ‬
Dialogue: 0,1:12:25.75,1:12:29.72,Default,,0,0,0,,Ерінбей еңбек ет, жеңіл жүр.
Dialogue: 0,1:12:29.84,1:12:34.76,Default,,0,0,0,,Сіздің арқаңызда Шусаку-кун да жарқырап кеткендей болды.
Dialogue: 0,1:12:40.02,1:12:45.06,Default,,0,0,0,,Бұл баланың біртүрлі ессіздігі ғана. Тым ерте бас тарт.
Dialogue: 0,1:12:45.19,1:12:49.28,Default,,0,0,0,,Сузу-сандай қызбен берік бол.
Dialogue: 0,1:12:49.40,1:12:52.86,Default,,0,0,0,,Бұл өте жақсы болды.
Dialogue: 0,1:12:59.29,1:13:01.04,Default,,0,0,0,,Хэхе... Хэхе...
Dialogue: 0,1:13:01.16,1:13:05.46,Default,,0,0,0,,Аа, футонды аударыңыз. Ах...
Dialogue: 0,1:13:09.34,1:13:10.13,Default,,0,0,0,,(Кобаяшидің әйелі) Ах.
Dialogue: 0,1:13:10.26,1:13:13.68,Default,,0,0,0,,Құдай-ау, мен теледидар алдым!
Dialogue: 0,1:13:13.80,1:13:16.60,Default,,0,0,0,,Маңызды бөлігінің менің басыма жеткенін қаламаймын.
Dialogue: 0,1:13:16.72,1:13:19.47,Default,,0,0,0,,(Кобаяши) Жарайды, оның келгеніне қуаныштымын.
Dialogue: 0,1:13:19.60,1:13:21.98,Default,,0,0,0,,Суық тер Санто Яну
Dialogue: 0,1:13:23.69,1:13:25.27,Default,,0,0,0,,Сузу Ноу
Dialogue: 0,1:13:25.40,1:13:27.11,Default,,0,0,0,,Қызыл инелік
Dialogue: 0,1:13:27.23,1:13:30.36,Default,,0,0,0,,Жаз бен күздің түстері қызылдың әртүрлі түстері.
Dialogue: 0,1:13:30.48,1:13:33.86,Default,,0,0,0,,Уау, бұл рас.
Dialogue: 0,1:13:33.99,1:13:34.95,Default,,0,0,0,,(Шусаку) Йо
Dialogue: 0,1:13:36.28,1:13:37.24,Default,,0,0,0,,Иә
Dialogue: 0,1:13:44.08,1:13:44.96,Default,,0,0,0,,Эвакуациялаңыз! Эвакуацияланамын!
Dialogue: 0,1:13:44.96,1:13:45.92,Default,,0,0,0,,Эвакуациялаңыз! Эвакуацияланамын!
Dialogue: 0,1:13:44.96,1:13:45.92,Default,,0,0,0,,(Мейко) А
Dialogue: 0,1:13:45.92,1:13:48.17,Default,,0,0,0,,Эвакуациялаңыз! Эвакуацияланамын!
Dialogue: 0,1:13:48.29,1:13:49.92,Default,,0,0,0,,Сіз оны дұрыс ұстадыңыз ба? ‬
Dialogue: 0,1:13:50.05,1:13:52.09,Default,,0,0,0,,Иә Уау! (құлап түскен дыбыс)
Dialogue: 0,1:13:54.01,1:13:57.93,Default,,0,0,0,,(Өрт бригадасының мүшесі) Дәл қазір бұл сәулелену жаттығуларына арналған достық ұшақ! ‬
Dialogue: 0,1:13:59.85,1:14:01.52,Default,,0,0,0,,Сәлем
Dialogue: 0,1:14:04.10,1:14:05.39,Default,,0,0,0,,Шешуші шайқас...
Dialogue: 0,1:14:06.56,1:14:07.65,Default,,0,0,0,,Беттері...
Dialogue: 0,1:14:34.01,1:14:35.01,Default,,0,0,0,,Иә? ‬
Dialogue: 0,1:14:54.65,1:14:56.03,Default,,0,0,0,,О...
Dialogue: 0,1:14:57.15,1:15:00.53,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,1:15:59.59,1:16:00.97,Default,,0,0,0,,Ха…
Dialogue: 0,1:16:03.10,1:16:05.35,Default,,0,0,0,,Мен әйелім болатын адамға осылай жасасам ба деп ойлаймын.
Dialogue: 0,1:16:05.47,1:16:06.85,Default,,0,0,0,,Мен оны бұрын сатып алғанмын.
Dialogue: 0,1:16:06.97,1:16:08.06,Default,,0,0,0,,Иә?
Dialogue: 0,1:16:08.18,1:16:09.56,Default,,0,0,0,,Сузу-сан, оны қолданыңыз.
Dialogue: 0,1:16:09.69,1:16:11.23,Default,,0,0,0,,Иә.
Dialogue: 0,1:16:13.36,1:16:15.44,Default,,0,0,0,,Парашют қонғанға дейін⸺
Dialogue: 0,1:16:13.36,1:16:15.44,Default,,0,0,0,,Бұл арман емес екенін білемін...
Dialogue: 0,1:16:15.44,1:16:15.57,Default,,0,0,0,,Мен бұл арман емес екенін білемін...
Dialogue: 0,1:16:15.57,1:16:17.65,Default,,0,0,0,,Мен бұл арман емес екенін білемін...
Dialogue: 0,1:16:15.57,1:16:17.65,Default,,0,0,0,,Аяқтарды көздеңіз (Үй шаруасындағы әйел) Ta!
Dialogue: 0,1:16:19.40,1:16:20.40,Default,,0,0,0,,Жақсы! ‬
Dialogue: 0,1:16:21.11,1:16:22.99,Default,,0,0,0,,Келесі қалып
Dialogue: 0,1:16:23.12,1:16:23.95,Default,,0,0,0,,Айтат
Dialogue: 0,1:16:24.07,1:16:27.49,Default,,0,0,0,,(Чита) Қараңдаршы, сенің кезегіңде бей-жай қалу.
Dialogue: 0,1:16:27.62,1:16:28.62,Default,,0,0,0,,Иә
Dialogue: 0,1:16:28.75,1:16:30.16,Default,,0,0,0,,(Чита) Ой...
Dialogue: 0,1:16:30.29,1:16:32.37,Default,,0,0,0,,Баршаңызға.
Dialogue: 0,1:16:32.50,1:16:35.09,Default,,0,0,0,,(Қария) Ұзын алып жүрсең маған жақындағаныңды қаламаймын.
Dialogue: 0,1:16:35.21,1:16:37.13,Default,,0,0,0,,Мұнда не болып жатыр?
Dialogue: 0,1:16:37.25,1:16:38.38,Default,,0,0,0,,(нұсқаушы) Дайын! ‬
Dialogue: 0,1:16:39.76,1:16:43.84,Default,,0,0,0,,Сонда да бұл күндер жалғасуда
Dialogue: 0,1:16:59.48,1:17:00.57,Default,,0,0,0,,Ой...
Dialogue: 0,1:17:08.74,1:17:10.12,Default,,0,0,0,,Уау! ‬
Dialogue: 0,1:17:10.25,1:17:12.79,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,1:17:12.91,1:17:16.29,Default,,0,0,0,,(Кейко) Уау... Ракон сарайы қайда екен деп ойлаймын.
Dialogue: 0,1:17:19.88,1:17:21.30,Default,,0,0,0,,(Шусаку) Ха...
Dialogue: 0,1:17:21.92,1:17:23.26,Default,,0,0,0,,Дәл қазір
Dialogue: 0,1:17:23.38,1:17:25.72,Default,,0,0,0,,Қайтадан қош келдіңіз.
Dialogue: 0,1:17:26.47,1:17:27.55,Default,,0,0,0,,(Шусаку) Иә? ‬
Dialogue: 0,1:17:28.31,1:17:31.85,Default,,0,0,0,,Дануки баласын жапырақтар ұстайды.
Dialogue: 0,1:17:31.98,1:17:32.89,Default,,0,0,0,,Хаа
Dialogue: 0,1:17:33.02,1:17:36.86,Default,,0,0,0,,Мен құлаған жапырақтармен алмастырғыш тадон жасаймын.
Dialogue: 0,1:17:36.98,1:17:38.40,Default,,0,0,0,,О
Dialogue: 0,1:17:39.36,1:17:41.11,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе
Dialogue: 0,1:17:42.32,1:17:45.49,Default,,0,0,0,,(Шусаку) ♪ «Қалайсың?»
Dialogue: 0,1:17:46.37,1:17:47.49,Default,,0,0,0,,Ах...
Dialogue: 0,1:17:48.03,1:17:50.45,Default,,0,0,0,,(Кобаяши) Екеуің
Dialogue: 0,1:17:51.33,1:17:52.70,Default,,0,0,0,,(Кобаяшидің әйелі) Иә? ‬
Dialogue: 0,1:17:52.83,1:17:53.91,Default,,0,0,0,,Жоқ...
Dialogue: 0,1:17:54.96,1:17:59.75,Default,,0,0,0,,Жоқ, шынымен де, бәрі жақсы деп ойлаймын.
Dialogue: 0,1:18:00.59,1:18:05.72,Default,,0,0,0,,Шусакуға сонша ақшаны қарызға бермесең болды ғой.
Dialogue: 0,1:18:05.84,1:18:08.14,Default,,0,0,0,,Міне осылай
Dialogue: 0,1:18:08.26,1:18:11.68,Default,,0,0,0,,Бастығым мені бірінші рет жезөкшелер үйіне апарды.
Dialogue: 0,1:18:11.81,1:18:14.68,Default,,0,0,0,,Шыққан қызды аяп,
Dialogue: 0,1:18:14.81,1:18:17.06,Default,,0,0,0,,«Сені ол жерден шығарайық», - деді ол.
Dialogue: 0,1:18:17.19,1:18:20.73,Default,,0,0,0,,Маған біреу көк көзімен қараса...
Dialogue: 0,1:18:20.86,1:18:22.40,Default,,0,0,0,,Тамақтану кезінде
Dialogue: 0,1:18:22.53,1:18:24.03,Default,,0,0,0,,(Кобаяши) Ух...
Dialogue: 0,1:18:24.57,1:18:27.49,Default,,0,0,0,,Ерте түсінгеніңізге қуаныштымын.
Dialogue: 0,1:18:31.20,1:18:35.25,Default,,0,0,0,,Күріш жетпей қалды, мен кептірілген удонды ұсақтап, араластырдым.
Dialogue: 0,1:18:35.37,1:18:37.75,Default,,0,0,0,,«Ура но Сузу»
Dialogue: 0,1:18:37.87,1:18:38.75,Default,,0,0,0,,Иә? ‬
Dialogue: 0,1:18:38.88,1:18:40.25,Default,,0,0,0,,Бас тарту шарттары
Dialogue: 0,1:18:40.38,1:18:44.80,Default,,0,0,0,,Сузу Урано, Хиросимадағы балдырлар жасайтын отбасының қызы
Dialogue: 0,1:18:44.92,1:18:48.76,Default,,0,0,0,,Мен үрейленіп ойлап тапқан атын айттым.
Dialogue: 0,1:18:48.89,1:18:52.76,Default,,0,0,0,,Шынымды айтсам, қазір тіл табыса алмаймыз.
Dialogue: 0,1:18:52.89,1:18:57.27,Default,,0,0,0,,Махаббат барлық жерде, мүлдем...
Dialogue: 0,1:19:10.99,1:19:12.12,Default,,0,0,0,,№
Dialogue: 0,1:19:12.24,1:19:13.29,Default,,0,0,0,,(Шусаку) Иә? ‬
Dialogue: 0,1:19:44.57,1:19:47.19,Default,,0,0,0,,Сузу-сан, мүмкін
Dialogue: 0,1:19:49.53,1:19:51.99,Default,,0,0,0,,Балалы болмаймын деп уайымдайсыз ба? ‬
Dialogue: 0,1:19:52.12,1:19:53.91,Default,,0,0,0,,Бұл олай емес.
Dialogue: 0,1:19:57.08,1:20:00.00,Default,,0,0,0,,Ауыстырушылар туралы тым көп ойлау
Dialogue: 0,1:20:00.12,1:20:01.29,Default,,0,0,0,,Тек шаршадым
Dialogue: 0,1:20:05.67,1:20:07.80,Default,,0,0,0,,(Шусакудың жөтелі)
Dialogue: 0,1:20:07.92,1:20:09.59,Default,,0,0,0,,Мангалға не қойдыңыз? Гохогохо! ‬
Dialogue: 0,1:20:09.72,1:20:12.18,Default,,0,0,0,,No Тадон жапырақтары алмастырылған.
Dialogue: 0,1:20:12.30,1:20:14.30,Default,,0,0,0,,Мен оны көмірге айналдыра алмадым.
Dialogue: 0,1:20:14.43,1:20:15.51,Default,,0,0,0,,(терезенің ашылған дыбысы)
Dialogue: 0,1:20:15.64,1:20:19.02,Default,,0,0,0,,(Сузу мен Шусакудың жөтелі)
Dialogue: 0,1:20:20.77,1:20:23.98,Default,,0,0,0,,(бу ысқырығы)
Dialogue: 0,1:20:24.11,1:20:27.11,Default,,0,0,0,,(Солдат) Портқа кіруге дайындалуда Баяу алға жылдамдық Қызыл‎20
Dialogue: 0,1:20:27.23,1:20:31.03,Default,,0,0,0,,Яв Солоу Баяу алға Қызыл 20 Иу Солоу
Dialogue: 0,1:20:35.33,1:20:37.29,Default,,0,0,0,,Қаласаң, сұра.
Dialogue: 0,1:20:37.41,1:20:38.37,Default,,0,0,0,,(Философия)
Dialogue: 0,1:20:39.41,1:20:40.41,Default,,0,0,0,,(Харуми) Иә? Ах
Dialogue: 0,1:20:41.04,1:20:43.83,Default,,0,0,0,,(Харуми) Уау! Нағыз теңізші
Dialogue: 0,1:20:45.38,1:20:48.59,Default,,0,0,0,,Біз құдық басында бір-бірімізге тап болдық.
Dialogue: 0,1:20:48.71,1:20:52.51,Default,,0,0,0,,Сатоси Мизухара, Аоба әскери кемесінің экипаж мүшесі
Dialogue: 0,1:20:52.63,1:20:55.55,Default,,0,0,0,,(Харуми) Аоба Утару - Комецу (Тецу) О!
Dialogue: 0,1:20:55.68,1:20:58.10,Default,,0,0,0,,(Кейко) Бұл Харуми (Тетсу) Хахаха...
Dialogue: 0,1:20:59.89,1:21:03.35,Default,,0,0,0,,Уау, қыс болды, мен әбден тотықтым.
Dialogue: 0,1:21:03.48,1:21:07.15,Default,,0,0,0,,Әй, сен менің үйіме шомылуға келдің бе?
Dialogue: 0,1:21:07.27,1:21:10.53,Default,,0,0,0,,(Тэцу) А, бұл шомылу қонуы деп аталатын бос уақыт.
Dialogue: 0,1:21:10.65,1:21:15.99,Default,,0,0,0,,Баратын жеріне келсек, менің туған жерім Сузудан маған қонаққа баруын өтіндім.
Dialogue: 0,1:21:16.12,1:21:19.08,Default,,0,0,0,,Сузу бәріңе қамқор болады.
Dialogue: 0,1:21:19.70,1:21:23.71,Default,,0,0,0,,Қалай әрқашан сурет салуға әуес болған.
Dialogue: 0,1:21:23.83,1:21:26.42,Default,,0,0,0,,Бұл жай ғана бұлыңғыр.
Dialogue: 0,1:21:26.54,1:21:30.88,Default,,0,0,0,,Жарайды, ойланбасаң, мен сені үйге апарамын.
Dialogue: 0,1:21:31.01,1:21:33.13,Default,,0,0,0,,Хахаха... Уф! ‬
Dialogue: 0,1:21:33.26,1:21:34.63,Default,,0,0,0,,(Харуми) Иә? ‬
Dialogue: 0,1:21:35.30,1:21:37.05,Default,,0,0,0,,Қиын болса да
Dialogue: 0,1:21:37.18,1:21:39.72,Default,,0,0,0,,«Suzu Suzu» лақтырылатын сөз сияқты.
Dialogue: 0,1:21:39.85,1:21:42.56,Default,,0,0,0,,Иә? Сонымен, мен оны қалай атауға болады?
Dialogue: 0,1:21:42.68,1:21:44.14,Default,,0,0,0,,Бұл енді Урано емес шығар.
Dialogue: 0,1:21:44.27,1:21:45.65,Default,,0,0,0,,А...
Dialogue: 0,1:21:45.77,1:21:48.57,Default,,0,0,0,,Сузу-сан, теңізшілермен зорлық-зомбылық жасама...
Dialogue: 0,1:21:48.69,1:21:49.65,Default,,0,0,0,,Уф
Dialogue: 0,1:21:49.77,1:21:53.15,Default,,0,0,0,,(күлді)
Dialogue: 0,1:21:53.74,1:21:56.16,Default,,0,0,0,,(күлді)
Dialogue: 0,1:21:56.28,1:21:58.28,Default,,0,0,0,,(күлді)
Dialogue: 0,1:21:58.41,1:21:59.91,Default,,0,0,0,,Қызықты нәрсе бар ма?
Dialogue: 0,1:22:00.04,1:22:03.16,Default,,0,0,0,,Бұл күлкілі, сіз шынымен қалыптысыз.
Dialogue: 0,1:22:03.87,1:22:05.75,Default,,0,0,0,,Дәмді Иә Дәмді
Dialogue: 0,1:22:05.87,1:22:07.17,Default,,0,0,0,,Нашар картоп
Dialogue: 0,1:22:07.29,1:22:09.54,Default,,0,0,0,,Жұмақ Жұмақ
Dialogue: 0,1:22:09.67,1:22:11.96,Default,,0,0,0,,Эй, қаңылтырды сал.
Dialogue: 0,1:22:12.09,1:22:12.67,Default,,0,0,0,,Сіз ақымақсыз ба? ‬
Dialogue: 0,1:22:12.67,1:22:13.42,Default,,0,0,0,,Сен ақымақсың ба? ‬
Dialogue: 0,1:22:12.67,1:22:13.42,Default,,0,0,0,,(Тетсудың ән айту дауысы)
Dialogue: 0,1:22:13.42,1:22:13.55,Default,,0,0,0,,(Тетсудың ән айту дауысы)
Dialogue: 0,1:22:13.55,1:22:15.76,Default,,0,0,0,,(Тетсудың ән айту дауысы)
Dialogue: 0,1:22:13.55,1:22:15.76,Default,,0,0,0,,Сузу-сан, шам қайда?
Dialogue: 0,1:22:15.88,1:22:18.76,Default,,0,0,0,,А, мен окопта екеніне сенімдімін.
Dialogue: 0,1:22:18.89,1:22:19.80,Default,,0,0,0,,Хоука
Dialogue: 0,1:22:20.81,1:22:23.68,Default,,0,0,0,,Болашақта Харуми де теңізші болады.
Dialogue: 0,1:22:23.81,1:22:26.23,Default,,0,0,0,,О, дұрыс.
Dialogue: 0,1:22:26.35,1:22:27.15,Default,,0,0,0,,Иә
Dialogue: 0,1:22:27.27,1:22:28.69,Default,,0,0,0,,Итадакимасу
Dialogue: 0,1:22:28.81,1:22:30.02,Default,,0,0,0,,(Қиязи) Сәлемдесуіңіз қандай? ‬
Dialogue: 0,1:22:30.15,1:22:31.32,Default,,0,0,0,,(Харуми) Қайырлы түн.
Dialogue: 0,1:22:31.44,1:22:33.69,Default,,0,0,0,,(Тэцу) Хехе, қайырлы түн.
Dialogue: 0,1:22:34.61,1:22:37.61,Default,,0,0,0,,А, жер жақсы екен.
Dialogue: 0,1:22:37.74,1:22:40.16,Default,,0,0,0,,Ходжа Учиха
Dialogue: 0,1:22:40.28,1:22:42.99,Default,,0,0,0,,Жасыл жапырақтар қандай?
Dialogue: 0,1:22:43.12,1:22:45.91,Default,,0,0,0,,Мен Манилада жарақат алып, жаңа ғана оралдым.
Dialogue: 0,1:22:46.79,1:22:51.54,Default,,0,0,0,,Иә, бұл кеме болды, бірақ ол тағы да жақсы жұмыс істемеді немесе батып кетті.
Dialogue: 0,1:22:53.25,1:22:54.92,Default,,0,0,0,,Шусаку Ноу
Dialogue: 0,1:22:55.05,1:22:59.09,Default,,0,0,0,,Өлімге кешігіп келу қынжылтады.
Dialogue: 0,1:23:00.72,1:23:02.06,Default,,0,0,0,,Мизухара мырза
Dialogue: 0,1:23:02.18,1:23:06.14,Default,,0,0,0,,Әкем түнгі ауысымға қайта келмейді, сондықтан мен бүгін кешке үй басшысымын.
Dialogue: 0,1:23:06.81,1:23:10.27,Default,,0,0,0,,Кешіріңіз, бірақ мен сізді осында қалдыра алмаймын.
Dialogue: 0,1:23:13.44,1:23:15.69,Default,,0,0,0,,Иә? Осында? ‬
Dialogue: 0,1:23:15.82,1:23:18.32,Default,,0,0,0,,Мен қораның екінші қабатында ұйықтап жатқанмын.
Dialogue: 0,1:23:18.45,1:23:20.37,Default,,0,0,0,,Жоқ, бұл сирек болатын.
Dialogue: 0,1:23:20.49,1:23:23.28,Default,,0,0,0,,Тіпті сен кейде өрескелсің.
Dialogue: 0,1:23:23.41,1:23:24.54,Default,,0,0,0,,Хаа
Dialogue: 0,1:23:24.66,1:23:28.21,Default,,0,0,0,,Әй, зәкірді киіп ал, мен оны өзіңмен бірге алып кетемін.
Dialogue: 0,1:23:28.33,1:23:31.96,Default,,0,0,0,,Жүр, жай сөйлесейік. Мен сені тағы көремін бе деп ойлаймын.
Dialogue: 0,1:23:47.35,1:23:49.27,Default,,0,0,0,,Мұнда келгенім үшін кешіріңіз.
Dialogue: 0,1:23:49.39,1:23:53.27,Default,,0,0,0,,Хаха... Аспалы еденмен салыстырғанда бұл жұмақ.
Dialogue: 0,1:23:53.40,1:23:57.32,Default,,0,0,0,,Қараңдаршы, үймелеу туралы айтсаң, суық. Аяғыңызды салыңыз.
Dialogue: 0,1:23:57.44,1:23:58.24,Default,,0,0,0,,Иә
Dialogue: 0,1:24:02.16,1:24:04.37,Default,,0,0,0,,Қараңдаршы, бұл кәдесый.
Dialogue: 0,1:24:04.49,1:24:05.58,Default,,0,0,0,,Иә
Dialogue: 0,1:24:08.58,1:24:10.46,Default,,0,0,0,,(Тэцу) Сіз қаламсапта өмір сүргіңіз келе ме? Иә.
Dialogue: 0,1:24:12.29,1:24:13.46,Default,,0,0,0,,(Философия) Жақсы.
Dialogue: 0,1:24:21.22,1:24:23.26,Default,,0,0,0,,Уау, жаза аламын, жаза аламын (Философия) Жаза аламын.
Dialogue: 0,1:24:24.10,1:24:26.72,Default,,0,0,0,,Қарақұтанға ұқсайды, бірақ мен оны кездестірдім.
Dialogue: 0,1:24:26.85,1:24:28.81,Default,,0,0,0,,Джаттакеену Оңтүстік теңізі
Dialogue: 0,1:24:28.93,1:24:31.44,Default,,0,0,0,,Құтандар теңізден өте ме?
Dialogue: 0,1:24:31.56,1:24:34.23,Default,,0,0,0,,(Тетсу) Ноу Эба жыл бойы⸺
Dialogue: 0,1:24:34.36,1:24:36.48,Default,,0,0,0,,Маған өзен жағасында тұру ғана қалды.
Dialogue: 0,1:24:37.28,1:24:40.45,Default,,0,0,0,,Ах, Энами, сен жақсы болдың.
Dialogue: 0,1:24:40.57,1:24:44.62,Default,,0,0,0,,А... Мен оны өзім қалағандай тарта алмайтын сияқтымын.
Dialogue: 0,1:24:45.20,1:24:47.33,Default,,0,0,0,,Сізде де осындай кездер бола ма?
Dialogue: 0,1:24:48.41,1:24:52.12,Default,,0,0,0,,Мүмкін біраз уақыт өткен шығар? Сурет - бұл
Dialogue: 0,1:24:52.25,1:24:53.21,Default,,0,0,0,,Жақсы
Dialogue: 0,1:24:54.96,1:24:58.92,Default,,0,0,0,,Сол сурет, толқындағы қоян
Dialogue: 0,1:24:59.05,1:25:00.63,Default,,0,0,0,,О, бұл
Dialogue: 0,1:25:01.51,1:25:04.14,Default,,0,0,0,,Одан кейін қиын болды.
Dialogue: 0,1:25:04.26,1:25:06.81,Default,,0,0,0,,Не? Солай ма? ‬
Dialogue: 0,1:25:06.93,1:25:09.06,Default,,0,0,0,,(Философия) Сіз ұмыттыңыз ба? иә? ‬
Dialogue: 0,1:25:09.18,1:25:12.98,Default,,0,0,0,,Менің мұғалімім бұл суретті Хиросимадағы байқауға жіберді.
Dialogue: 0,1:25:13.10,1:25:17.98,Default,,0,0,0,,Мен ол жерде ең жақсы беделге ие болдым, бұл мені қатты алаңдатты.
Dialogue: 0,1:25:18.61,1:25:21.65,Default,,0,0,0,,Мен не салдым
Dialogue: 0,1:25:21.78,1:25:24.82,Default,,0,0,0,,Нағыз несие сізге беріледі.
Dialogue: 0,1:25:24.95,1:25:26.07,Default,,0,0,0,,Хэхе...
Dialogue: 0,1:25:26.70,1:25:27.49,Default,,0,0,0,,Ха…
Dialogue: 0,1:25:34.12,1:25:36.63,Default,,0,0,0,,Сузу жылы
Dialogue: 0,1:25:36.75,1:25:38.80,Default,,0,0,0,,Қалайы жұмсақ
Dialogue: 0,1:25:38.92,1:25:40.09,Default,,0,0,0,,Тәтті мұрын
Dialogue: 0,1:25:43.88,1:25:44.84,Default,,0,0,0,,Мизухара мырза
Dialogue: 0,1:25:46.93,1:25:50.31,Default,,0,0,0,,Мен осындай күнді көптен күткен сияқтымын.
Dialogue: 0,1:25:51.27,1:25:53.81,Default,,0,0,0,,Сен осылай келдің
Dialogue: 0,1:25:54.52,1:25:57.02,Default,,0,0,0,,Осылай жанымда болсаң да
Dialogue: 0,1:25:57.15,1:25:58.23,Default,,0,0,0,,Біз...
Dialogue: 0,1:25:58.36,1:25:59.32,Default,,0,0,0,,Ах! ‬
Dialogue: 0,1:25:59.98,1:26:04.11,Default,,0,0,0,,Шынымды айтсам, саған ренжімей тұра алмаймын.
Dialogue: 0,1:26:04.65,1:26:07.91,Default,,0,0,0,,Кешіріңіз, шынымен кешіріңіз
Dialogue: 0,1:26:08.78,1:26:12.75,Default,,0,0,0,,(Тэцу) Сізге ол адам ұнайды.
Dialogue: 0,1:26:12.87,1:26:13.79,Default,,0,0,0,,Иә
Dialogue: 0,1:26:14.66,1:26:18.13,Default,,0,0,0,,Бұл қалыпты жағдай
Dialogue: 0,1:26:18.25,1:26:19.04,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:26:19.17,1:26:22.01,Default,,0,0,0,,(Тэцу) Бұл анық нәрсеге ашуланған сияқты.
Dialogue: 0,1:26:22.13,1:26:24.30,Default,,0,0,0,,Белгілі себептермен кешірім сұрау
Dialogue: 0,1:26:25.13,1:26:27.55,Default,,0,0,0,,Мені үйге апара алмайтыныңызға сенімдісіз бе?
Dialogue: 0,1:26:27.68,1:26:30.56,Default,,0,0,0,,Саған еріксіз үйлендім деп қиналғаным дұрыс емес пе?
Dialogue: 0,1:26:30.68,1:26:31.93,Default,,0,0,0,,Жоқ
Dialogue: 0,1:26:32.47,1:26:34.56,Default,,0,0,0,,Сонда иә хаха...\NЖоғарыдағы
Dialogue: 0,1:26:36.10,1:26:38.44,Default,,0,0,0,,4-сынып
Dialogue: 0,1:26:38.56,1:26:39.94,Default,,0,0,0,,Шусаку мырза? ‬
Dialogue: 0,1:26:40.06,1:26:42.44,Default,,0,0,0,,(Тэцу) Ол менің қайтыс болған ағаммен құрдас.
Dialogue: 0,1:26:43.61,1:26:45.28,Default,,0,0,0,,Біз кедей едік.
Dialogue: 0,1:26:45.40,1:26:48.99,Default,,0,0,0,,Менің ағам Әскери-теңіз академиясына тегін түсті.
Dialogue: 0,1:26:49.12,1:26:52.16,Default,,0,0,0,,Менің ағам жаңа ғана қайтыс болды. Мен флотқа қосылдым.
Dialogue: 0,1:26:52.99,1:26:55.08,Default,,0,0,0,,Мұның бәрі қалыпты.
Dialogue: 0,1:26:55.21,1:26:59.71,Default,,0,0,0,,Адамдарға тән нормадан қай жерде қалып қойдым деп ойлаймын.
Dialogue: 0,1:27:00.67,1:27:05.76,Default,,0,0,0,,Джейки Сузудың мұнда қалыпты екенін көргенде мен жеңілдеп қалдым.
Dialogue: 0,1:27:05.88,1:27:09.14,Default,,0,0,0,,Мені батырлық рух деп атағым келмейді.
Dialogue: 0,1:27:09.26,1:27:12.64,Default,,0,0,0,,Мені еске алсаң, күліп еске ал.
Dialogue: 0,1:27:13.56,1:27:19.94,Default,,0,0,0,,Осы дүниеде соңына дейін қалыпты және әдепті болып қалыңыз.
Dialogue: 0,1:27:20.06,1:27:21.36,Default,,0,0,0,,(Тетсу) Сузу Иә? ‬
Dialogue: 0,1:27:21.48,1:27:23.27,Default,,0,0,0,,Бәрің дайынсыңдар
Dialogue: 0,1:27:23.82,1:27:25.15,Default,,0,0,0,,Сіз ақымақсыз ба?
Dialogue: 0,1:27:25.28,1:27:27.65,Default,,0,0,0,,Ахах... хаха...
Dialogue: 0,1:27:27.78,1:27:31.53,Default,,0,0,0,,Мен сені басынан бері білемін.
Dialogue: 0,1:27:31.66,1:27:34.87,Default,,0,0,0,,Маңызды нәрселерді айта алмайтын әдетім бар.
Dialogue: 0,1:27:35.75,1:27:40.12,Default,,0,0,0,,(Монах) Қазірдің өзінде мен адам денесін алдым...
Dialogue: 0,1:27:43.67,1:27:44.63,Default,,0,0,0,,Ха...
Dialogue: 0,1:27:45.80,1:27:47.67,Default,,0,0,0,,(Барлығы) Они-чанға қош келдіңіз
Dialogue: 0,1:27:48.30,1:27:52.51,Default,,0,0,0,,Дегенмен, сүйекті алмастыратын жалғыз тас дегеніміз не?
Dialogue: 0,1:27:52.64,1:27:54.47,Default,,0,0,0,,Суми-чан өте кішкентай...
Dialogue: 0,1:27:54.60,1:27:57.60,Default,,0,0,0,,Онии-чанның миы? ‬
Dialogue: 0,1:27:57.73,1:27:59.85,Default,,0,0,0,,Мен жаңа ғана қате айттым...
Dialogue: 0,1:27:59.98,1:28:01.60,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,1:28:02.65,1:28:05.40,Default,,0,0,0,,Суықта шақыру ақымақ сияқты
Dialogue: 0,1:28:05.53,1:28:08.11,Default,,0,0,0,,Қызық, әлгі Йоичи оңай өледі ме?
Dialogue: 0,1:28:09.32,1:28:12.07,Default,,0,0,0,,Кенет адамдар жоғалып кетеді.
Dialogue: 0,1:28:12.20,1:28:17.12,Default,,0,0,0,,Мені енді көре алмасаң, сөзім саған жетпейді.
Dialogue: 0,1:28:18.96,1:28:20.12,Default,,0,0,0,,Шусаку-сан
Dialogue: 0,1:28:21.54,1:28:24.88,Default,,0,0,0,,Өткен күн үшін көп рахмет.
Dialogue: 0,1:28:25.00,1:28:26.09,Default,,0,0,0,,Иә? ‬
Dialogue: 0,1:28:26.21,1:28:29.80,Default,,0,0,0,,Мизухара-санмен сөйлесуге уақытым таусылып жатыр.
Dialogue: 0,1:28:30.76,1:28:31.72,Default,,0,0,0,,Жоқ...
Dialogue: 0,1:28:32.43,1:28:35.64,Default,,0,0,0,,Шусаку Хойде, ерлі-зайыптылар осындай ма?
Dialogue: 0,1:28:38.06,1:28:41.48,Default,,0,0,0,,Мен мұны істей алмаймын десем де, әйеліңіздің келуін сұраңыз.
Dialogue: 0,1:28:43.27,1:28:47.03,Default,,0,0,0,,Маған көрсетпесең де ашулы жүзің бар.
Dialogue: 0,1:28:47.15,1:28:49.86,Default,,0,0,0,,Жарайды... Енді көретіндеріңізге сенімдімін.
Dialogue: 0,1:28:49.99,1:28:51.74,Default,,0,0,0,,(тежегіш дыбысы)
Dialogue: 0,1:28:51.86,1:28:54.41,Default,,0,0,0,,Ой, мен сенің ашуланатыныңды білмедім.
Dialogue: 0,1:28:54.53,1:28:56.87,Default,,0,0,0,,Бұл алаңдаушылық! ‬
Dialogue: 0,1:28:56.99,1:28:58.12,Default,,0,0,0,,(Шусаку) Хо~
Dialogue: 0,1:28:59.79,1:29:03.46,Default,,0,0,0,,Әй, бүгін ғана, қарлығаш шұлықтарыңды алып кетесің бе?
Dialogue: 0,1:29:03.58,1:29:06.84,Default,,0,0,0,,Сузу-сан өзі жөндеп жатқан утанға аяғын сала алмай қалды.
Dialogue: 0,1:29:06.96,1:29:08.50,Default,,0,0,0,,Басқалар болуы мүмкін.
Dialogue: 0,1:29:08.63,1:29:12.30,Default,,0,0,0,,(Ер адам) Енді екеуің төбелесесіңдер ме? ‬
Dialogue: 0,1:29:13.76,1:29:16.14,Default,,0,0,0,,(Шусаку) Мен тағы да дұрыс емес жолмен келе жатырмын, сондықтан осы жолмен жүр! ‬
Dialogue: 0,1:29:16.26,1:29:18.01,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,1:29:18.14,1:29:21.43,Default,,0,0,0,,(Шусаку) Біз сол жақта, Хайгамин бағытындамыз.
Dialogue: 0,1:29:21.56,1:29:23.19,Default,,0,0,0,,Түсіндім! ‬
Dialogue: 0,1:29:23.31,1:29:24.98,Default,,0,0,0,,(қол соғу дыбысы)
Dialogue: 0,1:29:25.10,1:29:28.02,Default,,0,0,0,,(Балалар) Өртке қарсы сақтық шаралары
Dialogue: 0,1:29:29.11,1:29:34.41,Default,,0,0,0,,(Балалар) Америка Құрама Штаттары мен Ұлыбританияның жойылуы: Өрттен сақтаныңыз
Dialogue: 0,1:29:37.45,1:29:39.20,Default,,0,0,0,,Үш күннен кейін
Dialogue: 0,1:29:47.21,1:29:49.46,Default,,0,0,0,,Уа... ау! ‬
Dialogue: 0,1:29:52.22,1:29:53.17,Default,,0,0,0,,(Әйел) Мен білмеймін! ‬
Dialogue: 0,1:29:53.30,1:29:55.51,Default,,0,0,0,,Жалқау бала мұнда жоқ.
Dialogue: 0,1:30:00.10,1:30:01.31,Default,,0,0,0,,А...
Dialogue: 0,1:30:11.94,1:30:13.07,Default,,0,0,0,,Үлкен апа
Dialogue: 0,1:30:13.19,1:30:14.11,Default,,0,0,0,,Иә? ‬
Dialogue: 0,1:30:16.11,1:30:19.24,Default,,0,0,0,,Біз де бизнеспен айналысамыз, мені кешіріңіз.
Dialogue: 0,1:30:19.37,1:30:20.45,Default,,0,0,0,,(жөтел)
Dialogue: 0,1:30:20.58,1:30:22.29,Default,,0,0,0,,... Иә? ‬
Dialogue: 0,1:30:22.87,1:30:24.91,Default,,0,0,0,,Сіз мұнда маған шабуыл жасау үшін келдіңіз, солай ма? ‬
Dialogue: 0,1:30:25.46,1:30:26.83,Default,,0,0,0,,Жоқ
Dialogue: 0,1:30:28.88,1:30:30.34,Default,,0,0,0,,Ах, мм.
Dialogue: 0,1:30:37.39,1:30:38.72,Default,,0,0,0,,Мм...
Dialogue: 0,1:30:38.85,1:30:42.97,Default,,0,0,0,,Бұл Рин Уча Ширакиге арналған.
Dialogue: 0,1:30:44.23,1:30:48.73,Default,,0,0,0,,(жөтел)
Dialogue: 0,1:30:57.53,1:30:59.87,Default,,0,0,0,,Қарды бірден алып шықтым.
Dialogue: 0,1:31:01.83,1:31:03.33,Default,,0,0,0,,Рахмет
Dialogue: 0,1:31:04.95,1:31:06.66,Default,,0,0,0,,Өте суық
Dialogue: 0,1:31:12.00,1:31:13.38,Default,,0,0,0,,Оишикаа
Dialogue: 0,1:31:13.92,1:31:18.05,Default,,0,0,0,,Мен Рин Ширакиді көруге келдім.
Dialogue: 0,1:31:18.18,1:31:19.59,Default,,0,0,0,,О
Dialogue: 0,1:31:19.72,1:31:23.85,Default,,0,0,0,,Егер сіз Рин-Чан болсаңыз, түні бойы офицердің соңынан еруіңізге болады.
Dialogue: 0,1:31:25.39,1:31:26.48,Default,,0,0,0,,Ах...
Dialogue: 0,1:31:30.10,1:31:34.32,Default,,0,0,0,,Эй, маған мына шайды бере аласың ба?
Dialogue: 0,1:31:35.94,1:31:38.20,Default,,0,0,0,,(жөтел)
Dialogue: 0,1:31:38.32,1:31:40.28,Default,,0,0,0,,Сәттілік
Dialogue: 0,1:31:40.82,1:31:43.62,Default,,0,0,0,,Әдемі шай ыдысы хехехе
Dialogue: 0,1:31:43.74,1:31:44.70,Default,,0,0,0,,Ах
Dialogue: 0,1:31:45.29,1:31:46.29,Default,,0,0,0,,Қол…
Dialogue: 0,1:31:46.91,1:31:49.67,Default,,0,0,0,,Бұл үлкен мәселе емес.
Dialogue: 0,1:31:49.79,1:31:54.50,Default,,0,0,0,,Мен сені жас теңізші байлап, Сақай өзеніне секіруіңді қалаймын.
Dialogue: 0,1:31:54.63,1:31:55.59,Default,,0,0,0,,Иә?
Dialogue: 0,1:31:55.71,1:32:00.18,Default,,0,0,0,,Суықтан аулақ болған дұрыс, өйткені одан суық тиюге болады.
Dialogue: 0,1:32:00.80,1:32:02.64,Default,,0,0,0,,Жоқ, жақсы.
Dialogue: 0,1:32:03.35,1:32:04.47,Default,,0,0,0,,Осыдан
Dialogue: 0,1:32:06.43,1:32:08.02,Default,,0,0,0,,Өте суық
Dialogue: 0,1:32:08.68,1:32:10.94,Default,,0,0,0,,Басқа адам кім? ‬
Dialogue: 0,1:32:11.94,1:32:15.19,Default,,0,0,0,,Менің Қомай өзенінде өлуім мүмкін емес.
Dialogue: 0,1:32:15.73,1:32:17.11,Default,,0,0,0,,Бір-біріңді ұнатасыңдар ма?
Dialogue: 0,1:32:17.24,1:32:18.03,Default,,0,0,0,,Ал...
Dialogue: 0,1:32:18.90,1:32:20.28,Default,,0,0,0,,Маған ұнайды, маған ұнайды
Dialogue: 0,1:32:20.91,1:32:23.70,Default,,0,0,0,,Мен бейтаныс болғым келеді. Мен бейтаныс болғым келеді.
Dialogue: 0,1:32:23.82,1:32:26.08,Default,,0,0,0,,Осы уақытта кеме қайтып келді.
Dialogue: 0,1:32:26.20,1:32:28.45,Default,,0,0,0,,Өте гүлденген жер екен
Dialogue: 0,1:32:29.16,1:32:30.29,Default,,0,0,0,,Тек…
Dialogue: 0,1:32:31.00,1:32:34.42,Default,,0,0,0,,Мен кептеліп қалғаныма өкінемін.
Dialogue: 0,1:32:37.42,1:32:40.68,Default,,0,0,0,,Өзен де жаз болса, оны қорғау жақсы.
Dialogue: 0,1:32:40.80,1:32:42.18,Default,,0,0,0,,(жөтел)
Dialogue: 0,1:32:42.80,1:32:46.22,Default,,0,0,0,,Тек қысты ұнатпаймын.
Dialogue: 0,1:32:46.35,1:32:50.89,Default,,0,0,0,,Жылы оңтүстік жерлерге өткен дұрыс болар еді.
Dialogue: 0,1:32:56.23,1:32:57.32,Default,,0,0,0,,Ах! ‬
Dialogue: 0,1:32:58.40,1:33:00.11,Default,,0,0,0,,Согендік сезім
Dialogue: 0,1:33:03.66,1:33:05.03,Default,,0,0,0,,Я~
Dialogue: 0,1:33:05.16,1:33:07.91,Default,,0,0,0,,Оңтүстік арал жақсы ма?
Dialogue: 0,1:33:10.16,1:33:12.25,Default,,0,0,0,,Жарайсың ба?
Dialogue: 0,1:33:15.71,1:33:17.84,Default,,0,0,0,,Суық.
Dialogue: 0,1:33:19.09,1:33:21.09,Default,,0,0,0,,Жылы екен, хехехе
Dialogue: 0,1:33:22.63,1:33:26.05,Default,,0,0,0,,Жарайды, мен түнде суық дәрігерге көрінемін.
Dialogue: 0,1:33:26.18,1:33:27.56,Default,,0,0,0,,(жөтел)
Dialogue: 0,1:33:27.68,1:33:31.14,Default,,0,0,0,,Күн суытып барады, қазір жабамын.
Dialogue: 0,1:33:31.27,1:33:32.77,Default,,0,0,0,,(жөтел)
Dialogue: 0,1:33:32.89,1:33:34.35,Default,,0,0,0,,Хехе
Dialogue: 0,1:33:45.87,1:33:47.07,Default,,0,0,0,,Учиха
Dialogue: 0,1:33:47.74,1:33:49.45,Default,,0,0,0,,Мен әлі де ащымын
Dialogue: 0,1:34:04.97,1:34:06.97,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:34:07.09,1:34:10.39,Default,,0,0,0,,Бұлай зеңбіректердің дыбысы енді мені қорқытпайды.
Dialogue: 0,1:34:10.51,1:34:12.43,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:34:12.60,1:34:13.56,Default,,0,0,0,,Шусаку-сан
Dialogue: 0,1:34:14.39,1:34:18.19,Default,,0,0,0,,Мен Рин-санмен ешбір жағдайда бәсекелесе алмайтын сияқтымын.
Dialogue: 0,1:34:21.28,1:34:25.07,Default,,0,0,0,,(Сузу/Харуми) ♪ «Аспандағы құдай сарбазы»
Dialogue: 0,1:34:41.75,1:34:44.47,Default,,0,0,0,,‪～♪‬
Dialogue: 0,1:34:45.01,1:34:47.05,Default,,0,0,0,,Аха, не болды?
Dialogue: 0,1:34:47.18,1:34:51.51,Default,,0,0,0,,Харуми-сан, тыныш болшы. Мұғалім де саған ұрысып жатқан жоқ.
Dialogue: 0,1:34:51.64,1:34:54.81,Default,,0,0,0,,Шынымен бе? Мектептен қорықпайсың ба? ‬
Dialogue: 0,1:34:54.93,1:34:57.69,Default,,0,0,0,,Иә, қазір достарым болмаса да.
Dialogue: 0,1:34:57.81,1:35:01.44,Default,,0,0,0,,Қараңдаршы, біз мұнда келгенде жалғыз қалдық.
Dialogue: 0,1:35:01.57,1:35:04.53,Default,,0,0,0,,Барлығы бірден тіл табысып кетті.
Dialogue: 0,1:35:04.65,1:35:05.65,Default,,0,0,0,,Менің анам да? ‬
Dialogue: 0,1:35:05.65,1:35:06.40,Default,,0,0,0,,Менің анам да? ‬
Dialogue: 0,1:35:05.65,1:35:06.40,Default,,0,0,0,,(Труба дыбысы)
Dialogue: 0,1:35:06.40,1:35:06.53,Default,,0,0,0,,(Труба дыбысы)
Dialogue: 0,1:35:06.53,1:35:09.24,Default,,0,0,0,,(Труба дыбысы)
Dialogue: 0,1:35:06.53,1:35:09.24,Default,,0,0,0,,Ах... у...
Dialogue: 0,1:35:09.24,1:35:10.07,Default,,0,0,0,,(Труба дыбысы)
Dialogue: 0,1:35:12.41,1:35:13.20,Default,,0,0,0,,Иә? ‬
Dialogue: 0,1:35:13.33,1:35:18.08,Default,,0,0,0,,(Труба дыбысы)
Dialogue: 0,1:35:19.08,1:35:23.34,Default,,0,0,0,,(жалғасы керней дыбысы)
Dialogue: 0,1:35:34.18,1:35:39.60,Default,,0,0,0,,(Соғыс ұшағы дыбысы)
Dialogue: 0,1:35:39.73,1:35:41.81,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:35:41.81,1:35:42.77,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:35:41.81,1:35:42.77,Default,,0,0,0,,Не!
Dialogue: 0,1:35:45.48,1:35:46.32,Default,,0,0,0,,(Харуми) Ах.
Dialogue: 0,1:35:47.28,1:35:48.70,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:35:49.95,1:35:50.95,Default,,0,0,0,,Ах! ‬
Dialogue: 0,1:35:57.29,1:35:59.58,Default,,0,0,0,,А, әуе шабуылы капоты
Dialogue: 0,1:36:00.33,1:36:02.13,Default,,0,0,0,,(Харуми) Ух... Харуми-чан
Dialogue: 0,1:36:04.42,1:36:06.01,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:36:14.51,1:36:18.02,Default,,0,0,0,,(Харуми) Уау... Уау...
Dialogue: 0,1:36:23.23,1:36:24.40,Default,,0,0,0,,Ах...
Dialogue: 0,1:36:25.23,1:36:28.32,Default,,0,0,0,,Егер менде қазір бояу болса
Dialogue: 0,1:36:29.07,1:36:32.91,Default,,0,0,0,,...Біз тіпті не туралы ойлап жатырмыз?
Dialogue: 0,1:36:33.87,1:36:34.91,Default,,0,0,0,,(Энтаро) Сәлем! ‬
Dialogue: 0,1:36:35.41,1:36:36.70,Default,,0,0,0,,Сіз не істеп жатырсыз? ‬
Dialogue: 0,1:36:36.83,1:36:39.08,Default,,0,0,0,,Көлеңкеге түс, тез жат.
Dialogue: 0,1:36:39.21,1:36:40.33,Default,,0,0,0,,(Дабыл)
Dialogue: 0,1:36:40.46,1:36:41.87,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,1:36:43.83,1:36:47.71,Default,,0,0,0,,Эй, қазір әуе шабуылы туралы ескерту бар.
Dialogue: 0,1:36:47.84,1:36:50.80,Default,,0,0,0,,Тыныш қалмаңыз, сізге снаряд сынықтары түседі.
Dialogue: 0,1:37:04.90,1:37:05.86,Default,,0,0,0,,(Entaro) Atta! ‬
Dialogue: 0,1:37:05.98,1:37:08.86,Default,,0,0,0,,(Ұшу дыбысы)
Dialogue: 0,1:37:08.98,1:37:12.11,Default,,0,0,0,,(Entaro) Қоңырау соғып жатыр ма? ‬
Dialogue: 0,1:37:12.24,1:37:15.78,Default,,0,0,0,,Біздің 2000 ат күшіміз қатты дыбыс шығарады.
Dialogue: 0,1:37:16.41,1:37:19.25,Default,,0,0,0,,Күндіз-түні зауыттарда жұмыс істейміз.
Dialogue: 0,1:37:19.37,1:37:22.33,Default,,0,0,0,,Оны табысқа айналдырайық, тек оны аяқтау үшін.
Dialogue: 0,1:37:22.46,1:37:23.58,Default,,0,0,0,,Ха...
Dialogue: 0,1:37:24.33,1:37:28.92,Default,,0,0,0,,91 500 ат күші түрінен бастап, біз осы уақытқа дейін жеттік.
Dialogue: 0,1:37:30.88,1:37:36.30,Default,,0,0,0,,♪ Жұмыс істеп жатқан дағдыға жабысып қалу
Dialogue: 0,1:37:37.30,1:37:41.18,Default,,0,0,0,,♪ Дүние жүзіндегі бейбітшілік нұры
Dialogue: 0,1:37:43.73,1:37:47.06,Default,,0,0,0,,♪ Бар күшіңізбен шоғырланыңыз
Dialogue: 0,1:37:47.19,1:37:50.40,Default,,0,0,0,,(Харуми) Әй, жаудың қанша ат күші бар? ‬
Dialogue: 0,1:37:52.15,1:37:54.36,Default,,0,0,0,,Әй, жаудың қанша ат күші бар... (құлап кеткен дыбыс)
Dialogue: 0,1:37:55.49,1:37:56.87,Default,,0,0,0,,Қайын ата!?
Dialogue: 0,1:37:56.99,1:37:59.41,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:38:01.20,1:38:05.33,Default,,0,0,0,,(Ерлер) Әуе шабуылы туралы ескерту жойылды
Dialogue: 0,1:38:05.46,1:38:08.50,Default,,0,0,0,,(Судзу мен Харумидің жылауы)
Dialogue: 0,1:38:08.63,1:38:11.34,Default,,0,0,0,,Дұрыс, түнгі ауысым аяқталды. Бұл сондай көңілді.
Dialogue: 0,1:38:11.46,1:38:15.59,Default,,0,0,0,,Әуе шабуылы кезінде сіз жерде тыныш ұйықтадыңыз...
Dialogue: 0,1:38:15.72,1:38:16.97,Default,,0,0,0,,Өте орынды
Dialogue: 0,1:38:17.09,1:38:18.89,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,1:38:19.01,1:38:21.85,Default,,0,0,0,,Сол күні Күреден балық ауланады.
Dialogue: 0,1:38:21.97,1:38:23.48,Default,,0,0,0,,(Харуми) Чисса
Dialogue: 0,1:38:23.60,1:38:26.56,Default,,0,0,0,,Суретке үлкен нәрсені салсаңыз, ол үлкен болады.
Dialogue: 0,1:38:26.69,1:38:28.36,Default,,0,0,0,,(күлді)
Dialogue: 0,1:38:28.48,1:38:32.40,Default,,0,0,0,,(Ескерту)
Dialogue: 0,1:38:32.53,1:38:34.45,Default,,0,0,0,,Дабыл беру Дабыл беру
Dialogue: 0,1:38:34.57,1:38:38.53,Default,,0,0,0,,Әуе қорғанысы киімдері Өрт сөндіру Есіктерді және жылжымалы есіктерді алыңыз
Dialogue: 0,1:38:38.66,1:38:42.45,Default,,0,0,0,,Жоғарыда айтылғандарды орындағаннан кейін, апаттық сөмкеңізді алып, әуе шабуылына қарсы панаханаға барыңыз.
Dialogue: 0,1:38:43.62,1:38:47.46,Default,,0,0,0,,(Ерлер) Әуе шабуылы туралы ескерту жойылды
Dialogue: 0,1:38:49.04,1:38:51.34,Default,,0,0,0,,Уф, бұл шикі.
Dialogue: 0,1:38:52.17,1:38:54.21,Default,,0,0,0,,(Домото) Мен өзімді ауыр сезінемін.
Dialogue: 0,1:38:54.34,1:38:56.80,Default,,0,0,0,,(Чита) Оның күйеуі де шайқаста қаза тапты.
Dialogue: 0,1:38:56.93,1:38:59.76,Default,,0,0,0,,Бұл жолы мен 17 жасар баламды көтере алмаймын.
Dialogue: 0,1:38:59.89,1:39:01.72,Default,,0,0,0,,Құттықтаймыз...
Dialogue: 0,1:39:01.85,1:39:04.60,Default,,0,0,0,,(дабыл)
Dialogue: 0,1:39:06.35,1:39:09.23,Default,,0,0,0,,Әуе қорғанысы киімдерін реттеп, өртті сөндіру.
Dialogue: 0,1:39:09.36,1:39:10.90,Default,,0,0,0,,Есіктерді және жылжымалы есіктерді алыңыз
Dialogue: 0,1:39:11.02,1:39:12.36,Default,,0,0,0,,Әуе қорғанысы құралдары... А! (Шусаку) Атта!
Dialogue: 0,1:39:13.15,1:39:15.61,Default,,0,0,0,,(Кейзи) Қазірдің өзінде қараңғы, мен көрмеймін.
Dialogue: 0,1:39:15.74,1:39:16.78,Default,,0,0,0,,Атта
Dialogue: 0,1:39:16.90,1:39:18.61,Default,,0,0,0,,(Мысық мияулайды) (Мысық) Эй, кешіріңіз.
Dialogue: 0,1:39:18.74,1:39:21.08,Default,,0,0,0,,Не... қай мысық? ‬
Dialogue: 0,1:39:23.33,1:39:27.08,Default,,0,0,0,,(Коджи) Бұл күндері түнде ескерту болмаса да.
Dialogue: 0,1:39:27.67,1:39:30.08,Default,,0,0,0,,Баршаңызға қош келдіңіздер.
Dialogue: 0,1:39:30.21,1:39:32.92,Default,,0,0,0,,Біз бір-бірімізді жоққа шығарамыз.
Dialogue: 0,1:39:34.34,1:39:36.92,Default,,0,0,0,,(Entaro) Зауыт да бүгін жабық.
Dialogue: 0,1:39:37.05,1:39:39.47,Default,,0,0,0,,Токио, Осака және Нагоя да өртенді.
Dialogue: 0,1:39:39.59,1:39:41.43,Default,,0,0,0,,Толқып кетпеймін.
Dialogue: 0,1:39:41.55,1:39:43.93,Default,,0,0,0,,Жүрекке толы мереке.
Dialogue: 0,1:39:46.81,1:39:47.81,Default,,0,0,0,,Уау
Dialogue: 0,1:39:47.94,1:39:50.31,Default,,0,0,0,,Көптен бері көрмегелі, Сузу-сан
Dialogue: 0,1:39:50.44,1:39:51.40,Default,,0,0,0,,Лин мырза
Dialogue: 0,1:39:52.36,1:39:55.73,Default,,0,0,0,,Мен барлық тұрақты тұтынушыларыммен келемін.
Dialogue: 0,1:39:57.78,1:40:02.24,Default,,0,0,0,,А, мен де отбасыммен келдім... Уф.
Dialogue: 0,1:40:02.37,1:40:03.45,Default,,0,0,0,,Бару
Dialogue: 0,1:40:03.58,1:40:04.33,Default,,0,0,0,,Шусаку-сан, маған осында қоңырау шалып, Рин-санды кездестір.
Dialogue: 0,1:40:04.33,1:40:05.29,Default,,0,0,0,,Шусаку-сан, маған осында қоңырау шалып, Рин-санды кездестір.
Dialogue: 0,1:40:04.33,1:40:05.29,Default,,0,0,0,,Эй
Dialogue: 0,1:40:05.29,1:40:06.70,Default,,0,0,0,,Шусаку-сан, маған осында қоңырау шалып, Рин-санды кездестір.
Dialogue: 0,1:40:07.50,1:40:08.79,Default,,0,0,0,,Иә? ‬
Dialogue: 0,1:40:08.91,1:40:12.29,Default,,0,0,0,,Не болады? Иә? Уф...
Dialogue: 0,1:40:08.91,1:40:12.29,Default,,0,0,0,,Сузудағы Футагава саябағында бірінші рет болып тұрсыз ба?
Dialogue: 0,1:40:13.63,1:40:15.00,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,1:40:15.13,1:40:18.80,Default,,0,0,0,,Біреу менімен көз алдымда ұрысып қалса, мен еш қиналмас едім.
Dialogue: 0,1:40:18.92,1:40:20.13,Default,,0,0,0,,Мен... білмеймін.
Dialogue: 0,1:40:20.13,1:40:20.88,Default,,0,0,0,,Мен... білмеймін.
Dialogue: 0,1:40:20.13,1:40:20.88,Default,,0,0,0,,Сузу-сан?
Dialogue: 0,1:40:20.88,1:40:21.01,Default,,0,0,0,,Сузу-сан?
Dialogue: 0,1:40:21.01,1:40:21.30,Default,,0,0,0,,Сузу-сан?
Dialogue: 0,1:40:21.01,1:40:21.30,Default,,0,0,0,,Екеуміз оянып, жыласақ, одан бетер қиыншылыққа ұшыраймыз.
Dialogue: 0,1:40:21.30,1:40:24.68,Default,,0,0,0,,Екеуміз оянып, жыласақ, одан бетер қиыншылыққа тап боламыз.
Dialogue: 0,1:40:24.81,1:40:27.02,Default,,0,0,0,,Иә? Не істеуім керек?
Dialogue: 0,1:40:27.56,1:40:29.31,Default,,0,0,0,,Сіз мені естисіз бе? ‬
Dialogue: 0,1:40:29.85,1:40:31.06,Default,,0,0,0,,Ах...
Dialogue: 0,1:40:31.19,1:40:34.86,Default,,0,0,0,,Кью... Рин-сан бүгін әдемі көрінеді.
Dialogue: 0,1:40:37.65,1:40:38.86,Default,,0,0,0,,Бірақ қараңыз
Dialogue: 0,1:40:39.99,1:40:41.11,Default,,0,0,0,,Қараңыз
Dialogue: 0,1:40:41.70,1:40:44.12,Default,,0,0,0,,Жіңішке камаманы төмен қарай шешіңіз.
Dialogue: 0,1:40:44.66,1:40:48.62,Default,,0,0,0,,Өрт сөндіру және құтқару жұмыстарын жедел орындауға болады.
Dialogue: 0,1:40:48.75,1:40:50.54,Default,,0,0,0,,Ағаштарға өрмелеуге де болады.
Dialogue: 0,1:40:50.66,1:40:52.04,Default,,0,0,0,,Жақсы.
Dialogue: 0,1:40:52.17,1:40:55.71,Default,,0,0,0,,Уншо Уншо
Dialogue: 0,1:40:56.25,1:40:57.21,Default,,0,0,0,,А...
Dialogue: 0,1:40:58.05,1:41:01.97,Default,,0,0,0,,А, қарашы, Сузу-сан да шықты...
Dialogue: 0,1:41:02.09,1:41:03.18,Default,,0,0,0,,А, мен білмеймін.
Dialogue: 0,1:41:03.89,1:41:05.93,Default,,0,0,0,,Білмеймін, білмеймін, білмеймін... енді! ‬
Dialogue: 0,1:41:06.06,1:41:08.06,Default,,0,0,0,,Мен енді тыңдамаймын.
Dialogue: 0,1:41:09.27,1:41:10.81,Default,,0,0,0,,Не? Ах
Dialogue: 0,1:41:11.85,1:41:12.81,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:41:13.35,1:41:14.77,Default,,0,0,0,,Иә, иә.
Dialogue: 0,1:41:17.40,1:41:18.36,Default,,0,0,0,,Иә
Dialogue: 0,1:41:19.03,1:41:22.40,Default,,0,0,0,,Қар жауған кезде ол маған шәй шыны әкелді⸺
Dialogue: 0,1:41:22.53,1:41:23.99,Default,,0,0,0,,Сузу-сан емес пе? ‬
Dialogue: 0,1:41:24.11,1:41:26.95,Default,,0,0,0,,Е, мынау Шусаку-сан...
Dialogue: 0,1:41:27.08,1:41:28.33,Default,,0,0,0,,Ах...
Dialogue: 0,1:41:28.45,1:41:32.00,Default,,0,0,0,,Оның аты Шусаку Хожо.
Dialogue: 0,1:41:32.12,1:41:36.54,Default,,0,0,0,,Бұл күйеуімнің баяғыда сатып алған шыныаяқы.
Dialogue: 0,1:41:38.30,1:41:42.38,Default,,0,0,0,,Менің ойымша, бұл Рин-санға қалай да жарасады...
Dialogue: 0,1:41:43.13,1:41:44.09,Default,,0,0,0,,Иә? ‬
Dialogue: 0,1:41:46.14,1:41:47.10,Default,,0,0,0,,Ах...
Dialogue: 0,1:41:49.01,1:41:51.43,Default,,0,0,0,,А... бұл
Dialogue: 0,1:41:56.02,1:41:57.40,Default,,0,0,0,,Қараңыз
Dialogue: 0,1:41:57.52,1:42:01.11,Default,,0,0,0,,Адамдардың сіз білмейтін сияқты көрінгенін жек көрмейсіз бе? Сузу да
Dialogue: 0,1:42:01.24,1:42:02.95,Default,,0,0,0,,бұл... хаха
Dialogue: 0,1:42:03.74,1:42:05.61,Default,,0,0,0,,Хойде
Dialogue: 0,1:42:05.74,1:42:09.83,Default,,0,0,0,,Қып-қызыл келіншек суықтан айыққан ба? ‬
Dialogue: 0,1:42:10.41,1:42:11.45,Default,,0,0,0,,О
Dialogue: 0,1:42:12.29,1:42:13.71,Default,,0,0,0,,Теру-чан
Dialogue: 0,1:42:14.41,1:42:17.71,Default,,0,0,0,,Пневмониядан қайтыс болды.
Dialogue: 0,1:42:17.84,1:42:18.79,Default,,0,0,0,,Иә?
Dialogue: 0,1:42:19.80,1:42:21.51,Default,,0,0,0,,Теру-чанды мадақтау
Dialogue: 0,1:42:21.63,1:42:24.84,Default,,0,0,0,,Сіз оңтүстік аралдың суретін салған жоқсыз, солай ма? ‬
Dialogue: 0,1:42:24.97,1:42:26.09,Default,,0,0,0,,Сузу-сан
Dialogue: 0,1:42:27.68,1:42:32.52,Default,,0,0,0,,Теру-чан, мен жылы оңтүстік теңіздерде өмір сүргім келеді.
Dialogue: 0,1:42:32.64,1:42:35.23,Default,,0,0,0,,Мен мұны үнемі айтып жүрдім.
Dialogue: 0,1:42:35.77,1:42:40.23,Default,,0,0,0,,Сузудың суретін көргенде күлетінмін.
Dialogue: 0,1:42:35.77,1:42:40.23,Default,,0,0,0,,(Айтатын күлкі)
Dialogue: 0,1:42:41.28,1:42:42.73,Default,,0,0,0,,Сіз оны пайдалансаңыз да
Dialogue: 0,1:42:44.03,1:42:45.82,Default,,0,0,0,,Теру-чанның ерін далабы
Dialogue: 0,1:42:46.36,1:42:48.24,Default,,0,0,0,,Таза сүртіңіз
Dialogue: 0,1:42:48.87,1:42:50.33,Default,,0,0,0,,Әуе шабуылынан кейін
Dialogue: 0,1:42:50.45,1:42:54.58,Default,,0,0,0,,Таза мәйіт тез тазартылатын сияқты.
Dialogue: 0,1:42:55.25,1:42:56.58,Default,,0,0,0,,Рахмет...
Dialogue: 0,1:42:58.00,1:43:00.92,Default,,0,0,0,,деді бізге қонаққа келген теңіз офицері.
Dialogue: 0,1:43:01.04,1:43:04.55,Default,,0,0,0,,Күн сайын түнде ұйықтауға мүмкіндік бермейді.
Dialogue: 0,1:43:04.67,1:43:10.01,Default,,0,0,0,,Себебі, B-29 ұшақтары әр түнде тыңғылықты түрде мина жасайды.
Dialogue: 0,1:43:10.14,1:43:11.10,Default,,0,0,0,,Хойде
Dialogue: 0,1:43:11.81,1:43:14.64,Default,,0,0,0,,Куре порты және Хиросима теңізі
Dialogue: 0,1:43:14.77,1:43:16.73,Default,,0,0,0,,Бұрынғыдан өзгеше
Dialogue: 0,1:43:16.85,1:43:21.69,Default,,0,0,0,,Мен қозғала алмаймын. Теңіз қауіпті бола ма деп қорқамын.
Dialogue: 0,1:43:22.40,1:43:27.15,Default,,0,0,0,,Неге менің басымнан қарап отырсың деп ойлаймын.
Dialogue: 0,1:43:29.32,1:43:30.70,Default,,0,0,0,,Бірақ иә
Dialogue: 0,1:43:30.82,1:43:34.95,Default,,0,0,0,,Жапонияның соңғы қалған ең үлкен әскери кемесі
Dialogue: 0,1:43:35.08,1:43:37.25,Default,,0,0,0,,Оның Күреге қайта оралуына жол бермеу.
Dialogue: 0,1:43:38.54,1:43:42.04,Default,,0,0,0,,Күре соғыс кемелерімен бірге болмайық.
Dialogue: 0,1:43:42.17,1:43:45.17,Default,,0,0,0,,Бұл сізді жалғыз қалдыру үшін.
Dialogue: 0,1:43:46.38,1:43:51.80,Default,,0,0,0,,Джейк, бәрі осылай жалғыз қалады.
Dialogue: 0,1:43:54.14,1:43:56.48,Default,,0,0,0,,Сәлем Сузу-сан
Dialogue: 0,1:43:57.43,1:43:59.94,Default,,0,0,0,,Мен өлсем, менің де жүрегімнің сырлары
Dialogue: 0,1:44:00.06,1:44:03.07,Default,,0,0,0,,Бұл ештеңе жоғалып кетпегенін білдіреді.
Dialogue: 0,1:44:03.73,1:44:08.61,Default,,0,0,0,,Бұл сән-салтанат болуы мүмкін.
Dialogue: 0,1:44:08.74,1:44:13.03,Default,,0,0,0,,Өзіңіздің шыныаяқыңыз болғандай.
Dialogue: 0,1:44:14.37,1:44:16.50,Default,,0,0,0,,Енді мен кетуім керек.
Dialogue: 0,1:44:19.21,1:44:20.79,Default,,0,0,0,,Хехехе
Dialogue: 0,1:44:21.54,1:44:24.50,Default,,0,0,0,,Менің ойымша, ол қашып кетті. Уфуфуфу.
Dialogue: 0,1:44:24.63,1:44:26.84,Default,,0,0,0,,Тағы да иә
Dialogue: 0,1:44:32.39,1:44:35.64,Default,,0,0,0,,Жалғыз емес екенімізге қуаныштымын.
Dialogue: 0,1:44:38.23,1:44:39.94,Default,,0,0,0,,Иә, біраз уақыт өтті.
Dialogue: 0,1:44:40.56,1:44:41.65,Default,,0,0,0,,(Шусаку) Сәлеметсіз бе.
Dialogue: 0,1:44:45.86,1:44:48.44,Default,,0,0,0,,Сузу-сан, сен сонда болдың ба?
Dialogue: 0,1:44:48.57,1:44:52.61,Default,,0,0,0,,Кешіріңіз, мен дос таптым.
Dialogue: 0,1:44:55.78,1:45:00.00,Default,,0,0,0,,(Шусаку) Бәрің қоштасатын уақыт келді деп шие гүлін көруге келесіңдер ме?
Dialogue: 0,1:45:00.71,1:45:05.67,Default,,0,0,0,,Бірақ бүгінгі адамдардың оңай күлімсірегеніне көңілім толды.
Dialogue: 0,1:45:05.79,1:45:11.55,Default,,0,0,0,,Шусаку-санның кәдімгідей жымиып тұрғанын көріп, менің де көңілім көтерілді.
Dialogue: 0,1:45:13.39,1:45:14.72,Default,,0,0,0,,(Шусаку) Отаде
Dialogue: 0,1:45:15.18,1:45:17.01,Default,,0,0,0,,Достарды қуу
Dialogue: 0,1:45:17.14,1:45:20.77,Default,,0,0,0,,Мен бөлек шығып, ағашқа өрмелеп көрдім, бірақ түсе алмадым.
Dialogue: 0,1:45:20.89,1:45:23.02,Default,,0,0,0,,Ұрысуды ойлап, есінен танып қалды.
Dialogue: 0,1:45:23.15,1:45:26.27,Default,,0,0,0,,(Қайжы) Әй, ауыртпалық түсірмегеніңе қуаныштымын.
Dialogue: 0,1:45:26.40,1:45:30.19,Default,,0,0,0,,Бұл сәл басқаша, бірақ жақсы.
Dialogue: 0,1:45:32.78,1:45:34.61,Default,,0,0,0,,Жүрек құпиясы
Dialogue: 0,1:45:35.16,1:45:37.95,Default,,0,0,0,,(Ескерту)
Dialogue: 0,1:45:38.08,1:45:39.04,Default,,0,0,0,,(Шусаку) Ммм.
Dialogue: 0,1:45:39.83,1:45:40.62,Default,,0,0,0,,‪‬
Dialogue: 0,1:45:40.75,1:45:43.00,Default,,0,0,0,,Ескерту Мен одан шаршадым
Dialogue: 0,1:45:43.12,1:45:45.92,Default,,0,0,0,,‪‬
Dialogue: 0,1:45:57.22,1:45:58.93,Default,,0,0,0,,Бірінші рет көрдім
Dialogue: 0,1:46:04.85,1:46:07.06,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,1:46:10.94,1:46:14.91,Default,,0,0,0,,(дыбыс)
Dialogue: 0,1:46:19.28,1:46:22.54,Default,,0,0,0,,(Жұмысшы) Ходжо мырза, әуе шабуылы туралы ескерту! ‬
Dialogue: 0,1:46:22.66,1:46:23.62,Default,,0,0,0,,(Entaro) Иә? ‬
Dialogue: 0,1:46:24.29,1:46:25.79,Default,,0,0,0,,Әуе шабуылы туралы ескерту! ‬
Dialogue: 0,1:46:25.92,1:46:26.71,Default,,0,0,0,,(Энтаро) Әй? ‬
Dialogue: 0,1:46:30.55,1:46:33.72,Default,,0,0,0,,(Энтаро) Әнші дауыс біз үшін де қорқынышты түс.
Dialogue: 0,1:46:33.84,1:46:35.22,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:46:35.34,1:46:39.22,Default,,0,0,0,,(Энтаро) Менің ойымша, бұл біреудің арманы орындалған шығар.
Dialogue: 0,1:46:43.85,1:46:44.81,Default,,0,0,0,,(Қоғамдық хабар) Хитомару Йонго
Dialogue: 0,1:46:44.94,1:46:47.73,Default,,0,0,0,,Такахата тауы Қарсыласу
Dialogue: 0,1:46:47.85,1:46:50.73,Default,,0,0,0,,(Радио: Ер) 30 ұшақ Токусима префектурасының оңтүстік-шығысында
Dialogue: 0,1:46:50.86,1:46:53.03,Default,,0,0,0,,Күреге қарай бет алды
Dialogue: 0,1:46:54.44,1:46:58.62,Default,,0,0,0,,(Ерлер) Әуе шабуылы туралы ескерту жойылды
Dialogue: 0,1:46:58.74,1:46:59.87,Default,,0,0,0,,Ах~аа
Dialogue: 0,1:46:59.99,1:47:04.16,Default,,0,0,0,,(Радио: Ер) 5-і күні таңертең жаудың 125 ірі ұшағы шабуылға шықты.
Dialogue: 0,1:47:04.29,1:47:07.33,Default,,0,0,0,,Хиро Арсенал және 11 Әуе күштері...
Dialogue: 0,1:47:07.46,1:47:09.08,Default,,0,0,0,,(Шусаку) Мен үйдемін
Dialogue: 0,1:47:09.21,1:47:12.05,Default,,0,0,0,,Ах, жақсысың деп үміттенемін, Шусаку.
Dialogue: 0,1:47:12.17,1:47:13.34,Default,,0,0,0,,Әкем ше? ‬
Dialogue: 0,1:47:14.09,1:47:15.67,Default,,0,0,0,,Жоқ, әлі жоқ...
Dialogue: 0,1:47:15.80,1:47:16.59,Default,,0,0,0,,Хоука
Dialogue: 0,1:47:20.64,1:47:23.14,Default,,0,0,0,,Сузу-сан шашу
Dialogue: 0,1:47:23.72,1:47:24.56,Default,,0,0,0,,Ах
Dialogue: 0,1:47:25.73,1:47:26.81,Default,,0,0,0,,Ах...
Dialogue: 0,1:47:32.40,1:47:34.90,Default,,0,0,0,,Сузу-сан - Комайноу
Dialogue: 0,1:47:38.03,1:47:40.16,Default,,0,0,0,,Тұрсаң да
Dialogue: 0,1:47:40.28,1:47:42.53,Default,,0,0,0,,О... не? ‬
Dialogue: 0,1:47:42.66,1:47:44.12,Default,,0,0,0,,(Шусаку) Ештеңе
Dialogue: 0,1:47:44.24,1:47:46.41,Default,,0,0,0,,Уайымдамаңыз. Бұл туралы жай ғана айтпаңыз.
Dialogue: 0,1:47:59.26,1:48:02.26,Default,,0,0,0,,Жарайды, әке, мен сенімдімін.
Dialogue: 0,1:48:02.39,1:48:04.43,Default,,0,0,0,,(Шусаку) Әскери киім, иә? ‬
Dialogue: 0,1:48:05.06,1:48:06.81,Default,,0,0,0,,(Шусаку) Фурошики мазмұны
Dialogue: 0,1:48:07.93,1:48:11.94,Default,,0,0,0,,15-ші жағдай бойынша құқық саласындағы жеке бірінші сыныпқа айналды.
Dialogue: 0,1:48:12.06,1:48:15.82,Default,,0,0,0,,Енді сіз солдатсыз, теңіз жаяу әскерінде дайындықтан өтесіз.
Dialogue: 0,1:48:15.94,1:48:17.24,Default,,0,0,0,,Наурызда қайтып оралу мүмкін емес
Dialogue: 0,1:48:18.57,1:48:21.74,Default,,0,0,0,,Осыдан кейін қайтып келе аласыз ба? ‬
Dialogue: 0,1:48:21.87,1:48:22.70,Default,,0,0,0,,(Шусаку) Мүмкін
Dialogue: 0,1:48:23.83,1:48:25.95,Default,,0,0,0,,Жақсысың ба, Сузу-сан?
Dialogue: 0,1:48:26.54,1:48:28.96,Default,,0,0,0,,Мен суықпын және арықпын
Dialogue: 0,1:48:29.08,1:48:33.25,Default,,0,0,0,,Ер адам қалмады, бізді қорғай алар ма екен деп ойлаймын.
Dialogue: 0,1:48:34.09,1:48:37.30,Default,,0,0,0,,Бұл мүмкін емес. Мүлдем мүмкін емес! ‬
Dialogue: 0,1:48:42.89,1:48:45.56,Default,,0,0,0,,Кешіріңіз, бұл өтірік.
Dialogue: 0,1:48:46.68,1:48:48.48,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,1:48:49.31,1:48:53.98,Default,,0,0,0,,Наурызда сені көрмесем, жүзіңді ұмытып қалуым мүмкін.
Dialogue: 0,1:48:54.11,1:48:55.44,Default,,0,0,0,,Сузу-сан
Dialogue: 0,1:48:55.57,1:48:57.82,Default,,0,0,0,,Джейк, мен сені осы үйде күтемін.
Dialogue: 0,1:48:57.94,1:49:02.45,Default,,0,0,0,,Мен бұл үйден Шусаку-санды таба алмайтын шығармын.
Dialogue: 0,1:49:21.84,1:49:23.72,Default,,0,0,0,,Егер сіз сурет салсаңыз, оны ұмытасыз ба? ‬
Dialogue: 0,1:49:23.84,1:49:26.35,Default,,0,0,0,,А, иә, астарлы әңгімеде.
Dialogue: 0,1:49:26.47,1:49:29.27,Default,,0,0,0,,Жоқ, Сузу-сан түсінбейді.
Dialogue: 0,1:49:29.39,1:49:31.94,Default,,0,0,0,,Әдемі көріну үшін қайсысын салдыңыз?
Dialogue: 0,1:49:32.06,1:49:32.89,Default,,0,0,0,,Алға, алға! Go
Dialogue: 0,1:49:33.02,1:49:35.36,Default,,0,0,0,,Бұл маңызды құпия.
Dialogue: 0,1:49:49.87,1:49:51.41,Default,,0,0,0,,Мен барамын.
Dialogue: 0,1:49:53.21,1:49:54.50,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,1:49:55.54,1:49:58.13,Default,,0,0,0,,(Кэйджи) Шусаку Жарты жолда бірге барайық.
Dialogue: 0,1:49:58.25,1:49:59.05,Default,,0,0,0,,(Шусаку) Ах
Dialogue: 0,1:49:59.63,1:50:01.42,Default,,0,0,0,,(Харуми) Әскери киімдер өте керемет.
Dialogue: 0,1:50:03.59,1:50:07.64,Default,,0,0,0,,Үй кенеттен үлкейіп кеткендей.
Dialogue: 0,1:50:08.85,1:50:10.43,Default,,0,0,0,,(Жеткізуші) Ха ха ха...
Dialogue: 0,1:50:12.77,1:50:14.94,Default,,0,0,0,,(Жеткізуші) Ходжо мырзаға (Кейко) Иә? ‬
Dialogue: 0,1:50:15.06,1:50:18.94,Default,,0,0,0,,(Кайджи) Ха ха ха ха...
Dialogue: 0,1:50:21.36,1:50:25.70,Default,,0,0,0,,Мен бұл Хироның өзара көмек көрсететін ауруханасы екеніне сенімдімін, солай ма?
Dialogue: 0,1:50:25.82,1:50:28.16,Default,,0,0,0,,Мен оны таба алмағаным таңқаларлық емес.
Dialogue: 0,1:50:28.28,1:50:31.08,Default,,0,0,0,,(Қозы) Қарны мен басы жараланған сияқты.
Dialogue: 0,1:50:31.20,1:50:33.16,Default,,0,0,0,,Мен ауруханадан шыға жаздадым.
Dialogue: 0,1:50:34.71,1:50:38.17,Default,,0,0,0,,Әкем сағатын жөндеуімді өтінді.
Dialogue: 0,1:50:38.29,1:50:39.71,Default,,0,0,0,,Иә, бұл мүмкіндік.
Dialogue: 0,1:50:39.84,1:50:43.55,Default,,0,0,0,,Мен Шимоносекидегі Куромура Нгатаға баруды ойлап жүрмін.
Dialogue: 0,1:50:43.67,1:50:44.59,Default,,0,0,0,,Тіпті ертең
Dialogue: 0,1:50:44.72,1:50:47.68,Default,,0,0,0,,Иә? Не? Сен ағаңмен барасың ба? ‬
Dialogue: 0,1:50:47.80,1:50:49.26,Default,,0,0,0,,(Мэйдзи) дайындал
Dialogue: 0,1:50:49.39,1:50:50.60,Default,,0,0,0,,Харуми де? ‬
Dialogue: 0,1:50:52.43,1:50:53.39,Default,,0,0,0,,(Харуми) Мектеп ше? ‬
Dialogue: 0,1:50:53.52,1:50:57.31,Default,,0,0,0,,(Гуйжи) Иә, иә, ол жерге барсаң да, топырақпен ойнап, гимнастика жасайсың.
Dialogue: 0,1:50:58.23,1:51:02.36,Default,,0,0,0,,(Әйелдер) ♪ «Жеңіс күніне дейін»
Dialogue: 0,1:51:08.87,1:51:11.66,Default,,0,0,0,,(Мейко) А, бұл көп уақытты алады.
Dialogue: 0,1:51:11.79,1:51:12.87,Default,,0,0,0,,(Харуми) Ха...
Dialogue: 0,1:51:12.99,1:51:14.08,Default,,0,0,0,,(Гуйжи) Мен билет аламын.
Dialogue: 0,1:51:14.20,1:51:16.83,Default,,0,0,0,,Харумиді әкесіне апара аласыз ба?
Dialogue: 0,1:51:16.96,1:51:17.83,Default,,0,0,0,,(Харуми)? ‬
Dialogue: 0,1:51:17.96,1:51:20.71,Default,,0,0,0,,Эй, кеттік, Харуми-чан.
Dialogue: 0,1:51:20.84,1:51:23.05,Default,,0,0,0,,(Харуми) Әскери-теңіз күштеріне қосыла аламын ба? ‬
Dialogue: 0,1:51:23.17,1:51:24.05,Default,,0,0,0,,Иә...
Dialogue: 0,1:51:26.80,1:51:28.43,Default,,0,0,0,,Неге сонша аю?
Dialogue: 0,1:51:28.55,1:51:31.35,Default,,0,0,0,,Төтенше жағдайда сізде мақтанатын бамбук найзасы бар.
Dialogue: 0,1:51:31.47,1:51:34.93,Default,,0,0,0,,Сен ақымақсың ба? Ата-анаң қорқса, басқаша.
Dialogue: 0,1:51:35.06,1:51:37.64,Default,,0,0,0,,Жоқ, өзімді жақсы сезінбеймін.
Dialogue: 0,1:51:37.77,1:51:39.90,Default,,0,0,0,,Дәлірек айтсақ, бамбук найзасымен...
Dialogue: 0,1:51:40.44,1:51:42.52,Default,,0,0,0,,(Харуми) Шимоносэки алыс па? ‬
Dialogue: 0,1:51:42.65,1:51:43.61,Default,,0,0,0,,Иә
Dialogue: 0,1:51:43.73,1:51:45.49,Default,,0,0,0,,(Харуми) Хиросимадан алыс па? ‬
Dialogue: 0,1:51:45.61,1:51:46.74,Default,,0,0,0,,Ол алыс
Dialogue: 0,1:51:46.86,1:51:47.95,Default,,0,0,0,,(Харуми) Осылай ма? ‬
Dialogue: 0,1:51:48.07,1:51:50.07,Default,,0,0,0,,Мен ауруханаға баруым керек.
Dialogue: 0,1:51:50.20,1:51:51.16,Default,,0,0,0,,(Харуми) Иә.
Dialogue: 0,1:51:52.16,1:51:55.54,Default,,0,0,0,,♪«Ай сәулесі серенадасы»
Dialogue: 0,1:51:55.66,1:51:57.58,Default,,0,0,0,,(Харуми) Дұшпандық музыка дегенді қалай түсінесіңдер? (Сержант) Ш.
Dialogue: 0,1:51:57.71,1:51:59.96,Default,,0,0,0,,Сіз уайымдадыңыз.
Dialogue: 0,1:52:00.08,1:52:03.92,Default,,0,0,0,,Мен көптен бері ес-түссіз жатырмын, маусым айы да болды.
Dialogue: 0,1:52:04.05,1:52:06.01,Default,,0,0,0,,Бұл бәрінен де көп болды.
Dialogue: 0,1:52:06.13,1:52:09.55,Default,,0,0,0,,Харуми, мен пойызға мініп, ағаммен барамын.
Dialogue: 0,1:52:09.68,1:52:12.43,Default,,0,0,0,,Неғұрлым тезірек болса, соғұрлым жақсы.
Dialogue: 0,1:52:12.55,1:52:15.31,Default,,0,0,0,,Әй, сен қандай кемеге міндің? ‬
Dialogue: 0,1:52:15.43,1:52:17.52,Default,,0,0,0,,(Жеке) №16 арнайы мина тасушы
Dialogue: 0,1:52:17.64,1:52:19.19,Default,,0,0,0,,(Харуми) Хмм.
Dialogue: 0,1:52:19.98,1:52:23.44,Default,,0,0,0,,Мұнда келсеңіз, көп нәрсені үйренесіз.
Dialogue: 0,1:52:23.57,1:52:25.44,Default,,0,0,0,,Гуанчжоу да жабылды.
Dialogue: 0,1:52:25.57,1:52:29.95,Default,,0,0,0,,Сондай-ақ Әскери-теңіз күштерінің өзі армияға сіңеді деген қауесет бар.
Dialogue: 0,1:52:30.07,1:52:33.12,Default,,0,0,0,,Сузу-сан, Ямато батып кеткен сияқты.
Dialogue: 0,1:52:33.24,1:52:34.37,Default,,0,0,0,,Ямато? ‬
Dialogue: 0,1:52:34.49,1:52:39.58,Default,,0,0,0,,Әй, бұрышқа тығылып жаудың алдына шықтым.
Dialogue: 0,1:52:40.29,1:52:44.63,Default,,0,0,0,,Сето ішкі теңізі де біздің теңіз.
Dialogue: 0,1:52:44.75,1:52:48.30,Default,,0,0,0,,Ей, толқындағы қоян әлдеқашан...
Dialogue: 0,1:52:48.42,1:52:50.26,Default,,0,0,0,,(Entaro) Иә? Жоқ
Dialogue: 0,1:52:50.38,1:52:53.14,Default,,0,0,0,,(Энтаро) Жүр, мен айттым.
Dialogue: 0,1:52:53.26,1:52:57.47,Default,,0,0,0,,Куромураның ата-анасына Харумиді эвакуациялауға рұқсат етіңіз.
Dialogue: 0,1:52:57.60,1:53:00.10,Default,,0,0,0,,Мен мұндағыдан гөрі қауіпсіз сезінемін.
Dialogue: 0,1:53:01.23,1:53:02.60,Default,,0,0,0,,Сонымен, жеңге
Dialogue: 0,1:53:02.73,1:53:06.11,Default,,0,0,0,,(Харуми) Эй, Сузу-сан, сол жаққа барып қарауға бола ма? ‬
Dialogue: 0,1:53:06.23,1:53:09.65,Default,,0,0,0,,Мен мұнда қандай кеме келгенін айтайын.
Dialogue: 0,1:53:09.78,1:53:11.95,Default,,0,0,0,,Иә, көре аласыз ба?
Dialogue: 0,1:53:12.07,1:53:14.20,Default,,0,0,0,,(Харуми) Тек Чито Тек Чито
Dialogue: 0,1:53:14.32,1:53:15.62,Default,,0,0,0,,Мен оны көрмеймін
Dialogue: 0,1:53:15.74,1:53:18.16,Default,,0,0,0,,(Ескерту)
Dialogue: 0,1:53:18.29,1:53:20.37,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,1:53:20.50,1:53:23.75,Default,,0,0,0,,Мен үйге қайта алмаймын, мен бір жерде қоғамдық әуе шабуылына қарсы паналаудамын...
Dialogue: 0,1:53:23.88,1:53:24.67,Default,,0,0,0,,Иә? ‬
Dialogue: 0,1:53:25.79,1:53:27.25,Default,,0,0,0,,(Әйел) Шынымен келе жатырсың ба? ‬
Dialogue: 0,1:53:27.38,1:53:30.17,Default,,0,0,0,,(Әйел) Соңғы кездері мен көп қателесіп жүрмін.
Dialogue: 0,1:53:30.88,1:53:34.09,Default,,0,0,0,,(Ер) Марукюфутасан Токуяма оңтүстік-шығыс
Dialogue: 0,1:53:34.22,1:53:38.85,Default,,0,0,0,,Жау ұшағы Үлкен Шамамен 20 ұшақ Куреге қарай бет алды
Dialogue: 0,1:53:40.31,1:53:42.77,Default,,0,0,0,,(Әйел) Әй, шынымен де осы жолы келдім.
Dialogue: 0,1:53:42.89,1:53:45.02,Default,,0,0,0,,Кешіріңіз, кіруге болады ма?
Dialogue: 0,1:53:45.15,1:53:46.19,Default,,0,0,0,,Ерте келіңіз
Dialogue: 0,1:53:46.31,1:53:48.94,Default,,0,0,0,,(Ер адам) Эвакуация, асығыңыз! ‬
Dialogue: 0,1:53:53.32,1:53:54.74,Default,,0,0,0,,Сузу-сан қорқынышты
Dialogue: 0,1:53:53.32,1:53:54.74,Default,,0,0,0,,(қашықтағы бомбалау дыбыстары)
Dialogue: 0,1:53:54.74,1:53:54.86,Default,,0,0,0,,(қашықтағы бомбалау дыбыстары)
Dialogue: 0,1:53:54.86,1:53:57.33,Default,,0,0,0,,(қашықтағы бомбалау дыбыстары)
Dialogue: 0,1:53:54.86,1:53:57.33,Default,,0,0,0,,Жарайды, қара.
Dialogue: 0,1:53:59.33,1:54:01.16,Default,,0,0,0,,(Харуми) А, анашым.
Dialogue: 0,1:54:01.29,1:54:04.04,Default,,0,0,0,,Иә, эй, бұл туралы ше? ‬
Dialogue: 0,1:54:04.17,1:54:05.21,Default,,0,0,0,,(Харуми) Харуми
Dialogue: 0,1:54:05.33,1:54:07.92,Default,,0,0,0,,Харуми-чан, сен анаңмен біргесің.
Dialogue: 0,1:54:08.04,1:54:10.38,Default,,0,0,0,,(Әйел) Сіз бұл жақтан емессіз.
Dialogue: 0,1:54:10.51,1:54:13.26,Default,,0,0,0,,Наганокиден ауруханаға бару
Dialogue: 0,1:54:13.38,1:54:15.13,Default,,0,0,0,,Бұл жаман уақыт болды.
Dialogue: 0,1:54:15.13,1:54:15.93,Default,,0,0,0,,Бұл қате болды.
Dialogue: 0,1:54:15.13,1:54:15.93,Default,,0,0,0,,(бомба дыбысы)
Dialogue: 0,1:54:15.93,1:54:16.05,Default,,0,0,0,,(бомба дыбысы)
Dialogue: 0,1:54:16.05,1:54:17.30,Default,,0,0,0,,(бомба дыбысы)
Dialogue: 0,1:54:16.05,1:54:17.30,Default,,0,0,0,,(Әйел) Міне келді! Құлағыңызды жабыңыз, аузыңызды ашыңыз, көзіңіз шығады
Dialogue: 0,1:54:17.30,1:54:19.22,Default,,0,0,0,,(Әйел) Міне келді! Құлағыңызды жабыңыз, аузыңызды ашыңыз, көзіңіз шығады
Dialogue: 0,1:54:20.89,1:54:24.39,Default,,0,0,0,,(Харуми) Ыстық, иә, мен шыдай аламын.
Dialogue: 0,1:54:24.52,1:54:26.73,Default,,0,0,0,,(Жарылыс дыбысы) (Айқай)
Dialogue: 0,1:54:28.86,1:54:30.73,Default,,0,0,0,,(айқай)
Dialogue: 0,1:54:43.08,1:54:45.25,Default,,0,0,0,,Ух... ха...
Dialogue: 0,1:54:46.25,1:54:47.58,Default,,0,0,0,,(Әйел жөтелді)
Dialogue: 0,1:54:49.42,1:54:52.26,Default,,0,0,0,,(Харумидің жөтелі)
Dialogue: 0,1:54:57.72,1:55:01.35,Default,,0,0,0,,Мм... су іше аласыз ба? ‬
Dialogue: 0,1:55:01.47,1:55:02.27,Default,,0,0,0,,(Әйел) А...
Dialogue: 0,1:55:06.39,1:55:08.73,Default,,0,0,0,,Рахмет
Dialogue: 0,1:55:09.36,1:55:12.82,Default,,0,0,0,,(Харуми) Пойыз әлі кетті ме?
Dialogue: 0,1:55:12.94,1:55:16.03,Default,,0,0,0,,Пойыз да қозғалмайды. Күте тұрыңыз, Рин-са.
Dialogue: 0,1:55:16.95,1:55:17.78,Default,,0,0,0,,(Харуми) Иә.
Dialogue: 0,1:55:17.91,1:55:19.53,Default,,0,0,0,,(жарты қоңырау және сирена)
Dialogue: 0,1:55:19.66,1:55:20.49,Default,,0,0,0,,Ах! ‬
Dialogue: 0,1:55:23.91,1:55:27.00,Default,,0,0,0,,Ах~ мен ештеңе көрмеймін
Dialogue: 0,1:55:27.12,1:55:29.13,Default,,0,0,0,,Хмм хмм хмм
Dialogue: 0,1:55:29.25,1:55:31.13,Default,,0,0,0,,(Өрт сөндіруші) Жақсысың ба? ‬
Dialogue: 0,1:55:31.25,1:55:32.30,Default,,0,0,0,,Иә
Dialogue: 0,1:55:32.42,1:55:34.13,Default,,0,0,0,,Жарылмаған снарядтар
Dialogue: 0,1:55:34.26,1:55:39.30,Default,,0,0,0,,Бұл сағаттық бомба болуы мүмкін, сондықтан асығыңыз және қашыңыз!
Dialogue: 0,1:55:39.43,1:55:42.85,Default,,0,0,0,,Ха, сәттілік!
Dialogue: 0,1:55:42.97,1:55:44.31,Default,,0,0,0,,Эй, Сузу-сан
Dialogue: 0,1:55:44.43,1:55:47.81,Default,,0,0,0,,Келесі жолы Харумидің ағасын да салыңыз.
Dialogue: 0,1:55:47.94,1:55:50.90,Default,,0,0,0,,(Әскери) Жарылмаған снарядтардың шұңқыры өте кішкентай.
Dialogue: 0,1:55:51.02,1:55:54.15,Default,,0,0,0,,Жақында шыққан Азаматтық әуе қорғанысының оқу бюллетеніне сәйкес
Dialogue: 0,1:55:54.28,1:55:56.82,Default,,0,0,0,,Жау тасталған бомбаның бір бөлігі болады...
Dialogue: 0,1:55:56.94,1:55:59.78,Default,,0,0,0,,Ха! қауіпті! Харуми-чан
Dialogue: 0,1:56:36.57,1:56:39.20,Default,,0,0,0,,Тағы да басқаша.
Dialogue: 0,1:56:39.36,1:56:43.16,Default,,0,0,0,,Сен сондай жаман болсаң, маған үйленбе.
Dialogue: 0,1:56:43.28,1:56:47.16,Default,,0,0,0,,Енді ойлап қарасам, маған көп айтылды.
Dialogue: 0,1:56:47.29,1:56:49.50,Default,,0,0,0,,Мен бармайтын жол болмады.
Dialogue: 0,1:56:51.21,1:56:57.38,Default,,0,0,0,,Қарбыз Вараби мочи Жалбыз қант
Dialogue: 0,1:56:58.05,1:57:03.05,Default,,0,0,0,,Сол жолда арық болса, мен секіре алар едім.
Dialogue: 0,1:57:03.93,1:57:06.56,Default,,0,0,0,,Фурошики сол қолға оралған
Dialogue: 0,1:57:07.89,1:57:09.77,Default,,0,0,0,,Харуми-сан оң жақта
Dialogue: 0,1:57:11.06,1:57:13.40,Default,,0,0,0,,Мен керісінше болғанын қалаймын.
Dialogue: 0,1:57:15.31,1:57:18.99,Default,,0,0,0,,Ең болмаса киіміңді шешіп жүгір.
Dialogue: 0,1:57:20.07,1:57:21.70,Default,,0,0,0,,Төбенің арғы жағында
Dialogue: 0,1:57:22.24,1:57:24.45,Default,,0,0,0,,Төбенің арғы жағында...
Dialogue: 0,1:57:24.57,1:57:28.45,Default,,0,0,0,,(Харуми) Бұл Тон, бұл Хината.
Dialogue: 0,1:57:28.58,1:57:32.00,Default,,0,0,0,,Ямато ана осында.
Dialogue: 0,1:57:32.12,1:57:34.92,Default,,0,0,0,,(Кейзидің жылаған дауысы)
Dialogue: 0,1:57:35.04,1:57:36.29,Default,,0,0,0,,Бұл адам...
Dialogue: 0,1:57:37.55,1:57:41.76,Default,,0,0,0,,Расымен де Шусаку-сан Ринсаруға ұқсайды.
Dialogue: 0,1:57:43.43,1:57:45.18,Default,,0,0,0,,(Кейзи) Сіз менің артымнан келе жатырсыз...
Dialogue: 0,1:57:46.22,1:57:48.77,Default,,0,0,0,,Сіз менімен бірге болғаныңызда! ‬
Dialogue: 0,1:57:48.89,1:57:50.52,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:57:50.64,1:57:52.69,Default,,0,0,0,,Кешіріңіз, Харуми-сан.
Dialogue: 0,1:57:52.81,1:57:54.19,Default,,0,0,0,,Кешіріңіз, жеңге.
Dialogue: 0,1:57:54.31,1:57:56.36,Default,,0,0,0,,(Киязи) Қанішер
Dialogue: 0,1:57:56.90,1:57:58.57,Default,,0,0,0,,Кісі өлтіру! ‬
Dialogue: 0,1:57:58.69,1:58:00.61,Default,,0,0,0,,(Энтаро) Тоқта, Кейко (Кейко) Харумиді қайтар! ‬
Dialogue: 0,1:58:00.74,1:58:02.78,Default,,0,0,0,,Тофуды тарататын кез келді.
Dialogue: 0,1:58:04.70,1:58:09.41,Default,,0,0,0,,Сен оны байыппен айта алмайсың, себебі ол бала да ренжіп қалады.
Dialogue: 0,1:58:09.54,1:58:12.37,Default,,0,0,0,,Сіз бізді жаңа ғана құтқарсаңыз да.
Dialogue: 0,1:58:12.50,1:58:15.21,Default,,0,0,0,,Мен солай ойлағаныма қуаныштымын.
Dialogue: 0,1:58:15.33,1:58:16.71,Default,,0,0,0,,Мен солай ойлаймын.
Dialogue: 0,1:58:18.00,1:58:21.80,Default,,0,0,0,,Бұл дүниеде маған тиесілі орын жоқ.
Dialogue: 0,1:58:21.92,1:58:22.55,Default,,0,0,0,,Лин мырза
Dialogue: 0,1:58:22.55,1:58:23.51,Default,,0,0,0,,Лин мырза
Dialogue: 0,1:58:22.55,1:58:23.51,Default,,0,0,0,,Эй
Dialogue: 0,1:58:24.55,1:58:28.64,Default,,0,0,0,,Ол кезде менің орным қай жерде еді?
Dialogue: 0,1:58:29.39,1:58:33.43,Default,,0,0,0,,Кейбір тақталар сол тақтай қоршаудан құлап кеткен болуы керек.
Dialogue: 0,1:58:34.06,1:58:36.77,Default,,0,0,0,,Жарылысқа мініп, сол жерден секіру
Dialogue: 0,1:58:37.61,1:58:40.57,Default,,0,0,0,,Ана жақта, ана жақта...
Dialogue: 0,1:58:40.69,1:58:43.07,Default,,0,0,0,,(Дабыл)
Dialogue: 0,1:58:43.19,1:58:45.28,Default,,0,0,0,,Жарайсың, тағы кездескенше.
Dialogue: 0,1:58:45.40,1:58:48.57,Default,,0,0,0,,Бұл дыбыс шықпайды, ұйықта, ұйықта
Dialogue: 0,1:58:48.70,1:58:52.58,Default,,0,0,0,,Бұл үй ерекше емес еді.
Dialogue: 0,1:58:52.70,1:58:55.96,Default,,0,0,0,,Эй, уайымдама.
Dialogue: 0,1:58:56.08,1:58:58.04,Default,,0,0,0,,Жақсы
Dialogue: 0,1:58:58.17,1:58:59.21,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,1:58:59.96,1:59:04.34,Default,,0,0,0,,Сол адам менің үйімді бұзды.
Dialogue: 0,1:59:04.97,1:59:08.34,Default,,0,0,0,,Мен бұл қаладан абыроймен кете алар ма едім деп ойлаймын.
Dialogue: 0,1:59:10.89,1:59:12.89,Default,,0,0,0,,(Мейко) Асықпа.
Dialogue: 0,1:59:13.02,1:59:17.06,Default,,0,0,0,,(Энтаро) Жарайды, егер бұл үлкен мәселе болса, мен сізге жұмыста демалуға рұқсат етемін.
Dialogue: 0,1:59:17.19,1:59:18.40,Default,,0,0,0,,(Viazi) Қош келдіңіз.
Dialogue: 0,1:59:21.73,1:59:24.15,Default,,0,0,0,,Иә, күн жарқырайды
Dialogue: 0,1:59:24.28,1:59:27.11,Default,,0,0,0,,(Қайжы) Таңғыш Сыртынан кептірейік.
Dialogue: 0,1:59:30.41,1:59:32.54,Default,,0,0,0,,(Радио: Ер) Қытай аймағының әуе қорғанысы туралы ақпарат
Dialogue: 0,1:59:32.66,1:59:36.16,Default,,0,0,0,,23:50 Хиросима шығанағында жау ұшақтарының 2 нысанасы бар
Dialogue: 0,1:59:36.29,1:59:37.37,Default,,0,0,0,,2 Suonada үшін мақсаттар
Dialogue: 0,1:59:37.50,1:59:38.88,Default,,0,0,0,,Ояна аласың ба, Сузу-сан?
Dialogue: 0,1:59:39.00,1:59:42.38,Default,,0,0,0,,Иә, жақсы.
Dialogue: 0,1:59:42.50,1:59:46.80,Default,,0,0,0,,(Радио: Ер) 23:58 Куре мен Хиросима маңындағы жау ұшақтары.
Dialogue: 0,1:59:46.92,1:59:47.22,Default,,0,0,0,,Бірнеше ұшақ айналып жүрді.
Dialogue: 0,1:59:47.22,1:59:48.38,Default,,0,0,0,,Бірнеше ұшақ айналып жүрді.
Dialogue: 0,1:59:47.22,1:59:48.38,Default,,0,0,0,,Қараңыз
Dialogue: 0,1:59:48.38,1:59:48.97,Default,,0,0,0,,Бірнеше ұшақ айналып жүрді.
Dialogue: 0,1:59:50.60,1:59:51.51,Default,,0,0,0,,Ах...
Dialogue: 0,1:59:53.35,1:59:54.31,Default,,0,0,0,,(Кайжы) Хаа...
Dialogue: 0,1:59:55.93,2:00:00.56,Default,,0,0,0,,Хохо, мен мұнда келсем, мені көре алмайсың.
Dialogue: 0,2:00:01.31,2:00:04.40,Default,,0,0,0,,(Виази) Ах! Уау
Dialogue: 0,2:00:04.53,2:00:06.07,Default,,0,0,0,,Бұл алау ма? ‬
Dialogue: 0,2:00:09.82,2:00:11.70,Default,,0,0,0,,Сузу-сан, сен де тез кел.
Dialogue: 0,2:00:31.26,2:00:33.14,Default,,0,0,0,,(шу)
Dialogue: 0,2:00:43.52,2:00:47.23,Default,,0,0,0,,Сузу-сан! Сен не істеп жатырсың? Асықшы! ‬
Dialogue: 0,2:00:52.66,2:00:55.66,Default,,0,0,0,,Сузу-сан! Сузу-сан! ‬
Dialogue: 0,2:00:56.54,2:00:57.66,Default,,0,0,0,,Ах...
Dialogue: 0,2:00:57.79,2:00:59.79,Default,,0,0,0,,Ах! ‬
Dialogue: 0,2:01:02.08,2:01:04.25,Default,,0,0,0,,Уау! ‬
Dialogue: 0,2:01:04.38,2:01:05.71,Default,,0,0,0,,Ахх
Dialogue: 0,2:01:06.96,2:01:09.05,Default,,0,0,0,,(Кайко) Сузу-сан, құлап қалдың ба?
Dialogue: 0,2:01:09.59,2:01:11.88,Default,,0,0,0,,Су! көбірек су
Dialogue: 0,2:01:12.01,2:01:12.80,Default,,0,0,0,,Уау!
Dialogue: 0,2:01:13.59,2:01:16.35,Default,,0,0,0,,(Радио: Ер) Қытай аймағының әуе қорғанысы туралы ақпарат
Dialogue: 0,2:01:13.59,2:01:16.35,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,2:01:16.47,2:01:20.98,Default,,0,0,0,,0:20: Алдымен Бунго арнасының бойымен солтүстікке қарай жылжитын жау құрамы
Dialogue: 0,2:01:16.47,2:01:20.98,Default,,0,0,0,,Хмм, жарайды... Абайлаңыз.
Dialogue: 0,2:01:21.10,2:01:23.44,Default,,0,0,0,,Хиросима шығанағының оңтүстігі арқылы солтүстікке бару
Dialogue: 0,2:01:23.56,2:01:26.32,Default,,0,0,0,,1 формация Бунго арнасынан солтүстікке қарай
Dialogue: 0,2:01:26.44,2:01:30.82,Default,,0,0,0,,оңтүстік-батыс теңізінде және Ашизуриде 3 нысана бар.
Dialogue: 0,2:01:30.95,2:01:32.53,Default,,0,0,0,,Ақпараттың соңы
Dialogue: 0,2:01:32.66,2:01:33.95,Default,,0,0,0,,Бұл JOFK Хиросима хабар тарату станциясы
Dialogue: 0,2:01:33.95,2:01:36.28,Default,,0,0,0,,Бұл JOFK Хиросима хабар тарату станциясы
Dialogue: 0,2:01:33.95,2:01:36.28,Default,,0,0,0,,(жарты қоңырау және сирена)
Dialogue: 0,2:01:36.28,2:01:36.41,Default,,0,0,0,,(жарты қоңырау және сирена)
Dialogue: 0,2:01:36.41,2:01:38.62,Default,,0,0,0,,(жарты қоңырау және сирена)
Dialogue: 0,2:01:36.41,2:01:38.62,Default,,0,0,0,,Күреде барлығына сәттілік.
Dialogue: 0,2:01:38.74,2:01:41.25,Default,,0,0,0,,Күреде барлығына сәттілік.
Dialogue: 0,2:01:44.25,2:01:46.29,Default,,0,0,0,,(Ер) Барлық апаттан зардап шеккендерге
Dialogue: 0,2:01:47.17,2:01:51.80,Default,,0,0,0,,Нигири Меши Хиросимадан келеді.
Dialogue: 0,2:01:51.92,2:01:55.26,Default,,0,0,0,,Футагва саябағында тарату
Dialogue: 0,2:01:55.39,2:01:57.68,Default,,0,0,0,,(Домото) Апат құрбаны туралы куәлікті қайдан алуға болады?
Dialogue: 0,2:01:57.81,2:01:59.52,Default,,0,0,0,,Қалалық әкімдік әлі бар ма?
Dialogue: 0,2:01:59.64,2:02:01.02,Default,,0,0,0,,Менің үйім толығымен өртеніп кетті, солай емес пе?
Dialogue: 0,2:02:01.14,2:02:03.31,Default,,0,0,0,,(Кобаяши) Траншеяға түсіп, жаныңды сақтама.
Dialogue: 0,2:02:03.44,2:02:05.15,Default,,0,0,0,,(Ер адам) Кешіріңіз, жарай ма? ‬
Dialogue: 0,2:02:05.27,2:02:06.61,Default,,0,0,0,,Иә, өтінемін
Dialogue: 0,2:02:08.94,2:02:11.74,Default,,0,0,0,,(Әйел) Аа, оны жылы болғанша жеу керек.
Dialogue: 0,2:02:11.86,2:02:15.41,Default,,0,0,0,,Төсектің астына қойған картоп толығымен өртеніп кетті.
Dialogue: 0,2:02:15.53,2:02:18.16,Default,,0,0,0,,Итадакимасу
Dialogue: 0,2:02:18.28,2:02:19.74,Default,,0,0,0,,Жездем де
Dialogue: 0,2:02:20.95,2:02:24.58,Default,,0,0,0,,Жоқ, ыстық, ыстық, ыстық...
Dialogue: 0,2:02:25.29,2:02:28.09,Default,,0,0,0,,(Ер адам) Эй, Шинономе қаласының тұрғындары ше?
Dialogue: 0,2:02:28.21,2:02:31.42,Default,,0,0,0,,(Ер) Мен Асахи қаласынан оңтүстікке бара алмаймын.
Dialogue: 0,2:02:31.55,2:02:33.26,Default,,0,0,0,,Қызыл жарық аймағы да өртенді.
Dialogue: 0,2:02:33.38,2:02:34.47,Default,,0,0,0,,(Ер) Хоука
Dialogue: 0,2:02:34.59,2:02:36.09,Default,,0,0,0,,(Аяқ дыбысы) Ах...
Dialogue: 0,2:02:36.22,2:02:38.51,Default,,0,0,0,,(Шусаку) Сузу-сан! Эй...
Dialogue: 0,2:02:40.14,2:02:41.10,Default,,0,0,0,,Сіз жарақат алдыңыз ба? ‬
Dialogue: 0,2:02:41.22,2:02:43.23,Default,,0,0,0,,Жаттығу туралы не деуге болады? (Шусаку) Ол жойылды.
Dialogue: 0,2:02:43.93,2:02:47.02,Default,,0,0,0,,Әйтеуір, аман қалғаныңа қуаныштымын.
Dialogue: 0,2:02:47.81,2:02:50.07,Default,,0,0,0,,Аңырап, бұлыңғыр
Dialogue: 0,2:02:50.19,2:02:50.98,Default,,0,0,0,,Сузу-сан! ‬
Dialogue: 0,2:02:51.11,2:02:54.11,Default,,0,0,0,,Рин-санды іздеп жатырмын... (Шусаку) Сузу-сан Эй! ‬
Dialogue: 0,2:02:54.24,2:02:57.24,Default,,0,0,0,,Иә, мен өз дауысымды естідім
Dialogue: 0,2:02:59.99,2:03:01.24,Default,,0,0,0,,(Шусаку) Әйтеуір, жақсы болды.
Dialogue: 0,2:03:01.37,2:03:04.00,Default,,0,0,0,,Қызуыңыздың төмендегеніне қуаныштымын.
Dialogue: 0,2:03:04.12,2:03:06.87,Default,,0,0,0,,Жақсы болды, ол жарылып кетпеді.
Dialogue: 0,2:03:07.00,2:03:08.88,Default,,0,0,0,,Сіз оны өшіре алғаныңызға қуаныштымын.
Dialogue: 0,2:03:09.00,2:03:11.80,Default,,0,0,0,,(Дәрігер) Тез жазылып кеткеніңізге қуаныштымын.
Dialogue: 0,2:03:11.92,2:03:12.71,Default,,0,0,0,,Жақсы...
Dialogue: 0,2:03:13.55,2:03:15.72,Default,,0,0,0,,«Жақсы, жақсы»
Dialogue: 0,2:03:17.22,2:03:20.93,Default,,0,0,0,,Мен оның не жақсы болғанын білмеймін.
Dialogue: 0,2:03:23.18,2:03:27.06,Default,,0,0,0,,Маусым айында менің оң қолым Харуми-санға қосылды.
Dialogue: 0,2:03:27.19,2:03:31.48,Default,,0,0,0,,Мамыр айында Шусакудың оң қолында ұйықтап жатқан беті бейнеленген
Dialogue: 0,2:03:31.61,2:03:33.23,Default,,0,0,0,,Сәуірде оң қол Теру мырзаның қып-қызыл қызылын ұстады
Dialogue: 0,2:03:33.23,2:03:34.40,Default,,0,0,0,,Сәуірде оң қол Теру-санның қып-қызыл қызылын қысып ұстады
Dialogue: 0,2:03:33.23,2:03:34.40,Default,,0,0,0,,Наурызда
Dialogue: 0,2:03:34.40,2:03:34.53,Default,,0,0,0,,Сәуірде оң қолы Теру-санның қып-қызыл өңін ұстады
Dialogue: 0,2:03:34.53,2:03:35.82,Default,,0,0,0,,Сәуірде оң қол Теру мырзаның қып-қызыл қызылын ұстады
Dialogue: 0,2:03:34.53,2:03:35.82,Default,,0,0,0,,Харумиге арналған оқулықты көшірген оң қол
Dialogue: 0,2:03:35.82,2:03:35.95,Default,,0,0,0,,Харумиге арналған оқулықты көшірген оң қол
Dialogue: 0,2:03:35.95,2:03:37.28,Default,,0,0,0,,Харумиге арналған оқулықты көшірген оң қол
Dialogue: 0,2:03:35.95,2:03:37.28,Default,,0,0,0,,Ақпан айында Онии-чанның миын көтерген оң қол
Dialogue: 0,2:03:37.28,2:03:37.40,Default,,0,0,0,,Ақпан айында Онии-чанның миын көтерген оң қол
Dialogue: 0,2:03:37.40,2:03:38.45,Default,,0,0,0,,Ақпан айында Онии-чанның миын көтерген оң қол
Dialogue: 0,2:03:37.40,2:03:38.45,Default,,0,0,0,,қаңтарда
Dialogue: 0,2:03:38.45,2:03:38.57,Default,,0,0,0,,Ақпан айында Онии-чанның миын көтерген оң қол
Dialogue: 0,2:03:38.57,2:03:40.37,Default,,0,0,0,,Ақпан айында Онии-чанның миын көтерген оң қол
Dialogue: 0,2:03:38.57,2:03:40.37,Default,,0,0,0,,Карутаның оң қолы
Dialogue: 0,2:03:40.49,2:03:41.95,Default,,0,0,0,,Өткен қараша айында қайын апамның кимоносын қате қиып алдым.
Dialogue: 0,2:03:41.95,2:03:43.54,Default,,0,0,0,,Өткен қараша айында қайын апамның кимоносын қате қиып алдым.
Dialogue: 0,2:03:41.95,2:03:43.54,Default,,0,0,0,,Өткен маусымда...
Dialogue: 0,2:03:43.54,2:03:44.54,Default,,0,0,0,,Өткен қараша айында қайын сіңілімнің кимоносын қате қидым.
Dialogue: 0,2:03:44.54,2:03:45.91,Default,,0,0,0,,Өткен қараша айында қайын апамның кимоносын қате қиып алдым.
Dialogue: 0,2:03:44.54,2:03:45.91,Default,,0,0,0,,Өткен қыркүйекте...
Dialogue: 0,2:03:46.04,2:03:47.08,Default,,0,0,0,,Өткен тамызда мен Линнің оң қолына қарбыз тарттым.
Dialogue: 0,2:03:47.08,2:03:48.79,Default,,0,0,0,,Өткен тамызда мен Линнің оң қолына қарбыз тарттым.
Dialogue: 0,2:03:47.08,2:03:48.79,Default,,0,0,0,,Өткен шілдеде...
Dialogue: 0,2:03:48.79,2:03:50.33,Default,,0,0,0,,Өткен тамызда мен Линнің оң қолына қарбыз тарттым.
Dialogue: 0,2:03:50.33,2:03:50.67,Default,,0,0,0,,Өткен тамызда мен Линнің оң қолына қарбыз тарттым.
Dialogue: 0,2:03:50.33,2:03:50.67,Default,,0,0,0,,Өткен маусымда...
Dialogue: 0,2:03:50.67,2:03:51.59,Default,,0,0,0,,Өткен маусымда...
Dialogue: 0,2:03:51.59,2:03:52.25,Default,,0,0,0,,Өткен маусымда...
Dialogue: 0,2:03:51.59,2:03:52.25,Default,,0,0,0,,Өткен мамырда мен лорд Кусунокиге таңғалғаным сонша, таяқшаларымды тастап кеттім.
Dialogue: 0,2:03:52.25,2:03:53.59,Default,,0,0,0,,Өткен мамырда мен лорд Кусунокиге таңғалғаным сонша, таяқшаларымды тастап кеттім.
Dialogue: 0,2:03:53.59,2:03:55.46,Default,,0,0,0,,Өткен мамырда мен лорд Кусунокиден таң қалып, таяқшаларымды тастап кеттім.
Dialogue: 0,2:03:53.59,2:03:55.46,Default,,0,0,0,,Өткен тамызда...
Dialogue: 0,2:03:55.46,2:03:55.59,Default,,0,0,0,,Өткен мамырда мен лорд Кусунокиге таңғалғаным сонша, таяқшаларымды тастап кеттім.
Dialogue: 0,2:03:55.59,2:03:56.97,Default,,0,0,0,,Өткен мамырда мен лорд Кусунокиге таңғалғаным сонша, таяқшаларымды түсіріп алдым.
Dialogue: 0,2:03:55.59,2:03:56.97,Default,,0,0,0,,Өткен сәуірде...
Dialogue: 0,2:03:56.97,2:03:57.47,Default,,0,0,0,,Өткен мамырда мен лорд Кусунокиге таңғалғаным сонша, таяқшаларымды тастап кеттім.
Dialogue: 0,2:03:57.59,2:03:59.22,Default,,0,0,0,,Өткен жылдың ақпан айында...
Dialogue: 0,2:03:57.59,2:03:59.22,Default,,0,0,0,,Өткен наурызда... Оң қолыма туған жерім сызылған...
Dialogue: 0,2:03:59.22,2:04:00.26,Default,,0,0,0,,Өткен наурызда... туған жерім оң қолыма сызылған...
Dialogue: 0,2:04:00.26,2:04:01.60,Default,,0,0,0,,Өткен наурызда... Оң қолыма туған жерім сызылған...
Dialogue: 0,2:04:00.26,2:04:01.60,Default,,0,0,0,,Жыл соңында...
Dialogue: 0,2:04:01.60,2:04:02.01,Default,,0,0,0,,Өткен наурызда... Оң қолыма туған жерім сызылған...
Dialogue: 0,2:04:02.14,2:04:04.52,Default,,0,0,0,,Норисуки жақсы көретін оң қол...
Dialogue: 0,2:04:05.39,2:04:10.10,Default,,0,0,0,,Жеті жыл бұрын ақпан айында менің оң қолым көптеген қояндарды салды.
Dialogue: 0,2:04:11.86,2:04:13.90,Default,,0,0,0,,Әпке, мен көре алмадым.
Dialogue: 0,2:04:14.02,2:04:16.69,Default,,0,0,0,,Бұл үлкен мәселе болды, Сузу-чан.
Dialogue: 0,2:04:17.40,2:04:20.78,Default,,0,0,0,,Суми-чан, келгеніңе рахмет.
Dialogue: 0,2:04:20.91,2:04:22.70,Default,,0,0,0,,Әскер офицері
Dialogue: 0,2:04:22.83,2:04:26.08,Default,,0,0,0,,Маған құтқару көлігіне мінгізіңізші.
Dialogue: 0,2:04:27.33,2:04:28.91,Default,,0,0,0,,Не? Иә
Dialogue: 0,2:04:29.04,2:04:31.54,Default,,0,0,0,,Иә, ескі киім таза мақта.
Dialogue: 0,2:04:31.67,2:04:33.25,Default,,0,0,0,,Құрамында суфу жоқ па? ‬
Dialogue: 0,2:04:33.38,2:04:35.05,Default,,0,0,0,,Иә, ол бұзылған.
Dialogue: 0,2:04:35.17,2:04:36.38,Default,,0,0,0,,Уау
Dialogue: 0,2:04:36.51,2:04:39.05,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,2:04:48.98,2:04:50.56,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,2:04:54.82,2:04:59.32,Default,,0,0,0,,Бұл Еба тауынан жиналған локаттар.
Dialogue: 0,2:04:59.45,2:05:01.28,Default,,0,0,0,,Жақсысың ба? ‬
Dialogue: 0,2:05:01.41,2:05:05.16,Default,,0,0,0,,Орнымнан тұрмасам, жалқау боламын, сондықтан мен сені жарты жолға жіберемін.
Dialogue: 0,2:05:05.28,2:05:08.33,Default,,0,0,0,,Өрт сөндіру бекетінің алдында кездесейік.
Dialogue: 0,2:05:08.45,2:05:11.46,Default,,0,0,0,,Хойжа Өзен жағасындағы мұнара – көрнекті орын
Dialogue: 0,2:05:11.58,2:05:13.75,Default,,0,0,0,,Жоқ, ол да күйіп кеткен.
Dialogue: 0,2:05:13.88,2:05:15.75,Default,,0,0,0,,Әлі тұр
Dialogue: 0,2:05:15.88,2:05:19.05,Default,,0,0,0,,Келсем офицерді көріп шошып кеттім.
Dialogue: 0,2:05:19.17,2:05:22.13,Default,,0,0,0,,Жас болса да мейірімді адам емес.
Dialogue: 0,2:05:22.26,2:05:25.10,Default,,0,0,0,,Сіз маған бұрыннан тамақ билетін бердіңіз.
Dialogue: 0,2:05:25.22,2:05:30.43,Default,,0,0,0,,Күреге тұрмысқа шыққан үлкен әпкем бар, соны есіңе түсір.
Dialogue: 0,2:05:30.56,2:05:31.89,Default,,0,0,0,,Сізге ұнады деп ойлаймын.
Dialogue: 0,2:05:32.02,2:05:34.86,Default,,0,0,0,,О, тәңірім Сузу-чан
Dialogue: 0,2:05:35.61,2:05:36.40,Default,,0,0,0,,Atta
Dialogue: 0,2:05:40.11,2:05:41.82,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,2:05:49.20,2:05:50.96,Default,,0,0,0,,(Ер адам) А... Жарайды.
Dialogue: 0,2:05:53.50,2:05:57.67,Default,,0,0,0,,Әуе шабуылдарынан Күрені аяма.
Dialogue: 0,2:05:58.59,2:06:03.01,Default,,0,0,0,,Егер мен үйге күтім жасай алмасам, үйге жету қиынға соғатын еді.
Dialogue: 0,2:06:05.43,2:06:07.10,Default,,0,0,0,,Сәлем, Сузу-чан
Dialogue: 0,2:06:07.68,2:06:10.31,Default,,0,0,0,,Хиросимаға қайту.
Dialogue: 0,2:06:10.43,2:06:11.39,Default,,0,0,0,,А...
Dialogue: 0,2:06:11.52,2:06:13.27,Default,,0,0,0,,Қорқынышты әуе шабуылдары жоқ.
Dialogue: 0,2:06:13.39,2:06:18.19,Default,,0,0,0,,Онии-чан жоқ, бұзақылар да жоқ.
Dialogue: 0,2:06:20.82,2:06:22.53,Default,,0,0,0,,Жоқ
Dialogue: 0,2:06:23.53,2:06:27.37,Default,,0,0,0,,Суми-чанның офицері сымбатты ма, жоқ па, соған қарап шешім қабылдамауым керек деп ойлаймын.
Dialogue: 0,2:06:27.49,2:06:29.83,Default,,0,0,0,,Иә, бұл таза емес.
Dialogue: 0,2:06:29.95,2:06:32.33,Default,,0,0,0,,Өтірік, өтірік Онда кездескенше
Dialogue: 0,2:06:32.45,2:06:33.37,Default,,0,0,0,,Бұрмаланған
Dialogue: 0,2:06:33.50,2:06:36.38,Default,,0,0,0,,Иә, бұл жай ғана ой деп ойлаймын.
Dialogue: 0,2:06:36.50,2:06:39.55,Default,,0,0,0,,Келесі айдың 6-сы Энами фестивалі болады.
Dialogue: 0,2:06:39.67,2:06:41.38,Default,,0,0,0,,Тезірек үйге келіңізші.
Dialogue: 0,2:06:41.51,2:06:43.84,Default,,0,0,0,,Рахмет, Суми Чан
Dialogue: 0,2:06:43.97,2:06:46.68,Default,,0,0,0,,Мен Онии-чанның қайтыс болғанына қуаныштымын.
Dialogue: 0,2:06:47.72,2:06:49.51,Default,,0,0,0,,Бұрмаланған біздер.
Dialogue: 0,2:06:50.14,2:06:52.68,Default,,0,0,0,,Сол қолмен салынған сурет сияқты
Dialogue: 0,2:06:56.10,2:07:02.40,Default,,0,0,0,,(Дабыл)
Dialogue: 0,2:07:19.63,2:07:20.50,Default,,0,0,0,,Ах...
Dialogue: 0,2:07:33.10,2:07:38.06,Default,,0,0,0,,(Ескерту)
Dialogue: 0,2:07:40.36,2:07:41.36,Default,,0,0,0,,(Қайжы) Әй, мен де бүгін келдім.
Dialogue: 0,2:07:41.48,2:07:44.99,Default,,0,0,0,,Ки тағы да ырылдайтын сияқты. Затыңызды әкеліңіз.
Dialogue: 0,2:07:45.11,2:07:46.24,Default,,0,0,0,,(Қайжы) Иә, солай.
Dialogue: 0,2:07:46.36,2:07:48.66,Default,,0,0,0,,Сузу-сан, алға.
Dialogue: 0,2:07:51.03,2:07:52.37,Default,,0,0,0,,(Геронның айқайы)
Dialogue: 0,2:07:53.08,2:07:54.04,Default,,0,0,0,,Ах...
Dialogue: 0,2:07:56.16,2:07:57.12,Default,,0,0,0,,Келме
Dialogue: 0,2:07:59.33,2:08:01.54,Default,,0,0,0,,Енді мұнда келуге болмайды.
Dialogue: 0,2:08:03.46,2:08:04.34,Default,,0,0,0,,Ах...
Dialogue: 0,2:08:11.89,2:08:14.81,Default,,0,0,0,,Содан кейін сол жаққа дейін қашыңыз.
Dialogue: 0,2:08:15.39,2:08:18.23,Default,,0,0,0,,Таудан өткеннен кейін Хиросимаға жетесіз.
Dialogue: 0,2:08:18.35,2:08:23.19,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,2:08:28.45,2:08:31.20,Default,,0,0,0,,(бомба дыбысы)
Dialogue: 0,2:08:32.66,2:08:33.49,Default,,0,0,0,,Ах
Dialogue: 0,2:08:50.68,2:08:52.05,Default,,0,0,0,,(Шусаку) Сіз өлуді жоспарлап отырсыз ба?
Dialogue: 0,2:08:52.93,2:08:54.14,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,2:08:54.26,2:08:57.43,Default,,0,0,0,,Құлтан... Құтан ұшып кетті.
Dialogue: 0,2:08:57.56,2:09:00.48,Default,,0,0,0,,(Шусаку) Әй, ол жағадан қашып кеткен шығар.
Dialogue: 0,2:09:01.65,2:09:04.11,Default,,0,0,0,,Шусаку мырза
Dialogue: 0,2:09:04.77,2:09:06.40,Default,,0,0,0,,Хиросимаға қайту
Dialogue: 0,2:09:06.53,2:09:08.11,Default,,0,0,0,,(ұшу дыбысы)
Dialogue: 0,2:09:10.90,2:09:12.61,Default,,0,0,0,,(Шусаку) Қайтуды жоспарлап жүрсіз бе?
Dialogue: 0,2:09:14.20,2:09:15.78,Default,,0,0,0,,Қолдарыңыз үшін алаңдайсыз ба? ‬
Dialogue: 0,2:09:16.83,2:09:18.41,Default,,0,0,0,,Сіз әуе шабуылынан қорқасыз ба? ‬
Dialogue: 0,2:09:19.16,2:09:20.12,Default,,0,0,0,,Сіз Харуми туралы айтып отырсыз ба? ‬
Dialogue: 0,2:09:20.25,2:09:24.13,Default,,0,0,0,,Иә, иә, барлығы.
Dialogue: 0,2:09:24.71,2:09:25.71,Default,,0,0,0,,Мен сізді естімеймін! ‬
Dialogue: 0,2:09:25.84,2:09:26.92,Default,,0,0,0,,Жоқ! ‬
Dialogue: 0,2:09:28.51,2:09:29.92,Default,,0,0,0,,Сонда неге?
Dialogue: 0,2:09:31.59,2:09:33.18,Default,,0,0,0,,Сузу-сан
Dialogue: 0,2:09:33.30,2:09:36.68,Default,,0,0,0,,Мен өткен бір жарым жылды көңілді өткіздім.
Dialogue: 0,2:09:36.81,2:09:38.85,Default,,0,0,0,,Үйіңізге қайтыңыз.
Dialogue: 0,2:09:38.97,2:09:42.64,Default,,0,0,0,,Мен сенімен бірге жүремін, мен сенімен сөйлесемін.
Dialogue: 0,2:09:44.27,2:09:48.15,Default,,0,0,0,,Сіз басқашасыз ба? Осы уақыт бойы мен оны білмеген сияқтымын ба? ‬
Dialogue: 0,2:09:51.28,2:09:52.36,Default,,0,0,0,,Мен сізді естімеймін
Dialogue: 0,2:09:53.41,2:09:56.24,Default,,0,0,0,,Мен естімеймін, естімеймін, мен ештеңе естімеймін
Dialogue: 0,2:09:56.37,2:09:59.66,Default,,0,0,0,,Қайту Қайту Хиросимаға қайту! ‬
Dialogue: 0,2:09:59.79,2:10:00.95,Default,,0,0,0,,(Шусаку) Ой, түсіндім! ‬
Dialogue: 0,2:10:02.04,2:10:03.29,Default,,0,0,0,,Қалағаныңды істе
Dialogue: 0,2:10:16.55,2:10:19.85,Default,,0,0,0,,(Радио: Әйел) Қытай әскери округінде аспанда жау ұшағы жоқ.
Dialogue: 0,2:10:19.97,2:10:23.14,Default,,0,0,0,,Қытайдың әскери аймағында аспанда жау ұшағы жоқ
Dialogue: 0,2:10:23.27,2:10:26.15,Default,,0,0,0,,Хиросима префектурасының ауданы 7:31
Dialogue: 0,2:10:26.27,2:10:28.82,Default,,0,0,0,,Ескерту ескертуі жойылды
Dialogue: 0,2:10:30.40,2:10:32.65,Default,,0,0,0,,Ол дер кезінде жойылды.
Dialogue: 0,2:10:32.78,2:10:34.40,Default,,0,0,0,,(Кобаяши) Эй, мен сонда боламын.
Dialogue: 0,2:10:34.53,2:10:36.70,Default,,0,0,0,,(Кобаяшидің әйелі) Ой, қош келдіңіз.
Dialogue: 0,2:10:37.82,2:10:40.87,Default,,0,0,0,,Айтатата…
Dialogue: 0,2:10:40.99,2:10:42.62,Default,,0,0,0,,Әділ
Dialogue: 0,2:10:42.75,2:10:46.00,Default,,0,0,0,,Жаса, таңнан бері ыстық.
Dialogue: 0,2:10:47.71,2:10:52.46,Default,,0,0,0,,Сузу-сан кеткенде жалғыздық.
Dialogue: 0,2:11:08.52,2:11:09.48,Default,,0,0,0,,‪（）‬
Dialogue: 0,2:11:12.36,2:11:14.70,Default,,0,0,0,,Қай уақыттан бастап? ‬
Dialogue: 0,2:11:14.82,2:11:16.53,Default,,0,0,0,,үшін? (Гуйжи) ауруханасы
Dialogue: 0,2:11:17.45,2:11:20.20,Default,,0,0,0,,Ха, сағат 10 шамасында.
Dialogue: 0,2:11:23.20,2:11:25.58,Default,,0,0,0,,(Кайко) Хаа... Бұлай киінуге болмайды.
Dialogue: 0,2:11:27.04,2:11:27.88,Default,,0,0,0,,Иә
Dialogue: 0,2:11:37.01,2:11:39.39,Default,,0,0,0,,Кешіріңіз, мм...
Dialogue: 0,2:11:40.47,2:11:43.35,Default,,0,0,0,,А... бұл кір емес еді.
Dialogue: 0,2:11:45.06,2:11:48.56,Default,,0,0,0,,(Киоко) Бүгін сенің ауылыңның мерекесі.
Dialogue: 0,2:11:49.52,2:11:50.77,Default,,0,0,0,,Иә
Dialogue: 0,2:11:50.90,2:11:56.78,Default,,0,0,0,,Мен демалыс күні үйге баруды жоспарлап едім, бірақ мен бүгін ғана ауруханаға жазыла аламын.
Dialogue: 0,2:12:00.45,2:12:01.49,Default,,0,0,0,,Қараңыз.
Dialogue: 0,2:12:01.62,2:12:02.95,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,2:12:04.29,2:12:06.37,Default,,0,0,0,,(Кейзи) Бәрібір уақытында үлгермейміз.
Dialogue: 0,2:12:06.91,2:12:08.96,Default,,0,0,0,,Дәрігерлер бос емес болса да.
Dialogue: 0,2:12:09.67,2:12:13.67,Default,,0,0,0,,Менің ойымша, мен Хиросимадағы ауруханаға кіріспе хат жазуым керек.
Dialogue: 0,2:12:14.34,2:12:17.26,Default,,0,0,0,,Даиичи Мен пойызға билет ала алмай жүрмін.
Dialogue: 0,2:12:19.34,2:12:20.14,Default,,0,0,0,,Иә
Dialogue: 0,2:12:20.26,2:12:24.47,Default,,0,0,0,,Мен апамның таза мақтасын жөндеуге Монпеге бардым.
Dialogue: 0,2:12:24.60,2:12:27.10,Default,,0,0,0,,Серпімді сым арқылы бір адамға киюге болады.
Dialogue: 0,2:12:27.23,2:12:29.98,Default,,0,0,0,,Резеңкенің шатасып кеткені өкінішті.
Dialogue: 0,2:12:30.10,2:12:33.23,Default,,0,0,0,,Ах... Рахмет.
Dialogue: 0,2:12:36.90,2:12:41.41,Default,,0,0,0,,Өте өкінішті, мен сені Харумидің өліміне кінәлаймын.
Dialogue: 0,2:12:42.32,2:12:43.12,Default,,0,0,0,,№
Dialogue: 0,2:12:45.49,2:12:48.08,Default,,0,0,0,,(Кейзи) Сүйген адамым ерте қайтыс болды.
Dialogue: 0,2:12:48.62,2:12:50.96,Default,,0,0,0,,Эвакуация кезінде дүкен де жойылды.
Dialogue: 0,2:12:51.92,2:12:53.88,Default,,0,0,0,,Мен енді балаларымды көре алмаймын.
Dialogue: 0,2:12:54.88,2:12:57.71,Default,,0,0,0,,Қандай жағдай болмасын, бұл сен таңдаған жолдың соңы.
Dialogue: 0,2:12:59.68,2:13:01.39,Default,,0,0,0,,Осы орайда, сіз
Dialogue: 0,2:13:01.51,2:13:04.18,Default,,0,0,0,,Айналаңыздағылар айтқандай жасап, бейтаныс адамға үйленіңіз
Dialogue: 0,2:13:04.30,2:13:06.22,Default,,0,0,0,,Жұмыс істеуге мәжбүрлеу
Dialogue: 0,2:13:07.72,2:13:10.73,Default,,0,0,0,,Бұл қызықсыз өмір деп ойлаймын.
Dialogue: 0,2:13:15.27,2:13:19.57,Default,,0,0,0,,Сузу-санның тұрған жері осында немесе кез келген жерде болуы мүмкін.
Dialogue: 0,2:13:19.70,2:13:22.74,Default,,0,0,0,,Ешқандай әбігерге түспей өзіңіз шешіңіз
Dialogue: 0,2:13:32.08,2:13:33.13,Default,,0,0,0,,(Suzu/Keiko) Иә? ‬
Dialogue: 0,2:13:34.21,2:13:37.17,Default,,0,0,0,,(Кобаяшидің әйелі) Кейко-чан, дәл қазір бірдеңе жарқ етті ме?
Dialogue: 0,2:13:37.30,2:13:38.55,Default,,0,0,0,,Жарқыраған
Dialogue: 0,2:13:39.21,2:13:42.30,Default,,0,0,0,,Күн күркіреді ме? Иә, ауа-райы.
Dialogue: 0,2:13:42.43,2:13:44.55,Default,,0,0,0,,Мм... мен күткенім осы болды.
Dialogue: 0,2:13:45.01,2:13:46.93,Default,,0,0,0,,Маған жууға бола ма?
Dialogue: 0,2:13:48.10,2:13:50.77,Default,,0,0,0,,Өйткені
Dialogue: 0,2:13:50.89,2:13:52.69,Default,,0,0,0,,Сіз осында келе аласыз ба?
Dialogue: 0,2:13:52.81,2:13:57.19,Default,,0,0,0,,Әй, түсіндім, түсіндім, бірақ кет, ыстық.
Dialogue: 0,2:14:06.70,2:14:08.45,Default,,0,0,0,,Не? Қазіргісі
Dialogue: 0,2:14:08.58,2:14:10.87,Default,,0,0,0,,(шу дыбысы)
Dialogue: 0,2:14:11.00,2:14:13.79,Default,,0,0,0,,(Мейко) Мен Джофктан ештеңе естімеймін.
Dialogue: 0,2:14:13.92,2:14:15.08,Default,,0,0,0,,Басқалар туралы не деуге болады? ‬
Dialogue: 0,2:14:15.21,2:14:16.04,Default,,0,0,0,,(Entaro) Сәлем
Dialogue: 0,2:14:16.17,2:14:16.96,Default,,0,0,0,,(диази) га
Dialogue: 0,2:14:17.09,2:14:19.05,Default,,0,0,0,,Келіңіз және қараңыз.
Dialogue: 0,2:14:23.05,2:14:24.97,Default,,0,0,0,,(Кобаяшидің әйелі) Не? Бұл бұлт
Dialogue: 0,2:14:25.09,2:14:26.85,Default,,0,0,0,,(Мейко) Иә? Ах...
Dialogue: 0,2:14:26.97,2:14:28.22,Default,,0,0,0,,Бұлттар? ‬
Dialogue: 0,2:14:28.89,2:14:32.23,Default,,0,0,0,,Бұл үлкен бұлт, Канатоко бұлты.
Dialogue: 0,2:14:33.06,2:14:38.23,Default,,0,0,0,,(Радио: Ер) Бұл Окаяма хабар тарату станциясы немесе Хиросима хабар тарату станциясы ма? Хиросима хабар тарату станциясы? ‬
Dialogue: 0,2:14:38.36,2:14:40.15,Default,,0,0,0,,Бұл Окаяма хабар тарату станциясы
Dialogue: 0,2:14:40.28,2:14:45.36,Default,,0,0,0,,(Әйел) Жоқ, мен бірдеңені түсіріп алдым деп ойладым, бірақ ол Хиросимадағы дөңгелек тақта болып шықты.
Dialogue: 0,2:14:50.95,2:14:52.50,Default,,0,0,0,,(Әйелдер) Ах...
Dialogue: 0,2:14:52.62,2:14:56.37,Default,,0,0,0,,Қолдарыңыз бос болса, Ринпоканға кейінірек тоқтаңыз.
Dialogue: 0,2:14:56.50,2:15:00.38,Default,,0,0,0,,(Кобаяшидің әйелі) Чита медбике болды ма?
Dialogue: 0,2:15:00.50,2:15:03.97,Default,,0,0,0,,(Чита) Ха, мен бұрын ешқашан зори сандалдарын жасаған емеспін.
Dialogue: 0,2:15:04.09,2:15:06.13,Default,,0,0,0,,(Гуйжи) Мұндағылардың бәрі сондай.
Dialogue: 0,2:15:06.26,2:15:08.10,Default,,0,0,0,,Келе аласыз ба?
Dialogue: 0,2:15:08.93,2:15:12.27,Default,,0,0,0,,А, мен енді бір қолмен қозғала алмаймын, тістерім нашар.
Dialogue: 0,2:15:12.39,2:15:13.81,Default,,0,0,0,,Сонда бұл сізге ұнамайды ма?
Dialogue: 0,2:15:14.39,2:15:16.94,Default,,0,0,0,,Әй, мына сандалдарды не істейсің? ‬
Dialogue: 0,2:15:17.06,2:15:18.27,Default,,0,0,0,,(Чита) Хиросимаға.
Dialogue: 0,2:15:18.40,2:15:21.02,Default,,0,0,0,,Өткен айдағы әуе шабуылындағыдай жолдар еріп кетсе.
Dialogue: 0,2:15:21.15,2:15:23.19,Default,,0,0,0,,Аяқ киім немесе аяқ киім жоқ
Dialogue: 0,2:15:23.90,2:15:25.32,Default,,0,0,0,,Біз де бара аламыз ба? ‬
Dialogue: 0,2:15:25.45,2:15:26.86,Default,,0,0,0,,(Чита) Зардап шеккендер жоқ
Dialogue: 0,2:15:26.99,2:15:30.28,Default,,0,0,0,,Менің ұлымды солдаттар Хиросимаға алып кетті.
Dialogue: 0,2:15:30.41,2:15:32.79,Default,,0,0,0,,(Чита) Эй, сен ертең жүк көлігіне мінесің бе? ‬
Dialogue: 0,2:15:32.91,2:15:36.33,Default,,0,0,0,,Куреге әуе шабуылы кезінде Хиросима құтқарылды!
Dialogue: 0,2:15:36.46,2:15:38.17,Default,,0,0,0,,Мен саған өтеуім керек... Ах...
Dialogue: 0,2:15:39.33,2:15:40.38,Default,,0,0,0,,Ах
Dialogue: 0,2:15:41.00,2:15:44.55,Default,,0,0,0,,Бұл сізді байлау қиындығынан құтқарады, сондықтан мен сізді алаңдатпаймын.
Dialogue: 0,2:15:44.67,2:15:45.51,Default,,0,0,0,,Барыңыз
Dialogue: 0,2:15:46.38,2:15:48.26,Default,,0,0,0,,Қайтадан ақымақ бол
Dialogue: 0,2:15:48.39,2:15:50.22,Default,,0,0,0,,Тез, үйге барып, кесіп алайық.
Dialogue: 0,2:15:50.35,2:15:54.52,Default,,0,0,0,,(Кобаяшидің әйелі) Менің отбасым да жақында Хиросимаға барады.
Dialogue: 0,2:15:54.64,2:15:57.02,Default,,0,0,0,,Хиросимаға бомбаның жаңа түрі тасталған көрінеді.
Dialogue: 0,2:15:57.14,2:15:58.81,Default,,0,0,0,,Иә
Dialogue: 0,2:15:58.94,2:16:00.23,Default,,0,0,0,,Сузу-сан жарайды...
Dialogue: 0,2:16:00.36,2:16:01.44,Default,,0,0,0,,Ана
Dialogue: 0,2:16:02.77,2:16:06.53,Default,,0,0,0,,Жеңілдік әскери базадан келеді, сондықтан...
Dialogue: 0,2:16:12.24,2:16:13.20,Default,,0,0,0,,Хмм...
Dialogue: 0,2:16:16.66,2:16:19.17,Default,,0,0,0,,Сіз де Хиросимадан келдіңіз.
Dialogue: 0,2:16:34.35,2:16:37.06,Default,,0,0,0,,(Чита) Отырып өлмейсің.
Dialogue: 0,2:16:37.18,2:16:39.52,Default,,0,0,0,,(Кария) Хиросимадан осы жерге дейін жаяу келдім.
Dialogue: 0,2:16:39.64,2:16:42.69,Default,,0,0,0,,(Домото) А... Кім екенін білмеймін.
Dialogue: 0,2:16:42.81,2:16:44.86,Default,,0,0,0,,Беті де, киімі де жабылған
Dialogue: 0,2:16:44.98,2:16:47.15,Default,,0,0,0,,(Қария) Тыныш, Қожоның әйеліне мынаны айт.
Dialogue: 0,2:16:47.28,2:16:50.86,Default,,0,0,0,,(Домото) Мен ол баланың түрін көрмеймін, оны аяймын.
Dialogue: 0,2:16:50.99,2:16:51.95,Default,,0,0,0,,(Чита) Ха...
Dialogue: 0,2:16:53.74,2:16:56.20,Default,,0,0,0,,Эвкалипт жапырақтары көктеп шықты.
Dialogue: 0,2:16:56.33,2:16:58.29,Default,,0,0,0,,Масалардан қорғау үшін қолданыңыз
Dialogue: 0,2:16:59.33,2:17:01.08,Default,,0,0,0,,Рахмет
Dialogue: 0,2:17:01.21,2:17:02.88,Default,,0,0,0,,Сергек болыңыз
Dialogue: 0,2:17:03.00,2:17:05.00,Default,,0,0,0,,Иә, келіңіз...
Dialogue: 0,2:17:05.13,2:17:08.34,Default,,0,0,0,,Энамиден келген Юро Урано Суми Кисено
Dialogue: 0,2:17:08.46,2:17:09.38,Default,,0,0,0,,(Чита) Иә.
Dialogue: 0,2:17:09.51,2:17:12.97,Default,,0,0,0,,Ито Морита Кусацу Марина Чизуко
Dialogue: 0,2:17:15.01,2:17:19.81,Default,,0,0,0,,Мен де қатты дірілдегім келеді, Ақырын, қыңыр қарқылғым келеді
Dialogue: 0,2:17:19.94,2:17:22.31,Default,,0,0,0,,Осы қаланың адамдары сияқты
Dialogue: 0,2:17:22.44,2:17:24.48,Default,,0,0,0,,О, бұл шулы.
Dialogue: 0,2:17:24.61,2:17:27.11,Default,,0,0,0,,Мұндай зорлық-зомбылыққа кім көнеді?
Dialogue: 0,2:17:28.36,2:17:31.49,Default,,0,0,0,,Өтінемін, осында мәңгі келіңіз.
Dialogue: 0,2:17:33.16,2:17:34.91,Default,,0,0,0,,Мені алаңдатыңыз
Dialogue: 0,2:17:35.03,2:17:36.53,Default,,0,0,0,,Ақымақ! ‬
Dialogue: 0,2:17:36.66,2:17:39.50,Default,,0,0,0,,Идиот ақымақ ақымақ...
Dialogue: 0,2:17:39.62,2:17:40.96,Default,,0,0,0,,Кешіріңіз (Шусаку) Ах.
Dialogue: 0,2:17:42.46,2:17:44.08,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,2:17:44.21,2:17:45.88,Default,,0,0,0,,Мен шынымен кешірім сұраймын.
Dialogue: 0,2:17:46.59,2:17:47.54,Default,,0,0,0,,Кешіріңіз (Шусаку) Ах.
Dialogue: 0,2:17:48.26,2:17:50.17,Default,,0,0,0,,(Шусаку) Біреуін де алмайсың.
Dialogue: 0,2:17:50.30,2:17:52.72,Default,,0,0,0,,Теңіз жаяу әскері мені тағы да қорқытады деп ойлаймын.
Dialogue: 0,2:17:53.97,2:17:57.89,Default,,0,0,0,,Сузу-сан, егер сіз АҚШ әскерінен оқиғаны алсаңыз, оны жеткізуіңіз керек.
Dialogue: 0,2:17:58.01,2:18:00.27,Default,,0,0,0,,Әскери полиция маған тағы ұрысты.
Dialogue: 0,2:18:00.85,2:18:03.35,Default,,0,0,0,,Жеткізсең де тек күйіп қалады.
Dialogue: 0,2:18:03.48,2:18:05.81,Default,,0,0,0,,Оны осылай ысқылап, тамшы қағазға айналдырған дұрыс.
Dialogue: 0,2:18:05.94,2:18:07.52,Default,,0,0,0,,Өте көп қалдықтар
Dialogue: 0,2:18:07.65,2:18:09.23,Default,,0,0,0,,Сірә
Dialogue: 0,2:18:09.36,2:18:12.15,Default,,0,0,0,,Әзірге дәретхана ешкімге қарызға берілмейді.
Dialogue: 0,2:18:12.28,2:18:16.24,Default,,0,0,0,,Біздің шайқас - қолымызда бар нәрсені пайдалана отырып өмір сүруді жалғастыру.
Dialogue: 0,2:18:16.37,2:18:17.33,Default,,0,0,0,,(Шусаку) Иә?
Dialogue: 0,2:18:18.16,2:18:19.91,Default,,0,0,0,,А, өтінемін, көтеріліңіз.
Dialogue: 0,2:18:20.04,2:18:21.33,Default,,0,0,0,,(Кария/Домото) Сәлем.
Dialogue: 0,2:18:21.45,2:18:24.92,Default,,0,0,0,,(Радио: Император) Ұрыс даласында қаза тауып, борышын өтеу кезінде қаза тапты.
Dialogue: 0,2:18:25.04,2:18:30.80,Default,,0,0,0,,Қайтыс болғандар мен жақындары туралы ойлар.
Dialogue: 0,2:18:30.92,2:18:32.34,Default,,0,0,0,,Гонайдың көз жасы
Dialogue: 0,2:18:32.46,2:18:37.05,Default,,0,0,0,,Соғыста жараланып, апатқа ұшыраған.
Dialogue: 0,2:18:37.18,2:18:40.18,Default,,0,0,0,,Отбасылық кәсіптен айырылғандардың амандығы үшін...
Dialogue: 0,2:18:40.31,2:18:44.60,Default,,0,0,0,,Төзгісізге шыдаңыз Төзгісізге шыдаңыз
Dialogue: 0,2:18:44.73,2:18:46.86,Default,,0,0,0,,Барлық жастағы адамдар үшін...
Dialogue: 0,2:18:46.98,2:18:49.94,Default,,0,0,0,,(Радио: Ер) Біз ұлы мәртебелі императордың дауысын кішіпейілділікпен тыңдаймыз...
Dialogue: 0,2:18:50.07,2:18:52.32,Default,,0,0,0,,(Киязи) Хаа... болды, бітті
Dialogue: 0,2:18:52.44,2:18:53.65,Default,,0,0,0,,Сонымен...
Dialogue: 0,2:18:53.78,2:18:56.53,Default,,0,0,0,,Бұл сіздің жеңіліп қалдыңыз дегенді білдіре ме? ‬
Dialogue: 0,2:18:56.66,2:18:57.66,Default,,0,0,0,,Неліктен? ‬
Dialogue: 0,2:18:57.78,2:19:01.04,Default,,0,0,0,,Хиросима мен Нагасакиге жаңа бомбалар тасталды.
Dialogue: 0,2:19:01.16,2:19:05.08,Default,,0,0,0,,Соғысқа Кеңес Одағы да қосылды, сондықтан бұл үлкен мәселе емес.
Dialogue: 0,2:19:05.79,2:19:08.67,Default,,0,0,0,,Сіз бұған дайын емессіз бе?
Dialogue: 0,2:19:08.79,2:19:11.96,Default,,0,0,0,,Ең соңғы адамға дейін шайқаспас па едің?
Dialogue: 0,2:19:12.09,2:19:14.47,Default,,0,0,0,,Мұнда әлі бес адам бар.
Dialogue: 0,2:19:14.59,2:19:18.64,Default,,0,0,0,,Сол қолым мен екі аяғым болса да.
Dialogue: 0,2:19:18.76,2:19:21.26,Default,,0,0,0,,Уф! аа! Уф! ‬
Dialogue: 0,2:19:22.77,2:19:25.94,Default,,0,0,0,,(Кейзидің жылаған дауысы)
Dialogue: 0,2:19:26.06,2:19:27.73,Default,,0,0,0,,(Кейко) Харуми…
Dialogue: 0,2:19:27.85,2:19:30.23,Default,,0,0,0,,Ух... Харуми...
Dialogue: 0,2:19:37.32,2:19:41.33,Default,,0,0,0,,Біздің өткеніміз ұшып барады
Dialogue: 0,2:19:41.45,2:19:44.41,Default,,0,0,0,,Менің ойлағаным дұрыс болды
Dialogue: 0,2:19:44.54,2:19:47.21,Default,,0,0,0,,Сондықтан мен өзімді ұстауға тырыстым
Dialogue: 0,2:19:48.88,2:19:53.55,Default,,0,0,0,,Ах... теңіздің арғы жағындағы күріш пен соя.
Dialogue: 0,2:19:53.67,2:19:57.09,Default,,0,0,0,,Менің ойымша, біз осындай нәрсені жасай аламыз.
Dialogue: 0,2:19:58.13,2:20:01.01,Default,,0,0,0,,Зорлық-зомбылыққа берілу керек емес пе?
Dialogue: 0,2:20:01.14,2:20:03.10,Default,,0,0,0,,(жылау)
Dialogue: 0,2:20:03.22,2:20:07.23,Default,,0,0,0,,А-а... Ештеңені ойламаймын, сасқалақтап қаламын
Dialogue: 0,2:20:07.35,2:20:09.44,Default,,0,0,0,,Менің өлгім келді
Dialogue: 0,2:20:09.56,2:20:11.94,Default,,0,0,0,,(жылау)
Dialogue: 0,2:20:21.99,2:20:23.33,Default,,0,0,0,,Ақыры келгенде
Dialogue: 0,2:20:23.45,2:20:26.25,Default,,0,0,0,,Соңында, менің ойымша, біз мұны тек сол үшін жасадық.
Dialogue: 0,2:20:28.16,2:20:30.75,Default,,0,0,0,,Бүгін барлығын араластырып пісірейік.
Dialogue: 0,2:20:30.88,2:20:32.96,Default,,0,0,0,,Барлығы емес
Dialogue: 0,2:20:33.09,2:20:36.76,Default,,0,0,0,,Әлі ертең және одан кейінгі күн бар.
Dialogue: 0,2:20:40.09,2:20:41.47,Default,,0,0,0,,Ах (Мейко) Ах...
Dialogue: 0,2:20:42.43,2:20:45.77,Default,,0,0,0,,15 және 16 тамыз
Dialogue: 0,2:20:47.93,2:20:49.31,Default,,0,0,0,,17-ші
Dialogue: 0,2:20:50.90,2:20:52.15,Default,,0,0,0,,Сондай-ақ қыркүйекте
Dialogue: 0,2:20:53.40,2:20:54.48,Default,,0,0,0,,қазан
Dialogue: 0,2:20:55.36,2:20:57.28,Default,,0,0,0,,Қарашада да, келесі жылы да
Dialogue: 0,2:20:58.28,2:21:00.78,Default,,0,0,0,,Келесі жыл және 10 жылдан кейін
Dialogue: 0,2:21:02.24,2:21:03.78,Default,,0,0,0,,мәңгілік
Dialogue: 0,2:21:12.33,2:21:13.46,Default,,0,0,0,,(2 адам) Уау.
Dialogue: 0,2:21:14.42,2:21:18.26,Default,,0,0,0,,(Энтаро) Аа, бұл таза ақ, жарқыраған.
Dialogue: 0,2:21:18.38,2:21:20.34,Default,,0,0,0,,Гарнир бәріне жарайды.
Dialogue: 0,2:21:20.47,2:21:23.09,Default,,0,0,0,,Шусаку ше? ‬
Dialogue: 0,2:21:23.22,2:21:24.39,Default,,0,0,0,,Әлі жоқ
Dialogue: 0,2:21:24.51,2:21:29.43,Default,,0,0,0,,Осы кезде тәртіпті сақтау заңгердің міндеті ме?
Dialogue: 0,2:21:29.56,2:21:30.85,Default,,0,0,0,,Алдымен соны алайық.
Dialogue: 0,2:21:33.52,2:21:36.57,Default,,0,0,0,,Ешқандай бомба түспейді, сондықтан балық қалмайды.
Dialogue: 0,2:21:36.69,2:21:38.53,Default,,0,0,0,,Ол кезде емес
Dialogue: 0,2:21:38.65,2:21:42.16,Default,,0,0,0,,(Харумидің күлкісі)
Dialogue: 0,2:21:49.83,2:21:51.83,Default,,0,0,0,,Ха... (Энтаро) Не істеп жатырсың?
Dialogue: 0,2:21:51.96,2:21:54.17,Default,,0,0,0,,Қымбат ақ ас көрінбейді
Dialogue: 0,2:22:06.64,2:22:09.68,Default,,0,0,0,,Бұдан кейін әр күн жалғасады
Dialogue: 0,2:22:09.81,2:22:13.19,Default,,0,0,0,,Бұл соғыс аяқталғаннан кейінгі үшінші тайфун.
Dialogue: 0,2:22:13.31,2:22:17.32,Default,,0,0,0,,Хиросимадан қайтқаннан бері шаршадым.
Dialogue: 0,2:22:17.44,2:22:20.82,Default,,0,0,0,,Жоқ, демалыңыз.
Dialogue: 0,2:22:20.94,2:22:21.78,Default,,0,0,0,,Ах
Dialogue: 0,2:22:31.29,2:22:33.46,Default,,0,0,0,,Охх~ (Шусаку) Міне! Бұл қауіпті
Dialogue: 0,2:22:33.58,2:22:35.33,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,2:22:35.46,2:22:37.17,Default,,0,0,0,,Тағы бір тұтандырғыш тесік
Dialogue: 0,2:22:37.29,2:22:40.13,Default,,0,0,0,,(Шусаку) Нені көруім керек?
Dialogue: 0,2:22:40.26,2:22:41.30,Default,,0,0,0,,Уф...
Dialogue: 0,2:22:42.09,2:22:44.43,Default,,0,0,0,,Мен саған сене алмаймын.
Dialogue: 0,2:22:48.89,2:22:52.48,Default,,0,0,0,,(Шусаку) Кешіріңіз, мен тағы бір тесік жасауым керек болды.
Dialogue: 0,2:22:52.60,2:22:53.56,Default,,0,0,0,,№
Dialogue: 0,2:23:00.98,2:23:03.82,Default,,0,0,0,,(Мейко) Әй, уау! ‬
Dialogue: 0,2:23:07.74,2:23:10.41,Default,,0,0,0,,Юта мүлде қиыншылықта болды.
Dialogue: 0,2:23:11.58,2:23:14.58,Default,,0,0,0,,Мен көшкінге түсіп, әрең дегенде қайта көтерілдім.
Dialogue: 0,2:23:14.71,2:23:16.37,Default,,0,0,0,,Мені қайтадан итеріп жібереді
Dialogue: 0,2:23:16.50,2:23:18.04,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,2:23:18.17,2:23:20.38,Default,,0,0,0,,Пошташы да жоғары көтерілуі керек.
Dialogue: 0,2:23:20.50,2:23:24.55,Default,,0,0,0,,Мен оны төменнен алып, орнына пошташыны пайдалануым керек болды.
Dialogue: 0,2:23:25.09,2:23:26.34,Default,,0,0,0,,Жақсы жұмыс...
Dialogue: 0,2:23:29.01,2:23:30.26,Default,,0,0,0,,А... Мен оны оқи алмаймын.
Dialogue: 0,2:23:30.26,2:23:30.97,Default,,0,0,0,,А... Мен оқи алмаймын.
Dialogue: 0,2:23:30.26,2:23:30.97,Default,,0,0,0,,Әй, мама, бүгін мен жақсы бала болдым ба?
Dialogue: 0,2:23:30.97,2:23:31.10,Default,,0,0,0,,Әй, мама, бүгін мен жақсы бала болдым ба?
Dialogue: 0,2:23:31.10,2:23:32.47,Default,,0,0,0,,Әй, мама, бүгін мен жақсы бала болдым ба?
Dialogue: 0,2:23:31.10,2:23:32.47,Default,,0,0,0,,(Мейко) А...
Dialogue: 0,2:23:33.73,2:23:35.77,Default,,0,0,0,,(Entaro) Мен үйдемін! ‬
Dialogue: 0,2:23:36.94,2:23:39.19,Default,,0,0,0,,(Шусаку) Қош келдіңіз, әке
Dialogue: 0,2:23:39.31,2:23:40.65,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,2:23:43.40,2:23:45.53,Default,,0,0,0,,(Entaro) Ха ха...
Dialogue: 0,2:23:48.99,2:23:49.95,Default,,0,0,0,,Хмм! ‬
Dialogue: 0,2:23:51.16,2:23:55.29,Default,,0,0,0,,Әскери-теңіз арсеналында 42 жыл еңбек өтілі
Dialogue: 0,2:23:55.41,2:23:58.58,Default,,0,0,0,,Мен жұмыстан шығарылдым! ‬
Dialogue: 0,2:24:01.00,2:24:03.34,Default,,0,0,0,,(сықырлау)
Dialogue: 0,2:24:03.46,2:24:04.92,Default,,0,0,0,,Ария (Шусаку) Сықырлаған Миору
Dialogue: 0,2:24:07.76,2:24:08.80,Default,,0,0,0,,(шулау)
Dialogue: 0,2:24:08.93,2:24:12.35,Default,,0,0,0,,(Entaro) Уау! (Барлығы) Уау! ‬
Dialogue: 0,2:24:12.47,2:24:14.14,Default,,0,0,0,,(Entaro) О! ‬
Dialogue: 0,2:24:14.27,2:24:17.14,Default,,0,0,0,,(Энтаро) Сарай қираған ба?
Dialogue: 0,2:24:18.73,2:24:20.61,Default,,0,0,0,,Бұл өте дұрыс.
Dialogue: 0,2:24:21.56,2:24:24.36,Default,,0,0,0,,Эвакуация... болса да
Dialogue: 0,2:24:24.48,2:24:27.45,Default,,0,0,0,,Тіпті әуе шабуылына қарсы баспана да жерленген.
Dialogue: 0,2:24:27.57,2:24:29.24,Default,,0,0,0,,Жетеді.
Dialogue: 0,2:24:29.36,2:24:31.82,Default,,0,0,0,,Жол құлағалы тұр.
Dialogue: 0,2:24:36.25,2:24:38.58,Default,,0,0,0,,(Барлығы күледі)
Dialogue: 0,2:24:38.71,2:24:40.25,Default,,0,0,0,,(Шусаку) Саенну
Dialogue: 0,2:24:40.38,2:24:43.13,Default,,0,0,0,,(Кобаяши) Қазір айналады деп ойламаппын.
Dialogue: 0,2:24:43.25,2:24:45.55,Default,,0,0,0,,(Киязи) Бір ай бұрын бітті.
Dialogue: 0,2:24:45.67,2:24:46.92,Default,,0,0,0,,(Entaro) Үлкен жарылыспен! ‬
Dialogue: 0,2:24:47.05,2:24:49.55,Default,,0,0,0,,(Шусаку) Бұл шынымен тітіркендіргіш камикадзе.
Dialogue: 0,2:24:49.68,2:24:52.43,Default,,0,0,0,,(Барлығы күледі)
Dialogue: 0,2:24:55.06,2:24:57.10,Default,,0,0,0,,(Шусаку) Бұл күлкі емес.
Dialogue: 0,2:24:57.98,2:25:00.19,Default,,0,0,0,,Адамдар да өлуі мүмкін.
Dialogue: 0,2:25:01.19,2:25:04.44,Default,,0,0,0,,Адамдар соғысса да өледі.
Dialogue: 0,2:25:07.07,2:25:10.95,Default,,0,0,0,,Хойдемо Суми-чан аман қалды
Dialogue: 0,2:25:17.41,2:25:19.83,Default,,0,0,0,,(Шусаку) Ақыры жағаға шықтық.
Dialogue: 0,2:25:19.96,2:25:22.25,Default,,0,0,0,,Отакеге көшеміз
Dialogue: 0,2:25:22.38,2:25:25.71,Default,,0,0,0,,Не болса да, біз флотты бөлшектегенше
Dialogue: 0,2:25:25.84,2:25:29.09,Default,,0,0,0,,Тәртіпті сақтау – заңгерлік кәсіптің міндеті.
Dialogue: 0,2:25:29.55,2:25:33.43,Default,,0,0,0,,Ах... Қараңғы түскенде, екі қолым болса ғой
Dialogue: 0,2:25:33.55,2:25:38.31,Default,,0,0,0,,Мен бұл кісінің қобалжыған қолына ақырын ғана қолымды қоя алсам да.
Dialogue: 0,2:25:40.31,2:25:42.02,Default,,0,0,0,,Тыныш.
Dialogue: 0,2:25:42.15,2:25:43.90,Default,,0,0,0,,(Шусаку) Барлығың дайындалыңдар.
Dialogue: 0,2:25:46.40,2:25:49.57,Default,,0,0,0,,Сузу-сан, қайтқанда үйден шықпа.
Dialogue: 0,2:25:49.69,2:25:50.78,Default,,0,0,0,,Иә
Dialogue: 0,2:25:50.90,2:25:53.53,Default,,0,0,0,,Сузу-санды білейік, осы жерден солға бұрылыңыз.
Dialogue: 0,2:25:53.66,2:25:54.62,Default,,0,0,0,,Өзіңіз барыңыз
Dialogue: 0,2:25:57.37,2:25:59.00,Default,,0,0,0,,Сіз не істеп жатырсыз? Асықшы! ‬
Dialogue: 0,2:25:59.58,2:26:00.79,Default,,0,0,0,,Енді
Dialogue: 0,2:26:02.08,2:26:04.96,Default,,0,0,0,,А... а... иә! ‬
Dialogue: 0,2:26:07.88,2:26:11.30,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,2:26:20.93,2:26:21.89,Default,,0,0,0,,Лин мырза
Dialogue: 0,2:26:27.52,2:26:29.40,Default,,0,0,0,,Рин мырза біледі ме? ‬
Dialogue: 0,2:26:35.03,2:26:38.33,Default,,0,0,0,,Олар сені осы қалаға әкелгенше қашып кет.
Dialogue: 0,2:26:40.66,2:26:44.50,Default,,0,0,0,,Бір үйдің шатырында бір бала тығылып отырды.
Dialogue: 0,2:26:55.26,2:26:56.80,Default,,0,0,0,,Учиха
Dialogue: 0,2:26:56.93,2:26:59.72,Default,,0,0,0,,Мен мұндай баланы бұрын да кездестіргенмін.
Dialogue: 0,2:27:02.02,2:27:06.31,Default,,0,0,0,,Мен өлсем, менің де жүрегімнің сырлары
Dialogue: 0,2:27:06.44,2:27:08.69,Default,,0,0,0,,Әр адам ешқашан болмаған
Dialogue: 0,2:27:10.78,2:27:12.07,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,2:27:12.90,2:27:16.16,Default,,0,0,0,,Рин-сан туралы, бұл құпия болмауы керек.
Dialogue: 0,2:27:18.20,2:27:19.16,Default,,0,0,0,,Бірақ
Dialogue: 0,2:27:19.95,2:27:23.58,Default,,0,0,0,,Бұл сән-салтанат сияқты.
Dialogue: 0,2:27:36.38,2:27:38.05,Default,,0,0,0,,Ах, Чита-сан
Dialogue: 0,2:27:40.51,2:27:41.93,Default,,0,0,0,,Сәлеметсіз бе
Dialogue: 0,2:27:50.15,2:27:51.94,Default,,0,0,0,,(Чита) Сен шығасың ба?
Dialogue: 0,2:27:52.86,2:27:54.28,Default,,0,0,0,,Ходжоның әйелі
Dialogue: 0,2:27:57.15,2:27:58.07,Default,,0,0,0,,Хаа
Dialogue: 0,2:27:58.99,2:28:01.83,Default,,0,0,0,,Қалай болғанда да, мен оны сатып алуды ойладым.
Dialogue: 0,2:28:04.29,2:28:06.41,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,2:28:06.54,2:28:10.50,Default,,0,0,0,,Егер сіз рационға сенсеңіз, күн астында кептіруге болмайды.
Dialogue: 0,2:28:23.72,2:28:26.77,Default,,0,0,0,,Мм... анау қолшатыр
Dialogue: 0,2:28:28.94,2:28:29.90,Default,,0,0,0,,Иә
Dialogue: 0,2:28:30.02,2:28:33.11,Default,,0,0,0,,Күн нұрын шашып тұр.
Dialogue: 0,2:28:34.73,2:28:38.53,Default,,0,0,0,,Әпкең әлі тірі сияқты.
Dialogue: 0,2:28:38.65,2:28:39.61,Default,,0,0,0,,Иә
Dialogue: 0,2:28:40.91,2:28:42.66,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,2:28:45.12,2:28:46.95,Default,,0,0,0,,(Чита) Бұл тамаша.
Dialogue: 0,2:28:51.17,2:28:52.46,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,2:28:53.04,2:28:57.09,Default,,0,0,0,,(Чита) Сіз мүмкіндігінше демалу керек адамсыз.
Dialogue: 0,2:28:57.21,2:29:00.59,Default,,0,0,0,,Егер остеомиелит пайда болса, қайта кесуге болмайды.
Dialogue: 0,2:29:17.15,2:29:18.95,Default,,0,0,0,,(жанды музыка)
Dialogue: 0,2:29:19.61,2:29:20.78,Default,,0,0,0,,Әй, жеңге
Dialogue: 0,2:29:20.91,2:29:23.95,Default,,0,0,0,,Ах, Сузу-сан, бұл қандай кезек?
Dialogue: 0,2:29:24.08,2:29:28.37,Default,,0,0,0,,Бәрі жақсы, ештеңе жетпейді.
Dialogue: 0,2:29:29.08,2:29:30.21,Default,,0,0,0,,Әрине
Dialogue: 0,2:29:29.08,2:29:30.21,Default,,0,0,0,,(Балалардың жылауы)
Dialogue: 0,2:29:30.21,2:29:31.50,Default,,0,0,0,,(баланың шулы дауысы)
Dialogue: 0,2:29:31.62,2:29:34.46,Default,,0,0,0,,Бірақ бұл қала да өзгерді.
Dialogue: 0,2:29:35.21,2:29:36.55,Default,,0,0,0,,Маған беріңіз
Dialogue: 0,2:29:36.67,2:29:38.09,Default,,0,0,0,,(Кейко) Қызық, енді Хисао да солай істеуі керек пе?
Dialogue: 0,2:29:38.09,2:29:39.38,Default,,0,0,0,,(Кейко) Қызық, енді Хисао да солай істеуі керек пе?
Dialogue: 0,2:29:38.09,2:29:39.38,Default,,0,0,0,,Сағыз шоколады
Dialogue: 0,2:29:39.38,2:29:40.22,Default,,0,0,0,,Сағыз шоколады
Dialogue: 0,2:29:40.34,2:29:41.59,Default,,0,0,0,,Қызық, Харуми де солай жасады ма?
Dialogue: 0,2:29:41.72,2:29:46.47,Default,,0,0,0,,Бұл басқыншы әскерден қалған күріш ботқасы еді. Ха...
Dialogue: 0,2:29:47.97,2:29:49.43,Default,,0,0,0,,(Киязи) Қағаз сынықтары...
Dialogue: 0,2:29:51.44,2:29:52.27,Default,,0,0,0,,Уф
Dialogue: 0,2:29:55.56,2:29:56.36,Default,,0,0,0,,(Мейко) Уф
Dialogue: 0,2:29:57.44,2:30:00.36,Default,,0,0,0,,(2 адам) Уф...
Dialogue: 0,2:30:00.49,2:30:02.61,Default,,0,0,0,,Дәмді
Dialogue: 0,2:30:05.16,2:30:07.87,Default,,0,0,0,,Бұның дәмі мүлде жоқ.
Dialogue: 0,2:30:08.66,2:30:12.12,Default,,0,0,0,,Тұз бен соя соусы баяғыда кетті.
Dialogue: 0,2:30:14.58,2:30:17.84,Default,,0,0,0,,Жүр, мен Америкаға жол көрсетемін.
Dialogue: 0,2:30:17.96,2:30:19.55,Default,,0,0,0,,Шоколад да балауыз
Dialogue: 0,2:30:19.67,2:30:23.30,Default,,0,0,0,,(Қария) Сол шаш үлгісімен мені бала деп қателескен шығарсың.
Dialogue: 0,2:30:23.43,2:30:24.51,Default,,0,0,0,,Хахаха…
Dialogue: 0,2:30:29.52,2:30:33.35,Default,,0,0,0,,Солай ма? сенімен киім айырбастау
Dialogue: 0,2:30:33.48,2:30:34.90,Default,,0,0,0,,(Қария) Иә.
Dialogue: 0,2:30:35.48,2:30:37.31,Default,,0,0,0,,Сіз білмейсіз бе?
Dialogue: 0,2:30:37.44,2:30:42.15,Default,,0,0,0,,Көршілес мұражайда қаза тапқан солдат менің ұлым сияқты.
Dialogue: 0,2:30:43.15,2:30:46.03,Default,,0,0,0,,Мен бұл менің ұлым екенін түсінбедім.
Dialogue: 0,2:30:47.74,2:30:50.37,Default,,0,0,0,,Менің алдымда Харуми-санды да көрдің...
Dialogue: 0,2:30:51.58,2:30:54.37,Default,,0,0,0,,Иә, бұл ұят.
Dialogue: 0,2:30:58.04,2:30:59.04,Default,,0,0,0,,(Философия) Сузу
Dialogue: 0,2:31:01.09,2:31:02.13,Default,,0,0,0,,Қалайы
Dialogue: 0,2:31:03.09,2:31:07.05,Default,,0,0,0,,Мені есіңе алсаң, күл.
Dialogue: 0,2:31:09.60,2:31:13.43,Default,,0,0,0,,Осы дүниеде қалыпты және әдепті болыңыз.
Dialogue: 0,2:31:09.60,2:31:13.43,Default,,0,0,0,,(Балалардың ән айтуы)
Dialogue: 0,2:31:14.94,2:31:16.15,Default,,0,0,0,,Қалайы
Dialogue: 0,2:31:16.27,2:31:17.77,Default,,0,0,0,,Харуми-сан
Dialogue: 0,2:31:17.90,2:31:20.98,Default,,0,0,0,,Мен мұнда қандай кеме екенін көрдім, Харуми-сан.
Dialogue: 0,2:31:21.98,2:31:24.20,Default,,0,0,0,,Құлаған Аоба болды.
Dialogue: 0,2:31:26.95,2:31:28.16,Default,,0,0,0,,Тецу-сан
Dialogue: 0,2:31:28.82,2:31:31.58,Default,,0,0,0,,Дәл қазір күлкіңнің шетінде
Dialogue: 0,2:31:31.70,2:31:37.46,Default,,0,0,0,,Қояндар секіретін теңіз - құтандар өтетін аспанның мекені.
Dialogue: 0,2:31:37.58,2:31:41.88,Default,,0,0,0,,(Харумидің күлкісі)
Dialogue: 0,2:31:42.00,2:31:44.13,Default,,0,0,0,,Харуми-сан күліп тұр.
Dialogue: 0,2:31:44.26,2:31:48.01,Default,,0,0,0,,Мен Харуми-санды күліп еске аламын.
Dialogue: 0,2:31:48.14,2:31:52.43,Default,,0,0,0,,Бұдан былай біз әрқашан күлкі контейнері боламыз.
Dialogue: 0,2:31:52.56,2:31:56.69,Default,,0,0,0,,Ей, үнемі жылай берсең босқа.
Dialogue: 0,2:31:56.81,2:31:59.06,Default,,0,0,0,,(2 адам) Менің тұзым жетпейді.
Dialogue: 0,2:31:59.19,2:32:00.02,Default,,0,0,0,,(Барлығы) Куу~
Dialogue: 0,2:32:00.15,2:32:03.07,Default,,0,0,0,,Теңіздің тұзды суы емес.
Dialogue: 0,2:32:03.53,2:32:07.53,Default,,0,0,0,,Чизуко-чан апай
Dialogue: 0,2:32:07.66,2:32:09.49,Default,,0,0,0,,Аххх (Чизуко) Сузу-чан
Dialogue: 0,2:32:11.83,2:32:13.20,Default,,0,0,0,,Суми-чан
Dialogue: 0,2:32:13.33,2:32:15.33,Default,,0,0,0,,Ах! Сузу-чан
Dialogue: 0,2:32:15.45,2:32:17.33,Default,,0,0,0,,Мен шашымды қимадым.
Dialogue: 0,2:32:17.46,2:32:21.00,Default,,0,0,0,,Иә, иә, оян, ауырып тұрсың ба? ‬
Dialogue: 0,2:32:21.13,2:32:23.13,Default,,0,0,0,,Менің басым айналады.
Dialogue: 0,2:32:23.25,2:32:24.09,Default,,0,0,0,,А...
Dialogue: 0,2:32:24.21,2:32:26.76,Default,,0,0,0,,Әй, не деген ұят, апа.
Dialogue: 0,2:32:26.88,2:32:31.14,Default,,0,0,0,,Осы суық аспан астында Норидің жұмысы көмектеседі
Dialogue: 0,2:32:33.14,2:32:36.56,Default,,0,0,0,,Яғни, сіз ересек адам ретінде ұйықтауыңыз керек.
Dialogue: 0,2:32:38.44,2:32:40.44,Default,,0,0,0,,(2 адам) Хехехе...
Dialogue: 0,2:32:40.56,2:32:41.73,Default,,0,0,0,,Әй, қолым болса ғой.
Dialogue: 0,2:32:41.86,2:32:46.65,Default,,0,0,0,,Мен Онии-чанның Оңтүстік теңіздеріндегі шытырман оқиғаларын суреттеп бере алар едім.
Dialogue: 0,2:32:46.78,2:32:49.91,Default,,0,0,0,,Бұл қандай? Әй, не әңгіме? ‬
Dialogue: 0,2:32:50.03,2:32:53.83,Default,,0,0,0,,Онии-чан: Көлік кемесі апатқа ұшырады.
Dialogue: 0,2:32:54.54,2:32:58.71,Default,,0,0,0,,Оңтүстік аралда пальма жапырақтарынан үй тұрғыз
Dialogue: 0,2:32:58.83,2:33:03.09,Default,,0,0,0,,Менің сақалым бітті, қолтырауынды әйелім етіп алдым.
Dialogue: 0,2:33:03.21,2:33:05.75,Default,,0,0,0,,Крокодил сіздің әйеліңіз бе?
Dialogue: 0,2:33:06.88,2:33:10.05,Default,,0,0,0,,Неге Эбаға қайтпайсың, Они-чан?
Dialogue: 0,2:33:10.18,2:33:11.51,Default,,0,0,0,,Анам да
Dialogue: 0,2:33:11.64,2:33:12.43,Default,,0,0,0,,Иә? ‬
Dialogue: 0,2:33:13.14,2:33:18.48,Default,,0,0,0,,Сол күні таңертең мерекеге дайындалу үшін анам қалаға жұмыс істеуге кетті.
Dialogue: 0,2:33:19.48,2:33:22.35,Default,,0,0,0,,Әкем екеуміз әр жерден іздедік.
Dialogue: 0,2:33:22.48,2:33:24.69,Default,,0,0,0,,Мен оны таба алмадым.
Dialogue: 0,2:33:24.82,2:33:28.94,Default,,0,0,0,,Әке, ол қазан айында құлап, бірден өлетін еді.
Dialogue: 0,2:33:29.07,2:33:32.03,Default,,0,0,0,,Оның бәрін мектепте пісіре аласыз ба?
Dialogue: 0,2:33:32.16,2:33:35.33,Default,,0,0,0,,Сізге хабарлауға уақыт алғаным үшін кешірім сұраймыз.
Dialogue: 0,2:33:36.58,2:33:39.71,Default,,0,0,0,,Ерте келмегенім үшін кешіріңіз.
Dialogue: 0,2:33:39.83,2:33:42.42,Default,,0,0,0,,Ерте келгеніңізге қуаныштымын.
Dialogue: 0,2:33:42.54,2:33:46.25,Default,,0,0,0,,Сузу-чан, мынау сияқты
Dialogue: 0,2:33:46.38,2:33:48.71,Default,,0,0,0,,Емдейтінін білмеймін.
Dialogue: 0,2:33:48.84,2:33:51.43,Default,,0,0,0,,Сауықтырады, жазылмаса біртүрлі болады.
Dialogue: 0,2:34:02.69,2:34:03.65,Default,,0,0,0,,(шу)
Dialogue: 0,2:34:03.77,2:34:05.73,Default,,0,0,0,,А... ә! ‬
Dialogue: 0,2:34:06.40,2:34:07.78,Default,,0,0,0,,Анам осында...
Dialogue: 0,2:34:07.90,2:34:09.32,Default,,0,0,0,,(Балалардың үрейлі дауыстары)
Dialogue: 0,2:34:09.44,2:34:11.86,Default,,0,0,0,,(Әпке) Аға (Аға) Кешіріңіз, кешіріңіз.
Dialogue: 0,2:34:11.99,2:34:14.37,Default,,0,0,0,,Кешіріңіз, кешіріңіз.
Dialogue: 0,2:34:14.49,2:34:16.33,Default,,0,0,0,,Ешкім болған жоқ.
Dialogue: 0,2:34:28.30,2:34:31.22,Default,,0,0,0,,(Судзу күрсінуі)
Dialogue: 0,2:34:34.68,2:34:37.64,Default,,0,0,0,,(дөрекі тыныс алу)
Dialogue: 0,2:34:44.65,2:34:48.40,Default,,0,0,0,,♪～
Dialogue: 0,2:34:48.52,2:34:50.65,Default,,0,0,0,,(Әйел) Ах! Сачико-сан! ‬
Dialogue: 0,2:34:51.74,2:34:52.90,Default,,0,0,0,,Жоқ (әйел) А...
Dialogue: 0,2:34:55.95,2:34:58.74,Default,,0,0,0,,(Еркек) Киоко-сан Бұл Киоко-сан емес пе? ‬
Dialogue: 0,2:35:00.58,2:35:02.16,Default,,0,0,0,,Бұл қалада барлығы біреуді жоғалтып алып, іздеп жүр.
Dialogue: 0,2:35:02.16,2:35:03.71,Default,,0,0,0,,Бұл қалада барлығы біреуді жоғалтып алып, іздеп жүр.
Dialogue: 0,2:35:02.16,2:35:03.71,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,2:35:03.71,2:35:05.04,Default,,0,0,0,,Бұл қалада барлығы біреуді жоғалтып алып, іздеп жүр.
Dialogue: 0,2:35:05.17,2:35:09.25,Default,,0,0,0,,Мен де Рин-санды бір-екі рет көргендей болдым.
Dialogue: 0,2:35:09.38,2:35:10.50,Default,,0,0,0,,Ха...
Dialogue: 0,2:35:11.09,2:35:12.26,Default,,0,0,0,,(Шусаку) Сузу-сан
Dialogue: 0,2:35:13.63,2:35:16.84,Default,,0,0,0,,О, сен амансың деп үміттенемін.
Dialogue: 0,2:35:17.51,2:35:21.43,Default,,0,0,0,,Әскери-теңіз күштері де қараша айының соңына дейін оларға қызмет етпейтінін айтты.
Dialogue: 0,2:35:22.81,2:35:23.93,Default,,0,0,0,,Сузу-сан
Dialogue: 0,2:35:24.81,2:35:29.02,Default,,0,0,0,,Осы көпірде мен және Сузу алғаш рет кездестік.
Dialogue: 0,2:35:30.36,2:35:32.86,Default,,0,0,0,,Мен ол күндерге қайта оралмаймын
Dialogue: 0,2:35:32.99,2:35:36.61,Default,,0,0,0,,Бұл қала және біз өзгереміз.
Dialogue: 0,2:35:36.74,2:35:38.70,Default,,0,0,0,,Мен Сузу-санды әрқашан түсіне аламын.
Dialogue: 0,2:35:39.45,2:35:42.37,Default,,0,0,0,,Бұл жерде мең бар, оны бірден көруге болады.
Dialogue: 0,2:35:43.50,2:35:45.83,Default,,0,0,0,,Рахмет Шусаку-сан
Dialogue: 0,2:35:45.96,2:35:50.21,Default,,0,0,0,,Бізді әлемнің осы бұрышынан тапқаны үшін
Dialogue: 0,2:35:50.34,2:35:54.72,Default,,0,0,0,,Өтінемін, қазір мені тастап, мәңгі қасымда бол.
Dialogue: 0,2:35:55.42,2:35:57.18,Default,,0,0,0,,(2 адам) Иә? иә? ‬
Dialogue: 0,2:36:19.37,2:36:22.03,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,2:36:22.16,2:36:26.96,Default,,0,0,0,,(Ана) Ха ха ха ха...
Dialogue: 0,2:36:37.63,2:36:41.97,Default,,0,0,0,,(Бала) Ууууууууууу...
Dialogue: 0,2:37:06.41,2:37:08.33,Default,,0,0,0,,Ах (Шусаку) Иә, иә
Dialogue: 0,2:37:08.46,2:37:11.42,Default,,0,0,0,,Қалай болғанда да, мен Хиросимадан жұмыс тапқаныма қуаныштымын.
Dialogue: 0,2:37:12.04,2:37:13.04,Default,,0,0,0,,Иә
Dialogue: 0,2:37:16.17,2:37:19.09,Default,,0,0,0,,Бірақ бұл алыс және қиын.
Dialogue: 0,2:37:19.22,2:37:21.43,Default,,0,0,0,,Біз... иә...
Dialogue: 0,2:37:25.01,2:37:28.35,Default,,0,0,0,,Рахмет, тамақ ішіңіз.
Dialogue: 0,2:37:28.48,2:37:32.73,Default,,0,0,0,,Мен үйден шығып, осында отбасын құруым керек пе?
Dialogue: 0,2:37:32.86,2:37:35.61,Default,,0,0,0,,Мұнда сенің енең мен Суми-сан да бар.
Dialogue: 0,2:37:35.73,2:37:40.03,Default,,0,0,0,,Жоқ, мен сонда барамын.
Dialogue: 0,2:37:40.15,2:37:45.58,Default,,0,0,0,,Мен Хиросима үшін уайымдаймын, бірақ Куре - біз таңдаған жер.
Dialogue: 0,2:37:47.04,2:37:47.95,Default,,0,0,0,,Иә...
Dialogue: 0,2:37:55.84,2:37:56.80,Default,,0,0,0,,Иә
Dialogue: 0,2:38:05.89,2:38:09.31,Default,,0,0,0,,(Станция қызметкерлері) Ву~ Ву~
Dialogue: 0,2:38:09.43,2:38:10.77,Default,,0,0,0,,(Бала) Ву? ‬
Dialogue: 0,2:38:10.89,2:38:13.35,Default,,0,0,0,,Иә, бұл Күре.
Dialogue: 0,2:38:13.48,2:38:18.82,Default,,0,0,0,,Ол тоғыз жотамен қорғалған.
Dialogue: 0,2:38:18.94,2:38:23.70,Default,,0,0,0,,Оң жақтағы - тыныштық тау. Сол жақтағы - Хачимаки тауы
Dialogue: 0,2:38:25.28,2:38:28.79,Default,,0,0,0,,Хойда ортасы Нонга Хайгамин
Dialogue: 0,2:38:32.12,2:38:35.17,Default,,0,0,0,,Ол юбка біздің үйде.
Dialogue: 0,2:38:44.18,2:38:45.47,Default,,0,0,0,,Бұл бала...
Dialogue: 0,2:38:45.59,2:38:46.39,Default,,0,0,0,,Иә
Dialogue: 0,2:38:47.51,2:38:50.27,Default,,0,0,0,,(Энтаро) Бұл үлкен бит. (Кобаяшидің әйелі) Аххх
Dialogue: 0,2:38:50.39,2:38:54.60,Default,,0,0,0,,Үлкен қазанға суды қайнатып, бәрін қайнатыңыз.
Dialogue: 0,2:38:54.73,2:38:56.40,Default,,0,0,0,,(Шусаку) Қазір жуынып алайық.
Dialogue: 0,2:38:56.52,2:38:59.27,Default,,0,0,0,,Бұл бала соңында жақсырақ емес пе? ‬
Dialogue: 0,2:38:59.40,2:39:01.40,Default,,0,0,0,,(Энтаро) Жарайды, бәрібір мен шомыламын.
Dialogue: 0,2:39:02.57,2:39:05.66,Default,,0,0,0,,Харумидің былтырғы киімдері жеткіліксіз.
Dialogue: 0,2:39:25.72,2:39:30.68,Default,,0,0,0,,‪～♪‬
Dialogue: 0,2:39:30.81,2:39:35.77,Default,,0,0,0,,♪～
Dialogue: 0,2:44:27.23,2:44:32.19,Default,,0,0,0,,‪～♪‬
Dialogue: 0,2:44:34.03,2:44:38.99,Default,,0,0,0,,‪♪～‬
Dialogue: 0,2:47:39.09,2:47:44.05,Default,,0,0,0,,‪～♪‬
