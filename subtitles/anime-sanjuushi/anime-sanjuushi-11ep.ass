Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.98,0:00:09.29,Default,,0,0,0,,♬～
Dialogue: 0,0:01:26.01,0:01:32.00,Default,,0,0,0,,Д'Артаньян Парижге Гасконьнен мушкетер болу арманымен келді➡
Dialogue: 0,0:01:32.00,0:01:37.11,Default,,0,0,0,,Бұл тілектің орындалуы екіталай көрінді.
Dialogue: 0,0:01:43.67,0:01:45.67,Default,,0,0,0,,Хмм.
Dialogue: 0,0:01:47.32,0:01:49.32,Default,,0,0,0,,Иә.
Dialogue: 0,0:01:49.30,0:01:51.81,Default,,0,0,0,,Сіз қалай ойлайсыз? Жан!
Dialogue: 0,0:01:51.82,0:01:53.83,Default,,0,0,0,,Бұл сізге жақсы көрінеді.
Dialogue: 0,0:01:56.16,0:01:58.26,Default,,0,0,0,,Бұл өте көлемді емес пе?
Dialogue: 0,0:01:58.31,0:02:01.32,Default,,0,0,0,,Менің таңдауым жоқ. Бұл Портостың тапсырысы.
Dialogue: 0,0:02:01.35,0:02:05.45,Default,,0,0,0,,Мен д'Артаньянмын, Мәртебелі мушкетермін!
Dialogue: 0,0:02:05.50,0:02:08.51,Default,,0,0,0,,Ах, мұнда және мұнда. Жаңадан жасалған бұйымдар➡
Dialogue: 0,0:02:08.51,0:02:11.31,Default,,0,0,0,,Егер ол ластанса ше? Мен бара алмаймын.
Dialogue: 0,0:02:13.16,0:02:16.16,Default,,0,0,0,,Ах…. (сынған дыбыс)
Dialogue: 0,0:02:16.16,0:02:21.27,Default,,0,0,0,,Ах~. Ааа... Уау….
Dialogue: 0,0:02:21.32,0:02:23.42,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:02:23.47,0:02:29.78,Default,,0,0,0,,♬～
Dialogue: 0,0:02:29.85,0:02:33.15,Default,,0,0,0,,Энн Сізден бір нәрсе естігім келеді.
Dialogue: 0,0:02:33.18,0:02:36.49,Default,,0,0,0,,Сіз нені айтасыз? (Луи XIII) Букингем герцогы➡
Dialogue: 0,0:02:36.50,0:02:40.31,Default,,0,0,0,,Мен Англия королі Карл I-ге хабаршы ретінде Парижге келемін.
Dialogue: 0,0:02:40.34,0:02:43.34,Default,,0,0,0,,Иә? о қымбаттым! Не таң қалдырады?
Dialogue: 0,0:02:43.34,0:02:45.34,Default,,0,0,0,,Жоқ. Әсіресе...
Dialogue: 0,0:02:45.33,0:02:49.63,Default,,0,0,0,,Бір күні Букингем екеуің Парижге жасырын келдіңдер.
Dialogue: 0,0:02:49.65,0:02:52.25,Default,,0,0,0,,Жасырын кездескен деген қауесет бар.
Dialogue: 0,0:02:52.35,0:02:57.34,Default,,0,0,0,,Жоқ, мұндай әрекетті кім жасады? Кез келген адам болуы мүмкін.
Dialogue: 0,0:02:57.34,0:03:01.43,Default,,0,0,0,,Ришелье, солай ма? Мен мұндай қауесеттерге сенгім келмейді.
Dialogue: 0,0:03:01.51,0:03:04.51,Default,,0,0,0,,Әрине, біз кездеспегендіктен.
Dialogue: 0,0:03:04.51,0:03:08.60,Default,,0,0,0,,Бірақ Букингем сені бұл жолы тағы көруге тырысады.
Dialogue: 0,0:03:08.65,0:03:10.95,Default,,0,0,0,,Эксклюзивті қауесет. ➡
Dialogue: 0,0:03:11.00,0:03:14.01,Default,,0,0,0,,Францияның ар-намысын қорлауға мүлдем жол берілмейді. ➡
Dialogue: 0,0:03:13.99,0:03:17.98,Default,,0,0,0,,Ресми жағдайдан басқа ешбір жерде жалғыз кездесуге болмайды.
Dialogue: 0,0:03:17.99,0:03:20.80,Default,,0,0,0,,Жалпы мағына. Сізбен кездесуге ниетім жоқ.
Dialogue: 0,0:03:20.83,0:03:26.64,Default,,0,0,0,,Бұл сөздер мені жұбатты. Сенімге опасыздық жасамауыңды өтіндім.
Dialogue: 0,0:03:32.01,0:03:36.01,Default,,0,0,0,,Сіз мұны естідіңіз, Констанс. иә. Біз не істеуіміз керек?
Dialogue: 0,0:03:36.01,0:03:39.01,Default,,0,0,0,,Ришельеде мұндай жақсы мүмкіндік болған емес.
Dialogue: 0,0:03:38.98,0:03:43.29,Default,,0,0,0,,Мені жаман адам қылу үшін тұзақ құратынына сенімдімін.
Dialogue: 0,0:03:43.35,0:03:46.64,Default,,0,0,0,,Уайымдама, тек патшайым өзін өзі ойласа➡
Dialogue: 0,0:03:46.64,0:03:50.14,Default,,0,0,0,,Біз сені өз өмірімізбен қорғаймыз.
Dialogue: 0,0:03:50.16,0:03:53.96,Default,,0,0,0,,(айқай)
Dialogue: 0,0:03:55.65,0:03:59.65,Default,,0,0,0,,(Көшіріп алу)
Dialogue: 0,0:03:59.67,0:04:02.97,Default,,0,0,0,,«Ванаво Шикакетекуруни Чигайнай».
Dialogue: 0,0:04:03.00,0:04:07.31,Default,,0,0,0,,Жарайды, жүр. (айқай)
Dialogue: 0,0:04:07.34,0:04:11.45,Default,,0,0,0,,Ришелье, Букингем герцогы Парижге келгенге дейін➡
Dialogue: 0,0:04:11.51,0:04:15.92,Default,,0,0,0,,Кейбір адамдардан құтылуымыз керек. (Ришелье) Сіз кімсіз?
Dialogue: 0,0:04:16.02,0:04:19.62,Default,,0,0,0,,Бұл үш мушкетер. Хмм.
Dialogue: 0,0:04:19.64,0:04:23.64,Default,,0,0,0,,Басқа сәтсіздік те олардың араласуынан болды.
Dialogue: 0,0:04:23.68,0:04:27.26,Default,,0,0,0,,Келесі жоспарыңызды сәтті орындау үшін алдын ала дайындалыңыз➡
Dialogue: 0,0:04:27.33,0:04:32.33,Default,,0,0,0,,Менің ойымша, олардан құтылған дұрыс болар еді. Мені өлтіресің бе?
Dialogue: 0,0:04:32.32,0:04:35.92,Default,,0,0,0,,Ұйымдастырулар қазірдің өзінде бар.
Dialogue: 0,0:04:35.99,0:04:42.28,Default,,0,0,0,,♬～
Dialogue: 0,0:04:43.81,0:04:46.82,Default,,0,0,0,,Капитан Тревильге сәлем!
Dialogue: 0,0:04:51.99,0:04:55.27,Default,,0,0,0,,Иә? о?
Dialogue: 0,0:04:55.34,0:04:59.34,Default,,0,0,0,,Не? Сол қылыш. Атос Арамис Портос та!
Dialogue: 0,0:04:59.34,0:05:04.85,Default,,0,0,0,,Капитан Бұл достықтың белгісі. не? ➡
Dialogue: 0,0:05:04.85,0:05:09.14,Default,,0,0,0,,Мен д'Артаньянның қылышын сындырғандықтан, олар да сындырды дейсіз бе?
Dialogue: 0,0:05:09.17,0:05:12.96,Default,,0,0,0,,Біз д'Артаньянмен жекпе-жек өткізуге келістік.
Dialogue: 0,0:05:13.01,0:05:15.31,Default,,0,0,0,,Әрине, дуэльге тыйым салынады.
Dialogue: 0,0:05:15.33,0:05:18.83,Default,,0,0,0,,Егер капитан д'Артаньян жекпе-жек өткізбек болғанда оның қылышын сындырса ше?
Dialogue: 0,0:05:18.81,0:05:20.92,Default,,0,0,0,,Біз де кінәліміз.
Dialogue: 0,0:05:21.00,0:05:24.10,Default,,0,0,0,,Ол кезде д'Артаньян бізбен бірге болды➡
Dialogue: 0,0:05:24.15,0:05:26.64,Default,,0,0,0,,Ришельенің сүйемелдеуімен күресуге тырысты.
Dialogue: 0,0:05:26.67,0:05:31.18,Default,,0,0,0,,Осы кезде д'Артаньян екеуміздің арамызда достық басталды.
Dialogue: 0,0:05:31.18,0:05:35.48,Default,,0,0,0,,Балалар, сендер мушкетерлерсіңдер! Сынған қылыштар т.б. ілулі тұр➡
Dialogue: 0,0:05:35.50,0:05:38.80,Default,,0,0,0,,Төтенше жағдайда Мәртебеліге көмектесе алмасаңыз, не істер едіңіз?
Dialogue: 0,0:05:38.80,0:05:41.90,Default,,0,0,0,,Қылыш болмаса да, Ұлы мәртебеліге пайдалы болудың жолдары бар➡
Dialogue: 0,0:05:41.99,0:05:45.49,Default,,0,0,0,,Көп.
Dialogue: 0,0:05:45.51,0:05:51.11,Default,,0,0,0,,Мен сіздің ақымақтығыңызды түсінемін, Портос. Рахмет сізге.
Dialogue: 0,0:05:51.18,0:05:55.97,Default,,0,0,0,,Бірақ біз мушкетерлерге керексіз қылыштарды салбыратып жібере алмаймыз.
Dialogue: 0,0:05:55.98,0:05:57.99,Default,,0,0,0,,Оны дереу тиісті қылышпен ауыстырыңыз.
Dialogue: 0,0:05:58.00,0:06:01.61,Default,,0,0,0,,Олай болса, д'Артаньянның қылышын бастапқы қалпына келтіріңіз.
Dialogue: 0,0:06:01.64,0:06:03.64,Default,,0,0,0,,Ол мушкетер де емес.
Dialogue: 0,0:06:03.64,0:06:06.65,Default,,0,0,0,,Бірақ мен оның мушкетер болғысы келетініне сенімдімін.
Dialogue: 0,0:06:06.63,0:06:09.63,Default,,0,0,0,,Оны неге мушкетер етпейсің?
Dialogue: 0,0:06:09.68,0:06:12.47,Default,,0,0,0,,Әлі ерте. Оның үстіне сен әлі баласың ғой, солай ма?
Dialogue: 0,0:06:12.50,0:06:16.81,Default,,0,0,0,,Қалай десек те, бұл сынған қылышымыз достығымыздың белгісі. ➡
Dialogue: 0,0:06:16.84,0:06:21.34,Default,,0,0,0,,Д'Артаньянға айтпа, қылышты қалпына келтіретін жалғыз біз бола алмаймыз!
Dialogue: 0,0:06:21.34,0:06:24.13,Default,,0,0,0,,Мен ол баланы сендіремін. ➡
Dialogue: 0,0:06:24.18,0:06:27.27,Default,,0,0,0,,Мені кейінірек әкеліңіз. Күрсін. Мен оны түсіндім.
Dialogue: 0,0:06:27.35,0:06:31.34,Default,,0,0,0,,-да біз қылышты осыдан кейін бастапқы қалпына келтіреміз.
Dialogue: 0,0:06:31.32,0:06:33.92,Default,,0,0,0,,Қалағаныңды істе.
Dialogue: 0,0:06:38.01,0:06:42.11,Default,,0,0,0,,Бұл Атос. Ол үш мушкетердің кілті.
Dialogue: 0,0:06:42.16,0:06:45.27,Default,,0,0,0,,Егер сіз оны жеңсеңіз, Үш мушкетер ыдырап кетеді.
Dialogue: 0,0:06:45.32,0:06:48.82,Default,,0,0,0,,Жақсы дайындық. әрине.
Dialogue: 0,0:06:48.80,0:06:55.11,Default,,0,0,0,,♬～
Dialogue: 0,0:07:14.15,0:07:17.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:17.48,0:07:19.78,Default,,0,0,0,,Мм... Ах.
Dialogue: 0,0:07:35.97,0:07:38.07,Default,,0,0,0,,Жаса!
Dialogue: 0,0:07:38.15,0:07:44.44,Default,,0,0,0,,♬～
Dialogue: 0,0:07:48.65,0:07:51.45,Default,,0,0,0,,Сіз кімсіз! Есіміңді бер!
Dialogue: 0,0:07:51.48,0:07:57.77,Default,,0,0,0,,♬～
Dialogue: 0,0:08:06.31,0:08:10.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:16.34,0:08:20.13,Default,,0,0,0,,Хэхехе…. Қарғыс атсын. Хмм. Ку….
Dialogue: 0,0:08:20.16,0:08:23.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:23.48,0:08:25.58,Default,,0,0,0,,Эй... Хёуна!
Dialogue: 0,0:08:31.64,0:08:34.24,Default,,0,0,0,,Ух... уф...
Dialogue: 0,0:08:37.48,0:08:40.28,Default,,0,0,0,,Хехехехе….
Dialogue: 0,0:08:42.65,0:08:44.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:47.31,0:08:49.31,Default,,0,0,0,,Өл!
Dialogue: 0,0:08:49.31,0:08:52.91,Default,,0,0,0,,Қарғыс атсын.
Dialogue: 0,0:08:53.01,0:08:56.61,Default,,0,0,0,,Іздеу! Сенің осында болатыныңа сенімдімін.
Dialogue: 0,0:09:03.47,0:09:05.77,Default,,0,0,0,,Әй?
Dialogue: 0,0:09:07.98,0:09:11.98,Default,,0,0,0,,Мен сенің сонда екеніңді білемін! Қазір шық!
Dialogue: 0,0:09:25.18,0:09:28.78,Default,,0,0,0,,Уау. (Рошфолл мен оның достарының айқайы)
Dialogue: 0,0:09:31.15,0:09:33.15,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:35.97,0:09:37.97,Default,,0,0,0,,Менің қашып кетуіме жол берме!
Dialogue: 0,0:09:38.01,0:09:40.29,Default,,0,0,0,,(Кристи) Ах! (Нат) Ах…
Dialogue: 0,0:09:45.98,0:09:47.98,Default,,0,0,0,,(Оқушы) Қайырлы таң. (Оқушы) Қайырлы таң. Ой, күйіп кеткен екен!
Dialogue: 0,0:09:50.34,0:09:52.84,Default,,0,0,0,,Жоқ... жоқ.
Dialogue: 0,0:09:52.80,0:09:55.81,Default,,0,0,0,,Chase! Маған қашып кетуіме жол берме!
Dialogue: 0,0:10:04.67,0:10:06.77,Default,,0,0,0,,Ах... Уф...
Dialogue: 0,0:10:12.16,0:10:14.14,Default,,0,0,0,,Иә, иә.
Dialogue: 0,0:10:15.99,0:10:19.80,Default,,0,0,0,,Атос! сұраңыз….
Dialogue: 0,0:10:19.80,0:10:21.80,Default,,0,0,0,,«Құрғап қалған болар ма?»
Dialogue: 0,0:10:30.68,0:10:34.78,Default,,0,0,0,,Атос, сен қайда жасырдың? Мұнда қан бар!
Dialogue: 0,0:10:39.35,0:10:43.64,Default,,0,0,0,,Сіз бұл жарамен алысқа бара алмайсыз. Хе.
Dialogue: 0,0:10:43.66,0:10:45.66,Default,,0,0,0,,Кім бұндай әрекет жасады?
Dialogue: 0,0:10:45.67,0:10:49.78,Default,,0,0,0,,Мен білмеймін. Олардың барлығы бетперде киген.
Dialogue: 0,0:10:49.84,0:10:52.33,Default,,0,0,0,,Бұл ақылсыз. Мен мүлде таң қалдым.
Dialogue: 0,0:10:52.33,0:10:56.13,Default,,0,0,0,,Уф. Кешіріңіз... мен сізге қиындық туғыздым.
Dialogue: 0,0:10:56.17,0:10:58.97,Default,,0,0,0,,Атос….
Dialogue: 0,0:10:58.99,0:11:01.59,Default,,0,0,0,,Ол есінен танып қалған сияқты.
Dialogue: 0,0:11:01.66,0:11:04.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:04.69,0:11:08.48,Default,,0,0,0,,Жарайды, семсерім сынғандықтан төбелесе алмадым.
Dialogue: 0,0:11:08.50,0:11:13.10,Default,,0,0,0,,Әйтпесе, Атос сияқты шебер қылышшының бұлай жеңілуі мүмкін емес.
Dialogue: 0,0:11:13.17,0:11:16.77,Default,,0,0,0,,Бұл менің кінәм. Кешіріңіз, Атос.
Dialogue: 0,0:11:20.17,0:11:23.78,Default,,0,0,0,,Жан Қараңызшы. Иә.
Dialogue: 0,0:11:23.81,0:11:26.92,Default,,0,0,0,,Сәлем! Оны ашыңыз!
Dialogue: 0,0:11:29.68,0:11:34.17,Default,,0,0,0,,Бұл қиын! Олар осында! Тәт~ жауды шығарамын!
Dialogue: 0,0:11:36.17,0:11:40.76,Default,,0,0,0,,Атос. Абырой болма, мені тапсыр.
Dialogue: 0,0:11:40.83,0:11:44.82,Default,,0,0,0,,Болды... Айтқаныңды істе.
Dialogue: 0,0:11:44.83,0:11:47.84,Default,,0,0,0,,Мен капитаннан сіз туралы жиі сұрайтынмын. ➡
Dialogue: 0,0:11:47.84,0:11:53.34,Default,,0,0,0,,Мен өлгеннен кейін ол сені мушкетші етіп алады.
Dialogue: 0,0:11:53.34,0:11:56.64,Default,,0,0,0,,Уф! а…. Атос...
Dialogue: 0,0:11:56.68,0:12:01.17,Default,,0,0,0,,⚟Оны ашыңыз! Сіз оны аша аласыз ба?
Dialogue: 0,0:12:01.13,0:12:04.74,Default,,0,0,0,,Уақыт ұтып, артқы есіктен қашуға тырыссаңыз да, ол жұмыс істемейді!
Dialogue: 0,0:12:04.82,0:12:06.92,Default,,0,0,0,,Енді құтылу мүмкін емес!
Dialogue: 0,0:12:07.01,0:12:11.01,Default,,0,0,0,,Не болды? Дәл осы жерде нашақорлар пана болған болуы керек.
Dialogue: 0,0:12:10.99,0:12:14.50,Default,,0,0,0,,Оны ақырын тапсырыңыз. Әйтпесе, сіз қиындыққа тап боласыз.
Dialogue: 0,0:12:14.51,0:12:19.10,Default,,0,0,0,,А, ра... зорлық көрсетуден аулақ болыңыз. (Рошфор) Онда нашақорды осында әкел.
Dialogue: 0,0:12:19.15,0:12:21.65,Default,,0,0,0,,Бұл... Жалқау болма!
Dialogue: 0,0:12:21.67,0:12:24.47,Default,,0,0,0,,Жоқ, ол ауыр жарақат алып, есінен танып қалды➡
Dialogue: 0,0:12:24.51,0:12:29.51,Default,,0,0,0,,Оны жылжыту мүмкін емес. Оны қолымызбен жүргізіп, бағыттаңыз.
Dialogue: 0,0:12:29.51,0:12:33.80,Default,,0,0,0,,А... м, міне, осы.
Dialogue: 0,0:12:39.64,0:12:41.64,Default,,0,0,0,,Сол жерде.
Dialogue: 0,0:12:49.16,0:12:53.47,Default,,0,0,0,,Ух, Париждің үш мушкетері аянышты.
Dialogue: 0,0:12:53.50,0:12:56.60,Default,,0,0,0,,Соңғы соққыны алғыңыз келе ме? Күте тұрыңыз, бұл жерде жұмыс істемейді.
Dialogue: 0,0:12:56.67,0:13:00.98,Default,,0,0,0,,Менің денем бәрібір қарсы тұра алмайды, мені өзіңмен бірге ала кет. Мен оны түсіндім.
Dialogue: 0,0:13:04.33,0:13:07.83,Default,,0,0,0,,Бүгінгі күн туралы ешкімге айтпа. Иә... Иә.
Dialogue: 0,0:13:07.82,0:13:10.82,Default,,0,0,0,,Бұл тыныш ақша.
Dialogue: 0,0:13:10.85,0:13:15.64,Default,,0,0,0,,Ей, бұл жігіт жақсы. (Рошфолл) Кеттік!
Dialogue: 0,0:13:25.98,0:13:32.27,Default,,0,0,0,,♬～
Dialogue: 0,0:13:57.33,0:13:59.93,Default,,0,0,0,,Мықтап ұстаңыз. Ха.
Dialogue: 0,0:14:11.83,0:14:15.83,Default,,0,0,0,,Жарайды, бұл тереңдікте жақсы. Ерен еңбегіңіз үшін рахмет.
Dialogue: 0,0:14:15.83,0:14:19.44,Default,,0,0,0,,Балалар, алдымен сендер кетулерің керек. Ха.
Dialogue: 0,0:14:21.17,0:14:25.48,Default,,0,0,0,,Соңғы соққыны берейік. Тек оны толтырыңыз.
Dialogue: 0,0:14:25.51,0:14:31.80,Default,,0,0,0,,Қалай болғанда да сол күйінде қалдырсаң, өмір болмайды. Иә, мен ақылдымын.
Dialogue: 0,0:14:34.50,0:14:36.80,Default,,0,0,0,,Хехе, қош бол Атос. ➡
Dialogue: 0,0:14:36.82,0:14:41.13,Default,,0,0,0,,Мен Арамис пен Портосты бірден жіберемін.
Dialogue: 0,0:14:49.48,0:14:52.27,Default,,0,0,0,,Жарайды, бұл жақсы болуы керек.
Dialogue: 0,0:14:52.34,0:14:55.44,Default,,0,0,0,,Ал, Джуссак, кеттік. иә.
Dialogue: 0,0:15:03.16,0:15:05.67,Default,,0,0,0,,Асығыңыз! Rocinante!
Dialogue: 0,0:15:07.34,0:15:11.14,Default,,0,0,0,,Асығыңыз! Асықпасаң, шынымен өлесің!
Dialogue: 0,0:15:16.84,0:15:20.45,Default,,0,0,0,,Ах~ Аллаға шүкір, уақытында жасадым!
Dialogue: 0,0:15:20.50,0:15:24.80,Default,,0,0,0,,А, бұл өте ауыр болды~ Фу.
Dialogue: 0,0:15:24.82,0:15:27.82,Default,,0,0,0,,Келіңіздер, мұндай жерде ұзақ тұрудың қажеті жоқ!
Dialogue: 0,0:15:27.81,0:15:30.61,Default,,0,0,0,,Тоқта, күт, біз оларды жазалауымыз керек.
Dialogue: 0,0:15:30.64,0:15:33.24,Default,,0,0,0,,Мен саған бірдеңе көрсетемін.
Dialogue: 0,0:15:41.00,0:15:47.01,Default,,0,0,0,,Енді үш мушкетердің бір бұрышы құлады. Қалғаны жоспарлағандай өтті.
Dialogue: 0,0:15:46.99,0:15:49.28,Default,,0,0,0,,Еш нәрсе айналып өтпейді.
Dialogue: 0,0:15:49.33,0:15:54.33,Default,,0,0,0,,⚟ (қорқынышты дауыспен) Рошефол Рошефол!
Dialogue: 0,0:15:54.35,0:15:58.14,Default,,0,0,0,,Бұл кім? иә? иә?
Dialogue: 0,0:15:58.15,0:16:02.16,Default,,0,0,0,,⚟Рошфолл….
Dialogue: 0,0:16:05.49,0:16:08.48,Default,,0,0,0,,Қайдасың? Шығу!
Dialogue: 0,0:16:08.51,0:16:11.60,Default,,0,0,0,,А... бұл... иә? Апыр-ай!
Dialogue: 0,0:16:11.65,0:16:17.44,Default,,0,0,0,,♬～
Dialogue: 0,0:16:17.49,0:16:23.58,Default,,0,0,0,,Мен сені күттім... Рошфорт.
Dialogue: 0,0:16:23.71,0:16:26.31,Default,,0,0,0,,О... сен Атоссың.
Dialogue: 0,0:16:28.30,0:16:32.59,Default,,0,0,0,,Мен~ Сіз адасып қалдыңыз ба?
Dialogue: 0,0:16:32.65,0:16:34.66,Default,,0,0,0,,«Құрғап қалған болар ма?»
Dialogue: 0,0:16:37.33,0:16:40.83,Default,,0,0,0,,Бағана. ➡
Dialogue: 0,0:16:40.83,0:16:43.61,Default,,0,0,0,,Жоқ! Ақыр аяғында бұл елес!
Dialogue: 0,0:16:43.66,0:16:48.27,Default,,0,0,0,,Бұл елес пе, жоқ па, бұл жолы соңғы соққыны мен берем!
Dialogue: 0,0:16:48.32,0:16:52.92,Default,,0,0,0,,Бұл жұмыс істеді. Енді келесіге көшейік. Жақсы.
Dialogue: 0,0:16:52.97,0:16:55.58,Default,,0,0,0,,Қайда жоғалып кетті! Атос!
Dialogue: 0,0:16:55.64,0:16:57.65,Default,,0,0,0,,(Бумеранг ұшқан дыбыс)
Dialogue: 0,0:16:57.65,0:16:59.95,Default,,0,0,0,,Ta! иә?
Dialogue: 0,0:16:59.98,0:17:02.58,Default,,0,0,0,,Жалғастырыңыз.
Dialogue: 0,0:17:02.65,0:17:04.65,Default,,0,0,0,,Бұл — радио гимнастика.
Dialogue: 0,0:17:06.99,0:17:08.99,Default,,0,0,0,,Сен істедің, аруақ!
Dialogue: 0,0:17:08.99,0:17:11.49,Default,,0,0,0,,Міне болды. О құдайым-ай?
Dialogue: 0,0:17:14.98,0:17:17.28,Default,,0,0,0,,Қош бол.
Dialogue: 0,0:17:19.33,0:17:22.94,Default,,0,0,0,,Бұл... Менің ойымша, бұл жерде болды.
Dialogue: 0,0:17:23.00,0:17:28.09,Default,,0,0,0,,Бұл елес болғандықтан, оның жоғалып кетуі табиғи нәрсе. Тез барайық, себебі бұл қорқынышты.
Dialogue: 0,0:17:28.14,0:17:34.45,Default,,0,0,0,,(Жел дыбыстары мен оғаш дыбыстар)
Dialogue: 0,0:17:38.19,0:17:43.17,Default,,0,0,0,,⚟ (қорқынышты дауыспен) Рошефол, қашпа!
Dialogue: 0,0:17:50.31,0:17:52.90,Default,,0,0,0,,Бұл шықты!
Dialogue: 0,0:17:55.65,0:17:57.66,Default,,0,0,0,,Эй, сәл күте тұрыңыз!
Dialogue: 0,0:17:57.67,0:17:59.77,Default,,0,0,0,,Джу... Джуссак Бірдеңе істе!
Dialogue: 0,0:17:59.84,0:18:01.84,Default,,0,0,0,,Жоқ, сен солай айттың...
Dialogue: 0,0:18:01.84,0:18:05.33,Default,,0,0,0,,Сіз бойдақсыз, солай ма? Сен өлсең де, ешкім қайғырмайды!
Dialogue: 0,0:18:05.35,0:18:08.43,Default,,0,0,0,,Жоқ, жоқ, мен де ғашық болғым келеді.
Dialogue: 0,0:18:08.48,0:18:14.79,Default,,0,0,0,,(Екі адам ауыр тыныс алуда)
Dialogue: 0,0:18:18.01,0:18:20.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:19.98,0:18:23.98,Default,,0,0,0,,♬～
Dialogue: 0,0:18:24.00,0:18:26.00,Default,,0,0,0,,Немесе...
Dialogue: 0,0:18:28.82,0:18:31.32,Default,,0,0,0,,Бүгінгі тақырып:
Dialogue: 0,0:18:33.49,0:18:35.49,Default,,0,0,0,,Бұл шықты! Ол шықты!
Dialogue: 0,0:18:37.18,0:18:40.97,Default,,0,0,0,,Сіздің бетіңіз шынымен ұзын болды. Бұл... адам ба?
Dialogue: 0,0:18:40.97,0:18:44.47,Default,,0,0,0,,Бұл елес! Бұл адам болуы мүмкін емес!
Dialogue: 0,0:18:44.49,0:18:46.89,Default,,0,0,0,,Ах. Апыр-ай!
Dialogue: 0,0:18:48.66,0:18:51.14,Default,,0,0,0,,Әй?
Dialogue: 0,0:18:51.18,0:18:55.68,Default,,0,0,0,,А... мен оны жаңа ғана жерлеген жерім.
Dialogue: 0,0:18:55.68,0:19:01.49,Default,,0,0,0,,Жарайды... жарайды. Мм... не... не істеуді жоспарлап отырсың?
Dialogue: 0,0:19:01.49,0:19:03.59,Default,,0,0,0,,Мен мәйітті тексеремін.
Dialogue: 0,0:19:03.67,0:19:06.47,Default,,0,0,0,,Жасайық. Маған қарамай көмектес.
Dialogue: 0,0:19:06.51,0:19:10.81,Default,,0,0,0,,Мәйіт болмаса, ол елес емес. Бұл Атос.
Dialogue: 0,0:19:17.34,0:19:21.64,Default,,0,0,0,,Мәйіт сол қалпында қалады. сондай-ақ….
Dialogue: 0,0:19:21.67,0:19:24.28,Default,,0,0,0,,... Қаш, Джуссак. Тұру.
Dialogue: 0,0:19:24.33,0:19:27.61,Default,,0,0,0,,Жоқ, менің арқам...
Dialogue: 0,0:19:27.65,0:19:29.75,Default,,0,0,0,,Бүгінгі тақырып:
Dialogue: 0,0:19:33.48,0:19:36.09,Default,,0,0,0,,Бүгінгі тақырып:
Dialogue: 0,0:19:40.31,0:19:42.61,Default,,0,0,0,,Күтіңіз.
Dialogue: 0,0:19:42.64,0:19:45.65,Default,,0,0,0,,Бүгінгі тақырып:
Dialogue: 0,0:19:45.66,0:19:48.77,Default,,0,0,0,,Қорқынышты! (Рошфолл) Маған көмектес!
Dialogue: 0,0:19:48.82,0:19:51.92,Default,,0,0,0,,Бүгінгі тақырып:
Dialogue: 0,0:19:51.99,0:19:54.97,Default,,0,0,0,,Қош бол.
Dialogue: 0,0:19:54.97,0:19:58.78,Default,,0,0,0,,А, бұл қызық болды.
Dialogue: 0,0:19:58.81,0:20:01.61,Default,,0,0,0,,Енді олар жазаланады.
Dialogue: 0,0:20:01.68,0:20:03.78,Default,,0,0,0,,Бұл жақсы сезінеді! (Росинантенің жылағаны)
Dialogue: 0,0:20:03.81,0:20:07.60,Default,,0,0,0,,(айқай)
Dialogue: 0,0:20:07.67,0:20:11.97,Default,,0,0,0,,Сіз не істеп жатырсыз? Rocinante. Ол епсіз жігіт.
Dialogue: 0,0:20:11.99,0:20:18.30,Default,,0,0,0,,Хахахахаха...!
Dialogue: 0,0:20:19.81,0:20:26.12,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:20:29.01,0:20:33.29,Default,,0,0,0,,Атосты құтқарғаныңыз үшін рахмет. Сізге шын жүректен алғыс айтқым келеді.
Dialogue: 0,0:20:33.34,0:20:36.33,Default,,0,0,0,,Әрине. Өйткені біз доспыз.
Dialogue: 0,0:20:36.31,0:20:40.92,Default,,0,0,0,,Д'Артаньян Мен сені мушкетерлерге шәкірт етіп тағайындаймын.
Dialogue: 0,0:20:40.97,0:20:43.25,Default,,0,0,0,,Не? Бұл рас па?
Dialogue: 0,0:20:43.34,0:20:45.94,Default,,0,0,0,,Бұл менің сыпайылығым. Сіз оны қабылдайсыз ба?
Dialogue: 0,0:20:45.99,0:20:48.78,Default,,0,0,0,,Әрине! Қалай рахмет айтамын...
Dialogue: 0,0:20:48.84,0:20:52.45,Default,,0,0,0,,Қуануға әлі ерте. Олар ресми мүше емес.
Dialogue: 0,0:20:52.51,0:20:55.50,Default,,0,0,0,,Иә. Шәкірттік немесе кез келген нәрсе жақсы.
Dialogue: 0,0:20:55.50,0:20:57.60,Default,,0,0,0,,Егер сіз көп еңбек етсеңіз, соңында мушкетер бола аласыз, солай ма?
Dialogue: 0,0:20:57.67,0:20:59.95,Default,,0,0,0,,Иә. Бірақ жақсылап есте сақтаңыз. ➡
Dialogue: 0,0:20:59.97,0:21:03.77,Default,,0,0,0,,Егер мушкеттердің абыройына нұқсан келтіретін әрекет жасасаңыз, бірден жұмыстан қуылады.
Dialogue: 0,0:21:03.84,0:21:07.65,Default,,0,0,0,,Иә! Сізге жақсы, д'Артаньян. Құттықтаймыз.
Dialogue: 0,0:21:07.68,0:21:12.27,Default,,0,0,0,,Рахмет Арамис Портос Атос.
Dialogue: 0,0:21:12.35,0:21:16.34,Default,,0,0,0,,Жоқ, мен сізге рахмет айтуым керек.
Dialogue: 0,0:21:16.34,0:21:19.34,Default,,0,0,0,,Бұл мен сындырған қылышыңның ұшы. ➡
Dialogue: 0,0:21:19.34,0:21:23.33,Default,,0,0,0,,Сіз білікті темір ұстасынан оны қалпына келтіруді сұрағыңыз келуі мүмкін.
Dialogue: 0,0:21:23.34,0:21:28.13,Default,,0,0,0,,Мен оған жаңа қылыш беруді ойладым, бірақ бұл оның әкесінің маңызды естелігі шығар.
Dialogue: 0,0:21:28.17,0:21:32.77,Default,,0,0,0,,Мен ұстаның ақысын төлеймін. рақмет сізге.
Dialogue: 0,0:21:34.49,0:21:36.59,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:21:43.81,0:21:46.32,Default,,0,0,0,,Yahoo!
Dialogue: 0,0:21:46.32,0:21:50.10,Default,,0,0,0,,Ах! Д'Артаньян!
Dialogue: 0,0:21:50.17,0:21:52.67,Default,,0,0,0,,Қалай болды? Жарайсың Жан!
Dialogue: 0,0:21:52.67,0:21:56.68,Default,,0,0,0,,Ақыры мушкеттердің шәкірті болдым. Сынған қылыш маған да қайтарылды.
Dialogue: 0,0:21:56.66,0:22:00.76,Default,,0,0,0,,Шынымен бе? жақсы. Құттықтаймыз д'Артаньян.
Dialogue: 0,0:22:00.83,0:22:04.94,Default,,0,0,0,,Констансқа рахмет. Біз дереу тойлауымыз керек.
Dialogue: 0,0:22:05.00,0:22:07.81,Default,,0,0,0,,Ах…. Бұл тойлауға жақсы уақыт.
Dialogue: 0,0:22:07.82,0:22:09.81,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:22:09.84,0:22:14.14,Default,,0,0,0,,Егер мушкетер болғың келсе, этикет маңызды! Осындай жерде кенет мені қалай сүйіп алдың?
Dialogue: 0,0:22:14.14,0:22:17.65,Default,,0,0,0,,көремін. Екеуміз ғана болғанымыз жақсы, солай ма?
Dialogue: 0,0:22:17.67,0:22:21.77,Default,,0,0,0,,Егер ол жұмыс істемесе, онда жоқ! Бетіңізден тағы бір шапалақпен ұрғыңыз келе ме?
Dialogue: 0,0:22:25.31,0:22:28.81,Default,,0,0,0,,Уау. Хмф!
Dialogue: 0,0:22:28.83,0:22:30.93,Default,,0,0,0,,Констанс….
Dialogue: 0,0:22:30.10,0:22:33.50,Default,,0,0,0,,д'Артаньян! Сақ болыңыз.
Dialogue: 0,0:22:33.51,0:22:37.50,Default,,0,0,0,,Әйелді күндіз қуу мушкетер сияқты емес.
Dialogue: 0,0:22:37.48,0:22:40.27,Default,,0,0,0,,Капитан біліп қалса, саған ұрысады.
Dialogue: 0,0:22:40.32,0:22:42.92,Default,,0,0,0,,Шәкірттік оқудан шығаруға болады ма?
Dialogue: 0,0:22:43.01,0:22:45.81,Default,,0,0,0,,Сәлем. Сондай тар мушкетерге➡
Dialogue: 0,0:22:45.84,0:22:49.35,Default,,0,0,0,,Неліктен болғың келеді? Д'Артаньян: Бұл сізге жарамайды.
Dialogue: 0,0:22:49.33,0:22:52.43,Default,,0,0,0,,Бұл жігіт. Қазірдің өзінде ауырады!
Dialogue: 0,0:22:52.50,0:22:57.50,Default,,0,0,0,,(Үш мушкетер мен д'Артаньянның күлкісі)
Dialogue: 0,0:23:00.81,0:23:07.11,Default,,0,0,0,,(қайықтың есу дыбысы)
Dialogue: 0,0:23:25.50,0:23:31.81,Default,,0,0,0,,«Жүрек дауысы» (Миледи) Букингем ақыры Парижге аттанады. Мен де баруым керек. ➡
Dialogue: 0,0:23:32.14,0:23:36.74,Default,,0,0,0,,Парижде кездескенше, Букингем герцогы.
Dialogue: 0,0:23:38.53,0:23:43.32,Default,,0,0,0,,Д'Артаньян ақыры мушкетер шәкірті болғанына қуанғанымен➡
Dialogue: 0,0:23:43.35,0:23:49.64,Default,,0,0,0,,Интриганың қара бұлты Париждің үстінен қайта орала бастады.
Dialogue: 0,0:23:53.31,0:23:59.62,Default,,0,0,0,,♬～
Dialogue: 0,0:24:01.12,0:24:07.12,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
