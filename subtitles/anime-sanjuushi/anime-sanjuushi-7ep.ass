Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.98,0:00:09.27,Default,,0,0,0,,♬～
Dialogue: 0,0:01:24.80,0:01:31.10,Default,,0,0,0,,♬～
Dialogue: 0,0:01:40.33,0:01:43.32,Default,,0,0,0,,Енді жоқ... тұтқынға аласың!
Dialogue: 0,0:01:43.33,0:01:45.83,Default,,0,0,0,,Жан, мұнда кел! иә?
Dialogue: 0,0:01:45.80,0:01:47.80,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:01:47.80,0:01:54.11,Default,,0,0,0,,♬～
Dialogue: 0,0:01:59.13,0:02:01.23,Default,,0,0,0,,Д'Артаньян және Жан➡
Dialogue: 0,0:02:01.30,0:02:05.90,Default,,0,0,0,,Букингем герцогын Ришелье тұзағынан құтқарды➡
Dialogue: 0,0:02:06.00,0:02:10.49,Default,,0,0,0,,Мен оның Лондонға аман-есен оралуына көмектестім.
Dialogue: 0,0:02:10.46,0:02:16.77,Default,,0,0,0,,♬～
Dialogue: 0,0:02:23.51,0:02:28.49,Default,,0,0,0,,Қош бол... Адие Букингем.
Dialogue: 0,0:02:28.49,0:02:34.10,Default,,0,0,0,,Королева Қайта кездескенше... О, Ребоир.
Dialogue: 0,0:02:34.13,0:02:40.44,Default,,0,0,0,,♬～
Dialogue: 0,0:03:22.16,0:03:25.17,Default,,0,0,0,,Енді үйге қайтайық. Қайда қайтып бара жатырсың?
Dialogue: 0,0:03:25.13,0:03:28.24,Default,,0,0,0,,Бұл біздің үй екен деп шешіп қойған.
Dialogue: 0,0:03:28.34,0:03:32.14,Default,,0,0,0,,Букингем герцогымен бірге үй де жоқ.
Dialogue: 0,0:03:32.17,0:03:36.76,Default,,0,0,0,,Не? Мен түсінемін. Бұл дұрыс.
Dialogue: 0,0:03:36.83,0:03:40.43,Default,,0,0,0,,Мен Парижге қайтып келгенде, ең бірінші ұйықтайтын жер табуым керек.
Dialogue: 0,0:03:40.50,0:03:43.50,Default,,0,0,0,,Сіз жаман нәрсе жасадыңыз. Жақсы. ➡
Dialogue: 0,0:03:43.50,0:03:49.79,Default,,0,0,0,,Үйсіз-күйсіз жүруге үйренгенмін. Жаңбыр жаумағанша, кез келген жерде ұйықтай аласыз.
Dialogue: 0,0:03:49.98,0:03:56.26,Default,,0,0,0,,Бұл менің соңғы өтінішім
Dialogue: 0,0:03:59.97,0:04:02.47,Default,,0,0,0,,Жаңбыр жиі жауады.
Dialogue: 0,0:04:02.47,0:04:04.57,Default,,0,0,0,,Уф, суық.
Dialogue: 0,0:04:04.67,0:04:07.26,Default,,0,0,0,,Хакерлік! Уф.
Dialogue: 0,0:04:07.36,0:04:09.86,Default,,0,0,0,,Амансың ба? Жан. аа….
Dialogue: 0,0:04:09.80,0:04:13.30,Default,,0,0,0,,Жаңбыр басылғанда, сәл жақсырақ жер іздейік.
Dialogue: 0,0:04:13.30,0:04:15.80,Default,,0,0,0,,⚟(Арба дыбысы)
Dialogue: 0,0:04:15.82,0:04:17.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:22.49,0:04:25.29,Default,,0,0,0,,Ко Констанс! д'Артаньян.
Dialogue: 0,0:04:25.33,0:04:28.83,Default,,0,0,0,,Мен осындай жерде болдым. Мен оны іздедім. сурет?
Dialogue: 0,0:04:28.81,0:04:31.40,Default,,0,0,0,,Сіз өмір сүрген қайық➡
Dialogue: 0,0:04:31.48,0:04:34.07,Default,,0,0,0,,Мен оны Букингем герцогіне берер едім.
Dialogue: 0,0:04:34.17,0:04:38.16,Default,,0,0,0,,Мен сені қиналып жүрген шығар деп ойладым. Ал... онша емес...
Dialogue: 0,0:04:38.16,0:04:41.46,Default,,0,0,0,,Қарсы болмасаң, әкеңнің үйінде біраз тұрғың келе ме?
Dialogue: 0,0:04:41.49,0:04:46.10,Default,,0,0,0,,Жоқ... жоқ, жарайды. Мұнда өте жақсы желдетілген және ыңғайлы.
Dialogue: 0,0:04:46.16,0:04:50.97,Default,,0,0,0,,Өтінішімді тыңдағаның үшін мен қайығымнан айырылдым.
Dialogue: 0,0:04:50.99,0:04:54.49,Default,,0,0,0,,Өтінемін. Хмм….
Dialogue: 0,0:04:54.49,0:04:58.29,Default,,0,0,0,,Жан! Констанс оны әкесінің үйіне қалдыратынын айтты.
Dialogue: 0,0:04:58.33,0:05:02.33,Default,,0,0,0,,Мм. Не, сен бақытты емессің бе?
Dialogue: 0,0:05:02.30,0:05:04.60,Default,,0,0,0,,Сіз дұрыс шатыр астында ұйықтай аласыз.
Dialogue: 0,0:05:04.63,0:05:08.24,Default,,0,0,0,,Бірақ адамдар алаңдаулы.
Dialogue: 0,0:05:08.30,0:05:10.41,Default,,0,0,0,,Бұл ысырапшылдықтың уақыты емес.
Dialogue: 0,0:05:10.47,0:05:12.47,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:05:12.49,0:05:15.29,Default,,0,0,0,,Сәлем, қош келдіңіз. Мәңгі осылай қалсам деп едім➡
Dialogue: 0,0:05:15.29,0:05:17.60,Default,,0,0,0,,Мен ауырып өлемін.
Dialogue: 0,0:05:21.82,0:05:28.12,Default,,0,0,0,,♬～
Dialogue: 0,0:05:28.14,0:05:31.24,Default,,0,0,0,,Осында отырыңыз.
Dialogue: 0,0:05:31.33,0:05:33.83,Default,,0,0,0,,Эй, тыңдап тұрмын.
Dialogue: 0,0:05:33.83,0:05:36.43,Default,,0,0,0,,Констанс үшін көп рахмет.
Dialogue: 0,0:05:36.48,0:05:40.89,Default,,0,0,0,,Бұл шектен шыққан. Королева үшін жұмыс істеу мушкеттердің міндеті.
Dialogue: 0,0:05:40.97,0:05:43.07,Default,,0,0,0,,Иә? Қашаннан бері мушкетер болдыңыз?
Dialogue: 0,0:05:43.17,0:05:46.78,Default,,0,0,0,,Шулы! Әлі емес, бірақ мен өзімді мушкетер сияқты сезінетінмін.
Dialogue: 0,0:05:46.83,0:05:50.63,Default,,0,0,0,,Сіз бір күні мушкетер боласыз, сондықтан қазірден бастап мұны жоспарлағаныңыз дұрыс емес пе?
Dialogue: 0,0:05:50.66,0:05:55.47,Default,,0,0,0,,Ах... Әйтеуір, бұл адамдар герцог Букингемге көмектесті➡
Dialogue: 0,0:05:55.50,0:05:59.29,Default,,0,0,0,,Мен тұратын жерімнен айырылдым. Сіз оны біраз уақытқа осында қалдыра аласыз ба?
Dialogue: 0,0:05:59.32,0:06:03.43,Default,,0,0,0,,О, жақсы. Рахмет, Бонасие мырза.
Dialogue: 0,0:06:03.48,0:06:06.88,Default,,0,0,0,,Өз кезегінде мен сіздерден біздің үйдегі тәртіпті сақтауларыңызды сұраймын.
Dialogue: 0,0:06:06.98,0:06:08.98,Default,,0,0,0,,А? Ережелер?
Dialogue: 0,0:06:08.98,0:06:12.48,Default,,0,0,0,,Біз өте тәртіпті және тәртіпті өмір сүреміз.
Dialogue: 0,0:06:12.50,0:06:16.81,Default,,0,0,0,,Ештеңе қиын емес, тек белгілі бір уақытта ояныңыз.
Dialogue: 0,0:06:16.84,0:06:19.34,Default,,0,0,0,,Мен мұны істей алмаймын.
Dialogue: 0,0:06:19.32,0:06:23.93,Default,,0,0,0,,Тез үйреніп кетесің. Сізге тек Марте айтқандай істеу керек. Малт.
Dialogue: 0,0:06:23.96,0:06:26.57,Default,,0,0,0,,күрсіну.
Dialogue: 0,0:06:26.67,0:06:28.97,Default,,0,0,0,,Иә, сэр.
Dialogue: 0,0:06:28.97,0:06:31.77,Default,,0,0,0,,А... иә.
Dialogue: 0,0:06:31.82,0:06:35.62,Default,,0,0,0,,Бүгіннен бастап д'Артаньян мен Жан біздің үйде тұрады.
Dialogue: 0,0:06:35.66,0:06:38.66,Default,,0,0,0,,Шатырдағы бөлме бос болды. Маған жол көрсетіңізші.
Dialogue: 0,0:06:38.66,0:06:41.26,Default,,0,0,0,,Мен ақылдымын. Танысқаныма қуаныштымын, Марто.
Dialogue: 0,0:06:41.33,0:06:45.42,Default,,0,0,0,,Уайымдамаңыз, жас ханым, оны Мальтаға қалдырыңыз.
Dialogue: 0,0:06:45.50,0:06:49.50,Default,,0,0,0,,Қош келдіңіз. иә. Хмм….
Dialogue: 0,0:06:49.47,0:06:52.26,Default,,0,0,0,,Осы жолмен.
Dialogue: 0,0:06:52.31,0:06:54.39,Default,,0,0,0,,А…?
Dialogue: 0,0:06:56.63,0:06:58.63,Default,,0,0,0,,Міне.
Dialogue: 0,0:07:00.30,0:07:04.40,Default,,0,0,0,,Иә. Бұл өте жоғары сапалы емес пе?
Dialogue: 0,0:07:10.33,0:07:13.63,Default,,0,0,0,,Ол жерден әлдеқайда жақсы, солай емес пе? Жан.
Dialogue: 0,0:07:13.65,0:07:16.25,Default,,0,0,0,,Бір ғана төсек бар.
Dialogue: 0,0:07:16.31,0:07:18.62,Default,,0,0,0,,Кейінірек тағы біреуін қосамын.
Dialogue: 0,0:07:18.67,0:07:22.15,Default,,0,0,0,,Міне, жас ханым сотқа қызмет етуге келеді➡
Dialogue: 0,0:07:22.17,0:07:26.66,Default,,0,0,0,,Мен оны қолдандым. сурет? Бұл Констанстың бөлмесі болды ма?
Dialogue: 0,0:07:26.66,0:07:29.96,Default,,0,0,0,,Сонда Констанс осы төсекте ұйықтап жатыр ма?
Dialogue: 0,0:07:29.10,0:07:35.08,Default,,0,0,0,,Констанс Констанс Констанс Констанс Констанс!
Dialogue: 0,0:07:35.17,0:07:38.27,Default,,0,0,0,,Жылыныңыз! Иә, иә.
Dialogue: 0,0:07:38.30,0:07:40.91,Default,,0,0,0,,Ахахахха мен ұялып қалдым.
Dialogue: 0,0:07:40.97,0:07:43.96,Default,,0,0,0,,Ей, мен қарауды тоқтата алмаймын!
Dialogue: 0,0:07:43.99,0:07:47.80,Default,,0,0,0,,Қалай болғанда да мен таңғы 6-да тұрып, таңғы ас 7-де ішемін.
Dialogue: 0,0:07:47.83,0:07:54.14,Default,,0,0,0,,Иә! Бұл ақымақ жылдам. Бұл үйдің ережесі.
Dialogue: 0,0:07:55.32,0:07:59.32,Default,,0,0,0,,Дұрыс, тұрақты өмір салты – денсаулық кепілі!
Dialogue: 0,0:07:59.31,0:08:01.31,Default,,0,0,0,,Вахахахаха!
Dialogue: 0,0:08:01.31,0:08:04.31,Default,,0,0,0,,(Қарғаның айқайы)
Dialogue: 0,0:08:04.30,0:08:10.60,Default,,0,0,0,,♬～
Dialogue: 0,0:08:16.51,0:08:18.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:21.66,0:08:24.27,Default,,0,0,0,,Иә, арсыз қарға.
Dialogue: 0,0:08:24.33,0:08:27.64,Default,,0,0,0,,Күтіңіз, күтіңіз. Бұл Миледидің тапсырмасы болуы мүмкін.
Dialogue: 0,0:08:32.47,0:08:35.28,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:08:35.33,0:08:39.43,Default,,0,0,0,,Күтілгендей. Лондон аралындағы үлкен стақанды ұстаңыз➡
Dialogue: 0,0:08:39.46,0:08:43.07,Default,,0,0,0,,Мен оны пайдаландым деп жазылған.
Dialogue: 0,0:08:43.17,0:08:46.17,Default,,0,0,0,,Иә? (Миледи) «Мәртебелі Ришелье.➡
Dialogue: 0,0:08:46.14,0:08:49.74,Default,,0,0,0,,Лондонға қайтып келген Букингем герцогының қозғалыстары туралы➡
Dialogue: 0,0:08:49.82,0:08:53.43,Default,,0,0,0,,Біз сізге мүмкіндігінше тезірек хабарлаймыз. ➡
Dialogue: 0,0:08:53.50,0:08:58.48,Default,,0,0,0,,Букингем Анна патшайымның оны жалған хатпен Парижге азғырғанына ашуланды➡
Dialogue: 0,0:08:58.47,0:09:02.47,Default,,0,0,0,,Біз шындықты анықтау үшін жолға шықтық».
Dialogue: 0,0:09:02.50,0:09:06.31,Default,,0,0,0,,Жүрек үні: Мен, Ришелье, жалған хаттың дәлелін алған кезде➡
Dialogue: 0,0:09:06.32,0:09:10.43,Default,,0,0,0,,Мен Франция короліне наразылық білдіремін және оны премьер-министр қызметінен қуамын.
Dialogue: 0,0:09:10.50,0:09:15.28,Default,,0,0,0,,«Ол болмай тұрып, Анна патшайым сарайдан қуылады➡
Dialogue: 0,0:09:15.32,0:09:18.80,Default,,0,0,0,,Менің ойымша, бұл сізге жақсы идея болар еді».
Dialogue: 0,0:09:18.82,0:09:22.12,Default,,0,0,0,,(ысқырық пен қарға қарға)
Dialogue: 0,0:09:29.65,0:09:33.15,Default,,0,0,0,,Барыңыз. (қарға)
Dialogue: 0,0:09:36.29,0:09:38.59,Default,,0,0,0,,Егер бұл орын алса, не қажет болса, соны орындаңыз➡
Dialogue: 0,0:09:38.66,0:09:40.76,Default,,0,0,0,,Бұл Букингем патшайымды көруге жасырын келген➡
Dialogue: 0,0:09:40.84,0:09:44.63,Default,,0,0,0,,Мен мұны ұлы мәртебеліге дәлелдеуім керек. Ол үшін куәгер керек.
Dialogue: 0,0:09:44.63,0:09:47.93,Default,,0,0,0,,Сол мушкетер Арамис Букингемді жасырған➡
Dialogue: 0,0:09:48.00,0:09:52.10,Default,,0,0,0,,Бар болғаны мойындау керек. Оны ұстап алып, мойындатайық.
Dialogue: 0,0:09:52.17,0:09:55.16,Default,,0,0,0,,Ал егер патшайым мұны істеуімді сұраса➡
Dialogue: 0,0:09:55.14,0:09:57.24,Default,,0,0,0,,Дәл осындай қылмысқа патшайым да кінәлі.
Dialogue: 0,0:09:57.31,0:10:00.41,Default,,0,0,0,,Бұл жалғыз нұсқа. Мен оны сұрадым.
Dialogue: 0,0:10:00.46,0:10:06.77,Default,,0,0,0,,♬～
Dialogue: 0,0:10:08.82,0:10:13.12,Default,,0,0,0,,Ханшайым! Не болды, Констанс, сен сонша асығып тұрсың ба?
Dialogue: 0,0:10:13.16,0:10:16.76,Default,,0,0,0,,Міне, Букингем мырзадан хат келді.
Dialogue: 0,0:10:16.81,0:10:19.60,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:10:19.65,0:10:23.45,Default,,0,0,0,,Шеврой ханымның тапсырмасы оны сізге жасырын түрде жеткізді.
Dialogue: 0,0:10:23.50,0:10:27.79,Default,,0,0,0,,Бұл жақсы нәрсе. Сіздің Лондонға аман-есен оралғаныңызды естідім.
Dialogue: 0,0:10:27.81,0:10:30.09,Default,,0,0,0,,Қазір мен өзімді қауіпсіз сезінемін.
Dialogue: 0,0:10:30.14,0:10:33.23,Default,,0,0,0,,Айтпақшы, «Мен де Париждегі моншаға бардым, сонда өзімді күтіп алдым➡
Dialogue: 0,0:10:33.33,0:10:37.63,Default,,0,0,0,,«Танысқаныма қуаныштымын» деп жазылған... Ах, д'Артаньян мен Жан туралы.
Dialogue: 0,0:10:37.65,0:10:40.74,Default,,0,0,0,,Иә! Мен сізге қандай да бір түрде алғыс айтуым керек.
Dialogue: 0,0:10:40.82,0:10:43.92,Default,,0,0,0,,Қазір не істеп жатырсың? Иә, мен әкемнің үйіндемін.
Dialogue: 0,0:10:43.99,0:10:49.09,Default,,0,0,0,,Демек, әкеңіз д'Артаньян екеуіңіздің араңыздағы қарым-қатынасты мойындап қойған.
Dialogue: 0,0:10:49.16,0:10:52.66,Default,,0,0,0,,Маған бұл ұнамайды, патшайым. Мен жай тұрғынмын.
Dialogue: 0,0:10:52.63,0:10:55.73,Default,,0,0,0,,Иә? Уфуфуфуфу….
Dialogue: 0,0:10:58.30,0:11:04.59,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:11:09.66,0:11:12.77,Default,,0,0,0,,Хмм…. Хмм.
Dialogue: 0,0:11:12.82,0:11:15.92,Default,,0,0,0,,(Қатты қағу және Джиннің қорылдауы)
Dialogue: 0,0:11:16.00,0:11:19.51,Default,,0,0,0,,д'Артаньян! Жан! Оян, сағат 6 болды!
Dialogue: 0,0:11:21.49,0:11:24.80,Default,,0,0,0,,Бұл тітіркендіргіш. Маған тағы біраз ұйықтауға рұқсат етіңізші.
Dialogue: 0,0:11:24.83,0:11:28.62,Default,,0,0,0,,⚟Сен тұрмайынша мен бөлмені жинай алмаймын!
Dialogue: 0,0:11:28.63,0:11:31.64,Default,,0,0,0,,Бөлмелер тазалауға арналған, солай ма?
Dialogue: 0,0:11:31.65,0:11:35.16,Default,,0,0,0,,Сәлем Джан Жан! Бұл не?
Dialogue: 0,0:11:35.16,0:11:38.26,Default,,0,0,0,,Оян да, сені жалғыз қалдыруымды айт.
Dialogue: 0,0:11:38.33,0:11:40.93,Default,,0,0,0,,Өзіңіз айтыңыз. Ендеше міне ➡
Dialogue: 0,0:11:40.98,0:11:43.78,Default,,0,0,0,,Мен қарапайым үйде тұрғым келмейді дедім.
Dialogue: 0,0:11:43.80,0:11:46.60,Default,,0,0,0,,Мүлдем емес...
Dialogue: 0,0:11:46.63,0:11:50.14,Default,,0,0,0,,Оянбайсың ба? Иә?
Dialogue: 0,0:11:50.14,0:11:53.14,Default,,0,0,0,,Констанс төмен түсіп келе жатса да...
Dialogue: 0,0:11:53.16,0:11:55.66,Default,,0,0,0,,Тіпті Констанс! ? Эй Жан!
Dialogue: 0,0:11:55.66,0:11:58.16,Default,,0,0,0,,Жан, оян! Оян!
Dialogue: 0,0:11:58.13,0:12:01.73,Default,,0,0,0,,Бұл не? Сіз өте шулысыз.
Dialogue: 0,0:12:01.85,0:12:04.95,Default,,0,0,0,,Констанс осында! Тез бетіңізді жуыңыз!
Dialogue: 0,0:12:04.97,0:12:07.47,Default,,0,0,0,,Ұсқынсыз жүзбен көрінбе!
Dialogue: 0,0:12:07.47,0:12:09.47,Default,,0,0,0,,Хмм, дұрыс.
Dialogue: 0,0:12:13.33,0:12:15.63,Default,,0,0,0,,Қайырлы таң. қайырлы таң.
Dialogue: 0,0:12:15.68,0:12:18.97,Default,,0,0,0,,Иә! Тет, тет, тет!
Dialogue: 0,0:12:20.65,0:12:23.96,Default,,0,0,0,,Ол сондай шулы жігіт.
Dialogue: 0,0:12:23.99,0:12:25.99,Default,,0,0,0,,Қайырлы таң, д'Артаньян.
Dialogue: 0,0:12:26.01,0:12:30.80,Default,,0,0,0,,Иә? Қайырлы таң, Бонасие мырза.
Dialogue: 0,0:12:33.48,0:12:35.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:35.63,0:12:38.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:39.00,0:12:43.29,Default,,0,0,0,,Констанс қайда орналасқан? Констанс сияқты ештеңе жоқ.
Dialogue: 0,0:12:43.32,0:12:45.63,Default,,0,0,0,,Иә? Өйткені Марто...
Dialogue: 0,0:12:45.64,0:12:48.13,Default,,0,0,0,,Ойланып қарасам, оянғандықтан шығар.
Dialogue: 0,0:12:48.16,0:12:51.77,Default,,0,0,0,,Е... бұл дұрыс емес. Констанс ше?
Dialogue: 0,0:12:51.82,0:12:55.92,Default,,0,0,0,,Бұл өтірік. Маған солай көрінеді.
Dialogue: 0,0:12:55.95,0:12:59.06,Default,,0,0,0,,Иә? аа….
Dialogue: 0,0:12:59.14,0:13:01.94,Default,,0,0,0,,(Мальт гуілі)
Dialogue: 0,0:13:01.98,0:13:04.28,Default,,0,0,0,,Малт! Есіңізде болсын!
Dialogue: 0,0:13:04.33,0:13:08.33,Default,,0,0,0,,Хахахаха. Бұл әлдеқашан болды, сондықтан мен бұл туралы ештеңе істей алмаймын.
Dialogue: 0,0:13:08.33,0:13:11.32,Default,,0,0,0,,Бетіңізді жуыңыз. "Ерте тұру - қасиет" дейді➡
Dialogue: 0,0:13:11.30,0:13:13.30,Default,,0,0,0,,Мүмкін қазір жақсы нәрсе болатын шығар.
Dialogue: 0,0:13:13.30,0:13:17.41,Default,,0,0,0,,Мен бетімді жуып қойғанмын! Эй!
Dialogue: 0,0:13:19.64,0:13:22.75,Default,,0,0,0,,О.
Dialogue: 0,0:13:22.83,0:13:26.93,Default,,0,0,0,,Констанс! қайырлы таң! д'Артаньян.
Dialogue: 0,0:13:26.99,0:13:31.59,Default,,0,0,0,,Қайырлы таң! Констанс. Бұл Констанс! Бұл Констанс!
Dialogue: 0,0:13:31.66,0:13:34.76,Default,,0,0,0,,Бонасие мырза айтқандай, ерте тұру жақсы болды.
Dialogue: 0,0:13:34.84,0:13:36.84,Default,,0,0,0,,Қайырлы таң, әке.
Dialogue: 0,0:13:36.83,0:13:39.13,Default,,0,0,0,,Иә? Не болды? Констанс.
Dialogue: 0,0:13:39.16,0:13:42.67,Default,,0,0,0,,Королева маған демалыс берді деп ойламаймын.
Dialogue: 0,0:13:42.63,0:13:45.44,Default,,0,0,0,,№. Букингем мырзадан➡
Dialogue: 0,0:13:45.47,0:13:48.07,Default,,0,0,0,,Лондонға аман-есен оралғаным туралы хабар алдым➡
Dialogue: 0,0:13:48.16,0:13:50.66,Default,,0,0,0,,Сыйлық ретінде патшайым маған жақсы демалыс берді.
Dialogue: 0,0:13:50.66,0:13:53.66,Default,,0,0,0,,Я~ Түсіндім. Сонымен, сіз оны жеңілдете аласыз ба?
Dialogue: 0,0:13:53.68,0:13:56.78,Default,,0,0,0,,Иә. Мен д'Артаньян мен Жанға да қарыздар едім➡
Dialogue: 0,0:13:56.81,0:13:59.92,Default,,0,0,0,,Мен бүгін саған дәмді нәрсе жасаймын деп ойладым.
Dialogue: 0,0:13:59.98,0:14:03.99,Default,,0,0,0,,Мен бұл үшін ризамын. Ондай жағдайда неге Арамисті де шақырмайсың?
Dialogue: 0,0:14:03.99,0:14:07.79,Default,,0,0,0,,Иә, жақсы нәрсе айттыңыз. Арамис маған көп көмектесті.
Dialogue: 0,0:14:07.83,0:14:11.33,Default,,0,0,0,,Жан, маған қоңырау шалыңыз. Неге өзің бармайсың?
Dialogue: 0,0:14:11.33,0:14:15.93,Default,,0,0,0,,Мен Констансқа мерекені дайындауға көмектесуім керек.
Dialogue: 0,0:14:16.00,0:14:20.81,Default,,0,0,0,,Хмф! Сіз Констанстың жанынан аз уақыт болса да кеткіңіз келмейді!
Dialogue: 0,0:14:20.82,0:14:24.33,Default,,0,0,0,,Білсең, тез барып Арамисті ал.
Dialogue: 0,0:14:24.31,0:14:27.31,Default,,0,0,0,,Бетімді жуғаныма біраз болды.
Dialogue: 0,0:14:27.35,0:14:32.43,Default,,0,0,0,,Мен оны бірден пайдаланып жатқаныма сене алар емеспін... Хмф! Мен енді бетімді жуудың қажеті жоқ!
Dialogue: 0,0:14:51.99,0:14:55.29,Default,,0,0,0,,Бұл кім? Бұл күзет капитаны Джуссак.
Dialogue: 0,0:14:55.34,0:14:58.14,Default,,0,0,0,,Мен граф Рошфортқа тапсырмамен келдім. Өтінемін, ашыңыз.
Dialogue: 0,0:14:58.14,0:15:00.23,Default,,0,0,0,,⚟Күтіңіз.
Dialogue: 0,0:15:00.33,0:15:02.93,Default,,0,0,0,,Жарайсың ба? Оны қалдырмаңыз. Ха.
Dialogue: 0,0:15:05.33,0:15:09.14,Default,,0,0,0,,Не? Арамис мушкетер.
Dialogue: 0,0:15:09.14,0:15:11.94,Default,,0,0,0,,Ах…. Мені ал!
Dialogue: 0,0:15:11.96,0:15:13.96,Default,,0,0,0,,(Каори) Жоқ, бірақ... (Косей) Ақыл-жастарың ұқсас болғандықтан ба?
Dialogue: 0,0:15:18.15,0:15:20.95,Default,,0,0,0,,Қарсы шықсаң, мен сені атып тастаймын.
Dialogue: 0,0:15:25.47,0:15:27.47,Default,,0,0,0,,«Құрғап қалған болар ма?»
Dialogue: 0,0:15:30.49,0:15:34.50,Default,,0,0,0,,Фуфуфуфу... Келдің бе?
Dialogue: 0,0:15:34.50,0:15:40.30,Default,,0,0,0,,Бұны саған кім бұйырды? Мен Мәртебелі мушкетермін.
Dialogue: 0,0:15:40.32,0:15:42.30,Default,,0,0,0,,Жарайды, мін!
Dialogue: 0,0:15:59.30,0:16:01.41,Default,,0,0,0,,Арамис….
Dialogue: 0,0:16:07.46,0:16:09.86,Default,,0,0,0,,Жақсы! Бұл жақсы ет.
Dialogue: 0,0:16:09.98,0:16:13.08,Default,,0,0,0,,Королева оны маған д'Артаньян мен Жан үшін берді.
Dialogue: 0,0:16:13.13,0:16:15.14,Default,,0,0,0,,«Құрғап қалған болар ма?»
Dialogue: 0,0:16:15.15,0:16:17.26,Default,,0,0,0,,Сәлем. Ухуху.
Dialogue: 0,0:16:17.31,0:16:20.61,Default,,0,0,0,,Мәртебелі аңшылықта өлтірген қабанның еті.
Dialogue: 0,0:16:20.64,0:16:23.14,Default,,0,0,0,,Мен сізге дәмді тұздық дайындаймын.
Dialogue: 0,0:16:23.16,0:16:28.27,Default,,0,0,0,,Жақсы! Мен саған көмектесемін! Бұл жақсы! Сіз жолдасыз, сондықтан кетіңіз!
Dialogue: 0,0:16:28.33,0:16:34.32,Default,,0,0,0,,Мен де Констансқа көмектескім келеді.
Dialogue: 0,0:16:34.32,0:16:38.33,Default,,0,0,0,,Бұл не? Бұл дәмдеуіш.
Dialogue: 0,0:16:38.33,0:16:40.93,Default,,0,0,0,,Хехекция!
Dialogue: 0,0:16:41.00,0:16:44.50,Default,,0,0,0,,Бұл бұрыш! Бұл дұрыс.
Dialogue: 0,0:16:44.50,0:16:47.90,Default,,0,0,0,,Бұл жағдайда... Hection! Hection!
Dialogue: 0,0:16:47.97,0:16:51.06,Default,,0,0,0,,Ер адам болса да, асүйді аралап жүреді.
Dialogue: 0,0:16:51.16,0:16:55.46,Default,,0,0,0,,Өйткені...! Ха ха... Бұзушылық!
Dialogue: 0,0:16:55.49,0:16:59.30,Default,,0,0,0,,Олай болса, етті жақсырақ кесуім үшін пышақты қайрап жібересіз бе?
Dialogue: 0,0:16:59.33,0:17:02.33,Default,,0,0,0,,Жақсы. Білгіш тас қайда?
Dialogue: 0,0:17:02.33,0:17:06.14,Default,,0,0,0,,Ол сонда. иә? иә….
Dialogue: 0,0:17:10.49,0:17:13.90,Default,,0,0,0,,Оны сыртынан қайраңыз. Иә.
Dialogue: 0,0:17:18.13,0:17:20.43,Default,,0,0,0,,О, бұл қызықсыз.
Dialogue: 0,0:17:20.50,0:17:23.30,Default,,0,0,0,,⚟Д'Артаньян! Бұл өте қиын!
Dialogue: 0,0:17:23.32,0:17:27.33,Default,,0,0,0,,Арамис тұтқынға алынып, Рошфорт сарайына жеткізілді!
Dialogue: 0,0:17:27.33,0:17:29.93,Default,,0,0,0,,Не? Бұл қиын! Rocinante!
Dialogue: 0,0:17:34.47,0:17:36.57,Default,,0,0,0,,Кеттік! Rocinante!
Dialogue: 0,0:17:36.63,0:17:38.94,Default,,0,0,0,,Эй... сәл күте тұрыңыз!
Dialogue: 0,0:17:41.97,0:17:44.08,Default,,0,0,0,,Жүр! Rocinante!
Dialogue: 0,0:17:44.13,0:17:47.93,Default,,0,0,0,,Д'Артаньян Д'Артаньян?
Dialogue: 0,0:17:47.96,0:17:51.27,Default,,0,0,0,,Ах~ Қайда бардың деп қызық.
Dialogue: 0,0:17:51.32,0:17:54.40,Default,,0,0,0,,Пышақсыз тамақ пісіруге болмайды.
Dialogue: 0,0:17:54.49,0:17:56.57,Default,,0,0,0,,Хмм! Д'Артаньянға келгенде.
Dialogue: 0,0:17:58.66,0:18:01.46,Default,,0,0,0,,Мұнда? Иә.
Dialogue: 0,0:18:11.00,0:18:13.60,Default,,0,0,0,,Сіз қалай ойлайсыз? Арамис осында ма?
Dialogue: 0,0:18:13.67,0:18:16.96,Default,,0,0,0,,Хмм, мен бұл жерден ештеңе көрмеймін.
Dialogue: 0,0:18:19.49,0:18:22.50,Default,,0,0,0,,Жан Арғы бетке айналып шығайық. Иә.
Dialogue: 0,0:18:30.29,0:18:34.59,Default,,0,0,0,,Мен қалай жасырын түрде кіремін?
Dialogue: 0,0:18:34.64,0:18:37.65,Default,,0,0,0,,Мына жерде аспан жарығы бар.
Dialogue: 0,0:18:37.65,0:18:39.73,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:18:49.96,0:18:52.26,Default,,0,0,0,,Кеттік, Жан.
Dialogue: 0,0:18:52.29,0:18:58.60,Default,,0,0,0,,♬～
Dialogue: 0,0:19:06.81,0:19:08.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:13.48,0:19:16.58,Default,,0,0,0,,Сіз әлі мойындаған жоқсыз ба?
Dialogue: 0,0:19:16.65,0:19:19.75,Default,,0,0,0,,Міне болды. Мен түссіндім.
Dialogue: 0,0:19:19.82,0:19:23.32,Default,,0,0,0,,Сіз Букингемнің қашып кетуіне жол бергенсіз, солай емес пе?
Dialogue: 0,0:19:23.32,0:19:26.83,Default,,0,0,0,,Мен білмеймін. Оның үстіне мұндай жағдайдың орын алуына ешқандай себеп жоқ.
Dialogue: 0,0:19:26.81,0:19:29.61,Default,,0,0,0,,Ресми қамауға алу ордері болса, мен оны көре аламын ба?
Dialogue: 0,0:19:29.63,0:19:31.63,Default,,0,0,0,,Қамауға бұйрық берген кім?
Dialogue: 0,0:19:31.67,0:19:35.67,Default,,0,0,0,,Иә, мен тыңдаймын. Тез жауап беріңіз!
Dialogue: 0,0:19:35.64,0:19:38.74,Default,,0,0,0,,Дәлелдемеген сұрақтарға жауап берудің қажеті жоқ.
Dialogue: 0,0:19:38.84,0:19:42.33,Default,,0,0,0,,Олай болса менде де бір ой бар, Джуссак.
Dialogue: 0,0:19:42.33,0:19:47.13,Default,,0,0,0,,Иә. Мына жігіттің күртешесін жыртып, қамшымен ұр!
Dialogue: 0,0:19:47.15,0:19:50.43,Default,,0,0,0,,Бақытымызға орай, осы жаманның атыс құралдары баяу
Dialogue: 0,0:19:50.48,0:19:52.89,Default,,0,0,0,,Бұл қиын. Дүрлікпеңіз.
Dialogue: 0,0:19:52.97,0:19:56.27,Default,,0,0,0,,Сізді қамшыға алдыңыз, бұл сіздің аузыңызды ашатындай қорқақ екеніңізді білдірмейді➡
Dialogue: 0,0:19:56.32,0:19:58.83,Default,,0,0,0,,Арамис. Бұл басқаша.
Dialogue: 0,0:19:58.83,0:20:01.43,Default,,0,0,0,,Арамис - әйел. сурет?
Dialogue: 0,0:20:01.50,0:20:05.80,Default,,0,0,0,,А... жоқ... Арамис әйел емес, ол еркек.
Dialogue: 0,0:20:05.80,0:20:07.80,Default,,0,0,0,,Көзге көрінетін нәрселерді айтпа.
Dialogue: 0,0:20:07.82,0:20:12.42,Default,,0,0,0,,Иә, ауырса да шыдаймын...
Dialogue: 0,0:20:12.46,0:20:14.56,Default,,0,0,0,,(Киімнің жыртылған дыбысы)
Dialogue: 0,0:20:14.66,0:20:17.46,Default,,0,0,0,,Кел, айт! Айтпасаң қиналып қаласың.
Dialogue: 0,0:20:17.46,0:20:19.56,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:20:19.66,0:20:25.45,Default,,0,0,0,,Уф~ Джуссак, сен немен айналысып тұрсың! Қамшыны тез қолданыңыз!
Dialogue: 0,0:20:25.49,0:20:28.89,Default,,0,0,0,,Иә. Қарғыс атсын.
Dialogue: 0,0:20:28.97,0:20:32.58,Default,,0,0,0,,Ха! Апыр-ай!
Dialogue: 0,0:20:32.64,0:20:36.23,Default,,0,0,0,,Мына жігіт тыныш шықсын...
Dialogue: 0,0:20:36.30,0:20:40.58,Default,,0,0,0,,Сізге зиян тигізгіңіз келеді. Еске саламын!
Dialogue: 0,0:20:40.67,0:20:45.47,Default,,0,0,0,,Иә! (Бас ұрған дыбыс) О... Иә! Ах~!
Dialogue: 0,0:20:45.49,0:20:48.49,Default,,0,0,0,,Сіз не күтіп тұрсыз? Тез жасаңыз!
Dialogue: 0,0:20:48.46,0:20:51.06,Default,,0,0,0,,Мен бұған жол бере алмаймын!
Dialogue: 0,0:20:51.16,0:20:54.67,Default,,0,0,0,,Арамиске қауіп төніп тұр. Жақында.
Dialogue: 0,0:20:54.63,0:20:57.94,Default,,0,0,0,,Уф... дайындал!
Dialogue: 0,0:21:01.31,0:21:03.31,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:21:06.13,0:21:08.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:08.33,0:21:11.63,Default,,0,0,0,,Эй Джуссак, сен не ойнап жатырсың?
Dialogue: 0,0:21:11.65,0:21:13.75,Default,,0,0,0,,Әй, атта! а….
Dialogue: 0,0:21:17.30,0:21:19.31,Default,,0,0,0,,Қандай лас көрініс…
Dialogue: 0,0:21:20.98,0:21:22.98,Default,,0,0,0,,Күтіңіз.
Dialogue: 0,0:21:22.98,0:21:25.56,Default,,0,0,0,,Арамис! тез!
Dialogue: 0,0:21:25.63,0:21:28.13,Default,,0,0,0,,Рахмет, д'Артаньян!
Dialogue: 0,0:21:28.15,0:21:30.45,Default,,0,0,0,,Ку… шіркін….
Dialogue: 0,0:21:30.48,0:21:32.87,Default,,0,0,0,,Бұл қауіпті жер еді.
Dialogue: 0,0:21:32.97,0:21:35.57,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,0:21:35.64,0:21:37.94,Default,,0,0,0,,Жүр, асығайық!
Dialogue: 0,0:21:43.81,0:21:46.62,Default,,0,0,0,,Үйге келсем, той дайын болады.
Dialogue: 0,0:21:55.83,0:21:59.63,Default,,0,0,0,,Не? Сіз әлі пісірдіңіз бе?
Dialogue: 0,0:21:59.66,0:22:02.47,Default,,0,0,0,,Әрине. Ол қолындағы пышақпен жоғалып кетті➡
Dialogue: 0,0:22:02.50,0:22:05.90,Default,,0,0,0,,Біз ештеңе істей алмаймыз. Эй, Жан, пышақ!
Dialogue: 0,0:22:06.00,0:22:07.99,Default,,0,0,0,,Не? Иә.
Dialogue: 0,0:22:09.97,0:22:12.58,Default,,0,0,0,,Жоқ, бұл….
Dialogue: 0,0:22:12.64,0:22:15.23,Default,,0,0,0,,Жақсы иіс шығады. Мен не істей аламын?
Dialogue: 0,0:22:15.30,0:22:17.80,Default,,0,0,0,,Оны қуыру керек еді, бірақ...
Dialogue: 0,0:22:17.83,0:22:22.32,Default,,0,0,0,,Иә? Бұл шынымен жақсы иіс.
Dialogue: 0,0:22:25.47,0:22:27.78,Default,,0,0,0,,Ах!
Dialogue: 0,0:22:27.79,0:22:31.60,Default,,0,0,0,,Менде пышақ жоқ еді, мен оны қуырудың орнына қуырдым.
Dialogue: 0,0:22:31.66,0:22:34.67,Default,,0,0,0,,Біраз уақыт өтті, бірақ дәмді болып шықты.
Dialogue: 0,0:22:34.63,0:22:36.73,Default,,0,0,0,,Бұл дәмді көрінеді.
Dialogue: 0,0:22:36.80,0:22:39.60,Default,,0,0,0,,Не? Менің ойымша, тағам дұрыс дайындалған.
Dialogue: 0,0:22:39.64,0:22:42.14,Default,,0,0,0,,Констанс та жаман адам.
Dialogue: 0,0:22:42.12,0:22:46.13,Default,,0,0,0,,Енді етті тез кесіп, барлығымен бөліс.
Dialogue: 0,0:22:46.14,0:22:48.15,Default,,0,0,0,,Жарайды, міне келдік!
Dialogue: 0,0:22:56.47,0:22:58.47,Default,,0,0,0,,Бұл жігіт жақсы!
Dialogue: 0,0:22:58.49,0:23:03.09,Default,,0,0,0,,Мынау және анау. Құдайға дұрыс дұға еткеннен кейін.
Dialogue: 0,0:23:03.14,0:23:05.65,Default,,0,0,0,,Барма.
Dialogue: 0,0:23:07.85,0:23:12.94,Default,,0,0,0,,Көктегі Әкеміз, баршаңызға құрмет көрсетсін. ➡
Dialogue: 0,0:23:12.99,0:23:18.99,Default,,0,0,0,,Патшалығың келсін, көктегідей жерде де болсын. ➡
Dialogue: 0,0:23:18.99,0:23:22.60,Default,,0,0,0,,Осы күні бізге күнделікті нанымызды беріңіз. ➡
Dialogue: 0,0:23:22.68,0:23:26.18,Default,,0,0,0,,Бізге қарыздар, біз оларды кешіреміз➡
Dialogue: 0,0:23:26.13,0:23:29.14,Default,,0,0,0,,Біздің қарыздарымызды кешіре гөр.
Dialogue: 0,0:23:29.14,0:23:35.43,Default,,0,0,0,,♬～
Dialogue: 0,0:23:43.48,0:23:47.59,Default,,0,0,0,,Осылайша күн аман-есен аяқталды.
Dialogue: 0,0:23:52.96,0:23:59.27,Default,,0,0,0,,♬～
Dialogue: 0,0:24:00.77,0:24:06.77,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
