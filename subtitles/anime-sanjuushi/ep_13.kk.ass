Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.00,0:00:09.30,Default,,0,0,0,,♬～
Dialogue: 0,0:01:32.35,0:01:36.94,Default,,0,0,0,,Мен мушкеттердің шәкірті болып жұмысқа алғаш рет барған күні➡
Dialogue: 0,0:01:37.01,0:01:40.10,Default,,0,0,0,,Д'Артаньян Ришельенің сюжетін ашады➡
Dialogue: 0,0:01:40.16,0:01:45.95,Default,,0,0,0,,Ол Букингем герцогын құтқару үшін тамаша жұмыс жасады.
Dialogue: 0,0:01:55.03,0:01:58.31,Default,,0,0,0,,Ал келесі күні...
Dialogue: 0,0:01:58.33,0:02:04.62,Default,,0,0,0,,♬～
Dialogue: 0,0:02:11.66,0:02:13.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:13.65,0:02:19.95,Default,,0,0,0,,♬～
Dialogue: 0,0:02:30.68,0:02:34.28,Default,,0,0,0,,Жан Юбе - бұл құпия. Ешкімге айтпа.
Dialogue: 0,0:02:34.35,0:02:37.34,Default,,0,0,0,,Иә. Бірақ неге?
Dialogue: 0,0:02:37.34,0:02:41.84,Default,,0,0,0,,Мен бұл нәрседе бұдан да үлкен құпия жасырылғанына сенімдімін.
Dialogue: 0,0:02:41.84,0:02:44.34,Default,,0,0,0,,Байқамай біреумен сөйлесіп қалсаңыз, қиналып қаласыз.
Dialogue: 0,0:02:44.33,0:02:46.63,Default,,0,0,0,,Хмм….
Dialogue: 0,0:02:53.69,0:02:58.27,Default,,0,0,0,,Патшайым, Юбе шынымен қауіпті жерде болды.
Dialogue: 0,0:02:58.36,0:03:01.84,Default,,0,0,0,,Букингем герцогы Парижден кеткенге дейін➡
Dialogue: 0,0:03:01.83,0:03:03.91,Default,,0,0,0,,Мен өзімді әлі қауіпсіз сезінбеймін.
Dialogue: 0,0:03:04.03,0:03:08.02,Default,,0,0,0,,Мен Ришельенің соңында не істейді деп алаңдаймын.
Dialogue: 0,0:03:07.98,0:03:09.99,Default,,0,0,0,,Сол алмас алқа➡
Dialogue: 0,0:03:09.99,0:03:14.99,Default,,0,0,0,,Оны саған бергенім дұрыс па?
Dialogue: 0,0:03:14.99,0:03:16.99,Default,,0,0,0,,Менің таңдауым болмады.
Dialogue: 0,0:03:17.01,0:03:20.31,Default,,0,0,0,,Мен мұны саған бермесем не болар еді...
Dialogue: 0,0:03:20.35,0:03:23.45,Default,,0,0,0,,Иә. бірақ…. (айқай)
Dialogue: 0,0:03:23.52,0:03:25.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:25.52,0:03:28.62,Default,,0,0,0,,Өтінемін.
Dialogue: 0,0:03:28.67,0:03:32.46,Default,,0,0,0,,Букингем герцогы қоштасқандай болды.
Dialogue: 0,0:03:32.49,0:03:35.59,Default,,0,0,0,,Үлкен залға келіңіз.
Dialogue: 0,0:03:35.66,0:03:38.66,Default,,0,0,0,,Түсінді. Мен жақында боламын.
Dialogue: 0,0:03:38.66,0:03:40.65,Default,,0,0,0,,(айқай)
Dialogue: 0,0:03:40.67,0:03:44.17,Default,,0,0,0,,Мәртебелі Король және оның әпкесі Генриетта➡
Dialogue: 0,0:03:44.20,0:03:47.81,Default,,0,0,0,,Маған Мәртебелі Король Чарльз I➡-ге үйленуге рұқсат бергеніңіз үшін рахмет
Dialogue: 0,0:03:47.82,0:03:49.83,Default,,0,0,0,,Сізге көп рахмет. ➡
Dialogue: 0,0:03:49.86,0:03:53.85,Default,,0,0,0,,Сіздердің арқаларыңызда мен елшілік қызметімді мүлтіксіз атқара алдым.
Dialogue: 0,0:03:53.83,0:03:56.93,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:03:57.03,0:03:59.03,Default,,0,0,0,,Менде де осындай үйлену жоспары бар➡
Dialogue: 0,0:03:59.00,0:04:03.00,Default,,0,0,0,,Ол Франция мен Англия арасындағы бейбітшілікті қалайды➡
Dialogue: 0,0:04:03.00,0:04:07.61,Default,,0,0,0,,Мен мұны Чарльз-доноға жеткізгім келеді. Мен оны түсіндім.
Dialogue: 0,0:04:14.02,0:04:17.62,Default,,0,0,0,,Королева әрқашан сарапшы болады.
Dialogue: 0,0:04:21.16,0:04:25.66,Default,,0,0,0,,Сізге қауіпсіз сапарлар тілейміз.
Dialogue: 0,0:04:25.66,0:04:29.65,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:04:29.65,0:04:33.95,Default,,0,0,0,,Оның көзіндегі жарық патшайымның гауһар тастарының жарқырауына ұқсайды➡
Dialogue: 0,0:04:34.00,0:04:37.01,Default,,0,0,0,,Ол менің жолымды жарықтандырады.
Dialogue: 0,0:04:40.51,0:04:43.51,Default,,0,0,0,,А... жай ғана жағымсыз нәрсе айтыңыз.
Dialogue: 0,0:04:43.51,0:04:47.32,Default,,0,0,0,,Енді мен сендермен қоштасқым келеді.
Dialogue: 0,0:05:10.34,0:05:13.93,Default,,0,0,0,,Қош бол, Анна патшайым.
Dialogue: 0,0:05:19.35,0:05:23.65,Default,,0,0,0,,Ал, Букингем герцогы әлі бізге қарап тұр.
Dialogue: 0,0:05:23.69,0:05:27.69,Default,,0,0,0,,Шулы Көшіру. Ауызыңды жап.
Dialogue: 0,0:05:29.32,0:05:33.33,Default,,0,0,0,,Мен саған сыйлаған гауһар алқаны мен деп ойлап көрші➡
Dialogue: 0,0:05:33.33,0:05:36.82,Default,,0,0,0,,Рубльге қатысты бұдан былай шу шығармауыңызды өтінемін.
Dialogue: 0,0:05:36.83,0:05:39.12,Default,,0,0,0,,Қош бол, герцог Букингем.
Dialogue: 0,0:05:39.15,0:05:43.96,Default,,0,0,0,,(айқай)
Dialogue: 0,0:05:43.99,0:05:45.99,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:05:50.35,0:05:54.33,Default,,0,0,0,,Букингемді үйге аман-есен әкелесіз бе?
Dialogue: 0,0:05:54.35,0:05:59.35,Default,,0,0,0,,Мен өз рөлімді дұрыс орындадым деп ойлаймын.
Dialogue: 0,0:06:03.68,0:06:08.28,Default,,0,0,0,,Лорд Рошфорттың міндеті – қақпанға түскен олжаны ұстау.
Dialogue: 0,0:06:08.35,0:06:12.65,Default,,0,0,0,,Жоқ, мен мұндай жерде кедергі келтіремін деп ойламадым.
Dialogue: 0,0:06:12.68,0:06:14.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:16.67,0:06:20.78,Default,,0,0,0,,Мм, сен жақсы қызсың. Ханшайым не деді?
Dialogue: 0,0:06:20.83,0:06:23.63,Default,,0,0,0,,(айқай)
Dialogue: 0,0:06:23.66,0:06:26.26,Default,,0,0,0,,Енді тез айт.
Dialogue: 0,0:06:26.36,0:06:30.15,Default,,0,0,0,,«Мен уақытты жақсы өткіземін».
Dialogue: 0,0:06:30.17,0:06:33.97,Default,,0,0,0,,Бұл алмас алқа! ? (айқай)
Dialogue: 0,0:06:38.51,0:06:42.61,Default,,0,0,0,,Барлық көмектеріңіз үшін рахмет. Жолда аман-есен жүрсің деп үміттенемін.
Dialogue: 0,0:06:42.68,0:06:47.19,Default,,0,0,0,,Д'Артаньянға да сәлем жолдауыңызды өтінемін. д'Артаньян? Бұл не?
Dialogue: 0,0:06:47.19,0:06:51.17,Default,,0,0,0,,Маған Букингем рахмет айтқанын айтыңызшы.
Dialogue: 0,0:06:51.16,0:06:53.16,Default,,0,0,0,,Күрсіну….
Dialogue: 0,0:07:04.67,0:07:06.67,Default,,0,0,0,,Хмм….
Dialogue: 0,0:07:13.35,0:07:17.95,Default,,0,0,0,,Д'Артаньян. Сәлем Портос. Капитан шақырып жатыр.
Dialogue: 0,0:07:18.02,0:07:21.82,Default,,0,0,0,,Дереу кел дейді. сурет? Бірден келу деген нені білдіреді деп ойлаймын...
Dialogue: 0,0:07:21.82,0:07:23.82,Default,,0,0,0,,Сізге ұрысатынына сенімдімін.
Dialogue: 0,0:07:23.84,0:07:30.15,Default,,0,0,0,,Егер ойыңызға бірдеңе келсе, алдымен кешірім сұраңыз. мм... хмм?
Dialogue: 0,0:07:31.00,0:07:34.30,Default,,0,0,0,,Қою.
Dialogue: 0,0:07:37.69,0:07:40.99,Default,,0,0,0,,Кешіріңіз, капитан. Не?
Dialogue: 0,0:07:41.02,0:07:46.31,Default,,0,0,0,,Мен де түсінбеймін. Қалай болғанда да, кешіріңіз.
Dialogue: 0,0:07:46.31,0:07:49.31,Default,,0,0,0,,Сонымен не үшін кешірім сұрайсыз?
Dialogue: 0,0:07:49.35,0:07:54.35,Default,,0,0,0,,Капитан аударманы біледі, солай ма? Саған ұрысатын капитан.
Dialogue: 0,0:07:54.35,0:07:59.14,Default,,0,0,0,,Саған ұрсамын деп кім айтты? иә? Маған ұрыспайсың ба?
Dialogue: 0,0:07:59.16,0:08:01.16,Default,,0,0,0,,Кешірім сұраудың өзі шығын...
Dialogue: 0,0:08:01.16,0:08:04.76,Default,,0,0,0,,Букингем герцогы сізге сәлем берді.
Dialogue: 0,0:08:04.83,0:08:07.33,Default,,0,0,0,,О, солай ма?
Dialogue: 0,0:08:07.32,0:08:11.32,Default,,0,0,0,,Сіз нені айтасыз? Ашық сөйлесейік!
Dialogue: 0,0:08:11.32,0:08:14.32,Default,,0,0,0,,Бұл біреудің ар-намысы туралы.
Dialogue: 0,0:08:14.32,0:08:17.63,Default,,0,0,0,,Мен капитанмен де сөйлесе алмаймын.
Dialogue: 0,0:08:17.69,0:08:22.98,Default,,0,0,0,,Королеваның... солай ма? Не, сен білдің бе?
Dialogue: 0,0:08:22.98,0:08:25.98,Default,,0,0,0,,Іс жүзінде герцог Букингемнің қарсы алу балында➡
Dialogue: 0,0:08:25.98,0:08:29.49,Default,,0,0,0,,Миледи есімді әйел лорд Ришельенің аяқ-қолы болып жұмыс істейді➡
Dialogue: 0,0:08:29.52,0:08:32.91,Default,,0,0,0,,Сіздің қатысып жатқаныңызды білдім. Иә.
Dialogue: 0,0:08:32.99,0:08:36.59,Default,,0,0,0,,Ол тағы бір жамандық жасап қала ма деп қорқамын➡
Dialogue: 0,0:08:36.68,0:08:40.68,Default,,0,0,0,,Мен жасырын түрде сарай ауласында күзетуді шештім.
Dialogue: 0,0:08:40.67,0:08:42.77,Default,,0,0,0,,Сонымен? Содан кейін➡
Dialogue: 0,0:08:42.83,0:08:47.64,Default,,0,0,0,,Мен бір әйелдің Букингем герцогын саңылауға азғырғанын көрдім.
Dialogue: 0,0:08:47.66,0:08:53.96,Default,,0,0,0,,♬～
Dialogue: 0,0:09:12.65,0:09:16.65,Default,,0,0,0,,Әйел кеткенде, Рошфор және басқалары келеді➡
Dialogue: 0,0:09:16.65,0:09:19.65,Default,,0,0,0,,Біз саңылаудан шығуды қамтамасыз еттік.
Dialogue: 0,0:09:27.01,0:09:31.82,Default,,0,0,0,,Бұл әйел кім? Мен бетперде киіп жүрдім, сондықтан сіздің бетіңізді анық көрмеймін➡
Dialogue: 0,0:09:31.85,0:09:35.15,Default,,0,0,0,,Менің ойымша, бұл Миледи. Иә... солай ма?
Dialogue: 0,0:09:35.17,0:09:38.67,Default,,0,0,0,,Мен ойлағандай. Біраз уақыттан кейін Букингем герцогы шықты➡
Dialogue: 0,0:09:38.66,0:09:40.96,Default,,0,0,0,,Конвой оны ұстап алмақ болды.
Dialogue: 0,0:09:41.01,0:09:45.61,Default,,0,0,0,,Мен сыртқа шығып, герцог Букингемді құтқардым.
Dialogue: 0,0:09:45.65,0:09:47.65,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:45.68,0:09:49.48,Default,,0,0,0,,Сол саңылау патшайымның бөлмесіне апарған болуы керек.
Dialogue: 0,0:09:51.50,0:09:53.51,Default,,0,0,0,,Неліктен мұндай олқылық бар?
Dialogue: 0,0:09:53.51,0:09:59.81,Default,,0,0,0,,Шындығында, оны Мәртебелі мен патшайым төтенше жағдайда сарайдан қашу үшін қолдануға арналған.
Dialogue: 0,0:09:59.99,0:10:02.50,Default,,0,0,0,,Егер Букингем герцогы сол жерде ұсталса➡
Dialogue: 0,0:10:02.50,0:10:05.90,Default,,0,0,0,,Королева да ұлы мәртебелі батасын алған болуы керек.
Dialogue: 0,0:10:06.00,0:10:09.80,Default,,0,0,0,,Жақсы жұмыс, д'Артаньян. Жоқ...
Dialogue: 0,0:10:09.85,0:10:12.96,Default,,0,0,0,,Ришелье, көңіліңіз қалған шығар.
Dialogue: 0,0:10:12.99,0:10:15.29,Default,,0,0,0,,Иә... иә!
Dialogue: 0,0:10:17.01,0:10:21.32,Default,,0,0,0,,Мені осындай жерге шақырып сыр айтасың ба?
Dialogue: 0,0:10:21.35,0:10:25.85,Default,,0,0,0,,Иә. Негізінде бұл Мәртебелі мен Королеваның құрметіне байланысты...
Dialogue: 0,0:10:25.85,0:10:29.84,Default,,0,0,0,,Букингем туралы тағы бір қауесет бар ма? Сақ болыңыз.
Dialogue: 0,0:10:29.84,0:10:34.45,Default,,0,0,0,,Ол өз миссиясын орындап, Англияға оқиғасыз оралды емес пе?
Dialogue: 0,0:10:34.50,0:10:37.78,Default,,0,0,0,,Олардың үйлеріне үлкен қуанышпен барғандарына сенімдімін.
Dialogue: 0,0:10:37.85,0:10:42.15,Default,,0,0,0,,Патшайым маған гауһар тасты алқа сыйлады. не?
Dialogue: 0,0:10:42.17,0:10:45.47,Default,,0,0,0,,Оның үстіне Мәртебелі оны патшайымға сыйлық ретінде берді➡
Dialogue: 0,0:10:45.51,0:10:50.91,Default,,0,0,0,,Бұл керемет гауһар алқа. Амал жоқ...
Dialogue: 0,0:10:51.01,0:10:55.82,Default,,0,0,0,,Егер күмәніңіз болса, сізде гауһар алқа бар ма?➡
Dialogue: 0,0:10:55.83,0:10:59.14,Default,,0,0,0,,Тексеріп көрсеңізші... Бұл мүмкін емес.
Dialogue: 0,0:10:59.15,0:11:01.16,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:11:01.16,0:11:03.16,Default,,0,0,0,,Мен Францияның королімін.
Dialogue: 0,0:11:03.16,0:11:05.96,Default,,0,0,0,,Дүниенің күйеулері әйелдерінен сұрайтындай➡
Dialogue: 0,0:11:06.01,0:11:09.81,Default,,0,0,0,,Сыйлық бергеннен кейін оның қайда кеткенін қалай сұрауға болады?
Dialogue: 0,0:11:09.81,0:11:11.92,Default,,0,0,0,,Олай болса, неге той жасамасқа➡
Dialogue: 0,0:11:12.02,0:11:15.80,Default,,0,0,0,,Сіз сол орындыққа бриллиант алқа тағып көрінуіңізге болады➡
Dialogue: 0,0:11:15.85,0:11:20.66,Default,,0,0,0,,Патшайым сізге бұйырса, қалай қалар едіңіз?
Dialogue: 0,0:11:23.68,0:11:28.27,Default,,0,0,0,,Менің әпкем Генриеттті Чарльз I-ге үйленуімен құттықтаймын➡
Dialogue: 0,0:11:28.32,0:11:31.92,Default,,0,0,0,,Той өткізейін деп жатырмын, ше?
Dialogue: 0,0:11:31.99,0:11:33.99,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:11:34.02,0:11:37.81,Default,,0,0,0,,Мен Генриетт-саманың да өте бақытты болатынына сенімдімін.
Dialogue: 0,0:11:37.84,0:11:40.95,Default,,0,0,0,,Осы кешке мен сізге сыйлық бердім➡
Dialogue: 0,0:11:41.01,0:11:45.12,Default,,0,0,0,,Мен сіздің гауһар тасты алқа тағып қатысуыңызды қалаймын. Жақсы.
Dialogue: 0,0:11:45.17,0:11:47.95,Default,,0,0,0,,Не? а….
Dialogue: 0,0:11:47.99,0:11:49.99,Default,,0,0,0,,Осындайша тәж кигізу рәсіміне кедергі келтіру…
Dialogue: 0,0:11:49.99,0:11:52.29,Default,,0,0,0,,Бұл алмас алқа.
Dialogue: 0,0:11:52.36,0:11:57.35,Default,,0,0,0,,Сіз бұл гауһар тасты келесі күні Букингемнің құттықтау балында тағып едіңіз.
Dialogue: 0,0:11:57.33,0:12:00.62,Default,,0,0,0,,Ол келген әйелдердің бәрінен де сұлу еді.
Dialogue: 0,0:12:00.70,0:12:03.30,Default,,0,0,0,,Келесі кеште мен мұны қайталаймын➡
Dialogue: 0,0:12:03.35,0:12:08.36,Default,,0,0,0,,Мен сіздің гауһар алқа таққан жүзіңізді көргім келеді.
Dialogue: 0,0:12:08.32,0:12:11.83,Default,,0,0,0,,Не болды? Ыңғайсыз нәрсе бар ма?
Dialogue: 0,0:12:11.84,0:12:18.13,Default,,0,0,0,,Жоқ... Мәртебелі қандай киім сұраса, соны киемін.
Dialogue: 0,0:12:19.98,0:12:23.99,Default,,0,0,0,,Гауһар тастардың жарқырауымен бәсекелесетін әдемі фигураңыз➡
Dialogue: 0,0:12:23.99,0:12:26.98,Default,,0,0,0,,Мен оны асыға күтемін. ➡
Dialogue: 0,0:12:27.03,0:12:29.61,Default,,0,0,0,,Тексеру. а….
Dialogue: 0,0:12:37.69,0:12:41.19,Default,,0,0,0,,Мәртебелі неге мұндай әрекетке барды?
Dialogue: 0,0:12:41.16,0:12:43.16,Default,,0,0,0,,Мен білмеймін... ➡
Dialogue: 0,0:12:43.19,0:12:47.28,Default,,0,0,0,,Мәртебелі кешке қалай киіну керектігі туралы ешқашан нұсқау бермесе де...
Dialogue: 0,0:12:47.35,0:12:51.45,Default,,0,0,0,,Оны Ришелье мырза шабыттандырғанына сенімдімін.
Dialogue: 0,0:12:51.52,0:12:56.52,Default,,0,0,0,,Бірақ Ришельеге кім хабарлады? Алмаз алқа туралы...
Dialogue: 0,0:12:56.50,0:12:58.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:58.67,0:13:02.18,Default,,0,0,0,,Букингем герцогіне алқаны кім бергенін кім біледі?
Dialogue: 0,0:13:02.16,0:13:04.96,Default,,0,0,0,,Констанс Бұл сіз ғана болуыңыз керек...
Dialogue: 0,0:13:05.00,0:13:08.60,Default,,0,0,0,,Ах... Патшайым...
Dialogue: 0,0:13:10.69,0:13:14.49,Default,,0,0,0,,Сіз маған күмәнданасыз ба? Бұл тым көп.
Dialogue: 0,0:13:14.52,0:13:20.53,Default,,0,0,0,,Бірақ ол кезде тек мен, Букингем герцогы және сіз болдыңыз. ➡
Dialogue: 0,0:13:20.53,0:13:22.83,Default,,0,0,0,,Мен және Букингем герцогы солай істедік➡
Dialogue: 0,0:13:22.81,0:13:25.62,Default,,0,0,0,,Ришельеге айтудың жолы жоқ деп есептесек...
Dialogue: 0,0:13:25.67,0:13:27.77,Default,,0,0,0,,Мен кінәсізмін.
Dialogue: 0,0:13:27.85,0:13:32.16,Default,,0,0,0,,Мен патшайымға адал қызмет еткенімді мақтан тұтамын➡
Dialogue: 0,0:13:32.16,0:13:34.46,Default,,0,0,0,,Бұл қалай мүмкін?
Dialogue: 0,0:13:34.49,0:13:36.49,Default,,0,0,0,,Мен де саған сенгім келеді.
Dialogue: 0,0:13:36.51,0:13:42.32,Default,,0,0,0,,Бірақ дәл қазір оның не екенін білмеймін.
Dialogue: 0,0:13:44.34,0:13:46.64,Default,,0,0,0,,Ханшайым! Констанс.
Dialogue: 0,0:13:46.67,0:13:50.68,Default,,0,0,0,,Мені біраз уақытқа қалдырыңызшы.
Dialogue: 0,0:13:56.66,0:13:59.27,Default,,0,0,0,,(айқай)
Dialogue: 0,0:13:59.33,0:14:05.62,Default,,0,0,0,,♬～
Dialogue: 0,0:14:14.67,0:14:16.95,Default,,0,0,0,,(айқай)
Dialogue: 0,0:14:20.32,0:14:26.63,Default,,0,0,0,,♬～
Dialogue: 0,0:14:37.32,0:14:39.32,Default,,0,0,0,,Сізге жақсы, Росинанте.
Dialogue: 0,0:14:39.32,0:14:41.93,Default,,0,0,0,,Сізге де анда-санда щетка керек.
Dialogue: 0,0:14:44.85,0:14:49.65,Default,,0,0,0,,Констанс. сурет? а….
Dialogue: 0,0:14:49.67,0:14:52.67,Default,,0,0,0,,Констанс.
Dialogue: 0,0:14:52.65,0:14:55.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:55.32,0:14:57.63,Default,,0,0,0,,Констанс!
Dialogue: 0,0:14:57.68,0:15:03.48,Default,,0,0,0,,Констанс Не болды? Сарайда бірдеңе болды ма?
Dialogue: 0,0:15:03.48,0:15:06.58,Default,,0,0,0,,Бұл жақсы. Мені жалғыз қалдыр.
Dialogue: 0,0:15:06.65,0:15:09.95,Default,,0,0,0,,Юбеге қатысы бар шығар...
Dialogue: 0,0:15:10.02,0:15:14.01,Default,,0,0,0,,Не? д'Артаньян, неге олай істейсің?
Dialogue: 0,0:15:19.01,0:15:22.32,Default,,0,0,0,,Е! ? Ал, патшайым, Констанс ше?
Dialogue: 0,0:15:22.33,0:15:25.64,Default,,0,0,0,,Сіз мені тыңшы деп күдіктенесіз бе?
Dialogue: 0,0:15:25.65,0:15:27.96,Default,,0,0,0,,Мен де патшайымды аяймын.
Dialogue: 0,0:15:27.99,0:15:31.09,Default,,0,0,0,,Қалай ойласаң да, менен басқа ешкім жоқ...
Dialogue: 0,0:15:31.16,0:15:33.26,Default,,0,0,0,,Солай болса да, бұл қорқынышты...
Dialogue: 0,0:15:33.34,0:15:37.65,Default,,0,0,0,,Ришелье алмас алқа туралы қайдан білді➡
Dialogue: 0,0:15:37.70,0:15:42.19,Default,,0,0,0,,Егер мен мұны анықтай алсам, патшайымның күдігін жоя алар едім...
Dialogue: 0,0:15:42.15,0:15:44.76,Default,,0,0,0,,Хмм... Қабырғалардың құлағы бар дейді...
Dialogue: 0,0:15:44.84,0:15:48.94,Default,,0,0,0,,Бұл да патшайымның бөлмесінде не болып жатқанын тыңдауға арналған құрылғы емес пе?
Dialogue: 0,0:15:49.01,0:15:53.01,Default,,0,0,0,,Иә? Күте тұрыңыз... бірдеңе? сурет?
Dialogue: 0,0:15:53.01,0:15:56.32,Default,,0,0,0,,Ойланып көрейікші, Букингем герцогын тұзаққа түсірген әйелдің құшағында➡
Dialogue: 0,0:15:56.35,0:15:59.34,Default,,0,0,0,,Сол жерде тотықұс отыр екен. Бұл тотықұс па?
Dialogue: 0,0:15:59.34,0:16:02.64,Default,,0,0,0,,Ах! Патшайымның бөлмесінде тотықұс та бар.
Dialogue: 0,0:16:02.66,0:16:05.76,Default,,0,0,0,,Бұл заттарды көшіруге шебер тотықұс➡
Dialogue: 0,0:16:05.84,0:16:09.35,Default,,0,0,0,,Ришелье оны патшайымға туған күніне сыйлық ретінде бергеніне сенімдімін.
Dialogue: 0,0:16:09.33,0:16:12.32,Default,,0,0,0,,Міне. Оны құйрығынан ұстаңыз.
Dialogue: 0,0:16:12.33,0:16:15.34,Default,,0,0,0,,Бұл Констанстың шпион емес екенін білдіреді➡
Dialogue: 0,0:16:15.34,0:16:18.44,Default,,0,0,0,,Мен оны толық дәлелдей аламын.
Dialogue: 0,0:16:18.49,0:16:20.89,Default,,0,0,0,,Иә.
Dialogue: 0,0:16:26.98,0:16:29.58,Default,,0,0,0,,Ханшайым, саған айтарым бар!
Dialogue: 0,0:16:29.68,0:16:32.99,Default,,0,0,0,,Мен сені көргім келмейді. Түсіңіз.
Dialogue: 0,0:16:33.00,0:16:38.11,Default,,0,0,0,,Букингем герцогы гауһар алқаны қайтарып берді.
Dialogue: 0,0:16:38.16,0:16:40.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:41.00,0:16:43.10,Default,,0,0,0,,Мен қазір өзімді қауіпсіз сезінемін.
Dialogue: 0,0:16:43.18,0:16:47.99,Default,,0,0,0,,Ришелье мырза патшайымды тұзаққа түсірмек болса да, мен қорықпаймын.
Dialogue: 0,0:16:48.02,0:16:53.62,Default,,0,0,0,,Не... (айқай)
Dialogue: 0,0:17:13.66,0:17:17.16,Default,,0,0,0,,Бұл оқиға рас па?
Dialogue: 0,0:17:17.16,0:17:19.67,Default,,0,0,0,,Мені кешіріңіз, патшайым.
Dialogue: 0,0:17:19.68,0:17:25.97,Default,,0,0,0,,Бұл менің жеке тұлғамды дәлелдеу үшін өтірік болды. сурет….
Dialogue: 0,0:17:33.01,0:17:36.32,Default,,0,0,0,,Бұл Ришельенің үйі. Менің ойымша...
Dialogue: 0,0:17:38.69,0:17:41.79,Default,,0,0,0,,Ханшайымға бір ғана жол қалды. ➡
Dialogue: 0,0:17:41.82,0:17:43.82,Default,,0,0,0,,Лондонға тапсырма жіберу➡
Dialogue: 0,0:17:43.84,0:17:47.35,Default,,0,0,0,,Сізге тек Букингемнен алқаны қайтарып алсаңыз болғаны.
Dialogue: 0,0:17:47.35,0:17:51.95,Default,,0,0,0,,Уайымдамаңыз. Хабаршы ешқашан тірі орала алмайды.
Dialogue: 0,0:17:52.00,0:17:56.59,Default,,0,0,0,,(айқай)
Dialogue: 0,0:17:59.34,0:18:05.65,Default,,0,0,0,,♬～(ысқырық)(сықырлау)
Dialogue: 0,0:18:07.65,0:18:09.95,Default,,0,0,0,,Енді көшіріңіз.
Dialogue: 0,0:18:11.69,0:18:14.97,Default,,0,0,0,,Енді сөйлесейік. Ханшайымның құпиясы.
Dialogue: 0,0:18:15.01,0:18:19.61,Default,,0,0,0,,Бағана. ➡
Dialogue: 0,0:18:19.68,0:18:24.68,Default,,0,0,0,,«Букингем Даймонд Кубиказари Каешитекоралемашита.»
Dialogue: 0,0:18:24.70,0:18:28.99,Default,,0,0,0,,Не? Сондай ақымақ... Сене алар емеспін.
Dialogue: 0,0:18:29.02,0:18:32.32,Default,,0,0,0,,Енді сіз бәрін білесіз. Иә.
Dialogue: 0,0:18:32.34,0:18:36.44,Default,,0,0,0,,«Букингем Даймонд Кубиказари Каешитекоралемашита».
Dialogue: 0,0:18:36.48,0:18:39.88,Default,,0,0,0,,Егер біз бұл көшірмені басып алсақ, бұл дәлел болар еді...
Dialogue: 0,0:18:40.00,0:18:43.30,Default,,0,0,0,,Хмм….
Dialogue: 0,0:18:43.35,0:18:46.95,Default,,0,0,0,,Жарайды, маған қалдырыңыз! иә?
Dialogue: 0,0:18:48.99,0:18:51.59,Default,,0,0,0,,(Миледи флейтасының дыбысына еліктеу)
Dialogue: 0,0:18:51.68,0:18:56.98,Default,,0,0,0,,Әй, көшіріп ал! Қайда бара жатырсың?
Dialogue: 0,0:18:56.98,0:19:01.09,Default,,0,0,0,,(Миледи флейтасының дыбысына еліктеу)
Dialogue: 0,0:19:01.17,0:19:03.27,Default,,0,0,0,,Иә! (3 адам) Ах!
Dialogue: 0,0:19:03.37,0:19:06.66,Default,,0,0,0,,Жүр, тез!
Dialogue: 0,0:19:06.66,0:19:09.96,Default,,0,0,0,,Ұры! Менің көшірмесім!
Dialogue: 0,0:19:09.98,0:19:12.58,Default,,0,0,0,,Қарсыластың семсерін жеңемін!
Dialogue: 0,0:19:12.65,0:19:16.95,Default,,0,0,0,,Мен оны бір жерден көрдім. Есіміңді бер!
Dialogue: 0,0:19:17.00,0:19:20.60,Default,,0,0,0,,Ескертудің қажеті жоқ. бұл!
Dialogue: 0,0:19:20.65,0:19:25.66,Default,,0,0,0,,♬～
Dialogue: 0,0:19:25.66,0:19:29.26,Default,,0,0,0,,Асығыңыз! Көшірмеңізді қайтарыңыз!
Dialogue: 0,0:19:29.33,0:19:35.62,Default,,0,0,0,,♬～
Dialogue: 0,0:19:39.32,0:19:41.33,Default,,0,0,0,,Жеңдер!
Dialogue: 0,0:19:43.34,0:19:47.15,Default,,0,0,0,,Жүр, қайда болсаң да маған қоңырау шал! сен….
Dialogue: 0,0:19:47.18,0:19:49.98,Default,,0,0,0,,Е, мен сені кешіре алмаймын! Тория!
Dialogue: 0,0:19:49.98,0:19:55.09,Default,,0,0,0,,♬～
Dialogue: 0,0:19:55.16,0:19:57.16,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:59.16,0:20:01.96,Default,,0,0,0,,Сәлем! Апыр-ай!
Dialogue: 0,0:20:02.00,0:20:05.58,Default,,0,0,0,,Не істеп жатырсың! Боқ...
Dialogue: 0,0:20:07.33,0:20:09.94,Default,,0,0,0,,Бұл тұйыққа тіреледі.
Dialogue: 0,0:20:11.66,0:20:16.96,Default,,0,0,0,,Күтіңіз. Мен қазір қашып құтыла алмаймын...
Dialogue: 0,0:20:16.99,0:20:22.98,Default,,0,0,0,,♬～
Dialogue: 0,0:20:22.98,0:20:25.59,Default,,0,0,0,,Боқ...
Dialogue: 0,0:20:30.83,0:20:32.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:32.84,0:20:37.85,Default,,0,0,0,,Ол өте жабайы болды. Бірақ бұл соңы, сондықтан дайын болыңыз.
Dialogue: 0,0:20:37.83,0:20:42.34,Default,,0,0,0,,Мені саған қамқорлық жасауға мәжбүрлеме...
Dialogue: 0,0:20:42.32,0:20:44.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:44.32,0:20:46.32,Default,,0,0,0,,Рошефол!
Dialogue: 0,0:20:46.32,0:20:50.33,Default,,0,0,0,,Енді атыңыз.
Dialogue: 0,0:20:50.33,0:20:52.93,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:53.00,0:20:55.58,Default,,0,0,0,,Менің жолымнан кет!
Dialogue: 0,0:20:55.65,0:20:57.65,Default,,0,0,0,,Бұл 5 миллион йенге арналған ақшалай ваучер
Dialogue: 0,0:20:59.32,0:21:01.92,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:21:03.66,0:21:05.96,Default,,0,0,0,,Тағы кездескенше!
Dialogue: 0,0:21:10.33,0:21:13.32,Default,,0,0,0,,Күткеніңізге рахмет! Барайық!
Dialogue: 0,0:21:20.32,0:21:23.33,Default,,0,0,0,,(Миледидің флейта дыбысына еліктеу және шырылдау)
Dialogue: 0,0:21:23.34,0:21:26.95,Default,,0,0,0,,Енді Ришельеге барып, маған не айтқаныңды айт.
Dialogue: 0,0:21:27.00,0:21:29.30,Default,,0,0,0,,(айқай)
Dialogue: 0,0:21:29.33,0:21:35.62,Default,,0,0,0,,(Миледи флейтасының дыбысына еліктеу)
Dialogue: 0,0:21:36.34,0:21:39.34,Default,,0,0,0,,«Букингем». тістер….
Dialogue: 0,0:21:39.34,0:21:43.35,Default,,0,0,0,,«Диаано Кубиказари Каэшитекоралемашита.»
Dialogue: 0,0:21:43.33,0:21:46.63,Default,,0,0,0,,Жетер, мен түсінемін.
Dialogue: 0,0:21:46.65,0:21:49.25,Default,,0,0,0,,Констанс.
Dialogue: 0,0:21:49.34,0:21:53.34,Default,,0,0,0,,Сізге күмәнданғаным үшін кешіріңіз. Өтінемін, мені кешірші.
Dialogue: 0,0:21:53.34,0:21:57.34,Default,,0,0,0,,Кешіру ысырап болар еді. Сен не туралы айтып тұрсың?
Dialogue: 0,0:21:59.01,0:22:02.32,Default,,0,0,0,,Маған да бәрі қамқор болды. рақмет сізге.
Dialogue: 0,0:22:02.35,0:22:06.35,Default,,0,0,0,,Жоқ, патшайым үшін жұмыс істеу мушкеттердің міндеті.
Dialogue: 0,0:22:06.35,0:22:10.36,Default,,0,0,0,,Жақсы, бірақ осылай киінбейінше сарайға кіре алмайсың...
Dialogue: 0,0:22:10.32,0:22:13.91,Default,,0,0,0,,Мен оны енді кигім келмейді...
Dialogue: 0,0:22:13.99,0:22:18.08,Default,,0,0,0,,Күрсіндім... Мен өзімді сергек сезінемін.
Dialogue: 0,0:22:18.18,0:22:21.99,Default,,0,0,0,,Жақсы…. Хехехехе.
Dialogue: 0,0:22:30.01,0:22:33.11,Default,,0,0,0,,Сізге көп рахмет, д'Артаньян.
Dialogue: 0,0:22:33.15,0:22:35.75,Default,,0,0,0,,Не? Бұл соншалықты үлкен мәміле емес.
Dialogue: 0,0:22:35.82,0:22:37.92,Default,,0,0,0,,Бірақ... бірақ?
Dialogue: 0,0:22:37.99,0:22:40.49,Default,,0,0,0,,Жан көшірмені алды➡
Dialogue: 0,0:22:40.52,0:22:44.83,Default,,0,0,0,,Меніңше, аз да болса сыйақы болса жақсы болар еді...
Dialogue: 0,0:22:44.84,0:22:48.35,Default,,0,0,0,,Королева да сізге алғыс айтуы керек. Маған патшайымның садағы керек емес.
Dialogue: 0,0:22:48.33,0:22:50.33,Default,,0,0,0,,Иә….
Dialogue: 0,0:22:50.33,0:22:54.94,Default,,0,0,0,,Бұл алқа мен үшін ең маңыздысы, бірақ мен оны саған беремін.
Dialogue: 0,0:22:55.02,0:22:57.02,Default,,0,0,0,,Иә! Жоқ.
Dialogue: 0,0:22:56.99,0:22:59.09,Default,,0,0,0,,Ожерельдер – сәтсіздік.
Dialogue: 0,0:22:59.19,0:23:02.28,Default,,0,0,0,,Не айтып тұрсың, Жан? Мен қиындықты көтердім ...
Dialogue: 0,0:23:05.00,0:23:07.00,Default,,0,0,0,,Е...
Dialogue: 0,0:23:08.68,0:23:14.49,Default,,0,0,0,,Сәлем Констанс. Мен патшайымның алқасын қайтарып алатыныма сенімдімін.
Dialogue: 0,0:23:14.51,0:23:17.89,Default,,0,0,0,,Уайымдамаңыз.
Dialogue: 0,0:23:17.98,0:23:23.28,Default,,0,0,0,,(айқай)
Dialogue: 0,0:23:23.31,0:23:25.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:25.35,0:23:27.35,Default,,0,0,0,,«Аншин Сиротта». Хаха.
Dialogue: 0,0:23:27.32,0:23:32.62,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:23:32.69,0:23:38.70,Default,,0,0,0,,Шпиондық көшірме Жалаңаяқ Жанмен дос болып кеткен көрінеді.
Dialogue: 0,0:23:38.65,0:23:42.95,Default,,0,0,0,,Бірақ алмас алқаны ойласам➡
Dialogue: 0,0:23:43.02,0:23:49.01,Default,,0,0,0,,Констанстың жүрегі еріксіз батып кетті.
Dialogue: 0,0:23:53.33,0:23:59.63,Default,,0,0,0,,♬～
