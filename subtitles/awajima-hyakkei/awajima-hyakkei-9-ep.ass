Dialogue: 1,0:02:07.90,0:02:10.90,Title,,0,0,0,,Таншима мәдени фестивалі
Dialogue: 1,0:09:16.87,0:09:19.37,Title,,0,0,0,,Акихо Кашивара Вакана Вадабата
Dialogue: 1,0:00:32.68,0:00:39.39,OP - CN,,0,0,0,,Өмірдің тағдыры шақырылып, үлкен сахнаға көтерілеміз.
Dialogue: 1,0:00:40.68,0:00:45.94,OP - CN,,0,0,0,,Теңіздің жүрегіндегі жарық туралы ойлау
Dialogue: 1,0:00:47.40,0:00:53.66,OP - CN,,0,0,0,,Арманымды қайталау жолында, барған соң, қызған күйде болдым.
Dialogue: 1,0:00:54.66,0:00:58.74,OP - CN,,0,0,0,,Бірден жүрекке ән айту
Dialogue: 1,0:00:59.04,0:01:01.66,OP - CN,,0,0,0,,Алдында Акебоно Мицунари
Dialogue: 1,0:01:01.66,0:01:05.12,OP - CN,,0,0,0,,Сіз және сіздің серіктесіңіз
Dialogue: 1,0:01:05.12,0:01:08.42,OP - CN,,0,0,0,,Баратын жерге саяхат
Dialogue: 1,0:01:08.75,0:01:12.42,OP - CN,,0,0,0,,Түнгі аспан астында мен жұлдыздарды да көремін
Dialogue: 1,0:01:12.42,0:01:16.18,OP - CN,,0,0,0,,Жарық жағына бағыт
Dialogue: 1,0:01:17.35,0:01:21.02,OP - CN,,0,0,0,,Қайсар қол, зор тілек
Dialogue: 1,0:01:21.02,0:01:24.69,OP - CN,,0,0,0,,Керек емес пе, біреудің көзінде бұл арман.
Dialogue: 1,0:01:24.69,0:01:28.86,OP - CN,,0,0,0,,Инаугурация: «Ең ерте келіп, жанып кеткен жұлдызды генерал».
Dialogue: 1,0:01:28.86,0:01:32.19,OP - CN,,0,0,0,,Га-я-кайды жеңу тағдыры
Dialogue: 1,0:01:32.19,0:01:35.45,OP - CN,,0,0,0,,Адамның ақыл-парасатынан ада ерлер
Dialogue: 1,0:01:35.45,0:01:39.33,OP - CN,,0,0,0,,Тек талап пен ішкі дауыс
Dialogue: 1,0:01:39.33,0:01:42.95,OP - CN,,0,0,0,,Жын шығару
Dialogue: 1,0:01:42.95,0:01:44.79,OP - CN,,0,0,0,,Йоми Шого
Dialogue: 1,0:01:44.79,0:01:49.21,OP - CN,,0,0,0,,Бір-бірімен әрекеттесу
Dialogue: 1,0:01:50.46,0:01:52.80,OP - CN,,0,0,0,,Ең сирек кездесетін анттың қолданылуы
Dialogue: 0,0:00:32.68,0:00:39.39,OP - JP,,0,0,0,,ей, тағдыр үлкен сахнаға шақырады
Dialogue: 0,0:00:40.68,0:00:45.94,OP - JP,,0,0,0,,Жүрегіме толады прожектор, Сезімім қайта қызады
Dialogue: 0,0:00:47.40,0:00:53.66,OP - JP,,0,0,0,,Әй, арман қуып көз жасын төккен алдымдағылар
Dialogue: 0,0:00:54.66,0:00:58.74,OP - JP,,0,0,0,,Мен сенгім келген жүрек сыздатып ән айтамын
Dialogue: 0,0:00:59.04,0:01:01.66,OP - JP,,0,0,0,,Жарық күтіп тұр
Dialogue: 0,0:01:01.66,0:01:05.12,OP - JP,,0,0,0,,Мен сені алдым Сенде мені
Dialogue: 0,0:01:05.12,0:01:08.42,OP - JP,,0,0,0,,Соңына дейін барыңыз
Dialogue: 0,0:01:08.75,0:01:12.42,OP - JP,,0,0,0,,О, түнде біз жұлдызға тілек айта аламыз
Dialogue: 0,0:01:12.42,0:01:16.18,OP - JP,,0,0,0,,Жарықтан тыс
Dialogue: 0,0:01:17.35,0:01:21.02,OP - JP,,0,0,0,,Мен үлкен арманға қол соза бердім
Dialogue: 0,0:01:21.02,0:01:24.69,OP - JP,,0,0,0,,Біреудің көзінде бұл арман
Dialogue: 0,0:01:24.69,0:01:28.86,OP - JP,,0,0,0,,«Барлық жұлдыздар жарқырайды, ең жылдам сөнеді»
Dialogue: 0,0:01:28.86,0:01:32.19,OP - JP,,0,0,0,,Біз оны жеңе аламыз
Dialogue: 0,0:01:32.19,0:01:35.45,OP - JP,,0,0,0,,Ертеңгі күнді ешкім білмейді
Dialogue: 0,0:01:35.45,0:01:39.33,OP - JP,,0,0,0,,Жүрегіңіздегі дауысты орындаңыз
Dialogue: 0,0:01:39.33,0:01:42.95,OP - JP,,0,0,0,,Мен жүгіргім келеді
Dialogue: 0,0:01:42.95,0:01:44.79,OP - JP,,0,0,0,,Арман және болашақ
Dialogue: 0,0:01:44.79,0:01:49.21,OP - JP,,0,0,0,,Қабаттасу
Dialogue: 0,0:01:50.46,0:01:52.80,OP - JP,,0,0,0,,менің кепіліммен
Dialogue: 3,0:22:25.66,0:22:33.33,ED - CN,,0,0,0,,...
Dialogue: 3,0:22:33.46,0:22:36.92,ED - CN,,0,0,0,,Зайна ауданы
Dialogue: 3,0:22:38.46,0:22:45.64,ED - CN,,0,0,0,,Өзіндік тәубеге келуге үлес қосу
Dialogue: 3,0:22:45.64,0:22:51.06,ED - CN,,0,0,0,,Жапондық өзін-өзі құрметтеудің барлық мүшелері
Dialogue: 3,0:22:51.22,0:22:57.73,ED - CN,,0,0,0,,Уақыт пен ақшаны сирек жұмсайды
Dialogue: 3,0:22:57.73,0:23:04.86,ED - CN,,0,0,0,,Дәл қазір мен Наджода жүгіріп жатырмын
Dialogue: 3,0:23:04.86,0:23:09.62,ED - CN,,0,0,0,,Бұрын-соңды болмаған мұраттарға ұмтылу жолында
Dialogue: 3,0:23:09.62,0:23:12.62,ED - CN,,0,0,0,,Уақыт өте келе өзгеретін нақты мен
Dialogue: 3,0:23:12.62,0:23:18.08,ED - CN,,0,0,0,,Еске алу кездесуі
Dialogue: 3,0:23:19.13,0:23:25.47,ED - CN,,0,0,0,,...
Dialogue: 3,0:23:25.47,0:23:32.02,ED - CN,,0,0,0,,Әр адамның өз мұраты бар.
Dialogue: 3,0:23:32.02,0:23:36.14,ED - CN,,0,0,0,,Түсіндегі бала
Dialogue: 3,0:23:36.14,0:23:42.98,ED - CN,,0,0,0,,...
Dialogue: 3,0:23:42.98,0:23:46.24,ED - CN,,0,0,0,,Дегенмен менің ойым болашақта.
Dialogue: 3,0:23:46.24,0:23:49.45,ED - CN,,0,0,0,,Мен болашақта боламын
Dialogue: 3,0:23:49.45,0:23:52.99,ED - CN,,0,0,0,,...
Dialogue: 1,0:22:25.66,0:22:33.33,ED - JP,,0,0,0,,Айнаға қарап, көз жасымды сүртіп, арман қудым.
Dialogue: 1,0:22:33.46,0:22:36.92,ED - JP,,0,0,0,,Сол жерде
Dialogue: 1,0:22:38.46,0:22:45.64,ED - JP,,0,0,0,,Өзімді құшақтай алмағаныма өкінемін
Dialogue: 1,0:22:45.64,0:22:51.06,ED - JP,,0,0,0,,Бөлмені мақтаныш басып өтті
Dialogue: 1,0:22:51.22,0:22:57.73,ED - JP,,0,0,0,,Бағалы уақыт ұрланды
Dialogue: 1,0:22:57.73,0:23:04.86,ED - JP,,0,0,0,,Қайтпай іздеген идеал жолы
Dialogue: 1,0:23:04.86,0:23:09.62,ED - JP,,0,0,0,,Бұрынғыдан көбірек жүру
Dialogue: 1,0:23:09.62,0:23:12.62,ED - JP,,0,0,0,,Мен қанағаттандым
Dialogue: 1,0:23:12.62,0:23:18.08,ED - JP,,0,0,0,,Мен өз естеліктерімді аралауға барамын
Dialogue: 1,0:23:19.13,0:23:25.47,ED - JP,,0,0,0,,Қоштасулар арасында да
Dialogue: 1,0:23:25.47,0:23:32.02,ED - JP,,0,0,0,,Біз әрқайсымыз өз идеалдарымызды жинақтадық.
Dialogue: 1,0:23:32.02,0:23:36.14,ED - JP,,0,0,0,,Түс көрген күнім
Dialogue: 1,0:23:36.14,0:23:42.98,ED - JP,,0,0,0,,Бұл алыс сияқты, бірақ бәрібір
Dialogue: 1,0:23:42.98,0:23:46.24,ED - JP,,0,0,0,,Мен оны болашаққа сақтаймын.
Dialogue: 1,0:23:46.24,0:23:49.45,ED - JP,,0,0,0,,Менің болашақ өзім
Dialogue: 1,0:23:49.45,0:23:52.99,ED - JP,,0,0,0,,Сізге ләззат алу үшін
Dialogue: 2,0:22:25.66,0:22:33.33,ED - CN - Shad,,0,0,0,,...
Dialogue: 2,0:22:33.46,0:22:36.92,ED - CN - Shad,,0,0,0,,Зайна ауданы
Dialogue: 2,0:22:38.46,0:22:45.64,ED - CN - Shad,,0,0,0,,Өзін-өзі тәубеге келтіруге үлес қосу
Dialogue: 2,0:22:45.64,0:22:51.06,ED - CN - Shad,,0,0,0,,Жапондық өзін-өзі құрметтеудің барлық мүшелері
Dialogue: 2,0:22:51.22,0:22:57.73,ED - CN - Shad,,0,0,0,,Сирек сатып алынатын уақытты пайдалану
Dialogue: 2,0:22:57.73,0:23:04.86,ED - CN - Shad,,0,0,0,,Дәл қазір мен Наджода жүгіріп жатырмын
Dialogue: 2,0:23:04.86,0:23:09.62,ED - CN - Shad,,0,0,0,,Бұрын-соңды болмаған мұраттарға ұмтылу жолында
Dialogue: 2,0:23:09.62,0:23:12.62,ED - CN - Shad,,0,0,0,,Уақыт өте келе өзгеретін нақты Мен
Dialogue: 2,0:23:12.62,0:23:18.08,ED - CN - Shad,,0,0,0,,Өткен жылғы кездесу
Dialogue: 2,0:23:19.13,0:23:25.47,ED - CN - Shad,,0,0,0,,...
Dialogue: 2,0:23:25.47,0:23:32.02,ED - CN - Shad,,0,0,0,,Әр адамның өз мұраты бар.
Dialogue: 2,0:23:32.02,0:23:36.14,ED - CN - Shad,,0,0,0,,Түсіндегі шарасыз бала
Dialogue: 2,0:23:36.14,0:23:42.98,ED - CN - Shad,,0,0,0,,...
Dialogue: 2,0:23:42.98,0:23:46.24,ED - CN - Shad,,0,0,0,,Дегенмен, мен болашақ туралы ойлауды жалғастырамын.
Dialogue: 2,0:23:46.24,0:23:49.45,ED - CN - Shad,,0,0,0,,Мен болашақтамын
Dialogue: 2,0:23:49.45,0:23:52.99,ED - CN - Shad,,0,0,0,,Noisei Yoshie көрмесі Күлімдеген бет
Dialogue: 0,0:22:25.66,0:22:33.33,ED - JP - Shad,,0,0,0,,Айнаға қарап, көз жасымды сүртіп, арман қудым.
Dialogue: 0,0:22:33.46,0:22:36.92,ED - JP - Shad,,0,0,0,,Сол жерде
Dialogue: 0,0:22:38.46,0:22:45.64,ED - JP - Shad,,0,0,0,,Өзімді құшақтай алмағаныма өкінемін
Dialogue: 0,0:22:45.64,0:22:51.06,ED - JP - Shad,,0,0,0,,Бөлмені мақтаныш басып өтті
Dialogue: 0,0:22:51.22,0:22:57.73,ED - JP - Shad,,0,0,0,,Бағалы уақыт ұрланды
Dialogue: 0,0:22:57.73,0:23:04.86,ED - JP - Shad,,0,0,0,,Іздегенім мінсіз жол
Dialogue: 0,0:23:04.86,0:23:09.62,ED - JP - Shad,,0,0,0,,Сол күндерден көбірек жүру
Dialogue: 0,0:23:09.62,0:23:12.62,ED - JP - Shad,,0,0,0,,Мен қанағаттандым
Dialogue: 0,0:23:12.62,0:23:18.08,ED - JP - Shad,,0,0,0,,Мен өз естеліктерімді аралауға барамын
Dialogue: 0,0:23:19.13,0:23:25.47,ED - JP - Shad,,0,0,0,,Қоштасулар арасында да
Dialogue: 0,0:23:25.47,0:23:32.02,ED - JP - Shad,,0,0,0,,Біз әрқайсымыз өз идеалдарымызды жинақтадық.
Dialogue: 0,0:23:32.02,0:23:36.14,ED - JP - Shad,,0,0,0,,Түс көрген күнім
Dialogue: 0,0:23:36.14,0:23:42.98,ED - JP - Shad,,0,0,0,,Бұл алыс сияқты, бірақ бәрібір
Dialogue: 0,0:23:42.98,0:23:46.24,ED - JP - Shad,,0,0,0,,Мен оны болашаққа сақтаймын.
Dialogue: 0,0:23:46.24,0:23:49.45,ED - JP - Shad,,0,0,0,,Менің болашақ өзім
Dialogue: 0,0:23:49.45,0:23:52.99,ED - JP - Shad,,0,0,0,,Сізге ләззат алу үшін
