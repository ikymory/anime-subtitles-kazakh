Dialogue: 0,0:05:13.17,0:05:17.92,Default,,0,0,0,,Кубота отбасын жерлеу рәсімі
Dialogue: 0,0:13:13.44,0:13:16.44,Default,,0,0,0,,Ито Кошо
Dialogue: 0,0:13:13.44,0:13:16.44,Default,,0,0,0,,Ішкі аурулар · Тыныс алу аурулары
Dialogue: 0,0:13:13.44,0:13:16.44,Default,,0,0,0,,Ғылым бөлімі
Dialogue: 0,0:13:13.44,0:13:16.44,Default,,0,0,0,,Кіру · Тұрғын аурухана
Dialogue: 0,0:13:13.44,0:13:16.44,Default,,0,0,0,,Шу 1-ден Шу 5-ке дейін
Dialogue: 0,0:13:13.44,0:13:16.44,Default,,0,0,0,,Шуроку
Dialogue: 0,0:15:58.69,0:16:01.69,Default,,0,0,0,,Күзгі консорциум 《Он екінші түн》
Dialogue: 0,0:15:58.69,0:16:01.69,Default,,0,0,0,,Оокура —— Хироми Абэ, Окуниши графы —— Сато Окури Коэй —— Юки Онода
Dialogue: 0,0:21:04.70,0:21:06.75,Default,,0,0,0,,Сыртқа шығуға рұқсат сұрау
Dialogue: 0,0:21:04.70,0:21:06.75,Default,,0,0,0,,Аудандық бөлім
Dialogue: 0,0:21:04.70,0:21:06.75,Default,,0,0,0,,Қоғамдық істер
Dialogue: 0,0:21:04.70,0:21:06.75,Default,,0,0,0,,Жеке мәселелер
Dialogue: 0,0:21:04.70,0:21:06.75,Default,,0,0,0,,Өкіл тобы/аты
Dialogue: 0,0:21:04.70,0:21:06.75,Default,,0,0,0,,Тасымалдау А
Dialogue: 0,0:21:04.70,0:21:06.75,Default,,0,0,0,,Вакаюмен бірге жүретін барлық студенттерді тіркеу (өзін қоса)
Dialogue: 0,0:21:04.70,0:21:06.75,Default,,0,0,0,,Сынып/Аты
Dialogue: 0,0:21:04.70,0:21:06.75,Default,,0,0,0,,Шығу себебін тіркеу
Dialogue: 0,0:21:04.70,0:21:06.75,Default,,0,0,0,,Өткен сауда көшесінде сатылатын күнделікті қажетті заттар
Dialogue: 0,0:21:04.70,0:21:06.75,Default,,0,0,0,,Шығу туралы арнайы өтініш
Dialogue: 0,0:21:04.70,0:21:06.75,Default,,0,0,0,,Мұғалімнің аты-жөні
Dialogue: 0,0:00:06.58,0:00:07.99,Default,,0,0,0,,Бұл өте әдемі адам
Dialogue: 0,0:00:06.58,0:00:07.99,Default,,0,0,0,,Бұл керемет болды
Dialogue: 0,0:00:09.00,0:00:11.35,Default,,0,0,0,,Бұл да менің алғашқы махаббатым.
Dialogue: 0,0:00:09.00,0:00:11.35,Default,,0,0,0,,Менің алғашқы махаббатым сол адам
Dialogue: 0,0:00:13.87,0:00:17.37,Default,,0,0,0,,Ерлердің костюмдері
Dialogue: 0,0:00:13.87,0:00:17.37,Default,,0,0,0,,Сол еркек рөлі
Dialogue: 0,0:00:26.05,0:00:28.93,Default,,0,0,0,,Келмеу төлемі
Dialogue: 0,0:00:26.05,0:00:28.93,Default,,0,0,0,,Білесіз бе, бұл жақсы болмады.
Dialogue: 0,0:00:28.93,0:00:32.55,Default,,0,0,0,,...
Dialogue: 0,0:00:28.93,0:00:32.55,Default,,0,0,0,,Ахаха, тым ерте бас тартасың.
Dialogue: 0,0:00:32.55,0:00:36.19,Default,,0,0,0,,Менің жұмысыма май қосу үшін қолдануға болады.
Dialogue: 0,0:00:32.55,0:00:36.19,Default,,0,0,0,,Әйтеуір Эми-чанды қолдайтын біздер ғой.
Dialogue: 0,0:00:36.19,0:00:37.97,Default,,0,0,0,,Адамдар туралы не шындық?
Dialogue: 0,0:00:36.19,0:00:37.97,Default,,0,0,0,,Сіз қазірдің өзінде барсыз
Dialogue: 0,0:00:39.33,0:00:44.69,Default,,0,0,0,,Мен өте танымал адаммын.
Dialogue: 0,0:00:39.33,0:00:44.69,Default,,0,0,0,,Трансфер студенті Эми Чан шынымен де керемет болды.
Dialogue: 0,0:00:47.05,0:00:50.49,Default,,0,0,0,,Бар уақыт пен жақсы сөз және жақсы жолдар
Dialogue: 0,0:00:47.05,0:00:50.49,Default,,0,0,0,,Сәнді, анық айтады.
Dialogue: 0,0:00:50.49,0:00:54.95,Default,,0,0,0,,Ньоичи Наомоте сұлулығы
Dialogue: 0,0:00:50.49,0:00:54.95,Default,,0,0,0,,Мен бұл сәйкессіздікті сезініп қалдым.
Dialogue: 0,0:00:56.26,0:00:59.58,Default,,0,0,0,,Сұлулық туралы толық шолу мектебінде көрсетілгендей
Dialogue: 0,0:00:56.26,0:00:59.58,Default,,0,0,0,,Неліктен Эми опера мектебіне баруды мақсат етті?
Dialogue: 0,0:00:59.58,0:01:01.36,Default,,0,0,0,,Бұл қажет
Dialogue: 0,0:00:59.58,0:01:01.36,Default,,0,0,0,,Бұл сөзсіз болды.
Dialogue: 0,0:02:26.07,0:02:28.07,Default,,0,0,0,,Койоши мен ойладым.
Dialogue: 0,0:02:26.07,0:02:28.07,Default,,0,0,0,,Экчан өтті
Dialogue: 0,0:02:29.38,0:02:31.63,Default,,0,0,0,,...
Dialogue: 0,0:02:29.38,0:02:31.63,Default,,0,0,0,,Мен Авашимадан өттім.
Dialogue: 0,0:02:34.47,0:02:36.55,Default,,0,0,0,,...
Dialogue: 0,0:02:34.47,0:02:36.55,Default,,0,0,0,,Анам Ана керемет
Dialogue: 0,0:02:36.55,0:02:38.93,Default,,0,0,0,,...
Dialogue: 0,0:02:36.55,0:02:38.93,Default,,0,0,0,,Эми-чан Авашима өтті.
Dialogue: 0,0:02:39.39,0:02:48.02,Default,,0,0,0,,Зиянды сұлулық
Dialogue: 0,0:02:39.39,0:02:48.02,Default,,0,0,0,,Эми-чан керемет
Dialogue: 0,0:02:42.35,0:02:44.07,Default,,0,0,0,,Таңшима – бұл
Dialogue: 0,0:02:42.35,0:02:44.07,Default,,0,0,0,,Авашима дегеніміз не?
Dialogue: 0,0:02:44.07,0:02:46.90,Default,,0,0,0,,Ән мен жыр мектебі
Dialogue: 0,0:02:44.07,0:02:46.90,Default,,0,0,0,,Қараңызшы, бұл ән немесе басқа нәрсе болды.
Dialogue: 0,0:02:46.90,0:02:50.57,Default,,0,0,0,,Бұл Эцуконың соңғы орны.
Dialogue: 0,0:02:46.90,0:02:50.57,Default,,0,0,0,,А, менің ойымша, Эцуконың барғысы келетіні туралы көп шу болды.
Dialogue: 0,0:02:51.19,0:02:55.45,Default,,0,0,0,,Жұмыс емтиханын тапсырған табысты әйел актерлер
Dialogue: 0,0:02:51.19,0:02:55.45,Default,,0,0,0,,Ондай жерге барып актриса болу мүмкін емес.
Dialogue: 0,0:02:55.45,0:02:56.95,Default,,0,0,0,,Сұлулықтың пайдасы мен зияны
Dialogue: 0,0:02:55.45,0:02:56.95,Default,,0,0,0,,Эми-чан керемет
Dialogue: 0,0:02:58.70,0:03:02.74,Default,,0,0,0,,Мен университет туралы ойлауым керек.
Dialogue: 0,0:02:58.70,0:03:02.74,Default,,0,0,0,,Егер сіз университетке қабылдансаңыз, спектакльді тамашалай аласыз.
Dialogue: 0,0:03:02.74,0:03:05.21,Default,,0,0,0,,Ойымның сұлулығын тойлау
Dialogue: 0,0:03:02.74,0:03:05.21,Default,,0,0,0,,Эми-чан, мен сені құттықтағым келеді.
Dialogue: 0,0:03:05.50,0:03:07.50,Default,,0,0,0,,Расталған көрініс аяқталды
Dialogue: 0,0:03:05.50,0:03:07.50,Default,,0,0,0,,Эми-чан шығады деп шешілді.
Dialogue: 0,0:03:07.50,0:03:09.46,Default,,0,0,0,,Бұл мектептегі жаңа оқушының өнері.
Dialogue: 0,0:03:07.50,0:03:09.46,Default,,0,0,0,,Бұл жаңа спектакль.
Dialogue: 0,0:03:09.46,0:03:12.21,Default,,0,0,0,,...
Dialogue: 0,0:03:09.46,0:03:12.21,Default,,0,0,0,,Эми-чан міндетті түрде басты кейіпкер болады.
Dialogue: 0,0:03:12.21,0:03:14.92,Default,,0,0,0,,Иссей Йозай Даиичи Кайкан
Dialogue: 0,0:03:12.21,0:03:14.92,Default,,0,0,0,,Мен оны бірінші қатардан көргім келеді.
Dialogue: 0,0:03:15.14,0:03:17.48,Default,,0,0,0,,Айдаһар плащын қалдыруға да болады.
Dialogue: 0,0:03:15.14,0:03:17.48,Default,,0,0,0,,Бұл қорқудың рөлі болуы мүмкін.
Dialogue: 0,0:03:17.48,0:03:21.68,Default,,0,0,0,,Сонымен қатар, мектепте әдеби қойылым жоқ.
Dialogue: 0,0:03:17.48,0:03:21.68,Default,,0,0,0,,Бұл мектеп шоуы емес, Авашима болуы мүмкін емес.
Dialogue: 0,0:03:22.88,0:03:25.94,Default,,0,0,0,,Сахнадағы әдемі көрініс
Dialogue: 0,0:03:22.88,0:03:25.94,Default,,0,0,0,,Біз сахнадан Эми-чанды іздедік.
Dialogue: 0,0:03:27.35,0:03:31.07,Default,,0,0,0,,Ойдан кейін ойдың болуы әңгіменің алғы шарты.
Dialogue: 0,0:03:27.35,0:03:31.07,Default,,0,0,0,,Дегенмен, мен сізге алдын ала хабарласуым керек еді.
Dialogue: 0,0:03:31.07,0:03:33.69,Default,,0,0,0,,Сондықтан кеш болды деп ойладым.
Dialogue: 0,0:03:31.07,0:03:33.69,Default,,0,0,0,,Менің ойымша, сіз рөлді әлі алған жоқсыз.
Dialogue: 0,0:03:39.41,0:03:42.19,Default,,0,0,0,,Менің қара шешімімнің алғашқы қойылымының жаңалықтары
Dialogue: 0,0:03:39.41,0:03:42.19,Default,,0,0,0,,Бірінші орындауыңыз туралы хабар алған кезде
Dialogue: 0,0:03:42.19,0:03:47.00,Default,,0,0,0,,Сізді бірінші жұмыстан шығуыңызбен және жұмыс шығындарымен құттықтаймыз
Dialogue: 0,0:03:42.19,0:03:47.00,Default,,0,0,0,,Біз бірінші жарты күндік жұмысымыздың ақшасына тойлауды шештік.
Dialogue: 0,0:03:50.98,0:03:52.96,Default,,0,0,0,,Дегенмен, телефон басталуы және аяқталуы мүмкін және т.б.
Dialogue: 0,0:03:50.98,0:03:52.96,Default,,0,0,0,,Әзірге телефон қоңыраулары жоқ
Dialogue: 0,0:03:54.05,0:03:56.13,Default,,0,0,0,,...
Dialogue: 0,0:03:54.05,0:03:56.13,Default,,0,0,0,,Эй, сен білмедің бе?
Dialogue: 0,0:03:56.13,0:03:59.18,Default,,0,0,0,,...
Dialogue: 0,0:03:56.13,0:03:59.18,Default,,0,0,0,,Эми-чан, сенің жұмыстан кеткеніңді баяғыда естідім.
Dialogue: 0,0:03:59.18,0:04:00.21,Default,,0,0,0,,Ескерту: жапон тілінде «емтиханға өтініш беру» мен «өлім» сөздері бірдей айтылады
Dialogue: 0,0:03:59.18,0:04:00.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:00.21,0:04:03.68,Default,,0,0,0,,Түсіндірме, сіз мектепке барар алдында тұруыңызды аяқтадыңыз.
Dialogue: 0,0:04:00.21,0:04:03.68,Default,,0,0,0,,Ол Авашимаға қосылмас бұрын оқу-жаттығу жиынын тастады.
Dialogue: 0,0:04:04.06,0:04:08.31,Default,,0,0,0,,Аралда орналасқан компанияның мүсіні
Dialogue: 0,0:04:04.06,0:04:08.31,Default,,0,0,0,,Қазір ағамның компаниясы Хиросимада орналасқан.
Dialogue: 0,0:04:08.31,0:04:10.59,Default,,0,0,0,,Ағымдағы жұмыс
Dialogue: 0,0:04:08.31,0:04:10.59,Default,,0,0,0,,Ақыры даяшы келді.
Dialogue: 0,0:04:10.59,0:04:16.07,Default,,0,0,0,,Мен не айтарымды білмеймін.
Dialogue: 0,0:04:10.59,0:04:16.07,Default,,0,0,0,,Көрдің бе, өнерлі адам болмайынша өмір сүре алмайтын дүние.
Dialogue: 0,0:04:17.95,0:04:21.80,Default,,0,0,0,,Былайша айтқанда, оқиғаның көркі – ол мүлде адасқан адам.
Dialogue: 0,0:04:17.95,0:04:21.80,Default,,0,0,0,,Өтінемін, Эми-чанға ол дарынды емес сияқты қоңырау шалмаңыз.
Dialogue: 0,0:04:25.21,0:04:27.54,Default,,0,0,0,,...
Dialogue: 0,0:04:25.21,0:04:27.54,Default,,0,0,0,,Мен сенің анаң туралы ештеңе білмесем де.
Dialogue: 0,0:04:27.54,0:04:29.58,Default,,0,0,0,,Өздігінен әңгімелеу
Dialogue: 0,0:04:27.54,0:04:29.58,Default,,0,0,0,,Тек өзімшіл нәрселер
Dialogue: 0,0:04:33.93,0:04:37.51,Default,,0,0,0,,...
Dialogue: 0,0:04:33.93,0:04:37.51,Default,,0,0,0,,Мен бұл туралы ештеңе білмедім.
Dialogue: 0,0:04:37.51,0:04:41.55,Default,,0,0,0,,Осыған байланысты мен оны бұрын көрмедім.
Dialogue: 0,0:04:37.51,0:04:41.55,Default,,0,0,0,,Біз енді ешқашан кездеспейміз деп үміттенемін.
Dialogue: 0,0:04:52.53,0:04:55.01,Default,,0,0,0,,Аралдан қашан шығу керек
Dialogue: 0,0:04:52.53,0:04:55.01,Default,,0,0,0,,Хиросимаға дейін 2 сағат
Dialogue: 0,0:04:55.01,0:04:57.79,Default,,0,0,0,,Екеуінің арасында үлкен қашықтық бар
Dialogue: 0,0:04:55.01,0:04:57.79,Default,,0,0,0,,Мен сені көруге баратын жерім жетпейді.\N23-бөлім
Dialogue: 0,0:04:57.79,0:05:02.20,Default,,0,0,0,,...
Dialogue: 0,0:04:57.79,0:05:02.20,Default,,0,0,0,,Мен өзімді ешқашан естімеген шет елге жібергендей сезінемін.
Dialogue: 0,0:05:05.03,0:05:10.62,Default,,0,0,0,,Одан кейін үйленуге бірге жұмыс істедім.
Dialogue: 0,0:05:05.03,0:05:10.62,Default,,0,0,0,,Одан кейін жұмысқа орналастым, келін түсіріп, үйлендім.
Dialogue: 0,0:05:10.62,0:05:13.17,Default,,0,0,0,,Сәтті туу және баланың анасы
Dialogue: 0,0:05:10.62,0:05:13.17,Default,,0,0,0,,Екі ұлдың ата-анасы болды
Dialogue: 0,0:05:16.13,0:05:17.92,Default,,0,0,0,,Көп жылдардан кейін сұлуды қайта көрдім
Dialogue: 0,0:05:16.13,0:05:17.92,Default,,0,0,0,,Мен Эми-чанды кездестірдім
Dialogue: 0,0:05:18.93,0:05:21.43,Default,,0,0,0,,Бұл жерлеу рәсімі.
Dialogue: 0,0:05:18.93,0:05:21.43,Default,,0,0,0,,Бұл Эми-чанның жерлеу рәсімі болатын.
Dialogue: 0,0:05:23.47,0:05:25.68,Default,,0,0,0,,Токучихо Мия Юрё отбасы
Dialogue: 0,0:05:23.47,0:05:25.68,Default,,0,0,0,,Эмидің де отбасы бар.
Dialogue: 0,0:05:26.04,0:05:29.34,Default,,0,0,0,,Күшті жапонның заманы туралы сұрақтар
Dialogue: 0,0:05:26.04,0:05:29.34,Default,,0,0,0,,Күйеуі мен ұлдарымен амандасу
Dialogue: 0,0:05:29.34,0:05:31.60,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймын.
Dialogue: 0,0:05:29.34,0:05:31.60,Default,,0,0,0,,Мен өзімді жеңіл сезінемін.
Dialogue: 0,0:05:33.37,0:05:36.69,Default,,0,0,0,,Сұлулық туралы ойлар жалғыз емес.
Dialogue: 0,0:05:33.37,0:05:36.69,Default,,0,0,0,,Эми-чан, сен жалғыз болған жоқсың.
Dialogue: 0,0:05:43.25,0:05:45.95,Default,,0,0,0,,Сен үшін кешірім сұраймын.
Dialogue: 0,0:05:43.25,0:05:45.95,Default,,0,0,0,,Мен сені аядым.
Dialogue: 0,0:05:50.54,0:05:52.00,Default,,0,0,0,,Бірінші сынып
Dialogue: 0,0:05:50.54,0:05:52.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:05:59.21,0:06:03.01,Default,,0,0,0,,Тегі - Онода.
Dialogue: 0,0:05:59.21,0:06:03.01,Default,,0,0,0,,Сіздің қыз есіміңіз Онода емес пе?
Dialogue: 0,0:06:07.64,0:06:11.23,Default,,0,0,0,,Төтенше жағдайды құшақтау Кенеттен айғайлау
Dialogue: 0,0:06:07.64,0:06:11.23,Default,,0,0,0,,Сізді кенет тоқтатқаным үшін кешіріңіз.
Dialogue: 0,0:06:11.23,0:06:14.42,Default,,0,0,0,,Бұл жай ғана…
Dialogue: 0,0:06:11.23,0:06:14.42,Default,,0,0,0,,Жоқ, бұл жай ғана...
Dialogue: 0,0:06:16.06,0:06:23.07,Default,,0,0,0,,Такехара есімі енді Ураками болып өзгертілді.
Dialogue: 0,0:06:16.06,0:06:23.07,Default,,0,0,0,,Жоқ. Менің қыз атым Такехара, ал қазіргі атым - Ураками.
Dialogue: 0,0:06:26.60,0:06:29.04,Default,,0,0,0,,Қолайсыз бүкіл дене жалғыз және дымқыл
Dialogue: 0,0:06:26.60,0:06:29.04,Default,,0,0,0,,Мен қатты ылғалданамын.
Dialogue: 0,0:06:31.29,0:06:35.42,Default,,0,0,0,,Бұл кенеттен болған нәрсе.
Dialogue: 0,0:06:31.29,0:06:35.42,Default,,0,0,0,,Мен бұрын шынымен дөрекі болдым.
Dialogue: 0,0:06:35.42,0:06:40.59,Default,,0,0,0,,Бұл менің кінәм емес, мен Мэңнің ықыласына көнемін, мен жауға қарсы тұрамын.
Dialogue: 0,0:06:35.42,0:06:40.59,Default,,0,0,0,,Жоқ, сөзіме еріп бара жатқан менмін.
Dialogue: 0,0:06:41.84,0:06:46.09,Default,,0,0,0,,Қайтыс болған әйелімнің мүсінін көріп, зиярат еттім.
Dialogue: 0,0:06:41.84,0:06:46.09,Default,,0,0,0,,Өзім құрдас әйелді көргенде мен де сол сұрақты қойдым.
Dialogue: 0,0:06:50.60,0:06:51.75,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:06:50.60,0:06:51.75,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:06:51.75,0:06:56.15,Default,,0,0,0,,Әйелім мен балаларым қайтыс болғаннан кейін маған жіберілетін мөр осы.
Dialogue: 0,0:06:51.75,0:06:56.15,Default,,0,0,0,,Мен бұл хатты әйелім қайтыс болғаннан кейін таптым.
Dialogue: 0,0:07:03.90,0:07:09.20,Default,,0,0,0,,Шинсатоның мазмұны тек кінәсін мойындау
Dialogue: 0,0:07:03.90,0:07:09.20,Default,,0,0,0,,Мазмұны кешірім сұрау мен мойындаудан басқа ештеңе болмады.
Dialogue: 0,0:07:15.96,0:07:19.59,Default,,0,0,0,,Менің көз алдымда үйеңкі ұшады махаббат еліне.
Dialogue: 0,0:07:15.96,0:07:19.59,Default,,0,0,0,,Шие гүлдері оңай түседі
Dialogue: 0,0:07:19.88,0:07:26.13,Default,,0,0,0,,Өз денем мен өз денем шашылып жатыр.
Dialogue: 0,0:07:19.88,0:07:26.13,Default,,0,0,0,,Менің де денем толығымен шашырап кетсе жақсы болар еді деп ойладым.
Dialogue: 0,0:07:30.41,0:07:32.59,Default,,0,0,0,,Натен бөлек аралда
Dialogue: 0,0:07:30.41,0:07:32.59,Default,,0,0,0,,Мен Авашиманы тастаған күнім
Dialogue: 0,0:07:32.59,0:07:34.68,Default,,0,0,0,,Мен жалғызбын
Dialogue: 0,0:07:32.59,0:07:34.68,Default,,0,0,0,,Мен жалғыз болдым
Dialogue: 0,0:07:36.85,0:07:38.61,Default,,0,0,0,,Түзету
Dialogue: 0,0:07:36.85,0:07:38.61,Default,,0,0,0,,Түзету
Dialogue: 0,0:07:38.61,0:07:42.19,Default,,0,0,0,,Зайнари Мен жалғызбын, жалғызбын
Dialogue: 0,0:07:38.61,0:07:42.19,Default,,0,0,0,,Жалғыз болмаған күнім болған емес.
Dialogue: 0,0:07:47.86,0:07:49.37,Default,,0,0,0,,Хоми Догаку
Dialogue: 0,0:07:47.86,0:07:49.37,Default,,0,0,0,,Эми-сан
Dialogue: 0,0:08:00.31,0:08:01.50,Default,,0,0,0,,Оны оқып берейін.
Dialogue: 0,0:08:00.31,0:08:01.50,Default,,0,0,0,,Мен...
Dialogue: 0,0:08:02.84,0:08:04.51,Default,,0,0,0,,Кешір мені.
Dialogue: 0,0:08:02.84,0:08:04.51,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:08:05.67,0:08:07.22,Default,,0,0,0,,Кешір мені.
Dialogue: 0,0:08:05.67,0:08:07.22,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:08:08.68,0:08:10.12,Default,,0,0,0,,Джиорно, жараландың ба?
Dialogue: 0,0:08:08.68,0:08:10.12,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:08:10.12,0:08:12.26,Default,,0,0,0,,Бұл менің жеке шешімім
Dialogue: 0,0:08:10.12,0:08:12.26,Default,,0,0,0,,Бұл менің шешімім болды.
Dialogue: 0,0:08:13.87,0:08:17.10,Default,,0,0,0,,Онода бір мектепте оқығанда, мен оны екінші жақтан көрдім.
Dialogue: 0,0:08:13.87,0:08:17.10,Default,,0,0,0,,Онода мырзаның мені көруге келгеніне қуаныштымын.
Dialogue: 0,0:08:21.15,0:08:26.28,Default,,0,0,0,,Мен таза әйел емеспін, қатын-балалы әйелмін, барғаныма еш өкінбеймін.
Dialogue: 0,0:08:21.15,0:08:26.28,Default,,0,0,0,,Ол адам мен оның әйелі арасында қандай қарым-қатынас болғанын білмеймін.
Dialogue: 0,0:08:26.99,0:08:30.24,Default,,0,0,0,,...
Dialogue: 0,0:08:26.99,0:08:30.24,Default,,0,0,0,,Әйелі өз жауабын қалай жазды
Dialogue: 0,0:08:30.24,0:08:32.78,Default,,0,0,0,,Сондай-ақ, бұл бастапқы байланыс.
Dialogue: 0,0:08:30.24,0:08:32.78,Default,,0,0,0,,Әлде сен жазбадың ба?
Dialogue: 0,0:08:32.78,0:08:35.16,Default,,0,0,0,,Мен өзім туралы ештеңе білмеймін.
Dialogue: 0,0:08:32.78,0:08:35.16,Default,,0,0,0,,Білмеу жақсы
Dialogue: 0,0:08:35.16,0:08:39.29,Default,,0,0,0,,Ескі әңгіме Шынымен үмітім үзілді
Dialogue: 0,0:08:35.16,0:08:39.29,Default,,0,0,0,,Шынымды айтсам, көрмеген болар едім.
Dialogue: 0,0:08:52.52,0:08:56.68,Default,,0,0,0,,...
Dialogue: 0,0:08:52.52,0:08:56.68,Default,,0,0,0,,Қараңызшы, бұл Эми Окабе, стипендиат студенті.
Dialogue: 0,0:08:57.23,0:09:00.94,Default,,0,0,0,,Дәліздің ортасы
Dialogue: 0,0:08:57.23,0:09:00.94,Default,,0,0,0,,Ол күткендей орталықта сенімді жүріп жатыр.
Dialogue: 0,0:09:02.31,0:09:07.19,Default,,0,0,0,,...
Dialogue: 0,0:09:02.31,0:09:07.19,Default,,0,0,0,,Эй, Кумада саған көп ұнайтын сияқты.
Dialogue: 0,0:09:07.82,0:09:11.45,Default,,0,0,0,,Сіз өзіңіздің алғашқы қайырымдылықыңыз үшін жауаптысыз.
Dialogue: 0,0:09:07.82,0:09:11.45,Default,,0,0,0,,Тіпті пәктігімді де солай біреуге бердім.
Dialogue: 0,0:09:14.38,0:09:16.16,Default,,0,0,0,,және т.б. Кейко Дугаку
Dialogue: 0,0:09:14.38,0:09:16.16,Default,,0,0,0,,Күте тұрыңыз, Кейко-сан.
Dialogue: 0,0:09:28.10,0:09:31.97,Default,,0,0,0,,Мен жоғалтқаным үшін кешірім сұраймын.
Dialogue: 0,0:09:28.10,0:09:31.97,Default,,0,0,0,,Мен ол адамды қорғай алмадым.
Dialogue: 0,0:09:33.22,0:09:36.06,Default,,0,0,0,,Миёшидің беті
Dialogue: 0,0:09:33.22,0:09:36.06,Default,,0,0,0,,Сіз өте кереметсіз
Dialogue: 0,0:09:36.06,0:09:39.23,Default,,0,0,0,,Мен мұны істемеуді таңдаймын.
Dialogue: 0,0:09:36.06,0:09:39.23,Default,,0,0,0,,Мен жалғыз әлсізмін
Dialogue: 0,0:09:49.61,0:09:50.93,Default,,0,0,0,,Құрғақ?
Dialogue: 0,0:09:49.61,0:09:50.93,Default,,0,0,0,,Не?
Dialogue: 0,0:09:50.93,0:09:53.11,Default,,0,0,0,,Мен сөйлеу үшін келдім.
Dialogue: 0,0:09:50.93,0:09:53.11,Default,,0,0,0,,Мен саған түкірдім.
Dialogue: 0,0:09:57.74,0:09:58.95,Default,,0,0,0,,Жақсы көңіл-күй
Dialogue: 0,0:09:57.74,0:09:58.95,Default,,0,0,0,,Кешірім сұраңыз
Dialogue: 0,0:10:00.81,0:10:03.21,Default,,0,0,0,,Менің жолға түскенімді қаламасаң,
Dialogue: 0,0:10:00.81,0:10:03.21,Default,,0,0,0,,Неліктен кешірім сұрауым керек?
Dialogue: 0,0:10:03.70,0:10:06.84,Default,,0,0,0,,Мен оны көптен бері қабылдадым.
Dialogue: 0,0:10:03.70,0:10:06.84,Default,,0,0,0,,Мен ұзақ шыдадым.
Dialogue: 0,0:10:07.97,0:10:10.53,Default,,0,0,0,,Шебер жасаған кішкентай бала мінез
Dialogue: 0,0:10:07.97,0:10:10.53,Default,,0,0,0,,Ересек адамның бетін балалықпен қарау
Dialogue: 0,0:10:10.53,0:10:13.22,Default,,0,0,0,,Бұл өзін-өзі жою үшін үлкен күш.
Dialogue: 0,0:10:10.53,0:10:13.22,Default,,0,0,0,,Бұл ештеңе емес.
Dialogue: 0,0:10:13.59,0:10:16.72,Default,,0,0,0,,Кагая Ичия ересек адам емес.
Dialogue: 0,0:10:13.59,0:10:16.72,Default,,0,0,0,,Мен тіпті ересек емеспін.
Dialogue: 0,0:10:16.72,0:10:18.22,Default,,0,0,0,,Мен ең тәжірибелімін.
Dialogue: 0,0:10:16.72,0:10:18.22,Default,,0,0,0,,Мен ондай адамдарды жек көремін.
Dialogue: 0,0:10:18.22,0:10:19.64,Default,,0,0,0,,Ойлы өлім
Dialogue: 0,0:10:18.22,0:10:19.64,Default,,0,0,0,,Менің өлуім керек деп ойлаймын.
Dialogue: 0,0:10:19.64,0:10:22.23,Default,,0,0,0,,Тәртіпсіздік
Dialogue: 0,0:10:19.64,0:10:22.23,Default,,0,0,0,,Жоқ, жоқ, жоқ.
Dialogue: 0,0:10:22.73,0:10:25.44,Default,,0,0,0,,Ибуки Догаку – қайтпас күш.
Dialogue: 0,0:10:22.73,0:10:25.44,Default,,0,0,0,,Тек Ибуки-сан ашуланбауы керек.
Dialogue: 0,0:10:25.44,0:10:29.04,Default,,0,0,0,,Менің түлкі бар
Dialogue: 0,0:10:25.44,0:10:29.04,Default,,0,0,0,,Оның жаман достары көп.
Dialogue: 0,0:10:29.04,0:10:31.49,Default,,0,0,0,,Сіз бұл растауға алданып қалуыңыз мүмкін.
Dialogue: 0,0:10:29.04,0:10:31.49,Default,,0,0,0,,Саған бір қорқынышты нәрсе болатынына сенімдімін.
Dialogue: 0,0:10:31.49,0:10:34.32,Default,,0,0,0,,Мүсін болып бір мектепте оқитын адам
Dialogue: 0,0:10:31.49,0:10:34.32,Default,,0,0,0,,Эми сияқты сұлу адамдар
Dialogue: 0,0:10:34.32,0:10:35.57,Default,,0,0,0,,Толығымен…
Dialogue: 0,0:10:34.32,0:10:35.57,Default,,0,0,0,,Мүлдем...
Dialogue: 0,0:10:37.70,0:10:39.45,Default,,0,0,0,,Толығымен...
Dialogue: 0,0:10:37.70,0:10:39.45,Default,,0,0,0,,Мүлдем...
Dialogue: 0,0:10:41.20,0:10:43.29,Default,,0,0,0,,Дугаку Онода
Dialogue: 0,0:10:41.20,0:10:43.29,Default,,0,0,0,,Онода мырза
Dialogue: 0,0:10:43.29,0:10:45.46,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:10:43.29,0:10:45.46,Default,,0,0,0,,Саған бірдеңе болды ма?
Dialogue: 0,0:10:46.83,0:10:47.84,Default,,0,0,0,,Талқылау
Dialogue: 0,0:10:46.83,0:10:47.84,Default,,0,0,0,,Эй
Dialogue: 0,0:10:47.84,0:10:49.88,Default,,0,0,0,,Кейко Ибукидің бұрынғы алдауы
Dialogue: 0,0:10:47.84,0:10:49.88,Default,,0,0,0,,Кейко Ибукиге не істеді?
Dialogue: 0,0:10:49.88,0:10:51.05,Default,,0,0,0,,Мен сенімен кездескім келмейді.
Dialogue: 0,0:10:49.88,0:10:51.05,Default,,0,0,0,,Сіз емессіз бе?
Dialogue: 0,0:10:53.30,0:10:55.01,Default,,0,0,0,,Дұрыс емес
Dialogue: 0,0:10:53.30,0:10:55.01,Default,,0,0,0,,Жоқ
Dialogue: 0,0:10:55.01,0:10:57.05,Default,,0,0,0,,Өзін-өзі алдау және алдау
Dialogue: 0,0:10:55.01,0:10:57.05,Default,,0,0,0,,Маған ештеңе жасалған жоқ
Dialogue: 0,0:10:59.64,0:11:02.68,Default,,0,0,0,,Әйтсе де, бұл сыртқы көріністің тарихы.
Dialogue: 0,0:10:59.64,0:11:02.68,Default,,0,0,0,,Эмиге бірдеңе болса ше?
Dialogue: 0,0:11:02.68,0:11:05.56,Default,,0,0,0,,Менің ойым өлді
Dialogue: 0,0:11:02.68,0:11:05.56,Default,,0,0,0,,Мен өлемін деп ойлаймын
Dialogue: 0,0:11:08.57,0:11:10.99,Default,,0,0,0,,Жалпы
Dialogue: 0,0:11:08.57,0:11:10.99,Default,,0,0,0,,Кім сені бұрышқа түсірді
Dialogue: 0,0:11:10.99,0:11:13.57,Default,,0,0,0,,Кейко Ибуки
Dialogue: 0,0:11:10.99,0:11:13.57,Default,,0,0,0,,Бұл Кейко Ибуки болды ма?
Dialogue: 0,0:11:14.36,0:11:17.20,Default,,0,0,0,,Кейбір лицензия
Dialogue: 0,0:11:14.36,0:11:17.20,Default,,0,0,0,,Мүмкін бұл себеп болды
Dialogue: 0,0:11:19.49,0:11:24.00,Default,,0,0,0,,Алайда соңғы хабаршы аралды тастап кетті.
Dialogue: 0,0:11:19.49,0:11:24.00,Default,,0,0,0,,Бірақ сені Авашимадан қуып шыққан адам
Dialogue: 0,0:11:24.00,0:11:26.21,Default,,0,0,0,,Мен не көремін, мен солмын
Dialogue: 0,0:11:24.00,0:11:26.21,Default,,0,0,0,,Менің ойымша, бұл менікі.
Dialogue: 0,0:11:29.30,0:11:32.84,Default,,0,0,0,,Мен сен үшін келдім
Dialogue: 0,0:11:29.30,0:11:32.84,Default,,0,0,0,,Мен сенен қорықтым
Dialogue: 0,0:11:35.16,0:11:37.59,Default,,0,0,0,,...
Dialogue: 0,0:11:35.16,0:11:37.59,Default,,0,0,0,,Мен саған ғашық болдым
Dialogue: 0,0:11:39.75,0:11:42.10,Default,,0,0,0,,Жауапсыз махаббат
Dialogue: 0,0:11:39.75,0:11:42.10,Default,,0,0,0,,Жауапсыз махаббат деген не?
Dialogue: 0,0:11:42.39,0:11:46.48,Default,,0,0,0,,Келіп-кеткенімде бірнеше рет түстім.
Dialogue: 0,0:11:42.39,0:11:46.48,Default,,0,0,0,,Енді маған неше нәрсе болады?
Dialogue: 0,0:11:47.30,0:11:50.48,Default,,0,0,0,,Ойланып қарашы, мен суық емеспін.
Dialogue: 0,0:11:47.30,0:11:50.48,Default,,0,0,0,,Осыны ойлаудың өзі қалтырап кетеді.
Dialogue: 0,0:11:51.32,0:11:53.32,Default,,0,0,0,,Алайда болмашы махаббат
Dialogue: 0,0:11:51.32,0:11:53.32,Default,,0,0,0,,Және олардың ешқайсысы да жоқ
Dialogue: 0,0:11:53.32,0:11:57.49,Default,,0,0,0,,Менің сезімім менің бақылауымнан тыс.
Dialogue: 0,0:11:53.32,0:11:57.49,Default,,0,0,0,,Саған деген сезімімнен асатын ештеңені елестете алмаймын.
Dialogue: 0,0:11:59.79,0:12:05.04,Default,,0,0,0,,Маған зиян тигізетін адам, Тәнімнің, ойымның, жанымның бейнесі.
Dialogue: 0,0:11:59.79,0:12:05.04,Default,,0,0,0,,Мен сен сияқты жаны да, тәні де сұлу адамдардан қорқамын.
Dialogue: 0,0:12:07.68,0:12:13.25,Default,,0,0,0,,Көп уақыттың ортасында болғанымнан бері көп уақыт өтті.
Dialogue: 0,0:12:07.68,0:12:13.25,Default,,0,0,0,,Мен сол күні Авашима Ревю спектаклін көрмеуім керек еді.
Dialogue: 0,0:12:14.13,0:12:18.64,Default,,0,0,0,,Мен әлі көрмеген арманымды жүзеге асыру маңызды.
Dialogue: 0,0:12:14.13,0:12:18.64,Default,,0,0,0,,Мен мұндай қисынсыз армандарды көрмеуім керек еді.
Dialogue: 0,0:12:20.39,0:12:23.89,Default,,0,0,0,,Бір уақытта өмір сүру
Dialogue: 0,0:12:20.39,0:12:23.89,Default,,0,0,0,,Мен сенімен бір заманда өмір сүргенім үшін өзімді қарғаймын.
Dialogue: 0,0:12:25.27,0:12:30.18,Default,,0,0,0,,Сіз өзіңіздің жеке өміріңізді қалай білесіз?
Dialogue: 0,0:12:25.27,0:12:30.18,Default,,0,0,0,,Осы өзімшіл өмірлер жойылса екен деп тілеймін.
Dialogue: 0,0:12:30.18,0:12:32.77,Default,,0,0,0,,Осы кезде мен ақыры төмен түсуді шештім.
Dialogue: 0,0:12:30.18,0:12:32.77,Default,,0,0,0,,Мен ақыры шешім қабылдадым.
Dialogue: 0,0:12:37.75,0:12:40.66,Default,,0,0,0,,Әуелде сұлуға бір жақты қарадым.
Dialogue: 0,0:12:37.75,0:12:40.66,Default,,0,0,0,,Мен Эми-чанға баруым керек еді.
Dialogue: 0,0:12:41.69,0:12:43.94,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:12:41.69,0:12:43.94,Default,,0,0,0,,Біз қашан бардық?
Dialogue: 0,0:12:43.94,0:12:47.04,Default,,0,0,0,,Кейбір өзгертулер енгізілмеуі мүмкін.
Dialogue: 0,0:12:43.94,0:12:47.04,Default,,0,0,0,,Мүмкін ештеңе өзгермес еді.
Dialogue: 0,0:12:49.75,0:12:53.00,Default,,0,0,0,,Әйтсе де, сол кезде мен оны көрудің сұлулығына сіңіп кеттім
Dialogue: 0,0:12:49.75,0:12:53.00,Default,,0,0,0,,Көңілсіз Эмиге қарап тұра алмадым.
Dialogue: 0,0:12:53.00,0:12:55.21,Default,,0,0,0,,Осының арқасында сіз картаны көре аласыз
Dialogue: 0,0:12:53.00,0:12:55.21,Default,,0,0,0,,Неге әуре?
Dialogue: 0,0:12:56.16,0:12:58.44,Default,,0,0,0,,Белгісіз жол болғандықтан
Dialogue: 0,0:12:56.16,0:12:58.44,Default,,0,0,0,,Мен не айтарымды білмеймін
Dialogue: 0,0:12:58.44,0:13:02.68,Default,,0,0,0,,Ақырзаманға дейін
Dialogue: 0,0:12:58.44,0:13:02.68,Default,,0,0,0,,Эми-чан өте керемет болды.
Dialogue: 0,0:13:04.39,0:13:09.69,Default,,0,0,0,,Бір адамға қарасам, адасып кетем.
Dialogue: 0,0:13:04.39,0:13:09.69,Default,,0,0,0,,Біз бұл жағдайдан шыққан Эми-чанмен кездескіміз келмеді.
Dialogue: 0,0:13:15.27,0:13:19.07,Default,,0,0,0,,Онода Онода, №301 аурухана
Dialogue: 0,0:13:15.27,0:13:19.07,Default,,0,0,0,,Онода мырза 301-бөлмеде болар еді.
Dialogue: 0,0:13:32.63,0:13:34.00,Default,,0,0,0,,Қандай шындық?
Dialogue: 0,0:13:32.63,0:13:34.00,Default,,0,0,0,,Сен ақымақсың.
Dialogue: 0,0:13:36.34,0:13:39.13,Default,,0,0,0,,Оны қабылдаңыз
Dialogue: 0,0:13:36.34,0:13:39.13,Default,,0,0,0,,Сізді таң қалдырғаны үшін кешіріңіз.
Dialogue: 0,0:13:39.13,0:13:41.51,Default,,0,0,0,,Дегенмен, бұл менің шынайылығым.
Dialogue: 0,0:13:39.13,0:13:41.51,Default,,0,0,0,,Бірақ бұл шындық.
Dialogue: 0,0:13:42.76,0:13:45.31,Default,,0,0,0,,Сен өлгеннен бері мен өлдім
Dialogue: 0,0:13:42.76,0:13:45.31,Default,,0,0,0,,Мен шынымен де өлдім деп ойладым.
Dialogue: 0,0:13:45.31,0:13:46.61,Default,,0,0,0,,өлім
Dialogue: 0,0:13:45.31,0:13:46.61,Default,,0,0,0,,Мен өлемін
Dialogue: 0,0:13:46.61,0:13:47.97,Default,,0,0,0,,Сәтті аяқтау
Dialogue: 0,0:13:46.61,0:13:47.97,Default,,0,0,0,,Жақында
Dialogue: 0,0:13:50.31,0:13:54.48,Default,,0,0,0,,Соңғы рет қайта көрдім, аяқтадым.
Dialogue: 0,0:13:50.31,0:13:54.48,Default,,0,0,0,,Соңында Эмидің келгеніне қуаныштымын.
Dialogue: 0,0:13:54.98,0:13:56.61,Default,,0,0,0,,Сізге өлу керек.
Dialogue: 0,0:13:54.98,0:13:56.61,Default,,0,0,0,,Өлсең мен сені кешірмеймін
Dialogue: 0,0:13:58.01,0:14:00.24,Default,,0,0,0,,Менің кім екенімді кім біледі?
Dialogue: 0,0:13:58.01,0:14:00.24,Default,,0,0,0,,Кешірілмейтін әрекеттер жасағандар
Dialogue: 0,0:14:04.49,0:14:07.26,Default,,0,0,0,,Өкінішке орай менің сөйлеуге мүмкіндігім жоқ.
Dialogue: 0,0:14:04.49,0:14:07.26,Default,,0,0,0,,Бұл мен айта алатын нәрсе емес.
Dialogue: 0,0:14:07.26,0:14:09.66,Default,,0,0,0,,Алайда өмірде бәрі дұрыс емес.
Dialogue: 0,0:14:07.26,0:14:09.66,Default,,0,0,0,,Өйткені Авашима бәрі емес
Dialogue: 0,0:14:11.25,0:14:15.25,Default,,0,0,0,,Орындай алатындарыңызға сенемін.
Dialogue: 0,0:14:11.25,0:14:15.25,Default,,0,0,0,,Актриса болуды мақсат еткеніңізді қалаймын...
Dialogue: 0,0:14:18.88,0:14:20.88,Default,,0,0,0,,Мен өзімді қалай қоямын
Dialogue: 0,0:14:18.88,0:14:20.88,Default,,0,0,0,,Мені не қуды
Dialogue: 0,0:14:21.30,0:14:24.55,Default,,0,0,0,,Кейко Ибуки - Юки Онода
Dialogue: 0,0:14:21.30,0:14:24.55,Default,,0,0,0,,Кейко Ибуки даши Юкие Онода даши
Dialogue: 0,0:14:24.55,0:14:26.18,Default,,0,0,0,,Мен қандаймын?
Dialogue: 0,0:14:24.55,0:14:26.18,Default,,0,0,0,,Өзім
Dialogue: 0,0:14:30.35,0:14:34.44,Default,,0,0,0,,Менің капиталым жоқ.
Dialogue: 0,0:14:30.35,0:14:34.44,Default,,0,0,0,,Біз сылтау іздедік.
Dialogue: 0,0:14:34.44,0:14:38.02,Default,,0,0,0,,Басқаларға бақытсыз болу
Dialogue: 0,0:14:34.44,0:14:38.02,Default,,0,0,0,,Бақытты бола алмасаң, біреу кінәлі
Dialogue: 0,0:14:40.88,0:14:43.07,Default,,0,0,0,,Танымал әндер мен өлеңдер жинағы
Dialogue: 0,0:14:40.88,0:14:43.07,Default,,0,0,0,,Бұл танымал ән сияқты.
Dialogue: 0,0:14:45.87,0:14:49.89,Default,,0,0,0,,Осыны маған айт.
Dialogue: 0,0:14:45.87,0:14:49.89,Default,,0,0,0,,Сол үшін мен сендерді кешірмеймін.
Dialogue: 0,0:14:49.89,0:14:52.50,Default,,0,0,0,,Сарафукайхара Кагоме
Dialogue: 0,0:14:49.89,0:14:52.50,Default,,0,0,0,,Мен өзімді кешірмеймін
Dialogue: 0,0:14:53.21,0:14:55.04,Default,,0,0,0,,Мен сізге болмашы бірдеңені айтайын деп отырмын.
Dialogue: 0,0:14:53.21,0:14:55.04,Default,,0,0,0,,Соны айтайын деп келдім.
Dialogue: 0,0:15:00.17,0:15:03.05,Default,,0,0,0,,Сіз табиғатыңыздан мінсіз адамсыз.
Dialogue: 0,0:15:00.17,0:15:03.05,Default,,0,0,0,,Сіз бәрібір керемет адамсыз.
Dialogue: 0,0:15:06.05,0:15:08.35,Default,,0,0,0,,Бұл менің алғашқы махаббатым
Dialogue: 0,0:15:06.05,0:15:08.35,Default,,0,0,0,,Бұл менің алғашқы махаббатым еді
Dialogue: 0,0:15:11.36,0:15:12.02,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:15:11.36,0:15:12.02,Default,,0,0,0,,Аралау
Dialogue: 0,0:15:12.02,0:15:14.64,Default,,0,0,0,,...
Dialogue: 0,0:15:12.02,0:15:14.64,Default,,0,0,0,,Мен өте әдемі қызды көрдім
Dialogue: 0,0:15:14.64,0:15:18.31,Default,,0,0,0,,Келесі дауыс бірінші көтеріледі.
Dialogue: 0,0:15:14.64,0:15:18.31,Default,,0,0,0,,Келесі жолы вокалдық музыка бойынша бір сыныпта боламыз, мен сізге міндетті түрде қоңырау шаламын.
Dialogue: 0,0:15:18.31,0:15:20.03,Default,,0,0,0,,Әділетсіз Гайя Канаме
Dialogue: 0,0:15:18.31,0:15:20.03,Default,,0,0,0,,Мені де алдау
Dialogue: 0,0:15:35.54,0:15:37.79,Default,,0,0,0,,Кейко Ибуки айқайлап жатыр
Dialogue: 0,0:15:35.54,0:15:37.79,Default,,0,0,0,,Менің атым Кейко Ибуки.
Dialogue: 0,0:15:37.79,0:15:42.42,Default,,0,0,0,,Сіз аралық қабырғаға келгенде
Dialogue: 0,0:15:37.79,0:15:42.42,Default,,0,0,0,,Сіз жатақхананың келесі бөлмесінде боласыз, сондықтан сұрақтарыңыз болса, маған хабарласыңыз.
Dialogue: 0,0:15:47.55,0:15:48.72,Default,,0,0,0,,Әр адамның ешкімге көрсетпейтін бір жағы бар
Dialogue: 0,0:15:47.55,0:15:48.72,Default,,0,0,0,,Рахмет
Dialogue: 0,0:15:53.82,0:15:56.27,Default,,0,0,0,,Шындық мінсіз
Dialogue: 0,0:15:53.82,0:15:56.27,Default,,0,0,0,,Кемел адамдар бар ма?
Dialogue: 0,0:15:56.27,0:15:57.79,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:15:56.27,0:15:57.79,Default,,0,0,0,,Рас
Dialogue: 0,0:15:58.69,0:16:02.44,Default,,0,0,0,,Келесі бірлескен оқу
Dialogue: 0,0:15:58.69,0:16:02.44,Default,,0,0,0,,Окабе мырза келесі бірлескен сыныпта басты болып келетін сияқты.
Dialogue: 0,0:16:04.10,0:16:07.28,Default,,0,0,0,,Дегенмен, орындау Онода Догаку.
Dialogue: 0,0:16:04.10,0:16:07.28,Default,,0,0,0,,Бірақ келіңіз, менің серіктесім Онода мырза.
Dialogue: 0,0:16:07.28,0:16:08.16,Default,,0,0,0,,Эйкикай
Dialogue: 0,0:16:07.28,0:16:08.16,Default,,0,0,0,,Жоқ
Dialogue: 0,0:16:08.62,0:16:10.78,Default,,0,0,0,,Сіз туралы тағы бір оқиға
Dialogue: 0,0:16:08.62,0:16:10.78,Default,,0,0,0,,Тек тоқтатыңыз.
Dialogue: 0,0:16:11.12,0:16:13.54,Default,,0,0,0,,Мұны айту мүмкін емес, бірақ Онода қол жетімді емес.
Dialogue: 0,0:16:11.12,0:16:13.54,Default,,0,0,0,,Мен мұны айтпауым керек, бірақ бұл пропорционалды емес.
Dialogue: 0,0:16:13.54,0:16:14.41,Default,,0,0,0,,Мен де көремін
Dialogue: 0,0:16:13.54,0:16:14.41,Default,,0,0,0,,Эй
Dialogue: 0,0:16:17.94,0:16:20.42,Default,,0,0,0,,Оноданың презентациясына назар аударыңыз
Dialogue: 0,0:16:17.94,0:16:20.42,Default,,0,0,0,,Мен Онода-санның өнерін ешқашан көрген емеспін.
Dialogue: 0,0:16:22.88,0:16:25.55,Default,,0,0,0,,...
Dialogue: 0,0:16:22.88,0:16:25.55,Default,,0,0,0,,Сіздердің кез келгеніңізден жақсырақ
Dialogue: 0,0:16:50.32,0:16:51.53,Default,,0,0,0,,Кездескенше
Dialogue: 0,0:16:50.32,0:16:51.53,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:16:51.53,0:16:53.91,Default,,0,0,0,,Қабылданбайтын аурухана тұрғындары
Dialogue: 0,0:16:51.53,0:16:53.91,Default,,0,0,0,,Сіз ауруханада жүгіре алмайсыз, солай ма?
Dialogue: 0,0:16:53.91,0:16:55.58,Default,,0,0,0,,Жағымсыз ниеттер
Dialogue: 0,0:16:53.91,0:16:55.58,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:55.58,0:16:57.16,Default,,0,0,0,,...
Dialogue: 0,0:16:55.58,0:16:57.16,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:57.41,0:16:59.17,Default,,0,0,0,,Кешір мені.
Dialogue: 0,0:16:57.41,0:16:59.17,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:17:00.63,0:17:02.63,Default,,0,0,0,,Ұзын және жақсы бейне шағын ләззат
Dialogue: 0,0:17:00.63,0:17:02.63,Default,,0,0,0,,Экчанға ұқсайды
Dialogue: 0,0:17:03.14,0:17:07.38,Default,,0,0,0,,Тога университеті
Dialogue: 0,0:17:03.14,0:17:07.38,Default,,0,0,0,,Егер сіз университетке түссеңіз, міндетті түрде баруыңыз керек.
Dialogue: 0,0:17:09.86,0:17:11.89,Default,,0,0,0,,Аз ләззат пен сәттілік
Dialogue: 0,0:17:09.86,0:17:11.89,Default,,0,0,0,,Экчан, қалыңыз қалай?
Dialogue: 0,0:17:16.48,0:17:19.02,Default,,0,0,0,,Менің қабілетсіздігім туралы сөздер
Dialogue: 0,0:17:16.48,0:17:19.02,Default,,0,0,0,,Уәдеде тұра алмадым.
Dialogue: 0,0:17:19.89,0:17:21.65,Default,,0,0,0,,Кешір мені.
Dialogue: 0,0:17:19.89,0:17:21.65,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:17:32.62,0:17:34.16,Default,,0,0,0,,Жылтыратылған бала
Dialogue: 0,0:17:32.62,0:17:34.16,Default,,0,0,0,,Сәлем, сегізаяқ
Dialogue: 0,0:17:36.54,0:17:37.50,Default,,0,0,0,,Әрине, бөлек.
Dialogue: 0,0:17:36.54,0:17:37.50,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:17:38.59,0:17:42.75,Default,,0,0,0,,Талантты адамның қоғамдық көлік жолағында бір сұлу әйел жылап тұр.
Dialogue: 0,0:17:38.59,0:17:42.75,Default,,0,0,0,,Автобуста сүйкімді әйел жылап отырды.
Dialogue: 0,0:17:47.30,0:17:49.76,Default,,0,0,0,,Телефон ұстаған кемпір
Dialogue: 0,0:17:47.30,0:17:49.76,Default,,0,0,0,,Качан телефоны
Dialogue: 0,0:17:49.76,0:17:51.38,Default,,0,0,0,,Қолайсыз Аспан астанасы Қара Рио
Dialogue: 0,0:17:49.76,0:17:51.38,Default,,0,0,0,,Жоқ, сыртта тас қараңғы.
Dialogue: 0,0:17:52.18,0:17:53.14,Default,,0,0,0,,Кімнің телефоны?
Dialogue: 0,0:17:52.18,0:17:53.14,Default,,0,0,0,,Кім?
Dialogue: 0,0:17:53.14,0:17:55.01,Default,,0,0,0,,Такехара қайын атасы
Dialogue: 0,0:17:53.14,0:17:55.01,Default,,0,0,0,,Такехараның тәтесі
Dialogue: 0,0:17:55.39,0:17:57.86,Default,,0,0,0,,...
Dialogue: 0,0:17:55.39,0:17:57.86,Default,,0,0,0,,О, не болып жатыр?
Dialogue: 0,0:17:57.86,0:18:01.06,Default,,0,0,0,,Алды-артына кетсең де
Dialogue: 0,0:17:57.86,0:18:01.06,Default,,0,0,0,,Мұнда анда-санда оралыңыз.
Dialogue: 0,0:18:02.56,0:18:04.77,Default,,0,0,0,,Ескерту: жапон тілінде «емтиханға өтініш беру» мен «өлім» сөздері бірдей айтылады
Dialogue: 0,0:18:02.56,0:18:04.77,Default,,0,0,0,,Не?
Dialogue: 0,0:18:04.77,0:18:07.44,Default,,0,0,0,,Бұл кішкентай бұтақ па?
Dialogue: 0,0:18:04.77,0:18:07.44,Default,,0,0,0,,Кинуэ-чан Кинуэ-чан ма?
Dialogue: 0,0:18:08.53,0:18:10.03,Default,,0,0,0,,Шынайы оқиға
Dialogue: 0,0:18:08.53,0:18:10.03,Default,,0,0,0,,Усоо
Dialogue: 0,0:18:10.03,0:18:12.03,Default,,0,0,0,,Бұл тұр ма?
Dialogue: 0,0:18:10.03,0:18:12.03,Default,,0,0,0,,Авашиманы алу дегенді қалай түсінесіңдер?
Dialogue: 0,0:18:12.41,0:18:14.57,Default,,0,0,0,,Бұлай айту керек.
Dialogue: 0,0:18:12.41,0:18:14.57,Default,,0,0,0,,Бұл да өте керемет
Dialogue: 0,0:18:14.57,0:18:19.54,Default,,0,0,0,,...
Dialogue: 0,0:18:14.57,0:18:19.54,Default,,0,0,0,,Қараңдаршы, менің балам алғашында қыздар мектебіне барамын деп қуанған.
Dialogue: 0,0:18:19.54,0:18:22.33,Default,,0,0,0,,Қойылымдар мектебіне келгенде, сіз өлтіресіз.
Dialogue: 0,0:18:19.54,0:18:22.33,Default,,0,0,0,,Сахналық өнер мектебі туралы не ойлайсыз?
Dialogue: 0,0:18:22.33,0:18:24.04,Default,,0,0,0,,Басқа сөздер
Dialogue: 0,0:18:22.33,0:18:24.04,Default,,0,0,0,,Сіз не айтасыз?
Dialogue: 0,0:18:24.50,0:18:26.67,Default,,0,0,0,,Маған не болды?
Dialogue: 0,0:18:24.50,0:18:26.67,Default,,0,0,0,,Егер солай болса, маған қалдырыңыз.
Dialogue: 0,0:18:26.67,0:18:29.05,Default,,0,0,0,,Кішкене қолдау
Dialogue: 0,0:18:26.67,0:18:29.05,Default,,0,0,0,,Қолдау отын қалауыңызша қамтамасыз етіңіз.
Dialogue: 0,0:18:29.30,0:18:32.30,Default,,0,0,0,,Шәкіртімнің осалдығы, 100 адамға қыр көрсету қабілетім
Dialogue: 0,0:18:29.30,0:18:32.30,Default,,0,0,0,,Ініңіздің жүз кемшілігін білуіңіз керек.
Dialogue: 0,0:18:35.12,0:18:37.60,Default,,0,0,0,,Бұтақтарға қосылуға болатын уақытты қараңыз.
Dialogue: 0,0:18:35.12,0:18:37.60,Default,,0,0,0,,Бір күні Кинумен сөйлесіңізші.
Dialogue: 0,0:18:40.48,0:18:46.44,Default,,0,0,0,,Поэзия мектебінің әсем әңгімесі
Dialogue: 0,0:18:40.48,0:18:46.44,Default,,0,0,0,,Эми-чанның опера мектебіне барғысы келетіні сөзсіз еді.
Dialogue: 0,0:18:52.00,0:18:53.78,Default,,0,0,0,,...
Dialogue: 0,0:18:52.00,0:18:53.78,Default,,0,0,0,,Рахмет, апай
Dialogue: 0,0:18:54.57,0:18:57.88,Default,,0,0,0,,Ескі әңгіме
Dialogue: 0,0:18:54.57,0:18:57.88,Default,,0,0,0,,Шынымды айтсам, шамалы.
Dialogue: 0,0:18:57.88,0:18:59.88,Default,,0,0,0,,Кайо Катэйдо Корё
Dialogue: 0,0:18:57.88,0:18:59.88,Default,,0,0,0,,Мен бұзылуға жақын болдым
Dialogue: 0,0:19:02.58,0:19:05.08,Default,,0,0,0,,Көп уақыттың ортасында болғанымнан бері ұзақ уақыт болды.
Dialogue: 0,0:19:02.58,0:19:05.08,Default,,0,0,0,,Апайдың арқасында өзімді жақсы сезінемін.
Dialogue: 0,0:19:05.46,0:19:07.84,Default,,0,0,0,,Қазіргі уақытта қолданылуда
Dialogue: 0,0:19:05.46,0:19:07.84,Default,,0,0,0,,Осындай жерде жүрегім сыздаса
Dialogue: 0,0:19:07.84,0:19:09.96,Default,,0,0,0,,Осыдан кейін сіз мұны істей аласыз.
Dialogue: 0,0:19:07.84,0:19:09.96,Default,,0,0,0,,Енді не істейсіз?
Dialogue: 0,0:19:11.43,0:19:14.22,Default,,0,0,0,,Қазіргі уақытта күш салуды бастау уақыты келді.
Dialogue: 0,0:19:11.43,0:19:14.22,Default,,0,0,0,,Бұдан былай көп жұмыс істеуге тура келеді.
Dialogue: 0,0:19:22.22,0:19:24.98,Default,,0,0,0,,Шығыс пен Батыстан қалай тұрып, қалай кететінін айтып отырмын.
Dialogue: 0,0:19:22.22,0:19:24.98,Default,,0,0,0,,Ей, келесіде бәріміз бірге дүкен аралайық.
Dialogue: 0,0:19:24.98,0:19:26.27,Default,,0,0,0,,Бұл не өзі?
Dialogue: 0,0:19:24.98,0:19:26.27,Default,,0,0,0,,Зұлым орыннан қозғалмайды!
Dialogue: 0,0:19:27.17,0:19:31.66,Default,,0,0,0,,Дегенмен, сіз оны алуға болатын жерге өтініш беруіңіз керек.
Dialogue: 0,0:19:27.17,0:19:31.66,Default,,0,0,0,,Бірақ сіз саяхатқа рұқсат алу үшін өтініш беруіңіз керек.
Dialogue: 0,0:19:31.66,0:19:33.28,Default,,0,0,0,,Жақсы үйеңкі
Dialogue: 0,0:19:31.66,0:19:33.28,Default,,0,0,0,,Е, қиын
Dialogue: 0,0:19:33.28,0:19:35.88,Default,,0,0,0,,Бұл жай ғана Мапо туралы әңгіме.
Dialogue: 0,0:19:33.28,0:19:35.88,Default,,0,0,0,,Бір әурешілік болса, жарайды.
Dialogue: 0,0:19:35.88,0:19:38.53,Default,,0,0,0,,«Нұсқаушы» ұстанымына баса назар аударылады.
Dialogue: 0,0:19:35.88,0:19:38.53,Default,,0,0,0,,Екінші тарап «нұсқаушы» болғандықтан
Dialogue: 0,0:19:39.20,0:19:41.54,Default,,0,0,0,,Қайырлы кеш сұхбаты
Dialogue: 0,0:19:39.20,0:19:41.54,Default,,0,0,0,,Мен өзімді ауыр сезінемін.
Dialogue: 0,0:19:42.08,0:19:45.54,Default,,0,0,0,,Қайшы тас басы...
Dialogue: 0,0:19:42.08,0:19:45.54,Default,,0,0,0,,Алдымен тас-қағаз-қайшы...
Dialogue: 0,0:19:46.15,0:19:48.75,Default,,0,0,0,,Бұл менің өмірден айырылған кезім.
Dialogue: 0,0:19:46.15,0:19:48.75,Default,,0,0,0,,Мен мұндай жағдайда ешқашан жеңілмеймін.
Dialogue: 0,0:19:48.75,0:19:50.04,Default,,0,0,0,,Мен де
Dialogue: 0,0:19:48.75,0:19:50.04,Default,,0,0,0,,Мен де
Dialogue: 0,0:19:50.04,0:19:51.92,Default,,0,0,0,,Пошта бөлімшесі
Dialogue: 0,0:19:50.04,0:19:51.92,Default,,0,0,0,,Не болды?
Dialogue: 0,0:19:52.30,0:19:53.76,Default,,0,0,0,,Дугаку Мураками?
Dialogue: 0,0:19:52.30,0:19:53.76,Default,,0,0,0,,Мураками мырза?
Dialogue: 0,0:19:53.76,0:19:55.17,Default,,0,0,0,,Мен
Dialogue: 0,0:19:53.76,0:19:55.17,Default,,0,0,0,,Иә
Dialogue: 0,0:19:55.77,0:19:57.74,Default,,0,0,0,,Жаңа алмасуды аяқтадыңыз.
Dialogue: 0,0:19:55.77,0:19:57.74,Default,,0,0,0,,Тапсырмаңызды қайта жібердіңіз бе?
Dialogue: 0,0:19:57.74,0:19:59.62,Default,,0,0,0,,Қолайсыз Мен ұмытып қалдым
Dialogue: 0,0:19:57.74,0:19:59.62,Default,,0,0,0,,А, мен ұмытып қалдым.
Dialogue: 0,0:19:59.62,0:20:02.93,Default,,0,0,0,,Шындық мынада, біз бес нүктеге жеттік.
Dialogue: 0,0:19:59.62,0:20:02.93,Default,,0,0,0,,Мен кешкі сағат 17:00-ге дейін күтемін, тезірек әкеліңізші.
Dialogue: 0,0:20:04.18,0:20:05.19,Default,,0,0,0,,тақырып
Dialogue: 0,0:20:04.18,0:20:05.19,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:20:05.81,0:20:08.94,Default,,0,0,0,,Менің сыйлығым – ``аты''.
Dialogue: 0,0:20:05.81,0:20:08.94,Default,,0,0,0,,«Е» осында, Момочиннің ақымақ.
Dialogue: 0,0:20:12.35,0:20:15.07,Default,,0,0,0,,Ибуки Роши Маярина №.
Dialogue: 0,0:20:12.35,0:20:15.07,Default,,0,0,0,,Ибуки-сенсэй шынымен де қорқынышты ма?
Dialogue: 0,0:20:15.45,0:20:20.33,Default,,0,0,0,,Қандай жағдай болмасын, жын нұсқаушы болғаны дұрыс.
Dialogue: 0,0:20:15.45,0:20:20.33,Default,,0,0,0,,Бұл қорқынышты, дәлірек айтқанда, ол жын нұсқаушы сияқты.
Dialogue: 0,0:20:21.07,0:20:23.75,Default,,0,0,0,,Белгілі бір позициядан өткеннен кейін
Dialogue: 0,0:20:21.07,0:20:23.75,Default,,0,0,0,,Өйткені менің үлкендерімнің бірі осылай деді
Dialogue: 0,0:20:23.75,0:20:27.21,Default,,0,0,0,,Жалға берушінің «жын» және «нұсқаушы» ретінде жұмыс істеуі
Dialogue: 0,0:20:23.75,0:20:27.21,Default,,0,0,0,,«Нұсқаушы» «они» дегеннен кейін лақап атқа айналды.
Dialogue: 0,0:20:27.75,0:20:30.08,Default,,0,0,0,,Кету туралы өтініш
Dialogue: 0,0:20:27.75,0:20:30.08,Default,,0,0,0,,Сыртқа шығуға рұқсат.
Dialogue: 0,0:20:30.08,0:20:31.34,Default,,0,0,0,,Сіз кеткіңіз келе ме?
Dialogue: 0,0:20:30.08,0:20:31.34,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:20:31.34,0:20:34.07,Default,,0,0,0,,Йорокогучи негізгі көшесі, сауда көшесі
Dialogue: 0,0:20:31.34,0:20:34.07,Default,,0,0,0,,Иә Минато-дори сауда көшесі және
Dialogue: 0,0:20:34.07,0:20:36.49,Default,,0,0,0,,Менің есіме түспегеніне көп болды.
Dialogue: 0,0:20:34.07,0:20:36.49,Default,,0,0,0,,Біраз уақыт теңізге шығайық.
Dialogue: 0,0:20:36.49,0:20:39.41,Default,,0,0,0,,Бұл қауіпті мәселе.
Dialogue: 0,0:20:36.49,0:20:39.41,Default,,0,0,0,,Бұл шынымен де. Мен қауіпті ештеңе істемеймін.
Dialogue: 0,0:20:39.41,0:20:42.10,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймын.
Dialogue: 0,0:20:39.41,0:20:42.10,Default,,0,0,0,,Мен ештеңе айтқан жоқпын.
Dialogue: 0,0:20:42.10,0:20:44.97,Default,,0,0,0,,Адекватты емес, ұялшақ және тривиальды.
Dialogue: 0,0:20:42.10,0:20:44.97,Default,,0,0,0,,Ойлы болу маңызды.
Dialogue: 0,0:20:45.60,0:20:49.10,Default,,0,0,0,,Сақтық және қауіпсіздік Қақпада тыйым салынған уақытты ескеріңіз
Dialogue: 0,0:20:45.60,0:20:49.10,Default,,0,0,0,,Абайлаңыз және коменданттық сағатқа дейін кетіңіз.
Dialogue: 0,0:20:49.90,0:20:53.73,Default,,0,0,0,,Мейірімді қарт шебер
Dialogue: 0,0:20:49.90,0:20:53.73,Default,,0,0,0,,Иә, рақмет.
Dialogue: 0,0:20:54.40,0:20:56.49,Default,,0,0,0,,Қарт қайта қарады
Dialogue: 0,0:20:54.40,0:20:56.49,Default,,0,0,0,,Уф! Босат! Мені босат!
Dialogue: 0,0:20:57.36,0:20:58.70,Default,,0,0,0,,Мен саған мүмкіндік беремін. Таңдауға екі жол бар.
Dialogue: 0,0:20:57.36,0:20:58.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:00.16,0:21:03.41,Default,,0,0,0,,...
Dialogue: 0,0:21:00.16,0:21:03.41,Default,,0,0,0,,Ол аса қорқынышты мұғалім емес еді.
Dialogue: 0,0:21:05.70,0:21:06.75,Default,,0,0,0,,Қолдаусыз
Dialogue: 0,0:21:05.70,0:21:06.75,Default,,0,0,0,,Бүгін тағы да керемет жұмыс істеп жатырсың… Ау!
Dialogue: 0,0:21:07.25,0:21:11.38,Default,,0,0,0,,Әйелім қайтыс болғанда, Ибуки Рошидің сүйікті әңгімесі
Dialogue: 0,0:21:07.25,0:21:11.38,Default,,0,0,0,,Анамнан көп жақсы сөз естіген емеспін.
Dialogue: 0,0:21:12.38,0:21:14.88,Default,,0,0,0,,...
Dialogue: 0,0:21:12.38,0:21:14.88,Default,,0,0,0,,А, Вака-чан білмей ме?
Dialogue: 0,0:21:14.88,0:21:18.88,Default,,0,0,0,,Сяозэнің ісі
Dialogue: 0,0:21:14.88,0:21:18.88,Default,,0,0,0,,Зава-чанның анасы да Авашимадан.
Dialogue: 0,0:21:18.88,0:21:21.01,Default,,0,0,0,,Endo no kami7 мүмкін емес...
Dialogue: 0,0:21:18.88,0:21:21.01,Default,,0,0,0,,Мен Ибуки Сэнсимен бір кезеңненмін.
Dialogue: 0,0:21:21.01,0:21:22.39,Default,,0,0,0,,және интернатта тұратын оқушылар мен күндізгі бөлімде оқитындар арасында шиеленіс бар.
Dialogue: 0,0:21:21.01,0:21:22.39,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:21:22.39,0:21:23.85,Default,,0,0,0,,Неке куәлігі: Ллойд Фогель, Джоэл Фогель
Dialogue: 0,0:21:22.39,0:21:23.85,Default,,0,0,0,,Мүлде
Dialogue: 0,0:21:23.85,0:21:26.90,Default,,0,0,0,,Юичи тікелей сөйлеуді өздігінен жалғыз орындау
Dialogue: 0,0:21:23.85,0:21:26.90,Default,,0,0,0,,Ол кішкентай рөлдерді ғана алатынын айтты.
Dialogue: 0,0:21:26.90,0:21:29.08,Default,,0,0,0,,...
Dialogue: 0,0:21:26.90,0:21:29.08,Default,,0,0,0,,Өтірік Бұл керемет.
Dialogue: 0,0:21:29.08,0:21:31.14,Default,,0,0,0,,Сіз орындаушысыз.
Dialogue: 0,0:21:29.08,0:21:31.14,Default,,0,0,0,,Өйткені бұл ата-ана мен баланың екі ұрпағы.
Dialogue: 0,0:21:31.14,0:21:33.65,Default,,0,0,0,,Ибуки Роши отбасының үшінші ұрпағы
Dialogue: 0,0:21:31.14,0:21:33.65,Default,,0,0,0,,Ибуки мырзаның үш ұрпағы бар.
Dialogue: 0,0:21:34.69,0:21:37.74,Default,,0,0,0,,Бұл қарттың өзі.
Dialogue: 0,0:21:34.69,0:21:37.74,Default,,0,0,0,,Әже-ана Мұғалім
Dialogue: 0,0:21:39.49,0:21:41.87,Default,,0,0,0,,...
Dialogue: 0,0:21:39.49,0:21:41.87,Default,,0,0,0,,Анам айтады
Dialogue: 0,0:21:41.87,0:21:44.62,Default,,0,0,0,,Бұрын Ибуки Рохо жұмыс істеген
Dialogue: 0,0:21:41.87,0:21:44.62,Default,,0,0,0,,Өйткені, мұғалімдер әрқашан қорқынышты болған.
Dialogue: 0,0:21:44.62,0:21:45.88,Default,,0,0,0,,Гасоязе
Dialogue: 0,0:21:44.62,0:21:45.88,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:21:45.88,0:21:49.12,Default,,0,0,0,,...
Dialogue: 0,0:21:45.88,0:21:49.12,Default,,0,0,0,,Менің анам да оны ұнатпайтынын айтты.
Dialogue: 0,0:21:51.95,0:21:53.13,Default,,0,0,0,,Ю Линг?
Dialogue: 0,0:21:51.95,0:21:53.13,Default,,0,0,0,,Қорқыту?
Dialogue: 0,0:21:54.67,0:21:58.09,Default,,0,0,0,,Эйхао мүсіні - бастың келуі.
Dialogue: 0,0:21:54.67,0:21:58.09,Default,,0,0,0,,жетекшісі сияқты
Dialogue: 0,0:22:04.74,0:22:06.10,Default,,0,0,0,,Сіздің ойларыңыз
Dialogue: 0,0:22:04.74,0:22:06.10,Default,,0,0,0,,Осындай нәрсе
Dialogue: 0,0:22:06.10,0:22:08.60,Default,,0,0,0,,Барлық бағыттар бойынша
Dialogue: 0,0:22:06.10,0:22:08.60,Default,,0,0,0,,Мүмкін сияқты.
Dialogue: 0,0:23:41.52,0:23:47.52,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
