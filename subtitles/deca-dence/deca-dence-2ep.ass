Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:23.06,0:00:25.06,Default,,0,0,0,,Уау...
Dialogue: 0,0:00:25.48,0:00:27.14,Default,,0,0,0,,Гуггггг... Гах...
Dialogue: 0,0:00:27.48,0:00:28.56,Default,,0,0,0,,Уф... (танкер) Көмектесіңізші...
Dialogue: 0,0:00:28.69,0:00:30.27,Default,,0,0,0,,Мен… Бұл… Менің денем…
Dialogue: 0,0:00:30.56,0:00:31.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:31.86,0:00:32.94,Default,,0,0,0,,Бұл ұрыс алаңы
Dialogue: 0,0:00:33.07,0:00:33.82,Default,,0,0,0,,Әй!
Dialogue: 0,0:00:33.94,0:00:36.57,Default,,0,0,0,,Сіз жауынгер болғыңыз келетіні туралы ойыңызды өзгерттіңіз бе?
Dialogue: 0,0:00:40.87,0:00:43.03,Default,,0,0,0,,Жарайды, жақсы.
Dialogue: 0,0:00:48.21,0:00:50.46,Default,,0,0,0,,(Сөмке дыбысы)
Dialogue: 0,0:00:50.46,0:00:53.38,Default,,0,0,0,,(Сөмке дыбысы)
Dialogue: 0,0:00:50.46,0:00:53.38,Default,,0,0,0,,Бұл тітіркендіргіш. Қайтадан басталды.
Dialogue: 0,0:00:53.92,0:00:58.38,Default,,0,0,0,,Рұқсатсыз ұрыс даласына барып, рұқсатсыз өліп қалсаң, мен сені асырамаймын.
Dialogue: 0,0:00:59.68,0:01:02.89,Default,,0,0,0,,Олар жақсы ұл-қыздар болды.
Dialogue: 0,0:01:03.39,0:01:06.18,Default,,0,0,0,,Ол жақсы күйеу мен әйел болды.
Dialogue: 0,0:01:06.31,0:01:08.89,Default,,0,0,0,,Ол жақсы әке және шеше болды.
Dialogue: 0,0:01:09.44,0:01:10.81,Default,,0,0,0,,Ең бастысы
Dialogue: 0,0:01:10.94,0:01:13.82,Default,,0,0,0,,Олардың бәрі бірдей ержүрек жауынгерлер еді.
Dialogue: 0,0:01:14.32,0:01:17.15,Default,,0,0,0,,Олар мына елсіз әлемде
Dialogue: 0,0:01:17.74,0:01:20.07,Default,,0,0,0,,Сол қызу өмір сүрді
Dialogue: 0,0:01:20.57,0:01:23.70,Default,,0,0,0,,Мен олардың өмір жолын мақтан тұтамын
Dialogue: 0,0:01:23.91,0:01:27.62,Default,,0,0,0,,Жауынгерлеріміздің жаны жәннатта болсын.
Dialogue: 0,0:01:30.12,0:01:31.12,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:31.25,0:01:33.00,Default,,0,0,0,,Дұрыс, ақсақал.
Dialogue: 0,0:01:33.13,0:01:34.88,Default,,0,0,0,,Өздігінен өлме
Dialogue: 0,0:01:35.00,0:01:37.88,Default,,0,0,0,,Ки-иииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииии
Dialogue: 0,0:01:43.05,0:01:44.76,Default,,0,0,0,,Декаданс
Dialogue: 0,0:01:44.97,0:01:48.22,Default,,0,0,0,,Оны сізге Solid Quake әкелді.
Dialogue: 0,0:01:48.35,0:01:52.73,Default,,0,0,0,,Сіз бұрын-соңды болмаған толқуды сезіне алатын үлкен ойын-сауық нысаны
Dialogue: 0,0:01:55.90,0:01:58.07,Default,,0,0,0,,Бұл виртуалды кеңістік емес
Dialogue: 0,0:01:58.94,0:02:01.45,Default,,0,0,0,,Кең байтақ Еуразия материгінде орналасқан
Dialogue: 0,0:02:02.45,0:02:05.62,Default,,0,0,0,,Ойыншы Decadence жылжымалы бекінісіне отырады.
Dialogue: 0,0:02:05.74,0:02:08.16,Default,,0,0,0,,Барлығы шынайы әлемнен ләззат алыңыз
Dialogue: 0,0:02:09.29,0:02:11.25,Default,,0,0,0,,Алдымен ойыншы Gear болады.
Dialogue: 0,0:02:11.37,0:02:12.62,Default,,0,0,0,,Тағайындалған негізгі денеге
Dialogue: 0,0:02:12.75,0:02:15.17,Default,,0,0,0,,Қалауыңызша реттеңіз
Dialogue: 0,0:02:15.75,0:02:18.38,Default,,0,0,0,,Дайын болған кезде достарыңызбен жұмыс жасаңыз
Dialogue: 0,0:02:18.50,0:02:20.67,Default,,0,0,0,,Гадолл аңшылық шытырман оқиғасына аттаныңыз
Dialogue: 0,0:02:20.80,0:02:22.68,Default,,0,0,0,,Міне — жер астында.
Dialogue: 0,0:02:23.55,0:02:25.43,Default,,0,0,0,,Мен өлгенде мұнымен не болады?
Dialogue: 0,0:02:25.89,0:02:27.85,Default,,0,0,0,,Өйткені тісті беріліс денесі тірі дене.
Dialogue: 0,0:02:27.97,0:02:29.93,Default,,0,0,0,,Басынан басынан бастаңыз.
Dialogue: 0,0:02:30.06,0:02:31.56,Default,,0,0,0,,Бұл қиын
Dialogue: 0,0:02:31.81,0:02:34.23,Default,,0,0,0,,Сондықтан да шиеленіс сезімі бар болғандықтан танымал.
Dialogue: 0,0:02:34.35,0:02:36.81,Default,,0,0,0,,Оны да көріңіз, қызық болады
Dialogue: 0,0:02:36.98,0:02:39.61,Default,,0,0,0,,Үнемі өзгеретін салмақсыз шайқас
Dialogue: 0,0:02:39.86,0:02:42.99,Default,,0,0,0,,Тәжірибе жинап, рейтингтің жоғарғы жағына ұмтылыңыз
Dialogue: 0,0:02:43.40,0:02:45.74,Default,,0,0,0,,Қару-жарақ пен сауыттың алуан түрі
Dialogue: 0,0:02:46.20,0:02:49.66,Default,,0,0,0,,Тек беріліс қабатының астында орналасқан цистерналар қаласында
Dialogue: 0,0:02:49.79,0:02:53.62,Default,,0,0,0,,Сіз сондай-ақ жойылып кету қаупі төнген адам танкерлерімен әрекеттесе аласыз
Dialogue: 0,0:02:53.83,0:02:59.38,Default,,0,0,0,,Қанағаттану деңгейі 90% болатын бұрын-соңды болмаған ауқымдағы үлкен шайқас.
Dialogue: 0,0:02:59.50,0:03:01.63,Default,,0,0,0,,Жақыннан дәм татып көріңіз!
Dialogue: 0,0:03:07.97,0:03:12.98,Default,,0,0,0,,♪～
Dialogue: 0,0:04:32.85,0:04:37.85,Default,,0,0,0,,～♪
Dialogue: 0,0:04:50.66,0:04:51.74,Default,,0,0,0,,Үлкен гадолл
Dialogue: 0,0:04:51.87,0:04:53.91,Default,,0,0,0,,Диландтың жойылуы аяқталды
Dialogue: 0,0:04:54.04,0:04:56.87,Default,,0,0,0,,Барлық қызметкерлерге еңбектеріңіз үшін алғыс айтамыз.
Dialogue: 0,0:04:57.25,0:04:59.33,Default,,0,0,0,,Оксонды енгізуді ұмытпаңыз
Dialogue: 0,0:04:59.46,0:05:02.54,Default,,0,0,0,,Компьютеріңізді тиісті түрде қайта іске қосыңыз.
Dialogue: 0,0:05:02.88,0:05:05.13,Default,,0,0,0,,Күніңіз жемісті болсын.
Dialogue: 0,0:05:06.17,0:05:09.05,Default,,0,0,0,,Бәріңе сәлем, Кабураги мырза, еңбегіңіз үшін рахмет.
Dialogue: 0,0:05:09.18,0:05:10.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:10.43,0:05:11.89,Default,,0,0,0,,Мен оны көрдім~
Dialogue: 0,0:05:12.01,0:05:12.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:12.97,0:05:14.93,Default,,0,0,0,,Ұрыс даласын соңғы рет көргеніме көп уақыт болды.
Dialogue: 0,0:05:15.06,0:05:15.89,Default,,0,0,0,,Әй!
Dialogue: 0,0:05:16.72,0:05:18.02,Default,,0,0,0,,Сіз оны монитордан көрдіңіз бе?
Dialogue: 0,0:05:18.14,0:05:20.90,Default,,0,0,0,,Иә, керемет болды!
Dialogue: 0,0:05:21.02,0:05:24.36,Default,,0,0,0,,Топ Ранкер болған кезіңіз есіңізде ме?
Dialogue: 0,0:05:26.65,0:05:28.53,Default,,0,0,0,,Тыңдап тұрсың ба?
Dialogue: 0,0:05:28.74,0:05:31.11,Default,,0,0,0,,Иә? Кабураги-сан?
Dialogue: 0,0:05:31.24,0:05:33.87,Default,,0,0,0,,Сонда Оксонды қоя алмайсың ба?
Dialogue: 0,0:05:34.33,0:05:37.62,Default,,0,0,0,,Не? Бұл біртүрлі
Dialogue: 0,0:05:41.87,0:05:43.00,Default,,0,0,0,,Бір мүйізбен осындай күш.
Dialogue: 0,0:05:43.79,0:05:47.00,Default,,0,0,0,,Мен енді ешқашан майданға бармаймын...
Dialogue: 0,0:05:49.09,0:05:50.17,Default,,0,0,0,,Донателло мырза
Dialogue: 0,0:05:50.30,0:05:52.64,Default,,0,0,0,,Сіз шектеулерді шығару туралы білесіз бе?
Dialogue: 0,0:05:53.34,0:05:54.85,Default,,0,0,0,,Оны кім естіді?
Dialogue: 0,0:05:54.97,0:05:56.89,Default,,0,0,0,,Білмесеңіз, уайымдамаңыз.
Dialogue: 0,0:05:57.22,0:06:00.52,Default,,0,0,0,,Иә? Білсеңіз маған хабарлаңыз
Dialogue: 0,0:06:00.64,0:06:04.02,Default,,0,0,0,,Маған қарашы, оның ақымақ адал адамдарға қатысы жоқ.
Dialogue: 0,0:06:04.15,0:06:05.65,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:06:06.02,0:06:07.69,Default,,0,0,0,,Чира (Түркия) Иә?
Dialogue: 0,0:06:07.82,0:06:08.94,Default,,0,0,0,,Я...
Dialogue: 0,0:06:09.19,0:06:10.78,Default,,0,0,0,,Майки
Dialogue: 0,0:06:10.90,0:06:13.66,Default,,0,0,0,,Сол қол жұлынса не болар еді?
Dialogue: 0,0:06:13.78,0:06:15.28,Default,,0,0,0,,Не? Бұл ауырады
Dialogue: 0,0:06:15.45,0:06:16.53,Default,,0,0,0,,Сәлем Түркия
Dialogue: 0,0:06:16.83,0:06:20.58,Default,,0,0,0,,Жарайды, мен мұны қалай істеу керектігін де білмеймін.
Dialogue: 0,0:06:20.71,0:06:22.79,Default,,0,0,0,,Жарайды, айтыңызшы.
Dialogue: 0,0:06:23.04,0:06:25.04,Default,,0,0,0,,Сен ақымақ
Dialogue: 0,0:06:25.17,0:06:26.04,Default,,0,0,0,,Қалағаныңды істе
Dialogue: 0,0:06:26.63,0:06:28.09,Default,,0,0,0,,Дұрыс айтасыз...
Dialogue: 0,0:06:28.21,0:06:31.92,Default,,0,0,0,,Дененің қолын жұлып алғанда ауру сезімі бар.
Dialogue: 0,0:06:32.05,0:06:34.55,Default,,0,0,0,,Негізгі дененің қолын жұлып алатындай емес.
Dialogue: 0,0:06:34.89,0:06:36.51,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:06:36.64,0:06:39.18,Default,,0,0,0,,Егер олар шынымен зақымдалған болса, оны ешкім жасамас еді.
Dialogue: 0,0:06:39.72,0:06:42.89,Default,,0,0,0,,Шектеуішті босату бұл шектеуді жояды.
Dialogue: 0,0:06:43.02,0:06:45.19,Default,,0,0,0,,Мәселе мынада, сіз шынымен зақымдайсыз.
Dialogue: 0,0:06:45.60,0:06:47.73,Default,,0,0,0,,Не? Бұл қауіпті емес пе?
Dialogue: 0,0:06:47.86,0:06:48.69,Default,,0,0,0,,О
Dialogue: 0,0:06:48.82,0:06:51.24,Default,,0,0,0,,Негізгі корпустың жойылу мүмкіндігі бар.
Dialogue: 0,0:06:51.36,0:06:54.20,Default,,0,0,0,,-мен бір мезгілде элементар денеге қатысты шектеу де жойылады.
Dialogue: 0,0:06:54.32,0:06:57.20,Default,,0,0,0,,Сондықтан сіздің спорттық қабілеттеріңіз артады.
Dialogue: 0,0:06:57.87,0:07:01.08,Default,,0,0,0,,Тәуекелге айырбастау күшінің артуы
Dialogue: 0,0:07:01.41,0:07:03.29,Default,,0,0,0,,Эри-чан маған хат жіберіпті. Қандай ғажап, иә?
Dialogue: 0,0:07:03.41,0:07:05.29,Default,,0,0,0,,Бұл мүмкін бе?
Dialogue: 0,0:07:05.42,0:07:07.08,Default,,0,0,0,,Жоқ, мен мұны істеген жоқпын.
Dialogue: 0,0:07:07.63,0:07:10.17,Default,,0,0,0,,Әй, Кабураги-сан, сенің қимылың сондай өткір.
Dialogue: 0,0:07:10.30,0:07:11.59,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:07:11.71,0:07:15.84,Default,,0,0,0,,Ауырсынуға құмар ойыншы жасаған алдау сияқты.
Dialogue: 0,0:07:16.47,0:07:17.89,Default,,0,0,0,,Осындай нәрсемен араласу
Dialogue: 0,0:07:18.01,0:07:21.27,Default,,0,0,0,,Ақымақ пен жындылар солай істейді, солай ма?
Dialogue: 0,0:07:21.60,0:07:23.02,Default,,0,0,0,,Осымен
Dialogue: 0,0:07:23.27,0:07:24.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:24.98,0:07:25.44,Default,,0,0,0,,Мен сұрамағандай кейіп танытамын.
Dialogue: 0,0:07:25.44,0:07:26.27,Default,,0,0,0,,Мен сұрамағандай кейіп танытамын.
Dialogue: 0,0:07:25.44,0:07:26.27,Default,,0,0,0,,О!
Dialogue: 0,0:07:26.27,0:07:26.73,Default,,0,0,0,,Мен сұрамағандай кейіп танытамын.
Dialogue: 0,0:07:26.85,0:07:27.69,Default,,0,0,0,,Қауіпті әңгіме
Dialogue: 0,0:07:27.81,0:07:29.32,Default,,0,0,0,,Мұны жеке режимде орындаңыз
Dialogue: 0,0:07:29.44,0:07:30.94,Default,,0,0,0,,Жоғарғы дәрежедегілер
Dialogue: 0,0:07:31.36,0:07:34.61,Default,,0,0,0,,Жақында біз келісім нүктесінде боламыз. Бүгінгі қолдауыңыз үшін рахмет.
Dialogue: 0,0:07:34.74,0:07:36.86,Default,,0,0,0,,Донателло-самаға қалдырыңыз!
Dialogue: 0,0:07:37.41,0:07:39.62,Default,,0,0,0,,Біз бүгін тағы да жабайы боламыз!
Dialogue: 0,0:07:39.74,0:07:40.99,Default,,0,0,0,,Дұрыс айтасыңдар, балалар!
Dialogue: 0,0:07:41.33,0:07:42.20,Default,,0,0,0,,Кеттік! (Ер) Иә
Dialogue: 0,0:07:42.33,0:07:43.25,Default,,0,0,0,,Мен жасадым!
Dialogue: 0,0:07:43.66,0:07:46.12,Default,,0,0,0,,Енді кеш уақыты!
Dialogue: 0,0:07:46.25,0:07:47.67,Default,,0,0,0,,Бар, жүр, жүр!
Dialogue: 0,0:07:47.79,0:07:50.13,Default,,0,0,0,,Уууу!
Dialogue: 0,0:07:50.34,0:07:52.67,Default,,0,0,0,,Мынаны есте сақта: негізінен, демонның күші ол жеген адамдар санына байланысты анықталады.
Dialogue: 0,0:08:00.22,0:08:01.06,Default,,0,0,0,,Қалғанын саған қалдырамын.
Dialogue: 0,0:08:02.26,0:08:03.39,Default,,0,0,0,,Хамф!
Dialogue: 0,0:08:04.98,0:08:06.69,Default,,0,0,0,,Керемет!
Dialogue: 0,0:08:23.37,0:08:25.16,Default,,0,0,0,,О...
Dialogue: 0,0:08:25.29,0:08:26.62,Default,,0,0,0,,Шынымен жүректі елжіретеді…
Dialogue: 0,0:08:26.79,0:08:28.83,Default,,0,0,0,,Сәлем Кабураги-сан
Dialogue: 0,0:08:28.96,0:08:31.09,Default,,0,0,0,,Ой! Бұл жоғары сапалы Оксон ба?
Dialogue: 0,0:08:31.21,0:08:32.46,Default,,0,0,0,,Yo Max
Dialogue: 0,0:08:32.59,0:08:34.34,Default,,0,0,0,,Сіз сәулелерге шомылғыңыз келетін сияқтысыз.
Dialogue: 0,0:08:34.46,0:08:37.22,Default,,0,0,0,,Жоғары сатыдағылар ақымақ емес.
Dialogue: 0,0:08:37.34,0:08:38.88,Default,,0,0,0,,Маған бірдеңе сатып аласың ба?
Dialogue: 0,0:08:39.01,0:08:41.68,Default,,0,0,0,,Ха... Басқа амалым жоқ. Маған жазыл.
Dialogue: 0,0:08:41.97,0:08:43.39,Default,,0,0,0,,Жарайсың!
Dialogue: 0,0:08:43.51,0:08:45.89,Default,,0,0,0,,Мен жоғары сапалы Оксонмен де бөліскеніңізді қалаймын.
Dialogue: 0,0:08:46.02,0:08:48.19,Default,,0,0,0,,Бұл мүмкін емес сұрақ.
Dialogue: 0,0:08:48.31,0:08:50.19,Default,,0,0,0,,Ухёхёхёхё...
Dialogue: 0,0:08:50.40,0:08:52.19,Default,,0,0,0,,Ооооо!
Dialogue: 0,0:08:52.44,0:08:55.15,Default,,0,0,0,,Хяхахаха... хахахаха...
Dialogue: 0,0:09:00.70,0:09:02.70,Default,,0,0,0,,Ах Майки
Dialogue: 0,0:09:02.83,0:09:05.87,Default,,0,0,0,,Соңғы кездері рейтингте көтеріліп келе жатқаныңызды айтады.
Dialogue: 0,0:09:06.00,0:09:06.91,Default,,0,0,0,,Маған күшіңді бересің бе?
Dialogue: 0,0:09:07.54,0:09:10.96,Default,,0,0,0,,Жарайды, мен Кабураги мырзадан қалыс қалған жоқпын.
Dialogue: 0,0:09:11.50,0:09:12.96,Default,,0,0,0,,Хо…
Dialogue: 0,0:09:27.89,0:09:29.14,Default,,0,0,0,,Хун
Dialogue: 0,0:10:01.63,0:10:04.01,Default,,0,0,0,,Кешіріңіз, маған уақыт бөліңіз.
Dialogue: 0,0:10:04.30,0:10:06.47,Default,,0,0,0,,Маған бәрібір. Не болды?
Dialogue: 0,0:10:06.60,0:10:10.35,Default,,0,0,0,,Ах... Негізі соңғы кездері рейтингім жақсарған жоқ.
Dialogue: 0,0:10:10.60,0:10:13.31,Default,,0,0,0,,Мен Кабураги мырзадан кеңес сұрағым келеді.
Dialogue: 0,0:10:13.48,0:10:15.11,Default,,0,0,0,,Нашар өсу?
Dialogue: 0,0:10:15.40,0:10:18.40,Default,,0,0,0,,Иә, мен соңғы кездері тоқырауға ұшырадым.
Dialogue: 0,0:10:18.53,0:10:21.11,Default,,0,0,0,,Тіпті бірдеңе жетіспейтінін білемін.
Dialogue: 0,0:10:24.45,0:10:25.91,Default,,0,0,0,,О... не?
Dialogue: 0,0:10:26.70,0:10:28.37,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:10:28.49,0:10:30.83,Default,,0,0,0,,Неге менің орнына Донателлодан сұрамайсың?
Dialogue: 0,0:10:31.33,0:10:32.62,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:32.75,0:10:33.50,Default,,0,0,0,,Не!
Dialogue: 0,0:10:35.33,0:10:36.92,Default,,0,0,0,,Кабураги-сан, солай!
Dialogue: 0,0:10:37.17,0:10:38.25,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:10:38.38,0:10:39.21,Default,,0,0,0,,Сізден бір нәрсе сұрасам…
Dialogue: 0,0:10:39.34,0:10:41.42,Default,,0,0,0,,Сіз шектегішті қалай босату керектігін білесіз!
Dialogue: 0,0:10:41.55,0:10:42.38,Default,,0,0,0,,Алдымен осы жігіт туралы білетіндерімізді реттеп көрейік.
Dialogue: 0,0:10:44.09,0:10:45.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:45.55,0:10:46.64,Default,,0,0,0,,Рахмет
Dialogue: 0,0:10:47.26,0:10:49.89,Default,,0,0,0,,Сіз, сөзсіз, жоғары деңгейлі адамсыз.
Dialogue: 0,0:10:50.02,0:10:51.93,Default,,0,0,0,,Қазіргідей жақсы.
Dialogue: 0,0:10:52.23,0:10:56.19,Default,,0,0,0,,Басқалар сияқты менің де күмәнім болған жоқ.
Dialogue: 0,0:10:56.31,0:10:57.15,Default,,0,0,0,,Әй?
Dialogue: 0,0:10:57.40,0:11:00.73,Default,,0,0,0,,Егер мен компанияның жүйесіне иелік етсем
Dialogue: 0,0:11:00.86,0:11:03.07,Default,,0,0,0,,Ауыстыруға болатын...
Dialogue: 0,0:11:04.03,0:11:06.03,Default,,0,0,0,,Скреп - бұл рөлді орындағанның мақтанышы.
Dialogue: 0,0:11:06.16,0:11:07.87,Default,,0,0,0,,Мен әрқашан осылай ойладым
Dialogue: 0,0:11:08.41,0:11:10.24,Default,,0,0,0,,Бірақ мен ранжер болған соң өзгердім.
Dialogue: 0,0:11:10.66,0:11:11.58,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:11:12.41,0:11:13.50,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:14.62,0:11:16.04,Default,,0,0,0,,Маған енді ұнамайды!
Dialogue: 0,0:11:16.17,0:11:18.38,Default,,0,0,0,,Сізді ауыстыруға болатын күйге оралу!
Dialogue: 0,0:11:18.50,0:11:21.34,Default,,0,0,0,,Егер бұл жалғаса берсе, мен сенімдімін
Dialogue: 0,0:11:21.46,0:11:23.67,Default,,0,0,0,,Сіздің рейтингіңіз төмендейді.
Dialogue: 0,0:11:24.68,0:11:27.51,Default,,0,0,0,,Жоқ... бір боялған соң, қайтып орала алмайсың.
Dialogue: 0,0:11:27.85,0:11:29.51,Default,,0,0,0,,Біз жақсы орындаймыз!
Dialogue: 0,0:11:29.64,0:11:32.02,Default,,0,0,0,,Оны қолданатын ойыншылар бар, солай ма?
Dialogue: 0,0:11:32.14,0:11:33.56,Default,,0,0,0,,Себебі
Dialogue: 0,0:11:33.68,0:11:36.23,Default,,0,0,0,,Ойыншылар мен ранкерлер қолданғанда басқаша.
Dialogue: 0,0:11:36.35,0:11:37.90,Default,,0,0,0,,Ол қате ретінде жойылады.
Dialogue: 0,0:11:38.06,0:11:39.98,Default,,0,0,0,,Мен өзімді шегіне жеткізгім келеді!
Dialogue: 0,0:11:40.11,0:11:40.86,Default,,0,0,0,,Әй!
Dialogue: 0,0:11:40.98,0:11:42.07,Default,,0,0,0,,Кабураги мырза!
Dialogue: 0,0:11:42.53,0:11:45.07,Default,,0,0,0,,Өтінемін! Өтінемін!
Dialogue: 0,0:11:50.37,0:11:52.12,Default,,0,0,0,,20%-ға дейін...
Dialogue: 0,0:11:52.24,0:11:53.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:53.62,0:11:57.29,Default,,0,0,0,,Шектеуішті жою 20% шектелетініне уәде беріңіз.
Dialogue: 0,0:11:57.75,0:12:00.09,Default,,0,0,0,,Олай болса, шабуылға төтеп бере аласыз.
Dialogue: 0,0:12:00.29,0:12:01.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:01.88,0:12:04.09,Default,,0,0,0,,Рахмет! Хехе!
Dialogue: 0,0:12:07.93,0:12:10.85,Default,,0,0,0,,Не деп күліп тұрсың? Бұл жақсы сезінеді
Dialogue: 0,0:12:11.14,0:12:13.85,Default,,0,0,0,,А... кешіріңіз, мен майдан даласын асыға күтемін.
Dialogue: 0,0:12:13.97,0:12:16.69,Default,,0,0,0,,Дәрежеңіз көтерілді деп, ренжімеңіз.
Dialogue: 0,0:12:17.06,0:12:18.48,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:12:18.60,0:12:20.65,Default,,0,0,0,,Мен осында болғаныма қуаныштымын.
Dialogue: 0,0:12:20.98,0:12:22.65,Default,,0,0,0,,олар ондағы жазбаларды сақтау үшін көшіріп жазады—
Dialogue: 0,0:12:22.90,0:12:24.15,Default,,0,0,0,,Жоғарғы дәрежедегілер
Dialogue: 0,0:12:24.53,0:12:26.53,Default,,0,0,0,,Келісуге жақын қалдық.
Dialogue: 0,0:12:26.65,0:12:28.16,Default,,0,0,0,,Бүгін мен де сенен сұраймын.
Dialogue: 0,0:12:34.08,0:12:35.37,Default,,0,0,0,,Міне...
Dialogue: 0,0:12:35.50,0:12:36.25,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:12:36.87,0:12:38.08,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:12:44.67,0:12:46.88,Default,,0,0,0,,Тіркелмеген Арнайы Сынып па?
Dialogue: 0,0:12:49.93,0:12:52.39,Default,,0,0,0,,Әлемге қателер қажет емес
Dialogue: 0,0:12:52.64,0:12:54.68,Default,,0,0,0,,Уау! Тоқта!
Dialogue: 0,0:12:54.81,0:12:56.14,Default,,0,0,0,,Ах, уау, а...
Dialogue: 0,0:12:56.35,0:12:58.64,Default,,0,0,0,,Pipo pipo pipo~
Dialogue: 0,0:12:58.98,0:13:01.65,Default,,0,0,0,,Құпиялылықты бұзу – елеулі қате
Dialogue: 0,0:13:02.06,0:13:03.73,Default,,0,0,0,,Оны қайтарыңыз.
Dialogue: 0,0:13:03.86,0:13:05.90,Default,,0,0,0,,Бұл құнды ресурс.
Dialogue: 0,0:13:07.99,0:13:09.86,Default,,0,0,0,,Көкнәр
Dialogue: 0,0:13:09.99,0:13:10.78,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:10.91,0:13:12.41,Default,,0,0,0,,Күшік күшік!
Dialogue: 0,0:13:13.03,0:13:16.16,Default,,0,0,0,,Хмм, бұл өте маңызды мәселе.
Dialogue: 0,0:13:16.91,0:13:19.12,Default,,0,0,0,,Сіз алдаушылардың бірісіз бе?
Dialogue: 0,0:13:19.25,0:13:20.17,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:13:20.29,0:13:21.83,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:13:21.96,0:13:23.42,Default,,0,0,0,,Майки…
Dialogue: 0,0:13:23.54,0:13:26.51,Default,,0,0,0,,Джиджи… Гаггагага…
Dialogue: 0,0:13:29.34,0:13:30.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:31.30,0:13:34.10,Default,,0,0,0,,Бұл кім? Мына жігітті оқытқан жігіт!
Dialogue: 0,0:13:34.22,0:13:35.51,Default,,0,0,0,,Түркия! (Түркия) Иә!
Dialogue: 0,0:13:35.64,0:13:37.72,Default,,0,0,0,,Уф, жоқ!
Dialogue: 0,0:13:37.85,0:13:38.89,Default,,0,0,0,,Донателло, тоқтат!
Dialogue: 0,0:13:39.02,0:13:40.60,Default,,0,0,0,,(төбелес дауыстары)
Dialogue: 0,0:13:41.10,0:13:42.90,Default,,0,0,0,,ақымақ
Dialogue: 0,0:13:57.37,0:13:58.95,Default,,0,0,0,,Кабураги мырза
Dialogue: 0,0:13:59.08,0:14:02.54,Default,,0,0,0,,Сізді ұстағаным үшін кешіріңіз, жоғары дәрежелі қызметкер.
Dialogue: 0,0:14:02.67,0:14:05.38,Default,,0,0,0,,Бұл басқа ранжер зорлық-зомбылық танытқандықтан қабылданған шара.
Dialogue: 0,0:14:07.42,0:14:08.38,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:14:08.92,0:14:12.55,Default,,0,0,0,,Майки шектеушіні босатады, бұл тыйым салынған әрекет.
Dialogue: 0,0:14:12.68,0:14:14.14,Default,,0,0,0,,Қырылған
Dialogue: 0,0:14:14.64,0:14:16.56,Default,,0,0,0,,Демек, ранкер командасы таратылады.
Dialogue: 0,0:14:16.68,0:14:18.64,Default,,0,0,0,,Жоқ! Команда жауапты емес!
Dialogue: 0,0:14:19.52,0:14:20.35,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:20.48,0:14:23.56,Default,,0,0,0,,Тәуекелге айырбастау күшінің артуы
Dialogue: 0,0:14:23.69,0:14:27.36,Default,,0,0,0,,Ауырсынуға құмар ойыншы жасаған алдау сияқты.
Dialogue: 0,0:14:27.48,0:14:28.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:28.82,0:14:29.65,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:29.78,0:14:30.65,Default,,0,0,0,,Мұны қабылдаңыз
Dialogue: 0,0:14:31.15,0:14:35.87,Default,,0,0,0,,Жүйе бұл Ранкердің жалпы тәртібіне қатысты мәселе екенін анықтады.
Dialogue: 0,0:14:35.99,0:14:39.66,Default,,0,0,0,,Ертеңнен бастап қол-аяғымыз болып жұмыс істейсің.
Dialogue: 0,0:14:40.16,0:14:41.75,Default,,0,0,0,,Күндізгі сауыт жөндеуші
Dialogue: 0,0:14:41.87,0:14:44.17,Default,,0,0,0,,Түнде коллектор ретінде әрекет етіңіз.
Dialogue: 0,0:14:44.75,0:14:45.83,Default,,0,0,0,,Коллекционер?
Dialogue: 0,0:14:45.83,0:14:45.96,Default,,0,0,0,,Коллекционер?
Dialogue: 0,0:14:45.83,0:14:45.96,Default,,0,0,0,,(монитор дыбысы)
Dialogue: 0,0:14:45.96,0:14:46.08,Default,,0,0,0,,(монитор дыбысы)
Dialogue: 0,0:14:46.08,0:14:46.92,Default,,0,0,0,,(монитор дыбысы)
Dialogue: 0,0:14:46.08,0:14:46.92,Default,,0,0,0,,Әй!
Dialogue: 0,0:14:48.25,0:14:50.13,Default,,0,0,0,,Кейбір адамдар
Dialogue: 0,0:14:50.26,0:14:54.47,Default,,0,0,0,,Бұл дүниеге ыңғайсыз адамдар жиі шығады.
Dialogue: 0,0:14:54.59,0:14:56.93,Default,,0,0,0,,Мұның бәрі қателер
Dialogue: 0,0:14:58.26,0:15:01.52,Default,,0,0,0,,Қателер әлем үшін қаншалықты қауіпті?
Dialogue: 0,0:15:01.64,0:15:03.52,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:15:04.85,0:15:07.56,Default,,0,0,0,,Жүйе қатені жояды.
Dialogue: 0,0:15:07.77,0:15:11.65,Default,,0,0,0,,Адамның ішіне чипті жинау керек.
Dialogue: 0,0:15:11.78,0:15:14.15,Default,,0,0,0,,Мен де қате таптым.
Dialogue: 0,0:15:14.28,0:15:16.20,Default,,0,0,0,,Сондай-ақ хабарлаңыз
Dialogue: 0,0:15:18.08,0:15:20.20,Default,,0,0,0,,Жеткізгішті қайта бер.
Dialogue: 0,0:15:20.95,0:15:23.41,Default,,0,0,0,,Мен және сіз Компанияның мүлкі
Dialogue: 0,0:15:23.54,0:15:25.67,Default,,0,0,0,,Күшік күшік Бас тартуға...
Dialogue: 0,0:15:26.25,0:15:28.54,Default,,0,0,0,,Менің жүйеге қарсы шығу ниетім жоқ.
Dialogue: 0,0:15:28.84,0:15:30.63,Default,,0,0,0,,Жақсы көзқарас
Dialogue: 0,0:15:30.75,0:15:32.67,Default,,0,0,0,,Донателло және басқалар сияқты емес.
Dialogue: 0,0:15:33.17,0:15:35.13,Default,,0,0,0,,Иә! Ол нені білдіреді?
Dialogue: 0,0:15:35.43,0:15:37.05,Default,,0,0,0,,Олар ақымақ
Dialogue: 0,0:15:37.18,0:15:40.01,Default,,0,0,0,,Мен жүйенің шешімін орындамадым.
Dialogue: 0,0:15:40.76,0:15:43.64,Default,,0,0,0,,Сондықтан мені түзеу мекемесіне, Көкнәр Попи Көкнәрге жіберді.
Dialogue: 0,0:15:44.27,0:15:45.64,Default,,0,0,0,,Айха.
Dialogue: 0,0:15:46.65,0:15:49.02,Default,,0,0,0,,Енді қайталаңыз
Dialogue: 0,0:15:49.19,0:15:51.65,Default,,0,0,0,,«Әлемге қателер қажет емес»
Dialogue: 0,0:15:52.19,0:15:53.07,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:54.74,0:15:56.03,Default,,0,0,0,,Кабураги мырза?
Dialogue: 0,0:15:56.32,0:15:57.24,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:15:58.32,0:16:01.41,Default,,0,0,0,,Әлемге қателер қажет емес
Dialogue: 0,0:16:10.88,0:16:13.63,Default,,0,0,0,,Мұны өзім шешуге рұқсат етіңіз.
Dialogue: 0,0:16:15.01,0:16:17.22,Default,,0,0,0,,Сәлем Майки...
Dialogue: 0,0:16:20.05,0:16:22.51,Default,,0,0,0,,Маған күресуді үйретіңізші!
Dialogue: 0,0:16:22.81,0:16:26.18,Default,,0,0,0,,Мен «сол күшке» қосылғым келеді!
Dialogue: 0,0:16:26.31,0:16:28.06,Default,,0,0,0,,Сіз әлі де солай айтасыз ба?
Dialogue: 0,0:16:28.19,0:16:30.69,Default,,0,0,0,,Аскөктен аздап үйренсек ше?
Dialogue: 0,0:16:31.15,0:16:33.73,Default,,0,0,0,,Содан бері көшеге шығуға қорқатынын айтты.
Dialogue: 0,0:16:33.86,0:16:35.40,Default,,0,0,0,,Мен кеңсеге жұмысқа бардым.
Dialogue: 0,0:16:35.53,0:16:37.53,Default,,0,0,0,,Менің өлгім де, берілгім де келмейді.
Dialogue: 0,0:16:38.45,0:16:40.28,Default,,0,0,0,,Бірдеңе айту бекер
Dialogue: 0,0:16:40.74,0:16:42.33,Default,,0,0,0,,Түсінікті...
Dialogue: 0,0:16:42.45,0:16:45.79,Default,,0,0,0,,Осыншама көп сұрасаң, нәтиже шықпаса, менің амалым жоқ.
Dialogue: 0,0:16:46.08,0:16:47.79,Default,,0,0,0,,Бастық, кешіріңіз!
Dialogue: 0,0:16:48.21,0:16:49.04,Default,,0,0,0,,Не!
Dialogue: 0,0:16:49.50,0:16:50.92,Default,,0,0,0,,Бұл менің төзімділігім жақсарғандықтан, және
Dialogue: 0,0:16:51.08,0:16:53.88,Default,,0,0,0,,Айтпасаң мен саған құбырды айтамын!
Dialogue: 0,0:16:54.00,0:16:54.84,Default,,0,0,0,,Не!
Dialogue: 0,0:16:54.96,0:16:57.59,Default,,0,0,0,,Содан кейін бастық Decadence-тен шығарылды.
Dialogue: 0,0:16:57.72,0:17:00.68,Default,,0,0,0,,Сүйкімді Пип-чан тартылған етке айналады!
Dialogue: 0,0:17:00.80,0:17:03.26,Default,,0,0,0,,Сіз мені қорқытасыз ба?
Dialogue: 0,0:17:03.51,0:17:06.27,Default,,0,0,0,,Егер бұл сізге ұқсайтын болса, солай.
Dialogue: 0,0:17:07.85,0:17:09.02,Default,,0,0,0,,мұнда тұтқындарды пайдаланып көмір қазылады
Dialogue: 0,0:17:10.56,0:17:11.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:13.02,0:17:15.78,Default,,0,0,0,,Кешіріңіз! Бұрынғы айтқаным өтірік!
Dialogue: 0,0:17:15.90,0:17:18.03,Default,,0,0,0,,Мен бұл фотоны бағалаймын...
Dialogue: 0,0:17:18.82,0:17:20.78,Default,,0,0,0,,Бірақ неге?
Dialogue: 0,0:17:21.53,0:17:23.28,Default,,0,0,0,,Мен біттім
Dialogue: 0,0:17:23.83,0:17:26.41,Default,,0,0,0,,Өлгенше күнде солай өмір сүруден басқа амалым жоқ.
Dialogue: 0,0:17:26.75,0:17:28.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:29.92,0:17:32.29,Default,,0,0,0,,Бұл сәл артық.
Dialogue: 0,0:17:32.96,0:17:34.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:38.67,0:17:40.09,Default,,0,0,0,,Өл, қарт жезөкше!
Dialogue: 0,0:17:40.22,0:17:42.30,Default,,0,0,0,,О, қош келдіңіз, Нацумэ-чан
Dialogue: 0,0:17:42.59,0:17:45.22,Default,,0,0,0,,Ах! Баға тағы көтерілді ме?
Dialogue: 0,0:17:45.35,0:17:47.47,Default,,0,0,0,,Соңғы кездері жақсы емеспін.
Dialogue: 0,0:17:47.60,0:17:49.52,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:49.64,0:17:51.73,Default,,0,0,0,,Бұл жай ғана...
Dialogue: 0,0:17:51.85,0:17:54.36,Default,,0,0,0,,Хмм... Жарайды, мен шештім!
Dialogue: 0,0:17:54.48,0:17:55.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:59.70,0:18:00.82,Default,,0,0,0,,Бастық?
Dialogue: 0,0:18:01.15,0:18:02.74,Default,,0,0,0,,Не? Не?
Dialogue: 0,0:18:02.86,0:18:03.82,Default,,0,0,0,,Иә! (Дүкенші) Әй!
Dialogue: 0,0:18:04.91,0:18:07.24,Default,,0,0,0,,Сәлем Нацумэ-чан!
Dialogue: 0,0:18:07.58,0:18:09.79,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:18:09.91,0:18:10.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:12.12,0:18:14.58,Default,,0,0,0,,Иә? Бұл қайда?
Dialogue: 0,0:18:15.17,0:18:17.84,Default,,0,0,0,,Ах! Қайда бара жатырсың?
Dialogue: 0,0:18:23.22,0:18:24.18,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:24.30,0:18:25.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:25.85,0:18:26.76,Default,,0,0,0,,Өтірік!
Dialogue: 0,0:18:30.06,0:18:31.56,Default,,0,0,0,,Бұл...
Dialogue: 0,0:18:31.98,0:18:32.85,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:37.07,0:18:38.40,Default,,0,0,0,,Негізінен, біз қашамыз.
Dialogue: 0,0:18:38.53,0:18:39.99,Default,,0,0,0,,Негізінен, біз қашамыз.
Dialogue: 0,0:18:41.28,0:18:42.78,Default,,0,0,0,,Бастық! Ха!
Dialogue: 0,0:18:44.24,0:18:46.45,Default,,0,0,0,,Мұны істеме!
Dialogue: 0,0:18:46.58,0:18:48.45,Default,,0,0,0,,Көрдіңіз бе...
Dialogue: 0,0:18:49.41,0:18:50.79,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:18:51.12,0:18:53.29,Default,,0,0,0,,Соңғысы сіздің чипіңіз.
Dialogue: 0,0:18:54.04,0:18:55.42,Default,,0,0,0,,Бұл ирониялық.
Dialogue: 0,0:18:55.54,0:18:56.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:59.34,0:19:00.46,Default,,0,0,0,,Не?
Dialogue: 0,0:19:00.84,0:19:02.22,Default,,0,0,0,,Неліктен өңделмейді?
Dialogue: 0,0:19:02.34,0:19:05.30,Default,,0,0,0,,Енді мен түсінбейтін не айтып тұрсың?
Dialogue: 0,0:19:05.43,0:19:08.81,Default,,0,0,0,,Айтайын дегенім, ұйықтап жатқан адамдардың ақшасын ұрлау жақсы емес!
Dialogue: 0,0:19:08.93,0:19:09.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:09.81,0:19:12.98,Default,,0,0,0,,Бастық: Сіз шынымен де мұндай нәрсені жасайтын адам емессіз бе?
Dialogue: 0,0:19:13.19,0:19:14.85,Default,,0,0,0,,Мықты болыңыз!
Dialogue: 0,0:19:15.19,0:19:16.86,Default,,0,0,0,,Мен не болғанын білмеймін.
Dialogue: 0,0:19:17.31,0:19:20.86,Default,,0,0,0,,Бітті деме, берілме!
Dialogue: 0,0:19:21.15,0:19:22.03,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:22.94,0:19:24.99,Default,,0,0,0,,Мен оны саған қарызға беремін!
Dialogue: 0,0:19:25.11,0:19:28.16,Default,,0,0,0,,Иә! Менің барлық қымбат дүниелерім!
Dialogue: 0,0:19:28.74,0:19:33.54,Default,,0,0,0,,Поо! Кукукуку…
Dialogue: 0,0:19:33.66,0:19:34.96,Default,,0,0,0,,Хахаха... аа...?
Dialogue: 0,0:19:35.12,0:19:36.04,Default,,0,0,0,,Мм!
Dialogue: 0,0:19:36.17,0:19:38.00,Default,,0,0,0,,Бұл күлкі емес!
Dialogue: 0,0:19:38.13,0:19:40.63,Default,,0,0,0,,Мен мүлдем ақша алған жоқпын!
Dialogue: 0,0:19:40.75,0:19:42.09,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:19:42.21,0:19:44.13,Default,,0,0,0,,Мен енді ұрлық жасамаймын, үйге қайт.
Dialogue: 0,0:19:44.26,0:19:45.43,Default,,0,0,0,,Эй, бұл не? Қалай айту керек!
Dialogue: 0,0:19:45.43,0:19:46.72,Default,,0,0,0,,Эй, бұл не? Қалай айту керек!
Dialogue: 0,0:19:45.43,0:19:46.72,Default,,0,0,0,,Хаха...
Dialogue: 0,0:19:49.35,0:19:50.68,Default,,0,0,0,,Егер Хигучи екінші Кира сияқты тек қарап-ақ адам өлтіре алса, онда Кираның шын кім екені бағдарлама соңында ашылады!
Dialogue: 0,0:19:50.81,0:19:53.23,Default,,0,0,0,,Барлық адамдар чиптермен басқарылады
Dialogue: 0,0:19:54.06,0:19:55.94,Default,,0,0,0,,Ұрлық деп қателессеңіз де
Dialogue: 0,0:19:56.06,0:19:57.98,Default,,0,0,0,,Міндетті түрде өңделуі керек
Dialogue: 0,0:20:01.53,0:20:02.48,Default,,0,0,0,,Не?
Dialogue: 0,0:20:03.15,0:20:04.74,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:20:11.95,0:20:12.16,Default,,0,0,0,,(монитор дыбысы)
Dialogue: 0,0:20:12.16,0:20:12.99,Default,,0,0,0,,(монитор дыбысы)
Dialogue: 0,0:20:12.16,0:20:12.99,Default,,0,0,0,,Не!
Dialogue: 0,0:20:15.21,0:20:16.50,Default,,0,0,0,,Не...
Dialogue: 0,0:20:16.96,0:20:18.04,Default,,0,0,0,,Бәрі жақсы, мен бұны істей аламын!
Dialogue: 0,0:20:18.17,0:20:20.63,Default,,0,0,0,,Оны жүйе танымайды ма?
Dialogue: 0,0:20:21.67,0:20:22.92,Default,,0,0,0,,Қате…
Dialogue: 0,0:20:23.46,0:20:25.63,Default,,0,0,0,,! Сол сияқты
Dialogue: 0,0:20:25.76,0:20:27.93,Default,,0,0,0,,Мен бұл күшке қосыла алмадым.
Dialogue: 0,0:20:28.34,0:20:29.89,Default,,0,0,0,,Бұл шынымен жаман ба?
Dialogue: 0,0:20:31.56,0:20:33.93,Default,,0,0,0,,Сәлем Майки
Dialogue: 0,0:20:34.77,0:20:35.64,Default,,0,0,0,,Мен...
Dialogue: 0,0:20:43.98,0:20:45.90,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,0:20:46.03,0:20:48.07,Default,,0,0,0,,Бұл не деген жиіркенішті бет?
Dialogue: 0,0:20:48.61,0:20:51.91,Default,,0,0,0,,Неге маған күресуді үйреткіңіз келді?
Dialogue: 0,0:20:53.95,0:20:55.70,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:20:55.83,0:20:58.42,Default,,0,0,0,,Қателер бұл әлемде қалай өмір сүреді?
Dialogue: 0,0:20:58.96,0:21:00.54,Default,,0,0,0,,Мен тексергім келді.
Dialogue: 0,0:21:00.75,0:21:03.25,Default,,0,0,0,,Иә? Қате дегеніміз не?
Dialogue: 0,0:21:03.38,0:21:04.25,Default,,0,0,0,,Бұл сіз туралы.
Dialogue: 0,0:21:04.38,0:21:05.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:05.51,0:21:08.43,Default,,0,0,0,,Басқаша айтқанда, жәндік сияқты әлсіз дегенді білдіреді.
Dialogue: 0,0:21:08.55,0:21:10.22,Default,,0,0,0,,Бұл аздап нашар емес пе?
Dialogue: 0,0:21:10.68,0:21:13.10,Default,,0,0,0,,Үміт болмаса, бас тарт.
Dialogue: 0,0:21:13.22,0:21:14.85,Default,,0,0,0,,Не? Маған ұнамайды
Dialogue: 0,0:21:16.52,0:21:19.64,Default,,0,0,0,,О! Бұл керемет~
Dialogue: 0,0:21:19.77,0:21:21.48,Default,,0,0,0,,Не, мұнда бірінші рет келіп тұрсың ба?
Dialogue: 0,0:21:22.40,0:21:24.86,Default,,0,0,0,,Мен сол күшке байланысты әскерге түсе алмадым.
Dialogue: 0,0:21:27.94,0:21:29.45,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:29.57,0:21:31.53,Default,,0,0,0,,Бұл Gear негізі!
Dialogue: 0,0:21:31.66,0:21:34.58,Default,,0,0,0,,Мен басқа әлемге келгендей болдым!
Dialogue: 0,0:21:37.12,0:21:39.75,Default,,0,0,0,,Уау, тамаша!
Dialogue: 0,0:21:39.87,0:21:41.79,Default,,0,0,0,,Иә? Тері дүкені?
Dialogue: 0,0:21:42.33,0:21:44.04,Default,,0,0,0,,Бұл не? бұл?
Dialogue: 0,0:21:44.17,0:21:46.80,Default,,0,0,0,,Ах! Сәл күте тұрыңыз!
Dialogue: 0,0:21:48.05,0:21:49.80,Default,,0,0,0,,Әлемге қателер қажет болмаса
Dialogue: 0,0:21:50.47,0:21:53.14,Default,,0,0,0,,Оны өшіру керек
Dialogue: 0,0:21:55.43,0:21:57.56,Default,,0,0,0,,Әлемге қателер қажет болмаса
Dialogue: 0,0:21:58.43,0:22:01.39,Default,,0,0,0,,Ол түкке тұрғысыз болады
Dialogue: 0,0:22:02.90,0:22:04.52,Default,,0,0,0,,Бірақ сол кезде
Dialogue: 0,0:22:05.48,0:22:08.07,Default,,0,0,0,,Мен... әрине...
Dialogue: 0,0:22:09.95,0:22:11.66,Default,,0,0,0,,Мен құтқарылдым.
Dialogue: 0,0:22:19.96,0:22:24.96,Default,,0,0,0,,♪～
Dialogue: 0,0:23:44.83,0:23:49.84,Default,,0,0,0,,～♪
Dialogue: 0,0:23:51.34,0:23:57.34,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory