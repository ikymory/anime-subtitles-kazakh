Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.32,0:00:13.36,Default,,0,0,0,,Балапан Дайынсың ба?
Dialogue: 0,0:00:19.37,0:00:22.62,Default,,0,0,0,,Декаденс іске қосылды!
Dialogue: 0,0:00:25.41,0:00:26.37,Default,,0,0,0,,Неліктен...
Dialogue: 0,0:00:26.67,0:00:28.12,Default,,0,0,0,,Неліктен ол басталмайды?
Dialogue: 0,0:00:28.58,0:00:30.04,Default,,0,0,0,,Бұйрық! Ха!
Dialogue: 0,0:00:30.17,0:00:31.34,Default,,0,0,0,,Негізгі денеде қауіпті
Dialogue: 0,0:00:31.46,0:00:32.63,Default,,0,0,0,,Мен жақында қайтамын...
Dialogue: 0,0:00:32.80,0:00:33.76,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:35.51,0:00:37.18,Default,,0,0,0,,Жерде не...
Dialogue: 0,0:00:38.01,0:00:40.43,Default,,0,0,0,,Денеңіз ретінде декаденспен кіресіз бе?
Dialogue: 0,0:00:40.55,0:00:42.39,Default,,0,0,0,,Қосылым аяқталды
Dialogue: 0,0:00:42.51,0:00:43.47,Default,,0,0,0,,Бір түнде, 452 адамнан тұратын тұрғындардың арасынан—
Dialogue: 0,0:00:43.85,0:00:45.77,Default,,0,0,0,,Бірақ мен оны бастай алмаймын.
Dialogue: 0,0:00:45.89,0:00:47.27,Default,,0,0,0,,Ағымдағы жағдайды түсінуді сұраңыз
Dialogue: 0,0:00:47.39,0:00:49.23,Default,,0,0,0,,Біз әлі де бірдеңе істей аламыз.
Dialogue: 0,0:00:49.56,0:00:50.48,Default,,0,0,0,,Ха!
Dialogue: 0,0:00:50.61,0:00:51.73,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:00:52.32,0:00:54.23,Default,,0,0,0,,Эй, қарашы (Киборг) Мынау ақылсыз!
Dialogue: 0,0:00:54.82,0:00:56.61,Default,,0,0,0,,Декаденс, қозғалма
Dialogue: 0,0:00:56.74,0:00:57.74,Default,,0,0,0,,Неге...
Dialogue: 0,0:00:58.07,0:01:01.12,Default,,0,0,0,,Қосылым сәтті болған сияқты.
Dialogue: 0,0:01:01.24,0:01:03.49,Default,,0,0,0,,Қалғаны Кабураги-санға қалды.
Dialogue: 0,0:01:03.62,0:01:05.83,Default,,0,0,0,,Иә! байланыс?
Dialogue: 0,0:01:05.95,0:01:07.50,Default,,0,0,0,,Бастыққа не болды?
Dialogue: 0,0:01:07.71,0:01:09.08,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:09.25,0:01:10.25,Default,,0,0,0,,Бұл бастық
Dialogue: 0,0:01:10.79,0:01:12.75,Default,,0,0,0,,Иә? тістері?
Dialogue: 0,0:01:13.09,0:01:13.88,Default,,0,0,0,,Кабураги мырза
Dialogue: 0,0:01:14.00,0:01:16.01,Default,,0,0,0,,Мен Декаденциямен байланыстырдым.
Dialogue: 0,0:01:16.13,0:01:18.38,Default,,0,0,0,,Басқаша айтқанда, сіз айтқан бастық...
Dialogue: 0,0:01:18.51,0:01:20.26,Default,,0,0,0,,Енді бұл
Dialogue: 0,0:01:27.85,0:01:29.02,Default,,0,0,0,,…Елшілік шын мәнінде шетелде орналасқанын білесіз ғой.
Dialogue: 0,0:01:29.64,0:01:32.52,Default,,0,0,0,,Deca-Dance қазір Cub Dance деп аталады.
Dialogue: 0,0:01:32.69,0:01:33.73,Default,,0,0,0,,Гяхахаха! (Киборг) Иә!
Dialogue: 0,0:01:33.86,0:01:35.86,Default,,0,0,0,,Керемет, Джилл.
Dialogue: 0,0:01:36.03,0:01:37.07,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:37.32,0:01:38.40,Default,,0,0,0,,Бұл...
Dialogue: 0,0:01:39.45,0:01:42.95,Default,,0,0,0,,Бар, менің бір ісім бар.
Dialogue: 0,0:01:44.33,0:01:47.04,Default,,0,0,0,,Бастық әрқашан осылай, солай ма?
Dialogue: 0,0:01:47.16,0:01:47.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:48.96,0:01:51.92,Default,,0,0,0,,Бұл не қажет болса да істеуге жеткілікті өзімшіл.
Dialogue: 0,0:01:52.33,0:01:53.38,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:53.50,0:01:55.63,Default,,0,0,0,,Бірақ біз қалай күресеміз?
Dialogue: 0,0:01:55.75,0:01:57.42,Default,,0,0,0,,Ол әлдеқашан тозған, солай емес пе?
Dialogue: 0,0:01:57.55,0:01:58.67,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:58.80,0:02:00.93,Default,,0,0,0,,Иә, қару жасайық.
Dialogue: 0,0:02:01.05,0:02:01.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:01.93,0:02:03.64,Default,,0,0,0,,«Балапан биі» қаруы
Dialogue: 0,0:02:03.76,0:02:06.18,Default,,0,0,0,,Мұны бастық қуаттандырды.
Dialogue: 0,0:02:06.39,0:02:08.39,Default,,0,0,0,,«Бұл сіздің қаруыңыз».
Dialogue: 0,0:02:08.52,0:02:10.19,Default,,0,0,0,,Сен ақымақсың ба?
Dialogue: 0,0:02:10.31,0:02:11.85,Default,,0,0,0,,Таразылар тым әртүрлі
Dialogue: 0,0:02:12.15,0:02:14.23,Default,,0,0,0,,Бастық та былай деді:
Dialogue: 0,0:02:14.36,0:02:17.23,Default,,0,0,0,,«Бөлшектерді қажетінше өзгертуге болады»
Dialogue: 0,0:02:17.65,0:02:20.11,Default,,0,0,0,,Сонымен бөлшектер...
Dialogue: 0,0:02:20.65,0:02:22.32,Default,,0,0,0,,Осыны айтып тұрсың ба?
Dialogue: 0,0:02:22.99,0:02:23.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:24.20,0:02:25.37,Default,,0,0,0,,Не? (Кайборг) Не істеп жатырсың?
Dialogue: 0,0:02:25.49,0:02:26.83,Default,,0,0,0,,Түсіндіңіз бе? (Киборг) Мен түсінбеймін.
Dialogue: 0,0:02:27.87,0:02:30.08,Default,,0,0,0,,Ескі бөлшектерді пайдалансаңыз...
Dialogue: 0,0:02:30.50,0:02:33.63,Default,,0,0,0,,Осылайша... Жоқ, жоқ, бірақ қалай...
Dialogue: 0,0:02:33.75,0:02:35.84,Default,,0,0,0,,Түсіндім, егер сіз аймақтарды пайдалансаңыз...
Dialogue: 0,0:02:39.34,0:02:40.34,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:02:40.88,0:02:41.84,Default,,0,0,0,,Джил мырза?
Dialogue: 0,0:02:42.26,0:02:45.01,Default,,0,0,0,,Негізсіз тілек...
Dialogue: 0,0:02:45.14,0:02:46.85,Default,,0,0,0,,Олай емес сияқты.
Dialogue: 0,0:02:47.01,0:02:49.52,Default,,0,0,0,,Тек бір рет шектеу.
Dialogue: 0,0:02:49.97,0:02:51.73,Default,,0,0,0,,Бастыққа сеніңіз!
Dialogue: 0,0:02:51.85,0:02:52.85,Default,,0,0,0,,Хехе
Dialogue: 0,0:02:53.19,0:02:54.69,Default,,0,0,0,,Жасайық!
Dialogue: 0,0:02:54.81,0:02:55.65,Default,,0,0,0,,Сонымен не істеп жатырсың?
Dialogue: 0,0:02:55.77,0:02:56.86,Default,,0,0,0,,Мен білемін бе?
Dialogue: 0,0:02:58.94,0:03:01.11,Default,,0,0,0,,Хмм... жағдай қалай?
Dialogue: 0,0:03:01.32,0:03:03.32,Default,,0,0,0,,Қайта жүктеу кезеңі аяқталды
Dialogue: 0,0:03:03.45,0:03:04.99,Default,,0,0,0,,Мен себебін білмеймін
Dialogue: 0,0:03:05.11,0:03:06.41,Default,,0,0,0,,Операциялық жүйедегі шу
Dialogue: 0,0:03:06.53,0:03:09.62,Default,,0,0,0,,Жүйе тарапынан кейбір кедергілер болуы мүмкін.
Dialogue: 0,0:03:09.74,0:03:11.20,Default,,0,0,0,,Цк, ақыр соңында?
Dialogue: 0,0:03:11.33,0:03:12.16,Default,,0,0,0,,Операцияны басқаратын шебер агент: Твайлайт
Dialogue: 0,0:03:12.71,0:03:15.00,Default,,0,0,0,,Мен бұл туралы ештеңе істей алмаймын.
Dialogue: 0,0:03:15.17,0:03:16.84,Default,,0,0,0,,Сіз тек сене аласыз және күте аласыз.
Dialogue: 0,0:03:16.96,0:03:18.17,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:18.46,0:03:21.55,Default,,0,0,0,,Бұрынғы қолбасшы ынтымақтастықты сұрайды
Dialogue: 0,0:03:21.88,0:03:22.80,Default,,0,0,0,,Әй?
Dialogue: 0,0:03:25.34,0:03:27.43,Default,,0,0,0,,Хаха...
Dialogue: 0,0:03:27.76,0:03:29.26,Default,,0,0,0,,Сіз оны ақырында тазаладыңыз ба?
Dialogue: 0,0:03:29.39,0:03:30.31,Default,,0,0,0,,және бұл балалар арасында кемсітушілік пен қорлауға әкеліп соғатын сияқты.
Dialogue: 0,0:03:30.64,0:03:32.48,Default,,0,0,0,,Бұл өте қарапайым.
Dialogue: 0,0:03:32.60,0:03:33.56,Default,,0,0,0,,Өтірікші (Исаам)...
Dialogue: 0,0:03:33.69,0:03:34.69,Default,,0,0,0,,Әй!
Dialogue: 0,0:03:35.35,0:03:37.81,Default,,0,0,0,,Балалар, бұл соңғы тапсырма.
Dialogue: 0,0:03:38.23,0:03:39.82,Default,,0,0,0,,Не? (Иссам) Миссия?
Dialogue: 0,0:03:40.48,0:03:41.94,Default,,0,0,0,,Барлық жерде шашыраңқы -
Dialogue: 0,0:03:42.07,0:03:44.65,Default,,0,0,0,,Бұрынғы Декаденс бөліктеріне оксонды қосу
Dialogue: 0,0:03:45.36,0:03:47.66,Default,,0,0,0,,Сенің маған өмір бергеніңді қалаймын.
Dialogue: 0,0:03:48.03,0:03:50.66,Default,,0,0,0,,Бұл тозудың қаруы.
Dialogue: 0,0:03:51.12,0:03:54.79,Default,,0,0,0,,Сізде бір ғана мүмкіндік бар, бірақ мен сізді міндетті түрде жеңемін.
Dialogue: 0,0:03:55.58,0:03:56.79,Default,,0,0,0,,Мен сізден өтіндім, мырзалар.
Dialogue: 0,0:03:58.13,0:04:00.80,Default,,0,0,0,,Декаденстің болашағы үшін
Dialogue: 0,0:04:01.09,0:04:03.13,Default,,0,0,0,,Мен қатты тұрып қалдым.
Dialogue: 0,0:04:03.26,0:04:04.30,Default,,0,0,0,,Қашан жоғалды?
Dialogue: 0,0:04:04.63,0:04:05.76,Default,,0,0,0,,Бар, жүр, жүр!
Dialogue: 0,0:04:05.88,0:04:06.80,Default,,0,0,0,,Жасайық!
Dialogue: 0,0:04:07.51,0:04:09.05,Default,,0,0,0,,Әй, не болды?
Dialogue: 0,0:04:09.18,0:04:09.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:10.05,0:04:11.43,Default,,0,0,0,,Барлығы бірден қайда кетті?
Dialogue: 0,0:04:11.76,0:04:13.93,Default,,0,0,0,,Уууу!
Dialogue: 0,0:04:14.23,0:04:16.06,Default,,0,0,0,,Не болды?
Dialogue: 0,0:04:16.19,0:04:18.06,Default,,0,0,0,,Сәлем әпке!
Dialogue: 0,0:04:19.36,0:04:21.32,Default,,0,0,0,,Келіңіз, бізге де көмектесіңіз.
Dialogue: 0,0:04:21.73,0:04:23.07,Default,,0,0,0,,Көмектесу дегенді қалай түсінесіңдер?
Dialogue: 0,0:04:24.53,0:04:26.11,Default,,0,0,0,,Миссия
Dialogue: 0,0:04:27.41,0:04:28.41,Default,,0,0,0,,Эй, сен мұны естідің бе?
Dialogue: 0,0:04:28.53,0:04:30.49,Default,,0,0,0,,Decadence өз қызметін тоқтататын сияқты ма?
Dialogue: 0,0:04:30.62,0:04:32.20,Default,,0,0,0,,Соңғы тапсырма аяқталды.
Dialogue: 0,0:04:32.33,0:04:34.08,Default,,0,0,0,,Жоқ, мен кіріп жатырмын!
Dialogue: 0,0:04:34.20,0:04:35.16,Default,,0,0,0,,Мен де (Киборг) Мен де
Dialogue: 0,0:04:35.29,0:04:36.08,Default,,0,0,0,,Жүгір!
Dialogue: 0,0:04:36.21,0:04:37.58,Default,,0,0,0,,Көпіршікті көпіршік көпіршік...
Dialogue: 0,0:04:39.63,0:04:42.17,Default,,0,0,0,,Иә! Бұл не? Бұл не?
Dialogue: 0,0:04:42.30,0:04:44.55,Default,,0,0,0,,Мен кіруді тоқтата алмаймын!
Dialogue: 0,0:04:44.96,0:04:45.88,Default,,0,0,0,,Шу!
Dialogue: 0,0:04:46.01,0:04:47.55,Default,,0,0,0,,Мына жігіттер (Салли) қандай қауіпті? Біз не істеуіміз керек?
Dialogue: 0,0:04:47.68,0:04:49.26,Default,,0,0,0,,Қызмет тоқтатылды, солай ма? (Салли) О, не істеуіміз керек?
Dialogue: 0,0:04:49.39,0:04:52.01,Default,,0,0,0,,Бірақ мен сенің сезіміңді білемін~ (Сони) Ааа!
Dialogue: 0,0:04:52.14,0:04:57.14,Default,,0,0,0,,♪～
Dialogue: 0,0:05:18.08,0:05:23.09,Default,,0,0,0,,～♪
Dialogue: 0,0:05:24.38,0:05:27.47,Default,,0,0,0,,Иә, солай болды.
Dialogue: 0,0:05:28.42,0:05:32.51,Default,,0,0,0,,Қандай қызықсыз тапсырма.
Dialogue: 0,0:05:33.05,0:05:34.51,Default,,0,0,0,,Сіз мұны істей аласыз!
Dialogue: 0,0:05:35.14,0:05:38.39,Default,,0,0,0,,Оның қарсыласы мен!
Dialogue: 0,0:05:40.81,0:05:42.81,Default,,0,0,0,,Келесі бөлім...
Dialogue: 0,0:05:42.94,0:05:44.77,Default,,0,0,0,,Не? Не болды?
Dialogue: 0,0:05:44.90,0:05:46.65,Default,,0,0,0,,Бұл күтпеген жерден жылдам.
Dialogue: 0,0:05:47.19,0:05:50.66,Default,,0,0,0,,Барлық белсенді емес ойыншылар жүйеге кіріп жатқан сияқты.
Dialogue: 0,0:05:51.61,0:05:52.66,Default,,0,0,0,,... иә?
Dialogue: 0,0:05:52.82,0:05:54.08,Default,,0,0,0,,Yahoo (cyborg) достары
Dialogue: 0,0:05:54.20,0:05:56.41,Default,,0,0,0,,Бұл соңғы (киборг) партия.
Dialogue: 0,0:05:57.08,0:05:58.41,Default,,0,0,0,,Бұл жұмыс істейтін сияқты
Dialogue: 0,0:05:58.75,0:06:02.04,Default,,0,0,0,,Кабураги мырза оны іске қоса алмаса, бұл мүлдем мағынасыз.
Dialogue: 0,0:06:02.17,0:06:05.17,Default,,0,0,0,,Кеңістіктің өзі жоғалады.
Dialogue: 0,0:06:05.29,0:06:06.80,Default,,0,0,0,,Кеңістіктің өзі?
Dialogue: 0,0:06:07.26,0:06:09.72,Default,,0,0,0,,Иә, гадоллдың бәрі.
Dialogue: 0,0:06:09.84,0:06:12.80,Default,,0,0,0,,Уақытымыз аз қалды.
Dialogue: 0,0:06:13.34,0:06:15.01,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:15.35,0:06:17.68,Default,,0,0,0,,Неліктен бастық бастамайды?
Dialogue: 0,0:06:18.02,0:06:19.39,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:06:19.52,0:06:23.48,Default,,0,0,0,,Өйткені, бұрын ешқашан Декаденспен байланысты ештеңе болған емес.
Dialogue: 0,0:06:24.86,0:06:26.36,Default,,0,0,0,,Бастық…
Dialogue: 0,0:06:28.11,0:06:28.99,Default,,0,0,0,,Мен толықтай жазылып кеттім! (Косей) Оу!
Dialogue: 0,0:06:29.40,0:06:31.49,Default,,0,0,0,,Гах! (Киборгтар) Уау!
Dialogue: 0,0:06:31.61,0:06:35.03,Default,,0,0,0,,(киборгтардың айқайы)
Dialogue: 0,0:06:35.16,0:06:36.99,Default,,0,0,0,,Ei (Cyborg) О...
Dialogue: 0,0:06:37.12,0:06:37.95,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:06:38.24,0:06:39.20,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:06:39.33,0:06:40.46,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:45.88,0:06:46.71,Default,,0,0,0,,Не?
Dialogue: 0,0:06:46.84,0:06:47.96,Default,,0,0,0,,Жақындама! Мен саған айттым ғой, оның ашуы тез шығатынын!
Dialogue: 0,0:06:49.38,0:06:51.97,Default,,0,0,0,,Поо... Ахахха!
Dialogue: 0,0:06:53.22,0:06:56.68,Default,,0,0,0,,Кабураги мырзамен жақсы төбелесіп жатырсыз.
Dialogue: 0,0:07:01.85,0:07:04.15,Default,,0,0,0,,Эй (Киборг) Ол қозғала бастады.
Dialogue: 0,0:07:04.27,0:07:07.11,Default,,0,0,0,,Ал, сен ояусың.
Dialogue: 0,0:07:14.20,0:07:15.07,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:07:15.74,0:07:17.83,Default,,0,0,0,,Декаденс күмбезінің сыртында
Dialogue: 0,0:07:18.49,0:07:22.08,Default,,0,0,0,,Бұл бір кездері ақымақ адамдар өмір сүрген қаланың видеосы.
Dialogue: 0,0:07:22.62,0:07:26.00,Default,,0,0,0,,Барлық тіршілік иелері өмір сүре алмайтын жерде
Dialogue: 0,0:07:26.13,0:07:28.38,Default,,0,0,0,,Бұл менің де туған жерім
Dialogue: 0,0:07:28.50,0:07:29.34,Default,,0,0,0,,Не?
Dialogue: 0,0:07:32.01,0:07:34.72,Default,,0,0,0,,Осы ақымақ тарихты қайталамау үшін
Dialogue: 0,0:07:34.84,0:07:37.18,Default,,0,0,0,,Мен жасалдым
Dialogue: 0,0:07:40.43,0:07:43.60,Default,,0,0,0,,Толық басқарудың тәуелсіз жүйесі.
Dialogue: 0,0:07:44.10,0:07:45.56,Default,,0,0,0,,Сіз жүйе болдыңыз ба?
Dialogue: 0,0:07:46.02,0:07:47.23,Default,,0,0,0,,Хугин Мунин
Dialogue: 0,0:07:47.36,0:07:50.36,Default,,0,0,0,,Жүйенің қызмет ету мерзімін жүзеге асыратын аяқ киім
Dialogue: 0,0:07:50.48,0:07:53.07,Default,,0,0,0,,Жүйенің өзінде ешқандай субстанция жоқ.
Dialogue: 0,0:07:53.65,0:07:54.57,Default,,0,0,0,,Бұл не үшін?
Dialogue: 0,0:07:54.70,0:07:57.12,Default,,0,0,0,,Неліктен бекер күресеміз?
Dialogue: 0,0:07:57.24,0:08:00.20,Default,,0,0,0,,Гадоллды декаденспен жеңу мүмкін емес.
Dialogue: 0,0:08:00.33,0:08:02.08,Default,,0,0,0,,Сіз мұны да білесіз бе?
Dialogue: 0,0:08:03.16,0:08:05.54,Default,,0,0,0,,Бұл мен бас тартпаймын деген сөз емес.
Dialogue: 0,0:08:05.67,0:08:07.58,Default,,0,0,0,,Маған Decadence бақылауын беріңіз.
Dialogue: 0,0:08:12.30,0:08:14.80,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:08:15.30,0:08:16.72,Default,,0,0,0,,Сіз мені қате деп мазалайсыз ба?
Dialogue: 0,0:08:17.30,0:08:19.10,Default,,0,0,0,,Жүйенің шын мағынасында
Dialogue: 0,0:08:19.22,0:08:21.51,Default,,0,0,0,,Қателердің бар екені расталды.
Dialogue: 0,0:08:21.64,0:08:22.47,Default,,0,0,0,,Не?
Dialogue: 0,0:08:22.68,0:08:24.81,Default,,0,0,0,,Қателерді жою әрекеті
Dialogue: 0,0:08:24.93,0:08:26.60,Default,,0,0,0,,Оған қарсы болғандар
Dialogue: 0,0:08:26.73,0:08:30.73,Default,,0,0,0,,Екі жақтың әрекетінің өзі жүйенің бір бөлігі.
Dialogue: 0,0:08:30.86,0:08:32.61,Default,,0,0,0,,және әрекеттің салдары
Dialogue: 0,0:08:32.86,0:08:35.86,Default,,0,0,0,,Күшті жүйе құрылды
Dialogue: 0,0:08:36.82,0:08:39.74,Default,,0,0,0,,Жүйелер деректерді әмбебап сақтайды.
Dialogue: 0,0:08:39.87,0:08:42.87,Default,,0,0,0,,Өзгеріс уақыты келгенде, ол жаңартылады.
Dialogue: 0,0:08:43.58,0:08:45.87,Default,,0,0,0,,Бұл бірнеше рет жасалды
Dialogue: 0,0:08:46.58,0:08:49.88,Default,,0,0,0,,Қазіргі уақытта болып жатқан оқиғалар жүйеге арналған
Dialogue: 0,0:08:50.00,0:08:53.30,Default,,0,0,0,,Үлкен ағынның бір бөлігі ғана
Dialogue: 0,0:08:53.46,0:08:57.13,Default,,0,0,0,,Қазір әлем үлкен өзгерістер уақытын күтіп тұр.
Dialogue: 0,0:08:57.59,0:09:00.14,Default,,0,0,0,,Сіз күресуге тырысатын әрекеттер
Dialogue: 0,0:09:00.51,0:09:02.72,Default,,0,0,0,,Жүйенің бір бөлігі ғана
Dialogue: 0,0:09:02.85,0:09:04.35,Default,,0,0,0,,Қанша күрессең де
Dialogue: 0,0:09:04.47,0:09:07.64,Default,,0,0,0,,Біз бұл үлкен трендті өзгерте алмаймыз.
Dialogue: 0,0:09:09.23,0:09:11.90,Default,,0,0,0,,Өзгеремін деп қорқасыз ба?
Dialogue: 0,0:09:12.06,0:09:12.90,Default,,0,0,0,,Хмм…
Dialogue: 0,0:09:13.19,0:09:16.53,Default,,0,0,0,,Мен өз еркіммен ғана күресемін.
Dialogue: 0,0:09:16.74,0:09:18.78,Default,,0,0,0,,Жүйенің ыңғайлылығы маңызды емес.
Dialogue: 0,0:09:19.24,0:09:21.53,Default,,0,0,0,,Бастық! Сіз мені естисіз, солай ма?
Dialogue: 0,0:09:21.78,0:09:25.04,Default,,0,0,0,,Сіз осындай сәтте бас тартасыз ба? Бастық!
Dialogue: 0,0:09:25.83,0:09:28.75,Default,,0,0,0,,Мені құтқарған Нацумэ есімді адам
Dialogue: 0,0:09:28.87,0:09:30.54,Default,,0,0,0,,Ол сондай жігіт.
Dialogue: 0,0:09:30.83,0:09:33.04,Default,,0,0,0,,Жүйе ешкімді құтқармайды
Dialogue: 0,0:09:33.50,0:09:34.50,Default,,0,0,0,,Тек...
Dialogue: 0,0:09:34.71,0:09:38.30,Default,,0,0,0,,Бұл жай ғана заттардың нәтижесіне қарай өзгеретін нәрсе.
Dialogue: 0,0:09:38.88,0:09:40.26,Default,,0,0,0,,Өмір сүру дегеніміз
Dialogue: 0,0:09:40.59,0:09:42.43,Default,,0,0,0,,Бастық!
Dialogue: 0,0:09:42.80,0:09:43.93,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:09:45.64,0:09:46.93,Default,,0,0,0,,Уф! (Оң қолдың сынған дыбысы)
Dialogue: 0,0:09:50.65,0:09:52.15,Default,,0,0,0,,Аузыңды жап, қара!
Dialogue: 0,0:09:52.52,0:09:53.52,Default,,0,0,0,,Хун
Dialogue: 0,0:09:54.44,0:09:56.15,Default,,0,0,0,,Қанша күрессем де
Dialogue: 0,0:09:56.28,0:09:57.53,Default,,0,0,0,,Сен өлесің
Dialogue: 0,0:09:57.65,0:10:01.99,Default,,0,0,0,,Дүниедегі өзгерістерді көре алмайтынымыз өкінішті.
Dialogue: 0,0:10:02.95,0:10:03.70,Default,,0,0,0,,Әй!
Dialogue: 0,0:10:06.99,0:10:07.83,Default,,0,0,0,,Шу таза...
Dialogue: 0,0:10:08.33,0:10:11.08,Default,,0,0,0,,Commander Decadence қайтадан бақылауға алынды.
Dialogue: 0,0:10:15.21,0:10:16.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:17.38,0:10:19.59,Default,,0,0,0,,Қайырлы таң, бастық!
Dialogue: 0,0:10:21.09,0:10:23.64,Default,,0,0,0,,Шалғам Күтуден шаршадым.
Dialogue: 0,0:10:23.76,0:10:24.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:25.22,0:10:27.97,Default,,0,0,0,,Декаденс іске қосылды!
Dialogue: 0,0:10:32.56,0:10:34.77,Default,,0,0,0,,Декаденс іске қосылды!
Dialogue: 0,0:10:37.07,0:10:39.53,Default,,0,0,0,,Шақалақ Сіз жағдайды түсіне аласыз ба?
Dialogue: 0,0:10:39.69,0:10:42.07,Default,,0,0,0,,А, бірақ сәл күте тұрыңыз.
Dialogue: 0,0:10:42.20,0:10:44.20,Default,,0,0,0,,Тым көп ақпарат...
Dialogue: 0,0:10:44.78,0:10:46.20,Default,,0,0,0,,Картадағы нүктелерге қараңыз
Dialogue: 0,0:10:47.16,0:10:51.25,Default,,0,0,0,,Ескі бөліктерді қосып, оларды тануға мүмкіндік бересіз бе?
Dialogue: 0,0:10:51.37,0:10:53.21,Default,,0,0,0,,О, мен оны жинап алайыншы.
Dialogue: 0,0:10:53.54,0:10:54.54,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:10:54.67,0:10:56.46,Default,,0,0,0,,Алдымен аймақты кеңейтейік.
Dialogue: 0,0:10:56.79,0:10:58.96,Default,,0,0,0,,Жарайды, вампир гарпунын өрте!
Dialogue: 0,0:11:09.06,0:11:11.23,Default,,0,0,0,,Гадолл Омега аймағын кеңейту
Dialogue: 0,0:11:12.06,0:11:14.19,Default,,0,0,0,,Иә? Уа, уай, ау!
Dialogue: 0,0:11:14.77,0:11:17.36,Default,,0,0,0,,Декаденс Бөлшектерді жинаңыз!
Dialogue: 0,0:11:25.45,0:11:27.20,Default,,0,0,0,,Жалған жарық бағыттаушы талшық...
Dialogue: 0,0:11:27.33,0:11:28.99,Default,,0,0,0,,Тірі зат сияқты
Dialogue: 0,0:11:32.54,0:11:33.75,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:34.04,0:11:35.25,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:11:35.54,0:11:36.58,Default,,0,0,0,,Керемет! (Киборг) Бұл әдемі.
Dialogue: 0,0:11:36.71,0:11:38.04,Default,,0,0,0,,Хмм... сәл тар!
Dialogue: 0,0:11:48.26,0:11:49.01,Default,,0,0,0,,Не?
Dialogue: 0,0:11:49.14,0:11:49.89,Default,,0,0,0,,Ябба!
Dialogue: 0,0:11:50.01,0:11:51.52,Default,,0,0,0,,Керемет, жүр!
Dialogue: 0,0:11:53.89,0:11:56.48,Default,,0,0,0,,Бірінен соң бірі... Бөлшектер...
Dialogue: 0,0:11:56.60,0:11:57.52,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:11:58.48,0:11:59.73,Default,,0,0,0,,Бұл не? Мен байланғанмын.
Dialogue: 0,0:11:59.98,0:12:01.28,Default,,0,0,0,,Сіз мұны істей аласыз!
Dialogue: 0,0:12:04.82,0:12:07.53,Default,,0,0,0,,Бұл декаденс пе?
Dialogue: 0,0:12:13.41,0:12:16.04,Default,,0,0,0,,Омега ішінде оксон энергиясының жоғары концентрациясы анықталды
Dialogue: 0,0:12:16.50,0:12:18.04,Default,,0,0,0,,Жоқ! Шалғам!
Dialogue: 0,0:12:18.33,0:12:20.88,Default,,0,0,0,,Ол қазірдің өзінде толық қуатта. Біз үлгере алмаймыз!
Dialogue: 0,0:12:24.22,0:12:25.17,Default,,0,0,0,,Бұл...
Dialogue: 0,0:12:25.30,0:12:26.63,Default,,0,0,0,,Тағы да
Dialogue: 0,0:12:26.97,0:12:28.93,Default,,0,0,0,,Қат! Осы уакытқа дейін?
Dialogue: 0,0:12:29.05,0:12:29.80,Default,,0,0,0,,Әй!
Dialogue: 0,0:12:32.31,0:12:33.72,Default,,0,0,0,,Гах ха ха!
Dialogue: 0,0:12:34.56,0:12:35.56,Default,,0,0,0,,Донателло? не?
Dialogue: 0,0:12:35.85,0:12:38.56,Default,,0,0,0,,Жалқау болма, Балапан!
Dialogue: 0,0:12:39.19,0:12:41.23,Default,,0,0,0,,Жолдан кет!
Dialogue: 0,0:12:41.36,0:12:44.07,Default,,0,0,0,,Маған кедергі жасама
Dialogue: 0,0:12:44.24,0:12:46.07,Default,,0,0,0,,Хмм, не? Не?
Dialogue: 0,0:12:46.20,0:12:47.82,Default,,0,0,0,,Сіз не істемексіз? Сол жігіт
Dialogue: 0,0:12:47.99,0:12:49.20,Default,,0,0,0,,Уау! (Киборг) Босс!
Dialogue: 0,0:12:49.32,0:12:52.83,Default,,0,0,0,,Тек маңдай бөлігінің тізбегі бұзылған.
Dialogue: 0,0:12:55.83,0:12:57.58,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:13:02.88,0:13:04.42,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:06.59,0:13:07.97,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:08.09,0:13:09.39,Default,,0,0,0,,Жақсы! (Киборг) Неге?
Dialogue: 0,0:13:13.93,0:13:15.89,Default,,0,0,0,,Уау! Жүгіріп кету!
Dialogue: 0,0:13:16.14,0:13:17.35,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:18.23,0:13:19.15,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:13:20.48,0:13:21.94,Default,,0,0,0,,Омега тыныштығы
Dialogue: 0,0:13:22.06,0:13:25.15,Default,,0,0,0,,Ұстау бөліктері қосылым аяқталғанша 10% қалды
Dialogue: 0,0:13:25.61,0:13:28.15,Default,,0,0,0,,Жарайды, параллель ұшыруға дайындалайық.
Dialogue: 0,0:13:28.28,0:13:30.28,Default,,0,0,0,,Түн ортасында әлі де 36 сағат.
Dialogue: 0,0:13:30.41,0:13:31.66,Default,,0,0,0,,Егер бізге шабуыл жасалса, онда
Dialogue: 0,0:13:32.03,0:13:33.62,Default,,0,0,0,,Сіз кереметсіз
Dialogue: 0,0:13:33.74,0:13:35.66,Default,,0,0,0,,Өйткені, бастық ғажап
Dialogue: 0,0:13:35.87,0:13:39.87,Default,,0,0,0,,Барлығымыз Саркозидің ішімдігімен тост айтайық.
Dialogue: 0,0:13:40.29,0:13:41.50,Default,,0,0,0,,Апай?
Dialogue: 0,0:13:41.79,0:13:42.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:43.04,0:13:44.38,Default,,0,0,0,,Не? (Киборг) А...
Dialogue: 0,0:13:44.50,0:13:46.01,Default,,0,0,0,,Балалар, сендер не қарап тұрсыңдар?
Dialogue: 0,0:13:46.13,0:13:47.34,Default,,0,0,0,,Ннуну...
Dialogue: 0,0:13:47.47,0:13:48.63,Default,,0,0,0,,Ка-пе
Dialogue: 0,0:13:48.97,0:13:50.51,Default,,0,0,0,,А? Дұрыс па?
Dialogue: 0,0:13:50.63,0:13:52.05,Default,,0,0,0,,Шобо... (Киборг) Жоқ.
Dialogue: 0,0:13:52.18,0:13:53.22,Default,,0,0,0,,Пепе Пепе (Киборг) №
Dialogue: 0,0:13:53.35,0:13:54.10,Default,,0,0,0,,Жоқ! (Киборг) Мүмкін емес
Dialogue: 0,0:13:54.22,0:13:55.22,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:13:55.35,0:13:56.10,Default,,0,0,0,,Я...
Dialogue: 0,0:13:56.22,0:13:57.39,Default,,0,0,0,,Мен не айта аламын?
Dialogue: 0,0:13:59.81,0:14:01.15,Default,,0,0,0,,Барлық бөлшектер бекітілген
Dialogue: 0,0:14:01.44,0:14:02.27,Default,,0,0,0,,Жарайды
Dialogue: 0,0:14:02.40,0:14:04.27,Default,,0,0,0,,Шалғам Мен сені шекке тартамын.
Dialogue: 0,0:14:04.40,0:14:05.15,Default,,0,0,0,,О
Dialogue: 0,0:14:05.69,0:14:07.36,Default,,0,0,0,,Декаденс зеңбіректерінің тұтануы
Dialogue: 0,0:14:14.66,0:14:16.87,Default,,0,0,0,,Омега әрекетті жалғастырады
Dialogue: 0,0:14:17.66,0:14:19.46,Default,,0,0,0,,Балапан Дайынсың ба?
Dialogue: 0,0:14:19.58,0:14:20.41,Default,,0,0,0,,О
Dialogue: 0,0:14:20.54,0:14:21.46,Default,,0,0,0,,Әй!
Dialogue: 0,0:14:21.75,0:14:22.71,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:29.05,0:14:29.88,Default,,0,0,0,,Нацумэ!
Dialogue: 0,0:14:30.47,0:14:32.13,Default,,0,0,0,,Бұл не? (Оператор) Қосалқы бөлшектер.
Dialogue: 0,0:14:32.51,0:14:33.59,Default,,0,0,0,,Мұның қажеті жоқ.
Dialogue: 0,0:14:33.72,0:14:35.22,Default,,0,0,0,,Ол жерден тез кет!
Dialogue: 0,0:14:35.72,0:14:37.72,Default,,0,0,0,,Тұр!
Dialogue: 0,0:14:38.31,0:14:40.35,Default,,0,0,0,,Тұр! Тұр!
Dialogue: 0,0:14:40.48,0:14:42.23,Default,,0,0,0,,Оооххх!
Dialogue: 0,0:14:42.60,0:14:43.90,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:44.02,0:14:45.23,Default,,0,0,0,,Нацумэ!
Dialogue: 0,0:14:45.61,0:14:46.98,Default,,0,0,0,,Тым қобалжымаңыз
Dialogue: 0,0:14:47.36,0:14:48.48,Default,,0,0,0,,Күренай-сан
Dialogue: 0,0:14:48.61,0:14:50.95,Default,,0,0,0,,Мұндай затты өз бетіңізше алып жүру мүмкін емес!
Dialogue: 0,0:14:51.07,0:14:52.11,Default,,0,0,0,,Хмм! Ха!
Dialogue: 0,0:14:52.49,0:14:54.37,Default,,0,0,0,,Ауыр жүкті маған қалдыр!
Dialogue: 0,0:14:54.62,0:14:56.74,Default,,0,0,0,,Сіз ұрыс алаңын ұнатпаймын дедіңіз ғой, солай ма?
Dialogue: 0,0:14:56.87,0:14:58.66,Default,,0,0,0,,(Изуку) Качан… әдетте оң қолымен мықты соққы жасап бастайды
Dialogue: 0,0:14:58.99,0:15:00.58,Default,,0,0,0,,…қашып кету…
Dialogue: 0,0:15:02.79,0:15:04.63,Default,,0,0,0,,Уууу!
Dialogue: 0,0:15:05.50,0:15:07.84,Default,,0,0,0,,Бір нәрсені дұрыс істемеу
Dialogue: 0,0:15:08.00,0:15:09.13,Default,,0,0,0,,Фу…
Dialogue: 0,0:15:11.13,0:15:12.13,Default,,0,0,0,,Су астында беткі қабаттан әрбір 10 метрге тереңдеген сайын—
Dialogue: 0,0:15:12.26,0:15:13.63,Default,,0,0,0,,Уау уау...
Dialogue: 0,0:15:13.76,0:15:15.93,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:16.72,0:15:18.89,Default,,0,0,0,,... декаденцияда?
Dialogue: 0,0:15:19.01,0:15:20.56,Default,,0,0,0,,Бастық…
Dialogue: 0,0:15:21.73,0:15:23.19,Default,,0,0,0,,Сол жерде қалмаңыз.
Dialogue: 0,0:15:25.02,0:15:27.15,Default,,0,0,0,,Decadence Іске қосуға дайын
Dialogue: 0,0:15:27.27,0:15:28.69,Default,,0,0,0,,Шалғам Енді ешқашан
Dialogue: 0,0:15:28.90,0:15:29.73,Default,,0,0,0,,Оны шешпеңіз
Dialogue: 0,0:15:29.86,0:15:30.69,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:15:31.07,0:15:33.57,Default,,0,0,0,,Кеңістікті сығу құрылғысының іске қосылуына 90 минут қалды
Dialogue: 0,0:15:36.03,0:15:37.32,Default,,0,0,0,,Мені ұр!
Dialogue: 0,0:15:40.83,0:15:45.83,Default,,0,0,0,,♪～
Dialogue: 0,0:15:46.08,0:15:48.04,Default,,0,0,0,,…
Dialogue: 0,0:15:48.75,0:15:50.21,Default,,0,0,0,,Өлмейтін? Сол жігіт
Dialogue: 0,0:15:50.34,0:15:51.51,Default,,0,0,0,,Шығаруды одан да арттырыңыз
Dialogue: 0,0:15:52.17,0:15:55.51,Default,,0,0,0,,Менің енді қолымнан келмейді... Оксон жетпейді.
Dialogue: 0,0:15:56.30,0:15:57.18,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:15:57.51,0:15:59.31,Default,,0,0,0,,Тәтті... Мм! (шу)
Dialogue: 0,0:16:05.48,0:16:06.94,Default,,0,0,0,,Ах (Киборг) Бұл қауіпті!
Dialogue: 0,0:16:07.06,0:16:08.19,Default,,0,0,0,,Сәттілік~
Dialogue: 0,0:16:08.48,0:16:10.77,Default,,0,0,0,,Декаденстің аяқталуына жол бермеңіз!
Dialogue: 0,0:16:10.90,0:16:11.69,Default,,0,0,0,,Жеңіліс!
Dialogue: 0,0:16:11.98,0:16:12.99,Default,,0,0,0,,Бұл жасырын.
Dialogue: 0,0:16:13.11,0:16:14.19,Default,,0,0,0,,Баланың биі...
Dialogue: 0,0:16:14.32,0:16:15.20,Default,,0,0,0,,Жоғалтып алмаңыз!
Dialogue: 0,0:16:15.45,0:16:17.20,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:17.45,0:16:19.20,Default,,0,0,0,,Уау...
Dialogue: 0,0:16:23.04,0:16:24.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:24.87,0:16:26.17,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:16:28.08,0:16:31.34,Default,,0,0,0,,Бітті деме, берілме!
Dialogue: 0,0:16:31.96,0:16:35.72,Default,,0,0,0,,Мен күшейіп, «сол күшке» қосыламын!
Dialogue: 0,0:16:36.63,0:16:38.72,Default,,0,0,0,,Мен шештім
Dialogue: 0,0:16:39.60,0:16:42.97,Default,,0,0,0,,Мен өзімді шектен шығарамын
Dialogue: 0,0:16:44.18,0:16:47.23,Default,,0,0,0,,Сондықтан мен бар күшімді салуым керек...
Dialogue: 0,0:16:47.52,0:16:50.98,Default,,0,0,0,,Маған көбірек көмектесу керек...
Dialogue: 0,0:16:51.19,0:16:52.36,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:16:52.98,0:16:56.49,Default,,0,0,0,,Мен білетін бастыққа сенемін деп шештім.
Dialogue: 0,0:17:10.38,0:17:15.38,Default,,0,0,0,,～♪
Dialogue: 0,0:17:20.47,0:17:22.22,Default,,0,0,0,,Декадентті шектегіштің шығарылуы
Dialogue: 0,0:17:22.39,0:17:23.22,Default,,0,0,0,,Шалғам!
Dialogue: 0,0:17:24.52,0:17:25.89,Default,,0,0,0,,Жүзбе…
Dialogue: 0,0:17:26.31,0:17:28.52,Default,,0,0,0,,Сіз шулысыз.
Dialogue: 0,0:17:28.73,0:17:30.27,Default,,0,0,0,,Мен сізге бұрын айтқанмын.
Dialogue: 0,0:17:33.19,0:17:38.24,Default,,0,0,0,,Мен бәрін құртамын!
Dialogue: 0,0:17:45.04,0:17:49.50,Default,,0,0,0,,Джуууууу...
Dialogue: 0,0:18:06.81,0:18:08.02,Default,,0,0,0,,Сооо...
Dialogue: 0,0:18:08.31,0:18:09.27,Default,,0,0,0,,Яба…
Dialogue: 0,0:18:09.39,0:18:11.23,Default,,0,0,0,,Мен жасадым... дұрыс па?
Dialogue: 0,0:18:11.35,0:18:13.31,Default,,0,0,0,,Аа, солай көрінеді...
Dialogue: 0,0:18:13.86,0:18:14.77,Default,,0,0,0,,Уау
Dialogue: 0,0:18:14.90,0:18:16.57,Default,,0,0,0,,Ууууах!
Dialogue: 0,0:18:19.07,0:18:20.57,Default,,0,0,0,,О... мен жасадым.
Dialogue: 0,0:18:20.78,0:18:22.53,Default,,0,0,0,,Уау, сіз оны уақытында орындадыңыз!
Dialogue: 0,0:18:22.66,0:18:23.70,Default,,0,0,0,,Жақсы
Dialogue: 0,0:18:24.70,0:18:25.99,Default,,0,0,0,,Я...
Dialogue: 0,0:18:26.91,0:18:29.33,Default,,0,0,0,,Барлығы, жүйеден шығыңыз, құлайсыз.
Dialogue: 0,0:18:30.12,0:18:31.83,Default,,0,0,0,,Ол мұны істеді!
Dialogue: 0,0:18:31.96,0:18:33.33,Default,,0,0,0,,Балапан биі жеңеді
Dialogue: 0,0:18:33.46,0:18:34.75,Default,,0,0,0,,Уау...
Dialogue: 0,0:18:34.88,0:18:35.63,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:35.96,0:18:37.76,Default,,0,0,0,,Баланың биі...
Dialogue: 0,0:18:41.72,0:18:45.14,Default,,0,0,0,,Қателер әлі де қызықты.
Dialogue: 0,0:18:45.51,0:18:46.56,Default,,0,0,0,,Жетті. Мен сені де, әпкеңді де өлтіремін.
Dialogue: 0,0:18:46.68,0:18:47.85,Default,,0,0,0,,Бұл...
Dialogue: 0,0:18:47.97,0:18:51.14,Default,,0,0,0,,Декаденс ыдырап жатыр...
Dialogue: 0,0:18:57.19,0:18:58.73,Default,,0,0,0,,Бастық…
Dialogue: 0,0:19:01.78,0:19:04.41,Default,,0,0,0,,Көріскенше Нацумэ
Dialogue: 0,0:19:12.66,0:19:16.09,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:19:16.21,0:19:17.54,Default,,0,0,0,,Мұнда? О
Dialogue: 0,0:19:17.67,0:19:19.17,Default,,0,0,0,,Күмән жоқ
Dialogue: 0,0:19:19.51,0:19:20.71,Default,,0,0,0,,Біз тек сүйіскендей боламыз.
Dialogue: 0,0:19:21.59,0:19:22.42,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:23.26,0:19:24.93,Default,,0,0,0,,Рахмет
Dialogue: 0,0:19:27.43,0:19:29.52,Default,,0,0,0,,Бастық, кешіріңіз.
Dialogue: 0,0:19:29.77,0:19:33.23,Default,,0,0,0,,Менің жасаған оң қолым сынды.
Dialogue: 0,0:19:33.69,0:19:36.44,Default,,0,0,0,,Мен оны қазірден бастап өзім қалпына келтіремін.
Dialogue: 0,0:19:37.61,0:19:40.32,Default,,0,0,0,,Мен сенімдімін...
Dialogue: 0,0:19:42.15,0:19:43.11,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:44.24,0:19:46.95,Default,,0,0,0,,(Шұғылдың құлау дыбысы)
Dialogue: 0,0:19:51.91,0:19:53.71,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:19:53.83,0:19:58.84,Default,,0,0,0,,♪～
Dialogue: 0,0:20:13.02,0:20:14.39,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:20:14.52,0:20:17.15,Default,,0,0,0,,О, сіз оны жақсы таптыңыз.
Dialogue: 0,0:20:17.27,0:20:20.15,Default,,0,0,0,,Ол шашыраңқы бөліктердің қоқыстарына көмілген.
Dialogue: 0,0:20:20.27,0:20:21.86,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:20:22.15,0:20:24.86,Default,,0,0,0,,Мен көп нәрсені сұрайтын адаммын.
Dialogue: 0,0:20:25.03,0:20:27.24,Default,,0,0,0,,Менен сұрамасаң да істеймін.
Dialogue: 0,0:20:27.36,0:20:31.08,Default,,0,0,0,,Қателер әрқашан менің зерттеуімнің тақырыбы болды.
Dialogue: 0,0:20:31.45,0:20:33.62,Default,,0,0,0,,Жоғарғы әкімші туралы не деуге болады?
Dialogue: 0,0:20:33.95,0:20:36.17,Default,,0,0,0,,Проблемалар көп.
Dialogue: 0,0:20:36.29,0:20:39.13,Default,,0,0,0,,Менің қолымнан көп нәрсе келмейді.
Dialogue: 0,0:20:39.25,0:20:43.09,Default,,0,0,0,,Біз жаңа жүйені егжей-тегжейлі жаңартамыз.
Dialogue: 0,0:20:43.21,0:20:44.97,Default,,0,0,0,,Ол жұмысты да сол екеуіне қалдырамын.
Dialogue: 0,0:20:44.97,0:20:46.55,Default,,0,0,0,,Ол жұмысты да сол екеуіне қалдырамын.
Dialogue: 0,0:20:44.97,0:20:46.55,Default,,0,0,0,,(Сонидің ашулы дауысы)
Dialogue: 0,0:20:46.55,0:20:46.63,Default,,0,0,0,,(Сонидің ашулы дауысы)
Dialogue: 0,0:20:46.88,0:20:48.05,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:48.30,0:20:49.64,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:20:50.35,0:20:51.76,Default,,0,0,0,,Менің ойымша
Dialogue: 0,0:20:52.26,0:20:55.39,Default,,0,0,0,,Міне, менің жинағаным осы ғана.
Dialogue: 0,0:20:55.85,0:20:56.73,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:20:56.85,0:20:58.65,Default,,0,0,0,,Әртүрлі үлгі деректер.
Dialogue: 0,0:20:59.06,0:21:01.02,Default,,0,0,0,,Гадолл боқының ингредиенттер тізімі.
Dialogue: 0,0:21:01.15,0:21:02.77,Default,,0,0,0,,Оксон ликерінің рецепті
Dialogue: 0,0:21:02.90,0:21:04.44,Default,,0,0,0,,Донателломен қалай әрекет ету керек
Dialogue: 0,0:21:04.57,0:21:06.40,Default,,0,0,0,,Джосукенің әкесіне —
Dialogue: 0,0:21:07.07,0:21:07.91,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:21:08.86,0:21:10.99,Default,,0,0,0,,А... Мен сенімдімін...
Dialogue: 0,0:21:11.83,0:21:15.04,Default,,0,0,0,,Сол кезде Кабураги-санды жаңартқанда.
Dialogue: 0,0:21:15.16,0:21:18.00,Default,,0,0,0,,Үлгі ретінде сақтық көшірме жасау…
Dialogue: 0,0:21:15.16,0:21:18.00,Default,,0,0,0,,～♪
Dialogue: 0,0:21:18.00,0:21:18.42,Default,,0,0,0,,～♪
Dialogue: 0,0:21:18.42,0:21:19.25,Default,,0,0,0,,～♪
Dialogue: 0,0:21:18.42,0:21:19.25,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:20.63,0:21:21.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:23.30,0:21:25.26,Default,,0,0,0,,Уау! (Кайборг) О, менің!
Dialogue: 0,0:21:25.63,0:21:27.97,Default,,0,0,0,,Дұрыс, дұрыс
Dialogue: 0,0:21:29.18,0:21:31.05,Default,,0,0,0,,Қайта туылған декаденция
Dialogue: 0,0:21:31.18,0:21:33.31,Default,,0,0,0,,Әртүрлі салаларға бөлінді.
Dialogue: 0,0:21:33.43,0:21:34.97,Default,,0,0,0,,Ойын-сауық кешені
Dialogue: 0,0:21:35.31,0:21:38.64,Default,,0,0,0,,Ферма аймағындағы сүйікті ауылшаруашылық құралдарын реттеңіз.
Dialogue: 0,0:21:39.23,0:21:40.23,Default,,0,0,0,,Танкермен
Dialogue: 0,0:21:40.35,0:21:42.86,Default,,0,0,0,,Егін көп өсірейік
Dialogue: 0,0:21:43.90,0:21:45.78,Default,,0,0,0,,Декаденстің өзегі жаңартылды.
Dialogue: 0,0:21:45.90,0:21:47.40,Default,,0,0,0,,Аттракцион аймағында
Dialogue: 0,0:21:47.61,0:21:50.99,Default,,0,0,0,,Үнемі өзгеретін салмақсыз негізгі допты тамашалаңыз
Dialogue: 0,0:21:51.11,0:21:52.53,Default,,0,0,0,,Жүр! О, менің!
Dialogue: 0,0:21:53.12,0:21:54.08,Default,,0,0,0,,Хахаха!
Dialogue: 0,0:21:54.53,0:21:56.12,Default,,0,0,0,,Жасайық
Dialogue: 0,0:21:56.95,0:21:58.08,Default,,0,0,0,,Сіз елді дүр сілкіндіре білген ардагер орындаушы ретінде әйгілісіз, иә?
Dialogue: 0,0:21:58.79,0:22:01.08,Default,,0,0,0,,Ұрысты ұмытуға болмайды.
Dialogue: 0,0:22:01.21,0:22:02.04,Default,,0,0,0,,Қан атқылау, ет секіру
Dialogue: 0,0:22:02.04,0:22:03.09,Default,,0,0,0,,Қан атқылап, ет секірді Хааа!
Dialogue: 0,0:22:03.54,0:22:04.63,Default,,0,0,0,,Ең керемет жекпе-жек!
Dialogue: 0,0:22:04.63,0:22:05.63,Default,,0,0,0,,Ең керемет жекпе-жек! (Көрермендер) Уууу!
Dialogue: 0,0:22:05.63,0:22:06.09,Default,,0,0,0,,Уууу!
Dialogue: 0,0:22:06.92,0:22:09.68,Default,,0,0,0,,Тоқтап, қараңызшы.
Dialogue: 0,0:22:10.05,0:22:12.22,Default,,0,0,0,,Эй, сен маған көмектесе аласың!
Dialogue: 0,0:22:12.34,0:22:13.18,Default,,0,0,0,,Аха…
Dialogue: 0,0:22:13.76,0:22:15.68,Default,,0,0,0,,Ғажайып Гадоль аймағында
Dialogue: 0,0:22:15.81,0:22:17.72,Default,,0,0,0,,Осы сүйкімді адамдармен қайта қауышу
Dialogue: 0,0:22:17.85,0:22:19.69,Default,,0,0,0,,Гадолмен қауіпсіз әрекеттесіңіз
Dialogue: 0,0:22:20.06,0:22:20.23,Default,,0,0,0,,Менің Гадоллымды да көтеруге болады
Dialogue: 0,0:22:20.23,0:22:22.60,Default,,0,0,0,,Менің Гадоллымды да көтеруге болады
Dialogue: 0,0:22:20.23,0:22:22.60,Default,,0,0,0,,Иә...
Dialogue: 0,0:22:22.73,0:22:23.90,Default,,0,0,0,,Эй, сен тағы да келдің бе?
Dialogue: 0,0:22:24.02,0:22:26.02,Default,,0,0,0,,Ах, Итата... Шашымды жеме.
Dialogue: 0,0:22:26.15,0:22:28.19,Default,,0,0,0,,Ахаха... сүйкімді
Dialogue: 0,0:22:28.53,0:22:30.74,Default,,0,0,0,,Тұрғын ауданның бұрынғы танк қаласы
Dialogue: 0,0:22:30.86,0:22:33.82,Default,,0,0,0,,Бірдей ерекшеліктерімен айтарлықтай жаңару
Dialogue: 0,0:22:33.95,0:22:35.95,Default,,0,0,0,,Сіз киборгтарды да, танкерлерді де тамашалай аласыз.
Dialogue: 0,0:22:36.08,0:22:38.41,Default,,0,0,0,,Жаңа қалаға қош келдіңіз
Dialogue: 0,0:22:39.91,0:22:43.17,Default,,0,0,0,,Басқа әрекеттердің қатарында
Dialogue: 0,0:22:43.29,0:22:46.96,Default,,0,0,0,,Ең танымал кен орнын барлау - ең жақсы жады
Dialogue: 0,0:22:47.09,0:22:47.84,Default,,0,0,0,,Әй!
Dialogue: 0,0:22:55.55,0:22:57.35,Default,,0,0,0,,Біріншісі – сараймен байланысты адамдардың сеніміне ие болу.
Dialogue: 0,0:23:09.65,0:23:11.40,Default,,0,0,0,,Қош бол әпке
Dialogue: 0,0:23:11.53,0:23:13.36,Default,,0,0,0,,Көңілді болды. Жуықта көріскенше.
Dialogue: 0,0:23:13.70,0:23:17.20,Default,,0,0,0,,Иә, рахмет, қайта келіңіз.
Dialogue: 0,0:23:18.16,0:23:22.33,Default,,0,0,0,,Олай болса, бүгінгі қажырлы еңбектеріңізге рахмет.
Dialogue: 0,0:23:23.79,0:23:25.25,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:23:30.01,0:23:30.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:36.05,0:23:37.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:38.68,0:23:40.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:41.56,0:23:42.93,Default,,0,0,0,,Ах!
Dialogue: 0,0:23:44.39,0:23:46.35,Default,,0,0,0,,Ах!
Dialogue: 0,0:23:47.85,0:23:53.85,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory