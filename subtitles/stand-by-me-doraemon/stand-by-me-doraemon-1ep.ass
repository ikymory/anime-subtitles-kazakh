Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:24.77,0:00:29.40,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:00:36.74,0:00:37.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:37.91,0:00:39.53,Default,,0,0,0,,Нобита-сан
Dialogue: 0,0:00:39.66,0:00:40.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:40.91,0:00:42.70,Default,,0,0,0,,Мұнда
Dialogue: 0,0:00:44.25,0:00:45.71,Default,,0,0,0,,Шизука-чан
Dialogue: 0,0:00:45.83,0:00:48.29,Default,,0,0,0,,Уфуфу, бұл қызық.
Dialogue: 0,0:00:48.42,0:00:51.71,Default,,0,0,0,,Иә! Уау хахаха
Dialogue: 0,0:00:51.84,0:00:53.47,Default,,0,0,0,,Тез, тез
Dialogue: 0,0:00:53.59,0:00:57.01,Default,,0,0,0,,Хахаха... Күте тұрыңыз, Шизука-чан
Dialogue: 0,0:00:57.14,0:01:00.18,Default,,0,0,0,,Нобита, ерте тұр.
Dialogue: 0,0:01:00.31,0:01:02.81,Default,,0,0,0,,Менің енді таңғы ас ішуге уақытым жоқ.
Dialogue: 0,0:01:02.93,0:01:06.90,Default,,0,0,0,,Нобита, сен кешігіп қаласың.
Dialogue: 0,0:01:07.02,0:01:10.36,Default,,0,0,0,,Анашым! Эй! Апыр-ай!
Dialogue: 0,0:01:10.48,0:01:12.78,Default,,0,0,0,,Ха! Бұл арман ба?
Dialogue: 0,0:01:15.03,0:01:19.74,Default,,0,0,0,,Иә? Оянсам да кешігіп барамын.
Dialogue: 0,0:01:20.53,0:01:24.12,Default,,0,0,0,,Нобита Оян!
Dialogue: 0,0:01:27.21,0:01:28.54,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:28.67,0:01:31.38,Default,,0,0,0,,Неге мені тезірек оята алмайсың? анам
Dialogue: 0,0:01:28.67,0:01:31.38,Default,,0,0,0,,Апамды айқайлата алмай тұрып, оған не істедің?
Dialogue: 0,0:01:31.50,0:01:33.46,Default,,0,0,0,,Мен сені талай рет ояттым.
Dialogue: 0,0:01:31.50,0:01:33.46,Default,,0,0,0,,(баспалдақтан құлаған дыбыс)
Dialogue: 0,0:01:33.46,0:01:33.59,Default,,0,0,0,,(баспалдақтан құлаған дыбыс)
Dialogue: 0,0:01:33.59,0:01:34.38,Default,,0,0,0,,(баспалдақтан құлаған дыбыс)
Dialogue: 0,0:01:33.59,0:01:34.38,Default,,0,0,0,,Итата... күрсіну...
Dialogue: 0,0:01:34.38,0:01:35.72,Default,,0,0,0,,Итата... күрсініп...
Dialogue: 0,0:01:35.84,0:01:38.89,Default,,0,0,0,,Мен барамын Уау!
Dialogue: 0,0:01:40.76,0:01:44.31,Default,,0,0,0,,Әлі де... уақыт өте келе жатыр.
Dialogue: 0,0:01:45.18,0:01:47.23,Default,,0,0,0,,Қараңызшы, мен оны білдім.
Dialogue: 0,0:01:47.35,0:01:50.15,Default,,0,0,0,,Ал, әзірше оқуды жалғастырайық.
Dialogue: 0,0:01:50.27,0:01:53.23,Default,,0,0,0,,Мен үш күн қатарынан стейк жедім.
Dialogue: 0,0:01:53.36,0:01:56.44,Default,,0,0,0,,Иә? Бұл ~ Нобита
Dialogue: 0,0:01:56.57,0:01:59.45,Default,,0,0,0,,Сіз әлі тұрасыз ба?
Dialogue: 0,0:01:59.99,0:02:04.95,Default,,0,0,0,,Кешігіп келгені үшін тоқтатқанда қандай сезім бар? Ухуху
Dialogue: 0,0:02:05.08,0:02:08.96,Default,,0,0,0,,Мені кем дегенде бір рет тұрғызғанын қалаймын.
Dialogue: 0,0:02:09.08,0:02:11.38,Default,,0,0,0,,Уфуфуфу... Ахахха
Dialogue: 0,0:02:11.50,0:02:13.17,Default,,0,0,0,,Сәлем Сунео
Dialogue: 0,0:02:13.80,0:02:16.55,Default,,0,0,0,,Оны қалдырыңыз.
Dialogue: 0,0:02:16.67,0:02:18.63,Default,,0,0,0,,Бір орында тұру
Dialogue: 0,0:02:18.76,0:02:21.68,Default,,0,0,0,,Нобитаның жігіті шаршады.
Dialogue: 0,0:02:21.80,0:02:22.60,Default,,0,0,0,,Джан
Dialogue: 0,0:02:23.56,0:02:28.35,Default,,0,0,0,,Мен сені бүгін бейсболға жіберемін, сондықтан риза бол.
Dialogue: 0,0:02:28.48,0:02:30.60,Default,,0,0,0,,Менің бір ісім бар.
Dialogue: 0,0:02:30.73,0:02:33.82,Default,,0,0,0,,Не? Нобита сондай тәкаппар.
Dialogue: 0,0:02:33.94,0:02:35.32,Default,,0,0,0,,Өте…
Dialogue: 0,0:02:35.44,0:02:38.90,Default,,0,0,0,,Екеуің доғарыңдар. Бұл Нобита-санға ұнамайды, солай ма?
Dialogue: 0,0:02:39.03,0:02:40.74,Default,,0,0,0,,Оның Шизука-чанға еш қатысы жоқ.
Dialogue: 0,0:02:40.86,0:02:42.53,Default,,0,0,0,,Иә, иә, соусты кальмар
Dialogue: 0,0:02:42.66,0:02:45.24,Default,,0,0,0,,Сіз бұлай айтпайсыз, солай ма?
Dialogue: 0,0:02:45.37,0:02:46.33,Default,,0,0,0,,Шизука-чан...
Dialogue: 0,0:02:46.45,0:02:50.25,Default,,0,0,0,,А, қыз маған көмектесіп жатыр.
Dialogue: 0,0:02:50.37,0:02:53.04,Default,,0,0,0,,Бұл мен ойлағаннан да аянышты.
Dialogue: 0,0:02:53.17,0:02:56.00,Default,,0,0,0,,Келесі Нобита, кеттік!
Dialogue: 0,0:02:56.13,0:02:58.38,Default,,0,0,0,,О! Да~!
Dialogue: 0,0:02:58.51,0:03:00.38,Default,,0,0,0,,(Кёко) Ой... мен соңғы хиттердің ешқайсысын білмеймін!
Dialogue: 0,0:03:00.51,0:03:03.43,Default,,0,0,0,,А... аа... уау
Dialogue: 0,0:03:03.55,0:03:07.02,Default,,0,0,0,,Ита~ (Сунео) Нобита Жақсы аулау
Dialogue: 0,0:03:07.14,0:03:11.14,Default,,0,0,0,,Пу~пупупу, аға, мен де ұрайын.
Dialogue: 0,0:03:11.27,0:03:13.19,Default,,0,0,0,,Ей, маған жарғанақты берші. Маған қарызға бер.
Dialogue: 0,0:03:13.31,0:03:14.52,Default,,0,0,0,,Тек бір рет, Джайко
Dialogue: 0,0:03:14.65,0:03:15.61,Default,,0,0,0,,Иә
Dialogue: 0,0:03:16.23,0:03:17.15,Default,,0,0,0,,Эй!
Dialogue: 0,0:03:17.28,0:03:19.82,Default,,0,0,0,,Тааааааа...
Dialogue: 0,0:03:19.94,0:03:22.86,Default,,0,0,0,,(Барлығы күледі)
Dialogue: 0,0:03:23.74,0:03:25.91,Default,,0,0,0,,Қозғалыс дағдыларының айтарлықтай жетіспеушілігі
Dialogue: 0,0:03:26.03,0:03:28.24,Default,,0,0,0,,Иә... әрине.
Dialogue: 0,0:03:30.46,0:03:33.08,Default,,0,0,0,,Ой, мен шындап оқи бастадым.
Dialogue: 0,0:03:33.21,0:03:34.79,Default,,0,0,0,,Мүмкін сен ақылды шығарсың
Dialogue: 0,0:03:34.92,0:03:38.46,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:03:38.59,0:03:42.05,Default,,0,0,0,,Бірдеңе құлап қалды. Ах...
Dialogue: 0,0:03:42.18,0:03:46.26,Default,,0,0,0,,Ақыр соңында тоқтайық. Барғанның мәні жоқ.
Dialogue: 0,0:03:46.39,0:03:50.43,Default,,0,0,0,,Сіз мені жалғыз қалдыра алмайсыз. Қараңызшы, маған біреу қамқорлық жасауы керек.
Dialogue: 0,0:03:50.56,0:03:52.44,Default,,0,0,0,,Бұл мүмкін емес, мүмкін емес, мүмкін емес.
Dialogue: 0,0:03:52.56,0:03:53.73,Default,,0,0,0,,Қалай болғанда да
Dialogue: 0,0:03:53.85,0:03:56.15,Default,,0,0,0,,Арғы атаңмен сөйлесейік.
Dialogue: 0,0:03:56.27,0:03:59.53,Default,,0,0,0,,Әйтпесе, мұрын ауыстырғышы...
Dialogue: 0,0:03:59.65,0:04:01.19,Default,,0,0,0,,Жақсы...
Dialogue: 0,0:04:01.32,0:04:05.62,Default,,0,0,0,,Түсіндім, басқа амалым жоқ.
Dialogue: 0,0:04:09.70,0:04:10.50,Default,,0,0,0,,Жарайды
Dialogue: 0,0:04:15.38,0:04:17.34,Default,,0,0,0,,Ал, кеттік.
Dialogue: 0,0:04:37.56,0:04:42.15,Default,,0,0,0,,(Дораэмонның ауыр дауысы)
Dialogue: 0,0:04:46.53,0:04:48.20,Default,,0,0,0,,Аа, ол ашық.
Dialogue: 0,0:04:52.00,0:04:55.25,Default,,0,0,0,,Уф...хии~
Dialogue: 0,0:04:56.12,0:04:59.79,Default,,0,0,0,,Нобита-кун, Нобита-кун, солай ма?
Dialogue: 0,0:04:59.92,0:05:02.13,Default,,0,0,0,,Хмм... мм?
Dialogue: 0,0:05:02.88,0:05:04.47,Default,,0,0,0,,Хехехе
Dialogue: 0,0:05:06.22,0:05:08.18,Default,,0,0,0,,Э~?
Dialogue: 0,0:05:08.30,0:05:10.10,Default,,0,0,0,,(күледі)
Dialogue: 0,0:05:13.22,0:05:14.43,Default,,0,0,0,,Хмм?
Dialogue: 0,0:05:15.44,0:05:16.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:17.85,0:05:21.48,Default,,0,0,0,,Уау! Тата... Ракон ит!
Dialogue: 0,0:05:21.61,0:05:23.23,Default,,0,0,0,,Зуко!
Dialogue: 0,0:05:23.36,0:05:26.95,Default,,0,0,0,,Сені енот ит деп айту дөрекі.
Dialogue: 0,0:05:27.07,0:05:32.04,Default,,0,0,0,,Бұл ақылға сыймайтын нәрсе емес, солай ма? Қараңғы
Dialogue: 0,0:05:32.66,0:05:34.95,Default,,0,0,0,,Жақсы жұмыс хаха
Dialogue: 0,0:05:35.08,0:05:37.87,Default,,0,0,0,,Қайырлы кеш, мен Дораемонмын
Dialogue: 0,0:05:38.71,0:05:41.59,Default,,0,0,0,,Уау... о...
Dialogue: 0,0:05:41.71,0:05:46.34,Default,,0,0,0,,Жақсы кадр, иә? Ол жәшіктен шықты
Dialogue: 0,0:05:47.09,0:05:48.80,Default,,0,0,0,,Сәлеметсіз бе, мен Севашимін
Dialogue: 0,0:05:48.93,0:05:52.81,Default,,0,0,0,,Иә! Қалай... неге ондай жерден келдің?
Dialogue: 0,0:05:52.93,0:05:57.77,Default,,0,0,0,,Таң қалма, тыңда, біз болашақтанбыз.
Dialogue: 0,0:05:58.31,0:06:00.48,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:06:02.02,0:06:03.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:06.61,0:06:10.20,Default,,0,0,0,,Ой, не болып жатыр? Бұл
Dialogue: 0,0:06:10.32,0:06:14.16,Default,,0,0,0,,А, жәшікте не болды деп уайымдама.
Dialogue: 0,0:06:14.79,0:06:18.29,Default,,0,0,0,,Өйткені мен бәрін осы төрт өлшемді қалтаға аудардым.
Dialogue: 0,0:06:18.41,0:06:20.88,Default,,0,0,0,,Бұл қалтаға кез келген нәрсені салуға болады.
Dialogue: 0,0:06:21.00,0:06:22.00,Default,,0,0,0,,Көп...
Dialogue: 0,0:06:22.13,0:06:24.88,Default,,0,0,0,,Уау, уау... Уау!
Dialogue: 0,0:06:26.09,0:06:29.22,Default,,0,0,0,,(Ит айқайлайды)
Dialogue: 0,0:06:35.31,0:06:38.68,Default,,0,0,0,,Өтінемін, уайымдамаңыз.
Dialogue: 0,0:06:39.23,0:06:43.69,Default,,0,0,0,,Келгеніңізге қуаныштымын, бірақ мен әлі түсінбеймін.
Dialogue: 0,0:06:43.82,0:06:47.61,Default,,0,0,0,,Мені... иә... немерем десең де.
Dialogue: 0,0:06:47.74,0:06:50.11,Default,,0,0,0,,Нақтырақ айтсақ немеренің немересі
Dialogue: 0,0:06:50.24,0:06:53.28,Default,,0,0,0,,Мен сенің төртінші ұрпағыңмын.
Dialogue: 0,0:06:54.41,0:06:58.41,Default,,0,0,0,,Мен әлі баламын. Немерелерім бар ма?
Dialogue: 0,0:06:58.54,0:07:00.33,Default,,0,0,0,,Дәмді!
Dialogue: 0,0:07:01.37,0:07:03.96,Default,,0,0,0,,Бұл қандай тағам?
Dialogue: 0,0:07:05.17,0:07:06.42,Default,,0,0,0,,Дораяки
Dialogue: 0,0:07:06.55,0:07:09.17,Default,,0,0,0,,Уау~ Дораяки деп аталады.
Dialogue: 0,0:07:09.30,0:07:12.34,Default,,0,0,0,,Мен мұндай дәмді ештеңе жеген емеспін.
Dialogue: 0,0:07:12.89,0:07:13.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:13.97,0:07:15.64,Default,,0,0,0,,Қазірдің өзінде...
Dialogue: 0,0:07:16.35,0:07:18.18,Default,,0,0,0,,Білесің бе, арғы ата?
Dialogue: 0,0:07:18.31,0:07:20.81,Default,,0,0,0,,Сен де бір күні есейесің, солай ма?
Dialogue: 0,0:07:20.94,0:07:21.73,Default,,0,0,0,,Иә
Dialogue: 0,0:07:21.85,0:07:24.86,Default,,0,0,0,,Сонда үйленесің, солай ма? (Нобита) Солай ма?
Dialogue: 0,0:07:24.98,0:07:27.02,Default,,0,0,0,,Мен мұны 19 жылдан кейін жасаймын.
Dialogue: 0,0:07:27.15,0:07:29.07,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:07:29.69,0:07:32.16,Default,,0,0,0,,Басқа адам қандай адам?
Dialogue: 0,0:07:32.28,0:07:34.95,Default,,0,0,0,,Ал... бұл үйлену тойындағы фото
Dialogue: 0,0:07:35.07,0:07:36.70,Default,,0,0,0,,Сіз Джайко айттыңыз.
Dialogue: 0,0:07:36.83,0:07:38.70,Default,,0,0,0,,Иә, Джайко?
Dialogue: 0,0:07:38.83,0:07:41.12,Default,,0,0,0,,Бұл одан кейінгі өмір
Dialogue: 0,0:07:42.83,0:07:46.21,Default,,0,0,0,,Анау ебедейсіз бала менікі...
Dialogue: 0,0:07:46.34,0:07:50.59,Default,,0,0,0,,Бұл өтірік. Үйге бар. Мүмкін болса, үйге барыңыз!
Dialogue: 0,0:07:51.26,0:07:54.43,Default,,0,0,0,,Сыртқа шық, мен ондай бос сөзге сенбеймін.
Dialogue: 0,0:07:54.55,0:07:55.97,Default,,0,0,0,,(құлау дыбысы)
Dialogue: 0,0:07:56.85,0:08:01.23,Default,,0,0,0,,Мм... Мені ашуланбай тыңдауларыңызды қалаймын.
Dialogue: 0,0:08:01.77,0:08:06.11,Default,,0,0,0,,Расында, осылай жүре берсең, өмір бойы қиналмайсың.
Dialogue: 0,0:08:06.23,0:08:07.36,Default,,0,0,0,,Иә...
Dialogue: 0,0:08:07.48,0:08:08.69,Default,,0,0,0,,Мынаны қараңыз
Dialogue: 0,0:08:09.23,0:08:13.11,Default,,0,0,0,,Мен жұмысқа тұра алмаймын, сондықтан жеке компаниямды аштым.
Dialogue: 0,0:08:13.86,0:08:17.53,Default,,0,0,0,,Өрт болып, рота толығымен жойылды.
Dialogue: 0,0:08:18.24,0:08:19.37,Default,,0,0,0,,Сол кездегі қарыз
Dialogue: 0,0:08:19.49,0:08:21.62,Default,,0,0,0,,Қар жауып тұр.
Dialogue: 0,0:08:22.12,0:08:26.79,Default,,0,0,0,,Сенің арқаңда біз кедейміз, тек ескі, ескірген дүниелеріміз бар.
Dialogue: 0,0:08:28.25,0:08:29.59,Default,,0,0,0,,Түсіндіңіз бе?
Dialogue: 0,0:08:32.38,0:08:34.55,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:08:34.68,0:08:37.64,Default,,0,0,0,,Тіпті сендерге қиындық туғызады
Dialogue: 0,0:08:38.39,0:08:42.02,Default,,0,0,0,,Менің енді өмір сүргім келмейді.
Dialogue: 0,0:08:44.56,0:08:46.77,Default,,0,0,0,,Көңіліңді түсірме.
Dialogue: 0,0:08:46.90,0:08:49.48,Default,,0,0,0,,Сіз тіпті болашақты өзгерте аласыз.
Dialogue: 0,0:08:50.02,0:08:51.57,Default,,0,0,0,,Иә... шынымен бе?
Dialogue: 0,0:08:54.11,0:08:57.70,Default,,0,0,0,,Біз сол үшін келдік, солай ма? Дораемон
Dialogue: 0,0:08:57.82,0:09:03.41,Default,,0,0,0,,Севаши-кун, мен әлі жарайды деп айтқан жоқпын...
Dialogue: 0,0:09:04.16,0:09:05.92,Default,,0,0,0,,Бір минут күтіңіз
Dialogue: 0,0:09:06.04,0:09:08.79,Default,,0,0,0,,Дораемон, біз бұл туралы дұрыс сөйлестік, солай ма?
Dialogue: 0,0:09:08.92,0:09:11.88,Default,,0,0,0,,(Екі адам сөйлеседі)
Dialogue: 0,0:09:17.13,0:09:18.30,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:09:18.43,0:09:20.97,Default,,0,0,0,,Гуджиджи…
Dialogue: 0,0:09:21.10,0:09:25.81,Default,,0,0,0,,Мен көмектесе алмаймын, мен мұны істегім келмеді.
Dialogue: 0,0:09:27.02,0:09:27.94,Default,,0,0,0,,Мен Нобитаны бақытты етпесем
Dialogue: 0,0:09:27.94,0:09:31.94,Default,,0,0,0,,Мен Нобитаны бақытты етпесем
Dialogue: 0,0:09:27.94,0:09:31.94,Default,,0,0,0,,(мұрынның бұрылу дыбысы)
Dialogue: 0,0:09:32.07,0:09:36.90,Default,,0,0,0,,Мен болашаққа орала алмаймын!
Dialogue: 0,0:09:43.79,0:09:46.87,Default,,0,0,0,,Ах! Севаси-кун қорқынышты
Dialogue: 0,0:09:47.00,0:09:49.83,Default,,0,0,0,,Бүгіннен бастап бұл Дораемон сізге қамқорлық жасайды.
Dialogue: 0,0:09:49.96,0:09:51.67,Default,,0,0,0,,Мен бір нәрсемен айналысамын.
Dialogue: 0,0:09:51.79,0:09:54.96,Default,,0,0,0,,Мүмкін емес Мүмкін емес Мүмкін емес Бұл мүмкін емес.
Dialogue: 0,0:09:55.51,0:09:58.22,Default,,0,0,0,,Нобитаның бақытына қол жеткізсе
Dialogue: 0,0:09:58.34,0:10:01.43,Default,,0,0,0,,Мен сізді тезірек оралуға бағдарламаладым.
Dialogue: 0,0:10:01.55,0:10:02.85,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:10:02.97,0:10:07.73,Default,,0,0,0,,Иә, қалғым келеді десең де, амалсыз кері қайтарылады.
Dialogue: 0,0:10:08.35,0:10:11.65,Default,,0,0,0,,Жоқ, жоқ, сөзсіз!
Dialogue: 0,0:10:11.77,0:10:15.69,Default,,0,0,0,,Міне, мен сенен сұрадым, Дораемон.
Dialogue: 0,0:10:15.82,0:10:18.65,Default,,0,0,0,,Ммм
Dialogue: 0,0:10:20.11,0:10:22.58,Default,,0,0,0,,Оны өңдеу біршама қиын.
Dialogue: 0,0:10:23.12,0:10:27.50,Default,,0,0,0,,Арғы атаңа пайдалы болатынына сенімдімін.
Dialogue: 0,0:10:28.41,0:10:29.67,Default,,0,0,0,,Жақында кездескенше
Dialogue: 0,0:10:34.17,0:10:35.13,Default,,0,0,0,,Ком-Омбодағы адам да шынайы емес пе еді?
Dialogue: 0,0:10:35.92,0:10:40.05,Default,,0,0,0,,Эхехехе-Танысқаныма қуаныштымын Дораемон
Dialogue: 0,0:10:41.51,0:10:44.68,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:44.81,0:10:46.60,Default,,0,0,0,,Уау Уау~
Dialogue: 0,0:10:46.72,0:10:52.02,Default,,0,0,0,,Жоқ, бұл мүмкін емес. Мен де болашаққа қайтамын.
Dialogue: 0,0:10:52.65,0:10:54.02,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:10:52.65,0:10:54.02,Default,,0,0,0,,«Болашаққа оралу» қате сөзін растаңыз
Dialogue: 0,0:10:54.02,0:10:56.61,Default,,0,0,0,,«Болашаққа оралу» қате сөзін растаңыз
Dialogue: 0,0:10:56.73,0:10:59.70,Default,,0,0,0,,(Дораэмонның айқайы)
Dialogue: 0,0:11:01.07,0:11:04.37,Default,,0,0,0,,Түсіндім, түсіндім, түсіндім... Түсіндім.
Dialogue: 0,0:11:04.49,0:11:07.70,Default,,0,0,0,,Мен Нобитаны қуантамын
Dialogue: 0,0:11:09.71,0:11:11.25,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:11:11.37,0:11:15.96,Default,,0,0,0,,Севаши-кун да маған қорқынышты бағдарлама дайындады.
Dialogue: 0,0:11:16.75,0:11:19.47,Default,,0,0,0,,Сіз ауырып қалдыңыз ба?
Dialogue: 0,0:11:22.22,0:11:24.72,Default,,0,0,0,,Сіз шынымен пайдалысыз ба?
Dialogue: 0,0:11:24.85,0:11:26.72,Default,,0,0,0,,Иә? Не!
Dialogue: 0,0:11:26.85,0:11:29.89,Default,,0,0,0,,Енді мен сендерге 22 ғасырдың ғажайыптарын көрсетемін.
Dialogue: 0,0:11:31.19,0:11:34.06,Default,,0,0,0,,Қаңтар «Takecopter»
Dialogue: 0,0:11:34.19,0:11:37.36,Default,,0,0,0,,Бұл не? Жарайды, жарайды
Dialogue: 0,0:11:37.48,0:11:40.28,Default,,0,0,0,,Иә, иә... (Нобита) Не? Не?
Dialogue: 0,0:11:40.40,0:11:42.45,Default,,0,0,0,,Ал, жарайды... (Нобита) Әй, күте тұрыңыз... сәл.
Dialogue: 0,0:11:42.57,0:11:44.70,Default,,0,0,0,,Терезеден шыққанда не істейсің?
Dialogue: 0,0:11:44.82,0:11:46.78,Default,,0,0,0,,Бұл қызық болады (Нобита) Иә?
Dialogue: 0,0:11:46.91,0:11:50.04,Default,,0,0,0,,Йойшо (Нобита) Уау Уау... Уау
Dialogue: 0,0:11:50.16,0:11:53.08,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:53.21,0:11:57.46,Default,,0,0,0,,А, а, а, а... а?
Dialogue: 0,0:11:57.59,0:12:00.55,Default,,0,0,0,,(Takecopter айналу дыбысы)
Dialogue: 0,0:12:02.13,0:12:04.22,Default,,0,0,0,,Ауада қалықтау
Dialogue: 0,0:12:05.18,0:12:06.85,Default,,0,0,0,,Бұл таңқаларлық емес пе?
Dialogue: 0,0:12:07.60,0:12:10.64,Default,,0,0,0,,Итаааа... бұл арман емес.
Dialogue: 0,0:12:10.77,0:12:14.40,Default,,0,0,0,,Уау Уау Уау... Уау
Dialogue: 0,0:12:17.65,0:12:19.11,Default,,0,0,0,,Уау~ Ах~ Ах~!
Dialogue: 0,0:12:19.23,0:12:20.03,Default,,0,0,0,,Иә
Dialogue: 0,0:12:20.15,0:12:21.99,Default,,0,0,0,,(Нобитаның айқайы)
Dialogue: 0,0:12:22.11,0:12:25.82,Default,,0,0,0,,Маған көмектес, мен ғарышқа барамын.
Dialogue: 0,0:12:26.32,0:12:29.83,Default,,0,0,0,,Тыныштық, тыныштық
Dialogue: 0,0:12:30.62,0:12:33.25,Default,,0,0,0,,Тоқта, тоқта, тоқта, тоқта, тоқта!
Dialogue: 0,0:12:33.37,0:12:35.25,Default,,0,0,0,,А, тоқтады.
Dialogue: 0,0:12:35.37,0:12:36.71,Default,,0,0,0,,Ах! Нобита-кун!
Dialogue: 0,0:12:36.83,0:12:40.80,Default,,0,0,0,,Қозғал, қимылда, қозғал!
Dialogue: 0,0:12:41.71,0:12:43.84,Default,,0,0,0,,Уау о... Уау
Dialogue: 0,0:12:45.89,0:12:49.64,Default,,0,0,0,,Нобита-кун, күте тұр.
Dialogue: 0,0:12:49.76,0:12:51.27,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:51.39,0:12:56.23,Default,,0,0,0,,Ухххххххххххххххх...
Dialogue: 0,0:12:56.35,0:12:59.73,Default,,0,0,0,,Мен Каназучинамын!
Dialogue: 0,0:13:00.77,0:13:03.40,Default,,0,0,0,,Уау... Уау...
Dialogue: 0,0:13:21.34,0:13:24.09,Default,,0,0,0,,Жақсырақ.
Dialogue: 0,0:13:24.22,0:13:25.38,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:13:30.76,0:13:32.22,Default,,0,0,0,,Я...
Dialogue: 0,0:13:34.35,0:13:37.14,Default,,0,0,0,,(Нобитаның күлкісі)
Dialogue: 0,0:13:37.27,0:13:40.69,Default,,0,0,0,,Не? Үйренген соң оңай емес пе?
Dialogue: 0,0:13:42.02,0:13:44.78,Default,,0,0,0,,Уф! Фуфу хахахаха
Dialogue: 0,0:13:45.40,0:13:49.78,Default,,0,0,0,,Ол тіпті кішкентай балалар да ұша алатындай етіп орнатылған.
Dialogue: 0,0:13:49.91,0:13:52.87,Default,,0,0,0,,(Нобитаның көңілді дауысы)
Dialogue: 0,0:13:56.87,0:13:59.83,Default,,0,0,0,,Ах... ааа...
Dialogue: 0,0:14:02.46,0:14:05.42,Default,,0,0,0,,А, не болды?
Dialogue: 0,0:14:05.55,0:14:07.80,Default,,0,0,0,,Шизуканың үйі
Dialogue: 0,0:14:08.97,0:14:11.85,Default,,0,0,0,,Бір-біріңді білесіңдер ме? (Нобита) Иә, сыныптастар.
Dialogue: 0,0:14:11.97,0:14:15.77,Default,,0,0,0,,Дұрыс, мен Шизука-чанды таң қалдырамын.
Dialogue: 0,0:14:17.06,0:14:18.81,Default,,0,0,0,,Сіз әлі ояусыз ба?
Dialogue: 0,0:14:21.77,0:14:22.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:23.32,0:14:27.15,Default,,0,0,0,,Сіз ұйықтап жатырсыз (Нобита) Өте жаман.
Dialogue: 0,0:14:32.16,0:14:35.33,Default,,0,0,0,,Шизука-чан өте сүйкімді
Dialogue: 0,0:14:35.45,0:14:39.50,Default,,0,0,0,,Сонымен... Мен солай ойлаймын. Оны сіздің болашақ өзіңіз көрсе де?
Dialogue: 0,0:14:39.62,0:14:42.63,Default,,0,0,0,,Иә (Нобита) Иә, солай.
Dialogue: 0,0:14:42.75,0:14:46.76,Default,,0,0,0,,Дұрыс, мен де...
Dialogue: 0,0:14:46.88,0:14:48.72,Default,,0,0,0,,Корпус мүшелеріне бір-біріне негізсіз қылыш кезенуге мүлде болмайды!
Dialogue: 0,0:14:51.59,0:14:53.47,Default,,0,0,0,,Эх!
Dialogue: 0,0:14:54.01,0:14:58.39,Default,,0,0,0,,Нобита? Сіз әлі оянасыз ба? ерте жату
Dialogue: 0,0:14:59.48,0:15:01.90,Default,,0,0,0,,Не? Күте тұрыңыз... Дораемон
Dialogue: 0,0:15:02.02,0:15:04.77,Default,,0,0,0,,Мен... мен және... Шизука-чан
Dialogue: 0,0:15:04.90,0:15:07.07,Default,,0,0,0,,Ке... Ке~!
Dialogue: 0,0:15:07.90,0:15:09.28,Default,,0,0,0,,Неке?
Dialogue: 0,0:15:09.40,0:15:12.95,Default,,0,0,0,,Иә, мен де болашаққа тезірек оралғым келеді.
Dialogue: 0,0:15:13.07,0:15:18.12,Default,,0,0,0,,Менің ойымша, бұл Нобитаны бақытты етудің ең жақсы жолы.
Dialogue: 0,0:15:18.25,0:15:22.21,Default,,0,0,0,,Сонымен... бұл... мен...
Dialogue: 0,0:15:22.33,0:15:24.88,Default,,0,0,0,,Ұят~
Dialogue: 0,0:15:25.00,0:15:27.63,Default,,0,0,0,,Ештеңе жасамасаңыз да...
Dialogue: 0,0:15:27.76,0:15:30.38,Default,,0,0,0,,Сіз де қиындыққа тап болмайсыз ба?
Dialogue: 0,0:15:30.92,0:15:32.59,Default,,0,0,0,,Сонда тоқтайсың ба?
Dialogue: 0,0:15:33.22,0:15:35.22,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:15:36.51,0:15:38.85,Default,,0,0,0,,Бірақ қалай?
Dialogue: 0,0:15:38.97,0:15:41.10,Default,,0,0,0,,Уху эх хе
Dialogue: 0,0:15:42.60,0:15:45.15,Default,,0,0,0,,I'm going
Dialogue: 0,0:15:48.11,0:15:50.74,Default,,0,0,0,,Иә? Дораемон
Dialogue: 0,0:15:50.86,0:15:53.70,Default,,0,0,0,,Ең алдымен кешіктіруді доғар.
Dialogue: 0,0:15:54.53,0:15:56.70,Default,,0,0,0,,«Кез келген жерде есік»
Dialogue: 0,0:15:57.58,0:15:59.12,Default,,0,0,0,,Не? ол
Dialogue: 0,0:15:59.24,0:16:03.04,Default,,0,0,0,,Жүр, жүр, қайда барғың келетінін айтып, есікті аш.
Dialogue: 0,0:16:03.17,0:16:04.50,Default,,0,0,0,,Мектепке
Dialogue: 0,0:16:07.63,0:16:10.13,Default,,0,0,0,,Ухохохо хахахаха
Dialogue: 0,0:16:10.59,0:16:12.63,Default,,0,0,0,,Кеше маған біреу жаңа ойыншық сатып алды.
Dialogue: 0,0:16:12.76,0:16:14.09,Default,,0,0,0,,Түрлі оқиғаларға араласып жүріп—
Dialogue: 0,0:16:14.22,0:16:16.72,Default,,0,0,0,,Уа, ау, ау...
Dialogue: 0,0:16:16.85,0:16:19.85,Default,,0,0,0,,Нобитаның әдетіне қарамастан ерте келді.
Dialogue: 0,0:16:22.64,0:16:24.60,Default,,0,0,0,,Ах Шизука-чан
Dialogue: 0,0:16:25.27,0:16:28.15,Default,,0,0,0,,О, Нобита-сан
Dialogue: 0,0:16:30.73,0:16:33.36,Default,,0,0,0,,Қайырлы таң, бүгін ерте келдің.
Dialogue: 0,0:16:33.49,0:16:34.53,Default,,0,0,0,,Иә
Dialogue: 0,0:16:35.45,0:16:37.07,Default,,0,0,0,,«Анкипан»
Dialogue: 0,0:16:37.70,0:16:41.08,Default,,0,0,0,,Бұны жесең, онда не жазылғанын есте сақтайсың.
Dialogue: 0,0:16:41.20,0:16:44.33,Default,,0,0,0,,Иә Иә Иә (Нобита) Әму Әму Әму
Dialogue: 0,0:16:47.17,0:16:49.59,Default,,0,0,0,,Мен түсіндім, түсінемін
Dialogue: 0,0:16:49.71,0:16:53.51,Default,,0,0,0,,Сіз маған қарағанда жақсы ұпай жинадыңыз.
Dialogue: 0,0:16:53.63,0:16:58.80,Default,,0,0,0,,Дораэмон Джианды жеңгісі келеді
Dialogue: 0,0:16:59.51,0:17:01.27,Default,,0,0,0,,«Томей плащы»
Dialogue: 0,0:17:02.10,0:17:05.02,Default,,0,0,0,,Анам қарны ашты.
Dialogue: 0,0:17:06.02,0:17:10.27,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:17:11.90,0:17:14.19,Default,,0,0,0,,Қайнатыңыз!
Dialogue: 0,0:17:14.32,0:17:16.70,Default,,0,0,0,,«Мықты қолғап»
Dialogue: 0,0:17:16.82,0:17:20.20,Default,,0,0,0,,Егер сіз жаттығу жасай алсаңыз, танымал бола аласыз деп ойлаймын.
Dialogue: 0,0:17:20.33,0:17:21.45,Default,,0,0,0,,(жұмыс дыбысы)
Dialogue: 0,0:17:21.58,0:17:25.12,Default,,0,0,0,,Уау... о-о~
Dialogue: 0,0:17:26.33,0:17:27.92,Default,,0,0,0,,А, мен түсіндім.
Dialogue: 0,0:17:28.46,0:17:30.54,Default,,0,0,0,,Уау, бұл керемет
Dialogue: 0,0:17:30.67,0:17:33.01,Default,,0,0,0,,Хехехе~ Уау
Dialogue: 0,0:17:33.13,0:17:36.93,Default,,0,0,0,,Мммм мен көрдім мен көрдім
Dialogue: 0,0:17:37.05,0:17:38.68,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:17:38.80,0:17:41.43,Default,,0,0,0,,Дораемон
Dialogue: 0,0:17:41.56,0:17:44.02,Default,,0,0,0,,«Уақыт Фурошики»
Dialogue: 0,0:17:44.14,0:17:46.69,Default,,0,0,0,,Осымен орау сізді өткенге қайтарады.
Dialogue: 0,0:17:46.81,0:17:49.48,Default,,0,0,0,,Ішіне орап алсаң, болашаққа көшіп кетесің.
Dialogue: 0,0:17:49.61,0:17:51.40,Default,,0,0,0,,Я~
Dialogue: 0,0:17:51.52,0:17:54.53,Default,,0,0,0,,Ах... (Мұғалім) Өтірік айтпа, Хонекава-кун.
Dialogue: 0,0:17:54.65,0:17:56.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:57.03,0:17:59.99,Default,,0,0,0,,Шизука-чан, сен ненің суретін салып жатырсың?
Dialogue: 0,0:18:00.12,0:18:02.53,Default,,0,0,0,,Тайтер айтты
Dialogue: 0,0:18:02.66,0:18:05.12,Default,,0,0,0,,Дораемон
Dialogue: 0,0:18:05.25,0:18:07.75,Default,,0,0,0,,«Кисекае камерасы»
Dialogue: 0,0:18:07.87,0:18:10.13,Default,,0,0,0,,Киімнің суретін салып көріңіз.
Dialogue: 0,0:18:10.25,0:18:12.54,Default,,0,0,0,,Иә, сурет дәптеріңізді маған беріңіз.
Dialogue: 0,0:18:12.67,0:18:14.42,Default,,0,0,0,,Сүйкімді киім киіңіз
Dialogue: 0,0:18:14.55,0:18:15.92,Default,,0,0,0,,Жаңалықтар «Батырлар өлтіруші» туралы әңгімеге толы болды
Dialogue: 0,0:18:17.30,0:18:19.18,Default,,0,0,0,,Иә Сыр
Dialogue: 0,0:18:19.30,0:18:20.30,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:18:20.43,0:18:24.85,Default,,0,0,0,,Кя~! Нобитаның жынысы
Dialogue: 0,0:18:25.02,0:18:27.77,Default,,0,0,0,,«Аппақ орам»
Dialogue: 0,0:18:27.89,0:18:30.65,Default,,0,0,0,,Мұны пайдаланған кезде, сіз оны керемет жылдамдықпен жасай аласыз.
Dialogue: 0,0:18:30.77,0:18:34.44,Default,,0,0,0,,Мен тапсырмаларды орындай аламын.
Dialogue: 0,0:18:35.90,0:18:38.40,Default,,0,0,0,,Сен бүгін қатты толқыдың, солай емес пе?
Dialogue: 0,0:18:38.53,0:18:40.53,Default,,0,0,0,,Дора-чанға келгені үшін рахмет деп ойлаймын.
Dialogue: 0,0:18:40.66,0:18:43.24,Default,,0,0,0,,Бәрі бітті. иә? Ол аяқтады?
Dialogue: 0,0:18:43.78,0:18:46.70,Default,,0,0,0,,Эй, сен маған көмектесіп тұрсың. Бұл керемет, Нобита.
Dialogue: 0,0:18:46.83,0:18:49.50,Default,,0,0,0,,Жарайды, мен сенен қонақ бөлмені де жинауды сұраймын.
Dialogue: 0,0:18:49.62,0:18:52.25,Default,,0,0,0,,Жарайды уау~
Dialogue: 0,0:18:52.38,0:18:54.67,Default,,0,0,0,,«Гулливер туннелі»
Dialogue: 0,0:18:55.21,0:18:58.30,Default,,0,0,0,,Уау, өте кең!
Dialogue: 0,0:18:58.88,0:19:01.09,Default,,0,0,0,,(көңілді дауыс)
Dialogue: 0,0:19:03.51,0:19:05.56,Default,,0,0,0,,Уау! Эй!
Dialogue: 0,0:19:06.31,0:19:08.73,Default,,0,0,0,,«Пәтер ағашы»
Dialogue: 0,0:19:08.85,0:19:09.89,Default,,0,0,0,,(Скрипка үні)
Dialogue: 0,0:19:10.02,0:19:12.56,Default,,0,0,0,,(Джианның ән салған дауысы)
Dialogue: 0,0:19:13.23,0:19:16.11,Default,,0,0,0,,«Бұлтты қатайтатын газ»
Dialogue: 0,0:19:17.61,0:19:22.74,Default,,0,0,0,,(көңілді дауыс)
Dialogue: 0,0:19:22.87,0:19:25.83,Default,,0,0,0,,Қайырлы таң Шизука-чан
Dialogue: 0,0:19:25.95,0:19:28.33,Default,,0,0,0,,Қайырлы таң Нобита-сан
Dialogue: 0,0:19:28.45,0:19:31.96,Default,,0,0,0,,Соңғы кездері өзімді жақсы сезініп жүрмін. Мүмкін бұл Дора Чанның кесірінен шығар.
Dialogue: 0,0:19:32.08,0:19:36.75,Default,,0,0,0,,Дұрыс, менің қолымнан бәрі келетін сияқты.
Dialogue: 0,0:19:36.88,0:19:37.84,Default,,0,0,0,,Әжеміздің бір ескі танысы шығар. Ах, дұрыс.
Dialogue: 0,0:19:37.96,0:19:40.59,Default,,0,0,0,,Шизука-чан, сәл жақсы.
Dialogue: 0,0:19:40.72,0:19:42.01,Default,,0,0,0,,Иә
Dialogue: 0,0:19:45.72,0:19:49.81,Default,,0,0,0,,Дұрыс, менің сыныбымда ол жігіт бар еді.
Dialogue: 0,0:19:50.43,0:19:53.94,Default,,0,0,0,,Спортқа жақсы, өте жақсы баға
Dialogue: 0,0:19:54.06,0:19:56.82,Default,,0,0,0,,Және өте жақсы адам
Dialogue: 0,0:19:56.94,0:19:58.90,Default,,0,0,0,,Декисуги!
Dialogue: 0,0:19:59.78,0:20:03.28,Default,,0,0,0,,Эй, Нобита, бүгін де ерте.
Dialogue: 0,0:20:04.62,0:20:06.03,Default,,0,0,0,,О...
Dialogue: 0,0:20:07.62,0:20:08.91,Default,,0,0,0,,Яғни⸺
Dialogue: 0,0:20:09.04,0:20:12.37,Default,,0,0,0,,Болашақтың құралдарын қалай пайдалансаңыз да
Dialogue: 0,0:20:12.92,0:20:17.59,Default,,0,0,0,,Мен сыныптасым Декисуги-кунмен сәйкес келуім керек.
Dialogue: 0,0:20:17.71,0:20:19.92,Default,,0,0,0,,Хмм.
Dialogue: 0,0:20:20.05,0:20:21.67,Default,,0,0,0,,Мені мазақ етпе!
Dialogue: 0,0:20:21.80,0:20:24.26,Default,,0,0,0,,Бұл 22 ғасырдағы мысық тәрізді робот.
Dialogue: 0,0:20:24.38,0:20:26.89,Default,,0,0,0,,Мүмкін емес ештеңе жоқ!
Dialogue: 0,0:20:27.68,0:20:30.43,Default,,0,0,0,,Күте тұрыңыз, Шизука-чанның сезімдері анық.
Dialogue: 0,0:20:30.56,0:20:34.60,Default,,0,0,0,,Мен сізге дәл қазір Нобита-кунға бару үшін құралдарды беремін.
Dialogue: 0,0:20:34.77,0:20:37.11,Default,,0,0,0,,Хмм... «Басылған жұмыртқа»
Dialogue: 0,0:20:37.23,0:20:40.03,Default,,0,0,0,,Ой, бұл не?
Dialogue: 0,0:20:40.61,0:20:43.32,Default,,0,0,0,,«Импринтинг» деген не екенін білесіз бе?
Dialogue: 0,0:20:43.45,0:20:45.03,Default,,0,0,0,,Ах... хмм.
Dialogue: 0,0:20:45.16,0:20:47.74,Default,,0,0,0,,Аа, сіз білуге ​​​​мүмкін емес.
Dialogue: 0,0:20:48.45,0:20:51.66,Default,,0,0,0,,Кейбір жануарлар, әсіресе құстар⸺
Dialogue: 0,0:20:51.79,0:20:54.67,Default,,0,0,0,,Жұмыртқадан шыққанда ең бірінші нені көрдіңіз?
Dialogue: 0,0:20:54.79,0:20:56.92,Default,,0,0,0,,Ата-ана ретінде мынаны есте сақтаңыз.
Dialogue: 0,0:20:57.04,0:21:00.13,Default,,0,0,0,,Ойыншық құс болса да
Dialogue: 0,0:21:00.25,0:21:03.76,Default,,0,0,0,,Бұл құбылыс «ізге түсіру» деп аталады.
Dialogue: 0,0:21:04.38,0:21:05.63,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:21:06.26,0:21:09.22,Default,,0,0,0,,Ах… Ах…
Dialogue: 0,0:21:10.14,0:21:13.56,Default,,0,0,0,,Сен онсыз да ақымақсың.
Dialogue: 0,0:21:13.68,0:21:18.23,Default,,0,0,0,,Қарапайым тілмен айтқанда, Шидзука-чанды осында қояйық.
Dialogue: 0,0:21:19.06,0:21:22.44,Default,,0,0,0,,Қақпақ жабылып, таймер жұмыс істей бастайды.
Dialogue: 0,0:21:22.99,0:21:25.28,Default,,0,0,0,,15 минуттан кейін Қақпақ ашылғанда
Dialogue: 0,0:21:25.40,0:21:29.03,Default,,0,0,0,,Мен бірінші рет кездескен адамға ғашық болып қалдым, мен оған қолым жетпейді.
Dialogue: 0,0:21:29.16,0:21:32.08,Default,,0,0,0,,Әу бастан осылай айтсаң ғой.
Dialogue: 0,0:21:32.70,0:21:37.12,Default,,0,0,0,,Эй, мынандай құрал бар еді.
Dialogue: 0,0:21:38.00,0:21:41.84,Default,,0,0,0,,Шизука-чан, сен менікісің.
Dialogue: 0,0:21:41.96,0:21:44.80,Default,,0,0,0,,Фуфуфуфуфу Мен мақтанғаным жоқ.
Dialogue: 0,0:21:44.92,0:21:48.39,Default,,0,0,0,,Бұл басылған жұмыртқаның мәжбүрлеу күші таң қалдырады.
Dialogue: 0,0:21:48.51,0:21:51.89,Default,,0,0,0,,Сіз қандай адам болсаңыз да, оған ешқашан қарсы шыға алмайсыз.
Dialogue: 0,0:21:52.01,0:21:55.35,Default,,0,0,0,,Жарайды, мен мұндай қорқақ құралды қолданбас едім.
Dialogue: 0,0:21:55.48,0:21:57.44,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:21:57.56,0:21:59.31,Default,,0,0,0,,О, жоқ болып кетті.
Dialogue: 0,0:21:59.44,0:22:02.36,Default,,0,0,0,,Бір минут күте тұрыңыз, Нобита-кун.
Dialogue: 0,0:22:02.98,0:22:06.82,Default,,0,0,0,,Йойшо Йойшо
Dialogue: 0,0:22:07.78,0:22:08.95,Default,,0,0,0,,Брандо мырза
Dialogue: 0,0:22:09.07,0:22:12.33,Default,,0,0,0,,Уау, уау... Күте тұрыңыз.
Dialogue: 0,0:22:12.45,0:22:15.04,Default,,0,0,0,,Джан, тоқта!
Dialogue: 0,0:22:16.16,0:22:19.08,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:22:19.21,0:22:21.08,Default,,0,0,0,,(жұмыс дыбысы)
Dialogue: 0,0:22:21.67,0:22:23.55,Default,,0,0,0,,А... а...
Dialogue: 0,0:22:23.67,0:22:26.72,Default,,0,0,0,,(Джианның айқайы)
Dialogue: 0,0:22:30.18,0:22:32.35,Default,,0,0,0,,Джан, жақсысың ба?
Dialogue: 0,0:22:33.89,0:22:37.18,Default,,0,0,0,,Алып жұмыртқада...
Dialogue: 0,0:22:37.31,0:22:41.90,Default,,0,0,0,,Ууу Ноби-чан Чут Чут Чутт
Dialogue: 0,0:22:42.02,0:22:44.98,Default,,0,0,0,,Авававава…
Dialogue: 0,0:22:45.11,0:22:48.74,Default,,0,0,0,,Жақсы, жүр Сунео.
Dialogue: 0,0:22:49.53,0:22:51.99,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,0:22:52.70,0:22:57.04,Default,,0,0,0,,Уау, Джан, сен мұнда не істеп жүрсің?
Dialogue: 0,0:22:57.16,0:22:58.25,Default,,0,0,0,,Пиё
Dialogue: 0,0:22:58.37,0:23:00.62,Default,,0,0,0,,Қандай азап…
Dialogue: 0,0:23:00.75,0:23:04.63,Default,,0,0,0,,Пиё Пиё Пиё (Сунео) Бұл қымбат болды.
Dialogue: 0,0:23:04.75,0:23:08.67,Default,,0,0,0,,Ах... өте сүйкімді~
Dialogue: 0,0:23:08.80,0:23:11.13,Default,,0,0,0,,О, мен? Мен оны білемін.
Dialogue: 0,0:23:11.76,0:23:15.81,Default,,0,0,0,,Ах, мен оны жаңа ғана сатып алдым.
Dialogue: 0,0:23:15.93,0:23:18.52,Default,,0,0,0,,Ол енді түзетілмейді
Dialogue: 0,0:23:18.64,0:23:22.94,Default,,0,0,0,,Сунео, мен сені енді жібермеймін.
Dialogue: 0,0:23:23.06,0:23:24.65,Default,,0,0,0,,Жарайсың ба?
Dialogue: 0,0:23:24.77,0:23:28.36,Default,,0,0,0,,Гах! маған көмектесші!
Dialogue: 0,0:23:30.32,0:23:33.74,Default,,0,0,0,,Анашым! Тоқта, неге қашып жүрсің?
Dialogue: 0,0:23:33.87,0:23:36.20,Default,,0,0,0,,Бұл қорқынышты тиімді.
Dialogue: 0,0:23:36.33,0:23:38.50,Default,,0,0,0,,Бұл қауіпті болды.
Dialogue: 0,0:23:38.62,0:23:42.58,Default,,0,0,0,,Нобита-кун, сен неге бұл құралды пайдалануды тоқтатпайсың?
Dialogue: 0,0:23:42.71,0:23:45.00,Default,,0,0,0,,Не? Неліктен?
Dialogue: 0,0:23:45.13,0:23:48.30,Default,,0,0,0,,Сіз мұны бұрын көрдіңіз бе? Бұл жақсы емес
Dialogue: 0,0:23:48.42,0:23:51.93,Default,,0,0,0,,Мен де танымал болғым келеді.
Dialogue: 0,0:23:53.43,0:23:56.35,Default,,0,0,0,,Бұл шынымен жақсы ма?
Dialogue: 0,0:23:56.47,0:24:00.52,Default,,0,0,0,,Бұл жақсы. Жарайды, Шизука-чанды осында кіргізейік.
Dialogue: 0,0:24:00.64,0:24:02.31,Default,,0,0,0,,Бұл тек бұршақ мылтық, бірақ… Марли әскерінің қарсы шабуылының сигналы
Dialogue: 0,0:24:03.10,0:24:05.52,Default,,0,0,0,,Онда кездескенше (Декисуги) Иә, тағы кездескенше.
Dialogue: 0,0:24:06.73,0:24:09.90,Default,,0,0,0,,Ааа... Иә? Кя~!
Dialogue: 0,0:24:10.94,0:24:14.53,Default,,0,0,0,,Иә, Дораемон, бұл не? Ол қандай тесік?
Dialogue: 0,0:24:15.16,0:24:17.33,Default,,0,0,0,,«Тура тесік»
Dialogue: 0,0:24:17.45,0:24:20.91,Default,,0,0,0,,Ол Шизуканың үйінің алдыңғы есігіне қосылған.
Dialogue: 0,0:24:21.04,0:24:25.58,Default,,0,0,0,,Бұл таңқаларлық. Енді тек 15 минут күтуім керек.
Dialogue: 0,0:24:25.71,0:24:28.04,Default,,0,0,0,,А, Дораемон бір жерге кетіп қалды.
Dialogue: 0,0:24:28.17,0:24:32.17,Default,,0,0,0,,Шизука-чан шықса, бірінші саған қарасам, қиналып қаламын.
Dialogue: 0,0:24:32.30,0:24:34.80,Default,,0,0,0,,Иә иә Йотто
Dialogue: 0,0:24:35.34,0:24:36.60,Default,,0,0,0,,Хехехе
Dialogue: 0,0:24:37.43,0:24:43.02,Default,,0,0,0,,Жақында 15 минут өте ме деп ойлаймын. Шизука-чан шыққанда...
Dialogue: 0,0:24:43.14,0:24:45.90,Default,,0,0,0,,Сәлем Нобита!
Dialogue: 0,0:24:46.02,0:24:49.48,Default,,0,0,0,,Не? Осындай маңызды уақытта?
Dialogue: 0,0:24:53.20,0:24:56.07,Default,,0,0,0,,Бұл біртүрлі жұмыртқа - Дораемон, солай ма?
Dialogue: 0,0:24:56.20,0:24:58.33,Default,,0,0,0,,Сізге рахмет, мен қорқынышты жағдайдамын.
Dialogue: 0,0:24:58.45,0:24:59.78,Default,,0,0,0,,Бірдеңе жасаңыз
Dialogue: 0,0:24:59.91,0:25:01.83,Default,,0,0,0,,Мен қазір бос емеспін, кейінірек кел.
Dialogue: 0,0:25:01.95,0:25:04.79,Default,,0,0,0,,Дәл қасымда Джиан келе жатыр.
Dialogue: 0,0:25:04.92,0:25:08.54,Default,,0,0,0,,Сунэ Чан, сен қайда бардың?
Dialogue: 0,0:25:08.67,0:25:09.84,Default,,0,0,0,,Не!
Dialogue: 0,0:25:10.55,0:25:13.22,Default,,0,0,0,,Міне! Жолдан кет
Dialogue: 0,0:25:14.72,0:25:18.22,Default,,0,0,0,,Аа, дұрыс, мен ұмытып қалдым, Шизука-кун.
Dialogue: 0,0:25:22.35,0:25:24.89,Default,,0,0,0,,Асығыңыз, асығыңыз, Дорэмонға қоңырау шалыңыз.
Dialogue: 0,0:25:25.02,0:25:26.98,Default,,0,0,0,,Ол қазір жоқ.
Dialogue: 0,0:25:27.10,0:25:30.48,Default,,0,0,0,,Қайда бара жатырсың? Мені тезірек осында әкел!
Dialogue: 0,0:25:31.02,0:25:32.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:34.15,0:25:37.32,Default,,0,0,0,,Суне-чан Микке
Dialogue: 0,0:25:37.45,0:25:39.41,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:25:39.53,0:25:41.74,Default,,0,0,0,,Сен менің бәрімсің
Dialogue: 0,0:25:41.87,0:25:43.45,Default,,0,0,0,,Ол – Лорд Широ.
Dialogue: 0,0:25:43.58,0:25:46.46,Default,,0,0,0,,Маған көмектесші, анашым!
Dialogue: 0,0:25:46.58,0:25:48.21,Default,,0,0,0,,Шизука-кун
Dialogue: 0,0:25:48.33,0:25:52.21,Default,,0,0,0,,Шизука-чан!
Dialogue: 0,0:25:52.88,0:25:56.05,Default,,0,0,0,,Ноби-кун, не болып жатыр? Бұл
Dialogue: 0,0:25:56.17,0:25:58.18,Default,,0,0,0,,Қандай азап…
Dialogue: 0,0:25:59.80,0:26:00.85,Default,,0,0,0,,Ей!
Dialogue: 0,0:26:00.97,0:26:03.60,Default,,0,0,0,,(Нобитаның айқайы)
Dialogue: 0,0:26:03.72,0:26:06.64,Default,,0,0,0,,Мен үшін не істей аласың?
Dialogue: 0,0:26:06.77,0:26:09.19,Default,,0,0,0,,Сондықтан мен саған тоқта деп айттым.
Dialogue: 0,0:26:09.31,0:26:12.69,Default,,0,0,0,,Өтінемін, оны қандай да бір жолмен қалпына келтіріңіз.
Dialogue: 0,0:26:12.82,0:26:14.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:26:14.32,0:26:17.45,Default,,0,0,0,,Егер сіз мұны кисеңіз, ол қалыпты жағдайға оралады, бірақ
Dialogue: 0,0:26:17.57,0:26:20.24,Default,,0,0,0,,Жоқ? (Декисуги) Хмм...
Dialogue: 0,0:26:20.37,0:26:23.70,Default,,0,0,0,,Декисуги мырза, мені ұнататын болсам, ыңғайсыздық тудырар ма еді?
Dialogue: 0,0:26:23.83,0:26:25.16,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:26:25.83,0:26:29.17,Default,,0,0,0,,Мен де сені жақсы көремін, Шизука.
Dialogue: 0,0:26:29.29,0:26:31.92,Default,,0,0,0,,Бірақ осындай құралдарға сүйену
Dialogue: 0,0:26:32.04,0:26:35.17,Default,,0,0,0,,Жүрегіңді қозғағым келмейді
Dialogue: 0,0:26:42.64,0:26:45.77,Default,,0,0,0,,Құралдарға сенбеу...
Dialogue: 0,0:26:47.64,0:26:48.94,Default,,0,0,0,,Мен оның бетіндегі өңді көргім келеді
Dialogue: 0,0:26:49.06,0:26:50.27,Default,,0,0,0,,Маған Декисуги одан сайын ұнай бастады.
Dialogue: 0,0:26:50.27,0:26:52.61,Default,,0,0,0,,Маған Декисуги одан сайын ұнай бастады.
Dialogue: 0,0:26:50.27,0:26:52.61,Default,,0,0,0,,(Сунео мен Джианның шулы дауыстары)
Dialogue: 0,0:26:52.61,0:26:52.73,Default,,0,0,0,,(Сунео мен Джианның шулы дауыстары)
Dialogue: 0,0:26:52.73,0:26:55.03,Default,,0,0,0,,(Сунео мен Джианның шулы дауыстары)
Dialogue: 0,0:26:52.73,0:26:55.03,Default,,0,0,0,,А... жоқ...
Dialogue: 0,0:26:55.15,0:26:57.99,Default,,0,0,0,,Декисуги мырза (Декисуги) Ахаха...
Dialogue: 0,0:27:01.11,0:27:04.66,Default,,0,0,0,,Сіз күткендей Декисуги-кун.
Dialogue: 0,0:27:04.78,0:27:08.12,Default,,0,0,0,,Декисуги сияқты ештеңе жоқ.
Dialogue: 0,0:27:08.25,0:27:12.46,Default,,0,0,0,,Онымен салыстырғанда мен... га...
Dialogue: 0,0:27:16.05,0:27:20.59,Default,,0,0,0,,Салыстырмалы түрде сіз ебедейсіз, баяусыз және оқуды жек көресіз.
Dialogue: 0,0:27:20.72,0:27:22.30,Default,,0,0,0,,Мен сені жеңемін — міне, жоспар!
Dialogue: 0,0:27:22.43,0:27:24.35,Default,,0,0,0,,Әлсіз, жалқау, жалқау
Dialogue: 0,0:27:24.47,0:27:25.26,Default,,0,0,0,,Ұсталу аяқталды.
Dialogue: 0,0:27:25.39,0:27:28.43,Default,,0,0,0,,Мен дене шынықтыруға шебер емеспін, қорқақпын, немқұрайлымын.
Dialogue: 0,0:27:28.56,0:27:30.44,Default,,0,0,0,,Сенімсіз және қиын...
Dialogue: 0,0:27:35.40,0:27:38.15,Default,,0,0,0,,Оның пайдасыз болғаны сонша, Декисуги-кунға жақындай да алмайды.
Dialogue: 0,0:27:38.28,0:27:40.03,Default,,0,0,0,,Уау~
Dialogue: 0,0:27:41.91,0:27:44.32,Default,,0,0,0,,Бұлай жаман айтудың қажеті жоқ.
Dialogue: 0,0:27:44.45,0:27:48.54,Default,,0,0,0,,Сіз құралдарды пайдалансаңыз да, оның жұмыс істемейтінін білесіз.
Dialogue: 0,0:27:48.66,0:27:51.87,Default,,0,0,0,,Бірдеңені өзіңіз жасауыңыз керек
Dialogue: 0,0:27:52.00,0:27:56.13,Default,,0,0,0,,Бірдеңе... иә?
Dialogue: 0,0:27:59.63,0:28:02.26,Default,,0,0,0,,«Галактика» О!
Dialogue: 0,0:28:02.38,0:28:04.39,Default,,0,0,0,,...Олай болса.
Dialogue: 0,0:28:05.22,0:28:11.52,Default,,0,0,0,,Әй... Не істесем де, жақсы емес.
Dialogue: 0,0:28:12.06,0:28:13.85,Default,,0,0,0,,«Не болса да» деп, бас тартсам
Dialogue: 0,0:28:13.98,0:28:16.27,Default,,0,0,0,,Мәңгілік өзгеріссіз қалады
Dialogue: 0,0:28:16.40,0:28:18.61,Default,,0,0,0,,Бұл әлі де жақсы ма?
Dialogue: 0,0:28:26.62,0:28:28.20,Default,,0,0,0,,Өз өмірімді өз шарттарыммен өткіземін
Dialogue: 0,0:28:42.51,0:28:45.05,Default,,0,0,0,,110×6 бұл...
Dialogue: 0,0:28:48.22,0:28:51.85,Default,,0,0,0,,660 мүмкін бе? Сәйкес келді
Dialogue: 0,0:28:53.18,0:28:57.06,Default,,0,0,0,,120÷6 бұл... Ммм...
Dialogue: 0,0:28:57.94,0:29:00.78,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,0:29:00.90,0:29:05.57,Default,,0,0,0,,Не болды? Нобита-кун, сен таңертең ерте оқисың.
Dialogue: 0,0:29:05.70,0:29:10.08,Default,,0,0,0,,А, Дораемон, сен мені ояттың ба? Кешіріңіз
Dialogue: 0,0:29:10.87,0:29:13.46,Default,,0,0,0,,Мен көп нәрсені ойладым.
Dialogue: 0,0:29:13.58,0:29:15.58,Default,,0,0,0,,Әзірге келесі сынақ
Dialogue: 0,0:29:15.71,0:29:18.88,Default,,0,0,0,,0 ұпай алмауға бар күшімді саламын.
Dialogue: 0,0:29:20.92,0:29:22.59,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:29:26.18,0:29:29.10,Default,,0,0,0,,Бұл шынымен де проблема. Егер сіз ана болсаңыз, маған қалта ақшасын беруіңіз керек... Иә?
Dialogue: 0,0:29:29.22,0:29:32.60,Default,,0,0,0,,Не? иә? Мен Нобита болсам да оқимын.
Dialogue: 0,0:29:32.72,0:29:35.48,Default,,0,0,0,,Ноби-чан керемет~
Dialogue: 0,0:29:35.60,0:29:37.56,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:29:38.73,0:29:39.69,Default,,0,0,0,,Кішкентай шайтанның тартымдылығы
Dialogue: 0,0:29:39.81,0:29:41.82,Default,,0,0,0,,What is 120÷3? (Nobita) 40
Dialogue: 0,0:29:41.94,0:29:43.99,Default,,0,0,0,,13×5 ше? (Nobita) 65
Dialogue: 0,0:29:44.11,0:29:45.99,Default,,0,0,0,,What about 25×3? (Нобита) 75
Dialogue: 0,0:29:46.11,0:29:47.70,Default,,0,0,0,,800÷4 деген не?
Dialogue: 0,0:29:48.45,0:29:51.45,Default,,0,0,0,,14×2 is...
Dialogue: 0,0:29:52.08,0:29:54.37,Default,,0,0,0,,12÷3 бұл...
Dialogue: 0,0:29:54.50,0:29:58.12,Default,,0,0,0,,Нобита-кун, ертеңгі сынаққа бар күшіңді сал.
Dialogue: 0,0:29:58.25,0:30:00.59,Default,,0,0,0,,Жақсы ұпай алатындарыңызға сенімдімін.
Dialogue: 0,0:30:10.89,0:30:14.02,Default,,0,0,0,,Иә (Нобита) Иә, хехехе...
Dialogue: 0,0:30:14.14,0:30:16.56,Default,,0,0,0,,Иә Сунео Уфуфу...
Dialogue: 0,0:30:16.68,0:30:20.61,Default,,0,0,0,,Бұл не? Нобита, бұл жиіркенішті.
Dialogue: 0,0:30:21.15,0:30:24.86,Default,,0,0,0,,Мен бұл жолы сәл басқашамын деп ойлаймын.
Dialogue: 0,0:30:24.98,0:30:28.32,Default,,0,0,0,,Өздігінен жақсы балл алсаң, мен сені кешірмеймін.
Dialogue: 0,0:30:28.45,0:30:33.91,Default,,0,0,0,,Ахахахха қазір кешірім сұраймын кешіріңіз~
Dialogue: 0,0:30:34.04,0:30:36.45,Default,,0,0,0,,Yes Start
Dialogue: 0,0:30:37.16,0:30:39.46,Default,,0,0,0,,Иә? Ах
Dialogue: 0,0:30:39.58,0:30:43.71,Default,,0,0,0,,Сонымен... бұл... неге?
Dialogue: 0,0:30:47.76,0:30:51.64,Default,,0,0,0,,Nobi 0 points
Dialogue: 0,0:30:52.35,0:30:55.85,Default,,0,0,0,,Бұл неше рет болды? (Nobita) I'm sorry.
Dialogue: 0,0:30:55.97,0:31:00.90,Default,,0,0,0,,Ха... Осы бағалармен мен бастауыш мектепті бітіре алмаймын.
Dialogue: 0,0:31:01.02,0:31:04.40,Default,,0,0,0,,Сіздің мұғаліміңіз сіздің болашағыңызға шынымен алаңдайды.
Dialogue: 0,0:31:04.52,0:31:07.65,Default,,0,0,0,,Ах~ Не дегенмен Нобита-кун осында.
Dialogue: 0,0:31:07.78,0:31:09.82,Default,,0,0,0,,Мен де жеңілдеп қалдым.
Dialogue: 0,0:31:09.95,0:31:13.66,Default,,0,0,0,,Не айтып тұрсың, Гоуда? Сіз де 10 ұпай алдыңыз.
Dialogue: 0,0:31:13.78,0:31:15.74,Default,,0,0,0,,Көп өзгермейді.
Dialogue: 0,0:31:19.50,0:31:22.04,Default,,0,0,0,,Nobita-kun!
Dialogue: 0,0:31:23.92,0:31:25.59,Default,,0,0,0,,How was the test?
Dialogue: 0,0:31:25.71,0:31:26.88,Default,,0,0,0,,Маған бәрібір
Dialogue: 0,0:31:27.01,0:31:29.80,Default,,0,0,0,,Тағы да~ Мен осылай оқыдым.
Dialogue: 0,0:31:29.92,0:31:31.93,Default,,0,0,0,,Бұл өте жақсы мәселе болды, солай емес пе?
Dialogue: 0,0:31:32.05,0:31:35.89,Default,,0,0,0,,Айтқым келмейді, таусылып қалдым.
Dialogue: 0,0:31:36.01,0:31:39.56,Default,,0,0,0,,Йо~ши «Торийоза сөмкесі»
Dialogue: 0,0:31:39.68,0:31:42.19,Default,,0,0,0,,Енді жауаптарды Нобитаның мектеп сөмкесінен таба аласыз.
Dialogue: 0,0:31:42.31,0:31:44.27,Default,,0,0,0,,Order it!
Dialogue: 0,0:31:45.02,0:31:48.03,Default,,0,0,0,,Бұл канжи тесті ме?
Dialogue: 0,0:31:48.90,0:31:53.03,Default,,0,0,0,,Нобита-кун арифметиканы оқыды, солай ма?
Dialogue: 0,0:31:55.53,0:32:00.08,Default,,0,0,0,,Wow, I don't want it anymore.
Dialogue: 0,0:32:00.20,0:32:03.58,Default,,0,0,0,,Мен өзімді жек көре бастадым.
Dialogue: 0,0:32:03.71,0:32:07.75,Default,,0,0,0,,Nobita-kun, leave me alone.
Dialogue: 0,0:32:12.05,0:32:15.26,Default,,0,0,0,,Уау (ана) Жүгіру қауіпті.
Dialogue: 0,0:32:15.39,0:32:16.22,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:32:16.35,0:32:18.68,Default,,0,0,0,,Эй, эй, жақсысың ба?
Dialogue: 0,0:32:18.81,0:32:19.77,Default,,0,0,0,,(Баланың жылауы)
Dialogue: 0,0:32:19.77,0:32:22.14,Default,,0,0,0,,(Баланың жылауы)
Dialogue: 0,0:32:19.77,0:32:22.14,Default,,0,0,0,,Ахахха мен көмектесе алмаймын
Dialogue: 0,0:32:22.27,0:32:25.65,Default,,0,0,0,,Жарайды, онда Кото-чанды иығыма көтеріп алайық.
Dialogue: 0,0:32:25.77,0:32:28.61,Default,,0,0,0,,(Балалардың күлкісі)
Dialogue: 0,0:32:33.70,0:32:35.70,Default,,0,0,0,,Э? Хмм…
Dialogue: 0,0:32:36.70,0:32:39.99,Default,,0,0,0,,О? Нобита-сан, сен не істеп жатырсың?
Dialogue: 0,0:32:40.12,0:32:41.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:32:45.42,0:32:47.21,Default,,0,0,0,,Strange person
Dialogue: 0,0:32:48.17,0:32:50.38,Default,,0,0,0,,Анашым, сізден бір жақсылығым бар.
Dialogue: 0,0:32:50.51,0:32:51.97,Default,,0,0,0,,Мен ештеңе сатып алмаймын.
Dialogue: 0,0:32:52.09,0:32:53.63,Default,,0,0,0,,That's not it.
Dialogue: 0,0:32:53.76,0:32:56.47,Default,,0,0,0,,Әй, сен неге қозғалмайсың? somewhere far away
Dialogue: 0,0:32:56.59,0:32:58.43,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:32:58.55,0:33:00.52,Default,,0,0,0,,Мен неге көшуім керек?
Dialogue: 0,0:33:00.64,0:33:05.31,Default,,0,0,0,,Егер бұл жұмыс істемесе, маған шетелде оқуға рұқсат етіңіз, мысалы Америкада.
Dialogue: 0,0:33:05.44,0:33:08.27,Default,,0,0,0,,Тым көп бос сөз айтсаң
Dialogue: 0,0:33:08.40,0:33:09.90,Default,,0,0,0,,I'll be angry!
Dialogue: 0,0:33:13.32,0:33:15.86,Default,,0,0,0,,Егер бұл орын алса, тек сіздің ерік-жігеріңіздің күші
Dialogue: 0,0:33:15.99,0:33:17.49,Default,,0,0,0,,Бірдеңе істеу керек
Dialogue: 0,0:33:18.32,0:33:21.74,Default,,0,0,0,,Нобита-кун, сен керемет жұмыс жасадың.
Dialogue: 0,0:33:21.87,0:33:24.04,Default,,0,0,0,,Сәтсіздік нені білдіреді?
Dialogue: 0,0:33:24.16,0:33:26.67,Default,,0,0,0,,Басқалар не істей алады, тек сіз оны жасай алмайсыз.
Dialogue: 0,0:33:26.79,0:33:27.75,Default,,0,0,0,,Are there any
Dialogue: 0,0:33:27.88,0:33:29.21,Default,,0,0,0,,Міне, болды.
Dialogue: 0,0:33:29.75,0:33:31.71,Default,,0,0,0,,Сіз басқалардың айтқанын тыңдайсыз ба?
Dialogue: 0,0:33:31.84,0:33:34.80,Default,,0,0,0,,Wow, that's it!
Dialogue: 0,0:33:35.72,0:33:38.14,Default,,0,0,0,,Бұл жеткілікті, иә?
Dialogue: 0,0:33:38.26,0:33:39.93,Default,,0,0,0,,Жетеді.
Dialogue: 0,0:33:40.05,0:33:43.31,Default,,0,0,0,,Мен Шизука-чанға тұрмысқа шығудан бас тартамын.
Dialogue: 0,0:33:43.43,0:33:47.06,Default,,0,0,0,,Не? неге? Did you start hating it?
Dialogue: 0,0:33:47.19,0:33:50.11,Default,,0,0,0,,Мен оны өте жақсы көремін!
Dialogue: 0,0:33:51.15,0:33:55.15,Default,,0,0,0,,Сол баланың арқасында мен өмір сүре аламын.
Dialogue: 0,0:33:56.36,0:33:59.45,Default,,0,0,0,,Онда неге бұлай...
Dialogue: 0,0:33:59.57,0:34:01.70,Default,,0,0,0,,Мен бұл туралы көп ойладым.
Dialogue: 0,0:34:02.24,0:34:04.75,Default,,0,0,0,,Менің әйелім болсаң
Dialogue: 0,0:34:04.87,0:34:07.83,Default,,0,0,0,,Шизука өмірінің соңына дейін қиналады.
Dialogue: 0,0:34:09.50,0:34:14.34,Default,,0,0,0,,Осы уақытқа дейін мен өзімді ғана ойладым.
Dialogue: 0,0:34:14.46,0:34:18.93,Default,,0,0,0,,Бірақ егер сізге Шизука-чан шынымен ұнаса
Dialogue: 0,0:34:20.55,0:34:23.14,Default,,0,0,0,,Менсіз жақсырақ
Dialogue: 0,0:34:25.85,0:34:28.73,Default,,0,0,0,,Шизука-чаннан кету қиын.
Dialogue: 0,0:34:29.27,0:34:32.15,Default,,0,0,0,,Бірақ мен үшін
Dialogue: 0,0:34:32.27,0:34:36.24,Default,,0,0,0,,Шизука-чанның бақытсыздығын көру одан да ауыр.
Dialogue: 0,0:34:40.49,0:34:43.12,Default,,0,0,0,,Шизука Нобита-кун.
Dialogue: 0,0:34:43.24,0:34:44.45,Default,,0,0,0,,Сіз қазір шомылып жатырсыз ба?
Dialogue: 0,0:34:44.58,0:34:46.04,Default,,0,0,0,,Кеше болған жайтқа әлі де алаңдайсың ба?
Dialogue: 0,0:34:46.16,0:34:49.00,Default,,0,0,0,,Мен жаңа ғана алған кітабымды қайтаруға келдім.
Dialogue: 0,0:34:49.71,0:34:55.00,Default,,0,0,0,,Мен әрқашан Шизука-чанға бақыт тілеймін.
Dialogue: 0,0:34:55.55,0:34:57.13,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:34:57.26,0:35:01.72,Default,,0,0,0,,Шизука-чанға қош айтыңыз
Dialogue: 0,0:35:01.84,0:35:04.81,Default,,0,0,0,,А... Нобита-сан?
Dialogue: 0,0:35:14.15,0:35:16.69,Default,,0,0,0,,Бұл жақсы. Бұл жақсы.
Dialogue: 0,0:35:16.82,0:35:18.40,Default,,0,0,0,,Нобита-сан
Dialogue: 0,0:35:25.79,0:35:29.87,Default,,0,0,0,,Не болды? Нобита-сан, сен бір нәрсеге ашуланып тұрсың ба?
Dialogue: 0,0:35:30.00,0:35:31.25,Default,,0,0,0,,Сұрамаңыз
Dialogue: 0,0:35:31.37,0:35:34.00,Default,,0,0,0,,Қайта кездеспегеніміз жақсы.
Dialogue: 0,0:35:34.13,0:35:37.38,Default,,0,0,0,,Мен барған сайын қызығып барамын, өйткені мен саған айтпайынша сені тастамаймын.
Dialogue: 0,0:35:37.51,0:35:41.18,Default,,0,0,0,,А, мен не істеуім керек?
Dialogue: 0,0:35:42.76,0:35:44.85,Default,,0,0,0,,Мені көбірек жек көру керек
Dialogue: 0,0:35:53.86,0:35:57.40,Default,,0,0,0,,Ах... Кя~ Нобитаның жынысы!
Dialogue: 0,0:35:59.15,0:36:00.28,Default,,0,0,0,,Мен оны жек көремін!
Dialogue: 0,0:36:04.74,0:36:07.41,Default,,0,0,0,,Бұл өте маңызды.
Dialogue: 0,0:36:08.74,0:36:11.00,Default,,0,0,0,,Мен енді Нобита-санды танымаймын.
Dialogue: 0,0:36:19.26,0:36:23.05,Default,,0,0,0,,Бұл жақсы, бірақ ауырады.
Dialogue: 0,0:36:23.63,0:36:27.14,Default,,0,0,0,,А, Ноби-кун, не болды?
Dialogue: 0,0:36:28.51,0:36:31.93,Default,,0,0,0,,Декисуги-кун, сен жақсы жігітсің.
Dialogue: 0,0:36:32.06,0:36:34.69,Default,,0,0,0,,Мен Шизука-чанды сұрадым.
Dialogue: 0,0:36:34.81,0:36:35.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:37.82,0:36:39.86,Default,,0,0,0,,Хмм.
Dialogue: 0,0:36:41.28,0:36:42.36,Default,,0,0,0,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,0:36:42.90,0:36:46.12,Default,,0,0,0,,Нобита-кун, дораяки жегің келе ме?
Dialogue: 0,0:36:46.24,0:36:48.33,Default,,0,0,0,,Мұндағы тағамдар дәмді.
Dialogue: 0,0:36:48.45,0:36:51.08,Default,,0,0,0,,Маған керек емес. Менің қазір көңіл-күйім жоқ.
Dialogue: 0,0:36:51.20,0:36:52.66,Default,,0,0,0,,Тістеп алыңыз.
Dialogue: 0,0:36:52.79,0:36:54.08,Default,,0,0,0,,Өйткені бұл Дораемон емес
Dialogue: 0,0:36:54.21,0:36:55.37,Default,,0,0,0,,Жай ғана жеп қойыңыз.
Dialogue: 0,0:36:55.50,0:36:58.00,Default,,0,0,0,,Табандысың, керегі жоқ дейсің.
Dialogue: 0,0:36:58.13,0:37:00.92,Default,,0,0,0,,Мен саған дораяки беретінім сирек.
Dialogue: 0,0:37:01.05,0:37:04.80,Default,,0,0,0,,Қалай болғанда да, Ноби-кунда біртүрлі нәрсе бар.
Dialogue: 0,0:37:05.64,0:37:07.01,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:37:07.68,0:37:12.14,Default,,0,0,0,,Нобитаның 0 ұпайы бұл жолы өте жақсы жауап берген сияқты.
Dialogue: 0,0:37:12.27,0:37:13.77,Default,,0,0,0,,Солай емес пе?
Dialogue: 0,0:37:13.89,0:37:17.77,Default,,0,0,0,,Егер мұғалім саған бастауыш мектепті бітіре алмайсың десе ше?
Dialogue: 0,0:37:17.90,0:37:20.40,Default,,0,0,0,,Мен сенің орнында болсам, өлгім келеді.
Dialogue: 0,0:37:20.52,0:37:21.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:21.61,0:37:25.95,Default,,0,0,0,,Шизука-чанға қош айтыңыз
Dialogue: 0,0:37:26.07,0:37:27.28,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:37:29.03,0:37:30.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:30.70,0:37:32.75,Default,,0,0,0,,Қазірдің өзінде... Нобита-сан
Dialogue: 0,0:37:32.87,0:37:34.33,Default,,0,0,0,,Бұл Шизука-чан
Dialogue: 0,0:37:34.46,0:37:38.04,Default,,0,0,0,,Сіз сондасыз ба? (Нобита) Уау! Бұл жаман!
Dialogue: 0,0:37:38.17,0:37:40.96,Default,,0,0,0,,Шық (Нобита) Дораемон, не істеуіміз керек?
Dialogue: 0,0:37:41.09,0:37:42.21,Default,,0,0,0,,Нобита-сан
Dialogue: 0,0:37:42.34,0:37:44.55,Default,,0,0,0,,Шизука-чанның мені тез жек көруіне мәжбүрлеуім керек.
Dialogue: 0,0:37:44.67,0:37:46.34,Default,,0,0,0,,Мұны тағы да айтыңыз
Dialogue: 0,0:37:46.47,0:37:49.76,Default,,0,0,0,,Егер Шизука-чан сені жек көрсе, мен де қиындыққа тап боламын.
Dialogue: 0,0:37:49.89,0:37:52.77,Default,,0,0,0,,Жарайды, бірдеңе істе.
Dialogue: 0,0:37:52.89,0:37:56.77,Default,,0,0,0,,Хмм, егер сізді шынымен жек көргіңіз келсе...
Dialogue: 0,0:37:56.89,0:37:59.27,Default,,0,0,0,,«Қателерді сканерлеу» жылдам және жылдам
Dialogue: 0,0:38:00.02,0:38:01.32,Default,,0,0,0,,Осыны ішсең, сені жек көретіні сөзсіз.
Dialogue: 0,0:38:01.32,0:38:02.94,Default,,0,0,0,,Осыны ішсең, сені жек көретіні сөзсіз.
Dialogue: 0,0:38:01.32,0:38:02.94,Default,,0,0,0,,Нобита Шизука-чан келе жатыр.
Dialogue: 0,0:38:02.94,0:38:04.53,Default,,0,0,0,,Нобита Шизука-чан келе жатыр.
Dialogue: 0,0:38:04.65,0:38:08.95,Default,,0,0,0,,Бірақ тек Шизука-чан ғана емес, саған ешкім жақындамайды.
Dialogue: 0,0:38:09.07,0:38:13.08,Default,,0,0,0,,Түсіндіңіз бе? Эй, бір-ақ тістеу жеткілікті.
Dialogue: 0,0:38:13.20,0:38:14.50,Default,,0,0,0,,Эх!
Dialogue: 0,0:38:18.96,0:38:23.71,Default,,0,0,0,,Иә? Бұл ештеңе емес, солай ма?
Dialogue: 0,0:38:24.71,0:38:28.43,Default,,0,0,0,,Оххх... уф... уф
Dialogue: 0,0:38:29.14,0:38:34.10,Default,,0,0,0,,Иә? не болды? Дораемон
Dialogue: 0,0:38:35.98,0:38:40.65,Default,,0,0,0,,Дораемон
Dialogue: 0,0:38:41.81,0:38:44.78,Default,,0,0,0,,Ой... ой... ой...
Dialogue: 0,0:38:45.65,0:38:47.95,Default,,0,0,0,,Бұл не? Бұл сезім
Dialogue: 0,0:38:48.82,0:38:50.61,Default,,0,0,0,,Жоқ... жоқ.
Dialogue: 0,0:38:50.74,0:38:56.25,Default,,0,0,0,,Жарайды... сенің жаныңда жүргенде менің жаным ауырады. Кешіріңіз!
Dialogue: 0,0:38:56.37,0:38:57.75,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:38:58.96,0:39:02.08,Default,,0,0,0,,Ue~ Ue~
Dialogue: 0,0:39:02.21,0:39:04.09,Default,,0,0,0,,Уау!
Dialogue: 0,0:39:05.67,0:39:11.76,Default,,0,0,0,,Ішімдікті көп ішкеннен кейін ауырып тұрмын...
Dialogue: 0,0:39:12.60,0:39:15.31,Default,,0,0,0,,Уф... (Нобита) Көмектесіңізші!
Dialogue: 0,0:39:15.43,0:39:16.22,Default,,0,0,0,,Ах
Dialogue: 0,0:39:26.94,0:39:29.15,Default,,0,0,0,,Артық емес...
Dialogue: 0,0:39:30.15,0:39:32.24,Default,,0,0,0,,Мен өлейін деп жатырмын...
Dialogue: 0,0:39:44.96,0:39:45.92,Default,,0,0,0,,Ах
Dialogue: 0,0:39:53.43,0:39:55.01,Default,,0,0,0,,Нобита-сан
Dialogue: 0,0:39:56.06,0:39:59.10,Default,,0,0,0,,Нобита-сан Нобита-сан!
Dialogue: 0,0:40:03.19,0:40:05.65,Default,,0,0,0,,Ши... Шизука-чан
Dialogue: 0,0:40:09.32,0:40:11.86,Default,,0,0,0,,Құсасаң жақсы болады.
Dialogue: 0,0:40:11.99,0:40:13.95,Default,,0,0,0,,Ал, жақсы...
Dialogue: 0,0:40:14.74,0:40:15.87,Default,,0,0,0,,Иә
Dialogue: 0,0:40:15.99,0:40:20.54,Default,,0,0,0,,(Анамның айқайы)
Dialogue: 0,0:40:20.66,0:40:24.04,Default,,0,0,0,,А... А? кінә?
Dialogue: 0,0:40:24.17,0:40:27.29,Default,,0,0,0,,Жоқ, мен неге жүгірдім?
Dialogue: 0,0:40:28.13,0:40:31.47,Default,,0,0,0,,А... бұл көмектесті.
Dialogue: 0,0:40:32.01,0:40:35.68,Default,,0,0,0,,Мен таң қалдым. Мен сені у ішті деп ойладым.
Dialogue: 0,0:40:35.80,0:40:36.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:40:38.60,0:40:42.14,Default,,0,0,0,,Сіз соншалықты алаңдайсыз ба? Мен туралы
Dialogue: 0,0:40:43.14,0:40:46.44,Default,,0,0,0,,Бұл табиғи, біз доспыз.
Dialogue: 0,0:40:46.56,0:40:50.61,Default,,0,0,0,,Жалпы айтқанда, сенің қыңырлығың сонша, мұғалім сені ұрсып тастады...
Dialogue: 0,0:40:52.49,0:40:56.32,Default,,0,0,0,,Нобитаның ақымақ ақымақ ақымақ
Dialogue: 0,0:40:56.95,0:40:59.91,Default,,0,0,0,,Себебі мен уайымдадым
Dialogue: 0,0:40:56.95,0:40:59.91,Default,,0,0,0,,А... Менде қорқынышты оқиға болды. Иә?
Dialogue: 0,0:40:59.91,0:41:00.04,Default,,0,0,0,,А... Менде қорқынышты оқиға болды, иә?
Dialogue: 0,0:41:00.04,0:41:02.00,Default,,0,0,0,,А... Менде қорқынышты оқиға болды, иә?
Dialogue: 0,0:41:00.04,0:41:02.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:41:02.12,0:41:05.08,Default,,0,0,0,,Е! неге?
Dialogue: 0,0:41:02.12,0:41:05.08,Default,,0,0,0,,(Нобита мен Шизуканың жылауы)
Dialogue: 0,0:41:05.08,0:41:06.46,Default,,0,0,0,,(Нобита мен Шизуканың жылауы)
Dialogue: 0,0:41:07.21,0:41:11.17,Default,,0,0,0,,Шизука-чан маған ашуланды, хехехе...
Dialogue: 0,0:41:13.30,0:41:14.88,Default,,0,0,0,,Иида-кун мен Яо-санды да құттықтаймыз.
Dialogue: 0,0:41:16.05,0:41:18.80,Default,,0,0,0,,Бүгін түнде жұлдыздар әдемі.
Dialogue: 0,0:41:21.60,0:41:23.77,Default,,0,0,0,,Хмм… күте тұрыңыз…
Dialogue: 0,0:41:23.89,0:41:26.02,Default,,0,0,0,,Не? Не болды?
Dialogue: 0,0:41:26.15,0:41:30.65,Default,,0,0,0,,Негізі сіздің болашағыңыз осы оқиғаға байланысты болады...
Dialogue: 0,0:41:30.77,0:41:33.15,Default,,0,0,0,,Не? Аа~ ақыры мен бас тарттым.
Dialogue: 0,0:41:33.74,0:41:35.20,Default,,0,0,0,,Не? Сен не туралы айтып тұрсың?
Dialogue: 0,0:41:35.32,0:41:38.66,Default,,0,0,0,,Мен сізге айтпаймын. Егер сіз білсеңіз, сіз әлсірейсіз.
Dialogue: 0,0:41:38.78,0:41:42.79,Default,,0,0,0,,Айтшы, сәл ғана жақсы.
Dialogue: 0,0:41:42.91,0:41:46.08,Default,,0,0,0,,Ухуху уххуху уххуху...
Dialogue: 0,0:41:46.21,0:41:48.75,Default,,0,0,0,,Айт! Не істеуім керек?
Dialogue: 0,0:41:48.88,0:41:51.21,Default,,0,0,0,,Бұл аз дегенде қытық.
Dialogue: 0,0:41:51.34,0:41:53.01,Default,,0,0,0,,Уау!
Dialogue: 0,0:41:53.13,0:41:55.55,Default,,0,0,0,,Бұл жерде жабайы жүру қауіпті.
Dialogue: 0,0:41:55.67,0:41:57.22,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:41:57.76,0:42:01.26,Default,,0,0,0,,Болашақ жақсы бағытқа қарап тұрса да
Dialogue: 0,0:42:01.39,0:42:03.72,Default,,0,0,0,,Е... не? Жақсы бағыт дегеніміз не?
Dialogue: 0,0:42:03.85,0:42:05.56,Default,,0,0,0,,Оны көргіңіз келе ме?
Dialogue: 0,0:42:06.19,0:42:08.98,Default,,0,0,0,,Көрейік Көрейік
Dialogue: 0,0:42:09.10,0:42:14.44,Default,,0,0,0,,Аа, қайда бардың?
Dialogue: 0,0:42:14.57,0:42:16.82,Default,,0,0,0,,Бұл қазіргі жағдай...
Dialogue: 0,0:42:16.95,0:42:18.99,Default,,0,0,0,,Сіздің болашағыңыз!
Dialogue: 0,0:42:19.11,0:42:20.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:42:21.78,0:42:23.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:42:24.12,0:42:26.58,Default,,0,0,0,,Бұл ересек Шизука-чан
Dialogue: 0,0:42:26.71,0:42:28.00,Default,,0,0,0,,Әдемі~
Dialogue: 0,0:42:28.12,0:42:31.34,Default,,0,0,0,,Ал ұрып жатқан бала
Dialogue: 0,0:42:31.46,0:42:34.30,Default,,0,0,0,,Сізге ұқсайды, яғни...
Dialogue: 0,0:42:35.09,0:42:36.05,Default,,0,0,0,,Ха!
Dialogue: 0,0:42:37.47,0:42:43.60,Default,,0,0,0,,Менің әйелім... Шизука-чан?
Dialogue: 0,0:42:46.18,0:42:49.69,Default,,0,0,0,,Уау Ахаха~
Dialogue: 0,0:42:50.77,0:42:54.07,Default,,0,0,0,,Банзай Банзай Банзай!
Dialogue: 0,0:42:54.19,0:42:56.40,Default,,0,0,0,,Банзай!
Dialogue: 0,0:42:57.40,0:42:59.91,Default,,0,0,0,,Рахмет сізге Doraemon
Dialogue: 0,0:43:00.03,0:43:01.70,Default,,0,0,0,,Келгеніңіз үшін рахмет.
Dialogue: 0,0:43:01.82,0:43:04.91,Default,,0,0,0,,Жоқ, бұл дұрыс емес, Нобита-кун.
Dialogue: 0,0:43:05.04,0:43:07.91,Default,,0,0,0,,Себебі жұлдыздар сияқты мүмкіндіктер бар.
Dialogue: 0,0:43:08.04,0:43:10.29,Default,,0,0,0,,Сіз мүмкіндікті пайдаландыңыз.
Dialogue: 0,0:43:11.50,0:43:13.71,Default,,0,0,0,,Менің болашағым өзгереді
Dialogue: 0,0:43:13.84,0:43:16.38,Default,,0,0,0,,Сіздің жаңа болашағыңыз
Dialogue: 0,0:43:16.51,0:43:19.72,Default,,0,0,0,,Иә, менің жаңа болашағым
Dialogue: 0,0:43:19.84,0:43:25.64,Default,,0,0,0,,Сіздің басқаларға деген жанашырлығыңыз болашақты өзгертеді.
Dialogue: 0,0:43:26.31,0:43:27.89,Default,,0,0,0,,Уау...
Dialogue: 0,0:43:32.35,0:43:34.69,Default,,0,0,0,,Сізде басқа туыстарыңыз жоқ па?
Dialogue: 0,0:43:34.82,0:43:37.36,Default,,0,0,0,,Маған тұрмысқа шығуыңызды өтінемін
Dialogue: 0,0:43:37.48,0:43:39.78,Default,,0,0,0,,Мен 100 пайыз дәлдікпен анықтай аламын
Dialogue: 0,0:43:39.90,0:43:42.87,Default,,0,0,0,,Уау, мен бірдеңе ұсындым.
Dialogue: 0,0:43:42.99,0:43:46.20,Default,,0,0,0,,Әдепсіз тентек!
Dialogue: 0,0:43:48.16,0:43:51.12,Default,,0,0,0,,(Сидзука мен Декисугидің күлкісі)
Dialogue: 0,0:43:52.92,0:43:56.88,Default,,0,0,0,,Жоқ, Нобита-сан, бұл «Золушкаға» арналған жаттығу.
Dialogue: 0,0:43:57.00,0:43:59.47,Default,,0,0,0,,Біз мұны келесі мектеп ойынында жасаймыз, солай ма?
Dialogue: 0,0:44:01.88,0:44:03.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:44:03.34,0:44:07.14,Default,,0,0,0,,Бұл жақсы емес, а~
Dialogue: 0,0:44:07.26,0:44:09.68,Default,,0,0,0,,Мен де ойланып қалғаныма сенімдімін.
Dialogue: 0,0:44:09.81,0:44:13.35,Default,,0,0,0,,Неліктен Шизука-чан сияқты жақсы қыз Нобита-кунға ұқсайды?
Dialogue: 0,0:44:13.48,0:44:16.11,Default,,0,0,0,,Жақсырақ қарсыластар көп.
Dialogue: 0,0:44:16.23,0:44:17.82,Default,,0,0,0,,Бұл тым көп!
Dialogue: 0,0:44:17.94,0:44:21.20,Default,,0,0,0,,Болашақ жақсы бағытқа қарап тұрса да
Dialogue: 0,0:44:21.32,0:44:24.45,Default,,0,0,0,,Ах... егер жағдай осылай жалғаса берсе, Шизуканың күйеу баласы...
Dialogue: 0,0:44:24.57,0:44:27.20,Default,,0,0,0,,Сіз Декисугимен аяқталуыңыз мүмкін
Dialogue: 0,0:44:27.33,0:44:30.79,Default,,0,0,0,,Егер сіз соншалықты уайымдасаңыз, оны Time TV-ден неге көрмейсіз?
Dialogue: 0,0:44:31.41,0:44:32.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:44:33.21,0:44:36.84,Default,,0,0,0,,Осы уақытқа дейін 14 жылдан кейін 25 қазанда
Dialogue: 0,0:44:36.96,0:44:40.09,Default,,0,0,0,,Балалар сендер құда түсулерің керек.
Dialogue: 0,0:44:40.21,0:44:43.13,Default,,0,0,0,,Олай болса, оған дейін біраз қарап көрейік.
Dialogue: 0,0:44:43.26,0:44:44.80,Default,,0,0,0,,Сіз оны шынымен көріп тұрсыз ба?
Dialogue: 0,0:44:47.47,0:44:49.85,Default,,0,0,0,,
Dialogue: 0,0:44:51.27,0:44:53.77,Default,,0,0,0,,Бұл жас Нобита
Dialogue: 0,0:44:53.89,0:44:55.94,Default,,0,0,0,,Әлі де әсерлі емес
Dialogue: 0,0:44:56.06,0:44:59.86,Default,,0,0,0,,Өрмелеу? Өрмелеу...
Dialogue: 0,0:44:59.98,0:45:02.15,Default,,0,0,0,,Сен барасың ба? Бармайсың ба?
Dialogue: 0,0:45:02.69,0:45:03.70,Default,,0,0,0,,Бұл Шизука-чан
Dialogue: 0,0:45:03.82,0:45:07.45,Default,,0,0,0,,Мен барғым келеді, бірақ мен төбеден жақсы емеспін.
Dialogue: 0,0:45:07.57,0:45:10.29,Default,,0,0,0,,Тегіс тау жақсы болар еді.
Dialogue: 0,0:45:10.83,0:45:13.16,Default,,0,0,0,,Ешқандай прогресс жоқ
Dialogue: 0,0:45:13.29,0:45:16.63,Default,,0,0,0,,Жақсы, мен қазір басқа достарыммен барамын.
Dialogue: 0,0:45:16.75,0:45:19.46,Default,,0,0,0,,А... а...
Dialogue: 0,0:45:20.92,0:45:22.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:45:23.09,0:45:26.26,Default,,0,0,0,,Мен оны көре алмаймын, алдымен жіберіңізші.
Dialogue: 0,0:45:28.80,0:45:29.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:45:29.89,0:45:31.81,Default,,0,0,0,,Шизука-чан жалғыз.
Dialogue: 0,0:45:31.93,0:45:34.35,Default,,0,0,0,,Қарлы боранда достарымнан ажырадым.
Dialogue: 0,0:45:34.48,0:45:37.40,Default,,0,0,0,,Мен қатты қысылып қалдым. Иә, бұл жаман.
Dialogue: 0,0:45:37.52,0:45:39.73,Default,,0,0,0,,Менің болашақ өзім не істейді?
Dialogue: 0,0:45:39.86,0:45:40.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:45:40.86,0:45:42.82,Default,,0,0,0,,Мен суық тиіп төсекте жаттым.
Dialogue: 0,0:45:43.78,0:45:45.57,Default,,0,0,0,,А, жоқ, енді жоқ
Dialogue: 0,0:45:46.95,0:45:48.95,Default,,0,0,0,,Күте тұрыңыз, түсінемін.
Dialogue: 0,0:45:49.07,0:45:51.58,Default,,0,0,0,,Енді жұмбақ шешілді...
Dialogue: 0,0:45:51.70,0:45:53.29,Default,,0,0,0,,Маған фурошики уақытын беріңіз
Dialogue: 0,0:45:53.95,0:45:57.00,Default,,0,0,0,,Жарайды, бірақ неден бастағыңыз келеді?
Dialogue: 0,0:45:57.12,0:46:00.29,Default,,0,0,0,,Осы жағына кигенде уақыт алға жылжиды, солай ма?
Dialogue: 0,0:46:00.92,0:46:04.09,Default,,0,0,0,,Хмм... иә? О?
Dialogue: 0,0:46:04.63,0:46:05.97,Default,,0,0,0,,14 жыл ғана
Dialogue: 0,0:46:06.09,0:46:08.51,Default,,0,0,0,,Бұдан былай мен осы пішіндегі уақыт машинасын мінемін.
Dialogue: 0,0:46:08.64,0:46:10.68,Default,,0,0,0,,Сіз Шизука-чанға көмектесуге барасыз, солай ма?
Dialogue: 0,0:46:10.80,0:46:13.43,Default,,0,0,0,,«Сидзука-чан, жақсысың ба?» Сосын Шизука-чан...
Dialogue: 0,0:46:13.56,0:46:15.52,Default,,0,0,0,,«Нобита-сан, сен сенімдісің».
Dialogue: 0,0:46:15.64,0:46:19.06,Default,,0,0,0,,Мен сенің үйленетініңе сенімдімін.
Dialogue: 0,0:46:19.19,0:46:21.36,Default,,0,0,0,,Хохохохо...
Dialogue: 0,0:46:21.48,0:46:24.36,Default,,0,0,0,,Бұл жақсы жұмыс істей ме?
Dialogue: 0,0:46:24.49,0:46:26.61,Default,,0,0,0,,Күте тұрыңыз, мен дайындалайын.
Dialogue: 0,0:46:27.70,0:46:29.20,Default,,0,0,0,,Дайындық дұрыс
Dialogue: 0,0:46:29.87,0:46:32.87,Default,,0,0,0,,Кел, кел, болашаққа тез барайық Кел, кел, кел
Dialogue: 0,0:46:32.99,0:46:35.58,Default,,0,0,0,,Эй, сәл күте тұрыңыз...
Dialogue: 0,0:46:36.21,0:46:38.96,Default,,0,0,0,,Амансың ба? Мен бұл туралы ғана ойлап жүрмін
Dialogue: 0,0:46:39.08,0:46:42.34,Default,,0,0,0,,Уақыт машинасын пайдалансаңыз, болашақты қайтадан өзгертуге болады.
Dialogue: 0,0:46:43.00,0:46:43.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:46:43.96,0:46:47.80,Default,,0,0,0,,Ол әрқашан жақсы бағытта бола бермейді.
Dialogue: 0,0:46:47.93,0:46:50.89,Default,,0,0,0,,Doraemon - бұл асыра сілтеу.
Dialogue: 0,0:46:51.43,0:46:53.22,Default,,0,0,0,,Мен тез көмекке баруым керек.
Dialogue: 0,0:46:55.22,0:46:57.27,Default,,0,0,0,,Itte~
Dialogue: 0,0:46:58.35,0:46:59.39,Default,,0,0,0,,Осы жерден құлап кетсем
Dialogue: 0,0:46:59.52,0:47:01.94,Default,,0,0,0,,Кеңістік пен уақыттың тұңғиығында мәңгілік адасып кетесің.
Dialogue: 0,0:47:02.06,0:47:03.73,Default,,0,0,0,,Мықтап ұстаңыз
Dialogue: 0,0:47:04.44,0:47:06.82,Default,,0,0,0,,Иә, онда кеттік.
Dialogue: 0,0:47:06.94,0:47:11.91,Default,,0,0,0,,(Нобитаның айқайы)
Dialogue: 0,0:47:17.87,0:47:19.37,Default,,0,0,0,,Уау!
Dialogue: 0,0:47:21.46,0:47:22.42,Default,,0,0,0,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,0:47:23.17,0:47:24.88,Default,,0,0,0,,Уф...
Dialogue: 0,0:47:25.67,0:47:28.09,Default,,0,0,0,,Мен әжетханаға айналдым.
Dialogue: 0,0:47:28.80,0:47:32.68,Default,,0,0,0,,14 жылдан кейін бұл аумақ саябақ болады.
Dialogue: 0,0:47:32.80,0:47:35.31,Default,,0,0,0,,Сіз көп өзгердіңіз.
Dialogue: 0,0:47:35.43,0:47:39.35,Default,,0,0,0,,Енді мен кетуім керек Эй, мынаны шығар, бұл барлық жерде есік.
Dialogue: 0,0:47:39.48,0:47:43.06,Default,,0,0,0,,Сіз адамдармен қарым-қатынаста өте нашарсыз.
Dialogue: 0,0:47:43.77,0:47:46.61,Default,,0,0,0,,Шизука-чанға байлау
Dialogue: 0,0:47:52.28,0:47:53.74,Default,,0,0,0,,Табылды
Dialogue: 0,0:47:54.62,0:47:57.04,Default,,0,0,0,,Бұдан былай менімен араласпа.
Dialogue: 0,0:47:57.16,0:47:59.41,Default,,0,0,0,,Мен саған өз күшіммен көмектесемін.
Dialogue: 0,0:48:00.00,0:48:02.25,Default,,0,0,0,,Шизука-чан
Dialogue: 0,0:48:02.37,0:48:04.63,Default,,0,0,0,,Ал, сәттілік
Dialogue: 0,0:48:11.55,0:48:13.80,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:48:13.93,0:48:17.39,Default,,0,0,0,,Шизука-чан Уау
Dialogue: 0,0:48:18.68,0:48:20.14,Default,,0,0,0,,Егер ол ондаған күн бойы осылай көңілді жүретін болса, онда Киса қалыпты емес болар еді.
Dialogue: 0,0:48:21.44,0:48:22.64,Default,,0,0,0,,Шизу…
Dialogue: 0,0:48:23.44,0:48:26.94,Default,,0,0,0,,Таудағы күркеге дейін әлі ұзақ...
Dialogue: 0,0:48:27.07,0:48:28.73,Default,,0,0,0,,Шизу... Уау
Dialogue: 0,0:48:28.86,0:48:33.49,Default,,0,0,0,,Бұл өте жаман. Барлығынан бөлек тұрғанымызға үш сағат болды.
Dialogue: 0,0:48:35.45,0:48:37.41,Default,,0,0,0,,Шизука-чан ах
Dialogue: 0,0:48:37.53,0:48:39.45,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:48:39.58,0:48:42.79,Default,,0,0,0,,Бұл менмін... Бұл Нобита.
Dialogue: 0,0:48:42.92,0:48:44.75,Default,,0,0,0,,Иә? (Нобита) Фуфун
Dialogue: 0,0:48:45.29,0:48:48.09,Default,,0,0,0,,Нобита-сан, сен не айтып тұрсың?
Dialogue: 0,0:48:49.55,0:48:51.80,Default,,0,0,0,,Бәрі жақсы, Шизука-чан
Dialogue: 0,0:48:51.92,0:48:54.68,Default,,0,0,0,,Енді мен мұндамын, бәрі жақсы
Dialogue: 0,0:48:54.80,0:48:58.51,Default,,0,0,0,,Біріншіден, қарда адасып қалсаңыз, кездейсоқ жүрмеңіз.
Dialogue: 0,0:48:58.64,0:49:02.89,Default,,0,0,0,,Картаны міндетті түрде қарап шығыңыз Бұл ақылға қонымды
Dialogue: 0,0:49:05.77,0:49:08.19,Default,,0,0,0,,Иә? Иә?
Dialogue: 0,0:49:08.90,0:49:13.45,Default,,0,0,0,,Бұл дүние картасы, шамасы, Нобита-сан.
Dialogue: 0,0:49:15.03,0:49:18.41,Default,,0,0,0,,Бұл автокомпас сізге бағытты айтады, сондықтан бәрі жақсы.
Dialogue: 0,0:49:19.03,0:49:21.70,Default,,0,0,0,,Менде... Менде осындай нәрсе бар.
Dialogue: 0,0:49:27.50,0:49:30.13,Default,,0,0,0,,Амансың ба? (Нобита) Иә
Dialogue: 0,0:49:31.13,0:49:34.01,Default,,0,0,0,,Кішкентай кезімде, осындай кездері
Dialogue: 0,0:49:34.13,0:49:36.51,Default,,0,0,0,,Дора-чан маған әрқашан көмектесетін.
Dialogue: 0,0:49:37.05,0:49:38.10,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:49:38.22,0:49:40.35,Default,,0,0,0,,Не? Не?
Dialogue: 0,0:49:41.31,0:49:44.02,Default,,0,0,0,,Қызық, Дора-чанның жағдайы қалай?
Dialogue: 0,0:49:45.23,0:49:48.94,Default,,0,0,0,,Жүр... Ол ұйықтап жатқан шығар.
Dialogue: 0,0:49:50.57,0:49:54.74,Default,,0,0,0,,Нобита-сан, сен не айтып тұрсың? Бұл біртүрлі.
Dialogue: 0,0:49:54.86,0:49:56.07,Default,,0,0,0,,Бала сияқты
Dialogue: 0,0:49:56.24,0:49:58.16,Default,,0,0,0,,Балалар? Сіз білдіңіз бе?
Dialogue: 0,0:49:58.28,0:50:01.54,Default,,0,0,0,,Мұнда жартас үңгір бар. Демалайық.
Dialogue: 0,0:50:04.25,0:50:07.62,Default,,0,0,0,,Амансың ба? Қарлы тауда адасып кетудің ең қорқыныштысы - аяздан өлу.
Dialogue: 0,0:50:07.75,0:50:10.34,Default,,0,0,0,,От жағу арқылы дене қызуын көтеріңіз
Dialogue: 0,0:50:11.96,0:50:14.46,Default,,0,0,0,,Сіріңке суға малынған.
Dialogue: 0,0:50:14.59,0:50:18.09,Default,,0,0,0,,Мәселе жоқ, мен отты қалай жағу керектігін білемін.
Dialogue: 0,0:50:18.72,0:50:21.22,Default,,0,0,0,,Ағашты ағашқа сүртсеңіз болғаны.
Dialogue: 0,0:50:21.35,0:50:23.85,Default,,0,0,0,,(Ағаштың үйкелу дыбысы)
Dialogue: 0,0:50:21.35,0:50:23.85,Default,,0,0,0,,Әйтеуір жақсы жағы осында
Dialogue: 0,0:50:23.85,0:50:25.68,Default,,0,0,0,,Әйтеуір жақсы жағы осында
Dialogue: 0,0:50:25.81,0:50:27.89,Default,,0,0,0,,Мен сізге көрсетуім керек!
Dialogue: 0,0:50:29.02,0:50:30.90,Default,,0,0,0,,Жақсы емес.
Dialogue: 0,0:50:31.02,0:50:33.03,Default,,0,0,0,,Сонымен, оттықты қолдану керек пе?
Dialogue: 0,0:50:33.65,0:50:34.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:50:39.36,0:50:42.28,Default,,0,0,0,,Егер сізде оттық болса, мүмкіндігінше тезірек хабарлаңыз.
Dialogue: 0,0:50:43.29,0:50:45.75,Default,,0,0,0,,Жаман, себебі сен қатты толқыдың.
Dialogue: 0,0:50:45.87,0:50:49.50,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:50:49.62,0:50:51.33,Default,,0,0,0,,Мүмкін сізге суық тиген шығар?
Dialogue: 0,0:50:52.46,0:50:55.92,Default,,0,0,0,,Мен аздап ауырып тұрмын, бірақ бұл маңызды емес.
Dialogue: 0,0:50:56.67,0:50:58.43,Default,,0,0,0,,Менің болашақ өзімді жұқтырды.
Dialogue: 0,0:50:58.55,0:51:01.34,Default,,0,0,0,,Иә? (Нобита) Жоқ, бұл ештеңе емес.
Dialogue: 0,0:51:01.47,0:51:03.93,Default,,0,0,0,,Мені шақыруға келгеніңіз үшін кешіріңіз.
Dialogue: 0,0:51:04.06,0:51:06.93,Default,,0,0,0,,Мен суық тиіп қалдым, сол себепті болар деп ойладым.
Dialogue: 0,0:51:07.06,0:51:10.94,Default,,0,0,0,,Уайымдамаңыз, бұл менің денсаулығымдағы мәселе.
Dialogue: 0,0:51:11.06,0:51:13.73,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:51:14.94,0:51:18.45,Default,,0,0,0,,А, мынаны киіп ал, қарсы емеспін.
Dialogue: 0,0:51:20.11,0:51:22.24,Default,,0,0,0,,Ылғалға малынған мысық
Dialogue: 0,0:51:22.37,0:51:24.74,Default,,0,0,0,,Сіздің киіміңіз де дымқыл емес пе?
Dialogue: 0,0:51:24.87,0:51:26.62,Default,,0,0,0,,Суық емес пе?
Dialogue: 0,0:51:26.75,0:51:29.96,Default,,0,0,0,,Енді ойлап қарасам... Әй, суық екен.
Dialogue: 0,0:51:30.08,0:51:32.33,Default,,0,0,0,,Киіміңді шешпесең өлесің.
Dialogue: 0,0:51:32.92,0:51:34.63,Default,,0,0,0,,Киімді ауыстыруға болмайды
Dialogue: 0,0:51:35.75,0:51:37.76,Default,,0,0,0,,Менде аман қалу парағы бар.
Dialogue: 0,0:51:38.30,0:51:41.38,Default,,0,0,0,,Бұл жаман.
Dialogue: 0,0:51:44.43,0:51:48.52,Default,,0,0,0,,Уау, бұл өте жылы.
Dialogue: 0,0:51:48.64,0:51:50.10,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:51:50.94,0:51:54.69,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:51:59.03,0:52:02.24,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:52:06.58,0:52:10.83,Default,,0,0,0,,Амансың ба? Менің суық тиюім күшейіп кетті деп ойлаймын. О, мен не істеуім керек?
Dialogue: 0,0:52:10.96,0:52:13.54,Default,,0,0,0,,Бұлай жалғаса берсе, Шизука-чан өлуі мүмкін.
Dialogue: 0,0:52:14.67,0:52:16.96,Default,,0,0,0,,Берекелі емес нәрсені айтпа.
Dialogue: 0,0:52:18.67,0:52:22.63,Default,,0,0,0,,Сонда да Нобита мүлде өзгерген жоқ.
Dialogue: 0,0:52:23.51,0:52:26.60,Default,,0,0,0,,Мен оны жай қалдырсам не болады деп ойлаймын
Dialogue: 0,0:52:26.72,0:52:28.31,Default,,0,0,0,,Мен қобалжыдым
Dialogue: 0,0:52:30.56,0:52:35.23,Default,,0,0,0,,Иә, жақсы. Келесі күні жауап беріңіз...
Dialogue: 0,0:52:36.90,0:52:38.32,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:52:39.19,0:52:40.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:52:41.11,0:52:45.91,Default,,0,0,0,,Иә? Мен сізге риза болар деп ойладым...
Dialogue: 0,0:52:46.99,0:52:48.58,Default,,0,0,0,,Мен анаммен де, әкеммен де сөйлестім—
Dialogue: 0,0:52:49.20,0:52:51.66,Default,,0,0,0,,Шизука-чан Шизука-чан!
Dialogue: 0,0:52:52.62,0:52:54.92,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:52:55.75,0:52:59.71,Default,,0,0,0,,Маған көмектес, маған көмектес, Дораемон!
Dialogue: 0,0:52:59.84,0:53:03.01,Default,,0,0,0,,Дораемон!
Dialogue: 0,0:53:03.55,0:53:08.89,Default,,0,0,0,,Уф, осындай жақсы ауа-райы мені ұйықтап жатыр.
Dialogue: 0,0:53:09.01,0:53:10.72,Default,,0,0,0,,Шизука-чан
Dialogue: 0,0:53:13.77,0:53:17.56,Default,,0,0,0,,Әйтеуір, мен сені есікке дейін апаруым керек.
Dialogue: 0,0:53:19.73,0:53:22.57,Default,,0,0,0,,Хмм...
Dialogue: 0,0:53:25.11,0:53:29.03,Default,,0,0,0,,Бұл дораяки қаншалықты дәмді?
Dialogue: 0,0:53:29.58,0:53:33.79,Default,,0,0,0,,Мии-чан да... бірге тамақтан...
Dialogue: 0,0:53:29.58,0:53:33.79,Default,,0,0,0,,(Барлық жерде дірілдеген есіктердің дыбысы)
Dialogue: 0,0:53:41.21,0:53:44.55,Default,,0,0,0,,Бұл жерде болуы керек, бірақ бұл барлық жерде есік.
Dialogue: 0,0:53:44.67,0:53:48.05,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:53:48.18,0:53:49.76,Default,,0,0,0,,Бұл не өзі! Олар кішірейіп кеткен—
Dialogue: 0,0:53:49.89,0:53:53.10,Default,,0,0,0,,Қауіпті өмірлік элементтер Пульс төмендейді
Dialogue: 0,0:53:53.23,0:53:54.48,Default,,0,0,0,,Дереу медициналық қызмет көрсетушіге хабарласыңыз
Dialogue: 0,0:53:54.48,0:53:55.69,Default,,0,0,0,,Дереу медициналық көмек көрсетушіге хабарласыңыз
Dialogue: 0,0:53:54.48,0:53:55.69,Default,,0,0,0,,Ой, не істеуім керек?
Dialogue: 0,0:53:55.81,0:53:58.65,Default,,0,0,0,,Қауіпті өмірлік элементтер Пульс төмендейді
Dialogue: 0,0:53:59.27,0:54:01.23,Default,,0,0,0,,Иә, автокомпас
Dialogue: 0,0:54:05.40,0:54:07.91,Default,,0,0,0,,Уау... Уау!
Dialogue: 0,0:54:08.99,0:54:10.49,Default,,0,0,0,,Itte~
Dialogue: 0,0:54:11.41,0:54:13.12,Default,,0,0,0,,Мен... аа...
Dialogue: 0,0:54:13.83,0:54:15.96,Default,,0,0,0,,аяғының созылуы
Dialogue: 0,0:54:16.08,0:54:20.34,Default,,0,0,0,,Ха, менде көзілдірік те жоқ, мен бұлардан ештеңе көрмеймін.
Dialogue: 0,0:54:20.46,0:54:23.92,Default,,0,0,0,,Уақыт машинасын пайдалансаңыз, болашақ қайтадан өзгереді.
Dialogue: 0,0:54:24.05,0:54:27.80,Default,,0,0,0,,Уау~ Не істеуім керек? Не істеуім керек?
Dialogue: 0,0:54:27.93,0:54:31.60,Default,,0,0,0,,Ол әрқашан жақсы бағытта бола бермейді.
Dialogue: 0,0:54:32.10,0:54:34.31,Default,,0,0,0,,Мен мұны қаламаймын.
Dialogue: 0,0:54:34.93,0:54:37.27,Default,,0,0,0,,Өтінемін, Шизука-чан өледі.
Dialogue: 0,0:54:37.39,0:54:41.40,Default,,0,0,0,,Мен оқимын немесе ойымды өзгерту үшін кез келген нәрсені істеймін.
Dialogue: 0,0:54:41.94,0:54:44.15,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:54:48.28,0:54:50.66,Default,,0,0,0,,Себебі мен бейқам сезіммен келдім.
Dialogue: 0,0:54:51.70,0:54:52.78,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:54:57.46,0:55:01.33,Default,,0,0,0,,Менің өз бетімше бірдеңе істеуден басқа амалым жоқ...
Dialogue: 0,0:55:02.00,0:55:05.34,Default,,0,0,0,,Бір амал болуы керек! Бір нәрсе!
Dialogue: 0,0:55:08.13,0:55:11.72,Default,,0,0,0,,Ха... Оған сенуден басқа амалым жоқ.
Dialogue: 0,0:55:15.47,0:55:17.98,Default,,0,0,0,,Жақсы, сағат жақсы.
Dialogue: 0,0:55:18.10,0:55:21.90,Default,,0,0,0,,Жарайды, қазір қай жыл, сағат, минут екені есімде.
Dialogue: 0,0:55:22.02,0:55:26.03,Default,,0,0,0,,Қалғаны менің болашақ өзіме байланысты. Мен өзіме сенемін.
Dialogue: 0,0:55:26.65,0:55:30.57,Default,,0,0,0,,Осы естелікті менің болашақ қызметшіме жеткізіңіз.
Dialogue: 0,0:55:30.70,0:55:32.95,Default,,0,0,0,,Осы оқиға есіңізде ме?
Dialogue: 0,0:55:33.07,0:55:37.20,Default,,0,0,0,,Өмірімдегі ең үлкен дағдарысты ұмыту мүмкін емес.
Dialogue: 0,0:55:37.33,0:55:39.41,Default,,0,0,0,,Хабарландыру туралы хабарлама
Dialogue: 0,0:55:40.04,0:55:43.00,Default,,0,0,0,,Осы жадты жеткізіңіз!
Dialogue: 0,0:56:05.19,0:56:07.23,Default,,0,0,0,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,0:56:19.62,0:56:22.08,Default,,0,0,0,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,0:56:25.88,0:56:28.84,Default,,0,0,0,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,0:56:30.80,0:56:31.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:56:34.30,0:56:36.26,Default,,0,0,0,,Эй!
Dialogue: 0,0:56:37.14,0:56:38.97,Default,,0,0,0,,Эй!
Dialogue: 0,0:56:39.10,0:56:42.89,Default,,0,0,0,,Эй, эй!
Dialogue: 0,0:56:43.02,0:56:45.06,Default,,0,0,0,,Естеліктер келді!
Dialogue: 0,0:56:47.82,0:56:51.53,Default,,0,0,0,,Эй, жақсысың ба?
Dialogue: 0,0:56:53.32,0:56:57.45,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:57:06.71,0:57:07.84,Default,,0,0,0,,
Dialogue: 0,0:57:07.96,0:57:09.21,Default,,0,0,0,,Сіз мені еске түсірдіңіз.
Dialogue: 0,0:57:09.34,0:57:13.05,Default,,0,0,0,,А, мен суық тиіп, үйде ұйықтап қалдым.
Dialogue: 0,0:57:13.17,0:57:14.84,Default,,0,0,0,,Кенет есіме түсті
Dialogue: 0,0:57:14.97,0:57:18.47,Default,,0,0,0,,Дәлірек айтқанда, естелік секіріп кеткендей болды ма?
Dialogue: 0,0:57:18.60,0:57:20.56,Default,,0,0,0,,Бұл біртүрлі сезім болды.
Dialogue: 0,0:57:21.68,0:57:25.19,Default,,0,0,0,,Мен соншалықты маңызды нәрсені қалай ұмыттым деп ойлаймын.
Dialogue: 0,0:57:25.85,0:57:28.82,Default,,0,0,0,,Осыдан кейін мен не тұра алмай, не тұра алмадым.
Dialogue: 0,0:57:28.94,0:57:30.90,Default,,0,0,0,,Мен асығыс келдім.
Dialogue: 0,0:57:31.44,0:57:32.94,Default,,0,0,0,,Бұл қорқынышты болды
Dialogue: 0,0:57:36.03,0:57:39.78,Default,,0,0,0,,Уайымдамаңыз, операция өте сәтті өтті.
Dialogue: 0,0:57:40.62,0:57:43.33,Default,,0,0,0,,Осыны өзіңізге айту біртүрлі.
Dialogue: 0,0:57:43.46,0:57:46.92,Default,,0,0,0,,Маған сенгеніңіз үшін рахмет
Dialogue: 0,0:57:50.55,0:57:53.30,Default,,0,0,0,,Өйткені мен тек сол Нобитаға ғана сене алар едім.
Dialogue: 0,0:57:53.84,0:57:57.05,Default,,0,0,0,,Маған сенім артқаныңыз үшін рахмет, Нобита-кун.
Dialogue: 0,0:57:58.93,0:58:01.72,Default,,0,0,0,,Жүр, асығайық. Мен Шизука үшін алаңдаймын.
Dialogue: 0,0:58:18.03,0:58:19.74,Default,,0,0,0,,А, мен қайтып келдім.
Dialogue: 0,0:58:26.37,0:58:27.54,Default,,0,0,0,,Әй, қалай болды?
Dialogue: 0,0:58:27.67,0:58:30.96,Default,,0,0,0,,Шизука-сан, саған қауіп төніп тұр.
Dialogue: 0,0:58:31.09,0:58:33.80,Default,,0,0,0,,Бірақ бәрібір, маған енді бұл туралы уайымдаудың қажеті жоқ.
Dialogue: 0,0:58:34.55,0:58:36.01,Default,,0,0,0,,Сізге рахмет
Dialogue: 0,0:58:36.13,0:58:39.84,Default,,0,0,0,,Соңғы кездері осы қонақүйдің сапасы сәл төмендеген сияқты…
Dialogue: 0,0:58:41.89,0:58:42.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:58:43.81,0:58:45.64,Default,,0,0,0,,О, Дораемон?
Dialogue: 0,0:58:46.60,0:58:47.56,Default,,0,0,0,,Иә
Dialogue: 0,0:58:47.69,0:58:49.10,Default,,0,0,0,,Сізге қоңырау шалайын ба?
Dialogue: 0,0:58:49.73,0:58:53.69,Default,,0,0,0,,Хмм... жоқ, тоқтайық.
Dialogue: 0,0:58:54.23,0:58:55.74,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:58:58.07,0:59:00.11,Default,,0,0,0,,Дораемон - сіздің...
Dialogue: 0,0:59:00.24,0:59:03.74,Default,,0,0,0,,Ол менің бала кездегі досым.
Dialogue: 0,0:59:04.29,0:59:08.08,Default,,0,0,0,,Doraemon-мен өткізген уақытыңызды бағалаңыз
Dialogue: 0,0:59:10.38,0:59:11.42,Default,,0,0,0,,Хакушон
Dialogue: 0,0:59:11.54,0:59:14.80,Default,,0,0,0,,Мен жақында үйге барамын. Менің ойымша, мен қайтадан ыстығым көтеріліп жатыр.
Dialogue: 0,0:59:14.92,0:59:19.30,Default,,0,0,0,,Иә, ә... рахмет.
Dialogue: 0,0:59:19.43,0:59:23.43,Default,,0,0,0,,Иә, бәрі жақсы деп үміттенемін.
Dialogue: 0,0:59:24.14,0:59:25.10,Default,,0,0,0,,Хигучи, қолыңды көтер де, көліктен шық.
Dialogue: 0,0:59:25.22,0:59:28.98,Default,,0,0,0,,Ересек Шизука-чан есінен танып кетер алдында осылай деді.
Dialogue: 0,0:59:29.94,0:59:31.90,Default,,0,0,0,,Не? Шизука?
Dialogue: 0,0:59:32.56,0:59:35.15,Default,,0,0,0,,Алдыңғы әңгіме «Жарайды»
Dialogue: 0,0:59:35.28,0:59:39.24,Default,,0,0,0,,Алдыңғы әңгіме дұрыс па? Хмм...
Dialogue: 0,0:59:39.36,0:59:41.28,Default,,0,0,0,,Не~!
Dialogue: 0,0:59:42.49,0:59:45.41,Default,,0,0,0,,Сондай-ақ... тағы да
Dialogue: 0,0:59:46.29,0:59:48.37,Default,,0,0,0,,Тағы да айтыңыз!
Dialogue: 0,0:59:48.50,0:59:50.71,Default,,0,0,0,,Сонымен ересек Шизука-чан
Dialogue: 0,0:59:50.83,0:59:54.38,Default,,0,0,0,,Соңғы рет сіз «Жарайды» дедіңіз
Dialogue: 0,0:59:54.50,0:59:58.46,Default,,0,0,0,,Бұл... Бұл...
Dialogue: 0,0:59:59.34,1:00:01.38,Default,,0,0,0,,Міне!
Dialogue: 0,1:00:01.51,1:00:05.85,Default,,0,0,0,,Ауырды, ауырады, ауырады, не болды?
Dialogue: 0,1:00:05.97,1:00:08.89,Default,,0,0,0,,Иә! Хахаха
Dialogue: 0,1:00:09.02,1:00:12.52,Default,,0,0,0,,Сіз сенімдісіз бе? Шынымен бе? Сіз шынымен солай айттыңыз ба?
Dialogue: 0,1:00:12.65,1:00:14.69,Default,,0,0,0,,Не? Не айтқың келеді?
Dialogue: 0,1:00:16.77,1:00:20.15,Default,,0,0,0,,Күні кеше мен ұсыныс жасадым.
Dialogue: 0,1:00:20.28,1:00:24.24,Default,,0,0,0,,Сен баяғы Нобитасың, бірақ істеп жатырсың.
Dialogue: 0,1:00:24.37,1:00:28.49,Default,,0,0,0,,Мен көптен бері жауап алмадым... Жарайды... Ха~
Dialogue: 0,1:00:29.04,1:00:30.96,Default,,0,0,0,,Ах~
Dialogue: 0,1:00:31.08,1:00:34.17,Default,,0,0,0,,А, жақсысың ба? Сенімен бәрі жақсы ма?
Dialogue: 0,1:00:34.88,1:00:39.38,Default,,0,0,0,,А, мен мұны істей алмаймын. Мен Шизука-санға баруым керек.
Dialogue: 0,1:00:42.43,1:00:45.55,Default,,0,0,0,,Шизука-сан!
Dialogue: 0,1:00:45.68,1:00:47.76,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,1:00:47.89,1:00:52.27,Default,,0,0,0,,Ұсыныс дұрыс болғандықтан, мен қатты ренжідім.
Dialogue: 0,1:00:52.39,1:00:55.44,Default,,0,0,0,,А, бұл дегеніміз...
Dialogue: 0,1:00:55.56,1:00:59.44,Default,,0,0,0,,Шизука-чанға үйленді!
Dialogue: 0,1:01:02.49,1:01:06.70,Default,,0,0,0,,Doraemon Ah...
Dialogue: 0,1:01:06.82,1:01:10.62,Default,,0,0,0,,Эх! Шынымен бе?
Dialogue: 0,1:01:10.75,1:01:12.21,Default,,0,0,0,,Шынымен бе? Шынымен бе?
Dialogue: 0,1:01:12.33,1:01:14.50,Default,,0,0,0,,Жақсы жұмыс!
Dialogue: 0,1:01:14.62,1:01:16.58,Default,,0,0,0,,Керемет!
Dialogue: 0,1:01:17.46,1:01:19.55,Default,,0,0,0,,Нобита-кун Нобита-кун, саған жақсы
Dialogue: 0,1:01:19.67,1:01:21.46,Default,,0,0,0,,Керемет!
Dialogue: 0,1:01:21.59,1:01:23.51,Default,,0,0,0,,(көңілді дауыс)
Dialogue: 0,1:01:25.72,1:01:27.22,Default,,0,0,0,,Нобита-кун керемет
Dialogue: 0,1:01:27.35,1:01:29.89,Default,,0,0,0,,Ия, иә!
Dialogue: 0,1:01:30.01,1:01:31.93,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:01:36.73,1:01:38.11,Default,,0,0,0,,Оны көргің келе ме?
Dialogue: 0,1:01:38.23,1:01:40.40,Default,,0,0,0,,Иә, мен оны көргім келеді.
Dialogue: 0,1:01:40.53,1:01:44.57,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:01:44.70,1:01:47.07,Default,,0,0,0,,Үйлену тойы!
Dialogue: 0,1:01:47.20,1:01:48.95,Default,,0,0,0,,(уақыт машинасының келуі дыбысы)
Dialogue: 0,1:01:49.08,1:01:49.95,Default,,0,0,0,,♪~
Dialogue: 0,1:01:50.08,1:01:52.16,Default,,0,0,0,,Бүгін үйленетін күн.
Dialogue: 0,1:01:52.91,1:01:55.87,Default,,0,0,0,,Ха~ Менің жүрегім дүрсілдеп тұр
Dialogue: 0,1:01:56.62,1:01:58.04,Default,,0,0,0,,Иә? Иә?
Dialogue: 0,1:01:59.34,1:02:01.21,Default,,0,0,0,,Мен той өтетін жерге бара жатырмын.
Dialogue: 0,1:02:01.34,1:02:04.26,Default,,0,0,0,,Мен Doraemon Takecopter-ді тез қуып жетуім керек
Dialogue: 0,1:02:04.38,1:02:05.51,Default,,0,0,0,,Мұндай жағдай болса деп, астымда бронежилет киіп жүрмін.
Dialogue: 0,1:02:09.76,1:02:11.51,Default,,0,0,0,,Сіз бірдеңеге үрейленіп тұрған сияқтысыз.
Dialogue: 0,1:02:11.64,1:02:15.56,Default,,0,0,0,,Сіз осындай уақытта кешігіп қалатын шығарсыз.
Dialogue: 0,1:02:22.73,1:02:26.28,Default,,0,0,0,,Уау~ Бұл болашақ әлем ме?
Dialogue: 0,1:02:28.07,1:02:29.70,Default,,0,0,0,,Нобита-кун алдында қарады
Dialogue: 0,1:02:29.82,1:02:32.16,Default,,0,0,0,,Не? Уау, бұл қауіпті!
Dialogue: 0,1:02:32.29,1:02:36.41,Default,,0,0,0,,(Нобитаның айқайы)
Dialogue: 0,1:02:36.54,1:02:37.71,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,1:02:38.25,1:02:40.33,Default,,0,0,0,,Нобита-кун, артта, артта! (Нобита) Е...
Dialogue: 0,1:02:40.46,1:02:44.01,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,1:02:46.34,1:02:50.55,Default,,0,0,0,,Уау~ Аа...
Dialogue: 0,1:02:51.14,1:02:55.14,Default,,0,0,0,,Уау... Уау... Уау...
Dialogue: 0,1:02:55.27,1:02:56.68,Default,,0,0,0,,Ах...
Dialogue: 0,1:02:57.52,1:02:59.15,Default,,0,0,0,,Ах...
Dialogue: 0,1:02:59.27,1:03:00.90,Default,,0,0,0,,Қайта оқу~
Dialogue: 0,1:03:02.82,1:03:03.44,Default,,0,0,0,,Ух... кешіріңіз
Dialogue: 0,1:03:03.44,1:03:04.48,Default,,0,0,0,,Ух... кешіріңіз
Dialogue: 0,1:03:03.44,1:03:04.48,Default,,0,0,0,,(әуе велосипедінің жүгіру дыбысы)
Dialogue: 0,1:03:04.48,1:03:04.61,Default,,0,0,0,,(әуе велосипедінің жүгіру дыбысы)
Dialogue: 0,1:03:04.61,1:03:05.40,Default,,0,0,0,,(әуе велосипедінің жүгіру дыбысы)
Dialogue: 0,1:03:04.61,1:03:05.40,Default,,0,0,0,,Жарайды.
Dialogue: 0,1:03:05.40,1:03:06.11,Default,,0,0,0,,Жарайды.
Dialogue: 0,1:03:11.74,1:03:13.91,Default,,0,0,0,,Жүр, кеттік (Нобита) Иә.
Dialogue: 0,1:03:21.38,1:03:25.34,Default,,0,0,0,,Кешіріңіз, мен Нобита Нобимін, кешігіп қалдым.
Dialogue: 0,1:03:26.26,1:03:30.43,Default,,0,0,0,,Сіздің үйлену тойыңыз ертеңге жоспарланған.
Dialogue: 0,1:03:30.97,1:03:33.18,Default,,0,0,0,,Эх!
Dialogue: 0,1:03:34.56,1:03:36.93,Default,,0,0,0,,1-ші күні менде түсінбеушілік болды.
Dialogue: 0,1:03:37.06,1:03:40.27,Default,,0,0,0,,Қанша жасқа келсем де, көмектеспейді.
Dialogue: 0,1:03:40.85,1:03:44.52,Default,,0,0,0,,Тоқта, онда бұл күні неге келдің?
Dialogue: 0,1:03:44.65,1:03:47.11,Default,,0,0,0,,Мен абайсызда болдым.
Dialogue: 0,1:03:47.24,1:03:49.20,Default,,0,0,0,,Сіз басқа адамдар туралы айта алмайсыз.
Dialogue: 0,1:03:49.32,1:03:51.24,Default,,0,0,0,,Мен жол бойы келдім.
Dialogue: 0,1:03:51.36,1:03:54.08,Default,,0,0,0,,Салтанатқа дайындалып жатқан Нобитаға назар аударайық.
Dialogue: 0,1:03:54.20,1:03:55.99,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,1:03:54.20,1:03:55.99,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,1:03:56.54,1:03:58.45,Default,,0,0,0,,Мұздатқыш балмұздақ жақсы-ақ, бірақ бұл да дәмді.
Dialogue: 0,1:03:59.37,1:04:00.67,Default,,0,0,0,,Сәлем Сунео
Dialogue: 0,1:04:00.79,1:04:02.17,Default,,0,0,0,,Қайдасың?
Dialogue: 0,1:04:02.29,1:04:04.09,Default,,0,0,0,,Мен бүгін бойдақ кешімді өткіземін.
Dialogue: 0,1:04:04.21,1:04:06.09,Default,,0,0,0,,Джан, сен мұны бірге жасауға уәде бергенсің.
Dialogue: 0,1:04:06.21,1:04:07.84,Default,,0,0,0,,А, алға.
Dialogue: 0,1:04:08.97,1:04:10.72,Default,,0,0,0,,(ішу дыбысы)
Dialogue: 0,1:04:10.84,1:04:12.39,Default,,0,0,0,,Пуха~
Dialogue: 0,1:04:12.51,1:04:17.47,Default,,0,0,0,,Эй, мен ертең болатынына әлі сене алмаймын, солай ма? неке
Dialogue: 0,1:04:18.81,1:04:21.52,Default,,0,0,0,,Бірақ бұл әдемі, солай емес пе?
Dialogue: 0,1:04:21.64,1:04:23.73,Default,,0,0,0,,Ертең Шизука-чан
Dialogue: 0,1:04:23.86,1:04:26.52,Default,,0,0,0,,Шизука-кун біздің кумиріміз болды
Dialogue: 0,1:04:27.86,1:04:30.57,Default,,0,0,0,,Сіз Нобиге үйленесіз бе?
Dialogue: 0,1:04:31.32,1:04:33.53,Default,,0,0,0,,Сен мені бақытты етесің
Dialogue: 0,1:04:33.66,1:04:34.70,Default,,0,0,0,,Иә
Dialogue: 0,1:04:36.41,1:04:40.83,Default,,0,0,0,,Мүмкін болса, мен сені бақытты еткім келді.
Dialogue: 0,1:04:42.50,1:04:45.67,Default,,0,0,0,,Бірақ олар: «Сіз бәрін өзіңіз жасай аласыз», - деді.
Dialogue: 0,1:04:45.79,1:04:49.80,Default,,0,0,0,,Солай ма? Декисуги, сен де?
Dialogue: 0,1:04:49.92,1:04:52.51,Default,,0,0,0,,Эй, Нобита, бір сәт сонда бол.
Dialogue: 0,1:04:52.63,1:04:54.05,Default,,0,0,0,,Иә, сонда қал.
Dialogue: 0,1:04:54.18,1:04:56.64,Default,,0,0,0,,Егер бұл Декисуги болса, мен бас тартуым мүмкін.
Dialogue: 0,1:04:56.76,1:04:59.31,Default,,0,0,0,,Неге сен? иә?
Dialogue: 0,1:04:59.43,1:05:01.52,Default,,0,0,0,,Нобитаның әдеті
Dialogue: 0,1:05:02.14,1:05:04.69,Default,,0,0,0,,Мен тым қызғанатын шығармын.
Dialogue: 0,1:05:04.81,1:05:07.02,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:05:07.65,1:05:09.03,Default,,0,0,0,,Не қызық?
Dialogue: 0,1:05:09.03,1:05:09.53,Default,,0,0,0,,Не қызық?
Dialogue: 0,1:05:09.03,1:05:09.53,Default,,0,0,0,,(жылжымалы есіктің ашылу дыбысы)
Dialogue: 0,1:05:09.53,1:05:09.65,Default,,0,0,0,,(жылжымалы есіктің ашылу дыбысы)
Dialogue: 0,1:05:09.65,1:05:10.61,Default,,0,0,0,,(жылжымалы есіктің ашылу дыбысы)
Dialogue: 0,1:05:09.65,1:05:10.61,Default,,0,0,0,,Тыныш бол, мерзімі жақын.
Dialogue: 0,1:05:10.61,1:05:12.82,Default,,0,0,0,,Тыныш бол, мерзімі жақын.
Dialogue: 0,1:05:12.95,1:05:13.95,Default,,0,0,0,,Джайко
Dialogue: 0,1:05:14.07,1:05:16.20,Default,,0,0,0,,Эй, Джайко-чан, біраз уақыт болды.
Dialogue: 0,1:05:16.32,1:05:19.41,Default,,0,0,0,,Ах, Нобита-сан, үйленуіңмен құттықтаймын.
Dialogue: 0,1:05:19.54,1:05:21.66,Default,,0,0,0,,Сонда манга суретшісі болдың ба?
Dialogue: 0,1:05:21.79,1:05:24.37,Default,,0,0,0,,Егер мен Шизуканы жылатсам
Dialogue: 0,1:05:24.50,1:05:27.21,Default,,0,0,0,,Менің қаламым өшпейді!
Dialogue: 0,1:05:28.13,1:05:31.51,Default,,0,0,0,,Білемін, білемін, көп рахмет.
Dialogue: 0,1:05:32.76,1:05:34.68,Default,,0,0,0,,Сол бақытты жүз
Dialogue: 0,1:05:34.80,1:05:37.30,Default,,0,0,0,,Тығыздау мүлдем жоқ.
Dialogue: 0,1:05:38.30,1:05:40.64,Default,,0,0,0,,Мен оны енді қарай алмаймын
Dialogue: 0,1:05:40.77,1:05:42.73,Default,,0,0,0,,Қызық, Шизука-чанның жағдайы қалай?
Dialogue: 0,1:05:42.85,1:05:45.39,Default,,0,0,0,,Бәлкім, мен абайсыз күйеуге шыққаныма өкінетін шығармын.
Dialogue: 0,1:05:45.52,1:05:46.73,Default,,0,0,0,,Мүмкін сен жылап жатқан шығарсың
Dialogue: 0,1:05:46.85,1:05:50.27,Default,,0,0,0,,Тоқташы, ау... Мен уайымдай бастадым.
Dialogue: 0,1:05:50.40,1:05:52.44,Default,,0,0,0,,Барып қарайық. О... күте тұрыңыз.
Dialogue: 0,1:05:56.07,1:05:57.66,Default,,0,0,0,,
Dialogue: 0,1:05:58.20,1:05:59.37,Default,,0,0,0,,Енгізіңіз
Dialogue: 0,1:06:01.04,1:06:05.00,Default,,0,0,0,,Әке, ертең ерте, сондықтан мен ұйықтаймын.
Dialogue: 0,1:06:05.12,1:06:06.37,Default,,0,0,0,,Жарайды, тікелей іске кірісейік. Шинигамиңді Мисакиге де көрсет.
Dialogue: 0,1:06:07.17,1:06:08.83,Default,,0,0,0,,Қалай болғанда да, мен жақында 15-ке толамын.
Dialogue: 0,1:06:09.75,1:06:12.51,Default,,0,0,0,,Иә? Бірдеңе батып бара жатыр ма?
Dialogue: 0,1:06:12.63,1:06:15.47,Default,,0,0,0,,Мен үйленетін адам сенсің, солай ма?
Dialogue: 0,1:06:17.64,1:06:19.18,Default,,0,0,0,,Жарайды, тікелей іске кірісейік. Шинигамиңді Мисакиге де көрсет.
Dialogue: 0,1:06:19.30,1:06:20.26,Default,,0,0,0,,О
Dialogue: 0,1:06:20.93,1:06:24.93,Default,,0,0,0,,А... осымен бітті ме? Мен ертең үйленемін
Dialogue: 0,1:06:25.64,1:06:29.23,Default,,0,0,0,,Керісінше, мен мұндай кезде сөйлей алмаймын...
Dialogue: 0,1:06:29.36,1:06:31.52,Default,,0,0,0,,«Адал радиотолқындар»
Dialogue: 0,1:06:32.19,1:06:33.53,Default,,0,0,0,,Бұны алған адам
Dialogue: 0,1:06:33.65,1:06:35.70,Default,,0,0,0,,Сіз әдетте айтуға ұялатын нәрселер бар.
Dialogue: 0,1:06:35.82,1:06:37.66,Default,,0,0,0,,Шындықты айт
Dialogue: 0,1:06:37.78,1:06:40.28,Default,,0,0,0,,А... Әке!
Dialogue: 0,1:06:42.87,1:06:44.45,Default,,0,0,0,,Мен үйленуді тоқтатамын.
Dialogue: 0,1:06:44.58,1:06:47.50,Default,,0,0,0,,А? (Нобита) Е, неге?
Dialogue: 0,1:06:47.62,1:06:48.83,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,1:06:48.96,1:06:50.21,Default,,0,0,0,,Не? кенеттен
Dialogue: 0,1:06:50.75,1:06:53.67,Default,,0,0,0,,Мен кеткенде сен жалғыз қаласың, солай ма?
Dialogue: 0,1:06:53.80,1:06:55.80,Default,,0,0,0,,Әрине
Dialogue: 0,1:06:55.92,1:07:00.30,Default,,0,0,0,,Мен әрқашан бұзылған және өзімшіл болдым ...
Dialogue: 0,1:07:00.85,1:07:02.72,Default,,0,0,0,,Бірақ мен
Dialogue: 0,1:07:02.85,1:07:06.14,Default,,0,0,0,,Мен анам мен әкем үшін ештеңе істей алмадым.
Dialogue: 0,1:07:08.60,1:07:10.06,Default,,0,0,0,,Төтенше
Dialogue: 0,1:07:10.60,1:07:15.40,Default,,0,0,0,,Сіз бізге тамаша сыйлық қалдырып отырсыз.
Dialogue: 0,1:07:16.65,1:07:17.86,Default,,0,0,0,,Сыйлық?
Dialogue: 0,1:07:18.57,1:07:20.91,Default,,0,0,0,,Санау үшін тым көп.
Dialogue: 0,1:07:22.24,1:07:26.75,Default,,0,0,0,,Ең бірінші сыйлық – туғаның.
Dialogue: 0,1:07:27.29,1:07:29.37,Default,,0,0,0,,Сағат 3-тер шамасында болды.
Dialogue: 0,1:07:29.50,1:07:33.42,Default,,0,0,0,,Сенің туған айқайың періштенің кернейіндей болды.
Dialogue: 0,1:07:34.17,1:07:37.38,Default,,0,0,0,,Мен мұндай әдемі әуенді естіген емеспін.
Dialogue: 0,1:07:38.38,1:07:43.26,Default,,0,0,0,,Ауруханадан шыққанда шығыстағы аспан аздап аппақ болды.
Dialogue: 0,1:07:43.39,1:07:47.93,Default,,0,0,0,,Менің басымда әлі де жұлдызды аспан болды.
Dialogue: 0,1:07:48.89,1:07:51.60,Default,,0,0,0,,Осы кең ғаламның бір бұрышында
Dialogue: 0,1:07:51.73,1:07:55.94,Default,,0,0,0,,Қаныма енген өмір енді туды.
Dialogue: 0,1:07:56.07,1:07:59.36,Default,,0,0,0,,Осыны ойласам, орынсыз қозғалып кетем.
Dialogue: 0,1:07:59.49,1:08:01.57,Default,,0,0,0,,Мен жылауымды тоқтата алмадым
Dialogue: 0,1:08:02.66,1:08:06.33,Default,,0,0,0,,Одан кейінгі әр күн қызық жыл болды.
Dialogue: 0,1:08:06.45,1:08:09.21,Default,,0,0,0,,Орындалған күндерден естеліктер
Dialogue: 0,1:08:09.33,1:08:12.42,Default,,0,0,0,,Бұл маған берген ең жақсы сыйлық болды.
Dialogue: 0,1:08:13.79,1:08:15.75,Default,,0,0,0,,Өзімді аздап жалғыз сезінсем де
Dialogue: 0,1:08:15.88,1:08:18.05,Default,,0,0,0,,Естеліктер мені жылытады
Dialogue: 0,1:08:18.59,1:08:21.68,Default,,0,0,0,,Бұл туралы уайымдаудың қажеті жоқ.
Dialogue: 0,1:08:22.84,1:08:25.22,Default,,0,0,0,,Мен уайымдаймын
Dialogue: 0,1:08:25.85,1:08:27.89,Default,,0,0,0,,Біз тіл табыса аламыз ба?
Dialogue: 0,1:08:28.02,1:08:31.85,Default,,0,0,0,,Сіз мұны істей алатыныңызға Нобита-кунға сеніңіз.
Dialogue: 0,1:08:32.39,1:08:37.15,Default,,0,0,0,,Сіз Нобитаны таңдауда дұрыс шешім қабылдадыңыз деп ойлаймын.
Dialogue: 0,1:08:37.27,1:08:41.11,Default,,0,0,0,,Ол жас жігіт ешбір керемет емес.
Dialogue: 0,1:08:41.24,1:08:47.08,Default,,0,0,0,,Бірақ біз басқалардың бақытын тілеп, басқалардың бақытсыздығына қайғыра аламыз.
Dialogue: 0,1:08:47.20,1:08:51.33,Default,,0,0,0,,Бұл адамдар үшін ең маңызды нәрсе.
Dialogue: 0,1:08:52.08,1:08:55.33,Default,,0,0,0,,Ол сізді міндетті түрде бақытты етеді.
Dialogue: 0,1:08:55.46,1:08:57.21,Default,,0,0,0,,Мен сенемін
Dialogue: 0,1:08:57.34,1:09:02.34,Default,,0,0,0,,Мен оны таңдағаныңыз үшін сізді мақтан тұтамын.
Dialogue: 0,1:09:02.47,1:09:06.55,Default,,0,0,0,,Жарайды, болашағың жарқын.
Dialogue: 0,1:09:10.18,1:09:11.31,Default,,0,0,0,,Иә
Dialogue: 0,1:09:15.56,1:09:19.48,Default,,0,0,0,,Тойды қайта көргіңіз келе ме?
Dialogue: 0,1:09:19.61,1:09:23.11,Default,,0,0,0,,Дұрыс, қазірге тез оралайық.
Dialogue: 0,1:09:23.24,1:09:26.57,Default,,0,0,0,,Мен Шидзука-чанмен кездескім келеді.
Dialogue: 0,1:09:26.70,1:09:27.87,Default,,0,0,0,,Иә
Dialogue: 0,1:09:27.99,1:09:30.95,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,1:09:37.21,1:09:39.42,Default,,0,0,0,,Не? Сізбен шұғыл сөйлесетін бір нәрсем бар.
Dialogue: 0,1:09:40.55,1:09:41.88,Default,,0,0,0,,Шизука-чан
Dialogue: 0,1:09:42.01,1:09:43.72,Default,,0,0,0,,Нобита-сан?
Dialogue: 0,1:09:45.26,1:09:49.85,Default,,0,0,0,,Мен сені бақытты ететініме сенімдімін
Dialogue: 0,1:09:50.56,1:09:53.68,Default,,0,0,0,,Мен сені міндетті түрде бақытты етемін
Dialogue: 0,1:09:53.81,1:09:55.06,Default,,0,0,0,,Иә...
Dialogue: 0,1:10:00.36,1:10:02.65,Default,,0,0,0,,Сіз кешігіп қалдыңыз, Дораемон
Dialogue: 0,1:10:02.99,1:10:07.53,Default,,0,0,0,,Ха... ха... ха!
Dialogue: 0,1:10:09.41,1:10:10.49,Default,,0,0,0,,Дораемон
Dialogue: 0,1:10:11.24,1:10:14.71,Default,,0,0,0,,Хмм... Маған Takecopter көлігін беріңізші.
Dialogue: 0,1:10:15.37,1:10:18.54,Default,,0,0,0,,Жарайды, бірақ... иә
Dialogue: 0,1:10:21.80,1:10:23.26,Default,,0,0,0,,Эй, бір секундқа осында кел
Dialogue: 0,1:10:23.38,1:10:24.97,Default,,0,0,0,,Не?
Dialogue: 0,1:10:25.72,1:10:27.30,Default,,0,0,0,,Білесіз бе, иә.
Dialogue: 0,1:10:28.80,1:10:31.18,Default,,0,0,0,,Қазір мен
Dialogue: 0,1:10:32.93,1:10:34.64,Default,,0,0,0,,Мен, иә.
Dialogue: 0,1:10:35.31,1:10:38.02,Default,,0,0,0,,Жарайды
Dialogue: 0,1:10:38.15,1:10:40.06,Default,,0,0,0,,Сонымен не?
Dialogue: 0,1:10:40.90,1:10:45.44,Default,,0,0,0,,Мен оны барлығымен бөліскім келеді...
Dialogue: 0,1:10:45.57,1:10:48.70,Default,,0,0,0,,Мен бақыттымын!
Dialogue: 0,1:10:51.12,1:10:52.83,Default,,0,0,0,,Иә?
Dialogue: 0,1:10:53.45,1:10:54.45,Default,,0,0,0,,Иә?
Dialogue: 0,1:10:54.58,1:10:57.50,Default,,0,0,0,,«Нобита-кунның бақыты» алынды
Dialogue: 0,1:10:57.62,1:10:59.50,Default,,0,0,0,,Орындалу бағдарламасы орындалды
Dialogue: 0,1:10:59.63,1:11:03.05,Default,,0,0,0,,48 сағат ішінде болашаққа оралыңыз.
Dialogue: 0,1:11:03.59,1:11:07.68,Default,,0,0,0,,Дұрыс, Севаши-кун орнатты, солай ма?
Dialogue: 0,1:11:11.51,1:11:13.85,Default,,0,0,0,,Әлсіреп қалма — жолды бөгеп тұрсың.
Dialogue: 0,1:11:14.27,1:11:17.06,Default,,0,0,0,,Менің де иығымнан жүк көтерілді.
Dialogue: 0,1:11:17.73,1:11:21.40,Default,,0,0,0,,Бұл менің үйге бара алатынымды білдіре ме?
Dialogue: 0,1:11:23.19,1:11:28.24,Default,,0,0,0,,Сіз шынымен ебедейсіз және баяусыз.
Dialogue: 0,1:11:28.78,1:11:31.12,Default,,0,0,0,,Мен оқуды жек көремін
Dialogue: 0,1:11:31.62,1:11:35.29,Default,,0,0,0,,Әлсіз және жалқау
Dialogue: 0,1:11:36.12,1:11:39.79,Default,,0,0,0,,Шаршағаным сонша, тіпті жаттығу жасай алмаймын.
Dialogue: 0,1:11:40.83,1:11:44.63,Default,,0,0,0,,Қорқақ және бейқам
Dialogue: 0,1:11:45.55,1:11:50.68,Default,,0,0,0,,Бұл сенімсіз және қиын.
Dialogue: 0,1:11:52.72,1:11:58.06,Default,,0,0,0,,Едепсіз, есте сақтау қабілеті нашар
Dialogue: 0,1:11:59.98,1:12:04.15,Default,,0,0,0,,Жақсы мінезді және жақсы мінезді
Dialogue: 0,1:12:05.15,1:12:07.11,Default,,0,0,0,,бұзылған бала
Dialogue: 0,1:12:11.57,1:12:13.78,Default,,0,0,0,,Эй!
Dialogue: 0,1:12:14.74,1:12:19.41,Default,,0,0,0,,Иә? Не істеуім керек? Мен шығындамын.
Dialogue: 0,1:12:20.46,1:12:25.42,Default,,0,0,0,,(Шырылдаған дыбыс)
Dialogue: 0,1:12:32.89,1:12:34.80,Default,,0,0,0,,Дораемон!
Dialogue: 0,1:12:32.89,1:12:34.80,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,1:12:34.93,1:12:37.18,Default,,0,0,0,,Уау!
Dialogue: 0,1:12:37.31,1:12:40.56,Default,,0,0,0,,Әй, эй, мұрныңмен спагетти жейтін құралды бер.
Dialogue: 0,1:12:40.68,1:12:44.15,Default,,0,0,0,,Қолыңнан келмесе, Алпамыс сені ұрады.
Dialogue: 0,1:12:44.27,1:12:47.52,Default,,0,0,0,,Уәде бере алмасаң, ең алдымен орындама!
Dialogue: 0,1:12:47.65,1:12:49.82,Default,,0,0,0,,Әрқашан, әрқашан маған сүйен
Dialogue: 0,1:12:49.94,1:12:52.45,Default,,0,0,0,,Неге анда-санда өзің бірдеңе жасамайсың?
Dialogue: 0,1:12:52.57,1:12:55.91,Default,,0,0,0,,Сенің ашулы болғаның не болды, Дораемон?
Dialogue: 0,1:12:56.03,1:12:58.58,Default,,0,0,0,,Не болса да, мынандай нәрсе бар!
Dialogue: 0,1:12:58.70,1:13:02.58,Default,,0,0,0,,Қиындыққа тап болсаң да мен саған енді көмектесе алмаймын.
Dialogue: 0,1:13:02.71,1:13:05.83,Default,,0,0,0,,Не? Не айтқың келеді?
Dialogue: 0,1:13:05.96,1:13:07.34,Default,,0,0,0,,Ах...
Dialogue: 0,1:13:09.42,1:13:11.84,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,1:13:12.47,1:13:17.76,Default,,0,0,0,,Негізі мен енді бұл жерде тұра алмаймын.
Dialogue: 0,1:13:19.39,1:13:21.64,Default,,0,0,0,,Бірдеңе істе!
Dialogue: 0,1:13:22.68,1:13:24.56,Default,,0,0,0,,Кешіріңіз Нобита-кун
Dialogue: 0,1:13:24.69,1:13:27.90,Default,,0,0,0,,Ертең қайтпасам өте жаман.
Dialogue: 0,1:13:28.02,1:13:29.78,Default,,0,0,0,,(Нобитаның айқайы)
Dialogue: 0,1:13:30.65,1:13:34.11,Default,,0,0,0,,Нобита, бас тарт.
Dialogue: 0,1:13:34.24,1:13:36.32,Default,,0,0,0,,Дора-чан қиыншылықта.
Dialogue: 0,1:13:36.45,1:13:39.03,Default,,0,0,0,,Маған анда-санда келіп тұрыңыз.
Dialogue: 0,1:13:39.74,1:13:42.54,Default,,0,0,0,,Бұл бағдарламада
Dialogue: 0,1:13:42.66,1:13:46.58,Default,,0,0,0,,Мен бұл дәуірге енді келе алмаймын.
Dialogue: 0,1:13:46.71,1:13:50.84,Default,,0,0,0,,Солай ма? Бұл өкінішті.
Dialogue: 0,1:13:51.51,1:13:52.30,Default,,0,0,0,,Жоқ… Оларды Эрен өлтірді!!
Dialogue: 0,1:13:52.42,1:13:55.59,Default,,0,0,0,,Жоқ, үйге барма, Дораемон!
Dialogue: 0,1:13:55.72,1:13:59.93,Default,,0,0,0,,Мүмкін болса үйге барғым келмейді.
Dialogue: 0,1:14:00.06,1:14:02.81,Default,,0,0,0,,«Мен үйге барғым келмейді» деген қате сөзді растаңыз
Dialogue: 0,1:14:02.93,1:14:04.60,Default,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан қабырғаны бұзып өтті,
Dialogue: 0,1:14:04.73,1:14:06.94,Default,,0,0,0,,Уау~ Уау...
Dialogue: 0,1:14:07.06,1:14:10.86,Default,,0,0,0,,Гя~ Мен болашаққа дұрыстап қайтамын.
Dialogue: 0,1:14:10.86,1:14:11.28,Default,,0,0,0,,Гах~ Мен болашаққа дұрыстап ораламын.
Dialogue: 0,1:14:10.86,1:14:11.28,Default,,0,0,0,,(құлау дыбысы)
Dialogue: 0,1:14:11.28,1:14:11.40,Default,,0,0,0,,(құлау дыбысы)
Dialogue: 0,1:14:11.40,1:14:12.19,Default,,0,0,0,,(құлау дыбысы)
Dialogue: 0,1:14:11.40,1:14:12.19,Default,,0,0,0,,Дораемон
Dialogue: 0,1:14:12.19,1:14:12.73,Default,,0,0,0,,Дораемон
Dialogue: 0,1:14:13.44,1:14:15.90,Default,,0,0,0,,Амансың ба? Эй Дораемон
Dialogue: 0,1:14:16.74,1:14:17.74,Default,,0,0,0,,Иә
Dialogue: 0,1:14:18.28,1:14:23.04,Default,,0,0,0,,Жетістік бағдарламасына қарсы тұра алмаймын.
Dialogue: 0,1:14:31.84,1:14:36.09,Default,,0,0,0,,Нобита-кун, мен не айтуым керек?
Dialogue: 0,1:14:40.55,1:14:43.52,Default,,0,0,0,,Оған көп тоқталмаңыз
Dialogue: 0,1:14:47.85,1:14:52.36,Default,,0,0,0,,Сіздің болашағыңыз өзгерді. Көңіл көтеру.
Dialogue: 0,1:14:53.28,1:14:56.82,Default,,0,0,0,,Дораемонсыз ешнәрсе жоқ
Dialogue: 0,1:14:56.95,1:15:00.66,Default,,0,0,0,,А... тіпті өзің де өзгердің.
Dialogue: 0,1:15:00.78,1:15:03.70,Default,,0,0,0,,Бұл кездескен кезден үлкен айырмашылық.
Dialogue: 0,1:15:06.46,1:15:07.92,Default,,0,0,0,,Я...
Dialogue: 0,1:15:09.88,1:15:14.84,Default,,0,0,0,,Бірақ мен әлі де алаңдаймын.
Dialogue: 0,1:15:15.38,1:15:20.09,Default,,0,0,0,,Мен сенің жаныңда болсам ғой.
Dialogue: 0,1:15:21.35,1:15:24.43,Default,,0,0,0,,Менсіз басқара аласыз ба?
Dialogue: 0,1:15:25.52,1:15:27.77,Default,,0,0,0,,Егер Джиан немесе Сунео сізге жағымсыз болса
Dialogue: 0,1:15:27.89,1:15:29.94,Default,,0,0,0,,Сіз мұны жалғыз жеңе аласыз ба?
Dialogue: 0,1:15:32.40,1:15:34.23,Default,,0,0,0,,Нобита-кун
Dialogue: 0,1:15:40.07,1:15:42.53,Default,,0,0,0,,Қайда бара жатырсың? (Нобита) Мені жайыма қалдыр
Dialogue: 0,1:15:42.66,1:15:43.95,Default,,0,0,0,,Нобита-кун…
Dialogue: 0,1:15:52.71,1:15:54.71,Default,,0,0,0,,Дорэмонның ақымақ
Dialogue: 0,1:15:54.84,1:15:57.97,Default,,0,0,0,,Жалғыз бірдеңе істеу мүмкін емес.
Dialogue: 0,1:15:59.51,1:16:02.93,Default,,0,0,0,,Әй, бұл Нобита емес пе?
Dialogue: 0,1:16:04.39,1:16:06.64,Default,,0,0,0,,Біз жақсы жерде кездестік.
Dialogue: 0,1:16:09.48,1:16:11.14,Default,,0,0,0,,Джан
Dialogue: 0,1:16:11.81,1:16:14.61,Default,,0,0,0,,Сонымен, сіз шешім қабылдадыңыз ба?
Dialogue: 0,1:16:15.15,1:16:17.65,Default,,0,0,0,,Сіз спагеттиді мұрынмен жейсіз бе?
Dialogue: 0,1:16:18.36,1:16:20.45,Default,,0,0,0,,Мен сені ұрып-соғамын ба?
Dialogue: 0,1:16:21.07,1:16:23.49,Default,,0,0,0,,Ах... Уау...
Dialogue: 0,1:16:23.62,1:16:24.95,Default,,0,0,0,,Маған көмектесші, Дора...
Dialogue: 0,1:16:25.08,1:16:27.37,Default,,0,0,0,,Егер Джиан немесе Сунео сізге жағымсыз болса
Dialogue: 0,1:16:27.49,1:16:29.50,Default,,0,0,0,,Сіз мұны жалғыз жеңе аласыз ба?
Dialogue: 0,1:16:29.62,1:16:30.46,Default,,0,0,0,,Ha
Dialogue: 0,1:16:31.33,1:16:33.79,Default,,0,0,0,,Эй... сәл күте тұрыңыз.
Dialogue: 0,1:16:33.92,1:16:35.25,Default,,0,0,0,,Иә?
Dialogue: 0,1:16:37.80,1:16:39.92,Default,,0,0,0,,Сіз мұны жалғыз жеңе аласыз ба?
Dialogue: 0,1:16:42.76,1:16:44.30,Default,,0,0,0,,Егер ұрысқың келсе...
Dialogue: 0,1:16:46.85,1:16:48.72,Default,,0,0,0,,Дораемонсыз жасайық
Dialogue: 0,1:16:48.85,1:16:50.93,Default,,0,0,0,,Хахахаха
Dialogue: 0,1:16:51.06,1:16:54.60,Default,,0,0,0,,Бұл керемет, мұны істеу керек.
Dialogue: 0,1:16:56.44,1:16:59.19,Default,,0,0,0,,Олай болса... Бастаймыз ба?
Dialogue: 0,1:16:59.32,1:17:02.32,Default,,0,0,0,,Ол қазірдің өзінде басталды!
Dialogue: 0,1:17:05.12,1:17:08.49,Default,,0,0,0,,Нобита-кун, қызық, тез қайтесің?
Dialogue: 0,1:17:08.62,1:17:11.16,Default,,0,0,0,,Соңғы түн болса да
Dialogue: 0,1:17:12.46,1:17:15.17,Default,,0,0,0,,Уф хахаха
Dialogue: 0,1:17:15.29,1:17:17.88,Default,,0,0,0,,Бұл қалай?
Dialogue: 0,1:17:18.00,1:17:21.01,Default,,0,0,0,,Енді маған қарсы шықпа.
Dialogue: 0,1:17:21.13,1:17:24.38,Default,,0,0,0,,Тоқта, біз әлі жеңілген жоқпыз.
Dialogue: 0,1:17:24.51,1:17:28.47,Default,,0,0,0,,Не, сен әлі ұрған жоқсың ба?
Dialogue: 0,1:17:28.60,1:17:32.10,Default,,0,0,0,,Не? Шайқас қазір басталады!
Dialogue: 0,1:17:32.89,1:17:34.02,Default,,0,0,0,,Иә! Уау
Dialogue: 0,1:17:34.14,1:17:35.65,Default,,0,0,0,,Уау!
Dialogue: 0,1:17:37.36,1:17:40.11,Default,,0,0,0,,А... ол әлі оралған жоқ.
Dialogue: 0,1:17:40.23,1:17:44.03,Default,,0,0,0,,Сіз қайда және не істеп жатырсыз?
Dialogue: 0,1:17:44.15,1:17:48.66,Default,,0,0,0,,Адамдарды ақырына дейін уайымдау... Енді жоқ!
Dialogue: 0,1:17:50.91,1:17:54.08,Default,,0,0,0,,Ха... ха...
Dialogue: 0,1:17:54.62,1:17:57.50,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл сізді жазалады ма?
Dialogue: 0,1:18:00.13,1:18:01.59,Default,,0,0,0,,Сіз елді дүр сілкіндіре білген ардагер орындаушы ретінде әйгілісіз, иә?
Dialogue: 0,1:18:02.76,1:18:04.38,Default,,0,0,0,,Иә?
Dialogue: 0,1:18:05.68,1:18:07.76,Default,,0,0,0,,Нобита-кун!
Dialogue: 0,1:18:08.30,1:18:10.60,Default,,0,0,0,,Қызық, қайда кетті?
Dialogue: 0,1:18:10.72,1:18:13.14,Default,,0,0,0,,♬~
Dialogue: 0,1:18:13.27,1:18:14.56,Default,,0,0,0,,Уф
Dialogue: 0,1:18:19.40,1:18:21.48,Default,,0,0,0,,Нобита-кун!
Dialogue: 0,1:18:24.95,1:18:28.62,Default,,0,0,0,,Көп уақыт өтті. Бұл біртүрлі.
Dialogue: 0,1:18:28.74,1:18:30.83,Default,,0,0,0,,Бұл жай ғана мәселе емес.
Dialogue: 0,1:18:33.04,1:18:35.87,Default,,0,0,0,,Мына бейбақтан құтыл.
Dialogue: 0,1:18:37.58,1:18:39.33,Default,,0,0,0,,Менің күшіммен...
Dialogue: 0,1:18:39.33,1:18:40.50,Default,,0,0,0,,Менің күшіммен...
Dialogue: 0,1:18:39.33,1:18:40.50,Default,,0,0,0,,Ноби...
Dialogue: 0,1:18:40.63,1:18:42.67,Default,,0,0,0,,Мен жеңуім керек
Dialogue: 0,1:18:48.22,1:18:50.47,Default,,0,0,0,,Дораемон...
Dialogue: 0,1:18:51.43,1:18:53.72,Default,,0,0,0,,Уайымдама...
Dialogue: 0,1:18:56.31,1:18:58.77,Default,,0,0,0,,Мен үйге бара алмаймын!
Dialogue: 0,1:18:59.69,1:19:01.65,Default,,0,0,0,,Сіз білесіз бе!
Dialogue: 0,1:19:03.69,1:19:07.49,Default,,0,0,0,,Бұл... Ол үшін уайымдамаңыз!
Dialogue: 0,1:19:07.61,1:19:09.24,Default,,0,0,0,,Уау
Dialogue: 0,1:19:09.36,1:19:15.00,Default,,0,0,0,,(Екі адам ауыр тыныс алуда)
Dialogue: 0,1:19:31.34,1:19:32.47,Default,,0,0,0,,Ах...
Dialogue: 0,1:19:34.01,1:19:35.27,Default,,0,0,0,,Уф...
Dialogue: 0,1:19:45.44,1:19:46.69,Default,,0,0,0,,Уф!
Dialogue: 0,1:19:48.86,1:19:50.82,Default,,0,0,0,,Уф...
Dialogue: 0,1:19:51.82,1:19:54.83,Default,,0,0,0,,Жарайды, бұл менің жоғалтым.
Dialogue: 0,1:19:55.54,1:19:57.16,Default,,0,0,0,,Кешір мені, Нобита
Dialogue: 0,1:20:03.71,1:20:04.80,Default,,0,0,0,,Нобита-кун
Dialogue: 0,1:20:06.30,1:20:07.80,Default,,0,0,0,,Нобита-кун
Dialogue: 0,1:20:21.60,1:20:24.56,Default,,0,0,0,,Дораэмонға қараңыз
Dialogue: 0,1:20:25.44,1:20:27.86,Default,,0,0,0,,Сонымен... мен жеңдім.
Dialogue: 0,1:20:31.11,1:20:33.74,Default,,0,0,0,,Мен жалғызбын
Dialogue: 0,1:20:35.24,1:20:41.00,Default,,0,0,0,,Енді үйге тыныш қайтуға болады, солай ма?
Dialogue: 0,1:20:44.71,1:20:48.55,Default,,0,0,0,,Дұрыс па? Дораемон
Dialogue: 0,1:20:53.47,1:20:58.43,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,1:21:20.54,1:21:24.79,Default,,0,0,0,,Нобита, таңғы асты тез іш.
Dialogue: 0,1:21:25.71,1:21:27.09,Default,,0,0,0,,Иә
Dialogue: 0,1:21:29.50,1:21:30.67,Default,,0,0,0,,Дораемон
Dialogue: 0,1:21:31.51,1:21:36.14,Default,,0,0,0,,Сіз кеткенде бөлме толығымен бос болды.
Dialogue: 0,1:21:37.60,1:21:39.26,Default,,0,0,0,,Енді барыңыз
Dialogue: 0,1:21:45.23,1:21:48.52,Default,,0,0,0,,Бірақ тез үйреніп кетесің деп ойлаймын.
Dialogue: 0,1:21:49.61,1:21:53.53,Default,,0,0,0,,Сондықтан уайымдама, Дораемон
Dialogue: 0,1:22:04.29,1:22:07.67,Default,,0,0,0,,Е! Цучиноко?
Dialogue: 0,1:22:08.29,1:22:11.30,Default,,0,0,0,,Бұл иллюзия? Бұл тамаша жаңалық емес пе?
Dialogue: 0,1:22:11.42,1:22:14.42,Default,,0,0,0,,Тыныш! қатты дауыс
Dialogue: 0,1:22:14.55,1:22:18.18,Default,,0,0,0,,Мен сені осында қуғаным үшін, мені сол жерден ұра аласың ба?
Dialogue: 0,1:22:18.30,1:22:19.97,Default,,0,0,0,,Мен оны осы жерден аламын.
Dialogue: 0,1:22:20.10,1:22:22.35,Default,,0,0,0,,Ио... Жарайды, Иитомо.
Dialogue: 0,1:22:23.10,1:22:25.44,Default,,0,0,0,,(балшықтан жасалған құбырдың дыбысы)
Dialogue: 0,1:22:25.56,1:22:27.31,Default,,0,0,0,,Иә?
Dialogue: 0,1:22:27.44,1:22:29.52,Default,,0,0,0,,Ухухуху хухуху
Dialogue: 0,1:22:29.65,1:22:33.28,Default,,0,0,0,,Уау~ Уау... Мен қатты толқып тұрмын...
Dialogue: 0,1:22:33.40,1:22:35.78,Default,,0,0,0,,(Сунеоның күлкісі)
Dialogue: 0,1:22:35.90,1:22:38.20,Default,,0,0,0,,Жақсы көрінеді!
Dialogue: 0,1:22:38.32,1:22:40.12,Default,,0,0,0,,Айтатата...
Dialogue: 0,1:22:40.24,1:22:43.54,Default,,0,0,0,,Қорқынышты Маған еркелеме.
Dialogue: 0,1:22:44.62,1:22:48.25,Default,,0,0,0,,Нобита Қиын, қиын
Dialogue: 0,1:22:48.38,1:22:51.54,Default,,0,0,0,,Нобита Нобита... сен
Dialogue: 0,1:22:51.67,1:22:54.01,Default,,0,0,0,,О... сабыр ет, тыңда.
Dialogue: 0,1:22:55.34,1:23:00.26,Default,,0,0,0,,Сіз қазір кіммен кездесті деп ойлайсыз?
Dialogue: 0,1:23:01.35,1:23:02.47,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,1:23:02.60,1:23:03.77,Default,,0,0,0,,Иә?
Dialogue: 0,1:23:04.39,1:23:08.69,Default,,0,0,0,,До-ра-э-мо-н
Dialogue: 0,1:23:10.36,1:23:11.40,Default,,0,0,0,,Дораемон
Dialogue: 0,1:23:12.11,1:23:14.23,Default,,0,0,0,,Эй, эй
Dialogue: 0,1:23:15.32,1:23:18.91,Default,,0,0,0,,Уау, хаха Дораемон Дораемон...
Dialogue: 0,1:23:22.24,1:23:24.54,Default,,0,0,0,,Дораемон!
Dialogue: 0,1:23:26.04,1:23:27.62,Default,,0,0,0,,Mom!
Dialogue: 0,1:23:27.75,1:23:30.00,Default,,0,0,0,,(Баспалдақтан жүгіру дыбысы)
Dialogue: 0,1:23:30.13,1:23:31.67,Default,,0,0,0,,(баспалдақтан құлаған дыбыс)
Dialogue: 0,1:23:32.25,1:23:33.09,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,1:23:33.21,1:23:36.55,Default,,0,0,0,,Эхехе... Жарайды, жарайды.
Dialogue: 0,1:23:36.67,1:23:38.72,Default,,0,0,0,,Әй, анашым, Дораемон келмеді ме?
Dialogue: 0,1:23:38.84,1:23:41.80,Default,,0,0,0,,Иә, Дора-чан? Қайтып келдіңіз бе?
Dialogue: 0,1:23:42.80,1:23:46.52,Default,,0,0,0,,Иә? Оның жоқтығы біртүрлі.
Dialogue: 0,1:23:47.81,1:23:51.48,Default,,0,0,0,,Жарайды, түсіндім, хи хи хи
Dialogue: 0,1:23:52.65,1:23:54.23,Default,,0,0,0,,Doraemon Telekusakute⸺
Dialogue: 0,1:23:54.36,1:23:57.24,Default,,0,0,0,,Ол тумей плащының артына тығылып жатыр.
Dialogue: 0,1:23:57.36,1:24:00.32,Default,,0,0,0,,Мен ұялмас едім ғой
Dialogue: 0,1:24:00.45,1:24:01.99,Default,,0,0,0,,Хмм.
Dialogue: 0,1:24:02.12,1:24:06.24,Default,,0,0,0,,Енді мен дораяки сатып аламын деп ойлаймын.
Dialogue: 0,1:24:07.16,1:24:10.25,Default,,0,0,0,,Осы арада Дораемон келеді деп үміттенемін.
Dialogue: 0,1:24:10.37,1:24:14.21,Default,,0,0,0,,Хехехехехехе... хахаха
Dialogue: 0,1:24:14.88,1:24:19.13,Default,,0,0,0,,Дораяки Дораяки Фуфу~н
Dialogue: 0,1:24:19.26,1:24:24.01,Default,,0,0,0,,Сіз қалай ойлайсыз? Менің өтірігім айқынырақ болды, солай емес пе?
Dialogue: 0,1:24:24.14,1:24:28.43,Default,,0,0,0,,Жоқ, мен Гота мырзадан жеңіліп қалдым.
Dialogue: 0,1:24:28.56,1:24:29.93,Default,,0,0,0,,Бұл өтірік пе?
Dialogue: 0,1:24:30.06,1:24:31.69,Default,,0,0,0,,Ухахаха
Dialogue: 0,1:24:31.81,1:24:34.44,Default,,0,0,0,,Бүгін күлкі күні.
Dialogue: 0,1:24:34.56,1:24:38.53,Default,,0,0,0,,Өйткені, Нобитаны алдау ең оңай.
Dialogue: 0,1:24:38.65,1:24:40.99,Default,,0,0,0,,Ku~!
Dialogue: 0,1:24:41.11,1:24:43.36,Default,,0,0,0,,Мен анаммен де, әкеммен де сөйлестім—
Dialogue: 0,1:24:43.49,1:24:45.66,Default,,0,0,0,,Көңіліңіз қалса, өтірік айту керек.
Dialogue: 0,1:24:45.78,1:24:46.74,Default,,0,0,0,,Бұл дұрыс, дұрыс.
Dialogue: 0,1:24:46.87,1:24:48.95,Default,,0,0,0,,Артыңда елес бар!
Dialogue: 0,1:24:49.08,1:24:52.42,Default,,0,0,0,,Аруақ бала ма?
Dialogue: 0,1:24:52.54,1:24:55.34,Default,,0,0,0,,Елес... Елес
Dialogue: 0,1:25:05.35,1:25:06.85,Default,,0,0,0,,Дораемон
Dialogue: 0,1:25:08.31,1:25:10.52,Default,,0,0,0,,Дора…
Dialogue: 0,1:25:11.31,1:25:12.39,Default,,0,0,0,,Иә.
Dialogue: 0,1:25:13.44,1:25:16.27,Default,,0,0,0,,Нобита-кун, мен қайтқан соң
Dialogue: 0,1:25:16.40,1:25:19.78,Default,,0,0,0,,Бірдеңе болса, шыдай алмайсың.
Dialogue: 0,1:25:20.74,1:25:22.07,Default,,0,0,0,,А, міне, солай.
Dialogue: 0,1:25:23.86,1:25:26.70,Default,,0,0,0,,Осы мұрын қосқышын басып көріңіз.
Dialogue: 0,1:25:26.83,1:25:30.08,Default,,0,0,0,,Сол кезде сізге ең қажет құрал
Dialogue: 0,1:25:30.20,1:25:33.58,Default,,0,0,0,,Сіз тек бір рет қайта бағытталасыз
Dialogue: 0,1:25:37.38,1:25:41.09,Default,,0,0,0,,«Бұл Uso 800 деп аталатын дәрі».
Dialogue: 0,1:25:41.21,1:25:45.64,Default,,0,0,0,,«Мұны ішсең, айтқаныңның бәрі өтірік болады».
Dialogue: 0,1:25:46.43,1:25:49.01,Default,,0,0,0,,Сәуірдің күлкі күніне өте ыңғайлы
Dialogue: 0,1:25:49.14,1:25:54.19,Default,,0,0,0,,Дораемонның келгені мен үшін ең қатыгез өтірік...
Dialogue: 0,1:25:55.77,1:25:57.90,Default,,0,0,0,,Мен оларды кешіре алмаймын.
Dialogue: 0,1:25:59.36,1:26:00.73,Default,,0,0,0,,«Елес бар~»
Dialogue: 0,1:26:00.86,1:26:03.24,Default,,0,0,0,,А, қарашы, қарашы, Джан, сонда қара.
Dialogue: 0,1:26:04.15,1:26:06.41,Default,,0,0,0,,Неге екені белгісіз, мен ақымақтық толқып әрекет еттім.
Dialogue: 0,1:26:06.53,1:26:09.16,Default,,0,0,0,,Баланың тағы бір өтірігін ойлап қалдыңыз.
Dialogue: 0,1:26:09.28,1:26:12.16,Default,,0,0,0,,Бұл жолы өтіріктің түрі қандай?
Dialogue: 0,1:26:12.29,1:26:14.12,Default,,0,0,0,,Кел, айт.
Dialogue: 0,1:26:15.87,1:26:17.92,Default,,0,0,0,,Менен кешірім сұрағың келмей ме?
Dialogue: 0,1:26:18.04,1:26:21.71,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:26:21.84,1:26:23.38,Default,,0,0,0,,Сонда оған көмектесу мүмкін емес.
Dialogue: 0,1:26:23.51,1:26:24.88,Default,,0,0,0,,Іш қуысы~
Dialogue: 0,1:26:32.18,1:26:36.77,Default,,0,0,0,,Бүгін ауа-райы жақсы (Сунео) Иә? Бұл өтірік пе?
Dialogue: 0,1:26:37.94,1:26:38.86,Default,,0,0,0,,(Жаңбырдың дыбысы)
Dialogue: 0,1:26:38.86,1:26:40.52,Default,,0,0,0,,(жаңбырдың дыбысы)
Dialogue: 0,1:26:38.86,1:26:40.52,Default,,0,0,0,,Иә? Уау~
Dialogue: 0,1:26:41.73,1:26:43.40,Default,,0,0,0,,Аа, қатты жаңбыр жауып тұр.
Dialogue: 0,1:26:46.15,1:26:49.91,Default,,0,0,0,,Сіз не істеп жатырсыз? (Сунео) Хакушон
Dialogue: 0,1:26:50.66,1:26:53.66,Default,,0,0,0,,Ал, енді не болады, сұмдық жігіт?
Dialogue: 0,1:26:53.79,1:26:58.08,Default,,0,0,0,,Хмм, Сунео... және...
Dialogue: 0,1:26:59.29,1:27:00.63,Default,,0,0,0,,Иттерді тістеп алмаңыз
Dialogue: 0,1:27:00.75,1:27:02.88,Default,,0,0,0,,Мен... ит пе? Күте тұрыңыз...
Dialogue: 0,1:27:03.00,1:27:03.55,Default,,0,0,0,,Сен кереметсің, Кёко. Ол қандай? Сымбатты ма?
Dialogue: 0,1:27:03.55,1:27:07.09,Default,,0,0,0,,Сен кереметсің, Кёко. Ол қандай? Сымбатты ма?
Dialogue: 0,1:27:03.55,1:27:07.09,Default,,0,0,0,,Ит~! маған көмектесші!
Dialogue: 0,1:27:07.72,1:27:10.47,Default,,0,0,0,,Джан, сен...
Dialogue: 0,1:27:11.14,1:27:14.77,Default,,0,0,0,,Анаң сені қатты жақсы көреді.
Dialogue: 0,1:27:15.31,1:27:17.27,Default,,0,0,0,,Ал!
Dialogue: 0,1:27:17.39,1:27:20.90,Default,,0,0,0,,Дүкенде көмектеспей қайда қыдырдың?
Dialogue: 0,1:27:21.02,1:27:23.32,Default,,0,0,0,,Мен сені бүгін кешірмеймін.
Dialogue: 0,1:27:23.44,1:27:26.28,Default,,0,0,0,,А... Анашым, кешіріңіз.
Dialogue: 0,1:27:26.40,1:27:29.41,Default,,0,0,0,,Сен бала екенсің (Нобита) Ахахаха...
Dialogue: 0,1:27:29.53,1:27:33.12,Default,,0,0,0,,Хахахахахахахахаха
Dialogue: 0,1:27:33.24,1:27:37.08,Default,,0,0,0,,Хахаха хахаха...
Dialogue: 0,1:27:37.62,1:27:39.12,Default,,0,0,0,,Я...
Dialogue: 0,1:27:41.21,1:27:43.17,Default,,0,0,0,,Бұрын Нерима Уордындағы Цукимидайда
Dialogue: 0,1:27:43.17,1:27:43.92,Default,,0,0,0,,Бұрын Нерима Уордындағы Цукимидайда
Dialogue: 0,1:27:43.17,1:27:43.92,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,1:27:43.92,1:27:44.05,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,1:27:44.05,1:27:45.63,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,1:27:44.05,1:27:45.63,Default,,0,0,0,,Кенет қатты жаңбыр жауды.
Dialogue: 0,1:27:45.63,1:27:46.34,Default,,0,0,0,,Кенет қатты жаңбыр жауды.
Dialogue: 0,1:27:47.01,1:27:50.68,Default,,0,0,0,,Кешке дейін кенеттен жауатын жаңбырдан сақ болыңыз.
Dialogue: 0,1:27:52.89,1:27:55.43,Default,,0,0,0,,Сонда Дора-чан сонда болды ма?
Dialogue: 0,1:27:55.56,1:27:58.06,Default,,0,0,0,,Дораэмонның болуы мүмкін емес, солай ма?
Dialogue: 0,1:27:58.98,1:28:00.02,Default,,0,0,0,,Иә?
Dialogue: 0,1:28:04.82,1:28:07.94,Default,,0,0,0,,Себебі Дораемон қайтып келмейді
Dialogue: 0,1:28:12.32,1:28:15.03,Default,,0,0,0,,Өйткені біз енді ешқашан кездеспейміз
Dialogue: 0,1:28:15.58,1:28:17.37,Default,,0,0,0,,Осы сатыға разы емессің бе?
Dialogue: 0,1:28:21.42,1:28:22.63,Default,,0,0,0,,Ах!
Dialogue: 0,1:28:30.43,1:28:32.05,Default,,0,0,0,,Нобита-кун
Dialogue: 0,1:28:36.35,1:28:38.43,Default,,0,0,0,,Неліктен?Неліктен?
Dialogue: 0,1:28:38.56,1:28:43.06,Default,,0,0,0,,Мен күтпеген жерден келуге мүмкіндік алғаным біртүрлі.
Dialogue: 0,1:28:44.90,1:28:47.44,Default,,0,0,0,,Иә, мұны ішіңіз.
Dialogue: 0,1:28:47.57,1:28:50.99,Default,,0,0,0,,Мен қайтып келмеймін дедіңіз.
Dialogue: 0,1:28:55.95,1:28:56.91,Default,,0,0,0,,Мен бақыттымын...
Dialogue: 0,1:29:01.16,1:29:03.12,Default,,0,0,0,,Мм... Мен риза емеспін.
Dialogue: 0,1:29:04.29,1:29:07.00,Default,,0,0,0,,Мүлдем бақытты емес
Dialogue: 0,1:29:07.13,1:29:09.09,Default,,0,0,0,,Мүлдем бақытты емес
Dialogue: 0,1:29:10.17,1:29:13.18,Default,,0,0,0,,Мен шынымен бақытты емеспін.
Dialogue: 0,1:29:15.76,1:29:19.43,Default,,0,0,0,,Бұдан былай да...
Dialogue: 0,1:29:19.56,1:29:23.90,Default,,0,0,0,,Дораемонмен бірге тұрмаңыз
Dialogue: 0,1:29:24.77,1:29:28.82,Default,,0,0,0,,Егер сен өмір сүрмесең, өмір сүрмейсің.
Dialogue: 0,1:29:29.90,1:29:33.40,Default,,0,0,0,,Ешқашан бірге тұрмаңыз
Dialogue: 0,1:29:35.99,1:29:40.95,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,1:30:01.39,1:30:06.35,Default,,0,0,0,,♪~
Dialogue: 0,1:34:11.31,1:34:16.27,Default,,0,0,0,,~♪
