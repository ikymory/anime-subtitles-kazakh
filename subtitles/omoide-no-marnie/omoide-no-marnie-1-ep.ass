Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:20.33,0:00:21.20,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:00:22.29,0:00:23.33,Default,,0,0,0,,ұсталды
Dialogue: 0,0:00:23.87,0:00:26.58,Default,,0,0,0,,(Қырда ойнаған балалардың дыбысы)
Dialogue: 0,0:00:36.20,0:00:39.91,Default,,0,0,0,,Бұл дүниеде көзге көрінбейтін сиқырлы сақина бар
Dialogue: 0,0:00:40.00,0:00:41.29,Default,,0,0,0,,Ұстадым!
Dialogue: 0,0:00:45.33,0:00:46.41,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:00:46.79,0:00:48.04,Default,,0,0,0,,(Студент қыздың күлкісі)
Dialogue: 0,0:00:48.12,0:00:50.58,Default,,0,0,0,,Біз шынымен кездесіп жүрдік. (Қыз студент) Не?
Dialogue: 0,0:00:53.79,0:00:55.79,Default,,0,0,0,,Сақинаның ішкі және сыртқы жағы болады.
Dialogue: 0,0:00:55.87,0:00:57.45,Default,,0,0,0,,Мұғалім, мен мүлде сурет сала алмаймын.
Dialogue: 0,0:00:57.87,0:00:59.58,Default,,0,0,0,,Қозғалыс сәтін түсіру
Dialogue: 0,0:00:59.95,0:01:00.91,Default,,0,0,0,,Бұл қиын
Dialogue: 0,0:01:01.00,0:01:02.00,Default,,0,0,0,,Эй (мұғалім) Қайсысы?
Dialogue: 0,0:01:02.08,0:01:04.66,Default,,0,0,0,,Сәлем! Қарама, тентек
Dialogue: 0,0:01:04.75,0:01:06.95,Default,,0,0,0,,Бұл адамдар ішкі адамдар
Dialogue: 0,0:01:09.16,0:01:10.45,Default,,0,0,0,,Жарайды, тез бітір.
Dialogue: 0,0:01:10.54,0:01:12.54,Default,,0,0,0,,Ал мен бөгде адаммын
Dialogue: 0,0:01:14.20,0:01:15.79,Default,,0,0,0,,Бірақ бұл маңызды емес.
Dialogue: 0,0:01:17.58,0:01:18.54,Default,,0,0,0,,Бұл қалай?
Dialogue: 0,0:01:20.04,0:01:21.91,Default,,0,0,0,,А (Мұғалім) А?
Dialogue: 0,0:01:22.04,0:01:25.79,Default,,0,0,0,,Мен сәл сәтсіздікке ұшыраған сияқтымын.
Dialogue: 0,0:01:25.87,0:01:27.16,Default,,0,0,0,,Қайсысы? Маған көрсет
Dialogue: 0,0:01:27.25,0:01:28.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:36.25,0:01:38.20,Default,,0,0,0,,(баланың жылауы)
Dialogue: 0,0:01:38.70,0:01:39.83,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:01:39.91,0:01:41.54,Default,,0,0,0,,Не болды?Сенімен бәрі жақсы ма?
Dialogue: 0,0:01:42.00,0:01:43.37,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:01:43.45,0:01:45.45,Default,,0,0,0,,(баланың жылауы)
Dialogue: 0,0:01:45.58,0:01:46.58,Default,,0,0,0,,Не болды?
Dialogue: 0,0:01:49.66,0:01:50.50,Default,,0,0,0,,(Аннаның жөтел дыбысы)
Dialogue: 0,0:01:52.87,0:01:53.87,Default,,0,0,0,,Мен...
Dialogue: 0,0:01:57.37,0:01:58.54,Default,,0,0,0,,Мен мені жек көремін
Dialogue: 0,0:02:00.33,0:02:04.00,Default,,0,0,0,,♪~
Dialogue: 0,0:02:18.20,0:02:19.20,Default,,0,0,0,,Анна…
Dialogue: 0,0:02:20.70,0:02:22.95,Default,,0,0,0,,Қазір бәрі жақсы, еңбектеріңізге рахмет.
Dialogue: 0,0:02:23.04,0:02:26.58,Default,,0,0,0,,Уау, бұл жақсы. Рахмет, мұғалім.
Dialogue: 0,0:02:28.04,0:02:30.75,Default,,0,0,0,,Анна ше? Енді ауырмай ма?
Dialogue: 0,0:02:31.29,0:02:32.16,Default,,0,0,0,,Жарайды
Dialogue: 0,0:02:32.75,0:02:35.45,Default,,0,0,0,,Қатты қиналған сияқты болды, қазір де
Dialogue: 0,0:02:35.75,0:02:37.62,Default,,0,0,0,,Сізде ингалятор болған жоқ па?
Dialogue: 0,0:02:39.37,0:02:41.41,Default,,0,0,0,,Бұл қайтадан ақшаға түсті.
Dialogue: 0,0:02:41.95,0:02:44.87,Default,,0,0,0,,Сіз не туралы айтып отырсыз? (домофон дыбысы)
Dialogue: 0,0:02:47.70,0:02:48.91,Default,,0,0,0,,О, Миёко-чан
Dialogue: 0,0:02:49.66,0:02:51.62,Default,,0,0,0,,Мен Аннаның сөмкесін әкелдім.
Dialogue: 0,0:02:51.95,0:02:53.29,Default,,0,0,0,,Ішінде дәптер де бар.
Dialogue: 0,0:02:53.83,0:02:55.04,Default,,0,0,0,,Ал, рахмет
Dialogue: 0,0:02:55.12,0:02:58.00,Default,,0,0,0,,Жоқ, жақын жерде, сондықтан бірдеңе қайталанса.
Dialogue: 0,0:02:59.20,0:03:00.29,Default,,0,0,0,,Ум...
Dialogue: 0,0:03:01.04,0:03:04.04,Default,,0,0,0,,Анна, сен бәрімен жақсы араласасың ба?
Dialogue: 0,0:03:04.37,0:03:06.50,Default,,0,0,0,,Мектеп туралы ештеңе айтпа.
Dialogue: 0,0:03:07.33,0:03:08.37,Default,,0,0,0,,Қалыпты
Dialogue: 0,0:03:08.70,0:03:10.50,Default,,0,0,0,,Бірақ Анна-чан тыныш.
Dialogue: 0,0:03:11.45,0:03:13.08,Default,,0,0,0,,Тыныштық дейсіз бе?
Dialogue: 0,0:03:13.16,0:03:14.54,Default,,0,0,0,,Тек тоқтатыңыз.
Dialogue: 0,0:03:15.54,0:03:17.87,Default,,0,0,0,,Өйткені біз өте шулымыз (оқушылар күледі)
Dialogue: 0,0:03:19.75,0:03:21.37,Default,,0,0,0,,Абайлаңыз.
Dialogue: 0,0:03:22.37,0:03:25.12,Default,,0,0,0,,Сіз әлі де уайымсызсыз, мама.
Dialogue: 0,0:03:28.91,0:03:30.00,Default,,0,0,0,,Сол жігіт мүлде есінен танып кетті – адамдар оны ұстап тұруға мәжбүр болды.
Dialogue: 0,0:03:30.45,0:03:31.62,Default,,0,0,0,,~♪
Dialogue: 0,0:03:33.08,0:03:36.16,Default,,0,0,0,,Мүмкін ол мектепте оқшауланған шығар.
Dialogue: 0,0:03:36.87,0:03:38.08,Default,,0,0,0,,Демікпе ұстамасы
Dialogue: 0,0:03:38.16,0:03:40.66,Default,,0,0,0,,Бұл күйзеліспен де байланысты болуы мүмкін.
Dialogue: 0,0:03:40.95,0:03:43.83,Default,,0,0,0,,Осындай кездерде де менің күйеуім іссапарда болады.
Dialogue: 0,0:03:45.54,0:03:48.54,Default,,0,0,0,,Менің ойымша, екеумізде де қиындықтар бар.
Dialogue: 0,0:03:49.79,0:03:51.00,Default,,0,0,0,,12 жаста?
Dialogue: 0,0:03:51.41,0:03:53.37,Default,,0,0,0,,Бұл қиын жас.
Dialogue: 0,0:03:54.33,0:03:56.87,Default,,0,0,0,,Сіз бірдеңе байқадыңыз ба?
Dialogue: 0,0:03:58.20,0:04:02.16,Default,,0,0,0,,Ол қыздың бет-әлпеті әрқашан қалыпты.
Dialogue: 0,0:04:02.62,0:04:04.08,Default,,0,0,0,,Қарапайым тұлға?
Dialogue: 0,0:04:07.04,0:04:08.20,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:04:11.29,0:04:14.12,Default,,0,0,0,,Өз эмоцияларыңызды көрсетпеңіз
Dialogue: 0,0:04:14.91,0:04:17.29,Default,,0,0,0,,Ол өрнектері көп бала еді.
Dialogue: 0,0:04:18.20,0:04:21.87,Default,,0,0,0,,Бірақ соңғы кездері түсінбеймін.
Dialogue: 0,0:04:25.12,0:04:29.45,Default,,0,0,0,,Менің ойымша, бұл біздің қандас туыс емеспіз.
Dialogue: 0,0:04:30.87,0:04:32.41,Default,,0,0,0,,Медициналық емдеу үлгілері
Dialogue: 0,0:04:33.08,0:04:35.20,Default,,0,0,0,,Бұл туралы ойлану керек шығар.
Dialogue: 0,0:04:38.04,0:04:41.25,Default,,0,0,0,,♪~
Dialogue: 0,0:04:49.66,0:04:51.16,Default,,0,0,0,,Сәлем Анна
Dialogue: 0,0:04:51.62,0:04:52.50,Default,,0,0,0,,(таңданған дауыс)
Dialogue: 0,0:04:52.83,0:04:55.87,Default,,0,0,0,,Ойваның ағасы мен апасы есіңізде ме?
Dialogue: 0,0:04:57.87,0:05:01.16,Default,,0,0,0,,Біздің үйдің ауасы өте таза.
Dialogue: 0,0:05:04.20,0:05:05.83,Default,,0,0,0,,Аннаның ауруы...
Dialogue: 0,0:05:05.91,0:05:08.95,Default,,0,0,0,,Ондай жерде біраз уақыт өткізу жақсы сияқты.
Dialogue: 0,0:05:10.62,0:05:12.25,Default,,0,0,0,,Мен сіздің артыңыздан жүре алмаймын.
Dialogue: 0,0:05:13.20,0:05:15.08,Default,,0,0,0,,Саған жақсы қарайтынына сенімдімін.
Dialogue: 0,0:05:16.50,0:05:19.33,Default,,0,0,0,,Жақсы қыз болып, жақсы тамақтан.
Dialogue: 0,0:05:19.62,0:05:21.33,Default,,0,0,0,,Сау болыңыз және оралыңыз.
Dialogue: 0,0:05:26.16,0:05:28.16,Default,,0,0,0,,Ешкідей шулы
Dialogue: 0,0:06:12.08,0:06:13.50,Default,,0,0,0,,~♪
Dialogue: 0,0:06:14.04,0:06:15.12,Default,,0,0,0,,О, кел, кел (Киёмасаның тұрған дыбысы)
Dialogue: 0,0:06:15.20,0:06:16.04,Default,,0,0,0,,Ах
Dialogue: 0,0:06:17.20,0:06:18.29,Default,,0,0,0,,Анна-чан
Dialogue: 0,0:06:19.08,0:06:19.91,Default,,0,0,0,,Ах
Dialogue: 0,0:06:20.00,0:06:23.33,Default,,0,0,0,,(Аннаның ізі)
Dialogue: 0,0:06:23.41,0:06:24.62,Default,,0,0,0,,Есіңде ме?
Dialogue: 0,0:06:24.70,0:06:27.62,Default,,0,0,0,,Жоқ, бірақ мен тәтемнен әртүрлі нәрселерді сұрадым.
Dialogue: 0,0:06:28.37,0:06:29.50,Default,,0,0,0,,Бұл Анна Сасаки.
Dialogue: 0,0:06:29.58,0:06:32.87,Default,,0,0,0,,Қолайсыздықтар үшін кешірім сұраймыз, бірақ бұл тудыруы мүмкін кез келген қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:06:35.04,0:06:36.16,Default,,0,0,0,,Мен де солай.
Dialogue: 0,0:06:37.04,0:06:37.87,Default,,0,0,0,,Апай?
Dialogue: 0,0:06:38.54,0:06:39.70,Default,,0,0,0,,Бұл Йорико туралы.
Dialogue: 0,0:06:39.95,0:06:40.91,Default,,0,0,0,,Ах
Dialogue: 0,0:06:43.41,0:06:46.87,Default,,0,0,0,,Енді көлікке отыр. Осылай тозғаным үшін кешірім сұраймын.
Dialogue: 0,0:06:54.83,0:06:57.00,Default,,0,0,0,,Кешіріңіз, бұл тым кішкентай.
Dialogue: 0,0:06:57.37,0:06:58.66,Default,,0,0,0,,Бұл мүлдем маңызды емес.
Dialogue: 0,0:06:59.75,0:07:02.79,Default,,0,0,0,,Келмегеніме біраз уақыт болса да, вокзал алдындағы аумақ өзгерді.
Dialogue: 0,0:07:02.87,0:07:04.66,Default,,0,0,0,,Көптеген жаңа дүкендер
Dialogue: 0,0:07:05.20,0:07:08.54,Default,,0,0,0,,Біз қазір баратын жер демалатын жер.
Dialogue: 0,0:07:09.37,0:07:13.20,Default,,0,0,0,,Жоғарғы үлкен жол салынғаннан кейін мұнда адамдар келуді тоқтатты.
Dialogue: 0,0:07:25.95,0:07:27.58,Default,,0,0,0,,Уау
Dialogue: 0,0:07:30.20,0:07:33.37,Default,,0,0,0,,Сіз бұл үңгірді әлі жөндеген жоқсыз ба?
Dialogue: 0,0:07:37.37,0:07:38.45,Default,,0,0,0,,Демікпе дегеніміз не?
Dialogue: 0,0:07:38.58,0:07:39.75,Default,,0,0,0,,Иә
Dialogue: 0,0:07:39.83,0:07:42.45,Default,,0,0,0,,Мұнда жел соқсаң, тез жазыласың.
Dialogue: 0,0:07:50.83,0:07:54.62,Default,,0,0,0,,Керемет жер емес пе? Маған көрсеткіңіз келе ме? Тіпті менің нағашым
Dialogue: 0,0:07:54.70,0:07:56.00,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:07:56.08,0:07:57.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:57.50,0:07:58.62,Default,,0,0,0,,Жартаста
Dialogue: 0,0:07:58.70,0:08:03.37,Default,,0,0,0,,А, бұл силос. Ол мал азықтық дақылдарды сақтау үшін қолданылады.
Dialogue: 0,0:08:03.95,0:08:06.58,Default,,0,0,0,,Бірақ ол ондаған жылдар бойы қолданылмаған.
Dialogue: 0,0:08:07.20,0:08:10.33,Default,,0,0,0,,Енді оны ауыл балалары бақтарын сынау үшін пайдаланады.
Dialogue: 0,0:08:11.00,0:08:13.62,Default,,0,0,0,,Нағыз елес пайда болатын сияқты.
Dialogue: 0,0:08:13.70,0:08:15.33,Default,,0,0,0,,Тек тоқтатыңыз.
Dialogue: 0,0:08:15.79,0:08:18.33,Default,,0,0,0,,Бұл жігіт ондай әңгімелерді ұнатады.
Dialogue: 0,0:08:18.41,0:08:20.12,Default,,0,0,0,,Ендеше, аулақ болғаны дұрыс.
Dialogue: 0,0:08:20.54,0:08:23.25,Default,,0,0,0,,Рахмет (баланың ойнақы дауысы)
Dialogue: 0,0:08:23.95,0:08:27.04,Default,,0,0,0,,Қараңдаршы, мынау біздің үйді ана жерден көріп тұрсыңдар.
Dialogue: 0,0:08:33.62,0:08:35.41,Default,,0,0,0,,Мұны бір сәтке ұстап тұрыңыз.
Dialogue: 0,0:08:36.20,0:08:37.45,Default,,0,0,0,,Не?
Dialogue: 0,0:08:37.54,0:08:40.33,Default,,0,0,0,,Не? Мен неге мұндай нәрсені аламын деп ойлаймын?
Dialogue: 0,0:08:41.87,0:08:44.16,Default,,0,0,0,,Біз өз бетімізше тамақ іше алмаймыз.
Dialogue: 0,0:08:44.25,0:08:48.04,Default,,0,0,0,,Мен мұны әрқашан әрі қарай не болатынын ойламай жасаймын.
Dialogue: 0,0:08:50.33,0:08:53.16,Default,,0,0,0,,Балалар тәуелсіз, енді олар кетті
Dialogue: 0,0:08:53.62,0:08:55.79,Default,,0,0,0,,Оны пайдалана аласыз (Анна) Иә.
Dialogue: 0,0:08:56.29,0:08:58.83,Default,,0,0,0,,Ал, мынау және мынау...
Dialogue: 0,0:08:59.45,0:09:00.62,Default,,0,0,0,,Әкесі: Ллойд Форджер, психиатр
Dialogue: 0,0:09:10.50,0:09:13.12,Default,,0,0,0,,Сіз бұл біртүрлі үй деп ойлайсыз, солай ма?
Dialogue: 0,0:09:13.75,0:09:15.37,Default,,0,0,0,,Жоқ, бұл жақсы үй.
Dialogue: 0,0:09:15.50,0:09:19.79,Default,,0,0,0,,Мақтауды күштеп айтудың қажеті жоқ.
Dialogue: 0,0:09:22.54,0:09:24.25,Default,,0,0,0,,Сіздің бөлмеңіз екінші қабатта.
Dialogue: 0,0:09:26.04,0:09:27.70,Default,,0,0,0,,Қызы пайдаланатын бөлме
Dialogue: 0,0:09:30.37,0:09:34.75,Default,,0,0,0,,Тазалау мұң емес пе? Сондықтан оны бұрынғыдай қалдырыңыз.
Dialogue: 0,0:09:35.54,0:09:36.50,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:09:36.91,0:09:40.25,Default,,0,0,0,,Дәл қазір мен Токиода йога мұғалімі болып жұмыс істеймін.
Dialogue: 0,0:09:40.70,0:09:43.75,Default,,0,0,0,,Мен де бастауды ойлап жүрмін (Сецу күлді)
Dialogue: 0,0:09:44.54,0:09:48.20,Default,,0,0,0,,О, шкаф пен сөрелер бос, сондықтан оларды пайдаланыңыз.
Dialogue: 0,0:09:48.70,0:09:49.66,Default,,0,0,0,,Иә
Dialogue: 0,0:09:58.20,0:10:02.58,Default,,0,0,0,,«Не болғанын жазыңызшы, Йорико.»
Dialogue: 0,0:10:03.20,0:10:06.75,Default,,0,0,0,,Ашық хаттар бұл күндері жақсы емес, жай ғана жіберіңіз.
Dialogue: 0,0:10:07.45,0:10:08.50,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:10:09.37,0:10:10.54,Default,,0,0,0,,Уа!
Dialogue: 0,0:10:11.16,0:10:13.29,Default,,0,0,0,,Ол адамдарды пайдалануда өте нашар.
Dialogue: 0,0:10:13.62,0:10:15.00,Default,,0,0,0,,Содан кейін кездескенше.
Dialogue: 0,0:10:16.00,0:10:19.08,Default,,0,0,0,,(Баспалдақтан түскен Сецу дыбысы)
Dialogue: 0,0:10:21.08,0:10:22.70,Default,,0,0,0,,Хитачидің иісі сияқты.
Dialogue: 0,0:10:37.41,0:10:38.41,Default,,0,0,0,,Уау
Dialogue: 0,0:10:40.62,0:10:43.83,Default,,0,0,0,,♪~
Dialogue: 0,0:10:56.33,0:10:57.62,Default,,0,0,0,,Мен мұнда жүктеме болғым келмейді.
Dialogue: 0,0:10:59.50,0:11:00.66,Default,,0,0,0,,Аман-есен келді
Dialogue: 0,0:11:01.20,0:11:02.83,Default,,0,0,0,,Бұл өте жақсы жер.
Dialogue: 0,0:11:03.41,0:11:06.33,Default,,0,0,0,,Нағашылары мен апалары да өте мейірімді.
Dialogue: 0,0:11:20.91,0:11:22.00,Default,,0,0,0,,Бұл дәмді
Dialogue: 0,0:11:22.66,0:11:25.37,Default,,0,0,0,,Мен сені қазір жібере алмаймын.
Dialogue: 0,0:11:25.45,0:11:28.00,Default,,0,0,0,,Мен сол пошта бөлімшесіне барамын.
Dialogue: 0,0:11:29.12,0:11:30.83,Default,,0,0,0,,Қош келдіңіз.
Dialogue: 0,0:11:30.91,0:11:32.12,Default,,0,0,0,,Эй, сен тамақ ішпейсің бе?
Dialogue: 0,0:11:32.87,0:11:33.83,Default,,0,0,0,,Кейінірек
Dialogue: 0,0:11:33.91,0:11:36.20,Default,,0,0,0,,Иә? Олай болса, кешкі астан кейінгі тағамдар үшін.
Dialogue: 0,0:11:44.70,0:11:48.20,Default,,0,0,0,,Дұрыс, тұраққа төте жол бар.
Dialogue: 0,0:11:48.29,0:11:49.25,Default,,0,0,0,,Иә, иә.
Dialogue: 0,0:11:55.41,0:11:57.58,Default,,0,0,0,,Бұл төте жол ма?
Dialogue: 0,0:12:05.45,0:12:06.37,Default,,0,0,0,,Ой (шөптің сыбдыры)
Dialogue: 0,0:12:28.58,0:12:30.58,Default,,0,0,0,,~♪
Dialogue: 0,0:12:30.66,0:12:33.20,Default,,0,0,0,,Мүлдем ұл болса, мен жынданып қаламын.
Dialogue: 0,0:12:33.33,0:12:35.08,Default,,0,0,0,,Төраға болу қиын.
Dialogue: 0,0:12:35.16,0:12:37.62,Default,,0,0,0,,Аа, мен сізге хат жіберемін, күте тұрыңыз.
Dialogue: 0,0:12:43.04,0:12:46.62,Default,,0,0,0,,Иә? ДДСҰ? Сол қыз
Dialogue: 0,0:12:47.25,0:12:50.87,Default,,0,0,0,,(Аннаның ентігу дыбысы)
Dialogue: 0,0:12:52.33,0:12:53.29,Default,,0,0,0,,Ах
Dialogue: 0,0:12:54.58,0:12:55.41,Default,,0,0,0,,Әй!
Dialogue: 0,0:12:58.20,0:12:59.12,Default,,0,0,0,,А...
Dialogue: 0,0:13:00.29,0:13:01.29,Default,,0,0,0,,Ха...
Dialogue: 0,0:13:10.16,0:13:11.62,Default,,0,0,0,,♪~
Dialogue: 0,0:13:15.29,0:13:16.37,Default,,0,0,0,,Бұл тест
Dialogue: 0,0:13:19.04,0:13:21.50,Default,,0,0,0,,Мен ол үйді білетін сияқтымын.
Dialogue: 0,0:13:35.04,0:13:36.00,Default,,0,0,0,,Ах (судың шашырауы)
Dialogue: 0,0:13:54.16,0:13:55.95,Default,,0,0,0,,Менің ойымша, онда ешкім тұрмайды.
Dialogue: 0,0:14:00.70,0:14:03.66,Default,,0,0,0,,Ах... Мазалағаным үшін кешіріңіз.
Dialogue: 0,0:14:19.54,0:14:21.12,Default,,0,0,0,,Үлкен үй
Dialogue: 0,0:14:53.83,0:14:55.91,Default,,0,0,0,,Бұл жерде ешкім жоқ.
Dialogue: 0,0:15:11.00,0:15:13.00,Default,,0,0,0,,~♪
Dialogue: 0,0:15:16.66,0:15:18.37,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:15:18.45,0:15:19.58,Default,,0,0,0,,♬~
Dialogue: 0,0:15:20.87,0:15:21.87,Default,,0,0,0,,Ха
Dialogue: 0,0:15:26.87,0:15:27.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:30.87,0:15:31.83,Default,,0,0,0,,Ах
Dialogue: 0,0:15:35.04,0:15:36.20,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:16:00.12,0:16:01.20,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:20.87,0:16:23.75,Default,,0,0,0,,Аю, мүмкін теңіз арыстаны
Dialogue: 0,0:16:27.54,0:16:28.37,Default,,0,0,0,,Ха
Dialogue: 0,0:16:30.70,0:16:31.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:31.91,0:16:34.29,Default,,0,0,0,,♪~
Dialogue: 0,0:16:49.08,0:16:51.08,Default,,0,0,0,,~♪
Dialogue: 0,0:16:51.16,0:16:53.70,Default,,0,0,0,,Хахахаха Бұл апат болды (плиталар қозғалатын дыбыс)
Dialogue: 0,0:16:54.29,0:16:57.25,Default,,0,0,0,,Толқын мен ағыс Табиғат толығымен өзгереді, солай ма?
Dialogue: 0,0:16:57.66,0:16:59.70,Default,,0,0,0,,Бұл айдың күші. Бұл айдың күші.
Dialogue: 0,0:17:00.50,0:17:04.08,Default,,0,0,0,,Бірақ Джуичи мырза қызды қайыққа отырғызбайды деп ойлаймын.
Dialogue: 0,0:17:04.29,0:17:06.16,Default,,0,0,0,,Жоқ, ол жақсы жігіт. Ол...
Dialogue: 0,0:17:06.25,0:17:08.58,Default,,0,0,0,,Мен сенімен сөйлесе алмаймын деп ойлаймын.
Dialogue: 0,0:17:11.37,0:17:13.66,Default,,0,0,0,,Маған тағы да жол бересіз деп үміттенемін.
Dialogue: 0,0:17:14.45,0:17:16.41,Default,,0,0,0,,Маған көлік беріңізші.
Dialogue: 0,0:17:18.75,0:17:19.70,Default,,0,0,0,,Иә
Dialogue: 0,0:17:20.50,0:17:24.50,Default,,0,0,0,,Бірақ батпақты зәулім үйден алыс болған дұрыс.
Dialogue: 0,0:17:26.20,0:17:28.16,Default,,0,0,0,,Неге?
Dialogue: 0,0:17:29.91,0:17:31.29,Default,,0,0,0,,Тағы да шықты!
Dialogue: 0,0:17:31.41,0:17:33.29,Default,,0,0,0,,Хахахаха (Киёмасаның тұрған және жүрген дыбысы)
Dialogue: 0,0:17:33.37,0:17:34.54,Default,,0,0,0,,Мен шарап алып келейін.
Dialogue: 0,0:17:35.66,0:17:37.66,Default,,0,0,0,,Онда ешкім тұрмайтын сияқты.
Dialogue: 0,0:17:37.91,0:17:39.50,Default,,0,0,0,,Иә... әзірге.
Dialogue: 0,0:17:41.20,0:17:44.16,Default,,0,0,0,,Шетелдіктер бұрыннан демалыс үйі ретінде пайдаланып жүрген көрінеді.
Dialogue: 0,0:17:44.70,0:17:47.45,Default,,0,0,0,,Осыдан кейін иесі бірнеше рет өзгерді.
Dialogue: 0,0:17:48.20,0:17:50.66,Default,,0,0,0,,Үй біраз уақыттан бері бос.
Dialogue: 0,0:17:52.12,0:17:53.25,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:18:04.08,0:18:06.66,Default,,0,0,0,,♪~
Dialogue: 0,0:18:13.33,0:18:14.54,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:20.12,0:18:22.54,Default,,0,0,0,,Күрсін... біреу бар.
Dialogue: 0,0:18:28.41,0:18:30.95,Default,,0,0,0,,Уау! (Су шашыраған дыбыс)
Dialogue: 0,0:18:53.33,0:18:54.16,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:54.29,0:18:56.66,Default,,0,0,0,,~♪
Dialogue: 0,0:19:03.04,0:19:05.54,Default,,0,0,0,,(Киёмаса гуілдеген дыбыс)
Dialogue: 0,0:19:05.62,0:19:08.04,Default,,0,0,0,,Сіз мұны істей аласыз ба? (Киёмаса) Иә?
Dialogue: 0,0:19:08.54,0:19:10.33,Default,,0,0,0,,Кадоя мырза сұраған нәрсе
Dialogue: 0,0:19:10.70,0:19:12.16,Default,,0,0,0,,Әй, бұл дерлік қалды.
Dialogue: 0,0:19:12.83,0:19:14.70,Default,,0,0,0,,Эй, Анна-чан, шығасың ба?
Dialogue: 0,0:19:15.04,0:19:16.04,Default,,0,0,0,,Иә
Dialogue: 0,0:19:16.58,0:19:18.54,Default,,0,0,0,,Мен оны тез бітірсем екен.
Dialogue: 0,0:19:20.29,0:19:22.25,Default,,0,0,0,,Сол нобайда
Dialogue: 0,0:19:22.33,0:19:23.75,Default,,0,0,0,,Қош келдіңіз!
Dialogue: 0,0:19:23.83,0:19:24.75,Default,,0,0,0,,Иә
Dialogue: 0,0:19:25.87,0:19:26.87,Default,,0,0,0,,Йоишото
Dialogue: 0,0:19:29.45,0:19:32.33,Default,,0,0,0,,Йорико-сан қатты қобалжыған сияқты.
Dialogue: 0,0:19:32.41,0:19:33.87,Default,,0,0,0,,Жарайды, жақсы сияқты.
Dialogue: 0,0:19:34.79,0:19:37.37,Default,,0,0,0,,Көп ойнап, көп жесең
Dialogue: 0,0:19:38.12,0:19:39.08,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:19:43.70,0:19:47.37,Default,,0,0,0,,Сіз сенімдісіз бе? Терген қоқысты осында жинаймын.
Dialogue: 0,0:19:47.45,0:19:49.79,Default,,0,0,0,,Бұл жер қай жер?
Dialogue: 0,0:19:49.87,0:19:51.45,Default,,0,0,0,,Олай болса тара!
Dialogue: 0,0:19:51.54,0:19:53.12,Default,,0,0,0,,Төбеге шығайық
Dialogue: 0,0:19:54.70,0:19:56.37,Default,,0,0,0,,А, он бір!
Dialogue: 0,0:19:56.45,0:19:57.62,Default,,0,0,0,,Данмари он бір!
Dialogue: 0,0:19:58.04,0:20:01.12,Default,,0,0,0,,Он жылда бір сөйлейтін он бір
Dialogue: 0,0:20:01.54,0:20:04.62,Default,,0,0,0,,Міне! Мен саған мұны кейінірек істе дедім ғой!
Dialogue: 0,0:20:04.75,0:20:06.91,Default,,0,0,0,,Сонша шуламаңыз! Міне алдын ала қарау!
Dialogue: 0,0:20:07.00,0:20:08.12,Default,,0,0,0,,Кешір мені. Қызығушылығымды тежей алмадым; мен жай ғана…
Dialogue: 0,0:20:08.20,0:20:11.20,Default,,0,0,0,,Келесі кездескен кезде сәлемдесуіңізді өтінемін.
Dialogue: 0,0:20:11.29,0:20:14.87,Default,,0,0,0,,(Балалардың күлкісі)
Dialogue: 0,0:20:22.16,0:20:25.33,Default,,0,0,0,,♪~
Dialogue: 0,0:20:37.75,0:20:40.29,Default,,0,0,0,,(Аннаның гуілдеуі)
Dialogue: 0,0:20:40.37,0:20:41.20,Default,,0,0,0,,Ха...
Dialogue: 0,0:20:56.29,0:20:59.25,Default,,0,0,0,,~♪
Dialogue: 0,0:21:12.54,0:21:13.45,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:21:14.75,0:21:15.87,Default,,0,0,0,,Ах Анна-чан
Dialogue: 0,0:21:19.04,0:21:21.54,Default,,0,0,0,,Тоқтай тұрыңыз, менде біраз уақытқа шығу керек.
Dialogue: 0,0:21:24.41,0:21:25.29,Default,,0,0,0,,Иә
Dialogue: 0,0:21:28.45,0:21:30.91,Default,,0,0,0,,Мен оны өзім әкелуім керек еді.
Dialogue: 0,0:21:31.00,0:21:33.79,Default,,0,0,0,,Мен анау кемпірге жақсы емеспін деп.
Dialogue: 0,0:21:34.54,0:21:37.29,Default,,0,0,0,,Бірақ Кадоя-сан Анна-чанмен кездескісі келді.
Dialogue: 0,0:21:38.20,0:21:41.25,Default,,0,0,0,,Сізден бір жас үлкен Нобуко-чан деген қыз бар.
Dialogue: 0,0:21:41.33,0:21:42.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:44.79,0:21:47.29,Default,,0,0,0,,Нобуко бүгін қарбалас мектепте.
Dialogue: 0,0:21:47.87,0:21:49.50,Default,,0,0,0,,Өте жаман, солай емес пе?
Dialogue: 0,0:21:49.58,0:21:52.29,Default,,0,0,0,,Бұл Анна Чан. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:21:54.16,0:21:56.79,Default,,0,0,0,,О, сәлем.
Dialogue: 0,0:21:56.87,0:21:59.54,Default,,0,0,0,,Әй, сурет салатын сен бе?
Dialogue: 0,0:21:59.91,0:22:01.12,Default,,0,0,0,,Келесі жолы көрсетіңіз
Dialogue: 0,0:22:01.50,0:22:03.29,Default,,0,0,0,,Жоқ! Өйткені мен оған нашармын
Dialogue: 0,0:22:03.87,0:22:05.29,Default,,0,0,0,,Иә
Dialogue: 0,0:22:05.37,0:22:07.95,Default,,0,0,0,,Дұрыс. Ертеңгі Танабата фестивалі
Dialogue: 0,0:22:08.04,0:22:09.79,Default,,0,0,0,,Неге Нобукомен бірге жүрмейсің?
Dialogue: 0,0:22:10.12,0:22:13.58,Default,,0,0,0,,Бұл жақсы! Менің қызымның юкатасы бір жерде болса керек.
Dialogue: 0,0:22:14.29,0:22:16.66,Default,,0,0,0,,Оны кию керек!
Dialogue: 0,0:22:17.25,0:22:18.66,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:22:20.16,0:22:21.04,Default,,0,0,0,,Иә
Dialogue: 0,0:22:21.45,0:22:23.95,Default,,0,0,0,,Мен де Нобукоға айтамын, көтеріл.
Dialogue: 0,0:22:24.04,0:22:24.87,Default,,0,0,0,,Ах
Dialogue: 0,0:22:24.95,0:22:26.12,Default,,0,0,0,,Оны қайда қойдыңыз?
Dialogue: 0,0:22:26.20,0:22:28.04,Default,,0,0,0,,Өйткені, мен.
Dialogue: 0,0:22:28.45,0:22:31.04,Default,,0,0,0,,Әй, эскиз! Өз-өзіңді күт!
Dialogue: 0,0:22:34.50,0:22:35.37,Default,,0,0,0,,Сізге сәйкес келетініне сенімдімін.
Dialogue: 0,0:22:36.04,0:22:37.91,Default,,0,0,0,,Сейно! Жақсы!
Dialogue: 0,0:22:38.00,0:22:39.62,Default,,0,0,0,,Мұны да орындаңыз! (2-кәсіпкер) Иә.
Dialogue: 0,0:22:40.54,0:22:42.04,Default,,0,0,0,,Бұл сізге ұнамайды.
Dialogue: 0,0:22:43.70,0:22:44.66,Default,,0,0,0,,Араласу
Dialogue: 0,0:22:57.66,0:22:58.54,Default,,0,0,0,,Мұнда емес.
Dialogue: 0,0:23:00.33,0:23:01.33,Default,,0,0,0,,Ах
Dialogue: 0,0:23:26.58,0:23:28.75,Default,,0,0,0,,Ертең кездескенше (Нобуконың досы)
Dialogue: 0,0:23:48.50,0:23:52.41,Default,,0,0,0,,♪~
Dialogue: 0,0:23:59.04,0:24:00.66,Default,,0,0,0,,Толқын шығып жатыр.
Dialogue: 0,0:24:19.41,0:24:21.83,Default,,0,0,0,,~♪
Dialogue: 0,0:24:23.37,0:24:24.29,Default,,0,0,0,,Тағы да…
Dialogue: 0,0:24:31.95,0:24:33.29,Default,,0,0,0,,Хмм...
Dialogue: 0,0:24:34.54,0:24:36.00,Default,,0,0,0,,Фестиваль
Dialogue: 0,0:24:36.08,0:24:40.79,Default,,0,0,0,,Шамды сөндіріңіз. Шамды сөндіріңіз.
Dialogue: 0,0:24:40.87,0:24:46.87,Default,,0,0,0,,Егер бермесең, мен сені өлтіремін.
Dialogue: 0,0:24:47.45,0:24:48.45,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:24:48.54,0:24:49.79,Default,,0,0,0,,Рахмет
Dialogue: 0,0:24:49.87,0:24:50.75,Default,,0,0,0,,Иә тәттілер
Dialogue: 0,0:24:50.83,0:24:52.12,Default,,0,0,0,,Рахмет Иә
Dialogue: 0,0:24:53.54,0:24:56.87,Default,,0,0,0,,Бұл жақсы. Мен де юката кигім келді.
Dialogue: 0,0:24:56.95,0:24:59.00,Default,,0,0,0,,Жарайды, оңай.
Dialogue: 0,0:24:59.08,0:25:01.62,Default,,0,0,0,,Маған ата-анамның хоббиі таңылуы қиын.
Dialogue: 0,0:25:02.33,0:25:03.87,Default,,0,0,0,,Менің ойымша, бұл сүйкімді
Dialogue: 0,0:25:03.95,0:25:05.37,Default,,0,0,0,,Е, қайда?
Dialogue: 0,0:25:06.20,0:25:08.70,Default,,0,0,0,,Бұл қарапайым және дәмі нашар.
Dialogue: 0,0:25:08.79,0:25:11.70,Default,,0,0,0,,Әй, Анна қайдан келді?
Dialogue: 0,0:25:12.33,0:25:13.20,Default,,0,0,0,,Саппоро
Dialogue: 0,0:25:13.33,0:25:16.95,Default,,0,0,0,,Бұл жақсы. Қалада көп сауда жасауға болады.
Dialogue: 0,0:25:17.04,0:25:19.12,Default,,0,0,0,,Әдемі жігіттер көп пе?
Dialogue: 0,0:25:19.20,0:25:20.62,Default,,0,0,0,,Сен аузыңды жап!
Dialogue: 0,0:25:20.70,0:25:21.70,Default,,0,0,0,,Субару-кун?
Dialogue: 0,0:25:22.08,0:25:24.75,Default,,0,0,0,,Ауылда көп таңдауың жоқ.
Dialogue: 0,0:25:25.75,0:25:27.70,Default,,0,0,0,,Бірақ сен бұл ауылға не үшін келдің?
Dialogue: 0,0:25:28.45,0:25:29.83,Default,,0,0,0,,Жақсы
Dialogue: 0,0:25:29.91,0:25:32.75,Default,,0,0,0,,Бұл не? Нобуко, бір секундқа осында кел.
Dialogue: 0,0:25:32.83,0:25:34.08,Default,,0,0,0,,Не! (Нобуко досының күлкісі)
Dialogue: 0,0:25:35.04,0:25:38.41,Default,,0,0,0,,Неліктен ол үнемі бірдей қателіктер жібереді?
Dialogue: 0,0:25:38.50,0:25:40.12,Default,,0,0,0,,Келесі жолы сені көрсем, сақ боламын.
Dialogue: 0,0:25:41.20,0:25:43.91,Default,,0,0,0,,(фестиваль шығанағының дыбысы)
Dialogue: 0,0:25:48.08,0:25:49.04,Default,,0,0,0,,болды
Dialogue: 0,0:25:49.12,0:25:50.29,Default,,0,0,0,,Менің тілегім орындала ма?
Dialogue: 0,0:25:50.58,0:25:53.62,Default,,0,0,0,,Әй, маған шам берші.
Dialogue: 0,0:26:00.58,0:26:02.37,Default,,0,0,0,,Өзіңіз ойланыңыз
Dialogue: 0,0:26:04.70,0:26:06.20,Default,,0,0,0,,Өз тілегіңізді жазыңыз
Dialogue: 0,0:26:09.20,0:26:10.75,Default,,0,0,0,,Тілек...
Dialogue: 0,0:26:12.54,0:26:13.79,Default,,0,0,0,,Сіз маған хабарласа аласыз ба?
Dialogue: 0,0:26:13.87,0:26:15.83,Default,,0,0,0,,Жібер (баланың аяғының соғу дыбысы)
Dialogue: 0,0:26:16.37,0:26:18.08,Default,,0,0,0,,Кешіріңіз (бала) Иә.
Dialogue: 0,0:26:18.66,0:26:19.66,Default,,0,0,0,,А? (Балалардың күлкісі)
Dialogue: 0,0:26:20.70,0:26:21.58,Default,,0,0,0,,Анна-чан!
Dialogue: 0,0:26:22.04,0:26:25.58,Default,,0,0,0,,Сіз қайда болдыңыз? Мен сені іздедім.
Dialogue: 0,0:26:26.16,0:26:27.54,Default,,0,0,0,,Ах! қағаз жолағы
Dialogue: 0,0:26:28.33,0:26:29.58,Default,,0,0,0,,Ах (Нобуко) Қайсысы?
Dialogue: 0,0:26:30.66,0:26:33.58,Default,,0,0,0,,«Күндеріңізді қалыпты өткізе аласыз деп үміттенемін»
Dialogue: 0,0:26:34.58,0:26:36.83,Default,,0,0,0,,«Қалыпты»? Анна-чан
Dialogue: 0,0:26:36.91,0:26:38.41,Default,,0,0,0,,Қалыпты деген не?
Dialogue: 0,0:26:38.58,0:26:39.58,Default,,0,0,0,,Бұл...
Dialogue: 0,0:26:40.08,0:26:41.20,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:26:41.33,0:26:43.08,Default,,0,0,0,,Ах! Аннаның көзінің түсі!
Dialogue: 0,0:26:44.04,0:26:45.08,Default,,0,0,0,,Не болды?
Dialogue: 0,0:26:45.41,0:26:47.50,Default,,0,0,0,,Мұқият қарасаңыз, өте әдемі
Dialogue: 0,0:26:47.58,0:26:49.45,Default,,0,0,0,,Ішінде аздап көгілдір бар, сырттағыдай...
Dialogue: 0,0:26:49.54,0:26:50.95,Default,,0,0,0,,Мені жай қалдырыңыз!
Dialogue: 0,0:26:51.25,0:26:52.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:26:52.79,0:26:53.79,Default,,0,0,0,,Майлы шошқа
Dialogue: 0,0:26:56.91,0:26:57.79,Default,,0,0,0,,Майлы
Dialogue: 0,0:26:58.37,0:27:00.54,Default,,0,0,0,,Ха...
Dialogue: 0,0:27:00.91,0:27:01.79,Default,,0,0,0,,Ум...
Dialogue: 0,0:27:02.45,0:27:03.83,Default,,0,0,0,,Хмм…
Dialogue: 0,0:27:04.00,0:27:05.79,Default,,0,0,0,,Мен кәдімгі сөздің мағынасын түсінемін.
Dialogue: 0,0:27:08.04,0:27:11.16,Default,,0,0,0,,Бірақ байғұсты кәдімгідей етіп көрсетудің пайдасы жоқ.
Dialogue: 0,0:27:11.70,0:27:15.25,Default,,0,0,0,,Өйткені сіз өзіңізге ұқсайсыз.
Dialogue: 0,0:27:18.37,0:27:20.58,Default,,0,0,0,,Иә! Осымен бітейік
Dialogue: 0,0:27:20.95,0:27:23.37,Default,,0,0,0,,Эй, келесі жолы бізбен бірге жүр...
Dialogue: 0,0:27:24.54,0:27:25.95,Default,,0,0,0,,Хмм! (Нобуко) Анна-чан!
Dialogue: 0,0:27:26.66,0:27:27.70,Default,,0,0,0,,Уайымдамаңыз!
Dialogue: 0,0:27:34.29,0:27:37.04,Default,,0,0,0,,(Аннаның ентігу дыбысы)
Dialogue: 0,0:27:38.12,0:27:39.87,Default,,0,0,0,,Мен қандай болсам, солаймын...
Dialogue: 0,0:27:40.66,0:27:46.12,Default,,0,0,0,,(Аннаның жөтел дыбысы)
Dialogue: 0,0:27:47.75,0:27:50.29,Default,,0,0,0,,♪~
Dialogue: 0,0:28:05.54,0:28:07.29,Default,,0,0,0,,Мен қандай болсам, солаймын
Dialogue: 0,0:28:08.54,0:28:10.79,Default,,0,0,0,,Ұсқынсыз және ақымақ
Dialogue: 0,0:28:11.91,0:28:14.79,Default,,0,0,0,,ұнамсыз және ұнамсыз
Dialogue: 0,0:28:17.75,0:28:18.87,Default,,0,0,0,,Сонымен
Dialogue: 0,0:28:20.70,0:28:22.37,Default,,0,0,0,,Мен өзімді жек көремін
Dialogue: 0,0:28:24.70,0:28:26.54,Default,,0,0,0,,Сондықтан мен туралы бәрі ойлайды...
Dialogue: 0,0:28:24.70,0:28:26.54,Default,,0,0,0,,~♪
Dialogue: 0,0:28:29.00,0:28:31.41,Default,,0,0,0,,Бізге көп жол жоқ.
Dialogue: 0,0:28:31.50,0:28:33.95,Default,,0,0,0,,Бұл жағдайда әдетте сіз боласыз.
Dialogue: 0,0:28:34.04,0:28:36.00,Default,,0,0,0,,Сіз бұл туралы әлі айтып жатырсыз ба?
Dialogue: 0,0:28:36.58,0:28:38.79,Default,,0,0,0,,Бұл мәселе қазір шешілуі керек еді.
Dialogue: 0,0:28:38.87,0:28:40.62,Default,,0,0,0,,Мен сені кінәлап отырған жоқпын.
Dialogue: 0,0:28:40.70,0:28:41.62,Default,,0,0,0,,Тек...
Dialogue: 0,0:28:41.70,0:28:43.20,Default,,0,0,0,,Сондықтан мен мұны көп айтамын!
Dialogue: 0,0:28:43.79,0:28:46.75,Default,,0,0,0,,Бұл ақша туралы емес!
Dialogue: 0,0:28:46.83,0:28:49.37,Default,,0,0,0,,Өйткені, сендер жақсысыңдар
Dialogue: 0,0:28:52.66,0:28:55.95,Default,,0,0,0,,♪~
Dialogue: 0,0:29:04.79,0:29:07.66,Default,,0,0,0,,~♪
Dialogue: 0,0:29:09.16,0:29:10.25,Default,,0,0,0,,Мен үйге баруым керек
Dialogue: 0,0:29:19.62,0:29:20.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:35.87,0:29:37.70,Default,,0,0,0,,Біреу келді ме деп ойлаймын.
Dialogue: 0,0:29:40.16,0:29:41.00,Default,,0,0,0,,Ах
Dialogue: 0,0:29:42.58,0:29:44.16,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:29:51.83,0:29:52.91,Default,,0,0,0,,Ах
Dialogue: 0,0:29:55.70,0:29:58.45,Default,,0,0,0,,Хмм... Жарайды.
Dialogue: 0,0:29:59.75,0:30:02.54,Default,,0,0,0,,Ах... ой!
Dialogue: 0,0:30:07.91,0:30:08.83,Default,,0,0,0,,О!
Dialogue: 0,0:30:17.41,0:30:18.70,Default,,0,0,0,,Уууу… Уф!
Dialogue: 0,0:30:25.16,0:30:26.04,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,0:30:32.66,0:30:33.50,Default,,0,0,0,,Ха!
Dialogue: 0,0:30:35.33,0:30:37.37,Default,,0,0,0,,Ха! Ол қозғалмайды!
Dialogue: 0,0:30:40.29,0:30:41.33,Default,,0,0,0,,Тыныш, сендер!
Dialogue: 0,0:30:42.75,0:30:44.33,Default,,0,0,0,,Ах! Уф
Dialogue: 0,0:30:44.41,0:30:45.66,Default,,0,0,0,,Арқанды осы жерге лақтыр!
Dialogue: 0,0:30:46.16,0:30:48.58,Default,,0,0,0,,Арқан? Хаха
Dialogue: 0,0:30:51.00,0:30:52.16,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:31:02.87,0:31:03.75,Default,,0,0,0,,Ах!
Dialogue: 0,0:31:06.45,0:31:07.29,Default,,0,0,0,,Уууу… Уф!
Dialogue: 0,0:31:09.16,0:31:12.41,Default,,0,0,0,,(Аннаның тыныссыз дауысы)
Dialogue: 0,0:31:19.29,0:31:21.75,Default,,0,0,0,,♪~
Dialogue: 0,0:31:23.29,0:31:24.33,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:31:25.95,0:31:28.83,Default,,0,0,0,,Иә, у...
Dialogue: 0,0:31:30.54,0:31:32.04,Default,,0,0,0,,Сіз нағыз адамсыз ба? (Марни) Тынш!
Dialogue: 0,0:31:32.87,0:31:34.58,Default,,0,0,0,,Ешкімнің сұрауына жол бермеңіз.
Dialogue: 0,0:31:35.70,0:31:38.33,Default,,0,0,0,,Түсімде пайда болған бала сияқты
Dialogue: 0,0:31:39.33,0:31:40.20,Default,,0,0,0,,Сіз жақсысыз ба?
Dialogue: 0,0:31:48.54,0:31:49.45,Default,,0,0,0,,О!
Dialogue: 0,0:31:54.91,0:31:56.04,Default,,0,0,0,,Рахмет
Dialogue: 0,0:32:00.54,0:32:01.83,Default,,0,0,0,,Бұл арман емес
Dialogue: 0,0:32:05.04,0:32:05.95,Default,,0,0,0,,Ах
Dialogue: 0,0:32:08.20,0:32:10.54,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:32:11.04,0:32:12.04,Default,,0,0,0,,Анна
Dialogue: 0,0:32:12.33,0:32:15.12,Default,,0,0,0,,Мен сенімен танысқым келеді.
Dialogue: 0,0:32:15.87,0:32:16.87,Default,,0,0,0,,Мен тастап кеткен құралдар—
Dialogue: 0,0:32:18.12,0:32:19.12,Default,,0,0,0,,Иә
Dialogue: 0,0:32:20.87,0:32:22.62,Default,,0,0,0,,Сіз мені көрдіңіз бе?
Dialogue: 0,0:32:23.70,0:32:26.41,Default,,0,0,0,,Иә, жиі
Dialogue: 0,0:32:27.54,0:32:29.50,Default,,0,0,0,,Мен жаңа келдім бе?
Dialogue: 0,0:32:29.87,0:32:31.58,Default,,0,0,0,,Сіз мұнда қанша уақыт болдыңыз?
Dialogue: 0,0:32:31.95,0:32:33.75,Default,,0,0,0,,Мен мұнда мәңгі болдым... (есіктің ашылған дыбысы)
Dialogue: 0,0:32:35.70,0:32:38.12,Default,,0,0,0,,(Марнидің анасының күлкісі)
Dialogue: 0,0:32:39.87,0:32:40.91,Default,,0,0,0,,Уф (Анна) А...
Dialogue: 0,0:32:47.20,0:32:51.58,Default,,0,0,0,,Түнде батпақты жерге қара.
Dialogue: 0,0:32:52.20,0:32:56.50,Default,,0,0,0,,Бұл әдемі. Эй, сәл жақындайық.
Dialogue: 0,0:32:56.58,0:32:57.45,Default,,0,0,0,,ханым
Dialogue: 0,0:32:58.50,0:32:59.87,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:33:00.37,0:33:03.37,Default,,0,0,0,,Айтпақшы, ол бала қайда?
Dialogue: 0,0:33:03.70,0:33:06.04,Default,,0,0,0,,Мен бөлмеде болған жоқпын.
Dialogue: 0,0:33:10.20,0:33:11.41,Default,,0,0,0,,Мен қайтуым керек
Dialogue: 0,0:33:12.00,0:33:13.54,Default,,0,0,0,,Бұл сіз туралы ма?
Dialogue: 0,0:33:13.62,0:33:14.66,Default,,0,0,0,,Иә
Dialogue: 0,0:33:16.54,0:33:19.37,Default,,0,0,0,,Мен әдетте төсекте болатын уақыт
Dialogue: 0,0:33:22.12,0:33:24.37,Default,,0,0,0,,Жүр, мен сені сонда апарамын.
Dialogue: 0,0:33:25.79,0:33:27.08,Default,,0,0,0,,Бұл сенің қайығың еді, солай емес пе?
Dialogue: 0,0:33:28.00,0:33:30.41,Default,,0,0,0,,Иә, мен оны сізге әдейі қалдырдым.
Dialogue: 0,0:33:30.50,0:33:31.33,Default,,0,0,0,,(Марнидің күлкісі)
Dialogue: 0,0:33:34.62,0:33:37.45,Default,,0,0,0,,Бірақ мен бұл сәл жақсырақ күйеді деп ойладым.
Dialogue: 0,0:33:37.62,0:33:39.83,Default,,0,0,0,,(Марнидің күлкісі)
Dialogue: 0,0:33:40.08,0:33:43.04,Default,,0,0,0,,Мен де солай ойладым.
Dialogue: 0,0:33:45.66,0:33:47.91,Default,,0,0,0,,Сен менің асыл сырымсың
Dialogue: 0,0:33:49.20,0:33:52.45,Default,,0,0,0,,Мен ешкімге айтқан емеспін және айтпаймын.
Dialogue: 0,0:33:53.20,0:33:56.45,Default,,0,0,0,,Өйткені біреу білсе, сені әбігерге салады.
Dialogue: 0,0:34:03.83,0:34:06.37,Default,,0,0,0,,Эй, өтінемін, маған уәде бер.
Dialogue: 0,0:34:07.95,0:34:11.04,Default,,0,0,0,,Біз мәңгілік құпиямыз
Dialogue: 0,0:34:12.75,0:34:13.75,Default,,0,0,0,,Иә
Dialogue: 0,0:34:15.37,0:34:17.79,Default,,0,0,0,,Бұл мәңгілік құпия.
Dialogue: 0,0:34:32.41,0:34:33.79,Default,,0,0,0,,~♪
Dialogue: 0,0:34:46.08,0:34:47.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:35:00.83,0:35:04.33,Default,,0,0,0,,Әйтеуір қиын болды, үйге жылап келдім.
Dialogue: 0,0:35:05.54,0:35:07.12,Default,,0,0,0,,Бұл не Анна?
Dialogue: 0,0:35:07.20,0:35:09.83,Default,,0,0,0,,Менің балам семіз шошқа!
Dialogue: 0,0:35:10.25,0:35:11.58,Default,,0,0,0,,Майлы шошқа?
Dialogue: 0,0:35:12.79,0:35:15.62,Default,,0,0,0,,Сонымен қатар, сіз кескішті сипап жібердіңіз.
Dialogue: 0,0:35:15.70,0:35:16.70,Default,,0,0,0,,О, бұл қорқынышты
Dialogue: 0,0:35:16.79,0:35:18.16,Default,,0,0,0,,Мен бұған сене алмаймын.
Dialogue: 0,0:35:18.37,0:35:20.95,Default,,0,0,0,,Жоқ. Адамнан сұраған дұрыс.
Dialogue: 0,0:35:21.04,0:35:22.58,Default,,0,0,0,,Жүр, мені осында әкел.
Dialogue: 0,0:35:23.70,0:35:25.87,Default,,0,0,0,,Ол әлі оралмаған сияқты.
Dialogue: 0,0:35:25.95,0:35:30.58,Default,,0,0,0,,Бұл жаман! Сенің осынша кеш жүргеніңе сене алар емеспін.
Dialogue: 0,0:35:30.91,0:35:33.50,Default,,0,0,0,,Сіз де жауаптысыз.
Dialogue: 0,0:35:34.70,0:35:36.70,Default,,0,0,0,,Өтінемін, мені қадағалаңыз.
Dialogue: 0,0:35:40.70,0:35:42.08,Default,,0,0,0,,Қараңғы, сондықтан мынаны пайдаланыңыз
Dialogue: 0,0:35:42.16,0:35:43.37,Default,,0,0,0,,Көшелер сонша көп, мүлде адасып кеттім.
Dialogue: 0,0:35:46.12,0:35:49.62,Default,,0,0,0,,Толық жергілікті балаға бірдеңе болса, не істер едің?
Dialogue: 0,0:35:51.29,0:35:54.04,Default,,0,0,0,,Хмм... Үйге кешігіп келе жатқан шығармын.
Dialogue: 0,0:35:54.12,0:35:55.50,Default,,0,0,0,,Бұлай ашуланба.
Dialogue: 0,0:35:55.62,0:35:57.75,Default,,0,0,0,,Ол ақаулы ма? Сол бала
Dialogue: 0,0:35:59.16,0:36:00.75,Default,,0,0,0,,А, мен қайтып келдім.
Dialogue: 0,0:36:01.66,0:36:02.87,Default,,0,0,0,,Анна-чан
Dialogue: 0,0:36:04.08,0:36:05.20,Default,,0,0,0,,Апай
Dialogue: 0,0:36:05.29,0:36:08.50,Default,,0,0,0,,Сіз мұны естідіңіз бе? Бұл туралы алаңдамаңыз
Dialogue: 0,0:36:10.50,0:36:12.04,Default,,0,0,0,,Біз бітісеміз.
Dialogue: 0,0:36:13.04,0:36:15.54,Default,,0,0,0,,Ваннаға түсіп, тамақ ішіңіз.
Dialogue: 0,0:36:15.91,0:36:16.79,Default,,0,0,0,,Иә
Dialogue: 0,0:36:16.87,0:36:19.87,Default,,0,0,0,,Жоқ.Тамақ ішкеннен кейін шомылу керек пе?
Dialogue: 0,0:36:20.08,0:36:21.95,Default,,0,0,0,,Қайсысы маңызды емес.
Dialogue: 0,0:36:23.37,0:36:25.54,Default,,0,0,0,,Бірақ "Семіз шошқа" жақсы болмады.
Dialogue: 0,0:36:25.62,0:36:26.75,Default,,0,0,0,,(Киёмасаның күлкісі)
Dialogue: 0,0:36:27.29,0:36:28.91,Default,,0,0,0,,Сөз жоқ (Киёмасаның күлкісі)
Dialogue: 0,0:36:29.00,0:36:30.37,Default,,0,0,0,,Сіз тым қатты күлесіз
Dialogue: 0,0:36:48.29,0:36:50.58,Default,,0,0,0,,Әлі де уайымдаймын
Dialogue: 0,0:36:55.12,0:36:57.25,Default,,0,0,0,,Анна-чан! Бұл қарбыз
Dialogue: 0,0:37:02.83,0:37:04.16,Default,,0,0,0,,Анна-чан?
Dialogue: 0,0:37:07.33,0:37:10.25,Default,,0,0,0,,Толқынға екі сағат қалды
Dialogue: 0,0:37:10.87,0:37:14.79,Default,,0,0,0,,(Аннаның ентігу дыбысы)
Dialogue: 0,0:37:14.91,0:37:18.00,Default,,0,0,0,,(Аннаның ентігу дыбысы)
Dialogue: 0,0:37:26.66,0:37:30.45,Default,,0,0,0,,Hah... (Марнидің қайық есіп бара жатқан дыбысы)
Dialogue: 0,0:37:37.58,0:37:38.58,Default,,0,0,0,,Ах!
Dialogue: 0,0:37:50.37,0:37:53.91,Default,,0,0,0,,(Аннаның созылған дыбысы)
Dialogue: 0,0:37:54.83,0:37:56.91,Default,,0,0,0,,Жүр! Бұл пикник
Dialogue: 0,0:37:57.58,0:37:59.41,Default,,0,0,0,,Мен шырын мен печенье әкелдім.
Dialogue: 0,0:37:59.83,0:38:02.66,Default,,0,0,0,,Осындай уақытта пикникке бару керек пе?
Dialogue: 0,0:38:02.75,0:38:05.29,Default,,0,0,0,,Дұрыс, бұғаздың артына барайық.
Dialogue: 0,0:38:05.79,0:38:08.83,Default,,0,0,0,,♪~
Dialogue: 0,0:38:18.33,0:38:20.08,Default,,0,0,0,,Сіз қайықпен жүзуге шеберсіз, солай емес пе?
Dialogue: 0,0:38:22.16,0:38:24.08,Default,,0,0,0,,Сізге де жаттығу керек
Dialogue: 0,0:38:24.41,0:38:25.45,Default,,0,0,0,,Мұнда келіңіз
Dialogue: 0,0:38:25.54,0:38:26.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:38:30.66,0:38:31.66,Default,,0,0,0,,Бұл оңай.
Dialogue: 0,0:38:38.87,0:38:43.87,Default,,0,0,0,,Сен менің үлкен сырымсың деп айтқаным есіңде ме?
Dialogue: 0,0:38:45.87,0:38:48.95,Default,,0,0,0,,Есіңде болсын, сен де менің сырымсың.
Dialogue: 0,0:38:49.66,0:38:51.00,Default,,0,0,0,,Жақсы
Dialogue: 0,0:38:51.33,0:38:52.54,Default,,0,0,0,,Ах!
Dialogue: 0,0:38:52.62,0:38:53.66,Default,,0,0,0,,Сәлем! (Марни күледі)
Dialogue: 0,0:38:59.33,0:39:01.41,Default,,0,0,0,,Жақсы, жақсы
Dialogue: 0,0:39:05.79,0:39:09.16,Default,,0,0,0,,Бірақ мен сенің атыңды әлі білмеймін.
Dialogue: 0,0:39:10.25,0:39:11.33,Default,,0,0,0,,Га
Dialogue: 0,0:39:12.29,0:39:13.54,Default,,0,0,0,,Мен бәс тігемін, ол ауыр мазутпен ластанған теңіз қарлығаштарына от қоятын жан
Dialogue: 0,0:39:15.29,0:39:16.29,Default,,0,0,0,,Марни
Dialogue: 0,0:39:16.66,0:39:18.20,Default,,0,0,0,,Мен сіз білесіз деп ойладым.
Dialogue: 0,0:39:18.29,0:39:20.50,Default,,0,0,0,,Хе-хе-хе…
Dialogue: 0,0:39:20.58,0:39:21.83,Default,,0,0,0,,Бұл қауіпті
Dialogue: 0,0:39:30.79,0:39:32.95,Default,,0,0,0,,Енді жалғастыра бер.
Dialogue: 0,0:39:43.41,0:39:46.41,Default,,0,0,0,,~♪
Dialogue: 0,0:39:49.87,0:39:53.33,Default,,0,0,0,,Мен сен туралы білгім келетін нәрселер өте көп.
Dialogue: 0,0:39:54.12,0:39:56.66,Default,,0,0,0,,Бірақ мен бірте-бірте білгім келеді
Dialogue: 0,0:39:57.79,0:40:00.12,Default,,0,0,0,,Мен оны ақырындап өзім тапқым келеді.
Dialogue: 0,0:40:00.79,0:40:01.62,Default,,0,0,0,,Иә
Dialogue: 0,0:40:02.25,0:40:04.33,Default,,0,0,0,,Ей, мұны істейік.
Dialogue: 0,0:40:05.00,0:40:09.50,Default,,0,0,0,,Түнде бір-бірімізге үш сұрақ қоямыз.
Dialogue: 0,0:40:09.95,0:40:11.04,Default,,0,0,0,,Қалай болғанда да, ең алдымен мен Мими-уэге жақындауым керек, бірақ
Dialogue: 0,0:40:11.12,0:40:13.33,Default,,0,0,0,,Ал, енді меннен бастайық.
Dialogue: 0,0:40:13.41,0:40:17.16,Default,,0,0,0,,1-сұрақ Сен неге бұл ауылдасың?
Dialogue: 0,0:40:18.20,0:40:20.08,Default,,0,0,0,,Менде астма бар.
Dialogue: 0,0:40:20.16,0:40:25.04,Default,,0,0,0,,Сонымен, дәрігер Ямашита маған біраз уақыт таза ауасы бар жерге бару керектігін айтты.
Dialogue: 0,0:40:25.83,0:40:27.79,Default,,0,0,0,,Мектепті жіберіп алған дұрыс.
Dialogue: 0,0:40:27.87,0:40:29.41,Default,,0,0,0,,Ал, ауырып тұрсың ба?
Dialogue: 0,0:40:29.50,0:40:31.04,Default,,0,0,0,,Ұстама болмаса, жарайды.
Dialogue: 0,0:40:31.91,0:40:35.58,Default,,0,0,0,,Сонымен, мен қазір тәтемнің туысы Ойваның үйіндемін.
Dialogue: 0,0:40:36.12,0:40:39.04,Default,,0,0,0,,Апай деген кім? (Анна) Енді менің сұрақ қою кезегім.
Dialogue: 0,0:40:39.91,0:40:41.91,Default,,0,0,0,,Сіз сол сарайда тұрасыз ба?
Dialogue: 0,0:40:42.87,0:40:44.62,Default,,0,0,0,,Екі жасымнан бері.
Dialogue: 0,0:40:45.20,0:40:46.95,Default,,0,0,0,,Әже мен Ниямен
Dialogue: 0,0:40:48.04,0:40:48.91,Default,,0,0,0,,Шырын
Dialogue: 0,0:40:49.87,0:40:51.91,Default,,0,0,0,,Сенің әкең мен анаң ше?
Dialogue: 0,0:40:52.95,0:40:56.91,Default,,0,0,0,,Жұмысым көп болғандықтан анда-санда ғана келе аламын.
Dialogue: 0,0:40:57.00,0:40:57.95,Default,,0,0,0,,Иә
Dialogue: 0,0:40:58.25,0:41:01.16,Default,,0,0,0,,2-сұрақ Апай деген кім?
Dialogue: 0,0:41:02.87,0:41:03.91,Default,,0,0,0,,Менің қамқоршым
Dialogue: 0,0:41:04.95,0:41:07.87,Default,,0,0,0,,Бірақ сіз мені қиын деп ойлайсыз
Dialogue: 0,0:41:07.95,0:41:10.16,Default,,0,0,0,,Мен сені осында біраз уақытқа әкелдім.
Dialogue: 0,0:41:10.25,0:41:11.29,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:41:12.04,0:41:13.83,Default,,0,0,0,,Мен бұл туралы бір күні айтып беремін.
Dialogue: 0,0:41:14.50,0:41:15.91,Default,,0,0,0,,Келесі менің кезегім.
Dialogue: 0,0:41:17.04,0:41:18.37,Default,,0,0,0,,Қанша ағайындысың?
Dialogue: 0,0:41:17.04,0:41:18.37,Default,,0,0,0,,♪~
Dialogue: 0,0:41:18.45,0:41:19.91,Default,,0,0,0,,Мен жалғыз баламын
Dialogue: 0,0:41:20.04,0:41:21.62,Default,,0,0,0,,Иә, сіз де.
Dialogue: 0,0:41:21.70,0:41:22.79,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:41:24.37,0:41:26.04,Default,,0,0,0,,Бұл үлкен мәселе емес.
Dialogue: 0,0:41:26.95,0:41:30.04,Default,,0,0,0,,Өйткені ағам болса қандай болар еді деп ойладым.
Dialogue: 0,0:41:30.83,0:41:33.95,Default,,0,0,0,,Иә, сіз оны елестетсеңіз, бұл қызықты естіледі.
Dialogue: 0,0:41:34.45,0:41:36.04,Default,,0,0,0,,Енді 3-сұрақ.
Dialogue: 0,0:41:36.70,0:41:39.16,Default,,0,0,0,,Ойва мырзаның бұл өмірі қандай?
Dialogue: 0,0:41:40.00,0:41:41.04,Default,,0,0,0,,Оива мырза?
Dialogue: 0,0:41:44.50,0:41:45.45,Default,,0,0,0,,Бұл
Dialogue: 0,0:41:46.62,0:41:47.62,Default,,0,0,0,,Бұл тест
Dialogue: 0,0:41:49.08,0:41:50.08,Default,,0,0,0,,Ойлар...
Dialogue: 0,0:41:51.45,0:41:52.41,Default,,0,0,0,,Шығаруға болмайды
Dialogue: 0,0:42:29.37,0:42:30.25,Default,,0,0,0,,Марни?
Dialogue: 0,0:42:33.95,0:42:35.16,Default,,0,0,0,,Марни!
Dialogue: 0,0:42:35.25,0:42:36.33,Default,,0,0,0,,Анна!
Dialogue: 0,0:42:38.75,0:42:42.29,Default,,0,0,0,,Жақсы, қайда бардың деп қызық болдым.
Dialogue: 0,0:42:45.58,0:42:46.54,Default,,0,0,0,,Марни?
Dialogue: 0,0:42:52.25,0:42:55.91,Default,,0,0,0,,Мен сені көптен бері іздедім, бірақ сен кенет жоғалып кеттің.
Dialogue: 0,0:42:56.54,0:42:58.29,Default,,0,0,0,,Мен ешқайда кетпеймін.
Dialogue: 0,0:42:58.37,0:43:00.91,Default,,0,0,0,,Тек сұрағыңызға жауап беруге тырысамын
Dialogue: 0,0:43:02.04,0:43:05.08,Default,,0,0,0,,Әй, бұл не?
Dialogue: 0,0:43:05.16,0:43:08.70,Default,,0,0,0,,Жетер, маған бәрібір.
Dialogue: 0,0:43:08.79,0:43:11.12,Default,,0,0,0,,Бүгін тезірек оралуым керек.
Dialogue: 0,0:43:13.33,0:43:15.29,Default,,0,0,0,,Аа, дұрыс!
Dialogue: 0,0:43:17.16,0:43:19.41,Default,,0,0,0,,Мүмкін емес Мүмкін емес Мүмкін емес Мүлде мүмкін емес!
Dialogue: 0,0:43:19.95,0:43:21.66,Default,,0,0,0,,Партиялар және осыған ұқсас нәрселер I
Dialogue: 0,0:43:21.75,0:43:22.75,Default,,0,0,0,,Жарайды
Dialogue: 0,0:43:24.08,0:43:25.87,Default,,0,0,0,,Менің бір қызық ойым бар.
Dialogue: 0,0:43:32.00,0:43:33.12,Default,,0,0,0,,(Марнидің күлкісі)
Dialogue: 0,0:43:43.16,0:43:45.91,Default,,0,0,0,,(Пластинкалардағы классикалық музыка)
Dialogue: 0,0:43:48.54,0:43:50.91,Default,,0,0,0,,(Сөйлесіп жатқан адамдардың дауыстары)
Dialogue: 0,0:44:01.25,0:44:03.04,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:44:03.12,0:44:04.29,Default,,0,0,0,,Ааа, сене алар емеспін.
Dialogue: 0,0:44:14.75,0:44:15.91,Default,,0,0,0,,Сол екеу ме?
Dialogue: 0,0:44:16.00,0:44:16.87,Default,,0,0,0,,(Есіктің жабылу дыбысы)
Dialogue: 0,0:44:17.20,0:44:21.12,Default,,0,0,0,,Кешіріңіз! Сіз күттіңіз бе? Мен одан шыға алмаймын
Dialogue: 0,0:44:21.75,0:44:22.70,Default,,0,0,0,,Марни!
Dialogue: 0,0:44:22.79,0:44:25.45,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:44:26.79,0:44:27.95,Default,,0,0,0,,Бұл әдемі
Dialogue: 0,0:44:28.91,0:44:31.37,Default,,0,0,0,,Мен әжемнің орамалын қарызға алдым.
Dialogue: 0,0:44:31.79,0:44:33.66,Default,,0,0,0,,Қайта ашуланып жатырсың, хехе
Dialogue: 0,0:44:33.75,0:44:34.75,Default,,0,0,0,,Ол L-дің атын білген бойда мен тергеу штабын түгел жоямын.
Dialogue: 0,0:44:35.33,0:44:37.83,Default,,0,0,0,,Жарайды, мен әкеме айттым.
Dialogue: 0,0:44:44.45,0:44:45.70,Default,,0,0,0,,Оджо-сама! (Марни) Ха
Dialogue: 0,0:44:47.16,0:44:49.50,Default,,0,0,0,,Қазір ұйықтайтын уақыт болуы керек.
Dialogue: 0,0:44:50.37,0:44:52.08,Default,,0,0,0,,Бұл адам кім?
Dialogue: 0,0:44:54.95,0:44:56.70,Default,,0,0,0,,Менің орамалымды киіңіз
Dialogue: 0,0:44:59.00,0:45:00.45,Default,,0,0,0,,Екінші қабатқа барыңыз! (Анна) Иә!
Dialogue: 0,0:45:01.37,0:45:02.45,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:45:06.75,0:45:07.70,Default,,0,0,0,,Ах! (Баспалдақпен көтерілу дыбысы)
Dialogue: 0,0:45:10.12,0:45:11.12,Default,,0,0,0,,(Әженің тамағын тазалап жатқан дауысы)
Dialogue: 0,0:45:11.70,0:45:12.91,Default,,0,0,0,,Га
Dialogue: 0,0:45:16.50,0:45:19.16,Default,,0,0,0,,Сіз тағы бір жаман нәрсені ойлап отырсыз.
Dialogue: 0,0:45:20.12,0:45:21.00,Default,,0,0,0,,Анна сол жаққа барады
Dialogue: 0,0:45:21.08,0:45:22.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:45:22.33,0:45:23.33,Default,,0,0,0,,Ах
Dialogue: 0,0:45:24.87,0:45:26.25,Default,,0,0,0,,Марни!
Dialogue: 0,0:45:27.58,0:45:29.00,Default,,0,0,0,,(Әженің ыңырануы)
Dialogue: 0,0:45:34.66,0:45:36.79,Default,,0,0,0,,(Әженің ыңырануы)
Dialogue: 0,0:45:39.83,0:45:40.79,Default,,0,0,0,,Марни!
Dialogue: 0,0:45:41.37,0:45:42.83,Default,,0,0,0,,Ашық!
Dialogue: 0,0:45:42.91,0:45:43.75,Default,,0,0,0,,Кеттік
Dialogue: 0,0:45:43.83,0:45:45.62,Default,,0,0,0,,Егер сіз осылай жасай берсеңіз
Dialogue: 0,0:45:45.70,0:45:47.95,Default,,0,0,0,,Сіз жалқау ересек адамға айналасыз.
Dialogue: 0,0:45:48.08,0:45:53.04,Default,,0,0,0,,(Марнидің күлкісі)
Dialogue: 0,0:45:55.58,0:45:58.95,Default,,0,0,0,,Сәлем бәріңе, міне бір сүйкімді гүл қыз.
Dialogue: 0,0:45:59.83,0:46:01.62,Default,,0,0,0,,Қызымның қонағы.
Dialogue: 0,0:46:01.70,0:46:03.08,Default,,0,0,0,,Гүл қыз деген не?
Dialogue: 0,0:46:03.20,0:46:04.45,Default,,0,0,0,,Бұл қыз Марни.
Dialogue: 0,0:46:04.54,0:46:06.45,Default,,0,0,0,,Анаңдай сұлу боласың.
Dialogue: 0,0:46:06.83,0:46:10.20,Default,,0,0,0,,Мына гүлдерді ала аламын ба?
Dialogue: 0,0:46:11.66,0:46:12.58,Default,,0,0,0,,Ана
Dialogue: 0,0:46:20.83,0:46:24.87,Default,,0,0,0,,Қош келдіңіз, кішкентай бақсы, хехехе
Dialogue: 0,0:46:25.33,0:46:28.08,Default,,0,0,0,,Ол кісі нағыз бақсы.
Dialogue: 0,0:46:28.20,0:46:30.66,Default,,0,0,0,,(Барлығы күледі)
Dialogue: 0,0:46:30.75,0:46:31.75,Default,,0,0,0,,Ум...
Dialogue: 0,0:46:35.08,0:46:37.70,Default,,0,0,0,,Охохохо
Dialogue: 0,0:46:37.79,0:46:40.75,Default,,0,0,0,,Мен тек сәттілік тілеймін.
Dialogue: 0,0:46:41.79,0:46:45.37,Default,,0,0,0,,Менің гүлдерімнің ақысын біреу төлей ме?
Dialogue: 0,0:46:48.16,0:46:50.62,Default,,0,0,0,,Бақсының өтінішіне келгенде (Джентельмен 2), мен де.
Dialogue: 0,0:46:51.29,0:46:52.95,Default,,0,0,0,,Сонда мен де
Dialogue: 0,0:46:53.45,0:46:55.00,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:46:55.08,0:46:57.08,Default,,0,0,0,,Мен де (Анна) А...
Dialogue: 0,0:46:57.20,0:46:59.33,Default,,0,0,0,,(аккордеон дыбысы)
Dialogue: 0,0:46:59.66,0:47:00.91,Default,,0,0,0,,О, басталды.
Dialogue: 0,0:47:06.29,0:47:07.33,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:47:07.41,0:47:08.37,Default,,0,0,0,,Жоқ, мен қашып кеттім.
Dialogue: 0,0:47:08.91,0:47:09.75,Default,,0,0,0,,О!
Dialogue: 0,0:47:09.83,0:47:10.50,Default,,0,0,0,,Жақсы
Dialogue: 0,0:47:24.20,0:47:26.66,Default,,0,0,0,,Сәттілік үшін біреуін алыңыз!
Dialogue: 0,0:47:26.75,0:47:27.83,Default,,0,0,0,,Оны ала аламын ба?
Dialogue: 0,0:47:28.33,0:47:30.75,Default,,0,0,0,,(Барлығы күледі)
Dialogue: 0,0:47:31.25,0:47:32.45,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:47:43.87,0:47:44.87,Default,,0,0,0,,Қария
Dialogue: 0,0:47:45.50,0:47:47.41,Default,,0,0,0,,Денсаулық үшін дұға ет
Dialogue: 0,0:47:48.12,0:47:50.95,Default,,0,0,0,,Аа, көп рахмет.
Dialogue: 0,0:47:53.16,0:47:54.54,Default,,0,0,0,,Хехе
Dialogue: 0,0:48:11.16,0:48:12.20,Default,,0,0,0,,Алкоголь!
Dialogue: 0,0:48:24.33,0:48:25.70,Default,,0,0,0,,Сіз ояусыз ба? (Анна) А
Dialogue: 0,0:48:28.12,0:48:29.12,Default,,0,0,0,,Мен... (ықылдаған дыбыс)
Dialogue: 0,0:48:30.58,0:48:31.75,Default,,0,0,0,,Мас адам
Dialogue: 0,0:48:35.58,0:48:36.91,Default,,0,0,0,,Бұл адам кім?
Dialogue: 0,0:48:37.37,0:48:38.45,Default,,0,0,0,,Қай адам?
Dialogue: 0,0:48:38.66,0:48:40.04,Default,,0,0,0,,Мен билеген адам
Dialogue: 0,0:48:41.12,0:48:44.20,Default,,0,0,0,,Ах, Казухико, менің бала күнгі досым.
Dialogue: 0,0:48:45.95,0:48:48.00,Default,,0,0,0,,Сіз билеуде жақсысыз, солай емес пе?
Dialogue: 0,0:48:48.95,0:48:49.95,Default,,0,0,0,,Сіз де
Dialogue: 0,0:48:54.33,0:48:56.91,Default,,0,0,0,,Жүр, біз де билейік
Dialogue: 0,0:48:57.20,0:48:58.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:48:59.08,0:49:01.95,Default,,0,0,0,,А, эй, эй! аздап!
Dialogue: 0,0:49:02.04,0:49:03.25,Default,,0,0,0,,Би билей алмайды
Dialogue: 0,0:49:03.33,0:49:05.20,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:49:05.91,0:49:07.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:49:07.37,0:49:12.91,Default,,0,0,0,,(Марнидің ызылдаған дыбысы)
Dialogue: 0,0:49:20.75,0:49:23.29,Default,,0,0,0,,♪~
Dialogue: 0,0:49:42.79,0:49:46.66,Default,,0,0,0,,Ах! (Анна) Уа, уа, уа...
Dialogue: 0,0:49:49.37,0:49:52.04,Default,,0,0,0,,Ах
Dialogue: 0,0:49:52.79,0:49:58.91,Default,,0,0,0,,(Анна мен Марнидің күлкісі)
Dialogue: 0,0:50:02.50,0:50:04.29,Default,,0,0,0,,Мені тағы ізде
Dialogue: 0,0:50:05.87,0:50:08.95,Default,,0,0,0,,Және ешкімге айтпа, уәде бер.
Dialogue: 0,0:50:09.04,0:50:10.00,Default,,0,0,0,,Иә
Dialogue: 0,0:50:11.62,0:50:12.50,Default,,0,0,0,,(Марнидің күлкісі)
Dialogue: 0,0:50:13.50,0:50:15.08,Default,,0,0,0,,Уау, күте тұрыңыз!
Dialogue: 0,0:50:33.54,0:50:34.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:50:34.95,0:50:35.91,Default,,0,0,0,,Міне!
Dialogue: 0,0:50:41.00,0:50:42.75,Default,,0,0,0,,Оива мырза және мына бала.
Dialogue: 0,0:50:58.00,0:51:00.95,Default,,0,0,0,,~♪
Dialogue: 0,0:51:08.41,0:51:10.75,Default,,0,0,0,,(қуырылған жұмыртқаны таяқшамен кесу дыбысы)
Dialogue: 0,0:51:13.00,0:51:16.08,Default,,0,0,0,,Иә, Зоокты тапсам жақсы болар еді.
Dialogue: 0,0:51:17.00,0:51:18.75,Default,,0,0,0,,Мен оның бір жерде бар екеніне сенімдімін.
Dialogue: 0,0:51:19.33,0:51:20.50,Default,,0,0,0,,Мен оны іздеймін.
Dialogue: 0,0:51:21.66,0:51:23.04,Default,,0,0,0,,Мен де жиі заттарды жоғалтып аламын.
Dialogue: 0,0:51:23.83,0:51:26.83,Default,,0,0,0,,Толқынды жерлерде жерленген балалардың аяқ киімдері өте көп.
Dialogue: 0,0:51:27.12,0:51:28.87,Default,,0,0,0,,Мұны сізбен жасамаңыз
Dialogue: 0,0:51:29.50,0:51:32.45,Default,,0,0,0,,Менің қызымның кішкентай кезінде киген аяқ киімі бар деп ойлаймын.
Dialogue: 0,0:51:32.83,0:51:34.29,Default,,0,0,0,,Мен оны әзірге шығарамын.
Dialogue: 0,0:51:34.95,0:51:36.45,Default,,0,0,0,,Рахмет
Dialogue: 0,0:51:54.58,0:51:55.54,Default,,0,0,0,,Марни
Dialogue: 0,0:52:31.00,0:52:32.00,Default,,0,0,0,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,0:52:33.95,0:52:35.12,Default,,0,0,0,,Тек үлкен емес
Dialogue: 0,0:52:35.58,0:52:38.50,Default,,0,0,0,,Бұл тәтті және өте дәмді.
Dialogue: 0,0:52:39.00,0:52:41.54,Default,,0,0,0,,Ах! Ой (қызанақтарды тартып алған дыбыс)
Dialogue: 0,0:52:54.37,0:52:56.70,Default,,0,0,0,,Пышақты жақсы қолдануға болады.
Dialogue: 0,0:52:56.79,0:52:59.08,Default,,0,0,0,,Өйткені апам үнемі сабақ береді
Dialogue: 0,0:52:59.66,0:53:03.20,Default,,0,0,0,,Анна-чан жақсы сәлем бере алады, әдепті.
Dialogue: 0,0:53:03.83,0:53:06.04,Default,,0,0,0,,Мен де қызыма көрсеткім келеді.
Dialogue: 0,0:53:07.62,0:53:08.87,Default,,0,0,0,,Мен жай ғана өтіп кетемін.
Dialogue: 0,0:53:09.54,0:53:13.25,Default,,0,0,0,,Аннаның Йориконың орнына келгені есімде.
Dialogue: 0,0:53:14.20,0:53:16.00,Default,,0,0,0,,Бақыттымын десең,
Dialogue: 0,0:53:17.12,0:53:20.70,Default,,0,0,0,,Ол Анна-чанмен бірге болмаған бес жылдың орнын толтыратынын айтты.
Dialogue: 0,0:53:21.12,0:53:22.91,Default,,0,0,0,,Сіз көп нәрсені ойластырған сияқтысыз.
Dialogue: 0,0:53:24.54,0:53:28.70,Default,,0,0,0,,Оның бір себебі - пышақты жақсы пайдалана білу деп ойлаймын.
Dialogue: 0,0:53:33.00,0:53:35.25,Default,,0,0,0,,Бірақ бұл алаңдаушылық
Dialogue: 0,0:53:36.54,0:53:38.91,Default,,0,0,0,,Бірдеңе керек кезде маған қоңырау шалыңыз.
Dialogue: 0,0:53:39.00,0:53:42.29,Default,,0,0,0,,Менің де онша бос уақытым жоқ десем, сыбырладым.
Dialogue: 0,0:53:42.37,0:53:44.87,Default,,0,0,0,,О! Менің саған айтқым келгені осы, қызым.
Dialogue: 0,0:53:45.66,0:53:48.20,Default,,0,0,0,,Хехе, мен өте жақсы түсіндім.
Dialogue: 0,0:53:48.79,0:53:52.87,Default,,0,0,0,,Менде үйде Йорико жіберген көптеген фотоларыңыз бар.
Dialogue: 0,0:53:54.00,0:53:55.37,Default,,0,0,0,,Мен сізге кейінірек көрсетемін
Dialogue: 0,0:53:58.70,0:53:59.91,Default,,0,0,0,,(Жолаушы) Соңғы сегіздік пе? Сен керемет көріндің. (Изуку) Ә…
Dialogue: 0,0:54:01.20,0:54:03.87,Default,,0,0,0,,Бал айын баратын жерімде жасаған жел үні шықты.
Dialogue: 0,0:54:05.54,0:54:08.20,Default,,0,0,0,,Жазды осымен өткізейік, иә?
Dialogue: 0,0:54:10.16,0:54:12.04,Default,,0,0,0,,Шашыңыз ұзарып кетпей ме?
Dialogue: 0,0:54:12.62,0:54:14.45,Default,,0,0,0,,Саған кесіп берейін бе?
Dialogue: 0,0:54:14.83,0:54:15.66,Default,,0,0,0,,(Киришима & Сейро) Хахаха… Шынымен бе? Шынымен бе? Бакуго!
Dialogue: 0,0:54:15.75,0:54:17.37,Default,,0,0,0,,Сіз қиындыққа тап боласыз, солай ма?
Dialogue: 0,0:54:31.91,0:54:32.95,Default,,0,0,0,,Иә...
Dialogue: 0,0:54:44.33,0:54:46.00,Default,,0,0,0,,Марни?
Dialogue: 0,0:54:47.12,0:54:48.79,Default,,0,0,0,,Мені ізде.
Dialogue: 0,0:54:48.87,0:54:49.75,Default,,0,0,0,,Ха!
Dialogue: 0,0:54:55.16,0:54:58.08,Default,,0,0,0,,Мен Марниді ұмытып кете жаздадым.
Dialogue: 0,0:55:02.41,0:55:05.62,Default,,0,0,0,,(Аннаның ентігу дыбысы)
Dialogue: 0,0:55:07.87,0:55:09.16,Default,,0,0,0,,Ах!
Dialogue: 0,0:55:15.04,0:55:16.04,Default,,0,0,0,,Марни
Dialogue: 0,0:55:21.04,0:55:22.12,Default,,0,0,0,,Марни?
Dialogue: 0,0:55:27.83,0:55:28.83,Default,,0,0,0,,…
Dialogue: 0,0:55:28.91,0:55:31.95,Default,,0,0,0,,(Найзағайдың дыбысы)
Dialogue: 0,0:55:35.62,0:55:36.45,Default,,0,0,0,,Ах
Dialogue: 0,0:55:38.62,0:55:41.58,Default,,0,0,0,,Мен саған да беремін, Тору.
Dialogue: 0,0:56:07.04,0:56:08.50,Default,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:56:08.91,0:56:09.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:56:10.66,0:56:11.62,Default,,0,0,0,,Иә
Dialogue: 0,0:56:12.54,0:56:14.37,Default,,0,0,0,,Сіз де сурет саласыз, солай ма?
Dialogue: 0,0:56:15.20,0:56:17.91,Default,,0,0,0,,Ол бала мен білетін балаға ұқсайды.
Dialogue: 0,0:56:18.20,0:56:19.70,Default,,0,0,0,,Ол өте жақсы бала еді.
Dialogue: 0,0:56:21.66,0:56:23.33,Default,,0,0,0,,Иә, жақсы қыз.
Dialogue: 0,0:56:24.16,0:56:27.50,Default,,0,0,0,,Бірақ бір апта бойы бір-бірімізді көрмедік.
Dialogue: 0,0:56:29.00,0:56:32.62,Default,,0,0,0,,Мен ұмыттым деп ашуланып тұрсың ба?
Dialogue: 0,0:56:34.20,0:56:37.29,Default,,0,0,0,,Дос болсаң, менімен сөйлес, сонда бәрі жақсы болады.
Dialogue: 0,0:56:39.20,0:56:41.12,Default,,0,0,0,,Эй, мен қарап шыға аламын ба?
Dialogue: 0,0:56:41.83,0:56:42.79,Default,,0,0,0,,Иә
Dialogue: 0,0:56:49.16,0:56:50.08,Default,,0,0,0,,Қарапайым айтқанда—
Dialogue: 0,0:56:51.25,0:56:53.79,Default,,0,0,0,,Менің ойымша, түстер аздап шатастырылған.
Dialogue: 0,0:56:53.87,0:56:56.08,Default,,0,0,0,,Жоқ, бұл жақсы.
Dialogue: 0,0:56:56.50,0:56:58.08,Default,,0,0,0,,I Хисако
Dialogue: 0,0:56:58.16,0:57:01.83,Default,,0,0,0,,Сіз сулы-батпақты жерді жақсы көресіз бе?
Dialogue: 0,0:57:03.29,0:57:05.91,Default,,0,0,0,,Бұл Анна. Мен де сені жақсы көремін.
Dialogue: 0,0:57:07.95,0:57:09.95,Default,,0,0,0,,(шөпті басқан дыбыс)
Dialogue: 0,0:57:12.75,0:57:15.79,Default,,0,0,0,,Бірақ мен оның суретін тезірек аяқтауым керек.
Dialogue: 0,0:57:16.50,0:57:18.33,Default,,0,0,0,,Біреу кіріп келе жатқан сияқты.
Dialogue: 0,0:57:18.66,0:57:20.62,Default,,0,0,0,,Жөндеу жұмыстары жүріп жатыр.
Dialogue: 0,0:57:18.66,0:57:20.62,Default,,0,0,0,,~♪
Dialogue: 0,0:57:21.08,0:57:22.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:57:24.66,0:57:27.95,Default,,0,0,0,,Еңбегіңіз үшін рахмет. Мен шай қойдым.
Dialogue: 0,0:57:28.04,0:57:30.58,Default,,0,0,0,,Аа, кешіріңіз. Итадакимасу
Dialogue: 0,0:57:32.33,0:57:34.16,Default,,0,0,0,,Әй, бір дем алайық.
Dialogue: 0,0:57:34.25,0:57:35.95,Default,,0,0,0,,Жарайды, мен бірден кетемін.
Dialogue: 0,0:57:38.25,0:57:39.16,Default,,0,0,0,,Ах!
Dialogue: 0,0:57:41.29,0:57:42.62,Default,,0,0,0,,Хмм?
Dialogue: 0,0:57:43.79,0:57:44.95,Default,,0,0,0,,Ха...
Dialogue: 0,0:57:48.12,0:57:49.58,Default,,0,0,0,,Сіз Марнисіз бе?
Dialogue: 0,0:57:55.70,0:57:56.66,Default,,0,0,0,,Кел!
Dialogue: 0,0:58:11.16,0:58:13.79,Default,,0,0,0,,Мен алдыңғы жағын бірінші рет көріп тұрмын.
Dialogue: 0,0:58:14.33,0:58:17.04,Default,,0,0,0,,Мен оны біраз тазаладым, бірақ бұл әлі де орындалу үстінде.
Dialogue: 0,0:58:19.33,0:58:20.70,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:58:20.95,0:58:22.29,Default,,0,0,0,,Ей, жарайсың!
Dialogue: 0,0:58:22.37,0:58:24.37,Default,,0,0,0,,Бүгін достарың сенімен бірге ме?
Dialogue: 0,0:58:25.70,0:58:27.79,Default,,0,0,0,,Сүйікті тәпішкелеріңізді киіңіз
Dialogue: 0,0:58:28.70,0:58:29.75,Default,,0,0,0,,Тұтынушы?
Dialogue: 0,0:58:29.83,0:58:31.12,Default,,0,0,0,,Иә, құпия
Dialogue: 0,0:58:31.20,0:58:32.12,Default,,0,0,0,,Құпия?
Dialogue: 0,0:58:32.50,0:58:33.54,Default,,0,0,0,,Маңызы бар деп саналатын бір куәгерлік көрсету бар
Dialogue: 0,0:58:34.20,0:58:36.50,Default,,0,0,0,,Кешіріңіз, уақытыңызды бөліңіз.
Dialogue: 0,0:58:38.00,0:58:39.58,Default,,0,0,0,,Әкесі: Ллойд Форджер, психиатр
Dialogue: 0,0:58:41.08,0:58:43.62,Default,,0,0,0,,Иә Иә
Dialogue: 0,0:58:43.70,0:58:45.75,Default,,0,0,0,,Бұл өте жақсы жер.
Dialogue: 0,0:58:45.83,0:58:47.87,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:58:48.16,0:58:49.87,Default,,0,0,0,,Қазіргі уақытта жөндеу жұмыстары жүргізілуде
Dialogue: 0,0:58:50.58,0:58:51.62,Default,,0,0,0,,Бұл бөлме…
Dialogue: 0,0:58:51.91,0:58:53.20,Default,,0,0,0,,(Аяканың тамағын тазалап жатқан дыбысы)
Dialogue: 0,0:58:55.33,0:58:56.37,Default,,0,0,0,,Екінші қабатқа
Dialogue: 0,0:58:58.16,0:59:00.20,Default,,0,0,0,,Бұл бөлік әлі ескі.
Dialogue: 0,0:59:04.41,0:59:06.25,Default,,0,0,0,,Міне, менің бөлмемде
Dialogue: 0,0:59:09.33,0:59:10.25,Default,,0,0,0,,Иә
Dialogue: 0,0:59:15.12,0:59:16.08,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:59:16.33,0:59:18.87,Default,,0,0,0,,Иә, бұл сүйкімді бөлме.
Dialogue: 0,0:59:20.54,0:59:23.00,Default,,0,0,0,,Бұл сіздің бөлмеңіз емес пе еді?
Dialogue: 0,0:59:23.08,0:59:24.00,Default,,0,0,0,,Эх!
Dialogue: 0,0:59:24.66,0:59:25.75,Default,,0,0,0,,Не керек, Крюгер мырза?
Dialogue: 0,0:59:26.70,0:59:27.83,Default,,0,0,0,,Марни, солай ма?
Dialogue: 0,0:59:28.50,0:59:31.20,Default,,0,0,0,,Мен? Бұл басқаша!
Dialogue: 0,0:59:31.54,0:59:35.45,Default,,0,0,0,,Е! Сонда сен неге менің бөлмеме қарап тұрдың?
Dialogue: 0,0:59:35.54,0:59:36.75,Default,,0,0,0,,Бұл... (Аяка) Қараңдар!
Dialogue: 0,0:59:36.83,0:59:39.12,Default,,0,0,0,,Сіз әрқашан сондасыз.
Dialogue: 0,0:59:39.91,0:59:41.87,Default,,0,0,0,,Мен оны көп рет көрдім.
Dialogue: 0,0:59:44.20,0:59:45.25,Default,,0,0,0,,Қандай айырмашылығы бар?
Dialogue: 0,0:59:46.04,0:59:48.62,Default,,0,0,0,,Маған мына сарай ұнайды, болды.
Dialogue: 0,0:59:48.70,0:59:49.79,Default,,0,0,0,,Өтірік!
Dialogue: 0,0:59:51.00,0:59:54.33,Default,,0,0,0,,Мен Марни туралы бұрын естігенде, ол қатты таң қалды.
Dialogue: 0,0:59:54.54,0:59:57.16,Default,,0,0,0,,Сіз Марниді қайдан білесіз?
Dialogue: 0,1:00:02.20,1:00:04.16,Default,,0,0,0,,Мен оны сөрелердің арасынан таптым.
Dialogue: 0,1:00:04.29,1:00:05.87,Default,,0,0,0,,«Күнделік»
Dialogue: 0,1:00:05.95,1:00:07.08,Default,,0,0,0,,Күнделік?
Dialogue: 0,1:00:07.20,1:00:09.45,Default,,0,0,0,,Иә, бұл сенің күнделігің.
Dialogue: 0,1:00:14.20,1:00:15.91,Default,,0,0,0,,«Марни күнделігі»
Dialogue: 0,1:00:16.58,1:00:18.75,Default,,0,0,0,,Ха Марни!
Dialogue: 0,1:00:21.00,1:00:24.33,Default,,0,0,0,,Мен сізге сүйікті Мэри ханшайымыңызды әкелемін.
Dialogue: 0,1:00:25.45,1:00:26.54,Default,,0,0,0,,Мені күт
Dialogue: 0,1:00:27.29,1:00:28.25,Default,,0,0,0,,(Есіктің жабылу дыбысы)
Dialogue: 0,1:00:32.83,1:00:35.62,Default,,0,0,0,,«Юубе түнгі көйлегімен қайыққа отырды».
Dialogue: 0,1:00:37.04,1:00:40.16,Default,,0,0,0,,«Түнде батпақты жерлер мен ай өте әдемі болды».
Dialogue: 0,1:00:37.04,1:00:40.16,Default,,0,0,0,,♪~
Dialogue: 0,1:00:41.58,1:00:42.79,Default,,0,0,0,,«Мен қайтадан барғым келеді.»
Dialogue: 0,1:00:45.95,1:00:48.29,Default,,0,0,0,,«8 маусым партия»
Dialogue: 0,1:00:49.54,1:00:52.66,Default,,0,0,0,,«Анам мен әкем және көптеген достар келді...»
Dialogue: 0,1:00:52.75,1:00:54.20,Default,,0,0,0,,«Бұл өте қызық болды»
Dialogue: 0,1:00:56.37,1:00:58.04,Default,,0,0,0,,«Күн бөлмесінен шығыңыз»
Dialogue: 0,1:00:59.00,1:01:02.25,Default,,0,0,0,,«Мен гүл қызбен биледім».
Dialogue: 0,1:01:04.79,1:01:05.75,Default,,0,0,0,,«Бірақ...»
Dialogue: 0,1:01:06.62,1:01:11.00,Default,,0,0,0,,«Әжем мені Юбе туралы бөлмесіне қамап қойды».
Dialogue: 0,1:01:12.37,1:01:16.04,Default,,0,0,0,,«Енді мен біраз уақыт түнде қайықпен жүре алмаймын».
Dialogue: 0,1:01:23.79,1:01:26.20,Default,,0,0,0,,Эй, бұл сенсің ғой, солай ма?
Dialogue: 0,1:01:28.83,1:01:29.91,Default,,0,0,0,,Әртүрлі
Dialogue: 0,1:01:30.87,1:01:31.87,Default,,0,0,0,,Марни...
Dialogue: 0,1:01:32.75,1:01:37.45,Default,,0,0,0,,Марни... Мен оны ойлап таптым.
Dialogue: 0,1:01:39.50,1:01:42.62,Default,,0,0,0,,Қиялдағы қыз
Dialogue: 0,1:01:44.00,1:01:46.87,Default,,0,0,0,,Бірақ бұл Марнидің күнделігі.
Dialogue: 0,1:01:48.08,1:01:51.00,Default,,0,0,0,,Мен шынымен де осында тұрған сияқтымын.
Dialogue: 0,1:01:53.83,1:01:56.12,Default,,0,0,0,,Марни сізді білдірмей ме?
Dialogue: 0,1:01:56.62,1:01:59.08,Default,,0,0,0,,Иә (Аяка) Бұл жай ғана сіздің қиялыңызда пайда болды ма?
Dialogue: 0,1:01:59.33,1:02:00.20,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,1:02:02.75,1:02:06.37,Default,,0,0,0,,Мен Марни күнделік іздеп қайтып келді деп ойладым.
Dialogue: 0,1:02:06.45,1:02:07.83,Default,,0,0,0,,Эх (Аяканың төсекке құлаған дыбысы)
Dialogue: 0,1:02:10.66,1:02:13.95,Default,,0,0,0,,I'm Анна, and I'm coming from Sapporo for medical treatment.
Dialogue: 0,1:02:14.62,1:02:16.29,Default,,0,0,0,,I Аяка
Dialogue: 0,1:02:17.16,1:02:18.91,Default,,0,0,0,,Мен Токиодан келдім.
Dialogue: 0,1:02:20.50,1:02:23.20,Default,,0,0,0,,Бірақ сіздің қиялыңыздағы қыз ше?
Dialogue: 0,1:02:23.54,1:02:25.29,Default,,0,0,0,,Неліктен олардың аты бірдей?
Dialogue: 0,1:02:26.50,1:02:27.70,Default,,0,0,0,,Шынында да. Мен оны жеңілдетіп бағаладым. Шынында да жеңілдетіп бағаладым
Dialogue: 0,1:02:28.12,1:02:30.25,Default,,0,0,0,,Марни really exists
Dialogue: 0,1:02:30.87,1:02:32.62,Default,,0,0,0,,Мен оны қайтадан іздеймін.
Dialogue: 0,1:02:45.95,1:02:48.66,Default,,0,0,0,,Hey Марни
Dialogue: 0,1:02:50.45,1:02:53.16,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,1:03:01.91,1:03:04.91,Default,,0,0,0,,~♪
Dialogue: 0,1:03:15.37,1:03:16.41,Default,,0,0,0,,Бұл мен бе?
Dialogue: 0,1:03:17.54,1:03:18.50,Default,,0,0,0,,Ха...
Dialogue: 0,1:03:24.66,1:03:26.83,Default,,0,0,0,,Марни? Марни!
Dialogue: 0,1:03:29.62,1:03:33.79,Default,,0,0,0,,А... уф
Dialogue: 0,1:03:39.20,1:03:43.29,Default,,0,0,0,,А... бұл әлі жолда.
Dialogue: 0,1:03:44.04,1:03:46.29,Default,,0,0,0,,Ал, сен қаншалықты жақсысың?
Dialogue: 0,1:03:46.54,1:03:48.33,Default,,0,0,0,,О, досым! Осы жеңісті тойлайық
Dialogue: 0,1:03:48.41,1:03:51.16,Default,,0,0,0,,Мен өзімнің суретімді алғаш рет салып отырмын.
Dialogue: 0,1:03:51.58,1:03:52.83,Default,,0,0,0,,Мен қуаныштымын
Dialogue: 0,1:04:01.66,1:04:02.62,Default,,0,0,0,,Мәселе онда емес еді.
Dialogue: 0,1:04:05.95,1:04:08.37,Default,,0,0,0,,Жүрегімде сені шақырдым
Dialogue: 0,1:04:09.79,1:04:12.25,Default,,0,0,0,,♪~
Dialogue: 0,1:04:12.83,1:04:13.79,Default,,0,0,0,,Мен де
Dialogue: 0,1:04:14.75,1:04:16.54,Default,,0,0,0,,Кеттік (Анна) Менің бөлмеме кел!
Dialogue: 0,1:04:17.87,1:04:20.66,Default,,0,0,0,,Менің бөлмеме кел, Марни.
Dialogue: 0,1:04:23.50,1:04:26.66,Default,,0,0,0,,Мен сарайдан шыға алмаймын
Dialogue: 0,1:04:28.95,1:04:30.04,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,1:04:30.79,1:04:32.87,Default,,0,0,0,,Мен Марнидің қалаған жеріне барамын.
Dialogue: 0,1:05:00.62,1:05:01.83,Default,,0,0,0,,(Марнидің күлкісі)
Dialogue: 0,1:05:02.75,1:05:04.75,Default,,0,0,0,,Марни саңырауқұлақтар туралы көп біледі, солай ма?
Dialogue: 0,1:05:05.70,1:05:08.37,Default,,0,0,0,,Мұны маған кішкентай кезімде әкем үйреткен.
Dialogue: 0,1:05:09.16,1:05:12.41,Default,,0,0,0,,Мен бір рет үйге саңырауқұлақ толы үш қап әкелдім.
Dialogue: 0,1:05:14.00,1:05:18.79,Default,,0,0,0,,Мама таң қалды (Марни күлді)
Dialogue: 0,1:05:25.20,1:05:27.91,Default,,0,0,0,,Не болды? кенет үндемеді
Dialogue: 0,1:05:30.66,1:05:32.45,Default,,0,0,0,,Сіз жарылқадыңыз
Dialogue: 0,1:05:33.00,1:05:35.83,Default,,0,0,0,,Мен сен болғаныңды қалаймын
Dialogue: 0,1:05:45.95,1:05:46.95,Default,,0,0,0,,Әңгімелеу
Dialogue: 0,1:05:50.29,1:05:51.16,Default,,0,0,0,,Мен
Dialogue: 0,1:05:53.45,1:05:54.54,Default,,0,0,0,,Мен асырап алған баламын
Dialogue: 0,1:05:57.00,1:06:00.79,Default,,0,0,0,,Менің шын ата-анам кішкентай кезімде қайтыс болды.
Dialogue: 0,1:06:01.45,1:06:02.58,Default,,0,0,0,,Әже де
Dialogue: 0,1:06:03.95,1:06:06.79,Default,,0,0,0,,Мен сенің әдейі өлмегеніңді білемін.
Dialogue: 0,1:06:08.00,1:06:09.45,Default,,0,0,0,,Кейде ойлаймын
Dialogue: 0,1:06:11.04,1:06:15.00,Default,,0,0,0,,Мен сені жалғыз қалдыруға жол бермеймін
Dialogue: 0,1:06:20.16,1:06:21.66,Default,,0,0,0,,Мен сені қызғанамын!
Dialogue: 0,1:06:22.16,1:06:24.50,Default,,0,0,0,,Сіз асырап алғаныңыз үшін бақыттысыз деп ойлаймын.
Dialogue: 0,1:06:25.37,1:06:27.50,Default,,0,0,0,,Егер мен отбасысыз бала болсам...
Dialogue: 0,1:06:28.20,1:06:31.50,Default,,0,0,0,,Сол кезде қызымды асырап алған әке мен шеше болды.
Dialogue: 0,1:06:32.33,1:06:34.54,Default,,0,0,0,,Ол шынымен мейірімді адам ма деп ойлаймын.
Dialogue: 0,1:06:46.04,1:06:48.58,Default,,0,0,0,,Ал, мен сендерге үлкен сыр айтайын.
Dialogue: 0,1:06:50.00,1:06:53.41,Default,,0,0,0,,Мен апайларды айтып отырмын, олар маған мейірімді...
Dialogue: 0,1:06:53.50,1:06:55.08,Default,,0,0,0,,Өте мейірімді адамдар
Dialogue: 0,1:06:56.54,1:06:58.70,Default,,0,0,0,,Мен нағыз бала емеспін...
Dialogue: 0,1:06:58.79,1:07:01.12,Default,,0,0,0,,Осы уақытқа дейін мені өсіргеніңізге рахмет.
Dialogue: 0,1:07:03.70,1:07:06.20,Default,,0,0,0,,Бірақ сіз білесіз, мен таптым.
Dialogue: 0,1:07:07.16,1:07:09.83,Default,,0,0,0,,Бұл адамдарға жалақы төлене ме?
Dialogue: 0,1:07:11.29,1:07:12.29,Default,,0,0,0,,Ақша?
Dialogue: 0,1:07:11.29,1:07:12.29,Default,,0,0,0,,♪~
Dialogue: 0,1:07:13.00,1:07:15.25,Default,,0,0,0,,Мен мемлекеттік кеңседен келген хатты көрдім.
Dialogue: 0,1:07:17.62,1:07:21.62,Default,,0,0,0,,Маған бөлінген сома ұлғайтылды деп жазылған.
Dialogue: 0,1:07:23.54,1:07:25.41,Default,,0,0,0,,Себебі бұған себеп бар.
Dialogue: 0,1:07:25.50,1:07:27.12,Default,,0,0,0,,Кез келген себеп жақсы!
Dialogue: 0,1:07:29.37,1:07:31.54,Default,,0,0,0,,Егер мен нағыз бала болсам...
Dialogue: 0,1:07:32.12,1:07:33.79,Default,,0,0,0,,Мен бұл ақшаны алған жоқпын.
Dialogue: 0,1:07:35.20,1:07:39.41,Default,,0,0,0,,Бұл адамдар оны нақты балалар емес болғандықтан алады.
Dialogue: 0,1:07:41.66,1:07:42.70,Default,,0,0,0,,Бұл да-
Dialogue: 0,1:07:44.29,1:07:46.25,Default,,0,0,0,,Маған хабар берме
Dialogue: 0,1:07:48.83,1:07:49.75,Default,,0,0,0,,Иә
Dialogue: 0,1:07:51.83,1:07:55.41,Default,,0,0,0,,Бірақ апаң сені жақсы көреді ме, жоқ па маңызды емес.
Dialogue: 0,1:07:55.87,1:07:58.29,Default,,0,0,0,,Жоқ! Мен білмеймін?
Dialogue: 0,1:07:58.45,1:08:02.41,Default,,0,0,0,,Бір тұрғын үй кешенінің балалары алмағанымен, біз алдық.
Dialogue: 0,1:08:03.41,1:08:08.08,Default,,0,0,0,,Ол әрқашан мен білемін деп алаңдайды.
Dialogue: 0,1:08:08.50,1:08:12.12,Default,,0,0,0,,Мен де осындай нәрселерге алаңдағаным үшін өзімді жек көремін.
Dialogue: 0,1:08:13.00,1:08:16.00,Default,,0,0,0,,Менде басқа ештеңе жоқ...
Dialogue: 0,1:08:16.33,1:08:18.25,Default,,0,0,0,,Мен енді сене алмаймын
Dialogue: 0,1:08:18.33,1:08:23.54,Default,,0,0,0,,(Анна жылайды)
Dialogue: 0,1:08:28.25,1:08:31.29,Default,,0,0,0,,Иә, жылауға болмайды, Анна.
Dialogue: 0,1:08:31.37,1:08:33.33,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,1:08:35.54,1:08:39.54,Default,,0,0,0,,Мен сені кез келген басқа қыздардан артық жақсы көремін
Dialogue: 0,1:08:42.66,1:08:45.54,Default,,0,0,0,,Енді маған Марнидің құпиясын айт.
Dialogue: 0,1:08:49.08,1:08:52.79,Default,,0,0,0,,Мен кішкентай кезімде әкеммен саңырауқұлақ аулауға баратынмын.
Dialogue: 0,1:08:54.37,1:08:57.29,Default,,0,0,0,,Мен қазір анам мен әкемді мүлдем көрмеймін.
Dialogue: 0,1:08:59.16,1:09:00.87,Default,,0,0,0,,Анам көп саяхаттайды.
Dialogue: 0,1:09:06.12,1:09:09.50,Default,,0,0,0,,Әкем жұмысына байланысты жылына екі рет қана келеді.
Dialogue: 0,1:09:11.12,1:09:15.16,Default,,0,0,0,,Әдетте бұл сарайдағы адамдар әже мен егіздер.
Dialogue: 0,1:09:15.79,1:09:17.75,Default,,0,0,0,,Бұл мен ғана
Dialogue: 0,1:09:19.16,1:09:21.91,Default,,0,0,0,,Кемпірлер сөйлесіп жатқанда, сырғып кетіңіз.
Dialogue: 0,1:09:22.50,1:09:24.54,Default,,0,0,0,,Сол кезде қараңыз
Dialogue: 0,1:09:25.04,1:09:26.25,Default,,0,0,0,,Сонша еркіндік
Dialogue: 0,1:09:29.79,1:09:32.87,Default,,0,0,0,,Әкелер үйге келгенде жақсы болады
Dialogue: 0,1:09:33.79,1:09:35.08,Default,,0,0,0,,Той өткізу
Dialogue: 0,1:09:36.33,1:09:38.20,Default,,0,0,0,,Өткен күндегідей ме?
Dialogue: 0,1:09:39.50,1:09:41.37,Default,,0,0,0,,Менің мақтаншақ анам мен әкем
Dialogue: 0,1:09:41.91,1:09:45.37,Default,,0,0,0,,Ал көп адам келеді, бұл өте қызық.
Dialogue: 0,1:09:46.29,1:09:49.70,Default,,0,0,0,,Мен де сен маған сатып алған жаңа көйлекті киіп билеймін.
Dialogue: 0,1:09:51.50,1:09:56.70,Default,,0,0,0,,Сондай кезде мен өзімді әлемдегі ең бақытты қыздай сезінемін.
Dialogue: 0,1:09:58.04,1:09:59.00,Default,,0,0,0,,Иә
Dialogue: 0,1:10:09.50,1:10:13.95,Default,,0,0,0,,Эй Анна, сен менің мәңгілік досым боласың ба?
Dialogue: 0,1:10:14.83,1:10:17.66,Default,,0,0,0,,Иә, біз мәңгі дос боламыз.
Dialogue: 0,1:10:17.75,1:10:18.87,Default,,0,0,0,,(Нейяның күлкісі)
Dialogue: 0,1:10:18.95,1:10:21.37,Default,,0,0,0,,Дұрыс? Эй.
Dialogue: 0,1:10:24.29,1:10:26.25,Default,,0,0,0,,Менің әжемнің көңіл-күйі үнемі нашар.
Dialogue: 0,1:10:26.62,1:10:30.95,Default,,0,0,0,,Қолымнан мықтап ұстап, шашымды қатты тарадың.
Dialogue: 0,1:10:32.16,1:10:34.12,Default,,0,0,0,,Сізді ешкім қорлап жатыр деп ойламайсыз.
Dialogue: 0,1:10:35.16,1:10:36.62,Default,,0,0,0,,Бірақ бұл қатты ауырады
Dialogue: 0,1:10:35.16,1:10:36.62,Default,,0,0,0,,~♪
Dialogue: 0,1:10:37.83,1:10:39.00,Default,,0,0,0,,Мен жылап жібердім
Dialogue: 0,1:10:41.54,1:10:44.04,Default,,0,0,0,,Олар адамдарды қорқытқанды ұнатады.
Dialogue: 0,1:10:45.33,1:10:47.54,Default,,0,0,0,,Кішкентай кезімде мені қорқытатын.
Dialogue: 0,1:10:48.87,1:10:50.91,Default,,0,0,0,,Жаман балаларды силостарда ұстаңыз
Dialogue: 0,1:10:51.33,1:10:54.29,Default,,0,0,0,,Жаныңды аруақ алып кетеді.
Dialogue: 0,1:10:55.75,1:10:58.16,Default,,0,0,0,,Сүрлем сол төбеде ме?
Dialogue: 0,1:10:58.58,1:11:01.66,Default,,0,0,0,,Мені шынымен бір рет алып кетті ме?
Dialogue: 0,1:11:01.95,1:11:03.62,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:11:03.70,1:11:06.54,Default,,0,0,0,,Мен сүрлемге жеткенше жол бойы сүйретілді.
Dialogue: 0,1:11:06.91,1:11:08.70,Default,,0,0,0,,Мен өлгенше қорықтым
Dialogue: 0,1:11:09.29,1:11:12.87,Default,,0,0,0,,Сосын, біз жеткен бойда аспан тас қараңғы болып кетті.
Dialogue: 0,1:11:12.95,1:11:14.87,Default,,0,0,0,,Үлкен найзағай басталды
Dialogue: 0,1:11:14.95,1:11:16.04,Default,,0,0,0,,(күн күркіреуі)
Dialogue: 0,1:11:16.33,1:11:17.91,Default,,0,0,0,,(Нейяның айқайы)
Dialogue: 0,1:11:18.83,1:11:21.87,Default,,0,0,0,,Мен ішке кірмедім, өйткені әпкем қатты қорқып кетті.
Dialogue: 0,1:11:23.33,1:11:26.29,Default,,0,0,0,,Қалғанның бәріне шыдай аламын.
Dialogue: 0,1:11:27.50,1:11:30.20,Default,,0,0,0,,Бірақ силостар жақсы емес.
Dialogue: 0,1:11:31.08,1:11:33.87,Default,,0,0,0,,Мен мұндай қорқынышты оқиғаны естіген емеспін!
Dialogue: 0,1:11:34.25,1:11:37.20,Default,,0,0,0,,Бәрімізді найзағай ұрса ғой!
Dialogue: 0,1:11:39.20,1:11:43.29,Default,,0,0,0,,Сіз біреуден қорқып көрдіңіз бе?
Dialogue: 0,1:11:44.04,1:11:46.70,Default,,0,0,0,,Жоқ! Әрине әдейі емес
Dialogue: 0,1:11:48.45,1:11:50.20,Default,,0,0,0,,Сіз жарылқадыңыз
Dialogue: 0,1:11:51.16,1:11:53.58,Default,,0,0,0,,Мен бұл сен болғаныңды қалаймын
Dialogue: 0,1:11:56.16,1:11:57.45,Default,,0,0,0,,Біздің сарай
Dialogue: 0,1:12:00.95,1:12:02.54,Default,,0,0,0,,Бейшара Марни
Dialogue: 0,1:12:03.20,1:12:05.79,Default,,0,0,0,,Маған Марни ең қатты ұнайды.
Dialogue: 0,1:12:06.08,1:12:08.08,Default,,0,0,0,,Мен кездестірген кез келген адамнан артық
Dialogue: 0,1:12:10.66,1:12:11.66,Default,,0,0,0,,Эмилия ханым, жоспар бойынша айдаһар арбасымен эвакуацияланыңыз.
Dialogue: 0,1:12:12.95,1:12:14.87,Default,,0,0,0,,♪~
Dialogue: 0,1:12:17.54,1:12:21.20,Default,,0,0,0,,Бізді орындар ауыстырған сияқты.
Dialogue: 0,1:12:22.08,1:12:23.50,Default,,0,0,0,,Рас!
Dialogue: 0,1:12:24.12,1:12:28.83,Default,,0,0,0,,(Аннаның күлкісі)
Dialogue: 0,1:12:30.95,1:12:32.58,Default,,0,0,0,,Толқын көтеріледі
Dialogue: 0,1:12:33.83,1:12:36.66,Default,,0,0,0,,Ей, бірге силосқа барайық.
Dialogue: 0,1:12:38.33,1:12:41.87,Default,,0,0,0,,Елестер шығады деген өтірік. Мен барып тексеремін.
Dialogue: 0,1:12:43.08,1:12:46.20,Default,,0,0,0,,Ертең... Мм, қазір барайық.
Dialogue: 0,1:12:53.45,1:12:55.79,Default,,0,0,0,,Маған Марнидің кім екені маңызды емес.
Dialogue: 0,1:12:57.25,1:13:00.25,Default,,0,0,0,,Мен Марниге көмектескім келеді.
Dialogue: 0,1:13:00.91,1:13:03.91,Default,,0,0,0,,~♪
Dialogue: 0,1:13:12.25,1:13:13.87,Default,,0,0,0,,Амансың ба? Марни
Dialogue: 0,1:13:14.79,1:13:18.41,Default,,0,0,0,,Иә, мен саған бәрі жақсы болатынына сенімдімін.
Dialogue: 0,1:13:19.12,1:13:20.79,Default,,0,0,0,,Казухико (Анна) Иә?
Dialogue: 0,1:13:29.87,1:13:31.87,Default,,0,0,0,,Анна-чан!
Dialogue: 0,1:13:32.75,1:13:35.54,Default,,0,0,0,,Дұрыс! Мен таптым!
Dialogue: 0,1:13:35.95,1:13:39.12,Default,,0,0,0,,（）
Dialogue: 0,1:13:45.70,1:13:48.58,Default,,0,0,0,,Күнделіктің жалғасы! Үйге кел!
Dialogue: 0,1:13:49.00,1:13:50.12,Default,,0,0,0,,Марни
Dialogue: 0,1:13:51.95,1:13:54.58,Default,,0,0,0,,Кешіріңіз! Келесі кездескенше
Dialogue: 0,1:13:55.20,1:13:57.58,Default,,0,0,0,,Бұл тамаша жаңалық болды.
Dialogue: 0,1:13:59.08,1:14:00.95,Default,,0,0,0,,Жаңбыр жауады
Dialogue: 0,1:14:01.70,1:14:05.12,Default,,0,0,0,,(Желдің дыбысы)
Dialogue: 0,1:14:42.29,1:14:43.66,Default,,0,0,0,,Менің ағам – ағам, ал мен – өзім; біз мүлдем әртүрліміз.
Dialogue: 0,1:14:43.75,1:14:45.20,Default,,0,0,0,,(Аннаның ентігу дыбысы)
Dialogue: 0,1:14:45.29,1:14:46.54,Default,,0,0,0,,(тышқан жылайды)
Dialogue: 0,1:14:49.87,1:14:50.83,Default,,0,0,0,,Уау! (судың шашыраған дыбысы)
Dialogue: 0,1:14:55.41,1:14:56.33,Default,,0,0,0,,Кім?
Dialogue: 0,1:14:58.95,1:15:00.20,Default,,0,0,0,,Онда біреу бар ма?
Dialogue: 0,1:15:00.62,1:15:01.75,Default,,0,0,0,,Марни!
Dialogue: 0,1:15:06.08,1:15:09.75,Default,,0,0,0,,Сен бірінші келдің, енді мені қорқытпа.
Dialogue: 0,1:15:12.79,1:15:13.66,Default,,0,0,0,,Марни
Dialogue: 0,1:15:16.45,1:15:17.50,Default,,0,0,0,,Ха!
Dialogue: 0,1:15:17.95,1:15:19.79,Default,,0,0,0,,Амансың ба? неге жалғызсың
Dialogue: 0,1:15:19.87,1:15:20.79,Default,,0,0,0,,Казухико!
Dialogue: 0,1:15:22.20,1:15:25.37,Default,,0,0,0,,Қорқынышты Мен төменнен біреуді естідім.
Dialogue: 0,1:15:26.37,1:15:29.29,Default,,0,0,0,,Қорыққаным сонша, Казухико өлемін деп ойладым
Dialogue: 0,1:15:30.37,1:15:34.62,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Мен Аннамын, мықты бол
Dialogue: 0,1:15:34.70,1:15:37.04,Default,,0,0,0,,Анна? Анна!
Dialogue: 0,1:15:37.62,1:15:40.00,Default,,0,0,0,,Мені ешкімнің мазақ еткенін қаламаймын.
Dialogue: 0,1:15:40.25,1:15:43.04,Default,,0,0,0,,Бірақ менде батылдық жоқ. Әй, Анна!
Dialogue: 0,1:15:44.41,1:15:47.04,Default,,0,0,0,,Батылсың, дұрыс келдің.
Dialogue: 0,1:15:49.54,1:15:51.91,Default,,0,0,0,,Үйге қайтайық (Марни) Иә.
Dialogue: 0,1:15:52.00,1:15:54.79,Default,,0,0,0,,Кя!
Dialogue: 0,1:16:04.62,1:16:05.62,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,1:16:09.79,1:16:12.20,Default,,0,0,0,,Бұл жел ғана, кеттік.
Dialogue: 0,1:16:13.08,1:16:14.83,Default,,0,0,0,,Үйге бірге барайық
Dialogue: 0,1:16:19.95,1:16:20.79,Default,,0,0,0,,Иә...
Dialogue: 0,1:16:25.33,1:16:28.70,Default,,0,0,0,,(Қурылдаған желдің дыбысы)
Dialogue: 0,1:16:29.12,1:16:30.95,Default,,0,0,0,,А... жоқ
Dialogue: 0,1:16:31.29,1:16:34.20,Default,,0,0,0,,(Найзағайдың дыбысы)
Dialogue: 0,1:16:34.29,1:16:36.29,Default,,0,0,0,,Анна, қайтып кел
Dialogue: 0,1:16:36.70,1:16:37.87,Default,,0,0,0,,Анна!
Dialogue: 0,1:16:38.66,1:16:41.91,Default,,0,0,0,,Жоғарыға келсең, түсуге болады.
Dialogue: 0,1:16:42.75,1:16:45.20,Default,,0,0,0,,Мен бірінші барамын, сондықтан менің артымнан жүріңіз.
Dialogue: 0,1:16:47.04,1:16:49.79,Default,,0,0,0,,Жоқ! мені тастама
Dialogue: 0,1:16:49.91,1:16:51.91,Default,,0,0,0,,Кя!
Dialogue: 0,1:16:58.95,1:16:59.87,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:17:03.33,1:17:04.33,Default,,0,0,0,,Марни!
Dialogue: 0,1:17:06.41,1:17:08.16,Default,,0,0,0,,Басқа бұрышқа барайық
Dialogue: 0,1:17:21.87,1:17:24.37,Default,,0,0,0,,Суық Бұл өте суық
Dialogue: 0,1:17:28.04,1:17:32.25,Default,,0,0,0,,Анна Мен қорқамын. Мен қорқып тұрмын.
Dialogue: 0,1:17:32.62,1:17:33.87,Default,,0,0,0,,Жарайды
Dialogue: 0,1:17:34.20,1:17:36.12,Default,,0,0,0,,Екеуміз бірге болсақ жарайды
Dialogue: 0,1:17:36.20,1:17:39.33,Default,,0,0,0,,Жақсы жұмыс Марни
Dialogue: 0,1:17:54.70,1:17:58.16,Default,,0,0,0,,♪~
Dialogue: 0,1:18:12.54,1:18:16.45,Default,,0,0,0,,(Марни жылайды)
Dialogue: 0,1:18:20.91,1:18:22.12,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,1:18:23.41,1:18:24.58,Default,,0,0,0,,Казухико!
Dialogue: 0,1:18:25.87,1:18:27.75,Default,,0,0,0,,Мен сені келмейді деп ойладым.
Dialogue: 0,1:18:28.75,1:18:30.79,Default,,0,0,0,,Мен… Мен…
Dialogue: 0,1:18:31.79,1:18:33.37,Default,,0,0,0,,(Марни жылайды)
Dialogue: 0,1:18:39.12,1:18:40.62,Default,,0,0,0,,Жүр, үйге қайтайық.
Dialogue: 0,1:18:51.29,1:18:53.29,Default,,0,0,0,,~♪
Dialogue: 0,1:18:54.50,1:18:58.12,Default,,0,0,0,,(Судың құлаған дыбысы)
Dialogue: 0,1:19:05.25,1:19:06.62,Default,,0,0,0,,Марни?
Dialogue: 0,1:19:09.41,1:19:10.83,Default,,0,0,0,,Марни!
Dialogue: 0,1:19:13.41,1:19:16.33,Default,,0,0,0,,（）
Dialogue: 0,1:19:17.87,1:19:20.54,Default,,0,0,0,,Марни!
Dialogue: 0,1:19:20.91,1:19:23.54,Default,,0,0,0,,(Найзағайдың дыбысы)
Dialogue: 0,1:19:20.91,1:19:23.54,Default,,0,0,0,,♪~
Dialogue: 0,1:19:27.62,1:19:30.95,Default,,0,0,0,,Марни, сен мені артта қалдырдың.
Dialogue: 0,1:19:37.91,1:19:39.66,Default,,0,0,0,,Мен саған
Dialogue: 0,1:19:52.12,1:19:53.45,Default,,0,0,0,,(Аннаның сүрінген дыбысы)
Dialogue: 0,1:19:57.70,1:20:00.66,Default,,0,0,0,,~♪
Dialogue: 0,1:20:06.25,1:20:08.66,Default,,0,0,0,,«Казухико» «Казухико»
Dialogue: 0,1:20:09.37,1:20:11.83,Default,,0,0,0,,Бұл күнделік Казухикоға толы.
Dialogue: 0,1:20:13.75,1:20:18.00,Default,,0,0,0,,«Казухико мені силосқа апармақшы.»
Dialogue: 0,1:20:18.79,1:20:19.83,Default,,0,0,0,,Силос?
Dialogue: 0,1:20:20.41,1:20:21.70,Default,,0,0,0,,(есік қағылған дыбыс)
Dialogue: 0,1:20:22.62,1:20:23.58,Default,,0,0,0,,Иә!
Dialogue: 0,1:20:25.04,1:20:26.83,Default,,0,0,0,,Анам жүгеріні қайнатып берді.
Dialogue: 0,1:20:27.70,1:20:29.95,Default,,0,0,0,,Тез келмесең, мен сені жеймін (Аяка) Үлкен аға!
Dialogue: 0,1:20:32.16,1:20:34.50,Default,,0,0,0,,Мен мұндай түнде ешқашан шыққан емеспін.
Dialogue: 0,1:20:35.54,1:20:36.41,Default,,0,0,0,,Қауіпті болар еді
Dialogue: 0,1:20:36.50,1:20:39.25,Default,,0,0,0,,Менің досым жаңбырда суланып қалуы мүмкін.
Dialogue: 0,1:20:39.33,1:20:41.37,Default,,0,0,0,,Егер сіз пневмониямен ауырсаңыз
Dialogue: 0,1:20:42.04,1:20:43.16,Default,,0,0,0,,Хмм...
Dialogue: 0,1:20:45.75,1:20:46.70,Default,,0,0,0,,Қандай әйелдер ұнайды саған?
Dialogue: 0,1:20:47.87,1:20:48.95,Default,,0,0,0,,Анна-чан!
Dialogue: 0,1:20:49.58,1:20:50.45,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,1:20:53.16,1:20:54.12,Default,,0,0,0,,Ой...
Dialogue: 0,1:20:55.70,1:20:56.91,Default,,0,0,0,,Анна-чан?
Dialogue: 0,1:20:57.33,1:20:58.54,Default,,0,0,0,,(Аннаның құлаған дыбысы)
Dialogue: 0,1:20:58.91,1:20:59.91,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,1:21:00.00,1:21:00.95,Default,,0,0,0,,…
Dialogue: 0,1:21:01.58,1:21:02.70,Default,,0,0,0,,Үлкен қызба
Dialogue: 0,1:21:03.25,1:21:04.50,Default,,0,0,0,,Көмек шақыру
Dialogue: 0,1:21:05.75,1:21:07.00,Default,,0,0,0,,Анна-чан
Dialogue: 0,1:21:10.20,1:21:11.37,Default,,0,0,0,,Анна-чан?
Dialogue: 0,1:21:13.33,1:21:14.45,Default,,0,0,0,,Анна-чан
Dialogue: 0,1:21:15.87,1:21:19.79,Default,,0,0,0,,♪~
Dialogue: 0,1:21:21.04,1:21:22.45,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,1:21:22.83,1:21:26.37,Default,,0,0,0,,Хмм, қызуым әлі түскен жоқ.
Dialogue: 0,1:21:28.20,1:21:30.29,Default,,0,0,0,,Мен укол алдым.
Dialogue: 0,1:21:30.79,1:21:32.00,Default,,0,0,0,,Солай ма?
Dialogue: 0,1:21:43.62,1:21:44.62,Default,,0,0,0,,Ой...
Dialogue: 0,1:21:48.08,1:21:50.50,Default,,0,0,0,,Марни, бұл қорқынышты.
Dialogue: 0,1:21:55.29,1:21:56.83,Default,,0,0,0,,Мүлдем қабылданбайды
Dialogue: 0,1:21:58.20,1:22:00.25,Default,,0,0,0,,Мені жалғыз қалдырып, үйге үнсіз қайтуға қалай дәтің бар?
Dialogue: 0,1:22:25.62,1:22:28.37,Default,,0,0,0,,Анна! Менің сүйікті Анна!
Dialogue: 0,1:22:30.41,1:22:34.87,Default,,0,0,0,,Марни! Неге мені тастап кеттің?
Dialogue: 0,1:22:34.95,1:22:36.75,Default,,0,0,0,,Маған неге опасыздық жасадың?
Dialogue: 0,1:22:37.70,1:22:40.75,Default,,0,0,0,,Кешіріңіз, мен мұны істегім келмеді!
Dialogue: 0,1:22:41.91,1:22:42.87,Default,,0,0,0,,Өйткені
Dialogue: 0,1:22:45.20,1:22:48.37,Default,,0,0,0,,Өйткені сіз ол кезде болмағансыз.
Dialogue: 0,1:22:50.12,1:22:51.00,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,1:22:52.54,1:22:54.25,Default,,0,0,0,,Анна I...
Dialogue: 0,1:22:55.16,1:22:57.50,Default,,0,0,0,,Мен қазір бұл жерден кетуім керек.
Dialogue: 0,1:22:58.20,1:23:01.45,Default,,0,0,0,,Мен сенімен қоштасуым керек.
Dialogue: 0,1:23:02.04,1:23:06.20,Default,,0,0,0,,Сондықтан, Анна, мені кешіретініңді айтшы.
Dialogue: 0,1:23:10.83,1:23:11.79,Default,,0,0,0,,Анна
Dialogue: 0,1:23:15.08,1:23:17.50,Default,,0,0,0,,Әрине! Мен сені кешіремін!
Dialogue: 0,1:23:17.91,1:23:20.37,Default,,0,0,0,,Мен сені жақсы көремін! Марни
Dialogue: 0,1:23:20.75,1:23:23.00,Default,,0,0,0,,Мен сені ешқашан ұмытпаймын
Dialogue: 0,1:23:23.41,1:23:26.08,Default,,0,0,0,,Мен сені ешқашан ұмытпаймын, мәңгілік!
Dialogue: 0,1:23:26.20,1:23:29.66,Default,,0,0,0,,（）
Dialogue: 0,1:23:30.20,1:23:33.20,Default,,0,0,0,,(Аннаның таңданған дауысы)
Dialogue: 0,1:23:57.70,1:24:00.70,Default,,0,0,0,,~♪
Dialogue: 0,1:24:04.33,1:24:05.79,Default,,0,0,0,,(есік қағылған дыбыс)
Dialogue: 0,1:24:08.12,1:24:09.20,Default,,0,0,0,,Анна-чан
Dialogue: 0,1:24:16.33,1:24:17.79,Default,,0,0,0,,Аяка-чан келе жатыр
Dialogue: 0,1:24:21.37,1:24:22.29,Default,,0,0,0,,Иә
Dialogue: 0,1:24:25.58,1:24:27.62,Default,,0,0,0,,О, сен өз бөлмеңде болмайсың ба?
Dialogue: 0,1:24:27.87,1:24:31.20,Default,,0,0,0,,Иә, сыртта өзін жақсы сезінеді.
Dialogue: 0,1:24:34.12,1:24:35.08,Default,,0,0,0,,Аяка-чан
Dialogue: 0,1:24:36.37,1:24:37.83,Default,,0,0,0,,Иә, жанашырлық
Dialogue: 0,1:24:38.20,1:24:39.54,Default,,0,0,0,,Рахмет
Dialogue: 0,1:24:39.62,1:24:40.54,Default,,0,0,0,,Және…
Dialogue: 0,1:24:43.50,1:24:47.45,Default,,0,0,0,,Мен мұны оқығанда, Анна силоста болуы мүмкін деп ойладым.
Dialogue: 0,1:24:47.87,1:24:48.95,Default,,0,0,0,,Не?
Dialogue: 0,1:24:49.04,1:24:52.16,Default,,0,0,0,,Күнделікті жалғастыру. Сіз келесі жолы қараймын дедіңіз.
Dialogue: 0,1:24:53.00,1:24:56.25,Default,,0,0,0,,Мен жақсы есімде жоқ.
Dialogue: 0,1:24:56.33,1:24:57.91,Default,,0,0,0,,Бірақ мен кереметпін.
Dialogue: 0,1:24:58.50,1:25:02.12,Default,,0,0,0,,Мен бұл суретті шкафтың артында кездейсоқ тауып алдым.
Dialogue: 0,1:25:03.62,1:25:05.91,Default,,0,0,0,,Мен эспер болуым мүмкін.
Dialogue: 0,1:25:06.70,1:25:07.83,Default,,0,0,0,,Артыңызға қараңыз
Dialogue: 0,1:25:10.04,1:25:13.00,Default,,0,0,0,,«Марниге, Хисакодан»
Dialogue: 0,1:25:13.33,1:25:15.16,Default,,0,0,0,,Ах Хисако-сан
Dialogue: 0,1:25:18.79,1:25:20.33,Default,,0,0,0,,Хисако-сан!
Dialogue: 0,1:25:35.54,1:25:38.70,Default,,0,0,0,,Айтыңызшы, мен Марни туралы білгім келеді.
Dialogue: 0,1:25:38.79,1:25:39.87,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,1:25:39.95,1:25:41.20,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:25:41.62,1:25:43.25,Default,,0,0,0,,Бұл азапты оқиға болады.
Dialogue: 0,1:25:43.33,1:25:44.16,Default,,0,0,0,,А...
Dialogue: 0,1:25:44.45,1:25:45.75,Default,,0,0,0,,Өтінемін
Dialogue: 0,1:25:50.41,1:25:53.16,Default,,0,0,0,,Бұл көп уақыт бұрын болды
Dialogue: 0,1:25:55.08,1:25:58.66,Default,,0,0,0,,Мен сол дымқыл сарайға баратынмын.
Dialogue: 0,1:26:00.70,1:26:03.29,Default,,0,0,0,,Марни екеуміз әлі кішкентай кезімізде.
Dialogue: 0,1:26:03.37,1:26:05.91,Default,,0,0,0,,Бұл аю! (Бала Хисако) Көрсет, көрсет
Dialogue: 0,1:26:06.33,1:26:09.25,Default,,0,0,0,,Бұл әке, солай ма? Керемет емес пе?
Dialogue: 0,1:26:10.04,1:26:12.16,Default,,0,0,0,,Марнидің әдемі ата-анасы бар...
Dialogue: 0,1:26:12.25,1:26:15.91,Default,,0,0,0,,Ол өзінің шамадан тыс кештері туралы үнемі қуана әңгімелейтін.
Dialogue: 0,1:26:19.33,1:26:22.37,Default,,0,0,0,,Бірақ шын мәнінде ол назардан тыс қалды.
Dialogue: 0,1:26:26.37,1:26:28.12,Default,,0,0,0,,Марни кездескенше
Dialogue: 0,1:26:28.50,1:26:29.95,Default,,0,0,0,,Ол кедей бала еді.
Dialogue: 0,1:26:30.04,1:26:33.70,Default,,0,0,0,,Жоқ, жоқ! Мені сонда қалдырмаңыз, анашым! Барма!
Dialogue: 0,1:26:34.20,1:26:35.16,Default,,0,0,0,,Анашым!
Dialogue: 0,1:26:35.25,1:26:38.20,Default,,0,0,0,,Оны қызметшілер де қорқытқан сияқты.
Dialogue: 0,1:26:39.00,1:26:40.08,Default,,0,0,0,,Бұл қорқынышты!
Dialogue: 0,1:26:41.62,1:26:44.37,Default,,0,0,0,,Осыдан кейін Марни Саппороға көшті.
Dialogue: 0,1:26:44.45,1:26:47.16,Default,,0,0,0,,Мен бала күнгі досым Казухикоға үйлендім.
Dialogue: 0,1:26:50.70,1:26:54.20,Default,,0,0,0,,Марни, оның отбасы бұзылғаннан кейін күйзеліске ұшырады.
Dialogue: 0,1:26:54.29,1:26:56.79,Default,,0,0,0,,Үнемі қолдап жүретін сияқты.
Dialogue: 0,1:26:58.41,1:27:02.54,Default,,0,0,0,,Жақсы (Аяка) Казухико жақсы адам еді.
Dialogue: 0,1:27:04.41,1:27:07.54,Default,,0,0,0,,Екі жылдан кейін Эмири дүниеге келді.
Dialogue: 0,1:27:08.16,1:27:11.50,Default,,0,0,0,,Ақыры жылы үйде таптым
Dialogue: 0,1:27:11.58,1:27:13.50,Default,,0,0,0,,Ол қатты қуанды
Dialogue: 0,1:27:16.16,1:27:19.37,Default,,0,0,0,,Осыдан кейін мен Марниді біраз уақыт көрмедім.
Dialogue: 0,1:27:21.16,1:27:22.45,Default,,0,0,0,,Мен кездестім...
Dialogue: 0,1:27:22.91,1:27:27.00,Default,,0,0,0,,Казухико аурудан қайтыс болғаннан кейін бірнеше жыл өткен соң.
Dialogue: 0,1:27:29.87,1:27:31.00,Default,,0,0,0,,Марни
Dialogue: 0,1:27:31.87,1:27:34.16,Default,,0,0,0,,Казухико өлімінің күйзелісінен -
Dialogue: 0,1:27:34.25,1:27:36.95,Default,,0,0,0,,Мен бұзылып, санаторияға бардым.
Dialogue: 0,1:27:37.62,1:27:38.95,Default,,0,0,0,,Санаторий?
Dialogue: 0,1:27:39.62,1:27:42.00,Default,,0,0,0,,Ауруларды емдеуге арналған санаторий.
Dialogue: 0,1:27:43.41,1:27:45.70,Default,,0,0,0,,Эмири-чан ше? Не болды?
Dialogue: 0,1:27:46.29,1:27:51.12,Default,,0,0,0,,Марнидің ата-анасы да қайтыс болды, сондықтан оған қарайтын ешкім болмады.
Dialogue: 0,1:27:54.25,1:27:58.70,Default,,0,0,0,,Бастауыш сыныпқа барғанда мені интернатқа берді.
Dialogue: 0,1:28:07.37,1:28:12.25,Default,,0,0,0,,13 жасында қайтып келгенде, ол басқа бала еді.
Dialogue: 0,1:28:12.75,1:28:13.83,Default,,0,0,0,,Эмири
Dialogue: 0,1:28:14.16,1:28:16.62,Default,,0,0,0,,Өзімшіл және тәуелсіз
Dialogue: 0,1:28:17.75,1:28:19.33,Default,,0,0,0,,Мен ауырсам да...
Dialogue: 0,1:28:19.41,1:28:23.62,Default,,0,0,0,,Мен анамды балалық шағымнан итеріп жібергені үшін жек көрдім.
Dialogue: 0,1:28:24.87,1:28:27.75,Default,,0,0,0,,Осындай сөздерді айту анаға тән нәрсе деп ойлайсың ба?
Dialogue: 0,1:28:28.12,1:28:31.50,Default,,0,0,0,,Мен сенің өзің қалағандай өмір сүргеніңді қалаймын, бірақ...
Dialogue: 0,1:28:32.08,1:28:33.37,Default,,0,0,0,,Мен сенің өзіңе қамқор болғаныңды қалаймын.
Dialogue: 0,1:28:33.45,1:28:36.50,Default,,0,0,0,,Содан кейін де екеуі бір-бірін білмеді.
Dialogue: 0,1:28:36.58,1:28:37.50,Default,,0,0,0,,Менің анам
Dialogue: 0,1:28:37.58,1:28:40.16,Default,,0,0,0,,Жетер, мен өзімді ешқашан анамын деп ойлаған емеспін.
Dialogue: 0,1:28:42.20,1:28:45.83,Default,,0,0,0,,Эмири үйден қашып, көп ұзамай үйленді.
Dialogue: 0,1:28:47.25,1:28:49.16,Default,,0,0,0,,Сіздің ішіңізде нәресте болды, солай ма?
Dialogue: 0,1:28:56.37,1:28:58.08,Default,,0,0,0,,(телефон шырылдаған дыбыс)
Dialogue: 0,1:29:09.83,1:29:10.79,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:29:13.20,1:29:18.45,Default,,0,0,0,,Бір күні күйеуі мен әйелі жол апатынан қайтыс болды.
Dialogue: 0,1:29:22.33,1:29:24.62,Default,,0,0,0,,Мен Марнидің баланы қамқорлыққа алғанын естідім.
Dialogue: 0,1:29:26.95,1:29:31.83,Default,,0,0,0,,Бұл баланы жалғыз сезінбеуге бел байлаған сияқты.
Dialogue: 0,1:29:33.75,1:29:34.75,Default,,0,0,0,,Бірақ
Dialogue: 0,1:29:35.12,1:29:38.62,Default,,0,0,0,,Эмиридің өлімінің күйзелісінен айыға алмадың.
Dialogue: 0,1:29:40.20,1:29:44.33,Default,,0,0,0,,Ол ауыр науқасқа шалдығып, келесі жылы қайтыс болды.
Dialogue: 0,1:29:46.91,1:29:50.08,Default,,0,0,0,,Бұл шамамен 10 жыл бұрын болды.
Dialogue: 0,1:29:55.41,1:29:57.83,Default,,0,0,0,,Кешіріңіз, бұл қайғылы оқиға.
Dialogue: 0,1:29:58.25,1:30:00.70,Default,,0,0,0,,Жоқ Рахмет
Dialogue: 0,1:30:02.37,1:30:05.37,Default,,0,0,0,,Марни бұл үйді жақсы көретін.
Dialogue: 0,1:30:08.08,1:30:11.37,Default,,0,0,0,,Маған тереземнен сулы-батпақты жердің көрінісі ұнады.
Dialogue: 0,1:30:13.16,1:30:16.87,Default,,0,0,0,,Құстар менімен сөйлесіп тұрған сияқты
Dialogue: 0,1:30:18.95,1:30:21.50,Default,,0,0,0,,Ол жалғыз адам еді, бірақ
Dialogue: 0,1:30:21.87,1:30:24.00,Default,,0,0,0,,Мен әрқашан өз өмірімді толыққанды өткіздім.
Dialogue: 0,1:30:24.87,1:30:28.33,Default,,0,0,0,,Қуануға тырысып, күлімсіреп алға қарадым.
Dialogue: 0,1:30:31.08,1:30:33.33,Default,,0,0,0,,Сіз Марниді де кездестірдіңіз.
Dialogue: 0,1:30:53.70,1:30:56.70,Default,,0,0,0,,Мен Аннамен көбірек ойнағым келді.
Dialogue: 0,1:30:57.20,1:31:00.33,Default,,0,0,0,,Бастапқыда бұл тек жазғы демалыста ғана жоспарланған болатын.
Dialogue: 0,1:31:01.04,1:31:02.95,Default,,0,0,0,,Келесі жазда тағы келесің бе?
Dialogue: 0,1:31:03.50,1:31:05.87,Default,,0,0,0,,Келетініңізге сенімдімін. Мен саған хат жазамын.
Dialogue: 0,1:31:06.33,1:31:08.95,Default,,0,0,0,,Мен де саған хат жазамын.
Dialogue: 0,1:31:13.16,1:31:16.41,Default,,0,0,0,,Мен күнделік пен Хисаконың суреттерін сол жерде сақтадым.
Dialogue: 0,1:31:16.79,1:31:18.79,Default,,0,0,0,,Иә, бұл жақсы.
Dialogue: 0,1:31:19.54,1:31:21.41,Default,,0,0,0,,Үйдегі адамдардан құпия ұстаймын.
Dialogue: 0,1:31:22.12,1:31:24.04,Default,,0,0,0,,Оны біз үшін ғана құпия сақтаңыз
Dialogue: 0,1:31:24.50,1:31:25.58,Default,,0,0,0,,Иә
Dialogue: 0,1:31:27.04,1:31:29.08,Default,,0,0,0,,Бұл біртүрлі (Анна) Иә?
Dialogue: 0,1:31:30.20,1:31:32.91,Default,,0,0,0,,Марни кездесуге рұқсат етіңіз.
Dialogue: 0,1:31:33.87,1:31:34.83,Default,,0,0,0,,Алдымен саусақтарыңды найза пішініне келтір.
Dialogue: 0,1:31:34.91,1:31:36.70,Default,,0,0,0,,(Аннаның күлкісі)
Dialogue: 0,1:31:36.79,1:31:37.79,Default,,0,0,0,,Марни
Dialogue: 0,1:31:41.50,1:31:45.62,Default,,0,0,0,,Көк терезеде қамалған қыз
Dialogue: 0,1:31:47.20,1:31:48.91,Default,,0,0,0,,Баяғыда.
Dialogue: 0,1:31:53.70,1:31:57.70,Default,,0,0,0,,Дұрыс, сіз өзіңіздің сүйіктіңіздің өмірін қорғауды шешесіз.
Dialogue: 0,1:31:57.79,1:31:59.16,Default,,0,0,0,,Маған бұл көрініс ұнайды
Dialogue: 0,1:31:59.25,1:32:02.25,Default,,0,0,0,,Аа, енді қайта оқығым келіп тұр.
Dialogue: 0,1:32:02.95,1:32:04.70,Default,,0,0,0,,Келесі жолы мен сізге жалғасын беремін.
Dialogue: 0,1:32:04.79,1:32:06.00,Default,,0,0,0,,Анна
Dialogue: 0,1:32:09.50,1:32:11.29,Default,,0,0,0,,Әй, апа!
Dialogue: 0,1:32:14.20,1:32:15.45,Default,,0,0,0,,Анна-чан?
Dialogue: 0,1:32:17.70,1:32:19.95,Default,,0,0,0,,Тым кенет тұрып қалмаңыз.
Dialogue: 0,1:32:20.04,1:32:21.00,Default,,0,0,0,,(Иура) Жарайды, жарайды. (Мотоко) Оны қолыңмен тиме.
Dialogue: 0,1:32:21.08,1:32:24.79,Default,,0,0,0,,Му (Аннаның күлкісі)
Dialogue: 0,1:32:28.33,1:32:29.91,Default,,0,0,0,,Апай келді
Dialogue: 0,1:32:30.87,1:32:33.58,Default,,0,0,0,,Ал, Йорико! Қош келдіңіз
Dialogue: 0,1:32:36.37,1:32:38.20,Default,,0,0,0,,Рахмет Анна
Dialogue: 0,1:32:38.29,1:32:41.58,Default,,0,0,0,,Мен сонша жігерлі болып, жаңа достар тапқаныма сене алар емеспін.
Dialogue: 0,1:32:42.37,1:32:44.00,Default,,0,0,0,,Алғысымды қалай айта аламын?
Dialogue: 0,1:32:44.08,1:32:48.04,Default,,0,0,0,,Жоқ, біз ештеңе істеген жоқпыз.
Dialogue: 0,1:32:48.45,1:32:50.16,Default,,0,0,0,,Өйткені Анна-чан жақсы қыз
Dialogue: 0,1:32:50.25,1:32:53.33,Default,,0,0,0,,Қызым үйге келгендей қызық болды.
Dialogue: 0,1:32:54.25,1:32:55.45,Default,,0,0,0,,Сіз тағы да келесіз деп үміттенемін
Dialogue: 0,1:32:56.20,1:32:57.08,Default,,0,0,0,,Иә
Dialogue: 0,1:32:57.54,1:32:58.79,Default,,0,0,0,,Ішінде әңгімелесу
Dialogue: 0,1:33:01.70,1:33:05.20,Default,,0,0,0,,Сен де кереметсің. Сіз бұл жолы маған қоңырау шалмадыңыз.
Dialogue: 0,1:33:06.04,1:33:08.25,Default,,0,0,0,,(Сецу мен Киёмасаның күлкісі)
Dialogue: 0,1:33:18.66,1:33:20.45,Default,,0,0,0,,Менің жүгім толтырылған.
Dialogue: 0,1:33:21.33,1:33:22.25,Default,,0,0,0,,Анна
Dialogue: 0,1:33:23.75,1:33:24.79,Default,,0,0,0,,Не?
Dialogue: 0,1:33:26.04,1:33:29.37,Default,,0,0,0,,Менің саған айтар сөзім бар.
Dialogue: 0,1:33:31.50,1:33:35.95,Default,,0,0,0,,Ай сайын жергілікті үкімет сізді өсіру құнына субсидия береді.
Dialogue: 0,1:33:36.54,1:33:37.87,Default,,0,0,0,,Сіз жалақы аласыз ба?
Dialogue: 0,1:33:38.54,1:33:41.70,Default,,0,0,0,,Мен сізге айтайын ба деп ойлап едім, бірақ...
Dialogue: 0,1:33:41.79,1:33:44.00,Default,,0,0,0,,Жетеді (Йорико) Бұл рас
Dialogue: 0,1:33:44.37,1:33:46.95,Default,,0,0,0,,Сіз ақша аласыз ба, жоқ па
Dialogue: 0,1:33:47.25,1:33:49.12,Default,,0,0,0,,Менің Аннаға деген сезімім өзгерген жоқ.
Dialogue: 0,1:33:50.70,1:33:51.79,Default,,0,0,0,,Мен білгенмін
Dialogue: 0,1:33:52.54,1:33:55.00,Default,,0,0,0,,Апайдың менімен сөйлескеніне қуаныштымын.
Dialogue: 0,1:33:55.08,1:33:56.08,Default,,0,0,0,,Анна!
Dialogue: 0,1:34:01.20,1:34:04.37,Default,,0,0,0,,Тәтем жіберген суретке үнемі қарайтынмын.
Dialogue: 0,1:34:05.70,1:34:06.58,Default,,0,0,0,,Фото?
Dialogue: 0,1:34:07.04,1:34:11.91,Default,,0,0,0,,Дұрыс, сен жоқта ескі альбомдарыңды қарап отырдым.
Dialogue: 0,1:34:12.00,1:34:13.37,Default,,0,0,0,,Бұл фотосурет пайда болды
Dialogue: 0,1:34:13.87,1:34:14.95,Default,,0,0,0,,Есіңізде ме?
Dialogue: 0,1:34:18.04,1:34:19.50,Default,,0,0,0,,Сол сарай!
Dialogue: 0,1:34:19.58,1:34:23.00,Default,,0,0,0,,Анна үйге келгенде, мен оны үнемі ұстадым.
Dialogue: 0,1:34:25.70,1:34:27.50,Default,,0,0,0,,Нысандағы адам осылай деді.
Dialogue: 0,1:34:28.45,1:34:30.62,Default,,0,0,0,,Бұл сенің әжеңдікі.
Dialogue: 0,1:34:39.33,1:34:40.29,Default,,0,0,0,,Марни!
Dialogue: 0,1:34:42.75,1:34:46.16,Default,,0,0,0,,♪~
Dialogue: 0,1:34:58.41,1:35:03.12,Default,,0,0,0,,(Анна сәби жылайды)
Dialogue: 0,1:35:19.37,1:35:21.16,Default,,0,0,0,,Олай ма еді?
Dialogue: 0,1:35:24.00,1:35:24.91,Default,,0,0,0,,Анна?
Dialogue: 0,1:35:28.58,1:35:32.75,Default,,0,0,0,,Осылайша түні бойы силоста болдым.
Dialogue: 0,1:35:33.33,1:35:35.62,Default,,0,0,0,,Мен қатты қорықтым!
Dialogue: 0,1:35:36.41,1:35:38.87,Default,,0,0,0,,Сол кезде қария келді.
Dialogue: 0,1:35:39.70,1:35:42.87,Default,,0,0,0,,Ол мені жігерлендіріп, жақсы жұмыс істегенімді айтты.
Dialogue: 0,1:35:43.66,1:35:47.16,Default,,0,0,0,,Мен көптеген қорқынышты нәрселерді жеңдім.
Dialogue: 0,1:35:47.25,1:35:48.87,Default,,0,0,0,,Анна да жақсы.
Dialogue: 0,1:35:50.37,1:35:55.79,Default,,0,0,0,,Өйткені Анна менің жалғыз немерем.
Dialogue: 0,1:35:59.00,1:36:00.08,Default,,0,0,0,,Әже
Dialogue: 0,1:36:29.87,1:36:34.12,Default,,0,0,0,,~♪
Dialogue: 0,1:36:44.12,1:36:44.95,Default,,0,0,0,,(Нобуконың күлкісі)
Dialogue: 0,1:36:44.12,1:36:44.95,Default,,0,0,0,,♪~
Dialogue: 0,1:36:45.04,1:36:45.95,Default,,0,0,0,,Бұл
Dialogue: 0,1:36:48.20,1:36:49.25,Default,,0,0,0,,Анна-чан
Dialogue: 0,1:36:50.70,1:36:52.58,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,1:36:55.12,1:36:57.29,Default,,0,0,0,,Келесі жылы мен қоқыс жинаймын.
Dialogue: 0,1:37:05.04,1:37:06.20,Default,,0,0,0,,Достар?
Dialogue: 0,1:37:06.29,1:37:07.50,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,1:37:14.04,1:37:15.45,Default,,0,0,0,,Хисако-сан!
Dialogue: 0,1:37:19.16,1:37:20.25,Default,,0,0,0,,Анна-чан
Dialogue: 0,1:37:20.83,1:37:23.25,Default,,0,0,0,,Мен қазір Саппороға қайтамын.
Dialogue: 0,1:37:23.50,1:37:24.87,Default,,0,0,0,,Дұрыс.
Dialogue: 0,1:37:25.58,1:37:29.12,Default,,0,0,0,,Бірақ сіз шынымен жақсы нәрсе болған сияқтысыз.
Dialogue: 0,1:37:29.70,1:37:32.45,Default,,0,0,0,,Иә! мен өте қуаныштымын
Dialogue: 0,1:37:32.79,1:37:33.75,Default,,0,0,0,,Иә
Dialogue: 0,1:37:34.83,1:37:37.08,Default,,0,0,0,,Бұл менің анам.
Dialogue: 0,1:37:38.41,1:37:41.62,Default,,0,0,0,,Аннаға қамқорлық көрсеткеніңіз үшін рахмет.
Dialogue: 0,1:37:42.25,1:37:44.45,Default,,0,0,0,,Жоқ, бұл менмін.
Dialogue: 0,1:37:44.83,1:37:47.08,Default,,0,0,0,,Қайтадан бірге сурет салайық.
Dialogue: 0,1:37:47.16,1:37:51.50,Default,,0,0,0,,Иә, мен саған хат жазамын. Сіздерге айтар тамаша жаңалығым бар.
Dialogue: 0,1:37:51.58,1:37:52.50,Default,,0,0,0,,Сонымен
Dialogue: 0,1:37:54.70,1:37:56.62,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,1:38:02.25,1:38:03.58,Default,,0,0,0,,Жақсы жаңалық?
Dialogue: 0,1:38:03.87,1:38:06.00,Default,,0,0,0,,Иә, мен сенімен кейінірек сөйлесемін.
Dialogue: 0,1:38:06.50,1:38:07.91,Default,,0,0,0,,Не, енді жақсы емес пе?
Dialogue: 0,1:38:08.00,1:38:10.62,Default,,0,0,0,,Мен саған кейін айтамын (Аннаның күлкісі)
Dialogue: 0,1:38:21.04,1:38:25.08,Default,,0,0,0,,Ағай! Аяка! Қош бол
Dialogue: 0,1:38:31.54,1:38:35.54,Default,,0,0,0,,♪ «Сырттағы жақсы»
Dialogue: 0,1:38:55.91,1:38:58.50,Default,,0,0,0,,«Сызба дәптері»
Dialogue: 0,1:42:06.83,1:42:13.79,Default,,0,0,0,,~♪
Dialogue: 0,1:42:15.29,1:42:21.29,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
