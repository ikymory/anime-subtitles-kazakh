Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.67,0:00:14.68,Default,,0,0,0,,♪～
Dialogue: 0,0:01:39.93,0:01:41.93,Default,,0,0,0,,～♪
Dialogue: 0,0:01:42.56,0:01:45.81,Default,,0,0,0,,(Харудың қорқып тыныс алуы)
Dialogue: 0,0:01:45.89,0:01:46.56,Default,,0,0,0,,Уф
Dialogue: 0,0:01:48.23,0:01:49.44,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:50.31,0:01:51.23,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:01:51.31,0:01:54.86,Default,,0,0,0,,Ол мен күткеннен де мықты.
Dialogue: 0,0:01:54.94,0:01:55.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:55.69,0:01:58.07,Default,,0,0,0,,Легоси саған ғашық болады.
Dialogue: 0,0:01:58.15,0:01:59.74,Default,,0,0,0,,Иә, Легоши?
Dialogue: 0,0:02:00.57,0:02:01.37,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:02:01.45,0:02:03.99,Default,,0,0,0,,Сенің көздерің менікі сияқты, солай ма?
Dialogue: 0,0:02:04.08,0:02:06.12,Default,,0,0,0,,Жоқ, сен...
Dialogue: 0,0:02:06.20,0:02:08.92,Default,,0,0,0,,Ах, Легошидің атасы.
Dialogue: 0,0:02:09.00,0:02:10.17,Default,,0,0,0,,Е...
Dialogue: 0,0:02:10.25,0:02:12.34,Default,,0,0,0,,Жоқ, бұл кесіртке!
Dialogue: 0,0:02:12.42,0:02:15.26,Default,,0,0,0,,Бұл тістерімді қақыратады, ақымақ! Ал, ал да кет.
Dialogue: 0,0:02:24.06,0:02:26.02,Default,,0,0,0,,Ой, кешіріңіз.
Dialogue: 0,0:02:26.10,0:02:28.69,Default,,0,0,0,,Легошидің атасы кесіртке екенін білмедім.
Dialogue: 0,0:02:28.77,0:02:30.19,Default,,0,0,0,,Жоқ, жоқ, жоқ
Dialogue: 0,0:02:30.77,0:02:33.27,Default,,0,0,0,,Әлгі бала сөйлеген жоқ.
Dialogue: 0,0:02:33.36,0:02:37.40,Default,,0,0,0,,Аа, шынымен де Легоси-кун туралы осындай нәрсе бар.
Dialogue: 0,0:02:37.49,0:02:40.20,Default,,0,0,0,,Сіз мұны әдетте бірінші айтпайсыз ба? Бір нәрсе сияқты
Dialogue: 0,0:02:40.28,0:02:42.28,Default,,0,0,0,,А, қазір ойлап қарасам... бірдеңе.
Dialogue: 0,0:02:43.37,0:02:45.62,Default,,0,0,0,,Бұл Легосидің анасы ма?
Dialogue: 0,0:02:46.79,0:02:47.87,Default,,0,0,0,,О
Dialogue: 0,0:02:48.62,0:02:50.04,Default,,0,0,0,,Менің қызым менің әйеліме ұқсайды, солай ма?
Dialogue: 0,0:02:50.12,0:02:51.96,Default,,0,0,0,,Эмма мен басқалары – мен бұрын-соңды көрген де, сөйлескен де алғашқы адамдар еді.
Dialogue: 0,0:02:52.04,0:02:54.50,Default,,0,0,0,,Шырын болса екен...
Dialogue: 0,0:02:54.59,0:02:55.25,Default,,0,0,0,,Жоқ
Dialogue: 0,0:02:55.34,0:02:58.13,Default,,0,0,0,,Легоси-кун да ойнауға шыққанда шай береді.
Dialogue: 0,0:02:58.21,0:02:59.34,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:03:00.17,0:03:01.01,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:01.09,0:03:02.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:04.10,0:03:04.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:05.39,0:03:06.56,Default,,0,0,0,,Иә...
Dialogue: 0,0:03:07.39,0:03:09.56,Default,,0,0,0,,Иә, дезинфекция аяқталды
Dialogue: 0,0:03:09.64,0:03:11.14,Default,,0,0,0,,Не...?
Dialogue: 0,0:03:11.23,0:03:14.23,Default,,0,0,0,,Комодо айдаһарының уы қауіпті
Dialogue: 0,0:03:14.31,0:03:17.07,Default,,0,0,0,,Кішкентай жанасу да өлімге әкелуі мүмкін.
Dialogue: 0,0:03:17.98,0:03:18.90,Default,,0,0,0,,У...
Dialogue: 0,0:03:19.40,0:03:21.86,Default,,0,0,0,,Сондықтан бұрын оқ ату жақсы стратегия болған.
Dialogue: 0,0:03:21.86,0:03:22.70,Default,,0,0,0,,Сондықтан бұрын оқ ату жақсы стратегия болған.
Dialogue: 0,0:03:21.86,0:03:22.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:22.78,0:03:24.99,Default,,0,0,0,,Қарсыласқа тимей-ақ шабуыл жасай аласыз.
Dialogue: 0,0:03:25.66,0:03:29.12,Default,,0,0,0,,Мм, сізді кенеттен қобалжытқаным үшін кешіріңіз.
Dialogue: 0,0:03:29.20,0:03:32.71,Default,,0,0,0,,Мені қорқытқан сенсің.
Dialogue: 0,0:03:32.79,0:03:34.83,Default,,0,0,0,,Мен шамалы қалықтадым
Dialogue: 0,0:03:34.92,0:03:39.09,Default,,0,0,0,,Легоси маған асыл баламды сеніп тапсырғанына қуаныштымын.
Dialogue: 0,0:03:39.17,0:03:42.22,Default,,0,0,0,,Мен алдымен сенімен дұрыс сөйлесуім керек еді.
Dialogue: 0,0:03:42.30,0:03:43.13,Default,,0,0,0,,Жоқ
Dialogue: 0,0:03:43.22,0:03:47.14,Default,,0,0,0,,Мен бірінші айтсам, саған ұнамайтынын білемін, Легоси-кун.
Dialogue: 0,0:03:47.22,0:03:50.68,Default,,0,0,0,,Менің ойымша, ол маған шабуыл жасамады деп алаңдады.
Dialogue: 0,0:03:50.77,0:03:54.69,Default,,0,0,0,,Легосиге мүлде күмәнданбайсыз.
Dialogue: 0,0:03:54.77,0:03:56.65,Default,,0,0,0,,Сол баладан қорықпайсың ба?
Dialogue: 0,0:03:56.73,0:03:57.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:57.40,0:04:01.49,Default,,0,0,0,,Өліп қалу қаупі бар, әйтпесе атаң кесіртке.
Dialogue: 0,0:04:01.57,0:04:03.36,Default,,0,0,0,,Ең бастысы, қасқырлар.
Dialogue: 0,0:04:03.45,0:04:06.41,Default,,0,0,0,,Ахаха... Мен қорықпаймын.
Dialogue: 0,0:04:06.49,0:04:09.12,Default,,0,0,0,,Жарайды, қорқатын кездерім болды.
Dialogue: 0,0:04:09.20,0:04:11.33,Default,,0,0,0,,Қоян қасқырларды ұната бастағанда
Dialogue: 0,0:04:11.41,0:04:13.37,Default,,0,0,0,,Бұл өте кедергі.
Dialogue: 0,0:04:14.08,0:04:18.34,Default,,0,0,0,,Оның үстіне бұл қасқыр емес, Легоси-кун.
Dialogue: 0,0:04:18.84,0:04:20.96,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:04:21.05,0:04:22.63,Default,,0,0,0,,Токи де солай болды.
Dialogue: 0,0:04:23.34,0:04:25.22,Default,,0,0,0,,Токи? Бұл сіздің әйеліңіз бе?
Dialogue: 0,0:04:25.30,0:04:26.22,Default,,0,0,0,,О
Dialogue: 0,0:04:26.80,0:04:29.51,Default,,0,0,0,,Ол маған мұны да айтты.
Dialogue: 0,0:04:29.60,0:04:31.14,Default,,0,0,0,,Мен кім болсам да
Dialogue: 0,0:04:31.22,0:04:34.35,Default,,0,0,0,,Тіпті мен, Комодо айдаһары да оны жақсы көремін.
Dialogue: 0,0:04:36.40,0:04:39.69,Default,,0,0,0,,Біз кездескен кезде жасөспірім едік.
Dialogue: 0,0:04:40.36,0:04:45.11,Default,,0,0,0,,Біз бір көргеннен ғашық болып, айналамыздағылардың қарсылығына қарамастан кездесе бастадық.
Dialogue: 0,0:04:46.53,0:04:52.04,Default,,0,0,0,,Ол кезде түраралық романтика әлі де салқын көзбен қаралатын.
Dialogue: 0,0:04:52.12,0:04:53.83,Default,,0,0,0,,Бірақ мен бақыттымын...
Dialogue: 0,0:04:53.91,0:04:56.29,Default,,0,0,0,,Ғажайып балалы болдым
Dialogue: 0,0:04:56.37,0:04:58.38,Default,,0,0,0,,Эй, мені сүй
Dialogue: 0,0:04:58.46,0:05:00.71,Default,,0,0,0,,Не болды? Бүгін сен де сүйкімдісің
Dialogue: 0,0:05:00.80,0:05:01.71,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:01.80,0:05:02.63,Default,,0,0,0,,Шу
Dialogue: 0,0:05:02.71,0:05:03.46,Default,,0,0,0,,Хмм… Бұл не өзі!
Dialogue: 0,0:05:05.76,0:05:08.09,Default,,0,0,0,,А... сен де әйеліңе солай істедің бе?
Dialogue: 0,0:05:08.68,0:05:11.14,Default,,0,0,0,,Сіз үнемі шағымданушы едіңіз.
Dialogue: 0,0:05:11.22,0:05:13.47,Default,,0,0,0,,Бұл мүлдем романтикалық емес
Dialogue: 0,0:05:15.02,0:05:18.10,Default,,0,0,0,,Әр күнім түс сияқты өтті
Dialogue: 0,0:05:18.19,0:05:21.02,Default,,0,0,0,,Мейірімді, сұлу қыз
Dialogue: 0,0:05:21.11,0:05:25.32,Default,,0,0,0,,Мен сияқты улы құбыжықпен отбасын құрғаны үшін.
Dialogue: 0,0:05:25.40,0:05:28.78,Default,,0,0,0,,Әйеліңді құбыжық деп ойламадың, солай ма?
Dialogue: 0,0:05:28.87,0:05:29.91,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:05:30.49,0:05:32.87,Default,,0,0,0,,Токи үміттенген сияқты.
Dialogue: 0,0:05:32.95,0:05:36.46,Default,,0,0,0,,Улар туралы уайымдамауды қалаймын.
Dialogue: 0,0:05:37.79,0:05:39.92,Default,,0,0,0,,Бұл болды
Dialogue: 0,0:05:40.71,0:05:44.88,Default,,0,0,0,,Ол кезде мен бір-біріне махаббат құюға құмар болатынмын.
Dialogue: 0,0:05:46.80,0:05:48.80,Default,,0,0,0,,Туған күніңмен Токи
Dialogue: 0,0:05:49.43,0:05:50.55,Default,,0,0,0,,Кристалда жарық жүздеген миллион рет шағылады—
Dialogue: 0,0:05:50.64,0:05:51.68,Default,,0,0,0,,Рахмет
Dialogue: 0,0:05:53.18,0:05:54.52,Default,,0,0,0,,Мен бұл туралы шынымен ойлаймын
Dialogue: 0,0:05:55.31,0:05:59.90,Default,,0,0,0,,Мен сенімен бірге болған әлемдегі ең бақытты адаммын.
Dialogue: 0,0:06:03.23,0:06:06.32,Default,,0,0,0,,На не! Токиге! Не істеп жатырсың...
Dialogue: 0,0:06:06.40,0:06:10.28,Default,,0,0,0,,Дезинфекциялық залалсыздандыру Дезинфекциялау құралы туралы не деуге болады?
Dialogue: 0,0:06:10.36,0:06:11.87,Default,,0,0,0,,Ол қайда?
Dialogue: 0,0:06:11.95,0:06:13.87,Default,,0,0,0,,Мен сенің білгеніңді қалаймын
Dialogue: 0,0:06:14.45,0:06:18.46,Default,,0,0,0,,Ештеңеге алаңдамай, құмарлықпен сүю бақыты
Dialogue: 0,0:06:18.54,0:06:19.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:20.83,0:06:22.29,Default,,0,0,0,,А...
Dialogue: 0,0:06:23.38,0:06:27.30,Default,,0,0,0,,Мен саған уайымдарыңды ұмыттырдым
Dialogue: 0,0:06:29.68,0:06:30.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:30.64,0:06:31.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:30.64,0:06:31.76,Default,,0,0,0,,Міне, мен ақыры түсіндім
Dialogue: 0,0:06:31.76,0:06:31.84,Default,,0,0,0,,Міне, мен ақыры түсіндім
Dialogue: 0,0:06:31.84,0:06:33.64,Default,,0,0,0,,Міне, мен ақыры түсіндім
Dialogue: 0,0:06:31.84,0:06:33.64,Default,,0,0,0,,(Гошаның айқайы)
Dialogue: 0,0:06:33.64,0:06:34.39,Default,,0,0,0,,(Гошаның айқайы)
Dialogue: 0,0:06:34.47,0:06:37.93,Default,,0,0,0,,Мені Ібіске ғашық еткен нәрсе
Dialogue: 0,0:06:38.02,0:06:41.19,Default,,0,0,0,,Мұның бәрі Токидің ескеруінің арқасында болды.
Dialogue: 0,0:06:41.98,0:06:44.36,Default,,0,0,0,,Егер мен байқаған болсам—
Dialogue: 0,0:06:44.44,0:06:47.44,Default,,0,0,0,,Мүмкін мен оны жоғалтпауым керек еді.
Dialogue: 0,0:06:48.28,0:06:50.86,Default,,0,0,0,,Легошиді жақсы көретініңізге қуаныштымын.
Dialogue: 0,0:06:51.57,0:06:56.62,Default,,0,0,0,,Сондықтан мен сенің бақытты болғаныңды қалаймын
Dialogue: 0,0:06:56.70,0:06:59.62,Default,,0,0,0,,Екі жануармен мәңгілік
Dialogue: 0,0:07:00.71,0:07:02.42,Default,,0,0,0,,Жарайды
Dialogue: 0,0:07:02.50,0:07:05.55,Default,,0,0,0,,Дәл бүгін атамды осылай қарсы алғаным сияқты.
Dialogue: 0,0:07:05.63,0:07:08.67,Default,,0,0,0,,Мен сен туралы көбірек білгім келеді, Легоси.
Dialogue: 0,0:07:09.26,0:07:11.55,Default,,0,0,0,,Сенің де мен туралы білгеніңді қалаймын.
Dialogue: 0,0:07:11.63,0:07:14.72,Default,,0,0,0,,Өйткені сен тірі болмасаң мұны істей алмайсың.
Dialogue: 0,0:07:15.22,0:07:16.56,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:07:17.89,0:07:19.27,Default,,0,0,0,,Ата
Dialogue: 0,0:07:19.35,0:07:21.94,Default,,0,0,0,,Токи-сан сені шынымен жақсы көрді, солай ма?
Dialogue: 0,0:07:22.02,0:07:23.35,Default,,0,0,0,,О
Dialogue: 0,0:07:25.48,0:07:28.23,Default,,0,0,0,,Бірақ мен жалғызбын
Dialogue: 0,0:07:36.74,0:07:38.49,Default,,0,0,0,,Неге жылайсың?
Dialogue: 0,0:07:38.58,0:07:41.54,Default,,0,0,0,,Иісінің күштілігі сонша, көзімді шағып жібереді
Dialogue: 0,0:07:43.37,0:07:45.42,Default,,0,0,0,,Хаха...
Dialogue: 0,0:07:47.42,0:07:48.59,Default,,0,0,0,,Ха!
Dialogue: 0,0:07:49.13,0:07:51.09,Default,,0,0,0,,Ах, мен өмірге қайта оралдым.
Dialogue: 0,0:07:49.13,0:07:51.09,Default,,0,0,0,,(Баланың жылауы)
Dialogue: 0,0:07:51.17,0:07:53.30,Default,,0,0,0,,Кешіріңіз, анашым!
Dialogue: 0,0:07:54.64,0:07:56.64,Default,,0,0,0,,Ол тағы бірдеңені ұрлады.
Dialogue: 0,0:07:56.72,0:07:59.39,Default,,0,0,0,,Ата-анаң қанша болса да, сәл артық шығар...
Dialogue: 0,0:07:59.47,0:08:01.56,Default,,0,0,0,,Жоқ, жоқ, бұл ата-ана мен бала емес.
Dialogue: 0,0:08:01.64,0:08:03.06,Default,,0,0,0,,Бірақ «мама»…
Dialogue: 0,0:08:03.14,0:08:05.15,Default,,0,0,0,,Сіздің патронаттық ата-анаңыз қандай?
Dialogue: 0,0:08:05.23,0:08:06.23,Default,,0,0,0,,Жақсы емес нәрсе жақсы емес.
Dialogue: 0,0:08:06.23,0:08:07.86,Default,,0,0,0,,Жақсы емес нәрсе жақсы емес.
Dialogue: 0,0:08:06.23,0:08:07.86,Default,,0,0,0,,Жетімдер?
Dialogue: 0,0:08:07.94,0:08:10.65,Default,,0,0,0,,Ол баланы қарт кісі тәрбиелеп отырған.
Dialogue: 0,0:08:10.74,0:08:13.45,Default,,0,0,0,,Әлгі қарт қоғамдық қоғамда біраз ебедейсіз.
Dialogue: 0,0:08:14.20,0:08:16.99,Default,,0,0,0,,Мен қашуға кешігіп, Яхьяның қолына түстім.
Dialogue: 0,0:08:17.07,0:08:18.91,Default,,0,0,0,,Білесің бе, Яхья.
Dialogue: 0,0:08:18.99,0:08:19.62,Default,,0,0,0,,Иә
Dialogue: 0,0:08:20.41,0:08:22.91,Default,,0,0,0,,Яхьяның қолына түссең, ақыры.
Dialogue: 0,0:08:23.00,0:08:24.33,Default,,0,0,0,,Қайтып келмейді
Dialogue: 0,0:08:25.71,0:08:27.42,Default,,0,0,0,,Сәбіз тыңайтқышы…
Dialogue: 0,0:08:28.09,0:08:31.05,Default,,0,0,0,,Бұл артқы базарда осындай бірнеше балалар бар.
Dialogue: 0,0:08:31.13,0:08:32.01,Default,,0,0,0,,Кохома мені тамақтандырып жатыр.
Dialogue: 0,0:08:32.01,0:08:33.55,Default,,0,0,0,,Кохома мені тамақтандырып жатыр.
Dialogue: 0,0:08:32.01,0:08:33.55,Default,,0,0,0,,Кәне, ойнайық
Dialogue: 0,0:08:33.63,0:08:34.63,Default,,0,0,0,,(1-ші баланың күлкісі)
Dialogue: 0,0:08:35.26,0:08:35.97,Default,,0,0,0,,О, өтінемін, мені өлтірме
Dialogue: 0,0:08:36.05,0:08:36.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:36.68,0:08:38.14,Default,,0,0,0,,Сәлем Дегоши
Dialogue: 0,0:08:38.85,0:08:42.68,Default,,0,0,0,,Қабырғаның ішінде немесе сыртында кім жүрексіз деп ойлайсың?
Dialogue: 0,0:08:43.81,0:08:45.69,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:47.31,0:08:48.56,Default,,0,0,0,,Әй?
Dialogue: 0,0:08:48.65,0:08:49.98,Default,,0,0,0,,(Мугидің тосынсыйы)
Dialogue: 0,0:08:50.07,0:08:53.11,Default,,0,0,0,,Бір апталық азық-түлік бір жолда тасымалданды.
Dialogue: 0,0:08:53.19,0:08:54.36,Default,,0,0,0,,Дегоси Керемет!
Dialogue: 0,0:08:54.45,0:08:56.53,Default,,0,0,0,,Мен тек ауыр жүкті көтере аламын...
Dialogue: 0,0:08:56.53,0:08:57.78,Default,,0,0,0,,Мен тек ауыр жүкті көтере аламын...
Dialogue: 0,0:08:56.53,0:08:57.78,Default,,0,0,0,,(бұршақтың күші)
Dialogue: 0,0:08:57.87,0:09:00.54,Default,,0,0,0,,- (Бұршақ) Эй! көзқарас! -иә? О...
Dialogue: 0,0:09:01.58,0:09:03.16,Default,,0,0,0,,(бұршақтың күші)
Dialogue: 0,0:09:03.25,0:09:06.37,Default,,0,0,0,,Тей! Алақай! Таа!
Dialogue: 0,0:09:07.33,0:09:10.09,Default,,0,0,0,,Бұршақ Cue сияқты күштірек болады.
Dialogue: 0,0:09:10.17,0:09:12.92,Default,,0,0,0,,Q бұл қоян ба?
Dialogue: 0,0:09:13.01,0:09:15.88,Default,,0,0,0,,Әй, бұл кішкентай шөп қоректі жануар болса да.
Dialogue: 0,0:09:15.97,0:09:18.93,Default,,0,0,0,,Fight Club ойынында ең көп ақша табыңыз
Dialogue: 0,0:09:19.01,0:09:20.97,Default,,0,0,0,,Бұл өте күшті
Dialogue: 0,0:09:21.06,0:09:23.47,Default,,0,0,0,,Артқы нарықтағы балалардың ұмтылысы
Dialogue: 0,0:09:23.56,0:09:25.31,Default,,0,0,0,,(От-шағал жәндігінің дыбысы)
Dialogue: 0,0:09:25.39,0:09:26.60,Default,,0,0,0,,Бұл арман
Dialogue: 0,0:09:27.10,0:09:28.02,Default,,0,0,0,,Арман...
Dialogue: 0,0:09:28.60,0:09:31.19,Default,,0,0,0,,Мен армандаймын, өйткені менің қызым бар.
Dialogue: 0,0:09:31.27,0:09:33.90,Default,,0,0,0,,Аспанда жарқыраған жұлдыз.
Dialogue: 0,0:09:33.99,0:09:36.74,Default,,0,0,0,,Мен сондай болғым келеді, мүмкін мен де солай болуым мүмкін.
Dialogue: 0,0:09:36.82,0:09:38.57,Default,,0,0,0,,Өйткені солай ойлайтындар бар.
Dialogue: 0,0:09:38.66,0:09:41.62,Default,,0,0,0,,Бұл балалар бастарын көтере алады.
Dialogue: 0,0:09:41.70,0:09:43.62,Default,,0,0,0,,Негізі кім екенің маңызды емес.
Dialogue: 0,0:09:44.33,0:09:47.54,Default,,0,0,0,,Мұндай адамның бар болуы маңызды.
Dialogue: 0,0:09:48.17,0:09:50.84,Default,,0,0,0,,Басыңды төмен салып өмір сүрсең, аяғың бірін-бірі таптайды.
Dialogue: 0,0:09:50.92,0:09:53.75,Default,,0,0,0,,Бүйірге бұрылып, көз жанассаңыз да, менші арасында төбелес болады.
Dialogue: 0,0:09:54.38,0:09:56.13,Default,,0,0,0,,Егер бәрімізде ізденетін нәрсе болса
Dialogue: 0,0:09:56.22,0:09:59.34,Default,,0,0,0,,Ең болмағанда сол сәтке ешқандай қақтығыс болмайды.
Dialogue: 0,0:09:59.43,0:10:01.47,Default,,0,0,0,,Қоғамдық қоғамда да солай.
Dialogue: 0,0:10:02.81,0:10:06.73,Default,,0,0,0,,Егер мен басын көтеріп, сол түсімді көрсем —
Dialogue: 0,0:10:07.52,0:10:11.90,Default,,0,0,0,,Жер асты нарығында және қоғамдық әлемде етқоректі де, шөпқоректі де
Dialogue: 0,0:10:12.82,0:10:15.03,Default,,0,0,0,,Қызық, бірге жұмыс істей аламыз ба?
Dialogue: 0,0:10:22.66,0:10:23.74,Default,,0,0,0,,Не істеу керек...
Dialogue: 0,0:10:23.83,0:10:25.49,Default,,0,0,0,,Сіз қашып құтыла аласыз ба?
Dialogue: 0,0:10:26.00,0:10:30.04,Default,,0,0,0,,Жоқ, жоқ, қашу ештеңені шешпейді.
Dialogue: 0,0:10:30.12,0:10:31.13,Default,,0,0,0,,Луис мырза
Dialogue: 0,0:10:31.21,0:10:33.79,Default,,0,0,0,,Келіңізші, Луис.
Dialogue: 0,0:10:33.88,0:10:35.59,Default,,0,0,0,,Мен шомылдым.
Dialogue: 0,0:10:35.67,0:10:38.80,Default,,0,0,0,,А... бұл тез болды.
Dialogue: 0,0:10:38.88,0:10:40.93,Default,,0,0,0,,Кел, айт!
Dialogue: 0,0:10:41.01,0:10:44.22,Default,,0,0,0,,Мен шөпқоректі жануармен бұлай істей алмаймын.
Dialogue: 0,0:10:44.31,0:10:46.18,Default,,0,0,0,,Мен сол лайшаға қызғанып жүр едім…
Dialogue: 0,0:10:46.27,0:10:49.31,Default,,0,0,0,,Мен сені шақырғанда, сен менен бас тартасың деп ойладым.
Dialogue: 0,0:10:49.39,0:10:50.81,Default,,0,0,0,,Біз өлерміз
Dialogue: 0,0:10:50.90,0:10:53.77,Default,,0,0,0,,Екеуміз жалғыз қалатын дәрежеге жеттік.
Dialogue: 0,0:10:53.86,0:10:55.69,Default,,0,0,0,,Сөйле! Дұрыстап айт!
Dialogue: 0,0:10:57.28,0:11:00.07,Default,,0,0,0,,Жоқ, мен не айтуым керек?
Dialogue: 0,0:11:00.15,0:11:01.57,Default,,0,0,0,,Келісімді бұзу мүмкін емес
Dialogue: 0,0:11:01.66,0:11:05.53,Default,,0,0,0,,Сонда да... сонда мен...
Dialogue: 0,0:11:05.62,0:11:06.70,Default,,0,0,0,,Бізде бөлмеге қызмет көрсету керек пе?
Dialogue: 0,0:11:06.70,0:11:07.70,Default,,0,0,0,,Бөлмеге қызмет көрсетеміз бе?
Dialogue: 0,0:11:06.70,0:11:07.70,Default,,0,0,0,,А...?
Dialogue: 0,0:11:08.29,0:11:09.87,Default,,0,0,0,,Кешкі ас әлі берілген жоқ.
Dialogue: 0,0:11:10.37,0:11:12.29,Default,,0,0,0,,Мұнда бөлмеге қызмет көрсету... Уау!
Dialogue: 0,0:11:12.38,0:11:14.50,Default,,0,0,0,,Уф ха!
Dialogue: 0,0:11:14.59,0:11:17.55,Default,,0,0,0,,Луи, жат.
Dialogue: 0,0:11:17.63,0:11:18.76,Default,,0,0,0,,Мен мұны істеймін.
Dialogue: 0,0:11:18.84,0:11:20.42,Default,,0,0,0,,Жоқ... өтінемін тоқта!
Dialogue: 0,0:11:20.51,0:11:21.76,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:21.84,0:11:22.59,Default,,0,0,0,,Ха...
Dialogue: 0,0:11:24.76,0:11:25.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:25.93,0:11:27.89,Default,,0,0,0,,Бұл...
Dialogue: 0,0:11:27.97,0:11:29.39,Default,,0,0,0,,Мен де...
Dialogue: 0,0:11:30.23,0:11:32.44,Default,,0,0,0,,Мен де көп тырысамын.
Dialogue: 0,0:11:32.52,0:11:35.06,Default,,0,0,0,,Түсіндім, кешіріңіз.
Dialogue: 0,0:11:35.15,0:11:37.86,Default,,0,0,0,,Сіз мұны екі отбасы үшін де жасап жатырсыз.
Dialogue: 0,0:11:37.94,0:11:39.99,Default,,0,0,0,,Сен мені сонша жек көресің бе?
Dialogue: 0,0:11:40.07,0:11:41.15,Default,,0,0,0,,Бұлай емес...
Dialogue: 0,0:11:41.24,0:11:43.99,Default,,0,0,0,,Олай болса, мені сүйіп жібересің бе?
Dialogue: 0,0:11:44.07,0:11:45.07,Default,,0,0,0,,Мұнда және қазір
Dialogue: 0,0:11:45.16,0:11:47.70,Default,,0,0,0,,А... бұл...
Dialogue: 0,0:11:50.37,0:11:52.04,Default,,0,0,0,,Бұл сенің кінәң емес
Dialogue: 0,0:11:52.67,0:11:54.67,Default,,0,0,0,,Бұл менің проблемам.
Dialogue: 0,0:11:54.75,0:11:58.21,Default,,0,0,0,,Мен... Шөпқоректі...
Dialogue: 0,0:11:58.30,0:11:58.96,Default,,0,0,0,,А...
Dialogue: 0,0:11:59.05,0:12:00.38,Default,,0,0,0,,Мен...
Dialogue: 0,0:12:01.17,0:12:04.84,Default,,0,0,0,,Менің жыртқыштарға деген қатты сезімім бар.
Dialogue: 0,0:12:04.93,0:12:06.51,Default,,0,0,0,,Сізге келсек...
Dialogue: 0,0:12:06.60,0:12:09.68,Default,,0,0,0,,Бірақ бұл мәселе.
Dialogue: 0,0:12:09.77,0:12:14.69,Default,,0,0,0,,Әкем үшін мен артымда Horns конгломератының мұрагерін қалдырамын.
Dialogue: 0,0:12:14.77,0:12:17.15,Default,,0,0,0,,Әйтпесе, пайда болмайды.
Dialogue: 0,0:12:17.23,0:12:19.53,Default,,0,0,0,,Бірақ бұл қиын.
Dialogue: 0,0:12:20.86,0:12:25.28,Default,,0,0,0,,Қанша ойласам да, көңілім жеңілдеп қалды.
Dialogue: 0,0:12:26.49,0:12:27.74,Default,,0,0,0,,Сол жігіттер...
Dialogue: 0,0:12:27.83,0:12:29.49,Default,,0,0,0,,Етқоректілермен
Dialogue: 0,0:12:30.12,0:12:32.37,Default,,0,0,0,,Сол иіспен қоршалған кезде
Dialogue: 0,0:12:33.46,0:12:35.62,Default,,0,0,0,,Сіз келісімді бұза аласыз.
Dialogue: 0,0:12:36.29,0:12:39.92,Default,,0,0,0,,Мен сені бұдан былай ұстай алмайтын шығармын.
Dialogue: 0,0:12:40.42,0:12:45.80,Default,,0,0,0,,Үйленуіміздің мақсаты – мұрагерді табу...
Dialogue: 0,0:12:45.89,0:12:46.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:48.43,0:12:49.43,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:12:49.97,0:12:52.02,Default,,0,0,0,,Мен жағдайды түсінемін.
Dialogue: 0,0:12:52.10,0:12:55.19,Default,,0,0,0,,Олай болса, мені ұстаудың қажеті жоқ.
Dialogue: 0,0:12:55.27,0:12:55.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:55.98,0:13:02.07,Default,,0,0,0,,Луис, біздің мақсатымыз үйлерді қосу.
Dialogue: 0,0:13:02.15,0:13:05.53,Default,,0,0,0,,Балалар қажет, бірақ көптеген жолдар бар.
Dialogue: 0,0:13:05.61,0:13:06.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:06.95,0:13:08.53,Default,,0,0,0,,Шынында да, И
Dialogue: 0,0:13:08.62,0:13:11.87,Default,,0,0,0,,Менің мақсатым сенімен романтикалық қарым-қатынаста болу еді.
Dialogue: 0,0:13:11.95,0:13:16.04,Default,,0,0,0,,Бірақ мақсаттарыңызды икемді түрде өзгертіңіз
Dialogue: 0,0:13:16.12,0:13:18.63,Default,,0,0,0,,Бұл басқару үшін де қажет.
Dialogue: 0,0:13:18.71,0:13:20.54,Default,,0,0,0,,Азуки-сан
Dialogue: 0,0:13:20.63,0:13:22.55,Default,,0,0,0,,Мақсаттарыңызды өзгертіңіз
Dialogue: 0,0:13:22.63,0:13:25.67,Default,,0,0,0,,Бізге романтикалық қарым-қатынаста болудың қажеті жоқ.
Dialogue: 0,0:13:25.76,0:13:27.43,Default,,0,0,0,,Жыныстық қатынастың қажеті жоқ
Dialogue: 0,0:13:27.51,0:13:28.64,Default,,0,0,0,,Келесі шайқас үшін!
Dialogue: 0,0:13:29.22,0:13:33.22,Default,,0,0,0,,Бұл келісімді бұзбай үйленетініңді білдіре ме?
Dialogue: 0,0:13:33.31,0:13:35.23,Default,,0,0,0,,Иә, бұрынғыдай.
Dialogue: 0,0:13:35.31,0:13:35.89,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:13:35.98,0:13:36.81,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:13:36.89,0:13:39.44,Default,,0,0,0,,Мен сенің бақытсыз неке болғаныңды қаламаймын.
Dialogue: 0,0:13:40.06,0:13:41.23,Default,,0,0,0,,Және...
Dialogue: 0,0:13:41.94,0:13:42.90,Default,,0,0,0,,Луис мырза
Dialogue: 0,0:13:43.48,0:13:45.57,Default,,0,0,0,,Сіз қате түсіндіңіз.
Dialogue: 0,0:13:45.65,0:13:46.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:46.61,0:13:50.37,Default,,0,0,0,,Үйленудің өзі – менің мақсатым.
Dialogue: 0,0:13:52.45,0:13:55.16,Default,,0,0,0,,Сондықтан уайымдамаңыз.
Dialogue: 0,0:13:56.04,0:13:57.75,Default,,0,0,0,,Ал біз
Dialogue: 0,0:13:57.83,0:14:01.13,Default,,0,0,0,,Ғашық бола алмасаң да, жар бола аласың.
Dialogue: 0,0:14:01.21,0:14:02.25,Default,,0,0,0,,Бизнес
Dialogue: 0,0:14:03.34,0:14:06.13,Default,,0,0,0,,Бұған сен жарайсың ба?
Dialogue: 0,0:14:06.22,0:14:07.17,Default,,0,0,0,,Иә
Dialogue: 0,0:14:07.76,0:14:08.76,Default,,0,0,0,,Мен —
Dialogue: 0,0:14:08.84,0:14:13.22,Default,,0,0,0,,Мен әкемнің соңынан еретін компанияны дамытуға мүдделімін.
Dialogue: 0,0:14:13.31,0:14:14.56,Default,,0,0,0,,Осы неке ұсынысымен—
Dialogue: 0,0:14:14.64,0:14:17.85,Default,,0,0,0,,My Augula Foods тарихына ие болды.
Dialogue: 0,0:14:17.94,0:14:22.11,Default,,0,0,0,,Horns конгломератының болашағы туралы алаңдаушылық жоғалады.
Dialogue: 0,0:14:22.19,0:14:23.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:25.03,0:14:25.99,Default,,0,0,0,,Хехе
Dialogue: 0,0:14:32.74,0:14:35.08,Default,,0,0,0,,Бұл шынымен сен бе?
Dialogue: 0,0:14:35.16,0:14:35.95,Default,,0,0,0,,О
Dialogue: 0,0:14:36.62,0:14:37.79,Default,,0,0,0,,Өкілдіксіз—
Dialogue: 0,0:14:37.87,0:14:40.87,Default,,0,0,0,,Махаббат еті күнінде сіз шымтезек соғысына қатыса алмайсыз, солай ма?
Dialogue: 0,0:14:40.96,0:14:44.13,Default,,0,0,0,,Айтпақшы, мен бастық екенімді мойындамаймын.
Dialogue: 0,0:14:44.21,0:14:45.63,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:14:45.71,0:14:47.63,Default,,0,0,0,,Дәл осы жолы
Dialogue: 0,0:14:47.72,0:14:50.22,Default,,0,0,0,,Мен осыдан шықпасам, келесісі бір жылдан кейін...
Dialogue: 0,0:14:50.30,0:14:53.47,Default,,0,0,0,,Оған дейін Доку тобы, Мадара тобы, Инари тобы
Dialogue: 0,0:14:53.55,0:14:57.52,Default,,0,0,0,,Олардың менің территориямды басып алып, мені үлкен адам етіп көрсетуіне шыдай алмаймын.
Dialogue: 0,0:14:58.31,0:15:04.02,Default,,0,0,0,,«Өкіл Агата»
Dialogue: 0,0:15:05.23,0:15:07.90,Default,,0,0,0,,Хмм, жарайды!
Dialogue: 0,0:15:08.53,0:15:11.41,Default,,0,0,0,,Tto! Енді мен кіре аламын!
Dialogue: 0,0:15:11.49,0:15:12.87,Default,,0,0,0,,Күте тұрыңыз, күтіңіз
Dialogue: 0,0:15:12.95,0:15:15.83,Default,,0,0,0,,Егер бәріміз осылай жасасақ, Хаку мұны істей алмайды.
Dialogue: 0,0:15:15.91,0:15:18.91,Default,,0,0,0,,Уақытша болса да, өкіл - өкіл.
Dialogue: 0,0:15:19.00,0:15:20.08,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:15:21.50,0:15:26.46,Default,,0,0,0,,Хмм… Бұл не өзі!
Dialogue: 0,0:15:26.46,0:15:27.84,Default,,0,0,0,,Хмм… Бұл не өзі!
Dialogue: 0,0:15:26.46,0:15:27.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:27.84,0:15:28.46,Default,,0,0,0,,Хмм… Бұл не өзі!
Dialogue: 0,0:15:29.34,0:15:31.93,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:15:32.01,0:15:32.89,Default,,0,0,0,,Бастық?
Dialogue: 0,0:15:38.14,0:15:42.35,Default,,0,0,0,,Қатысушының барлығын көруге жылы лебіз.
Dialogue: 0,0:15:42.44,0:15:44.06,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:15:44.77,0:15:45.90,Default,,0,0,0,,Әй?
Dialogue: 0,0:15:51.86,0:15:54.16,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:15:54.24,0:15:56.16,Default,,0,0,0,,Не... шеп соғысы?
Dialogue: 0,0:15:56.24,0:15:57.53,Default,,0,0,0,,Соғысқа қатысу
Dialogue: 0,0:15:57.62,0:15:58.95,Default,,0,0,0,,Хмм.
Dialogue: 0,0:15:59.83,0:16:03.29,Default,,0,0,0,,Бұл Ай ет күні ме? Дұрыс.
Dialogue: 0,0:16:03.92,0:16:07.34,Default,,0,0,0,,Мен ұрғашы қоянды сағындым.
Dialogue: 0,0:16:08.00,0:16:10.30,Default,,0,0,0,,Мен қашан тамақ ішеміз деп ойладым.
Dialogue: 0,0:16:10.92,0:16:13.63,Default,,0,0,0,,Етті жақсы көретін күн ғой, солай ма?
Dialogue: 0,0:16:13.72,0:16:15.43,Default,,0,0,0,,Сол күні тамақ ішуім керек пе?
Dialogue: 0,0:16:17.64,0:16:18.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:18.47,0:16:20.22,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:20.85,0:16:24.19,Default,,0,0,0,,«Өкіл Агата»
Dialogue: 0,0:16:24.27,0:16:27.31,Default,,0,0,0,,(Қауын күлкі)
Dialogue: 0,0:16:27.40,0:16:30.65,Default,,0,0,0,,Сіз әлдеқайда үлкен болдыңыз, солай емес пе?
Dialogue: 0,0:16:31.32,0:16:32.57,Default,,0,0,0,,Келесі шайқас!
Dialogue: 0,0:16:33.15,0:16:36.41,Default,,0,0,0,,Бұл мені әлдеқашан шығарып жіберді дегенді білдіре ме?
Dialogue: 0,0:16:36.49,0:16:38.12,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:16:38.20,0:16:40.74,Default,,0,0,0,,Өйткені сіз ол жерде болмадыңыз.
Dialogue: 0,0:16:40.83,0:16:43.79,Default,,0,0,0,,Мен сенің орныңды аламын...
Dialogue: 0,0:16:45.79,0:16:49.71,Default,,0,0,0,,(Қауынның күлкісі)
Dialogue: 0,0:16:49.80,0:16:51.05,Default,,0,0,0,,Сіз—
Dialogue: 0,0:16:51.63,0:16:53.76,Default,,0,0,0,,Менің орнымда ма?
Dialogue: 0,0:16:53.84,0:16:54.93,Default,,0,0,0,,Уф! Арх!
Dialogue: 0,0:16:56.05,0:16:56.89,Default,,0,0,0,,(қауын тілін шерту)
Dialogue: 0,0:16:57.59,0:17:00.39,Default,,0,0,0,,Мен тіпті сені ренжіттім
Dialogue: 0,0:17:00.47,0:17:03.35,Default,,0,0,0,,Сіз әлі ештеңе түсінбейсіз.
Dialogue: 0,0:17:03.43,0:17:04.73,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:05.31,0:17:06.10,Default,,0,0,0,,Не!
Dialogue: 0,0:17:07.10,0:17:10.44,Default,,0,0,0,,Мүмкін мен бастықты ауыстыра аламын.
Dialogue: 0,0:17:10.52,0:17:12.78,Default,,0,0,0,,Сіз мені алмастыра алмайсыз
Dialogue: 0,0:17:12.86,0:17:17.82,Default,,0,0,0,,Бұл дүниеде менің орнын басатын ешкім жоқ.
Dialogue: 0,0:17:20.41,0:17:22.91,Default,,0,0,0,,Бұл жалпы мағына
Dialogue: 0,0:17:23.58,0:17:26.29,Default,,0,0,0,,Анам да түсінбеді
Dialogue: 0,0:17:30.34,0:17:34.26,Default,,0,0,0,,Анам мені жақсы көретінін айтты, бірақ...
Dialogue: 0,0:17:34.34,0:17:39.51,Default,,0,0,0,,Ішімде әкемді іздедім.
Dialogue: 0,0:17:40.93,0:17:46.89,Default,,0,0,0,,Мен емес, әлсіз және қорқатын шөпқоректі жануар.
Dialogue: 0,0:17:47.60,0:17:50.27,Default,,0,0,0,,Сондықтан мен сендерге түсінік бердім.
Dialogue: 0,0:17:51.15,0:17:52.36,Default,,0,0,0,,(темір соққан дыбыс)
Dialogue: 0,0:17:53.11,0:17:56.36,Default,,0,0,0,,Мен әкемнен ерекшемін
Dialogue: 0,0:17:56.45,0:17:58.49,Default,,0,0,0,,Барлығынан бөлек
Dialogue: 0,0:17:59.07,0:18:00.95,Default,,0,0,0,,Мен жай ғана менмін
Dialogue: 0,0:18:01.53,0:18:03.79,Default,,0,0,0,,Менің орнын басатын ешкім жоқ
Dialogue: 0,0:18:04.33,0:18:04.95,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:18:05.04,0:18:06.46,Default,,0,0,0,,(Агатаның айқайы)
Dialogue: 0,0:18:06.54,0:18:08.87,Default,,0,0,0,,Ахх! Ха ха...
Dialogue: 0,0:18:08.96,0:18:10.63,Default,,0,0,0,,(Қауын күлкі)
Dialogue: 0,0:18:10.71,0:18:13.67,Default,,0,0,0,,Оны алмастырушы деп көрсетпеңіз.
Dialogue: 0,0:18:13.75,0:18:15.13,Default,,0,0,0,,Бұл ауруды біреу алып тастай ала ма?
Dialogue: 0,0:18:15.13,0:18:17.13,Default,,0,0,0,,Бұл ауруды біреу жоя алады ма?
Dialogue: 0,0:18:15.13,0:18:17.13,Default,,0,0,0,,(Мылтық көтеріліп жатқан дыбыс)
Dialogue: 0,0:18:17.22,0:18:19.34,Default,,0,0,0,,Ауырсыну тек саған ғана.
Dialogue: 0,0:18:20.64,0:18:21.30,Default,,0,0,0,,Эй...
Dialogue: 0,0:18:21.39,0:18:23.43,Default,,0,0,0,,Сен жалғызсың
Dialogue: 0,0:18:23.51,0:18:25.64,Default,,0,0,0,,Егер қолыңыздан келсе, жасап көріңіз.
Dialogue: 0,0:18:25.72,0:18:29.65,Default,,0,0,0,,Бастық позициясын өз қолыңызбен жеңіп алуға тырысыңыз.
Dialogue: 0,0:18:29.73,0:18:33.02,Default,,0,0,0,,Өзіңізге ұнамайтын нәрсені жойыңыз
Dialogue: 0,0:18:33.11,0:18:35.78,Default,,0,0,0,,Өз жолыңызды жасаңыз
Dialogue: 0,0:18:35.86,0:18:38.53,Default,,0,0,0,,Біз мұны осылай жасаймыз, солай ма?
Dialogue: 0,0:18:39.66,0:18:42.83,Default,,0,0,0,,Балалар сендер мұны бұрын да айттыңдар.
Dialogue: 0,0:18:43.58,0:18:48.12,Default,,0,0,0,,Жалғасы бар арыстан бол.
Dialogue: 0,0:18:48.21,0:18:49.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:49.92,0:18:54.00,Default,,0,0,0,,Стандарт дегеніміз не? Оған лайық болу үшін не істеуім керек?
Dialogue: 0,0:18:55.38,0:18:56.76,Default,,0,0,0,,Ол мықты жігіт.
Dialogue: 0,0:18:56.84,0:18:58.67,Default,,0,0,0,,(Китамура) Жарайды, Сатору, енді уақыты келген сияқты.
Dialogue: 0,0:18:58.76,0:19:00.47,Default,,0,0,0,,(Қауын күлкі)
Dialogue: 0,0:19:00.55,0:19:02.01,Default,,0,0,0,,Менің ойымша.
Dialogue: 0,0:19:02.76,0:19:06.27,Default,,0,0,0,,Мықты адам – еркін адам
Dialogue: 0,0:19:06.35,0:19:08.52,Default,,0,0,0,,Шұңқырдың кесірінен әлсіз
Dialogue: 0,0:19:08.60,0:19:11.77,Default,,0,0,0,,Қалағаныңды же, қалағаныңды істе
Dialogue: 0,0:19:12.35,0:19:13.27,Default,,0,0,0,,Эй
Dialogue: 0,0:19:14.06,0:19:16.82,Default,,0,0,0,,Еркін өмір сүрудің не кінәсі бар?
Dialogue: 0,0:19:16.90,0:19:19.61,Default,,0,0,0,,Бұл осы мақсат үшін кері нарық па?
Dialogue: 0,0:19:21.16,0:19:24.58,Default,,0,0,0,,Қауын – арғы базарға жарасатын шайтан.
Dialogue: 0,0:19:26.03,0:19:28.70,Default,,0,0,0,,Тек сол жерде тұрып ұйықтап жат.
Dialogue: 0,0:19:29.71,0:19:35.34,Default,,0,0,0,,Бұл жыртқыштар мен шөпқоректілердің араласуынан жасалған нағыз.
Dialogue: 0,0:19:35.42,0:19:37.00,Default,,0,0,0,,Аңдар патшасы
Dialogue: 0,0:19:37.50,0:19:41.47,Default,,0,0,0,,Уф... ха...
Dialogue: 0,0:19:42.80,0:19:44.26,Default,,0,0,0,,Гррр…
Dialogue: 0,0:19:44.34,0:19:45.10,Default,,0,0,0,,Әй?
Dialogue: 0,0:19:46.97,0:19:49.77,Default,,0,0,0,,Мен сіздің артыңыздан барамын, бастық.
Dialogue: 0,0:19:50.39,0:19:51.69,Default,,0,0,0,,Агата…
Dialogue: 0,0:19:52.77,0:19:55.73,Default,,0,0,0,,Сіз сөзсіз сынғансыз.
Dialogue: 0,0:19:55.81,0:19:58.82,Default,,0,0,0,,Бірақ мен сені бастық ете алмаймын.
Dialogue: 0,0:19:58.90,0:20:00.40,Default,,0,0,0,,Біз туралы.
Dialogue: 0,0:20:00.49,0:20:03.49,Default,,0,0,0,,Мен саған қол немесе жал беремін.
Dialogue: 0,0:20:03.57,0:20:09.12,Default,,0,0,0,,Сізбен бірге біз Шиши-гуми күшейіп, нашарлай аламыз.
Dialogue: 0,0:20:11.96,0:20:13.42,Default,,0,0,0,,Иә
Dialogue: 0,0:20:13.50,0:20:15.33,Default,,0,0,0,,Ешкім сен сияқты жынды емес.
Dialogue: 0,0:20:15.96,0:20:19.71,Default,,0,0,0,,Дұрыс, онсыз қызық емес.
Dialogue: 0,0:20:19.80,0:20:23.59,Default,,0,0,0,,Бұл сіздің келесі жұмысыңыз.
Dialogue: 0,0:20:23.68,0:20:24.55,Default,,0,0,0,,О...
Dialogue: 0,0:20:26.80,0:20:27.89,Default,,0,0,0,,Мелда?
Dialogue: 0,0:20:27.97,0:20:31.14,Default,,0,0,0,,Сіз онымен әлі ойнаған жоқсыз.
Dialogue: 0,0:20:31.23,0:20:33.60,Default,,0,0,0,,Жылы өмір сүретіндерге
Dialogue: 0,0:20:33.69,0:20:37.44,Default,,0,0,0,,Мен саған шынайы өмір сүрудің қандай екенін көрсетемін.
Dialogue: 0,0:20:37.52,0:20:40.44,Default,,0,0,0,,Оны көбірек қара түске боя!
Dialogue: 0,0:20:40.53,0:20:45.32,Default,,0,0,0,,Осы артқы базардағы қара аңдардың патшасы бол.
Dialogue: 0,0:20:45.41,0:20:46.53,Default,,0,0,0,,Шиши-гуми!
Dialogue: 0,0:20:46.62,0:20:48.62,Default,,0,0,0,,Сендер де жақсы жүрсіңдер ғой, Танихара…
Dialogue: 0,0:20:49.24,0:20:50.33,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:20:54.37,0:20:58.38,Default,,0,0,0,,(Зенitsu) Ата енді ғана пайда болып, «Таласуды қойма» деді…
Dialogue: 0,0:21:06.84,0:21:11.31,Default,,0,0,0,,Жылына бір рет бэк базардың аумағын шешу күні!
Dialogue: 0,0:21:11.39,0:21:15.19,Default,,0,0,0,,Биылғы Ай ет күніне қатысушылар...
Dialogue: 0,0:21:16.06,0:21:17.52,Default,,0,0,0,,Инар тобы!
Dialogue: 0,0:21:17.60,0:21:18.15,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:21:18.23,0:21:19.86,Default,,0,0,0,,Мадара тобы!
Dialogue: 0,0:21:19.94,0:21:20.65,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:21:20.73,0:21:22.61,Default,,0,0,0,,Құжаттар тобы!
Dialogue: 0,0:21:23.28,0:21:24.36,Default,,0,0,0,,Шишигуми ше?
Dialogue: 0,0:21:24.44,0:21:26.11,Default,,0,0,0,,Сәлем! Жолдан кет!
Dialogue: 0,0:21:26.20,0:21:27.32,Default,,0,0,0,,Бұл ыңғайсыздық!
Dialogue: 0,0:21:27.41,0:21:28.78,Default,,0,0,0,,Жол аш, жол аш, ей
Dialogue: 0,0:21:28.87,0:21:29.87,Default,,0,0,0,,Өтіп кетсін Эй!
Dialogue: 0,0:21:29.95,0:21:30.78,Default,,0,0,0,,Жолдан кет!
Dialogue: 0,0:21:30.87,0:21:32.33,Default,,0,0,0,,Оны ашыңыз! Жол!
Dialogue: 0,0:21:46.47,0:21:48.43,Default,,0,0,0,,Бұл Шиши-гумидің бастығы ма?
Dialogue: 0,0:21:48.51,0:21:49.64,Default,,0,0,0,,Аралас?
Dialogue: 0,0:21:49.72,0:21:51.10,Default,,0,0,0,,Мен оны бірінші рет көріп тұрмын.
Dialogue: 0,0:21:51.18,0:21:52.22,Default,,0,0,0,,Міне!
Dialogue: 0,0:21:58.44,0:22:01.69,Default,,0,0,0,,Сіз бұл жігітті көрдіңіз бе?
Dialogue: 0,0:22:02.48,0:22:03.78,Default,,0,0,0,,Газель?
Dialogue: 0,0:22:03.86,0:22:04.94,Default,,0,0,0,,Иә, араластырыңыз…
Dialogue: 0,0:22:05.03,0:22:08.16,Default,,0,0,0,,Сәлем Дегоши! Қауын болды!
Dialogue: 0,0:22:08.24,0:22:10.87,Default,,0,0,0,,Не? Қайда?
Dialogue: 0,0:22:11.99,0:22:13.99,Default,,0,0,0,,♪～
Dialogue: 0,0:23:39.91,0:23:41.92,Default,,0,0,0,,～♪
