Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.67,0:00:14.68,Default,,0,0,0,,♪～
Dialogue: 0,0:01:39.93,0:01:41.93,Default,,0,0,0,,～♪
Dialogue: 0,0:01:51.23,0:01:53.61,Default,,0,0,0,,Сіз ойлағаннан да көп нәрсе бар.
Dialogue: 0,0:01:53.69,0:01:56.90,Default,,0,0,0,,Легоси мұны көп айтқаны сонша, мен бұл шынымен ештеңе емес деп ойладым.
Dialogue: 0,0:01:56.99,0:01:58.20,Default,,0,0,0,,Әрине жоқ.
Dialogue: 0,0:01:58.28,0:01:59.70,Default,,0,0,0,,(Джек күледі)
Dialogue: 0,0:02:00.78,0:02:02.41,Default,,0,0,0,,Мен орта мектеп туралы аттестат аламын ба?
Dialogue: 0,0:02:02.49,0:02:03.37,Default,,0,0,0,,Иә
Dialogue: 0,0:02:04.08,0:02:07.41,Default,,0,0,0,,Инсектарийде жұмыс істеу үшін орта білім туралы аттестат қажет.
Dialogue: 0,0:02:08.29,0:02:09.96,Default,,0,0,0,,Мен бұл туралы мектептен шыққанша білмедім.
Dialogue: 0,0:02:10.58,0:02:11.50,Default,,0,0,0,,Сіз инсектарийде жұмыс істейсіз бе?
Dialogue: 0,0:02:12.13,0:02:15.80,Default,,0,0,0,,Жоқ, бұл арман. Бұл әлі арман.
Dialogue: 0,0:02:15.88,0:02:18.97,Default,,0,0,0,,көремін.
Dialogue: 0,0:02:19.76,0:02:20.84,Default,,0,0,0,,Бұл арман ма?
Dialogue: 0,0:02:23.89,0:02:26.89,Default,,0,0,0,,Әй, толған ай жақындап қалды.
Dialogue: 0,0:02:26.98,0:02:28.23,Default,,0,0,0,,Ай толған кезде
Dialogue: 0,0:02:28.31,0:02:31.69,Default,,0,0,0,,Мен Коломен жиі ойнап, оның айқайлағанына еліктеймін.
Dialogue: 0,0:02:31.77,0:02:33.65,Default,,0,0,0,,Мектеп ішінде тыйым салынған емес пе?
Dialogue: 0,0:02:33.73,0:02:35.98,Default,,0,0,0,,Еліктеңіз
Dialogue: 0,0:02:36.07,0:02:38.28,Default,,0,0,0,,Бұл өте кішкентай дауыс
Dialogue: 0,0:02:38.36,0:02:42.32,Default,,0,0,0,,Алыста жүрсеңіз де сіздің дауысыңызды естігеніңіз тыныштандырады.
Dialogue: 0,0:02:44.28,0:02:46.54,Default,,0,0,0,,Құйрық бұлғамайды
Dialogue: 0,0:02:46.62,0:02:48.20,Default,,0,0,0,,Мен оны бір күні естігім келеді.
Dialogue: 0,0:02:48.29,0:02:49.71,Default,,0,0,0,,Легосидің айқайы
Dialogue: 0,0:02:51.00,0:02:51.96,Default,,0,0,0,,Джек
Dialogue: 0,0:02:52.04,0:02:52.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:54.00,0:02:55.30,Default,,0,0,0,,Қызу!
Dialogue: 0,0:02:56.42,0:02:58.72,Default,,0,0,0,,Өзіңізді жақсы сезінбейсіз, солай ма?
Dialogue: 0,0:03:00.22,0:03:05.22,Default,,0,0,0,,Аа, мен арнайы сынып сабақтарынан біраз шаршаған шығармын.
Dialogue: 0,0:03:05.31,0:03:08.43,Default,,0,0,0,,Арнайы сынып шынымен де қатал ма?
Dialogue: 0,0:03:08.52,0:03:09.39,Default,,0,0,0,,Иә
Dialogue: 0,0:03:10.06,0:03:13.65,Default,,0,0,0,,Менің айтайын дегенім бұл қиын.
Dialogue: 0,0:03:14.40,0:03:16.44,Default,,0,0,0,,Бұл өте ерекше.
Dialogue: 0,0:03:16.52,0:03:17.57,Default,,0,0,0,,Арнайы?
Dialogue: 0,0:03:18.19,0:03:19.99,Default,,0,0,0,,Сыныптағылардың барлығы ит.
Dialogue: 0,0:03:20.07,0:03:21.11,Default,,0,0,0,,үшін?
Dialogue: 0,0:03:21.20,0:03:23.66,Default,,0,0,0,,Әрине, бұл табиғи нәрсе.
Dialogue: 0,0:03:23.74,0:03:25.16,Default,,0,0,0,,Өйткені біз иттерміз
Dialogue: 0,0:03:25.24,0:03:27.83,Default,,0,0,0,,Өйткені біз интеллектті дамыту үшін жаратылған нәсілбіз.
Dialogue: 0,0:03:27.91,0:03:31.29,Default,,0,0,0,,Бұл оқуға болады деген сөз емес пе?
Dialogue: 0,0:03:31.37,0:03:32.33,Default,,0,0,0,,Жоқ
Dialogue: 0,0:03:33.00,0:03:38.55,Default,,0,0,0,,Сабырлы, саналы, эмоцияның ықпалына түспеу
Dialogue: 0,0:03:39.88,0:03:41.30,Default,,0,0,0,,Арнайы сыныпта.
Dialogue: 0,0:03:42.22,0:03:45.60,Default,,0,0,0,,Сіз әдеттегі сабақтарда оқытылмайтын нәрселерді үйренесіз.
Dialogue: 0,0:03:46.68,0:03:50.14,Default,,0,0,0,,Қай нәсіл қай нәсілді қырғынға ұшыратты?
Dialogue: 0,0:03:50.73,0:03:52.39,Default,,0,0,0,,Жойылған
Dialogue: 0,0:03:53.56,0:03:57.40,Default,,0,0,0,,Бірақ біз ештеңе болмағандай әрекет етеміз
Dialogue: 0,0:03:57.48,0:04:01.24,Default,,0,0,0,,Дәптеріңізге көшіріп, білімдерін жинақтаңыз
Dialogue: 0,0:04:02.36,0:04:06.70,Default,,0,0,0,,Сабақ біткен соң барлығы бір-бірімен жылдам жымиып амандасады.
Dialogue: 0,0:04:07.83,0:04:10.83,Default,,0,0,0,,Өзіне берілген жұмысты ғана орындайтын робот сияқты.
Dialogue: 0,0:04:12.91,0:04:16.46,Default,,0,0,0,,Легоси ашуланып, уайымдайтын еді.
Dialogue: 0,0:04:17.17,0:04:19.09,Default,,0,0,0,,Тіпті Джек азап шегеді, солай ма?
Dialogue: 0,0:04:19.17,0:04:22.92,Default,,0,0,0,,Онда неге мен ештеңені жек көрмеймін?
Dialogue: 0,0:04:23.01,0:04:24.84,Default,,0,0,0,,Неге қашпайсың?
Dialogue: 0,0:04:24.93,0:04:26.01,Default,,0,0,0,,Өйткені бұл ит.
Dialogue: 0,0:04:26.64,0:04:28.43,Default,,0,0,0,,Өйткені ол сабырлы және ұтымды
Dialogue: 0,0:04:29.31,0:04:31.60,Default,,0,0,0,,Өйткені ол осылай жасалған.
Dialogue: 0,0:04:33.31,0:04:35.40,Default,,0,0,0,,Мен одан сайын уайымдап барамын.
Dialogue: 0,0:04:36.23,0:04:39.86,Default,,0,0,0,,Негізі мен ештеңе сезбеймін, солай ма?
Dialogue: 0,0:04:40.82,0:04:43.61,Default,,0,0,0,,Тым болмаса жылай алсам ғой
Dialogue: 0,0:04:43.70,0:04:44.65,Default,,0,0,0,,Сондықтан мен...
Dialogue: 0,0:04:44.74,0:04:47.37,Default,,0,0,0,,Сонда бұл сізде болды ма?
Dialogue: 0,0:04:47.45,0:04:48.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:49.70,0:04:50.54,Default,,0,0,0,,Иә
Dialogue: 0,0:04:51.83,0:04:56.25,Default,,0,0,0,,Мен осылайша көз жасымды төгуге мәжбүрмін.
Dialogue: 0,0:04:58.04,0:05:02.30,Default,,0,0,0,,Бұл мен үшін қазір құтқарылу.
Dialogue: 0,0:05:04.55,0:05:05.43,Default,,0,0,0,,-Ей! - Уау Джек!
Dialogue: 0,0:05:05.51,0:05:09.22,Default,,0,0,0,,Мен мұны істей алмаймын, бұл лабрадор.
Dialogue: 0,0:05:09.30,0:05:12.64,Default,,0,0,0,,Бұлай жалғаса берсе, біз бір күні ит бұйырған қоғамға айналамыз.
Dialogue: 0,0:05:13.56,0:05:16.02,Default,,0,0,0,,Бұл туралы не деуге болады? мен...
Dialogue: 0,0:05:16.94,0:05:18.73,Default,,0,0,0,,Егер сізге бұл орынды деп айтса
Dialogue: 0,0:05:18.81,0:05:22.07,Default,,0,0,0,,Олар сабырсыз кісі өлтіретін нәсіл.
Dialogue: 0,0:05:22.15,0:05:24.61,Default,,0,0,0,,Иттер қорқынышты! Мен де!
Dialogue: 0,0:05:25.53,0:05:28.20,Default,,0,0,0,,Джек ешкімді жек көре алмайды.
Dialogue: 0,0:05:28.28,0:05:30.70,Default,,0,0,0,,Ит болғандықтан емес, домкрат болғандықтан.
Dialogue: 0,0:05:30.78,0:05:31.99,Default,,0,0,0,,Джек - Джек!
Dialogue: 0,0:05:32.83,0:05:33.95,Default,,0,0,0,,(Джектің айқайы)
Dialogue: 0,0:05:34.04,0:05:35.91,Default,,0,0,0,,Неге олай дейсің?
Dialogue: 0,0:05:36.62,0:05:39.13,Default,,0,0,0,,Сіз қайдан білесіз? Мұндай нәрсе
Dialogue: 0,0:05:41.46,0:05:43.50,Default,,0,0,0,,Өйткені біз бірге өстік.
Dialogue: 0,0:05:44.05,0:05:46.51,Default,,0,0,0,,(Джектің айқайы)
Dialogue: 0,0:05:46.59,0:05:47.55,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:05:49.47,0:05:50.85,Default,,0,0,0,,Бірге?
Dialogue: 0,0:05:51.72,0:05:53.43,Default,,0,0,0,,...Бұл емес, Легоши.
Dialogue: 0,0:05:54.02,0:05:57.10,Default,,0,0,0,,Сіз мен үшін тым үлкен болып кеттіңіз, солай емес пе?
Dialogue: 0,0:05:57.81,0:06:01.02,Default,,0,0,0,,Еркін, мен білмеймін
Dialogue: 0,0:06:02.48,0:06:05.11,Default,,0,0,0,,Әй, көңіл көтер.
Dialogue: 0,0:06:06.53,0:06:09.07,Default,,0,0,0,,Мен Джектің күлгенін қалаймын.
Dialogue: 0,0:06:10.82,0:06:12.28,Default,,0,0,0,,Ах... Ах!
Dialogue: 0,0:06:12.37,0:06:16.12,Default,,0,0,0,,Идиот! Түкірік Джек! Пияз жесең өлесің!
Dialogue: 0,0:06:16.20,0:06:18.54,Default,,0,0,0,,Айтқаныңды ит тыңдайды деп ойлайсың!
Dialogue: 0,0:06:18.62,0:06:20.50,Default,,0,0,0,,Өмірің қыл үстінде тұрғанда не айтасың!
Dialogue: 0,0:06:20.58,0:06:23.75,Default,,0,0,0,,Тіпті лабрадорлардың да бүлікшіл кезеңдері болады!
Dialogue: 0,0:06:25.59,0:06:27.34,Default,,0,0,0,,Саусағыңызды салыңыз!
Dialogue: 0,0:06:27.42,0:06:29.47,Default,,0,0,0,,Дегенмен, Ол Майт—
Dialogue: 0,0:06:30.13,0:06:31.14,Default,,0,0,0,,Бәрін түкіріп таста!
Dialogue: 0,0:06:31.22,0:06:33.72,Default,,0,0,0,,(Джектің мазасыз дауысы)
Dialogue: 0,0:06:33.81,0:06:36.77,Default,,0,0,0,,Легошидің ұзын саусақтары мен өткір тырнақтары
Dialogue: 0,0:06:36.85,0:06:40.23,Default,,0,0,0,,Тамағымның артына тиіп, ауырады.
Dialogue: 0,0:06:41.31,0:06:44.02,Default,,0,0,0,,Әрқашан осылай.
Dialogue: 0,0:06:44.11,0:06:45.40,Default,,0,0,0,,онда Әйел Титанның ішіндегі адам қазір
Dialogue: 0,0:06:46.69,0:06:48.28,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:53.20,0:06:54.58,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:06:54.66,0:06:58.00,Default,,0,0,0,,Жоқ, расында, пиязды жеуге болмайды, өлесің.
Dialogue: 0,0:07:00.08,0:07:01.83,Default,,0,0,0,,Өзіңізге қамқорлық жасаңыз
Dialogue: 0,0:07:03.13,0:07:06.38,Default,,0,0,0,,Ата болсам да арманым
Dialogue: 0,0:07:06.46,0:07:11.84,Default,,0,0,0,,Бұл Джекпен осылай жылап, күлу туралы.
Dialogue: 0,0:07:12.76,0:07:16.26,Default,,0,0,0,,Сен олай демейсің, жаман қасқыр.
Dialogue: 0,0:07:17.31,0:07:19.64,Default,,0,0,0,,Маған көп қиналуға рұқсат етіңіз
Dialogue: 0,0:07:27.86,0:07:30.99,Default,,0,0,0,,(Алау)
Dialogue: 0,0:07:31.07,0:07:31.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:33.32,0:07:37.54,Default,,0,0,0,,(Алау)
Dialogue: 0,0:07:38.37,0:07:42.17,Default,,0,0,0,,(Алау)
Dialogue: 0,0:07:42.25,0:07:43.29,Default,,0,0,0,,Легоши…
Dialogue: 0,0:07:44.54,0:07:47.63,Default,,0,0,0,,(Алау)
Dialogue: 0,0:07:56.76,0:08:00.85,Default,,0,0,0,,Мелда? Енді не туралы айтып тұрсың?
Dialogue: 0,0:08:00.93,0:08:04.73,Default,,0,0,0,,Бұл маскалы түнгі кеште ашылған дәрі.
Dialogue: 0,0:08:04.81,0:08:08.02,Default,,0,0,0,,Оны Шиши-гуми осы жерден әкелгенін білеміз.
Dialogue: 0,0:08:08.11,0:08:09.90,Default,,0,0,0,,Шынында ма?
Dialogue: 0,0:08:09.98,0:08:11.94,Default,,0,0,0,,Бұл қандай дәрі?
Dialogue: 0,0:08:12.03,0:08:13.45,Default,,0,0,0,,Мен оны тыңдауға келдім.
Dialogue: 0,0:08:15.78,0:08:16.66,Default,,0,0,0,,Бұл ма?
Dialogue: 0,0:08:16.74,0:08:18.91,Default,,0,0,0,,Қалжыңдауды доғарыңыз.
Dialogue: 0,0:08:18.99,0:08:21.20,Default,,0,0,0,,Бұл арнайы Копи Лувак.
Dialogue: 0,0:08:24.25,0:08:26.21,Default,,0,0,0,,Жұмыртқа мен сүт сияқты
Dialogue: 0,0:08:26.29,0:08:29.50,Default,,0,0,0,,Жануарлар денесі арқылы түзілетін тағам
Dialogue: 0,0:08:29.59,0:08:33.51,Default,,0,0,0,,Бұл ет жегендегідей бақыт сезімін береді.
Dialogue: 0,0:08:33.59,0:08:35.55,Default,,0,0,0,,Бұл да Копи Лувак.
Dialogue: 0,0:08:40.10,0:08:41.18,Default,,0,0,0,,Хмм?
Dialogue: 0,0:08:44.06,0:08:44.60,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:08:44.69,0:08:48.27,Default,,0,0,0,,Хмм? Неліктен шөпқоректілер?
Dialogue: 0,0:08:48.36,0:08:50.69,Default,,0,0,0,,Kopi Luwak қолданбасын бірінші рет қолданып көруіңіз бе?
Dialogue: 0,0:08:50.78,0:08:51.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:51.90,0:08:55.24,Default,,0,0,0,,Жыртқыштар кейде реакция жасайды...
Dialogue: 0,0:08:55.32,0:08:59.16,Default,,0,0,0,,Еттегі қоректік заттарды сіңірген сәбіздің кесірінен бе?
Dialogue: 0,0:09:00.37,0:09:04.12,Default,,0,0,0,,Сіз кездейсоқ араласасыз ба?
Dialogue: 0,0:09:04.21,0:09:05.96,Default,,0,0,0,,Неліктен олай ойлайсың?
Dialogue: 0,0:09:06.04,0:09:07.79,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:09:08.50,0:09:11.17,Default,,0,0,0,,Сізде үлкен шешім бар -
Dialogue: 0,0:09:11.25,0:09:14.67,Default,,0,0,0,,Бір нәрсені құмарлықпен істей алады
Dialogue: 0,0:09:14.76,0:09:17.34,Default,,0,0,0,,Сондай-ақ, зорлық-зомбылық қолданудан тартынуға болмайды.
Dialogue: 0,0:09:17.43,0:09:21.43,Default,,0,0,0,,Сынға немқұрайлы қарамайды, тәкаппарлық шегіне жететін намыс бар.
Dialogue: 0,0:09:21.51,0:09:22.35,Default,,0,0,0,,Хун
Dialogue: 0,0:09:22.43,0:09:23.68,Default,,0,0,0,,Әрине, бұлар
Dialogue: 0,0:09:23.77,0:09:27.19,Default,,0,0,0,,Қоспаға қолданылады Сипаттама емес
Dialogue: 0,0:09:27.27,0:09:31.40,Default,,0,0,0,,Дегенмен, зерттеу пәндері сияқты қоспалар бар.
Dialogue: 0,0:09:31.48,0:09:32.82,Default,,0,0,0,,Қауын?
Dialogue: 0,0:09:32.90,0:09:34.28,Default,,0,0,0,,Сол уақыттан бері жағдай өзгерді ғой, иә?
Dialogue: 0,0:09:34.36,0:09:38.28,Default,,0,0,0,,Ғылыми-зерттеу мекемесі ретінде құпиялылық міндеті бар, сондықтан
Dialogue: 0,0:09:38.36,0:09:39.62,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:40.20,0:09:44.00,Default,,0,0,0,,Сонымен, жалпы алғанда, қоспаның әлсіз жақтары қандай?
Dialogue: 0,0:09:44.08,0:09:45.33,Default,,0,0,0,,(Десиконың күлкісі)
Dialogue: 0,0:09:45.41,0:09:47.04,Default,,0,0,0,,Ол жылдам допты лақтырады.
Dialogue: 0,0:09:47.12,0:09:48.54,Default,,0,0,0,,Маған айналма жолдар ұнамайды.
Dialogue: 0,0:09:48.62,0:09:49.42,Default,,0,0,0,,Менің ойымша
Dialogue: 0,0:09:50.33,0:09:53.21,Default,,0,0,0,,Бұл жай ғана жалпылау, бірақ...
Dialogue: 0,0:09:53.30,0:09:57.47,Default,,0,0,0,,Микс тәбет пен жыныстық құштарлықсыз...
Dialogue: 0,0:09:57.55,0:10:00.39,Default,,0,0,0,,Жалпы жағдай көп сияқты.
Dialogue: 0,0:10:00.47,0:10:03.51,Default,,0,0,0,,Бұл қоғамда тиімді болып көрінгенімен
Dialogue: 0,0:10:03.60,0:10:06.73,Default,,0,0,0,,Бірақ бұл қатысушы тараптар үшін қиын болуы керек.
Dialogue: 0,0:10:06.81,0:10:09.77,Default,,0,0,0,,Не жесең де тоймайды.
Dialogue: 0,0:10:10.94,0:10:14.48,Default,,0,0,0,,Мен не жесем де, тоймаймын...
Dialogue: 0,0:10:16.03,0:10:19.99,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:10:20.07,0:10:21.49,Default,,0,0,0,,Секір!
Dialogue: 0,0:10:21.57,0:10:24.41,Default,,0,0,0,,Өзін шөпқоректі жануар ретінде көрсететін қоспа
Dialogue: 0,0:10:24.49,0:10:26.54,Default,,0,0,0,,Профессор болу мүмкін емес.
Dialogue: 0,0:10:26.62,0:10:28.87,Default,,0,0,0,,Секір!
Dialogue: 0,0:10:28.96,0:10:32.04,Default,,0,0,0,,Мысық болса, құласа да өлмейді, солай ма?
Dialogue: 0,0:10:32.13,0:10:33.71,Default,,0,0,0,,Арх!
Dialogue: 0,0:10:35.25,0:10:36.30,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:10:40.55,0:10:43.01,Default,,0,0,0,,Мұны сөмкеңізде сақтаңыз.
Dialogue: 0,0:10:43.85,0:10:46.06,Default,,0,0,0,,Иә
Dialogue: 0,0:10:52.81,0:10:54.36,Default,,0,0,0,,Терезені жабыңыз.
Dialogue: 0,0:10:58.86,0:11:00.03,Default,,0,0,0,,(Харудың күші)
Dialogue: 0,0:11:00.66,0:11:01.32,Default,,0,0,0,,Мистер Хал
Dialogue: 0,0:11:01.41,0:11:02.53,Default,,0,0,0,,Иә
Dialogue: 0,0:11:03.12,0:11:04.53,Default,,0,0,0,,Өзіңіз—
Dialogue: 0,0:11:04.62,0:11:07.37,Default,,0,0,0,,Сіз бір рет өлтіріліп кете жаздадыңыз дедіңіз.
Dialogue: 0,0:11:08.50,0:11:11.12,Default,,0,0,0,,Жарайды, бұл қоян, сондықтан бұл қарапайым әңгіме.
Dialogue: 0,0:11:11.67,0:11:14.46,Default,,0,0,0,,Жыртқыштардан қорықпайсың ба?
Dialogue: 0,0:11:14.54,0:11:16.88,Default,,0,0,0,,Хмм, сен қорқып тұрсың.
Dialogue: 0,0:11:16.96,0:11:19.55,Default,,0,0,0,,Сіз басқа адамды тіпті тани алмайсыз, солай ма?
Dialogue: 0,0:11:19.63,0:11:21.34,Default,,0,0,0,,Бұл қорқынышты
Dialogue: 0,0:11:21.43,0:11:22.72,Default,,0,0,0,,Жегеннен жақсы ма?
Dialogue: 0,0:11:22.80,0:11:25.55,Default,,0,0,0,,Иә, дұрыс... Уау!
Dialogue: 0,0:11:25.64,0:11:28.39,Default,,0,0,0,,А... бұл...
Dialogue: 0,0:11:30.48,0:11:32.98,Default,,0,0,0,,Бір күні сені шынымен де жейтін болады.
Dialogue: 0,0:11:33.06,0:11:34.61,Default,,0,0,0,,Осылай десеңіз
Dialogue: 0,0:11:34.69,0:11:36.02,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:36.11,0:11:40.19,Default,,0,0,0,,Мен бәрібір өліммен бетпе-бет келсем, Махаббат үшін өмірімді қатерге тігемін.
Dialogue: 0,0:11:41.78,0:11:43.36,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:11:43.45,0:11:46.83,Default,,0,0,0,,Ой, жаңбыр қатты жауып тұр
Dialogue: 0,0:11:46.91,0:11:52.29,Default,,0,0,0,,Тіршілікті қамтамасыз ету үшін барын салатын кішкентай дене.
Dialogue: 0,0:11:53.12,0:11:56.96,Default,,0,0,0,,Пропорционалды емес ойлар санымен толтырылған
Dialogue: 0,0:11:57.46,0:11:59.92,Default,,0,0,0,,Хехе, керемет душ
Dialogue: 0,0:12:00.84,0:12:02.63,Default,,0,0,0,,Мен білгім келеді
Dialogue: 0,0:12:03.30,0:12:06.89,Default,,0,0,0,,Осы баланың сезіміне сіңген қан мен ет
Dialogue: 0,0:12:07.56,0:12:09.68,Default,,0,0,0,,Оның дәмі қандай?
Dialogue: 0,0:12:10.56,0:12:11.60,Default,,0,0,0,,(Шикі түкірікті жұтқан дыбыс)
Dialogue: 0,0:12:13.60,0:12:14.65,Default,,0,0,0,,Мен...
Dialogue: 0,0:12:16.65,0:12:18.73,Default,,0,0,0,,Мен мына баланы жегім келеді
Dialogue: 0,0:12:20.36,0:12:21.36,Default,,0,0,0,,Уф!
Dialogue: 0,0:12:24.32,0:12:26.99,Default,,0,0,0,,Сол кездегі сезім
Dialogue: 0,0:12:27.53,0:12:28.08,Default,,0,0,0,,Ха...
Dialogue: 0,0:12:28.87,0:12:30.16,Default,,0,0,0,,Гү… гүг… Дұрыс.
Dialogue: 0,0:12:30.24,0:12:32.20,Default,,0,0,0,,Мұғалім, сенің нәсілің қандай?
Dialogue: 0,0:12:32.29,0:12:33.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:33.21,0:12:37.29,Default,,0,0,0,,А, жоқ, қазір бір-бірімізді құшақтауымыз еркек пен әйелге көбірек ұқсайды.
Dialogue: 0,0:12:37.38,0:12:42.47,Default,,0,0,0,,Бұл жыртқыштың шөпқоректіні ұстап алғанына ұқсас болды...
Dialogue: 0,0:12:42.55,0:12:46.01,Default,,0,0,0,,А, мен бір рет жеп қала жаздадым, сондықтан білемін.
Dialogue: 0,0:12:46.09,0:12:48.68,Default,,0,0,0,,Өте қауіпті Қоянның күнделікті өмірі
Dialogue: 0,0:12:48.76,0:12:50.64,Default,,0,0,0,,Ал, сіз не айтқыңыз келді?
Dialogue: 0,0:12:51.52,0:12:54.81,Default,,0,0,0,,Көріп тұрғандай мен қарақұйрықпын.
Dialogue: 0,0:12:56.40,0:13:01.32,Default,,0,0,0,,Дұрыс. Бұл қарақұйрық. Бұл жыртқыш болуы мүмкін емес.
Dialogue: 0,0:13:01.40,0:13:03.40,Default,,0,0,0,,Бірақ хмм...
Dialogue: 0,0:13:03.49,0:13:05.20,Default,,0,0,0,,Олай болса, мұғалім.
Dialogue: 0,0:13:05.28,0:13:08.74,Default,,0,0,0,,Жаңа ғана мені әйел ретінде құшақтап алдың ба?
Dialogue: 0,0:13:10.16,0:13:11.58,Default,,0,0,0,,Аха…
Dialogue: 0,0:13:11.66,0:13:16.00,Default,,0,0,0,,Кешіріңіз, біз романтикалық қарым-қатынаста болғанымызға біраз болды, мен мақтан тұтамын...
Dialogue: 0,0:13:16.08,0:13:18.21,Default,,0,0,0,,Қазір маған ұнайтын бір бала бар.
Dialogue: 0,0:13:18.29,0:13:21.00,Default,,0,0,0,,Мен орта мектеппен бір мезгілде ерлермен ойнауды бітірдім...
Dialogue: 0,0:13:21.09,0:13:24.84,Default,,0,0,0,,(кескіш пышақтың дыбысы)
Dialogue: 0,0:13:27.26,0:13:28.05,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:13:28.14,0:13:31.60,Default,,0,0,0,,Хаха...
Dialogue: 0,0:13:32.31,0:13:34.27,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:13:34.35,0:13:35.31,Default,,0,0,0,,Иә...
Dialogue: 0,0:13:37.10,0:13:38.69,Default,,0,0,0,,Менің бағалы шайнегіме не істеп жатырсың?
Dialogue: 0,0:13:39.86,0:13:42.11,Default,,0,0,0,,Мен мұндай нәрсені бірінші рет жасап тұрмын
Dialogue: 0,0:13:43.57,0:13:45.36,Default,,0,0,0,,Өте ауыртпайды
Dialogue: 0,0:13:46.28,0:13:50.87,Default,,0,0,0,,Енді... Менің жүрегім одан бетер ауыратын сияқты.
Dialogue: 0,0:13:50.95,0:13:51.87,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:13:53.20,0:13:57.79,Default,,0,0,0,,Бұл күрделене түсуде.
Dialogue: 0,0:13:58.75,0:14:05.63,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:14:13.68,0:14:15.31,Default,,0,0,0,,Үздіксіз қолдау көрсеткеніңіз үшін рахмет.
Dialogue: 0,0:14:15.39,0:14:18.98,Default,,0,0,0,,Эй, отаку да, құпия мәзір бар ғой, солай ма?
Dialogue: 0,0:14:19.06,0:14:20.85,Default,,0,0,0,,Не? Мен бұл туралы ешқашан естіген емеспін ...
Dialogue: 0,0:14:20.94,0:14:23.15,Default,,0,0,0,,Маған тағы да айтыңызшы
Dialogue: 0,0:14:23.23,0:14:25.32,Default,,0,0,0,,Ет удон, оякодон, т.б.
Dialogue: 0,0:14:25.40,0:14:26.86,Default,,0,0,0,,Ондай нәрсе жоқ.
Dialogue: 0,0:14:26.94,0:14:29.20,Default,,0,0,0,,Сіздің үрейіңіз күдікті.
Dialogue: 0,0:14:29.28,0:14:31.53,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:14:32.32,0:14:33.62,Default,,0,0,0,,№.
Dialogue: 0,0:14:33.70,0:14:36.37,Default,,0,0,0,,Мен ертең арғы базардан қой етін аламын.
Dialogue: 0,0:14:36.45,0:14:39.50,Default,,0,0,0,,Мен сені қуантамын ет удон кеспе.
Dialogue: 0,0:14:39.58,0:14:41.38,Default,,0,0,0,,Сіз бақыттысыз ба...
Dialogue: 0,0:14:42.54,0:14:45.05,Default,,0,0,0,,Мен тым талғампазмын ба?
Dialogue: 0,0:14:45.13,0:14:46.67,Default,,0,0,0,,Мазасыз қасқыр-күн
Dialogue: 0,0:14:48.05,0:14:52.22,Default,,0,0,0,,Яхья-сан! А... қазір аяқтарыңыз жақсы емес пе?
Dialogue: 0,0:14:52.30,0:14:54.14,Default,,0,0,0,,Қауынды таптыңыз ба?
Dialogue: 0,0:14:54.89,0:14:56.39,Default,,0,0,0,,Неге ол бізді өзінен алыстатқысы келеді?
Dialogue: 0,0:14:56.47,0:15:00.14,Default,,0,0,0,,Әзірге оның маскасын қайтарып алайық.
Dialogue: 0,0:15:00.23,0:15:03.19,Default,,0,0,0,,Ах... Кешіріңіз.
Dialogue: 0,0:15:03.27,0:15:08.19,Default,,0,0,0,,Сіз оны теңізге тастадыңыз ба? Дәлірек айтқанда, ол тасталды ...
Dialogue: 0,0:15:08.28,0:15:11.16,Default,,0,0,0,,Сіз Қауынмен кездестіңіз.
Dialogue: 0,0:15:13.20,0:15:15.99,Default,,0,0,0,,Сіз қауын мәселесінен бас тартатыныңызды айттыңыз...
Dialogue: 0,0:15:16.58,0:15:18.29,Default,,0,0,0,,Тағы бірдеңе болды ма?
Dialogue: 0,0:15:18.37,0:15:21.87,Default,,0,0,0,,Қауынмен дос бола алдыңыз ба?
Dialogue: 0,0:15:22.58,0:15:23.50,Default,,0,0,0,,Бұл жақсы болмады.
Dialogue: 0,0:15:24.34,0:15:25.59,Default,,0,0,0,,Мен аңғал болдым.
Dialogue: 0,0:15:25.67,0:15:27.34,Default,,0,0,0,,Келесі, мына жігіт
Dialogue: 0,0:15:28.09,0:15:32.18,Default,,0,0,0,,Нағыз зұлымдық бар екенін түсіндім.
Dialogue: 0,0:15:33.43,0:15:35.05,Default,,0,0,0,,Бұл өте қорқынышты болды!
Dialogue: 0,0:15:35.85,0:15:36.97,Default,,0,0,0,,Әлі де қорқынышты
Dialogue: 0,0:15:37.68,0:15:40.48,Default,,0,0,0,,Өлмейтін Легоси қорқынышты ма?
Dialogue: 0,0:15:41.89,0:15:45.23,Default,,0,0,0,,Бұл көздер менің өлгенімді көргенде ләззат алады
Dialogue: 0,0:15:45.98,0:15:49.57,Default,,0,0,0,,Ол жерде ашық қызыл жалын жанып тұрды.
Dialogue: 0,0:15:50.86,0:15:52.70,Default,,0,0,0,,Мен бұл жалынды білемін
Dialogue: 0,0:15:53.28,0:15:57.49,Default,,0,0,0,,Ет жегенде, Жаман аңды ұрғанда —
Dialogue: 0,0:15:59.50,0:16:01.08,Default,,0,0,0,,Менде де болды
Dialogue: 0,0:16:02.46,0:16:04.33,Default,,0,0,0,,Менің де ішімде қауын бар
Dialogue: 0,0:16:04.96,0:16:07.09,Default,,0,0,0,,Сондықтан мен қорқамын
Dialogue: 0,0:16:08.46,0:16:11.09,Default,,0,0,0,,Бұл қауынның сұмдығы ма?
Dialogue: 0,0:16:11.80,0:16:13.34,Default,,0,0,0,,Мен сені енді көргім келмейді
Dialogue: 0,0:16:14.64,0:16:15.97,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:16:16.64,0:16:18.72,Default,,0,0,0,,Менің маскамды жоғалтқаным үшін кешірім сұраймын.
Dialogue: 0,0:16:18.81,0:16:20.60,Default,,0,0,0,,Сіз дайынсыз ба?
Dialogue: 0,0:16:21.56,0:16:23.39,Default,,0,0,0,,Үйге бармасаң, жалақың азаяды.
Dialogue: 0,0:16:23.48,0:16:26.06,Default,,0,0,0,,Аа, мен сіздің сөзіңізді бөлдім.
Dialogue: 0,0:16:36.57,0:16:37.53,Default,,0,0,0,,Мен...
Dialogue: 0,0:16:38.16,0:16:42.62,Default,,0,0,0,,Ішімдегі аңнан осылай қорқып кете берем бе?
Dialogue: 0,0:16:46.79,0:16:47.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:48.63,0:16:49.67,Default,,0,0,0,,Капитан Магатоға не деп тұрсың!!
Dialogue: 0,0:16:49.75,0:16:52.59,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:16:55.26,0:16:55.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:56.01,0:16:59.05,Default,,0,0,0,,Әй, ақыры қайттің, жаман қасқыр.
Dialogue: 0,0:16:59.14,0:17:00.56,Default,,0,0,0,,Күтуден шаршадым.
Dialogue: 0,0:17:00.64,0:17:02.43,Default,,0,0,0,,А... Аха...
Dialogue: 0,0:17:04.56,0:17:06.69,Default,,0,0,0,,Мазалағаным үшін кешіріңіз
Dialogue: 0,0:17:07.44,0:17:10.98,Default,,0,0,0,,Иә, бұл таңқаларлық өмірге ұқсайды, иә?
Dialogue: 0,0:17:11.07,0:17:11.78,Default,,0,0,0,,Хмм?
Dialogue: 0,0:17:11.86,0:17:15.20,Default,,0,0,0,,Ах, Минт, сен дұрыс өсіп жатырсың.
Dialogue: 0,0:17:15.28,0:17:16.20,Default,,0,0,0,,Ойласам, біз ұзақ уақыт сөйлеспеген сияқтымыз
Dialogue: 0,0:17:16.28,0:17:16.91,Default,,0,0,0,,Хару-чан, сен бұл мұрынды алдай алмайсың.
Dialogue: 0,0:17:16.91,0:17:20.08,Default,,0,0,0,,Хару-чан, сен бұл мұрынды алдай алмайсың.
Dialogue: 0,0:17:16.91,0:17:20.08,Default,,0,0,0,,А, бірақ сен маған тек су бердің.
Dialogue: 0,0:17:20.87,0:17:23.62,Default,,0,0,0,,Бүгін бір адамды құшақтап алдың.
Dialogue: 0,0:17:23.70,0:17:26.08,Default,,0,0,0,,Қайда және кім?
Dialogue: 0,0:17:26.17,0:17:28.13,Default,,0,0,0,,Мен саған келесі жолы тыңайтқыш әкелемін.
Dialogue: 0,0:17:28.21,0:17:30.71,Default,,0,0,0,,Әй, жаңбыр жауғандықтан айта алмаймын!
Dialogue: 0,0:17:31.50,0:17:32.50,Default,,0,0,0,,Эй, Легоши-кун
Dialogue: 0,0:17:32.59,0:17:33.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:33.67,0:17:36.09,Default,,0,0,0,,Пойыз жоқ, мен түнеймін.
Dialogue: 0,0:17:36.18,0:17:38.14,Default,,0,0,0,,О, не?
Dialogue: 0,0:17:38.22,0:17:39.85,Default,,0,0,0,,Бір түнде қалу... А?
Dialogue: 0,0:17:40.35,0:17:41.93,Default,,0,0,0,,Хехе, жарайды.
Dialogue: 0,0:17:42.01,0:17:44.85,Default,,0,0,0,,Мен тек тіс щеткамды әкелдім.
Dialogue: 0,0:17:46.06,0:17:47.90,Default,,0,0,0,,Аха…
Dialogue: 0,0:17:48.40,0:17:49.86,Default,,0,0,0,,(шай ішкен дыбыс)
Dialogue: 0,0:17:49.94,0:17:51.94,Default,,0,0,0,,Бұл шай дәмді.
Dialogue: 0,0:17:54.28,0:17:55.07,Default,,0,0,0,,Хару-чан
Dialogue: 0,0:17:55.15,0:17:55.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:55.78,0:17:57.65,Default,,0,0,0,,Мен бар күшімді салып, сол екі команданың ұпайларын жұлып аламын!
Dialogue: 0,0:17:58.99,0:18:02.83,Default,,0,0,0,,Бұл... қызық па? Кампус өмірі
Dialogue: 0,0:18:02.91,0:18:04.91,Default,,0,0,0,,Мен туралы не нәрсеге күмәнданасыз?
Dialogue: 0,0:18:05.00,0:18:07.37,Default,,0,0,0,,А, жоқ, сіз жай ғана сұрадыңыз.
Dialogue: 0,0:18:07.46,0:18:09.08,Default,,0,0,0,,Сіз бұл сұрақты құйрығыңызды көтеріп қоясыз ба?
Dialogue: 0,0:18:09.17,0:18:12.84,Default,,0,0,0,,А... жоқ, мен жай ғана колледжді айтамын...
Dialogue: 0,0:18:12.92,0:18:15.34,Default,,0,0,0,,Өйткені бейнеде ерлер мен әйелдердің өзара әрекеттесуі белсендірек болады...
Dialogue: 0,0:18:16.09,0:18:18.63,Default,,0,0,0,,Сәлем, Легоси-кун.
Dialogue: 0,0:18:18.72,0:18:20.55,Default,,0,0,0,,Әйелді еш нәрсеге мәжбүрлемей, тежеуге тырысу.
Dialogue: 0,0:18:20.64,0:18:22.18,Default,,0,0,0,,Сіз тым аңғалсыз.
Dialogue: 0,0:18:22.26,0:18:24.97,Default,,0,0,0,,Мен сені сүйетініңді және тағы басқаларды күттім!
Dialogue: 0,0:18:25.06,0:18:28.23,Default,,0,0,0,,Иә, бұл өте қауіпті.
Dialogue: 0,0:18:28.31,0:18:30.94,Default,,0,0,0,,Физикалық, әлеуметтік және экономикалық
Dialogue: 0,0:18:31.02,0:18:33.82,Default,,0,0,0,,Аа~ Сіз білетіндей не айтып тұрсыз?
Dialogue: 0,0:18:33.90,0:18:34.61,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:18:35.57,0:18:39.03,Default,,0,0,0,,Жалпы айтқанда, физикалық...
Dialogue: 0,0:18:39.11,0:18:40.49,Default,,0,0,0,,Мен әлі білмеймін.
Dialogue: 0,0:18:40.57,0:18:41.32,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:18:42.07,0:18:46.25,Default,,0,0,0,,Сіз мұны істеп көрмейінше, мұны істей аласыз ба, жоқ па білмейсіз.
Dialogue: 0,0:18:46.33,0:18:47.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:47.25,0:18:49.75,Default,,0,0,0,,Мен Легошиге қарауым керек
Dialogue: 0,0:18:49.83,0:18:51.75,Default,,0,0,0,,Бұл не рух?
Dialogue: 0,0:18:51.83,0:18:52.75,Default,,0,0,0,,Бұл өтірік емес пе?
Dialogue: 0,0:18:52.84,0:18:54.38,Default,,0,0,0,,Бұл өтірік емес
Dialogue: 0,0:18:54.46,0:18:55.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:55.30,0:18:57.46,Default,,0,0,0,,Маған көрсетші, Легоси-кун.
Dialogue: 0,0:18:58.09,0:18:59.30,Default,,0,0,0,,Мені өзімшілдікпен тыңда
Dialogue: 0,0:18:59.93,0:19:02.43,Default,,0,0,0,,Легоси-кун, сен мені кез келген уақытта жей аласың...
Dialogue: 0,0:19:02.51,0:19:05.22,Default,,0,0,0,,Бүгін түнде мен Легоси-кунды жеймін.
Dialogue: 0,0:19:07.77,0:19:09.69,Default,,0,0,0,,Ах... ой!
Dialogue: 0,0:19:10.64,0:19:12.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:13.23,0:19:14.06,Default,,0,0,0,,Иә...
Dialogue: 0,0:19:14.15,0:19:14.90,Default,,0,0,0,,Хару-чан
Dialogue: 0,0:19:15.90,0:19:20.70,Default,,0,0,0,,Мен саған ғашық болған күннен бері осыны ойлап келемін.
Dialogue: 0,0:19:23.41,0:19:27.20,Default,,0,0,0,,Мен ұрғашы қоян болсам, ал сен еркек қасқыр болсаң—
Dialogue: 0,0:19:28.29,0:19:31.62,Default,,0,0,0,,Мені сенің қолыңнан ұстап, жесең...
Dialogue: 0,0:19:32.12,0:19:34.38,Default,,0,0,0,,Қаншалықты жақсы болса да
Dialogue: 0,0:19:35.63,0:19:36.88,Default,,0,0,0,,Хмм…
Dialogue: 0,0:19:37.42,0:19:38.71,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:19:39.21,0:19:41.05,Default,,0,0,0,,Ол шынымен де осындай.
Dialogue: 0,0:19:41.13,0:19:42.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:42.63,0:19:45.60,Default,,0,0,0,,Бұл кешірім сұраудың қажеті жоқ деп ойлаймын.
Dialogue: 0,0:19:46.60,0:19:48.93,Default,,0,0,0,,Маған дұрыс көрсеткеніңізге қуаныштымын.
Dialogue: 0,0:19:49.81,0:19:51.23,Default,,0,0,0,,Себебі мен сені қабылдамады деп ойладым.
Dialogue: 0,0:19:54.98,0:19:57.65,Default,,0,0,0,,Бұл бөлме жақсы тазаланбаған.
Dialogue: 0,0:19:59.11,0:20:03.24,Default,,0,0,0,,Мен және Хару-чанның шаштары ауада жарқырап тұр...
Dialogue: 0,0:20:03.32,0:20:05.37,Default,,0,0,0,,Бұл шынайы емес сияқты.
Dialogue: 0,0:20:06.58,0:20:08.49,Default,,0,0,0,,Мәселелерді араластыру
Dialogue: 0,0:20:08.58,0:20:11.46,Default,,0,0,0,,Әр түрлі нәсілдер арасындағы некелер бақытсыздыққа ұшырайды делінеді ме?
Dialogue: 0,0:20:12.04,0:20:14.46,Default,,0,0,0,,Дүниелік әңгімені бір жаққа қой.
Dialogue: 0,0:20:14.54,0:20:18.50,Default,,0,0,0,,Бұл бөлмеде ғаламға ешкім қол тигізе алмайды, тек екеуі ғана.
Dialogue: 0,0:20:19.17,0:20:21.59,Default,,0,0,0,,Сіз осындасыз...
Dialogue: 0,0:20:21.67,0:20:23.05,Default,,0,0,0,,Әй, бұл не болды?
Dialogue: 0,0:20:23.13,0:20:25.14,Default,,0,0,0,,Ах! Енді түсіндім, сонда
Dialogue: 0,0:20:25.22,0:20:26.18,Default,,0,0,0,,Бұл да
Dialogue: 0,0:20:26.26,0:20:28.26,Default,,0,0,0,,А... мен құладым.
Dialogue: 0,0:20:28.35,0:20:30.39,Default,,0,0,0,,Ер адамның құлағаны 80% өтірік
Dialogue: 0,0:20:30.47,0:20:32.10,Default,,0,0,0,,Сізде көптеген басқа жарақаттар бар, солай ма?
Dialogue: 0,0:20:32.18,0:20:33.69,Default,,0,0,0,,Ах...хехехе...
Dialogue: 0,0:20:33.77,0:20:35.40,Default,,0,0,0,,Легоши мырза
Dialogue: 0,0:20:36.06,0:20:40.69,Default,,0,0,0,,Өйткені, бұл тамаша жыртқыш және қасқыр.
Dialogue: 0,0:20:40.78,0:20:43.45,Default,,0,0,0,,Зорлық-зомбылық жасау немесе қауіпті көпірден өтуге тырысу оңай.
Dialogue: 0,0:20:43.53,0:20:44.74,Default,,0,0,0,,Бұл инстинкт.
Dialogue: 0,0:20:44.82,0:20:45.86,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:45.95,0:20:47.37,Default,,0,0,0,,Бұл туралы ештеңе істей алмаймыз.
Dialogue: 0,0:20:48.37,0:20:51.29,Default,,0,0,0,,Бірақ бұл инстинкт балаға ұқсай бастады!
Dialogue: 0,0:20:51.37,0:20:51.91,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:56.58,0:21:00.59,Default,,0,0,0,,Бұдан былай мен Легосидің өмірін ересек етуді жалғастырамын.
Dialogue: 0,0:21:01.67,0:21:04.59,Default,,0,0,0,,Әр уақытта, бірте-бірте
Dialogue: 0,0:21:05.09,0:21:06.55,Default,,0,0,0,,Хехе, саған ұнамайды ма?
Dialogue: 0,0:21:08.89,0:21:10.31,Default,,0,0,0,,Маған ұнамайды.
Dialogue: 0,0:21:10.97,0:21:12.27,Default,,0,0,0,,Жақсы
Dialogue: 0,0:21:13.43,0:21:15.14,Default,,0,0,0,,Бір-біріміз туралы не білеміз
Dialogue: 0,0:21:16.06,0:21:18.48,Default,,0,0,0,,Бұдан былай бір-бірімізді бірте-бірте көрсетуіміз керек.
Dialogue: 0,0:21:19.90,0:21:21.78,Default,,0,0,0,,Мен бүгін түнде тым алыс секірдім деп ойлаймын.
Dialogue: 0,0:21:21.86,0:21:23.90,Default,,0,0,0,,Хехе, солай деп ойлаймын.
Dialogue: 0,0:21:24.86,0:21:27.41,Default,,0,0,0,,үшін - барлығы
Dialogue: 0,0:21:29.07,0:21:31.08,Default,,0,0,0,,Легоши-кунның тірі болған дыбысы
Dialogue: 0,0:21:32.08,0:21:35.12,Default,,0,0,0,,Бұл екеуің де білмейтін нәрсе ме?
Dialogue: 0,0:21:36.00,0:21:37.12,Default,,0,0,0,,Жоқ
Dialogue: 0,0:21:38.04,0:21:39.67,Default,,0,0,0,,Сіз көп білетін бөлім
Dialogue: 0,0:21:50.43,0:21:53.06,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:55.60,0:21:56.52,Default,,0,0,0,,Иә...
Dialogue: 0,0:21:59.40,0:22:00.19,Default,,0,0,0,,Хмм...
Dialogue: 0,0:22:02.61,0:22:03.48,Default,,0,0,0,,Хару-чан...
Dialogue: 0,0:22:11.99,0:22:13.99,Default,,0,0,0,,♪～
Dialogue: 0,0:23:39.91,0:23:41.92,Default,,0,0,0,,～♪
