Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.67,0:00:14.68,Default,,0,0,0,,♪～
Dialogue: 0,0:01:39.93,0:01:41.93,Default,,0,0,0,,～♪
Dialogue: 0,0:01:48.60,0:01:50.90,Default,,0,0,0,,(Легоши ұйқысы)
Dialogue: 0,0:01:53.78,0:01:57.99,Default,,0,0,0,,(Легоши ұйқысы)
Dialogue: 0,0:02:00.53,0:02:03.12,Default,,0,0,0,,Бұл зертхана мүшелерінің жиналысы.
Dialogue: 0,0:02:04.62,0:02:05.62,Default,,0,0,0,,Фалько…
Dialogue: 0,0:02:06.75,0:02:07.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:10.04,0:02:11.25,Default,,0,0,0,,Хару-чан...
Dialogue: 0,0:02:12.67,0:02:13.63,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:02:14.13,0:02:15.21,Default,,0,0,0,,Хаа…
Dialogue: 0,0:02:16.59,0:02:17.72,Default,,0,0,0,,Хмм.
Dialogue: 0,0:02:19.01,0:02:19.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:28.06,0:02:29.06,Default,,0,0,0,,Ха…
Dialogue: 0,0:02:35.19,0:02:39.49,Default,,0,0,0,,(Жүректің соғу дыбысы)
Dialogue: 0,0:02:39.57,0:02:41.49,Default,,0,0,0,,Ах... а
Dialogue: 0,0:02:43.70,0:02:44.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:45.33,0:02:47.08,Default,,0,0,0,,Бұл арман
Dialogue: 0,0:02:48.33,0:02:49.66,Default,,0,0,0,,Арман болсын
Dialogue: 0,0:02:50.54,0:02:51.83,Default,,0,0,0,,Хару-чан...
Dialogue: 0,0:02:53.25,0:02:55.17,Default,,0,0,0,,меніңше, бұл – нағыз ақымақтық шыңы… Яғни—
Dialogue: 0,0:02:55.25,0:02:57.42,Default,,0,0,0,,(жүрек соғуының үздіксіз дыбысы)
Dialogue: 0,0:02:57.51,0:02:58.63,Default,,0,0,0,,Қал...
Dialogue: 0,0:03:00.17,0:03:01.26,Default,,0,0,0,,Бұл шындық.
Dialogue: 0,0:03:03.93,0:03:06.64,Default,,0,0,0,,Ақымақ! Неге...
Dialogue: 0,0:03:07.85,0:03:09.06,Default,,0,0,0,,Неге...
Dialogue: 0,0:03:09.14,0:03:13.69,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:03:18.61,0:03:19.90,Default,,0,0,0,,Хару-чан
Dialogue: 0,0:03:21.24,0:03:22.41,Default,,0,0,0,,Хару-чан...
Dialogue: 0,0:03:25.16,0:03:26.24,Default,,0,0,0,,Хару-чан...
Dialogue: 0,0:03:32.17,0:03:33.37,Default,,0,0,0,,Хару-чан
Dialogue: 0,0:03:34.50,0:03:36.92,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:03:37.00,0:03:37.96,Default,,0,0,0,,Е...
Dialogue: 0,0:03:39.01,0:03:42.30,Default,,0,0,0,,Мен жастайымнан өзімді бастым.
Dialogue: 0,0:03:42.38,0:03:45.39,Default,,0,0,0,,Мен көлеңкеде тыныш өмір сүрдім.
Dialogue: 0,0:03:46.05,0:03:49.60,Default,,0,0,0,,Мен сені мөрмен басып тастауым керек еді.
Dialogue: 0,0:03:50.10,0:03:50.93,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:51.02,0:03:53.10,Default,,0,0,0,,Сіздің сүйікті қауыныңыз
Dialogue: 0,0:03:53.19,0:03:55.61,Default,,0,0,0,,Сіз оны мен үшін аштыңыз.
Dialogue: 0,0:03:55.69,0:03:59.73,Default,,0,0,0,,Қарғыс атсын, анау көздің түбінде жанып тұрған от.
Dialogue: 0,0:04:00.90,0:04:02.53,Default,,0,0,0,,Мен қорықтым...
Dialogue: 0,0:04:04.78,0:04:07.66,Default,,0,0,0,,Өзіңізден бас тартпаңыз
Dialogue: 0,0:04:08.24,0:04:12.29,Default,,0,0,0,,Қайғылы ма? Әлде көңілсіздеу ме?
Dialogue: 0,0:04:13.00,0:04:18.17,Default,,0,0,0,,Олардың бәрі әртүрлі, түйсігің бақытты.
Dialogue: 0,0:04:18.25,0:04:20.46,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:04:21.17,0:04:22.76,Default,,0,0,0,,Уф, жоқ!
Dialogue: 0,0:04:23.30,0:04:26.09,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:04:31.47,0:04:35.73,Default,,0,0,0,,үшін… аяқталды.
Dialogue: 0,0:04:37.73,0:04:39.48,Default,,0,0,0,,Мен сені енді көре алмаймын
Dialogue: 0,0:04:40.02,0:04:42.78,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:04:44.32,0:04:45.66,Default,,0,0,0,,(есіктің ашылуы/аяқ дыбысы)
Dialogue: 0,0:04:45.74,0:04:49.78,Default,,0,0,0,,Аа, кешіріңіз, кешіріңіз, мен оны кейінірек жууды жоспарлап едім.
Dialogue: 0,0:04:50.79,0:04:51.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:51.54,0:04:54.46,Default,,0,0,0,,Мен сонда тұрған қызанақ шырынын алғым келді.
Dialogue: 0,0:04:54.54,0:04:56.21,Default,,0,0,0,,Мен оны төгіп тастадым.
Dialogue: 0,0:04:56.29,0:04:57.50,Default,,0,0,0,,Ха...Хару-чан
Dialogue: 0,0:04:58.33,0:04:59.71,Default,,0,0,0,,Томат шырыны...?
Dialogue: 0,0:04:59.79,0:05:01.34,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:05:01.42,0:05:03.84,Default,,0,0,0,,Менің мұрным шоктан ақымақ болып көрінеді.
Dialogue: 0,0:05:03.92,0:05:05.80,Default,,0,0,0,,Не? не болды?
Dialogue: 0,0:05:12.39,0:05:15.69,Default,,0,0,0,,Не болды, Легоси-кун? Сіз қорқынышты түс көрдіңіз бе?
Dialogue: 0,0:05:16.89,0:05:18.23,Default,,0,0,0,,Сол Титан
Dialogue: 0,0:05:19.15,0:05:20.69,Default,,0,0,0,,Бұл шынайы болды
Dialogue: 0,0:05:21.77,0:05:24.82,Default,,0,0,0,,Бұл шынымен қорқынышты шындық болды.
Dialogue: 0,0:05:26.03,0:05:26.95,Default,,0,0,0,,Дұрыс айтасың — ол әдеттегіден де көп әуре-сарсаңға түсіп жүр.
Dialogue: 0,0:05:28.87,0:05:31.12,Default,,0,0,0,,Мен таңғы ас сатып алдым.
Dialogue: 0,0:05:32.62,0:05:34.12,Default,,0,0,0,,(Харудың күлкісі)
Dialogue: 0,0:05:35.12,0:05:37.50,Default,,0,0,0,,Ал, йогурт пен нан.
Dialogue: 0,0:05:37.58,0:05:40.25,Default,,0,0,0,,Қайсысы жақсы, құлпынай немесе алоэ йогурты?
Dialogue: 0,0:05:41.00,0:05:43.50,Default,,0,0,0,,Маған құлпынай ұнайды...
Dialogue: 0,0:05:44.26,0:05:47.34,Default,,0,0,0,,Хаа... Жақсы.
Dialogue: 0,0:05:47.43,0:05:50.68,Default,,0,0,0,,Жарайсың ба? Ал, Легоси-кун, алоэ, иә.
Dialogue: 0,0:05:50.76,0:05:55.89,Default,,0,0,0,,Шынайы әлемде ғажайыптар бізбен жалғасуда.
Dialogue: 0,0:05:55.98,0:05:56.77,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:05:56.85,0:06:00.31,Default,,0,0,0,,Мен Хару-чанды жеуді армандайтыным сияқты
Dialogue: 0,0:06:00.40,0:06:02.11,Default,,0,0,0,,Хару-чан бұл сөзсіз
Dialogue: 0,0:06:02.19,0:06:04.86,Default,,0,0,0,,Менің жегенімді армандаған шығарсың.
Dialogue: 0,0:06:05.74,0:06:09.91,Default,,0,0,0,,Сонда да сен маған йогурт сатып алдың
Dialogue: 0,0:06:09.99,0:06:13.49,Default,,0,0,0,,Ол маған таңғы ас ішуімді сұрайды, бұл түсінікті.
Dialogue: 0,0:06:14.54,0:06:18.50,Default,,0,0,0,,Сіз үлкен тәуекелге барасыз.
Dialogue: 0,0:06:19.17,0:06:21.96,Default,,0,0,0,,Сіз менің серіктесім болғандықтан жалғасады.
Dialogue: 0,0:06:22.71,0:06:24.63,Default,,0,0,0,,-Хару-чан! -Уау
Dialogue: 0,0:06:25.34,0:06:29.43,Default,,0,0,0,,Біз міндетті түрде үйленеміз!
Dialogue: 0,0:06:29.51,0:06:32.64,Default,,0,0,0,,Балалы болып, бірге өмір сүріңіз
Dialogue: 0,0:06:32.72,0:06:36.27,Default,,0,0,0,,Қанша қобалжысам да, қорқынышты түс көрсем де,
Dialogue: 0,0:06:36.35,0:06:39.19,Default,,0,0,0,,Таңертең оянғанда, дастархан басында йогурт таңдауды ұмытпаңыз.
Dialogue: 0,0:06:39.98,0:06:43.73,Default,,0,0,0,,Мәңгілік бақытты отбасын құрайық Бақытты болайық!
Dialogue: 0,0:06:43.82,0:06:46.19,Default,,0,0,0,,Ух...иә
Dialogue: 0,0:06:47.19,0:06:51.24,Default,,0,0,0,,Олай болса, менің де өтінішім бар.
Dialogue: 0,0:06:51.32,0:06:52.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:52.70,0:06:56.37,Default,,0,0,0,,Биылғы метеорит фестиваліне бірге барайық.
Dialogue: 0,0:06:57.79,0:06:59.00,Default,,0,0,0,,Метеорит фестивалі?
Dialogue: 0,0:06:59.08,0:07:00.92,Default,,0,0,0,,Өйткені былтыр бұл мүмкін емес еді.
Dialogue: 0,0:07:01.62,0:07:05.00,Default,,0,0,0,,Ендеше бәріміз бірге шам жақайық.
Dialogue: 0,0:07:06.05,0:07:07.09,Default,,0,0,0,,Сен сияқты — олардың әрқайсысы.
Dialogue: 0,0:07:13.30,0:07:15.47,Default,,0,0,0,,Мен Хару-чанға міндетті түрде үйленемін
Dialogue: 0,0:07:16.22,0:07:20.81,Default,,0,0,0,,Ол үшін Яхья-санға берген уәдемді орындауым керек.
Dialogue: 0,0:07:23.44,0:07:25.48,Default,,0,0,0,,Қауынды ұстаңыз!
Dialogue: 0,0:07:31.99,0:07:36.83,Default,,0,0,0,,Қауын жігіті Хиноның атын да есіме түсірмедім.
Dialogue: 0,0:07:37.74,0:07:39.20,Default,,0,0,0,,Ол үшін
Dialogue: 0,0:07:39.29,0:07:42.17,Default,,0,0,0,,Менің ойымша, біз мүшелер жай ғана пешкалармыз.
Dialogue: 0,0:07:42.25,0:07:44.21,Default,,0,0,0,,(Сота) Жарайды. (Есіктің ашылып, жабылуының дыбысы)
Dialogue: 0,0:07:45.54,0:07:46.54,Default,,0,0,0,,Хино мырза
Dialogue: 0,0:07:47.42,0:07:49.13,Default,,0,0,0,,Сізде арыстанның жалы бар
Dialogue: 0,0:07:49.21,0:07:51.55,Default,,0,0,0,,Мен оған лайықты өлімді бергім келді.
Dialogue: 0,0:07:52.59,0:07:54.47,Default,,0,0,0,,(қиғыштың жұмыс дыбысы)
Dialogue: 0,0:07:54.55,0:07:55.76,Default,,0,0,0,,Эй, сен не істеп жатырсың?
Dialogue: 0,0:07:55.85,0:07:58.31,Default,,0,0,0,,Мен аяныштымын.
Dialogue: 0,0:07:58.39,0:08:01.39,Default,,0,0,0,,Достарың өлтірілсе де қауын жігіттің соңынан еріңдер
Dialogue: 0,0:08:01.48,0:08:03.10,Default,,0,0,0,,Аңдардың патшасы қандай!
Dialogue: 0,0:08:03.19,0:08:04.23,Default,,0,0,0,,Тоқта, тоқта!
Dialogue: 0,0:08:04.31,0:08:05.31,Default,,0,0,0,,Тоқтамаңыз!
Dialogue: 0,0:08:05.40,0:08:07.69,Default,,0,0,0,,-Тоқта -Менде мынандай жал бар
Dialogue: 0,0:08:07.77,0:08:09.69,Default,,0,0,0,,Біз бәріміз сондаймыз.
Dialogue: 0,0:08:09.78,0:08:10.65,Default,,0,0,0,,Мен бұл ауыртпалық екенін білемін.
Dialogue: 0,0:08:10.74,0:08:11.99,Default,,0,0,0,,Ол саған айтты!
Dialogue: 0,0:08:12.07,0:08:14.66,Default,,0,0,0,,«Себебі мен арыстан болып тудым».
Dialogue: 0,0:08:14.74,0:08:16.24,Default,,0,0,0,,«Бір күні жал саған жақсы көрінеді...»
Dialogue: 0,0:08:16.32,0:08:18.49,Default,,0,0,0,,«Сен аңдардың нағыз патшасы болғың келеді, солай ма?»
Dialogue: 0,0:08:18.58,0:08:21.62,Default,,0,0,0,,Дұрыс, бір күні ол сізге шынымен сәйкес келеді.
Dialogue: 0,0:08:21.70,0:08:23.46,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:08:24.21,0:08:26.63,Default,,0,0,0,,Бірақ... Хино мырза
Dialogue: 0,0:08:28.09,0:08:32.88,Default,,0,0,0,,Осылай жалғаса берсе, менің манағым өмір бойы ыстық әшекей болып қала береді.
Dialogue: 0,0:08:34.34,0:08:36.76,Default,,0,0,0,,Мен қауындарды кешіре алмаймын
Dialogue: 0,0:08:36.84,0:08:39.01,Default,,0,0,0,,Ол Шиши тобында емес!
Dialogue: 0,0:08:39.68,0:08:41.14,Default,,0,0,0,,Бастықтан құтылғыңыз келе ме?
Dialogue: 0,0:08:41.22,0:08:44.06,Default,,0,0,0,,Сіз мұны істей алмайсыз ба?
Dialogue: 0,0:08:44.14,0:08:49.40,Default,,0,0,0,,Бастықсыз келесі айдағы шымтезек соғысы туралы не істейміз?
Dialogue: 0,0:08:49.48,0:08:51.03,Default,,0,0,0,,«Махаббат ет күні»?
Dialogue: 0,0:08:51.11,0:08:53.57,Default,,0,0,0,,Мен Луи қайтып келсе екен.
Dialogue: 0,0:08:53.65,0:08:55.20,Default,,0,0,0,,Бұл жақсы
Dialogue: 0,0:08:55.28,0:08:59.70,Default,,0,0,0,,Луи бізге хайуандардың патшасындай қарады.
Dialogue: 0,0:09:00.45,0:09:03.91,Default,,0,0,0,,Сондықтан Луи бізді жетектеп келеді.
Dialogue: 0,0:09:04.00,0:09:05.58,Default,,0,0,0,,Бұл ерекше көрінді.
Dialogue: 0,0:09:05.67,0:09:08.50,Default,,0,0,0,,Мен сұрасам қайтеді?
Dialogue: 0,0:09:08.58,0:09:10.13,Default,,0,0,0,,Еңкейсек...
Dialogue: 0,0:09:10.21,0:09:12.05,Default,,0,0,0,,-Жоқ! -(Шишигуми) Не!
Dialogue: 0,0:09:12.13,0:09:13.63,Default,,0,0,0,,Әй, жоқ болды.
Dialogue: 0,0:09:13.71,0:09:14.55,Default,,0,0,0,,Сіз...
Dialogue: 0,0:09:14.63,0:09:16.13,Default,,0,0,0,,- Уа - (Тегін) Сол кезде!
Dialogue: 0,0:09:16.22,0:09:18.09,Default,,0,0,0,,Сіз аман қалдыңыз ба?
Dialogue: 0,0:09:18.18,0:09:21.43,Default,,0,0,0,,Сен мұнда не үшін келдің? Мені тағы да өлтіресің бе?
Dialogue: 0,0:09:21.51,0:09:24.10,Default,,0,0,0,,Күте тұрыңыз! Бұл басқаша
Dialogue: 0,0:09:24.18,0:09:25.64,Default,,0,0,0,,Мен сізден бірнәрсе сұрайын деп едім.
Dialogue: 0,0:09:25.73,0:09:26.89,Default,,0,0,0,,Әй?
Dialogue: 0,0:09:26.98,0:09:29.36,Default,,0,0,0,,Қауынның қайда екенін айта аласыз ба?
Dialogue: 0,0:09:29.44,0:09:30.65,Default,,0,0,0,,Сіз не ойлап отырсыз?
Dialogue: 0,0:09:30.73,0:09:31.90,Default,,0,0,0,,Мен сені ұстағым келеді!
Dialogue: 0,0:09:32.61,0:09:35.90,Default,,0,0,0,,Қауынның да жоғалғанын бәрің қалайсыңдар, солай ма?
Dialogue: 0,0:09:36.40,0:09:37.86,Default,,0,0,0,,-Олай болса ынтымақтас... Уау! -Ой!
Dialogue: 0,0:09:38.86,0:09:41.03,Default,,0,0,0,,Қасқырлардың соңынан еріңіз, бұл әзіл емес.
Dialogue: 0,0:09:41.12,0:09:43.29,Default,,0,0,0,,Жоқ, мен сені бағындырғым келмеді!
Dialogue: 0,0:09:43.37,0:09:46.12,Default,,0,0,0,,Біздің мақсатымыз бір, солай емес пе?
Dialogue: 0,0:09:46.62,0:09:49.04,Default,,0,0,0,,Мен Луи-сенпайды бастық етумен келіспеймін, бірақ...
Dialogue: 0,0:09:49.13,0:09:53.13,Default,,0,0,0,,Эй, сен «Луи-сенпай» дедің бе?
Dialogue: 0,0:09:53.21,0:09:54.05,Default,,0,0,0,,Әй, сен не айтып тұрсың...
Dialogue: 0,0:09:54.13,0:09:56.76,Default,,0,0,0,,-Мен сенің орта мектептің кіші сынып оқушысымын.-(Еркін Джинма) А?
Dialogue: 0,0:09:56.84,0:09:58.88,Default,,0,0,0,,Луидің не туралы екені маңызды емес.
Dialogue: 0,0:09:58.97,0:10:00.80,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:00.89,0:10:03.22,Default,,0,0,0,,Қауынның қолайсыз екені рас, бірақ
Dialogue: 0,0:10:03.31,0:10:05.60,Default,,0,0,0,,Азу иттерге сенетіндей күйзелме.
Dialogue: 0,0:10:05.68,0:10:08.73,Default,,0,0,0,,Есептерімізді шешеміз
Dialogue: 0,0:10:08.81,0:10:13.69,Default,,0,0,0,,Бірақ сіз менің айтқанымды естігендіктен, бұл жолы жоғалуыңызды сұраймын.
Dialogue: 0,0:10:13.77,0:10:16.69,Default,,0,0,0,,- Уф... - (Виктор) Уф.
Dialogue: 0,0:10:16.78,0:10:17.99,Default,,0,0,0,,Құдай-ай!
Dialogue: 0,0:10:23.45,0:10:27.54,Default,,0,0,0,,Мені өлтірсең, Луи-сенпай қатты қайғырады.
Dialogue: 0,0:10:27.62,0:10:29.67,Default,,0,0,0,,Бұл қандай сенімділік?
Dialogue: 0,0:10:29.75,0:10:31.71,Default,,0,0,0,,Біз енді жоқпыз
Dialogue: 0,0:10:31.79,0:10:34.75,Default,,0,0,0,,Мен арыстан мақтанышымды жоғалтқым келмейді.
Dialogue: 0,0:10:36.67,0:10:39.30,Default,,0,0,0,,Мен сені осы жолы өлуге рұқсат етемін.
Dialogue: 0,0:10:42.80,0:10:44.35,Default,,0,0,0,,«Зооолимпиада»
Dialogue: 0,0:10:44.85,0:10:50.56,Default,,0,0,0,,Барлық тірі организмдер спортта жарысатын және өздерінің жоғары күштерін көрсететін фестиваль.
Dialogue: 0,0:10:50.65,0:10:52.73,Default,,0,0,0,,Әртүрлі айырмашылықтарды жеңу
Dialogue: 0,0:10:52.81,0:10:57.19,Default,,0,0,0,,Бейбіт және жақсы әлемді жүзеге асыруға бағытталған оқиғалар
Dialogue: 0,0:10:57.82,0:11:01.16,Default,,0,0,0,,БІРГЕ ӨМІР СҮРУ туралы менің көзқарасым
Dialogue: 0,0:11:01.24,0:11:04.24,Default,,0,0,0,,«Бірге өмір сүру және бірге өркендеудің» өзі
Dialogue: 0,0:11:05.12,0:11:10.04,Default,,0,0,0,,Мен осы қалаға Зоолимпиаданы шақыруды ойлап жүрмін.
Dialogue: 0,0:11:10.12,0:11:14.21,Default,,0,0,0,,Алайда үлкен шығын ауыр болуы мүмкін.
Dialogue: 0,0:11:14.29,0:11:16.84,Default,,0,0,0,,Шегініп жатқан қалалар көбейіп бара жатқан сияқты.
Dialogue: 0,0:11:16.92,0:11:20.42,Default,,0,0,0,,Бұл біздің мүмкіндігіміз деп ойламайсыз ба?
Dialogue: 0,0:11:20.51,0:11:23.80,Default,,0,0,0,,Шығындар бойынша, конкурстық комиссияның төрағасы ретінде
Dialogue: 0,0:11:23.89,0:11:27.18,Default,,0,0,0,,Мен уайымдамаймын, өйткені Огма мырза осында.
Dialogue: 0,0:11:28.18,0:11:29.81,Default,,0,0,0,,(Игги) Ұф! (Джозеф) Хи-хи
Dialogue: 0,0:11:30.31,0:11:32.94,Default,,0,0,0,,Әкенің ойы бар ма?
Dialogue: 0,0:11:33.02,0:11:38.11,Default,,0,0,0,,Сонымен қатар, біз шешуші козир дайындап жатырмыз.
Dialogue: 0,0:11:40.24,0:11:42.11,Default,,0,0,0,,Хм, бұл не?
Dialogue: 0,0:11:42.20,0:11:43.82,Default,,0,0,0,,Жасанды ет
Dialogue: 0,0:11:43.91,0:11:47.58,Default,,0,0,0,,А... Мен бұл туралы естідім.
Dialogue: 0,0:11:47.66,0:11:52.00,Default,,0,0,0,,Бұлшық ет жасушаларын өсіру арқылы жасанды түрде өндірілген ет
Dialogue: 0,0:11:52.08,0:11:57.75,Default,,0,0,0,,Бұл ешкімді өлтірмейтін этикалық таза ет дегенді білдіреді.
Dialogue: 0,0:11:57.84,0:12:00.76,Default,,0,0,0,,Бұл нақты нәрсеге ұқсайды.
Dialogue: 0,0:12:00.84,0:12:03.76,Default,,0,0,0,,Дәмі мен тамақтануын қанағаттандыру
Dialogue: 0,0:12:04.59,0:12:06.39,Default,,0,0,0,,Менің ойымша, ол әлі даму сатысында...
Dialogue: 0,0:12:07.30,0:12:09.35,Default,,0,0,0,,Сіз оны уақытында жасайсыз, солай ма?
Dialogue: 0,0:12:10.02,0:12:11.02,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:12:11.52,0:12:15.44,Default,,0,0,0,,Жасыратыны жоқ, спортшылар жасырын түрде ет жейді.
Dialogue: 0,0:12:15.52,0:12:17.73,Default,,0,0,0,,Бұл ұят.
Dialogue: 0,0:12:17.82,0:12:18.86,Default,,0,0,0,,Квирктерін қылмыстық мақсатта пайдаланатын жауыздармен күресу үшін —
Dialogue: 0,0:12:18.94,0:12:23.82,Default,,0,0,0,,Бірақ осы жасанды етті спортшыларға беретін болсақ ше?
Dialogue: 0,0:12:23.90,0:12:26.95,Default,,0,0,0,,Ет жейтіндер қуана жейді.
Dialogue: 0,0:12:27.03,0:12:32.54,Default,,0,0,0,,Бұл турнирде бірінен соң бірі жаңа рекордтар жасалатынына сенімдімін.
Dialogue: 0,0:12:33.16,0:12:35.71,Default,,0,0,0,,Horns Pharmaceuticals және Agura Foods үшін
Dialogue: 0,0:12:35.79,0:12:38.84,Default,,0,0,0,,Бұл жарнама үшін тамаша орын.
Dialogue: 0,0:12:39.50,0:12:43.67,Default,,0,0,0,,Азукидің әкесінің компаниясы және Horns Pharmaceutical
Dialogue: 0,0:12:43.76,0:12:45.01,Default,,0,0,0,,Жағымсыз иіс шығады.
Dialogue: 0,0:12:45.51,0:12:46.34,Default,,0,0,0,,Уф
Dialogue: 0,0:12:46.43,0:12:48.51,Default,,0,0,0,,Міне, сіз кіресіз.
Dialogue: 0,0:12:49.14,0:12:53.06,Default,,0,0,0,,Біз сізді елшіміз болуды өтінеміз деп шештік.
Dialogue: 0,0:12:53.14,0:12:53.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:54.06,0:12:59.94,Default,,0,0,0,,Сіздерге, жастардың сенімі мен ықпалына ие болған болашақ аң жұлдызы.
Dialogue: 0,0:13:00.02,0:13:01.11,Default,,0,0,0,,Сен Риппелді қалағанша басқара алатындайша жаттығу жасауың керек—
Dialogue: 0,0:13:02.15,0:13:02.90,Default,,0,0,0,,Тіпті тәтті, бал иісі бар дене жылуы
Dialogue: 0,0:13:04.61,0:13:05.91,Default,,0,0,0,,Тоқтатылды
Dialogue: 0,0:13:07.45,0:13:08.82,Default,,0,0,0,,Өзі ешқашан Ал Майтты басып оза алмайтынын түсінген әкем—
Dialogue: 0,0:13:10.41,0:13:11.74,Default,,0,0,0,,Ах
Dialogue: 0,0:13:14.08,0:13:17.67,Default,,0,0,0,,О, бұл керемет мүйіз.
Dialogue: 0,0:13:18.33,0:13:20.54,Default,,0,0,0,,Бұл әлі де ата-ана мен бала.
Dialogue: 0,0:13:21.13,0:13:23.67,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:13:26.22,0:13:29.47,Default,,0,0,0,,Ендеше, бірінші оқуды бірге бастайық.
Dialogue: 0,0:13:29.55,0:13:31.64,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:13:31.72,0:13:35.39,Default,,0,0,0,,Пина-кун, ренжіген кездерім болды.
Dialogue: 0,0:13:35.48,0:13:37.73,Default,,0,0,0,,Бір рет қойылымды ұмытайық.
Dialogue: 0,0:13:37.81,0:13:39.19,Default,,0,0,0,,«Мың жыл бұрын»
Dialogue: 0,0:13:39.27,0:13:44.40,Default,,0,0,0,,«Шөпқоректілер мен жыртқыштар кемсітусіз бірге өмір сүрген уақыт».
Dialogue: 0,0:13:44.49,0:13:46.95,Default,,0,0,0,,«Лира мен басқалары жеміс алуға кеткеннен кейін».
Dialogue: 0,0:13:47.03,0:13:49.70,Default,,0,0,0,,«Күн жеті рет шықты».
Dialogue: 0,0:13:49.78,0:13:51.49,Default,,0,0,0,,«Сіз әдеттегіден баяусыз».
Dialogue: 0,0:13:51.58,0:13:54.54,Default,,0,0,0,,«Жарайды, бұл Лира, сен амансың».
Dialogue: 0,0:13:54.62,0:13:57.12,Default,,0,0,0,,Жоғарыдан Ләйлә пайда болады
Dialogue: 0,0:13:58.42,0:14:01.04,Default,,0,0,0,,«үшін жаңа ғана оралды».
Dialogue: 0,0:14:01.13,0:14:04.05,Default,,0,0,0,,«Қайтар жолда маған ягуарлар үйірі шабуыл жасады».
Dialogue: 0,0:14:04.13,0:14:05.76,Default,,0,0,0,,«Осы азу тістермен және мына тырнақтармен...»
Dialogue: 0,0:14:05.84,0:14:08.51,Default,,0,0,0,,«үшін жаңа ғана оралды».
Dialogue: 0,0:14:08.59,0:14:10.97,Default,,0,0,0,,«Қайтар жолда маған ягуарлар үйірі шабуыл жасады...»
Dialogue: 0,0:14:11.05,0:14:13.18,Default,,0,0,0,,Ой, күт, күт, не істеп жатырсың?
Dialogue: 0,0:14:13.26,0:14:14.85,Default,,0,0,0,,Бұл сіздің жолыңыз емес.
Dialogue: 0,0:14:14.93,0:14:19.06,Default,,0,0,0,,Мен білемін, бірақ мен бұлай әрекет етпес едім.
Dialogue: 0,0:14:19.14,0:14:20.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:20.98,0:14:24.82,Default,,0,0,0,,Бұл көшбасшы ешқашан өз күшіне күмән келтірген емес.
Dialogue: 0,0:14:24.90,0:14:28.36,Default,,0,0,0,,Біреуді ренжіткен кезде өзіңізді тыныштандырмайсыз ба?
Dialogue: 0,0:14:28.45,0:14:30.53,Default,,0,0,0,,Күрсін... Мен түсінемін.
Dialogue: 0,0:14:30.61,0:14:32.16,Default,,0,0,0,,-Бірақ... -Тыңда.
Dialogue: 0,0:14:32.24,0:14:35.79,Default,,0,0,0,,Мен сені қайтып әкелдім, өйткені сен Галанның рөліне мінсіз болғансың.
Dialogue: 0,0:14:35.87,0:14:37.08,Default,,0,0,0,,Иә, және—
Dialogue: 0,0:14:37.16,0:14:40.87,Default,,0,0,0,,Бұл оқиға болған дәуірдегі шөпқоректілердің суреттері қандай?
Dialogue: 0,0:14:40.96,0:14:45.00,Default,,0,0,0,,Бұлардың бәрі мүйізді қойлардың суреттері болғандықтан, Пина орындайды деп ойладым.
Dialogue: 0,0:14:45.09,0:14:46.84,Default,,0,0,0,,Бұл осы дәуірден қалған оқиға дейді...
Dialogue: 0,0:14:46.92,0:14:49.72,Default,,0,0,0,,Хмм, мен мұны білемін, бірақ...
Dialogue: 0,0:14:50.76,0:14:55.64,Default,,0,0,0,,Бірақ менің жыртқыштың рөлін ойнағаным қызық емес пе?
Dialogue: 0,0:14:55.72,0:14:56.60,Default,,0,0,0,,Бұл...
Dialogue: 0,0:14:56.68,0:14:58.06,Default,,0,0,0,,Дәлірек айтқанда
Dialogue: 0,0:14:58.14,0:15:03.27,Default,,0,0,0,,Жыртқыш шөпқоректі үшінн ауыстырсақ, қызық болар деп ойладым.
Dialogue: 0,0:15:03.36,0:15:06.73,Default,,0,0,0,,Бұл шынымен де солай ма?
Dialogue: 0,0:15:06.82,0:15:10.40,Default,,0,0,0,,Не айтып тұрсың, өзімшіл нарцист қой!
Dialogue: 0,0:15:10.49,0:15:12.28,Default,,0,0,0,,Тұтынушылар шатастырмай ма?
Dialogue: 0,0:15:12.36,0:15:13.12,Default,,0,0,0,,Бірақ
Dialogue: 0,0:15:13.20,0:15:15.74,Default,,0,0,0,,Адамдарға мұны түсінудің көптеген жолдары бар емес пе?
Dialogue: 0,0:15:15.83,0:15:17.41,Default,,0,0,0,,Костюм атмосферасын өзгерту
Dialogue: 0,0:15:17.49,0:15:21.54,Default,,0,0,0,,Шөпқоректілердің жасылдау екені рас.
Dialogue: 0,0:15:21.62,0:15:23.67,Default,,0,0,0,,Жыртқыштар қызғылт сары болуы керек пе?
Dialogue: 0,0:15:23.75,0:15:25.38,Default,,0,0,0,,Театр дегеніміз не?
Dialogue: 0,0:15:25.46,0:15:28.51,Default,,0,0,0,,Сіз болмайтын нәрсеге айналуға мүмкіндік беретін сиқыр емес пе?
Dialogue: 0,0:15:28.59,0:15:30.51,Default,,0,0,0,,Бұл дұрыс, бірақ...
Dialogue: 0,0:15:30.59,0:15:32.55,Default,,0,0,0,,Жоқ, күте тұрыңыз!
Dialogue: 0,0:15:35.05,0:15:39.48,Default,,0,0,0,,Олай десеңіз, мен де Лираны ойнағым келеді!
Dialogue: 0,0:15:39.56,0:15:42.85,Default,,0,0,0,,Оның үстіне мен ешқашан шөпқоректіні ойнаған емеспін...
Dialogue: 0,0:15:42.94,0:15:45.81,Default,,0,0,0,,Олай болса, бұл дұрыс. Бірінші сынақ.
Dialogue: 0,0:15:45.90,0:15:48.94,Default,,0,0,0,,Мен бұл рөлді ойнағым келеді
Dialogue: 0,0:15:49.03,0:15:50.69,Default,,0,0,0,,Ал Пина-кун үшін,
Dialogue: 0,0:15:50.78,0:15:53.03,Default,,0,0,0,,Сіз жыртқыштардың қалай сезінетінін түсінбейсіз.
Dialogue: 0,0:15:53.11,0:15:57.28,Default,,0,0,0,,Сонымен, Джуно-сан, сен шөп қоректі жануарды ренжітіп көрдің бе?
Dialogue: 0,0:15:57.37,0:15:58.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:58.45,0:16:02.83,Default,,0,0,0,,Қолыңызды сындырған немесе жеген кезіңіз болды ма?
Dialogue: 0,0:16:02.92,0:16:04.42,Default,,0,0,0,,Шынымен емес, бірақ...
Dialogue: 0,0:16:04.50,0:16:07.96,Default,,0,0,0,,Олай болса, Джуно өз қиялынан әрекет етпей ме?
Dialogue: 0,0:16:08.05,0:16:10.01,Default,,0,0,0,,Ал бұл...
Dialogue: 0,0:16:10.09,0:16:11.30,Default,,0,0,0,,Джуно мырза
Dialogue: 0,0:16:11.38,0:16:16.01,Default,,0,0,0,,Сіз ең жақсы өнер көрсеткіңіз келеді, солай ма?
Dialogue: 0,0:16:16.10,0:16:19.60,Default,,0,0,0,,Орташа күйзеліс және әдемі
Dialogue: 0,0:16:19.68,0:16:22.39,Default,,0,0,0,,Басты кейіпкер ретінде ерекшеленетін тамаша рөл
Dialogue: 0,0:16:22.48,0:16:23.56,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:16:23.64,0:16:27.82,Default,,0,0,0,,Мен жай ғана осы спектакльге сәйкес келетін рөлді ойнағым келеді...
Dialogue: 0,0:16:27.90,0:16:31.61,Default,,0,0,0,,Менің ойымша, Джуно шөпқоректілердің рөлін ойнауы керек.
Dialogue: 0,0:16:32.15,0:16:33.86,Default,,0,0,0,,Сіз Құбыжық болғыңыз келеді, солай ма?
Dialogue: 0,0:16:33.95,0:16:35.74,Default,,0,0,0,,Менің көзқарасым кеңейіп жатқан сияқты.
Dialogue: 0,0:16:35.82,0:16:36.70,Default,,0,0,0,,Бұл...
Dialogue: 0,0:16:36.78,0:16:42.50,Default,,0,0,0,,Шөпқоректілердің әлсіз, күшейе түсу арқылы ғана қорғана алатын сезімі.
Dialogue: 0,0:16:42.58,0:16:44.04,Default,,0,0,0,,Елестетіп көріңізші?
Dialogue: 0,0:16:44.83,0:16:46.54,Default,,0,0,0,,-Мүмкін -О
Dialogue: 0,0:16:46.63,0:16:49.84,Default,,0,0,0,,Оңай ойнайтын рөлді ойнаудың еш айыбы жоқ.
Dialogue: 0,0:16:49.92,0:16:54.22,Default,,0,0,0,,Жоқ... Енді сіз айтып отырсаңыз, Пина-кун дұрыс шығар.
Dialogue: 0,0:16:54.30,0:16:55.68,Default,,0,0,0,,Мен де солай ойладым.
Dialogue: 0,0:16:55.76,0:17:00.81,Default,,0,0,0,,Менің ойымша, егер Пинаның идеясы болса, тақырып түсінікті болар еді...
Dialogue: 0,0:17:00.89,0:17:03.64,Default,,0,0,0,,Бұл Адлерге ұқсайтын шығар.
Dialogue: 0,0:17:04.39,0:17:05.77,Default,,0,0,0,,Бастапқыда Адлер болды
Dialogue: 0,0:17:05.85,0:17:10.02,Default,,0,0,0,,Шөпқоректі жануардың тіршілік аңшысының рөлін ойнау мағынасы бар, солай емес пе?
Dialogue: 0,0:17:10.11,0:17:12.07,Default,,0,0,0,,Ал... шынымды айтсам
Dialogue: 0,0:17:12.15,0:17:15.53,Default,,0,0,0,,Егер солай болса, оны бірлесіп орындаудың пайдасы көп.
Dialogue: 0,0:17:15.61,0:17:16.78,Default,,0,0,0,,Idededebut...
Dialogue: 0,0:17:16.86,0:17:20.28,Default,,0,0,0,,Хаха Джуно-сан, қорықпайсың ба?
Dialogue: 0,0:17:21.24,0:17:23.75,Default,,0,0,0,,Рөлді орындауға сенімділік болмағандықтан қорқасыз ба?
Dialogue: 0,0:17:23.83,0:17:29.17,Default,,0,0,0,,ше? Сіз жыртқыштың рөлін оңай ойнай аламын деп ойламайсыз ба?
Dialogue: 0,0:17:29.25,0:17:32.09,Default,,0,0,0,,Бұл оңай деп ойламайсыз ба?
Dialogue: 0,0:17:32.63,0:17:34.30,Default,,0,0,0,,Мен мұны істеу мүмкін емес деп ойлаймын.
Dialogue: 0,0:17:35.42,0:17:38.59,Default,,0,0,0,,Жақсы, мен істеймін.
Dialogue: 0,0:17:38.68,0:17:40.51,Default,,0,0,0,,Мен галанды орындаймын
Dialogue: 0,0:17:40.60,0:17:42.97,Default,,0,0,0,,Мен мұны сенен әлдеқайда жақсы істеймін, Пина!
Dialogue: 0,0:17:43.06,0:17:46.31,Default,,0,0,0,,Ия, мен мұны істеуім керек.
Dialogue: 0,0:17:47.14,0:17:51.57,Default,,0,0,0,,Қазірдің өзінде... мен не дедім?
Dialogue: 0,0:17:59.11,0:18:01.58,Default,,0,0,0,,(тон)
Dialogue: 0,0:18:03.49,0:18:04.70,Default,,0,0,0,,Біз келдік
Dialogue: 0,0:18:05.29,0:18:07.83,Default,,0,0,0,,(есіктің қатты ашылған дыбысы)
Dialogue: 0,0:18:10.17,0:18:11.42,Default,,0,0,0,,Сен жақсысың деп үміттенемін.
Dialogue: 0,0:18:11.50,0:18:13.80,Default,,0,0,0,,Сен келдің.
Dialogue: 0,0:18:13.88,0:18:18.88,Default,,0,0,0,,Балалар, сендер нені айтасыңдар? Ол қауіп төндіретін сияқты әрекет етті
Dialogue: 0,0:18:18.97,0:18:21.47,Default,,0,0,0,,Бұны жасамасаң, келмейсің.
Dialogue: 0,0:18:21.55,0:18:24.43,Default,,0,0,0,,Дұрыс, телефонға да жауап бермейді.
Dialogue: 0,0:18:24.52,0:18:26.43,Default,,0,0,0,,Жарайды, қасқырды шығарыңдар.
Dialogue: 0,0:18:26.52,0:18:29.14,Default,,0,0,0,,Егер оған бірдеңе болса, бұл тегін...
Dialogue: 0,0:18:29.23,0:18:32.15,Default,,0,0,0,,Әй, қасқыр сенсің!
Dialogue: 0,0:18:32.23,0:18:33.98,Default,,0,0,0,,Жоқ... сәлем...
Dialogue: 0,0:18:34.07,0:18:35.19,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:35.28,0:18:38.65,Default,,0,0,0,,Хаа... не істеп жатырсың?
Dialogue: 0,0:18:38.74,0:18:42.49,Default,,0,0,0,,А... Мен оны Джуно деп ойладым ба?
Dialogue: 0,0:18:42.57,0:18:45.49,Default,,0,0,0,,Ха... не болды?
Dialogue: 0,0:18:46.12,0:18:48.16,Default,,0,0,0,,Сізден бір нәрсе сұрайын деп едім.
Dialogue: 0,0:18:48.25,0:18:49.71,Default,,0,0,0,,Мен Қауынның қайда екенін білгім келеді.
Dialogue: 0,0:18:49.79,0:18:52.42,Default,,0,0,0,,Сіз енді Қауынмен ештеңе істегіңіз келмейтінін айттыңыз.
Dialogue: 0,0:18:52.50,0:18:53.92,Default,,0,0,0,,А... дұрыс.
Dialogue: 0,0:18:54.00,0:18:59.93,Default,,0,0,0,,Қауын ұстасам, ет соттығымды өшіре аламын.
Dialogue: 0,0:19:00.01,0:19:02.72,Default,,0,0,0,,Олай етпесем, Хару-чанға үйлене алмаймын.
Dialogue: 0,0:19:04.97,0:19:07.93,Default,,0,0,0,,Сонда сіз бұл жігіттерден ақпарат алуға тырысасыз ба?
Dialogue: 0,0:19:08.43,0:19:09.89,Default,,0,0,0,,Сізді жақсы өлтірген жоқсыз.
Dialogue: 0,0:19:09.98,0:19:12.65,Default,,0,0,0,,Жоқ... Мен өліп қала жаздадым.
Dialogue: 0,0:19:12.73,0:19:15.40,Default,,0,0,0,,Бірақ менің ағам айтса, мен оны үйрете аламын.
Dialogue: 0,0:19:15.48,0:19:18.94,Default,,0,0,0,,Бұл жігіт егер ол үшін болса, Луи келеді деді.
Dialogue: 0,0:19:19.03,0:19:20.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:20.65,0:19:23.87,Default,,0,0,0,,Хехе... Шиши-гумимен барлық байланысымды үзсем де.
Dialogue: 0,0:19:23.95,0:19:25.87,Default,,0,0,0,,Кешіріңіз, бұл менің кінәм
Dialogue: 0,0:19:26.54,0:19:29.87,Default,,0,0,0,,А, бірақ сен маған көмектесе аласың ба?
Dialogue: 0,0:19:29.96,0:19:31.21,Default,,0,0,0,,Гааах!
Dialogue: 0,0:19:31.87,0:19:34.67,Default,,0,0,0,,Етқоректілер мен шөпқоректілерді араластырып ұстасаң да
Dialogue: 0,0:19:34.75,0:19:36.88,Default,,0,0,0,,Харумен бақытты болуға кепілдік берілмейді.
Dialogue: 0,0:19:36.96,0:19:40.01,Default,,0,0,0,,Иә, мен оны есте сақтаймын.
Dialogue: 0,0:19:52.81,0:19:54.40,Default,,0,0,0,,Мен ертегіні естідім.
Dialogue: 0,0:19:55.36,0:19:58.36,Default,,0,0,0,,Қауынның қайда екенін айт.
Dialogue: 0,0:19:59.36,0:20:02.65,Default,,0,0,0,,Мен саған сабақ бере аламын, бірақ шарттары бар.
Dialogue: 0,0:20:02.74,0:20:03.99,Default,,0,0,0,,Жағдайлар?
Dialogue: 0,0:20:04.53,0:20:11.12,Default,,0,0,0,,Луи, сіз Шиши-гумиге біздің бастық ретінде қайта аласыз ба?
Dialogue: 0,0:20:11.21,0:20:12.46,Default,,0,0,0,,Бұл жақсы емес!
Dialogue: 0,0:20:12.54,0:20:13.33,Default,,0,0,0,,Шу!
Dialogue: 0,0:20:14.12,0:20:15.83,Default,,0,0,0,,Бастық ретінде сөзіңді орындаймын.
Dialogue: 0,0:20:15.83,0:20:17.29,Default,,0,0,0,,Бастық ретінде сөзіңді орындаймын.
Dialogue: 0,0:20:15.83,0:20:17.29,Default,,0,0,0,,Бұл басқа әңгіме!
Dialogue: 0,0:20:17.29,0:20:17.38,Default,,0,0,0,,Бұл басқа әңгіме!
Dialogue: 0,0:20:17.38,0:20:18.42,Default,,0,0,0,,Бұл басқа әңгіме!
Dialogue: 0,0:20:17.38,0:20:18.42,Default,,0,0,0,,Олай десеңіз, мына қасқырмен ынтымақтастықта болыңыз...
Dialogue: 0,0:20:18.42,0:20:18.50,Default,,0,0,0,,Олай десеңіз, мына қасқырмен ынтымақтастықта болыңыз...
Dialogue: 0,0:20:18.50,0:20:20.71,Default,,0,0,0,,Олай десеңіз, мына қасқырмен ынтымақтастықта болыңыз...
Dialogue: 0,0:20:18.50,0:20:20.71,Default,,0,0,0,,Егер Луи-сенпай менен сұраса...
Dialogue: 0,0:20:20.71,0:20:20.80,Default,,0,0,0,,Егер Луи-сенпай менен сұраса...
Dialogue: 0,0:20:20.80,0:20:21.30,Default,,0,0,0,,Егер Луи-сенпай менен сұраса...
Dialogue: 0,0:20:20.80,0:20:21.30,Default,,0,0,0,,Шу!
Dialogue: 0,0:20:21.30,0:20:21.92,Default,,0,0,0,,Шу!
Dialogue: 0,0:20:22.01,0:20:23.68,Default,,0,0,0,,Бұл шарт.
Dialogue: 0,0:20:25.64,0:20:29.56,Default,,0,0,0,,Мен көремін. Сол себепті атадың ба?
Dialogue: 0,0:20:32.02,0:20:35.06,Default,,0,0,0,,Өтінемін, бұл осылай.
Dialogue: 0,0:20:37.23,0:20:38.61,Default,,0,0,0,,Хмм
Dialogue: 0,0:20:41.74,0:20:43.74,Default,,0,0,0,,Мен мұндай көріністі бұрын-соңды көрген емеспін.
Dialogue: 0,0:20:44.95,0:20:49.24,Default,,0,0,0,,Бүйірінде арыстан тұрған киік осылай көрінеді.
Dialogue: 0,0:20:52.75,0:20:53.62,Default,,0,0,0,,(Иносукэ) Эй! (Зэнитсу) Ұф…
Dialogue: 0,0:20:53.71,0:20:57.42,Default,,0,0,0,,Уф... неге...
Dialogue: 0,0:21:00.96,0:21:03.22,Default,,0,0,0,,Ибуки мен үшін өлді
Dialogue: 0,0:21:04.59,0:21:06.72,Default,,0,0,0,,Өйткені мен бастықтан кететінімді айттым.
Dialogue: 0,0:21:06.80,0:21:08.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:08.43,0:21:09.85,Default,,0,0,0,,Хаа…
Dialogue: 0,0:21:09.93,0:21:11.77,Default,,0,0,0,,Сол кезде ол
Dialogue: 0,0:21:12.52,0:21:16.90,Default,,0,0,0,,Ол Шиши-гуми мақтанышын қорғау үшін өлді.
Dialogue: 0,0:21:23.86,0:21:26.99,Default,,0,0,0,,Қайтып келсем, оның өлімі бекер.
Dialogue: 0,0:21:27.91,0:21:34.08,Default,,0,0,0,,Сондықтан мен ешқашан сіздің бастық болмаймын.
Dialogue: 0,0:21:38.71,0:21:39.84,Default,,0,0,0,,Луис…
Dialogue: 0,0:21:43.76,0:21:46.43,Default,,0,0,0,,Өте өкінішті, пайдасы жоқ.
Dialogue: 0,0:21:47.09,0:21:47.97,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:55.02,0:21:56.85,Default,,0,0,0,,- (Еркін) Эй - Әй?
Dialogue: 0,0:21:57.48,0:22:02.61,Default,,0,0,0,,Қауынды қоғамда «Сенсей» деп атаса керек.
Dialogue: 0,0:22:03.23,0:22:04.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:07.32,0:22:09.03,Default,,0,0,0,,5-үй, «Малкольм» үй меңгерушісі
Dialogue: 0,0:22:11.99,0:22:13.99,Default,,0,0,0,,♪～
Dialogue: 0,0:23:39.91,0:23:41.92,Default,,0,0,0,,～♪
