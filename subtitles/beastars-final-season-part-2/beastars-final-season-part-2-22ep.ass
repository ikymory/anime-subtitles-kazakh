Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.67,0:00:14.68,Default,,0,0,0,,♪～
Dialogue: 0,0:01:39.93,0:01:41.93,Default,,0,0,0,,～♪
Dialogue: 0,0:01:47.02,0:01:51.02,Default,,0,0,0,,(Легоши мен оның достарының ауыр тыныс алуы)
Dialogue: 0,0:01:51.11,0:01:54.40,Default,,0,0,0,,(Зенitsu) Ата енді ғана пайда болып, «Таласуды қойма» деді…
Dialogue: 0,0:01:54.48,0:01:57.24,Default,,0,0,0,,Мен бұл дыбысты естігенде толқып кетемін.
Dialogue: 0,0:01:57.32,0:01:58.91,Default,,0,0,0,,Фестивальдерде де солай жасайсыз ба?
Dialogue: 0,0:01:58.99,0:02:01.32,Default,,0,0,0,,Шеңбер соғысына қатысуды қабылдау.
Dialogue: 0,0:02:01.41,0:02:04.16,Default,,0,0,0,,Сіз аумақ үшін соғысасыз ба?
Dialogue: 0,0:02:04.24,0:02:06.70,Default,,0,0,0,,Мен бұл күндері мұндай қиындықты өткермес едім.
Dialogue: 0,0:02:06.79,0:02:10.54,Default,,0,0,0,,Артқы базарды бақылайтын төрт топ қандарын өртеп жіберді...
Dialogue: 0,0:02:10.63,0:02:12.25,Default,,0,0,0,,Иістің күштілігіне жарысыңыз
Dialogue: 0,0:02:12.34,0:02:14.92,Default,,0,0,0,,Ей, бұл аңдардың негізі.
Dialogue: 0,0:02:15.42,0:02:19.55,Default,,0,0,0,,Өткізілетін жерде қауын пайда болды.
Dialogue: 0,0:02:19.63,0:02:23.72,Default,,0,0,0,,(Зенitsu) Ата енді ғана пайда болып, «Таласуды қойма» деді…
Dialogue: 0,0:02:27.73,0:02:30.77,Default,,0,0,0,,Қатысушылар бар ма?
Dialogue: 0,0:02:31.35,0:02:34.23,Default,,0,0,0,,2 минуттан кейін жабылады
Dialogue: 0,0:02:38.03,0:02:39.78,Default,,0,0,0,,Қауын қайда?
Dialogue: 0,0:02:39.86,0:02:41.99,Default,,0,0,0,,Иә?Онда емес
Dialogue: 0,0:02:42.07,0:02:43.37,Default,,0,0,0,,Тым кеш!
Dialogue: 0,0:02:44.08,0:02:45.54,Default,,0,0,0,,Кешіріңіз, үйге қайтайық.
Dialogue: 0,0:02:45.62,0:02:47.04,Default,,0,0,0,,О, сәл күте тұрыңыз.
Dialogue: 0,0:02:47.12,0:02:49.12,Default,,0,0,0,,Мына жерде «қауын» бар.
Dialogue: 0,0:02:49.21,0:02:52.54,Default,,0,0,0,,Соңғы мерзім жақында келеді.
Dialogue: 0,0:02:52.63,0:02:54.88,Default,,0,0,0,,Бұл менің дәл қазір болғанымның дәлелі.
Dialogue: 0,0:02:54.96,0:02:55.88,Default,,0,0,0,,Рычаг дегеніміз не?
Dialogue: 0,0:02:55.96,0:02:58.30,Default,,0,0,0,,Қауындар да сол аумақ үшін соғысуға келеді дейсіз бе?
Dialogue: 0,0:02:58.38,0:03:00.59,Default,,0,0,0,,Ол Шиши-гумидің бастығы.
Dialogue: 0,0:03:00.68,0:03:03.39,Default,,0,0,0,,Содан кейін қауынды ұстай аласыз.
Dialogue: 0,0:03:04.01,0:03:05.47,Default,,0,0,0,,Әй, эй! Дегоси!
Dialogue: 0,0:03:05.56,0:03:06.72,Default,,0,0,0,,Не істемекшісің?
Dialogue: 0,0:03:06.81,0:03:08.93,Default,,0,0,0,,Тапсыру мерзімі!
Dialogue: 0,0:03:09.02,0:03:11.60,Default,,0,0,0,,(Зенitsu) Ата енді ғана пайда болып, «Таласуды қойма» деді…
Dialogue: 0,0:03:11.69,0:03:13.94,Default,,0,0,0,,Мен қатысамын
Dialogue: 0,0:03:14.02,0:03:17.57,Default,,0,0,0,,Иә? Сіз ережелерді білесіз, солай ма?
Dialogue: 0,0:03:17.65,0:03:19.99,Default,,0,0,0,,Иә... мүмкін
Dialogue: 0,0:03:20.07,0:03:21.74,Default,,0,0,0,,Не? сол қасқыр
Dialogue: 0,0:03:21.82,0:03:24.20,Default,,0,0,0,,Енді атыңызды жазыңыз.
Dialogue: 0,0:03:24.28,0:03:26.78,Default,,0,0,0,,Сіз аумақтық жекпе-жекке өзіңіз қатысуды жоспарлап отырсыз ба?
Dialogue: 0,0:03:26.87,0:03:29.00,Default,,0,0,0,,О, доғар, Дегоши!
Dialogue: 0,0:03:29.83,0:03:32.21,Default,,0,0,0,,Аты...
Dialogue: 0,0:03:32.29,0:03:35.59,Default,,0,0,0,,Бұл өте жаман, мені іздеуде.
Dialogue: 0,0:03:35.59,0:03:36.21,Default,,0,0,0,,Бұл өте жаман, мені іздеуде.
Dialogue: 0,0:03:35.59,0:03:36.21,Default,,0,0,0,,(Көрермендер мазақ етеді)
Dialogue: 0,0:03:36.21,0:03:37.05,Default,,0,0,0,,(Көрермендер мазақ етеді)
Dialogue: 0,0:03:37.05,0:03:39.01,Default,,0,0,0,,(Көрермендер мазақ етеді)
Dialogue: 0,0:03:37.05,0:03:39.01,Default,,0,0,0,,Осы жерге шын аты-жөніңізді жазсаңыз...
Dialogue: 0,0:03:39.01,0:03:39.59,Default,,0,0,0,,(Көрермендер мазақ етеді)
Dialogue: 0,0:03:40.42,0:03:42.80,Default,,0,0,0,,Бірақ бүркеншік есімдерді ұнатпаймын.
Dialogue: 0,0:03:43.51,0:03:46.18,Default,,0,0,0,,Қауынмен әділ және шаршы алаңға тартқым келеді.
Dialogue: 0,0:03:47.64,0:03:49.47,Default,,0,0,0,,Сондықтан, егер Урарака ханым алғашқы қадамды жасаса…
Dialogue: 0,0:03:49.97,0:03:51.81,Default,,0,0,0,,Жақсы емес, менің сиям бітті.
Dialogue: 0,0:03:54.15,0:03:55.31,Default,,0,0,0,,О, бұл да
Dialogue: 0,0:03:55.90,0:03:57.40,Default,,0,0,0,,Бір минут, Ұсуке.
Dialogue: 0,0:03:57.98,0:04:00.69,Default,,0,0,0,,Бізге жаңа қатысушы келгеніне біраз уақыт болды.
Dialogue: 0,0:04:00.78,0:04:01.74,Default,,0,0,0,,Әрине
Dialogue: 0,0:04:03.86,0:04:05.91,Default,,0,0,0,,«Легоси»
Dialogue: 0,0:04:06.41,0:04:08.87,Default,,0,0,0,,Жақсы, өйткені сіз оны оқи аласыз.
Dialogue: 0,0:04:08.95,0:04:11.50,Default,,0,0,0,,Сырттай сұсты кейіпкерлер
Dialogue: 0,0:04:12.08,0:04:13.29,Default,,0,0,0,,Қауын!
Dialogue: 0,0:04:13.37,0:04:17.04,Default,,0,0,0,,Сіз шынымен менің туған күнімді шатастырдыңыз.
Dialogue: 0,0:04:17.13,0:04:18.80,Default,,0,0,0,,Шишигуми ше?
Dialogue: 0,0:04:18.88,0:04:20.63,Default,,0,0,0,,Жоқ бар ма?
Dialogue: 0,0:04:20.71,0:04:25.34,Default,,0,0,0,,Бірақ сен мені таң қалдырдың.
Dialogue: 0,0:04:25.93,0:04:28.39,Default,,0,0,0,,Артқы нарықта аумақты алғыңыз келе ме?
Dialogue: 0,0:04:28.47,0:04:29.47,Default,,0,0,0,,Жоқ
Dialogue: 0,0:04:30.10,0:04:32.14,Default,,0,0,0,,Мен осында көрінсем, сенімен кездесермін деп ойладым.
Dialogue: 0,0:04:32.23,0:04:35.98,Default,,0,0,0,,Сіз менімен қоғамдық орындарда сөйлесуді жоспарлайсыз ба?
Dialogue: 0,0:04:36.60,0:04:39.57,Default,,0,0,0,,А... сіз ерекше болғыңыз келе ме?
Dialogue: 0,0:04:39.65,0:04:42.82,Default,,0,0,0,,Мен сені кез келген жерде ұстай аламын
Dialogue: 0,0:04:42.90,0:04:44.15,Default,,0,0,0,,Иә
Dialogue: 0,0:04:44.24,0:04:49.03,Default,,0,0,0,,Басқаша айтқанда, бұл жерде бір-бірімен төбелесуге болады.
Dialogue: 0,0:04:49.12,0:04:51.74,Default,,0,0,0,,(Екі айқайлау)
Dialogue: 0,0:04:51.83,0:04:52.95,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:04:53.83,0:04:56.54,Default,,0,0,0,,Ұрысқың келсе, сол күні істе.
Dialogue: 0,0:04:56.62,0:04:59.00,Default,,0,0,0,,Алдымен сынақтан өтіңіз
Dialogue: 0,0:04:59.09,0:04:59.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:01.67,0:05:03.46,Default,,0,0,0,,Е... бұл не? Бұл
Dialogue: 0,0:05:03.55,0:05:06.26,Default,,0,0,0,,Жануарлар қоғамы туралы негізгі білім викторинасы
Dialogue: 0,0:05:06.34,0:05:08.59,Default,,0,0,0,,Артқы нарықты басқаратын аңға
Dialogue: 0,0:05:08.68,0:05:12.02,Default,,0,0,0,,Ол тек жауыздықты ғана емес, сонымен қатар ақылды да қажет етеді.
Dialogue: 0,0:05:12.10,0:05:13.64,Default,,0,0,0,,Үйге бара аламын ба?
Dialogue: 0,0:05:13.73,0:05:14.64,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:05:14.73,0:05:17.65,Default,,0,0,0,,Шиши тобында болсаңыз да, бірінші рет қатысып отырсыз.
Dialogue: 0,0:05:17.73,0:05:20.23,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:05:20.32,0:05:23.53,Default,,0,0,0,,Иә, мен соғысқа қатысамын.
Dialogue: 0,0:05:24.11,0:05:24.99,Default,,0,0,0,,Хааа~
Dialogue: 0,0:05:25.07,0:05:27.53,Default,,0,0,0,,Иә, әлгі қасқыр.
Dialogue: 0,0:05:27.61,0:05:30.95,Default,,0,0,0,,Сіз астыртын базармен не істеуді жоспарлап отырсыз?
Dialogue: 0,0:05:31.03,0:05:32.70,Default,,0,0,0,,Ережелер қарапайым
Dialogue: 0,0:05:32.79,0:05:37.12,Default,,0,0,0,,Легоши викторинаға жауап беру арқылы жеңіске жетсе, ол қатысу құқығын алады.
Dialogue: 0,0:05:37.21,0:05:41.29,Default,,0,0,0,,Жеңілсең, жоғарыдан алтын шашлық келеді.
Dialogue: 0,0:05:41.38,0:05:43.21,Default,,0,0,0,,-Неге тек мен? -Хмф
Dialogue: 0,0:05:43.30,0:05:47.55,Default,,0,0,0,,Шиши-гумиге сенім мен тәжірибенің ұзақ тарихы бар.
Dialogue: 0,0:05:47.63,0:05:50.43,Default,,0,0,0,,Легоши мырза, енді бас тартатын кез келді.
Dialogue: 0,0:05:50.51,0:05:52.06,Default,,0,0,0,,Бірақ ол екі жылдан бері қоғамдық сахнаға шыққан жоқ
Dialogue: 0,0:05:52.14,0:05:53.93,Default,,0,0,0,,Сіз жеңе аласыз, әрине.
Dialogue: 0,0:05:54.02,0:05:56.02,Default,,0,0,0,,бастайық
Dialogue: 0,0:05:56.52,0:05:57.52,Default,,0,0,0,,(Сұрақтық дыбыс әсерлері)
Dialogue: 0,0:05:57.60,0:06:00.98,Default,,0,0,0,,Құстарға арналған таксидің бастапқы бағасы қандай?
Dialogue: 0,0:06:02.15,0:06:03.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:03.15,0:06:06.15,Default,,0,0,0,,3км-ден аз жолаушылар үшін 520 иен
Dialogue: 0,0:06:06.24,0:06:08.99,Default,,0,0,0,,720 иенден астам
Dialogue: 0,0:06:09.07,0:06:10.20,Default,,0,0,0,,(дұрыс жауап дыбыс әсері)
Dialogue: 0,0:06:10.28,0:06:11.12,Default,,0,0,0,,Бірақ соғыс жыртқыштары сиқыр қолдана алмайды ғой, иә?
Dialogue: 0,0:06:11.66,0:06:12.66,Default,,0,0,0,,(Сұрақ дыбыс әсерлері)
Dialogue: 0,0:06:13.20,0:06:16.50,Default,,0,0,0,,Тасбақаның қоғамдық киім туралы жарлығының мазмұны қандай?
Dialogue: 0,0:06:17.96,0:06:21.50,Default,,0,0,0,,Егер сіздің мойныңызға жағаңыз болса, сіз толығымен жалаңаш бола аласыз.
Dialogue: 0,0:06:21.58,0:06:22.84,Default,,0,0,0,,(Дұрыс жауап дыбыс әсері)
Dialogue: 0,0:06:24.63,0:06:27.92,Default,,0,0,0,,-де біз бұл құйрықтардың эмоцияларын түсіндіреміз.
Dialogue: 0,0:06:28.01,0:06:29.84,Default,,0,0,0,,үшінн оқу
Dialogue: 0,0:06:30.84,0:06:31.76,Default,,0,0,0,,Жоғарыдан төменге
Dialogue: 0,0:06:31.84,0:06:34.06,Default,,0,0,0,,«Мен шешімдімін» «Менің ішім ауырады»
Dialogue: 0,0:06:34.14,0:06:36.93,Default,,0,0,0,,«Тазалау тезірек жүреді» «Мен кеше таңертең драманы жіберіп алдым»
Dialogue: 0,0:06:37.02,0:06:38.18,Default,,0,0,0,,(Дұрыс жауап дыбыс әсері)
Dialogue: 0,0:06:38.27,0:06:39.10,Default,,0,0,0,,үшін дұрыс
Dialogue: 0,0:06:39.19,0:06:40.48,Default,,0,0,0,,Оши!
Dialogue: 0,0:06:40.56,0:06:41.56,Default,,0,0,0,,4 ұпай қосылды
Dialogue: 0,0:06:41.65,0:06:44.48,Default,,0,0,0,,Сәлем! Бұл жігіт ит.
Dialogue: 0,0:06:44.57,0:06:47.44,Default,,0,0,0,,Құйрық тілі тым көп қызмет көрсету мәселесі.
Dialogue: 0,0:06:47.53,0:06:48.44,Default,,0,0,0,,(Легошидің күлкісі)
Dialogue: 0,0:06:48.53,0:06:52.78,Default,,0,0,0,,Иә, бұл сәл әділетсіздік болды.
Dialogue: 0,0:06:52.87,0:06:55.20,Default,,0,0,0,,Енді 1 ұпай.
Dialogue: 0,0:06:55.28,0:06:56.99,Default,,0,0,0,,Иә, бұл қиын!
Dialogue: 0,0:06:57.50,0:07:00.33,Default,,0,0,0,,Ол іздеуде жүрген қасқыр емес пе?
Dialogue: 0,0:07:00.41,0:07:01.71,Default,,0,0,0,,О, бұл
Dialogue: 0,0:07:01.79,0:07:04.54,Default,,0,0,0,,Келесі есептен деңгейді сәл көтерейік.
Dialogue: 0,0:07:04.63,0:07:06.34,Default,,0,0,0,,(Сұрақтық дыбыс әсерлері)
Dialogue: 0,0:07:06.42,0:07:08.67,Default,,0,0,0,,Шөпқоректілер мен жыртқыштар
Dialogue: 0,0:07:08.76,0:07:10.93,Default,,0,0,0,,Бірқалыпты байланыс үшін—
Dialogue: 0,0:07:11.01,0:07:13.68,Default,,0,0,0,,Ең қолайлы уақыт қандай?
Dialogue: 0,0:07:14.60,0:07:15.51,Default,,0,0,0,,Хайаааа
Dialogue: 0,0:07:15.60,0:07:17.35,Default,,0,0,0,,8.00-ден 10.00-ге дейін.
Dialogue: 0,0:07:17.43,0:07:19.31,Default,,0,0,0,,Ал, таңертең...
Dialogue: 0,0:07:20.43,0:07:21.81,Default,,0,0,0,,-Эй, Легоши -Хмм?
Dialogue: 0,0:07:21.89,0:07:24.52,Default,,0,0,0,,Мен бұрын кіммен сөйлескенімді тап?
Dialogue: 0,0:07:24.61,0:07:25.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:26.11,0:07:27.36,Default,,0,0,0,,Таңертеңгі иіскеу
Dialogue: 0,0:07:27.94,0:07:30.57,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:07:30.65,0:07:32.03,Default,,0,0,0,,Бұл теке ме?
Dialogue: 0,0:07:32.11,0:07:34.32,Default,,0,0,0,,Джек таңертең шөпқоректілермен жиі ойнайды.
Dialogue: 0,0:07:34.41,0:07:36.95,Default,,0,0,0,,Менің ойымша, бұл ет жейтіндердің этикасы деп аталады.
Dialogue: 0,0:07:37.54,0:07:41.12,Default,,0,0,0,,Таңертеңгі күн сәулесінің әсеріне ұшыраған жануарлар миға серотонин деп аталатын химиялық зат бөледі...
Dialogue: 0,0:07:41.21,0:07:43.71,Default,,0,0,0,,Таңертеңгілік күннің шуағын шашу барлығын бақытты етеді!
Dialogue: 0,0:07:43.79,0:07:47.21,Default,,0,0,0,,Хмм, жарайды.
Dialogue: 0,0:07:47.30,0:07:48.25,Default,,0,0,0,,Дұрыс
Dialogue: 0,0:07:48.34,0:07:49.63,Default,,0,0,0,,(дұрыс жауап дыбыс әсері)
Dialogue: 0,0:07:49.71,0:07:51.13,Default,,0,0,0,,Келесі сұрақ
Dialogue: 0,0:07:51.22,0:07:52.43,Default,,0,0,0,,(Сұрақтық дыбыс әсерлері)
Dialogue: 0,0:07:52.51,0:07:55.60,Default,,0,0,0,,Неліктен мысықтардың қарашықтары үлкенірек?
Dialogue: 0,0:07:55.68,0:07:58.93,Default,,0,0,0,,Қараңғы жерде жүргенде ше?
Dialogue: 0,0:07:59.81,0:08:02.48,Default,,0,0,0,,Дәмді нәрсе жегенде емес...
Dialogue: 0,0:08:04.65,0:08:06.11,Default,,0,0,0,,О, Билл!
Dialogue: 0,0:08:06.19,0:08:09.23,Default,,0,0,0,,Тың қыз үш күріш шарын жеуге лайық емес.
Dialogue: 0,0:08:09.32,0:08:12.20,Default,,0,0,0,,Менің сүйікті ламинария күріш шары...
Dialogue: 0,0:08:13.32,0:08:14.95,Default,,0,0,0,,Дәмді!
Dialogue: 0,0:08:16.37,0:08:19.12,Default,,0,0,0,,Жақын достарымен ойнағанда
Dialogue: 0,0:08:19.20,0:08:20.04,Default,,0,0,0,,Бірақ соғыс жыртқыштары сиқыр қолдана алмайды ғой, иә?
Dialogue: 0,0:08:20.12,0:08:20.87,Default,,0,0,0,,(Дұрыс жауап дыбыс әсері)
Dialogue: 0,0:08:20.95,0:08:22.71,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:08:23.54,0:08:25.12,Default,,0,0,0,,Дұрыс түсінсең қызық
Dialogue: 0,0:08:25.21,0:08:26.58,Default,,0,0,0,,Өйткені бұл викторина
Dialogue: 0,0:08:26.67,0:08:28.63,Default,,0,0,0,,Аа, менің айтқым келгені бұл емес еді.
Dialogue: 0,0:08:28.71,0:08:32.42,Default,,0,0,0,,Мен көп нәрсені біліп, ересек адам болғым келеді.
Dialogue: 0,0:08:32.51,0:08:34.30,Default,,0,0,0,,Қауын Сіз туралы да...
Dialogue: 0,0:08:34.38,0:08:35.51,Default,,0,0,0,,(арқан үзілген дыбыс)
Dialogue: 0,0:08:35.59,0:08:36.55,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:39.89,0:08:41.85,Default,,0,0,0,,Әрең қауіпсіз!
Dialogue: 0,0:08:41.93,0:08:44.64,Default,,0,0,0,,Арқан ескірген сияқты.
Dialogue: 0,0:08:44.73,0:08:46.73,Default,,0,0,0,,Ух... қауын
Dialogue: 0,0:08:48.31,0:08:49.27,Default,,0,0,0,,Рахмет
Dialogue: 0,0:08:50.07,0:08:53.53,Default,,0,0,0,,Шынымды айтсам, сіз бүлініп қалдыңыз.
Dialogue: 0,0:08:53.61,0:08:54.32,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:08:56.03,0:08:58.57,Default,,0,0,0,,Бұл жеткілікті.
Dialogue: 0,0:08:58.66,0:09:02.66,Default,,0,0,0,,Бұл жігіт те шым соғысқа қатыссын.
Dialogue: 0,0:09:02.75,0:09:04.25,Default,,0,0,0,,Сол сәтте, контекстке қарамастан, мен бұл тіркесті «дәптерді лақтыру» деген мағынада қолданамын.
Dialogue: 0,0:09:04.33,0:09:05.54,Default,,0,0,0,,Легоши
Dialogue: 0,0:09:06.25,0:09:11.88,Default,,0,0,0,,Мен саған дайындаған үмітсіздікте өлуге рұқсат етемін.
Dialogue: 0,0:09:11.96,0:09:14.84,Default,,0,0,0,,Махаббат еті күніне міндетті түрде келіңіз
Dialogue: 0,0:09:14.92,0:09:16.13,Default,,0,0,0,,Әрине
Dialogue: 0,0:09:17.34,0:09:18.09,Default,,0,0,0,,Ал сосын!
Dialogue: 0,0:09:18.76,0:09:23.10,Default,,0,0,0,,Бұл шайқас шешілгенше Хару-чанға тиіспеңіз.
Dialogue: 0,0:09:24.43,0:09:25.27,Default,,0,0,0,,О
Dialogue: 0,0:09:26.73,0:09:31.98,Default,,0,0,0,,Мен қабіріңнің алдында Халдың дәмін татамын.
Dialogue: 0,0:09:41.99,0:09:42.99,Default,,0,0,0,,Луис
Dialogue: 0,0:09:45.00,0:09:46.00,Default,,0,0,0,,Луис
Dialogue: 0,0:09:47.25,0:09:48.37,Default,,0,0,0,,Иә
Dialogue: 0,0:09:48.46,0:09:51.92,Default,,0,0,0,,Мен Азуки-санның жағдайы жақсы ма деп сұраймын.
Dialogue: 0,0:09:52.00,0:09:55.80,Default,,0,0,0,,А... Иә, жақсы, өзімізше.
Dialogue: 0,0:09:57.13,0:10:00.34,Default,,0,0,0,,Түсіндім, сонда жеңілдеп қалдым.
Dialogue: 0,0:10:02.01,0:10:03.85,Default,,0,0,0,,Тіпті бұл сізді алаңдататын нәрсе болса да?
Dialogue: 0,0:10:04.56,0:10:08.56,Default,,0,0,0,,Сіз менің ниетімді дұрыс түсіндіңіз деп ойлаймын.
Dialogue: 0,0:10:08.64,0:10:10.44,Default,,0,0,0,,Келесі сәтте
Dialogue: 0,0:10:10.52,0:10:14.11,Default,,0,0,0,,Алғыссыз жыртқыштай азу тістерін жалаңаштады
Dialogue: 0,0:10:14.69,0:10:16.32,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:10:25.83,0:10:27.91,Default,,0,0,0,,Әкім сізге айтар еді.
Dialogue: 0,0:10:28.50,0:10:31.88,Default,,0,0,0,,Аяғыңызды жеген қасқыр ұсталғанша...
Dialogue: 0,0:10:32.46,0:10:35.30,Default,,0,0,0,,Қажетсіз назар аудармаңыз
Dialogue: 0,0:10:35.38,0:10:38.01,Default,,0,0,0,,Енді солай ма?
Dialogue: 0,0:10:38.84,0:10:42.30,Default,,0,0,0,,Сіздің сол қасқырмен қарым-қатынасыңыз әшкере болды.
Dialogue: 0,0:10:42.39,0:10:44.47,Default,,0,0,0,,Сіз ұтылатын адамсыз.
Dialogue: 0,0:10:46.43,0:10:49.89,Default,,0,0,0,,Олай болса, менің де сенен сұрайын дегенім бар.
Dialogue: 0,0:10:49.98,0:10:54.32,Default,,0,0,0,,Біз Зулимпиадаға демеушілерді жинау үшін ойын-сауық үшін төлеп жатырмыз.
Dialogue: 0,0:10:54.40,0:10:56.11,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:10:56.65,0:10:58.19,Default,,0,0,0,,Бұл бәрі емес
Dialogue: 0,0:10:58.90,0:11:03.74,Default,,0,0,0,,Zulympia алаңының құрылысына 3 млрд. Жарнамаға 5 млрд
Dialogue: 0,0:11:04.37,0:11:07.75,Default,,0,0,0,,Демеушілік қаражаттың 80%-ы
Dialogue: 0,0:11:07.83,0:11:10.37,Default,,0,0,0,,Хорнс Зайбатсу басып шығарған.
Dialogue: 0,0:11:10.46,0:11:13.83,Default,,0,0,0,,Бұл әкімнің тапсырмасы.
Dialogue: 0,0:11:16.63,0:11:19.92,Default,,0,0,0,,Сіз үшін ең маңыздысы сандар
Dialogue: 0,0:11:20.01,0:11:24.72,Default,,0,0,0,,Барлық аңдармен қарым-қатынас қаншалықты тиімді?
Dialogue: 0,0:11:24.80,0:11:28.81,Default,,0,0,0,,Бұл тек Horns конгломератының қаржылық профицитіне әкелуі керек еді.
Dialogue: 0,0:11:28.89,0:11:31.81,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:11:32.65,0:11:35.65,Default,,0,0,0,,Сіз қашан бухгалтерлік аудитор болдыңыз?
Dialogue: 0,0:11:36.40,0:11:38.44,Default,,0,0,0,,Құпия кітапты тапты
Dialogue: 0,0:11:39.24,0:11:43.49,Default,,0,0,0,,Сіз әкімді шығынмен қаржыландырып жатырсыз.
Dialogue: 0,0:11:44.53,0:11:47.12,Default,,0,0,0,,Сіз қандай есеп жүргізіп жатырсыз?
Dialogue: 0,0:11:47.95,0:11:49.91,Default,,0,0,0,,Сіз жауап беруге міндетті емессіз.
Dialogue: 0,0:11:50.00,0:11:51.75,Default,,0,0,0,,Жоқ, бар.
Dialogue: 0,0:11:52.58,0:11:54.42,Default,,0,0,0,,Мүйіздердің мұрагері
Dialogue: 0,0:11:54.50,0:11:55.88,Default,,0,0,0,,Қағазда
Dialogue: 0,0:11:57.04,0:11:57.96,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:58.05,0:12:00.63,Default,,0,0,0,,Ит өсіргенім есімде жоқ.
Dialogue: 0,0:12:01.38,0:12:02.97,Default,,0,0,0,,Айналаңа иіскеуді доғар.
Dialogue: 0,0:12:15.15,0:12:16.86,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:12:20.36,0:12:21.44,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:12:21.53,0:12:22.61,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:12:23.74,0:12:26.78,Default,,0,0,0,,(Кіріс қоңыраудың діріл дыбысы)
Dialogue: 0,0:12:31.66,0:12:33.62,Default,,0,0,0,,(Жарқанаттың дауысы мен айқайы)
Dialogue: 0,0:12:34.92,0:12:36.13,Default,,0,0,0,,(Балапан жылауы)
Dialogue: 0,0:12:37.96,0:12:40.88,Default,,0,0,0,,Менің ойларым дұрыс болса...
Dialogue: 0,0:12:41.92,0:12:43.42,Default,,0,0,0,,Жыртқыштардың қаны
Dialogue: 0,0:12:45.47,0:12:47.18,Default,,0,0,0,,Шөпқоректілердің қаны
Dialogue: 0,0:12:48.68,0:12:50.72,Default,,0,0,0,,Хехе, еңбегіңіз үшін рахмет.
Dialogue: 0,0:13:06.78,0:13:12.20,Default,,0,0,0,,(Балапан жылауы)
Dialogue: 0,0:13:13.37,0:13:17.33,Default,,0,0,0,,(әлсіреу)
Dialogue: 0,0:13:18.25,0:13:22.30,Default,,0,0,0,,Микстің керемет сезімі мақтауға тұрарлық.
Dialogue: 0,0:13:22.38,0:13:23.88,Default,,0,0,0,,Бұл да әлсіздік.
Dialogue: 0,0:13:23.96,0:13:24.55,Default,,0,0,0,,(сөмкенің дыбысы)
Dialogue: 0,0:13:24.63,0:13:25.34,Default,,0,0,0,,​​О?
Dialogue: 0,0:13:25.97,0:13:26.51,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:26.59,0:13:30.93,Default,,0,0,0,,(Десиконың қиын дауысы)
Dialogue: 0,0:13:41.77,0:13:42.73,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:44.78,0:13:49.66,Default,,0,0,0,,(Десиконың мазасыз дауысы)
Dialogue: 0,0:13:54.50,0:13:56.04,Default,,0,0,0,,(Су ыдысына соғылған дыбыс)
Dialogue: 0,0:14:14.64,0:14:15.81,Default,,0,0,0,,Десико мырза!
Dialogue: 0,0:14:15.89,0:14:18.35,Default,,0,0,0,,Дешико мырза, Дешико мырза!
Dialogue: 0,0:14:19.85,0:14:23.90,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:14:23.98,0:14:26.61,Default,,0,0,0,,(Экипаж мүшесі 1) Жұмысты жалғастырып, қазынаны көрсекші.
Dialogue: 0,0:14:29.11,0:14:30.86,Default,,0,0,0,,Не болды?
Dialogue: 0,0:14:30.95,0:14:32.58,Default,,0,0,0,,Қауын
Dialogue: 0,0:14:32.66,0:14:34.37,Default,,0,0,0,,Қауын өлтірді
Dialogue: 0,0:14:35.08,0:14:37.91,Default,,0,0,0,,Ха ха... Хакция
Dialogue: 0,0:14:38.91,0:14:41.71,Default,,0,0,0,,Себебі мен қоспаның әлсіз жерін таптым
Dialogue: 0,0:14:41.79,0:14:42.42,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:14:42.50,0:14:44.04,Default,,0,0,0,,Араластың әлсіз жақтары?
Dialogue: 0,0:14:44.13,0:14:45.17,Default,,0,0,0,,Иә
Dialogue: 0,0:14:46.34,0:14:47.51,Default,,0,0,0,,Ууух!
Dialogue: 0,0:14:49.09,0:14:54.51,Default,,0,0,0,,Ет және шөпқоректілердің қанын араластырып қыздырғанда түзілетін газ.
Dialogue: 0,0:14:54.60,0:14:58.18,Default,,0,0,0,,Ондағы қандай да бір заттың әсерінен
Dialogue: 0,0:14:58.27,0:15:01.10,Default,,0,0,0,,Микс ішімдік ішкен сияқты
Dialogue: 0,0:15:01.19,0:15:02.94,Default,,0,0,0,,А, онда...
Dialogue: 0,0:15:03.02,0:15:06.98,Default,,0,0,0,,Қауынға қолдансаңыз, ұстай аласыз.
Dialogue: 0,0:15:07.57,0:15:09.86,Default,,0,0,0,,Құнды ақпаратыңыз үшін рахмет
Dialogue: 0,0:15:09.95,0:15:10.65,Default,,0,0,0,,Ендеше бастайық...
Dialogue: 0,0:15:10.74,0:15:12.95,Default,,0,0,0,,Оңай емес
Dialogue: 0,0:15:13.03,0:15:13.57,Default,,0,0,0,,Фалько…
Dialogue: 0,0:15:15.08,0:15:20.79,Default,,0,0,0,,Етқоректілер мен шөпқоректілердің қанын араластырса, ол бірден ұйып қалады.
Dialogue: 0,0:15:20.87,0:15:23.79,Default,,0,0,0,,Газ бір сәтте пайда болады
Dialogue: 0,0:15:23.88,0:15:26.84,Default,,0,0,0,,Үлкен аңды өлтіруге тоймайсың.
Dialogue: 0,0:15:26.92,0:15:29.21,Default,,0,0,0,,Бірақ ұрыс даласы...
Dialogue: 0,0:15:29.30,0:15:32.30,Default,,0,0,0,,Өйткені көп қан төгілді
Dialogue: 0,0:15:33.09,0:15:35.47,Default,,0,0,0,,Мен түсіндім... жоқ па?
Dialogue: 0,0:15:35.55,0:15:36.64,Default,,0,0,0,,Неге ол бізді өзінен алыстатқысы келеді?
Dialogue: 0,0:15:37.43,0:15:38.18,Default,,0,0,0,,Хаха… бұл қызық екен.
Dialogue: 0,0:15:38.27,0:15:39.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:39.43,0:15:41.02,Default,,0,0,0,,Онда не айтылған?
Dialogue: 0,0:15:41.60,0:15:46.02,Default,,0,0,0,,Басқа нәсілдердің қанының ұюына жол бермейтін зат бар сияқты.
Dialogue: 0,0:15:46.11,0:15:51.40,Default,,0,0,0,,Бұл арқылы қанның аз мөлшері де жеткілікті нәтиже бере алады.
Dialogue: 0,0:15:51.49,0:15:52.91,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:15:52.99,0:15:55.87,Default,,0,0,0,,Бірақ оны қалай алуға болады?
Dialogue: 0,0:15:55.95,0:15:56.74,Default,,0,0,0,,Иә
Dialogue: 0,0:15:57.33,0:15:59.08,Default,,0,0,0,,Менің ойымша, бұл сізге байланысты.
Dialogue: 0,0:16:02.16,0:16:04.54,Default,,0,0,0,,Әй, менің зертханам.
Dialogue: 0,0:16:04.63,0:16:05.79,Default,,0,0,0,,Иә
Dialogue: 0,0:16:05.88,0:16:08.75,Default,,0,0,0,,Түсіндім, рахмет.
Dialogue: 0,0:16:09.51,0:16:11.84,Default,,0,0,0,,О, сәл күте тұрыңыз.
Dialogue: 0,0:16:11.92,0:16:13.59,Default,,0,0,0,,Суық тиюден сақтаныңыз
Dialogue: 0,0:16:15.72,0:16:17.26,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:16:17.35,0:16:18.39,Default,,0,0,0,,Иә
Dialogue: 0,0:16:18.47,0:16:19.72,Default,,0,0,0,,Сіз жассыз.
Dialogue: 0,0:16:21.35,0:16:22.73,Default,,0,0,0,,Бұл қауіпті.
Dialogue: 0,0:16:22.81,0:16:25.35,Default,,0,0,0,,Пальмалардың санын азайтудан басқа амалымыз жоқ.
Dialogue: 0,0:16:25.44,0:16:28.02,Default,,0,0,0,,Мынаны-мынаны істесең, уақытында үлгере алмайсың.
Dialogue: 0,0:16:28.11,0:16:29.15,Default,,0,0,0,,бірінші кезекте —
Dialogue: 0,0:16:29.23,0:16:31.78,Default,,0,0,0,,Оны неге қойманың сыртына қалдырдың?
Dialogue: 0,0:16:31.86,0:16:33.78,Default,,0,0,0,,Бояу құрғақ емес.
Dialogue: 0,0:16:33.86,0:16:35.91,Default,,0,0,0,,Болжам бойынша дауыл болады!
Dialogue: 0,0:16:35.99,0:16:37.45,Default,,0,0,0,,Оның не екенін кейінірек айта аласыз!
Dialogue: 0,0:16:37.53,0:16:38.83,Default,,0,0,0,,Басыңды пайдалансаң, түсінесің!
Dialogue: 0,0:16:38.91,0:16:39.74,Default,,0,0,0,,Не?
Dialogue: 0,0:16:39.83,0:16:42.45,Default,,0,0,0,,Оны тоқтатыңыз, тек қолмен орындаңыз.
Dialogue: 0,0:16:42.54,0:16:44.04,Default,,0,0,0,,Иә, менің уақытым жоқ.
Dialogue: 0,0:16:44.12,0:16:44.71,Default,,0,0,0,,(Дауласып жатқан мүшелердің дауысы)
Dialogue: 0,0:16:44.71,0:16:47.63,Default,,0,0,0,,(Дауласып жатқан мүшелердің дауысы)
Dialogue: 0,0:16:44.71,0:16:47.63,Default,,0,0,0,,Бұл атмосферамен не істеуім керек?
Dialogue: 0,0:16:47.63,0:16:47.71,Default,,0,0,0,,(Дауласып жатқан мүшелердің дауысы)
Dialogue: 0,0:16:47.71,0:16:49.92,Default,,0,0,0,,(Дауласып жатқан мүшелердің дауысы)
Dialogue: 0,0:16:47.71,0:16:49.92,Default,,0,0,0,,Осындай жағдайда не істеу керек?
Dialogue: 0,0:16:50.00,0:16:52.34,Default,,0,0,0,,Ит сияқты жарқыра?
Dialogue: 0,0:16:52.92,0:16:54.30,Default,,0,0,0,,үшін...
Dialogue: 0,0:16:54.30,0:16:55.22,Default,,0,0,0,,үшін...
Dialogue: 0,0:16:54.30,0:16:55.22,Default,,0,0,0,,(ағаш сынған дыбыс)
Dialogue: 0,0:16:55.30,0:16:56.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:57.26,0:16:58.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:59.47,0:17:00.93,Default,,0,0,0,,Мен енді мұны істей алмаймын.
Dialogue: 0,0:17:01.52,0:17:02.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:02.47,0:17:05.60,Default,,0,0,0,,Менің ойымша, қазір бас тартқан дұрыс.
Dialogue: 0,0:17:06.27,0:17:07.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:08.02,0:17:10.86,Default,,0,0,0,,үшін да солай ойлайды, солай ма?
Dialogue: 0,0:17:11.36,0:17:14.24,Default,,0,0,0,,Сәттілік бізге артта қалды
Dialogue: 0,0:17:14.82,0:17:18.16,Default,,0,0,0,,Метеорит фестивалі де жаңбыр жауады деп болжануда, сондықтан ол тоқтатылуы мүмкін.
Dialogue: 0,0:17:18.24,0:17:19.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:22.24,0:17:23.50,Default,,0,0,0,,Және-
Dialogue: 0,0:17:23.58,0:17:28.21,Default,,0,0,0,,Легоси іздеуде болды, мен оны таба алмадым.
Dialogue: 0,0:17:28.29,0:17:34.47,Default,,0,0,0,,Лиздің оқиғасы мен Кибиді ренжіткенім ғой
Dialogue: 0,0:17:34.55,0:17:38.05,Default,,0,0,0,,Бұл жыртқыштар шөпқоректілермен бірге болғандықтан болды.
Dialogue: 0,0:17:38.14,0:17:41.22,Default,,0,0,0,,Заттар қаншалықты әдемі болса да, бұл шындық.
Dialogue: 0,0:17:41.31,0:17:42.93,Default,,0,0,0,,Дао…
Dialogue: 0,0:17:43.02,0:17:44.14,Default,,0,0,0,,Кешіріңіз, тары
Dialogue: 0,0:17:44.77,0:17:47.90,Default,,0,0,0,,Мен, өзіңе ыңғайлысын жаз.
Dialogue: 0,0:17:49.35,0:17:52.15,Default,,0,0,0,,Бұл жай ғана тілек.
Dialogue: 0,0:17:52.65,0:17:54.86,Default,,0,0,0,,Жай ғана тілек пе?
Dialogue: 0,0:17:54.94,0:17:56.36,Default,,0,0,0,,Сонымен не?
Dialogue: 0,0:17:56.45,0:17:57.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:57.95,0:18:01.58,Default,,0,0,0,,«Бір күні мен сені жеуім мүмкін».
Dialogue: 0,0:18:01.66,0:18:02.37,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:18:02.95,0:18:05.00,Default,,0,0,0,,Бұл кезең...
Dialogue: 0,0:18:05.08,0:18:06.75,Default,,0,0,0,,Сценарий жолдары
Dialogue: 0,0:18:07.29,0:18:09.96,Default,,0,0,0,,«Мен көпірдің арғы бетіне барамын»
Dialogue: 0,0:18:10.04,0:18:14.13,Default,,0,0,0,,«Егер шөпқоректілер болмаса, ешкімге зиян тимейді».
Dialogue: 0,0:18:14.88,0:18:17.76,Default,,0,0,0,,«Күте тұр, барма».
Dialogue: 0,0:18:17.84,0:18:20.59,Default,,0,0,0,,«Сен мені жемейсің.»
Dialogue: 0,0:18:20.68,0:18:22.47,Default,,0,0,0,,«Осы жерде қал.»
Dialogue: 0,0:18:22.97,0:18:24.64,Default,,0,0,0,,«Мен жаман адам болғым келмейді»
Dialogue: 0,0:18:25.31,0:18:27.02,Default,,0,0,0,,«Мен жай ғана қорқып тұрған жоқпын».
Dialogue: 0,0:18:27.10,0:18:30.48,Default,,0,0,0,,«Мен сені бұдан былай ренжіткім келмейді».
Dialogue: 0,0:18:31.48,0:18:32.65,Default,,0,0,0,,«Өйткені бұл маңызды»
Dialogue: 0,0:18:33.82,0:18:36.99,Default,,0,0,0,,Бұл жай ғана тілек пе?
Dialogue: 0,0:18:37.07,0:18:38.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:42.45,0:18:43.28,Default,,0,0,0,,(қабықтың жарылған дыбысы)
Dialogue: 0,0:18:43.37,0:18:44.16,Default,,0,0,0,,Сынған!
Dialogue: 0,0:18:44.24,0:18:44.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:44.95,0:18:48.54,Default,,0,0,0,,Мен тырыссам қолымнан келеді! тамаша!
Dialogue: 0,0:18:49.08,0:18:50.17,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:18:50.71,0:18:52.29,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:18:52.38,0:18:54.55,Default,,0,0,0,,Егер сіз тырыссаңыз, мұны істей аласыз
Dialogue: 0,0:18:55.38,0:18:57.71,Default,,0,0,0,,Соңына дейін барымызды салайық
Dialogue: 0,0:18:57.80,0:18:58.55,Default,,0,0,0,,О
Dialogue: 0,0:19:01.59,0:19:02.34,Default,,0,0,0,,Иә
Dialogue: 0,0:19:03.05,0:19:06.14,Default,,0,0,0,,Жақсы! Бәріміз оттайық!
Dialogue: 0,0:19:06.22,0:19:07.22,Default,,0,0,0,,Жарайды
Dialogue: 0,0:19:16.19,0:19:18.65,Default,,0,0,0,,20 метрден кейін оңға бұрылыңыз.
Dialogue: 0,0:19:18.74,0:19:20.11,Default,,0,0,0,,Иә? Ха...
Dialogue: 0,0:19:20.20,0:19:21.36,Default,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан қабырғаны бұзып өтті,
Dialogue: 0,0:19:21.45,0:19:24.24,Default,,0,0,0,,Zuzzle картасына сәйкес, мен артқы базардан өте аламын.
Dialogue: 0,0:19:30.00,0:19:31.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:45.76,0:19:50.81,Default,,0,0,0,,Ол кезде маған айына бір рет сыртын көруге рұқсат беретін.
Dialogue: 0,0:19:51.94,0:19:52.85,Default,,0,0,0,,Луи-сенпай?
Dialogue: 0,0:19:53.60,0:19:54.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:55.02,0:19:56.69,Default,,0,0,0,,А, сен мұнда неге келдің?
Dialogue: 0,0:19:59.19,0:20:02.65,Default,,0,0,0,,Сенпай! Рұқсатсыз кірсең ашуланасың!
Dialogue: 0,0:20:02.74,0:20:03.78,Default,,0,0,0,,Жарайды, солай ма?
Dialogue: 0,0:20:04.36,0:20:06.16,Default,,0,0,0,,Бұл менің ата-анамның үйі.
Dialogue: 0,0:20:06.24,0:20:07.53,Default,,0,0,0,,Д... ата-анамның үйі ме?
Dialogue: 0,0:20:08.49,0:20:11.54,Default,,0,0,0,,Бұл нені білдіреді? Ата-анаңның үйі қандай?
Dialogue: 0,0:20:11.62,0:20:13.25,Default,,0,0,0,,Дәл солай.
Dialogue: 0,0:20:13.33,0:20:15.21,Default,,0,0,0,,Бұл тірі жем қоймасы.
Dialogue: 0,0:20:16.04,0:20:17.75,Default,,0,0,0,,Мен осында өстім.
Dialogue: 0,0:20:18.30,0:20:23.05,Default,,0,0,0,,Мені сатып алған адам Horns конгломератының төрағасы болды.
Dialogue: 0,0:20:25.09,0:20:26.47,Default,,0,0,0,,Сіз таңданбайсыз.
Dialogue: 0,0:20:27.26,0:20:32.43,Default,,0,0,0,,Луи-сенпайдың үніне қарап, мен сабырмен тыңдағаным дұрыс деп ойладым.
Dialogue: 0,0:20:44.57,0:20:48.28,Default,,0,0,0,,Сіз бұл әлемді өзгерте аласыз.
Dialogue: 0,0:20:51.25,0:20:52.45,Default,,0,0,0,,Мен шештім
Dialogue: 0,0:20:53.66,0:20:55.21,Default,,0,0,0,,Мен енді ештеңені майыстырмаймын
Dialogue: 0,0:20:55.92,0:20:58.13,Default,,0,0,0,,Қолымнан келгеннің бәрін жасаймын.
Dialogue: 0,0:20:59.34,0:21:00.34,Default,,0,0,0,,Луи Сенпай
Dialogue: 0,0:21:01.42,0:21:05.59,Default,,0,0,0,,Мен ертең Қауынмен келісіп алайын деп жатырмын.
Dialogue: 0,0:21:05.68,0:21:07.22,Default,,0,0,0,,Қауын таптың ба?
Dialogue: 0,0:21:07.30,0:21:07.97,Default,,0,0,0,,Иә...
Dialogue: 0,0:21:08.47,0:21:11.72,Default,,0,0,0,,Шиши-гумидің бастығы ретінде мен аумақ үшін күресемін.
Dialogue: 0,0:21:11.81,0:21:13.73,Default,,0,0,0,,Сондықтан мен де қатысамын.
Dialogue: 0,0:21:13.81,0:21:17.56,Default,,0,0,0,,Ережелерді білесіз бе? Бұл ауыр шайқас
Dialogue: 0,0:21:17.65,0:21:21.90,Default,,0,0,0,,Ах... иә, солай...
Dialogue: 0,0:21:22.61,0:21:25.99,Default,,0,0,0,,Маған бірдеңе болса, онда...
Dialogue: 0,0:21:26.07,0:21:28.28,Default,,0,0,0,,Хару-чанға көп рахмет.
Dialogue: 0,0:21:28.37,0:21:31.12,Default,,0,0,0,,Ол өткен жылы мен жекпе-жек өткізген Лизге қарағанда басқа деңгейде.
Dialogue: 0,0:21:31.79,0:21:32.95,Default,,0,0,0,,Бір жануармен бұл мүмкін емес.
Dialogue: 0,0:21:33.66,0:21:38.04,Default,,0,0,0,,Ах... Бірақ мен әділ және бір-бірден төртбұрышпын...
Dialogue: 0,0:21:39.46,0:21:40.67,Default,,0,0,0,,Екі болса
Dialogue: 0,0:21:41.38,0:21:42.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:43.21,0:21:47.34,Default,,0,0,0,,Мен протезді аяғыммен және сен іздеудесің
Dialogue: 0,0:21:48.43,0:21:50.26,Default,,0,0,0,,Біз тоз-тоз болып қалдық, бірақ...
Dialogue: 0,0:21:51.14,0:21:52.72,Default,,0,0,0,,Иә...
Dialogue: 0,0:21:55.18,0:21:56.10,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:21:58.35,0:22:00.36,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:22:01.69,0:22:02.73,Default,,0,0,0,,Біз
Dialogue: 0,0:22:04.11,0:22:05.40,Default,,0,0,0,,Егер біз
Dialogue: 0,0:22:11.99,0:22:13.99,Default,,0,0,0,,♪～
Dialogue: 0,0:23:39.91,0:23:41.92,Default,,0,0,0,,～♪
