Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.67,0:00:14.68,Default,,0,0,0,,♪～
Dialogue: 0,0:01:39.93,0:01:41.93,Default,,0,0,0,,～♪
Dialogue: 0,0:01:51.56,0:01:53.65,Default,,0,0,0,,«Сен әрине күштісің».
Dialogue: 0,0:01:54.19,0:01:56.57,Default,,0,0,0,,«Бірақ сен мені жемейсің, солай ма?»
Dialogue: 0,0:01:57.95,0:02:00.95,Default,,0,0,0,,Хмм, тым мақтаншақ па?
Dialogue: 0,0:02:02.41,0:02:04.41,Default,,0,0,0,,«Сен әрине күштісің».
Dialogue: 0,0:02:04.49,0:02:07.62,Default,,0,0,0,,«Бірақ сен мені жемейсің, солай ма?»
Dialogue: 0,0:02:08.21,0:02:11.04,Default,,0,0,0,,Жоқ, бұл өте қорқынышты.
Dialogue: 0,0:02:11.13,0:02:14.59,Default,,0,0,0,,Бұл бала жыртқыш достарына сенеді.
Dialogue: 0,0:02:15.38,0:02:18.93,Default,,0,0,0,,Жоқ, бірақ сенім мен достық басқаша ма?
Dialogue: 0,0:02:19.55,0:02:20.51,Default,,0,0,0,,Не?
Dialogue: 0,0:02:21.05,0:02:24.26,Default,,0,0,0,,«Бірақ сен мені жемейсің, солай ма?»
Dialogue: 0,0:02:24.76,0:02:27.14,Default,,0,0,0,,Ах~! басқа!
Dialogue: 0,0:02:28.06,0:02:29.19,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:02:37.36,0:02:39.45,Default,,0,0,0,,«Сен әрине күштісің».
Dialogue: 0,0:02:40.53,0:02:42.99,Default,,0,0,0,,«Сен мені жемейсің, солай ма?»
Dialogue: 0,0:02:43.07,0:02:44.62,Default,,0,0,0,,(Лемур мен барыстың алаңдаушылық дауысы)
Dialogue: 0,0:02:44.70,0:02:46.87,Default,,0,0,0,,«Бірақ мен туралы...»
Dialogue: 0,0:02:46.95,0:02:49.83,Default,,0,0,0,,Қазірдің өзінде! Не істеп жатырсың, Джуно?
Dialogue: 0,0:02:49.91,0:02:50.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:51.37,0:02:53.84,Default,,0,0,0,,Аа, жоқ, бұл клубтың әрекеті...
Dialogue: 0,0:02:53.92,0:02:57.38,Default,,0,0,0,,Мен әрекет еткеніме қуаныштымын, қатты тырыспаңыз
Dialogue: 0,0:02:57.46,0:02:59.76,Default,,0,0,0,,Бұл бала салмақты.
Dialogue: 0,0:02:59.84,0:03:01.09,Default,,0,0,0,,Сіз салмақ қостыңыз, солай емес пе?
Dialogue: 0,0:03:01.18,0:03:01.93,Default,,0,0,0,,Иә! Өтірік?
Dialogue: 0,0:03:02.01,0:03:04.22,Default,,0,0,0,,Джуно уайымдаса тамақ ішеді.
Dialogue: 0,0:03:04.30,0:03:06.68,Default,,0,0,0,,Хехе, жарайды, жей бер!
Dialogue: 0,0:03:06.76,0:03:10.81,Default,,0,0,0,,Ей, Джуно, сен клубта жоғары сыныпта оқисың. Сіз бірдеңе естідіңіз бе?
Dialogue: 0,0:03:10.89,0:03:11.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:11.73,0:03:15.57,Default,,0,0,0,,Мен бір күні бірдеңе істейтінімді білдім, бірақ бұл жақын арада емес.
Dialogue: 0,0:03:15.65,0:03:18.23,Default,,0,0,0,,Жақсы, бірақ ол Beast Star үміткері болды.
Dialogue: 0,0:03:18.32,0:03:20.82,Default,,0,0,0,,Тоқта, сен не айтып тұрсың?
Dialogue: 0,0:03:20.90,0:03:22.78,Default,,0,0,0,,Иә? мен білмеймін?
Dialogue: 0,0:03:23.91,0:03:24.99,Default,,0,0,0,,Мынау және анау
Dialogue: 0,0:03:25.07,0:03:28.04,Default,,0,0,0,,Ол сонымен қатар Зулимпиада елшісі.
Dialogue: 0,0:03:28.12,0:03:30.58,Default,,0,0,0,,Алыстағы тіршілікке айналдың, солай емес пе?
Dialogue: 0,0:03:30.66,0:03:33.42,Default,,0,0,0,,Алғашында бұлттардың үстінде тұрғандай болды.
Dialogue: 0,0:03:33.50,0:03:37.42,Default,,0,0,0,,Дұрыс хахаха...
Dialogue: 0,0:03:37.50,0:03:39.80,Default,,0,0,0,,Не... Бұл не?
Dialogue: 0,0:03:39.88,0:03:41.97,Default,,0,0,0,,Мүмкін ол жоғары сынып оқушысы шығар?
Dialogue: 0,0:03:42.05,0:03:44.55,Default,,0,0,0,,Шай ішуге уақытыңыз таусылады ма?
Dialogue: 0,0:03:44.64,0:03:45.18,Default,,0,0,0,,(Қабылданған дыбыс)
Dialogue: 0,0:03:45.26,0:03:45.85,Default,,0,0,0,,Га
Dialogue: 0,0:03:49.10,0:03:50.52,Default,,0,0,0,,Бұл жәндік емес.
Dialogue: 0,0:03:53.98,0:03:55.36,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:03:55.44,0:03:57.52,Default,,0,0,0,,Асыңызды асықпай ішіңіз.
Dialogue: 0,0:03:58.40,0:03:59.19,Default,,0,0,0,,Ах
Dialogue: 0,0:04:01.28,0:04:02.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:03.24,0:04:04.28,Default,,0,0,0,,Гао!
Dialogue: 0,0:04:04.86,0:04:06.37,Default,,0,0,0,,Менің арыстаным
Dialogue: 0,0:04:09.41,0:04:10.33,Default,,0,0,0,,Иә, өтінемін
Dialogue: 0,0:04:10.41,0:04:11.29,Default,,0,0,0,,Рахмет
Dialogue: 0,0:04:11.37,0:04:12.87,Default,,0,0,0,,Бұл тек менің алаңдаулы жүрегімді жеделдетті
Dialogue: 0,0:04:13.46,0:04:14.79,Default,,0,0,0,,Сізге Арыстан мырза ұнай ма?
Dialogue: 0,0:04:14.87,0:04:17.59,Default,,0,0,0,,Иә, өскенде арыстан боламын.
Dialogue: 0,0:04:17.67,0:04:19.13,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:04:19.21,0:04:21.05,Default,,0,0,0,,Иә, өйткені ол сүйкімді
Dialogue: 0,0:04:22.92,0:04:23.88,Default,,0,0,0,,Хару-чан
Dialogue: 0,0:04:23.97,0:04:24.84,Default,,0,0,0,,Ах
Dialogue: 0,0:04:24.93,0:04:26.43,Default,,0,0,0,,6-кесте
Dialogue: 0,0:04:26.51,0:04:27.43,Default,,0,0,0,,Иә
Dialogue: 0,0:04:30.52,0:04:31.56,Default,,0,0,0,,Сен Құбыжықтарды жоюшылар корпусының мүшесі емессің бе?
Dialogue: 0,0:04:31.64,0:04:34.02,Default,,0,0,0,,Иә...
Dialogue: 0,0:04:44.78,0:04:47.32,Default,,0,0,0,,Сізді күттіргенім үшін кешіріңіз Уау... Ах!
Dialogue: 0,0:04:48.12,0:04:48.87,Default,,0,0,0,,Ах
Dialogue: 0,0:04:49.53,0:04:50.41,Default,,0,0,0,,Джуно мырза
Dialogue: 0,0:04:50.49,0:04:51.95,Default,,0,0,0,,Хару Сенпай
Dialogue: 0,0:04:53.45,0:04:54.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:54.96,0:04:56.50,Default,,0,0,0,,Осының бәрін жедің бе?
Dialogue: 0,0:04:56.58,0:04:58.67,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:04:59.46,0:05:01.21,Default,,0,0,0,,Айырмашылығы жоқ.
Dialogue: 0,0:05:02.05,0:05:03.01,Default,,0,0,0,,(Харудың ащы күлкісі)
Dialogue: 0,0:05:03.09,0:05:05.09,Default,,0,0,0,,А... жақсысың ба?
Dialogue: 0,0:05:05.59,0:05:09.14,Default,,0,0,0,,Мм... онда мен мұны төмендетемін.
Dialogue: 0,0:05:09.22,0:05:10.35,Default,,0,0,0,,Бұл!
Dialogue: 0,0:05:10.43,0:05:10.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:11.60,0:05:14.48,Default,,0,0,0,,Ертегіні тыңдай аласыз ба?
Dialogue: 0,0:05:19.44,0:05:21.23,Default,,0,0,0,,көремін.
Dialogue: 0,0:05:21.32,0:05:23.74,Default,,0,0,0,,Джуноның оны ұнататын күйеу жігіті бар.
Dialogue: 0,0:05:23.82,0:05:25.40,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:05:25.49,0:05:27.24,Default,,0,0,0,,Сонда ол қандай бала?
Dialogue: 0,0:05:27.32,0:05:29.91,Default,,0,0,0,,Мен ағамын.
Dialogue: 0,0:05:29.99,0:05:32.41,Default,,0,0,0,,Бүгін мен сіздермен спектакль туралы тағы сөйлескім келді...
Dialogue: 0,0:05:32.49,0:05:34.58,Default,,0,0,0,,Не? Драма клубы?
Dialogue: 0,0:05:34.66,0:05:38.33,Default,,0,0,0,,Ол осы көктемде бітірді, енді мұнда жоқ...
Dialogue: 0,0:05:38.42,0:05:39.92,Default,,0,0,0,,Осы жылы мектеп бітіреміз бе?
Dialogue: 0,0:05:40.00,0:05:42.75,Default,,0,0,0,,Мен сізбен байланысу үшін батылдым жинадым.
Dialogue: 0,0:05:42.84,0:05:45.72,Default,,0,0,0,,Олай болса! Мынаны қараңызшы
Dialogue: 0,0:05:45.80,0:05:47.51,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:05:47.59,0:05:48.97,Default,,0,0,0,,А... бұл Луис!
Dialogue: 0,0:05:49.05,0:05:50.18,Default,,0,0,0,,Жаман емес пе?
Dialogue: 0,0:05:51.01,0:05:54.10,Default,,0,0,0,,А... бұл сұмдық, соншалықты ойландыратын нәрсе.
Dialogue: 0,0:05:54.18,0:05:55.31,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:05:55.39,0:05:58.14,Default,,0,0,0,,Өйткені мен әрқашан үміт артатын істермен айналысамын...
Dialogue: 0,0:05:58.23,0:06:00.65,Default,,0,0,0,,Ол не істеп жатыр?
Dialogue: 0,0:06:00.73,0:06:02.82,Default,,0,0,0,,Мен жақсымын, айта аламын.
Dialogue: 0,0:06:02.90,0:06:06.03,Default,,0,0,0,,Бірақ бұл бала алмайды, ол салмақты.
Dialogue: 0,0:06:06.11,0:06:09.32,Default,,0,0,0,,Бұл баланың менімен тым көп хоббиі бар емес пе?
Dialogue: 0,0:06:09.41,0:06:12.70,Default,,0,0,0,,Сіз мектепте біреумен кездесіп көрдіңіз бе?
Dialogue: 0,0:06:12.78,0:06:13.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:13.79,0:06:15.75,Default,,0,0,0,,А... жоқ, жоқ, жоқ
Dialogue: 0,0:06:15.83,0:06:16.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:16.41,0:06:18.92,Default,,0,0,0,,А... жоқ, ол жерде жоқ шығар.
Dialogue: 0,0:06:19.00,0:06:20.54,Default,,0,0,0,,Біз құда болдық.
Dialogue: 0,0:06:20.63,0:06:21.79,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:06:23.29,0:06:26.42,Default,,0,0,0,,Бұл өкінішті, солай емес пе?
Dialogue: 0,0:06:26.51,0:06:28.26,Default,,0,0,0,,Мен өзім қалағандай ғашық бола алмаймын
Dialogue: 0,0:06:31.05,0:06:33.76,Default,,0,0,0,,Оның несі сізге ұнайды?
Dialogue: 0,0:06:34.43,0:06:35.31,Default,,0,0,0,,Хехе
Dialogue: 0,0:06:35.93,0:06:38.48,Default,,0,0,0,,Мен бәрінің алдында мінсізмін.
Dialogue: 0,0:06:39.06,0:06:40.81,Default,,0,0,0,,Бірақ шынымен...
Dialogue: 0,0:06:41.44,0:06:44.07,Default,,0,0,0,,Мен күштімін және әлсізмін.
Dialogue: 0,0:06:45.48,0:06:47.53,Default,,0,0,0,,Маған да ұнады.
Dialogue: 0,0:06:47.61,0:06:49.78,Default,,0,0,0,,Итермеудің сүйкімді жағы
Dialogue: 0,0:06:49.86,0:06:50.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:50.86,0:06:52.91,Default,,0,0,0,,«О, құдайым» деген сияқтысың.
Dialogue: 0,0:06:52.99,0:06:55.79,Default,,0,0,0,,Айналғанда бақытты көрінеді, ал...
Dialogue: 0,0:06:55.87,0:06:59.12,Default,,0,0,0,,Ой, күте тұршы, балам, сен осыны сезіп тұрсың ба?
Dialogue: 0,0:06:59.21,0:06:59.79,Default,,0,0,0,,Иә
Dialogue: 0,0:06:59.87,0:07:02.13,Default,,0,0,0,,Сіз ақылды және салқын әрекет етсеңіз де
Dialogue: 0,0:07:02.21,0:07:05.17,Default,,0,0,0,,Бала сияқты ұялып, үрейленіп... хехе
Dialogue: 0,0:07:05.25,0:07:07.00,Default,,0,0,0,,Ой, күтпеген жерден
Dialogue: 0,0:07:07.09,0:07:08.80,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:07:08.88,0:07:11.72,Default,,0,0,0,,Менде мұндай нәрсе бірінші рет болып тұр.
Dialogue: 0,0:07:11.80,0:07:16.18,Default,,0,0,0,,Мен де ол үшін ерекше екенімді білемін.
Dialogue: 0,0:07:16.76,0:07:18.14,Default,,0,0,0,,Бар...
Dialogue: 0,0:07:18.68,0:07:19.60,Default,,0,0,0,,Бірақ?
Dialogue: 0,0:07:21.56,0:07:22.65,Default,,0,0,0,,Шынында да, осы дүкенде…
Dialogue: 0,0:07:22.73,0:07:26.36,Default,,0,0,0,,Мен сені шынымен жей аламын деп ойлайсың ба?
Dialogue: 0,0:07:26.44,0:07:28.65,Default,,0,0,0,,О, ол шөпқоректі.
Dialogue: 0,0:07:29.24,0:07:32.36,Default,,0,0,0,,Хару-сенпай, Легоши-сенпайда осындай нәрсе бар ма?
Dialogue: 0,0:07:32.45,0:07:33.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:33.24,0:07:36.78,Default,,0,0,0,,Келінімнің бұғысы қауіпсіз.
Dialogue: 0,0:07:36.87,0:07:39.33,Default,,0,0,0,,Сондықтан мені таңдамайсың ба?
Dialogue: 0,0:07:39.41,0:07:41.04,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:07:41.12,0:07:43.79,Default,,0,0,0,,Бірақ мен бас тартқым келмейді.
Dialogue: 0,0:07:43.88,0:07:45.38,Default,,0,0,0,,Басқа ешкім жоқ
Dialogue: 0,0:07:45.46,0:07:49.05,Default,,0,0,0,,Қай жерде болсаңыз да күшті және жарқыраған
Dialogue: 0,0:07:49.13,0:07:52.30,Default,,0,0,0,,Сүйкімді, сондықтан мен оны жегім келеді...
Dialogue: 0,0:07:52.38,0:07:53.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:53.09,0:07:57.60,Default,,0,0,0,,А, жоқ, бұл басқаша, бұл жай ғана сөздерді бұрмалау.
Dialogue: 0,0:07:57.68,0:08:00.81,Default,,0,0,0,,Аа, енді жоқ.
Dialogue: 0,0:08:02.06,0:08:04.73,Default,,0,0,0,,Хехе, түсіндім.
Dialogue: 0,0:08:05.44,0:08:09.36,Default,,0,0,0,,Бұл бала шөпқоректі Луиді ұнатпайды.
Dialogue: 0,0:08:09.44,0:08:12.36,Default,,0,0,0,,Мен ғашық болған Луи шөпқоректі еді.
Dialogue: 0,0:08:13.61,0:08:16.12,Default,,0,0,0,,Мен Луиді жақсы көремін.
Dialogue: 0,0:08:16.99,0:08:18.03,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:08:19.20,0:08:20.20,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:08:20.79,0:08:23.04,Default,,0,0,0,,Джуно оны жемейді.
Dialogue: 0,0:08:23.75,0:08:24.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:26.21,0:08:27.08,Default,,0,0,0,,Джуно мырза?
Dialogue: 0,0:08:27.71,0:08:29.09,Default,,0,0,0,,Мен қазір қалай сезінемін
Dialogue: 0,0:08:29.17,0:08:30.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:30.34,0:08:32.30,Default,,0,0,0,,Мен қазір солай сезінемін.
Dialogue: 0,0:08:32.38,0:08:35.38,Default,,0,0,0,,«Джуно оны жемейді».
Dialogue: 0,0:08:36.01,0:08:37.89,Default,,0,0,0,,Сендіруге тырысу...
Dialogue: 0,0:08:37.97,0:08:38.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:40.26,0:08:41.43,Default,,0,0,0,,Хару-чан
Dialogue: 0,0:08:41.52,0:08:43.23,Default,,0,0,0,,Иә
Dialogue: 0,0:08:44.19,0:08:44.89,Default,,0,0,0,,Мен қайтуым керек
Dialogue: 0,0:08:44.98,0:08:46.10,Default,,0,0,0,,Хару Сенпай
Dialogue: 0,0:08:47.02,0:08:48.56,Default,,0,0,0,,Рахмет
Dialogue: 0,0:08:48.65,0:08:50.11,Default,,0,0,0,,Иә
Dialogue: 0,0:08:57.32,0:08:58.78,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:08:59.28,0:09:06.29,Default,,0,0,0,,(қатты металл музыкасы)
Dialogue: 0,0:09:12.84,0:09:15.80,Default,,0,0,0,,Сізге классикалық музыка ұнамайды ма?
Dialogue: 0,0:09:16.30,0:09:18.47,Default,,0,0,0,,Бұл сенің әкеңнің хоббиі.
Dialogue: 0,0:09:19.14,0:09:22.01,Default,,0,0,0,,Луис мырза мен туралы әлі ештеңе білмейді.
Dialogue: 0,0:09:23.14,0:09:24.23,Default,,0,0,0,,Бұл жақсы сезінеді, солай ма?
Dialogue: 0,0:09:24.81,0:09:28.31,Default,,0,0,0,,Осылай жасасаңыз, бәрі жақсы емес пе?
Dialogue: 0,0:09:29.36,0:09:31.57,Default,,0,0,0,,Луи-сан, соңғы уақытта шаршадың ба?
Dialogue: 0,0:09:31.65,0:09:33.78,Default,,0,0,0,,Мен бүгін үзіліс жасайын деп ойладым.
Dialogue: 0,0:09:33.86,0:09:34.61,Default,,0,0,0,,(Радио станциясының дыбысы)
Dialogue: 0,0:09:34.61,0:09:35.24,Default,,0,0,0,,(Радиостанцияны өзгерту дыбысы)
Dialogue: 0,0:09:34.61,0:09:35.24,Default,,0,0,0,,Не ол?
Dialogue: 0,0:09:35.24,0:09:35.32,Default,,0,0,0,,Не ол?
Dialogue: 0,0:09:35.32,0:09:35.90,Default,,0,0,0,,Не ол?
Dialogue: 0,0:09:35.32,0:09:35.90,Default,,0,0,0,,Осы баспасөз мәслихатында әкім
Dialogue: 0,0:09:35.90,0:09:35.99,Default,,0,0,0,,Осы баспасөз мәслихатында әкім
Dialogue: 0,0:09:35.99,0:09:37.07,Default,,0,0,0,,Осы баспасөз мәслихатында әкім
Dialogue: 0,0:09:35.99,0:09:37.07,Default,,0,0,0,,Луи-сан, сен соңғы уақытта шаршаған шығарсың, үзіліс ал.
Dialogue: 0,0:09:37.07,0:09:37.15,Default,,0,0,0,,Луи-сан, сен соңғы уақытта шаршаған шығарсың, үзіліс ал.
Dialogue: 0,0:09:37.15,0:09:39.91,Default,,0,0,0,,Луи-сан, сен соңғы уақытта шаршаған шығарсың, үзіліс ал.
Dialogue: 0,0:09:37.15,0:09:39.91,Default,,0,0,0,,Зулимпиадаға қатысуға елші ретінде
Dialogue: 0,0:09:39.99,0:09:43.58,Default,,0,0,0,,Горнс конгломератының мұрагері Луис мырза ұсынылды.
Dialogue: 0,0:09:43.66,0:09:44.50,Default,,0,0,0,,(Радионы өшіру дыбысы)
Dialogue: 0,0:09:46.25,0:09:48.87,Default,,0,0,0,,Сіз мен күткеннен де кішіпейілсіз.
Dialogue: 0,0:09:48.96,0:09:50.75,Default,,0,0,0,,Сізге ерекшелену ұнайды ма?
Dialogue: 0,0:09:50.84,0:09:54.17,Default,,0,0,0,,Азуки-сан да мені әлі танымайтын сияқты.
Dialogue: 0,0:09:54.76,0:09:56.92,Default,,0,0,0,,Бұл жерде ештеңе жоқ.
Dialogue: 0,0:09:57.01,0:09:59.34,Default,,0,0,0,,Бізде не үшін уақыт бар
Dialogue: 0,0:10:13.94,0:10:15.32,Default,,0,0,0,,Күн ашық болған кезде
Dialogue: 0,0:10:15.40,0:10:18.03,Default,,0,0,0,,Теңіз жарқыраған және әдемі, бірақ...
Dialogue: 0,0:10:18.11,0:10:19.86,Default,,0,0,0,,Бақша әдемі.
Dialogue: 0,0:10:19.95,0:10:20.62,Default,,0,0,0,,Сол ағаш—
Dialogue: 0,0:10:21.20,0:10:24.66,Default,,0,0,0,,Әкем мен туылған күні еккен.
Dialogue: 0,0:10:25.54,0:10:29.42,Default,,0,0,0,,Баламыз да дүниеге келгенде отырғызайық.
Dialogue: 0,0:10:30.63,0:10:32.00,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:10:33.21,0:10:34.42,Default,,0,0,0,,Әкемнен
Dialogue: 0,0:10:35.17,0:10:38.09,Default,,0,0,0,,Зулимпиадаға қатысу үшін елші болып тағайындалды —
Dialogue: 0,0:10:38.17,0:10:39.59,Default,,0,0,0,,Неге… неге мен
Dialogue: 0,0:10:40.89,0:10:41.97,Default,,0,0,0,,Уақытыңызды алыңыз
Dialogue: 0,0:10:42.76,0:10:44.22,Default,,0,0,0,,(Луис жалған күлімсіреу)
Dialogue: 0,0:10:47.10,0:10:50.06,Default,,0,0,0,,Болашақ күйеуіңізді құттықтаймыз
Dialogue: 0,0:10:54.73,0:10:56.28,Default,,0,0,0,,Мен мақтанамын
Dialogue: 0,0:10:56.90,0:10:57.86,Default,,0,0,0,,Сәлем
Dialogue: 0,0:10:57.94,0:10:59.65,Default,,0,0,0,,Менің де саған сыйлығым бар.
Dialogue: 0,0:11:01.11,0:11:02.37,Default,,0,0,0,,Жалюзи
Dialogue: 0,0:11:08.04,0:11:11.92,Default,,0,0,0,,Луис мырза, сіз көп адамдардың алдында жиірек тұратын шығарсыз.
Dialogue: 0,0:11:12.00,0:11:14.21,Default,,0,0,0,,Бұдан былай мен сенің түр-келбетіңді күтемін.
Dialogue: 0,0:11:14.29,0:11:15.75,Default,,0,0,0,,Мен абай боламын.
Dialogue: 0,0:11:16.55,0:11:18.05,Default,,0,0,0,,Күнжіт майы
Dialogue: 0,0:11:19.05,0:11:22.13,Default,,0,0,0,,Мүк, пачули және лавр хош иісі
Dialogue: 0,0:11:23.01,0:11:24.30,Default,,0,0,0,,Сіз тынышталасыз ба?
Dialogue: 0,0:11:24.39,0:11:25.89,Default,,0,0,0,,Және қалағаныңа қол жеткізе алмасаң—
Dialogue: 0,0:11:31.44,0:11:33.48,Default,,0,0,0,,О, күте тұрыңыз, мен...
Dialogue: 0,0:11:33.56,0:11:35.56,Default,,0,0,0,,Ұялмаңыз
Dialogue: 0,0:11:37.27,0:11:38.40,Default,,0,0,0,,Азуки-сан
Dialogue: 0,0:11:39.19,0:11:41.90,Default,,0,0,0,,Хехе, сабыр етіңіз.
Dialogue: 0,0:11:42.49,0:11:44.20,Default,,0,0,0,,Демалу
Dialogue: 0,0:11:44.28,0:11:45.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:45.45,0:11:47.03,Default,,0,0,0,,Жіңішке мүйіздер
Dialogue: 0,0:11:47.79,0:11:49.95,Default,,0,0,0,,Бұл менің мүйізім емес.
Dialogue: 0,0:11:50.45,0:11:53.29,Default,,0,0,0,,Қайта өсіру кезінде жалған.
Dialogue: 0,0:11:53.37,0:11:55.33,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:11:55.96,0:12:00.76,Default,,0,0,0,,Біреудің алдында тұрғанда оның мүйізі сенікі болып көрінеді.
Dialogue: 0,0:12:01.55,0:12:03.97,Default,,0,0,0,,Олай болса, үлкен, әдемі болған дұрыс.
Dialogue: 0,0:12:04.55,0:12:06.14,Default,,0,0,0,,Сіз солай ойлайсыз ба?
Dialogue: 0,0:12:06.89,0:12:09.10,Default,,0,0,0,,Ол шынайы болуы керек пе?
Dialogue: 0,0:12:09.18,0:12:10.06,Default,,0,0,0,,Иә
Dialogue: 0,0:12:10.77,0:12:14.52,Default,,0,0,0,,Қазір басқаша болса да, ол ақырында шындыққа айналады.
Dialogue: 0,0:12:14.60,0:12:15.98,Default,,0,0,0,,Уақыт қажет болса да
Dialogue: 0,0:12:16.90,0:12:18.36,Default,,0,0,0,,Ешқандай кепілдіктер жоқ.
Dialogue: 0,0:12:18.44,0:12:19.73,Default,,0,0,0,,Мәселе жоқ
Dialogue: 0,0:12:20.65,0:12:22.32,Default,,0,0,0,,Пішіннен бастаңыз
Dialogue: 0,0:12:22.40,0:12:25.61,Default,,0,0,0,,Өйткені мұны істеудің мағынасы бар деп ойлаймын.
Dialogue: 0,0:12:25.70,0:12:26.66,Default,,0,0,0,,Жетеді
Dialogue: 0,0:12:26.74,0:12:29.99,Default,,0,0,0,,Ойланып қарашы, тыңдап тұрсың ба?
Dialogue: 0,0:12:30.49,0:12:32.58,Default,,0,0,0,,Осы қаланы тазарту оқиғасы
Dialogue: 0,0:12:32.66,0:12:33.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:33.62,0:12:36.00,Default,,0,0,0,,Егер біз Зулимпиаданы өткізе алатын болсақ
Dialogue: 0,0:12:36.08,0:12:39.67,Default,,0,0,0,,Бұл қалада сыртқы әлемге көрсетуге болмайтын жерлер бар емес пе?
Dialogue: 0,0:12:39.75,0:12:40.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:40.46,0:12:43.34,Default,,0,0,0,,Сондықтан біраз өзгерістер енгізетін сияқтымыз.
Dialogue: 0,0:12:43.92,0:12:46.14,Default,,0,0,0,,Бұл жыртқыштарға толы күдікті қала...
Dialogue: 0,0:12:46.22,0:12:47.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:48.68,0:12:50.31,Default,,0,0,0,,Урайчи...?
Dialogue: 0,0:12:50.39,0:12:54.27,Default,,0,0,0,,Бірдеңе үшін төбелесіп жатқан қорқынышты адамдар болуы керек.
Dialogue: 0,0:12:54.35,0:12:57.81,Default,,0,0,0,,Әкесі оны тазартамын деді.
Dialogue: 0,0:12:57.90,0:13:00.11,Default,,0,0,0,,Мен ештеңе естіген жоқпын.
Dialogue: 0,0:13:00.19,0:13:03.28,Default,,0,0,0,,Өте өкінішті, мен оны асыға күтемін
Dialogue: 0,0:13:03.86,0:13:04.61,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:06.49,0:13:07.95,Default,,0,0,0,,Уақыт келді
Dialogue: 0,0:13:08.45,0:13:12.04,Default,,0,0,0,,Бұл теңіздің үстінде күннің шығуы әдемі.
Dialogue: 0,0:13:13.04,0:13:14.83,Default,,0,0,0,,Менімен бірге күткіңіз келе ме?
Dialogue: 0,0:13:18.00,0:13:20.71,Default,,0,0,0,,Жолдан кет! Жолдан кет!
Dialogue: 0,0:13:21.34,0:13:23.38,Default,,0,0,0,,Мадара-гуми көшесі.
Dialogue: 0,0:13:23.46,0:13:26.09,Default,,0,0,0,,Мадара тобы! Оны ашыңыз! Оны ашыңыз!
Dialogue: 0,0:13:26.18,0:13:27.55,Default,,0,0,0,,Жоқ, қаш.
Dialogue: 0,0:13:29.97,0:13:30.85,Default,,0,0,0,,(Мисоның күрсінуі)
Dialogue: 0,0:13:30.93,0:13:33.43,Default,,0,0,0,,Әй, қария, қалыңыз қалай?
Dialogue: 0,0:13:33.52,0:13:36.52,Default,,0,0,0,,Сізге рахмет, бұл ай үшін.
Dialogue: 0,0:13:36.60,0:13:37.10,Default,,0,0,0,,О
Dialogue: 0,0:13:37.19,0:13:38.23,Default,,0,0,0,,(Мисоның күлкісі)
Dialogue: 0,0:13:38.90,0:13:41.82,Default,,0,0,0,,Жарайды, жарайды, маған қалдырыңыз.
Dialogue: 0,0:13:41.90,0:13:44.28,Default,,0,0,0,,Біз оны дұрыс қорғаймыз.
Dialogue: 0,0:13:44.36,0:13:45.11,Default,,0,0,0,,(жарылған дыбыс)
Dialogue: 0,0:13:45.19,0:13:46.32,Default,,0,0,0,,Уау
Dialogue: 0,0:13:46.99,0:13:47.82,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:13:47.91,0:13:49.24,Default,,0,0,0,,-Жолдан кет! - (Мадара тобының мүшесі) Не істеп жатырсың!
Dialogue: 0,0:13:49.32,0:13:50.12,Default,,0,0,0,,(Ондық күрсіну)
Dialogue: 0,0:13:50.87,0:13:52.20,Default,,0,0,0,,Мен саған айтайын, сенің дөрекі екеніңді.
Dialogue: 0,0:13:52.20,0:13:53.79,Default,,0,0,0,,Қаншалықты арсыз екеніңді айтайын.
Dialogue: 0,0:13:52.20,0:13:53.79,Default,,0,0,0,,(Инари мүшелерінің күлкілері)
Dialogue: 0,0:13:53.87,0:13:55.25,Default,,0,0,0,,Ең жақсы стилетто өкшесі
Dialogue: 0,0:13:55.33,0:13:57.62,Default,,0,0,0,,Бұл қызыл кілеммен жүруге арналған.
Dialogue: 0,0:13:57.62,0:13:58.08,Default,,0,0,0,,Бұл қызыл кілеммен жүруге арналған.
Dialogue: 0,0:13:57.62,0:13:58.08,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:13:58.08,0:13:58.79,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:13:58.79,0:13:58.83,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:13:58.79,0:13:58.83,Default,,0,0,0,,Көп шуласаң, қаныңнан қызыл кілем жасаймын.
Dialogue: 0,0:13:58.83,0:14:00.29,Default,,0,0,0,,Көп шуласаң, қаныңнан қызыл кілем жасаймын.
Dialogue: 0,0:14:00.29,0:14:03.09,Default,,0,0,0,,Егер сіз қатты шуылдасаңыз, мен сіздің қаныңыздан қызыл кілем жасаймын.
Dialogue: 0,0:14:00.29,0:14:03.09,Default,,0,0,0,,(Мадара-гуми гектері)
Dialogue: 0,0:14:03.09,0:14:03.75,Default,,0,0,0,,(Мадара-гуми гектері)
Dialogue: 0,0:14:03.84,0:14:07.01,Default,,0,0,0,,Алып бара жатқан шығарсың, Тен.
Dialogue: 0,0:14:07.09,0:14:09.47,Default,,0,0,0,,Хехе, әрине.
Dialogue: 0,0:14:09.55,0:14:11.05,Default,,0,0,0,,Урайчидің қазір іздеп жүргені біз, Инари тобы.
Dialogue: 0,0:14:11.05,0:14:12.64,Default,,0,0,0,,Урайчидің қазір іздеп жүргені біз, Инари тобы.
Dialogue: 0,0:14:11.05,0:14:12.64,Default,,0,0,0,,Иә! Тен-чан сүйкімді!
Dialogue: 0,0:14:12.64,0:14:13.56,Default,,0,0,0,,Урайчидің қазір іздеп жүргені біз, Инари тобы.
Dialogue: 0,0:14:13.56,0:14:14.31,Default,,0,0,0,,Жер асты нарығы қазір іздеп жүрген біз, Инари тобы.
Dialogue: 0,0:14:13.56,0:14:14.31,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:14:14.97,0:14:17.48,Default,,0,0,0,,Бұл көше бізге Мадара тобына тиесілі.
Dialogue: 0,0:14:17.48,0:14:18.27,Default,,0,0,0,,Бұл көше бізге Мадара тобына тиесілі.
Dialogue: 0,0:14:17.48,0:14:18.27,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:18.35,0:14:19.94,Default,,0,0,0,,Жолдан кет, ақымақ!
Dialogue: 0,0:14:19.94,0:14:20.35,Default,,0,0,0,,Жолдан кет, ақымақ!
Dialogue: 0,0:14:19.94,0:14:20.35,Default,,0,0,0,,Дұрыс, жолдан тай!
Dialogue: 0,0:14:20.35,0:14:20.44,Default,,0,0,0,,Иә, жолдан кет!
Dialogue: 0,0:14:20.44,0:14:21.15,Default,,0,0,0,,Иә, жолдан кет!
Dialogue: 0,0:14:20.44,0:14:21.15,Default,,0,0,0,,Егер сен мені жеңе алсаң
Dialogue: 0,0:14:21.15,0:14:23.15,Default,,0,0,0,,Егер сен мені жеңе алсаң
Dialogue: 0,0:14:23.23,0:14:25.03,Default,,0,0,0,,Хозаки Ягатте!
Dialogue: 0,0:14:25.11,0:14:26.74,Default,,0,0,0,,Мұнда ешкім жоқ сияқты. (Ұшқыш А) Жоқ, бар.
Dialogue: 0,0:14:31.49,0:14:32.91,Default,,0,0,0,,Үй жануарлары және жем
Dialogue: 0,0:14:32.99,0:14:33.66,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:14:33.74,0:14:36.66,Default,,0,0,0,,(Тоқсу дауысы)
Dialogue: 0,0:14:36.75,0:14:37.37,Default,,0,0,0,,(Шыны сынып жатқан дыбыс)
Dialogue: 0,0:14:37.45,0:14:39.67,Default,,0,0,0,,Дүкен құлағалы тұр.
Dialogue: 0,0:14:40.50,0:14:42.25,Default,,0,0,0,,Мен бұл күндері күнделікті істеймін.
Dialogue: 0,0:14:42.33,0:14:45.71,Default,,0,0,0,,Шиши-гуми киік бастығы болған күндерді сағындым.
Dialogue: 0,0:14:48.47,0:14:49.68,Default,,0,0,0,,Иә~
Dialogue: 0,0:14:50.26,0:14:52.93,Default,,0,0,0,,Оны осындай бағаға кім сатып алады?
Dialogue: 0,0:14:57.10,0:14:57.93,Default,,0,0,0,,(Джинманың күші)
Dialogue: 0,0:14:57.10,0:14:57.93,Default,,0,0,0,,(соғу дыбысы)
Dialogue: 0,0:14:57.93,0:14:58.52,Default,,0,0,0,,(соғу дыбысы)
Dialogue: 0,0:14:58.52,0:14:59.85,Default,,0,0,0,,(соғу дыбысы)
Dialogue: 0,0:14:58.52,0:14:59.85,Default,,0,0,0,,Конняро!
Dialogue: 0,0:14:59.85,0:14:59.94,Default,,0,0,0,,(соғу дыбысы)
Dialogue: 0,0:14:59.94,0:15:01.73,Default,,0,0,0,,(соғу дыбысы)
Dialogue: 0,0:14:59.94,0:15:01.73,Default,,0,0,0,,Оны жалама!
Dialogue: 0,0:15:01.73,0:15:01.81,Default,,0,0,0,,(соғу дыбысы)
Dialogue: 0,0:15:01.81,0:15:03.86,Default,,0,0,0,,(соғу дыбысы)
Dialogue: 0,0:15:01.81,0:15:03.86,Default,,0,0,0,,Қорғаныс ақысын төлемейтін адам ешқашан болған емес.
Dialogue: 0,0:15:03.86,0:15:05.98,Default,,0,0,0,,Қорғаныс ақысын төлемеген адам ешқашан болған емес.
Dialogue: 0,0:15:06.07,0:15:07.48,Default,,0,0,0,,Эй!
Dialogue: 0,0:15:07.57,0:15:09.11,Default,,0,0,0,,Инари-гуми мен Мадара-гумиден
Dialogue: 0,0:15:09.19,0:15:12.11,Default,,0,0,0,,Дүкенді қорғауға дайын болсаңыз, мен төлеймін.
Dialogue: 0,0:15:12.20,0:15:13.66,Default,,0,0,0,,Сіз мұны істей алмайсыз, солай ма?
Dialogue: 0,0:15:13.74,0:15:15.24,Default,,0,0,0,,Сонша шуламаңыз!
Dialogue: 0,0:15:17.49,0:15:18.91,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:15:19.00,0:15:19.37,Default,,0,0,0,,Біріншіден, мен ешқашан сіздің қамқорлығыңызда болған емеспін.
Dialogue: 0,0:15:19.37,0:15:20.16,Default,,0,0,0,,Біріншіден, мен ешқашан сіздің қамқорлығыңызда болған емеспін.
Dialogue: 0,0:15:19.37,0:15:20.16,Default,,0,0,0,,(Джинманың күші)
Dialogue: 0,0:15:20.16,0:15:20.25,Default,,0,0,0,,Біріншіден, мен ешқашан сіздің қамқорлығыңызда болған емеспін.
Dialogue: 0,0:15:20.25,0:15:21.12,Default,,0,0,0,,Біріншіден, мен ешқашан сіздің қамқорлығыңызда болған емеспін.
Dialogue: 0,0:15:20.25,0:15:21.12,Default,,0,0,0,,Oh?
Dialogue: 0,0:15:21.12,0:15:22.54,Default,,0,0,0,,Біріншіден, мен ешқашан сіздің қамқорлығыңызда болған емеспін.
Dialogue: 0,0:15:22.71,0:15:23.17,Default,,0,0,0,,(Джинманың күші)
Dialogue: 0,0:15:23.17,0:15:23.50,Default,,0,0,0,,(Джинманың күші)
Dialogue: 0,0:15:23.17,0:15:23.50,Default,,0,0,0,,Әй?
Dialogue: 0,0:15:23.50,0:15:24.04,Default,,0,0,0,,Әй?
Dialogue: 0,0:15:24.54,0:15:27.84,Default,,0,0,0,,Келісім-шартқа қол қойғандай емеспіз.
Dialogue: 0,0:15:27.92,0:15:30.47,Default,,0,0,0,,Оның үстіне мен өзімді осылай жасырып қалдым.
Dialogue: 0,0:15:30.55,0:15:31.55,Default,,0,0,0,,Тек бұғы емес
Dialogue: 0,0:15:31.63,0:15:33.68,Default,,0,0,0,,Тіпті микс бастығы мені тастап кетті...
Dialogue: 0,0:15:33.76,0:15:34.60,Default,,0,0,0,,Сен
Dialogue: 0,0:15:34.68,0:15:37.72,Default,,0,0,0,,Сіз теңізге бата аласыз ба?
Dialogue: 0,0:15:37.81,0:15:40.89,Default,,0,0,0,,Уф, а... а, мен төлеймін.
Dialogue: 0,0:15:40.98,0:15:41.52,Default,,0,0,0,,Әй?
Dialogue: 0,0:15:41.60,0:15:43.94,Default,,0,0,0,,Ақыры мен төлеймін. Мен оны бояп, төлеймін.
Dialogue: 0,0:15:44.02,0:15:44.56,Default,,0,0,0,,(Еркін күлкі)
Dialogue: 0,0:15:44.65,0:15:46.98,Default,,0,0,0,,Өтінемін, бірдеңе жасаңыз!
Dialogue: 0,0:15:47.07,0:15:48.40,Default,,0,0,0,,(Еркін күлкі)
Dialogue: 0,0:15:48.48,0:15:51.61,Default,,0,0,0,,Дұрыс, жақсы.
Dialogue: 0,0:15:51.70,0:15:51.99,Default,,0,0,0,,Әй?
Dialogue: 0,0:15:51.99,0:15:52.49,Default,,0,0,0,,Әй?
Dialogue: 0,0:15:51.99,0:15:52.49,Default,,0,0,0,,(протездік қадамдар)
Dialogue: 0,0:15:52.49,0:15:52.57,Default,,0,0,0,,(протездік қадамдар)
Dialogue: 0,0:15:52.57,0:15:53.57,Default,,0,0,0,,(протездік қадамдар)
Dialogue: 0,0:15:52.57,0:15:53.57,Default,,0,0,0,,Хмм
Dialogue: 0,0:15:56.24,0:15:56.74,Default,,0,0,0,,бұл...!
Dialogue: 0,0:15:57.45,0:15:58.83,Default,,0,0,0,,Луи!
Dialogue: 0,0:16:04.00,0:16:05.83,Default,,0,0,0,,Ах~ мен шаршадым
Dialogue: 0,0:16:06.79,0:16:12.01,Default,,0,0,0,,Мен бұл бір ғана шөпқоректі жануармен артқы базарды аралаудың ең қауіпсіз жолы деп ойладым.
Dialogue: 0,0:16:12.09,0:16:13.55,Default,,0,0,0,,Керісінше көзге түсті
Dialogue: 0,0:16:13.63,0:16:14.51,Default,,0,0,0,,Менің ойымша, солай.
Dialogue: 0,0:16:14.59,0:16:17.81,Default,,0,0,0,,Сен бұрынғыдай әлі ессізсің.
Dialogue: 0,0:16:17.89,0:16:19.22,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:16:19.31,0:16:19.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:20.39,0:16:22.81,Default,,0,0,0,,Сонымен, сіз артқы нарыққа келдіңіз бе?
Dialogue: 0,0:16:22.89,0:16:25.81,Default,,0,0,0,,Бұл сіз Шиши-гумидің бастығы боласыз дегенді білдіре ме?
Dialogue: 0,0:16:25.90,0:16:27.73,Default,,0,0,0,,(мүшелердің наразылығы)
Dialogue: 0,0:16:28.65,0:16:31.61,Default,,0,0,0,,Жоқ, сіз бұл ұсыныстан бас тарттыңыз.
Dialogue: 0,0:16:31.69,0:16:33.03,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:16:33.11,0:16:34.66,Default,,0,0,0,,Мені үміттендір
Dialogue: 0,0:16:34.74,0:16:36.70,Default,,0,0,0,,Бұл мүлдем басқа әңгіме.
Dialogue: 0,0:16:37.28,0:16:38.91,Default,,0,0,0,,Жақында
Dialogue: 0,0:16:38.99,0:16:41.66,Default,,0,0,0,,Осы астыртын нарықты тазарту қозғалысы бар сияқты.
Dialogue: 0,0:16:41.75,0:16:42.79,Default,,0,0,0,,Тазалау?
Dialogue: 0,0:16:43.29,0:16:45.83,Default,,0,0,0,,Мен нақты не істеу керектігін білмеймін.
Dialogue: 0,0:16:45.92,0:16:48.59,Default,,0,0,0,,Балалар, сендер естігендерің дұрыс болар деп ойладым.
Dialogue: 0,0:16:48.67,0:16:52.34,Default,,0,0,0,,Соны маған айту үшін келдің бе?
Dialogue: 0,0:16:53.01,0:16:55.01,Default,,0,0,0,,Иә?О
Dialogue: 0,0:16:56.01,0:16:57.09,Default,,0,0,0,,Осымен
Dialogue: 0,0:16:57.68,0:16:58.68,Default,,0,0,0,,А, дұрыс. Мен қалаған DVD бүгін шықты.
Dialogue: 0,0:16:58.76,0:17:01.18,Default,,0,0,0,,О, жоқ күте тұра күте тұр
Dialogue: 0,0:17:01.27,0:17:04.14,Default,,0,0,0,,Жақсы емес пе? Мен жол бойы келдім.
Dialogue: 0,0:17:04.23,0:17:07.27,Default,,0,0,0,,Менің тамақ жегенімді қалайсың ба?
Dialogue: 0,0:17:07.90,0:17:09.23,Default,,0,0,0,,Мен дайындаймын.
Dialogue: 0,0:17:10.40,0:17:12.44,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:17:12.53,0:17:15.74,Default,,0,0,0,,Иісі әдеттегіден өзгеше.
Dialogue: 0,0:17:15.82,0:17:17.82,Default,,0,0,0,,Иә, мен де солай ойладым.
Dialogue: 0,0:17:17.91,0:17:19.24,Default,,0,0,0,,(Луи күрсінуі)
Dialogue: 0,0:17:19.32,0:17:20.91,Default,,0,0,0,,Көп нәрсе болды.
Dialogue: 0,0:17:20.99,0:17:22.29,Default,,0,0,0,,Сіз әйелсіз бе?
Dialogue: 0,0:17:22.37,0:17:23.20,Default,,0,0,0,,Әй?
Dialogue: 0,0:17:23.29,0:17:24.41,Default,,0,0,0,,Гааах!
Dialogue: 0,0:17:25.16,0:17:27.75,Default,,0,0,0,,Балалар сендер шынымен жиіркенішті екенсіңдер.
Dialogue: 0,0:17:28.42,0:17:29.79,Default,,0,0,0,,Сіз оны жуып жатырсыз ба?
Dialogue: 0,0:17:29.88,0:17:30.29,Default,,0,0,0,,Көз жасы жауса да
Dialogue: 0,0:17:30.29,0:17:32.88,Default,,0,0,0,,Көз жасы жауса да
Dialogue: 0,0:17:30.29,0:17:32.88,Default,,0,0,0,,(Еркін күлкі)
Dialogue: 0,0:17:32.88,0:17:33.26,Default,,0,0,0,,Көз жасы жауса да
Dialogue: 0,0:17:33.34,0:17:35.59,Default,,0,0,0,,Сіз душ қабылдауға болмайды
Dialogue: 0,0:17:35.67,0:17:36.34,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:17:35.67,0:17:36.34,Default,,0,0,0,,Жырылдау...
Dialogue: 0,0:17:36.34,0:17:36.43,Default,,0,0,0,,Айналдыру…
Dialogue: 0,0:17:36.43,0:17:37.43,Default,,0,0,0,,Айналдыру…
Dialogue: 0,0:17:36.43,0:17:37.43,Default,,0,0,0,,(Еркін күлкі)
Dialogue: 0,0:17:37.43,0:17:37.51,Default,,0,0,0,,Дабыл...
Dialogue: 0,0:17:37.51,0:17:39.47,Default,,0,0,0,,Жырылдау…
Dialogue: 0,0:17:37.51,0:17:39.47,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:17:39.55,0:17:41.43,Default,,0,0,0,,Маған не енгізгендерін ешкім білмейді.
Dialogue: 0,0:17:39.55,0:17:41.43,Default,,0,0,0,,Тоқташы хахаха...
Dialogue: 0,0:17:41.43,0:17:41.51,Default,,0,0,0,,Тоқташы хахаха...
Dialogue: 0,0:17:41.51,0:17:42.31,Default,,0,0,0,,Тоқташы хахаха...
Dialogue: 0,0:17:41.51,0:17:42.31,Default,,0,0,0,,Өйткені, бұл иіс тыныштандырады.
Dialogue: 0,0:17:42.31,0:17:44.35,Default,,0,0,0,,Өйткені, бұл иіс тыныштандырады.
Dialogue: 0,0:17:44.93,0:17:46.69,Default,,0,0,0,,Ей, бұл үлкен мәселе.
Dialogue: 0,0:17:46.77,0:17:49.98,Default,,0,0,0,,Бұл Луиге ұнайтын ойнақы нәрсе емес пе?
Dialogue: 0,0:17:50.06,0:17:52.44,Default,,0,0,0,,Сот процесі деген ұғым жоқ.
Dialogue: 0,0:17:52.52,0:17:53.90,Default,,0,0,0,,Әй, ет болса...
Dialogue: 0,0:17:53.98,0:17:57.91,Default,,0,0,0,,Идиот! Шөпқоректіге көбірек ұқсайды...
Dialogue: 0,0:17:57.99,0:17:58.74,Default,,0,0,0,,О
Dialogue: 0,0:18:00.16,0:18:01.07,Default,,0,0,0,,Онда болды ма?
Dialogue: 0,0:18:04.58,0:18:06.25,Default,,0,0,0,,Мынау!
Dialogue: 0,0:18:07.08,0:18:08.08,Default,,0,0,0,,Джажан!
Dialogue: 0,0:18:08.17,0:18:09.67,Default,,0,0,0,,Күткеніңізге рахмет!
Dialogue: 0,0:18:09.75,0:18:14.63,Default,,0,0,0,,Бұл мен Луиге дайындаған ең жақсы және ең жақсы қауын...!
Dialogue: 0,0:18:15.84,0:18:16.38,Default,,0,0,0,,Әй?
Dialogue: 0,0:18:17.26,0:18:19.97,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:18:23.97,0:18:26.43,Default,,0,0,0,,Гааах!
Dialogue: 0,0:18:27.35,0:18:31.40,Default,,0,0,0,,Етқоректілердің ұясында осылай қорғансыз ұйықтай алмаймын.
Dialogue: 0,0:18:32.11,0:18:34.78,Default,,0,0,0,,Дүниеде жалғыз сенсің
Dialogue: 0,0:18:36.90,0:18:39.40,Default,,0,0,0,,(Легошидің ауыр тыныс алуы)
Dialogue: 0,0:18:44.58,0:18:46.16,Default,,0,0,0,,О, рахмет.
Dialogue: 0,0:18:46.95,0:18:48.29,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:18:51.04,0:18:52.58,Default,,0,0,0,,Хару-чан
Dialogue: 0,0:18:52.67,0:18:56.30,Default,,0,0,0,,Ол бүгін толық емес жұмыс күні бар екенін айтты, сондықтан ол жерде жоқ.
Dialogue: 0,0:18:57.21,0:18:59.47,Default,,0,0,0,,Ах, Хару-чанның иісі.
Dialogue: 0,0:19:07.06,0:19:10.31,Default,,0,0,0,,Иіс осы жерден шығып тұр...
Dialogue: 0,0:19:11.15,0:19:12.65,Default,,0,0,0,,Мұнда жоқ екеніңізге сенімдісіз бе?
Dialogue: 0,0:19:13.23,0:19:13.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:14.44,0:19:17.19,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:19:17.28,0:19:18.86,Default,,0,0,0,,Мен бұны шешемін.
Dialogue: 0,0:19:19.61,0:19:21.86,Default,,0,0,0,,Жоқ, бірақ мүмкін емес.
Dialogue: 0,0:19:21.95,0:19:23.91,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:19:23.99,0:19:25.28,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:26.62,0:19:27.58,Default,,0,0,0,,Қауын
Dialogue: 0,0:19:28.16,0:19:29.83,Default,,0,0,0,,Ол жерде күдікті біреу бар.
Dialogue: 0,0:19:29.91,0:19:31.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:31.21,0:19:31.75,Default,,0,0,0,,Есеп беру керек пе?
Dialogue: 0,0:19:31.83,0:19:32.50,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:19:34.29,0:19:36.75,Default,,0,0,0,,Иә? Легоси емес пе?
Dialogue: 0,0:19:36.84,0:19:39.21,Default,,0,0,0,,Не? аа!
Dialogue: 0,0:19:39.30,0:19:40.80,Default,,0,0,0,,Күмбез-сенпай!
Dialogue: 0,0:19:40.88,0:19:42.01,Default,,0,0,0,,(Күлкі)
Dialogue: 0,0:19:42.59,0:19:44.89,Default,,0,0,0,,Жарайды, менің орта сынып оқушым.
Dialogue: 0,0:19:44.97,0:19:45.60,Default,,0,0,0,,О
Dialogue: 0,0:19:47.01,0:19:49.31,Default,,0,0,0,,Сенпай, сен университетке осында бардың.
Dialogue: 0,0:19:49.39,0:19:51.14,Default,,0,0,0,,Иә Өнер бөлімі
Dialogue: 0,0:19:51.23,0:19:55.40,Default,,0,0,0,,Мен шынымен бақыттымын. Мен сені сыртта кездестіремін деп ойламаппын.
Dialogue: 0,0:19:58.57,0:20:01.32,Default,,0,0,0,,Сіз драма үйірмесіндегі барлық адамдармен байланыстасыз ба?
Dialogue: 0,0:20:01.40,0:20:04.24,Default,,0,0,0,,Аа, мен өткен айда біраз уақыт клуб бөлмесінде болдым.
Dialogue: 0,0:20:04.32,0:20:05.62,Default,,0,0,0,,Барлығы қолынан келгенін жасады
Dialogue: 0,0:20:05.70,0:20:08.49,Default,,0,0,0,,Мектеп қиын сияқты.
Dialogue: 0,0:20:08.58,0:20:12.92,Default,,0,0,0,,Жыртқыштар мен шөпқоректілер бар сияқты, үйірме жұмыстары да әртүрлі.
Dialogue: 0,0:20:13.00,0:20:15.08,Default,,0,0,0,,Сіздің аға бірдеңе естіді ме?
Dialogue: 0,0:20:15.17,0:20:18.05,Default,,0,0,0,,Мен Каймен байланыста болдым, бірақ...
Dialogue: 0,0:20:18.13,0:20:20.09,Default,,0,0,0,,Каймен? А... Солай ма?
Dialogue: 0,0:20:20.17,0:20:23.76,Default,,0,0,0,,Уфуфу Ол: «Қиындыққа тап болғанда күйемін» деді.
Dialogue: 0,0:20:23.84,0:20:27.47,Default,,0,0,0,,Бұл бала актерлік топта болғаннан гөрі драма үйірмесінің мүшесіне ұқсайды.
Dialogue: 0,0:20:27.55,0:20:29.35,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:20:29.85,0:20:33.06,Default,,0,0,0,,Сіз бұрын не істеп едіңіз?
Dialogue: 0,0:20:33.14,0:20:33.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:34.90,0:20:36.02,Default,,0,0,0,,(Легошидің ащы күлкісі)
Dialogue: 0,0:20:36.10,0:20:36.98,Default,,0,0,0,,Бірдеңе іздеп жатырсыз ба?
Dialogue: 0,0:20:37.06,0:20:39.94,Default,,0,0,0,,А... жоқ, шынында да...
Dialogue: 0,0:20:40.03,0:20:43.24,Default,,0,0,0,,Тым оғаш ештеңе жасамаған дұрыс.
Dialogue: 0,0:20:43.32,0:20:46.20,Default,,0,0,0,,Келмегендіктен, көп нәрсе бірінен соң бірі орын алды.
Dialogue: 0,0:20:46.82,0:20:48.24,Default,,0,0,0,,Оны осылай созып, салбыратып қой.
Dialogue: 0,0:20:48.33,0:20:49.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:50.04,0:20:55.71,Default,,0,0,0,,Профессордың шатырдан құлауы, студенттерді өлтіруге оқталу және т.б.
Dialogue: 0,0:20:55.79,0:20:58.17,Default,,0,0,0,,Барлығы да аздап дірілдеп тұр.
Dialogue: 0,0:20:58.96,0:21:00.75,Default,,0,0,0,,Олай ма еді?
Dialogue: 0,0:21:00.84,0:21:05.26,Default,,0,0,0,,Мектептің ішінде де, сыртында да қауіпті болғандықтан, мен одан шаршадым.
Dialogue: 0,0:21:06.80,0:21:08.60,Default,,0,0,0,,Метеорит фестиваліне барасыз ба?
Dialogue: 0,0:21:08.68,0:21:09.72,Default,,0,0,0,,Бұл менің ниетім
Dialogue: 0,0:21:09.81,0:21:11.77,Default,,0,0,0,,Олай болса.
Dialogue: 0,0:21:11.85,0:21:13.89,Default,,0,0,0,,Неке куәлігі: Ллойд Фогель, Джоэл Фогель
Dialogue: 0,0:21:22.19,0:21:24.99,Default,,0,0,0,,Бұл иісті мектеп ғимаратына кіргеннен кейін сезіндім
Dialogue: 0,0:21:26.32,0:21:31.37,Default,,0,0,0,,Қауынды қоғамда «Сенсей» деп атаса керек.
Dialogue: 0,0:21:37.42,0:21:38.33,Default,,0,0,0,,Міне, осы жерде.
Dialogue: 0,0:21:50.55,0:21:51.76,Default,,0,0,0,,Қауын…
Dialogue: 0,0:21:52.89,0:21:54.73,Default,,0,0,0,,Мен сені міндетті түрде ұстаймын
Dialogue: 0,0:21:55.77,0:21:57.39,Default,,0,0,0,,Е, бүгін таңертең ерте.
Dialogue: 0,0:21:57.48,0:21:59.27,Default,,0,0,0,,Осы пәтердегі бөлмеде.
Dialogue: 0,0:21:59.35,0:22:01.31,Default,,0,0,0,,Әйел лама сойылды.
Dialogue: 0,0:22:01.40,0:22:03.94,Default,,0,0,0,,Өлді деп есептелетін қоңыр аю
Dialogue: 0,0:22:04.03,0:22:06.57,Default,,0,0,0,,Сол оқиға орнында өлі табылды.
Dialogue: 0,0:22:06.65,0:22:09.70,Default,,0,0,0,,Сайт Алғама ауданы мен Орталық көшесін байланыстырады.
Dialogue: 0,0:22:09.78,0:22:11.91,Default,,0,0,0,,Көшенің артқы жағында орналасқан…
Dialogue: 0,0:22:11.99,0:22:13.99,Default,,0,0,0,,♪～
Dialogue: 0,0:23:39.91,0:23:41.92,Default,,0,0,0,,～♪
