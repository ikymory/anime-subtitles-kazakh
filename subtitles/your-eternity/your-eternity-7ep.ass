Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.13,0:00:05.98,Main,,0,0,0,,Мен сенің жасаушыңмын.
Dialogue: 0,00:00:04.17,00:00:07.09,JPN TOP,,0,0,0,,Мен сені жараттым
Dialogue: 0,0:00:09.10,0:00:12.73,Main,,0,0,0,,Біздің үлкен мақсат бар.
Dialogue: 0,00:00:10.17,00:00:13.68,JPN TOP,,0,0,0,,Бізде үлкен мақсат бар
Dialogue: 0,0:00:14.37,0:00:17.35,Main,,0,0,0,,Осы дүниені сақтау.
Dialogue: 0,00:00:15.14,00:00:18.47,JPN TOP,,0,0,0,,Бұл әлемді құтқару үшін
Dialogue: 0,0:00:19.53,0:00:26.17,Main,,0,0,0,,Бұл зат біздің мақсатымызға кедергі жасау үшін осы дүниеге жіберілді.
Dialogue: 0,00:00:20.56,00:00:22.64,JPN TOP,,0,0,0,,Ал мынау
Dialogue: 0,00:00:22.73,00:00:27.27,JPN TOP,,0,0,0,,Ол бұл жоспарды бұзу үшін жіберілді.
Dialogue: 0,0:00:43.80,0:00:47.02,Main,,0,0,0,,Ал, Фуши, біз көңілді боламыз.
Dialogue: 0,00:00:44.83,00:00:47.92,JPN TOP,,0,0,0,,Олай болса, көңіл көтерейік.
Dialogue: 0,0:00:47.62,0:00:50.53,Main,,0,0,0,,Алдағы соңына дейін.
Dialogue: 0,00:00:48.67,00:00:51.71,JPN TOP,,0,0,0,,Алдағы соңына дейін
Dialogue: 0,00:00:54.05,00:00:58.85,JPN TOP,,0,0,0,,♪~
Dialogue: 0,00:02:18.93,00:02:23.93,JPN TOP,,0,0,0,,~♪
Dialogue: 0,0:02:26.87,0:02:29.00,Main,,0,0,0,,Мен соңғы кездері ойланып жүрмін...
Dialogue: 0,00:02:27.89,00:02:29.94,JPN TOP,,0,0,0,,Соңғы кездері осыны ойлап жүрмін.
Dialogue: 0,0:02:30.31,0:02:33.27,Main,,0,0,0,,Мен неге менмін?
Dialogue: 0,00:02:31.44,00:02:34.44,JPN TOP,,0,0,0,,Мен неге менмін?
Dialogue: 0,0:02:33.88,0:02:38.00,Main,,0,0,0,,Неліктен мен сол жақтағы сарайдың отбасында туылмадым?
Dialogue: 0,00:02:34.98,00:02:38.95,JPN TOP,,0,0,0,,Мен неге сол сарайда бала туылмадым деп ойлаймын.
Dialogue: 0,0:02:38.37,0:02:39.96,Main,,0,0,0,,Мен де солай сезінемін.
Dialogue: 0,00:02:39.45,00:02:41.36,JPN TOP,,0,0,0,,Мен де солай ойлаймын.
Dialogue: 0,0:02:40.42,0:02:44.54,Main,,0,0,0,,Сондықтан біз ағайындар күнде жұмыс істейміз.
Dialogue: 0,00:02:41.45,00:02:45.49,JPN TOP,,0,0,0,,Сондықтан ағаларым екеуміз күнде осылай жұмыс істейміз.
Dialogue: 0,0:02:44.54,0:02:45.43,Main,,0,0,0,,Ұзақ жұмыс күнінен кейін бір шыныаяқ сакэ ішуден артық ештеңе жоқ!
Dialogue: 0,00:02:45.62,00:02:46.58,JPN TOP,,0,0,0,,Мен және ұлым
Dialogue: 0,0:02:47.19,0:02:49.52,Main,,0,0,0,,Біріншіден, біз бір тонна ақша жинаймыз.
Dialogue: 0,00:02:48.25,00:02:50.67,JPN TOP,,0,0,0,,Біріншіден, көп ақша жинаңыз
Dialogue: 0,0:02:54.28,0:02:59.41,Main,,0,0,0,,Содан кейін, бір күні біз бірге тұру үшін осындай үлкен үй сала аламыз.
Dialogue: 0,00:02:55.34,00:02:56.42,JPN TOP,,0,0,0,,Және бір күні
Dialogue: 0,00:02:56.50,00:03:00.55,JPN TOP,,0,0,0,,Сол сияқты үлкен үй салып, бірге тұрайық.
Dialogue: 0,00:03:02.09,00:03:03.72,JPN TOP,,0,0,0,,Уау...
Dialogue: 0,0:03:03.12,0:03:07.12,Episode_Title,,0,0,0,,Өзгергісі келетін бала
Dialogue: 0,0:03:11.66,0:03:13.37,Main,,0,0,0,,Жарайды, жұмыс уақыты!
Dialogue: 0,00:03:12.69,00:03:14.31,JPN TOP,,0,0,0,,Енді жұмысқа кірісейік!
Dialogue: 0,0:03:13.86,0:03:16.82,Main,,0,0,0,,Шин, сен бүгін даладасың.
Dialogue: 0,00:03:14.94,00:03:17.78,JPN TOP,,0,0,0,,Шин, сен бүгін де даладасың.
Dialogue: 0,0:03:16.82,0:03:18.88,Main,,0,0,0,,Гугу, базарға көкөніс сат.
Dialogue: 0,00:03:17.86,00:03:19.82,JPN TOP,,0,0,0,,Гу Гу базарда көкөніс сатады.
Dialogue: 0,0:03:19.36,0:03:21.29,Main,,0,0,0,,Соңғысын сатыңыз.
Dialogue: 0,00:03:20.40,00:03:22.24,JPN TOP,,0,0,0,,Олардың әрқайсысын сат.
Dialogue: 0,0:03:21.29,0:03:22.89,Main,,0,0,0,,Иә, шебер.
Dialogue: 0,00:03:22.32,00:03:23.82,JPN TOP,,0,0,0,,Иә, сэр!
Dialogue: 0,0:03:31.13,0:03:33.14,Main,,0,0,0,,Мұнда жаңа піскен өнімдер!
Dialogue: 0,00:03:32.21,00:03:34.04,JPN TOP,,0,0,0,,Welcome! Қош келдіңіз!
Dialogue: 0,0:03:33.14,0:03:35.02,Main,,0,0,0,,Мұнда жаңа піскен өнімдер!
Dialogue: 0,00:03:34.17,00:03:36.84,JPN TOP,,0,0,0,,Қош келдіңіз, қош келдіңіз... а
Dialogue: 0,0:03:40.83,0:03:43.66,Italics,,0,0,0,,Ол қыз әрқашан осында.
Dialogue: 0,00:03:41.93,00:03:44.89,JPN TOP,,0,0,0,,Ол қыз үнемі осында.
Dialogue: 0,0:03:43.95,0:03:45.64,Italics,,0,0,0,,Оның есімі кім екен деп ойлаймын.
Dialogue: 0,00:03:44.97,00:03:48.35,JPN TOP,,0,0,0,,What's his name? Ол сол сарайдың баласы ма?
Dialogue: 0,0:03:45.64,0:03:47.41,Italics,,0,0,0,,Мүмкін ол сол сарайдан шығар?
Dialogue: 0,00:03:48.43,00:03:49.56,JPN TOP,,0,0,0,,Ha
Dialogue: 0,0:03:50.67,0:03:53.42,Main,,0,0,0,,Сіз мұнда тұқым сатасыз ба?
Dialogue: 0,00:03:51.68,00:03:54.35,JPN TOP,,0,0,0,,Сіз мұнда тұқым сатасыз ба?
Dialogue: 0,0:03:53.42,0:03:54.43,Main,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:03:54.43,0:03:56.52,Main,,0,0,0,,О, жоқ, мен емес.
Dialogue: 0,00:03:54.44,00:03:57.86,JPN TOP,,0,0,0,,Не? Ah, no, I don't sell it.
Dialogue: 0,00:03:54.44,00:03:57.86,JPN TOP,,0,0,0,,(Wild pig's cry)
Dialogue: 0,0:03:56.88,0:03:59.46,Main,,0,0,0,,Мен қожайынымнан кейін сұраймын.
Dialogue: 0,00:03:57.94,00:04:00.40,JPN TOP,,0,0,0,,Мен күйеуімнен кейін сұраймын.
Dialogue: 0,0:03:59.88,0:04:02.42,Main,,0,0,0,,Рахмет. Сатып алу.
Dialogue: 0,00:04:00.90,00:04:03.36,JPN TOP,,0,0,0,,Рахмет! Онда кездескенше!
Dialogue: 0,0:04:02.91,0:04:05.53,Main,,0,0,0,,Бұл кәрі осар бұрынғыдай оғаш.
Dialogue: 0,00:04:04.07,00:04:06.41,JPN TOP,,0,0,0,,Ол әлі біртүрлі қарт.
Dialogue: 0,0:04:05.53,0:04:06.63,Main,,0,0,0,,Сабыр сақта, Ято.
Dialogue: 0,00:04:06.49,00:04:07.58,JPN TOP,,0,0,0,,Do you know?
Dialogue: 0,0:04:07.00,0:04:09.16,Main,,0,0,0,,Ол төбеде тұратын сыра қайнатушы.
Dialogue: 0,00:04:07.66,00:04:10.04,JPN TOP,,0,0,0,,Төбедегі ішімдік сататын дүкен
Dialogue: 0,00:04:07.66,00:04:10.04,JPN TOP,,0,0,0,,(жабайы шошқаның айқайы)
Dialogue: 0,0:04:09.16,0:04:12.09,Main,,0,0,0,,Мен оның заңсыз бизнеспен айналысқанын естідім.
Dialogue: 0,00:04:10.12,00:04:13.21,JPN TOP,,0,0,0,,Ол қылмысқа ұқсас нәрсе істеп жатыр деген қауесет бар.
Dialogue: 0,0:04:19.91,0:04:21.43,Main,,0,0,0,,Мен үйдемін, Үлкен аға.
Dialogue: 0,00:04:20.67,00:04:22.34,JPN TOP,,0,0,0,,Бауырым, мен үйдемін.
Dialogue: 0,0:04:21.43,0:04:23.32,Main,,0,0,0,,Мен қалғандарынан біраз қалдық алдым.
Dialogue: 0,0:04:21.83,0:04:23.16,Main,,0,0,0,,Later, Shin.
Dialogue: 0,00:04:22.42,00:04:24.34,JPN TOP,,0,0,0,,I got it.
Dialogue: 0,00:04:22.92,00:04:24.34,JPN TOP,,0,0,0,,See you, Shin
Dialogue: 0,0:04:23.32,0:04:24.77,Main,,0,0,0,,Ертең жеңгеніңіз жөн.
Dialogue: 0,00:04:24.43,00:04:25.72,JPN TOP,,0,0,0,,Ертең жеңіңіз
Dialogue: 0,0:04:24.77,0:04:25.61,Main,,0,0,0,,Оқу, оқу
Dialogue: 0,0:04:25.61,0:04:26.52,Main,,0,0,0,,Сау болыңыз.
Dialogue: 0,00:04:25.80,00:04:27.64,JPN TOP,,0,0,0,,Тағы да
Dialogue: 0,0:04:28.62,0:04:29.68,Main,,0,0,0,,Олар кім болды?
Dialogue: 0,00:04:29.68,00:04:30.77,JPN TOP,,0,0,0,,Who?
Dialogue: 0,0:04:30.21,0:04:31.28,Main,,0,0,0,,My friends.
Dialogue: 0,00:04:31.27,00:04:32.39,JPN TOP,,0,0,0,,Жарай бер, жарай бер — сен ауаны тұншықтырып жатырсың, шетке жыл.
Dialogue: 0,0:04:32.04,0:04:33.71,Main,,0,0,0,,Мен олармен жақында ғана таныстым.
Dialogue: 0,00:04:33.10,00:04:34.64,JPN TOP,,0,0,0,,Жақында кездестік.
Dialogue: 0,0:04:33.71,0:04:35.12,Main,,0,0,0,,Иә?
Dialogue: 0,00:04:34.73,00:04:36.06,JPN TOP,,0,0,0,,Хмм…
Dialogue: 0,0:04:41.23,0:04:41.98,Main,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,00:04:42.32,00:04:43.53,JPN TOP,,0,0,0,,Әй...
Dialogue: 0,0:04:43.32,0:04:44.67,Main,,0,0,0,,Біраз жетіспейді.
Dialogue: 0,00:04:44.36,00:04:45.78,JPN TOP,,0,0,0,,азайту
Dialogue: 0,0:04:46.14,0:04:49.22,Main,,0,0,0,,Үлкен аға, бүгін ақша жұмсадың ба?
Dialogue: 0,00:04:47.20,00:04:50.12,JPN TOP,,0,0,0,,Бауырым, бүгін бірдеңе үшін пайдаландың ба?
Dialogue: 0,0:04:49.22,0:04:50.74,Main,,0,0,0,,Неліктен мен мұны істеймін?
Dialogue: 0,00:04:50.20,00:04:52.00,JPN TOP,,0,0,0,,Жоқ, солай емес пе?
Dialogue: 0,0:04:51.09,0:04:52.90,Main,,0,0,0,,Бір уыс жетіспейді.
Dialogue: 0,00:04:52.08,00:04:55.37,JPN TOP,,0,0,0,,Бір ғана бума қалды. Мүмкін бұл ұрлық шығар.
Dialogue: 0,0:04:52.90,0:04:54.18,Main,,0,0,0,,Сіз бізді тонап кетті деп ойлайсыз ба?
Dialogue: 0,0:04:54.43,0:04:57.11,Main,,0,0,0,,Бұл адамдар бұл туралы білмеді, солай ма?
Dialogue: 0,00:04:55.46,00:04:57.88,JPN TOP,,0,0,0,,Бұрынғылар оны көрмеді, солай ма?
Dialogue: 0,0:04:57.11,0:04:58.85,Main,,0,0,0,,Менің достарымды айыптамаңыз.
Dialogue: 0,00:04:57.96,00:04:59.79,JPN TOP,,0,0,0,,Менің достарыма күмәнданба!
Dialogue: 0,0:04:59.07,0:05:02.04,Main,,0,0,0,,R-оң жақ. Кешіріңіз.
Dialogue: 0,00:04:59.88,00:05:02.96,JPN TOP,,0,0,0,,Дұрыс, кешіріңіз.
Dialogue: 0,0:05:02.04,0:05:05.07,Main,,0,0,0,,Мен жаңа ғана маңайда сызбалы біреу бар екенін естідім, сондықтан...
Dialogue: 0,00:05:03.05,00:05:06.26,JPN TOP,,0,0,0,,Маңайда мазалайтын адамдар бар деп естідім...
Dialogue: 0,00:05:06.76,00:05:07.93,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,0:05:06.91,0:05:08.87,Main,,0,0,0,,Мен таң қалдым.
Dialogue: 0,00:05:08.01,00:05:10.18,JPN TOP,,0,0,0,,Бірақ мен қатты таң қалдым.
Dialogue: 0,0:05:10.04,0:05:11.90,Main,,0,0,0,,Жоғалған нәрсе жоғалады.
Dialogue: 0,00:05:11.10,00:05:14.68,JPN TOP,,0,0,0,,Бұл туралы ештеңе істей алмайсыз.
Dialogue: 0,0:05:12.22,0:05:13.74,Main,,0,0,0,,Оның сізге жетуіне жол бермеңіз.
Dialogue: 0,0:05:16.16,0:05:18.33,Main,,0,0,0,,Иә, дұрыс айтасыз.
Dialogue: 0,00:05:17.23,00:05:19.23,JPN TOP,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:05:18.33,0:05:20.86,Main,,0,0,0,,Біз тағы біраз жұмыс істеп, көбірек ақша таба аламыз.
Dialogue: 0,00:05:19.31,00:05:21.77,JPN TOP,,0,0,0,,Тек қайта жұмыс істеп, үнемдеңіз.
Dialogue: 0,0:05:22.02,0:05:24.49,Main,,0,0,0,,Мен оны бұдан былай осында жасырамын.
Dialogue: 0,00:05:23.11,00:05:25.70,JPN TOP,,0,0,0,,Мұнда жасырынатын орынды өзгертіңіз.
Dialogue: 0,0:05:24.76,0:05:25.64,Main,,0,0,0,,Алдымен, ортаңғы және көрсеткі саусақтарыңызды осылайша қосыңыз,
Dialogue: 0,00:05:25.78,00:05:26.78,JPN TOP,,0,0,0,,О
Dialogue: 0,0:05:26.61,0:05:29.86,Main,,0,0,0,,Мен алған буға пісірілген тоқаштың жартысын алғыңыз келе ме?
Dialogue: 0,00:05:27.70,00:05:30.83,JPN TOP,,0,0,0,,Мен алған буға пісірілген тоқаштың жартысын жегің келе ме?
Dialogue: 0,0:05:29.86,0:05:30.80,Main,,0,0,0,,Жоқ, рахмет.
Dialogue: 0,00:05:30.91,00:05:31.95,JPN TOP,,0,0,0,,Бетіңде әлі де сол мұңды кейіп бар.
Dialogue: 0,00:05:35.71,00:05:36.58,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,00:05:39.50,00:05:41.92,JPN TOP,,0,0,0,,Кю Кю…
Dialogue: 0,0:05:41.34,0:05:43.94,Main,,0,0,0,,Не болды? Сен ашсың ба?
Dialogue: 0,00:05:42.42,00:05:44.88,JPN TOP,,0,0,0,,Не, қарныңыз ашты ма?
Dialogue: 0,0:05:44.61,0:05:46.10,Main,,0,0,0,,Міне, тамақтанып ал.
Dialogue: 0,00:05:45.76,00:05:47.38,JPN TOP,,0,0,0,,Ей, тамақ ішейік.
Dialogue: 0,0:05:48.05,0:05:49.78,Main,,0,0,0,,Екеуміздің де жағдайымыз нашар, иә?
Dialogue: 0,00:05:49.14,00:05:50.89,JPN TOP,,0,0,0,,Екеумізге де қиын.
Dialogue: 0,0:05:54.30,0:05:56.33,Main,,0,0,0,,Мұнда жаңа піскен өнімдер!
Dialogue: 0,00:05:55.35,00:05:57.27,JPN TOP,,0,0,0,,Қош келдіңіз! Қош келдіңіз!
Dialogue: 0,00:05:57.35,00:05:59.06,JPN TOP,,0,0,0,,Тапсырма!
Dialogue: 0,00:05:59.15,00:06:03.40,JPN TOP,,0,0,0,,Уау! Сіз кешегі жігітсіз ғой, солай ма?
Dialogue: 0,0:05:59.31,0:06:02.15,Main,,0,0,0,,Ей, сен кешегі итсің!
Dialogue: 0,0:06:02.49,0:06:05.30,Main,,0,0,0,,Кешіріңіз, менде бүгін буға пісірілген тоқаш жоқ.
Dialogue: 0,00:06:03.48,00:06:06.24,JPN TOP,,0,0,0,,Өкінішке орай, менде бүгін буға пісірілген тоқаш жоқ.
Dialogue: 0,0:06:06.68,0:06:07.81,Main,,0,0,0,,Меер?
Dialogue: 0,00:06:06.74,00:06:08.74,JPN TOP,,0,0,0,,Иә? «тамақ»?
Dialogue: 0,0:06:08.09,0:06:10.75,Main,,0,0,0,,Сенің атың Меер, иә?
Dialogue: 0,00:06:09.24,00:06:11.07,JPN TOP,,0,0,0,,Сіздің атыңыз Мир ба?
Dialogue: 0,0:06:10.22,0:06:11.44,Main,,0,0,0,,Меер!
Dialogue: 0,00:06:11.16,00:06:12.53,JPN TOP,,0,0,0,,Тамақ!
Dialogue: 0,0:06:12.04,0:06:13.37,Main,,0,0,0,,Meer!
Dialogue: 0,00:06:12.62,00:06:14.16,JPN TOP,,0,0,0,,Иә? (Арық) Тамақ!
Dialogue: 0,0:06:13.37,0:06:14.39,Italics,,0,0,0,,Бір қолымда оқпен зарядталған винтовка
Dialogue: 0,00:06:14.24,00:06:15.24,JPN TOP,,0,0,0,,Бұл бала.
Dialogue: 0,0:06:14.39,0:06:15.78,Main,,0,0,0,,Меер!
Dialogue: 0,00:06:15.33,00:06:16.20,JPN TOP,,0,0,0,,Тамақ!
Dialogue: 0,00:06:16.29,00:06:17.71,JPN TOP,,0,0,0,,(Мирдің айқайы)
Dialogue: 0,00:06:17.79,00:06:21.21,JPN TOP,,0,0,0,,А... аа... аа... у...
Dialogue: 0,0:06:19.21,0:06:20.30,Main,,0,0,0,,Олар дәл қашан осы үйдің бір бөлігіне айналды?
Dialogue: 0,0:06:20.63,0:06:23.08,Main,,0,0,0,,Сіз іздеп жүрген адам осы ма?
Dialogue: 0,00:06:21.71,00:06:24.00,JPN TOP,,0,0,0,,Бұл сіз іздеген қыз ба?
Dialogue: 0,00:06:24.09,00:06:25.46,JPN TOP,,0,0,0,,Не? Ах!
Dialogue: 0,0:06:24.67,0:06:26.53,Main,,0,0,0,,Meer!
Dialogue: 0,00:06:25.55,00:06:28.97,JPN TOP,,0,0,0,,Тамақ жоқ! Мен сені сағындым!
Dialogue: 0,0:06:26.53,0:06:28.02,Main,,0,0,0,,Мен сені сағындым!
Dialogue: 0,0:06:30.26,0:06:32.05,Main,,0,0,0,,Мен сізге алғыс айтуым керек.
Dialogue: 0,00:06:31.39,00:06:34.93,JPN TOP,,0,0,0,,Сізге рахмет айтуым керек... Бұл туралы не айтасыз?
Dialogue: 0,0:06:32.48,0:06:33.99,Main,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:06:33.99,0:06:37.59,Main,,0,0,0,,Бұл сіздің әкеңіздің сыйы еді, ханым.
Dialogue: 0,00:06:35.01,00:06:37.81,JPN TOP,,0,0,0,,Кішкентай қыз, бұл әкеңнің сыйы.
Dialogue: 0,0:06:37.80,0:06:39.05,Main,,0,0,0,,Жақсы.
Dialogue: 0,00:06:37.89,00:06:39.98,JPN TOP,,0,0,0,,А-а... (жеңіл) Жарайды.
Dialogue: 0,0:06:39.05,0:06:43.05,Main,,0,0,0,,Менің бұл түсті кимейтінімді біліп, маған сатып алды.
Dialogue: 0,00:06:40.06,00:06:43.98,JPN TOP,,0,0,0,,Менің бұл түсті кимейтінімді білсең де, оны сатып алдың.
Dialogue: 0,0:06:43.30,0:06:47.91,Main,,0,0,0,,Мұны сатыңыз, сонда көкөністерді ешқашан сатудың қажеті болмайды.
Dialogue: 0,00:06:44.48,00:06:48.86,JPN TOP,,0,0,0,,Егер мен мұны сатсам, мен енді ешқашан көкөніс сатумен жұмыс істемеймін.
Dialogue: 0,00:06:48.95,00:06:50.36,JPN TOP,,0,0,0,,Эх!
Dialogue: 0,0:06:50.06,0:06:52.51,Italics,,0,0,0,,Ол мені таниды!
Dialogue: 0,00:06:51.24,00:06:53.66,JPN TOP,,0,0,0,,Ол мен туралы білетін.
Dialogue: 0,0:06:53.22,0:06:55.42,Main,,0,0,0,,Мм... Сенің атың кім?
Dialogue: 0,00:06:54.24,00:06:56.37,JPN TOP,,0,0,0,,Мм... сенің атың кім?
Dialogue: 0,0:06:55.42,0:06:57.73,Main,,0,0,0,,Оған бұл дөрекі сөз болды.
Dialogue: 0,00:06:56.45,00:06:58.54,JPN TOP,,0,0,0,,Сіздің дәл қазір айтқаныңыз дөрекі.
Dialogue: 0,0:06:58.60,0:07:00.93,Main,,0,0,0,,Мен оның көңілін көтеруге тырыстым.
Dialogue: 0,00:06:58.62,00:07:01.87,JPN TOP,,0,0,0,,Иә? Мен жай ғана сені ынталандыруға тырыстым.
Dialogue: 0,0:07:01.28,0:07:02.11,Main,,0,0,0,,Шекара сызықтары?
Dialogue: 0,00:07:01.96,00:07:03.33,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:07:08.22,0:07:09.89,Main,,0,0,0,,Мен үйдемін, Үлкен аға!
Dialogue: 0,00:07:09.30,00:07:10.80,JPN TOP,,0,0,0,,Мен үйдемін, ағайын!
Dialogue: 0,0:07:09.89,0:07:12.12,Main,,0,0,0,,Бүгінгі күнім жақсы өтті!
Dialogue: 0,00:07:10.88,00:07:13.72,JPN TOP,,0,0,0,,Бүгін жақсы нәрсе болды... Иә?
Dialogue: 0,0:07:16.83,0:07:18.08,Main,,0,0,0,,Үлкен аға?
Dialogue: 0,00:07:17.93,00:07:21.06,JPN TOP,,0,0,0,,Аға? Бауырым?
Dialogue: 0,0:07:18.51,0:07:19.94,Main,,0,0,0,,Үлкен аға?
Dialogue: 0,00:07:22.15,00:07:22.98,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:07:38.22,0:07:41.30,Italics,,0,0,0,,Бұл дүниеде «тағдыр» деген нәрсе бар.
Dialogue: 0,00:07:39.29,00:07:42.42,JPN TOP,,0,0,0,,Бұл дүниеде тағдыр деген сөз бар.
Dialogue: 0,0:07:42.22,0:07:44.30,Italics,,0,0,0,,Мен оған қарсы күресуді шештім.
Dialogue: 0,00:07:43.25,00:07:45.33,JPN TOP,,0,0,0,,Мен оған қарсы тұруды шештім.
Dialogue: 0,0:07:45.25,0:07:47.11,Italics,,0,0,0,,Кешіріңіз, Гугу.
Dialogue: 0,00:07:46.38,00:07:48.21,JPN TOP,,0,0,0,,Кешіріңіз Гу Гу
Dialogue: 0,0:07:50.71,0:07:52.07,Main,,0,0,0,,Өтірікші.
Dialogue: 0,00:07:51.76,00:07:53.18,JPN TOP,,0,0,0,,Өтірікші
Dialogue: 0,00:08:06.31,00:08:07.61,JPN TOP,,0,0,0,,Фу…
Dialogue: 0,0:08:09.55,0:08:11.60,Italics,,0,0,0,,Мен неге менмін?
Dialogue: 0,00:08:10.61,00:08:12.53,JPN TOP,,0,0,0,,Неліктен мен кіммін?
Dialogue: 0,0:08:14.54,0:08:19.32,Flashback_Italics,,0,0,0,,Мұны сатыңыз, сонда көкөністерді ешқашан сатудың қажеті болмайды.
Dialogue: 0,00:08:15.62,00:08:18.28,JPN TOP,,0,0,0,,Осыны сатсам, көкөніс сататын жұмысым болмайды.
Dialogue: 0,00:08:18.37,00:08:20.45,JPN TOP,,0,0,0,,Сізге мәңгі өмір сүрудің қажеті жоқ.
Dialogue: 0,00:08:25.04,00:08:27.04,JPN TOP,,0,0,0,,(Арбаның жүгіру дыбысы)
Dialogue: 0,00:08:26.21,00:08:27.04,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:08:32.30,0:08:33.90,Italics,,0,0,0,,Егер мен сол нәрсеге соқтығыссам...
Dialogue: 0,00:08:33.34,00:08:38.10,JPN TOP,,0,0,0,,Егер сіз бұл затты ұрсаңыз, ол жарылып кетеді.
Dialogue: 0,0:08:34.30,0:08:36.77,Italics,,0,0,0,,Ұнады, бам! Құлап! Апат!
Dialogue: 0,0:08:37.17,0:08:38.92,Italics,,0,0,0,,Бұл менің тағдырымды өзгерте ме?
Dialogue: 0,00:08:38.18,00:08:39.85,JPN TOP,,0,0,0,,Тағдыр өзгерер ме екен...
Dialogue: 0,0:08:39.67,0:08:43.60,Italics,,0,0,0,,Жоқ, мен не ойлап отырмын?
Dialogue: 0,00:08:40.72,00:08:44.81,JPN TOP,,0,0,0,,Мен қандай ақымақ нәрсе ойлап тұрмын?
Dialogue: 0,0:08:54.27,0:08:56.34,Main,,0,0,0,,Сәлем! Сенде бәрі жақсы ма?
Dialogue: 0,00:08:55.32,00:08:57.28,JPN TOP,,0,0,0,,Эй, сен ауырып қалдың ба?
Dialogue: 0,00:08:57.37,00:09:00.33,JPN TOP,,0,0,0,,Хаха... Сено!
Dialogue: 0,0:08:58.01,0:08:59.42,Main,,0,0,0,,Бір, екі...
Dialogue: 0,00:09:00.41,00:09:02.04,JPN TOP,,0,0,0,,Уф...
Dialogue: 0,0:09:01.76,0:09:03.42,Main,,0,0,0,,Бұл белгі болмайды.
Dialogue: 0,00:09:02.12,00:09:04.37,JPN TOP,,0,0,0,,Тіпті алаңдамаңыз
Dialogue: 0,0:09:03.42,0:09:06.02,Main,,0,0,0,,Мен барып көмек алуым керек. Осыны қадағалай аласыз ба?
Dialogue: 0,00:09:04.46,00:09:06.96,JPN TOP,,0,0,0,,Мен біреуді шақырамын, сен мені бақылай аласың ба?
Dialogue: 0,0:09:06.02,0:09:07.35,Main,,0,0,0,,Иә? О...
Dialogue: 0,00:09:07.04,00:09:08.29,JPN TOP,,0,0,0,,(Сузуя) Ал сен неге Гульге айналдың?
Dialogue: 0,00:09:08.38,00:09:10.00,JPN TOP,,0,0,0,,(Жүргізушінің қатты тыныс алуы)
Dialogue: 0,00:09:10.75,00:09:12.42,JPN TOP,,0,0,0,,Я...
Dialogue: 0,0:09:11.44,0:09:14.85,Main,,0,0,0,,Бұл қауіпті болды. Ол тым жылдам жүрді.
Dialogue: 0,00:09:12.51,00:09:15.80,JPN TOP,,0,0,0,,Бұл қауіпті. Сіз тым жылдам бара жатырсыз.
Dialogue: 0,0:09:14.85,0:09:16.86,Main,,0,0,0,,Мен шынымен өлетін едім.
Dialogue: 0,00:09:15.88,00:09:17.80,JPN TOP,,0,0,0,,Мен өліп қала жаздадым.
Dialogue: 0,00:09:26.44,00:09:27.27,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:09:29.28,0:09:30.55,Main,,0,0,0,,Бір сәт те жоғалтуға болмайды.
Dialogue: 0,00:09:30.40,00:09:34.44,JPN TOP,,0,0,0,,Сәлем! Бұл адам қауіпті!
Dialogue: 0,0:09:30.55,0:09:33.22,Main,,0,0,0,,Сен сонда! Абайлау!
Dialogue: 0,00:09:35.57,00:09:36.61,JPN TOP,,0,0,0,,Ах!
Dialogue: 0,0:09:38.18,0:09:39.96,Main,,0,0,0,,Абайлаңыз!
Dialogue: 0,00:09:39.20,00:09:42.12,JPN TOP,,0,0,0,,Бұл қауіпті! Жүгіріп кету!
Dialogue: 0,0:09:39.96,0:09:41.18,Main,,0,0,0,,Бұл тек менің алаңдаулы жүрегімді жеделдетті
Dialogue: 0,00:09:45.54,00:09:47.08,JPN TOP,,0,0,0,,Қақпақ…
Dialogue: 0,00:09:58.68,00:09:59.51,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,0:09:59.89,0:10:02.57,Italics,,0,0,0,,Біреу... маған көмектесші...
Dialogue: 0,00:10:00.97,00:10:03.51,JPN TOP,,0,0,0,,Біреу маған көмектесіңізші...
Dialogue: 0,00:10:04.06,00:10:05.81,JPN TOP,,0,0,0,,(Құлаған бөренелердің дыбысы)
Dialogue: 0,0:10:06.38,0:10:07.68,Main,,0,0,0,,Оның қансырап жатыр!
Dialogue: 0,00:10:07.39,00:10:09.56,JPN TOP,,0,0,0,,Қан бар! Сенімен бәрі жақсы ма?
Dialogue: 0,0:10:07.68,0:10:08.65,Main,,0,0,0,,Маған көмектес...
Dialogue: 0,0:10:08.65,0:10:10.73,Main,,0,0,0,,Асығыңыз! Оның жараларын емдеңіз!
Dialogue: 0,00:10:09.65,00:10:11.69,JPN TOP,,0,0,0,,Жараны тез емдеңіз!
Dialogue: 0,0:10:11.51,0:10:13.33,Main,,0,0,0,,Оның есі бар!
Dialogue: 0,00:10:11.77,00:10:14.28,JPN TOP,,0,0,0,,А, мен байқадым!
Dialogue: 0,0:10:13.33,0:10:15.28,Main,,0,0,0,,Реан! Реан!
Dialogue: 0,00:10:14.36,00:10:17.95,JPN TOP,,0,0,0,,Арық... Арқаң! Мықты бол
Dialogue: 0,0:10:15.28,0:10:16.81,Main,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:10:18.03,0:10:21.47,Italics,,0,0,0,,Оның аты Реан, иә?
Dialogue: 0,0:10:18.61,0:10:19.91,Main - Top,,0,0,0,,Қазір бәрі жақсы.
Dialogue: 0,00:10:19.03,00:10:20.82,JPN TOP,,0,0,0,,Оның аты Лианна.
Dialogue: 0,00:10:19.61,00:10:20.82,JPN TOP,,0,0,0,,Қазір бәрі жақсы.
Dialogue: 0,0:10:19.91,0:10:21.47,Main - Top,,0,0,0,,H-Оны көтеруге көмектесіңізші!
Dialogue: 0,00:10:20.82,00:10:22.41,JPN TOP,,0,0,0,,Оның аты – Лианна.
Dialogue: 0,00:10:20.91,00:10:22.41,JPN TOP,,0,0,0,,Маған оны ұстауға көмектесіңіз
Dialogue: 0,0:10:21.47,0:10:22.35,Main - Top,,0,0,0,,Басқа серіктес және серіктес емес ғибадатханалардың көмегімен бөгеттерді тұрғызғаннан кейін,
Dialogue: 0,0:10:22.35,0:10:24.30,Main - Top,,0,0,0,,Дайын ба? және...
Dialogue: 0,0:10:22.36,0:10:25.71,Italics,,0,0,0,,Құдайға шүкір. Ол қауіпсіз.
Dialogue: 0,00:10:22.49,00:10:23.33,JPN TOP,,0,0,0,,Иә
Dialogue: 0,00:10:23.41,00:10:24.91,JPN TOP,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,00:10:23.41,00:10:26.58,JPN TOP,,0,0,0,,Жақсы, құтқарылдыңыз ба?
Dialogue: 0,00:10:24.99,00:10:26.58,JPN TOP,,0,0,0,,Бүгінгі жағдайда ол профессор Годжо немесе сондай біреу болар еді.
Dialogue: 0,0:10:25.71,0:10:26.97,Italics,,0,0,0,,Біздің руға шабуыл жасаған Маскалылар Эбису-саманың…
Dialogue: 0,0:10:26.18,0:10:27.49,Main,,0,0,0,,Мырза...
Dialogue: 0,00:10:26.66,00:10:27.91,JPN TOP,,0,0,0,,Жақсы...
Dialogue: 0,00:10:26.66,00:10:27.91,JPN TOP,,0,0,0,,Күйеуі...
Dialogue: 0,0:10:27.81,0:10:30.33,Main,,0,0,0,,Үйге қайтайық.
Dialogue: 0,00:10:28.83,00:10:31.50,JPN TOP,,0,0,0,,Жарайды, сарайға қайтайық.
Dialogue: 0,0:10:31.17,0:10:33.34,Main,,0,0,0,,Үйге асығыңыз!
Dialogue: 0,00:10:32.17,00:10:34.30,JPN TOP,,0,0,0,,Сіз, алдымен кері қайтыңыз.
Dialogue: 0,0:10:33.34,0:10:34.34,Main,,0,0,0,,Иә, сэр!
Dialogue: 0,00:10:34.38,00:10:35.50,JPN TOP,,0,0,0,,Иә!
Dialogue: 0,00:11:01.03,00:11:03.41,JPN TOP,,0,0,0,,Хмм... Цу...
Dialogue: 0,00:11:03.49,00:11:04.45,JPN TOP,,0,0,0,,Я...
Dialogue: 0,0:11:04.70,0:11:05.88,Main,,0,0,0,,Мен қайдамын?
Dialogue: 0,00:11:05.74,00:11:06.83,JPN TOP,,0,0,0,,Бұл қайда?
Dialogue: 0,00:11:07.62,00:11:09.00,JPN TOP,,0,0,0,,Уау...
Dialogue: 0,0:11:08.54,0:11:10.61,Main,,0,0,0,,Мен өзімді баяу сезінемін.
Dialogue: 0,00:11:09.66,00:11:11.54,JPN TOP,,0,0,0,,Сен нағыз бас аурусың.
Dialogue: 0,0:11:16.15,0:11:19.83,Main,,0,0,0,,Менің ішім шығып тұр.
Dialogue: 0,00:11:17.17,00:11:20.93,JPN TOP,,0,0,0,,Мен... ішім қатты шығып тұрғандай сезінемін.
Dialogue: 0,00:11:21.97,00:11:22.93,JPN TOP,,0,0,0,,Ах!
Dialogue: 0,0:11:22.90,0:11:23.96,Main,,0,0,0,,Менің көзім...
Dialogue: 0,00:11:23.89,00:11:27.43,JPN TOP,,0,0,0,,Көз... Ауыз... Мұрын...
Dialogue: 0,0:11:23.96,0:11:24.98,Main,,0,0,0,,Менің аузым...
Dialogue: 0,0:11:25.38,0:11:26.48,Main,,0,0,0,,Менің мұрным...
Dialogue: 0,0:11:27.99,0:11:30.99,Main,,0,0,0,,Мен ұқсаймын...
Dialogue: 0,00:11:29.10,00:11:31.94,JPN TOP,,0,0,0,,Бұл дәл солай...
Dialogue: 0,0:11:31.22,0:11:34.63,Main,,0,0,0,,Сіздің мұрныңыз бұзылды, бірақ сіз әлі де жей аласыз.
Dialogue: 0,00:11:32.02,00:11:35.52,JPN TOP,,0,0,0,,Мұрным сынған, бірақ тамақ жей аламын.
Dialogue: 0,0:11:34.63,0:11:37.47,Main,,0,0,0,,Басыңыздан өткен жағдайды ескере отырып, сонда ілулі тұрғаныңызға таң қалдым.
Dialogue: 0,00:11:35.61,00:11:38.40,JPN TOP,,0,0,0,,Сіз бұл жағдайдан жақсы шықтыңыз.
Dialogue: 0,0:11:38.09,0:11:40.81,Main,,0,0,0,,Сіз бақытты жансыз.
Dialogue: 0,00:11:39.24,00:11:41.74,JPN TOP,,0,0,0,,Сізге сәттілік!
Dialogue: 0,0:11:41.97,0:11:47.34,Italics,,0,0,0,,Мен әрқашан мен емес адам ретінде өмір сүруді армандадым.
Dialogue: 0,00:11:43.03,00:11:44.49,JPN TOP,,0,0,0,,(Rodanse) Тыныш болыңыздар, өтінемін. (Bluebell) Ой!
Dialogue: 0,00:11:44.57,00:11:48.41,JPN TOP,,0,0,0,,Мен өзімнен басқа біреу сияқты өмір сүруді армандадым
Dialogue: 0,0:11:48.49,0:11:50.09,Italics,,0,0,0,,Менің арманым орындалды.
Dialogue: 0,00:11:49.54,00:11:51.25,JPN TOP,,0,0,0,,Арман орындалды
Dialogue: 0,0:11:50.60,0:11:54.32,Italics,,0,0,0,,Мен өзім емес құбыжық болдым.
Dialogue: 0,00:11:51.75,00:11:55.42,JPN TOP,,0,0,0,,Мен емес құбыжық болдым.
Dialogue: 0,0:11:55.63,0:11:56.80,Main,,0,0,0,,Сіз естідіңіз бе?
Dialogue: 0,00:11:56.71,00:11:59.34,JPN TOP,,0,0,0,,Сіз білесіз бе? Сол ескі оғаш
Dialogue: 0,0:11:56.80,0:12:00.77,Main,,0,0,0,,Әлгі ақымақ қарт ақыры құбыжық жасады.
Dialogue: 0,00:11:59.42,00:12:01.72,JPN TOP,,0,0,0,,Олар ақырында құбыжықты жасаған сияқты.
Dialogue: 0,0:12:04.96,0:12:07.63,Main,,0,0,0,,Сәлем! Қарт қайда?!
Dialogue: 0,00:12:06.01,00:12:08.81,JPN TOP,,0,0,0,,Сәлем! Қарт адам бар ма?
Dialogue: 0,0:12:09.13,0:12:14.30,Main,,0,0,0,,Рахмет! Pioran сізге сыйлық әкелді!
Dialogue: 0,00:12:10.18,00:12:15.23,JPN TOP,,0,0,0,,Мына Пиоран сізге кәдесый әкелді.
Dialogue: 0,0:12:15.36,0:12:18.30,Main,,0,0,0,,Өлмейтін ақымақ!
Dialogue: 0,00:12:16.40,00:12:19.44,JPN TOP,,0,0,0,,Өлмейтін құбыжық
Dialogue: 0,0:12:30.59,0:12:33.26,Main,,0,0,0,,Жақсы ма? Бұл таңқаларлық емес пе?
Dialogue: 0,00:12:31.70,00:12:34.21,JPN TOP,,0,0,0,,Бұл таңқаларлық емес пе?
Dialogue: 0,0:12:33.46,0:12:36.16,Main,,0,0,0,,Бұл өлмейтін, иә?
Dialogue: 0,00:12:34.29,00:12:37.21,JPN TOP,,0,0,0,,Сонымен қатар, сіз өлмейтін болдыңыз ба?
Dialogue: 0,0:12:36.16,0:12:37.45,Main,,0,0,0,,Сіз мені түсіндіңіз.
Dialogue: 0,00:12:37.29,00:12:41.30,JPN TOP,,0,0,0,,Жоқ! Бұл менің қолымнан келмейтін материал.
Dialogue: 0,0:12:37.45,0:12:39.89,Main,,0,0,0,,Бұл мен үшін тым көп.
Dialogue: 0,0:12:40.32,0:12:43.79,Main,,0,0,0,,Оны қайдан таптың, кемпір?
Dialogue: 0,00:12:41.38,00:12:44.72,JPN TOP,,0,0,0,,Оны қайдан алдың, Баа-сан?
Dialogue: 0,0:12:44.04,0:12:46.71,Main,,0,0,0,,Яном оны басып алды.
Dialogue: 0,00:12:44.80,00:12:47.68,JPN TOP,,0,0,0,,Yanome оны басып алды.
Dialogue: 0,0:12:46.71,0:12:49.27,Main,,0,0,0,,Біз бірге көп нәрсені бастан өткердік, енді менімен бірге.
Dialogue: 0,00:12:47.76,00:12:50.22,JPN TOP,,0,0,0,,Түрлі себептерге байланысты мен оны айналамын
Dialogue: 0,0:12:52.23,0:12:53.74,Main,,0,0,0,,H-Эй.
Dialogue: 0,00:12:53.31,00:12:54.85,JPN TOP,,0,0,0,,Иә... сәлем
Dialogue: 0,0:12:54.62,0:12:59.29,Main,,0,0,0,,Мен... Менің атым Гугу. Мен мұнда қызметшімін.
Dialogue: 0,00:12:55.64,00:12:56.94,JPN TOP,,0,0,0,,Мен...
Dialogue: 0,00:12:57.02,00:13:00.23,JPN TOP,,0,0,0,,Мен мұнда қызметшімін, ал менің атым Гу Гу.
Dialogue: 0,0:12:59.29,0:13:00.70,Main,,0,0,0,,Сенің атың кім?
Dialogue: 0,00:13:00.32,00:13:01.65,JPN TOP,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:13:01.94,0:13:03.89,Main,,0,0,0,,Аты...?
Dialogue: 0,00:13:03.07,00:13:04.70,JPN TOP,,0,0,0,,На ма…
Dialogue: 0,0:13:03.89,0:13:06.17,Main,,0,0,0,,Оның аты Фуши.
Dialogue: 0,00:13:04.78,00:13:07.11,JPN TOP,,0,0,0,,Бұл жігіт Фуши деп аталады.
Dialogue: 0,0:13:06.68,0:13:08.83,Main,,0,0,0,,Фуши? Өйткені сен өлмейтінсің бе?
Dialogue: 0,00:13:07.78,00:13:09.74,JPN TOP,,0,0,0,,Өлмейтін болғандықтан Фуши ме?
Dialogue: 0,0:13:08.83,0:13:10.37,Main,,0,0,0,,Бұл өте мұрнына!
Dialogue: 0,00:13:09.83,00:13:12.54,JPN TOP,,0,0,0,,Дәл солай! Ахах...
Dialogue: 0,0:13:12.41,0:13:13.21,Main,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,00:13:13.45,00:13:14.46,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:13:13.86,0:13:15.42,Main,,0,0,0,,Сен біртүрлі екенсің.
Dialogue: 0,00:13:14.96,00:13:17.58,JPN TOP,,0,0,0,,Ол біртүрлі жігіт, жарай ма?
Dialogue: 0,0:13:15.42,0:13:16.48,Main,,0,0,0,,Қалай болса да.
Dialogue: 0,0:13:17.00,0:13:20.52,Main,,0,0,0,,Ей, ішімдік, мен оны көрсетсем қарсы боласың ба?
Dialogue: 0,00:13:18.08,00:13:21.50,JPN TOP,,0,0,0,,Әй, Сакеджи, мен бұл адамды көрсетсем бола ма?
Dialogue: 0,0:13:20.52,0:13:21.60,Main,,0,0,0,,Ф-Фатирлеу ештеңе әкелмейді.
Dialogue: 0,00:13:21.59,00:13:22.55,JPN TOP,,0,0,0,,О
Dialogue: 0,0:13:22.64,0:13:25.02,Main,,0,0,0,,Екеуің де осында тұрасыңдар, иә?
Dialogue: 0,00:13:23.76,00:13:25.97,JPN TOP,,0,0,0,,Балалар, сендер де осында уақыт өткізесіңдер ме?
Dialogue: 0,0:13:25.24,0:13:28.30,Main,,0,0,0,,Менің келгеніме үш ай болды.
Dialogue: 0,00:13:26.05,00:13:29.35,JPN TOP,,0,0,0,,Менің келгеніме үш ай болды.
Dialogue: 0,0:13:28.76,0:13:32.46,Main,,0,0,0,,Мен қатты жараландым, ішімдік адам келіп көмектесті.
Dialogue: 0,00:13:29.85,00:13:33.43,JPN TOP,,0,0,0,,Ауыр жарақат алғанымда Саке қарт маған көмектесті.
Dialogue: 0,0:13:32.83,0:13:35.21,Main,,0,0,0,,Ол біртүрлі кәрі палуан.
Dialogue: 0,00:13:33.93,00:13:36.14,JPN TOP,,0,0,0,,Негізінде ол біртүрлі адам.
Dialogue: 0,0:13:35.50,0:13:39.97,Main,,0,0,0,,О, мен оны ішімдік ішетін адам деп атаймын.
Dialogue: 0,00:13:36.64,00:13:38.15,JPN TOP,,0,0,0,,А, ақсақал?
Dialogue: 0,00:13:38.23,00:13:41.02,JPN TOP,,0,0,0,,Қарттың ішімдік жасайтыны.
Dialogue: 0,0:13:39.97,0:13:43.27,Main,,0,0,0,,Оның тұтынушылары тым көп емес, өйткені бұл талғампаздық.
Dialogue: 0,00:13:41.11,00:13:44.15,JPN TOP,,0,0,0,,Бұл тек энтузиастар арасында танымал, бірақ тұтынушылар көп емес.
Dialogue: 0,0:13:43.67,0:13:46.22,Main,,0,0,0,,Қараңыз. Бұл жерде ол дистилляция жасайды.
Dialogue: 0,00:13:44.69,00:13:47.15,JPN TOP,,0,0,0,,Қараңдар, біз осы жерде дистилляция жасап жатырмыз.
Dialogue: 0,0:13:47.27,0:13:48.39,Main,,0,0,0,,Жер
Dialogue: 0,00:13:48.28,00:13:49.37,JPN TOP,,0,0,0,,Нани?
Dialogue: 0,00:13:49.45,00:13:50.49,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:13:49.86,0:13:52.45,Main,,0,0,0,,«Ішімдік» дегеніміз не?
Dialogue: 0,00:13:50.99,00:13:53.74,JPN TOP,,0,0,0,,Саке... Нани?
Dialogue: 0,0:13:52.84,0:13:53.72,Main,,0,0,0,,Ә... ә... білесің бе...
Dialogue: 0,00:13:53.83,00:13:54.66,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,0:13:56.40,0:13:57.69,Main,,0,0,0,,Байқап көріңіз.
Dialogue: 0,00:13:57.46,00:13:58.75,JPN TOP,,0,0,0,,Ішіңіз
Dialogue: 0,00:14:01.42,00:14:02.59,JPN TOP,,0,0,0,,(тұншыққан дауыс)
Dialogue: 0,00:14:02.67,00:14:04.05,JPN TOP,,0,0,0,,Хахаха!
Dialogue: 0,0:14:04.04,0:14:08.08,Main,,0,0,0,,Мен сіздің киіміңіздің өте лас екенін байқадым.
Dialogue: 0,00:14:05.21,00:14:08.97,JPN TOP,,0,0,0,,Ойланып қарашы, киген киімің кір.
Dialogue: 0,0:14:08.08,0:14:09.62,Main,,0,0,0,,Адамдар арам жігіттерді ұнатпайды.
Dialogue: 0,00:14:09.05,00:14:10.55,JPN TOP,,0,0,0,,Лас танымал емес
Dialogue: 0,0:14:11.81,0:14:14.20,Main,,0,0,0,,Әй, қайда бара жатырсың?
Dialogue: 0,00:14:12.64,00:14:15.14,JPN TOP,,0,0,0,,Әй, қайда барасың?
Dialogue: 0,0:14:14.20,0:14:16.11,Main,,0,0,0,,Біз суда ойнаймыз.
Dialogue: 0,00:14:15.22,00:14:17.06,JPN TOP,,0,0,0,,Мен суда аздап ойнаймын.
Dialogue: 0,00:14:19.48,00:14:20.31,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:14:22.25,0:14:23.62,Main,,0,0,0,,Құдайым, маған көмектес
Dialogue: 0,00:14:23.27,00:14:24.57,JPN TOP,,0,0,0,,Не болды?
Dialogue: 0,0:14:23.97,0:14:26.63,Main,,0,0,0,,Сіз орманнан қорқасыз, солай емес пе?
Dialogue: 0,00:14:24.65,00:14:27.57,JPN TOP,,0,0,0,,Сіз орманнан қорқасыз, солай емес пе?
Dialogue: 0,0:14:26.63,0:14:27.75,Main,,0,0,0,,Қорқасыз ба?
Dialogue: 0,00:14:27.65,00:14:28.70,JPN TOP,,0,0,0,,Қорқынышты ма?
Dialogue: 0,0:14:28.02,0:14:31.85,Main,,0,0,0,,Бізге орманда белгісіз бір нәрсе шабуыл жасады.
Dialogue: 0,00:14:28.78,00:14:32.83,JPN TOP,,0,0,0,,Маған орманда жұмбақ адам шабуыл жасады.
Dialogue: 0,0:14:31.85,0:14:35.03,Main,,0,0,0,,Бұл ағашқа ұқсайды.
Dialogue: 0,00:14:32.91,00:14:35.95,JPN TOP,,0,0,0,,Бұл нәрсе ағашқа ұқсайды.
Dialogue: 0,0:14:35.47,0:14:36.93,Main,,0,0,0,,Шекара сызықтары?
Dialogue: 0,00:14:36.54,00:14:40.42,JPN TOP,,0,0,0,,А... сен өлмейтін болудан шынымен қорқасың ба?
Dialogue: 0,0:14:36.93,0:14:39.47,Main,,0,0,0,,Өлмейтін болсаң да, одан қорқасың ба?
Dialogue: 0,0:14:39.83,0:14:41.44,Main,,0,0,0,,содан кейін өзіңіз бен Фантомның арасында сызық сызып көріңіз.
Dialogue: 0,00:14:40.96,00:14:42.38,JPN TOP,,0,0,0,,Қорқынышты
Dialogue: 0,0:14:41.72,0:14:43.93,Main,,0,0,0,,Жарайды. Бұл жақсы.
Dialogue: 0,00:14:42.46,00:14:44.96,JPN TOP,,0,0,0,,Иә, түсіндім.
Dialogue: 0,0:14:43.93,0:14:45.44,Main,,0,0,0,,содан кейін өзіңіз бен Фантомның арасында сызық сызып көріңіз.
Dialogue: 0,00:14:45.05,00:14:46.38,JPN TOP,,0,0,0,,Бұл... I
Dialogue: 0,0:14:46.62,0:14:49.86,Main,,0,0,0,,Бұл суды пайдаланғанымыз үшін қиындыққа тап боламыз, бірақ...
Dialogue: 0,00:14:47.76,00:14:50.76,JPN TOP,,0,0,0,,Осы жердегі суды пайдалансам ұрысады.
Dialogue: 0,0:14:49.86,0:14:50.97,Main,,0,0,0,,О, жақсы.
Dialogue: 0,00:14:50.84,00:14:52.68,JPN TOP,,0,0,0,,Жарайды... Иә?
Dialogue: 0,0:14:50.97,0:14:51.73,Main,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:14:52.29,0:14:54.03,Main,,0,0,0,,Неліктен жарақат алдыңыз?
Dialogue: 0,00:14:53.39,00:14:56.31,JPN TOP,,0,0,0,,Неліктен ренжідіңіз? Мен өлмейтін болсам да
Dialogue: 0,0:14:54.03,0:14:55.35,Main,,0,0,0,,Мен сені өлмейтін деп ойладым.
Dialogue: 0,0:14:57.57,0:14:59.36,Main,,0,0,0,,Сіз білмейсіз бе?
Dialogue: 0,00:14:58.64,00:15:00.31,JPN TOP,,0,0,0,,Түсінбейсің бе?
Dialogue: 0,0:14:59.66,0:15:03.18,Main,,0,0,0,,Қалай жауап береріңді білмесең, «білмеймін» дейсің.
Dialogue: 0,00:15:00.39,00:15:04.52,JPN TOP,,0,0,0,,Жауап таба алмасаңыз, «білмеймін» деп айтыңыз.
Dialogue: 0,0:15:03.59,0:15:05.02,Main,,0,0,0,,Тик-так, сағат тілі тик-так
Dialogue: 0,00:15:04.61,00:15:05.98,JPN TOP,,0,0,0,,Шынында да. Мен оны жеңілдетіп бағаладым. Шынында да жеңілдетіп бағаладым
Dialogue: 0,0:15:05.02,0:15:07.34,Main,,0,0,0,,Ей, кем дегенде, сізбен ақылдасу оңай.
Dialogue: 0,00:15:06.07,00:15:08.49,JPN TOP,,0,0,0,,Ой, сен жақсы тыңдайсың.
Dialogue: 0,0:15:07.83,0:15:09.48,Main,,0,0,0,,Жарайды, шешініп ал.
Dialogue: 0,00:15:08.99,00:15:11.82,JPN TOP,,0,0,0,,Енді оны шешіп, жуыңыз.
Dialogue: 0,0:15:09.48,0:15:10.86,Main,,0,0,0,,Мен оны жуамын.
Dialogue: 0,0:15:10.86,0:15:11.72,Main,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,00:15:11.91,00:15:14.41,JPN TOP,,0,0,0,,Иә? Екеуміз бірге болғанымызды қалаймын...
Dialogue: 0,0:15:11.95,0:15:13.47,Main,,0,0,0,,Бұл сізге жабысып қалды.
Dialogue: 0,0:15:14.01,0:15:14.98,Main,,0,0,0,,Бұл да.
Dialogue: 0,00:15:15.08,00:15:15.91,JPN TOP,,0,0,0,,Мұнда да...
Dialogue: 0,0:15:15.27,0:15:17.43,Main,,0,0,0,,Және бұл! Неге?!
Dialogue: 0,00:15:15.99,00:15:18.37,JPN TOP,,0,0,0,,Бұл да! неге?
Dialogue: 0,00:15:21.42,00:15:22.54,JPN TOP,,0,0,0,,А (жұт) А?
Dialogue: 0,0:15:21.59,0:15:22.98,Main,,0,0,0,,Сәлем! Болма!
Dialogue: 0,00:15:22.63,00:15:23.92,JPN TOP,,0,0,0,,Эй, кел!
Dialogue: 0,00:15:22.63,00:15:26.34,JPN TOP,,0,0,0,,(Фушидің айқайы)
Dialogue: 0,0:15:22.98,0:15:24.47,Main,,0,0,0,,Маған шешінудің қажеті жоқ!
Dialogue: 0,00:15:24.00,00:15:27.13,JPN TOP,,0,0,0,,Маған бәрібір, өйткені мен ұсқынсызмын...
Dialogue: 0,0:15:24.47,0:15:26.22,Main,,0,0,0,,Мен шынымен де ұсқынсызмын!
Dialogue: 0,00:15:27.21,00:15:28.34,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,0:15:31.19,0:15:33.44,Main,,0,0,0,,Көрдіңіз бе? Мен ұсқынсыз емеспін бе?
Dialogue: 0,00:15:32.26,00:15:34.55,JPN TOP,,0,0,0,,Қарашы, сен ұсқынсызсың, солай ма?
Dialogue: 0,0:15:34.57,0:15:37.18,Main,,0,0,0,,S-Бірдеңе айт.
Dialogue: 0,00:15:34.64,00:15:35.60,JPN TOP,,0,0,0,,Ммм
Dialogue: 0,00:15:35.68,00:15:38.06,JPN TOP,,0,0,0,,Эй... бірдеңе айт.
Dialogue: 0,0:15:37.18,0:15:39.92,Main,,0,0,0,,«Ұсқынсыз» деген не?
Dialogue: 0,00:15:38.14,00:15:39.31,JPN TOP,,0,0,0,,Нани?
Dialogue: 0,00:15:39.39,00:15:41.10,JPN TOP,,0,0,0,,Ұсқынсыз
Dialogue: 0,0:15:40.19,0:15:43.08,Main,,0,0,0,,Күлкілі көрінетін бет.
Dialogue: 0,00:15:41.19,00:15:44.02,JPN TOP,,0,0,0,,Қарасаң қызық болып кететін түрі.
Dialogue: 0,0:15:43.76,0:15:45.54,Main,,0,0,0,,Мен құбыжық сияқтымын.
Dialogue: 0,00:15:44.81,00:15:46.77,JPN TOP,,0,0,0,,Құбыжық сияқты
Dialogue: 0,0:15:45.85,0:15:49.18,Main,,0,0,0,,Мен сияқтылар өмірімізді жасырынып өткізуге мәжбүр.
Dialogue: 0,00:15:46.86,00:15:50.11,JPN TOP,,0,0,0,,Мен сияқтылар өмір бойы жасырынып өтеді.
Dialogue: 0,0:15:49.53,0:15:53.84,Main,,0,0,0,,Мен мұны түсінемін, бірақ мен бұл өмірге әлі үйренген жоқпын.
Dialogue: 0,00:15:50.65,00:15:55.03,JPN TOP,,0,0,0,,Түсіндім, бірақ әлі күнге дейін бұл өмірге үйрене алмай жүрмін.
Dialogue: 0,0:15:54.82,0:15:56.31,Main,,0,0,0,,Ұсқынсыз.
Dialogue: 0,00:15:55.91,00:15:57.87,JPN TOP,,0,0,0,,Шіркін (гу-у)...
Dialogue: 0,0:15:57.24,0:16:00.47,Main,,0,0,0,,Екеуміз де құбыжықпыз. Бірге тұрайық.
Dialogue: 0,00:15:58.37,00:16:01.29,JPN TOP,,0,0,0,,Ал, жарасайық, құбыжықтар.
Dialogue: 0,0:16:00.47,0:16:01.68,Main,,0,0,0,,Ұсқынсыз.
Dialogue: 0,00:16:01.37,00:16:02.62,JPN TOP,,0,0,0,,Ұсқынсыз
Dialogue: 0,0:16:03.96,0:16:05.37,Main,,0,0,0,,Тыңда, Фуши.
Dialogue: 0,00:16:04.71,00:16:06.21,JPN TOP,,0,0,0,,Жарайды, Фуши.
Dialogue: 0,0:16:05.37,0:16:10.59,Main,,0,0,0,,Сіз осында тұратындықтан, жұмысты үйренуіңіз керек.
Dialogue: 0,00:16:06.29,00:16:08.50,JPN TOP,,0,0,0,,Енді осында тұрып жатқандықтан,
Dialogue: 0,00:16:08.59,00:16:11.55,JPN TOP,,0,0,0,,Қажетті жұмысты меңгеруі керек
Dialogue: 0,00:16:11.63,00:16:13.18,JPN TOP,,0,0,0,,Ммм
Dialogue: 0,0:16:12.44,0:16:13.83,Main,,0,0,0,,Мен бір қолымда оқталған винтовка ұстап тұрмын
Dialogue: 0,00:16:13.26,00:16:14.76,JPN TOP,,0,0,0,,Таку!
Dialogue: 0,0:16:13.83,0:16:15.71,Main,,0,0,0,,Кем дегенде «иә» немесе бірдеңе деңіз.
Dialogue: 0,00:16:14.84,00:16:18.93,JPN TOP,,0,0,0,,«Иә!» деп айтыңыз. Жауап беру адам үшін негізгі нәрсе
Dialogue: 0,0:16:15.71,0:16:17.71,Main,,0,0,0,,Адам боламын десең, жауап беруді үйрену керек.
Dialogue: 0,0:16:17.98,0:16:19.00,Main,,0,0,0,,Оған не болды? Ол жалғыз өзі салқынқанды болып жүр.
Dialogue: 0,0:16:19.00,0:16:19.98,Main,,0,0,0,,Қасиетті орындарым қалайша күйреді.
Dialogue: 0,00:16:19.01,00:16:19.97,JPN TOP,,0,0,0,,Иә
Dialogue: 0,00:16:20.06,00:16:20.93,JPN TOP,,0,0,0,,Жарайды
Dialogue: 0,0:16:20.27,0:16:22.66,Main,,0,0,0,,Таңертең оянғанда ең бірінші тазалық жасайсың.
Dialogue: 0,00:16:21.02,00:16:23.48,JPN TOP,,0,0,0,,First thing I do when I wake up in the morning is clean.
Dialogue: 0,0:16:22.66,0:16:23.44,Main,,0,0,0,,Оған не болды? Ол жалғыз өзі салқынқанды болып жүр.
Dialogue: 0,0:16:23.44,0:16:25.27,Main,,0,0,0,,Содан кейін сіз тамақ жасайсыз.
Dialogue: 0,00:16:23.56,00:16:24.40,JPN TOP,,0,0,0,,Иә
Dialogue: 0,00:16:24.48,00:16:26.19,JPN TOP,,0,0,0,,Келесі - тамақ жасау
Dialogue: 0,0:16:25.27,0:16:26.20,Main,,0,0,0,,Оған не болды? Ол жалғыз өзі салқынқанды болып жүр.
Dialogue: 0,00:16:26.27,00:16:27.15,JPN TOP,,0,0,0,,Иә
Dialogue: 0,0:16:28.50,0:16:31.30,Main,,0,0,0,,Түске дейін егістікте жұмыс істе. Осыдан кейін біз дүкенді басқарамыз.
Dialogue: 0,00:16:29.23,00:16:31.99,JPN TOP,,0,0,0,,Түске дейін далада жұмыс істе, түстен кейін дүкенге қара!
Dialogue: 0,0:16:31.30,0:16:31.96,Main,,0,0,0,,Оған не болды? Ол жалғыз өзі салқынқанды болып жүр.
Dialogue: 0,00:16:32.07,00:16:32.90,JPN TOP,,0,0,0,,Иә
Dialogue: 0,0:16:32.69,0:16:35.31,Main,,0,0,0,,Сонымен, Фуши, сен менен үлкенсің...
Dialogue: 0,00:16:33.78,00:16:38.03,JPN TOP,,0,0,0,,Фуши менен үлкен, жасы нешеде?
Dialogue: 0,0:16:35.31,0:16:36.56,Main,,0,0,0,,Жасың нешеде?
Dialogue: 0,0:16:37.00,0:16:38.43,Main,,0,0,0,,Тик-так, сағат тілі тик-так
Dialogue: 0,00:16:38.12,00:16:39.37,JPN TOP,,0,0,0,,Шынында да. Мен оны жеңілдетіп бағаладым. Шынында да жеңілдетіп бағаладым
Dialogue: 0,0:16:39.40,0:16:42.95,Main,,0,0,0,,You don't know anything about yourself, huh?
Dialogue: 0,00:16:40.33,00:16:43.87,JPN TOP,,0,0,0,,Сіз өзіңіз туралы ештеңе білмейсіз.
Dialogue: 0,0:16:43.24,0:16:44.84,Main,,0,0,0,,Сонда ата-анаң ше?
Dialogue: 0,00:16:43.96,00:16:47.33,JPN TOP,,0,0,0,,Сонда ата-аналар ше? Сіз жүзді білесіз бе?
Dialogue: 0,0:16:44.84,0:16:46.41,Main,,0,0,0,,Олардың қандай екенін білесіз бе?
Dialogue: 0,0:16:47.21,0:16:48.56,Main,,0,0,0,,Тик-так, сағат тілі тик-так
Dialogue: 0,00:16:48.25,00:16:51.34,JPN TOP,,0,0,0,,Мен «Эй» Наниді түсінбеймін бе?
Dialogue: 0,0:16:48.56,0:16:50.39,Main,,0,0,0,,p-ата-ана дегеніміз не?
Dialogue: 0,0:16:50.64,0:16:52.94,Main,,0,0,0,,Міне, осыдан бастау керек пе?
Dialogue: 0,00:16:51.84,00:16:53.88,JPN TOP,,0,0,0,,Сол жерден...
Dialogue: 0,0:16:52.94,0:16:57.66,Main,,0,0,0,,Ата-ана - сізді шексіз жақсы көретін және сізге қамқорлық жасайтын адам.
Dialogue: 0,00:16:53.97,00:16:58.60,JPN TOP,,0,0,0,,Ата-ана – сізге шексіз махаббатпен берілген адам.
Dialogue: 0,0:16:58.10,0:16:59.29,Main,,0,0,0,,Ағайындылар ше?
Dialogue: 0,00:16:59.14,00:17:02.06,JPN TOP,,0,0,0,,Бауырларың ше? Сізде бірге өскен адам болды ма?
Dialogue: 0,0:16:59.29,0:17:01.13,Main,,0,0,0,,Сіз біреумен бірге өстіңіз бе?
Dialogue: 0,0:17:01.57,0:17:03.08,Main,,0,0,0,,Тик-так, сағат тілі тик-так
Dialogue: 0,00:17:02.64,00:17:04.02,JPN TOP,,0,0,0,,Шынында да. Мен оны жеңілдетіп бағаладым. Шынында да жеңілдетіп бағаладым
Dialogue: 0,0:17:03.33,0:17:04.97,Main,,0,0,0,,Менде біреу болды.
Dialogue: 0,00:17:04.10,00:17:07.98,JPN TOP,,0,0,0,,Менің салқын ағам бар еді.
Dialogue: 0,0:17:04.97,0:17:06.98,Main,,0,0,0,,Керемет аға.
Dialogue: 0,0:17:06.98,0:17:09.33,Main,,0,0,0,,Ол қазір ақша табуда.
Dialogue: 0,00:17:08.06,00:17:10.27,JPN TOP,,0,0,0,,Мен қазір шетелде жұмыс істеймін.
Dialogue: 0,0:17:09.33,0:17:12.60,Main,,0,0,0,,Ол бір күні үйге бай болып келеді.
Dialogue: 0,00:17:10.36,00:17:13.74,JPN TOP,,0,0,0,,Бір күні бай болып қайтасың.
Dialogue: 0,0:17:13.23,0:17:17.20,Main,,0,0,0,,Менің ойымша, сіз бір жағынан білмегеніңіз үшін бақыттысыз.
Dialogue: 0,00:17:14.32,00:17:18.45,JPN TOP,,0,0,0,,Білмеу бір мағынада бақыт шығар.
Dialogue: 0,0:17:17.49,0:17:19.34,Main,,0,0,0,,Үміт үзбеу керек.
Dialogue: 0,00:17:18.53,00:17:20.28,JPN TOP,,0,0,0,,Үміт үзудің қажеті жоқ
Dialogue: 0,0:17:19.94,0:17:21.85,Main,,0,0,0,,Мен сені қызғанамын.
Dialogue: 0,00:17:20.99,00:17:22.79,JPN TOP,,0,0,0,,Мен сені қызғанамын
Dialogue: 0,0:17:26.89,0:17:30.01,Main,,0,0,0,,Олай болса, енді ол туралы не істейміз?
Dialogue: 0,00:17:27.88,00:17:30.96,JPN TOP,,0,0,0,,Ендеше бұл жігітпен болашақта не істеуіміз керек?
Dialogue: 0,0:17:30.01,0:17:33.79,Main,,0,0,0,,Мен жай сыра қайнатушымын. Саған не айтқанымды қалайсың?
Dialogue: 0,00:17:31.05,00:17:34.72,JPN TOP,,0,0,0,,Менен ішімдік сататын дүкенде сұрасаң да...
Dialogue: 0,0:17:34.20,0:17:37.23,Main,,0,0,0,,Ол тым сирек кездесетін дүние.
Dialogue: 0,00:17:35.22,00:17:39.85,JPN TOP,,0,0,0,,Осындай сирек адам туралы дүние білсе, соғыс болар еді.
Dialogue: 0,0:17:37.23,0:17:38.91,Main,,0,0,0,,Соғыс басталады.
Dialogue: 0,00:17:38.51,00:17:40.51,JPN TOP,,0,0,0,,Дәмді дәмді...
Dialogue: 0,0:17:42.22,0:17:43.65,Main,,0,0,0,,Тик-так, сағат тілі тик-так
Dialogue: 0,00:17:43.27,00:17:44.56,JPN TOP,,0,0,0,,Солай ма?
Dialogue: 0,0:17:43.65,0:17:46.86,Main,,0,0,0,,Тіпті егер бұлай болса да, мен алдымен оны қорғайтын едім.
Dialogue: 0,00:17:44.64,00:17:47.81,JPN TOP,,0,0,0,,Олай болса да, мен сені олай болмай тұрып қорғаймын.
Dialogue: 0,0:17:47.14,0:17:48.09,Main,,0,0,0,,Оның қуыршаққа айналдырған рухтары да керемет екенін естідім.
Dialogue: 0,00:17:47.90,00:17:50.06,JPN TOP,,0,0,0,,Дәмді дәмді
Dialogue: 0,0:17:48.52,0:17:49.13,Main,,0,0,0,,Оның қуыршаққа айналдырған рухтары да керемет екенін естідім.
Dialogue: 0,0:17:49.31,0:17:54.73,Main,,0,0,0,,Оны бізден қомақты ақшаға сатып алатын адамдар көп болуы керек!
Dialogue: 0,00:17:50.15,00:17:52.27,JPN TOP,,0,0,0,,Әрине, бұл жігіт
Dialogue: 0,00:17:52.36,00:17:55.49,JPN TOP,,0,0,0,,Оны қымбат бағаға сатып алғысы келетіндер көп болуы керек.
Dialogue: 0,0:17:54.73,0:17:56.85,Main,,0,0,0,,Тоқта! Фуши сату туралы айтпаңыз!
Dialogue: 0,00:17:55.57,00:17:57.78,JPN TOP,,0,0,0,,Тоқта! Таяқтарды сату
Dialogue: 0,0:17:57.11,0:17:58.58,Main,,0,0,0,,Жүріңдер, асығыңдар, жігіттер
Dialogue: 0,00:17:57.86,00:17:59.45,JPN TOP,,0,0,0,,Түсіндім.
Dialogue: 0,0:17:58.58,0:18:00.92,Main,,0,0,0,,Өлмейтін шарап жасайық!
Dialogue: 0,00:17:59.53,00:18:01.70,JPN TOP,,0,0,0,,Өлмейтіндік үшін жасайық
Dialogue: 0,0:18:00.92,0:18:03.05,Main,,0,0,0,,Мен оның негізін жасау үшін саусақтарын кесіп тастаймын!
Dialogue: 0,00:18:01.78,00:18:03.95,JPN TOP,,0,0,0,,Мына жігіттің саусағын кесіп таста.
Dialogue: 0,0:18:03.05,0:18:04.74,Main,,0,0,0,,Олай айтпа, ішімдік ішкен адам!
Dialogue: 0,00:18:04.04,00:18:06.96,JPN TOP,,0,0,0,,Не айтып тұрсың, Сәке қария? Маған үзіліс беріңіз
Dialogue: 0,0:18:04.74,0:18:06.31,Main,,0,0,0,,Маған үзіліс беріңіз!
Dialogue: 0,00:18:07.04,00:18:08.12,JPN TOP,,0,0,0,,Ахаха…
Dialogue: 0,0:18:07.14,0:18:08.68,Main,,0,0,0,,Неге сонша ренжідің?
Dialogue: 0,00:18:08.21,00:18:12.29,JPN TOP,,0,0,0,,Мияуға ашуландың ба? Сен мені қалжыңдап тұрсың, байсалды бала.
Dialogue: 0,0:18:08.68,0:18:11.37,Main,,0,0,0,,Мен жай ғана қалжыңдап тұрмын. Сен сондай салмақты баласың.
Dialogue: 0,0:18:11.37,0:18:12.45,Main,,0,0,0,,О, жақсы, онда.
Dialogue: 0,00:18:12.38,00:18:17.09,JPN TOP,,0,0,0,,Мен көмектесе алмаймын. Біраз ақша табуды келісемін.
Dialogue: 0,0:18:12.45,0:18:16.21,Main,,0,0,0,,Көшедегі әртіс ретінде оған қосымша ақша табуын сұрайық.
Dialogue: 0,00:18:15.84,00:18:19.26,JPN TOP,,0,0,0,,Хмм...
Dialogue: 0,0:18:16.21,0:18:17.85,Main,,0,0,0,,Шынымен!
Dialogue: 0,00:18:17.17,00:18:19.26,JPN TOP,,0,0,0,,Дұрыс, хехехе...
Dialogue: 0,0:18:18.57,0:18:21.29,Main,,0,0,0,,Екеуің неге сараңсыңдар?!
Dialogue: 0,00:18:19.80,00:18:22.22,JPN TOP,,0,0,0,,Неге екеуің де сараңсыңдар!
Dialogue: 0,0:18:21.29,0:18:24.29,Main,,0,0,0,,Біз Фушиді ақша табу үшін пайдаланбаймыз! Бұл жабайылық!
Dialogue: 0,00:18:22.30,00:18:25.22,JPN TOP,,0,0,0,,Фушиді ақшаға пайдалану айуандық.
Dialogue: 0,0:18:24.50,0:18:25.59,Main,,0,0,0,,Тыңдаңыз!
Dialogue: 0,00:18:25.31,00:18:26.43,JPN TOP,,0,0,0,,Жарайды ма?
Dialogue: 0,0:18:25.59,0:18:28.58,Main,,0,0,0,,Фуши құнды күшке ие.
Dialogue: 0,00:18:26.52,00:18:29.48,JPN TOP,,0,0,0,,Фуши ештеңемен алмастырылмайтын күшке ие.
Dialogue: 0,0:18:28.58,0:18:32.49,Main,,0,0,0,,Біз оны кездестіргенімізге қуанышты болуымыз керек!
Dialogue: 0,00:18:29.56,00:18:33.44,JPN TOP,,0,0,0,,Біз оны кездестіргенімізге шын жүректен риза болуымыз керек!
Dialogue: 0,0:18:32.49,0:18:36.13,Main,,0,0,0,,Мен оның біздің отбасымыздың мүшесі болғанын қалаймын!
Dialogue: 0,00:18:33.52,00:18:37.19,JPN TOP,,0,0,0,,Мен Фушиді отбасыма қарсы алғым келеді!
Dialogue: 0,00:18:37.28,00:18:41.07,JPN TOP,,0,0,0,,Иә? Иә... Фуши ағасы сияқты
Dialogue: 0,0:18:37.41,0:18:38.43,Main,,0,0,0,,Дұрыс.
Dialogue: 0,0:18:38.43,0:18:40.17,Main,,0,0,0,,Ол ағасы сияқты.
Dialogue: 0,0:18:40.17,0:18:41.82,Main,,0,0,0,,Сіздің ағаңыз?
Dialogue: 0,00:18:41.16,00:18:42.74,JPN TOP,,0,0,0,,Бұл сенің ағаң ба?
Dialogue: 0,0:18:41.82,0:18:43.51,Main,,0,0,0,,інім!
Dialogue: 0,00:18:42.83,00:18:44.45,JPN TOP,,0,0,0,,Бұл менің ағам!
Dialogue: 0,0:18:43.78,0:18:46.03,Main,,0,0,0,,Юм. Юм.
Dialogue: 0,00:18:44.95,00:18:47.20,JPN TOP,,0,0,0,,Дәмді дәмді...
Dialogue: 0,0:18:47.55,0:18:52.64,Main,,0,0,0,,Эй, сен он жылдан кейін не істеймін деп ойлайсың?
Dialogue: 0,00:18:48.66,00:18:49.58,JPN TOP,,0,0,0,,Эй
Dialogue: 0,00:18:50.08,00:18:53.59,JPN TOP,,0,0,0,,10 жылдан кейін қайда боламын деп ойлайсың?
Dialogue: 0,0:18:53.06,0:18:55.15,Main,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,00:18:54.17,00:18:56.09,JPN TOP,,0,0,0,,Мен білмеймін
Dialogue: 0,0:18:55.42,0:18:59.80,Main,,0,0,0,,Мен әлі де қазіргідей өмір сүретін боламын деп ойлаймын.
Dialogue: 0,00:18:56.59,00:18:58.05,JPN TOP,,0,0,0,,Мен әрқашан қазіргідей болдым ...
Dialogue: 0,00:18:58.13,00:19:00.80,JPN TOP,,0,0,0,,Менің ойымша, ол сонда тұрады.
Dialogue: 0,0:18:59.80,0:19:02.77,Main,,0,0,0,,Тазалау, тамақ әзірлеу, жұмыс...
Dialogue: 0,00:19:00.88,00:19:03.72,JPN TOP,,0,0,0,,Тазалау, тамақ әзірлеу, жұмыс…
Dialogue: 0,0:19:02.77,0:19:04.45,Main,,0,0,0,,Қызық өмір.
Dialogue: 0,00:19:03.80,00:19:05.39,JPN TOP,,0,0,0,,Күнделікті қызықсыз
Dialogue: 0,0:19:04.81,0:19:07.26,Main,,0,0,0,,Мен осылай болғанға дейін,
Dialogue: 0,00:19:05.89,00:19:09.60,JPN TOP,,0,0,0,,Осы жағдайға дейін мен үлкен сарайда тұрдым.
Dialogue: 0,0:19:07.26,0:19:12.55,Main,,0,0,0,,Мен үлкен сарайда тұрып, күнде қарын жеуді армандайтынмын.
Dialogue: 0,00:19:09.69,00:19:13.56,JPN TOP,,0,0,0,,Мен күнде күріш тауында өмір сүруді армандадым.
Dialogue: 0,0:19:12.98,0:19:15.22,Main,,0,0,0,,Сол арман орындалды.
Dialogue: 0,00:19:14.06,00:19:16.15,JPN TOP,,0,0,0,,Енді сол арман орындалды
Dialogue: 0,0:19:16.09,0:19:19.36,Main,,0,0,0,,Бірақ бұл қымбатқа түсті.
Dialogue: 0,00:19:17.19,00:19:20.40,JPN TOP,,0,0,0,,Бірақ оның бағасы болды.
Dialogue: 0,0:19:19.88,0:19:24.82,Main,,0,0,0,,Менің үлкен ағам болған және өзіме ұнайтын қызбен сөйлескен өмірім...
Dialogue: 0,00:19:20.95,00:19:25.91,JPN TOP,,0,0,0,,Менің үлкен ағам бар, мен өзім ұнататын қызбен сөйлесемін...
Dialogue: 0,0:19:25.41,0:19:28.92,Main,,0,0,0,,Менің жеке өмірім... ешқашан қайтып келмейді.
Dialogue: 0,00:19:26.45,00:19:28.33,JPN TOP,,0,0,0,,Менің жалғыз өмірім
Dialogue: 0,00:19:28.41,00:19:31.50,JPN TOP,,0,0,0,,Мен қайтып оралмаймын, енді ешқашан...
Dialogue: 0,0:19:29.24,0:19:30.26,Main,,0,0,0,,Ешқашан емес.
Dialogue: 0,0:19:31.04,0:19:34.24,Main,,0,0,0,,Менің болашағым тасқа басылды.
Dialogue: 0,00:19:32.12,00:19:35.17,JPN TOP,,0,0,0,,Бұл абсолютті белгілі болашақ.
Dialogue: 0,0:19:34.78,0:19:37.92,Main,,0,0,0,,Бұл мені өте аянышты етеді.
Dialogue: 0,00:19:35.88,00:19:39.17,JPN TOP,,0,0,0,,Бұл мен үшін өте ауыр.
Dialogue: 0,0:19:36.71,0:19:37.75,Main - Top,,0,0,0,,Оның қуыршаққа айналдырған рухтары да керемет екенін естідім.
Dialogue: 0,00:19:37.96,00:19:39.17,JPN TOP,,0,0,0,,Дәмді
Dialogue: 0,0:19:38.53,0:19:44.50,Main,,0,0,0,,Бірақ сіздің осында болғаныңыздың арқасында мен бұл қызықсыз өмірге төзе аламын деп ойлаймын.
Dialogue: 0,00:19:39.67,00:19:42.26,JPN TOP,,0,0,0,,Бірақ келгеніңіз үшін Фушиге рахмет.
Dialogue: 0,00:19:42.34,00:19:45.72,JPN TOP,,0,0,0,,Мен бұл қызықсыз күнделікті өмірді жеңе алатын сияқтымын.
Dialogue: 0,0:19:46.97,0:19:48.02,Main,,0,0,0,,Сонымен, бәрібір...
Dialogue: 0,0:19:48.02,0:19:53.84,Main,,0,0,0,,Егер сіз ішімдікке айналсаңыз, ішімдіктің дәмі жақсы деп ойлайсыз ба?
Dialogue: 0,00:19:48.06,00:19:52.06,JPN TOP,,0,0,0,,Сонымен, мысалы, саке қарт болып өзгерсеңіз.
Dialogue: 0,00:19:52.14,00:19:54.81,JPN TOP,,0,0,0,,Алкогольді дәмді деп санайсыз ба?
Dialogue: 0,0:19:53.84,0:19:55.53,Main,,0,0,0,,Тик-так, сағат тілі тик-так
Dialogue: 0,00:19:54.90,00:19:56.48,JPN TOP,,0,0,0,,Шынында да. Мен оны жеңілдетіп бағаладым. Шынында да жеңілдетіп бағаладым
Dialogue: 0,0:19:55.53,0:19:57.84,Main,,0,0,0,,Байқап көріңіз, адам.
Dialogue: 0,00:19:56.57,00:19:58.69,JPN TOP,,0,0,0,,Тек байқап көріңіз.
Dialogue: 0,0:19:57.84,0:19:59.12,Main,,0,0,0,,Қалай?
Dialogue: 0,00:19:58.78,00:20:00.07,JPN TOP,,0,0,0,,Бұл тек бұршақ мылтық, бірақ… Марли әскерінің қарсы шабуылының сигналы
Dialogue: 0,0:19:59.98,0:20:01.40,Main,,0,0,0,,Мен бір қолымда оқпен жүктелген винтовка ұстап тұрмын
Dialogue: 0,00:20:01.07,00:20:02.40,JPN TOP,,0,0,0,,Қиындық тудырғаным үшін кешір.
Dialogue: 0,0:20:01.86,0:20:04.00,Main,,0,0,0,,Иә?! Қош келдіңіз!
Dialogue: 0,00:20:02.91,00:20:04.95,JPN TOP,,0,0,0,,А... иә, қош келдіңіз!
Dialogue: 0,0:20:08.18,0:20:10.73,Main,,0,0,0,,Кім-Бүгін сені мұнда не әкелді?
Dialogue: 0,00:20:09.24,00:20:11.71,JPN TOP,,0,0,0,,Кио... Бүгін саған не керек?
Dialogue: 0,0:20:11.38,0:20:12.78,Main,,0,0,0,,Бұл сыра зауыты, сіз білесіз.
Dialogue: 0,00:20:11.79,00:20:13.71,JPN TOP,,0,0,0,,Мм... бұл ішімдік сататын дүкен...
Dialogue: 0,0:20:13.33,0:20:14.05,Main,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,00:20:13.79,00:20:16.42,JPN TOP,,0,0,0,,Ах... у...
Dialogue: 0,0:20:14.28,0:20:18.09,Main,,0,0,0,,Мм... Мен мұнда ішімдік немесе басқа нәрсе жеу үшін келген жоқпын!
Dialogue: 0,00:20:16.50,00:20:19.05,JPN TOP,,0,0,0,,Мен ішімдік ішкім келмейді!
Dialogue: 0,0:20:18.09,0:20:20.24,Main,,0,0,0,,Мен сау нәрсе іздеймін!
Dialogue: 0,00:20:19.13,00:20:21.17,JPN TOP,,0,0,0,,Денеңізге пайдалы нәрсе іздеу
Dialogue: 0,0:20:20.47,0:20:24.20,Main,,0,0,0,,W-Бізде қосымша сусындар бар, бірақ...
Dialogue: 0,00:20:21.26,00:20:25.18,JPN TOP,,0,0,0,,Жақсы... қоректік заттарды арттыратын емдік ликерлер бар...
Dialogue: 0,0:20:24.20,0:20:25.51,Main,,0,0,0,,О, мен білемін!
Dialogue: 0,00:20:25.26,00:20:26.47,JPN TOP,,0,0,0,,Иә!
Dialogue: 0,0:20:25.51,0:20:29.07,Main,,0,0,0,,Саған біздің алкогольсіз тәтті тұздалған қиярларымызды әкелейін бе?
Dialogue: 0,00:20:26.55,00:20:29.85,JPN TOP,,0,0,0,,Құрамында спирті жоқ тәтті тұздалған қиярлар дайындағанымды қалайсыз ба?
Dialogue: 0,0:20:29.07,0:20:31.62,Main,,0,0,0,,Олар сумен және цитруспен кесілгенде дәмді болады.
Dialogue: 0,00:20:29.93,00:20:32.56,JPN TOP,,0,0,0,,Су мен цитрус қосылғанда дәмді болады.
Dialogue: 0,0:20:32.19,0:20:33.55,Main,,0,0,0,,Бұл керемет естіледі!
Dialogue: 0,00:20:32.64,00:20:34.44,JPN TOP,,0,0,0,,Сонымен... жақсы!
Dialogue: 0,0:20:33.55,0:20:35.38,Main,,0,0,0,,Бұл менің жарамды емдей ме?
Dialogue: 0,00:20:34.52,00:20:36.31,JPN TOP,,0,0,0,,Бұл жараны емдей ме?
Dialogue: 0,0:20:35.66,0:20:36.74,Main,,0,0,0,,Сіздің жараңыз?
Dialogue: 0,00:20:36.40,00:20:37.69,JPN TOP,,0,0,0,,Жара?
Dialogue: 0,0:20:37.60,0:20:41.70,Main,,0,0,0,,Менің үш ай бұрынғы жарам әлі жазылмады.
Dialogue: 0,00:20:38.65,00:20:42.65,JPN TOP,,0,0,0,,Үш ай бұрын алған жарам әлі жазылмаған...
Dialogue: 0,0:20:41.91,0:20:45.73,Main,,0,0,0,,Бұл өте үлкен, ұят жара, сондықтан мен оны жасыруым керек.
Dialogue: 0,00:20:42.74,00:20:46.87,JPN TOP,,0,0,0,,Бұл шынымен де үлкен тыртық, мен ұялып тұрмын, сондықтан оны жасырудан басқа амалым жоқ.
Dialogue: 0,0:20:46.43,0:20:48.51,Main,,0,0,0,,L-Ол жараны түзетейік!
Dialogue: 0,00:20:47.49,00:20:50.08,JPN TOP,,0,0,0,,Сол жараны айықтырайық!
Dialogue: 0,0:20:48.51,0:20:49.14,Main,,0,0,0,,Әрине!
Dialogue: 0,0:20:49.69,0:20:50.64,Main,,0,0,0,,Ә... ә... білесің бе...
Dialogue: 0,0:20:50.64,0:20:52.65,Italics,,0,0,0,,S- Өте сүйкімді!
Dialogue: 0,00:20:50.74,00:20:51.58,JPN TOP,,0,0,0,,Иә!
Dialogue: 0,00:20:51.66,00:20:54.00,JPN TOP,,0,0,0,,Сонымен... өте сүйкімді!
Dialogue: 0,0:20:53.00,0:20:55.78,Main,,0,0,0,,Мынаның осындай мейірімді дүкен болғанына қуаныштымын.
Dialogue: 0,00:20:54.08,00:20:56.71,JPN TOP,,0,0,0,,Дүкен өте мейірімді және мен өзімді еркін сезіндім.
Dialogue: 0,0:20:55.78,0:20:58.72,Main,,0,0,0,,Мен бұл жер өте қорқынышты деп ойладым.
Dialogue: 0,00:20:56.79,00:20:59.67,JPN TOP,,0,0,0,,Мен бұл жер өте қорқынышты деп ойладым.
Dialogue: 0,0:20:59.09,0:21:02.85,Main,,0,0,0,,Айтайын дегенім, сенің басың не болды?
Dialogue: 0,00:21:00.17,00:21:03.80,JPN TOP,,0,0,0,,Өйткені әлгі бас киім... бұл не?
Dialogue: 0,00:21:03.88,00:21:04.93,JPN TOP,,0,0,0,,Уф...
Dialogue: 0,0:21:05.13,0:21:06.56,Main,,0,0,0,,Ұсқынсыз.
Dialogue: 0,0:21:05.55,0:21:08.00,Main,,0,0,0,,Бұл тұтынушыларды тартуға арналған!
Dialogue: 0,00:21:05.88,00:21:08.80,JPN TOP,,0,0,0,,Шіркін... (жұт) О, жоқ, бұл таңқаларлық.
Dialogue: 0,0:21:08.00,0:21:10.15,Main,,0,0,0,,Адамдар мұны жақсы көреді!
Dialogue: 0,00:21:08.89,00:21:10.76,JPN TOP,,0,0,0,,Бұл жігіттің беделі жақсы.
Dialogue: 0,0:21:10.15,0:21:11.79,Main,,0,0,0,,Өтірік, жеккөру, құлдырау—әр күнді лақтыру
Dialogue: 0,00:21:11.27,00:21:13.73,JPN TOP,,0,0,0,,Солай ма? Уху...
Dialogue: 0,0:21:14.58,0:21:16.80,Italics,,0,0,0,,Көмектесіңіз! Мен дәл қазір сондай бақыттымын!
Dialogue: 0,00:21:15.56,00:21:17.77,JPN TOP,,0,0,0,,Ақылсыз, мен бақыттымын!
Dialogue: 0,0:21:16.80,0:21:18.11,Italics,,0,0,0,,Жоқ, абай болыңыз.
Dialogue: 0,00:21:17.85,00:21:21.11,JPN TOP,,0,0,0,,Жоқ, абай болыңыз. Өзіңді ұмыту қауіпті.
Dialogue: 0,0:21:18.11,0:21:20.16,Italics,,0,0,0,,Менің орнымды білу үшін абай болу керек.
Dialogue: 0,0:21:20.39,0:21:23.71,Main,,0,0,0,,Әй, балалар, сендер мұндағы отбасы емессіңдер ғой?
Dialogue: 0,00:21:21.19,00:21:24.65,JPN TOP,,0,0,0,,Әй, сен мұнда бала емессің ғой?
Dialogue: 0,0:21:24.02,0:21:26.17,Main,,0,0,0,,Жоқ. Біз тек осында жұмыс істейміз.
Dialogue: 0,00:21:25.15,00:21:27.11,JPN TOP,,0,0,0,,Иә, мен осында жұмыс істеймін!
Dialogue: 0,0:21:26.43,0:21:29.96,Main,,0,0,0,,О! Сонда мен кірген сайын осында боласың ба?
Dialogue: 0,00:21:27.20,00:21:30.83,JPN TOP,,0,0,0,,Иә! Сондықтан мұнда келсеңіз, сіз әрқашан сонда боласыз.
Dialogue: 0,0:21:29.96,0:21:30.66,Main,,0,0,0,,Әрине!
Dialogue: 0,0:21:30.66,0:21:33.39,Main,,0,0,0,,Таңертең егістікте жұмыс істейміз, түстен кейін осындамыз.
Dialogue: 0,00:21:30.91,00:21:34.33,JPN TOP,,0,0,0,,Иә! Таңертең далада, түстен кейін осы дүкенде боламын!
Dialogue: 0,0:21:34.18,0:21:37.56,Main,,0,0,0,,Атыңызды сұрасам бола ма?
Dialogue: 0,00:21:35.21,00:21:38.83,JPN TOP,,0,0,0,,Аты... Сұрауға бола ма?
Dialogue: 0,00:21:38.92,00:21:43.26,JPN TOP,,0,0,0,,Цу…бо…Мен оны гу гу деп атаймын.
Dialogue: 0,0:21:39.42,0:21:40.50,Main,,0,0,0,,Мен...
Dialogue: 0,0:21:40.50,0:21:42.33,Main,,0,0,0,,Менің атым Дж-Гугу.
Dialogue: 0,0:21:42.33,0:21:44.01,Main,,0,0,0,,Сіз емес.
Dialogue: 0,00:21:43.34,00:21:46.47,JPN TOP,,0,0,0,,Жоқ, мен бұл кісіден сұрадым.
Dialogue: 0,0:21:44.01,0:21:45.54,Main,,0,0,0,,Мен одан сұрадым.
Dialogue: 0,0:21:47.46,0:21:48.69,Main,,0,0,0,,Бұл Фуши.
Dialogue: 0,00:21:48.55,00:21:49.64,JPN TOP,,0,0,0,,Фушиджа
Dialogue: 0,00:21:49.72,00:21:52.81,JPN TOP,,0,0,0,,Уау, менің атым Фуши-сан.
Dialogue: 0,0:21:49.92,0:21:51.87,Main,,0,0,0,,Фуши-сан, иә?
Dialogue: 0,0:21:51.87,0:21:53.39,Main,,0,0,0,,Бұл әдемі есім.
Dialogue: 0,00:21:52.89,00:21:56.31,JPN TOP,,0,0,0,,Өте жақсы көрінеді. Қай жыл? Сен қай жақтансын?
Dialogue: 0,0:21:53.39,0:21:55.44,Main,,0,0,0,,Жасың нешеде? Сен қай жақтансын?
Dialogue: 0,0:21:55.44,0:21:56.92,Main,,0,0,0,,Сіз не жегенді ұнатасыз?
Dialogue: 0,00:21:56.39,00:21:57.85,JPN TOP,,0,0,0,,Сіздің сүйікті тағамыңыз қандай?
Dialogue: 0,0:21:56.92,0:22:00.23,Main,,0,0,0,,Оған менің жасаған барлық нәрселерім ұнайды.
Dialogue: 0,00:21:57.94,00:22:01.15,JPN TOP,,0,0,0,,Маған кез келген тағам ұнайды.
Dialogue: 0,0:22:00.23,0:22:01.80,Main,,0,0,0,,Жемістер.
Dialogue: 0,00:22:01.23,00:22:02.69,JPN TOP,,0,0,0,,Кудамоно
Dialogue: 0,0:22:01.80,0:22:04.23,Main,,0,0,0,,Шынымен бе?! Мен де!
Dialogue: 0,00:22:02.77,00:22:05.57,JPN TOP,,0,0,0,,Солай ма? мен де!
Dialogue: 0,0:22:03.24,0:22:04.22,Main,,0,0,0,,Сәлем, Фуши!
Dialogue: 0,0:22:04.22,0:22:05.58,Main,,0,0,0,,Біз жұмыстың ортасындамыз!
Dialogue: 0,00:22:04.36,00:22:06.90,JPN TOP,,0,0,0,,Эй, Фуши, мен жұмыстамын.
Dialogue: 0,0:22:04.54,0:22:06.62,Main,,0,0,0,,Мені Реан деп атаңыз.
Dialogue: 0,00:22:05.65,00:22:07.90,JPN TOP,,0,0,0,,Эй, Лин деп айт.
Dialogue: 0,0:22:06.95,0:22:08.22,Main,,0,0,0,,Реан.
Dialogue: 0,00:22:07.99,00:22:08.91,JPN TOP,,0,0,0,,Арық
Dialogue: 0,0:22:08.58,0:22:09.85,Main,,0,0,0,,Сіз кереметсіз!
Dialogue: 0,00:22:08.99,00:22:10.78,JPN TOP,,0,0,0,,Ах! тамаша!
Dialogue: 0,0:22:10.17,0:22:11.25,Main,,0,0,0,,Реан.
Dialogue: 0,0:22:10.51,0:22:12.51,Main,,0,0,0,,О, сен!
Dialogue: 0,00:22:10.87,00:22:13.74,JPN TOP,,0,0,0,,Арық... (Арық) О, жоқ...
Dialogue: 0,0:22:11.53,0:22:12.79,Main,,0,0,0,,Реан.
Dialogue: 0,0:22:12.81,0:22:13.95,Main,,0,0,0,,Рейки.
Dialogue: 0,00:22:13.83,00:22:17.04,JPN TOP,,0,0,0,,Жарайды, жарайды, қартқа көмектесетін кез келді.
Dialogue: 0,0:22:13.95,0:22:16.18,Main,,0,0,0,,Қартқа көмектесіңіз немесе бір нәрсеге барыңыз.
Dialogue: 0,0:22:16.18,0:22:17.82,Main,,0,0,0,,Сіз басқа тұтынушылардың назарын аударасыз.
Dialogue: 0,00:22:17.12,00:22:18.75,JPN TOP,,0,0,0,,Өйткені ол басқа тұтынушыларды алаңдатады.
Dialogue: 0,0:22:18.28,0:22:19.15,Main,,0,0,0,,(Тик-так, сағаттың көрсеткіштері тик-так)
Dialogue: 0,0:22:19.15,0:22:22.04,Main,,0,0,0,,Олай болса, мен Фуси-санмен серуендегім келеді.
Dialogue: 0,00:22:19.25,00:22:22.92,JPN TOP,,0,0,0,,Жоқ... Ондай жағдайда мен Фуси-санмен серуендеуге барғым келеді.
Dialogue: 0,0:22:22.04,0:22:24.90,Main,,0,0,0,,Сонда біз басқа клиенттерді алаңдатпаймыз, солай ма, Шопбой мырза?
Dialogue: 0,00:22:23.00,00:22:25.84,JPN TOP,,0,0,0,,Сонда сіз мазасыз болмайсыз, солай ма, хатшы?
Dialogue: 0,0:22:25.77,0:22:26.78,Main,,0,0,0,,(Тик-так, сағаттың көрсеткіштері тик-так)
Dialogue: 0,0:22:26.78,0:22:30.37,Main,,0,0,0,,Тыңдаңыз! Көмексіз киімін де шеше алмайды!
Dialogue: 0,00:22:26.97,00:22:28.51,JPN TOP,,0,0,0,,Жоқ, жарай ма?
Dialogue: 0,00:22:28.59,00:22:31.30,JPN TOP,,0,0,0,,Өзі киімін де шеше алмайтын жігіт.
Dialogue: 0,0:22:30.37,0:22:33.00,Main,,0,0,0,,Ол тіпті әрең сөйлейді. Ол сәби сияқты!
Dialogue: 0,00:22:31.39,00:22:33.93,JPN TOP,,0,0,0,,Сөздің өзі сәбидей шатастырады.
Dialogue: 0,0:22:33.00,0:22:35.45,Main,,0,0,0,,Оған білім керек.
Dialogue: 0,00:22:34.01,00:22:36.35,JPN TOP,,0,0,0,,Сондықтан бізге білім керек.
Dialogue: 0,0:22:35.45,0:22:37.49,Main,,0,0,0,,Оның ойнауға уақыты жоқ!
Dialogue: 0,00:22:36.43,00:22:38.44,JPN TOP,,0,0,0,,Ойынға уақыт жоқ!
Dialogue: 0,0:22:37.79,0:22:41.38,Main,,0,0,0,,Мен оған сөйлеуді үйрете аламын...
Dialogue: 0,00:22:38.98,00:22:42.15,JPN TOP,,0,0,0,,Мен сендерге сөздерді үйрете алар едім.
Dialogue: 0,0:22:41.38,0:22:43.85,Main,,0,0,0,,және оның киімін шешу жолы.
Dialogue: 0,00:22:42.23,00:22:46.19,JPN TOP,,0,0,0,,Әрине, киіміңді қалай шешсең... не болса да.
Dialogue: 0,0:22:43.85,0:22:45.25,Main,,0,0,0,,Әзіл!
Dialogue: 0,00:22:49.24,00:22:51.66,JPN TOP,,0,0,0,,Сонымен, осы екі адамның қайсысы Стэнді қолданады?
Dialogue: 0,00:22:51.74,00:22:54.66,JPN TOP,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:22:53.71,0:22:57.23,Main,,0,0,0,,Адам тек арақ үшін өмір сүрмейді.
Dialogue: 0,00:22:54.74,00:22:58.16,JPN TOP,,0,0,0,,Адамдар тек ішумен өмір сүрмейді.
Dialogue: 0,00:22:58.96,00:22:59.96,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:22:59.63,0:23:03.95,Main,,0,0,0,,Ішімдік адамның өзін жақсы сезініп, көңілін көтеруі мүмкін.
Dialogue: 0,00:23:00.46,00:23:04.88,JPN TOP,,0,0,0,,Алкогольді ішу адамдарды жақсы сезініп, көңілді етеді, бірақ
Dialogue: 0,0:23:03.95,0:23:07.92,Main,,0,0,0,,Бірақ бұл сізді тәрбиелейтін барлық нәрсе емес.
Dialogue: 0,00:23:04.96,00:23:08.80,JPN TOP,,0,0,0,,Бұл сізді тамақтандыратын жалғыз нәрсе емес
Dialogue: 0,0:23:07.92,0:23:11.07,Main,,0,0,0,,Сіз не туралы айтып отырсыз? Мен арақ ішпеймін!
Dialogue: 0,00:23:08.88,00:23:12.01,JPN TOP,,0,0,0,,Сіз не туралы айтып отырсыз? Мен ішімдік ішпеймін!
Dialogue: 0,0:23:11.30,0:23:14.46,Main,,0,0,0,,Сіз соншалықты көңілсіз өткізетін уақыт - бұл жақсы өткізілген уақыт.
Dialogue: 0,00:23:12.09,00:23:15.39,JPN TOP,,0,0,0,,Қашаннан бері осылай күйзеліп жүрсің?
Dialogue: 0,0:23:14.69,0:23:20.29,Main,,0,0,0,,Бұл сізді әлдеқайда мәдениетті адам етеді.
Dialogue: 0,00:23:15.47,00:23:18.60,JPN TOP,,0,0,0,,Бұл сізді тұлға ретінде қызықтырақ етеді.
Dialogue: 0,00:23:18.68,00:23:21.10,JPN TOP,,0,0,0,,Маған маңызды уақыт екенін айтыңыз
Dialogue: 0,00:23:21.19,00:23:22.02,JPN TOP,,0,0,0,,Ha
Dialogue: 0,0:23:21.49,0:23:26.71,Main,,0,0,0,,Жүректің ауырғанын құшақтап, жақсы адам бол, Гугу!
Dialogue: 0,00:23:22.56,00:23:25.90,JPN TOP,,0,0,0,,Қалағаныңызша уайымдап, жақсы адам болыңыз
Dialogue: 0,00:23:25.98,00:23:27.86,JPN TOP,,0,0,0,,Гу Гу
Dialogue: 0,00:23:30.07,00:23:33.41,JPN TOP,,0,0,0,,(Гу-Гудың ауыр тыныс алуы)
Dialogue: 0,00:23:35.74,00:23:38.41,JPN TOP,,0,0,0,,Олар ештеңе білмейміз дейді.
Dialogue: 0,00:23:38.50,00:23:40.66,JPN TOP,,0,0,0,,Хмм... уф...
Dialogue: 0,00:23:40.75,00:23:42.58,JPN TOP,,0,0,0,,Гу… Гу…
Dialogue: 0,00:23:42.67,00:23:43.67,JPN TOP,,0,0,0,,Фу
Dialogue: 0,00:23:44.17,00:23:45.46,JPN TOP,,0,0,0,,Қара, тегі бірдей. Сен іздедің ғой, иә?
Dialogue: 0,0:23:44.61,0:23:46.68,Main,,0,0,0,,Мұның бәрі тек менің алаңдаған жүрегімді жылдамдатты
Dialogue: 0,00:23:45.54,00:23:47.88,JPN TOP,,0,0,0,,Нани жасайсың ба?
Dialogue: 0,0:23:47.10,0:23:48.50,Main,,0,0,0,,Мен жаттығудамын.
Dialogue: 0,00:23:47.96,00:23:49.42,JPN TOP,,0,0,0,,Тренинг
Dialogue: 0,0:23:49.20,0:23:51.59,Main,,0,0,0,,Мен өзіме қызықтыратын нәрсе беремін.
Dialogue: 0,00:23:50.34,00:23:52.93,JPN TOP,,0,0,0,,Менің белгімді қою
Dialogue: 0,0:23:52.14,0:23:54.15,Main,,0,0,0,,Мен де.
Dialogue: 0,00:23:53.01,00:23:54.93,JPN TOP,,0,0,0,,Мен де жасаймын
Dialogue: 0,0:23:54.15,0:23:56.09,Main,,0,0,0,,Мұны істеудің қажеті жоқ!
Dialogue: 0,00:23:55.01,00:23:56.76,JPN TOP,,0,0,0,,Мұны істеудің қажеті жоқ.
Dialogue: 0,0:23:56.09,0:23:56.74,Main,,0,0,0,,Түсіңіз!
Dialogue: 0,00:23:56.85,00:23:57.68,JPN TOP,,0,0,0,,Түсіңіз!
Dialogue: 0,0:23:57.21,0:24:00.59,Main,,0,0,0,,Ішке қайта кіріп, ұйықтап ал.
Dialogue: 0,00:23:58.31,00:24:01.77,JPN TOP,,0,0,0,,Бөлмеңде ұйықтау керек.
Dialogue: 0,00:24:02.94,00:24:04.69,JPN TOP,,0,0,0,,Хмм...
Dialogue: 0,0:24:06.53,0:24:08.63,Main,,0,0,0,,Гугуға не кіреді?
Dialogue: 0,00:24:07.57,00:24:09.57,JPN TOP,,0,0,0,,Мынау не болды...
Dialogue: 0,0:24:08.63,0:24:10.69,Main,,0,0,0,,Оған қара!
Dialogue: 0,00:24:09.65,00:24:13.07,JPN TOP,,0,0,0,,Ақырында, адам деген осы
Dialogue: 0,0:24:10.69,0:24:12.13,Main,,0,0,0,,Бұл жақсы адам.
Dialogue: 0,0:24:12.63,0:24:15.18,Main,,0,0,0,,Мықты бол, балақай.
Dialogue: 0,00:24:13.74,00:24:16.07,JPN TOP,,0,0,0,,Хмм, сен күшті боласың.
Dialogue: 0,00:24:16.16,00:24:19.70,JPN TOP,,0,0,0,,Фофофофо…
Dialogue: 0,00:24:19.79,00:24:21.45,JPN TOP,,0,0,0,,Хаха...
Dialogue: 0,00:24:21.54,00:24:23.92,JPN TOP,,0,0,0,,(Фуси мен Саке қарттың күлкісі)
Dialogue: 0,00:24:24.00,00:24:25.96,JPN TOP,,0,0,0,,Хм
Dialogue: 0,00:24:27.63,00:24:30.92,JPN TOP,,0,0,0,,А... уф...
Dialogue: 0,0:24:29.98,0:24:51.01,sign_35245_236_Preview,,0,0,0,,Алдын ала қарау
Dialogue: 0,0:24:31.80,0:24:34.89,Narration,,0,0,0,,Олар Такунахада бейбіт өмір сүріп жатқандықтан,
Dialogue: 0,00:24:32.88,00:24:36.01,JPN TOP,,0,0,0,,Такнахадағы тыныш күнделікті өмір
Dialogue: 0,0:24:35.48,0:24:41.13,Narration,,0,0,0,,Гугу мен Фуши бірте-бірте бір-бірін жақсы түсінеді.
Dialogue: 0,00:24:36.51,00:24:42.06,JPN TOP,,0,0,0,,Гу Гу мен Фуши бірте-бірте бір-бірін түсінеді.
Dialogue: 0,0:24:41.47,0:24:47.59,Narration,,0,0,0,,Бірақ Гугу өзінің денесінде жасырылған құпияны ашады.
Dialogue: 0,00:24:42.14,00:24:43.77,JPN TOP,,0,0,0,,дәл қазір менің алдымда тұр!
Dialogue: 0,00:24:43.85,00:24:48.77,JPN TOP,,0,0,0,,Гу Гу өз денесінде жасырылған құпияны түсінеді
Dialogue: 0,0:24:48.33,0:24:53.77,Narration,,0,0,0,,Үмітсіз күйде, жалғыз өзі тағдырымен бетпе-бет келеді.
Dialogue: 0,00:24:49.44,00:24:54.95,JPN TOP,,0,0,0,,Жалғыз, үмітсіз, тағдырыммен бетпе-бет
Dialogue: 0,0:24:51.01,0:24:55.01,Episode_Title,,0,0,0,,Құбыжық ағайындылар
Dialogue: 0,0:24:56.51,0:25:02.51,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory