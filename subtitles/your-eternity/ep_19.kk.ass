Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.68,0:00:07.36,Narration,,0,0,0,,Фуши мен Тонари Джананда аралынан қашпақ болған кезде,
Dialogue: 0,00:00:02.75,00:00:04.46,JPN TOP,,0,0,0,,Фуши мен Тонари
Dialogue: 0,00:00:04.54,00:00:08.17,JPN TOP,,0,0,0,,Джананда аралынан қашуға тырысқанда
Dialogue: 0,0:00:07.78,0:00:11.48,Narration,,0,0,0,,Аралға тағы Ноккерлер келді.
Dialogue: 0,00:00:08.84,00:00:12.42,JPN TOP,,0,0,0,,Аралда жаңа тықылдағыш пайда болды.
Dialogue: 0,0:00:13.75,0:00:20.20,Narration,,0,0,0,,Ноккерлер өлгендердің денелерін басып алып, ордаларға шабуыл жасады.
Dialogue: 0,00:00:14.80,00:00:17.55,JPN TOP,,0,0,0,,Нокер өлгендердің денесін қарызға алады
Dialogue: 0,00:00:18.35,00:00:21.35,JPN TOP,,0,0,0,,Топ-топ болып шабуылға ұшырады
Dialogue: 0,0:00:22.24,0:00:28.05,Narration,,0,0,0,,Фуши арал тұрғындарын қорғау үшін Тонари және оның достарымен бірге шайқасты.
Dialogue: 0,00:00:23.27,00:00:29.23,JPN TOP,,0,0,0,,Арал тұрғындарын қорғау үшін Фуши Тонари және оның достарымен бірге шайқасты.
Dialogue: 0,0:00:29.12,0:00:35.89,Narration,,0,0,0,,Бірақ Оопа, Миа және Урой бірінен соң бірі жеңілді.
Dialogue: 0,00:00:30.15,00:00:36.82,JPN TOP,,0,0,0,,Бірақ Woopa Mia Wooroi бірінен соң бірі құлады.
Dialogue: 0,0:00:37.68,0:00:40.40,Narration,,0,0,0,,Фуши шайқасы,
Dialogue: 0,00:00:38.66,00:00:41.33,JPN TOP,,0,0,0,,Сізге таңданатын адамдармен
Dialogue: 0,0:00:40.40,0:00:44.99,Narration,,0,0,0,,Кімді қорғау керек екенін түсінген және оны құрметтейтіндер,
Dialogue: 0,00:00:41.41,00:00:46.00,JPN TOP,,0,0,0,,Фуши шайқасы, мен қорғайтын достарым бар екенін білдім.
Dialogue: 0,0:00:45.47,0:00:47.29,Narration,,0,0,0,,жалғасы.
Dialogue: 0,00:00:46.50,00:00:48.42,JPN TOP,,0,0,0,,Жалғасы
Dialogue: 0,00:00:50.05,00:00:55.34,JPN TOP,,0,0,0,,♪~
Dialogue: 0,00:02:14.92,00:02:19.93,JPN TOP,,0,0,0,,~♪
Dialogue: 0,0:02:24.24,0:02:26.31,Main,,0,0,0,,Сіз қазір шыға аласыз.
Dialogue: 0,00:02:25.31,00:02:27.35,JPN TOP,,0,0,0,,Сіз шыға аласыз.
Dialogue: 0,0:02:26.31,0:02:28.37,Main,,0,0,0,,Мен бұл аймақты тазаладым.
Dialogue: 0,00:02:27.43,00:02:29.31,JPN TOP,,0,0,0,,Мен бұл жерді тазаладым.
Dialogue: 0,00:02:31.31,00:02:34.94,JPN TOP,,0,0,0,,Әй... Рахмет, Хаясе-сан.
Dialogue: 0,0:02:31.75,0:02:34.04,Main,,0,0,0,,Рахмет, Хаясе-сан.
Dialogue: 0,0:02:34.04,0:02:35.31,Main,,0,0,0,,Біз сізге қарыздармыз.
Dialogue: 0,00:02:35.02,00:02:36.69,JPN TOP,,0,0,0,,Рахмет
Dialogue: 0,0:02:35.71,0:02:39.27,Main,,0,0,0,,Мына адамдарды баспанаға апарыңыз.
Dialogue: 0,00:02:36.78,00:02:40.28,JPN TOP,,0,0,0,,Бұл адамдарды эвакуация орталығына дейін алып барыңыз.
Dialogue: 0,0:02:39.27,0:02:40.10,Main,,0,0,0,,Иә, ханым.
Dialogue: 0,00:02:40.36,00:02:41.32,JPN TOP,,0,0,0,,Иә
Dialogue: 0,0:02:55.47,0:02:58.75,Main,,0,0,0,,Қандай жағымсыз көрініс.
Dialogue: 0,00:02:56.50,00:02:59.80,JPN TOP,,0,0,0,,Қандай жағымсыз көрініс, солай емес пе?
Dialogue: 0,0:02:59.25,0:03:01.58,Main,,0,0,0,,Енді не істейміз?
Dialogue: 0,00:03:00.34,00:03:02.68,JPN TOP,,0,0,0,,Енді не істейміз?
Dialogue: 0,00:03:02.76,00:03:03.60,JPN TOP,,0,0,0,,(Біреуді тесіп өткендей дыбыс)
Dialogue: 0,00:03:03.68,00:03:04.60,JPN TOP,,0,0,0,,Уф
Dialogue: 0,00:03:20.19,00:03:22.86,JPN TOP,,0,0,0,,А...
Dialogue: 0,0:03:22.32,0:03:25.72,Main,,0,0,0,,Айтшы, құбыжық, сен не істемексің?
Dialogue: 0,00:03:23.36,00:03:27.08,JPN TOP,,0,0,0,,Құбыжық, саған не керек?
Dialogue: 0,0:03:26.09,0:03:30.01,Main,,0,0,0,,Сіз де мен сияқты Фушидің артынан жүрсіз бе?
Dialogue: 0,00:03:27.16,00:03:30.96,JPN TOP,,0,0,0,,Мен сияқты Фушидің артынан жүресің бе?
Dialogue: 0,0:03:31.00,0:03:35.15,Main,,0,0,0,,Бұл жағдайда сіз мұны ақылдырақ жасауыңыз керек.
Dialogue: 0,00:03:32.00,00:03:36.13,JPN TOP,,0,0,0,,Онда біз ақылдырақ болуымыз керек
Dialogue: 0,0:03:35.15,0:03:40.39,Main,,0,0,0,,Осындай жиіркенішті кейпі бар баланы қалай басқаруға болады?
Dialogue: 0,00:03:36.21,00:03:41.76,JPN TOP,,0,0,0,,Мынадай сұрықсыз кейпі бар баланы қалай басқаруға болады?
Dialogue: 0,0:03:40.77,0:03:44.89,Main,,0,0,0,,Сіз Фушиді дөрекі күшпен ала алмайсыз.
Dialogue: 0,00:03:41.84,00:03:45.97,JPN TOP,,0,0,0,,Фуши енді күшпен алынбайды.
Dialogue: 0,0:03:49.63,0:03:51.16,Main,,0,0,0,,Өте талғампаз болма.
Dialogue: 0,00:03:50.64,00:03:52.19,JPN TOP,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:03:51.16,0:03:54.70,Main,,0,0,0,,Оған мен сияқты мейірімділікпен қарау керек.
Dialogue: 0,00:03:52.27,00:03:55.86,JPN TOP,,0,0,0,,Мен сияқты мейірімді болуың керек.
Dialogue: 0,00:04:11.25,00:04:12.41,JPN TOP,,0,0,0,,Фу…
Dialogue: 0,00:04:12.50,00:04:13.46,JPN TOP,,0,0,0,,(жебенің ату дыбысы)
Dialogue: 0,0:04:21.65,0:04:25.66,Episode_Title,,0,0,0,,Қаһарлы қаһар
Dialogue: 0,0:04:26.47,0:04:28.76,Main,,0,0,0,,Біз жақындап қалдық, Тонари-сан.
Dialogue: 0,00:04:27.55,00:04:29.64,JPN TOP,,0,0,0,,Жақында, Тонари-сан.
Dialogue: 0,0:04:28.76,0:04:31.54,Main,,0,0,0,,Біз олардың ұясына жақындап қалдық.
Dialogue: 0,00:04:29.72,00:04:32.48,JPN TOP,,0,0,0,,Біз олардың ұясына жақындап қалдық!
Dialogue: 0,0:04:31.80,0:04:33.44,Main,,0,0,0,,Б... бір сызық
Dialogue: 0,00:04:32.56,00:04:34.52,JPN TOP,,0,0,0,,Солай ма?
Dialogue: 0,0:04:34.47,0:04:38.27,Main,,0,0,0,,Маған да көбірек зерек болуы керек сияқты.
Dialogue: 0,00:04:35.52,00:04:39.36,JPN TOP,,0,0,0,,Мен де ақылды болуым керек.
Dialogue: 0,0:04:39.59,0:04:42.30,Main,,0,0,0,,Бет бе әлде ішек пе?
Dialogue: 0,00:04:40.65,00:04:43.24,JPN TOP,,0,0,0,,Бет немесе асқазан...
Dialogue: 0,0:04:43.85,0:04:46.26,Main,,0,0,0,,Мойын оны тездетуі керек.
Dialogue: 0,00:04:44.90,00:04:47.41,JPN TOP,,0,0,0,,Сіз жылдам сияқтысыз.
Dialogue: 0,00:04:50.45,00:04:51.66,JPN TOP,,0,0,0,,Гаха
Dialogue: 0,00:04:53.87,00:04:57.79,JPN TOP,,0,0,0,,Гурулу... у...
Dialogue: 0,0:04:58.06,0:04:59.17,Main,,0,0,0,,Фуши.
Dialogue: 0,00:04:59.13,00:05:00.21,JPN TOP,,0,0,0,,Фуши…
Dialogue: 0,0:05:00.38,0:05:03.16,Main,,0,0,0,,Сіз... мені өлтіресіз бе?
Dialogue: 0,00:05:01.50,00:05:04.34,JPN TOP,,0,0,0,,Өлтіру...?
Dialogue: 0,0:05:03.86,0:05:04.87,Main,,0,0,0,,Фуши?
Dialogue: 0,00:05:04.92,00:05:06.09,JPN TOP,,0,0,0,,Фуши!
Dialogue: 0,00:05:06.88,00:05:09.30,JPN TOP,,0,0,0,,Гуруру…
Dialogue: 0,00:05:09.39,00:05:11.85,JPN TOP,,0,0,0,,Хехе...
Dialogue: 0,0:05:10.83,0:05:12.91,Main,,0,0,0,,Қандай әзілқой.
Dialogue: 0,00:05:11.93,00:05:15.85,JPN TOP,,0,0,0,,Бұл күлкілі. Не болды?
Dialogue: 0,0:05:12.91,0:05:14.72,Main,,0,0,0,,Не болды?
Dialogue: 0,0:05:15.37,0:05:19.16,Main,,0,0,0,,Мені өлтіруге сізде ешқашан жақсы мүмкіндік болған емес.
Dialogue: 0,00:05:16.48,00:05:20.11,JPN TOP,,0,0,0,,Мені осылай кездейсоқ өлтірмеуге қалай дәтің бар?
Dialogue: 0,0:05:19.93,0:05:23.29,Main,,0,0,0,,Адам өлтіруден сонша қорқасың ба?
Dialogue: 0,00:05:20.94,00:05:24.24,JPN TOP,,0,0,0,,Сіз адамдарды өлтіруден қорқасыз ба?
Dialogue: 0,0:05:23.65,0:05:28.54,Main,,0,0,0,,Тезірек мені өлтіргеніңіз жөн, әйтпесе достарыңыз өледі.
Dialogue: 0,00:05:24.78,00:05:29.49,JPN TOP,,0,0,0,,Досыңды тез арада өлтірмесең өледі.
Dialogue: 0,00:05:32.08,00:05:33.33,JPN TOP,,0,0,0,,Уф
Dialogue: 0,0:05:33.19,0:05:34.51,Main,,0,0,0,,Тонари-сан!
Dialogue: 0,00:05:34.50,00:05:35.46,JPN TOP,,0,0,0,,Тонари мырза!
Dialogue: 0,00:05:35.54,00:05:38.62,JPN TOP,,0,0,0,,Ой... жарайды...
Dialogue: 0,0:05:36.19,0:05:37.52,Main,,0,0,0,,Менде бәрі жақсы.
Dialogue: 0,0:05:40.63,0:05:41.51,Main,,0,0,0,,Төмен тұр!
Dialogue: 0,00:05:41.67,00:05:43.13,JPN TOP,,0,0,0,,Өтінемін, жат!
Dialogue: 0,0:05:44.31,0:05:45.37,Main,,0,0,0,,Менің жебелерім!
Dialogue: 0,00:05:45.05,00:05:47.47,JPN TOP,,0,0,0,,Ха, жебе... Ах.
Dialogue: 0,00:05:49.05,00:05:50.30,JPN TOP,,0,0,0,,Уау
Dialogue: 0,0:05:53.01,0:05:54.03,Main,,0,0,0,,Сіз ауырып қалдыңыз ба?
Dialogue: 0,00:05:54.10,00:05:54.97,JPN TOP,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:05:54.52,0:05:55.71,Main,,0,0,0,,Өлмейтін...
Dialogue: 0,00:05:55.56,00:05:57.48,JPN TOP,,0,0,0,,Өлмейтін... Фуши мырза!
Dialogue: 0,0:05:55.71,0:05:56.54,Main,,0,0,0,,Фуши-сан!
Dialogue: 0,0:05:56.98,0:05:58.64,Main,,0,0,0,,Менің артымда болыңыз.
Dialogue: 0,00:05:58.10,00:06:00.94,JPN TOP,,0,0,0,,Менің артымда бол! бәрін өртеп жіберіңіз
Dialogue: 0,0:05:58.64,0:06:00.00,Main,,0,0,0,,Мен олардың бәрін өртеп жіберемін.
Dialogue: 0,0:06:20.66,0:06:23.80,Main,,0,0,0,,Сіз олардың бәрін жеңдіңіз, солай емес пе?
Dialogue: 0,00:06:21.75,00:06:24.92,JPN TOP,,0,0,0,,Сіз олардың бәрін жеңдіңіз, солай ма?
Dialogue: 0,0:06:24.62,0:06:25.86,Main,,0,0,0,,Сіз мұны жасадыңыз!
Dialogue: 0,00:06:25.59,00:06:26.80,JPN TOP,,0,0,0,,Иә!
Dialogue: 0,0:06:27.03,0:06:29.22,Main,,0,0,0,,Жарайсың, Фуши.
Dialogue: 0,00:06:28.13,00:06:30.47,JPN TOP,,0,0,0,,Жарайсың Фуши
Dialogue: 0,0:06:29.57,0:06:33.93,Main,,0,0,0,,Енді аралда тек үш Ноккер қалды.
Dialogue: 0,00:06:30.55,00:06:34.81,JPN TOP,,0,0,0,,Енді аралда үш тықыршы қалды.
Dialogue: 0,0:06:33.93,0:06:35.31,Main,,0,0,0,,Үш?
Dialogue: 0,00:06:34.89,00:06:36.47,JPN TOP,,0,0,0,,Үш дене...
Dialogue: 0,0:06:37.90,0:06:39.63,Main,,0,0,0,,Ей, Өлмейтін...
Dialogue: 0,00:06:38.68,00:06:42.11,JPN TOP,,0,0,0,,Ей, өлмейтіндер, Мия мен Урой ше?
Dialogue: 0,0:06:39.63,0:06:41.17,Main,,0,0,0,,Миа мен Урой қайда?
Dialogue: 0,00:06:56.20,00:06:57.37,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,0:06:57.32,0:06:58.31,Main,,0,0,0,,Миа...
Dialogue: 0,00:06:58.41,00:07:00.96,JPN TOP,,0,0,0,,Миа... Вуори!
Dialogue: 0,0:06:58.71,0:07:00.01,Main,,0,0,0,,Урой...
Dialogue: 0,0:07:02.07,0:07:03.18,Main,,0,0,0,,Өлмейтін...
Dialogue: 0,00:07:03.04,00:07:04.42,JPN TOP,,0,0,0,,Авдол мен басқалар… келе жатыр…
Dialogue: 0,00:07:06.30,00:07:07.55,JPN TOP,,0,0,0,,Құт
Dialogue: 0,0:07:07.33,0:07:08.25,Main,,0,0,0,,Мұнда.
Dialogue: 0,00:07:08.46,00:07:09.47,JPN TOP,,0,0,0,,Барша адамның ішінен… сен бе
Dialogue: 0,0:07:09.39,0:07:11.00,Main,,0,0,0,,Мен оларды құтқара алмадым.
Dialogue: 0,00:07:10.47,00:07:12.14,JPN TOP,,0,0,0,,(Қол Перісі) Құтқарып болмайды… Соңғы көргенім – демон өлтірушінің жүзі болар деп кім ойлаған…
Dialogue: 0,00:07:13.39,00:07:16.97,JPN TOP,,0,0,0,,(Тонаридің айқайы)
Dialogue: 0,0:07:15.99,0:07:17.03,Main,,0,0,0,,Мұнда.
Dialogue: 0,00:07:17.06,00:07:18.10,JPN TOP,,0,0,0,,Барша адамның ішінен… сен бе
Dialogue: 0,00:07:17.06,00:07:20.31,JPN TOP,,0,0,0,,(Сандель мен Тонаридің жылауы)
Dialogue: 0,0:07:18.21,0:07:19.24,Main,,0,0,0,,Мұнда.
Dialogue: 0,00:07:19.23,00:07:20.31,JPN TOP,,0,0,0,,Барша адамның ішінен… сен бе
Dialogue: 0,00:07:20.31,00:07:21.27,JPN TOP,,0,0,0,,(Сандель мен Тонаридің жылауы)
Dialogue: 0,0:07:22.26,0:07:24.84,Main,,0,0,0,,Жоқ, барлығына мен кінәлімін.
Dialogue: 0,00:07:23.31,00:07:25.94,JPN TOP,,0,0,0,,Жоқ, бұл менің кінәм.
Dialogue: 0,0:07:25.36,0:07:27.74,Main,,0,0,0,,Осының бәрін мен әкелдім.
Dialogue: 0,00:07:26.44,00:07:28.94,JPN TOP,,0,0,0,,Мен олардың барлығын шақырдым.
Dialogue: 0,0:07:28.71,0:07:30.79,Main,,0,0,0,,Сегіз жасымнан бастап,
Dialogue: 0,00:07:29.78,00:07:32.32,JPN TOP,,0,0,0,,Мен сегіз жасымнан сенімдімін.
Dialogue: 0,0:07:31.56,0:07:34.73,Main,,0,0,0,,Мен барлық қате таңдау жасадым.
Dialogue: 0,00:07:32.41,00:07:35.66,JPN TOP,,0,0,0,,Мен қате таңдау жасай бердім
Dialogue: 0,0:07:35.85,0:07:39.23,Main,,0,0,0,,Мен өзімшілмін.
Dialogue: 0,00:07:36.91,00:07:40.16,JPN TOP,,0,0,0,,Мен өзімшілмін...
Dialogue: 0,0:07:39.23,0:07:42.34,Main,,0,0,0,,Мен ешқашан дұрыс емес едім.
Dialogue: 0,00:07:40.25,00:07:43.62,JPN TOP,,0,0,0,,Мен тыныш болмадым.
Dialogue: 0,0:07:42.65,0:07:44.62,Main,,0,0,0,,Эбису
Dialogue: 0,00:07:43.71,00:07:45.54,JPN TOP,,0,0,0,,Жоқ, олай емес!
Dialogue: 0,0:07:44.94,0:07:47.81,Main,,0,0,0,,Бұлай болғанын ешкім қалаған жоқ.
Dialogue: 0,00:07:45.63,00:07:49.30,JPN TOP,,0,0,0,,Ешкім күтпеген нәрсе болды.
Dialogue: 0,0:07:48.37,0:07:50.45,Main,,0,0,0,,Бұл ешкімнің кінәсі емес.
Dialogue: 0,00:07:49.38,00:07:52.88,JPN TOP,,0,0,0,,Оған ешкім кінәлі емес, мүлде!
Dialogue: 0,0:07:50.45,0:07:51.96,Main,,0,0,0,,Бұл емес!
Dialogue: 0,00:07:54.09,00:07:55.93,JPN TOP,,0,0,0,,(Тонари мен Сандельдің жылауы)
Dialogue: 0,0:07:54.93,0:08:01.95,Main,,0,0,0,,Фуши, олар жеткілікті жақындаған кезде, олар жерге тамыр салады.
Dialogue: 0,00:07:56.01,00:08:00.89,JPN TOP,,0,0,0,,Фуши Бұл нәрсе маған біраз жақындап қалды.
Dialogue: 0,00:08:00.98,00:08:03.06,JPN TOP,,0,0,0,,Жерге тамыр жайған
Dialogue: 0,0:08:03.62,0:08:06.09,Main,,0,0,0,,Балалар, артқа шегініңдер.
Dialogue: 0,00:08:04.69,00:08:07.48,JPN TOP,,0,0,0,,Екеуің де артқа шегініңдер.
Dialogue: 0,0:08:06.53,0:08:08.35,Main,,0,0,0,,Олардан аулақ болу керек.
Dialogue: 0,00:08:07.57,00:08:09.28,JPN TOP,,0,0,0,,Олардан аулақ болыңыз.
Dialogue: 0,0:08:10.58,0:08:12.27,Main,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,00:08:11.57,00:08:13.20,JPN TOP,,0,0,0,,Мүмкін, сенің көзіңдегі жамандықтан шығар
Dialogue: 0,0:08:14.63,0:08:16.08,Main,,0,0,0,,Мен бір қолымда оқталған винтовка ұстап тұрмын
Dialogue: 0,00:08:15.74,00:08:17.33,JPN TOP,,0,0,0,,Не істеуім керек?
Dialogue: 0,0:08:19.61,0:08:23.69,Main,,0,0,0,,Мен Тонари-санға шешім қабылдауға рұқсат етемін.
Dialogue: 0,00:08:20.66,00:08:24.62,JPN TOP,,0,0,0,,Мен мұны Тонари-санға қалдырамын.
Dialogue: 0,0:08:26.71,0:08:28.13,Main,,0,0,0,,Ой, Хиёри-я! Жаңа жылды әзілмен бастап жатырсың ғой, иә?
Dialogue: 0,00:08:27.75,00:08:29.13,JPN TOP,,0,0,0,,Мен...
Dialogue: 0,0:08:30.09,0:08:31.44,Main,,0,0,0,,Мен істеймін бе?
Dialogue: 0,00:08:31.13,00:08:33.13,JPN TOP,,0,0,0,,I… га
Dialogue: 0,0:08:32.99,0:08:36.11,Main,,0,0,0,,Сен үшін оларды өлтірейін бе?
Dialogue: 0,00:08:34.09,00:08:37.30,JPN TOP,,0,0,0,,Мен сені өлтірейін бе?
Dialogue: 0,00:08:41.89,00:08:44.64,JPN TOP,,0,0,0,,Ах... Тонари!
Dialogue: 0,0:08:42.77,0:08:43.70,Main,,0,0,0,,Тонари!
Dialogue: 0,0:08:44.76,0:08:47.20,Main,,0,0,0,,Олар тек ұйықтап жатыр.
Dialogue: 0,00:08:45.85,00:08:48.15,JPN TOP,,0,0,0,,Ол ұйықтап жатыр.
Dialogue: 0,0:08:48.15,0:08:49.17,Main,,0,0,0,,Әзірге.
Dialogue: 0,00:08:49.23,00:08:50.36,JPN TOP,,0,0,0,,Жарайды, операцияны басынан бастауға тура келеді.
Dialogue: 0,0:08:51.96,0:08:56.29,Main,,0,0,0,,Енді мен сен үшін ол балаларды өлтіремін.
Dialogue: 0,00:08:53.03,00:08:57.24,JPN TOP,,0,0,0,,Жүр, мен ол балаларды өлтіремін.
Dialogue: 0,0:08:56.55,0:08:59.49,Main,,0,0,0,,Өтінемін, оларды өлтіруге рұқсат етіңіз.
Dialogue: 0,00:08:57.32,00:09:00.91,JPN TOP,,0,0,0,,Жоқ, мен сені өлтірейін!
Dialogue: 0,0:08:59.93,0:09:01.53,Main,,0,0,0,,Сізге.
Dialogue: 0,00:09:00.99,00:09:02.45,JPN TOP,,0,0,0,,Сізге
Dialogue: 0,00:09:02.54,00:09:03.75,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:09:03.64,0:09:08.02,Main,,0,0,0,,Мен сенің сұлу жан болғаныңды қалаймын.
Dialogue: 0,00:09:04.66,00:09:09.21,JPN TOP,,0,0,0,,Мен сенің әдемі болғаныңды қалаймын.
Dialogue: 0,0:09:08.96,0:09:12.94,Main,,0,0,0,,Ешкімді өлтірмей, ешкімді ренжітпей, ешкімнен алмаған.
Dialogue: 0,00:09:10.04,00:09:14.55,JPN TOP,,0,0,0,,Ешкімді өлтірмеңіз, ренжітпеңіз немесе ұрламаңыз
Dialogue: 0,0:09:13.58,0:09:18.53,Main,,0,0,0,,Тәніне ие болған дос болса да.
Dialogue: 0,00:09:14.63,00:09:15.88,JPN TOP,,0,0,0,,Тіпті егер
Dialogue: 0,00:09:16.43,00:09:19.68,JPN TOP,,0,0,0,,Денесі басқарылатын дос болсаң да...
Dialogue: 0,0:09:19.20,0:09:21.55,Main,,0,0,0,,Сенің қалағаның осы емес пе, Фуши?
Dialogue: 0,00:09:20.26,00:09:22.77,JPN TOP,,0,0,0,,Сіз де соны қалайсыз, солай ма?
Dialogue: 0,0:09:22.16,0:09:25.12,Main,,0,0,0,,Сол үшін де мені өлтіре алмадың ба?
Dialogue: 0,00:09:23.27,00:09:26.27,JPN TOP,,0,0,0,,Демек, сен де мені өлтіре алмадың, солай ма?
Dialogue: 0,0:09:25.77,0:09:30.06,Main,,0,0,0,,Сізде өзіңізді қорлауға батылдық жетпейді.
Dialogue: 0,00:09:26.85,00:09:31.48,JPN TOP,,0,0,0,,Өзіңді кірлетуге батылың жетпейді.
Dialogue: 0,0:09:30.55,0:09:33.58,Main,,0,0,0,,Иә, мен мұны қолдаймын!
Dialogue: 0,00:09:31.57,00:09:34.74,JPN TOP,,0,0,0,,Иә, келісемін!
Dialogue: 0,0:09:34.35,0:09:40.23,Main,,0,0,0,,Мен сені қорғау үшін сол лас рөлді аламын.
Dialogue: 0,00:09:35.53,00:09:37.86,JPN TOP,,0,0,0,,Сізді қорғау үшін
Dialogue: 0,00:09:37.95,00:09:41.16,JPN TOP,,0,0,0,,Мен лас рөлді аламын.
Dialogue: 0,0:09:40.44,0:09:42.91,Main,,0,0,0,,Тонариді жібер.
Dialogue: 0,00:09:41.24,00:09:43.91,JPN TOP,,0,0,0,,Әзірге Тонариді жіберіңіз.
Dialogue: 0,0:09:42.91,0:09:45.23,Main,,0,0,0,,Осыдан кейін мен сізді тыңдаймын.
Dialogue: 0,00:09:44.00,00:09:46.16,JPN TOP,,0,0,0,,Ертегіні кейін тыңдаймын.
Dialogue: 0,0:09:45.23,0:09:47.19,Main,,0,0,0,,Қозғалмаңыз, өтінемін.
Dialogue: 0,00:09:46.25,00:09:48.12,JPN TOP,,0,0,0,,Әйелдер бұл рөлге жарамайды; ол спикер ретіндегі рөлін түсінуде жеткіліксіз санаға ие болған деген қорытындыға келуге тура келеді
Dialogue: 0,0:09:49.40,0:09:52.69,Main,,0,0,0,,Оның өртеніп күлге айналғанын көргің келе ме?
Dialogue: 0,00:09:50.46,00:09:53.63,JPN TOP,,0,0,0,,Мына баланың күйіп кеткенін көргің келе ме?
Dialogue: 0,0:09:52.94,0:09:54.81,Main,,0,0,0,,Тонаридің бұған қатысы жоқ!
Dialogue: 0,00:09:53.71,00:09:55.76,JPN TOP,,0,0,0,,Тонаридің бұған қатысы жоқ!
Dialogue: 0,0:09:55.63,0:09:58.26,Main,,0,0,0,,Мен сенімен келіссөз жүргізіп жатырмын, Фуси.
Dialogue: 0,00:09:56.72,00:09:59.39,JPN TOP,,0,0,0,,Біз келіссөздер жүргізіп жатырмыз, Фуси.
Dialogue: 0,0:09:59.27,0:10:01.72,Main,,0,0,0,,Менен бас тартасың ба,
Dialogue: 0,00:10:00.34,00:10:05.02,JPN TOP,,0,0,0,,Достарыңды өлтіріп, күнәһар, арам болсаң да
Dialogue: 0,0:10:01.72,0:10:06.64,Main,,0,0,0,,Достарыңды өлтіріп, күнәға батып, лас болуды білдірсе де?
Dialogue: 0,00:10:05.10,00:10:07.77,JPN TOP,,0,0,0,,Менен бас тартқыңыз келе ме?
Dialogue: 0,0:10:07.50,0:10:10.86,Main,,0,0,0,,Мен саған керекпін.
Dialogue: 0,00:10:08.60,00:10:11.98,JPN TOP,,0,0,0,,Мен саған керекпін
Dialogue: 0,00:10:12.06,00:10:12.90,JPN TOP,,0,0,0,,Ha
Dialogue: 0,0:10:12.27,0:10:14.30,Main,,0,0,0,,Менің ұсынысым қарапайым.
Dialogue: 0,00:10:12.98,00:10:15.65,JPN TOP,,0,0,0,,Қарапайым ұсыныс
Dialogue: 0,0:10:14.69,0:10:17.68,Main,,0,0,0,,Мен оны өлтірмеймін.
Dialogue: 0,00:10:15.74,00:10:18.57,JPN TOP,,0,0,0,,Мен бұл баланы өлтірмеймін.
Dialogue: 0,0:10:18.13,0:10:22.14,Main,,0,0,0,,Оның орнына мен үшеуін өлтіремін.
Dialogue: 0,00:10:18.70,00:10:23.08,JPN TOP,,0,0,0,,(Тонаридің ауыр тыныс алуы)
Dialogue: 0,00:10:19.24,00:10:23.08,JPN TOP,,0,0,0,,Оның орнына мен сол үш адамды өлтіремін.
Dialogue: 0,00:10:23.08,00:10:24.95,JPN TOP,,0,0,0,,(Тонаридің ауыр тыныс алуы)
Dialogue: 0,00:10:23.16,00:10:24.95,JPN TOP,,0,0,0,,Ha
Dialogue: 0,0:10:24.20,0:10:29.89,Main,,0,0,0,,Менің ұсынысымды қолдап басын изеп қойсаңыз болғаны.
Dialogue: 0,00:10:25.04,00:10:27.54,JPN TOP,,0,0,0,,Сіз менің ұсынысымды қабылдайсыз
Dialogue: 0,00:10:27.62,00:10:31.00,JPN TOP,,0,0,0,,«Иә» деп бас изеу жеткілікті.
Dialogue: 0,0:10:32.05,0:10:34.75,Main,,0,0,0,,Жаса, мына қызды құтқар.
Dialogue: 0,00:10:33.13,00:10:35.92,JPN TOP,,0,0,0,,Мына қызға көмектесу үшін
Dialogue: 0,0:10:49.39,0:10:53.45,Italics,,0,0,0,,Дәл қазір таңдағым келетін тағдыр болса,
Dialogue: 0,00:10:50.48,00:10:54.52,JPN TOP,,0,0,0,,Маған қазір таңдау керек болса...
Dialogue: 0,0:10:54.46,0:10:55.50,Italics,,0,0,0,,міне осы.
Dialogue: 0,00:10:55.57,00:10:56.44,JPN TOP,,0,0,0,,Міне!
Dialogue: 0,0:10:56.32,0:11:00.28,Italics,,0,0,0,,Опа, Миа, Урой...
Dialogue: 0,00:10:57.40,00:11:01.45,JPN TOP,,0,0,0,,Woopa mia wooroi...
Dialogue: 0,0:11:01.06,0:11:04.52,Italics,,0,0,0,,Мен саған бара жатырмын.
Dialogue: 0,00:11:02.16,00:11:05.45,JPN TOP,,0,0,0,,Мен де қазір барамын.
Dialogue: 0,00:11:15.13,00:11:18.05,JPN TOP,,0,0,0,,(Тонаридің ауыр тыныс алуы)
Dialogue: 0,0:11:17.93,0:11:20.62,Main,,0,0,0,,Сізге дер кезінде жеткеніме шүкір.
Dialogue: 0,00:11:19.13,00:11:21.80,JPN TOP,,0,0,0,,Жақсы нәрсе, мен оны уақытында жасадым ...
Dialogue: 0,00:11:23.80,00:11:24.80,JPN TOP,,0,0,0,,Ha
Dialogue: 0,0:11:23.81,0:11:24.97,Main,,0,0,0,,Не бұл, Хиёри? Жаңа жылдық әзіл ме?
Dialogue: 0,00:11:24.89,00:11:27.52,JPN TOP,,0,0,0,,Жарайды, мен ұйықтап жатырмын.
Dialogue: 0,0:11:25.42,0:11:26.59,Main,,0,0,0,,Мен оны ұйықтаттым.
Dialogue: 0,0:11:36.50,0:11:38.19,Main,,0,0,0,,Жүріңдер, тұрыңдар.
Dialogue: 0,00:11:37.53,00:11:39.44,JPN TOP,,0,0,0,,Кәне, орнымыздан тұрайық.
Dialogue: 0,00:11:39.53,00:11:44.95,JPN TOP,,0,0,0,,(Тонаридің ауыр тыныс алуы)
Dialogue: 0,00:12:13.94,00:12:14.90,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,0:12:57.63,0:13:01.20,Main,,0,0,0,,Оопаның ата-анасы оны бір күміс монетаға сатты,
Dialogue: 0,00:12:58.73,00:13:02.53,JPN TOP,,0,0,0,,Упа ата-анасына бір күміс тиынға сатылды.
Dialogue: 0,0:13:01.59,0:13:05.63,Main,,0,0,0,,бірақ ол қамқор, жанашыр қыз болып өсті.
Dialogue: 0,00:13:02.61,00:13:06.95,JPN TOP,,0,0,0,,Осыған қарамастан мен қамқор, ілтипатты бала болып өстім.
Dialogue: 0,0:13:06.05,0:13:07.62,Main,,0,0,0,,Ол өте жақсы қыз.
Dialogue: 0,00:13:07.03,00:13:08.57,JPN TOP,,0,0,0,,Ол өте жақсы бала.
Dialogue: 0,0:13:08.38,0:13:12.18,Main,,0,0,0,,Миа маған достық сыйлады.
Dialogue: 0,00:13:09.45,00:13:13.29,JPN TOP,,0,0,0,,Миа маған дос сыйлады.
Dialogue: 0,0:13:12.75,0:13:16.81,Main,,0,0,0,,Бұл аралда күлімсіреуімнің жалғыз себебі ол.
Dialogue: 0,00:13:13.79,00:13:16.33,JPN TOP,,0,0,0,,Менің бұл аралда күлімсіреу себебім болды
Dialogue: 0,00:13:16.42,00:13:17.96,JPN TOP,,0,0,0,,Осы балаға рахмет
Dialogue: 0,0:13:17.56,0:13:20.41,Main,,0,0,0,,Урой ақкөңіл аға сияқты еді.
Dialogue: 0,00:13:18.63,00:13:21.38,JPN TOP,,0,0,0,,Урой өзін ақкөңіл аға ретінде сезінеді.
Dialogue: 0,0:13:20.91,0:13:22.48,Main,,0,0,0,,Бірдеңе болған кезде,
Dialogue: 0,00:13:21.96,00:13:23.34,JPN TOP,,0,0,0,,Бірдеңе болған кезде
Dialogue: 0,0:13:22.48,0:13:25.69,Main,,0,0,0,,ол бірінші болып семсерін суырып, бәрімізді қорғайды.
Dialogue: 0,00:13:23.42,00:13:26.84,JPN TOP,,0,0,0,,Бірінші болып қылышын суырып, бәрін қорғайды.
Dialogue: 0,0:13:28.36,0:13:31.66,Main,,0,0,0,,Олар мен үшін өмір сүруге тура келді.
Dialogue: 0,00:13:29.47,00:13:32.81,JPN TOP,,0,0,0,,Барлығы менің өмір сүруіме себеп болды.
Dialogue: 0,0:13:33.08,0:13:36.68,Main,,0,0,0,,Бұрын айтқан сөздерім үшін кешірім сұраймын.
Dialogue: 0,00:13:34.18,00:13:36.23,JPN TOP,,0,0,0,,Менің бұрын айтқаным...
Dialogue: 0,00:13:36.89,00:13:38.15,JPN TOP,,0,0,0,,Кешіріңіз
Dialogue: 0,0:13:37.12,0:13:42.75,Main,,0,0,0,,Мен сені қалыпты емессің деп айтпауым керек еді.
Dialogue: 0,00:13:38.23,00:13:41.69,JPN TOP,,0,0,0,,Мен барлығы қалыпты емес дедім...
Dialogue: 0,00:13:42.19,00:13:44.03,JPN TOP,,0,0,0,,Бұл жаман сөз болды.
Dialogue: 0,0:13:43.58,0:13:44.83,Main,,0,0,0,,Жақсы.
Dialogue: 0,00:13:44.65,00:13:47.49,JPN TOP,,0,0,0,,Жарайды, бәрі білді.
Dialogue: 0,0:13:44.83,0:13:46.43,Main,,0,0,0,,Бәріміз білдік.
Dialogue: 0,0:13:46.91,0:13:48.37,Main,,0,0,0,,Біз қарсылық көрсеттік.
Dialogue: 0,00:13:47.99,00:13:49.66,JPN TOP,,0,0,0,,Мен қарсылық көрсеттім.
Dialogue: 0,0:13:48.72,0:13:51.34,Main,,0,0,0,,Біз бұл аралды жеңгіміз келді.
Dialogue: 0,00:13:49.74,00:13:52.54,JPN TOP,,0,0,0,,Олар бұл аралды жеңеміз деді.
Dialogue: 0,0:13:52.19,0:13:55.11,Main,,0,0,0,,Бірақ біз одан кейін күлдік.
Dialogue: 0,00:13:53.29,00:13:56.12,JPN TOP,,0,0,0,,Бірақ осыдан кейін бәріміз күлдік.
Dialogue: 0,0:13:55.51,0:13:57.24,Main,,0,0,0,,Дұрыс, орындадық.
Dialogue: 0,00:13:56.62,00:14:00.54,JPN TOP,,0,0,0,,Дұрыс, «Айтасың ба?» дедім.
Dialogue: 0,0:13:57.24,0:13:59.61,Main,,0,0,0,,Сіз сөйлейтін адамсыз, солай емес пе?
Dialogue: 0,0:13:59.94,0:14:02.60,Main,,0,0,0,,Біз мәйіттерді алғымыз келеді.
Dialogue: 0,00:14:01.09,00:14:03.55,JPN TOP,,0,0,0,,Мен мәйітті тезірек жеткізгім келеді...
Dialogue: 0,0:14:03.45,0:14:04.96,Main,,0,0,0,,Арал көшбасшысы.
Dialogue: 0,00:14:03.63,00:14:07.17,JPN TOP,,0,0,0,,Аа, бастық, мұнда неге келдің?
Dialogue: 0,0:14:04.96,0:14:06.24,Main,,0,0,0,,Осы сәттен бастап біз жын-перілердің сиқырына алданған сиқыршы Эбисуды өлтіруге аттанамыз
Dialogue: 0,0:14:06.70,0:14:09.11,Main,,0,0,0,,Мен сені кетті деп ойладым.
Dialogue: 0,00:14:07.80,00:14:10.05,JPN TOP,,0,0,0,,Ол кеткен жоқ па?
Dialogue: 0,0:14:10.29,0:14:14.44,Main,,0,0,0,,Бұлар сізбен бірге аралды тастап кеткен достарыңыз болды, солай емес пе?
Dialogue: 0,00:14:11.35,00:14:15.60,JPN TOP,,0,0,0,,Бұл балалар да аралды бірге тастап кеткен достарың, солай ма?
Dialogue: 0,0:14:16.26,0:14:17.74,Main,,0,0,0,,Біз қайтып келдік.
Dialogue: 0,00:14:17.39,00:14:18.89,JPN TOP,,0,0,0,,Мен қайтып келдім
Dialogue: 0,0:14:18.72,0:14:21.82,Main,,0,0,0,,Бәріміз бірге күрестік.
Dialogue: 0,00:14:19.81,00:14:22.90,JPN TOP,,0,0,0,,Барлығы бірге күресті.
Dialogue: 0,00:14:25.36,00:14:26.28,JPN TOP,,0,0,0,,Жоқ…
Dialogue: 0,0:14:27.77,0:14:29.41,Main,,0,0,0,,Бұл қалай болуы мүмкін?
Dialogue: 0,00:14:28.86,00:14:30.57,JPN TOP,,0,0,0,,О, құдайым...
Dialogue: 0,0:14:32.68,0:14:36.15,Main,,0,0,0,,Бұл балалар қателік жасаған жоқ.
Dialogue: 0,00:14:33.74,00:14:37.08,JPN TOP,,0,0,0,,Бұл балалар ештеңе істеп жатқан жоқ.
Dialogue: 0,0:14:37.09,0:14:39.77,Main,,0,0,0,,Бәрі де біз сияқты маскүнемдер үшін...
Dialogue: 0,00:14:38.12,00:14:40.79,JPN TOP,,0,0,0,,Біз сияқты маскүнемдерге...
Dialogue: 0,00:14:42.67,00:14:48.09,JPN TOP,,0,0,0,,(Аралдықтардың айқайы)
Dialogue: 0,0:14:55.48,0:14:56.68,Main,,0,0,0,,Фуши-сан,
Dialogue: 0,00:14:56.52,00:14:57.68,JPN TOP,,0,0,0,,Фуши мырза
Dialogue: 0,0:14:57.31,0:15:00.73,Main,,0,0,0,,Бұл арал көшбасшыны талап етеді.
Dialogue: 0,00:14:58.18,00:15:01.77,JPN TOP,,0,0,0,,Бұл аралға көшбасшы керек.
Dialogue: 0,0:15:00.73,0:15:04.12,Main,,0,0,0,,Халықпен сөйлесер ме едіңіз?
Dialogue: 0,00:15:01.85,00:15:05.07,JPN TOP,,0,0,0,,Барлығының алдында сөйлей аласыз ба?
Dialogue: 0,0:15:05.90,0:15:08.96,Main,,0,0,0,,Жоқ, мен олай істей алмаймын.
Dialogue: 0,00:15:06.94,00:15:10.28,JPN TOP,,0,0,0,,Жоқ, сіз мұны істей алмайсыз.
Dialogue: 0,0:15:09.34,0:15:11.80,Main,,0,0,0,,Мұның бәріне менің кінәм болды.
Dialogue: 0,00:15:10.36,00:15:12.74,JPN TOP,,0,0,0,,Мұның болғанына мен кінәлімін.
Dialogue: 0,0:15:12.03,0:15:14.66,Main,,0,0,0,,Олай болса, көсем, сөз?
Dialogue: 0,00:15:12.82,00:15:15.70,JPN TOP,,0,0,0,,Енді, бастық, бірдеңе айтыңызшы!
Dialogue: 0,00:15:15.78,00:15:16.70,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:15:19.02,0:15:21.78,Main,,0,0,0,,Олай болса бәріне осыны айт.
Dialogue: 0,00:15:20.04,00:15:22.71,JPN TOP,,0,0,0,,Осыны барлығына айт.
Dialogue: 0,0:15:22.58,0:15:26.01,Main,,0,0,0,,Мәйіт тауы жамандықты тартады.
Dialogue: 0,00:15:23.67,00:15:27.38,JPN TOP,,0,0,0,,Мәйіт тауы жамандықты өзіне тартады.
Dialogue: 0,0:15:26.41,0:15:31.23,Main,,0,0,0,,Сондықтан біз өлтіруді тоқтатып, өліп қалмас үшін бір-бірімізге көмектесуіміз керек.
Dialogue: 0,00:15:27.46,00:15:29.67,JPN TOP,,0,0,0,,Біріншіден, өлтіруді доғар.
Dialogue: 0,00:15:29.76,00:15:32.59,JPN TOP,,0,0,0,,Бір-бірімізге көмектесіп, өлмейтіндей өмір сүрейік
Dialogue: 0,0:15:32.41,0:15:34.43,Main,,0,0,0,,Кел де жуынып ал.
Dialogue: 0,00:15:33.43,00:15:37.39,JPN TOP,,0,0,0,,Рахмет, мен бірден айтамын.
Dialogue: 0,0:15:34.43,0:15:36.24,Main,,0,0,0,,Мен сіздің хабарламаңызды бірден бөлісемін.
Dialogue: 0,0:15:42.99,0:15:45.17,Main,,0,0,0,,Сөз тарайды деп үміттенемін.
Dialogue: 0,00:15:44.02,00:15:46.40,JPN TOP,,0,0,0,,тарайды деп үміттенемін.
Dialogue: 0,0:15:45.78,0:15:46.59,Main,,0,0,0,,Оқу, оқу
Dialogue: 0,00:15:46.90,00:15:47.90,JPN TOP,,0,0,0,,Иә
Dialogue: 0,00:15:48.98,00:15:53.36,JPN TOP,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:15:52.43,0:15:56.68,Main,,0,0,0,,Енді қандай жоспарың бар, Фуси-сан?
Dialogue: 0,00:15:53.45,00:15:57.62,JPN TOP,,0,0,0,,Ендеше, енді не істейсіз, Фуси мырза?
Dialogue: 0,0:15:57.03,0:16:01.07,Main,,0,0,0,,Мен осында қалсам, көбірек Ноккерлер келеді.
Dialogue: 0,00:15:58.16,00:16:02.25,JPN TOP,,0,0,0,,Мен осында қалсам, тықылдаушы тағы келеді.
Dialogue: 0,0:16:01.94,0:16:04.95,Main,,0,0,0,,Мен аралды аралаймын әлі уақыт бар,
Dialogue: 0,00:16:03.04,00:16:06.04,JPN TOP,,0,0,0,,Уақытым болғанша аралды аралаймын.
Dialogue: 0,0:16:04.95,0:16:07.82,Main,,0,0,0,,және мен жетіспейтін ештеңе қалмаған соң кетемін.
Dialogue: 0,00:16:06.13,00:16:09.00,JPN TOP,,0,0,0,,Ештеңе жоқ кезде мен кетемін.
Dialogue: 0,0:16:08.82,0:16:10.11,Main,,0,0,0,,Б... бір сызық
Dialogue: 0,00:16:09.96,00:16:11.76,JPN TOP,,0,0,0,,Солай ма?
Dialogue: 0,0:16:10.78,0:16:12.37,Main,,0,0,0,,Екеуің ше?
Dialogue: 0,00:16:11.84,00:16:13.47,JPN TOP,,0,0,0,,Тонари мен Сандел туралы не деуге болады?
Dialogue: 0,0:16:13.23,0:16:15.88,Main,,0,0,0,,Біз де бұрын сөйлескен едік.
Dialogue: 0,00:16:14.34,00:16:17.05,JPN TOP,,0,0,0,,Біз де бұрын сөйлескен едік.
Dialogue: 0,0:16:20.28,0:16:22.16,Main,,0,0,0,,Біз осы аралда қаламыз.
Dialogue: 0,00:16:21.39,00:16:23.31,JPN TOP,,0,0,0,,Осы аралда қалыңыз
Dialogue: 0,0:16:32.73,0:16:36.09,Main,,0,0,0,,Аралдан кеткіңіз келмейтініне сенімдісіз бе?
Dialogue: 0,00:16:33.86,00:16:37.03,JPN TOP,,0,0,0,,Аралдан кетудің қажеті жоқ екеніне сенімдісіз бе?
Dialogue: 0,0:16:36.82,0:16:37.59,Main,,0,0,0,,Оқу, оқу
Dialogue: 0,00:16:37.87,00:16:38.78,JPN TOP,,0,0,0,,Иә
Dialogue: 0,0:16:41.02,0:16:44.68,Main,,0,0,0,,Мен осы жердегі ластанған суды тазалағым келеді.
Dialogue: 0,00:16:42.12,00:16:46.04,JPN TOP,,0,0,0,,Мен мұндағы бұлыңғыр суды тазартқым келеді.
Dialogue: 0,0:16:48.29,0:16:54.47,Main,,0,0,0,,Мазалаған адамдар көбірек пайда болып, аралды қайтадан мазалайтынына сенімдімін.
Dialogue: 0,00:16:49.13,00:16:52.88,JPN TOP,,0,0,0,,Болашақта бұдан да көп қиындық тудыратын адамдар болатынына сенімдімін.
Dialogue: 0,00:16:52.97,00:16:55.51,JPN TOP,,0,0,0,,Менің ойымша, олар тағы да аралда қиындық туғызады.
Dialogue: 0,0:16:55.00,0:16:58.11,Main,,0,0,0,,Бірақ мен бұған жол бергім келмейді.
Dialogue: 0,00:16:56.09,00:16:59.05,JPN TOP,,0,0,0,,Бірақ мен оны бұлай қалдырмаймын.
Dialogue: 0,0:17:00.30,0:17:04.58,Main,,0,0,0,,Мен оны кірді тазартатын аралға айналдырамын ...
Dialogue: 0,00:17:01.39,00:17:05.77,JPN TOP,,0,0,0,,Барлық лас адамдарды толығымен тазартуға болатын арал жасаңыз...
Dialogue: 0,0:17:07.32,0:17:11.80,Main,,0,0,0,,және басқа тағдырға жол сілтеңіз.
Dialogue: 0,00:17:08.40,00:17:12.99,JPN TOP,,0,0,0,,Мен сенің тағдырыңды өзгерту үшін жол көрсетуші бағана жасағым келеді.
Dialogue: 0,0:17:14.14,0:17:18.91,Main,,0,0,0,,Мен он төрт жасар қыздың бұл арал үшін ештеңе істей алатынын білмеймін,
Dialogue: 0,00:17:15.15,00:17:19.91,JPN TOP,,0,0,0,,14 жасар қыз бұл аралмен ештеңе істей ала ма, білмеймін.
Dialogue: 0,0:17:18.91,0:17:20.12,Main,,0,0,0,,бірақ мен оны сынап көремін.
Dialogue: 0,00:17:19.99,00:17:21.33,JPN TOP,,0,0,0,,Мен жасап көремін
Dialogue: 0,0:17:23.63,0:17:25.06,Main,,0,0,0,,Мен керек-жарақтарды әкелдім.
Dialogue: 0,00:17:24.41,00:17:27.25,JPN TOP,,0,0,0,,Мен әкелдім, өтінемін.
Dialogue: 0,0:17:25.06,0:17:26.30,Main,,0,0,0,,Жер
Dialogue: 0,0:17:26.48,0:17:28.04,Main,,0,0,0,,Кел де жуынып ал.
Dialogue: 0,00:17:27.33,00:17:29.00,JPN TOP,,0,0,0,,Рахмет
Dialogue: 0,0:17:28.04,0:17:31.40,Main,,0,0,0,,Сізге тағы бір нәрсе керек болса, маған хабарлаңыз.
Dialogue: 0,00:17:29.08,00:17:30.75,JPN TOP,,0,0,0,,Тағы не жетіспейді?
Dialogue: 0,00:17:30.84,00:17:34.30,JPN TOP,,0,0,0,,Өтінемін, орындаңыз! Мен өте жігерлімін
Dialogue: 0,0:17:31.40,0:17:33.36,Main,,0,0,0,,Менде көп күш бар.
Dialogue: 0,0:17:34.36,0:17:36.61,Main,,0,0,0,,Жараларыңыз қалай?
Dialogue: 0,00:17:35.42,00:17:37.55,JPN TOP,,0,0,0,,Сіздің жараңыз қалай?
Dialogue: 0,0:17:36.61,0:17:39.61,Main,,0,0,0,,Рахмет, жастар.
Dialogue: 0,00:17:37.63,00:17:40.55,JPN TOP,,0,0,0,,Рахмет, апалар
Dialogue: 0,0:17:41.14,0:17:42.11,Main,,0,0,0,,Мүлде жоқ.
Dialogue: 0,00:17:41.35,00:17:43.47,JPN TOP,,0,0,0,,А... жоқ
Dialogue: 0,0:17:42.54,0:17:44.82,Main,,0,0,0,,Тағы да көп нәрсе бар.
Dialogue: 0,00:17:43.56,00:17:46.48,JPN TOP,,0,0,0,,Алда әлі көп...
Dialogue: 0,0:17:44.82,0:17:45.61,Main,,0,0,0,,Тамақ ішіңіз.
Dialogue: 0,0:17:45.61,0:17:46.80,Main,,0,0,0,,Кел де жуынып ал.
Dialogue: 0,00:17:46.56,00:17:48.98,JPN TOP,,0,0,0,,Кешіріңіз, мен риза боламын.
Dialogue: 0,0:17:46.80,0:17:47.79,Main,,0,0,0,,Мен оны бағалаймын.
Dialogue: 0,0:17:47.79,0:17:48.85,Main,,0,0,0,,Жер
Dialogue: 0,0:17:48.85,0:17:50.24,Main,,0,0,0,,Бір күні қайтып кел.
Dialogue: 0,00:17:49.06,00:17:51.19,JPN TOP,,0,0,0,,Иә, өтінемін. (Арал) Қайта келіңізші.
Dialogue: 0,0:17:50.24,0:17:52.19,Main,,0,0,0,,Сізге тағы бір нәрсе керек пе?
Dialogue: 0,00:17:51.27,00:17:53.07,JPN TOP,,0,0,0,,Бірдеңе жетіспейді ме?
Dialogue: 0,00:17:53.15,00:17:53.98,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:18:00.23,0:18:01.56,Main,,0,0,0,,Кел де жуынып ал.
Dialogue: 0,00:18:01.33,00:18:02.58,JPN TOP,,0,0,0,,Рахмет
Dialogue: 0,0:18:02.07,0:18:03.39,Main,,0,0,0,,Міне, өтінемін!
Dialogue: 0,00:18:03.08,00:18:04.37,JPN TOP,,0,0,0,,Маған да беріңізші
Dialogue: 0,0:18:03.39,0:18:04.57,Main,,0,0,0,,Мен де алғым келеді!
Dialogue: 0,00:18:04.45,00:18:05.58,JPN TOP,,0,0,0,,Маған да беріңіз
Dialogue: 0,0:18:04.57,0:18:05.55,Main,,0,0,0,,Мен де!
Dialogue: 0,0:18:05.55,0:18:06.96,Main,,0,0,0,,Маған он керек!
Dialogue: 0,00:18:05.66,00:18:06.54,JPN TOP,,0,0,0,,Мен де!
Dialogue: 0,00:18:06.62,00:18:07.92,JPN TOP,,0,0,0,,Маған 10 дана керек
Dialogue: 0,0:18:19.49,0:18:21.86,Main,,0,0,0,,Ал, мен қазір кетейін.
Dialogue: 0,00:18:20.55,00:18:22.81,JPN TOP,,0,0,0,,Олай болса, кететін уақыт келді.
Dialogue: 0,0:18:22.27,0:18:24.47,Main,,0,0,0,,Жарайды. Өз-өзіңді күт.
Dialogue: 0,00:18:23.35,00:18:25.72,JPN TOP,,0,0,0,,Иә, абай болыңыз
Dialogue: 0,0:18:26.07,0:18:28.84,Main,,0,0,0,,Сіз бұл ханымды шынымен қабылдайсыз ба?
Dialogue: 0,00:18:27.18,00:18:29.98,JPN TOP,,0,0,0,,Сіз бұл адаммен баратыныңызға сенімдісіз бе?
Dialogue: 0,0:18:29.79,0:18:30.53,Main,,0,0,0,,Оқу, оқу
Dialogue: 0,00:18:30.85,00:18:33.19,JPN TOP,,0,0,0,,Иә... бәрібір.
Dialogue: 0,0:18:31.06,0:18:32.07,Main,,0,0,0,,Ято ақша әкелмейтіндіктен, жартылай жұмыс, жартылай жұмыс.
Dialogue: 0,0:18:32.66,0:18:38.84,Main,,0,0,0,,Мен Хаясаның адамдары оны іздеп жүріп сенің соңынан келе ме деп көбірек уайымдап отырмын.
Dialogue: 0,00:18:33.86,00:18:37.19,JPN TOP,,0,0,0,,Одан да Хаясаны іздеген адамдар
Dialogue: 0,0:18:36.43,0:18:37.98,Main - Top,,0,0,0,,Хаясе-сама!
Dialogue: 0,00:18:37.28,00:18:39.07,JPN TOP,,0,0,0,,Хаясе-сама!
Dialogue: 0,00:18:37.28,00:18:40.07,JPN TOP,,0,0,0,,Екі адамды көздейтін шығар деп ойлаймын.
Dialogue: 0,0:18:37.98,0:18:39.99,Main - Top,,0,0,0,,Қайдасың?
Dialogue: 0,00:18:39.15,00:18:40.95,JPN TOP,,0,0,0,,Қайдасың!
Dialogue: 0,0:18:39.99,0:18:41.27,Main,,0,0,0,,Хаясе-сама!
Dialogue: 0,00:18:40.99,00:18:42.20,JPN TOP,,0,0,0,,Хаясе-сама!
Dialogue: 0,0:18:41.52,0:18:42.83,Main,,0,0,0,,Кім біледі?
Dialogue: 0,00:18:42.28,00:18:43.95,JPN TOP,,0,0,0,,Ал...
Dialogue: 0,0:18:43.68,0:18:45.28,Main,,0,0,0,,Бірақ алаңдамаңыз.
Dialogue: 0,00:18:44.79,00:18:46.37,JPN TOP,,0,0,0,,Бірақ уайымдамаңыз
Dialogue: 0,0:18:45.81,0:18:48.67,Main,,0,0,0,,Біз сол әлсіздердің бізді алып кетуіне жол бермейміз.
Dialogue: 0,00:18:46.87,00:18:49.62,JPN TOP,,0,0,0,,Біз ол жігіттен ұтыла алмаймыз.
Dialogue: 0,0:18:49.40,0:18:52.59,Main,,0,0,0,,Енді біреу бізді таппай тұрып, жүре бер.
Dialogue: 0,00:18:50.46,00:18:53.79,JPN TOP,,0,0,0,,Жүр, кеттік, біреу келе жатыр.
Dialogue: 0,0:18:53.86,0:18:56.94,Main,,0,0,0,,Жарайды. Барлығы үшін рахмет.
Dialogue: 0,00:18:54.92,00:18:58.17,JPN TOP,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:18:57.54,0:18:58.72,Main,,0,0,0,,Қалай?
Dialogue: 0,00:18:58.67,00:19:02.59,JPN TOP,,0,0,0,,Келіңіздер ме? Біз ештеңе істеп жатқан жоқпыз...
Dialogue: 0,0:18:59.09,0:19:01.64,Main,,0,0,0,,Біз ештеңе істеген жоқпыз.
Dialogue: 0,00:19:03.55,00:19:04.97,JPN TOP,,0,0,0,,Эххе
Dialogue: 0,0:19:10.30,0:19:12.29,Main,,0,0,0,,Бір сәт те жоғалтуға болмайды.
Dialogue: 0,00:19:11.44,00:19:13.40,JPN TOP,,0,0,0,,Маңызы бар деп саналатын бір куәгерлік көрсету бар
Dialogue: 0,0:19:14.13,0:19:15.61,Main,,0,0,0,,Фуши-сан!
Dialogue: 0,00:19:15.27,00:19:18.82,JPN TOP,,0,0,0,,Сау болыңыз, Фуши мырза!
Dialogue: 0,0:19:15.61,0:19:17.62,Main,,0,0,0,,Аман болыңыз!
Dialogue: 0,0:19:18.61,0:19:24.84,Main,,0,0,0,,Фуши, мен сені бір күні көруім мүмкін!
Dialogue: 0,00:19:19.70,00:19:21.99,JPN TOP,,0,0,0,,Фуши! мен...
Dialogue: 0,00:19:22.07,00:19:26.29,JPN TOP,,0,0,0,,Бәлкім, бір күні сенімен кездесуге тағы баруым керек.
Dialogue: 0,0:19:25.35,0:19:26.67,Main,,0,0,0,,Әзіл.
Dialogue: 0,00:19:26.37,00:19:27.62,JPN TOP,,0,0,0,,Не деген сұмдық!
Dialogue: 0,0:19:30.26,0:19:33.79,Main,,0,0,0,,Лигард, онымен бірге бару керек.
Dialogue: 0,00:19:31.33,00:19:32.62,JPN TOP,,0,0,0,,Қарау
Dialogue: 0,00:19:32.71,00:19:34.84,JPN TOP,,0,0,0,,Оның соңынан еріңіз
Dialogue: 0,0:19:34.23,0:19:37.71,Main,,0,0,0,,Дүниеде әлдеқайда еркіндікке ие боласыз.
Dialogue: 0,00:19:35.34,00:19:38.88,JPN TOP,,0,0,0,,Басқа әлем мұндағыдан әлдеқайда еркін.
Dialogue: 0,0:19:38.48,0:19:42.57,Main,,0,0,0,,Бір күні мені оған жетеле.
Dialogue: 0,00:19:39.59,00:19:43.80,JPN TOP,,0,0,0,,Бір күні мені оның орнына апарыңыз.
Dialogue: 0,00:19:47.85,00:19:49.52,JPN TOP,,0,0,0,,(Регардтың айқайы)
Dialogue: 0,00:20:15.21,00:20:16.17,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,0:20:21.13,0:20:22.28,Main,,0,0,0,,Айтыңызшы.
Dialogue: 0,00:20:22.22,00:20:26.55,JPN TOP,,0,0,0,,Айтыңызшы, сіздің мақсатыңыз қандай?
Dialogue: 0,0:20:23.02,0:20:25.14,Main,,0,0,0,,Сіздің мақсатыңыз қандай?
Dialogue: 0,0:20:28.22,0:20:30.48,Main,,0,0,0,,Менің тілегім қарапайым.
Dialogue: 0,00:20:29.26,00:20:31.68,JPN TOP,,0,0,0,,Шағын тілек
Dialogue: 0,0:20:31.42,0:20:35.59,Main,,0,0,0,,Бұл сенің жаныңда болу.
Dialogue: 0,00:20:32.48,00:20:36.69,JPN TOP,,0,0,0,,Бұл... сенің жаныңда болу.
Dialogue: 0,0:20:37.27,0:20:42.75,Main,,0,0,0,,Ол үшін Март пен Паронаны өлтіру керек пе еді?!
Dialogue: 0,00:20:38.36,00:20:42.28,JPN TOP,,0,0,0,,Наурызды өлтіру керек пе еді!
Dialogue: 0,00:20:42.36,00:20:43.70,JPN TOP,,0,0,0,,Парона!
Dialogue: 0,0:20:43.71,0:20:46.86,Main,,0,0,0,,Сол қыздар сені өздері үшін ұстауға тырысты.
Dialogue: 0,00:20:44.78,00:20:47.78,JPN TOP,,0,0,0,,Ол балалар сізді монополиялайды
Dialogue: 0,0:20:46.86,0:20:50.08,Main,,0,0,0,,Олар сені менің қолымнан алмақ болды.
Dialogue: 0,00:20:47.87,00:20:51.37,JPN TOP,,0,0,0,,Себебі мен сені жанымнан алмақ болдым...
Dialogue: 0,0:20:50.76,0:20:52.01,Main,,0,0,0,,Жер
Dialogue: 0,00:20:51.45,00:20:53.04,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:20:52.44,0:20:56.08,Main,,0,0,0,,Менің сезімімді түсінбейсің бе?
Dialogue: 0,00:20:53.54,00:20:57.38,JPN TOP,,0,0,0,,Менің сезімімді түсінбейсің бе?
Dialogue: 0,0:20:57.84,0:21:00.23,Main,,0,0,0,,Мен саған ғашықпын.
Dialogue: 0,00:20:58.96,00:21:01.38,JPN TOP,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:21:00.91,0:21:04.31,Main,,0,0,0,,Мен сені кездестірген күннен бастап.
Dialogue: 0,00:21:02.01,00:21:05.26,JPN TOP,,0,0,0,,Біз алғаш танысқаннан бері
Dialogue: 0,00:21:06.93,00:21:08.18,JPN TOP,,0,0,0,,Әй?
Dialogue: 0,0:21:08.41,0:21:10.13,Main,,0,0,0,,Бейшара сен.
Dialogue: 0,00:21:09.55,00:21:13.98,JPN TOP,,0,0,0,,Бейшара... махаббатты білмейсің.
Dialogue: 0,0:21:10.70,0:21:12.78,Main,,0,0,0,,Сен махаббатты білмейсің ғой?
Dialogue: 0,0:21:14.50,0:21:16.32,Main,,0,0,0,,Маған аз ғана уақыт керек.
Dialogue: 0,00:21:15.60,00:21:17.40,JPN TOP,,0,0,0,,Бір сәтке...
Dialogue: 0,0:21:16.79,0:21:23.80,Main,,0,0,0,,Егер бір түнге өзіңді сыйласаң, мен саған махаббатты үйретер едім.
Dialogue: 0,00:21:17.90,00:21:21.86,JPN TOP,,0,0,0,,Бір түнге өзіңді сеніп тапсырсаң
Dialogue: 0,00:21:22.36,00:21:24.74,JPN TOP,,0,0,0,,Мен саған махаббатты үйретер едім
Dialogue: 0,00:21:24.82,00:21:25.70,JPN TOP,,0,0,0,,Уф
Dialogue: 0,0:21:28.19,0:21:30.69,Main,,0,0,0,,Өтінемін, мені өлтірші, Фуши.
Dialogue: 0,00:21:29.28,00:21:31.74,JPN TOP,,0,0,0,,Өтінемін, мені Фуши өлтіріңіз
Dialogue: 0,0:21:31.18,0:21:35.02,Main,,0,0,0,,Мен сені өлтіргім келеді.
Dialogue: 0,00:21:32.24,00:21:35.96,JPN TOP,,0,0,0,,Мен... Мені өлтіргеніңді қалаймын.
Dialogue: 0,0:21:36.08,0:21:39.99,Main,,0,0,0,,Сонда біз бір боламыз.
Dialogue: 0,00:21:37.17,00:21:41.42,JPN TOP,,0,0,0,,Сонда біз бір бола аламыз, солай ма?
Dialogue: 0,0:21:41.33,0:21:46.23,Main,,0,0,0,,Өтінемін, мені өлтіріп, мен бол.
Dialogue: 0,00:21:42.42,00:21:43.46,JPN TOP,,0,0,0,,Эй
Dialogue: 0,00:21:44.17,00:21:47.18,JPN TOP,,0,0,0,,Мені өлтіріп, мен бол
Dialogue: 0,0:21:47.26,0:21:51.17,Main,,0,0,0,,Мен сенде бар адамдардан күштімін.
Dialogue: 0,00:21:48.39,00:21:52.26,JPN TOP,,0,0,0,,Мен сенде бар кез келген адамнан күштімін
Dialogue: 0,0:21:51.78,0:21:54.81,Main,,0,0,0,,Жақсы ма? Бұл қызықты емес пе?
Dialogue: 0,00:21:52.89,00:21:55.93,JPN TOP,,0,0,0,,Дұрыс па? Бұл тартымды емес пе?
Dialogue: 0,0:22:10.60,0:22:12.60,Main,,0,0,0,,Барма, Фуши!
Dialogue: 0,00:22:11.66,00:22:13.95,JPN TOP,,0,0,0,,Барма, Фуши!
Dialogue: 0,0:22:12.95,0:22:15.40,Main,,0,0,0,,Мен саған керекпін!
Dialogue: 0,00:22:14.04,00:22:16.66,JPN TOP,,0,0,0,,Мен саған керекпін!
Dialogue: 0,0:22:16.22,0:22:19.50,Main,,0,0,0,,Мен қайда бара жатқаныма назар аудармадым, сондықтан қайда екенімізді білмеймін.
Dialogue: 0,00:22:17.33,00:22:20.58,JPN TOP,,0,0,0,,Мен кездейсоқ есумен айналыстым, сондықтан бұл қай жерде екенін білмеймін.
Dialogue: 0,0:22:19.96,0:22:23.30,Main,,0,0,0,,Өмір сүргің келсе, оны өзің анықта.
Dialogue: 0,00:22:21.08,00:22:24.55,JPN TOP,,0,0,0,,Егер сіз өмір сүргіңіз келсе, өзіңіз бір нәрсе жасаңыз.
Dialogue: 0,0:22:23.93,0:22:25.98,Main,,0,0,0,,Енді маған жақындама.
Dialogue: 0,00:22:25.05,00:22:26.92,JPN TOP,,0,0,0,,Енді маған жақындама
Dialogue: 0,0:22:27.00,0:22:27.99,Main,,0,0,0,,Фуши!
Dialogue: 0,00:22:28.09,00:22:29.22,JPN TOP,,0,0,0,,Фуши…
Dialogue: 0,0:22:30.05,0:22:32.04,Main,,0,0,0,,Мен сені жек көремін.
Dialogue: 0,00:22:31.18,00:22:35.68,JPN TOP,,0,0,0,,Мен сені жек көремін, сен өлсең бәрібір.
Dialogue: 0,0:22:32.50,0:22:34.73,Main,,0,0,0,,Өлсең де мен ештеңе сезбеймін.
Dialogue: 0,0:22:35.71,0:22:37.55,Main,,0,0,0,,Мен бұл туралы білемін.
Dialogue: 0,00:22:36.77,00:22:38.64,JPN TOP,,0,0,0,,Мен білемін
Dialogue: 0,00:22:44.32,00:22:49.70,JPN TOP,,0,0,0,,(Хаясаның ауыр тыныс алуы)
Dialogue: 0,00:22:53.70,00:22:55.70,JPN TOP,,0,0,0,,(Су дыбысы)
Dialogue: 0,00:23:05.25,00:23:07.55,JPN TOP,,0,0,0,,Ух...ха
Dialogue: 0,00:23:13.22,00:23:15.93,JPN TOP,,0,0,0,,(Хаясаның айқайы)
Dialogue: 0,0:23:32.94,0:23:34.39,Main,,0,0,0,,Ал, Фуши?
Dialogue: 0,00:23:34.03,00:23:36.03,JPN TOP,,0,0,0,,Қалай ойлайсың, Фуши?
Dialogue: 0,0:23:35.01,0:23:37.42,Main,,0,0,0,,Сізге Джананда ұнады ма?
Dialogue: 0,00:23:36.12,00:23:38.62,JPN TOP,,0,0,0,,Джананда көңілді болды ма?
Dialogue: 0,0:23:41.45,0:23:42.59,Main,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,00:23:42.54,00:23:43.67,JPN TOP,,0,0,0,,Келіңіздер...
Dialogue: 0,0:23:43.32,0:23:46.18,Main,,0,0,0,,Жағаға қалай жетуге болатынын айтыңызшы.
Dialogue: 0,00:23:44.38,00:23:47.13,JPN TOP,,0,0,0,,Оның орнына мені қонуға бағыттаңыз.
Dialogue: 0,00:23:49.34,00:23:50.26,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:23:51.52,0:23:54.48,Main,,0,0,0,,Лигард сізге жол көрсетуді ұсынды.
Dialogue: 0,00:23:52.59,00:23:55.64,JPN TOP,,0,0,0,,Регард сізге жол көрсететін сияқты.
Dialogue: 0,0:23:58.16,0:24:01.36,Italics,,0,0,0,,Басында мен әр күнді жек көретінмін.
Dialogue: 0,00:23:59.18,00:24:02.27,JPN TOP,,0,0,0,,Басында мен оны күнде жек көретінмін.
Dialogue: 0,0:24:01.36,0:24:04.46,Italics,,0,0,0,,Мен аралдан түсуге шыдадым.
Dialogue: 0,00:24:02.35,00:24:05.40,JPN TOP,,0,0,0,,Мен аралдан тезірек кеткім келді, бірақ қолымнан келмеді.
Dialogue: 0,0:24:05.37,0:24:06.39,Italics,,0,0,0,,Бірақ қазір,
Dialogue: 0,00:24:06.48,00:24:07.61,JPN TOP,,0,0,0,,(Иида) Турбо Герой Ингениумды білесің бе?
Dialogue: 0,0:24:09.17,0:24:10.66,Italics,,0,0,0,,Мен оны сәл сағындым.
Dialogue: 0,00:24:10.24,00:24:11.74,JPN TOP,,0,0,0,,Кішкене жалғыздық
Dialogue: 0,0:24:29.99,0:24:51.01,sign_35245_236_Preview,,0,0,0,,Алдын ала қарау
Dialogue: 0,0:24:31.35,0:24:36.03,Narration,,0,0,0,,Пиоран Фушиді көптен күтті.
Dialogue: 0,00:24:32.42,00:24:37.14,JPN TOP,,0,0,0,,Пиоран Фушиді көптен күтті.
Dialogue: 0,0:24:36.71,0:24:39.70,Narration,,0,0,0,,Ол бұрын талай рет үрейленсе де,
Dialogue: 0,00:24:38.01,00:24:41.68,JPN TOP,,0,0,0,,Фуши өз қауіпсіздігіне көп алаңдады.
Dialogue: 0,0:24:39.70,0:24:44.29,Narration,,0,0,0,,Фуши өмірін онымен өткізуді шешеді.
Dialogue: 0,00:24:42.23,00:24:45.48,JPN TOP,,0,0,0,,Мен онымен тұруды шештім.
Dialogue: 0,0:24:45.37,0:24:51.00,Narration,,0,0,0,,Олардың достық сапарлары мәңгілікке жалғасатын сияқты.
Dialogue: 0,00:24:46.40,00:24:51.94,JPN TOP,,0,0,0,,Екеуміздің достық сапарымыз мәңгілікке созылатындай көрінді.
Dialogue: 0,0:24:51.01,0:24:55.01,Episode_Title,,0,0,0,,Жаңғырық
Dialogue: 0,0:24:52.21,0:24:53.48,Narration,,0,0,0,,Дәл солай! Ицумида!
Dialogue: 0,00:24:53.20,00:24:54.65,JPN TOP,,0,0,0,,Және…
Dialogue: 0,0:24:56.51,0:25:02.51,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory