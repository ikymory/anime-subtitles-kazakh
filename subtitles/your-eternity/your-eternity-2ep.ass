Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.27,0:00:09.56,Narration,,0,0,0,,Оңтүстікке қарай жүрді.
Dialogue: 0,00:00:07.29,00:00:10.84,JPN TOP,,0,0,0,,Ол оңтүстікке қарай жүрді.
Dialogue: 0,0:00:10.47,0:00:15.57,Narration,,0,0,0,,Ол білім жинады және ынталандыру арқылы,
Dialogue: 0,00:00:11.51,00:00:13.93,JPN TOP,,0,0,0,,Ақпарат жинайды
Dialogue: 0,00:00:14.01,00:00:18.93,JPN TOP,,0,0,0,,Бұл ақпаратты ынталандыру арқылы қайталаңыз
Dialogue: 0,0:00:15.57,0:00:18.00,Narration,,0,0,0,,бұл ақпаратты қайталай алады.
Dialogue: 0,00:00:19.01,00:00:20.39,JPN TOP,,0,0,0,,(доптың құлаған дыбысы)
Dialogue: 0,0:00:20.76,0:00:21.85,Narration,,0,0,0,,Тас...
Dialogue: 0,00:00:21.85,00:00:23.06,JPN TOP,,0,0,0,,Тас…
Dialogue: 0,0:00:24.93,0:00:26.07,Narration,,0,0,0,,Қасқыр...
Dialogue: 0,00:00:26.02,00:00:27.40,JPN TOP,,0,0,0,,Қасқыр…
Dialogue: 0,0:00:27.74,0:00:29.33,Narration,,0,0,0,,Сосын, адам.
Dialogue: 0,00:00:28.77,00:00:30.69,JPN TOP,,0,0,0,,Және адамдар
Dialogue: 0,0:00:31.15,0:00:35.22,Narration,,0,0,0,,Ол адамды адам ететін нәрселердің ешқайсысына ие болмағандықтан,
Dialogue: 0,00:00:32.19,00:00:36.16,JPN TOP,,0,0,0,,Себебі оларда адам ететін ештеңе жоқ.
Dialogue: 0,0:00:35.51,0:00:40.21,Narration,,0,0,0,,ол өзін ластап, жеткілікті қоректік заттарды ала алмады.
Dialogue: 0,00:00:36.24,00:00:41.16,JPN TOP,,0,0,0,,Түбім тамшылап, тойып тамақ ала алмадым.
Dialogue: 0,0:00:41.57,0:00:44.71,Narration,,0,0,0,,Осылайша ол тез өлді.
Dialogue: 0,00:00:42.62,00:00:46.12,JPN TOP,,0,0,0,,Осылайша ол көп ұзамай қайтыс болды.
Dialogue: 0,0:00:46.66,0:00:51.94,Narration,,0,0,0,,Бұл объект үшін өлім тек күйдің өзгеруі болып табылады.
Dialogue: 0,00:00:47.71,00:00:53.34,JPN TOP,,0,0,0,,Бұл объект үшін өлім жай күйдің өзгеруі болып табылады.
Dialogue: 0,0:00:52.62,0:00:59.35,Narration,,0,0,0,,Ол осы уақытқа дейін алты рет өлді, бірақ күткендей, ол әр жолы жаңарды.
Dialogue: 0,00:00:53.42,00:00:56.34,JPN TOP,,0,0,0,,Мен осы уақытқа дейін алты рет өлдім.
Dialogue: 0,00:00:56.43,00:01:00.64,JPN TOP,,0,0,0,,Барлық ойнату функциялары дұрыс жұмыс істеді.
Dialogue: 0,0:01:00.09,0:01:04.18,Narration,,0,0,0,,Бірінші рет толық бес күн өтті,
Dialogue: 0,00:01:01.18,00:01:05.14,JPN TOP,,0,0,0,,Бірінші рет қалпына келтіруге 5 күн қажет болды.
Dialogue: 0,0:01:04.18,0:01:08.25,Narration,,0,0,0,,бірақ алтыншы рет оны шамамен он екі сағатта орындауға болады.
Dialogue: 0,00:01:05.23,00:01:09.19,JPN TOP,,0,0,0,,6-шы уақытта шамамен 12 сағат болды.
Dialogue: 0,0:01:10.46,0:01:13.25,Narration,,0,0,0,,Ауырсыну өсуге ықпал етеді.
Dialogue: 0,00:01:11.57,00:01:14.19,JPN TOP,,0,0,0,,Ауырсыну өсуге ықпал етеді
Dialogue: 0,0:01:13.74,0:01:15.67,Narration,,0,0,0,,Ешбір өлім босқа кетпейді.
Dialogue: 0,00:01:14.82,00:01:16.95,JPN TOP,,0,0,0,,Бос өлім жоқ.
Dialogue: 0,00:01:41.81,00:01:44.22,JPN TOP,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,00:01:51.23,00:01:52.73,JPN TOP,,0,0,0,,(Онигманың айқайы)
Dialogue: 0,0:01:57.36,0:01:58.90,Narration,,0,0,0,,Қайтадан өлді.
Dialogue: 0,00:01:58.24,00:02:00.28,JPN TOP,,0,0,0,,Тағы біреу қаза тапты.
Dialogue: 0,0:02:00.39,0:02:02.36,Narration,,0,0,0,,Бірақ бұл проблема емес еді.
Dialogue: 0,00:02:01.49,00:02:03.87,JPN TOP,,0,0,0,,Бірақ проблема жоқ
Dialogue: 0,00:02:04.99,00:02:09.79,JPN TOP,,0,0,0,,♪~
Dialogue: 0,00:03:29.91,00:03:34.92,JPN TOP,,0,0,0,,~♪
Dialogue: 0,0:03:35.48,0:03:38.62,Main,,0,0,0,,Мама, менің қарным қатты ашты, өліп қалуым мүмкін!
Dialogue: 0,00:03:35.59,00:03:39.55,JPN TOP,,0,0,0,,«Грр... мен аштан өліп жатырмын, мама».
Dialogue: 0,0:03:38.81,0:03:41.68,Main,,0,0,0,,Әй, Усадзиро, бейшара балақай!
Dialogue: 0,00:03:39.63,00:03:42.43,JPN TOP,,0,0,0,,Әй, қоянға жаным ашиды.
Dialogue: 0,0:03:41.68,0:03:43.95,Main,,0,0,0,,Мама саған бірден бірдеңе жасап береді.
Dialogue: 0,00:03:42.51,00:03:45.05,JPN TOP,,0,0,0,,Мама саған күріш жасап береді.
Dialogue: 0,0:03:44.21,0:03:46.12,Main,,0,0,0,,Міне, кеттіңіз. Тамақ іш.
Dialogue: 0,00:03:45.14,00:03:47.06,JPN TOP,,0,0,0,,Орындалды! Тамақ
Dialogue: 0,0:03:46.31,0:03:47.35,Main,,0,0,0,,Дәмді!
Dialogue: 0,00:03:47.14,00:03:50.89,JPN TOP,,0,0,0,,"Бұл дәмді. Анаң күткендей, сен жақсы аспазсың."
Dialogue: 0,0:03:47.35,0:03:48.37,Main,,0,0,0,,Рахмет, анашым!
Dialogue: 0,0:03:48.37,0:03:50.04,Main,,0,0,0,,Сіз тамақ дайындауға өте шеберсіз!
Dialogue: 0,0:03:50.04,0:03:52.51,Main,,0,0,0,,О, жаным, рахмет!
Dialogue: 0,00:03:50.98,00:03:53.98,JPN TOP,,0,0,0,,О, ау! Рахмет... Иә?
Dialogue: 0,0:03:51.22,0:03:52.77,Main,,0,0,0,,Құттықтаймыз, Ли.
Dialogue: 0,00:03:52.31,00:03:53.98,JPN TOP,,0,0,0,,Құттықтаймыз Ли
Dialogue: 0,0:03:53.03,0:03:55.25,Main,,0,0,0,,Сіз қазір толыққанды ересек адамсыз, иә?
Dialogue: 0,00:03:54.06,00:03:56.19,JPN TOP,,0,0,0,,Енді сіз ересек адамсыз.
Dialogue: 0,0:03:55.74,0:03:57.50,Main,,0,0,0,,Рахмет, әже.
Dialogue: 0,00:03:56.27,00:03:58.78,JPN TOP,,0,0,0,,Рахмет, әже
Dialogue: 0,00:03:58.86,00:03:59.69,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,00:04:05.28,00:04:06.66,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,0:04:07.42,0:04:09.51,Main,,0,0,0,,Наурыз не қарап тұрсың?
Dialogue: 0,00:04:08.03,00:04:10.37,JPN TOP,,0,0,0,,Наурызға не қарап тұрсың?
Dialogue: 0,00:04:10.45,00:04:11.33,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:04:10.63,0:04:11.63,Main,,0,0,0,,Та-да!
Dialogue: 0,0:04:11.63,0:04:12.81,Main,,0,0,0,,Қандай сәнсіз...
Dialogue: 0,00:04:11.91,00:04:13.75,JPN TOP,,0,0,0,,Сәлем! Бұл не?
Dialogue: 0,0:04:13.04,0:04:14.71,Main,,0,0,0,,Бізде тағы бала болды ма?!
Dialogue: 0,00:04:13.83,00:04:15.63,JPN TOP,,0,0,0,,Сіз дүниеге келдіңіз!
Dialogue: 0,0:04:14.89,0:04:15.84,Main,,0,0,0,,Өте талғампаз болма.
Dialogue: 0,00:04:15.71,00:04:18.17,JPN TOP,,0,0,0,,Иә, алтыншы ұлы Канитаро!
Dialogue: 0,0:04:15.84,0:04:17.64,Main,,0,0,0,,Біздің алтыншы баламыз Канитаро!
Dialogue: 0,0:04:18.25,0:04:20.59,Main,,0,0,0,,Мен басқа бала алғым келеді!
Dialogue: 0,00:04:18.25,00:04:21.42,JPN TOP,,0,0,0,,Уау, мен балалы болғым келді.
Dialogue: 0,0:04:20.59,0:04:22.93,Main,,0,0,0,,Енді біз сегіз адамнан тұратын отбасымыз!
Dialogue: 0,00:04:21.51,00:04:23.76,JPN TOP,,0,0,0,,Бұл сегіз адамнан тұратын отбасы.
Dialogue: 0,0:04:22.93,0:04:23.91,Main,,0,0,0,,Өте талғампаз болма.
Dialogue: 0,00:04:23.84,00:04:24.84,JPN TOP,,0,0,0,,That's right.
Dialogue: 0,0:04:24.26,0:04:27.33,Main,,0,0,0,,Міне, қымбаттым! Сізге алғыс айту үшін жасаған бұл мейрамды жеңіз!
Dialogue: 0,00:04:24.93,00:04:28.26,JPN TOP,,0,0,0,,Мереке үшін рахмет!
Dialogue: 0,0:04:27.51,0:04:29.33,Main,,0,0,0,,Уау, бұл дәмді көрінеді!
Dialogue: 0,00:04:28.35,00:04:30.27,JPN TOP,,0,0,0,,Уау! Дәмді көрінеді
Dialogue: 0,0:04:30.33,0:04:33.25,Main,,0,0,0,,Сіз әрқашан ең жақсы тағам жасайсыз, бал.
Dialogue: 0,00:04:31.39,00:04:33.85,JPN TOP,,0,0,0,,Сіз жасаған тағам ең жақсы.
Dialogue: 0,0:04:33.78,0:04:36.35,Main,,0,0,0,,Маған тұрмысқа шыққаныңызға қуанышты емессіз бе?
Dialogue: 0,00:04:33.94,00:04:37.27,JPN TOP,,0,0,0,,Ууууу, маған тұрмысқа шыққаныңа қуанышты емессің бе?
Dialogue: 0,0:04:36.79,0:04:38.46,Main,,0,0,0,,Тамақтану уақыты, наурыз.
Dialogue: 0,00:04:37.90,00:04:39.40,JPN TOP,,0,0,0,,Бұл тағам наурыз
Dialogue: 0,0:04:38.77,0:04:40.42,Main,,0,0,0,,Әке! Мама!
Dialogue: 0,00:04:39.98,00:04:41.36,JPN TOP,,0,0,0,,Әке! Анашым!
Dialogue: 0,0:04:40.64,0:04:42.86,Main,,0,0,0,,Қараңыз! Канитаро!
Dialogue: 0,00:04:41.44,00:04:43.49,JPN TOP,,0,0,0,,Қараңыз! Crab Taro!
Dialogue: 0,0:04:43.25,0:04:45.38,Main,,0,0,0,,Ол жаңасын жасады, солай ма? Өте жақсы.
Dialogue: 0,00:04:43.57,00:04:46.24,JPN TOP,,0,0,0,,Ой, бұл жаңа шығарма ма? Күшті.
Dialogue: 0,0:04:45.38,0:04:47.80,Main,,0,0,0,,Оған үнемі қамқорлық жасағаныңыз үшін рахмет, Парона-чан.
Dialogue: 0,00:04:46.32,00:04:48.74,JPN TOP,,0,0,0,,Бұл әрқашан жаман, Палона-чан.
Dialogue: 0,0:04:48.25,0:04:49.41,Main,,0,0,0,,Мүлде жоқ.
Dialogue: 0,00:04:49.37,00:04:53.25,JPN TOP,,0,0,0,,Жоқ, Наурызбен жүргенде мен өзімді тыныш сезінемін.
Dialogue: 0,0:04:49.41,0:04:52.32,Main,,0,0,0,,Наурыздың қасында болу мені жұбатады.
Dialogue: 0,0:04:57.14,0:05:02.39,Main,,0,0,0,,Әй, мама, мен қашан есейемін?
Dialogue: 0,00:04:58.21,00:04:59.63,JPN TOP,,0,0,0,,Сәлем анашым
Dialogue: 0,00:04:59.71,00:05:03.34,JPN TOP,,0,0,0,,Наурыз қашан ересек болады?
Dialogue: 0,0:05:02.69,0:05:04.52,Main,,0,0,0,,Бұл сұрақ тағы да?
Dialogue: 0,00:05:03.92,00:05:05.51,JPN TOP,,0,0,0,,Бұл сұрақ тағы да?
Dialogue: 0,0:05:04.52,0:05:07.70,Main,,0,0,0,,Төсекті сулауды тоқтатқаннан кейін, 3000 есе көп ұйықтаңыз.
Dialogue: 0,00:05:05.59,00:05:08.59,JPN TOP,,0,0,0,,Мен жыныс мүшесін жоғалтқаннан кейін 3000 рет ұйықтаған кезде
Dialogue: 0,0:05:07.70,0:05:09.04,Main,,0,0,0,,Мен саған үнемі айтамын.
Dialogue: 0,00:05:08.68,00:05:09.97,JPN TOP,,0,0,0,,Осыны айтып тұрсыз.
Dialogue: 0,0:05:09.04,0:05:10.78,Main,,0,0,0,,Мен көп күте алмаймын!
Dialogue: 0,00:05:10.05,00:05:11.68,JPN TOP,,0,0,0,,Мен көп күте алмаймын!
Dialogue: 0,0:05:10.78,0:05:13.91,Main,,0,0,0,,Мен ана болу үшін өскім келеді!
Dialogue: 0,00:05:11.76,00:05:14.85,JPN TOP,,0,0,0,,Мен тезірек өсіп, ана атанғым келеді.
Dialogue: 0,0:05:13.91,0:05:17.68,Main,,0,0,0,,Сіз білесіз бе? Көрші үйдегі Ли Чан енді бала емес!
Dialogue: 0,00:05:14.93,00:05:18.48,JPN TOP,,0,0,0,,Сіз білесіз бе? Көрші үйдегі Ли Чан енді бала емеспін дейді!
Dialogue: 0,0:05:17.68,0:05:19.86,Main,,0,0,0,,Олар оның бетінен сияны алып тастады!
Dialogue: 0,00:05:18.56,00:05:20.73,JPN TOP,,0,0,0,,Бетімнен сия жойылды.
Dialogue: 0,0:05:19.86,0:05:23.96,Main,,0,0,0,,Бұл ауылда жалғыз бала мен, Лиза және кішкентай Лалах қалды!
Dialogue: 0,00:05:20.82,00:05:24.78,JPN TOP,,0,0,0,,Бұл ауылдың жалғыз балалары - Март, Лиза және кішкентай Лала.
Dialogue: 0,0:05:23.96,0:05:25.67,Main,,0,0,0,,Бұл өте масқара!
Dialogue: 0,00:05:24.86,00:05:26.61,JPN TOP,,0,0,0,,Немесе енді ғана көшіп келген жаңа көрші — әрине, менде ешқандай түсінік жоқ
Dialogue: 0,0:05:25.91,0:05:27.20,Main,,0,0,0,,Міне, сонда, Лиза.
Dialogue: 0,00:05:26.70,00:05:30.78,JPN TOP,,0,0,0,,Қай Лиза? Келесі жолы әпкең саған кеудесін береді.
Dialogue: 0,0:05:27.20,0:05:29.90,Main,,0,0,0,,Маған сүтімнен тамақ берейін.
Dialogue: 0,0:05:29.90,0:05:31.38,Main,,0,0,0,,Мұны тоқтатыңыз.
Dialogue: 0,00:05:30.87,00:05:32.29,JPN TOP,,0,0,0,,Тоқта
Dialogue: 0,0:05:31.38,0:05:33.69,Main,,0,0,0,,Наурыз айы сырымды айтайын.
Dialogue: 0,00:05:32.37,00:05:34.37,JPN TOP,,0,0,0,,Мен саған жақсы нәрсе айтайын, наурыз
Dialogue: 0,00:05:34.45,00:05:35.29,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:05:34.55,0:05:38.81,Main,,0,0,0,,Енді тыңдаңыз. Өзіңді ұстамасаң үлкен бола алмайсың.
Dialogue: 0,00:05:35.37,00:05:39.79,JPN TOP,,0,0,0,,Тыңда, үндемесең өспейсің.
Dialogue: 0,0:05:38.81,0:05:40.23,Main,,0,0,0,,Өскенше үндеме!
Dialogue: 0,00:05:39.88,00:05:41.17,JPN TOP,,0,0,0,,Тек «ересектерге»
Dialogue: 0,0:05:40.48,0:05:43.77,Main,,0,0,0,,Не?! Бұл өте ақымақ!
Dialogue: 0,00:05:41.25,00:05:44.71,JPN TOP,,0,0,0,,Бұл не! Мен оны түсінбеймін
Dialogue: 0,00:05:44.80,00:05:47.47,JPN TOP,,0,0,0,,Хм
Dialogue: 0,0:05:46.53,0:05:50.53,Episode_Title,,0,0,0,,Қатты қыз
Dialogue: 0,00:05:52.06,00:05:54.97,JPN TOP,,0,0,0,,(Құстар әні)
Dialogue: 0,00:06:04.78,00:06:05.94,JPN TOP,,0,0,0,,(Құстар әні)
Dialogue: 0,00:06:12.91,00:06:14.12,JPN TOP,,0,0,0,,Я...
Dialogue: 0,0:06:13.15,0:06:16.55,Main,,0,0,0,,Ол садақ саған тым күшті және ауыр.
Dialogue: 0,00:06:14.20,00:06:17.50,JPN TOP,,0,0,0,,Ол садақ саған тым ауыр және күшті.
Dialogue: 0,0:06:16.55,0:06:19.11,Main,,0,0,0,,Уайымдамаңыз. Ақыр соңында сіз оны жақсырақ аласыз.
Dialogue: 0,00:06:17.58,00:06:20.00,JPN TOP,,0,0,0,,Жарайды! Бір күні мен сауығып кетемін
Dialogue: 0,0:06:19.11,0:06:20.96,Main,,0,0,0,,Біз сізге көмектесеміз.
Dialogue: 0,00:06:20.08,00:06:23.38,JPN TOP,,0,0,0,,Біз де ынтымақтасамыз, ендеше көп жаттығу жасайық.
Dialogue: 0,0:06:20.96,0:06:22.45,Main,,0,0,0,,Онда ілініп, жаттығуды жалғастырайық.
Dialogue: 0,0:06:24.62,0:06:25.85,Main,,0,0,0,,Хиёри, қош келдің.
Dialogue: 0,00:06:25.71,00:06:27.26,JPN TOP,,0,0,0,,Рахмет
Dialogue: 0,0:06:26.32,0:06:27.82,Main,,0,0,0,,Әй, әке қайда?
Dialogue: 0,00:06:27.34,00:06:29.72,JPN TOP,,0,0,0,,Әй, әке ше? Әке ше?
Dialogue: 0,0:06:27.82,0:06:28.77,Main,,0,0,0,,Әкем қайда?
Dialogue: 0,0:06:28.95,0:06:31.36,Main,,0,0,0,,Әкем жұмыстан бос емес.
Dialogue: 0,00:06:29.80,00:06:32.22,JPN TOP,,0,0,0,,Әкем жұмыста.
Dialogue: 0,0:06:31.36,0:06:32.80,Main,,0,0,0,,Әй, бірақ...
Dialogue: 0,00:06:32.30,00:06:33.76,JPN TOP,,0,0,0,,Жақсы, бірақ...
Dialogue: 0,0:06:32.80,0:06:34.34,Main,,0,0,0,,Енді өзімшіл болма!
Dialogue: 0,00:06:33.85,00:06:35.26,JPN TOP,,0,0,0,,Эгоизм жоқ
Dialogue: 0,00:06:35.85,00:06:39.27,JPN TOP,,0,0,0,,(жартылай қоңырау сияқты)
Dialogue: 0,00:06:39.85,00:06:42.77,JPN TOP,,0,0,0,,Иә? Қызық, бұл не дыбыс?
Dialogue: 0,0:06:39.86,0:06:41.84,Main,,0,0,0,,Бұл ненің дыбысы?
Dialogue: 0,0:06:41.84,0:06:43.38,Main,,0,0,0,,Тик-так, сағат тілі тик-так
Dialogue: 0,00:06:42.86,00:06:44.32,JPN TOP,,0,0,0,,«Мен білмеймін»
Dialogue: 0,0:06:43.38,0:06:44.40,Main,,0,0,0,,наурыз!
Dialogue: 0,00:06:44.40,00:06:45.86,JPN TOP,,0,0,0,,наурыз! (Наурыз) Иә?
Dialogue: 0,00:06:45.94,00:06:47.86,JPN TOP,,0,0,0,,Хахаха...
Dialogue: 0,0:06:47.76,0:06:49.46,Main,,0,0,0,,Сиси!
Dialogue: 0,00:06:48.78,00:06:50.61,JPN TOP,,0,0,0,,Сәлем!
Dialogue: 0,0:06:51.46,0:06:52.90,Main,,0,0,0,,Біз қайда барамыз?
Dialogue: 0,00:06:52.53,00:06:54.12,JPN TOP,,0,0,0,,Осы жолы сен жұмсаған күшіңе сай нәтижеге қол жеткіздің—
Dialogue: 0,0:06:53.54,0:06:55.42,Main,,0,0,0,,Мен жақсы жер таптым.
Dialogue: 0,00:06:54.70,00:06:58.29,JPN TOP,,0,0,0,,Мен жақсы жер таптым. Бүгін сонда ойнайық.
Dialogue: 0,0:06:55.42,0:06:57.34,Main,,0,0,0,,Бүгін сонда ойынға барайық.
Dialogue: 0,0:06:57.34,0:06:59.18,Main,,0,0,0,,Сіз не істеп жатыр деп ойлайсыз?
Dialogue: 0,00:06:58.37,00:07:00.37,JPN TOP,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,00:07:08.88,00:07:09.88,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,0:07:09.37,0:07:11.80,Main,,0,0,0,,Анау қыз ауылдан емес пе?
Dialogue: 0,00:07:10.43,00:07:12.76,JPN TOP,,0,0,0,,Бұл ауылдың қызы емес пе?
Dialogue: 0,0:07:11.80,0:07:14.48,Main,,0,0,0,,Сіз жиналу туралы бұйрықты естіген жоқсыз ба?
Dialogue: 0,00:07:12.84,00:07:15.43,JPN TOP,,0,0,0,,Сіз жиналу туралы бұйрықты естіген жоқсыз ба?
Dialogue: 0,00:07:15.51,00:07:17.64,JPN TOP,,0,0,0,,Уф... уф
Dialogue: 0,00:07:17.72,00:07:18.68,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:07:18.17,0:07:20.49,Main,,0,0,0,,Қуаныңыз, бәріңіз.
Dialogue: 0,00:07:19.27,00:07:21.44,JPN TOP,,0,0,0,,Барлығыңыз қуаныңыздар.
Dialogue: 0,0:07:20.84,0:07:24.26,Main,,0,0,0,,Сіздің ауылыңызға биыл таңдау бақыты бұйырды.
Dialogue: 0,00:07:22.02,00:07:25.19,JPN TOP,,0,0,0,,Биыл бұл ауыл бақытына орай таңдалды.
Dialogue: 0,0:07:24.57,0:07:28.37,Main,,0,0,0,,Бейбітшілік әкелуші құдай Онигума-самаға алғыс айту ырымы
Dialogue: 0,00:07:25.77,00:07:29.36,JPN TOP,,0,0,0,,Нинанна аймағына тыныштық пен гүлдену әкелетін құдай.
Dialogue: 0,0:07:28.37,0:07:30.77,Main,,0,0,0,,және Нинанна аймағына гүлдену,
Dialogue: 0,00:07:29.44,00:07:33.95,JPN TOP,,0,0,0,,Осы ауылда Онигма мырзаға алғыс айту рәсімі өтеді.
Dialogue: 0,0:07:30.77,0:07:33.02,Main,,0,0,0,,осы ауылда өтеді.
Dialogue: 0,0:07:33.34,0:07:36.52,Main,,0,0,0,,Дәстүрге сәйкес, біз, Яноме халқы,
Dialogue: 0,00:07:34.53,00:07:37.45,JPN TOP,,0,0,0,,Пәк қыз Онигма-самаға арналады
Dialogue: 0,00:07:34.53,00:07:37.45,JPN TOP,,0,0,0,,(Лизаны жұбататын дауыс)
Dialogue: 0,0:07:36.90,0:07:41.70,Main,,0,0,0,,Онигума-самаға ұсынатын дақсыз қызды таңдайды.
Dialogue: 0,00:07:38.04,00:07:40.25,JPN TOP,,0,0,0,,Таңдау дәстүр бойынша жүргізіледі.
Dialogue: 0,00:07:40.33,00:07:42.92,JPN TOP,,0,0,0,,Біз яномдық адамдар мұны істейміз.
Dialogue: 0,0:07:42.59,0:07:43.90,Main,,0,0,0,,Көрейік...
Dialogue: 0,00:07:43.00,00:07:45.17,JPN TOP,,0,0,0,,Иә? Қай...
Dialogue: 0,00:07:47.59,00:07:48.42,JPN TOP,,0,0,0,,Хмм…
Dialogue: 0,00:07:49.05,00:07:49.92,JPN TOP,,0,0,0,,Хмм…
Dialogue: 0,00:07:51.38,00:07:52.43,JPN TOP,,0,0,0,,Хяхаха…
Dialogue: 0,00:07:55.43,00:07:56.47,JPN TOP,,0,0,0,,Хмм…
Dialogue: 0,00:07:56.55,00:07:57.39,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,00:07:59.64,00:08:00.64,JPN TOP,,0,0,0,,Хехе
Dialogue: 0,00:08:02.73,00:08:03.64,JPN TOP,,0,0,0,,Хмм...
Dialogue: 0,00:08:09.23,00:08:11.15,JPN TOP,,0,0,0,,Ахаха
Dialogue: 0,00:08:11.74,00:08:12.65,JPN TOP,,0,0,0,,Хмм…
Dialogue: 0,0:08:12.66,0:08:14.41,Main,,0,0,0,,Мынау.
Dialogue: 0,00:08:13.74,00:08:15.66,JPN TOP,,0,0,0,,Бұл бала.
Dialogue: 0,0:08:15.73,0:08:17.09,Main,,0,0,0,,Наурыз құтты болсын!
Dialogue: 0,00:08:16.74,00:08:17.91,JPN TOP,,0,0,0,,Наурыз құтты болсын
Dialogue: 0,0:08:17.09,0:08:17.77,Main,,0,0,0,,Құттықтаймыз!
Dialogue: 0,0:08:17.77,0:08:18.81,Main,,0,0,0,,Құттықтаймыз!
Dialogue: 0,00:08:17.99,00:08:19.79,JPN TOP,,0,0,0,,Құттықтау Құттықтау
Dialogue: 0,0:08:18.81,0:08:20.22,Main,,0,0,0,,Кел де жуынып ал.
Dialogue: 0,00:08:19.87,00:08:21.29,JPN TOP,,0,0,0,,Рахмет
Dialogue: 0,0:08:20.22,0:08:21.92,Main,,0,0,0,,Кел де жуынып ал.
Dialogue: 0,00:08:21.37,00:08:22.87,JPN TOP,,0,0,0,,Рахмет
Dialogue: 0,0:08:22.48,0:08:25.32,Main,,0,0,0,,Олар мені неге құттықтап жатыр? Не болды?
Dialogue: 0,00:08:23.54,00:08:26.25,JPN TOP,,0,0,0,,«Құттықтаймын» дедіңіз бе?
Dialogue: 0,0:08:25.98,0:08:29.56,Main,,0,0,0,,Сіз үлкен құрметке сайланды.
Dialogue: 0,00:08:27.04,00:08:30.51,JPN TOP,,0,0,0,,Сіз үлкен құрметпен таңдалдыңыз.
Dialogue: 0,0:08:30.28,0:08:31.57,Main,,0,0,0,,Ар-намыс?
Dialogue: 0,00:08:31.38,00:08:33.01,JPN TOP,,0,0,0,,Мейо?
Dialogue: 0,00:08:33.67,00:08:35.13,JPN TOP,,0,0,0,,Эхехе…
Dialogue: 0,0:08:37.59,0:08:39.09,Main,,0,0,0,,Кешіріңіз, Наурыз!
Dialogue: 0,00:08:38.72,00:08:40.01,JPN TOP,,0,0,0,,Кешіріңіз наурыз
Dialogue: 0,00:08:40.10,00:08:43.18,JPN TOP,,0,0,0,,Не... Не болды, мама?
Dialogue: 0,0:08:40.24,0:08:42.26,Main,,0,0,0,,Не болды, мама?
Dialogue: 0,0:08:42.26,0:08:44.13,Main,,0,0,0,,Сен өлесің.
Dialogue: 0,00:08:43.27,00:08:46.98,JPN TOP,,0,0,0,,Сіз өлесіз, Марш мырза.
Dialogue: 0,0:08:45.03,0:08:46.03,Main,,0,0,0,,наурыз-сан.
Dialogue: 0,00:08:47.06,00:08:48.48,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:08:47.73,0:08:51.30,Main,,0,0,0,,Сіз Онигума-самаға құрбандыққа шалынасыз.
Dialogue: 0,00:08:48.56,00:08:52.24,JPN TOP,,0,0,0,,Бұл лорд Онигмаға ұсынылатын құрбандық болады.
Dialogue: 0,0:08:51.30,0:08:52.79,Main,,0,0,0,,Барлығымыз үшін.
Dialogue: 0,00:08:52.32,00:08:53.74,JPN TOP,,0,0,0,,Барлығына арналған
Dialogue: 0,0:08:53.52,0:08:55.30,Main,,0,0,0,,Құрбандыққа шалынды?
Dialogue: 0,00:08:54.57,00:08:56.24,JPN TOP,,0,0,0,,Құрбан шалу?
Dialogue: 0,0:08:55.54,0:08:58.22,Main,,0,0,0,,Менің атым Хаясе.
Dialogue: 0,00:08:56.32,00:08:59.12,JPN TOP,,0,0,0,,Менің атым Хаясе.
Dialogue: 0,0:08:58.62,0:09:03.89,Main,,0,0,0,,Маған ырым біткенше сізге қарау бұйырылды.
Dialogue: 0,00:08:59.66,00:09:01.95,JPN TOP,,0,0,0,,Ритуал аяқталғанша
Dialogue: 0,00:09:02.04,00:09:04.54,JPN TOP,,0,0,0,,Қамқоршы қызметін атқаруды бұйырды
Dialogue: 0,0:09:03.89,0:09:05.30,Main,,0,0,0,,Артқа жылжыңыз, өтінемін.
Dialogue: 0,00:09:04.62,00:09:06.29,JPN TOP,,0,0,0,,Аа, кетіңізші.
Dialogue: 0,0:09:05.30,0:09:07.39,Main,,0,0,0,,Ешбір еркек оған жақындамауы керек.
Dialogue: 0,00:09:06.37,00:09:08.33,JPN TOP,,0,0,0,,Ер адамдар жақындамауы керек
Dialogue: 0,0:09:07.99,0:09:10.61,Main,,0,0,0,,Біз оның дақ түсіруіне жол бермеуіміз керек.
Dialogue: 0,00:09:09.13,00:09:11.84,JPN TOP,,0,0,0,,Сіз лас заттарды тартпауыңыз керек.
Dialogue: 0,0:09:11.72,0:09:13.48,Main,,0,0,0,,Міне кесте.
Dialogue: 0,00:09:12.80,00:09:14.42,JPN TOP,,0,0,0,,Кестені хабарлаңыз
Dialogue: 0,0:09:14.23,0:09:18.30,Main,,0,0,0,,Біз кетер алдындағы күні ауылда ауызашар болады.
Dialogue: 0,00:09:15.26,00:09:19.35,JPN TOP,,0,0,0,,Ұшудан бір күн бұрын бүкіл ауыл той жасайды.
Dialogue: 0,0:09:18.78,0:09:22.65,Main,,0,0,0,,Осы уақытта отбасынан қоштасу сұралады.
Dialogue: 0,00:09:19.85,00:09:23.85,JPN TOP,,0,0,0,,Отбасы мүшелері, осы жерде қоштасуларыңызды сұраймыз.
Dialogue: 0,0:09:23.23,0:09:25.89,Main,,0,0,0,,Содан кейін біз тауға шығуға үш күн жұмсаймыз.
Dialogue: 0,00:09:24.43,00:09:26.94,JPN TOP,,0,0,0,,Тауға шығу үшін үш күн қажет.
Dialogue: 0,0:09:26.39,0:09:31.58,Main,,0,0,0,,Екеуің аман-есен саяхаттайтынымызға сенімді болыңдар.
Dialogue: 0,00:09:27.44,00:09:30.31,JPN TOP,,0,0,0,,Мен тиісті сақтық пен қауіпсіздікті сақтаймын.
Dialogue: 0,00:09:30.40,00:09:32.73,JPN TOP,,0,0,0,,Екеуің де тыныш жатыңдар.
Dialogue: 0,0:09:32.64,0:09:36.23,Main,,0,0,0,,Наурыз-сан тау басындағы құрбандық үстелінде ұйықтайды.
Dialogue: 0,00:09:33.73,00:09:37.66,JPN TOP,,0,0,0,,Мен Марш мырзаның таудағы құрбандық үстелінде ұйықтауын сұраймын.
Dialogue: 0,0:09:36.64,0:09:40.30,Main,,0,0,0,,Онигума-сама келгенше таудан қайтып ораламыз.
Dialogue: 0,00:09:37.74,00:09:41.24,JPN TOP,,0,0,0,,Онигма-саманы күтпей таудан төмен түстік.
Dialogue: 0,0:09:40.57,0:09:44.15,Main,,0,0,0,,Бір жылдан кейін құрбандық үстелінде қалған нәрсені аламыз
Dialogue: 0,00:09:41.83,00:09:45.12,JPN TOP,,0,0,0,,Бір жылдан кейін құрбандық үстелінде қалғандарды жинаңыз.
Dialogue: 0,0:09:44.15,0:09:46.02,Main,,0,0,0,,және оны ата-анасына үйге әкел.
Dialogue: 0,00:09:45.20,00:09:46.96,JPN TOP,,0,0,0,,Ата-анаңызға оралыңыз
Dialogue: 0,0:09:46.24,0:09:48.59,Main,,0,0,0,,Менің өлгім келмейді!
Dialogue: 0,00:09:47.04,00:09:49.54,JPN TOP,,0,0,0,,Наурыз Менің өлгім келмейді
Dialogue: 0,0:09:50.51,0:09:53.86,Main,,0,0,0,,Мен өлсем, үлкен адам бола алмаймын, солай ма?
Dialogue: 0,00:09:51.38,00:09:54.80,JPN TOP,,0,0,0,,Өлу ересек бола алмаймын деген сөз емес пе?
Dialogue: 0,0:09:54.54,0:09:55.85,Main,,0,0,0,,Бұл солай болар еді.
Dialogue: 0,00:09:55.59,00:09:56.80,JPN TOP,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:09:55.85,0:09:58.06,Main,,0,0,0,,Сондықтан мен өлгім келмейді!
Dialogue: 0,00:09:56.88,00:09:59.01,JPN TOP,,0,0,0,,Сондықтан өлгім келмейді
Dialogue: 0,0:09:58.61,0:10:00.16,Main,,0,0,0,,Бұл өкінішті.
Dialogue: 0,00:09:59.72,00:10:01.51,JPN TOP,,0,0,0,,Бұл ұят.
Dialogue: 0,00:10:02.35,00:10:03.31,JPN TOP,,0,0,0,,Ei
Dialogue: 0,0:10:02.54,0:10:05.29,Main,,0,0,0,,Маған не болатынын неге сен шешесің?!
Dialogue: 0,00:10:03.39,00:10:06.23,JPN TOP,,0,0,0,,Наурыз туралы неліктен шешім қабылдап жатырсыз?
Dialogue: 0,0:10:05.29,0:10:06.92,Main,,0,0,0,,Бұл дәстүр.
Dialogue: 0,00:10:06.31,00:10:07.85,JPN TOP,,0,0,0,,Бұл ереже.
Dialogue: 0,0:10:06.92,0:10:09.18,Main,,0,0,0,,Не?! Бұл мағынасы жоқ!
Dialogue: 0,00:10:07.94,00:10:10.10,JPN TOP,,0,0,0,,Иә? Мен оны түсінбеймін!
Dialogue: 0,0:10:09.18,0:10:10.46,Main,,0,0,0,,Жоқ! Жоқ! Жоқ!
Dialogue: 0,00:10:10.19,00:10:12.77,JPN TOP,,0,0,0,,Яда яда яда Менің өлгім келмейді
Dialogue: 0,0:10:10.46,0:10:11.84,Main,,0,0,0,,Ессіздік балалары 'ЖОҚ' жағын бөгеп, жояды
Dialogue: 0,0:10:11.84,0:10:14.60,Main,,0,0,0,,Мен неге өлуім керек?!
Dialogue: 0,00:10:12.86,00:10:15.53,JPN TOP,,0,0,0,,Наурыз неге өлуі керек?
Dialogue: 0,0:10:14.60,0:10:17.60,Main,,0,0,0,,Мен неге есеймеймін?!
Dialogue: 0,00:10:15.61,00:10:18.28,JPN TOP,,0,0,0,,Неліктен Наурыз ғана ересек бола алмайды?
Dialogue: 0,0:10:17.60,0:10:19.60,Main,,0,0,0,,Айтыңызшы! Неге?! Неге?! Неге?!
Dialogue: 0,00:10:18.36,00:10:19.99,JPN TOP,,0,0,0,,Эй неге неге неге...
Dialogue: 0,0:10:18.92,0:10:20.32,Main,,0,0,0,,наурыз!
Dialogue: 0,00:10:20.07,00:10:21.78,JPN TOP,,0,0,0,,наурыз!
Dialogue: 0,0:10:26.02,0:10:27.61,Main,,0,0,0,,Өзіңізді ұстаңыз.
Dialogue: 0,00:10:27.12,00:10:28.54,JPN TOP,,0,0,0,,Тыныш бол...
Dialogue: 0,0:10:38.30,0:10:39.86,Main,,0,0,0,,Наурыз-чан, мынаны же.
Dialogue: 0,00:10:39.34,00:10:40.84,JPN TOP,,0,0,0,,Марш-чан, мынаны ал
Dialogue: 0,0:10:39.86,0:10:41.10,Main,,0,0,0,,Мынаны да же.
Dialogue: 0,00:10:40.93,00:10:42.05,JPN TOP,,0,0,0,,Мұны да жеңіз
Dialogue: 0,0:10:44.19,0:10:45.37,Main,,0,0,0,,Лалах.
Dialogue: 0,00:10:45.31,00:10:46.31,JPN TOP,,0,0,0,,Лара
Dialogue: 0,0:10:45.66,0:10:47.87,Main,,0,0,0,,Мен мұны наурыз айында жасадым.
Dialogue: 0,00:10:46.39,00:10:48.81,JPN TOP,,0,0,0,,Наурыз Мен мұны жасадым.
Dialogue: 0,0:10:48.15,0:10:50.31,Main,,0,0,0,,Оны соңғы күні киіңіз.
Dialogue: 0,00:10:48.89,00:10:51.27,JPN TOP,,0,0,0,,Соңғы күні киілген
Dialogue: 0,0:10:50.31,0:10:51.38,Main,,0,0,0,,Хиёри, қош келдің.
Dialogue: 0,00:10:51.35,00:10:55.57,JPN TOP,,0,0,0,,Рахмет... Қолымнан келгеннің бәрін жасаймын.
Dialogue: 0,0:10:51.93,0:10:54.32,Main,,0,0,0,,Мен бар күшімді саламын.
Dialogue: 0,0:11:01.33,0:11:05.54,Main,,0,0,0,,Сіздің жұмысыңыз менің ваннаға барғанымды бақылау ма?
Dialogue: 0,00:11:02.41,00:11:06.45,JPN TOP,,0,0,0,,Сіздің жұмысыңыз наурыздағы дәретхананы бақылау ма?
Dialogue: 0,0:11:05.54,0:11:10.78,Main,,0,0,0,,Мен сізді таза күйде ұстау үшін соңғы күнге дейін бақылап отырамын.
Dialogue: 0,00:11:06.54,00:11:07.91,JPN TOP,,0,0,0,,Соңғы күнге дейін
Dialogue: 0,00:11:08.00,00:11:11.71,JPN TOP,,0,0,0,,Денсаулығыңыз жақсы болуы үшін мен сізді бақылап отырамын.
Dialogue: 0,0:11:11.14,0:11:13.28,Main,,0,0,0,,Менің қашып кетпеуімді қадағалап отырсың.
Dialogue: 0,00:11:12.29,00:11:14.21,JPN TOP,,0,0,0,,Мен қашып кетпес үшін сен маған қарап тұрсың.
Dialogue: 0,0:11:13.56,0:11:16.72,Main,,0,0,0,,Сізге ескертуге рұқсат етіңіз: егер сіз қашып кетсеңіз,
Dialogue: 0,00:11:14.29,00:11:17.76,JPN TOP,,0,0,0,,Қашып кетсең ескертемін
Dialogue: 0,0:11:16.72,0:11:18.77,Main,,0,0,0,,Лалах сенің орныңда өледі.
Dialogue: 0,00:11:17.84,00:11:19.72,JPN TOP,,0,0,0,,Оның орнына Лала өледі.
Dialogue: 0,0:11:19.31,0:11:20.90,Main,,0,0,0,,Ал егер Лалах қашып кетсе?
Dialogue: 0,00:11:20.38,00:11:21.84,JPN TOP,,0,0,0,,Лара қашып кетсе ше?
Dialogue: 0,0:11:21.44,0:11:23.87,Main,,0,0,0,,Қашып кете алмағанды ​​таңдаймыз.
Dialogue: 0,00:11:22.51,00:11:24.80,JPN TOP,,0,0,0,,Мен қаша алмайтын қызды таңдаймын.
Dialogue: 0,00:11:24.89,00:11:26.31,JPN TOP,,0,0,0,,(Лиза жылап жатыр)
Dialogue: 0,0:11:25.77,0:11:28.11,Main,,0,0,0,,О, қымбаттым. Не болды?
Dialogue: 0,00:11:26.39,00:11:29.06,JPN TOP,,0,0,0,,Әй, не болды?
Dialogue: 0,00:11:29.14,00:11:31.81,JPN TOP,,0,0,0,,(Лиза жылап жатыр)
Dialogue: 0,0:11:32.63,0:11:35.12,Main,,0,0,0,,Онда, сонда.
Dialogue: 0,00:11:33.65,00:11:36.07,JPN TOP,,0,0,0,,Жарайды, жарайды, иә.
Dialogue: 0,0:11:36.29,0:11:39.07,Main,,0,0,0,,Онда, сонда.
Dialogue: 0,00:11:37.40,00:11:40.28,JPN TOP,,0,0,0,,Жарайды, жарайды, жарайды...
Dialogue: 0,00:11:44.16,00:11:46.08,JPN TOP,,0,0,0,,(жылау)
Dialogue: 0,00:11:54.17,00:11:57.59,JPN TOP,,0,0,0,,(Ауыл тұрғындарының айқайы)
Dialogue: 0,0:12:25.38,0:12:27.93,Main,,0,0,0,,Сіз өте күшті болдыңыз.
Dialogue: 0,00:12:26.49,00:12:28.87,JPN TOP,,0,0,0,,Бүгінге дейін жақсы орындадың.
Dialogue: 0,00:12:29.45,00:12:30.37,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:12:29.62,0:12:31.81,Main,,0,0,0,,Сіз өзіңізді жақсы ұстайсыз.
Dialogue: 0,00:12:30.45,00:12:33.87,JPN TOP,,0,0,0,,Сіз мұны тыныш орындадыңыз, бұл таңғаларлық.
Dialogue: 0,0:12:31.81,0:12:32.94,Main,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:12:34.12,0:12:39.46,Main,,0,0,0,,Өлгеннен кейін дүниеде бостандық күтіп тұр деген аңыз бар.
Dialogue: 0,00:12:35.25,00:12:37.00,JPN TOP,,0,0,0,,Осындай аңыз бар.
Dialogue: 0,00:12:37.59,00:12:40.71,JPN TOP,,0,0,0,,Сіз өлгеннен кейін әлемде сізді бостандық күтеді.
Dialogue: 0,0:12:39.77,0:12:42.50,Main,,0,0,0,,Сіз кез келген нәрсені жасай аласыз және кез келген нәрсеге айнала аласыз.
Dialogue: 0,00:12:40.80,00:12:43.34,JPN TOP,,0,0,0,,Сіз кез келген нәрсені жасай аласыз және кез келген нәрсеге айнала аласыз.
Dialogue: 0,0:12:42.85,0:12:46.96,Main,,0,0,0,,Сіз мұнда бола алмаған ересек адам бола аласыз.
Dialogue: 0,00:12:43.84,00:12:47.89,JPN TOP,,0,0,0,,Сіз мұнда бола алмаған ересек адам бола аласыз.
Dialogue: 0,00:12:47.97,00:12:50.60,JPN TOP,,0,0,0,,Сен сияқты қорқақ не айтып тұрсың!
Dialogue: 0,00:13:01.48,00:13:03.15,JPN TOP,,0,0,0,,(атылған жебенің дыбысы)
Dialogue: 0,00:13:03.24,00:13:04.07,JPN TOP,,0,0,0,,Ах
Dialogue: 0,00:13:04.15,00:13:05.57,JPN TOP,,0,0,0,,О
Dialogue: 0,0:13:04.62,0:13:05.36,Main,,0,0,0,,Көрсеткі...
Dialogue: 0,00:13:05.65,00:13:06.57,JPN TOP,,0,0,0,,Көрсеткі…
Dialogue: 0,0:13:07.24,0:13:08.41,Main,,0,0,0,,Ол қашып кетті!
Dialogue: 0,00:13:07.24,00:13:08.07,JPN TOP,,0,0,0,,Ах
Dialogue: 0,00:13:08.16,00:13:09.58,JPN TOP,,0,0,0,,Ол қашып кетті!
Dialogue: 0,0:13:08.77,0:13:09.88,Main,,0,0,0,,Неге мен әлі де физикалық сезімдерді сезінемін?
Dialogue: 0,00:13:09.66,00:13:11.08,JPN TOP,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:13:13.46,0:13:14.69,Main,,0,0,0,,Хаясе-сама!
Dialogue: 0,00:13:14.58,00:13:15.75,JPN TOP,,0,0,0,,Хаясе-сама!
Dialogue: 0,0:13:15.51,0:13:16.48,Main,,0,0,0,,Наурыздан кейін!
Dialogue: 0,0:13:16.48,0:13:17.62,Main,,0,0,0,,Оны жоғалтпа!
Dialogue: 0,00:13:16.54,00:13:18.83,JPN TOP,,0,0,0,,Маршты қу, қашып кетпесін!
Dialogue: 0,00:13:19.50,00:13:21.42,JPN TOP,,0,0,0,,Хахаха...
Dialogue: 0,00:13:24.01,00:13:26.34,JPN TOP,,0,0,0,,Ах! Уаааааа
Dialogue: 0,00:13:29.30,00:13:30.26,JPN TOP,,0,0,0,,Уау
Dialogue: 0,0:13:37.04,0:13:38.11,Main,,0,0,0,,Ол жоғалып кетті ме?
Dialogue: 0,00:13:38.10,00:13:40.56,JPN TOP,,0,0,0,,Жоғалып кетті ме? Мына жаққа қара!
Dialogue: 0,0:13:38.11,0:13:39.26,Main,,0,0,0,,Сол жерден іздеңіз!
Dialogue: 0,0:13:39.65,0:13:40.58,Main,,0,0,0,,Ол мұнда жоқ!
Dialogue: 0,0:13:40.58,0:13:41.94,Main,,0,0,0,,Қаттырақ іздеңіз!
Dialogue: 0,00:13:40.65,00:13:43.36,JPN TOP,,0,0,0,,Ол жерде жоқ, мұқият іздеңіз.
Dialogue: 0,00:13:47.82,00:13:52.03,JPN TOP,,0,0,0,,Пухахахаха...
Dialogue: 0,0:13:56.85,0:13:58.82,Italics,,0,0,0,,Кешіріңіз, әке.
Dialogue: 0,00:13:57.92,00:14:00.17,JPN TOP,,0,0,0,,Кешіріңіз, әке.
Dialogue: 0,0:13:59.77,0:14:02.53,Italics,,0,0,0,,Мен өзімді ұстай алмадым.
Dialogue: 0,00:14:00.88,00:14:03.92,JPN TOP,,0,0,0,,Наурыз Мен үндемедім
Dialogue: 0,00:14:09.59,00:14:12.89,JPN TOP,,0,0,0,,Фу ха ха...
Dialogue: 0,00:14:12.97,00:14:14.27,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,00:14:16.10,00:14:17.77,JPN TOP,,0,0,0,,Иә?Ах...
Dialogue: 0,00:14:20.60,00:14:21.69,JPN TOP,,0,0,0,,13-ші мұғалімнің жаттығу тесті соңына дейін созылып кетті…
Dialogue: 0,00:14:30.53,00:14:31.62,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,0:14:34.42,0:14:35.98,Main,,0,0,0,,Міне, ол! Наурыз айы!
Dialogue: 0,00:14:35.54,00:14:36.91,JPN TOP,,0,0,0,,Наурыз!
Dialogue: 0,00:14:37.00,00:14:38.16,JPN TOP,,0,0,0,,(таңданған дауыс)
Dialogue: 0,0:14:39.93,0:14:41.30,Main,,0,0,0,,Бұл не?!
Dialogue: 0,00:14:40.75,00:14:42.13,JPN TOP,,0,0,0,,Бұл не!
Dialogue: 0,0:14:41.30,0:14:42.72,Main,,0,0,0,,W-Мені күт!
Dialogue: 0,00:14:42.21,00:14:43.67,JPN TOP,,0,0,0,,Уау... (Қызметші) Күте тұрыңыз.
Dialogue: 0,00:14:47.26,00:14:48.17,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,0:14:48.46,0:14:49.25,Main,,0,0,0,,Жер
Dialogue: 0,00:14:49.34,00:14:50.18,JPN TOP,,0,0,0,,Не?
Dialogue: 0,0:14:53.62,0:14:55.79,Main,,0,0,0,,Бұл не болып жатыр өзі?!
Dialogue: 0,00:14:54.76,00:14:56.93,JPN TOP,,0,0,0,,Бұл не?
Dialogue: 0,0:15:14.18,0:15:16.47,Main,,0,0,0,,Хиёри, мұнда жақынлама.
Dialogue: 0,00:15:14.99,00:15:17.41,JPN TOP,,0,0,0,,Ах... ой...
Dialogue: 0,00:15:19.54,00:15:20.96,JPN TOP,,0,0,0,,Сәлем!
Dialogue: 0,00:15:22.50,00:15:23.46,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,0:15:24.08,0:15:25.60,Main,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,00:15:25.13,00:15:26.92,JPN TOP,,0,0,0,,Осы жолы сен жұмсаған күшіңе сай нәтижеге қол жеткіздің—
Dialogue: 0,00:15:29.01,00:15:30.34,JPN TOP,,0,0,0,,Уау! Өте әдемі!
Dialogue: 0,0:15:30.92,0:15:33.19,Main,,0,0,0,,Мені өзіңізбен бірге алыңыз!
Dialogue: 0,00:15:31.97,00:15:34.60,JPN TOP,,0,0,0,,Наурызды да қабыл алыңыз!
Dialogue: 0,0:15:47.66,0:15:48.85,Main,,0,0,0,,Б... бір сызық
Dialogue: 0,00:15:48.73,00:15:53.11,JPN TOP,,0,0,0,,Мен көремін. Марш мырзаның өлімін қолдан жасауды ойладыңыз ба?
Dialogue: 0,0:15:49.14,0:15:52.19,Main,,0,0,0,,Сен Марш-санның өлімін жасақтайтын болдың.
Dialogue: 0,0:15:53.06,0:15:57.48,Main,,0,0,0,,Не істемекші болғаныңызды көріп тұрмын, бірақ бұл бала ойнап жүргендей болды.
Dialogue: 0,00:15:54.16,00:15:56.12,JPN TOP,,0,0,0,,Мен не істегім келетінін білемін, бірақ
Dialogue: 0,00:15:56.20,00:15:58.45,JPN TOP,,0,0,0,,Бұл ойнау сияқты болды.
Dialogue: 0,0:15:58.63,0:16:03.99,Main,,0,0,0,,Қате түсінбеңіз. Мен сені жазалайтын адам болмаймын.
Dialogue: 0,00:15:59.45,00:16:01.75,JPN TOP,,0,0,0,,Мені қате түсінбеңіз.
Dialogue: 0,00:16:02.25,00:16:05.00,JPN TOP,,0,0,0,,Сені жазалайтын мен емес.
Dialogue: 0,0:16:03.99,0:16:06.53,Main,,0,0,0,,Бұл сіздің Нинанна халқы болады.
Dialogue: 0,00:16:05.08,00:16:08.34,JPN TOP,,0,0,0,,Нинанна тұрғындары
Dialogue: 0,00:16:06.59,00:16:08.34,JPN TOP,,0,0,0,,(Шөптің тырмалаған дыбысы)
Dialogue: 0,00:16:08.42,00:16:10.97,JPN TOP,,0,0,0,,Хахаха...
Dialogue: 0,0:16:10.27,0:16:11.48,Main,,0,0,0,,Наурыз қайда?
Dialogue: 0,00:16:11.05,00:16:12.47,JPN TOP,,0,0,0,,наурыз?
Dialogue: 0,0:16:11.48,0:16:13.24,Main,,0,0,0,,Ал...
Dialogue: 0,00:16:12.55,00:16:14.18,JPN TOP,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:16:13.24,0:16:14.67,Main,,0,0,0,,Сіз оның кетуіне жол бердіңіз бе?
Dialogue: 0,00:16:14.26,00:16:15.59,JPN TOP,,0,0,0,,Сіз оның қашып кетуіне рұқсат еттіңіз бе?
Dialogue: 0,0:16:14.67,0:16:17.03,Main,,0,0,0,,Ауылға қайтайық, тағы бір қыз алайық.
Dialogue: 0,00:16:15.68,00:16:17.97,JPN TOP,,0,0,0,,Ауылға қайтайық, орнына бала әкелейік.
Dialogue: 0,0:16:17.03,0:16:19.93,Main,,0,0,0,,Біз оны өзімізді қорламай тұрып табамыз!
Dialogue: 0,00:16:18.06,00:16:20.89,JPN TOP,,0,0,0,,Өзіңді осылай ұятқа қалдырмас бұрын тауып ал!
Dialogue: 0,0:16:19.93,0:16:21.35,Main,,0,0,0,,Бірден іздеуге оралыңыз!
Dialogue: 0,00:16:20.98,00:16:22.27,JPN TOP,,0,0,0,,Мен қазір қайта іздеймін!
Dialogue: 0,0:16:21.54,0:16:23.00,Main,,0,0,0,,Жоқ! Күте тұрыңыз!
Dialogue: 0,00:16:22.35,00:16:23.89,JPN TOP,,0,0,0,,Жоқ, күте тұрыңыз!
Dialogue: 0,0:16:23.00,0:16:24.41,Main,,0,0,0,,Мына жерде құбыжық бар!
Dialogue: 0,00:16:23.98,00:16:25.94,JPN TOP,,0,0,0,,Құбыжық бар
Dialogue: 0,0:16:24.98,0:16:26.24,Main,,0,0,0,,Құбыжық?
Dialogue: 0,00:16:26.02,00:16:27.19,JPN TOP,,0,0,0,,Құбыжық?
Dialogue: 0,0:16:29.45,0:16:31.27,Main,,0,0,0,,Сіз кімсіз?
Dialogue: 0,00:16:30.28,00:16:32.19,JPN TOP,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:16:31.45,0:16:33.95,Main,,0,0,0,,Басында бос қауыз сияқты көріндің.
Dialogue: 0,00:16:32.28,00:16:34.95,JPN TOP,,0,0,0,,Алғашында қабық сияқты көріндің
Dialogue: 0,0:16:33.95,0:16:37.76,Main,,0,0,0,,Сосын бәрің қиналып, қайта тірілдің.
Dialogue: 0,00:16:35.03,00:16:38.70,JPN TOP,,0,0,0,,Қайта тірілгендей болды.
Dialogue: 0,0:16:37.95,0:16:43.23,Main,,0,0,0,,Бірде Сисси қатені басып, ол қайта жанданып, мені қорқытты.
Dialogue: 0,00:16:38.78,00:16:42.45,JPN TOP,,0,0,0,,Неене оны басқан кезде әлі тірі болатын қате болды.
Dialogue: 0,00:16:42.54,00:16:44.25,JPN TOP,,0,0,0,,Уау!
Dialogue: 0,0:16:43.23,0:16:48.81,Main,,0,0,0,,Бұл... у... в... имм... деп аталады емес пе?
Dialogue: 0,00:16:44.33,00:16:47.46,JPN TOP,,0,0,0,,Мен оның осындай нәрсе екеніне сенімдімін ...
Dialogue: 0,00:16:47.54,00:16:49.63,JPN TOP,,0,0,0,,Фуши… Фуджими…
Dialogue: 0,0:16:48.81,0:16:50.81,Main,,0,0,0,,Өлмейтін, солай ма?
Dialogue: 0,00:16:49.71,00:16:51.80,JPN TOP,,0,0,0,,Өлмейтіндік дейсіз бе?
Dialogue: 0,0:16:50.81,0:16:52.77,Main,,0,0,0,,Сисси маған сабақ берді.
Dialogue: 0,00:16:51.88,00:16:53.72,JPN TOP,,0,0,0,,Нене маған айтты
Dialogue: 0,0:16:55.79,0:16:58.26,Main,,0,0,0,,Айтпақшы, сен қайдан келдің?
Dialogue: 0,00:16:56.80,00:16:59.14,JPN TOP,,0,0,0,,Ойланып қарашы, қайдан келдің?
Dialogue: 0,0:16:58.26,0:17:01.78,Main,,0,0,0,,Нинанна емес, солай ма? Ал сіз Яномеден емес сияқтысыз...
Dialogue: 0,00:16:59.22,00:17:02.73,JPN TOP,,0,0,0,,Бұл Нинанна сияқты емес, Яноме сияқты емес...
Dialogue: 0,0:17:04.42,0:17:06.05,Main,,0,0,0,,Сенің атың кім?
Dialogue: 0,00:17:05.31,00:17:07.10,JPN TOP,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:17:06.05,0:17:08.29,Main,,0,0,0,,Менің маршымыз!
Dialogue: 0,00:17:07.19,00:17:09.23,JPN TOP,,0,0,0,,Менің атым Наурыз!
Dialogue: 0,0:17:10.83,0:17:13.00,Main,,0,0,0,,Hey! Бірдене айтыңыз!
Dialogue: 0,00:17:11.57,00:17:15.49,JPN TOP,,0,0,0,,Эй, маған бірдеңе деп жауап берші! Сіз сөйлей алмайсыз ба?
Dialogue: 0,0:17:13.00,0:17:14.75,Main,,0,0,0,,Сөйлеуді білмейсің бе?!
Dialogue: 0,00:17:15.57,00:17:16.74,JPN TOP,,0,0,0,,Ha
Dialogue: 0,00:17:23.58,00:17:25.08,JPN TOP,,0,0,0,,Иә?Ах...
Dialogue: 0,0:17:26.32,0:17:28.09,Main,,0,0,0,,Бұл жеміс тәтті көрінеді.
Dialogue: 0,00:17:27.17,00:17:29.54,JPN TOP,,0,0,0,,Тәтті жеміс
Dialogue: 0,0:17:28.50,0:17:31.85,Main,,0,0,0,,Иә, менің де қарным ашылып жатыр.
Dialogue: 0,00:17:28.83,00:17:30.59,JPN TOP,,0,0,0,,(Наурыз айындағы қарынның шуылдаған дыбысы)
Dialogue: 0,00:17:29.63,00:17:32.80,JPN TOP,,0,0,0,,Енді менің ішім бос...
Dialogue: 0,0:17:32.07,0:17:33.34,Main,,0,0,0,,Мен саған біраз алып беремін!
Dialogue: 0,00:17:32.88,00:17:34.21,JPN TOP,,0,0,0,,I'll take it!
Dialogue: 0,0:17:33.34,0:17:35.99,Main,,0,0,0,,Мұны маған қалдырыңыз! Мен жақсы альпинистпін!
Dialogue: 0,00:17:34.30,00:17:37.30,JPN TOP,,0,0,0,,Маған қалдырыңыз. Мен ағаштарға өрмелеуді жақсы көремін.
Dialogue: 0,0:17:37.32,0:17:38.10,Main,,0,0,0,,түн
Dialogue: 0,00:17:38.14,00:17:39.39,JPN TOP,,0,0,0,,Иә!
Dialogue: 0,00:17:42.68,00:17:43.97,JPN TOP,,0,0,0,,Уау
Dialogue: 0,00:17:45.68,00:17:48.60,JPN TOP,,0,0,0,,Уау... ә, бұл өтірік.
Dialogue: 0,0:17:46.44,0:17:47.66,Main,,0,0,0,,Сіз қалжыңдаған боларсыз...
Dialogue: 0,0:17:48.12,0:17:49.66,Main,,0,0,0,,You poor thing.
Dialogue: 0,00:17:49.19,00:17:53.23,JPN TOP,,0,0,0,,Бейшара бала, ата-анасы оны жөнге келтіре алмады.
Dialogue: 0,0:17:49.66,0:17:52.31,Main,,0,0,0,,Ата-анаң әдептілікке үйретпеген болуы керек.
Dialogue: 0,00:17:55.03,00:17:56.24,JPN TOP,,0,0,0,,Бұлп
Dialogue: 0,0:17:57.41,0:17:58.37,Main,,0,0,0,,Жер
Dialogue: 0,0:17:58.37,0:18:01.41,Main,,0,0,0,,Қолыңмен жейсің, осылай.
Dialogue: 0,00:17:58.45,00:18:02.33,JPN TOP,,0,0,0,,Қараңдар, қолдарыңмен ұстап жейсіңдер.
Dialogue: 0,00:18:02.41,00:18:03.24,JPN TOP,,0,0,0,,Уау!
Dialogue: 0,0:18:05.92,0:18:08.40,Main,,0,0,0,,Сіз сондай сұмдықсыз!
Dialogue: 0,00:18:07.16,00:18:09.33,JPN TOP,,0,0,0,,Ал, қандай адам!
Dialogue: 0,0:18:08.59,0:18:10.15,Main,,0,0,0,,Қатты жылау үшін...
Dialogue: 0,00:18:09.92,00:18:11.09,JPN TOP,,0,0,0,,Мүлдем емес...
Dialogue: 0,00:18:11.17,00:18:12.34,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,0:18:11.39,0:18:14.15,Main,,0,0,0,,Сіз ақымақсыз! Бұл менікі еді!
Dialogue: 0,00:18:12.42,00:18:15.09,JPN TOP,,0,0,0,,Наурыз болса да, сұмдық!
Dialogue: 0,0:18:14.31,0:18:15.90,Main,,0,0,0,,Ақыры заман мені қуып жетті ме?
Dialogue: 0,00:18:15.17,00:18:16.84,JPN TOP,,0,0,0,,Қазірдің өзінде...
Dialogue: 0,0:18:17.75,0:18:19.64,Main,,0,0,0,,Жоқ! Бұл менікі!
Dialogue: 0,00:18:18.88,00:18:21.10,JPN TOP,,0,0,0,,Жоқ, наурыз... Ах!
Dialogue: 0,00:18:24.93,00:18:26.60,JPN TOP,,0,0,0,,Хмм...
Dialogue: 0,00:18:26.68,00:18:30.35,JPN TOP,,0,0,0,,Мубааааааааааааа!
Dialogue: 0,00:18:30.44,00:18:33.36,JPN TOP,,0,0,0,,(Наурыздың жылаған дауысы)
Dialogue: 0,00:18:37.44,00:18:38.86,JPN TOP,,0,0,0,,Хахаха...
Dialogue: 0,00:18:40.28,00:18:41.87,JPN TOP,,0,0,0,,Хмм.
Dialogue: 0,00:18:48.50,00:18:49.71,JPN TOP,,0,0,0,,Хмм.
Dialogue: 0,00:19:00.34,00:19:02.05,JPN TOP,,0,0,0,,Hmph, hmph, hmph
Dialogue: 0,00:19:09.77,00:19:11.06,JPN TOP,,0,0,0,,
Dialogue: 0,0:19:22.00,0:19:24.44,Main,,0,0,0,,Сіз соншалықты аш болдыңыз ба?
Dialogue: 0,00:19:23.07,00:19:25.37,JPN TOP,,0,0,0,,сонша жегің келді ме?
Dialogue: 0,0:19:27.15,0:19:30.54,Main,,0,0,0,,Listen. Сіз танымайтын адам сізге жақсылық жасаса,
Dialogue: 0,00:19:28.16,00:19:31.50,JPN TOP,,0,0,0,,Жарайсың ба? Егер сіз танымайтын адам сізге мейірімді болса
Dialogue: 0,0:19:30.54,0:19:33.23,Main,,0,0,0,,«рахмет» деп айту керек, жарай ма?
Dialogue: 0,00:19:31.58,00:19:34.17,JPN TOP,,0,0,0,,Рахмет айтуым керек
Dialogue: 0,0:19:33.23,0:19:35.76,Main,,0,0,0,,Can you say that? Say "thank you."
Dialogue: 0,00:19:34.25,00:19:36.71,JPN TOP,,0,0,0,,Сіз айта аласыз ба? Қараңыз, «Рахмет» деп айтыңыз.
Dialogue: 0,0:19:40.92,0:19:45.73,Main,,0,0,0,,"Thank you."
Dialogue: 0,00:19:41.93,00:19:46.72,JPN TOP,,0,0,0,,“A… Ri… Ga… To… U”
Dialogue: 0,0:19:46.48,0:19:49.30,Main,,0,0,0,,Кел де жуынып ал.
Dialogue: 0,00:19:47.31,00:19:50.23,JPN TOP,,0,0,0,,(Студенттердің шуы)
Dialogue: 0,0:19:49.55,0:19:52.37,Main,,0,0,0,,Кел де жуынып ал.
Dialogue: 0,00:19:50.81,00:19:53.77,JPN TOP,,0,0,0,,(Студенттердің шуы)
Dialogue: 0,00:19:53.85,00:19:55.15,JPN TOP,,0,0,0,,Ах
Dialogue: 0,0:19:57.53,0:19:58.41,Main,,0,0,0,,Бір сәт те жоғалтуға болмайды.
Dialogue: 0,0:19:58.41,0:20:00.41,Main,,0,0,0,,Жай жүрме!
Dialogue: 0,00:19:58.57,00:20:01.82,JPN TOP,,0,0,0,,Сәлем! Жай барма
Dialogue: 0,00:20:02.99,00:20:04.53,JPN TOP,,0,0,0,,Хмм...
Dialogue: 0,0:20:15.40,0:20:16.58,Main,,0,0,0,,Сіз ұйықтайсыз ба?
Dialogue: 0,00:20:16.46,00:20:17.92,JPN TOP,,0,0,0,,Сіз ұйықтайсыз ба?
Dialogue: 0,0:20:17.42,0:20:18.52,Main,,0,0,0,,Та-да!
Dialogue: 0,00:20:18.42,00:20:19.96,JPN TOP,,0,0,0,,Эй
Dialogue: 0,00:20:23.55,00:20:26.01,JPN TOP,,0,0,0,,Mogumogu... Hmm
Dialogue: 0,00:20:27.26,00:20:31.18,JPN TOP,,0,0,0,,(Наурыз тынысы)
Dialogue: 0,0:20:35.91,0:20:37.65,Main,,0,0,0,,Анашым! Әке!
Dialogue: 0,00:20:36.94,00:20:40.36,JPN TOP,,0,0,0,,Анашым! Daddy! March is back
Dialogue: 0,0:20:37.65,0:20:39.42,Main,,0,0,0,,Мен үйдемін!
Dialogue: 0,0:20:40.09,0:20:41.32,Main,,0,0,0,,наурыз!
Dialogue: 0,00:20:41.24,00:20:42.49,JPN TOP,,0,0,0,,March
Dialogue: 0,00:20:42.57,00:20:44.07,JPN TOP,,0,0,0,,Ахаха
Dialogue: 0,00:20:44.57,00:20:48.62,JPN TOP,,0,0,0,,Huh? Лиза ше?
Dialogue: 0,0:20:44.64,0:20:45.49,Main,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:20:46.02,0:20:47.36,Main,,0,0,0,,Where's Lisa?
Dialogue: 0,00:21:09.97,00:21:11.77,JPN TOP,,0,0,0,,Ах
Dialogue: 0,00:21:12.56,00:21:13.39,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,0:21:13.82,0:21:16.88,Main,,0,0,0,,Бұл сен кінәлі, Наурыз.
Dialogue: 0,00:21:14.94,00:21:17.81,JPN TOP,,0,0,0,,Наурыз сен кінәлісің
Dialogue: 0,0:21:17.70,0:21:18.84,Main,,0,0,0,,Сиси...
Dialogue: 0,00:21:18.77,00:21:20.15,JPN TOP,,0,0,0,,Hey...
Dialogue: 0,0:21:20.09,0:21:24.13,Main,,0,0,0,,Олар сен қашып кеткендіктен құрбан болды.
Dialogue: 0,00:21:20.90,00:21:25.07,JPN TOP,,0,0,0,,Сен қашқаның үшін, Ол екеуі құрбан болды.
Dialogue: 0,00:21:29.41,00:21:30.41,JPN TOP,,0,0,0,,Ха!
Dialogue: 0,00:21:30.49,00:21:33.66,JPN TOP,,0,0,0,,Хахахахаха…
Dialogue: 0,00:21:34.66,00:21:38.13,JPN TOP,,0,0,0,,Уф...
Dialogue: 0,00:21:57.23,00:22:01.15,JPN TOP,,0,0,0,,(Құстар әні)
Dialogue: 0,00:22:05.19,00:22:06.15,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:22:06.71,0:22:09.73,Main,,0,0,0,,Не-Не болды? Неге мені аңдып жүрсің?
Dialogue: 0,00:22:07.82,00:22:10.66,JPN TOP,,0,0,0,,Не… не болды? Маған еріңіз
Dialogue: 0,00:22:16.50,00:22:17.41,JPN TOP,,0,0,0,,Хмм.
Dialogue: 0,00:22:32.47,00:22:33.68,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,00:22:39.14,00:22:40.19,JPN TOP,,0,0,0,,Уау! Өте әдемі!
Dialogue: 0,00:22:43.11,00:22:44.27,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,0:22:55.30,0:22:56.40,Main,,0,0,0,,Ақыры заман мені қуып жетті ме?
Dialogue: 0,00:22:56.33,00:23:00.96,JPN TOP,,0,0,0,,Already! Наурыз сенің анаң емес!
Dialogue: 0,0:22:56.40,0:22:59.73,Main,,0,0,0,,Мен сенің анаң емеспін, білесің бе!
Dialogue: 0,00:23:01.04,00:23:06.05,JPN TOP,,0,0,0,,♪~
Dialogue: 0,00:24:25.92,00:24:30.92,JPN TOP,,0,0,0,,~♪
Dialogue: 0,0:24:29.99,0:24:51.01,sign_35245_236_Preview,,0,0,0,,Preview
Dialogue: 0,0:24:30.38,0:24:37.52,Narration,,0,0,0,,Ештеңені білмейтін ұл, Ұлына аяулы анадай болған наурыз.
Dialogue: 0,00:24:31.51,00:24:33.93,JPN TOP,,0,0,0,,Ештеңені білмейтін баламен
Dialogue: 0,00:24:34.01,00:24:38.85,JPN TOP,,0,0,0,,Наурыз баласына сүйсінген анадай әрекет етеді
Dialogue: 0,0:24:38.05,0:24:41.74,Narration,,0,0,0,,Екеуі бірте-бірте өзара әрекеттеседі.
Dialogue: 0,00:24:38.93,00:24:42.18,JPN TOP,,0,0,0,,Екеуі бірте-бірте араласа бастайды.
Dialogue: 0,0:24:42.52,0:24:46.15,Narration,,0,0,0,,Парона наурызды құтқару үшін күреседі.
Dialogue: 0,00:24:43.60,00:24:47.69,JPN TOP,,0,0,0,,Парона наурыздың өмірін сақтап қалу үшін күреседі
Dialogue: 0,0:24:46.69,0:24:49.47,Narration,,0,0,0,,Хаясе наурызды тынымсыз қуады.
Dialogue: 0,00:24:47.77,00:24:49.94,JPN TOP,,0,0,0,,Хаясе тынымсыз қуады
Dialogue: 0,0:24:49.83,0:24:53.82,Narration,,0,0,0,,Ал үлкен көлеңке шығады.
Dialogue: 0,00:24:50.90,00:24:55.20,JPN TOP,,0,0,0,,Сосын үлкен көлеңке пайда болады...
Dialogue: 0,0:24:51.01,0:24:55.01,Episode_Title,,0,0,0,,Шағын эволюция
Dialogue: 0,0:24:56.70,0:25:02.70,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory