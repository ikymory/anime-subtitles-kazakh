Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.15,0:00:06.11,Narration,,0,0,0,,Яноме түрмесінен қашу
Dialogue: 0,00:00:04.17,00:00:07.42,JPN TOP,,0,0,0,,Яноме түрмесінен қашу
Dialogue: 0,0:00:08.26,0:00:12.05,Narration,,0,0,0,,күтпеген жағдайды тудырды.
Dialogue: 0,00:00:09.13,00:00:13.01,JPN TOP,,0,0,0,,Күтпеген жағдай туғызды
Dialogue: 0,0:00:15.91,0:00:17.84,Narration,,0,0,0,,Наурыздың өлімі.
Dialogue: 0,00:00:16.97,00:00:18.89,JPN TOP,,0,0,0,,Наурыздың өлімі
Dialogue: 0,0:00:18.92,0:00:24.03,Narration,,0,0,0,,Бұл Фуси куә болған екінші адам өлімі болды,
Dialogue: 0,00:00:19.97,00:00:24.98,JPN TOP,,0,0,0,,Бұл Фушидің екінші адам өлімі болды.
Dialogue: 0,0:00:25.91,0:00:29.44,Narration,,0,0,0,,және ол жаңа ынталандыру көзі болды.
Dialogue: 0,00:00:26.98,00:00:30.61,JPN TOP,,0,0,0,,Бұл сонымен қатар жаңа ынталандыруды алу болды.
Dialogue: 0,0:00:32.99,0:00:36.60,Narration,,0,0,0,,Осы анамен кездесуі арқылы Наурыз,
Dialogue: 0,00:00:34.07,00:00:37.74,JPN TOP,,0,0,0,,Наурыз атты анамен танысу арқылы
Dialogue: 0,0:00:37.89,0:00:41.26,Narration,,0,0,0,,Фуши барған сайын адамға ұқсайды.
Dialogue: 0,00:00:38.74,00:00:42.29,JPN TOP,,0,0,0,,Фуши аздап адамшылыққа ие болды.
Dialogue: 0,0:00:44.02,0:00:49.59,Narration,,0,0,0,,Оның иісі ғана қалды, ол жолға шықты.
Dialogue: 0,00:00:45.04,00:00:47.63,JPN TOP,,0,0,0,,Оның тұрақты хош иісінен кейін
Dialogue: 0,00:00:48.29,00:00:50.71,JPN TOP,,0,0,0,,Ол жүре бастады.
Dialogue: 0,00:00:54.05,00:00:58.85,JPN TOP,,0,0,0,,♪~
Dialogue: 0,00:02:18.93,00:02:23.93,JPN TOP,,0,0,0,,~♪
Dialogue: 0,00:02:25.64,00:02:26.77,JPN TOP,,0,0,0,,（）
Dialogue: 0,0:02:27.04,0:02:31.99,Narration,,0,0,0,,Фуши көбірек ынталандыру іздеп жүрді.
Dialogue: 0,00:02:28.10,00:02:32.94,JPN TOP,,0,0,0,,Фуши жүре берді, келесі ынталандыруды іздеді.
Dialogue: 0,0:02:32.77,0:02:36.50,Narration,,0,0,0,,Уақытының көп бөлігін қасқыр кейпінде өткізді.
Dialogue: 0,00:02:33.82,00:02:37.44,JPN TOP,,0,0,0,,Уақыттың көп бөлігін қасқыр түрінде өткізді.
Dialogue: 0,0:02:37.34,0:02:41.77,Narration,,0,0,0,,Бұл оның келесі баратын жерін иіс арқылы таңдауға көмектесті.
Dialogue: 0,00:02:38.40,00:02:42.70,JPN TOP,,0,0,0,,Себебі иіс келесі бағытты анықтайды.
Dialogue: 0,0:02:43.78,0:02:45.95,Narration,,0,0,0,,Бұл аю пішінін алған жоқ.
Dialogue: 0,00:02:44.87,00:02:47.12,JPN TOP,,0,0,0,,Аюға айналмады
Dialogue: 0,0:02:46.51,0:02:49.76,Narration,,0,0,0,,Бұл пішінде ол тынымсыз ауырсынуды сезінді.
Dialogue: 0,00:02:47.62,00:02:50.71,JPN TOP,,0,0,0,,Өйткені менің денем үнемі ауырады.
Dialogue: 0,0:02:52.26,0:02:54.17,Narration,,0,0,0,,Кейде ол баланың кейпін алды,
Dialogue: 0,00:02:53.38,00:02:55.88,JPN TOP,,0,0,0,,Кейде ұл болып кететінмін
Dialogue: 0,0:02:55.30,0:02:57.06,Narration,,0,0,0,,бірақ оған себеп аз болды.
Dialogue: 0,00:02:56.38,00:02:58.17,JPN TOP,,0,0,0,,Мағынасыз дерлік
Dialogue: 0,0:03:03.68,0:03:07.83,Narration,,0,0,0,,Қарны ашқанда наурыздың кейпіне енетін.
Dialogue: 0,00:03:04.76,00:03:09.02,JPN TOP,,0,0,0,,Қарны ашқанда наурыз кейпіне енеді.
Dialogue: 0,0:03:08.51,0:03:14.26,Narration,,0,0,0,,Осылайша ол жеміс ағаштарына оңай көтеріле алады.
Dialogue: 0,00:03:09.56,00:03:11.64,JPN TOP,,0,0,0,,Осы пішінді алған кезде
Dialogue: 0,00:03:11.73,00:03:15.57,JPN TOP,,0,0,0,,Жеміс ағашына сәтті шықты.
Dialogue: 0,00:03:21.15,00:03:21.99,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:03:21.23,0:03:26.62,Narration,,0,0,0,,Сосын таныс иіске тап болды.
Dialogue: 0,00:03:22.07,00:03:23.49,JPN TOP,,0,0,0,,Және…
Dialogue: 0,00:03:24.37,00:03:27.87,JPN TOP,,0,0,0,,Мен таныс иіске жеттім
Dialogue: 0,0:03:26.93,0:03:30.93,Episode_Title,,0,0,0,,Біздің мақсаттарымыз
Dialogue: 0,00:03:35.92,00:03:37.84,JPN TOP,,0,0,0,,(бұталардың дірілдеген дыбысы)
Dialogue: 0,00:03:40.51,00:03:41.34,JPN TOP,,0,0,0,,Ha
Dialogue: 0,0:03:43.44,0:03:45.71,Main,,0,0,0,,Сен тірісің бе?!
Dialogue: 0,00:03:43.80,00:03:46.80,JPN TOP,,0,0,0,,О... аман қалдың!
Dialogue: 0,0:03:46.28,0:03:48.71,Main,,0,0,0,,Сіз менің басымнан өткенімді білмейсіз!
Dialogue: 0,00:03:47.31,00:03:49.52,JPN TOP,,0,0,0,,Бұл қиын болуы керек!
Dialogue: 0,0:03:48.71,0:03:51.51,Main,,0,0,0,,Үш күн мен түн жоғалдым,
Dialogue: 0,00:03:49.60,00:03:52.27,JPN TOP,,0,0,0,,Үш күн, үш түн жалғыз өзім адасып қалдым.
Dialogue: 0,0:03:51.51,0:03:54.64,Main,,0,0,0,,Мен ауыл тұрғындарынан тірі қалу үшін тамақ сұрауға тура келді,
Dialogue: 0,00:03:52.35,00:03:55.52,JPN TOP,,0,0,0,,Жеке үйден тамақ алып, күн көр
Dialogue: 0,0:03:54.64,0:03:57.35,Main,,0,0,0,,Мен есектерге су бермек болдым, олар маған қарай қашып кетті,
Dialogue: 0,00:03:55.61,00:03:58.02,JPN TOP,,0,0,0,,Есекке су берейін десем, қашып кетті.
Dialogue: 0,0:03:57.35,0:03:59.99,Main,,0,0,0,,мен осы уақыттың бәрін осында, жаңбыр мен желден жасырып өткіздім!
Dialogue: 0,00:03:58.11,00:04:01.32,JPN TOP,,0,0,0,,Мен мұнда жаңбыр мен желден пана болдым ...
Dialogue: 0,00:04:01.40,00:04:02.28,JPN TOP,,0,0,0,,Ах
Dialogue: 0,0:04:01.65,0:04:05.17,Main,,0,0,0,,Әлгі қыз... Парона, солай ма? Ол сенімен бірге емес пе?
Dialogue: 0,00:04:02.78,00:04:06.12,JPN TOP,,0,0,0,,Парона деген қыз сенің жаныңда емес пе?
Dialogue: 0,0:04:05.17,0:04:07.74,Main,,0,0,0,,Ал мына құбыжық Фуши.
Dialogue: 0,00:04:06.20,00:04:08.99,JPN TOP,,0,0,0,,Ал Фуши деген құбыжық.
Dialogue: 0,0:04:08.62,0:04:10.64,Main,,0,0,0,,Әй, бірдеңе айт!
Dialogue: 0,00:04:09.70,00:04:11.58,JPN TOP,,0,0,0,,Әй, неге бірдеңе айтпайсың?
Dialogue: 0,00:04:19.46,00:04:20.96,JPN TOP,,0,0,0,,(дыбысты түрлендіру)
Dialogue: 0,0:04:20.02,0:04:22.80,Main,,0,0,0,,О, сіз болдыңыз ба?
Dialogue: 0,00:04:20.13,00:04:20.96,JPN TOP,,0,0,0,,Ha
Dialogue: 0,00:04:21.05,00:04:23.76,JPN TOP,,0,0,0,,Не, бұл сен бе?
Dialogue: 0,0:04:22.80,0:04:25.27,Main,,0,0,0,,Сіздің соншалықты тыныш болғаныңыз таңқаларлық емес.
Dialogue: 0,00:04:23.84,00:04:26.22,JPN TOP,,0,0,0,,Мен үндемейтін сияқтымын.
Dialogue: 0,00:04:29.14,00:04:30.18,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,0:04:29.63,0:04:34.52,Main,,0,0,0,,Қалай болғанда да, сіз мұнда жалғызсыз.
Dialogue: 0,00:04:30.77,00:04:35.48,JPN TOP,,0,0,0,,Қалай болғанда да, дәл қазір сен жалғызсың.
Dialogue: 0,0:04:36.30,0:04:38.04,Main,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,00:04:36.65,00:04:39.23,JPN TOP,,0,0,0,,Не? Қайда бара жатырсың?
Dialogue: 0,0:04:41.08,0:04:41.92,Main,,0,0,0,,Бір сәт те жоғалтуға болмайды.
Dialogue: 0,00:04:41.61,00:04:46.28,JPN TOP,,0,0,0,,Ей... Мен қарттарды жалғыз қалдыра алмаймын!
Dialogue: 0,0:04:42.30,0:04:45.14,Main,,0,0,0,,Ақсақалды жалғыз қалдырмаңыз!
Dialogue: 0,0:04:48.38,0:04:53.42,Main,,0,0,0,,Сенің не ойлап тұрғаныңды менде шамалы сезінбеймін.
Dialogue: 0,00:04:49.49,00:04:54.50,JPN TOP,,0,0,0,,Мен сенің не ойлап тұрғаныңды білмеймін.
Dialogue: 0,0:04:53.88,0:04:57.81,Main,,0,0,0,,Наурыз формасын кигенде сіздің басыңыздан не өтеді?
Dialogue: 0,00:04:55.00,00:04:59.17,JPN TOP,,0,0,0,,Наурызға ұқсағанда қандай сезімде боласың?
Dialogue: 0,0:04:58.19,0:05:03.85,Main,,0,0,0,,Құбыжықтарда сезім бар ма, әлде заттар туралы ойланады ма?
Dialogue: 0,00:04:59.25,00:05:02.34,JPN TOP,,0,0,0,,Тіпті құбыжықтардың да кейбір эмоциялары болады.
Dialogue: 0,00:05:02.42,00:05:04.88,JPN TOP,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:05:04.58,0:05:09.01,Main,,0,0,0,,Мен көремін, егер сіз мұны жасасаңыз, сізде оның ешқайсысын білдіруге мүмкіндік жоқ.
Dialogue: 0,00:05:05.38,00:05:08.59,JPN TOP,,0,0,0,,Айтуға амалы жоқтар
Dialogue: 0,00:05:08.68,00:05:10.10,JPN TOP,,0,0,0,,Оны көргенде білесің
Dialogue: 0,00:05:10.64,00:05:13.77,JPN TOP,,0,0,0,,Хааха... хаа...
Dialogue: 0,0:05:13.23,0:05:17.98,Main,,0,0,0,,Мен бір күні сіздің ойыңызға көз салғым келеді.
Dialogue: 0,00:05:14.27,00:05:18.10,JPN TOP,,0,0,0,,Бір күні сенің жүрегіңе үңгім келеді.
Dialogue: 0,00:05:18.19,00:05:19.81,JPN TOP,,0,0,0,,(Іштің ырылдаған дыбысы)
Dialogue: 0,0:05:19.03,0:05:21.50,Main,,0,0,0,,Менің қарным ашты...
Dialogue: 0,00:05:19.90,00:05:22.40,JPN TOP,,0,0,0,,Менің қарным ашты...
Dialogue: 0,0:05:21.50,0:05:24.30,Main,,0,0,0,,Екі күннен бері тамақ ішкен жоқпын.
Dialogue: 0,00:05:22.48,00:05:25.45,JPN TOP,,0,0,0,,Мен кешеден бері ештеңе жеген жоқпын.
Dialogue: 0,0:05:24.89,0:05:28.33,Main,,0,0,0,,Әй, бір дем алайық.
Dialogue: 0,00:05:25.95,00:05:29.45,JPN TOP,,0,0,0,,Әй, енді үзіліс жасайық ба?
Dialogue: 0,0:05:33.57,0:05:35.75,Main,,0,0,0,,Су...
Dialogue: 0,00:05:34.41,00:05:36.54,JPN TOP,,0,0,0,,Су…
Dialogue: 0,0:05:35.75,0:05:37.92,Main,,0,0,0,,Ет...
Dialogue: 0,00:05:36.62,00:05:39.08,JPN TOP,,0,0,0,,Ет…
Dialogue: 0,00:05:40.17,00:05:42.34,JPN TOP,,0,0,0,,Сонымен бірге ол фонды да бір уақытта салып жатыр!
Dialogue: 0,00:05:46.13,00:05:48.30,JPN TOP,,0,0,0,,(Пиоранның ауыр тыныс алуы)
Dialogue: 0,0:05:47.37,0:05:49.23,Main,,0,0,0,,Сан еті!
Dialogue: 0,00:05:48.38,00:05:50.55,JPN TOP,,0,0,0,,Сан еті!
Dialogue: 0,00:05:50.64,00:05:51.68,JPN TOP,,0,0,0,,Ha
Dialogue: 0,00:05:54.77,00:05:57.19,JPN TOP,,0,0,0,,Уау... уф
Dialogue: 0,00:05:57.27,00:05:59.31,JPN TOP,,0,0,0,,(Фуши ырылдады)
Dialogue: 0,0:05:58.70,0:06:00.56,Main,,0,0,0,,Ештеңе жоғалтатын сияқты емес!
Dialogue: 0,00:05:59.40,00:06:01.44,JPN TOP,,0,0,0,,Азаймайды деп ойлаймын!
Dialogue: 0,0:06:00.56,0:06:02.56,Main,,0,0,0,,Маған пісіруге рұқсат етіңіз!
Dialogue: 0,00:06:01.52,00:06:03.48,JPN TOP,,0,0,0,,Оны грильде және тамақтандырыңыз!
Dialogue: 0,0:06:02.56,0:06:05.68,Main,,0,0,0,,Үлкенге жақсылық жаса!
Dialogue: 0,00:06:03.57,00:06:06.90,JPN TOP,,0,0,0,,Қарттарды күт!
Dialogue: 0,0:06:06.63,0:06:08.17,Main,,0,0,0,,Мына жерге жет!
Dialogue: 0,00:06:07.78,00:06:09.41,JPN TOP,,0,0,0,,Қашпа!
Dialogue: 0,00:06:13.41,00:06:16.25,JPN TOP,,0,0,0,,(тыныс алу сияқты естіледі)
Dialogue: 0,00:06:17.83,00:06:18.66,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,00:06:27.55,00:06:30.09,JPN TOP,,0,0,0,,Ааа... жын!
Dialogue: 0,0:06:28.04,0:06:29.15,Main,,0,0,0,,Құбыжық!
Dialogue: 0,00:06:32.60,00:06:34.35,JPN TOP,,0,0,0,,Ha
Dialogue: 0,0:06:34.39,0:06:36.98,Main,,0,0,0,,Мен сізден өтінемін! Маған біраз беріңізші!
Dialogue: 0,00:06:34.43,00:06:37.89,JPN TOP,,0,0,0,,Уф... маған да беріңізші!
Dialogue: 0,0:06:36.98,0:06:39.59,Main,,0,0,0,,Мен ары қарай жүре алмаймын!
Dialogue: 0,00:06:37.98,00:06:40.31,JPN TOP,,0,0,0,,Енді жоқ!
Dialogue: 0,00:06:40.39,00:06:41.44,JPN TOP,,0,0,0,,Бұл...
Dialogue: 0,00:06:46.90,00:06:49.32,JPN TOP,,0,0,0,,Уа, ау...
Dialogue: 0,0:06:53.59,0:06:54.61,Main,,0,0,0,,Оның қуыршаққа айналдырған рухтары да керемет екенін естідім.
Dialogue: 0,00:06:54.33,00:06:55.74,JPN TOP,,0,0,0,,Дәмді...
Dialogue: 0,00:06:56.79,00:06:57.62,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,00:07:02.54,00:07:04.38,JPN TOP,,0,0,0,,Дәмді!
Dialogue: 0,0:07:03.36,0:07:04.83,Main,,0,0,0,,Юм. Юм.
Dialogue: 0,00:07:04.46,00:07:06.17,JPN TOP,,0,0,0,,Дәмді дәмді...
Dialogue: 0,00:07:07.55,00:07:09.80,JPN TOP,,0,0,0,,А, дәмді...
Dialogue: 0,00:07:12.93,00:07:15.47,JPN TOP,,0,0,0,,Дәмді! Мм... дәмді
Dialogue: 0,00:07:15.56,00:07:17.47,JPN TOP,,0,0,0,,Дәмді дәмді...
Dialogue: 0,00:07:19.06,00:07:22.40,JPN TOP,,0,0,0,,(Пиораның тістеген дыбысы)
Dialogue: 0,0:07:21.69,0:07:24.76,Main,,0,0,0,,«Рахмет»?
Dialogue: 0,00:07:22.48,00:07:25.90,JPN TOP,,0,0,0,,Иә!
Dialogue: 0,0:07:30.83,0:07:32.64,Main,,0,0,0,,Рахмет, рахмет.
Dialogue: 0,00:07:31.70,00:07:36.12,JPN TOP,,0,0,0,,Рахмет, рахмет, жақсы бала екенсің.
Dialogue: 0,0:07:32.64,0:07:35.17,Main,,0,0,0,,Қандай жақсы қыз.
Dialogue: 0,00:07:36.20,00:07:40.62,JPN TOP,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:07:39.92,0:07:41.54,Main,,0,0,0,,Бұл карта.
Dialogue: 0,00:07:40.71,00:07:42.79,JPN TOP,,0,0,0,,О, бұл карта.
Dialogue: 0,0:07:42.43,0:07:43.58,Main,,0,0,0,,Қандай сәнсіз...
Dialogue: 0,00:07:43.46,00:07:46.59,JPN TOP,,0,0,0,,Не! Қала бар
Dialogue: 0,0:07:43.58,0:07:45.32,Main,,0,0,0,,Мұнда қала бар!
Dialogue: 0,0:07:45.62,0:07:49.16,Main,,0,0,0,,100 ри қашықтықта деп ойладым.
Dialogue: 0,00:07:46.67,00:07:50.38,JPN TOP,,0,0,0,,Бірақ ол әлі 100 ри қашықтықта...
Dialogue: 0,0:07:49.73,0:07:52.71,Main,,0,0,0,,Біз де теңізге қарай жүре аламыз.
Dialogue: 0,00:07:50.47,00:07:53.93,JPN TOP,,0,0,0,,Теңізге осылай шығуға болады.
Dialogue: 0,0:07:59.88,0:08:01.79,Main,,0,0,0,,Қалай ойлайсың, Фуши?
Dialogue: 0,00:08:00.98,00:08:02.69,JPN TOP,,0,0,0,,Фуши туралы не айтасыз?
Dialogue: 0,0:08:01.79,0:08:04.80,Main,,0,0,0,,Менің туған жерім теңіздің ар жағында.
Dialogue: 0,00:08:02.77,00:08:05.73,JPN TOP,,0,0,0,,Менің туған жерім теңіздің ар жағында.
Dialogue: 0,0:08:05.29,0:08:06.44,Main,,0,0,0,,Біз барамыз ба?
Dialogue: 0,00:08:06.36,00:08:07.57,JPN TOP,,0,0,0,,Барғыңыз келе ме?
Dialogue: 0,00:08:12.32,00:08:13.15,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:08:21.51,0:08:22.68,Main,,0,0,0,,Сен өткенде жақсы нәтиже көрсеттің, сондықтан оны қалай жасау керектігін үйренуге дайынсың деп ойлаймын.
Dialogue: 0,00:08:22.62,00:08:23.62,JPN TOP,,0,0,0,,Не?
Dialogue: 0,00:08:24.83,00:08:26.00,JPN TOP,,0,0,0,,О...
Dialogue: 0,00:08:27.08,00:08:30.34,JPN TOP,,0,0,0,,Хмм... Ммм...
Dialogue: 0,0:08:31.90,0:08:34.81,Main,,0,0,0,,Сіз жазуға қызығасыз ба?
Dialogue: 0,00:08:33.01,00:08:35.76,JPN TOP,,0,0,0,,Сізді әріп қызықтырады ма?
Dialogue: 0,00:08:41.77,00:08:42.93,JPN TOP,,0,0,0,,Ha
Dialogue: 0,0:08:41.99,0:08:46.24,Main,,0,0,0,,Қараңыз. Осылайша сіз «ri» деп жазасыз.
Dialogue: 0,00:08:43.02,00:08:47.44,JPN TOP,,0,0,0,,Қарасам, “ri” осылай жазылған.
Dialogue: 0,00:08:49.48,00:08:50.65,JPN TOP,,0,0,0,,(Фушидің күрсінуі)
Dialogue: 0,0:08:53.65,0:08:54.97,Main,,0,0,0,,Міне.
Dialogue: 0,00:08:54.49,00:08:55.91,JPN TOP,,0,0,0,,Жарайды, бірінші кім?
Dialogue: 0,00:08:56.41,00:08:59.91,JPN TOP,,0,0,0,,(Фушидің күрсінуі)
Dialogue: 0,00:09:00.54,00:09:01.91,JPN TOP,,0,0,0,,Ухяу-ке-ко-ке! Ке-ке-ке-ке! Ке-ко-ке-ко!
Dialogue: 0,0:09:08.17,0:09:09.86,Main,,0,0,0,,Көбірек білгіңіз келе ме?
Dialogue: 0,00:09:08.25,00:09:11.00,JPN TOP,,0,0,0,,А... сіз көбірек білгіңіз келе ме?
Dialogue: 0,0:09:10.48,0:09:12.53,Main,,0,0,0,,Олай болса менімен бірге жүр.
Dialogue: 0,00:09:11.55,00:09:13.46,JPN TOP,,0,0,0,,Олай болса менің артымнан жүр.
Dialogue: 0,0:09:12.53,0:09:18.25,Main,,0,0,0,,Сөз бен жазуды, адам болып өмір сүруді үйретемін.
Dialogue: 0,00:09:13.55,00:09:15.51,JPN TOP,,0,0,0,,сөздер әріптер
Dialogue: 0,00:09:15.59,00:09:19.22,JPN TOP,,0,0,0,,Мен саған адам болып өмір сүруді үйретемін.
Dialogue: 0,0:09:18.65,0:09:20.76,Main,,0,0,0,,Ал сен маған жақсырақ қарайсың.
Dialogue: 0,00:09:19.72,00:09:21.68,JPN TOP,,0,0,0,,Маған көбірек көңіл бөл
Dialogue: 0,00:09:23.77,00:09:25.94,JPN TOP,,0,0,0,,(Фушидің дөрекі демі)
Dialogue: 0,0:09:27.09,0:09:30.58,Main,,0,0,0,,«Наурыз» деп жазылған.
Dialogue: 0,00:09:28.15,00:09:31.52,JPN TOP,,0,0,0,,Бұл «марш» деп оқылады
Dialogue: 0,00:09:32.23,00:09:34.57,JPN TOP,,0,0,0,,(Фушидің күрсінуі)
Dialogue: 0,0:09:34.04,0:09:35.28,Main,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,00:09:35.19,00:09:38.45,JPN TOP,,0,0,0,,Not like this.
Dialogue: 0,0:09:35.58,0:09:37.51,Main,,0,0,0,,Like this.
Dialogue: 0,0:09:37.80,0:09:39.66,Main,,0,0,0,,This says "Fushi."
Dialogue: 0,00:09:38.53,00:09:41.95,JPN TOP,,0,0,0,,Бұл сіз туралы «фуши».
Dialogue: 0,0:09:39.66,0:09:41.00,Main,,0,0,0,,Бұл сенсің.
Dialogue: 0,0:09:41.25,0:09:42.76,Main,,0,0,0,,"Parona."
Dialogue: 0,00:09:42.03,00:09:43.95,JPN TOP,,0,0,0,,“Parona”
Dialogue: 0,0:09:43.44,0:09:45.39,Main,,0,0,0,,This is my name.
Dialogue: 0,00:09:44.50,00:09:46.33,JPN TOP,,0,0,0,,This is my name
Dialogue: 0,0:09:45.56,0:09:47.83,Main,,0,0,0,,"Pioran."
Dialogue: 0,00:09:46.41,00:09:48.96,JPN TOP,,0,0,0,,“Piolan”
Dialogue: 0,0:09:49.57,0:09:51.87,Main,,0,0,0,,That's a "tree."
Dialogue: 0,00:09:50.63,00:09:53.17,JPN TOP,,0,0,0,,Бұл «ағаш»
Dialogue: 0,0:09:54.90,0:09:57.15,Main,,0,0,0,,Бұл «гүлдер».
Dialogue: 0,00:09:55.92,00:09:58.09,JPN TOP,,0,0,0,,Бұл «гүлдер»
Dialogue: 0,0:09:57.38,0:09:58.27,Main,,0,0,0,,Құс.
Dialogue: 0,00:09:58.18,00:09:59.34,JPN TOP,,0,0,0,,«Құс»
Dialogue: 0,0:09:59.36,0:10:00.95,Main,,0,0,0,,Sun.
Dialogue: 0,00:10:00.18,00:10:02.10,JPN TOP,,0,0,0,,«Күн»
Dialogue: 0,0:10:06.00,0:10:06.92,Main,,0,0,0,,Yum!
Dialogue: 0,00:10:06.10,00:10:07.85,JPN TOP,,0,0,0,,Ah, delicious!
Dialogue: 0,00:10:17.28,00:10:19.11,JPN TOP,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:10:18.81,0:10:19.93,Main,,0,0,0,,Өзен.
Dialogue: 0,00:10:19.95,00:10:20.87,JPN TOP,,0,0,0,,«Өзен»
Dialogue: 0,0:10:21.00,0:10:22.68,Main,,0,0,0,,Өзен.
Dialogue: 0,00:10:22.03,00:10:24.37,JPN TOP,,0,0,0,,Kawa umu
Dialogue: 0,0:10:25.88,0:10:27.20,Main,,0,0,0,,Балық.
Dialogue: 0,00:10:26.91,00:10:29.58,JPN TOP,,0,0,0,,«Балық» «Өрт»
Dialogue: 0,0:10:27.87,0:10:28.64,Main,,0,0,0,,Өрт.
Dialogue: 0,0:10:30.57,0:10:32.01,Main,,0,0,0,,Балық.
Dialogue: 0,00:10:31.67,00:10:33.13,JPN TOP,,0,0,0,,Сакана
Dialogue: 0,0:10:33.09,0:10:34.06,Main,,0,0,0,,Өрт.
Dialogue: 0,00:10:34.13,00:10:35.76,JPN TOP,,0,0,0,,Сәлем… Хмм.
Dialogue: 0,0:10:38.33,0:10:39.93,Main,,0,0,0,,Кел де жуынып ал.
Dialogue: 0,00:10:39.47,00:10:42.72,JPN TOP,,0,0,0,,Рахмет, рахмет, рахмет,
Dialogue: 0,0:10:40.20,0:10:41.78,Main,,0,0,0,,Кел де жуынып ал.
Dialogue: 0,0:10:42.05,0:10:46.12,Main,,0,0,0,,Бұл дұрыс емес, бірақ бұл жағдайға жақсырақ сөз бар.
Dialogue: 0,00:10:42.80,00:10:44.60,JPN TOP,,0,0,0,,Мен қателеспеймін.
Dialogue: 0,00:10:44.68,00:10:47.18,JPN TOP,,0,0,0,,Жақсырақ сөз бар
Dialogue: 0,0:10:48.82,0:10:49.87,Main,,0,0,0,,«Иә»!
Dialogue: 0,00:10:49.85,00:10:50.81,JPN TOP,,0,0,0,,Дәмді!
Dialogue: 0,0:10:55.89,0:10:57.03,Main,,0,0,0,,Юф!
Dialogue: 0,00:10:56.98,00:10:58.24,JPN TOP,,0,0,0,,Дәмді! Хмм
Dialogue: 0,0:10:58.38,0:10:59.21,Main,,0,0,0,,Оның қуыршаққа айналдырған рухтары да керемет екенін естідім.
Dialogue: 0,0:10:59.40,0:11:00.34,Main,,0,0,0,,Оның қуыршаққа айналдырған рухтары да керемет екенін естідім.
Dialogue: 0,00:10:59.45,00:11:01.45,JPN TOP,,0,0,0,,Yummy Yummy…
Dialogue: 0,0:11:01.31,0:11:02.51,Main,,0,0,0,,Goodnight.
Dialogue: 0,00:11:02.32,00:11:03.62,JPN TOP,,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:11:03.27,0:11:04.58,Main,,0,0,0,,Қайырлы түн.
Dialogue: 0,00:11:04.33,00:11:05.66,JPN TOP,,0,0,0,,Good night
Dialogue: 0,0:11:38.09,0:11:39.69,Main,,0,0,0,,түн
Dialogue: 0,00:11:39.11,00:11:40.99,JPN TOP,,0,0,0,,Не?
Dialogue: 0,0:11:40.32,0:11:41.70,Main,,0,0,0,,That's a boat.
Dialogue: 0,00:11:41.07,00:11:42.82,JPN TOP,,0,0,0,,Бұл кеме
Dialogue: 0,0:11:43.50,0:11:45.24,Main,,0,0,0,,Балық.
Dialogue: 0,00:11:44.53,00:11:46.95,JPN TOP,,0,0,0,,Балық Уму
Dialogue: 0,0:11:46.45,0:11:48.74,Main,,0,0,0,,Жеміс.
Dialogue: 0,00:11:47.49,00:11:50.45,JPN TOP,,0,0,0,,Кудамоно, солай емес пе?
Dialogue: 0,0:11:48.74,0:11:49.52,Main,,0,0,0,,Иә.
Dialogue: 0,0:11:54.33,0:11:59.12,Main,,0,0,0,,Сіз көп нәрсені айтуды үйрендіңіз бе?
Dialogue: 0,00:11:55.42,00:11:56.96,JPN TOP,,0,0,0,,Солай болса да, сіз
Dialogue: 0,00:11:57.04,00:12:00.21,JPN TOP,,0,0,0,,Енді мен көп сөйлей аламын.
Dialogue: 0,0:11:59.62,0:12:00.98,Main,,0,0,0,,Менде бар.
Dialogue: 0,00:12:00.71,00:12:01.92,JPN TOP,,0,0,0,,болды
Dialogue: 0,0:12:01.16,0:12:04.45,Main,,0,0,0,,Наурыздың арқасында деп ойлайсың ба?
Dialogue: 0,00:12:02.01,00:12:05.39,JPN TOP,,0,0,0,,Өзгеріс наурызға байланысты ма?
Dialogue: 0,0:12:05.21,0:12:09.51,Main,,0,0,0,,Өсе білу – үйрену.
Dialogue: 0,00:12:06.30,00:12:08.68,JPN TOP,,0,0,0,,Ересек болу
Dialogue: 0,00:12:08.76,00:12:10.89,JPN TOP,,0,0,0,,Білу
Dialogue: 0,0:12:09.94,0:12:11.44,Main,,0,0,0,,Біздің руға шабуыл жасаған Маскалылар Эбису-саманың…
Dialogue: 0,00:12:10.98,00:12:12.35,JPN TOP,,0,0,0,,Не?
Dialogue: 0,0:12:11.44,0:12:13.96,Main,,0,0,0,,Сіз ересек болғыңыз келе ме?
Dialogue: 0,00:12:12.44,00:12:14.90,JPN TOP,,0,0,0,,Сіз ересек болғыңыз келе ме?
Dialogue: 0,0:12:15.31,0:12:18.51,Main,,0,0,0,,Айт, наурызды қарсы алғанға дейін қайда болдың?
Dialogue: 0,00:12:16.40,00:12:17.48,JPN TOP,,0,0,0,,Эй
Dialogue: 0,00:12:17.57,00:12:21.57,JPN TOP,,0,0,0,,Наурызбен танысқанға дейін қайда, не істеп жүр едің?
Dialogue: 0,0:12:18.51,0:12:22.35,Main,,0,0,0,,Сен не істедің? Сіз кіммен болдыңыз?
Dialogue: 0,00:12:22.07,00:12:23.28,JPN TOP,,0,0,0,,Сіз кіммен болдыңыз?
Dialogue: 0,0:12:24.32,0:12:28.35,Main,,0,0,0,,Мен жалғыз жүрдім.
Dialogue: 0,00:12:25.41,00:12:29.29,JPN TOP,,0,0,0,,Мен жол бойы жалғыз жүрдім
Dialogue: 0,0:12:28.73,0:12:31.36,Main,,0,0,0,,Содан мен оны кездестірдім.
Dialogue: 0,00:12:29.83,00:12:32.29,JPN TOP,,0,0,0,,Содан біз кездестік
Dialogue: 0,0:12:32.05,0:12:34.86,Main,,0,0,0,,Ол маған тамақ берді.
Dialogue: 0,00:12:33.08,00:12:35.88,JPN TOP,,0,0,0,,Гохан... оны маған берді.
Dialogue: 0,0:12:35.36,0:12:36.38,Main,,0,0,0,,Кім?
Dialogue: 0,00:12:36.38,00:12:39.25,JPN TOP,,0,0,0,,Бұл кім? Сіз кіммен кездестіңіз?
Dialogue: 0,0:12:37.10,0:12:38.31,Main,,0,0,0,,Сіз кіммен таныстыңыз?
Dialogue: 0,0:12:38.74,0:12:40.23,Main,,0,0,0,,Тик-так, сағат тілі тик-так
Dialogue: 0,00:12:39.75,00:12:41.17,JPN TOP,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:12:40.71,0:12:43.11,Main,,0,0,0,,Мен оның атын білмеймін.
Dialogue: 0,00:12:41.84,00:12:44.05,JPN TOP,,0,0,0,,Аты-жөнін білмеймін
Dialogue: 0,0:12:43.74,0:12:49.13,Main,,0,0,0,,Пішіндер, дыбыстар, иістер... есімде.
Dialogue: 0,00:12:44.84,00:12:50.18,JPN TOP,,0,0,0,,Пішін Дыбыс Иісі есімде
Dialogue: 0,0:12:49.86,0:12:53.78,Main,,0,0,0,,Мен сол адамға айналдым.
Dialogue: 0,00:12:50.97,00:12:55.14,JPN TOP,,0,0,0,,Мен сол адамға айналдым
Dialogue: 0,0:12:54.22,0:12:55.35,Main,,0,0,0,,Соңы.
Dialogue: 0,00:12:55.23,00:12:56.44,JPN TOP,,0,0,0,,Соңы
Dialogue: 0,00:13:04.07,00:13:07.32,JPN TOP,,0,0,0,,О, енді жер көзге көрініп тұр!
Dialogue: 0,0:13:04.12,0:13:06.15,Main,,0,0,0,,Біз құрлықта келе жатырмыз!
Dialogue: 0,0:13:10.82,0:13:13.55,Main,,0,0,0,,Қараңдаршы, аспан қалай қызыл?
Dialogue: 0,00:13:11.91,00:13:14.50,JPN TOP,,0,0,0,,Аспан тек сонда ғана қызыл.
Dialogue: 0,0:13:13.92,0:13:17.42,Main,,0,0,0,,Яномдықтар күнде осылай ұрысады.
Dialogue: 0,00:13:14.58,00:13:18.46,JPN TOP,,0,0,0,,Яноме күнде осылай ұрысады.
Dialogue: 0,0:13:17.42,0:13:20.10,Main,,0,0,0,,Такунахамен, біз қазір қайда барамыз.
Dialogue: 0,00:13:18.54,00:13:21.50,JPN TOP,,0,0,0,,Мен бұдан былай баратын такнаха.
Dialogue: 0,0:13:24.09,0:13:27.49,Main,,0,0,0,,Менің ғашығымның үйі солай.
Dialogue: 0,00:13:25.13,00:13:28.43,JPN TOP,,0,0,0,,Менің сүйіктімнің үйі алда
Dialogue: 0,0:13:27.80,0:13:30.25,Main,,0,0,0,,Алдымен біз барамыз.
Dialogue: 0,00:13:28.51,00:13:31.22,JPN TOP,,0,0,0,,Мен сонда барамын.
Dialogue: 0,0:13:30.25,0:13:32.57,Main,,0,0,0,,Осы орманда түнеп алайық.
Dialogue: 0,00:13:31.31,00:13:33.93,JPN TOP,,0,0,0,,Бүгін түнде осы орманда демалайық.
Dialogue: 0,0:13:34.50,0:13:36.91,Main,,0,0,0,,Ол зиялы.
Dialogue: 0,00:13:35.60,00:13:37.85,JPN TOP,,0,0,0,,Ол зиялы
Dialogue: 0,0:13:36.91,0:13:40.49,Main,,0,0,0,,Ол сіз туралы бірдеңе білуі мүмкін.
Dialogue: 0,00:13:37.94,00:13:41.69,JPN TOP,,0,0,0,,Мүмкін мен де сіз туралы бірдеңе білуім мүмкін.
Dialogue: 0,0:13:41.53,0:13:43.86,Main,,0,0,0,,Ертеңнің соңына дейін сонда боламыз.
Dialogue: 0,00:13:42.69,00:13:45.11,JPN TOP,,0,0,0,,Ол ертең келеді.
Dialogue: 0,0:14:00.07,0:14:01.30,Narration,,0,0,0,,Қандай сәнсіз...
Dialogue: 0,00:14:01.13,00:14:02.55,JPN TOP,,0,0,0,,Қап…
Dialogue: 0,0:14:01.65,0:14:05.24,Narration,,0,0,0,,Менің бақшама ойнауға біреу келген сияқты.
Dialogue: 0,00:14:02.63,00:14:06.34,JPN TOP,,0,0,0,,Менің бақшама біреу қонаққа келген сияқты.
Dialogue: 0,00:14:12.35,00:14:13.64,JPN TOP,,0,0,0,,Ha
Dialogue: 0,00:14:19.31,00:14:22.15,JPN TOP,,0,0,0,,(Фушидің ыңырсыуы)
Dialogue: 0,0:14:29.19,0:14:32.18,Narration,,0,0,0,,Оның еті әдеттегіден басқаша жауап береді.
Dialogue: 0,00:14:30.20,00:14:33.12,JPN TOP,,0,0,0,,Менің денемнің реакциясы әдеттегіден өзгеше.
Dialogue: 0,0:14:32.58,0:14:36.63,Narration,,0,0,0,,Баланың кейпін алуға тырысады, бірақ нәтиже жоқ.
Dialogue: 0,00:14:33.74,00:14:37.58,JPN TOP,,0,0,0,,Мен бала пішініме оралуға тырысамын, бірақ мүмкін емес.
Dialogue: 0,00:14:37.66,00:14:39.21,JPN TOP,,0,0,0,,Иә?
Dialogue: 0,0:14:40.93,0:14:42.82,Main,,0,0,0,,Бұл не, Фуши?
Dialogue: 0,00:14:42.08,00:14:45.59,JPN TOP,,0,0,0,,Не болды, Фуши? Бірдеңе болды ма?
Dialogue: 0,0:14:42.82,0:14:44.55,Main,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,00:14:46.09,00:14:46.92,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,00:14:51.51,00:14:54.43,JPN TOP,,0,0,0,,(Жел дыбысы)
Dialogue: 0,00:15:04.77,00:15:07.19,JPN TOP,,0,0,0,,(Фуши ырылдады)
Dialogue: 0,00:15:09.53,00:15:13.95,JPN TOP,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:15:13.18,0:15:15.51,Main,,0,0,0,,Кім-Сен несің?!
Dialogue: 0,00:15:14.03,00:15:16.45,JPN TOP,,0,0,0,,Не... не істеп жатырсың!?
Dialogue: 0,0:15:15.51,0:15:17.74,Main,,0,0,0,,Неліктен Фушиге ұқсайсың?
Dialogue: 0,00:15:16.54,00:15:18.62,JPN TOP,,0,0,0,,Балықтай солған бет
Dialogue: 0,0:15:17.74,0:15:19.73,Main,,0,0,0,,Бізден не қалайсың?!
Dialogue: 0,00:15:18.70,00:15:20.66,JPN TOP,,0,0,0,,Жер бетінде бізге не керек...
Dialogue: 0,0:15:43.13,0:15:47.00,Main,,0,0,0,,Сенің денең қимылсыз болса да, Даусымды естисің.
Dialogue: 0,00:15:44.19,00:15:47.94,JPN TOP,,0,0,0,,Ет қозғалмаса да, дауысты естисің.
Dialogue: 0,0:15:47.77,0:15:48.67,Main,,0,0,0,,Жақсы ма?
Dialogue: 0,00:15:48.86,00:15:52.95,JPN TOP,,0,0,0,,Өзіңіздің бір бөлігін жоғалтуға қалай қарайсыз?
Dialogue: 0,0:15:49.02,0:15:52.00,Main,,0,0,0,,Өзіңіздің бір бөлігін жоғалтып алу қандай сезімде болады?
Dialogue: 0,0:15:53.11,0:15:55.62,Main,,0,0,0,,Бұл сенің бір бөлігіңді алды.
Dialogue: 0,00:15:54.20,00:15:56.91,JPN TOP,,0,0,0,,Сізді ол ұрлап кетті
Dialogue: 0,0:15:55.96,0:15:57.69,Main,,0,0,0,,Сол бала.
Dialogue: 0,00:15:56.99,00:16:02.46,JPN TOP,,0,0,0,,Бала, пішіні, дыбысы, иісі
Dialogue: 0,0:15:57.69,0:16:01.53,Main,,0,0,0,,Оның пішіні. Оның дыбысы. Оның иісі.
Dialogue: 0,0:16:03.17,0:16:07.77,Main,,0,0,0,,Оның сізден не алғанын еске түсіре алмайсыз.
Dialogue: 0,00:16:04.25,00:16:08.96,JPN TOP,,0,0,0,,Осы қарқынмен сіз өзіңізден не алынғанын еске түсірмейсіз.
Dialogue: 0,0:16:08.41,0:16:13.52,Main,,0,0,0,,Бірақ сол бостықты, ыңғайсыздықты байқаған боларсыз.
Dialogue: 0,00:16:09.51,00:16:11.80,JPN TOP,,0,0,0,,Бірақ сіз байқағаныңыз жөн
Dialogue: 0,00:16:11.88,00:16:14.47,JPN TOP,,0,0,0,,Мен сол қуыста біртүрлі сезінемін.
Dialogue: 0,0:16:14.45,0:16:17.67,Main,,0,0,0,,Бұл сіз үшін құнды ма?
Dialogue: 0,00:16:15.55,00:16:18.97,JPN TOP,,0,0,0,,Онда құнды нәрсе бар ма?
Dialogue: 0,0:16:18.01,0:16:21.55,Main,,0,0,0,,Мен сізге ақыл-парасатыңызға сай кеңес беремін.
Dialogue: 0,00:16:19.06,00:16:22.48,JPN TOP,,0,0,0,,Мен саған ақыл-парасатыңа қарай кеңес беремін.
Dialogue: 0,0:16:22.13,0:16:24.79,Main,,0,0,0,,Бұл сенің жауың.
Dialogue: 0,00:16:23.19,00:16:25.65,JPN TOP,,0,0,0,,Бұл сенің жауың.
Dialogue: 0,0:16:24.79,0:16:27.28,Main,,0,0,0,,Онымен күресіп, жеңіңіз.
Dialogue: 0,00:16:25.73,00:16:28.23,JPN TOP,,0,0,0,,Оған қарсы күресіп, жеңіңіз
Dialogue: 0,00:16:31.24,00:16:32.24,JPN TOP,,0,0,0,,(Фуши үреді)
Dialogue: 0,00:16:39.58,00:16:40.45,JPN TOP,,0,0,0,,(қабығы)
Dialogue: 0,00:16:44.50,00:16:45.67,JPN TOP,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:16:48.78,0:16:51.36,Main,,0,0,0,,Оның ортасында өзек бар.
Dialogue: 0,00:16:49.67,00:16:52.26,JPN TOP,,0,0,0,,Орталықта ядро бар
Dialogue: 0,0:16:51.68,0:16:54.26,Main,,0,0,0,,Сол өзегін етінен жұлып ал.
Dialogue: 0,00:16:52.76,00:16:55.22,JPN TOP,,0,0,0,,Оны етінен жұлып ал
Dialogue: 0,0:16:54.26,0:16:56.86,Main,,0,0,0,,Бұл оның қозғалуын тоқтатады.
Dialogue: 0,00:16:55.30,00:16:57.80,JPN TOP,,0,0,0,,Сонда қозғалыс тоқтайды
Dialogue: 0,00:17:02.64,00:17:04.02,JPN TOP,,0,0,0,,(Фушидің айқайы)
Dialogue: 0,0:17:19.74,0:17:21.19,Main,,0,0,0,,Жаман емес.
Dialogue: 0,00:17:20.83,00:17:22.12,JPN TOP,,0,0,0,,Жаман емес
Dialogue: 0,00:17:26.58,00:17:29.79,JPN TOP,,0,0,0,,(Пиоранның ауыр тыныс алуы)
Dialogue: 0,0:17:28.83,0:17:29.88,Main,,0,0,0,,Фуши!
Dialogue: 0,0:17:29.88,0:17:32.10,Main,,0,0,0,,Келме.
Dialogue: 0,00:17:29.88,00:17:30.71,JPN TOP,,0,0,0,,Фуши!
Dialogue: 0,00:17:30.79,00:17:33.05,JPN TOP,,0,0,0,,Осылайша...
Dialogue: 0,00:17:33.13,00:17:34.42,JPN TOP,,0,0,0,,Ах!
Dialogue: 0,0:17:41.54,0:17:45.05,Main,,0,0,0,,Бұл сіз жинаған ыдыстарды ұрлайды.
Dialogue: 0,00:17:42.64,00:17:45.98,JPN TOP,,0,0,0,,Ол сіз жинаған ыдыстарды ұрлады.
Dialogue: 0,0:17:45.05,0:17:49.79,Main,,0,0,0,,Ол сізді әлсірету мақсатында жасалған.
Dialogue: 0,00:17:46.06,00:17:50.73,JPN TOP,,0,0,0,,Сізді әлсірету үшін жасалған
Dialogue: 0,00:17:46.06,00:17:50.73,JPN TOP,,0,0,0,,(Фуши ырылдады)
Dialogue: 0,0:17:50.24,0:17:53.29,Main,,0,0,0,,Бұл өмірдің сәтсіздігі, жануарға айналуға қабілетсіз.
Dialogue: 0,00:17:51.32,00:17:54.23,JPN TOP,,0,0,0,,Жануар бола алмасаң, сәтсізсің.
Dialogue: 0,00:17:54.32,00:17:56.78,JPN TOP,,0,0,0,,(Фушидің шайқас айқайы)
Dialogue: 0,0:18:00.06,0:18:03.57,Main,,0,0,0,,Бірақ ол ұрлыққа шебер.
Dialogue: 0,00:18:00.91,00:18:04.66,JPN TOP,,0,0,0,,Бірақ ол ұрлыққа мамандандырылған.
Dialogue: 0,00:18:03.87,00:18:05.25,JPN TOP,,0,0,0,,(қасқырдың ұлыуы)
Dialogue: 0,00:18:06.54,00:18:07.54,JPN TOP,,0,0,0,,(Фушидің айқайы)
Dialogue: 0,00:18:10.58,00:18:13.00,JPN TOP,,0,0,0,,(Фушидің ыңырсыуы)
Dialogue: 0,00:18:15.96,00:18:18.84,JPN TOP,,0,0,0,,Шыу!
Dialogue: 0,00:18:18.93,00:18:20.80,JPN TOP,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,00:18:26.35,00:18:28.64,JPN TOP,,0,0,0,,(Фуши ырылдады)
Dialogue: 0,0:18:39.54,0:18:41.31,Main,,0,0,0,,Жарайсыңдар.
Dialogue: 0,00:18:40.66,00:18:42.41,JPN TOP,,0,0,0,,Жарайсың
Dialogue: 0,0:18:42.10,0:18:44.14,Main,,0,0,0,,Бұл өзегі.
Dialogue: 0,00:18:43.20,00:18:45.04,JPN TOP,,0,0,0,,Бұл ядро.
Dialogue: 0,0:18:44.93,0:18:48.42,Main,,0,0,0,,Оның ішінде сізден ұрлағанның бәрі бар.
Dialogue: 0,00:18:45.99,00:18:49.58,JPN TOP,,0,0,0,,Ішінде сізден ұрланған бірдеңе бар.
Dialogue: 0,00:18:55.96,00:18:58.17,JPN TOP,,0,0,0,,(аюдың ақыруы)
Dialogue: 0,0:18:57.19,0:18:59.70,Main,,0,0,0,,Оны қайтарып алу ғана қалды.
Dialogue: 0,00:18:58.26,00:19:00.63,JPN TOP,,0,0,0,,Оны қайтарып алу ғана қалды.
Dialogue: 0,00:19:34.50,00:19:35.42,JPN TOP,,0,0,0,,Әй!
Dialogue: 0,00:19:37.92,00:19:39.59,JPN TOP,,0,0,0,,(аюдың дауысы)
Dialogue: 0,00:19:40.42,00:19:41.76,JPN TOP,,0,0,0,,(Фушидің айқайы)
Dialogue: 0,00:19:41.84,00:19:44.76,JPN TOP,,0,0,0,,(аюдың дауысы)
Dialogue: 0,00:19:47.72,00:19:49.06,JPN TOP,,0,0,0,,Уф...
Dialogue: 0,00:19:50.14,00:19:52.56,JPN TOP,,0,0,0,,Ауылдың қарапайым адамдары көбейіп кеткен сияқты.
Dialogue: 0,00:19:57.48,00:19:58.73,JPN TOP,,0,0,0,,Ах
Dialogue: 0,00:20:02.82,00:20:04.49,JPN TOP,,0,0,0,,Ах... Мм.
Dialogue: 0,00:20:06.99,00:20:08.37,JPN TOP,,0,0,0,,Құт
Dialogue: 0,00:20:25.30,00:20:28.26,JPN TOP,,0,0,0,,(Фушидің қатты тыныс алуы)
Dialogue: 0,00:20:31.93,00:20:33.27,JPN TOP,,0,0,0,,Фу
Dialogue: 0,00:20:35.19,00:20:37.44,JPN TOP,,0,0,0,,Хмм...
Dialogue: 0,00:20:37.52,00:20:38.94,JPN TOP,,0,0,0,,Хмм
Dialogue: 0,00:20:39.02,00:20:40.57,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,00:20:42.90,00:20:44.20,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,00:20:55.92,00:20:57.38,JPN TOP,,0,0,0,,Ах
Dialogue: 0,00:21:00.96,00:21:02.92,JPN TOP,,0,0,0,,Ах...
Dialogue: 0,00:21:14.69,00:21:16.23,JPN TOP,,0,0,0,,Фу
Dialogue: 0,0:21:22.61,0:21:25.48,Main,,0,0,0,,Сіз кімсіз?
Dialogue: 0,00:21:23.61,00:21:26.41,JPN TOP,,0,0,0,,Нани... сен бе?
Dialogue: 0,0:21:28.36,0:21:31.26,Main,,0,0,0,,Мен сенің жаратушыңмын.
Dialogue: 0,00:21:29.45,00:21:32.24,JPN TOP,,0,0,0,,Мен сені жараттым
Dialogue: 0,0:21:31.65,0:21:34.97,Main,,0,0,0,,Біздің үлкен мақсатымыз бар.
Dialogue: 0,00:21:32.74,00:21:35.91,JPN TOP,,0,0,0,,Бізде үлкен мақсат бар
Dialogue: 0,0:21:35.80,0:21:38.71,Main,,0,0,0,,Осы дүниені сақтау үшін.
Dialogue: 0,00:21:36.92,00:21:39.88,JPN TOP,,0,0,0,,Бұл әлемді құтқару үшін
Dialogue: 0,0:21:40.05,0:21:46.56,Main,,0,0,0,,Бұл зат біздің мақсатымызға кедергі жасау үшін осы дүниеге жіберілді.
Dialogue: 0,00:21:41.13,00:21:43.01,JPN TOP,,0,0,0,,Және бұл
Dialogue: 0,00:21:43.09,00:21:47.72,JPN TOP,,0,0,0,,Ол бұл жоспарды бұзу үшін жіберілді.
Dialogue: 0,0:21:48.44,0:21:50.95,Main,,0,0,0,,Сіз түсінбейтін сияқтысыз.
Dialogue: 0,00:21:49.55,00:21:51.89,JPN TOP,,0,0,0,,Бұл дұрыс емес сияқты.
Dialogue: 0,0:21:55.02,0:21:56.30,Main,,0,0,0,,Бұл жақсы.
Dialogue: 0,00:21:56.14,00:21:59.90,JPN TOP,,0,0,0,,Мәселе жоқ, мен сенімен тағы сөйлесемін.
Dialogue: 0,0:21:56.90,0:21:58.68,Main,,0,0,0,,Мен сенімен тағы да сөйлесуге келемін.
Dialogue: 0,0:21:59.64,0:22:02.96,Main,,0,0,0,,Ал, Фуши, біз көңіл көтереміз.
Dialogue: 0,00:22:00.81,00:22:04.03,JPN TOP,,0,0,0,,Олай болса, көңіл көтерейік
Dialogue: 0,0:22:06.44,0:22:09.37,Main,,0,0,0,,Алдағы соңына дейін.
Dialogue: 0,00:22:07.24,00:22:10.74,JPN TOP,,0,0,0,,Алдағы соңына дейін
Dialogue: 0,0:22:11.66,0:22:12.79,Main,,0,0,0,,Бір сәт те жоғалтуға болмайды.
Dialogue: 0,00:22:12.70,00:22:15.87,JPN TOP,,0,0,0,,Сәлем! Жақсысың ба, Фуши?
Dialogue: 0,0:22:13.24,0:22:14.93,Main,,0,0,0,,Амансың ба, Фуши?
Dialogue: 0,0:22:15.59,0:22:17.86,Main,,0,0,0,,Бұл не болды?
Dialogue: 0,00:22:16.71,00:22:18.79,JPN TOP,,0,0,0,,Бұл бұрын не болды?
Dialogue: 0,0:22:22.33,0:22:23.49,Main,,0,0,0,,Фуши?
Dialogue: 0,00:22:23.38,00:22:24.76,JPN TOP,,0,0,0,,Фуши?
Dialogue: 0,00:22:27.55,00:22:28.63,JPN TOP,,0,0,0,,Хаха…
Dialogue: 0,0:22:28.38,0:22:29.85,Main,,0,0,0,,Тик-так, сағат тілі тик-так
Dialogue: 0,00:22:29.51,00:22:32.72,JPN TOP,,0,0,0,,Түсінбедім, біртүрлі екен.
Dialogue: 0,0:22:30.30,0:22:31.61,Main,,0,0,0,,Бұл біртүрлі болды.
Dialogue: 0,0:22:44.02,0:22:46.78,Main,,0,0,0,,Сәлем! Қарт қайда?!
Dialogue: 0,00:22:45.15,00:22:47.90,JPN TOP,,0,0,0,,Сәлем! Қарт адам бар ма?
Dialogue: 0,0:22:48.06,0:22:53.27,Main,,0,0,0,,Рахмет! Pioran сізге сыйлық әкелді!
Dialogue: 0,00:22:49.07,00:22:54.49,JPN TOP,,0,0,0,,Мына Пиоран сізге кәдесый әкелді.
Dialogue: 0,0:22:54.56,0:22:57.51,Main,,0,0,0,,Өлмейтін ақымақ!
Dialogue: 0,00:22:55.62,00:22:58.66,JPN TOP,,0,0,0,,Бұл өлмейтін құбыжық.
Dialogue: 0,00:23:01.04,00:23:06.05,JPN TOP,,0,0,0,,♪~
Dialogue: 0,00:24:25.92,00:24:30.92,JPN TOP,,0,0,0,,~♪
Dialogue: 0,0:24:29.98,0:24:34.48,sign_35245_236_Preview,,0,0,0,,Алдын ала қарау
Dialogue: 0,0:24:31.35,0:24:37.74,Narration,,0,0,0,,Фуши мен Пиоран ескі сыра қайнатушының үйінде жаңа өмір бастайды.
Dialogue: 0,00:24:32.47,00:24:34.68,JPN TOP,,0,0,0,,Ішімдік дүкеніндегі қарияның үйінде
Dialogue: 0,00:24:35.34,00:24:38.68,JPN TOP,,0,0,0,,Фушидің жаңа өмірі басталады
Dialogue: 0,0:24:39.40,0:24:44.63,Narration,,0,0,0,,Бетперде киген Гугу Фушиді қуана қарсы алады.
Dialogue: 0,00:24:40.77,00:24:45.56,JPN TOP,,0,0,0,,Бетперде киген бала Гу Гу Фушиді қуана қабылдайды
Dialogue: 0,0:24:46.38,0:24:53.30,Narration,,0,0,0,,Ал Фушидің қатысуы Гугудың өзінде өзгеріс әкеледі.
Dialogue: 0,00:24:47.40,00:24:49.32,JPN TOP,,0,0,0,,Және фушидің болуы
Dialogue: 0,00:24:50.07,00:24:54.49,JPN TOP,,0,0,0,,Гу Гу да өзіне өзгерістер әкеледі.
Dialogue: 0,0:24:51.01,0:24:58.43,Episode_Title,,0,0,0,,Өзгергісі келетін бала
Dialogue: 0,0:24:59.93,0:25:05.93,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory