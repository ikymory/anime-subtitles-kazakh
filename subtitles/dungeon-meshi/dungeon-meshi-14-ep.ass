Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.00,0:00:03.00,Default,,0,0,0,,♪~
Dialogue: 0,0:01:26.92,0:01:28.92,Default,,0,0,0,,~♪
Dialogue: 0,0:01:32.00,0:01:34.80,Default,,0,0,0,,Лайос пен оның достары жер бетіне қайтып келгендерін хабарлады.
Dialogue: 0,0:01:34.88,0:01:37.05,Default,,0,0,0,,Балалар мен сендерді жоғалтқым келмейді
Dialogue: 0,0:01:37.59,0:01:38.47,Default,,0,0,0,,…қашып кету…
Dialogue: 0,0:01:39.22,0:01:41.93,Default,,0,0,0,,Олар бір-бірімен байланысын растаған кезде
Dialogue: 0,0:01:42.01,0:01:43.97,Default,,0,0,0,,Уақыттан сәл артқа
Dialogue: 0,0:01:46.64,0:01:48.31,Default,,0,0,0,,Сіздің санаңыз таза ма?
Dialogue: 0,0:01:48.40,0:01:50.56,Default,,0,0,0,,Денеңізде қандай да бір жайсыздықты сезінесіз бе?
Dialogue: 0,0:01:51.90,0:01:53.57,Default,,0,0,0,,Ешқандай проблема жоқ сияқты.
Dialogue: 0,0:01:54.15,0:01:56.74,Default,,0,0,0,,Қаным жетпегендіктен ешкінің қанын пайдаландым.
Dialogue: 0,0:01:56.82,0:01:57.74,Default,,0,0,0,,Керемет емес
Dialogue: 0,0:01:58.28,0:02:00.62,Default,,0,0,0,,Қалаға қайт.
Dialogue: 0,0:02:01.16,0:02:04.41,Default,,0,0,0,,Егер ол суда өлі болса, қазір балыққа жем болар еді.
Dialogue: 0,0:02:05.00,0:02:07.54,Default,,0,0,0,,Сізді биікке көтерген адамға алғыс айтыңыз.
Dialogue: 0,0:02:08.50,0:02:10.04,Default,,0,0,0,,Мен оны көтерсем де...
Dialogue: 0,0:02:10.13,0:02:11.46,Default,,0,0,0,,Куро!
Dialogue: 0,0:02:11.54,0:02:13.96,Default,,0,0,0,,（）
Dialogue: 0,0:02:14.51,0:02:16.01,Default,,0,0,0,,Мен иісті білемін
Dialogue: 0,0:02:16.09,0:02:18.93,Default,,0,0,0,,Эльф… Таллман…
Dialogue: 0,0:02:19.01,0:02:21.85,Default,,0,0,0,,Жарты аяқ… Есік…
Dialogue: 0,0:02:21.93,0:02:23.60,Default,,0,0,0,,Қазына Оны ұрлағандар
Dialogue: 0,0:02:23.68,0:02:25.35,Default,,0,0,0,,Олар шынымен де олар ма?
Dialogue: 0,0:02:27.98,0:02:28.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:29.19,0:02:31.36,Default,,0,0,0,,Реанимация ақысын алу
Dialogue: 0,0:02:31.44,0:02:34.11,Default,,0,0,0,,Мен сені ешкі ақысын кешіремін.
Dialogue: 0,0:02:35.44,0:02:37.44,Default,,0,0,0,,Иә, мен сенімдімін...
Dialogue: 0,0:02:37.53,0:02:39.74,Default,,0,0,0,,Балықшылардың шабуылына...
Dialogue: 0,0:02:46.29,0:02:48.46,Default,,0,0,0,,Қайтадан өлген сияқты.
Dialogue: 0,0:02:49.04,0:02:50.96,Default,,0,0,0,,Иә, әрине
Dialogue: 0,0:02:51.83,0:02:53.00,Default,,0,0,0,,Авантюрист пе?
Dialogue: 0,0:02:56.38,0:02:56.96,Default,,0,0,0,,'Ол да сондай.'
Dialogue: 0,0:02:57.05,0:02:59.47,Default,,0,0,0,,А? Бұл не?
Dialogue: 0,0:02:59.55,0:03:01.72,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:03:02.59,0:03:03.80,Default,,0,0,0,,Жүр, Намари
Dialogue: 0,0:03:03.89,0:03:04.68,Default,,0,0,0,,Ұлы соғыс аяқталғаннан бері—
Dialogue: 0,0:03:08.43,0:03:10.73,Default,,0,0,0,,Гномдар да қорғаныс аймағына кіреді ме?
Dialogue: 0,0:03:10.81,0:03:12.90,Default,,0,0,0,,Сізде тәртіп жоқ.
Dialogue: 0,0:03:12.98,0:03:14.73,Default,,0,0,0,,Бойы ұзын адаммен араласыңыз.
Dialogue: 0,0:03:14.82,0:03:16.90,Default,,0,0,0,,Мен ешқашан таңдамағаным
Dialogue: 0,0:03:16.98,0:03:17.82,Default,,0,0,0,,Ахсо
Dialogue: 0,0:03:17.90,0:03:19.24,Default,,0,0,0,,Kyaa~
Dialogue: 0,0:03:19.32,0:03:20.61,Default,,0,0,0,,Тамақ жоқ!
Dialogue: 0,0:03:20.70,0:03:22.91,Default,,0,0,0,,Олар оны қайтадан ұрлады.
Dialogue: 0,0:03:22.99,0:03:23.82,Default,,0,0,0,,Тамақ…
Dialogue: 0,0:03:23.91,0:03:25.20,Default,,0,0,0,,Әзіл!
Dialogue: 0,0:03:25.28,0:03:26.99,Default,,0,0,0,,Тағы да...
Dialogue: 0,0:03:27.08,0:03:29.87,Default,,0,0,0,,Ақшаға қол тигізбей тек тамақ?
Dialogue: 0,0:03:29.96,0:03:31.83,Default,,0,0,0,,Қолыңызда ақша болды ма?
Dialogue: 0,0:03:32.37,0:03:33.79,Default,,0,0,0,,Мен ренжідім...
Dialogue: 0,0:03:33.88,0:03:35.75,Default,,0,0,0,,Міндетті түрде орындалуы керек
Dialogue: 0,0:03:35.84,0:03:37.17,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:03:37.71,0:03:39.17,Default,,0,0,0,,Ммм
Dialogue: 0,0:03:39.26,0:03:41.63,Default,,0,0,0,,Амал жоқ, қалаға қайтайық.
Dialogue: 0,0:03:41.72,0:03:43.39,Default,,0,0,0,,Эй, шын айтасың ба?
Dialogue: 0,0:03:43.47,0:03:45.43,Default,,0,0,0,,Қылмыскер бостандықта қалды ма?
Dialogue: 0,0:03:45.51,0:03:46.97,Default,,0,0,0,,Бірақ тамақ жоқ
Dialogue: 0,0:03:47.06,0:03:48.89,Default,,0,0,0,,Ары қарай жүре алмайсың.
Dialogue: 0,0:03:48.97,0:03:51.06,Default,,0,0,0,,Сіздің күшіңіз жеткіліксіз екенін мойындаңыз.
Dialogue: 0,0:03:52.02,0:03:53.65,Default,,0,0,0,,Сол адамдар маған айтқандай
Dialogue: 0,0:03:53.73,0:03:55.86,Default,,0,0,0,,Өмірің барына шүкіршілік ету керек.
Dialogue: 0,0:03:56.44,0:03:57.77,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:58.48,0:04:01.49,Default,,0,0,0,,Кабру солай шешсе, мен оның соңынан еремін.
Dialogue: 0,0:04:01.57,0:04:02.61,Default,,0,0,0,,Мен де
Dialogue: 0,0:04:02.70,0:04:06.07,Default,,0,0,0,,Қылмыскерді табудан бас тартпаймын деп уәде берсеңіз.
Dialogue: 0,0:04:06.16,0:04:07.62,Default,,0,0,0,,Бұл маған да жақсы.
Dialogue: 0,0:04:07.70,0:04:09.87,Default,,0,0,0,,Уәде беремін, Рин.
Dialogue: 0,0:04:09.95,0:04:12.12,Default,,0,0,0,,Куро Микбеллдің артынан келеді
Dialogue: 0,0:04:12.21,0:04:14.29,Default,,0,0,0,,Гунуну…
Dialogue: 0,0:04:14.37,0:04:15.54,Default,,0,0,0,,Хааа~
Dialogue: 0,0:04:15.63,0:04:18.59,Default,,0,0,0,,Бұл іздеу қызыл түсте.
Dialogue: 0,0:04:21.59,0:04:24.26,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:04:24.34,0:04:26.76,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:04:26.85,0:04:28.60,Default,,0,0,0,,Тұман шықты.
Dialogue: 0,0:04:29.47,0:04:30.27,Default,,0,0,0,,Барлығыңыз, сақ болыңыздар...
Dialogue: 0,0:04:31.85,0:04:32.60,Default,,0,0,0,,​​О?
Dialogue: 0,0:04:34.85,0:04:35.73,Default,,0,0,0,,(қылыштың тартылған дыбысы)
Dialogue: 0,0:04:35.81,0:04:38.27,Default,,0,0,0,,Табиғи тұман емес
Dialogue: 0,0:04:38.36,0:04:40.15,Default,,0,0,0,,Бұл жындардың ісі ме?
Dialogue: 0,0:04:42.03,0:04:44.15,Default,,0,0,0,,(сыбырлау)
Dialogue: 0,0:04:44.24,0:04:46.62,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:04:46.70,0:04:47.28,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:04:47.37,0:04:48.83,Default,,0,0,0,,Балықшы...?
Dialogue: 0,0:04:50.37,0:04:52.20,Default,,0,0,0,,Біз бұл көп нәрсені қашан алдық...
Dialogue: 0,0:04:52.87,0:04:53.79,Default,,0,0,0,,Не~!? (Официант) Бұл – «Ой-Пи», көріп тұрсыз ба.
Dialogue: 0,0:04:53.87,0:04:55.42,Default,,0,0,0,,Ей, менің мұны істеуден басқа амалым жоқ...
Dialogue: 0,0:04:55.50,0:04:56.92,Default,,0,0,0,,Охххх...
Dialogue: 0,0:04:57.00,0:04:57.92,Default,,0,0,0,,Келе жатыр!
Dialogue: 0,0:04:58.50,0:04:59.50,Default,,0,0,0,,О!
Dialogue: 0,0:04:59.59,0:05:00.42,Default,,0,0,0,,Уф... Уф
Dialogue: 0,0:05:00.50,0:05:01.38,Default,,0,0,0,,Урю~
Dialogue: 0,0:05:01.46,0:05:02.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:02.26,0:05:04.17,Default,,0,0,0,,Ohhhhh...
Dialogue: 0,0:05:04.76,0:05:07.68,Default,,0,0,0,,Бұл балта шабу сияқты қалай қолданылады
Dialogue: 0,0:05:07.76,0:05:11.01,Default,,0,0,0,,Мен бұл жолды өте жақсы білемін.
Dialogue: 0,0:05:11.77,0:05:12.68,Default,,0,0,0,,Иә.
Dialogue: 0,0:05:13.27,0:05:14.56,Default,,0,0,0,,Бұл...
Dialogue: 0,0:05:15.77,0:05:16.69,Default,,0,0,0,,Ei
Dialogue: 0,0:05:19.31,0:05:20.11,Default,,0,0,0,,Ааааааааааааааааааааа
Dialogue: 0,0:05:20.19,0:05:22.23,Default,,0,0,0,,Тынш, жарайды.
Dialogue: 0,0:05:22.32,0:05:23.24,Default,,0,0,0,,Сабыр сақта.
Dialogue: 0,0:05:23.86,0:05:24.49,Default,,0,0,0,,Алмаз
Dialogue: 0,0:05:24.57,0:05:25.65,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:05:25.74,0:05:26.91,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:05:29.16,0:05:30.74,Default,,0,0,0,,Бұл тұман – иллюзия сиқыры
Dialogue: 0,0:05:32.16,0:05:34.75,Default,,0,0,0,,Куро - тартылған қаруымен шатастырған адам.
Dialogue: 0,0:05:34.83,0:05:37.83,Default,,0,0,0,,Анау сол жерде аңырап тұрған Холм ма?
Dialogue: 0,0:05:37.92,0:05:41.00,Default,,0,0,0,,Көп нәрсе бірден бола қалса, қатып қалатын әдетім бар.
Dialogue: 0,0:05:41.09,0:05:43.51,Default,,0,0,0,,Мик ертерек қашып кеткен болуы керек.
Dialogue: 0,0:05:44.26,0:05:46.51,Default,,0,0,0,,...Қазіргі уақытта ең қауіптісі...
Dialogue: 0,0:05:47.84,0:05:49.51,Default,,0,0,0,,Лин…
Dialogue: 0,0:05:50.18,0:05:51.76,Default,,0,0,0,,Қараңдар, мен ән айтып жатырмын.
Dialogue: 0,0:05:52.43,0:05:55.77,Default,,0,0,0,,Ол осы бөлмедегілердің барлығын көмірге айналдыра алады.
Dialogue: 0,0:05:55.85,0:05:59.52,Default,,0,0,0,,Сиқыршының ән айтуын бейбіт түрде қалай тоқтатуға болады...
Dialogue: 0,0:06:04.78,0:06:05.61,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:06:05.69,0:06:06.53,Default,,0,0,0,,Ринша
Dialogue: 0,0:06:06.61,0:06:08.03,Default,,0,0,0,,Түсінесің бе?
Dialogue: 0,0:06:08.11,0:06:09.45,Default,,0,0,0,,Бұл галлюцинация
Dialogue: 0,0:06:10.87,0:06:12.78,Default,,0,0,0,,Құбыжық сияқты көрінетіні ұят.
Dialogue: 0,0:06:13.79,0:06:14.54,Default,,0,0,0,,Қазір...
Dialogue: 0,0:06:15.29,0:06:17.54,Default,,0,0,0,,Бұл сиқырлы тұманды тоқтату үшін...
Dialogue: 0,0:06:17.62,0:06:18.42,Default,,0,0,0,,Әй!
Dialogue: 0,0:06:19.50,0:06:20.00,Default,,0,0,0,,Әй!
Dialogue: 0,0:06:20.83,0:06:22.71,Default,,0,0,0,,- (Кабуру) Гуааах... - (Балықшы 3) Гуаааа
Dialogue: 0,0:06:22.79,0:06:24.13,Default,,0,0,0,,Уфф
Dialogue: 0,0:06:24.92,0:06:25.63,Default,,0,0,0,,(Көрермен) Мен оны мінген күйдегі шайқасқа дейін қызықты жігіт деп ойладым…
Dialogue: 0,0:06:28.05,0:06:29.97,Default,,0,0,0,,Бұл басқаша.
Dialogue: 0,0:06:30.05,0:06:33.47,Default,,0,0,0,,Сізге қару алып келе жатқан құюшы емес.
Dialogue: 0,0:06:33.56,0:06:36.43,Default,,0,0,0,,Саған бір қадам артқа қарай отырып.
Dialogue: 0,0:06:37.06,0:06:37.98,Default,,0,0,0,,Бәрі жақсы, мен бұны істей аламын!
Dialogue: 0,0:06:38.06,0:06:39.10,Default,,0,0,0,,Не...
Dialogue: 0,0:06:40.94,0:06:42.52,Default,,0,0,0,,Ки-иииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииии
Dialogue: 0,0:06:42.61,0:06:44.48,Default,,0,0,0,,Уау Уау
Dialogue: 0,0:06:51.07,0:06:53.78,Default,,0,0,0,,Шаршадым, шаршадым, берілемін.
Dialogue: 0,0:06:54.58,0:06:57.00,Default,,0,0,0,,Сіз мені жібере аласыз ба?
Dialogue: 0,0:06:57.83,0:06:59.25,Default,,0,0,0,,Бұл жігіттер...
Dialogue: 0,0:06:59.33,0:07:01.79,Default,,0,0,0,,Біз жоғарыда кездестірген дене жинаушы!
Dialogue: 0,0:07:02.42,0:07:05.50,Default,,0,0,0,,Бұл кездесу кездейсоқ емес сияқты.
Dialogue: 0,0:07:05.59,0:07:07.01,Default,,0,0,0,,Менің соңымнан ердің деп ойлаймын.
Dialogue: 0,0:07:07.09,0:07:09.09,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:07:09.17,0:07:12.18,Default,,0,0,0,,Мәйіттерді тереңірек қабаттап алу тиімдірек.
Dialogue: 0,0:07:12.26,0:07:14.22,Default,,0,0,0,,Арал гранттарымен
Dialogue: 0,0:07:15.39,0:07:18.93,Default,,0,0,0,,Біз ұрланған олжаны қайтаруға тырысамыз.
Dialogue: 0,0:07:19.02,0:07:21.85,Default,,0,0,0,,Қолайсыз деңгейге шықты
Dialogue: 0,0:07:21.94,0:07:23.98,Default,,0,0,0,,Бар болғаны баяу жүру керек
Dialogue: 0,0:07:24.06,0:07:26.44,Default,,0,0,0,,Пайдалы мәйітті жасау
Dialogue: 0,0:07:26.53,0:07:27.86,Default,,0,0,0,,Хаха...
Dialogue: 0,0:07:27.94,0:07:29.36,Default,,0,0,0,,Мен ренжідім...
Dialogue: 0,0:07:29.44,0:07:31.36,Default,,0,0,0,,Бірақ ол сәл баяу болды.
Dialogue: 0,0:07:31.45,0:07:34.20,Default,,0,0,0,,Олар бізді тапқанша, біз тірілеміз.
Dialogue: 0,0:07:34.28,0:07:36.45,Default,,0,0,0,,Мен жерге қайтатын болдым.
Dialogue: 0,0:07:37.16,0:07:39.70,Default,,0,0,0,,Дүрбелеңде сіз мәжбүрлі шараларды қолдандыңыз.
Dialogue: 0,0:07:39.79,0:07:41.87,Default,,0,0,0,,Иллюзиялық сиқырмен бірін-бірі өлтіру
Dialogue: 0,0:07:41.96,0:07:43.71,Default,,0,0,0,,Бұл сәл басқаша.
Dialogue: 0,0:07:43.79,0:07:46.84,Default,,0,0,0,,Расында, балалар, ұрыны қуып жеттіңдер.
Dialogue: 0,0:07:46.92,0:07:49.71,Default,,0,0,0,,Бір-бірімізді өлтірсек жақсы болар еді.
Dialogue: 0,0:07:49.80,0:07:51.26,Default,,0,0,0,,Өкінішті
Dialogue: 0,0:07:51.34,0:07:55.26,Default,,0,0,0,,Мен құбыжықтарға шабуыл жасап, тез өлемін деп ешқашан ойламадым.
Dialogue: 0,0:07:55.35,0:07:56.10,Default,,0,0,0,,Хаха
Dialogue: 0,0:07:56.18,0:07:57.43,Default,,0,0,0,,(ДжоДжо) Шынында да, ол адам болса жақсы болар еді.
Dialogue: 0,0:07:58.10,0:08:00.73,Default,,0,0,0,,Ұрлық пен авантюристер арасындағы төбелес ауыр қылмыс болып табылады.
Dialogue: 0,0:08:01.39,0:08:03.23,Default,,0,0,0,,Арал иесіне есеп беру
Dialogue: 0,0:08:03.31,0:08:04.90,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:05.65,0:08:07.02,Default,,0,0,0,,Сауда жасаймыз ба?
Dialogue: 0,0:08:07.11,0:08:09.82,Default,,0,0,0,,Үйге осылай барсаңыз, сіз де ұтыласыз.
Dialogue: 0,0:08:10.36,0:08:13.95,Default,,0,0,0,,Біздің екі дос сол жерде тұр.
Dialogue: 0,0:08:14.03,0:08:16.37,Default,,0,0,0,,Оларды реанимация станциясына апарыңыз.
Dialogue: 0,0:08:16.45,0:08:19.54,Default,,0,0,0,,Сіз лайықты ақша алуыңыз керек.
Dialogue: 0,0:08:19.62,0:08:21.79,Default,,0,0,0,,Олар ес-түссіз.
Dialogue: 0,0:08:24.25,0:08:26.88,Default,,0,0,0,,Сізге балықшы шабуыл жасағаны туралы куәлік беріңіз
Dialogue: 0,0:08:26.96,0:08:28.46,Default,,0,0,0,,Біздің үлесіміз
Dialogue: 0,0:08:28.55,0:08:33.59,Default,,0,0,0,,Дұрыс. 4 Жоқ, 30% жақсы.
Dialogue: 0,0:08:33.68,0:08:36.72,Default,,0,0,0,,Сіз қалай ойлайсыз? Мұның зияны жоқ, солай ма?
Dialogue: 0,0:08:39.64,0:08:41.48,Default,,0,0,0,,Жарайды, жақсы.
Dialogue: 0,0:08:42.98,0:08:44.39,Default,,0,0,0,,Кабру…
Dialogue: 0,0:08:51.86,0:08:52.90,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:08:55.36,0:08:57.66,Default,,0,0,0,,Не... тақырып?
Dialogue: 0,0:08:57.74,0:08:59.62,Default,,0,0,0,,Мен солай деп ойлаймын.
Dialogue: 0,0:08:59.70,0:09:00.91,Default,,0,0,0,,Әйтпесе
Dialogue: 0,0:09:01.50,0:09:02.20,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:09:02.29,0:09:03.21,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:03.29,0:09:05.21,Default,,0,0,0,,- (2-жинақтаушы) Арх! - (3-жинақтаушы) Уф!
Dialogue: 0,0:09:07.75,0:09:09.96,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:09:10.05,0:09:11.34,Default,,0,0,0,,Эй, сәлем...
Dialogue: 0,0:09:11.96,0:09:12.67,Default,,0,0,0,,Иә
Dialogue: 0,0:09:12.76,0:09:15.68,Default,,0,0,0,,Адамдардың оңай болғаны жақсы.
Dialogue: 0,0:09:15.76,0:09:17.72,Default,,0,0,0,,Ұзын адамдар, гномдар және гномдар
Dialogue: 0,0:09:17.80,0:09:20.18,Default,,0,0,0,,Барлығының негізгі ойлары бірдей
Dialogue: 0,0:09:20.26,0:09:22.47,Default,,0,0,0,,Денеңізді қалай қозғалтатыныңызға да қатысты.
Dialogue: 0,0:09:22.56,0:09:25.48,Default,,0,0,0,,Мұндай құбыжықтарға да оңайырақ болар еді.
Dialogue: 0,0:09:25.56,0:09:28.36,Default,,0,0,0,,Маған Chromic тауып бере аласыз ба?
Dialogue: 0,0:09:28.44,0:09:29.48,Default,,0,0,0,,Қосулы!
Dialogue: 0,0:09:29.56,0:09:30.73,Default,,0,0,0,,Кабру
Dialogue: 0,0:09:30.82,0:09:32.32,Default,,0,0,0,,Бұл жігітпен не істеуіміз керек?
Dialogue: 0,0:09:32.40,0:09:34.65,Default,,0,0,0,,Оған назар аудармауыңызды өтінемін.
Dialogue: 0,0:09:34.74,0:09:36.49,Default,,0,0,0,,Мен ештеңе білмедім
Dialogue: 0,0:09:37.11,0:09:40.16,Default,,0,0,0,,Хмф, мен де лабиринттің қарғысын бұзуды жоспарлап отырмын.
Dialogue: 0,0:09:40.24,0:09:42.74,Default,,0,0,0,,Құбыжықтарды жоюға ерік-жігер жоқ
Dialogue: 0,0:09:43.62,0:09:45.12,Default,,0,0,0,,Басқа адамнан алу арқылы
Dialogue: 0,0:09:45.21,0:09:47.50,Default,,0,0,0,,Күнделікті ақша табатындар саны артып келеді.
Dialogue: 0,0:09:47.58,0:09:49.46,Default,,0,0,0,,Бұл қарқынмен ешбір есі дұрыс адам жасай алмайды
Dialogue: 0,0:09:49.54,0:09:51.25,Default,,0,0,0,,Аралдан кету
Dialogue: 0,0:09:52.96,0:09:54.01,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:09:54.09,0:09:56.63,Default,,0,0,0,,Мен сен сияқтыларды кешіре алмаймын.
Dialogue: 0,0:09:56.72,0:09:58.39,Default,,0,0,0,,Тоқтатыңыз...
Dialogue: 0,0:09:58.47,0:10:00.64,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,0:10:00.72,0:10:02.97,Default,,0,0,0,,Уау...
Dialogue: 0,0:10:11.40,0:10:11.90,Default,,0,0,0,,(Суға құлау дыбысы)
Dialogue: 0,0:10:16.49,0:10:17.65,Default,,0,0,0,,Кабру
Dialogue: 0,0:10:17.74,0:10:18.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:18.49,0:10:20.82,Default,,0,0,0,,Аа... Ертерек үшін кешірім сұраймын.
Dialogue: 0,0:10:20.91,0:10:22.70,Default,,0,0,0,,Менің қолымнан келетіні осы ғана
Dialogue: 0,0:10:23.24,0:10:24.66,Default,,0,0,0,,(сүю дыбысы)
Dialogue: 0,0:10:24.74,0:10:26.04,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:10:26.12,0:10:27.83,Default,,0,0,0,,Мен білмеймін! Маған бұл қызықты емес!
Dialogue: 0,0:10:27.91,0:10:29.17,Default,,0,0,0,,жақсы болар еді...
Dialogue: 0,0:10:30.29,0:10:33.92,Default,,0,0,0,,Мен алға ұмтылуға тым уайымдаймын.
Dialogue: 0,0:10:34.00,0:10:35.01,Default,,0,0,0,,Иә.
Dialogue: 0,0:10:35.09,0:10:37.05,Default,,0,0,0,,Бұл менің асығымның жемісі.
Dialogue: 0,0:10:37.13,0:10:38.80,Default,,0,0,0,,ең нашар
Dialogue: 0,0:10:38.88,0:10:41.30,Default,,0,0,0,,Мені анда-санда жігерлендіріп отырсаңыз жақсы емес пе?
Dialogue: 0,0:10:41.39,0:10:43.56,Default,,0,0,0,,Алдаудың қажеті жоқ, солай ма?
Dialogue: 0,0:10:43.64,0:10:45.81,Default,,0,0,0,,Бұл біздің қазіргі қолымыз...
Dialogue: 0,0:10:45.89,0:10:46.98,Default,,0,0,0,,Хаха…
Dialogue: 0,0:10:47.06,0:10:48.14,Default,,0,0,0,,Арал иесі
Dialogue: 0,0:10:48.23,0:10:51.06,Default,,0,0,0,,Мен лабиринттерді тек ``пайда әкелетін тесіктер'' деп ойлаймын.
Dialogue: 0,0:10:51.15,0:10:52.86,Default,,0,0,0,,Алтын мен күміс таусылып қалса да
Dialogue: 0,0:10:52.94,0:10:55.82,Default,,0,0,0,,Мен құбыжықтардың терісі мен сүйегімен өмір сүре аламын деп ойлаймын.
Dialogue: 0,0:10:56.40,0:10:57.36,Default,,0,0,0,,Бірақ шын мәнінде
Dialogue: 0,0:10:57.44,0:11:00.66,Default,,0,0,0,,Толық зерттелген лабиринтке сүңгір ешкім жоқ.
Dialogue: 0,0:11:00.74,0:11:03.16,Default,,0,0,0,,Мүмкін тез байып кетемін деген арманым болмағандықтан болар.
Dialogue: 0,0:11:03.24,0:11:06.33,Default,,0,0,0,,Менің шытырман рухым қытықпағандықтан ба?
Dialogue: 0,0:11:06.41,0:11:09.83,Default,,0,0,0,,Адам саны азайып, адам саны одан да азайып барады.
Dialogue: 0,0:11:09.91,0:11:13.34,Default,,0,0,0,,Лабиринттен құбыжықтар ағып, тұрғындарды азаптайды.
Dialogue: 0,0:11:14.04,0:11:15.80,Default,,0,0,0,,Осылайша көптеген ауылдар
Dialogue: 0,0:11:15.88,0:11:17.21,Default,,0,0,0,,Ол қирап қалды.
Dialogue: 0,0:11:18.17,0:11:20.47,Default,,0,0,0,,Лабиринттің қарғысын тез жою керек.
Dialogue: 0,0:11:21.13,0:11:23.30,Default,,0,0,0,,Бұл дүниеде құбыжықтар мен лабиринттердің қажеті жоқ.
Dialogue: 0,0:11:23.97,0:11:24.64,Default,,0,0,0,,Иә
Dialogue: 0,0:11:27.43,0:11:28.89,Default,,0,0,0,,Менің қарным ашты...
Dialogue: 0,0:11:28.98,0:11:31.39,Default,,0,0,0,,Реанимациядан кейін бірден аштық сезінесіз.
Dialogue: 0,0:11:31.48,0:11:33.48,Default,,0,0,0,,Кабуру ~ Кабуру ~
Dialogue: 0,0:11:33.56,0:11:36.61,Default,,0,0,0,,Бұл балаларда өте көп құнды заттар бар.
Dialogue: 0,0:11:36.69,0:11:40.82,Default,,0,0,0,,Жарайды, тамақты ал да, қалғанын суға сал.
Dialogue: 0,0:11:40.90,0:11:42.61,Default,,0,0,0,,Иә? Раковина?
Dialogue: 0,0:11:42.70,0:11:43.82,Default,,0,0,0,,(Кабрудың күрсінуі)
Dialogue: 0,0:11:43.91,0:11:45.41,Default,,0,0,0,,Осыны бастайық
Dialogue: 0,0:11:45.49,0:11:47.24,Default,,0,0,0,,Біз де солар сияқтымыз, солай ма?
Dialogue: 0,0:11:47.95,0:11:51.00,Default,,0,0,0,,Одан кейін жеңіл тамақтанайық.
Dialogue: 0,0:11:51.08,0:11:53.00,Default,,0,0,0,,Қалай болғанда да, бұл қаһармандарды өлтіру миссиясын соңына дейін жеткізетін мен боламын.
Dialogue: 0,0:11:57.09,0:11:59.01,Default,,0,0,0,,Itadadakimasu
Dialogue: 0,0:11:59.09,0:11:59.71,Default,,0,0,0,,Аму
Dialogue: 0,0:11:59.80,0:12:00.76,Default,,0,0,0,,Дәмді!
Dialogue: 0,0:12:00.84,0:12:02.76,Default,,0,0,0,,Мен жақсы тамақ жеп жатырмын.
Dialogue: 0,0:12:02.84,0:12:04.97,Default,,0,0,0,,Мәйіттерді алу пайдалы болуы мүмкін.
Dialogue: 0,0:12:05.05,0:12:08.18,Default,,0,0,0,,Мәйітті өзіңіз жасап, үйге әкелмеңіз.
Dialogue: 0,0:12:08.26,0:12:10.64,Default,,0,0,0,,Тіпті аралдың иесі де байқамайды.
Dialogue: 0,0:12:10.73,0:12:14.15,Default,,0,0,0,,Аралдан сыйақы алу үшін шолу бар сияқты.
Dialogue: 0,0:12:14.23,0:12:17.40,Default,,0,0,0,,Олар өте жақсы орындаған сияқты.
Dialogue: 0,0:12:19.69,0:12:23.91,Default,,0,0,0,,Немесе кооперативтік қатынастарда басқа тараптардың күтпеген көп саны бар ма?
Dialogue: 0,0:12:23.99,0:12:25.91,Default,,0,0,0,,Бұл шірік~
Dialogue: 0,0:12:25.99,0:12:28.24,Default,,0,0,0,,Мен өзімді тұншықтырып жатсам да...
Dialogue: 0,0:12:28.33,0:12:30.16,Default,,0,0,0,,Арал иесіне есеп беру керек пе?
Dialogue: 0,0:12:30.25,0:12:33.83,Default,,0,0,0,,Арал иесі жақсы шешім табады деп ойламаймын.
Dialogue: 0,0:12:34.50,0:12:37.04,Default,,0,0,0,,Дони сияқты жаңадан келгендер жай ғана кесіп алады.
Dialogue: 0,0:12:37.13,0:12:38.80,Default,,0,0,0,,Әлгі ақымақ арал иесі
Dialogue: 0,0:12:38.88,0:12:40.84,Default,,0,0,0,,Қызық, салмақ қосып, жарылып кете берем бе?
Dialogue: 0,0:12:40.92,0:12:43.93,Default,,0,0,0,,Сонда саған пері ұшып келеді~
Dialogue: 0,0:12:44.01,0:12:47.30,Default,,0,0,0,,Әзірге біз оны толқын суы ретінде ұстауымыз керек...
Dialogue: 0,0:12:48.43,0:12:51.27,Default,,0,0,0,,...Солай болса да, Ұзын адам мен Гном
Dialogue: 0,0:12:51.35,0:12:53.31,Default,,0,0,0,,Жартылай және пері?
Dialogue: 0,0:12:53.39,0:12:54.56,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:12:54.64,0:12:58.06,Default,,0,0,0,,Бұл бізге аруақтардан құтылу үшін заклинание берген партия.
Dialogue: 0,0:12:58.15,0:13:00.23,Default,,0,0,0,,Әй, зергер ұры.
Dialogue: 0,0:13:00.32,0:13:01.90,Default,,0,0,0,,Тамақ ұры
Dialogue: 0,0:13:01.99,0:13:04.86,Default,,0,0,0,,Эльфтермен кештер онша көп емес.
Dialogue: 0,0:13:04.95,0:13:07.07,Default,,0,0,0,,Егер біз оны аздап ықшамдасақ, біз оны анықтай аламыз.
Dialogue: 0,0:13:07.95,0:13:09.58,Default,,0,0,0,,Дони мен Фионил?
Dialogue: 0,0:13:09.66,0:13:13.58,Default,,0,0,0,,Дони мен оның достарының үшінші жертөле қабатына жеткенін елестету қиын ба?
Dialogue: 0,0:13:13.66,0:13:16.33,Default,,0,0,0,,Төрт адам болғаны да мәселе емес пе?
Dialogue: 0,0:13:16.42,0:13:18.59,Default,,0,0,0,,Бұл сүңгудің абайсыз әдісі.
Dialogue: 0,0:13:19.46,0:13:20.63,Default,,0,0,0,,Лин Холм
Dialogue: 0,0:13:20.71,0:13:23.09,Default,,0,0,0,,Осы жын шығару техникасын көргенде не байқадың?
Dialogue: 0,0:13:23.17,0:13:24.88,Default,,0,0,0,,Сіз оны әлі киіп жүрсіз бе?
Dialogue: 0,0:13:24.97,0:13:26.84,Default,,0,0,0,,Бұл жай ғана дәлел.
Dialogue: 0,0:13:26.93,0:13:29.35,Default,,0,0,0,,Мен мұндай техниканы түсінбеймін.
Dialogue: 0,0:13:30.76,0:13:31.35,Default,,0,0,0,,Маған көрсет
Dialogue: 0,0:13:33.81,0:13:35.14,Default,,0,0,0,,Хмм.
Dialogue: 0,0:13:35.69,0:13:37.15,Default,,0,0,0,,«Үздік студент»
Dialogue: 0,0:13:37.23,0:13:39.65,Default,,0,0,0,,Оқулықтағы сипаттама сияқты сезіледі.
Dialogue: 0,0:13:39.73,0:13:42.11,Default,,0,0,0,,Ал мен үйренбеген шығармын.
Dialogue: 0,0:13:42.19,0:13:44.78,Default,,0,0,0,,Мүмкін ол шынымен сиқырлы мектептен шыққан шығар.
Dialogue: 0,0:13:44.86,0:13:47.82,Default,,0,0,0,,Ол жігіттердің барлығы бірдей формулаларды жазады.
Dialogue: 0,0:13:47.91,0:13:50.58,Default,,0,0,0,,Бұл эльфтер жазған техника екені сөзсіз.
Dialogue: 0,0:13:51.58,0:13:53.08,Default,,0,0,0,,Сиқырлы мектеп...
Dialogue: 0,0:13:53.95,0:13:58.37,Default,,0,0,0,,Huh~ «Сиқырлы мектеп» Мен көріп тұрмын…
Dialogue: 0,0:13:58.46,0:13:59.88,Default,,0,0,0,,​​Не? Бұл не?
Dialogue: 0,0:13:59.96,0:14:02.67,Default,,0,0,0,,А, жоқ, менде аздап түсінік бар...
Dialogue: 0,0:14:02.75,0:14:04.80,Default,,0,0,0,,Тек болжам...
Dialogue: 0,0:14:04.88,0:14:05.63,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:14:05.72,0:14:08.13,Default,,0,0,0,,Мен мұны дұрыс түсінсем, қуанар едім.
Dialogue: 0,0:14:08.22,0:14:10.72,Default,,0,0,0,,Бұл не? Бұл соншалықты үлкен.
Dialogue: 0,0:14:10.80,0:14:12.14,Default,,0,0,0,,Жақсы
Dialogue: 0,0:14:12.22,0:14:14.89,Default,,0,0,0,,Бұл Торден ағасы мен әпкесінің кеші.
Dialogue: 0,0:14:14.97,0:14:17.14,Default,,0,0,0,,Торден ше?
Dialogue: 0,0:14:17.23,0:14:19.81,Default,,0,0,0,,Қылмыс жасағым келмейді.
Dialogue: 0,0:14:19.90,0:14:20.90,Default,,0,0,0,,Неге негіз болып табылады?
Dialogue: 0,0:14:20.98,0:14:23.57,Default,,0,0,0,,Біріншіден, Төденнің сіңлісі
Dialogue: 0,0:14:23.65,0:14:25.90,Default,,0,0,0,,Мен оның сиқырлы мектептен шыққанына сенімдімін.
Dialogue: 0,0:14:25.99,0:14:28.66,Default,,0,0,0,,Саған тұмар салған пері болды, солай ма?
Dialogue: 0,0:14:28.74,0:14:30.74,Default,,0,0,0,,Бұл ағайындылар Таллман емес пе?
Dialogue: 0,0:14:30.82,0:14:33.28,Default,,0,0,0,,Ал, соңына дейін тыңдаңыз.
Dialogue: 0,0:14:33.37,0:14:37.29,Default,,0,0,0,,Кештегі пері менің әпкеммен жақсы қарым-қатынаста болды.
Dialogue: 0,0:14:37.37,0:14:40.46,Default,,0,0,0,,Баяғыдан бала күнгі достар сияқты
Dialogue: 0,0:14:41.08,0:14:44.80,Default,,0,0,0,,...Сондықтан біз бір сиқырлы мектепте өстік деп ойлаймын.
Dialogue: 0,0:14:44.88,0:14:48.05,Default,,0,0,0,,Мұнда сиқырлы мектеп бітірген адамдар сирек кездеседі.
Dialogue: 0,0:14:48.13,0:14:49.72,Default,,0,0,0,,Перілерді былай қойғанда.
Dialogue: 0,0:14:50.39,0:14:53.05,Default,,0,0,0,,Хмм, мен олай ойламаймын.
Dialogue: 0,0:14:53.14,0:14:54.89,Default,,0,0,0,,Барлығы осы.
Dialogue: 0,0:14:54.97,0:14:58.10,Default,,0,0,0,,Біріншіден, Таллманның иісі бір адамға арналған болса керек.
Dialogue: 0,0:14:58.18,0:15:00.81,Default,,0,0,0,,Аға-қарындас болса, екі кісілік болу керек... Әй!
Dialogue: 0,0:15:00.90,0:15:04.40,Default,,0,0,0,,Аз ғана адамдардың абайсызда суға түсуінің себебі осы ма?
Dialogue: 0,0:15:04.48,0:15:07.40,Default,,0,0,0,,Иә, мен не ағамнан, не әпкемнен айырылдым.
Dialogue: 0,0:15:07.49,0:15:10.70,Default,,0,0,0,,Мен оны құтқарамын ба, жоқ па деп достарыммен ұрысып қалдым.
Dialogue: 0,0:15:10.78,0:15:12.32,Default,,0,0,0,,Мен де ойлаймын...
Dialogue: 0,0:15:12.41,0:15:14.70,Default,,0,0,0,,Мен олардың бірінің жанынан ертерек өттім.
Dialogue: 0,0:15:14.78,0:15:18.58,Default,,0,0,0,,Олар біраз уақыттан бері өз мақсаттары мен табыстары үшін күресіп жүрген сияқты.
Dialogue: 0,0:15:18.66,0:15:22.13,Default,,0,0,0,,Осы оқиғадан кейін кейбір адамдар партиядан шығып кеткен шығар.
Dialogue: 0,0:15:22.21,0:15:25.46,Default,,0,0,0,,Ал мұқтаж, асыл бұйымдар мен азық-түлік...
Dialogue: 0,0:15:25.55,0:15:27.59,Default,,0,0,0,,Мүмкін бұл сәл нанымдырақ шығар...
Dialogue: 0,0:15:27.67,0:15:28.46,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:15:28.55,0:15:29.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:29.51,0:15:32.72,Default,,0,0,0,,Бірақ Куро оның да ергежейлі иісі шыққанын айтты.
Dialogue: 0,0:15:32.80,0:15:34.97,Default,,0,0,0,,Бұл керемет болды.
Dialogue: 0,0:15:35.05,0:15:36.35,Default,,0,0,0,,Бұл біртүрлі емес пе?
Dialogue: 0,0:15:36.43,0:15:38.27,Default,,0,0,0,,Неліктен ергежейлілер әлі де бар?
Dialogue: 0,0:15:38.35,0:15:40.60,Default,,0,0,0,,Мүмкін жаңа жалдау
Dialogue: 0,0:15:40.69,0:15:43.35,Default,,0,0,0,,Бұл партияда тағы кім бар?
Dialogue: 0,0:15:43.44,0:15:44.73,Default,,0,0,0,,Э-э-э—
Dialogue: 0,0:15:44.81,0:15:47.15,Default,,0,0,0,,Таллман - Лайос пен Фарин
Dialogue: 0,0:15:47.23,0:15:49.65,Default,,0,0,0,,Содан кейін Шығыстың Шросы болуы мүмкін
Dialogue: 0,0:15:49.74,0:15:52.03,Default,,0,0,0,,Мен бұрын кездескен гном Намариге.
Dialogue: 0,0:15:52.11,0:15:53.36,Default,,0,0,0,,Эльф Марсиль
Dialogue: 0,0:15:53.45,0:15:57.24,Default,,0,0,0,,Жартылай Чилчак деді ме?
Dialogue: 0,0:15:57.33,0:15:59.79,Default,,0,0,0,,Тоденнің ағасы мен әпкесінің кеші болса керек.
Dialogue: 0,0:15:59.87,0:16:02.96,Default,,0,0,0,,Ағайындылардың бірі мен Шуро Намари жоғалып кетті.
Dialogue: 0,0:16:03.04,0:16:05.67,Default,,0,0,0,,Бір жаңа ергежейлі қосылу керек...
Dialogue: 0,0:16:06.34,0:16:07.55,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:07.63,0:16:09.76,Default,,0,0,0,,Бұрынғы әйел Намари болатын.
Dialogue: 0,0:16:10.38,0:16:11.05,Default,,0,0,0,,(Юки) Қыз ба? (Миямура) Ұл ба?
Dialogue: 0,0:16:11.13,0:16:13.09,Default,,0,0,0,,Сіз бірдеңе білесіз бе? алмаз
Dialogue: 0,0:16:13.18,0:16:15.39,Default,,0,0,0,,Есімі әйгілі.
Dialogue: 0,0:16:15.47,0:16:18.18,Default,,0,0,0,,«Қару дүкені» деген адамның жалғыз қызы
Dialogue: 0,0:16:18.26,0:16:19.56,Default,,0,0,0,,«Қару дүкені»
Dialogue: 0,0:16:19.64,0:16:22.64,Default,,0,0,0,,Бұрын осы аралда қару-жарақ таратуды басқарған адам.
Dialogue: 0,0:16:23.73,0:16:27.07,Default,,0,0,0,,Бірақ бір күні қомақты ақша табылып, ол жоғалып кетті.
Dialogue: 0,0:16:27.61,0:16:31.40,Default,,0,0,0,,Арал иесінің ергежейлілер туралы жаман әсер қалдыруының бір себебі деуге болады.
Dialogue: 0,0:16:31.49,0:16:34.61,Default,,0,0,0,,Осының кесірінен көптеген гномдар зардап шекті.
Dialogue: 0,0:16:35.28,0:16:36.41,Default,,0,0,0,,Мен де
Dialogue: 0,0:16:36.95,0:16:40.24,Default,,0,0,0,,Әдепті ергежейлі мұндай күйде отырмайды деп ойлаймын...
Dialogue: 0,0:16:40.75,0:16:42.91,Default,,0,0,0,,Сіз кәдімгі ергежейлі емессіз, солай ма?
Dialogue: 0,0:16:43.54,0:16:45.83,Default,,0,0,0,,Негізі бұл иіс қорқынышты.
Dialogue: 0,0:16:45.92,0:16:48.88,Default,,0,0,0,,Мен де Чилчакты білемін.
Dialogue: 0,0:16:48.96,0:16:50.67,Default,,0,0,0,,Мен қартпын, бірақ
Dialogue: 0,0:16:50.76,0:16:54.05,Default,,0,0,0,,Аралдағы жарты футтық халықтың өкілі сияқтысың.
Dialogue: 0,0:16:54.76,0:16:57.93,Default,,0,0,0,,«Біреумен келісім-шартқа отырғанда, кәсіподақ арқылы өтіңіз».
Dialogue: 0,0:16:58.01,0:17:01.06,Default,,0,0,0,,Содан кейін ол: «Сіз делдалдық төлемді төлеуіңіз керек» деген сияқты сөздерді айтудан қайтпайды.
Dialogue: 0,0:17:01.64,0:17:04.44,Default,,0,0,0,,Мен оған кіре алмағандықтан қашып жүрмін.
Dialogue: 0,0:17:04.52,0:17:06.15,Default,,0,0,0,,Өйткені олар менің коболдтарды жалдағанымды білсе ше?
Dialogue: 0,0:17:06.23,0:17:08.15,Default,,0,0,0,,Адамдар «мүлдем» сияқты сөздерді айтады
Dialogue: 0,0:17:08.65,0:17:10.19,Default,,0,0,0,,Бұл дұрыс емес, солай емес пе?
Dialogue: 0,0:17:10.27,0:17:12.44,Default,,0,0,0,,Куро мені жұмысқа алғысы келеді.
Dialogue: 0,0:17:12.53,0:17:15.20,Default,,0,0,0,,Мик, маған тамақ бер, жақсы жұмыс беруші.
Dialogue: 0,0:17:15.28,0:17:16.45,Default,,0,0,0,,… өтіңіз.
Dialogue: 0,0:17:16.53,0:17:19.87,Default,,0,0,0,,Мен олардың төмен жалақы үшін көп жұмыс істейтініне сенімдімін.
Dialogue: 0,0:17:19.95,0:17:22.95,Default,,0,0,0,,Холм Мен мұны болжамға сүйене отырып айтып отырған жоқпын.
Dialogue: 0,0:17:23.04,0:17:26.71,Default,,0,0,0,,Демек, шығыстағы Таллман Риннің туған жерінен, солай ма?
Dialogue: 0,0:17:26.79,0:17:28.00,Default,,0,0,0,,Мүмкін олар таныс болған шығар.
Dialogue: 0,0:17:28.67,0:17:29.46,Default,,0,0,0,,Эй...
Dialogue: 0,0:17:29.54,0:17:31.80,Default,,0,0,0,,Олардың барлығын шығыстықтармен біріктірмеңіз.
Dialogue: 0,0:17:32.34,0:17:34.76,Default,,0,0,0,,Орынына қарай тіл түсінбей қалуы мүмкін.
Dialogue: 0,0:17:34.84,0:17:37.51,Default,,0,0,0,,Шро менің аралыма жатпайды.
Dialogue: 0,0:17:38.05,0:17:40.47,Default,,0,0,0,,Мүмкін мен бұл туралы көбірек білетін шығармын.
Dialogue: 0,0:17:40.56,0:17:43.73,Default,,0,0,0,,Ол жерде де аздап өзгермелі болды.
Dialogue: 0,0:17:43.81,0:17:46.19,Default,,0,0,0,,Мен бір туған қаладағы достарыммен аралға бардым.
Dialogue: 0,0:17:46.27,0:17:48.73,Default,,0,0,0,,Торденнің партиясына жалғыз қосылды.
Dialogue: 0,0:17:49.31,0:17:51.27,Default,,0,0,0,,Атмосфера формальды емес сияқты.
Dialogue: 0,0:17:51.36,0:17:54.24,Default,,0,0,0,,Лабиринтті сынау шеберлікті сынау сияқты көрінді.
Dialogue: 0,0:17:54.32,0:17:57.11,Default,,0,0,0,,Ол партиядан шықты ма?
Dialogue: 0,0:17:57.20,0:18:00.49,Default,,0,0,0,,Ол сыйақы немесе тәуекел туралы ойламаған сияқты...
Dialogue: 0,0:18:00.58,0:18:02.99,Default,,0,0,0,,Ағам да, әпкем де кетеді деп ойламаппын.
Dialogue: 0,0:18:03.08,0:18:05.87,Default,,0,0,0,,Ол қалды... Жоқ, солай емес пе...
Dialogue: 0,0:18:05.96,0:18:09.54,Default,,0,0,0,,Кабуру адамдарды қорқынышты түрде еске алады.
Dialogue: 0,0:18:09.63,0:18:11.13,Default,,0,0,0,,Неліктен бұл көңілді болып көрінеді?
Dialogue: 0,0:18:11.21,0:18:13.63,Default,,0,0,0,,Бұл қызық, бұл өте қызық
Dialogue: 0,0:18:14.21,0:18:16.17,Default,,0,0,0,,Бұл аралда көптеген адамдар бар.
Dialogue: 0,0:18:16.26,0:18:18.51,Default,,0,0,0,,Олардың әрқайсысы әртүрлі ниетпен әрекет етеді.
Dialogue: 0,0:18:18.59,0:18:21.76,Default,,0,0,0,,Бірақ бір-біріне ұқсамайтын әрекеттер бір-біріне тамаша сәйкес келгенде,
Dialogue: 0,0:18:21.85,0:18:25.18,Default,,0,0,0,,Көптеген адамдарды қамтитын тарихи оқиғаға айналады
Dialogue: 0,0:18:25.27,0:18:27.31,Default,,0,0,0,,Мен бұл қызық ұрлық ісі деп ойладым.
Dialogue: 0,0:18:27.39,0:18:29.48,Default,,0,0,0,,Менде бір қызық нәрсе болатын сияқты.
Dialogue: 0,0:18:29.98,0:18:32.86,Default,,0,0,0,,Тоден аға мен апаның кеші болар деп үміттенемін.
Dialogue: 0,0:18:32.94,0:18:35.65,Default,,0,0,0,,Өйткені мен көптен бері осындамын
Dialogue: 0,0:18:35.74,0:18:38.91,Default,,0,0,0,,Мен олардың құбыжық терісінің қабыршақтайтын кезін күттім.
Dialogue: 0,0:18:38.99,0:18:41.16,Default,,0,0,0,,Тағдырдың бір түрі бар ма?
Dialogue: 0,0:18:41.24,0:18:43.16,Default,,0,0,0,,Маған ештеңе жасалған сияқты емес.
Dialogue: 0,0:18:43.24,0:18:46.87,Default,,0,0,0,,Ол баяғыда зергерлер тобында жұмыс істеп байлыққа кенелсе керек.
Dialogue: 0,0:18:46.95,0:18:50.17,Default,,0,0,0,,Бірақ ауру немесе жарақат салдарынан лабиринтке сүңгій алмайтын достарым үшін.
Dialogue: 0,0:18:50.25,0:18:52.17,Default,,0,0,0,,Мен табысымның көп бөлігін бердім.
Dialogue: 0,0:18:52.25,0:18:53.13,Default,,0,0,0,,өтіңіз
Dialogue: 0,0:18:53.21,0:18:54.17,Default,,0,0,0,,Бұл жақсы әңгіме.
Dialogue: 0,0:18:54.25,0:18:56.01,Default,,0,0,0,,Иә, әдемі әңгіме екен.
Dialogue: 0,0:18:56.09,0:18:58.17,Default,,0,0,0,,Бірақ бұл оқиғада тағы да көп нәрсе бар.
Dialogue: 0,0:18:58.76,0:19:02.18,Default,,0,0,0,,Олар ақшаны толық қалпына келтіріп қойғанына қарамастан алды.
Dialogue: 0,0:19:02.26,0:19:05.18,Default,,0,0,0,,Ақырында, олар ешқашан авантюрист болып оралмады.
Dialogue: 0,0:19:05.26,0:19:07.52,Default,,0,0,0,,Ол қазір аралда ұрланған тауарларды сатады.
Dialogue: 0,0:19:08.02,0:19:11.35,Default,,0,0,0,,«Бәрі лабиринт иесін жеңген адамға беріледі».
Dialogue: 0,0:19:12.06,0:19:14.77,Default,,0,0,0,,Бұл елдің патшасы болып көрінетін адамның артында қалған сөздері болса керек.
Dialogue: 0,0:19:15.27,0:19:18.90,Default,,0,0,0,,Сіз шынымен бәрін ала аласыз ба, жоқ па, қарамастан.
Dialogue: 0,0:19:18.99,0:19:22.57,Default,,0,0,0,,Бұл лабиринттің өзі ежелгі эльфтерден қалған жәдігер.
Dialogue: 0,0:19:22.66,0:19:25.28,Default,,0,0,0,,Оның ықпалы зор болатыны сөзсіз.
Dialogue: 0,0:19:25.95,0:19:26.70,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:19:26.79,0:19:30.00,Default,,0,0,0,,Менің ойымша, бұл аға мен әпке болмауы керек.
Dialogue: 0,0:19:30.54,0:19:32.46,Default,,0,0,0,,Олар жақсы адамдар емес
Dialogue: 0,0:19:32.54,0:19:34.25,Default,,0,0,0,,Оны адамдар қызықтырмайды.
Dialogue: 0,0:19:34.79,0:19:36.75,Default,,0,0,0,,Сол арал иесімен бірдей.
Dialogue: 0,0:19:37.30,0:19:39.30,Default,,0,0,0,,Мен Кабруды білемін
Dialogue: 0,0:19:39.38,0:19:41.72,Default,,0,0,0,,Біз сізді жалғыз деп ойлаймыз
Dialogue: 0,0:19:41.80,0:19:44.22,Default,,0,0,0,,Сондай-ақ ақымақ арал иесін қуып жібереді.
Dialogue: 0,0:19:44.30,0:19:47.22,Default,,0,0,0,,Бұл жердегі құбыжықтармен күресу сізге қиынға соғатын сияқты.
Dialogue: 0,0:19:47.31,0:19:49.48,Default,,0,0,0,,Бізде әлі көп жол бар.
Dialogue: 0,0:19:49.56,0:19:51.27,Default,,0,0,0,,Әкеміз шашыңды көрсе, сені кешірмес еді.
Dialogue: 0,0:19:51.35,0:19:53.40,Default,,0,0,0,,Ал, қазір кетейік.
Dialogue: 0,0:19:53.48,0:19:55.94,Default,,0,0,0,,Еш қиындықсыз үйге барасыз деп үміттенемін...
Dialogue: 0,0:20:01.90,0:20:03.87,Default,,0,0,0,,-Уау! Бұл қауіпті - бұл жүзді балық.
Dialogue: 0,0:20:05.20,0:20:06.70,Default,,0,0,0,,Балыққа алаңдамаңыз!
Dialogue: 0,0:20:06.78,0:20:08.37,Default,,0,0,0,,Әркім өз қадамыңды бақылаңыз... А!
Dialogue: 0,0:20:12.54,0:20:14.83,Default,,0,0,0,,Кракен... Жоқ, бұл Шисерпент!
Dialogue: 0,0:20:14.92,0:20:17.04,Default,,0,0,0,,- (Кабуру) Лин! Кетіңіз... -Ән
Dialogue: 0,0:20:18.38,0:20:19.05,Default,,0,0,0,,Холм!
Dialogue: 0,0:20:19.13,0:20:21.72,Default,,0,0,0,,Бұл жағдайда оны шығару мүмкін емес...
Dialogue: 0,0:20:21.80,0:20:23.38,Default,,0,0,0,,Біртүрлі нәрселер араласып кетеді!
Dialogue: 0,0:20:24.05,0:20:24.72,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:20:27.97,0:20:28.97,Default,,0,0,0,,Дүрбелеңге түспеңіз
Dialogue: 0,0:20:29.06,0:20:31.06,Default,,0,0,0,,Сен бірдеңе істейсің, Кабру.
Dialogue: 0,0:20:31.56,0:20:33.98,Default,,0,0,0,,Қимылдары күрделі тіршілік иесі емес
Dialogue: 0,0:20:34.06,0:20:37.36,Default,,0,0,0,,Қарсыласыңыздың қимылын бағалаңыз, ол ұйқы артериясы немесе басқа нәрсе болсын...
Dialogue: 0,0:20:38.52,0:20:40.03,Default,,0,0,0,,Жоқ, бұл қайда, ұйқы артериясы!
Dialogue: 0,0:20:40.11,0:20:40.86,Default,,0,0,0,,<Мен оны «Спайс» деп атаймын➡
Dialogue: 0,0:20:43.36,0:20:43.91,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:20:43.99,0:20:45.11,Default,,0,0,0,,Хмм, Таде!
Dialogue: 0,0:20:45.20,0:20:46.99,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:20:50.29,0:20:52.50,Default,,0,0,0,,Бала! өтінемін!
Dialogue: 0,0:20:53.08,0:20:53.92,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:20:56.25,0:20:57.00,Default,,0,0,0,,(қаптау дыбысы)
Dialogue: 0,0:20:57.08,0:20:58.96,Default,,0,0,0,,(суға құлау дыбысы)
Dialogue: 0,0:20:59.05,0:20:59.92,Default,,0,0,0,,Бала!
Dialogue: 0,0:21:01.80,0:21:03.13,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:21:03.76,0:21:05.18,Default,,0,0,0,,Киіміңіз лас па?
Dialogue: 0,0:21:05.26,0:21:06.14,Default,,0,0,0,,(Чунтарo) Чип… (Танжиро) Ә?
Dialogue: 0,0:21:06.22,0:21:07.30,Default,,0,0,0,,Сіз шаршаған болуыңыз керек.
Dialogue: 0,0:21:07.39,0:21:09.43,Default,,0,0,0,,Неге мұнда тамақ ішпейсің...
Dialogue: 0,0:21:09.51,0:21:11.27,Default,,0,0,0,,Жақсы, асығыңыз
Dialogue: 0,0:21:12.31,0:21:14.27,Default,,0,0,0,,Менің де саған қатысты мәселем бар.
Dialogue: 0,0:21:14.35,0:21:17.36,Default,,0,0,0,,Ол солтүстік әйелге әбден ғашық сияқты.
Dialogue: 0,0:21:17.44,0:21:18.02,Default,,0,0,0,,(асқазанның айқайлауы)
Dialogue: 0,0:21:18.11,0:21:20.52,Default,,0,0,0,,Тэде қарны ашты.
Dialogue: 0,0:21:20.61,0:21:22.61,Default,,0,0,0,,Кабуру~ Сіз ауырып қалдыңыз ба?
Dialogue: 0,0:21:22.69,0:21:24.90,Default,,0,0,0,,-(Кабуру) Жоспарлардың өзгеруі -А?
Dialogue: 0,0:21:24.99,0:21:27.41,Default,,0,0,0,,А-а, шалғаммен қайнатса дәмді болмай ма?
Dialogue: 0,0:21:27.49,0:21:28.07,Default,,0,0,0,,Сен ақымақсың ба?
Dialogue: 0,0:21:28.16,0:21:29.16,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:21:29.24,0:21:32.91,Default,,0,0,0,,Маған қауіпті жағдайда көмектескеніңіз үшін рахмет.
Dialogue: 0,0:21:33.00,0:21:36.04,Default,,0,0,0,,Менің атым Кабру. Атыңызды сұрасам бола ма?
Dialogue: 0,0:21:36.12,0:21:37.42,Default,,0,0,0,,Бұл туралы алаңдамаңыз
Dialogue: 0,0:21:37.50,0:21:39.17,Default,,0,0,0,,Мен жаңа ғана өтіп бара жатқанмын.
Dialogue: 0,0:21:40.13,0:21:41.92,Default,,0,0,0,,Қателеспесем...
Dialogue: 0,0:21:42.00,0:21:44.42,Default,,0,0,0,,Мүмкін сіз әйел іздеп жүрген шығарсыз?
Dialogue: 0,0:21:44.51,0:21:45.51,Default,,0,0,0,,Әй!
Dialogue: 0,0:21:45.59,0:21:47.59,Default,,0,0,0,,Сіз бірдеңе білесіз бе?
Dialogue: 0,0:21:47.68,0:21:49.30,Default,,0,0,0,,Ах... күткендей.
Dialogue: 0,0:21:49.39,0:21:50.72,Default,,0,0,0,,Суицид үшін кешірім сұраймын.
Dialogue: 0,0:21:51.22,0:21:54.02,Default,,0,0,0,,Мүмкін мен сізге көмектесермін.
Dialogue: 0,0:21:54.73,0:21:57.14,Default,,0,0,0,,Фарин Торденді іздеу туралы
Dialogue: 0,0:21:57.98,0:21:58.98,Default,,0,0,0,,Colla
Dialogue: 0,0:21:59.06,0:22:00.44,Default,,0,0,0,,Куро Бұл өрнекті жасайтын адам
Dialogue: 0,0:22:00.52,0:22:02.40,Default,,0,0,0,,Тоқта дедім, қорқынышты...
Dialogue: 0,0:22:03.07,0:22:05.36,Default,,0,0,0,,Не болды?
Dialogue: 0,0:22:05.44,0:22:07.03,Default,,0,0,0,,Осылайша Кабрус
Dialogue: 0,0:22:07.11,0:22:09.91,Default,,0,0,0,,Мен тағы да зынданға сүңгіуді жөн көрдім.
Dialogue: 0,0:22:10.95,0:22:13.24,Default,,0,0,0,,Уақыт кері кетеді, Лайос және т.б
Dialogue: 0,0:22:13.74,0:22:15.96,Default,,0,0,0,,Қайтару жарияланғаннан кейін толық екі күн
Dialogue: 0,0:22:17.16,0:22:18.42,Default,,0,0,0,,Бұл тұйыққа тіреледі.
Dialogue: 0,0:22:18.50,0:22:20.42,Default,,0,0,0,,Тағы бір тұйық...
Dialogue: 0,0:22:22.00,0:22:23.75,Default,,0,0,0,,Менің қарным ашты...
Dialogue: 0,0:22:23.84,0:22:24.92,Default,,0,0,0,,(Аизава) Қорытынды емтихандар жақындап келеді—
Dialogue: 0,0:22:25.01,0:22:26.42,Default,,0,0,0,,шөлдеген
Dialogue: 0,0:22:27.13,0:22:29.80,Default,,0,0,0,,Мен адасып, өліп қала жаздадым.
Dialogue: 0,0:22:31.01,0:22:33.01,Default,,0,0,0,,♪~
Dialogue: 0,0:23:58.18,0:24:00.18,Default,,0,0,0,,~♪
Dialogue: 0,0:24:01.68,0:24:07.68,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory