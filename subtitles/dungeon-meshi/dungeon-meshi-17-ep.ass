Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.00,0:00:03.00,Default,,0,0,0,,♪~
Dialogue: 0,0:01:26.50,0:01:28.50,Default,,0,0,0,,~♪
Dialogue: 0,0:01:41.26,0:01:42.72,Default,,0,0,0,,Жоқ, шынымен
Dialogue: 0,0:01:43.31,0:01:46.52,Default,,0,0,0,,Қара магия қорқынышты емес, солай емес пе?
Dialogue: 0,0:01:47.19,0:01:50.06,Default,,0,0,0,,Қайта тірілу керек еді?
Dialogue: 0,0:01:50.15,0:01:53.03,Default,,0,0,0,,Шлоу мырзаның ашулы болғаны таңқаларлық емес.
Dialogue: 0,0:01:53.11,0:01:56.49,Default,,0,0,0,,Сіз мені осындай жат жолмен өмірге әкелдіңіз.
Dialogue: 0,0:01:56.57,0:01:58.32,Default,,0,0,0,,Тәуекелден басқа ештеңе жоқ, солай ма?
Dialogue: 0,0:01:58.91,0:02:01.03,Default,,0,0,0,,Оның өліміне жол бергені жақсы болар еді...
Dialogue: 0,0:02:01.12,0:02:02.08,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:02:03.33,0:02:05.16,Default,,0,0,0,,Өйткені мен сіздің не айтқыңыз келетінін түсіндім.
Dialogue: 0,0:02:06.04,0:02:07.50,Default,,0,0,0,,Енді жоқ, өтінемін.
Dialogue: 0,0:02:08.67,0:02:09.96,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:10.54,0:02:11.54,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:02:12.04,0:02:15.51,Default,,0,0,0,,Мен Шлоу мырзаның мұны терең түсінетініне сенімдімін.
Dialogue: 0,0:02:16.17,0:02:18.51,Default,,0,0,0,,Егер сіз де дәл осындай жағдайда болсаңыз
Dialogue: 0,0:02:18.59,0:02:20.47,Default,,0,0,0,,Сол әдісті таңдамадыңыз ба?
Dialogue: 0,0:02:20.55,0:02:22.97,Default,,0,0,0,,Мен білемін! Мен білемін, бірақ
Dialogue: 0,0:02:23.06,0:02:24.85,Default,,0,0,0,,Мына жігіттің мінезі тым көп!
Dialogue: 0,0:02:25.47,0:02:26.89,Default,,0,0,0,,Мен құбыжықтарды жедім
Dialogue: 0,0:02:26.98,0:02:29.52,Default,,0,0,0,,Бұл естеліктері бар жалын айдаһар ма?
Dialogue: 0,0:02:29.60,0:02:31.44,Default,,0,0,0,,Қараңдар, қараңдар! құбыжық қылыш
Dialogue: 0,0:02:31.52,0:02:35.03,Default,,0,0,0,,Мен қара сиқырды қолдандым, бірақ Шроу бұл туралы үндемейді, солай ма?
Dialogue: 0,0:02:35.11,0:02:36.19,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:02:36.28,0:02:37.61,Default,,0,0,0,,Қалай болғанда да
Dialogue: 0,0:02:37.69,0:02:39.15,Default,,0,0,0,,Мен сенің не ойлайтыныңды білемін
Dialogue: 0,0:02:39.24,0:02:40.20,Default,,0,0,0,,Ал біз болсақ, жай ғана
Dialogue: 0,0:02:41.20,0:02:42.70,Default,,0,0,0,,Мен тіпті түсінбеймін деп ойлаймын.
Dialogue: 0,0:02:43.49,0:02:44.70,Default,,0,0,0,,Ынтымақтастық мүмкін емес.
Dialogue: 0,0:02:45.41,0:02:46.70,Default,,0,0,0,,Лайос Сенси
Dialogue: 0,0:02:47.45,0:02:48.21,Default,,0,0,0,,Кәсібі: тыңшы
Dialogue: 0,0:02:48.29,0:02:51.58,Default,,0,0,0,,Бір топ құбыжықтар ас әзірлеу тобына кірді...
Dialogue: 0,0:02:52.96,0:02:54.38,Default,,0,0,0,,Сіз не істедіңіз?
Dialogue: 0,0:02:55.00,0:02:57.59,Default,,0,0,0,,Мен саған осы уақытқа дейін болғанның бәрін айттым.
Dialogue: 0,0:02:58.59,0:02:59.63,Default,,0,0,0,,Барлығы?
Dialogue: 0,0:02:59.72,0:03:01.76,Default,,0,0,0,,Шро түсінеді деп үміттенемін.
Dialogue: 0,0:03:01.84,0:03:03.76,Default,,0,0,0,,Қалай қарасаң да, ең сорақысы.
Dialogue: 0,0:03:03.85,0:03:04.64,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:03:04.72,0:03:08.73,Default,,0,0,0,,Не? Менің кінәм ба? Бұл менің пікірімдегі қателік пе?
Dialogue: 0,0:03:09.23,0:03:11.10,Default,,0,0,0,,Көңіл көтеру
Dialogue: 0,0:03:11.19,0:03:13.23,Default,,0,0,0,,Ол да аздап шаршады.
Dialogue: 0,0:03:15.52,0:03:17.69,Default,,0,0,0,,Мен оны құрметтеймін
Dialogue: 0,0:03:17.78,0:03:21.49,Default,,0,0,0,,Менің шытырман оқиғам кезінде мені қанша рет құтқарғанын білмеймін.
Dialogue: 0,0:03:22.28,0:03:25.24,Default,,0,0,0,,Мен өз елімді және осы аралды ғана білемін
Dialogue: 0,0:03:25.33,0:03:27.87,Default,,0,0,0,,Маған шет елдер туралы әңгімелеп берді.
Dialogue: 0,0:03:27.95,0:03:31.50,Default,,0,0,0,,Шлоу әрқашан байсалды және ақылды болды.
Dialogue: 0,0:03:32.79,0:03:35.21,Default,,0,0,0,,Сондықтан ашуланады.
Dialogue: 0,0:03:35.79,0:03:38.01,Default,,0,0,0,,Мен өте жаман нәрсе жасаған болуым керек.
Dialogue: 0,0:03:38.51,0:03:42.01,Default,,0,0,0,,Достығымыздың осылай аяқталғаны өкінішті...
Dialogue: 0,0:03:42.09,0:03:44.18,Default,,0,0,0,,Гяхахаха…
Dialogue: 0,0:03:44.26,0:03:45.43,Default,,0,0,0,,Гяхахаха…
Dialogue: 0,0:03:45.51,0:03:46.81,Default,,0,0,0,,-Уау! -Уф
Dialogue: 0,0:03:46.89,0:03:49.31,Default,,0,0,0,,(Гарпилердің күлкісі)
Dialogue: 0,0:03:49.89,0:03:50.77,Default,,0,0,0,,Гарпи
Dialogue: 0,0:03:51.89,0:03:52.56,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,0:03:52.64,0:03:54.56,Default,,0,0,0,,Камado Танжиро.
Dialogue: 0,0:03:54.65,0:03:56.27,Default,,0,0,0,,Рачи түсініксіз.
Dialogue: 0,0:03:56.36,0:03:58.48,Default,,0,0,0,,Әсеби Кеттік үшеуің!
Dialogue: 0,0:04:00.65,0:04:01.82,Default,,0,0,0,,А…?
Dialogue: 0,0:04:01.90,0:04:05.70,Default,,0,0,0,,Мен Райостың жігіті Шроға болған жағдайдың бәрін айтып бердім.
Dialogue: 0,0:04:05.78,0:04:08.04,Default,,0,0,0,,О, бұл атмосфера?
Dialogue: 0,0:04:08.12,0:04:10.16,Default,,0,0,0,,Шро - банка
Dialogue: 0,0:04:10.25,0:04:12.96,Default,,0,0,0,,Егер ол жер бетінде анықталса, не істеуіміз керек...
Dialogue: 0,0:04:13.04,0:04:15.13,Default,,0,0,0,,Мен білемін, білемін, бірақ...
Dialogue: 0,0:04:15.21,0:04:15.96,Default,,0,0,0,,Бұл – Огимотоя.
Dialogue: 0,0:04:16.79,0:04:17.46,Default,,0,0,0,,Жасайық
Dialogue: 0,0:04:17.54,0:04:20.46,Default,,0,0,0,,Ниндзялар жақсы жұмыс істеп жатқан сияқты.
Dialogue: 0,0:04:20.55,0:04:23.13,Default,,0,0,0,,Әйтеуір, тағы кім біледі?
Dialogue: 0,0:04:23.22,0:04:26.55,Default,,0,0,0,,Қазіргі уақытта 4 адам: Шлоу және оның 2 әйел қызметшісі.
Dialogue: 0,0:04:27.26,0:04:29.22,Default,,0,0,0,,Ал анау бұйра шашты жігіт
Dialogue: 0,0:04:30.39,0:04:31.10,Default,,0,0,0,,Иә
Dialogue: 0,0:04:32.35,0:04:35.73,Default,,0,0,0,,Бұл адам қазына жәндіктерімен жойылған адам болды, солай ма?
Dialogue: 0,0:04:36.52,0:04:38.02,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:04:38.11,0:04:39.19,Default,,0,0,0,,Сол жігіт пен оның адамдарының бәрі Стэнд қолданушылары сияқты
Dialogue: 0,0:04:39.27,0:04:43.11,Default,,0,0,0,,Сіз олжаңыз бен тағамыңызды ұрлаған адамды іздеп жүрген шығарсыз.
Dialogue: 0,0:04:43.20,0:04:45.20,Default,,0,0,0,,Түсініспеушілікті жоюым керек.
Dialogue: 0,0:04:45.28,0:04:49.08,Default,,0,0,0,,олжа - қазына қателері, ал тамақ суға батып, жойылды!
Dialogue: 0,0:04:49.16,0:04:49.70,Default,,0,0,0,,Идиот!
Dialogue: 0,0:04:50.66,0:04:53.21,Default,,0,0,0,,Мәселе қара магияда.
Dialogue: 0,0:04:53.79,0:04:55.92,Default,,0,0,0,,Шро ашуланады, бірақ проблема жоқ.
Dialogue: 0,0:04:56.63,0:04:59.84,Default,,0,0,0,,Фаринге қауіп төндіргеніміз үшін ол бізге ашулы.
Dialogue: 0,0:05:00.42,0:05:02.30,Default,,0,0,0,,Ал басқалары ше...
Dialogue: 0,0:05:03.17,0:05:05.84,Default,,0,0,0,,Айтпақшы, сіздің қара магияны қолданғаныңызға ешқандай дәлел жоқ.
Dialogue: 0,0:05:05.93,0:05:07.22,Default,,0,0,0,,Қанша қалды?
Dialogue: 0,0:05:07.30,0:05:08.18,Default,,0,0,0,,Хмм.
Dialogue: 0,0:05:08.26,0:05:11.64,Default,,0,0,0,,Сиқырлы шеңбер тазалаушының кесірінен жоғалып кетті.
Dialogue: 0,0:05:11.72,0:05:14.56,Default,,0,0,0,,Егер сіз Фариннің денесі мен таяғын мұқият қарап шықсаңыз.
Dialogue: 0,0:05:14.64,0:05:16.35,Default,,0,0,0,,Жаман болуы мүмкін...?
Dialogue: 0,0:05:16.44,0:05:18.36,Default,,0,0,0,,Олай болса, таяқты қазір өрте.
Dialogue: 0,0:05:18.44,0:05:19.61,Default,,0,0,0,,Күтіңіз, күтіңіз!
Dialogue: 0,0:05:19.69,0:05:22.03,Default,,0,0,0,,Сіздің күдіктеріңіз сол кезеңге жеткенде, ештеңе істеуге кеш болады...
Dialogue: 0,0:05:22.11,0:05:22.99,Default,,0,0,0,,(құлау дыбысы)
Dialogue: 0,0:05:23.74,0:05:24.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:25.57,0:05:26.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:26.36,0:05:28.49,Default,,0,0,0,,Уау! Анау, анау!
Dialogue: 0,0:05:31.08,0:05:32.95,Default,,0,0,0,,Бұл не құбыжық?
Dialogue: 0,0:05:33.04,0:05:35.37,Default,,0,0,0,,Гарпи... жоқ
Dialogue: 0,0:05:41.67,0:05:43.01,Default,,0,0,0,,(тықылдаған дыбыс)
Dialogue: 0,0:05:44.42,0:05:47.51,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:05:47.59,0:05:50.01,Default,,0,0,0,,Ах, аа... хаа...
Dialogue: 0,0:05:52.81,0:05:54.06,Default,,0,0,0,,(қанаттардың дыбысы)
Dialogue: 0,0:05:54.56,0:05:56.02,Default,,0,0,0,,Өзіме пластырь жапсыра аламын.
Dialogue: 0,0:05:56.89,0:05:58.52,Default,,0,0,0,,Өтірік Өтірік Неге...
Dialogue: 0,0:05:59.48,0:06:00.52,Default,,0,0,0,,Фари…
Dialogue: 0,0:06:03.15,0:06:04.53,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:06:06.11,0:06:06.95,Default,,0,0,0,,Бұл...
Dialogue: 0,0:06:08.45,0:06:09.91,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:06:13.24,0:06:15.08,Default,,0,0,0,,(Гарпилердің күлкісі)
Dialogue: 0,0:06:15.16,0:06:17.54,Default,,0,0,0,,Керемет!
Dialogue: 0,0:06:19.75,0:06:21.84,Default,,0,0,0,,Бірақ сіз тым сараң емессіз бе?
Dialogue: 0,0:06:21.92,0:06:24.30,Default,,0,0,0,,Қанаттары, қауырсындары және қабыршақтары бар...
Dialogue: 0,0:06:24.38,0:06:25.26,Default,,0,0,0,,Фарин!
Dialogue: 0,0:06:25.76,0:06:27.38,Default,,0,0,0,,Сіз мені түсінесіз бе?
Dialogue: 0,0:06:27.47,0:06:28.80,Default,,0,0,0,,Кел, Марсиль!
Dialogue: 0,0:06:28.88,0:06:30.05,Default,,0,0,0,,Құлдым!
Dialogue: 0,0:06:30.14,0:06:31.30,Default,,0,0,0,,(құлау дыбысы)
Dialogue: 0,0:06:32.22,0:06:34.47,Default,,0,0,0,,Холм Лин шайқасқа дайын!
Dialogue: 0,0:06:34.56,0:06:35.31,Default,,0,0,0,,Иә
Dialogue: 0,0:06:35.39,0:06:38.77,Default,,0,0,0,,Лайос Шро, мен не істеуім керек? Маған нұсқау беріңіз!
Dialogue: 0,0:06:38.85,0:06:39.81,Default,,0,0,0,,Ит балық!
Dialogue: 0,0:06:39.90,0:06:42.65,Default,,0,0,0,,Оны ренжітпе! Ұстаңыз!
Dialogue: 0,0:06:42.73,0:06:44.15,Default,,0,0,0,,Аа~ иә?
Dialogue: 0,0:06:44.23,0:06:46.74,Default,,0,0,0,,Қашуға болмайды, кішкентай бала... Уф.
Dialogue: 0,0:06:49.20,0:06:49.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:52.74,0:06:53.37,Default,,0,0,0,,Ах
Dialogue: 0,0:06:54.58,0:06:55.79,Default,,0,0,0,,Гуруруруру Руаааа...
Dialogue: 0,0:06:55.87,0:06:57.54,Default,,0,0,0,,Уаааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:06:59.37,0:07:00.96,Default,,0,0,0,,Grrrrrrrrrrr!
Dialogue: 0,0:07:02.33,0:07:03.00,Default,,0,0,0,,Незуко! Мен төмен түсемін
Dialogue: 0,0:07:03.09,0:07:04.75,Default,,0,0,0,,Ууууууу!
Dialogue: 0,0:07:04.84,0:07:05.92,Default,,0,0,0,,Кяаааааааааааааааааааааааааааа
Dialogue: 0,0:07:06.71,0:07:10.59,Default,,0,0,0,,Ум, басып ал, басып ал, зиянсыз басып ал.
Dialogue: 0,0:07:10.68,0:07:12.18,Default,,0,0,0,,Зиянсыз қолға түсті ме?
Dialogue: 0,0:07:13.01,0:07:14.89,Default,,0,0,0,,Нуаааааа~
Dialogue: 0,0:07:20.23,0:07:20.89,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:21.48,0:07:22.90,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:07:26.48,0:07:27.61,Default,,0,0,0,,Барсам болады ма? голм
Dialogue: 0,0:07:27.69,0:07:28.90,Default,,0,0,0,,Ум...
Dialogue: 0,0:07:30.15,0:07:32.24,Default,,0,0,0,,Жарайды, шық...
Dialogue: 0,0:07:32.74,0:07:33.99,Default,,0,0,0,,Хмм... Хмм...
Dialogue: 0,0:07:34.99,0:07:37.70,Default,,0,0,0,,Хмм... аааа...
Dialogue: 0,0:07:37.79,0:07:39.83,Default,,0,0,0,,Хмм... аа
Dialogue: 0,0:07:39.91,0:07:42.04,Default,,0,0,0,,Гах ха ха...
Dialogue: 0,0:07:42.12,0:07:44.04,Default,,0,0,0,,Ха ха…
Dialogue: 0,0:07:45.42,0:07:46.42,Default,,0,0,0,,(жаншылған дыбыс)
Dialogue: 0,0:07:50.63,0:07:51.55,Default,,0,0,0,,А...?
Dialogue: 0,0:07:52.84,0:07:55.14,Default,,0,0,0,,Кяаааааааааааааааааааааа
Dialogue: 0,0:07:55.22,0:07:56.01,Default,,0,0,0,,Фарин!
Dialogue: 0,0:07:56.10,0:07:57.93,Default,,0,0,0,,Болдырмау...
Dialogue: 0,0:07:58.01,0:07:59.77,Default,,0,0,0,,Сіз мұны басқарасыз ба?
Dialogue: 0,0:07:59.85,0:08:03.40,Default,,0,0,0,,Тоқтатыңызшы, ол жай ғана абдырап қалды.
Dialogue: 0,0:08:03.48,0:08:04.35,Default,,0,0,0,,(тілді шертеді)
Dialogue: 0,0:08:04.98,0:08:06.19,Default,,0,0,0,,Қалағаныңды істе!
Dialogue: 0,0:08:06.73,0:08:09.23,Default,,0,0,0,,Жақындарыңызды қорғау үшін
Dialogue: 0,0:08:09.32,0:08:11.65,Default,,0,0,0,,Қанша адамның құрбандыққа шалынғаны маңызды ма?
Dialogue: 0,0:08:11.74,0:08:12.82,Default,,0,0,0,,(Фариннің айқайы)
Dialogue: 0,0:08:12.90,0:08:14.66,Default,,0,0,0,,Бұл «қыз» емес
Dialogue: 0,0:08:15.24,0:08:16.32,Default,,0,0,0,,Бұл жай ғана құбыжық!
Dialogue: 0,0:08:20.12,0:08:21.91,Default,,0,0,0,,Рудеролар
Dialogue: 0,0:08:22.00,0:08:23.04,Default,,0,0,0,,Арнбиде
Dialogue: 0,0:08:28.30,0:08:29.63,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:08:30.55,0:08:32.55,Default,,0,0,0,,Ах... Мэрили
Dialogue: 0,0:08:32.63,0:08:34.22,Default,,0,0,0,,Сіз де сиқыр жасайсыз ба...
Dialogue: 0,0:08:34.30,0:08:37.47,Default,,0,0,0,,Гуруруруру…
Dialogue: 0,0:08:42.06,0:08:44.48,Default,,0,0,0,,Гуруруру!
Dialogue: 0,0:08:44.56,0:08:46.23,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:48.57,0:08:50.11,Default,,0,0,0,,Уау Куро!
Dialogue: 0,0:08:50.19,0:08:51.61,Default,,0,0,0,,Жүр, ақымақ, тығыл!
Dialogue: 0,0:08:54.82,0:08:55.61,Default,,0,0,0,,Фарин…
Dialogue: 0,0:09:01.83,0:09:03.16,Default,,0,0,0,,Түнгі күзетші келеді. Көзіңді жұмшы.
Dialogue: 0,0:09:03.25,0:09:05.33,Default,,0,0,0,,Орбисті төмендетеді!
Dialogue: 0,0:09:13.13,0:09:16.05,Default,,0,0,0,,(Фариннің айқайы)
Dialogue: 0,0:09:17.64,0:09:18.64,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:09:21.06,0:09:22.81,Default,,0,0,0,,Құбыжықтар қауіпті
Dialogue: 0,0:09:23.77,0:09:26.10,Default,,0,0,0,,Боқ, Кенсуке, сен құбыжықсың ғой...
Dialogue: 0,0:09:26.94,0:09:28.15,Default,,0,0,0,,(Кенсукенің діріл дыбысы)
Dialogue: 0,0:09:30.36,0:09:31.69,Default,,0,0,0,,Кешіріңіз Фарин
Dialogue: 0,0:09:32.32,0:09:35.36,Default,,0,0,0,,Егер мені ауыстыруға болатын болса, оның орнына мұны істегім келді.
Dialogue: 0,0:09:35.95,0:09:37.86,Default,,0,0,0,,(қылыштың тартылған дыбысы)
Dialogue: 0,0:09:44.62,0:09:46.37,Default,,0,0,0,,Лайос аға...
Dialogue: 0,0:09:46.46,0:09:47.12,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:56.17,0:09:56.76,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,0:09:56.84,0:09:57.51,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:09:58.13,0:09:59.18,Default,,0,0,0,,Фарин!
Dialogue: 0,0:09:59.26,0:10:00.68,Default,,0,0,0,,Өкпе! бүйрек!
Dialogue: 0,0:10:01.47,0:10:02.51,Default,,0,0,0,,Жүрек!
Dialogue: 0,0:10:03.47,0:10:04.85,Default,,0,0,0,,Не!
Dialogue: 0,0:10:09.52,0:10:10.19,Default,,0,0,0,,Аһ!
Dialogue: 0,0:10:10.77,0:10:11.44,Default,,0,0,0,,Ga!
Dialogue: 0,0:10:14.15,0:10:14.73,Default,,0,0,0,,О, батыр!
Dialogue: 0,0:10:14.82,0:10:15.86,Default,,0,0,0,,Уф
Dialogue: 0,0:10:15.94,0:10:18.49,Default,,0,0,0,,Гяаааааа...
Dialogue: 0,0:10:18.57,0:10:19.61,Default,,0,0,0,,Сіз тұра аласыз ба?
Dialogue: 0,0:10:19.70,0:10:21.62,Default,,0,0,0,,Көңілсіз болғаным үшін кешіріңіз.
Dialogue: 0,0:10:21.70,0:10:23.37,Default,,0,0,0,,Дұрыс айтасыз.
Dialogue: 0,0:10:23.45,0:10:24.62,Default,,0,0,0,,Менің әпкемнің жаны
Dialogue: 0,0:10:25.29,0:10:27.83,Default,,0,0,0,,Қазір лабиринт шеберінің бақылауында болса керек.
Dialogue: 0,0:10:29.83,0:10:33.59,Default,,0,0,0,,Бірақ егер сіз оны өлтірсеңіз, тағы бір ашуланған сиқыршы шығады.
Dialogue: 0,0:10:33.67,0:10:35.63,Default,,0,0,0,,Енді мен бұл жерден кетуім керек.
Dialogue: 0,0:10:35.71,0:10:37.17,Default,,0,0,0,,- (Кабуру) Сонымен... - Уф!
Dialogue: 0,0:10:37.26,0:10:38.63,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:40.30,0:10:41.26,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:42.26,0:10:43.85,Default,,0,0,0,,Маған біртіндеп орал
Dialogue: 0,0:10:43.93,0:10:47.10,Default,,0,0,0,,У-у-у-у
Dialogue: 0,0:10:47.18,0:10:48.27,Default,,0,0,0,,Фарин…
Dialogue: 0,0:10:48.35,0:10:50.27,Default,,0,0,0,,Ахххх...!
Dialogue: 0,0:10:50.35,0:10:51.27,Default,,0,0,0,,Ей!
Dialogue: 0,0:10:51.35,0:10:54.94,Default,,0,0,0,,Ууууууууууууууууууууууууууууу...!
Dialogue: 0,0:10:56.57,0:10:57.32,Default,,0,0,0,,Құбыжық!
Dialogue: 0,0:10:57.40,0:11:01.11,Default,,0,0,0,,Ruderoes Ejectulum Hemtum
Dialogue: 0,0:11:01.78,0:11:03.07,Default,,0,0,0,,Бұл техника...
Dialogue: 0,0:11:03.16,0:11:05.08,Default,,0,0,0,,Барлығың менің қасымда болыңдар!
Dialogue: 0,0:11:05.16,0:11:07.83,Default,,0,0,0,,Уаааааа...
Dialogue: 0,0:11:07.91,0:11:09.79,Default,,0,0,0,,Аххх...
Dialogue: 0,0:11:09.87,0:11:12.00,Default,,0,0,0,,(көрнекті дыбыс)
Dialogue: 0,0:11:12.08,0:11:13.17,Default,,0,0,0,,Эсси!
Dialogue: 0,0:11:13.25,0:11:19.72,Default,,0,0,0,,Ааааааааааааа...
Dialogue: 0,0:11:23.51,0:11:26.43,Default,,0,0,0,,(жығылған дыбыс)
Dialogue: 0,0:11:27.56,0:11:28.18,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:11:28.27,0:11:29.98,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:11:30.06,0:11:33.10,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:11:33.19,0:11:36.86,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:11:37.48,0:11:38.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:41.78,0:11:43.03,Default,,0,0,0,,Мүмкін мен қайта оралатын шығармын
Dialogue: 0,0:11:43.11,0:11:45.12,Default,,0,0,0,,Зардап шеккен адамдарды тосқауылға көшіру.
Dialogue: 0,0:11:45.70,0:11:48.83,Default,,0,0,0,,Өлгендермен не істеуіміз керек... мм...
Dialogue: 0,0:11:49.83,0:11:51.46,Default,,0,0,0,,Мен тірілемін
Dialogue: 0,0:11:51.96,0:11:53.63,Default,,0,0,0,,Бұл әркімнің қолынан келе бермейді.
Dialogue: 0,0:11:54.83,0:11:56.46,Default,,0,0,0,,Мәйіттерді жинаймыз ба?
Dialogue: 0,0:11:56.54,0:11:58.80,Default,,0,0,0,,Жоқ, жоқ, қозғалма.
Dialogue: 0,0:11:58.88,0:12:01.38,Default,,0,0,0,,Төгілген қанның бір тамшысы да босқа кетпейді.
Dialogue: 0,0:12:04.14,0:12:06.43,Default,,0,0,0,,А... құбыжықтар ше?
Dialogue: 0,0:12:06.51,0:12:08.72,Default,,0,0,0,,Мен қашып кеттім. Қазір бәрі жақсы.
Dialogue: 0,0:12:09.43,0:12:10.48,Default,,0,0,0,,Енді, келесі...
Dialogue: 0,0:12:10.56,0:12:12.89,Default,,0,0,0,,Күте тұрыңыз, егер сіз алдымен сол адамды тірілткіңіз келсе...
Dialogue: 0,0:12:15.86,0:12:16.98,Default,,0,0,0,,Неге мен?
Dialogue: 0,0:12:17.98,0:12:20.90,Default,,0,0,0,,Мен Майзуру-санды күшті сиқыршы ретінде көрдім.
Dialogue: 0,0:12:20.99,0:12:23.82,Default,,0,0,0,,Емдеу және реанимация әдістерін қолдануға болады деп ойладым...
Dialogue: 0,0:12:24.41,0:12:27.16,Default,,0,0,0,,Барлығын өз бетімен емдей алмайды.
Dialogue: 0,0:12:27.70,0:12:31.29,Default,,0,0,0,,Жолда көрсеткен көмегіңіз үшін рахмет.
Dialogue: 0,0:12:31.37,0:12:32.66,Default,,0,0,0,,Сіз несие алдыңыз ба?
Dialogue: 0,0:12:32.75,0:12:35.54,Default,,0,0,0,,Сіз бәрібір басқа әдісті іздеп жүргеніңізге сенімдімін.
Dialogue: 0,0:12:35.63,0:12:38.17,Default,,0,0,0,,Жарайды, мен оны тез бітіремін.
Dialogue: 0,0:12:38.75,0:12:41.26,Default,,0,0,0,,Егер менде қарапайым реанимация техникасы болса...
Dialogue: 0,0:12:41.34,0:12:42.17,Default,,0,0,0,,Тоқта
Dialogue: 0,0:12:42.76,0:12:44.47,Default,,0,0,0,,Оны бір саусақпен ұстамаңыз
Dialogue: 0,0:12:45.09,0:12:48.22,Default,,0,0,0,,Мен саған енді қара магияны қолдануға рұқсат ете алмаймын.
Dialogue: 0,0:12:49.39,0:12:51.06,Default,,0,0,0,,Оны қолданбаңыз...
Dialogue: 0,0:12:51.14,0:12:52.52,Default,,0,0,0,,Сонда бұл не?
Dialogue: 0,0:12:52.60,0:12:54.60,Default,,0,0,0,,Ол неге олай көрінеді?
Dialogue: 0,0:12:54.69,0:12:57.94,Default,,0,0,0,,Бұл айдаһардың еті мен қара магияны пайдаланғаны үшін болуы керек!
Dialogue: 0,0:12:58.02,0:12:59.98,Default,,0,0,0,,Жоқ! Бұл шындық болуы мүмкін емес
Dialogue: 0,0:13:00.07,0:13:02.07,Default,,0,0,0,,Бұл сиқырдың мұндай күші жоқ!
Dialogue: 0,0:13:02.69,0:13:05.66,Default,,0,0,0,,Бірақ... мүмкін болса...
Dialogue: 0,0:13:06.16,0:13:09.49,Default,,0,0,0,,Қызыл айдаһардың рухында қандай да бір қулық бар.
Dialogue: 0,0:13:10.24,0:13:12.25,Default,,0,0,0,,Фарин мен айдаһардың жаны аралас.
Dialogue: 0,0:13:12.33,0:13:15.08,Default,,0,0,0,,Ашуланған сиқыршының қолынан бұл ...
Dialogue: 0,0:13:16.17,0:13:17.33,Default,,0,0,0,,Schro…
Dialogue: 0,0:13:17.42,0:13:19.42,Default,,0,0,0,,Мына жігітті батыстағы эльфтерге тапсыр.
Dialogue: 0,0:13:20.42,0:13:22.38,Default,,0,0,0,,Мен бұл нәрсені өлтіре алмаймын.
Dialogue: 0,0:13:22.46,0:13:24.72,Default,,0,0,0,,Бірақ біз оны сол күйінде қалдыра алмаймыз.
Dialogue: 0,0:13:25.55,0:13:28.47,Default,,0,0,0,,Ең болмағанда жаным лабиринттен құтылар.
Dialogue: 0,0:13:28.55,0:13:30.64,Default,,0,0,0,,Мен оны тыныштандырғым келеді.
Dialogue: 0,0:13:31.51,0:13:32.47,Default,,0,0,0,,Бұл...
Dialogue: 0,0:13:32.56,0:13:34.68,Default,,0,0,0,,Эльфтер мұны қалай жасау керектігін білуі керек.
Dialogue: 0,0:13:35.85,0:13:38.73,Default,,0,0,0,,Батыстың эльфтерінің алдында бәрін мойындаңыз.
Dialogue: 0,0:13:38.81,0:13:42.23,Default,,0,0,0,,Тоқта, Шлоу, басқа жол болуы керек.
Dialogue: 0,0:13:42.32,0:13:43.57,Default,,0,0,0,,бірақ мен міндетті түрде Незуконы қайтадан адамға айналдырамын.
Dialogue: 0,0:13:43.65,0:13:45.74,Default,,0,0,0,,Балалар, осы уақытқа дейін не істедіңдер?
Dialogue: 0,0:13:45.82,0:13:48.74,Default,,0,0,0,,Басқа жол? Сіз не істемексіз?
Dialogue: 0,0:13:49.28,0:13:50.91,Default,,0,0,0,,Ол қайтып келгенше
Dialogue: 0,0:13:50.99,0:13:53.41,Default,,0,0,0,,Өзіңізді қандай да бір құбыжықтың етімен тірілтіп көргіңіз келе ме?
Dialogue: 0,0:13:54.58,0:13:55.46,Default,,0,0,0,,Айт!
Dialogue: 0,0:13:55.54,0:13:57.71,Default,,0,0,0,,Сіз не істеуді жоспарлап отырсыз?
Dialogue: 0,0:13:58.29,0:13:59.46,Default,,0,0,0,,Сізде идея бар ма?
Dialogue: 0,0:13:59.54,0:14:00.84,Default,,0,0,0,,Айт!
Dialogue: 0,0:14:04.26,0:14:05.17,Default,,0,0,0,,Хмм
Dialogue: 0,0:14:06.59,0:14:09.14,Default,,0,0,0,,Ашуланған сиқыршыны жеңіңіз!
Dialogue: 0,0:14:09.22,0:14:13.10,Default,,0,0,0,,Бұл қызыл айдаһар бұйрық бойынша әрекет еткені анық.
Dialogue: 0,0:14:13.18,0:14:14.52,Default,,0,0,0,,Мұны кім жасай алады?
Dialogue: 0,0:14:14.60,0:14:17.06,Default,,0,0,0,,Бұл лабиринтті жасаған сиқыршыдан басқа ешкім жоқ.
Dialogue: 0,0:14:17.77,0:14:19.60,Default,,0,0,0,,Содан кейін сиқыршыны өлтіріңіз
Dialogue: 0,0:14:19.69,0:14:21.31,Default,,0,0,0,,Тек нұсқауларды қайта жазыңыз!
Dialogue: 0,0:14:21.86,0:14:24.03,Default,,0,0,0,,Мен бұл туралы шынымен білмеймін.
Dialogue: 0,0:14:24.11,0:14:26.44,Default,,0,0,0,,Марсиль мұны істей алуы керек.
Dialogue: 0,0:14:26.53,0:14:28.24,Default,,0,0,0,,Сондықтан мен саған Марсильді бере алмаймын!
Dialogue: 0,0:14:28.74,0:14:30.91,Default,,0,0,0,,Бір сәт!
Dialogue: 0,0:14:30.99,0:14:33.16,Default,,0,0,0,,Қара магиядан туындаған мәселелер
Dialogue: 0,0:14:33.24,0:14:35.25,Default,,0,0,0,,Сен оны қара магиямен шешпексің бе?
Dialogue: 0,0:14:35.33,0:14:37.50,Default,,0,0,0,,Егер біз нәрселер туралы біршама байыпты ойласақ ше...
Dialogue: 0,0:14:37.58,0:14:38.33,Default,,0,0,0,,(тықылдаған дыбыс)
Dialogue: 0,0:14:39.54,0:14:41.04,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:14:41.13,0:14:43.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:44.71,0:14:45.38,Default,,0,0,0,,Ах! Кешіріңіз...
Dialogue: 0,0:14:45.46,0:14:47.22,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:14:50.76,0:14:52.68,Default,,0,0,0,,- Уф Эй - (Баяу) Уф
Dialogue: 0,0:14:54.26,0:14:57.48,Default,,0,0,0,,Менің онша шебер емес екенім рас.
Dialogue: 0,0:14:57.56,0:15:00.06,Default,,0,0,0,,Сіз авантюристтердің көпшілігінен күштісіз.
Dialogue: 0,0:15:00.98,0:15:03.94,Default,,0,0,0,,Бірақ... Мен мұны анық айта аламын.
Dialogue: 0,0:15:04.77,0:15:06.82,Default,,0,0,0,,Күніне үш рет тамақтаныңыз.
Dialogue: 0,0:15:06.90,0:15:10.24,Default,,0,0,0,,Біз ұйықтап жатқандар әлдеқайда байсалды еді!
Dialogue: 0,0:15:11.45,0:15:12.16,Default,,0,0,0,,Қараңдар!
Dialogue: 0,0:15:12.24,0:15:15.83,Default,,0,0,0,,Біз құтырған сиқыршыны міндетті түрде жеңеміз.
Dialogue: 0,0:15:15.91,0:15:17.66,Default,,0,0,0,,Мен Фаринді міндетті түрде құтқарамын!
Dialogue: 0,0:15:17.75,0:15:20.33,Default,,0,0,0,,Шуро, жер бетіне қайту керек.
Dialogue: 0,0:15:20.42,0:15:23.33,Default,,0,0,0,,Олай болса тамақ іш, шомыл, ұйықта!
Dialogue: 0,0:15:23.42,0:15:24.63,Default,,0,0,0,,(Шлоудың күңкілдеген дауысы)
Dialogue: 0,0:15:24.71,0:15:25.55,Default,,0,0,0,,Әй?
Dialogue: 0,0:15:25.63,0:15:27.17,Default,,0,0,0,,(Шлоудың күңкілдеген дауысы)
Dialogue: 0,0:15:27.26,0:15:28.55,Default,,0,0,0,,Не?
Dialogue: 0,0:15:29.72,0:15:32.80,Default,,0,0,0,,Шулы!
Dialogue: 0,0:15:34.72,0:15:37.06,Default,,0,0,0,,Шайқас әлі бітпеген шығар.
Dialogue: 0,0:15:37.14,0:15:40.39,Default,,0,0,0,,Егер сіз келіссеңіз, менің де бір ойым бар.
Dialogue: 0,0:15:40.89,0:15:41.81,Default,,0,0,0,,Ойлар...
Dialogue: 0,0:15:41.89,0:15:42.98,Default,,0,0,0,,бірақ ол да маған күдікпен қарады…
Dialogue: 0,0:15:43.06,0:15:45.27,Default,,0,0,0,,Мен...
Dialogue: 0,0:15:46.07,0:15:47.40,Default,,0,0,0,,Ұзақ уақыт бойы
Dialogue: 0,0:15:48.11,0:15:50.61,Default,,0,0,0,,Мен сені жақтырмай тұра алмадым.
Dialogue: 0,0:15:51.24,0:15:54.12,Default,,0,0,0,,Өйткені сіз өте сызбасыз және сезімталсыз.
Dialogue: 0,0:15:54.20,0:15:55.58,Default,,0,0,0,,Нашар уақыт!
Dialogue: 0,0:15:55.66,0:15:57.49,Default,,0,0,0,,Ей, көп шетелдік әңгімелер
Dialogue: 0,0:15:57.58,0:15:59.91,Default,,0,0,0,,Иә? Тамақ беруге уәде ме? Мен де барамын!
Dialogue: 0,0:16:00.00,0:16:02.04,Default,,0,0,0,,Біз қазірдің өзінде доспыз, солай ма?
Dialogue: 0,0:16:02.12,0:16:05.21,Default,,0,0,0,,Не керек, арамдық болмаған соң, одан да жаман болды.
Dialogue: 0,0:16:05.29,0:16:07.50,Default,,0,0,0,,Мен сені осы жерде және қазір өлтіремін
Dialogue: 0,0:16:07.59,0:16:08.59,Default,,0,0,0,,Марсильді өзіммен бірге алып кетсем де...
Dialogue: 0,0:16:08.67,0:16:10.47,Default,,0,0,0,,Олай болса тез айт!
Dialogue: 0,0:16:10.55,0:16:12.55,Default,,0,0,0,,Неліктен осы уақытқа дейін үндемедің?
Dialogue: 0,0:16:12.63,0:16:14.72,Default,,0,0,0,,Сен маған жақсы емессің бе?
Dialogue: 0,0:16:14.80,0:16:16.60,Default,,0,0,0,,Бұл сезімсіз немесе нашар!
Dialogue: 0,0:16:16.68,0:16:20.10,Default,,0,0,0,,Мен сізге көп адамдар байқайтындай айттым!
Dialogue: 0,0:16:20.85,0:16:23.48,Default,,0,0,0,,Оны да аздап түсінуге тырысу керек!
Dialogue: 0,0:16:23.56,0:16:24.48,Default,,0,0,0,,Сіз оны болжай аласыз ба?
Dialogue: 0,0:16:24.56,0:16:27.98,Default,,0,0,0,,Осы аралда тапқан бірінші досым
Dialogue: 0,0:16:28.07,0:16:30.49,Default,,0,0,0,,Мынау қалықтады!
Dialogue: 0,0:16:30.57,0:16:34.57,Default,,0,0,0,,Уф... сенің ол жағың маған да ұнамайды!
Dialogue: 0,0:16:34.66,0:16:36.66,Default,,0,0,0,,Менде ғана адал жүз бар
Dialogue: 0,0:16:36.74,0:16:39.20,Default,,0,0,0,,Басқаларға ауыртпалық түсіру
Dialogue: 0,0:16:39.29,0:16:41.79,Default,,0,0,0,,Сіз мұны білесіз бе?
Dialogue: 0,0:16:41.87,0:16:44.21,Default,,0,0,0,,Ештеңе айтпа, ештеңе жеме
Dialogue: 0,0:16:44.29,0:16:47.50,Default,,0,0,0,,Неліктен оның аузы бар?
Dialogue: 0,0:16:47.59,0:16:49.25,Default,,0,0,0,,Шулы ақымақ!
Dialogue: 0,0:16:49.34,0:16:52.55,Default,,0,0,0,,Сіз Марсильдің жартысы сияқты тырысып жатқан жоқсыз.
Dialogue: 0,0:16:52.63,0:16:54.76,Default,,0,0,0,,Егер сіз осындай әрекет жасасаңыз
Dialogue: 0,0:16:54.84,0:16:56.43,Default,,0,0,0,,Бұл балалық төбелес.
Dialogue: 0,0:16:56.51,0:16:57.14,Default,,0,0,0,,Хмм
Dialogue: 0,0:16:57.22,0:16:59.35,Default,,0,0,0,,Менің білімім үшін кінәлімін...
Dialogue: 0,0:17:00.39,0:17:02.52,Default,,0,0,0,,7 адам қайтыс болды, соның ішінде мен
Dialogue: 0,0:17:02.60,0:17:05.14,Default,,0,0,0,,1 адам ауыр жағдайда, 3 адам белгісіз
Dialogue: 0,0:17:06.23,0:17:09.61,Default,,0,0,0,,Гном екеуміз оны тірілтеміз, бірақ қан жеткіліксіз.
Dialogue: 0,0:17:10.32,0:17:13.24,Default,,0,0,0,,Сенші, шашылған ингредиенттерді жинай аласың ба?
Dialogue: 0,0:17:13.74,0:17:14.28,Default,,0,0,0,,Растау
Dialogue: 0,0:17:14.95,0:17:17.53,Default,,0,0,0,,Егер менде қарапайым реанимация техникасы болса...
Dialogue: 0,0:17:17.62,0:17:19.41,Default,,0,0,0,,Мен бұл үшін кешірім сұраймын.
Dialogue: 0,0:17:22.45,0:17:26.00,Default,,0,0,0,,зардап шеккендерді емдеу және хабар-ошарсыз кеткен адамдарды іздеуді қамтиды.
Dialogue: 0,0:17:26.08,0:17:28.67,Default,,0,0,0,,Біртүрлі әдіс қолдансаңыз, мен сізді бірден кесіп тастаймын.
Dialogue: 0,0:17:29.25,0:17:30.42,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:17:50.65,0:17:51.65,Default,,0,0,0,,Уф
Dialogue: 0,0:17:51.73,0:17:52.94,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:54.65,0:17:55.78,Default,,0,0,0,,Не болды, Шло!
Dialogue: 0,0:17:56.36,0:17:59.20,Default,,0,0,0,,Мен күткендей тамақты осында жеген адаммын.
Dialogue: 0,0:17:59.28,0:18:00.53,Default,,0,0,0,,Күшті!
Dialogue: 0,0:18:00.62,0:18:02.29,Default,,0,0,0,,Shit… Shit…
Dialogue: 0,0:18:04.12,0:18:05.41,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:07.08,0:18:09.38,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:18:09.46,0:18:13.05,Default,,0,0,0,,Хмм хмм...
Dialogue: 0,0:18:13.84,0:18:14.76,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:16.76,0:18:17.68,Default,,0,0,0,,Дәмді...
Dialogue: 0,0:18:18.63,0:18:21.43,Default,,0,0,0,,Бала, реанимация аяқталды.
Dialogue: 0,0:18:22.01,0:18:24.10,Default,,0,0,0,,Келесіде қашан кетесіз?
Dialogue: 0,0:18:25.48,0:18:28.06,Default,,0,0,0,,Жоқ, қайтару техникасына дайындал.
Dialogue: 0,0:18:28.14,0:18:29.15,Default,,0,0,0,,Жерге оралайық
Dialogue: 0,0:18:29.73,0:18:30.98,Default,,0,0,0,,Қарсы болмасаңыз...?
Dialogue: 0,0:18:31.81,0:18:33.82,Default,,0,0,0,,Әсеби жоқ...
Dialogue: 0,0:18:33.90,0:18:35.94,Default,,0,0,0,,Жолың болмай қалды, лақтыр.
Dialogue: 0,0:18:36.44,0:18:39.66,Default,,0,0,0,,Біздің қолымыздан келмейтініне өкінеміз.
Dialogue: 0,0:18:40.20,0:18:43.45,Default,,0,0,0,,Жоқ, сен қолыңнан келгеннің бәрін істедің.
Dialogue: 0,0:18:44.33,0:18:45.45,Default,,0,0,0,,Рахмет
Dialogue: 0,0:18:45.54,0:18:47.54,Default,,0,0,0,,Сізбен кездескенім үшін кешіріңіз.
Dialogue: 0,0:18:49.29,0:18:50.71,Default,,0,0,0,,Түн ортасында әлі де 36 сағат.
Dialogue: 0,0:18:52.54,0:18:53.96,Default,,0,0,0,,Мен еліме қайтамын
Dialogue: 0,0:18:55.09,0:18:56.92,Default,,0,0,0,,Мен бұл аралға ешқашан оралмаймын
Dialogue: 0,0:18:58.55,0:19:01.30,Default,,0,0,0,,Осы уақыт туралы арал иесіне ескертіңіз.
Dialogue: 0,0:19:02.30,0:19:03.47,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:19:04.64,0:19:06.64,Default,,0,0,0,,Мен Фаринмен бірге үйге барғым келді.
Dialogue: 0,0:19:07.56,0:19:08.81,Default,,0,0,0,,Үйлену туралы ұсынысқа қандай жауап беріледі?
Dialogue: 0,0:19:09.60,0:19:10.73,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:19:12.11,0:19:14.36,Default,,0,0,0,,Ол менің бұл туралы ойлануымды қалайтынын айтты.
Dialogue: 0,0:19:15.19,0:19:16.48,Default,,0,0,0,,Мен сенің жауабыңды күттім.
Dialogue: 0,0:19:24.99,0:19:27.75,Default,,0,0,0,,Мұндай тартымды әйел жоқ.
Dialogue: 0,0:19:29.46,0:19:30.71,Default,,0,0,0,,Оның дауысы
Dialogue: 0,0:19:31.25,0:19:32.58,Default,,0,0,0,,Менің ойлау тәсілім...
Dialogue: 0,0:19:34.29,0:19:35.67,Default,,0,0,0,,Маған сенің күлкің ұнады
Dialogue: 0,0:19:39.01,0:19:40.01,Default,,0,0,0,,Шындығында, әлі жоқ
Dialogue: 0,0:19:40.63,0:19:42.97,Default,,0,0,0,,Мен оған бұл туралы айтқан жоқпын.
Dialogue: 0,0:19:44.43,0:19:46.26,Default,,0,0,0,,Мен сізге ертерек айтуым керек еді.
Dialogue: 0,0:19:47.43,0:19:50.06,Default,,0,0,0,,Не, сен кенет ұсыныс жасадың ба?
Dialogue: 0,0:19:50.14,0:19:51.39,Default,,0,0,0,,Сіз қорықпайсыз ба?
Dialogue: 0,0:19:51.48,0:19:53.19,Default,,0,0,0,,Сіз сондай дүниеденсіз бе?
Dialogue: 0,0:19:53.69,0:19:56.77,Default,,0,0,0,,Түсіндім, сосын Фаринге айтамын.
Dialogue: 0,0:19:58.28,0:19:59.36,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:20:00.74,0:20:02.78,Default,,0,0,0,,Сіз туралы мұндай нәрсе ...
Dialogue: 0,0:20:04.57,0:20:06.12,Default,,0,0,0,,Мен қызғанамын
Dialogue: 0,0:20:09.33,0:20:12.67,Default,,0,0,0,,Кабру, сен маған көп көмектестің.
Dialogue: 0,0:20:12.75,0:20:16.00,Default,,0,0,0,,Ерекше ештеңе жоқ, менің шабуылым мағынасыз болды.
Dialogue: 0,0:20:16.09,0:20:18.84,Default,,0,0,0,,Жоқ, мен одан көп нәрсені түсіндім.
Dialogue: 0,0:20:18.92,0:20:20.17,Default,,0,0,0,,Әртүрлі заттар...
Dialogue: 0,0:20:20.26,0:20:23.26,Default,,0,0,0,,Сіз пышақ салған жерлер адам үшін өлімге әкеледі.
Dialogue: 0,0:20:23.34,0:20:25.18,Default,,0,0,0,,Менің әпкемде олай емес еді.
Dialogue: 0,0:20:25.72,0:20:28.64,Default,,0,0,0,,Сонымен, сол аймақта маңызды органдар бар ма?
Dialogue: 0,0:20:28.72,0:20:30.39,Default,,0,0,0,,немесе бірнеше бар
Dialogue: 0,0:20:30.98,0:20:33.27,Default,,0,0,0,,Базилиск, Цербер және Скилла
Dialogue: 0,0:20:33.35,0:20:35.86,Default,,0,0,0,,Бірнеше миы бар құбыжықтар аз емес.
Dialogue: 0,0:20:35.94,0:20:38.15,Default,,0,0,0,,Химериялық деп аталатын түрлерде жиі кездеседі
Dialogue: 0,0:20:39.19,0:20:41.11,Default,,0,0,0,,Менің қарашықтарым кеңейген...
Dialogue: 0,0:20:41.19,0:20:43.86,Default,,0,0,0,,Сізге құбыжықтар өте ұнайды.
Dialogue: 0,0:20:43.95,0:20:45.66,Default,,0,0,0,,Бұл білім қару ма?
Dialogue: 0,0:20:45.74,0:20:48.41,Default,,0,0,0,,Лабиринт шеберін жеңу...
Dialogue: 0,0:20:48.49,0:20:51.87,Default,,0,0,0,,Одан да шебер шытырмандардың көп екені рас.
Dialogue: 0,0:20:51.95,0:20:55.04,Default,,0,0,0,,Мұндай білім мен мотивация ешкімде жоқ...
Dialogue: 0,0:20:56.04,0:20:59.05,Default,,0,0,0,,Ол мұны шынымен де жасай алады.
Dialogue: 0,0:20:59.92,0:21:00.80,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:21:01.51,0:21:04.01,Default,,0,0,0,,Лабиринт шеберін жеңгеннен кейін не болады?
Dialogue: 0,0:21:04.09,0:21:06.39,Default,,0,0,0,,Ашуланған сиқыршыны жеңген
Dialogue: 0,0:21:06.47,0:21:08.80,Default,,0,0,0,,Бұл елде бәрін алуға болатын сияқты.
Dialogue: 0,0:21:09.97,0:21:14.10,Default,,0,0,0,,Бұл лабиринттің келесі шебері болуды білдірсе ше?
Dialogue: 0,0:21:15.35,0:21:17.98,Default,,0,0,0,,Қала мен барлық құбыжықтар қара сиқырмен жаратылған.
Dialogue: 0,0:21:18.06,0:21:19.65,Default,,0,0,0,,Қолыңызға түскенде
Dialogue: 0,0:21:19.73,0:21:21.07,Default,,0,0,0,,Бұл адам не істейді?
Dialogue: 0,0:21:21.61,0:21:24.20,Default,,0,0,0,,Осы лабиринтті мойынсұнып мөрлейсіз бе?
Dialogue: 0,0:21:25.36,0:21:26.66,Default,,0,0,0,,Сіз аштыңыз ба?
Dialogue: 0,0:21:26.74,0:21:27.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:47.84,0:21:49.26,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:21:49.35,0:21:51.72,Default,,0,0,0,,Тамагояки гарпи жұмыртқасынан жасалған
Dialogue: 0,0:21:51.81,0:21:53.31,Default,,0,0,0,,(Гарпының күлкісі)
Dialogue: 0,0:21:53.39,0:21:56.14,Default,,0,0,0,,Сенши оны ертерек тауыпты.
Dialogue: 0,0:21:56.23,0:21:58.73,Default,,0,0,0,,Оны құбыжық тағамы қызықтыратын сияқты.
Dialogue: 0,0:21:58.81,0:22:00.06,Default,,0,0,0,,Бір өтінемін
Dialogue: 0,0:22:00.98,0:22:04.44,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:22:04.53,0:22:06.07,Default,,0,0,0,,Анашым!
Dialogue: 0,0:22:06.65,0:22:08.57,Default,,0,0,0,,Мен оны жегім келмейді!
Dialogue: 0,0:22:09.16,0:22:10.91,Default,,0,0,0,,Не істеу керек? қалай аман жүрсің
Dialogue: 0,0:22:10.99,0:22:14.04,Default,,0,0,0,,Жоқ, оны қазір өлтіруден басқа амалым жоқ...
Dialogue: 0,0:22:14.66,0:22:15.66,Default,,0,0,0,,Қазір мүмкін емес!
Dialogue: 0,0:22:15.75,0:22:16.71,Default,,0,0,0,,Itadadakimasu!
Dialogue: 0,0:22:16.79,0:22:18.04,Default,,0,0,0,,Күтілгендей...
Dialogue: 0,0:22:18.12,0:22:21.42,Default,,0,0,0,,Біреудің қалтасына кіріп кету үшін бәріне дайын адам
Dialogue: 0,0:22:21.50,0:22:23.05,Default,,0,0,0,,Өте жақсы адам...
Dialogue: 0,0:22:35.56,0:22:36.73,Default,,0,0,0,,Қайтару өнері
Dialogue: 0,0:22:36.81,0:22:38.56,Default,,0,0,0,,Дайын
Dialogue: 0,0:22:39.19,0:22:41.23,Default,,0,0,0,,Ешкім зардап шеккен жоқ па?
Dialogue: 0,0:22:41.31,0:22:42.69,Default,,0,0,0,,Мұның арғы жағында жер бар
Dialogue: 0,0:22:42.77,0:22:44.48,Default,,0,0,0,,Өлсең, қайта тірілу болмайды.
Dialogue: 0,0:22:45.07,0:22:46.40,Default,,0,0,0,,Шынымды айтсам, мен
Dialogue: 0,0:22:46.49,0:22:50.36,Default,,0,0,0,,Менің ойымша, сен жынды сиқыршыға жетпей өлесің.
Dialogue: 0,0:22:51.07,0:22:52.99,Default,,0,0,0,,Мен аман қалатын жағдайда
Dialogue: 0,0:22:53.53,0:22:56.75,Default,,0,0,0,,Бірақ қара магияның кесірінен мен жерге қайта орала алмадым.
Dialogue: 0,0:22:57.33,0:22:59.00,Default,,0,0,0,,Мына дыбысты айт
Dialogue: 0,0:22:59.87,0:23:02.25,Default,,0,0,0,,Алыстағы жұп қоңыраумен резонанс
Dialogue: 0,0:23:02.79,0:23:06.51,Default,,0,0,0,,Хабаршы жіберіп, шығысқа қашуын ұйымдастырайық.
Dialogue: 0,0:23:08.34,0:23:09.30,Default,,0,0,0,,Өлме
Dialogue: 0,0:23:10.89,0:23:11.76,Default,,0,0,0,,Рахмет
Dialogue: 0,0:23:13.76,0:23:14.64,Default,,0,0,0,,Лайос
Dialogue: 0,0:23:14.72,0:23:16.39,Default,,0,0,0,,Сізбен сөйлескеніме қуаныштымын
Dialogue: 0,0:23:16.47,0:23:18.27,Default,,0,0,0,,Бұл жолғы ең үлкен егін болды.
Dialogue: 0,0:23:18.77,0:23:19.77,Default,,0,0,0,,Мен де солай.
Dialogue: 0,0:23:20.27,0:23:21.40,Default,,0,0,0,,Ум...
Dialogue: 0,0:23:21.48,0:23:22.73,Default,,0,0,0,,Иә.
Dialogue: 0,0:23:22.81,0:23:25.61,Default,,0,0,0,,Менің атымды есіңе түсірдің, солай ма?
Dialogue: 0,0:23:25.69,0:23:27.36,Default,,0,0,0,,О, әрине
Dialogue: 0,0:23:27.86,0:23:28.74,Default,,0,0,0,,Жақсы
Dialogue: 0,0:23:30.36,0:23:32.24,Default,,0,0,0,,Келесі жолы ұмытпаңыз
Dialogue: 0,0:23:33.78,0:23:35.24,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:23:36.54,0:23:37.37,Default,,0,0,0,,«Келесі»?
Dialogue: 0,0:23:38.79,0:23:40.16,Default,,0,0,0,,Кеттік, Лайос.
Dialogue: 0,0:23:40.25,0:23:42.42,Default,,0,0,0,,Мен енді қайтып бара алмаймын.
Dialogue: 0,0:23:43.38,0:23:45.17,Default,,0,0,0,,Қап, мына жерге қара.
Dialogue: 0,0:23:45.25,0:23:49.05,Default,,0,0,0,,Мен мұның соңы осылай болатынын сездім, маған қарғыс атсын.
Dialogue: 0,0:23:49.84,0:23:51.72,Default,,0,0,0,,Бұл дөрекі, салқын.
Dialogue: 0,0:23:51.80,0:23:52.68,Default,,0,0,0,,Барша адамның ішінен… сен бе
Dialogue: 0,0:23:52.76,0:23:54.93,Default,,0,0,0,,Хмм...
Dialogue: 0,0:23:56.85,0:23:58.10,Default,,0,0,0,,Бірдеңе болады.
Dialogue: 0,0:24:00.98,0:24:02.98,Default,,0,0,0,,♪~
Dialogue: 0,0:25:28.06,0:25:30.07,Default,,0,0,0,,~♪
