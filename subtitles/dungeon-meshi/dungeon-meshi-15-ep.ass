Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.00,0:00:03.00,Default,,0,0,0,,♪~
Dialogue: 0,0:01:26.50,0:01:28.50,Default,,0,0,0,,~♪
Dialogue: 0,0:01:31.55,0:01:32.84,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:01:32.92,0:01:34.17,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:01:34.26,0:01:36.72,Default,,0,0,0,,Мен мұнда келгенде мұндай қабырға болған жоқ.
Dialogue: 0,0:01:36.80,0:01:37.47,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:38.05,0:01:39.68,Default,,0,0,0,,Тағы жер сілкінісі?
Dialogue: 0,0:01:39.76,0:01:41.47,Default,,0,0,0,,Жер сілкінісі емес
Dialogue: 0,0:01:41.56,0:01:44.02,Default,,0,0,0,,Лабиринт қозғалып, пішінін өзгертеді.
Dialogue: 0,0:01:44.10,0:01:46.60,Default,,0,0,0,,Мүмкін сол сиқыршының жұмысы...
Dialogue: 0,0:01:46.69,0:01:49.35,Default,,0,0,0,,Мүмкін олар бізден қорқатын шығар...
Dialogue: 0,0:01:49.44,0:01:53.65,Default,,0,0,0,,Мәңгі бір жерде жүруге мәжбүрміз бе?
Dialogue: 0,0:01:54.44,0:01:56.36,Default,,0,0,0,,Кішкене тырысып көрейін бе?
Dialogue: 0,0:01:56.45,0:01:58.11,Default,,0,0,0,,Бір минут күтіңіз.
Dialogue: 0,0:02:01.12,0:02:01.62,Default,,0,0,0,,Карс неге қарап тұр өзі?
Dialogue: 0,0:02:06.46,0:02:07.71,Default,,0,0,0,,Ол кеткен сияқты
Dialogue: 0,0:02:09.67,0:02:12.71,Default,,0,0,0,,Менің ойымша, қабырғаға өрмелеу дұрыс таңдау емес.
Dialogue: 0,0:02:13.21,0:02:15.21,Default,,0,0,0,,Сіз тұрақты жол іздеп жүрсіз бе?
Dialogue: 0,0:02:17.47,0:02:20.51,Default,,0,0,0,,Қалай болғанда да бір нәрсе бар...
Dialogue: 0,0:02:21.22,0:02:23.81,Default,,0,0,0,,Ол жанданған сияқты
Dialogue: 0,0:02:24.39,0:02:28.02,Default,,0,0,0,,Жалын айдаһар өлді, үндемеген құбыжық шықты.
Dialogue: 0,0:02:28.60,0:02:30.77,Default,,0,0,0,,Бастапқыда бұл қабатта көптеген құбыжықтар болған.
Dialogue: 0,0:02:31.44,0:02:33.57,Default,,0,0,0,,Мен сізді бұрын кездестірмегенім үшін бақыттымын...
Dialogue: 0,0:02:33.65,0:02:34.15,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:34.94,0:02:36.53,Default,,0,0,0,,-Ах... Уф - Уф
Dialogue: 0,0:02:36.61,0:02:38.40,Default,,0,0,0,,Егер ойыңды өзгертсең, маған хабарла
Dialogue: 0,0:02:39.32,0:02:41.37,Default,,0,0,0,,Хмм, бұл денсаулыққа зиян.
Dialogue: 0,0:02:41.45,0:02:43.74,Default,,0,0,0,,Жол бойы жүріп айдаһарды жегеннен бері
Dialogue: 0,0:02:43.83,0:02:45.74,Default,,0,0,0,,Дұрыс тамақтанбау
Dialogue: 0,0:02:46.25,0:02:48.50,Default,,0,0,0,,Лайостың жасы...
Dialogue: 0,0:02:48.58,0:02:52.04,Default,,0,0,0,,Мен жақсымын ба, жаспын ба білмеймін...
Dialogue: 0,0:02:52.13,0:02:53.92,Default,,0,0,0,,Чилчак пен Марсиль
Dialogue: 0,0:02:54.00,0:02:56.42,Default,,0,0,0,,Өсіп келе жатқан шығар...
Dialogue: 0,0:02:56.51,0:03:00.01,Default,,0,0,0,,Осындай уақытта қанағаттанарлық тамақ бере алмайсыз ба?
Dialogue: 0,0:03:00.09,0:03:01.55,Default,,0,0,0,,Мен қорқынышты көтере алмаймын!
Dialogue: 0,0:03:02.05,0:03:05.26,Default,,0,0,0,,Жастарды бақпасаң,
Dialogue: 0,0:03:05.35,0:03:06.81,Default,,0,0,0,,Мен сені тамақтандыруым керек!
Dialogue: 0,0:03:07.60,0:03:10.35,Default,,0,0,0,,Иә? бір нәрсенің иісі тәтті
Dialogue: 0,0:03:10.44,0:03:12.06,Default,,0,0,0,,Тамақтың иісі бар ма?
Dialogue: 0,0:03:12.15,0:03:14.52,Default,,0,0,0,,Жоқ, гүлдердің иісі бар...
Dialogue: 0,0:03:14.61,0:03:15.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:15.27,0:03:18.90,Default,,0,0,0,,Гүлдер жайқалған жерде жақын жерде су көзі бар.
Dialogue: 0,0:03:18.99,0:03:20.40,Default,,0,0,0,,Мені тап, Салқын!
Dialogue: 0,0:03:20.49,0:03:21.20,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:03:21.70,0:03:24.16,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:03:25.45,0:03:26.62,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:03:26.70,0:03:28.50,Default,,0,0,0,,Зират немесе бір нәрсе...
Dialogue: 0,0:03:29.58,0:03:30.50,Default,,0,0,0,,Не!
Dialogue: 0,0:03:31.08,0:03:33.21,Default,,0,0,0,,Күте тұрыңыз, мұнда біреу бар...
Dialogue: 0,0:03:33.29,0:03:39.21,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:03:39.30,0:03:40.01,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:03:40.09,0:03:41.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:43.47,0:03:45.10,Default,,0,0,0,,Бұл құрметсіздік.
Dialogue: 0,0:03:45.18,0:03:46.89,Default,,0,0,0,,Ей, Сенші, жібер!
Dialogue: 0,0:03:47.47,0:03:48.64,Default,,0,0,0,,Ха!
Dialogue: 0,0:03:48.72,0:03:49.43,Default,,0,0,0,,Ооо...
Dialogue: 0,0:03:49.52,0:03:50.52,Default,,0,0,0,,Сеншиге түс
Dialogue: 0,0:03:50.60,0:03:52.06,Default,,0,0,0,,- Уф - күрсіну
Dialogue: 0,0:03:52.77,0:03:53.52,Default,,0,0,0,,Каа!
Dialogue: 0,0:03:53.60,0:03:54.94,Default,,0,0,0,,Сонымен!
Dialogue: 0,0:03:55.02,0:03:55.98,Default,,0,0,0,,Гохо гохо гохо
Dialogue: 0,0:03:56.06,0:03:56.90,Default,,0,0,0,,Не?
Dialogue: 0,0:03:56.98,0:03:58.03,Default,,0,0,0,,Қаруларыңызды алыңыз!
Dialogue: 0,0:03:58.11,0:04:00.28,Default,,0,0,0,,Бұл жігіттер адам емес.
Dialogue: 0,0:04:00.36,0:04:01.07,Default,,0,0,0,,Драйадтың...
Dialogue: 0,0:04:01.15,0:04:02.53,Default,,0,0,0,,Гүлдер!
Dialogue: 0,0:04:02.61,0:04:05.12,Default,,0,0,0,,Сонымен бұл дене сұйықтығы дегеніміз не?
Dialogue: 0,0:04:05.20,0:04:06.91,Default,,0,0,0,,Сұйық емес
Dialogue: 0,0:04:06.99,0:04:10.29,Default,,0,0,0,,Бұл ұсақ бөлшектер тыныс алу жолдары арқылы енгенде,
Dialogue: 0,0:04:10.37,0:04:11.91,Default,,0,0,0,,Шырышты қабаттарға жабысады
Dialogue: 0,0:04:12.83,0:04:16.67,Default,,0,0,0,,Дене бұл таныс бөлшекті у деп таниды.
Dialogue: 0,0:04:16.75,0:04:19.30,Default,,0,0,0,,Иммунитетті жұмылдыру
Dialogue: 0,0:04:19.38,0:04:21.42,Default,,0,0,0,,Эвакуацияны дереу бастады
Dialogue: 0,0:04:22.22,0:04:23.05,Default,,0,0,0,,... деп аталатын
Dialogue: 0,0:04:24.51,0:04:26.14,Default,,0,0,0,,Бува~ккушой~!
Dialogue: 0,0:04:26.22,0:04:27.43,Default,,0,0,0,,Менде шөп безгегі бар
Dialogue: 0,0:04:27.51,0:04:29.56,Default,,0,0,0,,- (2 адам) Буваккушой! -Ой, бұл не? Ол лас.
Dialogue: 0,0:04:29.64,0:04:31.93,Default,,0,0,0,,-Аа, ауырады -Буваксой!
Dialogue: 0,0:04:32.02,0:04:33.77,Default,,0,0,0,,Құрғақ тозаң?
Dialogue: 0,0:04:34.31,0:04:34.94,Default,,0,0,0,,Бұл қауіпті.
Dialogue: 0,0:04:35.02,0:04:36.69,Default,,0,0,0,,Тозаңмен дем алмаңыз!
Dialogue: 0,0:04:37.40,0:04:40.53,Default,,0,0,0,,Ахх...
Dialogue: 0,0:04:41.24,0:04:42.19,Default,,0,0,0,,Кәсібі: тыңшы
Dialogue: 0,0:04:42.28,0:04:44.20,Default,,0,0,0,,Мен жылауымды тоқтата алмаймын
Dialogue: 0,0:04:45.95,0:04:47.12,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:48.83,0:04:50.83,Default,,0,0,0,,Тұр! Мықты бол, Сенші.
Dialogue: 0,0:04:50.91,0:04:51.83,Default,,0,0,0,,Бұл...
Dialogue: 0,0:04:51.91,0:04:53.21,Default,,0,0,0,,Лайос
Dialogue: 0,0:04:53.29,0:04:54.46,Default,,0,0,0,,Кенсуке Кенсуке
Dialogue: 0,0:04:54.54,0:04:57.33,Default,,0,0,0,,Шүкір, мен де... көзім...
Dialogue: 0,0:04:58.42,0:04:59.21,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:04:59.29,0:05:01.09,Default,,0,0,0,,Сенші, қол соз!
Dialogue: 0,0:05:01.67,0:05:04.55,Default,,0,0,0,,Менің сигналым бойынша оны артқа ұрыңыз!
Dialogue: 0,0:05:05.05,0:05:06.47,Default,,0,0,0,,Бір
Dialogue: 0,0:05:06.55,0:05:07.64,Default,,0,0,0,,...
Dialogue: 0,0:05:08.35,0:05:10.06,Default,,0,0,0,,-Мистер - Иә
Dialogue: 0,0:05:11.31,0:05:12.98,Default,,0,0,0,,- Уф - Муф~
Dialogue: 0,0:05:14.18,0:05:15.44,Default,,0,0,0,,(Екі адам түшкіреді)
Dialogue: 0,0:05:15.52,0:05:18.90,Default,,0,0,0,,Қарғыс атсын, менің де көзім қыши бастады.
Dialogue: 0,0:05:18.98,0:05:20.23,Default,,0,0,0,,Көріну...
Dialogue: 0,0:05:22.94,0:05:24.49,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:25.36,0:05:26.45,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,0:05:27.82,0:05:28.41,Default,,0,0,0,,(семсер дыбысы)
Dialogue: 0,0:05:28.49,0:05:29.74,Default,,0,0,0,,Қаш, Сенші!
Dialogue: 0,0:05:29.83,0:05:30.62,Default,,0,0,0,,Ойға сыймайды!
Dialogue: 0,0:05:30.70,0:05:33.75,Default,,0,0,0,,Мен жастарды қорғауым керек!
Dialogue: 0,0:05:33.83,0:05:35.21,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:05:35.29,0:05:38.38,Default,,0,0,0,,Чилчак, сен менің көзіме айналасың!
Dialogue: 0,0:05:38.46,0:05:40.50,Default,,0,0,0,,Бұл мүмкін емес. Мен ештеңе көре алмаймын.
Dialogue: 0,0:05:40.59,0:05:42.96,Default,,0,0,0,,Сізде бес сезім керемет болуы керек.
Dialogue: 0,0:05:43.05,0:05:44.13,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:44.21,0:05:45.63,Default,,0,0,0,,Иіс...
Dialogue: 0,0:05:45.72,0:05:49.14,Default,,0,0,0,,Жоқ, тозаңның иісі тым күшті.
Dialogue: 0,0:05:49.72,0:05:50.51,Default,,0,0,0,,Дыбыс…
Dialogue: 0,0:05:50.60,0:05:51.64,Default,,0,0,0,,Буваккушой!
Dialogue: 0,0:05:51.72,0:05:53.77,Default,,0,0,0,,Сеншінің түшкіргені сондай тітіркендіреді!
Dialogue: 0,0:05:53.85,0:05:57.02,Default,,0,0,0,,Сіз көру, иіс және есту қабілетіне сене аласыз...
Dialogue: 0,0:05:57.52,0:05:58.15,Default,,0,0,0,,Ха!
Dialogue: 0,0:05:58.85,0:06:00.36,Default,,0,0,0,,(Марио) Ж… Жуық келме. Бұл тұзақ.
Dialogue: 0,0:06:00.44,0:06:01.61,Default,,0,0,0,,Буваккушой!
Dialogue: 0,0:06:01.69,0:06:04.48,Default,,0,0,0,,Мен түшкірмеу үшін диагональ бойынша оңға қарай жүгірдім!
Dialogue: 0,0:06:04.57,0:06:06.40,Default,,0,0,0,,Осылай тербеле бер, Сенші!
Dialogue: 0,0:06:06.49,0:06:07.65,Default,,0,0,0,,Nu...
Dialogue: 0,0:06:07.74,0:06:08.99,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:10.57,0:06:11.62,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:06:13.37,0:06:14.37,Default,,0,0,0,,(Екі адам түшкіреді)
Dialogue: 0,0:06:14.45,0:06:15.83,Default,,0,0,0,,Кенсуке~
Dialogue: 0,0:06:16.75,0:06:17.83,Default,,0,0,0,,(Марсиль күрсінуі)
Dialogue: 0,0:06:17.91,0:06:20.00,Default,,0,0,0,,Керемет жарылу
Dialogue: 0,0:06:20.08,0:06:23.55,Default,,0,0,0,,Оны тез жөндеп, сиқырлы күш бермесең, таяқ өледі.
Dialogue: 0,0:06:24.05,0:06:27.51,Default,,0,0,0,,Осы деңгейге жету үшін көп жылдар қажет болса да...
Dialogue: 0,0:06:28.63,0:06:29.22,Default,,0,0,0,,Ах
Dialogue: 0,0:06:29.30,0:06:30.80,Default,,0,0,0,,-(3 адам) Уф... -Уау!
Dialogue: 0,0:06:31.30,0:06:33.56,Default,,0,0,0,,Бұл жерде қауіпсіз...
Dialogue: 0,0:06:33.64,0:06:34.47,Default,,0,0,0,,Өтірік!
Dialogue: 0,0:06:35.93,0:06:38.48,Default,,0,0,0,,Сіз Құрғақ гүлмен күрестіңіз бе?
Dialogue: 0,0:06:39.06,0:06:40.56,Default,,0,0,0,,Бұл қиын болды.
Dialogue: 0,0:06:40.65,0:06:42.86,Default,,0,0,0,,Бірақ гүл құбыжығы дегеніміз не?
Dialogue: 0,0:06:42.94,0:06:45.98,Default,,0,0,0,,Мен оларды еркек пен әйел деп толық ойладым.
Dialogue: 0,0:06:46.57,0:06:49.99,Default,,0,0,0,,Құрғақгүлдер дара жынысты гүлдер, сондықтан олар аталық және аналық болуы керек.
Dialogue: 0,0:06:50.07,0:06:50.86,Default,,0,0,0,,Ах
Dialogue: 0,0:06:50.95,0:06:52.24,Default,,0,0,0,,Мүмкін...
Dialogue: 0,0:06:52.32,0:06:53.99,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:06:54.08,0:06:56.29,Default,,0,0,0,,Оны ұрып, тоқтатқан дұрыс емес пе?
Dialogue: 0,0:06:56.37,0:07:00.33,Default,,0,0,0,,Бірақ бізде ақырында ештеңе айту салтанаты жоқ.
Dialogue: 0,0:07:00.42,0:07:04.63,Default,,0,0,0,,Гүлдің пішіні адамға ұқсайтындықтан, мені «Бұл не?» деп таң қалдырады.
Dialogue: 0,0:07:04.71,0:07:05.55,Default,,0,0,0,,Марси…
Dialogue: 0,0:07:05.63,0:07:06.76,Default,,0,0,0,,-Ах! -(2 адам) А?
Dialogue: 0,0:07:07.67,0:07:09.51,Default,,0,0,0,,Міне болды~
Dialogue: 0,0:07:09.59,0:07:11.84,Default,,0,0,0,,Құрғақ жеміс!
Dialogue: 0,0:07:12.84,0:07:14.81,Default,,0,0,0,,Уақыт... кері қайту...
Dialogue: 0,0:07:14.89,0:07:17.77,Default,,0,0,0,,Тоқта! Мен жай ғана қауіпті көрінетін сиқыр іздеп жүрмін
Dialogue: 0,0:07:17.85,0:07:19.77,Default,,0,0,0,,Сіздің қара сиқырлы әзіліңіз қандай?
Dialogue: 0,0:07:19.85,0:07:21.19,Default,,0,0,0,,Мен күле алмаймын!
Dialogue: 0,0:07:21.98,0:07:24.48,Default,,0,0,0,,Соңғы өлген драйадтан
Dialogue: 0,0:07:24.56,0:07:26.27,Default,,0,0,0,,Тозаң болған жоқ.
Dialogue: 0,0:07:26.36,0:07:28.11,Default,,0,0,0,,Аналық гүл болса керек.
Dialogue: 0,0:07:28.69,0:07:32.45,Default,,0,0,0,,Гүл тозаңдану алдында жемісті күтіп, қорғайды.
Dialogue: 0,0:07:33.74,0:07:35.74,Default,,0,0,0,,Мұнда да жеміс өсетін нәрсе бар.
Dialogue: 0,0:07:36.24,0:07:38.75,Default,,0,0,0,,А, бұл бүршік.
Dialogue: 0,0:07:38.83,0:07:41.25,Default,,0,0,0,,Құрғақ гүлге айналады.
Dialogue: 0,0:07:41.92,0:07:44.75,Default,,0,0,0,,Бұл жемісті жеу бұрынғы жемістерге қарағанда оңайырақ көрінеді.
Dialogue: 0,0:07:45.25,0:07:47.25,Default,,0,0,0,,Бұл әбден мүмкін.
Dialogue: 0,0:07:47.34,0:07:48.21,Default,,0,0,0,,Егін орайық
Dialogue: 0,0:07:50.97,0:07:53.01,Default,,0,0,0,,Сіз көп таңдамайсыз.
Dialogue: 0,0:07:55.35,0:07:56.22,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:07:57.26,0:07:59.31,Default,,0,0,0,,Ей, мандрака өсіп жатыр.
Dialogue: 0,0:07:59.39,0:08:02.89,Default,,0,0,0,,Ит дайындайтын уақытым жоқ, басын кесіп алайын.
Dialogue: 0,0:08:03.52,0:08:06.57,Default,,0,0,0,,Бұл өте шулы. Қашанға дейін шығарасың?
Dialogue: 0,0:08:07.69,0:08:08.57,Default,,0,0,0,,Хмм
Dialogue: 0,0:08:08.65,0:08:11.40,Default,,0,0,0,,Бұл айтарлықтай егін болды.
Dialogue: 0,0:08:11.49,0:08:14.53,Default,,0,0,0,,Орктардан балта алу жақсы болды!
Dialogue: 0,0:08:14.61,0:08:15.70,Default,,0,0,0,,Уф
Dialogue: 0,0:08:16.53,0:08:20.58,Default,,0,0,0,,Ұсақталған ингредиенттерді суы бар қазанға салып, қайнатыңыз.
Dialogue: 0,0:08:21.16,0:08:23.83,Default,,0,0,0,,Ингредиенттер жұмсақ болған кезде, отты өшіріңіз.
Dialogue: 0,0:08:23.92,0:08:26.08,Default,,0,0,0,,Кәстрөлде езіңіз
Dialogue: 0,0:08:26.17,0:08:29.59,Default,,0,0,0,,Паста болғаннан кейін қайтадан су қосыңыз.
Dialogue: 0,0:08:29.67,0:08:31.34,Default,,0,0,0,,Дәмдеуіштерді қосыңыз
Dialogue: 0,0:08:31.42,0:08:33.05,Default,,0,0,0,,Хмм
Dialogue: 0,0:08:36.68,0:08:37.47,Default,,0,0,0,,（）
Dialogue: 0,0:08:37.55,0:08:39.06,Default,,0,0,0,,Жақсы иіс шығады.
Dialogue: 0,0:08:39.14,0:08:40.35,Default,,0,0,0,,Егер бұл...
Dialogue: 0,0:08:41.06,0:08:43.10,Default,,0,0,0,,Сары маймен аздап қуырылған
Dialogue: 0,0:08:43.19,0:08:44.85,Default,,0,0,0,,Саңырауқұлақтарды қосыңыз
Dialogue: 0,0:08:44.94,0:08:48.36,Default,,0,0,0,,Үстіне еріген ірімшікті себіңіз
Dialogue: 0,0:08:48.44,0:08:49.61,Default,,0,0,0,,Орындалды
Dialogue: 0,0:08:52.94,0:08:54.65,Default,,0,0,0,,Оны неге сонда қойдыңыз?
Dialogue: 0,0:08:54.74,0:08:57.87,Default,,0,0,0,,Бұл менің сиқырлы күшімді аз да болса толықтыруға көмектеседі деп сенемін.
Dialogue: 0,0:08:57.95,0:09:01.58,Default,,0,0,0,,Егер сіз оны жақсы ниетпен қолдасаңыз, кешіре алмайды деп ойлаймын!
Dialogue: 0,0:09:01.66,0:09:03.08,Default,,0,0,0,,Мен оны жеймін.
Dialogue: 0,0:09:04.33,0:09:05.29,Default,,0,0,0,,Тәтті
Dialogue: 0,0:09:05.37,0:09:07.21,Default,,0,0,0,,Гүлдің иісі бар.
Dialogue: 0,0:09:07.29,0:09:09.88,Default,,0,0,0,,Қалың болса да, аузыңда ериді.
Dialogue: 0,0:09:09.96,0:09:11.42,Default,,0,0,0,,Маған бұл ұнайды...
Dialogue: 0,0:09:12.46,0:09:14.09,Default,,0,0,0,,Сурет ең нашар
Dialogue: 0,0:09:16.84,0:09:18.64,Default,,0,0,0,,Амммм...
Dialogue: 0,0:09:18.72,0:09:21.31,Default,,0,0,0,,Сырдың қышқылдығы онымен жақсы үйлеседі.
Dialogue: 0,0:09:21.39,0:09:23.98,Default,,0,0,0,,Маған сәл ащы дәмі ұнады.
Dialogue: 0,0:09:25.14,0:09:28.27,Default,,0,0,0,,...Бірақ олар қалай құтылды?
Dialogue: 0,0:09:28.36,0:09:30.90,Default,,0,0,0,,Мен осылай мәңгілікке кете алмас едім...
Dialogue: 0,0:09:30.98,0:09:34.11,Default,,0,0,0,,Жерге өтуді толығымен жабу болып табылады
Dialogue: 0,0:09:34.19,0:09:36.99,Default,,0,0,0,,Мен олай ойламаймын, өйткені ол сиқырлы күштің ағынын кесіп тастайды.
Dialogue: 0,0:09:37.49,0:09:39.78,Default,,0,0,0,,Бір жерде саңылау болуы керек.
Dialogue: 0,0:09:39.87,0:09:40.66,Default,,0,0,0,,Хмм
Dialogue: 0,0:09:41.24,0:09:43.83,Default,,0,0,0,,Қызық, лабиринттегі өзгерістерге қатысты ережелер бар ма?
Dialogue: 0,0:09:43.91,0:09:45.16,Default,,0,0,0,,Ия, солай!
Dialogue: 0,0:09:45.25,0:09:47.67,Default,,0,0,0,,Жер гүрілінің аралығын және картасын жазып алайық
Dialogue: 0,0:09:47.75,0:09:49.71,Default,,0,0,0,,Мен бірдеңе болатынын сезе бастадым.
Dialogue: 0,0:09:49.79,0:09:51.00,Default,,0,0,0,,Қарын тоқ болғанда
Dialogue: 0,0:09:51.09,0:09:52.38,Default,,0,0,0,,Кішкене оптимист болу.
Dialogue: 0,0:09:52.46,0:09:54.01,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,0:09:55.67,0:09:57.05,Default,,0,0,0,,Пуха~
Dialogue: 0,0:09:57.63,0:09:59.72,Default,,0,0,0,,Денем қызып тұр.
Dialogue: 0,0:09:59.80,0:10:02.06,Default,,0,0,0,,Сиқырлы күш біраз уақытқа оралған болуы мүмкін
Dialogue: 0,0:10:02.14,0:10:05.39,Default,,0,0,0,,Райос пен Сеншидің жарақаттарын да емдеуіміз керек.
Dialogue: 0,0:10:05.48,0:10:07.31,Default,,0,0,0,,Өзіңізді әлі тым қатты итермеңіз.
Dialogue: 0,0:10:07.39,0:10:08.81,Default,,0,0,0,,Оны асыра алмаңыз
Dialogue: 0,0:10:08.90,0:10:09.81,Default,,0,0,0,,Лайос!
Dialogue: 0,0:10:09.90,0:10:11.73,Default,,0,0,0,,Сіз қолыңыздан келгеннің бәрін жасайсыз
Dialogue: 0,0:10:11.82,0:10:12.69,Default,,0,0,0,,Хмм?
Dialogue: 0,0:10:12.77,0:10:15.19,Default,,0,0,0,,Мен сендерге сиқырды үйретемін
Dialogue: 0,0:10:15.28,0:10:19.45,Default,,0,0,0,,Құтырған сиқыршыдан жалғыз мен бәрін қорғай алмаймын.
Dialogue: 0,0:10:19.53,0:10:23.29,Default,,0,0,0,,Егер сіз емдік немесе қорғаныс сиқырын қолдансаңыз, іс әлдеқайда жеңіл болады.
Dialogue: 0,0:10:24.54,0:10:26.33,Default,,0,0,0,,Фарин саған қол тигізуді үйретті, солай ма?
Dialogue: 0,0:10:26.87,0:10:27.71,Default,,0,0,0,,Кез келген жағдайда...
Dialogue: 0,0:10:27.79,0:10:30.58,Default,,0,0,0,,Ол баланың мамандығы - гномдық сиқыр жүйесі.
Dialogue: 0,0:10:30.67,0:10:33.84,Default,,0,0,0,,Мен қолданатын сиқырлы жүйе сәл басқаша.
Dialogue: 0,0:10:34.42,0:10:36.88,Default,,0,0,0,,Жарайды, түбірлері бір, сондықтан жарайды.
Dialogue: 0,0:10:36.97,0:10:39.22,Default,,0,0,0,,Мен оны бірден әкелемін.
Dialogue: 0,0:10:39.80,0:10:40.55,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:41.64,0:10:43.97,Default,,0,0,0,,Біз күштірек болуымыз керек
Dialogue: 0,0:10:44.93,0:10:46.10,Default,,0,0,0,,Иә
Dialogue: 0,0:10:47.35,0:10:49.52,Default,,0,0,0,,Бұл жігіттер тым позитивті
Dialogue: 0,0:10:50.06,0:10:52.90,Default,,0,0,0,,Жастар үшін бұл жеткілікті.
Dialogue: 0,0:10:53.52,0:10:54.36,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:54.44,0:10:57.07,Default,,0,0,0,,Маған бала сияқты қарауды қоясың ба?
Dialogue: 0,0:10:57.15,0:10:58.53,Default,,0,0,0,,Мен шыдай алмаймын!
Dialogue: 0,0:10:58.61,0:11:01.74,Default,,0,0,0,,Негізінде құбыжықтың алдында неге менің көзімді жауып алдың?
Dialogue: 0,0:11:01.82,0:11:03.41,Default,,0,0,0,,Мен ақырында құтқарылдым!
Dialogue: 0,0:11:04.83,0:11:06.99,Default,,0,0,0,,Көрдім... Чилчак
Dialogue: 0,0:11:07.08,0:11:10.58,Default,,0,0,0,,Сіз әкеңізден айырылдым деп айттыңыз.
Dialogue: 0,0:11:11.12,0:11:12.58,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:11:12.67,0:11:13.88,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:11:14.63,0:11:17.92,Default,,0,0,0,,Бұл жақсы мүмкіндік, сондықтан мен сізге бір нәрсе айтайын.
Dialogue: 0,0:11:18.92,0:11:20.63,Default,,0,0,0,,Онда отырыңыз
Dialogue: 0,0:11:21.93,0:11:24.76,Default,,0,0,0,,Сіз де өзіңізді қызықтыратын жаста шығарсыз.
Dialogue: 0,0:11:24.85,0:11:28.18,Default,,0,0,0,,Дұрыс білім алу керек
Dialogue: 0,0:11:28.89,0:11:30.02,Default,,0,0,0,,Хе-хе. Баспалдақтан төмен түсіп кеткенсің ғой?
Dialogue: 0,0:11:30.60,0:11:33.15,Default,,0,0,0,,Адамдарда аталық және аналық мүшелер де болады...
Dialogue: 0,0:11:33.23,0:11:35.27,Default,,0,0,0,,Кяаааааа...!
Dialogue: 0,0:11:35.36,0:11:37.03,Default,,0,0,0,,Жоқ, қайталап көріңіз!
Dialogue: 0,0:11:37.11,0:11:38.78,Default,,0,0,0,,Мұқият тыңдаңыз!
Dialogue: 0,0:11:39.61,0:11:43.32,Default,,0,0,0,,Осылайша олардың түні өтті.
Dialogue: 0,0:11:45.95,0:11:47.24,Default,,0,0,0,,Менің айтпағым сол емес еді—
Dialogue: 0,0:11:48.04,0:11:49.12,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:53.67,0:11:54.88,Default,,0,0,0,,- Дөрекі! -Ах!
Dialogue: 0,0:11:56.09,0:11:58.42,Default,,0,0,0,,Мен саған біртүрлі тиіп кетсем жаман болар деп ойладым...
Dialogue: 0,0:11:58.51,0:12:00.51,Default,,0,0,0,,Бұлай шалынып қалма!
Dialogue: 0,0:12:00.59,0:12:02.22,Default,,0,0,0,,Сол қолыңызды шығарыңыз!
Dialogue: 0,0:12:04.22,0:12:06.89,Default,,0,0,0,,Қараңызшы, бұл өте жақсы.
Dialogue: 0,0:12:06.97,0:12:07.93,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:08.47,0:12:10.98,Default,,0,0,0,,Ұялып қалсаң да, сиқырдан таймайсың.
Dialogue: 0,0:12:11.06,0:12:12.77,Default,,0,0,0,,Қараңыз, шоғырланыңыз, шоғырланыңыз!
Dialogue: 0,0:12:13.48,0:12:17.19,Default,,0,0,0,,Сіздің денеңіздің ішінде айналып жатқан сиқырлы күшке назар аударыңыз.
Dialogue: 0,0:12:17.27,0:12:18.82,Default,,0,0,0,,Қан тамыр тәрізді кескін
Dialogue: 0,0:12:19.40,0:12:21.28,Default,,0,0,0,,Ағынды алақаннан қосыңыз
Dialogue: 0,0:12:21.95,0:12:25.49,Default,,0,0,0,,Сенің басыңнан аяғымның ұшына дейін
Dialogue: 0,0:12:26.20,0:12:27.74,Default,,0,0,0,,Бір ауыздан дем алыңыз
Dialogue: 0,0:12:27.83,0:12:29.37,Default,,0,0,0,,Дене қызуы мен пульс...
Dialogue: 0,0:12:29.91,0:12:33.42,Default,,0,0,0,,Сіз онымен таныспын деп ойласаңыз, менен кейін қайталаңыз.
Dialogue: 0,0:12:33.50,0:12:34.50,Default,,0,0,0,,Спела
Dialogue: 0,0:12:34.58,0:12:35.54,Default,,0,0,0,,Спела
Dialogue: 0,0:12:35.63,0:12:36.46,Default,,0,0,0,,Yeptum
Dialogue: 0,0:12:36.54,0:12:37.54,Default,,0,0,0,,Yeptum
Dialogue: 0,0:12:37.63,0:12:38.59,Default,,0,0,0,,Руферм
Dialogue: 0,0:12:38.67,0:12:39.67,Default,,0,0,0,,Руферм
Dialogue: 0,0:12:39.75,0:12:41.13,Default,,0,0,0,,-Вирар -Вирар
Dialogue: 0,0:12:41.21,0:12:42.17,Default,,0,0,0,,Эвркант
Dialogue: 0,0:12:42.26,0:12:43.38,Default,,0,0,0,,Эвриканто
Dialogue: 0,0:12:43.47,0:12:44.22,Default,,0,0,0,,Жаралар
Dialogue: 0,0:12:44.30,0:12:45.51,Default,,0,0,0,,Жаралар
Dialogue: 0,0:12:45.59,0:12:46.18,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:46.26,0:12:47.68,Default,,0,0,0,,-Қышымады! -Аға!
Dialogue: 0,0:12:47.76,0:12:50.43,Default,,0,0,0,,Уф~ Қышыма Қышыма~
Dialogue: 0,0:12:50.52,0:12:52.06,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:12:52.14,0:12:54.52,Default,,0,0,0,,Әй, қотыры түсіп қалды.
Dialogue: 0,0:12:55.02,0:12:56.65,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:12:56.73,0:12:58.11,Default,,0,0,0,,Жарайсың, Райос!
Dialogue: 0,0:12:58.19,0:12:59.32,Default,,0,0,0,,Маған күшіңді бересің бе?
Dialogue: 0,0:12:59.40,0:13:01.19,Default,,0,0,0,,Қан шығып жатыр...
Dialogue: 0,0:13:01.28,0:13:03.45,Default,,0,0,0,,Басында осылай болды
Dialogue: 0,0:13:03.53,0:13:05.57,Default,,0,0,0,,Бірақ оны жұту оңай.
Dialogue: 0,0:13:05.66,0:13:08.03,Default,,0,0,0,,Бәлкім, бұл талантты қандастар.
Dialogue: 0,0:13:08.53,0:13:11.70,Default,,0,0,0,,Марсильдің оқыту әдісі де түсінікті болды.
Dialogue: 0,0:13:12.25,0:13:13.46,Default,,0,0,0,,Рахмет
Dialogue: 0,0:13:14.21,0:13:16.96,Default,,0,0,0,,Ал, мен бұл сезімді ұмытпас бұрын
Dialogue: 0,0:13:17.04,0:13:18.33,Default,,0,0,0,,Сеншимен көреміз бе?
Dialogue: 0,0:13:18.42,0:13:19.29,Default,,0,0,0,,Не!
Dialogue: 0,0:13:19.84,0:13:21.09,Default,,0,0,0,,Өйткені мен қарап отырмын
Dialogue: 0,0:13:21.17,0:13:22.67,Default,,0,0,0,,Дәл солай істеп көріңіз.
Dialogue: 0,0:13:24.34,0:13:25.34,Default,,0,0,0,,ал біз батырлармыз.
Dialogue: 0,0:13:25.43,0:13:28.60,Default,,0,0,0,,Драйад бұтағы бар уақытша жөндеу
Dialogue: 0,0:13:28.68,0:13:30.01,Default,,0,0,0,,Ол сәйкес келе ме?
Dialogue: 0,0:13:32.10,0:13:32.72,Default,,0,0,0,,Сәлем~
Dialogue: 0,0:13:32.81,0:13:34.10,Default,,0,0,0,,-Уф -Уф
Dialogue: 0,0:13:34.18,0:13:35.73,Default,,0,0,0,,Қалай түрту керек...
Dialogue: 0,0:13:35.81,0:13:36.56,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:13:36.64,0:13:38.61,Default,,0,0,0,,Ендеше олай сүрінбе!
Dialogue: 0,0:13:38.69,0:13:40.61,Default,,0,0,0,,Қараңызшы, ұялмаңыз.
Dialogue: 0,0:13:40.69,0:13:42.98,Default,,0,0,0,,Өйткені ұялшақтық – жақсартудың ең үлкен жауы!
Dialogue: 0,0:13:44.07,0:13:46.45,Default,,0,0,0,,Мұндай нәрсені бағаламау өте қиын.
Dialogue: 0,0:13:47.45,0:13:50.87,Default,,0,0,0,,Терапевтер басқа адамдармен көбірек байланысады, бұл қиындық тудырады.
Dialogue: 0,0:13:51.49,0:13:54.50,Default,,0,0,0,,Партияның таралу себебі негізінен адами қарым-қатынастар болып табылады.
Dialogue: 0,0:13:55.29,0:13:57.87,Default,,0,0,0,,Қызғаныш пен көреалмаушылық
Dialogue: 0,0:13:57.96,0:13:59.38,Default,,0,0,0,,Кекпен жек көру
Dialogue: 0,0:13:59.46,0:14:01.04,Default,,0,0,0,,Бұл тітіркендіргіш.
Dialogue: 0,0:14:01.75,0:14:02.92,Default,,0,0,0,,Бұл дегеніміз…
Dialogue: 0,0:14:03.00,0:14:04.59,Default,,0,0,0,,Фарин мен Шроу туралы айтып тұрсың ба?
Dialogue: 0,0:14:04.67,0:14:06.84,Default,,0,0,0,,Менің тәжірибем
Dialogue: 0,0:14:06.93,0:14:08.84,Default,,0,0,0,,Көшбасшының шайқаста шеберлігі жоғары
Dialogue: 0,0:14:08.93,0:14:11.26,Default,,0,0,0,,Адамдарды байланыстыру қабілеті болуы керек
Dialogue: 0,0:14:11.76,0:14:13.77,Default,,0,0,0,,Шынымды айтсам, Райостың сиқырдан да көп нәрсені ұсынатыны бар.
Dialogue: 0,0:14:13.85,0:14:17.19,Default,,0,0,0,,Мен сіздердің әлеуметтік дағдыларды дамытып, адамдарға көз жеткізуді қалаймын.
Dialogue: 0,0:14:17.85,0:14:19.15,Default,,0,0,0,,Егер солай болса
Dialogue: 0,0:14:19.23,0:14:22.48,Default,,0,0,0,,Мен мұны білмей тұрып, қара магияның серіктесі болдым.
Dialogue: 0,0:14:23.23,0:14:24.73,Default,,0,0,0,,Чилчак – сол
Dialogue: 0,0:14:24.82,0:14:26.99,Default,,0,0,0,,Неліктен бір рет сиқырды зерттеп көрмеске?
Dialogue: 0,0:14:27.07,0:14:28.74,Default,,0,0,0,,Тек суреттен қорықпайсыз ба?
Dialogue: 0,0:14:28.82,0:14:30.99,Default,,0,0,0,,О~ бұл жаман болды
Dialogue: 0,0:14:31.07,0:14:34.74,Default,,0,0,0,,Мені эльфтер қара магияға қатысты заттармен айналысқаным үшін ұрлап кетті.
Dialogue: 0,0:14:34.83,0:14:37.71,Default,,0,0,0,,Менің руымның қайтып оралмаған адамдары көп.
Dialogue: 0,0:14:37.79,0:14:40.42,Default,,0,0,0,,Менің көбірек білуге ​​мүмкіндігім болмады.
Dialogue: 0,0:14:40.50,0:14:42.09,Default,,0,0,0,,Жоқ, білмегенім үшін кешірім сұраймын.
Dialogue: 0,0:14:42.17,0:14:44.67,Default,,0,0,0,,Мен зерттеп отырған ежелгі сиқыр
Dialogue: 0,0:14:44.75,0:14:45.80,Default,,0,0,0,,Дөрекі айтқанда
Dialogue: 0,0:14:45.88,0:14:50.18,Default,,0,0,0,,Бұл шексіздік бар басқа өлшемнен энергия әкелетін сиқыр.
Dialogue: 0,0:14:50.26,0:14:53.72,Default,,0,0,0,,Стакан суды газға қалай айналдыруға болады?
Dialogue: 0,0:14:53.81,0:14:55.52,Default,,0,0,0,,Қайнатсаңыз жақсы.
Dialogue: 0,0:14:56.02,0:14:59.94,Default,,0,0,0,,Сонымен, көлдегі барлық суды қалай газға айналдыруға болады?
Dialogue: 0,0:15:00.02,0:15:03.82,Default,,0,0,0,,Теория бірдей, бірақ оны жүзеге асыру біршама қиын.
Dialogue: 0,0:15:04.86,0:15:08.28,Default,,0,0,0,,Үлкен күш пен уақытты қажет ететін сиқырды қолдау
Dialogue: 0,0:15:08.78,0:15:10.32,Default,,0,0,0,,Бұл координаттардың сиқыры
Dialogue: 0,0:15:10.86,0:15:14.12,Default,,0,0,0,,Бұл лабиринт көптеген жерлерде әртүрлі өлшемдерге қосылған.
Dialogue: 0,0:15:14.20,0:15:16.58,Default,,0,0,0,,Бұл қуатты құбыжықтарды шақыру үшін пайдаланыңыз
Dialogue: 0,0:15:16.66,0:15:18.50,Default,,0,0,0,,Осындай лабиринттерді құру
Dialogue: 0,0:15:19.62,0:15:20.58,Default,,0,0,0,,Бәрі сол қорқақтың кесірінен.
Dialogue: 0,0:15:20.67,0:15:23.67,Default,,0,0,0,,Фариннің енді өздігінен емдейтін күші қалмады.
Dialogue: 0,0:15:24.17,0:15:27.59,Default,,0,0,0,,Сонымен мен лабиринттің бір бөлігін қайта жаздым.
Dialogue: 0,0:15:27.67,0:15:31.09,Default,,0,0,0,,Мен «бұл дене лабиринттің бөлігі» деп шештім.
Dialogue: 0,0:15:31.72,0:15:33.34,Default,,0,0,0,,Әрине, бір сәтке ғана.
Dialogue: 0,0:15:34.93,0:15:36.10,Default,,0,0,0,,О!
Dialogue: 0,0:15:36.18,0:15:37.39,Default,,0,0,0,,Жер қайтадан шуылдады.
Dialogue: 0,0:15:37.47,0:15:38.22,Default,,0,0,0,,Жақын.
Dialogue: 0,0:15:39.81,0:15:40.98,Default,,0,0,0,,Мына жаққа қара!
Dialogue: 0,0:15:41.06,0:15:42.31,Default,,0,0,0,,Қабырға қозғалады
Dialogue: 0,0:15:43.86,0:15:45.23,Default,,0,0,0,,​​Қайда бара жатырсың?
Dialogue: 0,0:15:45.32,0:15:46.82,Default,,0,0,0,,Неге жақын жерде жүрмеске?
Dialogue: 0,0:15:47.40,0:15:48.23,Default,,0,0,0,,Иә
Dialogue: 0,0:15:49.19,0:15:49.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:50.07,0:15:51.24,Default,,0,0,0,,Егер ұйықтап жатқанда Толық шоғырлану тынысын тоқтатсам,
Dialogue: 0,0:15:51.32,0:15:52.66,Default,,0,0,0,,Не болды?
Dialogue: 0,0:15:53.16,0:15:54.62,Default,,0,0,0,,Кю кенеттен басым айналып кетті...
Dialogue: 0,0:15:54.70,0:15:58.04,Default,,0,0,0,,А-а... Мүмкін сиқырды алғаш рет қолданғандықтан шығар.
Dialogue: 0,0:15:58.12,0:16:00.37,Default,,0,0,0,,Мүмкін мен сиқырлы ауруды тудыратын шығармын.
Dialogue: 0,0:16:00.96,0:16:02.87,Default,,0,0,0,,Жақында реттеледі деп ойлаймын...
Dialogue: 0,0:16:02.96,0:16:03.96,Default,,0,0,0,,Мен оны қалдырамын.
Dialogue: 0,0:16:04.04,0:16:05.13,Default,,0,0,0,,Жақсы демалыңыз.
Dialogue: 0,0:16:05.21,0:16:06.13,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:16:06.21,0:16:10.13,Default,,0,0,0,,Көзіңді жұмсаң да, ашсаң да, бәрі толық түсті...
Dialogue: 0,0:16:10.97,0:16:12.47,Default,,0,0,0,,Маған көмектесіңіз...
Dialogue: 0,0:16:12.55,0:16:15.89,Default,,0,0,0,,Сиқыршы өлсін...
Dialogue: 0,0:16:15.97,0:16:19.31,Default,,0,0,0,,Бұл галлюцинация ма? Есту галлюцинациясы?
Dialogue: 0,0:16:19.39,0:16:22.60,Default,,0,0,0,,Өтінемін... өтінемін... өлуге рұқсат етіңіз...
Dialogue: 0,0:16:22.69,0:16:25.86,Default,,0,0,0,,Сиқырлы ауру... бұл ең нашар...
Dialogue: 0,0:16:29.11,0:16:31.19,Default,,0,0,0,,Сол жерде жол өзгерді.
Dialogue: 0,0:16:31.28,0:16:32.03,Default,,0,0,0,,Хмм.
Dialogue: 0,0:16:32.11,0:16:35.82,Default,,0,0,0,,Мен заңдылықты түсінетін сияқтымын Бұл мүмкін емес сияқты
Dialogue: 0,0:16:35.91,0:16:37.16,Default,,0,0,0,,Біз жеңілдік.
Dialogue: 0,0:16:37.24,0:16:39.49,Default,,0,0,0,,Маған көбірек бақылау керек.
Dialogue: 0,0:16:40.08,0:16:42.75,Default,,0,0,0,,Қозғала алмау ауырады...
Dialogue: 0,0:16:42.83,0:16:43.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:45.04,0:16:46.58,Default,,0,0,0,,Менің аяғым көтеріліп жатыр!
Dialogue: 0,0:16:46.67,0:16:47.88,Default,,0,0,0,,Түсіңіз! Түсіңіз!
Dialogue: 0,0:16:47.96,0:16:49.67,Default,,0,0,0,,Ой! Ой!
Dialogue: 0,0:16:49.75,0:16:51.01,Default,,0,0,0,,Қауіпті Қауіпті
Dialogue: 0,0:16:51.59,0:16:53.72,Default,,0,0,0,,Қайтыс болмайтын жерге жеттім.
Dialogue: 0,0:16:53.80,0:16:54.93,Default,,0,0,0,,Хм
Dialogue: 0,0:16:55.01,0:16:56.76,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:17:02.64,0:17:04.44,Default,,0,0,0,,Гяаааааа...
Dialogue: 0,0:17:05.27,0:17:06.98,Default,,0,0,0,,Насыбайгүлге ұқсайды
Dialogue: 0,0:17:07.06,0:17:09.23,Default,,0,0,0,,Кокатрица одан да қауіпті!
Dialogue: 0,0:17:09.32,0:17:11.73,Default,,0,0,0,,Шағып алма, әйтпесе тас мүсінге айналасың!
Dialogue: 0,0:17:12.40,0:17:12.94,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:13.03,0:17:14.11,Default,,0,0,0,,Сол жақтағы есік!
Dialogue: 0,0:17:14.20,0:17:15.70,Default,,0,0,0,,Сол жаққа жүгір!
Dialogue: 0,0:17:15.78,0:17:17.12,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:17.20,0:17:17.74,Default,,0,0,0,,(Есіктің жабылу дыбысы)
Dialogue: 0,0:17:28.08,0:17:29.63,Default,,0,0,0,,Не болды?
Dialogue: 0,0:17:29.71,0:17:31.42,Default,,0,0,0,,Ұзақ емес.
Dialogue: 0,0:17:31.50,0:17:33.59,Default,,0,0,0,,Артқы жақтан қашып құтыла алмайсың ба?
Dialogue: 0,0:17:33.67,0:17:37.05,Default,,0,0,0,,Егер оның насыбайгүлге ұқсас қасиеттері болса, онда мүмкін
Dialogue: 0,0:17:37.14,0:17:40.01,Default,,0,0,0,,Ол бізді дене температурасы арқылы таниды.
Dialogue: 0,0:17:40.60,0:17:42.72,Default,,0,0,0,,Жасырын құтылу қиын
Dialogue: 0,0:17:43.22,0:17:46.35,Default,,0,0,0,,Бірақ бұл жылан басының қабілеті.
Dialogue: 0,0:17:46.44,0:17:49.15,Default,,0,0,0,,Құстың басы көру қабілетіне сүйенуі керек.
Dialogue: 0,0:17:49.23,0:17:50.15,Default,,0,0,0,,Марсиль
Dialogue: 0,0:17:50.23,0:17:53.23,Default,,0,0,0,,Лайос бұрын Базилискті қалай жеңді?
Dialogue: 0,0:17:53.32,0:17:54.32,Default,,0,0,0,,есімде.
Dialogue: 0,0:17:54.40,0:17:55.28,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:17:56.49,0:17:58.03,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:58.11,0:18:00.41,Default,,0,0,0,,Ешқашан қорықпа
Dialogue: 0,0:18:00.49,0:18:03.45,Default,,0,0,0,,Қарсыласыңызды жан-тәніңізбен қорқытыңыз!
Dialogue: 0,0:18:03.54,0:18:04.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:04.62,0:18:06.75,Default,,0,0,0,,Сіз осылай дедіңіз...
Dialogue: 0,0:18:06.83,0:18:08.71,Default,,0,0,0,,Тек денеңізді үлкен етіп көрсетіңіз
Dialogue: 0,0:18:08.79,0:18:11.04,Default,,0,0,0,,Барынша қатты сөйлеңіз!
Dialogue: 0,0:18:11.13,0:18:14.42,Default,,0,0,0,,Солардың ішіндегі ең ұзыны менмін, бірақ...
Dialogue: 0,0:18:14.51,0:18:17.30,Default,,0,0,0,,Қарсылас та өткен жолғыдан екі есе үлкен.
Dialogue: 0,0:18:17.38,0:18:20.64,Default,,0,0,0,,Даусымды көтеруге шебер емеспін...
Dialogue: 0,0:18:20.72,0:18:21.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:21.39,0:18:23.51,Default,,0,0,0,,«Лайос» деп айқайладыңыз ба?
Dialogue: 0,0:18:24.35,0:18:26.18,Default,,0,0,0,,«Уау» жеткілікті ме?
Dialogue: 0,0:18:26.27,0:18:28.31,Default,,0,0,0,,Бұл «гао~» болды ма?
Dialogue: 0,0:18:28.39,0:18:30.23,Default,,0,0,0,,Que!
Dialogue: 0,0:18:30.31,0:18:31.73,Default,,0,0,0,,Хмм.
Dialogue: 0,0:18:31.81,0:18:34.19,Default,,0,0,0,,Жоқ, бәрібір, егер сіз басқа адамды селт еткізсеңіз
Dialogue: 0,0:18:34.28,0:18:35.86,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:18:37.20,0:18:40.24,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:42.20,0:18:45.66,Default,,0,0,0,,Жоқ, бұл сөзсіз, мүлде сәтсіз болады.
Dialogue: 0,0:18:45.75,0:18:47.46,Default,,0,0,0,,Сіз Лайосқа еліктей алмайсыз.
Dialogue: 0,0:18:47.54,0:18:49.58,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:18:51.04,0:18:52.00,Default,,0,0,0,,Мен...
Dialogue: 0,0:18:52.09,0:18:53.63,Default,,0,0,0,,Менің...
Dialogue: 0,0:18:54.67,0:18:55.80,Default,,0,0,0,,Өз жолыңызда!
Dialogue: 0,0:19:01.30,0:19:03.43,Default,,0,0,0,,Ах~ Ах!
Dialogue: 0,0:19:03.51,0:19:04.93,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:19:06.27,0:19:07.89,Default,,0,0,0,,Бұл қандай жарылыс дыбысы?
Dialogue: 0,0:19:07.98,0:19:09.69,Default,,0,0,0,,Бұл Марсиль, кеттік!
Dialogue: 0,0:19:12.90,0:19:15.32,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:15.40,0:19:16.11,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,0:19:16.94,0:19:17.61,Default,,0,0,0,,Біз оның жайлы өте аз білеміз… Бұл не, мырза Ринатаки?
Dialogue: 0,0:19:17.69,0:19:19.11,Default,,0,0,0,,Не? Е~
Dialogue: 0,0:19:19.20,0:19:21.74,Default,,0,0,0,,Бұл өте көзге көрінетін болды.
Dialogue: 0,0:19:21.82,0:19:23.78,Default,,0,0,0,,Екеуің де менен қорқасыңдар ма?
Dialogue: 0,0:19:23.87,0:19:24.78,Default,,0,0,0,,Ән!
Dialogue: 0,0:19:24.87,0:19:26.20,Default,,0,0,0,,Уақытында емес!
Dialogue: 0,0:19:27.33,0:19:29.25,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:30.29,0:19:31.25,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:19:31.92,0:19:32.50,Default,,0,0,0,,Уф!
Dialogue: 0,0:19:33.46,0:19:36.50,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:19:36.59,0:19:39.17,Default,,0,0,0,,Марсиль Сізді тістеп алды ма?
Dialogue: 0,0:19:39.26,0:19:40.88,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:19:42.72,0:19:44.85,Default,,0,0,0,,Тістеген шығарсың, ақымақ!
Dialogue: 0,0:19:45.43,0:19:46.51,Default,,0,0,0,,Ah, already!
Dialogue: 0,0:19:46.60,0:19:49.02,Default,,0,0,0,,Не? Кокатрица тістеп алды ма?
Dialogue: 0,0:19:49.10,0:19:50.31,Default,,0,0,0,,Бұл қиын!
Dialogue: 0,0:19:50.39,0:19:53.10,Default,,0,0,0,,Сізді кокатрица тістеп алса, не істеу керектігін білесіз бе?
Dialogue: 0,0:19:53.65,0:19:55.15,Default,,0,0,0,,Хм... Ондай нәрсе бар ма?
Dialogue: 0,0:19:55.23,0:19:56.98,Default,,0,0,0,,Алдымен іш киіміңді шеш!
Dialogue: 0,0:19:58.48,0:20:00.95,Default,,0,0,0,,Теріге қарай отырыңыз!
Dialogue: 0,0:20:02.24,0:20:05.16,Default,,0,0,0,,Қолдарыңызды қатайтып, құлақтарыңызды саусақтарыңызбен жабыңыз!
Dialogue: 0,0:20:05.24,0:20:07.03,Default,,0,0,0,,- Сіз де аузыңызды жабыңыз! -Хмм
Dialogue: 0,0:20:07.74,0:20:10.00,Default,,0,0,0,,-Хаа -Иә.
Dialogue: 0,0:20:10.08,0:20:13.08,Default,,0,0,0,,Жарайды, енді сіз кез келген уақытта тастайсыз.
Dialogue: 0,0:20:13.17,0:20:15.54,Default,,0,0,0,,Бұл тас болып қалмаудың жолы емес пе?
Dialogue: 0,0:20:17.00,0:20:17.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:18.50,0:20:20.92,Default,,0,0,0,,Ах~
Dialogue: 0,0:20:21.01,0:20:24.26,Default,,0,0,0,,Мен өте қауіпті күйде қатып қалдым.
Dialogue: 0,0:20:24.34,0:20:25.34,Default,,0,0,0,,Сынуға жақын
Dialogue: 0,0:20:25.43,0:20:28.43,Default,,0,0,0,,Оның үстіне, менің ауырлық центрім қисайған және мен кез келген сәтте құлап кететін сияқтымын.
Dialogue: 0,0:20:28.51,0:20:30.14,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:20:30.64,0:20:33.14,Default,,0,0,0,,Адамдар мұндай болғысы келмейді.
Dialogue: 0,0:20:33.77,0:20:35.40,Default,,0,0,0,,Мұнымен не істеуім керек?
Dialogue: 0,0:20:35.48,0:20:36.86,Default,,0,0,0,,Тастауды қалай жоюға болады?
Dialogue: 0,0:20:37.40,0:20:39.44,Default,,0,0,0,,Хм, әртүрлі нәрселер бар ...
Dialogue: 0,0:20:40.03,0:20:41.69,Default,,0,0,0,,Алдымен табиғи сауығуды күтіңіз
Dialogue: 0,0:20:42.36,0:20:45.45,Default,,0,0,0,,Тастау удың емес, қарғыстың бір түрі сияқты.
Dialogue: 0,0:20:46.03,0:20:48.20,Default,,0,0,0,,Егер сіз сиқырлы қарсылығы күшті эльф болсаңыз
Dialogue: 0,0:20:48.28,0:20:50.29,Default,,0,0,0,,Басқа нәсілдерге қарағанда тезірек қалпына келеді
Dialogue: 0,0:20:51.12,0:20:54.25,Default,,0,0,0,,Екіншісі – тасты емдейтін дәрілік шөп немесе
Dialogue: 0,0:20:54.33,0:20:57.59,Default,,0,0,0,,Қалпына келтіру құралы бар басқа авантюристерді іздеңіз.
Dialogue: 0,0:20:58.17,0:20:58.96,Default,,0,0,0,,Соңында...
Dialogue: 0,0:20:59.05,0:21:02.09,Default,,0,0,0,,Мен емдік сиқырды көрсетуге бар күшімді саламын!
Dialogue: 0,0:21:02.17,0:21:03.55,Default,,0,0,0,,Сіз?
Dialogue: 0,0:21:03.63,0:21:06.59,Default,,0,0,0,,Марсиль маған сиқырлы кітаптарды оқуды үйретті.
Dialogue: 0,0:21:07.22,0:21:09.18,Default,,0,0,0,,Сондай-ақ тасты кетіру үшін заклинание болуы керек.
Dialogue: 0,0:21:09.85,0:21:11.18,Default,,0,0,0,,Хмм.
Dialogue: 0,0:21:11.27,0:21:13.85,Default,,0,0,0,,Дәрілік шөптерді немесе авантюристерді іздеу.
Dialogue: 0,0:21:13.94,0:21:16.40,Default,,0,0,0,,Мен басқа екі нұсқаны да қолданғым келеді.
Dialogue: 0,0:21:16.90,0:21:19.61,Default,,0,0,0,,Табиғи сауығу қанша уақытқа созылады?
Dialogue: 0,0:21:20.36,0:21:22.65,Default,,0,0,0,,Таллман үшін бұл 6 айдан 10 жылға дейін созылады.
Dialogue: 0,0:21:23.49,0:21:25.32,Default,,0,0,0,,Кокатриканы ұста
Dialogue: 0,0:21:28.03,0:21:30.70,Default,,0,0,0,,Түсі бір түнде айтарлықтай өзгерді.
Dialogue: 0,0:21:30.79,0:21:32.70,Default,,0,0,0,,Біз онымен тез күресуіміз керек...
Dialogue: 0,0:21:33.29,0:21:35.33,Default,,0,0,0,,Ол еңкейтілген және қауіпті.
Dialogue: 0,0:21:35.92,0:21:38.63,Default,,0,0,0,,Бөксеге бірдеңе тістеген дұрыс емес пе?
Dialogue: 0,0:21:39.13,0:21:40.00,Default,,0,0,0,,That's right.
Dialogue: 0,0:21:40.09,0:21:41.84,Default,,0,0,0,,Менің жақсы ойым бар.
Dialogue: 0,0:21:42.46,0:21:44.88,Default,,0,0,0,,Кәстрөлдің түбіне ұсақталған бүршіктерді қосыңыз.
Dialogue: 0,0:21:44.97,0:21:47.13,Default,,0,0,0,,Дәмдеуіштер қоспасын жағыңыз.
Dialogue: 0,0:21:47.22,0:21:49.14,Default,,0,0,0,,Үстіне марцилды қойыңыз
Dialogue: 0,0:21:50.05,0:21:51.89,Default,,0,0,0,,Аа... кірпігім сынды.
Dialogue: 0,0:21:51.97,0:21:54.73,Default,,0,0,0,,Кокатрица етін тұзды суға салып қойыңыз
Dialogue: 0,0:21:54.81,0:21:56.48,Default,,0,0,0,,Марсильдің тізесіне қойылған
Dialogue: 0,0:21:56.56,0:21:58.44,Default,,0,0,0,,Ескерту
Dialogue: 0,0:22:00.56,0:22:03.23,Default,,0,0,0,,Ал, сіз тұрақтылық сезімін сезіндіңіз бе?
Dialogue: 0,0:22:03.32,0:22:05.24,Default,,0,0,0,,Осымен сіз құламайсыз.
Dialogue: 0,0:22:05.82,0:22:07.86,Default,,0,0,0,,Секінетін пұтқа ұқсайды.
Dialogue: 0,0:22:08.45,0:22:11.66,Default,,0,0,0,,Осыдан кейін Лайос және оның достары көп жұмыс істеді.
Dialogue: 0,0:22:12.49,0:22:14.70,Default,,0,0,0,,Қайталанатын сынақ және қате...
Dialogue: 0,0:22:18.08,0:22:19.00,Default,,0,0,0,,Міне болды!
Dialogue: 0,0:22:19.08,0:22:21.00,Default,,0,0,0,,Ол қалай қолданылады?
Dialogue: 0,0:22:21.09,0:22:22.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:23.13,0:22:24.38,Default,,0,0,0,,Осы жаққа қара.
Dialogue: 0,0:22:24.46,0:22:26.01,Default,,0,0,0,,Оны қою керек пе?
Dialogue: 0,0:22:26.63,0:22:29.09,Default,,0,0,0,,Тас терісі дене қызуымен қызады.
Dialogue: 0,0:22:29.59,0:22:30.76,Default,,0,0,0,,Ән...
Dialogue: 0,0:22:30.85,0:22:33.26,Default,,0,0,0,,Spelae Yeptum
Dialogue: 0,0:22:33.35,0:22:35.77,Default,,0,0,0,,Руфермус Вильяр
Dialogue: 0,0:22:36.77,0:22:38.77,Default,,0,0,0,,Айтылуы дұрыс па?
Dialogue: 0,0:22:38.85,0:22:39.69,Default,,0,0,0,,Бұл…
Dialogue: 0,0:22:40.23,0:22:41.27,Default,,0,0,0,,- (жер гүрілдеп) - Ах!
Dialogue: 0,0:22:42.36,0:22:42.86,Default,,0,0,0,,Қауіпті!
Dialogue: 0,0:22:48.40,0:22:49.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:49.53,0:22:50.70,Default,,0,0,0,,Марсиль!
Dialogue: 0,0:22:50.78,0:22:51.78,Default,,0,0,0,,Жұмсақ
Dialogue: 0,0:22:51.87,0:22:53.62,Default,,0,0,0,,-Сәттілік~ -Уау~
Dialogue: 0,0:22:53.70,0:22:54.83,Default,,0,0,0,,Не?
Dialogue: 0,0:22:54.91,0:22:57.87,Default,,0,0,0,,Не? Неліктен көкөністер туралған?
Dialogue: 0,0:22:57.96,0:22:59.71,Default,,0,0,0,,Неліктен кастрюль?
Dialogue: 0,0:22:59.79,0:23:01.04,Default,,0,0,0,,Қайсысы...
Dialogue: 0,0:23:02.21,0:23:03.63,Default,,0,0,0,,Бұл да сәтті болды!
Dialogue: 0,0:23:03.71,0:23:05.09,Default,,0,0,0,,-Уау -Бұл не?
Dialogue: 0,0:23:05.67,0:23:07.84,Default,,0,0,0,,Тұздалған етті қайнату
Dialogue: 0,0:23:07.92,0:23:09.59,Default,,0,0,0,,Жұқа тілімдерге кесіңіз
Dialogue: 0,0:23:09.68,0:23:12.85,Default,,0,0,0,,Ашыған бүршіктерді тамақтандырсаңыз
Dialogue: 0,0:23:12.93,0:23:14.47,Default,,0,0,0,,Ол аяқталды!
Dialogue: 0,0:23:16.43,0:23:18.60,Default,,0,0,0,,Аа, сонша уақыт болды ма?
Dialogue: 0,0:23:19.19,0:23:21.06,Default,,0,0,0,,Соңында не істеді?
Dialogue: 0,0:23:21.56,0:23:24.07,Default,,0,0,0,,Мен тым көп нәрсені сынап көрдім және түсінбеймін.
Dialogue: 0,0:23:24.15,0:23:26.32,Default,,0,0,0,,Бұл менің сиқырым болса екен.
Dialogue: 0,0:23:26.40,0:23:29.61,Default,,0,0,0,,Ендеше, емдік шөптердің балғындығы жақсы болды.
Dialogue: 0,0:23:29.70,0:23:32.28,Default,,0,0,0,,Пісірілген кокатрица еті
Dialogue: 0,0:23:32.37,0:23:34.62,Default,,0,0,0,,Қарғысты бейтараптандырдың ба...
Dialogue: 0,0:23:34.70,0:23:35.87,Default,,0,0,0,,Мен
Dialogue: 0,0:23:35.95,0:23:38.16,Default,,0,0,0,,Жерге қайту керек болғанда
Dialogue: 0,0:23:38.25,0:23:39.66,Default,,0,0,0,,Сіз маған қамқор болдыңыз ...
Dialogue: 0,0:23:40.62,0:23:41.58,Default,,0,0,0,,Барлығыңызды кешіріңіз...
Dialogue: 0,0:23:41.67,0:23:44.09,Default,,0,0,0,,Жоқ... бұл дұрыс емес.
Dialogue: 0,0:23:44.67,0:23:47.76,Default,,0,0,0,,Осындай кезде көп нәрсені айтуға болады.
Dialogue: 0,0:23:48.55,0:23:50.30,Default,,0,0,0,,Ең алдымен...
Dialogue: 0,0:23:51.51,0:23:54.10,Default,,0,0,0,,Адамдарды маринадталған тас ретінде пайдаланбаңыз
Dialogue: 0,0:23:54.97,0:23:57.18,Default,,0,0,0,,Әйтеуір, зындандағы тағам
Dialogue: 0,0:23:57.26,0:23:59.60,Default,,0,0,0,,А, зындандағы тағам
Dialogue: 0,0:24:00.98,0:24:02.98,Default,,0,0,0,,♪~
Dialogue: 0,0:25:27.98,0:25:29.98,Default,,0,0,0,,~♪
Dialogue: 0,0:25:31.48,0:25:37.48,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory