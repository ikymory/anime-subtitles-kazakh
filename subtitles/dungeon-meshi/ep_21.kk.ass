Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.00,0:00:03.00,Default,,0,0,0,,♪~
Dialogue: 0,0:01:26.50,0:01:28.50,Default,,0,0,0,,~♪
Dialogue: 0,0:01:35.26,0:01:36.51,Default,,0,0,0,,Мен үйдемін~
Dialogue: 0,0:01:36.59,0:01:37.34,Default,,0,0,0,,Фува…
Dialogue: 0,0:01:37.43,0:01:39.05,Default,,0,0,0,,Өйткені, жер үстіндегі ауа ең жақсы.
Dialogue: 0,0:01:39.14,0:01:40.26,Default,,0,0,0,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,0:01:40.35,0:01:42.51,Default,,0,0,0,,Бұл таң ба? кеш?
Dialogue: 0,0:01:42.60,0:01:43.89,Default,,0,0,0,,Терезені әлі ұстамаңыз!
Dialogue: 0,0:01:43.97,0:01:46.02,Default,,0,0,0,,Телепортация техникасы пайдасыз болады!
Dialogue: 0,0:01:46.10,0:01:46.94,Default,,0,0,0,,Кабру
Dialogue: 0,0:01:47.48,0:01:49.69,Default,,0,0,0,,Ертең мен арал иесіне есеп беремін.
Dialogue: 0,0:01:50.61,0:01:52.40,Default,,0,0,0,,Мен қосымша айғақтар сұрағым келеді.
Dialogue: 0,0:01:52.98,0:01:55.19,Default,,0,0,0,,Сен маған бәрін айтып бересің бе?
Dialogue: 0,0:01:55.28,0:01:58.41,Default,,0,0,0,,Лайос және басқалар туралы ештеңе айтудың қажеті жоқ.
Dialogue: 0,0:01:59.11,0:02:00.16,Default,,0,0,0,,Мен енді жоқпын
Dialogue: 0,0:02:00.24,0:02:03.29,Default,,0,0,0,,Мен жай ғана Фариннің адамдардан бас тартқанын қаламаймын.
Dialogue: 0,0:02:03.37,0:02:04.41,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:02:05.08,0:02:06.79,Default,,0,0,0,,Бүгін жақсылап демалыңыз.
Dialogue: 0,0:02:07.41,0:02:09.00,Default,,0,0,0,,Ой! Қараңыз, Куро!
Dialogue: 0,0:02:09.08,0:02:10.17,Default,,0,0,0,,Үлкен кеме
Dialogue: 0,0:02:10.88,0:02:13.00,Default,,0,0,0,,Байлар, сіз көп мінесіз бе?
Dialogue: 0,0:02:13.09,0:02:14.76,Default,,0,0,0,,Хмм... Уа!
Dialogue: 0,0:02:18.09,0:02:19.30,Default,,0,0,0,,Бұл жаман...
Dialogue: 0,0:02:20.14,0:02:21.51,Default,,0,0,0,,Тосиро-сан
Dialogue: 0,0:02:21.60,0:02:24.01,Default,,0,0,0,,Енді барған дұрыс сияқты.
Dialogue: 0,0:02:24.10,0:02:25.43,Default,,0,0,0,,Сол ақ кеме туралы не деуге болады?
Dialogue: 0,0:02:25.93,0:02:28.06,Default,,0,0,0,,Бұл батыс эльф кемесі.
Dialogue: 0,0:02:28.73,0:02:30.31,Default,,0,0,0,,Құстың басы
Dialogue: 0,0:02:30.90,0:02:32.65,Default,,0,0,0,,Оны канарея деп атайды.
Dialogue: 0,0:02:34.23,0:02:37.57,Default,,0,0,0,,Лабиринттің қауіптілігі белгілі бір деңгейден асқанда келеді
Dialogue: 0,0:02:38.24,0:02:42.28,Default,,0,0,0,,Олардың міндеті - лабиринтті зерттеу... және оны бағындыру.
Dialogue: 0,0:02:42.78,0:02:46.62,Default,,0,0,0,,Арал иесіне қысым көрсетіп жатыр деген қауесеттер біраздан бері айтылып жүр.
Dialogue: 0,0:02:46.70,0:02:48.96,Default,,0,0,0,,Сіз мәжбүрлеу шараларын қолданған сияқтысыз.
Dialogue: 0,0:02:49.04,0:02:50.83,Default,,0,0,0,,Бұл рұқсат етілген бе?
Dialogue: 0,0:02:50.92,0:02:52.92,Default,,0,0,0,,Бұл Таллманның жері, солай ма?
Dialogue: 0,0:02:53.79,0:02:57.13,Default,,0,0,0,,Эльфтер мен гномдар үшін қысқа өмір сүретін түрлер сәбилер сияқты.
Dialogue: 0,0:02:57.76,0:03:01.09,Default,,0,0,0,,Оның үстіне аралдың иесі жақсы келіссөз жүргізушісі емес...
Dialogue: 0,0:03:01.18,0:03:02.39,Default,,0,0,0,,Осындай күйде тежеліп тұру аса жағымды емес
Dialogue: 0,0:03:05.56,0:03:06.35,Default,,0,0,0,,Әй!
Dialogue: 0,0:03:06.43,0:03:07.43,Default,,0,0,0,,Маңызы бар деп саналатын бір куәгерлік көрсету бар
Dialogue: 0,0:03:08.18,0:03:09.77,Default,,0,0,0,,Бұл Шлоу емес пе?
Dialogue: 0,0:03:09.85,0:03:11.06,Default,,0,0,0,,Намари?
Dialogue: 0,0:03:11.69,0:03:12.81,Default,,0,0,0,,Фарин ше?
Dialogue: 0,0:03:13.61,0:03:14.65,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:16.23,0:03:18.49,Default,,0,0,0,,Лайос пен басқалары бас тартпаған сияқты...
Dialogue: 0,0:03:19.11,0:03:20.24,Default,,0,0,0,,Мен...
Dialogue: 0,0:03:22.45,0:03:24.16,Default,,0,0,0,,Сіз мұны жедіңіз бе?
Dialogue: 0,0:03:24.24,0:03:25.28,Default,,0,0,0,,Мен тамақтанып отырдым...
Dialogue: 0,0:03:25.83,0:03:28.50,Default,,0,0,0,,Біз арал иесін көруге келдік.
Dialogue: 0,0:03:28.58,0:03:30.75,Default,,0,0,0,,А... бұл мүмкін емес.
Dialogue: 0,0:03:30.83,0:03:33.75,Default,,0,0,0,,Мен маңызды адам кенеттен келгендіктен ғана кірдім.
Dialogue: 0,0:03:33.83,0:03:36.25,Default,,0,0,0,,Сағаттап шықпайды
Dialogue: 0,0:03:36.34,0:03:37.13,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:37.21,0:03:38.26,Default,,0,0,0,,тым кеш пе...
Dialogue: 0,0:03:38.84,0:03:40.05,Default,,0,0,0,,ішке кірейік.
Dialogue: 0,0:03:40.13,0:03:41.26,Default,,0,0,0,,Бұл жаман болар еді
Dialogue: 0,0:03:41.34,0:03:44.39,Default,,0,0,0,,Лабиринт эльфтердің қолына түскенде, бар болғаны.
Dialogue: 0,0:03:45.30,0:03:48.68,Default,,0,0,0,,Менің туған жерім де лабиринтте гүлденген қала болды.
Dialogue: 0,0:03:50.06,0:03:52.27,Default,,0,0,0,,Бір күні құбыжықтар кенет толып кетті.
Dialogue: 0,0:03:52.35,0:03:54.94,Default,,0,0,0,,Эльфтер келіп, көпшілігі өлді.
Dialogue: 0,0:03:55.65,0:03:58.94,Default,,0,0,0,,Неліктен менің отбасым өлуге мәжбүр болды?
Dialogue: 0,0:03:59.57,0:04:03.32,Default,,0,0,0,,Анам мені жалғыз өсірді.
Dialogue: 0,0:04:04.11,0:04:05.95,Default,,0,0,0,,Бұлай өлетін адам емес.
Dialogue: 0,0:04:07.16,0:04:10.33,Default,,0,0,0,,Мен мұның қайталанғанын қаламаймын.
Dialogue: 0,0:04:10.41,0:04:13.58,Default,,0,0,0,,Қазіргі құрылым тек кейбір нәсілдердің күші бар.
Dialogue: 0,0:04:13.67,0:04:15.67,Default,,0,0,0,,Екеуіне де зиянды
Dialogue: 0,0:04:15.75,0:04:17.21,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:17.29,0:04:18.21,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:04:21.80,0:04:23.18,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:04:23.26,0:04:26.09,Default,,0,0,0,,Менің арал қожайынына хабарлауым керек.
Dialogue: 0,0:04:26.64,0:04:27.85,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:28.56,0:04:29.47,Default,,0,0,0,,Не?
Dialogue: 0,0:04:29.56,0:04:31.73,Default,,0,0,0,,Көріп отырғаныңыздай, ол жүктелуде.
Dialogue: 0,0:04:31.81,0:04:33.23,Default,,0,0,0,,Шығаруға өтініш беріңіз
Dialogue: 0,0:04:33.98,0:04:36.48,Default,,0,0,0,,Бұл лабиринттің қазіргі жағдайы туралы есеп.
Dialogue: 0,0:04:36.56,0:04:38.02,Default,,0,0,0,,Мені тыңдаңыз.
Dialogue: 0,0:04:38.90,0:04:40.69,Default,,0,0,0,,(Эльфтердің сөйлейтін дауыстары)
Dialogue: 0,0:04:40.78,0:04:42.28,Default,,0,0,0,,Кешіктірмеңіз...
Dialogue: 0,0:04:43.90,0:04:45.03,Default,,0,0,0,,Қысқа болыңыз
Dialogue: 0,0:04:45.11,0:04:47.91,Default,,0,0,0,,Лабиринтті зерттеу кезінде
Dialogue: 0,0:04:47.99,0:04:51.41,Default,,0,0,0,,Мен құбыжыққа айналған адамды кездестірдім.
Dialogue: 0,0:04:51.50,0:04:52.16,Default,,0,0,0,,На
Dialogue: 0,0:04:52.25,0:04:53.16,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:53.25,0:04:55.21,Default,,0,0,0,,Қат! Химера?
Dialogue: 0,0:04:55.29,0:04:56.92,Default,,0,0,0,,Прогресс күтілгеннен жылдамырақ
Dialogue: 0,0:04:57.00,0:04:58.84,Default,,0,0,0,,Қарашы, мен саған айттым ғой!
Dialogue: 0,0:04:58.92,0:05:01.59,Default,,0,0,0,,Жауапты жайбарақат күтуге уақытым болмады!
Dialogue: 0,0:05:01.67,0:05:03.26,Default,,0,0,0,,Қону тапсырыстары қазір!
Dialogue: 0,0:05:03.34,0:05:04.47,Default,,0,0,0,,Қандай өзімшіл нәрсе!
Dialogue: 0,0:05:04.55,0:05:06.84,Default,,0,0,0,,Қария, сабыр сақта
Dialogue: 0,0:05:06.93,0:05:10.72,Default,,0,0,0,,Адам өміріне келгенде шекара және басқа да қиын...
Dialogue: 0,0:05:10.81,0:05:14.14,Default,,0,0,0,,Сізге қарт адам сияқты қарауға ешқандай себеп жоқ.
Dialogue: 0,0:05:14.23,0:05:16.73,Default,,0,0,0,,Сандық... Бұл жеткілікті емес пе?
Dialogue: 0,0:05:16.81,0:05:17.81,Default,,0,0,0,,На
Dialogue: 0,0:05:17.90,0:05:19.61,Default,,0,0,0,,Арал шебері күткендей
Dialogue: 0,0:05:19.69,0:05:21.23,Default,,0,0,0,,Икемді және ақылды
Dialogue: 0,0:05:21.32,0:05:23.24,Default,,0,0,0,,Олай болса осы жерге мөртаңба қойыңыз.
Dialogue: 0,0:05:23.32,0:05:25.45,Default,,0,0,0,,Жоқ! Бұл болмайды!
Dialogue: 0,0:05:25.53,0:05:28.57,Default,,0,0,0,,Бұл жағдайды одан сайын қиындатады...
Dialogue: 0,0:05:29.16,0:05:30.24,Default,,0,0,0,,Шын мәнінде...
Dialogue: 0,0:05:30.91,0:05:35.12,Default,,0,0,0,,Егер менде лабиринтті басқара алатын қабілетім болса, еш қиындық болмас еді.
Dialogue: 0,0:05:35.71,0:05:36.79,Default,,0,0,0,,Бұл қандай қорқыту… Жақындама!
Dialogue: 0,0:05:37.46,0:05:41.92,Default,,0,0,0,,Сондықтан мен басқа қабілетті авантюристтердің мені қолдай алатынын зерттей бастадым.
Dialogue: 0,0:05:43.26,0:05:47.09,Default,,0,0,0,,Бірақ көпшілігі өзімшіл және елеусіз болды.
Dialogue: 0,0:05:47.76,0:05:51.85,Default,,0,0,0,,Соңында лабиринтті өз күшіммен бағындырудан басқа амалым жоқ деп шештім.
Dialogue: 0,0:05:51.93,0:05:54.73,Default,,0,0,0,,Мен Торден ағалары туралы өсек естідім.
Dialogue: 0,0:05:54.81,0:05:56.85,Default,,0,0,0,,Иә, сіз өте жақсы тәрбиелісіз.
Dialogue: 0,0:05:57.39,0:06:00.11,Default,,0,0,0,,Менің интуициям жақсы, бірақ сіз мені риясыз деп айта аласыз...
Dialogue: 0,0:06:00.19,0:06:01.90,Default,,0,0,0,,Ол жай ғана біртүрлі жігіт.
Dialogue: 0,0:06:02.57,0:06:05.57,Default,,0,0,0,,Мен іздеген сайын ол бөтен болып кетті.
Dialogue: 0,0:06:05.65,0:06:09.32,Default,,0,0,0,,Ол ерекше күшті болмаса да, тереңдікке жетеді
Dialogue: 0,0:06:09.41,0:06:12.66,Default,,0,0,0,,Жаман өсек айтатын адамдарға ақша ағылады
Dialogue: 0,0:06:12.74,0:06:14.12,Default,,0,0,0,,Шығу жұмбағы...
Dialogue: 0,0:06:14.20,0:06:16.20,Default,,0,0,0,,Достықтар мен түсінбеймін...
Dialogue: 0,0:06:17.33,0:06:19.83,Default,,0,0,0,,Бірақ әйтеуір бұл адам
Dialogue: 0,0:06:19.92,0:06:23.25,Default,,0,0,0,,Бұл аралдың тағдырына көп қатысы бар шығар деп ойладым.
Dialogue: 0,0:06:23.88,0:06:26.92,Default,,0,0,0,,Бұл жақсы немесе жаман бола ма, мәселе...
Dialogue: 0,0:06:27.55,0:06:30.55,Default,,0,0,0,,Мен әрқашан сізбен тікелей сөйлесіп, шешім қабылдағым келді.
Dialogue: 0,0:06:30.64,0:06:33.26,Default,,0,0,0,,Ақыры кездесіп, сөйлескеннен кейін мен...
Dialogue: 0,0:06:34.35,0:06:36.60,Default,,0,0,0,,Тек құбыжықтар туралы ойлау
Dialogue: 0,0:06:36.68,0:06:39.60,Default,,0,0,0,,Аралдың болашағын ойлай алмайды.
Dialogue: 0,0:06:39.69,0:06:42.40,Default,,0,0,0,,Оны саған сеніп тапсыруға болмайды, бірақ мен мұны айта аламын.
Dialogue: 0,0:06:43.07,0:06:45.07,Default,,0,0,0,,Қазір Таллманда
Dialogue: 0,0:06:45.15,0:06:47.90,Default,,0,0,0,,Ол лабиринттің ортасына ең жақын адам.
Dialogue: 0,0:06:48.57,0:06:51.95,Default,,0,0,0,,Мүмкін бұл бірінші және соңғы мүмкіндік шығар
Dialogue: 0,0:06:52.03,0:06:54.74,Default,,0,0,0,,Біз эльфтердің жолымызға түсуіне жол бере алмаймыз.
Dialogue: 0,0:06:55.37,0:06:57.54,Default,,0,0,0,,Онымен не істеу керектігін осыдан кейін шешеміз.
Dialogue: 0,0:06:58.08,0:06:59.62,Default,,0,0,0,,- (Арал иесі) Жетер... -Аа!
Dialogue: 0,0:07:00.17,0:07:01.38,Default,,0,0,0,,Қалағаныңды істе
Dialogue: 0,0:07:01.46,0:07:02.38,Default,,0,0,0,,Арал шебері!
Dialogue: 0,0:07:02.46,0:07:03.96,Default,,0,0,0,,қонуға бұйрық береді
Dialogue: 0,0:07:04.04,0:07:05.75,Default,,0,0,0,,- (Кабру) Күте тұрыңыз! -(2 адам) А?
Dialogue: 0,0:07:05.84,0:07:08.63,Default,,0,0,0,,Енді лабиринт - бұл құрылым және қоршаған орта.
Dialogue: 0,0:07:08.72,0:07:10.76,Default,,0,0,0,,Құбыжықтардың түрлері де әр түрлі.
Dialogue: 0,0:07:10.84,0:07:12.14,Default,,0,0,0,,Өте тұрақсыз
Dialogue: 0,0:07:12.22,0:07:14.26,Default,,0,0,0,,Әрине түсінемін
Dialogue: 0,0:07:14.35,0:07:16.81,Default,,0,0,0,,Лабиринт өскен кездегі сипаттамалар
Dialogue: 0,0:07:16.89,0:07:18.89,Default,,0,0,0,,Оны мүмкіндігінше тез тоқтату керек.
Dialogue: 0,0:07:18.98,0:07:21.06,Default,,0,0,0,,Адамның өсу кезеңі
Dialogue: 0,0:07:21.65,0:07:23.90,Default,,0,0,0,,Бұл тамақтануды ең қажет ететін уақыт.
Dialogue: 0,0:07:23.98,0:07:25.15,Default,,0,0,0,,Сіз не айттыңыз?
Dialogue: 0,0:07:25.73,0:07:27.28,Default,,0,0,0,,Менің туған жерім осыдан 15 жыл бұрын болды
Dialogue: 0,0:07:27.86,0:07:29.95,Default,,0,0,0,,Лабиринтпен қираған
Dialogue: 0,0:07:31.07,0:07:32.78,Default,,0,0,0,,Бұл Утайя деген қала.
Dialogue: 0,0:07:32.86,0:07:34.45,Default,,0,0,0,,15 жыл бұрын?
Dialogue: 0,0:07:34.53,0:07:35.41,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:07:35.49,0:07:38.54,Default,,0,0,0,,Сіз сол уақытта аман қалған баласыз ба?
Dialogue: 0,0:07:38.62,0:07:42.46,Default,,0,0,0,,Естуімше, сол кездегі командирдің орынбасары ма әлде біреулер алып келген.
Dialogue: 0,0:07:42.54,0:07:45.46,Default,,0,0,0,,Иә, бірнеше жыл бойы көмектескеніңіз үшін рахмет.
Dialogue: 0,0:07:45.54,0:07:48.92,Default,,0,0,0,,Ей, мені сүйгендіктен, мен шытырманшы болдым.
Dialogue: 0,0:07:49.01,0:07:52.55,Default,,0,0,0,,Әскерге бару менің арманым еді, бірақ нәсілдік кедергілер болды...
Dialogue: 0,0:07:53.05,0:07:55.18,Default,,0,0,0,,Туған жерімнің қасіретін қайталамау үшін
Dialogue: 0,0:07:55.26,0:07:57.35,Default,,0,0,0,,Маған бір көмек болса екен...
Dialogue: 0,0:07:57.43,0:07:58.85,Default,,0,0,0,,Бұл ерекше жеңіс.
Dialogue: 0,0:07:58.93,0:08:00.18,Default,,0,0,0,,Сіз дұрыс тамақтанып жатырсыз ба?
Dialogue: 0,0:08:00.27,0:08:02.85,Default,,0,0,0,,Көңілді жүзіңізді анда-санда көрсетіңіз
Dialogue: 0,0:08:02.94,0:08:04.19,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:08:05.27,0:08:06.77,Default,,0,0,0,,Тамақтану?
Dialogue: 0,0:08:06.86,0:08:07.94,Default,,0,0,0,,Не болды?
Dialogue: 0,0:08:08.02,0:08:09.19,Default,,0,0,0,,Жалғастыру
Dialogue: 0,0:08:09.90,0:08:12.20,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:08:12.28,0:08:14.95,Default,,0,0,0,,Утайяның лабиринті бірден құлады, бірақ
Dialogue: 0,0:08:15.53,0:08:19.20,Default,,0,0,0,,Сарбаздарға да, тұрғындарға да көп шығын келтірілді.
Dialogue: 0,0:08:19.29,0:08:23.71,Default,,0,0,0,,Өйткені өлгендер құбыжықтарға айналып, адамдарды тірідей жеген.
Dialogue: 0,0:08:23.79,0:08:27.21,Default,,0,0,0,,Көптеген сарбаздар арт жағынан шабуылға ұшырады.
Dialogue: 0,0:08:27.29,0:08:30.59,Default,,0,0,0,,Сандармен шабуыл жасасаңыз да, тек Утайяның ізін қайталайсыз.
Dialogue: 0,0:08:30.67,0:08:33.22,Default,,0,0,0,,Мен лабиринтті жабуды ұсынамын.
Dialogue: 0,0:08:33.80,0:08:36.34,Default,,0,0,0,,Лабиринтті тамақтандыруға болмайды
Dialogue: 0,0:08:36.43,0:08:38.68,Default,,0,0,0,,Лабиринт шайқаста зақымдалуы мүмкін.
Dialogue: 0,0:08:38.76,0:08:41.43,Default,,0,0,0,,Бұл сіздің ниетіңіз болмауы керек.
Dialogue: 0,0:08:41.52,0:08:43.10,Default,,0,0,0,,Кім қалды?
Dialogue: 0,0:08:43.19,0:08:45.27,Default,,0,0,0,,Көпшілігі бір қабатта шоғырланған
Dialogue: 0,0:08:46.15,0:08:47.69,Default,,0,0,0,,Біртіндеп көшейік
Dialogue: 0,0:08:48.40,0:08:50.69,Default,,0,0,0,,Әрбір адам қандай да бір жолмен байланысқан.
Dialogue: 0,0:08:51.36,0:08:53.70,Default,,0,0,0,,Мен көмек сұраудың кейбір жолдарын білемін.
Dialogue: 0,0:08:54.74,0:08:55.82,Default,,0,0,0,,Оны маған қалдыр!
Dialogue: 0,0:08:58.07,0:08:58.62,Default,,0,0,0,,Мүмкін, олардың санын және ауқымын неғұрлым шектесек—
Dialogue: 0,0:08:59.70,0:09:00.87,Default,,0,0,0,,≫ Тап-тап-тап (аяқ дыбысы) (Ол Майт) Һм?
Dialogue: 0,0:09:00.95,0:09:03.75,Default,,0,0,0,,Сіз осындай жағдайда құбыжықты жедіңіз бе?
Dialogue: 0,0:09:07.42,0:09:08.71,Default,,0,0,0,,Эй, дайындал.
Dialogue: 0,0:09:08.79,0:09:09.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:09.71,0:09:10.84,Default,,0,0,0,,Тергеуге дайындық.
Dialogue: 0,0:09:10.92,0:09:11.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:13.22,0:09:15.13,Default,,0,0,0,,Ол бірдеңе құрып жатқан болуы керек.
Dialogue: 0,0:09:15.72,0:09:17.97,Default,,0,0,0,,Осыншама көп айтқыңыз келсе, сынап көрейін.
Dialogue: 0,0:09:18.60,0:09:21.64,Default,,0,0,0,,Бірдеңе болса, дереу әскерді жіберіңіз.
Dialogue: 0,0:09:22.35,0:09:23.39,Default,,0,0,0,,Қызымнан күткенімдей.
Dialogue: 0,0:09:24.23,0:09:25.06,Default,,0,0,0,,Иә
Dialogue: 0,0:09:30.19,0:09:31.61,Default,,0,0,0,,
Dialogue: 0,0:09:33.69,0:09:35.49,Default,,0,0,0,,Бұл пісірілген жұмыртқа ма?
Dialogue: 0,0:09:35.57,0:09:36.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:36.57,0:09:39.45,Default,,0,0,0,,Бұрын мен жанды жұмыртқаға теңеп едім.
Dialogue: 0,0:09:40.03,0:09:42.12,Default,,0,0,0,,Аралас жандардың күйі
Dialogue: 0,0:09:42.20,0:09:45.62,Default,,0,0,0,,Жұмыртқа деген нені білдіреді?
Dialogue: 0,0:09:46.21,0:09:48.75,Default,,0,0,0,,Мысалы, қатты пісірілген жұмыртқада және қуырылған жұмыртқада
Dialogue: 0,0:09:48.83,0:09:51.80,Default,,0,0,0,,Бұл мүлдем басқа әңгіме болар еді, солай емес пе?
Dialogue: 0,0:09:51.88,0:09:54.59,Default,,0,0,0,,Білесің бе, жанды жұмыртқаға салыстыру.
Dialogue: 0,0:09:54.67,0:09:57.13,Default,,0,0,0,,Сөзіңмен ойнау емес пе?
Dialogue: 0,0:09:57.22,0:09:58.64,Default,,0,0,0,,Маған күшіңді бересің бе?
Dialogue: 0,0:09:58.72,0:10:02.51,Default,,0,0,0,,Мен оның жақсы аналогия екеніне таң қалдым, бірақ...
Dialogue: 0,0:10:02.60,0:10:06.60,Default,,0,0,0,,Жұмыртқа сияқты әртүрлі қасиеттерге ие ештеңе жоқ.
Dialogue: 0,0:10:06.69,0:10:09.40,Default,,0,0,0,,Мысалы, бұл қыздыру қатаю қасиеті болып табылады
Dialogue: 0,0:10:09.48,0:10:12.02,Default,,0,0,0,,Ақ пен сарысы әртүрлі температураға ие
Dialogue: 0,0:10:12.11,0:10:16.57,Default,,0,0,0,,Көбіктену, ылғалдандыру, жабысқақтық... Ең қызығы эмульсия
Dialogue: 0,0:10:17.15,0:10:20.82,Default,,0,0,0,,Сонымен қатар табиғи араласпайтын заттар, мысалы, су мен май.
Dialogue: 0,0:10:20.91,0:10:23.58,Default,,0,0,0,,Егер шарттар қойылса, олар жақсы араласады.
Dialogue: 0,0:10:23.66,0:10:24.87,Default,,0,0,0,,Осы сияқты
Dialogue: 0,0:10:26.08,0:10:27.00,Default,,0,0,0,,Ал...
Dialogue: 0,0:10:27.62,0:10:29.37,Default,,0,0,0,,Рас, бұл неге жұмыртқа...?
Dialogue: 0,0:10:29.96,0:10:32.71,Default,,0,0,0,,Лайос, мына нанды ал.
Dialogue: 0,0:10:34.30,0:10:35.96,Default,,0,0,0,,Шынымен осындай азғырумен құпия мәліметтерді ағызып жіберемін деп ойлайсың ба?
Dialogue: 0,0:10:43.35,0:10:44.56,Default,,0,0,0,,Ол аяқталды!
Dialogue: 0,0:10:48.64,0:10:50.77,Default,,0,0,0,,Оны қалай жеу керек?
Dialogue: 0,0:10:50.85,0:10:53.27,Default,,0,0,0,,Шанышқы мен пышақты пайдаланыңыз
Dialogue: 0,0:10:53.36,0:10:56.23,Default,,0,0,0,,Нанмен бірге сарысы мен соусты аршып отырып жеп қойыңыз.
Dialogue: 0,0:10:59.78,0:11:01.91,Default,,0,0,0,,Амммм...
Dialogue: 0,0:11:01.99,0:11:04.03,Default,,0,0,0,,Әрине дәмді!
Dialogue: 0,0:11:04.78,0:11:06.16,Default,,0,0,0,,-Мм! -Хмм
Dialogue: 0,0:11:06.24,0:11:07.54,Default,,0,0,0,,Изцуми…
Dialogue: 0,0:11:07.62,0:11:10.54,Default,,0,0,0,,Сен сол бос жерді көзіңмен қууды доғар!
Dialogue: 0,0:11:10.62,0:11:11.92,Default,,0,0,0,,Сіз бірдеңе көріп тұрсыз ба?
Dialogue: 0,0:11:12.42,0:11:13.29,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:11:13.38,0:11:16.05,Default,,0,0,0,,Мен бар болғанын сезіндім...
Dialogue: 0,0:11:16.13,0:11:17.92,Default,,0,0,0,,Ха! иә?
Dialogue: 0,0:11:18.01,0:11:20.68,Default,,0,0,0,,Бұл галлюцинация болуы мүмкін бе?
Dialogue: 0,0:11:21.80,0:11:22.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:24.01,0:11:26.64,Default,,0,0,0,,Жоқ, мен бұрын сиқырлы мас болған кезде.
Dialogue: 0,0:11:26.72,0:11:29.48,Default,,0,0,0,,Сізде галлюцинация және есту галлюцинациялары бар дедіңіз.
Dialogue: 0,0:11:29.56,0:11:31.31,Default,,0,0,0,,Бұл көптен бері жүріп жатыр
Dialogue: 0,0:11:31.39,0:11:33.61,Default,,0,0,0,,Мәңгі? Неге үндемедің?
Dialogue: 0,0:11:33.69,0:11:36.61,Default,,0,0,0,,Өйткені ол мені бірден басы ауырады деп қорқытады...
Dialogue: 0,0:11:36.69,0:11:38.03,Default,,0,0,0,,Жоқ, сіз ауырып жатырсыз.
Dialogue: 0,0:11:38.11,0:11:38.99,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:11:39.07,0:11:40.70,Default,,0,0,0,,Бұл галлюцинацияның қандай түрі?
Dialogue: 0,0:11:43.41,0:11:46.70,Default,,0,0,0,,Менімен үнемі біреу сөйлеседі...
Dialogue: 0,0:11:46.79,0:11:49.70,Default,,0,0,0,,Басында не айтып тұрғаныңызды түсінбедім.
Dialogue: 0,0:11:49.79,0:11:53.08,Default,,0,0,0,,Бірақ бірте-бірте дауысым мен пішінім анық бола бастады.
Dialogue: 0,0:11:53.17,0:11:56.46,Default,,0,0,0,,Мен қорқып кеттім, сондықтан мен көрмегендей болдым ...
Dialogue: 0,0:11:56.54,0:11:59.34,Default,,0,0,0,,Сіз мені естіген шығарсыз.
Dialogue: 0,0:11:59.42,0:12:00.84,Default,,0,0,0,,Хмм.
Dialogue: 0,0:12:00.92,0:12:02.30,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:12:02.84,0:12:05.60,Default,,0,0,0,,Мен сені менсінбегеніме ашулысың ба...?
Dialogue: 0,0:12:05.68,0:12:07.72,Default,,0,0,0,,Әңгімелесу дұрыс па?
Dialogue: 0,0:12:07.81,0:12:09.27,Default,,0,0,0,,Бұл зұлым рухқа ұқсайды ма?
Dialogue: 0,0:12:09.35,0:12:11.94,Default,,0,0,0,,Хмм... жақсы, менің ойымша, кез келген жағдайда.
Dialogue: 0,0:12:12.02,0:12:12.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:13.44,0:12:14.27,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:12:14.35,0:12:16.23,Default,,0,0,0,,Сізге бірдеңе керек пе?
Dialogue: 0,0:12:16.31,0:12:18.19,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:12:18.27,0:12:19.53,Default,,0,0,0,,Сіз не айтасыз?
Dialogue: 0,0:12:20.19,0:12:22.86,Default,,0,0,0,,Мені жын сияқты көргендеріне ашуланамын.
Dialogue: 0,0:12:22.95,0:12:24.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:24.11,0:12:25.16,Default,,0,0,0,,-Ал... -(3 адам) А?
Dialogue: 0,0:12:25.82,0:12:29.41,Default,,0,0,0,,«Сиқыршының маған көмектескен жақсылығын ұмыттың ба?»
Dialogue: 0,0:12:29.49,0:12:30.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:31.50,0:12:33.37,Default,,0,0,0,,Ах... сол кезде...
Dialogue: 0,0:12:33.46,0:12:36.00,Default,,0,0,0,,Бұл болды...
Dialogue: 0,0:12:36.08,0:12:37.50,Default,,0,0,0,,Рахмет
Dialogue: 0,0:12:37.59,0:12:39.00,Default,,0,0,0,,Көңілді
Dialogue: 0,0:12:39.09,0:12:41.51,Default,,0,0,0,,Сіз мені таныстырғыңыз келетін біреу бар.
Dialogue: 0,0:12:41.59,0:12:42.88,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:12:42.97,0:12:44.72,Default,,0,0,0,,Өлім құдай емес пе?
Dialogue: 0,0:12:44.80,0:12:46.89,Default,,0,0,0,,Жарайды... Басқа амалым жоқ...
Dialogue: 0,0:12:46.97,0:12:47.76,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:12:47.85,0:12:50.06,Default,,0,0,0,,Олай болса мен ол адаммен танысуға рұқсат етіңіз.
Dialogue: 0,0:12:52.60,0:12:53.94,Default,,0,0,0,,Иә? Nua...
Dialogue: 0,0:12:54.02,0:12:55.90,Default,,0,0,0,,(Таңданған үш дауыс)
Dialogue: 0,0:12:55.98,0:12:57.15,Default,,0,0,0,,(Марсиль және басқалардың айқайы)
Dialogue: 0,0:12:57.23,0:12:58.02,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:59.73,0:13:01.15,Default,,0,0,0,,Куу! Апыр-ай!
Dialogue: 0,0:13:01.23,0:13:05.74,Default,,0,0,0,,Уаааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:13:09.03,0:13:13.00,Default,,0,0,0,,(Инелік аспаз)
Dialogue: 0,0:13:13.08,0:13:13.62,Default,,0,0,0,,Хмм
Dialogue: 0,0:13:14.12,0:13:15.87,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:15.96,0:13:16.50,Default,,0,0,0,,Хмм
Dialogue: 0,0:13:18.54,0:13:19.04,Default,,0,0,0,,Әй!
Dialogue: 0,0:13:19.13,0:13:20.38,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:13:20.46,0:13:21.46,Default,,0,0,0,,Ой!
Dialogue: 0,0:13:27.26,0:13:29.10,Default,,0,0,0,,-Ха! -Ое~
Dialogue: 0,0:13:29.18,0:13:30.60,Default,,0,0,0,,Не?
Dialogue: 0,0:13:30.68,0:13:32.60,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:13:32.68,0:13:34.10,Default,,0,0,0,,Маңызы бар деп саналатын бір куәгерлік көрсету бар
Dialogue: 0,0:13:34.18,0:13:36.10,Default,,0,0,0,,Бұл қауіпті~
Dialogue: 0,0:13:36.19,0:13:36.98,Default,,0,0,0,,Ю!
Dialogue: 0,0:13:37.06,0:13:38.69,Default,,0,0,0,,Бірмүйіз!
Dialogue: 0,0:13:40.57,0:13:41.94,Default,,0,0,0,,Сіз...
Dialogue: 0,0:13:42.03,0:13:43.49,Default,,0,0,0,,Сырттан келді ме?
Dialogue: 0,0:13:43.57,0:13:46.36,Default,,0,0,0,,Жоқ... біз лабиринттен келдік...
Dialogue: 0,0:13:46.45,0:13:47.82,Default,,0,0,0,,Бұл өте қиын!
Dialogue: 0,0:13:47.91,0:13:48.95,Default,,0,0,0,,Менімен бірге жүр!
Dialogue: 0,0:13:56.25,0:13:59.13,Default,,0,0,0,,Құбыжықтар соншалықты тыныш...
Dialogue: 0,0:13:59.21,0:14:02.46,Default,,0,0,0,,Сізге бізге зиян тигізбеу бұйырылды.
Dialogue: 0,0:14:02.55,0:14:03.42,Default,,0,0,0,,О!
Dialogue: 0,0:14:03.51,0:14:05.76,Default,,0,0,0,,Бірақ сырттан келген сен басқасың.
Dialogue: 0,0:14:06.34,0:14:08.51,Default,,0,0,0,,Ауылдың заттарын жаныңда ұста.
Dialogue: 0,0:14:08.59,0:14:10.80,Default,,0,0,0,,-Мм -Изуцуми
Dialogue: 0,0:14:10.89,0:14:11.76,Default,,0,0,0,,Не болды?
Dialogue: 0,0:14:11.85,0:14:13.26,Default,,0,0,0,,Бұл трансферттік ауру ма?
Dialogue: 0,0:14:13.35,0:14:15.02,Default,,0,0,0,,Сіз шаршадыңыз ба?
Dialogue: 0,0:14:16.64,0:14:18.48,Default,,0,0,0,,Бұл Алтын қамал ма?
Dialogue: 0,0:14:18.56,0:14:19.40,Default,,0,0,0,,Иә.
Dialogue: 0,0:14:20.06,0:14:22.32,Default,,0,0,0,,Мен мұнда рухпен танысқандықтан келдім.
Dialogue: 0,0:14:22.40,0:14:24.40,Default,,0,0,0,,Олар осында тұрады ма?
Dialogue: 0,0:14:24.48,0:14:25.53,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:14:25.61,0:14:28.86,Default,,0,0,0,,Мәліметтерді кездесуге дайын тұрған адамнан сұраңыз.
Dialogue: 0,0:14:28.95,0:14:31.03,Default,,0,0,0,,Неліктен сіз таңдадыңыз?
Dialogue: 0,0:14:31.12,0:14:32.62,Default,,0,0,0,,Мен де көп білмеймін.
Dialogue: 0,0:14:32.70,0:14:33.87,Default,,0,0,0,,Таңдалған?
Dialogue: 0,0:14:35.37,0:14:36.66,Default,,0,0,0,,Міне, мен келдім.
Dialogue: 0,0:14:36.75,0:14:37.79,Default,,0,0,0,,Бір минут күтіңіз!
Dialogue: 0,0:14:41.00,0:14:43.29,Default,,0,0,0,,Күйеуіңіз құлшылыққа кетті.
Dialogue: 0,0:14:46.01,0:14:47.67,Default,,0,0,0,,- (1-ауыл тұрғыны) Мысалы... - (2-ауыл тұрғыны) Әй!
Dialogue: 0,0:14:47.76,0:14:48.88,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:50.26,0:14:52.43,Default,,0,0,0,,Біраз кідіріс болған сияқты.
Dialogue: 0,0:14:52.51,0:14:56.93,Default,,0,0,0,,Қожайын қайтып келгенше ауылда демалыңыз.
Dialogue: 0,0:14:57.02,0:15:00.69,Default,,0,0,0,,Барлығы сізге қамқорлық жасағысы келетін сияқты.
Dialogue: 0,0:15:00.77,0:15:03.06,Default,,0,0,0,,Мен саған қайда көрсеттім...
Dialogue: 0,0:15:03.61,0:15:05.19,Default,,0,0,0,,Ештеңесі жоқ ауыл...
Dialogue: 0,0:15:05.28,0:15:07.86,Default,,0,0,0,,Бұлардың барлығы Алтын сарайдың тұрғындары ма?
Dialogue: 0,0:15:07.94,0:15:09.61,Default,,0,0,0,,Қарт адамдарға болмайды
Dialogue: 0,0:15:10.15,0:15:12.91,Default,,0,0,0,,Менің құбыжықтар өсіріп жатқанымды көргің келе ме?
Dialogue: 0,0:15:13.91,0:15:14.70,Default,,0,0,0,,I
Dialogue: 0,0:15:14.78,0:15:17.20,Default,,0,0,0,,Жолда көрген алқаптарды аралап көргім келеді.
Dialogue: 0,0:15:17.29,0:15:19.62,Default,,0,0,0,,Иә, жақсы ма?
Dialogue: 0,0:15:19.71,0:15:21.83,Default,,0,0,0,,Әрине, мен сізге жол көрсетемін.
Dialogue: 0,0:15:21.92,0:15:23.38,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:24.42,0:15:26.34,Default,,0,0,0,,Мен осында күтемін.
Dialogue: 0,0:15:26.42,0:15:29.05,Default,,0,0,0,,Мен Изуцумиді жалғыз қалдыра алмаймын.
Dialogue: 0,0:15:29.13,0:15:30.09,Default,,0,0,0,,Жоспар
Dialogue: 0,0:15:30.68,0:15:32.14,Default,,0,0,0,,Ми... Минотавр!
Dialogue: 0,0:15:32.22,0:15:33.85,Default,,0,0,0,,Әйел!
Dialogue: 0,0:15:33.93,0:15:35.22,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:15:35.31,0:15:36.72,Default,,0,0,0,,Сауын сиырларды ауыстырады
Dialogue: 0,0:15:36.81,0:15:38.64,Default,,0,0,0,,Неліктен құбыжықтар мал ретінде?
Dialogue: 0,0:15:38.73,0:15:42.10,Default,,0,0,0,,Қарапайым мал бағу қиын болатын.
Dialogue: 0,0:15:42.19,0:15:43.56,Default,,0,0,0,,«Қажет болса», – дейді Джосуке. «Жарайды».
Dialogue: 0,0:15:45.86,0:15:47.73,Default,,0,0,0,,Хааааааааааааааааааааааааааааааа~
Dialogue: 0,0:15:50.70,0:15:52.11,Default,,0,0,0,,Апыр-ай!? (Лорд Джоэстар) С… Сен…
Dialogue: 0,0:15:52.20,0:15:55.24,Default,,0,0,0,,Бұл әдемі, жақсы күтімді алқап.
Dialogue: 0,0:15:55.33,0:15:58.33,Default,,0,0,0,,Оны тек ауыл тұрғындары тұтына ма?
Dialogue: 0,0:15:58.41,0:16:00.83,Default,,0,0,0,,Әрине, көп қалдықтар бар.
Dialogue: 0,0:16:00.91,0:16:04.25,Default,,0,0,0,,Сонда да өрістер болмаса, істейтін ештеңе болмас еді.
Dialogue: 0,0:16:04.33,0:16:07.55,Default,,0,0,0,,Біз жер бетіндегідей өмір сүріп жатырмыз, тіпті пішінде болса да.
Dialogue: 0,0:16:07.63,0:16:08.71,Default,,0,0,0,,Не...
Dialogue: 0,0:16:10.88,0:16:13.13,Default,,0,0,0,,Изуцуми... жақсысың ба?
Dialogue: 0,0:16:14.72,0:16:15.89,Default,,0,0,0,,Хмм.
Dialogue: 0,0:16:15.97,0:16:18.39,Default,,0,0,0,,Сіз ауырып жатқан сияқтысыз...
Dialogue: 0,0:16:19.72,0:16:21.85,Default,,0,0,0,,Бұл мені еш себепсіз қабылданбай жатқандай сезіндіреді.
Dialogue: 0,0:16:22.85,0:16:23.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:24.19,0:16:25.40,Default,,0,0,0,,…көйлек?
Dialogue: 0,0:16:25.48,0:16:26.48,Default,,0,0,0,,Манга ма? Ах, мен де бәрібір адам сияқты оқимын ғой, болар.
Dialogue: 0,0:16:26.56,0:16:28.23,Default,,0,0,0,,Біз жасаған киімдер!
Dialogue: 0,0:16:28.32,0:16:30.49,Default,,0,0,0,,Әрқашан кезекпен бір-бірімізді киіндіреміз.
Dialogue: 0,0:16:30.57,0:16:32.65,Default,,0,0,0,,Бұл қызықсыз, өйткені бәрі бірдей жүздер...
Dialogue: 0,0:16:33.28,0:16:34.78,Default,,0,0,0,,Егер бұл мен болсам...
Dialogue: 0,0:16:34.86,0:16:35.91,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:16:35.99,0:16:37.28,Default,,0,0,0,,Мен қайсысын таңдауым керек?
Dialogue: 0,0:16:37.37,0:16:39.16,Default,,0,0,0,,Менің ойымша, бұл қызыл түсті!
Dialogue: 0,0:16:39.24,0:16:40.29,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:40.37,0:16:43.37,Default,,0,0,0,,Сіздің көзқарасыңыз бойынша бәрі ескірген болуы мүмкін, бірақ...
Dialogue: 0,0:16:44.00,0:16:45.29,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:16:48.38,0:16:49.25,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:16:49.34,0:16:52.30,Default,,0,0,0,,Бұл мен ойлағаннан басқаша...
Dialogue: 0,0:16:52.88,0:16:56.68,Default,,0,0,0,,1000 жыл сыртқы әлеммен байланыс үзілгеннен кейін тенденциялар басқаша бола ма?
Dialogue: 0,0:16:56.76,0:16:58.05,Default,,0,0,0,,Одан кейін мұны орындаңыз
Dialogue: 0,0:16:58.14,0:17:00.06,Default,,0,0,0,,(ішу дыбысы)
Dialogue: 0,0:17:00.14,0:17:02.56,Default,,0,0,0,,Пуха~! Жақсы!
Dialogue: 0,0:17:02.64,0:17:04.77,Default,,0,0,0,,Мен ішімдікке аздап талғампазмын.
Dialogue: 0,0:17:04.85,0:17:06.44,Default,,0,0,0,,Жоқ, жаман емес.
Dialogue: 0,0:17:06.52,0:17:07.77,Default,,0,0,0,,Мен құрметтімін
Dialogue: 0,0:17:07.86,0:17:09.98,Default,,0,0,0,,Мен оны орктарға ішуге беремін.
Dialogue: 0,0:17:10.07,0:17:12.44,Default,,0,0,0,,Соңғылары әсіресе жақсы қабылданады.
Dialogue: 0,0:17:12.53,0:17:14.20,Default,,0,0,0,,(ішу дыбысы)
Dialogue: 0,0:17:14.28,0:17:15.28,Default,,0,0,0,,Ұнады!
Dialogue: 0,0:17:15.36,0:17:17.70,Default,,0,0,0,,Әй, сіз де шарап жасайсыз ба?
Dialogue: 0,0:17:17.78,0:17:20.70,Default,,0,0,0,,Негізі мен оны жақында бастадым.
Dialogue: 0,0:17:20.79,0:17:24.33,Default,,0,0,0,,Мен 400 жыл бойы жасап келе жатқан алемен салыстырғанда, қиын болды.
Dialogue: 0,0:17:24.41,0:17:25.33,Default,,0,0,0,,400 жыл!
Dialogue: 0,0:17:25.42,0:17:27.67,Default,,0,0,0,,Бұл бұрыннан қалыптасқан саке сыра зауыты.
Dialogue: 0,0:17:27.75,0:17:29.13,Default,,0,0,0,,Сіз қай ұрпақсыз?
Dialogue: 0,0:17:29.21,0:17:32.34,Default,,0,0,0,,Мен оны 600 жасымда бастадым, сондықтан бұл бірінші буын.
Dialogue: 0,0:17:33.34,0:17:34.22,Default,,0,0,0,,О...
Dialogue: 0,0:17:34.30,0:17:35.22,Default,,0,0,0,,Әй?
Dialogue: 0,0:17:35.30,0:17:38.09,Default,,0,0,0,,Маған Минотаврды саууға рұқсат етілді!
Dialogue: 0,0:17:38.18,0:17:41.22,Default,,0,0,0,,О, сен істедің. Оны жүрегіңде сақта.
Dialogue: 0,0:17:41.31,0:17:42.97,Default,,0,0,0,,О, құдай!
Dialogue: 0,0:17:43.06,0:17:46.73,Default,,0,0,0,,Біз мұнда құбыжықтарды өсіруге толықтай қол жеткіздік!
Dialogue: 0,0:17:47.31,0:17:47.81,Default,,0,0,0,,Қараңыз!
Dialogue: 0,0:17:47.90,0:17:50.52,Default,,0,0,0,,Бұл үлкен драйад фермасы!
Dialogue: 0,0:17:50.61,0:17:52.65,Default,,0,0,0,,Сиыр сияқты төрт емшегі бар!
Dialogue: 0,0:17:53.61,0:17:55.15,Default,,0,0,0,,Мен ауырып жатқан сияқтымын...
Dialogue: 0,0:17:55.74,0:17:58.74,Default,,0,0,0,,Жоқ, бірақ бұл таңғажайып тәжірибе болды...
Dialogue: 0,0:17:58.82,0:18:00.41,Default,,0,0,0,,Мұндай сауу...
Dialogue: 0,0:18:00.49,0:18:02.91,Default,,0,0,0,,Бұл туралы айтатын болсақ, Марсил мен Изуцуми ше?
Dialogue: 0,0:18:02.99,0:18:04.70,Default,,0,0,0,,Есіңізде қалай...
Dialogue: 0,0:18:05.37,0:18:07.12,Default,,0,0,0,,О, күткеніңізге рахмет~
Dialogue: 0,0:18:10.71,0:18:11.50,Default,,0,0,0,,(дауыс дыбысы)
Dialogue: 0,0:18:11.59,0:18:14.26,Default,,0,0,0,,Бұл көріністе не бар? Тым толқыдың!
Dialogue: 0,0:18:14.34,0:18:15.76,Default,,0,0,0,,Жоқ, бұл!
Dialogue: 0,0:18:15.84,0:18:17.76,Default,,0,0,0,,Бұл... Мен сұрамасқа амалым жоқ!
Dialogue: 0,0:18:18.34,0:18:21.55,Default,,0,0,0,,Мен бәрібір ең тынышын таңдадым...
Dialogue: 0,0:18:22.47,0:18:24.64,Default,,0,0,0,,Марсиль... Бұл...
Dialogue: 0,0:18:24.72,0:18:27.10,Default,,0,0,0,,Уа! Не...?
Dialogue: 0,0:18:29.10,0:18:31.56,Default,,0,0,0,,Неліктен Изуцумиді қатты сағындың?
Dialogue: 0,0:18:31.65,0:18:33.15,Default,,0,0,0,,А, солай ма?
Dialogue: 0,0:18:33.23,0:18:34.98,Default,,0,0,0,,Неліктен? Бұл ма?
Dialogue: 0,0:18:36.61,0:18:39.32,Default,,0,0,0,,Мен сәбилік күйге түскендеймін...
Dialogue: 0,0:18:39.41,0:18:40.11,Default,,0,0,0,,Уф!
Dialogue: 0,0:18:40.20,0:18:41.28,Default,,0,0,0,,өтіңіз
Dialogue: 0,0:18:41.37,0:18:42.45,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:18:43.24,0:18:46.66,Default,,0,0,0,,Мұнда көптеген қабат-қабат кедергілер бар.
Dialogue: 0,0:18:46.75,0:18:50.17,Default,,0,0,0,,Мүмкін бұл Изцуми туралы бірдеңеге кедергі келтіруі мүмкін...
Dialogue: 0,0:18:50.25,0:18:52.50,Default,,0,0,0,,Жартылай құбыжықтар?
Dialogue: 0,0:18:52.59,0:18:53.42,Default,,0,0,0,,Иә
Dialogue: 0,0:18:53.50,0:18:57.59,Default,,0,0,0,,Бірақ мен құбыжықтарды агрессиясынан айыратын бөгетті ешқашан көрген емеспін...
Dialogue: 0,0:18:58.88,0:19:01.18,Default,,0,0,0,,Мен мұны шеше алсам ғой...
Dialogue: 0,0:19:01.76,0:19:03.51,Default,,0,0,0,,Мен бұрын көрмеген көптеген кейіпкерлер бар.
Dialogue: 0,0:19:03.60,0:19:04.93,Default,,0,0,0,,Мұны бір түнде жасау мүмкін емес!
Dialogue: 0,0:19:05.01,0:19:08.81,Default,,0,0,0,,Қазір бәрі цензурадан өткен...
Dialogue: 0,0:19:09.48,0:19:12.19,Default,,0,0,0,,Бірақ бұл шынымен де ғажайып жер.
Dialogue: 0,0:19:12.77,0:19:14.57,Default,,0,0,0,,Егер бұл жағдай болмаса
Dialogue: 0,0:19:14.65,0:19:16.94,Default,,0,0,0,,Мен мәңгі қалғым келді...
Dialogue: 0,0:19:18.57,0:19:19.40,Default,,0,0,0,,Биыл ғана дебют жасаған –
Dialogue: 0,0:19:23.78,0:19:25.33,Default,,0,0,0,,О!
Dialogue: 0,0:19:25.41,0:19:27.33,Default,,0,0,0,,Күткендеріңізге рахмет.
Dialogue: 0,0:19:27.41,0:19:30.71,Default,,0,0,0,,Кішкентай болса да, кешкі асқа дастархан жайдық.
Dialogue: 0,0:19:30.79,0:19:31.92,Default,,0,0,0,,Мен сен демалыс үйін сатып аламыз дедің деп анық естідім.
Dialogue: 0,0:19:34.25,0:19:35.46,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:19:36.75,0:19:39.72,Default,,0,0,0,,Қош келдіңіздер, мен сіздермен танысқым келді.
Dialogue: 0,0:19:39.80,0:19:41.76,Default,,0,0,0,,Менің атым Яад
Dialogue: 0,0:19:41.84,0:19:43.59,Default,,0,0,0,,Өздеріңіз білетіндей
Dialogue: 0,0:19:43.68,0:19:45.56,Default,,0,0,0,,Делгардың немересі
Dialogue: 0,0:19:45.64,0:19:47.06,Default,,0,0,0,,Делгар…
Dialogue: 0,0:19:47.14,0:19:48.85,Default,,0,0,0,,Енді трубканы қойыңыз.
Dialogue: 0,0:19:49.43,0:19:53.48,Default,,0,0,0,,Мен сені неге шақырдым? Ұзақ әңгіме айтып берейін.
Dialogue: 0,0:19:54.40,0:19:55.36,Default,,0,0,0,,Тамақты ұсыну
Dialogue: 0,0:20:01.70,0:20:03.87,Default,,0,0,0,,Мм... мына ет...
Dialogue: 0,0:20:03.95,0:20:04.70,Default,,0,0,0,,Иә
Dialogue: 0,0:20:04.78,0:20:07.03,Default,,0,0,0,,Барлығы мұны сұрағандай,
Dialogue: 0,0:20:07.12,0:20:08.74,Default,,0,0,0,,Минотавр еті!
Dialogue: 0,0:20:08.83,0:20:10.87,Default,,0,0,0,,Уау... Кукку...
Dialogue: 0,0:20:10.96,0:20:14.04,Default,,0,0,0,,Сіз күнделікті құбыжықтарды жейсіз бе?
Dialogue: 0,0:20:14.54,0:20:18.00,Default,,0,0,0,,Кейбір адамдар жейді, бірақ олар жемейді.
Dialogue: 0,0:20:18.09,0:20:19.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:19.34,0:20:21.76,Default,,0,0,0,,Менің дәм сезуім түтіккен.
Dialogue: 0,0:20:22.34,0:20:25.18,Default,,0,0,0,,Біріншіден, тәбетім жоқ.
Dialogue: 0,0:20:26.05,0:20:27.89,Default,,0,0,0,,Бұл ашуланған сиқыршы.
Dialogue: 0,0:20:27.97,0:20:30.73,Default,,0,0,0,,Бұл бізге берілген өлместік сиқыры.
Dialogue: 0,0:20:31.23,0:20:33.48,Default,,0,0,0,,Хмм.
Dialogue: 0,0:20:33.56,0:20:36.02,Default,,0,0,0,,Неліктен сиқыршы мұндай әрекетке барады?
Dialogue: 0,0:20:36.11,0:20:37.48,Default,,0,0,0,,Келіңіздер...
Dialogue: 0,0:20:37.57,0:20:39.69,Default,,0,0,0,,Есіме түскенше
Dialogue: 0,0:20:39.78,0:20:43.24,Default,,0,0,0,,Мен дұрыс сөйлей алмай қалдым...
Dialogue: 0,0:20:44.86,0:20:47.45,Default,,0,0,0,,Бірақ біз үшін алаңдамаңыз.
Dialogue: 0,0:20:47.53,0:20:49.62,Default,,0,0,0,,Көңіліңіз жеткенше ләззат алыңыз.
Dialogue: 0,0:20:49.70,0:20:54.54,Default,,0,0,0,,Тәбетім болмаса да, басқалардың тамақ ішкенін көріп қуанамын.
Dialogue: 0,0:20:55.12,0:20:56.17,Default,,0,0,0,,Тамақтанғысы келмеу деген нені білдіреді?
Dialogue: 0,0:20:56.25,0:20:59.05,Default,,0,0,0,,Мен ештеңе айта алмайтындай болдым.
Dialogue: 0,0:21:01.46,0:21:02.42,Default,,0,0,0,,Менің атам...
Dialogue: 0,0:21:03.05,0:21:04.72,Default,,0,0,0,,Ашуланған сиқыршы
Dialogue: 0,0:21:04.80,0:21:08.26,Default,,0,0,0,,Қара магияға бет бұрғаным менің кінәм болды.
Dialogue: 0,0:21:08.35,0:21:10.26,Default,,0,0,0,,Ол көптен бері ауырған сияқты.
Dialogue: 0,0:21:10.77,0:21:14.52,Default,,0,0,0,,Ал мен көмек сұрау үшін жер бетіне шықтым.
Dialogue: 0,0:21:16.02,0:21:18.56,Default,,0,0,0,,Жердегі атаң ше?
Dialogue: 0,0:21:19.11,0:21:20.73,Default,,0,0,0,,Менің естуім бойынша
Dialogue: 0,0:21:20.82,0:21:23.69,Default,,0,0,0,,Бір күні ауылдың катакомбаларынан кенет пайда болды.
Dialogue: 0,0:21:23.78,0:21:25.66,Default,,0,0,0,,Өзін жер аударылған елдің патшасымын деп айту
Dialogue: 0,0:21:25.74,0:21:29.78,Default,,0,0,0,,Абыржыған сиқыршыны жеңген адамға оның бүкіл елінен айырылатынын айт.
Dialogue: 0,0:21:29.87,0:21:31.70,Default,,0,0,0,,Шаңға айналсам ше...
Dialogue: 0,0:21:31.79,0:21:33.45,Default,,0,0,0,,Шит… шит…
Dialogue: 0,0:21:34.04,0:21:38.46,Default,,0,0,0,,Атамның дерттен құтылғаны үлкен жұбаныш.
Dialogue: 0,0:21:38.54,0:21:42.59,Default,,0,0,0,,Қарғыстан құтылу үшін көп адамдар ауылды тастап кетті.
Dialogue: 0,0:21:43.21,0:21:45.13,Default,,0,0,0,,Бірақ ешкім табысқа жете алмады
Dialogue: 0,0:21:45.22,0:21:47.55,Default,,0,0,0,,Мен жаңа ғана денемнен айырылдым...
Dialogue: 0,0:21:48.18,0:21:51.56,Default,,0,0,0,,Денеңізді жоғалтқанда, сіз бірте-бірте өзіңізді сезінесіз.
Dialogue: 0,0:21:51.64,0:21:53.22,Default,,0,0,0,,Зұлым рухқа айналады
Dialogue: 0,0:21:53.31,0:21:55.48,Default,,0,0,0,,Бұл жерге қайтып келуге болмайды
Dialogue: 0,0:21:56.06,0:21:58.02,Default,,0,0,0,,Сіз онымен бірнеше рет кездескен болуыңыз керек.
Dialogue: 0,0:21:58.52,0:21:59.36,Default,,0,0,0,,Мен жасадым!
Dialogue: 0,0:21:59.94,0:22:03.86,Default,,0,0,0,,Оның үстіне қасиетті суды құйып шербет жасады.
Dialogue: 0,0:22:03.94,0:22:06.11,Default,,0,0,0,,Бір, екі, үш.
Dialogue: 0,0:22:06.20,0:22:08.49,Default,,0,0,0,,Бізді мұнда не үшін шақырды?
Dialogue: 0,0:22:08.57,0:22:09.78,Default,,0,0,0,,Бұл пайғамбарлық.
Dialogue: 0,0:22:09.87,0:22:10.83,Default,,0,0,0,,Пайғамбарлық?
Dialogue: 0,0:22:10.91,0:22:11.74,Default,,0,0,0,,Иә
Dialogue: 0,0:22:12.54,0:22:15.00,Default,,0,0,0,,«Ол қанатты қылыш ұстайды»
Dialogue: 0,0:22:15.08,0:22:19.88,Default,,0,0,0,,«Ол жынды сиқыршыны жеңіп, бізді босатады».
Dialogue: 0,0:22:19.96,0:22:21.09,Default,,0,0,0,,Қанаттар...?
Dialogue: 0,0:22:21.17,0:22:22.50,Default,,0,0,0,,Кенсуке ше?
Dialogue: 0,0:22:22.59,0:22:25.01,Default,,0,0,0,,Оның қанаттары бар, бірақ...
Dialogue: 0,0:22:25.09,0:22:28.13,Default,,0,0,0,,Иә? Оның бетінде арыстан бар!
Dialogue: 0,0:22:28.22,0:22:29.30,Default,,0,0,0,,Мен мұны білмей тұрып...
Dialogue: 0,0:22:29.39,0:22:30.26,Default,,0,0,0,,Ой
Dialogue: 0,0:22:30.34,0:22:32.93,Default,,0,0,0,,Қанатты арыстан – бұл елдің қамқоршысы.
Dialogue: 0,0:22:33.43,0:22:37.10,Default,,0,0,0,,Мені лабиринт түбінде жынды сиқыршы басып қалды.
Dialogue: 0,0:22:37.69,0:22:42.77,Default,,0,0,0,,Ол арман арқылы болашақты болжап, бүгінгі күнге дейін бізге бағыт-бағдар береді.
Dialogue: 0,0:22:42.86,0:22:46.78,Default,,0,0,0,,Атамның жерге сапарына да пайғамбарлық себеп болған.
Dialogue: 0,0:22:48.65,0:22:49.53,Default,,0,0,0,,Лорд Райос
Dialogue: 0,0:22:50.24,0:22:51.91,Default,,0,0,0,,Пайғамбарлық келесідей жалғасады:
Dialogue: 0,0:22:52.53,0:22:56.91,Default,,0,0,0,,«Қанатты семсер құтырған сиқыршыны өлтіреді».
Dialogue: 0,0:22:57.50,0:23:00.67,Default,,0,0,0,,«Ол осы елдің жаңа патшасы болады».
Dialogue: 0,0:23:00.75,0:23:01.42,Default,,0,0,0,,Пуф!
Dialogue: 0,0:23:01.50,0:23:03.21,Default,,0,0,0,,Бұл дұрыс емес адам!
Dialogue: 0,0:23:03.29,0:23:05.59,Default,,0,0,0,,Бұл қылыш менің кездейсоқ қолыма алған нәрсе еді!
Dialogue: 0,0:23:05.67,0:23:07.01,Default,,0,0,0,,Кездейсоқ емес
Dialogue: 0,0:23:07.59,0:23:09.38,Default,,0,0,0,,Оның қазір бар екендігі
Dialogue: 0,0:23:09.47,0:23:11.59,Default,,0,0,0,,Бұл шешім қабылданған болуы керек.
Dialogue: 0,0:23:11.68,0:23:12.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:14.18,0:23:15.18,Default,,0,0,0,,Лорд Райос
Dialogue: 0,0:23:15.77,0:23:17.93,Default,,0,0,0,,Маған уәде бере аласыз ба?
Dialogue: 0,0:23:18.52,0:23:20.81,Default,,0,0,0,,Ақылсыз сиқыршыны жеңу
Dialogue: 0,0:23:20.90,0:23:23.02,Default,,0,0,0,,Егер сіз бізді босатсаңыз
Dialogue: 0,0:23:24.23,0:23:25.32,Default,,0,0,0,,Бұл...
Dialogue: 0,0:23:25.40,0:23:27.07,Default,,0,0,0,,Ум...
Dialogue: 0,0:23:27.74,0:23:28.49,Default,,0,0,0,,Хмм...
Dialogue: 0,0:23:31.53,0:23:34.33,Default,,0,0,0,,Бір сәт ойланып көрейін...
Dialogue: 0,0:23:35.16,0:23:36.70,Default,,0,0,0,,Жоқ, жоқ деп айтыңыз.
Dialogue: 0,0:23:36.79,0:23:39.21,Default,,0,0,0,,Неліктен кез келген мүмкіндікті ашық қалдырасыз?
Dialogue: 0,0:23:39.29,0:23:41.46,Default,,0,0,0,,Бірақ бәрібір сіз мұны істей алмайсыз.
Dialogue: 0,0:23:41.54,0:23:42.92,Default,,0,0,0,,Кенсуке...
Dialogue: 0,0:23:43.00,0:23:45.59,Default,,0,0,0,,Қашан осындай болдың?
Dialogue: 0,0:23:46.21,0:23:49.13,Default,,0,0,0,,Мені зындан тазалаушы жеп қойғанда күдікті болды...
Dialogue: 0,0:23:51.13,0:23:53.43,Default,,0,0,0,,Тамақ әзірлеуге қобалжығандықтан ба?
Dialogue: 0,0:23:53.51,0:23:56.26,Default,,0,0,0,,Не жесем де, дәмін тата алмадым...
Dialogue: 0,0:23:56.35,0:23:56.85,Default,,0,0,0,,Аһ!
Dialogue: 0,0:23:56.93,0:23:58.43,Default,,0,0,0,,Бұл жігіт қу!
Dialogue: 0,0:23:58.52,0:24:00.56,Default,,0,0,0,,«Әркімнің қалауы» дегеніміз не?
Dialogue: 0,0:24:00.64,0:24:01.31,Default,,0,0,0,,Мені жеңіл санама!
Dialogue: 0,0:24:02.10,0:24:04.73,Default,,0,0,0,,Негізінде дәм жоқтың қасы.
Dialogue: 0,0:24:05.48,0:24:08.98,Default,,0,0,0,,Олар тамақ керек емес деді.
Dialogue: 0,0:24:09.07,0:24:12.53,Default,,0,0,0,,Тамақтың жақсы піспегені содан болса керек.
Dialogue: 0,0:24:13.49,0:24:15.24,Default,,0,0,0,,Мен бұл туралы ойладым
Dialogue: 0,0:24:15.83,0:24:19.91,Default,,0,0,0,,Оларға өрістер немесе ыдыс-аяқ қажет болмауы керек.
Dialogue: 0,0:24:20.00,0:24:22.25,Default,,0,0,0,,Неліктен олардың бәрі сонда?
Dialogue: 0,0:24:22.33,0:24:24.04,Default,,0,0,0,,Мың жыл бойы
Dialogue: 0,0:24:24.13,0:24:28.25,Default,,0,0,0,,Неліктен біз оларға қамқорлық жасауды және күтіп ұстауды жалғастырдық?
Dialogue: 0,0:24:28.88,0:24:31.88,Default,,0,0,0,,Қажет болғандықтан шығар.
Dialogue: 0,0:24:32.47,0:24:34.39,Default,,0,0,0,,Егер олар есі дұрыс болса
Dialogue: 0,0:24:34.47,0:24:36.55,Default,,0,0,0,,Тірі қалу
Dialogue: 0,0:24:37.97,0:24:38.81,Default,,0,0,0,,Лайос
Dialogue: 0,0:24:39.35,0:24:40.64,Default,,0,0,0,,Мен бұрыннан болатынмын
Dialogue: 0,0:24:40.72,0:24:44.73,Default,,0,0,0,,Орк басшысына айтқан сөзіңіз есімде.
Dialogue: 0,0:24:44.81,0:24:45.65,Default,,0,0,0,,Е...
Dialogue: 0,0:24:47.02,0:24:48.65,Default,,0,0,0,,Сіз не айттыңыз...?
Dialogue: 0,0:24:48.73,0:24:52.07,Default,,0,0,0,,Ал, түнде ойланыңыз.
Dialogue: 0,0:24:54.66,0:24:56.45,Default,,0,0,0,,Мен де осында ұйықтай аламын ба?
Dialogue: 0,0:24:56.53,0:24:58.49,Default,,0,0,0,,Сізге дайындалған бөлмеде ұйықтаңыз.
Dialogue: 0,0:24:58.58,0:25:00.16,Default,,0,0,0,,Мен жалғыз қалғым келмейді.
Dialogue: 0,0:25:00.24,0:25:02.29,Default,,0,0,0,,Изицуми де біртүрлі.
Dialogue: 0,0:25:02.37,0:25:03.58,Default,,0,0,0,,Орап ал, сал!
Dialogue: 0,0:25:03.66,0:25:05.17,Default,,0,0,0,,Еденде ұйықтау
Dialogue: 0,0:25:05.25,0:25:07.13,Default,,0,0,0,,Оның қолдары суық болды.
Dialogue: 0,0:25:15.97,0:25:17.97,Default,,0,0,0,,♪~
Dialogue: 0,0:26:43.01,0:26:45.02,Default,,0,0,0,,~♪
