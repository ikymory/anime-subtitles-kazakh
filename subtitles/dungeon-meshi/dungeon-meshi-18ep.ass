Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.00,0:00:03.00,Default,,0,0,0,,♪~
Dialogue: 0,0:01:26.50,0:01:28.50,Default,,0,0,0,,~♪
Dialogue: 0,0:01:34.01,0:01:35.63,Default,,0,0,0,,Жоғарғы қабатқа шығатын баспалдақтар
Dialogue: 0,0:01:35.72,0:01:37.43,Default,,0,0,0,,Нені табу қиын болды
Dialogue: 0,0:01:38.01,0:01:40.26,Default,,0,0,0,,Мен әрі қарай қозғаламын деп шештім, бұл болды.
Dialogue: 0,0:01:40.35,0:01:41.76,Default,,0,0,0,,Бұл жиіркенішті...
Dialogue: 0,0:01:42.26,0:01:44.22,Default,,0,0,0,,Әлі құрғақ емес
Dialogue: 0,0:01:44.31,0:01:47.81,Default,,0,0,0,,Фарин біраз бұрын осы жерден өтіп, төменгі қабатқа қарай бет алған сияқты.
Dialogue: 0,0:01:49.15,0:01:50.61,Default,,0,0,0,,Ол кішкентай болса керек.
Dialogue: 0,0:01:51.52,0:01:53.28,Default,,0,0,0,,6 қабат
Dialogue: 0,0:01:53.36,0:01:57.45,Default,,0,0,0,,Жер асты су жолы ежелгі ергежейлілер жасаған туннель арқылы жасалған.
Dialogue: 0,0:01:57.53,0:01:59.87,Default,,0,0,0,,Шексіз кең және ұзын
Dialogue: 0,0:01:59.95,0:02:03.20,Default,,0,0,0,,Қаланың табанының астындағы қантамырдай созылады.
Dialogue: 0,0:02:03.87,0:02:07.54,Default,,0,0,0,,Бұрын бұл жерде әртүрлі заттар ағып жатқан шығар.
Dialogue: 0,0:02:07.62,0:02:09.37,Default,,0,0,0,,Әрине су
Dialogue: 0,0:02:09.46,0:02:11.00,Default,,0,0,0,,Адамдар мен жануарлар
Dialogue: 0,0:02:11.08,0:02:13.63,Default,,0,0,0,,Қыршын, өтірік, қауесет
Dialogue: 0,0:02:13.71,0:02:15.38,Default,,0,0,0,,Алтын, күміс және қан…
Dialogue: 0,0:02:16.05,0:02:17.47,Default,,0,0,0,,Суық
Dialogue: 0,0:02:17.55,0:02:20.72,Default,,0,0,0,,6-қабат ылғалдырақ болуы керек...
Dialogue: 0,0:02:21.72,0:02:23.47,Default,,0,0,0,,Сіз басқа жерде көрінбедіңіз бе?
Dialogue: 0,0:02:23.56,0:02:26.23,Default,,0,0,0,,Жоқ, бұл жол таныс сияқты.
Dialogue: 0,0:02:26.31,0:02:29.90,Default,,0,0,0,,Бізге осы қабаттағы жалын айдаһары міндетті түрде шабуыл жасады.
Dialogue: 0,0:02:29.98,0:02:31.23,Default,,0,0,0,,Жойылуға жақын
Dialogue: 0,0:02:31.81,0:02:35.03,Default,,0,0,0,,Ал, бұл қабырғалары мен жолдары қозғалатын лабиринт.
Dialogue: 0,0:02:35.11,0:02:36.82,Default,,0,0,0,,Температураның өзгеруі таңқаларлық емес.
Dialogue: 0,0:02:37.32,0:02:40.11,Default,,0,0,0,,Ыстықтан суық болған жақсы.
Dialogue: 0,0:02:40.20,0:02:43.74,Default,,0,0,0,,Қан дақтарын қар мен су кетіріп кеткені алаңдатады.
Dialogue: 0,0:02:43.83,0:02:47.62,Default,,0,0,0,,Әйтеуір, өткен жолы қырылып қала жаздаған жерге барайық.
Dialogue: 0,0:02:47.70,0:02:49.21,Default,,0,0,0,,Тазартқыштар жеуі керек
Dialogue: 0,0:02:49.29,0:02:51.75,Default,,0,0,0,,Артында қалдырған жүгіңізді қайтарып алуыңыз мүмкін.
Dialogue: 0,0:02:51.83,0:02:54.00,Default,,0,0,0,,Фарин жақсы ма?
Dialogue: 0,0:02:54.09,0:02:56.88,Default,,0,0,0,,Бұл суық Қызыл Айдаһар үшін қатал болуы керек.
Dialogue: 0,0:02:56.96,0:02:59.01,Default,,0,0,0,,А, қауырсындар ма?
Dialogue: 0,0:02:59.09,0:03:00.34,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:03:00.43,0:03:04.18,Default,,0,0,0,,Сіз жаңа ғана Шроның «қызғанған сиқыршыны жеңетінін» айттыңыз.
Dialogue: 0,0:03:04.26,0:03:06.52,Default,,0,0,0,,Менің ойымша, олардың ойларында қандай да бір жоспар бар.
Dialogue: 0,0:03:07.18,0:03:08.39,Default,,0,0,0,,Міне...
Dialogue: 0,0:03:09.10,0:03:11.73,Default,,0,0,0,,Фарин Делгал деген адамды іздеді.
Dialogue: 0,0:03:11.81,0:03:13.19,Default,,0,0,0,,Бұл Қызыл Айдаһар
Dialogue: 0,0:03:13.27,0:03:15.82,Default,,0,0,0,,Маған ашулы сиқыршы бұйырды.
Dialogue: 0,0:03:16.69,0:03:18.40,Default,,0,0,0,,Қызыл айдаһар ешқашан ұйықтамайды
Dialogue: 0,0:03:18.49,0:03:21.74,Default,,0,0,0,,Сондықтан мен әдеттегіден басқа деңгейлерді аралап жүрдім...
Dialogue: 0,0:03:22.66,0:03:23.82,Default,,0,0,0,,Делгал?
Dialogue: 0,0:03:23.91,0:03:27.04,Default,,0,0,0,,Бұл кім? Таныс естіледі.
Dialogue: 0,0:03:27.12,0:03:27.99,Default,,0,0,0,,Бұл патша
Dialogue: 0,0:03:29.54,0:03:32.46,Default,,0,0,0,,1000 жыл бұрын жойылған алтын қала
Dialogue: 0,0:03:32.54,0:03:33.92,Default,,0,0,0,,Соңғы патша Делгар
Dialogue: 0,0:03:35.04,0:03:38.71,Default,,0,0,0,,Осы лабиринтте оны мадақтайтын сөздер ойып жазылған.
Dialogue: 0,0:03:38.80,0:03:39.92,Default,,0,0,0,,Міне.
Dialogue: 0,0:03:40.01,0:03:41.97,Default,,0,0,0,,Қазылған заттарға да есімдер жазылған.
Dialogue: 0,0:03:42.05,0:03:44.72,Default,,0,0,0,,Күте тұрыңыз, бірақ бұл Делгар...
Dialogue: 0,0:03:44.80,0:03:45.97,Default,,0,0,0,,Иә
Dialogue: 0,0:03:46.05,0:03:48.35,Default,,0,0,0,,Бұл лабиринт қашан ашылды
Dialogue: 0,0:03:48.43,0:03:51.98,Default,,0,0,0,,Жерде пайда болады, шаңға айналады, содан кейін жоғалады ...
Dialogue: 0,0:03:52.06,0:03:54.10,Default,,0,0,0,,Басқаша айтқанда, құтырған сиқыршы
Dialogue: 0,0:03:54.19,0:03:57.94,Default,,0,0,0,,Қызыл Айдаһарды пайдаланып, көптен бері жоғалған патшаны іздеу
Dialogue: 0,0:03:58.03,0:04:00.19,Default,,0,0,0,,Сіз лабиринтті жаңартып жатырсыз ба?
Dialogue: 0,0:04:00.28,0:04:03.99,Default,,0,0,0,,Бұрынғы патша құтырған сиқыршының көз алдында өлтірілгеннен бері.
Dialogue: 0,0:04:04.07,0:04:06.70,Default,,0,0,0,,Менің ұлым Делғал да осындай жағдайды басынан кешіреді деп қорқамын.
Dialogue: 0,0:04:07.20,0:04:08.24,Default,,0,0,0,,Сонымен, біз
Dialogue: 0,0:04:08.33,0:04:10.33,Default,,0,0,0,,Ол кісі өлтіруші деп күдіктеніп, оған шабуыл жасады.
Dialogue: 0,0:04:10.41,0:04:11.54,Default,,0,0,0,,
Dialogue: 0,0:04:11.62,0:04:13.96,Default,,0,0,0,,Не? Мұны кімнен естідің?
Dialogue: 0,0:04:14.04,0:04:15.00,Default,,0,0,0,,адасу?
Dialogue: 0,0:04:15.08,0:04:17.25,Default,,0,0,0,,Жоқ, мен бұрын болғанмын
Dialogue: 0,0:04:17.34,0:04:21.01,Default,,0,0,0,,Мен жынды сиқыршыны тірі суретте кездестірдім.
Dialogue: 0,0:04:21.09,0:04:22.09,Default,,0,0,0,,Мен сонда үйрендім
Dialogue: 0,0:04:22.59,0:04:26.89,Default,,0,0,0,,Қараңдаршы, суреттегі тамақты жеймін деп ұрысқанымды айттым.
Dialogue: 0,0:04:27.60,0:04:29.35,Default,,0,0,0,,Иә? Тез айт!
Dialogue: 0,0:04:29.43,0:04:31.73,Default,,0,0,0,,Мен оны сол кезде түсінбедім...
Dialogue: 0,0:04:32.85,0:04:35.85,Default,,0,0,0,,Түсіндім... Оқиғаны қайталау
Dialogue: 0,0:04:36.36,0:04:40.19,Default,,0,0,0,,Тек растау үшін, ашуланған сиқыршы пері болды.
Dialogue: 0,0:04:40.28,0:04:42.61,Default,,0,0,0,,Эльфтер мың жыл өмір сүре ме?
Dialogue: 0,0:04:42.69,0:04:45.57,Default,,0,0,0,,Мұндай жазбалар ертеде болған сияқты.
Dialogue: 0,0:04:45.66,0:04:48.45,Default,,0,0,0,,Қазіргі уақытта шектеу ең көбі 500 жыл болуы мүмкін.
Dialogue: 0,0:04:48.53,0:04:50.04,Default,,0,0,0,,Ең көбі
Dialogue: 0,0:04:50.12,0:04:52.75,Default,,0,0,0,,Басқа адамдардың өмірі сенің қолыңда.
Dialogue: 0,0:04:52.83,0:04:56.04,Default,,0,0,0,,Адамның өмірін ұзарту - қарапайым мәселе.
Dialogue: 0,0:04:56.12,0:04:57.29,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:04:57.38,0:05:00.05,Default,,0,0,0,,Өз сиқырыңызбен ұзақ өмір сүру деген нені білдіреді?
Dialogue: 0,0:05:00.13,0:05:03.13,Default,,0,0,0,,Сұрақ, сіз өз етіңізді жей отырып, ұзақ өмір сүре аласыз ба?
Dialogue: 0,0:05:03.22,0:05:07.05,Default,,0,0,0,,Қалай болғанда да, олар бізді патшаның жауы деп ойлап, бізге шабуыл жасады.
Dialogue: 0,0:05:07.14,0:05:09.10,Default,,0,0,0,,Түсінбеушіліктерді диалог арқылы шешуге болады
Dialogue: 0,0:05:09.18,0:05:10.22,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:05:11.39,0:05:12.43,Default,,0,0,0,,Хмм.
Dialogue: 0,0:05:12.52,0:05:15.19,Default,,0,0,0,,(Боранның дыбысы)
Dialogue: 0,0:05:15.27,0:05:17.48,Default,,0,0,0,,Жел күшейеді
Dialogue: 0,0:05:17.56,0:05:18.86,Default,,0,0,0,,Суық көрінеді~
Dialogue: 0,0:05:18.94,0:05:20.61,Default,,0,0,0,,Сіздің алдыңызда көрінбейді
Dialogue: 0,0:05:20.69,0:05:23.07,Default,,0,0,0,,Сіз мені естисіз бе? Сіз дұрыс бақылап жүрсіз бе?
Dialogue: 0,0:05:23.15,0:05:24.57,Default,,0,0,0,,Қайда? Лайос
Dialogue: 0,0:05:24.65,0:05:26.20,Default,,0,0,0,,Мен ештеңе көрмеймін!
Dialogue: 0,0:05:26.28,0:05:28.57,Default,,0,0,0,,Осындай жерде ажырассақ, сұмдық болар еді!
Dialogue: 0,0:05:28.66,0:05:30.24,Default,,0,0,0,,Барлығы қол ұстасып тұрады
Dialogue: 0,0:05:30.33,0:05:32.20,Default,,0,0,0,,Куу... у...
Dialogue: 0,0:05:32.29,0:05:33.62,Default,,0,0,0,,Хмм
Dialogue: 0,0:05:34.96,0:05:36.50,Default,,0,0,0,,Иносукэ, кешір мені. Егер оны ертерек байқап қалсам...
Dialogue: 0,0:05:40.54,0:05:42.13,Default,,0,0,0,,Осылай қалса жаман.
Dialogue: 0,0:05:44.17,0:05:45.22,Default,,0,0,0,,Бұл бүйірлік тесік.
Dialogue: 0,0:05:45.30,0:05:46.38,Default,,0,0,0,,Әзірше көшейік!
Dialogue: 0,0:05:50.80,0:05:52.22,Default,,0,0,0,,Хаа…
Dialogue: 0,0:05:52.31,0:05:55.23,Default,,0,0,0,,Хаа… хаа…
Dialogue: 0,0:05:55.93,0:05:58.19,Default,,0,0,0,,Барлығы сонда ма? Салқындатыңыз ба?
Dialogue: 0,0:05:58.27,0:06:00.02,Default,,0,0,0,,Мұнда ешқандай проблема жоқ.
Dialogue: 0,0:06:00.73,0:06:01.61,Default,,0,0,0,,Марсиль?
Dialogue: 0,0:06:01.69,0:06:03.69,Default,,0,0,0,,Иә, мен осында болар едім.
Dialogue: 0,0:06:04.19,0:06:05.07,Default,,0,0,0,,Сенши?
Dialogue: 0,0:06:05.15,0:06:06.78,Default,,0,0,0,,О, сен амансың.
Dialogue: 0,0:06:06.86,0:06:08.36,Default,,0,0,0,,Күрсін... Жақсы.
Dialogue: 0,0:06:08.45,0:06:09.66,Default,,0,0,0,,-Хмм? - Марсиль
Dialogue: 0,0:06:09.74,0:06:10.57,Default,,0,0,0,,Мен дәл қазір...
Dialogue: 0,0:06:10.66,0:06:12.28,Default,,0,0,0,,Жарықты қоса аласыз ба?
Dialogue: 0,0:06:16.37,0:06:18.25,Default,,0,0,0,,Хмм... аа...
Dialogue: 0,0:06:19.04,0:06:22.13,Default,,0,0,0,,Бұл жер... Саңыраулар түрмесінің қирандылары сияқты.
Dialogue: 0,0:06:23.25,0:06:24.84,Default,,0,0,0,,Бірақ не болады...
Dialogue: 0,0:06:27.34,0:06:28.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:28.34,0:06:29.51,Default,,0,0,0,,Өтірік?
Dialogue: 0,0:06:29.59,0:06:30.76,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:06:31.51,0:06:32.51,Default,,0,0,0,,Бұл...
Dialogue: 0,0:06:33.60,0:06:35.06,Default,,0,0,0,,Бұл өсуде!
Dialogue: 0,0:06:35.60,0:06:37.81,Default,,0,0,0,,Тәтті, нені айтып тұрсың?
Dialogue: 0,0:06:37.89,0:06:39.27,Default,,0,0,0,,Иллюзия сиқыры?
Dialogue: 0,0:06:39.94,0:06:42.27,Default,,0,0,0,,Жоқ, мм.
Dialogue: 0,0:06:43.36,0:06:46.28,Default,,0,0,0,,Мүмкін бұл пішін ауыстырғыш шығар?
Dialogue: 0,0:06:46.36,0:06:47.57,Default,,0,0,0,,Пішін?
Dialogue: 0,0:06:47.65,0:06:48.74,Default,,0,0,0,,Білмейсіз бе?
Dialogue: 0,0:06:48.82,0:06:51.24,Default,,0,0,0,,Менің туған жерімде кейде пайда болатын құбыжық.
Dialogue: 0,0:06:52.49,0:06:55.08,Default,,0,0,0,,Қалың тұман немесе қатты боран соғатын күндер
Dialogue: 0,0:06:55.16,0:06:58.46,Default,,0,0,0,,Егіс пен тауды аралап жүргенде, серіктері мен отбасы мүшелерінің саны сен білмей тұрып көбейеді.
Dialogue: 0,0:06:59.08,0:07:02.96,Default,,0,0,0,,Бұл олардың сыртқы түріне еліктейтін және араласатын пішін ауыстырғыш.
Dialogue: 0,0:07:03.04,0:07:05.42,Default,,0,0,0,,Сіздің туған қалаңыз алаңдатады.
Dialogue: 0,0:07:05.50,0:07:07.01,Default,,0,0,0,,Сен ертегідейсің бе?
Dialogue: 0,0:07:07.09,0:07:08.80,Default,,0,0,0,,Сіз бірдеңе дұрыс емес істеп жатырсыз ба?
Dialogue: 0,0:07:08.88,0:07:12.18,Default,,0,0,0,,Байқамасаң, шынды жеп, өзгертетін сияқты.
Dialogue: 0,0:07:12.26,0:07:13.14,Default,,0,0,0,,- (Марсиль Б) Эй! - (Чилчак А) Гааааааааааааааааа!
Dialogue: 0,0:07:13.22,0:07:15.22,Default,,0,0,0,,Жалғанды ​​тез табыңыз!
Dialogue: 0,0:07:15.31,0:07:15.93,Default,,0,0,0,,Хмм
Dialogue: 0,0:07:16.01,0:07:17.27,Default,,0,0,0,,Ой, жоқ…
Dialogue: 0,0:07:17.35,0:07:18.81,Default,,0,0,0,,Тамақтану керек
Dialogue: 0,0:07:18.89,0:07:20.44,Default,,0,0,0,,Не? Жұмыс істемей жатыр…
Dialogue: 0,0:07:20.52,0:07:23.19,Default,,0,0,0,,Эй, Лайос ана жақта.
Dialogue: 0,0:07:23.27,0:07:25.44,Default,,0,0,0,,Бұл жалған болғаны дұрыс емес пе?
Dialogue: 0,0:07:25.52,0:07:26.94,Default,,0,0,0,,Бұл да рас.
Dialogue: 0,0:07:27.03,0:07:29.95,Default,,0,0,0,,Сіз құбыжықтар туралы көп білмейсіз.
Dialogue: 0,0:07:30.03,0:07:32.91,Default,,0,0,0,,Пішін өзгертушілер тірі заттардың ойларын оқиды.
Dialogue: 0,0:07:32.99,0:07:35.70,Default,,0,0,0,,Жақын адамның сыртқы түріне еліктеу
Dialogue: 0,0:07:35.78,0:07:38.91,Default,,0,0,0,,Ондағы үшеуміз Марсиль мен Чилчакпыз.
Dialogue: 0,0:07:39.00,0:07:40.91,Default,,0,0,0,,Сеншінің есінде қалған мен шығармын.
Dialogue: 0,0:07:41.42,0:07:42.96,Default,,0,0,0,,Әрине
Dialogue: 0,0:07:43.04,0:07:44.33,Default,,0,0,0,,Мұқият қарасаңыз
Dialogue: 0,0:07:44.42,0:07:46.04,Default,,0,0,0,,Әркім әртүрлі көрінеді
Dialogue: 0,0:07:46.13,0:07:47.38,Default,,0,0,0,,Басқаша көрінеді
Dialogue: 0,0:07:48.42,0:07:50.84,Default,,0,0,0,,Олай болса, бұл балаға бірден бірдеңе істей аласың ба?
Dialogue: 0,0:07:50.92,0:07:53.18,Default,,0,0,0,,- (Марсиль D) Иә? - (Марсиль С) Бұл жалған екені анық.
Dialogue: 0,0:07:53.72,0:07:54.47,Default,,0,0,0,,Әрине
Dialogue: 0,0:07:54.55,0:07:57.10,Default,,0,0,0,,Бұл дұрыс болуы мүмкін емес. Мұқият қараңыз!
Dialogue: 0,0:07:57.18,0:07:58.06,Default,,0,0,0,,Мен сиқырды қолданамын.
Dialogue: 0,0:07:58.14,0:07:59.43,Default,,0,0,0,,тітіркендіргіш
Dialogue: 0,0:07:59.52,0:08:00.98,Default,,0,0,0,,Олар кімнің естеліктері?
Dialogue: 0,0:08:01.06,0:08:03.65,Default,,0,0,0,,Мына жігіт пен мынау жалған екені анық.
Dialogue: 0,0:08:04.35,0:08:06.27,Default,,0,0,0,,-Қайда? - (Чилчак Б) Иә?
Dialogue: 0,0:08:06.36,0:08:07.40,Default,,0,0,0,,Мұқият қараңыз!
Dialogue: 0,0:08:07.48,0:08:09.99,Default,,0,0,0,,Менің мойын орамалым глушитель емес.
Dialogue: 0,0:08:10.07,0:08:12.11,Default,,0,0,0,,Сеншінің дулығасында тесігі жоқ.
Dialogue: 0,0:08:12.20,0:08:13.03,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:13.95,0:08:15.20,Default,,0,0,0,,Менен сұрасаңыз...
Dialogue: 0,0:08:16.20,0:08:19.33,Default,,0,0,0,,Бұл Райостың естелігінде біз екені анық.
Dialogue: 0,0:08:19.41,0:08:20.70,Default,,0,0,0,,Тым анық емес есте сақтау
Dialogue: 0,0:08:21.20,0:08:23.87,Default,,0,0,0,,Уф... Уф...
Dialogue: 0,0:08:23.96,0:08:25.92,Default,,0,0,0,,Мен оны сол күйінде қалдыра аламын ба?
Dialogue: 0,0:08:26.00,0:08:28.88,Default,,0,0,0,,Оларда адамға ұқсас интеллект жоқ.
Dialogue: 0,0:08:29.46,0:08:32.76,Default,,0,0,0,,Алайда, егер сіз оларды ренжітсеңіз, олар қарсы тұруы мүмкін.
Dialogue: 0,0:08:32.84,0:08:36.64,Default,,0,0,0,,Мен бұл жағдайда белгісіз құбыжықтармен соғысудан аулақ болғым келеді.
Dialogue: 0,0:08:36.72,0:08:39.89,Default,,0,0,0,,Жасандылықты сабырлы түрде ашыңыз және олармен бірге күресіңіз!
Dialogue: 0,0:08:42.48,0:08:44.44,Default,,0,0,0,,Импульс жақсы.
Dialogue: 0,0:08:44.52,0:08:47.86,Default,,0,0,0,,Ол жалған мен шынайы нәрсені ажырата алады ма?
Dialogue: 0,0:08:47.94,0:08:49.40,Default,,0,0,0,,Мен бұған күмәнданамын...
Dialogue: 0,0:08:49.48,0:08:51.32,Default,,0,0,0,,Қалған фейктер саны…
Dialogue: 0,0:08:51.99,0:08:52.90,Default,,0,0,0,,6 адам
Dialogue: 0,0:08:53.49,0:08:56.45,Default,,0,0,0,,Егер сіз оларды қатарластырып қарасаңыз, біршама айырмашылықтар бар.
Dialogue: 0,0:08:56.53,0:09:00.33,Default,,0,0,0,,Мен мұны істеп жатқанда, менің есімде бұлыңғыр қалған бөліктер түзетіліп жатыр.
Dialogue: 0,0:09:00.41,0:09:02.50,Default,,0,0,0,,Бұны тез шешпесек жаман болады.
Dialogue: 0,0:09:03.50,0:09:06.21,Default,,0,0,0,,Марсильдің шаш үлгісі басқаша.
Dialogue: 0,0:09:06.29,0:09:09.46,Default,,0,0,0,,Сізді соңғы рет көргенімде шаш үлгісі қандай болғаны есімде жоқ.
Dialogue: 0,0:09:09.54,0:09:10.46,Default,,0,0,0,,Өтірік!
Dialogue: 0,0:09:10.55,0:09:12.96,Default,,0,0,0,,Бұл шаш үлгісі сирек кездеседі, сондықтан есіңізде ме, солай ма?
Dialogue: 0,0:09:13.05,0:09:14.05,Default,,0,0,0,,(Роко) Куфуфуфу. Мақтаның жараланды ма?
Dialogue: 0,0:09:14.13,0:09:16.47,Default,,0,0,0,,Қарлы боранда суық болды, мен оны түсірдім.
Dialogue: 0,0:09:16.55,0:09:19.18,Default,,0,0,0,,Біріншіден, олардың шаш түрлері мүлдем басқаша.
Dialogue: 0,0:09:19.26,0:09:21.10,Default,,0,0,0,,Шаш - сиқыршының өмірі
Dialogue: 0,0:09:21.64,0:09:24.23,Default,,0,0,0,,Барлығы осылай дейді.
Dialogue: 0,0:09:24.31,0:09:27.40,Default,,0,0,0,,Бұл біздің басымыздағы Марсиль.
Dialogue: 0,0:09:28.36,0:09:29.36,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:30.15,0:09:31.82,Default,,0,0,0,,Ах! Мен түсінемін.
Dialogue: 0,0:09:31.90,0:09:35.32,Default,,0,0,0,,Сонда мен тек өзім білетін ақпаратқа сүйене отырып шешім қабылдай аламын.
Dialogue: 0,0:09:35.40,0:09:37.95,Default,,0,0,0,,Менен анаңның қыз атын табуды сұрама.
Dialogue: 0,0:09:38.03,0:09:38.74,Default,,0,0,0,,Жоқ
Dialogue: 0,0:09:41.12,0:09:42.49,Default,,0,0,0,,Бұл сиқырлы кітап.
Dialogue: 0,0:09:43.54,0:09:45.04,Default,,0,0,0,,- (Марсиль С) Уф! -(Марсиль А) Қараңдаршы.
Dialogue: 0,0:09:45.12,0:09:46.04,Default,,0,0,0,,О...
Dialogue: 0,0:09:46.12,0:09:48.42,Default,,0,0,0,,Бір кітаптың жалған екені анық.
Dialogue: 0,0:09:49.04,0:09:51.88,Default,,0,0,0,,Бірақ қалған екі кітаптың екеуі де солай көрінеді.
Dialogue: 0,0:09:51.96,0:09:55.05,Default,,0,0,0,,Иә? Жоқ, әннің синтаксисі бұзылған!
Dialogue: 0,0:09:55.13,0:09:56.47,Default,,0,0,0,,Бұл жол!
Dialogue: 0,0:09:56.55,0:09:57.84,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:58.43,0:10:00.89,Default,,0,0,0,,Сіз заттарыңызға біраз ақша жұмсайтын сияқтысыз.
Dialogue: 0,0:10:00.97,0:10:02.64,Default,,0,0,0,,Сенші заттарыңды жайып жібер.
Dialogue: 0,0:10:02.72,0:10:03.22,Default,,0,0,0,,Иә
Dialogue: 0,0:10:07.81,0:10:09.44,Default,,0,0,0,,Үшеуміз дүкен аралап жүрміз!
Dialogue: 0,0:10:10.31,0:10:13.23,Default,,0,0,0,,Уф... Уф... Уф
Dialogue: 0,0:10:14.15,0:10:16.61,Default,,0,0,0,,Мен оны екі адамға дейін қысқарта алдым, бірақ...
Dialogue: 0,0:10:17.32,0:10:18.99,Default,,0,0,0,,Мен кептеліп қалдым.
Dialogue: 0,0:10:19.66,0:10:21.24,Default,,0,0,0,,Қалған фейктер саны
Dialogue: 0,0:10:21.87,0:10:23.49,Default,,0,0,0,,3 адам
Dialogue: 0,0:10:25.58,0:10:27.50,Default,,0,0,0,,Жарайды, тамақ ішейік.
Dialogue: 0,0:10:27.58,0:10:29.37,Default,,0,0,0,,Бұл жағдайда?
Dialogue: 0,0:10:29.96,0:10:32.29,Default,,0,0,0,,Көрнекі кемсітушілік енді мүмкін емес.
Dialogue: 0,0:10:32.38,0:10:35.13,Default,,0,0,0,,Бағалаудың жалғыз жолы - сіздің әдеттегі мінез-құлқыңызға қарау.
Dialogue: 0,0:10:35.21,0:10:38.63,Default,,0,0,0,,Барлығы пісірсін, мен олардың пісіруін бақылаймын.
Dialogue: 0,0:10:39.13,0:10:41.39,Default,,0,0,0,,Жалған мен шынайыны ажырату
Dialogue: 0,0:10:43.47,0:10:46.39,Default,,0,0,0,,Мен де ашулы сиқыршыны кездестірдім.
Dialogue: 0,0:10:46.47,0:10:48.14,Default,,0,0,0,,Шлоудың сезіміне келсек...
Dialogue: 0,0:10:48.23,0:10:49.85,Default,,0,0,0,,Мен Қабуру деген жігітпен сөйлесетінмін.
Dialogue: 0,0:10:49.94,0:10:51.69,Default,,0,0,0,,Қай жерде кездескенімізді де байқамаймын.
Dialogue: 0,0:10:51.77,0:10:55.15,Default,,0,0,0,,Лайостың бақылаушы көзіне сүйене отырып...?
Dialogue: 0,0:10:57.78,0:10:59.40,Default,,0,0,0,,Мазасыздық!
Dialogue: 0,0:11:00.86,0:11:03.91,Default,,0,0,0,,Жалған досты құбыжықтан айыру
Dialogue: 0,0:11:03.99,0:11:06.33,Default,,0,0,0,,Бұл жоғалған сенімді қалпына келтіру мүмкіндігі.
Dialogue: 0,0:11:06.41,0:11:08.46,Default,,0,0,0,,Мен енді бәрінің көңілін қалдырғым келмейді.
Dialogue: 0,0:11:09.12,0:11:12.08,Default,,0,0,0,,Қалай болғанда да, кішігірім айырмашылықтарды байқауыңыз керек!
Dialogue: 0,0:11:12.67,0:11:14.29,Default,,0,0,0,,Бұл ол туралы.
Dialogue: 0,0:11:14.38,0:11:18.63,Default,,0,0,0,,Біз құбыжықтар болып табылатын жалғандарды тартымдырақ табу мүмкіндігі бар.
Dialogue: 0,0:11:19.13,0:11:20.22,Default,,0,0,0,,Эмма…
Dialogue: 0,0:11:20.30,0:11:23.18,Default,,0,0,0,,Біз өзіміз бірдеңе істеуіміз керек...
Dialogue: 0,0:11:23.68,0:11:25.18,Default,,0,0,0,,Мен осында қарап отырмын
Dialogue: 0,0:11:25.76,0:11:27.06,Default,,0,0,0,,Әркім қолынан келгенін жасайды деп сенемін
Dialogue: 0,0:11:27.14,0:11:28.43,Default,,0,0,0,,Тітіркендіргіш
Dialogue: 0,0:11:28.52,0:11:29.60,Default,,0,0,0,,Не істеу керек?
Dialogue: 0,0:11:29.68,0:11:32.40,Default,,0,0,0,,Мен 5-қабаттан тапқан затты
Dialogue: 0,0:11:32.48,0:11:35.48,Default,,0,0,0,,Майзуру-донодан алынған тағам
Dialogue: 0,0:11:36.19,0:11:40.36,Default,,0,0,0,,Мен дұрыс ингредиенттерді алдым, міне...
Dialogue: 0,0:11:40.45,0:11:41.95,Default,,0,0,0,,Тағы бір нәрсе
Dialogue: 0,0:11:42.03,0:11:45.45,Default,,0,0,0,,Мен бір адамның жұппен тамақ жасағанын қалаймын.
Dialogue: 0,0:11:45.95,0:11:47.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:47.20,0:11:51.25,Default,,0,0,0,,Бірлескен жұмыс арқылы мінез-құлықтағы айырмашылықтарды байқағым келеді.
Dialogue: 0,0:11:51.83,0:11:53.54,Default,,0,0,0,,Рецептті Сеншиден үйренуге болады.
Dialogue: 0,0:11:54.08,0:11:55.63,Default,,0,0,0,,әрқайсысында
Dialogue: 0,0:11:55.71,0:11:57.38,Default,,0,0,0,,Сіз дайынсыз ба?
Dialogue: 0,0:11:57.46,0:11:59.09,Default,,0,0,0,,Пісіруді бастаңыз!
Dialogue: 0,0:12:01.05,0:12:02.59,Default,,0,0,0,,Ең алдымен Чилчак командасы.
Dialogue: 0,0:12:03.76,0:12:06.97,Default,,0,0,0,,Етті тураңыз Жұмыртқа мен дәмдеуіштерді араластырыңыз
Dialogue: 0,0:12:07.47,0:12:09.52,Default,,0,0,0,,Чилчак А дәліздің ортасында.
Dialogue: 0,0:12:09.60,0:12:13.44,Default,,0,0,0,,Чилчак Б ағаш жәшікке отырып, жұмысқа кіріседі.
Dialogue: 0,0:12:13.52,0:12:14.85,Default,,0,0,0,,Қандай ескерту!
Dialogue: 0,0:12:14.94,0:12:16.15,Default,,0,0,0,,Мұны істеу қиын!
Dialogue: 0,0:12:16.73,0:12:17.57,Default,,0,0,0,,Хмм
Dialogue: 0,0:12:18.23,0:12:20.74,Default,,0,0,0,,Ммм.
Dialogue: 0,0:12:20.82,0:12:22.86,Default,,0,0,0,,Оны аша алмайсыз ба? Риосты ашыңыз.
Dialogue: 0,0:12:22.95,0:12:23.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:23.74,0:12:27.24,Default,,0,0,0,,Шүберек шықты! B жалған екенін көрдіңіз бе?
Dialogue: 0,0:12:27.33,0:12:29.16,Default,,0,0,0,,Не? мәселе неде
Dialogue: 0,0:12:29.24,0:12:31.16,Default,,0,0,0,,Жоқ, түсіндің.
Dialogue: 0,0:12:31.25,0:12:33.83,Default,,0,0,0,,Менің де сенімім, мақтанышым бар.
Dialogue: 0,0:12:33.92,0:12:36.79,Default,,0,0,0,,Адамдар бір-біріне көмектеседі, Чилчак.
Dialogue: 0,0:12:36.88,0:12:39.05,Default,,0,0,0,,Бұл тым бұзық емес пе?
Dialogue: 0,0:12:39.13,0:12:42.13,Default,,0,0,0,,Мұқият қарасаң, А-ның көзі нашар.
Dialogue: 0,0:12:42.22,0:12:43.30,Default,,0,0,0,,Эй
Dialogue: 0,0:12:43.38,0:12:45.55,Default,,0,0,0,,Менің Чилчак одан да сүйкімді.
Dialogue: 0,0:12:45.64,0:12:46.64,Default,,0,0,0,,Тоқта
Dialogue: 0,0:12:46.72,0:12:49.81,Default,,0,0,0,,Ла Риос... Түсінесіз.
Dialogue: 0,0:12:50.60,0:12:52.06,Default,,0,0,0,,Чилчак А…
Dialogue: 0,0:12:52.14,0:12:55.56,Default,,0,0,0,,Оның жүзінде, әрине, күдікті көрініс бар.
Dialogue: 0,0:12:55.65,0:12:57.06,Default,,0,0,0,,Бұл жалған болуы мүмкін
Dialogue: 0,0:12:57.15,0:12:59.82,Default,,0,0,0,,Пісіруді жалғастыруды қарастырыңыз.
Dialogue: 0,0:13:01.23,0:13:02.36,Default,,0,0,0,,Бұлыңғыр!
Dialogue: 0,0:13:02.86,0:13:05.07,Default,,0,0,0,,Мені жалпы тілде балағаттау...
Dialogue: 0,0:13:05.86,0:13:07.41,Default,,0,0,0,,Келесіде Марсиль командасы.
Dialogue: 0,0:13:07.91,0:13:10.79,Default,,0,0,0,,Кеш болды, бірақ бұл қандай жұмыртқа?
Dialogue: 0,0:13:10.87,0:13:12.25,Default,,0,0,0,,Гарпи
Dialogue: 0,0:13:13.62,0:13:15.62,Default,,0,0,0,,Мен басында көп айттым.
Dialogue: 0,0:13:15.71,0:13:17.46,Default,,0,0,0,,Гуманоидты құбыжықтар мүлдем жоқ
Dialogue: 0,0:13:17.54,0:13:20.84,Default,,0,0,0,,Жақында сіз аздап болғаныңыз үшін, бұл нашарлаған жоқ па?
Dialogue: 0,0:13:21.42,0:13:23.42,Default,,0,0,0,,Марсиль Б әдеттегідей
Dialogue: 0,0:13:23.51,0:13:26.09,Default,,0,0,0,,Шамадан тыс ...
Dialogue: 0,0:13:26.72,0:13:28.30,Default,,0,0,0,,Кесілген дәретхананы қайнатыңыз
Dialogue: 0,0:13:29.51,0:13:30.89,Default,,0,0,0,,Марсиль А не ойлайды?
Dialogue: 0,0:13:31.43,0:13:32.97,Default,,0,0,0,,Мен бақытты емеспін
Dialogue: 0,0:13:33.56,0:13:36.31,Default,,0,0,0,,Мен тіпті балықшылардың жұмыртқалары мен драйадтарды жедім.
Dialogue: 0,0:13:36.39,0:13:37.98,Default,,0,0,0,,Енді мұндай шу шығарудың қажеті жоқ.
Dialogue: 0,0:13:38.56,0:13:41.32,Default,,0,0,0,,Мен Фаринді құтқару үшін бәрін жасаймын.
Dialogue: 0,0:13:41.82,0:13:42.69,Default,,0,0,0,,О...
Dialogue: 0,0:13:42.78,0:13:43.78,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:13:44.36,0:13:47.07,Default,,0,0,0,,Мен Фарин үшін бәрін жасаймын!
Dialogue: 0,0:13:47.16,0:13:49.41,Default,,0,0,0,,Менің ойымша, В-ның анықтауы жеңіл.
Dialogue: 0,0:13:49.49,0:13:52.24,Default,,0,0,0,,Арфа жеу жағдайды жақсарта ма?
Dialogue: 0,0:13:53.04,0:13:55.83,Default,,0,0,0,,Таяқшалармен тесу үшін жеткілікті жұмсақ болған кезде, оны ыстық судан алыңыз.
Dialogue: 0,0:13:56.46,0:13:58.33,Default,,0,0,0,,Дәмдеуіштермен араластырып, езіңіз
Dialogue: 0,0:13:59.33,0:14:01.67,Default,,0,0,0,,Иә? Бұл қиын
Dialogue: 0,0:14:01.75,0:14:03.80,Default,,0,0,0,,Екі мәлімдеме де дұрыс сияқты.\NSensiTeam ішіндегі
Dialogue: 0,0:14:04.30,0:14:05.76,Default,,0,0,0,,...
Dialogue: 0,0:14:06.34,0:14:08.64,Default,,0,0,0,,Мына жұмыртқаларды қайдан алдың?
Dialogue: 0,0:14:09.22,0:14:11.89,Default,,0,0,0,,Құлаған үйдің ішінде ұя бар.
Dialogue: 0,0:14:12.39,0:14:14.10,Default,,0,0,0,,Мен онда не бар екенін жинадым.
Dialogue: 0,0:14:15.14,0:14:16.81,Default,,0,0,0,,Салманы 1см кесектерге кесіңіз
Dialogue: 0,0:14:17.60,0:14:20.56,Default,,0,0,0,,Міне, жұмыртқа тамаша...
Dialogue: 0,0:14:20.65,0:14:21.73,Default,,0,0,0,,Тағамдық тағам
Dialogue: 0,0:14:21.81,0:14:23.40,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:14:23.98,0:14:26.49,Default,,0,0,0,,Ингредиенттер мен күрішті баяу отта қуырып, дәмдеңіз.
Dialogue: 0,0:14:27.49,0:14:29.70,Default,,0,0,0,,Күріш Шлоудың сүйікті тағамы болды.
Dialogue: 0,0:14:30.24,0:14:31.62,Default,,0,0,0,,Авантюристер үшін
Dialogue: 0,0:14:31.70,0:14:34.54,Default,,0,0,0,,Маңызды қоректік заттармен қапталған
Dialogue: 0,0:14:34.62,0:14:37.41,Default,,0,0,0,,Оны алу ұят болды.
Dialogue: 0,0:14:37.50,0:14:40.63,Default,,0,0,0,,Құбыжықтарды жегісі келетін маған ұқсамайды.
Dialogue: 0,0:14:40.71,0:14:42.92,Default,,0,0,0,,Сенші бір қадам тереңірек қарайды.
Dialogue: 0,0:14:43.63,0:14:46.01,Default,,0,0,0,,Дәм немесе тамақтану сияқты нәрселерді ойлай алмаймын.
Dialogue: 0,0:14:46.63,0:14:48.72,Default,,0,0,0,,Барлық тағамдар дәмді көрінеді.
Dialogue: 0,0:14:48.80,0:14:50.89,Default,,0,0,0,,Тек шеберлікке қарап айта алмайсың.
Dialogue: 0,0:14:52.64,0:14:53.30,Default,,0,0,0,,Бұл
Dialogue: 0,0:14:53.39,0:14:56.56,Default,,0,0,0,,Ешкім бұл туралы айтпағандықтан, мен оны тексеремін.
Dialogue: 0,0:14:57.14,0:15:00.65,Default,,0,0,0,,В-ның Сенши Бұл жерде кішкене керемет нәрсе бар емес пе?
Dialogue: 0,0:15:01.15,0:15:03.06,Default,,0,0,0,,Ах~
Dialogue: 0,0:15:05.65,0:15:07.32,Default,,0,0,0,,Мынадай.
Dialogue: 0,0:15:07.40,0:15:08.99,Default,,0,0,0,,Сенші әрқашан салқын
Dialogue: 0,0:15:09.07,0:15:10.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:10.15,0:15:12.91,Default,,0,0,0,,Гномдарға қарсы көзқарас қандай?
Dialogue: 0,0:15:12.99,0:15:15.33,Default,,0,0,0,,Сенши бұл ақымақ емес.
Dialogue: 0,0:15:15.91,0:15:17.95,Default,,0,0,0,,Сенши керемет...
Dialogue: 0,0:15:22.21,0:15:25.75,Default,,0,0,0,,Пісіру аяқталуға жақын, бірақ қорытындыға келдіңіз бе?
Dialogue: 0,0:15:26.80,0:15:27.96,Default,,0,0,0,,Шынымды айтсам...
Dialogue: 0,0:15:28.05,0:15:29.67,Default,,0,0,0,,Менде түсінік жоқ
Dialogue: 0,0:15:29.76,0:15:32.55,Default,,0,0,0,,Мұның бәрі шынайы, ал бәрі жалған болып көрінеді.
Dialogue: 0,0:15:33.05,0:15:36.39,Default,,0,0,0,,Жалпы айтқанда, біз өз басымыздан туған иллюзияларды ажыратуымыз керек.
Dialogue: 0,0:15:36.47,0:15:38.47,Default,,0,0,0,,Бұл өте әділетсіз ойын емес пе?
Dialogue: 0,0:15:38.56,0:15:42.44,Default,,0,0,0,,Адамға айналған құбыжықты табу қызық болар еді.
Dialogue: 0,0:15:42.52,0:15:44.36,Default,,0,0,0,,Бұл фантомдық қарсылас...
Dialogue: 0,0:15:46.52,0:15:48.44,Default,,0,0,0,,Құбыжықтарды іздеу...
Dialogue: 0,0:15:49.07,0:15:50.45,Default,,0,0,0,,Орындалды
Dialogue: 0,0:15:54.49,0:15:56.53,Default,,0,0,0,,Енді, барлығыңыз тамақ ішіп отырып тыңдаңыздар.
Dialogue: 0,0:15:57.49,0:15:59.33,Default,,0,0,0,,Мен шын деп ойлаған нәрсе
Dialogue: 0,0:16:00.58,0:16:01.75,Default,,0,0,0,,Чилчак А
Dialogue: 0,0:16:02.50,0:16:04.13,Default,,0,0,0,,Көру қабілеті нашар, ұят
Dialogue: 0,0:16:04.92,0:16:06.38,Default,,0,0,0,,Марсиль Б
Dialogue: 0,0:16:06.46,0:16:09.26,Default,,0,0,0,,Мен тіпті Фарин үшін де арпа жұмыртқасын жегім келмейді.
Dialogue: 0,0:16:09.96,0:16:11.01,Default,,0,0,0,,Сенси А
Dialogue: 0,0:16:11.09,0:16:12.26,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:16:12.93,0:16:16.35,Default,,0,0,0,,Ендеше, барлық жалғандар, дереу торға кіріңдер.
Dialogue: 0,0:16:16.43,0:16:18.01,Default,,0,0,0,,Бір минут күтіңіз~
Dialogue: 0,0:16:18.10,0:16:20.31,Default,,0,0,0,,Бұны шын деп қалай бағалайсыз?
Dialogue: 0,0:16:20.98,0:16:23.19,Default,,0,0,0,,Қалай қарасаң да, ол жалған!
Dialogue: 0,0:16:23.27,0:16:25.02,Default,,0,0,0,,Неліктен олай ойлайсың?
Dialogue: 0,0:16:25.10,0:16:27.36,Default,,0,0,0,,Хмм, қалай болғанда да
Dialogue: 0,0:16:27.94,0:16:29.82,Default,,0,0,0,,Ал, мен мұны кейін түсіндіремін.
Dialogue: 0,0:16:30.36,0:16:31.74,Default,,0,0,0,,Алдымен фейкпен айналысайық.
Dialogue: 0,0:16:32.24,0:16:33.15,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:16:33.95,0:16:35.28,Default,,0,0,0,,Әйтеуір
Dialogue: 0,0:16:35.87,0:16:37.16,Default,,0,0,0,,Өңдеу…
Dialogue: 0,0:16:37.24,0:16:39.04,Default,,0,0,0,,Бұл жігіт күткендей жақсы емес.
Dialogue: 0,0:16:39.74,0:16:40.83,Default,,0,0,0,,Менің денем
Dialogue: 0,0:16:40.91,0:16:43.54,Default,,0,0,0,,Оны өзім қорғаудан басқа амалым жоқ сияқты.
Dialogue: 0,0:16:43.62,0:16:44.79,Default,,0,0,0,,- Уф! -Эй
Dialogue: 0,0:16:44.87,0:16:45.63,Default,,0,0,0,,(балтаның соғу дыбысы)
Dialogue: 0,0:16:47.00,0:16:49.88,Default,,0,0,0,,Кімді таңдасаң да солай болады
Dialogue: 0,0:16:50.46,0:16:53.80,Default,,0,0,0,,Shapeshifter — сыртқы көріністерге еліктейтін құбыжықтарға арналған жалпы термин.
Dialogue: 0,0:16:53.88,0:16:56.55,Default,,0,0,0,,Дауыстарға еліктейтіндер, оларға иелер
Dialogue: 0,0:16:56.64,0:16:59.10,Default,,0,0,0,,Сыртқы түрін іс жүзінде өзгерткендер
Dialogue: 0,0:16:59.18,0:17:01.39,Default,,0,0,0,,Мыналардың қайсысы бұл жігіттің шынайы тұлғасы?
Dialogue: 0,0:17:02.10,0:17:04.64,Default,,0,0,0,,Құбыжық қандай болса да тамақ пісіре алмайды.
Dialogue: 0,0:17:05.27,0:17:07.90,Default,,0,0,0,,Марсиль айтқандай, ол иллюзияларды манипуляциялауы мүмкін.
Dialogue: 0,0:17:08.61,0:17:11.90,Default,,0,0,0,,Адамдарды немесе жануарларды нысанаға алғандықтан етқоректі немесе барлық қоректі
Dialogue: 0,0:17:12.61,0:17:15.74,Default,,0,0,0,,Жемдікке бетпе-бет шабуыл жасауға күші жетпейді, қорқақ
Dialogue: 0,0:17:16.82,0:17:19.16,Default,,0,0,0,,Бұл жерде суық және қараңғы, көріну нашар.
Dialogue: 0,0:17:19.66,0:17:23.00,Default,,0,0,0,,Суыққа төзімді, иіс пен естуге сүйенетін аң.
Dialogue: 0,0:17:26.25,0:17:28.04,Default,,0,0,0,,Төменгі жел сол жақта
Dialogue: 0,0:17:28.63,0:17:31.13,Default,,0,0,0,,Жау біздің қажығанымызды күтіп тұр.
Dialogue: 0,0:17:31.63,0:17:34.84,Default,,0,0,0,,Қылышымды абайсызда сермеп кетсем де, маған тимейді деп ойлаймын...
Dialogue: 0,0:17:35.68,0:17:36.88,Default,,0,0,0,,Не болды?
Dialogue: 0,0:17:37.39,0:17:39.85,Default,,0,0,0,,Кенсуке де тыныш.
Dialogue: 0,0:17:39.93,0:17:41.81,Default,,0,0,0,,Суықтан өліп қалуыңыз мүмкін
Dialogue: 0,0:17:43.14,0:17:45.48,Default,,0,0,0,,Аңның өз жолы бар
Dialogue: 0,0:17:45.56,0:17:48.69,Default,,0,0,0,,Тек оны аңшыдан аңшыға ауыстырыңыз.
Dialogue: 0,0:17:49.90,0:17:52.15,Default,,0,0,0,,«Мұны» ұзақ уақыттан кейін жасайсыз ба?
Dialogue: 0,0:17:52.65,0:17:55.57,Default,,0,0,0,,(Қақтығыс дауыстары)
Dialogue: 0,0:17:57.99,0:17:58.95,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:02.54,0:18:03.66,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:18:06.16,0:18:06.87,Default,,0,0,0,,(ит үреді)
Dialogue: 0,0:18:07.67,0:18:08.46,Default,,0,0,0,,Қазір ғана Какёин менің кім екенімді анықтай бастағанда мен дүрлігіп кеттім
Dialogue: 0,0:18:09.71,0:18:14.09,Default,,0,0,0,,(ит үреді)
Dialogue: 0,0:18:14.17,0:18:16.47,Default,,0,0,0,,- (Сенсей А) Ит пе? - (Чилчак А) Дәмді!
Dialogue: 0,0:18:16.55,0:18:18.34,Default,,0,0,0,,Жоқ. Бұл ит пе?
Dialogue: 0,0:18:18.43,0:18:22.10,Default,,0,0,0,,Есімде қалғаннан бері иттер қасымда болды.
Dialogue: 0,0:18:22.18,0:18:24.27,Default,,0,0,0,,Мен көп нәрсені білдім
Dialogue: 0,0:18:24.35,0:18:25.77,Default,,0,0,0,,Аң аулау жолы
Dialogue: 0,0:18:25.85,0:18:28.85,Default,,0,0,0,,Өзімізден күштілерді қалай сынаймыз
Dialogue: 0,0:18:28.94,0:18:30.52,Default,,0,0,0,,Мен саған үйретемін!
Dialogue: 0,0:18:30.61,0:18:31.86,Default,,0,0,0,,(иттің ұлыуы)
Dialogue: 0,0:18:31.94,0:18:33.07,Default,,0,0,0,,Мен бір қолымда оқпен жүктелген винтовка ұстап тұрмын
Dialogue: 0,0:18:33.15,0:18:34.44,Default,,0,0,0,,Өте жақсы
Dialogue: 0,0:18:34.53,0:18:35.61,Default,,0,0,0,,Мен ит алатын болсам, қауіпсіздік үшін сенім артатын күзетші ит алсам жақсы болар деп ойладым…
Dialogue: 0,0:18:35.69,0:18:39.70,Default,,0,0,0,,Сен аңшы емессің, аңшысың!
Dialogue: 0,0:18:40.95,0:18:41.82,Default,,0,0,0,,Ах
Dialogue: 0,0:18:41.91,0:18:44.87,Default,,0,0,0,,Барлығына! Иллюзияны қараңыз ...
Dialogue: 0,0:18:44.95,0:18:46.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:57.47,0:18:59.55,Default,,0,0,0,,Сіз құйрығыңызды көрсеттіңіз.
Dialogue: 0,0:19:00.22,0:19:02.97,Default,,0,0,0,,Сен де хайуан болсаң, жақсырақ білер едің.
Dialogue: 0,0:19:03.05,0:19:04.14,Default,,0,0,0,,Бұл шайқас
Dialogue: 0,0:19:06.10,0:19:10.14,Default,,0,0,0,,Неғұрлым секірсең, соғұрлым ұтыласың!
Dialogue: 0,0:19:11.10,0:19:14.15,Default,,0,0,0,,Лайос!
Dialogue: 0,0:19:21.28,0:19:23.74,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:19:23.83,0:19:25.28,Default,,0,0,0,,Сиыр!
Dialogue: 0,0:19:26.49,0:19:29.54,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:19:34.29,0:19:35.04,Default,,0,0,0,,Иә
Dialogue: 0,0:19:37.30,0:19:38.71,Default,,0,0,0,,Сен тірісің бе? Лайос
Dialogue: 0,0:19:38.80,0:19:40.17,Default,,0,0,0,,Дұрысы, есі дұрыс па?
Dialogue: 0,0:19:41.26,0:19:42.30,Default,,0,0,0,,Иә
Dialogue: 0,0:19:42.39,0:19:44.26,Default,,0,0,0,,Айтайын дегенім көп.
Dialogue: 0,0:19:44.35,0:19:46.60,Default,,0,0,0,,Неге қаруыңды тартпадың?
Dialogue: 0,0:19:46.68,0:19:49.02,Default,,0,0,0,,Сіз аздап араласып жатырсыз...
Dialogue: 0,0:19:49.10,0:19:50.31,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:52.77,0:19:54.90,Default,,0,0,0,,Барлық тағамдар аяқталмаған.
Dialogue: 0,0:19:54.98,0:19:57.36,Default,,0,0,0,,Бұл галлюцинация және мен жасаған тағам болды.
Dialogue: 0,0:19:57.44,0:19:58.69,Default,,0,0,0,,Оны қайта жасайық
Dialogue: 0,0:20:00.24,0:20:04.66,Default,,0,0,0,,Бірақ соңында Лайостың эстетикалық сезімі дұрыс болды.
Dialogue: 0,0:20:04.74,0:20:06.45,Default,,0,0,0,,Шешім қабылдау үшін қайда қарау керек?
Dialogue: 0,0:20:06.53,0:20:09.45,Default,,0,0,0,,Иә, менің ойымша, бұл құбыжықтардан қашық болу сезімі...
Dialogue: 0,0:20:10.25,0:20:11.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:11.66,0:20:13.92,Default,,0,0,0,,Алдымен Чилчак ағаш жәшікке отырды.
Dialogue: 0,0:20:14.63,0:20:17.84,Default,,0,0,0,,Мұндай орын Мимикс пен Тентакл үшін тамаша жасырыну болып табылады.
Dialogue: 0,0:20:18.34,0:20:21.34,Default,,0,0,0,,Мен оның бұған мүлдем мән бермейтініне таң қалдым.
Dialogue: 0,0:20:21.42,0:20:24.72,Default,,0,0,0,,Құлаған үйдің ішінде ұя бар.
Dialogue: 0,0:20:24.80,0:20:26.97,Default,,0,0,0,,Онда жиналған заттар
Dialogue: 0,0:20:27.68,0:20:30.18,Default,,0,0,0,,Экожүйенің тепе-теңдігін бағалайтын адамға
Dialogue: 0,0:20:30.27,0:20:31.98,Default,,0,0,0,,Аздап немқұрайлы
Dialogue: 0,0:20:32.06,0:20:34.98,Default,,0,0,0,,Арфа жеу жағдайды жақсарта ма?
Dialogue: 0,0:20:35.86,0:20:38.57,Default,,0,0,0,,Ақыры Марсиль қайнаған суды лақтырып жіберді.
Dialogue: 0,0:20:38.65,0:20:42.15,Default,,0,0,0,,Егер сіз Undine-дан сақ болсаңыз, онда бұл әрекет абайсызда.
Dialogue: 0,0:20:42.24,0:20:44.78,Default,,0,0,0,,Мен оның бұған мүлдем мән бермейтініне таң қалдым.
Dialogue: 0,0:20:45.78,0:20:47.74,Default,,0,0,0,,Хмм...?
Dialogue: 0,0:20:49.12,0:20:50.58,Default,,0,0,0,,Ха!
Dialogue: 0,0:20:50.66,0:20:51.54,Default,,0,0,0,,Уф. Менің не істеуімді қалайсың?
Dialogue: 0,0:20:51.62,0:20:54.50,Default,,0,0,0,,Керісінше, оның бейқамдығы шынайы сияқты деп ойладым.
Dialogue: 0,0:20:55.12,0:20:56.38,Default,,0,0,0,,(От-шағал жәндігінің дыбысы)
Dialogue: 0,0:20:56.46,0:20:57.84,Default,,0,0,0,,Мен мұны істеймін, солай ма?
Dialogue: 0,0:20:57.92,0:21:00.50,Default,,0,0,0,,Мен оны қарап шықтым, Райос.
Dialogue: 0,0:21:00.59,0:21:02.84,Default,,0,0,0,,Перспектива сәл ауытқиды.
Dialogue: 0,0:21:03.34,0:21:07.60,Default,,0,0,0,,Жоқ, бірақ генжуцу арқылы көру мүмкін емес.
Dialogue: 0,0:21:08.14,0:21:10.77,Default,,0,0,0,,Олар да осы жейді.
Dialogue: 0,0:21:11.35,0:21:12.89,Default,,0,0,0,,Мен сөзсіз...
Dialogue: 0,0:21:12.98,0:21:15.56,Default,,0,0,0,,Мен тіпті балықшылардың жұмыртқалары мен драйадтарды жедім.\NМен
Dialogue: 0,0:21:16.40,0:21:18.77,Default,,0,0,0,,айтқан кезде байқадың деп ойладым.
Dialogue: 0,0:21:19.52,0:21:23.61,Default,,0,0,0,,Өйткені біз ешқашан балықшының жұмыртқасын жеген емеспіз.
Dialogue: 0,0:21:23.69,0:21:24.57,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:21:25.49,0:21:26.86,Default,,0,0,0,,Ммм...
Dialogue: 0,0:21:27.49,0:21:28.53,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:29.33,0:21:31.33,Default,,0,0,0,,Сол кездегі ботқа ма?
Dialogue: 0,0:21:33.79,0:21:35.79,Default,,0,0,0,,Десерт те пісіріледі.
Dialogue: 0,0:21:35.87,0:21:36.96,Default,,0,0,0,,Иә
Dialogue: 0,0:21:37.04,0:21:39.46,Default,,0,0,0,,Тәттілер Дәмді бірдеңені жемегеніме көп болды.
Dialogue: 0,0:21:39.54,0:21:40.96,Default,,0,0,0,,Шай ішуге бола ма?
Dialogue: 0,0:21:41.55,0:21:44.55,Default,,0,0,0,,Мен алған ингредиенттерде шай жапырақтары бар екеніне сенімдімін...
Dialogue: 0,0:21:44.63,0:21:45.97,Default,,0,0,0,,Хмм?
Dialogue: 0,0:21:46.05,0:21:48.09,Default,,0,0,0,,Бұл түсінбеушілік емес пе?
Dialogue: 0,0:21:48.18,0:21:50.35,Default,,0,0,0,,Жоқ, мен оны осында қойғаныма сенімдімін.
Dialogue: 0,0:21:50.43,0:21:51.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:55.10,0:21:56.31,Default,,0,0,0,,Күріш...
Dialogue: 0,0:21:58.31,0:21:59.44,Default,,0,0,0,,А…?
Dialogue: 0,0:22:10.32,0:22:11.08,Default,,0,0,0,,Ах!
Dialogue: 0,0:22:12.45,0:22:13.58,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:22:15.20,0:22:16.71,Default,,0,0,0,,-Гяаа -Ах
Dialogue: 0,0:22:17.37,0:22:18.08,Default,,0,0,0,,А, аа!
Dialogue: 0,0:22:18.79,0:22:20.04,Default,,0,0,0,,Марсиль!
Dialogue: 0,0:22:21.38,0:22:22.84,Default,,0,0,0,,Қаруыңызды тастаңыз және қозғалмаңыз.
Dialogue: 0,0:22:23.50,0:22:25.80,Default,,0,0,0,,Бейбіт сөйлесейік
Dialogue: 0,0:22:31.01,0:22:33.01,Default,,0,0,0,,♪~
Dialogue: 0,0:23:58.06,0:24:00.06,Default,,0,0,0,,~♪
Dialogue: 0,0:24:01.56,0:24:07.56,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory