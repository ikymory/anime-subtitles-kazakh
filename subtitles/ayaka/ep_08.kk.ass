Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.20,0:00:06.27,Default,,0,0,0,,(құты ашылған дыбыс)
Dialogue: 0,0:00:10.27,0:00:12.24,Default,,0,0,0,,Ку~хехехе
Dialogue: 0,0:00:12.31,0:00:17.31,Default,,0,0,0,,(Сачитоның ұйықтап жатқан тынысы)
Dialogue: 0,0:00:22.72,0:00:24.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:24.62,0:00:27.69,Default,,0,0,0,,Бұл түс көрмегелі біраз болды.
Dialogue: 0,0:00:30.33,0:00:31.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:45.74,0:00:46.64,Default,,0,0,0,,Уф...
Dialogue: 0,0:00:46.71,0:00:48.68,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:00:52.65,0:00:55.08,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:00:56.35,0:00:57.32,Default,,0,0,0,,Ха…
Dialogue: 0,0:00:57.39,0:01:01.59,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:01:03.09,0:01:04.53,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:01:05.26,0:01:06.73,Default,,0,0,0,,Жарайды
Dialogue: 0,0:01:09.63,0:01:11.80,Default,,0,0,0,,Менің көңілім қалды.
Dialogue: 0,0:01:12.07,0:01:14.40,Default,,0,0,0,,Мен біртүрлі түс көрдім.
Dialogue: 0,0:01:14.47,0:01:15.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:16.14,0:01:17.27,Default,,0,0,0,,Юкито…
Dialogue: 0,0:01:18.47,0:01:19.78,Default,,0,0,0,,Сіз...
Dialogue: 0,0:01:23.81,0:01:25.15,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:25.75,0:01:26.65,Default,,0,0,0,,А…?
Dialogue: 0,0:01:28.68,0:01:30.39,Default,,0,0,0,,Ах (ендуги) Бұл кім?
Dialogue: 0,0:01:30.45,0:01:33.39,Default,,0,0,0,,Мүмкін сіз жақында танысқан досыңыздан шығарсыз?
Dialogue: 0,0:01:33.46,0:01:34.32,Default,,0,0,0,,Тіпті оның есту қабілетінен айырылғаны туралы қауесет те бар
Dialogue: 0,0:01:34.39,0:01:36.33,Default,,0,0,0,,Оның Джингиге қатысы жоқ, солай ма?
Dialogue: 0,0:01:36.39,0:01:37.76,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:01:38.39,0:01:39.26,Default,,0,0,0,,Иә
Dialogue: 0,0:01:41.10,0:01:43.57,Default,,0,0,0,,А... А? Фестиваль?
Dialogue: 0,0:01:52.14,0:01:53.78,Default,,0,0,0,,Ғибадатханадағы фестиваль
Dialogue: 0,0:01:53.84,0:01:56.11,Default,,0,0,0,,Және достармен
Dialogue: 0,0:01:56.61,0:01:58.51,Default,,0,0,0,,Ah Жауап Жауап
Dialogue: 0,0:02:03.32,0:02:04.42,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:05.15,0:02:06.29,Default,,0,0,0,,Иә
Dialogue: 0,0:02:06.76,0:02:09.26,Default,,0,0,0,,Мен жексенбіні асыға күтемін.
Dialogue: 0,0:02:09.33,0:02:11.29,Default,,0,0,0,,Ниггамен фестиваль?
Dialogue: 0,0:02:11.36,0:02:12.46,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:12.53,0:02:13.86,Default,,0,0,0,,Жастар, солай емес пе?
Dialogue: 0,0:02:14.13,0:02:16.20,Default,,0,0,0,,Өтінемін, маған қарамаңыз.
Dialogue: 0,0:02:16.27,0:02:20.34,Default,,0,0,0,,Иә? Айтпақшы, отшашу фестиваліне бірінші рет барасыз ба?
Dialogue: 0,0:02:20.40,0:02:22.67,Default,,0,0,0,,Менің есімде жоқ, бірақ мүмкін
Dialogue: 0,0:02:22.74,0:02:25.51,Default,,0,0,0,,Жарайды, сәл күте тұрыңыз.
Dialogue: 0,0:02:28.24,0:02:29.38,Default,,0,0,0,,(Суырманы ашу дыбысы)
Dialogue: 0,0:02:29.45,0:02:32.72,Default,,0,0,0,,Менің ойымша, бұл осы жерде...
Dialogue: 0,0:02:32.78,0:02:34.48,Default,,0,0,0,,болды
Dialogue: 0,0:02:38.55,0:02:40.92,Default,,0,0,0,,Міне, мынаны алыңыз.
Dialogue: 0,0:02:41.19,0:02:41.86,Default,,0,0,0,,Маска?
Dialogue: 0,0:02:42.46,0:02:44.19,Default,,0,0,0,,Аралдың әдет-ғұрыптары.
Dialogue: 0,0:02:44.26,0:02:47.70,Default,,0,0,0,,Отшашу фестиваліне баратындардың барлығы бетперде киеді.
Dialogue: 0,0:02:47.76,0:02:48.80,Default,,0,0,0,,А...
Dialogue: 0,0:02:49.33,0:02:52.80,Default,,0,0,0,,Айтпақшы, ол масканы қожайыным қолданған.
Dialogue: 0,0:02:52.87,0:02:53.90,Default,,0,0,0,,Е...
Dialogue: 0,0:02:55.54,0:02:58.31,Default,,0,0,0,,Менің әкем осылай істеген...
Dialogue: 0,0:02:59.88,0:03:04.68,Default,,0,0,0,,♪～
Dialogue: 0,0:04:23.76,0:04:28.86,Default,,0,0,0,,～♪
Dialogue: 0,0:04:40.78,0:04:42.81,Default,,0,0,0,,Адамдар көп.
Dialogue: 0,0:04:42.88,0:04:44.81,Default,,0,0,0,,Бұл мереке ғой.
Dialogue: 0,0:04:44.88,0:04:46.72,Default,,0,0,0,,Жоғарыда тағы да бар.
Dialogue: 0,0:04:52.29,0:04:52.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:55.89,0:04:58.03,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:58.89,0:05:00.93,Default,,0,0,0,,Сонымен... керемет
Dialogue: 0,0:05:01.00,0:05:05.60,Default,,0,0,0,,Таң қалсам, сіз шынымен қалада болдыңыз ба?
Dialogue: 0,0:05:05.67,0:05:08.94,Default,,0,0,0,,Мен әрқашан адам көп жиналатын жерлерден мүмкіндігінше аулақ болдым.
Dialogue: 0,0:05:09.00,0:05:11.04,Default,,0,0,0,,Йо Джинги (Джинги/Юкито) иә?
Dialogue: 0,0:05:11.31,0:05:12.51,Default,,0,0,0,,О
Dialogue: 0,0:05:12.57,0:05:15.08,Default,,0,0,0,,Не, сен сондай кереметсің бе?
Dialogue: 0,0:05:15.34,0:05:18.75,Default,,0,0,0,,Жақсы, ер адам киімін шешіп, бірдеңе айту керек.
Dialogue: 0,0:05:19.35,0:05:21.92,Default,,0,0,0,,Хаха, сен жалқаусың.
Dialogue: 0,0:05:21.98,0:05:25.85,Default,,0,0,0,,Оның үстіне Азуки-чанның сол жақта дүңгіршегі бар еді.
Dialogue: 0,0:05:25.92,0:05:27.86,Default,,0,0,0,,«Бетіңді көрсет»
Dialogue: 0,0:05:27.92,0:05:30.76,Default,,0,0,0,,Шынайы ма? Қызық, маған қосымша ретінде бересіз бе?
Dialogue: 0,0:05:30.83,0:05:34.10,Default,,0,0,0,,«Егер сізде фестивальде ойнауға ақшаңыз болса, бағасын төлеңіз».
Dialogue: 0,0:05:34.36,0:05:36.00,Default,,0,0,0,,Ах~ Солай ма?
Dialogue: 0,0:05:36.07,0:05:37.80,Default,,0,0,0,,(Үйдегі күлкі/Саруватари)
Dialogue: 0,0:05:38.57,0:05:42.57,Default,,0,0,0,,Мен шынымен де сонда болдым, Джингидің досы.
Dialogue: 0,0:05:42.64,0:05:44.51,Default,,0,0,0,,Әрине, бұл өрескел.
Dialogue: 0,0:05:44.57,0:05:45.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:45.64,0:05:47.38,Default,,0,0,0,,Неге менің артымнан келе жатырсың?
Dialogue: 0,0:05:47.44,0:05:48.41,Default,,0,0,0,,Сіздің достарыңыз ше?
Dialogue: 0,0:05:48.48,0:05:50.75,Default,,0,0,0,,Біз оларды кейінірек қалдырамыз.
Dialogue: 0,0:05:50.81,0:05:52.45,Default,,0,0,0,,Оның орнына сіз
Dialogue: 0,0:05:52.51,0:05:55.45,Default,,0,0,0,,Момоко-сан: «Бәріміз бірге ойнайық» деді.
Dialogue: 0,0:05:55.52,0:05:57.02,Default,,0,0,0,,Сізде қалта ақшасы бар, солай ма?
Dialogue: 0,0:05:57.09,0:05:59.62,Default,,0,0,0,,Мені де сол адамдардың қатарына қосуыңызды өтінемін.
Dialogue: 0,0:05:59.69,0:06:03.89,Default,,0,0,0,,Ұстаздың шәкірттерінен сұрағанын естімеппін.
Dialogue: 0,0:06:03.96,0:06:04.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:04.93,0:06:07.10,Default,,0,0,0,,Мәліметтер жақсы, солай ма?
Dialogue: 0,0:06:07.36,0:06:08.86,Default,,0,0,0,,Барлығымыз көңіл көтерейік
Dialogue: 0,0:06:08.93,0:06:11.40,Default,,0,0,0,,Неге сізде сонша ақша жоқ?
Dialogue: 0,0:06:11.47,0:06:13.94,Default,,0,0,0,,Үлкендер үшін көп нәрсе бар.
Dialogue: 0,0:06:15.67,0:06:17.91,Default,,0,0,0,,Бұл ұят, солай емес пе?
Dialogue: 0,0:06:18.41,0:06:20.41,Default,,0,0,0,,Юкито Янаги (Юкито/Джиёши) Ах...
Dialogue: 0,0:06:26.08,0:06:28.48,Default,,0,0,0,,Ах, Ичиджо мырза.
Dialogue: 0,0:06:28.75,0:06:29.75,Default,,0,0,0,,Қайырлы кеш
Dialogue: 0,0:06:29.82,0:06:30.72,Default,,0,0,0,,Иә
Dialogue: 0,0:06:30.79,0:06:31.75,Default,,0,0,0,,Тікенектер
Dialogue: 0,0:06:32.49,0:06:33.56,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:06:33.62,0:06:36.49,Default,,0,0,0,,Рұқсатсыз сізге жазылғаным үшін кешіріңіз.
Dialogue: 0,0:06:36.56,0:06:37.89,Default,,0,0,0,,Бұл қаңғыбас ит пе?
Dialogue: 0,0:06:38.49,0:06:42.03,Default,,0,0,0,,Әзірше Чатаро-кун мен Яго-кунмен кездесейік.
Dialogue: 0,0:06:42.70,0:06:44.17,Default,,0,0,0,,Сәлем Юкито
Dialogue: 0,0:06:44.43,0:06:47.00,Default,,0,0,0,,Тікенді юкатаны көріп, ойларыңыз бар ма?
Dialogue: 0,0:06:47.07,0:06:48.70,Default,,0,0,0,,Мені мақтасаң, Мен бақыттымын.
Dialogue: 0,0:06:49.54,0:06:52.44,Default,,0,0,0,,Кю... кенет осылай айтсаң да.
Dialogue: 0,0:06:52.51,0:06:53.64,Default,,0,0,0,,Иә.
Dialogue: 0,0:06:53.71,0:06:55.94,Default,,0,0,0,,Бұл туралы менің ойым жоқ сияқты.
Dialogue: 0,0:06:56.01,0:06:57.81,Default,,0,0,0,,Эй, айтшы.
Dialogue: 0,0:06:57.88,0:06:59.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:02.55,0:07:04.19,Default,,0,0,0,,Ой... ой
Dialogue: 0,0:07:04.45,0:07:06.52,Default,,0,0,0,,Мен... Ичиджо мырза
Dialogue: 0,0:07:06.59,0:07:09.46,Default,,0,0,0,,Мына юката... жақсы
Dialogue: 0,0:07:09.83,0:07:13.60,Default,,0,0,0,,Менің ойымша, бұл сізге жарасады...
Dialogue: 0,0:07:13.66,0:07:14.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:16.57,0:07:18.17,Default,,0,0,0,,Ичиджо мырза?
Dialogue: 0,0:07:18.43,0:07:19.64,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:20.07,0:07:23.64,Default,,0,0,0,,Джи... Джинги мырза? Бұл басқа әңгіме.
Dialogue: 0,0:07:21.90,0:07:25.17,Default,,0,0,0,,(Құрмет туралы ысқырық)
Dialogue: 0,0:07:24.17,0:07:26.11,Default,,0,0,0,,Сіз...
Dialogue: 0,0:07:26.64,0:07:27.81,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:28.14,0:07:29.65,Default,,0,0,0,,А…?
Dialogue: 0,0:07:33.95,0:07:34.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:35.65,0:07:37.15,Default,,0,0,0,,Ух... иә!
Dialogue: 0,0:07:37.22,0:07:38.82,Default,,0,0,0,,Бұл сізге өте жарасады
Dialogue: 0,0:07:39.86,0:07:40.92,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:07:43.53,0:07:44.56,Default,,0,0,0,,На
Dialogue: 0,0:07:44.63,0:07:46.70,Default,,0,0,0,,Дәл мен айтқандай болды.
Dialogue: 0,0:07:46.76,0:07:48.76,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:07:48.83,0:07:50.63,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:07:59.91,0:08:03.05,Default,,0,0,0,,Уау, көп нәрсе бар.
Dialogue: 0,0:08:03.11,0:08:05.71,Default,,0,0,0,,...Ал біз қай дүңгіршектен бастауымыз керек?
Dialogue: 0,0:08:05.78,0:08:07.15,Default,,0,0,0,,Мен болсам...
Dialogue: 0,0:08:08.48,0:08:12.25,Default,,0,0,0,,Жоқ... жоқ, алдымен Чатаромен және басқалармен кездесуім керек.
Dialogue: 0,0:08:12.52,0:08:14.26,Default,,0,0,0,,Аз ғана, солай ма?
Dialogue: 0,0:08:14.52,0:08:15.56,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:08:18.06,0:08:21.93,Default,,0,0,0,,Такояки Якисоба кальмар поппо~
Dialogue: 0,0:08:22.00,0:08:23.20,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:29.74,0:08:32.14,Default,,0,0,0,,Шынымды айтсам, абай болмаңыз.
Dialogue: 0,0:08:32.21,0:08:33.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:33.74,0:08:36.01,Default,,0,0,0,,Мен бірдеңені сатқан сайын бонус қоссам.
Dialogue: 0,0:08:36.08,0:08:37.85,Default,,0,0,0,,Бұл тапшылық. Бұл тапшылық.
Dialogue: 0,0:08:37.91,0:08:39.95,Default,,0,0,0,,Ертерек сатып алған адамға
Dialogue: 0,0:08:40.02,0:08:42.52,Default,,0,0,0,,Сіз маған үш сүйкімді сыйладыңыз, солай ма?
Dialogue: 0,0:08:42.58,0:08:43.75,Default,,0,0,0,,Аха…
Dialogue: 0,0:08:43.82,0:08:46.89,Default,,0,0,0,,Өйткені сіз бақытты боласыз.
Dialogue: 0,0:08:46.96,0:08:48.59,Default,,0,0,0,,Я...
Dialogue: 0,0:08:50.26,0:08:51.99,Default,,0,0,0,,Сәлеметсіз бе, қош келдіңіз
Dialogue: 0,0:08:52.06,0:08:52.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:53.00,0:08:55.10,Default,,0,0,0,,Кете барсам, қоштасу сүйісін бересің бе?
Dialogue: 0,0:08:57.07,0:08:59.17,Default,,0,0,0,,Ха... Мен шаршадым.
Dialogue: 0,0:08:59.23,0:09:01.74,Default,,0,0,0,,Әй, тез дүңгіршектерге барайық.
Dialogue: 0,0:09:01.80,0:09:04.01,Default,,0,0,0,,Сіз ештеңе істеген жоқсыз.
Dialogue: 0,0:09:04.07,0:09:06.68,Default,,0,0,0,,Көмектесіңізші.
Dialogue: 0,0:09:07.84,0:09:09.85,Default,,0,0,0,,Оның жасы үлкен екенін білетінмін, бірақ бұл…
Dialogue: 0,0:09:10.71,0:09:13.98,Default,,0,0,0,,Сіз маған ертерек бірдеңе көрсеттіңіз.
Dialogue: 0,0:09:14.55,0:09:16.08,Default,,0,0,0,,Бұл дұрыс емес...
Dialogue: 0,0:09:17.12,0:09:19.09,Default,,0,0,0,,О? Сол маска...
Dialogue: 0,0:09:19.66,0:09:21.82,Default,,0,0,0,,А... иә, бұл менің әкемдікі.
Dialogue: 0,0:09:22.12,0:09:23.93,Default,,0,0,0,,Сондай ностальгиялық
Dialogue: 0,0:09:23.99,0:09:26.09,Default,,0,0,0,,Әйтеуір таныс сияқты.
Dialogue: 0,0:09:26.16,0:09:28.56,Default,,0,0,0,,Мен бұл туралы ойладым.
Dialogue: 0,0:09:28.90,0:09:32.13,Default,,0,0,0,,Неліктен адамдар отшашу фестивалінде бетперде киеді?
Dialogue: 0,0:09:32.20,0:09:33.30,Default,,0,0,0,,Маска...
Dialogue: 0,0:09:34.10,0:09:35.80,Default,,0,0,0,,Бір кездері осы фестивальде
Dialogue: 0,0:09:35.87,0:09:38.87,Default,,0,0,0,,Бұл «адам емес жандардың» қатысуының қалдығы.
Dialogue: 0,0:09:39.78,0:09:41.34,Default,,0,0,0,,Адам емес...
Dialogue: 0,0:09:41.61,0:09:44.75,Default,,0,0,0,,Бұл құдай немесе аруақ сияқты ма?
Dialogue: 0,0:09:44.81,0:09:47.25,Default,,0,0,0,,Ал, бетперде кию себебі
Dialogue: 0,0:09:47.32,0:09:50.65,Default,,0,0,0,,Жеке тұлғамды ұмытып, фестивальден ләззат алу.
Dialogue: 0,0:09:50.72,0:09:52.75,Default,,0,0,0,,Есіңізде болсын
Dialogue: 0,0:09:53.86,0:09:59.66,Default,,0,0,0,,(Адамдардың толқуы)
Dialogue: 0,0:09:59.73,0:10:02.60,Default,,0,0,0,,Иә ірімшік (ысырма дыбысы)
Dialogue: 0,0:10:02.97,0:10:04.30,Default,,0,0,0,,Йошитто
Dialogue: 0,0:10:05.00,0:10:06.84,Default,,0,0,0,,Эй, осы күйіңде мәңгі қалсаң қалай?
Dialogue: 0,0:10:06.90,0:10:11.31,Default,,0,0,0,,Мен және Джинги сатушы боламыз, сондықтан фестивальді тамашалаңыздар.
Dialogue: 0,0:10:10.64,0:10:11.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:11.81,0:10:12.81,Default,,0,0,0,,Иә
Dialogue: 0,0:10:12.87,0:10:16.21,Default,,0,0,0,,Тоқта... Хару-нии, мен сатушылар туралы сұрамадым.
Dialogue: 0,0:10:16.28,0:10:19.18,Default,,0,0,0,,Балалар сендерге бірдеңе болса не істер едіңдер?
Dialogue: 0,0:10:19.25,0:10:20.65,Default,,0,0,0,,Менің күткенім осы болды.
Dialogue: 0,0:10:20.72,0:10:23.82,Default,,0,0,0,,Мен сенің қамқоршың ретінде сенімен бірге боламын...
Dialogue: 0,0:10:24.22,0:10:25.12,Default,,0,0,0,,Энди
Dialogue: 0,0:10:25.89,0:10:29.26,Default,,0,0,0,,Ұстаздың шәкірт болғаны дұрыс емес деп ойлаймын.
Dialogue: 0,0:10:29.32,0:10:30.99,Default,,0,0,0,,А... уф...
Dialogue: 0,0:10:31.36,0:10:34.33,Default,,0,0,0,,Сәттілік, сатушы.
Dialogue: 0,0:10:35.10,0:10:38.40,Default,,0,0,0,,Сәлеметсіз бе, келіңіз.
Dialogue: 0,0:10:35.86,0:10:38.40,Default,,0,0,0,,Эй, Юкито, сен тікендісің!
Dialogue: 0,0:10:38.67,0:10:41.07,Default,,0,0,0,,Есте сақта! (Курама) Хахаха...
Dialogue: 0,0:10:41.34,0:10:44.41,Default,,0,0,0,,Мұғалімге тым көп қадаласың ба?
Dialogue: 0,0:10:44.67,0:10:46.27,Default,,0,0,0,,Ол кісі бастықтың жауы
Dialogue: 0,0:10:46.34,0:10:47.94,Default,,0,0,0,,Сақ болу табиғи нәрсе.
Dialogue: 0,0:10:48.01,0:10:50.41,Default,,0,0,0,,Бірақ біз кімбіз, жаудың шәкірттері?
Dialogue: 0,0:10:50.68,0:10:52.85,Default,,0,0,0,,Бір-бірімізбен қарым-қатынас жасауымыз қалыпты жағдай емес пе?
Dialogue: 0,0:10:52.91,0:10:54.18,Default,,0,0,0,,Екі адам қауіпсіз
Dialogue: 0,0:10:54.25,0:10:55.28,Default,,0,0,0,,Ах... (Яко) Иә.
Dialogue: 0,0:10:55.35,0:10:57.02,Default,,0,0,0,,Әлсіз болғандықтан (Чатаро/Яго)...
Dialogue: 0,0:10:57.29,0:10:59.69,Default,,0,0,0,,Қандай масқара жауап (Чатаро) Ха...
Dialogue: 0,0:10:59.76,0:11:01.12,Default,,0,0,0,,Хаха…
Dialogue: 0,0:11:02.79,0:11:04.66,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:05.39,0:11:06.26,Default,,0,0,0,,Юкито-кун?
Dialogue: 0,0:11:05.39,0:11:06.26,Default,,0,0,0,,Юкито Янаги (Чатаро) Юкито
Dialogue: 0,0:11:06.83,0:11:08.13,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:11:08.20,0:11:10.13,Default,,0,0,0,,Мен кенеттен басым айналып кетті...
Dialogue: 0,0:11:10.77,0:11:12.27,Default,,0,0,0,,Иә? Жарайды
Dialogue: 0,0:11:12.33,0:11:14.97,Default,,0,0,0,,Кешіріңіз, бұл менің қиялым шығар.
Dialogue: 0,0:11:15.27,0:11:16.91,Default,,0,0,0,,Таң қалмаңыз
Dialogue: 0,0:11:17.17,0:11:18.31,Default,,0,0,0,,Аха…
Dialogue: 0,0:11:19.11,0:11:21.28,Default,,0,0,0,,Әзірше бірдеңе жейік.
Dialogue: 0,0:11:21.34,0:11:22.31,Default,,0,0,0,,Жоқ-қ-қ-қ-қ…
Dialogue: 0,0:11:22.38,0:11:25.98,Default,,0,0,0,,Алдымен тойып ал, сосын толық ойнайық.
Dialogue: 0,0:11:26.05,0:11:27.15,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:11:27.75,0:11:28.42,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:11:28.68,0:11:29.89,Default,,0,0,0,,Дәмді
Dialogue: 0,0:11:30.15,0:11:31.05,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:11:30.75,0:11:32.69,Default,,0,0,0,,Көрдіңіз бе? Йоко, түсіндім!
Dialogue: 0,0:11:32.75,0:11:33.69,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:11:32.75,0:11:33.96,Default,,0,0,0,,Сіз үйрендіңіз бе?
Dialogue: 0,0:11:34.02,0:11:35.09,Default,,0,0,0,,«Алдау?» Оны алдау үшін не істемексің?
Dialogue: 0,0:11:35.16,0:11:36.12,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:11:37.76,0:11:38.76,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:11:37.76,0:11:40.10,Default,,0,0,0,,Ой, не істеуім керек? (Чатаро/Яго) Хахаха
Dialogue: 0,0:11:45.27,0:11:49.77,Default,,0,0,0,,Қарғыс атсын, Хару-ни, мені сонша пайдалан!
Dialogue: 0,0:11:49.84,0:11:52.44,Default,,0,0,0,,Мүмкіндікті пайдаланып, қашып құтылғаным жақсы болды...
Dialogue: 0,0:11:52.71,0:11:55.18,Default,,0,0,0,,...Бұл Юкито емес пе?
Dialogue: 0,0:11:53.91,0:11:55.18,Default,,0,0,0,,Онда ол енді
Dialogue: 0,0:11:55.24,0:11:57.18,Default,,0,0,0,,Неліктен біз суретте жоқпыз?
Dialogue: 0,0:11:57.85,0:11:59.21,Default,,0,0,0,,Маған бәрібір
Dialogue: 0,0:11:59.28,0:12:00.22,Default,,0,0,0,,Бұл өтірік...
Dialogue: 0,0:12:00.28,0:12:03.12,Default,,0,0,0,,Ахаха... (Яго) Біздің тіршілігіміз қандай...
Dialogue: 0,0:12:03.19,0:12:06.15,Default,,0,0,0,,Адамдар арба аттай еңбек етсін
Dialogue: 0,0:12:06.22,0:12:09.96,Default,,0,0,0,,Фестиваль тек сіз ғана ұнайсыз ба? Солай ма?
Dialogue: 0,0:12:10.46,0:12:13.90,Default,,0,0,0,,Я, мен мұны жоспарлағандай орындаймын.
Dialogue: 0,0:12:13.96,0:12:16.06,Default,,0,0,0,,Бірақ бұған дейін...
Dialogue: 0,0:12:16.50,0:12:20.24,Default,,0,0,0,,Қожайынымды сатып жібергені үшін суланған үкім.
Dialogue: 0,0:12:20.30,0:12:21.44,Default,,0,0,0,,Хахахаха әдейі емес
Dialogue: 0,0:12:21.50,0:12:23.27,Default,,0,0,0,,Жоқ, бұл анық.
Dialogue: 0,0:12:21.50,0:12:25.17,Default,,0,0,0,,Ал, келесі жолы бәріміз бірге суретке түсейік.
Dialogue: 0,0:12:23.34,0:12:25.77,Default,,0,0,0,,Иә, бұл әдейі жасалғаны сөзсіз.
Dialogue: 0,0:12:27.04,0:12:27.98,Default,,0,0,0,,Хмм…
Dialogue: 0,0:12:28.04,0:12:31.41,Default,,0,0,0,,Бәрінен бас тартқандай көрінген бала
Dialogue: 0,0:12:31.48,0:12:34.22,Default,,0,0,0,,Сіз әдемі жүзді кие бастадыңыз, солай емес пе?
Dialogue: 0,0:12:37.15,0:12:38.99,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:12:40.06,0:12:42.42,Default,,0,0,0,,Юкитодан рахат алыңыз
Dialogue: 0,0:12:51.23,0:12:52.80,Default,,0,0,0,,Енді не жейміз?
Dialogue: 0,0:12:52.87,0:12:54.47,Default,,0,0,0,,Қырылған мұз жегіңіз келе ме?
Dialogue: 0,0:12:54.54,0:12:56.27,Default,,0,0,0,,Сіз аздап көп жеп жатырмын деп ойламайсыз ба?
Dialogue: 0,0:12:56.34,0:12:59.21,Default,,0,0,0,,А, солай шығар. (Чатаро) Сен әлі бара аласың, Юкито.
Dialogue: 0,0:12:59.51,0:13:01.81,Default,,0,0,0,,О... не болды? Ичиджо мырза
Dialogue: 0,0:13:05.38,0:13:09.08,Default,,0,0,0,,Әй, әлгі бау әлгі шілтерге тозып кетті.
Dialogue: 0,0:13:09.15,0:13:10.99,Default,,0,0,0,,Егер сіз оларды киюге дағдыланбасаңыз, сіз оны көп жасайсыз.
Dialogue: 0,0:13:11.52,0:13:13.05,Default,,0,0,0,,Емдеу жақсы болар еді...
Dialogue: 0,0:13:13.12,0:13:14.32,Default,,0,0,0,,Мен жақсымын
Dialogue: 0,0:13:14.39,0:13:16.53,Default,,0,0,0,,Қасиетті кеңседен таңғыш алайын ба?
Dialogue: 0,0:13:17.09,0:13:19.23,Default,,0,0,0,,Мен жақсы жүре аламын.
Dialogue: 0,0:13:19.29,0:13:20.56,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:13:21.40,0:13:24.53,Default,,0,0,0,,Өзіңізді мәжбүрлемеңіз, бұл ауырады.
Dialogue: 0,0:13:25.90,0:13:27.27,Default,,0,0,0,,Мен де
Dialogue: 0,0:13:27.57,0:13:28.87,Default,,0,0,0,,Юката…
Dialogue: 0,0:13:28.94,0:13:33.38,Default,,0,0,0,,Момоко-сан бұл ерекше оқиға болса да, оны маған кигізді және...
Dialogue: 0,0:13:34.01,0:13:38.11,Default,,0,0,0,,Толқып, толқып кеткенім сонша, мен тым көп жүрдім деп ойлаймын.
Dialogue: 0,0:13:38.51,0:13:40.42,Default,,0,0,0,,Менің аяғым аздап ауыруы мүмкін.
Dialogue: 0,0:13:40.95,0:13:43.22,Default,,0,0,0,,Мен бір жерде үзіліс жасай аламын ба?
Dialogue: 0,0:13:43.59,0:13:45.45,Default,,0,0,0,,Бұл сіз...
Dialogue: 0,0:13:46.82,0:13:48.09,Default,,0,0,0,,Әй?
Dialogue: 0,0:13:49.29,0:13:50.96,Default,,0,0,0,,Барлығына не болды?
Dialogue: 0,0:13:52.93,0:13:54.43,Default,,0,0,0,,Иә орындалды
Dialogue: 0,0:13:54.96,0:13:57.10,Default,,0,0,0,,Сіз қалай ойлайсыз? Ибара-чан
Dialogue: 0,0:14:00.57,0:14:01.97,Default,,0,0,0,,Бұл ауырмайды
Dialogue: 0,0:14:02.04,0:14:04.17,Default,,0,0,0,,Аяқ киіміңіздегі көпіршіктерді таңдамаңыз
Dialogue: 0,0:14:04.24,0:14:06.17,Default,,0,0,0,,Сенің аяғың әдемі ғой.
Dialogue: 0,0:14:06.51,0:14:07.88,Default,,0,0,0,,Иә
Dialogue: 0,0:14:07.94,0:14:10.31,Default,,0,0,0,,Рахмет, Момоко-сан.
Dialogue: 0,0:14:10.38,0:14:14.92,Default,,0,0,0,,(Инаоның қорылдауы)
Dialogue: 0,0:14:10.95,0:14:14.92,Default,,0,0,0,,Айтпақшы, Ино мырза және басқалары, не болды?
Dialogue: 0,0:14:15.62,0:14:18.25,Default,,0,0,0,,Барлығы мас болды.
Dialogue: 0,0:14:18.32,0:14:21.09,Default,,0,0,0,,Бұл фестиваль болғандықтан, сіз оны тым көп өткізіп жібердіңіз.
Dialogue: 0,0:14:21.16,0:14:22.29,Default,,0,0,0,,Фу…
Dialogue: 0,0:14:23.43,0:14:24.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:28.46,0:14:31.90,Default,,0,0,0,,Алкогольді өз қарқынмен ішкен дұрыс болса да.
Dialogue: 0,0:14:32.23,0:14:36.34,Default,,0,0,0,,(ішу дыбысы)
Dialogue: 0,0:14:36.40,0:14:39.98,Default,,0,0,0,,А... а...
Dialogue: 0,0:14:42.54,0:14:46.01,Default,,0,0,0,,Ммм, дәмді
Dialogue: 0,0:14:47.42,0:14:50.39,Default,,0,0,0,,Одан гөрі, Юкито-кун, фестиваль туралы не айтасыз?
Dialogue: 0,0:14:51.25,0:14:52.49,Default,,0,0,0,,Ал...
Dialogue: 0,0:14:53.15,0:14:55.49,Default,,0,0,0,,Бұл өте қызық
Dialogue: 0,0:14:55.56,0:14:57.49,Default,,0,0,0,,Бұл ностальгиялық.
Dialogue: 0,0:14:57.56,0:15:02.13,Default,,0,0,0,,Фестивальде Янаги-сенсэй де Юкито сияқты күлді ме?
Dialogue: 0,0:15:02.20,0:15:05.53,Default,,0,0,0,,Хехе, мен үнемі шу шығарып жүретінмін.
Dialogue: 0,0:15:05.60,0:15:07.57,Default,,0,0,0,,Ино мырзамен
Dialogue: 0,0:15:07.64,0:15:10.14,Default,,0,0,0,,Ал... Масато
Dialogue: 0,0:15:10.21,0:15:12.61,Default,,0,0,0,,Мен қырылған мұз дүкеніне көмектесемін дедім.
Dialogue: 0,0:15:12.67,0:15:16.08,Default,,0,0,0,,Мен Антарктидаға мұз жинауға барады дегенді естімеппін... Уф...
Dialogue: 0,0:15:16.14,0:15:17.28,Default,,0,0,0,,Хехе
Dialogue: 0,0:15:17.35,0:15:20.38,Default,,0,0,0,,Бұл баяғыда бірге тамақ сататын дүңгіршекті бірге басқарған кездегі арман болды ма деп ойлаймын.
Dialogue: 0,0:15:20.92,0:15:23.32,Default,,0,0,0,,Сол Момоко-сан
Dialogue: 0,0:15:24.32,0:15:25.55,Default,,0,0,0,,Маған келесі сұраққа жауап бер.
Dialogue: 0,0:15:26.62,0:15:32.09,Default,,0,0,0,,Келесі жолы әкеңіз туралы көбірек айтып беруіңізді өтінемін бе?
Dialogue: 0,0:15:32.16,0:15:33.60,Default,,0,0,0,,Әрине
Dialogue: 0,0:15:33.66,0:15:36.97,Default,,0,0,0,,Мен саған көптеген оғаш оқиғаларды айтып беремін.
Dialogue: 0,0:15:37.03,0:15:39.03,Default,,0,0,0,,Ино-сан және мен
Dialogue: 0,0:15:39.47,0:15:42.14,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:15:42.20,0:15:45.64,Default,,0,0,0,,Курама-санның сыйы Бұл жақсы болды ма?
Dialogue: 0,0:15:45.71,0:15:47.64,Default,,0,0,0,,Мұғалім кез келген нәрсеге риза болады.
Dialogue: 0,0:15:48.34,0:15:50.95,Default,,0,0,0,,Егер ішіне әдемі қызбен бірге мінгенімде ғой.
Dialogue: 0,0:15:51.01,0:15:52.21,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:15:52.71,0:15:54.12,Default,,0,0,0,,Телефон?
Dialogue: 0,0:15:54.18,0:15:55.38,Default,,0,0,0,,Иә
Dialogue: 0,0:15:55.45,0:15:57.45,Default,,0,0,0,,Иә Иә
Dialogue: 0,0:15:58.02,0:15:59.29,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:16:00.19,0:16:01.42,Default,,0,0,0,,Мені өзгертіңізші
Dialogue: 0,0:16:01.49,0:16:03.59,Default,,0,0,0,,Маған? Кімнен?
Dialogue: 0,0:16:04.39,0:16:05.33,Default,,0,0,0,,Босс
Dialogue: 0,0:16:05.39,0:16:08.10,Default,,0,0,0,,Бо... Мен... Ибуки-сан?
Dialogue: 0,0:16:08.53,0:16:09.53,Default,,0,0,0,,Ой... уау...
Dialogue: 0,0:16:12.30,0:16:14.40,Default,,0,0,0,,Мо... Моши Моши
Dialogue: 0,0:16:15.07,0:16:16.04,Default,,0,0,0,,Юкито?
Dialogue: 0,0:16:16.57,0:16:17.97,Default,,0,0,0,,Бұл Ибуки
Dialogue: 0,0:16:19.31,0:16:22.74,Default,,0,0,0,,Бүгін Ибарая Кайзуми храмының балаларымен.
Dialogue: 0,0:16:23.01,0:16:24.45,Default,,0,0,0,,Фестивальге баратын сияқты.
Dialogue: 0,0:16:25.01,0:16:26.51,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:16:28.18,0:16:30.65,Default,,0,0,0,,Мм... Ибуки-сан?
Dialogue: 0,0:16:31.22,0:16:32.62,Default,,0,0,0,,Сіз көңіл көтересіз бе?
Dialogue: 0,0:16:32.69,0:16:35.39,Default,,0,0,0,,... тікенектер
Dialogue: 0,0:16:35.46,0:16:39.09,Default,,0,0,0,,Адамның өзінен сұрау керек.
Dialogue: 0,0:16:39.43,0:16:40.30,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:16:40.36,0:16:42.73,Default,,0,0,0,,Мен... Мен қорықпаймын.
Dialogue: 0,0:16:43.00,0:16:45.33,Default,,0,0,0,,Эй (Яко) да... Әрине.
Dialogue: 0,0:16:45.40,0:16:46.63,Default,,0,0,0,,Тым қорқады
Dialogue: 0,0:16:47.57,0:16:51.14,Default,,0,0,0,,Маған өте қызық болып көрінеді
Dialogue: 0,0:16:52.04,0:16:54.38,Default,,0,0,0,,Олай болса, жақсы.
Dialogue: 0,0:16:56.38,0:16:57.41,Default,,0,0,0,,Фу…
Dialogue: 0,0:16:57.48,0:16:58.71,Default,,0,0,0,,Күтіңіз
Dialogue: 0,0:17:00.05,0:17:03.72,Default,,0,0,0,,Қызының мектепте қалай оқитынын сұраған әкедей болды.
Dialogue: 0,0:17:03.79,0:17:05.05,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:05.12,0:17:07.62,Default,,0,0,0,,А... бұл ештеңе емес.
Dialogue: 0,0:17:11.39,0:17:13.73,Default,,0,0,0,,Біріншіден, мұғалім мінезді адам.
Dialogue: 0,0:17:11.76,0:17:13.26,Default,,0,0,0,,Ол бұзылды
Dialogue: 0,0:17:13.80,0:17:14.66,Default,,0,0,0,,Бұл ең күшті
Dialogue: 0,0:17:14.26,0:17:17.47,Default,,0,0,0,,Мен Құрама-санға тым сақ екенімді айттым.
Dialogue: 0,0:17:14.73,0:17:18.27,Default,,0,0,0,,Иә, сондықтан біз де тату болуымыз керек.
Dialogue: 0,0:17:17.53,0:17:20.54,Default,,0,0,0,,Балалар сендер менің бастығымнан тым қорқасыңдар.
Dialogue: 0,0:17:18.33,0:17:19.70,Default,,0,0,0,,Не болды, мырза Мокки!
Dialogue: 0,0:17:21.04,0:17:21.70,Default,,0,0,0,,Ах... (жүрек соғысы)
Dialogue: 0,0:17:23.07,0:17:24.67,Default,,0,0,0,,Уф... тағы да
Dialogue: 0,0:17:26.71,0:17:28.04,Default,,0,0,0,,Бұл сезім...
Dialogue: 0,0:17:29.48,0:17:30.38,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:17:30.45,0:17:33.25,Default,,0,0,0,,(Шықылдаған дыбыс)
Dialogue: 0,0:17:33.31,0:17:34.32,Default,,0,0,0,,Не?
Dialogue: 0,0:17:34.38,0:17:35.68,Default,,0,0,0,,Бұл...
Dialogue: 0,0:17:35.75,0:17:39.32,Default,,0,0,0,,Кішкентай кезімде менің күшім бақылаудан шығып кеткен кездегідей.
Dialogue: 0,0:17:39.39,0:17:40.26,Default,,0,0,0,,Неге қазір...
Dialogue: 0,0:17:40.56,0:17:43.53,Default,,0,0,0,,Бұл жақсы емес. Бұл жерде мен бақылаудан шықсам...
Dialogue: 0,0:17:44.06,0:17:45.13,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:45.39,0:17:46.63,Default,,0,0,0,,Барлығын кешіріңіз
Dialogue: 0,0:17:46.69,0:17:48.13,Default,,0,0,0,,Е... (Чатаро) Эй, Юкито!
Dialogue: 0,0:17:48.20,0:17:49.26,Default,,0,0,0,,Юкито
Dialogue: 0,0:17:52.27,0:17:54.50,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:17:59.11,0:18:02.58,Default,,0,0,0,,Ешкім қалмайынша кет
Dialogue: 0,0:18:02.64,0:18:05.71,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:18:13.09,0:18:13.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:17.39,0:18:18.76,Default,,0,0,0,,Бұл...
Dialogue: 0,0:18:22.56,0:18:24.13,Default,,0,0,0,,Юкито-кун?
Dialogue: 0,0:18:25.27,0:18:27.67,Default,,0,0,0,,Уф... ха ха...
Dialogue: 0,0:18:28.50,0:18:30.31,Default,,0,0,0,,А... у...
Dialogue: 0,0:18:30.57,0:18:31.64,Default,,0,0,0,,Я...
Dialogue: 0,0:18:31.71,0:18:35.18,Default,,0,0,0,,Мұнда ешкім мазаламайды...
Dialogue: 0,0:18:37.61,0:18:38.55,Default,,0,0,0,,Ах
Dialogue: 0,0:18:38.61,0:18:40.25,Default,,0,0,0,,Немесе... көлеңкеге.
Dialogue: 0,0:18:40.55,0:18:42.42,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:18:43.25,0:18:47.32,Default,,0,0,0,,Жоқ, дәл қазір билікті бақылау бірінші орында.
Dialogue: 0,0:18:47.82,0:18:49.56,Default,,0,0,0,,Сәйкес кел, сәйкес кел
Dialogue: 0,0:18:50.49,0:18:52.46,Default,,0,0,0,,Сәйкес кел, сәйкес кел
Dialogue: 0,0:18:52.79,0:18:55.40,Default,,0,0,0,,Сәйкес кел, жарас, сай
Dialogue: 0,0:18:55.46,0:18:59.17,Default,,0,0,0,,Сәйкес кел, жарас, жарас
Dialogue: 0,0:19:02.24,0:19:03.54,Default,,0,0,0,,Сол жылы тағы бір үрей басталды
Dialogue: 0,0:19:04.47,0:19:06.24,Default,,0,0,0,,Бұл жалғаса берсе...
Dialogue: 0,0:19:06.61,0:19:08.48,Default,,0,0,0,,Сіз бәрін ренжітесіз
Dialogue: 0,0:19:14.35,0:19:16.35,Default,,0,0,0,,Қара, зейінін, зейінін
Dialogue: 0,0:19:16.72,0:19:17.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:18.29,0:19:20.82,Default,,0,0,0,,Иә, мұны істей аласыз.
Dialogue: 0,0:19:21.79,0:19:23.32,Default,,0,0,0,,Джинёши мырза...
Dialogue: 0,0:19:26.76,0:19:29.70,Default,,0,0,0,,Батырлар курсы: Дэнки Камина!
Dialogue: 0,0:19:29.76,0:19:32.60,Default,,0,0,0,,Махаббат пен шаттықта піл бар
Dialogue: 0,0:19:32.67,0:19:36.47,Default,,0,0,0,,Экстаз немесе ғашық, ішінде бірдеңе бар
Dialogue: 0,0:19:36.54,0:19:39.54,Default,,0,0,0,,Ішінде рух бар
Dialogue: 0,0:19:44.25,0:19:45.85,Default,,0,0,0,,Сонымен... мен мұны істей алдым.
Dialogue: 0,0:19:46.48,0:19:47.58,Default,,0,0,0,,Я...
Dialogue: 0,0:19:48.62,0:19:51.39,Default,,0,0,0,,Қашқан билікте, сол көлеңке...
Dialogue: 0,0:19:51.45,0:19:53.25,Default,,0,0,0,,Мен кіммін...
Dialogue: 0,0:19:54.59,0:19:56.49,Default,,0,0,0,,Бұл үлкен мәселе
Dialogue: 0,0:19:56.56,0:19:57.56,Default,,0,0,0,,А...
Dialogue: 0,0:20:04.20,0:20:07.64,Default,,0,0,0,,Мүмкін сен қазір менімен бетпе-бет келерсің.
Dialogue: 0,0:20:08.60,0:20:11.27,Default,,0,0,0,,Өзіңіздегі шындық
Dialogue: 0,0:20:13.44,0:20:14.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:14.44,0:20:15.81,Default,,0,0,0,,Ах... ой...
Dialogue: 0,0:20:16.78,0:20:18.28,Default,,0,0,0,,Қолыңыздан келгеннің бәрін жасаңыз
Dialogue: 0,0:20:20.45,0:20:21.32,Default,,0,0,0,,Ах
Dialogue: 0,0:20:21.38,0:20:23.25,Default,,0,0,0,,Күте тұрыңыз, сіз...
Dialogue: 0,0:20:23.32,0:20:25.22,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:20:25.29,0:20:26.29,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:27.49,0:20:28.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:35.86,0:20:39.23,Default,,0,0,0,,Мен ол адаммен бұрын кездескен сияқтымын...
Dialogue: 0,0:20:39.30,0:20:41.27,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:41.34,0:20:43.94,Default,,0,0,0,,Сен мұнда не істеп жүрсің?
Dialogue: 0,0:20:44.01,0:20:46.47,Default,,0,0,0,,А? Оны көргенде түсінесіз
Dialogue: 0,0:20:46.54,0:20:49.64,Default,,0,0,0,,Фестивальдің шуынан ләззат алу үшін сусын алдық.
Dialogue: 0,0:20:49.94,0:20:52.61,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:20:52.68,0:20:55.48,Default,,0,0,0,,Балалар арасындағы ойын аяқталды ма?
Dialogue: 0,0:20:55.55,0:20:56.92,Default,,0,0,0,,Э? Ах…
Dialogue: 0,0:21:00.02,0:21:03.02,Default,,0,0,0,,Барлығы... Момоко да.
Dialogue: 0,0:21:03.93,0:21:05.76,Default,,0,0,0,,«Кешіріңіз, мен бірден қайтамын.»
Dialogue: 0,0:21:05.83,0:21:06.69,Default,,0,0,0,,(беру дыбысы)
Dialogue: 0,0:21:07.00,0:21:09.93,Default,,0,0,0,,Мен барлығына қайта ораламын.
Dialogue: 0,0:21:12.93,0:21:15.94,Default,,0,0,0,,Ах... Джинги-сан (Джинги) А?
Dialogue: 0,0:21:16.57,0:21:19.74,Default,,0,0,0,,Өйткені Джинги-сан маған өз күшімді басқаруды үйретті.
Dialogue: 0,0:21:19.81,0:21:21.88,Default,,0,0,0,,Сіз барлығымен бірге бола аласыз
Dialogue: 0,0:21:21.94,0:21:22.98,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:21:23.54,0:21:25.48,Default,,0,0,0,,Рахмет
Dialogue: 0,0:21:29.35,0:21:30.32,Default,,0,0,0,,Иә
Dialogue: 0,0:21:31.52,0:21:32.49,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:21:32.55,0:21:35.49,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:21:43.70,0:21:44.77,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:21:45.57,0:21:46.77,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:21:46.83,0:21:47.97,Default,,0,0,0,,Ха…
Dialogue: 0,0:21:49.90,0:21:51.57,Default,,0,0,0,,Шиносима...
Dialogue: 0,0:21:54.38,0:21:55.31,Default,,0,0,0,,Хаха…
Dialogue: 0,0:21:58.61,0:22:01.02,Default,,0,0,0,,Ол ақыры келді ме?
Dialogue: 0,0:22:04.89,0:22:09.89,Default,,0,0,0,,♪～
Dialogue: 0,0:23:29.84,0:23:34.84,Default,,0,0,0,,～♪
