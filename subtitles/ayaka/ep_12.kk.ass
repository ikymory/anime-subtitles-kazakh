Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.13,0:00:06.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:09.63,0:00:13.84,Default,,0,0,0,,♪～
Dialogue: 0,0:00:14.84,0:00:16.22,Default,,0,0,0,,Юкито-кун…
Dialogue: 0,0:00:19.06,0:00:21.10,Default,,0,0,0,,Ха... Бастық!
Dialogue: 0,0:00:24.65,0:00:27.48,Default,,0,0,0,,Әй... Әй, екеуіңе не болды?
Dialogue: 0,0:00:30.36,0:00:32.82,Default,,0,0,0,,Қазір қайда баруым керек?
Dialogue: 0,0:00:43.66,0:00:46.29,Default,,0,0,0,,Юкито, ұшып көріңіз!
Dialogue: 0,0:00:50.42,0:00:55.43,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:01:06.69,0:01:08.73,Default,,0,0,0,,Оны қайтадан сезініңіз
Dialogue: 0,0:01:09.23,0:01:12.57,Default,,0,0,0,,Сол Джинги жүзіп жүрген жер
Dialogue: 0,0:01:13.69,0:01:14.95,Default,,0,0,0,,Бұл тым қауіпті. Соған қарамастан, шкафта жасырынғаным дұрыс
Dialogue: 0,0:01:15.74,0:01:16.86,Default,,0,0,0,,Мен оларды көріп тұрмын
Dialogue: 0,0:01:17.49,0:01:18.87,Default,,0,0,0,,Бұл өмір арқауы
Dialogue: 0,0:01:20.87,0:01:22.16,Default,,0,0,0,,Ұшайық
Dialogue: 0,0:01:22.24,0:01:26.17,Default,,0,0,0,,Бұл жолы мен Джинги-санға өзім көмектесемін.
Dialogue: 0,0:01:35.67,0:01:38.84,Default,,0,0,0,,～♪
Dialogue: 0,0:01:41.26,0:01:42.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:44.18,0:01:45.64,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:01:50.90,0:01:52.78,Default,,0,0,0,,Мен кірдім.
Dialogue: 0,0:01:53.48,0:01:54.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:57.66,0:01:58.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:01.12,0:02:03.79,Default,,0,0,0,,Өмір бірге ағып жатқан жер
Dialogue: 0,0:02:03.87,0:02:07.08,Default,,0,0,0,,Немесе осы бір өмірдің өзі шығар
Dialogue: 0,0:02:07.67,0:02:08.96,Default,,0,0,0,,Өмір желісі?
Dialogue: 0,0:02:12.92,0:02:16.13,Default,,0,0,0,,Осылардың арасынан тек бір адамды іздеңіз...
Dialogue: 0,0:02:16.72,0:02:19.51,Default,,0,0,0,,Сіз мені желкеден ұстасаңыз да, мен ешқашан...
Dialogue: 0,0:02:19.59,0:02:22.01,Default,,0,0,0,,Мен сені міндетті түрде үйге апарамын.
Dialogue: 0,0:02:27.06,0:02:30.56,Default,,0,0,0,,Джинги мырза, сіз қайдасыз?
Dialogue: 0,0:02:30.65,0:02:32.02,Default,,0,0,0,,А...
Dialogue: 0,0:02:32.11,0:02:32.94,Default,,0,0,0,,Уау
Dialogue: 0,0:02:38.32,0:02:39.61,Default,,0,0,0,,Қандай әйелдер ұнайды саған?
Dialogue: 0,0:02:44.41,0:02:45.70,Default,,0,0,0,,Жарайды, жарайды
Dialogue: 0,0:02:45.79,0:02:48.87,Default,,0,0,0,,Сіздің өзін-өзі сезінуіңіз адам сияқты қалыптасады.
Dialogue: 0,0:02:49.29,0:02:52.54,Default,,0,0,0,,Егер сіз оны менсіз Аяка аралында өсірсеңіз, жағдай бұлай болмайды.
Dialogue: 0,0:02:53.00,0:02:57.38,Default,,0,0,0,,Нұсқаулар өлім сәтіне дейін өте дәл болды.
Dialogue: 0,0:02:58.34,0:02:59.59,Default,,0,0,0,,Өлімдік күнәлардың кардиналына тән нәрсе деп айтуға болатын шығар.
Dialogue: 0,0:03:01.55,0:03:03.26,Default,,0,0,0,,Мен күткендей
Dialogue: 0,0:03:03.35,0:03:05.39,Default,,0,0,0,,Кез келген жағдайда, әке?
Dialogue: 0,0:03:06.10,0:03:09.10,Default,,0,0,0,,Әй, балам, түсіндің бе?
Dialogue: 0,0:03:09.94,0:03:12.02,Default,,0,0,0,,Бұл жерде маскалар ештеңені білдірмейді.
Dialogue: 0,0:03:12.10,0:03:14.11,Default,,0,0,0,,Білу табиғи нәрсе ме?
Dialogue: 0,0:03:15.57,0:03:16.65,Default,,0,0,0,,Иә
Dialogue: 0,0:03:17.53,0:03:19.78,Default,,0,0,0,,Әй, біраз уақыт болды.
Dialogue: 0,0:03:19.86,0:03:21.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:23.28,0:03:26.41,Default,,0,0,0,,Өйткені, бұл менің әкем еді.
Dialogue: 0,0:03:26.49,0:03:29.83,Default,,0,0,0,,Бірақ менің әкем 10 жыл бұрын қайтыс болды...
Dialogue: 0,0:03:30.50,0:03:32.25,Default,,0,0,0,,Неге мұндасың?
Dialogue: 0,0:03:32.33,0:03:35.17,Default,,0,0,0,,Су айдаһарындай оянғанша
Dialogue: 0,0:03:35.25,0:03:38.96,Default,,0,0,0,,Мен мұнда 10 жыл бойы отты айдаһарды ұстап тұрдым.
Dialogue: 0,0:03:39.05,0:03:41.63,Default,,0,0,0,,Бұл жолы шынымен де қолымнан шықты.
Dialogue: 0,0:03:42.18,0:03:45.43,Default,,0,0,0,,Әкең қайтыс болды, солай ма?
Dialogue: 0,0:03:45.51,0:03:47.14,Default,,0,0,0,,Жақсы
Dialogue: 0,0:03:47.22,0:03:51.35,Default,,0,0,0,,Күтілгендей, егер бұл бетпе-бет шайқас болса, сіз отты айдаһарды жеңе алмас едіңіз.
Dialogue: 0,0:03:51.44,0:03:53.02,Default,,0,0,0,,Жан болған соң,
Dialogue: 0,0:03:53.10,0:03:57.57,Default,,0,0,0,,Мен өзімнің өмір жолымда отты айдаһармен күресуді шыдамдылықпен жалғастырдым.
Dialogue: 0,0:03:58.03,0:04:02.36,Default,,0,0,0,,Менен маңыздысы сенсің, су айдаһары.
Dialogue: 0,0:04:02.86,0:04:05.99,Default,,0,0,0,,Мен оны мен сияқты қамқоршысыз аралда өсірсем ше?
Dialogue: 0,0:04:06.08,0:04:07.95,Default,,0,0,0,,Дәл сол жерде от айдаһары айналып жүр.
Dialogue: 0,0:04:08.04,0:04:09.91,Default,,0,0,0,,Зорлану қаупі болды.
Dialogue: 0,0:04:10.00,0:04:12.71,Default,,0,0,0,,Сондықтан мүмкіндігінше...
Dialogue: 0,0:04:12.79,0:04:15.00,Default,,0,0,0,,Байланысты әлсірету үшін...
Dialogue: 0,0:04:15.08,0:04:18.17,Default,,0,0,0,,Аралдан тыс жерде ешкімнің сізбен байланысуына жол бермеңіз.
Dialogue: 0,0:04:18.25,0:04:20.09,Default,,0,0,0,,Адам болып өскен
Dialogue: 0,0:04:20.17,0:04:21.59,Default,,0,0,0,,Ах~ Ол тірі!
Dialogue: 0,0:04:21.67,0:04:24.39,Default,,0,0,0,,Бізбен сөйлесіп, жанашырлық таныта аласыз――
Dialogue: 0,0:04:24.47,0:04:28.85,Default,,0,0,0,,Сондықтан ол мені аралдың қамқоршы құдайы етіп дайындады.
Dialogue: 0,0:04:29.39,0:04:31.81,Default,,0,0,0,,Ештеңе болмайынша, бәріміз сол қалпымызда қала береміз.
Dialogue: 0,0:04:31.89,0:04:33.64,Default,,0,0,0,,Мен өмір сүре алар едім...
Dialogue: 0,0:04:36.77,0:04:37.77,Default,,0,0,0,,Я...
Dialogue: 0,0:04:39.02,0:04:42.24,Default,,0,0,0,,Ха, бұл адам сенгісіз әуесқойлық.
Dialogue: 0,0:04:42.99,0:04:44.53,Default,,0,0,0,,Осыдан, Юкито
Dialogue: 0,0:04:44.61,0:04:47.24,Default,,0,0,0,,Осы уақытқа дейін бірдеңе істегендіктен келдіңіз, солай ма?
Dialogue: 0,0:04:47.32,0:04:48.53,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:04:48.62,0:04:50.08,Default,,0,0,0,,Мүмкін бұл сенің әкең шығар.
Dialogue: 0,0:04:50.16,0:04:52.37,Default,,0,0,0,,Джинги-санның қайда екенін де білесің...
Dialogue: 0,0:04:52.45,0:04:53.54,Default,,0,0,0,,Әрине
Dialogue: 0,0:04:53.62,0:04:55.62,Default,,0,0,0,,Өйткені бұл Ұлы Гермит.
Dialogue: 0,0:04:56.04,0:04:58.54,Default,,0,0,0,,Мен мұнда келген кезде оны бағдар ретінде белгіледім――
Dialogue: 0,0:04:58.63,0:05:00.05,Default,,0,0,0,,Менің кейінгі суретімде
Dialogue: 0,0:05:00.13,0:05:03.22,Default,,0,0,0,,Өкінішпен маған жабысады...
Dialogue: 0,0:05:03.67,0:05:06.39,Default,,0,0,0,,Иә? Ол кетті
Dialogue: 0,0:05:06.47,0:05:07.76,Default,,0,0,0,,Сізді су шайып кетті ме?
Dialogue: 0,0:05:07.85,0:05:08.85,Default,,0,0,0,,А...
Dialogue: 0,0:05:08.93,0:05:10.56,Default,,0,0,0,,Мені қазір сонда апарыңыз
Dialogue: 0,0:05:10.93,0:05:13.10,Default,,0,0,0,,Мен Джинёшиді қайтарғым келеді.
Dialogue: 0,0:05:13.18,0:05:14.39,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:05:14.48,0:05:16.23,Default,,0,0,0,,Сіз су айдаһарындайсыз
Dialogue: 0,0:05:16.31,0:05:19.44,Default,,0,0,0,,Өмірге үйренгеніңді күттім.
Dialogue: 0,0:05:19.52,0:05:20.86,Default,,0,0,0,,Басқа амал жоқ па?
Dialogue: 0,0:05:21.19,0:05:22.99,Default,,0,0,0,,Менің артымнан жүр
Dialogue: 0,0:05:25.24,0:05:26.24,Default,,0,0,0,,А...
Dialogue: 0,0:05:26.70,0:05:28.32,Default,,0,0,0,,Ал... күте тұрыңыз
Dialogue: 0,0:05:30.58,0:05:32.04,Default,,0,0,0,,Ах... ах
Dialogue: 0,0:05:33.37,0:05:34.20,Default,,0,0,0,,Уау
Dialogue: 0,0:05:34.58,0:05:36.12,Default,,0,0,0,,Қарғыс атсын... тағы да...
Dialogue: 0,0:05:36.92,0:05:38.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:38.29,0:05:40.59,Default,,0,0,0,,Не болды? су айдаһары
Dialogue: 0,0:05:40.67,0:05:43.55,Default,,0,0,0,,Тез жетпесең, бөлініп қаламыз.
Dialogue: 0,0:05:43.63,0:05:45.72,Default,,0,0,0,,Уау... Уау
Dialogue: 0,0:05:46.18,0:05:48.22,Default,,0,0,0,,Танжиро~!
Dialogue: 0,0:05:48.30,0:05:49.72,Default,,0,0,0,,Өмір сызығы қандай?
Dialogue: 0,0:05:49.80,0:05:53.14,Default,,0,0,0,,Тіршілік атты өмірді алып жатқан үлкен өзен.
Dialogue: 0,0:05:53.81,0:05:56.77,Default,,0,0,0,,Егер сіз өзіңіздің сенімді Ұлы Гермитіңізден айырылсаңыз
Dialogue: 0,0:05:56.85,0:05:58.81,Default,,0,0,0,,Тіпті кішіпейіл су айдаһары
Dialogue: 0,0:05:58.90,0:06:01.07,Default,,0,0,0,,Сіз адасып қалуыңыз мүмкін.
Dialogue: 0,0:06:02.23,0:06:04.15,Default,,0,0,0,,Бұл... (Янаги) Сіз оны мәжбүрлей алмайсыз.
Dialogue: 0,0:06:04.23,0:06:05.07,Default,,0,0,0,,Е...
Dialogue: 0,0:06:05.15,0:06:09.62,Default,,0,0,0,,Егер сіз бас тартсаңыз, сіздің өмір жолыңыз басқа нәрсеге айналады және сізді блоктайды.
Dialogue: 0,0:06:10.87,0:06:14.83,Default,,0,0,0,,Ағып жатқан өмір ағымына қосылыңыз.
Dialogue: 0,0:06:14.91,0:06:18.08,Default,,0,0,0,,Егер сіз мұны істесеңіз, сізді ештеңе тоқтата алмайды.
Dialogue: 0,0:06:18.54,0:06:20.00,Default,,0,0,0,,Бұл әрекет...
Dialogue: 0,0:06:20.75,0:06:22.42,Default,,0,0,0,,Импульстік қосылым
Dialogue: 0,0:06:29.34,0:06:30.34,Default,,0,0,0,,Иә
Dialogue: 0,0:06:33.47,0:06:34.89,Default,,0,0,0,,Орындалды, солай ма?
Dialogue: 0,0:06:34.97,0:06:36.73,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:06:36.81,0:06:39.65,Default,,0,0,0,,Адал бейбақ, бұл сиқыр ма, әлде техника ма?
Dialogue: 0,0:06:39.73,0:06:41.98,Default,,0,0,0,,Менің ойымша, ол маған жай ғана тармақтар мен соңғы тарауларды үйретті.
Dialogue: 0,0:06:42.06,0:06:43.98,Default,,0,0,0,,Мен уайымдап тұрмын.
Dialogue: 0,0:06:44.40,0:06:47.28,Default,,0,0,0,,Әй, байыпты айтып тұрған сияқтысың...
Dialogue: 0,0:06:47.36,0:06:48.32,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:48.40,0:06:50.53,Default,,0,0,0,,Менде солай істеген кездер болды.
Dialogue: 0,0:06:50.95,0:06:53.95,Default,,0,0,0,,Хаха, ол өзгерген жоқ.
Dialogue: 0,0:06:55.79,0:06:57.25,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:06:57.33,0:07:01.67,Default,,0,0,0,,Менің ұлыма үйрететінім және айтатыным осы...
Dialogue: 0,0:07:01.75,0:07:03.13,Default,,0,0,0,,Ұлым?
Dialogue: 0,0:07:03.21,0:07:04.96,Default,,0,0,0,,Бұл қызметші
Dialogue: 0,0:07:05.05,0:07:06.38,Default,,0,0,0,,Отомо
Dialogue: 0,0:07:07.09,0:07:08.80,Default,,0,0,0,,Сіздің тұлғаңыз қандай болса да
Dialogue: 0,0:07:08.88,0:07:11.09,Default,,0,0,0,,Мен оны ұлым ретінде қабылдағаннан бері.
Dialogue: 0,0:07:11.18,0:07:14.30,Default,,0,0,0,,Кім не десе де, ол менің ұлым.
Dialogue: 0,0:07:14.76,0:07:15.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:16.06,0:07:17.64,Default,,0,0,0,,Жүр, асығайық.
Dialogue: 0,0:07:17.72,0:07:21.15,Default,,0,0,0,,Мен сол ақымақтың жанын қорғау үшін сиқыр қолдандым, бірақ...
Dialogue: 0,0:07:21.23,0:07:22.94,Default,,0,0,0,,Қанша уақытқа созылатынын білмеймін.
Dialogue: 0,0:07:23.02,0:07:26.11,Default,,0,0,0,,Е, тез айтшы.
Dialogue: 0,0:07:32.03,0:07:33.62,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:07:33.70,0:07:35.03,Default,,0,0,0,,Бұл...
Dialogue: 0,0:07:35.12,0:07:36.99,Default,,0,0,0,,От айдаһар бағындырылса да
Dialogue: 0,0:07:37.08,0:07:39.71,Default,,0,0,0,,Әлі тұрақты емес пе?
Dialogue: 0,0:07:39.79,0:07:44.59,Default,,0,0,0,,(Арамитаманың ырылдауы)
Dialogue: 0,0:07:44.67,0:07:45.59,Default,,0,0,0,,Осындай кезде...
Dialogue: 0,0:07:45.67,0:07:46.80,Default,,0,0,0,,Мұғалімнің араласуы
Dialogue: 0,0:07:47.21,0:07:48.13,Default,,0,0,0,,Мен саған рұқсат бермеймін!
Dialogue: 0,0:07:49.42,0:07:50.34,Default,,0,0,0,,Келеді!
Dialogue: 0,0:07:50.42,0:07:51.72,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:07:55.80,0:07:57.93,Default,,0,0,0,,Не... мұнда неге келдің?
Dialogue: 0,0:08:00.06,0:08:03.65,Default,,0,0,0,,Қожайыныңыз мұнда не істеп жатыр?
Dialogue: 0,0:08:03.73,0:08:05.40,Default,,0,0,0,,Біз үшін де сергіту
Dialogue: 0,0:08:05.48,0:08:07.32,Default,,0,0,0,,Бұл маңызды рәсім сияқты.
Dialogue: 0,0:08:07.40,0:08:10.24,Default,,0,0,0,,Юкито туралы айтылған сияқты.
Dialogue: 0,0:08:10.32,0:08:13.53,Default,,0,0,0,,Айдаһарға айналған Юкитоның барын да сездің.
Dialogue: 0,0:08:14.03,0:08:16.70,Default,,0,0,0,,Осыдан кейін ол құтқару жіпіне секірді.
Dialogue: 0,0:08:16.78,0:08:17.83,Default,,0,0,0,,Е...
Dialogue: 0,0:08:17.91,0:08:21.33,Default,,0,0,0,,А-а... Айдаһар боп өмір арқауыма оралмадым.
Dialogue: 0,0:08:21.41,0:08:22.87,Default,,0,0,0,,Момоко-санның әңгімесіне келсек
Dialogue: 0,0:08:22.96,0:08:25.13,Default,,0,0,0,,Өмірдің тамырында әлі тірі жүрген Мицуёси мырза.
Dialogue: 0,0:08:25.21,0:08:26.96,Default,,0,0,0,,Сіз көмекке бардыңыз ба?
Dialogue: 0,0:08:27.04,0:08:27.88,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:08:27.96,0:08:30.30,Default,,0,0,0,,Юкито, жақсысың ба?
Dialogue: 0,0:08:30.38,0:08:33.30,Default,,0,0,0,,Сезім мүшелеріммен түрткенде ғана есінен танып қалатындай сезінемін.
Dialogue: 0,0:08:33.38,0:08:36.30,Default,,0,0,0,,Бұл дүниедегі барлық тіршіліктің ағымы.
Dialogue: 0,0:08:36.39,0:08:37.72,Default,,0,0,0,,Қанша болса да...
Dialogue: 0,0:08:37.80,0:08:40.35,Default,,0,0,0,,Олар қарт адамды шынымен сынап жатыр
Dialogue: 0,0:08:40.43,0:08:42.35,Default,,0,0,0,,Үлкен кеме болса да
Dialogue: 0,0:08:42.43,0:08:46.19,Default,,0,0,0,,Егер капитан теңізбен таныс болмай, толқынды теңізге шықса,
Dialogue: 0,0:08:46.27,0:08:49.52,Default,,0,0,0,,Дрейф, аударылу және мүмкін батып кету
Dialogue: 0,0:08:49.61,0:08:51.90,Default,,0,0,0,,Мен су айдаһарына айналдым
Dialogue: 0,0:08:51.99,0:08:54.20,Default,,0,0,0,,Қауіпті білмеу мүмкін емес
Dialogue: 0,0:08:54.28,0:08:56.62,Default,,0,0,0,,Ол сонда да секіріп кетті.
Dialogue: 0,0:08:57.66,0:08:59.79,Default,,0,0,0,,Себепке көмектесу
Dialogue: 0,0:09:01.04,0:09:03.50,Default,,0,0,0,,Керемет, Юкито.
Dialogue: 0,0:09:03.58,0:09:05.04,Default,,0,0,0,,Иә, шынымен
Dialogue: 0,0:09:05.12,0:09:06.08,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:09:06.17,0:09:07.50,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:09:07.58,0:09:09.42,Default,,0,0,0,,Бұл айтатын уақыт емес
Dialogue: 0,0:09:11.13,0:09:13.38,Default,,0,0,0,,Арамитама сондай...
Dialogue: 0,0:09:13.92,0:09:16.05,Default,,0,0,0,,Менің шақыруыма жауап ретінде
Dialogue: 0,0:09:16.13,0:09:19.55,Default,,0,0,0,,Менің ойымша, артық адамдар өмірден шығып жатыр.
Dialogue: 0,0:09:19.64,0:09:21.47,Default,,0,0,0,,Сіз осындасыз ба?
Dialogue: 0,0:09:25.02,0:09:27.85,Default,,0,0,0,,Менің қолымнан келеді деп ойлаймын, Көктем мен Күз.
Dialogue: 0,0:09:28.90,0:09:31.28,Default,,0,0,0,,Мен жасап көрейін, Шу.
Dialogue: 0,0:09:35.20,0:09:37.11,Default,,0,0,0,,Мен саған кедергі келтірмеймін.
Dialogue: 0,0:09:37.20,0:09:38.53,Default,,0,0,0,,Тіпті біз
Dialogue: 0,0:09:38.62,0:09:39.53,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:40.37,0:09:42.04,Default,,0,0,0,,Мен… алдымен сені өлтіремін… Буга…ратти…
Dialogue: 0,0:09:48.96,0:09:51.42,Default,,0,0,0,,Уау...
Dialogue: 0,0:09:48.96,0:09:51.42,Default,,0,0,0,,Қараңдар, мына жерде. (Юкито) Ах.
Dialogue: 0,0:09:52.05,0:09:53.59,Default,,0,0,0,,сыпырылып кетті
Dialogue: 0,0:09:53.67,0:09:56.51,Default,,0,0,0,,Тез кел, Юкито.
Dialogue: 0,0:09:56.59,0:09:57.55,Default,,0,0,0,,Эден мектебінің сұхбатына барамын
Dialogue: 0,0:09:57.63,0:10:01.10,Default,,0,0,0,,Не... мен көмектесуге келдім.
Dialogue: 0,0:10:01.60,0:10:03.97,Default,,0,0,0,,H... Бұл шынымен Юкито ма?
Dialogue: 0,0:10:04.06,0:10:06.77,Default,,0,0,0,,Саман болса да, Мен онымен шыдаймын.
Dialogue: 0,0:10:06.85,0:10:08.15,Default,,0,0,0,,Ф-Фатирлеу ештеңе әкелмейді.
Dialogue: 0,0:10:08.23,0:10:10.81,Default,,0,0,0,,Осындай уақытқа дейін сен кімсің?
Dialogue: 0,0:10:12.86,0:10:15.36,Default,,0,0,0,,Өздігінен көңіл көтеру
Dialogue: 0,0:10:15.44,0:10:17.70,Default,,0,0,0,,Жалғыз және рұқсатсыз өліңіз
Dialogue: 0,0:10:17.78,0:10:20.70,Default,,0,0,0,,Артында бәрі қалды... Мен...
Dialogue: 0,0:10:20.78,0:10:21.87,Default,,0,0,0,,Қанша...
Dialogue: 0,0:10:22.33,0:10:24.70,Default,,0,0,0,,Сіз мұны істей алмайсыз, солай ма?
Dialogue: 0,0:10:24.79,0:10:26.41,Default,,0,0,0,,Мұны жасамаңыз.
Dialogue: 0,0:10:26.50,0:10:29.04,Default,,0,0,0,,Бұл ақымақ шәкірт (Шегі жоқ) О...
Dialogue: 0,0:10:29.12,0:10:31.34,Default,,0,0,0,,Енді сіз ең болмағанда қозғала аласыз.
Dialogue: 0,0:10:31.42,0:10:33.96,Default,,0,0,0,,Ши... Ұстаз? неге мұнда
Dialogue: 0,0:10:34.05,0:10:34.96,Default,,0,0,0,,Менің қалай сезініп жүргенімді елестетіп көр.
Dialogue: 0,0:10:35.05,0:10:38.59,Default,,0,0,0,,Тәжірибесіз адамдар жасырын әдістерді ұқыпсыз қолданады.
Dialogue: 0,0:10:38.68,0:10:41.26,Default,,0,0,0,,Иә, жағдай шынымен нашар болғанда айдаһарды ояту.
Dialogue: 0,0:10:41.35,0:10:43.06,Default,,0,0,0,,Бұл төтенше шара.
Dialogue: 0,0:10:43.14,0:10:45.64,Default,,0,0,0,,Менің ойымша, олар оны пайдаланды, себебі бұл өте нашар болды.
Dialogue: 0,0:10:46.02,0:10:47.31,Default,,0,0,0,,Осылай жалғаса берсе, арал отты теңізге айналады...
Dialogue: 0,0:10:47.39,0:10:48.89,Default,,0,0,0,,Хмм, жарай…
Dialogue: 0,0:10:48.98,0:10:50.31,Default,,0,0,0,,Егер солай болса
Dialogue: 0,0:10:50.40,0:10:53.07,Default,,0,0,0,,Мен жасаған гексаграмма сияқты
Dialogue: 0,0:10:53.15,0:10:56.44,Default,,0,0,0,,«15 жылдан кейін Юкитоны аралға қайтарыңыз.»
Dialogue: 0,0:10:56.53,0:10:58.74,Default,,0,0,0,,Үшінші туралы айтатын нәрсе қалдырсам да
Dialogue: 0,0:10:58.82,0:11:02.41,Default,,0,0,0,,Уақытында су айдаһары болып оянбасам
Dialogue: 0,0:11:02.49,0:11:06.33,Default,,0,0,0,,Мен аралдың өртеніп кетуіне дайындалуым керек еді.
Dialogue: 0,0:11:06.41,0:11:08.54,Default,,0,0,0,,Бұл да табиғи нәрсе.
Dialogue: 0,0:11:08.62,0:11:12.46,Default,,0,0,0,,Данышпанның көзқарасы бойынша мұны оңай айтуға болады.
Dialogue: 0,0:11:12.54,0:11:15.71,Default,,0,0,0,,Маған да ыңғайлы сияқты...
Dialogue: 0,0:11:15.80,0:11:18.84,Default,,0,0,0,,Біз тұратын жерді қорғағымыз келді, солай ма?
Dialogue: 0,0:11:18.92,0:11:21.51,Default,,0,0,0,,Ұят болатын ештеңе айтпа.
Dialogue: 0,0:11:20.68,0:11:21.51,Default,,0,0,0,,Иә
Dialogue: 0,0:11:21.59,0:11:23.10,Default,,0,0,0,,Юкито
Dialogue: 0,0:11:23.18,0:11:26.31,Default,,0,0,0,,Сіз көмектесуге келдім дейсіз, бірақ бұл жерден не істеуіміз керек?
Dialogue: 0,0:11:26.72,0:11:30.60,Default,,0,0,0,,Егер сіз оны құтқару сызығынан алсаңыз, оны өмірге қайтаруыңыз мүмкін.
Dialogue: 0,0:11:30.69,0:11:32.56,Default,,0,0,0,,...Мен солай ойладым.
Dialogue: 0,0:11:32.65,0:11:33.81,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:11:33.90,0:11:35.77,Default,,0,0,0,,Мен қайдан білемін?
Dialogue: 0,0:11:35.86,0:11:39.36,Default,,0,0,0,,Жалпы айтқанда, біреуді өмірге қайтару...
Dialogue: 0,0:11:39.44,0:11:41.61,Default,,0,0,0,,Сіз алмайсыз ба? қайта тірілу
Dialogue: 0,0:11:41.70,0:11:42.53,Default,,0,0,0,,ше? (Юкито) Иә?
Dialogue: 0,0:11:42.99,0:11:45.58,Default,,0,0,0,,Құдайдың интуициясына сеніңіз
Dialogue: 0,0:11:45.66,0:11:47.58,Default,,0,0,0,,Өйткені сенде де өкініш болды.
Dialogue: 0,0:11:47.66,0:11:50.37,Default,,0,0,0,,Ол өмірлік желімен араласпай, ойнап жүрді.
Dialogue: 0,0:11:50.46,0:11:53.92,Default,,0,0,0,,Барлығы бар жерге оралғыңыз келмей ме?
Dialogue: 0,0:11:54.00,0:11:55.84,Default,,0,0,0,,Ой... жақсы...
Dialogue: 0,0:11:55.92,0:11:58.38,Default,,0,0,0,,Өмір ағымына араласқаным артық.
Dialogue: 0,0:11:58.46,0:12:00.38,Default,,0,0,0,,Дәмді тағамды көбірек жеп, ішіңіз
Dialogue: 0,0:12:00.47,0:12:01.68,Default,,0,0,0,,Менімен ұйықта
Dialogue: 0,0:12:01.76,0:12:03.30,Default,,0,0,0,,Ағаңнан ақша сұрау
Dialogue: 0,0:12:03.39,0:12:05.64,Default,,0,0,0,,Сонымен қатар ұйықтау, балық аулау, т.б.
Dialogue: 0,0:12:05.72,0:12:08.43,Default,,0,0,0,,Басқа әрекеттерді орындауға болады.
Dialogue: 0,0:12:08.52,0:12:09.81,Default,,0,0,0,,Я...
Dialogue: 0,0:12:09.89,0:12:12.35,Default,,0,0,0,,Одан артық себеп жоқ па?
Dialogue: 0,0:12:12.44,0:12:13.56,Default,,0,0,0,,Урухи
Dialogue: 0,0:12:13.65,0:12:15.86,Default,,0,0,0,,Көңілді қалаудың несі жаман?
Dialogue: 0,0:12:15.94,0:12:18.07,Default,,0,0,0,,Әйтеуір, өкінішім бар.
Dialogue: 0,0:12:18.15,0:12:19.28,Default,,0,0,0,,Мен жақында үйге барамын.
Dialogue: 0,0:12:19.36,0:12:20.40,Default,,0,0,0,,Иә
Dialogue: 0,0:12:20.49,0:12:21.53,Default,,0,0,0,,Иә
Dialogue: 0,0:12:21.61,0:12:22.86,Default,,0,0,0,,Ах... бірақ
Dialogue: 0,0:12:22.95,0:12:23.95,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:12:24.03,0:12:26.20,Default,,0,0,0,,Мен осы уақытқа дейін қарқынмен келдім.
Dialogue: 0,0:12:26.28,0:12:28.66,Default,,0,0,0,,Мен қай арал екенін білмеймін.
Dialogue: 0,0:12:28.74,0:12:30.16,Default,,0,0,0,,Міне, бастаймыз!
Dialogue: 0,0:12:30.25,0:12:33.17,Default,,0,0,0,,Бұл өмір жолында адасу деген сөз тіркесі емес.
Dialogue: 0,0:12:33.25,0:12:34.67,Default,,0,0,0,,Әкеңіз ше?
Dialogue: 0,0:12:34.75,0:12:35.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:36.38,0:12:38.04,Default,,0,0,0,,Юкито ішке секірген кезде
Dialogue: 0,0:12:38.13,0:12:40.63,Default,,0,0,0,,Менің мөрімді сындырдың.
Dialogue: 0,0:12:41.17,0:12:43.43,Default,,0,0,0,,Осыған байланысты аралдың орналасқан жері
Dialogue: 0,0:12:43.51,0:12:44.97,Default,,0,0,0,,Мен мұны білдім
Dialogue: 0,0:12:45.05,0:12:45.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:45.97,0:12:48.56,Default,,0,0,0,,Юкито, сен мен үшін не істеп жатырсың!
Dialogue: 0,0:12:48.64,0:12:50.47,Default,,0,0,0,,Джинги осылай құтқарылуда.
Dialogue: 0,0:12:50.56,0:12:52.23,Default,,0,0,0,,Біз келгендіктен.
Dialogue: 0,0:12:52.31,0:12:54.56,Default,,0,0,0,,Иә, үрейленбеңіз.
Dialogue: 0,0:12:54.64,0:12:56.73,Default,,0,0,0,,Шамамен 4 жылдан 50 жылға дейін қаңғыған соң
Dialogue: 0,0:12:56.81,0:12:59.44,Default,,0,0,0,,Бір жерден басқа шығу жолын табатыныңызға сенімдімін.
Dialogue: 0,0:12:59.52,0:13:02.40,Default,,0,0,0,,Олай болса, бұлай сөйлесуді тоқтата аласыз ба?
Dialogue: 0,0:13:02.86,0:13:04.78,Default,,0,0,0,,Тез қайтпасам, денем күлге айналады...
Dialogue: 0,0:13:04.86,0:13:05.74,Default,,0,0,0,,Тыныш.
Dialogue: 0,0:13:05.82,0:13:06.95,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:13:07.70,0:13:08.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:11.58,0:13:12.58,Default,,0,0,0,,Сол жерде
Dialogue: 0,0:13:12.66,0:13:13.91,Default,,0,0,0,,Джинги мырза, кеттік.
Dialogue: 0,0:13:14.00,0:13:15.29,Default,,0,0,0,,Жақсы болатынына сенімдімін.
Dialogue: 0,0:13:15.37,0:13:16.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:20.30,0:13:21.42,Default,,0,0,0,,Иә
Dialogue: 0,0:13:24.80,0:13:26.26,Default,,0,0,0,,Алыс...
Dialogue: 0,0:13:30.18,0:13:31.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:32.06,0:13:34.60,Default,,0,0,0,,Түсірілді! Юкихито мырза
Dialogue: 0,0:13:34.68,0:13:35.60,Default,,0,0,0,,Курама мырза?
Dialogue: 0,0:13:35.69,0:13:36.77,Default,,0,0,0,,Юкито
Dialogue: 0,0:13:36.85,0:13:40.44,Default,,0,0,0,,Маған сіздің ниетіңіз маңызды емес, бірақ сіз қайтуыңыз керек.
Dialogue: 0,0:13:40.52,0:13:41.61,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:13:41.69,0:13:43.11,Default,,0,0,0,,Сол бейбақ...
Dialogue: 0,0:13:43.19,0:13:44.95,Default,,0,0,0,,Юкито Янаги
Dialogue: 0,0:13:46.11,0:13:48.37,Default,,0,0,0,,Міне... Мен күтіп тұрмын.
Dialogue: 0,0:13:49.74,0:13:50.99,Default,,0,0,0,,Ах
Dialogue: 0,0:13:52.66,0:13:54.12,Default,,0,0,0,,Бауырлар...
Dialogue: 0,0:13:54.20,0:13:56.75,Default,,0,0,0,,Сіз мені шығуға дейін тартқыңыз келе ме?
Dialogue: 0,0:13:57.83,0:13:59.25,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:13:59.75,0:14:03.00,Default,,0,0,0,,Олар менің ініме әлі де мейірімді.
Dialogue: 0,0:14:03.67,0:14:06.17,Default,,0,0,0,,Міне, отбасы деген осындай.
Dialogue: 0,0:14:07.63,0:14:09.89,Default,,0,0,0,,Иә, мен бұл туралы айтуды ұмытып кетіппін.
Dialogue: 0,0:14:10.43,0:14:12.72,Default,,0,0,0,,Жарайсың Джинги
Dialogue: 0,0:14:12.81,0:14:14.43,Default,,0,0,0,,Мастер...
Dialogue: 0,0:14:14.52,0:14:17.14,Default,,0,0,0,,Екеуің кездескенше.
Dialogue: 0,0:14:17.23,0:14:18.31,Default,,0,0,0,,Ах
Dialogue: 0,0:14:18.40,0:14:20.52,Default,,0,0,0,,Ұстаз! Ұстаз да...
Dialogue: 0,0:14:21.15,0:14:23.94,Default,,0,0,0,,Мен мұнда тым көп болдым
Dialogue: 0,0:14:24.03,0:14:26.15,Default,,0,0,0,,Мен сені қазір тастап кете алмаймын
Dialogue: 0,0:14:26.24,0:14:30.82,Default,,0,0,0,,Тіпті жалғыз отты айдаһарды да тыныштандыру керек.
Dialogue: 0,0:14:30.91,0:14:33.95,Default,,0,0,0,,Балам, сенімен сөйлесу бір ғанибет болды.
Dialogue: 0,0:14:34.04,0:14:36.50,Default,,0,0,0,,Ақылсыз ағаларымды сұраймын.
Dialogue: 0,0:14:37.08,0:14:37.96,Default,,0,0,0,,Сенде ондай мақсат болса да…
Dialogue: 0,0:14:38.04,0:14:38.87,Default,,0,0,0,,Юкито
Dialogue: 0,0:14:38.96,0:14:40.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:43.67,0:14:46.34,Default,,0,0,0,,Джинги мырза, қолымды жібермеңіз.
Dialogue: 0,0:14:46.42,0:14:49.05,Default,,0,0,0,,Айттым ғой, өкініш бар.
Dialogue: 0,0:14:49.13,0:14:50.47,Default,,0,0,0,,Кім жібереді?
Dialogue: 0,0:14:51.39,0:14:52.93,Default,,0,0,0,,Бір күні кездескенше
Dialogue: 0,0:14:53.01,0:14:54.31,Default,,0,0,0,,Әке.
Dialogue: 0,0:14:55.85,0:14:57.14,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:15:00.23,0:15:01.65,Default,,0,0,0,,Сіз мұны істей аласыз ба? Вермилион
Dialogue: 0,0:15:01.73,0:15:03.73,Default,,0,0,0,,Орындаймын, Көктем мен Күз
Dialogue: 0,0:15:11.32,0:15:14.62,Default,,0,0,0,,Ооооооооо...
Dialogue: 0,0:15:18.33,0:15:19.87,Default,,0,0,0,,Жарайды ма? Бұл
Dialogue: 0,0:15:19.96,0:15:21.25,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,0:15:21.33,0:15:23.96,Default,,0,0,0,,Бірақ мен Курама-санмен байланысты сезінемін.
Dialogue: 0,0:15:24.04,0:15:25.25,Default,,0,0,0,,Ауырса да
Dialogue: 0,0:15:25.34,0:15:26.88,Default,,0,0,0,,Зенитсу неге қылышын шешпей жатқанын түсінбейсің бе?
Dialogue: 0,0:15:26.96,0:15:29.42,Default,,0,0,0,,Бұл ағын да байланысты... Ах...
Dialogue: 0,0:15:33.89,0:15:34.89,Default,,0,0,0,,Ибуки мырза!
Dialogue: 0,0:15:34.97,0:15:37.06,Default,,0,0,0,,Уау...
Dialogue: 0,0:15:37.85,0:15:39.39,Default,,0,0,0,,Басқаша айтқанда, бұл сенің махаббатыңның күші
Dialogue: 0,0:15:39.48,0:15:41.31,Default,,0,0,0,,Бұл жолы
Dialogue: 0,0:15:42.40,0:15:44.19,Default,,0,0,0,,Мен саған көмектесемін!
Dialogue: 0,0:15:44.27,0:15:49.15,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:15:49.86,0:15:50.82,Default,,0,0,0,,Шексіз міндет
Dialogue: 0,0:15:51.36,0:15:52.99,Default,,0,0,0,,Юкито Янаги…
Dialogue: 0,0:15:53.07,0:15:54.62,Default,,0,0,0,,Қайта оралыңыз
Dialogue: 0,0:15:54.70,0:15:56.16,Default,,0,0,0,,Юкито!
Dialogue: 0,0:15:56.24,0:15:58.79,Default,,0,0,0,,Ууууууууу...
Dialogue: 0,0:16:01.50,0:16:03.00,Default,,0,0,0,,…қашып кету…
Dialogue: 0,0:16:04.50,0:16:05.59,Default,,0,0,0,,Уау (енді) Уау
Dialogue: 0,0:16:05.67,0:16:07.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:07.42,0:16:09.38,Default,,0,0,0,,Эй (Юкито) Иә?
Dialogue: 0,0:16:11.26,0:16:12.13,Default,,0,0,0,,Ах
Dialogue: 0,0:16:13.13,0:16:15.22,Default,,0,0,0,,Сіз кетесіз бе?
Dialogue: 0,0:16:15.30,0:16:18.22,Default,,0,0,0,,Сіз отты айдаһарсыз ба?
Dialogue: 0,0:16:18.31,0:16:19.56,Default,,0,0,0,,Иә
Dialogue: 0,0:16:20.43,0:16:22.23,Default,,0,0,0,,Осы аралда тұру
Dialogue: 0,0:16:22.31,0:16:24.35,Default,,0,0,0,,Мен міндетті түрде қайта ораламын.
Dialogue: 0,0:16:24.90,0:16:26.82,Default,,0,0,0,,Мен Юкито Янагимін
Dialogue: 0,0:16:26.90,0:16:28.44,Default,,0,0,0,,Вена байланысы бар
Dialogue: 0,0:16:28.53,0:16:30.03,Default,,0,0,0,,Өйткені бұл су айдаһары
Dialogue: 0,0:16:30.36,0:16:32.03,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:16:32.11,0:16:33.61,Default,,0,0,0,,Күту
Dialogue: 0,0:16:36.16,0:16:37.62,Default,,0,0,0,,Рахмет
Dialogue: 0,0:16:40.33,0:16:43.46,Default,,0,0,0,,Юкито!
Dialogue: 0,0:16:45.17,0:16:46.33,Default,,0,0,0,,Қарғыс атсын... (Юкито) А...
Dialogue: 0,0:17:03.64,0:17:05.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:05.19,0:17:07.11,Default,,0,0,0,,Юкито! (Яко) Юкито
Dialogue: 0,0:17:12.28,0:17:14.40,Default,,0,0,0,,Білмеймін, бірақ оның жағдайы өте ауыр сияқты
Dialogue: 0,0:17:14.49,0:17:15.32,Default,,0,0,0,,Иә
Dialogue: 0,0:17:15.41,0:17:17.20,Default,,0,0,0,,Құтқару жіпіне секіру
Dialogue: 0,0:17:17.28,0:17:18.74,Default,,0,0,0,,Мүлдем шектен шыққан
Dialogue: 0,0:17:18.83,0:17:20.16,Default,,0,0,0,,Мен уайымдадым.
Dialogue: 0,0:17:20.24,0:17:22.00,Default,,0,0,0,,Өйткені бұл су айдаһары
Dialogue: 0,0:17:22.08,0:17:24.08,Default,,0,0,0,,Жақсылық пен жамандық бар.
Dialogue: 0,0:17:24.46,0:17:26.12,Default,,0,0,0,,Бұл жаман
Dialogue: 0,0:17:26.21,0:17:28.04,Default,,0,0,0,,Сиқыр формуласын ашу
Dialogue: 0,0:17:28.13,0:17:30.46,Default,,0,0,0,,Юкито-кун, бұл
Dialogue: 0,0:17:31.30,0:17:32.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:46.02,0:17:48.35,Default,,0,0,0,,А, мен шөлдеп тұрмын.
Dialogue: 0,0:17:48.44,0:17:49.77,Default,,0,0,0,,Джи... Джинги-чан?
Dialogue: 0,0:17:50.44,0:17:52.86,Default,,0,0,0,,А... Момоко-сан, маған сусын берші.
Dialogue: 0,0:17:52.94,0:17:54.53,Default,,0,0,0,,Жаназада сол ғой, солай ма?
Dialogue: 0,0:17:54.61,0:17:57.36,Default,,0,0,0,,Момоко-сан, қалғанын өзім шешемін...
Dialogue: 0,0:17:57.45,0:17:59.03,Default,,0,0,0,,Ах... (Инао) Уау!
Dialogue: 0,0:17:59.12,0:18:00.49,Default,,0,0,0,,Менің атым Дарио Брандо.
Dialogue: 0,0:18:00.58,0:18:02.79,Default,,0,0,0,,Ал... Сіз адасып қалдыңыз ба? Шиги!
Dialogue: 0,0:18:02.87,0:18:06.29,Default,,0,0,0,,Ха... Масато! Бұл сіздің кінәңіз бе?
Dialogue: 0,0:18:06.37,0:18:08.08,Default,,0,0,0,,Бұл сен кінәлісің!
Dialogue: 0,0:18:08.17,0:18:10.79,Default,,0,0,0,,Момоко-сан, маған бір бөтелке бер.
Dialogue: 0,0:18:08.17,0:18:12.25,Default,,0,0,0,,(Инао шулы дауысы)
Dialogue: 0,0:18:10.88,0:18:12.25,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:18:16.72,0:18:20.14,Default,,0,0,0,,Өмірге қайта оралыңыз
Dialogue: 0,0:18:20.60,0:18:22.22,Default,,0,0,0,,Неміс медицинасы мен ғылымында осындай нәрселер бар шығар—
Dialogue: 0,0:18:22.31,0:18:24.18,Default,,0,0,0,,(Экипаж мүшесі 1) Жұмысты жалғастырып, қазынаны көрсекші.
Dialogue: 0,0:18:24.27,0:18:26.77,Default,,0,0,0,,Джинги мырза қайтып келді.
Dialogue: 0,0:18:26.85,0:18:28.48,Default,,0,0,0,,Сіз шынымен жарақат алған жоқсыз ба?
Dialogue: 0,0:18:28.56,0:18:29.60,Default,,0,0,0,,Е...күте тұрыңыз.
Dialogue: 0,0:18:29.69,0:18:31.06,Default,,0,0,0,,Міне, бастаймыз!
Dialogue: 0,0:18:31.15,0:18:33.90,Default,,0,0,0,,Әр бұрышты тексермейінше көңілім толмайды.
Dialogue: 0,0:18:34.36,0:18:37.32,Default,,0,0,0,,Әрине мен сізді алаңдаттым.
Dialogue: 0,0:18:37.40,0:18:38.57,Default,,0,0,0,,Аха…
Dialogue: 0,0:18:39.16,0:18:41.74,Default,,0,0,0,,Барлығыңызға рахмет
Dialogue: 0,0:18:42.66,0:18:43.91,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:18:44.37,0:18:46.75,Default,,0,0,0,,Иә (Чатаро) Қайтадан қош келдіңіз.
Dialogue: 0,0:18:46.83,0:18:48.46,Default,,0,0,0,,Юкито-кун қош келдіңіз
Dialogue: 0,0:18:49.04,0:18:50.71,Default,,0,0,0,,Мен сізге алғыс айтпаймын.
Dialogue: 0,0:18:50.79,0:18:53.75,Default,,0,0,0,,Мен мұны маған рахмет айту үшін жасаған жоқпын.
Dialogue: 0,0:18:54.25,0:18:55.71,Default,,0,0,0,,Әлі де...
Dialogue: 0,0:18:55.80,0:18:59.05,Default,,0,0,0,,Біз бұл жолы дәл уақытында жасаған сияқтымыз.
Dialogue: 0,0:18:59.51,0:19:01.97,Default,,0,0,0,,Мен әлсіз жеңілген болсам да
Dialogue: 0,0:19:02.47,0:19:05.85,Default,,0,0,0,,Бірлігіміз жараса, сонша күресе аламыз.
Dialogue: 0,0:19:06.81,0:19:09.44,Default,,0,0,0,,Бұл мүлдем адал емес.
Dialogue: 0,0:19:10.31,0:19:13.06,Default,,0,0,0,,Бауырлар, бәріміз бірге
Dialogue: 0,0:19:14.44,0:19:16.69,Default,,0,0,0,,Ауырды... Ауырады.
Dialogue: 0,0:19:16.78,0:19:19.86,Default,,0,0,0,,Ауырды, Инудың қарт.
Dialogue: 0,0:19:19.95,0:19:23.45,Default,,0,0,0,,Міне, осы сағатта да жиналдың.
Dialogue: 0,0:19:23.53,0:19:24.49,Default,,0,0,0,,Түсіндіріңіз
Dialogue: 0,0:19:24.58,0:19:25.87,Default,,0,0,0,,Не? Ал...
Dialogue: 0,0:19:25.95,0:19:27.33,Default,,0,0,0,,Арнау! (Шексіз) Ах...
Dialogue: 0,0:19:28.75,0:19:30.67,Default,,0,0,0,,Арнау! (Джиёши) Уау...
Dialogue: 0,0:19:30.75,0:19:32.92,Default,,0,0,0,,Өлсем де өлмеймін деп ойладым.
Dialogue: 0,0:19:33.00,0:19:34.92,Default,,0,0,0,,Бұл не? (Осы үй) Ақымақ.
Dialogue: 0,0:19:35.00,0:19:37.05,Default,,0,0,0,,Қазірден бастап ішейік.
Dialogue: 0,0:19:37.13,0:19:40.05,Default,,0,0,0,,Мен тірімін... Мен шынымен тірімін
Dialogue: 0,0:19:40.13,0:19:41.26,Default,,0,0,0,,Бұл арман емес.
Dialogue: 0,0:19:41.34,0:19:42.64,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:43.05,0:19:44.51,Default,,0,0,0,,Арнау!
Dialogue: 0,0:19:44.60,0:19:46.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:46.14,0:19:47.97,Default,,0,0,0,,♪～
Dialogue: 0,0:19:46.14,0:19:47.97,Default,,0,0,0,,Қа~!
Dialogue: 0,0:19:48.06,0:19:49.52,Default,,0,0,0,,Азуки-чанды ауыстыру
Dialogue: 0,0:19:48.93,0:19:51.85,Default,,0,0,0,,Осыдан кейін бәрі қалыпты болды.
Dialogue: 0,0:19:49.60,0:19:51.85,Default,,0,0,0,,Мен де (тұрғылықты жерім) Мен де
Dialogue: 0,0:19:51.94,0:19:53.98,Default,,0,0,0,,Күндер өтті
Dialogue: 0,0:19:52.44,0:19:53.98,Default,,0,0,0,,Балалар
Dialogue: 0,0:19:54.06,0:19:55.61,Default,,0,0,0,,Мен не айтамын?
Dialogue: 0,0:19:55.69,0:19:57.40,Default,,0,0,0,,Міне, күндіз, сондықтан...
Dialogue: 0,0:19:57.48,0:19:59.03,Default,,0,0,0,,О, жарайды, жарайды.
Dialogue: 0,0:19:59.11,0:20:00.45,Default,,0,0,0,,Адамдар қашан өледі?
Dialogue: 0,0:20:02.70,0:20:05.53,Default,,0,0,0,,Адамдар, өзіңе ұнайтыныңды істе!
Dialogue: 0,0:20:05.62,0:20:07.08,Default,,0,0,0,,Сіз тым көп ойнап жатырсыз, солай емес пе?
Dialogue: 0,0:20:07.16,0:20:08.58,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:20:08.66,0:20:09.83,Default,,0,0,0,,Не!
Dialogue: 0,0:20:09.91,0:20:12.42,Default,,0,0,0,,Мен өзіме ұнайтын нәрсені істеймін, өйткені мен қалағанмын.
Dialogue: 0,0:20:10.29,0:20:14.50,Default,,0,0,0,,Бұл аралда бұл қалыпты жағдай.
Dialogue: 0,0:20:17.92,0:20:19.13,Default,,0,0,0,,Түсіруді тоқтатыңыз!
Dialogue: 0,0:20:24.68,0:20:26.01,Default,,0,0,0,,Джинчи Тендо
Dialogue: 0,0:20:27.51,0:20:31.10,Default,,0,0,0,,Дүниедегі ең жұмсақ, ең қатты.
Dialogue: 0,0:20:31.18,0:20:33.35,Default,,0,0,0,,Ештеңе жоқтыққа енеді
Dialogue: 0,0:20:40.28,0:20:41.11,Default,,0,0,0,,Олар сіздің жағдайыңызды өздеріне тапсыруымды сұрады.
Dialogue: 0,0:20:41.19,0:20:42.90,Default,,0,0,0,,Бүгін ме? Ибара
Dialogue: 0,0:20:42.99,0:20:43.82,Default,,0,0,0,,О
Dialogue: 0,0:20:43.91,0:20:45.20,Default,,0,0,0,,Қазір ерте.
Dialogue: 0,0:20:45.28,0:20:46.91,Default,,0,0,0,,Сол тікенектер...
Dialogue: 0,0:20:47.37,0:20:48.83,Default,,0,0,0,,Өтінемін, рұқсат етші.
Dialogue: 0,0:20:48.91,0:20:50.04,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:20:50.12,0:20:53.04,Default,,0,0,0,,Жарайды, бастық та қызық шығар, солай ма?
Dialogue: 0,0:20:53.12,0:20:54.29,Default,,0,0,0,,Бөлек
Dialogue: 0,0:20:55.71,0:20:57.34,Default,,0,0,0,,Фу… фуфу
Dialogue: 0,0:20:57.42,0:20:58.96,Default,,0,0,0,,Басқа жөнелтілім болмаса
Dialogue: 0,0:20:59.05,0:21:00.46,Default,,0,0,0,,Мүмкін біз оны уақытында жасаймыз.
Dialogue: 0,0:21:00.55,0:21:02.47,Default,,0,0,0,,Бұл В ауданындағы Арамитама!
Dialogue: 0,0:21:02.55,0:21:03.42,Default,,0,0,0,,Кеттік
Dialogue: 0,0:21:03.51,0:21:04.80,Default,,0,0,0,,Қарсылас – Sparking Killing Boy!
Dialogue: 0,0:21:08.39,0:21:09.97,Default,,0,0,0,,Бастық, сізді шынымен қызықтырады ма?
Dialogue: 0,0:21:10.06,0:21:12.02,Default,,0,0,0,,Сол күндерде
Dialogue: 0,0:21:11.35,0:21:12.73,Default,,0,0,0,,Аа, бастық, олай емес.
Dialogue: 0,0:21:12.10,0:21:15.56,Default,,0,0,0,,Мен де осы аралда «қалыпты» өмір сүріп жатырмын.
Dialogue: 0,0:21:12.81,0:21:13.89,Default,,0,0,0,,Урусее (Такида) Қарашы, мен білдім.
Dialogue: 0,0:21:13.98,0:21:15.56,Default,,0,0,0,,Сіз уайымдайсыз ба?
Dialogue: 0,0:21:15.65,0:21:16.52,Default,,0,0,0,,Сәлем, бастық
Dialogue: 0,0:21:17.06,0:21:17.90,Default,,0,0,0,,О.
Dialogue: 0,0:21:17.98,0:21:20.02,Default,,0,0,0,,Сіздің шәкірттеріңіз де сондай ма?
Dialogue: 0,0:21:20.11,0:21:21.03,Default,,0,0,0,,Иә
Dialogue: 0,0:21:21.11,0:21:22.65,Default,,0,0,0,,Менің барғым келді.
Dialogue: 0,0:21:22.74,0:21:25.61,Default,,0,0,0,,«Мұғалім, бар күшіңізді салыңыз.»
Dialogue: 0,0:21:25.70,0:21:26.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:26.91,0:21:28.32,Default,,0,0,0,,Бұл бонус.
Dialogue: 0,0:21:28.41,0:21:31.45,Default,,0,0,0,,Әй, рахмет сізге әдеттегідей.
Dialogue: 0,0:21:31.54,0:21:34.04,Default,,0,0,0,,Жоқ, абай болыңыз.
Dialogue: 0,0:21:39.79,0:21:41.00,Default,,0,0,0,,Бұл…
Dialogue: 0,0:21:41.09,0:21:43.38,Default,,0,0,0,,Менің жалғыз орным
Dialogue: 0,0:21:43.80,0:21:44.97,Default,,0,0,0,,Аяка аралында
Dialogue: 0,0:21:45.05,0:21:47.55,Default,,0,0,0,,Сондай-ақ... Момоко-сан, сен қалай ойлайсың?
Dialogue: 0,0:21:47.97,0:21:48.85,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:21:48.93,0:21:51.22,Default,,0,0,0,,Сен керемет көрінесің, Юкито-кун.
Dialogue: 0,0:21:51.31,0:21:53.27,Default,,0,0,0,,Ах... Рахмет.
Dialogue: 0,0:21:53.35,0:21:55.31,Default,,0,0,0,,Бұл ерекше шуақты кезең.
Dialogue: 0,0:21:55.39,0:21:57.90,Default,,0,0,0,,Мен оны бейнекамераға тамаша орналастыруым керек.
Dialogue: 0,0:21:57.98,0:22:00.19,Default,,0,0,0,,Бұл ұят нәрсе.
Dialogue: 0,0:22:00.27,0:22:02.61,Default,,0,0,0,,Дәл орта мектеп формасы сияқты
Dialogue: 0,0:22:02.69,0:22:04.78,Default,,0,0,0,,Хехе, асыра сілтеу.
Dialogue: 0,0:22:04.86,0:22:05.70,Default,,0,0,0,,Я...
Dialogue: 0,0:22:09.57,0:22:10.66,Default,,0,0,0,,Олай болса, әке.
Dialogue: 0,0:22:11.70,0:22:13.08,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:22:14.54,0:22:15.37,Default,,0,0,0,,Иә
Dialogue: 0,0:22:15.46,0:22:17.71,Default,,0,0,0,,Юкито-кун, сен ештеңе ұмыттың ба?
Dialogue: 0,0:22:17.79,0:22:19.79,Default,,0,0,0,,Бет астында ғаламдық державалар қатал ақпараттық соғыстар жүргізетін дәуірде
Dialogue: 0,0:22:19.88,0:22:22.55,Default,,0,0,0,,Кууу хахахаха
Dialogue: 0,0:22:29.30,0:22:31.76,Default,,0,0,0,,Сәлем, Юкито! (Юкито) Иә.
Dialogue: 0,0:22:31.85,0:22:33.68,Default,,0,0,0,,Мұнда
Dialogue: 0,0:22:33.77,0:22:35.64,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз.
Dialogue: 0,0:22:35.73,0:22:38.94,Default,,0,0,0,,Иә? Юкито-кун, сен мектепке теңіз пойызымен барасың ба?
Dialogue: 0,0:22:39.02,0:22:40.73,Default,,0,0,0,,Иә, бірақ
Dialogue: 0,0:22:40.81,0:22:42.52,Default,,0,0,0,,Ұшып кетеді деп ойладым.
Dialogue: 0,0:22:42.61,0:22:44.11,Default,,0,0,0,,Мен мұны істемеймін.
Dialogue: 0,0:22:44.19,0:22:46.40,Default,,0,0,0,,Хахахаха әзіл әзіл
Dialogue: 0,0:22:46.78,0:22:48.40,Default,,0,0,0,,Юкито жапырақшалары бекітілген
Dialogue: 0,0:22:48.49,0:22:49.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:50.82,0:22:53.16,Default,,0,0,0,,Рахмет, Ичиджо мырза.
Dialogue: 0,0:22:53.74,0:22:56.29,Default,,0,0,0,,Форма саған жарасады деп ойлаймын.
Dialogue: 0,0:22:56.37,0:22:57.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:57.29,0:22:59.58,Default,,0,0,0,,Түні бойы ұйықтамаған Ино мырза сияқты.
Dialogue: 0,0:22:59.67,0:23:01.46,Default,,0,0,0,,Мақтап жатқан жоқсың ба?
Dialogue: 0,0:23:01.46,0:23:02.46,Default,,0,0,0,,Не дедің!
Dialogue: 0,0:23:02.54,0:23:04.05,Default,,0,0,0,,Аня әлі ұйықтап жатыр ма?
Dialogue: 0,0:23:04.13,0:23:05.63,Default,,0,0,0,,Міне, осы
Dialogue: 0,0:23:05.71,0:23:08.22,Default,,0,0,0,,Қараңдаршы, сынып кестесі ілінді.
Dialogue: 0,0:23:05.71,0:23:10.22,Default,,0,0,0,,Сыныбыңызды тексеріп, сыныпқа барыңыз.
Dialogue: 0,0:23:08.30,0:23:10.80,Default,,0,0,0,,Ой, сен қатты қобалжыдың.
Dialogue: 0,0:23:12.05,0:23:14.31,Default,,0,0,0,,Ичиджо мырза, кеттік.
Dialogue: 0,0:23:14.39,0:23:15.22,Default,,0,0,0,,Иә
Dialogue: 0,0:23:18.60,0:23:19.85,Default,,0,0,0,,Құрметті
Dialogue: 0,0:23:19.94,0:23:21.69,Default,,0,0,0,,Уф!
Dialogue: 0,0:23:21.77,0:23:23.69,Default,,0,0,0,,қарқынды көңіл көтеру
Dialogue: 0,0:23:24.27,0:23:25.57,Default,,0,0,0,,Ақылсыз
Dialogue: 0,0:23:26.07,0:23:28.03,Default,,0,0,0,,Әртүрлі заттар араласады
Dialogue: 0,0:23:29.70,0:23:31.49,Default,,0,0,0,,Ал дегенмен!
Dialogue: 0,0:23:32.41,0:23:34.41,Default,,0,0,0,,Аякай аралында
Dialogue: 0,0:23:34.49,0:23:39.37,Default,,0,0,0,,～♪
Dialogue: 0,0:23:40.87,0:23:46.87,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
