Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,12:48:08.10,12:48:23.09,Default,,0,0,0,,♪♪~
Dialogue: 0,12:48:23.09,12:48:25.09,Default,,0,0,0,,《Эйджун: Крис Сенпай...》
Dialogue: 0,12:51:09.06,12:51:13.11,Default,,0,0,0,,Савамура жігіт, сен Криске қатал бола аласың ба?
Dialogue: 0,12:51:13.11,12:51:18.09,Default,,0,0,0,,Бұл оның зейнеткерлікке шығуы болса да, оның оған деген сезімі ерекше екеніне сенімдімін.
Dialogue: 0,12:51:18.09,12:51:20.62,Default,,0,0,0,,А, Савамура осы жазда→
Dialogue: 0,12:51:20.62,12:51:23.81,Default,,0,0,0,,Ол мені бірінші командада белсенді рөл атқара алатын құмыраға көтерді→
Dialogue: 0,12:51:23.81,12:51:26.11,Default,,0,0,0,,Өйткені ол менің тәлімгерім, былайша айтқанда.
Dialogue: 0,12:51:32.43,12:51:35.12,Default,,0,0,0,,《Канамару: Крис-сенпай...》
Dialogue: 0,12:51:35.12,12:51:38.09,Default,,0,0,0,,((Крис: Бұл құлдыраудан үлкен секіріске →
Dialogue: 0,12:51:38.09,12:51:40.27,Default,,0,0,0,,Мен оны өзгертетініңізге сенемін.
Dialogue: 0,12:51:40.27,12:51:42.64,Default,,0,0,0,,Ол сондай жігіт.
Dialogue: 0,12:51:42.64,12:51:44.74,Default,,0,0,0,,Әлгі жігіт))
Dialogue: 0,12:51:51.30,12:51:53.60,Default,,0,0,0,,《Миюки: Егер мұндай мүмкіндік болмаса→
Dialogue: 0,12:51:53.60,12:51:56.27,Default,,0,0,0,,Қатты ұрысуға болмайды.
Dialogue: 0,12:51:56.27,12:51:58.94,Default,,0,0,0,,Савамура….
Dialogue: 0,12:51:58.94,12:52:02.56,Default,,0,0,0,,Сіз жасай алатын жалғыз нәрсе - ең жақсы →
Dialogue: 0,12:52:02.56,12:52:05.62,Default,,0,0,0,,Мен бұл адамға жауап бере алмаймын.
Dialogue: 0,12:52:05.62,12:52:22.08,Default,,0,0,0,,♪♪~
Dialogue: 0,12:52:22.08,12:52:26.29,Default,,0,0,0,,《Мен қандай ақымақ болдым...》
Dialogue: 0,12:52:26.29,12:52:33.44,Default,,0,0,0,,((Алайда, бұл қызық доп сіздің ең күшті күшіңіз.
Dialogue: 0,12:52:33.44,12:52:36.41,Default,,0,0,0,,Мына қызық шарды жылтыратыңыз))
Dialogue: 0,12:52:36.41,12:52:40.94,Default,,0,0,0,,《Ол құмыра ретінде қаншалықты жетілмеген?》
Dialogue: 0,12:52:40.94,12:52:43.72,Default,,0,0,0,,((Уайымдамаңыз, жоғары мақсат қойыңыз.
Dialogue: 0,12:52:43.72,12:52:47.81,Default,,0,0,0,,Сізде әлі көп жол бар))
Dialogue: 0,12:52:47.81,12:52:50.41,Default,,0,0,0,,《Оны маған үйреткен...》
Dialogue: 0,12:53:00.45,12:53:02.75,Default,,0,0,0,,《Мен кешіктім...》
Dialogue: 0,12:53:08.28,12:53:10.45,Default,,0,0,0,,Оны жарғанақтан көру қиынырақ.
Dialogue: 0,12:53:10.45,12:53:12.45,Default,,0,0,0,,Ортаға дерлік.
Dialogue: 0,12:53:15.32,12:53:18.12,Default,,0,0,0,,《Доптың жылдамдығы 130км/сағ аз.
Dialogue: 0,12:53:18.12,12:53:20.92,Default,,0,0,0,,Бірақ енгізілген түзу》
Dialogue: 0,12:53:26.28,12:53:29.92,Default,,0,0,0,,《Крис: Мен жарғанатқа тұрғанда тағы да есіме түсті.
Dialogue: 0,12:53:29.92,12:53:33.10,Default,,0,0,0,,Сіз қандай құмырасыз?
Dialogue: 0,12:53:33.10,12:53:39.39,Default,,0,0,0,,Доп сөзден гөрі қаттырақ сөйлейді.
Dialogue: 0,12:53:39.39,12:53:52.56,Default,,0,0,0,,♪♪~
Dialogue: 0,12:53:52.56,12:53:54.61,Default,,0,0,0,,Доп!
Dialogue: 0,12:53:54.61,12:53:57.58,Default,,0,0,0,,Қазір жақсы емес пе?
Dialogue: 0,12:53:57.58,12:53:59.63,Default,,0,0,0,,Савамура үшін...
Dialogue: 0,12:53:59.63,12:54:02.43,Default,,0,0,0,,Керемет доп! Жақсы курс келе жатыр!
Dialogue: 0,12:54:02.43,12:54:06.40,Default,,0,0,0,,Бұл үкім қатал болды.
Dialogue: 0,12:54:06.40,12:54:11.00,Default,,0,0,0,,Егер сіз қазір не болып жатқанын бағалай алсаңыз, Крис-сенпай.
Dialogue: 0,12:54:14.80,12:54:20.10,Default,,0,0,0,,Жоқ... Мен оған көмектесе алмадым.
Dialogue: 0,12:54:24.64,12:54:28.14,Default,,0,0,0,,《Осы жерде сияқты...》
Dialogue: 0,12:54:34.15,12:54:37.18,Default,,0,0,0,,Біраз уақыттан бері көп нәрсе болған жоқ па?
Dialogue: 0,12:54:37.18,12:54:40.94,Default,,0,0,0,,Иә, Миюки осылай жетекшілік етеді.
Dialogue: 0,12:54:40.94,12:54:46.86,Default,,0,0,0,,Мен курсқа дайын емеспін, бірақ Крис соға алмады ма?
Dialogue: 0,12:54:46.86,12:54:50.11,Default,,0,0,0,,Бастапқыда доптың өзі ерекше түр болды.
Dialogue: 0,12:54:50.11,12:54:53.48,Default,,0,0,0,,Якушимен жекпе-жекте соққыға жығылдым, бірақ→
Dialogue: 0,12:54:53.48,12:54:58.77,Default,,0,0,0,,Қалған кездесулердің көпшілігінде мен қарсыласымды басқардым.
Dialogue: 0,12:54:58.77,12:55:03.43,Default,,0,0,0,,《Очиай: Бірақ сіз оны ішкі курсқа лақтыра алмайсыз, солай ма?
Dialogue: 0,12:55:03.43,12:55:06.93,Default,,0,0,0,,Егер курста жұмыс істемесе, курстан тыс.
Dialogue: 0,12:55:06.93,12:55:09.75,Default,,0,0,0,,Мен сабанға ілгім келеді. Мен сіздің сезіміңізді түсінемін, бірақ →
Dialogue: 0,12:55:09.75,12:55:14.75,Default,,0,0,0,,Кем дегенде, оны ешбір бақылаусыз сыртқа лақтыруға болады》
Dialogue: 0,12:55:18.61,12:55:22.61,Default,,0,0,0,,《Тез... қазір сезінгеніңізді қайталаңыз》
Dialogue: 0,12:55:22.61,12:55:26.42,Default,,0,0,0,,《Кездейсоқ шешілетін курста ешқандай мән жоқ.
Dialogue: 0,12:55:26.42,12:55:29.79,Default,,0,0,0,,Мені тоқтатқыңыз келсе, ағымдағы допты пайдаланыңыз →
Dialogue: 0,12:55:29.79,12:55:33.11,Default,,0,0,0,,Қайта лақтырып көріңіз! 》
Dialogue: 0,12:55:33.11,12:55:36.76,Default,,0,0,0,,《Бір нүктеге шоғырлану.
Dialogue: 0,12:55:36.76,12:55:43.76,Default,,0,0,0,,Денеңіздегі барлық жүйкелер саусақ ұшына келеді! 》
Dialogue: 0,12:55:48.44,12:55:54.09,Default,,0,0,0,,((Оң жақ соққышының кеудесін ойып алған биіктікке жауап ретінде→
Dialogue: 0,12:55:54.09,12:55:59.39,Default,,0,0,0,,Батырдың көзінен ең алыс жерден өтетін заңсыздық))
Dialogue: 0,12:56:11.45,12:56:14.43,Default,,0,0,0,,((Крис: Егер сіз оны дәл осы жерге тастай алсаңыз→
Dialogue: 0,12:56:14.43,12:56:18.62,Default,,0,0,0,,Қамырға көмектесу мүмкін емес.
Dialogue: 0,12:56:18.62,12:56:22.61,Default,,0,0,0,,Осы уақытқа дейін тек шабуылға ден қойғандар үшін→
Dialogue: 0,12:56:22.61,12:56:25.71,Default,,0,0,0,,Бұл мен ең көп алғым келген доп))
Dialogue: 0,12:56:39.97,12:56:45.07,Default,,0,0,0,,(Дарио) Қ… Қандай қорқынышты маска. Маған бұл керек емес.
Dialogue: 0,12:58:17.12,12:58:36.92,Default,,0,0,0,,♪♪~
Dialogue: 0,12:58:36.92,12:58:38.94,Default,,0,0,0,,О!
Dialogue: 0,12:58:38.94,12:58:44.00,Default,,0,0,0,,Савамура Жақсы, жақсы доп. (Кариба) 2 шығу, 2 шығу!
Dialogue: 0,12:58:44.00,12:58:46.80,Default,,0,0,0,,《Кувата: уақытты дұрыс анықтаңыз》
Dialogue: 0,12:58:48.82,12:58:53.12,Default,,0,0,0,,《Барлық жүйкелер, назарды саусақ ұшына аударыңыз》
Dialogue: 0,12:58:59.85,12:59:02.15,Default,,0,0,0,,Шығару. Шаа!
Dialogue: 0,12:59:08.14,12:59:10.14,Default,,0,0,0,,Савамура Бұл жолы ұпай жоқ!
Dialogue: 0,12:59:13.39,12:59:16.23,Default,,0,0,0,,《Бәрі ойлағандай болмаса да→
Dialogue: 0,12:59:16.23,12:59:18.95,Default,,0,0,0,,Тіпті сыртқы орталықтандырылған жинақта →
Dialogue: 0,12:59:18.95,12:59:21.45,Default,,0,0,0,,Допты соғып, ырғаққа кіре алдым.
Dialogue: 0,12:59:23.62,12:59:28.53,Default,,0,0,0,,《Сол жақ қамырдың қолдары сермеп жатыр →
Dialogue: 0,12:59:28.53,12:59:30.44,Default,,0,0,0,,Бұл доп өте...》
Dialogue: 0,12:59:30.44,12:59:33.45,Default,,0,0,0,,《Сол доп алыста сезінді》
Dialogue: 0,12:59:33.45,12:59:37.22,Default,,0,0,0,,Қамырды бірінші көргенде соғу қиын емес пе?
Dialogue: 0,12:59:37.22,12:59:42.27,Default,,0,0,0,,《Сіз түсіндіңіз бе? Сабақтың тиімділігі.
Dialogue: 0,12:59:42.27,12:59:44.91,Default,,0,0,0,,Сырт және ішкі → тіркесі бойынша
Dialogue: 0,12:59:44.91,12:59:48.78,Default,,0,0,0,,Питинг ауқымы бұрынғыдан да кең.
Dialogue: 0,12:59:48.78,12:59:52.28,Default,,0,0,0,,Курста лақтыру мүмкін болған кезде →
Dialogue: 0,12:59:52.28,12:59:55.38,Default,,0,0,0,,Әрі қарай биіктерге》
Dialogue: 0,12:59:57.45,13:00:00.11,Default,,0,0,0,,Соңында ойын тең аяқталды.
Dialogue: 0,13:00:00.11,13:00:03.23,Default,,0,0,0,,Керемет ойын! Жақсы матч болды!
Dialogue: 0,13:00:03.23,13:00:07.26,Default,,0,0,0,,《Түсіндім, бітті...
Dialogue: 0,13:00:07.26,13:00:11.94,Default,,0,0,0,,Мен тағы біраз лақтырғым келді...
Dialogue: 0,13:00:11.94,13:00:17.47,Default,,0,0,0,,Мен бұл сезімді ұмытпас бұрын...》
Dialogue: 0,13:00:17.47,13:00:19.77,Default,,0,0,0,,Енді сапқа тұрыңдар!
Dialogue: 0,13:00:26.60,13:00:28.60,Default,,0,0,0,,Әлі жоқ!
Dialogue: 0,13:00:30.77,13:00:33.56,Default,,0,0,0,,Бұл әлі шешілген жоқ.
Dialogue: 0,13:00:33.56,13:00:37.06,Default,,0,0,0,,Ойынға қатыспаған үшінші курс студенттері аз болуы керек.
Dialogue: 0,13:00:37.06,13:00:39.10,Default,,0,0,0,,Осы уақытқа дейін келген болсаңыз...
Dialogue: 0,13:00:39.10,13:00:41.23,Default,,0,0,0,,Қолыңыздан келгеннің бәрін жасаңыз!
Dialogue: 0,13:00:41.23,13:00:47.94,Default,,0,0,0,,♪♪~
Dialogue: 0,13:00:47.94,13:00:51.07,Default,,0,0,0,,《Режиссер: Біз өзімшіл болып жатырмыз→
Dialogue: 0,13:00:51.07,13:00:53.83,Default,,0,0,0,,Бұл матч болса да, маған ойнауға рұқсат берілді...
Dialogue: 0,13:00:53.83,13:00:56.13,Default,,0,0,0,,Тіпті матчқа қатыспайтын мүшелер туралы...》
Dialogue: 0,13:00:58.08,13:01:01.97,Default,,0,0,0,,Не? иә? Бұл мен әлі де дауыс бере аламын дегенді білдіре ме?
Dialogue: 0,13:01:01.97,13:01:06.62,Default,,0,0,0,,А, мүмкін, жаттықтырушы әлі де сенің алаңға шыққаныңды көргісі келген шығар.
Dialogue: 0,13:01:06.62,13:01:08.62,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,13:01:10.64,13:01:12.60,Default,,0,0,0,,Генерал!
Dialogue: 0,13:01:12.60,13:01:14.58,Default,,0,0,0,,Мен өте қуаныштымын!
Dialogue: 0,13:01:14.58,13:01:16.58,Default,,0,0,0,,Айла ....
Dialogue: 0,13:01:16.58,13:01:19.42,Default,,0,0,0,,Жақсы! Бір шымшым болып шыққан жігіт бірден қорғанысқа шығады!
Dialogue: 0,13:01:19.42,13:01:21.41,Default,,0,0,0,,Ішкі және сыртқы өрістер ауыстырылады!
Dialogue: 0,13:01:21.41,13:01:23.44,Default,,0,0,0,,Мұнда ешкім жоқ сияқты. (Ұшқыш А) Жоқ, бар.
Dialogue: 0,13:01:23.44,13:01:25.94,Default,,0,0,0,,Ах... Бірақ мен де Танбаның орнына шықтым!
Dialogue: 0,13:01:25.94,13:01:27.95,Default,,0,0,0,,Амал жоқ, лақтырамын!
Dialogue: 0,13:01:27.95,13:01:29.96,Default,,0,0,0,,Иә?
Dialogue: 0,13:01:29.96,13:01:32.60,Default,,0,0,0,,Барлығыңыз, иықтарыңызды көтеріңіздер.
Dialogue: 0,13:01:32.60,13:01:34.90,Default,,0,0,0,,Эй, эй, сені соққыға жығады деп ойлайсың ба?
Dialogue: 0,13:01:34.90,13:01:37.82,Default,,0,0,0,,Жоқ. Ереуіл жоқ деп есептейміз.
Dialogue: 0,13:01:37.82,13:01:40.42,Default,,0,0,0,,Нгаа. (Мияучи) Мен бара аламын ба? Нху.
Dialogue: 0,13:01:43.09,13:01:45.09,Default,,0,0,0,,А, мен кетейін.
Dialogue: 0,13:01:48.52,13:01:50.43,Default,,0,0,0,,《Крис Сенпай...》
Dialogue: 0,13:01:50.43,13:01:53.40,Default,,0,0,0,,Канеда мен Кавасима, өздеріңізді күтіңіздер.
Dialogue: 0,13:01:53.40,13:01:55.46,Default,,0,0,0,,Иә!
Dialogue: 0,13:01:55.46,13:01:58.91,Default,,0,0,0,,Өзіңізді қатты итермеңіз. (Рйосуке) Бұл құмыра.
Dialogue: 0,13:01:58.91,13:02:01.61,Default,,0,0,0,,Хахаха Крис қабылдай ма?
Dialogue: 0,13:02:01.61,13:02:03.60,Default,,0,0,0,,Мен кенеттен мотивацияны сезіндім!
Dialogue: 0,13:02:03.60,13:02:06.23,Default,,0,0,0,,Мотивация жақсы, бірақ төрт доп жасама.
Dialogue: 0,13:02:06.23,13:02:09.44,Default,,0,0,0,,Нху Берілу.
Dialogue: 0,13:02:09.44,13:02:12.57,Default,,0,0,0,,Раа~! Мен бәрін біржола реттеймін →
Dialogue: 0,13:02:12.57,13:02:15.28,Default,,0,0,0,,Дайын бол! ! (3-сынып оқушылары) Тшш!
Dialogue: 0,13:02:15.28,13:02:19.68,Default,,0,0,0,,Эй, ха! Джун-сан, сен ереуілге шығасың ба? ?
Dialogue: 0,13:02:19.68,13:02:22.43,Default,,0,0,0,,Егер сіз ынта-жігеріңізбен бұзсаңыз! (Курамочи) Хяхаха!
Dialogue: 0,13:02:22.43,13:02:25.82,Default,,0,0,0,,Не? Исашики лақтырмақсың ба? Шынайы! ?
Dialogue: 0,13:02:25.82,13:02:28.92,Default,,0,0,0,,Сабыр ет, Исаски! Арандатпаңыз!
Dialogue: 0,13:02:28.92,13:02:30.94,Default,,0,0,0,,Мінбе, ақымақ!
Dialogue: 0,13:02:30.94,13:02:34.48,Default,,0,0,0,,Құмыраның мінезі қысқа. Өлі шарлардан сақ болыңыз!
Dialogue: 0,13:02:34.48,13:02:36.73,Default,,0,0,0,,Не болды!
Dialogue: 0,13:02:36.73,13:02:39.93,Default,,0,0,0,,Бұл кеңейтім бе? Ойыншылар бақытты.
Dialogue: 0,13:02:39.93,13:02:42.59,Default,,0,0,0,,Иә.
Dialogue: 0,13:02:42.59,13:02:46.46,Default,,0,0,0,,《Тұрақтылар команданың жалғыз мүшелері емес.
Dialogue: 0,13:02:46.46,13:02:50.78,Default,,0,0,0,,Директор Катаока үнемі осылай айтып отырады.
Dialogue: 0,13:02:50.78,13:02:53.43,Default,,0,0,0,,((Катаока: Тек Фуруя үшін →
Dialogue: 0,13:02:53.43,13:02:56.93,Default,,0,0,0,,Менің командамды құрбан етуге ниетім жоқ.
Dialogue: 0,13:02:56.93,13:03:03.76,Default,,0,0,0,,Мен оларды Кошиенге апарғым келеді))
Dialogue: 0,13:03:03.76,13:03:05.78,Default,,0,0,0,,Соңғы!
Dialogue: 0,13:03:05.78,13:03:08.23,Default,,0,0,0,,《Ота: Мен көп сөзді адам емеспін, бірақ→
Dialogue: 0,13:03:08.23,13:03:10.30,Default,,0,0,0,,Ауырлықтың артында→
Dialogue: 0,13:03:10.30,13:03:13.30,Default,,0,0,0,,Әр ойыншының қамын ойлайтын жүрегі бар.
Dialogue: 0,13:03:15.92,13:03:18.61,Default,,0,0,0,,((Катаока: Қиын жаттығу және тұрақты бәсекелестік.
Dialogue: 0,13:03:18.61,13:03:24.26,Default,,0,0,0,,Мен сізде көптеген ауыр және көңілсіз оқиғалар болғанына сенімдімін.
Dialogue: 0,13:03:24.26,13:03:28.32,Default,,0,0,0,,Бірақ сіз ешқашан берілмейсіз →
Dialogue: 0,13:03:28.32,13:03:31.42,Default,,0,0,0,,Менің соңына дейін ердің.
Dialogue: 0,13:03:34.07,13:03:39.48,Default,,0,0,0,,Менің мақтанышым болып жүре бер))
Dialogue: 0,13:03:39.48,13:03:55.44,Default,,0,0,0,,♪♪~
Dialogue: 0,13:03:55.44,13:03:59.73,Default,,0,0,0,,《Зейнетке шыққан үшінші курс студенті кіші директор...
Dialogue: 0,13:03:59.73,13:04:04.28,Default,,0,0,0,,Бұған жауап ретінде белсенді топ өз күшін көрсете бастады.
Dialogue: 0,13:04:04.28,13:04:07.92,Default,,0,0,0,,Осындай тамаша ұжымды кім құрды→
Dialogue: 0,13:04:07.92,13:04:12.14,Default,,0,0,0,,Бұл сізсіз, директор Катаока》
Dialogue: 0,13:04:12.14,13:04:26.14,Default,,0,0,0,,♪♪~
Dialogue: 0,13:04:54.05,13:04:57.44,Default,,0,0,0,,Маекура No29 орта мектебі.
Dialogue: 0,13:04:57.44,13:05:00.99,Default,,0,0,0,,Бірінші айналымда күшті командалар бірін-бірі тастай ма?
Dialogue: 0,13:05:00.99,13:05:04.44,Default,,0,0,0,,Тек сол жаққа барыңыз.
Dialogue: 0,13:05:04.44,13:05:09.35,Default,,0,0,0,,Жаз мезгілінен айырмашылығы, Күзгі университет Шығыс пен Батысты ажыратпайтын турнир →
Dialogue: 0,13:05:09.35,13:05:13.94,Default,,0,0,0,,Бірінші айналымнан бастап Кошиенге қатысатын мектептер арасында шайқас болуы мүмкін.
Dialogue: 0,13:05:13.94,13:05:16.14,Default,,0,0,0,,Лотереяның сәттілігі Ақымақ болмаңыз.
Dialogue: 0,13:05:16.14,13:05:19.44,Default,,0,0,0,,Ой, мынау өсек... фармацевт.
Dialogue: 0,13:05:21.41,13:05:23.78,Default,,0,0,0,,Жеңіс сериясы әлі жалғасуда ма?
Dialogue: 0,13:05:23.78,13:05:26.37,Default,,0,0,0,,Менің ойымша, ол Сейдоны да жеңді.
Dialogue: 0,13:05:26.37,13:05:31.37,Default,,0,0,0,,[Майк] Якуши №41 орта мектебі. О!
Dialogue: 0,13:05:34.01,13:05:36.23,Default,,0,0,0,,《Миюки: Қандай блокқа кірсеңіз де→
Dialogue: 0,13:05:36.23,13:05:41.11,Default,,0,0,0,,Қай командаға қарсы ойнағаныңыз маңызды емес.
Dialogue: 0,13:05:41.11,13:05:49.11,Default,,0,0,0,,Біз көздеген бір ғана тау бар.
Dialogue: 0,13:05:49.11,13:05:55.06,Default,,0,0,0,,Мен бұл қадамды жасауға дайынмын.
Dialogue: 0,13:05:55.06,13:06:29.06,Default,,0,0,0,,♪♪~
Dialogue: 0,13:06:29.06,13:06:32.48,Default,,0,0,0,,Күнде баратын жер болса да→
Dialogue: 0,13:06:32.48,13:06:35.39,Default,,0,0,0,,Қазір басқаша сезіледі.
Dialogue: 0,13:06:35.39,13:06:49.10,Default,,0,0,0,,♪♪~
Dialogue: 0,13:06:49.10,13:06:51.75,Default,,0,0,0,,Бүгінгі күн үшін рахмет!
Dialogue: 0,13:06:51.75,13:06:54.09,Default,,0,0,0,,Мен жасадым!
Dialogue: 0,13:06:54.09,13:06:57.77,Default,,0,0,0,,Топтың жұмысы жақсы емес деп естідім.→
Dialogue: 0,13:06:57.77,13:07:00.43,Default,,0,0,0,,Мен төбелесе алмаймын деп жеңілдендім.
Dialogue: 0,13:07:00.43,13:07:03.11,Default,,0,0,0,,Міне, біз жеңдік.
Dialogue: 0,13:07:03.11,13:07:07.75,Default,,0,0,0,,Жоқ, жоқ, жоқ... Соңында мен үлкендерге гүл сыйладым.
Dialogue: 0,13:07:07.75,13:07:10.77,Default,,0,0,0,,Ах! ? Мен осылай айта бастадым.
Dialogue: 0,13:07:10.77,13:07:14.46,Default,,0,0,0,,Ұжым ретінде бізге әлі де күш жетіспейтін шығар→
Dialogue: 0,13:07:14.46,13:07:18.06,Default,,0,0,0,,Енді бізге өз рөлімізді ойнау ғана қалды.
Dialogue: 0,13:07:21.82,13:07:26.42,Default,,0,0,0,,《Ойынға келгенің өте жақсы.》
Dialogue: 0,13:07:29.39,13:07:40.15,Default,,0,0,0,,♪♪~
Dialogue: 0,13:07:40.15,13:07:43.75,Default,,0,0,0,,((Сіз ғана азап шегесіз.
Dialogue: 0,13:07:48.14,13:07:51.76,Default,,0,0,0,,Бұлай жалғаспаса, біз бұл жерде аман қалмаймыз))
Dialogue: 0,13:07:51.76,13:08:04.76,Default,,0,0,0,,♪♪~
Dialogue: 0,13:08:04.76,13:08:08.16,Default,,0,0,0,,Тәжірибе ешқашан өтірік айтпайды.
Dialogue: 0,13:08:08.16,13:08:12.12,Default,,0,0,0,,Мен бұл сөздерге әлі де сенемін→
Dialogue: 0,13:08:12.12,13:08:15.47,Default,,0,0,0,,Мен бұл командамен бәсекеге түскеніме өкінбеймін.
Dialogue: 0,13:08:15.47,13:08:19.44,Default,,0,0,0,,Дегенмен, бұл бәсекеге қабілетті әлем. Күресетін адам болғанша →
Dialogue: 0,13:08:19.44,13:08:23.88,Default,,0,0,0,,Жеңіс немесе жеңіліс Тек екі нәтиже бар.
Dialogue: 0,13:08:23.88,13:08:44.88,Default,,0,0,0,,♪♪~
Dialogue: 0,13:08:49.10,13:08:53.77,Default,,0,0,0,,Жоғалтпаңдар, балалар.
Dialogue: 0,13:08:53.77,13:09:38.10,Default,,0,0,0,,♪♪~
Dialogue: 0,13:09:38.10,13:09:41.77,Default,,0,0,0,,《Миюки: Барлығы тамсанатын жерге ұмтылу→
Dialogue: 0,13:09:41.77,13:09:46.43,Default,,0,0,0,,Оңай жол жоқ. Жеңіске деген талпыныс →
Dialogue: 0,13:09:46.43,13:09:49.95,Default,,0,0,0,,Әр команда осылай жасайды.
Dialogue: 0,13:09:49.95,13:10:11.10,Default,,0,0,0,,♪♪~
Dialogue: 0,13:10:11.10,13:10:13.55,Default,,0,0,0,,《Әлі...》
Dialogue: 0,13:10:13.55,13:10:57.33,Default,,0,0,0,,♪♪~
Dialogue: 0,13:10:57.33,13:11:00.25,Default,,0,0,0,,Тыныш! Мен біріншісін алдым!
Dialogue: 0,13:11:00.25,13:11:02.24,Default,,0,0,0,,Бірінші.
Dialogue: 0,13:11:02.24,13:11:04.65,Default,,0,0,0,,Фуруя тақырыбы!
Dialogue: 0,13:11:04.65,13:11:08.89,Default,,0,0,0,,Күте тұрыңыз! Апыр-ай!
Dialogue: 0,13:11:08.89,13:11:12.31,Default,,0,0,0,,Содан кейін жалғастырыңыз. Көктем! ?
Dialogue: 0,13:11:12.31,13:12:22.15,Default,,0,0,0,,♪♪~
Dialogue: 0,13:12:22.15,13:12:25.45,Default,,0,0,0,,《Миюки: Сонда да біз...》
Dialogue: 0,13:12:25.45,13:12:38.40,Default,,0,0,0,,♪♪~
Dialogue: 0,13:12:38.40,13:12:40.48,Default,,0,0,0,,Кеттік! !
Dialogue: 0,13:12:40.48,13:12:43.08,Default,,0,0,0,,Тыныш!
Dialogue: 0,13:12:44.58,13:12:50.58,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory