Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:33.88,0:00:37.35,Default,,0,0,0,,[Үндеткіш] Құмыраны ауыстыру Mino →
Dialogue: 0,0:00:37.35,0:00:41.15,Default,,0,0,0,,Санада мырза. Құмыра Санада-кун.
Dialogue: 0,0:00:43.89,0:00:46.76,Default,,0,0,0,,Нашар Санада.
Dialogue: 0,0:00:46.76,0:00:48.89,Default,,0,0,0,,Мен онымен ұзағырақ ұстанғым келді, бірақ...
Dialogue: 0,0:00:48.89,0:00:52.13,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Сол жердегі тазалаудан →
Dialogue: 0,0:00:52.13,0:00:55.93,Default,,0,0,0,,Қашпай бетпе-бет күрес. Бұл маған батылдық берді.
Dialogue: 0,0:00:58.87,0:01:01.09,Default,,0,0,0,,Мен сұрадым, Шунпей! Түсіңіз →
Dialogue: 0,0:01:01.09,0:01:03.47,Default,,0,0,0,,Доппен! Қарқынды бөлу →
Dialogue: 0,0:01:03.47,0:01:06.01,Default,,0,0,0,,Ойлан!
Dialogue: 0,0:01:06.01,0:01:09.76,Default,,0,0,0,,Санада-сенпай, мынаны ұрайын, жарайды!
Dialogue: 0,0:01:09.76,0:01:13.22,Default,,0,0,0,,Мен оны міндетті түрде тоқтатамын! (Санада) Сен де, мен де қорқамыз →
Dialogue: 0,0:01:13.22,0:01:16.42,Default,,0,0,0,,Мен сені ұруға жол бермеймін. Қате болатын сияқты.
Dialogue: 0,0:01:16.42,0:01:18.44,Default,,0,0,0,,Жоқ, шындап.
Dialogue: 0,0:01:18.44,0:01:22.09,Default,,0,0,0,,Раиичи! Санаданы ұстамаңыз! !
Dialogue: 0,0:01:22.09,0:01:25.28,Default,,0,0,0,,Әр жағдайда қайда лақтыру керектігін тексеріңіз!
Dialogue: 0,0:01:25.28,0:01:27.70,Default,,0,0,0,,Сіз өте ақылды емессіз!
Dialogue: 0,0:01:27.70,0:01:31.09,Default,,0,0,0,,Шулы! Қарғыс ата! ! (күлкі)
Dialogue: 0,0:01:31.09,0:01:36.44,Default,,0,0,0,,Оған көмектесу мүмкін емес, себебі бұл генетикалық! ≪Райнчи! Енді маған қанша шығуды айтыңыз.
Dialogue: 0,0:01:36.44,0:01:39.89,Default,,0,0,0,,≪Себебі жүгіруші екінші негізде! (күлкі)
Dialogue: 0,0:01:39.89,0:01:44.95,Default,,0,0,0,,Сол құмыра шыққанда, атмосфера мүлдем өзгерді.
Dialogue: 0,0:01:44.95,0:01:47.74,Default,,0,0,0,,Сөз жоқ. (Катаока) Ах.
Dialogue: 0,0:01:47.74,0:01:51.84,Default,,0,0,0,,Өйткені, ол кісі осы ұжымның эйсті...
Dialogue: 0,0:04:33.87,0:04:37.89,Default,,0,0,0,,Сол құмыра шыққанда, атмосфера толығымен өзгерді.
Dialogue: 0,0:04:37.89,0:04:40.96,Default,,0,0,0,,Сөз жоқ. Ах.
Dialogue: 0,0:04:40.96,0:04:45.46,Default,,0,0,0,,Өйткені, ол кісі осы команданың эй...
Dialogue: 0,0:04:52.75,0:04:55.59,Default,,0,0,0,,《Миюки: Курстағы атылатын құмыра.
Dialogue: 0,0:04:55.59,0:04:59.21,Default,,0,0,0,,Ол соққыдан гөрі допты соғуға мүмкіндік беретін жігіт пе?
Dialogue: 0,0:04:59.21,0:05:02.31,Default,,0,0,0,,Егер мен мына құмыраны осында соға алсам→
Dialogue: 0,0:05:02.31,0:05:06.11,Default,,0,0,0,,Жеңіске жақындайсың, Масуко-сенпай...》
Dialogue: 0,0:05:11.79,0:05:18.13,Default,,0,0,0,,《1 шықты, 2-ші негізде жүгіруші... Ат-батта №5 күшті соққышы болды.
Dialogue: 0,0:05:18.13,0:05:23.13,Default,,0,0,0,,Менің рөлім - бұл команданың серпінін жою...》
Dialogue: 0,0:05:26.37,0:05:30.12,Default,,0,0,0,,《Кенет өте ыстық! 》
Dialogue: 0,0:05:30.12,0:05:38.22,Default,,0,0,0,,♪♪~
Dialogue: 0,0:05:43.72,0:05:46.31,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:46.31,0:05:48.41,Default,,0,0,0,,≪Өлі доп!
Dialogue: 0,0:05:50.71,0:05:53.91,Default,,0,0,0,,Кенет, бұл құмыра қай жерде құйылды?
Dialogue: 0,0:05:53.91,0:05:56.28,Default,,0,0,0,,Бұл жақсы болды, өйткені ол күзетшіге тиді! !
Dialogue: 0,0:05:56.28,0:05:59.57,Default,,0,0,0,,Сіз айтасыз. (Харуичи) Иә. Эйджунға →
Dialogue: 0,0:05:59.57,0:06:01.57,Default,,0,0,0,,Айтатын біліктілігі жоқ.
Dialogue: 0,0:06:03.76,0:06:07.63,Default,,0,0,0,,《Масуко: Не деген өткір ату... Реакция жасап жатса да→
Dialogue: 0,0:06:07.63,0:06:09.88,Default,,0,0,0,,Одан құтылу мүмкін емес еді...》
Dialogue: 0,0:06:09.88,0:06:12.27,Default,,0,0,0,,Жақсы! Енді 1-ші және 2-ші базадағы жүгірушілер! !
Dialogue: 0,0:06:12.27,0:06:14.49,Default,,0,0,0,,Осы уақытта бірден барайық!
Dialogue: 0,0:06:14.49,0:06:17.99,Default,,0,0,0,,Әлгі ақымақ! Мен кенеттен шымшып кетсем не істеуім керек?
Dialogue: 0,0:06:20.27,0:06:25.77,Default,,0,0,0,,《Тодороки: Жарайды...оның жақсы жері сол қорлайтын питчинг.》
Dialogue: 0,0:06:29.60,0:06:34.76,Default,,0,0,0,,《О, құдай-ау, ол келесіден сақ болатын адамдардың бірі.》
Dialogue: 0,0:06:34.76,0:06:38.76,Default,,0,0,0,,[Баяндамашы] №6 Ұстаушы Миюки-кун.
Dialogue: 0,0:06:38.76,0:06:40.75,Default,,0,0,0,,≪Сәттілік! ≪Миюки-кун!
Dialogue: 0,0:06:40.75,0:06:43.08,Default,,0,0,0,,《Миюки: Кенеттен өлі доп.
Dialogue: 0,0:06:43.08,0:06:47.30,Default,,0,0,0,,Бұл жігіт бейнеде көрінгеннен әлдеқайда дөрекі.
Dialogue: 0,0:06:47.30,0:06:52.30,Default,,0,0,0,,Жарайды, өрескел допты көздеу қиын.
Dialogue: 0,0:06:56.78,0:06:59.91,Default,,0,0,0,,《Бүгін Фуруя бірдеңе жасайтын сияқты.
Dialogue: 0,0:06:59.91,0:07:02.91,Default,,0,0,0,,Мұны Масуко-сенпайға қалдырамын ба?
Dialogue: 0,0:07:05.30,0:07:08.40,Default,,0,0,0,,《Жаман, бәрін бірден шешейін》
Dialogue: 0,0:07:19.90,0:07:22.00,Default,,0,0,0,,Уф….
Dialogue: 0,0:07:27.76,0:07:29.76,Default,,0,0,0,,《Міне~!
Dialogue: 0,0:07:29.76,0:07:33.16,Default,,0,0,0,,Бұл доп 140 км жерге тиген болуы керек.
Dialogue: 0,0:07:33.16,0:07:37.94,Default,,0,0,0,,Оның үстіне өлі доп шығарылғаннан кейін де оның беті тырналып кеткен.
Dialogue: 0,0:07:37.94,0:07:42.06,Default,,0,0,0,,Оң қолмен ұрғандар үшін соққы кеудені ойып жіберуі мүмкін →
Dialogue: 0,0:07:42.06,0:07:46.54,Default,,0,0,0,,Солақайлар үшін бұл доп қашып кетеді.
Dialogue: 0,0:07:46.54,0:07:50.64,Default,,0,0,0,,Сіз курста есеп алуды және оны сырттай қабылдауды жоспарлап отырғаныңызға сенімдімін, бірақ...
Dialogue: 0,0:07:52.88,0:07:55.92,Default,,0,0,0,,《Бұған жол бермеу》
Dialogue: 0,0:07:55.92,0:07:58.06,Default,,0,0,0,,Миюки жарғанатты қысқартады!
Dialogue: 0,0:07:58.06,0:08:03.49,Default,,0,0,0,,Иә, мен ұзақ хиттерге қарағанда сенімділікке басымдық берер едім.
Dialogue: 0,0:08:03.49,0:08:06.88,Default,,0,0,0,,《Крис: Тәтті допты жіберіп алмай қосылуды білу.
Dialogue: 0,0:08:06.88,0:08:09.47,Default,,0,0,0,,Мен жаңа ғана ауыстырған құмыраны →
Dialogue: 0,0:08:09.47,0:08:12.07,Default,,0,0,0,,Мен сенің нені жек көретініңді білемін》
Dialogue: 0,0:08:16.11,0:08:18.58,Default,,0,0,0,,Доп!
Dialogue: 0,0:08:18.58,0:08:20.76,Default,,0,0,0,,Бұл 2 доп ештеңе емес!
Dialogue: 0,0:08:20.76,0:08:23.21,Default,,0,0,0,,Құмыраға соққы бере алмайды!
Dialogue: 0,0:08:23.21,0:08:26.27,Default,,0,0,0,,Яябе.
Dialogue: 0,0:08:26.27,0:08:29.10,Default,,0,0,0,,Тек тәтті шарларды мақсат етіңіз!
Dialogue: 0,0:08:29.10,0:08:31.46,Default,,0,0,0,,《Сақ бол, Миюки.
Dialogue: 0,0:08:31.46,0:08:35.38,Default,,0,0,0,,Оның соққысы мен күткеннен де өткір болды.
Dialogue: 0,0:08:35.38,0:08:37.43,Default,,0,0,0,,《Миюки: 2 шар ештеңе жоқ...
Dialogue: 0,0:08:37.43,0:08:40.28,Default,,0,0,0,,Әрі қарай, мен ереуіл алғым келеді.
Dialogue: 0,0:08:40.28,0:08:45.22,Default,,0,0,0,,Бұл көріністің ең сорақысы доптың сырттағы допқа түсіп қалуы.
Dialogue: 0,0:08:45.22,0:08:49.71,Default,,0,0,0,,Қатты тартуға тырыспаңыз, қысқа тоқтатудың басынан жоғары көздеңіз.
Dialogue: 0,0:08:49.71,0:08:55.41,Default,,0,0,0,,Атқан оқ па, тік пе, тәтті кірсе, соқ! 》
Dialogue: 0,0:08:55.41,0:08:59.55,Default,,0,0,0,,Мен... Оның жүзі әдеттен тыс салмақты! Бұл дөрекі.
Dialogue: 0,0:08:59.55,0:09:07.26,Default,,0,0,0,,♪♪~
Dialogue: 0,0:09:07.26,0:09:09.79,Default,,0,0,0,,《Міне, келді! Тәтті курс.
Dialogue: 0,0:09:09.79,0:09:11.89,Default,,0,0,0,,Керемет уақыт! 》
Dialogue: 0,0:09:18.57,0:09:21.44,Default,,0,0,0,,Екінші!
Dialogue: 0,0:09:21.44,0:09:23.54,Default,,0,0,0,,Бірінші!
Dialogue: 0,0:09:26.29,0:09:28.29,Default,,0,0,0,,О!
Dialogue: 0,0:09:30.38,0:09:34.64,Default,,0,0,0,,Эй~ Гетц! Жақсы бөлік Санада!
Dialogue: 0,0:09:34.64,0:09:37.44,Default,,0,0,0,,Санада-сенпай күткендей!
Dialogue: 0,0:09:40.72,0:09:43.26,Default,,0,0,0,,Миюки мүмкіндіктерге қарсы күшті...
Dialogue: 0,0:09:43.26,0:09:45.26,Default,,0,0,0,,Бұл қандай доп?
Dialogue: 0,0:09:45.26,0:09:50.05,Default,,0,0,0,,Уақыт дұрыс болды, солай ма? Бірақ мен кептеліп қалдым! ?
Dialogue: 0,0:09:50.05,0:09:53.30,Default,,0,0,0,,Кешіріңіз, мен сіздің мүмкіндікті құрттым.
Dialogue: 0,0:09:53.30,0:09:55.60,Default,,0,0,0,,Ағымдағы доп дегеніміз не?
Dialogue: 0,0:09:57.76,0:10:02.93,Default,,0,0,0,,Мүмкін... кесілген доп.
Dialogue: 0,0:10:02.93,0:10:05.72,Default,,0,0,0,,Допты кесіңіз! ?
Dialogue: 0,0:10:05.72,0:10:10.12,Default,,0,0,0,,дегеніміз не? Крис Сенпай!
Dialogue: 0,0:10:10.12,0:10:13.72,Default,,0,0,0,,Қамырдың қолында кенет қисық доп.
Dialogue: 0,0:10:13.72,0:10:16.41,Default,,0,0,0,,Сырғытпаға қарағанда иілу →
Dialogue: 0,0:10:16.41,0:10:19.61,Default,,0,0,0,,Доптың жылдамдығы түзу доппен бірдей дерлік.
Dialogue: 0,0:10:19.61,0:10:24.39,Default,,0,0,0,,Кескіш ретінде белгілі. Бұл қозғалыстың бір түрі.
Dialogue: 0,0:10:24.39,0:10:27.10,Default,,0,0,0,,Жылжыту?
Dialogue: 0,0:10:27.10,0:10:31.21,Default,,0,0,0,,Өткір соққылар ғана емес, кесілген доптар да.
Dialogue: 0,0:10:31.21,0:10:34.60,Default,,0,0,0,,Сіздің курсқа ерекше көңіл бөлуіңіздің себебі осы ма?
Dialogue: 0,0:10:34.60,0:10:38.27,Default,,0,0,0,,Ах. Савамура сияқты қызықты доп емес→
Dialogue: 0,0:10:38.27,0:10:40.72,Default,,0,0,0,,Сіз допты әдейі жылжытып жатырсыз.
Dialogue: 0,0:10:40.72,0:10:42.75,Default,,0,0,0,,Га!
Dialogue: 0,0:10:42.75,0:10:47.89,Default,,0,0,0,,Қызықты. Ол Савамураға қарағанда әлдеқайда жақсы қозғалатын қолданушы.
Dialogue: 0,0:10:47.89,0:10:49.93,Default,,0,0,0,,Угугу….
Dialogue: 0,0:10:49.93,0:10:52.60,Default,,0,0,0,,Менің амалым жоқ, өйткені бұл рас.
Dialogue: 0,0:10:52.60,0:10:56.05,Default,,0,0,0,,Бірақ Эйс, мен Эйсті тез шығарып алдым.
Dialogue: 0,0:10:56.05,0:11:00.10,Default,,0,0,0,,Сіз қалағаныңызша стратегияларды таба аласыз, хахаха.
Dialogue: 0,0:11:00.10,0:11:02.16,Default,,0,0,0,,Тез ауыспаңыз!
Dialogue: 0,0:11:02.16,0:11:05.46,Default,,0,0,0,,Сізде өзіңіздің ерекше қасиеттеріңіз болуы керек.
Dialogue: 0,0:11:05.46,0:11:08.46,Default,,0,0,0,,Мен құмыра ретінде жеңіліп жатқан сияқты емеспін.
Dialogue: 0,0:11:11.12,0:11:13.72,Default,,0,0,0,,Хаха! Біртүрлі қателіктер жасамаңыз.
Dialogue: 0,0:11:13.72,0:11:17.65,Default,,0,0,0,,Төрт доп үш есеге дейін! Тағы бәрі мені өлтіреді!
Dialogue: 0,0:11:17.65,0:11:20.89,Default,,0,0,0,,Бұл алдыңғы орында. Барынша қатты лақтырыңыз.
Dialogue: 0,0:11:20.89,0:11:22.96,Default,,0,0,0,,Сіз кез келген уақытта ойыңызды өзгерте аласыз.
Dialogue: 0,0:11:22.96,0:11:26.06,Default,,0,0,0,,Савамура, өз дауысыңды айт.
Dialogue: 0,0:11:29.25,0:11:33.25,Default,,0,0,0,,Оңай! ! Барлығының үмітін ақтайтыныма сенімдімін...
Dialogue: 0,0:11:33.25,0:11:36.55,Default,,0,0,0,,Жарайды, тезірек қорғанға бар. Ха... Бастық!
Dialogue: 0,0:13:08.90,0:13:15.09,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:13:15.09,0:13:19.04,Default,,0,0,0,,Уа, мен істеп жатырмын. (Омае) Бұл әлі 4 рет болды.
Dialogue: 0,0:13:19.04,0:13:23.26,Default,,0,0,0,,Сіз оны уақытында орындадыңыз. (Шимадзу) Сіз бұл Тамба допты лақтыра алмайсыз.
Dialogue: 0,0:13:23.26,0:13:26.90,Default,,0,0,0,,Бірыңғай киім нөмірі 20 Бұл бірінші курс студенті Савамура ма?
Dialogue: 0,0:13:26.90,0:13:29.22,Default,,0,0,0,,Ей, не болып жатыр! ?
Dialogue: 0,0:13:29.22,0:13:32.79,Default,,0,0,0,,Якуши матчтары әлі бір ғана ұпай жинады!
Dialogue: 0,0:13:32.79,0:13:36.38,Default,,0,0,0,,《Сен бәрібір келдің, Хиракава》
Dialogue: 0,0:13:36.38,0:13:41.08,Default,,0,0,0,,Каваками - бұқа, ал Фуруя - сол жақтағы?
Dialogue: 0,0:13:41.08,0:13:43.22,Default,,0,0,0,,Тамбаға не болды?
Dialogue: 0,0:13:43.22,0:13:46.05,Default,,0,0,0,,Сіз оны бір рет болса да лақтырған жоқсыз, солай ма?
Dialogue: 0,0:13:46.05,0:13:48.97,Default,,0,0,0,,Мен Якушидің соққылар құрамы бір жыл болғанына сене алмадым →
Dialogue: 0,0:13:48.97,0:13:51.47,Default,,0,0,0,,Менің ойымша, оны 1 ұпайға дейін сақтау жақсы емес ...
Dialogue: 0,0:13:55.43,0:13:59.03,Default,,0,0,0,,《Мишима: Бұл жігіттің пішіні мен уақыты не болды? 》
Dialogue: 0,0:14:02.25,0:14:05.24,Default,,0,0,0,,Оши Оши Оши!
Dialogue: 0,0:14:05.24,0:14:08.43,Default,,0,0,0,,Түсіндім, түсіндім! Оши Оши!
Dialogue: 0,0:14:08.43,0:14:10.79,Default,,0,0,0,,Сіз өткен жылы жақсы болдыңыз.
Dialogue: 0,0:14:10.79,0:14:12.93,Default,,0,0,0,,Ах. иә?
Dialogue: 0,0:14:12.93,0:14:16.38,Default,,0,0,0,,《Омаэ: Манака...》
Dialogue: 0,0:14:16.38,0:14:22.87,Default,,0,0,0,,♪♪~
Dialogue: 0,0:14:22.87,0:14:25.74,Default,,0,0,0,,О~. Құдай-ай!
Dialogue: 0,0:14:25.74,0:14:28.24,Default,,0,0,0,,Сәттілік, Фуруя-кун!
Dialogue: 0,0:14:32.73,0:14:34.94,Default,,0,0,0,,Ku….
Dialogue: 0,0:14:34.94,0:14:37.30,Default,,0,0,0,,≪Өт!
Dialogue: 0,0:14:37.30,0:14:41.11,Default,,0,0,0,,Жарайды! Жақсы бөлік Санада!
Dialogue: 0,0:14:41.11,0:14:43.23,Default,,0,0,0,,《Ол, әрине, жақсы құмыра.
Dialogue: 0,0:14:43.23,0:14:47.41,Default,,0,0,0,,Бірақ неге осы калибрлі құмыралар іске қосылмайды?
Dialogue: 0,0:14:47.41,0:14:52.85,Default,,0,0,0,,Осы уақытқа дейін барлық ойындар жеңілдік болды. Мұның себебі неде? 》
Dialogue: 0,0:14:52.85,0:14:56.22,Default,,0,0,0,,Фуруя! Мен сенің жауыңды жеңемін!
Dialogue: 0,0:14:56.22,0:14:58.26,Default,,0,0,0,,Оишо Оишо!
Dialogue: 0,0:14:58.26,0:15:01.61,Default,,0,0,0,,Сәлем! Қамырды тастаңыз!
Dialogue: 0,0:15:01.61,0:15:04.23,Default,,0,0,0,,Қарғыс атсын! Бұл кескіш пе?
Dialogue: 0,0:15:04.23,0:15:06.65,Default,,0,0,0,,Күткендей, сіз оны бір қарағанда жеңе алмайсыз!
Dialogue: 0,0:15:06.65,0:15:11.25,Default,,0,0,0,,Жоқ, бәрі түзу. Келесі жолы соғыңыз!
Dialogue: 0,0:15:13.92,0:15:15.94,Default,,0,0,0,,2 шықты!
Dialogue: 0,0:15:15.94,0:15:19.60,Default,,0,0,0,,《Қарғыс атсын! Питингке келгенде ешқашан ұтыла алмайсыз! 》
Dialogue: 0,0:15:19.60,0:15:22.60,Default,,0,0,0,,Барлығымыз ауысайық.
Dialogue: 0,0:15:22.60,0:15:26.55,Default,,0,0,0,,Тек оң ілгерілеушілік бар. Олай айтпа!
Dialogue: 0,0:15:26.55,0:15:34.21,Default,,0,0,0,,♪♪~
Dialogue: 0,0:15:34.21,0:15:37.91,Default,,0,0,0,,《Менде тағы екі иннинг қалды.
Dialogue: 0,0:15:37.91,0:15:43.89,Default,,0,0,0,,Қатты ұстап, Каваками-сенпаймен байланысыңыз! 》
Dialogue: 0,0:15:43.89,0:15:45.94,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:15:45.94,0:15:47.96,Default,,0,0,0,,Қысқа! Хяха!
Dialogue: 0,0:15:47.96,0:15:49.99,Default,,0,0,0,,≪Өт!
Dialogue: 0,0:15:49.99,0:15:52.88,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:52.88,0:15:55.60,Default,,0,0,0,,Сенің көңіл-күйің жоқ, Савамура!
Dialogue: 0,0:15:55.60,0:15:57.97,Default,,0,0,0,,Толқындар ұзаққа созылмайды!
Dialogue: 0,0:15:57.97,0:16:00.55,Default,,0,0,0,,Зе... бәрі жақсы жүріп жатыр.
Dialogue: 0,0:16:00.55,0:16:04.88,Default,,0,0,0,,《Тодорокиді жеңу арқылы сіз толқынды толығымен басып өттіңіз.
Dialogue: 0,0:16:04.88,0:16:09.93,Default,,0,0,0,,Допқа сенімділік беру》
Dialogue: 0,0:16:09.93,0:16:11.93,Default,,0,0,0,,Қарғыс атсын! Бауырым!
Dialogue: 0,0:16:14.89,0:16:17.24,Default,,0,0,0,,2 шықты! 2 шықты!
Dialogue: 0,0:16:17.24,0:16:22.31,Default,,0,0,0,,《Рахмет: Жақсы қарқынмен ойнау арқылы мен өз ырғағымды жасай аламын.
Dialogue: 0,0:16:22.31,0:16:24.91,Default,,0,0,0,,Мен шынымен күшті болдым》
Dialogue: 0,0:16:27.88,0:16:31.64,Default,,0,0,0,,《Қолым ойлағаннан кеш шықты.
Dialogue: 0,0:16:31.64,0:16:35.64,Default,,0,0,0,,Доптың қайдан келе жатқанын көру қиын. Сіз қозғалыстағы баллерсіз бе?
Dialogue: 0,0:16:39.93,0:16:42.93,Default,,0,0,0,,《Жеңілме! 1 жылда! 》
Dialogue: 0,0:16:52.96,0:16:56.23,Default,,0,0,0,,Керемет! Жақсы бөлік Санада!
Dialogue: 0,0:16:56.23,0:16:58.93,Default,,0,0,0,,Цк….
Dialogue: 0,0:16:58.93,0:17:01.28,Default,,0,0,0,,Дәрігердің көкесі пайда болған бойда →
Dialogue: 0,0:17:01.28,0:17:04.32,Default,,0,0,0,,Матч тығырыққа тірелді.
Dialogue: 0,0:17:04.32,0:17:07.55,Default,,0,0,0,,Ах, бірақ одан да таң қалдыратыны →
Dialogue: 0,0:17:07.55,0:17:11.59,Default,,0,0,0,,Якуши сапына сенімді түрде қарсы шығуды жалғастыру→
Dialogue: 0,0:17:11.59,0:17:14.88,Default,,0,0,0,,Бірінші курс құмыра Савамура.
Dialogue: 0,0:17:14.88,0:17:17.55,Default,,0,0,0,,Акекаваға қарсы матчтан бері жүгіруден бас тартпай питчинг →
Dialogue: 0,0:17:17.55,0:17:21.25,Default,,0,0,0,,Ол жалғасады. (Менікі) Оның қолының тербелуі ерекше →
Dialogue: 0,0:17:21.25,0:17:24.25,Default,,0,0,0,,Менің ойымша, ол доптың қайдан келетінін көру қиын болатын түрі.
Dialogue: 0,0:17:24.25,0:17:28.21,Default,,0,0,0,,Әрбір қамырдың уақыты аздап өшірілген.
Dialogue: 0,0:17:28.21,0:17:31.60,Default,,0,0,0,,Егер мен сізге осыншама питтингті көрсете алсам →
Dialogue: 0,0:17:31.60,0:17:34.26,Default,,0,0,0,,Орындықты ауыстыру да қиын болады.
Dialogue: 0,0:17:34.26,0:17:39.25,Default,,0,0,0,,көремін. Стартер Фуруяны бірінші раундта ауыстырды →
Dialogue: 0,0:17:39.25,0:17:41.27,Default,,0,0,0,,Келесіде Савамура бар ма?
Dialogue: 0,0:17:41.27,0:17:45.56,Default,,0,0,0,,Бұл Якуши ұрып-соғу линейкасының көзі үйреніп қалмауы үшін жасалған стратегия ма?
Dialogue: 0,0:17:45.56,0:17:51.28,Default,,0,0,0,,Аа, Сейдо бұл матчты алмастыру арқылы шешуге ниетті.
Dialogue: 0,0:17:51.28,0:17:53.88,Default,,0,0,0,,Бірақ заттар осылай дамитын кезде→
Dialogue: 0,0:17:53.88,0:17:56.89,Default,,0,0,0,,Күрделі бөлігі оны ауыстыру.
Dialogue: 0,0:17:56.89,0:18:01.31,Default,,0,0,0,,Үшінші раундта құмыра жоспарланғандай ауыстырылады ма→
Dialogue: 0,0:18:01.31,0:18:05.25,Default,,0,0,0,,Әлде ағымдағы ағынға басымдық беру керек пе?
Dialogue: 0,0:18:05.25,0:18:10.67,Default,,0,0,0,,Якуши шайқастарының қашан жарылғанын ешқашан білмейсіз.
Dialogue: 0,0:18:10.67,0:18:14.60,Default,,0,0,0,,《Манака….
Dialogue: 0,0:18:14.60,0:18:18.56,Default,,0,0,0,,Осы матчты көруге келгеніңізге сене алар емеспін.
Dialogue: 0,0:18:18.56,0:18:21.55,Default,,0,0,0,,Сол жеңілістің ең таң қалдырғаны не болды?→
Dialogue: 0,0:18:21.55,0:18:24.41,Default,,0,0,0,,Тіпті сен》
Dialogue: 0,0:18:24.41,0:18:27.13,Default,,0,0,0,,Эй, Тамба бұқада болады.
Dialogue: 0,0:18:27.13,0:18:30.23,Default,,0,0,0,,Кеш шықтың, бейбақ.
Dialogue: 0,0:18:33.59,0:18:35.59,Default,,0,0,0,,Танба мырза….
Dialogue: 0,0:18:37.63,0:18:42.22,Default,,0,0,0,,4 иннинг қалды... Зейінді жоғалтпа, Каваками.
Dialogue: 0,0:18:42.22,0:18:46.84,Default,,0,0,0,,Бірінші жыл осы уақытқа дейін созылды.
Dialogue: 0,0:18:46.84,0:18:49.94,Default,,0,0,0,,Қалған иннингтер Біз оны міндетті түрде басқара аламыз.
Dialogue: 0,0:18:51.93,0:18:53.98,Default,,0,0,0,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:18:53.98,0:18:58.72,Default,,0,0,0,,♪♪~
Dialogue: 0,0:18:58.72,0:19:03.94,Default,,0,0,0,,《Омаэ: Түсіндім. Танба екеуміз бала кезден дос болдық, сондықтан...》
Dialogue: 0,0:19:03.94,0:19:07.82,Default,,0,0,0,,Эй, олардың эйстері бұқада.
Dialogue: 0,0:19:07.82,0:19:10.89,Default,,0,0,0,,Мына басына қараңыз.
Dialogue: 0,0:19:10.89,0:19:14.10,Default,,0,0,0,,Бұл тегіс. Монахты қараңызшы, оның басы жақсы.
Dialogue: 0,0:19:14.10,0:19:17.90,Default,,0,0,0,,Біз оларға қалағанын жасауға мүмкіндік бере аламыз ба?
Dialogue: 0,0:19:17.90,0:19:21.44,Default,,0,0,0,,Кобаяши Ота Қанша лас болса да.
Dialogue: 0,0:19:21.44,0:19:23.92,Default,,0,0,0,,Жүгірушілеріңізді Раиичидің алдына жинаңыз!
Dialogue: 0,0:19:23.92,0:19:26.38,Default,,0,0,0,,Сонда бұл жігіт бірдеңе жасайды.
Dialogue: 0,0:19:26.38,0:19:28.45,Default,,0,0,0,,Жоқ, рұқсат етіңіз!
Dialogue: 0,0:19:28.45,0:19:32.75,Default,,0,0,0,,Біздің өміріміз соған байланысты! !
Dialogue: 0,0:19:32.75,0:19:37.42,Default,,0,0,0,,Сол бірінші курс құмыра, оны лақтыруға ешқашан жол бермеңіз.
Dialogue: 0,0:19:37.42,0:19:45.55,Default,,0,0,0,,[Спикер] 6-шы иннингтік Якуши орта мектебінің шабуылы №8 қысқа қашықтықта Кобаяши болды.
Dialogue: 0,0:19:45.55,0:19:48.98,Default,,0,0,0,,《Бұл жолы Тодороки соққы ретін өзгертті...
Dialogue: 0,0:19:48.98,0:19:53.77,Default,,0,0,0,,Егер бәрі ойдағыдай болса, мен 3-ші раундтан бастап Кавакамиге ауысамын...
Dialogue: 0,0:19:53.77,0:19:57.92,Default,,0,0,0,,Алдыңғы айналымда Савамура Тодорокиді → толығымен жеңді
Dialogue: 0,0:19:57.92,0:20:01.80,Default,,0,0,0,,Басқа қамырлардың да уақыты нашар.
Dialogue: 0,0:20:01.80,0:20:05.15,Default,,0,0,0,,Директорды бағалау да қиын.
Dialogue: 0,0:20:05.15,0:20:10.25,Default,,0,0,0,,Бүгінгі Савамураның орнықтылығы сонша, оны ауыстыру босқа кетеді.
Dialogue: 0,0:20:13.11,0:20:16.19,Default,,0,0,0,,《Екінші соққыға дейін траекторияны мұқият бақылаңыз...
Dialogue: 0,0:20:16.19,0:20:19.29,Default,,0,0,0,,Мен бұған көніп қалуым керек.
Dialogue: 0,0:20:24.05,0:20:26.77,Default,,0,0,0,,≪Ереуіл!
Dialogue: 0,0:20:26.77,0:20:29.14,Default,,0,0,0,,Жақсы доп Савамура.
Dialogue: 0,0:20:29.14,0:20:32.74,Default,,0,0,0,,Ол керемет формада емес пе? Егер бұл орын алса, ол мүмкіндігінше алыс кете алады! !
Dialogue: 0,0:20:34.93,0:20:37.78,Default,,0,0,0,,《Кобаяши: Барлығы айтқандай, мен ат-батқа кіргенде →
Dialogue: 0,0:20:37.78,0:20:40.43,Default,,0,0,0,,Бұл көрінгеннен әлдеқайда жылдам сезіледі》
Dialogue: 0,0:20:40.43,0:20:42.39,Default,,0,0,0,,《Соққанның белгісі жоқ.
Dialogue: 0,0:20:42.39,0:20:44.59,Default,,0,0,0,,Уақытты өлшеу үшін жағдайды қарап жатырсыз ба?
Dialogue: 0,0:20:44.59,0:20:46.99,Default,,0,0,0,,Содан кейін...》
Dialogue: 0,0:20:46.99,0:20:48.88,Default,,0,0,0,,Польнареффтің қылышынан да жылдам болды. Құдай-ай!》
Dialogue: 0,0:20:48.88,0:20:51.93,Default,,0,0,0,,《Миюки: өз есебіңді табуға болады》
Dialogue: 0,0:20:51.93,0:20:53.88,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:20:53.88,0:20:56.22,Default,,0,0,0,,Жарайды, жақсы доп!
Dialogue: 0,0:20:56.22,0:20:58.23,Default,,0,0,0,,《Миюки: дәл ортасында.
Dialogue: 0,0:20:58.23,0:21:00.44,Default,,0,0,0,,Савамураның қарқыны жақсы.
Dialogue: 0,0:21:00.44,0:21:02.94,Default,,0,0,0,,Ойлануға уақыт бермеңіз.
Dialogue: 0,0:21:05.09,0:21:07.54,Default,,0,0,0,,Уақытша аяқ киім бауы!
Dialogue: 0,0:21:07.54,0:21:09.58,Default,,0,0,0,,《Миюки: Чичи》
Dialogue: 0,0:21:09.58,0:21:12.05,Default,,0,0,0,,《Кобаяши: Шүкір, бұл олардың қарқынында...
Dialogue: 0,0:21:12.05,0:21:14.88,Default,,0,0,0,,Сіз өз уақытыңызда жарғанаттағы кезекті алуыңыз керек.
Dialogue: 0,0:21:14.88,0:21:17.94,Default,,0,0,0,,Уау...
Dialogue: 0,0:21:17.94,0:21:19.89,Default,,0,0,0,,《Райнчи….
Dialogue: 0,0:21:19.89,0:21:24.58,Default,,0,0,0,,Мен саған жарғанақтың ең жақсы бұрылысын беремін.
Dialogue: 0,0:21:24.58,0:21:28.21,Default,,0,0,0,,Ол ақымақ, бірақ... бір ғана сермеумен →
Dialogue: 0,0:21:28.21,0:21:31.27,Default,,0,0,0,,Тек сіз толқынды өзгерте аласыз.
Dialogue: 0,0:21:31.27,0:21:33.22,Default,,0,0,0,,Уф.
Dialogue: 0,0:21:33.22,0:21:36.97,Default,,0,0,0,,《Қандай форманы алғаныңыз маңызды емес, міндетті түрде негізге алуыңыз керек...''
Dialogue: 0,0:21:36.97,0:21:39.47,Default,,0,0,0,,Ей, ақымақ... Лақтыруға тым тез! 》
Dialogue: 0,0:21:41.58,0:21:43.93,Default,,0,0,0,,Сәлем! !
Dialogue: 0,0:21:43.93,0:21:46.63,Default,,0,0,0,,Көшбасшы? Бауырым?
Dialogue: 0,0:21:46.63,0:21:48.63,Default,,0,0,0,,Қарғыс атсын! !
Dialogue: 0,0:21:51.39,0:21:55.44,Default,,0,0,0,,Раа~! Жарайды, жарайды, жарайды...
Dialogue: 0,0:21:55.44,0:21:57.38,Default,,0,0,0,,Хмм….
Dialogue: 0,0:21:57.38,0:21:59.40,Default,,0,0,0,,Уайымдама, Савамура!
Dialogue: 0,0:21:59.40,0:22:01.60,Default,,0,0,0,,Үйімнен алып едім, ұшқан жері...
Dialogue: 0,0:22:01.60,0:22:03.97,Default,,0,0,0,,Дұрыс! !
Dialogue: 0,0:22:03.97,0:22:06.42,Default,,0,0,0,,Бірде-бір жүйрік шыққан жоқ.
Dialogue: 0,0:22:06.42,0:22:10.89,Default,,0,0,0,,О, тағы бір адам шықса, енді не болады...
Dialogue: 0,0:22:10.89,0:22:13.88,Default,,0,0,0,,Кахахаха... Найбач Коба-сенпай.
Dialogue: 0,0:22:13.88,0:22:16.93,Default,,0,0,0,,Директор Бұл ешқайсысы жоқ жүгіруші.
Dialogue: 0,0:22:16.93,0:22:20.28,Default,,0,0,0,,Тек осы көріністе Гецзу... Мен қатты толқып тұрмын!
Dialogue: 0,0:22:20.28,0:22:24.78,Default,,0,0,0,,[Баяндамашы] №9 орталық Ота мырза.
Dialogue: 0,0:22:31.71,0:22:33.71,Default,,0,0,0,,А, енді.
Dialogue: 0,0:22:33.71,0:22:35.78,Default,,0,0,0,,《Ол》
Dialogue: 0,0:22:35.78,0:22:38.15,Default,,0,0,0,,Кел, эй!
Dialogue: 0,0:22:38.15,0:22:40.60,Default,,0,0,0,,《Ота сен》
Dialogue: 0,0:22:40.60,0:22:43.64,Default,,0,0,0,,Сәлем! Джи~.
Dialogue: 0,0:22:43.64,0:22:46.74,Default,,0,0,0,,Сіз тынышсыз. Мен жүгірушілерді анық көріп тұрмын.
Dialogue: 0,0:22:50.26,0:22:52.72,Default,,0,0,0,,《Миюки: Якушиде тоқаш жоқ.
Dialogue: 0,0:22:52.72,0:22:55.37,Default,,0,0,0,,Базаны бірінші рет ұрлай алмағаннан кейін →
Dialogue: 0,0:22:55.37,0:22:59.14,Default,,0,0,0,,Менің ойымша, бұл оңай қозғалмайды.
Dialogue: 0,0:22:59.14,0:23:02.14,Default,,0,0,0,,Ұпайлар айырмасы 4 ұпай. Егер мен дәйекті соққылардың алдын алсам》
Dialogue: 0,0:23:07.60,0:23:10.68,Default,,0,0,0,,《Крис: Медицина қызметкері айқайлайды! 》
Dialogue: 0,0:23:10.68,0:23:12.92,Default,,0,0,0,,((Тодороки: Қараңызшы, сізде бәрі жақсы.
Dialogue: 0,0:23:12.92,0:23:15.39,Default,,0,0,0,,Негізінде мен бөртпе белгілерін бермеймін.
Dialogue: 0,0:23:15.39,0:23:19.93,Default,,0,0,0,,Мен бұл кездейсоқ шабуылдардан ешқандай романс таба алмаймын.
Dialogue: 0,0:23:19.93,0:23:23.41,Default,,0,0,0,,Дегенмен, егер сіз шынымен де шыққыңыз келсе →
Dialogue: 0,0:23:23.41,0:23:25.48,Default,,0,0,0,,Мені тоқтатпа.
Dialogue: 0,0:23:25.48,0:23:27.52,Default,,0,0,0,,Бұл орын алғанда, маған бұрылыңыз→
Dialogue: 0,0:23:27.52,0:23:29.42,Default,,0,0,0,,Мына белгіні көрсетіңіз.
Dialogue: 0,0:23:29.42,0:23:34.42,Default,,0,0,0,,Алаңда тұрған кез келген адам сізге қандай да бір нұсқау бере алады деп ойламаңыз.
Dialogue: 0,0:23:34.42,0:23:39.41,Default,,0,0,0,,Өзіңіз ойлаңыз және өз ісіңізге жауапкершілік алыңыз))
Dialogue: 0,0:23:39.41,0:23:42.00,Default,,0,0,0,,♬~
Dialogue: 0,0:23:42.00,0:23:43.88,Default,,0,0,0,,《Доптың импульсі өлді.
Dialogue: 0,0:23:43.88,0:23:47.77,Default,,0,0,0,,Бұл кеше және бүгін жаттығатын тоқаш емес.
Dialogue: 0,0:23:47.77,0:23:51.54,Default,,0,0,0,,Бірінші!
Dialogue: 0,0:23:51.54,0:23:53.93,Default,,0,0,0,,Керемет Ота! Керемет соққы!
Dialogue: 0,0:23:53.93,0:23:55.96,Default,,0,0,0,,Енді жүгіруші екінші негізде тұр.
Dialogue: 0,0:23:55.96,0:23:58.60,Default,,0,0,0,,《Мен өз мүмкіндігімді алып кету арқылы құртқым келеді →
Dialogue: 0,0:23:58.60,0:24:00.92,Default,,0,0,0,,Өлсең де жүйрікті жібер.
Dialogue: 0,0:24:00.92,0:24:04.40,Default,,0,0,0,,Ей, балалар, ақыры, миыңызды пайдалана аласыз →
Dialogue: 0,0:24:04.40,0:24:06.42,Default,,0,0,0,,Олай болған жоқ па?
Dialogue: 0,0:24:06.42,0:24:08.93,Default,,0,0,0,,Қарғыс атсын, мен сендермен біргемін →
Dialogue: 0,0:24:08.93,0:24:12.10,Default,,0,0,0,,Жерде жүгіру》
Dialogue: 0,0:24:12.10,0:24:15.06,Default,,0,0,0,,≪Дәрігерді бірінші рет көруім.
Dialogue: 0,0:24:15.06,0:24:17.90,Default,,0,0,0,,≪Сонымен сіз ұпай жинауға тырысып жатырсыз ба?
Dialogue: 0,0:24:17.90,0:24:20.25,Default,,0,0,0,,Оның үстіне келесі қамыр...
Dialogue: 0,0:24:20.25,0:24:24.32,Default,,0,0,0,,♪♪~
Dialogue: 0,0:24:24.32,0:24:29.10,Default,,0,0,0,,[Баяндамашы] Үшінші Тодороки.
Dialogue: 0,0:24:29.10,0:24:33.25,Default,,0,0,0,,≪Құбыжық құбыжық пайда болды! ≪Таңғажайып соққы!
Dialogue: 0,0:24:33.25,0:24:36.17,Default,,0,0,0,,Уа. ≪Мен жақын арада қарсы шабуыл көргім келеді!
Dialogue: 0,0:24:36.17,0:24:38.05,Default,,0,0,0,,≪Бірдеңе істе~!
Dialogue: 0,0:24:38.05,0:24:40.59,Default,,0,0,0,,Раиичи! Тодороки!
Dialogue: 0,0:24:40.59,0:24:43.26,Default,,0,0,0,,Бұл үлкен қуаныш.
Dialogue: 0,0:24:43.26,0:24:46.75,Default,,0,0,0,,Әй, аудитория бір жерден күткен шығар.
Dialogue: 0,0:24:46.75,0:24:51.25,Default,,0,0,0,,Қалалық соғыс сияқты дүрбелең...
Dialogue: 0,0:24:51.25,0:24:55.39,Default,,0,0,0,,Бұл Тодорокидің Савамура-кунға қарсы екінші кезегі.
Dialogue: 0,0:24:55.39,0:24:59.26,Default,,0,0,0,,Бірдей шабуыл әдісі міндетті түрде жұмыс істемейді.
Dialogue: 0,0:24:59.26,0:25:03.40,Default,,0,0,0,,Енді Seido Bench қалай жұмыс істейді?
Dialogue: 0,0:25:03.40,0:25:07.05,Default,,0,0,0,,Тіпті осы уақытқа дейін жақсы ойнаған Савамура-кунды алмастыру →
Dialogue: 0,0:25:07.05,0:25:09.62,Default,,0,0,0,,Сіз өту алаңдарын ұстануға батылыңыз бар ма?
Dialogue: 0,0:25:09.62,0:25:12.22,Default,,0,0,0,,Немесе...
Dialogue: 0,0:25:13.72,0:25:19.72,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory