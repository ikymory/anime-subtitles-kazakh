Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:33.32,0:00:36.21,Default,,0,0,0,,Ол міндетті түрде қызықты доп лақтырады →
Dialogue: 0,0:00:36.21,0:00:39.33,Default,,0,0,0,,Сіз бір жыл бұрынғыдан басқа адамсыз.
Dialogue: 0,0:00:39.33,0:00:41.87,Default,,0,0,0,,Бірақ бәрібір өрескел.
Dialogue: 0,0:00:41.87,0:00:47.51,Default,,0,0,0,,Шынымды айтсам, мен оның бұл эйс нөмірін арқасына көтеріп жүргенін елестете алмаймын.
Dialogue: 0,0:00:47.51,0:00:49.96,Default,,0,0,0,,Бұл қиын. Сен ақымақсың ба?
Dialogue: 0,0:00:49.96,0:00:52.04,Default,,0,0,0,,Олай десеңіз, қазіргі үш жыл жақсы→
Dialogue: 0,0:00:52.04,0:00:54.66,Default,,0,0,0,,Бұдан да жаман болуы мүмкін еді!
Dialogue: 0,0:00:54.66,0:00:57.35,Default,,0,0,0,,Ал, Крис ерекше нәрсе жасады →
Dialogue: 0,0:00:57.35,0:01:01.35,Default,,0,0,0,,Қалғандары Борокас жасады!
Dialogue: 0,0:01:01.35,0:01:03.80,Default,,0,0,0,,Азума-сенпайдың көзқарасы бойынша бұл кез келген адам болуы мүмкін...
Dialogue: 0,0:01:03.80,0:01:06.87,Default,,0,0,0,,Жоқ, жоқ, басында өте нашар болды.
Dialogue: 0,0:01:06.87,0:01:11.48,Default,,0,0,0,,《Фуруя: Үшінші курс студенттері Борокасу ма? 》
Dialogue: 0,0:01:11.48,0:01:17.78,Default,,0,0,0,,Ақырында, қанша өсе алатының маңызды емес.
Dialogue: 0,0:01:21.87,0:01:24.37,Default,,0,0,0,,Соны әлгі қаншық баласына айт.
Dialogue: 0,0:04:06.37,0:04:08.37,Default,,0,0,0,,Фуши!
Dialogue: 0,0:04:12.79,0:04:16.71,Default,,0,0,0,,Фуши!
Dialogue: 0,0:04:16.71,0:04:19.31,Default,,0,0,0,,Керемет доп!
Dialogue: 0,0:04:21.30,0:04:24.21,Default,,0,0,0,,Иә? Ол адам қайтып келді ме?
Dialogue: 0,0:04:24.21,0:04:27.84,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:04:27.84,0:04:30.64,Default,,0,0,0,,Мен сені ұрғаным үшін кешірім сұраған жоқпын.
Dialogue: 0,0:04:32.88,0:04:36.45,Default,,0,0,0,,Каваками: Сен де.
Dialogue: 0,0:04:36.45,0:04:39.00,Default,,0,0,0,,((Мен өзіме ұнайтын адамдар туралы ғана ойлаймын.
Dialogue: 0,0:04:39.00,0:04:41.54,Default,,0,0,0,,Ол құмыра, бәрібір→
Dialogue: 0,0:04:41.54,0:04:44.88,Default,,0,0,0,,Сенімдірек лақтыруға болады))
Dialogue: 0,0:04:44.88,0:04:46.98,Default,,0,0,0,,Азума мырза….
Dialogue: 0,0:04:50.01,0:04:52.47,Default,,0,0,0,,Крис.
Dialogue: 0,0:04:52.47,0:04:56.22,Default,,0,0,0,,Барлық құмыраларды созуға дайындаңыз.
Dialogue: 0,0:04:56.22,0:04:58.32,Default,,0,0,0,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:05:00.29,0:05:05.76,Default,,0,0,0,,Юки: Матчқа дейін ұрыңыз, мен бұл нағыз ойын сияқты шешемін!
Dialogue: 0,0:05:05.76,0:05:07.67,Default,,0,0,0,,Иә! (Курамочи) Ша~!
Dialogue: 0,0:05:07.67,0:05:10.05,Default,,0,0,0,,Уга~! (Исашики) Эй!
Dialogue: 0,0:05:10.05,0:05:12.10,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:05:12.10,0:05:30.97,Default,,0,0,0,,♪♪~
Dialogue: 0,0:05:30.97,0:05:34.68,Default,,0,0,0,,Сырттағы доп екінші! Барайық!
Dialogue: 0,0:05:34.68,0:05:37.80,Default,,0,0,0,,♪♪~
Dialogue: 0,0:05:37.80,0:05:41.15,Default,,0,0,0,,Келіңіздер! Эй!
Dialogue: 0,0:05:41.15,0:05:46.65,Default,,0,0,0,,♪♪~
Dialogue: 0,0:05:46.65,0:05:50.52,Default,,0,0,0,,Алдымен ішкі доп!
Dialogue: 0,0:05:50.52,0:05:52.59,Default,,0,0,0,,Техникалық колледжде күтіп тұрған сиқыршыларды мүмкіндігінше үнсіз жойып жібергім келеді.
Dialogue: 0,0:05:52.59,0:05:55.66,Default,,0,0,0,,♪♪~
Dialogue: 0,0:05:55.66,0:05:57.67,Default,,0,0,0,,Тынш!
Dialogue: 0,0:05:57.67,0:06:03.15,Default,,0,0,0,,♪♪~
Dialogue: 0,0:06:03.15,0:06:06.62,Default,,0,0,0,,О, қандай ұлы рух! (Исашики) Жүр!
Dialogue: 0,0:06:06.62,0:06:09.16,Default,,0,0,0,,Ішке кіріңіз!
Dialogue: 0,0:06:09.16,0:06:16.12,Default,,0,0,0,,♪♪~
Dialogue: 0,0:06:16.12,0:06:18.14,Default,,0,0,0,,Хяха!
Dialogue: 0,0:06:18.14,0:06:23.44,Default,,0,0,0,,♪♪~
Dialogue: 0,0:06:27.46,0:06:29.71,Default,,0,0,0,,((Азума: Крис ерекше нәрсе жасады, дегенмен →
Dialogue: 0,0:06:29.71,0:06:32.81,Default,,0,0,0,,Қалғандарының бәрі Борокас жасады! ))
Dialogue: 0,0:06:35.50,0:06:40.06,Default,,0,0,0,,《Фуруя: Борокасу... Мына адамдар ма? 》
Dialogue: 0,0:06:40.06,0:06:43.86,Default,,0,0,0,,Азума-кунның айтқанына сенбейсің бе?
Dialogue: 0,0:06:46.50,0:06:49.83,Default,,0,0,0,,Қазіргі 3-сыныпты ғана көргендер үшін →
Dialogue: 0,0:06:49.83,0:06:52.55,Default,,0,0,0,,Сене алмайтыным табиғи шығар, бірақ→
Dialogue: 0,0:06:52.55,0:06:56.35,Default,,0,0,0,,Оның айтқаны рас болды.
Dialogue: 0,0:06:58.36,0:07:01.75,Default,,0,0,0,,Нашар өнім алған жыл.
Dialogue: 0,0:07:01.75,0:07:04.30,Default,,0,0,0,,Ол балалар мектепке келгенде →
Dialogue: 0,0:07:04.30,0:07:07.50,Default,,0,0,0,,Адамдар мені осылай атайтын.
Dialogue: 0,0:07:07.50,0:07:13.49,Default,,0,0,0,,Не? Сіз бұл жұмыс істемейді деп нені айтып отырсыз?
Dialogue: 0,0:07:13.49,0:07:16.58,Default,,0,0,0,,Үшінші курс студенттері де сіз сияқты →
Dialogue: 0,0:07:16.58,0:07:21.08,Default,,0,0,0,,Әу бастан-ақ бәрі мықты емес.
Dialogue: 0,0:07:32.16,0:07:35.18,Default,,0,0,0,,((Сакай: Казама орта мектебінен Ичиро Сакай.
Dialogue: 0,0:07:35.18,0:07:38.85,Default,,0,0,0,,Сырттан қорғаушы қажет. Мен бар күшімді саламын.
Dialogue: 0,0:07:38.85,0:07:40.78,Default,,0,0,0,,Мұнда жоқ! Қайда ол?!
Dialogue: 0,0:07:40.78,0:07:43.99,Default,,0,0,0,,Иә, Аягами ағадан Джун Исашики.
Dialogue: 0,0:07:43.99,0:07:46.36,Default,,0,0,0,,Менің қалаған позициям, әрине, құмыра!
Dialogue: 0,0:07:46.36,0:07:48.41,Default,,0,0,0,,Мен сүйетін құмыра - Номо.
Dialogue: 0,0:07:48.41,0:07:50.33,Default,,0,0,0,,Менің сүйікті бірінші бейсменім - Очиай.
Dialogue: 0,0:07:50.33,0:07:53.30,Default,,0,0,0,,Екінші басшы – Хитоши. Накамура - үшінші бейсмен.
Dialogue: 0,0:07:53.30,0:07:55.33,Default,,0,0,0,,Қысқасы…. Күтіңіз, күтіңіз, күтіңіз!
Dialogue: 0,0:07:55.33,0:07:57.47,Default,,0,0,0,,Сіз маған барлық позицияларды айтасыз ба?
Dialogue: 0,0:07:57.47,0:08:00.42,Default,,0,0,0,,Жоқ? Мен саған әлі қызық емеспін!
Dialogue: 0,0:08:00.42,0:08:02.72,Default,,0,0,0,,Сасен!
Dialogue: 0,0:08:06.63,0:08:08.66,Default,,0,0,0,,≪Келесі!
Dialogue: 0,0:08:08.66,0:08:12.57,Default,,0,0,0,,Oura Junior High School оқушысы Тору Масуко далада ойнауға үміттенеді.
Dialogue: 0,0:08:12.57,0:08:14.97,Default,,0,0,0,,Емтихан тапсыру арқылы 10 кг қостым.
Dialogue: 0,0:08:14.97,0:08:17.39,Default,,0,0,0,,≪Сылтау айтпа!
Dialogue: 0,0:08:17.39,0:08:21.34,Default,,0,0,0,,Орта мектеп... Қайдан... Танба... Ро.
Dialogue: 0,0:08:21.34,0:08:24.26,Default,,0,0,0,,≪Денесі үлкен болса да даусы кішкентай.
Dialogue: 0,0:08:24.26,0:08:28.68,Default,,0,0,0,,Йоко орта мектебінен Риосуке Коминато. Ішкі қорғаушы қалаған.
Dialogue: 0,0:08:28.68,0:08:32.64,Default,,0,0,0,,Мен тек жақсы фигурасы бар адамға ешқашан жеңілмеймін.
Dialogue: 0,0:08:32.64,0:08:35.32,Default,,0,0,0,,Акадо орта мектебінен Тецуя Юуки.
Dialogue: 0,0:08:35.32,0:08:38.49,Default,,0,0,0,,Арнайы қажет позиция жоқ. Сіз оны кез келген жерде қорғай аласыз.
Dialogue: 0,0:08:38.49,0:08:40.51,Default,,0,0,0,,≪О. ≪Мен айтамын.
Dialogue: 0,0:08:40.51,0:08:43.35,Default,,0,0,0,,Менің сүйікті тарихи драмам ``Жалғыз қасқыр мен күшік''.
Dialogue: 0,0:08:43.35,0:08:45.30,Default,,0,0,0,,Мені тыңдама.
Dialogue: 0,0:08:45.30,0:08:47.33,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:08:47.33,0:08:50.14,Default,,0,0,0,,《Бұл не сұмдық? Сен сондай дәмді ақымақсың.》
Dialogue: 0,0:08:50.14,0:08:53.52,Default,,0,0,0,,Крис Ю Такигава, Marugame Senior.
Dialogue: 0,0:08:53.52,0:08:56.66,Default,,0,0,0,,Қалаған позиция - ұстаушы.
Dialogue: 0,0:08:56.66,0:08:59.31,Default,,0,0,0,,Әй, бұл жаңағы қауесет.
Dialogue: 0,0:08:59.31,0:09:01.87,Default,,0,0,0,,Бұл Жануардың баласы, солай ма?
Dialogue: 0,0:09:01.87,0:09:03.87,Default,,0,0,0,,《Мм》
Dialogue: 0,0:09:06.12,0:09:08.17,Default,,0,0,0,,《Крис...》
Dialogue: 0,0:09:08.17,0:09:11.29,Default,,0,0,0,,《Ммф, қазір көңіл көтеріңіз.
Dialogue: 0,0:09:11.29,0:09:15.00,Default,,0,0,0,,Мен бірінші болып тұрақты боламын.
Dialogue: 0,0:09:15.00,0:09:19.90,Default,,0,0,0,,Сен мұнда не істеп жүрсің? Рұқсатсыз желіні бұзбаңыз, кері қайтыңыз! !
Dialogue: 0,0:09:19.90,0:09:22.04,Default,,0,0,0,,Сасен!
Dialogue: 0,0:09:22.04,0:09:24.04,Default,,0,0,0,,Уау! !
Dialogue: 0,0:09:26.19,0:09:28.79,Default,,0,0,0,,Сіз қалай ойлайсыз? Менің базука добым.
Dialogue: 0,0:09:28.79,0:09:31.20,Default,,0,0,0,,Ереуіл мүлде жоқ. Ақымақ!
Dialogue: 0,0:09:31.20,0:09:33.73,Default,,0,0,0,,Менің негізім мықты, дегенмен→
Dialogue: 0,0:09:33.73,0:09:36.83,Default,,0,0,0,,Бұл басқару құмыралар үшін қиын.
Dialogue: 0,0:09:40.90,0:09:42.79,Default,,0,0,0,,Ах... Кешіріңіз.
Dialogue: 0,0:09:42.79,0:09:45.01,Default,,0,0,0,,Әр кезде кешірім сұраудың қажеті жоқ, Тамба.
Dialogue: 0,0:09:45.01,0:09:49.45,Default,,0,0,0,,Қасымдағы жігітпен салыстырғанда мен де қалыспаймын.
Dialogue: 0,0:09:49.45,0:09:51.45,Default,,0,0,0,,А, иә, кешіріңіз.
Dialogue: 0,0:09:55.52,0:09:58.32,Default,,0,0,0,,Мен сені кез келген жерде қорғай аламын, Юки!
Dialogue: 0,0:09:58.32,0:10:00.79,Default,,0,0,0,,Сіз ештеңені қорғай алмайсыз! иә?
Dialogue: 0,0:10:00.79,0:10:03.21,Default,,0,0,0,,Қолғаптар жаман емес.
Dialogue: 0,0:10:03.21,0:10:07.66,Default,,0,0,0,,Мияучи: Сізге көбірек бұлшықет салу керек, әйтпесе жүгірушілер сізді таң қалдырмайды!
Dialogue: 0,0:10:07.66,0:10:10.68,Default,,0,0,0,,Протеинді ішіңіз.
Dialogue: 0,0:10:10.68,0:10:12.67,Default,,0,0,0,,Киіміңіз жараспайды.
Dialogue: 0,0:10:12.67,0:10:16.81,Default,,0,0,0,,Бұл жақсы. Ақырында сіздің өлшеміңізге сәйкес келетін денеңіз болады.
Dialogue: 0,0:10:16.81,0:10:19.33,Default,,0,0,0,,≪Бір жыл! Доп әлі домалап жатыр! !
Dialogue: 0,0:10:19.33,0:10:21.35,Default,,0,0,0,,<<Оны дұрыстап тазалаңыз.
Dialogue: 0,0:10:21.35,0:10:23.85,Default,,0,0,0,,Бұл... Жақсысың ба? Сол балалар...
Dialogue: 0,0:10:28.40,0:10:30.80,Default,,0,0,0,,《Қарғыс атсын, тез лақтырамын》
Dialogue: 0,0:10:30.80,0:10:32.87,Default,,0,0,0,,《Мәселе қорғаныста ма?》
Dialogue: 0,0:10:32.87,0:10:34.97,Default,,0,0,0,,《Қозғалу қиын》
Dialogue: 0,0:10:37.01,0:10:39.95,Default,,0,0,0,,《Ни... Ет тоқаш, Анман...》
Dialogue: 0,0:10:39.95,0:10:42.25,Default,,0,0,0,,《Алдымен адамдардың көздеріне қарап, олармен сөйлесіңіз》
Dialogue: 0,0:10:45.00,0:10:47.02,Default,,0,0,0,,Ей, көбірек же!
Dialogue: 0,0:10:47.02,0:10:50.06,Default,,0,0,0,,Бірінші жыл не болды? Менің таяқшаларым тоқтап қалды... Масуко! Сіз жемейсіз.
Dialogue: 0,0:10:50.06,0:11:01.37,Default,,0,0,0,,♪♪~
Dialogue: 0,0:11:01.37,0:11:03.37,Default,,0,0,0,,Дене...
Dialogue: 0,0:11:06.01,0:11:09.63,Default,,0,0,0,,Балалар сендерге не болды? Тезірек Юки сияқты демалыңыз.
Dialogue: 0,0:11:09.63,0:11:15.33,Default,,0,0,0,,♪♪~
Dialogue: 0,0:11:15.33,0:11:17.47,Default,,0,0,0,,Еңбегіңіз үшін рахмет!
Dialogue: 0,0:11:17.47,0:11:20.30,Default,,0,0,0,,Ой, бұлардың бәрі менеджер ме?
Dialogue: 0,0:11:20.30,0:11:22.32,Default,,0,0,0,,Дәмді көрінеді!
Dialogue: 0,0:11:22.32,0:11:26.43,Default,,0,0,0,,Жарайды... бұл менің ағам ұстағандықтан болды→
Dialogue: 0,0:11:26.43,0:11:28.53,Default,,0,0,0,,Менікі... бұл.
Dialogue: 0,0:11:31.01,0:11:34.32,Default,,0,0,0,,Осы арқылы мен күні бойы жұмыс істей аламын.
Dialogue: 0,0:11:34.32,0:11:38.17,Default,,0,0,0,,Бұл өте көп, сондықтан оны жеуге болады.
Dialogue: 0,0:11:38.17,0:11:40.22,Default,,0,0,0,,Иә, көбірек тамақтаныңыз.
Dialogue: 0,0:11:40.22,0:11:42.68,Default,,0,0,0,,Тәжірибе жалғасады. Usu!
Dialogue: 0,0:11:42.68,0:11:45.18,Default,,0,0,0,,《Құсума, анау жігіт》 《Мүлдем құсу》
Dialogue: 0,0:11:45.18,0:11:47.35,Default,,0,0,0,,《Өлді》 《Байғұс》
Dialogue: 0,0:11:47.35,0:11:49.35,Default,,0,0,0,,Сіз тамақ ішпейсіз!
Dialogue: 0,0:11:52.39,0:11:55.49,Default,,0,0,0,,《Жоқ, мен тым көп жедім》
Dialogue: 0,0:11:57.49,0:12:01.35,Default,,0,0,0,,《Исашики: Ақырында ол 1-ші армияда бірінші болды》
Dialogue: 0,0:12:01.35,0:12:04.70,Default,,0,0,0,,Сәлем Крис.
Dialogue: 0,0:12:04.70,0:12:07.33,Default,,0,0,0,,Саған да қиын болады.
Dialogue: 0,0:12:07.33,0:12:11.17,Default,,0,0,0,,Сенің ұрпағың бір топ ебос емес пе?
Dialogue: 0,0:12:11.17,0:12:14.39,Default,,0,0,0,,(Шығыс күлкі)
Dialogue: 0,0:12:14.39,0:12:18.49,Default,,0,0,0,,Жоқ, бұл жігіттердің болашағы жоқ.
Dialogue: 0,0:12:25.14,0:12:27.97,Default,,0,0,0,,(Шығыс күлкі)
Dialogue: 0,0:12:27.97,0:12:31.17,Default,,0,0,0,,《Мен солай ойлаймын...》
Dialogue: 0,0:12:31.17,0:12:34.21,Default,,0,0,0,,(Қоңырау шалу)
Dialogue: 0,0:12:34.21,0:12:36.21,Default,,0,0,0,,Нара!
Dialogue: 0,0:12:43.37,0:12:47.87,Default,,0,0,0,,<Рйосуке: Егер сіз орта мектепте бейсбол ойнағыңыз келсе, Кошиенді көздейтін командада болыңыз.>
Dialogue: 0,0:12:51.66,0:12:53.83,Default,,0,0,0,,Керемет, Крис. Керемет ойын!
Dialogue: 0,0:12:53.83,0:12:57.77,Default,,0,0,0,,<Мияучи: 1 жылда қосылды стенд, 2 жылдан кейін тұрақты>
Dialogue: 0,0:12:57.77,0:13:01.87,Default,,0,0,0,,<Масуко: Кошиенге үшінші курста негізгі тірек ретінде қатысты>
Dialogue: 0,0:13:03.84,0:13:05.88,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:13:05.88,0:13:08.50,Default,,0,0,0,,<Юки: Әркімнің жүрегінде болған амбиция...>
Dialogue: 0,0:13:08.50,0:13:11.80,Default,,0,0,0,,<Исашики: Кішкене алаңдаушылық>
Dialogue: 0,0:13:11.80,0:13:15.84,Default,,0,0,0,,Сен ақымақсың. Сіз өзіңізді шаршатып жіберетін нәрсені істеу үшін бар күшіңізді саласыз.
Dialogue: 0,0:13:15.84,0:13:18.29,Default,,0,0,0,,Эй.
Dialogue: 0,0:13:18.29,0:13:20.37,Default,,0,0,0,,《Қарғыс атсын мына жігіт...》
Dialogue: 0,0:13:20.37,0:13:24.37,Default,,0,0,0,,Күте тұрыңыз! Менің алдымда көрінбе!
Dialogue: 0,0:14:31.31,0:14:33.35,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:14:33.35,0:14:35.43,Default,,0,0,0,,[Майк] Матч аяқталды!
Dialogue: 0,0:14:35.43,0:14:39.93,Default,,0,0,0,,[Майк] 4-тен 5-ке дейінгі Сейдо орта мектебі Үздік 4-ке кірмейді.
Dialogue: 0,0:14:43.09,0:14:48.59,Default,,0,0,0,,[Майк] Жартылай финалға өткен команда біздің көптен бергі қарсыласымыз City University Үшінші орта мектебі болды!
Dialogue: 0,0:14:55.20,0:14:59.30,Default,,0,0,0,,《Исашики: Біздің үлкендер жеңіліп қалды...》
Dialogue: 0,0:15:06.35,0:15:10.87,Default,,0,0,0,,Жеңілген команда үшін жазғы демалыс тым ерте келеді.
Dialogue: 0,0:15:10.87,0:15:15.97,Default,,0,0,0,,Жаңа команда келесі жазда кек алуға уәде берді.
Dialogue: 0,0:15:19.34,0:15:21.68,Default,,0,0,0,,Не? иықпен →
Dialogue: 0,0:15:21.68,0:15:23.83,Default,,0,0,0,,Жақсы соққы.
Dialogue: 0,0:15:23.83,0:15:26.63,Default,,0,0,0,,Мен оны команда үшін пайдаланғаныңызды қалаймын.
Dialogue: 0,0:15:26.63,0:15:30.63,Default,,0,0,0,,《Бірақ… сыртқы қорғаушы…》
Dialogue: 0,0:15:34.22,0:15:39.88,Default,,0,0,0,,<Исашики: Мен беделді команда ретінде танымал команданы жеңіл қабылдаған жоқпын.>
Dialogue: 0,0:15:39.88,0:15:44.68,Default,,0,0,0,,Немесе… бұл туралы ойлануға рұқсат етіңіз.
Dialogue: 0,0:15:56.33,0:15:58.40,Default,,0,0,0,,(жөтел дауысы)
Dialogue: 0,0:15:58.40,0:16:00.90,Default,,0,0,0,,Амансың ба? Сақай.
Dialogue: 0,0:16:02.84,0:16:06.62,Default,,0,0,0,,Енді жоқ... Мен ілесе алмаймын.
Dialogue: 0,0:16:06.62,0:16:11.66,Default,,0,0,0,,<Тамба: идеал мен шындық арасындағы алшақтық әлі де өсуде>
Dialogue: 0,0:16:11.66,0:16:13.98,Default,,0,0,0,,(жөтел дауысы)
Dialogue: 0,0:16:13.98,0:16:17.17,Default,,0,0,0,,<Рйосуке: Осы жерден тоқтаймыз ба...?
Dialogue: 0,0:16:17.17,0:16:22.66,Default,,0,0,0,,Әлде алға жылжуым керек пе?
Dialogue: 0,0:16:22.66,0:16:38.62,Default,,0,0,0,,♪♪~
Dialogue: 0,0:16:38.62,0:16:40.71,Default,,0,0,0,,《Исашики…》
Dialogue: 0,0:16:40.71,0:16:44.71,Default,,0,0,0,,Қиналған жалғыз сен емессің.
Dialogue: 0,0:16:55.72,0:16:59.22,Default,,0,0,0,,<Юки: Аман қалудың жалғыз жолы - алға қарау>
Dialogue: 0,0:17:07.37,0:17:09.37,Default,,0,0,0,,<Сақай: Алдыңда...! ＞
Dialogue: 0,0:17:17.18,0:17:19.66,Default,,0,0,0,,Не істеп жатырсың! Бекітіңіз!
Dialogue: 0,0:17:19.66,0:17:22.16,Default,,0,0,0,,Егер ол тартқышқа түспесе, оны денеңізбен тоқтатыңыз!
Dialogue: 0,0:17:25.89,0:17:28.39,Default,,0,0,0,,Доптан көзіңді алма!
Dialogue: 0,0:17:30.29,0:17:32.38,Default,,0,0,0,,Айналаңа қарап қалма!
Dialogue: 0,0:17:32.38,0:17:35.38,Default,,0,0,0,,Төбеге шыққанда зейініңді питтингке аудар!
Dialogue: 0,0:17:43.65,0:17:47.67,Default,,0,0,0,,Менде шоғырлану жеткіліксіз! Жасағыңыз келмесе, кетіңіз!
Dialogue: 0,0:17:47.67,0:17:51.14,Default,,0,0,0,,Уау... Директор: Бұл әдеттегіден де қатал.
Dialogue: 0,0:17:51.14,0:17:53.55,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:17:53.55,0:17:56.85,Default,,0,0,0,,Жаңа командада осындай нашар жыл болған болуы керек.
Dialogue: 0,0:18:06.16,0:18:08.30,Default,,0,0,0,,《Исашики: Мен оны көруді шыдамаймын...
Dialogue: 0,0:18:08.30,0:18:11.33,Default,,0,0,0,,Мен оның осылай аяқталуын күте алмаймын!
Dialogue: 0,0:18:11.33,0:18:13.75,Default,,0,0,0,,Тіпті сырт алаңда жақсы!
Dialogue: 0,0:18:13.75,0:18:17.35,Default,,0,0,0,,Егер аман қалудың жалғыз жолы осы болса, мен ілулі тұрамын! 》
Dialogue: 0,0:18:24.04,0:18:26.14,Default,,0,0,0,,《Исашики: Юки…》
Dialogue: 0,0:18:30.57,0:18:33.34,Default,,0,0,0,,Не істеп жатырсың! Осындай уақытта!
Dialogue: 0,0:18:33.34,0:18:37.81,Default,,0,0,0,,Онда бармайсың ба?
Dialogue: 0,0:18:37.81,0:18:42.16,Default,,0,0,0,,Мүмкін сіз онымен күнде қалып, жұмыс істеген шығарсыз?
Dialogue: 0,0:18:42.16,0:18:44.63,Default,,0,0,0,,Ей, бүгін кешкі асқа не ішесің?
Dialogue: 0,0:18:44.63,0:18:47.13,Default,,0,0,0,,Бұл рамен емес пе? О, жақсы!
Dialogue: 0,0:18:50.50,0:18:53.16,Default,,0,0,0,,Ха! ? Күніне 500 тербеліс! ?
Dialogue: 0,0:18:53.16,0:18:58.14,Default,,0,0,0,,мектепте 300, үйде 200. Шынайы!
Dialogue: 0,0:18:58.14,0:19:02.17,Default,,0,0,0,,Осы мектепке келуге шешім қабылдаған кезден бастап квота.
Dialogue: 0,0:19:02.17,0:19:06.20,Default,,0,0,0,,Бұлай жалғаспаса, біз бұл жерде аман қала алмаймыз.
Dialogue: 0,0:19:06.20,0:19:09.17,Default,,0,0,0,,《Бұл жігіт...》
Dialogue: 0,0:19:09.17,0:19:13.06,Default,,0,0,0,,Менің денем үйренгеннен кейін оны тағы біраз көбейтемін деп ойлаймын.
Dialogue: 0,0:19:13.06,0:19:15.13,Default,,0,0,0,,Көбейтпе, ақымақ!
Dialogue: 0,0:19:15.13,0:19:17.35,Default,,0,0,0,,Енді сіз осындасыз→
Dialogue: 0,0:19:17.35,0:19:22.99,Default,,0,0,0,,Өйткені, әр адамның белгілі бір деңгейі бар.
Dialogue: 0,0:19:22.99,0:19:29.06,Default,,0,0,0,,Біз де араласа аламыз ба? Менің ағамның қорылдағаны соншалықты қатты.
Dialogue: 0,0:19:29.06,0:19:32.56,Default,,0,0,0,,Масуко Коминато….
Dialogue: 0,0:19:42.47,0:19:44.56,Default,,0,0,0,,<Құрметпен: Мен басқалардан жақсы болғым келеді.
Dialogue: 0,0:19:44.56,0:19:49.16,Default,,0,0,0,,Сол күшті сезім айналаңыздағыларға бірте-бірте таралады.＞
Dialogue: 0,0:19:53.32,0:19:56.99,Default,,0,0,0,,Әй, біреу менің көлеңкеме қарай ала ма?
Dialogue: 0,0:19:56.99,0:20:13.69,Default,,0,0,0,,♪♪~
Dialogue: 0,0:20:13.69,0:20:16.79,Default,,0,0,0,,Жоғары курс студенттері өз бетінше оқуын аяқтағаннан кейін →
Dialogue: 0,0:20:16.79,0:20:19.59,Default,,0,0,0,,Олар күнде жиналатын сияқты.
Dialogue: 0,0:20:23.01,0:20:25.90,Default,,0,0,0,,Ум...
Dialogue: 0,0:20:25.90,0:20:30.52,Default,,0,0,0,,Мен мұны жасадым, егер ұнаса!
Dialogue: 0,0:20:30.52,0:20:32.52,Default,,0,0,0,,Ааах— сол сұм!
Dialogue: 0,0:20:32.52,0:20:34.57,Default,,0,0,0,,Дәмді көрінеді! Уга!
Dialogue: 0,0:20:34.57,0:20:36.49,Default,,0,0,0,,Рахмет! Менің қарыным ашты!
Dialogue: 0,0:20:36.49,0:20:39.65,Default,,0,0,0,,Пішін аяқталды.
Dialogue: 0,0:20:39.65,0:20:42.33,Default,,0,0,0,,Itadadakimasu!
Dialogue: 0,0:20:42.33,0:20:45.97,Default,,0,0,0,,Өте дәмді! (Масуко) Шайыңыз, шайыңыз!
Dialogue: 0,0:20:45.97,0:20:47.99,Default,,0,0,0,,Бұл жақсы жанасу.
Dialogue: 0,0:20:47.99,0:20:50.64,Default,,0,0,0,,Иә? Қарашы, бойың өсіп жатқан жоқ па?
Dialogue: 0,0:20:50.64,0:20:53.18,Default,,0,0,0,,Қайтарылды? Уф.
Dialogue: 0,0:20:53.18,0:20:57.33,Default,,0,0,0,,Эй, мен өзімді жақсы сезінемін!
Dialogue: 0,0:20:57.33,0:20:59.67,Default,,0,0,0,,Эй, келесі жолы треска етігін де қосыңыз.
Dialogue: 0,0:20:59.67,0:21:03.00,Default,,0,0,0,,Туна майосы да! Окка... Мен ірімшік!
Dialogue: 0,0:21:03.00,0:21:05.99,Default,,0,0,0,,Окака. (Исашики) Сыр!
Dialogue: 0,0:21:05.99,0:21:07.97,Default,,0,0,0,,Иә... Иә!
Dialogue: 0,0:21:07.97,0:21:10.34,Default,,0,0,0,,Әй, біреу менеджер жіберсін.
Dialogue: 0,0:21:10.34,0:21:12.31,Default,,0,0,0,,Сен бар. (Исашики) Жүр!
Dialogue: 0,0:21:12.31,0:21:16.00,Default,,0,0,0,,Сіз не туралы айтып тұрсыз? Ахаха….
Dialogue: 0,0:21:16.00,0:21:20.19,Default,,0,0,0,,<Құрметпен: Бір-біріне шабыт бере алатын достармен кездесу.
Dialogue: 0,0:21:20.19,0:21:24.29,Default,,0,0,0,,Мен жинаған күнделікті тербелістер...>
Dialogue: 0,0:21:43.83,0:21:48.85,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:48.85,0:21:51.85,Default,,0,0,0,,О... ортаңғы оң жақ.
Dialogue: 0,0:21:57.17,0:22:00.06,Default,,0,0,0,,Ол мұны істеді. Мен нәтиже алдым!
Dialogue: 0,0:22:00.06,0:22:02.06,Default,,0,0,0,,Бірінші бастапқы құрам, бірінші ат-бат →
Dialogue: 0,0:22:02.06,0:22:04.66,Default,,0,0,0,,Бірінші үйге жүгіру! Юки...
Dialogue: 0,0:22:04.66,0:22:08.17,Default,,0,0,0,,Бұл керемет, Тецу! Керемет белгі Тецу!
Dialogue: 0,0:22:08.17,0:22:11.27,Default,,0,0,0,,Қандай қарапайым жұдырық сорғы!
Dialogue: 0,0:22:11.27,0:22:16.07,Default,,0,0,0,,Тырыспа, Тецу, біз де жеңілмейміз! ))
Dialogue: 0,0:22:18.39,0:22:23.33,Default,,0,0,0,,Жаттығу матчында Юки допқа соқты.
Dialogue: 0,0:22:23.33,0:22:27.22,Default,,0,0,0,,Мен бұған өзімдікі сияқты қуанамын →
Dialogue: 0,0:22:27.22,0:22:32.68,Default,,0,0,0,,Бұл балалар өте әсерлі болды.
Dialogue: 0,0:22:32.68,0:22:37.33,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасай аламын, өйткені мен басқаларды тани аламын.
Dialogue: 0,0:22:37.33,0:22:43.62,Default,,0,0,0,,Бұл ұрпақ жүрегі сондай мықты ойыншыларға толы еді...
Dialogue: 0,0:22:43.62,0:22:45.96,Default,,0,0,0,,Үйден тыс дала!
Dialogue: 0,0:22:45.96,0:22:49.34,Default,,0,0,0,,《Жүрек...》 《Күш...》
Dialogue: 0,0:22:49.34,0:22:52.20,Default,,0,0,0,,《Мен түсіндім. Бұл дұрыс...
Dialogue: 0,0:22:52.20,0:22:58.52,Default,,0,0,0,,Бұл адамдар да басынан жақсы емес еді.
Dialogue: 0,0:22:58.52,0:23:04.12,Default,,0,0,0,,Үздіксіз күш-жігермен→
Dialogue: 0,0:23:04.12,0:23:06.71,Default,,0,0,0,,Мен осы уақытқа дейін келдім》
Dialogue: 0,0:23:06.71,0:23:08.71,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:23:10.65,0:23:13.17,Default,,0,0,0,,Ішкі алаңға оралу!
Dialogue: 0,0:23:13.17,0:23:21.16,Default,,0,0,0,,《Біз әлі де осы адамдардан бастаймыз→
Dialogue: 0,0:23:21.16,0:23:24.64,Default,,0,0,0,,Үйренетін нәрсе бар! 》
Dialogue: 0,0:23:24.64,0:23:28.67,Default,,0,0,0,,Ұстаушы!
Dialogue: 0,0:23:28.67,0:24:01.11,Default,,0,0,0,,♪♪~
Dialogue: 0,0:24:01.11,0:24:03.70,Default,,0,0,0,,《Сакай/Мияучи: Не істеу керек...》
Dialogue: 0,0:24:03.70,0:24:07.00,Default,,0,0,0,,《Кусуноки/Кадота/Эндо: Мен бәрін істедім》
Dialogue: 0,0:24:12.16,0:24:16.38,Default,,0,0,0,,《Мияучи/Масуко/Рйосуке: Қалғаны – өз күшіміз...》
Dialogue: 0,0:24:16.38,0:24:18.68,Default,,0,0,0,,《Юки/Исашики: Тек барыңды бер》
Dialogue: 0,0:24:24.14,0:24:29.89,Default,,0,0,0,,《Юки және оның достары: Біз үш жыл бірге болған осы жерде→
Dialogue: 0,0:24:29.89,0:24:37.99,Default,,0,0,0,,Тағы да күліп оралайық》
Dialogue: 0,0:24:39.99,0:24:43.29,Default,,0,0,0,,Шиа!
Dialogue: 0,0:24:44.79,0:24:50.79,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory