Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:33.50,0:00:37.49,Default,,0,0,0,,Тамба 3 ұпай айырмашылығы бар.
Dialogue: 0,0:00:37.49,0:00:39.79,Default,,0,0,0,,Мен мұны сізге қалдырамын.
Dialogue: 0,0:00:42.61,0:00:44.63,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:00:44.63,0:00:46.95,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:00:46.95,0:00:49.15,Default,,0,0,0,,Тағы үш шығу.
Dialogue: 0,0:00:49.15,0:00:52.35,Default,,0,0,0,,Қорытынды бөлім Барлығыңызға рахмет!
Dialogue: 0,0:00:52.35,0:00:55.22,Default,,0,0,0,,Тамбаға барайық!
Dialogue: 0,0:00:55.22,0:00:58.49,Default,,0,0,0,,Танба мырза, өтінемін! ≪Тамба-сан!
Dialogue: 0,0:00:58.49,0:01:01.49,Default,,0,0,0,,≪Оларды бір-бірден алайық!
Dialogue: 0,0:01:03.50,0:01:06.47,Default,,0,0,0,,Үш ұпай айырмашылығы...
Dialogue: 0,0:01:06.47,0:01:10.20,Default,,0,0,0,,Бұл жағдайды өзгерту үшін дұрыс нүкте айырмашылығы емес пе?
Dialogue: 0,0:01:10.20,0:01:12.50,Default,,0,0,0,,Көрермендерге де ұнайды деп ойлаймын.
Dialogue: 0,0:01:15.46,0:01:19.16,Default,,0,0,0,,Әзірге мен бірнеше жүгірушілерді жинап, Раиичиге жіберуім керек.
Dialogue: 0,0:01:19.16,0:01:23.88,Default,,0,0,0,,Бәріңіз де Раиичиге жіберсеңіз бәрі жақсы болады деп ойлайсыз, солай ма?
Dialogue: 0,0:01:23.88,0:01:29.48,Default,,0,0,0,,Мен бұл матчта жеңілемін деп ешқашан ойламадым.
Dialogue: 0,0:04:12.50,0:04:27.20,Default,,0,0,0,,♪♪~
Dialogue: 0,0:04:27.20,0:04:29.20,Default,,0,0,0,,Шаа! (Ақиба) Шығып қалады.
Dialogue: 0,0:04:35.13,0:04:37.11,Default,,0,0,0,,Мен оның солай болатынына көз жеткіземін.
Dialogue: 0,0:04:37.11,0:04:40.61,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:04:40.61,0:04:43.17,Default,,0,0,0,,2 шықты! (Исашики) 2 ұпай!
Dialogue: 0,0:04:43.17,0:04:46.14,Default,,0,0,0,,≪2 шықты. ≪2 шықты.
Dialogue: 0,0:04:46.14,0:04:49.81,Default,,0,0,0,,≪Тағы бір нәрсе. ≪Тағы бір нәрсе.
Dialogue: 0,0:04:49.81,0:04:53.61,Default,,0,0,0,,Тағы бір бару керек Тағы біреуі бар!
Dialogue: 0,0:04:53.61,0:04:57.83,Default,,0,0,0,,Доп жүгіріп келеді, Танба мырза. (Көктем қаласы) Ойымызды жинақтайық!
Dialogue: 0,0:04:57.83,0:05:04.66,Default,,0,0,0,,[Баяндамашы] №9 орталық Ота мырза. (Ота) Шаа!
Dialogue: 0,0:05:04.66,0:05:17.53,Default,,0,0,0,,♪♪~
Dialogue: 0,0:05:17.53,0:05:19.53,Default,,0,0,0,,Танба мырза.
Dialogue: 0,0:05:21.51,0:05:23.47,Default,,0,0,0,,《Миюки: Тағы бір шықты...
Dialogue: 0,0:05:23.47,0:05:26.77,Default,,0,0,0,,Осы жерден шешсеңіз, Тодороки бұрылып кетпейді.》
Dialogue: 0,0:05:31.17,0:05:34.45,Default,,0,0,0,,Мен оны аяқтауды күте алмаймын!
Dialogue: 0,0:05:34.45,0:05:38.97,Default,,0,0,0,,《Мен міндетті түрде шығамын, мүлдем...》
Dialogue: 0,0:05:38.97,0:05:52.87,Default,,0,0,0,,♪♪~
Dialogue: 0,0:05:52.87,0:05:54.87,Default,,0,0,0,,Фуши!
Dialogue: 0,0:05:57.12,0:05:59.16,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:05:59.16,0:06:02.70,Default,,0,0,0,,Үшінші!
Dialogue: 0,0:06:02.70,0:06:04.70,Default,,0,0,0,,Угара~! Ра~!
Dialogue: 0,0:06:09.67,0:06:11.86,Default,,0,0,0,,Шектеу өзгерді!
Dialogue: 0,0:06:11.86,0:06:14.66,Default,,0,0,0,,Үшіншінің алдындағы жер шары күтпеген жерден дұрыс емес! ?
Dialogue: 0,0:06:16.68,0:06:18.68,Default,,0,0,0,,Уга!
Dialogue: 0,0:06:18.68,0:06:20.68,Default,,0,0,0,,Тез кір, Ота!
Dialogue: 0,0:06:24.32,0:06:30.36,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:06:30.36,0:06:33.46,Default,,0,0,0,,≪Жай ғана қосылды!
Dialogue: 0,0:06:41.45,0:06:43.77,Default,,0,0,0,,《Мені өлтір, Раиичи.
Dialogue: 0,0:06:43.77,0:06:48.01,Default,,0,0,0,,Тіпті бейсбол құдайлары сізді жарғанақта көргісі келеді...》
Dialogue: 0,0:06:48.01,0:06:50.88,Default,,0,0,0,,2 шығу, 1-ші негізде жүгіруші….
Dialogue: 0,0:06:50.88,0:06:55.15,Default,,0,0,0,,Үш ұпайлық айырмашылық болды, бірақ мен ең жек көретін соққыға бардым.
Dialogue: 0,0:06:55.15,0:07:00.04,Default,,0,0,0,,А, мына жігіт ұрса, ойын міндетті түрде қозғалады...
Dialogue: 0,0:07:00.04,0:07:01.96,Default,,0,0,0,,≪Тодороки!
Dialogue: 0,0:07:01.96,0:07:04.31,Default,,0,0,0,,≪Тамаша соққы! ≪Райнчи!
Dialogue: 0,0:07:04.31,0:07:08.45,Default,,0,0,0,,Келесі № 2 және № 3, сондай-ақ есептелуі керек →
Dialogue: 0,0:07:08.45,0:07:10.80,Default,,0,0,0,,Мен ұзақ соққылардан аулақ болғым келеді.
Dialogue: 0,0:07:10.80,0:07:14.30,Default,,0,0,0,,Ал... үш ұпай айырмашылығы бар. Бетпе-бет шайқаста →
Dialogue: 0,0:07:14.30,0:07:17.80,Default,,0,0,0,,Бар болғаны жату керек. Ашуланба, Тамба!
Dialogue: 0,0:07:22.51,0:07:26.00,Default,,0,0,0,,《Соғысқа барайық, Танба мырза.
Dialogue: 0,0:07:26.00,0:07:29.35,Default,,0,0,0,,Қалай болғанда да, мен бұл адамды өлтіруім керек→
Dialogue: 0,0:07:29.35,0:07:32.45,Default,,0,0,0,,Якушидің серпінін тоқтату мүмкін емес》
Dialogue: 0,0:07:34.47,0:07:38.97,Default,,0,0,0,,(жүрек тондары)
Dialogue: 0,0:07:44.36,0:07:46.96,Default,,0,0,0,,《Манака: Бәсекеге түспе...》
Dialogue: 0,0:07:49.64,0:07:55.14,Default,,0,0,0,,《Манака: Ол жігітпен бәсекеге түспе, Коичиро》
Dialogue: 0,0:08:00.50,0:08:02.65,Default,,0,0,0,,Тамба! Раиичи!
Dialogue: 0,0:08:02.65,0:08:05.02,Default,,0,0,0,,Сейдо! Фармацевт!
Dialogue: 0,0:08:05.02,0:08:07.54,Default,,0,0,0,,Жылама! Ақымақ, Косей! Енді мен де…
Dialogue: 0,0:08:07.54,0:08:13.46,Default,,0,0,0,,≪Сейдо! Сейдо! Сейдо!
Dialogue: 0,0:08:13.46,0:08:15.78,Default,,0,0,0,,Раиичи! Мені ұр!
Dialogue: 0,0:08:15.78,0:08:17.82,Default,,0,0,0,,Егер мені ұрмасаң, мен саған банан жеуге рұқсат етпеймін!
Dialogue: 0,0:08:17.82,0:08:19.87,Default,,0,0,0,,Соқ! !
Dialogue: 0,0:08:19.87,0:08:23.14,Default,,0,0,0,,《Соңғы 4 ат-батта бұл жігіт екі соққы жасады.
Dialogue: 0,0:08:23.14,0:08:27.69,Default,,0,0,0,,Фуруяның түзу добы және Савамураның биік ілулі добы.
Dialogue: 0,0:08:27.69,0:08:30.69,Default,,0,0,0,,Біз төменгі диапазонға мұқият шабуыл жасаймыз》
Dialogue: 0,0:08:36.22,0:08:38.62,Default,,0,0,0,,Фуши!
Dialogue: 0,0:08:38.62,0:08:40.70,Default,,0,0,0,,Доп!
Dialogue: 0,0:08:40.70,0:08:44.20,Default,,0,0,0,,Жарайды, жақсы доп. Жақсы курс екен.
Dialogue: 0,0:08:46.84,0:08:48.94,Default,,0,0,0,,《Тіпті тартпа...》
Dialogue: 0,0:08:51.28,0:08:55.65,Default,,0,0,0,,Шабуыл жасайық! (Канамару) Шеш, Тамба-сан!
Dialogue: 0,0:08:55.65,0:08:57.82,Default,,0,0,0,,Фуши!
Dialogue: 0,0:08:57.82,0:08:59.82,Default,,0,0,0,,Доп!
Dialogue: 0,0:08:59.82,0:09:02.21,Default,,0,0,0,,О, қандай ұят! ≪Жақсы курс!
Dialogue: 0,0:09:02.21,0:09:04.33,Default,,0,0,0,,Доптың күші бар!
Dialogue: 0,0:09:04.33,0:09:06.78,Default,,0,0,0,,Тамба-сан тура жүгіріп келеді!
Dialogue: 0,0:09:06.78,0:09:09.87,Default,,0,0,0,,Қисықтан кейін түзу болады.
Dialogue: 0,0:09:09.87,0:09:13.29,Default,,0,0,0,,Екі сыртқы алаңға қарсы сәл қозғалмады.
Dialogue: 0,0:09:13.29,0:09:16.67,Default,,0,0,0,,Мен осы уақытқа дейін кейбір сасық курстармен айналысқандықтан→
Dialogue: 0,0:09:16.67,0:09:20.33,Default,,0,0,0,,Бұл қорқынышты. Сіз курсты күтіп тұрған жоқсыз ба?
Dialogue: 0,0:09:20.33,0:09:25.98,Default,,0,0,0,,(жүрек тондары)
Dialogue: 0,0:09:25.98,0:09:28.00,Default,,0,0,0,,《Миюки: Егер сіз маған олардың біреуіне көмектессеңіз→
Dialogue: 0,0:09:28.00,0:09:31.46,Default,,0,0,0,,Мен құтқарылдым. Осы уақытқа жеткенде →
Dialogue: 0,0:09:31.46,0:09:35.03,Default,,0,0,0,,Бұл өте қиын жер, сондықтан шабуыл жасаудан басқа амалымыз жоқ.》
Dialogue: 0,0:09:35.03,0:09:37.96,Default,,0,0,0,,Оны үрлеп тастаңыз! (Ямаучи) Раиичи!
Dialogue: 0,0:09:37.96,0:09:40.05,Default,,0,0,0,,Мен оны көремін Мен оны көремін!
Dialogue: 0,0:09:40.05,0:09:42.35,Default,,0,0,0,,≪Мақсат ет! ≪Райнчи!
Dialogue: 0,0:09:44.48,0:09:52.29,Default,,0,0,0,,♪♪~
Dialogue: 0,0:09:52.29,0:09:56.33,Default,,0,0,0,,《Райнчи: Соқ, міндетті түрде ұр.
Dialogue: 0,0:09:56.33,0:10:01.34,Default,,0,0,0,,Кез келген жолмен базаға тұрыңыз.
Dialogue: 0,0:10:01.34,0:10:04.47,Default,,0,0,0,,→ түймесін басу арқылы
Dialogue: 0,0:10:04.47,0:10:07.54,Default,,0,0,0,,Егер мен команданың үмітін ақтай алсам...》
Dialogue: 0,0:10:07.54,0:10:09.84,Default,,0,0,0,,Фуши!
Dialogue: 0,0:10:12.81,0:10:16.53,Default,,0,0,0,,《Тәтті!
Dialogue: 0,0:10:16.53,0:10:18.53,Default,,0,0,0,,Орындалды! 》
Dialogue: 0,0:11:24.48,0:11:28.04,Default,,0,0,0,,《Тәтті!
Dialogue: 0,0:11:28.04,0:11:30.04,Default,,0,0,0,,Орындалды! 》
Dialogue: 0,0:11:36.36,0:11:38.46,Default,,0,0,0,,≪Фол!
Dialogue: 0,0:11:41.64,0:11:44.34,Default,,0,0,0,,《Мен соққыны өткізіп алдым! ? 》
Dialogue: 0,0:11:44.34,0:11:48.23,Default,,0,0,0,,Не болды, Раиичи! Сіз көп жұмыс жасайсыз ба?
Dialogue: 0,0:11:48.23,0:11:53.15,Default,,0,0,0,,Соқ... соққы....
Dialogue: 0,0:11:53.15,0:11:56.07,Default,,0,0,0,,《Бұл жігіт...
Dialogue: 0,0:11:56.07,0:12:00.17,Default,,0,0,0,,Маған күшті тіке атуыңызды өтінемін, Танба мырза! 》
Dialogue: 0,0:12:02.16,0:12:05.28,Default,,0,0,0,,《Миюки: Осы жазда алғаш рет қорғанда→
Dialogue: 0,0:12:05.28,0:12:10.63,Default,,0,0,0,,Мен тек қисық доптар мен түзу алаңдарды лақтырдым.
Dialogue: 0,0:12:10.63,0:12:13.15,Default,,0,0,0,,Бұл жерде әлі жоқ→
Dialogue: 0,0:12:13.15,0:12:18.79,Default,,0,0,0,,Басқа орындық ешқашан білмейтін козир бар.
Dialogue: 0,0:12:18.79,0:12:20.82,Default,,0,0,0,,Фуши!
Dialogue: 0,0:12:20.82,0:12:23.99,Default,,0,0,0,,≪Фол! 《Үш адам: Біз оларды қуып келдік! 》
Dialogue: 0,0:12:23.99,0:12:28.48,Default,,0,0,0,,《Менің әткеншектегі кәдімгі ойық жоқ!
Dialogue: 0,0:12:28.48,0:12:32.32,Default,,0,0,0,,Әлгі ақымақ, мүмкін...》
Dialogue: 0,0:12:32.32,0:12:35.49,Default,,0,0,0,,Раиичи! Жаман нәрселер туралы ойламаңыз!
Dialogue: 0,0:12:35.49,0:12:38.43,Default,,0,0,0,,Сізге тек соққы жасау керек!
Dialogue: 0,0:12:38.43,0:12:41.43,Default,,0,0,0,,Құмыраға қарсы бәсекелесуден рахат алыңыз!
Dialogue: 0,0:12:43.46,0:12:48.20,Default,,0,0,0,,Ереуіл. Соққы.
Dialogue: 0,0:12:48.20,0:12:51.30,Default,,0,0,0,,《Әр адамның үмітін ақтау》
Dialogue: 0,0:12:54.83,0:12:57.83,Default,,0,0,0,,《Жоқ, ол келмейді! 》
Dialogue: 0,0:12:57.83,0:13:01.20,Default,,0,0,0,,《Шешейік, Танба мырза.
Dialogue: 0,0:13:01.20,0:13:03.30,Default,,0,0,0,,Осымен! 》
Dialogue: 0,0:13:09.01,0:13:12.96,Default,,0,0,0,,9-шы иннингтің жоғарғы бөлігі, 2 шығу, 1-ші негізде жүгіруші.
Dialogue: 0,0:13:12.96,0:13:15.83,Default,,0,0,0,,Санақ 2 ұшы 2.
Dialogue: 0,0:13:15.83,0:13:19.33,Default,,0,0,0,,Жеңімпаз жартылай финалға өтеді.
Dialogue: 0,0:13:19.33,0:13:21.65,Default,,0,0,0,,Танба мырза! Мен сені ұрайын, Тамба!
Dialogue: 0,0:13:21.65,0:13:23.67,Default,,0,0,0,,Ей, шешейік!
Dialogue: 0,0:13:23.67,0:13:25.62,Default,,0,0,0,,Угара! (Рйосуке) Мен сені қуып келемін!
Dialogue: 0,0:13:25.62,0:13:29.38,Default,,0,0,0,,Уф! Мені өлтір!
Dialogue: 0,0:13:29.38,0:13:34.88,Default,,0,0,0,,《Тамба: Осы уақытқа дейін... Мен командаға қиындық туғыздым》
Dialogue: 0,0:13:37.95,0:13:41.79,Default,,0,0,0,,《Осы жерден шешіңіз! 》
Dialogue: 0,0:13:41.79,0:13:50.33,Default,,0,0,0,,♪♪~
Dialogue: 0,0:13:50.33,0:13:54.02,Default,,0,0,0,,《Шешіңіз! 》
Dialogue: 0,0:13:54.02,0:13:56.02,Default,,0,0,0,,Раиичи!
Dialogue: 0,0:13:59.44,0:14:03.08,Default,,0,0,0,,《Бұрынғы курс.
Dialogue: 0,0:14:03.08,0:14:07.58,Default,,0,0,0,,Тікелей! Бұл жолы...》
Dialogue: 0,0:14:09.88,0:14:12.88,Default,,0,0,0,,《Ұшып кет! 》
Dialogue: 0,0:14:27.70,0:14:34.50,Default,,0,0,0,,《Ба... бұл шанышқы! ? Мұндай ақпарат еш жерде жоқ...》
Dialogue: 0,0:14:37.29,0:14:43.50,Default,,0,0,0,,《Жоқ, мен бірде бұрышта қалдым...
Dialogue: 0,0:14:43.50,0:14:46.00,Default,,0,0,0,,Шайқас болды.
Dialogue: 0,0:14:46.00,0:14:48.99,Default,,0,0,0,,≪ Қамырды тастаңыз!
Dialogue: 0,0:14:48.99,0:14:52.51,Default,,0,0,0,,Уау! ≪Ойын жинағы!
Dialogue: 0,0:14:52.51,0:14:57.66,Default,,0,0,0,,♪♪~
Dialogue: 0,0:14:57.66,0:15:01.20,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:15:01.20,0:15:04.96,Default,,0,0,0,,Соңғы доп…. аа.
Dialogue: 0,0:15:04.96,0:15:09.18,Default,,0,0,0,,Тамбаның жігіті Мен білмей тұрып.
Dialogue: 0,0:15:09.18,0:15:12.33,Default,,0,0,0,,Жақсы доп, Тамба-сан. о!
Dialogue: 0,0:15:12.33,0:15:15.25,Default,,0,0,0,,Хяхаха! Керемет алаң! Уга!
Dialogue: 0,0:15:15.25,0:15:17.55,Default,,0,0,0,,《Крис: Тамба…》
Dialogue: 0,0:15:20.84,0:15:23.37,Default,,0,0,0,,Коичиро….
Dialogue: 0,0:15:23.37,0:15:27.79,Default,,0,0,0,,Ал... Тодороки шығып кетті...
Dialogue: 0,0:15:27.79,0:15:33.53,Default,,0,0,0,,Аа, мен ешқашан шанышқыны козир ретінде сақтаймын деп ойламадым.
Dialogue: 0,0:15:33.53,0:15:38.63,Default,,0,0,0,,Бірақ оның соңғы соққысында Тодорокидің әткеншегі баяу болды...
Dialogue: 0,0:15:42.54,0:15:47.66,Default,,0,0,0,,Бұл қысым шығар. сурет! ?
Dialogue: 0,0:15:47.66,0:15:51.84,Default,,0,0,0,,Ол үнемі құмыралармен жарысады→
Dialogue: 0,0:15:51.84,0:15:56.27,Default,,0,0,0,,Ол рахаттанып жатқан сияқты.
Dialogue: 0,0:15:56.27,0:15:59.48,Default,,0,0,0,,Содан кейін оның жарғанаттағы соңғы кезегі болды→
Dialogue: 0,0:15:59.48,0:16:05.13,Default,,0,0,0,,Алғаш рет топ үшін жарғанақты сермеу.
Dialogue: 0,0:16:05.13,0:16:09.73,Default,,0,0,0,,Өзің үшін емес, ұжым үшін.
Dialogue: 0,0:16:12.64,0:16:17.83,Default,,0,0,0,,《Түсіндім, ол бастауыш немесе орта мектепте бейсбол үйірмесіне қатыспаған→
Dialogue: 0,0:16:17.83,0:16:21.45,Default,,0,0,0,,Допты жалғыз ойнау...》
Dialogue: 0,0:16:21.45,0:16:25.00,Default,,0,0,0,,Мен әркімнің сезіміне жауап бергім келеді.
Dialogue: 0,0:16:25.00,0:16:28.31,Default,,0,0,0,,Бір қызығы, қысымға айналды→
Dialogue: 0,0:16:28.31,0:16:32.91,Default,,0,0,0,,Менің ойымша, бұл оның жарғанасына ауыр салмақ түсіреді.
Dialogue: 0,0:16:36.35,0:16:38.32,Default,,0,0,0,,Сапқа тұр!
Dialogue: 0,0:16:38.32,0:16:53.50,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:16:53.50,0:16:55.70,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:16:55.70,0:16:58.00,Default,,0,0,0,,Шиа!
Dialogue: 0,0:17:08.83,0:17:12.13,Default,,0,0,0,,Жақсы жекпе-жек! Келесі жылы сәттілік!
Dialogue: 0,0:17:15.50,0:17:17.79,Default,,0,0,0,,Енді жылама, Раиичи.
Dialogue: 0,0:17:17.79,0:17:20.97,Default,,0,0,0,,Егер соға алмасаң, мен бас тартар едім.
Dialogue: 0,0:17:20.97,0:17:23.97,Default,,0,0,0,,Ешкімді кінәламаңыз.
Dialogue: 0,0:17:26.90,0:17:30.00,Default,,0,0,0,,Қадағалау!
Dialogue: 0,0:17:32.84,0:17:36.81,Default,,0,0,0,,Бір жарым жылдық басшылық үшін көп рахмет!
Dialogue: 0,0:17:36.81,0:17:39.66,Default,,0,0,0,,Мен жасадым!
Dialogue: 0,0:17:39.66,0:17:44.15,Default,,0,0,0,,Маған көптеген ауыр және ауыр сөздер айтылды→
Dialogue: 0,0:17:44.15,0:17:47.68,Default,,0,0,0,,Әр күн шынымен де қызықты болды...
Dialogue: 0,0:17:47.68,0:17:51.79,Default,,0,0,0,,Өзгеге сенбе, өзің ойла.
Dialogue: 0,0:17:51.79,0:17:56.49,Default,,0,0,0,,Өз ойыныңыз үшін жауапкершілікті алыңыз. (Кобаяши) Бұл мен режиссерден үйренгенім.
Dialogue: 0,0:17:56.49,0:17:58.66,Default,,0,0,0,,Тағы да... (Тодороки) Хмф.
Dialogue: 0,0:17:58.66,0:18:03.62,Default,,0,0,0,,Жеңілсең бітті... Жарыс →
Dialogue: 0,0:18:03.62,0:18:06.72,Default,,0,0,0,,Егер мен жеңілсем...
Dialogue: 0,0:18:11.32,0:18:14.96,Default,,0,0,0,,Сонда да жаттықтырушы маған бейсбол ойнауды үйреткеніне қуаныштымын!
Dialogue: 0,0:18:14.96,0:18:17.86,Default,,0,0,0,,Әр күн шынымен жаңа!
Dialogue: 0,0:18:17.86,0:18:21.95,Default,,0,0,0,,Бір жарым жыл көзді ашып-жұмғанша өтті!
Dialogue: 0,0:18:21.95,0:18:25.16,Default,,0,0,0,,Рахмет, директор Тодороки.
Dialogue: 0,0:18:25.16,0:18:27.66,Default,,0,0,0,,Мен жасадым! !
Dialogue: 0,0:18:30.79,0:18:35.72,Default,,0,0,0,,Санада! Келесі жылы жаттықтырушыны Кошиенге апарыңыз! !
Dialogue: 0,0:18:35.72,0:18:38.99,Default,,0,0,0,,Уау! (Ота) Акиба Мишима→
Dialogue: 0,0:18:38.99,0:18:44.44,Default,,0,0,0,,Біздің көзімізде сендер де құбыжықсыңдар. Іске сәт!
Dialogue: 0,0:18:44.44,0:18:47.18,Default,,0,0,0,,Найзағай қаласы.
Dialogue: 0,0:18:47.18,0:18:51.10,Default,,0,0,0,,Біз күтеміз. (Фукуда) Сіздің атыңыз →
Dialogue: 0,0:18:51.10,0:18:54.10,Default,,0,0,0,,Елдің түкпір-түкпірінде жаңғырған уақыт.
Dialogue: 0,0:18:57.50,0:19:01.39,Default,,0,0,0,,《Ол нөлден басталады.
Dialogue: 0,0:19:01.39,0:19:04.66,Default,,0,0,0,,Мен де, сен де...
Dialogue: 0,0:19:04.66,0:19:09.66,Default,,0,0,0,,Маған бұл жігіттер әлі көп нәрсені үйретеді...》
Dialogue: 0,0:19:14.50,0:19:18.17,Default,,0,0,0,,《Тодороки: Күшті болайық, Раиичи...
Dialogue: 0,0:19:18.17,0:19:22.97,Default,,0,0,0,,Бұл командада барлығымен бірге...》
Dialogue: 0,0:19:26.95,0:19:29.82,Default,,0,0,0,,≪Сәттілік! ≪Тетсу!
Dialogue: 0,0:19:29.82,0:19:33.17,Default,,0,0,0,,Керемет ойын! Керемет алаң Тамба!
Dialogue: 0,0:19:33.17,0:19:36.04,Default,,0,0,0,,Бастық~! Катаока-сан!
Dialogue: 0,0:19:36.04,0:19:38.06,Default,,0,0,0,,Тағы екі!
Dialogue: 0,0:19:38.06,0:19:40.16,Default,,0,0,0,,≪Биыл міндетті түрде Кошиенге барайық!
Dialogue: 0,0:19:40.16,0:19:44.98,Default,,0,0,0,,≪Бұл команда мұны істей алады! ≪Сейдо - ең күшті!
Dialogue: 0,0:19:44.98,0:19:47.85,Default,,0,0,0,,≪Тэцу-сан! ≪Фуруя-кун!
Dialogue: 0,0:19:47.85,0:19:49.89,Default,,0,0,0,,≪Исашики!
Dialogue: 0,0:19:49.89,0:19:52.86,Default,,0,0,0,,Хмм... не болды? Эйджун мырза.
Dialogue: 0,0:19:52.86,0:19:55.16,Default,,0,0,0,,О, жоқ...
Dialogue: 0,0:20:01.53,0:20:05.03,Default,,0,0,0,,((Рахмет! Шиа!
Dialogue: 0,0:20:07.34,0:20:10.78,Default,,0,0,0,,(Иида) Ол тіпті мұзды жұмсартатын әсерді де алып тастапты
Dialogue: 0,0:20:10.78,0:20:14.65,Default,,0,0,0,,Келесі жолы мен жеңілмеймін! Эй, Эйджун-кун!
Dialogue: 0,0:20:14.65,0:20:18.00,Default,,0,0,0,,An! ? Темера жеңді деп ойлаймын!
Dialogue: 0,0:20:18.00,0:20:20.30,Default,,0,0,0,,Сіз оны жек көресіз бе? кешіріңіз...
Dialogue: 0,0:20:20.30,0:20:23.71,Default,,0,0,0,,Өйткені бұл адам ақымақ... Сөзсіз жең! !
Dialogue: 0,0:20:23.71,0:20:26.51,Default,,0,0,0,,Қолыңызды алыңыз! Қараңдар! Ұстау...))
Dialogue: 0,0:20:35.62,0:20:39.04,Default,,0,0,0,,Оның қолы→
Dialogue: 0,0:20:39.04,0:20:42.34,Default,,0,0,0,,Жартас қатты көрінді...
Dialogue: 0,0:20:45.80,0:20:53.34,Default,,0,0,0,,《Ондай қолды алу үшін жарғанатты сермеу қаншалықты қиын?
Dialogue: 0,0:20:53.34,0:20:55.86,Default,,0,0,0,,Қанша…》
Dialogue: 0,0:20:55.86,0:20:59.36,Default,,0,0,0,,Мен жоғалтқым келмейді.
Dialogue: 0,0:21:04.83,0:21:07.28,Default,,0,0,0,,Балалар сендерге де қиын.
Dialogue: 0,0:21:07.28,0:21:10.82,Default,,0,0,0,,Мен үш жыл сол құбыжықпен бір блокта болдым.
Dialogue: 0,0:21:10.82,0:21:13.61,Default,,0,0,0,,Ол команда әлі де күшейіп келеді.
Dialogue: 0,0:21:13.61,0:21:17.33,Default,,0,0,0,,Ал, ең алдымен бүгінгі шолу жиналысы.
Dialogue: 0,0:21:17.33,0:21:20.01,Default,,0,0,0,,Әсіресе Савамура, көп.
Dialogue: 0,0:21:20.01,0:21:22.20,Default,,0,0,0,,Көп! ?
Dialogue: 0,0:21:22.20,0:21:26.20,Default,,0,0,0,,Бұл бір ғана нәрсе емес, Фуруя. (Фуруя) Уф.
Dialogue: 0,0:21:58.95,0:22:01.82,Default,,0,0,0,,Қазір Сейдо үздік 4-те.
Dialogue: 0,0:22:01.82,0:22:04.49,Default,,0,0,0,,Кошиенге дейін екі жеңіс қалды?
Dialogue: 0,0:22:04.49,0:22:08.29,Default,,0,0,0,,№4 Юкидің айналасында орналасқан күшті соққылар сапы→
Dialogue: 0,0:22:08.29,0:22:13.00,Default,,0,0,0,,Төрт құмырамен шабуылдау.
Dialogue: 0,0:22:13.00,0:22:16.00,Default,,0,0,0,,Ең бастысы, Эйс Тамба-кунның қайта тірілуі.
Dialogue: 0,0:22:16.00,0:22:19.32,Default,,0,0,0,,Себебі мен дәрігердің күшін тойтардым.
Dialogue: 0,0:22:19.32,0:22:24.26,Default,,0,0,0,,Күріш тұқымынан да жақсы шығар...
Dialogue: 0,0:22:24.26,0:22:29.63,Default,,0,0,0,,Айналасындағылардың үмітінен қысым көрген бірінші курс студентімен→
Dialogue: 0,0:22:29.63,0:22:36.34,Default,,0,0,0,,Айналасындағылардың үмітін күшке айналдыра білген үшінші курс студенті.
Dialogue: 0,0:22:36.34,0:22:38.99,Default,,0,0,0,,Жарғанаттағы соңғы бұрылыс → болды
Dialogue: 0,0:22:38.99,0:22:44.45,Default,,0,0,0,,Мүмкін бұл менің әріптестеріммен өткізген уақытым шығар.
Dialogue: 0,0:22:44.45,0:22:50.17,Default,,0,0,0,,《Менікі: Орта мектепте ойнауға екі жарым жыл ғана қалды.
Dialogue: 0,0:22:50.17,0:22:54.32,Default,,0,0,0,,Бірақ сол қысқа уақыттың өзінде→
Dialogue: 0,0:22:54.32,0:22:58.81,Default,,0,0,0,,Адамдар үлкен бола алады》
Dialogue: 0,0:22:58.81,0:23:02.98,Default,,0,0,0,,((Какчан, мен Сейдоға барамын. А?
Dialogue: 0,0:23:02.98,0:23:05.35,Default,,0,0,0,,Мәңгі→
Dialogue: 0,0:23:05.35,0:23:09.51,Default,,0,0,0,,Какчанның артынан қуа берсең жақсы емес.
Dialogue: 0,0:23:09.51,0:23:13.79,Default,,0,0,0,,Мен Каччанмен иық тіресе алатындай сезінемін→
Dialogue: 0,0:23:13.79,0:23:16.15,Default,,0,0,0,,Мен құмыра болғым келеді.
Dialogue: 0,0:23:16.15,0:23:19.65,Default,,0,0,0,,Мен Seido-да өзімді өзгерткім келеді))
Dialogue: 0,0:23:26.99,0:23:32.15,Default,,0,0,0,,Бұл Тамба шанышқы ма?
Dialogue: 0,0:23:32.15,0:23:34.11,Default,,0,0,0,,Бұл жақсы доп болды.
Dialogue: 0,0:23:34.11,0:23:38.28,Default,,0,0,0,,А, бұл жақсы доп болды.
Dialogue: 0,0:23:38.28,0:23:40.49,Default,,0,0,0,,Сіз мұны мойындамадыңыз деп ойлаймын.
Dialogue: 0,0:23:40.49,0:23:43.36,Default,,0,0,0,,Сейдо биыл мықты болады.
Dialogue: 0,0:23:43.36,0:23:46.48,Default,,0,0,0,,Екі бірінші курс құмыраларын қосу арқылы→
Dialogue: 0,0:23:46.48,0:23:48.48,Default,,0,0,0,,Ойыншы құрамы тереңдеді.
Dialogue: 0,0:23:48.48,0:23:50.98,Default,,0,0,0,,Әр түрі де әртүрлі.
Dialogue: 0,0:23:53.02,0:23:55.64,Default,,0,0,0,,Иә! Чикусо!
Dialogue: 0,0:23:55.64,0:24:00.01,Default,,0,0,0,,Енді бейсбол ойнағың келеді!
Dialogue: 0,0:24:00.01,0:24:04.43,Default,,0,0,0,,Ертең далаға шығамыз ба?
Dialogue: 0,0:24:04.43,0:24:08.16,Default,,0,0,0,,Директор да қуанады.
Dialogue: 0,0:24:08.16,0:24:10.32,Default,,0,0,0,,Мен оқумен айналысамын.
Dialogue: 0,0:24:10.32,0:24:12.65,Default,,0,0,0,,Тіпті теңізге де баруға болады.
Dialogue: 0,0:24:12.65,0:24:16.46,Default,,0,0,0,,Сіз оқымайсыз. (Хиракава) Шулы!
Dialogue: 0,0:24:16.46,0:24:18.86,Default,,0,0,0,,Онда ертең сағат 12-де кездесеміз.
Dialogue: 0,0:24:18.86,0:24:20.86,Default,,0,0,0,,Өз бетіңізше шешім қабылдамаңыз!
Dialogue: 0,0:24:20.86,0:24:23.20,Default,,0,0,0,,Неге келе жатырсың? (Хиракава) Иә?
Dialogue: 0,0:24:23.20,0:24:25.50,Default,,0,0,0,,Басқа мүшелермен сөйлесейік.
Dialogue: 0,0:24:30.45,0:24:35.88,Default,,0,0,0,,《Осындай келген болсаң... жүр.
Dialogue: 0,0:24:35.88,0:24:41.48,Default,,0,0,0,,Кошиен, Коичироға барыңыз》
Dialogue: 0,0:24:42.98,0:24:48.98,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory