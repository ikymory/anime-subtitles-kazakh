Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:32.90,0:00:35.45,Default,,0,0,0,,Ауыстыруды енгізіңіз.
Dialogue: 0,0:00:35.45,0:00:39.59,Default,,0,0,0,,Ұстаушының орнында Оно...
Dialogue: 0,0:00:39.59,0:00:41.62,Default,,0,0,0,,Такигава!
Dialogue: 0,0:00:41.62,0:00:44.83,Default,,0,0,0,,♪♪~
Dialogue: 0,0:00:44.83,0:00:46.83,Default,,0,0,0,,Крис-сенпай!
Dialogue: 0,0:00:48.93,0:00:50.93,Default,,0,0,0,,Мен оның солай болатынына көз жеткіземін.
Dialogue: 0,0:00:53.08,0:00:57.12,Default,,0,0,0,,Шынайы ма? 4-2-9 үйге бару.
Dialogue: 0,0:00:57.12,0:01:00.11,Default,,0,0,0,,<<Осы бастан көздегеніңіз осы ма еді?
Dialogue: 0,0:01:00.11,0:01:04.41,Default,,0,0,0,,≪Шығыс жоқ, негіз жүктелді, екі шығыс, бір сәтте екінші және үшінші негіз.
Dialogue: 0,0:01:04.41,0:01:08.37,Default,,0,0,0,,≪Бұл ұстаушы кім?
Dialogue: 0,0:01:08.37,0:01:12.47,Default,,0,0,0,,Өйткені, сен осындай болуың керек, Крис-сенпай.
Dialogue: 0,0:01:14.42,0:01:17.99,Default,,0,0,0,,Миюки, сен де қораға кел.
Dialogue: 0,0:01:17.99,0:01:23.75,Default,,0,0,0,,Кәдімгі ұстаушы ретінде ол жігіттің алаңдарын қадағалап отыру керек.
Dialogue: 0,0:01:23.75,0:01:26.98,Default,,0,0,0,,Сіз қызықты нәрселерді көресіз.
Dialogue: 0,0:01:26.98,0:01:28.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:21.46,0:04:23.46,Default,,0,0,0,,Бірінші!
Dialogue: 0,0:04:23.46,0:04:25.48,Default,,0,0,0,,≪Сіз оны мұқият жібердіңіз!
Dialogue: 0,0:04:25.48,0:04:27.50,Default,,0,0,0,,≪Жүгіруші екінші базаға өтеді!
Dialogue: 0,0:04:27.50,0:04:29.75,Default,,0,0,0,,Шабуыл жасағыңыз келетін жерге шабуыл жасаңыз, қалаған жеріңізді қатайтыңыз.
Dialogue: 0,0:04:29.75,0:04:32.92,Default,,0,0,0,,Иә, бұл Сейдо бейсболы!
Dialogue: 0,0:04:32.92,0:04:37.86,Default,,0,0,0,,Савамура: Сіз лақтырған кезде жаңа пішін туралы қалай ойлайсыз?
Dialogue: 0,0:04:37.86,0:04:40.26,Default,,0,0,0,,Бұл жай ғана сезім болса да, ол туралы айтуға тырысыңыз.
Dialogue: 0,0:04:40.26,0:04:44.75,Default,,0,0,0,,Бұл сана ма, дәлірек айтсақ, оң жақтағы қабырға ма?
Dialogue: 0,0:04:44.75,0:04:49.12,Default,,0,0,0,,Бірақ мен қабырға жасауды білмеймін...
Dialogue: 0,0:04:49.12,0:04:53.79,Default,,0,0,0,,Мен бұлай лақтырғанда қолғапты жаншып көремін.
Dialogue: 0,0:04:53.79,0:04:57.16,Default,,0,0,0,,Осыдан кейін өзімді сәл жақсы сезіндім.
Dialogue: 0,0:04:57.16,0:04:59.30,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:04:59.30,0:05:01.75,Default,,0,0,0,,《Оң жақ қабырға? 》
Dialogue: 0,0:05:01.75,0:05:05.32,Default,,0,0,0,,Шынында да, оң қолды саналы түрде →
Dialogue: 0,0:05:05.32,0:05:08.46,Default,,0,0,0,,Денесін шыңдап, доптың күші артты.
Dialogue: 0,0:05:08.46,0:05:10.96,Default,,0,0,0,,Бірақ мен қабырғаға тым бей-жай қараймын→
Dialogue: 0,0:05:10.96,0:05:13.79,Default,,0,0,0,,Сіздің оң аяғыңыз тым алыс іште.
Dialogue: 0,0:05:13.79,0:05:15.78,Default,,0,0,0,,Не? Ағзаңыз үйренген соң →
Dialogue: 0,0:05:15.78,0:05:18.67,Default,,0,0,0,,Бұл сізге ескерту алуға көмектесуі мүмкін.
Dialogue: 0,0:05:18.67,0:05:22.74,Default,,0,0,0,,Бірақ енді сіз оны басқара алмайсыз.
Dialogue: 0,0:05:22.74,0:05:24.85,Default,,0,0,0,,Оң жақтағы қабырғаны сезінгенде→
Dialogue: 0,0:05:24.85,0:05:29.35,Default,,0,0,0,,Оң аяғыңыз платформаға түзу сызықта болатындай алға қадам жасаңыз.
Dialogue: 0,0:05:33.98,0:05:37.42,Default,,0,0,0,,Уақыт жоқ. Оны мүмкіндігінше қатты лақтырыңыз.
Dialogue: 0,0:05:37.42,0:05:40.02,Default,,0,0,0,,《Оң аяғыңызды үйге қарай түзу сызыққа қойыңыз...》
Dialogue: 0,0:05:42.84,0:05:47.99,Default,,0,0,0,,Мұқият қара, Миюки.
Dialogue: 0,0:05:47.99,0:05:52.99,Default,,0,0,0,,《Уф, мына екі адам мені көргенде қобалжыймын》
Dialogue: 0,0:05:56.12,0:05:58.92,Default,,0,0,0,,《Оң жақ қабырға...
Dialogue: 0,0:05:58.92,0:06:01.72,Default,,0,0,0,,Оң аяқ платформаға сәйкес келеді》
Dialogue: 0,0:06:05.40,0:06:07.70,Default,,0,0,0,,《Миюки: Уау... сол қолым баяу...》
Dialogue: 0,0:06:10.10,0:06:13.20,Default,,0,0,0,,Бұл… бұл….
Dialogue: 0,0:06:17.79,0:06:19.79,Default,,0,0,0,,Уау~ Мен мұндамын!
Dialogue: 0,0:06:19.79,0:06:22.60,Default,,0,0,0,,Жоқ, бұл жай ғана доп.
Dialogue: 0,0:06:22.60,0:06:24.60,Default,,0,0,0,,Цк.
Dialogue: 0,0:06:30.42,0:06:33.12,Default,,0,0,0,,((Жануар: Не!? Сіріңке?
Dialogue: 0,0:06:33.12,0:06:36.61,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Ал сіз қазір жазып жатырсыз!
Dialogue: 0,0:06:36.61,0:06:40.08,Default,,0,0,0,,Мен матчқа қатыса алмаймын деп ойлаймын.
Dialogue: 0,0:06:40.08,0:06:44.90,Default,,0,0,0,,Бірақ ертең екінші команда үшін соңғы ойын.
Dialogue: 0,0:06:44.90,0:06:48.96,Default,,0,0,0,,Келіңіздер ме, әке))
Dialogue: 0,0:06:48.96,0:06:53.63,Default,,0,0,0,,《Екінші команданың жаттығу матчында адам көп болды.
Dialogue: 0,0:06:53.63,0:06:57.60,Default,,0,0,0,,Жапония мен Американың мәдениеттері әртүрлі болғанымен→
Dialogue: 0,0:06:57.60,0:07:00.58,Default,,0,0,0,,Өзгермеген жалғыз нәрсе - бейсбол жанкүйерлерінің ынта-жігері.
Dialogue: 0,0:07:00.58,0:07:05.91,Default,,0,0,0,,Жапон жанкүйерлерінің арқасында мен бүгін кіммін...》
Dialogue: 0,0:07:05.91,0:07:07.92,Default,,0,0,0,,≪Не болды! ≪Жүріңіз! Бар!
Dialogue: 0,0:07:07.92,0:07:11.41,Default,,0,0,0,,≪Бір шығу, бірінші және екінші негіз.
Dialogue: 0,0:07:11.41,0:07:15.95,Default,,0,0,0,,≪Олар құрбандық шыбынымен және уақытылы соққысымен алға шықты, бірақ олар қайтадан қиындыққа тап болды.
Dialogue: 0,0:07:15.95,0:07:19.47,Default,,0,0,0,,≪Бұл құмыра әлі де тұрақсыз.
Dialogue: 0,0:07:19.47,0:07:32.12,Default,,0,0,0,,♪♪~
Dialogue: 0,0:07:32.12,0:07:34.12,Default,,0,0,0,,Доп!
Dialogue: 0,0:07:34.12,0:07:39.57,Default,,0,0,0,,Саваму ра~! Эй!
Dialogue: 0,0:07:39.57,0:07:43.29,Default,,0,0,0,,《Алғашқы әсерім өте нашар болды.
Dialogue: 0,0:07:43.29,0:07:46.30,Default,,0,0,0,,Барлық нашар бөліктер шарға айналады》
Dialogue: 0,0:07:46.30,0:07:49.73,Default,,0,0,0,,Жарайды, жарайды, допты ұстама.
Dialogue: 0,0:07:49.73,0:07:53.49,Default,,0,0,0,,Тек тәтті шарларды мақсат етіңіз, қиын!
Dialogue: 0,0:07:53.49,0:07:57.49,Default,,0,0,0,,《Цу~, мына жігіттің добының уақытын біліңіз》
Dialogue: 0,0:08:02.31,0:08:04.81,Default,,0,0,0,,Сәлем! Алдымен доп!
Dialogue: 0,0:08:08.59,0:08:10.95,Default,,0,0,0,,≪Өт!
Dialogue: 0,0:08:10.95,0:08:13.27,Default,,0,0,0,,Жарайды, екеуі шықты!
Dialogue: 0,0:08:13.27,0:08:16.91,Default,,0,0,0,,Әй! Әлі екі жүгіруші қалды, босаңсып қалмаңыз!
Dialogue: 0,0:08:16.91,0:08:18.95,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:18.95,0:08:24.37,Default,,0,0,0,,《Тәтті курс деп ойладым, бірақ доп... қозғалды ма? 》
Dialogue: 0,0:08:24.37,0:08:26.25,Default,,0,0,0,,《Көктем қаласы: Қандай да бір себептермен →
Dialogue: 0,0:08:26.25,0:08:29.96,Default,,0,0,0,,Мен бірде-бір лайықты соққы алған жоқпын.
Dialogue: 0,0:08:29.96,0:08:34.91,Default,,0,0,0,,О, құдай-ау, әлгі жынды бала бастаушы ма?
Dialogue: 0,0:08:34.91,0:08:40.60,Default,,0,0,0,,Дегенмен, мен оның қимыл-қозғалыс шебері екенін білмедім, бұл Жапонияда жиі кездесе бермейді.
Dialogue: 0,0:08:40.60,0:08:44.09,Default,,0,0,0,,Әй, бұл жануар! Бұл комедияның жануары!
Dialogue: 0,0:08:44.09,0:08:47.66,Default,,0,0,0,,Неліктен танымал комедия мұнда? ? Бұл өте үлкен!
Dialogue: 0,0:08:47.66,0:08:51.66,Default,,0,0,0,,Комедияшы кім? Мен бейсбол адамымын!
Dialogue: 0,0:08:53.63,0:08:55.57,Default,,0,0,0,,Ю Ю!
Dialogue: 0,0:08:55.57,0:08:59.52,Default,,0,0,0,,Сіз не үшін матчтасыз? Менде жағымсыз сезім болды.
Dialogue: 0,0:08:59.52,0:09:03.62,Default,,0,0,0,,Бұл мектеп менің баламды құртпақшы!
Dialogue: 0,0:09:03.62,0:09:09.08,Default,,0,0,0,,《Крис: Аа... Келдің, әке.》
Dialogue: 0,0:09:09.08,0:09:11.11,Default,,0,0,0,,Эй Ю!
Dialogue: 0,0:09:11.11,0:09:15.91,Default,,0,0,0,,Ойын әлі алда. Қойайық!
Dialogue: 0,0:09:21.12,0:09:24.91,Default,,0,0,0,,《Ю... сен неге?》
Dialogue: 0,0:09:24.91,0:09:27.96,Default,,0,0,0,,Крис-сенпай, сен қатты шу шығарып тұрсың!
Dialogue: 0,0:09:27.96,0:09:31.42,Default,,0,0,0,,Бірақ менің даусым сәл бәсең болды.
Dialogue: 0,0:09:31.42,0:09:36.01,Default,,0,0,0,,Шулы, тек қолға дұрыс лақтыруды ойлаңыз.
Dialogue: 0,0:09:36.01,0:09:38.11,Default,,0,0,0,,Тек осы жолы ғана көз жұма қараймын.
Dialogue: 0,0:09:40.28,0:09:43.16,Default,,0,0,0,,《Мені қорғайтын достарым бар.
Dialogue: 0,0:09:43.16,0:09:51.30,Default,,0,0,0,,Менің қолымдағының бәрін Крис-сенпайдың қолтығына лақтыру ғана қалды! 》
Dialogue: 0,0:09:51.30,0:09:56.46,Default,,0,0,0,,《Не... Мен допты сермеуге кешігіп қалдым! 》
Dialogue: 0,0:09:56.46,0:09:59.25,Default,,0,0,0,,≪Сіз оны ұстау үшін шығуды жоспарлап отырсыз ба? ? Сол ұстаушы!
Dialogue: 0,0:09:59.25,0:10:02.97,Default,,0,0,0,,Ю Ақылсыз болмаңыз!
Dialogue: 0,0:10:02.97,0:10:06.92,Default,,0,0,0,,《Крис: Әке... Уәдеңізді бұзғаным үшін кешіріңіз.
Dialogue: 0,0:10:06.92,0:10:10.61,Default,,0,0,0,,Екінші команда және жаттығу матчы...
Dialogue: 0,0:10:10.61,0:10:12.58,Default,,0,0,0,,Сіздің кезегіңіз болмаса да →
Dialogue: 0,0:10:12.58,0:10:17.91,Default,,0,0,0,,Мен жай ғана әкемнің осы матчты дұрыс көргенін қаладым.
Dialogue: 0,0:10:17.91,0:10:20.60,Default,,0,0,0,,Бұл... мен үшін →
Dialogue: 0,0:10:20.60,0:10:23.20,Default,,0,0,0,,Өйткені бұл соңғы ресми матч...》
Dialogue: 0,0:10:27.62,0:10:31.93,Default,,0,0,0,,Ах! Жоқ!
Dialogue: 0,0:10:31.93,0:10:34.28,Default,,0,0,0,,≪Не? Сенімен бәрі жақсы ма? ≪Эй.
Dialogue: 0,0:10:34.28,0:10:36.60,Default,,0,0,0,,≪Ол ұсталды!
Dialogue: 0,0:10:36.60,0:10:39.99,Default,,0,0,0,,≪Соңғы минутта қоршау! Ол ойланбастан ішке кірді!
Dialogue: 0,0:10:39.99,0:10:43.66,Default,,0,0,0,,≪Жараланып қалудан қорықпайсыз ба? ? Әлгі жігіт!
Dialogue: 0,0:10:43.66,0:10:45.96,Default,,0,0,0,,Амансың ба? ? Крис Сенпай!
Dialogue: 0,0:10:48.91,0:10:50.90,Default,,0,0,0,,Уайымдамаңыз.
Dialogue: 0,0:10:50.90,0:10:55.92,Default,,0,0,0,,Бұл сіз ойлағандай қауіпті емес.
Dialogue: 0,0:10:55.92,0:10:58.96,Default,,0,0,0,,Таку... Мені үрейлендірме.
Dialogue: 0,0:10:58.96,0:11:01.62,Default,,0,0,0,,Бос болса да, ойсыз.
Dialogue: 0,0:11:01.62,0:11:03.98,Default,,0,0,0,,《Хаха! Ол өзгерген жоқ.
Dialogue: 0,0:11:03.98,0:11:07.25,Default,,0,0,0,,Біреуін шығаруға сараңдық→
Dialogue: 0,0:11:07.25,0:11:11.67,Default,,0,0,0,,Команданы жеңіске жетелейтін фигура...
Dialogue: 0,0:11:11.67,0:11:15.97,Default,,0,0,0,,Бұл... Крис-сенпайдың ойын мәнері.
Dialogue: 0,0:11:23.61,0:11:26.27,Default,,0,0,0,,((Ей, эй, Жануар, тоқтат!
Dialogue: 0,0:11:26.27,0:11:28.33,Default,,0,0,0,,Ертең де ойын бар! ?
Dialogue: 0,0:11:28.33,0:11:33.63,Default,,0,0,0,,Бұл менің өмірім. Мені жалғыз қалдыр. Мен оны бәрібір шайқауым керек... Мен ұйықтай алмаймын! ))
Dialogue: 0,0:11:36.59,0:11:42.00,Default,,0,0,0,,Нуо~! Мен гол саламын! Бұл құмарлықты жарғанатқа салыңыз!
Dialogue: 0,0:11:42.00,0:11:45.28,Default,,0,0,0,,Хун хун хун...! Эйджун-кун, демал, демал.
Dialogue: 0,0:11:45.28,0:11:47.30,Default,,0,0,0,,Егер сіз шиеленіссеңіз, жарғанатты сермете алмайсыз.
Dialogue: 0,0:11:47.30,0:11:49.24,Default,,0,0,0,,Ах.
Dialogue: 0,0:11:49.24,0:11:51.26,Default,,0,0,0,,≪Мен шықтым! Сол жақта.
Dialogue: 0,0:11:51.26,0:11:53.58,Default,,0,0,0,,≪Бұл қатты соққы болды.
Dialogue: 0,0:11:53.58,0:11:57.30,Default,,0,0,0,,Уау, сен маған көбірек мүмкіндіктер аштың.
Dialogue: 0,0:11:57.30,0:12:01.90,Default,,0,0,0,,Крис-сенпай! Мен олай ойламаймын...
Dialogue: 0,0:12:01.90,0:12:05.25,Default,,0,0,0,,Әлгі жігіттің соққаны да тот емес.
Dialogue: 0,0:12:05.25,0:12:09.99,Default,,0,0,0,,《Тамба: Бірінші армияға көтерілуге ​​екі-ақ орын қалды.
Dialogue: 0,0:12:09.99,0:12:12.59,Default,,0,0,0,,Кел, Крис! 》
Dialogue: 0,0:13:45.92,0:13:48.27,Default,,0,0,0,,Не!
Dialogue: 0,0:13:48.27,0:13:50.59,Default,,0,0,0,,Савамура тоқаш жасады.
Dialogue: 0,0:13:50.59,0:13:53.96,Default,,0,0,0,,Доптың екпінін жойған талғампаз бунт.
Dialogue: 0,0:13:53.96,0:13:55.98,Default,,0,0,0,,Крис-сенпай базаға оңай жетеді!
Dialogue: 0,0:13:55.98,0:13:58.95,Default,,0,0,0,,Керемет тоқаш! Керемет тоқаш!
Dialogue: 0,0:13:58.95,0:14:02.91,Default,,0,0,0,,Керемет Савамура! Бұл Магуре шығар.
Dialogue: 0,0:14:02.91,0:14:07.28,Default,,0,0,0,,Қолтаңбаны дұрыс есте сақтағанына сене алар емеспін! Хахахаха!
Dialogue: 0,0:14:07.28,0:14:10.91,Default,,0,0,0,,《Бәрекелді... Мен туралы бәрің қалай ойлайсыңдар!? ?
Dialogue: 0,0:14:10.91,0:14:15.62,Default,,0,0,0,,Крис-сенпай, мен үйге соққым келді! 》
Dialogue: 0,0:14:15.62,0:14:20.01,Default,,0,0,0,,《Бір себептермен сен тек қана тоқымашылықта жақсысың, Эйджун.》
Dialogue: 0,0:14:20.01,0:14:22.28,Default,,0,0,0,,Екінші негізде бір-ақ шыққан жүгіруші.
Dialogue: 0,0:14:22.28,0:14:24.94,Default,,0,0,0,,Сонымен қатар, соғу реті осыдан бастап ең жоғарғы соққылар қатары болып табылады.
Dialogue: 0,0:14:24.94,0:14:27.91,Default,,0,0,0,,Мұндағы нүкте алшақтығын жылдам кеңейте аламыз ба?
Dialogue: 0,0:14:27.91,0:14:30.62,Default,,0,0,0,,Бұл ерте кезеңдерде шарықтау шегі болатын сияқты.
Dialogue: 0,0:14:30.62,0:14:35.29,Default,,0,0,0,,Көктем! Демалыңыз демалыңыз! Шыдасаң, жарғанатты сермеп кете алмайсың!
Dialogue: 0,0:14:35.29,0:14:40.93,Default,,0,0,0,,Хахахаха! Жоқ, бұл менің айтқаным...
Dialogue: 0,0:14:40.93,0:14:43.95,Default,,0,0,0,,《Бірақ Эйджун-кун мен Крис-сенпай→
Dialogue: 0,0:14:43.95,0:14:47.95,Default,,0,0,0,,Бұл мүмкіндік екі батареядан жасалған →
Dialogue: 0,0:14:47.95,0:14:51.25,Default,,0,0,0,,Үмітті ақтамасаң, еркек емессің! 》
Dialogue: 0,0:14:51.25,0:14:54.66,Default,,0,0,0,,Әзірге бұл таңғажайып 50%.
Dialogue: 0,0:14:54.66,0:14:58.66,Default,,0,0,0,,Алғаш рет үздік батер ретінде таңдалса, ол қалай жауап береді?
Dialogue: 0,0:15:01.11,0:15:03.12,Default,,0,0,0,,《Рахмет: Бағаларға қарасаңыз →
Dialogue: 0,0:15:03.12,0:15:06.32,Default,,0,0,0,,Бірінші армияға көтерілу үшін шарттарды толығымен орындадым.
Dialogue: 0,0:15:06.32,0:15:11.32,Default,,0,0,0,,Бұл мүмкіндікті барынша пайдалану үшін сізде бәсекеге қабілеттілік бар ма, жоқ па, сонда ғана қалады.
Dialogue: 0,0:15:14.81,0:15:18.93,Default,,0,0,0,,《Харуичи: Сырттағы алаң үйге емес, алға жылжуда.
Dialogue: 0,0:15:18.93,0:15:22.43,Default,,0,0,0,,Менің ойымша, адамдар ұзақ хит жоқ деп ойлайды.
Dialogue: 0,0:15:28.17,0:15:30.27,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:32.60,0:15:34.78,Default,,0,0,0,,Бұзушылық!
Dialogue: 0,0:15:34.78,0:15:37.12,Default,,0,0,0,,Сол денемен толық серпілу! ?
Dialogue: 0,0:15:37.12,0:15:40.07,Default,,0,0,0,,Бұл жігіттің де ұзақ соққысы бар.
Dialogue: 0,0:15:40.07,0:15:42.29,Default,,0,0,0,,《Мен сені құлатпақ болғаныммен→
Dialogue: 0,0:15:42.29,0:15:45.41,Default,,0,0,0,,Ол биік допты жол бойы алып жүрді.
Dialogue: 0,0:15:45.41,0:15:49.11,Default,,0,0,0,,Хмм, мен сәл зеріккен шығармын?
Dialogue: 0,0:15:49.11,0:15:52.48,Default,,0,0,0,,《Бұл жігіт...》
Dialogue: 0,0:15:52.48,0:15:56.17,Default,,0,0,0,,《Ей, эй, ерте келгеніміз дұрыс па? 》
Dialogue: 0,0:15:56.17,0:16:00.27,Default,,0,0,0,,《Бұл әлі ерте кезең, сондықтан ұзақ хиттерден сақ болу керек...》
Dialogue: 0,0:16:05.63,0:16:08.13,Default,,0,0,0,,《Слайдер сыртында》
Dialogue: 0,0:16:14.84,0:16:17.34,Default,,0,0,0,,Ах! Үйге жарық!
Dialogue: 0,0:16:19.93,0:16:22.93,Default,,0,0,0,,Ей, ақымақ, неге төменге түстің!
Dialogue: 0,0:16:26.45,0:16:28.92,Default,,0,0,0,,《Қандай қорқынышты адам》
Dialogue: 0,0:16:28.92,0:16:30.92,Default,,0,0,0,,Қауіпсіз!
Dialogue: 0,0:16:32.99,0:16:37.43,Default,,0,0,0,,《Крис: икемді жараларды басқару, нағыз дарынды талант.
Dialogue: 0,0:16:37.43,0:16:43.33,Default,,0,0,0,,Менің талғамым ағамнан асып түсуі мүмкін...》
Dialogue: 0,0:16:43.33,0:16:45.40,Default,,0,0,0,,Әй, үшінші нүкте!
Dialogue: 0,0:16:45.40,0:16:47.57,Default,,0,0,0,,Күткендей, менің бөренем үлкен болды.
Dialogue: 0,0:16:47.57,0:16:50.01,Default,,0,0,0,,Бұл үшеуміз үшін бір ұпай!
Dialogue: 0,0:16:50.01,0:16:52.09,Default,,0,0,0,,Сәлем! Мен жақсы бота!
Dialogue: 0,0:16:52.09,0:16:55.80,Default,,0,0,0,,Оны қатты итермеңіз.
Dialogue: 0,0:16:55.80,0:17:01.25,Default,,0,0,0,,Бақытты болуға уақыт жоқ. Оны жай ғана бұқаға салыңыз.
Dialogue: 0,0:17:01.25,0:17:04.92,Default,,0,0,0,,Бұл менің сізбен соңғы кездесуім болады.
Dialogue: 0,0:17:04.92,0:17:07.96,Default,,0,0,0,,Ең жақсы допты лақтыр.
Dialogue: 0,0:17:07.96,0:17:10.76,Default,,0,0,0,,Е! ? Сен не туралы айтып тұрсың?
Dialogue: 0,0:17:10.76,0:17:13.30,Default,,0,0,0,,Біз батареяларды жаңадан бастап жатырмыз!
Dialogue: 0,0:17:13.30,0:17:16.68,Default,,0,0,0,,Харучи, Крис-сенпай және әрине мен де→
Dialogue: 0,0:17:16.68,0:17:19.24,Default,,0,0,0,,Барлығымыз үздік болуды мақсат етейік!
Dialogue: 0,0:17:19.24,0:17:21.95,Default,,0,0,0,,Уау...
Dialogue: 0,0:17:21.95,0:17:24.59,Default,,0,0,0,,《Бірінші команда үшін екі көтерілу орны бар...》
Dialogue: 0,0:17:24.59,0:17:26.63,Default,,0,0,0,,Уау...
Dialogue: 0,0:17:26.63,0:17:30.78,Default,,0,0,0,,《Крис: Сен бұл туралы баяғыда ұмытып кеткен сияқтысың》
Dialogue: 0,0:17:30.78,0:17:33.45,Default,,0,0,0,,Хахаха…. Ақымақ күлкі дегеннің бәрі осы. Барайық.
Dialogue: 0,0:17:33.45,0:17:35.45,Default,,0,0,0,,Тек осы жолы ғана көз жұма қараймын.
Dialogue: 0,0:17:35.45,0:17:38.84,Default,,0,0,0,,《Бірақ маған бұл жігіттің оң көзқарасы ұнайды→
Dialogue: 0,0:17:38.84,0:17:41.49,Default,,0,0,0,,Мен өзімді құтқарылғандай сезінемін》
Dialogue: 0,0:17:41.49,0:17:45.09,Default,,0,0,0,,Эй Ю, сәл күте тұр!
Dialogue: 0,0:17:49.43,0:17:51.43,Default,,0,0,0,,Әке….
Dialogue: 0,0:17:53.62,0:17:57.57,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:17:57.57,0:18:02.28,Default,,0,0,0,,《Жануар: Иә, дұрыс...》
Dialogue: 0,0:18:02.28,0:18:04.91,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:18:04.91,0:18:08.92,Default,,0,0,0,,《Жануар: Тек ойыншылар өздерінің сезімдерін түсіне алады.
Dialogue: 0,0:18:08.92,0:18:11.95,Default,,0,0,0,,Үйренбеген мәдениет Үйренбеген орта.
Dialogue: 0,0:18:11.95,0:18:17.08,Default,,0,0,0,,Белсенді ойыншы болған кезімде мен тек қана жарғанақты сермедім.
Dialogue: 0,0:18:17.08,0:18:24.28,Default,,0,0,0,,Менің Жапония деп аталатын шет елде бар екенімді дәлелдеу үшін》
Dialogue: 0,0:18:24.28,0:18:31.74,Default,,0,0,0,,♪♪~
Dialogue: 0,0:18:31.74,0:18:34.31,Default,,0,0,0,,Қайта….
Dialogue: 0,0:18:34.31,0:18:38.78,Default,,0,0,0,,Мылтық… Барре….
Dialogue: 0,0:18:38.78,0:18:43.67,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе… Юу….
Dialogue: 0,0:18:43.67,0:18:47.12,Default,,0,0,0,,《Өкінбесең →
Dialogue: 0,0:18:47.12,0:18:49.98,Default,,0,0,0,,Бұл жақсы…》
Dialogue: 0,0:18:49.98,0:18:53.06,Default,,0,0,0,,Ганбаре….
Dialogue: 0,0:18:53.06,0:18:57.15,Default,,0,0,0,,♪♪~
Dialogue: 0,0:18:57.15,0:19:01.25,Default,,0,0,0,,《Крис: Рахмет... Әке》
Dialogue: 0,0:19:08.58,0:19:11.28,Default,,0,0,0,,Нуо~! Неліктен? ?
Dialogue: 0,0:19:11.28,0:19:16.74,Default,,0,0,0,,Мен өзімді алаңнан тыс үйге жүгіргендей сезінемін! ! Маэзоно Сенпай! демалыңыз демалыңыз.
Dialogue: 0,0:19:16.74,0:19:19.79,Default,,0,0,0,,Сіз сүзіп алсаңыз, жарғанат... Жакаашии! !
Dialogue: 0,0:19:19.79,0:19:25.34,Default,,0,0,0,,《Маэзононың үлкен тербелісі сенімді емес, бірақ оның соққы күшін елемеу қиын.
Dialogue: 0,0:19:25.34,0:19:29.06,Default,,0,0,0,,Коминато жалпы күш бойынша үздік шықты...
Dialogue: 0,0:19:29.06,0:19:33.54,Default,,0,0,0,,Қаруы қозғалатын доп Савамура да қызық.
Dialogue: 0,0:19:33.54,0:19:36.41,Default,,0,0,0,,Ал Крис….
Dialogue: 0,0:19:36.41,0:19:42.61,Default,,0,0,0,,Басқа 2-ші және 3-ші курс мүшелері бірінші команданың мүшелері ретінде таңдалса, таң қалмас еді.
Dialogue: 0,0:19:42.61,0:19:47.00,Default,,0,0,0,,Осы жерден екі адам...
Dialogue: 0,0:19:47.00,0:19:51.40,Default,,0,0,0,,Директор Катаока кімді таңдайды? 》
Dialogue: 0,0:19:51.40,0:19:54.11,Default,,0,0,0,,Сәлем! Мен де бұл жолы қатты соғамын!
Dialogue: 0,0:19:54.11,0:19:56.09,Default,,0,0,0,,Барлығына сәлем! !
Dialogue: 0,0:19:56.09,0:19:58.61,Default,,0,0,0,,Идиот! Төрт шардың санын азайтыңыз, содан кейін айтыңыз!
Dialogue: 0,0:19:58.61,0:20:01.45,Default,,0,0,0,,(Жолаушы) Соңғы сегіздік пе? Сен керемет көріндің.
Dialogue: 0,0:20:01.45,0:20:06.42,Default,,0,0,0,,Tsk! Сіз бірінші курс құмырасына қарсы не істеп жатырсыз?
Dialogue: 0,0:20:06.42,0:20:11.61,Default,,0,0,0,,Өкінішті. Осы қарқынмен біз осы жазда да Кошиенді ойнай алмаймыз.
Dialogue: 0,0:20:11.61,0:20:15.59,Default,,0,0,0,,Зайзен. (Зайзен) А, сен мені естідің бе?
Dialogue: 0,0:20:15.59,0:20:21.39,Default,,0,0,0,,Эй... Мен саған арнайы кеңес беремін.
Dialogue: 0,0:20:29.84,0:20:31.88,Default,,0,0,0,,Доп!
Dialogue: 0,0:20:31.88,0:20:34.13,Default,,0,0,0,,Қауіпсіз! Ахх! !
Dialogue: 0,0:20:34.13,0:20:37.10,Default,,0,0,0,,Осы сәттен бастап мен тым қатты күйде болдым!
Dialogue: 0,0:20:37.10,0:20:40.25,Default,,0,0,0,,《Мына жігіт бірінші ұрып-соққаннан кейін батты ма?
Dialogue: 0,0:20:40.25,0:20:43.61,Default,,0,0,0,,Савамураны сілкіп тастадың ба?
Dialogue: 0,0:20:43.61,0:20:46.43,Default,,0,0,0,,Алданбаңыз!
Dialogue: 0,0:20:46.43,0:20:49.11,Default,,0,0,0,,Бірінші ұршық қайтадан жүрсін! !
Dialogue: 0,0:20:49.11,0:20:52.50,Default,,0,0,0,,Эйджун-кун, сабыр ет. Сіз → жаза аласыз
Dialogue: 0,0:20:52.50,0:20:55.42,Default,,0,0,0,,Оларды бір-бірден шығарайық. Иә!
Dialogue: 0,0:20:55.42,0:20:58.45,Default,,0,0,0,,Жоқ, мен аға емеспін...
Dialogue: 0,0:20:58.45,0:21:03.91,Default,,0,0,0,,Хехе... Шайқаңыз Жақсылап шайқаңыз.
Dialogue: 0,0:21:03.91,0:21:09.98,Default,,0,0,0,,♪♪~
Dialogue: 0,0:21:09.98,0:21:15.09,Default,,0,0,0,,Анау тентекті қолынан келгенше айдап салып жатыр.
Dialogue: 0,0:21:15.09,0:21:17.14,Default,,0,0,0,,Польнареффтің қылышынан да жылдам болды. Құдай-ай!》
Dialogue: 0,0:21:17.14,0:21:19.21,Default,,0,0,0,,Қауіпсіз!
Dialogue: 0,0:21:19.21,0:21:21.43,Default,,0,0,0,,《Жоқ...》
Dialogue: 0,0:21:21.43,0:21:24.88,Default,,0,0,0,,《Бірақ бұл жақсы, Зайзен》
Dialogue: 0,0:21:24.88,0:21:26.88,Default,,0,0,0,,Хэхехе….
Dialogue: 0,0:21:30.12,0:21:34.72,Default,,0,0,0,,Үш бота! ? 《Адасып қалмаңдар, қолдарыңды барынша сермеңдер》
Dialogue: 0,0:21:36.79,0:21:39.65,Default,,0,0,0,,Үш қателік! Қандай ысырап! !
Dialogue: 0,0:21:39.65,0:21:42.67,Default,,0,0,0,,Сәлем! Бірінші шықты!
Dialogue: 0,0:21:42.67,0:21:46.67,Default,,0,0,0,,《Иә... бұл саған жақсы》
Dialogue: 0,0:21:49.41,0:21:51.46,Default,,0,0,0,,Уау... бұл жаман.
Dialogue: 0,0:21:51.46,0:21:53.83,Default,,0,0,0,,Жақсы жұмыс Жақсы жұмыс.
Dialogue: 0,0:21:53.83,0:21:55.95,Default,,0,0,0,,Оған сонша лақтыруға рұқсат етіңіз.
Dialogue: 0,0:21:55.95,0:22:00.97,Default,,0,0,0,,Сізді шайқап тұрған құмыра емес.
Dialogue: 0,0:22:00.97,0:22:03.75,Default,,0,0,0,,Өйткені ол ұстайтын адам.
Dialogue: 0,0:22:03.75,0:22:07.81,Default,,0,0,0,,Мен орта мектепте оқып жүрген кезімде мен Покемонды көретін адам едім.
Dialogue: 0,0:22:07.81,0:22:11.76,Default,,0,0,0,,Иә, мен бір рет иығымды сындырдым.
Dialogue: 0,0:22:11.76,0:22:16.83,Default,,0,0,0,,Егер сіз оларға көбірек лақтыруға рұқсат етсеңіз, онда әрқашан шүберек болады.
Dialogue: 0,0:22:16.83,0:22:20.95,Default,,0,0,0,,《Бант тағы?》
Dialogue: 0,0:22:20.95,0:22:23.26,Default,,0,0,0,,Жүр!
Dialogue: 0,0:22:23.26,0:22:26.61,Default,,0,0,0,,Болат! ? Ол толығымен ұрланған.
Dialogue: 0,0:22:26.61,0:22:30.70,Default,,0,0,0,,《Сіз оны уақытында жасайсыз ба? ? 》
Dialogue: 0,0:22:30.70,0:22:33.58,Default,,0,0,0,,Қауіпсіз!
Dialogue: 0,0:22:33.58,0:22:35.62,Default,,0,0,0,,≪Сіз не істедіңіз?
Dialogue: 0,0:22:35.62,0:22:39.25,Default,,0,0,0,,≪Сол ұстаушы допты нашар лақтырды ма?
Dialogue: 0,0:22:39.25,0:22:41.96,Default,,0,0,0,,Хехе... Хахахаха!
Dialogue: 0,0:22:41.96,0:22:44.94,Default,,0,0,0,,Бұл не? Ол шайтан жын сияқты болды →
Dialogue: 0,0:22:44.94,0:22:46.95,Default,,0,0,0,,Көрінетін көлеңке емес!
Dialogue: 0,0:22:46.95,0:22:51.28,Default,,0,0,0,,Әлгі бейбақ әлі толық сауығып кеткен жоқ.
Dialogue: 0,0:22:51.28,0:22:55.92,Default,,0,0,0,,Жүгір, жүгір, қатты жүгір! Хахаха….
Dialogue: 0,0:22:55.92,0:22:58.12,Default,,0,0,0,,《Менің иығым әлі...》
Dialogue: 0,0:22:58.12,0:23:03.91,Default,,0,0,0,,Крис-сенпай! Жарайды, уайымдама.
Dialogue: 0,0:23:03.91,0:23:06.27,Default,,0,0,0,,Ю….
Dialogue: 0,0:23:06.27,0:23:10.30,Default,,0,0,0,,Үйдегі жалғыз алаң!
Dialogue: 0,0:23:10.30,0:23:13.92,Default,,0,0,0,,Infield Бір-бірден барайық! (Көктем қаласы/Маэзоно) Иә!
Dialogue: 0,0:23:13.92,0:23:17.99,Default,,0,0,0,,Жүгірушілер туралы алаңдамаңыз! Барынша лақтыр, Савамура!
Dialogue: 0,0:23:17.99,0:23:20.09,Default,,0,0,0,,Иә!
Dialogue: 0,0:23:26.12,0:23:30.67,Default,,0,0,0,,《Қалағаныңша банта.
Dialogue: 0,0:23:30.67,0:23:34.17,Default,,0,0,0,,Мен енді Крис-сенпайдың қолғаптарын ғана көремін.
Dialogue: 0,0:23:39.13,0:23:41.18,Default,,0,0,0,,Мен оны аламын! Маған қалдырыңыз.
Dialogue: 0,0:23:41.18,0:23:43.27,Default,,0,0,0,,《Уақыт бойынша үшінші》
Dialogue: 0,0:23:43.27,0:23:46.81,Default,,0,0,0,,Бұл мүмкін емес, уақытында үлгермейміз.
Dialogue: 0,0:23:46.81,0:23:50.63,Default,,0,0,0,,Қауіпсіз!
Dialogue: 0,0:23:50.63,0:23:56.08,Default,,0,0,0,,≪Уау, үшінші орынға Филдердің таңдауы! Бірінші база мен үшінші базаның барлығы қауіпсіз.
Dialogue: 0,0:23:56.08,0:23:59.79,Default,,0,0,0,,≪Кенет доп лақтыра бастады.
Dialogue: 0,0:23:59.79,0:24:05.44,Default,,0,0,0,,Крис-сенпай.
Dialogue: 0,0:24:05.44,0:24:08.61,Default,,0,0,0,,Орта мектептегі бейсболға бар болғаны екі жарым жыл→
Dialogue: 0,0:24:08.61,0:24:14.03,Default,,0,0,0,,Бір жылдың бос орны қандай үлкен→
Dialogue: 0,0:24:14.03,0:24:18.09,Default,,0,0,0,,Сіз аяқтадыңыз.
Dialogue: 0,0:24:18.09,0:24:23.29,Default,,0,0,0,,Олар бір кездері бір-бірімен жарысқан үлкен қарсыластар болды.
Dialogue: 0,0:24:23.29,0:24:28.95,Default,,0,0,0,,Саған бағыт беру менің міндетім, Крис...
Dialogue: 0,0:24:28.95,0:24:31.92,Default,,0,0,0,,《Зайзен》
Dialogue: 0,0:24:31.92,0:24:34.32,Default,,0,0,0,,Бір шығу, 1-ші және 3-ші негіз.
Dialogue: 0,0:24:34.32,0:24:36.82,Default,,0,0,0,,Бұл аулаушы үлкен қателік жіберді.
Dialogue: 0,0:24:40.24,0:24:44.45,Default,,0,0,0,,((Сізге берілген мүмкіндік - 3 иннинг.
Dialogue: 0,0:24:44.45,0:24:52.25,Default,,0,0,0,,Өкінбей сөйле, Савамура))
Dialogue: 0,0:24:52.25,0:24:56.96,Default,,0,0,0,,《Мен не істеп жатырмын?
Dialogue: 0,0:24:56.96,0:25:01.58,Default,,0,0,0,,Мен Крис-сенпаймен бірге батарея жинадым.
Dialogue: 0,0:25:01.58,0:25:06.74,Default,,0,0,0,,Сіз қиыншылыққа тап болдыңыз, өйткені сіз өзіңізге әкелген жағдайға тап болдыңыз.
Dialogue: 0,0:25:06.74,0:25:09.51,Default,,0,0,0,,Мен...
Dialogue: 0,0:25:09.51,0:25:14.01,Default,,0,0,0,,Мен Крис-сенпайға әлі ештеңе қайтарған жоқпын! 》
Dialogue: 0,0:25:15.51,0:25:21.51,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory