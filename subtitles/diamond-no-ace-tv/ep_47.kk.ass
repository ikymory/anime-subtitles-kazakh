Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:33.53,0:00:38.85,Default,,0,0,0,,♪♪~
Dialogue: 0,0:00:38.85,0:00:42.80,Default,,0,0,0,,Ямада, өтінемін!
Dialogue: 0,0:00:42.80,0:00:44.80,Default,,0,0,0,,Әлі алда!
Dialogue: 0,0:00:44.80,0:00:47.02,Default,,0,0,0,,Ол төмендеп келеді. (Масуко) Уга!
Dialogue: 0,0:00:47.02,0:00:49.48,Default,,0,0,0,,Мен допты көріп тұрмын. (Таңба) Бір бөтелке, өтінемін.
Dialogue: 0,0:00:49.48,0:00:53.85,Default,,0,0,0,,♪♪~
Dialogue: 0,0:00:53.85,0:00:56.20,Default,,0,0,0,,О! кел!
Dialogue: 0,0:00:56.20,0:01:00.35,Default,,0,0,0,,《Наримия: Ештеңе емес, шайқас бітті》
Dialogue: 0,0:01:00.35,0:01:06.35,Default,,0,0,0,,♪♪~
Dialogue: 0,0:01:11.18,0:01:17.99,Default,,0,0,0,,♪♪~
Dialogue: 0,0:01:17.99,0:01:23.01,Default,,0,0,0,,Уф... уау!
Dialogue: 0,0:01:23.01,0:01:35.32,Default,,0,0,0,,♪♪~
Dialogue: 0,0:01:35.32,0:01:41.42,Default,,0,0,0,,Сол үшін айттым ғой, солай ма? Өкінсем де, білмеймін.
Dialogue: 0,0:04:25.53,0:04:28.18,Default,,0,0,0,,Жатақханаға қайтқанда жиналыс болады.
Dialogue: 0,0:04:28.18,0:04:31.00,Default,,0,0,0,,Денеңізді бірден қозғалтпасаңыз, жарылып кетесіз.
Dialogue: 0,0:04:31.00,0:04:33.03,Default,,0,0,0,,Уга.
Dialogue: 0,0:04:33.03,0:04:35.33,Default,,0,0,0,,Сіз бірдеңені ұмыттыңыз ба?
Dialogue: 0,0:04:37.35,0:04:40.71,Default,,0,0,0,,Бұл сөмке кімдікі?
Dialogue: 0,0:04:40.71,0:04:43.34,Default,,0,0,0,,Савамура, сен ше?
Dialogue: 0,0:04:43.34,0:04:45.50,Default,,0,0,0,,Миюки-кун мені ваннаға апарды.
Dialogue: 0,0:04:45.50,0:04:48.10,Default,,0,0,0,,Ол мені алып кетті...
Dialogue: 0,0:04:51.18,0:04:53.54,Default,,0,0,0,,Қамқоршы?
Dialogue: 0,0:04:53.54,0:04:55.59,Default,,0,0,0,,Асығыңыз.
Dialogue: 0,0:04:55.59,0:04:57.51,Default,,0,0,0,,Артыңнан ермей-ақ қойсам ғой.
Dialogue: 0,0:04:57.51,0:04:59.64,Default,,0,0,0,,Балалар сендер оңай адасып кетесіңдер.
Dialogue: 0,0:04:59.64,0:05:02.48,Default,,0,0,0,,Шулы! Сізде әрқашан тым көп сөздер болады!
Dialogue: 0,0:05:02.48,0:05:04.85,Default,,0,0,0,,Эйджун-кун Тамегучи Жақсы емес.
Dialogue: 0,0:05:04.85,0:05:07.23,Default,,0,0,0,,Алдымен өтіңіз. О, менің!
Dialogue: 0,0:05:07.23,0:05:10.14,Default,,0,0,0,,≪Нарумия Керемет болды.
Dialogue: 0,0:05:10.14,0:05:12.17,Default,,0,0,0,,≪Соғыс тізбегі де керемет болды.
Dialogue: 0,0:05:12.17,0:05:15.17,Default,,0,0,0,,Инами биыл тағы да жеңімпаз атана ма?
Dialogue: 0,0:05:22.97,0:05:26.65,Default,,0,0,0,,《Жақсы, әрине→
Dialogue: 0,0:05:26.65,0:05:32.09,Default,,0,0,0,,Біз бұл күшті соққылар тізбегін құмыралармен басу керек.
Dialogue: 0,0:05:32.09,0:05:38.83,Default,,0,0,0,,Ең бастысы, сіз Нарудан ұпай алмасаңыз, ойында ұта алмайсыз.
Dialogue: 0,0:05:38.83,0:05:42.83,Default,,0,0,0,,Бұл екі жағдайда да қиын шайқас болатын сияқты.
Dialogue: 0,0:05:45.05,0:05:48.05,Default,,0,0,0,,Бұл Миюки емес пе?
Dialogue: 0,0:05:51.33,0:05:54.21,Default,,0,0,0,,Не, балалар әлі оралмадыңдар ма?
Dialogue: 0,0:05:54.21,0:05:57.27,Default,,0,0,0,,Трибунадан биік көрініс па?
Dialogue: 0,0:05:57.27,0:05:59.84,Default,,0,0,0,,бойынша жақсы деректер алдыңыз ба?
Dialogue: 0,0:05:59.84,0:06:04.02,Default,,0,0,0,,Деректердің және барлығының соншалықты тамаша қойылғанын қалаймын.
Dialogue: 0,0:06:04.02,0:06:08.64,Default,,0,0,0,,Жарайды, Казуя мені мақтады.
Dialogue: 0,0:06:08.64,0:06:10.85,Default,,0,0,0,,《Тездетіңдер, балалар.
Dialogue: 0,0:06:10.85,0:06:15.33,Default,,0,0,0,,Мен ертең төбелесетін адаммен сөйлескім келмейді.
Dialogue: 0,0:06:15.33,0:06:17.69,Default,,0,0,0,,Айтпақшы, осы мүмкіндіктердің барлығына ие болу да → болып табылады
Dialogue: 0,0:06:17.69,0:06:19.66,Default,,0,0,0,,Содан бері?
Dialogue: 0,0:06:19.66,0:06:21.96,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:06:25.34,0:06:30.03,Default,,0,0,0,,((Ей, сізде керемет жүздер бар.
Dialogue: 0,0:06:30.03,0:06:32.49,Default,,0,0,0,,Джонан аға Карлос.
Dialogue: 0,0:06:32.49,0:06:35.00,Default,,0,0,0,,Маругаме ағасының Ширакавасы.
Dialogue: 0,0:06:35.00,0:06:38.51,Default,,0,0,0,,Такахираның ағасы Ямаока мен Ябе.
Dialogue: 0,0:06:38.51,0:06:43.68,Default,,0,0,0,,Сіз бұл жігіттердің барлығын жинадыңыз ба? Дыбыс.
Dialogue: 0,0:06:43.68,0:06:46.47,Default,,0,0,0,,Болды, сонда Казуя бар.
Dialogue: 0,0:06:46.47,0:06:50.67,Default,,0,0,0,,Келсеңіз, мен өзімнің идеалды командамды құра аламын.
Dialogue: 0,0:06:50.67,0:06:52.69,Default,,0,0,0,,Хаха.
Dialogue: 0,0:06:52.69,0:06:55.56,Default,,0,0,0,,Мен кез келген басқа ұстаушымен жақсы болар едім.
Dialogue: 0,0:06:55.56,0:06:58.01,Default,,0,0,0,,Наримия сен жақсысың дейді.
Dialogue: 0,0:06:58.01,0:07:01.03,Default,,0,0,0,,Казуя да Инамиден шақыру алды, солай ма?
Dialogue: 0,0:07:01.03,0:07:04.13,Default,,0,0,0,,Олай болса, ең күшті топты бірге құрайық.
Dialogue: 0,0:07:04.13,0:07:08.59,Default,,0,0,0,,Егер бізде осы мүшелер болса, ел чемпионатында жеңіске жетеміз деген арман ғана емес.
Dialogue: 0,0:07:08.59,0:07:12.68,Default,,0,0,0,,Инамиде дәлелденген тәжірибесі бар режиссер Кунитомо да бар →
Dialogue: 0,0:07:12.68,0:07:15.73,Default,,0,0,0,,Құрылыстар Токиодағы ең жақсысы.
Dialogue: 0,0:07:15.73,0:07:18.51,Default,,0,0,0,,Менің ойымша, орта ретінде шағымданатын ештеңе жоқ.
Dialogue: 0,0:07:18.51,0:07:22.19,Default,,0,0,0,,Ең бастысы, мен Наримияны жау етудің қажеті жоқ.
Dialogue: 0,0:07:22.19,0:07:27.69,Default,,0,0,0,,Әрине, сіз бұған кірісесіз, солай ма? Казуя Миюки...
Dialogue: 0,0:07:31.03,0:07:35.92,Default,,0,0,0,,Кешіріңіз, бірақ мені Сейдоға көптен бері шақырды.
Dialogue: 0,0:07:35.92,0:07:38.17,Default,,0,0,0,,Мен бұл оқиғаны сатып ала алмаймын.
Dialogue: 0,0:07:38.17,0:07:41.04,Default,,0,0,0,,Ха! ? Сен не айтып тұрсың?
Dialogue: 0,0:07:41.04,0:07:44.69,Default,,0,0,0,,Сейдо, иә?
Dialogue: 0,0:07:44.69,0:07:47.03,Default,,0,0,0,,Бұрынғы директор қызметінен кеткеннен бері →
Dialogue: 0,0:07:47.03,0:07:50.00,Default,,0,0,0,,Мен Кошиенде осы уақытқа дейін бір рет қана болдым.
Dialogue: 0,0:07:50.00,0:07:52.85,Default,,0,0,0,,Директор Кунитомоның тәжірибесімен салыстырғанда →
Dialogue: 0,0:07:52.85,0:07:57.32,Default,,0,0,0,,Менің ойымша, директор Катаока әлі тым жас.
Dialogue: 0,0:07:57.32,0:07:59.67,Default,,0,0,0,,Жоқ, менің айтқым келгені бұл емес.
Dialogue: 0,0:07:59.67,0:08:03.19,Default,,0,0,0,,Бұл керемет жүздері бар команда, солай емес пе?
Dialogue: 0,0:08:03.19,0:08:05.39,Default,,0,0,0,,Инаги Джицугё.
Dialogue: 0,0:08:05.39,0:08:08.69,Default,,0,0,0,,Егер солай болса, мен одан да көп ұрысқым келеді.
Dialogue: 0,0:08:12.85,0:08:15.14,Default,,0,0,0,,《Осылай.
Dialogue: 0,0:08:15.14,0:08:18.84,Default,,0,0,0,,Қарсыласын әлсіз командада жеңу→
Dialogue: 0,0:08:18.84,0:08:20.98,Default,,0,0,0,,Оның көздері үнемі жарқырап тұрады.
Dialogue: 0,0:08:20.98,0:08:25.35,Default,,0,0,0,,Маған бұл бөлім ұнады...》
Dialogue: 0,0:08:25.35,0:08:27.40,Default,,0,0,0,,Казуя.
Dialogue: 0,0:08:27.40,0:08:29.89,Default,,0,0,0,,Соңында тағы бір рет сұрайын...
Dialogue: 0,0:08:29.89,0:08:31.89,Default,,0,0,0,,Кешіріңіз, мүмкін емес.
Dialogue: 0,0:08:36.56,0:08:40.66,Default,,0,0,0,,《Наримия: Керемет. Бірақ өкінетінімді білмеймін
Dialogue: 0,0:08:44.18,0:08:47.60,Default,,0,0,0,,Соңында Инамидің шақыруынан бас тарттым→
Dialogue: 0,0:08:47.60,0:08:49.82,Default,,0,0,0,,Казуя жалғыз.
Dialogue: 0,0:08:49.82,0:08:54.08,Default,,0,0,0,,Бірақ сенсіз де биылғы команда ең мықты.
Dialogue: 0,0:08:54.08,0:08:57.88,Default,,0,0,0,,Мен Кошиеннен бас тарта алмаймын!
Dialogue: 0,0:09:04.32,0:09:08.24,Default,,0,0,0,,Менің үйіме келмегеніңізге өкінуіңіз керек.
Dialogue: 0,0:09:08.24,0:09:12.85,Default,,0,0,0,,10 жылдан кейін, 20 жылдан кейін, мәңгілік.
Dialogue: 0,0:09:12.85,0:09:15.68,Default,,0,0,0,,Олай болса матчқа барайық. аа.
Dialogue: 0,0:09:15.68,0:09:17.80,Default,,0,0,0,,Аа, мен өзімді сергек сезіндім. Хмм!
Dialogue: 0,0:09:17.80,0:09:21.82,Default,,0,0,0,,Сен сол ақ жігіттермен не туралы сөйлестің?
Dialogue: 0,0:09:21.82,0:09:23.86,Default,,0,0,0,,Шын мәнінде емес.
Dialogue: 0,0:09:23.86,0:09:29.38,Default,,0,0,0,,Шынымен де емес! Бұл сіз ертең күресетін қарсылас!
Dialogue: 0,0:09:29.38,0:09:32.38,Default,,0,0,0,,Фуруя-кун, бұл әлі сәйкес емес.
Dialogue: 0,0:09:34.35,0:09:38.24,Default,,0,0,0,,Автобусқа қайтайық. Барлығы күтіп отыр.
Dialogue: 0,0:09:38.24,0:09:40.36,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:40.36,0:09:43.06,Default,,0,0,0,,Жарайды, мүмкін емес! Менің ақпаратым сенің жауың! ?
Dialogue: 0,0:09:43.06,0:09:45.06,Default,,0,0,0,,Мен сені екеуіңді де жақсы көремін, сондықтан оны өзім бергім келеді.
Dialogue: 0,0:09:48.35,0:09:52.75,Default,,0,0,0,,Сіз не туралы айттыңыз? Ақ басымен. Сіз сондай табандысыз.
Dialogue: 0,0:09:52.75,0:09:54.82,Default,,0,0,0,,Наримияны кездестірдіңіз бе?
Dialogue: 0,0:09:54.82,0:09:57.17,Default,,0,0,0,,Бұл жігіт күдікті!
Dialogue: 0,0:09:57.17,0:10:00.34,Default,,0,0,0,,Сіз Инамиге бұл деректер туралы еркін айтып жатқан сияқтысыз!
Dialogue: 0,0:10:00.34,0:10:02.56,Default,,0,0,0,,Бұл сізден басқаша.
Dialogue: 0,0:10:02.56,0:10:06.56,Default,,0,0,0,,Сізді де Инами шақырған сияқты.
Dialogue: 0,0:10:08.99,0:10:11.19,Default,,0,0,0,,Ол тыңшы болған ғой!
Dialogue: 0,0:10:11.19,0:10:15.34,Default,,0,0,0,,Савамура: Шулы! Бірақ қазір Сейдоның үлкен ісі!
Dialogue: 0,0:10:15.34,0:10:17.83,Default,,0,0,0,,Сондықтан ренжітеді!
Dialogue: 0,0:10:17.83,0:10:21.63,Default,,0,0,0,,Ал, Крис-сенпай→
Dialogue: 0,0:10:21.63,0:10:24.02,Default,,0,0,0,,Рей-чан.
Dialogue: 0,0:10:24.02,0:10:27.57,Default,,0,0,0,,Егер мен бұл екеуін кездестірмегенде, мен арғы бетке түсіп қалуым мүмкін еді.
Dialogue: 0,0:10:27.57,0:10:29.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:34.46,0:10:38.51,Default,,0,0,0,,《Егер мен саған сол күні аулаушы ойнайтынымды айтпасам...
Dialogue: 0,0:10:38.51,0:10:40.72,Default,,0,0,0,,Осы екеуін көрмесем...
Dialogue: 0,0:10:40.72,0:10:46.52,Default,,0,0,0,,Ойланып қарасаңыз, бұл тағдыр болған шығар...》
Dialogue: 0,0:10:48.52,0:10:51.03,Default,,0,0,0,,((Ишикава: Араларыңда аулаушы ойнағысы келетін біреу бар ма?
Dialogue: 0,0:10:51.03,0:10:55.31,Default,,0,0,0,,Иә? Ұстаушы? (Эйджу) Мен жақсы құмырамын!
Dialogue: 0,0:10:55.31,0:10:58.15,Default,,0,0,0,,Егер сіз мұны істесеңіз ше? Ұстаушыға ұқсайды.
Dialogue: 0,0:10:58.15,0:11:03.26,Default,,0,0,0,,≪Жоқ, бұл қарапайым. Ұстаушының беті жасырылған.
Dialogue: 0,0:11:03.26,0:11:07.48,Default,,0,0,0,,Бастауыш сынып оқушылары мұны әлі түсінбей жүрсіз бе?
Dialogue: 0,0:11:07.48,0:11:11.70,Default,,0,0,0,,Тыңдаңдар, аулаушы жердегі басқару мұнарасы→
Dialogue: 0,0:11:11.70,0:11:14.70,Default,,0,0,0,,Бұл қорғаныстың кілті болатын маңызды позиция.
Dialogue: 0,0:11:14.70,0:11:17.00,Default,,0,0,0,,Иә, орындаймын!
Dialogue: 0,0:11:19.97,0:11:22.49,Default,,0,0,0,,Ұстаушы! ))
Dialogue: 0,0:11:22.49,0:11:25.01,Default,,0,0,0,,《Миюки: Қолғаптың пішіні басқаларға ұқсамайды.
Dialogue: 0,0:11:25.01,0:11:30.13,Default,,0,0,0,,Бір ғана адам барлық ойыншыларды көретіндей жерде отырады →
Dialogue: 0,0:11:30.13,0:11:34.22,Default,,0,0,0,,Мен ол жерде күшті тартымды сезіндім.
Dialogue: 0,0:11:34.22,0:11:38.52,Default,,0,0,0,,Бұл менің аулаушы ретіндегі алғашқы қадамым болды.
Dialogue: 0,0:12:46.84,0:12:48.86,Default,,0,0,0,,((Шығар!
Dialogue: 0,0:12:48.86,0:12:52.13,Default,,0,0,0,,Уау, бұл керемет. Ол әлі орта мектептің бірінші курсында, солай ма?
Dialogue: 0,0:12:52.13,0:12:55.18,Default,,0,0,0,,Қандай ұят!
Dialogue: 0,0:12:55.18,0:12:57.14,Default,,0,0,0,,2 шықты!
Dialogue: 0,0:12:57.14,0:13:01.17,Default,,0,0,0,,Мұнда бір керемет бала кірді.
Dialogue: 0,0:13:01.17,0:13:05.68,Default,,0,0,0,,Егер сізде бұл иықтар болса, сіз сәтті құмыра бола алмайсыз ба?
Dialogue: 0,0:13:05.68,0:13:08.85,Default,,0,0,0,,Бірақ ол тек ұстаушы ойнағысы келетінін айтты.
Dialogue: 0,0:13:08.85,0:13:12.95,Default,,0,0,0,,Солай ма? Біртүрлі бала екен...
Dialogue: 0,0:13:16.52,0:13:18.64,Default,,0,0,0,,А? О құдайым-ай!
Dialogue: 0,0:13:18.64,0:13:20.86,Default,,0,0,0,,Мұны тағы бір рет айтып көріңіз.
Dialogue: 0,0:13:20.86,0:13:23.73,Default,,0,0,0,,Сондықтан екінші қақпақ баяу →
Dialogue: 0,0:13:23.73,0:13:26.07,Default,,0,0,0,,Бұл құмыралардың тексеру алаңдарын лақтыруын қиындатады.
Dialogue: 0,0:13:26.07,0:13:28.07,Default,,0,0,0,,Сәлем Казуя….
Dialogue: 0,0:13:31.17,0:13:34.69,Default,,0,0,0,,Ей, бар болғаны бір жыл болды! !
Dialogue: 0,0:13:34.69,0:13:39.13,Default,,0,0,0,,Барлық ойыншылар алаңда тең.
Dialogue: 0,0:13:39.13,0:13:41.68,Default,,0,0,0,,Баға деңгейі маңызды емес.
Dialogue: 0,0:13:41.68,0:13:43.77,Default,,0,0,0,,Жоқ... Қарғыс атсын...
Dialogue: 0,0:13:43.77,0:13:45.65,Default,,0,0,0,,Хахаха.
Dialogue: 0,0:13:45.65,0:13:47.69,Default,,0,0,0,,Ақымақ болуды доғар, Казуя.
Dialogue: 0,0:13:47.69,0:13:51.34,Default,,0,0,0,,Мына бейбақ бізбен ұрыспақшы болып тұр ғой, солай ма?
Dialogue: 0,0:13:51.34,0:13:54.71,Default,,0,0,0,,Бір жылдың ішінде тұрақты орынға ие болдым деп алданып қалмаңыз.
Dialogue: 0,0:13:54.71,0:13:57.01,Default,,0,0,0,,Олай емес.
Dialogue: 0,0:13:57.01,0:13:59.48,Default,,0,0,0,,Мені мақтамаңыз!
Dialogue: 0,0:13:59.48,0:14:01.68,Default,,0,0,0,,Хахаха.
Dialogue: 0,0:14:01.68,0:14:04.59,Default,,0,0,0,,Сіз қалай сөйлеуді білмейтін сияқтысыз.
Dialogue: 0,0:14:04.59,0:14:07.39,Default,,0,0,0,,Әй, мен саған азғантай білім берейін.
Dialogue: 0,0:14:12.51,0:14:14.90,Default,,0,0,0,,Гяхахаха, шын айтасың ба?
Dialogue: 0,0:14:14.90,0:14:17.47,Default,,0,0,0,,Неге бізге де телефон соқпайсың?
Dialogue: 0,0:14:17.47,0:14:19.90,Default,,0,0,0,,Мен саған бүгін сабақ беретін шығармын.
Dialogue: 0,0:14:19.90,0:14:22.90,Default,,0,0,0,,Сіз күткендей, бүгін келмейсіз.
Dialogue: 0,0:14:28.86,0:14:31.68,Default,,0,0,0,,Шайна, кешігіп қалдың сенпай.
Dialogue: 0,0:14:31.68,0:14:33.70,Default,,0,0,0,,Мама, шын айтасыз ба?
Dialogue: 0,0:14:33.70,0:14:35.80,Default,,0,0,0,,Бейбақ….
Dialogue: 0,0:14:38.19,0:14:40.31,Default,,0,0,0,,《Миюки: бір жаста немесе одан кіші →
Dialogue: 0,0:14:40.31,0:14:44.26,Default,,0,0,0,,Мен бұл лауазымды өз бетімше алдым.
Dialogue: 0,0:14:44.26,0:14:47.18,Default,,0,0,0,,Құмыраға апаратын жол.
Dialogue: 0,0:14:47.18,0:14:50.67,Default,,0,0,0,,Ойыншылармен ойынды орнату.
Dialogue: 0,0:14:50.67,0:14:55.00,Default,,0,0,0,,Жергілікті жерде бақылау рөлі》
Dialogue: 0,0:14:55.00,0:14:57.01,Default,,0,0,0,,Екінші қақпақ баяу!
Dialogue: 0,0:14:57.01,0:15:00.44,Default,,0,0,0,,Бұл өте шулы! !
Dialogue: 0,0:15:00.44,0:15:05.70,Default,,0,0,0,,《Қызық, мен бұл қызықты жерді басқа біреуге бере аламын ба?》
Dialogue: 0,0:15:05.70,0:15:09.99,Default,,0,0,0,,Ертеңгі ойын Marugame Senior болады, солай ма?
Dialogue: 0,0:15:09.99,0:15:14.71,Default,,0,0,0,,Ол Канто турнирінің тұрақты қатысушысы. Қызық, матч не болып жатыр?
Dialogue: 0,0:15:14.71,0:15:18.14,Default,,0,0,0,,Ұрыс бастар алдында өзіңізді жұтып қоюға жол бермеңіз.
Dialogue: 0,0:15:18.14,0:15:20.70,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:15:20.70,0:15:23.85,Default,,0,0,0,,Мен өзімнің күшті тұстарымды қалай басуға болатынын ойлағанда→
Dialogue: 0,0:15:23.85,0:15:25.80,Default,,0,0,0,,Бұл қызықты.
Dialogue: 0,0:15:25.80,0:15:27.84,Default,,0,0,0,,Казуя-кун сенімді.
Dialogue: 0,0:15:27.84,0:15:29.84,Default,,0,0,0,,Өйткені Казуя байсалды.
Dialogue: 0,0:15:29.84,0:15:34.18,Default,,0,0,0,,Сізге әсер еткен кезде ме? Сен де Казуяның соңынан еру керек.
Dialogue: 0,0:15:34.18,0:15:36.66,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:15:36.66,0:15:40.35,Default,,0,0,0,,Сондықтан тырыспастан бұрын берілмеңіз. Мен үйге барып, әткеншекпен айналысамын.
Dialogue: 0,0:15:40.35,0:15:42.32,Default,,0,0,0,,Уау. Уау, жоқ! О! !
Dialogue: 0,0:15:42.32,0:15:44.32,Default,,0,0,0,,О! !
Dialogue: 0,0:15:50.68,0:15:52.68,Default,,0,0,0,,Мен үйдемін.
Dialogue: 0,0:15:52.68,0:15:55.35,Default,,0,0,0,,Току-сан, жеткізу күні ертең.→
Dialogue: 0,0:15:55.35,0:15:57.32,Default,,0,0,0,,Сіз мұны істей аласыз ба?
Dialogue: 0,0:15:57.32,0:15:59.32,Default,,0,0,0,,Менің мұны істеуден басқа амалым жоқ па?
Dialogue: 0,0:16:26.68,0:16:30.60,Default,,0,0,0,,Мен сіздің бұрынғы кәсіпқой бейсболшы ұлыңыз бар екенін естідім...
Dialogue: 0,0:16:30.60,0:16:33.70,Default,,0,0,0,,Мен оны қалай жеңуім керек?
Dialogue: 0,0:16:38.24,0:16:41.54,Default,,0,0,0,,О, дәмді! Мен данышпанмын! !
Dialogue: 0,0:16:47.93,0:16:53.23,Default,,0,0,0,,Жануар, солай ма? Бұл. Иә, бұл комедияның жануары.
Dialogue: 0,0:16:55.17,0:16:58.68,Default,,0,0,0,,《Бұл 4 саны ұстағыш...》
Dialogue: 0,0:16:58.68,0:17:01.18,Default,,0,0,0,,Керемет доп.
Dialogue: 0,0:17:01.18,0:17:05.13,Default,,0,0,0,,《Такигава Крис Ю》
Dialogue: 0,0:17:05.13,0:17:09.41,Default,,0,0,0,,Әй, мынау Жануар мырзаның баласы ма?
Dialogue: 0,0:17:09.41,0:17:12.91,Default,,0,0,0,,Әкеден қалған үлкен денелі.
Dialogue: 0,0:17:17.53,0:17:22.85,Default,,0,0,0,,[Сыпайылық: Оның әкесі бұрынғы кәсіби бейсбол ойыншысы және оның болашағы зор.
Dialogue: 0,0:17:22.85,0:17:26.45,Default,,0,0,0,,Сенің менің үйіме келгеніңді қалаймын》
Dialogue: 0,0:17:34.55,0:17:37.85,Default,,0,0,0,,Ширакава Жүгірушілерге қамқорлық жасайық.
Dialogue: 0,0:17:43.59,0:17:45.51,Default,,0,0,0,,Польнареффтің қылышынан да жылдам болды. Құдай-ай!》
Dialogue: 0,0:17:45.51,0:17:48.14,Default,,0,0,0,,《Екінші қадам да курста.
Dialogue: 0,0:17:48.14,0:17:50.85,Default,,0,0,0,,Олай болса, келесісі дұрыс емес шығар...》
Dialogue: 0,0:17:50.85,0:17:56.19,Default,,0,0,0,,≪Лалагүл. ≪Мен жүгірдім!
Dialogue: 0,0:17:56.19,0:17:58.24,Default,,0,0,0,,Бұл тек менің қиялым ғана болды.
Dialogue: 0,0:17:58.24,0:18:00.24,Default,,0,0,0,,Мен оның солай болатынына көз жеткіземін.
Dialogue: 0,0:18:07.23,0:18:10.03,Default,,0,0,0,,《Бұл күшті шабуыл.
Dialogue: 0,0:18:10.03,0:18:12.18,Default,,0,0,0,,Оның үстіне иығы да мықты》
Dialogue: 0,0:18:12.18,0:18:14.17,Default,,0,0,0,,2 сыртқа Қойайық!
Dialogue: 0,0:18:14.17,0:18:18.47,Default,,0,0,0,,《Казуя Миюки...》
Dialogue: 0,0:18:21.56,0:18:24.86,Default,,0,0,0,,《Келесі міндетті түрде сыртқы түзу》
Dialogue: 0,0:18:30.57,0:18:32.60,Default,,0,0,0,,《Кел! 》
Dialogue: 0,0:18:32.60,0:18:36.19,Default,,0,0,0,,Жоқ... Мұнда баяу қисық! ?
Dialogue: 0,0:18:36.19,0:18:39.19,Default,,0,0,0,,≪ Қамырды тастаңыз!
Dialogue: 0,0:18:43.48,0:18:47.08,Default,,0,0,0,,Күтілгендей, ол өз шегін сыртқа қарай итермеледі.
Dialogue: 0,0:18:56.60,0:18:58.60,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:19:02.48,0:19:07.78,Default,,0,0,0,,《Міне, бейсбол тек сіздің денеңізге қатысты емес.》
Dialogue: 0,0:19:17.35,0:19:21.49,Default,,0,0,0,,О. Бұл үйге жүгіру!
Dialogue: 0,0:19:21.49,0:19:25.56,Default,,0,0,0,,《Заңсыздықтың добын ана жаққа әкел! ? 》
Dialogue: 0,0:19:25.56,0:19:27.56,Default,,0,0,0,,Жақсы, Ю!
Dialogue: 0,0:19:30.48,0:19:33.85,Default,,0,0,0,,《Бәле... Әлі жоқ! 》
Dialogue: 0,0:19:33.85,0:19:46.73,Default,,0,0,0,,♪♪~
Dialogue: 0,0:19:46.73,0:19:49.23,Default,,0,0,0,,《Ант берді》
Dialogue: 0,0:19:51.87,0:19:55.89,Default,,0,0,0,,Сіз бұл ұстаушыны ұстауды жоспарлап отырсыз ба?
Dialogue: 0,0:19:55.89,0:19:57.89,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:20:08.87,0:20:11.27,Default,,0,0,0,,≪Ол ұсталды!
Dialogue: 0,0:20:11.27,0:20:14.84,Default,,0,0,0,,≪Дәл қоршаудың шетінде мен ойланбастан кіріп кеттім.
Dialogue: 0,0:20:14.84,0:20:17.14,Default,,0,0,0,,≪Жараланып қалудан қорықпайсыз ба? ?
Dialogue: 0,0:20:20.50,0:20:23.50,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:20:31.84,0:20:35.88,Default,,0,0,0,,《Күшті қорғасын және соққыларды оқитын соққы...
Dialogue: 0,0:20:35.88,0:20:38.48,Default,,0,0,0,,Ол қызық жігіт》
Dialogue: 0,0:20:42.52,0:20:45.14,Default,,0,0,0,,Күтілгендей, Маругам сеньор мықты.
Dialogue: 0,0:20:45.14,0:20:48.16,Default,,0,0,0,,Мен сенің қарсыласың емеспін.
Dialogue: 0,0:20:48.16,0:20:52.39,Default,,0,0,0,,≪Ол жақтағы ұстаушы мені қатты ұрды.
Dialogue: 0,0:20:52.39,0:20:55.19,Default,,0,0,0,,≪Бұл, әрине, құбыжық.
Dialogue: 0,0:20:59.50,0:21:03.19,Default,,0,0,0,,《Оның соққысы құмыраның жүрегін жаралауға жеткілікті болды.
Dialogue: 0,0:21:03.19,0:21:05.84,Default,,0,0,0,,Құмыраны пайдаланатын қорғасын.
Dialogue: 0,0:21:05.84,0:21:09.36,Default,,0,0,0,,Ойын барысын қате оқымайтын иіс сезу.
Dialogue: 0,0:21:09.36,0:21:14.13,Default,,0,0,0,,Бұл әлемде қаншама ғажайып адамдар бар.
Dialogue: 0,0:21:14.13,0:21:16.84,Default,,0,0,0,,Кухахаха….
Dialogue: 0,0:21:16.84,0:21:20.02,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:21:20.02,0:21:22.67,Default,,0,0,0,,《Миюки: Мен бүгін бәрін жоғалттым!
Dialogue: 0,0:21:22.67,0:21:27.18,Default,,0,0,0,,Бұл не, Крис? Шетелдік көмекшінің баласы ма?
Dialogue: 0,0:21:27.18,0:21:30.18,Default,,0,0,0,,Кочитора Мен қала орталығында өскен Эдо баласымын!
Dialogue: 0,0:21:30.18,0:21:34.00,Default,,0,0,0,,Ең алдымен бүгінгі жеңіліске ризамын.
Dialogue: 0,0:21:34.00,0:21:36.67,Default,,0,0,0,,Осы арқылы мен жақсы бола аламын.
Dialogue: 0,0:21:36.67,0:21:39.56,Default,,0,0,0,,Сіз күшті бола аласыз!
Dialogue: 0,0:21:39.56,0:21:43.16,Default,,0,0,0,,Бейсбол қызық болғанша, маған бәрібір! 》
Dialogue: 0,0:21:45.85,0:21:49.77,Default,,0,0,0,,Бір-бірінің сырын оқитын аулаушылардың ойыны.
Dialogue: 0,0:21:49.77,0:21:53.02,Default,,0,0,0,,Мен ересектер арасындағы матч мұндай жоғары сапалы болады деп ешқашан күтпеген едім→
Dialogue: 0,0:21:53.02,0:21:55.39,Default,,0,0,0,,Мен оны көремін деп ойламадым.
Dialogue: 0,0:21:55.39,0:21:57.98,Default,,0,0,0,,Бүгінгі матчтың нәтижесі → болды
Dialogue: 0,0:21:57.98,0:21:59.98,Default,,0,0,0,,Бұл, әрине, әріптестер арасындағы айырмашылық.
Dialogue: 0,0:22:03.63,0:22:07.14,Default,,0,0,0,,Жоғары талпыныс және жақсартуға деген ұмтылыс.
Dialogue: 0,0:22:07.14,0:22:11.01,Default,,0,0,0,,Сіз осы ойыншылардың барлығын біріктіргіңіз келді ме?
Dialogue: 0,0:22:11.01,0:22:15.14,Default,,0,0,0,,Бейсболды жоғары деңгейде ойнау керек.
Dialogue: 0,0:22:15.14,0:22:19.18,Default,,0,0,0,,《Түсіндім, бұл да қызық...》
Dialogue: 0,0:22:19.18,0:22:21.87,Default,,0,0,0,,Сіздің әпкеңіз кім?
Dialogue: 0,0:22:21.87,0:22:27.32,Default,,0,0,0,,Мен Рей Такашимамын, Сейдо орта мектебінің бейсбол клубының вице-президенті!
Dialogue: 0,0:22:27.32,0:22:33.41,Default,,0,0,0,,Қарапайым тілмен айтқанда, мен сізді барлау үшін шақырдым.
Dialogue: 0,0:22:33.41,0:22:36.48,Default,,0,0,0,,《Шынында мен Кристі көруге келдім, бірақ...》
Dialogue: 0,0:22:36.48,0:22:40.72,Default,,0,0,0,,Сәлем, скаут!
Dialogue: 0,0:22:40.72,0:22:44.52,Default,,0,0,0,,Бұл тым жылдам емес пе? Мен бар болғаны бір жастамын.
Dialogue: 0,0:22:46.48,0:22:48.88,Default,,0,0,0,,Е! Сіз тек бірінші курс студенті едіңіз! ?
Dialogue: 0,0:22:48.88,0:22:51.40,Default,,0,0,0,,Мен сені қысқа деп ойладым!
Dialogue: 0,0:22:51.40,0:22:53.90,Default,,0,0,0,,Міне, осыншама!
Dialogue: 0,0:22:53.90,0:22:56.70,Default,,0,0,0,,Әпке, сіз шынымен барлаушысыз ба? ))
Dialogue: 0,0:23:00.37,0:23:03.39,Default,,0,0,0,,《Жаздың сол күні кездескенімізге төрт жыл өтті.
Dialogue: 0,0:23:03.39,0:23:09.85,Default,,0,0,0,,Мүмкін мен қазір осында боламын деп сол күннен бастап шешкен шығар.
Dialogue: 0,0:23:09.85,0:23:17.67,Default,,0,0,0,,Және де осы адамдарға қарсы күресу.
Dialogue: 0,0:23:17.67,0:23:19.97,Default,,0,0,0,,Мен сенімдімін...》
Dialogue: 0,0:23:24.18,0:23:28.17,Default,,0,0,0,,Ал, финалға шығуыңмен құттықтаймыз!
Dialogue: 0,0:23:28.17,0:23:30.52,Default,,0,0,0,,Хаа… Хаа… Хаа….
Dialogue: 0,0:23:30.52,0:23:35.06,Default,,0,0,0,,Әзірге жақсы. Мәселе осыдан кейін келеді.
Dialogue: 0,0:23:35.06,0:23:37.56,Default,,0,0,0,,Сіз тағы бір нәрсені ұтып аламын деп ойлайсыз ба?
Dialogue: 0,0:23:39.86,0:23:41.88,Default,,0,0,0,,Оны дәл айтудың қажеті жоқ...
Dialogue: 0,0:23:41.88,0:23:44.18,Default,,0,0,0,,Шынымды айтсам, қарсыласым мықты.
Dialogue: 0,0:23:51.19,0:23:54.08,Default,,0,0,0,,Наримия былтыр да біркелкі болмады→
Dialogue: 0,0:23:54.08,0:23:58.66,Default,,0,0,0,,Соңғы бір жылда мен керемет тұрақтылық сезіміне ие болдым.
Dialogue: 0,0:23:58.66,0:24:01.88,Default,,0,0,0,,Бұл тесік жоқ дегенді білдіре ме...?
Dialogue: 0,0:24:01.88,0:24:03.88,Default,,0,0,0,,(Үлдеген дыбыс)
Dialogue: 0,0:24:15.15,0:24:18.67,Default,,0,0,0,,Ойын енді ғана аяқталса да...
Dialogue: 0,0:24:18.67,0:24:21.30,Default,,0,0,0,,Олар шынымен де ынталы балалар.
Dialogue: 0,0:24:21.30,0:24:24.24,Default,,0,0,0,,Оны тоқтатқан дұрыс емес пе?
Dialogue: 0,0:24:24.24,0:24:28.34,Default,,0,0,0,,Мен матчты күте алмаймын.
Dialogue: 0,0:24:35.37,0:24:40.89,Default,,0,0,0,,Өсіп келе жатқан екінші жағы ғана емес.
Dialogue: 0,0:24:40.89,0:24:45.49,Default,,0,0,0,,(Үлдеген дыбыс)
Dialogue: 0,0:24:46.99,0:24:52.99,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory