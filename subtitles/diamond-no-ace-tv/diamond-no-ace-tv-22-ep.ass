Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:33.54,0:00:35.56,Default,,0,0,0,,Біз кімбіз! Чемпион Сейдо!
Dialogue: 0,0:00:35.56,0:00:37.56,Default,,0,0,0,,Кім басқалардан артық тер төкті? Сейдо!
Dialogue: 0,0:00:37.56,0:00:40.04,Default,,0,0,0,,Кім көбірек көз жасын төкті? Сейдо!
Dialogue: 0,0:00:40.04,0:00:43.40,Default,,0,0,0,,Сіз күресуге дайынсыз ба! ? О!
Dialogue: 0,0:00:43.40,0:00:46.07,Default,,0,0,0,,Мектебіміздің мақтаныштарын ескере отырып, бізде бір ғана мақсат бар!
Dialogue: 0,0:00:46.07,0:00:49.07,Default,,0,0,0,,Тек ұлттық үстемдік үшін! Барайық! !
Dialogue: 0,0:00:49.07,0:00:52.57,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:03:36.55,0:03:45.53,Default,,0,0,0,,♪♪~
Dialogue: 0,0:03:45.53,0:03:50.13,Default,,0,0,0,,Кеттік! О!
Dialogue: 0,0:03:50.13,0:03:54.07,Default,,0,0,0,,[Спикер] Батыс Токио турнирінің 2-ші кезеңі басталады →
Dialogue: 0,0:03:54.07,0:04:00.69,Default,,0,0,0,,Сейдо орта мектебі мен Йонемон Ниши орта мектебі арасындағы матч басталады.
Dialogue: 0,0:04:00.69,0:04:03.25,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:04:03.25,0:04:07.20,Default,,0,0,0,,Сайдоның жазы басталады.
Dialogue: 0,0:04:07.20,0:04:09.20,Default,,0,0,0,,Маңызды бірінші сәйкестік→
Dialogue: 0,0:04:09.20,0:04:12.21,Default,,0,0,0,,Әркім осылай қыңыр болып кетпесе жақсы болар еді...
Dialogue: 0,0:04:12.21,0:04:14.78,Default,,0,0,0,,Қиын болып бара жатқан сенсің.
Dialogue: 0,0:04:14.78,0:04:18.58,Default,,0,0,0,,Уайымдама, бәрі жақсы болады.
Dialogue: 0,0:04:20.56,0:04:27.40,Default,,0,0,0,,♪♪~
Dialogue: 0,0:04:27.40,0:04:30.57,Default,,0,0,0,,Эй, эй, бірыңғай нөмір 10...
Dialogue: 0,0:04:30.57,0:04:32.93,Default,,0,0,0,,Бұл сол жақтағы эйс емес пе?
Dialogue: 0,0:04:32.93,0:04:37.73,Default,,0,0,0,,Ал лақтыру ...
Dialogue: 0,0:04:37.73,0:04:42.74,Default,,0,0,0,,Бірыңғай киім нөмірі 10 Мамору Минамихира 3 курс студенті.
Dialogue: 0,0:04:42.74,0:04:47.22,Default,,0,0,0,,Бірінші курста мен құмыра ретінде ойындарға қатыстым.→
Dialogue: 0,0:04:47.22,0:04:51.38,Default,,0,0,0,,Содан бері ол құмыра ретінде ешқандай ресми ойындарға қатысқан жоқ.
Dialogue: 0,0:04:51.38,0:04:56.25,Default,,0,0,0,,Мен олай ойламаймын, тек осы жаз үшін→
Dialogue: 0,0:04:56.25,0:04:59.12,Default,,0,0,0,,Асты лақтыруды меңгеру үшін екі жыл қажет болды→
Dialogue: 0,0:04:59.12,0:05:01.24,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:05:01.24,0:05:07.88,Default,,0,0,0,,♪♪~
Dialogue: 0,0:05:07.88,0:05:11.58,Default,,0,0,0,,Ой-ау!
Dialogue: 0,0:05:11.58,0:05:13.53,Default,,0,0,0,,Курамочи соқты!
Dialogue: 0,0:05:13.53,0:05:16.07,Default,,0,0,0,,Оны аяқтарыңызбен араластырыңыз!
Dialogue: 0,0:05:16.07,0:05:19.41,Default,,0,0,0,,《Енді не істеуім керек...
Dialogue: 0,0:05:19.41,0:05:23.81,Default,,0,0,0,,Бірінші ұрып-соғушының міндеті - алдымен негізге тұру.
Dialogue: 0,0:05:23.81,0:05:28.07,Default,,0,0,0,,Бірақ бізде мәлімет жоқ құмыра добы →
Dialogue: 0,0:05:28.07,0:05:30.57,Default,,0,0,0,,Мен кенеттен жарғанатқа барсам да...》
Dialogue: 0,0:05:34.57,0:05:36.52,Default,,0,0,0,,Польнареффтің қылышынан да жылдам болды. Құдай-ай!》
Dialogue: 0,0:05:36.52,0:05:38.91,Default,,0,0,0,,《Тым кеш!
Dialogue: 0,0:05:38.91,0:05:42.40,Default,,0,0,0,,Жоғары ағын пішінінен төмен.
Dialogue: 0,0:05:42.40,0:05:45.57,Default,,0,0,0,,Бір көтеріліп, кейін батып кететін орбита ма?
Dialogue: 0,0:05:45.57,0:05:50.57,Default,,0,0,0,,Жылдамдықтың болмауы допты одан сайын қиындатады...》
Dialogue: 0,0:05:50.57,0:05:54.06,Default,,0,0,0,,Хахахаха... Мына жүзді көрдің бе?
Dialogue: 0,0:05:54.06,0:05:57.60,Default,,0,0,0,,Көк жол жігіттері, бұл жағдайда деректер жоқ→
Dialogue: 0,0:05:57.60,0:05:59.60,Default,,0,0,0,,Менің көзім ақ пен қара.
Dialogue: 0,0:06:06.25,0:06:08.27,Default,,0,0,0,,《Қандай формада болса да→
Dialogue: 0,0:06:08.27,0:06:10.57,Default,,0,0,0,,Алдымен бастаманы қолға алыңыз.
Dialogue: 0,0:06:10.57,0:06:13.69,Default,,0,0,0,,Бірінші матчта қатты қарсылас командаға қарсы→
Dialogue: 0,0:06:13.69,0:06:17.97,Default,,0,0,0,,Кішкене болса да бұзылу болса, ол өшіріледі.
Dialogue: 0,0:06:17.97,0:06:21.47,Default,,0,0,0,,《Төмен! Бірақ курс әрең бар》
Dialogue: 0,0:06:24.19,0:06:26.19,Default,,0,0,0,,Қызыл Айдаһарларды таңдаймын.
Dialogue: 0,0:06:26.19,0:06:28.91,Default,,0,0,0,,Эй, олай емес сияқты, Курамочи!
Dialogue: 0,0:06:28.91,0:06:31.53,Default,,0,0,0,,Белсендірек болыңыз!
Dialogue: 0,0:06:31.53,0:06:34.73,Default,,0,0,0,,《Жоқ, мен амалсыз бұрышқа тығылдым.
Dialogue: 0,0:06:34.73,0:06:38.59,Default,,0,0,0,,Енді сіз нашар бөліктерді жіберіп алмайсыз.
Dialogue: 0,0:06:38.59,0:06:42.44,Default,,0,0,0,,Барлығына оның қандай құмыра екенін айтыңыз →
Dialogue: 0,0:06:42.44,0:06:44.74,Default,,0,0,0,,Мен сізге айтуым керек.
Dialogue: 0,0:06:47.21,0:06:51.70,Default,,0,0,0,,《Tch! қисық? сырғытпа? 》
Dialogue: 0,0:06:51.70,0:06:53.70,Default,,0,0,0,,Қамыр дайын!
Dialogue: 0,0:06:53.70,0:06:57.07,Default,,0,0,0,,《Түсінуге тым кеш》
Dialogue: 0,0:06:57.07,0:06:59.06,Default,,0,0,0,,Мен оның солай болатынына көз жеткіземін.
Dialogue: 0,0:06:59.06,0:07:01.04,Default,,0,0,0,,Сіз кенеттен шығып кеттіңіз бе?
Dialogue: 0,0:07:01.04,0:07:03.24,Default,,0,0,0,,Бұл сіз ерекше түрде күткеніңіз үшін.
Dialogue: 0,0:07:03.24,0:07:07.73,Default,,0,0,0,,Тіпті бір соққылы допты да тыныш ұстауға болады.
Dialogue: 0,0:07:07.73,0:07:09.73,Default,,0,0,0,,Ах.
Dialogue: 0,0:07:09.73,0:07:13.39,Default,,0,0,0,,Бір ескерту! Бір ескертпе!
Dialogue: 0,0:07:13.39,0:07:18.71,Default,,0,0,0,,《Исашики: Бұл балалар жай ғана асығыс жасалған батареялар емес.》
Dialogue: 0,0:07:18.71,0:07:21.11,Default,,0,0,0,,...
Dialogue: 0,0:07:21.11,0:07:24.91,Default,,0,0,0,,Бұл қисық допты көру жеткілікті болды.
Dialogue: 0,0:07:27.52,0:07:30.39,Default,,0,0,0,,《Катаока: тек тәтті тағамдарға ұмтылыңыз》
Dialogue: 0,0:07:30.39,0:07:32.57,Default,,0,0,0,,Иә.
Dialogue: 0,0:07:32.57,0:07:35.58,Default,,0,0,0,,Ей, Фуруя, біз жай ғана аулап ойнаймыз.
Dialogue: 0,0:07:35.58,0:07:38.41,Default,,0,0,0,,О, мен де қалуым керек шығар?
Dialogue: 0,0:07:38.41,0:07:42.71,Default,,0,0,0,,Неліктен? Гррр... tsk!
Dialogue: 0,0:07:46.70,0:07:49.91,Default,,0,0,0,,《Миюки: Мен оны бетіме көрсетпеймін, сондықтан білмеймін.→
Dialogue: 0,0:07:49.91,0:07:56.08,Default,,0,0,0,,Бұл жігіт сабырлы ма, әлде қобалжыды ма?
Dialogue: 0,0:07:56.08,0:07:59.70,Default,,0,0,0,,Мүмкіндігінше сабырлы түрде қорғанға көтеріліңіз→
Dialogue: 0,0:07:59.70,0:08:02.90,Default,,0,0,0,,Мен бірінші нүктені алғым келеді.
Dialogue: 0,0:08:02.90,0:08:06.29,Default,,0,0,0,,Доп!
Dialogue: 0,0:08:06.29,0:08:10.06,Default,,0,0,0,,《Бұл жігіт төменге мүлде тиіспейді.
Dialogue: 0,0:08:10.06,0:08:14.95,Default,,0,0,0,,Әзірше мен сені сыртта мұқият қадағалаймын.
Dialogue: 0,0:08:14.95,0:08:18.70,Default,,0,0,0,,Идиот! Өте тәтті! 》
Dialogue: 0,0:08:18.70,0:08:22.59,Default,,0,0,0,,Ах, үшінші лайнер! Артымнан ерме!
Dialogue: 0,0:08:22.59,0:08:25.69,Default,,0,0,0,,《～ 》
Dialogue: 0,0:08:25.69,0:08:27.73,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:08:27.73,0:08:30.25,Default,,0,0,0,,Мен бірінші кезден оңай шығып кеткеніме сене алар емеспін.
Dialogue: 0,0:08:30.25,0:08:33.62,Default,,0,0,0,,...
Dialogue: 0,0:08:33.62,0:08:35.62,Default,,0,0,0,,Хэхехе….
Dialogue: 0,0:08:37.57,0:08:39.57,Default,,0,0,0,,Исашики! Сіз соқтыңыз.
Dialogue: 0,0:08:39.57,0:08:43.86,Default,,0,0,0,,Айқай, Сейдо Шпиц!
Dialogue: 0,0:08:43.86,0:08:46.91,Default,,0,0,0,,～
Dialogue: 0,0:08:46.91,0:08:48.88,Default,,0,0,0,,Ах.
Dialogue: 0,0:08:48.88,0:08:50.87,Default,,0,0,0,,Польнареффтің қылышынан да жылдам болды. Құдай-ай!》
Dialogue: 0,0:08:50.87,0:08:53.24,Default,,0,0,0,,...
Dialogue: 0,0:08:53.24,0:08:56.41,Default,,0,0,0,,…
Dialogue: 0,0:08:56.41,0:08:59.78,Default,,0,0,0,,Оң жақтан соққан доп →
Dialogue: 0,0:08:59.78,0:09:02.56,Default,,0,0,0,,Менің ойымша, бұл өте алыс сияқты.
Dialogue: 0,0:09:02.56,0:09:06.20,Default,,0,0,0,,Хмм.
Dialogue: 0,0:09:06.20,0:09:08.85,Default,,0,0,0,,Дараша~! !
Dialogue: 0,0:09:08.85,0:09:11.19,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:09:11.19,0:09:13.41,Default,,0,0,0,,Жүгір, жүгір, Исаски.
Dialogue: 0,0:09:13.41,0:09:15.58,Default,,0,0,0,,(Каори) Жоқ, бірақ... (Косей) Ақыл-жастарың ұқсас болғандықтан ба?
Dialogue: 0,0:09:15.58,0:09:17.69,Default,,0,0,0,,Үшеуінің де жеңілгеніне сене алмадым! ?
Dialogue: 0,0:09:17.69,0:09:20.56,Default,,0,0,0,,Жарықтың сені соншалықты терең қорғайтынына сене алмаймын.
Dialogue: 0,0:09:20.56,0:09:25.04,Default,,0,0,0,,Қарсылас Сейдоны да біраз зерттеді.
Dialogue: 0,0:09:25.04,0:09:30.06,Default,,0,0,0,,《Қарғыс атсын, төбелес қой》
Dialogue: 0,0:09:30.06,0:09:33.06,Default,,0,0,0,,Фуруя кеттік. (Фуруя) Иә.
Dialogue: 0,0:09:35.91,0:09:38.27,Default,,0,0,0,,《Мен басқа адамды қорлаған жоқпын.
Dialogue: 0,0:09:38.27,0:09:43.19,Default,,0,0,0,,Керісінше, бұл әр адамның өз жұмысын жасауға тырысуының нәтижесі.
Dialogue: 0,0:09:43.19,0:09:47.57,Default,,0,0,0,,Бірақ мен бірінші ұпайды алғым келді.
Dialogue: 0,0:09:47.57,0:09:50.69,Default,,0,0,0,,Фуруя бастаушы, ал Каваками ұстап тұр.
Dialogue: 0,0:09:50.69,0:09:55.55,Default,,0,0,0,,Бұл қазіргі уақыттағы ең жақсы тапсырыс.
Dialogue: 0,0:09:55.55,0:09:59.47,Default,,0,0,0,,Енді Фуруяның бастамасы нашар болса →
Dialogue: 0,0:09:59.47,0:10:01.57,Default,,0,0,0,,Бұл жаман бастама болады.
Dialogue: 0,0:10:03.56,0:10:07.19,Default,,0,0,0,,Хахахаха, сақтығыңызды төмендетіңіз! Қауіпсіздікті төмендетіңіз!
Dialogue: 0,0:10:07.19,0:10:10.40,Default,,0,0,0,,Басыңызда, санаңызда білсеңіз де →
Dialogue: 0,0:10:10.40,0:10:12.90,Default,,0,0,0,,Бізді бағалама!
Dialogue: 0,0:10:12.90,0:10:17.91,Default,,0,0,0,,Бірақ әлсіздер үшін пайдалы мүмкіндік бар!
Dialogue: 0,0:10:17.91,0:10:22.71,Default,,0,0,0,,Оған дәлел ретінде қараңыз. Қарсыластың бастаушысы бір жаста.
Dialogue: 0,0:10:22.71,0:10:25.90,Default,,0,0,0,,Қаншалықты беделді болса да, бұл маңызды бірінші матч →
Dialogue: 0,0:10:25.90,0:10:30.57,Default,,0,0,0,,Бірінші курсты бастау керек пе? Хахахаха!
Dialogue: 0,0:10:30.57,0:10:34.09,Default,,0,0,0,,Сәлем Фуруя!
Dialogue: 0,0:10:34.09,0:10:37.61,Default,,0,0,0,,Соқса да мен дайынмын!
Dialogue: 0,0:10:37.61,0:10:41.11,Default,,0,0,0,,Сізді дереу ауыстырыңыз. Сенде шыдам жоқ, қалғанын өзім шешемін.
Dialogue: 0,0:10:44.21,0:10:47.51,Default,,0,0,0,,Хаха... Не, кәдімгідей.
Dialogue: 0,0:10:49.39,0:10:51.37,Default,,0,0,0,,Фуруя.
Dialogue: 0,0:10:51.37,0:10:56.59,Default,,0,0,0,,Мен бұл ойынды 9-шы иннингке дейін жасауды жоспарлап отырған жоқпын.
Dialogue: 0,0:10:56.59,0:10:58.69,Default,,0,0,0,,Сондай-ақ басынан өткізіп жіберуге болады.
Dialogue: 0,0:11:01.05,0:11:05.05,Default,,0,0,0,,Хехе Барлық соққылар, сіз соққыға ұмтыласыз ба?
Dialogue: 0,0:11:07.91,0:11:10.62,Default,,0,0,0,,Миюки-сенпай. иә?
Dialogue: 0,0:11:10.62,0:11:14.92,Default,,0,0,0,,Әу бастан-ақ осыны ойладым.
Dialogue: 0,0:11:21.74,0:11:24.92,Default,,0,0,0,,《Таку….
Dialogue: 0,0:11:24.92,0:11:29.53,Default,,0,0,0,,Бұл жігіт мүлде өзгерген жоқ...
Dialogue: 0,0:11:29.53,0:11:32.08,Default,,0,0,0,,Бұл құмыра бір жаста ғана.
Dialogue: 0,0:11:32.08,0:11:34.73,Default,,0,0,0,,Эйс Тамбаға не болды?
Dialogue: 0,0:11:34.73,0:11:38.15,Default,,0,0,0,,→
Dialogue: 0,0:11:38.15,0:11:40.15,Default,,0,0,0,,Кенеттен.
Dialogue: 0,0:11:46.28,0:11:50.20,Default,,0,0,0,,Хахахаха мен тіпті аулауды дұрыс ойнай алмаймын→
Dialogue: 0,0:11:50.20,0:11:54.20,Default,,0,0,0,,Сол бір жылы сіз қобалжыған және қатал болуыңыз керек.
Dialogue: 0,0:11:54.20,0:11:59.74,Default,,0,0,0,,《Егер соққы келмесе, ол өзін-өзі жоюы мүмкін.
Dialogue: 0,0:11:59.74,0:12:05.80,Default,,0,0,0,,Тыңда, тәтті шарлардан басқа ештеңені ұстама.
Dialogue: 0,0:12:05.80,0:12:13.47,Default,,0,0,0,,♪♪~
Dialogue: 0,0:12:13.47,0:12:15.87,Default,,0,0,0,,Ойна! Ша~!
Dialogue: 0,0:12:15.87,0:12:22.30,Default,,0,0,0,,《Базаға сондай жақынсың... Білмеймін бе?
Dialogue: 0,0:12:22.30,0:12:30.77,Default,,0,0,0,,Енді Фуруяның негізгі құрамы жақсы немесе жаман болады.
Dialogue: 0,0:12:30.77,0:12:45.57,Default,,0,0,0,,♪♪~
Dialogue: 0,0:14:33.53,0:14:37.56,Default,,0,0,0,,Ереуіл!
Dialogue: 0,0:14:37.56,0:14:40.47,Default,,0,0,0,,Уау, қандай доп!
Dialogue: 0,0:14:40.47,0:14:42.92,Default,,0,0,0,,Бұл бірінші жылы лақтырылған доп па? ?
Dialogue: 0,0:14:42.92,0:14:44.92,Default,,0,0,0,,Сіз неше километр жол жүрдіңіз?
Dialogue: 0,0:14:47.27,0:14:49.23,Default,,0,0,0,,Польнареффтің қылышынан да жылдам болды. Құдай-ай!》
Dialogue: 0,0:14:49.23,0:14:54.87,Default,,0,0,0,,Бақатаре Бұл қымбат доп! Неге онымен араласасың?
Dialogue: 0,0:14:54.87,0:15:00.12,Default,,0,0,0,,《Бұл не? Мен бұрын-соңды мұндай нәрсені машинада соққан емеспін.
Dialogue: 0,0:15:00.12,0:15:03.62,Default,,0,0,0,,Мен соққанда тұруға қорқамын》
Dialogue: 0,0:15:07.59,0:15:10.78,Default,,0,0,0,,Сол доп...
Dialogue: 0,0:15:10.78,0:15:12.78,Default,,0,0,0,,Онымен араласпа!
Dialogue: 0,0:15:14.95,0:15:17.55,Default,,0,0,0,,Бұл тек менің қиялым ғана болды.
Dialogue: 0,0:15:20.56,0:15:23.08,Default,,0,0,0,,Міне, келдік, үш соққы!
Dialogue: 0,0:15:23.08,0:15:26.20,Default,,0,0,0,,Ол бірінші рет бәрін берді.
Dialogue: 0,0:15:26.20,0:15:29.07,Default,,0,0,0,,Қараңдаршы, басқа команда қатып қалды!
Dialogue: 0,0:15:29.07,0:15:32.17,Default,,0,0,0,,Әдемі қадам. (Рйосуке) Жақсы жігіт.
Dialogue: 0,0:15:32.17,0:15:36.22,Default,,0,0,0,,Жарайды, Фуруя, доп болып қалды, хьяха!
Dialogue: 0,0:15:36.22,0:15:40.33,Default,,0,0,0,,《Ха! Бұл жігіт қобалжудан алыс →
Dialogue: 0,0:15:40.33,0:15:42.90,Default,,0,0,0,,Сіз әдеттегіден көбірек қызуыңыз керек.
Dialogue: 0,0:15:42.90,0:15:47.70,Default,,0,0,0,,Директордың айтқаны жұмыс істеп тұрған болуы мүмкін бе? 》
Dialogue: 0,0:15:47.70,0:15:52.64,Default,,0,0,0,,((Фуруя, Кавакамидің мағынасы →
Dialogue: 0,0:15:52.64,0:15:55.56,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:15:55.56,0:15:58.08,Default,,0,0,0,,Сіз бастағаныңыз үшін →
Dialogue: 0,0:15:58.08,0:16:01.55,Default,,0,0,0,,Командада барлығын алып жүрудің қажеті жоқ.
Dialogue: 0,0:16:01.55,0:16:05.24,Default,,0,0,0,,Қолыңыздан келгенін жасаңыз.
Dialogue: 0,0:16:05.24,0:16:08.27,Default,,0,0,0,,Сенімділікпен және сенімді түрде лақтыру.
Dialogue: 0,0:16:08.27,0:16:12.57,Default,,0,0,0,,Маңызды бірінші шайқасты маған сеніп тапсыруға күшіңіз жетеді))
Dialogue: 0,0:16:19.20,0:16:21.92,Default,,0,0,0,,Оған сіңіп кетпеңіз!
Dialogue: 0,0:16:21.92,0:16:25.36,Default,,0,0,0,,《Рухтың болғаны жақсы, дегенмен→
Dialogue: 0,0:16:25.36,0:16:27.94,Default,,0,0,0,,Доп тым биікте қалқып тұр.
Dialogue: 0,0:16:27.94,0:16:32.54,Default,,0,0,0,,Бүгін жұмыс істесе де, болашаққа алаңдаймын...》
Dialogue: 0,0:16:34.70,0:16:37.23,Default,,0,0,0,,Не... Бұл не?
Dialogue: 0,0:16:37.23,0:16:39.39,Default,,0,0,0,,Құбыжық?
Dialogue: 0,0:16:39.39,0:16:43.26,Default,,0,0,0,,Не істеп жатырсың! Тез қорғанысқа көшейік.
Dialogue: 0,0:16:43.26,0:16:45.56,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:45.56,0:16:50.48,Default,,0,0,0,,《Ойыңды ауыстыр.
Dialogue: 0,0:16:50.48,0:16:54.98,Default,,0,0,0,,Мүмкіндіктер міндетті түрде келеді, егер сіз шыдамдылық танытып, оларды қорғасаңыз...》
Dialogue: 0,0:17:02.56,0:17:06.45,Default,,0,0,0,,《Бәріне позитивті болыңыз》
Dialogue: 0,0:17:06.45,0:17:13.75,Default,,0,0,0,,♪♪«Адамның өз әлемі бар».
Dialogue: 0,0:17:13.75,0:17:19.89,Default,,0,0,0,,♪♪ «Аспанды кесіп өткен аққан жұлдыз»
Dialogue: 0,0:17:19.89,0:17:26.90,Default,,0,0,0,,Ұш, Юки, Юки, Юки!
Dialogue: 0,0:17:26.90,0:17:35.08,Default,,0,0,0,,♪♪
Dialogue: 0,0:17:35.08,0:17:39.58,Default,,0,0,0,,Қысқа аялдама екінші базаға жақындады.
Dialogue: 0,0:17:39.58,0:17:42.90,Default,,0,0,0,,Оңға қандай шектен ығысу.
Dialogue: 0,0:17:42.90,0:17:47.30,Default,,0,0,0,,Оң қолды соғушыларға қарсы ойын ойнауды жоспарлап отырсыз ба?
Dialogue: 0,0:17:47.30,0:17:50.54,Default,,0,0,0,,Егер бірдеңе болса, мен олар бәсекелестіктен аулақ жүргендей сезінемін.
Dialogue: 0,0:17:50.54,0:17:54.98,Default,,0,0,0,,Балалар, Юкидің жарғанаттағы кезегін жақсылап қараңдар.
Dialogue: 0,0:17:54.98,0:17:56.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:56.90,0:18:00.20,Default,,0,0,0,,Уф….
Dialogue: 0,0:18:07.57,0:18:10.56,Default,,0,0,0,,《Оны сасыған жерге лақтыр.
Dialogue: 0,0:18:10.56,0:18:14.16,Default,,0,0,0,,Бұл қамыр ең сорақысы, оның жүруіне қарсы емеспін.
Dialogue: 0,0:18:18.65,0:18:20.65,Default,,0,0,0,,Доп!
Dialogue: 0,0:18:23.29,0:18:27.29,Default,,0,0,0,,《Нанпей: Қарғыс атсын... Мен оны жібергім келмейді.》
Dialogue: 0,0:18:29.25,0:18:31.75,Default,,0,0,0,,《Жоқ, мен ішке кірдім...》
Dialogue: 0,0:18:38.07,0:18:40.57,Default,,0,0,0,,《Жаңа ғана жауап беріп жатсам да→
Dialogue: 0,0:18:40.57,0:18:44.19,Default,,0,0,0,,Доп тым жылдам тиіп тұр! 》
Dialogue: 0,0:18:44.19,0:18:46.41,Default,,0,0,0,,Сырттағы алаң да өтті!
Dialogue: 0,0:18:46.41,0:18:49.85,Default,,0,0,0,,Бұл дұрыс ауысым аралығына тиетін күшті соққы! !
Dialogue: 0,0:18:49.85,0:18:51.85,Default,,0,0,0,,Сәлем! Бірінші соққы! !
Dialogue: 0,0:18:51.85,0:18:53.89,Default,,0,0,0,,Керемет белгі Тецу!
Dialogue: 0,0:18:53.89,0:18:55.87,Default,,0,0,0,,Тецу-сан! !
Dialogue: 0,0:18:55.87,0:18:58.48,Default,,0,0,0,,Үлкен хиттердің қажеті жоқ.
Dialogue: 0,0:18:58.48,0:19:02.28,Default,,0,0,0,,Қарсыласыңыздың қорғанысын күшті, төмен доппен бұзыңыз.
Dialogue: 0,0:19:10.04,0:19:12.24,Default,,0,0,0,,Сәлем! Кезекті хит! !
Dialogue: 0,0:19:12.24,0:19:14.37,Default,,0,0,0,,Енді шығулар жоқ, бірінші және үшінші негіз.
Dialogue: 0,0:19:14.37,0:19:16.39,Default,,0,0,0,,Миюки!
Dialogue: 0,0:19:16.39,0:19:18.40,Default,,0,0,0,,Сен сұрадың, Миюки! !
Dialogue: 0,0:19:18.40,0:19:20.40,Default,,0,0,0,,Миюки!
Dialogue: 0,0:19:20.40,0:19:26.74,Default,,0,0,0,,♪♪
Dialogue: 0,0:19:26.74,0:19:30.89,Default,,0,0,0,,《Қарғыс атсын... Мен сені көбірек → айналайын деп ойладым
Dialogue: 0,0:19:30.89,0:19:34.08,Default,,0,0,0,,Бұл жігіттер сізді күтпеген жерден қосады.
Dialogue: 0,0:19:34.08,0:19:38.06,Default,,0,0,0,,Мүмкін қысылған да бар шығар.
Dialogue: 0,0:19:38.06,0:19:41.18,Default,,0,0,0,,Әзірге бірінші қадам - ​​қисық доп.
Dialogue: 0,0:19:41.18,0:19:45.74,Default,,0,0,0,,Қысу туралы алаңдамау үшін оны курсқа төмен түсіріңіз.
Dialogue: 0,0:19:45.74,0:19:51.71,Default,,0,0,0,,♪♪~
Dialogue: 0,0:19:51.71,0:19:54.25,Default,,0,0,0,,♪♪ «Оған мақсат қой»
Dialogue: 0,0:19:54.25,0:19:59.07,Default,,0,0,0,,♪♪~
Dialogue: 0,0:19:59.07,0:20:02.21,Default,,0,0,0,,《Не? Мен бірінші алаңнан соққы беруге келдім.
Dialogue: 0,0:20:02.21,0:20:04.71,Default,,0,0,0,,Доп сонша төмен ме? 》
Dialogue: 0,0:20:07.89,0:20:09.86,Default,,0,0,0,,Барлығы жақсы болады, иә?
Dialogue: 0,0:20:09.86,0:20:11.95,Default,,0,0,0,,Үшінші жүгіруші Ыңғайлы үй!
Dialogue: 0,0:20:11.95,0:20:15.55,Default,,0,0,0,,Бірінші табандағы жүгіруші де үлкен денесін шайқап, үшінші негізге көшеді.
Dialogue: 0,0:20:19.21,0:20:22.41,Default,,0,0,0,,Әй, алдын ала! ! Масуко-сенпай жақсы жүгіру!
Dialogue: 0,0:20:22.41,0:20:24.74,Default,,0,0,0,,Бұл Angry-дің үшінші қатарынан соққысы.
Dialogue: 0,0:20:24.74,0:20:28.58,Default,,0,0,0,,Миюки барлық дәмді тағамдарды әкелді.
Dialogue: 0,0:20:28.58,0:20:31.23,Default,,0,0,0,,Тек жүгірушілер болған кезде.
Dialogue: 0,0:20:31.23,0:20:34.65,Default,,0,0,0,,《Мына бейбақ мені көздеген...
Dialogue: 0,0:20:34.65,0:20:36.65,Default,,0,0,0,,Мен өткізіп алған доп...》
Dialogue: 0,0:20:38.58,0:20:40.98,Default,,0,0,0,,《Мына жігіттер не...?
Dialogue: 0,0:20:40.98,0:20:43.78,Default,,0,0,0,,Бұл қатты соққы беретін команда ма? 》
Dialogue: 0,0:20:48.45,0:20:50.45,Default,,0,0,0,,《Бірінші қадамды қысу! ? 》
Dialogue: 0,0:20:52.94,0:20:54.94,Default,,0,0,0,,Бірінші доп! !
Dialogue: 0,0:20:56.91,0:20:59.25,Default,,0,0,0,,Угара~! !
Dialogue: 0,0:20:59.25,0:21:01.40,Default,,0,0,0,,Әй, екінші нүкте!
Dialogue: 0,0:21:01.40,0:21:03.40,Default,,0,0,0,,Хакушу-сенпай жақсы бота! !
Dialogue: 0,0:21:03.40,0:21:06.57,Default,,0,0,0,,Жарайды, Масуко-сенпай, сен таңқаларлықтай жылдамсың.
Dialogue: 0,0:21:06.57,0:21:08.52,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:08.52,0:21:22.19,Default,,0,0,0,,♪♪~
Dialogue: 0,0:21:22.19,0:21:26.42,Default,,0,0,0,,Ғажайып, жүгірушілер бірінен соң бірі қайтып келеді.
Dialogue: 0,0:21:26.42,0:21:28.88,Default,,0,0,0,,Мен мұны да істей алмаймын! !
Dialogue: 0,0:21:28.88,0:21:32.08,Default,,0,0,0,,Көктем! Кел менімен ойнап аула! !
Dialogue: 0,0:21:32.08,0:21:34.41,Default,,0,0,0,,Не? Сіз бүгін ұсыныс жасайсыз ба?
Dialogue: 0,0:21:34.41,0:21:37.87,Default,,0,0,0,,Мен мұны түсінбеймін! !
Dialogue: 0,0:21:37.87,0:21:39.87,Default,,0,0,0,,Бірақ бүгін күн ыстық→
Dialogue: 0,0:21:39.87,0:21:43.54,Default,,0,0,0,,Фуруяның қашан шығатынын білмеймін.
Dialogue: 0,0:21:43.54,0:21:45.74,Default,,0,0,0,,По… Қалта….
Dialogue: 0,0:21:45.74,0:21:47.73,Default,,0,0,0,,Не болса да...
Dialogue: 0,0:21:47.73,0:21:50.73,Default,,0,0,0,,Дайын бол, ұрыспайсың.
Dialogue: 0,0:21:50.73,0:21:53.70,Default,,0,0,0,,Хехе.
Dialogue: 0,0:21:53.70,0:21:56.37,Default,,0,0,0,,《Бұл оң.
Dialogue: 0,0:21:56.37,0:22:01.39,Default,,0,0,0,,Мен де осындай көзқарасты үлгі етуім керек.
Dialogue: 0,0:22:01.39,0:22:23.89,Default,,0,0,0,,♪♪~
Dialogue: 0,0:22:28.87,0:22:31.92,Default,,0,0,0,,Бастапқыда сәл қатты болды →
Dialogue: 0,0:22:31.92,0:22:36.69,Default,,0,0,0,,Фуруяның питчингі мен Юкидің соққылары толығымен қарқын алды.
Dialogue: 0,0:22:36.69,0:22:41.20,Default,,0,0,0,,Қарсыластың соққысы да Фуруяның допына сәйкес келмеді →
Dialogue: 0,0:22:41.20,0:22:45.39,Default,,0,0,0,,Егер 5 иннингтен кейін алда 10 ұпай болса, ол шақырылады.
Dialogue: 0,0:22:45.39,0:22:48.54,Default,,0,0,0,,Фуруяда соңына дейін қалуға болмайды ма?
Dialogue: 0,0:22:48.54,0:22:51.89,Default,,0,0,0,,Жоқ. Тіпті қысқа иннинг болса да →
Dialogue: 0,0:22:51.89,0:22:55.96,Default,,0,0,0,,Осы жазда мен питтингті жалғастырамын. Кез келген уақытта бара алатындай етіп →
Dialogue: 0,0:22:55.96,0:22:59.53,Default,,0,0,0,,Кавакамиге айт. Ха, иә!
Dialogue: 0,0:22:59.53,0:23:02.60,Default,,0,0,0,,《Осы уақытқа дейін Фуруя сыбырлап жүр →
Dialogue: 0,0:23:02.60,0:23:06.41,Default,,0,0,0,,Жоғары доп. Егер сіз мұны анықтай алсаңыз→
Dialogue: 0,0:23:06.41,0:23:09.28,Default,,0,0,0,,Шарлар саны сәйкесінше артады.
Dialogue: 0,0:23:09.28,0:23:14.20,Default,,0,0,0,,Доптарды әрқашан машинамен 150 км-ге соғатын жоғарғы мектепте→
Dialogue: 0,0:23:14.20,0:23:16.62,Default,,0,0,0,,Бұл питчинг жұмыс істемейді→
Dialogue: 0,0:23:16.62,0:23:19.92,Default,,0,0,0,,Директор нақты біледі.
Dialogue: 0,0:23:22.72,0:23:26.03,Default,,0,0,0,,Хахахаха! Керемет формада! !
Dialogue: 0,0:23:26.03,0:23:30.96,Default,,0,0,0,,Мен төрт жылда бір рет қана жақсы сезінемін!
Dialogue: 0,0:23:30.96,0:23:34.08,Default,,0,0,0,,Олимпиада? Бұл жақсы емес ...
Dialogue: 0,0:23:34.08,0:23:36.25,Default,,0,0,0,,Вахахаха!
Dialogue: 0,0:23:36.25,0:23:40.22,Default,,0,0,0,,Мен әрқашан дайынмын! !
Dialogue: 0,0:23:40.22,0:23:42.74,Default,,0,0,0,,Вахахахаха!
Dialogue: 0,0:23:42.74,0:23:46.56,Default,,0,0,0,,Біраз уақыттан бері маған хабарласып жүрген бір адам бар...
Dialogue: 0,0:23:46.56,0:23:48.75,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:23:48.75,0:23:52.74,Default,,0,0,0,,Сәлем, Савамура! Сенің кезегің келмеген соң тентіреп жүрме!
Dialogue: 0,0:23:52.74,0:23:56.89,Default,,0,0,0,,Ұят! ! Асықшы! !
Dialogue: 0,0:23:56.89,0:24:00.41,Default,,0,0,0,,Өгізге сонша лақтырсаң, шаршайсың.
Dialogue: 0,0:24:00.41,0:24:05.45,Default,,0,0,0,,Жарайды! Мен де бірге күрескім келеді! !
Dialogue: 0,0:24:05.45,0:24:10.05,Default,,0,0,0,,《Бүгін доп әдеттегіден көбірек қозғалатын сияқты...》
Dialogue: 0,0:24:16.89,0:24:20.40,Default,,0,0,0,,((Мен сізге айта алатын нәрсе - →
Dialogue: 0,0:24:20.40,0:24:24.87,Default,,0,0,0,,Бұл соңғысы болатын сияқты. иә? ))
Dialogue: 0,0:24:24.87,0:24:29.24,Default,,0,0,0,,《Ол кезде мен оның мағынасын түсінбедім.→
Dialogue: 0,0:24:29.24,0:24:36.08,Default,,0,0,0,,Түсіндім... бұл үшінші курс студенттерінің соңғы сайысы.
Dialogue: 0,0:24:36.08,0:24:41.58,Default,,0,0,0,,Егер мен жеңілсем, сол кезде зейнетке шығуым керек...
Dialogue: 0,0:24:46.74,0:24:52.05,Default,,0,0,0,,Савамура! Директор шақырып жатыр!
Dialogue: 0,0:24:52.05,0:24:54.25,Default,,0,0,0,,《Не!?
Dialogue: 0,0:24:54.25,0:24:57.72,Default,,0,0,0,,Біреудің көңіл-күйі көтеріліп жатқанда! ! 》
Dialogue: 0,0:24:57.72,0:25:00.54,Default,,0,0,0,,Келесіде барайық, Савамура.
Dialogue: 0,0:25:00.54,0:25:04.24,Default,,0,0,0,,Не? Шынайы! ?
Dialogue: 0,0:25:04.24,0:25:07.59,Default,,0,0,0,,Дайынсың ба?
Dialogue: 0,0:25:07.59,0:25:12.28,Default,,0,0,0,,♪♪~
Dialogue: 0,0:25:12.28,0:25:14.58,Default,,0,0,0,,Иә! !
Dialogue: 0,0:25:16.08,0:25:22.08,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory