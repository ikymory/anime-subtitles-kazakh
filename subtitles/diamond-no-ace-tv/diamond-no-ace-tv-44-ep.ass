Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:28.36,0:00:33.38,Default,,0,0,0,,♪♪~
Dialogue: 0,0:00:33.38,0:00:35.83,Default,,0,0,0,,《Эйджун: Осы стендте бір жерде→
Dialogue: 0,0:00:35.83,0:00:38.20,Default,,0,0,0,,Мына балалар қарап тұр.
Dialogue: 0,0:00:38.20,0:00:42.61,Default,,0,0,0,,Тек ұсқынсыз сыртқы түрі→
Dialogue: 0,0:00:42.61,0:00:45.11,Default,,0,0,0,,Оны ешқашан көрсетпеңіз! 》
Dialogue: 0,0:00:50.76,0:00:53.32,Default,,0,0,0,,《Вакана: Темп өте жылдам.
Dialogue: 0,0:00:53.32,0:00:57.02,Default,,0,0,0,,Ал пішін сәл өзгерді ме? 》
Dialogue: 0,0:00:57.02,0:00:59.16,Default,,0,0,0,,≪Қауіпсіз!
Dialogue: 0,0:00:59.16,0:01:01.34,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:01:01.34,0:01:03.53,Default,,0,0,0,,[Майк] Екіншіге қарсы келетін соңғы жүгіріс.
Dialogue: 0,0:01:03.53,0:01:05.66,Default,,0,0,0,,[Майк] Сенсеннің шебер шабуылы →
Dialogue: 0,0:01:05.66,0:01:08.58,Default,,0,0,0,,Жаңа ғана ауыстырылған Савамураға шабуыл жасаңыз.
Dialogue: 0,0:01:08.58,0:01:11.10,Default,,0,0,0,,1-ші және 3-ші негізде шығыстар жоқ.
Dialogue: 0,0:01:11.10,0:01:13.65,Default,,0,0,0,,Савамура мырза.
Dialogue: 0,0:01:13.65,0:01:22.03,Default,,0,0,0,,♪♪~
Dialogue: 0,0:01:22.03,0:01:25.32,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:01:25.32,0:01:27.72,Default,,0,0,0,,≪Маки, бірінші қадамнан көзде!
Dialogue: 0,0:01:27.72,0:01:29.82,Default,,0,0,0,,≪Сіз соғуға болады!
Dialogue: 0,0:01:29.82,0:01:32.34,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:01:32.34,0:01:36.19,Default,,0,0,0,,《Маки: Мен оны қайтарамын...
Dialogue: 0,0:01:36.19,0:01:42.12,Default,,0,0,0,,Жоғалған ұпайларыңызды өзіңіз қалпына келтіріңіз》
Dialogue: 0,0:01:42.12,0:01:45.37,Default,,0,0,0,,《Миюки: Бұл жігіт қатты ашуланып кетті》
Dialogue: 0,0:01:45.37,0:01:47.87,Default,,0,0,0,,Бар күшіңмен лақтыр, Савамура!
Dialogue: 0,0:01:47.87,0:01:49.81,Default,,0,0,0,,Мен сені ұрайын!
Dialogue: 0,0:01:49.81,0:01:52.69,Default,,0,0,0,,Барыңды істе, Сакаэ-чан! Күте тұр!
Dialogue: 0,0:01:52.69,0:02:02.87,Default,,0,0,0,,♪♪~
Dialogue: 0,0:02:02.87,0:02:05.67,Default,,0,0,0,,Уау! !
Dialogue: 0,0:04:49.32,0:04:58.31,Default,,0,0,0,,♪♪~
Dialogue: 0,0:04:58.31,0:05:01.50,Default,,0,0,0,,Барыңды істе, Сакаэ-чан! Күте тұр!
Dialogue: 0,0:05:01.50,0:05:04.00,Default,,0,0,0,,《Эйджун…》
Dialogue: 0,0:05:07.37,0:05:09.72,Default,,0,0,0,,《Төменгі қатарда болса да, жарғанаттағы алдыңғы бұрылыс→
Dialogue: 0,0:05:09.72,0:05:12.24,Default,,0,0,0,,Бұл жігіт үлкен соққыға ұшырады.
Dialogue: 0,0:05:12.24,0:05:16.03,Default,,0,0,0,,Мен төменгі жағында толығымен шайқасамын.》
Dialogue: 0,0:05:16.03,0:05:24.84,Default,,0,0,0,,♪♪~
Dialogue: 0,0:05:24.84,0:05:27.34,Default,,0,0,0,,Уау! !
Dialogue: 0,0:05:38.92,0:05:41.52,Default,,0,0,0,,≪Фол!
Dialogue: 0,0:05:41.52,0:05:44.82,Default,,0,0,0,,《Жарқанаттың өзегін жылжыту арқылы алып тастау керек еді.
Dialogue: 0,0:05:44.82,0:05:48.06,Default,,0,0,0,,Мен оны сонда апарайын ба?
Dialogue: 0,0:05:48.06,0:05:51.16,Default,,0,0,0,,Өйткені, бұл жігіттің күші бар》
Dialogue: 0,0:05:54.85,0:05:57.02,Default,,0,0,0,,Савамура!
Dialogue: 0,0:05:57.02,0:06:00.66,Default,,0,0,0,,《Мен бұны енді ғана фолдан білдім.
Dialogue: 0,0:06:00.66,0:06:03.19,Default,,0,0,0,,Тәтті шарлар өлімге әкелуі мүмкін.》
Dialogue: 0,0:06:03.19,0:06:06.83,Default,,0,0,0,,Доп жүгіріп келеді. Қатты шабуыл жасаңыз!
Dialogue: 0,0:06:06.83,0:06:09.03,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:09.03,0:06:13.47,Default,,0,0,0,,《Бойы ұзын, қолы ұзын.
Dialogue: 0,0:06:13.47,0:06:17.97,Default,,0,0,0,,Қамырдың бұл түрінің әлсіз тұсы - ішкі тағам...
Dialogue: 0,0:06:19.88,0:06:22.41,Default,,0,0,0,,《Тағы бір доп, маған сыртқы допты көрсетші→
Dialogue: 0,0:06:22.41,0:06:24.41,Default,,0,0,0,,Соңында, инкурс! 》
Dialogue: 0,0:06:27.20,0:06:29.22,Default,,0,0,0,,≪Доп!
Dialogue: 0,0:06:29.22,0:06:33.52,Default,,0,0,0,,Ри... Сіз тым көп күш қолданасыз. Терең тыныс ал, терең дем ал!
Dialogue: 0,0:06:37.04,0:06:39.41,Default,,0,0,0,,《Крис: Мен мұны өз басымнан білсем де→
Dialogue: 0,0:06:39.41,0:06:43.35,Default,,0,0,0,,Бұл жағдайда өз күшіңізді жіберу мүмкін емес пе...?
Dialogue: 0,0:06:43.35,0:06:46.95,Default,,0,0,0,,Жақсы, менің қолым сермеп тұр. Келіңіз, шабуыл жасаңыз!
Dialogue: 0,0:06:48.99,0:06:53.99,Default,,0,0,0,,《Уақытты дұрыс анықтау қиын, бірақ доптың өзі жақсы көрінеді.
Dialogue: 0,0:06:53.99,0:06:57.86,Default,,0,0,0,,Жарғанатты тербеткенше...》
Dialogue: 0,0:06:57.86,0:07:02.35,Default,,0,0,0,,《Уқай: Дұрыс, Мәки, шоғырлан.
Dialogue: 0,0:07:02.35,0:07:05.95,Default,,0,0,0,,Әр доп үшін жүйкеңізді қайрайтыңыз.
Dialogue: 0,0:07:08.69,0:07:13.68,Default,,0,0,0,,《Укай: Хмф... Инаги Джицугё және үшінші қалалық орта мектеп.
Dialogue: 0,0:07:13.68,0:07:17.37,Default,,0,0,0,,Және Сейдо орта мектебі...
Dialogue: 0,0:07:17.37,0:07:24.07,Default,,0,0,0,,Осы үш команданың Батыс Токиода үздік үштікке енгеніне бірнеше жыл болды.
Dialogue: 0,0:07:24.07,0:07:28.07,Default,,0,0,0,,Мен қатты ренжідім, Маки...》
Dialogue: 0,0:07:31.36,0:07:33.98,Default,,0,0,0,,《Уқай: Бірдей жарысатындай күш →
Dialogue: 0,0:07:33.98,0:07:37.87,Default,,0,0,0,,Сізде қанша уақыт болса да →
Dialogue: 0,0:07:37.87,0:07:42.91,Default,,0,0,0,,Бұл үш команданың кешені бар.
Dialogue: 0,0:07:42.91,0:07:47.01,Default,,0,0,0,,Ең өкініштісі осы...》
Dialogue: 0,0:07:49.68,0:07:51.68,Default,,0,0,0,,≪Фол!
Dialogue: 0,0:07:53.82,0:07:55.86,Default,,0,0,0,,(жүрек тондары)
Dialogue: 0,0:07:55.86,0:08:24.66,Default,,0,0,0,,♪♪~
Dialogue: 0,0:08:27.00,0:08:29.99,Default,,0,0,0,,《Егер сіз соншалықты үлкен соқсаңыз →
Dialogue: 0,0:08:29.99,0:08:33.94,Default,,0,0,0,,Дәрігер кезінде жасаған үйге жүгірісі де оның басынан өтіп жатса керек.
Dialogue: 0,0:08:33.94,0:08:39.68,Default,,0,0,0,,Бірақ сізде әлі де осындай көздер болуы мүмкін бе?
Dialogue: 0,0:08:39.68,0:08:43.68,Default,,0,0,0,,Сен құмырасың ғой...》
Dialogue: 0,0:08:50.78,0:08:53.31,Default,,0,0,0,,Маки Питчер шошып кетті.
Dialogue: 0,0:08:53.31,0:08:55.36,Default,,0,0,0,,Сіз оны аяқтайсыз!
Dialogue: 0,0:08:55.36,0:08:59.04,Default,,0,0,0,,《Сенімді бол.
Dialogue: 0,0:08:59.04,0:09:02.37,Default,,0,0,0,,Маки Сіз мұны істей аласыз.
Dialogue: 0,0:09:02.37,0:09:07.67,Default,,0,0,0,,Үштіктің қабырғасын өз қолыммен қиратамын.
Dialogue: 0,0:09:11.70,0:09:16.59,Default,,0,0,0,,《Миюки: Білесің бе, егер тым қатты тырыссаң, оны жоғалтасың.
Dialogue: 0,0:09:16.59,0:09:20.42,Default,,0,0,0,,Оң жақ қамырдың төсінің астындағы төрт тігіс.
Dialogue: 0,0:09:20.42,0:09:23.72,Default,,0,0,0,,Ең жақсы допты осында лақтыр! 》
Dialogue: 0,0:09:26.85,0:09:30.65,Default,,0,0,0,,((Миюки: Сен осылай құлап, қорғаннан түсесің бе?
Dialogue: 0,0:09:30.65,0:09:35.35,Default,,0,0,0,,Әлде оны жеңіп, келесі жолы тағы қорғанды ала ма?
Dialogue: 0,0:09:35.35,0:09:39.65,Default,,0,0,0,,Дәл осы жерде сіздің құмыра ретіндегі сапаңыз тексеріледі))
Dialogue: 0,0:09:45.23,0:09:47.23,Default,,0,0,0,,《Мүлдем...》
Dialogue: 0,0:09:50.34,0:09:53.86,Default,,0,0,0,,《Оны ішке тастау》
Dialogue: 0,0:09:53.86,0:09:56.78,Default,,0,0,0,,Савамура Сезіміңізге берілмеңіз!
Dialogue: 0,0:09:56.78,0:09:58.86,Default,,0,0,0,,Барынша күресіңіз!
Dialogue: 0,0:09:58.86,0:10:03.92,Default,,0,0,0,,《Рахмет: Бұл шешуші фактор болады, Савамура-кун》
Dialogue: 0,0:10:03.92,0:10:07.34,Default,,0,0,0,,《Савамура-кун…》
Dialogue: 0,0:10:07.34,0:10:10.22,Default,,0,0,0,,Барыңыз~ Сакаэ-чан!
Dialogue: 0,0:10:10.22,0:10:28.06,Default,,0,0,0,,♪♪~
Dialogue: 0,0:10:28.06,0:10:30.09,Default,,0,0,0,,《Мен жалғыз →
Dialogue: 0,0:10:30.09,0:10:32.13,Default,,0,0,0,,Артында →
Dialogue: 0,0:10:32.13,0:10:34.73,Default,,0,0,0,,Бұл тұрарлық! 》
Dialogue: 0,0:10:37.40,0:10:40.40,Default,,0,0,0,,О!
Dialogue: 0,0:10:43.37,0:10:45.97,Default,,0,0,0,,Бучикамасе Маки!
Dialogue: 0,0:10:48.03,0:10:51.35,Default,,0,0,0,,《Идиот, сенің аяғың іште тым алыс!
Dialogue: 0,0:10:51.35,0:10:57.45,Default,,0,0,0,,Сонда... қолың серпілмейді.
Dialogue: 0,0:11:02.41,0:11:04.41,Default,,0,0,0,,《Na…》
Dialogue: 0,0:11:09.40,0:11:11.40,Default,,0,0,0,,
Dialogue: 0,0:11:14.02,0:11:17.39,Default,,0,0,0,,《Осы жерде оқ жауды ма?
Dialogue: 0,0:11:17.39,0:11:20.73,Default,,0,0,0,,Сол бір жылдық құмыра →
Dialogue: 0,0:11:20.73,0:11:24.03,Default,,0,0,0,,Сіз осылай бұрышпен доп жасай алдыңыз ба...》
Dialogue: 0,0:11:27.15,0:11:31.25,Default,,0,0,0,,《Мүлдем... мұндай лақтырудың ессіз тәсілі→
Dialogue: 0,0:11:31.25,0:11:34.36,Default,,0,0,0,,Мұны тек сіз жасай аласыз》
Dialogue: 0,0:11:34.36,0:11:38.21,Default,,0,0,0,,≪ Қамырды тастаңыз!
Dialogue: 0,0:11:38.21,0:11:41.41,Default,,0,0,0,,О! Шаа~!
Dialogue: 0,0:11:41.41,0:11:43.91,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:47.35,0:11:49.92,Default,,0,0,0,,Сакаэ-чан!
Dialogue: 0,0:11:49.92,0:11:54.04,Default,,0,0,0,,Ұстаңыз! Сіз жасадыңыз.
Dialogue: 0,0:11:54.04,0:11:57.04,Default,,0,0,0,,Тынш!
Dialogue: 0,0:12:06.99,0:12:10.68,Default,,0,0,0,,Мияби-сан, Сенсеннің ұпайы бар болғаны 1 ұпай.
Dialogue: 0,0:12:10.68,0:12:12.70,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:12:12.70,0:12:16.08,Default,,0,0,0,,Не? Сіз оны бір ұпаймен орындадыңыз ба?
Dialogue: 0,0:12:16.08,0:12:19.42,Default,,0,0,0,,Анау шымшым, сол шулы жыл?
Dialogue: 0,0:12:19.42,0:12:21.42,Default,,0,0,0,,Тынш!
Dialogue: 0,0:12:26.38,0:12:29.71,Default,,0,0,0,,Ағын бұзылса, таң қалмас еді...
Dialogue: 0,0:12:29.71,0:12:33.38,Default,,0,0,0,,Әлгі жігіт оны дұрыс лақтырды.
Dialogue: 0,0:12:33.38,0:12:36.32,Default,,0,0,0,,Біз жаттығу матчында алғаш кездескен кезде→
Dialogue: 0,0:12:36.32,0:12:40.04,Default,,0,0,0,,Қалай қарасам да, алмастырушы деп ойладым...
Dialogue: 0,0:12:40.04,0:12:45.44,Default,,0,0,0,,Ол жеңілдету ретінде қатарынан үш ойында алаңға шықты.
Dialogue: 0,0:12:45.44,0:12:48.05,Default,,0,0,0,,Дыбыс…. (Нарумия) А?
Dialogue: 0,0:12:48.05,0:12:50.37,Default,,0,0,0,,Сізде де солай болды →
Dialogue: 0,0:12:50.37,0:12:53.34,Default,,0,0,0,,1 курс студенттері үшін ойында питтинг →
Dialogue: 0,0:12:53.34,0:12:55.79,Default,,0,0,0,,Ең жақсы тәжірибе.
Dialogue: 0,0:12:55.79,0:12:58.66,Default,,0,0,0,,Тамба жарақатына байланысты алаңнан шықты→
Dialogue: 0,0:12:58.66,0:13:01.41,Default,,0,0,0,,Бірінші курстың екі құмырасы →
Dialogue: 0,0:13:01.41,0:13:04.41,Default,,0,0,0,,Мүмкін олар оны үлкейтуді шешкен шығар.
Dialogue: 0,0:13:09.99,0:13:14.07,Default,,0,0,0,,Бұл аздап қызық болатын сияқты. иә?
Dialogue: 0,0:13:14.07,0:13:17.07,Default,,0,0,0,,Бірден қоңырау шалу сияқты.
Dialogue: 0,0:13:19.38,0:13:21.36,Default,,0,0,0,,Савамура.
Dialogue: 0,0:13:21.36,0:13:24.05,Default,,0,0,0,,Келесі жолы сізге қалдырамын.
Dialogue: 0,0:13:24.05,0:13:25.99,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,0:13:25.99,0:13:30.07,Default,,0,0,0,,Керемет Сакаэ-чан! Керемет алаң!
Dialogue: 0,0:13:30.07,0:13:32.67,Default,,0,0,0,,Барлығы….
Dialogue: 0,0:13:43.99,0:13:46.02,Default,,0,0,0,,Кіріңіз!
Dialogue: 0,0:13:46.02,0:13:48.99,Default,,0,0,0,,Сіз не істеп жатырсыз? Оны алған мен болсам да!
Dialogue: 0,0:13:48.99,0:13:52.36,Default,,0,0,0,,Жоқ, Эйджун-кун! (Курамочи) Сіз жалқаусыз.
Dialogue: 0,0:13:52.36,0:13:54.73,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:13:54.73,0:13:58.40,Default,,0,0,0,,《Нобу: Сіз қазірдің өзінде Сейдоның лайықты мүшесісіз.
Dialogue: 0,0:13:58.40,0:14:03.40,Default,,0,0,0,,Өйткені, Сакаэ-чан біздің кейіпкеріміз》
Dialogue: 0,0:15:07.40,0:15:13.00,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:15:16.70,0:15:18.66,Default,,0,0,0,,Барлығы жақсы болады, иә?
Dialogue: 0,0:15:18.66,0:15:20.68,Default,,0,0,0,,≪1 ұпай қайтарылды!
Dialogue: 0,0:15:20.68,0:15:23.99,Default,,0,0,0,,О, мен кете аламын! (Яги) Әлі алда!
Dialogue: 0,0:15:23.99,0:15:28.66,Default,,0,0,0,,《Күтілгендей, сіз маған оңай шешім қабылдауға мүмкіндік бермейсіз.
Dialogue: 0,0:15:28.66,0:15:32.69,Default,,0,0,0,,Бұл ұстайтын жер.
Dialogue: 0,0:15:32.69,0:15:36.65,Default,,0,0,0,,Иә.
Dialogue: 0,0:15:36.65,0:15:38.98,Default,,0,0,0,,Нори-сенпай, ұпай айырмашылығы бар!
Dialogue: 0,0:15:38.98,0:15:41.32,Default,,0,0,0,,Бір-бірден барайық!
Dialogue: 0,0:15:41.32,0:15:43.99,Default,,0,0,0,,Таза соққы алғаныма біраз болды.
Dialogue: 0,0:15:43.99,0:15:49.03,Default,,0,0,0,,Міне, үшінші курс студентінің қыңырлығы. Ол мұнда бір ұпайды қайтарды.
Dialogue: 0,0:15:49.03,0:15:53.05,Default,,0,0,0,,Дегенмен, 9-шы иннингтің соңында ұпай айырмашылығы 5 ұпай болды.
Dialogue: 0,0:15:53.05,0:15:58.32,Default,,0,0,0,,7-ші иннинг Қосымша ұпай алынғаннан кейін екінші курс студенті Маки ойынды тастап кетті.
Dialogue: 0,0:15:58.32,0:16:03.23,Default,,0,0,0,,Алайда келесі құмыралар Сейдоның екпінін тоқтата алмады.
Dialogue: 0,0:16:03.23,0:16:05.48,Default,,0,0,0,,Әлі де 6 шабуыл →
Dialogue: 0,0:16:05.48,0:16:08.51,Default,,0,0,0,,Мен жаңа ғана қолына алған Савамура-кунға толық шабуыл жасай алмадым →
Dialogue: 0,0:16:08.51,0:16:10.51,Default,,0,0,0,,Ол үлкен болды ма?
Dialogue: 0,0:16:20.89,0:16:23.39,Default,,0,0,0,,≪Яги, мақсат қой!
Dialogue: 0,0:16:25.33,0:16:30.52,Default,,0,0,0,,《Негізі мен оны әу бастан білетінмін.
Dialogue: 0,0:16:30.52,0:16:33.24,Default,,0,0,0,,Сейдоға кірмегендер →
Dialogue: 0,0:16:33.24,0:16:35.74,Default,,0,0,0,,Даусыңды естімегендіктен емес》
Dialogue: 0,0:16:39.86,0:16:45.53,Default,,0,0,0,,《Ол командаға секіруге батылым жетпеді.
Dialogue: 0,0:16:45.53,0:16:49.54,Default,,0,0,0,,Дегенмен...
Dialogue: 0,0:16:49.54,0:16:57.35,Default,,0,0,0,,Мені мәңгілікке жалғыз сүйреп...
Dialogue: 0,0:16:57.35,0:17:04.69,Default,,0,0,0,,Мен қазір осы топтың мүшесі болсам да》
Dialogue: 0,0:17:04.69,0:17:27.34,Default,,0,0,0,,♪♪~
Dialogue: 0,0:17:27.34,0:17:32.26,Default,,0,0,0,,《Кешіріңіз...
Dialogue: 0,0:17:32.26,0:17:37.36,Default,,0,0,0,,Кешіріңіз мені кешіріңіз! 》
Dialogue: 0,0:17:47.68,0:17:50.28,Default,,0,0,0,,≪Ойын жинағы!
Dialogue: 0,0:17:52.70,0:17:55.99,Default,,0,0,0,,[Майк] 3 курс студенті Тамбадан 1 курс студенті Савамураға дейін!
Dialogue: 0,0:17:55.99,0:17:59.44,Default,,0,0,0,,[Майк] Соңында екінші курс студенті Каваками → деп қорытындылайды
Dialogue: 0,0:17:59.44,0:18:02.03,Default,,0,0,0,,Керемет құмыра эстафетасы!
Dialogue: 0,0:18:02.03,0:18:07.67,Default,,0,0,0,,[Майк] Сейдо орта мектебі соңғы үш жылда алғаш рет финалға өтті!
Dialogue: 0,0:18:07.67,0:18:09.87,Default,,0,0,0,,♬~
Dialogue: 0,0:18:09.87,0:18:11.99,Default,,0,0,0,,Бұл финал! иә!
Dialogue: 0,0:18:11.99,0:18:14.44,Default,,0,0,0,,Керемет дауыс, Каваками!
Dialogue: 0,0:18:14.44,0:18:17.54,Default,,0,0,0,,Керемет Нори! (Сакай) Каваками!
Dialogue: 0,0:18:24.15,0:18:37.75,Default,,0,0,0,,♪♪~
Dialogue: 0,0:18:37.75,0:18:43.35,Default,,0,0,0,,《Жартылай финалда қабырға тағы қалың болды ма?》
Dialogue: 0,0:18:49.86,0:18:54.38,Default,,0,0,0,,《3 курс студенттері ғана емес, сонымен қатар 2 курс және 1 курс студенттері →
Dialogue: 0,0:18:54.38,0:18:59.53,Default,,0,0,0,,Барлық ойыншылар бар күшімен ойнайды.
Dialogue: 0,0:18:59.53,0:19:04.84,Default,,0,0,0,,Менің ойыншыларым да берілмей соңына дейін күресті.→
Dialogue: 0,0:19:04.84,0:19:10.28,Default,,0,0,0,,Сайып келгенде, ең бастысы - сенімділік→
Dialogue: 0,0:19:10.28,0:19:12.16,Default,,0,0,0,,Мен оны саған бере алмадым.
Dialogue: 0,0:19:12.16,0:19:22.54,Default,,0,0,0,,♪♪~
Dialogue: 0,0:19:22.54,0:19:27.66,Default,,0,0,0,,《Мүмкін мен басқа адам туралы тым санаулы болған шығармын...''
Dialogue: 0,0:19:27.66,0:19:31.32,Default,,0,0,0,,Менің әлі алда көп жолым бар.
Dialogue: 0,0:19:31.32,0:19:33.75,Default,,0,0,0,,≪Рахмет! (Ойыншылар) Ия! !
Dialogue: 0,0:19:33.75,0:19:37.05,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:19:43.36,0:19:45.68,Default,,0,0,0,,≪ Керемет ойын! ≪Мырза Катаока! !
Dialogue: 0,0:19:45.68,0:19:49.32,Default,,0,0,0,,≪Сендер ең мықтысыңдар! ≪Тэцу-сан! !
Dialogue: 0,0:19:49.32,0:19:51.85,Default,,0,0,0,,≪Масуко! ! ≪Шпиц!
Dialogue: 0,0:19:51.85,0:19:56.86,Default,,0,0,0,,Керемет дауыс, Нори-сенпай!
Dialogue: 0,0:19:56.86,0:19:58.84,Default,,0,0,0,,Мен бір ұпай жоғалттым.
Dialogue: 0,0:19:58.84,0:20:01.35,Default,,0,0,0,,Жоқ, жоқ, сен күткендей, Сенпай.
Dialogue: 0,0:20:01.35,0:20:05.03,Default,,0,0,0,,Сіз де жақсы лақтырдыңыз. Жоқ, солай ма?
Dialogue: 0,0:20:05.03,0:20:07.07,Default,,0,0,0,,Мен жақсы уақыт өткіздім.
Dialogue: 0,0:20:07.07,0:20:09.67,Default,,0,0,0,,Жоқ, жоқ, дұрыс.
Dialogue: 0,0:20:12.57,0:20:15.53,Default,,0,0,0,,《Сіз неғұрлым көп жеңсеңіз, соғұрлым қысым күшейе түседі.
Dialogue: 0,0:20:15.53,0:20:18.70,Default,,0,0,0,,Екінші жартысы Бұл екеуінің ажырамағаны →
Dialogue: 0,0:20:18.70,0:20:21.83,Default,,0,0,0,,Бұл сәйкестік ең үлкен табыс》
Dialogue: 0,0:20:21.83,0:20:26.52,Default,,0,0,0,,Олардың әрқайсысы бір ұпайдан жинады, бірақ олар жақсы ойнады.
Dialogue: 0,0:20:26.52,0:20:30.93,Default,,0,0,0,,Мен жоспарланғандай Фуруяға демалуға мүмкіндік алдым.
Dialogue: 0,0:20:30.93,0:20:33.53,Default,,0,0,0,,Ах.
Dialogue: 0,0:20:33.53,0:20:38.13,Default,,0,0,0,,Бүкіл команда ақыры күш жинайды.
Dialogue: 0,0:20:38.13,0:20:47.23,Default,,0,0,0,,♪♪~
Dialogue: 0,0:20:50.38,0:20:53.43,Default,,0,0,0,,[Спикер] Ойынның басталу уақыты 13:00.
Dialogue: 0,0:20:53.43,0:20:59.23,Default,,0,0,0,,[Спикер] Инаги Джицугё Сакуразава орта мектебі Соғуға дайындалуды бастаңыз.
Dialogue: 0,0:21:08.03,0:21:10.20,Default,,0,0,0,,Сакаэ-чан, пішінің өзгерді, солай ма?
Dialogue: 0,0:21:10.20,0:21:12.65,Default,,0,0,0,,Сіз әрқашан бұрынғыдай боламын деп ойламаңыз.
Dialogue: 0,0:21:12.65,0:21:14.69,Default,,0,0,0,,Сіз қисық допты да үйрендіңіз бе?
Dialogue: 0,0:21:14.69,0:21:17.66,Default,,0,0,0,,А... адамдар оңайлықпен өзгермейді.
Dialogue: 0,0:21:17.66,0:21:19.69,Default,,0,0,0,,Менің кіші мектептегі досым →
Dialogue: 0,0:21:19.69,0:21:21.83,Default,,0,0,0,,Ол жол бойы мені көруге келгенін айтты.
Dialogue: 0,0:21:21.83,0:21:23.81,Default,,0,0,0,,Эй.
Dialogue: 0,0:21:23.81,0:21:26.03,Default,,0,0,0,,Сол қыз танымал болды.
Dialogue: 0,0:21:26.03,0:21:31.15,Default,,0,0,0,,Текаса Бұл қауесет қыз ба? Бұл сүйкімді.
Dialogue: 0,0:21:31.15,0:21:34.36,Default,,0,0,0,,Ол….
Dialogue: 0,0:21:34.36,0:21:37.86,Default,,0,0,0,,Не болды?
Dialogue: 0,0:21:37.86,0:21:41.70,Default,,0,0,0,,Уах уа уа....
Dialogue: 0,0:21:41.70,0:21:44.50,Default,,0,0,0,,《Вакана! ! 》
Dialogue: 0,0:21:47.34,0:21:50.72,Default,,0,0,0,,《Курамочи: Бұл біз әрқашан → электрондық поштасымен алмасамыз
Dialogue: 0,0:21:50.72,0:21:53.69,Default,,0,0,0,,Вакана?! !
Dialogue: 0,0:21:53.69,0:21:56.86,Default,,0,0,0,,Ба... Бакамура! ! 》
Dialogue: 0,0:21:56.86,0:21:59.36,Default,,0,0,0,,Тағы бір нәрсе қалды, Сакаэ-чан!
Dialogue: 0,0:21:59.36,0:22:02.70,Default,,0,0,0,,Бұл командамен біз міндетті түрде Кошиенге бара аламыз!
Dialogue: 0,0:22:02.70,0:22:04.84,Default,,0,0,0,,《Е...》
Dialogue: 0,0:22:04.84,0:22:08.04,Default,,0,0,0,,Бір жылдан кейін ұлттық дебют болуы мүмкін бе?
Dialogue: 0,0:22:08.04,0:22:10.39,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:22:10.39,0:22:12.86,Default,,0,0,0,,Біз сізге міндетті түрде қолдау көрсетеміз!
Dialogue: 0,0:22:12.86,0:22:16.87,Default,,0,0,0,,《Кошиен…》
Dialogue: 0,0:22:16.87,0:22:19.84,Default,,0,0,0,,Не болды? Эйджун.
Dialogue: 0,0:22:19.84,0:22:25.41,Default,,0,0,0,,Мен көрдім. Кошиен тағы бір қадам қалды. сурет?
Dialogue: 0,0:22:25.41,0:22:31.31,Default,,0,0,0,,Шынымды айтсам, бұл туралы мүлдем ойламадым. иә! ?
Dialogue: 0,0:22:31.31,0:22:35.75,Default,,0,0,0,,1 ойын 1 ойын Өз рөліңді ойна.
Dialogue: 0,0:22:35.75,0:22:39.75,Default,,0,0,0,,Мен шарасыздандым.
Dialogue: 0,0:22:44.16,0:22:49.06,Default,,0,0,0,,Менің үлкендерімнің барлығы да керемет адамдар→
Dialogue: 0,0:22:49.06,0:22:53.35,Default,,0,0,0,,Мен оны құрметтеймін және бұл тамаша→
Dialogue: 0,0:22:53.35,0:22:56.65,Default,,0,0,0,,Әй, ренжігендері бар.
Dialogue: 0,0:22:59.26,0:23:01.66,Default,,0,0,0,,Мен не айтайын, мен→
Dialogue: 0,0:23:01.66,0:23:07.65,Default,,0,0,0,,Мен бұл командамен мәңгі ойнағым келеді.
Dialogue: 0,0:23:07.65,0:23:11.75,Default,,0,0,0,,Хахаха мен оны жақсы айта алмаймын.
Dialogue: 0,0:23:11.75,0:23:14.35,Default,,0,0,0,,《Эйджун…》
Dialogue: 0,0:23:17.28,0:23:19.36,Default,,0,0,0,,Пу!
Dialogue: 0,0:23:19.36,0:23:21.90,Default,,0,0,0,,Мен сізге біраз уақыттан бері қоңырау шалып жатырмын.
Dialogue: 0,0:23:21.90,0:23:23.93,Default,,0,0,0,,А... аға...
Dialogue: 0,0:23:23.93,0:23:26.03,Default,,0,0,0,,Тете….
Dialogue: 0,0:23:28.85,0:23:30.87,Default,,0,0,0,,Тез кел, Савамура!
Dialogue: 0,0:23:30.87,0:23:34.04,Default,,0,0,0,,Инамидің матчы басталғалы жатыр!
Dialogue: 0,0:23:34.04,0:23:37.48,Default,,0,0,0,,Ауырды! Бұл әдеттегіден көп ауырады!
Dialogue: 0,0:23:37.48,0:23:39.86,Default,,0,0,0,,Бұл тек сіздің қиялыңыз, ақымақ.
Dialogue: 0,0:23:39.86,0:23:42.32,Default,,0,0,0,,Олай болса, мен бұл жігітті өзіммен бірге алып кетемін→
Dialogue: 0,0:23:42.32,0:23:45.79,Default,,0,0,0,,Қайта келіп, бізге қолдау көрсетіңіз.
Dialogue: 0,0:23:45.79,0:23:48.02,Default,,0,0,0,,Келіңіздер! Нана….
Dialogue: 0,0:23:48.02,0:23:51.89,Default,,0,0,0,,Тез жүру. Бұл... бұл жасөспірімдерді қорлау!
Dialogue: 0,0:23:51.89,0:23:53.81,Default,,0,0,0,,Бұл қиянат емес!
Dialogue: 0,0:23:53.81,0:23:57.70,Default,,0,0,0,,Кошиеннен Сіз осы командамен ойнауды жалғастырғыңыз келе ме?
Dialogue: 0,0:23:57.70,0:23:59.70,Default,,0,0,0,,Сакаэ-чанға ұқсайды.
Dialogue: 0,0:24:02.69,0:24:05.66,Default,,0,0,0,,Жүр! Сонда кездескенше!
Dialogue: 0,0:24:05.66,0:24:08.64,Default,,0,0,0,,《Әлі шынымен》
Dialogue: 0,0:24:08.64,0:24:11.70,Default,,0,0,0,,《Сэйичи: Тағы бір нәрсе қалды》
Dialogue: 0,0:24:11.70,0:24:15.83,Default,,0,0,0,,《Біз Сакаэ-чанбыз→
Dialogue: 0,0:24:15.83,0:24:19.25,Default,,0,0,0,,Мен сені Кошиендегі төбеде тұрғаныңды көргім келеді.
Dialogue: 0,0:24:19.25,0:24:40.35,Default,,0,0,0,,♪♪~
Dialogue: 0,0:24:41.85,0:24:47.85,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory