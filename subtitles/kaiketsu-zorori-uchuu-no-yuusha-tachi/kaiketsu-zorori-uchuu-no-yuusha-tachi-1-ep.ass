Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:38.28,0:00:39.99,Default,,0,0,0,,Әй, бұл жұлдыз жұлдыз!
Dialogue: 0,0:00:40.37,0:00:41.29,Default,,0,0,0,,Бұл әдемі!
Dialogue: 0,0:00:41.41,0:00:43.20,Default,,0,0,0,,Мен жоғары сапалы картоп жегім келеді Мен жоғары сапалы картоп жегім келеді
Dialogue: 0,0:00:43.33,0:00:45.50,Default,,0,0,0,,Ах! Ол әлдеқашан кетті!
Dialogue: 0,0:00:46.00,0:00:47.75,Default,,0,0,0,,Ношиши не істеп жатырсың?
Dialogue: 0,0:00:48.17,0:00:49.75,Default,,0,0,0,,Аққан жұлдыз жоғалып кетпей тұрып—
Dialogue: 0,0:00:49.88,0:00:52.21,Default,,0,0,0,,Үш рет тілек айтсаңыз, ол орындалады!
Dialogue: 0,0:00:52.34,0:00:53.92,Default,,0,0,0,,Уау, шынымен!?
Dialogue: 0,0:00:54.09,0:00:55.59,Default,,0,0,0,,Мен сенің жүзіңді қалаймын
Dialogue: 0,0:00:55.72,0:00:57.97,Default,,0,0,0,,Менің бетім... о, жоқ.
Dialogue: 0,0:00:58.34,0:01:01.22,Default,,0,0,0,,Зорори мырза, сіздің тілегіңіз тым ұзақ.
Dialogue: 0,0:01:01.35,0:01:04.43,Default,,0,0,0,,Қарғыс атсын! Мен міндетті түрде жасаймын
Dialogue: 0,0:01:04.68,0:01:06.10,Default,,0,0,0,,Мен оны қалаймын, мен оны қалаймын, мен оны қалаймын, мен оны қалаймын.
Dialogue: 0,0:01:06.23,0:01:07.60,Default,,0,0,0,,Мен оны қалаймын, мен оны қалаймын, мен оны қалаймын, мен оны қалаймын.
Dialogue: 0,0:01:07.73,0:01:09.44,Default,,0,0,0,,Мен оны қалаймын, мен оны қалаймын, мен оны қалаймын, мен оны қалаймын!
Dialogue: 0,0:01:09.56,0:01:13.23,Default,,0,0,0,,Сәлем! Жақсы, мен айттым!
Dialogue: 0,0:01:13.36,0:01:14.40,Default,,0,0,0,,Әй?
Dialogue: 0,0:01:19.95,0:01:21.99,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:22.16,0:01:25.00,Default,,0,0,0,,Уах, уах, уах, уах, уах, уах, уах!
Dialogue: 0,0:01:25.83,0:01:28.63,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:29.54,0:01:32.05,Default,,0,0,0,,♪〜
Dialogue: 0,0:02:53.96,0:02:58.97,Default,,0,0,0,,〜♪
Dialogue: 0,0:03:01.22,0:03:02.89,Default,,0,0,0,,Үйден құлаған тас...
Dialogue: 0,0:03:03.01,0:03:04.97,Default,,0,0,0,,Барлық жерде үлкен бум...
Dialogue: 0,0:03:05.10,0:03:07.60,Default,,0,0,0,,Бірақ мен оны құрлықтан таба алмаймын.
Dialogue: 0,0:03:08.22,0:03:10.02,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:03:10.52,0:03:12.02,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:03:12.85,0:03:15.98,Default,,0,0,0,,Жердің 70% мұхит, солай ма? Бұл дегеніміз-
Dialogue: 0,0:03:16.11,0:03:18.19,Default,,0,0,0,,Ол әлі табылған жоқ.
Dialogue: 0,0:03:18.32,0:03:22.07,Default,,0,0,0,,Мұхитта бір нәрсе бар.
Dialogue: 0,0:03:22.20,0:03:24.57,Default,,0,0,0,,Ааааааааааааааааааааааааааа
Dialogue: 0,0:03:26.08,0:03:27.87,Default,,0,0,0,,А, енді.
Dialogue: 0,0:03:28.45,0:03:30.37,Default,,0,0,0,,Эй Ишиши Ношиши
Dialogue: 0,0:03:30.83,0:03:32.25,Default,,0,0,0,,Қалайсың?
Dialogue: 0,0:03:36.96,0:03:39.71,Default,,0,0,0,,Зорори мырза, сіз алдап жатырсыз~
Dialogue: 0,0:03:39.84,0:03:41.30,Default,,0,0,0,,Өз бетіңізше ерінбеңіз.
Dialogue: 0,0:03:41.42,0:03:43.26,Default,,0,0,0,,Маған көмектесулеріңізді қалаймын.
Dialogue: 0,0:03:43.43,0:03:45.14,Default,,0,0,0,,Басқалар туралы жаман сөз айтпа.
Dialogue: 0,0:03:45.26,0:03:46.97,Default,,0,0,0,,Мен жасаған қулық
Dialogue: 0,0:03:47.10,0:03:48.60,Default,,0,0,0,,Алаяқтық көп, солай ма?
Dialogue: 0,0:03:49.10,0:03:51.39,Default,,0,0,0,,Мен мұны осы жерден тексеруім керек.
Dialogue: 0,0:03:51.52,0:03:53.02,Default,,0,0,0,,Әй?
Dialogue: 0,0:03:53.52,0:03:56.06,Default,,0,0,0,,Солтүстік-батысқа қарай спора бар!
Dialogue: 0,0:03:56.19,0:03:57.36,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:03:57.73,0:04:00.90,Default,,0,0,0,,Ах! Бұл кішкентай кеме, Зорори-сенсей!
Dialogue: 0,0:04:01.65,0:04:04.41,Default,,0,0,0,,Бұл жерде суық тию бар ма?
Dialogue: 0,0:04:06.20,0:04:08.83,Default,,0,0,0,,Інсекі ішкі…
Dialogue: 0,0:04:11.87,0:04:13.58,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:04:14.25,0:04:16.08,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:04:16.63,0:04:18.92,Default,,0,0,0,,Жоқ, Зоори-сенсей.
Dialogue: 0,0:04:19.13,0:04:21.30,Default,,0,0,0,,Мен оны мүлдем таба алмаймын.
Dialogue: 0,0:04:21.71,0:04:23.17,Default,,0,0,0,,Жалған емес—
Dialogue: 0,0:04:23.30,0:04:27.18,Default,,0,0,0,,Алтын тиындар, босеки, ондай нәрселер ақымақ.
Dialogue: 0,0:04:27.51,0:04:28.76,Default,,0,0,0,,Иә...
Dialogue: 0,0:04:29.18,0:04:30.85,Default,,0,0,0,,Алтын монеталар
Dialogue: 0,0:04:30.97,0:04:32.81,Default,,0,0,0,,Бұл көңіл көншітеді.
Dialogue: 0,0:04:32.93,0:04:35.02,Default,,0,0,0,,Не? Ия, күтіңіз, күтіңіз, күтіңіз!
Dialogue: 0,0:04:35.14,0:04:36.35,Default,,0,0,0,,Алтын монеталар мен босеки —
Dialogue: 0,0:04:36.48,0:04:38.52,Default,,0,0,0,,Екеуі де керемет, солай ма?
Dialogue: 0,0:04:38.65,0:04:39.52,Default,,0,0,0,,Бұл туралы айтатын болсақ!
Dialogue: 0,0:04:39.65,0:04:40.57,Default,,0,0,0,,Бұл болды
Dialogue: 0,0:04:40.69,0:04:41.86,Default,,0,0,0,,Мен оны фортепиано сабағында үйрендім.
Dialogue: 0,0:04:42.15,0:04:43.78,Default,,0,0,0,,Күте тұрыңыз, мен бірден барамын!
Dialogue: 0,0:05:04.38,0:05:06.76,Default,,0,0,0,,Мен барлық бос сөзге алаңдаймын.
Dialogue: 0,0:05:06.88,0:05:07.84,Default,,0,0,0,,Әрине, бұл жігіт—
Dialogue: 0,0:05:07.97,0:05:10.81,Default,,0,0,0,,Сіз сирек көретін күш деңгейі.
Dialogue: 0,0:05:10.93,0:05:13.27,Default,,0,0,0,,Мені де осы қысым нүктесі қызықтырады.
Dialogue: 0,0:05:13.39,0:05:15.10,Default,,0,0,0,,Хмм, жақсы сатылатын сияқты.
Dialogue: 0,0:05:16.35,0:05:17.27,Default,,0,0,0,,А...?
Dialogue: 0,0:05:20.06,0:05:21.27,Default,,0,0,0,,Суық тиюді іздеу
Dialogue: 0,0:05:21.61,0:05:23.94,Default,,0,0,0,,Сонымен қатар, сіз басқа адамдарды да ала аласыз!
Dialogue: 0,0:05:24.07,0:05:26.99,Default,,0,0,0,,Хмм, бұл жақсы бастама.
Dialogue: 0,0:05:27.11,0:05:29.12,Default,,0,0,0,,Уау! о?
Dialogue: 0,0:05:29.24,0:05:33.20,Default,,0,0,0,,Зорори-сенсэй, маған көмектесіңізші!
Dialogue: 0,0:05:34.50,0:05:35.66,Default,,0,0,0,,Сегізаяқ?
Dialogue: 0,0:05:38.08,0:05:39.25,Default,,0,0,0,,Сегізаяқ!?
Dialogue: 0,0:05:39.58,0:05:42.25,Default,,0,0,0,,ееееееееееееееееееееееееееееееееееееееееееееееек ееееееееееееееееееееееееееееееееееееееееее
Dialogue: 0,0:05:42.55,0:05:43.21,Default,,0,0,0,,Хуа?
Dialogue: 0,0:05:46.59,0:05:49.26,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:49.93,0:05:50.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:54.35,0:05:56.23,Default,,0,0,0,,Ннуа бу ва фугюн гя!
Dialogue: 0,0:06:00.40,0:06:02.19,Default,,0,0,0,,Сәлем! Тоқта!
Dialogue: 0,0:06:02.44,0:06:04.57,Default,,0,0,0,,Бұл жолы Зори-сенсэй қысылып қалды!
Dialogue: 0,0:06:04.69,0:06:06.94,Default,,0,0,0,,Кеттік, Ношиши, сен ысырып тұрсың!
Dialogue: 0,0:06:07.07,0:06:08.15,Default,,0,0,0,,Ryoukaidaa!
Dialogue: 0,0:06:08.28,0:06:10.91,Default,,0,0,0,,Ngggggggggggg!
Dialogue: 0,0:06:11.37,0:06:12.83,Default,,0,0,0,,Өзімді жоғалтып алған сияқтымын.
Dialogue: 0,0:06:14.24,0:06:15.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:15.79,0:06:17.33,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:06:17.46,0:06:19.92,Default,,0,0,0,,Сенсуи киімдері тек суды өткізбейді;
Dialogue: 0,0:06:20.04,0:06:21.88,Default,,0,0,0,,Тіпті фарттар да өтпейді.
Dialogue: 0,0:06:23.04,0:06:24.09,Default,,0,0,0,,Уааааааа!
Dialogue: 0,0:06:24.42,0:06:26.67,Default,,0,0,0,,Уф... аа...
Dialogue: 0,0:06:27.67,0:06:29.80,Default,,0,0,0,,Егер бұл орын алса, бұл соңғы рет!
Dialogue: 0,0:06:35.01,0:06:37.73,Default,,0,0,0,,Зорори-сама Токусей Дёрай No 1 No 2!
Dialogue: 0,0:06:37.98,0:06:38.68,Default,,0,0,0,,Хаша!
Dialogue: 0,0:06:40.77,0:06:41.35,Default,,0,0,0,,Геге!
Dialogue: 0,0:06:42.40,0:06:44.07,Default,,0,0,0,,Алдыңнан көрінбейді!?
Dialogue: 0,0:06:44.69,0:06:45.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:53.03,0:06:55.08,Default,,0,0,0,,Уау, Зори-сенсэй!
Dialogue: 0,0:06:55.99,0:06:59.46,Default,,0,0,0,,Сіз оны қайда ұрып жатырсыз?
Dialogue: 0,0:07:04.13,0:07:06.38,Default,,0,0,0,,Уау Уау Уау!
Dialogue: 0,0:07:09.05,0:07:10.84,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:19.18,0:07:21.44,Default,,0,0,0,,Неііі!
Dialogue: 0,0:07:21.73,0:07:23.23,Default,,0,0,0,,Уф...!
Dialogue: 0,0:07:34.41,0:07:37.83,Default,,0,0,0,,Уау!?
Dialogue: 0,0:07:39.58,0:07:42.04,Default,,0,0,0,,Учуу!?
Dialogue: 0,0:07:47.42,0:07:48.71,Default,,0,0,0,,Мумун…
Dialogue: 0,0:07:48.84,0:07:51.76,Default,,0,0,0,,Менің ойымша, бұл жолы тағы да Таос.
Dialogue: 0,0:07:51.97,0:07:54.14,Default,,0,0,0,,Мен Ммун планетасына орналастым.
Dialogue: 0,0:07:54.26,0:07:56.43,Default,,0,0,0,,Сол сұмдық жаратылыс...
Dialogue: 0,0:07:56.89,0:08:00.89,Default,,0,0,0,,Оның қатты айқайы әрқашан планетадағы барлық адамдарды ұйқыға батырады.
Dialogue: 0,0:08:01.02,0:08:02.35,Default,,0,0,0,,Менің басым айналып кетті
Dialogue: 0,0:08:02.77,0:08:05.48,Default,,0,0,0,,Не керек, олар айлақта жүгірді.
Dialogue: 0,0:08:05.90,0:08:08.86,Default,,0,0,0,,Іс осылай жалғаса берсе, мен дүкенге бара алмаймын.
Dialogue: 0,0:08:08.98,0:08:11.69,Default,,0,0,0,,Ммун планетасындағы жағдай нашарлап барады.
Dialogue: 0,0:08:11.82,0:08:14.32,Default,,0,0,0,,Ммм... Осындай кездерде—
Dialogue: 0,0:08:14.82,0:08:18.16,Default,,0,0,0,,Аты аңызға айналған батыр өмір сүрсе
Dialogue: 0,0:08:19.37,0:08:22.25,Default,,0,0,0,,Батыр, жарқыраған жұлдыздармен бірге...
Dialogue: 0,0:08:22.37,0:08:24.83,Default,,0,0,0,,Мен Ммун планетасына қондым.
Dialogue: 0,0:08:25.29,0:08:26.42,Default,,0,0,0,,Я...
Dialogue: 0,0:08:30.84,0:08:31.51,Default,,0,0,0,,А…?
Dialogue: 0,0:08:34.93,0:08:35.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:46.44,0:08:49.27,Default,,0,0,0,,Уууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:08:49.40,0:08:51.40,Default,,0,0,0,,Бұл мүлдем ұят болды...
Dialogue: 0,0:08:51.65,0:08:54.45,Default,,0,0,0,,Құтқарылғаныңызға қуаныштымын.
Dialogue: 0,0:08:54.57,0:08:55.86,Default,,0,0,0,,Айтпақшы—
Dialogue: 0,0:08:56.07,0:08:57.87,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:09:00.83,0:09:01.74,Default,,0,0,0,,Эй...
Dialogue: 0,0:09:01.87,0:09:02.83,Default,,0,0,0,,Хмм?
Dialogue: 0,0:09:03.45,0:09:04.79,Default,,0,0,0,,Бұл...
Dialogue: 0,0:09:06.37,0:09:08.58,Default,,0,0,0,,Ол қандай да бір планетаға келген жоқ па?
Dialogue: 0,0:09:08.71,0:09:09.92,Default,,0,0,0,,Данда!
Dialogue: 0,0:09:10.04,0:09:11.17,Default,,0,0,0,,Ха! Бұл дегеніміз-
Dialogue: 0,0:09:11.30,0:09:13.55,Default,,0,0,0,,Мұндағы тастарды жинасаң, көп ақша табасың!?
Dialogue: 0,0:09:13.67,0:09:14.63,Default,,0,0,0,,Нихи!
Dialogue: 0,0:09:15.05,0:09:16.38,Default,,0,0,0,,...
Dialogue: 0,0:09:16.68,0:09:18.14,Default,,0,0,0,,Қалағаныңызша ала аласыз!
Dialogue: 0,0:09:18.51,0:09:20.18,Default,,0,0,0,,Сіз көп нәрсені аласыз.
Dialogue: 0,0:09:20.30,0:09:21.31,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:09:21.43,0:09:23.39,Default,,0,0,0,,Сәлем! Тайрё Тайрё!
Dialogue: 0,0:09:23.52,0:09:25.56,Default,,0,0,0,,Жерге тез оралайық.
Dialogue: 0,0:09:25.69,0:09:26.52,Default,,0,0,0,,...
Dialogue: 0,0:09:27.73,0:09:29.36,Default,,0,0,0,,Мен бұлай үйге бара алмаймын!
Dialogue: 0,0:09:29.48,0:09:31.15,Default,,0,0,0,,Бұл бастапқыда Учуу кемесі емес еді.
Dialogue: 0,0:09:31.27,0:09:33.48,Default,,0,0,0,,Бұл жай ғана мұғалім болды.
Dialogue: 0,0:09:33.61,0:09:35.74,Default,,0,0,0,,Балалар!? (3 адам) Хмм... мм?
Dialogue: 0,0:09:35.86,0:09:37.95,Default,,0,0,0,,Ха ха ха ха ха ха
Dialogue: 0,0:09:38.49,0:09:41.87,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:09:42.20,0:09:44.41,Default,,0,0,0,,Жаса-іс-іс-әрекет-іс-әрекет-іс-әрекет!
Dialogue: 0,0:09:44.75,0:09:46.00,Default,,0,0,0,,Кя! Біз—
Dialogue: 0,0:09:46.12,0:09:47.92,Default,,0,0,0,,Бұл Хадаканбо мырза еді!
Dialogue: 0,0:09:49.29,0:09:51.21,Default,,0,0,0,,Оджо-сан, сенің атың кім?
Dialogue: 0,0:09:51.34,0:09:52.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:52.59,0:09:54.17,Default,,0,0,0,,Менің атым Ку Клара.
Dialogue: 0,0:09:54.30,0:09:55.97,Default,,0,0,0,,Есімі де сүйкімді!
Dialogue: 0,0:09:56.09,0:09:58.01,Default,,0,0,0,,Мен, Клара, Клара~
Dialogue: 0,0:09:58.13,0:09:59.34,Default,,0,0,0,,О!
Dialogue: 0,0:09:59.80,0:10:01.68,Default,,0,0,0,,Мен жерден келдім
Dialogue: 0,0:10:01.80,0:10:03.60,Default,,0,0,0,,Мен мұны Зооримен қайталаймын.
Dialogue: 0,0:10:03.72,0:10:04.60,Default,,0,0,0,,Бұл Ишиши!
Dialogue: 0,0:10:04.72,0:10:05.81,Default,,0,0,0,,Бұл қабан!
Dialogue: 0,0:10:06.14,0:10:07.60,Default,,0,0,0,,Ха... Зорори-сан
Dialogue: 0,0:10:07.73,0:10:10.02,Default,,0,0,0,,Ишиши мырза Ношиши мырза
Dialogue: 0,0:10:10.15,0:10:10.77,Default,,0,0,0,,Және…
Dialogue: 0,0:10:11.11,0:10:11.94,Default,,0,0,0,,Және?
Dialogue: 0,0:10:12.94,0:10:13.69,Default,,0,0,0,,Иә!?
Dialogue: 0,0:10:14.11,0:10:16.94,Default,,0,0,0,,Мына жігіт теңізден бізбен бірге келді ме?
Dialogue: 0,0:10:17.28,0:10:19.45,Default,,0,0,0,,Мугу Гиги Мугий
Dialogue: 0,0:10:19.66,0:10:22.53,Default,,0,0,0,,Мұғалім, бұл нақты шешім қабылдамайды.
Dialogue: 0,0:10:22.66,0:10:24.62,Default,,0,0,0,,Ахаха ахаха Күлме...
Dialogue: 0,0:10:24.74,0:10:26.62,Default,,0,0,0,,Балалар сендер де көмектесіңдер.
Dialogue: 0,0:10:26.75,0:10:28.25,Default,,0,0,0,,Мынау!
Dialogue: 0,0:10:28.37,0:10:30.92,Default,,0,0,0,,Мына жезөкше: «Әй, кеттік!» деп жатыр.
Dialogue: 0,0:10:31.04,0:10:31.83,Default,,0,0,0,,Күтілгендей...
Dialogue: 0,0:10:31.96,0:10:33.71,Default,,0,0,0,,Мына сегізаяқ Бұл сегізаяқ керемет
Dialogue: 0,0:10:34.50,0:10:35.46,Default,,0,0,0,,Бұл ас үй.
Dialogue: 0,0:10:37.13,0:10:38.17,Default,,0,0,0,,Не болды?
Dialogue: 0,0:10:38.30,0:10:39.59,Default,,0,0,0,,Ммм?
Dialogue: 0,0:10:40.09,0:10:43.18,Default,,0,0,0,,Фунгюу Фунгюу! Атта!
Dialogue: 0,0:10:43.30,0:10:44.51,Default,,0,0,0,,Ол адам...
Dialogue: 0,0:10:45.01,0:10:46.22,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:46.35,0:10:49.77,Default,,0,0,0,,Аты аңызға айналған батыр өлтірілді.
Dialogue: 0,0:10:50.27,0:10:51.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:52.98,0:10:55.36,Default,,0,0,0,,Бұл көп уақыт бұрын болды
Dialogue: 0,0:10:55.48,0:10:59.07,Default,,0,0,0,,Муму Сейкидің 666 жылы туралы...
Dialogue: 0,0:10:59.36,0:11:01.61,Default,,0,0,0,,Бір күні бейбіт Ммун планетасында—
Dialogue: 0,0:11:01.74,0:11:04.24,Default,,0,0,0,,Қорқынышты құбыжық пайда болды.
Dialogue: 0,0:11:04.58,0:11:07.37,Default,,0,0,0,,Кайбутсу күн сайын дерлік адамдарды мазалайды.
Dialogue: 0,0:11:07.50,0:11:08.95,Default,,0,0,0,,қорқып кетті
Dialogue: 0,0:11:09.50,0:11:10.92,Default,,0,0,0,,Мұндай уақытта—
Dialogue: 0,0:11:11.04,0:11:14.38,Default,,0,0,0,,Алыстағы жұлдыздан менің жұлдызым Мумунға келген адам —
Dialogue: 0,0:11:14.50,0:11:18.38,Default,,0,0,0,,Өзімен бірге үш досын ала келген батыр.
Dialogue: 0,0:11:19.51,0:11:22.13,Default,,0,0,0,,Батыр осы сияқты көп нәрсені жеңуі керек.
Dialogue: 0,0:11:22.26,0:11:24.64,Default,,0,0,0,,Құбыжықты жеңу...
Dialogue: 0,0:11:24.80,0:11:26.76,Default,,0,0,0,,Кейінірек мен осы планетада уақыт өткіземін.
Dialogue: 0,0:11:26.89,0:11:29.18,Default,,0,0,0,,Мумун планетамыздағы Хаттен үшін —
Dialogue: 0,0:11:29.31,0:11:31.23,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,0:11:32.65,0:11:35.11,Default,,0,0,0,,Қазір Ммуун планетасында бейбітшілік орнады.
Dialogue: 0,0:11:35.23,0:11:37.23,Default,,0,0,0,,Бәрі де батырдың арқасында
Dialogue: 0,0:11:37.36,0:11:40.57,Default,,0,0,0,,Біз батырмыз.
Dialogue: 0,0:11:40.78,0:11:41.99,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:11:42.11,0:11:46.08,Default,,0,0,0,,Міне, сол үш батыр
Dialogue: 0,0:11:47.58,0:11:49.54,Default,,0,0,0,,Зузузузу…
Dialogue: 0,0:11:49.87,0:11:52.54,Default,,0,0,0,,Сегізаяқ менің досым деп ойламаймын.
Dialogue: 0,0:11:55.13,0:11:55.88,Default,,0,0,0,,Хмм?
Dialogue: 0,0:11:56.00,0:11:59.46,Default,,0,0,0,,Угья~! (Ишиши Ношиши) Сәлем!
Dialogue: 0,0:11:59.76,0:12:01.72,Default,,0,0,0,,Ол келді.
Dialogue: 0,0:12:02.01,0:12:02.97,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:03.93,0:12:05.34,Default,,0,0,0,,А, енді ше?
Dialogue: 0,0:12:05.47,0:12:06.43,Default,,0,0,0,,Хмм...?
Dialogue: 0,0:12:06.80,0:12:10.18,Default,,0,0,0,,Бұл мен жоғарыда айтқан құбыжықтың дыбысы.
Dialogue: 0,0:12:10.47,0:12:12.39,Default,,0,0,0,,Иә? Сіз оны құлатқан жоқсыз ба?
Dialogue: 0,0:12:12.81,0:12:14.02,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:12:14.15,0:12:16.36,Default,,0,0,0,,Батыр мені жеңген соң...
Dialogue: 0,0:12:16.48,0:12:18.86,Default,,0,0,0,,Мен ұзақ уақыт үндемедім, бірақ...
Dialogue: 0,0:12:18.98,0:12:22.40,Default,,0,0,0,,Осы айғайдың кесірінен планетадағы барлық адамдар абдырап қалды.
Dialogue: 0,0:12:22.74,0:12:23.86,Default,,0,0,0,,Ой...!
Dialogue: 0,0:12:23.99,0:12:25.36,Default,,0,0,0,,Эй, бұл жаман.
Dialogue: 0,0:12:25.49,0:12:28.62,Default,,0,0,0,,Бұл «Маған көмектесші, батыр» үлгісі.
Dialogue: 0,0:12:28.83,0:12:31.12,Default,,0,0,0,,Иә, бұл күрделі.
Dialogue: 0,0:12:31.25,0:12:33.37,Default,,0,0,0,,А, мына жігіт жақсы жерде екен.
Dialogue: 0,0:12:33.50,0:12:35.79,Default,,0,0,0,,Бірдеңені дұрыс істемеген дұрыс... Уф!
Dialogue: 0,0:12:35.92,0:12:38.38,Default,,0,0,0,,Ах! Кеме болмады!
Dialogue: 0,0:12:38.50,0:12:39.50,Default,,0,0,0,,Апарып бара жатып тайып кеттім
Dialogue: 0,0:12:39.96,0:12:41.59,Default,,0,0,0,,А, бұл кеме ме?
Dialogue: 0,0:12:41.71,0:12:45.22,Default,,0,0,0,,Ондайда менде батырға жарасатын кеме бар.
Dialogue: 0,0:12:45.34,0:12:46.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:46.51,0:12:49.14,Default,,0,0,0,,Тасбақалар бұралған пирсте.
Dialogue: 0,0:12:49.26,0:12:51.72,Default,,0,0,0,,Аты аңызға айналған батырдың кемеге келгені айтылады.
Dialogue: 0,0:12:51.85,0:12:53.64,Default,,0,0,0,,Әлі біраз кемелер қалды.
Dialogue: 0,0:12:53.77,0:12:55.60,Default,,0,0,0,,Егер сіз тасбақаны өлтіре алсаңыз -
Dialogue: 0,0:12:55.73,0:12:57.69,Default,,0,0,0,,Маған берейін!
Dialogue: 0,0:12:57.81,0:12:58.98,Default,,0,0,0,,Шынымен!?
Dialogue: 0,0:12:59.11,0:13:01.73,Default,,0,0,0,,Осы жұлдызды тасты үстіне қойып, үйге барсам...
Dialogue: 0,0:13:01.86,0:13:03.69,Default,,0,0,0,,Уф!
Dialogue: 0,0:13:03.82,0:13:07.49,Default,,0,0,0,,Бірақ мен бұл соншалықты үлкен бе деп ойлаймын ...
Dialogue: 0,0:13:07.62,0:13:10.28,Default,,0,0,0,,Бізді құтқарыңыз!
Dialogue: 0,0:13:12.87,0:13:14.29,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:14.41,0:13:18.50,Default,,0,0,0,,Маған осылай қарасаң... Бірақ...
Dialogue: 0,0:13:18.63,0:13:19.50,Default,,0,0,0,,Хмм?
Dialogue: 0,0:13:20.25,0:13:21.63,Default,,0,0,0,,Маған көмектесесіз бе?
Dialogue: 0,0:13:21.75,0:13:23.01,Default,,0,0,0,,Гууууууууу...
Dialogue: 0,0:13:24.09,0:13:26.38,Default,,0,0,0,,Әй, сен өзің істе!
Dialogue: 0,0:13:26.72,0:13:28.01,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:13:30.97,0:13:32.81,Default,,0,0,0,,Dokkiin!
Dialogue: 0,0:13:32.93,0:13:34.10,Default,,0,0,0,,Басаа!
Dialogue: 0,0:13:35.52,0:13:36.64,Default,,0,0,0,,Охон!
Dialogue: 0,0:13:37.27,0:13:39.36,Default,,0,0,0,,Маған қалдырыңыз!
Dialogue: 0,0:13:39.48,0:13:40.65,Default,,0,0,0,,Ха~
Dialogue: 0,0:13:41.07,0:13:43.36,Default,,0,0,0,,Рахмет, батыр-сама.
Dialogue: 0,0:13:43.82,0:13:45.82,Default,,0,0,0,,Не не?
Dialogue: 0,0:13:53.58,0:13:55.87,Default,,0,0,0,,Сіз нені айтасыз, Зоори мырза?
Dialogue: 0,0:13:56.00,0:13:59.04,Default,,0,0,0,,Біз құбыжықтармен соғысқымыз келмейді.
Dialogue: 0,0:13:59.17,0:14:00.25,Default,,0,0,0,,Қандай да бір себепті,
Dialogue: 0,0:14:00.38,0:14:02.34,Default,,0,0,0,,Тіпті мен, жоқ.
Dialogue: 0,0:14:02.46,0:14:03.92,Default,,0,0,0,,Бірақ ол жігіт...
Dialogue: 0,0:14:04.59,0:14:07.72,Default,,0,0,0,,Ол сегізаяқ болса да, әдемі көрінеді.
Dialogue: 0,0:14:07.84,0:14:10.72,Default,,0,0,0,,Зорори мырза, бұл бөлім аяқталды.
Dialogue: 0,0:14:10.84,0:14:12.39,Default,,0,0,0,,О, рахмет~
Dialogue: 0,0:14:12.76,0:14:14.22,Default,,0,0,0,,Қалғаны –
Dialogue: 0,0:14:14.68,0:14:18.06,Default,,0,0,0,,осылайша осылай
Dialogue: 0,0:14:18.35,0:14:19.52,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:14:21.02,0:14:22.02,Default,,0,0,0,,Воила!
Dialogue: 0,0:14:22.31,0:14:23.77,Default,,0,0,0,,О~
Dialogue: 0,0:14:23.90,0:14:24.86,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:14:24.98,0:14:27.86,Default,,0,0,0,,Мен сенің аз уақыттың ішінде осындай нәрсені жасай алғаныңа сене алар емеспін!
Dialogue: 0,0:14:27.99,0:14:31.03,Default,,0,0,0,,Жарайды, барлығы сенің көмегіңнің арқасында.
Dialogue: 0,0:14:31.95,0:14:34.62,Default,,0,0,0,,Егер сізде бұл болса, сіз құбыжықты жеңе аласыз.
Dialogue: 0,0:14:34.74,0:14:36.75,Default,,0,0,0,,Сіз барлығының күлкісін қайтара аласыз.
Dialogue: 0,0:14:37.33,0:14:39.79,Default,,0,0,0,,Уф... Клара-чан...
Dialogue: 0,0:14:40.92,0:14:41.96,Default,,0,0,0,,Хмм!
Dialogue: 0,0:14:42.96,0:14:45.13,Default,,0,0,0,,Өзіміз жасайық.
Dialogue: 0,0:14:45.25,0:14:48.01,Default,,0,0,0,,Бұл планетадағы жаңа аңыз!
Dialogue: 0,0:14:48.13,0:14:49.09,Default,,0,0,0,,Хмм!
Dialogue: 0,0:14:49.22,0:14:52.47,Default,,0,0,0,,А, қазірдің өзінде! Бұл сен емессің!
Dialogue: 0,0:14:52.60,0:14:54.97,Default,,0,0,0,,Әңгімеле, сөйле, сегізаяқ! Ол әрине әдемі
Dialogue: 0,0:14:55.60,0:14:58.23,Default,,0,0,0,,Такомен болса да, Икамен.
Dialogue: 0,0:14:58.35,0:15:00.31,Default,,0,0,0,,Хехе хехе
Dialogue: 0,0:15:03.52,0:15:06.32,Default,,0,0,0,,Бұл құбыжық орналасқан пирс пе?
Dialogue: 0,0:15:09.82,0:15:10.57,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:15:11.61,0:15:12.53,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:15:12.87,0:15:14.41,Default,,0,0,0,,Урья!
Dialogue: 0,0:15:14.53,0:15:16.29,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:15:18.12,0:15:19.25,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:15:19.37,0:15:21.04,Default,,0,0,0,,Сәлем! Иә!
Dialogue: 0,0:15:23.04,0:15:24.59,Default,,0,0,0,,Угья~
Dialogue: 0,0:15:25.38,0:15:27.21,Default,,0,0,0,,Уау...
Dialogue: 0,0:15:27.34,0:15:29.55,Default,,0,0,0,,Мұғалім...Баратыныңызға сенімдісіз бе?
Dialogue: 0,0:15:29.67,0:15:31.51,Default,,0,0,0,,Ал...
Dialogue: 0,0:15:32.26,0:15:33.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:33.84,0:15:35.55,Default,,0,0,0,,А, бұл бұрын болған!
Dialogue: 0,0:15:35.97,0:15:36.97,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:15:44.98,0:15:45.90,Default,,0,0,0,,Уф!
Dialogue: 0,0:15:46.02,0:15:47.94,Default,,0,0,0,,Сәлем! Сәлем!
Dialogue: 0,0:15:48.07,0:15:49.90,Default,,0,0,0,,Неге тастамайсың!?
Dialogue: 0,0:15:50.03,0:15:51.86,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:15:51.99,0:15:53.61,Default,,0,0,0,,Бұл өте дұрыс
Dialogue: 0,0:15:53.86,0:15:55.12,Default,,0,0,0,,Енді!?
Dialogue: 0,0:15:55.41,0:15:56.28,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:56.53,0:15:58.12,Default,,0,0,0,,А... Кяаааааа!
Dialogue: 0,0:15:58.41,0:16:00.12,Default,,0,0,0,,Мм! Уф!
Dialogue: 0,0:16:02.37,0:16:05.00,Default,,0,0,0,,Фугууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу... Керемет тако!
Dialogue: 0,0:16:05.42,0:16:08.25,Default,,0,0,0,,Клара-чан, мықты бол! Уф!
Dialogue: 0,0:16:08.38,0:16:09.51,Default,,0,0,0,,Уау! (Ишиши Ношиши) Ах!
Dialogue: 0,0:16:10.46,0:16:11.38,Default,,0,0,0,,Хамф!
Dialogue: 0,0:16:13.72,0:16:14.72,Default,,0,0,0,,О!
Dialogue: 0,0:16:16.68,0:16:19.26,Default,,0,0,0,,Спидвегон, мен мұнда келдім —
Dialogue: 0,0:16:19.72,0:16:22.02,Default,,0,0,0,,Зорори-сенсэй, жақсысың ба!?
Dialogue: 0,0:16:22.52,0:16:24.52,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:24.94,0:16:26.77,Default,,0,0,0,,Өтінемін, мені тез көтеріп алыңыз!
Dialogue: 0,0:16:27.06,0:16:28.23,Default,,0,0,0,,Маған қалдырыңыз!
Dialogue: 0,0:16:28.77,0:16:30.99,Default,,0,0,0,,Клара-чан, жақсысың ба!?
Dialogue: 0,0:16:31.61,0:16:33.74,Default,,0,0,0,,Ю Батыр...
Dialogue: 0,0:16:35.36,0:16:37.12,Default,,0,0,0,,Иә!? Апыр-ай!
Dialogue: 0,0:16:37.24,0:16:38.62,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:38.74,0:16:40.08,Default,,0,0,0,,Кяах~!
Dialogue: 0,0:16:40.20,0:16:41.62,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:41.95,0:16:45.50,Default,,0,0,0,,Джо ван гя...
Dialogue: 0,0:16:46.38,0:16:48.34,Default,,0,0,0,,Буха! Бұл мені құтқарды~
Dialogue: 0,0:16:48.71,0:16:51.26,Default,,0,0,0,,Бөксесі жұмсақ болғанына қуаныштымын.
Dialogue: 0,0:16:51.38,0:16:52.51,Default,,0,0,0,,Мен жасадым...
Dialogue: 0,0:16:52.63,0:16:53.34,Default,,0,0,0,,Иә.
Dialogue: 0,0:16:53.84,0:16:55.55,Default,,0,0,0,,Неліктен ол жұмсақ?
Dialogue: 0,0:16:55.68,0:16:56.84,Default,,0,0,0,,Уау!?
Dialogue: 0,0:16:57.39,0:16:58.80,Default,,0,0,0,,Зори-сан, артыңызда!
Dialogue: 0,0:16:59.93,0:17:01.68,Default,,0,0,0,,Гааа! Нигеро
Dialogue: 0,0:17:01.81,0:17:02.77,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:17:02.89,0:17:04.77,Default,,0,0,0,,Уау, уау, Ада
Dialogue: 0,0:17:05.35,0:17:06.06,Default,,0,0,0,,Угья!
Dialogue: 0,0:17:06.19,0:17:07.35,Default,,0,0,0,,Қазір бұл не? (Ишиши Ношиши) Уау!
Dialogue: 0,0:17:10.40,0:17:11.28,Default,,0,0,0,,Иә...
Dialogue: 0,0:17:11.40,0:17:12.86,Default,,0,0,0,,Жақсы! Апыр-ай!
Dialogue: 0,0:17:13.32,0:17:18.87,Default,,0,0,0,,Уф, уф! Апыр-ай!
Dialogue: 0,0:17:18.99,0:17:21.33,Default,,0,0,0,,Дека!
Dialogue: 0,0:17:22.54,0:17:24.50,Default,,0,0,0,,Екеуің неге сонда тұрып, аң-таң болып қарап тұрсыңдар?
Dialogue: 0,0:17:24.83,0:17:28.00,Default,,0,0,0,,Мына жігіттің басына құладық.
Dialogue: 0,0:17:28.42,0:17:31.09,Default,,0,0,0,,Сіз ашулысыз ба?
Dialogue: 0,0:17:32.13,0:17:34.67,Default,,0,0,0,,Ааа! Апыр-ай!
Dialogue: 0,0:17:35.09,0:17:37.22,Default,,0,0,0,,Мына жігіт мұны істемекші!
Dialogue: 0,0:17:37.68,0:17:39.85,Default,,0,0,0,,Zorori Sensei Top Top!
Dialogue: 0,0:17:39.97,0:17:41.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:41.85,0:17:42.64,Default,,0,0,0,,Уау
Dialogue: 0,0:17:42.81,0:17:44.93,Default,,0,0,0,,Уау Уау Уау!
Dialogue: 0,0:17:48.69,0:17:52.52,Default,,0,0,0,,Уф!
Dialogue: 0,0:17:52.94,0:17:55.44,Default,,0,0,0,,Шығу! Шығу жолын табыңыз!
Dialogue: 0,0:17:55.90,0:17:58.07,Default,,0,0,0,,Не? Апыр-ай!
Dialogue: 0,0:17:58.99,0:18:00.37,Default,,0,0,0,,Бұл шығу!
Dialogue: 0,0:18:00.49,0:18:01.74,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:18:01.87,0:18:03.37,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:18:03.49,0:18:06.58,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:18:07.54,0:18:10.50,Default,,0,0,0,,Уф! Апыр-ай!
Dialogue: 0,0:18:12.00,0:18:13.92,Default,,0,0,0,,Гах! Қат!
Dialogue: 0,0:18:15.13,0:18:16.92,Default,,0,0,0,,Уггаа!
Dialogue: 0,0:18:17.05,0:18:18.93,Default,,0,0,0,,Угагагага...! Бұл буки буки!
Dialogue: 0,0:18:19.05,0:18:21.35,Default,,0,0,0,,Иә? жоқ!
Dialogue: 0,0:18:21.47,0:18:23.14,Default,,0,0,0,,Зорори Сенсэй ана жақта, ана жақта!
Dialogue: 0,0:18:23.60,0:18:24.60,Default,,0,0,0,,Міне болды!
Dialogue: 0,0:18:24.89,0:18:26.18,Default,,0,0,0,,Ура!
Dialogue: 0,0:18:26.98,0:18:27.68,Default,,0,0,0,,Бұл да тағдыр ма?
Dialogue: 0,0:18:28.81,0:18:30.19,Default,,0,0,0,,О…
Dialogue: 0,0:18:31.31,0:18:33.40,Default,,0,0,0,,Қорқынышты! Мен оны жасасам да
Dialogue: 0,0:18:33.52,0:18:35.61,Default,,0,0,0,,Ах, тегістелген.
Dialogue: 0,0:18:35.73,0:18:37.61,Default,,0,0,0,,Coppa су бүргесі
Dialogue: 0,0:18:37.82,0:18:39.57,Default,,0,0,0,,Иә? Қалай болғанда да -
Dialogue: 0,0:18:40.11,0:18:41.78,Default,,0,0,0,,Нигеро!
Dialogue: 0,0:18:42.12,0:18:43.24,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:43.37,0:18:45.04,Default,,0,0,0,,Угага… Угага…
Dialogue: 0,0:18:45.83,0:18:47.16,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:50.75,0:18:53.84,Default,,0,0,0,,Аргх, ха, ха, гарг!
Dialogue: 0,0:18:53.96,0:18:54.88,Default,,0,0,0,,Уау...
Dialogue: 0,0:18:55.00,0:18:57.05,Default,,0,0,0,,Әзірше қашып кетуге болмайды...
Dialogue: 0,0:18:57.17,0:18:58.92,Default,,0,0,0,,Біз не істеуіміз керек, Зоори мырза?
Dialogue: 0,0:18:59.05,0:19:02.14,Default,,0,0,0,,Жалынсыз әңгіме болмас еді.
Dialogue: 0,0:19:02.39,0:19:04.10,Default,,0,0,0,,Хмм ха!
Dialogue: 0,0:19:04.56,0:19:06.10,Default,,0,0,0,,Бұл түсініксіз...
Dialogue: 0,0:19:06.22,0:19:07.85,Default,,0,0,0,,Зорори-сан! иә?
Dialogue: 0,0:19:08.23,0:19:09.60,Default,,0,0,0,,Осы жерден кіруге болатын сияқты.
Dialogue: 0,0:19:10.35,0:19:11.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:17.61,0:19:20.99,Default,,0,0,0,,Бұл батыр мінген кеме ме?
Dialogue: 0,0:19:21.11,0:19:24.66,Default,,0,0,0,,Иә, ол қазір бұзылды және жұмыс істемейді.
Dialogue: 0,0:19:25.03,0:19:26.70,Default,,0,0,0,,Ойыншық машина
Dialogue: 0,0:19:26.87,0:19:27.79,Default,,0,0,0,,Тағдырымыз тоғысса екен.
Dialogue: 0,0:19:28.12,0:19:29.79,Default,,0,0,0,,Ойыншықтардың барлық жерінде сәулелер
Dialogue: 0,0:19:29.91,0:19:30.79,Default,,0,0,0,,Бааа!
Dialogue: 0,0:19:32.67,0:19:34.67,Default,,0,0,0,,Бұл төгілу ме?
Dialogue: 0,0:19:34.79,0:19:37.71,Default,,0,0,0,,Бұларды аты аңызға айналған батыр қолданған.
Dialogue: 0,0:19:37.84,0:19:39.21,Default,,0,0,0,,Бұл аңызға айналған бұта.
Dialogue: 0,0:19:39.34,0:19:41.13,Default,,0,0,0,,Уау! Иә!?
Dialogue: 0,0:19:41.38,0:19:42.38,Default,,0,0,0,,Буки!?
Dialogue: 0,0:19:42.51,0:19:43.84,Default,,0,0,0,,Бұл қайда!?
Dialogue: 0,0:19:45.22,0:19:46.35,Default,,0,0,0,,Мұнда қараңыз.
Dialogue: 0,0:19:46.68,0:19:47.97,Default,,0,0,0,,♬~
Dialogue: 0,0:19:49.85,0:19:50.98,Default,,0,0,0,,Батыр дегеніміз не?
Dialogue: 0,0:19:51.10,0:19:52.64,Default,,0,0,0,,Өзіңіз айтасыз ба?
Dialogue: 0,0:19:52.77,0:19:56.36,Default,,0,0,0,,Ал қалай қарасаң да, бұл жай ғана ойыншық... А?
Dialogue: 0,0:19:57.27,0:19:59.23,Default,,0,0,0,,Бұл жұмыртқаның қабығы ма?
Dialogue: 0,0:19:59.99,0:20:04.45,Default,,0,0,0,,Ал... сүйкімді бөлме, үлкен ойыншықтар...
Dialogue: 0,0:20:05.24,0:20:07.45,Default,,0,0,0,,Түсіндім! Түсіндім!
Dialogue: 0,0:20:09.29,0:20:11.08,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:11.21,0:20:13.71,Default,,0,0,0,,Уга гугаааага...
Dialogue: 0,0:20:14.00,0:20:15.79,Default,,0,0,0,,Клара! (Ишиши Ношиши) Уау!
Dialogue: 0,0:20:15.92,0:20:18.09,Default,,0,0,0,,Кяаааааааааааааааааааааааааа
Dialogue: 0,0:20:18.38,0:20:20.76,Default,,0,0,0,,Уау! Клараны жіберіңіз!
Dialogue: 0,0:20:20.88,0:20:22.97,Default,,0,0,0,,Ааа!
Dialogue: 0,0:20:23.09,0:20:24.05,Default,,0,0,0,,Техникалық колледжде күтіп тұрған сиқыршыларды мүмкіндігінше үнсіз жойып жібергім келеді.
Dialogue: 0,0:20:24.18,0:20:25.01,Default,,0,0,0,,А?
Dialogue: 0,0:20:25.14,0:20:26.14,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:26.26,0:20:28.31,Default,,0,0,0,,Екеуі де үлкен! (Ношиши Ишиши)?
Dialogue: 0,0:20:29.18,0:20:30.02,Default,,0,0,0,,Клара!
Dialogue: 0,0:20:30.85,0:20:31.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:32.18,0:20:35.48,Default,,0,0,0,,Мұны ұлы күшті алып кету үшін пайдаланыңыз!
Dialogue: 0,0:20:35.65,0:20:36.77,Default,,0,0,0,,Міндетті түрде көмектесіңіз!
Dialogue: 0,0:20:37.94,0:20:39.27,Default,,0,0,0,,Тек осы жолы ғана көз жұма қараймын.
Dialogue: 0,0:20:40.48,0:20:41.40,Default,,0,0,0,,А...
Dialogue: 0,0:20:41.74,0:20:42.74,Default,,0,0,0,,Әй?
Dialogue: 0,0:20:42.86,0:20:44.49,Default,,0,0,0,,Хаха... Ах~
Dialogue: 0,0:20:44.61,0:20:46.03,Default,,0,0,0,,Ах хуа хуа хуа
Dialogue: 0,0:20:46.37,0:20:49.03,Default,,0,0,0,,Эй, эй, жақсы өтті.
Dialogue: 0,0:20:49.45,0:20:51.37,Default,,0,0,0,,Жарайды, енді...
Dialogue: 0,0:20:51.50,0:20:54.29,Default,,0,0,0,,Аа, бірақ мен қай ойыншықты қолдануым керек... Иә?
Dialogue: 0,0:20:56.46,0:20:57.50,Default,,0,0,0,,Сегізаяқ!?
Dialogue: 0,0:20:57.79,0:20:59.67,Default,,0,0,0,,Үлкен пончик!
Dialogue: 0,0:20:59.80,0:21:00.92,Default,,0,0,0,,Бұл қызықты. Бұл қызықты.
Dialogue: 0,0:21:04.05,0:21:05.59,Default,,0,0,0,,Сіз немен ойнайсыз?
Dialogue: 0,0:21:05.72,0:21:08.22,Default,,0,0,0,,А, сен де байқадың!
Dialogue: 0,0:21:09.51,0:21:11.43,Default,,0,0,0,,Ах... у...
Dialogue: 0,0:21:11.93,0:21:14.02,Default,,0,0,0,,Ах... Фугугугу...
Dialogue: 0,0:21:14.14,0:21:15.27,Default,,0,0,0,,Кяаааа!
Dialogue: 0,0:21:15.39,0:21:17.35,Default,,0,0,0,,Ааааааааааа! Фугаа!
Dialogue: 0,0:21:17.48,0:21:19.27,Default,,0,0,0,,А-а-а-а... иә!
Dialogue: 0,0:21:19.48,0:21:21.40,Default,,0,0,0,,Жалықтыңыз ба?
Dialogue: 0,0:21:21.53,0:21:22.19,Default,,0,0,0,,Аға?
Dialogue: 0,0:21:22.32,0:21:24.19,Default,,0,0,0,,Иііііііі!
Dialogue: 0,0:21:24.65,0:21:26.36,Default,,0,0,0,,Зоори мырза!
Dialogue: 0,0:21:28.41,0:21:30.03,Default,,0,0,0,,Жарайды, сегізаяқ!
Dialogue: 0,0:21:31.91,0:21:32.95,Default,,0,0,0,,Клара!
Dialogue: 0,0:21:33.08,0:21:34.54,Default,,0,0,0,,Тағы сәл күте тұрыңыз!
Dialogue: 0,0:21:34.87,0:21:37.00,Default,,0,0,0,,Ах! Ааа!
Dialogue: 0,0:21:37.29,0:21:39.17,Default,,0,0,0,,Угаааааааааааааааааааааааааааааааааааааа...
Dialogue: 0,0:21:39.71,0:21:40.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:40.71,0:21:42.42,Default,,0,0,0,,Мен оны іздеп жүрмін.
Dialogue: 0,0:21:42.63,0:21:44.05,Default,,0,0,0,,Жарайды, маған бұл ұнады...
Dialogue: 0,0:21:45.88,0:21:50.22,Default,,0,0,0,,Угга... аа... Гяуга угаа!
Dialogue: 0,0:21:50.35,0:21:51.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:51.51,0:21:55.14,Default,,0,0,0,,Батыр-сама, жетеді! Нигети!
Dialogue: 0,0:21:56.02,0:21:57.27,Default,,0,0,0,,Батыр дегеніміз не?
Dialogue: 0,0:21:57.60,0:21:59.23,Default,,0,0,0,,Батыр дегеніміз не?
Dialogue: 0,0:21:59.60,0:22:03.48,Default,,0,0,0,,Оңай берілме!
Dialogue: 0,0:22:03.73,0:22:04.78,Default,,0,0,0,,Кя!
Dialogue: 0,0:22:08.74,0:22:11.20,Default,,0,0,0,,Иә, иә, иә...
Dialogue: 0,0:22:11.49,0:22:12.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:12.45,0:22:14.29,Default,,0,0,0,,Ах... Ммммммм...
Dialogue: 0,0:22:14.41,0:22:15.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:15.54,0:22:16.58,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:22:16.96,0:22:19.17,Default,,0,0,0,,Ммммммм… мммм…
Dialogue: 0,0:22:19.29,0:22:23.05,Default,,0,0,0,,Ах!
Dialogue: 0,0:22:23.17,0:22:24.00,Default,,0,0,0,,Клара!
Dialogue: 0,0:22:24.42,0:22:26.88,Default,,0,0,0,,Кяаааааааааааааааааааа
Dialogue: 0,0:22:27.01,0:22:29.05,Default,,0,0,0,,...
Dialogue: 0,0:22:29.18,0:22:31.22,Default,,0,0,0,,Ах, рақмет.
Dialogue: 0,0:22:31.55,0:22:33.06,Default,,0,0,0,,Әбу...
Dialogue: 0,0:22:33.26,0:22:34.77,Default,,0,0,0,,Міне, сол.
Dialogue: 0,0:22:34.89,0:22:35.72,Default,,0,0,0,,Надаа
Dialogue: 0,0:22:36.27,0:22:38.23,Default,,0,0,0,,Бұл баланың емізігі!
Dialogue: 0,0:22:39.23,0:22:41.65,Default,,0,0,0,,Бұл жігіт әлі сәби.
Dialogue: 0,0:22:41.86,0:22:42.86,Default,,0,0,0,,Иә!?
Dialogue: 0,0:22:42.98,0:22:45.07,Default,,0,0,0,,Аңызға айналған замандардан бері бар!?
Dialogue: 0,0:22:45.19,0:22:46.07,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:22:46.19,0:22:49.49,Default,,0,0,0,,Қартаюды білмеймін.
Dialogue: 0,0:22:49.82,0:22:51.66,Default,,0,0,0,,Мүмкін бізден—
Dialogue: 0,0:22:51.78,0:22:54.66,Default,,0,0,0,,Бәлкім, бұл барлық уақытта, барлық уақытта, баяу.
Dialogue: 0,0:22:55.54,0:22:58.16,Default,,0,0,0,,Бұл тым баяу...
Dialogue: 0,0:22:58.79,0:23:01.08,Default,,0,0,0,,Сонымен, бұл емізік болды.
Dialogue: 0,0:23:01.37,0:23:03.00,Default,,0,0,0,,Бұл керемет, Батыр-сама...
Dialogue: 0,0:23:03.13,0:23:04.50,Default,,0,0,0,,Уф!
Dialogue: 0,0:23:04.63,0:23:06.63,Default,,0,0,0,,Көп емес!
Dialogue: 0,0:23:06.80,0:23:08.67,Default,,0,0,0,,Ал... Мен асығуым керек.
Dialogue: 0,0:23:09.63,0:23:11.59,Default,,0,0,0,,Oh… Mmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmm...
Dialogue: 0,0:23:11.72,0:23:14.10,Default,,0,0,0,,Сен мені күттірдің, сегізаяқ!
Dialogue: 0,0:23:15.51,0:23:17.14,Default,,0,0,0,,Ах~ Нгю... (Ишиши Ношиши)
Dialogue: 0,0:23:17.27,0:23:20.56,Default,,0,0,0,,Ммм...
Dialogue: 0,0:23:20.98,0:23:23.36,Default,,0,0,0,,Бұл менмін, сіздің емізік!
Dialogue: 0,0:23:23.61,0:23:25.57,Default,,0,0,0,,Өйткені мен оны қолымнан келгенше қиындаттым.
Dialogue: 0,0:23:25.94,0:23:29.40,Default,,0,0,0,,Ол 100 000 жылдан кейін де, миллион жылдан кейін де бұзылмайды!
Dialogue: 0,0:23:29.53,0:23:33.45,Default,,0,0,0,,Хмм... Ммм...
Dialogue: 0,0:23:33.57,0:23:34.70,Default,,0,0,0,,Фуфун
Dialogue: 0,0:23:36.74,0:23:40.00,Default,,0,0,0,,Зоори мырза: Енді біз Жерге орала аламыз!
Dialogue: 0,0:23:40.12,0:23:41.08,Default,,0,0,0,,Ах!
Dialogue: 0,0:23:41.25,0:23:43.46,Default,,0,0,0,,Еңбегіңізге рахмет, Такомен!
Dialogue: 0,0:23:43.58,0:23:46.34,Default,,0,0,0,,Ааа, сегізаяқ сондай қыжылдап кеткен
Dialogue: 0,0:23:46.59,0:23:47.59,Default,,0,0,0,,Біздің қолымызбен—
Dialogue: 0,0:23:47.71,0:23:51.05,Default,,0,0,0,,Бұл Мумун планетасында жаңа аңыз дүниеге келді!
Dialogue: 0,0:23:52.09,0:23:52.84,Default,,0,0,0,,Әй
Dialogue: 0,0:23:53.05,0:23:55.60,Default,,0,0,0,,Бұл алдау! Біз де барынша тырыстық.
Dialogue: 0,0:23:55.72,0:23:56.85,Default,,0,0,0,,Менің де зәр алғым келеді!
Dialogue: 0,0:23:57.18,0:23:58.64,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:23:58.77,0:24:00.10,Default,,0,0,0,,Тесік! Алақай!
Dialogue: 0,0:24:00.23,0:24:02.64,Default,,0,0,0,,Сегізаяқ Кел, бірге жасайық! Алақай!
Dialogue: 0,0:24:02.94,0:24:04.19,Default,,0,0,0,,Иә!
Dialogue: 0,0:24:04.31,0:24:05.77,Default,,0,0,0,,Иә!
Dialogue: 0,0:24:08.61,0:24:09.53,Default,,0,0,0,,(Шетелдіктердің қуанышты дауысы)
Dialogue: 0,0:24:09.65,0:24:12.40,Default,,0,0,0,,Құрметті батыр! Мына жерге қара!
Dialogue: 0,0:24:14.41,0:24:16.95,Default,,0,0,0,,Өте танымал, Зорори-сенсэй!
Dialogue: 0,0:24:17.08,0:24:19.66,Default,,0,0,0,,Бұл мұғалім емес, батыр!
Dialogue: 0,0:24:20.00,0:24:21.16,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:24:21.29,0:24:23.62,Default,,0,0,0,,Курушуу жоқ, Курушуу Най!
Dialogue: 0,0:24:23.75,0:24:27.04,Default,,0,0,0,,Кяа~ Батыр~!
Dialogue: 0,0:24:32.26,0:24:35.05,Default,,0,0,0,,Сәлем, сәлем~ Иә, сәлем~ О!
Dialogue: 0,0:24:35.18,0:24:38.51,Default,,0,0,0,,Хахахаха Жоқ, жоқ, жоқ!
Dialogue: 0,0:24:39.18,0:24:40.56,Default,,0,0,0,,А... Клара?
Dialogue: 0,0:24:40.68,0:24:42.89,Default,,0,0,0,,Ммммммммммммм
Dialogue: 0,0:24:43.02,0:24:46.48,Default,,0,0,0,,Ммммммммммммммм
Dialogue: 0,0:24:53.20,0:24:54.40,Default,,0,0,0,,Я...
Dialogue: 0,0:24:57.07,0:24:57.95,Default,,0,0,0,,Ха!
Dialogue: 0,0:24:59.33,0:25:02.20,Default,,0,0,0,,Не болды, қария?
Dialogue: 0,0:25:02.50,0:25:03.16,Default,,0,0,0,,Иә!
Dialogue: 0,0:25:05.08,0:25:06.42,Default,,0,0,0,,Барлығы осылай күледі...
Dialogue: 0,0:25:07.00,0:25:09.34,Default,,0,0,0,,Мен оны біраз уақыттан кейін бірінші рет көрдім.
Dialogue: 0,0:25:09.54,0:25:12.42,Default,,0,0,0,,Ол сондай бақытты және жарқырап көрінді...
Dialogue: 0,0:25:13.55,0:25:14.97,Default,,0,0,0,,Бірақ мен...
Dialogue: 0,0:25:15.38,0:25:18.30,Default,,0,0,0,,Тек мен шынымен бақытты емеспін.
Dialogue: 0,0:25:18.43,0:25:20.43,Default,,0,0,0,,Не? Неліктен бұлай?
Dialogue: 0,0:25:21.77,0:25:23.93,Default,,0,0,0,,Сіз кеме алған кезде—
Dialogue: 0,0:25:24.14,0:25:26.94,Default,,0,0,0,,Барлығы үйіне жіберіледі, солай ма?
Dialogue: 0,0:25:27.19,0:25:28.61,Default,,0,0,0,,Не!? Ха!
Dialogue: 0,0:25:28.90,0:25:29.94,Default,,0,0,0,,Бұл –
Dialogue: 0,0:25:30.07,0:25:32.98,Default,,0,0,0,,Бұл махаббатты мойындау ма?
Dialogue: 0,0:25:33.15,0:25:34.78,Default,,0,0,0,,Күтілгендей, жоқ...
Dialogue: 0,0:25:35.03,0:25:37.28,Default,,0,0,0,,Мен Мен...!
Dialogue: 0,0:25:38.24,0:25:39.66,Default,,0,0,0,,Каккии!
Dialogue: 0,0:25:39.78,0:25:42.58,Default,,0,0,0,,Pupupupuppup nyan nya
Dialogue: 0,0:25:43.41,0:25:45.50,Default,,0,0,0,,Мен де сенімен біргемін...!
Dialogue: 0,0:25:45.66,0:25:47.50,Default,,0,0,0,,Асығыңыз ~ Бейшара ~
Dialogue: 0,0:25:47.83,0:25:49.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:25:52.75,0:25:54.76,Default,,0,0,0,,Эй, кел!
Dialogue: 0,0:25:55.63,0:25:56.26,Default,,0,0,0,,Клара
Dialogue: 0,0:25:56.88,0:25:58.51,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз...
Dialogue: 0,0:25:58.64,0:26:01.47,Default,,0,0,0,,Кез келген уақытта келіңіз бе?
Dialogue: 0,0:26:01.81,0:26:04.22,Default,,0,0,0,,О? Бұл сол кезден бе?
Dialogue: 0,0:26:04.35,0:26:05.93,Default,,0,0,0,,Мен де, бәріңмен бірге.
Dialogue: 0,0:26:06.06,0:26:08.10,Default,,0,0,0,,Мен сізге кемедегі маринадталған көкөністерге көмектесемін!
Dialogue: 0,0:26:08.23,0:26:09.77,Default,,0,0,0,,? Солай ма?
Dialogue: 0,0:26:10.19,0:26:13.07,Default,,0,0,0,,Иә! Ертең кездескенше
Dialogue: 0,0:26:13.94,0:26:15.28,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:26:16.11,0:26:17.32,Default,,0,0,0,,Е...
Dialogue: 0,0:26:17.53,0:26:20.20,Default,,0,0,0,,А, махаббатты мойындау туралы не айтасыз?
Dialogue: 0,0:26:20.82,0:26:22.24,Default,,0,0,0,,Гусун…
Dialogue: 0,0:26:46.18,0:26:47.10,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:26:48.44,0:26:50.15,Default,,0,0,0,,Аяқтауға жақын!
Dialogue: 0,0:26:50.27,0:26:52.44,Default,,0,0,0,,Сосын кетер алдында...
Dialogue: 0,0:26:52.56,0:26:54.61,Default,,0,0,0,,Мұны ұмытпаңыз
Dialogue: 0,0:26:54.73,0:26:56.36,Default,,0,0,0,,Бұл! иә?
Dialogue: 0,0:26:56.48,0:26:58.11,Default,,0,0,0,,Жаныңызда ешкім болмай тұрып!
Dialogue: 0,0:26:58.24,0:27:00.11,Default,,0,0,0,,Иә, мырза!
Dialogue: 0,0:27:00.36,0:27:01.74,Default,,0,0,0,,Nuo~
Dialogue: 0,0:27:02.16,0:27:03.70,Default,,0,0,0,,Оны алып жүр!
Dialogue: 0,0:27:03.95,0:27:05.41,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:27:05.79,0:27:08.66,Default,,0,0,0,,Асығыңыз! Essahoisa Тезірек!
Dialogue: 0,0:27:08.79,0:27:10.25,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:27:10.37,0:27:12.33,Default,,0,0,0,,Эссахоиса Тезірек болыңыз! Эсса Хойса кенеттен...
Dialogue: 0,0:27:12.46,0:27:15.21,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:27:16.17,0:27:17.80,Default,,0,0,0,,Міне.
Dialogue: 0,0:27:17.92,0:27:20.80,Default,,0,0,0,,Жұлдыз Ммунды ұмытпа...
Dialogue: 0,0:27:20.93,0:27:24.14,Default,,0,0,0,,Сол... Естелік ретінде.
Dialogue: 0,0:27:24.26,0:27:26.10,Default,,0,0,0,,Тек тас па?
Dialogue: 0,0:27:26.43,0:27:30.14,Default,,0,0,0,,Иә, тастарды шынымен жақсы көреміз...
Dialogue: 0,0:27:30.27,0:27:31.85,Default,,0,0,0,,Ишишиши Ишишиши!
Dialogue: 0,0:27:31.98,0:27:32.73,Default,,0,0,0,,Уау~
Dialogue: 0,0:27:32.85,0:27:35.61,Default,,0,0,0,,Сіз де бақытты боларсыз деп үміттенемін.
Dialogue: 0,0:27:36.15,0:27:37.07,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:27:37.28,0:27:40.82,Default,,0,0,0,,Ммммм мммммм
Dialogue: 0,0:27:40.95,0:27:42.61,Default,,0,0,0,,Ммм
Dialogue: 0,0:27:43.41,0:27:44.57,Default,,0,0,0,,Ммммммммммммм
Dialogue: 0,0:27:44.70,0:27:46.49,Default,,0,0,0,,Үлкен тас!
Dialogue: 0,0:27:46.62,0:27:47.58,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:27:47.87,0:27:49.29,Default,,0,0,0,,Аты аңызға айналған батыр...
Dialogue: 0,0:27:49.41,0:27:51.41,Default,,0,0,0,,Мен туып, оны Кокио планетасынан әкелдім.
Dialogue: 0,0:27:51.54,0:27:53.46,Default,,0,0,0,,Аңызға айналған тас!
Dialogue: 0,0:27:53.58,0:27:55.09,Default,,0,0,0,,Аңызға айналған тас?
Dialogue: 0,0:27:55.79,0:27:58.51,Default,,0,0,0,,Аты аңызға айналған батыр тас әкелгенде...
Dialogue: 0,0:27:58.63,0:28:00.67,Default,,0,0,0,,Інсеки-я, күннің ортасындағы тастан...
Dialogue: 0,0:28:00.80,0:28:03.59,Default,,0,0,0,,Одан да көп ақша табады емес пе?
Dialogue: 0,0:28:03.72,0:28:04.84,Default,,0,0,0,,Данда
Dialogue: 0,0:28:05.10,0:28:06.81,Default,,0,0,0,,Шын мәнінде, бұл кемелер
Dialogue: 0,0:28:06.93,0:28:10.81,Default,,0,0,0,,Осы аңызға айналған тас қана қозғала алады дейді.
Dialogue: 0,0:28:10.93,0:28:11.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:28:11.89,0:28:14.48,Default,,0,0,0,,Сонымен, оны бізге бересіз бе?
Dialogue: 0,0:28:14.60,0:28:15.81,Default,,0,0,0,,Бірлесіп күресу
Dialogue: 0,0:28:15.94,0:28:17.07,Default,,0,0,0,,Иә!
Dialogue: 0,0:28:17.44,0:28:20.53,Default,,0,0,0,,Дегенмен, Жұлдыз Ммун тасын және батырдың тасын жинасаңыз...
Dialogue: 0,0:28:20.65,0:28:22.99,Default,,0,0,0,,Бұл артық салмақ екені анық!
Dialogue: 0,0:28:23.15,0:28:26.74,Default,,0,0,0,,Ммун жұлдызды тасты тастамаңыз, мен оны үйге апарамын.
Dialogue: 0,0:28:28.37,0:28:31.58,Default,,0,0,0,,Нарутаке саңырауқұлақтарын пайдаланбаңыз!
Dialogue: 0,0:28:31.70,0:28:34.12,Default,,0,0,0,,Жинақтау Ақшаны үнемдеңіз!
Dialogue: 0,0:28:36.42,0:28:38.21,Default,,0,0,0,,Сізге тек...
Dialogue: 0,0:28:38.88,0:28:40.51,Default,,0,0,0,,Уау...
Dialogue: 0,0:28:40.63,0:28:44.38,Default,,0,0,0,,Күткендей, мен қатты жұмыс істеп шаршадым.
Dialogue: 0,0:28:44.51,0:28:46.47,Default,,0,0,0,,Шынында да
Dialogue: 0,0:28:46.64,0:28:48.22,Default,,0,0,0,,Теңіз кірпі... Хмм?
Dialogue: 0,0:28:48.68,0:28:49.97,Default,,0,0,0,,Теңіз кірпі... Уф!?
Dialogue: 0,0:28:50.43,0:28:51.93,Default,,0,0,0,,Хмм... unnunu
Dialogue: 0,0:28:52.06,0:28:55.52,Default,,0,0,0,,Funi Funi Funi Funununu Fununununu
Dialogue: 0,0:28:57.06,0:29:00.23,Default,,0,0,0,,Кемені жылжыту қиын.
Dialogue: 0,0:29:00.78,0:29:01.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:02.03,0:29:04.24,Default,,0,0,0,,«Еңбегіңіз үшін рахмет»?
Dialogue: 0,0:29:04.53,0:29:05.74,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:29:05.86,0:29:08.58,Default,,0,0,0,,Осындай ыңғайлы түйме болса ғой!
Dialogue: 0,0:29:09.53,0:29:11.12,Default,,0,0,0,,Не? иә?
Dialogue: 0,0:29:13.08,0:29:15.62,Default,,0,0,0,,Бұл не!?
Dialogue: 0,0:29:15.96,0:29:17.96,Default,,0,0,0,,Не болды! Не болды?
Dialogue: 0,0:29:19.13,0:29:21.46,Default,,0,0,0,,Егер сіз осы түймені кенеттен бассаңыз
Dialogue: 0,0:29:21.84,0:29:24.51,Default,,0,0,0,,Иә? Яғни...
Dialogue: 0,0:29:24.97,0:29:26.97,Default,,0,0,0,,Kinkyu іске қосу түймесі!
Dialogue: 0,0:29:27.47,0:29:28.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:28.85,0:29:32.47,Default,,0,0,0,,Міне!
Dialogue: 0,0:29:37.90,0:29:39.44,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:29:39.56,0:29:41.36,Default,,0,0,0,,А... а...
Dialogue: 0,0:29:41.48,0:29:45.24,Default,,0,0,0,,Батырдың соңынан еремін дейсің бе...
Dialogue: 0,0:29:45.86,0:29:47.99,Default,,0,0,0,,Клара, сен шеберсің.
Dialogue: 0,0:29:49.87,0:29:51.49,Default,,0,0,0,,Уау!
Dialogue: 0,0:29:51.95,0:29:54.16,Default,,0,0,0,,Бұл батырдың кемесі!
Dialogue: 0,0:29:54.29,0:29:57.00,Default,,0,0,0,,Бұл рас! Батыр!
Dialogue: 0,0:29:57.46,0:29:59.42,Default,,0,0,0,,Сіз кетіп қалдыңыз ба?
Dialogue: 0,0:29:59.54,0:30:01.75,Default,,0,0,0,,Қайта келіңіз!
Dialogue: 0,0:30:02.30,0:30:04.42,Default,,0,0,0,,Бұл әдемі көрініс болды~
Dialogue: 0,0:30:04.55,0:30:07.01,Default,,0,0,0,,Бұл суретті кітап сияқты керемет болды.
Dialogue: 0,0:30:07.26,0:30:09.59,Default,,0,0,0,,Қош бол~
Dialogue: 0,0:30:09.97,0:30:13.26,Default,,0,0,0,,Ммм! (Ютака) Өте талантты!
Dialogue: 0,0:30:15.35,0:30:17.60,Default,,0,0,0,,Эй, Клара, сен тез кетуің керек!
Dialogue: 0,0:30:17.73,0:30:20.06,Default,,0,0,0,,Қала азайып барады, солай емес пе?
Dialogue: 0,0:30:20.19,0:30:21.86,Default,,0,0,0,,Әлі уақыт бар!
Dialogue: 0,0:30:21.98,0:30:24.40,Default,,0,0,0,,Парашютпен қасық!
Dialogue: 0,0:30:24.73,0:30:25.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:30:25.78,0:30:27.49,Default,,0,0,0,,Иә? Клара?
Dialogue: 0,0:30:28.82,0:30:30.74,Default,,0,0,0,,Мені де алып кетіңізші!
Dialogue: 0,0:30:31.20,0:30:31.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:32.03,0:30:34.20,Default,,0,0,0,,Мен айта алмадым, бірақ мен...
Dialogue: 0,0:30:34.58,0:30:37.58,Default,,0,0,0,,Негізі мен батырдың соңынан қалғым келді.
Dialogue: 0,0:30:37.87,0:30:40.71,Default,,0,0,0,,Мен бұлай ештеңе істемеймін, өтінемін!
Dialogue: 0,0:30:41.38,0:30:42.54,Default,,0,0,0,,Клара…
Dialogue: 0,0:30:42.75,0:30:45.84,Default,,0,0,0,,Маған соншалықты көңіл бөлетініңізге сене алар емеспін
Dialogue: 0,0:30:45.96,0:30:49.30,Default,,0,0,0,,Осылайша мен Отакараны да, Ойоме-саманы да алдым!
Dialogue: 0,0:30:49.43,0:30:51.30,Default,,0,0,0,,Зорори Кангеки!
Dialogue: 0,0:30:51.43,0:30:55.22,Default,,0,0,0,,Ұстаз, сіз жұлдызды жұлдыздан сұраған нәрсе бар еді.
Dialogue: 0,0:30:56.14,0:30:58.64,Default,,0,0,0,,Сәлем! Мен мотивация алдым!
Dialogue: 0,0:30:58.77,0:31:02.19,Default,,0,0,0,,Біз Жерге оралсақ, үйлену тойының қоңыраулары болады!
Dialogue: 0,0:31:02.31,0:31:03.65,Default,,0,0,0,,О!
Dialogue: 0,0:31:04.57,0:31:06.48,Default,,0,0,0,,Мен тасты көрейін.
Dialogue: 0,0:31:06.61,0:31:08.19,Default,,0,0,0,,А, мен де барамын.
Dialogue: 0,0:31:09.24,0:31:11.70,Default,,0,0,0,,Ол азайып барады.
Dialogue: 0,0:31:11.82,0:31:14.53,Default,,0,0,0,,Осылайша энергияға айналады.
Dialogue: 0,0:31:14.66,0:31:17.20,Default,,0,0,0,,Оны Жерге дейін жеткізіңіз.
Dialogue: 0,0:31:23.96,0:31:25.55,Default,,0,0,0,,Ой! Алақай!
Dialogue: 0,0:31:25.67,0:31:26.80,Default,,0,0,0,,Бұл Жер!
Dialogue: 0,0:31:26.92,0:31:28.97,Default,,0,0,0,,Уау!
Dialogue: 0,0:31:31.47,0:31:32.80,Default,,0,0,0,,Не?!
Dialogue: 0,0:31:33.51,0:31:34.68,Default,,0,0,0,,Оған сіздер, студенттер де кіресіздер.
Dialogue: 0,0:31:34.80,0:31:36.43,Default,,0,0,0,,Атмосфералық қысымды қалай арттыруға болады—
Dialogue: 0,0:31:36.56,0:31:38.52,Default,,0,0,0,,Маған көбірек тас энергиясы керек.
Dialogue: 0,0:31:39.77,0:31:41.94,Default,,0,0,0,,Бұдан ештеңе қалмады!
Dialogue: 0,0:31:42.06,0:31:45.73,Default,,0,0,0,,Осы қарқынмен Жерге қайтару үшін бұдан былай ештеңе қалмайды!
Dialogue: 0,0:31:46.11,0:31:48.07,Default,,0,0,0,,Иә? Күте тұрыңыз...
Dialogue: 0,0:31:48.36,0:31:51.82,Default,,0,0,0,,Біз Мумун планетасына келдік...
Dialogue: 0,0:31:56.58,0:31:57.62,Default,,0,0,0,,Иә!
Dialogue: 0,0:31:57.83,0:31:58.75,Default,,0,0,0,,Ишиши Ношиши!
Dialogue: 0,0:31:59.12,0:32:01.29,Default,,0,0,0,,Фарттарыңызды қолданыңыз!
Dialogue: 0,0:32:01.54,0:32:03.67,Default,,0,0,0,,Е... не болды?
Dialogue: 0,0:32:04.25,0:32:06.92,Default,,0,0,0,,Негізі, ол кезде теңізге шықпас бұрын...
Dialogue: 0,0:32:07.05,0:32:08.84,Default,,0,0,0,,Зори-сенсеймен үндемей тұрайық.
Dialogue: 0,0:32:08.96,0:32:12.01,Default,,0,0,0,,Мен жай ғана жасырын түрде картоп жедім...
Dialogue: 0,0:32:12.13,0:32:13.26,Default,,0,0,0,,Не!?
Dialogue: 0,0:32:13.38,0:32:16.26,Default,,0,0,0,,Алайда Ммун планетасында картоп мүлде болмаған.
Dialogue: 0,0:32:16.39,0:32:18.06,Default,,0,0,0,,Мүлдем шықпайды.
Dialogue: 0,0:32:18.18,0:32:19.60,Default,,0,0,0,,Бұл тығыздағыш.
Dialogue: 0,0:32:19.72,0:32:20.68,Default,,0,0,0,,Уф...
Dialogue: 0,0:32:21.56,0:32:22.60,Default,,0,0,0,,Ха~
Dialogue: 0,0:32:22.73,0:32:25.36,Default,,0,0,0,,Осы қарқынмен тасқа бас салудан басқа амалым жоқ...
Dialogue: 0,0:32:25.48,0:32:26.69,Default,,0,0,0,,Иә? (Ишиши Ношиши) Иә?
Dialogue: 0,0:32:28.11,0:32:29.15,Default,,0,0,0,,Сәлем
Dialogue: 0,0:32:29.28,0:32:30.28,Default,,0,0,0,,Бұл картоп емес пе?
Dialogue: 0,0:32:30.40,0:32:33.74,Default,,0,0,0,,Бұл рас! Ішінде картоп өсіп жатыр!
Dialogue: 0,0:32:34.28,0:32:36.24,Default,,0,0,0,,Бірақ неге картоп?
Dialogue: 0,0:32:37.20,0:32:40.45,Default,,0,0,0,,Ах! Бұл баяғыда...
Dialogue: 0,0:32:40.58,0:32:42.33,Default,,0,0,0,,Біреудің айтуы...
Dialogue: 0,0:32:42.46,0:32:46.17,Default,,0,0,0,,Сол кезде мен қалдырған картоптар!
Dialogue: 0,0:32:46.58,0:32:47.25,Default,,0,0,0,,Не!
Dialogue: 0,0:32:47.38,0:32:49.42,Default,,0,0,0,,Әй, енді есіме түсті!
Dialogue: 0,0:32:49.55,0:32:52.38,Default,,0,0,0,,Мен сол кездегі картоптың әлі қалқып тұрғанына сене алар емеспін.
Dialogue: 0,0:32:52.63,0:32:54.18,Default,,0,0,0,,Сағыныш
Dialogue: 0,0:32:54.30,0:32:55.72,Default,,0,0,0,,Дәмді көрінеді!
Dialogue: 0,0:32:55.84,0:32:58.18,Default,,0,0,0,,Зоори мырза, біз қолдан келгеннің бәрін жасаймыз!
Dialogue: 0,0:32:58.30,0:32:59.64,Default,,0,0,0,,Картоп жеу үшін!
Dialogue: 0,0:32:59.76,0:33:02.64,Default,,0,0,0,,Осууға болмайды!
Dialogue: 0,0:33:02.77,0:33:04.89,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:33:07.27,0:33:11.36,Default,,0,0,0,,Уф, салмақсыз және үлпілдек.
Dialogue: 0,0:33:11.90,0:33:13.65,Default,,0,0,0,,Nii… Gu…
Dialogue: 0,0:33:14.78,0:33:17.62,Default,,0,0,0,,Ши... Хм... Тағы да...
Dialogue: 0,0:33:17.74,0:33:18.87,Default,,0,0,0,,О, Құдайым!
Dialogue: 0,0:33:19.58,0:33:21.74,Default,,0,0,0,,Хмм~ Доваа~де!
Dialogue: 0,0:33:21.87,0:33:24.29,Default,,0,0,0,,Ммм... Доуааааа!
Dialogue: 0,0:33:24.41,0:33:26.08,Default,,0,0,0,,Әй, мына жігіт жолға түсті!
Dialogue: 0,0:33:26.79,0:33:28.50,Default,,0,0,0,,Сәлем! (Ишиши Зори) Ах!
Dialogue: 0,0:33:29.00,0:33:30.25,Default,,0,0,0,,Йотто!
Dialogue: 0,0:33:30.50,0:33:34.51,Default,,0,0,0,,Иә! Түсіндім, Зори-сенси! иә?
Dialogue: 0,0:33:38.26,0:33:39.55,Default,,0,0,0,,Уау!
Dialogue: 0,0:33:39.68,0:33:42.10,Default,,0,0,0,,Татата Маған көмектесіңізші!
Dialogue: 0,0:33:42.22,0:33:43.73,Default,,0,0,0,,Ношиши! сәуле!
Dialogue: 0,0:33:43.85,0:33:45.81,Default,,0,0,0,,Күте тұрыңыз! Зорори Сенсей!?
Dialogue: 0,0:33:45.94,0:33:48.23,Default,,0,0,0,,Оны жалғыз қалдыруға болмайды!
Dialogue: 0,0:33:48.56,0:33:51.11,Default,,0,0,0,,Уау! Носиси!
Dialogue: 0,0:33:51.23,0:33:53.61,Default,,0,0,0,,Ну~ёёёёё!
Dialogue: 0,0:33:54.69,0:33:58.24,Default,,0,0,0,,Уф, уау!
Dialogue: 0,0:33:58.36,0:33:59.74,Default,,0,0,0,,Эй...!
Dialogue: 0,0:34:00.12,0:34:01.08,Default,,0,0,0,,Ношиши!
Dialogue: 0,0:34:01.70,0:34:04.45,Default,,0,0,0,,Мен қорықтым, Зори-сенсей!
Dialogue: 0,0:34:04.58,0:34:06.87,Default,,0,0,0,,Ауырсыну...
Dialogue: 0,0:34:07.58,0:34:09.17,Default,,0,0,0,,Мен бірден қайтамын!
Dialogue: 0,0:34:09.29,0:34:12.00,Default,,0,0,0,,О, тәңірім!
Dialogue: 0,0:34:12.13,0:34:13.09,Default,,0,0,0,,Жарайды, барлығыңыз, ережелерді түсіндірейін
Dialogue: 0,0:34:13.30,0:34:15.88,Default,,0,0,0,,Авава... Әй!
Dialogue: 0,0:34:16.13,0:34:18.34,Default,,0,0,0,,Уф... бұл ұстама...
Dialogue: 0,0:34:18.76,0:34:20.60,Default,,0,0,0,,Жарайсың!
Dialogue: 0,0:34:21.26,0:34:24.81,Default,,0,0,0,,Иә? о? Апыр-ай!
Dialogue: 0,0:34:24.93,0:34:26.06,Default,,0,0,0,,Мұғалім!
Dialogue: 0,0:34:26.18,0:34:28.56,Default,,0,0,0,,Хияаааааааааааааааааааааааааааааа!
Dialogue: 0,0:34:28.77,0:34:30.61,Default,,0,0,0,,Зоори мырза~!
Dialogue: 0,0:34:30.73,0:34:34.61,Default,,0,0,0,,Дәл қазір картопты жеп, көмектесу үшін қышы!
Dialogue: 0,0:34:34.73,0:34:36.36,Default,,0,0,0,,Сізге келудің қажеті жоқ! (Ишиши Ношиши) Иә?
Dialogue: 0,0:34:36.49,0:34:39.49,Default,,0,0,0,,Оны атмосфераға сақтаңыз.
Dialogue: 0,0:34:39.61,0:34:41.87,Default,,0,0,0,,Осардың да шегі бар.
Dialogue: 0,0:34:41.99,0:34:43.83,Default,,0,0,0,,Бірақ содан кейін...
Dialogue: 0,0:34:44.95,0:34:46.12,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:34:46.45,0:34:48.00,Default,,0,0,0,,Сіз және Клара...
Dialogue: 0,0:34:48.46,0:34:51.92,Default,,0,0,0,,Сондай-ақ, сегізаяқты құтқару мүмкін болса...
Dialogue: 0,0:34:52.04,0:34:55.46,Default,,0,0,0,,Ой... Мұғалім!
Dialogue: 0,0:34:56.76,0:35:00.47,Default,,0,0,0,,Қараңдар, екеуің де Жерге қараңдар...
Dialogue: 0,0:35:01.47,0:35:03.43,Default,,0,0,0,,Қандай әдемі...
Dialogue: 0,0:35:04.47,0:35:05.72,Default,,0,0,0,,Зорори мырза!
Dialogue: 0,0:35:06.43,0:35:08.68,Default,,0,0,0,,Уау!
Dialogue: 0,0:35:08.94,0:35:10.60,Default,,0,0,0,,Я...
Dialogue: 0,0:35:11.40,0:35:14.36,Default,,0,0,0,,Тұншыға бастады...
Dialogue: 0,0:35:16.19,0:35:18.32,Default,,0,0,0,,Егер бұл жоғары болса...
Dialogue: 0,0:35:18.69,0:35:21.36,Default,,0,0,0,,Анаммен жұмақ та жақын...
Dialogue: 0,0:35:23.32,0:35:26.24,Default,,0,0,0,,Мен сізді тағы көремін бе, мама...
Dialogue: 0,0:35:28.54,0:35:31.29,Default,,0,0,0,,Өз сөзіңізді ұмыттыңыз ба?
Dialogue: 0,0:35:31.54,0:35:32.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:35:33.25,0:35:36.55,Default,,0,0,0,,Батыр ешқашан берілмейді дедіңіз.
Dialogue: 0,0:35:37.05,0:35:38.71,Default,,0,0,0,,Бұл дауыс...?
Dialogue: 0,0:35:40.59,0:35:43.18,Default,,0,0,0,,Дұрыс, мен берілмеймін!
Dialogue: 0,0:35:43.30,0:35:45.85,Default,,0,0,0,,Оны сіз де, Ойоме-сан да түсінсеңіз де...
Dialogue: 0,0:35:45.97,0:35:49.18,Default,,0,0,0,,Мұндай жерде қыдырып жүру жалықтыра ма?
Dialogue: 0,0:35:49.31,0:35:51.56,Default,,0,0,0,,Гррр...!
Dialogue: 0,0:35:52.90,0:35:55.40,Default,,0,0,0,,Ду-ах!
Dialogue: 0,0:35:55.73,0:35:59.11,Default,,0,0,0,,Ававава а... Иә?
Dialogue: 0,0:35:59.49,0:36:01.40,Default,,0,0,0,,Taco?
Dialogue: 0,0:36:01.53,0:36:03.87,Default,,0,0,0,,Не істеп жатырсың!?
Dialogue: 0,0:36:05.16,0:36:06.78,Default,,0,0,0,,Басыңыз!
Dialogue: 0,0:36:07.20,0:36:08.87,Default,,0,0,0,,Басыңыз! Ах...
Dialogue: 0,0:36:09.00,0:36:10.54,Default,,0,0,0,,Басыңыз!
Dialogue: 0,0:36:10.66,0:36:12.87,Default,,0,0,0,,Рахмет, сегізаяқ!
Dialogue: 0,0:36:13.25,0:36:16.17,Default,,0,0,0,,Басыңыз! Басыңыз!
Dialogue: 0,0:36:18.34,0:36:21.17,Default,,0,0,0,,Зоори мырза!
Dialogue: 0,0:36:21.30,0:36:23.01,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:36:23.13,0:36:29.47,Default,,0,0,0,,(Екі адам жылайды)
Dialogue: 0,0:36:35.86,0:36:37.73,Default,,0,0,0,,уф уф ееее
Dialogue: 0,0:36:38.27,0:36:40.11,Default,,0,0,0,,Фарт Хаша Джунби!
Dialogue: 0,0:36:40.57,0:36:41.40,Default,,0,0,0,,５！
Dialogue: 0,0:36:41.82,0:36:42.49,Default,,0,0,0,,４！
Dialogue: 0,0:36:43.07,0:36:43.74,Default,,0,0,0,,３！
Dialogue: 0,0:36:44.28,0:36:44.95,Default,,0,0,0,,２！
Dialogue: 0,0:36:45.49,0:36:46.12,Default,,0,0,0,,１！
Dialogue: 0,0:36:46.66,0:36:47.87,Default,,0,0,0,,Тұтану!
Dialogue: 0,0:36:56.79,0:36:58.75,Default,,0,0,0,,Иә!
Dialogue: 0,0:37:11.89,0:37:13.81,Default,,0,0,0,,Жарайды, жасайық!
Dialogue: 0,0:37:16.73,0:37:18.81,Default,,0,0,0,,Алға!
Dialogue: 0,0:37:19.32,0:37:22.44,Default,,0,0,0,,О...
Dialogue: 0,0:37:27.53,0:37:28.45,Default,,0,0,0,,Уау!
Dialogue: 0,0:37:28.57,0:37:29.78,Default,,0,0,0,,Зоори мырза!
Dialogue: 0,0:37:29.91,0:37:30.53,Default,,0,0,0,,Не болды?
Dialogue: 0,0:37:31.33,0:37:33.33,Default,,0,0,0,,Генсоку менің қолымнан келмейді!
Dialogue: 0,0:37:33.45,0:37:34.66,Default,,0,0,0,,Төрт күн бұрын біздің бағдарламаның режиссеріне төрт таспа жіберілді
Dialogue: 0,0:37:41.05,0:37:43.21,Default,,0,0,0,,Уф! Не болып жатыр?
Dialogue: 0,0:37:46.47,0:37:48.68,Default,,0,0,0,,Уф... Куу...
Dialogue: 0,0:37:51.31,0:37:54.68,Default,,0,0,0,,Әй... А, қазірдің өзінде!
Dialogue: 0,0:37:54.81,0:37:55.81,Default,,0,0,0,,(Пинг Донг)
Dialogue: 0,0:37:55.94,0:37:57.44,Default,,0,0,0,,Не? а!
Dialogue: 0,0:37:58.69,0:38:00.36,Default,,0,0,0,,Мынаны салғанымды қалайсың ба?
Dialogue: 0,0:38:00.48,0:38:01.86,Default,,0,0,0,,Барлығы осында ма?
Dialogue: 0,0:38:01.98,0:38:03.69,Default,,0,0,0,,Қанша кітап бар...
Dialogue: 0,0:38:04.61,0:38:05.82,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:38:05.95,0:38:07.57,Default,,0,0,0,,Мұнда сегізаяқ бар.
Dialogue: 0,0:38:07.70,0:38:09.70,Default,,0,0,0,,Оның сегіз мүшесі бар ғой!
Dialogue: 0,0:38:09.82,0:38:11.45,Default,,0,0,0,,Иә, дұрыс!
Dialogue: 0,0:38:13.45,0:38:15.16,Default,,0,0,0,,Ештеңе болмайды, солай ма?
Dialogue: 0,0:38:15.29,0:38:16.58,Default,,0,0,0,,О?
Dialogue: 0,0:38:17.67,0:38:19.67,Default,,0,0,0,,Не? Енді ше?
Dialogue: 0,0:38:19.79,0:38:21.21,Default,,0,0,0,,Бұл аяқтың ізі.
Dialogue: 0,0:38:21.63,0:38:23.21,Default,,0,0,0,,Сіз мұны айтып тұрсыз ба?
Dialogue: 0,0:38:25.21,0:38:29.18,Default,,0,0,0,,Уф... Аяғыма жете алмаймын!
Dialogue: 0,0:38:29.30,0:38:30.85,Default,,0,0,0,,4 қалды...
Dialogue: 0,0:38:31.01,0:38:32.31,Default,,0,0,0,,Бұл болуы керек
Dialogue: 0,0:38:32.43,0:38:35.64,Default,,0,0,0,,Біздің кемені басқа планеталардың адамдары басып алуына жол бермеу.
Dialogue: 0,0:38:35.77,0:38:38.23,Default,,0,0,0,,Бұл батырлардың жасаған айласы.
Dialogue: 0,0:38:38.69,0:38:40.56,Default,,0,0,0,,Біз оны жеңе аламыз.
Dialogue: 0,0:38:40.69,0:38:41.65,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:38:43.19,0:38:44.86,Default,,0,0,0,,Ммун шетелдіктері үшін
Dialogue: 0,0:38:44.98,0:38:46.94,Default,,0,0,0,,Бұл пішінді басқаларға көрсету...
Dialogue: 0,0:38:47.07,0:38:48.78,Default,,0,0,0,,Жұлдыздарды лақтырудың дәлелі...
Dialogue: 0,0:38:49.11,0:38:50.16,Default,,0,0,0,,Бірақ!
Dialogue: 0,0:38:54.99,0:38:56.08,Default,,0,0,0,,Ах~
Dialogue: 0,0:38:56.20,0:38:57.58,Default,,0,0,0,,Ха...!
Dialogue: 0,0:39:09.43,0:39:11.47,Default,,0,0,0,,Иә!? (Ишиши Ношиши) Ах...
Dialogue: 0,0:39:11.59,0:39:13.10,Default,,0,0,0,,Бұл өте жақсы.
Dialogue: 0,0:39:13.22,0:39:14.22,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:39:14.60,0:39:16.52,Default,,0,0,0,,Тағы да әлгі шыңғырған дауыс
Dialogue: 0,0:39:17.02,0:39:18.98,Default,,0,0,0,,Ол қайдан шыққан?
Dialogue: 0,0:39:19.35,0:39:21.15,Default,,0,0,0,,Иә! Мен шештім
Dialogue: 0,0:39:21.27,0:39:22.02,Default,,0,0,0,,Хмм?
Dialogue: 0,0:39:22.15,0:39:24.98,Default,,0,0,0,,Мен батырға деген сүйіспеншілігімді өткіземін.
Dialogue: 0,0:39:25.32,0:39:27.57,Default,,0,0,0,,Иә! Сол сияқты...
Dialogue: 0,0:39:27.69,0:39:29.70,Default,,0,0,0,,Мені жақсы көремін, мені жақсы көреді...
Dialogue: 0,0:39:29.82,0:39:30.95,Default,,0,0,0,,Мен абдырап қалдым
Dialogue: 0,0:39:31.66,0:39:33.57,Default,,0,0,0,,Мен сіздің сезіміңізді түсінемін.
Dialogue: 0,0:39:33.99,0:39:34.70,Default,,0,0,0,,Хмм?
Dialogue: 0,0:39:35.24,0:39:37.29,Default,,0,0,0,,Жер бетінде бірге тұрайық!
Dialogue: 0,0:39:39.37,0:39:40.66,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:39:40.79,0:39:43.67,Default,,0,0,0,,Не? сурет? сурет? сурет?
Dialogue: 0,0:39:44.88,0:39:47.17,Default,,0,0,0,,Иә!?
Dialogue: 0,0:39:50.80,0:39:52.09,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:39:52.34,0:39:53.34,Default,,0,0,0,,Хмф!
Dialogue: 0,0:39:55.22,0:39:57.72,Default,,0,0,0,,Тежегіштер дірілдеп тұр ма?
Dialogue: 0,0:39:57.85,0:40:00.35,Default,,0,0,0,,Бұл тасты кішірейтеді!
Dialogue: 0,0:40:04.77,0:40:05.69,Default,,0,0,0,,Не?!
Dialogue: 0,0:40:05.82,0:40:10.32,Default,,0,0,0,,Ууууууууууууууууууууууууу
Dialogue: 0,0:40:10.44,0:40:13.99,Default,,0,0,0,,Уау! Апыр-ай! Апыр-ай!
Dialogue: 0,0:40:26.79,0:40:30.01,Default,,0,0,0,,Хмм... О, ол жерде...
Dialogue: 0,0:40:30.51,0:40:31.84,Default,,0,0,0,,Барлығы... Әй!
Dialogue: 0,0:40:32.84,0:40:33.93,Default,,0,0,0,,Амансың ба!?
Dialogue: 0,0:40:34.05,0:40:35.59,Default,,0,0,0,,Досей
Dialogue: 0,0:40:35.72,0:40:38.97,Default,,0,0,0,,Әй, менің аузым саңылауларға толы...
Dialogue: 0,0:40:39.10,0:40:40.81,Default,,0,0,0,,Біз қайтып келдік!
Dialogue: 0,0:40:41.06,0:40:42.39,Default,,0,0,0,,Иә!
Dialogue: 0,0:40:42.52,0:40:43.89,Default,,0,0,0,,Батыр!
Dialogue: 0,0:40:48.52,0:40:49.48,Default,,0,0,0,,Клара...
Dialogue: 0,0:40:50.82,0:40:52.19,Default,,0,0,0,,Не? Лала?
Dialogue: 0,0:40:52.74,0:40:53.78,Default,,0,0,0,,Иә!?
Dialogue: 0,0:40:54.49,0:40:56.53,Default,,0,0,0,,Менімен келесің бе?
Dialogue: 0,0:40:56.70,0:40:58.41,Default,,0,0,0,,Иә, Батыр-сама
Dialogue: 0,0:40:58.58,0:41:00.74,Default,,0,0,0,,Тоқта, күт, күт, күт!
Dialogue: 0,0:41:00.87,0:41:02.87,Default,,0,0,0,,Батыр - мен, солай ма? Клара?
Dialogue: 0,0:41:03.00,0:41:05.08,Default,,0,0,0,,Иә?осу?
Dialogue: 0,0:41:05.62,0:41:06.58,Default,,0,0,0,,Мен
Dialogue: 0,0:41:06.71,0:41:10.30,Default,,0,0,0,,Мен сені көрген сәттен бастап, Батыр жүрегімді ұрлады.
Dialogue: 0,0:41:10.71,0:41:13.63,Default,,0,0,0,,Батыр тіпті өзін құрбан етті...
Dialogue: 0,0:41:13.76,0:41:15.72,Default,,0,0,0,,Ммун планетасына көмектескеніңіз үшін рахмет.
Dialogue: 0,0:41:16.18,0:41:17.68,Default,,0,0,0,,Мен туралы да...
Dialogue: 0,0:41:18.47,0:41:21.18,Default,,0,0,0,,Мен сіздің артыңыздан қалғым келетінін айтқан кезде—
Dialogue: 0,0:41:21.39,0:41:24.02,Default,,0,0,0,,Батыр мені тоқтатты, бірақ...
Dialogue: 0,0:41:24.64,0:41:25.81,Default,,0,0,0,,Сол кезде —
Dialogue: 0,0:41:25.98,0:41:29.44,Default,,0,0,0,,Мен сенің бақытыңды ойладым, бірақ...!
Dialogue: 0,0:41:30.02,0:41:33.57,Default,,0,0,0,,Менің бақытым батырдың қасында ғана!
Dialogue: 0,0:41:33.74,0:41:35.32,Default,,0,0,0,,Өтірік!?
Dialogue: 0,0:41:35.45,0:41:37.62,Default,,0,0,0,,Зоори мырза! Мынаны қара!
Dialogue: 0,0:41:37.74,0:41:39.45,Default,,0,0,0,,Ах... а!?
Dialogue: 0,0:41:40.16,0:41:41.37,Default,,0,0,0,,Сонымен батыр...
Dialogue: 0,0:41:41.49,0:41:44.96,Default,,0,0,0,,Мен үшеуінің айтқанын орындаңдар дедім.
Dialogue: 0,0:41:45.33,0:41:48.71,Default,,0,0,0,,Мынау мен әкелген батырдың кітабы.
Dialogue: 0,0:41:48.83,0:41:50.29,Default,,0,0,0,,Үш серік—
Dialogue: 0,0:41:50.42,0:41:52.71,Default,,0,0,0,,Мен батырдың серігі болдым ба?
Dialogue: 0,0:41:53.42,0:41:56.47,Default,,0,0,0,,Жоқ, біз теңбіз.
Dialogue: 0,0:41:56.88,0:41:58.22,Default,,0,0,0,,Қызық болса да...
Dialogue: 0,0:41:58.34,0:42:00.89,Default,,0,0,0,,Мені Ммун планетасына апарғаны үшін—
Dialogue: 0,0:42:01.14,0:42:03.47,Default,,0,0,0,,Менімен жұмыс істегеніңіз үшін—
Dialogue: 0,0:42:04.10,0:42:06.19,Default,,0,0,0,,Жүрегім сен үшін.
Dialogue: 0,0:42:06.31,0:42:06.98,Default,,0,0,0,,Эй?
Dialogue: 0,0:42:09.10,0:42:10.56,Default,,0,0,0,,Баяғыда-
Dialogue: 0,0:42:10.77,0:42:13.57,Default,,0,0,0,,Біздің оқушылар кемені құрастырды...
Dialogue: 0,0:42:14.78,0:42:17.03,Default,,0,0,0,,Жаңа жұлдызға ұмтылу—
Dialogue: 0,0:42:17.15,0:42:18.86,Default,,0,0,0,,Аңыз ретінде естідім
Dialogue: 0,0:42:18.99,0:42:21.20,Default,,0,0,0,,Сегізаяқ кемені дамытады!?
Dialogue: 0,0:42:21.33,0:42:24.08,Default,,0,0,0,,Мен бұл жай сегізаяқ емес деп ойладым!
Dialogue: 0,0:42:24.20,0:42:26.46,Default,,0,0,0,,Біз «сегізаяқтардан» басқа түрміз
Dialogue: 0,0:42:26.58,0:42:28.21,Default,,0,0,0,,Е, сегізаяқ емес пе?
Dialogue: 0,0:42:28.50,0:42:29.92,Default,,0,0,0,,Біз не істедік...
Dialogue: 0,0:42:30.04,0:42:32.04,Default,,0,0,0,,Ммун планетасы туралы аңыз құрастырыңыз—
Dialogue: 0,0:42:32.17,0:42:33.96,Default,,0,0,0,,Кларамен бірге далада...
Dialogue: 0,0:42:34.09,0:42:36.51,Default,,0,0,0,,Мен сені осылай кездестіре алатыныма сене алар емеспін...
Dialogue: 0,0:42:36.84,0:42:40.59,Default,,0,0,0,,Ал енді мен бұл планетаға келдім.
Dialogue: 0,0:42:40.89,0:42:43.64,Default,,0,0,0,,Сенімен бірге өмір сүру, сүйіктім!
Dialogue: 0,0:42:43.76,0:42:44.68,Default,,0,0,0,,Клара…
Dialogue: 0,0:42:44.81,0:42:45.89,Default,,0,0,0,,Құрметті батыр...
Dialogue: 0,0:42:46.14,0:42:47.39,Default,,0,0,0,,Ммммммммммм
Dialogue: 0,0:42:47.52,0:42:49.40,Default,,0,0,0,,Не болды?
Dialogue: 0,0:42:49.52,0:42:51.11,Default,,0,0,0,,Бұл Кьюрецу
Dialogue: 0,0:42:51.23,0:42:52.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:42:52.36,0:42:55.11,Default,,0,0,0,,О, ханым...
Dialogue: 0,0:42:55.23,0:42:57.78,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе, Зорори-сенсей.
Dialogue: 0,0:42:57.90,0:42:59.20,Default,,0,0,0,,Егер біз оларды тоқтатпасақ, олар сол темір кесекке сәбіз жегізуге тырысады.
Dialogue: 0,0:42:59.32,0:43:00.53,Default,,0,0,0,,Міне, солай!
Dialogue: 0,0:43:00.66,0:43:02.49,Default,,0,0,0,,Мені ханым тастап кетсе де...
Dialogue: 0,0:43:02.62,0:43:05.37,Default,,0,0,0,,Менде Мумун жұлдыз тасы әлі бар!
Dialogue: 0,0:43:05.49,0:43:06.41,Default,,0,0,0,,Егер сізде бұл болса
Dialogue: 0,0:43:08.21,0:43:09.33,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:43:09.46,0:43:11.21,Default,,0,0,0,,Бар болғаны...
Dialogue: 0,0:43:11.33,0:43:14.59,Default,,0,0,0,,Ол кенет серпілуден кішірейіп кетті.
Dialogue: 0,0:43:14.71,0:43:17.76,Default,,0,0,0,,Жоқ! Қандай аңызға айналған тас!
Dialogue: 0,0:43:17.88,0:43:21.43,Default,,0,0,0,,Осының өзі сізге керемет сезім сыйлауы керек.
Dialogue: 0,0:43:21.55,0:43:23.43,Default,,0,0,0,,Әлгі Зори-сан?
Dialogue: 0,0:43:24.81,0:43:27.93,Default,,0,0,0,,(Сүйек сынуының дыбысы)
Dialogue: 0,0:43:29.14,0:43:31.65,Default,,0,0,0,,Зори-санға рахмет, мен...
Dialogue: 0,0:43:32.61,0:43:34.23,Default,,0,0,0,,Мен өте қуаныштымын...
Dialogue: 0,0:43:37.23,0:43:39.15,Default,,0,0,0,,Суреттер кітабындағы ханшайым сияқты
Dialogue: 0,0:43:39.82,0:43:41.78,Default,,0,0,0,,Бақытты өмір сүр
Dialogue: 0,0:43:43.62,0:43:44.53,Default,,0,0,0,,Иә!
Dialogue: 0,0:43:48.62,0:43:50.54,Default,,0,0,0,,Бұл тіпті 1 иенге де тұрмайды!?
Dialogue: 0,0:43:50.83,0:43:52.29,Default,,0,0,0,,Бұл шындық болуы мүмкін емес!
Dialogue: 0,0:43:52.42,0:43:54.67,Default,,0,0,0,,Сіз тіпті кемені жылжыта аласыз, солай ма?
Dialogue: 0,0:43:54.79,0:43:56.50,Default,,0,0,0,,Сонда бұл кеме туралы не деуге болады?
Dialogue: 0,0:43:56.63,0:43:57.80,Default,,0,0,0,,Оны жылжытыңыз және маған көрсетіңіз.
Dialogue: 0,0:43:57.92,0:43:58.55,Default,,0,0,0,,Уф...
Dialogue: 0,0:43:58.76,0:44:03.30,Default,,0,0,0,,Біздің кеме қиратылды, оның бір бөлігі де қалмады.
Dialogue: 0,0:44:03.55,0:44:06.56,Default,,0,0,0,,Қалай болғанда да, бұл жақсы идея.
Dialogue: 0,0:44:07.93,0:44:09.52,Default,,0,0,0,,Аты аңызға айналған батыр...
Dialogue: 0,0:44:09.64,0:44:11.60,Default,,0,0,0,,Мен Кокио планетасынан туып, әкелдім.
Dialogue: 0,0:44:11.73,0:44:13.90,Default,,0,0,0,,Бұл аңызға айналған тас.
Dialogue: 0,0:44:14.10,0:44:16.90,Default,,0,0,0,,Батыр жұлдызынан Мумун жұлдызына дейін
Dialogue: 0,0:44:17.02,0:44:19.78,Default,,0,0,0,,Сегізаяқ Гозенцо – батыр.
Dialogue: 0,0:44:19.90,0:44:23.20,Default,,0,0,0,,Батырдың жұлдызы – біздің жұлдыз.
Dialogue: 0,0:44:23.32,0:44:25.57,Default,,0,0,0,,Сонымен біз не әкелдік...
Dialogue: 0,0:44:27.08,0:44:29.91,Default,,0,0,0,,Сондықтан бұл барлық жерде құлап жатыр -
Dialogue: 0,0:44:30.04,0:44:31.83,Default,,0,0,0,,Бұл жай ғана тас, солай ма?
Dialogue: 0,0:44:36.34,0:44:38.30,Default,,0,0,0,,О! Сол тас!
Dialogue: 0,0:44:38.84,0:44:41.34,Default,,0,0,0,,Бұл мен іздеген тас!
Dialogue: 0,0:44:41.47,0:44:43.34,Default,,0,0,0,,Біз оны міндетті түрде сатқыңыз келеді!
Dialogue: 0,0:44:43.47,0:44:44.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:44:44.26,0:44:46.01,Default,,0,0,0,,Сенің көздерің керемет!
Dialogue: 0,0:44:46.14,0:44:48.43,Default,,0,0,0,,Өйткені, мұның қаншалықты ғажап екенін түсінетіндер ғана...
Dialogue: 0,0:44:48.56,0:44:50.35,Default,,0,0,0,,Мына пішін, мына өлшем!
Dialogue: 0,0:44:50.47,0:44:53.56,Default,,0,0,0,,Мен іздеген маринадталған тасқа өте ыңғайлы!
Dialogue: 0,0:44:55.15,0:44:57.02,Default,,0,0,0,,Цукемоно тасы~~!?
Dialogue: 0,0:44:57.15,0:45:00.90,Default,,0,0,0,,Бұл емес!
Dialogue: 0,0:45:02.19,0:45:04.91,Default,,0,0,0,,♪ Жаңа! Би үшін жаңа!
Dialogue: 0,0:45:05.03,0:45:07.99,Default,,0,0,0,,♪ Жаңа! Би үшін жаңа!
Dialogue: 0,0:45:27.14,0:45:32.02,Default,,0,0,0,,♪Шицуреннің бір-екеуі
Dialogue: 0,0:45:32.14,0:45:37.77,Default,,0,0,0,,♪ 3 4 5 6 7 8
Dialogue: 0,0:45:38.15,0:45:43.40,Default,,0,0,0,,♪Олай жасасаң, көңілің қалады.
Dialogue: 0,0:45:43.69,0:45:49.58,Default,,0,0,0,,♪Ичиичи Очикомя «Бұл қиын.»
Dialogue: 0,0:45:49.87,0:45:53.00,Default,,0,0,0,,♪Егер ол бірдей «кеспе» болса
Dialogue: 0,0:45:53.12,0:45:59.79,Default,,0,0,0,,♪ «Рамен ше?»
Dialogue: 0,0:46:03.80,0:46:06.43,Default,,0,0,0,,♪Мисо тұзды соя соусы Чаршу ерлер
Dialogue: 0,0:46:06.55,0:46:08.55,Default,,0,0,0,,♪Менің ішім сондай жылы
Dialogue: 0,0:46:08.68,0:46:09.43,Default,,0,0,0,,♪ “Фуккатсу!!”
Dialogue: 0,0:46:09.55,0:46:11.97,Default,,0,0,0,,♪Таусылып қалсаң бара алмайсың.
Dialogue: 0,0:46:12.10,0:46:14.64,Default,,0,0,0,,♪Менің ішім тоқ
Dialogue: 0,0:46:14.77,0:46:16.98,Default,,0,0,0,,♪Оре-сама, мен «Икусаға» бармаймын, бірақ
Dialogue: 0,0:46:17.10,0:46:20.44,Default,,0,0,0,,♪Көңіл-күйіңіз көтеріңкі болса, ертеңгі күнді күтіңіз
Dialogue: 0,0:46:20.56,0:46:21.86,Default,,0,0,0,,♪「･･〜」
Dialogue: 0,0:46:21.98,0:46:27.15,Default,,0,0,0,,♪Оны бермеңіз.
Dialogue: 0,0:46:27.28,0:46:29.95,Default,,0,0,0,,♪Аяғыңды маған бер
Dialogue: 0,0:46:30.07,0:46:32.74,Default,,0,0,0,,♪ Алға қарай жылдам алға.
Dialogue: 0,0:46:32.87,0:46:35.37,Default,,0,0,0,,♪ «Біреу маған бірдеңе сатып алсын!»
Dialogue: 0,0:46:35.54,0:46:38.17,Default,,0,0,0,,♪Джинсей но Джумон емес
Dialogue: 0,0:46:38.29,0:46:40.96,Default,,0,0,0,,♪ «Би Кон Нюға» жалғастырыңыз
Dialogue: 0,0:46:41.08,0:46:43.67,Default,,0,0,0,,♪Джинсей но Джумон
Dialogue: 0,0:46:43.80,0:46:46.51,Default,,0,0,0,,♪ «Би Кон Нюға» жалғастырыңыз
Dialogue: 0,0:46:46.63,0:46:48.26,Default,,0,0,0,,♪ «Алайда…»
Dialogue: 0,0:47:00.19,0:47:03.40,Default,,0,0,0,,♪Иә! Бір немесе екі Дожи но Казу
Dialogue: 0,0:47:03.52,0:47:08.20,Default,,0,0,0,,♪ 3 4 5 6 7 8 9
Dialogue: 0,0:47:08.32,0:47:09.61,Default,,0,0,0,,♪Ｈｏ〜!!
Dialogue: 0,0:47:09.74,0:47:12.41,Default,,0,0,0,,♪Егер санасаң, қиындай түседі
Dialogue: 0,0:47:12.53,0:47:15.24,Default,,0,0,0,,♪Каноджо мені көргенде, "Мен шошып кеттім!!"
Dialogue: 0,0:47:15.37,0:47:18.37,Default,,0,0,0,,♪Хай, ертең ғой, қайырлы таң!!
Dialogue: 0,0:47:18.50,0:47:20.62,Default,,0,0,0,,♪ Бұл аздап аздап аздап аздап аздап аздап біраз Йо!!
Dialogue: 0,0:47:20.75,0:47:25.50,Default,,0,0,0,,♪Қараңыз, “Онигири~”
Dialogue: 0,0:47:27.17,0:47:29.84,Default,,0,0,0,,♪Алхоры лосось Окакани Ментайко
Dialogue: 0,0:47:29.97,0:47:32.09,Default,,0,0,0,,♪Ибукуро Ника! Егер сіз сезсеңіз
Dialogue: 0,0:47:32.22,0:47:32.93,Default,,0,0,0,,♪ “Фуккатсу!!”
Dialogue: 0,0:47:33.05,0:47:35.39,Default,,0,0,0,,♪Ешқайда бара алмайтын кезде
Dialogue: 0,0:47:35.51,0:47:38.10,Default,,0,0,0,,♪Экираотчира Бұлай етпе
Dialogue: 0,0:47:38.23,0:47:40.85,Default,,0,0,0,,♪Егер сен бір орында тұрып қалсаң
Dialogue: 0,0:47:40.98,0:47:42.98,Default,,0,0,0,,♪ Кенет хабарлама пайда болды, мен басқа жаққа қараймын.
Dialogue: 0,0:47:43.11,0:47:45.11,Default,,0,0,0,,♪Дайсейкоу~!
Dialogue: 0,0:47:45.23,0:47:50.53,Default,,0,0,0,,♪Қызыл Шинго Сары Шинго
Dialogue: 0,0:47:50.65,0:47:53.20,Default,,0,0,0,,♪Аошингоу
Dialogue: 0,0:47:53.32,0:47:54.70,Default,,0,0,0,,♪Тоқта! Широ!
Dialogue: 0,0:47:54.83,0:47:57.49,Default,,0,0,0,,♪Ұсынылады~
Dialogue: 0,0:47:57.62,0:48:02.96,Default,,0,0,0,,♪Түсті көтермеймін, бірақ түс көтермеймін.
Dialogue: 0,0:48:03.08,0:48:05.59,Default,,0,0,0,,♪Оны бермеңіз
Dialogue: 0,0:48:05.71,0:48:08.30,Default,,0,0,0,,♪Дұрыс шикоу гарнир~
Dialogue: 0,0:48:08.42,0:48:09.88,Default,,0,0,0,,♪ «Кейде майлы болады».
Dialogue: 0,0:48:10.01,0:48:11.26,Default,,0,0,0,,♪ «Мен оны жегім келеді».
Dialogue: 0,0:48:11.38,0:48:13.97,Default,,0,0,0,,♪Джинсей но Джумон
Dialogue: 0,0:48:14.09,0:48:16.51,Default,,0,0,0,,♪«То Би Кон Ню» жалғастырыңыз
Dialogue: 0,0:48:16.85,0:48:19.43,Default,,0,0,0,,♪Әңгіме жалғасуда
Dialogue: 0,0:48:19.56,0:48:22.35,Default,,0,0,0,,♪ "То Би Кон Ню" әнін айту
Dialogue: 0,0:48:33.45,0:48:38.70,Default,,0,0,0,,♪Қайғы кетпейді.
Dialogue: 0,0:48:38.95,0:48:41.66,Default,,0,0,0,,♪ Донмай Донмай Донмай Донмай
