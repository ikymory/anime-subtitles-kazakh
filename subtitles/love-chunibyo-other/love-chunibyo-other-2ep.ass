Dialogue: 0,0:00:00.00,0:00:05.00,Default,,0000,0000,0000,,

Dialogue: 0,0:00:27.14,0:00:28.70,JPDB,,0000,0000,0000,,Не...мяу
Dialogue: 0,0:02:21.76,0:02:24.67,JPDB,,0000,0000,0000,,Әй, бұл жақсы сезінеді.
Dialogue: 0,0:02:26.51,0:02:29.19,JPDB,,0000,0000,0000,,Бұл сәл тереңірек, сондықтан сақ болыңыз.
Dialogue: 0,0:02:34.31,0:02:34.84,JPDB,,0000,0000,0000,,Жарайды
Dialogue: 0,0:02:35.28,0:02:35.63,JPDB,,0000,0000,0000,,Иә
Dialogue: 0,0:02:39.68,0:02:42.47,JPDB,,0000,0000,0000,,Қайда қарап тұрсыз? Адамдар қиыншылықта.
Dialogue: 0,0:02:42.67,0:02:43.63,JPDB,,0000,0000,0000,,Кешіріңіз, кешіріңіз
Dialogue: 0,0:02:44.55,0:02:46.22,JPDB,,0000,0000,0000,,Тогаши-кунның жынысы
Dialogue: 0,0:02:47.86,0:02:49.00,JPDB,,0000,0000,0000,,Тоқта!
Dialogue: 0,0:02:49.00,0:02:50.94,JPDB,,0000,0000,0000,,Тогаши-кунның жынысы
Dialogue: 0,0:02:52.06,0:02:53.23,JPDB,,0000,0000,0000,,Тоқта!
Dialogue: 0,0:02:53.23,0:02:54.65,JPDB,,0000,0000,0000,,Экхи
Dialogue: 0,0:02:54.65,0:02:56.61,JPDB,,0000,0000,0000,,О, тоқта.
Dialogue: 0,0:02:59.74,0:03:00.73,JPDB,,0000,0000,0000,,Тоқта
Dialogue: 0,0:03:05.51,0:03:06.97,JPDB,,0000,0000,0000,,Ақырында оралдыңыз ба?
Dialogue: 0,0:03:07.69,0:03:09.31,JPDB,,0000,0000,0000,,Бұл сіздің қолыңызда не?
Dialogue: 0,0:03:10.10,0:03:22.03,JPDB,,0000,0000,0000,,Хейрих Вассер Сиқырлы камерадағы қысымның жоғарылауы Энергияны толтыру 120%
Dialogue: 0,0:03:22.41,0:03:24.77,JPDB,,0000,0000,0000,,Бұл сіздің кінәңіз бе?
Dialogue: 0,0:03:26.19,0:03:27.20,JPDB,,0000,0000,0000,,Маңдайыңа не болды?
Dialogue: 0,0:03:28.22,0:03:29.02,JPDB,,0000,0000,0000,,Маңдай
Dialogue: 0,0:03:32.85,0:03:35.48,JPDB,,0000,0000,0000,,Кеше түнде шайқас болды және сол кезде
Dialogue: 0,0:03:36.18,0:03:38.99,JPDB,,0000,0000,0000,,Әй, жоқ, бұл туралы әлі білмеген жақсы...
Dialogue: 0,0:03:39.21,0:03:40.90,JPDB,,0000,0000,0000,,Chuunibyou қиын.
Dialogue: 0,0:03:44.73,0:03:45.50,JPDB,,0000,0000,0000,,Мысық па?
Dialogue: 0,0:03:45.65,0:03:46.86,JPDB,,0000,0000,0000,,Мияу
Dialogue: 0,0:03:48.16,0:03:49.05,JPDB,,0000,0000,0000,,Химера
Dialogue: 0,0:03:50.24,0:03:53.55,JPDB,,0000,0000,0000,,Бұл грек мифологиясынан алынған құбыжық немесе ойын болуы мүмкін.
Dialogue: 0,0:03:53.82,0:03:58.45,JPDB,,0000,0000,0000,,Иә, мен оны кеше түнде көрінбейтін шекара сызығын зерттеу кезінде кездестірдім.
Dialogue: 0,0:04:01.33,0:04:02.12,JPDB,,0000,0000,0000,,Оны алыңыз
Dialogue: 0,0:04:02.87,0:04:03.71,JPDB,,0000,0000,0000,,Сіз оны сақтауды жоспарлап отырсыз ба?
Dialogue: 0,0:04:04.44,0:04:07.00,JPDB,,0000,0000,0000,,Иә, оны таныс ретінде пайдаланыңыз.
Dialogue: 0,0:04:07.64,0:04:12.89,JPDB,,0000,0000,0000,,Қараңғылық әлеміндегі химералар көрінбейтін шекараны таба алатын күшке ие болуы керек.
Dialogue: 0,0:04:13.78,0:04:15.79,JPDB,,0000,0000,0000,,Бірақ бір мәселе бар.
Dialogue: 0,0:04:15.99,0:04:16.49,JPDB,,0000,0000,0000,,Не?
Dialogue: 0,0:04:16.86,0:04:19.70,JPDB,,0000,0000,0000,,Көрінбейтін шекараны басқару бюросының діни қызметкері
Dialogue: 0,0:04:19.70,0:04:22.83,JPDB,,0000,0000,0000,,Химераның сиқырлы күші шамадан тыс иммундық жауап тудырады.
Dialogue: 0,0:04:24.29,0:04:26.63,JPDB,,0000,0000,0000,,Сіздің әпкеңіздің мысықтарға аллергиясы бар ма?
Dialogue: 0,0:04:27.13,0:04:31.73,JPDB,,0000,0000,0000,,Сондықтан мен жерлесім, Қараңғы жалын иесінің ынтымақтастығын сұрадым...
Dialogue: 0,0:04:31.73,0:04:32.60,JPDB,,0000,0000,0000,,(Иносукэ) Эй! (Зэнитсу) Ұф…
Dialogue: 0,0:04:34.31,0:04:36.77,JPDB,,0000,0000,0000,,Орта мектеп басталғалы бір аптадай болды.
Dialogue: 0,0:04:37.72,0:04:39.65,JPDB,,0000,0000,0000,,Сізге көп рахмет.
Dialogue: 0,0:04:39.85,0:04:42.41,JPDB,,0000,0000,0000,,Ей, қараңғы жалын шебері
Dialogue: 0,0:04:43.03,0:04:45.00,JPDB,,0000,0000,0000,,Қараңғы жалын шебері
Dialogue: 0,0:04:45.17,0:04:46.49,JPDB,,0000,0000,0000,,Жарайды, осы ғана. Абай бол.
Dialogue: 0,0:04:47.31,0:04:49.45,JPDB,,0000,0000,0000,,Орта мектеп өмірімен таныс
Dialogue: 0,0:04:49.89,0:04:52.38,JPDB,,0000,0000,0000,,Мен бұл нағыз chuunibyou ауруымен күресуге дағдыландым.
Dialogue: 0,0:04:53.92,0:04:55.39,JPDB,,0000,0000,0000,,Юта
Dialogue: 0,0:04:55.64,0:04:56.41,JPDB,,0000,0000,0000,,(Иносукэ) Эй! (Зэнитсу) Ұф…
Dialogue: 0,0:04:56.90,0:05:02.27,JPDB,,0000,0000,0000,,Кузуха да, Юмеха да жануарларды жақсы көреді, сондықтан олардың анасы оларды кешіреді деп ойлаймын.
Dialogue: 0,0:05:02.89,0:05:05.01,JPDB,,0000,0000,0000,,Мен сені тыңдағанды ​​жек көремін.
Dialogue: 0,0:05:05.83,0:05:07.74,JPDB,,0000,0000,0000,,Юта — дөрекі
Dialogue: 0,0:05:09.13,0:05:11.32,JPDB,,0000,0000,0000,,Кейде Ютаның әкесі
Dialogue: 0,0:05:11.67,0:05:13.16,JPDB,,0000,0000,0000,,Джакартада жалғыз
Dialogue: 0,0:05:13.80,0:05:14.97,JPDB,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:05:16.74,0:05:20.04,JPDB,,0000,0000,0000,,Джакартаны білесіз бе? Бұл «картоп» сөзінің шығу тегі.
Dialogue: 0,0:05:15.97,0:05:19.12,JPDB,,0000,0000,0000,,Өткенімді әшкерелеуге жол бермеу үшін әлі де сақ болуым керек.
Dialogue: 0,0:05:20.07,0:05:23.94,JPDB,,0000,0000,0000,,Кем дегенде, әзірге ештеңе дұрыс емес және мен сыныпқа араласып жатырмын.
Dialogue: 0,0:05:23.30,0:05:27.18,JPDB,,0000,0000,0000,,Сондықтан мен Хираката мырзадан кітапханашы болуды сұрауды жөн көрдім.
Dialogue: 0,0:05:27.85,0:05:32.87,JPDB,,0000,0000,0000,,​​Әйтсе де, ойнақы болған Исшикидің оны ұсынып, төраға етіп қоюы қате есеп болды.
Dialogue: 0,0:05:33.56,0:05:36.12,JPDB,,0000,0000,0000,,Бұл да нәтиже.
Dialogue: 0,0:05:36.79,0:05:38.71,JPDB,,0000,0000,0000,,Міне, солай.
Dialogue: 0,0:05:39.48,0:05:44.27,JPDB,,0000,0000,0000,,Иә, еңбегіңіз үшін рахмет. Үй бөлмесі бітті.
Dialogue: 0,0:05:44.75,0:05:47.36,JPDB,,0000,0000,0000,,Еңбегіңізге рахмет, төраға.
Dialogue: 0,0:05:47.48,0:05:48.67,JPDB,,0000,0000,0000,,Қай ауыз сөйлейді
Dialogue: 0,0:05:48.87,0:05:52.30,JPDB,,0000,0000,0000,,Одан гөрі кімге дауыс беруді шештіңіз бе?
Dialogue: 0,0:05:52.55,0:05:54.02,JPDB,,0000,0000,0000,,Мен оны қорытындылағым келеді.
Dialogue: 0,0:05:54.34,0:05:54.96,JPDB,,0000,0000,0000,,Дауыс беру керек пе?
Dialogue: 0,0:05:55.83,0:05:57.65,JPDB,,0000,0000,0000,,Бұл «Сүйкімді қыздар чемпионаты»
Dialogue: 0,0:05:57.80,0:06:01.62,JPDB,,0000,0000,0000,,Мен айттым ғой, сыныптағы бірінші қызды ұлдар дауыс беру арқылы анықтайды.
Dialogue: 0,0:06:02.10,0:06:02.77,JPDB,,0000,0000,0000,,Кімге
Dialogue: 0,0:06:04.31,0:06:08.18,JPDB,,0000,0000,0000,,Жарайды ма? Солай істеп ұсталсаң қыздардың ашуы шығады.
Dialogue: 0,0:06:08.63,0:06:10.00,JPDB,,0000,0000,0000,,Білмеді, табылмады
Dialogue: 0,0:06:10.05,0:06:13.28,JPDB,,0000,0000,0000,,Мұндай кезде адамдар арасындағы байланыс тастан да күшті болады.
Dialogue: 0,0:06:13.50,0:06:14.20,JPDB,,0000,0000,0000,,Тоғаши мырза
Dialogue: 0,0:06:14.32,0:06:15.14,JPDB,,0000,0000,0000,,(Бас редактор) Таңырқап қарап тұрма, материалдарды жина.
Dialogue: 0,0:06:16.39,0:06:18.13,JPDB,,0000,0000,0000,,Ғылым бөлмесі: Түскі үзіліс жақсы.
Dialogue: 0,0:06:19.59,0:06:22.62,JPDB,,0000,0000,0000,,Жаратылыстану пәнінің мұғалімі жабдықты тексеруді сұраған шығар.
Dialogue: 0,0:06:24.51,0:06:28.66,JPDB,,0000,0000,0000,,Жеті сегіз тоғыз он он екі
Dialogue: 0,0:06:29.26,0:06:33.46,JPDB,,0000,0000,0000,,Он екі... Иә, бұл кезеңнің соңы.
Dialogue: 0,0:06:35.60,0:06:38.43,JPDB,,0000,0000,0000,,Бұл хош иіс «азиялық» немесе «Видаль Сасун» ба?
Dialogue: 0,0:06:38.80,0:06:40.59,JPDB,,0000,0000,0000,,Сынып мүшелеріне үйреніп қалдыңыз ба?
Dialogue: 0,0:06:41.44,0:06:44.07,JPDB,,0000,0000,0000,,Иә, мен оны әлі түсінбеймін.
Dialogue: 0,0:06:45.24,0:06:47.53,JPDB,,0000,0000,0000,,Егер бірдеңе байқасаңыз, маған хабарлаңыз.
Dialogue: 0,0:06:48.22,0:06:51.03,JPDB,,0000,0000,0000,,Мен көп нәрсені ұмытып кетемін.
Dialogue: 0,0:06:51.68,0:06:54.79,JPDB,,0000,0000,0000,,Менің ойымша, бұл мүлдем ұқсамайтын болса да.
Dialogue: 0,0:06:55.31,0:06:58.37,JPDB,,0000,0000,0000,,Мен өзімді ондай емес деп көрсетуге тырысамын.
Dialogue: 0,0:06:59.36,0:07:00.78,JPDB,,0000,0000,0000,,Мен бәрібір төрағамын.
Dialogue: 0,0:07:03.19,0:07:06.64,JPDB,,0000,0000,0000,,Ал... Түсінемін, сіз сабырлы сияқтысыз.
Dialogue: 0,0:07:07.51,0:07:09.55,JPDB,,0000,0000,0000,,Сіз көп рет төраға болғаныңызға сенімдімін.
Dialogue: 0,0:07:10.57,0:07:13.38,JPDB,,0000,0000,0000,,Жақсы, бірақ бұл ұсынылды.
Dialogue: 0,0:07:13.97,0:07:16.04,JPDB,,0000,0000,0000,,Тогаши-кун да аз болуы керек.
Dialogue: 0,0:07:16.36,0:07:21.78,JPDB,,0000,0000,0000,,Мен? Жоқ, мен мұны бастауыш мектепте оқып жүргенімде бір рет жасадым деп ойлаймын.
Dialogue: 0,0:07:22.30,0:07:24.71,JPDB,,0000,0000,0000,,Егер бірдеңе болса, ол азырақ байқалады.
Dialogue: 0,0:07:25.36,0:07:30.00,JPDB,,0000,0000,0000,,Шынымен бе? Екеуміз алғаш танысқанда өте ұқсас екенбіз деп ойладым.
Dialogue: 0,0:07:30.58,0:07:33.66,JPDB,,0000,0000,0000,,Қараңызшы, біз кіру салтанаты күні вокзалда кездестік.
Dialogue: 0,0:07:43.65,0:07:44.42,JPDB,,0000,0000,0000,,Есіңізде ме?
Dialogue: 0,0:07:45.31,0:07:47.23,JPDB,,0000,0000,0000,,Неліктен бұл анық емес?
Dialogue: 0,0:07:47.68,0:07:52.05,JPDB,,0000,0000,0000,,Жоқ, бірақ мен өз сыныбымды немесе есімімді әлі білмедім.
Dialogue: 0,0:07:52.80,0:07:57.29,JPDB,,0000,0000,0000,,Мен оны сабаққа киіп, Тоғаши-кунды көргенде, мен: ''А, бұл ол!'' деп ойладым.
Dialogue: 0,0:07:57.54,0:07:59.01,JPDB,,0000,0000,0000,,Дұрыс...
Dialogue: 0,0:07:59.78,0:08:03.16,JPDB,,0000,0000,0000,,Тынышталыңыз, әлі үрейленетін уақыт емес.
Dialogue: 0,0:08:05.12,0:08:08.45,JPDB,,0000,0000,0000,,Бірақ, кем дегенде, бұл сіздің бұл туралы ренжімейтініңізді білдіреді.
Dialogue: 0,0:08:10.47,0:08:14.27,JPDB,,0000,0000,0000,,Ол келе ме? Менің артқы кеңеюім
Dialogue: 0,0:08:14.97,0:08:16.90,JPDB,,0000,0000,0000,,Ал, қалғаны ертең.
Dialogue: 0,0:08:17.23,0:08:19.84,JPDB,,0000,0000,0000,,Мен сізді шақыруым керек пе? «Менімен үйге барғың келе ме?»
Dialogue: 0,0:08:20.06,0:08:24.36,JPDB,,0000,0000,0000,,Жоқ, күте тұрыңыз, бұл модельдеу. Реакцияны болжау.
Dialogue: 0,0:08:26.47,0:08:27.79,JPDB,,0000,0000,0000,,Менімен бірге үйге барғың келе ме?
Dialogue: 0,0:08:29.21,0:08:29.79,JPDB,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:08:31.52,0:08:32.24,JPDB,,0000,0000,0000,,Қолымнан келгеннің бәрін жасадым
Dialogue: 0,0:08:33.51,0:08:34.75,JPDB,,0000,0000,0000,,Не болды, Тоғаши-кун?
Dialogue: 0,0:08:35.42,0:08:38.48,JPDB,,0000,0000,0000,,Жоқ...жоқ, бұл ештеңе емес. Бұл оқиға туралы.
Dialogue: 0,0:08:39.65,0:08:40.42,JPDB,,0000,0000,0000,,Тоғаши мырза
Dialogue: 0,0:08:40.42,0:08:42.43,JPDB,,0000,0000,0000,,Нанана...не?
Dialogue: 0,0:08:44.52,0:08:46.21,JPDB,,0000,0000,0000,,Біз финалға өте алмадық—
Dialogue: 0,0:08:46.41,0:08:49.51,JPDB,,0000,0000,0000,,Сіз бе? Әлде сен бе?
Dialogue: 0,0:08:49.51,0:08:51.60,JPDB,,0000,0000,0000,,Ютаның көзі айналады
Dialogue: 0,0:08:51.60,0:08:52.67,JPDB,,0000,0000,0000,,Kotoriyu-san?
Dialogue: 0,0:08:52.84,0:08:54.56,JPDB,,0000,0000,0000,,Неге мұндасың?
Dialogue: 0,0:08:54.91,0:08:56.35,JPDB,,0000,0000,0000,,Мұғалімнің қалауы бойынша
Dialogue: 0,0:08:57.62,0:08:59.58,JPDB,,0000,0000,0000,,Бұл жігіттің айтқанын елемеуге болады.
Dialogue: 0,0:09:00.65,0:09:06.36,JPDB,,0000,0000,0000,,Бұл мектепте есірткінің түрі бар ма? Әкімшілік бюроның тергеуі осы уақытқа дейін жетті ме?
Dialogue: 0,0:09:07.36,0:09:10.89,JPDB,,0000,0000,0000,,Болды, ақ халатыңды шеш. Бұл сен емессің.
Dialogue: 0,0:09:11.19,0:09:11.71,JPDB,,0000,0000,0000,,Оны шешіңіз бе?
Dialogue: 0,0:09:11.98,0:09:13.87,JPDB,,0000,0000,0000,,О, қазір шешіп таста.
Dialogue: 0,0:09:14.44,0:09:16.23,JPDB,,0000,0000,0000,,Мен... қазір шешіп алам...
Dialogue: 0,0:09:16.63,0:09:20.36,JPDB,,0000,0000,0000,,Бұл әдейі жасалды. Рұқсатсыз дәрімен араласпаңыз.
Dialogue: 0,0:09:20.63,0:09:24.13,JPDB,,0000,0000,0000,,Өкінішке орай, химералар нақты әлемде аман қалу үшін,
Dialogue: 0,0:09:24.26,0:09:25.65,JPDB,,0000,0000,0000,,Сиқырлы күш жеткіліксіз
Dialogue: 0,0:09:25.97,0:09:29.43,JPDB,,0000,0000,0000,,Жасанды түрде жасалуы және қамтамасыз етілуі қажет
Dialogue: 0,0:09:29.63,0:09:30.47,JPDB,,0000,0000,0000,,Химера?
Dialogue: 0,0:09:30.67,0:09:32.19,JPDB,,0000,0000,0000,,О, бұл туралы алаңдамаңыз.
Dialogue: 0,0:09:32.91,0:09:35.64,JPDB,,0000,0000,0000,,Бұл маңдайында осы өрнекті сұр мысық.
Dialogue: 0,0:09:36.64,0:09:39.32,JPDB,,0000,0000,0000,,Котори мырза оны кеше алғанын айтты.
Dialogue: 0,0:09:39.79,0:09:41.93,JPDB,,0000,0000,0000,,Которию орнына Риккамен бірге
Dialogue: 0,0:09:42.65,0:09:45.96,JPDB,,0000,0000,0000,,Сұр мысық Бұл туралы айтатын болсақ
Dialogue: 0,0:09:48.96,0:09:50.85,JPDB,,0000,0000,0000,,Не, шынымен Додомен?
Dialogue: 0,0:09:51.30,0:09:55.82,JPDB,,0000,0000,0000,,Бұл әртүрлі болуы мүмкін, бірақ мұнда сипатталған сипаттамалар жалпы сәйкес келеді.
Dialogue: 0,0:09:56.69,0:09:59.78,JPDB,,0000,0000,0000,,Көлемі шамамен осы, ал бөксесі мынадай.
Dialogue: 0,0:10:00.52,0:10:01.91,JPDB,,0000,0000,0000,,Менің арқамда қанаттар бар...
Dialogue: 0,0:10:02.16,0:10:02.93,JPDB,,0000,0000,0000,,Өспейді
Dialogue: 0,0:10:04.80,0:10:08.03,JPDB,,0000,0000,0000,,Менің мысығым да солай болғанына сенімдімін.
Dialogue: 0,0:10:08.38,0:10:09.05,JPDB,,0000,0000,0000,,Қанаттар?
Dialogue: 0,0:10:09.47,0:10:10.54,JPDB,,0000,0000,0000,,Жарайды, үндеме.
Dialogue: 0,0:10:12.05,0:10:13.45,JPDB,,0000,0000,0000,,Қашан жоғалып кеттің?
Dialogue: 0,0:10:15.56,0:10:17.22,JPDB,,0000,0000,0000,,Шамамен бір апта бұрын
Dialogue: 0,0:10:17.72,0:10:18.64,JPDB,,0000,0000,0000,,Сен оны көруге келесің бе?
Dialogue: 0,0:10:18.99,0:10:19.76,JPDB,,0000,0000,0000,,Та-да!
Dialogue: 0,0:10:20.11,0:10:20.75,JPDB,,0000,0000,0000,,Иә
Dialogue: 0,0:10:22.09,0:10:25.08,JPDB,,0000,0000,0000,,Ум, 7 мамыр Сенпай?
Dialogue: 0,0:10:26.02,0:10:27.99,JPDB,,0000,0000,0000,,Сондықтан ол «Цююри» деп айтылады.
Dialogue: 0,0:10:28.63,0:10:31.12,JPDB,,0000,0000,0000,,Менің атым Хисатами 7 мамыр. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:10:31.64,0:10:34.25,JPDB,,0000,0000,0000,,А, м, бұл Юта Тогаши.
Dialogue: 0,0:10:35.69,0:10:36.25,JPDB,,0000,0000,0000,,Сүннет
Dialogue: 0,0:10:41.26,0:10:44.66,JPDB,,0000,0000,0000,,Менің үйім екінші қабатта, ал Kotoriyu үйі оның үстінде.
Dialogue: 0,0:10:45.13,0:10:45.98,JPDB,,0000,0000,0000,,Риккамен бірге
Dialogue: 0,0:10:46.18,0:10:46.87,JPDB,,0000,0000,0000,,Жарайды, осы ғана. Абай бол.
Dialogue: 0,0:10:47.55,0:10:51.00,JPDB,,0000,0000,0000,,Біз жақсы достармыз, бала кезіміздегі достармыз немесе бір нәрсеміз.
Dialogue: 0,0:10:51.25,0:10:54.83,JPDB,,0000,0000,0000,,Жоқ, Котори мырза кеше ғана осында көшіп келді.
Dialogue: 0,0:11:01.54,0:11:02.96,JPDB,,0000,0000,0000,,Сиқырлы кодты шығару
Dialogue: 0,0:11:04.84,0:11:06.14,JPDB,,0000,0000,0000,,Жарайды, тез ашыңыз.
Dialogue: 0,0:11:12.57,0:11:14.79,JPDB,,0000,0000,0000,,Ашық Ол ақырында ашылды.
Dialogue: 0,0:11:14.91,0:11:16.35,JPDB,,0000,0000,0000,,Бұл қиын нәрсе.
Dialogue: 0,0:11:16.87,0:11:21.50,JPDB,,0000,0000,0000,,Сәл күте тұрыңыз, мен сіздің бөлмеңізде қандай да бір ауытқушылық бар-жоғын тексеремін.
Dialogue: 0,0:11:23.16,0:11:25.95,JPDB,,0000,0000,0000,,Кенеттен кіріп кеткеніме менің кінәм болды.
Dialogue: 0,0:11:26.09,0:11:27.34,JPDB,,0000,0000,0000,,Өйткені ол қыз
Dialogue: 0,0:11:28.16,0:11:28.85,JPDB,,0000,0000,0000,,Сіз кіре аласыз.
Dialogue: 0,0:11:29.80,0:11:31.26,JPDB,,0000,0000,0000,,(Кёко Хори) Иә, әлі де өзімді жақсы сезінбеймін.
Dialogue: 0,0:11:32.36,0:11:33.65,JPDB,,0000,0000,0000,,Бұл таңқаларлық
Dialogue: 0,0:11:38.02,0:11:43.19,JPDB,,0000,0000,0000,,Қараңғы жаққа қош келдіңіз Хаотикалық хаосқа қош келдіңіз
Dialogue: 0,0:11:43.87,0:11:45.53,JPDB,,0000,0000,0000,,Бұл мағынасы бар.
Dialogue: 0,0:11:47.69,0:11:50.35,JPDB,,0000,0000,0000,,Менің ойымша, сізге сүйкімді тұлыптар ұнайды.
Dialogue: 0,0:11:50.53,0:11:52.41,JPDB,,0000,0000,0000,,Ол бала солтүстікті қорғайтын Генбу.
Dialogue: 0,0:11:54.68,0:11:56.27,JPDB,,0000,0000,0000,,Маузер әскери
Dialogue: 0,0:11:56.86,0:11:58.88,JPDB,,0000,0000,0000,,Сізде таңқаларлық жақсы хобби бар.
Dialogue: 0,0:11:59.87,0:12:02.31,JPDB,,0000,0000,0000,,Жындарды жоя алатын қасиетті мылтық
Dialogue: 0,0:12:02.70,0:12:06.16,JPDB,,0000,0000,0000,,Мен осылай сезінемін. Маған көрсетіңізші.
Dialogue: 0,0:12:06.58,0:12:07.20,JPDB,,0000,0000,0000,,(Ер адам) Аа… тоқта… Уа! (Әйелдің айқайы)
Dialogue: 0,0:12:09.42,0:12:11.48,JPDB,,0000,0000,0000,,Бұл өте керемет, Маузер.
Dialogue: 0,0:12:16.77,0:12:21.89,JPDB,,0000,0000,0000,,А... бұл мылтық шын мәнінде жүз жылдан астам бұрын жасалған таңғажайып мылтық.
Dialogue: 0,0:12:21.89,0:12:25.55,JPDB,,0000,0000,0000,,Жоқ, бұл M712 деп аталатын түрі.
Dialogue: 0,0:12:25.67,0:12:28.43,JPDB,,0000,0000,0000,,Тогаши-кун, саған ондай нәрсе ұнайды.
Dialogue: 0,0:12:29.55,0:12:30.09,JPDB,,0000,0000,0000,,Айтпақшы
Dialogue: 0,0:12:30.09,0:12:34.87,JPDB,,0000,0000,0000,,Бұл бөлмедегі барлық нысандар астрологияға сәйкес орналастырылған.
Dialogue: 0,0:12:35.21,0:12:38.77,JPDB,,0000,0000,0000,,Оны жылжытуға қатаң тыйым салынады, сондықтан оны тазалаудың қажеті жоқ.
Dialogue: 0,0:12:43.91,0:12:44.78,JPDB,,0000,0000,0000,,Іске қосу
Dialogue: 0,0:12:45.58,0:12:47.09,JPDB,,0000,0000,0000,,Сонымен мысық
Dialogue: 0,0:12:47.74,0:12:50.52,JPDB,,0000,0000,0000,,Көпшілікке көрінбейтін шаралар қабылданды.
Dialogue: 0,0:12:51.42,0:12:53.41,JPDB,,0000,0000,0000,,Сен менің ағамсың, сондықтан құрметті тілмен айт.
Dialogue: 0,0:12:54.10,0:12:55.41,JPDB,,0000,0000,0000,,Жер
Dialogue: 0,0:12:59.50,0:13:01.19,JPDB,,0000,0000,0000,,Сіз бөлмеге араластыңыз.
Dialogue: 0,0:13:01.46,0:13:02.85,JPDB,,0000,0000,0000,,Сіз мұны көре аласыз ба?
Dialogue: 0,0:13:03.17,0:13:04.85,JPDB,,0000,0000,0000,,Істі қиындатпаңыз
Dialogue: 0,0:13:05.93,0:13:06.63,JPDB,,0000,0000,0000,,Сіз қалай ойлайсыз?
Dialogue: 0,0:13:08.52,0:13:12.05,JPDB,,0000,0000,0000,,Өкінішке орай, ол басқа адам сияқты. Оның сақалының пішіні әртүрлі.
Dialogue: 0,0:13:12.37,0:13:13.14,JPDB,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:13:15.97,0:13:16.82,JPDB,,0000,0000,0000,,Бұл кімнің мысығы?
Dialogue: 0,0:13:17.81,0:13:18.06,JPDB,,0000,0000,0000,,Иә?
Dialogue: 0,0:13:22.81,0:13:23.56,JPDB,,0000,0000,0000,,Кімнің?
Dialogue: 0,0:13:32.75,0:13:33.79,JPDB,,0000,0000,0000,,Бұл кімнің мысығы?
Dialogue: 0,0:13:37.00,0:13:41.15,JPDB,,0000,0000,0000,,Құпия қалқаны жабу Радиациядан қорғайтын қабырғаға су бүрку
Dialogue: 0,0:13:42.34,0:13:43.44,JPDB,,0000,0000,0000,,Барлық мүшелер қашып кетеді
Dialogue: 0,0:13:43.54,0:13:44.28,JPDB,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:13:56.64,0:13:57.48,JPDB,,0000,0000,0000,,Менің бөлмем
Dialogue: 0,0:14:02.73,0:14:04.59,JPDB,,0000,0000,0000,,Сіз біреудің бөлмесінде не істеп жатырсыз?
Dialogue: 0,0:14:04.74,0:14:05.76,JPDB,,0000,0000,0000,,Жақында аяқталады
Dialogue: 0,0:14:06.63,0:14:07.94,JPDB,,0000,0000,0000,,Мүмкін дуэль
Dialogue: 0,0:14:08.24,0:14:09.66,JPDB,,0000,0000,0000,,Көңіліңізді көтермеңіз
Dialogue: 0,0:14:10.28,0:14:18.86,JPDB,,0000,0000,0000,,Бір күні еңсеру керек қабырға, Шварц атыс толығымен ашылды
Dialogue: 0,0:14:38.47,0:14:41.12,JPDB,,0000,0000,0000,,«Avalon Smash»
Dialogue: 0,0:14:48.06,0:14:49.13,JPDB,,0000,0000,0000,,Юта Тогаши.
Dialogue: 0,0:14:51.19,0:14:56.46,JPDB,,0000,0000,0000,,Мен Тока Коториюмын. Мен бұл жігіттің әпкесімін. Менің айтайын деген әңгімем бар.
Dialogue: 0,0:14:59.04,0:15:03.64,JPDB,,0000,0000,0000,,Бұл «Жау Шинген» немесе басқа нәрсе ме, білмеймін, бірақ ол орта мектептен бері мүлде өзгерген жоқ.
Dialogue: 0,0:15:04.14,0:15:05.06,JPDB,,0000,0000,0000,,Онда адамдар бар. Екеуі.
Dialogue: 0,0:15:06.35,0:15:08.69,JPDB,,0000,0000,0000,,Ал менде мысықтың анергиясы бар.
Dialogue: 0,0:15:09.14,0:15:11.07,JPDB,,0000,0000,0000,,Кез келген нәрсеге келгенде, мен оны бірден аламын.
Dialogue: 0,0:15:11.40,0:15:15.05,JPDB,,0000,0000,0000,,Қолайсыздық үшін кешіріңіз, бірақ сізден бір нәрсе сұрасам болады ма?
Dialogue: 0,0:15:15.05,0:15:15.42,JPDB,,0000,0000,0000,,Ах
Dialogue: 0,0:15:16.02,0:15:20.05,JPDB,,0000,0000,0000,,Бұл мысық. Маған тимеңіз. Бұл туралы бірдеңе істегеніңізді қалаймын.
Dialogue: 0,0:15:20.62,0:15:23.58,JPDB,,0000,0000,0000,,Оны тастайсың ба, әлде біреуге бересің бе, бәрібір.
Dialogue: 0,0:15:23.97,0:15:26.24,JPDB,,0000,0000,0000,,Мен оны мұнда қоя алмаймын. Міне бітті.
Dialogue: 0,0:15:26.51,0:15:29.79,JPDB,,0000,0000,0000,,Жоқ, бірақ мен...
Dialogue: 0,0:15:30.31,0:15:30.83,JPDB,,0000,0000,0000,,Сіз оны жек көресіз бе?
Dialogue: 0,0:15:31.31,0:15:32.55,JPDB,,0000,0000,0000,,Дәлірек айтқанда, бұл маған ұнамайды.
Dialogue: 0,0:15:34.04,0:15:34.76,JPDB,,0000,0000,0000,,Олай болса, өтінемін
Dialogue: 0,0:15:36.43,0:15:37.05,JPDB,,0000,0000,0000,,Бірақ
Dialogue: 0,0:15:38.02,0:15:40.87,JPDB,,0000,0000,0000,,Бұл дыбыс жазу құрылғысы екі жыл бұрын орнатылған.
Dialogue: 0,0:15:41.07,0:15:43.41,JPDB,,0000,0000,0000,,Бұл тұрғын үй кешенінің балконында жазылған.
Dialogue: 0,0:15:49.45,0:15:52.26,JPDB,,0000,0000,0000,,Бұл пьеса да, арман да емес
Dialogue: 0,0:15:52.75,0:15:58.74,JPDB,,0000,0000,0000,,2012 жылы бұл әлем Майя пайғамбарлықтарына сәйкес қараңғылық әлеміне тартылады.
Dialogue: 0,0:15:57.05,0:15:58.74,JPDB,,0000,0000,0000,,Тоғаши-кун, не болды?
Dialogue: 0,0:15:59.04,0:16:00.36,JPDB,,0000,0000,0000,,Бауырым, не болды?
Dialogue: 0,0:16:00.36,0:16:04.06,JPDB,,0000,0000,0000,,Менің ағам емес. Менің атым Қараңғы жалын шебері.
Dialogue: 0,0:16:04.78,0:16:08.98,JPDB,,0000,0000,0000,,Қараңғылық отын пайдаланып, бұл дүниені өртеп жіберген.
Dialogue: 0,0:16:07.07,0:16:08.49,JPDB,,0000,0000,0000,,Бұл Тоғашидың дауысы ма?
Dialogue: 0,0:16:11.00,0:16:17.87,JPDB,,0000,0000,0000,,Тоқта, тоқта, тоқта. Мен мұны естігім келмейді. Мен мұны естігім келмейді.
Dialogue: 0,0:16:12.99,0:16:14.53,JPDB,,0000,0000,0000,,Бүгін жел шулы.
Dialogue: 0,0:16:15.07,0:16:18.70,JPDB,,0000,0000,0000,,Сіз не туралы айтып отырсыз? Жел соқпайды.
Dialogue: 0,0:16:18.68,0:16:21.88,JPDB,,0000,0000,0000,,Менің күшім артып келеді.
Dialogue: 0,0:16:23.05,0:16:27.20,JPDB,,0000,0000,0000,,Бұлай қатты шулама, бәрі күліп жатыр.
Dialogue: 0,0:16:28.17,0:16:33.54,JPDB,,0000,0000,0000,,Ақымақ күлсін, сүйікті қарындасым.
Dialogue: 0,0:16:34.09,0:16:35.33,JPDB,,0000,0000,0000,,Маған орнатылған тыңшылық құрылғыдан басқа, осы бөлмеде ештеңе жоқ
Dialogue: 0,0:16:35.33,0:16:36.20,JPDB,,0000,0000,0000,,Менің ағамнан...
Dialogue: 0,0:16:28.74,0:16:32.07,JPDB,,0000,0000,0000,,Менің хоббиім - қызықты бейне сайттарында жариялау.
Dialogue: 0,0:16:33.59,0:16:34.07,JPDB,,0000,0000,0000,,Кимоноым шаңмен кірленді.
Dialogue: 0,0:16:35.78,0:16:36.20,JPDB,,0000,0000,0000,,Иә
Dialogue: 0,0:16:40.10,0:16:40.85,JPDB,,0000,0000,0000,,Сіз қашып кеттіңіз бе?
Dialogue: 0,0:16:54.44,0:16:57.80,JPDB,,0000,0000,0000,,Әке, ана, өтінемін, мені кешіре гөр.
Dialogue: 0,0:16:58.57,0:17:01.87,JPDB,,0000,0000,0000,,Тоғаши-күн, менімен бірге ақырзаманға қашайық.
Dialogue: 0,0:17:02.27,0:17:03.54,JPDB,,0000,0000,0000,,Мен байсалдымын.
Dialogue: 0,0:17:04.06,0:17:09.03,JPDB,,0000,0000,0000,,Дүниенің ақыры осында. Жер дөңгелек.
Dialogue: 0,0:17:09.85,0:17:12.46,JPDB,,0000,0000,0000,,Сіз не істеп жатырсыз? Тока-сан ашуланды.
Dialogue: 0,0:17:12.83,0:17:16.66,JPDB,,0000,0000,0000,,Тез қашыңыз, ол басқару бюросының бірінші дәрежелі діни қызметкері.
Dialogue: 0,0:17:17.43,0:17:19.30,JPDB,,0000,0000,0000,,Бұл күш керемет
Dialogue: 0,0:17:28.59,0:17:34.78,JPDB,,0000,0000,0000,,Сіз барлық жаңа қанды қанды түрме ретінде тізбекті құрбандық ретінде ұсынасыз
Dialogue: 0,0:17:35.48,0:17:36.78,JPDB,,0000,0000,0000,,Сіз тамаша жұмыс жасадыңыз.
Dialogue: 0,0:17:37.74,0:17:41.39,JPDB,,0000,0000,0000,,Лездік қозғалысты басқаратын қорқынышты қабілет
Dialogue: 0,0:17:41.39,0:17:43.65,JPDB,,0000,0000,0000,,Мүмкін сіз жай ғана ақымақ болған шығарсыз.
Dialogue: 0,0:17:46.09,0:17:46.79,JPDB,,0000,0000,0000,,Ол қазірдің өзінде осында
Dialogue: 0,0:17:47.16,0:17:50.07,JPDB,,0000,0000,0000,,Бұл қорқынышты фильм сияқты қызықты.
Dialogue: 0,0:17:50.31,0:17:51.71,JPDB,,0000,0000,0000,,Бұл қызық емес
Dialogue: 0,0:17:55.46,0:17:56.68,JPDB,,0000,0000,0000,,Дәл қазір бір нәрсе жарқ етті.
Dialogue: 0,0:17:59.11,0:18:00.06,JPDB,,0000,0000,0000,,7 мамыр
Dialogue: 0,0:18:01.97,0:18:03.07,JPDB,,0000,0000,0000,,Юта асығыңыз
Dialogue: 0,0:18:12.09,0:18:15.37,JPDB,,0000,0000,0000,,Әйтеуір өз өміріме қауіп төніп тұрғандай сезінемін.
Dialogue: 0,0:18:15.67,0:18:19.79,JPDB,,0000,0000,0000,,Өкінішке орай, қазірге дейін менде Священниені жеңуге мүмкіндік жоқ.
Dialogue: 0,0:18:20.54,0:18:23.35,JPDB,,0000,0000,0000,,Бірақ қарсыласты біз ақырында жеңуіміз керек
Dialogue: 0,0:18:25.11,0:18:26.28,JPDB,,0000,0000,0000,,Мынаны алып, әрі қарай жүріңіз
Dialogue: 0,0:18:27.57,0:18:30.21,JPDB,,0000,0000,0000,,Осы шайқас біткен соң, бірге өмір сүрейік.
Dialogue: 0,0:18:30.50,0:18:32.29,JPDB,,0000,0000,0000,,Өлім жалауын көтермеңіз.
Dialogue: 0,0:18:32.96,0:18:37.59,JPDB,,0000,0000,0000,,Юта, тез қаш, мен сені осы жерден тоқтатамын, сондықтан сен бірінші жүр.
Dialogue: 0,0:18:39.68,0:18:44.02,JPDB,,0000,0000,0000,,Мен көрінбейтін шекараны табуым керек
Dialogue: 0,0:18:46.68,0:18:47.45,JPDB,,0000,0000,0000,,Kotoriyu
Dialogue: 0,0:18:49.37,0:18:50.39,JPDB,,0000,0000,0000,,Мені Рикка деп атаңыз
Dialogue: 0,0:18:51.58,0:18:52.35,JPDB,,0000,0000,0000,,Жоқ, бұл химера.
Dialogue: 0,0:18:55.26,0:18:56.00,JPDB,,0000,0000,0000,,Онда?
Dialogue: 0,0:18:56.40,0:18:58.89,JPDB,,0000,0000,0000,,Мен химера Ютаға тартамын
Dialogue: 0,0:19:01.80,0:19:05.47,JPDB,,0000,0000,0000,,Келіңіздер, Schwarzzechs Prototype Mk-II
Dialogue: 0,0:19:06.79,0:19:09.53,JPDB,,0000,0000,0000,,Жарылсын, шын, жарылсын, синапс
Dialogue: 0,0:19:09.80,0:19:12.95,JPDB,,0000,0000,0000,,Бұл әлемді қуу
Dialogue: 0,0:19:19.81,0:19:23.37,JPDB,,0000,0000,0000,,Қан келісімі бойынша мен сені шақырамын.
Dialogue: 0,0:19:29.58,0:19:31.47,JPDB,,0000,0000,0000,,«Конингин дер Нахт»
Dialogue: 0,0:19:47.20,0:19:48.77,JPDB,,0000,0000,0000,,“Қараңғы заттың жалыны”
Dialogue: 0,0:20:04.95,0:20:09.35,JPDB,,0000,0000,0000,,Kotoriyu Күтпеген жерден...Итеру
Dialogue: 0,0:20:10.07,0:20:11.46,JPDB,,0000,0000,0000,,«Нергал жарылысы»
Dialogue: 0,0:20:17.85,0:20:18.97,JPDB,,0000,0000,0000,,Сәттілік Kotoriyu
Dialogue: 0,0:20:19.46,0:20:22.02,JPDB,,0000,0000,0000,,«Кантикула»
Dialogue: 0,0:20:33.41,0:20:34.73,JPDB,,0000,0000,0000,,Сабыр етіңіз.
Dialogue: 0,0:20:41.11,0:20:42.75,JPDB,,0000,0000,0000,,Алдануыңызды барынша азайтыңыз
Dialogue: 0,0:20:45.54,0:20:49.22,JPDB,,0000,0000,0000,,Қалай болғанда да, мысықты кіргізбе. Мен оған бұл жолы үзіліс беремін.
Dialogue: 0,0:20:50.61,0:20:51.48,JPDB,,0000,0000,0000,,(Қол Перісі) Құтқарып болмайды… Соңғы көргенім – демон өлтірушінің жүзі болар деп кім ойлаған…
Dialogue: 0,0:20:54.09,0:20:54.93,JPDB,,0000,0000,0000,,Оны қойыңыз
Dialogue: 0,0:21:00.70,0:21:05.94,JPDB,,0000,0000,0000,,Бұл біртүрлі. Мен «кантикула» толығымен шешілді деп ойладым, бірақ неге?
Dialogue: 0,0:21:06.61,0:21:08.50,JPDB,,0000,0000,0000,,Сіздің ойыңызда емес
Dialogue: 0,0:21:14.69,0:21:16.03,JPDB,,0000,0000,0000,,Әлі де қышиды
Dialogue: 0,0:21:20.16,0:21:21.77,JPDB,,0000,0000,0000,,“Қараңғы заттың жалыны”
Dialogue: 0,0:21:27.42,0:21:28.93,JPDB,,0000,0000,0000,,Катцуно жекпе-жек ойыны
Dialogue: 0,0:21:34.05,0:21:35.92,JPDB,,0000,0000,0000,,Мылтық үлгісі жақсы болар еді.
Dialogue: 0,0:21:44.64,0:21:47.97,JPDB,,0000,0000,0000,,Кешіріңіз, бірақ мен бұрынғы үйіме қайта алмаймын.
Dialogue: 0,0:21:48.57,0:21:50.63,JPDB,,0000,0000,0000,,Мен де бұдан былай ауруды сезінгім келмейді.
Dialogue: 0,0:21:55.80,0:21:58.01,JPDB,,0000,0000,0000,,Анашым, мен мысық ұстағым келеді.
Dialogue: 0,0:21:58.33,0:22:00.45,JPDB,,0000,0000,0000,,Иә? Кенеттен
Dialogue: 0,0:22:02.63,0:22:05.34,JPDB,,0000,0000,0000,,Бұл мысық. Бұл сүйкімді.
Dialogue: 0,0:22:06.96,0:22:10.96,JPDB,,0000,0000,0000,,Хисатами-сенпайдың мысығы біраз уақыттан кейін аман-есен табылған көрінеді.
Dialogue: 0,0:00:27.14,0:00:28.70,ZWDB,,0000,0000,0000,,…~
Dialogue: 0,0:02:21.76,0:02:24.67,ZWDB,,0000,0000,0000,,Шиншу киімдері
Dialogue: 0,0:02:26.51,0:02:29.19,ZWDB,,0000,0000,0000,,Су тоғандарын салыстыру кезінде абай болу керек
Dialogue: 0,0:02:34.31,0:02:34.84,ZWDB,,0000,0000,0000,,Джиорно, жараландың ба?
Dialogue: 0,0:02:35.28,0:02:35.63,ZWDB,,0000,0000,0000,,Әрине, бөлек.
Dialogue: 0,0:02:39.68,0:02:42.47,ZWDB,,0000,0000,0000,,Қиындыққа тап болсаң, қиналып қаласың.
Dialogue: 0,0:02:42.67,0:02:43.63,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:02:44.55,0:02:46.22,ZWDB,,0000,0000,0000,,Тогаши-кун лечерус
Dialogue: 0,0:02:47.86,0:02:49.00,ZWDB,,0000,0000,0000,,Еркін аялдама
Dialogue: 0,0:02:49.00,0:02:50.94,ZWDB,,0000,0000,0000,,Тоғашы-күн қалың түс
Dialogue: 0,0:02:52.06,0:02:53.23,ZWDB,,0000,0000,0000,,Еркін аялдама
Dialogue: 0,0:02:53.23,0:02:54.65,ZWDB,,0000,0000,0000,,Дайиро қасқыр
Dialogue: 0,0:02:54.65,0:02:56.61,ZWDB,,0000,0000,0000,,Еркін аялдама
Dialogue: 0,0:02:59.74,0:03:00.73,ZWDB,,0000,0000,0000,,Еркін аялдама
Dialogue: 0,0:03:05.51,0:03:06.97,ZWDB,,0000,0000,0000,,Сіздің арман әлеміңіздің соңы
Dialogue: 0,0:03:07.69,0:03:09.31,ZWDB,,0000,0000,0000,,Өзің иеленушісің.
Dialogue: 0,0:03:10.10,0:03:22.03,ZWDB,,0000,0000,0000,,«Құдай суы» Сиқырлы резервуардағы қуат деңгейі 120%.
Dialogue: 0,0:03:22.41,0:03:24.77,ZWDB,,0000,0000,0000,,Бастапқыда бұл жақсы нәрсе болды.
Dialogue: 0,0:03:26.19,0:03:27.20,ZWDB,,0000,0000,0000,,Сіз бақытты болуыңыз керек
Dialogue: 0,0:03:28.22,0:03:29.02,ZWDB,,0000,0000,0000,,Салмағы?
Dialogue: 0,0:03:32.85,0:03:35.48,ZWDB,,0000,0000,0000,,Кеше түнде мен шайқаста болдым...
Dialogue: 0,0:03:36.18,0:03:38.99,ZWDB,,0000,0000,0000,,Не болғанын білмеймін, бірақ барсам білімнің керегі жоқ.
Dialogue: 0,0:03:39.21,0:03:40.90,ZWDB,,0000,0000,0000,,Chuunibyou рас
Dialogue: 0,0:03:44.73,0:03:45.50,ZWDB,,0000,0000,0000,,Мысық па?
Dialogue: 0,0:03:45.65,0:03:46.86,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:03:48.16,0:03:49.05,ZWDB,,0000,0000,0000,,Чимейра
Dialogue: 0,0:03:50.24,0:03:53.55,ZWDB,,0000,0000,0000,,Тәңірмен ойнағанда ауылда пайда болатын құбыжық.
Dialogue: 0,0:03:53.82,0:03:58.45,ZWDB,,0000,0000,0000,,Шындығында, шекара сызығын кеше түнде табу мүмкін болмады.
Dialogue: 0,0:04:01.33,0:04:02.12,ZWDB,,0000,0000,0000,,Түсіру
Dialogue: 0,0:04:02.87,0:04:03.71,ZWDB,,0000,0000,0000,,Есептеу нұсқаулығы
Dialogue: 0,0:04:04.44,0:04:07.00,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:04:07.64,0:04:12.89,ZWDB,,0000,0000,0000,,Қараңғы әлемнің тұрғындары, Химейра, көрінбейтін шекаралық күшке ие.
Dialogue: 0,0:04:13.78,0:04:15.79,ZWDB,,0000,0000,0000,,Тек бір мәселе
Dialogue: 0,0:04:15.99,0:04:16.49,ZWDB,,0000,0000,0000,,Әрине, бөлек.
Dialogue: 0,0:04:16.86,0:04:19.70,ZWDB,,0000,0000,0000,,Көрінбейтін шекаралық әлемдік кеңесші
Dialogue: 0,0:04:19.70,0:04:22.83,ZWDB,,0000,0000,0000,,Юйю Чимейланың сиқырлы әсерін алды және иммундық реакция ретінде пайда болды.
Dialogue: 0,0:04:24.29,0:04:26.63,ZWDB,,0000,0000,0000,,Сен мысықсың.
Dialogue: 0,0:04:27.13,0:04:31.73,ZWDB,,0000,0000,0000,,Сондықтан мен жерлестерімді және Қараңғы жалын шеберінен көмек сұраймын ...
Dialogue: 0,0:04:31.73,0:04:32.60,ZWDB,,0000,0000,0000,,Қайдасың, Жороно? Апачай?
Dialogue: 0,0:04:34.31,0:04:36.77,ZWDB,,0000,0000,0000,,Орта мектеп өмірін бастағаннан кейін, бір апта солға және оңға
Dialogue: 0,0:04:37.72,0:04:39.65,ZWDB,,0000,0000,0000,,Маори Нана
Dialogue: 0,0:04:39.85,0:04:42.41,ZWDB,,0000,0000,0000,,Уруши Қара жалынның өкілі
Dialogue: 0,0:04:43.03,0:04:45.00,ZWDB,,0000,0000,0000,,Лак қара жалынның өкілі
Dialogue: 0,0:04:45.17,0:04:46.49,ZWDB,,0000,0000,0000,,Сізге ұнайды
Dialogue: 0,0:04:46.97,0:04:53.06,ZWBT,,0000,0000,0000,,Әуенді…Шинёрижин
Dialogue: 0,0:04:47.31,0:04:49.45,ZWDB,,0000,0000,0000,,Орта және орта мектеп өмірі
Dialogue: 0,0:04:49.89,0:04:52.38,ZWDB,,0000,0000,0000,,Орта мектептегі ауыр дертке шалдыққан бұл қыздан қалай құтылдыңыз?
Dialogue: 0,0:04:53.92,0:04:55.39,ZWDB,,0000,0000,0000,,Юта…
Dialogue: 0,0:04:55.64,0:04:56.41,ZWDB,,0000,0000,0000,,Қайдасың, Жороно? Апачай?
Dialogue: 0,0:04:56.90,0:05:02.27,ZWDB,,0000,0000,0000,,Кездейсоқ камфора ағашы, арман, қуанышты әрекет және арман орындалады.
Dialogue: 0,0:05:02.89,0:05:05.01,ZWDB,,0000,0000,0000,,Дегенмен, бұл туралы айтқанда, сіз отты көресіз.
Dialogue: 0,0:05:05.83,0:05:07.74,ZWDB,,0000,0000,0000,,Юута Такаши
Dialogue: 0,0:05:09.13,0:05:11.32,ZWDB,,0000,0000,0000,,Әңгімелесу: Ютаның әкесі
Dialogue: 0,0:05:11.67,0:05:13.16,ZWDB,,0000,0000,0000,,Жұмысқа жауапты бір адам
Dialogue: 0,0:05:13.80,0:05:14.97,ZWDB,,0000,0000,0000,,Әр адамның ешкімге көрсетпейтін бір жағы бар
Dialogue: 0,0:05:16.74,0:05:20.04,ZWDB,,0000,0000,0000,,Көкөністердің әртүрлі түрлеріндегі фамилия `` Цзы Доу '' болып табылады.
Dialogue: 0,0:05:15.97,0:05:19.12,ZWDB,,0000,0000,0000,,Қазіргі уақытта мен өткен оқиғаларға назар аудара алмаймын.
Dialogue: 0,0:05:20.07,0:05:23.94,ZWDB,,0000,0000,0000,,Дегенмен, қазіргі уақытта бейбітшілік пен бейбітшілікке қол жеткізілмеген аймақтардың саны аз.
Dialogue: 0,0:05:23.30,0:05:27.18,ZWDB,,0000,0000,0000,,Нана кітап комитетінің мүшесі болып тағайындалды және Хираката университетінде сынып мұғалімі болып тағайындалды.
Dialogue: 0,0:05:27.85,0:05:32.87,ZWDB,,0000,0000,0000,,Қателік кеткеннен кейін мен де осындай орынды дамыта алдым, содан кейін мен команданың басшысы болдым.
Dialogue: 0,0:05:33.56,0:05:36.12,ZWDB,,0000,0000,0000,,Соның салдарынан мұнда келгеніме көп уақыт болған жоқ.
Dialogue: 0,0:05:36.79,0:05:38.71,ZWDB,,0000,0000,0000,,Нана осындай қорытындыға келеді
Dialogue: 0,0:05:39.48,0:05:44.27,ZWDB,,0000,0000,0000,,Осымен кездесу аяқталды.
Dialogue: 0,0:05:44.75,0:05:47.36,ZWDB,,0000,0000,0000,,Біздің команданың ұзақ болуы қиын және қиын.
Dialogue: 0,0:05:47.48,0:05:48.67,ZWDB,,0000,0000,0000,,Сізге жақсы ниет
Dialogue: 0,0:05:48.87,0:05:52.30,ZWDB,,0000,0000,0000,,Егер сіз басқа адам болсаңыз, кімге дауыс беруді шешкеніңізді маған хабарлаңыз.
Dialogue: 0,0:05:52.55,0:05:54.02,ZWDB,,0000,0000,0000,,Менің идеям басталып, дауыстардың саны есептелді.
Dialogue: 0,0:05:54.34,0:05:54.96,ZWDB,,0000,0000,0000,,Дауыс беру керек пе?
Dialogue: 0,0:05:55.83,0:05:57.65,ZWDB,,0000,0000,0000,,«Сүйікті студент қыз» дауысы
Dialogue: 0,0:05:57.80,0:06:01.62,ZWDB,,0000,0000,0000,,Топтағы ең сүйікті студент қыз кім?
Dialogue: 0,0:06:02.10,0:06:02.77,ZWDB,,0000,0000,0000,,Кімді таңдау керек?
Dialogue: 0,0:06:04.31,0:06:08.18,ZWDB,,0000,0000,0000,,Бұл өлген топтың шынайы оқиғасы.
Dialogue: 0,0:06:08.63,0:06:10.00,ZWDB,,0000,0000,0000,,Ашық емес
Dialogue: 0,0:06:10.05,0:06:13.28,ZWDB,,0000,0000,0000,,Әртүрлі уақытта, адам өмірінде тастай берік құрылым болуы мүмкін.
Dialogue: 0,0:06:13.50,0:06:14.20,ZWDB,,0000,0000,0000,,Тоғаши мырза
Dialogue: 0,0:06:14.32,0:06:15.14,ZWDB,,0000,0000,0000,,Осымен
Dialogue: 0,0:06:16.39,0:06:18.13,ZWDB,,0000,0000,0000,,Ғылым бөлмесі түстен кейінгі үзілісте қолжетімді
Dialogue: 0,0:06:19.59,0:06:22.62,ZWDB,,0000,0000,0000,,Мен ғылыми сарапшы емеспін, бірақ мен сізге қажетті құрал-жабдықтарды қалдырамын.
Dialogue: 0,0:06:24.51,0:06:28.66,ZWDB,,0000,0000,0000,,Жеті сегіз тоғыз он... он екі
Dialogue: 0,0:06:29.26,0:06:33.46,ZWDB,,0000,0000,0000,,Он екі дана… Бір қабатты растау аяқталды
Dialogue: 0,0:06:35.60,0:06:38.43,ZWDB,,0000,0000,0000,,Мұндай дәм - Асиенс пен Видал Сасун.
Dialogue: 0,0:06:38.80,0:06:40.59,ZWDB,,0000,0000,0000,,Топ жетекшісінің жұмысы аяқталды.
Dialogue: 0,0:06:41.44,0:06:44.07,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:06:45.24,0:06:47.53,ZWDB,,0000,0000,0000,,Мәселеге назар аударыңыз.
Dialogue: 0,0:06:48.22,0:06:51.03,ZWDB,,0000,0000,0000,,Шығыс пен Батыстағы кездесу әрқашан есімде.
Dialogue: 0,0:06:51.68,0:06:54.79,ZWDB,,0000,0000,0000,,Зена Того толығымен жарияланбаған
Dialogue: 0,0:06:55.31,0:06:58.37,ZWDB,,0000,0000,0000,,Мен басқа адамды көре алмаймын, бірақ мен басқа адамды көре алмаймын.
Dialogue: 0,0:06:59.36,0:07:00.78,ZWDB,,0000,0000,0000,,​​Мен де команданың жетекшісімін.
Dialogue: 0,0:07:03.19,0:07:06.64,ZWDB,,0000,0000,0000,,Мына жерді қарау керек.
Dialogue: 0,0:07:07.51,0:07:09.55,ZWDB,,0000,0000,0000,,Топ басшысы мен оның командасы көптеген тапсырмаларды орындады.
Dialogue: 0,0:07:10.57,0:07:13.38,ZWDB,,0000,0000,0000,,Бұл тұрарлық емес.
Dialogue: 0,0:07:13.97,0:07:16.04,ZWDB,,0000,0000,0000,,Тоғаши Кимия және оның отбасы
Dialogue: 0,0:07:16.36,0:07:21.78,ZWDB,,0000,0000,0000,,Гаго? Бастауыш сыныпта оқып жүргенімде, бастауыш сыныпта оқитынмын.
Dialogue: 0,0:07:22.30,0:07:24.71,ZWDB,,0000,0000,0000,,Мені құрметтемейтін адам осындай.
Dialogue: 0,0:07:25.36,0:07:30.00,ZWDB,,0000,0000,0000,,Командаңызды алғаш қашан көрдіңіз?
Dialogue: 0,0:07:30.58,0:07:33.66,ZWDB,,0000,0000,0000,,Барлау литургиясы вокзалда жақсы емес.
Dialogue: 0,0:07:43.65,0:07:44.42,ZWDB,,0000,0000,0000,,Сіз бұл туралы жаза аласыз.
Dialogue: 0,0:07:45.31,0:07:47.23,ZWDB,,0000,0000,0000,,Бұлай емес деп айту табиғи нәрсе.
Dialogue: 0,0:07:47.68,0:07:52.05,ZWDB,,0000,0000,0000,,Белгісіз аты және аты
Dialogue: 0,0:07:52.80,0:07:57.29,ZWDB,,0000,0000,0000,,Тогаши-кун сыныпқа келгенде, мен: «Бұл вокзалдағы талантты адам» деп ойладым.
Dialogue: 0,0:07:57.54,0:07:59.01,ZWDB,,0000,0000,0000,,Осы жолмен...осы жолмен
Dialogue: 0,0:07:59.78,0:08:03.16,ZWDB,,0000,0000,0000,,Кенеттен асқыну
Dialogue: 0,0:08:05.12,0:08:08.45,ZWDB,,0000,0000,0000,,Ең аз жеке әсер
Dialogue: 0,0:08:10.47,0:08:14.27,ZWDB,,0000,0000,0000,,Сүйіспеншілік пен қанағаттану жолы басталды.
Dialogue: 0,0:08:14.97,0:08:16.90,ZWDB,,0000,0000,0000,,Накагамидің стационарлық станциясы
Dialogue: 0,0:08:17.23,0:08:19.84,ZWDB,,0000,0000,0000,,「」
Dialogue: 0,0:08:20.06,0:08:24.36,ZWDB,,0000,0000,0000,,Тең емес Бірінші үлгі
Dialogue: 0,0:08:26.47,0:08:27.79,ZWDB,,0000,0000,0000,,Орнынан тұрып кететін уақыт келді ме?
Dialogue: 0,0:08:29.21,0:08:29.79,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:08:31.52,0:08:32.24,ZWDB,,0000,0000,0000,,Бұзықтық
Dialogue: 0,0:08:33.51,0:08:34.75,ZWDB,,0000,0000,0000,,Тоғаши-кун
Dialogue: 0,0:08:35.42,0:08:38.48,ZWDB,,0000,0000,0000,,Мен не айтарымды білмеймін.
Dialogue: 0,0:08:39.65,0:08:40.42,ZWDB,,0000,0000,0000,,Тоғаши мырза
Dialogue: 0,0:08:40.42,0:08:42.43,ZWDB,,0000,0000,0000,,Міне осылай.
Dialogue: 0,0:08:44.52,0:08:46.21,ZWDB,,0000,0000,0000,,Мен өлдім.
Dialogue: 0,0:08:46.41,0:08:49.51,ZWDB,,0000,0000,0000,,Міне, тағы бар.
Dialogue: 0,0:08:49.51,0:08:51.60,ZWDB,,0000,0000,0000,,Юута Мен осындамын.
Dialogue: 0,0:08:51.60,0:08:52.67,ZWDB,,0000,0000,0000,,Кішкентай құс оқушысы?
Dialogue: 0,0:08:52.84,0:08:54.56,ZWDB,,0000,0000,0000,,Мұнда қайдасың?
Dialogue: 0,0:08:54.91,0:08:56.35,ZWDB,,0000,0000,0000,,Мен мұнда келгенде маған не болды?
Dialogue: 0,0:08:57.62,0:08:59.58,ZWDB,,0000,0000,0000,,Мен бұл отбасының тілін көре алмаймын.
Dialogue: 0,0:09:00.65,0:09:06.36,ZWDB,,0000,0000,0000,,Бұл мектеп орналасқан жер.
Dialogue: 0,0:09:07.36,0:09:10.89,ZWDB,,0000,0000,0000,,Киіміңізге сәттілік тілейміз.
Dialogue: 0,0:09:11.19,0:09:11.71,ZWDB,,0000,0000,0000,,Қашу?
Dialogue: 0,0:09:11.98,0:09:13.87,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:09:14.44,0:09:16.23,ZWDB,,0000,0000,0000,,Kaname...Қазір тұр...
Dialogue: 0,0:09:16.63,0:09:20.36,ZWDB,,0000,0000,0000,,Сіз әдейі басқа нәрсе айттыңыз.
Dialogue: 0,0:09:20.63,0:09:24.13,ZWDB,,0000,0000,0000,,Әлемнің қазіргі бар болуы туралы әңгіме.
Dialogue: 0,0:09:24.26,0:09:25.65,ZWDB,,0000,0000,0000,,Сиқырлы күштің қазіргі жетіспеушілігі
Dialogue: 0,0:09:25.97,0:09:29.43,ZWDB,,0000,0000,0000,,Қажетті жасанды өндіріс прогрессі
Dialogue: 0,0:09:29.63,0:09:30.47,ZWDB,,0000,0000,0000,,Чимейра?
Dialogue: 0,0:09:30.67,0:09:32.19,ZWDB,,0000,0000,0000,,Қажет емес
Dialogue: 0,0:09:32.91,0:09:35.64,ZWDB,,0000,0000,0000,,Бұл беттің жоғарғы жағында тұрған Хайнеконың аты.
Dialogue: 0,0:09:36.64,0:09:39.32,ZWDB,,0000,0000,0000,,Бұл кішкентай құстың мектепке бірінші рет келуі.
Dialogue: 0,0:09:39.79,0:09:41.93,ZWDB,,0000,0000,0000,,Керексіз айқай «Котарию» Қажет айқай «Рикка»
Dialogue: 0,0:09:42.65,0:09:45.96,ZWDB,,0000,0000,0000,,Сұр мысық оқиғасының шығу тегі
Dialogue: 0,0:09:48.96,0:09:50.85,ZWDB,,0000,0000,0000,,Аты? Шындық деген не?
Dialogue: 0,0:09:51.30,0:09:55.82,ZWDB,,0000,0000,0000,,​​Бұл мүмкін емес болуы да мүмкін.
Dialogue: 0,0:09:56.69,0:09:59.78,ZWDB,,0000,0000,0000,,Көбінесе бұл үлкен осар.
Dialogue: 0,0:10:00.52,0:10:01.91,ZWDB,,0000,0000,0000,,Арқа қанатты қуық…
Dialogue: 0,0:10:02.16,0:10:02.93,ZWDB,,0000,0000,0000,,отбасы құру
Dialogue: 0,0:10:04.80,0:10:08.03,ZWDB,,0000,0000,0000,,Менің отбасымның мысығы нағыз мысықтан мүлде басқаша.
Dialogue: 0,0:10:08.38,0:10:09.05,ZWDB,,0000,0000,0000,,Бұл түсініктеме
Dialogue: 0,0:10:09.47,0:10:10.54,ZWDB,,0000,0000,0000,,Сәттілік.
Dialogue: 0,0:10:12.05,0:10:13.45,ZWDB,,0000,0000,0000,,Уақыт белгісіз болған кезде
Dialogue: 0,0:10:15.56,0:10:17.22,ZWDB,,0000,0000,0000,,Шамамен бір апта бұрын
Dialogue: 0,0:10:17.72,0:10:18.64,ZWDB,,0000,0000,0000,,Міндетті мейірбике күтімі
Dialogue: 0,0:10:18.99,0:10:19.76,ZWDB,,0000,0000,0000,,Мүмкін
Dialogue: 0,0:10:20.11,0:10:20.75,ZWDB,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:10:22.09,0:10:25.08,ZWDB,,0000,0000,0000,,Нана…Бұл 7 мамыр, ханым.
Dialogue: 0,0:10:26.02,0:10:27.99,ZWDB,,0000,0000,0000,,Оны Цююри жазған
Dialogue: 0,0:10:28.63,0:10:31.12,ZWDB,,0000,0000,0000,,Менің айқайым 7 мамыр Хисатами Корета Такашикио
Dialogue: 0,0:10:31.64,0:10:34.25,ZWDB,,0000,0000,0000,,Юта Тогаши
Dialogue: 0,0:10:35.69,0:10:36.25,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:10:41.26,0:10:44.66,ZWDB,,0000,0000,0000,,Менің үйім екінші бөлмеде.
Dialogue: 0,0:10:45.13,0:10:45.98,ZWDB,,0000,0000,0000,,Рокка Шоуга
Dialogue: 0,0:10:46.18,0:10:46.87,ZWDB,,0000,0000,0000,,Өлім
Dialogue: 0,0:10:47.55,0:10:51.00,ZWDB,,0000,0000,0000,,Сенің шын ғашығың, бұл жасыл алхоры бамбук.
Dialogue: 0,0:10:51.25,0:10:54.83,ZWDB,,0000,0000,0000,,Бұл кішкентай құс бұрын ешқашан тасымалданбаған.
Dialogue: 0,0:11:01.54,0:11:02.96,ZWDB,,0000,0000,0000,,Сиқырлы құпияны шығару
Dialogue: 0,0:11:04.84,0:11:06.14,ZWDB,,0000,0000,0000,,Басқа аударманы ашу оңай.
Dialogue: 0,0:11:12.57,0:11:14.79,ZWDB,,0000,0000,0000,,Ашылғаннан кейін
Dialogue: 0,0:11:14.91,0:11:16.35,ZWDB,,0000,0000,0000,,Шындық мынада, Мао мөлдір.
Dialogue: 0,0:11:16.87,0:11:21.50,ZWDB,,0000,0000,0000,,Ең бірінші істегенім бөлмемнен шықтым.
Dialogue: 0,0:11:23.16,0:11:25.95,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:11:26.09,0:11:27.34,ZWDB,,0000,0000,0000,,Бір мектепте ойнаған қыз
Dialogue: 0,0:11:28.16,0:11:28.85,ZWDB,,0000,0000,0000,,Мен келе аламын ба?
Dialogue: 0,0:11:29.80,0:11:31.26,ZWDB,,0000,0000,0000,,Бұл сіздің барлық жүктеріңіз бе?
Dialogue: 0,0:11:32.36,0:11:33.65,ZWDB,,0000,0000,0000,,Жақсы және жаман дәм сезу
Dialogue: 0,0:11:38.02,0:11:43.19,ZWDB,,0000,0000,0000,,Хаостың қараңғы жағына қош келдіңіз
Dialogue: 0,0:11:43.87,0:11:45.53,ZWDB,,0000,0000,0000,,Атау мағынасының маңыздылығы
Dialogue: 0,0:11:47.69,0:11:50.35,ZWDB,,0000,0000,0000,,Сүйкімді және сүйкімді үлбірлі ойыншық мүсінше
Dialogue: 0,0:11:50.53,0:11:52.41,ZWDB,,0000,0000,0000,,Солтүстік провинциясының Генбу
Dialogue: 0,0:11:54.68,0:11:56.27,ZWDB,,0000,0000,0000,,Бұл әскери мақсатқа арналмаған.
Dialogue: 0,0:11:56.86,0:11:58.88,ZWDB,,0000,0000,0000,,Мен бұл туралы ойладым және бұл туралы ойладым.
Dialogue: 0,0:11:59.87,0:12:02.31,ZWDB,,0000,0000,0000,,Жын-перілердің құдай әлемі
Dialogue: 0,0:12:02.70,0:12:06.16,ZWDB,,0000,0000,0000,,Мен көретін сезімдердің кейбір түрлері бар.
Dialogue: 0,0:12:06.58,0:12:07.20,ZWDB,,0000,0000,0000,,Рұқсат етілген
Dialogue: 0,0:12:09.42,0:12:11.48,ZWDB,,0000,0000,0000,,Жақсы адам болуға кепілдік
Dialogue: 0,0:12:16.77,0:12:21.89,ZWDB,,0000,0000,0000,,Бұл сала 100 жыл бұрын өндірістік модельдің зиянды әсерлеріне байланысты қолданылып келеді...
Dialogue: 0,0:12:21.89,0:12:25.55,ZWDB,,0000,0000,0000,,Бұл M712 түрі...
Dialogue: 0,0:12:25.67,0:12:28.43,ZWDB,,0000,0000,0000,,Тоғашы-күн Шығыс пен Батыста осында болғанына қуанышты
Dialogue: 0,0:12:29.55,0:12:30.09,ZWDB,,0000,0000,0000,,Алдымен пошталық индекс
Dialogue: 0,0:12:30.09,0:12:34.87,ZWDB,,0000,0000,0000,,Бұл кеңседегі барлық элементтер астрологиялық нәтижелерге негізделген және нәтижелер толығымен тегін.
Dialogue: 0,0:12:35.21,0:12:38.77,ZWDB,,0000,0000,0000,,Тыйым салынған тәртіпсіз қозғалыс, сондықтан қажетсіз сұрыптау бөлмесі
Dialogue: 0,0:12:43.91,0:12:44.78,ZWDB,,0000,0000,0000,,Түсіру
Dialogue: 0,0:12:45.58,0:12:47.09,ZWDB,,0000,0000,0000,,Ауылдағы мысық туралы айту
Dialogue: 0,0:12:47.74,0:12:50.52,ZWDB,,0000,0000,0000,,Мен оны оқып, қарапайым адамдардан аламын.
Dialogue: 0,0:12:51.42,0:12:53.41,ZWDB,,0000,0000,0000,,Менің отбасымның оқуы – менің құрметті тілім.
Dialogue: 0,0:12:54.10,0:12:55.41,ZWDB,,0000,0000,0000,,Анонимді
Dialogue: 0,0:12:59.50,0:13:01.19,ZWDB,,0000,0000,0000,,Жапон кеңселері арасындағы толық интеграцияны аяқтау
Dialogue: 0,0:13:01.46,0:13:02.85,ZWDB,,0000,0000,0000,,Сіз оны көре аласыз
Dialogue: 0,0:13:03.17,0:13:04.85,ZWDB,,0000,0000,0000,,Әңгімелесу әдістерінің басқа түрлері
Dialogue: 0,0:13:05.93,0:13:06.63,ZWDB,,0000,0000,0000,,Бұл жай ғана мысық.
Dialogue: 0,0:13:08.52,0:13:12.05,ZWDB,,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймын.
Dialogue: 0,0:13:12.37,0:13:13.14,ZWDB,,0000,0000,0000,,Әр адамның ешкімге көрсетпейтін бір жағы бар
Dialogue: 0,0:13:15.97,0:13:16.82,ZWDB,,0000,0000,0000,,Бұл мысық кім?
Dialogue: 0,0:13:17.81,0:13:18.06,ZWDB,,0000,0000,0000,,Аты?
Dialogue: 0,0:13:22.81,0:13:23.56,ZWDB,,0000,0000,0000,,Бұл кім?
Dialogue: 0,0:13:32.75,0:13:33.79,ZWDB,,0000,0000,0000,,Менің мысығым кім?
Dialogue: 0,0:13:37.00,0:13:41.15,ZWDB,,0000,0000,0000,,Құпия тосқауыл бөгет Радиалды қорғаныс қабырғасы Су бүрку басталады
Dialogue: 0,0:13:42.34,0:13:43.44,ZWDB,,0000,0000,0000,,Толық қашу
Dialogue: 0,0:13:43.54,0:13:44.28,ZWDB,,0000,0000,0000,,Ескерту: жапон тілінде «емтиханға өтініш беру» мен «өлім» сөздері бірдей айтылады
Dialogue: 0,0:13:56.64,0:13:57.48,ZWDB,,0000,0000,0000,,Нари менің бөлмем емес
Dialogue: 0,0:14:02.73,0:14:04.59,ZWDB,,0000,0000,0000,,Сіз менің бөлмемдесіз.
Dialogue: 0,0:14:04.74,0:14:05.76,ZWDB,,0000,0000,0000,,Шешім қабылданды
Dialogue: 0,0:14:06.63,0:14:07.94,ZWDB,,0000,0000,0000,,Мофей - бұл жауап
Dialogue: 0,0:14:08.24,0:14:09.66,ZWDB,,0000,0000,0000,,Оқудың қажеті жоқ
Dialogue: 0,0:14:10.28,0:14:18.86,ZWDB,,0000,0000,0000,,Дүниенің ақыры (шварцшильд), толығымен ашылуы керек.
Dialogue: 0,0:14:38.47,0:14:41.12,ZWDB,,0000,0000,0000,,"Avalon Smash"! (Агаратака Шигека)
Dialogue: 0,0:14:48.06,0:14:49.13,ZWDB,,0000,0000,0000,,Юта Тогашиге айқайлайсың
Dialogue: 0,0:14:51.19,0:14:56.46,ZWDB,,0000,0000,0000,,Мен сайрап тұрған кішкентай құс – осы әулеттің әпкесі.
Dialogue: 0,0:14:59.04,0:15:03.64,ZWDB,,0000,0000,0000,,Ганадзидоның `` Джау Шинган '' санаты бірдей.
Dialogue: 0,0:15:04.14,0:15:05.06,ZWDB,,0000,0000,0000,,Шынайы мүміннің зияны
Dialogue: 0,0:15:06.35,0:15:08.69,ZWDB,,0000,0000,0000,,Бірақ мен мысықпын.
Dialogue: 0,0:15:09.14,0:15:11.07,ZWDB,,0000,0000,0000,,Оны мына жерден көре аласыз.
Dialogue: 0,0:15:11.40,0:15:15.05,ZWDB,,0000,0000,0000,,Мао өлді деген шындық.
Dialogue: 0,0:15:15.05,0:15:15.42,ZWDB,,0000,0000,0000,,…
Dialogue: 0,0:15:16.02,0:15:20.05,ZWDB,,0000,0000,0000,,Мен бұл туралы ойланбай тұра алмаймын.
Dialogue: 0,0:15:20.62,0:15:23.58,ZWDB,,0000,0000,0000,,Қаланы тастап кеткен кім?
Dialogue: 0,0:15:23.97,0:15:26.24,ZWDB,,0000,0000,0000,,Мұны түсіну мүмкін емес.
Dialogue: 0,0:15:26.51,0:15:29.79,ZWDB,,0000,0000,0000,,Мен келгенде...
Dialogue: 0,0:15:30.31,0:15:30.83,ZWDB,,0000,0000,0000,,Фусу Канпо
Dialogue: 0,0:15:31.31,0:15:32.55,ZWDB,,0000,0000,0000,,Мен олай ойламаймын.
Dialogue: 0,0:15:34.04,0:15:34.76,ZWDB,,0000,0000,0000,,Нашуходан толық
Dialogue: 0,0:15:36.43,0:15:37.05,ZWDB,,0000,0000,0000,,Енді олар жай ғана кішігірім бандиттер тобы
Dialogue: 0,0:15:38.02,0:15:40.87,ZWDB,,0000,0000,0000,,Бұл музыкалық машина екі жыл бұрын болған.
Dialogue: 0,0:15:41.07,0:15:43.41,ZWDB,,0000,0000,0000,,Жергілікті жердегі платформада белгілі бір адамның дыбысы
Dialogue: 0,0:15:49.45,0:15:52.26,ZWDB,,0000,0000,0000,,Бұл орындалмаған немесе арман болған жоқ.
Dialogue: 0,0:15:52.75,0:15:58.74,ZWDB,,0000,0000,0000,,Міне, 2012 жылғы дүниенің қара түнек ортасындағы қазіргі жағдайы.
Dialogue: 0,0:15:57.05,0:15:58.74,ZWDB,,0000,0000,0000,,Тоғаши-кун
Dialogue: 0,0:15:59.04,0:16:00.36,ZWDB,,0000,0000,0000,,Қош келдіңіз
Dialogue: 0,0:16:00.36,0:16:04.06,ZWDB,,0000,0000,0000,,Мен сенікі емеспін, атым лак қара жалын
Dialogue: 0,0:16:04.78,0:16:08.98,ZWDB,,0000,0000,0000,,Қара және күңгірт жалынмен жаназасы бар әлемге әйгілі адам.
Dialogue: 0,0:16:07.07,0:16:08.49,ZWDB,,0000,0000,0000,,Бұл Тоғаши-күннің дауысы.
Dialogue: 0,0:16:11.00,0:16:17.87,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:16:12.99,0:16:14.53,ZWDB,,0000,0000,0000,,Бүгінгі жел мен шу
Dialogue: 0,0:16:15.07,0:16:18.70,ZWDB,,0000,0000,0000,,Сіз түпнұсқаны оқу үшін келдіңіз.
Dialogue: 0,0:16:18.68,0:16:21.88,ZWDB,,0000,0000,0000,,Менің бүкіл денем күшке толы.
Dialogue: 0,0:16:23.05,0:16:27.20,ZWDB,,0000,0000,0000,,Қатты күліңіз
Dialogue: 0,0:16:28.17,0:16:33.54,ZWDB,,0000,0000,0000,,Мен ең сүйікті әпкеммін.
Dialogue: 0,0:16:34.09,0:16:35.33,ZWDB,,0000,0000,0000,,Сіз осындасыз
Dialogue: 0,0:16:35.33,0:16:36.20,ZWDB,,0000,0000,0000,,Горега…
Dialogue: 0,0:16:28.74,0:16:32.07,ZWDB,,0000,0000,0000,,Менің қызығушылығым – станцияда Шығыс пен Батыстың әртүрлі қызықты көріністері.
Dialogue: 0,0:16:33.59,0:16:34.07,ZWDB,,0000,0000,0000,,Қолдауыңызға рахмет
Dialogue: 0,0:16:35.78,0:16:36.20,ZWDB,,0000,0000,0000,,Джунмей
Dialogue: 0,0:16:40.10,0:16:40.85,ZWDB,,0000,0000,0000,,Қашу
Dialogue: 0,0:16:54.44,0:16:57.80,ZWDB,,0000,0000,0000,,Мен туысқан емеспін.
Dialogue: 0,0:16:58.57,0:17:01.87,ZWDB,,0000,0000,0000,,Тогаши-кун, әлемдегі алғашқы қашу
Dialogue: 0,0:17:02.27,0:17:03.54,ZWDB,,0000,0000,0000,,Мен біздің қоғамның мүшесімін.
Dialogue: 0,0:17:04.06,0:17:09.03,ZWDB,,0000,0000,0000,,Бұл жаһандық күш-жігердің себебі.
Dialogue: 0,0:17:09.85,0:17:12.46,ZWDB,,0000,0000,0000,,Егер сіз дарынды адам болсаңыз, сіз осында өмір сүре аласыз.
Dialogue: 0,0:17:12.83,0:17:16.66,ZWDB,,0000,0000,0000,,Easy Escape Ная басқару бюросының мүшесі.
Dialogue: 0,0:17:17.43,0:17:19.30,ZWDB,,0000,0000,0000,,Мүмкін емес және шағын бақылау практикалық
Dialogue: 0,0:17:28.59,0:17:34.78,ZWDB,,0000,0000,0000,,«Қанды түрме»
Dialogue: 0,0:17:35.48,0:17:36.78,ZWDB,,0000,0000,0000,,Оны алыңыз
Dialogue: 0,0:17:37.74,0:17:41.39,ZWDB,,0000,0000,0000,,Қолдануға болатын бір сәттік ауыстырылатын қабілет
Dialogue: 0,0:17:41.39,0:17:43.65,ZWDB,,0000,0000,0000,,Бұл сіздің қалың болғаныңыз үшін ғана.
Dialogue: 0,0:17:46.09,0:17:46.79,ZWDB,,0000,0000,0000,,Келу керек
Dialogue: 0,0:17:47.16,0:17:50.07,ZWDB,,0000,0000,0000,,Жақсы сурет қорқынышты бейнеге ұқсайды.
Dialogue: 0,0:17:50.31,0:17:51.71,ZWDB,,0000,0000,0000,,Бір ұпай Миякофююшу
Dialogue: 0,0:17:55.46,0:17:56.68,ZWDB,,0000,0000,0000,,Талантты адамның жақсы бейнесі.
Dialogue: 0,0:17:59.11,0:18:00.06,ZWDB,,0000,0000,0000,,7 мамыр Манабу
Dialogue: 0,0:18:01.97,0:18:03.07,ZWDB,,0000,0000,0000,,Жақсы нүкте
Dialogue: 0,0:18:12.09,0:18:15.37,ZWDB,,0000,0000,0000,,Сіздің өміріңізге қауіп төніп тұрғанын естігеніме өкінішті.
Dialogue: 0,0:18:15.67,0:18:19.79,ZWDB,,0000,0000,0000,,Ағымдағы жағдайдан шығу үшін ``қарау'' әдісі
Dialogue: 0,0:18:20.54,0:18:23.35,ZWDB,,0000,0000,0000,,Дегенмен, ақыр соңында бұл шайқастың жеңімпазы болады.
Dialogue: 0,0:18:25.11,0:18:26.28,ZWDB,,0000,0000,0000,,Хагами Юшошо
Dialogue: 0,0:18:27.57,0:18:30.21,ZWDB,,0000,0000,0000,,Жарысты аяқтағаннан кейін мен мансабымды бастағаннан кейін өмірді бастадым.
Dialogue: 0,0:18:30.50,0:18:32.29,ZWDB,,0000,0000,0000,,Бөлек Өлім туы
Dialogue: 0,0:18:32.96,0:18:37.59,ZWDB,,0000,0000,0000,,Юутаяның оңай қашуы.
Dialogue: 0,0:18:39.68,0:18:44.02,ZWDB,,0000,0000,0000,,Мен көре алмайтын шекке жетуім керек.
Dialogue: 0,0:18:46.68,0:18:47.45,ZWDB,,0000,0000,0000,,Кішкентай құс
Dialogue: 0,0:18:49.37,0:18:50.39,ZWDB,,0000,0000,0000,,Менің атым Рокка.
Dialogue: 0,0:18:51.58,0:18:52.35,ZWDB,,0000,0000,0000,,Бұл жерде емес Чимей оқиғасы…
Dialogue: 0,0:18:55.26,0:18:56.00,ZWDB,,0000,0000,0000,,Зайна Рин
Dialogue: 0,0:18:56.40,0:18:58.89,ZWDB,,0000,0000,0000,,Гарокашижуан Юташа Цимейді ұрлау
Dialogue: 0,0:19:01.80,0:19:05.47,ZWDB,,0000,0000,0000,,"Schwarz Sechs Prototype Mark 2" шығарылымы
Dialogue: 0,0:19:06.79,0:19:09.53,ZWDB,,0000,0000,0000,,Жарылыс, шындық, жарылыс «Синапс»
Dialogue: 0,0:19:09.80,0:19:12.95,ZWDB,,0000,0000,0000,,«Бұл дүниені қудалау»
Dialogue: 0,0:19:19.81,0:19:23.37,ZWDB,,0000,0000,0000,,Айналымдағы қан пакті
Dialogue: 0,0:19:29.58,0:19:31.47,ZWDB,,0000,0000,0000,,«Koningin der Nacht» (Түн патшайымы)
Dialogue: 0,0:19:47.20,0:19:48.77,ZWDB,,0000,0000,0000,,“Қараңғы заттың жалыны”
Dialogue: 0,0:20:04.95,0:20:09.35,ZWDB,,0000,0000,0000,,Кішкентай құс Сіз сондасыз... Жапонияға қалай жетуге болады?
Dialogue: 0,0:20:10.07,0:20:11.46,ZWDB,,0000,0000,0000,,«Нергал жарылысы»
Dialogue: 0,0:20:17.85,0:20:18.97,ZWDB,,0000,0000,0000,,Кішкентай құс Юкаю
Dialogue: 0,0:20:19.46,0:20:22.02,ZWDB,,0000,0000,0000,,«Кантикула»
Dialogue: 0,0:20:33.41,0:20:34.73,ZWDB,,0000,0000,0000,,Сен өлдің
Dialogue: 0,0:20:41.11,0:20:42.75,ZWDB,,0000,0000,0000,,Алдану да бар болуды талап етеді
Dialogue: 0,0:20:45.54,0:20:49.22,ZWDB,,0000,0000,0000,,Келесі жолы үйге оралғанда, мысыққа қайта орала аласыз.
Dialogue: 0,0:20:50.61,0:20:51.48,ZWDB,,0000,0000,0000,,Бұл шынымен де өте, «өте» жақсы жас
Dialogue: 0,0:20:54.09,0:20:54.93,ZWDB,,0000,0000,0000,,Сатып алу мәліметтері
Dialogue: 0,0:21:00.70,0:21:05.94,ZWDB,,0000,0000,0000,,Тай Ци Кайрё “Кантикула”
Dialogue: 0,0:21:06.61,0:21:08.50,ZWDB,,0000,0000,0000,,Сіздің қиялыңыздағы әңгіме
Dialogue: 0,0:21:14.69,0:21:16.03,ZWDB,,0000,0000,0000,,Ауырсыну бар
Dialogue: 0,0:21:20.16,0:21:21.77,ZWDB,,0000,0000,0000,,“Қараңғы заттың жалыны”
Dialogue: 0,0:21:27.42,0:21:28.93,ZWDB,,0000,0000,0000,,Бұл ойнауға болатын ең жақсы ойын.
Dialogue: 0,0:21:34.05,0:21:35.92,ZWDB,,0000,0000,0000,,Бұл үлгінің сөздері мен жолдары ғана.
Dialogue: 0,0:21:44.64,0:21:47.97,ZWDB,,0000,0000,0000,,Үйден шыққанда оны көре алмайсың.
Dialogue: 0,0:21:48.57,0:21:50.63,ZWDB,,0000,0000,0000,,Гайя күтпеген жерден тағы да кездеседі
Dialogue: 0,0:21:55.80,0:21:58.01,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:21:58.33,0:22:00.45,ZWDB,,0000,0000,0000,,Аты? Мен кенеттен сөйлескім келеді
Dialogue: 0,0:22:02.63,0:22:05.34,ZWDB,,0000,0000,0000,,Коренеко Коукай
Dialogue: 0,0:22:06.96,0:22:10.96,ZWDB,,0000,0000,0000,,Ақыр заманнан кейін Манабу Оканың мысығы келді.
Dialogue: 0,0:00:51.62,0:00:55.59,JPOP,,0000,0000,0000,karaoke,Бір-біріне қарап біраз тұрған соң
Dialogue: 0,0:00:55.82,0:01:02.38,JPOP,,0000,0000,0000,karaoke,Маған таң қалдырмас бұрын сіз не ойладыңыз?
Dialogue: 0,0:01:02.60,0:01:06.63,JPOP,,0000,0000,0000,karaoke,Маған қараңдаршы еріндері
Dialogue: 0,0:01:06.85,0:01:12.17,JPOP,,0000,0000,0000,karaoke,Менен не болды деп сұрағанша күтемін.
Dialogue: 0,0:01:12.52,0:01:17.87,JPOP,,0000,0000,0000,karaoke,Алдағаннан кейін өзіңізге не айтасыз?
Dialogue: 0,0:01:18.36,0:01:23.78,JPOP,,0000,0000,0000,karaoke,Бұл ұят, сондықтан сұрамаңыз.
Dialogue: 0,0:01:24.48,0:01:29.32,JPOP,,0000,0000,0000,karaoke,Сізді бір-біріңізге тартатын махаббат
Dialogue: 0,0:01:29.67,0:01:34.14,JPOP,,0000,0000,0000,karaoke,Ол әлдеқашан басталған болатын
Dialogue: 0,0:01:35.16,0:01:37.52,JPOP,,0000,0000,0000,karaoke,Мен көптеген армандарды көрдім
Dialogue: 0,0:01:37.55,0:01:41.43,JPOP,,0000,0000,0000,karaoke,Оянсам да, сені көргім келеді.
Dialogue: 0,0:01:41.43,0:01:43.64,JPOP,,0000,0000,0000,karaoke,Сіз мұны жасадыңыз
Dialogue: 0,0:01:43.64,0:01:46.05,JPOP,,0000,0000,0000,karaoke,Махаббат сараңдық, солай емес пе?
Dialogue: 0,0:01:46.05,0:01:51.62,JPOP,,0000,0000,0000,karaoke,Бізді секіртетін жүрекке ерейік
Dialogue: 0,0:01:51.62,0:01:54.23,JPOP,,0000,0000,0000,karaoke,Идеалдар, адасушылықтар және шындық
Dialogue: 0,0:01:54.35,0:01:56.86,JPOP,,0000,0000,0000,karaoke,Барлығы сіздің айналаңызда айналады
Dialogue: 0,0:01:57.09,0:02:02.21,JPOP,,0000,0000,0000,karaoke,Жаңа әлемге
