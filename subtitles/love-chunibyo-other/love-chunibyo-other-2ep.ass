Dialogue: 0,0:00:51.62,0:00:55.59,ZWOP,,0000,0000,0000,fx,Сіз екі көзбен осы сәттесіз
Dialogue: 0,0:00:55.84,0:01:02.38,ZWOP,,0000,0000,0000,fx,Қозғалмас бұрын, сіз қайда екеніңізді көре аласыз.
Dialogue: 0,0:01:02.60,0:01:06.63,ZWOP,,0000,0000,0000,fx,Менің тұмсығыма қара
Dialogue: 0,0:01:06.85,0:01:12.17,ZWOP,,0000,0000,0000,fx,Жиналыстың сұрағы `` Мен мұны істегім келеді '' Сондай-ақ, үндемеңіз.
Dialogue: 0,0:01:12.52,0:01:17.87,ZWOP,,0000,0000,0000,fx,Моңғолияның өз-өзімен сөйлесуі
Dialogue: 0,0:01:18.36,0:01:23.78,ZWOP,,0000,0000,0000,fx,Но тағы да қажет емес.
Dialogue: 0,0:01:24.48,0:01:29.32,ZWOP,,0000,0000,0000,fx,Өзара тартымдылық махаббат
Dialogue: 0,0:01:29.67,0:01:34.14,ZWOP,,0000,0000,0000,fx,Жаңа ғана басталды
Dialogue: 0,0:01:35.16,0:01:37.52,ZWOP,,0000,0000,0000,fx,Шексіз әдемі армандар
Dialogue: 0,0:01:37.55,0:01:41.43,ZWOP,,0000,0000,0000,fx,Бұл түстен оянғаннан кейін де оны көру керек.
Dialogue: 0,0:01:41.43,0:01:43.64,ZWOP,,0000,0000,0000,fx,Капитал зиянды
Dialogue: 0,0:01:43.64,0:01:46.05,ZWOP,,0000,0000,0000,fx,Махаббат - махаббаттың шынайы табиғаты.
Dialogue: 0,0:01:46.05,0:01:51.62,ZWOP,,0000,0000,0000,fx,Будда мен баланың ішкі ойлары секіріп кетеді.
Dialogue: 0,0:01:51.62,0:01:54.23,ZWOP,,0000,0000,0000,fx,Күмән жоқ - идеал, адасушылық - шындық
Dialogue: 0,0:01:54.35,0:01:56.86,ZWOP,,0000,0000,0000,fx,Барлық астаналар сіздің кезегіңізге келді.
Dialogue: 0,0:01:57.09,0:02:02.21,ZWOP,,0000,0000,0000,fx,Дүниеден жаңа кету
Dialogue: 0,0:22:16.78,0:22:19.29,JPED,,0000,0000,0000,,INSIDE Identity
Dialogue: 0,0:22:19.29,0:22:21.06,JPED,,0000,0000,0000,,Сіздің орныңыз қай жерде?
Dialogue: 0,0:22:31.99,0:22:34.70,JPED,,0000,0000,0000,,Түсініспеушілік ұят па?
Dialogue: 0,0:22:34.70,0:22:37.03,JPED,,0000,0000,0000,,Адалдық ауыртады
Dialogue: 0,0:22:37.16,0:22:39.92,JPED,,0000,0000,0000,,Кім не айтса да
Dialogue: 0,0:22:39.92,0:22:42.34,JPED,,0000,0000,0000,,Мен ненің дұрыс екенін білмеймін
Dialogue: 0,0:22:42.34,0:22:45.16,JPED,,0000,0000,0000,,Әдеттегідей ағып жатқан күнделікті өмірде
Dialogue: 0,0:22:45.28,0:22:47.51,JPED,,0000,0000,0000,,Мен өзімді соған үйренуге мәжбүр еттім.
Dialogue: 0,0:22:47.51,0:22:50.01,JPED,,0000,0000,0000,,Суға батқан тұлға және қан
Dialogue: 0,0:22:50.01,0:22:52.51,JPED,,0000,0000,0000,,Шайнаңыз, ішіңіз, түкіріңіз және сындырыңыз
Dialogue: 0,0:22:52.51,0:22:57.68,JPED,,0000,0000,0000,,Мені осылай түсінгеніңізді қалаймын
Dialogue: 0,0:22:57.68,0:23:02.81,JPED,,0000,0000,0000,,Мен бірдеңе айтқым келеді, бірақ айта алмаймын.
Dialogue: 0,0:23:02.81,0:23:07.44,JPED,,0000,0000,0000,,Неге ешкім түсінбейді?
Dialogue: 0,0:23:07.44,0:23:12.45,JPED,,0000,0000,0000,,Ойлану сән-салтанат па? Солай ма?
Dialogue: 0,0:23:12.67,0:23:18.16,JPED,,0000,0000,0000,,Эмоциялық күн
Dialogue: 0,0:23:18.16,0:23:20.73,JPED,,0000,0000,0000,,Тым көп қызу
Dialogue: 0,0:23:20.73,0:23:22.92,JPED,,0000,0000,0000,,Әйтеуір шешетін сияқты
Dialogue: 0,0:23:22.92,0:23:28.08,JPED,,0000,0000,0000,,Айқайлағым келеді
Dialogue: 0,0:23:28.08,0:23:34.00,JPED,,0000,0000,0000,,ТҮСІМДІЛІК қатты іздейді
Dialogue: 0,0:23:34.01,0:23:36.76,JPED,,0000,0000,0000,,INSIDE Identity
Dialogue: 0,0:23:36.76,0:23:39.29,JPED,,0000,0000,0000,,ӘДІЛЕТІМНІҢ ІШІНДЕ
Dialogue: 0,0:23:39.29,0:23:41.73,JPED,,0000,0000,0000,,Маған кедергі жасама
Dialogue: 0,0:23:41.73,0:23:44.65,JPED,,0000,0000,0000,,Сіздің орныңыз қай жерде?
Dialogue: 0,0:22:16.78,0:22:19.29,ZWED,,0000,0000,0000,,INSIDE IDENTITY
Dialogue: 0,0:22:19.29,0:22:21.06,ZWED,,0000,0000,0000,,Қараған жерің – өмір сүретін жерің.
Dialogue: 0,0:22:31.99,0:22:34.70,ZWED,,0000,0000,0000,,Кездесуде мен аудиториядан алған әсерім үшін ұяламын.
Dialogue: 0,0:22:34.70,0:22:37.03,ZWED,,0000,0000,0000,,Ашық шолу
Dialogue: 0,0:22:37.16,0:22:39.92,ZWED,,0000,0000,0000,,Бұған күмән жоқ
Dialogue: 0,0:22:39.92,0:22:42.34,ZWED,,0000,0000,0000,,Байлығымның түзелетініне сенімдімін.
Dialogue: 0,0:22:42.34,0:22:45.16,ZWED,,0000,0000,0000,,Өзін-өзі анықтауды зерттеңіз
Dialogue: 0,0:22:45.28,0:22:47.51,ZWED,,0000,0000,0000,,Хико Ичиту Фукан
Dialogue: 0,0:22:47.51,0:22:50.01,ZWED,,0000,0000,0000,,Генералдың толық эго және қан
Dialogue: 0,0:22:50.01,0:22:52.51,ZWED,,0000,0000,0000,,Шайнау, жұту, түкіру, ойнау
Dialogue: 0,0:22:52.51,0:22:57.68,ZWED,,0000,0000,0000,,Сіз мұны түсінесіз деп үміттенемін.
Dialogue: 0,0:22:57.68,0:23:02.81,ZWED,,0000,0000,0000,,Күтпеген ойлар ашылуы мүмкін.
Dialogue: 0,0:23:02.81,0:23:07.44,ZWED,,0000,0000,0000,,Мен адам қалмағанын түсінемін.
Dialogue: 0,0:23:07.44,0:23:12.45,ZWED,,0000,0000,0000,,Түсінікті болғың келсе, сабыр ет.
Dialogue: 0,0:23:12.67,0:23:18.16,ZWED,,0000,0000,0000,,Бұл эмоционалды күн
Dialogue: 0,0:23:18.16,0:23:20.73,ZWED,,0000,0000,0000,,Радиациялық жылу сыйымдылығы
Dialogue: 0,0:23:20.73,0:23:22.92,ZWED,,0000,0000,0000,,Өзін ләззатқа ұшырататын теріс қылықтар
Dialogue: 0,0:23:22.92,0:23:28.08,ZWED,,0000,0000,0000,,Ойлар мен әрекеттерді заңсыз басу
Dialogue: 0,0:23:28.08,0:23:34.00,ZWED,,0000,0000,0000,,ТҰРҒЫНДАР
Dialogue: 0,0:23:34.01,0:23:36.76,ZWED,,0000,0000,0000,,INSIDE IDENTITY
Dialogue: 0,0:23:36.76,0:23:39.29,ZWED,,0000,0000,0000,,ӘДІЛЕТІМНІҢ ІШІНДЕ
Dialogue: 0,0:23:39.29,0:23:41.73,ZWED,,0000,0000,0000,,Қажетсіз кедергі
Dialogue: 0,0:23:41.73,0:23:44.65,ZWED,,0000,0000,0000,,Қараған жерің – өмір сүретін жерің.
Dialogue: 0,0:02:06.98,0:02:16.94,ZZ信息,,0000,0000,0000,,Бұл субтитрлер топтамасы субтитрлер тобында көрсетіледі және көбірек қытай, жапон және қытай субтитрлері алмасу үшін қолжетімді. www.kamigami.org
