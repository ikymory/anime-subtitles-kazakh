Dialogue: 0,0:00:00.00,0:00:05.00,Default,,0000,0000,0000,,

Dialogue: 0,0:00:02.78,0:00:05.14,JPDB,,0000,0000,0000,,Мен біраз уақыт жалғыз қалдым, сондықтан мен мүлдем үлгере алмадым.
Dialogue: 0,0:00:05.98,0:00:07.65,JPDB,,0000,0000,0000,,Бұл толығымен байланысты.
Dialogue: 0,0:00:10.66,0:00:12.05,JPDB,,0000,0000,0000,,Эй, маған кедергі жасама.
Dialogue: 0,0:00:20.50,0:00:25.00,JPDB,,0000,0000,0000,,Юта Юта Юта қолдауы
Dialogue: 0,0:00:25.55,0:00:26.19,JPDB,,0000,0000,0000,,Сіз білесіз бе?
Dialogue: 0,0:00:30.44,0:00:33.03,JPDB,,0000,0000,0000,,Шұғыл әрекет ету үшін бір талап бар.
Dialogue: 0,0:00:33.03,0:00:34.67,JPDB,,0000,0000,0000,,Сіз оны қате пайдаланып жатырсыз.
Dialogue: 0,0:00:34.99,0:00:36.90,JPDB,,0000,0000,0000,,Мен ұйымға арналған киім үлгісін жасадым.
Dialogue: 0,0:00:37.20,0:00:37.87,JPDB,,0000,0000,0000,,Біркелкі?
Dialogue: 0,0:00:39.04,0:00:43.04,JPDB,,0000,0000,0000,,Бұл әрекет кезінде киіледі және ``Қара жалын'' деп оқылады.
Dialogue: 0,0:00:43.56,0:00:47.54,JPDB,,0000,0000,0000,,Мен мұны «Жаман көз» деп оқыдым
Dialogue: 0,0:00:48.96,0:00:50.55,JPDB,,0000,0000,0000,,Ертеңгі әрекеттерден бастайық
Dialogue: 0,0:00:50.70,0:00:54.70,JPDB,,0000,0000,0000,,Мен сізге айттым, мен ондай нәрсені бітіріп қойғанмын.
Dialogue: 0,0:00:56.41,0:00:57.46,JPDB,,0000,0000,0000,,Бұл Ютаның мінезі
Dialogue: 0,0:00:57.46,0:00:58.75,JPDB,,0000,0000,0000,,Жақсы... жақсы.
Dialogue: 0,0:00:59.05,0:01:00.69,JPDB,,0000,0000,0000,,Аты «Сецуна»
Dialogue: 0,0:01:00.69,0:01:02.13,JPDB,,0000,0000,0000,,Ойында жақсы ма?
Dialogue: 0,0:01:05.61,0:01:07.95,JPDB,,0000,0000,0000,,Міне, діни қызметкер қайтып келді.
Dialogue: 0,0:01:08.97,0:01:11.23,JPDB,,0000,0000,0000,,Ертең таңғы сағат 7:00-де В кездесу нүктесінде
Dialogue: 0,0:01:22.91,0:01:23.63,JPDB,,0000,0000,0000,,Астанада ханым Куруш оларды қор ретінде жинап жатқанын естідім.
Dialogue: 0,0:03:05.36,0:03:07.69,JPDB,,0000,0000,0000,,Сіз, қазірдің өзінде шілде.
Dialogue: 0,0:03:08.74,0:03:12.86,JPDB,,0000,0000,0000,,Параметрлеріңізді түсінетін жалғыз адаммын, сондықтан оған көмектесу мүмкін емес.
Dialogue: 0,0:03:13.68,0:03:16.02,JPDB,,0000,0000,0000,,Басқа жігіттермен сөйлесіп көріңіз.
Dialogue: 0,0:03:17.73,0:03:21.21,JPDB,,0000,0000,0000,,Ютадан басқа мен Декомори, Кумин және Нибутанимен де сөйлесіп жатырмын.
Dialogue: 0,0:03:21.76,0:03:24.17,JPDB,,0000,0000,0000,,Бұл дұрыс, бірақ басқа нәрселер де бар.
Dialogue: 0,0:03:24.45,0:03:28.92,JPDB,,0000,0000,0000,,Юта да сабақта мен және Исшики Нибутани сияқты нәрселер туралы айтады.
Dialogue: 0,0:03:29.27,0:03:30.24,JPDB,,0000,0000,0000,,Ол енді ғана тозақтан оралды.
Dialogue: 0,0:03:30.91,0:03:32.72,JPDB,,0000,0000,0000,,Мен бірінші кезекте топтастыруды ұнатпаймын.
Dialogue: 0,0:03:34.91,0:03:37.27,JPDB,,0000,0000,0000,,Бұл азап, бірақ мені жалғыз қалдыр...
Dialogue: 0,0:03:38.12,0:03:42.32,JPDB,,0000,0000,0000,,Қазіргі кеңістікте мен ғана мені танимын.
Dialogue: 0,0:03:45.60,0:03:47.34,JPDB,,0000,0000,0000,,Тогаши-кунның суреті жақсы.
Dialogue: 0,0:03:47.44,0:03:47.66,JPDB,,0000,0000,0000,,Иә?
Dialogue: 0,0:03:48.23,0:03:49.97,JPDB,,0000,0000,0000,,Бұл Которию-сан сүйкімді
Dialogue: 0,0:03:50.14,0:03:51.41,JPDB,,0000,0000,0000,,Менің ойымша, солай.
Dialogue: 0,0:03:51.61,0:03:56.01,JPDB,,0000,0000,0000,,Бұлардың қайсысы дұрыс? Тогаши-кун, сен манга немесе бірдеңе саласың ба?
Dialogue: 0,0:03:56.36,0:03:58.15,JPDB,,0000,0000,0000,,Жоқ, жоқ, шынымен емес.
Dialogue: 0,0:03:58.94,0:04:01.48,JPDB,,0000,0000,0000,,Кіші мектеп оқушысы кезімде мен көптеген иллюстрациялар салатынмын.
Dialogue: 0,0:04:02.62,0:04:04.34,JPDB,,0000,0000,0000,,Салқын
Dialogue: 0,0:04:04.34,0:04:06.25,JPDB,,0000,0000,0000,,Шынымен бе? Маған көрсет
Dialogue: 0,0:04:07.79,0:04:09.21,JPDB,,0000,0000,0000,,Бұл Тогаши-кун ба?
Dialogue: 0,0:04:09.58,0:04:10.57,JPDB,,0000,0000,0000,,Шайқаста
Dialogue: 0,0:04:10.85,0:04:11.74,JPDB,,0000,0000,0000,,Ұрыста ма?
Dialogue: 0,0:04:16.81,0:04:20.02,JPDB,,0000,0000,0000,,Өлім алдында тұрған күйден шыққан толыққанды қараңғы жалын.
Dialogue: 0,0:04:20.17,0:04:21.04,JPDB,,0000,0000,0000,,Оны айтпа
Dialogue: 0,0:04:21.73,0:04:23.00,JPDB,,0000,0000,0000,,“Қара жалын”
Dialogue: 0,0:04:23.45,0:04:25.29,JPDB,,0000,0000,0000,,Мен оны дауыстап айта алмаймын, бірақ
Dialogue: 0,0:04:25.29,0:04:27.95,JPDB,,0000,0000,0000,,«Қара жалын» - Ютаның ең үлкен шабуыл сиқыры
Dialogue: 0,0:04:28.25,0:04:29.61,JPDB,,0000,0000,0000,,Осымен Юта...
Dialogue: 0,0:04:32.82,0:04:33.49,JPDB,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:04:36.65,0:04:37.84,JPDB,,0000,0000,0000,,Аа, дәл осы.
Dialogue: 0,0:04:38.01,0:04:41.00,JPDB,,0000,0000,0000,,Кез келген уақытта сақтығыңызды төмендетпеңіз, жалған Морисама
Dialogue: 0,0:04:41.00,0:04:42.46,JPDB,,0000,0000,0000,,Морисама деп айтпаңыз
Dialogue: 0,0:04:43.06,0:04:44.80,JPDB,,0000,0000,0000,,Жақсысың ба? Нибутани мырза
Dialogue: 0,0:04:46.61,0:04:47.26,JPDB,,0000,0000,0000,,Сіз бір-біріңізді танисыз ба?
Dialogue: 0,0:04:47.78,0:04:48.75,JPDB,,0000,0000,0000,,Келіңіздер... келіңіздер.
Dialogue: 0,0:04:49.20,0:04:51.01,JPDB,,0000,0000,0000,,Оны кішілер де жақсы көреді.
Dialogue: 0,0:04:52.65,0:04:53.85,JPDB,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:04:54.32,0:04:54.84,JPDB,,0000,0000,0000,,Юта
Dialogue: 0,0:04:56.93,0:04:57.85,JPDB,,0000,0000,0000,,Содан кейін кезекте тұрғандарды жақсылап ұрып, ақшаларын тартып алады
Dialogue: 0,0:04:58.37,0:05:00.71,JPDB,,0000,0000,0000,,Сабақтан кейін біраз уақыт бере аламын ба?
Dialogue: 0,0:05:02.22,0:05:04.01,JPDB,,0000,0000,0000,,Не, сізге махаббат хаты келді ме?
Dialogue: 0,0:05:05.13,0:05:06.00,JPDB,,0000,0000,0000,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:05:06.37,0:05:08.88,JPDB,,0000,0000,0000,,Сіз көптен күткен шығарсыз.
Dialogue: 0,0:05:09.06,0:05:10.35,JPDB,,0000,0000,0000,,Неге үрейленіп жатырсыз?
Dialogue: 0,0:05:10.35,0:05:13.48,JPDB,,0000,0000,0000,,Өйткені... бұл шынымен келеді деп ешқашан ойламадым.
Dialogue: 0,0:05:13.85,0:05:15.69,JPDB,,0000,0000,0000,,Неліктен Моға жүгінуге тырысып жатырсыз?
Dialogue: 0,0:05:15.87,0:05:17.36,JPDB,,0000,0000,0000,,Өйткені бұл гитара.
Dialogue: 0,0:05:17.85,0:05:20.51,JPDB,,0000,0000,0000,,Егер сіз бағаланып жатсаңыз, бұл музыкамен айналысқаныңыз үшін.
Dialogue: 0,0:05:20.74,0:05:24.12,JPDB,,0000,0000,0000,,Бірақ мен әлі де көп ойнай алмаймын, не істеуім керек?
Dialogue: 0,0:05:24.12,0:05:28.47,JPDB,,0000,0000,0000,,Әзірше кете аласыз ба? Барлығы толығымен құлап қалды.
Dialogue: 0,0:05:28.89,0:05:32.77,JPDB,,0000,0000,0000,,Бұл кіші аккорд. Әйелдер туралы айтатын болсақ, бұл кіші аккорд.
Dialogue: 0,0:05:32.97,0:05:34.61,JPDB,,0000,0000,0000,,Сізде қандай білім бар? Тынышталыңыз.
Dialogue: 0,0:05:34.61,0:05:35.85,JPDB,,0000,0000,0000,,Бұл мүмкін емес деп айтпаңыз
Dialogue: 0,0:05:36.64,0:05:40.82,JPDB,,0000,0000,0000,,Мен жайбарақат барамын. 1-сұрақ: Бұл шынымен махаббат хаты ма?
Dialogue: 0,0:05:41.39,0:05:43.01,JPDB,,0000,0000,0000,,Демек, сіз иә дейсіз.
Dialogue: 0,0:05:43.48,0:05:46.54,JPDB,,0000,0000,0000,,2-сұрақ: Бұл баланың еркелігі емес пе?
Dialogue: 0,0:05:46.71,0:05:48.30,JPDB,,0000,0000,0000,,Мына шеңбер кейіпкеріне қараңыз.
Dialogue: 0,0:05:48.85,0:05:52.87,JPDB,,0000,0000,0000,,«Мен осы сенбіде мектептен кейін гинкго ағашының астында күтемін».
Dialogue: 0,0:05:53.20,0:05:54.22,JPDB,,0000,0000,0000,,Эй, эй
Dialogue: 0,0:05:56.35,0:06:00.78,JPDB,,0000,0000,0000,,3-сұрақ: Бұл ұлдар мен қыздар сөз байласып жатыр дегенді білдіре ме?
Dialogue: 0,0:06:01.47,0:06:03.34,JPDB,,0000,0000,0000,,Сіз адамдарға сенбейсіз бе?
Dialogue: 0,0:06:04.43,0:06:05.38,JPDB,,0000,0000,0000,,Көп нәрсе болды.
Dialogue: 0,0:06:06.00,0:06:10.72,JPDB,,0000,0000,0000,,Эй, бұл кім деп ойлайсың? Хатта біз сыныптаспыз деп жазылған.
Dialogue: 0,0:06:11.22,0:06:12.98,JPDB,,0000,0000,0000,,Ең бастысы менің атым жоқ.
Dialogue: 0,0:06:13.55,0:06:15.07,JPDB,,0000,0000,0000,,Сізде қандай да бір ой бар ма?
Dialogue: 0,0:06:15.44,0:06:22.30,JPDB,,0000,0000,0000,,Бұл... Хираката Икутенмоку Цуяко Мен олай ойламаймын.
Dialogue: 0,0:06:22.50,0:06:23.40,JPDB,,0000,0000,0000,,Мүмкін емес.
Dialogue: 0,0:06:23.69,0:06:25.56,JPDB,,0000,0000,0000,,Бірақ мен оны айту керек болсам
Dialogue: 0,0:06:25.86,0:06:26.38,JPDB,,0000,0000,0000,,Мен не айтуым керек?
Dialogue: 0,0:06:26.87,0:06:27.62,JPDB,,0000,0000,0000,,Нибутани?
Dialogue: 0,0:06:28.34,0:06:30.35,JPDB,,0000,0000,0000,,Жоқ, қарашы, бұл Нибутани.
Dialogue: 0,0:06:30.63,0:06:33.64,JPDB,,0000,0000,0000,,Біз көзбен байланысқан кезде ол осылай күледі.
Dialogue: 0,0:06:33.96,0:06:37.21,JPDB,,0000,0000,0000,,Мінезі байсалды, орынды дер едім.
Dialogue: 0,0:06:37.59,0:06:41.24,JPDB,,0000,0000,0000,,Сол себепті музыка ойнайтын адамдардың жабайылығы мені қызықтырды.
Dialogue: 0,0:06:41.24,0:06:42.96,JPDB,,0000,0000,0000,,Жоқ, жоқ, жоқ…
Dialogue: 0,0:06:42.96,0:06:44.40,JPDB,,0000,0000,0000,,Неге олай дейсің?
Dialogue: 0,0:06:44.40,0:06:47.33,JPDB,,0000,0000,0000,,Жоқ, мен дәл осыны айта аламын.
Dialogue: 0,0:06:47.43,0:06:48.62,JPDB,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:06:49.27,0:06:52.52,JPDB,,0000,0000,0000,,Мен сені Нибутанимен бірге боламын деп ешқашан ойламадым...
Dialogue: 0,0:06:52.70,0:06:53.57,JPDB,,0000,0000,0000,,Бұл емес
Dialogue: 0,0:06:54.99,0:06:58.66,JPDB,,0000,0000,0000,,Нибутани екеуіңіз, әрине, жақсы сәйкестік емессіздер.
Dialogue: 0,0:06:59.01,0:06:59.93,JPDB,,0000,0000,0000,,Сіз айтасыз.
Dialogue: 0,0:07:00.18,0:07:03.51,JPDB,,0000,0000,0000,,Қалай болғанда да, маған хат жіберген қыздың кім екенін білгім келеді.
Dialogue: 0,0:07:03.61,0:07:08.08,JPDB,,0000,0000,0000,,Қараңызшы, егер мен адамдардан тікелей сұрасам, сіз жалғыз екенсіз дер едім.
Dialogue: 0,0:07:08.38,0:07:10.30,JPDB,,0000,0000,0000,,Бұл күні асыға күтетін нәрсе болса жақсы болар еді.
Dialogue: 0,0:07:10.42,0:07:12.71,JPDB,,0000,0000,0000,,Идиот Мен алғаш танысқан қызға
Dialogue: 0,0:07:12.71,0:07:15.74,JPDB,,0000,0000,0000,,Мен ad-libs тыңдап, жақсы жауап бере аламын деп ойлайсыз ба?
Dialogue: 0,0:07:15.94,0:07:19.34,JPDB,,0000,0000,0000,,Киодо сәтсіздікке ұшырайды, солай емес пе?
Dialogue: 0,0:07:19.69,0:07:22.25,JPDB,,0000,0000,0000,,Тым сенімді болмаңыз және сенімсіздігіңізді көрсетпеңіз.
Dialogue: 0,0:07:24.54,0:07:28.44,JPDB,,0000,0000,0000,,Қап қараңғылықпен қоршалған қараңғылық күші шынымен де төмендеп келеді.
Dialogue: 0,0:07:28.99,0:07:30.85,JPDB,,0000,0000,0000,,​​Менің ойымша, бұл түнгі киімге өте ыңғайлы.
Dialogue: 0,0:07:29.63,0:07:32.47,JPDB,,0000,0000,0000,,Дегенмен, бұл жігіттер білмейді деп ойлаймын.
Dialogue: 0,0:07:33.48,0:07:36.57,JPDB,,0000,0000,0000,,Мұны киген кезде, өзіңізді дұрыс көрсетіңіз.
Dialogue: 0,0:07:38.03,0:07:42.41,JPDB,,0000,0000,0000,,Evil King True Eye пайдаланушы қоғамының саны Zero Rikka Kotoriyu
Dialogue: 0,0:07:43.25,0:07:49.71,JPDB,,0000,0000,0000,,Зұлым патшаның қызметшісі True Eye Mjolnir Hammer пайдаланушы қоғамының нөмірі Zero Санае Демори
Dialogue: 0,0:07:50.26,0:07:55.63,JPDB,,0000,0000,0000,,Қорқынышты жарық Siesta қоғамы саны нөл 7 мамыр Кумин
Dialogue: 0,0:07:56.62,0:07:57.34,JPDB,,0000,0000,0000,,Шешім
Dialogue: 0,0:07:57.57,0:07:58.24,JPDB,,0000,0000,0000,,Бұл...
Dialogue: 0,0:07:58.46,0:08:00.28,JPDB,,0000,0000,0000,,Сандық сақиналардың астарында мағына бар ма?
Dialogue: 0,0:08:00.70,0:08:02.79,JPDB,,0000,0000,0000,,Өйткені, нөл саны керемет.
Dialogue: 0,0:08:03.23,0:08:05.15,JPDB,,0000,0000,0000,,Менің ойыма нөлден басқа ештеңе келмейді.
Dialogue: 0,0:08:05.60,0:08:07.86,JPDB,,0000,0000,0000,,Мен сенімді емеспін, бірақ бұл керемет шығар
Dialogue: 0,0:08:08.01,0:08:08.55,JPDB,,0000,0000,0000,,Және...
Dialogue: 0,0:08:10.84,0:08:13.50,JPDB,,0000,0000,0000,,Нөлге қайсысы қолайлырақ екенін осы жерден шешіңіз.
Dialogue: 0,0:08:13.75,0:08:15.31,JPDB,,0000,0000,0000,,Менің қалағаным осы
Dialogue: 0,0:08:17.03,0:08:17.67,JPDB,,0000,0000,0000,,Сіз мұны істей аласыз
Dialogue: 0,0:08:18.10,0:08:19.17,JPDB,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:08:19.49,0:08:21.18,JPDB,,0000,0000,0000,,Үлкендеріңізге мінбеңіздер.
Dialogue: 0,0:08:22.42,0:08:25.83,JPDB,,0000,0000,0000,,Иә, бірақ Тогаши-кун, мына көйлек астына қара.
Dialogue: 0,0:08:25.83,0:08:29.06,JPDB,,0000,0000,0000,,О, жоқ, менде киім жоқ.
Dialogue: 0,0:08:29.43,0:08:30.72,JPDB,,0000,0000,0000,,Юта киіп жүр
Dialogue: 0,0:08:30.97,0:08:31.59,JPDB,,0000,0000,0000,,Жолтайым Құдай
Dialogue: 0,0:08:33.61,0:08:35.77,JPDB,,0000,0000,0000,,Бакачубо
Dialogue: 0,0:08:36.54,0:08:37.73,JPDB,,0000,0000,0000,,Ақыры осында.
Dialogue: 0,0:08:38.18,0:08:40.94,JPDB,,0000,0000,0000,,Ақыр соңында, ақымақ екеніңді өзіңе еске салудан басқа амалың жоқ.
Dialogue: 0,0:08:42.11,0:08:43.90,JPDB,,0000,0000,0000,,Бұл «ақ су»
Dialogue: 0,0:08:44.22,0:08:49.41,JPDB,,0000,0000,0000,,Дәмі мен хош иісі аузыма таралуы үшін оны қыздырамын.
Dialogue: 0,0:08:49.69,0:08:54.58,JPDB,,0000,0000,0000,,Сен шайтансың ба? О, жоқ, бұл жағдайда Декомори қараңғылықта.
Dialogue: 0,0:08:54.78,0:08:57.07,JPDB,,0000,0000,0000,,Сен періштесің бе?
Dialogue: 0,0:08:57.27,0:08:59.11,JPDB,,0000,0000,0000,,Екеуі де жақсы.
Dialogue: 0,0:09:00.00,0:09:01.84,JPDB,,0000,0000,0000,,Жүр, іш, іш.
Dialogue: 0,0:09:01.84,0:09:03.21,JPDB,,0000,0000,0000,,Тоқта, тоқта.
Dialogue: 0,0:09:03.23,0:09:06.29,JPDB,,0000,0000,0000,,Сәттілік, Деко-чан, Деко-чан
Dialogue: 0,0:09:04.35,0:09:06.29,JPDB,,0000,0000,0000,,Hooraho hora
Dialogue: 0,0:09:06.34,0:09:07.48,JPDB,,0000,0000,0000,,Эй Нибутани
Dialogue: 0,0:09:07.73,0:09:10.17,JPDB,,0000,0000,0000,,Неліктен қазір бос емессіз? Ауызыңды жап.
Dialogue: 0,0:09:10.17,0:09:11.36,JPDB,,0000,0000,0000,,Жоқ, бірақ келіңіз.
Dialogue: 0,0:09:11.71,0:09:14.84,JPDB,,0000,0000,0000,,Бұл не? Сіз өте шулысыз. Егер мен сізді алаңдатсам, сіз де...
Dialogue: 0,0:09:17.32,0:09:18.07,JPDB,,0000,0000,0000,,Иә... иә
Dialogue: 0,0:09:18.22,0:09:20.61,JPDB,,0000,0000,0000,,О, Исшики-кун, не болды?
Dialogue: 0,0:09:21.23,0:09:21.90,JPDB,,0000,0000,0000,,Иә?
Dialogue: 0,0:09:22.30,0:09:24.73,JPDB,,0000,0000,0000,,Жоқ, мен Ютамен біраз кеңестім.
Dialogue: 0,0:09:25.08,0:09:28.41,JPDB,,0000,0000,0000,,Иә...дұрыс, мен таң қалдым...
Dialogue: 0,0:09:29.65,0:09:31.54,JPDB,,0000,0000,0000,,Сіз тамаша жұмыс жасадыңыз.
Dialogue: 0,0:09:32.01,0:09:35.47,JPDB,,0000,0000,0000,,Ақ суың әлдеқашан жоғалып кетті.
Dialogue: 0,0:09:36.84,0:09:38.70,JPDB,,0000,0000,0000,,Мен сені көріп тұрмын, жалған Морисама
Dialogue: 0,0:09:39.20,0:09:42.30,JPDB,,0000,0000,0000,,Өлім сені шексіз күш көкжиегіне жетелейді.
Dialogue: 0,0:09:42.68,0:09:43.55,JPDB,,0000,0000,0000,,Морисама?
Dialogue: 0,0:09:43.70,0:09:47.12,JPDB,,0000,0000,0000,,Маған қызық, ол қызық бала екен.
Dialogue: 0,0:09:47.67,0:09:51.77,JPDB,,0000,0000,0000,,«Мабиногион» жеті түсті қолжазба, 3-тарау, 1-тармақ
Dialogue: 0,0:09:53.04,0:09:57.76,JPDB,,0000,0000,0000,,«Рухтардың сыбырлары мен жарық пен судың ойлары бізге жеткенде.
Dialogue: 0,0:09:58.33,0:10:00.75,JPDB,,0000,0000,0000,,Ақ дүние ашылады».
Dialogue: 0,0:10:01.44,0:10:05.44,JPDB,,0000,0000,0000,,«Әлемді 400 жыл бақылап отырып, мен мұны түсінемін
Dialogue: 0,0:10:06.24,0:10:12.53,JPDB,,0000,0000,0000,,Бұл дүниеге ең қажет нәрсе – махаббат».
Dialogue: 0,0:10:12.82,0:10:16.10,JPDB,,0000,0000,0000,,Тоқта, мен мұны естігім келмейді.
Dialogue: 0,0:10:14.99,0:10:16.08,JPDB,,0000,0000,0000,,Содан кейін кезекте тұрғандарды жақсылап ұрып, ақшаларын тартып алады
Dialogue: 0,0:10:17.67,0:10:21.70,JPDB,,0000,0000,0000,,​​Жасандылықтан күткендей, мен шынайы сөздерді естігенде бұзылдым.
Dialogue: 0,0:10:22.17,0:10:23.41,JPDB,,0000,0000,0000,,Морисама-чан қатты...
Dialogue: 0,0:10:23.41,0:10:24.21,JPDB,,0000,0000,0000,,Морисама деп айтпаңыз
Dialogue: 0,0:10:25.18,0:10:27.64,JPDB,,0000,0000,0000,,Сізге... Нибутани
Dialogue: 0,0:10:31.51,0:10:37.38,JPDB,,0000,0000,0000,,Жаңа ғана сабақта көргеніңді айтсаң, мен сені өлгенше қарғаймын.
Dialogue: 0,0:10:37.58,0:10:40.04,JPDB,,0000,0000,0000,,Біраз…
Dialogue: 0,0:10:53.51,0:10:56.02,JPDB,,0000,0000,0000,,Жел... келе жатыр
Dialogue: 0,0:11:06.19,0:11:10.83,JPDB,,0000,0000,0000,,Сіз қалай ойлайсыз? Мүмкін бұл еркелік шығар?
Dialogue: 0,0:11:11.58,0:11:14.61,JPDB,,0000,0000,0000,,Жоқ, оны шынымен де бір қыз жазған шығар.
Dialogue: 0,0:11:15.78,0:11:16.23,JPDB,,0000,0000,0000,,Бұл рас па?
Dialogue: 0,0:11:17.49,0:11:18.66,JPDB,,0000,0000,0000,,Оны кім жазғанын білесіз бе?
Dialogue: 0,0:11:19.01,0:11:20.01,JPDB,,0000,0000,0000,,Оған дейін...
Dialogue: 0,0:11:21.10,0:11:22.64,JPDB,,0000,0000,0000,,Бір көргеннен ғашық болу мүмкін бе?
Dialogue: 0,0:11:23.11,0:11:24.88,JPDB,,0000,0000,0000,,Бұл мүмкін деп ойлайсыз ба?
Dialogue: 0,0:11:25.52,0:11:26.04,JPDB,,0000,0000,0000,,Осыншама ма?
Dialogue: 0,0:11:26.17,0:11:27.39,JPDB,,0000,0000,0000,,Сіз жауап бересіз.
Dialogue: 0,0:11:28.03,0:11:32.16,JPDB,,0000,0000,0000,,Басқаша айтқанда, бұл қыздың жағдайы жақсы бола ма, жоқ па, бұл қазір маңызды.
Dialogue: 0,0:11:34.27,0:11:38.07,JPDB,,0000,0000,0000,,Иә, мен бүгін көргенімді ұмытып кеттім.
Dialogue: 0,0:11:38.55,0:11:39.37,JPDB,,0000,0000,0000,,Ой, әкеміз келген сияқты.
Dialogue: 0,0:11:39.81,0:11:42.72,JPDB,,0000,0000,0000,,Керемет, кездескенше
Dialogue: 0,0:11:45.16,0:11:46.70,JPDB,,0000,0000,0000,,Сонымен, біз не істейміз?
Dialogue: 0,0:11:49.18,0:11:51.59,JPDB,,0000,0000,0000,,Дұрыс, қолымнан келгенше тырысамын.
Dialogue: 0,0:11:52.86,0:11:58.33,JPDB,,0000,0000,0000,,Кім келсе де, сенбіге дейін сыныптағы барлық қыздарға модельдеу жасаңыз.
Dialogue: 0,0:11:58.90,0:12:00.54,JPDB,,0000,0000,0000,,Жауап беруге дайын болыңыз
Dialogue: 0,0:12:01.26,0:12:01.83,JPDB,,0000,0000,0000,,Ә... ә... білесің бе...
Dialogue: 0,0:12:02.53,0:12:05.44,JPDB,,0000,0000,0000,,Уайымдамаңыз, бұл "Сүйкімді қыздар чемпионаты"
Dialogue: 0,0:12:05.59,0:12:08.99,JPDB,,0000,0000,0000,,Қыздар туралы барлық ақпаратты мен өз сыныбымдағы ұлдардан алдым.
Dialogue: 0,0:12:10.66,0:12:12.62,JPDB,,0000,0000,0000,,Егер біз қазір бастасақ, біз оны міндетті түрде уақытында жасаймыз
Dialogue: 0,0:12:13.27,0:12:14.11,JPDB,,0000,0000,0000,,Исшики…
Dialogue: 0,0:12:18.01,0:12:21.42,JPDB,,0000,0000,0000,,Менің уақытым көп емес, сондықтан мен мұны мінемін.
Dialogue: 0,0:12:32.68,0:12:34.32,JPDB,,0000,0000,0000,,Не болды? Мен үйге бара жатырмын.
Dialogue: 0,0:12:36.31,0:12:38.37,JPDB,,0000,0000,0000,,Юта қолдары
Dialogue: 0,0:12:39.22,0:12:43.79,JPDB,,0000,0000,0000,,Иә, қолдар? иә?
Dialogue: 0,0:12:43.96,0:12:44.66,JPDB,,0000,0000,0000,,Тыныш отырыңыз
Dialogue: 0,0:13:06.43,0:13:07.05,JPDB,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:13:07.42,0:13:08.57,JPDB,,0000,0000,0000,,Жел деп аталады
Dialogue: 0,0:13:09.14,0:13:11.45,JPDB,,0000,0000,0000,,Жел? Ах...мм...
Dialogue: 0,0:13:11.95,0:13:13.29,JPDB,,0000,0000,0000,,Жел шулы
Dialogue: 0,0:13:13.49,0:13:15.18,JPDB,,0000,0000,0000,,Мүмкін бұл пойыздың дыбысы шығар.
Dialogue: 0,0:13:30.29,0:13:35.49,JPDB,,0000,0000,0000,,Демек, егер Иномат мырза тапқан бұл дәптерде жазылғаны рас болса.
Dialogue: 0,0:13:36.38,0:13:40.98,JPDB,,0000,0000,0000,,Бұл осы сыныптағы ұлдар қыздарды өз бетінше ретке келтіргенін білдіреді.
Dialogue: 0,0:13:41.25,0:13:43.34,JPDB,,0000,0000,0000,,Бұл қорқынышты, бұл қорқынышты.
Dialogue: 0,0:13:43.99,0:13:46.37,JPDB,,0000,0000,0000,,Сол кезде, станциядағы кешегі орындық
Dialogue: 0,0:13:48.01,0:13:52.24,JPDB,,0000,0000,0000,,Мүмкін, бірақ иесінің кім екенін әлі анықтаған жоқпыз.
Dialogue: 0,0:13:52.54,0:13:53.18,JPDB,,0000,0000,0000,,Басқа амал жоқ па?!
Dialogue: 0,0:13:53.58,0:13:57.26,JPDB,,0000,0000,0000,,Мен бұл туралы бір адамнан естігім келеді.
Dialogue: 0,0:14:02.50,0:14:03.10,JPDB,,0000,0000,0000,,Мера-кун
Dialogue: 0,0:14:03.10,0:14:04.02,JPDB,,0000,0000,0000,,Ой, әкеміз келген сияқты.
Dialogue: 0,0:14:05.63,0:14:10.01,JPDB,,0000,0000,0000,,Мера мырза, сіз осындай рейтинг құруға қатыстыңыз ба?
Dialogue: 0,0:14:10.50,0:14:12.82,JPDB,,0000,0000,0000,,Жоқ... жоқ, мм.
Dialogue: 0,0:14:14.90,0:14:15.43,JPDB,,0000,0000,0000,,Онда...
Dialogue: 0,0:14:16.02,0:14:16.57,JPDB,,0000,0000,0000,,Арима
Dialogue: 0,0:14:20.50,0:14:20.87,JPDB,,0000,0000,0000,,Ки…
Dialogue: 0,0:14:21.22,0:14:21.49,JPDB,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:14:22.09,0:14:23.58,JPDB,,0000,0000,0000,,Менің есімде жоқ.
Dialogue: 0,0:14:25.32,0:14:31.75,JPDB,,0000,0000,0000,,Бұл қауіпті, бұл қауіпті. Осы жағдайды ескерсек, оның ұйымдастырушысы мен екені белгілі болғаны – уақыт мәселесі.
Dialogue: 0,0:14:32.13,0:14:35.41,JPDB,,0000,0000,0000,,Егер бұл орын алса, менің әлі басталмаған махаббатым аяқталады
Dialogue: 0,0:14:36.85,0:14:38.54,JPDB,,0000,0000,0000,,Уақытқа оралып, қайта оралуға ғана жететін отын қалды
Dialogue: 0,0:14:39.24,0:14:42.17,JPDB,,0000,0000,0000,,Тоғашы мырзадан сұрау керек деп ойлаймын.
Dialogue: 0,0:14:42.52,0:14:42.99,JPDB,,0000,0000,0000,,Иә?
Dialogue: 0,0:14:42.99,0:14:45.03,JPDB,,0000,0000,0000,,​​Иә, мен төрағамын.
Dialogue: 0,0:14:46.17,0:14:47.51,JPDB,,0000,0000,0000,,Тоғаши-кун, сен қалай ойлайсың?
Dialogue: 0,0:14:48.53,0:14:50.27,JPDB,,0000,0000,0000,,(Сота) Онда менің үйіме барайық! Апама айтамын!
Dialogue: 0,0:14:50.47,0:14:51.64,JPDB,,0000,0000,0000,,Сіз білмейсіз бе?
Dialogue: 0,0:14:52.01,0:14:54.97,JPDB,,0000,0000,0000,,Ум, жоқ, солай.
Dialogue: 0,0:14:55.29,0:14:56.46,JPDB,,0000,0000,0000,,2-эпизод: Буггарати келеді
Dialogue: 0,0:14:59.34,0:14:59.91,JPDB,,0000,0000,0000,,Бұл менмін
Dialogue: 0,0:15:00.14,0:15:00.49,JPDB,,0000,0000,0000,,Иә?
Dialogue: 0,0:15:00.96,0:15:06.45,JPDB,,0000,0000,0000,,Мен мұны жаздым, мен рейтингтерді де жасадым.
Dialogue: 0,0:15:09.96,0:15:10.75,JPDB,,0000,0000,0000,,Исшики…
Dialogue: 0,0:15:10.75,0:15:12.47,JPDB,,0000,0000,0000,,Исшики-кун, бұл рас па?
Dialogue: 0,0:15:12.99,0:15:16.12,JPDB,,0000,0000,0000,,Иә, бірақ мені қате түсінбеңіз.
Dialogue: 0,0:15:16.52,0:15:18.63,JPDB,,0000,0000,0000,,Біз сабақта дауыс бермейміз.
Dialogue: 0,0:15:18.88,0:15:21.69,JPDB,,0000,0000,0000,,Мен мұны өзім жаздым.
Dialogue: 0,0:15:24.62,0:15:27.40,JPDB,,0000,0000,0000,,Кешіріңіз, бұл жай ғана көңіл көтеру үшін болды.
Dialogue: 0,0:15:27.80,0:15:35.36,JPDB,,0000,0000,0000,,Басқа ұлдардың қатысы жоқ. Бәрі мен кінәлімін.
Dialogue: 0,0:15:43.53,0:15:45.07,JPDB,,0000,0000,0000,,Қол соғатын жеріңіз осы ма?
Dialogue: 0,0:15:45.07,0:15:46.04,JPDB,,0000,0000,0000,,Дұрыс па?
Dialogue: 0,0:15:46.47,0:15:50.44,JPDB,,0000,0000,0000,,Демек, бұл Исшики мұның бәрін өзі жасады дегенді білдіре ме?
Dialogue: 0,0:15:51.19,0:15:55.51,JPDB,,0000,0000,0000,,Иә, бірақ оның анықталып, қызды ренжіткенім рас.
Dialogue: 0,0:15:56.21,0:15:59.99,JPDB,,0000,0000,0000,,Енді бұл жағдай болған соң, мен басымды иіп, кешірім сұраймын.
Dialogue: 0,0:16:01.33,0:16:02.47,JPDB,,0000,0000,0000,,Исшики сен...
Dialogue: 0,0:16:02.94,0:16:06.08,JPDB,,0000,0000,0000,,Ер адам ретінде мен мұны істеуім керек деп ойлаймын.
Dialogue: 0,0:16:06.08,0:16:07.34,JPDB,,0000,0000,0000,,Бірақ монах
Dialogue: 0,0:16:07.64,0:16:10.18,JPDB,,0000,0000,0000,,Дұрыс, көп нәрсе істеудің қажеті жоқ.
Dialogue: 0,0:16:11.32,0:16:15.12,JPDB,,0000,0000,0000,,Жоқ, ер адам осылай істеуі керек.
Dialogue: 0,0:16:19.10,0:16:20.42,JPDB,,0000,0000,0000,,Не... бұл қалай болды?
Dialogue: 0,0:16:20.99,0:16:25.59,JPDB,,0000,0000,0000,,«Егер біз оттан каштан алуға батыл болсақ, ол керемет көрінеді».
Dialogue: 0,0:16:26.13,0:16:26.71,JPDB,,0000,0000,0000,,Жақсы
Dialogue: 0,0:16:26.88,0:16:30.28,JPDB,,0000,0000,0000,,Оның үстіне бұл еркектік еркектерді қорғап, кінәні өзіне алады.
Dialogue: 0,0:16:30.76,0:16:33.79,JPDB,,0000,0000,0000,,Бірақ сіз бұл баспен не істемексіз?
Dialogue: 0,0:16:34.01,0:16:37.14,JPDB,,0000,0000,0000,,Иә? Бұл монах туралы.
Dialogue: 0,0:16:37.14,0:16:41.72,JPDB,,0000,0000,0000,,Білесіз бе, мұны айтудан басқа, сізде осындай шешім бар екенін көрсету керек.
Dialogue: 0,0:16:42.39,0:16:44.45,JPDB,,0000,0000,0000,,Бірақ сіз мұны теріс қылық деп айтасыз
Dialogue: 0,0:16:44.85,0:16:48.28,JPDB,,0000,0000,0000,,Бұл рас, бірақ мен барлығының шындап келетінін ешқашан күткен емеспін...
Dialogue: 0,0:16:48.28,0:16:49.37,JPDB,,0000,0000,0000,,Мен солай ойлаймын.
Dialogue: 0,0:16:50.14,0:16:51.71,JPDB,,0000,0000,0000,,То... Нибутани Мен білмей тұрып
Dialogue: 0,0:16:52.45,0:16:54.96,JPDB,,0000,0000,0000,,Сізге айтамын, қыздарда әлі де күмән бар.
Dialogue: 0,0:16:55.49,0:16:55.88,JPDB,,0000,0000,0000,,Иә?
Dialogue: 0,0:16:56.36,0:16:59.64,JPDB,,0000,0000,0000,,Қанша айтсаң да, ешкім сенбейді.
Dialogue: 0,0:16:59.86,0:17:01.97,JPDB,,0000,0000,0000,,Исшики-кун шешпегенше.
Dialogue: 0,0:17:02.79,0:17:03.24,JPDB,,0000,0000,0000,,О... мен бе?
Dialogue: 0,0:17:03.69,0:17:07.07,JPDB,,0000,0000,0000,,Исшики-кун айтқаннан бері бұл табиғи нәрсе.
Dialogue: 0,0:17:07.94,0:17:09.83,JPDB,,0000,0000,0000,,Бұл өтірік. Бұл өтірік.
Dialogue: 0,0:17:12.31,0:17:14.90,JPDB,,0000,0000,0000,,Мен сенен тағы сұраймын. Бұл шынымен жақсы.
Dialogue: 0,0:17:15.02,0:17:17.28,JPDB,,0000,0000,0000,,Маған ұнамайды, маған ұнамайды.
Dialogue: 0,0:17:17.56,0:17:21.56,JPDB,,0000,0000,0000,,Бұл менің орта мектепте үш жыл бойы қырылған бас өміріне шыдағаннан кейін алған шашым.
Dialogue: 0,0:17:21.96,0:17:22.95,JPDB,,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,0:17:22.95,0:17:25.91,JPDB,,0000,0000,0000,,Егер солай болса, кешіріңіз және ертең шаш үшін кешірім сұраңыз.
Dialogue: 0,0:17:26.06,0:17:30.46,JPDB,,0000,0000,0000,,Егер мен мұны істесем, мен жай ғана ақымақ болар едім.
Dialogue: 0,0:17:30.88,0:17:34.06,JPDB,,0000,0000,0000,,Нибутани айтқандай, мен бұл жерде кінәні өз мойныма алуым керек.
Dialogue: 0,0:17:34.06,0:17:36.72,JPDB,,0000,0000,0000,,Сыныптағы қызға және маған махаббат хатын жіберген қызға.
Dialogue: 0,0:17:36.84,0:17:38.51,JPDB,,0000,0000,0000,,Сіз, әрине, сәтсіздікке ұқсайсыз.
Dialogue: 0,0:17:38.88,0:17:41.39,JPDB,,0000,0000,0000,,Жоқ, егер мен мұны бұрын айтқан болсам.
Dialogue: 0,0:17:41.72,0:17:44.42,JPDB,,0000,0000,0000,,Күдік тағы да барлық ұлдарға түседі.
Dialogue: 0,0:17:44.55,0:17:45.19,JPDB,,0000,0000,0000,,Сол себепті
Dialogue: 0,0:17:45.39,0:17:47.61,JPDB,,0000,0000,0000,,Мен дауыс сұраған адам болдым.
Dialogue: 0,0:17:48.35,0:17:52.85,JPDB,,0000,0000,0000,,​​Менің ойымша, оны түсірмес бұрын оны өзіне кию ер адамның міндеті.
Dialogue: 0,0:17:57.60,0:17:59.44,JPDB,,0000,0000,0000,,Ақыры қылмыскер автобустан секіріп түсіп, көлік астында қалыпты.
Dialogue: 0,0:17:59.78,0:18:01.62,JPDB,,0000,0000,0000,,Жапондық Харакири
Dialogue: 0,0:18:01.62,0:18:02.27,JPDB,,0000,0000,0000,,Жоқ
Dialogue: 0,0:18:02.27,0:18:05.43,JPDB,,0000,0000,0000,,Бұл ұқсас нәрсе емес. Оны тез кесіңіз.
Dialogue: 0,0:18:05.58,0:18:08.43,JPDB,,0000,0000,0000,,Балалар, сендер мазасызсыңдар, шығыңыздар.
Dialogue: 0,0:18:08.68,0:18:10.94,JPDB,,0000,0000,0000,,Бұл қоғамның жасырынған жері. Меншік құқығы - бұл...
Dialogue: 0,0:18:10.94,0:18:11.81,JPDB,,0000,0000,0000,,Жақында аяқталады
Dialogue: 0,0:18:11.91,0:18:12.78,JPDB,,0000,0000,0000,,Мен сәл күтемін.
Dialogue: 0,0:18:13.88,0:18:15.34,JPDB,,0000,0000,0000,,Менің қызметшім
Dialogue: 0,0:18:15.84,0:18:18.00,JPDB,,0000,0000,0000,,Бұл... бұл мөр.
Dialogue: 0,0:18:22.30,0:18:23.30,JPDB,,0000,0000,0000,,Сәлем Юта
Dialogue: 0,0:18:25.06,0:18:26.60,JPDB,,0000,0000,0000,,Барлығы үшін рахмет.
Dialogue: 0,0:18:27.75,0:18:31.08,JPDB,,0000,0000,0000,,Сізбен кіру салтанатында сөйлескеніме қуаныштымын.
Dialogue: 0,0:18:32.34,0:18:36.15,JPDB,,0000,0000,0000,,Әкем 35 жасында шашы түсіп қалды.
Dialogue: 0,0:18:36.57,0:18:40.74,JPDB,,0000,0000,0000,,Егер бұл тұқым қуалайтын болса, мен шаш үлгісімен 20 жылдай ғана ойнай аламын.
Dialogue: 0,0:18:41.81,0:18:44.55,JPDB,,0000,0000,0000,,Сол жылдардың ішінде мен үш жылын монах ретінде өткіздім.
Dialogue: 0,0:18:45.29,0:18:48.72,JPDB,,0000,0000,0000,,Мұндай нәрсенің қайталануы ақымақтық.
Dialogue: 0,0:18:49.87,0:18:52.72,JPDB,,0000,0000,0000,,Мен...Исшики, мен...
Dialogue: 0,0:18:54.29,0:18:56.28,JPDB,,0000,0000,0000,,Неге жылайсың, Юта?
Dialogue: 0,0:19:00.18,0:19:03.81,JPDB,,0000,0000,0000,,Енді мұны өз қолдарыңызбен жасаңыз.
Dialogue: 0,0:19:04.18,0:19:09.38,JPDB,,0000,0000,0000,,Исшики!
Dialogue: 0,0:19:10.64,0:19:12.83,JPDB,,0000,0000,0000,,Барлығына не болды?
Dialogue: 0,0:19:13.28,0:19:15.02,JPDB,,0000,0000,0000,,Мөрленген
Dialogue: 0,0:19:15.27,0:19:15.79,JPDB,,0000,0000,0000,,Шешілді
Dialogue: 0,0:19:16.93,0:19:17.65,JPDB,,0000,0000,0000,,Бітті ме?
Dialogue: 0,0:19:18.22,0:19:19.37,JPDB,,0000,0000,0000,,Менің қызметшілерім
Dialogue: 0,0:19:19.81,0:19:21.01,JPDB,,0000,0000,0000,,Әй, бітті.
Dialogue: 0,0:19:21.65,0:19:24.11,JPDB,,0000,0000,0000,,Бірақ қазір Исшики қобалжи бастады.
Dialogue: 0,0:19:24.86,0:19:27.72,JPDB,,0000,0000,0000,,Барлығыңыз өтінемін, оның көңіл-күйін көтере аласыз ба?
Dialogue: 0,0:19:29.81,0:19:30.40,JPDB,,0000,0000,0000,,Иә.
Dialogue: 0,0:19:30.48,0:19:31.20,JPDB,,0000,0000,0000,,Түсіндім
Dialogue: 0,0:19:31.35,0:19:32.37,JPDB,,0000,0000,0000,,Сиқырлы күш сыйла
Dialogue: 0,0:19:32.59,0:19:34.53,JPDB,,0000,0000,0000,,Мен шынымен түсінбеймін, бірақ маған қалдырыңыз.
Dialogue: 0,0:19:34.73,0:19:35.10,JPDB,,0000,0000,0000,,Бұл...
Dialogue: 0,0:19:35.62,0:19:42.01,JPDB,,0000,0000,0000,,Бұған дейін мынаны айтайын: Ешқашан күлме.
Dialogue: 0,0:19:47.68,0:19:49.54,JPDB,,0000,0000,0000,,Тыңдаған жоқсың ба?
Dialogue: 0,0:19:49.54,0:19:50.63,JPDB,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:19:50.73,0:19:51.26,JPDB,,0000,0000,0000,,Исшики
Dialogue: 0,0:19:53.00,0:19:55.73,JPDB,,0000,0000,0000,,Ерлігіңе қуат бергім келеді. Мында басыңыз.
Dialogue: 0,0:19:57.67,0:20:02.74,JPDB,,0000,0000,0000,,Мұнда жиналған қараңғылық күштері, менің атымнан осыны жарылқаңыз.
Dialogue: 0,0:20:07.73,0:20:09.65,JPDB,,0000,0000,0000,,Балалар!
Dialogue: 0,0:20:11.39,0:20:13.23,JPDB,,0000,0000,0000,,Бұл тым күшті
Dialogue: 0,0:20:15.12,0:20:20.14,JPDB,,0000,0000,0000,,Қарт, күлме. Жігіттер, сендерде адамның жүрегі жоқ па?
Dialogue: 0,0:20:15.34,0:20:20.14,JPDB,,0000,0000,0000,,Осылайша сүйкімді қыздың рейтингі мәселесі шешілді.
Dialogue: 0,0:20:21.38,0:20:26.35,JPDB,,0000,0000,0000,,Содан кейін гинкго ағашының астында махаббат хаты бар қыз пайда болады.
Dialogue: 0,0:20:26.57,0:20:30.75,JPDB,,0000,0000,0000,,Тағдырлы сенбі де аз ғана үмітпен келді.
Dialogue: 0,0:20:33.33,0:20:36.24,JPDB,,0000,0000,0000,,Исшики-кун
Dialogue: 0,0:20:36.86,0:20:42.38,JPDB,,0000,0000,0000,,Исшики сыныптағы ұлдардан күтпеген ынталы қолдау алды.
Dialogue: 0,0:20:47.82,0:20:52.22,JPDB,,0000,0000,0000,,Сондықтан махаббат хатының иесі ешқашан келмеді.
Dialogue: 0,0:20:53.17,0:20:55.35,JPDB,,0000,0000,0000,,Нибутани оның кім екенін білмейсің бе?
Dialogue: 0,0:20:55.73,0:20:58.09,JPDB,,0000,0000,0000,,Біз білсек те, қолымыздан ештеңе келмес еді.
Dialogue: 0,0:20:58.81,0:20:59.53,JPDB,,0000,0000,0000,,Жақсы
Dialogue: 0,0:21:00.67,0:21:06.24,JPDB,,0000,0000,0000,,Бірақ, менің ойымша, баланы қорғау және оны дұрыс қырынған бала ету жаман сезім емес.
Dialogue: 0,0:21:07.11,0:21:09.05,JPDB,,0000,0000,0000,,Осылай ойлайтын қыздар болуы мүмкін
Dialogue: 0,0:21:09.05,0:21:09.69,JPDB,,0000,0000,0000,,Бұл рас па?
Dialogue: 0,0:21:10.09,0:21:12.13,JPDB,,0000,0000,0000,,Ей, ақымақ, сенің ол жерде болуың мүмкін емес.
Dialogue: 0,0:21:12.85,0:21:13.95,JPDB,,0000,0000,0000,,Менімен қалжыңдап тұрсың ба?
Dialogue: 0,0:21:16.53,0:21:20.66,JPDB,,0000,0000,0000,,Кешіріңіз, мен қарсы тұра алмадым...
Dialogue: 0,0:21:21.08,0:21:23.34,JPDB,,0000,0000,0000,,Өтінемін, Исшики-кун, маған қол тигізуге рұқсат етіңіз.
Dialogue: 0,0:21:27.04,0:21:28.71,JPDB,,0000,0000,0000,,Эй...эй, сен
Dialogue: 0,0:21:29.73,0:21:31.91,JPDB,,0000,0000,0000,,Жазғы демалыс келе жатыр
Dialogue: 0,0:21:37.61,0:21:39.25,JPDB,,0000,0000,0000,,Эй Юта, не істеуіміз керек?
Dialogue: 0,0:21:40.39,0:21:44.44,JPDB,,0000,0000,0000,,Әкем: Ол биыл Жапонияға қайта келе алмайтын сияқты.
Dialogue: 0,0:21:44.66,0:21:47.35,JPDB,,0000,0000,0000,,Мен Джакартаға баратын сияқтымын.
Dialogue: 0,0:21:47.62,0:21:49.44,JPDB,,0000,0000,0000,,Иә, мен бұл туралы ойланамын.
Dialogue: 0,0:21:53.56,0:21:56.89,JPDB,,0000,0000,0000,,Юта, менің сенен бір жақсылығым бар.
Dialogue: 0,0:21:58.73,0:22:01.86,JPDB,,0000,0000,0000,,Жазғы демалысқа Риккамен бірге келгеніңізді қалаймын.
Dialogue: 0,0:22:03.70,0:22:06.41,JPDB,,0000,0000,0000,,Маған сен керексің
Dialogue: 0,0:22:08.80,0:22:11.23,JPDB,,0000,0000,0000,,Жаз басталады
Dialogue: 0,0:01:38.53,0:01:42.50,JPOP,,0000,0000,0000,karaoke,Бір-біріне қарап біраз тұрған соң
Dialogue: 0,0:01:42.73,0:01:49.29,JPOP,,0000,0000,0000,karaoke,Маған таң қалдырмас бұрын сіз не ойладыңыз?
Dialogue: 0,0:01:49.51,0:01:53.54,JPOP,,0000,0000,0000,karaoke,Маған қараңдаршы еріндері
Dialogue: 0,0:01:53.76,0:01:59.08,JPOP,,0000,0000,0000,karaoke,Мен не болды деп сұрағанша күтемін.
Dialogue: 0,0:01:59.43,0:02:04.78,JPOP,,0000,0000,0000,karaoke,Алдағаннан кейін өзіңізге не айтасыз?
Dialogue: 0,0:02:05.27,0:02:10.69,JPOP,,0000,0000,0000,karaoke,Бұл ұят, сондықтан сұрамаңыз.
Dialogue: 0,0:02:11.39,0:02:16.23,JPOP,,0000,0000,0000,karaoke,Сізді бір-біріңізге тартатын махаббат
Dialogue: 0,0:02:16.58,0:02:21.05,JPOP,,0000,0000,0000,karaoke,Ол әлдеқашан басталған болатын
Dialogue: 0,0:02:22.07,0:02:24.43,JPOP,,0000,0000,0000,karaoke,Мен көп армандадым
Dialogue: 0,0:02:24.46,0:02:28.34,JPOP,,0000,0000,0000,karaoke,Оянсам да сені көргім келеді.
Dialogue: 0,0:02:28.34,0:02:30.55,JPOP,,0000,0000,0000,karaoke,Сіз мұны жасадыңыз
Dialogue: 0,0:02:30.55,0:02:32.96,JPOP,,0000,0000,0000,karaoke,Махаббат сараңдық, солай емес пе?
Dialogue: 0,0:02:32.96,0:02:38.53,JPOP,,0000,0000,0000,karaoke,Жүрегіміз секіріп бара жатқандай, қайда барайық
Dialogue: 0,0:02:38.53,0:02:41.14,JPOP,,0000,0000,0000,karaoke,Идеалдар, адасушылықтар және шындық
Dialogue: 0,0:02:41.26,0:02:43.77,JPOP,,0000,0000,0000,karaoke,Барлығы сіздің айналаңызда айналады
Dialogue: 0,0:02:44.00,0:02:49.12,JPOP,,0000,0000,0000,karaoke,Жаңа әлемге
Dialogue: 0,0:01:38.53,0:01:42.50,ZWOP,,0000,0000,0000,karaoke,Сіз екі көзбен осы сәттесіз
Dialogue: 0,0:01:42.75,0:01:49.29,ZWOP,,0000,0000,0000,karaoke,Қозғалмас бұрын, сіз қайда екеніңізді көре аласыз.
Dialogue: 0,0:01:49.51,0:01:53.54,ZWOP,,0000,0000,0000,karaoke,Менің тұмсығыма қара
Dialogue: 0,0:01:53.76,0:01:59.08,ZWOP,,0000,0000,0000,karaoke,Жиналыстың сұрағы `` Мен мұны істегім келеді '' Сондай-ақ, үндемеңіз.
Dialogue: 0,0:01:59.43,0:02:04.78,ZWOP,,0000,0000,0000,karaoke,Моңғолияның өз-өзімен сөйлесуі
Dialogue: 0,0:02:05.27,0:02:10.69,ZWOP,,0000,0000,0000,karaoke,Но тағы да қажет емес.
Dialogue: 0,0:02:11.39,0:02:16.23,ZWOP,,0000,0000,0000,karaoke,Өзара тартымдылық махаббат
Dialogue: 0,0:02:16.58,0:02:21.05,ZWOP,,0000,0000,0000,karaoke,Жаңа ғана басталды
Dialogue: 0,0:02:22.07,0:02:24.43,ZWOP,,0000,0000,0000,karaoke,Шексіз әдемі армандар
Dialogue: 0,0:02:24.46,0:02:28.34,ZWOP,,0000,0000,0000,karaoke,Бұл түстен оянғаннан кейін де оны көру керек.
Dialogue: 0,0:02:28.34,0:02:30.55,ZWOP,,0000,0000,0000,karaoke,Капитал зиянды
Dialogue: 0,0:02:30.55,0:02:32.96,ZWOP,,0000,0000,0000,karaoke,Махаббат - махаббаттың шынайы табиғаты.
Dialogue: 0,0:02:32.96,0:02:38.53,ZWOP,,0000,0000,0000,karaoke,Будда мен баланың ішкі ойлары секіріп кетеді.
Dialogue: 0,0:02:38.53,0:02:41.14,ZWOP,,0000,0000,0000,karaoke,Күмән жоқ - идеал, адасушылық - шындық
Dialogue: 0,0:02:41.26,0:02:43.77,ZWOP,,0000,0000,0000,karaoke,Барлық астаналар сіздің кезегіңізге келді.
Dialogue: 0,0:03:33.00,0:03:38.12,ZWOP,,0000,0000,0000,karaoke,Дүниеден жаңа кету
Dialogue: 0,0:01:38.53,0:01:42.50,JPOP,,0000,0000,0000,fx,Бір-біріне қарап біраз тұрған соң
Dialogue: 0,0:01:42.73,0:01:49.29,JPOP,,0000,0000,0000,fx,Маған таң қалдырмас бұрын сіз не ойладыңыз?
Dialogue: 0,0:01:49.51,0:01:53.54,JPOP,,0000,0000,0000,fx,Маған қараңдаршы еріндері
Dialogue: 0,0:01:53.76,0:01:59.08,JPOP,,0000,0000,0000,fx,Мен не болды деп сұрағанша күтемін.
Dialogue: 0,0:01:59.43,0:02:04.78,JPOP,,0000,0000,0000,fx,Алдағаннан кейін өзіңізге не айтасыз?
Dialogue: 0,0:02:05.27,0:02:10.69,JPOP,,0000,0000,0000,fx,Бұл ұят, сондықтан сұрамаңыз.
Dialogue: 0,0:02:11.39,0:02:16.23,JPOP,,0000,0000,0000,fx,Сізді бір-біріңізге тартатын махаббат
Dialogue: 0,0:02:16.58,0:02:21.05,JPOP,,0000,0000,0000,fx,Ол әлдеқашан басталған болатын
Dialogue: 0,0:02:22.07,0:02:24.43,JPOP,,0000,0000,0000,fx,Мен көп армандадым
Dialogue: 0,0:02:24.46,0:02:28.34,JPOP,,0000,0000,0000,fx,Оянсам да сені көргім келеді.
Dialogue: 0,0:02:28.34,0:02:30.55,JPOP,,0000,0000,0000,fx,Сіз мұны жасадыңыз
Dialogue: 0,0:02:30.55,0:02:32.96,JPOP,,0000,0000,0000,fx,Махаббат сараңдық, солай емес пе?
Dialogue: 0,0:02:32.96,0:02:38.53,JPOP,,0000,0000,0000,fx,Жүрегіміз секіріп бара жатқандай, қайда барайық
Dialogue: 0,0:02:38.53,0:02:41.14,JPOP,,0000,0000,0000,fx,Идеалдар, адасушылықтар және шындық
Dialogue: 0,0:02:41.26,0:02:43.77,JPOP,,0000,0000,0000,fx,Барлығы сіздің айналаңызда айналады
Dialogue: 0,0:02:44.00,0:02:49.12,JPOP,,0000,0000,0000,fx,Жаңа әлемге
Dialogue: 0,0:01:38.53,0:01:42.50,ZWOP,,0000,0000,0000,fx,Сіз екі көзбен осы сәттесіз
Dialogue: 0,0:01:42.75,0:01:49.29,ZWOP,,0000,0000,0000,fx,Қозғалмас бұрын, сіз қайда екеніңізді көре аласыз.
Dialogue: 0,0:01:49.51,0:01:53.54,ZWOP,,0000,0000,0000,fx,Менің тұмсығыма қара
Dialogue: 0,0:01:53.76,0:01:59.08,ZWOP,,0000,0000,0000,fx,Жиналыстың сұрағы `` Мен мұны істегім келеді '' Сондай-ақ, үндемеңіз.
Dialogue: 0,0:01:59.43,0:02:04.78,ZWOP,,0000,0000,0000,fx,Моңғолияның өз-өзімен сөйлесуі
Dialogue: 0,0:02:05.27,0:02:10.69,ZWOP,,0000,0000,0000,fx,Но тағы да қажет емес.
Dialogue: 0,0:02:11.39,0:02:16.23,ZWOP,,0000,0000,0000,fx,Өзара тартымдылық махаббат
Dialogue: 0,0:02:16.58,0:02:21.05,ZWOP,,0000,0000,0000,fx,Жаңа ғана басталды
Dialogue: 0,0:02:22.07,0:02:24.43,ZWOP,,0000,0000,0000,fx,Шексіз әдемі армандар
Dialogue: 0,0:02:24.46,0:02:28.34,ZWOP,,0000,0000,0000,fx,Бұл түстен оянғаннан кейін де оны көру керек.
Dialogue: 0,0:02:28.34,0:02:30.55,ZWOP,,0000,0000,0000,fx,Капитал зиянды
Dialogue: 0,0:02:30.55,0:02:32.96,ZWOP,,0000,0000,0000,fx,Махаббат - махаббаттың шынайы табиғаты.
Dialogue: 0,0:02:32.96,0:02:38.53,ZWOP,,0000,0000,0000,fx,Будда мен баланың ішкі ойлары секіріп кетеді.
Dialogue: 0,0:02:38.53,0:02:41.14,ZWOP,,0000,0000,0000,fx,Күмән жоқ - идеал, адасушылық - шындық
Dialogue: 0,0:02:41.26,0:02:43.77,ZWOP,,0000,0000,0000,fx,Барлық астаналар сіздің кезегіңізге келді.
Dialogue: 0,0:02:44.00,0:02:49.12,ZWOP,,0000,0000,0000,fx,Дүниеден жаңа кету
Dialogue: 0,0:22:16.78,0:22:19.29,JPED,,0000,0000,0000,,INSIDE Identity
Dialogue: 0,0:22:19.29,0:22:21.06,JPED,,0000,0000,0000,,Сіздің орныңыз қай жерде?
Dialogue: 0,0:22:32.19,0:22:34.70,JPED,,0000,0000,0000,,Түсініспеушілік ұят па?
Dialogue: 0,0:22:34.70,0:22:37.03,JPED,,0000,0000,0000,,Адалдық ауыртады
Dialogue: 0,0:22:37.36,0:22:39.92,JPED,,0000,0000,0000,,Кім не айтса да
Dialogue: 0,0:22:39.92,0:22:42.35,JPED,,0000,0000,0000,,Мен ненің дұрыс екенін білмеймін
Dialogue: 0,0:22:42.55,0:22:45.16,JPED,,0000,0000,0000,,Әдеттегідей ағып жатқан күнделікті өмірде
Dialogue: 0,0:22:45.28,0:22:47.62,JPED,,0000,0000,0000,,Мен өзімді соған үйренуге мәжбүр еттім.
Dialogue: 0,0:22:47.62,0:22:50.25,JPED,,0000,0000,0000,,Суға батқан тұлға және қан
Dialogue: 0,0:22:50.45,0:22:52.67,JPED,,0000,0000,0000,,Шайнаңыз, ішіңіз, түкіріңіз және сындырыңыз
Dialogue: 0,0:22:52.67,0:22:57.09,JPED,,0000,0000,0000,,Мені осылай түсінгеніңізді қалаймын
Dialogue: 0,0:22:57.36,0:23:02.66,JPED,,0000,0000,0000,,Мен бірдеңе айтқым келеді, бірақ айта алмаймын.
Dialogue: 0,0:23:02.66,0:23:07.45,JPED,,0000,0000,0000,,Неге ешкім түсінбейді?
Dialogue: 0,0:23:07.68,0:23:12.62,JPED,,0000,0000,0000,,Ойлану сән-салтанат па? Солай ма?
Dialogue: 0,0:23:12.62,0:23:17.79,JPED,,0000,0000,0000,,Эмоциялық күн
Dialogue: 0,0:23:18.04,0:23:20.73,JPED,,0000,0000,0000,,Тым көп қызу
Dialogue: 0,0:23:20.73,0:23:23.01,JPED,,0000,0000,0000,,Әйтеуір шешетін сияқты
Dialogue: 0,0:23:23.16,0:23:28.08,JPED,,0000,0000,0000,,Айқайлағым келеді
Dialogue: 0,0:23:28.08,0:23:34.00,JPED,,0000,0000,0000,,ТҮСІМДІЛІК қатты іздейді
Dialogue: 0,0:23:34.27,0:23:36.76,JPED,,0000,0000,0000,,INSIDE Identity
Dialogue: 0,0:23:36.76,0:23:39.29,JPED,,0000,0000,0000,,ӘДІЛЕТІМНІҢ ІШІНДЕ
Dialogue: 0,0:23:39.29,0:23:41.85,JPED,,0000,0000,0000,,Маған кедергі жасама
Dialogue: 0,0:23:41.85,0:23:43.85,JPED,,0000,0000,0000,,Сіздің орныңыз қай жерде?
Dialogue: 0,0:22:16.78,0:22:19.29,ZWED,,0000,0000,0000,,INSIDE Identity
Dialogue: 0,0:22:19.29,0:22:21.06,ZWED,,0000,0000,0000,,Қараған жерің – өмір сүретін жерің.
Dialogue: 0,0:22:32.19,0:22:34.70,ZWED,,0000,0000,0000,,Кездесуде мен аудиториядан алған әсерім үшін ұяламын.
Dialogue: 0,0:22:34.70,0:22:37.03,ZWED,,0000,0000,0000,,Ашық шолу
Dialogue: 0,0:22:37.36,0:22:39.92,ZWED,,0000,0000,0000,,Бұған күмән жоқ
Dialogue: 0,0:22:39.92,0:22:42.35,ZWED,,0000,0000,0000,,Байлығымның түзелетініне сенімдімін.
Dialogue: 0,0:22:42.55,0:22:45.16,ZWED,,0000,0000,0000,,Өзін-өзі анықтауды зерттеңіз
Dialogue: 0,0:22:45.28,0:22:47.62,ZWED,,0000,0000,0000,,Хико Ичиту Фукан
Dialogue: 0,0:22:47.62,0:22:50.25,ZWED,,0000,0000,0000,,Генералдың толық эго және қан
Dialogue: 0,0:22:50.45,0:22:52.67,ZWED,,0000,0000,0000,,Шайнау, жұту, түкіру, ойнау
Dialogue: 0,0:22:52.67,0:22:57.09,ZWED,,0000,0000,0000,,Сіз мұны түсінесіз деп үміттенемін.
Dialogue: 0,0:22:57.36,0:23:02.66,ZWED,,0000,0000,0000,,Күтпеген ойлар ашылуы мүмкін.
Dialogue: 0,0:23:02.66,0:23:07.45,ZWED,,0000,0000,0000,,Мен адам қалмағанын түсінемін.
Dialogue: 0,0:23:07.68,0:23:12.62,ZWED,,0000,0000,0000,,Түсінікті болғың келсе, сабыр ет.
Dialogue: 0,0:23:12.62,0:23:17.79,ZWED,,0000,0000,0000,,Бұл эмоционалды күн
Dialogue: 0,0:23:18.04,0:23:20.73,ZWED,,0000,0000,0000,,Радиациялық жылу сыйымдылығы
Dialogue: 0,0:23:20.73,0:23:23.01,ZWED,,0000,0000,0000,,Өзін ләззатқа ұшырататын теріс қылықтар
Dialogue: 0,0:23:23.16,0:23:28.08,ZWED,,0000,0000,0000,,Ойлар мен әрекеттерді заңсыз басу
Dialogue: 0,0:23:28.08,0:23:34.00,ZWED,,0000,0000,0000,,ТҰРҒЫНДАР
Dialogue: 0,0:23:34.27,0:23:36.76,ZWED,,0000,0000,0000,,INSIDE Identity
Dialogue: 0,0:23:36.76,0:23:39.29,ZWED,,0000,0000,0000,,ӘДІЛЕТІМНІҢ ІШІНДЕ
Dialogue: 0,0:23:39.29,0:23:41.85,ZWED,,0000,0000,0000,,Қажетсіз кедергі
Dialogue: 0,0:23:41.85,0:23:43.85,ZWED,,0000,0000,0000,,Қараған жерің – өмір сүретін жерің.
Dialogue: 0,0:02:53.94,0:03:03.91,ZZ信息,,0000,0000,0000,,Бұл субтитрлер топтамасы субтитрлер тобында көрсетіледі және көбірек қытай, жапон және қытай субтитрлері алмасу үшін қолжетімді. www.kamigami.org
Dialogue: 0,0:02:53.94,0:03:03.91,ZZ信息,,0000,0000,0000,,...
Dialogue: 0,0:03:04.32,0:03:10.33,ZWBT,,0000,0000,0000,,Күнәкар... Құтқарушы
Dialogue: 0,0:00:02.78,0:00:05.14,ZWDB,,0000,0000,0000,,Шектеулі уақытты ойнату, қазіргі уақытта толығымен өшірілген
Dialogue: 0,0:00:05.98,0:00:07.65,ZWDB,,0000,0000,0000,,Магистрдің жұмысы толығымен аяқталды.
Dialogue: 0,0:00:10.66,0:00:12.05,ZWDB,,0000,0000,0000,,Бөлек шабуыл
Dialogue: 0,0:00:20.50,0:00:25.00,ZWDB,,0000,0000,0000,,Юта Юта Юта Райшога
Dialogue: 0,0:00:25.55,0:00:26.19,ZWDB,,0000,0000,0000,,Сіз не айтасыз?
Dialogue: 0,0:00:30.44,0:00:33.03,ZWDB,,0000,0000,0000,,Жедел басқаруды қажет ететін шұғыл мәселе бар.
Dialogue: 0,0:00:33.03,0:00:34.67,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:00:34.99,0:00:36.90,ZWDB,,0000,0000,0000,,Біз компаниямыздың формасын шығаруды аяқтадық.
Dialogue: 0,0:00:37.20,0:00:37.87,ZWDB,,0000,0000,0000,,Біркелкі?
Dialogue: 0,0:00:39.04,0:00:43.04,ZWDB,,0000,0000,0000,,Автордың ``Қара жалын''
Dialogue: 0,0:00:43.56,0:00:47.54,ZWDB,,0000,0000,0000,,Бұл менің жазғаным: «Жаман көз»
Dialogue: 0,0:00:48.96,0:00:50.55,ZWDB,,0000,0000,0000,,Мейтен әрекетінің басталуы басталды.
Dialogue: 0,0:00:50.70,0:00:54.70,ZWDB,,0000,0000,0000,,Менің талантым зерттелмеген.
Dialogue: 0,0:00:56.41,0:00:57.46,ZWDB,,0000,0000,0000,,Бұл Ютаның бұрыштық түсі
Dialogue: 0,0:00:57.46,0:00:58.75,ZWDB,,0000,0000,0000,,Есептеу…
Dialogue: 0,0:00:59.05,0:01:00.69,ZWDB,,0000,0000,0000,,Тегі – “Сецуна”
Dialogue: 0,0:01:00.69,0:01:02.13,ZWDB,,0000,0000,0000,,Қайда ойнауға болады?
Dialogue: 0,0:01:05.61,0:01:07.95,ZWDB,,0000,0000,0000,,「」
Dialogue: 0,0:01:08.97,0:01:11.23,ZWDB,,0000,0000,0000,,Meiten жеті ұпай келу кездесу нүктесі B
Dialogue: 0,0:01:22.91,0:01:23.63,ZWDB,,0000,0000,0000,,Келу
Dialogue: 0,0:03:05.36,0:03:07.69,ZWDB,,0000,0000,0000,,Мен қазір шілде айында астанадамын.
Dialogue: 0,0:03:08.74,0:03:12.86,ZWDB,,0000,0000,0000,,Не айтқыңыз келетінін түсінсеңіз, сіз тек бір адамды белгілей аласыз.
Dialogue: 0,0:03:13.68,0:03:16.02,ZWDB,,0000,0000,0000,,Мен сол зерттеумен не істеу керектігін білмеймін.
Dialogue: 0,0:03:17.73,0:03:21.21,ZWDB,,0000,0000,0000,,Юута но Гагава Арива Деккоками Ока Нютани әңгімесін қоспағанда
Dialogue: 0,0:03:21.76,0:03:24.17,ZWDB,,0000,0000,0000,,Бұл туралы сөйлесейік.
Dialogue: 0,0:03:24.45,0:03:28.92,ZWDB,,0000,0000,0000,,Юута Зайбан Киоя Шутадава Га Нибутани Исшики Рётен Кашига Сифуда
Dialogue: 0,0:03:29.27,0:03:30.24,ZWDB,,0000,0000,0000,,Түсінудің тағы бір жолы
Dialogue: 0,0:03:30.91,0:03:32.72,ZWDB,,0000,0000,0000,,Бастапқыда мен ыстыққа риза емес едім.
Dialogue: 0,0:03:34.91,0:03:37.27,ZWDB,,0000,0000,0000,,Нағыз Мао бөлек бақылауда...
Dialogue: 0,0:03:38.12,0:03:42.32,ZWDB,,0000,0000,0000,,«Қазір мен осы кеңістіктемін, бірақ мен өзімнің бар екендігімді білемін».
Dialogue: 0,0:03:45.60,0:03:47.34,ZWDB,,0000,0000,0000,,Тогаши Дугаку картиналары
Dialogue: 0,0:03:47.44,0:03:47.66,ZWDB,,0000,0000,0000,,тақырып
Dialogue: 0,0:03:48.23,0:03:49.97,ZWDB,,0000,0000,0000,,Осы аймақта ойнап жүрген кішкентай құс.
Dialogue: 0,0:03:50.14,0:03:51.41,ZWDB,,0000,0000,0000,,Корея…Корена Того
Dialogue: 0,0:03:51.61,0:03:56.01,ZWDB,,0000,0000,0000,,Тогаши Дугакуның тұрақты өмір сүретін манга сериясы
Dialogue: 0,0:03:56.36,0:03:58.15,ZWDB,,0000,0000,0000,,Қолжетімсіз
Dialogue: 0,0:03:58.94,0:04:01.48,ZWDB,,0000,0000,0000,,Бұл менің орта мектептің екінші курсында ауырған себебім.
Dialogue: 0,0:04:02.62,0:04:04.34,ZWDB,,0000,0000,0000,,Аяқталды
Dialogue: 0,0:04:04.34,0:04:06.25,ZWDB,,0000,0000,0000,,Менің көргенім шындық.
Dialogue: 0,0:04:07.79,0:04:09.21,ZWDB,,0000,0000,0000,,Бұл Тогаши Доужин ме?
Dialogue: 0,0:04:09.58,0:04:10.57,ZWDB,,0000,0000,0000,,Шайқас
Dialogue: 0,0:04:10.85,0:04:11.74,ZWDB,,0000,0000,0000,,Ұрыста ма?
Dialogue: 0,0:04:16.81,0:04:20.02,ZWDB,,0000,0000,0000,,Бүкіл дене ``қара және күңгірт жалын'', өйткені ол өлім жағдайында босатылады.
Dialogue: 0,0:04:20.17,0:04:21.04,ZWDB,,0000,0000,0000,,Балама аударма
Dialogue: 0,0:04:21.73,0:04:23.00,ZWDB,,0000,0000,0000,,«Қара жалын»
Dialogue: 0,0:04:23.45,0:04:25.29,ZWDB,,0000,0000,0000,,Сіз жоқта қатты сөйлей алмайсыз.
Dialogue: 0,0:04:25.29,0:04:27.95,ZWDB,,0000,0000,0000,,«Қара жалын» - Ютаның ең күшті шабуыл сиқыры
Dialogue: 0,0:04:28.25,0:04:29.61,ZWDB,,0000,0000,0000,,Юта және басқалар...
Dialogue: 0,0:04:32.82,0:04:33.49,ZWDB,,0000,0000,0000,,Қай жерде тамақтану керек
Dialogue: 0,0:04:36.65,0:04:37.84,ZWDB,,0000,0000,0000,,Бұл шынымен де өте, «өте» жақсы жас
Dialogue: 0,0:04:38.01,0:04:41.00,ZWDB,,0000,0000,0000,,Белгісіздік Қандай уақыт мүмкін емес? Ересектерге арналған шытырман оқиғалы орман
Dialogue: 0,0:04:41.00,0:04:42.46,ZWDB,,0000,0000,0000,,«Мори ересек» айқайы
Dialogue: 0,0:04:43.06,0:04:44.80,ZWDB,,0000,0000,0000,,Нибутани Дугакудың өлім тарихы
Dialogue: 0,0:04:46.61,0:04:47.26,ZWDB,,0000,0000,0000,,Бұл сенің жетілген адамың.
Dialogue: 0,0:04:47.78,0:04:48.75,ZWDB,,0000,0000,0000,,Күтіп тұрғаның үшін кешір. Міне, сенің құлпынайлы тортың
Dialogue: 0,0:04:49.20,0:04:51.01,ZWDB,,0000,0000,0000,,Одан кейін мен Нибутани университетінің студенттеріне тәнті болдым.
Dialogue: 0,0:04:52.65,0:04:53.85,ZWDB,,0000,0000,0000,,Қай жерде тамақтану керек
Dialogue: 0,0:04:54.32,0:04:54.84,ZWDB,,0000,0000,0000,,Юта
Dialogue: 0,0:04:56.93,0:04:57.85,ZWDB,,0000,0000,0000,,Басшы сатқындарды міндетті түрде түбірімен жояды…
Dialogue: 0,0:04:58.37,0:05:00.71,ZWDB,,0000,0000,0000,,Төмен түскеннен кейін мен төменге түсе аламын.
Dialogue: 0,0:05:02.22,0:05:04.01,ZWDB,,0000,0000,0000,,Ал сіз ше?
Dialogue: 0,0:05:05.13,0:05:06.00,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:05:06.37,0:05:08.88,ZWDB,,0000,0000,0000,,Менімен сөйлес.
Dialogue: 0,0:05:09.06,0:05:10.35,ZWDB,,0000,0000,0000,,Дүрбелең басталды.
Dialogue: 0,0:05:10.35,0:05:13.48,ZWDB,,0000,0000,0000,,Себеп... Себеп Ақиқаттың кездесуі туралы ойлау
Dialogue: 0,0:05:13.85,0:05:15.69,ZWDB,,0000,0000,0000,,Сіз осындасыз
Dialogue: 0,0:05:15.87,0:05:17.36,ZWDB,,0000,0000,0000,,Бұл Йошикичи және т.б.
Dialogue: 0,0:05:17.85,0:05:20.51,ZWDB,,0000,0000,0000,,Мен студенттік деңгейге қалай жеттім?
Dialogue: 0,0:05:20.74,0:05:24.12,ZWDB,,0000,0000,0000,,Дегенмен мен қазір осы қаладамын.
Dialogue: 0,0:05:24.12,0:05:28.47,ZWDB,,0000,0000,0000,,Келесі... Мен келесі сапарға үйімнен кетемін.
Dialogue: 0,0:05:28.89,0:05:32.77,ZWDB,,0000,0000,0000,,Бұл қысқа пернетақтаның алғашқы мысалы.
Dialogue: 0,0:05:32.97,0:05:34.61,ZWDB,,0000,0000,0000,,Кішкентай нәрселерді біліп, байсалды және байсалды келу керек.
Dialogue: 0,0:05:34.61,0:05:35.85,ZWDB,,0000,0000,0000,,Басқа адамның орны
Dialogue: 0,0:05:36.64,0:05:40.82,ZWDB,,0000,0000,0000,,Сабырлы және табиғи ойлау 1-сұрақ Наманың ойлар кітабы
Dialogue: 0,0:05:41.39,0:05:43.01,ZWDB,,0000,0000,0000,,Бұл оқиға рас.
Dialogue: 0,0:05:43.48,0:05:46.54,ZWDB,,0000,0000,0000,,2-сұрақ: Мен не айтуым керек?
Dialogue: 0,0:05:46.71,0:05:48.30,ZWDB,,0000,0000,0000,,Жоғарғы беттік таңбаны көруге болады
Dialogue: 0,0:05:48.85,0:05:52.87,ZWDB,,0000,0000,0000,,«Чжоу Чжоу төңірегінде оқығаннан кейін мен Джин Ансинде және т.б.».
Dialogue: 0,0:05:53.20,0:05:54.22,ZWDB,,0000,0000,0000,,Күтуге қарау
Dialogue: 0,0:05:56.35,0:06:00.78,ZWDB,,0000,0000,0000,,3-сұрақ: Кездеспеген еркек пен әйелдің дүниеге келуі оқиғасы.
Dialogue: 0,0:06:01.47,0:06:03.34,ZWDB,,0000,0000,0000,,Мен саған сенбеймін.
Dialogue: 0,0:06:04.43,0:06:05.38,ZWDB,,0000,0000,0000,,Бұрын менімен көп нәрсе болды.
Dialogue: 0,0:06:06.00,0:06:10.72,ZWDB,,0000,0000,0000,,Бір топтың шатастырылған оқушысы кім? [37]
Dialogue: 0,0:06:11.22,0:06:12.98,ZWDB,,0000,0000,0000,,Дегенмен, ең маңызды фамилия жоқ.
Dialogue: 0,0:06:13.55,0:06:15.07,ZWDB,,0000,0000,0000,,Мен ол жерге барғым келмейді.
Dialogue: 0,0:06:15.44,0:06:22.30,ZWDB,,0000,0000,0000,,Басшы… Хираката Икутенмоку Цуяко
Dialogue: 0,0:06:22.50,0:06:23.40,ZWDB,,0000,0000,0000,,Елестету мүмкін емес
Dialogue: 0,0:06:23.69,0:06:25.56,ZWDB,,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:06:25.86,0:06:26.38,ZWDB,,0000,0000,0000,,Бұл қиын оқиға ма?
Dialogue: 0,0:06:26.87,0:06:27.62,ZWDB,,0000,0000,0000,,Бұл Нюудани ме?
Dialogue: 0,0:06:28.34,0:06:30.35,ZWDB,,0000,0000,0000,,Нюяның Нибутани туралы ойлары
Dialogue: 0,0:06:30.63,0:06:33.64,ZWDB,,0000,0000,0000,,Сапқа шықсаңыз, қалада кішкентай күлкіні көресіз.
Dialogue: 0,0:06:33.96,0:06:37.21,ZWDB,,0000,0000,0000,,Тұлға да ақиқат.
Dialogue: 0,0:06:37.59,0:06:41.24,ZWDB,,0000,0000,0000,,​​Осыған байланысты мен әртүрлі музыка түрлерімен және жабайы табиғатқа сорылған адамдармен ұшырадым.
Dialogue: 0,0:06:41.24,0:06:42.96,ZWDB,,0000,0000,0000,,Мүмкін емес, мүмкін емес, мүмкін емес...
Dialogue: 0,0:06:42.96,0:06:44.40,ZWDB,,0000,0000,0000,,Егер сіз оны алғыңыз келсе, иә деп айта аласыз.
Dialogue: 0,0:06:44.40,0:06:47.33,ZWDB,,0000,0000,0000,,Мүмкін емес
Dialogue: 0,0:06:47.43,0:06:48.62,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:06:49.27,0:06:52.52,ZWDB,,0000,0000,0000,,Мо...Мо Фэй Сіз Ниу алқабына ғашықсыз...
Dialogue: 0,0:06:52.70,0:06:53.57,ZWDB,,0000,0000,0000,,Насарака мүмкін емес
Dialogue: 0,0:06:54.99,0:06:58.66,ZWDB,,0000,0000,0000,,Ол сондай-ақ толығымен таратылмаған.
Dialogue: 0,0:06:59.01,0:06:59.93,ZWDB,,0000,0000,0000,,Сіз мұнда келе алмайсыз.
Dialogue: 0,0:07:00.18,0:07:03.51,ZWDB,,0000,0000,0000,,Мен мұны өз өмірімнің фотокітаптарынан білемін.
Dialogue: 0,0:07:03.61,0:07:08.08,ZWDB,,0000,0000,0000,,Сіз бұл туралы ойласаңыз, оны қалдыруымды тікелей сұрай аласыз.
Dialogue: 0,0:07:08.38,0:07:10.30,ZWDB,,0000,0000,0000,,Мен келісім-шарт жасаған кезде таң қалдым.
Dialogue: 0,0:07:10.42,0:07:12.71,ZWDB,,0000,0000,0000,,Келген студент қыздың алғашқы көрнекі көрінісі
Dialogue: 0,0:07:12.71,0:07:15.74,ZWDB,,0000,0000,0000,,Әнді естігенде жақсы әсер аласыз.
Dialogue: 0,0:07:15.94,0:07:19.34,ZWDB,,0000,0000,0000,,Жиналыс аяқталғаннан кейін жиналыс аяқталды.
Dialogue: 0,0:07:19.69,0:07:22.25,ZWDB,,0000,0000,0000,,Қажетсіз өзіне деген сенімділік өзіне деген сенімділікті көрсетеді
Dialogue: 0,0:07:24.54,0:07:28.44,ZWDB,,0000,0000,0000,,Қара мен қара сауыт келді, қара мен қара күш түсті.
Dialogue: 0,0:07:28.99,0:07:30.85,ZWDB,,0000,0000,0000,,Ұйықтау киіміне қатысты киім
Dialogue: 0,0:07:29.63,0:07:32.47,ZWDB,,0000,0000,0000,,Мен не істерімді білмедім, бірақ не істерімді білмедім.
Dialogue: 0,0:07:33.48,0:07:36.57,ZWDB,,0000,0000,0000,,Форма киген кездегі жеке тегі
Dialogue: 0,0:07:38.03,0:07:42.41,ZWDB,,0000,0000,0000,,Зұлым патша шынайы көздер манипуляторы храмы № 0 Котори Ю Рикка
Dialogue: 0,0:07:43.25,0:07:49.71,ZWDB,,0000,0000,0000,,Зұлым патша Шинганның қызметшісі, найзағай құдайының пайдаланушысы, №0 храм, Санае Декомори
Dialogue: 0,0:07:50.26,0:07:55.63,ZWDB,,0000,0000,0000,,Жауынгерлік каштанның түстен кейінгі ұйқысы № 0 ғибадатхана 7 мамыр Хока
Dialogue: 0,0:07:56.62,0:07:57.34,ZWDB,,0000,0000,0000,,Сыртқы түрі жақсы.
Dialogue: 0,0:07:57.57,0:07:58.24,ZWDB,,0000,0000,0000,,…Бұл болатын жер
Dialogue: 0,0:07:58.46,0:08:00.28,ZWDB,,0000,0000,0000,,Сіздің атыңыз маңызды.
Dialogue: 0,0:08:00.70,0:08:02.79,ZWDB,,0000,0000,0000,,№ 0 аяқталды.
Dialogue: 0,0:08:03.23,0:08:05.15,ZWDB,,0000,0000,0000,,Нөлден басқа іргелі ойларға жету мүмкін емес.
Dialogue: 0,0:08:05.60,0:08:07.86,ZWDB,,0000,0000,0000,,Бұл жақсы идея емес.
Dialogue: 0,0:08:08.01,0:08:08.55,ZWDB,,0000,0000,0000,,Және...
Dialogue: 0,0:08:10.84,0:08:13.50,ZWDB,,0000,0000,0000,,Біз қазір кіммен жұмыс істеп жатырмыз?
Dialogue: 0,0:08:13.75,0:08:15.31,ZWDB,,0000,0000,0000,,Позитивті келісім және өзіндік ерік
Dialogue: 0,0:08:17.03,0:08:17.67,ZWDB,,0000,0000,0000,,Қосылған мүсіндер мен ойыншықтар
Dialogue: 0,0:08:18.10,0:08:19.17,ZWDB,,0000,0000,0000,,Оларды таба аламыз ба, Мелони?
Dialogue: 0,0:08:19.49,0:08:21.18,ZWDB,,0000,0000,0000,,Жұмысты бастаған кезде жұмыстан кетудің қажеті жоқ.
Dialogue: 0,0:08:22.42,0:08:25.83,ZWDB,,0000,0000,0000,,Дегенмен бұл Тоғашы-күннің бетінің түбі.
Dialogue: 0,0:08:25.83,0:08:29.06,ZWDB,,0000,0000,0000,,Басқа киім кимегенім емес...
Dialogue: 0,0:08:29.43,0:08:30.72,ZWDB,,0000,0000,0000,,Юта Юку киіп жүр
Dialogue: 0,0:08:30.97,0:08:31.59,ZWDB,,0000,0000,0000,,Басқа ойын ашылады
Dialogue: 0,0:08:33.61,0:08:35.77,ZWDB,,0000,0000,0000,,Kageta Junior High School Goblin
Dialogue: 0,0:08:36.54,0:08:37.73,ZWDB,,0000,0000,0000,,Ақыры келді
Dialogue: 0,0:08:38.18,0:08:40.94,ZWDB,,0000,0000,0000,,Өзін-өзі айыптау жиналысы бойынша өзін-өзі айыптауды орындау керек.
Dialogue: 0,0:08:42.11,0:08:43.90,ZWDB,,0000,0000,0000,,Накоре таза ақ су
Dialogue: 0,0:08:44.22,0:08:49.41,ZWDB,,0000,0000,0000,,Орын толығымен жылытылды, енді дәмі тасып жатыр.
Dialogue: 0,0:08:49.69,0:08:54.58,ZWDB,,0000,0000,0000,,Сіз қалу үшін осындасыз және т.б.
Dialogue: 0,0:08:54.78,0:08:57.07,ZWDB,,0000,0000,0000,,Сен періштесің.
Dialogue: 0,0:08:57.27,0:08:59.11,ZWDB,,0000,0000,0000,,Бұл астананың өлімі.
Dialogue: 0,0:09:00.00,0:09:01.84,ZWDB,,0000,0000,0000,,Кел, менің көңілімді көтер.
Dialogue: 0,0:09:01.84,0:09:03.21,ZWDB,,0000,0000,0000,,Қажетсіз Сумита
Dialogue: 0,0:09:03.23,0:09:06.29,ZWDB,,0000,0000,0000,,Кішкене дөңес май қосылған май
Dialogue: 0,0:09:04.35,0:09:06.29,ZWDB,,0000,0000,0000,,Көңілді кету
Dialogue: 0,0:09:06.34,0:09:07.48,ZWDB,,0000,0000,0000,,Нанибутани
Dialogue: 0,0:09:07.73,0:09:10.17,ZWDB,,0000,0000,0000,,Мен қазір бос емеспін.
Dialogue: 0,0:09:10.17,0:09:11.36,ZWDB,,0000,0000,0000,,Бұл дұрыс емес, бірақ бұл шындық.
Dialogue: 0,0:09:11.71,0:09:14.84,ZWDB,,0000,0000,0000,,Бұл туралы сенімен сөйлесу мүмкін емес еді, бірақ мен өлуге мәжбүр болдым ...
Dialogue: 0,0:09:17.32,0:09:18.07,ZWDB,,0000,0000,0000,,Сізге... ұнайды
Dialogue: 0,0:09:18.22,0:09:20.61,ZWDB,,0000,0000,0000,,Бір нәрсені үйрену бір бөлек.
Dialogue: 0,0:09:21.23,0:09:21.90,ZWDB,,0000,0000,0000,,тақырып
Dialogue: 0,0:09:22.30,0:09:24.73,ZWDB,,0000,0000,0000,,Юта Ганың өлімінің қысқаша мазмұны…
Dialogue: 0,0:09:25.08,0:09:28.41,ZWDB,,0000,0000,0000,,Міне, мен секіремін.
Dialogue: 0,0:09:29.65,0:09:31.54,ZWDB,,0000,0000,0000,,Керемет және батыл адам
Dialogue: 0,0:09:32.01,0:09:35.47,ZWDB,,0000,0000,0000,,Сіздің таза ақ су тізбегіңіз жойылды.
Dialogue: 0,0:09:36.84,0:09:38.70,ZWDB,,0000,0000,0000,,Ересек шытырман Мори
Dialogue: 0,0:09:39.20,0:09:42.30,ZWDB,,0000,0000,0000,,Мен сенің келгеніңді және аспанда саяхаттау қабілетіңде шек жоқ көкжиекте қозғалып жатқаныңды білуім керек.
Dialogue: 0,0:09:42.68,0:09:43.55,ZWDB,,0000,0000,0000,,Ересек Мори
Dialogue: 0,0:09:43.70,0:09:47.12,ZWDB,,0000,0000,0000,,Бұл кітапты оқу өте қызықты.
Dialogue: 0,0:09:47.67,0:09:51.77,ZWDB,,0000,0000,0000,,«Мабиногион» жеті түсті қолдан таңдалған кітап, 3 тарау, 1 бөлім
Dialogue: 0,0:09:53.04,0:09:57.76,ZWDB,,0000,0000,0000,,``Бұл рухтың тілі жеңіл, естігенде судың ойы.
Dialogue: 0,0:09:58.33,0:10:00.75,ZWDB,,0000,0000,0000,,Таза дүниежүзілік көрме қазір біздің көз алдымызда».
Dialogue: 0,0:10:01.44,0:10:05.44,ZWDB,,0000,0000,0000,,«400 жылдық тәжірибемде мен әлемнің өзін-өзі ашуын байқадым».
Dialogue: 0,0:10:06.24,0:10:12.53,ZWDB,,0000,0000,0000,,Бұдан былай дүниеде ең маңыздысы – махаббат».
Dialogue: 0,0:10:12.82,0:10:16.10,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:10:14.99,0:10:16.08,ZWDB,,0000,0000,0000,,Басшы сатқындарды міндетті түрде түбірімен жояды…
Dialogue: 0,0:10:17.67,0:10:21.70,ZWDB,,0000,0000,0000,,Бұл күпірлік екені көрініп тұр, ал ақиқат үлкен кісідей сөйлегеннен кейін рух құлдырайды.
Dialogue: 0,0:10:22.17,0:10:23.41,ZWDB,,0000,0000,0000,,Ересек Комори, Фурисакудың шығу тегі
Dialogue: 0,0:10:23.41,0:10:24.21,ZWDB,,0000,0000,0000,,Қажетсіз айқайлау Гамори ересек
Dialogue: 0,0:10:25.18,0:10:27.64,ZWDB,,0000,0000,0000,,Ni… Nibutani You…
Dialogue: 0,0:10:31.51,0:10:37.38,ZWDB,,0000,0000,0000,,Шығыс пен Батыстағы талантты көре алдым деп қалай айттыңыз?
Dialogue: 0,0:10:37.58,0:10:40.04,ZWDB,,0000,0000,0000,,Не істеп жатырсыңдар өзің? Бір сәттен бері құлақ тұндырардай шу болып тұр
Dialogue: 0,0:10:53.51,0:10:56.02,ZWDB,,0000,0000,0000,,Жел... келді.
Dialogue: 0,0:11:06.19,0:11:10.83,ZWDB,,0000,0000,0000,,Әнді көргің келмейді.
Dialogue: 0,0:11:11.58,0:11:14.61,ZWDB,,0000,0000,0000,,Көбінесе бұл белгілі бір әйелдің фотосуреті.
Dialogue: 0,0:11:15.78,0:11:16.23,ZWDB,,0000,0000,0000,,Шынайы оқиға
Dialogue: 0,0:11:17.49,0:11:18.66,ZWDB,,0000,0000,0000,,Көшіретін адам кім?
Dialogue: 0,0:11:19.01,0:11:20.01,ZWDB,,0000,0000,0000,,Нана таза емес...
Dialogue: 0,0:11:21.10,0:11:22.64,ZWDB,,0000,0000,0000,,Әйел өмірі болуы мүмкін.
Dialogue: 0,0:11:23.11,0:11:24.88,ZWDB,,0000,0000,0000,,Сіз оны ала аласыз.
Dialogue: 0,0:11:25.52,0:11:26.04,ZWDB,,0000,0000,0000,,Мүмкін емес
Dialogue: 0,0:11:26.17,0:11:27.39,ZWDB,,0000,0000,0000,,Сіздің жауабыңыз
Dialogue: 0,0:11:28.03,0:11:32.16,ZWDB,,0000,0000,0000,,Бұл да түсініктеме. Бұл әйелдің табысының кілті оның қазіргі уақытта туа алмайтындығы.
Dialogue: 0,0:11:34.27,0:11:38.07,ZWDB,,0000,0000,0000,,Енді мен оны көргеннен кейін оны ұмытып кеттім.
Dialogue: 0,0:11:38.55,0:11:39.37,ZWDB,,0000,0000,0000,,Ұмыту... ұмытылған
Dialogue: 0,0:11:39.81,0:11:42.72,ZWDB,,0000,0000,0000,,Tai Koryo Na Rewatch
Dialogue: 0,0:11:45.16,0:11:46.70,ZWDB,,0000,0000,0000,,Наня
Dialogue: 0,0:11:49.18,0:11:51.59,ZWDB,,0000,0000,0000,,Мен барынша тырыстым.
Dialogue: 0,0:11:52.86,0:11:58.33,ZWDB,,0000,0000,0000,,Алты жыл бұрын топтың үлгеріміне ие болған студент қыздың көрінісі
Dialogue: 0,0:11:58.90,0:12:00.54,ZWDB,,0000,0000,0000,,Егер сізге ұнамаса, бұл туралы алаңдамаңыз.
Dialogue: 0,0:12:01.26,0:12:01.83,ZWDB,,0000,0000,0000,,Сіздің шынайы жоспарыңыз есептелді.
Dialogue: 0,0:12:02.53,0:12:05.44,ZWDB,,0000,0000,0000,,"Сүйікті қыз күні" кезінде
Dialogue: 0,0:12:05.59,0:12:08.99,ZWDB,,0000,0000,0000,,Топтағы ер және қыз студенттер туралы ақпарат аяқталды.
Dialogue: 0,0:12:10.66,0:12:12.62,ZWDB,,0000,0000,0000,,Қазіргі уақытта басталатын оқиғаның белгілі бір кірісі бар және
Dialogue: 0,0:12:13.27,0:12:14.11,ZWDB,,0000,0000,0000,,Исшики…
Dialogue: 0,0:12:18.01,0:12:21.42,ZWDB,,0000,0000,0000,,Мен осында отырмын, көлік жүргізуді тоқтатқаннан бері уақыт өтті.
Dialogue: 0,0:12:32.68,0:12:34.32,ZWDB,,0000,0000,0000,,Қайту уақыты келді
Dialogue: 0,0:12:36.31,0:12:38.37,ZWDB,,0000,0000,0000,,Юта Тесуга
Dialogue: 0,0:12:39.22,0:12:43.79,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:12:43.96,0:12:44.66,ZWDB,,0000,0000,0000,,Қажетсіз әрекеттер
Dialogue: 0,0:13:06.43,0:13:07.05,ZWDB,,0000,0000,0000,,Мүлдем жиіркенішті
Dialogue: 0,0:13:07.42,0:13:08.57,ZWDB,,0000,0000,0000,,Жел туралы менің түсінігім
Dialogue: 0,0:13:09.14,0:13:11.45,ZWDB,,0000,0000,0000,,Жел? Не дейсіз...
Dialogue: 0,0:13:11.95,0:13:13.29,ZWDB,,0000,0000,0000,,Шулы жел
Dialogue: 0,0:13:13.49,0:13:15.18,ZWDB,,0000,0000,0000,,Бұл пойыздың шығып жатқан дыбысы ғана.
Dialogue: 0,0:13:30.29,0:13:35.49,ZWDB,,0000,0000,0000,,Жағдайға келетін болсақ, Иномата дәл осылай білді.
Dialogue: 0,0:13:36.38,0:13:40.98,ZWDB,,0000,0000,0000,,Бұл топтағы ер және қыз студенттерге арналған ерекше атау.
Dialogue: 0,0:13:41.25,0:13:43.34,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:13:43.99,0:13:46.37,ZWDB,,0000,0000,0000,,Теміржол вокзалындағы ұзын орындық сол кезде сонда болды.
Dialogue: 0,0:13:48.01,0:13:52.24,ZWDB,,0000,0000,0000,,Жазбаның иесі жоғалған адам.
Dialogue: 0,0:13:52.54,0:13:53.18,ZWDB,,0000,0000,0000,,Дегенмен, бұл оқиғаның артында тұрған оқиға ...
Dialogue: 0,0:13:53.58,0:13:57.26,ZWDB,,0000,0000,0000,,Мен бұл адамның өмірінде болған оқиғаны жек көремін.
Dialogue: 0,0:14:02.50,0:14:03.10,ZWDB,,0000,0000,0000,,Мера Дугаку
Dialogue: 0,0:14:03.10,0:14:04.02,ZWDB,,0000,0000,0000,,Иә... Иә!
Dialogue: 0,0:14:05.63,0:14:10.01,ZWDB,,0000,0000,0000,,Мера Дугаку Қатыссаңыз, тек қана дауыс беріңіз.
Dialogue: 0,0:14:10.50,0:14:12.82,ZWDB,,0000,0000,0000,,Жоқ... Жоқ
Dialogue: 0,0:14:14.90,0:14:15.43,ZWDB,,0000,0000,0000,,Өлім…
Dialogue: 0,0:14:16.02,0:14:16.57,ZWDB,,0000,0000,0000,,Өлім?
Dialogue: 0,0:14:20.50,0:14:20.87,ZWDB,,0000,0000,0000,,Жазу
Dialogue: 0,0:14:21.22,0:14:21.49,ZWDB,,0000,0000,0000,,Жазба?
Dialogue: 0,0:14:22.09,0:14:23.58,ZWDB,,0000,0000,0000,,Өз өмірім туралы естеліктер
Dialogue: 0,0:14:25.32,0:14:31.75,ZWDB,,0000,0000,0000,,Мен қазіргі жағдайды көрдім.
Dialogue: 0,0:14:32.13,0:14:35.41,ZWDB,,0000,0000,0000,,Нәсаның риуаят етуі: Сапар басталар алдында махаббат хикаясының аяқталуы
Dialogue: 0,0:14:36.85,0:14:38.54,ZWDB,,0000,0000,0000,,Кайсо ой әрекеті Кайсо ойы
Dialogue: 0,0:14:39.24,0:14:42.17,ZWDB,,0000,0000,0000,,Тоғаши мырза оқиғаға қатысты өз ұстанымын қабылдады.
Dialogue: 0,0:14:42.52,0:14:42.99,ZWDB,,0000,0000,0000,,тақырып
Dialogue: 0,0:14:42.99,0:14:45.03,ZWDB,,0000,0000,0000,,Топтың басқа мүшелері
Dialogue: 0,0:14:46.17,0:14:47.51,ZWDB,,0000,0000,0000,,Тоғаши-кунның әңгімесі
Dialogue: 0,0:14:48.53,0:14:50.27,ZWDB,,0000,0000,0000,,Өзім емес...
Dialogue: 0,0:14:50.47,0:14:51.64,ZWDB,,0000,0000,0000,,Сіз оқиға туралы білмедіңіз
Dialogue: 0,0:14:52.01,0:14:54.97,ZWDB,,0000,0000,0000,,Бұл дұрыс емес…
Dialogue: 0,0:14:55.29,0:14:56.46,ZWDB,,0000,0000,0000,,Нана...Нани
Dialogue: 0,0:14:59.34,0:14:59.91,ZWDB,,0000,0000,0000,,Енді мен өз нұсқауларымды жеткіземін.
Dialogue: 0,0:15:00.14,0:15:00.49,ZWDB,,0000,0000,0000,,тақырып
Dialogue: 0,0:15:00.96,0:15:06.45,ZWDB,,0000,0000,0000,,Намотоның Шығыс пен Батыс туралы жазбасы менің көшірмесім, ал әйелдерді алып тастау да менің ойыным.
Dialogue: 0,0:15:09.96,0:15:10.75,ZWDB,,0000,0000,0000,,Исшики…
Dialogue: 0,0:15:10.75,0:15:12.47,ZWDB,,0000,0000,0000,,Исшики Дугаку Назешиннің әңгімесі
Dialogue: 0,0:15:12.99,0:15:16.12,ZWDB,,0000,0000,0000,,Иә, бірақ бұл қажет емес.
Dialogue: 0,0:15:16.52,0:15:18.63,ZWDB,,0000,0000,0000,,Мен топтамын және дауыс беруді жалғастырамын.
Dialogue: 0,0:15:18.88,0:15:21.69,ZWDB,,0000,0000,0000,,Назенто - менің жеке портретім
Dialogue: 0,0:15:24.62,0:15:27.40,ZWDB,,0000,0000,0000,,Ойнайтын уақыт келді.
Dialogue: 0,0:15:27.80,0:15:35.36,ZWDB,,0000,0000,0000,,Бұл оқиға басқа еркектердің тууы мен өліміне қатысты.
Dialogue: 0,0:15:43.53,0:15:45.07,ZWDB,,0000,0000,0000,,Бұл қол шапалақтау уақыты.
Dialogue: 0,0:15:45.07,0:15:46.04,ZWDB,,0000,0000,0000,,Мүлдем қате
Dialogue: 0,0:15:46.47,0:15:50.44,ZWDB,,0000,0000,0000,,Бірдей нәрсені айту сәл басқаша, бірақ бір студент бір адам.
Dialogue: 0,0:15:51.19,0:15:55.51,ZWDB,,0000,0000,0000,,Алайда бұл жағдайдың әшкереленуі және әйелдердің жаратылуына зиян келтіруі.
Dialogue: 0,0:15:56.21,0:15:59.99,ZWDB,,0000,0000,0000,,Жағдай өзгерді және оқиға өзгерді.
Dialogue: 0,0:16:01.33,0:16:02.47,ZWDB,,0000,0000,0000,,Сіз Исшики…
Dialogue: 0,0:16:02.94,0:16:06.08,ZWDB,,0000,0000,0000,,Өз ісіне жарамсыз адам.
Dialogue: 0,0:16:06.08,0:16:07.34,ZWDB,,0000,0000,0000,,Дегенмен, Шакоцуя…
Dialogue: 0,0:16:07.64,0:16:10.18,ZWDB,,0000,0000,0000,,Бір-біріне жету қажет емес...
Dialogue: 0,0:16:11.32,0:16:15.12,ZWDB,,0000,0000,0000,,Ер адам болу шарт емес.
Dialogue: 0,0:16:19.10,0:16:20.42,ZWDB,,0000,0000,0000,,Сеніңше, қалай?
Dialogue: 0,0:16:20.99,0:16:25.59,ZWDB,,0000,0000,0000,,Мен басқаларға көмекші болған кезде өзімді тану мен өзімді танудың шеберімін.
Dialogue: 0,0:16:26.13,0:16:26.71,ZWDB,,0000,0000,0000,,Алға
Dialogue: 0,0:16:26.88,0:16:30.28,ZWDB,,0000,0000,0000,,Дегенмен, өз-өзіне жүктелген кінәні ер бала жапты.
Dialogue: 0,0:16:30.76,0:16:33.79,ZWDB,,0000,0000,0000,,Дегенмен, бұл сіздің жоспарыңыз.
Dialogue: 0,0:16:34.01,0:16:37.14,ZWDB,,0000,0000,0000,,Бұл қырылған жеңіл бастың оқиғасы.
Dialogue: 0,0:16:37.14,0:16:41.72,ZWDB,,0000,0000,0000,,Сіз оны оқып шықтым деп ойладыңыз, бірақ оны көрмедіңіз.
Dialogue: 0,0:16:42.39,0:16:44.45,ZWDB,,0000,0000,0000,,Дегенмен, егер сіз оны айтсаңыз, «Кешіріңіз» деп айту керек.
Dialogue: 0,0:16:44.85,0:16:48.28,ZWDB,,0000,0000,0000,,Пікірімді жоғалтқаным үшін кешірім сұраймын, бірақ мен өз үйімді тастап кеттім ...
Dialogue: 0,0:16:48.28,0:16:49.37,ZWDB,,0000,0000,0000,,Соуя Мияко Нагата
Dialogue: 0,0:16:50.14,0:16:51.71,ZWDB,,0000,0000,0000,,Ни…Нибутани Уақыт келді.
Dialogue: 0,0:16:52.45,0:16:54.96,ZWDB,,0000,0000,0000,,Кіріспе сөз түсінікті: Студент қыздар бар деген күдік бар.
Dialogue: 0,0:16:55.49,0:16:55.88,ZWDB,,0000,0000,0000,,тақырып
Dialogue: 0,0:16:56.36,0:16:59.64,ZWDB,,0000,0000,0000,,Тек тұмсықпен сөйле.
Dialogue: 0,0:16:59.86,0:17:01.97,ZWDB,,0000,0000,0000,,Зайшики Дугаку-Юу ``Каиичи Рёдан'' алдында
Dialogue: 0,0:17:02.79,0:17:03.24,ZWDB,,0000,0000,0000,,Мен...мен...
Dialogue: 0,0:17:03.69,0:17:07.07,ZWDB,,0000,0000,0000,,Әрине, бұл Исшики Доужиншидің өзін-өзі түсіндіруі.
Dialogue: 0,0:17:07.94,0:17:09.83,ZWDB,,0000,0000,0000,,Бұл дұрыс емес. Бұл дұрыс емес.
Dialogue: 0,0:17:12.31,0:17:14.90,ZWDB,,0000,0000,0000,,Мен бірінші сұрақты қойдым, қырынуға бола ма?
Dialogue: 0,0:17:15.02,0:17:17.28,ZWDB,,0000,0000,0000,,Бұл менің жүрегімде ауыр тәжірибе
Dialogue: 0,0:17:17.56,0:17:21.56,ZWDB,,0000,0000,0000,,Кіші мектепті бітіргеніме үш жыл болған соң, мен жеңіл ойлы адам болып өмір сүрдім.
Dialogue: 0,0:17:21.96,0:17:22.95,ZWDB,,0000,0000,0000,,Мен шашымды қырдым
Dialogue: 0,0:17:22.95,0:17:25.91,ZWDB,,0000,0000,0000,,Бүгінгі күнге дейінгі жолдағы ұжымның тарихына шолу
Dialogue: 0,0:17:26.06,0:17:30.46,ZWDB,,0000,0000,0000,,1993 жылы туған Нага Шиба есімді адам туралы әңгіме.
Dialogue: 0,0:17:30.88,0:17:34.06,ZWDB,,0000,0000,0000,,Нюя бейнесінің оқиғасы, қайдан шыққаным туралы әңгіме.
Dialogue: 0,0:17:34.06,0:17:36.72,ZWDB,,0000,0000,0000,,Командадағы студент қыз Вананың көшірмесі.
Dialogue: 0,0:17:36.84,0:17:38.51,ZWDB,,0000,0000,0000,,Мен қаланы тұтастай елестетемін.
Dialogue: 0,0:17:38.88,0:17:41.39,ZWDB,,0000,0000,0000,,Мен сонда болғанға дейін, онымен сөйлескеннен кейін.
Dialogue: 0,0:17:41.72,0:17:44.42,ZWDB,,0000,0000,0000,,Ұжымдағы ер студенттермен кездесуге тағы да күдікті
Dialogue: 0,0:17:44.55,0:17:45.19,ZWDB,,0000,0000,0000,,Есептеулер күнтізбесі
Dialogue: 0,0:17:45.39,0:17:47.61,ZWDB,,0000,0000,0000,,Бұл нақты дауыс беру процедурасы.
Dialogue: 0,0:17:48.35,0:17:52.85,ZWDB,,0000,0000,0000,,Өзін-өзі жою жағдайларына келетін болсақ, мен адам емеспін.
Dialogue: 0,0:17:57.60,0:17:59.44,ZWDB,,0000,0000,0000,,Сіз осындасыз.
Dialogue: 0,0:17:59.78,0:18:01.62,ZWDB,,0000,0000,0000,,Сеппукудың жапондық нұсқасы
Dialogue: 0,0:18:01.62,0:18:02.27,ZWDB,,0000,0000,0000,,Дарынсыз
Dialogue: 0,0:18:02.27,0:18:05.43,ZWDB,,0000,0000,0000,,Басқа бастың болуы жақсы идея емес.
Dialogue: 0,0:18:05.58,0:18:08.43,ZWDB,,0000,0000,0000,,Сен осы ауылдасың, сырт келбетің де жиіркенішті.
Dialogue: 0,0:18:08.68,0:18:10.94,ZWDB,,0000,0000,0000,,Бұл бізде бар әлеуметтік қауіпсіздіктің құпия базасы…
Dialogue: 0,0:18:10.94,0:18:11.81,ZWDB,,0000,0000,0000,,Сәттілік
Dialogue: 0,0:18:11.91,0:18:12.78,ZWDB,,0000,0000,0000,,Уолтер Эванс (59)
Dialogue: 0,0:18:13.88,0:18:15.34,ZWDB,,0000,0000,0000,,Менің қызметшім
Dialogue: 0,0:18:15.84,0:18:18.00,ZWDB,,0000,0000,0000,,Бұл мөр
Dialogue: 0,0:18:22.30,0:18:23.30,ZWDB,,0000,0000,0000,,Юта Го
Dialogue: 0,0:18:25.06,0:18:26.60,ZWDB,,0000,0000,0000,,Қолдауыңызға рахмет.
Dialogue: 0,0:18:27.75,0:18:31.08,ZWDB,,0000,0000,0000,,Ашылу салтанатының литургиясын аралаңыз.
Dialogue: 0,0:18:32.34,0:18:36.15,ZWDB,,0000,0000,0000,,Әкем 35 жыл бұрын келген кезде
Dialogue: 0,0:18:36.57,0:18:40.74,ZWDB,,0000,0000,0000,,Менің жеке әңгімеме қалай келдіңіз? Сенімен ойнағаныма жиырма жыл болды.
Dialogue: 0,0:18:41.81,0:18:44.55,ZWDB,,0000,0000,0000,,Нарименнің үш жасар орамасы жарық сезгіштігінен өтті
Dialogue: 0,0:18:45.29,0:18:48.72,ZWDB,,0000,0000,0000,,Тірі екенім рас, бірақ әлі тірімін.
Dialogue: 0,0:18:49.87,0:18:52.72,ZWDB,,0000,0000,0000,,Ичи… Исшики… И
Dialogue: 0,0:18:54.29,0:18:56.28,ZWDB,,0000,0000,0000,,Юта жылап жатыр
Dialogue: 0,0:19:00.18,0:19:03.81,ZWDB,,0000,0000,0000,,Келесі жолы келгенде, мен тағы да бақытты боламын
Dialogue: 0,0:19:04.18,0:19:09.38,ZWDB,,0000,0000,0000,,Исшики!
Dialogue: 0,0:19:10.64,0:19:12.83,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:19:13.28,0:19:15.02,ZWDB,,0000,0000,0000,,Хари мөрленген
Dialogue: 0,0:19:15.27,0:19:15.79,ZWDB,,0000,0000,0000,,Мөр шығарылды
Dialogue: 0,0:19:16.93,0:19:17.65,ZWDB,,0000,0000,0000,,Растау аяқталды
Dialogue: 0,0:19:18.22,0:19:19.37,ZWDB,,0000,0000,0000,,Менің қызметкерлерім
Dialogue: 0,0:19:19.81,0:19:21.01,ZWDB,,0000,0000,0000,,Расталған
Dialogue: 0,0:19:21.65,0:19:24.11,ZWDB,,0000,0000,0000,,Дегенмен, ағымдағы түс өзгерді және сапасы өзгерді.
Dialogue: 0,0:19:24.86,0:19:27.72,ZWDB,,0000,0000,0000,,Барлықтарыңызға жаңа революцияны бастау рухы осында.
Dialogue: 0,0:19:29.81,0:19:30.40,ZWDB,,0000,0000,0000,,Сондай-ақ
Dialogue: 0,0:19:30.48,0:19:31.20,ZWDB,,0000,0000,0000,,Түсінемін
Dialogue: 0,0:19:31.35,0:19:32.37,ZWDB,,0000,0000,0000,,Garai Kyoyo басқа сиқырлы күш
Dialogue: 0,0:19:32.59,0:19:34.53,ZWDB,,0000,0000,0000,,Бұл анық емес екені анық.
Dialogue: 0,0:19:34.73,0:19:35.10,ZWDB,,0000,0000,0000,,…Бұл болатын жер
Dialogue: 0,0:19:35.62,0:19:42.01,ZWDB,,0000,0000,0000,,Барар алдында абай болу керек.
Dialogue: 0,0:19:47.68,0:19:49.54,ZWDB,,0000,0000,0000,,Талантыңнан айырылғанда, мен саған бұл туралы айттым.
Dialogue: 0,0:19:49.54,0:19:50.63,ZWDB,,0000,0000,0000,,Сіз оны кептіріңіз.
Dialogue: 0,0:19:50.73,0:19:51.26,ZWDB,,0000,0000,0000,,Исшики
Dialogue: 0,0:19:53.00,0:19:55.73,ZWDB,,0000,0000,0000,,Сіз батыр болып көріндіңіз, мен сенен күш-қуат күту үшін келдім.
Dialogue: 0,0:19:57.67,0:20:02.74,ZWDB,,0000,0000,0000,,Бұл менің қара күшім, менің бұйрығым және менің батам.
Dialogue: 0,0:20:07.73,0:20:09.65,ZWDB,,0000,0000,0000,,Сен!
Dialogue: 0,0:20:11.39,0:20:13.23,ZWDB,,0000,0000,0000,,Кота Юрикирио
Dialogue: 0,0:20:15.12,0:20:20.14,ZWDB,,0000,0000,0000,,Тағы бір күлкі.
Dialogue: 0,0:20:15.34,0:20:20.14,ZWDB,,0000,0000,0000,,Сүйікті студент қыздың оқудан шығарылуына әкелген оқиға аяқталды.
Dialogue: 0,0:20:21.38,0:20:26.35,ZWDB,,0000,0000,0000,,Қызды құшақтап алғаннан кейінгі кездесуде қыздың өмірінің пайда болуын күту.
Dialogue: 0,0:20:26.57,0:20:30.75,ZWDB,,0000,0000,0000,,Тағдырдың келуі мен аяқталуының 6 жұлдызды кезеңі
Dialogue: 0,0:20:33.33,0:20:36.24,ZWDB,,0000,0000,0000,,Исшики Дугаку
Dialogue: 0,0:20:36.86,0:20:42.38,ZWDB,,0000,0000,0000,,Мектеп ер халықтың туған жерінің ақылсыздығы мен қызуын қолдауға толы.
Dialogue: 0,0:20:47.82,0:20:52.22,ZWDB,,0000,0000,0000,,Нәтижесінде фотокітаптағы әйел өмірінің оқиғасы сәтсіздікке ұшырайды.
Dialogue: 0,0:20:53.17,0:20:55.35,ZWDB,,0000,0000,0000,,Нибутани Ю Чидо - көшіргіңіз келетін адам
Dialogue: 0,0:20:55.73,0:20:58.09,ZWDB,,0000,0000,0000,,Шукан Чимичия қайтыс болғаннан кейін
Dialogue: 0,0:20:58.81,0:20:59.53,ZWDB,,0000,0000,0000,,Сондай-ақ
Dialogue: 0,0:21:00.67,0:21:06.24,ZWDB,,0000,0000,0000,,Егер сіз өз өміріңізді қорғағыңыз келмесе, өміріңізді тоқтатпаудан сақ болыңыз.
Dialogue: 0,0:21:07.11,0:21:09.05,ZWDB,,0000,0000,0000,,Менде де әйел өмірі туралы түсінік бар.
Dialogue: 0,0:21:09.05,0:21:09.69,ZWDB,,0000,0000,0000,,Шынайы оқиға
Dialogue: 0,0:21:10.09,0:21:12.13,ZWDB,,0000,0000,0000,,Өмір сүре алмайтын студент қыз
Dialogue: 0,0:21:12.85,0:21:13.95,ZWDB,,0000,0000,0000,,Сіз осындасыз
Dialogue: 0,0:21:16.53,0:21:20.66,ZWDB,,0000,0000,0000,,Не істерімді білмеймін, не істерімді білмеймін, не істерімді білмеймін ...
Dialogue: 0,0:21:21.08,0:21:23.34,ZWDB,,0000,0000,0000,,Исшики-кунның басы сенікі.
Dialogue: 0,0:21:27.04,0:21:28.71,ZWDB,,0000,0000,0000,,және т.б. т.б.. Сіз…
Dialogue: 0,0:21:29.73,0:21:31.91,ZWDB,,0000,0000,0000,,Міне, жаз маусымы
Dialogue: 0,0:21:37.61,0:21:39.25,ZWDB,,0000,0000,0000,,Юта Ютаның жұмысы
Dialogue: 0,0:21:40.39,0:21:44.44,ZWDB,,0000,0000,0000,,Жапония биыл келе алмайды
Dialogue: 0,0:21:44.66,0:21:47.35,ZWDB,,0000,0000,0000,,Сондықтан мен сені тастап кетемін.
Dialogue: 0,0:21:47.62,0:21:49.44,ZWDB,,0000,0000,0000,,Чиду Рио Гайкай Какугеки
Dialogue: 0,0:21:53.56,0:21:56.89,ZWDB,,0000,0000,0000,,Юута менің сенімен бір шаруам бар
Dialogue: 0,0:21:58.73,0:22:01.86,ZWDB,,0000,0000,0000,,Ыстық кезде
Dialogue: 0,0:22:03.70,0:22:06.41,ZWDB,,0000,0000,0000,,Маған сен керексің
Dialogue: 0,0:22:08.80,0:22:11.23,ZWDB,,0000,0000,0000,,Жаздың соңы
Dialogue: 0,0:05:46.71,0:05:48.30,ZWDB,,0000,0000,0000,,(Ескертпе: Шеңбер кейіпкерлері, мультфильм шрифті, Жапонияның бірінші орта және орта мектептегі қыздар сериясы, әрқашан пайдаланылады)
Dialogue: 0,0:23:45.35,0:23:51.35,Default,,0,0,0,,{\\an8\\fs18\\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\\NБарлық құқықтары қорғалған • github.com/ikymory
