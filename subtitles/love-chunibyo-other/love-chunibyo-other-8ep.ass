Dialogue: 0,0:00:00.00,0:00:05.00,Default,,0000,0000,0000,,
Dialogue: 0,0:22:08.62,0:22:09.30,Default,,0000,0000,0000,,

Dialogue: 0,0:00:06.26,0:00:11.38,JPDB,,0000,0000,0000,,Жарылсын, шын, жарылсын, синапс
Dialogue: 0,0:00:14.48,0:00:18.41,JPDB,,0000,0000,0000,,Бұл әлемді қуу
Dialogue: 0,0:00:37.03,0:00:39.04,JPDB,,0000,0000,0000,,Avalon Smash
Dialogue: 0,0:00:39.74,0:00:42.00,JPDB,,0000,0000,0000,,Сіз қашанға дейін ақымақ істермен айналыса бересіз?
Dialogue: 0,0:00:49.88,0:00:50.65,JPDB,,0000,0000,0000,,Бұл көңілді ме?
Dialogue: 0,0:00:53.51,0:00:57.51,JPDB,,0000,0000,0000,,Мәңгілік бала сияқты өзімшіл болу қызық емес пе?
Dialogue: 0,0:01:00.14,0:01:01.71,JPDB,,0000,0000,0000,,Кантикула
Dialogue: 0,0:01:14.83,0:01:16.12,JPDB,,0000,0000,0000,,Сіз анаңызды жек көресіз бе?
Dialogue: 0,0:01:17.54,0:01:18.24,JPDB,,0000,0000,0000,,Жоқ
Dialogue: 0,0:01:19.01,0:01:21.42,JPDB,,0000,0000,0000,,Сіз ата мен әжені ұятқа қалдырғыңыз келе ме?
Dialogue: 0,0:01:24.40,0:01:25.00,JPDB,,0000,0000,0000,,Жоқ
Dialogue: 0,0:01:25.57,0:01:28.03,JPDB,,0000,0000,0000,,Білесіз бе, бұл туралы ештеңе істей алмайсыз.
Dialogue: 0,0:01:28.18,0:01:29.47,JPDB,,0000,0000,0000,,Мен бұл туралы ештеңе істей алмаймын
Dialogue: 0,0:01:31.73,0:01:34.99,JPDB,,0000,0000,0000,,Мен қалай қанағаттандыра аламын? Мен ештеңе істей алмаймын.
Dialogue: 0,0:01:35.91,0:01:36.73,JPDB,,0000,0000,0000,,Жаман көз
Dialogue: 0,0:01:37.50,0:01:37.99,JPDB,,0000,0000,0000,,Иә…♡
Dialogue: 0,0:01:55.77,0:01:56.29,JPDB,,0000,0000,0000,,Жоқ…
Dialogue: 0,0:01:58.90,0:02:03.15,JPDB,,0000,0000,0000,,Жоқ, жоқ, жоқ
Dialogue: 0,0:02:07.99,0:02:11.72,JPDB,,0000,0000,0000,,Менің бұл жерде енді үйім жоқ, әкем еш жерде жоқ.
Dialogue: 0,0:02:12.72,0:02:14.26,JPDB,,0000,0000,0000,,Көрінбейтін шекара сызығы дегеніміз не?
Dialogue: 0,0:02:14.48,0:02:15.03,JPDB,,0000,0000,0000,,Харизма!
Dialogue: 0,0:02:17.17,0:02:19.43,JPDB,,0000,0000,0000,,Көрінбейтін шекара бар...
Dialogue: 0,0:02:23.88,0:02:24.62,JPDB,,0000,0000,0000,,Сіз...
Dialogue: 0,0:04:10.13,0:04:13.06,JPDB,,0000,0000,0000,,Менің ойымша, Тоқа-сан дұрыс.
Dialogue: 0,0:04:14.23,0:04:14.70,JPDB,,0000,0000,0000,,Юта…
Dialogue: 0,0:04:15.64,0:04:18.13,JPDB,,0000,0000,0000,,Бірақ мен мұны білемін
Dialogue: 0,0:04:19.42,0:04:22.26,JPDB,,0000,0000,0000,,Менің ойымша, Рикка мұны білетіндіктен істеп жатыр.
Dialogue: 0,0:04:24.52,0:04:27.75,JPDB,,0000,0000,0000,,Тіпті олар маған оны қабылдауым керек екенін айтты, өйткені бұл шындық.
Dialogue: 0,0:04:28.44,0:04:30.04,JPDB,,0000,0000,0000,,Мен қабылдай алмайтын көптеген нәрселер бар.
Dialogue: 0,0:04:32.69,0:04:36.03,JPDB,,0000,0000,0000,,Бірақ оқиғалар бірінен соң бірі болып жатты, мен ойымды реттеп үлгермедім.
Dialogue: 0,0:04:36.42,0:04:37.94,JPDB,,0000,0000,0000,,Мұның бәрі аяқталуы керек еді.
Dialogue: 0,0:04:41.15,0:04:44.13,JPDB,,0000,0000,0000,,Мен қашып жүрген жоқпын, қарамаймын.
Dialogue: 0,0:04:44.97,0:04:48.01,JPDB,,0000,0000,0000,,Бірақ кәдімгі сөздермен бұл жай ғана қабылдансын.
Dialogue: 0,0:04:48.01,0:04:49.55,JPDB,,0000,0000,0000,,Мен бұл дұрыс па деп ойладым.
Dialogue: 0,0:04:53.52,0:04:58.67,JPDB,,0000,0000,0000,,Бірақ бәрі бұл қалыпты жағдай, бұл шындық деп айтады.
Dialogue: 0,0:04:59.56,0:05:01.05,JPDB,,0000,0000,0000,,Бұл шынымен жақсы ма?
Dialogue: 0,0:05:02.72,0:05:06.35,JPDB,,0000,0000,0000,,Бұл шындық. Біз бәріміз осылай өмір сүреміз.
Dialogue: 0,0:05:07.22,0:05:08.81,JPDB,,0000,0000,0000,,Ересек болу деген осы.
Dialogue: 0,0:05:10.15,0:05:13.36,JPDB,,0000,0000,0000,,Мен солай ойлаймын, бірақ бұл жігіт...
Dialogue: 0,0:05:15.64,0:05:16.26,JPDB,,0000,0000,0000,,Рикка
Dialogue: 0,0:05:18.25,0:05:19.00,JPDB,,0000,0000,0000,,Рикка
Dialogue: 0,0:05:40.47,0:05:41.17,JPDB,,0000,0000,0000,,Рикка
Dialogue: 0,0:05:47.26,0:05:49.20,JPDB,,0000,0000,0000,,О, үйге қош келдіңіз.
Dialogue: 0,0:05:49.52,0:05:50.61,JPDB,,0000,0000,0000,,О, Рикка ше?
Dialogue: 0,0:05:51.13,0:05:55.78,JPDB,,0000,0000,0000,,Ах, мен таксимен жағажайға қайттым.
Dialogue: 0,0:05:56.08,0:05:59.68,JPDB,,0000,0000,0000,,Одан біраз уақыт бұрын барлығы сыртқа шықты, өйткені отшашу болады.
Dialogue: 0,0:05:59.83,0:06:00.78,JPDB,,0000,0000,0000,,Рахмет
Dialogue: 0,0:06:06.00,0:06:09.00,JPDB,,0000,0000,0000,,Қараңғы айдаһардың босатылатын уақыты келді.
Dialogue: 0,0:06:16.11,0:06:18.08,JPDB,,0000,0000,0000,,Өлімді күту Өлімді күту
Dialogue: 0,0:06:21.21,0:06:22.72,JPDB,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:06:26.78,0:06:30.43,JPDB,,0000,0000,0000,,Мен мұндамын, мында, мында, мында, кеттік.
Dialogue: 0,0:06:31.30,0:06:32.32,JPDB,,0000,0000,0000,,Уф… Таңертеңгісін-ақ шаршап біттім.
Dialogue: 0,0:06:35.00,0:06:36.69,JPDB,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:06:41.44,0:06:43.25,JPDB,,0000,0000,0000,,Бұл қызық, солай емес пе?
Dialogue: 0,0:06:44.02,0:06:45.25,JPDB,,0000,0000,0000,,Өрмектей өрілген тағдырлар
Dialogue: 0,0:06:47.65,0:06:53.00,JPDB,,0000,0000,0000,,Қалай болғанда да, Тогаши-кун мен Рикка-чан кешігіп қалды. Мен олар қайда кетті деп ойлаймын.
Dialogue: 0,0:06:53.37,0:06:58.71,JPDB,,0000,0000,0000,,Жазғы каникулда жағажайға келіп, бірге жасырын қыдыратыныңды айттым.
Dialogue: 0,0:06:58.96,0:07:02.09,JPDB,,0000,0000,0000,,Параллель әлемнің жауынгерімен күтпеген кездесу
Dialogue: 0,0:07:06.96,0:07:08.03,JPDB,,0000,0000,0000,,Тоғаши мырза
Dialogue: 0,0:07:08.48,0:07:09.23,JPDB,,0000,0000,0000,,Рикка ше?
Dialogue: 0,0:07:10.00,0:07:11.23,JPDB,,0000,0000,0000,,​​Ол келмеді.
Dialogue: 0,0:07:12.13,0:07:12.83,JPDB,,0000,0000,0000,,Сол жігіт
Dialogue: 0,0:07:15.27,0:07:16.29,JPDB,,0000,0000,0000,,Тоғаши мырза
Dialogue: 0,0:07:17.03,0:07:18.57,JPDB,,0000,0000,0000,,Сен өте жассың
Dialogue: 0,0:07:18.80,0:07:20.04,JPDB,,0000,0000,0000,,Мүмкін хаос көрінісі?
Dialogue: 0,0:07:20.21,0:07:22.25,JPDB,,0000,0000,0000,,Шураба — күшті тосқауыл сиқыры
Dialogue: 0,0:07:44.02,0:07:44.69,JPDB,,0000,0000,0000,,Юта
Dialogue: 0,0:07:48.35,0:07:50.68,JPDB,,0000,0000,0000,,Бұл соңғы минут болды.
Dialogue: 0,0:07:51.53,0:07:52.22,JPDB,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:07:52.97,0:07:55.75,JPDB,,0000,0000,0000,,Бұл менің жолым. Қайда бара жатырсың?
Dialogue: 0,0:07:58.02,0:08:04.33,JPDB,,0000,0000,0000,,Күтілгендей, басқару бюросының күші бұл аймақта орасан зор. Барьердің күші тым күшті. Эвакуация
Dialogue: 0,0:08:05.87,0:08:07.01,JPDB,,0000,0000,0000,,Үйге барасыз ба?
Dialogue: 0,0:08:17.63,0:08:18.20,JPDB,,0000,0000,0000,,Юта
Dialogue: 0,0:08:19.61,0:08:19.86,JPDB,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:20.71,0:08:25.08,JPDB,,0000,0000,0000,,Юта қараңғы жалынның күшін қайдан алды?
Dialogue: 0,0:08:25.73,0:08:27.34,JPDB,,0000,0000,0000,,Соған ұқсас нәрсе...
Dialogue: 0,0:08:31.20,0:08:34.20,JPDB,,0000,0000,0000,,Бастапқыда жай ғана достар сөйлесті.
Dialogue: 0,0:08:35.82,0:08:37.88,JPDB,,0000,0000,0000,,«Бәріміз сыртқа шығып, көңіл көтерейік» деген толқулар көп.
Dialogue: 0,0:08:38.65,0:08:42.36,JPDB,,0000,0000,0000,,Мен ғана басқаша сезіндім.
Dialogue: 0,0:08:43.47,0:08:44.44,JPDB,,0000,0000,0000,,Бұл жайсыздық сезімі ме?
Dialogue: 0,0:08:44.99,0:08:48.47,JPDB,,0000,0000,0000,,Дүниеден алыстап бара жатқандай біртүрлі жалғыздық сезімі.
Dialogue: 0,0:08:51.08,0:08:54.83,JPDB,,0000,0000,0000,,Қараңғы сана басқа әлем туралы естеліктерді тудырды ма?
Dialogue: 0,0:08:55.80,0:08:59.06,JPDB,,0000,0000,0000,,Мен осылай сезіндім...
Dialogue: 0,0:09:03.08,0:09:04.00,JPDB,,0000,0000,0000,,Мен ұмытқым келеді
Dialogue: 0,0:09:04.70,0:09:06.76,JPDB,,0000,0000,0000,,Басқару станциясының кедергісінде не болды?
Dialogue: 0,0:09:07.01,0:09:10.14,JPDB,,0000,0000,0000,,Жоқ, бұл сізсіз.
Dialogue: 0,0:09:10.14,0:09:10.99,JPDB,,0000,0000,0000,,Our eyes met
Dialogue: 0,0:09:27.14,0:09:31.42,JPDB,,0000,0000,0000,,Dark Flame Master енді жетілдірілген келісімшартқа отырды.
Dialogue: 0,0:09:32.04,0:09:32.78,JPDB,,0000,0000,0000,,Айтыңызшы
Dialogue: 0,0:09:33.60,0:09:35.32,JPDB,,0000,0000,0000,,Қараңғылық жалынымен құшақтасып...
Dialogue: 0,0:09:35.37,0:09:36.16,JPDB,,0000,0000,0000,,Сүннет
Dialogue: 0,0:09:48.29,0:09:49.66,JPDB,,0000,0000,0000,,А, бұл Тоғаши-кун.
Dialogue: 0,0:09:50.26,0:09:51.28,JPDB,,0000,0000,0000,,Не?
Dialogue: 0,0:09:51.75,0:09:54.94,JPDB,,0000,0000,0000,,Которию-сан үйіне қайтып бара жатқанын айтты, сондықтан оны тастап кететінін айтты.
Dialogue: 0,0:09:56.27,0:09:57.91,JPDB,,0000,0000,0000,,Сіз үйге кеттіңіз дейсіз бе?
Dialogue: 0,0:09:58.31,0:09:59.91,JPDB,,0000,0000,0000,,Бұл өте батыл, солай емес пе?
Dialogue: 0,0:10:00.42,0:10:01.44,JPDB,,0000,0000,0000,,Жуан деген не?
Dialogue: 0,0:10:02.56,0:10:05.69,JPDB,,0000,0000,0000,,Жеңіл болмасаң, маған ғашық боласың.
Dialogue: 0,0:10:08.72,0:10:11.33,JPDB,,0000,0000,0000,,Сіз ер адаммен кездесіп көрдіңіз бе?
Dialogue: 0,0:10:11.76,0:10:15.88,JPDB,,0000,0000,0000,,Иә, мен балабақшада жүргенде Така-кунмен бір сыныпта оқитынмын.
Dialogue: 0,0:10:17.00,0:10:19.88,JPDB,,0000,0000,0000,,Бірақ кейін әкем жұмыс бабымен шетелге кетті.
Dialogue: 0,0:10:20.16,0:10:24.43,JPDB,,0000,0000,0000,,Мен бастауыш немесе орта мектепке бармадым және жеке мұғалім болдым.
Dialogue: 0,0:10:25.03,0:10:27.69,JPDB,,0000,0000,0000,,Бұл жігіт ұзақ уақыттан кейін нағыз табиғи ма?
Dialogue: 0,0:10:28.28,0:10:28.90,JPDB,,0000,0000,0000,,Шұғыл хабар, шұғыл хабар!
Dialogue: 0,0:10:28.90,0:10:30.62,JPDB,,0000,0000,0000,,Аа, кешіріңіз.
Dialogue: 0,0:10:34.57,0:10:41.38,JPDB,,0000,0000,0000,,Ішке батқан өлім. Декоморидің денесі Икардың қанаттары сияқты күн күйген өлім.
Dialogue: 0,0:10:43.10,0:10:44.36,JPDB,,0000,0000,0000,,Қандай өлім?
Dialogue: 0,0:10:44.84,0:10:49.73,JPDB,,0000,0000,0000,,Жоқ, мен оны сенің арқаңнан жуып алайын деп ойладым.
Dialogue: 0,0:10:50.18,0:10:52.04,JPDB,,0000,0000,0000,,Тек дұрыс бақа болды.
Dialogue: 0,0:10:52.94,0:10:55.13,JPDB,,0000,0000,0000,,Ке... өте нашар
Dialogue: 0,0:10:55.72,0:10:57.01,JPDB,,0000,0000,0000,,Кездесе алмағаныма өкінішті—жоқ, бәріңмен… деп ойлаймын.
Dialogue: 0,0:10:57.54,0:10:59.01,JPDB,,0000,0000,0000,,Жақын келмеңіз
Dialogue: 0,0:11:11.65,0:11:13.34,JPDB,,0000,0000,0000,,Бұл өте кеш.
Dialogue: 0,0:11:13.99,0:11:16.15,JPDB,,0000,0000,0000,,Юта бөлмеге кіре алмайды
Dialogue: 0,0:11:19.91,0:11:21.45,JPDB,,0000,0000,0000,,Кілт өзгертілді
Dialogue: 0,0:11:21.62,0:11:23.82,JPDB,,0000,0000,0000,,Мен кілттерімді ұмытып қалдым деп ойлаймын.
Dialogue: 0,0:11:24.35,0:11:26.34,JPDB,,0000,0000,0000,,Менің таңдауым жоқ.
Dialogue: 0,0:11:27.64,0:11:29.82,JPDB,,0000,0000,0000,,Бұл қазір үй.
Dialogue: 0,0:11:31.61,0:11:32.66,JPDB,,0000,0000,0000,,Онда ешкім жоқ
Dialogue: 0,0:11:34.32,0:11:35.12,JPDB,,0000,0000,0000,,Жер
Dialogue: 0,0:11:36.86,0:11:38.65,JPDB,,0000,0000,0000,,Басқару бюросына шабуыл болуы мүмкін бе?
Dialogue: 0,0:11:39.04,0:11:41.31,JPDB,,0000,0000,0000,,Тоқта, менің отбасыма тиіспе.
Dialogue: 0,0:11:41.83,0:11:43.42,JPDB,,0000,0000,0000,,Сәтсіздікті айтпа
Dialogue: 0,0:11:45.73,0:11:50.97,JPDB,,0000,0000,0000,,А, түсіндім. Кузуха мен Юмеха орман мектебінде, ал анасы түнгі ауысымда жұмыс істейді.
Dialogue: 0,0:11:51.27,0:11:54.25,JPDB,,0000,0000,0000,,Сақ болыңыз, алдау мүмкіндігі бар.
Dialogue: 0,0:11:54.33,0:11:55.17,JPDB,,0000,0000,0000,,Эй
Dialogue: 0,0:11:56.02,0:11:58.93,JPDB,,0000,0000,0000,,Ертең бәріміз үйге қайтамыз.
Dialogue: 0,0:11:59.72,0:12:04.30,JPDB,,0000,0000,0000,,Демек, бүгін түнде екеуміз ғана болдық па?
Dialogue: 0,0:12:25.84,0:12:28.88,JPDB,,0000,0000,0000,,Иә? Ол қай дәретхана болды?
Dialogue: 0,0:12:31.59,0:12:32.58,JPDB,,0000,0000,0000,,Күмін-сенпай?
Dialogue: 0,0:12:33.87,0:12:36.83,JPDB,,0000,0000,0000,,Әй, Исшики-кун да ояу еді.
Dialogue: 0,0:12:37.62,0:12:38.57,JPDB,,0000,0000,0000,,Не болды?
Dialogue: 0,0:12:39.81,0:12:46.37,JPDB,,0000,0000,0000,,Сыртта қараңғы болса, ай әдемі деп ойлаймын, мен серуендеу керек деп ойлаймын.
Dialogue: 0,0:12:48.88,0:12:50.55,JPDB,,0000,0000,0000,,Исшики-кун да кете ме?
Dialogue: 0,0:12:52.79,0:12:55.57,JPDB,,0000,0000,0000,,Біраз уақытқа. Біраз уақытқа.
Dialogue: 0,0:12:56.99,0:13:00.22,JPDB,,0000,0000,0000,,Әй? серуендеу? Барғың келсе, бару керек.
Dialogue: 0,0:13:00.71,0:13:01.29,JPDB,,0000,0000,0000,,Оны кесіп алайық
Dialogue: 0,0:13:01.53,0:13:03.42,JPDB,,0000,0000,0000,,Бұл дөрекі жауап қандай?
Dialogue: 0,0:13:03.75,0:13:07.18,JPDB,,0000,0000,0000,,Егер менің қызым болса, мен достарыма көңіл бөлемін бе?
Dialogue: 0,0:13:07.57,0:13:09.34,JPDB,,0000,0000,0000,,Қашан қыз таптыңыз?
Dialogue: 0,0:13:09.51,0:13:14.01,JPDB,,0000,0000,0000,,Кіру салтанатында сөйлеуге мүмкіндік бергені үшін қаншалықты риза болғанымды ұмытып кеттім.
Dialogue: 0,0:13:17.27,0:13:18.91,JPDB,,0000,0000,0000,,О, жаман, мен оны кесіп аламын.
Dialogue: 0,0:13:18.91,0:13:19.73,JPDB,,0000,0000,0000,,Маюри үшін сол сәт келгенде қасында болғым келеді… яғни…
Dialogue: 0,0:13:22.36,0:13:23.63,JPDB,,0000,0000,0000,,Оны рұқсатсыз ашпаңыз
Dialogue: 0,0:13:26.98,0:13:28.25,JPDB,,0000,0000,0000,,Юта Бұл не?
Dialogue: 0,0:13:28.63,0:13:30.96,JPDB,,0000,0000,0000,,Әй? Мен білмеймін
Dialogue: 0,0:13:37.22,0:13:38.24,JPDB,,0000,0000,0000,,Жарайды, оны тастаңыз.
Dialogue: 0,0:13:38.87,0:13:41.80,JPDB,,0000,0000,0000,,Тіпті осы зұлым патша Шинген айта алмайтын түпкілікті механизм
Dialogue: 0,0:13:42.05,0:13:42.77,JPDB,,0000,0000,0000,,Жоқ
Dialogue: 0,0:13:43.96,0:13:45.70,JPDB,,0000,0000,0000,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:13:46.20,0:13:49.40,JPDB,,0000,0000,0000,,Бұл жерде осылай тіркеледі
Dialogue: 0,0:13:51.07,0:13:54.47,JPDB,,0000,0000,0000,,Ал мен қолымды бұлғасам, бұл керемет
Dialogue: 0,0:13:55.69,0:13:58.35,JPDB,,0000,0000,0000,,Таңғажайып таңғажайып Юта
Dialogue: 0,0:13:59.10,0:14:00.21,JPDB,,0000,0000,0000,,Көз жасын төкпе
Dialogue: 0,0:14:00.71,0:14:04.84,JPDB,,0000,0000,0000,,Джау Шинген Ютаға өзінің барлық құрметін көрсетеді.
Dialogue: 0,0:14:05.09,0:14:06.84,JPDB,,0000,0000,0000,,Маған бұл керек емес.
Dialogue: 0,0:14:10.90,0:14:12.42,JPDB,,0000,0000,0000,,Жегіңіз келетін нәрсе бар ма?
Dialogue: 0,0:14:13.34,0:14:18.36,JPDB,,0000,0000,0000,,Дегенмен, менде жақсы ингредиенттер қалмады, сондықтан ол Тоқа-сан сияқты болмайды.
Dialogue: 0,0:14:19.73,0:14:23.43,JPDB,,0000,0000,0000,,Мен соңғы бастықпен оны жегеннен гөрі жалаң қолыммен күрескенді жақсы көремін.
Dialogue: 0,0:14:23.95,0:14:28.13,JPDB,,0000,0000,0000,,Сіз мұқиятсыз. Жақсы, мен дүкенге барамын деп ойлаймын. Қазірдің өзінде кеш.
Dialogue: 0,0:14:28.67,0:14:32.58,JPDB,,0000,0000,0000,,Ықтимал дүкен? Мүмкін дүкеннен алынған тағам шығар?
Dialogue: 0,0:14:33.20,0:14:34.51,JPDB,,0000,0000,0000,,Сіз нені жек көресіз?
Dialogue: 0,0:14:34.59,0:14:37.40,JPDB,,0000,0000,0000,,Жоқ, бұған діни қызметкер тыйым салған.
Dialogue: 0,0:14:37.77,0:14:39.29,JPDB,,0000,0000,0000,,Өз тағамыңызды жеңіз
Dialogue: 0,0:14:39.83,0:14:42.37,JPDB,,0000,0000,0000,,Жоқ, бұл алғыс айту керек нәрсе.
Dialogue: 0,0:14:42.91,0:14:44.06,JPDB,,0000,0000,0000,,Сондықтан мен оны жегім келеді
Dialogue: 0,0:14:46.44,0:14:47.91,JPDB,,0000,0000,0000,,Сізге көп рахмет
Dialogue: 0,0:14:55.27,0:14:57.01,JPDB,,0000,0000,0000,,Бұл шынымен жақсы ма?
Dialogue: 0,0:14:57.85,0:15:02.00,JPDB,,0000,0000,0000,,Мен Ютаның құрылымына оның мектепте оны жеп жатқанын көргеннен бері қызық болдым.
Dialogue: 0,0:15:02.50,0:15:05.76,JPDB,,0000,0000,0000,,Осы жерден тазартып, эпидермисті бөліңіз
Dialogue: 0,0:15:06.48,0:15:08.07,JPDB,,0000,0000,0000,,Екі жағынан ұстап, тартыңыз.
Dialogue: 0,0:15:09.61,0:15:10.45,JPDB,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:15:11.00,0:15:11.89,JPDB,,0000,0000,0000,,Бұл керемет пе?
Dialogue: 0,0:15:18.63,0:15:19.30,JPDB,,0000,0000,0000,,Дәмді
Dialogue: 0,0:15:20.27,0:15:22.28,JPDB,,0000,0000,0000,,Менің ойымша, Тука мұны көрсе ашуланады.
Dialogue: 0,0:15:23.23,0:15:25.04,JPDB,,0000,0000,0000,,Қараңызшы, бізде қуырылған тауық еті де бар.
Dialogue: 0,0:15:29.76,0:15:30.68,JPDB,,0000,0000,0000,,Тәтті дәм
Dialogue: 0,0:15:30.98,0:15:31.80,JPDB,,0000,0000,0000,,Оның дәмі қандай?
Dialogue: 0,0:15:33.02,0:15:34.24,JPDB,,0000,0000,0000,,Ютаның күріш шарлары туралы не деуге болады?
Dialogue: 0,0:15:35.01,0:15:36.90,JPDB,,0000,0000,0000,,Тамақтанғыңыз келе ме?
Dialogue: 0,0:15:40.90,0:15:41.62,JPDB,,0000,0000,0000,,Бұл ауырды ма?
Dialogue: 0,0:15:41.92,0:15:42.79,JPDB,,0000,0000,0000,,Юта
Dialogue: 0,0:15:43.29,0:15:46.27,JPDB,,0000,0000,0000,,​​Нашар жаман, мен мұны кешірім сұрау үшін істеймін.
Dialogue: 0,0:15:48.38,0:15:49.30,JPDB,,0000,0000,0000,,Қызыл түс қауіпті
Dialogue: 0,0:15:49.82,0:15:51.41,JPDB,,0000,0000,0000,,Бұл шынымен де проблема емес пе?
Dialogue: 0,0:15:54.07,0:15:55.26,JPDB,,0000,0000,0000,,Жабдықтау аяқталды
Dialogue: 0,0:15:56.01,0:15:57.48,JPDB,,0000,0000,0000,,Жарайды, онда үйге қайтайық.
Dialogue: 0,0:16:18.63,0:16:19.12,JPDB,,0000,0000,0000,,Юта
Dialogue: 0,0:16:21.21,0:16:22.28,JPDB,,0000,0000,0000,,Шынымен бе!? Иә
Dialogue: 0,0:16:22.83,0:16:23.28,JPDB,,0000,0000,0000,,Иә?
Dialogue: 0,0:16:23.77,0:16:25.51,JPDB,,0000,0000,0000,,Ай нұрында рахаттану
Dialogue: 0,0:16:25.89,0:16:27.10,JPDB,,0000,0000,0000,,Келісімді пайдаланбай-ақ мені одақтасың қыла аласың деп ойладың ғой?
Dialogue: 0,0:16:37.24,0:16:40.33,JPDB,,0000,0000,0000,,Сіз қалай ойлайсыз? Түн болды, екеуміз ғана.
Dialogue: 0,0:16:40.70,0:16:45.25,JPDB,,0000,0000,0000,,Менің ойымша, бұл сахнаның орнатылғанын білдіреді, сондықтан сіз өз сезімдеріңізді мойындауыңыз керек.
Dialogue: 0,0:16:45.59,0:16:47.06,JPDB,,0000,0000,0000,,Жүр, мен білемін.
Dialogue: 0,0:16:47.06,0:16:49.17,JPDB,,0000,0000,0000,,Бұл не? Бұл жүрексіз.
Dialogue: 0,0:16:49.40,0:16:53.05,JPDB,,0000,0000,0000,,Кіру салтанатында сізді шақырған мейірімділікті ұмыттыңыз ба?
Dialogue: 0,0:16:53.05,0:16:55.16,JPDB,,0000,0000,0000,,Бұл туралы тағы да сөйлесейік.
Dialogue: 0,0:16:55.51,0:16:57.16,JPDB,,0000,0000,0000,,Аа, күте тұрыңыз.
Dialogue: 0,0:16:57.43,0:16:58.07,JPDB,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:16:59.19,0:17:01.25,JPDB,,0000,0000,0000,,Которию-сан ше?
Dialogue: 0,0:17:02.02,0:17:03.29,JPDB,,0000,0000,0000,,Мен күріш жедім.
Dialogue: 0,0:17:04.48,0:17:06.10,JPDB,,0000,0000,0000,,Ол үй кілтін ұмытып қалды.
Dialogue: 0,0:17:06.47,0:17:08.93,JPDB,,0000,0000,0000,,Иә, бұл екеуміз ғана шығармыз?
Dialogue: 0,0:17:09.23,0:17:09.70,JPDB,,0000,0000,0000,,Жақсы
Dialogue: 0,0:17:10.50,0:17:13.85,JPDB,,0000,0000,0000,,Мен бұл күдікті деп ойладым, бірақ ол соншалықты жаман емес еді.
Dialogue: 0,0:17:14.30,0:17:17.68,JPDB,,0000,0000,0000,,Сіз нені түсінбедіңіз? Бұлай болуы мүмкін емес.
Dialogue: 0,0:17:18.05,0:17:18.63,JPDB,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:17:19.42,0:17:23.02,JPDB,,0000,0000,0000,,Өйткені, бұл Рикка. Чуунибионың күші бар.
Dialogue: 0,0:17:23.42,0:17:24.79,JPDB,,0000,0000,0000,,Бірақ ол орта мектеп оқушысы.
Dialogue: 0,0:17:25.24,0:17:26.48,JPDB,,0000,0000,0000,,Жоқ, бірақ
Dialogue: 0,0:17:26.83,0:17:27.40,JPDB,,0000,0000,0000,,Юта
Dialogue: 0,0:17:29.79,0:17:30.18,JPDB,,0000,0000,0000,,Бірақ...
Dialogue: 0,0:17:30.78,0:17:32.49,JPDB,,0000,0000,0000,,Сәлем, сәлем
Dialogue: 0,0:17:33.54,0:17:34.26,JPDB,,0000,0000,0000,,Таку
Dialogue: 0,0:17:47.36,0:17:48.10,JPDB,,0000,0000,0000,,Рикка және...
Dialogue: 0,0:17:50.22,0:17:52.08,JPDB,,0000,0000,0000,,Жоқ, жоқ, жоқ, жоқ, жоқ
Dialogue: 0,0:17:52.85,0:17:56.98,JPDB,,0000,0000,0000,,Мен орта мектептің екінші курс оқушысы Риккада махаббат идеясы бар ма деп ойлаймын...
Dialogue: 0,0:17:58.24,0:18:02.10,JPDB,,0000,0000,0000,,Юта: Бұл... "Mjolnir Hammer" ма?
Dialogue: 0,0:18:03.74,0:18:04.48,JPDB,,0000,0000,0000,,Кеше болған жайтқа әлі де алаңдайсың ба?
Dialogue: 0,0:18:05.03,0:18:06.30,JPDB,,0000,0000,0000,,Оны тоқтатыңыз, себебі ол созылады.
Dialogue: 0,0:18:06.72,0:18:08.02,JPDB,,0000,0000,0000,,Жеңдеріңді қайырып алсаң, жарайсың.
Dialogue: 0,0:18:15.34,0:18:17.36,JPDB,,0000,0000,0000,,Мен бұл туралы үнемі ойлай аламын.
Dialogue: 0,0:18:17.85,0:18:19.05,JPDB,,0000,0000,0000,,Міне, қазірдің өзінде кеш болды.
Dialogue: 0,0:18:19.69,0:18:21.87,JPDB,,0000,0000,0000,,Бұл бөлмеде ұйықтап, тістеріңізді тазалай аласыз...
Dialogue: 0,0:18:24.71,0:18:26.23,JPDB,,0000,0000,0000,,Иісі Ютаға ұқсайды
Dialogue: 0,0:18:28.04,0:18:28.37,JPDB,,0000,0000,0000,,Тоқта
Dialogue: 0,0:18:28.91,0:18:29.66,JPDB,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:18:31.75,0:18:33.24,JPDB,,0000,0000,0000,,Иісі Ютаға ұқсайды
Dialogue: 0,0:18:35.00,0:18:37.24,JPDB,,0000,0000,0000,,Жоқ, бұл ұят нәрсе.
Dialogue: 0,0:18:39.58,0:18:40.45,JPDB,,0000,0000,0000,,Жарайды, оны жойайық.
Dialogue: 0,0:18:41.32,0:18:44.72,JPDB,,0000,0000,0000,,Түнде, Джау Шинган іске қосылғанда, ол қазірдің өзінде...
Dialogue: 0,0:18:44.72,0:18:45.59,JPDB,,0000,0000,0000,,Жарайды, ұйықта.
Dialogue: 0,0:18:47.55,0:18:49.87,JPDB,,0000,0000,0000,,Менің иісім қандай?
Dialogue: 0,0:19:05.85,0:19:07.19,JPDB,,0000,0000,0000,,Мен саған ұйықта деп айттым.
Dialogue: 0,0:19:07.66,0:19:08.85,JPDB,,0000,0000,0000,,Мен уайымдаймын
Dialogue: 0,0:19:09.50,0:19:12.76,JPDB,,0000,0000,0000,,Жақын жерде келе жатқан шығар. Сақ болыңыз.
Dialogue: 0,0:19:13.55,0:19:14.15,JPDB,,0000,0000,0000,,Сіз білесіз бе?
Dialogue: 0,0:19:20.98,0:19:21.31,JPDB,,0000,0000,0000,,Мен оны өшіремін.
Dialogue: 0,0:19:21.98,0:19:23.12,JPDB,,0000,0000,0000,,Мен уайымдаймын
Dialogue: 0,0:19:23.64,0:19:24.59,JPDB,,0000,0000,0000,,Ұйқы сені емдейді.
Dialogue: 0,0:19:25.46,0:19:26.35,JPDB,,0000,0000,0000,,Соққы
Dialogue: 0,0:19:26.58,0:19:27.25,JPDB,,0000,0000,0000,,"Олар әңгімелесіп жатыр!"
Dialogue: 0,0:19:27.92,0:19:28.76,JPDB,,0000,0000,0000,,Қызықты
Dialogue: 0,0:19:29.01,0:19:30.38,JPDB,,0000,0000,0000,,Тақырыптық саябақ жарнамасы ма?
Dialogue: 0,0:19:31.02,0:19:31.87,JPDB,,0000,0000,0000,,Мен… міне, ол. Бұл Рохан.
Dialogue: 0,0:19:32.07,0:19:32.84,JPDB,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:19:33.34,0:19:34.30,JPDB,,0000,0000,0000,,Менің жеңуімнің себебі…
Dialogue: 0,0:19:38.53,0:19:39.45,JPDB,,0000,0000,0000,,Жарайды, ұйықта.
Dialogue: 0,0:19:41.96,0:19:42.63,JPDB,,0000,0000,0000,,Ол мойнын қорғап қалды
Dialogue: 0,0:19:44.42,0:19:45.17,JPDB,,0000,0000,0000,,Сіз білесіз бе?
Dialogue: 0,0:19:47.13,0:19:48.22,JPDB,,0000,0000,0000,,Амон, ол жігіт қауіпті.
Dialogue: 0,0:19:49.29,0:19:51.18,JPDB,,0000,0000,0000,,Е, бұл өтірік.
Dialogue: 0,0:19:51.85,0:19:54.16,JPDB,,0000,0000,0000,,Юта көзіңді жұм
Dialogue: 0,0:19:54.54,0:19:55.03,JPDB,,0000,0000,0000,,Иә?
Dialogue: 0,0:19:55.41,0:19:58.86,JPDB,,0000,0000,0000,,Аз ғана, аз ғана жеткілікті
Dialogue: 0,0:20:00.53,0:20:05.10,JPDB,,0000,0000,0000,,Бұл өтірік болса керек. Бұл жігіт шынымен
Dialogue: 0,0:20:07.34,0:20:10.17,JPDB,,0000,0000,0000,,Жарайды ма?
Dialogue: 0,0:20:11.74,0:20:14.25,JPDB,,0000,0000,0000,,Жоқ, күтіңіз, жоқ, бірақ
Dialogue: 0,0:20:28.26,0:20:29.21,JPDB,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:20:29.93,0:20:34.82,JPDB,,0000,0000,0000,,Абсолютті сиқырдың фрагменті. Біз жаңа ғана жасаған жаңа келісімшарттың дәлелі.
Dialogue: 0,0:20:36.96,0:20:38.95,JPDB,,0000,0000,0000,,Оны азырақ көрінетін жерге қойыңыз.
Dialogue: 0,0:20:39.60,0:20:43.65,JPDB,,0000,0000,0000,,Бұл қараңғылықтың күшін екі есе арттыратын ең жақсы жер.
Dialogue: 0,0:20:44.05,0:20:47.50,JPDB,,0000,0000,0000,,Dark Flame-ден күштірек Dark Buster шығара алады.
Dialogue: 0,0:20:53.19,0:20:53.74,JPDB,,0000,0000,0000,,Мен ұйықтайын деп жатырмын
Dialogue: 0,0:20:58.91,0:21:02.02,JPDB,,0000,0000,0000,,Chuunibyou әлі Chuunibyou ме?
Dialogue: 0,0:21:03.13,0:21:05.77,JPDB,,0000,0000,0000,,Менің ойымша, бұл жақсы ...
Dialogue: 0,0:21:09.45,0:21:10.52,JPDB,,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:21:17.00,0:21:20.03,JPDB,,0000,0000,0000,,Бұл дірілдеген қатысу
Dialogue: 0,0:21:28.86,0:21:29.40,JPDB,,0000,0000,0000,,Аристократтар академиясына сұхбат
Dialogue: 0,0:22:08.62,0:22:09.30,JPDB,,0000,0000,0000,,Юта
Dialogue: 0,0:02:40.53,0:02:44.50,JPOP,,0000,0000,0000,karaoke,Бір-біріне қарап біраз тұрған соң
Dialogue: 0,0:02:44.73,0:02:51.29,JPOP,,0000,0000,0000,karaoke,Сіз оны бұрмастан бұрын не ойладыңыз деп ойлаймын.
Dialogue: 0,0:02:51.51,0:02:55.54,JPOP,,0000,0000,0000,karaoke,Маған қарашы еріндері
Dialogue: 0,0:02:55.76,0:03:01.08,JPOP,,0000,0000,0000,karaoke,Менен не болды деп сұрағанша күтемін.
Dialogue: 0,0:03:01.43,0:03:06.78,JPOP,,0000,0000,0000,karaoke,Алдағаннан кейін өзіңізге не айтасыз?
Dialogue: 0,0:03:07.27,0:03:12.69,JPOP,,0000,0000,0000,karaoke,Бұл ұят, сондықтан сұрамаңыз.
Dialogue: 0,0:03:13.39,0:03:18.23,JPOP,,0000,0000,0000,karaoke,Бір-біріне қарсылықсыз тартылатын махаббат
Dialogue: 0,0:03:18.58,0:03:23.05,JPOP,,0000,0000,0000,karaoke,Ол әлдеқашан басталған болатын
Dialogue: 0,0:03:24.07,0:03:26.43,JPOP,,0000,0000,0000,karaoke,Мен көп армандадым
Dialogue: 0,0:03:26.46,0:03:30.34,JPOP,,0000,0000,0000,karaoke,Оянсам да, сені көргім келеді.
Dialogue: 0,0:03:30.34,0:03:32.55,JPOP,,0000,0000,0000,karaoke,Сіз мұны жасадыңыз
Dialogue: 0,0:03:32.55,0:03:34.96,JPOP,,0000,0000,0000,karaoke,Махаббат сараңдық, солай емес пе?
Dialogue: 0,0:03:34.96,0:03:40.53,JPOP,,0000,0000,0000,karaoke,Бізді секіртетін жүрекке ерейік
Dialogue: 0,0:03:40.53,0:03:43.14,JPOP,,0000,0000,0000,karaoke,Идеалдар, адасушылықтар және шындық
Dialogue: 0,0:03:43.26,0:03:45.77,JPOP,,0000,0000,0000,karaoke,Барлығы сіздің айналаңызда айналады
Dialogue: 0,0:03:46.00,0:03:51.12,JPOP,,0000,0000,0000,karaoke,Жаңа әлемге
Dialogue: 0,0:02:40.53,0:02:44.50,ZWOP,,0000,0000,0000,karaoke,Сіз екі көзбен осы сәттесіз
Dialogue: 0,0:02:44.75,0:02:51.29,ZWOP,,0000,0000,0000,karaoke,Қозғалмас бұрын, сіз қаланың қай жерде екеніңізді көре аласыз.
Dialogue: 0,0:02:51.51,0:02:55.54,ZWOP,,0000,0000,0000,karaoke,Менің тұмсығыма қара
Dialogue: 0,0:02:55.76,0:03:01.08,ZWOP,,0000,0000,0000,karaoke,Жиналыстың сұрағы `` Мен мұны істегім келеді '' Сондай-ақ, үндемеңіз.
Dialogue: 0,0:03:01.43,0:03:06.78,ZWOP,,0000,0000,0000,karaoke,Моңғолияның өз бетімен сөйлесуі
Dialogue: 0,0:03:07.27,0:03:12.69,ZWOP,,0000,0000,0000,karaoke,Әңгімені қайта оқудың қажеті жоқ.
Dialogue: 0,0:03:13.39,0:03:18.23,ZWOP,,0000,0000,0000,karaoke,Өзара тартымдылық махаббат
Dialogue: 0,0:03:18.58,0:03:23.05,ZWOP,,0000,0000,0000,karaoke,Жаңа ғана басталды
Dialogue: 0,0:03:24.07,0:03:26.43,ZWOP,,0000,0000,0000,karaoke,Шектеусіз әдемі армандар
Dialogue: 0,0:03:26.46,0:03:30.34,ZWOP,,0000,0000,0000,karaoke,Бұл түстен оянғаннан кейін де оны көру керек.
Dialogue: 0,0:03:30.34,0:03:32.55,ZWOP,,0000,0000,0000,karaoke,Капитал зиянды
Dialogue: 0,0:03:32.55,0:03:34.96,ZWOP,,0000,0000,0000,karaoke,Махаббат - махаббаттың шынайы табиғаты.
Dialogue: 0,0:03:34.96,0:03:40.53,ZWOP,,0000,0000,0000,karaoke,Будда мен баланың ішкі ойлары секіріп кетеді.
Dialogue: 0,0:03:40.53,0:03:43.14,ZWOP,,0000,0000,0000,karaoke,Күмән жоқ - идеал, адасушылық - шындық
Dialogue: 0,0:03:43.26,0:03:45.77,ZWOP,,0000,0000,0000,karaoke,Барлық астаналар сіздің кезегіңізге келді.
Dialogue: 0,0:03:46.00,0:03:51.12,ZWOP,,0000,0000,0000,karaoke,Дүниедегі жаңа келу
