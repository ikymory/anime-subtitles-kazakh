Dialogue: 0,0:22:16.78,0:22:19.29,JPED,,0000,0000,0000,,INSIDE Identity
Dialogue: 0,0:22:19.29,0:22:21.06,JPED,,0000,0000,0000,,Сіздің орныңыз қай жерде?
Dialogue: 0,0:22:32.19,0:22:34.70,JPED,,0000,0000,0000,,Түсініспеушілік ұят па?
Dialogue: 0,0:22:34.70,0:22:37.03,JPED,,0000,0000,0000,,Адалдық зиян келтіреді.
Dialogue: 0,0:22:37.36,0:22:39.92,JPED,,0000,0000,0000,,Кім не айтса да
Dialogue: 0,0:22:39.92,0:22:42.35,JPED,,0000,0000,0000,,Мен ненің дұрыс екенін білмеймін
Dialogue: 0,0:22:42.55,0:22:45.16,JPED,,0000,0000,0000,,Әдеттегідей ағып жатқан күнделікті өмірде
Dialogue: 0,0:22:45.28,0:22:47.62,JPED,,0000,0000,0000,,Мен өзімді соған үйренуге мәжбүр еттім.
Dialogue: 0,0:22:47.62,0:22:50.25,JPED,,0000,0000,0000,,Суға батқан тұлға және қан
Dialogue: 0,0:22:50.45,0:22:52.67,JPED,,0000,0000,0000,,Шайнаңыз, ішіңіз, түкіріңіз және сындырыңыз
Dialogue: 0,0:22:52.67,0:22:57.09,JPED,,0000,0000,0000,,Мені осылай түсінгеніңізді қалаймын
Dialogue: 0,0:22:57.36,0:23:02.66,JPED,,0000,0000,0000,,Мен бірдеңе айтқым келеді, бірақ айта алмаймын.
Dialogue: 0,0:23:02.66,0:23:07.45,JPED,,0000,0000,0000,,Неге ешкім түсінбейді?
Dialogue: 0,0:23:07.68,0:23:12.62,JPED,,0000,0000,0000,,Ойлану сән-салтанат па? Солай ма?
Dialogue: 0,0:23:12.62,0:23:17.79,JPED,,0000,0000,0000,,Эмоциялық күн - бұл
Dialogue: 0,0:23:18.04,0:23:20.73,JPED,,0000,0000,0000,,Тым көп қызу
Dialogue: 0,0:23:20.73,0:23:23.01,JPED,,0000,0000,0000,,Менің ойымша, бұл қандай да бір жолмен жүзеге асады
Dialogue: 0,0:23:23.16,0:23:28.08,JPED,,0000,0000,0000,,Айқайлағым келеді
Dialogue: 0,0:23:28.08,0:23:34.00,JPED,,0000,0000,0000,,ТҮСІКТІЛІКТІ іздеп жатыр
Dialogue: 0,0:23:34.27,0:23:36.76,JPED,,0000,0000,0000,,INSIDE Identity
Dialogue: 0,0:23:36.76,0:23:39.29,JPED,,0000,0000,0000,,МЕНІҢ ӘДІЛЕТІМНІҢ ІШІНДЕ
Dialogue: 0,0:23:39.29,0:23:41.85,JPED,,0000,0000,0000,,Маған кедергі жасама
Dialogue: 0,0:23:41.85,0:23:43.85,JPED,,0000,0000,0000,,Сіздің орныңыз қай жерде?
Dialogue: 0,0:22:16.78,0:22:19.29,ZWED,,0000,0000,0000,,INSIDE Identity
Dialogue: 0,0:22:19.29,0:22:21.06,ZWED,,0000,0000,0000,,Қараған жерің – өмір сүретін жерің.
Dialogue: 0,0:22:32.19,0:22:34.70,ZWED,,0000,0000,0000,,Мен аудиториядан алған әсерге ұяламын.
Dialogue: 0,0:22:34.70,0:22:37.03,ZWED,,0000,0000,0000,,Жұртшылықтың алған әсерлеріне шынайы шолу
Dialogue: 0,0:22:37.36,0:22:39.92,ZWED,,0000,0000,0000,,Бұған күмән жоқ
Dialogue: 0,0:22:39.92,0:22:42.35,ZWED,,0000,0000,0000,,Белгісіз байлығымды түзететініме сенімдімін.
Dialogue: 0,0:22:42.55,0:22:45.16,ZWED,,0000,0000,0000,,Өзін-өзі анықтауды зерттеу
Dialogue: 0,0:22:45.28,0:22:47.62,ZWED,,0000,0000,0000,,Ичитоу Фуканнан келген Хико
Dialogue: 0,0:22:47.62,0:22:50.25,ZWED,,0000,0000,0000,,Шогунның толық эго және қан
Dialogue: 0,0:22:50.45,0:22:52.67,ZWED,,0000,0000,0000,,Шайнау, жұту, түкіру, ойнау
Dialogue: 0,0:22:52.67,0:22:57.09,ZWED,,0000,0000,0000,,Сіз мұны түсінесіз деп үміттенемін.
Dialogue: 0,0:22:57.36,0:23:02.66,ZWED,,0000,0000,0000,,Күтпеген ойлар ашылуы мүмкін.
Dialogue: 0,0:23:02.66,0:23:07.45,ZWED,,0000,0000,0000,,Мен адам қалмағанын түсінемін.
Dialogue: 0,0:23:07.68,0:23:12.62,ZWED,,0000,0000,0000,,Егер сізді түсінгіңіз келсе, солай етіңіз.
Dialogue: 0,0:23:12.62,0:23:17.79,ZWED,,0000,0000,0000,,Бұл жақсы сезінетін күн
Dialogue: 0,0:23:18.04,0:23:20.73,ZWED,,0000,0000,0000,,Радиациялық жылу сыйымдылығы
Dialogue: 0,0:23:20.73,0:23:23.01,ZWED,,0000,0000,0000,,Өзін ләззатқа ұшырататын теріс қылықтар
Dialogue: 0,0:23:23.16,0:23:28.08,ZWED,,0000,0000,0000,,Заңсыз шектеу кенеттен шабуыл жасауға шақырады
Dialogue: 0,0:23:28.08,0:23:34.00,ZWED,,0000,0000,0000,,ТҰРҒЫНДАР
Dialogue: 0,0:23:34.27,0:23:36.76,ZWED,,0000,0000,0000,,INSIDE Identity
Dialogue: 0,0:23:36.76,0:23:39.29,ZWED,,0000,0000,0000,,МЕНІҢ ӘДІЛЕТІМНІҢ ІШІНДЕ
Dialogue: 0,0:23:39.29,0:23:41.85,ZWED,,0000,0000,0000,,Қажетсіз кедергі
Dialogue: 0,0:23:41.85,0:23:43.85,ZWED,,0000,0000,0000,,Қараған жерің – өмір сүретін жерің.
Dialogue: 0,0:03:55.96,0:04:05.93,ZZ信息,,0000,0000,0000,,Бұл субтитрлер сериясы субтитрлер жиынтығы ретінде көрсетіледі және айырбастауға көбірек қытай, жапон және қытай субтитрлері қолжетімді. www.kamigami.org
Dialogue: 0,0:03:55.96,0:04:05.93,ZZ信息,,0000,0000,0000,,...
Dialogue: 0,0:05:27.09,0:05:33.10,ZWBT,,0000,0000,0000,,Екі адамның қашу сапары
Dialogue: 0,0:00:06.26,0:00:11.38,ZWDB,,0000,0000,0000,,Жарылғыш соңғы шындық, қаһарлы соңғы құдайлық байланыс
Dialogue: 0,0:00:14.48,0:00:18.41,ZWDB,,0000,0000,0000,,Бұл дүниенің жойылуы
Dialogue: 0,0:00:37.03,0:00:39.04,ZWDB,,0000,0000,0000,,Агарайу ұнтағы
Dialogue: 0,0:00:39.74,0:00:42.00,ZWDB,,0000,0000,0000,,Жағдайлардың барлық түрін ойлаған кезде
Dialogue: 0,0:00:49.88,0:00:50.65,ZWDB,,0000,0000,0000,,Барлау
Dialogue: 0,0:00:53.51,0:00:57.51,ZWDB,,0000,0000,0000,,Бұл тривиальды сексуалдық әңгіме болып табылатын бастауыш мектептегі жалпы әңгіменің бейнесі.
Dialogue: 0,0:01:00.14,0:01:01.71,ZWDB,,0000,0000,0000,,Кантикула
Dialogue: 0,0:01:14.83,0:01:16.12,ZWDB,,0000,0000,0000,,Сіз мұнда өшпенділікпен келдіңіз.
Dialogue: 0,0:01:17.54,0:01:18.24,ZWDB,,0000,0000,0000,,Фуку
Dialogue: 0,0:01:19.01,0:01:21.42,ZWDB,,0000,0000,0000,,Бұл туралы не ойлайтыныңызды айтайық.
Dialogue: 0,0:01:24.40,0:01:25.00,ZWDB,,0000,0000,0000,,Фуку
Dialogue: 0,0:01:25.57,0:01:28.03,ZWDB,,0000,0000,0000,,Бұл не анық?
Dialogue: 0,0:01:28.18,0:01:29.47,ZWDB,,0000,0000,0000,,Мен не істерімді білмеймін.
Dialogue: 0,0:01:31.73,0:01:34.99,ZWDB,,0000,0000,0000,,Мен сенің талантты және қабілетсіз болғаныңды қалаймын.
Dialogue: 0,0:01:35.91,0:01:36.73,ZWDB,,0000,0000,0000,,Жаман көз
Dialogue: 0,0:01:37.50,0:01:37.99,ZWDB,,0000,0000,0000,,Шабдалы жұмыртқасы
Dialogue: 0,0:01:55.77,0:01:56.29,ZWDB,,0000,0000,0000,,Не істеп жатырсыңдар өзің? Бір сәттен бері құлақ тұндырардай шу болып тұр
Dialogue: 0,0:01:58.90,0:02:03.15,ZWDB,,0000,0000,0000,,Міндетті емес Міндетті емес Міндетті емес
Dialogue: 0,0:02:07.99,0:02:11.72,ZWDB,,0000,0000,0000,,Әкем екеуміз бұдан былай үйде болдық.
Dialogue: 0,0:02:12.72,0:02:14.26,ZWDB,,0000,0000,0000,,Көрінбейтін шекаралық сызықтар…
Dialogue: 0,0:02:14.48,0:02:15.03,ZWDB,,0000,0000,0000,,Бар болу
Dialogue: 0,0:02:17.17,0:02:19.43,ZWDB,,0000,0000,0000,,Көрінбейтін шекаралар экзистенциалды
Dialogue: 0,0:02:23.88,0:02:24.62,ZWDB,,0000,0000,0000,,Марио Зкро
Dialogue: 0,0:04:10.13,0:04:13.06,ZWDB,,0000,0000,0000,,Мен бұл әңгімедегі он гүлді көремін.
Dialogue: 0,0:04:14.23,0:04:14.70,ZWDB,,0000,0000,0000,,Юта…
Dialogue: 0,0:04:15.64,0:04:18.13,ZWDB,,0000,0000,0000,,Дегенмен, мен оның себебі анық шындық деп есептеймін.
Dialogue: 0,0:04:19.42,0:04:22.26,ZWDB,,0000,0000,0000,,Дұрыс себеп алты гүлдің талантты болуына байланысты екені анық.
Dialogue: 0,0:04:24.52,0:04:27.75,ZWDB,,0000,0000,0000,,Нақты іске асыру қабылдануы тиіс болғандықтан
Dialogue: 0,0:04:28.44,0:04:30.04,ZWDB,,0000,0000,0000,,Дереу елшіге жіберілді Рұқсатсыз қабылдауға қатысты қазіргі жағдай өте үлкен.
Dialogue: 0,0:04:32.69,0:04:36.03,ZWDB,,0000,0000,0000,,Дегенмен, жағдай тұрақты және эмоционалды уақыт босқа кетеді.
Dialogue: 0,0:04:36.42,0:04:37.94,ZWDB,,0000,0000,0000,,Барлық жұмыс аяқталды
Dialogue: 0,0:04:41.15,0:04:44.13,ZWDB,,0000,0000,0000,,Қашып құтылу мүмкін емес.
Dialogue: 0,0:04:44.97,0:04:48.01,ZWDB,,0000,0000,0000,,Дегенмен, себеп табиғи, ал қорытынды себеп – себеп табиғи.
Dialogue: 0,0:04:48.01,0:04:49.55,ZWDB,,0000,0000,0000,,Макото Наганың жақсы сөздері
Dialogue: 0,0:04:53.52,0:04:58.67,ZWDB,,0000,0000,0000,,Дегенмен, үй иесінің басқаруы заңды.
Dialogue: 0,0:04:59.56,0:05:01.05,ZWDB,,0000,0000,0000,,Мен өз жұмысыма ризамын.
Dialogue: 0,0:05:02.72,0:05:06.35,ZWDB,,0000,0000,0000,,Насу – шындық; Дайя астанасы - Насудың өмір салты.
Dialogue: 0,0:05:07.22,0:05:08.81,ZWDB,,0000,0000,0000,,Нанаку ұзақ өмір сүретін ересек адам
Dialogue: 0,0:05:10.15,0:05:13.36,ZWDB,,0000,0000,0000,,Бұл мүмкін, бірақ бұл Рокка…
Dialogue: 0,0:05:15.64,0:05:16.26,ZWDB,,0000,0000,0000,,Рикка
Dialogue: 0,0:05:18.25,0:05:19.00,ZWDB,,0000,0000,0000,,Рикка
Dialogue: 0,0:05:40.47,0:05:41.17,ZWDB,,0000,0000,0000,,Рикка
Dialogue: 0,0:05:47.26,0:05:49.20,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:05:49.52,0:05:50.61,ZWDB,,0000,0000,0000,,…
Dialogue: 0,0:05:51.13,0:05:55.78,ZWDB,,0000,0000,0000,,Таксиді қайтару аяқталды.
Dialogue: 0,0:05:56.08,0:05:59.68,ZWDB,,0000,0000,0000,,Шебер қайтып келгенге дейін
Dialogue: 0,0:05:59.83,0:06:00.78,ZWDB,,0000,0000,0000,,Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр
Dialogue: 0,0:06:06.00,0:06:09.00,ZWDB,,0000,0000,0000,,The time has come to release the black dragon.
Dialogue: 0,0:06:16.11,0:06:18.08,ZWDB,,0000,0000,0000,,etc. etc. etc.
Dialogue: 0,0:06:21.21,0:06:22.72,ZWDB,,0000,0000,0000,,You are here.
Dialogue: 0,0:06:26.78,0:06:30.43,ZWDB,,0000,0000,0000,,Келе салысымен кетесің.
Dialogue: 0,0:06:31.30,0:06:32.32,ZWDB,,0000,0000,0000,,I'm done
Dialogue: 0,0:06:35.00,0:06:36.69,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:06:41.44,0:06:43.25,ZWDB,,0000,0000,0000,,Бұл нағыз сүйікті ойыншық
Dialogue: 0,0:06:44.02,0:06:45.25,ZWDB,,0000,0000,0000,,Yes…yes!
Dialogue: 0,0:06:47.65,0:06:53.00,ZWDB,,0000,0000,0000,,Тогаши Догакува Рокука Кокоро 3
Dialogue: 0,0:06:53.37,0:06:58.71,ZWDB,,0000,0000,0000,,Two people arrived at the sea in the summer, and then left.
Dialogue: 0,0:06:58.96,0:07:02.09,ZWDB,,0000,0000,0000,,Әлемдік жауынгерлердің параллель кездесуі
Dialogue: 0,0:07:06.96,0:07:08.03,ZWDB,,0000,0000,0000,,Доғаку Тоғаши
Dialogue: 0,0:07:08.48,0:07:09.23,ZWDB,,0000,0000,0000,,Rokkaku
Dialogue: 0,0:07:10.00,0:07:11.23,ZWDB,,0000,0000,0000,,Enthusiasm
Dialogue: 0,0:07:12.13,0:07:12.83,ZWDB,,0000,0000,0000,,Қонақтар келгенде өзімізді жұп болып көрсетелік.
Dialogue: 0,0:07:15.27,0:07:16.29,ZWDB,,0000,0000,0000,,Dogaku Togashi
Dialogue: 0,0:07:17.03,0:07:18.57,ZWDB,,0000,0000,0000,,Бұл менің жастық шағым
Dialogue: 0,0:07:18.80,0:07:20.04,ZWDB,,0000,0000,0000,,Бұл мәселе ме?
Dialogue: 0,0:07:20.21,0:07:22.25,ZWDB,,0000,0000,0000,,The training center is a powerful world magic
Dialogue: 0,0:07:44.02,0:07:44.69,ZWDB,,0000,0000,0000,,Юта
Dialogue: 0,0:07:48.35,0:07:50.68,ZWDB,,0000,0000,0000,,The truth is that the difference is not achieved.
Dialogue: 0,0:07:51.53,0:07:52.22,ZWDB,,0000,0000,0000,,Where are you?
Dialogue: 0,0:07:52.97,0:07:55.75,ZWDB,,0000,0000,0000,,Na мен айту керек нәрсе.
Dialogue: 0,0:07:58.02,0:08:04.33,ZWDB,,0000,0000,0000,,The power of local management is strong, and the prison is ultimately unbreakable. Retreat is required.
Dialogue: 0,0:08:05.87,0:08:07.01,ZWDB,,0000,0000,0000,,Бұл да бірінші рет айтып тұр.
Dialogue: 0,0:08:17.63,0:08:18.20,ZWDB,,0000,0000,0000,,Юта
Dialogue: 0,0:08:19.61,0:08:19.86,ZWDB,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:20.71,0:08:25.08,ZWDB,,0000,0000,0000,,Юута қара жалын алуға қабілетті.
Dialogue: 0,0:08:25.73,0:08:27.34,ZWDB,,0000,0000,0000,,Елдің аты Шығыс пен Батыс…
Dialogue: 0,0:08:31.20,0:08:34.20,ZWDB,,0000,0000,0000,,The beginning is just a friend conversation.
Dialogue: 0,0:08:35.82,0:08:37.88,ZWDB,,0000,0000,0000,,«Пәтер иелері бастайды және кетеді»
Dialogue: 0,0:08:38.65,0:08:42.36,ZWDB,,0000,0000,0000,,However, I am excluded from the outside world.
Dialogue: 0,0:08:43.47,0:08:44.44,ZWDB,,0000,0000,0000,,Бұл басқа сезім.
Dialogue: 0,0:08:44.99,0:08:48.47,ZWDB,,0000,0000,0000,,Бұл сіз өзіңізден алыс болған кезде ғана болатын бейненің бір түрі, бірақ сіз әлемнен тыс жалғыздықты біртүрлі сезінесіз.
Dialogue: 0,0:08:51.08,0:08:54.83,ZWDB,,0000,0000,0000,,It is also a dark meaning that has occurred in other world memories.
Dialogue: 0,0:08:55.80,0:08:59.06,ZWDB,,0000,0000,0000,,Бұл туралы менің де сезімім бар, сондықтан...
Dialogue: 0,0:09:03.08,0:09:04.00,ZWDB,,0000,0000,0000,,Shinsōbōri
Dialogue: 0,0:09:04.70,0:09:06.76,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:09:07.01,0:09:10.14,ZWDB,,0000,0000,0000,,…
Dialogue: 0,0:09:10.14,0:09:10.99,ZWDB,,0000,0000,0000,,Жоғарыдағы жолды қараңыз
Dialogue: 0,0:09:27.14,0:09:31.42,ZWDB,,0000,0000,0000,,This has been completed and the contract has been further enhanced. Dark Flame Manipulator
Dialogue: 0,0:09:32.04,0:09:32.78,ZWDB,,0000,0000,0000,,Нұсқауларды орындаңыз
Dialogue: 0,0:09:33.60,0:09:35.32,ZWDB,,0000,0000,0000,,“The lacquer black is surrounded by flames…”
Dialogue: 0,0:09:35.37,0:09:36.16,ZWDB,,0000,0000,0000,,Takahashi
Dialogue: 0,0:09:48.29,0:09:49.66,ZWDB,,0000,0000,0000,,Бұл Тогаши Дугашидің қысқаша хаты.
Dialogue: 0,0:09:50.26,0:09:51.28,ZWDB,,0000,0000,0000,,Other words
Dialogue: 0,0:09:51.75,0:09:54.94,ZWDB,,0000,0000,0000,,The saying is, “The little bird is talking about the return home, so I will send it back.”
Dialogue: 0,0:09:56.27,0:09:57.91,ZWDB,,0000,0000,0000,,Бұл сіздің айтқаныңыз ба?
Dialogue: 0,0:09:58.31,0:09:59.91,ZWDB,,0000,0000,0000,,True is bold
Dialogue: 0,0:10:00.42,0:10:01.44,ZWDB,,0000,0000,0000,,Жуан?
Dialogue: 0,0:10:02.56,0:10:05.69,ZWDB,,0000,0000,0000,,If you want to write the design, you can also choose it.
Dialogue: 0,0:10:08.72,0:10:11.33,ZWDB,,0000,0000,0000,,Сенің ер адаммен өмірің бар.
Dialogue: 0,0:10:11.76,0:10:15.88,ZWDB,,0000,0000,0000,,Ариса балалар мектебінің уақыты және жаттығу тобының шағын Коичи бастапқы ойыны
Dialogue: 0,0:10:17.00,0:10:19.88,ZWDB,,0000,0000,0000,,Сәтсіздікке менің де шет елден кеткенім себеп болды.
Dialogue: 0,0:10:20.16,0:10:24.43,ZWDB,,0000,0000,0000,,Бастауыш мектеп пен кіші орта мектеп негіздері төмендейді.
Dialogue: 0,0:10:25.03,0:10:27.69,ZWDB,,0000,0000,0000,,Бұл сирек кездесетін және шынайы табиғи апат
Dialogue: 0,0:10:28.28,0:10:28.90,ZWDB,,0000,0000,0000,,Хироси…
Dialogue: 0,0:10:28.90,0:10:30.62,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:10:34.57,0:10:41.38,ZWDB,,0000,0000,0000,,Бүкіл денемнің ауыруы, дөңес және денемді қорғайтын, сондай-ақ күннің ыстығы.
Dialogue: 0,0:10:43.10,0:10:44.36,ZWDB,,0000,0000,0000,,Әрине, бөлек.
Dialogue: 0,0:10:44.84,0:10:49.73,ZWDB,,0000,0000,0000,,Мен бұл идеяны алдым.
Dialogue: 0,0:10:50.18,0:10:52.04,ZWDB,,0000,0000,0000,,Тағы бір жақсы сапалы өнім.
Dialogue: 0,0:10:52.94,0:10:55.13,ZWDB,,0000,0000,0000,,Пайдаланылмаған...пайдаланылмаған
Dialogue: 0,0:10:55.72,0:10:57.01,ZWDB,,0000,0000,0000,,Қажетсіз тұтынушыларға қызмет көрсету
Dialogue: 0,0:10:57.54,0:10:59.01,ZWDB,,0000,0000,0000,,Басқа уақытта
Dialogue: 0,0:11:04.72,0:11:09.06,ZWZJ,,0000,0000,0000,,Мен бірінші рет кеттім.
Dialogue: 0,0:11:11.65,0:11:13.34,ZWDB,,0000,0000,0000,,Бұл жақсы түн болды.
Dialogue: 0,0:11:13.99,0:11:16.15,ZWDB,,0000,0000,0000,,Юута Мен ешқайда бармаймын
Dialogue: 0,0:11:19.91,0:11:21.45,ZWDB,,0000,0000,0000,,Құпия түрде қайта қаралған
Dialogue: 0,0:11:21.62,0:11:23.82,ZWDB,,0000,0000,0000,,Тек бұл туралы ұмытыңыз.
Dialogue: 0,0:11:24.35,0:11:26.34,ZWDB,,0000,0000,0000,,Рас – ақиқат
Dialogue: 0,0:11:27.64,0:11:29.82,ZWDB,,0000,0000,0000,,Мен тағы келдім
Dialogue: 0,0:11:31.61,0:11:32.66,ZWDB,,0000,0000,0000,,Үй иесі жоқ
Dialogue: 0,0:11:34.32,0:11:35.12,ZWDB,,0000,0000,0000,,Егер келіспесеңіз...
Dialogue: 0,0:11:36.86,0:11:38.65,ZWDB,,0000,0000,0000,,Бұл басқару бюросы ма?
Dialogue: 0,0:11:39.04,0:11:41.31,ZWDB,,0000,0000,0000,,Қажетсіз Қажетсіз
Dialogue: 0,0:11:41.83,0:11:43.42,ZWDB,,0000,0000,0000,,Қауіпті артықшылығы бар қажетсіз тіл
Dialogue: 0,0:11:45.73,0:11:50.97,ZWDB,,0000,0000,0000,,Түпнұсқа осы жерден шыққан. Камфора жапырақтары мен армандар орындалады.
Dialogue: 0,0:11:51.27,0:11:54.25,ZWDB,,0000,0000,0000,,Қорқақтық болуы мүмкін.
Dialogue: 0,0:11:54.33,0:11:55.17,ZWDB,,0000,0000,0000,,Дарынсыз
Dialogue: 0,0:11:56.02,0:11:58.93,ZWDB,,0000,0000,0000,,Томей он қайтарылған Ұлы үйді көру
Dialogue: 0,0:11:59.72,0:12:04.30,ZWDB,,0000,0000,0000,,Бұл да бүгінгі кештің жеке орындауының тарихы.
Dialogue: 0,0:12:25.84,0:12:28.88,ZWDB,,0000,0000,0000,,Кір жуғыш машина осында.
Dialogue: 0,0:12:31.59,0:12:32.58,ZWDB,,0000,0000,0000,,Манабу Инака?
Dialogue: 0,0:12:33.87,0:12:36.83,ZWDB,,0000,0000,0000,,Исшики Дугакуя оянады
Dialogue: 0,0:12:37.62,0:12:38.57,ZWDB,,0000,0000,0000,,Тіл үйреніңіз
Dialogue: 0,0:12:39.81,0:12:46.37,ZWDB,,0000,0000,0000,,Ойландым, ойладым, ойландым, ойладым, ойладым, ойладым, ойладым, ойладым, ойланып қалдым және мен айналамын.
Dialogue: 0,0:12:48.88,0:12:50.55,ZWDB,,0000,0000,0000,,Исшики Догакуё Ичигоу
Dialogue: 0,0:12:52.79,0:12:55.57,ZWDB,,0000,0000,0000,,және т.б..
Dialogue: 0,0:12:56.99,0:13:00.22,ZWDB,,0000,0000,0000,,Қамшы? Серуендеу? Бұл туралы айтқаным есімде жоқ.
Dialogue: 0,0:13:00.71,0:13:01.29,ZWDB,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:13:01.53,0:13:03.42,ZWDB,,0000,0000,0000,,Маған ыңғайлы жауап беріңізші.
Dialogue: 0,0:13:03.75,0:13:07.18,ZWDB,,0000,0000,0000,,Өздігінен тұратын әйел императрица
Dialogue: 0,0:13:07.57,0:13:09.34,ZWDB,,0000,0000,0000,,Мен ол кезде менің досыммын.
Dialogue: 0,0:13:09.51,0:13:14.01,ZWDB,,0000,0000,0000,,Мен литургияны жасаған кезде оны айту мүмкіндігін ұмытып кеттім.
Dialogue: 0,0:13:17.27,0:13:18.91,ZWDB,,0000,0000,0000,,Оны ұстаңыз
Dialogue: 0,0:13:18.91,0:13:19.73,ZWDB,,0000,0000,0000,,…
Dialogue: 0,0:13:22.36,0:13:23.63,ZWDB,,0000,0000,0000,,Бөлек тур
Dialogue: 0,0:13:26.98,0:13:28.25,ZWDB,,0000,0000,0000,,Юта осында
Dialogue: 0,0:13:28.63,0:13:30.96,ZWDB,,0000,0000,0000,,Аты? Мен наданмын
Dialogue: 0,0:13:37.22,0:13:38.24,ZWDB,,0000,0000,0000,,Сәттілік, шығыс пен батыстан тұр
Dialogue: 0,0:13:38.87,0:13:41.80,ZWDB,,0000,0000,0000,,Мо Фей шынайы көзбен сөйлей алмайтын ең зұлым патша ма?
Dialogue: 0,0:13:42.05,0:13:42.77,ZWDB,,0000,0000,0000,,Дарынсыз
Dialogue: 0,0:13:43.96,0:13:45.70,ZWDB,,0000,0000,0000,,Қайда өлдің?
Dialogue: 0,0:13:46.20,0:13:49.40,ZWDB,,0000,0000,0000,,Бұл жоғарғы беттің кілті.
Dialogue: 0,0:13:51.07,0:13:54.47,ZWDB,,0000,0000,0000,,Курсты аяқтағаннан кейін
Dialogue: 0,0:13:55.69,0:13:58.35,ZWDB,,0000,0000,0000,,Сәттілік Юута сәттілік
Dialogue: 0,0:13:59.10,0:14:00.21,ZWDB,,0000,0000,0000,,Тағы бір қызып кету
Dialogue: 0,0:14:00.71,0:14:04.84,ZWDB,,0000,0000,0000,,Мен зұлым патша Шинганды және басқалардың бәрін құрметтеймін.
Dialogue: 0,0:14:05.09,0:14:06.84,ZWDB,,0000,0000,0000,,Шығыс пен Батыс талап етілмейді.
Dialogue: 0,0:14:10.90,0:14:12.42,ZWDB,,0000,0000,0000,,Бұл туралы ойланыңыз
Dialogue: 0,0:14:13.34,0:14:18.36,ZWDB,,0000,0000,0000,,Ингредиенттерді сатып алу жеткіліксіз болды.
Dialogue: 0,0:14:19.73,0:14:23.43,ZWDB,,0000,0000,0000,,Менің жеке әңгімем: Егер мен мұны істемесем, соңғы BOSS шайқасында қызыл қолым бос жұдырығымды қалдырамын.
Dialogue: 0,0:14:23.95,0:14:28.13,ZWDB,,0000,0000,0000,,Мен соңғы рет ыңғайлы дүкен сатып алғаныма көп болды.
Dialogue: 0,0:14:28.67,0:14:32.58,ZWDB,,0000,0000,0000,,Ыңғайлы дүкен? Сізге ыңғайлы дүкеннен азық-түлік сатып алуға қош келдіңіз.
Dialogue: 0,0:14:33.20,0:14:34.51,ZWDB,,0000,0000,0000,,Мен бұған риза емеспін
Dialogue: 0,0:14:34.59,0:14:37.40,ZWDB,,0000,0000,0000,,Бұл жай ғана адамдарды тікелей сатып ала алмау мәселесі.
Dialogue: 0,0:14:37.77,0:14:39.29,ZWDB,,0000,0000,0000,,Бұл тұтыну үшін белгілі бір талап.
Dialogue: 0,0:14:39.83,0:14:42.37,ZWDB,,0000,0000,0000,,Мақтау үшін рахмет.
Dialogue: 0,0:14:42.91,0:14:44.06,ZWDB,,0000,0000,0000,,Сондықтан мен бұл туралы ойладым.
Dialogue: 0,0:14:46.44,0:14:47.91,ZWDB,,0000,0000,0000,,Құттықтаймыз
Dialogue: 0,0:14:55.27,0:14:57.01,ZWDB,,0000,0000,0000,,Маған жұмыс өте ұнайды.
Dialogue: 0,0:14:57.85,0:15:02.00,ZWDB,,0000,0000,0000,,Мектепте оқып жүргенімде Юта маған қамқор болды.
Dialogue: 0,0:15:02.50,0:15:05.76,ZWDB,,0000,0000,0000,,Эпидермистің бөлінуі
Dialogue: 0,0:15:06.48,0:15:08.07,ZWDB,,0000,0000,0000,,Не істеу керектігін білу маңызды
Dialogue: 0,0:15:09.61,0:15:10.45,ZWDB,,0000,0000,0000,,Хаоден
Dialogue: 0,0:15:11.00,0:15:11.89,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:15:18.63,0:15:19.30,ZWDB,,0000,0000,0000,,Ал Батыста Весталис, оны тоқтатуға бел буған
Dialogue: 0,0:15:20.27,0:15:22.28,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:15:23.23,0:15:25.04,ZWDB,,0000,0000,0000,,Келіңіз және бізді көріңіз
Dialogue: 0,0:15:29.76,0:15:30.68,ZWDB,,0000,0000,0000,,Басқа дәм
Dialogue: 0,0:15:30.98,0:15:31.80,ZWDB,,0000,0000,0000,,Мұның бәрі бар.
Dialogue: 0,0:15:33.02,0:15:34.24,ZWDB,,0000,0000,0000,,Ютаның кешкі асы дәмді ме?
Dialogue: 0,0:15:35.01,0:15:36.90,ZWDB,,0000,0000,0000,,Тамақтану және көру туралы ойлау
Dialogue: 0,0:15:40.90,0:15:41.62,ZWDB,,0000,0000,0000,,тым ұзақ
Dialogue: 0,0:15:41.92,0:15:42.79,ZWDB,,0000,0000,0000,,Юта!
Dialogue: 0,0:15:43.29,0:15:46.27,ZWDB,,0000,0000,0000,,Осы жұмысты қабылдағаныңыз үшін рахмет.
Dialogue: 0,0:15:48.38,0:15:49.30,ZWDB,,0000,0000,0000,,Қызыл түс қаупі
Dialogue: 0,0:15:49.82,0:15:51.41,ZWDB,,0000,0000,0000,,Мүлдем негізсіз
Dialogue: 0,0:15:54.07,0:15:55.26,ZWDB,,0000,0000,0000,,Тіркеу аяқталды
Dialogue: 0,0:15:56.01,0:15:57.48,ZWDB,,0000,0000,0000,,Жақсы
Dialogue: 0,0:16:18.63,0:16:19.12,ZWDB,,0000,0000,0000,,Юта
Dialogue: 0,0:16:21.21,0:16:22.28,ZWDB,,0000,0000,0000,,Өзіндік рефлексия
Dialogue: 0,0:16:22.83,0:16:23.28,ZWDB,,0000,0000,0000,,Ха?
Dialogue: 0,0:16:23.77,0:16:25.51,ZWDB,,0000,0000,0000,,Гакко Икшита Гекко
Dialogue: 0,0:16:25.89,0:16:27.10,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:16:37.24,0:16:40.33,ZWDB,,0000,0000,0000,,Түнде жалғыз ән айтуға болады.
Dialogue: 0,0:16:40.70,0:16:45.25,ZWDB,,0000,0000,0000,,Менің осында екенімді білдіреді: «Мен сенің астанаға келіп, өз сезімімді мойындауыңа дайынмын».
Dialogue: 0,0:16:45.59,0:16:47.06,ZWDB,,0000,0000,0000,,Гарай-кай Чидо-ку
Dialogue: 0,0:16:47.06,0:16:49.17,ZWDB,,0000,0000,0000,,Бұл аздап қайғылы.
Dialogue: 0,0:16:49.40,0:16:53.05,ZWDB,,0000,0000,0000,,Литургияны ашуды ұмытып қалсаңыз, мен сізге мейірімділік хабарын жіберемін.
Dialogue: 0,0:16:53.05,0:16:55.16,ZWDB,,0000,0000,0000,,Тағы да сөйлесейік.
Dialogue: 0,0:16:55.51,0:16:57.16,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:16:57.43,0:16:58.07,ZWDB,,0000,0000,0000,,Тағы да
Dialogue: 0,0:16:59.19,0:17:01.25,ZWDB,,0000,0000,0000,,Кішкентай құстар турынан ләззат ала аласыз.
Dialogue: 0,0:17:02.02,0:17:03.29,ZWDB,,0000,0000,0000,,Орныңыздан тұрып, тамақтанып болған соң
Dialogue: 0,0:17:04.48,0:17:06.10,ZWDB,,0000,0000,0000,,Мен Наяның бір қасықты ұмытып кетіппін.
Dialogue: 0,0:17:06.47,0:17:08.93,ZWDB,,0000,0000,0000,,Сіз нені айтасыз? Сіз қазір осындасыз және жалғызсыз.
Dialogue: 0,0:17:09.23,0:17:09.70,ZWDB,,0000,0000,0000,,Есептеу
Dialogue: 0,0:17:10.50,0:17:13.85,ZWDB,,0000,0000,0000,,Мұны тікелей көре алатыныңызға күмәнім жоқ, қорытындыға келген бойда кез келген жерде жүре аласыз.
Dialogue: 0,0:17:14.30,0:17:17.68,ZWDB,,0000,0000,0000,,Сіз осында болсаңыз, дәл сол нәрсені үйрену мүмкін емес.
Dialogue: 0,0:17:18.05,0:17:18.63,ZWDB,,0000,0000,0000,,Төлеу мүмкін емес
Dialogue: 0,0:17:19.42,0:17:23.02,ZWDB,,0000,0000,0000,,Наказэ Рокухана, Чуунибиоудың толық ашылған үйі
Dialogue: 0,0:17:23.42,0:17:24.79,ZWDB,,0000,0000,0000,,Мен орта және орта мектепте дүниеге келдім.
Dialogue: 0,0:17:25.24,0:17:26.48,ZWDB,,0000,0000,0000,,7-ші эпизод: Секси тапанша дебют жасайды – Бірінші бөлім
Dialogue: 0,0:17:26.83,0:17:27.40,ZWDB,,0000,0000,0000,,Юта
Dialogue: 0,0:17:29.79,0:17:30.18,ZWDB,,0000,0000,0000,,7-ші эпизод: Секси тапанша дебют жасайды – Бірінші бөлім
Dialogue: 0,0:17:30.78,0:17:32.49,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:17:33.54,0:17:34.26,ZWDB,,0000,0000,0000,,Барлығыңды өлтіреміз
Dialogue: 0,0:17:38.82,0:17:41.33,ZWZJ2,,0000,0000,0000,,Исшики Дугакуеннің дүниеге келгеніне көп уақыт болды, сондықтан мен соңғы рет қоңырау шалғаныма көп уақыт болды.
Dialogue: 0,0:17:47.36,0:17:48.10,ZWDB,,0000,0000,0000,,Варокука…
Dialogue: 0,0:17:50.22,0:17:52.08,ZWDB,,0000,0000,0000,,Фуфу Фу Фуаиши
Dialogue: 0,0:17:52.85,0:17:56.98,ZWDB,,0000,0000,0000,,Әңгіме орта мектепте оқитын алты жасар фантастикалық қыз Нацукоға және оны тастап кеткен махаббат хикаясына оралады.
Dialogue: 0,0:17:58.24,0:18:02.10,ZWDB,,0000,0000,0000,,Юта: Бұл «Найзағай Құдайдың қалтасы» ма?
Dialogue: 0,0:18:03.74,0:18:04.48,ZWDB,,0000,0000,0000,,Фукай Фукай
Dialogue: 0,0:18:05.03,0:18:06.30,ZWDB,,0000,0000,0000,,Киім жинау үшін бөлек уақыт
Dialogue: 0,0:18:06.72,0:18:08.02,ZWDB,,0000,0000,0000,,Орнынан тұрып, мектепке баруға болады.
Dialogue: 0,0:18:15.34,0:18:17.36,ZWDB,,0000,0000,0000,,Сіз туралы шынайы ойлар және астанаға саяхаттау мүмкіндігіңіз
Dialogue: 0,0:18:17.85,0:18:19.05,ZWDB,,0000,0000,0000,,Бұл жақсы түн болды.
Dialogue: 0,0:18:19.69,0:18:21.87,ZWDB,,0000,0000,0000,,Ұйқыға өтіп, басып шығаруды аяқтағаннан кейін...
Dialogue: 0,0:18:24.71,0:18:26.23,ZWDB,,0000,0000,0000,,Ютаның киімге деген талғамы
Dialogue: 0,0:18:28.04,0:18:28.37,ZWDB,,0000,0000,0000,,Қажет емес
Dialogue: 0,0:18:28.91,0:18:29.66,ZWDB,,0000,0000,0000,,Жылдамдық
Dialogue: 0,0:18:31.75,0:18:33.24,ZWDB,,0000,0000,0000,,Ютаның киімге деген талғамы
Dialogue: 0,0:18:35.00,0:18:37.24,ZWDB,,0000,0000,0000,,Қажет емес
Dialogue: 0,0:18:39.58,0:18:40.45,ZWDB,,0000,0000,0000,,Мен осындамын
Dialogue: 0,0:18:41.32,0:18:44.72,ZWDB,,0000,0000,0000,,Түн – зұлым патшаның шынайы көздері іске қосылатын уақыт...
Dialogue: 0,0:18:44.72,0:18:45.59,ZWDB,,0000,0000,0000,,Қайырлы түн жақсы ұйықтаңыз
Dialogue: 0,0:18:47.55,0:18:49.87,ZWDB,,0000,0000,0000,,Шынайы оқиға - «Юутаның дәмдік жолы»…
Dialogue: 0,0:19:05.85,0:19:07.19,ZWDB,,0000,0000,0000,,Әңгімені естіген соң, ұйқыға кеттім.
Dialogue: 0,0:19:07.66,0:19:08.85,ZWDB,,0000,0000,0000,,Жүрексіз сәжде
Dialogue: 0,0:19:09.50,0:19:12.76,ZWDB,,0000,0000,0000,,Мен бұл салада жұмыс бастаймын ба деп қорқамын, сондықтан мен сақ болуым керек.
Dialogue: 0,0:19:13.55,0:19:14.15,ZWDB,,0000,0000,0000,,Сіз не айтасыз?
Dialogue: 0,0:19:20.98,0:19:21.31,ZWDB,,0000,0000,0000,,Мен телефонды қарадым.
Dialogue: 0,0:19:21.98,0:19:23.12,ZWDB,,0000,0000,0000,,Жүрексіз сәжде
Dialogue: 0,0:19:23.64,0:19:24.59,ZWDB,,0000,0000,0000,,Қайырлы түн
Dialogue: 0,0:19:25.46,0:19:26.35,ZWDB,,0000,0000,0000,,Шинсо-дори тікелей секіру
Dialogue: 0,0:19:26.58,0:19:27.25,ZWDB,,0000,0000,0000,,НАТО біржақты
Dialogue: 0,0:19:27.92,0:19:28.76,ZWDB,,0000,0000,0000,,Толқу
Dialogue: 0,0:19:29.01,0:19:30.38,ZWDB,,0000,0000,0000,,Сіз негізгі саябақтасыз.
Dialogue: 0,0:19:31.02,0:19:31.87,ZWDB,,0000,0000,0000,,Қажетті жарылыс аяқталды
Dialogue: 0,0:19:32.07,0:19:32.84,ZWDB,,0000,0000,0000,,Бұл сөзсіз тұрарлық
Dialogue: 0,0:19:33.34,0:19:34.30,ZWDB,,0000,0000,0000,,Гая белгісіз
Dialogue: 0,0:19:38.53,0:19:39.45,ZWDB,,0000,0000,0000,,Қайырлы түн жақсы ұйқы
Dialogue: 0,0:19:41.96,0:19:42.63,ZWDB,,0000,0000,0000,,Уолтер Эванс (59)
Dialogue: 0,0:19:44.42,0:19:45.17,ZWDB,,0000,0000,0000,,Сіз не айтасыз…
Dialogue: 0,0:19:47.13,0:19:48.22,ZWDB,,0000,0000,0000,,Қажетсіз іске қосу
Dialogue: 0,0:19:49.29,0:19:51.18,ZWDB,,0000,0000,0000,,...
Dialogue: 0,0:19:51.85,0:19:54.16,ZWDB,,0000,0000,0000,,Ютаның қабақтары
Dialogue: 0,0:19:54.54,0:19:55.03,ZWDB,,0000,0000,0000,,тақырып
Dialogue: 0,0:19:55.41,0:19:58.86,ZWDB,,0000,0000,0000,,Бір кездесу, бір кездесу, біреудің жұмысы
Dialogue: 0,0:20:00.53,0:20:05.10,ZWDB,,0000,0000,0000,,Мүмкін емес
Dialogue: 0,0:20:07.34,0:20:10.17,ZWDB,,0000,0000,0000,,Менімен сөйлес...
Dialogue: 0,0:20:11.74,0:20:14.25,ZWDB,,0000,0000,0000,,тең емес
Dialogue: 0,0:20:28.26,0:20:29.21,ZWDB,,0000,0000,0000,,Кескіндеменің мәні осы.
Dialogue: 0,0:20:29.93,0:20:34.82,ZWDB,,0000,0000,0000,,Бұл толық тиімділігі бар сиқырлы бөлік және бұл жаңа келісімшарттың дәлелі.
Dialogue: 0,0:20:36.96,0:20:38.95,ZWDB,,0000,0000,0000,,Суреттер аймақта толығымен жоғалған.
Dialogue: 0,0:20:39.60,0:20:43.65,ZWDB,,0000,0000,0000,,Бұл ең қолайлы жер.
Dialogue: 0,0:20:44.05,0:20:47.50,ZWDB,,0000,0000,0000,,Лактың қара қараңғылығы мен қуатын шығарған қара жалын
Dialogue: 0,0:20:53.19,0:20:53.74,ZWDB,,0000,0000,0000,,Маған ұйқы керек
Dialogue: 0,0:20:58.91,0:21:02.02,ZWDB,,0000,0000,0000,,Әңгіменің мағынасы: қала Чуунибиоға толы.
Dialogue: 0,0:21:03.13,0:21:05.77,ZWDB,,0000,0000,0000,,Мен жұмысты осылай таптым.
Dialogue: 0,0:21:09.45,0:21:10.52,ZWDB,,0000,0000,0000,,Күнтізбе
Dialogue: 0,0:21:17.00,0:21:20.03,ZWDB,,0000,0000,0000,,Жүрегім секіруді тоқтатпайды, әр түрлі сезімдер...
Dialogue: 0,0:21:28.86,0:21:29.40,ZWDB,,0000,0000,0000,,Бірақ енді мен не істей аламын?
Dialogue: 0,0:22:08.62,0:22:09.30,ZWDB,,0000,0000,0000,,Юта
Dialogue: 0,0:08:11.73,0:08:15.51,JPIN,,0000,0000,0000,,Кім байқаған еді?
Dialogue: 0,0:08:16.46,0:08:19.41,JPIN,,0000,0000,0000,,Жарықтың сыртында
Dialogue: 0,0:08:19.41,0:08:22.52,JPIN,,0000,0000,0000,,Қараңғы көлеңкеде
Dialogue: 0,0:08:23.27,0:08:28.96,JPIN,,0000,0000,0000,,Өткен де алыстан айғайлады
Dialogue: 0,0:08:29.58,0:08:34.77,JPIN,,0000,0000,0000,,Егер мен саған арқамды бұрсам, мен сені ұстаймын
Dialogue: 0,0:08:35.82,0:08:41.19,JPIN,,0000,0000,0000,,Бұл ауырады деп өзіңізді әлсіз деп шешпеңіз.
Dialogue: 0,0:08:41.31,0:08:47.43,JPIN,,0000,0000,0000,,Жақсы болғаны оның күшті екенін білдірмейді деп ойламаңыз.
Dialogue: 0,0:08:48.00,0:08:53.79,JPIN,,0000,0000,0000,,Сіз ұстаған қол маған жылу береді
Dialogue: 0,0:08:54.19,0:09:00.75,JPIN,,0000,0000,0000,,Мен бұған сенуге тырысамын ба?
Dialogue: 0,0:09:00.75,0:09:03.73,JPIN,,0000,0000,0000,,Ақыры түсіндім
Dialogue: 0,0:09:03.73,0:09:06.76,JPIN,,0000,0000,0000,,Мен оны таптым
Dialogue: 0,0:09:07.01,0:09:12.58,JPIN,,0000,0000,0000,,Көз жасынан бұлдыратылған шындық
Dialogue: 0,0:09:13.35,0:09:16.26,JPIN,,0000,0000,0000,,Мен өзім болғым келеді
Dialogue: 0,0:09:16.43,0:09:18.99,JPIN,,0000,0000,0000,,Басымды сипап жатқанда
Dialogue: 0,0:09:19.54,0:09:25.75,JPIN,,0000,0000,0000,,Ұйқы профиліңіз қазір
Dialogue: 0,0:09:25.75,0:09:31.22,JPIN,,0000,0000,0000,,Жаңа сезімдерді нұрландырды
Dialogue: 0,0:09:33.55,0:09:37.46,JPIN,,0000,0000,0000,,Менің қасымда болғаныңыз үшін рахмет.
Dialogue: 0,0:09:38.25,0:09:45.41,JPIN,,0000,0000,0000,,Бастауыштың тұқымы көктеп шықты
Dialogue: 0,0:08:11.73,0:08:15.51,ZWIN,,0000,0000,0000,,Біреу мені ескертті
Dialogue: 0,0:08:16.46,0:08:19.41,ZWIN,,0000,0000,0000,,Нұрдың нұры
Dialogue: 0,0:08:19.41,0:08:22.52,ZWIN,,0000,0000,0000,,Көлеңкенің өзгеруі
Dialogue: 0,0:08:23.27,0:08:28.96,ZWIN,,0000,0000,0000,,Өткендегі дауыстар
Dialogue: 0,0:08:29.58,0:08:34.77,ZWIN,,0000,0000,0000,,Жолдан кейін мені құшақтайсың.
Dialogue: 0,0:08:35.82,0:08:41.19,ZWIN,,0000,0000,0000,,Факторларды түсіну қиын және өзін-өзі әлсіретеді
Dialogue: 0,0:08:41.31,0:08:47.43,ZWIN,,0000,0000,0000,,Сондай-ақ өзін-өзі тексерудің толық көлемін қарастырудың қажеті жоқ.
Dialogue: 0,0:08:48.00,0:08:53.79,ZWIN,,0000,0000,0000,,Қолың жылы.
Dialogue: 0,0:08:54.19,0:09:00.75,ZWIN,,0000,0000,0000,,Сондай-ақ басқалармен қарым-қатынас жасауға болады.
Dialogue: 0,0:09:00.75,0:09:03.73,ZWIN,,0000,0000,0000,,Хабарламаның соңы
Dialogue: 0,0:09:03.73,0:09:06.76,ZWIN,,0000,0000,0000,,Күнтізбе келді
Dialogue: 0,0:09:07.01,0:09:12.58,ZWIN,,0000,0000,0000,,Судың артындағы шындық
Dialogue: 0,0:09:13.35,0:09:16.26,ZWIN,,0000,0000,0000,,Мен туралы не ойлайсың?
Dialogue: 0,0:09:16.43,0:09:18.99,ZWIN,,0000,0000,0000,,Сізге тек табысты болу керек.
Dialogue: 0,0:09:19.54,0:09:25.75,ZWIN,,0000,0000,0000,,Ұйқының жағы
Dialogue: 0,0:09:25.75,0:09:31.22,ZWIN,,0000,0000,0000,,Будданың жаңа сезімдері
Dialogue: 0,0:09:33.55,0:09:37.46,ZWIN,,0000,0000,0000,,Қолдауыңыз үшін рахмет.
Dialogue: 0,0:09:38.25,0:09:45.41,ZWIN,,0000,0000,0000,,Алғашқы тұқым себу.