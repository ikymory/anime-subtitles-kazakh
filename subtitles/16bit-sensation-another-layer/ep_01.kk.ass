Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:13.26,0:00:16.14,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:00:24.23,0:00:27.44,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:00:28.65,0:00:29.98,Default,,0,0,0,,Әй, бұл!
Dialogue: 0,0:00:30.07,0:00:32.82,Default,,0,0,0,,Батыс күнтізбесінде бұл қай жыл?
Dialogue: 0,0:00:34.36,0:00:38.99,Default,,0,0,0,,Ал... биыл 1992 жыл.
Dialogue: 0,0:00:39.08,0:00:42.29,Default,,0,0,0,,1992?
Dialogue: 0,0:00:43.12,0:00:44.83,Default,,0,0,0,,Иә!
Dialogue: 0,0:00:44.91,0:00:48.79,Default,,0,0,0,,Уау~ Мен төменгі жағындамын!
Dialogue: 0,0:00:48.88,0:00:52.21,Default,,0,0,0,,Ха ха ха... Ой... Сабыр ет.
Dialogue: 0,0:00:52.30,0:00:53.47,Default,,0,0,0,,Мен сені екеуіңді де жақсы көремін, сондықтан оны өзім бергім келеді.
Dialogue: 0,0:00:53.55,0:00:54.34,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:00:54.42,0:00:58.09,Default,,0,0,0,,Ах... Менің атым Акисато Коноха!
Dialogue: 0,0:00:58.18,0:01:02.10,Default,,0,0,0,,Мен... Мен... 2023 жылғы әлемненмін.
Dialogue: 0,0:01:02.18,0:01:06.06,Default,,0,0,0,,Мен Акихабараға 1992 жылы келдім!
Dialogue: 0,0:01:06.14,0:01:07.15,Default,,0,0,0,,Бұл басқаша.
Dialogue: 0,0:01:07.23,0:01:09.86,Default,,0,0,0,,Уф... Мен бұл дұрыс емес адам екеніне сенімдімін!
Dialogue: 0,0:01:09.94,0:01:13.44,Default,,0,0,0,,Коноха - жай ғана төмен деңгейлі иллюстратор.
Dialogue: 0,0:01:13.53,0:01:16.45,Default,,0,0,0,,Бұл мен үшін мүмкін емес...
Dialogue: 0,0:01:16.99,0:01:19.45,Default,,0,0,0,,Уф... суық.
Dialogue: 0,0:01:19.53,0:01:22.33,Default,,0,0,0,,Әй, бұл! Сіз бұл бейнені көріп отырсыз
Dialogue: 0,0:01:22.41,0:01:24.00,Default,,0,0,0,,Осы жерде өлсем
Dialogue: 0,0:01:24.08,0:01:25.29,Default,,0,0,0,,Менің бөлмемдегі компьютер
Dialogue: 0,0:01:25.37,0:01:28.96,Default,,0,0,0,,Қатты дискінің мазмұнына қарамаңыз; оны толығымен жойыңыз!
Dialogue: 0,0:01:29.04,0:01:31.13,Default,,0,0,0,,Дәл осы, өтінемін!
Dialogue: 0,0:01:31.21,0:01:33.51,Default,,0,0,0,,Мекен-жайы: Мусашино қаласы, Токио...
Dialogue: 0,0:01:35.09,0:01:37.01,Default,,0,0,0,,Заряд бітті
Dialogue: 0,0:01:37.09,0:01:41.39,Default,,0,0,0,,Уф... Мен түбінде тұрмын!
Dialogue: 0,0:01:49.77,0:01:50.77,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:01:54.15,0:01:55.19,Default,,0,0,0,,Ммм
Dialogue: 0,0:01:56.03,0:01:56.95,Default,,0,0,0,,Хаа…
Dialogue: 0,0:02:02.33,0:02:04.45,Default,,0,0,0,,I Акисато Коноха
Dialogue: 0,0:02:04.54,0:02:08.67,Default,,0,0,0,,Bluebell әдемі қыздар ойынын шығаратын компаниямен байланысты иллюстратор
Dialogue: 0,0:02:08.75,0:02:13.21,Default,,0,0,0,,Жақын арада сүйкімді де жігерлі кейіпкерлер бірінен соң бірі құрылады.
Dialogue: 0,0:02:13.29,0:02:15.63,Default,,0,0,0,,Өте танымал суретші болуды жоспарлаңыз
Dialogue: 0,0:02:15.71,0:02:18.63,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:02:20.72,0:02:24.14,Default,,0,0,0,,Жарайсыңдар, балалар, келесі жолы осымен барайық.
Dialogue: 0,0:02:24.22,0:02:25.85,Default,,0,0,0,,Тақырып дұрыс
Dialogue: 0,0:02:25.93,0:02:29.14,Default,,0,0,0,,"Қош келдіңіздер! Гипноз үйленген әйел салоны"
Dialogue: 0,0:02:29.23,0:02:29.73,Default,,0,0,0,,Е...
Dialogue: 0,0:02:29.81,0:02:31.73,Default,,0,0,0,,Ой, осыншама ұзақ па?
Dialogue: 0,0:02:31.81,0:02:34.69,Default,,0,0,0,,Қалғанын ертең айтамыз, сондықтан ұсынысты оқып шығыңыз.
Dialogue: 0,0:02:35.86,0:02:38.57,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:02:39.07,0:02:40.16,Default,,0,0,0,,Хаа…
Dialogue: 0,0:02:40.74,0:02:43.20,Default,,0,0,0,,Соңғы бишоджо ойын индустриясы
Dialogue: 0,0:02:43.28,0:02:46.29,Default,,0,0,0,,Жеңіл романдарда, әлеуметтік ойындарда, Втуберлерде, соққылық әдіспен.
Dialogue: 0,0:02:46.37,0:02:48.25,Default,,0,0,0,,мүлде сатылмайды
Dialogue: 0,0:02:48.33,0:02:52.04,Default,,0,0,0,,Менің Bluebell компаниясы төменде!
Dialogue: 0,0:02:52.13,0:02:56.25,Default,,0,0,0,,Толық бағасы бар ойындарды ойнау енді мүмкін емес, сондықтан менің президентім арзан ойындарға назар аударды.
Dialogue: 0,0:02:56.34,0:03:00.63,Default,,0,0,0,,Коноха да кішкентай әдемі қыздар ойыны компанияларының бірі.
Dialogue: 0,0:03:01.51,0:03:05.39,Default,,0,0,0,,Noresu қосымша иллюстраторы
Dialogue: 0,0:03:05.47,0:03:08.35,Default,,0,0,0,,Компанияның бас суретшісі...
Dialogue: 0,0:03:11.02,0:03:12.65,Default,,0,0,0,,SNS-ге шабуыл жасалды
Dialogue: 0,0:03:12.73,0:03:15.61,Default,,0,0,0,,Жүрегім жараланып, сурет сала алмаймын.
Dialogue: 0,0:03:17.48,0:03:20.86,Default,,0,0,0,,Мен әдемі қыздарды жақсы көремін Мен әдемі қыздар ойындарын жақсы көремін
Dialogue: 0,0:03:20.95,0:03:23.16,Default,,0,0,0,,Мен осы компанияға қосылдым.
Dialogue: 0,0:03:23.99,0:03:25.24,Default,,0,0,0,,Фуфуфуфу~
Dialogue: 0,0:03:25.33,0:03:29.12,Default,,0,0,0,,Коноха жұлдызды иллюстраторға айналады!
Dialogue: 0,0:03:29.20,0:03:31.66,Default,,0,0,0,,Мен айтсам да...
Dialogue: 0,0:03:33.50,0:03:37.59,Default,,0,0,0,,Неліктен тек еркектердің арқасын бояйсың?
Dialogue: 0,0:03:37.67,0:03:39.30,Default,,0,0,0,,Уф!
Dialogue: 0,0:03:39.38,0:03:43.26,Default,,0,0,0,,Шындық - бұл бос ойын!
Dialogue: 0,0:03:46.97,0:03:48.77,Default,,0,0,0,,аяқталды
Dialogue: 0,0:03:48.85,0:03:49.89,Default,,0,0,0,,Енді үйге қайтайық?
Dialogue: 0,0:03:49.97,0:03:51.14,Default,,0,0,0,,Үйге бару Үйге қайт
Dialogue: 0,0:03:52.19,0:03:53.02,Default,,0,0,0,,Иида-кун мен Яо-санды да құттықтаймыз.
Dialogue: 0,0:03:53.10,0:03:54.56,Default,,0,0,0,,(Смартфонның діріл дыбысы)
Dialogue: 0,0:03:55.56,0:03:56.06,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:58.73,0:04:00.03,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:04:00.11,0:04:01.69,Default,,0,0,0,,Алдын ала кешіріңіз.
Dialogue: 0,0:04:01.78,0:04:03.70,Default,,0,0,0,,Жақсы жұмыс...
Dialogue: 0,0:04:06.57,0:04:08.20,Default,,0,0,0,,Алдын ала тапсырыс берілген өнім
Dialogue: 0,0:04:08.28,0:04:10.33,Default,,0,0,0,,Сіз мұнда қате жібердіңіз бе?
Dialogue: 0,0:04:10.41,0:04:13.37,Default,,0,0,0,,бұл... иә... жарайды.
Dialogue: 0,0:04:13.46,0:04:17.34,Default,,0,0,0,,А... иә, иә, рахмет. Ум... аа... рахмет.
Dialogue: 0,0:04:18.00,0:04:19.75,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:04:22.26,0:04:26.76,Default,,0,0,0,,Мен Күлгіннің жаңа жұмысын асыға күтемін!
Dialogue: 0,0:04:26.84,0:04:27.43,Default,,0,0,0,,О
Dialogue: 0,0:04:27.51,0:04:30.06,Default,,0,0,0,,О, өте сүйкімді!
Dialogue: 0,0:04:31.22,0:04:32.93,Default,,0,0,0,,Уау, бұл да қауіпті.
Dialogue: 0,0:04:33.02,0:04:35.56,Default,,0,0,0,,Уау, бұл да жақсы!
Dialogue: 0,0:04:35.65,0:04:37.94,Default,,0,0,0,,Нхухуху нхухуфу…
Dialogue: 0,0:04:38.02,0:04:41.44,Default,,0,0,0,,Нфуфуфу~!
Dialogue: 0,0:04:43.53,0:04:47.24,Default,,0,0,0,,Келесі Ниши-Огикубо Ниши-Огикубо
Dialogue: 0,0:04:47.32,0:04:48.95,Default,,0,0,0,,Шығу оң жақта
Dialogue: 0,0:04:49.83,0:04:52.62,Default,,0,0,0,,Келесі станция - Ниши-Огикубо.
Dialogue: 0,0:04:52.70,0:04:53.20,Default,,0,0,0,,Ах
Dialogue: 0,0:05:04.55,0:05:06.47,Default,,0,0,0,,Гунуну…
Dialogue: 0,0:05:07.30,0:05:08.47,Default,,0,0,0,,Митака Митака
Dialogue: 0,0:05:08.55,0:05:09.64,Default,,0,0,0,,Ах
Dialogue: 0,0:05:14.02,0:05:15.44,Default,,0,0,0,,(құлыпты ашу дыбысы)
Dialogue: 0,0:05:29.28,0:05:31.41,Default,,0,0,0,,Дүниеге қараңыз
Dialogue: 0,0:05:31.49,0:05:35.62,Default,,0,0,0,,Бір күні мен осы сөреде Коноханың суреттері бар ойындарды көрсетемін!
Dialogue: 0,0:05:35.71,0:05:38.37,Default,,0,0,0,,Ең алдымен, бұған дейін
Dialogue: 0,0:05:41.84,0:05:43.42,Default,,0,0,0,,Хаа~
Dialogue: 0,0:05:48.68,0:05:49.97,Default,,0,0,0,,Қандай азап…
Dialogue: 0,0:05:50.05,0:05:52.47,Default,,0,0,0,,Рейтинг төмендеп жатыр!
Dialogue: 0,0:05:53.14,0:05:54.27,Default,,0,0,0,,Хаа…
Dialogue: 0,0:05:54.35,0:05:57.52,Default,,0,0,0,,Мен бұл жолы өте жақсы суреттей алдым.
Dialogue: 0,0:05:57.60,0:06:00.02,Default,,0,0,0,,Мен не болды деп ойлаймын...
Dialogue: 0,0:06:00.52,0:06:03.11,Default,,0,0,0,,Тәтті~ Келесі жолы!
Dialogue: 0,0:06:05.11,0:06:06.74,Default,,0,0,0,,Меніңше... олар әлі өздерін жинастыра алмай, қиналып жатыр.
Dialogue: 0,0:06:16.58,0:06:17.79,Default,,0,0,0,,Хаа…
Dialogue: 0,0:06:39.56,0:06:42.52,Default,,0,0,0,,Енді кешегі әңгіменің жалғасы.
Dialogue: 0,0:06:42.61,0:06:44.86,Default,,0,0,0,,Балалар, сендер ұсынысты оқыдыңдар ма?
Dialogue: 0,0:06:44.94,0:06:46.11,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:06:46.19,0:06:47.40,Default,,0,0,0,,Мен ұсыныс жасаймын!
Dialogue: 0,0:06:47.49,0:06:48.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:48.19,0:06:49.90,Default,,0,0,0,,Бұл сен кімсің?
Dialogue: 0,0:06:49.99,0:06:52.49,Default,,0,0,0,,Ұсыныс дегеніміз не? Жаңа жұмыс туралы идея?
Dialogue: 0,0:06:52.57,0:06:53.20,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:53.28,0:06:55.41,Default,,0,0,0,,Менде жақсы идея бар!
Dialogue: 0,0:06:55.49,0:06:58.16,Default,,0,0,0,,Хм, бұл қандай мазмұн?
Dialogue: 0,0:06:58.25,0:07:01.62,Default,,0,0,0,,Осылай басталады... Майдан даласынан басталады!
Dialogue: 0,0:07:03.04,0:07:06.80,Default,,0,0,0,,Алыс планетада соғыс жүріп жатыр.
Dialogue: 0,0:07:06.88,0:07:08.92,Default,,0,0,0,,Өйткені, сонша алыс жерден
Dialogue: 0,0:07:09.01,0:07:12.05,Default,,0,0,0,,Мен ертегіні бастауыңды қалаймын, Коноха.
Dialogue: 0,0:07:12.14,0:07:14.26,Default,,0,0,0,,Бұл болашақ Жер ме?
Dialogue: 0,0:07:14.35,0:07:17.35,Default,,0,0,0,,Әлде бұл басқа өлшемдегі оқиға ма?
Dialogue: 0,0:07:17.43,0:07:18.68,Default,,0,0,0,,Жек көру?
Dialogue: 0,0:07:19.98,0:07:25.23,Default,,0,0,0,,Жапонияның ауылдық жерінде мектепке барған қыз болды!
Dialogue: 0,0:07:26.73,0:07:28.90,Default,,0,0,0,,Содан кейін қыздың денесі
Dialogue: 0,0:07:28.99,0:07:31.28,Default,,0,0,0,,Оның жартысы еріп, жоғалады!
Dialogue: 0,0:07:31.36,0:07:33.03,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:33.11,0:07:34.16,Default,,0,0,0,,Ақымақ! Хе-хе-хе! ➡
Dialogue: 0,0:07:34.24,0:07:35.07,Default,,0,0,0,,Хяаа
Dialogue: 0,0:07:35.16,0:07:37.54,Default,,0,0,0,,Сіздің әңгімеңіз қанша уақытқа созылды?
Dialogue: 0,0:07:37.62,0:07:40.20,Default,,0,0,0,,Мм...әлі ашылу күні.
Dialogue: 0,0:07:40.29,0:07:42.12,Default,,0,0,0,,Кейіпкер тіпті көрінбейді.
Dialogue: 0,0:07:42.62,0:07:45.13,Default,,0,0,0,,Бұл әлі де кейіпкердің достары туралы әңгіме...
Dialogue: 0,0:07:45.21,0:07:46.42,Default,,0,0,0,,Ғрр! Б-бұл жігіт…
Dialogue: 0,0:07:46.50,0:07:47.09,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:47.17,0:07:49.05,Default,,0,0,0,,Сіз кіріспеде
Dialogue: 0,0:07:49.13,0:07:51.01,Default,,0,0,0,,Қанша минут кетті!
Dialogue: 0,0:07:51.09,0:07:53.34,Default,,0,0,0,,Сіз қандай ойын ойнауды жоспарлап отырсыз?
Dialogue: 0,0:07:53.43,0:07:57.18,Default,,0,0,0,,Осындай ойын жасау қанша тұрады деп ойлайсың?
Dialogue: 0,0:07:57.26,0:08:00.60,Default,,0,0,0,,Сіз не қаласаңыз, сосын компанияны жойғыңыз келе ме?
Dialogue: 0,0:08:01.18,0:08:03.85,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:08:03.94,0:08:06.36,Default,,0,0,0,,Сіз шедеврлерді жасаған кезде және оларды барлығы сатып алған кезде.
Dialogue: 0,0:08:06.44,0:08:08.48,Default,,0,0,0,,Бәрі бітті.
Dialogue: 0,0:08:08.57,0:08:09.11,Default,,0,0,0,,Ha
Dialogue: 0,0:08:09.19,0:08:11.44,Default,,0,0,0,,Біз жасай алатын ең жақсы нәрсе
Dialogue: 0,0:08:11.53,0:08:15.74,Default,,0,0,0,,Бұл 4500 иендік гипноз некедегі әйел заты.
Dialogue: 0,0:08:15.82,0:08:16.62,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:08:18.62,0:08:19.99,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:08:23.08,0:08:24.21,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:08:29.84,0:08:30.96,Default,,0,0,0,,Ах
Dialogue: 0,0:08:34.76,0:08:35.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:36.72,0:08:38.39,Default,,0,0,0,,Жылы емес
Dialogue: 0,0:08:39.10,0:08:41.64,Default,,0,0,0,,Микротолқынды пеш бұзылды ма?
Dialogue: 0,0:08:42.14,0:08:45.81,Default,,0,0,0,,Хаа... Мен түскі ас сатып алайын деп жатырмын.
Dialogue: 0,0:08:47.15,0:08:48.40,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:08:48.48,0:08:52.15,Default,,0,0,0,,Менде ақша жоқ, сондықтан мен гипноздық үйленген әйел затын жасаймын.
Dialogue: 0,0:08:52.65,0:08:54.95,Default,,0,0,0,,Ондай бәсекелестер өте көп.
Dialogue: 0,0:08:55.03,0:08:58.74,Default,,0,0,0,,Ұйықтататын заттарды жасайтын адамдармен бәсекелесуге мүмкіндік жоқ.
Dialogue: 0,0:09:00.83,0:09:03.58,Default,,0,0,0,,Баяғыда адамдар шедеврлер жасап, оларды барлығы сатып алатын.
Dialogue: 0,0:09:03.66,0:09:05.96,Default,,0,0,0,,Бәрі бітті.
Dialogue: 0,0:09:07.04,0:09:08.33,Default,,0,0,0,,Хаа…
Dialogue: 0,0:09:09.09,0:09:11.38,Default,,0,0,0,,Дұрыс, осындай кезде...
Dialogue: 0,0:09:14.97,0:09:17.18,Default,,0,0,0,,Қиналғанда Алладан сұрау
Dialogue: 0,0:09:17.26,0:09:20.18,Default,,0,0,0,,Коноханың айналасында орналасқан толық бағалық ойын.
Dialogue: 0,0:09:20.26,0:09:21.60,Default,,0,0,0,,Сіз үлгере аласыз деп үміттенемін.
Dialogue: 0,0:09:21.68,0:09:24.60,Default,,0,0,0,,Егер бұл мүмкін болса, мен бәрін істеймін...
Dialogue: 0,0:09:25.64,0:09:30.02,Default,,0,0,0,,Бұл емес... бірақ мен салыстырмалы түрде кез келген нәрсені істей аламын.
Dialogue: 0,0:09:30.11,0:09:31.73,Default,,0,0,0,,Мен Изуку Мидориямын!
Dialogue: 0,0:09:38.16,0:09:39.66,Default,,0,0,0,,(ит үреді)
Dialogue: 0,0:09:39.74,0:09:40.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:42.49,0:09:43.49,Default,,0,0,0,,Дио жақын жерде.
Dialogue: 0,0:09:45.00,0:09:45.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:47.04,0:09:49.71,Default,,0,0,0,,BIBI ойын дүкені?
Dialogue: 0,0:09:50.29,0:09:53.25,Default,,0,0,0,,Қолданылған ойын дүкені? Осындай жерде ме?
Dialogue: 0,0:09:55.01,0:09:56.72,Default,,0,0,0,,Мен білмедім
Dialogue: 0,0:09:56.80,0:09:59.18,Default,,0,0,0,,Коноханың назарынан тыс қалғаныма сене алар емеспін!
Dialogue: 0,0:10:09.23,0:10:12.94,Default,,0,0,0,,Бұл өнімдердің өте қарапайым таңдауы...
Dialogue: 0,0:10:13.94,0:10:16.69,Default,,0,0,0,,О, олар бишоджо ойындарын да сатады.
Dialogue: 0,0:10:16.78,0:10:18.36,Default,,0,0,0,,Қайсысы?
Dialogue: 0,0:10:18.45,0:10:19.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:19.95,0:10:21.62,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:21.70,0:10:23.16,Default,,0,0,0,,«Канон» - 100 иен?
Dialogue: 0,0:10:23.24,0:10:25.58,Default,,0,0,0,,Е! «Комипа» да 100 иен бе?
Dialogue: 0,0:10:25.66,0:10:27.66,Default,,0,0,0,,«Лэнс» де 100 иен ме?
Dialogue: 0,0:10:27.75,0:10:29.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:32.88,0:10:34.21,Default,,0,0,0,,(Бағдарламалық құрал дірілдеген дыбыс)
Dialogue: 0,0:10:34.30,0:10:38.05,Default,,0,0,0,,Бұл бос жәшік емес, оның ішінде мазмұны бар.
Dialogue: 0,0:10:39.55,0:10:42.35,Default,,0,0,0,,Ах, у... кешіріңіз!
Dialogue: 0,0:10:42.85,0:10:45.14,Default,,0,0,0,,Қош келдіңіз.
Dialogue: 0,0:10:45.22,0:10:48.56,Default,,0,0,0,,Бұл сатып алу туралы емес.
Dialogue: 0,0:10:48.64,0:10:52.36,Default,,0,0,0,,Мм... бұл ойын неге сонша арзан?
Dialogue: 0,0:10:52.44,0:10:56.53,Default,,0,0,0,,Жоқ, мен қорапты біраз лас деп ойладым.
Dialogue: 0,0:10:56.61,0:10:58.90,Default,,0,0,0,,Бұл өте әдемі.
Dialogue: 0,0:10:58.99,0:11:01.24,Default,,0,0,0,,Бұл «Канонның» бірінші басылымы
Dialogue: 0,0:11:01.32,0:11:04.53,Default,,0,0,0,,Егер сіз оны 100 иенге сатсаңыз, ол сатып алынады және қайта сатылады.
Dialogue: 0,0:11:04.62,0:11:06.41,Default,,0,0,0,,Теңбай?
Dialogue: 0,0:11:06.99,0:11:11.00,Default,,0,0,0,,Өйткені мен мұндай нәрсені түсінбеймін.
Dialogue: 0,0:11:11.08,0:11:13.88,Default,,0,0,0,,Әже, бұл шедевр!
Dialogue: 0,0:11:13.96,0:11:15.50,Default,,0,0,0,,Бұл құнды!
Dialogue: 0,0:11:15.59,0:11:17.55,Default,,0,0,0,,Сондықтан оны вагонға сатудың қажеті жоқ
Dialogue: 0,0:11:17.63,0:11:18.80,Default,,0,0,0,,Көптеген адамдар...
Dialogue: 0,0:11:19.47,0:11:23.39,Default,,0,0,0,,Бұл қандай ойын түрі?
Dialogue: 0,0:11:23.47,0:11:25.47,Default,,0,0,0,,Аа, бұл қандай ойын?
Dialogue: 0,0:11:26.26,0:11:29.89,Default,,0,0,0,,Мм, сенімен сөйлессем болады ма? Коноха?
Dialogue: 0,0:11:29.98,0:11:30.77,Default,,0,0,0,,Иә
Dialogue: 0,0:11:30.85,0:11:32.60,Default,,0,0,0,,Шынымен бе? Әрине
Dialogue: 0,0:11:32.69,0:11:34.65,Default,,0,0,0,,Маған тыңдауға рұқсат етіңіз.
Dialogue: 0,0:11:35.19,0:11:36.02,Default,,0,0,0,,Кочон
Dialogue: 0,0:11:37.02,0:11:39.07,Default,,0,0,0,,Бұл «Канон» нені білдіреді?
Dialogue: 0,0:11:39.15,0:11:44.16,Default,,0,0,0,,Бұл 1999 жылы шықты және бұл өте қызық!
Dialogue: 0,0:11:44.24,0:11:47.08,Default,,0,0,0,,Мына Аю қызы «Угуу» дейді.
Dialogue: 0,0:11:47.16,0:11:48.83,Default,,0,0,0,,«Уф!»
Dialogue: 0,0:11:48.91,0:11:50.29,Default,,0,0,0,,Уф?
Dialogue: 0,0:11:52.37,0:11:55.42,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:11:55.50,0:11:58.63,Default,,0,0,0,,Мұнда көптеген таңғажайып ойындар бар.
Dialogue: 0,0:11:58.71,0:12:00.13,Default,,0,0,0,,Бұл вагон
Dialogue: 0,0:12:00.21,0:12:03.05,Default,,0,0,0,,Маған жақсырақ баға беріңізші.
Dialogue: 0,0:12:03.13,0:12:07.22,Default,,0,0,0,,Кішкентай қыз, сен ойындарды жақсы көресің.
Dialogue: 0,0:12:07.30,0:12:08.06,Default,,0,0,0,,А...
Dialogue: 0,0:12:08.76,0:12:10.47,Default,,0,0,0,,Ой, кешір.
Dialogue: 0,0:12:10.56,0:12:11.98,Default,,0,0,0,,Бұл... бәрі осы.
Dialogue: 0,0:12:12.06,0:12:15.06,Default,,0,0,0,,Бұл сүйкімді қыздарға ортақ білім.
Dialogue: 0,0:12:17.31,0:12:18.19,Default,,0,0,0,,Ха!
Dialogue: 0,0:12:18.27,0:12:20.03,Default,,0,0,0,,Мен... Кешіріңіз!
Dialogue: 0,0:12:20.11,0:12:22.74,Default,,0,0,0,,Эгоисттік нәрселер туралы тым ұзақ сөйлесу
Dialogue: 0,0:12:22.82,0:12:24.99,Default,,0,0,0,,Мен тезірек жұмысқа қайта оралуым керек.
Dialogue: 0,0:12:26.49,0:12:28.08,Default,,0,0,0,,Коноха-чан
Dialogue: 0,0:12:28.16,0:12:31.33,Default,,0,0,0,,Қыздар ойнайтын ойындар ұнай ма?
Dialogue: 0,0:12:31.41,0:12:32.00,Default,,0,0,0,,Ах
Dialogue: 0,0:12:32.08,0:12:34.75,Default,,0,0,0,,Бұл... иә... біртүрлі ме?
Dialogue: 0,0:12:34.83,0:12:37.25,Default,,0,0,0,,Жоқ
Dialogue: 0,0:12:38.67,0:12:43.84,Default,,0,0,0,,Сүйкімді қыздарды көргенде мен өзімді қуаттаймын.
Dialogue: 0,0:12:44.51,0:12:47.22,Default,,0,0,0,,Бірақ бұл жай ғана сүйкімді емес.
Dialogue: 0,0:12:47.30,0:12:49.43,Default,,0,0,0,,Ойындағы қыз
Dialogue: 0,0:12:49.51,0:12:53.64,Default,,0,0,0,,Жылау, күлу, көп уайымдау
Dialogue: 0,0:12:54.14,0:12:57.06,Default,,0,0,0,,Сонда да мықты болыңыз және бар күшіңізді салыңыз
Dialogue: 0,0:12:57.65,0:13:02.15,Default,,0,0,0,,Ойындағы қыз - ең жарқын!
Dialogue: 0,0:13:04.86,0:13:08.78,Default,,0,0,0,,Менің ойында белсенді болғанымды қалайтын қызым бар.
Dialogue: 0,0:13:09.74,0:13:13.45,Default,,0,0,0,,Мен ол баланың керемет шытырман оқиғасы болғанын қалаймын!
Dialogue: 0,0:13:14.50,0:13:17.88,Default,,0,0,0,,Сондықтан мен бұл жай ғана иллюстрация емес, ойын болғанын қалаймын.
Dialogue: 0,0:13:17.96,0:13:21.46,Default,,0,0,0,,Сұлу қызды барынша белсенді ететін не?
Dialogue: 0,0:13:21.55,0:13:23.42,Default,,0,0,0,,Өйткені бұл әдемі қыздар ойыны!
Dialogue: 0,0:13:24.22,0:13:28.43,Default,,0,0,0,,Әже, мен шын мәнінде ойын туралы көп білмеймін.
Dialogue: 0,0:13:28.51,0:13:33.10,Default,,0,0,0,,Коноха-чанның ойыны қызықты болатынына сенімдімін.
Dialogue: 0,0:13:33.18,0:13:34.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:36.64,0:13:37.94,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:38.02,0:13:42.02,Default,,0,0,0,,Уау, әже!
Dialogue: 0,0:13:42.11,0:13:44.24,Default,,0,0,0,,Әй, не болды?
Dialogue: 0,0:13:44.32,0:13:47.99,Default,,0,0,0,,Жұмыста Коноха туралы айтқанымды тыңдайтын ешкім жоқ.
Dialogue: 0,0:13:48.07,0:13:50.07,Default,,0,0,0,,Оны Коноха да біледі.
Dialogue: 0,0:13:50.16,0:13:52.70,Default,,0,0,0,,Толық пластик жасау мүмкін емес.
Dialogue: 0,0:13:53.20,0:13:55.45,Default,,0,0,0,,Дегенмен, аздап...
Dialogue: 0,0:13:55.54,0:13:59.21,Default,,0,0,0,,Коноха туралы аздап тыңдағаныңызды қалаймын!
Dialogue: 0,0:14:01.96,0:14:05.63,Default,,0,0,0,,Ойындар қызықты және қызықты, бірақ
Dialogue: 0,0:14:06.22,0:14:09.64,Default,,0,0,0,,Менің компаниямда ешкім армандамайды.
Dialogue: 0,0:14:10.39,0:14:13.47,Default,,0,0,0,,Армансыз ойын мүлде ойын емес!
Dialogue: 0,0:14:13.56,0:14:14.97,Default,,0,0,0,,Гипноз жақсы.
Dialogue: 0,0:14:15.06,0:14:18.14,Default,,0,0,0,,Мен армандармен ойын жасағым келеді!
Dialogue: 0,0:14:20.10,0:14:23.36,Default,,0,0,0,,Мен компаниядан шыға алмаймын ба?
Dialogue: 0,0:14:23.44,0:14:25.48,Default,,0,0,0,,О, дұрыс. Менді шілдеде көрсетілетін драмаға таңдады.
Dialogue: 0,0:14:25.57,0:14:28.61,Default,,0,0,0,,Коноханың мұндай қорлайтын көзқарасы жоқ.
Dialogue: 0,0:14:29.11,0:14:33.53,Default,,0,0,0,,Шығу қорқынышты және мүмкін емес...
Dialogue: 0,0:14:33.62,0:14:35.04,Default,,0,0,0,,Ей, тыңда—
Dialogue: 0,0:14:37.58,0:14:39.83,Default,,0,0,0,,Бірақ әжеге рахмет
Dialogue: 0,0:14:39.92,0:14:43.29,Default,,0,0,0,,Әйтеуір, көңілім күңгірттеніп кетті.
Dialogue: 0,0:14:43.38,0:14:46.46,Default,,0,0,0,,Мм... тағы келе аламын ба?
Dialogue: 0,0:14:46.55,0:14:47.92,Default,,0,0,0,,Қажеті жоқ. Айтқым келетін ешкім жоқ.
Dialogue: 0,0:14:48.01,0:14:51.14,Default,,0,0,0,,Дүкен ашық кез келген уақытта келіңіз.
Dialogue: 0,0:14:52.26,0:14:54.35,Default,,0,0,0,,Рахмет, әже!
Dialogue: 0,0:15:04.48,0:15:06.32,Default,,0,0,0,,Хм~
Dialogue: 0,0:15:06.40,0:15:07.28,Default,,0,0,0,,Хаа…
Dialogue: 0,0:15:07.86,0:15:08.69,Default,,0,0,0,,Ах
Dialogue: 0,0:15:08.78,0:15:13.07,Default,,0,0,0,,Мен түскі асқа барған BIBI атты ойын дүкеніне тоқтаймын деп ойлаймын.
Dialogue: 0,0:15:13.70,0:15:14.28,Default,,0,0,0,,Ах
Dialogue: 0,0:15:14.37,0:15:15.91,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:15:16.70,0:15:18.62,Default,,0,0,0,,Тайяки
Dialogue: 0,0:15:18.70,0:15:21.29,Default,,0,0,0,,Себебі сен менің әңгімемді бүгін тыңдадың.
Dialogue: 0,0:15:21.37,0:15:23.88,Default,,0,0,0,,Сізге алғыс ретінде бірдеңе әкелуім керек пе?
Dialogue: 0,0:15:24.92,0:15:26.38,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:15:27.34,0:15:29.05,Default,,0,0,0,,А... Иә?
Dialogue: 0,0:15:29.92,0:15:32.22,Default,,0,0,0,,Бұл жерде болды, солай ма?
Dialogue: 0,0:15:38.81,0:15:39.89,Default,,0,0,0,,Ашық
Dialogue: 0,0:15:47.11,0:15:47.69,Default,,0,0,0,,Ах
Dialogue: 0,0:15:49.78,0:15:51.70,Default,,0,0,0,,Қағаз қап?
Dialogue: 0,0:15:56.28,0:15:58.04,Default,,0,0,0,,«Коноха-чанға»
Dialogue: 0,0:15:58.12,0:16:00.79,Default,,0,0,0,,«Көңілді әңгіме үшін рахмет»
Dialogue: 0,0:16:01.29,0:16:02.83,Default,,0,0,0,,Әже...
Dialogue: 0,0:16:02.92,0:16:05.21,Default,,0,0,0,,Күндізгі уақытта қалыпты болды.
Dialogue: 0,0:16:05.71,0:16:08.13,Default,,0,0,0,,Ол кешке қашып кеткен болуы мүмкін бе?
Dialogue: 0,0:16:08.63,0:16:10.46,Default,,0,0,0,,Жоқ, бұл шындық болуы мүмкін емес!
Dialogue: 0,0:16:10.97,0:16:13.76,Default,,0,0,0,,Оны тез жою мүмкін емес.
Dialogue: 0,0:16:17.51,0:16:18.18,Default,,0,0,0,,(Аңқылдаған дыбыс)
Dialogue: 0,0:16:23.23,0:16:24.31,Default,,0,0,0,,Бұл…
Dialogue: 0,0:16:24.40,0:16:27.77,Default,,0,0,0,,Бұл әжеңнің кәдесыйы болуы мүмкін бе?
Dialogue: 0,0:16:32.86,0:16:34.36,Default,,0,0,0,,Ой, аралы тен
Dialogue: 0,0:16:34.45,0:16:36.95,Default,,0,0,0,,Түскі ас кезінде біз айтқан ойындар
Dialogue: 0,0:16:37.45,0:16:39.54,Default,,0,0,0,,Шедеврлерге толы
Dialogue: 0,0:16:39.62,0:16:43.46,Default,,0,0,0,,Бұл дәуір өте қызықты болса керек.
Dialogue: 0,0:16:43.54,0:16:45.67,Default,,0,0,0,,Бишоуджо ойындарының алтын ғасыры
Dialogue: 0,0:16:49.17,0:16:52.84,Default,,0,0,0,,Дүние қаншама сұлу қыздарға толы болса да
Dialogue: 0,0:16:57.55,0:17:00.01,Default,,0,0,0,,Коноха осылай мәңгі қалады.
Dialogue: 0,0:17:00.10,0:17:03.10,Default,,0,0,0,,Менің қолымнан ештеңе келмей бітер ме екен...
Dialogue: 0,0:17:07.60,0:17:08.15,Default,,0,0,0,,Ах
Dialogue: 0,0:17:10.65,0:17:12.40,Default,,0,0,0,,«Сыныптас»
Dialogue: 0,0:17:15.82,0:17:16.91,Default,,0,0,0,,DOS нұсқасы
Dialogue: 0,0:17:16.99,0:17:18.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:19.32,0:17:20.16,Default,,0,0,0,,А...
Dialogue: 0,0:17:20.24,0:17:21.62,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:25.50,0:17:27.37,Default,,0,0,0,,Иә...
Dialogue: 0,0:17:27.46,0:17:29.84,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:31.50,0:17:32.21,Default,,0,0,0,,Ха!
Dialogue: 0,0:17:32.30,0:17:35.63,Default,,0,0,0,,О, не? Жоқ... не?
Dialogue: 0,0:17:36.26,0:17:37.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:43.06,0:17:44.52,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:17:45.31,0:17:47.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:49.61,0:17:50.19,Default,,0,0,0,,А...
Dialogue: 0,0:17:52.48,0:17:53.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:02.33,0:18:05.79,Default,,0,0,0,,Міне, 1992 жыл аяқталуға жақын.
Dialogue: 0,0:18:05.87,0:18:09.29,Default,,0,0,0,,Биылғы жыл сен үшін қандай жыл болды?
Dialogue: 0,0:18:09.37,0:18:10.75,Default,,0,0,0,,Ақырында мен
Dialogue: 0,0:18:11.54,0:18:14.13,Default,,0,0,0,,Биыл менің сүйіктім...
Dialogue: 0,0:18:14.21,0:18:16.26,Default,,0,0,0,,Мен мұны істей алмадым!
Dialogue: 0,0:18:16.34,0:18:18.97,Default,,0,0,0,,Каори, радионы тоқтатыңыз.
Dialogue: 0,0:18:19.05,0:18:20.43,Default,,0,0,0,,Бұл қызықсыз.
Dialogue: 0,0:18:20.51,0:18:24.18,Default,,0,0,0,,Рождество мейрамы болса да, біз әлі де кездесусіз дамып жатырмыз.
Dialogue: 0,0:18:24.26,0:18:25.68,Default,,0,0,0,,Егер сіз солай ойласаңыз
Dialogue: 0,0:18:25.77,0:18:28.35,Default,,0,0,0,,Тенчо да дұрыс түзетеді.
Dialogue: 0,0:18:28.44,0:18:32.06,Default,,0,0,0,,Кюнши мырза, 33-көрініс бойынша сөйлемді аяқтадыңыз ба?
Dialogue: 0,0:18:32.15,0:18:33.65,Default,,0,0,0,,Мен мұны қазір істеп жатырмын
Dialogue: 0,0:18:34.69,0:18:36.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:36.15,0:18:38.11,Default,,0,0,0,,Ум... Мамору-кун
Dialogue: 0,0:18:38.20,0:18:40.99,Default,,0,0,0,,Мен қате алып жатырмын, неге?
Dialogue: 0,0:18:41.07,0:18:42.03,Default,,0,0,0,,Эй
Dialogue: 0,0:18:42.66,0:18:43.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:44.74,0:18:46.58,Default,,0,0,0,,Сіз мұны көрмейсіз бе? (Мейко) А?
Dialogue: 0,0:18:46.66,0:18:50.17,Default,,0,0,0,,Мм... «PBA»?
Dialogue: 0,0:18:52.13,0:18:53.17,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:18:53.25,0:18:54.55,Default,,0,0,0,,«Бағдарлама»
Dialogue: 0,0:18:54.63,0:18:55.71,Default,,0,0,0,,«Оқу»
Dialogue: 0,0:18:55.80,0:18:57.30,Default,,0,0,0,,«Идиоттар»
Dialogue: 0,0:18:58.09,0:19:00.13,Default,,0,0,0,,Менің бағдарламам тамаша
Dialogue: 0,0:19:00.22,0:19:02.85,Default,,0,0,0,,Бірақ сендер ойланбастан қостыңдар.
Dialogue: 0,0:19:02.93,0:19:04.64,Default,,0,0,0,,Рұқсатсыз қатені жасаңыз
Dialogue: 0,0:19:04.72,0:19:07.06,Default,,0,0,0,,Сол бөксені сүртетін мен емес пе?
Dialogue: 0,0:19:07.14,0:19:09.10,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:19:09.18,0:19:10.10,Default,,0,0,0,,Хун
Dialogue: 0,0:19:10.77,0:19:13.27,Default,,0,0,0,,Осы 98 (Кюхачи) сезімдері туралы көбірек ойланыңыз.
Dialogue: 0,0:19:13.36,0:19:17.78,Default,,0,0,0,,9801 (Кюу Хачимаруичи) қатты жұмыс істеп жатыр.
Dialogue: 0,0:19:18.28,0:19:21.28,Default,,0,0,0,,Лас файлдарды жасамаңыз және қателер тудырмаңыз
Dialogue: 0,0:19:21.36,0:19:23.91,Default,,0,0,0,,Әй, бұрынғы күндер жақсы еді.
Dialogue: 0,0:19:23.99,0:19:26.99,Default,,0,0,0,,Бәрі бағдарламашы болған кезде.
Dialogue: 0,0:19:27.58,0:19:30.66,Default,,0,0,0,,Мамоккидің 98 ауруы қайтадан басталды.
Dialogue: 0,0:19:31.17,0:19:32.96,Default,,0,0,0,,15 жасымда мен қазірдің өзінде сағынышқа толымын.
Dialogue: 0,0:19:33.04,0:19:37.42,Default,,0,0,0,,Ах... иә... біз саған сенеміз.
Dialogue: 0,0:19:37.50,0:19:38.88,Default,,0,0,0,,Қамқоршы
Dialogue: 0,0:19:40.30,0:19:42.55,Default,,0,0,0,,Мен де бағдарламалауды оқып жатырмын.
Dialogue: 0,0:19:42.63,0:19:43.39,Default,,0,0,0,,(қолды біріктіру дыбысы)
Dialogue: 0,0:19:43.47,0:19:46.51,Default,,0,0,0,,Түзетуге көмектесіңіз!
Dialogue: 0,0:19:48.85,0:19:50.02,Default,,0,0,0,,Хаа…
Dialogue: 0,0:19:50.10,0:19:52.19,Default,,0,0,0,,Сақтау кезінде өлшем мәселелеріне байланысты болуы мүмкін
Dialogue: 0,0:19:52.27,0:19:54.02,Default,,0,0,0,,Менің ойымша, бұл қате.
Dialogue: 0,0:19:54.10,0:19:55.48,Default,,0,0,0,,Оны кейінірек анықтаймыз
Dialogue: 0,0:19:56.61,0:19:58.15,Default,,0,0,0,,Қайда бара жатырсың? Мамокки
Dialogue: 0,0:19:58.23,0:20:00.40,Default,,0,0,0,,Сыртта кофе сатып алыңыз
Dialogue: 0,0:20:00.49,0:20:02.49,Default,,0,0,0,,100 иен жеткіліксіз.
Dialogue: 0,0:20:02.57,0:20:04.45,Default,,0,0,0,,Өйткені тұтыну салығы алынды
Dialogue: 0,0:20:04.53,0:20:05.82,Default,,0,0,0,,Цубаки горилла емес—
Dialogue: 0,0:20:07.28,0:20:08.54,Default,,0,0,0,,(құбырдың құлаған дыбысы)
Dialogue: 0,0:20:17.67,0:20:20.63,Default,,0,0,0,,Бишоуджо ойындарында не қызық?
Dialogue: 0,0:20:21.34,0:20:24.01,Default,,0,0,0,,Неліктен әлі де жөндеудесіз?
Dialogue: 0,0:20:24.59,0:20:26.89,Default,,0,0,0,,Осы уақытқа дейін бітуі керек еді!
Dialogue: 0,0:20:26.97,0:20:29.26,Default,,0,0,0,,Ойын жасаудың мәні осы!
Dialogue: 0,0:20:29.35,0:20:31.68,Default,,0,0,0,,Ересек адам не істейді?
Dialogue: 0,0:20:31.77,0:20:33.98,Default,,0,0,0,,Әкемнің компаниясында көмектескенім болмаса.
Dialogue: 0,0:20:34.06,0:20:35.90,Default,,0,0,0,,Мұны кім жасайды?
Dialogue: 0,0:20:39.57,0:20:40.61,Default,,0,0,0,,Мен оны тоқтатамын
Dialogue: 0,0:20:41.19,0:20:42.99,Default,,0,0,0,,Осы ойын аяқталғаннан кейін
Dialogue: 0,0:20:43.07,0:20:45.82,Default,,0,0,0,,Бұл жолы мен әдемі қыздар ойындарын ойнауды тоқтатамын.
Dialogue: 0,0:20:47.12,0:20:47.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:51.62,0:20:53.46,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:20:53.54,0:20:55.04,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:20:55.12,0:20:55.92,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:56.46,0:20:57.71,Default,,0,0,0,,Ватат...
Dialogue: 0,0:20:57.79,0:20:58.63,Default,,0,0,0,,Ta!
Dialogue: 0,0:20:58.71,0:21:02.76,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:02.84,0:21:04.55,Default,,0,0,0,,Камераларға түспейді ғой, иә?
Dialogue: 0,0:21:05.59,0:21:07.26,Default,,0,0,0,,Куууу…
Dialogue: 0,0:21:07.34,0:21:08.47,Default,,0,0,0,,Ау, ау…
Dialogue: 0,0:21:10.56,0:21:12.02,Default,,0,0,0,,Жоқ... сен қандайсың?
Dialogue: 0,0:21:12.10,0:21:14.31,Default,,0,0,0,,Ах! Кешіріңіз, кешіріңіз
Dialogue: 0,0:21:14.39,0:21:15.60,Default,,0,0,0,,Эй... дәл қазір.
Dialogue: 0,0:21:15.69,0:21:17.56,Default,,0,0,0,,Коноха шошып кетті
Dialogue: 0,0:21:18.19,0:21:19.23,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:19.31,0:21:22.44,Default,,0,0,0,,Жоқ... жоқ! Konoha компаниясы!
Dialogue: 0,0:21:22.53,0:21:23.40,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:23.49,0:21:28.41,Default,,0,0,0,,Ал... биыл 1992 жыл.
Dialogue: 0,0:21:28.49,0:21:31.74,Default,,0,0,0,,Бұл 1992 жылы болды.
Dialogue: 0,0:21:32.87,0:21:36.12,Default,,0,0,0,,Шынымен, шынымен
Dialogue: 0,0:21:36.21,0:21:37.46,Default,,0,0,0,,Коноха
Dialogue: 0,0:21:37.54,0:21:43.55,Default,,0,0,0,,Уақыт секірісі!
Dialogue: 0,0:21:51.68,0:21:53.93,Default,,0,0,0,,А... а...
Dialogue: 0,0:22:02.19,0:22:02.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:05.90,0:22:07.90,Default,,0,0,0,,♪～
Dialogue: 0,0:23:31.91,0:23:33.91,Default,,0,0,0,,～♪
Dialogue: 0,0:23:36.54,0:23:40.41,Default,,0,0,0,,(Пернетақта пернесінің дыбысы)
Dialogue: 0,0:23:41.91,0:23:47.91,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
