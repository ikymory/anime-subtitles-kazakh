Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.33,0:00:05.42,Default,,0,0,0,,ызылдау)
Dialogue: 0,0:00:05.50,0:00:07.17,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:00:09.42,0:00:11.88,Default,,0,0,0,,Эй, эй! (Өтіп бара жатқан адам) Бұл не?
Dialogue: 0,0:00:16.55,0:00:17.72,Default,,0,0,0,,ＵＦＯ？
Dialogue: 0,0:00:18.51,0:00:19.76,Default,,0,0,0,,О, менің…
Dialogue: 0,0:00:22.85,0:00:25.73,Default,,0,0,0,,Ал... Мамору-кун, біреу шықты!
Dialogue: 0,0:00:25.81,0:00:28.06,Default,,0,0,0,,Ах... бұл...
Dialogue: 0,0:00:28.57,0:00:30.73,Default,,0,0,0,,E... жаңғырық?
Dialogue: 0,0:00:31.32,0:00:32.44,Default,,0,0,0,,Хехе
Dialogue: 0,0:00:39.87,0:00:42.08,Default,,0,0,0,,А... сен...
Dialogue: 0,0:00:42.16,0:00:43.20,Default,,0,0,0,,Эхо
Dialogue: 0,0:00:44.79,0:00:46.67,Default,,0,0,0,,Немен айналысып жатырсың!
Dialogue: 0,0:00:46.75,0:00:49.09,Default,,0,0,0,,Акисато Коноханы тез қорғаңыз!
Dialogue: 0,0:00:49.17,0:00:50.09,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,0:00:52.71,0:00:53.59,Default,,0,0,0,,Жарылыс!
Dialogue: 0,0:00:57.76,0:00:58.55,Default,,0,0,0,,Не!
Dialogue: 0,0:01:00.10,0:01:01.68,Default,,0,0,0,,Сізге жаңғырық...
Dialogue: 0,0:01:01.77,0:01:04.10,Default,,0,0,0,,Сіз бізге көмектестіңіз бе?
Dialogue: 0,0:01:06.14,0:01:06.90,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:01:06.98,0:01:10.02,Default,,0,0,0,,А... ә!
Dialogue: 0,0:01:11.32,0:01:12.53,Default,,0,0,0,,Ал... Мамору-кун!
Dialogue: 0,0:01:13.03,0:01:15.74,Default,,0,0,0,,Жарайды, ол жау емес.
Dialogue: 0,0:01:21.49,0:01:23.12,Default,,0,0,0,,Хмм… мм…
Dialogue: 0,0:01:23.20,0:01:24.00,Default,,0,0,0,,Ха!
Dialogue: 0,0:01:24.08,0:01:25.79,Default,,0,0,0,,Бұл да Зигтің ісі ме?
Dialogue: 0,0:01:25.87,0:01:27.58,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:01:27.67,0:01:31.59,Default,,0,0,0,,Сонымен... одан да маңыздысы, Мамору-кун, бұл қайда?
Dialogue: 0,0:01:31.67,0:01:34.21,Default,,0,0,0,,Келіңіздер ме? Мен де шынымен түсінбеймін
Dialogue: 0,0:01:34.88,0:01:39.01,Default,,0,0,0,,Бұл бұрынғыдан мүлде басқа жер екені даусыз.
Dialogue: 0,0:01:39.76,0:01:42.93,Default,,0,0,0,,Мамору-кун, сен сабырлы сияқтысың.
Dialogue: 0,0:01:43.01,0:01:46.06,Default,,0,0,0,,Аударманы түсінбейтіндердің қуғанынан жақсы.
Dialogue: 0,0:01:46.64,0:01:48.77,Default,,0,0,0,,Сіз ояусыз ба?
Dialogue: 0,0:01:50.48,0:01:52.02,Default,,0,0,0,,Сіз...
Dialogue: 0,0:01:52.11,0:01:54.69,Default,,0,0,0,,Эй, сен Мамору-сан емессің бе?
Dialogue: 0,0:01:55.24,0:01:58.61,Default,,0,0,0,,Біз жасаған ойынды ойнадыңдар ма?
Dialogue: 0,0:01:59.11,0:02:02.08,Default,,0,0,0,,Мамору-кун, сен де бұл адамды танисың ба?
Dialogue: 0,0:02:02.16,0:02:03.74,Default,,0,0,0,,Сөйлегенде ұзарады.
Dialogue: 0,0:02:08.33,0:02:09.96,Default,,0,0,0,,Мен оны уақытында жасағаныма қуаныштымын.
Dialogue: 0,0:02:10.50,0:02:12.54,Default,,0,0,0,,Осы жерде саған бірдеңе болса
Dialogue: 0,0:02:12.63,0:02:15.92,Default,,0,0,0,,Мен қайтадан ұзақ айналма жолмен жүруге тура келді.
Dialogue: 0,0:02:16.46,0:02:18.88,Default,,0,0,0,,Сөйтіп, біз ақыры кездестік.
Dialogue: 0,0:02:18.97,0:02:22.60,Default,,0,0,0,,Мм... мм... сен кімсің?
Dialogue: 0,0:02:23.18,0:02:25.14,Default,,0,0,0,,Көп тәсілдермен көрсетуге болады
Dialogue: 0,0:02:25.68,0:02:28.14,Default,,0,0,0,,Бір сөзбен айтып жеткізу қиын.
Dialogue: 0,0:02:28.64,0:02:29.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:31.44,0:02:32.65,Default,,0,0,0,,Сіз...
Dialogue: 0,0:02:32.73,0:02:33.52,Default,,0,0,0,,Хехе
Dialogue: 0,0:02:33.61,0:02:34.44,Default,,0,0,0,,)
Dialogue: 0,0:02:35.82,0:02:39.95,Default,,0,0,0,,Мен сені кездестіру үшін ұзақ жол жүрдім.
Dialogue: 0,0:02:40.03,0:02:42.82,Default,,0,0,0,,Ал мен осы сөздерді жеткізгім келді.
Dialogue: 0,0:02:44.20,0:02:45.91,Default,,0,0,0,,Қол қойыңыз
Dialogue: 0,0:02:47.70,0:02:48.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:48.71,0:02:51.33,Default,,0,0,0,,Мен сенің жанкүйеріңмін
Dialogue: 0,0:02:51.42,0:02:52.17,Default,,0,0,0,,Желдеткіш?
Dialogue: 0,0:02:52.25,0:02:53.96,Default,,0,0,0,,Иә үлкен желдеткіш
Dialogue: 0,0:02:55.21,0:02:57.01,Default,,0,0,0,,Ах... Мм...
Dialogue: 0,0:02:57.09,0:03:00.01,Default,,0,0,0,,Сонда мен қайсысына қол қоюым керек?
Dialogue: 0,0:03:00.09,0:03:01.43,Default,,0,0,0,,Мұнда басыңыз
Dialogue: 0,0:03:03.64,0:03:06.43,Default,,0,0,0,,Осы ұяшыққа қол қою керек пе?
Dialogue: 0,0:03:06.51,0:03:07.93,Default,,0,0,0,,Қалай болғанда да
Dialogue: 0,0:03:12.98,0:03:14.81,Default,,0,0,0,,Өтінемін...
Dialogue: 0,0:03:19.61,0:03:21.03,Default,,0,0,0,,Рахмет
Dialogue: 0,0:03:22.07,0:03:24.53,Default,,0,0,0,,Жоқ... Жоқ, бұл.
Dialogue: 0,0:03:26.45,0:03:28.24,Default,,0,0,0,,Бұл ойын
Dialogue: 0,0:03:28.75,0:03:31.62,Default,,0,0,0,,Сіз аяқтағалы тұрған ойын
Dialogue: 0,0:03:31.71,0:03:32.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:32.54,0:03:36.34,Default,,0,0,0,,Мен олардың дәл қазір оны жасау процесінде екеніне сенімдімін.
Dialogue: 0,0:03:36.84,0:03:38.96,Default,,0,0,0,,Бұл ойын шедевр
Dialogue: 0,0:03:39.05,0:03:41.97,Default,,0,0,0,,A… Ахаха мен бақыттымын.
Dialogue: 0,0:03:42.05,0:03:45.35,Default,,0,0,0,,Мен жасап жатқан ойын туралы мақтау сөздер алсам да...
Dialogue: 0,0:03:45.43,0:03:48.47,Default,,0,0,0,,Хмм... түсіндім. Бұл дұрыс.
Dialogue: 0,0:03:48.56,0:03:49.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:49.89,0:03:52.56,Default,,0,0,0,,Оның қандай ойын екенін көргіңіз келе ме?
Dialogue: 0,0:03:52.64,0:03:53.52,Default,,0,0,0,,А...
Dialogue: 0,0:03:54.65,0:03:58.07,Default,,0,0,0,,Бұл енді сіз жасайтын ойын түрі.
Dialogue: 0,0:04:00.61,0:04:02.11,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,0:04:03.82,0:04:06.70,Default,,0,0,0,,Бізге осылай көрінеді.
Dialogue: 0,0:04:07.28,0:04:10.79,Default,,0,0,0,,Коноха-сан, сен бұл жарықтың не екенін білесің бе?
Dialogue: 0,0:04:10.87,0:04:15.92,Default,,0,0,0,,Білмеймін...бірақ бұл біртүрлі болып көрінеді
Dialogue: 0,0:04:16.50,0:04:19.09,Default,,0,0,0,,Бұл адамның қиялы
Dialogue: 0,0:04:19.17,0:04:20.84,Default,,0,0,0,,Қиял?
Dialogue: 0,0:04:21.34,0:04:23.59,Default,,0,0,0,,Қызық деп ойламайсыз ба?
Dialogue: 0,0:04:23.68,0:04:28.26,Default,,0,0,0,,Ол пішінін өзгертіп, уақыт өте осылай қалады.
Dialogue: 0,0:04:30.35,0:04:32.23,Default,,0,0,0,,Сіз жалғыз емессіз
Dialogue: 0,0:04:32.73,0:04:36.19,Default,,0,0,0,,Бұл барлық адамдарда болатын күш.
Dialogue: 0,0:04:36.27,0:04:38.23,Default,,0,0,0,,Қараңызшы, өтінемін.
Dialogue: 0,0:04:39.69,0:04:40.57,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:41.86,0:04:45.61,Default,,0,0,0,,Бұл адамдар үшін ерекше күш емес.
Dialogue: 0,0:04:52.50,0:04:54.83,Default,,0,0,0,,А... не? бұл жарық
Dialogue: 0,0:04:55.92,0:04:58.54,Default,,0,0,0,,Балалар, ересектер және қарттар
Dialogue: 0,0:04:58.63,0:05:00.71,Default,,0,0,0,,Кез келген жерде тұратын кез келген адам
Dialogue: 0,0:05:00.80,0:05:03.30,Default,,0,0,0,,Олар бірдей жабдықталады.
Dialogue: 0,0:05:03.38,0:05:07.64,Default,,0,0,0,,Және оны қалай пайдаланатыныңызға байланысты, ол орасан зор қуатты тудыруы мүмкін.
Dialogue: 0,0:05:07.72,0:05:09.68,Default,,0,0,0,,Бәрі де мүмкін
Dialogue: 0,0:05:09.76,0:05:12.02,Default,,0,0,0,,Иә, мысалы, осы ойын
Dialogue: 0,0:05:12.64,0:05:14.85,Default,,0,0,0,,Мен мұны бірінші рет кездестірдім
Dialogue: 0,0:05:14.93,0:05:17.73,Default,,0,0,0,,Мен бұл сезімді түсіне алмадым.
Dialogue: 0,0:05:18.40,0:05:20.61,Default,,0,0,0,,Осы сезімнің шынайы болмысын іздеуде
Dialogue: 0,0:05:20.69,0:05:24.28,Default,,0,0,0,,Біз ұзақ сапардан кейін осы уақытқа дейін жеттік.
Dialogue: 0,0:05:25.32,0:05:28.99,Default,,0,0,0,,Бастапқыда жоспарланғаннан көп уақыт қажет болса да.
Dialogue: 0,0:05:29.49,0:05:30.66,Default,,0,0,0,,Әлі де...
Dialogue: 0,0:05:32.45,0:05:34.41,Default,,0,0,0,,Тек осы қылмысың үшін-ақ—
Dialogue: 0,0:05:37.21,0:05:40.63,Default,,0,0,0,,Олай болса, мен оның аяқталуын асыға күтемін.
Dialogue: 0,0:05:41.13,0:05:41.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:42.59,0:05:44.13,Default,,0,0,0,,Мамору (Мамору) Иә?
Dialogue: 0,0:05:44.21,0:05:45.34,Default,,0,0,0,,Қош бол
Dialogue: 0,0:05:45.42,0:05:46.22,Default,,0,0,0,,Дио жақын жерде.
Dialogue: 0,0:05:46.88,0:05:48.22,Default,,0,0,0,,Ах... ой...
Dialogue: 0,0:05:48.30,0:05:50.60,Default,,0,0,0,,Сен кімсің?
Dialogue: 0,0:05:50.68,0:05:52.64,Default,,0,0,0,,Мен және сен бір жерде...
Dialogue: 0,0:05:53.14,0:05:53.93,Default,,0,0,0,,Хехе
Dialogue: 0,0:05:54.68,0:05:55.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:57.35,0:05:58.73,Default,,0,0,0,,Хехехе
Dialogue: 0,0:05:59.35,0:06:00.15,Default,,0,0,0,,Дио жақын жерде.
Dialogue: 0,0:06:04.78,0:06:06.53,Default,,0,0,0,,Хмм… мм…
Dialogue: 0,0:06:09.16,0:06:09.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:10.20,0:06:10.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:10.99,0:06:11.66,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:12.28,0:06:13.83,Default,,0,0,0,,Уау...
Dialogue: 0,0:06:14.74,0:06:16.37,Default,,0,0,0,,Сіз есін жоғалттыңыз ба?
Dialogue: 0,0:06:17.62,0:06:18.33,Default,,0,0,0,,Ах
Dialogue: 0,0:06:19.92,0:06:21.92,Default,,0,0,0,,Иә? НЛО туралы не деуге болады?
Dialogue: 0,0:06:24.92,0:06:25.92,Default,,0,0,0,,Жоғалып кетті ме?
Dialogue: 0,0:06:26.51,0:06:28.80,Default,,0,0,0,,Бұл арман емес, солай ма?
Dialogue: 0,0:06:28.88,0:06:29.80,Default,,0,0,0,,О
Dialogue: 0,0:06:29.88,0:06:32.43,Default,,0,0,0,,Өтірік! Мен ештеңе көрмеймін
Dialogue: 0,0:06:34.81,0:06:35.81,Default,,0,0,0,,Ұстау
Dialogue: 0,0:06:37.10,0:06:38.68,Default,,0,0,0,,Рахмет, Морикун
Dialogue: 0,0:06:39.19,0:06:40.31,Default,,0,0,0,,Әпке!
Dialogue: 0,0:06:42.19,0:06:43.52,Default,,0,0,0,,Туя-чан!
Dialogue: 0,0:06:47.07,0:06:48.19,Default,,0,0,0,,Туя-чан?
Dialogue: 0,0:06:48.69,0:06:50.49,Default,,0,0,0,,Құрметті апа, мынау
Dialogue: 0,0:06:50.99,0:06:52.49,Default,,0,0,0,,Кисаның маған басын айналдыра ғашық болуын қамтамасыз етуім керек
Dialogue: 0,0:06:52.99,0:06:55.33,Default,,0,0,0,,Туя-чан, сен мені іздеп келдің бе?
Dialogue: 0,0:06:56.45,0:06:58.83,Default,,0,0,0,,(Пропеллердің айналу дыбысы)
Dialogue: 0,0:07:02.38,0:07:04.04,Default,,0,0,0,,Сіз келдіңіз бе?
Dialogue: 0,0:07:05.59,0:07:07.21,Default,,0,0,0,,Коно-чан! иә?
Dialogue: 0,0:07:07.30,0:07:08.34,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:08.42,0:07:09.92,Default,,0,0,0,,Коно-чан!
Dialogue: 0,0:07:10.01,0:07:11.68,Default,,0,0,0,,Мамокки~!
Dialogue: 0,0:07:11.76,0:07:13.85,Default,,0,0,0,,Мейко-сан Каори-сан!
Dialogue: 0,0:07:14.80,0:07:16.72,Default,,0,0,0,,Коно-чан
Dialogue: 0,0:07:16.81,0:07:19.48,Default,,0,0,0,,Мен уже уайымдадым.
Dialogue: 0,0:07:19.56,0:07:21.35,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:07:21.85,0:07:25.11,Default,,0,0,0,,Мамоккиді жеке кездестіргенімізге біраз болды.
Dialogue: 0,0:07:25.19,0:07:26.48,Default,,0,0,0,,Менің қалай сезініп жүргенімді елестетіп көр.
Dialogue: 0,0:07:26.57,0:07:27.98,Default,,0,0,0,,Әлі де кеш емес
Dialogue: 0,0:07:28.69,0:07:30.07,Default,,0,0,0,,Тынық мұхиты
Dialogue: 0,0:07:30.15,0:07:33.03,Default,,0,0,0,,Олар тіпті скрамжеттік ұшақты жалдады.
Dialogue: 0,0:07:33.11,0:07:35.07,Default,,0,0,0,,Бұл қанша тұрады деп ойлайсыз?
Dialogue: 0,0:07:35.16,0:07:37.37,Default,,0,0,0,,А, бұл менің белім.
Dialogue: 0,0:07:37.45,0:07:39.16,Default,,0,0,0,,үшінна!
Dialogue: 0,0:07:39.70,0:07:40.91,Default,,0,0,0,,Бүркімен! Бүркімен, бүркімен, бүркімен
Dialogue: 0,0:07:41.00,0:07:44.04,Default,,0,0,0,,Иә? Коно-чан, тыңдап тұрған жоқсың ба?
Dialogue: 0,0:07:44.96,0:07:48.30,Default,,0,0,0,,Мамору-кун барлығына хабарласты.
Dialogue: 0,0:07:48.38,0:07:49.96,Default,,0,0,0,,Өйткені Коно-чан қиыншылықта
Dialogue: 0,0:07:50.05,0:07:52.51,Default,,0,0,0,,Маған ойын жасауға көмектесіңізші
Dialogue: 0,0:07:53.05,0:07:53.93,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:07:54.01,0:07:57.14,Default,,0,0,0,,Эй, Мамокчи, сен не айтып тұрсың?
Dialogue: 0,0:07:57.22,0:08:01.85,Default,,0,0,0,,Мамору, сен мүлде өзгерген жоқсың, а?
Dialogue: 0,0:08:01.93,0:08:04.23,Default,,0,0,0,,Ах~ бел ите
Dialogue: 0,0:08:04.31,0:08:07.06,Default,,0,0,0,,Хахаха хехехе
Dialogue: 0,0:08:07.15,0:08:08.73,Default,,0,0,0,,Танжиро~!
Dialogue: 0,0:08:09.23,0:08:10.74,Default,,0,0,0,,Маған жеңіл қарама
Dialogue: 0,0:08:10.82,0:08:12.11,Default,,0,0,0,,Мамокки
Dialogue: 0,0:08:12.20,0:08:13.95,Default,,0,0,0,,Мамору~
Dialogue: 0,0:08:15.74,0:08:18.41,Default,,0,0,0,,Коно-чан мүлде өзгерген жоқ.
Dialogue: 0,0:08:19.49,0:08:20.87,Default,,0,0,0,,Жақсы
Dialogue: 0,0:08:22.00,0:08:25.67,Default,,0,0,0,,Коно-чан шынымен де біртүрлі бала.
Dialogue: 0,0:08:25.75,0:08:26.88,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:08:26.96,0:08:29.38,Default,,0,0,0,,Бұл әлдеқашан шешілді, солай ма?
Dialogue: 0,0:08:29.46,0:08:30.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:30.09,0:08:33.13,Default,,0,0,0,,Өйткені Коно-чан періште.
Dialogue: 0,0:08:35.97,0:08:37.35,Default,,0,0,0,,Коно-чан
Dialogue: 0,0:08:37.43,0:08:39.51,Default,,0,0,0,,Коно-чан жасаған ойындар
Dialogue: 0,0:08:39.60,0:08:42.27,Default,,0,0,0,,Біз сізге көмектесеміз бе?
Dialogue: 0,0:08:42.93,0:08:45.85,Default,,0,0,0,,Мен Коно-чанмен ойын жасағым келеді
Dialogue: 0,0:08:46.48,0:08:47.40,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:48.36,0:08:52.15,Default,,0,0,0,,Жарайды! Егер сіз мұны шешсеңіз, барлығы тікұшаққа отырыңыз.
Dialogue: 0,0:08:52.86,0:08:56.82,Default,,0,0,0,,90-шы жылдардағы алкогольсіз алкогольсіз сусындар қайта оралды!
Dialogue: 0,0:09:01.12,0:09:02.25,Default,,0,0,0,,Туя-чан!
Dialogue: 0,0:09:03.50,0:09:05.41,Default,,0,0,0,,Туя-чан, менімен келесің бе?
Dialogue: 0,0:09:08.21,0:09:10.04,Default,,0,0,0,,Кешіріңіз, әпке.
Dialogue: 0,0:09:10.54,0:09:13.59,Default,,0,0,0,,Әлі де атқарылуы қажет істер бар.
Dialogue: 0,0:09:13.67,0:09:16.05,Default,,0,0,0,,Мен осында қаламын
Dialogue: 0,0:09:16.72,0:09:18.14,Default,,0,0,0,,Ал сіздің әпкеңіз
Dialogue: 0,0:09:18.22,0:09:20.47,Default,,0,0,0,,Осындай іске араласқан маған
Dialogue: 0,0:09:20.55,0:09:22.60,Default,,0,0,0,,Менде сенімен ойын ойнау үшін біліктілігім жоқ...
Dialogue: 0,0:09:22.68,0:09:24.27,Default,,0,0,0,,Иә, егер сіз талапқа сай болсаңыз.
Dialogue: 0,0:09:24.85,0:09:27.19,Default,,0,0,0,,Өйткені сіз уәде бердіңіз.
Dialogue: 0,0:09:27.27,0:09:29.40,Default,,0,0,0,,«Келесі жолы бірге ойын жасайық»
Dialogue: 0,0:09:30.15,0:09:33.40,Default,,0,0,0,,Уәде Есіңізде ме?
Dialogue: 0,0:09:33.48,0:09:34.78,Default,,0,0,0,,Әрине, білемін.
Dialogue: 0,0:09:34.86,0:09:38.16,Default,,0,0,0,,Мен Туя-чанға берген уәдемді ұмыту мүмкін емес.
Dialogue: 0,0:09:38.24,0:09:40.62,Default,,0,0,0,,Сонымен, Туя-чан, менімен бірге жүр!
Dialogue: 0,0:09:42.29,0:09:44.45,Default,,0,0,0,,Кешіріңіз, әпке.
Dialogue: 0,0:09:44.54,0:09:47.96,Default,,0,0,0,,Мен қазір сенімен бара алмаймын.
Dialogue: 0,0:09:48.67,0:09:49.50,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:09:51.67,0:09:53.80,Default,,0,0,0,,Жағдай тынышталған кезде мен сізге міндетті түрде хабарласамын.
Dialogue: 0,0:09:54.46,0:09:59.26,Default,,0,0,0,,Мен әлі де сенімен ойын жасағым келеді.
Dialogue: 0,0:10:00.85,0:10:02.68,Default,,0,0,0,,Иә, түсіндім.
Dialogue: 0,0:10:02.76,0:10:04.93,Default,,0,0,0,,Мен сені күтемін, Туя-чан!
Dialogue: 0,0:10:12.52,0:10:14.69,Default,,0,0,0,,110 жедел қызмет нөмірі
Dialogue: 0,0:10:14.78,0:10:16.90,Default,,0,0,0,,Бұл оқиға ма? Бұл апат болды ма?
Dialogue: 0,0:10:16.99,0:10:18.61,Default,,0,0,0,,Менің атым Фуйя Ямада.
Dialogue: 0,0:10:19.16,0:10:22.58,Default,,0,0,0,,Акихабара стадионына мүмкіндігінше тезірек келе аласыз ба?
Dialogue: 0,0:10:22.66,0:10:24.74,Default,,0,0,0,,Я... Туя Ямада?
Dialogue: 0,0:10:25.54,0:10:26.95,Default,,0,0,0,,Сәлем Коно-чан
Dialogue: 0,0:10:27.04,0:10:30.25,Default,,0,0,0,,Бұрынғы адам Туя Ямада, солай ма?
Dialogue: 0,0:10:30.33,0:10:31.88,Default,,0,0,0,,Атқан жұлдыздар
Dialogue: 0,0:10:31.96,0:10:36.01,Default,,0,0,0,,Коно-чан, сен осындай атақты адамдарды білесің бе?
Dialogue: 0,0:10:36.88,0:10:41.30,Default,,0,0,0,,Туя-чан Коноханың сүйікті досы!
Dialogue: 0,0:10:44.56,0:10:46.47,Default,,0,0,0,,Бұл соңы
Dialogue: 0,0:10:46.56,0:10:48.23,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:10:48.31,0:10:50.19,Default,,0,0,0,,Ах~ бел ите
Dialogue: 0,0:10:50.27,0:10:51.98,Default,,0,0,0,,Жақсы жұмыс Цзянши
Dialogue: 0,0:10:52.06,0:10:55.52,Default,,0,0,0,,Мен реттеген барлық үстелдер мен компьютерлер осы.
Dialogue: 0,0:10:55.61,0:10:57.28,Default,,0,0,0,,Көмегіңе рахмет, әке.
Dialogue: 0,0:10:57.36,0:11:00.99,Default,,0,0,0,,Иә? Бірақ парта көп сияқты...
Dialogue: 0,0:11:01.07,0:11:03.12,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:11:03.20,0:11:05.08,Default,,0,0,0,,Мен кешігіп қалдым~ Ха!
Dialogue: 0,0:11:05.16,0:11:08.50,Default,,0,0,0,,Уау~ Бұл шынымен де Коно-чан.
Dialogue: 0,0:11:08.58,0:11:10.04,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:11:10.12,0:11:12.25,Default,,0,0,0,,Көп болды, Коноха-сан.
Dialogue: 0,0:11:12.33,0:11:13.75,Default,,0,0,0,,Тенчо-сан қазірдің өзінде осында...
Dialogue: 0,0:11:13.83,0:11:16.50,Default,,0,0,0,,Кикирара мырза Хашимото мырза
Dialogue: 0,0:11:16.59,0:11:18.13,Default,,0,0,0,,Бұл мәселе болды.
Dialogue: 0,0:11:18.21,0:11:20.01,Default,,0,0,0,,Сондықтан сіз бұл үшін кешірім сұрадыңыз.
Dialogue: 0,0:11:21.18,0:11:23.26,Default,,0,0,0,,Әңгіменің бәрі осы.
Dialogue: 0,0:11:23.34,0:11:27.06,Default,,0,0,0,,үшінмыз, ендігі кезекте Коно-чанға көмектесеміз.
Dialogue: 0,0:11:27.56,0:11:30.52,Default,,0,0,0,,Коно-чанның ойынын аяқтаймыз!
Dialogue: 0,0:11:30.60,0:11:32.52,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:12:11.31,0:12:13.14,Default,,0,0,0,,Ол аяқталды.
Dialogue: 0,0:12:13.23,0:12:14.15,Default,,0,0,0,,О
Dialogue: 0,0:12:14.77,0:12:16.23,Default,,0,0,0,,Ойын аяқталғаннан кейін
Dialogue: 0,0:12:16.31,0:12:18.82,Default,,0,0,0,,Әкелері аз уақытта үйлеріне қайтты.
Dialogue: 0,0:12:18.90,0:12:22.40,Default,,0,0,0,,Бірақ қайтадан бірге ойын жасау қызықты болды!
Dialogue: 0,0:12:23.07,0:12:26.95,Default,,0,0,0,,Мен уақыт кестесі туралы айтып бітірдім.
Dialogue: 0,0:12:27.03,0:12:30.54,Default,,0,0,0,,Иә, бірақ мен оны енді жасыра алмаймын.
Dialogue: 0,0:12:30.62,0:12:31.83,Default,,0,0,0,,Коноханың сыртқы түрі
Dialogue: 0,0:12:31.91,0:12:33.79,Default,,0,0,0,,Ол мүлде өзгерген жоқ.
Dialogue: 0,0:12:33.87,0:12:37.25,Default,,0,0,0,,Бірақ соңында бәрі маған қолымнан келгеннің бәрін істеуімді айтты.
Dialogue: 0,0:12:37.33,0:12:38.04,Default,,0,0,0,,О
Dialogue: 0,0:12:40.30,0:12:41.67,Default,,0,0,0,,мен зұлымдарды әділ сотқа тартуға тырысар ма едім?
Dialogue: 0,0:12:42.42,0:12:43.92,Default,,0,0,0,,Аяқталмаған нәрсе қалды ма?
Dialogue: 0,0:12:44.43,0:12:47.68,Default,,0,0,0,,Иә, мен істегім келгеннің бәрін жинадым.
Dialogue: 0,0:12:47.76,0:12:49.97,Default,,0,0,0,,Ах, бірақ бір ғана.
Dialogue: 0,0:12:50.47,0:12:51.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:54.23,0:12:57.94,Default,,0,0,0,,Соңында, Акихабара көшелерімен тағы бір рет серуендеуді қалайсыз ба?
Dialogue: 0,0:12:58.02,0:13:00.52,Default,,0,0,0,,Орындалмаған ештеңе қалмады.
Dialogue: 0,0:13:01.23,0:13:02.94,Default,,0,0,0,,бөліміне өтіңіз… Бұл біртүрлі ме?
Dialogue: 0,0:13:03.03,0:13:05.03,Default,,0,0,0,,Жоқ, сізге ұқсайды.
Dialogue: 0,0:13:05.53,0:13:06.61,Default,,0,0,0,,Осы балаға не болған екен…
Dialogue: 0,0:13:07.11,0:13:09.45,Default,,0,0,0,,Ойынды әкелгеніңізге сенімдісіз бе?
Dialogue: 0,0:13:10.03,0:13:12.79,Default,,0,0,0,,Қазірдің өзінде! Маған бала сияқты қарамаңыз
Dialogue: 0,0:13:12.87,0:13:15.25,Default,,0,0,0,,Мен оны дұрыстап әкелдім.
Dialogue: 0,0:13:15.33,0:13:16.12,Default,,0,0,0,,Кенеттен келгеніме кешірім өтінемін.
Dialogue: 0,0:13:18.13,0:13:21.05,Default,,0,0,0,,«Мен үшін не маңызды»?
Dialogue: 0,0:13:21.13,0:13:22.76,Default,,0,0,0,,Да… жоқ па?
Dialogue: 0,0:13:22.84,0:13:24.72,Default,,0,0,0,,Жоқ, бұл жақсы деп ойлаймын.
Dialogue: 0,0:13:25.72,0:13:28.39,Default,,0,0,0,,Сонымен қатар, мазмұны қызықты екеніне сенімдімін.
Dialogue: 0,0:13:28.47,0:13:29.26,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:29.35,0:13:32.18,Default,,0,0,0,,Дұрыс, мен саған қазір беремін.
Dialogue: 0,0:13:33.14,0:13:35.56,Default,,0,0,0,,Мұнда сізге қажет нәрсенің бәрі жазылған.
Dialogue: 0,0:13:36.14,0:13:38.77,Default,,0,0,0,,Оны маған 1999 жылы беріңіз.
Dialogue: 0,0:13:39.65,0:13:43.44,Default,,0,0,0,,Қалғаны 1999 жылғы менмін.
Dialogue: 0,0:13:43.53,0:13:45.74,Default,,0,0,0,,Мен олар бұл туралы бірдеңе істей алады деп үміттенемін.
Dialogue: 0,0:13:46.65,0:13:48.03,Default,,0,0,0,,Морикун
Dialogue: 0,0:13:49.24,0:13:50.57,Default,,0,0,0,,Бұл қиын емес пе?
Dialogue: 0,0:13:50.66,0:13:54.33,Default,,0,0,0,,20 жылдан астам тарихты өзіңіз бақылайсыз ба?
Dialogue: 0,0:13:56.21,0:13:59.21,Default,,0,0,0,,Аа, солай болады.
Dialogue: 0,0:14:02.25,0:14:04.30,Default,,0,0,0,,Мені аяма.
Dialogue: 0,0:14:04.38,0:14:05.13,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:14:06.59,0:14:08.72,Default,,0,0,0,,Маған да Акихабара ұнайды.
Dialogue: 0,0:14:09.47,0:14:11.39,Default,,0,0,0,,Сіз сияқты жақсы
Dialogue: 0,0:14:12.43,0:14:13.81,Default,,0,0,0,,Мамору-кун…
Dialogue: 0,0:14:13.89,0:14:17.98,Default,,0,0,0,,Демек, бұл сен екеуміздің арамыздағы жоспар.
Dialogue: 0,0:14:19.23,0:14:21.31,Default,,0,0,0,,Сіз істеу керек нәрсені жасадыңыз.
Dialogue: 0,0:14:21.40,0:14:22.73,Default,,0,0,0,,Қалғанын маған қалдырыңыз
Dialogue: 0,0:14:23.44,0:14:26.03,Default,,0,0,0,,Өзіңіз жасаған ойынға сеніңіз
Dialogue: 0,0:14:27.70,0:14:28.24,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:29.32,0:14:31.99,Default,,0,0,0,,Акихабара таза және дүкендер жоқ.
Dialogue: 0,0:14:32.07,0:14:34.49,Default,,0,0,0,,Түні бойы жұмыс істегенде, бірден ұйықтап кеттің.
Dialogue: 0,0:14:34.58,0:14:35.87,Default,,0,0,0,,Е... бұл дұрыс емес.
Dialogue: 0,0:14:35.95,0:14:38.12,Default,,0,0,0,,Сіз 98-ге (Кюухачи) қол тигізбедіңіз бе?
Dialogue: 0,0:14:38.21,0:14:39.29,Default,,0,0,0,,Мен оған тиіскен жоқпын!
Dialogue: 0,0:14:39.37,0:14:41.67,Default,,0,0,0,,Сіз мүлде өспейсіз.
Dialogue: 0,0:14:41.75,0:14:43.29,Default,,0,0,0,,Не~!
Dialogue: 0,0:14:43.38,0:14:45.13,Default,,0,0,0,,Уф!
Dialogue: 0,0:14:52.39,0:14:53.35,Default,,0,0,0,,Сіз келдіңіз.
Dialogue: 0,0:14:54.39,0:14:56.35,Default,,0,0,0,,Олай болса сәттілік.
Dialogue: 0,0:14:56.43,0:14:57.22,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:03.98,0:15:05.86,Default,,0,0,0,,Сәлем, Морикун
Dialogue: 0,0:15:05.94,0:15:07.36,Default,,0,0,0,,Иә?Не?
Dialogue: 0,0:15:07.44,0:15:11.24,Default,,0,0,0,,Коноха Енді 1999 жылға өтіңіз
Dialogue: 0,0:15:11.32,0:15:12.62,Default,,0,0,0,,Өзгерістер журналы
Dialogue: 0,0:15:12.70,0:15:16.08,Default,,0,0,0,,Ал біз 2023 жылы қайтамыз, солай ма?
Dialogue: 0,0:15:16.16,0:15:19.58,Default,,0,0,0,,Ал... сонда, 2023 жылы, мен қайтқанда.
Dialogue: 0,0:15:19.66,0:15:22.00,Default,,0,0,0,,Мори-кунмен тағы кездессем...
Dialogue: 0,0:15:23.92,0:15:25.79,Default,,0,0,0,,Қамқоршы
Dialogue: 0,0:15:25.88,0:15:29.88,Default,,0,0,0,,Сіз қазір мұндағы Морикун сияқтысыз ба?
Dialogue: 0,0:15:31.59,0:15:33.64,Default,,0,0,0,,Дәлірек айтқанда, бұл басқа адам.
Dialogue: 0,0:15:33.72,0:15:36.01,Default,,0,0,0,,Ал... онда...
Dialogue: 0,0:15:36.10,0:15:40.35,Default,,0,0,0,,Бүгінге дейін болған оқиғаны және осы әңгімені ұмытасың ба?
Dialogue: 0,0:15:40.43,0:15:44.98,Default,,0,0,0,,Коноха мен қазір сөйлесіп отырған Мамору-кунды ұмыта ма?
Dialogue: 0,0:15:45.77,0:15:48.53,Default,,0,0,0,,А, солай шығар.
Dialogue: 0,0:15:49.32,0:15:50.57,Default,,0,0,0,,Бұл...
Dialogue: 0,0:15:52.95,0:15:57.49,Default,,0,0,0,,Мен Коноханы ұмытқым келмейді.
Dialogue: 0,0:16:00.08,0:16:01.46,Default,,0,0,0,,Мен ұмытпаймын
Dialogue: 0,0:16:02.04,0:16:02.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:03.92,0:16:06.88,Default,,0,0,0,,Жаңғырық деген жігітпен болғанымда сөйлесетінбіз.
Dialogue: 0,0:16:07.54,0:16:09.55,Default,,0,0,0,,Адамдар - жылу шарлары.
Dialogue: 0,0:16:10.55,0:16:11.38,Default,,0,0,0,,Қызба?
Dialogue: 0,0:16:11.47,0:16:14.76,Default,,0,0,0,,А, жылу - бұл барлық мүмкіндік.
Dialogue: 0,0:16:15.76,0:16:17.30,Default,,0,0,0,,Сондықтан мен ұмытпаймын
Dialogue: 0,0:16:17.93,0:16:20.85,Default,,0,0,0,,Бізде қызба болса, біз ешқашан ұмытпаймыз
Dialogue: 0,0:16:22.85,0:16:27.36,Default,,0,0,0,,Сіз оны қолданып көргіңіз келе ме? Бір-біріңді есіңе түсіресің бе?
Dialogue: 0,0:16:33.70,0:16:35.20,Default,,0,0,0,,Иә, жақсы!
Dialogue: 0,0:16:35.28,0:16:37.53,Default,,0,0,0,,Бүгінгі күнді ешқашан ұмытпаймын
Dialogue: 0,0:16:38.03,0:16:40.74,Default,,0,0,0,,Жоқ, бұл тек бүгінгі күн туралы емес.
Dialogue: 0,0:16:40.83,0:16:43.91,Default,,0,0,0,,Мамору-кунмен істегенімнің барлығы!
Dialogue: 0,0:16:44.54,0:16:45.12,Default,,0,0,0,,О
Dialogue: 0,0:16:46.58,0:16:48.46,Default,,0,0,0,,Олай болса, Морикун.
Dialogue: 0,0:16:51.92,0:16:52.76,Default,,0,0,0,,Жақында кездескенше
Dialogue: 0,0:16:59.51,0:17:01.35,Default,,0,0,0,,Матана Коноха
Dialogue: 0,0:17:10.82,0:17:13.82,Default,,0,0,0,,Бұл шынымен де соңғы сәт.
Dialogue: 0,0:17:13.90,0:17:16.24,Default,,0,0,0,,«Күлкілі кеш»
Dialogue: 0,0:17:16.32,0:17:19.03,Default,,0,0,0,,Жарайды, сеніңіз.
Dialogue: 0,0:17:19.53,0:17:21.33,Default,,0,0,0,,Маған көмектескендердің барлығына
Dialogue: 0,0:17:21.41,0:17:24.04,Default,,0,0,0,,Өзіңізді қорғаңыз!
Dialogue: 0,0:17:24.62,0:17:28.08,Default,,0,0,0,,Батырлар курсы: Дэнки Камина!
Dialogue: 0,0:18:15.76,0:18:16.63,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:17.67,0:18:19.76,Default,,0,0,0,,Сондай-ақ... қайтып келдіңіз бе?
Dialogue: 0,0:18:23.14,0:18:23.81,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:26.39,0:18:30.23,Default,,0,0,0,,Коноханың... Коноханың білетін Акибасының...
Dialogue: 0,0:18:33.48,0:18:35.65,Default,,0,0,0,,Мен қайтып келдім!
Dialogue: 0,0:18:37.03,0:18:38.32,Default,,0,0,0,,...
Dialogue: 0,0:18:39.45,0:18:40.24,Default,,0,0,0,,Не!
Dialogue: 0,0:18:40.32,0:18:44.08,Default,,0,0,0,,Иә! Керемет нәрсе болып жатыр!
Dialogue: 0,0:18:44.58,0:18:47.25,Default,,0,0,0,,Акихабараға қош келдіңіз!
Dialogue: 0,0:18:47.33,0:18:48.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:48.66,0:18:49.41,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:49.50,0:18:53.00,Default,,0,0,0,,Дұрыс, алкогольді алкогольсіз сусындар... Алкогольсіз алкогольсіз сусындар...
Dialogue: 0,0:18:57.55,0:19:02.97,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:19:03.89,0:19:05.68,Default,,0,0,0,,Электр қуаты жоқ
Dialogue: 0,0:19:06.52,0:19:07.81,Default,,0,0,0,,…қашып кету…
Dialogue: 0,0:19:08.39,0:19:09.73,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:19:09.81,0:19:10.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:10.56,0:19:13.23,Default,,0,0,0,,Уау! президент!
Dialogue: 0,0:19:13.31,0:19:14.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:14.15,0:19:16.73,Default,,0,0,0,,Аа, дұрыс!
Dialogue: 0,0:19:16.82,0:19:18.65,Default,,0,0,0,,Мен бұл туралы мүлдем ұмытып кеттім
Dialogue: 0,0:19:18.74,0:19:21.36,Default,,0,0,0,,Бастапқыда 2023 жылы осында
Dialogue: 0,0:19:21.45,0:19:23.24,Default,,0,0,0,,Бұл көк қоңырау болды...
Dialogue: 0,0:19:24.78,0:19:25.58,Default,,0,0,0,,Президент!
Dialogue: 0,0:19:25.66,0:19:27.91,Default,,0,0,0,,Коноха Бұл таңғажайып тәжірибе болды!
Dialogue: 0,0:19:28.00,0:19:30.71,Default,,0,0,0,,Ойындардың күші зор!
Dialogue: 0,0:19:30.79,0:19:34.67,Default,,0,0,0,,Коноха Мен кез келген ойынды жасауға бар күшімді саламын деп ойладым.
Dialogue: 0,0:19:34.75,0:19:36.96,Default,,0,0,0,,Коноха жасайды, президент!
Dialogue: 0,0:19:37.05,0:19:39.88,Default,,0,0,0,,Иә? Сен не туралы айтып тұрсың?
Dialogue: 0,0:19:39.97,0:19:41.43,Default,,0,0,0,,Сіз не туралы айтып отырсыз...
Dialogue: 0,0:19:41.51,0:19:45.01,Default,,0,0,0,,Қараңдар, мен Bluebell-дің жаңа ойыны туралы айтып отырмын.
Dialogue: 0,0:19:45.10,0:19:48.14,Default,,0,0,0,,Көк қоңырау? Біздің компания ше?
Dialogue: 0,0:19:48.22,0:19:50.60,Default,,0,0,0,,Біз ойын ойнамаймыз.
Dialogue: 0,0:19:50.68,0:19:51.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:51.64,0:19:52.31,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:19:53.56,0:19:56.82,Default,,0,0,0,,Сәлеметсіз бе... Bluebell кафесі тұрмысқа шықты ма?
Dialogue: 0,0:19:56.90,0:20:01.53,Default,,0,0,0,,А, мүмкін ойын компаниясы алкогольдік бағдарламалық қамтамасыз ету компаниясы шығар?
Dialogue: 0,0:20:01.61,0:20:04.49,Default,,0,0,0,,Алкоголь жұмсақ? Біреу бар ма? мұнда
Dialogue: 0,0:20:04.57,0:20:06.49,Default,,0,0,0,,Бұрын
Dialogue: 0,0:20:06.58,0:20:08.24,Default,,0,0,0,,Енді ойын хит болды.
Dialogue: 0,0:20:08.33,0:20:10.33,Default,,0,0,0,,үшін Америкаға кетті.
Dialogue: 0,0:20:10.83,0:20:12.87,Default,,0,0,0,,Тіпті алкогольсіз алкогольсіз сусындар сөнгеннен кейін де
Dialogue: 0,0:20:12.96,0:20:16.00,Default,,0,0,0,,Басқа ойын компаниясы бүкіл ғимаратты сатып алды.
Dialogue: 0,0:20:16.08,0:20:18.88,Default,,0,0,0,,Хехе, бұл экономика үшін жақсы жаңалық.
Dialogue: 0,0:20:18.96,0:20:22.17,Default,,0,0,0,,Мен де бір ойын жасап едім ғой.
Dialogue: 0,0:20:22.26,0:20:23.63,Default,,0,0,0,,Маған жеңіл қарама
Dialogue: 0,0:20:25.34,0:20:28.01,Default,,0,0,0,,Меніңше, Америкада бәрі бар ма?
Dialogue: 0,0:20:28.60,0:20:30.52,Default,,0,0,0,,Дұрыс, солай емес пе?
Dialogue: 0,0:20:33.02,0:20:34.06,Default,,0,0,0,,Жақсы
Dialogue: 0,0:20:34.69,0:20:36.27,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:20:36.90,0:20:39.19,Default,,0,0,0,,Коноханың қалағаны осы еді.
Dialogue: 0,0:20:39.78,0:20:41.82,Default,,0,0,0,,Рахмет, Морикун
Dialogue: 0,0:20:42.32,0:20:42.90,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:43.61,0:20:46.16,Default,,0,0,0,,Коноха есімде
Dialogue: 0,0:20:47.16,0:20:50.95,Default,,0,0,0,,Мамору-кунның бәрі есімде!
Dialogue: 0,0:20:53.37,0:20:55.04,Default,,0,0,0,,Рахмет, Морикун
Dialogue: 0,0:20:55.67,0:21:00.42,Default,,0,0,0,,Коноха Акихабарада ойын ойнап жатыр!
Dialogue: 0,0:21:01.05,0:21:04.26,Default,,0,0,0,,Мәңгі... мәңгілік!
Dialogue: 0,0:21:06.30,0:21:09.60,Default,,0,0,0,,Не істеу керек?
Dialogue: 0,0:21:09.68,0:21:12.68,Default,,0,0,0,,Bluebell үйленген әйелдің кафесіне айналды...
Dialogue: 0,0:21:12.77,0:21:13.81,Default,,0,0,0,,(98 іске қосу дыбысы)
Dialogue: 0,0:21:18.86,0:21:19.65,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:21:22.40,0:21:24.74,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:21:29.45,0:21:31.91,Default,,0,0,0,,20 жыл бойы ешкім ойын жасамаса ше?
Dialogue: 0,0:21:32.41,0:21:35.46,Default,,0,0,0,,Мұндай шағын компанияны ұстау қиын.
Dialogue: 0,0:21:36.71,0:21:38.46,Default,,0,0,0,,Сіз мені ұзақ күттіңіз.
Dialogue: 0,0:21:40.25,0:21:42.38,Default,,0,0,0,,Енді ойын құрастырайық.
Dialogue: 0,0:21:43.30,0:21:44.46,Default,,0,0,0,,Мамору-кун…
Dialogue: 0,0:21:46.55,0:21:47.80,Default,,0,0,0,,Мамору-кун!
Dialogue: 0,0:21:48.80,0:21:52.18,Default,,0,0,0,,Қорғаңыз!
Dialogue: 0,0:21:53.39,0:21:54.22,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:21:55.68,0:22:00.02,Default,,0,0,0,,(Коноханың айқайы)
Dialogue: 0,0:22:04.69,0:22:05.44,Default,,0,0,0,,Коноха
Dialogue: 0,0:22:07.70,0:22:10.57,Default,,0,0,0,,Бірге ойын жасағыларың келе ме?
Dialogue: 0,0:22:10.66,0:22:12.66,Default,,0,0,0,,♪～
Dialogue: 0,0:22:15.37,0:22:16.12,Default,,0,0,0,,Иә!
Dialogue: 0,0:23:36.03,0:23:38.04,Default,,0,0,0,,～♪
Dialogue: 0,0:23:39.54,0:23:45.54,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
