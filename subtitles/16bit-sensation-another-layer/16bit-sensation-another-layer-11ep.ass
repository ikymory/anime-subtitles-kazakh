Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.08,0:00:04.04,Default,,0,0,0,,Қазір 2023 жылы
Dialogue: 0,0:00:04.12,0:00:07.42,Default,,0,0,0,,Өзіңіз білетін 2023 жыл ағынын жасаңыз
Dialogue: 0,0:00:07.50,0:00:10.01,Default,,0,0,0,,Бір уақытта екі тарихты белгілеу
Dialogue: 0,0:00:10.51,0:00:12.59,Default,,0,0,0,,Бұл өткен менмен бетпе-бет келу.
Dialogue: 0,0:00:13.17,0:00:14.51,Default,,0,0,0,,Сіз жеңе аласыз ба?
Dialogue: 0,0:00:16.26,0:00:18.10,Default,,0,0,0,,Түсіндім, Морикун.
Dialogue: 0,0:00:18.97,0:00:21.93,Default,,0,0,0,,Коноха, бар күшіңізді салыңыз!
Dialogue: 0,0:00:22.68,0:00:26.10,Default,,0,0,0,,(Пернетақта пернесінің дыбысы)
Dialogue: 0,0:00:37.91,0:00:39.91,Default,,0,0,0,,Эй, Мамору (Мамору)?
Dialogue: 0,0:00:39.99,0:00:44.16,Default,,0,0,0,,Сіз тек Мамору екеумізбен ойын жасаймын дедіңіз.
Dialogue: 0,0:00:44.25,0:00:47.75,Default,,0,0,0,,Ойын жасау үшін сценарий мен музыка керек.
Dialogue: 0,0:00:47.83,0:00:49.96,Default,,0,0,0,,Тіпті жүздеген иллюстрациялар қажет.
Dialogue: 0,0:00:50.59,0:00:52.80,Default,,0,0,0,,Қалайша екеуміз ғана болдық...
Dialogue: 0,0:00:53.30,0:00:56.55,Default,,0,0,0,,Жүйені қолдаудан басқа, мен де көмектесе алмаймын.
Dialogue: 0,0:00:56.63,0:00:58.14,Default,,0,0,0,,Өйткені мен бағдарламашымын
Dialogue: 0,0:00:58.22,0:01:00.51,Default,,0,0,0,,Оны өзіңіз жасаудан басқа амалыңыз жоқ.
Dialogue: 0,0:01:00.60,0:01:01.89,Default,,0,0,0,,Уф!
Dialogue: 0,0:01:01.97,0:01:05.10,Default,,0,0,0,,Уф... бұл тым абайсызда.
Dialogue: 0,0:01:05.19,0:01:07.02,Default,,0,0,0,,Ойын жасау да дамып келеді.
Dialogue: 0,0:01:07.52,0:01:08.94,Default,,0,0,0,,Егер сіз оны қазір жасағыңыз келсе
Dialogue: 0,0:01:09.02,0:01:11.48,Default,,0,0,0,,Енді мен өз бетімше ойындар жасай аламын
Dialogue: 0,0:01:11.57,0:01:13.19,Default,,0,0,0,,AI арқасында
Dialogue: 0,0:01:13.28,0:01:15.61,Default,,0,0,0,,А... AI?
Dialogue: 0,0:01:16.99,0:01:18.99,Default,,0,0,0,,♪～
Dialogue: 0,0:02:42.66,0:02:44.66,Default,,0,0,0,,～♪
Dialogue: 0,0:02:50.00,0:02:52.13,Default,,0,0,0,,Бүгінгі ойындардағы иллюстрациялардың көпшілігі
Dialogue: 0,0:02:52.21,0:02:53.96,Default,,0,0,0,,AI мұны сіз үшін жасайды.
Dialogue: 0,0:02:54.04,0:02:55.59,Default,,0,0,0,,А, бұл!
Dialogue: 0,0:02:55.67,0:02:57.92,Default,,0,0,0,,Иә, бұл сіздің баяғыда салған суретіңіз.
Dialogue: 0,0:02:58.42,0:03:00.76,Default,,0,0,0,,AI-ға мұны үйренуге мүмкіндік беріңіз
Dialogue: 0,0:03:00.84,0:03:03.39,Default,,0,0,0,,Мамору-кун!
Dialogue: 0,0:03:03.47,0:03:04.80,Default,,0,0,0,,(Ино Хацусе) Қош келдіңіздер, Элькия патшасы, Лорд Сора, Лорд Широ.
Dialogue: 0,0:03:04.89,0:03:07.81,Default,,0,0,0,,Бұл AI мен жасаған және жеке.
Dialogue: 0,0:03:07.89,0:03:09.85,Default,,0,0,0,,Сыртқы әлемге ашылмаған
Dialogue: 0,0:03:10.85,0:03:13.02,Default,,0,0,0,,Бұл сурет жүктелгенде...
Dialogue: 0,0:03:13.73,0:03:17.32,Default,,0,0,0,,АИ талдап, ұқсас суретті жасайды.
Dialogue: 0,0:03:17.82,0:03:20.24,Default,,0,0,0,,Уау! Бұл керемет!
Dialogue: 0,0:03:20.32,0:03:22.41,Default,,0,0,0,,Суретті оңай өзгертуге болады
Dialogue: 0,0:03:22.91,0:03:24.57,Default,,0,0,0,,Жалпы иллюстрациялық бояудан...
Dialogue: 0,0:03:25.24,0:03:26.58,Default,,0,0,0,,Аниме бояуы Ах!
Dialogue: 0,0:03:26.66,0:03:28.33,Default,,0,0,0,,Акварель сияқты нәрселерді де жасауға болады.
Dialogue: 0,0:03:28.41,0:03:29.45,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:03:29.54,0:03:32.67,Default,,0,0,0,,Сызбадағы қателерді автоматты түрде түзетеді
Dialogue: 0,0:03:32.75,0:03:35.13,Default,,0,0,0,,Е! Өте пайдалы!
Dialogue: 0,0:03:35.21,0:03:36.71,Default,,0,0,0,,Суреттер ғана емес
Dialogue: 0,0:03:36.79,0:03:39.51,Default,,0,0,0,,Ойын жасауға қажетті әңгімелер мен музыка
Dialogue: 0,0:03:39.59,0:03:41.38,Default,,0,0,0,,AI сізге көмектеседі
Dialogue: 0,0:03:42.22,0:03:44.39,Default,,0,0,0,,Бұл әдіс AI көмегімен
Dialogue: 0,0:03:44.47,0:03:46.80,Default,,0,0,0,,Ол қазір ойын жасаудың негізгі ағымына айналды.
Dialogue: 0,0:03:47.31,0:03:49.68,Default,,0,0,0,,Осы арқылы сіз өз бетіңізше ойын жасай аласыз.
Dialogue: 0,0:03:50.18,0:03:54.31,Default,,0,0,0,,Егер AI осы деңгейге дейін дамыған болса, адамның араласуының қажеті болмайды.
Dialogue: 0,0:03:54.40,0:03:56.65,Default,,0,0,0,,Сіз жай ғана ойын жасай алмайсыз ба?
Dialogue: 0,0:03:56.73,0:03:57.94,Default,,0,0,0,,Әрине
Dialogue: 0,0:03:58.02,0:04:01.32,Default,,0,0,0,,Ағымдағы ойын жасау тұтастай осы бағытта қозғалады.
Dialogue: 0,0:04:01.82,0:04:05.45,Default,,0,0,0,,Дегенмен, AI дамып жатса да, әлі де жасалмайтын нәрселер бар.
Dialogue: 0,0:04:05.95,0:04:07.74,Default,,0,0,0,,Мұның не екенін білесіз бе?
Dialogue: 0,0:04:08.28,0:04:09.24,Default,,0,0,0,,Э~?
Dialogue: 0,0:04:09.33,0:04:11.20,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:04:11.70,0:04:12.58,Default,,0,0,0,,Бұл безгегі.
Dialogue: 0,0:04:13.08,0:04:18.25,Default,,0,0,0,,AI жоғары сапалы жұмыстарды тез және арзан жасайды
Dialogue: 0,0:04:18.34,0:04:20.13,Default,,0,0,0,,Бірақ ол жерде жылу жоқ
Dialogue: 0,0:04:20.84,0:04:22.26,Default,,0,0,0,,AI бар
Dialogue: 0,0:04:22.34,0:04:24.68,Default,,0,0,0,,Ойындар жасаудың себептері
Dialogue: 0,0:04:24.76,0:04:27.93,Default,,0,0,0,,Мазмұн бойынша қақтығыс немесе қорқыныш жоқ
Dialogue: 0,0:04:28.01,0:04:30.89,Default,,0,0,0,,Тек бұйрықты адал орындаңыз
Dialogue: 0,0:04:31.43,0:04:32.31,Default,,0,0,0,,Нәтижелер
Dialogue: 0,0:04:32.39,0:04:34.19,Default,,0,0,0,,Жаратушының құмарлығын сезінбейтін ойын.
Dialogue: 0,0:04:34.27,0:04:35.52,Default,,0,0,0,,Аяқталды
Dialogue: 0,0:04:35.60,0:04:39.02,Default,,0,0,0,,Тіпті ең қызықсыз ойындар да сатылуы мүмкін.
Dialogue: 0,0:04:39.52,0:04:41.53,Default,,0,0,0,,Өйткені ол өте толық көрінеді.
Dialogue: 0,0:04:42.03,0:04:46.24,Default,,0,0,0,,Сондықтан бүгінгі әлем АИ жасаған ойындарға толы.
Dialogue: 0,0:04:47.45,0:04:49.03,Default,,0,0,0,,Хааа~
Dialogue: 0,0:04:49.12,0:04:52.20,Default,,0,0,0,,Мейко және басқалары әлі де олардың көпшілігін қолмен жасауда.
Dialogue: 0,0:04:52.91,0:04:56.79,Default,,0,0,0,,Бірақ бізге қазір керек нәрсе ойын емес.
Dialogue: 0,0:04:57.29,0:04:59.21,Default,,0,0,0,,Уақытты өзгертетін ойын.
Dialogue: 0,0:04:59.29,0:05:01.75,Default,,0,0,0,,AI жалғыз мұндай нәрсені жасай алмайды.
Dialogue: 0,0:05:01.84,0:05:03.84,Default,,0,0,0,,Бізге адам күші керек
Dialogue: 0,0:05:04.42,0:05:07.68,Default,,0,0,0,,Басқаша айтқанда, оны жасаудан басқа амалыңыз жоқ.
Dialogue: 0,0:05:07.76,0:05:12.18,Default,,0,0,0,,Ух... у... қысым...
Dialogue: 0,0:05:12.77,0:05:14.43,Default,,0,0,0,,Жарайды, бұлай пессимистік болмаңыз.
Dialogue: 0,0:05:15.10,0:05:18.35,Default,,0,0,0,,Қазір шаршауды қалпына келтіруге арналған көптеген элементтер бар.
Dialogue: 0,0:05:18.44,0:05:19.44,Default,,0,0,0,,Жақсы мүмкіндік, сондықтан мәселені түпкілікті анықтап алайық.
Dialogue: 0,0:05:20.44,0:05:22.11,Default,,0,0,0,,Массаж функциясы бар кеңсе креслосы!
Dialogue: 0,0:05:22.19,0:05:23.94,Default,,0,0,0,,Бұл өте қиын қозғалады!
Dialogue: 0,0:05:24.53,0:05:26.36,Default,,0,0,0,,Мамонт энергиясы ұйқыңызды кетіреді!
Dialogue: 0,0:05:26.45,0:05:28.07,Default,,0,0,0,,Бұл ессіз түс!
Dialogue: 0,0:05:28.99,0:05:30.91,Default,,0,0,0,,Менің күйзелісім тылсым күш арқылы нөлге дейін төмендейді.
Dialogue: 0,0:05:30.99,0:05:32.37,Default,,0,0,0,,Бақытты қоспалар!
Dialogue: 0,0:05:32.45,0:05:35.08,Default,,0,0,0,,Жиынтық ретінде қосымша инесі жоқ шприц туралы не деуге болады?
Dialogue: 0,0:05:35.16,0:05:37.58,Default,,0,0,0,,Бәрі жақсы ма? бұл!
Dialogue: 0,0:05:37.67,0:05:41.63,Default,,0,0,0,,Бұл...артық пайдаланылған сияқты бірнеше заттар...
Dialogue: 0,0:05:41.71,0:05:43.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:44.42,0:05:46.05,Default,,0,0,0,,Осыншама ұзақ па?
Dialogue: 0,0:05:48.13,0:05:51.14,Default,,0,0,0,,Мұндағы құлыпты саусақ ізі аутентификациясы арқылы ашуға болады.
Dialogue: 0,0:05:51.72,0:05:54.06,Default,,0,0,0,,Сыртқа шыққыңыз келсе, рұқсатсыз шығуға болады.
Dialogue: 0,0:05:54.14,0:05:55.89,Default,,0,0,0,,Мұнда басқа адамдарға рұқсат етілмейді.
Dialogue: 0,0:05:56.39,0:05:59.31,Default,,0,0,0,,Сондай-ақ, 98 (Кюухачи) сөресіне жақындамаңыз.
Dialogue: 0,0:05:59.85,0:06:02.07,Default,,0,0,0,,98 сезімтал
Dialogue: 0,0:06:02.15,0:06:04.69,Default,,0,0,0,,Мен оған тиіспеймін...
Dialogue: 0,0:06:04.78,0:06:06.24,Default,,0,0,0,,Онда мен шығамын.
Dialogue: 0,0:06:06.32,0:06:08.45,Default,,0,0,0,,Е, Мамору-кун, шығасың ба?
Dialogue: 0,0:06:08.53,0:06:09.86,Default,,0,0,0,,Қайда?
Dialogue: 0,0:06:09.95,0:06:11.12,Default,,0,0,0,,Бұл жұмыс.
Dialogue: 0,0:06:11.62,0:06:13.95,Default,,0,0,0,,Мен мазмұнды басқаратынымды айттым ба?
Dialogue: 0,0:06:14.04,0:06:15.75,Default,,0,0,0,,Мен басқаруға жауаптымын.
Dialogue: 0,0:06:15.83,0:06:18.66,Default,,0,0,0,,Менің әкем сияқты қарыз болайын деген ойым жоқ.
Dialogue: 0,0:06:18.75,0:06:20.04,Default,,0,0,0,,Аха…
Dialogue: 0,0:06:20.12,0:06:21.42,Default,,0,0,0,,Я~
Dialogue: 0,0:06:21.50,0:06:24.71,Default,,0,0,0,,Мамору-кун да кәмелетке толған.
Dialogue: 0,0:06:24.80,0:06:26.38,Default,,0,0,0,,Жоғарыдан бірдеңе айтпа.
Dialogue: 0,0:06:26.46,0:06:27.22,Default,,0,0,0,,Мен айтамын!
Dialogue: 0,0:06:27.80,0:06:28.55,Default,,0,0,0,,Өйткені I
Dialogue: 0,0:06:28.63,0:06:31.97,Default,,0,0,0,,Мен Мамору-кунды жас кезінен білемін.
Dialogue: 0,0:06:32.05,0:06:35.64,Default,,0,0,0,,Ол кезде мен жеккөрінішті бала едім.
Dialogue: 0,0:06:35.72,0:06:37.73,Default,,0,0,0,,Бұл соншалықты кішкентай емес еді, солай ма?
Dialogue: 0,0:06:37.81,0:06:40.23,Default,,0,0,0,,Біз алғаш танысқанда мен 15 жаста едім.
Dialogue: 0,0:06:40.31,0:06:43.02,Default,,0,0,0,,Әй, енді ойлап қарасам, Мамору-кун.
Dialogue: 0,0:06:43.11,0:06:45.19,Default,,0,0,0,,Осы уақыт бойы жалғыз өмір сүрдіңіз бе? Мұнда?
Dialogue: 0,0:06:45.82,0:06:46.40,Default,,0,0,0,,О
Dialogue: 0,0:06:46.90,0:06:49.49,Default,,0,0,0,,Бұл пәтерде тұру қызық емес.
Dialogue: 0,0:06:50.15,0:06:51.49,Default,,0,0,0,,Олардың көпшілігі осында.
Dialogue: 0,0:06:51.99,0:06:53.53,Default,,0,0,0,,Жалғыз ба?
Dialogue: 0,0:06:54.03,0:06:55.03,Default,,0,0,0,,Ишишиши
Dialogue: 0,0:06:55.12,0:06:56.16,Default,,0,0,0,,Жаттығуға жарайды, білесің бе.
Dialogue: 0,0:06:56.24,0:06:57.83,Default,,0,0,0,,А... жоқ!
Dialogue: 0,0:06:57.91,0:06:59.41,Default,,0,0,0,,Біртүрлі емес
Dialogue: 0,0:06:59.50,0:07:01.58,Default,,0,0,0,,Мамору-кун күткендей!
Dialogue: 0,0:07:02.50,0:07:03.63,Default,,0,0,0,,Хаа…
Dialogue: 0,0:07:03.71,0:07:05.92,Default,,0,0,0,,Онда мен қазір барамын.
Dialogue: 0,0:07:06.00,0:07:07.26,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:07.34,0:07:09.76,Default,,0,0,0,,Қош келдіңіз, хехехе
Dialogue: 0,0:07:10.26,0:07:11.34,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:07:12.09,0:07:14.43,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:07:21.31,0:07:24.81,Default,,0,0,0,,(Қоңырау үні)
Dialogue: 0,0:07:29.32,0:07:31.74,Default,,0,0,0,,Қалдарыңыз қалай?
Dialogue: 0,0:07:31.82,0:07:35.74,Default,,0,0,0,,Дұрыс, қызым ақыры университетке түсу емтиханын тапсырады.
Dialogue: 0,0:07:36.33,0:07:36.95,Default,,0,0,0,,Бұл жылдам, солай емес пе?
Dialogue: 0,0:07:37.03,0:07:38.45,Default,,0,0,0,,Ух... (Мамору) А?
Dialogue: 0,0:07:38.54,0:07:41.37,Default,,0,0,0,,Бұл мүмкін емес!
Dialogue: 0,0:07:41.46,0:07:43.50,Default,,0,0,0,,Бірнеше күн болды.
Dialogue: 0,0:07:43.58,0:07:46.13,Default,,0,0,0,,Өйткені бұл тарихты өзгертетін ойын.
Dialogue: 0,0:07:46.21,0:07:48.13,Default,,0,0,0,,Мен оны ешқашан жасаған емеспін!
Dialogue: 0,0:07:48.63,0:07:53.89,Default,,0,0,0,,Бұл 1 миллиард иен жасайтын ойын жасаудан әлдеқайда қиын!
Dialogue: 0,0:07:53.97,0:07:56.60,Default,,0,0,0,,Басында мен мұны істей аламын деп ойладым.
Dialogue: 0,0:07:56.68,0:07:59.60,Default,,0,0,0,,Сіз не ойласаңыз да, бұл мүлдем пайдасыз!
Dialogue: 0,0:08:00.10,0:08:03.48,Default,,0,0,0,,Мен соңғы ойында бар талантымды жұмсадым!
Dialogue: 0,0:08:03.56,0:08:05.81,Default,,0,0,0,,Бұл бір соққының кереметі!
Dialogue: 0,0:08:05.90,0:08:09.73,Default,,0,0,0,,Сіз ойын жасағыңыз келгендіктен уақыт бойына секірдіңіз, солай ма?
Dialogue: 0,0:08:10.40,0:08:13.49,Default,,0,0,0,,Бір рет жасағаннан кейін мұны істеу керек пе?
Dialogue: 0,0:08:13.57,0:08:16.57,Default,,0,0,0,,Жасағым келді, жасаудан басқа амалым жоқ деп ойладым.
Dialogue: 0,0:08:16.66,0:08:17.78,Default,,0,0,0,,Иә, иә!
Dialogue: 0,0:08:17.87,0:08:21.29,Default,,0,0,0,,Өнім жасамайтын, тек өз әсерін беретін тұтынушылар.
Dialogue: 0,0:08:21.37,0:08:23.21,Default,,0,0,0,,Өтінемін, үндемеңіз!
Dialogue: 0,0:08:23.29,0:08:24.71,Default,,0,0,0,,Тұтынушы кім?
Dialogue: 0,0:08:24.79,0:08:26.54,Default,,0,0,0,,Мен бағдарламаны орындадым!
Dialogue: 0,0:08:26.63,0:08:28.21,Default,,0,0,0,,Не болды!
Dialogue: 0,0:08:28.29,0:08:31.13,Default,,0,0,0,,Мен оқимын, радио тыңдаймын, тіпті музыка тыңдаймын.
Dialogue: 0,0:08:31.21,0:08:32.42,Default,,0,0,0,,Бұл оңай!
Dialogue: 0,0:08:32.51,0:08:33.17,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:33.26,0:08:36.26,Default,,0,0,0,,(машина жұмысының дыбысы)
Dialogue: 0,0:08:36.34,0:08:38.55,Default,,0,0,0,,Жоқ... не... бұл не!
Dialogue: 0,0:08:38.64,0:08:39.85,Default,,0,0,0,,Қайтарыңыз! Ах...
Dialogue: 0,0:08:39.93,0:08:41.47,Default,,0,0,0,,98 операция дыбысы
Dialogue: 0,0:08:41.97,0:08:44.48,Default,,0,0,0,,Бұны тыңдасам, көңілім тыныштандырады.
Dialogue: 0,0:08:44.56,0:08:45.73,Default,,0,0,0,,Е...
Dialogue: 0,0:08:46.48,0:08:47.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:47.31,0:08:48.36,Default,,0,0,0,,Ал сосын!
Dialogue: 0,0:08:48.44,0:08:51.03,Default,,0,0,0,,Мен саған сататын ойын жаса деп тұрған жоқпын.
Dialogue: 0,0:08:51.11,0:08:53.61,Default,,0,0,0,,Мен сендерге қызықты ойындар жаса деп тұрған жоқпын.
Dialogue: 0,0:08:53.69,0:08:57.37,Default,,0,0,0,,Дәл қазір ойында немен айналысқыңыз келеді?
Dialogue: 0,0:08:57.45,0:08:59.33,Default,,0,0,0,,Бұл туралы ойланыңыз
Dialogue: 0,0:09:00.08,0:09:02.12,Default,,0,0,0,,Хмм.
Dialogue: 0,0:09:02.20,0:09:04.12,Default,,0,0,0,,...
Dialogue: 0,0:09:04.79,0:09:07.54,Default,,0,0,0,,Мен ауысуға шығамын!
Dialogue: 0,0:09:07.63,0:09:10.09,Default,,0,0,0,,Ойланып қарашы, сен... иә?
Dialogue: 0,0:09:10.17,0:09:12.30,Default,,0,0,0,,Сіз өзіңізді «Мен» деп атайсыз ба?
Dialogue: 0,0:09:12.80,0:09:13.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:13.42,0:09:16.97,Default,,0,0,0,,Сіз өзіңізді «Коноха» деп атайтынсыз.
Dialogue: 0,0:09:17.05,0:09:17.76,Default,,0,0,0,,А...
Dialogue: 0,0:09:18.84,0:09:21.56,Default,,0,0,0,,Мен әрқашан осылай болған емеспін бе?
Dialogue: 0,0:09:23.60,0:09:24.73,Default,,0,0,0,,Сіз...
Dialogue: 0,0:09:25.39,0:09:27.69,Default,,0,0,0,,Тезірек ойын құрғаныңыз жөн.
Dialogue: 0,0:09:27.77,0:09:28.48,Default,,0,0,0,,Е...
Dialogue: 0,0:09:33.03,0:09:34.69,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:09:38.78,0:09:40.87,Default,,0,0,0,,Сіз де өзгеріп жатырсыз.
Dialogue: 0,0:09:40.95,0:09:43.91,Default,,0,0,0,,Бүгінгі дүние саған да әсер етеді.
Dialogue: 0,0:09:44.41,0:09:46.87,Default,,0,0,0,,Іс осылай жалғаса берсе, бастапқы дүниенің естеліктері жойылады.
Dialogue: 0,0:09:46.96,0:09:49.29,Default,,0,0,0,,Ол сізден жоғалып кетуі мүмкін.
Dialogue: 0,0:09:50.33,0:09:52.80,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:09:54.26,0:09:56.80,Default,,0,0,0,,Жоқ, әлі есімде.
Dialogue: 0,0:09:56.88,0:09:58.72,Default,,0,0,0,,Сыртқы түрі мүлде өзгергенімен
Dialogue: 0,0:09:58.80,0:10:00.22,Default,,0,0,0,,Менің есімде дұрыс!
Dialogue: 0,0:10:00.30,0:10:03.18,Default,,0,0,0,,Бұл менің Акихабараға келген бірінші күнім болды.
Dialogue: 0,0:10:06.52,0:10:08.23,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,0:10:08.31,0:10:11.23,Default,,0,0,0,,Мен мұндай жат жерде болған емеспін.
Dialogue: 0,0:10:11.31,0:10:14.36,Default,,0,0,0,,Ойындар мен комикстер өте көп.
Dialogue: 0,0:10:14.44,0:10:17.45,Default,,0,0,0,,Сүйкімді қыздар өте көп
Dialogue: 0,0:10:17.53,0:10:21.28,Default,,0,0,0,,Күнде фестиваль өтетіндей болды.
Dialogue: 0,0:10:22.95,0:10:25.20,Default,,0,0,0,,Бұл Акихабара!
Dialogue: 0,0:10:25.29,0:10:28.12,Default,,0,0,0,,Уау ахаха хахаха
Dialogue: 0,0:10:28.21,0:10:30.54,Default,,0,0,0,,Хаха... хахаха
Dialogue: 0,0:10:31.25,0:10:32.29,Default,,0,0,0,,Хаа…
Dialogue: 0,0:10:35.00,0:10:38.30,Default,,0,0,0,,Дұрыс, үйге ертерек барып ойын жасайық!
Dialogue: 0,0:10:38.38,0:10:39.68,Default,,0,0,0,,Не дедің?
Dialogue: 0,0:10:39.76,0:10:40.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:42.26,0:10:43.01,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:44.60,0:10:46.14,Default,,0,0,0,,Туя-чан?
Dialogue: 0,0:10:52.10,0:10:53.61,Default,,0,0,0,,Туя-чан...
Dialogue: 0,0:10:56.19,0:10:57.90,Default,,0,0,0,,Сәлеметсіз бе, Туя-чан?
Dialogue: 0,0:10:58.49,0:10:59.36,Default,,0,0,0,,Әпке?
Dialogue: 0,0:10:59.90,0:11:01.03,Default,,0,0,0,,Әпке!
Dialogue: 0,0:11:01.11,0:11:02.28,Default,,0,0,0,,Туя-чан!
Dialogue: 0,0:11:02.37,0:11:04.16,Default,,0,0,0,,Уау, Туя-чан!
Dialogue: 0,0:11:04.24,0:11:06.04,Default,,0,0,0,,Эй... біраз болды.
Dialogue: 0,0:11:06.12,0:11:06.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:06.95,0:11:09.41,Default,,0,0,0,,Менің нөмірімді қайдан білесің?
Dialogue: 0,0:11:09.50,0:11:12.71,Default,,0,0,0,,Мен оны баяғыда Комикетте ауыстырдым.
Dialogue: 0,0:11:12.79,0:11:14.59,Default,,0,0,0,,А, солай ма?
Dialogue: 0,0:11:14.67,0:11:17.17,Default,,0,0,0,,Бірақ мен сізге көп қоңырау шалдым.
Dialogue: 0,0:11:17.25,0:11:18.67,Default,,0,0,0,,Қосылмаған
Dialogue: 0,0:11:19.22,0:11:21.01,Default,,0,0,0,,Енді сөйлесе алмаймыз деп ойлаймын.
Dialogue: 0,0:11:21.51,0:11:23.47,Default,,0,0,0,,Кешіріңіз... Кешіріңіз, Туя-чан.
Dialogue: 0,0:11:23.55,0:11:25.47,Default,,0,0,0,,Ал... Мен оның орнына жаңалықты көрдім.
Dialogue: 0,0:11:25.55,0:11:26.56,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:11:26.64,0:11:29.23,Default,,0,0,0,,Мен Туя-чанның компаниясы жақсы жұмыс істеп жатқанын көріп тұрмын!
Dialogue: 0,0:11:29.31,0:11:31.23,Default,,0,0,0,,Ах... Рахмет.
Dialogue: 0,0:11:31.31,0:11:34.48,Default,,0,0,0,,Ымм... Әпке, қазір қайдасыз?
Dialogue: 0,0:11:34.56,0:11:37.02,Default,,0,0,0,,Сіз ұзақ уақыттан кейін кездесіп, сөйлескіңіз келе ме?
Dialogue: 0,0:11:37.11,0:11:39.74,Default,,0,0,0,,Иә! Ах... ой...
Dialogue: 0,0:11:39.82,0:11:43.57,Default,,0,0,0,,Мм... Сізбен кездесуге мүлдем қарсы емеспін.
Dialogue: 0,0:11:43.66,0:11:46.24,Default,,0,0,0,,Туя-чан, сіз таң қалуыңыз мүмкін.
Dialogue: 0,0:11:46.33,0:11:47.62,Default,,0,0,0,,Мәселе жоқ!
Dialogue: 0,0:11:47.70,0:11:50.12,Default,,0,0,0,,Әпке, қазір қайдасыз?
Dialogue: 0,0:11:50.20,0:11:52.08,Default,,0,0,0,,Қайда болсаң да мен сені алып кетемін.
Dialogue: 0,0:11:52.16,0:11:53.71,Default,,0,0,0,,Бүгін жұма.
Dialogue: 0,0:11:53.79,0:11:55.21,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:11:56.79,0:11:58.25,Default,,0,0,0,,Хе-хе-хе…
Dialogue: 0,0:11:58.34,0:12:00.55,Default,,0,0,0,,Мен де сенімен танысқым келеді, Туя-чан!
Dialogue: 0,0:12:04.84,0:12:06.76,Default,,0,0,0,,Осындай нәрсе, Рокуда-сан
Dialogue: 0,0:12:06.85,0:12:08.22,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:12:08.81,0:12:10.89,Default,,0,0,0,,Жоқ, ол жоғалды.
Dialogue: 0,0:12:10.98,0:12:12.23,Default,,0,0,0,,Радиозал
Dialogue: 0,0:12:12.73,0:12:14.94,Default,,0,0,0,,Мен мұнда жиі келетінмін.
Dialogue: 0,0:12:15.02,0:12:19.19,Default,,0,0,0,,Маған да осындай жерлер ұнайтын.
Dialogue: 0,0:12:19.28,0:12:22.49,Default,,0,0,0,,Хахаха, аздап жалғыздық.
Dialogue: 0,0:12:23.24,0:12:25.20,Default,,0,0,0,,Әлі де... (Мамору) Иә?
Dialogue: 0,0:12:25.28,0:12:28.74,Default,,0,0,0,,Қызық, ол стадион қашан салынады?
Dialogue: 0,0:12:28.83,0:12:31.75,Default,,0,0,0,,Әйтеуір мен салған компания өзін сатып жіберді.
Dialogue: 0,0:12:31.83,0:12:35.12,Default,,0,0,0,,Анаңның денесін басқа жерге көшірді деп айттың.
Dialogue: 0,0:12:35.21,0:12:37.84,Default,,0,0,0,,Сізде қиындық болды ма?
Dialogue: 0,0:12:37.92,0:12:40.80,Default,,0,0,0,,Қайта құру осындай керемет жылдамдықпен жүріп жатыр.
Dialogue: 0,0:12:41.30,0:12:43.13,Default,,0,0,0,,Кез келген нәрсе болуы мүмкін.
Dialogue: 0,0:12:43.22,0:12:44.80,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:12:45.47,0:12:47.60,Default,,0,0,0,,А, онда Рокуда мырза, міне осы.
Dialogue: 0,0:12:48.10,0:12:49.60,Default,,0,0,0,,Мен сенің оны қаншалықты жақсы басқара алатыныңды білгім келеді.
Dialogue: 0,0:12:53.06,0:12:55.60,Default,,0,0,0,,Сізге де жақсы жұмыс
Dialogue: 0,0:13:02.69,0:13:05.40,Default,,0,0,0,,Коноха ойынды сәтті аяқтады деп есептесек.
Dialogue: 0,0:13:05.49,0:13:07.20,Default,,0,0,0,,Осыдан кейін не істеуім керек?
Dialogue: 0,0:13:08.20,0:13:12.04,Default,,0,0,0,,Коноха ойынмен 1999 жылға барды.
Dialogue: 0,0:13:12.12,0:13:14.21,Default,,0,0,0,,Оны сату мүмкін емес.
Dialogue: 0,0:13:14.75,0:13:18.58,Default,,0,0,0,,Мәліметтерді екінші жағынан көшіріп, өткенге қалдыру керек.
Dialogue: 0,0:13:19.34,0:13:21.71,Default,,0,0,0,,Ал оны кімге сеніп тапсыруымыз керек?
Dialogue: 0,0:13:22.51,0:13:25.26,Default,,0,0,0,,Коноханың қорқынышты оқиғасына сеніңіз
Dialogue: 0,0:13:25.34,0:13:28.05,Default,,0,0,0,,Ойынды жақсы пайдалана алатын адам...
Dialogue: 0,0:13:33.18,0:13:34.48,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:13:37.39,0:13:38.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:49.49,0:13:51.37,Default,,0,0,0,,Тағы кофе, өтінемін.
Dialogue: 0,0:13:51.45,0:13:52.91,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:13:56.71,0:13:59.04,Default,,0,0,0,,Туя-чан, мүмкін әлі жоқ шығар...
Dialogue: 0,0:14:01.04,0:14:01.54,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:02.59,0:14:03.88,Default,,0,0,0,,А... уф!
Dialogue: 0,0:14:04.51,0:14:06.01,Default,,0,0,0,,Иида-кун мен Яо-санды да құттықтаймыз.
Dialogue: 0,0:14:07.84,0:14:08.38,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:32.78,0:14:35.54,Default,,0,0,0,,Сізге қалай ұнайды? Жаңа кеңсе
Dialogue: 0,0:14:35.62,0:14:40.87,Default,,0,0,0,,Бұл сіз сияқты сұлу және талантты адам үшін тамаша орын.
Dialogue: 0,0:14:40.96,0:14:42.88,Default,,0,0,0,,Біз бұған сенеміз
Dialogue: 0,0:14:43.38,0:14:44.67,Default,,0,0,0,,Мисс Туя
Dialogue: 0,0:14:45.30,0:14:47.84,Default,,0,0,0,,Иә, бұл тамаша кеңсе.
Dialogue: 0,0:14:48.34,0:14:49.72,Default,,0,0,0,,Бірақ бір ғана нәрсе
Dialogue: 0,0:14:50.47,0:14:53.43,Default,,0,0,0,,Неліктен мен құрылтайшымен кездесе алмаймын?
Dialogue: 0,0:14:53.51,0:14:54.64,Default,,0,0,0,,Гленн мырза
Dialogue: 0,0:14:55.31,0:14:56.81,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:14:56.89,0:15:01.23,Default,,0,0,0,,Құрылтайшы қазір маңызды жобамен жұмыс істеуде.
Dialogue: 0,0:15:01.31,0:15:02.31,Default,,0,0,0,,Туя ханымға
Dialogue: 0,0:15:02.40,0:15:05.82,Default,,0,0,0,,Бұл аяқтала салысымен, мен бірінші сенімен кездескім келеді.
Dialogue: 0,0:15:05.90,0:15:09.65,Default,,0,0,0,,Менімен кездесуден басқа істерің бар ма?
Dialogue: 0,0:15:10.36,0:15:13.57,Default,,0,0,0,,Біз тең құқылы серіктес болуымыз керек
Dialogue: 0,0:15:13.66,0:15:15.83,Default,,0,0,0,,Әрине, біз теңбіз.
Dialogue: 0,0:15:15.91,0:15:19.41,Default,,0,0,0,,Сол үшін сіз сондасыз, Туя ханым.
Dialogue: 0,0:15:19.91,0:15:22.58,Default,,0,0,0,,Кью ойынын өндіру бойынша ноу-хау туралы біліңіз
Dialogue: 0,0:15:22.67,0:15:24.79,Default,,0,0,0,,Келісіммен және түсіністікпен
Dialogue: 0,0:15:25.29,0:15:26.84,Default,,0,0,0,,Мен... а
Dialogue: 0,0:15:26.92,0:15:30.38,Default,,0,0,0,,Сезімдерің салмақты.
Dialogue: 0,0:15:30.47,0:15:31.93,Default,,0,0,0,,Бірақ мен де
Dialogue: 0,0:15:32.01,0:15:34.68,Default,,0,0,0,,Мен Planet Games Japan бас директорымын.
Dialogue: 0,0:15:34.76,0:15:36.39,Default,,0,0,0,,Жеткілікті өкілеттілік...
Dialogue: 0,0:15:36.47,0:15:37.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:39.02,0:15:40.23,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:15:40.31,0:15:42.10,Default,,0,0,0,,О, бұл тамаша!
Dialogue: 0,0:15:42.19,0:15:44.23,Default,,0,0,0,,Бақытты болыңыз, Туя ханым.
Dialogue: 0,0:15:44.31,0:15:47.94,Default,,0,0,0,,Акисато Коноха-сама сол жаққа қарай бет алды.
Dialogue: 0,0:15:48.65,0:15:49.94,Default,,0,0,0,,Сіздің әпкеңіз?
Dialogue: 0,0:15:50.03,0:15:52.15,Default,,0,0,0,,Сіз де менімен кездескеніңізді қалар едіңіз.
Dialogue: 0,0:15:52.24,0:15:53.70,Default,,0,0,0,,Ол жолда...
Dialogue: 0,0:15:53.78,0:15:55.57,Default,,0,0,0,,Гленн мырза! Неге әпке...
Dialogue: 0,0:15:56.16,0:15:58.16,Default,,0,0,0,,Коноха Акисато осында ма?
Dialogue: 0,0:15:58.24,0:16:00.00,Default,,0,0,0,,Бұл оңай.
Dialogue: 0,0:16:00.08,0:16:02.04,Default,,0,0,0,,Мен жаңа ғана телефон соқтым
Dialogue: 0,0:16:02.12,0:16:04.71,Default,,0,0,0,,Бұл бір ғана сақина сақинасы!
Dialogue: 0,0:16:04.79,0:16:06.71,Default,,0,0,0,,Аа, бұл өлең
Dialogue: 0,0:16:06.79,0:16:09.51,Default,,0,0,0,,Ынтымақтастық үшін рахмет.
Dialogue: 0,0:16:09.59,0:16:10.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:10.76,0:16:13.22,Default,,0,0,0,,Әпке, қазір қайдасыз?
Dialogue: 0,0:16:13.30,0:16:15.43,Default,,0,0,0,,Ах... менің дауысым...
Dialogue: 0,0:16:15.93,0:16:18.47,Default,,0,0,0,,Әпкеңнің нөмірін алу үшін
Dialogue: 0,0:16:18.56,0:16:21.02,Default,,0,0,0,,Мен сіздің телефоныңызды бұздым.
Dialogue: 0,0:16:21.10,0:16:23.48,Default,,0,0,0,,Мен сенің әпкеңмен танысқым келеді.
Dialogue: 0,0:16:25.77,0:16:28.73,Default,,0,0,0,,Бірақ мен осы уақытқа дейін қосыла алмадым.
Dialogue: 0,0:16:28.82,0:16:29.69,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:16:29.78,0:16:33.45,Default,,0,0,0,,Бұл біріктіру мақсатына қол жеткізілгенін білдіреді.
Dialogue: 0,0:16:33.53,0:16:34.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:34.24,0:16:36.82,Default,,0,0,0,,Бұл шынымен де көп уақытты алды.
Dialogue: 0,0:16:37.41,0:16:40.33,Default,,0,0,0,,Бірақ ақырында мен оны аламын
Dialogue: 0,0:16:40.41,0:16:44.29,Default,,0,0,0,,«Соңғы вальс» түпнұсқа репликасы жасалды—
Dialogue: 0,0:16:44.37,0:16:46.38,Default,,0,0,0,,Данышпан жаратушы
Dialogue: 0,0:16:46.46,0:16:48.09,Default,,0,0,0,,үшін кездескісі келеді
Dialogue: 0,0:16:48.17,0:16:52.30,Default,,0,0,0,,Сол ойдың қайнар көзін білуді аңсаған сырлы адам.
Dialogue: 0,0:16:52.38,0:16:54.09,Default,,0,0,0,,Акисато Коноха
Dialogue: 0,0:16:54.76,0:16:57.55,Default,,0,0,0,,Ол есім жер шарын кезсе де
Dialogue: 0,0:16:57.64,0:17:00.10,Default,,0,0,0,,Не болып жатқанын ешкім білмейді
Dialogue: 0,0:17:00.18,0:17:03.31,Default,,0,0,0,,Мен ешкіммен кездеспедім немесе сөйлеспедім.
Dialogue: 0,0:17:03.81,0:17:06.19,Default,,0,0,0,,Кейбір ерекшеліктермен
Dialogue: 0,0:17:06.69,0:17:09.98,Default,,0,0,0,,Солардың бірі сіз едіңіз, Туя ханым.
Dialogue: 0,0:17:10.69,0:17:11.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:11.53,0:17:13.24,Default,,0,0,0,,Сіз әпкеңізбен не істеуді жоспарлап отырсыз?
Dialogue: 0,0:17:13.74,0:17:15.53,Default,,0,0,0,,А... мүмкін емес...
Dialogue: 0,0:17:16.16,0:17:17.70,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:17:17.78,0:17:18.78,Default,,0,0,0,,Сол себепті...
Dialogue: 0,0:17:18.87,0:17:21.20,Default,,0,0,0,,Сіз бұл үшін менің компаниямды қабылдадыңыз ба?
Dialogue: 0,0:17:21.74,0:17:24.04,Default,,0,0,0,,«Гүл құпия болмайды»
Dialogue: 0,0:17:24.12,0:17:26.75,Default,,0,0,0,,Сіз айтып тұрғаныңыз осы емес пе, Туя ханым?
Dialogue: 0,0:17:27.29,0:17:28.58,Default,,0,0,0,,Енді бізде
Dialogue: 0,0:17:28.67,0:17:32.05,Default,,0,0,0,,Сіз дүниежүзілік ойын-сауық чемпионы бола аласыз.
Dialogue: 0,0:17:32.13,0:17:37.34,Default,,0,0,0,,Сіз қалаған байлық, абырой, даңқ уәде етілгендей жақсы.
Dialogue: 0,0:17:38.14,0:17:40.39,Default,,0,0,0,,Маған неге олай айттың?
Dialogue: 0,0:17:41.10,0:17:43.31,Default,,0,0,0,,Егер мен полицияға хабарлассам...
Dialogue: 0,0:17:43.39,0:17:45.48,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:17:46.56,0:17:48.35,Default,,0,0,0,,Сіз есеп бермейсіз
Dialogue: 0,0:17:49.10,0:17:51.06,Default,,0,0,0,,Осы бірігуге қатысты
Dialogue: 0,0:17:51.15,0:17:53.78,Default,,0,0,0,,Маған да сен туралы білуді өтінді.
Dialogue: 0,0:17:53.86,0:17:55.07,Default,,0,0,0,,Мисс Туя
Dialogue: 0,0:17:55.15,0:17:58.32,Default,,0,0,0,,Сіз бізбен бір жақтасыз.
Dialogue: 0,0:17:58.91,0:18:02.28,Default,,0,0,0,,Сондықтан полиция шақырмайсыз.
Dialogue: 0,0:18:02.37,0:18:03.83,Default,,0,0,0,,Жоқ, алмаймын.
Dialogue: 0,0:18:03.91,0:18:06.12,Default,,0,0,0,,Жоқ? Туяны сағындым
Dialogue: 0,0:18:07.54,0:18:10.88,Default,,0,0,0,,Сабырлы болыңыз, Туя ханым.
Dialogue: 0,0:18:10.96,0:18:13.13,Default,,0,0,0,,Мен саған ешқашан жамандық жасамаймын.
Dialogue: 0,0:18:13.63,0:18:14.30,Default,,0,0,0,,Сонымен
Dialogue: 0,0:18:14.38,0:18:15.17,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:18:19.59,0:18:21.14,Default,,0,0,0,,Әпке...
Dialogue: 0,0:18:24.39,0:18:24.97,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:28.89,0:18:30.48,Default,,0,0,0,,Аурухана?
Dialogue: 0,0:18:31.69,0:18:32.77,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:18:33.40,0:18:33.90,Default,,0,0,0,,Ах
Dialogue: 0,0:18:36.57,0:18:38.07,Default,,0,0,0,,Иә.
Dialogue: 0,0:18:38.15,0:18:40.16,Default,,0,0,0,,Мен Туя-чанмен кездесіп тұрдым.
Dialogue: 0,0:18:40.24,0:18:42.20,Default,,0,0,0,,Көлікке мәжбүрлеу
Dialogue: 0,0:18:42.70,0:18:43.83,Default,,0,0,0,,Мурата мырза!
Dialogue: 0,0:18:43.91,0:18:44.49,Default,,0,0,0,,Не!
Dialogue: 0,0:18:44.58,0:18:47.45,Default,,0,0,0,,Уау! Бұл не!
Dialogue: 0,0:18:47.54,0:18:51.50,Default,,0,0,0,,Ол штепсельдік костюм сияқты бірдеңе киіп алған!
Dialogue: 0,0:18:51.58,0:18:53.09,Default,,0,0,0,,Киім ше? жоқ!
Dialogue: 0,0:18:53.17,0:18:54.67,Default,,0,0,0,,Смартфондар туралы не деуге болады? жоқ!
Dialogue: 0,0:18:54.75,0:18:56.96,Default,,0,0,0,,Сондай-ақ рюкзак? Жоқ!
Dialogue: 0,0:18:57.05,0:19:01.26,Default,,0,0,0,,Әйтеуір, мына жер қайда?
Dialogue: 0,0:19:01.80,0:19:05.85,Default,,0,0,0,,Мені әлдебір байға сатып жібере ме?
Dialogue: 0,0:19:05.93,0:19:07.72,Default,,0,0,0,,Ойын сияқты...
Dialogue: 0,0:19:07.81,0:19:10.19,Default,,0,0,0,,Иә? Ол құлыпталмаған
Dialogue: 0,0:19:11.94,0:19:14.15,Default,,0,0,0,,Хмм, бұл жағдайда
Dialogue: 0,0:19:14.23,0:19:16.40,Default,,0,0,0,,Есік құлпы ашылғанда
Dialogue: 0,0:19:16.48,0:19:20.82,Default,,0,0,0,,Әрбір дерлік ойында есік алдында бірдеңе болады...
Dialogue: 0,0:19:20.90,0:19:22.45,Default,,0,0,0,,Хмм.
Dialogue: 0,0:19:26.37,0:19:28.83,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:19:29.45,0:19:30.08,Default,,0,0,0,,Уау
Dialogue: 0,0:19:30.16,0:19:31.21,Default,,0,0,0,,Иә...
Dialogue: 0,0:19:33.00,0:19:35.29,Default,,0,0,0,,Әзірге шығу жолын іздейік.
Dialogue: 0,0:19:39.01,0:19:39.51,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:19:39.59,0:19:41.38,Default,,0,0,0,,Хяаааа!
Dialogue: 0,0:19:41.47,0:19:43.76,Default,,0,0,0,,...бұл ма?
Dialogue: 0,0:19:43.84,0:19:45.80,Default,,0,0,0,,Нағыз өлшемдегі фигура?
Dialogue: 0,0:19:45.89,0:19:47.81,Default,,0,0,0,,(Машина қозғалысының шуы)
Dialogue: 0,0:19:54.86,0:19:56.77,Default,,0,0,0,,Шығу... мүмкін бе?
Dialogue: 0,0:20:01.15,0:20:04.82,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:06.07,0:20:09.33,Default,,0,0,0,,Нана... Нана... Бұл не? мұнда
Dialogue: 0,0:20:11.08,0:20:12.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:12.33,0:20:13.42,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:14.29,0:20:16.96,Default,,0,0,0,,Бұл басқа фигура ма?
Dialogue: 0,0:20:17.04,0:20:18.46,Default,,0,0,0,,Дәмі өте нашар
Dialogue: 0,0:20:18.55,0:20:19.42,Default,,0,0,0,,Ха!
Dialogue: 0,0:20:19.96,0:20:24.30,Default,,0,0,0,,Жоқ... бұл цифр емес.
Dialogue: 0,0:20:24.80,0:20:28.14,Default,,0,0,0,,Адам... адам баласы қақпанға түсті!
Dialogue: 0,0:20:29.56,0:20:31.93,Default,,0,0,0,,Мұндағы барлық аквариумдар бар ма?
Dialogue: 0,0:20:32.43,0:20:33.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:34.81,0:20:35.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:39.94,0:20:43.28,Default,,0,0,0,,Кяаа!
Dialogue: 0,0:20:46.07,0:20:48.08,Default,,0,0,0,,♪～
Dialogue: 0,0:22:13.95,0:22:15.95,Default,,0,0,0,,～♪
Dialogue: 0,0:22:18.67,0:22:21.92,Default,,0,0,0,,(Қоңырау үні)
Dialogue: 0,0:22:28.13,0:22:29.01,Default,,0,0,0,,Сол кезде
Dialogue: 0,0:22:30.01,0:22:32.76,Default,,0,0,0,,Ол біреумен кездесіп жатқан сияқты.
Dialogue: 0,0:22:33.43,0:22:35.31,Default,,0,0,0,,Бірақ мен сенен көзімді алып тастаған сәтте
Dialogue: 0,0:22:35.93,0:22:38.14,Default,,0,0,0,,Ол кенет жоғалып кетті.
Dialogue: 0,0:22:39.19,0:22:41.81,Default,,0,0,0,,Мен осының алдында естіген дауыс
Dialogue: 0,0:22:41.90,0:22:43.98,Default,,0,0,0,,Ал кетіп қалған көлік
Dialogue: 0,0:22:49.82,0:22:51.45,Default,,0,0,0,,(Қоңырау үні)
Dialogue: 0,0:22:51.53,0:22:52.91,Default,,0,0,0,,Иә, бұл Мацубара.
Dialogue: 0,0:22:52.99,0:22:53.78,Default,,0,0,0,,Бұл Рокуда.
Dialogue: 0,0:22:53.87,0:22:55.49,Default,,0,0,0,,Ерен еңбегіңіз үшін рахмет, Президент.
Dialogue: 0,0:22:55.58,0:22:57.25,Default,,0,0,0,,Сізге қажет нәрсе бар ма?
Dialogue: 0,0:22:57.33,0:22:58.71,Default,,0,0,0,,Маған көлік алғым келеді, өтінемін.
Dialogue: 0,0:22:58.79,0:23:01.50,Default,,0,0,0,,Ең жылдамын қоймаға жіберіңіз.
Dialogue: 0,0:23:01.58,0:23:02.83,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:23:02.92,0:23:05.00,Default,,0,0,0,,Олай болса рахмет.
Dialogue: 0,0:23:06.51,0:23:09.26,Default,,0,0,0,,Дүкен сатушысын сомдаған комедиант өте крутой—
Dialogue: 0,0:23:13.93,0:23:18.27,Default,,0,0,0,,(операция дыбысы)
Dialogue: 0,0:23:20.60,0:23:23.77,Default,,0,0,0,,Мен ұйықтап жатқанда кенеттен оятып жібергені жаман болды, бәрі.
Dialogue: 0,0:23:24.31,0:23:27.57,Default,,0,0,0,,Бірақ дәл қазір бізге барлығының көмегі қажет.
Dialogue: 0,0:23:28.28,0:23:30.11,Default,,0,0,0,,Коноханың баратын жерін іздеңіз.
Dialogue: 0,0:23:30.74,0:23:32.99,Default,,0,0,0,,Мен мұны сұрадым, бәрінен де.
Dialogue: 0,0:23:36.70,0:23:40.96,Default,,0,0,0,,(Пернетақта пернесінің дыбысы)
Dialogue: 0,0:23:42.46,0:23:48.46,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
