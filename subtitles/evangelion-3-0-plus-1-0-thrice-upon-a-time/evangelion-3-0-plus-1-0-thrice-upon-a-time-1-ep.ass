Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.20,0:00:03.62,Default,,0,0,0,,Евангелион осы уақытқа дейін
Dialogue: 0,0:00:05.75,0:00:09.37,Default,,0,0,0,,Адамдар жасаған соңғы жалпы мақсаттағы гуманоидты жауынгерлік қару.
Dialogue: 0,0:00:09.45,0:00:11.16,Default,,0,0,0,,Android Evangelion
Dialogue: 0,0:00:11.45,0:00:13.54,Default,,0,0,0,,Синдзи Икари, сен мінесің.
Dialogue: 0,0:00:13.66,0:00:14.16,Default,,0,0,0,,Сұрыптау
Dialogue: 0,0:00:14.16,0:00:14.66,Default,,0,0,0,,Сұрыптау
Dialogue: 0,0:00:14.16,0:00:14.66,Default,,0,0,0,,Мен мұны міну мүмкін емес!
Dialogue: 0,0:00:14.66,0:00:16.08,Default,,0,0,0,,Мен мұны міну мүмкін емес!
Dialogue: 0,0:00:16.16,0:00:19.29,Default,,0,0,0,,Атқа мінетін болсаң, тез істе, әйтпесе үйіңе қайт!
Dialogue: 0,0:00:19.41,0:00:21.08,Default,,0,0,0,,Қашпа Қашпа
Dialogue: 0,0:00:21.16,0:00:23.25,Default,,0,0,0,,Қашпа! Қашпа!
Dialogue: 0,0:00:23.91,0:00:24.91,Default,,0,0,0,,Мен мінемін
Dialogue: 0,0:00:25.20,0:00:26.33,Default,,0,0,0,,Ева елшіні жеңе алады
Dialogue: 0,0:00:26.41,0:00:29.20,Default,,0,0,0,,Елшіні жеңмейінше, болашағымыз жоқ.
Dialogue: 0,0:00:29.29,0:00:30.33,Default,,0,0,0,,15 жыл бұрын -
Dialogue: 0,0:00:30.41,0:00:33.37,Default,,0,0,0,,Екінші әсерде адамзаттың жартысы жоғалды.
Dialogue: 0,0:00:33.45,0:00:35.87,Default,,0,0,0,,Енді, егер елші үшінші әсер етсе...
Dialogue: 0,0:00:35.95,0:00:37.37,Default,,0,0,0,,Бұл жолы адамдар жойылады.
Dialogue: 0,0:00:37.45,0:00:39.00,Default,,0,0,0,,Мен мұнда не үшін келдім?
Dialogue: 0,0:00:39.08,0:00:40.62,Default,,0,0,0,,Маған сенбейсіз бе? әкенің жұмысы
Dialogue: 0,0:00:40.83,0:00:42.95,Default,,0,0,0,,Менің Еваға мінуден басқа амалым жоқ, солай ма?
Dialogue: 0,0:00:43.04,0:00:45.00,Default,,0,0,0,,Сондықтан әкем мені шақырды.
Dialogue: 0,0:00:45.08,0:00:47.00,Default,,0,0,0,,Сондықтан менің Еваға мінуден басқа амалым жоқ.
Dialogue: 0,0:00:47.08,0:00:48.79,Default,,0,0,0,,Еваны басқаруды жалғастыру керек пе, жоқ па?
Dialogue: 0,0:00:48.87,0:00:50.08,Default,,0,0,0,,Өзіңіз шешіңіз
Dialogue: 0,0:00:50.33,0:00:52.25,Default,,0,0,0,,Тағы атқа мінейік
Dialogue: 0,0:00:52.33,0:00:55.00,Default,,0,0,0,,Сен өлмейсің, мен сені қорғаймын.
Dialogue: 0,0:00:55.08,0:00:57.12,Default,,0,0,0,,Қашпай Еваға мініп алды
Dialogue: 0,0:00:57.37,0:01:00.58,Default,,0,0,0,,Егер сіз өз еркіңізбен түспесеңіз, оны оған қалдырыңыз.
Dialogue: 0,0:01:00.91,0:01:01.91,Default,,0,0,0,,Әр сынып үшін түрлі жарыстарға іріктеу кезеңдері өткізіледі—
Dialogue: 0,0:01:02.04,0:01:04.83,Default,,0,0,0,,Қош бол, менде басқа ештеңе жоқ.
Dialogue: 0,0:01:04.83,0:01:05.08,Default,,0,0,0,,Қош бол, менде басқа ештеңе жоқ.
Dialogue: 0,0:01:04.83,0:01:05.08,Default,,0,0,0,,Аянами Аянами!
Dialogue: 0,0:01:05.08,0:01:05.83,Default,,0,0,0,,Аянами Аянами!
Dialogue: 0,0:01:05.83,0:01:05.95,Default,,0,0,0,,Аянами Аянами!
Dialogue: 0,0:01:05.83,0:01:05.95,Default,,0,0,0,,Мен мұндай кезде қандай бет жасау керектігін білмеймін.
Dialogue: 0,0:01:05.95,0:01:08.83,Default,,0,0,0,,Мен мұндай кезде қандай бет жасау керектігін білмеймін.
Dialogue: 0,0:01:08.91,0:01:10.37,Default,,0,0,0,,Менің ойымша, сіз күлуіңіз керек.
Dialogue: 0,0:01:10.66,0:01:13.33,Default,,0,0,0,,Тағдыры жазылған балалар...
Dialogue: 0,0:01:14.37,0:01:16.00,Default,,0,0,0,,Капитан Шикинами Асука Лэнгли
Dialogue: 0,0:01:16.08,0:01:17.70,Default,,0,0,0,,Ева 2-бөліміне жауапты ұшқыш.
Dialogue: 0,0:01:17.70,0:01:18.00,Default,,0,0,0,,Ева 2-бөліміне жауапты ұшқыш.
Dialogue: 0,0:01:17.70,0:01:18.00,Default,,0,0,0,,Сен ақымақсың ба?
Dialogue: 0,0:01:18.00,0:01:18.70,Default,,0,0,0,,Сен ақымақсың ба?
Dialogue: 0,0:01:18.79,0:01:20.83,Default,,0,0,0,,Кейбір адамдар Еваға мінгеніне қуанады.
Dialogue: 0,0:01:20.91,0:01:21.87,Default,,0,0,0,,Сенің әкең ондайға жарамайды.
Dialogue: 0,0:01:21.87,0:01:22.16,Default,,0,0,0,,Сенің әкең ондайға жарамайды.
Dialogue: 0,0:01:21.87,0:01:22.16,Default,,0,0,0,,Ол мені бірінші рет мақтады.
Dialogue: 0,0:01:22.16,0:01:23.29,Default,,0,0,0,,Ол мені бірінші рет мақтады.
Dialogue: 0,0:01:23.29,0:01:23.50,Default,,0,0,0,,Ол мені бірінші рет мақтады.
Dialogue: 0,0:01:23.29,0:01:23.50,Default,,0,0,0,,Жарайсың Шинжи
Dialogue: 0,0:01:23.50,0:01:24.29,Default,,0,0,0,,Жарайсың Шинжи
Dialogue: 0,0:01:24.54,0:01:26.66,Default,,0,0,0,,Алғаш рет мақтағаныма қуаныштымын.
Dialogue: 0,0:01:26.66,0:01:27.12,Default,,0,0,0,,Алғаш рет мақтағаныма қуаныштымын.
Dialogue: 0,0:01:26.66,0:01:27.12,Default,,0,0,0,,Адамды толықтыру жоспары
Dialogue: 0,0:01:27.12,0:01:27.75,Default,,0,0,0,,Адамды толықтыру жоспары
Dialogue: 0,0:01:27.75,0:01:27.95,Default,,0,0,0,,Адамды толықтыру жоспары
Dialogue: 0,0:01:27.75,0:01:27.95,Default,,0,0,0,,NERV сахнаның артында не істеуге тырысады?
Dialogue: 0,0:01:27.95,0:01:29.50,Default,,0,0,0,,NERV сахнаның артында не істеуге тырысады?
Dialogue: 0,0:01:29.58,0:01:30.83,Default,,0,0,0,,Катсураги Катсурагиді қорғаңыз
Dialogue: 0,0:01:30.91,0:01:32.70,Default,,0,0,0,,Мен Икари-кунмен бірге болсам, өзімді жылы сезінемін.
Dialogue: 0,0:01:32.79,0:01:34.37,Default,,0,0,0,,Бұл сені ұнататынымды білдірмейді.
Dialogue: 0,0:01:34.50,0:01:35.70,Default,,0,0,0,,Сіз қызықсыз.
Dialogue: 0,0:01:35.79,0:01:37.83,Default,,0,0,0,,Сізде Еваға мінбеген бақыт бар.
Dialogue: 0,0:01:37.91,0:01:38.91,Default,,0,0,0,,Мақсат дегенді қалай түсінесіз?
Dialogue: 0,0:01:39.00,0:01:40.87,Default,,0,0,0,,Асука бортта, әке!
Dialogue: 0,0:01:40.87,0:01:41.29,Default,,0,0,0,,Асука бортта, әке!
Dialogue: 0,0:01:40.87,0:01:41.29,Default,,0,0,0,,Ол кісі – елші, жауымыз.
Dialogue: 0,0:01:41.29,0:01:42.95,Default,,0,0,0,,Ол елші, ол біздің жауымыз.
Dialogue: 0,0:01:42.95,0:01:44.58,Default,,0,0,0,,Тоқта! Оған менің әкем кінәлі.
Dialogue: 0,0:01:44.58,0:01:45.75,Default,,0,0,0,,Тоқта! Оған менің әкем кінәлі.
Dialogue: 0,0:01:44.58,0:01:45.75,Default,,0,0,0,,Тағы да қашасың ба?
Dialogue: 0,0:01:45.75,0:01:45.83,Default,,0,0,0,,Тағы да қашасың ба?
Dialogue: 0,0:01:45.83,0:01:48.12,Default,,0,0,0,,Бір нәрседен қашудың несі жаман?
Dialogue: 0,0:01:48.20,0:01:49.75,Default,,0,0,0,,Мен енді Еваға мінгім келмейді.
Dialogue: 0,0:01:49.83,0:01:51.41,Default,,0,0,0,,Мен осылай сезіндім...
Dialogue: 0,0:01:51.50,0:01:52.87,Default,,0,0,0,,Мұнда қызық ештеңе жоқ
Dialogue: 0,0:01:52.95,0:01:55.45,Default,,0,0,0,,Икаридің Еваға мінуіне жол бермеңіз
Dialogue: 0,0:01:55.54,0:01:57.70,Default,,0,0,0,,Мен Evangelion Unit 01 ұшқышымын.
Dialogue: 0,0:01:57.79,0:01:59.08,Default,,0,0,0,,Бұл Синдзи Икари.
Dialogue: 0,0:01:59.16,0:02:01.70,Default,,0,0,0,,Аянамиді қайтарыңыз...
Dialogue: 0,0:02:01.79,0:02:04.79,Default,,0,0,0,,Бар, Синдзи-кун! өз тілектеріңіз үшін
Dialogue: 0,0:02:04.87,0:02:06.41,Default,,0,0,0,,Мен жоғалып кетсем де, менің орныма біреу келеді.
Dialogue: 0,0:02:06.50,0:02:08.33,Default,,0,0,0,,Аянами! кел!
Dialogue: 0,0:02:08.66,0:02:10.91,Default,,0,0,0,,Кешіріңіз, мен ештеңе істей алмадым.
Dialogue: 0,0:02:11.25,0:02:13.45,Default,,0,0,0,,Жарайды, бұл жеткілікті.
Dialogue: 0,0:02:13.54,0:02:15.25,Default,,0,0,0,,Екінші әсердің жалғасы -
Dialogue: 0,0:02:15.33,0:02:16.70,Default,,0,0,0,,Үшінші әсер басталады
Dialogue: 0,0:02:16.79,0:02:17.54,Default,,0,0,0,,Уақыт келді
Dialogue: 0,0:02:17.54,0:02:18.00,Default,,0,0,0,,Уақыт келді
Dialogue: 0,0:02:17.54,0:02:18.00,Default,,0,0,0,,Дүние бітеді
Dialogue: 0,0:02:18.00,0:02:18.91,Default,,0,0,0,,Дүние бітеді
Dialogue: 0,0:02:19.91,0:02:23.66,Default,,0,0,0,,Синдзи Икари, сен енді ештеңе істемейсің.
Dialogue: 0,0:02:23.75,0:02:25.37,Default,,0,0,0,,Мен мінуім керек пе?
Dialogue: 0,0:02:25.45,0:02:26.79,Default,,0,0,0,,Бұл біртүрлі, Мисато-сан.
Dialogue: 0,0:02:26.87,0:02:29.04,Default,,0,0,0,,Бұл кенеттен болды, мен түсінбеймін.
Dialogue: 0,0:02:29.12,0:02:31.08,Default,,0,0,0,,Содан бері 14 жыл өтті.
Dialogue: 0,0:02:31.16,0:02:34.83,Default,,0,0,0,,Біз Уилл Нервті жою мақсатын қоятын ұйымбыз.
Dialogue: 0,0:02:34.91,0:02:36.83,Default,,0,0,0,,Мен Кавору Нагиса Нагиса Каворумын
Dialogue: 0,0:02:37.08,0:02:39.75,Default,,0,0,0,,Мен де сен сияқты тағдырлы баламын.
Dialogue: 0,0:02:39.83,0:02:41.87,Default,,0,0,0,,Евангелия бөлімі 13
Dialogue: 0,0:02:42.12,0:02:44.75,Default,,0,0,0,,Уақыты келгенде мына Еваны сол баламен бірге мінгіз.
Dialogue: 0,0:02:44.83,0:02:46.50,Default,,0,0,0,,Еваға мініңіз!
Dialogue: 0,0:02:46.58,0:02:48.00,Default,,0,0,0,,Рей енді мұнда емес, Синдзи-кун.
Dialogue: 0,0:02:48.00,0:02:48.70,Default,,0,0,0,,Мынаны есте сақта: негізінен, демонның күші ол жеген адамдар санына байланысты анықталады.
Dialogue: 0,0:02:48.70,0:02:49.00,Default,,0,0,0,,Мынаны есте сақта: негізінен, демонның күші ол жеген адамдар санына байланысты анықталады.
Dialogue: 0,0:02:48.70,0:02:49.00,Default,,0,0,0,,Бірде оянған
Dialogue: 0,0:02:49.00,0:02:50.00,Default,,0,0,0,,Бірде оянған
Dialogue: 0,0:02:50.08,0:02:52.50,Default,,0,0,0,,Гафф есігін ашқан бірінші Ева...
Dialogue: 0,0:02:52.58,0:02:55.08,Default,,0,0,0,,Бұл үшінші әсерді тудырды.
Dialogue: 0,0:02:55.37,0:02:57.45,Default,,0,0,0,,Бәріне сен себепшісің
Dialogue: 0,0:02:57.58,0:02:58.83,Default,,0,0,0,,Сіз маған сол кезде көмектестіңіз, солай ма?
Dialogue: 0,0:02:58.91,0:02:59.50,Default,,0,0,0,,Көргенім, нато мен үшін емес екен
Dialogue: 0,0:02:59.50,0:02:59.91,Default,,0,0,0,,Көргенім, нато мен үшін емес екен
Dialogue: 0,0:02:59.50,0:02:59.91,Default,,0,0,0,,Фуюцукиді бастайық
Dialogue: 0,0:02:59.91,0:03:00.91,Default,,0,0,0,,Фуюцукиді бастайық
Dialogue: 0,0:03:00.91,0:03:01.12,Default,,0,0,0,,Фуюцукиді бастайық
Dialogue: 0,0:03:00.91,0:03:01.12,Default,,0,0,0,,Гаксинжи!
Dialogue: 0,0:03:01.12,0:03:01.95,Default,,0,0,0,,Гаксинжи!
Dialogue: 0,0:03:02.12,0:03:03.70,Default,,0,0,0,,Сіз тағы бір үшінші әсер етуді жоспарлап отырсыз ба?
Dialogue: 0,0:03:03.79,0:03:07.16,Default,,0,0,0,,Кавору-кунға және барлығына найза алыңыз.
Dialogue: 0,0:03:07.25,0:03:09.08,Default,,0,0,0,,Сонда дүние қайтып келеді
Dialogue: 0,0:03:09.37,0:03:11.75,Default,,0,0,0,,Егер солай істесең, Мисато-сан.
Dialogue: 0,0:03:11.83,0:03:13.12,Default,,0,0,0,,Мисато! DSS шокері
Dialogue: 0,0:03:13.20,0:03:14.25,Default,,0,0,0,,Жоқ, Шинджи-кун.
Dialogue: 0,0:03:14.25,0:03:14.62,Default,,0,0,0,,Жоқ, Шинджи-кун.
Dialogue: 0,0:03:14.25,0:03:14.62,Default,,0,0,0,,Тоқта! Ақымақ бала!
Dialogue: 0,0:03:14.62,0:03:15.91,Default,,0,0,0,,Тоқта! Ақымақ бала!
Dialogue: 0,0:03:15.91,0:03:16.12,Default,,0,0,0,,Тоқта! Ақымақ бала!
Dialogue: 0,0:03:15.91,0:03:16.12,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:03:16.12,0:03:17.37,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:03:17.70,0:03:21.16,Default,,0,0,0,,Күшпен әсер ету Оны бастайтын рәсім.
Dialogue: 0,0:03:21.25,0:03:22.83,Default,,0,0,0,,Менің кінәм бар ма?
Dialogue: 0,0:03:23.33,0:03:24.83,Default,,0,0,0,,Себебі мен найзамды суырып алдым
Dialogue: 0,0:03:24.91,0:03:25.75,Default,,0,0,0,,Бұл пәрмен
Dialogue: 0,0:03:25.75,0:03:26.04,Default,,0,0,0,,Бұл пәрмен
Dialogue: 0,0:03:25.75,0:03:26.04,Default,,0,0,0,,Бұл бетті жасама
Dialogue: 0,0:03:26.04,0:03:27.54,Default,,0,0,0,,Бұл бетті жасама
Dialogue: 0,0:03:27.66,0:03:29.83,Default,,0,0,0,,Мен сені тағы көремін, Шинджи-кун.
Dialogue: 0,0:03:29.95,0:03:30.95,Default,,0,0,0,,Каору-кун!
Dialogue: 0,0:03:31.04,0:03:32.50,Default,,0,0,0,,Ешқандай жақсылық болмайды!
Dialogue: 0,0:03:32.58,0:03:33.66,Default,,0,0,0,,Ол шынымен де бала.
Dialogue: 0,0:03:33.75,0:03:35.33,Default,,0,0,0,,Өтелмейтін күнә жоқ.
Dialogue: 0,0:03:37.29,0:03:40.75,Default,,0,0,0,,Үміт қалай болса да қалады.
