Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:27.52,0:00:30.03,Default,,0,0,0,,Мен әлі бастауыш сынып оқушысы кезімде
Dialogue: 0,0:00:30.11,0:00:32.40,Default,,0,0,0,,Жер 21 ғасырға аяқ басты
Dialogue: 0,0:00:34.57,0:00:36.95,Default,,0,0,0,,Нострадамустың ұлы болжамы да орындалды
Dialogue: 0,0:00:37.03,0:00:39.91,Default,,0,0,0,,Әйтеуір үйреншікті күндер өте берді.
Dialogue: 0,0:00:41.04,0:00:43.20,Default,,0,0,0,,Олар келгенше
Dialogue: 0,0:00:43.29,0:00:45.46,Default,,0,0,0,,(Ұшақтың ұшу дыбысы)
Dialogue: 0,0:01:18.03,0:01:18.66,Default,,0,0,0,,Әй!
Dialogue: 0,0:01:22.91,0:01:23.83,Default,,0,0,0,,Менің атым Джоэстар. Өмірімді сақтап қалғаныңыз үшін алғыс айтқым келеді.
Dialogue: 0,0:01:28.71,0:01:29.92,Default,,0,0,0,,Ефрейтор Жироро
Dialogue: 0,0:01:30.00,0:01:32.13,Default,,0,0,0,,Оның жауынгерлік қабілеті мен күшті ерік-жігері
Dialogue: 0,0:01:32.21,0:01:33.84,Default,,0,0,0,,Кероро взводының жылжымалы жаяу әскері
Dialogue: 0,0:01:36.72,0:01:37.22,Default,,0,0,0,,Хмм…
Dialogue: 0,0:01:39.84,0:01:40.51,Default,,0,0,0,,Не!
Dialogue: 0,0:01:42.22,0:01:42.72,Default,,0,0,0,,ал Ол Майтпен шайқасу – қауіпті ғана емес,
Dialogue: 0,0:01:45.39,0:01:47.27,Default,,0,0,0,,Өте ыстық!
Dialogue: 0,0:01:54.94,0:01:55.94,Default,,0,0,0,,Сәлем~
Dialogue: 0,0:01:56.65,0:01:57.74,Default,,0,0,0,,Иә... Мен жасадым!
Dialogue: 0,0:01:58.61,0:01:59.99,Default,,0,0,0,,Қатардағы Тамама
Dialogue: 0,0:02:00.07,0:02:02.66,Default,,0,0,0,,Кәдімгі сүйкімділігінің артында ол жауыз жүзді жасырады.
Dialogue: 0,0:02:02.74,0:02:04.37,Default,,0,0,0,,Кероро взводының шабуылдаушы сарбазы
Dialogue: 0,0:02:24.72,0:02:25.77,Default,,0,0,0,,Ефрейтор Дороро
Dialogue: 0,0:02:25.85,0:02:29.23,Default,,0,0,0,,Мейірімді ғарыш ниндзясы Кероро взводының пікір саны
Dialogue: 0,0:02:29.31,0:02:30.65,Default,,0,0,0,,Алайда, көлеңке жұқа болғандықтан,
Dialogue: 0,0:02:30.73,0:02:32.69,Default,,0,0,0,,Бұл пікір сирек қабылданады.
Dialogue: 0,0:02:34.32,0:02:35.61,Default,,0,0,0,,Иә!
Dialogue: 0,0:02:35.69,0:02:36.44,Default,,0,0,0,,- Иә? -иә?
Dialogue: 0,0:02:39.03,0:02:41.03,Default,,0,0,0,,Уақытымыз таусылып жатыр.
Dialogue: 0,0:02:41.53,0:02:43.70,Default,,0,0,0,,Жалғастырғыңыз келсе, 100 иен қосыңыз.
Dialogue: 0,0:02:43.78,0:02:44.78,Default,,0,0,0,,Аспазшы~
Dialogue: 0,0:02:44.87,0:02:46.24,Default,,0,0,0,,Бұл жаттығу!
Dialogue: 0,0:02:46.83,0:02:48.00,Default,,0,0,0,,Сержант майор Крулл
Dialogue: 0,0:02:48.08,0:02:49.96,Default,,0,0,0,,Ақыл-ойы таза, дархан мінезді
Dialogue: 0,0:02:50.04,0:02:52.46,Default,,0,0,0,,Кероро взводының жедел байланыс қызметкерлері
Dialogue: 0,0:02:57.09,0:02:59.13,Default,,0,0,0,,Демек, бұл Жер...
Dialogue: 0,0:02:59.22,0:03:01.43,Default,,0,0,0,,Пекопонды басып алуды көздеу⸺
Dialogue: 0,0:03:01.51,0:03:05.10,Default,,0,0,0,,Бұл Кероро взводының бес мүшесі туралы эпикалық оқиға.
Dialogue: 0,0:03:10.39,0:03:12.44,Default,,0,0,0,,Не? Бір адам жеткіліксіз
Dialogue: 0,0:03:12.52,0:03:15.19,Default,,0,0,0,,Бұл фильм нұсқасы болса да, бір маңызды адам...
Dialogue: 0,0:03:15.27,0:03:18.28,Default,,0,0,0,,Менің ойымша, жаттығудағы жалқаулар бәрібір май сатады.
Dialogue: 0,0:03:21.49,0:03:22.82,Default,,0,0,0,,Маған мұны істеуге рұқсат етіңіз!
Dialogue: 0,0:03:25.24,0:03:26.28,Default,,0,0,0,,Дұрыс емес
Dialogue: 0,0:03:26.37,0:03:28.49,Default,,0,0,0,,Вулканның ауырлық центрі жылжыды ма?
Dialogue: 0,0:03:28.58,0:03:32.87,Default,,0,0,0,,Міне, бұл ұшқыш шеберлігін шыңдаған сияқты.
Dialogue: 0,0:03:32.96,0:03:34.21,Default,,0,0,0,,Иә Келесі адамдар
Dialogue: 0,0:03:34.29,0:03:36.21,Default,,0,0,0,,Құсу? О!
Dialogue: 0,0:03:36.29,0:03:37.63,Default,,0,0,0,,Итита
Dialogue: 0,0:03:37.71,0:03:39.80,Default,,0,0,0,,Мен осындай жерде әлсіреп жүрдім.
Dialogue: 0,0:03:39.88,0:03:41.42,Default,,0,0,0,,Гама тұмандығы 58-ші планета⸺
Dialogue: 0,0:03:41.51,0:03:44.18,Default,,0,0,0,,Ғарышқа басып кіру күштерінің арнайы жедел операция бөлімінің командирі
Dialogue: 0,0:03:44.26,0:03:47.26,Default,,0,0,0,,Оның есімі таныс, сержант Кероро.
Dialogue: 0,0:03:47.35,0:03:48.68,Default,,0,0,0,,Иә, рақмет.
Dialogue: 0,0:03:48.77,0:03:50.14,Default,,0,0,0,,Тағы екі адам Тағы екі адам
Dialogue: 0,0:03:50.22,0:03:50.93,Default,,0,0,0,,Келесі адам
Dialogue: 0,0:03:51.02,0:03:51.52,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:51.60,0:03:54.02,Default,,0,0,0,,Тағы бір адам Тағы бір адам
Dialogue: 0,0:03:54.10,0:03:56.27,Default,,0,0,0,,Тағы бір адам Тағы бір адам...
Dialogue: 0,0:03:56.36,0:03:57.44,Default,,0,0,0,,Иә Келесі адамдар
Dialogue: 0,0:03:57.52,0:03:58.02,Default,,0,0,0,,Құсу!
Dialogue: 0,0:03:58.11,0:04:01.19,Default,,0,0,0,,А, бұл~ Джим Снайпер...
Dialogue: 0,0:04:01.28,0:04:03.45,Default,,0,0,0,,Иә, Джим Снайпер Custom.
Dialogue: 0,0:04:03.53,0:04:05.78,Default,,0,0,0,,Иә, бір өтінемін.
Dialogue: 0,0:04:07.87,0:04:10.87,Default,,0,0,0,,Құсу, құсу, құсу!
Dialogue: 0,0:04:12.41,0:04:13.08,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:04:13.16,0:04:14.54,Default,,0,0,0,,Yahoo~ Yahoo~
Dialogue: 0,0:04:14.62,0:04:15.67,Default,,0,0,0,,Бірақ неге шетелдіктер?
Dialogue: 0,0:04:15.75,0:04:16.75,Default,,0,0,0,,Осындай шу шығарсақ та
Dialogue: 0,0:04:16.83,0:04:19.30,Default,,0,0,0,,Біреудің қамы бар ма екен...
Dialogue: 0,0:04:19.38,0:04:20.42,Default,,0,0,0,,-Чу - (Әңгімелеу) Уау!
Dialogue: 0,0:04:20.51,0:04:22.17,Default,,0,0,0,,Менің басқа планеталықтар
Dialogue: 0,0:04:22.26,0:04:23.93,Default,,0,0,0,,Тосқауылға қарсы деп аталатын ыңғайлы функция
Dialogue: 0,0:04:24.01,0:04:25.30,Default,,0,0,0,,...
Dialogue: 0,0:04:25.97,0:04:27.39,Default,,0,0,0,,Мен Фуюки-дономен бірге тұрамын.
Dialogue: 0,0:04:27.47,0:04:29.97,Default,,0,0,0,,Оны отбасы мүшелері көре алатындай⸺
Dialogue: 0,0:04:30.06,0:04:31.27,Default,,0,0,0,,Түзетілген
Dialogue: 0,0:04:31.35,0:04:33.10,Default,,0,0,0,,Қарапайым Пекопон халқына арналған
Dialogue: 0,0:04:33.18,0:04:36.31,Default,,0,0,0,,Мен өзімнің бар екендігімді түсінбеймін.
Dialogue: 0,0:04:36.98,0:04:38.94,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:04:39.02,0:04:40.27,Default,,0,0,0,,Мен оны сатып алдым!
Dialogue: 0,0:04:40.36,0:04:42.65,Default,,0,0,0,,Керот Керот Керот Фуфун
Dialogue: 0,0:04:42.74,0:04:43.99,Default,,0,0,0,,Иә? Құсу!
Dialogue: 0,0:04:44.07,0:04:45.57,Default,,0,0,0,,-Гах... -(Фуюки) Ах.
Dialogue: 0,0:04:45.66,0:04:46.78,Default,,0,0,0,,Гу... Сержант?
Dialogue: 0,0:04:47.78,0:04:49.78,Default,,0,0,0,,Бар-жоғын білмеймін.
Dialogue: 0,0:04:54.87,0:04:57.04,Default,,0,0,0,,Менің қалағаным осы болды.
Dialogue: 0,0:04:57.13,0:04:58.79,Default,,0,0,0,,Бұл спорт залындағы снайперлердің әдеті!
Dialogue: 0,0:04:58.88,0:05:00.92,Default,,0,0,0,,Мен магистр дәрежесін күтпедім.
Dialogue: 0,0:05:01.00,0:05:03.34,Default,,0,0,0,,Олардың мұндай құраммен шабуылдайтынын күтпедім.
Dialogue: 0,0:05:03.42,0:05:04.97,Default,,0,0,0,,Мен шынымен түсінбеймін.
Dialogue: 0,0:05:05.05,0:05:08.01,Default,,0,0,0,,Сержантқа қарап мені де қуантады.
Dialogue: 0,0:05:08.09,0:05:09.93,Default,,0,0,0,,Ерте тұрып, сапқа тұру керек еді.
Dialogue: 0,0:05:10.01,0:05:13.81,Default,,0,0,0,,Құрметті Фуюки-доно, ынтымақтастығыңызға өте ризамын.
Dialogue: 0,0:05:13.89,0:05:15.89,Default,,0,0,0,,Жарайды, солай.
Dialogue: 0,0:05:15.98,0:05:18.81,Default,,0,0,0,,Сержантпен серуендеуге шығу өте қызықты және қызықты.
Dialogue: 0,0:05:18.90,0:05:19.90,Default,,0,0,0,,Кейде
Dialogue: 0,0:05:19.98,0:05:22.98,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:05:23.48,0:05:24.94,Default,,0,0,0,,-Ой? бұл! - (Фуюки) А?
Dialogue: 0,0:05:26.11,0:05:26.95,Default,,0,0,0,,Сол сияқты
Dialogue: 0,0:05:27.03,0:05:30.07,Default,,0,0,0,,Сол қайғылы ғарыш бекінісіндей жұмбақ ғибадатхана
Dialogue: 0,0:05:30.16,0:05:33.20,Default,,0,0,0,,Осындай жерде қасиетті орын болды ма?
Dialogue: 0,0:05:33.29,0:05:35.66,Default,,0,0,0,,Өтінемін, маған мына жерде құрбандық беріңіз.
Dialogue: 0,0:05:35.75,0:05:39.08,Default,,0,0,0,,Спорт залының снайперлік әдеті сәтті аяқталды деп үміттенемін...
Dialogue: 0,0:05:39.17,0:05:41.59,Default,,0,0,0,,О? Құсу~!
Dialogue: 0,0:05:41.67,0:05:43.30,Default,,0,0,0,,Бұл... жоғалып кетті ме?
Dialogue: 0,0:05:43.38,0:05:44.17,Default,,0,0,0,,Яббе~
Dialogue: 0,0:05:44.26,0:05:46.30,Default,,0,0,0,,Маған 100 иендік тиынды қайтарыңыз!
Dialogue: 0,0:05:46.88,0:05:48.01,Default,,0,0,0,,Сержант?
Dialogue: 0,0:05:49.09,0:05:49.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:50.80,0:05:52.18,Default,,0,0,0,,Сержант?
Dialogue: 0,0:05:52.93,0:05:54.52,Default,,0,0,0,,-Фуюки-доно! -(Фуюки) Уау!
Dialogue: 0,0:05:54.60,0:05:58.02,Default,,0,0,0,,Менімен бірге 100 иендік монетаны іздегеніңізді қалаймын.
Dialogue: 0,0:05:58.10,0:06:01.23,Default,,0,0,0,,Мен ұсынатын ақша 5 иен болады деп шештім.
Dialogue: 0,0:06:01.31,0:06:04.36,Default,,0,0,0,,Ах! Сержант! Сержант?
Dialogue: 0,0:06:10.20,0:06:11.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:11.99,0:06:14.08,Default,,0,0,0,,Бұл жердің не жері...
Dialogue: 0,0:06:14.58,0:06:16.50,Default,,0,0,0,,100 иендік монета 100 иендік монета...
Dialogue: 0,0:06:16.58,0:06:20.33,Default,,0,0,0,,100 иен 100 иен… 100 иен монетасы
Dialogue: 0,0:06:23.34,0:06:24.88,Default,,0,0,0,,Бұл не? Бұл
Dialogue: 0,0:06:26.76,0:06:28.76,Default,,0,0,0,,Ескі иероглифтерге ұқсайды
Dialogue: 0,0:06:29.59,0:06:30.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:32.47,0:06:33.89,Default,,0,0,0,,-100 иендік монета... -(Фуюки) Ах...
Dialogue: 0,0:06:33.97,0:06:36.64,Default,,0,0,0,,100 иендік монета… 100 иен 100 иен…
Dialogue: 0,0:06:38.14,0:06:39.39,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:06:39.89,0:06:43.82,Default,,0,0,0,,Бұл белгісіз өте ежелгі өркениеттің қирандылары болуы мүмкін бе?
Dialogue: 0,0:06:44.65,0:06:46.23,Default,,0,0,0,,Керемет
Dialogue: 0,0:06:46.82,0:06:47.49,Default,,0,0,0,,Ах
Dialogue: 0,0:06:48.15,0:06:49.57,Default,,0,0,0,,Керемет жаңалық!
Dialogue: 0,0:06:49.65,0:06:50.49,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:06:51.74,0:06:52.49,Default,,0,0,0,,-Ах! -(Фуюки) А?
Dialogue: 0,0:06:52.57,0:06:56.08,Default,,0,0,0,,Осындай жерде болды!
Dialogue: 0,0:06:56.16,0:06:56.99,Default,,0,0,0,,Жарақатым жазылды, сондықтан бүгіннен бастап қалыпты мектеп кестесіне оралдым.
Dialogue: 0,0:06:57.54,0:06:58.04,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:00.00,0:07:01.92,Default,,0,0,0,,- (Фуюки) Уау... - Құсу!
Dialogue: 0,0:07:05.92,0:07:07.17,Default,,0,0,0,,Не... не істеуім керек?
Dialogue: 0,0:07:07.26,0:07:08.17,Default,,0,0,0,,Сержант!
Dialogue: 0,0:07:08.26,0:07:10.22,Default,,0,0,0,,Тынышталыңыз
Dialogue: 0,0:07:10.30,0:07:11.93,Default,,0,0,0,,Менің ойымша, мұндай нәрсе болуы мүмкін бе...
Dialogue: 0,0:07:12.01,0:07:16.35,Default,,0,0,0,,Мен оларды бұрын бірге сатып алдым, бұл жақсы идея болды!
Dialogue: 0,0:07:16.43,0:07:17.89,Default,,0,0,0,,Толық қалпына келтіру!
Dialogue: 0,0:07:17.97,0:07:20.06,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:07:20.69,0:07:21.73,Default,,0,0,0,,Уф!
Dialogue: 0,0:07:21.81,0:07:23.27,Default,,0,0,0,,Аа...
Dialogue: 0,0:07:23.86,0:07:26.44,Default,,0,0,0,,Менің дағдыларымды Гунпла құру арқылы үйрендім...
Dialogue: 0,0:07:26.52,0:07:28.57,Default,,0,0,0,,Бұл пайдалы болғандықтан...
Dialogue: 0,0:07:28.65,0:07:29.90,Default,,0,0,0,,Жарақатым жазылды, сондықтан бүгіннен бастап қалыпты мектеп кестесіне оралдым.
Dialogue: 0,0:07:30.65,0:07:33.32,Default,,0,0,0,,-Міне, міне, мынау... -(Фуюки) Ах!
Dialogue: 0,0:07:33.41,0:07:34.82,Default,,0,0,0,,Құсу!
Dialogue: 0,0:07:35.41,0:07:38.12,Default,,0,0,0,,Бұл әдейі емес!
Dialogue: 0,0:07:39.41,0:07:43.58,Default,,0,0,0,,Мира Мира Мира Мира Мира
Dialogue: 0,0:07:43.67,0:07:45.29,Default,,0,0,0,,Мен үйдемін~
Dialogue: 0,0:07:45.38,0:07:46.59,Default,,0,0,0,,Қазіргі уақытта қол жетімді
Dialogue: 0,0:07:46.67,0:07:50.01,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:07:50.09,0:07:51.47,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:07:51.55,0:07:52.09,Default,,0,0,0,,Жарақатым жазылды, сондықтан бүгіннен бастап қалыпты мектеп кестесіне оралдым.
Dialogue: 0,0:07:52.68,0:07:56.39,Default,,0,0,0,,Сонымен, бүгін тазалықта кім кезекшілікте болды?
Dialogue: 0,0:07:57.18,0:07:57.89,Default,,0,0,0,,Эй?
Dialogue: 0,0:07:57.97,0:08:00.10,Default,,0,0,0,,На... Нацуми-доно
Dialogue: 0,0:08:00.18,0:08:02.89,Default,,0,0,0,,Содан үйге келе жатқанда күтпеген оғаш оқиға болды...
Dialogue: 0,0:08:02.98,0:08:04.52,Default,,0,0,0,,- Құсу~! -(Нацуми) Ештеңе айтпа.
Dialogue: 0,0:08:04.60,0:08:05.56,Default,,0,0,0,,Оны тез орындаңыз
Dialogue: 0,0:08:05.65,0:08:06.40,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,0:08:06.48,0:08:08.77,Default,,0,0,0,,Гимнастикалық снайпер Жеке спорт залы снайпер тапсырысы
Dialogue: 0,0:08:08.86,0:08:09.78,Default,,0,0,0,,Снайперге арналған жаттығу залы
Dialogue: 0,0:08:09.86,0:08:11.28,Default,,0,0,0,,Жаса, жаса, жаса!
Dialogue: 0,0:08:13.65,0:08:14.53,Default,,0,0,0,,Барлық машиналар жойылды!
Dialogue: 0,0:08:14.61,0:08:15.28,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:08:15.36,0:08:17.78,Default,,0,0,0,,Тама тама тама тама Тама тама тама тама!
Dialogue: 0,0:08:17.87,0:08:19.08,Default,,0,0,0,,Мен анаммен де, әкеммен де сөйлестім—
Dialogue: 0,0:08:19.16,0:08:21.91,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:08:22.00,0:08:22.62,Default,,0,0,0,,Тама?
Dialogue: 0,0:08:23.12,0:08:24.79,Default,,0,0,0,,-Куккук~ -Хмм?
Dialogue: 0,0:08:24.87,0:08:28.21,Default,,0,0,0,,Енді сіз Пекопон шабуылын 38 рет жойдыңыз.
Dialogue: 0,0:08:28.29,0:08:29.30,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:29.38,0:08:31.09,Default,,0,0,0,,Жаңарту жазу керек пе?
Dialogue: 0,0:08:31.17,0:08:35.05,Default,,0,0,0,,Сержантсыз жаттығу мүмкін емес еді.
Dialogue: 0,0:08:35.13,0:08:37.72,Default,,0,0,0,,Дороро да қатысады, бұл сирек кездеседі.
Dialogue: 0,0:08:37.80,0:08:39.43,Default,,0,0,0,,Хекшун
Dialogue: 0,0:08:39.93,0:08:42.98,Default,,0,0,0,,Жуынатын бөлмені тазалағаннан кейін денем әбден суып кетті.
Dialogue: 0,0:08:43.06,0:08:46.48,Default,,0,0,0,,Бірақ енді мен спорт залының снайперінің әдет-ғұрпын жасай аламын
Dialogue: 0,0:08:46.56,0:08:48.65,Default,,0,0,0,,Мен өзімді арнай аламын
Dialogue: 0,0:08:48.73,0:08:49.90,Default,,0,0,0,,Хаа~
Dialogue: 0,0:08:49.98,0:08:50.48,Default,,0,0,0,,Жарақатым жазылды, сондықтан бүгіннен бастап қалыпты мектеп кестесіне оралдым.
Dialogue: 0,0:08:51.86,0:08:52.74,Default,,0,0,0,,Күн шуақты ма?
Dialogue: 0,0:08:53.49,0:08:55.15,Default,,0,0,0,,Хмм... уф
Dialogue: 0,0:08:58.74,0:09:01.41,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:09:01.49,0:09:04.33,Default,,0,0,0,,Каппа аңызы Жер астындағы алып саз мүсіні
Dialogue: 0,0:09:04.41,0:09:06.42,Default,,0,0,0,,Ал бүгінгі жұмбақ ғибадатхана
Dialogue: 0,0:09:06.50,0:09:09.92,Default,,0,0,0,,Басқаша айтқанда, паранормальды құбылыс нүктелері Оку-Токио қаласында шоғырланған.
Dialogue: 0,0:09:10.00,0:09:11.42,Default,,0,0,0,,-Фуюки ше? -(Фуюки) А?
Dialogue: 0,0:09:11.50,0:09:13.88,Default,,0,0,0,,Әй, эй, мынаны қара!
Dialogue: 0,0:09:13.97,0:09:14.84,Default,,0,0,0,,Бұл...
Dialogue: 0,0:09:14.92,0:09:15.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:15.51,0:09:16.84,Default,,0,0,0,,Иә...
Dialogue: 0,0:09:18.51,0:09:20.10,Default,,0,0,0,,Сондықтан ~
Dialogue: 0,0:09:20.18,0:09:22.56,Default,,0,0,0,,Үйкесем де, мүлдем алып тастай алмаймын.
Dialogue: 0,0:09:22.64,0:09:24.14,Default,,0,0,0,,Сіз мұны істесеңіз де
Dialogue: 0,0:09:24.23,0:09:26.64,Default,,0,0,0,,Аа, не істесем де, оны түсіре алмаймын.
Dialogue: 0,0:09:26.73,0:09:27.73,Default,,0,0,0,,Я~
Dialogue: 0,0:09:27.81,0:09:28.44,Default,,0,0,0,,Құсу…
Dialogue: 0,0:09:28.52,0:09:29.94,Default,,0,0,0,,Куу~!
Dialogue: 0,0:09:30.02,0:09:33.07,Default,,0,0,0,,Бұл не? Сіз мені сәтсіз деп айтасыз ба?
Dialogue: 0,0:09:33.15,0:09:35.82,Default,,0,0,0,,Менің адамгершілігім нашар деу керек пе?
Dialogue: 0,0:09:35.90,0:09:37.78,Default,,0,0,0,,Менен сұрасаң, қиналып қалдым.
Dialogue: 0,0:09:37.86,0:09:38.74,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:09:38.82,0:09:39.95,Default,,0,0,0,,Құсу...
Dialogue: 0,0:09:40.03,0:09:42.03,Default,,0,0,0,,А, иә, иә
Dialogue: 0,0:09:42.12,0:09:44.37,Default,,0,0,0,,Бір ғана адам инвазияға дайындықты тоқтатып жатыр.
Dialogue: 0,0:09:44.45,0:09:46.29,Default,,0,0,0,,Мен Гунпланы жасауға тырыстым.
Dialogue: 0,0:09:46.37,0:09:48.67,Default,,0,0,0,,Мен де ұзақ уақыт дәретхана қағазын қолданамын.
Dialogue: 0,0:09:48.75,0:09:51.04,Default,,0,0,0,,Бұл соншалықты нашар емес пе?
Dialogue: 0,0:09:51.54,0:09:55.17,Default,,0,0,0,,Бұған кімнің құқығы бар?
Dialogue: 0,0:09:55.26,0:09:56.97,Default,,0,0,0,,О... жоқ, күте тұрыңыз.
Dialogue: 0,0:09:57.72,0:10:01.22,Default,,0,0,0,,Бұл не? Ауыр ауру.
Dialogue: 0,0:10:01.30,0:10:02.64,Default,,0,0,0,,…Мүмкін!
Dialogue: 0,0:10:02.72,0:10:04.27,Default,,0,0,0,,Сержант, мен оны көрмеймін.
Dialogue: 0,0:10:04.35,0:10:05.60,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:10:05.68,0:10:08.98,Default,,0,0,0,,Мына жерге қара, мына жерге мұқият қара~
Dialogue: 0,0:10:09.06,0:10:11.02,Default,,0,0,0,,Штанга өте анық...
Dialogue: 0,0:10:11.11,0:10:11.61,Default,,0,0,0,,Жарақатым жазылды, сондықтан бүгіннен бастап қалыпты мектеп кестесіне оралдым.
Dialogue: 0,0:10:12.23,0:10:13.73,Default,,0,0,0,,Фуюки-доно…
Dialogue: 0,0:10:14.69,0:10:16.94,Default,,0,0,0,,Аа, дұрыс, дұрыс!
Dialogue: 0,0:10:17.45,0:10:19.70,Default,,0,0,0,,Фуюки-доно үшін мен туралы ештеңе маңызды емес.
Dialogue: 0,0:10:19.78,0:10:24.08,Default,,0,0,0,,Бұл оның ноутбукке қарағанда жеңіл және жұқа екенін білдіре ме?
Dialogue: 0,0:10:24.16,0:10:25.62,Default,,0,0,0,,Бұл өнімділігі жоғары өнім.
Dialogue: 0,0:10:25.70,0:10:27.12,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:10:27.20,0:10:29.62,Default,,0,0,0,,Менен енді сұрамасаң жақсы!
Dialogue: 0,0:10:32.71,0:10:33.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:37.13,0:10:40.55,Default,,0,0,0,,Иә? иә? Сержант?
Dialogue: 0,0:10:40.63,0:10:42.39,Default,,0,0,0,,Хаа~
Dialogue: 0,0:10:43.64,0:10:47.68,Default,,0,0,0,,Сәлем Нацуми-доно
Dialogue: 0,0:10:47.77,0:10:51.56,Default,,0,0,0,,Менің бетіме кенет ілмек пайда болды.
Dialogue: 0,0:10:51.65,0:10:54.57,Default,,0,0,0,,Иә? Шынымен бе? Бұл мүмкін емес.
Dialogue: 0,0:10:54.65,0:10:55.82,Default,,0,0,0,,На... Нацуми-доно
Dialogue: 0,0:10:56.48,0:10:57.40,Default,,0,0,0,,Дұрыс! Дұрыс!
Dialogue: 0,0:10:57.49,0:11:00.65,Default,,0,0,0,,Менің жолдасым ешқандай қателік жасаған жоқ, сондықтан оның қабылданбауы мүмкін емес, солай ма?
Dialogue: 0,0:11:00.74,0:11:01.32,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:01.41,0:11:05.45,Default,,0,0,0,,Ұялы телефоныңызды ваннада ұстауға болмайды...
Dialogue: 0,0:11:05.53,0:11:06.37,Default,,0,0,0,,Құсу!
Dialogue: 0,0:11:07.04,0:11:07.87,Default,,0,0,0,,Құсу…
Dialogue: 0,0:11:07.95,0:11:10.08,Default,,0,0,0,,Мо~ Бұлыңғыр бақа!
Dialogue: 0,0:11:13.13,0:11:14.59,Default,,0,0,0,,Қарсымын!
Dialogue: 0,0:11:14.67,0:11:17.30,Default,,0,0,0,,Жақында сіз басқа толық емес жұмыс табасыз.
Dialogue: 0,0:11:17.38,0:11:19.30,Default,,0,0,0,,Оған дейін, Сүйікті, мен бар күшімді саламын.
Dialogue: 0,0:11:19.80,0:11:21.30,Default,,0,0,0,,Мен Вайолет Эвергарден деген осы қызды толық түсіне алмадым—
Dialogue: 0,0:11:21.38,0:11:25.51,Default,,0,0,0,,) Ха~хахаха...
Dialogue: 0,0:11:25.60,0:11:28.47,Default,,0,0,0,,Бұлай күйзелме, ағайын.
Dialogue: 0,0:11:28.56,0:11:34.40,Default,,0,0,0,,Өлтіру өлтіру өлтіру өлтіру ...
Dialogue: 0,0:11:35.69,0:11:37.65,Default,,0,0,0,,Ха~хахаха
Dialogue: 0,0:11:37.73,0:11:38.78,Default,,0,0,0,,- (Рабби) Иә? -(556) Нуу!
Dialogue: 0,0:11:38.86,0:11:40.28,Default,,0,0,0,,- (Рабби) Кя! -(556) Қалай!
Dialogue: 0,0:11:41.28,0:11:44.62,Default,,0,0,0,,- (556) Ха~хахахаха - (Рабби) Ах...
Dialogue: 0,0:11:45.91,0:11:46.62,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:48.29,0:11:51.04,Default,,0,0,0,,(Адамдар таң қалды)
Dialogue: 0,0:11:52.12,0:11:52.92,Default,,0,0,0,,Не? ток
Dialogue: 0,0:12:11.60,0:12:12.48,Default,,0,0,0,,Аа...
Dialogue: 0,0:12:14.44,0:12:15.81,Default,,0,0,0,,-(Күз) Мен үйдемін~ -Ха
Dialogue: 0,0:12:15.90,0:12:16.98,Default,,0,0,0,,О, Керо-чан
Dialogue: 0,0:12:17.06,0:12:18.57,Default,,0,0,0,,Құрметті анашым! Ах...
Dialogue: 0,0:12:18.65,0:12:21.40,Default,,0,0,0,,Мен енді ешкіммен сөйлеспеймін.
Dialogue: 0,0:12:21.49,0:12:24.28,Default,,0,0,0,,Олар бәрібір мені тыңдамайды.
Dialogue: 0,0:12:24.36,0:12:25.82,Default,,0,0,0,,Не болды? сол мұрын
Dialogue: 0,0:12:25.91,0:12:26.91,Default,,0,0,0,,Не!
Dialogue: 0,0:12:26.99,0:12:28.53,Default,,0,0,0,,Ма... Мен сенімдімін Мама-доно.
Dialogue: 0,0:12:28.62,0:12:30.83,Default,,0,0,0,,Мен сенің тыңдайтыныңа сендім.
Dialogue: 0,0:12:30.91,0:12:31.62,Default,,0,0,0,,Мегуми Фушигуро.
Dialogue: 0,0:12:31.70,0:12:33.41,Default,,0,0,0,,Әй, анашым, қош келдіңіз!
Dialogue: 0,0:12:33.50,0:12:35.21,Default,,0,0,0,,Дәл қазір теледидарда таңғаларлық нәрсе болып жатыр.
Dialogue: 0,0:12:35.29,0:12:37.21,Default,,0,0,0,,Әй, тез кел, бір қарап ал!
Dialogue: 0,0:12:37.29,0:12:40.42,Default,,0,0,0,,- (Күз) А? Не, не ғажап? - А? Ах...
Dialogue: 0,0:12:40.92,0:12:42.01,Default,,0,0,0,,Мүмкін бір күні сонда бірге ішеміз
Dialogue: 0,0:12:43.13,0:12:45.51,Default,,0,0,0,,Бірақ мен оның қандай теледидар екенін көргім келеді.
Dialogue: 0,0:12:45.59,0:12:49.18,Default,,0,0,0,,Өткен түннен бері Оку-Токио қаласында көптеген адамдар
Dialogue: 0,0:12:49.26,0:12:52.14,Default,,0,0,0,,Жұмбақ шамдармен кездесу оқиғаларының тізбегі
Dialogue: 0,0:12:52.22,0:12:54.06,Default,,0,0,0,,Және сол жарықпен
Dialogue: 0,0:12:54.14,0:12:56.02,Default,,0,0,0,,a белгісімен белгіленгендер
Dialogue: 0,0:12:56.10,0:12:58.27,Default,,0,0,0,,Табиғаттан тыс күштерге ие болды дейді.
Dialogue: 0,0:12:58.36,0:12:59.27,Default,,0,0,0,,Хахаха!
Dialogue: 0,0:12:59.36,0:13:01.15,Default,,0,0,0,,556-дағы баттен?
Dialogue: 0,0:13:01.23,0:13:02.65,Default,,0,0,0,,Қараңызшы, мен де.
Dialogue: 0,0:13:02.74,0:13:05.11,Default,,0,0,0,,На... Нацуми-доно да!
Dialogue: 0,0:13:05.20,0:13:06.66,Default,,0,0,0,,- (Фуюки) Мен де - Құсасың ба?
Dialogue: 0,0:13:06.74,0:13:08.66,Default,,0,0,0,,Таңертең оянғанда сол жерде болды.
Dialogue: 0,0:13:08.74,0:13:10.49,Default,,0,0,0,,Фуюки-доноға...
Dialogue: 0,0:13:10.58,0:13:12.50,Default,,0,0,0,,Сіз телепатияны пайдалана аласыз.
Dialogue: 0,0:13:12.58,0:13:14.08,Default,,0,0,0,,Интернетте көп шу бар.
Dialogue: 0,0:13:14.16,0:13:15.66,Default,,0,0,0,,Те...телепатия?
Dialogue: 0,0:13:15.75,0:13:16.92,Default,,0,0,0,,Онда мен сізді арттан сәл итермелеуге тура келеді —
Dialogue: 0,0:13:17.00,0:13:20.50,Default,,0,0,0,,Осы ілмекпен сіз ойша сөйлесе аласыз.
Dialogue: 0,0:13:21.00,0:13:21.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:22.88,0:13:23.55,Default,,0,0,0,,Әй?
Dialogue: 0,0:13:24.13,0:13:25.88,Default,,0,0,0,,Баттен бекітілген!
Dialogue: 0,0:13:25.97,0:13:28.47,Default,,0,0,0,,Менің де досым оны маған қосты.
Dialogue: 0,0:13:28.55,0:13:29.97,Default,,0,0,0,,Анама да беремін
Dialogue: 0,0:13:30.05,0:13:30.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:31.56,0:13:32.68,Default,,0,0,0,,Сонымен…
Dialogue: 0,0:13:39.27,0:13:40.15,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:13:40.65,0:13:42.32,Default,,0,0,0,,Сіз мені естисіз бе? анам
Dialogue: 0,0:13:42.40,0:13:43.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:43.32,0:13:45.61,Default,,0,0,0,,О, шынымен солай естіледі.
Dialogue: 0,0:13:45.69,0:13:47.11,Default,,0,0,0,,Мен де естіп тұрмын
Dialogue: 0,0:13:47.20,0:13:49.57,Default,,0,0,0,,Керемет, бұл біртүрлі.
Dialogue: 0,0:13:50.07,0:13:52.87,Default,,0,0,0,,Түсіндім, бұл ілмек бар
Dialogue: 0,0:13:53.95,0:13:57.50,Default,,0,0,0,,Сізде мұндай күш болды ма?
Dialogue: 0,0:13:59.46,0:14:00.88,Default,,0,0,0,,Бұл пайдалы!
Dialogue: 0,0:14:01.84,0:14:03.38,Default,,0,0,0,,Инвазия ықтималдығы
Dialogue: 0,0:14:03.46,0:14:04.76,Default,,0,0,0,,Барлығы жинал!
Dialogue: 0,0:14:04.84,0:14:05.84,Default,,0,0,0,,Міне кеттік!
Dialogue: 0,0:14:05.92,0:14:09.18,Default,,0,0,0,,құсу құсу құсу құсу құсу құсу құсу...
Dialogue: 0,0:14:09.26,0:14:10.76,Default,,0,0,0,,Жүр!
Dialogue: 0,0:14:11.43,0:14:12.26,Default,,0,0,0,,А, Тама?
Dialogue: 0,0:14:13.01,0:14:13.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:13.85,0:14:15.10,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:15.93,0:14:18.31,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:18.39,0:14:19.85,Default,,0,0,0,,Аспазшы~
Dialogue: 0,0:14:19.94,0:14:21.81,Default,,0,0,0,,Аға керемет
Dialogue: 0,0:14:21.90,0:14:23.77,Default,,0,0,0,,Теюука Ишинденшин?
Dialogue: 0,0:14:23.86,0:14:26.19,Default,,0,0,0,,Ия, сержант-сан екеуің сәйкес келеді.
Dialogue: 0,0:14:26.28,0:14:26.78,Default,,0,0,0,,♬ Ора ора ора ора, ора ора ора ора
Dialogue: 0,0:14:26.86,0:14:29.86,Default,,0,0,0,,Жақында менімен сырласайық.
Dialogue: 0,0:14:29.95,0:14:30.82,Default,,0,0,0,,Аспаз Аспаз аспаз
Dialogue: 0,0:14:30.91,0:14:33.37,Default,,0,0,0,,Өйткені, мен бұған сенімді емеспін.
Dialogue: 0,0:14:33.45,0:14:34.70,Default,,0,0,0,,Миссия үшін,
Dialogue: 0,0:14:34.79,0:14:37.54,Default,,0,0,0,,Латан бүкіл Пекопонға тараған кезде
Dialogue: 0,0:14:37.62,0:14:40.58,Default,,0,0,0,,Менен бұйрық жіберіп, оны күшейт.
Dialogue: 0,0:14:40.67,0:14:43.29,Default,,0,0,0,,Барлығын бірден Пекопон халқына жіберіңіз
Dialogue: 0,0:14:43.38,0:14:45.75,Default,,0,0,0,,...Көзді ашып-жұмғанша Пекопон халқы
Dialogue: 0,0:14:45.84,0:14:48.38,Default,,0,0,0,,Мен өз бақылауымда боламын.
Dialogue: 0,0:14:48.47,0:14:50.88,Default,,0,0,0,,Бұл тізбекті реакция ма?
Dialogue: 0,0:14:51.39,0:14:53.89,Default,,0,0,0,,Күшейткіш құрылғыны жасау
Dialogue: 0,0:14:53.97,0:14:56.52,Default,,0,0,0,,Оңай Бұл тым оңай
Dialogue: 0,0:14:56.60,0:14:57.56,Default,,0,0,0,,Хе-хе-хе.
Dialogue: 0,0:14:57.64,0:15:02.02,Default,,0,0,0,,Олай болса, Пекопон халқын қалай басқарасың?
Dialogue: 0,0:15:02.10,0:15:04.27,Default,,0,0,0,,А, иә, мен сенен бірдеңе сұрайын.
Dialogue: 0,0:15:04.90,0:15:06.15,Default,,0,0,0,,Дұрыс~
Dialogue: 0,0:15:06.23,0:15:09.36,Default,,0,0,0,,Біріншіден, мен сізге талай рет амалсыздан жасалған үй шаруасына көмектесуге рұқсат етіңіз.
Dialogue: 0,0:15:09.45,0:15:11.91,Default,,0,0,0,,Мен Нацуми-доноға бірдеңені қайтарғым келеді.
Dialogue: 0,0:15:11.99,0:15:14.03,Default,,0,0,0,,Мен анама қалта ақшасын көбейтуді бұйырдым.
Dialogue: 0,0:15:14.12,0:15:17.37,Default,,0,0,0,,Бүкіл елдегі ойыншық дүкендерінде жақсырақ gunpla бөлімдері болуы керек...
Dialogue: 0,0:15:17.45,0:15:21.08,Default,,0,0,0,,Жоқ, тікелей Гунпла зауытына нұсқау беріңіз.
Dialogue: 0,0:15:21.17,0:15:23.04,Default,,0,0,0,,Мен қалағандай мобильді костюм.
Dialogue: 0,0:15:23.13,0:15:25.09,Default,,0,0,0,,Мен оны Gunpla үлгісіне айналдырамын.
Dialogue: 0,0:15:25.17,0:15:27.80,Default,,0,0,0,,Бұл әлі де менің кішіпейіл шапқыншылығым.
Dialogue: 0,0:15:27.88,0:15:31.05,Default,,0,0,0,,Сержант күткендей! Өте керемет!
Dialogue: 0,0:15:31.13,0:15:32.68,Default,,0,0,0,,- Хаа... - Құсу құсу
Dialogue: 0,0:15:32.76,0:15:33.80,Default,,0,0,0,,Кероро-кун
Dialogue: 0,0:15:33.89,0:15:37.31,Default,,0,0,0,,«Маған да берші»...
Dialogue: 0,0:15:37.89,0:15:41.19,Default,,0,0,0,,Мен бұл сөзді үнемі айта алмаймын.
Dialogue: 0,0:15:43.44,0:15:45.19,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:15:50.49,0:15:51.57,Default,,0,0,0,,Мақсатты растау
Dialogue: 0,0:15:51.65,0:15:53.57,Default,,0,0,0,,Барлық командалар күту режимінде
Dialogue: 0,0:15:53.66,0:15:55.57,Default,,0,0,0,,Жарайды, операцияны бастаңыз
Dialogue: 0,0:15:56.28,0:15:57.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:05.88,0:16:06.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:06.71,0:16:08.67,Default,,0,0,0,,Бүгін таңертең не болды? иә?
Dialogue: 0,0:16:26.06,0:16:28.19,Default,,0,0,0,,Қайырлы таң, Фуюки-кун
Dialogue: 0,0:16:28.27,0:16:31.69,Default,,0,0,0,,То... Нишизава-сан Қайырлы таң
Dialogue: 0,0:16:31.78,0:16:33.32,Default,,0,0,0,,Ум...
Dialogue: 0,0:16:33.40,0:16:35.53,Default,,0,0,0,,Ал, мен бірінші барамын.
Dialogue: 0,0:16:35.61,0:16:36.91,Default,,0,0,0,,Уақытыңызды алыңыз~
Dialogue: 0,0:16:36.99,0:16:37.91,Default,,0,0,0,,Иә
Dialogue: 0,0:16:38.41,0:16:43.96,Default,,0,0,0,,А-а... мм... Мен оны Фуюки-кун кигенін қалаймын.
Dialogue: 0,0:16:44.04,0:16:44.58,Default,,0,0,0,,Бұл
Dialogue: 0,0:16:44.67,0:16:47.33,Default,,0,0,0,,Не? О, Баттен
Dialogue: 0,0:16:47.84,0:16:48.50,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:16:48.59,0:16:50.17,Default,,0,0,0,,Хааа~
Dialogue: 0,0:16:50.25,0:16:52.97,Default,,0,0,0,,Мен сол баттаны алған кезде біздің жүрегіміз қосылды.
Dialogue: 0,0:16:53.05,0:16:54.72,Default,,0,0,0,,Соңында мойындау!
Dialogue: 0,0:16:54.80,0:16:56.51,Default,,0,0,0,,Махаббат махаббат бақытты ма?
Dialogue: 0,0:16:57.18,0:16:58.43,Default,,0,0,0,,Эмилия ханым, жоспар бойынша айдаһар арбасымен эвакуацияланыңыз.
Dialogue: 0,0:16:58.51,0:17:01.64,Default,,0,0,0,,Басқа адамдарға Момока-самаға таяқшаны бекітуге жол бермеңіз⸺
Dialogue: 0,0:17:01.72,0:17:04.44,Default,,0,0,0,,Бүгін бізде арнайы қауіпсіздік жүйесі бар.
Dialogue: 0,0:17:04.52,0:17:07.02,Default,,0,0,0,,Сонымен... солай болды ма?
Dialogue: 0,0:17:07.10,0:17:08.06,Default,,0,0,0,,Жарайды, мен саған жіберемін.
Dialogue: 0,0:17:08.15,0:17:11.07,Default,,0,0,0,,Иә, өтінемін
Dialogue: 0,0:17:11.15,0:17:14.11,Default,,0,0,0,,Оны Нишизава мырзаға жеткізіңіз!
Dialogue: 0,0:17:14.19,0:17:17.07,Default,,0,0,0,,Жеткізу… Жеткізу… Жеткізу…
Dialogue: 0,0:17:17.16,0:17:18.91,Default,,0,0,0,,Фуюки-кун…
Dialogue: 0,0:17:19.49,0:17:20.74,Default,,0,0,0,,Ол келді ме?
Dialogue: 0,0:17:20.83,0:17:21.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:22.79,0:17:23.75,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:23.83,0:17:26.37,Default,,0,0,0,,Енді Момокки барлығына қосылады.
Dialogue: 0,0:17:26.46,0:17:29.13,Default,,0,0,0,,Тама... Тама-чан, мен білмей тұрып
Dialogue: 0,0:17:29.21,0:17:30.34,Default,,0,0,0,,Егер сіз мұны кисеңіз
Dialogue: 0,0:17:30.42,0:17:34.01,Default,,0,0,0,,Мен сенімен кез келген уақытта, кез келген жерде табиғаттан тыс күштерімді пайдаланып сөйлесе аламын.
Dialogue: 0,0:17:35.01,0:17:38.18,Default,,0,0,0,,Эй, сен мені естисің бе? Момокки
Dialogue: 0,0:17:38.68,0:17:40.26,Default,,0,0,0,,Не деген...
Dialogue: 0,0:17:40.35,0:17:43.64,Default,,0,0,0,,Мен мұны білемін, Тамако!
Dialogue: 0,0:17:43.72,0:17:44.52,Default,,0,0,0,,Тама…
Dialogue: 0,0:17:44.60,0:17:47.31,Default,,0,0,0,,Мен сенің ашулы жүрегіңді көріп тұрмын!
Dialogue: 0,0:17:47.39,0:17:47.94,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:48.02,0:17:51.77,Default,,0,0,0,,Мен үшін Фуюки-дононың балтасынан не пайда болады деп ойлаймын!
Dialogue: 0,0:17:51.86,0:17:53.90,Default,,0,0,0,,Тама~!
Dialogue: 0,0:17:54.40,0:17:56.90,Default,,0,0,0,,- (Момока) Ха ха ха ха... - (Фуюки) Ха ха ха...
Dialogue: 0,0:17:56.99,0:17:59.20,Default,,0,0,0,,- (Фуюки) А... анау Нишизава мырза? -(Момока) Ха!
Dialogue: 0,0:17:59.82,0:18:01.33,Default,,0,0,0,,Кешіріңіз, Фуюки-кун.
Dialogue: 0,0:18:01.41,0:18:03.79,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:18:07.79,0:18:09.08,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:18:12.17,0:18:14.13,Default,,0,0,0,,Эй, Мирай-сан, сен мені естисің бе?
Dialogue: 0,0:18:14.21,0:18:16.09,Default,,0,0,0,,Уау, мен естіп тұрмын, Вакана-сан.
Dialogue: 0,0:18:16.80,0:18:18.38,Default,,0,0,0,,Нацуми-санмен сәйкестік
Dialogue: 0,0:18:18.47,0:18:20.47,Default,,0,0,0,,Мен бақыттымын! Уууу
Dialogue: 0,0:18:20.55,0:18:22.81,Default,,0,0,0,,Олай болса табиғаттан тыс күштеріңізді байқап көріңіз.
Dialogue: 0,0:18:22.89,0:18:23.39,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:27.48,0:18:30.73,Default,,0,0,0,,Коюки-чан, сен менің дауысымды естисің бе?
Dialogue: 0,0:18:30.81,0:18:31.81,Default,,0,0,0,,Иә
Dialogue: 0,0:18:31.90,0:18:34.19,Default,,0,0,0,,Сонымен, Коюки-чанға не ұнайды?
Dialogue: 0,0:18:34.27,0:18:35.82,Default,,0,0,0,,Нацуми-сан
Dialogue: 0,0:18:35.90,0:18:39.11,Default,,0,0,0,,Не? Эй, сен мені дұрыс ести аласың ба?
Dialogue: 0,0:18:39.20,0:18:40.86,Default,,0,0,0,,Иә, мен сізді естимін.
Dialogue: 0,0:18:40.95,0:18:43.83,Default,,0,0,0,,Иә? Мен тағы барамын
Dialogue: 0,0:18:46.33,0:18:48.08,Default,,0,0,0,,Коюки-чанға не ұнайды?
Dialogue: 0,0:18:48.16,0:18:49.92,Default,,0,0,0,,Нацуми-сан
Dialogue: 0,0:18:50.42,0:18:52.46,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:18:52.54,0:18:54.59,Default,,0,0,0,,Менің ойымша, біз жақсы араласпай жатырмыз.
Dialogue: 0,0:18:54.67,0:18:55.67,Default,,0,0,0,,Уау
Dialogue: 0,0:19:02.43,0:19:03.60,Default,,0,0,0,,-(Нацуми) Мен үйдемін~ -Ня?
Dialogue: 0,0:19:04.39,0:19:07.22,Default,,0,0,0,,Уау~ Сіз тағы да алаңдататын нәрсені таратып жатырсыз.
Dialogue: 0,0:19:07.85,0:19:10.14,Default,,0,0,0,,Әй, сен де Джиророға бөрене қостың ба?
Dialogue: 0,0:19:10.23,0:19:10.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:10.81,0:19:12.60,Default,,0,0,0,,Ах... мынау...
Dialogue: 0,0:19:12.69,0:19:15.15,Default,,0,0,0,,Олай болса менімен психикалық күшімді пайдаланып сөйлесейік.
Dialogue: 0,0:19:15.23,0:19:15.73,Default,,0,0,0,,Не!
Dialogue: 0,0:19:15.82,0:19:18.74,Default,,0,0,0,,Не? О... мен және Нацуми?
Dialogue: 0,0:19:18.82,0:19:20.99,Default,,0,0,0,,Жоқ... доғар, ақымақ.
Dialogue: 0,0:19:21.07,0:19:22.36,Default,,0,0,0,,Нацуми, тоқта, тоқта.
Dialogue: 0,0:19:23.24,0:19:25.99,Default,,0,0,0,,Эй, тоқта!
Dialogue: 0,0:19:26.49,0:19:28.50,Default,,0,0,0,,Жироға не ұнайды?
Dialogue: 0,0:19:30.54,0:19:32.50,Default,,0,0,0,,На... Нацуми
Dialogue: 0,0:19:32.58,0:19:33.92,Default,,0,0,0,,Тағы да?
Dialogue: 0,0:19:34.00,0:19:36.13,Default,,0,0,0,,Әй, мұқият тыңдап тұрсың ба?
Dialogue: 0,0:19:36.21,0:19:39.05,Default,,0,0,0,,Мен мұны жақсы емеспін бе?
Dialogue: 0,0:19:39.13,0:19:41.88,Default,,0,0,0,,Жироның жүрегі Нацуми-чан хабарсыз
Dialogue: 0,0:19:41.97,0:19:42.63,Default,,0,0,0,,Бугья
Dialogue: 0,0:19:43.51,0:19:44.18,Default,,0,0,0,,Хмф!
Dialogue: 0,0:19:49.98,0:19:51.89,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:53.56,0:19:54.90,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:54.98,0:19:56.90,Default,,0,0,0,,Бұл Лево Комисул.
Dialogue: 0,0:19:56.98,0:19:58.40,Default,,0,0,0,,Ребо Коми~!
Dialogue: 0,0:19:58.48,0:20:00.69,Default,,0,0,0,,Ребо Коми ең жақсысы ма?
Dialogue: 0,0:20:00.78,0:20:02.15,Default,,0,0,0,,Керемет!
Dialogue: 0,0:20:02.24,0:20:03.32,Default,,0,0,0,,Ах! қазір
Dialogue: 0,0:20:03.41,0:20:05.28,Default,,0,0,0,,Біз не үшін шығамыз?
Dialogue: 0,0:20:05.37,0:20:06.83,Default,,0,0,0,,Сіз солай ойладыңыз, солай ма?
Dialogue: 0,0:20:06.91,0:20:10.04,Default,,0,0,0,,Мен барлығының не ойлайтынын толық түсінемін.
Dialogue: 0,0:20:10.95,0:20:13.08,Default,,0,0,0,,Оны революцияшыл деп атайды ма?
Dialogue: 0,0:20:13.17,0:20:14.37,Default,,0,0,0,,Бұны киген адам
Dialogue: 0,0:20:14.46,0:20:15.08,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:20:15.17,0:20:16.71,Default,,0,0,0,,Өйткені бұл револютордың байланысы.
Dialogue: 0,0:20:16.79,0:20:17.54,Default,,0,0,0,,Лебо Коми
Dialogue: 0,0:20:17.63,0:20:19.25,Default,,0,0,0,,Ұялы телефондар мен Интернеттен тыс⸺
Dialogue: 0,0:20:19.34,0:20:21.72,Default,,0,0,0,,Бұл адамзаттың ұлы эволюциясы ғана емес пе?
Dialogue: 0,0:20:21.80,0:20:22.55,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:20:22.63,0:20:23.88,Default,,0,0,0,,Лебо Коми...
Dialogue: 0,0:20:32.48,0:20:39.48,Default,,0,0,0,,Өлтіру өлтіру өлтіру өлтіру ...
Dialogue: 0,0:20:54.04,0:20:54.67,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:59.09,0:21:00.67,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:05.26,0:21:08.14,Default,,0,0,0,,Хмм…
Dialogue: 0,0:21:15.69,0:21:16.44,Default,,0,0,0,,Қайырлы таң~
Dialogue: 0,0:21:19.52,0:21:22.44,Default,,0,0,0,,Иә? не болды? Барлығы
Dialogue: 0,0:21:22.53,0:21:25.78,Default,,0,0,0,,Неліктен мен біртүрлі дауыстарды естимін?
Dialogue: 0,0:21:25.86,0:21:28.45,Default,,0,0,0,,Сіздің сынақ ұпайыңыз барлығына белгілі болады.
Dialogue: 0,0:21:29.07,0:21:32.95,Default,,0,0,0,,Мен не болды деп ойлаймын. Мен тек жаман дауыстарды естимін.
Dialogue: 0,0:21:33.87,0:21:35.83,Default,,0,0,0,,Сәтсіз қалдыңыз...
Dialogue: 0,0:21:36.33,0:21:37.37,Default,,0,0,0,,Артық емес...
Dialogue: 0,0:21:37.46,0:21:38.46,Default,,0,0,0,,Барлығы біледі
Dialogue: 0,0:21:38.54,0:21:40.38,Default,,0,0,0,,Телепатия болса
Dialogue: 0,0:21:40.46,0:21:42.96,Default,,0,0,0,,Бізге полиция керек емес, солай ма?
Dialogue: 0,0:21:43.05,0:21:45.47,Default,,0,0,0,,Оны да тоқтатыңыз.
Dialogue: 0,0:21:45.55,0:21:47.47,Default,,0,0,0,,Ән айтпасаң да
Dialogue: 0,0:21:47.55,0:21:49.93,Default,,0,0,0,,Оны барлығы ести алады
Dialogue: 0,0:21:50.01,0:21:51.56,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:21:51.64,0:21:53.60,Default,,0,0,0,,Маған хабар таратудың қажеті жоқ.
Dialogue: 0,0:21:56.77,0:21:58.27,Default,,0,0,0,,Тек өзара зұлымдық⸺
Dialogue: 0,0:21:58.35,0:22:00.73,Default,,0,0,0,,Бүкіл қала тұрғындары қабылдай бастады
Dialogue: 0,0:22:00.81,0:22:04.36,Default,,0,0,0,,Мен басқалармен араласудан алшақтай бастадым.
Dialogue: 0,0:22:12.12,0:22:14.20,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:22:14.29,0:22:17.62,Default,,0,0,0,,Бауырым, көп уайымдама!
Dialogue: 0,0:22:17.71,0:22:19.92,Default,,0,0,0,,2-3 ерекшелік бар сияқты...
Dialogue: 0,0:22:20.00,0:22:22.84,Default,,0,0,0,,Қолыңыздан келгеннің барлығын көбірек жасаңыз.
Dialogue: 0,0:22:22.92,0:22:25.71,Default,,0,0,0,,Чи~ Уайымдауға уақытым жоқ~
Dialogue: 0,0:22:26.72,0:22:29.13,Default,,0,0,0,,Не болды?
Dialogue: 0,0:22:29.22,0:22:29.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:43.82,0:22:46.23,Default,,0,0,0,,Бұл не? Бұл
Dialogue: 0,0:23:00.87,0:23:04.09,Default,,0,0,0,,Олар біздің соңғы үмітіміз
Dialogue: 0,0:23:05.17,0:23:06.59,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:23:07.96,0:23:09.22,Default,,0,0,0,,Бұл аяқталды!
Dialogue: 0,0:23:09.30,0:23:11.76,Default,,0,0,0,,А, тамаша.
Dialogue: 0,0:23:12.51,0:23:14.85,Default,,0,0,0,,Пекопон шабуылының соңғы қаруы
Dialogue: 0,0:23:14.93,0:23:17.27,Default,,0,0,0,,Менің командам өте қуатты күшейту машинасы
Dialogue: 0,0:23:17.97,0:23:19.31,Default,,0,0,0,,Соңында аяқталды!
Dialogue: 0,0:23:19.81,0:23:21.27,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:23:21.35,0:23:22.77,Default,,0,0,0,,-Аа... -Аспазшы~
Dialogue: 0,0:23:22.85,0:23:25.19,Default,,0,0,0,,Іске қосу уақыты келді!
Dialogue: 0,0:23:25.27,0:23:25.77,Default,,0,0,0,,т.б.
Dialogue: 0,0:23:26.40,0:23:28.82,Default,,0,0,0,,Мен бәрін талқандаймын!\NБұл
Dialogue: 0,0:23:28.90,0:23:30.03,Default,,0,0,0,,сияқты емес...
Dialogue: 0,0:23:30.11,0:23:31.53,Default,,0,0,0,,-Бұл? -хехе
Dialogue: 0,0:23:31.61,0:23:35.08,Default,,0,0,0,,Кепілдік талон нұсқаулықпен бірге беріледі.
Dialogue: 0,0:23:35.16,0:23:37.62,Default,,0,0,0,,Мен түні бойы ұйықтамай жатырмын, сондықтан ұйықтауға рұқсат етемін.
Dialogue: 0,0:23:37.70,0:23:38.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:39.58,0:23:42.54,Default,,0,0,0,,Ал, байқап көрейік.
Dialogue: 0,0:23:47.63,0:23:51.63,Default,,0,0,0,,Әпке, мен енді теледидарды да көрмеймін.
Dialogue: 0,0:23:52.84,0:23:55.35,Default,,0,0,0,,Бәрі де, бәрі де осының кесірінен!
Dialogue: 0,0:23:57.06,0:23:57.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:07.65,0:24:08.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:24:10.94,0:24:12.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:26.25,0:24:28.55,Default,,0,0,0,,Алдымен негізгі қуатты қосыңыз...
Dialogue: 0,0:24:29.05,0:24:30.30,Default,,0,0,0,,Коммутатор қайда орналасқан?
Dialogue: 0,0:24:30.38,0:24:31.84,Default,,0,0,0,,- (Нацуми) Эй, бұлдыр бақа! -Керо?
Dialogue: 0,0:24:32.51,0:24:34.01,Default,,0,0,0,,- Құсу~! -Уау
Dialogue: 0,0:24:35.01,0:24:36.39,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:24:36.47,0:24:39.43,Default,,0,0,0,,Осы қиын уақытта не істеп жатырсың?
Dialogue: 0,0:24:39.51,0:24:41.31,Default,,0,0,0,,Үйіңді тез қайтар!
Dialogue: 0,0:24:41.39,0:24:42.64,Default,,0,0,0,,- (Сөйлеуші: Мирала) Мира Мира... - (Барлығы) А?
Dialogue: 0,0:24:42.73,0:24:45.40,Default,,0,0,0,,Мира Мира Мира Мира…
Dialogue: 0,0:24:45.48,0:24:46.48,Default,,0,0,0,,- Құсу? -Уау
Dialogue: 0,0:24:47.19,0:24:47.90,Default,,0,0,0,,Дионың Рух толқынының шынайы табиғатын қалай ашуға болады
Dialogue: 0,0:24:47.98,0:24:49.57,Default,,0,0,0,,Не... бұл не?
Dialogue: 0,0:24:49.65,0:24:50.48,Default,,0,0,0,,Бұл жігіт...
Dialogue: 0,0:24:50.57,0:24:55.57,Default,,0,0,0,,Бұл Пекопондағы жер астынан табылған көне бөтен қару ма?
Dialogue: 0,0:24:55.66,0:24:56.99,Default,,0,0,0,,Менің атым Мирала
Dialogue: 0,0:24:57.07,0:25:01.12,Default,,0,0,0,,Мен Керон әскерінің ежелгі қару зерттеушісімін.
Dialogue: 0,0:25:02.08,0:25:03.50,Default,,0,0,0,,- Иә? - Мирала?
Dialogue: 0,0:25:03.58,0:25:05.00,Default,,0,0,0,,Сіз челондықсыз ба?
Dialogue: 0,0:25:05.08,0:25:06.75,Default,,0,0,0,,Ах, тағы бір қызық нәрсе...
Dialogue: 0,0:25:06.83,0:25:10.75,Default,,0,0,0,,Мен кездейсоқ өтіп бара жатып, өте жақсы қаруды көрдім.
Dialogue: 0,0:25:10.84,0:25:13.22,Default,,0,0,0,,Мен экскурсия жасай аламын ба?
Dialogue: 0,0:25:13.30,0:25:14.01,Default,,0,0,0,,Қару дегеніміз не?
Dialogue: 0,0:25:14.09,0:25:15.30,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:25:15.80,0:25:17.05,Default,,0,0,0,,Иә, бұл мынау
Dialogue: 0,0:25:17.14,0:25:17.64,Default,,0,0,0,,Әй?
Dialogue: 0,0:25:19.72,0:25:21.64,Default,,0,0,0,,(Стефани) Сол сөзіңді қайтарып ал. (Сора) Ә?
Dialogue: 0,0:25:21.72,0:25:22.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:23.98,0:25:25.77,Default,,0,0,0,,Ах! Айқас белгі!
Dialogue: 0,0:25:26.56,0:25:28.06,Default,,0,0,0,,Ой... Сабыр ет, Мирала.
Dialogue: 0,0:25:28.15,0:25:30.02,Default,,0,0,0,,Бірақ бұл крест белгісі сөзсіз...
Dialogue: 0,0:25:30.11,0:25:32.53,Default,,0,0,0,,Иә? Бірақ солай...
Dialogue: 0,0:25:32.61,0:25:35.53,Default,,0,0,0,,Умм, сіз бұл крест белгісі туралы білесіз бе?
Dialogue: 0,0:25:36.11,0:25:37.78,Default,,0,0,0,,Жоқ... Мен білмеймін.
Dialogue: 0,0:25:37.86,0:25:41.08,Default,,0,0,0,,Бұл белгіні ең қорқынышты Кируру қойған.
Dialogue: 0,0:25:41.16,0:25:43.16,Default,,0,0,0,,Аузым жарылып кетсе де... а
Dialogue: 0,0:25:43.25,0:25:44.54,Default,,0,0,0,,дейді
Dialogue: 0,0:25:44.62,0:25:46.67,Default,,0,0,0,,-Ах~ -(Нацуми) Кируру дегеніміз не?
Dialogue: 0,0:25:47.54,0:25:49.96,Default,,0,0,0,,Кируру ежелгі Керон әскерімен мөрленді⸺
Dialogue: 0,0:25:50.04,0:25:51.59,Default,,0,0,0,,Соңғы қару
Dialogue: 0,0:25:51.67,0:25:54.80,Default,,0,0,0,,Дау, қызғаныш, сенімсіздік, т.б.
Dialogue: 0,0:25:54.88,0:25:58.89,Default,,0,0,0,,Теріс ойды қайта-қайта өсу және бөлу үшін энергия ретінде пайдаланыңыз
Dialogue: 0,0:25:58.97,0:26:01.76,Default,,0,0,0,,Түбінде сол планета да жойылады дейді⸺
Dialogue: 0,0:26:01.85,0:26:03.68,Default,,0,0,0,,Бұл қорқынышты қару.
Dialogue: 0,0:26:03.77,0:26:05.10,Default,,0,0,0,,Иә!
Dialogue: 0,0:26:05.18,0:26:06.94,Default,,0,0,0,,Керон әскерінің қаруы...
Dialogue: 0,0:26:07.56,0:26:09.19,Default,,0,0,0,,Бұл сіздің әрекетіңіз бе?
Dialogue: 0,0:26:09.27,0:26:10.19,Default,,0,0,0,,Жоқ... бұл дұрыс емес!
Dialogue: 0,0:26:11.15,0:26:12.57,Default,,0,0,0,,Қара, қара, қара.
Dialogue: 0,0:26:13.15,0:26:15.15,Default,,0,0,0,,Мен де құрбанмын.
Dialogue: 0,0:26:15.24,0:26:17.57,Default,,0,0,0,,Осылай айтып алдап жатқан жоқсың ба?
Dialogue: 0,0:26:17.65,0:26:20.57,Default,,0,0,0,,Ұрысты тоқтатыңыз!
Dialogue: 0,0:26:21.16,0:26:22.12,Default,,0,0,0,,Уау!
Dialogue: 0,0:26:22.20,0:26:25.08,Default,,0,0,0,,Бұл қақтығыс Кируру энергиясына айналады.
Dialogue: 0,0:26:25.70,0:26:29.75,Default,,0,0,0,,Жақсы араласпасаң, Кируру тез өседі.
Dialogue: 0,0:26:29.83,0:26:30.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:26:31.29,0:26:32.34,Default,,0,0,0,,Хаа…
Dialogue: 0,0:26:32.42,0:26:36.26,Default,,0,0,0,,Неліктен бәрі кенеттен тек зиянды ниетті қабылдауды тоқтатты?
Dialogue: 0,0:26:36.34,0:26:38.47,Default,,0,0,0,,Бұл Кируру кінәлі.
Dialogue: 0,0:26:38.55,0:26:41.47,Default,,0,0,0,,Бірақ неге ежелгі Керон қаруы қазір қол жетімді?
Dialogue: 0,0:26:41.55,0:26:45.47,Default,,0,0,0,,Оны осындай қысым нүктесінде тығыздау керек еді...
Dialogue: 0,0:26:45.56,0:26:46.98,Default,,0,0,0,,- Құсу! - (Фуюки) Ах!
Dialogue: 0,0:26:47.06,0:26:50.35,Default,,0,0,0,,Сонымен... Мен мұндай қысым нүктесін көрген де, бұзған да емеспін.
Dialogue: 0,0:26:50.44,0:26:52.81,Default,,0,0,0,,Мен оны ешқашан цементпен жөндеген емеспін...
Dialogue: 0,0:26:52.90,0:26:54.11,Default,,0,0,0,,Фуюки-доно?
Dialogue: 0,0:26:54.19,0:26:57.40,Default,,0,0,0,,Соңында барлығына сен кінәлісің!
Dialogue: 0,0:26:57.49,0:26:58.99,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:26:59.07,0:27:00.86,Default,,0,0,0,,Ал, мен осымын.
Dialogue: 0,0:27:00.95,0:27:02.37,Default,,0,0,0,,-Ах~ Күте тұрыңыз! -сурет?
Dialogue: 0,0:27:02.95,0:27:05.20,Default,,0,0,0,,Кируру туралы көбірек айтып беріңізші.
Dialogue: 0,0:27:05.29,0:27:07.29,Default,,0,0,0,,Оны жеңудің жолы бар ма?
Dialogue: 0,0:27:07.37,0:27:08.87,Default,,0,0,0,,-Жоқ. -(2 адам) Әй!
Dialogue: 0,0:27:09.54,0:27:11.88,Default,,0,0,0,,Бұл планетаның жойылудан басқа амалы жоқ.
Dialogue: 0,0:27:11.96,0:27:13.17,Default,,0,0,0,,Бұл...
Dialogue: 0,0:27:13.25,0:27:14.25,Default,,0,0,0,,Біз бірдеңе істей алмаймыз ба?
Dialogue: 0,0:27:15.05,0:27:16.50,Default,,0,0,0,,Хмм...
Dialogue: 0,0:27:16.59,0:27:18.92,Default,,0,0,0,,Иә, Кируруға мөр қою үшін.
Dialogue: 0,0:27:19.01,0:27:23.14,Default,,0,0,0,,Мен саған ең мықты достық пен сенім керек деп естідім.
Dialogue: 0,0:27:23.22,0:27:26.14,Default,,0,0,0,,Бірақ сіз шерониттер мен пекопониттерсіз.
Dialogue: 0,0:27:26.77,0:27:29.35,Default,,0,0,0,,Олар нашар қарым-қатынаста сияқты, сондықтан бұл мүмкін емес.
Dialogue: 0,0:27:29.43,0:27:30.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:27:30.19,0:27:31.73,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:27:31.81,0:27:33.27,Default,,0,0,0,,Біз доспыз
Dialogue: 0,0:27:34.86,0:27:38.03,Default,,0,0,0,,Бірақ басқыншы мен басқыншы
Dialogue: 0,0:27:38.11,0:27:39.53,Default,,0,0,0,,Олар жау емес пе?
Dialogue: 0,0:27:39.61,0:27:41.45,Default,,0,0,0,,Біз әртүрліміз.
Dialogue: 0,0:27:41.53,0:27:42.03,Default,,0,0,0,,Бұл дәл «қуалап ұстау» ойыны сияқты.
Dialogue: 0,0:27:42.78,0:27:45.37,Default,,0,0,0,,Кирурудың баттен шабуылын алғаннан кейін!
Dialogue: 0,0:27:46.33,0:27:48.79,Default,,0,0,0,,Айнымас берік достық пен сенім
Dialogue: 0,0:27:49.58,0:27:52.33,Default,,0,0,0,,Менің әріптестерімнің барлығы дос.
Dialogue: 0,0:27:53.12,0:27:54.33,Default,,0,0,0,,Хехе
Dialogue: 0,0:27:55.21,0:27:56.34,Default,,0,0,0,,Хехе
Dialogue: 0,0:28:02.93,0:28:07.72,Default,,0,0,0,,Менің бұлыңғыр бақамен жақсы қарым-қатынаста болмағанымның себебі Кирурудан бұрын болған мәселе.
Dialogue: 0,0:28:07.81,0:28:09.56,Default,,0,0,0,,Егер менің әпкем...
Dialogue: 0,0:28:09.64,0:28:11.23,Default,,0,0,0,,-Кешіріңіз -(Фуюки және т.б.) Иә?
Dialogue: 0,0:28:11.89,0:28:14.23,Default,,0,0,0,,Барлығы бір-біріне сенеді, солай ма?
Dialogue: 0,0:28:14.90,0:28:18.61,Default,,0,0,0,,Ойлап қарасам, олар Пекопонға басып кіруді жоспарлап отыр.
Dialogue: 0,0:28:18.69,0:28:19.69,Default,,0,0,0,,Мен қате түсіндім
Dialogue: 0,0:28:19.78,0:28:20.78,Default,,0,0,0,,Гик!
Dialogue: 0,0:28:20.86,0:28:22.11,Default,,0,0,0,,Бұл жұлдыз
Dialogue: 0,0:28:22.74,0:28:24.07,Default,,0,0,0,,Ойланып қарашы, бұл не?
Dialogue: 0,0:28:24.16,0:28:26.45,Default,,0,0,0,,(Әйел) Жолдасым! Арбадағы әйел өліп қалды, бірақ➡
Dialogue: 0,0:28:26.53,0:28:28.70,Default,,0,0,0,,Пекопон - басқыншылық қару, солай емес пе?
Dialogue: 0,0:28:28.79,0:28:31.04,Default,,0,0,0,,Агрессия қаруы? Бұл?
Dialogue: 0,0:28:31.12,0:28:33.71,Default,,0,0,0,,Иә, ол өте күшті
Dialogue: 0,0:28:33.79,0:28:35.67,Default,,0,0,0,,-Сенің көздерің әдемі. -(Барлығы) иә?
Dialogue: 0,0:28:35.75,0:28:36.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:28:36.33,0:28:39.09,Default,,0,0,0,,Ку~ Төсекте ұйықтап қалдым.
Dialogue: 0,0:28:39.17,0:28:40.00,Default,,0,0,0,,Жер
Dialogue: 0,0:28:40.67,0:28:42.42,Default,,0,0,0,,Сіз мұны жасадыңыз ба?
Dialogue: 0,0:28:42.51,0:28:43.38,Default,,0,0,0,,Иса, әрине
Dialogue: 0,0:28:43.47,0:28:44.13,Default,,0,0,0,,Керемет
Dialogue: 0,0:28:44.80,0:28:47.68,Default,,0,0,0,,Сол қарумен барлық Пекопон халқы қалағанын жасай алады.
Dialogue: 0,0:28:47.76,0:28:50.43,Default,,0,0,0,,Шабуыл да оңай сияқты.
Dialogue: 0,0:28:50.52,0:28:52.56,Default,,0,0,0,,Бұл шынымен де олай емес сияқты.
Dialogue: 0,0:28:52.64,0:28:53.14,Default,,0,0,0,,Уау
Dialogue: 0,0:28:53.23,0:28:55.02,Default,,0,0,0,,Маған мұны істеуді тапсырды.
Dialogue: 0,0:28:55.10,0:28:57.77,Default,,0,0,0,,Сіз ақымақ шабуыл қаруын жасай алмайсыз.
Dialogue: 0,0:28:57.86,0:29:00.15,Default,,0,0,0,,Балалар, жай атмосфераны оқыңдар!
Dialogue: 0,0:29:00.23,0:29:02.53,Default,,0,0,0,,Ах... Ито, кешіріңіз.
Dialogue: 0,0:29:02.61,0:29:03.15,Default,,0,0,0,,Аспаз
Dialogue: 0,0:29:03.24,0:29:04.82,Default,,0,0,0,,Такумо~
Dialogue: 0,0:29:04.90,0:29:06.57,Default,,0,0,0,,Сіз нені айтасыз? сержант
Dialogue: 0,0:29:06.66,0:29:07.16,Default,,0,0,0,,Ах
Dialogue: 0,0:29:08.66,0:29:11.16,Default,,0,0,0,,Басқыншылық қарулар шынайы ма?
Dialogue: 0,0:29:11.24,0:29:13.66,Default,,0,0,0,,Мынау... мынау... анау...
Dialogue: 0,0:29:14.41,0:29:16.08,Default,,0,0,0,,Сіз мұндай қаруға шындап қарайсыз ба?
Dialogue: 0,0:29:17.92,0:29:20.09,Default,,0,0,0,,Жоқ, бұл сөз ойыны.
Dialogue: 0,0:29:20.17,0:29:22.96,Default,,0,0,0,,Кездейсоқ келе жатып, құлап қалған бірдеңені көтеріп алдым, жолым болды...
Dialogue: 0,0:29:23.05,0:29:24.30,Default,,0,0,0,,Дұрыс жауап беріңіз!
Dialogue: 0,0:29:24.38,0:29:24.88,Default,,0,0,0,,Мен де! Мен деее~!
Dialogue: 0,0:29:26.72,0:29:27.84,Default,,0,0,0,,Фуюки-доно
Dialogue: 0,0:29:27.93,0:29:31.01,Default,,0,0,0,,Маған сенбегендіктен бе?
Dialogue: 0,0:29:31.51,0:29:34.10,Default,,0,0,0,,Сонда бұл басып алу қаруы қандай?
Dialogue: 0,0:29:34.18,0:29:37.90,Default,,0,0,0,,Сонымен... біріншіден, мен басқыншымын.
Dialogue: 0,0:29:37.98,0:29:40.36,Default,,0,0,0,,Басқыншылардың басып кіруі табиғи нәрсе.
Dialogue: 0,0:29:40.44,0:29:43.19,Default,,0,0,0,,Сонымен, біз осы уақытқа дейін өткізген уақытымыз
Dialogue: 0,0:29:43.28,0:29:44.40,Default,,0,0,0,,Бұл не болды?
Dialogue: 0,0:29:44.90,0:29:46.86,Default,,0,0,0,,Мен әрқашан доспыз деп ойлайтынмын...
Dialogue: 0,0:29:46.95,0:29:48.78,Default,,0,0,0,,Бұл Фуюки-доно!
Dialogue: 0,0:29:48.87,0:29:51.99,Default,,0,0,0,,Мен сені тыңдағаныңды қалаймын десем, мені тыңдама
Dialogue: 0,0:29:52.08,0:29:53.87,Default,,0,0,0,,Сіз мені дос деп атай аласыз!
Dialogue: 0,0:29:53.95,0:29:56.71,Default,,0,0,0,,Бұл не, сержант? Сіз осылай ойладыңыз ба?
Dialogue: 0,0:29:56.79,0:29:58.29,Default,,0,0,0,,Барлығың тынышталыңдар
Dialogue: 0,0:29:58.37,0:30:00.84,Default,,0,0,0,,Кируру осылай ойлайды.
Dialogue: 0,0:30:00.92,0:30:03.38,Default,,0,0,0,,Басқыншы мен басып алған болса да
Dialogue: 0,0:30:03.46,0:30:05.63,Default,,0,0,0,,Басқаша айтқанда, жау болса да...
Dialogue: 0,0:30:06.13,0:30:06.80,Default,,0,0,0,,Әй?
Dialogue: 0,0:30:06.88,0:30:08.64,Default,,0,0,0,,Жоғарыдағылардан мен шынайы Кира екенімді түсінесіз деп ойлаймын.
Dialogue: 0,0:30:08.72,0:30:09.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:09.84,0:30:12.31,Default,,0,0,0,,Біз бәрібір жаумыз.
Dialogue: 0,0:30:12.39,0:30:14.06,Default,,0,0,0,,- (Нацуми) Дұрыс - Иа...
Dialogue: 0,0:30:14.14,0:30:16.81,Default,,0,0,0,,Балалар, сендер жат планеталықтарсыңдар, солай ма?
Dialogue: 0,0:30:18.90,0:30:21.69,Default,,0,0,0,,Сіз фукудайтен дейсіз бе?
Dialogue: 0,0:30:24.03,0:30:25.94,Default,,0,0,0,,Күте тұрыңызшы?
Dialogue: 0,0:30:26.69,0:30:28.95,Default,,0,0,0,,Сондықтан біз тіл табысуымыз керек... иә?
Dialogue: 0,0:30:29.03,0:30:30.45,Default,,0,0,0,,Қандай азап…
Dialogue: 0,0:30:30.53,0:30:32.95,Default,,0,0,0,,Бұл планета өліп жатыр!
Dialogue: 0,0:30:36.45,0:30:36.96,Default,,0,0,0,,Эх!
Dialogue: 0,0:30:37.04,0:30:38.75,Default,,0,0,0,,Сержантпен
Dialogue: 0,0:30:38.83,0:30:39.96,Default,,0,0,0,,Фуюки-кун шайқасы?
Dialogue: 0,0:30:40.04,0:30:41.96,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:30:42.04,0:30:44.96,Default,,0,0,0,,Мен бұл крест белгісінің арқасында екеніне сенімдімін.
Dialogue: 0,0:30:45.05,0:30:48.97,Default,,0,0,0,,Бұлай жалғаса берсе, Кируру өсе береді!
Dialogue: 0,0:30:49.05,0:30:51.64,Default,,0,0,0,,Сонымен қатар, Нацуми-сан мен Жиро-сан және т.б
Dialogue: 0,0:30:51.72,0:30:54.81,Default,,0,0,0,,Екеуміз төбелесіп қалдық, мен не істерімді білмеймін!
Dialogue: 0,0:30:54.89,0:30:58.89,Default,,0,0,0,,Ендеше, егер сіз екі адам болсаңыз, оларды басқыншы немесе жау демеңіз.
Dialogue: 0,0:30:58.98,0:31:00.56,Default,,0,0,0,,Екеуміз жақсы араласамыз ба...
Dialogue: 0,0:31:00.65,0:31:01.77,Default,,0,0,0,,Басқыншы?
Dialogue: 0,0:31:01.85,0:31:03.19,Default,,0,0,0,,Жаулар?
Dialogue: 0,0:31:03.82,0:31:04.32,Default,,0,0,0,,Иә!
Dialogue: 0,0:31:05.02,0:31:08.19,Default,,0,0,0,,Тама-чан басқыншы болды, солай ма?
Dialogue: 0,0:31:08.28,0:31:11.32,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:31:11.41,0:31:14.74,Default,,0,0,0,,Бірақ тіпті Момочи кейде қорқынышты істер жасайды.
Dialogue: 0,0:31:14.83,0:31:16.58,Default,,0,0,0,,Мен саған бұл крестті бергенімде де...
Dialogue: 0,0:31:16.66,0:31:19.21,Default,,0,0,0,,Менің ойымша, жолға түсе беру дұрыс емес!
Dialogue: 0,0:31:19.29,0:31:22.21,Default,,0,0,0,,- (Момока/Тамама) Уф! -Сәлем~
Dialogue: 0,0:31:24.79,0:31:26.71,Default,,0,0,0,,Қош бол
Dialogue: 0,0:31:27.21,0:31:28.72,Default,,0,0,0,,барлығын бірге орналастырыңыз.
Dialogue: 0,0:31:29.30,0:31:30.38,Default,,0,0,0,,Дәл солай...
Dialogue: 0,0:31:30.47,0:31:33.60,Default,,0,0,0,,Мен қиындыққа тап болдым! мм...
Dialogue: 0,0:31:43.77,0:31:44.65,Default,,0,0,0,,Мияу?
Dialogue: 0,0:31:44.73,0:31:49.07,Default,,0,0,0,,Няаааа!
Dialogue: 0,0:31:49.15,0:31:49.65,Default,,0,0,0,,Ня?
Dialogue: 0,0:31:53.32,0:31:54.16,Default,,0,0,0,,Ня…
Dialogue: 0,0:31:58.24,0:31:59.45,Default,,0,0,0,,Нацуми-сан
Dialogue: 0,0:31:59.54,0:32:01.54,Default,,0,0,0,,Мен алаңдаймын, өйткені қала біртүрлі әрекет етеді...
Dialogue: 0,0:32:01.62,0:32:02.87,Default,,0,0,0,,Келме!
Dialogue: 0,0:32:02.96,0:32:03.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:32:04.38,0:32:06.00,Default,,0,0,0,,Келме, Коюки-чан
Dialogue: 0,0:32:07.21,0:32:08.80,Default,,0,0,0,,Енді жоқ...
Dialogue: 0,0:32:09.67,0:32:11.80,Default,,0,0,0,,Себебі мен қоштасқым келмейді
Dialogue: 0,0:32:16.89,0:32:17.81,Default,,0,0,0,,Тойя!
Dialogue: 0,0:32:19.10,0:32:21.52,Default,,0,0,0,,Коюки-доноға берілген крест белгісі
Dialogue: 0,0:32:21.60,0:32:24.56,Default,,0,0,0,,Крулдың айтуы бойынша, Керон әскерінің көне қару-жарақтары себеп болған көрінеді...
Dialogue: 0,0:32:24.65,0:32:26.48,Default,,0,0,0,,- (Телепатия: Коюки) Оны бірінші рет көруім - иә?
Dialogue: 0,0:32:26.56,0:32:30.49,Default,,0,0,0,,Нацуми-санның бірінші рет...
Dialogue: 0,0:32:31.19,0:32:34.07,Default,,0,0,0,,Егер оны Дороро мен оның ата-бабалары жасаған болса.
Dialogue: 0,0:32:34.16,0:32:36.03,Default,,0,0,0,,Сіз бірдеңе істей алмайсыз ба?
Dialogue: 0,0:32:36.12,0:32:36.99,Default,,0,0,0,,Коюки-доно…
Dialogue: 0,0:32:37.08,0:32:38.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:32:38.83,0:32:40.83,Default,,0,0,0,,Кешіріңіз, Дороро
Dialogue: 0,0:32:42.71,0:32:46.38,Default,,0,0,0,,Коюки-дононың кешірім сұрауының қажеті жоқ.
Dialogue: 0,0:32:49.63,0:32:50.63,Default,,0,0,0,,Ах
Dialogue: 0,0:32:56.30,0:32:58.01,Default,,0,0,0,,Жер бетінде не болды?
Dialogue: 0,0:32:58.10,0:32:58.64,Default,,0,0,0,,Құрметті Момока!
Dialogue: 0,0:32:59.35,0:33:00.81,Default,,0,0,0,,Кез келген жағдайда эвакуациялаңыз...
Dialogue: 0,0:33:02.60,0:33:03.64,Default,,0,0,0,,- (Пол) Ммм? -(Момока) Ия!
Dialogue: 0,0:33:24.25,0:33:25.33,Default,,0,0,0,,Өлтіру
Dialogue: 0,0:33:25.42,0:33:26.37,Default,,0,0,0,,Ах!
Dialogue: 0,0:33:26.46,0:33:28.21,Default,,0,0,0,,СС не істеп жатыр?
Dialogue: 0,0:33:28.29,0:33:32.21,Default,,0,0,0,,Біз бәрібір жалдамалы жұмысшылармыз.
Dialogue: 0,0:33:44.60,0:33:45.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:33:48.06,0:33:48.56,Default,,0,0,0,,Ах!
Dialogue: 0,0:33:49.40,0:33:50.57,Default,,0,0,0,,- (Фуюки) Мынаны қара! -(Нацуми) Ах!
Dialogue: 0,0:33:54.32,0:33:55.57,Default,,0,0,0,,Мен бұған сене алмадым ...
Dialogue: 0,0:33:56.20,0:33:58.07,Default,,0,0,0,,-Бұл Кируру - (Нацуми/Фуюки) Иә!
Dialogue: 0,0:33:58.16,0:34:01.12,Default,,0,0,0,,Зиянды энергияңызды сіңіріңіз
Dialogue: 0,0:34:01.20,0:34:02.83,Default,,0,0,0,,Өте үлкен...
Dialogue: 0,0:34:02.91,0:34:04.62,Default,,0,0,0,,Біз...
Dialogue: 0,0:34:04.70,0:34:07.83,Default,,0,0,0,,Мен оны үлкен етіп жасадым.
Dialogue: 0,0:34:08.42,0:34:10.96,Default,,0,0,0,,Кируру Нишизава отбасылық сарайынан кетіп бара жатыр!
Dialogue: 0,0:34:11.04,0:34:12.42,Default,,0,0,0,,Мүмкін бір күні сонда бірге ішеміз
Dialogue: 0,0:34:12.92,0:34:14.96,Default,,0,0,0,,Пекопонның әділдік одақтастары жоқ па?
Dialogue: 0,0:34:15.05,0:34:17.84,Default,,0,0,0,,Бұл теледидар немесе фильмдер емес.
Dialogue: 0,0:34:17.93,0:34:20.51,Default,,0,0,0,,Пекопон халқын күлкіге айналдырды.
Dialogue: 0,0:34:20.60,0:34:21.60,Default,,0,0,0,,Шықпа.
Dialogue: 0,0:34:21.68,0:34:23.10,Default,,0,0,0,,Мүлде жоқ! Құсу
Dialogue: 0,0:34:23.72,0:34:26.60,Default,,0,0,0,,Кируру Нишизава отбасылық сауда аймағына басып кірді
Dialogue: 0,0:34:26.68,0:34:30.10,Default,,0,0,0,,Біз Момока жолын қирату арқылы жалғастырамыз!
Dialogue: 0,0:34:34.07,0:34:36.78,Default,,0,0,0,,Кеше, бүгін келген балапан басқыншыларға
Dialogue: 0,0:34:36.86,0:34:38.65,Default,,0,0,0,,Сіз қалағаныңызды жасай аласыз!
Dialogue: 0,0:34:38.74,0:34:41.37,Default,,0,0,0,,Жоқ, у... ерте заманнан мөрленген.
Dialogue: 0,0:34:42.20,0:34:45.12,Default,,0,0,0,,Кероро взводы, Кируруны жоюға тырысыңыз!
Dialogue: 0,0:34:45.20,0:34:46.04,Default,,0,0,0,,Ах
Dialogue: 0,0:34:46.12,0:34:47.29,Default,,0,0,0,,- Түсінікті! -сізді түсіндім!
Dialogue: 0,0:34:47.37,0:34:49.04,Default,,0,0,0,,- Түсінікті! - Аспаз аспаз
Dialogue: 0,0:34:53.92,0:34:55.67,Default,,0,0,0,,- (Фуюки) Ах - (Нацуми) Сол жігіттер...
Dialogue: 0,0:34:55.76,0:34:56.34,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:34:59.43,0:35:01.01,Default,,0,0,0,,Қашықтық 2000
Dialogue: 0,0:35:01.09,0:35:02.60,Default,,0,0,0,,Теюуканы орналастыру аяқталды
Dialogue: 0,0:35:02.68,0:35:03.51,Default,,0,0,0,,Жарайды
Dialogue: 0,0:35:04.01,0:35:04.72,Default,,0,0,0,,Орындалды!
Dialogue: 0,0:35:04.81,0:35:06.52,Default,,0,0,0,,Джироро айқайлады!
Dialogue: 0,0:35:07.02,0:35:09.94,Default,,0,0,0,,Тамама әсері!
Dialogue: 0,0:35:13.36,0:35:14.52,Default,,0,0,0,,Иә!
Dialogue: 0,0:35:15.32,0:35:16.57,Default,,0,0,0,,- (Фуюки) Керемет! -Жоқ.
Dialogue: 0,0:35:16.65,0:35:17.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:35:19.99,0:35:22.66,Default,,0,0,0,,Killurururu~
Dialogue: 0,0:35:22.74,0:35:23.91,Default,,0,0,0,,-құсу~? -Аа...
Dialogue: 0,0:35:23.99,0:35:25.66,Default,,0,0,0,,Шүкір, тағы барайық.
Dialogue: 0,0:35:25.74,0:35:27.04,Default,,0,0,0,,Мұны да алыңыз!
Dialogue: 0,0:35:32.29,0:35:32.92,Default,,0,0,0,,Чий!
Dialogue: 0,0:35:33.00,0:35:35.71,Default,,0,0,0,,Хиха~!
Dialogue: 0,0:35:36.21,0:35:38.92,Default,,0,0,0,,Диффузия Тамама әсері!
Dialogue: 0,0:35:45.72,0:35:47.47,Default,,0,0,0,,Кируру~
Dialogue: 0,0:35:48.10,0:35:50.81,Default,,0,0,0,,Қарудың Кируруға қарсы пайдасы жоқ.
Dialogue: 0,0:35:50.89,0:35:52.35,Default,,0,0,0,,- (Нацуми) Амал жоқ - (Фуюки) Бұл...
Dialogue: 0,0:35:52.44,0:35:54.52,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:35:54.61,0:35:56.44,Default,,0,0,0,,Тамама-кун, бұл босқа!
Dialogue: 0,0:35:57.11,0:35:57.61,Default,,0,0,0,,Тама?
Dialogue: 0,0:35:58.23,0:35:59.74,Default,,0,0,0,,Әзірге шабуылдан бас тартылды!
Dialogue: 0,0:35:59.82,0:36:01.57,Default,,0,0,0,,Өртті сөндіруге кірісіңіз!
Dialogue: 0,0:36:01.65,0:36:03.36,Default,,0,0,0,,Мен...
Dialogue: 0,0:36:03.45,0:36:05.49,Default,,0,0,0,,Менің жолдасым да шығады!
Dialogue: 0,0:36:05.58,0:36:07.58,Default,,0,0,0,,Суды шығару техникасы!
Dialogue: 0,0:36:08.58,0:36:10.71,Default,,0,0,0,,Бу~ Бу~ Бу~
Dialogue: 0,0:36:10.79,0:36:13.00,Default,,0,0,0,,Нггун... Бу-бу-
Dialogue: 0,0:36:14.75,0:36:15.92,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:36:16.59,0:36:18.55,Default,,0,0,0,,Олар не істеп жатыр?
Dialogue: 0,0:36:18.63,0:36:19.67,Default,,0,0,0,,Уау!
Dialogue: 0,0:36:20.30,0:36:22.22,Default,,0,0,0,,Мүмкін емес пе? Тағы?
Dialogue: 0,0:36:24.47,0:36:27.68,Default,,0,0,0,,Мен саған басқыншы болудың дұрыс жолын көрсетемін.
Dialogue: 0,0:36:28.47,0:36:30.18,Default,,0,0,0,,Сен мұнымен не істейсің?
Dialogue: 0,0:36:30.27,0:36:33.10,Default,,0,0,0,,Осы құрылғымен Кируруға пәрмендерді жіберіңіз
Dialogue: 0,0:36:33.19,0:36:34.44,Default,,0,0,0,,Мен оны басқарамын.
Dialogue: 0,0:36:35.02,0:36:38.90,Default,,0,0,0,,Менің пәрменім: Өте қуатты күшейткіш машинаны іске қосыңыз!
Dialogue: 0,0:36:40.94,0:36:41.69,Default,,0,0,0,,Керот?
Dialogue: 0,0:36:41.78,0:36:43.45,Default,,0,0,0,,-Гя~! -(Фуюки және т.б.) Уау
Dialogue: 0,0:36:47.78,0:36:49.45,Default,,0,0,0,,Ахх!
Dialogue: 0,0:36:50.12,0:36:51.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:36:51.37,0:36:52.79,Default,,0,0,0,,Гяа!
Dialogue: 0,0:36:53.29,0:36:56.04,Default,,0,0,0,,О? О? солай ма?
Dialogue: 0,0:36:56.83,0:36:58.29,Default,,0,0,0,,Мен күшейтілдім бе?
Dialogue: 0,0:36:59.09,0:37:02.55,Default,,0,0,0,,Бұл команданың күшейту қуатын да арттырады.
Dialogue: 0,0:37:02.63,0:37:04.05,Default,,0,0,0,,Нәзік сендіру күші
Dialogue: 0,0:37:04.88,0:37:07.72,Default,,0,0,0,,Олай болса бұл ойын!
Dialogue: 0,0:37:07.80,0:37:08.30,Default,,0,0,0,,Геротчи!
Dialogue: 0,0:37:09.06,0:37:10.06,Default,,0,0,0,,- Сержант мырза? -о?
Dialogue: 0,0:37:10.14,0:37:11.06,Default,,0,0,0,,Кероро?
Dialogue: 0,0:37:13.39,0:37:16.31,Default,,0,0,0,,Ой...
Dialogue: 0,0:37:16.40,0:37:17.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:17.52,0:37:20.94,Default,,0,0,0,,Йо-хо-ха-ё…
Dialogue: 0,0:37:21.03,0:37:22.86,Default,,0,0,0,,А, аа!
Dialogue: 0,0:37:22.94,0:37:24.03,Default,,0,0,0,,Аа...
Dialogue: 0,0:37:24.82,0:37:25.57,Default,,0,0,0,,Құсу?
Dialogue: 0,0:37:25.66,0:37:26.57,Default,,0,0,0,,Хаа…
Dialogue: 0,0:37:26.66,0:37:30.08,Default,,0,0,0,,Иә, кешіріңіз, кешіріңіз~
Dialogue: 0,0:37:31.95,0:37:32.58,Default,,0,0,0,,Ал...
Dialogue: 0,0:37:33.16,0:37:34.58,Default,,0,0,0,,Бұл жерде бәрі жақсы.
Dialogue: 0,0:37:34.66,0:37:38.17,Default,,0,0,0,,Кируру, менің артымнан жүр.
Dialogue: 0,0:37:38.25,0:37:39.59,Default,,0,0,0,,О~. Құдай-ай!
Dialogue: 0,0:37:39.67,0:37:42.17,Default,,0,0,0,,Шизуока фабрикасы!
Dialogue: 0,0:37:42.67,0:37:44.17,Default,,0,0,0,,Ол шықты ма?
Dialogue: 0,0:37:44.26,0:37:46.76,Default,,0,0,0,,Ум, Шизуока фабрикасы ше?
Dialogue: 0,0:37:46.84,0:37:48.47,Default,,0,0,0,,Не? Сіз бірдеңе естідіңіз бе?
Dialogue: 0,0:37:49.22,0:37:50.97,Default,,0,0,0,,-(Нацуми) Ах~ -(Фуюки) Сержант...
Dialogue: 0,0:37:51.68,0:37:52.22,Default,,0,0,0,,Иә.
Dialogue: 0,0:37:52.31,0:37:53.31,Default,,0,0,0,,О~. Құдай-ай!
Dialogue: 0,0:37:53.93,0:37:56.56,Default,,0,0,0,,Қалта ақшасының бағасы көтеріледі!
Dialogue: 0,0:37:56.64,0:37:57.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:58.56,0:38:01.23,Default,,0,0,0,,Үй шаруашылығын өзгертуге көмектесу!
Dialogue: 0,0:38:01.32,0:38:02.36,Default,,0,0,0,,Дұрыс мақсат қойыңыз!
Dialogue: 0,0:38:03.07,0:38:05.36,Default,,0,0,0,,Жарайды, бұл жақын шайқас.
Dialogue: 0,0:38:05.44,0:38:07.53,Default,,0,0,0,,Мұны істейік...
Dialogue: 0,0:38:08.24,0:38:11.08,Default,,0,0,0,,Сондай-ақ, заңсыз автотұрақтар да қолайсыздық туғызады.
Dialogue: 0,0:38:11.16,0:38:12.54,Default,,0,0,0,,- (Фуюки) Сержант қауіп! - Құсу?
Dialogue: 0,0:38:13.37,0:38:14.41,Default,,0,0,0,,Құсу!
Dialogue: 0,0:38:14.50,0:38:16.08,Default,,0,0,0,,Құсу!
Dialogue: 0,0:38:16.16,0:38:18.58,Default,,0,0,0,,Тоттотто...
Dialogue: 0,0:38:19.08,0:38:19.96,Default,,0,0,0,,Құсу
Dialogue: 0,0:38:21.38,0:38:22.80,Default,,0,0,0,,Құсу? Фуюки-доно?
Dialogue: 0,0:38:22.88,0:38:24.17,Default,,0,0,0,,Бұл қауіпті, сондықтан кері қайтыңыз!
Dialogue: 0,0:38:24.96,0:38:27.80,Default,,0,0,0,,Біреу аяғыңды айналып кетсе қауіпті!
Dialogue: 0,0:38:28.47,0:38:29.39,Default,,0,0,0,,Оу, бұ да керемет екен. Сендер тез жеп қойыңдар.
Dialogue: 0,0:38:29.47,0:38:31.64,Default,,0,0,0,,Мен сол ғибадатхананы зерттеймін!
Dialogue: 0,0:38:31.72,0:38:33.93,Default,,0,0,0,,Кируруны тоқтату туралы кеңес болуы мүмкін!
Dialogue: 0,0:38:34.60,0:38:36.14,Default,,0,0,0,,Олай болса, сәттілік сержант!
Dialogue: 0,0:38:36.23,0:38:37.56,Default,,0,0,0,,Не? Ах!
Dialogue: 0,0:38:39.15,0:38:39.73,Default,,0,0,0,,Уау!
Dialogue: 0,0:38:39.81,0:38:40.94,Default,,0,0,0,,Қауіпті!
Dialogue: 0,0:38:41.02,0:38:42.23,Default,,0,0,0,,- (Фуюки) Уау - (Нацуми) О!
Dialogue: 0,0:38:46.94,0:38:49.86,Default,,0,0,0,,Тіпті басқыншылар да кем дегенде адамдарға көмектесе алады.
Dialogue: 0,0:38:50.45,0:38:51.57,Default,,0,0,0,,Джироро…
Dialogue: 0,0:38:54.16,0:38:54.87,Default,,0,0,0,,Аа...
Dialogue: 0,0:38:55.54,0:38:57.00,Default,,0,0,0,,Мені сол жерге апарыңыз
Dialogue: 0,0:38:58.46,0:39:02.13,Default,,0,0,0,,Біз Кирурудың мөрін осы жерден сындырдық.
Dialogue: 0,0:39:02.21,0:39:03.04,Default,,0,0,0,,Ах!
Dialogue: 0,0:39:03.13,0:39:05.42,Default,,0,0,0,,Жарайды, бұл тосқауылдың бір түрі.
Dialogue: 0,0:39:05.50,0:39:06.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:39:08.13,0:39:09.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:39:10.63,0:39:12.05,Default,,0,0,0,,Қысым нүктелері жоқ
Dialogue: 0,0:39:12.14,0:39:14.06,Default,,0,0,0,,Иә? бұл!
Dialogue: 0,0:39:16.18,0:39:17.31,Default,,0,0,0,,Ежелгі керон жазуы.
Dialogue: 0,0:39:17.89,0:39:19.19,Default,,0,0,0,,Сіз оны оқи аласыз ба?
Dialogue: 0,0:39:19.27,0:39:20.56,Default,,0,0,0,,-Оқи алмаймын-(Фуюки/Нацуми) Ах...
Dialogue: 0,0:39:20.64,0:39:21.81,Default,,0,0,0,,О~. Құдай-ай!
Dialogue: 0,0:39:21.90,0:39:25.32,Default,,0,0,0,,Кешкі асқа әрқашан 3 немесе одан да көп гарнир болсын!
Dialogue: 0,0:39:25.40,0:39:27.82,Default,,0,0,0,,де! Мен неге соға алмаймын!
Dialogue: 0,0:39:27.90,0:39:28.82,Default,,0,0,0,,Жүгір!
Dialogue: 0,0:39:28.90,0:39:31.74,Default,,0,0,0,,Сіз бұл жерде қашан ұсталатыныңызды ешқашан білмейсіз!
Dialogue: 0,0:39:31.82,0:39:32.32,Default,,0,0,0,,Иә
Dialogue: 0,0:39:33.16,0:39:34.58,Default,,0,0,0,,Бұл болуы мүмкін бе?
Dialogue: 0,0:39:34.66,0:39:37.54,Default,,0,0,0,,Сіз Кируру динозаврларды бір рет жойғанын айтасыз ба?
Dialogue: 0,0:39:38.33,0:39:40.92,Default,,0,0,0,,Ей, тез қайтпасақ қауіпті.
Dialogue: 0,0:39:41.00,0:39:41.67,Default,,0,0,0,,Тағы біраз
Dialogue: 0,0:39:42.33,0:39:44.50,Default,,0,0,0,,Кируру үлкен болып, саны көбейе ме?
Dialogue: 0,0:39:45.25,0:39:45.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:39:46.71,0:39:49.34,Default,,0,0,0,,Бұл қысым нүктесі қажет болды.
Dialogue: 0,0:39:49.84,0:39:52.26,Default,,0,0,0,,Мен не істеуім керек...
Dialogue: 0,0:39:52.76,0:39:54.97,Default,,0,0,0,,О? Бірдеңе?
Dialogue: 0,0:39:55.05,0:39:58.10,Default,,0,0,0,,Қараңдаршы, мына суреттегі кірдің ішінде не жасырылған?
Dialogue: 0,0:40:00.18,0:40:01.52,Default,,0,0,0,,Мен бұны ешқашан күтпеген едім...
Dialogue: 0,0:40:03.06,0:40:04.27,Default,,0,0,0,,Мирала?
Dialogue: 0,0:40:04.36,0:40:07.23,Default,,0,0,0,,Маған соққы беріңіз!
Dialogue: 0,0:40:07.32,0:40:09.15,Default,,0,0,0,,Басыңыз!
Dialogue: 0,0:40:09.24,0:40:11.78,Default,,0,0,0,,Тағы да жоқ па? Құсу!
Dialogue: 0,0:40:13.61,0:40:14.28,Default,,0,0,0,,Уф...
Dialogue: 0,0:40:15.53,0:40:17.62,Default,,0,0,0,,Гей... Героооо...
Dialogue: 0,0:40:18.12,0:40:18.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:40:20.29,0:40:21.83,Default,,0,0,0,,Ачаа~
Dialogue: 0,0:40:22.42,0:40:23.83,Default,,0,0,0,,меніңше, бұл – нағыз ақымақтық шыңы… Яғни—
Dialogue: 0,0:40:24.58,0:40:27.09,Default,,0,0,0,,А... а...
Dialogue: 0,0:40:27.17,0:40:29.09,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:40:32.09,0:40:33.84,Default,,0,0,0,,Мен үшін күткендей
Dialogue: 0,0:40:33.93,0:40:36.60,Default,,0,0,0,,Пекопонды қорғау міндеті қандай?
Dialogue: 0,0:40:37.26,0:40:39.60,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:40:39.68,0:40:42.10,Default,,0,0,0,,Құсу!
Dialogue: 0,0:40:42.18,0:40:42.85,Default,,0,0,0,,Ах!
Dialogue: 0,0:40:42.94,0:40:44.60,Default,,0,0,0,,Ағай!
Dialogue: 0,0:40:44.69,0:40:46.11,Default,,0,0,0,,-Бұл аздап қорқынышты болды -Иә?
Dialogue: 0,0:40:46.19,0:40:48.98,Default,,0,0,0,,Капитанның энергиясы жұтылып жатыр.
Dialogue: 0,0:40:49.07,0:40:49.98,Default,,0,0,0,,Иә!
Dialogue: 0,0:40:50.48,0:40:51.99,Default,,0,0,0,,- Құсу! -Аа...
Dialogue: 0,0:40:52.65,0:40:56.99,Default,,0,0,0,,Құсу... гегех... ге~
Dialogue: 0,0:40:58.78,0:41:02.00,Default,,0,0,0,,Құсу...
Dialogue: 0,0:41:02.91,0:41:04.42,Default,,0,0,0,,Ге... Джерогеро...
Dialogue: 0,0:41:04.50,0:41:06.08,Default,,0,0,0,,Бұл~!
Dialogue: 0,0:41:07.04,0:41:09.25,Default,,0,0,0,,Құсу!
Dialogue: 0,0:41:13.01,0:41:15.05,Default,,0,0,0,,Геролин
Dialogue: 0,0:41:15.55,0:41:17.55,Default,,0,0,0,,Мен үшін не істедің!
Dialogue: 0,0:41:17.64,0:41:18.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:41:19.56,0:41:22.02,Default,,0,0,0,,Сіз жіберген теріс энергия
Dialogue: 0,0:41:22.10,0:41:24.81,Default,,0,0,0,,Кируруды одан сайын өсірдім.
Dialogue: 0,0:41:24.89,0:41:28.44,Default,,0,0,0,,Е! Бұл менің ниетім...
Dialogue: 0,0:41:40.95,0:41:42.58,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:41:42.66,0:41:43.75,Default,,0,0,0,,♬~
Dialogue: 0,0:41:43.83,0:41:44.91,Default,,0,0,0,,Павел!
Dialogue: 0,0:41:45.00,0:41:46.00,Default,,0,0,0,,Хаа~
Dialogue: 0,0:41:46.08,0:41:49.38,Default,,0,0,0,,Жылдың құбылмалы толқындарынан жеңе алмайсың...
Dialogue: 0,0:41:49.46,0:41:51.50,Default,,0,0,0,,Мен Катакиді алып кетемін!
Dialogue: 0,0:42:01.18,0:42:02.60,Default,,0,0,0,,Бұлыңғыр бақа!
Dialogue: 0,0:42:03.39,0:42:05.89,Default,,0,0,0,,Бұл да анық бұлыңғыр бақаға байланысты!
Dialogue: 0,0:42:05.98,0:42:07.35,Default,,0,0,0,,Біріккен Араб Әмірліктеріне кірді
Dialogue: 0,0:42:07.44,0:42:09.52,Default,,0,0,0,,Әйтеуір Миралаға асығыңыз.
Dialogue: 0,0:42:09.61,0:42:10.86,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:42:10.94,0:42:12.98,Default,,0,0,0,,Өйткені, өйткені, өйткені!
Dialogue: 0,0:42:13.07,0:42:16.24,Default,,0,0,0,,Менің де жаман ниетім жоқ!
Dialogue: 0,0:42:16.32,0:42:18.91,Default,,0,0,0,,Кируру жақында бөлінеді.
Dialogue: 0,0:42:18.99,0:42:20.99,Default,,0,0,0,,Сансыз Кируру туды
Dialogue: 0,0:42:21.08,0:42:23.49,Default,,0,0,0,,Және бұл планетаны жояды
Dialogue: 0,0:42:23.58,0:42:25.58,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:42:25.66,0:42:27.58,Default,,0,0,0,,Ах! Бір минут күтіңіз!
Dialogue: 0,0:42:27.67,0:42:29.25,Default,,0,0,0,,Оны маған қалдырыңыз
Dialogue: 0,0:42:29.33,0:42:29.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:42:30.92,0:42:32.13,Default,,0,0,0,,Лорд Мор?
Dialogue: 0,0:42:36.59,0:42:38.38,Default,,0,0,0,,Мен Кируруды жеңемін!
Dialogue: 0,0:42:38.97,0:42:39.89,Default,,0,0,0,,Ей, тыңда—
Dialogue: 0,0:42:39.97,0:42:40.47,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:42:40.55,0:42:42.68,Default,,0,0,0,,Люцифер Найза!
Dialogue: 0,0:42:51.61,0:42:54.02,Default,,0,0,0,,Армагеддон 1/1!
Dialogue: 0,0:43:02.62,0:43:04.03,Default,,0,0,0,,Бұл не? Бұл
Dialogue: 0,0:43:06.12,0:43:08.04,Default,,0,0,0,,Құсу! Амал жоқ...
Dialogue: 0,0:43:08.12,0:43:12.04,Default,,0,0,0,,Жұлдыздар, ештеңеге оралмаңыз және қайтадан жұлдыздарға тамақ болыңыз!
Dialogue: 0,0:43:12.13,0:43:13.54,Default,,0,0,0,,Моа-доно, жоқ!
Dialogue: 0,0:43:14.59,0:43:15.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:43:21.34,0:43:22.51,Default,,0,0,0,,Ағай?
Dialogue: 0,0:43:22.59,0:43:24.47,Default,,0,0,0,,Мен құтқарылдым~
Dialogue: 0,0:43:24.56,0:43:28.18,Default,,0,0,0,,Пекопон Кирурумен бірге жоғалып кете жаздады.
Dialogue: 0,0:43:28.27,0:43:31.44,Default,,0,0,0,,А... теюу? Мен арбаны аттың алдына қойдым ба?
Dialogue: 0,0:43:31.52,0:43:32.02,Default,,0,0,0,,13-ші мұғалімнің жаттығу тесті соңына дейін созылып кетті…
Dialogue: 0,0:43:32.10,0:43:33.52,Default,,0,0,0,,Мияу~
Dialogue: 0,0:43:33.61,0:43:35.69,Default,,0,0,0,,Маған қамқор болған сен бе? Рақмет…
Dialogue: 0,0:43:35.77,0:43:37.82,Default,,0,0,0,,- (Нацуми) Әй, үй! - (Фуюки) Ах!
Dialogue: 0,0:43:38.53,0:43:39.57,Default,,0,0,0,,Сержант?
Dialogue: 0,0:43:39.65,0:43:41.95,Default,,0,0,0,,Джироро, тез түсе кет!
Dialogue: 0,0:43:47.87,0:43:49.46,Default,,0,0,0,,Құсу!
Dialogue: 0,0:43:49.54,0:43:50.79,Default,,0,0,0,,А-а-а-а
Dialogue: 0,0:43:51.50,0:43:53.79,Default,,0,0,0,,Ах, жылап жібергім келеді!! Егер білгенімде➡
Dialogue: 0,0:43:54.38,0:43:56.55,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:43:57.59,0:44:01.26,Default,,0,0,0,,Кукку… Ууууууу…
Dialogue: 0,0:44:01.34,0:44:02.22,Default,,0,0,0,,Құсу!
Dialogue: 0,0:44:02.30,0:44:04.60,Default,,0,0,0,,Мұндай жерде тұру қауіпті.
Dialogue: 0,0:44:04.68,0:44:06.06,Default,,0,0,0,,Маған кедергі жасама
Dialogue: 0,0:44:06.14,0:44:08.35,Default,,0,0,0,,Не? Егер сержант...
Dialogue: 0,0:44:08.43,0:44:10.31,Default,,0,0,0,,-Уау! - (Фуюки) А?
Dialogue: 0,0:44:11.73,0:44:12.65,Default,,0,0,0,,Ах!
Dialogue: 0,0:44:12.73,0:44:13.27,Default,,0,0,0,,Құсу!
Dialogue: 0,0:44:14.86,0:44:16.07,Default,,0,0,0,,Уф...
Dialogue: 0,0:44:17.36,0:44:18.94,Default,,0,0,0,,Ах... Жақсы.
Dialogue: 0,0:44:19.03,0:44:20.53,Default,,0,0,0,,-Не істеп жатырсың?-(Фуюки) А?
Dialogue: 0,0:44:20.61,0:44:24.53,Default,,0,0,0,,Менің жаттығу залымдағы мергендік әдетім...
Dialogue: 0,0:44:24.62,0:44:26.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:44:26.12,0:44:30.04,Default,,0,0,0,,Мен... Мен оны Фуюки-дономен бірге сатып алудың қиындығына түстім.
Dialogue: 0,0:44:30.12,0:44:31.54,Default,,0,0,0,,Сержант...
Dialogue: 0,0:44:34.54,0:44:35.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:44:38.55,0:44:39.05,Default,,0,0,0,,Жарақатым жазылды, сондықтан бүгіннен бастап қалыпты мектеп кестесіне оралдым.
Dialogue: 0,0:44:39.92,0:44:41.72,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:44:43.97,0:44:44.55,Default,,0,0,0,,сержант.
Dialogue: 0,0:44:46.05,0:44:46.80,Default,,0,0,0,,Фуюки-доно
Dialogue: 0,0:44:49.06,0:44:50.81,Default,,0,0,0,,Уау!
Dialogue: 0,0:44:51.81,0:44:53.60,Default,,0,0,0,,Екеуі де өтті.
Dialogue: 0,0:44:53.69,0:44:55.27,Default,,0,0,0,,Мирала?
Dialogue: 0,0:44:55.35,0:44:55.85,Default,,0,0,0,,Ах
Dialogue: 0,0:44:56.44,0:44:59.23,Default,,0,0,0,,Мен сіздің суретіңізді Кируру храмынан таптым.
Dialogue: 0,0:44:59.32,0:45:00.15,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:45:00.23,0:45:04.61,Default,,0,0,0,,Сіз Кируруды қалай тоқтату керектігін білесіз ғой, солай емес пе?
Dialogue: 0,0:45:05.16,0:45:05.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:45:06.32,0:45:07.95,Default,,0,0,0,,Үндемегенім үшін кешіріңіз.
Dialogue: 0,0:45:08.03,0:45:08.53,Default,,0,0,0,,Жарақатым жазылды, сондықтан бүгіннен бастап қалыпты мектеп кестесіне оралдым.
Dialogue: 0,0:45:08.62,0:45:12.50,Default,,0,0,0,,Автоматты түрде анықтау түрі соңғы шабуыл қаруы Кирмиран
Dialogue: 0,0:45:13.21,0:45:17.50,Default,,0,0,0,,Мираланы өлтіретін Кируру, төреші
Dialogue: 0,0:45:21.09,0:45:22.51,Default,,0,0,0,,Екі бір
Dialogue: 0,0:45:22.59,0:45:24.38,Default,,0,0,0,,Бір – екі
Dialogue: 0,0:45:24.47,0:45:25.26,Default,,0,0,0,,Бұл дауыс...
Dialogue: 0,0:45:25.34,0:45:26.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:45:26.34,0:45:27.51,Default,,0,0,0,,Жер
Dialogue: 0,0:45:27.59,0:45:29.35,Default,,0,0,0,,Ми... Мирала?
Dialogue: 0,0:45:29.43,0:45:33.35,Default,,0,0,0,,Сіз кілтті ұстап тұруыңыз керек!
Dialogue: 0,0:45:33.43,0:45:34.85,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:45:34.94,0:45:35.48,Default,,0,0,0,,- (Фуюки) Иә? - Құсу?
Dialogue: 0,0:45:35.56,0:45:39.06,Default,,0,0,0,,Мен Кируру мөрінің кілтімін.
Dialogue: 0,0:45:39.57,0:45:40.90,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:45:40.98,0:45:43.40,Default,,0,0,0,,Бұл, әрине, кілт.
Dialogue: 0,0:45:43.49,0:45:45.07,Default,,0,0,0,,Ват!
Dialogue: 0,0:45:45.57,0:45:48.37,Default,,0,0,0,,Екеуіңнің арасындағы достық пен сенім
Dialogue: 0,0:45:48.45,0:45:52.08,Default,,0,0,0,,Оның күштілігі сонша, ол Кирурудың айқышын жеңе алады.
Dialogue: 0,0:45:52.16,0:45:54.00,Default,,0,0,0,,Маған көрсетілді
Dialogue: 0,0:45:54.08,0:45:57.58,Default,,0,0,0,,Кируруды тек сіз ғана мөрлей аласыз.
Dialogue: 0,0:45:57.67,0:46:00.13,Default,,0,0,0,,Мүмкін сіз бізді сынап жатқан шығарсыз?
Dialogue: 0,0:46:00.21,0:46:03.26,Default,,0,0,0,,Демек, олар басқыншылар, олар жау.
Dialogue: 0,0:46:03.34,0:46:05.38,Default,,0,0,0,,Атмосфераны түсіретін көптеген пікірлер...
Dialogue: 0,0:46:05.47,0:46:06.68,Default,,0,0,0,,Аузыңды жап.
Dialogue: 0,0:46:06.76,0:46:07.26,Default,,0,0,0,,Уф!
Dialogue: 0,0:46:07.34,0:46:08.55,Default,,0,0,0,,Бастапқыда
Dialogue: 0,0:46:08.64,0:46:10.85,Default,,0,0,0,,Кирурудың мөрін бұзған сен болдың.
Dialogue: 0,0:46:10.93,0:46:11.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:46:11.64,0:46:13.14,Default,,0,0,0,,Жауапкершілікті өзіңізге алыңыз
Dialogue: 0,0:46:13.64,0:46:14.89,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:46:15.93,0:46:20.11,Default,,0,0,0,,Егер сіз мені сол крест белгісінің ішіндегі кілт тесігіне кіргізсеңіз
Dialogue: 0,0:46:20.19,0:46:22.48,Default,,0,0,0,,Кируру мөрленуі мүмкін
Dialogue: 0,0:46:22.98,0:46:26.40,Default,,0,0,0,,Ажырасу басталғанға дейін асығыңыз
Dialogue: 0,0:46:26.49,0:46:27.86,Default,,0,0,0,,Жарайды
Dialogue: 0,0:46:28.36,0:46:29.41,Default,,0,0,0,,Кеттік, сержант.
Dialogue: 0,0:46:30.07,0:46:32.28,Default,,0,0,0,,Түсіндім, Фуюки-доно.
Dialogue: 0,0:46:34.87,0:46:36.33,Default,,0,0,0,,Соңында
Dialogue: 0,0:46:36.41,0:46:39.75,Default,,0,0,0,,Екеуінің Жерді құтқару үшін шайқасы басталды.
Dialogue: 0,0:46:39.83,0:46:40.71,Default,,0,0,0,,-Ах! -(Фуюки) Уау!
Dialogue: 0,0:46:40.79,0:46:41.79,Default,,0,0,0,,Әй?
Dialogue: 0,0:46:41.88,0:46:44.80,Default,,0,0,0,,Бұл жолы мен байсалды боламын!
Dialogue: 0,0:46:44.88,0:46:47.17,Default,,0,0,0,,Бұл аздап алдау деп ойламайсыз ба?
Dialogue: 0,0:46:47.26,0:46:49.22,Default,,0,0,0,,Өйткені Мираланың салмағы ауыр.
Dialogue: 0,0:46:49.84,0:46:51.85,Default,,0,0,0,,Диета ұстанған дұрыс
Dialogue: 0,0:46:51.93,0:46:53.31,Default,,0,0,0,,Қандай дөрекі!
Dialogue: 0,0:46:54.52,0:46:55.72,Default,,0,0,0,,Тек сол сәтте, бір сәтке ғана…
Dialogue: 0,0:46:57.18,0:46:58.73,Default,,0,0,0,,Yaho~
Dialogue: 0,0:46:59.31,0:47:01.23,Default,,0,0,0,,Бұл оңай жеңіс!
Dialogue: 0,0:47:01.31,0:47:02.73,Default,,0,0,0,,- (Фуюки) Иә? - Құсу?
Dialogue: 0,0:47:03.48,0:47:04.48,Default,,0,0,0,,Бұл...
Dialogue: 0,0:47:04.57,0:47:07.07,Default,,0,0,0,,Өлтір, өлтір...
Dialogue: 0,0:47:07.15,0:47:08.07,Default,,0,0,0,,№
Dialogue: 0,0:47:09.07,0:47:12.28,Default,,0,0,0,,Кейбір бөлімдер қазірдің өзінде басталды.
Dialogue: 0,0:47:12.37,0:47:13.74,Default,,0,0,0,,Эх!
Dialogue: 0,0:47:13.83,0:47:15.99,Default,,0,0,0,,Мен мұны естімедім!
Dialogue: 0,0:47:16.08,0:47:18.00,Default,,0,0,0,,-Gero gero~! -(Фуюки) Уау!
Dialogue: 0,0:47:18.08,0:47:18.87,Default,,0,0,0,,- Мм! -(Нацуми) Ах!
Dialogue: 0,0:47:18.96,0:47:21.58,Default,,0,0,0,,- Құсу! -(Фуюки) Уау!
Dialogue: 0,0:47:21.67,0:47:23.04,Default,,0,0,0,,-Gero gero~! -(Фуюки) Уау!
Dialogue: 0,0:47:23.67,0:47:25.80,Default,,0,0,0,,Мені Кируруға берме!
Dialogue: 0,0:47:25.88,0:47:27.55,Default,,0,0,0,,Мен осылай дедім
Dialogue: 0,0:47:27.63,0:47:29.88,Default,,0,0,0,,Уау!
Dialogue: 0,0:47:29.97,0:47:30.88,Default,,0,0,0,,Фуюки!
Dialogue: 0,0:47:30.97,0:47:34.89,Default,,0,0,0,,- Құсу! -(Фуюки) Уау!
Dialogue: 0,0:47:37.89,0:47:39.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:47:39.14,0:47:41.06,Default,,0,0,0,,Осы жерден жоғары көтеріліңіз.
Dialogue: 0,0:47:41.14,0:47:43.06,Default,,0,0,0,,Не? Мені жоғарыға жібер!
Dialogue: 0,0:47:43.15,0:47:44.82,Default,,0,0,0,,Мен оларды тоқтатамын!
Dialogue: 0,0:47:46.65,0:47:48.07,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:47:49.32,0:47:51.66,Default,,0,0,0,,А... А? Менің оқтарым бітті
Dialogue: 0,0:47:51.74,0:47:53.62,Default,,0,0,0,,Мен анаммен де, әкеммен де сөйлестім—
Dialogue: 0,0:47:53.70,0:47:54.78,Default,,0,0,0,,Джироро!
Dialogue: 0,0:47:54.87,0:47:55.62,Default,,0,0,0,,Бір минут күтіңіз
Dialogue: 0,0:47:55.70,0:47:57.08,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:47:57.16,0:47:58.62,Default,,0,0,0,,Аспазшы~
Dialogue: 0,0:47:58.70,0:47:59.83,Default,,0,0,0,,Қалай болғанда да...
Dialogue: 0,0:48:00.41,0:48:02.04,Default,,0,0,0,,Мен сені сонда деп ойладым.
Dialogue: 0,0:48:02.54,0:48:03.50,Default,,0,0,0,,А, бұл...
Dialogue: 0,0:48:03.58,0:48:05.50,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:48:05.59,0:48:07.42,Default,,0,0,0,,- (Фуюки) Уау - Міне!
Dialogue: 0,0:48:07.50,0:48:08.88,Default,,0,0,0,,- (Сабуро) Атқа мінгің келе ме? - (Кероро/Фуюки) Иә?
Dialogue: 0,0:48:09.46,0:48:11.51,Default,,0,0,0,,Куруру сирек кездеседі.
Dialogue: 0,0:48:11.59,0:48:13.01,Default,,0,0,0,,Сабуро-сенпай!
Dialogue: 0,0:48:13.09,0:48:15.51,Default,,0,0,0,,Сәлеметсіз бе, анау!
Dialogue: 0,0:48:15.60,0:48:17.43,Default,,0,0,0,,Мен тағы да осындамын!
Dialogue: 0,0:48:17.51,0:48:18.02,Default,,0,0,0,,- Құсу? -(Фуюки) А?
Dialogue: 0,0:48:18.10,0:48:20.02,Default,,0,0,0,,Бұл қайтадан келді!
Dialogue: 0,0:48:20.10,0:48:21.44,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:48:21.52,0:48:24.77,Default,,0,0,0,,- Құсу~! -(Фуюки) Уау!
Dialogue: 0,0:48:24.86,0:48:26.82,Default,,0,0,0,,Жоқ, шектеу жоқ.
Dialogue: 0,0:48:30.07,0:48:32.61,Default,,0,0,0,,саны тез өсуде!
Dialogue: 0,0:48:32.70,0:48:34.11,Default,,0,0,0,,Мен мұны сізге қалдырамын!
Dialogue: 0,0:48:34.20,0:48:34.74,Default,,0,0,0,,Тамама!
Dialogue: 0,0:48:35.32,0:48:36.91,Default,,0,0,0,,Өтінемін!
Dialogue: 0,0:48:38.24,0:48:40.91,Default,,0,0,0,,Маған кез келген жерден қоңырау шалыңыз.
Dialogue: 0,0:48:42.04,0:48:44.00,Default,,0,0,0,,Тама~!
Dialogue: 0,0:48:45.08,0:48:45.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:48:45.67,0:48:47.29,Default,,0,0,0,,-Кя~! -(Фуюки) Уау!
Dialogue: 0,0:48:47.38,0:48:49.42,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:48:49.50,0:48:50.34,Default,,0,0,0,,Сондай-ақ~ Жоқ~!
Dialogue: 0,0:48:50.42,0:48:52.55,Default,,0,0,0,,Мені елеме, Горр!
Dialogue: 0,0:48:52.63,0:48:54.22,Default,,0,0,0,,Құсу~
Dialogue: 0,0:48:54.72,0:48:55.55,Default,,0,0,0,,Иә.
Dialogue: 0,0:48:56.22,0:48:56.89,Default,,0,0,0,,Фуюки-доно
Dialogue: 0,0:48:56.97,0:48:58.06,Default,,0,0,0,,- (Фуюки) Иә? - А?
Dialogue: 0,0:48:58.14,0:48:59.93,Default,,0,0,0,,Тамама 2 сынып!
Dialogue: 0,0:49:00.02,0:49:01.27,Default,,0,0,0,,Иә!
Dialogue: 0,0:49:01.35,0:49:03.35,Default,,0,0,0,,Не? Алақай!
Dialogue: 0,0:49:03.44,0:49:06.69,Default,,0,0,0,,А... Бұл жақын қоңырау болды.
Dialogue: 0,0:49:06.77,0:49:08.44,Default,,0,0,0,,Сіз не істеп жатырсыз, сержант?
Dialogue: 0,0:49:08.52,0:49:09.02,Default,,0,0,0,,Құсу?
Dialogue: 0,0:49:09.11,0:49:12.03,Default,,0,0,0,,-Тама~! -Жоқ!
Dialogue: 0,0:49:13.32,0:49:14.36,Default,,0,0,0,,Уф...
Dialogue: 0,0:49:14.45,0:49:15.99,Default,,0,0,0,,Амансың ба? Тама-чан
Dialogue: 0,0:49:16.07,0:49:18.58,Default,,0,0,0,,Ешқандай жағдай жоқ.
Dialogue: 0,0:49:18.66,0:49:19.16,Default,,0,0,0,,Ах
Dialogue: 0,0:49:23.08,0:49:25.79,Default,,0,0,0,,Кешіріңіз, мен сізге көмектесуге тырыстым, бірақ...
Dialogue: 0,0:49:25.87,0:49:28.13,Default,,0,0,0,,Ах... Момочи
Dialogue: 0,0:49:29.54,0:49:30.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:49:30.13,0:49:31.13,Default,,0,0,0,,Ах
Dialogue: 0,0:49:32.13,0:49:33.05,Default,,0,0,0,,Әй?
Dialogue: 0,0:49:33.13,0:49:34.22,Default,,0,0,0,,-Уау! -(Момока) Ах!
Dialogue: 0,0:49:35.34,0:49:36.47,Default,,0,0,0,,Міне!
Dialogue: 0,0:49:36.55,0:49:37.89,Default,,0,0,0,,-Мен! -сурет?
Dialogue: 0,0:49:37.97,0:49:38.47,Default,,0,0,0,,-Уау! -(Момока) Ия!
Dialogue: 0,0:49:38.55,0:49:40.56,Default,,0,0,0,,- Міне! -Ах~ре~
Dialogue: 0,0:49:41.18,0:49:42.72,Default,,0,0,0,,Буншин жоқ Дзюцу!
Dialogue: 0,0:49:45.27,0:49:46.69,Default,,0,0,0,,-Ой! -(Фуюки) Уау.
Dialogue: 0,0:49:46.77,0:49:48.69,Default,,0,0,0,,-Хмф! -Кя~!
Dialogue: 0,0:49:49.19,0:49:53.57,Default,,0,0,0,,А, менің басым айналып кетті!
Dialogue: 0,0:49:54.44,0:49:56.74,Default,,0,0,0,,Дороро-кун! Pass Pass!
Dialogue: 0,0:49:56.82,0:49:59.74,Default,,0,0,0,,Оны Керороға және басқаларына мүмкіндігінше тезірек қайтарыңыз.
Dialogue: 0,0:49:59.83,0:50:01.28,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:50:01.37,0:50:02.12,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:50:06.79,0:50:08.08,Default,,0,0,0,,Коюки-доно
Dialogue: 0,0:50:08.17,0:50:10.25,Default,,0,0,0,,қабылдаңыз
Dialogue: 0,0:50:10.34,0:50:11.88,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:50:11.96,0:50:12.59,Default,,0,0,0,,Уау!
Dialogue: 0,0:50:12.67,0:50:14.51,Default,,0,0,0,,Қош келдіңіз!
Dialogue: 0,0:50:14.59,0:50:17.05,Default,,0,0,0,,Рахмет сізге Дороро
Dialogue: 0,0:50:17.55,0:50:18.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:50:18.14,0:50:20.80,Default,,0,0,0,,Бұл тоқтаусыз нәрсе
Dialogue: 0,0:50:24.47,0:50:24.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:50:25.81,0:50:26.98,Default,,0,0,0,,Уау...
Dialogue: 0,0:50:27.60,0:50:29.90,Default,,0,0,0,,Мен мұндай нәрсені бұза алмаймын.
Dialogue: 0,0:50:29.98,0:50:30.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:50:30.56,0:50:32.36,Default,,0,0,0,,- Күте тұрыңыз! - (Фуюки/Кероро) Уау!
Dialogue: 0,0:50:32.44,0:50:33.65,Default,,0,0,0,,Куруруға барыңыз!
Dialogue: 0,0:50:33.73,0:50:35.15,Default,,0,0,0,,Ку~куку~
Dialogue: 0,0:50:35.24,0:50:37.90,Default,,0,0,0,,-Мәжбүрлі серпіліс! - (Фуюки/Кероро) Уау!
Dialogue: 0,0:50:37.99,0:50:41.45,Default,,0,0,0,,Жасырмашы~!
Dialogue: 0,0:50:42.99,0:50:44.08,Default,,0,0,0,,Тата...
Dialogue: 0,0:50:44.16,0:50:46.96,Default,,0,0,0,,Мұндай жерде... бөгет бар
Dialogue: 0,0:50:47.46,0:50:48.92,Default,,0,0,0,,-Жолдан кет! - Құсу?
Dialogue: 0,0:50:50.08,0:50:50.67,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:50:50.75,0:50:52.54,Default,,0,0,0,,- (Фуюки) Уау! - Құсу!
Dialogue: 0,0:50:57.34,0:50:58.43,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,0:50:58.51,0:50:59.93,Default,,0,0,0,,-Тез жүр - Құсу ма?
Dialogue: 0,0:51:00.01,0:51:01.18,Default,,0,0,0,,Джироро!
Dialogue: 0,0:51:01.26,0:51:03.10,Default,,0,0,0,,Мен бұл жерді қорғаймын.
Dialogue: 0,0:51:03.18,0:51:04.68,Default,,0,0,0,,Балалар, тезірек ішке кіріңдер.
Dialogue: 0,0:51:05.35,0:51:06.64,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:51:06.73,0:51:07.68,Default,,0,0,0,,Шрамға толы емес
Dialogue: 0,0:51:07.77,0:51:10.23,Default,,0,0,0,,Уайымдамаңыз, барыңыз.
Dialogue: 0,0:51:10.31,0:51:13.07,Default,,0,0,0,,Мен оны тек басқыншылар үшін керемет етіп көрсетпеймін.
Dialogue: 0,0:51:13.15,0:51:13.69,Default,,0,0,0,,Не?
Dialogue: 0,0:51:13.77,0:51:16.19,Default,,0,0,0,,Алды-артымды босатпаймын.
Dialogue: 0,0:51:16.28,0:51:17.82,Default,,0,0,0,,- Құсу! -(Фуюки) Әпке?
Dialogue: 0,0:51:17.90,0:51:19.82,Default,,0,0,0,,Идиот! Нацуми тоқтат!
Dialogue: 0,0:51:31.50,0:51:32.00,Default,,0,0,0,,Не!
Dialogue: 0,0:51:32.63,0:51:35.00,Default,,0,0,0,,Мен де басқаларға көмектескенім үшін қарызымды өтеуім керек.
Dialogue: 0,0:51:35.09,0:51:37.09,Default,,0,0,0,,- Нацуми - (Фуюки) Әпке...
Dialogue: 0,0:51:37.17,0:51:38.84,Default,,0,0,0,,Фуюки және басқалары тез жүреді.
Dialogue: 0,0:51:38.92,0:51:39.97,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:51:40.05,0:51:41.13,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:51:47.22,0:51:49.64,Default,,0,0,0,,Пекопонның әйел солдаты күткендей
Dialogue: 0,0:51:50.27,0:51:51.90,Default,,0,0,0,,Мен жақсы көретін нәрселер бар.
Dialogue: 0,0:51:51.98,0:51:54.40,Default,,0,0,0,,Не? Сіз бірдеңе айттыңыз ба?
Dialogue: 0,0:51:54.90,0:51:55.40,Default,,0,0,0,,Ах
Dialogue: 0,0:51:55.98,0:51:56.90,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:51:57.48,0:51:58.28,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:51:58.36,0:51:59.40,Default,,0,0,0,,Иә!
Dialogue: 0,0:52:00.65,0:52:01.15,Default,,0,0,0,,Ах!
Dialogue: 0,0:52:01.24,0:52:03.49,Default,,0,0,0,,Жоғарыда кілт тесігі бар.
Dialogue: 0,0:52:03.57,0:52:05.33,Default,,0,0,0,,Асығыңыз
Dialogue: 0,0:52:05.41,0:52:06.54,Default,,0,0,0,,Жарайды
Dialogue: 0,0:52:06.62,0:52:07.66,Default,,0,0,0,,Мен бар күшімді саламын
Dialogue: 0,0:52:07.74,0:52:09.66,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:52:09.75,0:52:12.04,Default,,0,0,0,,Мүмкін Фуюки-доно шығар?
Dialogue: 0,0:52:12.12,0:52:15.29,Default,,0,0,0,,Бұл сәл жеңілірек емес пе?
Dialogue: 0,0:52:15.38,0:52:16.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:52:17.09,0:52:20.17,Default,,0,0,0,,Менің ойымша, мен оны жақсырақ ұстауым керек...
Dialogue: 0,0:52:20.26,0:52:21.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:52:22.09,0:52:23.72,Default,,0,0,0,,Бұл жолы ше?
Dialogue: 0,0:52:24.22,0:52:26.76,Default,,0,0,0,,Бұл ең қиыны!
Dialogue: 0,0:52:27.51,0:52:31.77,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:52:31.85,0:52:33.56,Default,,0,0,0,,Тағы да
Dialogue: 0,0:52:33.65,0:52:35.27,Default,,0,0,0,,Асықпасақ, нағашымыздың планетасынан айырыламыз!
Dialogue: 0,0:52:35.36,0:52:39.03,Default,,0,0,0,,Соны айтсам да, қайта көтеріле алмаймын.
Dialogue: 0,0:52:39.11,0:52:40.15,Default,,0,0,0,,Мен де...
Dialogue: 0,0:52:40.24,0:52:41.28,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе
Dialogue: 0,0:52:41.36,0:52:43.03,Default,,0,0,0,,Құсу~
Dialogue: 0,0:52:43.11,0:52:46.16,Default,,0,0,0,,Енді Пекопон шапқыншылығы да Ожан~
Dialogue: 0,0:52:46.24,0:52:47.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:52:48.12,0:52:51.16,Default,,0,0,0,,Егер Кируру жабылса...
Dialogue: 0,0:52:51.96,0:52:54.12,Default,,0,0,0,,Жерді басып алғыңыз келе ме?
Dialogue: 0,0:52:54.62,0:52:55.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:52:58.46,0:53:00.17,Default,,0,0,0,,Әрине
Dialogue: 0,0:53:00.26,0:53:04.26,Default,,0,0,0,,Мен Гунпла аспанындағы осы Пекопонмын.
Dialogue: 0,0:53:04.34,0:53:07.93,Default,,0,0,0,,Мама-доно, Нацуми-доно және басқалары осы Пекопонда.
Dialogue: 0,0:53:08.01,0:53:09.68,Default,,0,0,0,,Мен басып алғым келеді
Dialogue: 0,0:53:09.76,0:53:13.48,Default,,0,0,0,,Сіз Гунпланы Фуюки-дономен сатып ала аласыз⸺
Dialogue: 0,0:53:13.56,0:53:15.69,Default,,0,0,0,,Пекопон қазіргідей көңілді болуы керек.
Dialogue: 0,0:53:15.77,0:53:16.86,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:53:17.44,0:53:18.69,Default,,0,0,0,,Сержант...
Dialogue: 0,0:53:18.77,0:53:19.73,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:53:20.32,0:53:24.15,Default,,0,0,0,,Мен Кируру сияқты біреуден жеңілуге шамам жоқ.
Dialogue: 0,0:53:24.74,0:53:26.62,Default,,0,0,0,,- (Фуюки) Спорт залының мергені әйтеуір - А?
Dialogue: 0,0:53:27.28,0:53:28.74,Default,,0,0,0,,Қайтадан сатып алайық
Dialogue: 0,0:53:29.33,0:53:30.37,Default,,0,0,0,,Сержантпен бірге.
Dialogue: 0,0:53:31.08,0:53:32.37,Default,,0,0,0,,Фуюки-дономен
Dialogue: 0,0:53:32.45,0:53:35.12,Default,,0,0,0,,Бірге барайық!
Dialogue: 0,0:53:35.21,0:53:36.63,Default,,0,0,0,,Tama Impact!
Dialogue: 0,0:53:38.63,0:53:40.30,Default,,0,0,0,,Мынадай нәрсе ме?
Dialogue: 0,0:53:40.38,0:53:42.05,Default,,0,0,0,,(Наширо) Рей (Джузо Сузуя) Хм?
Dialogue: 0,0:53:48.55,0:53:49.30,Default,,0,0,0,,(ауада атыс дыбысы)
Dialogue: 0,0:53:49.39,0:53:51.31,Default,,0,0,0,,Цк, оқ-дәрі бітті ме?
Dialogue: 0,0:53:51.39,0:53:52.31,Default,,0,0,0,,- (Нацуми) Жироро - иә?
Dialogue: 0,0:53:54.14,0:53:55.06,Default,,0,0,0,,Оны қолданыңыз!
Dialogue: 0,0:53:57.44,0:53:57.94,Default,,0,0,0,,Кавабуки мен Цукуёми командасы
Dialogue: 0,0:53:58.61,0:54:00.02,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:54:00.11,0:54:02.53,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:54:02.61,0:54:05.40,Default,,0,0,0,,Қанша рет болса да бірге боламыз.
Dialogue: 0,0:54:05.49,0:54:06.53,Default,,0,0,0,,Қайтадан бірге дүкен аралайық.
Dialogue: 0,0:54:07.16,0:54:10.53,Default,,0,0,0,,Ерекше айналма жолмен жүру және барлау\NМен
Dialogue: 0,0:54:11.20,0:54:13.54,Default,,0,0,0,,жұмбақ ғибадатхананы таптым
Dialogue: 0,0:54:14.25,0:54:16.46,Default,,0,0,0,,Тырнақ әлдеқашан қатты.
Dialogue: 0,0:54:16.54,0:54:17.29,Default,,0,0,0,,Дұрыс па, солай емес пе?
Dialogue: 0,0:54:17.87,0:54:20.92,Default,,0,0,0,,Келесі жолы мен сержанттың айтқанын тыңдаймын.
Dialogue: 0,0:54:28.89,0:54:31.30,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:54:31.39,0:54:37.81,Default,,0,0,0,,Хаа һаа һаа һаа…
Dialogue: 0,0:54:38.94,0:54:39.44,Default,,0,0,0,,Иә
Dialogue: 0,0:54:42.98,0:54:44.19,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:54:44.82,0:54:47.20,Default,,0,0,0,,Джим! Мерген!
Dialogue: 0,0:54:48.03,0:54:51.20,Default,,0,0,0,,Арнаулы!
Dialogue: 0,0:54:58.96,0:54:59.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:55:00.08,0:55:03.34,Default,,0,0,0,,Екеуіңізге де еңбектеріңіз үшін рахмет.
Dialogue: 0,0:55:07.51,0:55:10.68,Default,,0,0,0,,Кируру қайтадан мөрленді.
Dialogue: 0,0:55:10.76,0:55:11.72,Default,,0,0,0,,Ах
Dialogue: 0,0:55:11.80,0:55:14.68,Default,,0,0,0,,Алыстағы жұлдыздарды достық біріктірсе ше?
Dialogue: 0,0:55:15.39,0:55:19.19,Default,,0,0,0,,Сен бұл ғаламда кез келген қиындықты жеңе алатыныңа сенімдімін.
Dialogue: 0,0:55:20.69,0:55:25.23,Default,,0,0,0,,Жаныңдағы адам қымбатты дос екенін ұмытпа.
Dialogue: 0,0:55:25.32,0:55:26.69,Default,,0,0,0,,Өтінемін, ұмытпаңыз
Dialogue: 0,0:55:35.95,0:55:36.95,Default,,0,0,0,,-Ой? -(Нацуми) А?
Dialogue: 0,0:55:40.46,0:55:41.46,Default,,0,0,0,,- (Момока) А... -Мм?
Dialogue: 0,0:56:03.19,0:56:04.36,Default,,0,0,0,,Уф!
Dialogue: 0,0:56:04.44,0:56:06.19,Default,,0,0,0,,-Уау! -(Момока) Кя~
Dialogue: 0,0:56:13.95,0:56:15.37,Default,,0,0,0,,Ах!
Dialogue: 0,0:56:17.95,0:56:19.62,Default,,0,0,0,,-(556) Ха~хахахаха... -(Рабби) Ах...
Dialogue: 0,0:56:19.70,0:56:20.37,Default,,0,0,0,,- (Рабби) Әй? -(556) Ха?
Dialogue: 0,0:56:20.46,0:56:22.12,Default,,0,0,0,,Уау...
Dialogue: 0,0:56:24.88,0:56:25.38,Default,,0,0,0,,Хмм!
Dialogue: 0,0:56:27.34,0:56:27.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:56:30.38,0:56:31.63,Default,,0,0,0,,Хмм... аа
Dialogue: 0,0:56:34.22,0:56:35.64,Default,,0,0,0,,Хмм...
Dialogue: 0,0:56:36.72,0:56:38.64,Default,,0,0,0,,О, не болып жатыр?
Dialogue: 0,0:56:38.72,0:56:40.31,Default,,0,0,0,,Бұл әдемі
Dialogue: 0,0:56:40.39,0:56:42.35,Default,,0,0,0,,Жарайсыңдар!
Dialogue: 0,0:56:42.44,0:56:45.06,Default,,0,0,0,,Жақсы! Ерен еңбегіңіз үшін рахмет
Dialogue: 0,0:56:57.62,0:57:01.83,Default,,0,0,0,,Кируру жабылып қалған сияқты.
Dialogue: 0,0:57:01.91,0:57:03.25,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:57:03.33,0:57:05.79,Default,,0,0,0,,Фуюки мен Бокегаэру ше?
Dialogue: 0,0:57:05.88,0:57:09.30,Default,,0,0,0,,Менің әлі баратын жерім бар!
Dialogue: 0,0:57:09.96,0:57:15.64,Default,,0,0,0,,-Артық емес! -(Фуюки) Уау!
Dialogue: 0,0:57:16.72,0:57:19.56,Default,,0,0,0,,Иә? иә? Ха...
Dialogue: 0,0:57:20.14,0:57:22.31,Default,,0,0,0,,Дәл осы жолы мен сені мақтаймын.
Dialogue: 0,0:57:22.39,0:57:26.15,Default,,0,0,0,,Е! Жоқ, бұл маңызды емес!
Dialogue: 0,0:57:26.23,0:57:28.69,Default,,0,0,0,,Мен айтқым келеді...
Dialogue: 0,0:57:28.77,0:57:31.73,Default,,0,0,0,,Бұл үйді не істейсің, ақымақ?
Dialogue: 0,0:57:31.82,0:57:34.24,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:57:36.20,0:57:37.57,Default,,0,0,0,,Хюга отбасы толығымен жойылды
Dialogue: 0,0:57:37.66,0:57:40.08,Default,,0,0,0,,Басқа зақым болғанымен,
Dialogue: 0,0:57:40.16,0:57:42.83,Default,,0,0,0,,Жер сәтті құтқарылған сияқты.
Dialogue: 0,0:57:42.91,0:57:44.87,Default,,0,0,0,,Құттықтау Құттықтау
Dialogue: 0,0:57:51.80,0:57:54.92,Default,,0,0,0,,құсу құсу құсу құсу
Dialogue: 0,0:57:55.97,0:57:57.39,Default,,0,0,0,,Енді сіз сенімді бола аласыз
Dialogue: 0,0:57:57.89,0:58:01.56,Default,,0,0,0,,Кероро взводының Пекопонға шабуылы басталды!
Dialogue: 0,0:58:03.02,0:58:05.02,Default,,0,0,0,,♪～
Dialogue: 0,0:59:41.41,0:59:43.41,Default,,0,0,0,,～♪
Dialogue: 0,0:59:44.91,0:59:50.91,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory