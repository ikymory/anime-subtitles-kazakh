Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.96,0:00:05.08,Default,,0,0,0,,<Гадиэль, хатыңызға рахмет>
Dialogue: 0,0:00:05.21,0:00:07.42,Default,,0,0,0,,<Мен сені жиі көре алмаймын, бірақ қалайсың? ＞
Dialogue: 0,0:00:08.05,0:00:12.88,Default,,0,0,0,,<Мен әлі де ханым істеу керек нәрсені істеуге мәжбүрмін>
Dialogue: 0,0:00:13.68,0:00:15.05,Default,,0,0,0,,<Егер бұл Ғадиел болса>
Dialogue: 0,0:00:15.22,0:00:18.68,Default,,0,0,0,,<"Мен туралы бәрі ойлағанына сенімдімін">
Dialogue: 0,0:00:18.81,0:00:20.47,Default,,0,0,0,,<Менің ойымша, сіз айтасыз>
Dialogue: 0,0:00:20.60,0:00:25.69,Default,,0,0,0,,<Бұл менің әкемді және сарайдағы барлық адамдарды мазақ еткен болуы керек.>
Dialogue: 0,0:00:25.81,0:00:27.73,Default,,0,0,0,,<Одан да көп>
Dialogue: 0,0:00:27.86,0:00:31.11,Default,,0,0,0,,<Мені қайтадан көруге келсеңіз қуанышты болар едім>
Dialogue: 0,0:00:31.94,0:00:35.99,Default,,0,0,0,,<О, иә, соңғы кездері қатты суық болып жатқан сияқты>
Dialogue: 0,0:00:36.11,0:00:39.87,Default,,0,0,0,,<Сау бол, Рафилия>
Dialogue: 0,0:00:41.04,0:00:44.00,Default,,0,0,0,,♪～
Dialogue: 0,0:02:03.95,0:02:06.91,Default,,0,0,0,,～♪
Dialogue: 0,0:02:15.80,0:02:17.63,Default,,0,0,0,,Дене қызуыңыз жоғары.
Dialogue: 0,0:02:17.76,0:02:19.13,Default,,0,0,0,,Аузыңызды ашыңыз
Dialogue: 0,0:02:21.68,0:02:23.81,Default,,0,0,0,,<Бадамша бездерім де ісінген>
Dialogue: 0,0:02:24.10,0:02:27.39,Default,,0,0,0,,<Соңғы кездегі суықтың белгілері...>
Dialogue: 0,0:02:28.48,0:02:31.10,Default,,0,0,0,,Балаңыздың температурасы қашан көтерілді?
Dialogue: 0,0:02:31.31,0:02:34.36,Default,,0,0,0,,Не? Ал... бүгін таңертең.
Dialogue: 0,0:02:34.48,0:02:36.49,Default,,0,0,0,,Таңертең кенеттен қызуым көтерілді.
Dialogue: 0,0:02:36.61,0:02:38.99,Default,,0,0,0,,Сізде бұрын жөтел болды ма?
Dialogue: 0,0:02:39.11,0:02:42.28,Default,,0,0,0,,Ойланып қарасам... Иә, солай болды.
Dialogue: 0,0:02:43.95,0:02:46.83,Default,,0,0,0,,Тез арада қызуды басатын дәрі берген дұрыс.
Dialogue: 0,0:02:46.95,0:02:49.54,Default,,0,0,0,,Ұзақ уақыт бойы жоғары температура болса, жақсы емес.
Dialogue: 0,0:02:50.54,0:02:54.38,Default,,0,0,0,,<Мен көп терлеймін, сондықтан сусызданудан сақ болу керек...>
Dialogue: 0,0:02:55.30,0:02:57.76,Default,,0,0,0,,Жеке бөлмеңізге кейінірек кіруімді сұраңыз.
Dialogue: 0,0:02:57.88,0:02:59.47,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:02:59.59,0:03:02.09,Default,,0,0,0,,Мен сенімен бірге жүрсем бола ма?
Dialogue: 0,0:03:02.22,0:03:03.89,Default,,0,0,0,,Мен мұны істей алмаймын
Dialogue: 0,0:03:04.01,0:03:06.56,Default,,0,0,0,,Балаңыздың ауруы сізге жұғуы мүмкін.
Dialogue: 0,0:03:06.72,0:03:07.72,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:03:07.85,0:03:11.27,Default,,0,0,0,,Уайымдамаңыз, 3 күннен кейін жақсы болады.
Dialogue: 0,0:03:11.40,0:03:12.31,Default,,0,0,0,,Медицина!?
Dialogue: 0,0:03:12.44,0:03:15.98,Default,,0,0,0,,Бұл жерде жақсы әсер ететін дәрі бар деп естідім...
Dialogue: 0,0:03:17.98,0:03:20.36,Default,,0,0,0,,Маған ыстықты түсіретін және суық тиюге қарсы дәрі алғым келеді.
Dialogue: 0,0:03:20.49,0:03:21.61,Default,,0,0,0,,Иә...
Dialogue: 0,0:03:30.12,0:03:31.29,Default,,0,0,0,,Ха-ха…
Dialogue: 0,0:03:31.42,0:03:33.67,Default,,0,0,0,,Иә, рақмет.
Dialogue: 0,0:03:38.67,0:03:41.47,Default,,0,0,0,,Балаларға 1 дәнді 3 тең бөлікке бөл.
Dialogue: 0,0:03:41.59,0:03:45.51,Default,,0,0,0,,Әр 12 сағат сайын күніне екі рет беріңіз.
Dialogue: 0,0:03:45.64,0:03:47.81,Default,,0,0,0,,Алдымен қарастырайық.
Dialogue: 0,0:03:47.93,0:03:49.06,Default,,0,0,0,,Иә
Dialogue: 0,0:03:49.27,0:03:52.31,Default,,0,0,0,,Тамақтан кейін суыққа қарсы дәрі беріңіз
Dialogue: 0,0:03:52.44,0:03:54.19,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:03:55.52,0:03:57.48,Default,,0,0,0,,Саған қалдырайық (ана) Иә...
Dialogue: 0,0:03:57.94,0:03:59.69,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:04:00.69,0:04:01.65,Default,,0,0,0,,Иә
Dialogue: 0,0:04:01.86,0:04:04.28,Default,,0,0,0,,Балалар сендерге сәттілік.
Dialogue: 0,0:04:04.41,0:04:06.87,Default,,0,0,0,,Ханшайым, сіз өзіңізді тексере аласыз.
Dialogue: 0,0:04:06.99,0:04:09.33,Default,,0,0,0,,А... ханшайым деген не?
Dialogue: 0,0:04:09.45,0:04:11.33,Default,,0,0,0,,Ханшайым емес!
Dialogue: 0,0:04:13.17,0:04:14.29,Default,,0,0,0,,Вентиляциялық тесік?!
Dialogue: 0,0:04:14.42,0:04:17.59,Default,,0,0,0,,Оны емші ханшайым деп атайды.
Dialogue: 0,0:04:17.71,0:04:21.76,Default,,0,0,0,,Хмм! Мен саған бұны доғар деп айтамын!
Dialogue: 0,0:04:21.88,0:04:23.22,Default,,0,0,0,,Охохохо кешіріңіз
Dialogue: 0,0:04:23.38,0:04:25.93,Default,,0,0,0,,Бұл шынымен ұят~ (Ровел) Ерен Уақыт келді...
Dialogue: 0,0:04:26.05,0:04:30.31,Default,,0,0,0,,А, иә, онда мен кешірім сұраймын.
Dialogue: 0,0:04:30.43,0:04:33.23,Default,,0,0,0,,Ах... Рахмет.
Dialogue: 0,0:04:37.31,0:04:39.94,Default,,0,0,0,,Мм... сол адамдар...
Dialogue: 0,0:04:40.07,0:04:41.69,Default,,0,0,0,,Хехехе
Dialogue: 0,0:04:41.78,0:04:43.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:44.70,0:04:47.87,Default,,0,0,0,,Емші ханшайым берген дәріні ішкенде,
Dialogue: 0,0:04:47.99,0:04:49.58,Default,,0,0,0,,3 күнде жазылды дейсіз бе?
Dialogue: 0,0:04:49.78,0:04:53.71,Default,,0,0,0,,Дұрыс! Келесі күні баламның қызуы толығымен басылды.
Dialogue: 0,0:04:53.83,0:04:55.96,Default,,0,0,0,,Мен шынымен таң қалдым.
Dialogue: 0,0:04:56.08,0:05:00.75,Default,,0,0,0,,Басында мен оны рухпен келісім жасаған сиқыршы деп ойладым.
Dialogue: 0,0:05:00.88,0:05:03.47,Default,,0,0,0,,Фармацевтке ұқсайды
Dialogue: 0,0:05:03.59,0:05:07.68,Default,,0,0,0,,Дәрі-дәрмекті рухтар қорғайды деген қауесеттер рас деп ойлаймын.
Dialogue: 0,0:05:07.93,0:05:10.60,Default,,0,0,0,,Ван Круфт отбасы қатысты деген нені айтасыз?
Dialogue: 0,0:05:10.72,0:05:11.89,Default,,0,0,0,,Иә...
Dialogue: 0,0:05:12.02,0:05:14.35,Default,,0,0,0,,Қызбен бірге болған адам...
Dialogue: 0,0:05:15.14,0:05:17.19,Default,,0,0,0,,Менің ойымша, ол батыр болды.
Dialogue: 0,0:05:19.94,0:05:22.28,Default,,0,0,0,,Бұл сарай емшісі Юм болатын.
Dialogue: 0,0:05:22.40,0:05:24.03,Default,,0,0,0,,(Кёсукэ Хори) Егер әке кетіп қалса—
Dialogue: 0,0:05:24.49,0:05:26.49,Default,,0,0,0,,Мен сіздің өтінішіңізді оқыдым.
Dialogue: 0,0:05:27.53,0:05:31.41,Default,,0,0,0,,Ван Круфт отбасына қатысты есірткі заттарын зерттегіңіз келетін сияқты.
Dialogue: 0,0:05:31.54,0:05:32.45,Default,,0,0,0,,Иә...
Dialogue: 0,0:05:32.58,0:05:37.04,Default,,0,0,0,,Мені бұл індетке қарсы тиімді деген дәрі қызықтырады.\NМаған
Dialogue: 0,0:05:37.17,0:05:39.25,Default,,0,0,0,,бойынша түсініктеме беруге рұқсат етіңіз...
Dialogue: 0,0:05:39.38,0:05:41.00,Default,,0,0,0,,Жоқ, жақсы (Хьюм) Ах!
Dialogue: 0,0:05:41.13,0:05:42.46,Default,,0,0,0,,Мен оны қарадым...
Dialogue: 0,0:05:42.59,0:05:44.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:45.76,0:05:48.30,Default,,0,0,0,,Сіз бұл дәріні алғыңыз келеді, солай ма?
Dialogue: 0,0:05:48.43,0:05:53.43,Default,,0,0,0,,Ауруы жазылмай жатқан анаңызға
Dialogue: 0,0:05:53.97,0:05:57.06,Default,,0,0,0,,Өтінемін... сөйлегенім үшін кешіріңіз.
Dialogue: 0,0:05:57.19,0:06:00.98,Default,,0,0,0,,А... Жоқ дедім, бірақ сен әлі айтасың.
Dialogue: 0,0:06:01.11,0:06:03.32,Default,,0,0,0,,Жақсы, мен сені кешіремін.
Dialogue: 0,0:06:04.73,0:06:08.03,Default,,0,0,0,,Бұл, әрине, өз мүддесіне арналған петиция.
Dialogue: 0,0:06:08.49,0:06:13.83,Default,,0,0,0,,Дегенмен, саудагерлер дәрі-дәрмекке қолын тигізуге тырысатын сияқты.
Dialogue: 0,0:06:13.95,0:06:17.91,Default,,0,0,0,,Біз, сот емшілері, ол дәріні мүмкіндігінше тезірек алуымыз керек.
Dialogue: 0,0:06:18.04,0:06:22.67,Default,,0,0,0,,Бұл халықтың сеніміне нұқсан келтіруі мүмкін деп ойладым...
Dialogue: 0,0:06:22.79,0:06:23.96,Default,,0,0,0,,Иә
Dialogue: 0,0:06:24.09,0:06:27.80,Default,,0,0,0,,Мен медицина туралы білгім келеді.
Dialogue: 0,0:06:29.09,0:06:31.14,Default,,0,0,0,,Халық сенімі...
Dialogue: 0,0:06:33.43,0:06:34.81,Default,,0,0,0,,Жақсы (Хьюм) Ха!
Dialogue: 0,0:06:37.27,0:06:38.89,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:06:39.02,0:06:39.77,Default,,0,0,0,,Хехе
Dialogue: 0,0:06:39.94,0:06:41.52,Default,,0,0,0,,Негізгі себебі
Dialogue: 0,0:06:41.69,0:06:45.19,Default,,0,0,0,,Мәселе мынада: сен сол жаста рух сиқыршысысың.
Dialogue: 0,0:06:47.15,0:06:50.61,Default,,0,0,0,,Мен болашағы зор адамдарды жақсы көремін.
Dialogue: 0,0:06:51.16,0:06:56.41,Default,,0,0,0,,Дегенмен Юмды анықтаудың шарттары бар.
Dialogue: 0,0:06:56.54,0:07:02.63,Default,,0,0,0,,Ванкрефттер отбасы корольдік отбасының ерекше мүшесі...
Dialogue: 0,0:07:04.46,0:07:08.13,Default,,0,0,0,,Сіз кете аласыз. Мен сізге кейінірек хабарлаймын.
Dialogue: 0,0:07:08.26,0:07:09.47,Default,,0,0,0,,Иә
Dialogue: 0,0:07:13.39,0:07:15.81,Default,,0,0,0,,Ғадиелді шақыру
Dialogue: 0,0:07:15.93,0:07:16.97,Default,,0,0,0,,Га
Dialogue: 0,0:07:19.98,0:07:22.27,Default,,0,0,0,,<Оның көңіл-күйі жақсы көрінді>
Dialogue: 0,0:07:22.40,0:07:25.69,Default,,0,0,0,,<Сол күлкінің бір сыры бар...>
Dialogue: 0,0:07:26.40,0:07:30.99,Default,,0,0,0,,<Бұл Ванкрефттер отбасына қатысты болуы мүмкін.>
Dialogue: 0,0:07:31.11,0:07:32.99,Default,,0,0,0,,<Мүмкін бұл...>
Dialogue: 0,0:07:33.11,0:07:37.49,Default,,0,0,0,,<Мүмкін бұл мен кірмейтін аймақ шығар>
Dialogue: 0,0:07:40.29,0:07:41.58,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:07:41.87,0:07:46.50,Default,,0,0,0,,Соңғы кездері Саувелдің қызымен хат алмасып жүрсіз бе?
Dialogue: 0,0:07:46.63,0:07:49.92,Default,,0,0,0,,Иә, мен тек анда-санда жауап жазамын...
Dialogue: 0,0:07:50.05,0:07:51.26,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:07:51.38,0:07:56.51,Default,,0,0,0,,Ванкрефттер отбасы жақында білікті дәріхананы жалдаған сияқты.
Dialogue: 0,0:07:56.97,0:07:58.72,Default,,0,0,0,,Якуши...?
Dialogue: 0,0:07:58.93,0:08:01.39,Default,,0,0,0,,Фармацевті кім жұмысқа алды?
Dialogue: 0,0:08:01.52,0:08:04.48,Default,,0,0,0,,Ол сол рух ханшайымы деген қауесет бар.
Dialogue: 0,0:08:04.69,0:08:07.40,Default,,0,0,0,,Не? Ерен?
Dialogue: 0,0:08:09.99,0:08:15.99,Default,,0,0,0,,Аумақта емделуге келгендердің саны өткен аймен салыстырғанда шамамен 30%-ға өсті.
Dialogue: 0,0:08:16.12,0:08:17.99,Default,,0,0,0,,30% өте көп...
Dialogue: 0,0:08:18.12,0:08:21.75,Default,,0,0,0,,Соның салдарынан дәрі-дәрмекпен қамтамасыз ету өз деңгейінде сақталмай отыр.
Dialogue: 0,0:08:22.12,0:08:27.13,Default,,0,0,0,,Төтенше мұқтаж адамдар дәрі-дәрмекке таласты.
Dialogue: 0,0:08:28.88,0:08:31.42,Default,,0,0,0,,Анықталған алғашқы көмек қажет болуы мүмкін
Dialogue: 0,0:08:31.63,0:08:34.34,Default,,0,0,0,,Төтенше жағдайды анықтау?
Dialogue: 0,0:08:34.47,0:08:38.39,Default,,0,0,0,,Емдеу тәртібі науқастың ауырлығына қарай анықталады.
Dialogue: 0,0:08:39.01,0:08:41.73,Default,,0,0,0,,Ауруларға төзімді емес балалар мен жүкті әйелдер
Dialogue: 0,0:08:41.85,0:08:44.85,Default,,0,0,0,,Есі жоқ науқастарға басымдық беріңіз.
Dialogue: 0,0:08:44.98,0:08:46.48,Default,,0,0,0,,Бұл жарақат алған жағдайда да қолданылады.
Dialogue: 0,0:08:46.69,0:08:48.61,Default,,0,0,0,,Хмм, сіздің ойыңыз бар.
Dialogue: 0,0:08:48.73,0:08:52.78,Default,,0,0,0,,Ерен күткендей, сіз тез шешім таптыңыз.
Dialogue: 0,0:08:52.90,0:08:55.41,Default,,0,0,0,,Джиджи мен қатты әсер алдым!
Dialogue: 0,0:08:55.53,0:08:57.49,Default,,0,0,0,,Еренге рахмет, сен маған көп көмектестің.
Dialogue: 0,0:08:57.62,0:09:01.08,Default,,0,0,0,,Сізге әрқашан сенім артқаным үшін кешіріңіз.
Dialogue: 0,0:09:01.20,0:09:05.46,Default,,0,0,0,,Бірақ менің білімім өзімнен бұрынғыларға тиесілі.
Dialogue: 0,0:09:05.58,0:09:07.96,Default,,0,0,0,,Мен ойлағандай емес
Dialogue: 0,0:09:08.42,0:09:12.96,Default,,0,0,0,,Мені мақтаған кезде, біраз өкінемін...
Dialogue: 0,0:09:13.09,0:09:18.26,Default,,0,0,0,,Бұрынғыларымыздың білімін, одан сабақ алып, қажет кезде пайдалана біл
Dialogue: 0,0:09:18.39,0:09:21.97,Default,,0,0,0,,Ата-бабамыз осылай еске түседі.
Dialogue: 0,0:09:23.10,0:09:25.06,Default,,0,0,0,,Иә, хехехе
Dialogue: 0,0:09:26.77,0:09:30.36,Default,,0,0,0,,Ах! Өйткені, менің қызым ең жақсы!
Dialogue: 0,0:09:30.57,0:09:33.07,Default,,0,0,0,,Тусама тітіркендіргіш!
Dialogue: 0,0:09:33.19,0:09:35.15,Default,,0,0,0,,Менің ағам Еренге тым көп көңіл бөледі.
Dialogue: 0,0:09:35.32,0:09:38.24,Default,,0,0,0,,Иә!? Мен Саувелдің бұл туралы естігенін қаламаймын!
Dialogue: 0,0:09:38.36,0:09:41.37,Default,,0,0,0,,Қызыңа көп көңіл бөлмейсің!
Dialogue: 0,0:09:48.75,0:09:51.25,Default,,0,0,0,,Лафилия Сіз ояусыз ба?
Dialogue: 0,0:10:00.93,0:10:03.26,Default,,0,0,0,,Менің қызым бүлікшіл кезеңде.
Dialogue: 0,0:10:03.39,0:10:06.02,Default,,0,0,0,,Сіз мені жалғыз қалдырғаныңыз үшін күңіреніп отырсыз, солай ма?
Dialogue: 0,0:10:06.56,0:10:08.48,Default,,0,0,0,,Зұлымдар Альянсының көлеңкесі – біздің ең үлкен алаңдаушылығымыз
Dialogue: 0,0:10:09.94,0:10:10.94,Default,,0,0,0,,Мен… (Дамиан) Хм. Тек балалар ойыны ғой.
Dialogue: 0,0:10:11.06,0:10:14.98,Default,,0,0,0,,Бауырым, тақырып шетке шығып кетті, бірақ мәселе бар.
Dialogue: 0,0:10:15.19,0:10:16.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:16.40,0:10:20.41,Default,,0,0,0,,Бұл аумақта емделу үшін қалатындардың саны көбейгендіктен бе?
Dialogue: 0,0:10:20.53,0:10:25.37,Default,,0,0,0,,Бізге соңғы уақытта қауіпсіздік жағдайы нашарлағаны туралы хабарламалар келіп түсті.
Dialogue: 0,0:10:29.04,0:10:31.38,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,0:10:31.71,0:10:33.34,Default,,0,0,0,,Ерен ақылды, бірақ
Dialogue: 0,0:10:33.46,0:10:36.17,Default,,0,0,0,,Өзіме келгенде шынымен наданмын.
Dialogue: 0,0:10:36.30,0:10:37.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:37.22,0:10:39.30,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:10:39.43,0:10:43.43,Default,,0,0,0,,Ерен қанша болса да бұл жаста өзіне объективті қарай алмайтын шығар.
Dialogue: 0,0:10:43.56,0:10:45.47,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:10:45.60,0:10:46.85,Default,,0,0,0,,Лорен (Лорен) Ха!
Dialogue: 0,0:10:48.48,0:10:50.35,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:10:50.98,0:10:53.15,Default,,0,0,0,,Түсіндім, мен сені шақырамын...
Dialogue: 0,0:10:53.27,0:10:55.28,Default,,0,0,0,,Біз бұл туралы көп сөйлестік, солай ма?
Dialogue: 0,0:10:55.40,0:10:57.03,Default,,0,0,0,,Әлі де сенбедіңіз бе?
Dialogue: 0,0:10:59.36,0:11:00.78,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:11:01.11,0:11:04.66,Default,,0,0,0,,Жоқ, бұл қазірдің өзінде аумақта өсек.
Dialogue: 0,0:11:04.78,0:11:09.37,Default,,0,0,0,,«Ванкрефттер отбасының кішкентай ханымы сізге дәрі береді».
Dialogue: 0,0:11:09.50,0:11:13.38,Default,,0,0,0,,Бұлай жалғаса берсе, Еренге қауіп төнуі мүмкін.
Dialogue: 0,0:11:13.50,0:11:18.38,Default,,0,0,0,,Басқаша айтқанда, мен бұрын шақырған адам...
Dialogue: 0,0:11:18.51,0:11:21.30,Default,,0,0,0,,Ереннің күзетшісі.
Dialogue: 0,0:11:21.43,0:11:23.85,Default,,0,0,0,,Мен сені әкелдім (Саувел)
Dialogue: 0,0:11:27.43,0:11:28.27,Default,,0,0,0,,Ах
Dialogue: 0,0:11:30.31,0:11:31.77,Default,,0,0,0,,Менің ұлым
Dialogue: 0,0:11:32.31,0:11:33.94,Default,,0,0,0,,Альберто ағай!?
Dialogue: 0,0:11:34.81,0:11:37.61,Default,,0,0,0,,Кай биыл 13 жасқа толады.
Dialogue: 0,0:11:37.73,0:11:40.65,Default,,0,0,0,,Ағай, сіз үйленгенсіз бе?
Dialogue: 0,0:11:41.45,0:11:43.41,Default,,0,0,0,,Сіз жалғыз көрінесіз бе?
Dialogue: 0,0:11:43.53,0:11:48.16,Default,,0,0,0,,Хмм, мен үнемі жұмыс істеймін, әйел адам жоқ.
Dialogue: 0,0:11:48.29,0:11:51.87,Default,,0,0,0,,Жұмыс... Бұл рас.
Dialogue: 0,0:11:52.71,0:11:55.08,Default,,0,0,0,,Танысқаныма қуаныштымын, менің атым Кай.
Dialogue: 0,0:11:58.67,0:12:01.26,Default,,0,0,0,,Танысқаныма қуаныштымын, менің атым Эллен.
Dialogue: 0,0:12:02.43,0:12:05.68,Default,,0,0,0,,Құрметті Эллен, мен әкемнен естідім.
Dialogue: 0,0:12:05.80,0:12:11.23,Default,,0,0,0,,Бұл өлеңде: ``Әкемді құтқарғаныңызға көп рахмет'' делінген.
Dialogue: 0,0:12:12.10,0:12:14.44,Default,,0,0,0,,Мен сені қорғауға бар күшімді саламын.
Dialogue: 0,0:12:14.56,0:12:17.82,Default,,0,0,0,,А... жоқ, мен ондай емеспін...
Dialogue: 0,0:12:17.94,0:12:20.49,Default,,0,0,0,,Бірақ бұған жол бермейтін адамдар бар.
Dialogue: 0,0:12:20.61,0:12:21.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:21.95,0:12:25.37,Default,,0,0,0,,Жоқ, мәселе күзетшілердің адам екендігінде.
Dialogue: 0,0:12:25.53,0:12:27.08,Default,,0,0,0,,Олар қарт адамды шынымен сынап жатыр
Dialogue: 0,0:12:27.49,0:12:30.04,Default,,0,0,0,,Эй, сен мені естисің, солай ма?
Dialogue: 0,0:12:35.50,0:12:36.42,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:36.54,0:12:38.00,Default,,0,0,0,,Әй, аға!
Dialogue: 0,0:12:38.13,0:12:41.13,Default,,0,0,0,,Жарайды Ван, өзіңді таныстыр.
Dialogue: 0,0:12:41.71,0:12:45.89,Default,,0,0,0,,Мен Ванмын, Винттің ұлы, желдің ұлы рухы.
Dialogue: 0,0:12:46.01,0:12:47.10,Default,,0,0,0,,Эллен-сама Абуна
Dialogue: 0,0:12:47.22,0:12:48.81,Default,,0,0,0,,Моффун!
Dialogue: 0,0:12:49.51,0:12:52.56,Default,,0,0,0,,Жарайды! Ван сен жақсы баласың
Dialogue: 0,0:12:52.68,0:12:55.27,Default,,0,0,0,,Хмм, жақсы!
Dialogue: 0,0:12:55.40,0:12:57.98,Default,,0,0,0,,Хехе, жаңадан жуылған.
Dialogue: 0,0:12:58.61,0:13:00.19,Default,,0,0,0,,Хун Кодонг
Dialogue: 0,0:13:00.32,0:13:03.61,Default,,0,0,0,,Ханшайымды қорғасаң ше? Ішімнің бір жағы ауырады
Dialogue: 0,0:13:03.82,0:13:04.90,Default,,0,0,0,,Не?!
Dialogue: 0,0:13:06.99,0:13:08.41,Default,,0,0,0,,Алайда, біз оның қозғалысын тоқтата аламыз.
Dialogue: 0,0:13:08.53,0:13:12.37,Default,,0,0,0,,Сол үшін мен де аруақтардан Ереннің оққағарларын жіберемін.
Dialogue: 0,0:13:13.20,0:13:15.37,Default,,0,0,0,,Ван желді еркін басқара алады.
Dialogue: 0,0:13:15.50,0:13:19.84,Default,,0,0,0,,Дыбыстарға сезімтал, алыстан өсек айтатын құлақтары жақсы.
Dialogue: 0,0:13:19.96,0:13:21.34,Default,,0,0,0,,Бұл пайдалы болады
Dialogue: 0,0:13:21.46,0:13:23.59,Default,,0,0,0,,Жоқ, бірақ аға!
Dialogue: 0,0:13:23.72,0:13:27.18,Default,,0,0,0,,Осындай үлкен аң қаланы дүрліктіреді.
Dialogue: 0,0:13:27.30,0:13:29.10,Default,,0,0,0,,Мен Тодомен мүмкіндігінше тезірек кездескім келеді—немесе ең болмағанда Мивамен—бірақ
Dialogue: 0,0:13:32.10,0:13:34.18,Default,,0,0,0,,Ханшайым, сен қалай ойлайсың?
Dialogue: 0,0:13:34.31,0:13:37.40,Default,,0,0,0,,Ван мырза! Мен енді адамға айнала аламын!
Dialogue: 0,0:13:37.52,0:13:39.40,Default,,0,0,0,,Иә! Күшті!
Dialogue: 0,0:13:40.11,0:13:41.65,Default,,0,0,0,,Мен солай ойлаймын!
Dialogue: 0,0:13:41.77,0:13:44.11,Default,,0,0,0,,Мен керемет және кереметмін!
Dialogue: 0,0:13:46.36,0:13:47.32,Default,,0,0,0,,Хун
Dialogue: 0,0:13:47.49,0:13:49.12,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:49.37,0:13:50.74,Default,,0,0,0,,Кішкентай балаға не болды?
Dialogue: 0,0:13:50.87,0:13:52.12,Default,,0,0,0,,Мен де...
Dialogue: 0,0:13:54.79,0:13:56.37,Default,,0,0,0,,Сәлем! Сіз жігіттер!
Dialogue: 0,0:13:56.50,0:13:58.25,Default,,0,0,0,,Ерен үшін не үшін ұрысып жатырсың?
Dialogue: 0,0:13:58.37,0:13:59.63,Default,,0,0,0,,Жоқ, жоқ!
Dialogue: 0,0:13:59.75,0:14:02.13,Default,,0,0,0,,Мен Ереннің жолсерігі боламын ғой!
Dialogue: 0,0:14:02.25,0:14:04.92,Default,,0,0,0,,Мен қызыма үйленбеймін! Аа!?
Dialogue: 0,0:14:05.09,0:14:06.22,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:06.34,0:14:08.05,Default,,0,0,0,,Аға?
Dialogue: 0,0:14:08.18,0:14:10.93,Default,,0,0,0,,Тусама тітіркендіргіш
Dialogue: 0,0:14:15.31,0:14:16.31,Default,,0,0,0,,Юм
Dialogue: 0,0:14:16.81,0:14:19.35,Default,,0,0,0,,Бүгін түнде осы маңдағы қонақүйде болайық.
Dialogue: 0,0:14:19.48,0:14:21.81,Default,,0,0,0,,Тым жақын келмейсіз бе?
Dialogue: 0,0:14:22.07,0:14:23.15,Default,,0,0,0,,Лорд Юм!
Dialogue: 0,0:14:23.27,0:14:25.40,Default,,0,0,0,,Мәртебелі Ғадиелге не айтасыз?
Dialogue: 0,0:14:25.53,0:14:27.28,Default,,0,0,0,,Оған көмектесу мүмкін емес, солай ма?
Dialogue: 0,0:14:27.82,0:14:30.24,Default,,0,0,0,,Менің рухым жоғары мәртебеден қорқады.
Dialogue: 0,0:14:31.37,0:14:34.37,Default,,0,0,0,,Жарайды, Фогель, бұл рас.
Dialogue: 0,0:14:34.66,0:14:37.50,Default,,0,0,0,,Сондай-ақ, мен қазір Мәртебелі емеспін.
Dialogue: 0,0:14:37.62,0:14:38.54,Default,,0,0,0,,Бұл Гаддис.
Dialogue: 0,0:14:39.25,0:14:42.00,Default,,0,0,0,,Қайда, кім тыңдап жатқаны маңызды емес.
Dialogue: 0,0:14:42.13,0:14:44.05,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:14:44.17,0:14:46.67,Default,,0,0,0,,Дәрі-дәрмекті кез келген бағамен алыңыз.
Dialogue: 0,0:14:46.80,0:14:49.55,Default,,0,0,0,,Оның қалай жасалғанын анықтауымыз керек.
Dialogue: 0,0:14:50.26,0:14:53.43,Default,,0,0,0,,Ванкрефттер отбасының жас ханымы қалай қатысты?
Dialogue: 0,0:14:53.76,0:14:56.64,Default,,0,0,0,,Әлде оны рухтар жаратты ма?
Dialogue: 0,0:14:56.77,0:14:59.23,Default,,0,0,0,,Менің рухым зерттеуі керек, солай ма?
Dialogue: 0,0:14:59.60,0:15:02.40,Default,,0,0,0,,Жұмыс істеуге тым қорқатын болсаңыз, не істейсіз?
Dialogue: 0,0:15:03.73,0:15:05.90,Default,,0,0,0,,Аа, дұрыс айтасыз.
Dialogue: 0,0:15:06.03,0:15:08.95,Default,,0,0,0,,Бірақ мен оны қабылдай алмаймын.
Dialogue: 0,0:15:09.07,0:15:10.07,Default,,0,0,0,,Не?
Dialogue: 0,0:15:10.49,0:15:13.16,Default,,0,0,0,,Мәртебелі жер бетінде не ойлайды?
Dialogue: 0,0:15:13.28,0:15:16.20,Default,,0,0,0,,Жоғары мәртебелі мырзаның мұндай жұмысты орындауы үшін неліктен өз жолыңыздан шығасыз?
Dialogue: 0,0:15:16.33,0:15:18.91,Default,,0,0,0,,Рабе Қанша айтсаң да түсінесің.
Dialogue: 0,0:15:19.04,0:15:20.21,Default,,0,0,0,,Мен Гаддиспін
Dialogue: 0,0:15:20.33,0:15:23.08,Default,,0,0,0,,Ах! кешіріңіз
Dialogue: 0,0:15:23.21,0:15:26.30,Default,,0,0,0,,Бірақ... бұл шектен шыққан.
Dialogue: 0,0:15:26.96,0:15:29.01,Default,,0,0,0,,Аурудың таралуына жол бермеу
Dialogue: 0,0:15:29.17,0:15:34.47,Default,,0,0,0,,Жел рухы ауруды көкке ұшырып, тазартады...
Dialogue: 0,0:15:35.60,0:15:37.18,Default,,0,0,0,,Қандай күш...
Dialogue: 0,0:15:45.23,0:15:48.19,Default,,0,0,0,,Менің жаным қорқады
Dialogue: 0,0:15:48.32,0:15:51.40,Default,,0,0,0,,Бұл жерде жоғары жел рухы бар екені даусыз.
Dialogue: 0,0:15:52.03,0:15:56.83,Default,,0,0,0,,Аруақтар дәрі жасайды деген қауесет рас болуы мүмкін...
Dialogue: 0,0:15:56.95,0:15:57.95,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:15:58.74,0:16:02.92,Default,,0,0,0,,<Дәріні жасайтын Ерен бе? ＞
Dialogue: 0,0:16:03.37,0:16:05.79,Default,,0,0,0,,Мырза... Гаддис?
Dialogue: 0,0:16:05.92,0:16:06.88,Default,,0,0,0,,О
Dialogue: 0,0:16:08.30,0:16:10.72,Default,,0,0,0,,<Мен бұл өзімшілдік екенін білемін>
Dialogue: 0,0:16:10.88,0:16:11.84,Default,,0,0,0,,<Тек...>
Dialogue: 0,0:16:13.01,0:16:16.30,Default,,0,0,0,,<Сізбен кездесуге деген сезімім өзгермейді>
Dialogue: 0,0:16:20.22,0:16:21.98,Default,,0,0,0,,(Ватару) Не болып жатыр? Бұл әңгіме… (Ер оқушы) Ол ұялы телефонымен дауласып жатыр.
Dialogue: 0,0:16:23.44,0:16:25.19,Default,,0,0,0,,Лафилия-сама
Dialogue: 0,0:16:26.48,0:16:28.23,Default,,0,0,0,,Бұл жас ханымға жазылған хат.
Dialogue: 0,0:16:28.36,0:16:29.48,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:29.65,0:16:30.90,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:16:32.07,0:16:34.03,Default,,0,0,0,,Ха! Бұл Ғадиелден!
Dialogue: 0,0:16:34.28,0:16:36.99,Default,,0,0,0,,Ханым! Мәртебелін шақыру үшін...
Dialogue: 0,0:16:37.33,0:16:40.20,Default,,0,0,0,,Шулы! Енді артқа шегінуге болады!
Dialogue: 0,0:16:47.00,0:16:49.63,Default,,0,0,0,,Не? Не... бұл өтірік, солай ма?
Dialogue: 0,0:16:50.55,0:16:52.55,Default,,0,0,0,,Ғадиел болса ше!
Dialogue: 0,0:16:56.47,0:17:01.10,Default,,0,0,0,,Айтпақшы, Альберто ағайдың әйелі қандай адам?
Dialogue: 0,0:17:01.22,0:17:04.89,Default,,0,0,0,,Оның жүрегі күшті, өте берік адам.
Dialogue: 0,0:17:05.02,0:17:09.77,Default,,0,0,0,,Анам туралы айтқаныңызда мен сәл ұяламын.
Dialogue: 0,0:17:09.90,0:17:10.78,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:17:10.90,0:17:14.78,Default,,0,0,0,,Демек, Альберто ағай әйелін сыйламайды...
Dialogue: 0,0:17:15.03,0:17:16.99,Default,,0,0,0,,Бұл қазірдің өзінде... Ngh!
Dialogue: 0,0:17:17.11,0:17:19.45,Default,,0,0,0,,Күтілгендей.
Dialogue: 0,0:17:19.91,0:17:23.79,Default,,0,0,0,,Бірақ бұл Альберто ағайға көбірек жарасады.
Dialogue: 0,0:17:25.92,0:17:28.75,Default,,0,0,0,,Енді мен анамды Элленмен таныстырамын.
Dialogue: 0,0:17:28.88,0:17:30.59,Default,,0,0,0,,Шынымен! Сенмен кездескім келеді!
Dialogue: 0,0:17:30.88,0:17:33.09,Default,,0,0,0,,Менің үйіме келіңізші!
Dialogue: 0,0:17:33.21,0:17:35.51,Default,,0,0,0,,Иә! (Ван) Мені үйіңе шақырғың келе ме?
Dialogue: 0,0:17:35.63,0:17:37.26,Default,,0,0,0,,Ата-анаңмен амандасу?
Dialogue: 0,0:17:37.59,0:17:38.76,Default,,0,0,0,,Мені кешіріңіз!
Dialogue: 0,0:17:38.89,0:17:40.43,Default,,0,0,0,,Тусама, шулы.
Dialogue: 0,0:17:40.56,0:17:41.47,Default,,0,0,0,,Ой...
Dialogue: 0,0:17:41.72,0:17:44.68,Default,,0,0,0,,Ағам Еренге шыдай алмайды.
Dialogue: 0,0:17:44.93,0:17:47.98,Default,,0,0,0,,Әрине, Ерен болса, бөксесіме жатқызуға қарсы емеспін.
Dialogue: 0,0:17:48.10,0:17:49.90,Default,,0,0,0,,Касама ұйықтап жатыр
Dialogue: 0,0:17:50.02,0:17:52.32,Default,,0,0,0,,Сәлем! Әзіл, Олли!
Dialogue: 0,0:17:52.44,0:17:56.49,Default,,0,0,0,,Мені тек Оллидің жамбасына жатқызуға болады!
Dialogue: 0,0:18:00.99,0:18:03.08,Default,,0,0,0,,Ханшайым! иә?
Dialogue: 0,0:18:03.20,0:18:05.25,Default,,0,0,0,,Мен айналама қараймын.
Dialogue: 0,0:18:05.37,0:18:07.92,Default,,0,0,0,,Егер сізге бірдеңе керек болса, бізге міндетті түрде қоңырау шалыңыз.
Dialogue: 0,0:18:08.04,0:18:11.38,Default,,0,0,0,,Иә, Ван, сіз де абай болыңыз.
Dialogue: 0,0:18:14.21,0:18:17.30,Default,,0,0,0,,Сіз ұсынған төтенше жағдай туралы мәселе.
Dialogue: 0,0:18:17.43,0:18:20.18,Default,,0,0,0,,Емшілердің ісі жақсы жүріп жатты.
Dialogue: 0,0:18:20.55,0:18:21.80,Default,,0,0,0,,Кейбір науқастар
Dialogue: 0,0:18:21.93,0:18:24.77,Default,,0,0,0,,«Бірінші келген мен едім» деген дұрыс.
Dialogue: 0,0:18:24.89,0:18:26.77,Default,,0,0,0,,Қазіргі жағдай – мұның соңы жоқ...
Dialogue: 0,0:18:27.18,0:18:32.48,Default,,0,0,0,,Барлығы да дәрі-дәрмегін ала аламын ба деп уайымдап жүрген сияқты.
Dialogue: 0,0:18:32.61,0:18:36.40,Default,,0,0,0,,Сонда мен бәріне көбірек дәрі берем...
Dialogue: 0,0:18:36.53,0:18:37.74,Default,,0,0,0,,Эллен!
Dialogue: 0,0:18:37.86,0:18:40.28,Default,,0,0,0,,Мен сіздің сезіміңізді түсінемін, бірақ бұл жақсы емес.
Dialogue: 0,0:18:40.41,0:18:44.87,Default,,0,0,0,,Жасалатын дәрі-дәрмектің көлемі туралы айттық, солай ма?
Dialogue: 0,0:18:44.99,0:18:48.91,Default,,0,0,0,,Дегенмен, мен сіздің алаңдаушылықтарыңызды алып тастағым келеді.
Dialogue: 0,0:18:49.58,0:18:51.92,Default,,0,0,0,,Тосама, сәл ғана...
Dialogue: 0,0:18:52.04,0:18:55.38,Default,,0,0,0,,Дәрінің дозасын аздап көбейту керек пе?
Dialogue: 0,0:19:04.06,0:19:06.22,Default,,0,0,0,,Эллен
Dialogue: 0,0:19:07.27,0:19:09.44,Default,,0,0,0,,Өзіңізді ешқашан мәжбүрлемеңіз...
Dialogue: 0,0:19:11.52,0:19:14.69,Default,,0,0,0,,Иә, түсіндім.
Dialogue: 0,0:19:23.28,0:19:24.20,Default,,0,0,0,,Ах
Dialogue: 0,0:19:24.70,0:19:26.66,Default,,0,0,0,,Не!? Жолбарыс!?
Dialogue: 0,0:19:28.08,0:19:32.63,Default,,0,0,0,,Күте тұрыңыз! Сізді таң қалдырғаным үшін кешіріңіз! бұл адам рух
Dialogue: 0,0:19:36.80,0:19:40.30,Default,,0,0,0,,Менің атым Ван, ханшайымның күзетшісі.
Dialogue: 0,0:19:40.42,0:19:42.05,Default,,0,0,0,,А...
Dialogue: 0,0:19:42.18,0:19:43.89,Default,,0,0,0,,Қайтадан қош келдіңіз!
Dialogue: 0,0:19:44.22,0:19:46.10,Default,,0,0,0,,Джиджи! Мен үйдемін!
Dialogue: 0,0:19:46.22,0:19:48.43,Default,,0,0,0,,Иә~ Ерен-сама~!
Dialogue: 0,0:19:49.48,0:19:54.90,Default,,0,0,0,,Уухо, мен саған арнайы шай дайындаймын, Эллен.
Dialogue: 0,0:19:55.02,0:19:55.86,Default,,0,0,0,,Лорен!
Dialogue: 0,0:19:56.15,0:19:57.11,Default,,0,0,0,,Ха!
Dialogue: 0,0:19:57.23,0:20:01.61,Default,,0,0,0,,Мен бүгін Рафилия мен Ариямен кешкі ас ішуді ойлап отырмын. Өтінемін маған білдір.
Dialogue: 0,0:20:01.74,0:20:03.99,Default,,0,0,0,,Қайырлы таң.
Dialogue: 0,0:20:04.12,0:20:05.32,Default,,0,0,0,,Достардан ғашықтарға, тіпті отбасы мүшелерінен де
Dialogue: 0,0:20:05.95,0:20:07.03,Default,,0,0,0,,Анасы да
Dialogue: 0,0:20:07.74,0:20:10.25,Default,,0,0,0,,Әрине!
Dialogue: 0,0:20:12.83,0:20:15.63,Default,,0,0,0,,Эллен айтқандай, мен оны қолданып көрдім.
Dialogue: 0,0:20:15.75,0:20:18.17,Default,,0,0,0,,Көкөністер жақсы өсіп жатыр.
Dialogue: 0,0:20:18.30,0:20:20.13,Default,,0,0,0,,Бұл жақсы болды.
Dialogue: 0,0:20:20.26,0:20:21.13,Default,,0,0,0,,Айтып тұрғасын...
Dialogue: 0,0:20:21.55,0:20:25.85,Default,,0,0,0,,Ағаң егістік тыңайтқыш туралы ақылдаспақшы деп естідім.
Dialogue: 0,0:20:25.97,0:20:28.39,Default,,0,0,0,,Мен де өрістерді жеке көргім келеді.
Dialogue: 0,0:20:28.51,0:20:31.43,Default,,0,0,0,,Емдеу емханасындағы жағдай тынышталған соң, бірге барайық.
Dialogue: 0,0:20:31.56,0:20:33.27,Default,,0,0,0,,Бұл пайдалы!
Dialogue: 0,0:20:34.81,0:20:36.40,Default,,0,0,0,,Енгізу (есіктің ашылған дыбысы)
Dialogue: 0,0:20:37.40,0:20:40.11,Default,,0,0,0,,Күйеуім, Лафилия-сама мұнда жоқ.
Dialogue: 0,0:20:40.28,0:20:41.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:41.44,0:20:45.45,Default,,0,0,0,,Мен сарайдың бәрін іздедім, бірақ оны еш жерден таба алмадым...
Dialogue: 0,0:20:48.91,0:20:49.91,Default,,0,0,0,,Лафилия!
Dialogue: 0,0:20:59.21,0:21:00.71,Default,,0,0,0,,Ария!
Dialogue: 0,0:21:00.84,0:21:01.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:02.51,0:21:04.72,Default,,0,0,0,,Сіз Ария Лафилияны білмейсіз бе?
Dialogue: 0,0:21:07.80,0:21:09.18,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:21:10.10,0:21:12.14,Default,,0,0,0,,Лафилияға не болды?
Dialogue: 0,0:21:13.60,0:21:14.85,Default,,0,0,0,,Лафилия...
Dialogue: 0,0:21:15.35,0:21:16.65,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:21:16.77,0:21:18.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:21.40,0:21:24.99,Default,,0,0,0,,Мен ол баланы тыңдамадым.
Dialogue: 0,0:21:26.20,0:21:28.41,Default,,0,0,0,,Жоқ... ол үйден қашып кетті!?
Dialogue: 0,0:21:37.12,0:21:38.58,Default,,0,0,0,,Ван мырза?
Dialogue: 0,0:21:44.26,0:21:47.01,Default,,0,0,0,,Ванкрефттер отбасы...
Dialogue: 0,0:21:47.18,0:21:50.22,Default,,0,0,0,,Медицина… Алу…
Dialogue: 0,0:21:50.35,0:21:52.72,Default,,0,0,0,,Ханым...
Dialogue: 0,0:21:55.60,0:21:57.60,Default,,0,0,0,,Мен осылай деген дауысты естідім.
Dialogue: 0,0:21:57.77,0:21:58.81,Default,,0,0,0,,Не!
Dialogue: 0,0:21:59.73,0:22:01.27,Default,,0,0,0,,Қазірге дейінгі тәжірибелердің нәтижелеріне сүйене отырып,
Dialogue: 0,0:22:04.03,0:22:08.16,Default,,0,0,0,,Мені қателесіп, ұрлап кетті...
Dialogue: 0,0:22:10.28,0:22:13.24,Default,,0,0,0,,♪～
Dialogue: 0,0:23:36.70,0:23:39.66,Default,,0,0,0,,～♪
Dialogue: 0,0:23:41.16,0:23:47.16,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory