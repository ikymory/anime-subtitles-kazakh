Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.50,0:00:08.50,SGS,NTP,0000,0000,0000,,SGS Akebonosha субтитр жұбы
Dialogue: 0,0:01:42.46,0:01:47.52,Title,NTP,0000,0000,0000,,Бұлттың екінші жағы
Dialogue: 0,0:00:13.50,0:00:16.50,Staff,NTP,0000,0000,0000,,Аудармасы: Кенгуру
Dialogue: 0,0:00:16.50,0:00:19.50,Staff,NTP,0000,0000,0000,,Уақыт: ACG
Dialogue: 0,0:00:19.50,0:00:22.50,Staff,NTP,0000,0000,0000,,Арнайы әсер: Тени
Dialogue: 0,0:00:22.50,0:00:25.50,Staff,NTP,0000,0000,0000,,Кеш кезең: Сяойи
Dialogue: 0,0:00:00.00,0:00:00.00,*Default,NTP,0000,0000,0000,,--------
Dialogue: 0,0:00:07.94,0:00:12.84,*Default,NTP,0000,0000,0000,,Ол үнемі бірдеңені жоғалтамын деген сезімде болатынын айтты.
Dialogue: 0,0:00:30.83,0:00:32.02,*Default,NTP,0000,0000,0000,,Сол кезде
Dialogue: 0,0:00:32.19,0:00:37.03,*Default,NTP,0000,0000,0000,,Мен әлі кіші мектеп оқушысы едім, сондықтан оны сезіну мүмкін емес еді.
Dialogue: 0,0:00:37.53,0:00:44.06,*Default,NTP,0000,0000,0000,,Сонда да оның сөздері жүрегімді елжіретіп жіберді.
Dialogue: 0,0:00:51.18,0:00:52.94,*Default,NTP,0000,0000,0000,,Соғысқа дейін
Dialogue: 0,0:00:53.48,0:00:55.92,*Default,NTP,0000,0000,0000,,Эзо деп аталатын үлкен арал
Dialogue: 0,0:00:56.48,0:00:59.18,*Default,NTP,0000,0000,0000,,Бұл басқа елдің территориясы болған кездегі оқиға.
Dialogue: 0,0:01:18.41,0:01:19.46,*Default,NTP,0000,0000,0000,,Тамаша!
Dialogue: 0,0:01:23.55,0:01:24.91,*Default,NTP,0000,0000,0000,,Ұшақ! ?
Dialogue: 0,0:01:35.69,0:01:40.56,*Default,NTP,0000,0000,0000,,Ол күн қазір алыс, бұл бұлттардың арғы жағында
Dialogue: 0,0:01:40.66,0:01:42.76,*Default,NTP,0000,0000,0000,,Менің құрбыммен кездесуге келген жер болды.
Dialogue: 0,0:01:46.67,0:01:49.36,*Default,NTP,0000,0000,0000,,«Қатты қызба мен тыныс алу арасындағы».
Dialogue: 0,0:01:49.84,0:01:52.20,*Default,NTP,0000,0000,0000,,«Сіз мұны істеуімді сұрадыңыз».
Dialogue: 0,0:01:52.61,0:01:55.70,*Default,NTP,0000,0000,0000,,«Галактика деп аталатын әлем, күн, атмосфера және т.б.»
Dialogue: 0,0:01:55.94,0:01:59.04,*Default,NTP,0000,0000,0000,,«Аспаннан түскен соңғы қар».
Dialogue: 0,0:01:59.65,0:02:01.41,*Default,NTP,0000,0000,0000,,«Граниттің бір бөлігіне»
Dialogue: 0,0:02:01.52,0:02:03.88,*Default,NTP,0000,0000,0000,,«Қар жалғыз»
Dialogue: 0,0:02:04.09,0:02:06.45,*Default,NTP,0000,0000,0000,,«Мен оған қауіптімін»
Dialogue: 0,0:02:06.55,0:02:09.55,*Default,NTP,0000,0000,0000,,«Таза ақ екі фазалы қар мен су жүйесі бар»
Dialogue: 0,0:02:09.76,0:02:12.09,*Default,NTP,0000,0000,0000,,«Мөлдір суық тамшыларға толы»
Dialogue: 0,0:02:14.00,0:02:18.73,*Default,NTP,0000,0000,0000,,Ол кезде біз екі нәрсені аңсайтынбыз.
Dialogue: 0,0:02:19.07,0:02:19.76,*Default,NTP,0000,0000,0000,,Неше минут қалды?
Dialogue: 0,0:02:19.87,0:02:21.63,*Default,NTP,0000,0000,0000,,бәрібір.
Dialogue: 0,0:02:31.68,0:02:32.34,*Default,NTP,0000,0000,0000,,Қараңыз
Dialogue: 0,0:02:32.45,0:02:34.38,*Default,NTP,0000,0000,0000,,Атчи… Рахмет
Dialogue: 0,0:02:34.48,0:02:36.71,*Default,NTP,0000,0000,0000,,Хироки, келесі жарты күндік жұмысыңызға қашан барасыз?
Dialogue: 0,0:02:36.82,0:02:41.08,*Default,NTP,0000,0000,0000,,А, менде ертеңге дейін үйірме жұмыстары бар, ертең шығар? Такуя ше?
Dialogue: 0,0:02:41.19,0:02:43.66,*Default,NTP,0000,0000,0000,,Ертеңгі таңғы жаттығу менің де соңғысы болады.
Dialogue: 0,0:02:44.96,0:02:46.45,*Default,NTP,0000,0000,0000,,Ертең шешіледі.
Dialogue: 0,0:02:46.83,0:02:47.82,*Default,NTP,0000,0000,0000,,О
Dialogue: 0,0:02:53.43,0:02:57.87,*Default,NTP,0000,0000,0000,,Менің кумирлерімнің бірі менің сыныптасым Саюри Саватари.
Dialogue: 0,0:02:59.61,0:03:01.10,*Default,NTP,0000,0000,0000,,Ал басқа нәрсе
Dialogue: 0,0:03:01.64,0:03:06.71,*Default,NTP,0000,0000,0000,,Бұл үлкен мұнара Цугару бұғазының шекарасынан асып түседі.
Dialogue: 0,0:03:15.62,0:03:19.56,*Default,NTP,0000,0000,0000,,Мен үнемі сол мұнараға қарайтынмын
Dialogue: 0,0:03:21.16,0:03:24.62,*Default,NTP,0000,0000,0000,,Мен үшін өте маңызды нәрсе
Dialogue: 0,0:03:24.90,0:03:27.23,*Default,NTP,0000,0000,0000,,Мен сол жерде мені бірдеңе күтіп тұрғандай сезіндім.
Dialogue: 0,0:03:27.50,0:03:30.49,*Default,NTP,0000,0000,0000,,Әйтеуір, менде қобалжу болды.
Dialogue: 0,0:03:56.43,0:03:57.73,*Default,NTP,0000,0000,0000,,…Бір күні!
Dialogue: 0,0:04:16.35,0:04:17.48,*Default,NTP,0000,0000,0000,,…Бір күні
Dialogue: 0,0:04:17.95,0:04:19.54,*Default,NTP,0000,0000,0000,,Мен міндетті түрде барамын
Dialogue: 0,0:04:27.73,0:04:29.32,*Default,NTP,0000,0000,0000,,Ширакава Сенпай!
Dialogue: 0,0:04:30.83,0:04:32.20,*Default,NTP,0000,0000,0000,,Мен келе жатырмын
Dialogue: 0,0:04:32.30,0:04:33.70,*Default,NTP,0000,0000,0000,,Сендер-ай, шіркін!
Dialogue: 0,0:04:35.17,0:04:39.27,*Default,NTP,0000,0000,0000,,Әй, әлгі сенпайлар бүгін зейнеткерлікке шықты.
Dialogue: 0,0:04:39.37,0:04:41.54,*Default,NTP,0000,0000,0000,,Мен қалаған нәрсе бар.
Dialogue: 0,0:04:42.04,0:04:43.41,*Default,NTP,0000,0000,0000,,Қарашы, Кана-чан
Dialogue: 0,0:04:43.51,0:04:45.24,*Default,NTP,0000,0000,0000,,Эхиё Чиотто
Dialogue: 0,0:04:46.68,0:04:48.67,*Default,NTP,0000,0000,0000,,Бұл
Dialogue: 0,0:04:48.82,0:04:49.98,*Default,NTP,0000,0000,0000,,…Бұл!
Dialogue: 0,0:04:50.92,0:04:53.18,*Default,NTP,0000,0000,0000,,... сондықтан сіз бас тарттыңыз ба?
Dialogue: 0,0:04:53.29,0:04:54.65,*Default,NTP,0000,0000,0000,,Әдеттегідей
Dialogue: 0,0:04:55.96,0:04:57.05,*Default,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:05:00.09,0:05:03.39,*Default,NTP,0000,0000,0000,,Бірінші курс Мацуура, ол сүйкімді.
Dialogue: 0,0:05:03.50,0:05:04.97,*Default,NTP,0000,0000,0000,,Сонда Хироки сенімен бірге жүреді.
Dialogue: 0,0:05:05.07,0:05:06.16,*Default,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:05:06.57,0:05:08.26,*Default,NTP,0000,0000,0000,,Менімен кездесесің бе?
Dialogue: 0,0:05:08.37,0:05:10.53,*Default,NTP,0000,0000,0000,,Е, жоқ, неге мен...
Dialogue: 0,0:05:10.64,0:05:12.73,*Default,NTP,0000,0000,0000,,Сізге біреу ұнайды ма?
Dialogue: 0,0:05:12.84,0:05:14.36,*Default,NTP,0000,0000,0000,,Не? Неліктен?
Dialogue: 0,0:05:14.48,0:05:17.97,*Default,NTP,0000,0000,0000,,Жоқ, мен оны сүйкімді қыз деп ойлаймын.
Dialogue: 0,0:05:18.08,0:05:19.57,*Default,NTP,0000,0000,0000,,Мен сенімен бірге шығамын
Dialogue: 0,0:05:19.68,0:05:22.74,*Default,NTP,0000,0000,0000,,Мен не істерімді білмеймін...
Dialogue: 0,0:05:25.89,0:05:27.86,*Default,NTP,0000,0000,0000,,Сізді мойындады, солай емес пе?
Dialogue: 0,0:05:27.96,0:05:29.75,*Default,NTP,0000,0000,0000,,Сіз естідіңіз!
Dialogue: 0,0:05:42.10,0:05:43.43,*Default,NTP,0000,0000,0000,,Саватари...!
Dialogue: 0,0:06:01.92,0:06:03.86,*Default,NTP,0000,0000,0000,,Әй, Фудзисава-кун!
Dialogue: 0,0:06:04.46,0:06:07.79,*Default,NTP,0000,0000,0000,,Саватари: Үйге кеш келдіңіз.
Dialogue: 0,0:06:07.90,0:06:10.89,*Default,NTP,0000,0000,0000,,Иә, мен жаттығып жүр едім, кешігіп қалдым.
Dialogue: 0,0:06:11.23,0:06:12.16,*Default,NTP,0000,0000,0000,,Скрипка?
Dialogue: 0,0:06:12.27,0:06:16.36,*Default,NTP,0000,0000,0000,,Иә, Фудзисава-кун Ширакава-кунмен бірдей емес пе?
Dialogue: 0,0:06:16.47,0:06:19.30,*Default,NTP,0000,0000,0000,,А, мен де үйірме жұмыстарына барамын.
Dialogue: 0,0:06:19.41,0:06:22.81,*Default,NTP,0000,0000,0000,,Фудзисава-кун, сіз кейде садақыңызды өзіңіз тартасыз.
Dialogue: 0,0:06:23.28,0:06:28.01,*Default,NTP,0000,0000,0000,,Жарайды, мен ондай емеспін... Менде көп көңіл бөлетін ойлар бар.
Dialogue: 0,0:06:33.15,0:06:36.18,*Default,NTP,0000,0000,0000,,Фудзисава-кун, көктемгі демалысқа жоспарың бар ма?
Dialogue: 0,0:06:36.29,0:06:39.02,*Default,NTP,0000,0000,0000,,Иә, мен Такуямен толық емес жұмыс күнімен жұмыс істеймін.
Dialogue: 0,0:06:39.13,0:06:41.72,*Default,NTP,0000,0000,0000,,А, толық емес жұмыс күні ме? Керемет, қайда! ?
Dialogue: 0,0:06:41.83,0:06:45.99,*Default,NTP,0000,0000,0000,,Хамана әскери қосалқы мердігерлік зауыты басқарылатын зымырандарды құрастырады
Dialogue: 0,0:06:46.10,0:06:49.83,*Default,NTP,0000,0000,0000,,Хмм, бұл қандай керемет, толық емес жұмыс күні.
Dialogue: 0,0:06:49.94,0:06:52.34,*Default,NTP,0000,0000,0000,,Мен тек үйірме жұмыстарына қатысамын...
Dialogue: 0,0:06:53.11,0:06:54.20,*Default,NTP,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:06:54.31,0:06:55.28,*Default,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:07:07.32,0:07:09.69,Notes,NTP,0000,0000,0000,,Келесі кезекте шағын және орта елдер. Шағын және орта елдер
Dialogue: 0,0:07:09.79,0:07:12.16,Notes,NTP,0000,0000,0000,,Шағын және орта елдерден кейін Тайпинге тоқтаңыз.
Dialogue: 0,0:07:12.26,0:07:13.82,*Default,NTP,0000,0000,0000,,Біз жақындап қалдық...
Dialogue: 0,0:07:14.63,0:07:16.82,*Default,NTP,0000,0000,0000,,...Білесің бе, маған ұнайды.
Dialogue: 0,0:07:16.93,0:07:19.96,*Default,NTP,0000,0000,0000,,Мен Фудзисавамен осылай үйге баруды армандадым.
Dialogue: 0,0:07:23.91,0:07:25.93,*Default,NTP,0000,0000,0000,,Қош бол! Мектепке қайта оралды!
Dialogue: 0,0:07:26.04,0:07:27.80,*Default,NTP,0000,0000,0000,,Және қалағаныңа қол жеткізе алмасаң—
Dialogue: 0,0:07:59.97,0:08:02.64,Notes,NTP,0000,0000,0000,,12-нен бастап 3 күн бойы өткізіледі.
Dialogue: 0,0:08:02.74,0:08:06.24,Notes,NTP,0000,0000,0000,,11
Dialogue: 0,0:08:06.35,0:08:08.82,Notes,NTP,0000,0000,0000,,Солтүстік-Оңтүстік мәселесіне Жапонияның жауабы шиеленісуде.
Dialogue: 0,0:08:08.92,0:08:10.75,Notes,NTP,0000,0000,0000,,Бұл назар аударатын сияқты
Dialogue: 0,0:08:10.85,0:08:13.55,Notes,NTP,0000,0000,0000,,Американың нысандарын, соның ішінде Мисава базасын нығайту
Dialogue: 0,0:08:13.65,0:08:15.85,Notes,NTP,0000,0000,0000,,Мүдделі Одақ үкіметіне
Dialogue: 0,0:08:15.96,0:08:18.79,Notes,NTP,0000,0000,0000,,Америка үкіметін Одақ Эзо территориясында тұрғызды.
Dialogue: 0,0:08:18.89,0:08:22.16,Notes,NTP,0000,0000,0000,,Үлкен мұнара нысанының мақсаты әлі анықталған жоқ.
Dialogue: 0,0:08:22.26,0:08:24.06,Notes,NTP,0000,0000,0000,,Күшті мазасыздық сезімін көрсетеді...
Dialogue: 0,0:08:22.70,0:08:24.06,*Default,NTP,0000,0000,0000,,Сәлеметсіз бе
Dialogue: 0,0:08:24.53,0:08:26.06,*Default,NTP,0000,0000,0000,,Ия, шайдың уақыты келді ме?
Dialogue: 0,0:08:26.23,0:08:27.63,*Default,NTP,0000,0000,0000,,Эй, мына жерге отыр.
Dialogue: 0,0:08:27.74,0:08:28.90,*Default,NTP,0000,0000,0000,,Жоғары
Dialogue: 0,0:08:29.00,0:08:29.97,*Default,NTP,0000,0000,0000,,Жақсы жұмыс Хироки
Dialogue: 0,0:08:30.07,0:08:31.04,*Default,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:08:31.14,0:08:32.70,*Default,NTP,0000,0000,0000,,Хироки, мен оны естідім.
Dialogue: 0,0:08:32.81,0:08:35.64,*Default,NTP,0000,0000,0000,,Сонымен сендер JMSDF чуккар ұрлап алдыңдар ма?
Dialogue: 0,0:08:35.74,0:08:36.23,*Default,NTP,0000,0000,0000,,Сонымен
Dialogue: 0,0:08:36.34,0:08:37.57,*Default,NTP,0000,0000,0000,,Бұл – тұзақ.
Dialogue: 0,0:08:37.78,0:08:38.77,*Default,NTP,0000,0000,0000,,Ол ұрланған жоқ.
Dialogue: 0,0:08:39.08,0:08:41.31,*Default,NTP,0000,0000,0000,,Оны орманнан он адам көтеріп алды!
Dialogue: 0,0:08:41.62,0:08:43.38,*Default,NTP,0000,0000,0000,,Менің ойымша, ол ұрлаған шығар.
Dialogue: 0,0:08:43.48,0:08:45.61,*Default,NTP,0000,0000,0000,,Жақында дрондарды ұшатын жаттығулар көп болды.
Dialogue: 0,0:08:45.72,0:08:46.98,*Default,NTP,0000,0000,0000,,...
Dialogue: 0,0:08:47.09,0:08:49.56,*Default,NTP,0000,0000,0000,,Аяқпен сүрініп қалудан сақ болыңыз.
Dialogue: 0,0:08:49.92,0:08:51.02,*Default,NTP,0000,0000,0000,,Оған не болды?
Dialogue: 0,0:08:51.13,0:08:54.72,*Default,NTP,0000,0000,0000,,Тегін болса да, бұл жер қоғамдық қауіпсіздіктің назарында.
Dialogue: 0,0:08:56.36,0:08:59.13,*Default,NTP,0000,0000,0000,,Басқа адамдар туралы жаман сөз айтпа!
Dialogue: 0,0:08:59.47,0:09:00.93,*Default,NTP,0000,0000,0000,,Жұмыс, еңбек
Dialogue: 0,0:09:01.04,0:09:02.40,*Default,NTP,0000,0000,0000,,Ой-ау, онда мен де күтіп, өзім үйленбей тұруым керек екен ғой?
Dialogue: 0,0:09:02.54,0:09:03.14,*Default,NTP,0000,0000,0000,,Сонда кездескенше
Dialogue: 0,0:09:03.14,0:09:04.53,*Default,NTP,0000,0000,0000,,Жоғары
Dialogue: 0,0:09:05.07,0:09:07.94,*Default,NTP,0000,0000,0000,,Балалар, сендер де ертеңнен бастап дұрыстап жұмыс істеулерің керек.
Dialogue: 0,0:09:08.04,0:09:10.67,*Default,NTP,0000,0000,0000,,Материалдардың құнынан артық жұмсаймын.
Dialogue: 0,0:09:10.78,0:09:11.97,*Default,NTP,0000,0000,0000,,Иә...
Dialogue: 0,0:09:12.18,0:09:14.01,*Default,NTP,0000,0000,0000,,Олай болса, кешіріңіз!
Dialogue: 0,0:09:14.12,0:09:15.05,*Default,NTP,0000,0000,0000,,Оу
Dialogue: 0,0:09:16.78,0:09:20.41,*Default,NTP,0000,0000,0000,,Толық емес жұмысқа кірісуіміздің себебі болды.
Dialogue: 0,0:09:20.99,0:09:25.48,*Default,NTP,0000,0000,0000,,Эзо әлі Хоккайдо деп аталған және осы елдің бөлігі болған кезде.
Dialogue: 0,0:09:25.59,0:09:29.93,*Default,NTP,0000,0000,0000,,Цугару бұғазының астынан туннель қазу жоспары болған сияқты.
Dialogue: 0,0:09:30.63,0:09:35.30,*Default,NTP,0000,0000,0000,,Соңында Солтүстік пен Оңтүстіктің бөлінуімен үзілді.
Dialogue: 0,0:09:35.40,0:09:37.34,*Default,NTP,0000,0000,0000,,...
Dialogue: 0,0:09:37.44,0:09:42.07,*Default,NTP,0000,0000,0000,,Құрылыс жұмыстарынан қалған кейбір қараусыз қалған станциялар мен рельстер әлі де бар.
Dialogue: 0,0:09:43.01,0:09:47.45,*Default,NTP,0000,0000,0000,,Біз осы таудың басындағы қараусыз қалған станциялардың бірінде болдық.
Dialogue: 0,0:09:47.55,0:09:49.91,*Default,NTP,0000,0000,0000,,Мен былтырдан бері бірдеңе жасап жүрмін.
Dialogue: 0,0:09:50.48,0:09:54.48,*Default,NTP,0000,0000,0000,,АҚШ әскері үшін қосалқы мердігерлік фабрикасы Emishi Manufacturing-те кім жұмыс істейді?
Dialogue: 0,0:09:54.59,0:09:56.78,*Default,NTP,0000,0000,0000,,Бөлшектерге ақша табу.
Dialogue: 0,0:09:58.09,0:10:00.86,*Default,NTP,0000,0000,0000,,Жете алатыным сонша алыста көрінсе де
Dialogue: 0,0:10:00.96,0:10:03.56,*Default,NTP,0000,0000,0000,,Сіз бара алмайтын жер
Dialogue: 0,0:10:04.47,0:10:09.87,*Default,NTP,0000,0000,0000,,Екеуміз де сол беймәлім аралды және онда бой көтерген алып мұнараны білеміз.
Dialogue: 0,0:10:10.07,0:10:12.56,*Default,NTP,0000,0000,0000,,Мен оны өз көзіммен көргім келді.
Dialogue: 0,0:10:17.81,0:10:21.04,*Default,NTP,0000,0000,0000,,Қар аз жауды. Жақында қайта бастағым келеді.
Dialogue: 0,0:10:21.48,0:10:23.71,*Default,NTP,0000,0000,0000,,Енді қар жаумауы керек
Dialogue: 0,0:10:24.52,0:10:27.21,*Default,NTP,0000,0000,0000,,Қалай болғанда да, қалған ингредиенттерді жинауым керек.
Dialogue: 0,0:10:27.32,0:10:28.91,*Default,NTP,0000,0000,0000,,Сыртқы нанонет және
Dialogue: 0,0:10:29.02,0:10:31.29,*Default,NTP,0000,0000,0000,,Менде әлі іске қосу қозғалтқышы жоқ.
Dialogue: 0,0:10:31.39,0:10:35.95,*Default,NTP,0000,0000,0000,,Ең бастысы - супер электр қозғалтқышы, сонымен бірге сізге керосин де керек болады...
Dialogue: 0,0:10:36.66,0:10:39.69,*Default,NTP,0000,0000,0000,,Мен ертеңнен бастап толық емес жұмыс күніммен айналыса алмауым мүмкін.
Dialogue: 0,0:10:39.90,0:10:42.99,*Default,NTP,0000,0000,0000,,Бірдеңе болады! Жазғы каникул да бар
Dialogue: 0,0:10:43.10,0:10:44.37,*Default,NTP,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:10:46.31,0:10:48.00,*Default,NTP,0000,0000,0000,,Сонымен, біз
Dialogue: 0,0:10:48.11,0:10:50.63,*Default,NTP,0000,0000,0000,,Цуэрашира деп аталатын бұл жазықтықта
Dialogue: 0,0:10:50.75,0:10:54.24,*Default,NTP,0000,0000,0000,,Мен шекараның арғы жағындағы мұнараға ұшып бармақ болдым.
Dialogue: 0,0:11:47.03,0:11:49.13,*Default,NTP,0000,0000,0000,,...Тағы да сол түс...
Dialogue: 0,0:12:03.38,0:12:04.54,*Default,NTP,0000,0000,0000,,Саватари?
Dialogue: 0,0:12:06.59,0:12:07.88,*Default,NTP,0000,0000,0000,,Такуя-кун
Dialogue: 0,0:12:24.94,0:12:26.17,*Default,NTP,0000,0000,0000,,Мм, м...
Dialogue: 0,0:12:26.27,0:12:27.37,*Default,NTP,0000,0000,0000,,Аа, кешіріңіз.
Dialogue: 0,0:12:27.48,0:12:28.67,*Default,NTP,0000,0000,0000,,Уууу… Уф!
Dialogue: 0,0:12:32.58,0:12:33.67,*Default,NTP,0000,0000,0000,,Хироки - Хироки
Dialogue: 0,0:12:33.78,0:12:34.91,*Default,NTP,0000,0000,0000,,Ах...
Dialogue: 0,0:12:38.29,0:12:39.78,*Default,NTP,0000,0000,0000,,Хе...
Dialogue: 0,0:12:39.89,0:12:42.69,*Default,NTP,0000,0000,0000,,...Екеуміз не туралы сөйлестік
Dialogue: 0,0:12:42.79,0:12:44.78,*Default,NTP,0000,0000,0000,,Көп болмады.
Dialogue: 0,0:12:45.29,0:12:46.78,*Default,NTP,0000,0000,0000,,Мүмкін...
Dialogue: 0,0:12:48.03,0:12:50.46,*Default,NTP,0000,0000,0000,,Эй, Такуя-кун, саған физика ұнай ма?
Dialogue: 0,0:12:50.56,0:12:54.56,*Default,NTP,0000,0000,0000,,Не? АаБұл кітап? ...Мені біраз қызықтырады.
Dialogue: 0,0:12:54.67,0:12:56.26,*Default,NTP,0000,0000,0000,,Бұл таңқаларлық
Dialogue: 0,0:12:56.37,0:12:59.90,*Default,NTP,0000,0000,0000,,Менің атам да физик болған.
Dialogue: 0,0:13:00.01,0:13:02.67,*Default,NTP,0000,0000,0000,,Иә? Бұл әлдеқайда таңқаларлық.
Dialogue: 0,0:13:02.78,0:13:05.41,*Default,NTP,0000,0000,0000,,Бірақ мен сені ешқашан кездестірмедім.
Dialogue: 0,0:13:05.61,0:13:06.94,*Default,NTP,0000,0000,0000,,Солтүстік-Оңтүстік бөлімі?
Dialogue: 0,0:13:07.05,0:13:07.95,*Default,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:13:08.05,0:13:09.24,*Default,NTP,0000,0000,0000,,Мен...
Dialogue: 0,0:13:12.75,0:13:16.38,*Default,NTP,0000,0000,0000,,Эй, Такуя-кун, сен әлі толық емес жұмыс күнімен жұмыс істейсің бе?
Dialogue: 0,0:13:16.49,0:13:17.55,*Default,NTP,0000,0000,0000,,Бұл көңілді ме?
Dialogue: 0,0:13:17.66,0:13:19.06,*Default,NTP,0000,0000,0000,,Мен таң қалдым ...
Dialogue: 0,0:13:19.16,0:13:23.46,*Default,NTP,0000,0000,0000,,Бұл қорқынышты қарттар басқаратын зауыт. Олар айғайлап, қатты қолданды.
Dialogue: 0,0:13:23.56,0:13:24.96,*Default,NTP,0000,0000,0000,,Бұл қорқынышты ма?
Dialogue: 0,0:13:25.07,0:13:26.33,*Default,NTP,0000,0000,0000,,Небута жынына ұқсайды
Dialogue: 0,0:13:26.43,0:13:27.66,*Default,NTP,0000,0000,0000,,Шынымен бе?
Dialogue: 0,0:13:27.77,0:13:28.89,*Default,NTP,0000,0000,0000,,Келесі жолы мені көруге келесің бе?
Dialogue: 0,0:13:29.00,0:13:29.97,*Default,NTP,0000,0000,0000,,Е...
Dialogue: 0,0:13:30.07,0:13:32.06,*Default,NTP,0000,0000,0000,,Бірақ бұл кедергі емес пе?
Dialogue: 0,0:13:32.17,0:13:34.57,*Default,NTP,0000,0000,0000,,Жоқ, мен Хирокидің де бақытты болатынына сенімдімін.
Dialogue: 0,0:13:34.68,0:13:36.23,*Default,NTP,0000,0000,0000,,Иә, жүр, жүр!
Dialogue: 0,0:13:36.34,0:13:38.50,Notes,NTP,0000,0000,0000,,Канита/Мимаяға бағытталған 2-платформа
Dialogue: 0,0:13:38.61,0:13:40.14,Notes,NTP,0000,0000,0000,,Пойыз келе жатыр.
Dialogue: 0,0:13:40.25,0:13:42.24,Notes,NTP,0000,0000,0000,,Ақ жолдың ішіне кері қадам жасаңыз
Dialogue: 0,0:13:42.35,0:13:43.54,Notes,NTP,0000,0000,0000,,Күте тұрыңыз
Dialogue: 0,0:13:45.02,0:13:47.08,*Default,NTP,0000,0000,0000,,...Эй, Такуя-кун
Dialogue: 0,0:13:48.29,0:13:51.32,*Default,NTP,0000,0000,0000,,Бұл күлкілі оқиға болуы мүмкін, бірақ күлмейсіз бе?
Dialogue: 0,0:13:51.43,0:13:53.83,*Default,NTP,0000,0000,0000,,Не? Мен күлмеймін
Dialogue: 0,0:13:53.93,0:13:55.99,*Default,NTP,0000,0000,0000,,Олай болса, сөйлесейік...
Dialogue: 0,0:14:13.01,0:14:13.74,*Default,NTP,0000,0000,0000,,Алып тасташы, өтінемін...?
Dialogue: 0,0:14:13.85,0:14:15.82,*Default,NTP,0000,0000,0000,,Рұқсатсыз не істеп жатырсың?
Dialogue: 0,0:14:15.92,0:14:19.91,*Default,NTP,0000,0000,0000,,Көмек болмас... Әңгіме осылай өрбіді.
Dialogue: 0,0:14:30.20,0:14:30.86,*Default,NTP,0000,0000,0000,,Кираны қуалау – кешірілмейтін әрекет; оны тіпті қылмыс деп те айтуға болады
Dialogue: 0,0:14:31.80,0:14:33.73,*Default,NTP,0000,0000,0000,,Мұнараға ұшуды да айту керек пе?
Dialogue: 0,0:14:33.87,0:14:35.84,*Default,NTP,0000,0000,0000,,Бұл жаман.
Dialogue: 0,0:14:36.57,0:14:40.30,*Default,NTP,0000,0000,0000,,Жарайды... Бірақ біреу сенен қайда барасың деп сұраса, не істеу керек?
Dialogue: 0,0:14:40.41,0:14:41.97,*Default,NTP,0000,0000,0000,,Хмм...
Dialogue: 0,0:14:43.81,0:14:45.04,*Default,NTP,0000,0000,0000,,Ум...
Dialogue: 0,0:14:46.11,0:14:46.77,*Default,NTP,0000,0000,0000,,Сәлем! ?
Dialogue: 0,0:14:48.75,0:14:50.41,*Default,NTP,0000,0000,0000,,…Хаха…
Dialogue: 0,0:14:50.52,0:14:51.78,*Default,NTP,0000,0000,0000,,…hehe…
Dialogue: 0,0:14:58.89,0:15:01.52,*Default,NTP,0000,0000,0000,,Сәлем.
Dialogue: 0,0:15:01.63,0:15:03.69,*Default,NTP,0000,0000,0000,,О, бүгін ыстық...
Dialogue: 0,0:15:03.80,0:15:05.29,*Default,NTP,0000,0000,0000,,Сәлеметсіз бе, мазалағаным үшін кешіріңіз.
Dialogue: 0,0:15:05.40,0:15:07.06,*Default,NTP,0000,0000,0000,,Я Сумимасен
Dialogue: 0,0:15:07.17,0:15:09.57,*Default,NTP,0000,0000,0000,,Е, иә, менің бакани халқым әрқашан
Dialogue: 0,0:15:09.67,0:15:11.64,*Default,NTP,0000,0000,0000,,Сіз маған қамқорлық жасап жатқан сияқтысыз...
Dialogue: 0,0:15:19.25,0:15:21.08,*Default,NTP,0000,0000,0000,,...Мыр. Окабе.
Dialogue: 0,0:15:21.32,0:15:22.48,*Default,NTP,0000,0000,0000,,Сіз бойдақсыз ба?
Dialogue: 0,0:15:22.88,0:15:25.48,*Default,NTP,0000,0000,0000,,Жоқ, ажырасқан деген қауесет естідім.
Dialogue: 0,0:15:25.99,0:15:28.92,*Default,NTP,0000,0000,0000,,Мен түсінгендеймін...
Dialogue: 0,0:15:34.03,0:15:37.79,*Default,NTP,0000,0000,0000,,Осындай жер болған! Хирои
Dialogue: 0,0:15:50.04,0:15:51.67,*Default,NTP,0000,0000,0000,,Тамаша!
Dialogue: 0,0:15:52.21,0:15:53.01,*Default,NTP,0000,0000,0000,,Ұшақ! ?
Dialogue: 0,0:15:53.21,0:15:54.04,*Default,NTP,0000,0000,0000,,Дұрыс...
Dialogue: 0,0:15:54.15,0:15:55.45,*Default,NTP,0000,0000,0000,,Я...
Dialogue: 0,0:15:55.78,0:15:58.15,*Default,NTP,0000,0000,0000,,Мұны екеуіңіз ғана жасап жатырсыз ба?
Dialogue: 0,0:15:58.25,0:16:01.62,*Default,NTP,0000,0000,0000,,Иә, мен мұны екінші курстың жазынан бастап біртіндеп жасап келемін.
Dialogue: 0,0:16:01.72,0:16:04.25,*Default,NTP,0000,0000,0000,,Зауытта толық емес жұмыс істеп жүріп бөлшектерді жинадым.
Dialogue: 0,0:16:04.36,0:16:06.38,*Default,NTP,0000,0000,0000,,Окабе мырзамен және басқалармен кеңесу кезінде.
Dialogue: 0,0:16:06.49,0:16:07.12,*Default,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:16:07.23,0:16:08.16,*Default,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:16:08.40,0:16:10.52,*Default,NTP,0000,0000,0000,,Бұл әлі аяқталмаған.
Dialogue: 0,0:16:10.63,0:16:12.39,*Default,NTP,0000,0000,0000,,...Бұл керемет...
Dialogue: 0,0:16:13.13,0:16:14.96,*Default,NTP,0000,0000,0000,,Өте керемет!
Dialogue: 0,0:16:16.74,0:16:19.26,*Default,NTP,0000,0000,0000,,...А, рахмет...
Dialogue: 0,0:16:43.83,0:16:44.66,*Default,NTP,0000,0000,0000,,…Сәлем
Dialogue: 0,0:16:44.77,0:16:47.29,*Default,NTP,0000,0000,0000,,Ұшақ Ол қашан аяқталады?
Dialogue: 0,0:16:47.60,0:16:51.13,*Default,NTP,0000,0000,0000,,Негізі мен оны жазғы демалыста бітіргім келеді.
Dialogue: 0,0:16:51.54,0:16:55.47,*Default,NTP,0000,0000,0000,,Бірақ бұл мүмкін емес шығар. Бұл көп уақытты алатын сияқты.
Dialogue: 0,0:16:55.91,0:16:58.14,*Default,NTP,0000,0000,0000,,Менің ойымша, мақсат жыл ішінде.
Dialogue: 0,0:16:58.48,0:16:59.67,*Default,NTP,0000,0000,0000,,Мен көремін...
Dialogue: 0,0:16:59.91,0:17:02.61,*Default,NTP,0000,0000,0000,,Әй, сен ол ұшақпен қаншаға барасың?
Dialogue: 0,0:17:04.62,0:17:06.61,*Default,NTP,0000,0000,0000,,Сол мұнараға барыңыз.
Dialogue: 0,0:17:09.09,0:17:09.85,*Default,NTP,0000,0000,0000,,Капитан Магатоға не деп тұрсың!!
Dialogue: 0,0:17:09.96,0:17:12.08,*Default,NTP,0000,0000,0000,,Мұнара одақ мұнарасы ма?
Dialogue: 0,0:17:15.23,0:17:16.09,*Default,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:17:16.20,0:17:18.96,*Default,NTP,0000,0000,0000,,Менің ойымша, мұнараға жету үшін шамамен 40 минут қажет.
Dialogue: 0,0:17:19.07,0:17:21.86,*Default,NTP,0000,0000,0000,,Мәселе шекарадан қалай өтуде.
Dialogue: 0,0:17:21.97,0:17:23.90,*Default,NTP,0000,0000,0000,,Бірақ бұл да идея.
Dialogue: 0,0:17:24.00,0:17:27.10,*Default,NTP,0000,0000,0000,,Керемет, ғажап, керемет, Хоккайдо! !
Dialogue: 0,0:17:28.38,0:17:30.00,*Default,NTP,0000,0000,0000,,...Саватари де кете ме?
Dialogue: 0,0:17:30.11,0:17:31.87,*Default,NTP,0000,0000,0000,,...Е...жақсы! ?
Dialogue: 0,0:17:32.11,0:17:33.08,*Default,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:17:33.25,0:17:36.01,*Default,NTP,0000,0000,0000,,Шынымен бе? Иә, барамынбарғым келеді!
Dialogue: 0,0:17:36.12,0:17:38.38,*Default,NTP,0000,0000,0000,,УауРахмет! !
Dialogue: 0,0:17:38.49,0:17:40.85,*Default,NTP,0000,0000,0000,,Бірақ мен шынымен ұша алатынымды білмеймін.
Dialogue: 0,0:17:40.95,0:17:42.85,*Default,NTP,0000,0000,0000,,ЖарайдыҰша алатыныңызға сенімдімін!
Dialogue: 0,0:17:42.96,0:17:43.89,*Default,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:17:44.06,0:17:46.05,*Default,NTP,0000,0000,0000,,Олай болса, уәде бер!
Dialogue: 0,0:17:46.23,0:17:47.19,*Default,NTP,0000,0000,0000,,О
Dialogue: 0,0:17:47.46,0:17:49.40,*Default,NTP,0000,0000,0000,,Содан кейін уәде беріңіз.
Dialogue: 0,0:17:49.50,0:17:50.49,*Default,NTP,0000,0000,0000,,Иә!
Dialogue: 0,0:17:57.70,0:18:00.57,*Default,NTP,0000,0000,0000,,Ол күндер өмір бойы осылай қалады.
Dialogue: 0,0:18:00.67,0:18:04.30,*Default,NTP,0000,0000,0000,,Бұл жер осыншама ұзаққа созылатындай болды.
Dialogue: 0,0:18:05.78,0:18:08.77,*Default,NTP,0000,0000,0000,,Мен аңсаған бұлттардың арғы жағындағы мұнара
Dialogue: 0,0:18:09.15,0:18:12.64,*Default,NTP,0000,0000,0000,,Бұл мен үшін маңызды кездесулер орны болды.
Dialogue: 0,0:18:13.65,0:18:15.12,*Default,NTP,0000,0000,0000,,Сол сәт
Dialogue: 0,0:18:15.69,0:18:19.65,*Default,NTP,0000,0000,0000,,Менің ойымша, бізде қорқатын ештеңе жоқ сияқты.
Dialogue: 0,0:18:21.93,0:18:24.56,*Default,NTP,0000,0000,0000,,Шындығында, дәл жақын жерде.
Dialogue: 0,0:18:24.87,0:18:27.36,*Default,NTP,0000,0000,0000,,Дүние мен тарих қозғалды, бірақ
Dialogue: 0,0:18:28.70,0:18:30.53,*Default,NTP,0000,0000,0000,,Бірақ сол кезде
Dialogue: 0,0:18:30.64,0:18:35.01,*Default,NTP,0000,0000,0000,,Пойыздағы түннің иісі, Достарыма сенім,
Dialogue: 0,0:18:35.11,0:18:38.14,*Default,NTP,0000,0000,0000,,Саюридің ауада қол бұлғап тұрғаны ғана
Dialogue: 0,0:18:38.25,0:18:40.84,*Default,NTP,0000,0000,0000,,Мен өзімді әлемдегі барлық нәрседей сезіндім.
Dialogue: 0,0:18:45.45,0:18:47.51,Notes,NTP,0000,0000,0000,,Кешегі түннен бүгін таң атқанға дейін
Dialogue: 0,0:18:47.62,0:18:51.92,Notes,NTP,0000,0000,0000,,Цугару бұғазы жағалауынан буферлік аймаққа дейін 42.15 жолға дейін
Dialogue: 0,0:18:52.03,0:18:53.42,Notes,NTP,0000,0000,0000,,АҚШ-тың жапондық және одақтық күштері
Dialogue: 0,0:18:53.53,0:18:55.62,Notes,NTP,0000,0000,0000,,Шағын қарулы қақтығыс орын алды
Dialogue: 0,0:18:56.33,0:18:57.76,Notes,NTP,0000,0000,0000,,Жауап ретінде елордалық полиция департаменті
Dialogue: 0,0:18:57.87,0:18:59.63,Notes,NTP,0000,0000,0000,,Ішкі Вильта азат ету майданы және т.б.
Dialogue: 0,0:18:59.73,0:19:00.79,Notes,NTP,0000,0000,0000,,Террористік ұйымдармен
Dialogue: 0,0:19:00.90,0:19:03.80,Notes,NTP,0000,0000,0000,,Одақ елшілігіне қарсы лаңкестік әрекеттердің алдын алу шарасы ретінде
Dialogue: 0,0:19:03.90,0:19:05.84,Notes,NTP,0000,0000,0000,,3300 қауіпсіздік қызметкері
Dialogue: 0,0:19:06.04,0:19:08.37,Notes,NTP,0000,0000,0000,,Токиода орналастырылатыны туралы хабарлады
Dialogue: 0,0:19:07.11,0:19:08.37,*Default,NTP,0000,0000,0000,,О
Dialogue: 0,0:19:11.55,0:19:14.04,*Default,NTP,0000,0000,0000,,Сіз керосинді пайдаланып жатырсыз.
Dialogue: 0,0:19:14.15,0:19:16.14,*Default,NTP,0000,0000,0000,,Егер сіз маған ақша төлесеңіз, мен оны сізге сатамын, бірақ ...
Dialogue: 0,0:19:16.78,0:19:19.25,*Default,NTP,0000,0000,0000,,Бірақ авиакеросин қымбат.
Dialogue: 0,0:19:20.15,0:19:21.49,*Default,NTP,0000,0000,0000,,Бұл шыншылдықпен жауап бере ме?
Dialogue: 0,0:19:21.59,0:19:24.06,*Default,NTP,0000,0000,0000,,Асқын өткізгіш қозғалтқышты қолдансақ ше?
Dialogue: 0,0:19:24.16,0:19:25.63,*Default,NTP,0000,0000,0000,,Хмм...
Dialogue: 0,0:19:27.09,0:19:28.56,*Default,NTP,0000,0000,0000,,Сіз көбірек білесіз бе?
Dialogue: 0,0:19:28.66,0:19:29.32,*Default,NTP,0000,0000,0000,,Жоғары
Dialogue: 0,0:19:29.43,0:19:30.90,*Default,NTP,0000,0000,0000,,Йорошику на
Dialogue: 0,0:19:43.61,0:19:47.67,*Default,NTP,0000,0000,0000,,Әй, олар неге реактивті қозғалтқышты жөнелтуде қиындық көрді?
Dialogue: 0,0:19:47.95,0:19:49.01,*Default,NTP,0000,0000,0000,,Өйткені бұл керемет!
Dialogue: 0,0:19:49.12,0:19:50.58,*Default,NTP,0000,0000,0000,,Барлығы осы ма?
Dialogue: 0,0:19:50.68,0:19:53.55,*Default,NTP,0000,0000,0000,,Біраз күтіңіз, басқа да көптеген себептер болды.
Dialogue: 0,0:19:53.65,0:19:55.68,*Default,NTP,0000,0000,0000,,Е, анау... а, болды
Dialogue: 0,0:19:55.99,0:19:57.35,*Default,NTP,0000,0000,0000,,Себебі мен оны алу үшін қиындық көрдім!
Dialogue: 0,0:19:57.46,0:19:58.69,*Default,NTP,0000,0000,0000,,Бұл дұрыс емес!
Dialogue: 0,0:19:58.96,0:20:01.52,*Default,NTP,0000,0000,0000,,Не? Ужас? Неліктен біз қос қозғалтқышты қолдандық?
Dialogue: 0,0:20:01.63,0:20:03.56,*Default,NTP,0000,0000,0000,,Жақсырақ себеп болды.
Dialogue: 0,0:20:03.66,0:20:05.22,*Default,NTP,0000,0000,0000,,Аа, солай.
Dialogue: 0,0:20:05.33,0:20:06.86,*Default,NTP,0000,0000,0000,,Өйткені мен оны түрлендіргім келеді
Dialogue: 0,0:20:07.03,0:20:08.63,*Default,NTP,0000,0000,0000,,Бұл дұрыс емес!
Dialogue: 0,0:20:09.80,0:20:11.63,*Default,NTP,0000,0000,0000,,...Бәрі жақсы, бірақ...
Dialogue: 0,0:20:12.14,0:20:15.63,*Default,NTP,0000,0000,0000,,Балалар, өлмеңдер... бұл азап.
Dialogue: 0,0:20:15.98,0:20:19.14,*Default,NTP,0000,0000,0000,,Ой, балалар, күнде жазғы демалыс басталған соң келіңдер.
Dialogue: 0,0:20:19.25,0:20:20.51,*Default,NTP,0000,0000,0000,,Біраз қорқынышты, иә?
Dialogue: 0,0:20:23.12,0:20:25.81,*Default,NTP,0000,0000,0000,,Эй, сіз шынымен ойнағыңыз келе ме?
Dialogue: 0,0:20:25.92,0:20:28.32,*Default,NTP,0000,0000,0000,,Иә, мен сабақтан кейін сонда барамын.
Dialogue: 0,0:20:30.76,0:20:33.82,*Default,NTP,0000,0000,0000,,Эй, мен онша жақсы емеспін.
Dialogue: 0,0:20:34.39,0:20:35.36,*Default,NTP,0000,0000,0000,,Жарайды
Dialogue: 0,0:20:35.46,0:20:37.66,*Default,NTP,0000,0000,0000,,Көз алдымда мұндайды көрген емеспін.
Dialogue: 0,0:20:37.76,0:20:38.92,*Default,NTP,0000,0000,0000,,Маған тыңдауға рұқсат етіңіз
Dialogue: 0,0:20:39.50,0:20:41.36,*Default,NTP,0000,0000,0000,,Менің де тыңдағым келеді
Dialogue: 0,0:20:41.60,0:20:44.70,*Default,NTP,0000,0000,0000,,Хмм...Мен қатты толқып тұрмын...
Dialogue: 0,0:21:47.53,0:21:50.23,*Default,NTP,0000,0000,0000,,Нанонеттер радарды көрсетпейді, солай ма?
Dialogue: 0,0:21:50.47,0:21:55.17,*Default,NTP,0000,0000,0000,,Бірақ ол буферлік аймақ арқылы ұшады...Нанонеттің сыртқы түрі қаншалықты болса да.
Dialogue: 0,0:21:55.78,0:21:59.18,*Default,NTP,0000,0000,0000,,Егер сіз нашар ұшсаңыз, сізді Одақтан бұрын АҚШ әскерилері табады.
Dialogue: 0,0:22:01.32,0:22:04.08,*Default,NTP,0000,0000,0000,,Өйткені, мүмкіндігінше төмен ұшудан басқа амалымыз жоқ...
Dialogue: 0,0:22:04.18,0:22:06.31,*Default,NTP,0000,0000,0000,,Толқындар мен рельефте адасқан
Dialogue: 0,0:22:06.42,0:22:09.32,*Default,NTP,0000,0000,0000,,Таңертең ерте шықсаң, таңғы тұманға тығыла аласың.
Dialogue: 0,0:22:09.52,0:22:11.35,*Default,NTP,0000,0000,0000,,Эзоның картасы бар ма?
Dialogue: 0,0:22:11.46,0:22:13.79,*Default,NTP,0000,0000,0000,,Бұл жалғыз, өйткені ол ең егжей-тегжейлі.
Dialogue: 0,0:22:13.89,0:22:15.95,*Default,NTP,0000,0000,0000,,Сіз ол жерге бармайынша нақты топографияны білмейсіз.
Dialogue: 0,0:22:16.06,0:22:18.26,*Default,NTP,0000,0000,0000,,Қонғаннан кейін биіктікке жетуден басқа амал жоқ.
Dialogue: 0,0:22:18.37,0:22:20.09,*Default,NTP,0000,0000,0000,,Бірақ біз қонғанша
Dialogue: 0,0:22:20.20,0:22:22.60,*Default,NTP,0000,0000,0000,,Менің ойымша, бұл Одақтың радарына түскен жоқ, солай ма?
Dialogue: 0,0:22:22.70,0:22:26.00,*Default,NTP,0000,0000,0000,,Верашира қайтаратын көлеңке кішкентай құстан кішірек болуы керек.
Dialogue: 0,0:22:26.11,0:22:29.01,*Default,NTP,0000,0000,0000,,Мүмкін менің жолым болмаса...
Dialogue: 0,0:24:00.70,0:24:01.76,*Default,NTP,0000,0000,0000,,Саватари!
Dialogue: 0,0:24:06.84,0:24:07.77,*Default,NTP,0000,0000,0000,,Күте тұрыңыз!
Dialogue: 0,0:24:13.11,0:24:16.11,*Default,NTP,0000,0000,0000,,Жарайды. Бұл соншалықты қымбат емес ...
Dialogue: 0,0:24:22.89,0:24:25.52,*Default,NTP,0000,0000,0000,,Бізбұрын...
Dialogue: 0,0:24:29.80,0:24:32.49,*Default,NTP,0000,0000,0000,,Мен мұны уақытында орындағаныма қуаныштымын…Қазір
Dialogue: 0,0:24:32.60,0:24:33.79,*Default,NTP,0000,0000,0000,,Уау!
Dialogue: 0,0:24:49.28,0:24:50.58,*Default,NTP,0000,0000,0000,,Жақсысың ба?
Dialogue: 0,0:24:51.32,0:24:52.41,*Default,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:24:52.52,0:24:53.61,*Default,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:24:53.72,0:24:54.98,*Default,NTP,0000,0000,0000,,Рахмет
Dialogue: 0,0:24:58.83,0:25:00.29,*Default,NTP,0000,0000,0000,,Хахахаха…
Dialogue: 0,0:25:00.39,0:25:01.99,*Default,NTP,0000,0000,0000,,Мен таң қалдым!
Dialogue: 0,0:25:02.43,0:25:03.73,*Default,NTP,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:25:03.83,0:25:04.46,*Default,NTP,0000,0000,0000,,Уау!
Dialogue: 0,0:25:04.56,0:25:05.59,*Default,NTP,0000,0000,0000,,Жарайсың, Хироки!
Dialogue: 0,0:25:05.70,0:25:08.29,*Default,NTP,0000,0000,0000,,ХахахаКешіріңізТвит
Dialogue: 0,0:25:08.40,0:25:09.80,*Default,NTP,0000,0000,0000,,Не! ?
Dialogue: 0,0:25:10.70,0:25:13.10,*Default,NTP,0000,0000,0000,,Сізге не керек!? ?
Dialogue: 0,0:25:13.44,0:25:15.17,*Default,NTP,0000,0000,0000,,Бұлай ашуланба
Dialogue: 0,0:25:15.28,0:25:18.73,*Default,NTP,0000,0000,0000,,Ашулан! Сіз қазірдің өзінде келе жатырсыз!
Dialogue: 0,0:25:18.85,0:25:20.44,*Default,NTP,0000,0000,0000,,БарайықСаватари
Dialogue: 0,0:25:20.71,0:25:22.05,*Default,NTP,0000,0000,0000,,Такуя...
Dialogue: 0,0:25:22.15,0:25:23.64,*Default,NTP,0000,0000,0000,,СаватариБірдеңе айт!
Dialogue: 0,0:25:23.75,0:25:26.28,*Default,NTP,0000,0000,0000,,Хехе...кешіріңізТакуя-кун
Dialogue: 0,0:25:26.39,0:25:28.32,*Default,NTP,0000,0000,0000,,Хироки - ақымақ
Dialogue: 0,0:25:28.42,0:25:29.68,*Default,NTP,0000,0000,0000,,Жарайды, кеттік.
Dialogue: 0,0:25:29.79,0:25:31.65,*Default,NTP,0000,0000,0000,,Эй, Такуя...
Dialogue: 0,0:25:44.34,0:25:45.57,*Default,NTP,0000,0000,0000,,Мен
Dialogue: 0,0:25:45.67,0:25:48.80,*Default,NTP,0000,0000,0000,,Мен бір сәт түс көрдім.
Dialogue: 0,0:25:49.54,0:25:51.81,*Default,NTP,0000,0000,0000,,Арман? Қандай арман?
Dialogue: 0,0:25:52.05,0:25:53.34,*Default,NTP,0000,0000,0000,,Хмм…
Dialogue: 0,0:25:53.45,0:25:58.32,*Default,NTP,0000,0000,0000,,Аа, ұмытып кетіппін, мүмкін бұл мұнараның арманы шығар.
Dialogue: 0,0:25:58.95,0:26:03.48,*Default,NTP,0000,0000,0000,,Көрініс өтірік сияқты Одақ керемет
Dialogue: 0,0:26:03.92,0:26:04.75,*Default,NTP,0000,0000,0000,,Мұнараның арғы жағында
Dialogue: 0,0:26:05.73,0:26:08.22,*Default,NTP,0000,0000,0000,,Басқа дүниелермен байланысқан сияқты.
Dialogue: 0,0:26:20.27,0:26:21.71,*Default,NTP,0000,0000,0000,,А...
Dialogue: 0,0:26:23.78,0:26:25.07,*Default,NTP,0000,0000,0000,,Күннің батуы
Dialogue: 0,0:26:26.08,0:26:28.34,*Default,NTP,0000,0000,0000,,Оңай батпайды...
Dialogue: 0,0:26:30.28,0:26:34.28,*Default,NTP,0000,0000,0000,,Бұл шынымен де ерекше жаз болды.
Dialogue: 0,0:26:34.99,0:26:40.95,*Default,NTP,0000,0000,0000,,Бірақ мені қоршап тұрған дүние бұдан былай маған қайта-қайта опасыздық жасайды.
Dialogue: 0,0:26:42.30,0:26:46.03,*Default,NTP,0000,0000,0000,,Содан бері үш жыл Бұл күн соңғы
Dialogue: 0,0:26:46.37,0:26:48.80,*Default,NTP,0000,0000,0000,,Мен Саватариді кездестірмедім.
Dialogue: 0,0:27:35.75,0:27:38.08,*Default,NTP,0000,0000,0000,,Тұтынушы келді, бірақ бұл туралы алаңдамаңыз.
Dialogue: 0,0:27:38.45,0:27:40.39,*Default,NTP,0000,0000,0000,,Бірінші кезең аяқталады. Келесі қадамға көшейік.
Dialogue: 0,0:27:40.49,0:27:41.42,*Default,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:27:42.12,0:27:43.59,*Default,NTP,0000,0000,0000,,Келесі фильтрация кезеңі
Dialogue: 0,0:27:43.76,0:27:45.52,*Default,NTP,0000,0000,0000,,Екінші кезең басталады
Dialogue: 0,0:27:45.63,0:27:49.08,*Default,NTP,0000,0000,0000,,Бағытты ажыратымдылық соңғы ретке қарағанда 25% жоғары
Dialogue: 0,0:27:49.30,0:27:51.86,*Default,NTP,0000,0000,0000,,Лайк Келесі жолы бара аламын ба деп ойлаймын
Dialogue: 0,0:27:51.97,0:27:53.90,*Default,NTP,0000,0000,0000,,АлгоритмАқылмен таңдаңыз
Dialogue: 0,0:27:54.00,0:27:55.02,*Default,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:27:55.64,0:27:57.13,*Default,NTP,0000,0000,0000,,Ширакава алгоритмі дегеніміз не?
Dialogue: 0,0:27:57.24,0:27:59.64,*Default,NTP,0000,0000,0000,,Өзгертілген топтық экстракция сүзгісі
Dialogue: 0,0:27:59.74,0:28:01.60,*Default,NTP,0000,0000,0000,,Эксун Цукиноенің қағазы негізінде
Dialogue: 0,0:28:01.71,0:28:03.11,*Default,NTP,0000,0000,0000,,Эксун Цукиное
Dialogue: 0,0:28:03.21,0:28:04.18,*Default,NTP,0000,0000,0000,,Одақ?
Dialogue: 0,0:28:04.28,0:28:05.04,*Default,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:28:05.15,0:28:06.67,*Default,NTP,0000,0000,0000,,Не? Осындай нәрсені қалай жасайсыз?
Dialogue: 0,0:28:06.78,0:28:09.11,*Default,NTP,0000,0000,0000,,Күте тұрыңызРеакция бірте-бірте күшейеді...
Dialogue: 0,0:28:09.48,0:28:10.64,*Default,NTP,0000,0000,0000,,Сіз кімсіз?
Dialogue: 0,0:28:10.75,0:28:14.71,*Default,NTP,0000,0000,0000,,Ол параллель дүниелердің бар екенін дәлелдеген бірінші одақ зерттеушісі болды.
Dialogue: 0,0:28:14.82,0:28:16.38,*Default,NTP,0000,0000,0000,,Ол мұнараның құрастырушысы деп айтылады.
Dialogue: 0,0:28:16.49,0:28:17.55,*Default,NTP,0000,0000,0000,,Түсірілді!
Dialogue: 0,0:28:17.66,0:28:21.09,*Default,NTP,0000,0000,0000,,XAYCZC бағытында экспозициялық жауапты растаңыз
Dialogue: 0,0:28:21.23,0:28:24.06,*Default,NTP,0000,0000,0000,,5, жоқ, 6 тармақталған ғалам бар!
Dialogue: 0,0:28:24.16,0:28:26.39,*Default,NTP,0000,0000,0000,,Алты! Синхрондау кезеңі басталады
Dialogue: 0,0:28:26.50,0:28:27.97,*Default,NTP,0000,0000,0000,,Менімен қосыл!
Dialogue: 0,0:28:28.10,0:28:30.19,*Default,NTP,0000,0000,0000,,Үшінші кезең басталады
Dialogue: 0,0:28:30.30,0:28:33.57,*Default,NTP,0000,0000,0000,,Ең жақын параллель ғаламға қосылуды бастаңыз
Dialogue: 0,0:28:33.67,0:28:34.64,*Default,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:28:40.68,0:28:41.84,*Default,NTP,0000,0000,0000,,…Тез!
Dialogue: 0,0:28:42.52,0:28:47.15,*Default,NTP,0000,0000,0000,,Ширакава-кунда ең жақын қосылатын аймаққа жету үшін 12 жаттығу қалды
Dialogue: 0,0:28:47.25,0:28:51.16,*Default,NTP,0000,0000,0000,,11 10 9.4 9.2…
Dialogue: 0,0:28:52.19,0:28:53.56,*Default,NTP,0000,0000,0000,,Қосылды!
Dialogue: 0,0:28:53.99,0:28:56.43,*Default,NTP,0000,0000,0000,,Бір жақын салалық ғаламға сәтті қосылды
Dialogue: 0,0:28:56.53,0:28:58.52,*Default,NTP,0000,0000,0000,,Экспозиция реакциясы  Тұрақты
Dialogue: 0,0:28:59.00,0:29:01.59,*Default,NTP,0000,0000,0000,,Жарайды, түрлендіру кезеңіне көшейік.
Dialogue: 0,0:29:02.17,0:29:03.10,*Default,NTP,0000,0000,0000,,Күш фазасы
Dialogue: 0,0:29:03.20,0:29:05.97,*Default,NTP,0000,0000,0000,,Параллель әлеммен кеңістікті ауыстыруБастау
Dialogue: 0,0:29:14.61,0:29:18.68,*Default,NTP,0000,0000,0000,,60 нано радиус кеңістігінде әртүрлі фазалық түрлендіруді растау! Жылдам кеңеюде
Dialogue: 0,0:29:18.79,0:29:21.08,*Default,NTP,0000,0000,0000,,Жақында жай көзге көрінетін болады
Dialogue: 0,0:29:45.61,0:29:46.37,*Default,NTP,0000,0000,0000,,Мүмкін емес
Dialogue: 0,0:29:47.05,0:29:47.88,*Default,NTP,0000,0000,0000,,Жоқ!
Dialogue: 0,0:29:48.15,0:29:49.45,*Default,NTP,0000,0000,0000,,Экспозиция реакциясының төмендеуі
Dialogue: 0,0:29:49.55,0:29:52.38,*Default,NTP,0000,0000,0000,,Параллель әлеммен байланысты бұдан былай жалғастыра алмайды!
Dialogue: 0,0:30:02.46,0:30:06.33,*Default,NTP,0000,0000,0000,,Толқындық функцияның жинақталуыДивергентті әлемТолық жоғалады
Dialogue: 0,0:30:06.43,0:30:09.99,*Default,NTP,0000,0000,0000,,Шамамен 1,3 мм радиусы бар фазадан тыс сәтті ауыстыру
Dialogue: 0,0:30:18.68,0:30:19.87,*Default,NTP,0000,0000,0000,,Еңбегіңіз үшін рахмет!
Dialogue: 0,0:30:19.98,0:30:20.91,*Default,NTP,0000,0000,0000,,Еңбегіңіз үшін рахмет!
Dialogue: 0,0:30:21.41,0:30:24.21,*Default,NTP,0000,0000,0000,,Томизава мырзамырза. ШиракаваБос жұмыс орындары бар ма?
Dialogue: 0,0:30:24.62,0:30:27.68,*Default,NTP,0000,0000,0000,,Мен боспын.Балалар сендерге не болды?Біз әрқашан біргеміз.
Dialogue: 0,0:30:27.79,0:30:29.85,*Default,NTP,0000,0000,0000,,Мұғалім үйренгенше соңынан еруімді өтінді.
Dialogue: 0,0:30:29.96,0:30:31.05,*Default,NTP,0000,0000,0000,,Мен мұны айтпадым ба?
Dialogue: 0,0:30:31.16,0:30:32.39,*Default,NTP,0000,0000,0000,,Солай ма?
Dialogue: 0,0:30:32.49,0:30:35.55,*Default,NTP,0000,0000,0000,,Ах, Маки-чан, мен ертеңнен бастап Токиоға іссапармен барамын.
Dialogue: 0,0:30:35.66,0:30:37.60,*Default,NTP,0000,0000,0000,,Бұл зерттеу есеп беру жиналысы болды, солай ма?
Dialogue: 0,0:30:37.70,0:30:41.33,*Default,NTP,0000,0000,0000,,Бұл бір нәрсе, бірақ кілт табылған сияқты.
Dialogue: 0,0:30:41.43,0:30:44.23,*Default,NTP,0000,0000,0000,,Кілт неде? Мұғалім мұны бұрын жасады ма?
Dialogue: 0,0:30:44.44,0:30:45.43,*Default,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:30:45.67,0:30:48.94,*Default,NTP,0000,0000,0000,,Сіздің ми туралы ғылым тобыңыз бос емес болуы мүмкін.
Dialogue: 0,0:30:49.04,0:30:49.94,*Default,NTP,0000,0000,0000,,Ах
Dialogue: 0,0:30:50.71,0:30:51.84,*Default,NTP,0000,0000,0000,,Маки-сан…
Dialogue: 0,0:31:00.15,0:31:02.55,*Default,NTP,0000,0000,0000,,...Солдат-санОл соңғы уақытта мұнда жиі келетін болды.
Dialogue: 0,0:31:02.86,0:31:05.22,*Default,NTP,0000,0000,0000,,Костюм NSA болуы мүмкін.
Dialogue: 0,0:31:05.33,0:31:06.59,*Default,NTP,0000,0000,0000,,NSA?
Dialogue: 0,0:31:06.69,0:31:08.18,*Default,NTP,0000,0000,0000,,Ұлттық қауіпсіздік агенттігі
Dialogue: 0,0:31:08.29,0:31:11.96,*Default,NTP,0000,0000,0000,,Хмм... соңғы кездері терроризм туралы қауесеттер көп.
Dialogue: 0,0:31:15.17,0:31:16.69,*Default,NTP,0000,0000,0000,,Бүгін  жақсы өтті ме?
Dialogue: 0,0:31:17.14,0:31:18.80,*Default,NTP,0000,0000,0000,,Әлі жоқ
Dialogue: 0,0:31:18.91,0:31:21.60,*Default,NTP,0000,0000,0000,,Ауыстыру жай көзге әрең көрінеді.
Dialogue: 0,0:31:21.71,0:31:23.94,*Default,NTP,0000,0000,0000,,Union Tower-ке жақындай да алмайды
Dialogue: 0,0:31:24.04,0:31:25.70,*Default,NTP,0000,0000,0000,,Бұған көмектесу мүмкін емес.
Dialogue: 0,0:31:25.81,0:31:29.37,*Default,NTP,0000,0000,0000,,Бұл негізгі физикадан әлдеқайда алда.
Dialogue: 0,0:31:29.72,0:31:32.71,*Default,NTP,0000,0000,0000,,Эзоның аэрофотосуретін мен де көрдім.
Dialogue: 0,0:31:37.36,0:31:38.52,*Default,NTP,0000,0000,0000,,Менің түсінбегенім
Dialogue: 0,0:31:38.63,0:31:41.72,*Default,NTP,0000,0000,0000,,Сондықтан әртүрлі фазалық түрлендіру мұнараның айналасында 2км жерде тоқтайды.
Dialogue: 0,0:31:42.80,0:31:45.96,*Default,NTP,0000,0000,0000,,Егер бұл шабуыл жасау үшін болса, мұның еш мәні жоқ...
Dialogue: 0,0:31:46.07,0:31:48.53,*Default,NTP,0000,0000,0000,,Қандай да бір апатқа байланысты функция тоқтады ма?
Dialogue: 0,0:31:48.64,0:31:51.70,*Default,NTP,0000,0000,0000,,Әлде бұл жай ғана эксперименттік қондырғы ма?
Dialogue: 0,0:31:51.97,0:31:53.44,*Default,NTP,0000,0000,0000,,Немесе әртүрлі фазалық түрлендірудің өзі
Dialogue: 0,0:31:53.54,0:31:56.53,*Default,NTP,0000,0000,0000,,Бұл дизайнер ойламаған қашық функция ма?
Dialogue: 0,0:31:57.18,0:31:58.23,*Default,NTP,0000,0000,0000,,Профессор Томизава
Dialogue: 0,0:31:58.41,0:32:00.14,*Default,NTP,0000,0000,0000,,Мұнараның функциялары басылып жатқан сияқты.
Dialogue: 0,0:32:00.25,0:32:02.98,*Default,NTP,0000,0000,0000,,Сіз сыртқы себеп болуы мүмкін деп жатырсыз.
Dialogue: 0,0:32:10.29,0:32:12.76,*Default,NTP,0000,0000,0000,,Эй, Ширакава-кун, сен ертең не істейсің?
Dialogue: 0,0:32:12.86,0:32:14.76,*Default,NTP,0000,0000,0000,,Орта мектеп те жабық, солай ма?
Dialogue: 0,0:32:15.26,0:32:17.09,*Default,NTP,0000,0000,0000,,Мен бір нәрсені білгім келеді...
Dialogue: 0,0:32:17.20,0:32:18.06,*Default,NTP,0000,0000,0000,,Кітапхана?
Dialogue: 0,0:32:18.16,0:32:20.66,*Default,NTP,0000,0000,0000,,Иә, мен бір танысымның зауытына бардым.
Dialogue: 0,0:32:20.77,0:32:24.07,*Default,NTP,0000,0000,0000,,Егер сіз оны көргіңіз келсе, біз туристік мекеме емеспіз.
Dialogue: 0,0:32:24.17,0:32:25.26,*Default,NTP,0000,0000,0000,,Не? Не?
Dialogue: 0,0:32:26.21,0:32:28.04,*Default,NTP,0000,0000,0000,,Қыз? Қанша бала?
Dialogue: 0,0:32:28.14,0:32:29.87,*Default,NTP,0000,0000,0000,,Мен білмеймін!
Dialogue: 0,0:32:30.58,0:32:33.14,*Default,NTP,0000,0000,0000,,Бірақ эй, ол әдемі адам, меніңше.
Dialogue: 0,0:32:33.25,0:32:36.01,*Default,NTP,0000,0000,0000,,А, мен күтемін.
Dialogue: 0,0:32:52.80,0:32:53.63,*Default,NTP,0000,0000,0000,,(От-шағал жәндігінің дыбысы)
Dialogue: 0,0:32:54.13,0:32:55.86,*Default,NTP,0000,0000,0000,,Бұл керемет антенна!
Dialogue: 0,0:32:55.97,0:32:57.37,*Default,NTP,0000,0000,0000,,Тағы бір… үкі ме?
Dialogue: 0,0:32:57.47,0:33:00.70,*Default,NTP,0000,0000,0000,,Сонымен қатар аздап заңсыздық бар.
Dialogue: 0,0:33:00.81,0:33:03.37,*Default,NTP,0000,0000,0000,,Бұл өте қызықты нәрселерге әкеледі.
Dialogue: 0,0:33:03.48,0:33:04.64,*Default,NTP,0000,0000,0000,,Иә...
Dialogue: 0,0:33:08.65,0:33:11.64,*Default,NTP,0000,0000,0000,,Сонымен, Маки-сан, сенің мамандығың миды зерттеу ме?
Dialogue: 0,0:33:11.82,0:33:14.65,*Default,NTP,0000,0000,0000,,Сәлем Жад, ұйқы, түс көру, т.б....
Dialogue: 0,0:33:15.42,0:33:18.05,*Default,NTP,0000,0000,0000,,Сіз Такуямен бір зертханадасыз, солай ма?
Dialogue: 0,0:33:18.16,0:33:20.46,*Default,NTP,0000,0000,0000,,Сіз мұнарада зерттеу жүргізіп жатқан жоқсыз ба?
Dialogue: 0,0:33:20.56,0:33:25.76,*Default,NTP,0000,0000,0000,,Иә, мұнараны зерттеп жатырмын...Не айтарымды білмеймін.
Dialogue: 0,0:33:25.87,0:33:28.16,*Default,NTP,0000,0000,0000,,Екеуі де параллель дүниелерді қарастыратын зерттеулер.
Dialogue: 0,0:33:28.53,0:33:30.00,*Default,NTP,0000,0000,0000,,Параллель дүние?
Dialogue: 0,0:33:30.80,0:33:33.50,*Default,NTP,0000,0000,0000,,Мм... түнде түс көрген адам сияқты.
Dialogue: 0,0:33:33.61,0:33:35.67,*Default,NTP,0000,0000,0000,,Бұл ғалам да түс көреді
Dialogue: 0,0:33:36.44,0:33:39.41,*Default,NTP,0000,0000,0000,,«Не болуы мүмкін» деген әртүрлі мүмкіндіктер
Dialogue: 0,0:33:39.51,0:33:41.81,*Default,NTP,0000,0000,0000,,Бұл дүние арманда жасырылған
Dialogue: 0,0:33:41.91,0:33:43.25,*Default,NTP,0000,0000,0000,,Біз
Dialogue: 0,0:33:43.35,0:33:46.38,*Default,NTP,0000,0000,0000,,Олар параллель дүниелер немесе тармақталған ғаламдар деп аталады.
Dialogue: 0,0:33:47.89,0:33:50.36,*Default,NTP,0000,0000,0000,,Менің зерттеуім параллель дүние
Dialogue: 0,0:33:50.46,0:33:53.76,*Default,NTP,0000,0000,0000,,Адамның миы мен арманына әсерін зерттеу
Dialogue: 0,0:33:54.16,0:33:55.49,*Default,NTP,0000,0000,0000,,Одақтағы мұнара да.
Dialogue: 0,0:33:55.60,0:33:58.59,*Default,NTP,0000,0000,0000,,Олар бір нәрсені бақылайды деген күшті теория бар.
Dialogue: 0,0:33:58.70,0:34:02.69,*Default,NTP,0000,0000,0000,,Технология параллель әлемдерді байқауға мүмкіндік бергенімен,
Dialogue: 0,0:34:02.84,0:34:05.74,*Default,NTP,0000,0000,0000,,Ежелден бері тірі заттардың миы бейсаналық
Dialogue: 0,0:34:05.84,0:34:08.20,*Default,NTP,0000,0000,0000,,Мүмкін мен байқағаным осы шығар.
Dialogue: 0,0:34:08.31,0:34:12.21,*Default,NTP,0000,0000,0000,,Мида кванттық деңгейде алға-артқа қозғалатын тармақталған ғалам туралы ақпарат
Dialogue: 0,0:34:12.31,0:34:13.14,*Default,NTP,0000,0000,0000,,Мүмкін
Dialogue: 0,0:34:13.25,0:34:16.88,*Default,NTP,0000,0000,0000,,Бұл адамның алдын ала ескертулері мен болжамдарының көзі болуы мүмкін.
Dialogue: 0,0:34:18.15,0:34:20.02,*Default,NTP,0000,0000,0000,,Мен осындай зерттеу жүргізіп жатырмын.
Dialogue: 0,0:34:20.55,0:34:22.11,*Default,NTP,0000,0000,0000,,...хех
Dialogue: 0,0:34:22.22,0:34:25.85,*Default,NTP,0000,0000,0000,,Ғаламның армандары романтикалық сияқты, солай емес пе?
Dialogue: 0,0:34:25.96,0:34:27.48,*Default,NTP,0000,0000,0000,,Романтикалық…
Dialogue: 0,0:34:27.59,0:34:28.39,*Default,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:34:28.49,0:34:29.96,*Default,NTP,0000,0000,0000,,Жоқ... шынымен емес...
Dialogue: 0,0:34:30.26,0:34:32.66,*Default,NTP,0000,0000,0000,,Бірақ Маки-сан таң қалдырады.
Dialogue: 0,0:34:32.77,0:34:35.76,*Default,NTP,0000,0000,0000,,Жас кезінде мемлекеттік консультативтік-кеңесші органның ғылыми қызметкері болу!
Dialogue: 0,0:34:35.97,0:34:39.77,*Default,NTP,0000,0000,0000,,Жоқ, олай емес... Бірақ мен мұнараны аңсадым.
Dialogue: 0,0:34:40.01,0:34:41.77,*Default,NTP,0000,0000,0000,,Бұл өте пайдалы.
Dialogue: 0,0:34:42.74,0:34:45.44,*Default,NTP,0000,0000,0000,,Мен де Шынында, мен оған сүйсіндім.
Dialogue: 0,0:34:45.55,0:34:48.78,*Default,NTP,0000,0000,0000,,Бірақ шынымен таңғажайып Ширакава!
Dialogue: 0,0:34:49.02,0:34:52.28,*Default,NTP,0000,0000,0000,,Ең жас сыртқы зерттеуші және ең ынталы!
Dialogue: 0,0:34:52.42,0:34:54.65,*Default,NTP,0000,0000,0000,,Мен сені әрқашан керемет деп ойлайтынмын
Dialogue: 0,0:34:54.75,0:34:56.28,*Default,NTP,0000,0000,0000,,Маған бұл ұнамайды
Dialogue: 0,0:34:56.69,0:34:58.12,*Default,NTP,0000,0000,0000,,Мен...мүлдем...
Dialogue: 0,0:35:04.23,0:35:06.29,*Default,NTP,0000,0000,0000,,IМен қазір тоқтатуым керек.
Dialogue: 0,0:35:06.70,0:35:07.46,*Default,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:35:07.57,0:35:10.37,*Default,NTP,0000,0000,0000,,Оның көбін өзім жеген сияқтымын.
Dialogue: 0,0:35:10.47,0:35:12.27,*Default,NTP,0000,0000,0000,,Иә...
Dialogue: 0,0:35:14.37,0:35:16.90,*Default,NTP,0000,0000,0000,,ТакуяСіз қалаға барасыз ба?
Dialogue: 0,0:35:17.01,0:35:19.07,*Default,NTP,0000,0000,0000,,Иә, Маки-санды жіберіңіз.
Dialogue: 0,0:35:19.18,0:35:20.48,*Default,NTP,0000,0000,0000,,Маған да мінуге рұқсат етіңізші.
Dialogue: 0,0:35:20.58,0:35:21.41,*Default,NTP,0000,0000,0000,,Е!
Dialogue: 0,0:35:21.51,0:35:22.04,*Default,NTP,0000,0000,0000,,Ол мені осы күйімде көрмесін деп, батыл болып көрінуге барынша тырысып жүрмін
Dialogue: 0,0:35:22.15,0:35:22.77,*Default,NTP,0000,0000,0000,,Е!
Dialogue: 0,0:35:35.76,0:35:37.75,*Default,NTP,0000,0000,0000,,Сіз мені вокзалға түсіре аласыз ба?
Dialogue: 0,0:35:37.86,0:35:39.56,*Default,NTP,0000,0000,0000,,Окабе мырзаҮйге бармайсыз ба?
Dialogue: 0,0:35:39.67,0:35:41.83,*Default,NTP,0000,0000,0000,,Мен ертеңнен бастап Токиода жұмыс істеймін.
Dialogue: 0,0:35:44.34,0:35:45.24,*Default,NTP,0000,0000,0000,,Окабе-сан
Dialogue: 0,0:35:45.34,0:35:46.43,*Default,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:35:47.34,0:35:49.64,*Default,NTP,0000,0000,0000,,Менің сұрағанымды ойладың ба?
Dialogue: 0,0:35:50.24,0:35:51.68,*Default,NTP,0000,0000,0000,,Солай ма! Онда саған ұнайды екен!
Dialogue: 0,0:35:51.78,0:35:53.40,*Default,NTP,0000,0000,0000,,Мен Вильта туралы айтып отырмын.
Dialogue: 0,0:35:53.68,0:35:56.15,*Default,NTP,0000,0000,0000,,Аа... сен де пысықсың.
Dialogue: 0,0:35:56.25,0:35:58.88,*Default,NTP,0000,0000,0000,,Оның орнына сіз зертханада көп жұмыс істеп жатқан сияқтысыз.
Dialogue: 0,0:35:58.99,0:36:00.75,*Default,NTP,0000,0000,0000,,Бұл пайдалырақ емес пе?
Dialogue: 0,0:36:00.85,0:36:02.51,*Default,NTP,0000,0000,0000,,Сондықтан...
Dialogue: 0,0:36:02.72,0:36:05.42,*Default,NTP,0000,0000,0000,,Мен мұны тез орындағым келеді.
Dialogue: 0,0:36:05.53,0:36:06.75,*Default,NTP,0000,0000,0000,,Бұл мұнара туралы не деуге болады?
Dialogue: 0,0:36:11.80,0:36:13.23,*Default,NTP,0000,0000,0000,,Шынын айтсам, мен әлі де «Арнайы сынып» дегеннің не екенін түсінбеймін.
Dialogue: 0,0:36:13.53,0:36:14.59,*Default,NTP,0000,0000,0000,,Ах…Жоқ.
Dialogue: 0,0:36:14.70,0:36:17.64,*Default,NTP,0000,0000,0000,,Мен бұл мұнараны Токиодан көремін деп ешқашан ойламаппын.
Dialogue: 0,0:36:17.74,0:36:22.73,*Default,NTP,0000,0000,0000,,Әй, кейде сондай күндер болады. Бүгін ауа таза.
Dialogue: 0,0:36:22.84,0:36:24.07,*Default,NTP,0000,0000,0000,,... Міне.
Dialogue: 0,0:36:29.65,0:36:32.85,*Default,NTP,0000,0000,0000,,Сіз ауруханаға келгеннен бері осылай болды.
Dialogue: 0,0:36:33.12,0:36:36.28,*Default,NTP,0000,0000,0000,,Кіші орта мектептің 3-ші курсының жазында басталуы Себебі белгісіз
Dialogue: 0,0:36:36.39,0:36:38.45,*Default,NTP,0000,0000,0000,,Ұйқы уақыты біртіндеп артады
Dialogue: 0,0:36:38.56,0:36:41.72,*Default,NTP,0000,0000,0000,,Белгілі бір уақыт ішінде сергек күйді сақтай білу
Dialogue: 0,0:36:41.83,0:36:43.99,*Default,NTP,0000,0000,0000,,Тек алғашқы 2 ай
Dialogue: 0,0:36:44.10,0:36:47.36,*Default,NTP,0000,0000,0000,,Мен соңғы үш жыл бойы ұйықтадым...
Dialogue: 0,0:36:47.57,0:36:50.09,*Default,NTP,0000,0000,0000,,Сонда сіз армандай бересіз бе?
Dialogue: 0,0:36:50.20,0:36:52.14,*Default,NTP,0000,0000,0000,,Мұндай ми толқындары тіркелген.
Dialogue: 0,0:36:52.24,0:36:54.40,*Default,NTP,0000,0000,0000,,Хмм...ДНҚ сынағы ше?
Dialogue: 0,0:36:54.51,0:36:56.00,*Default,NTP,0000,0000,0000,,Бұл 6-шы.
Dialogue: 0,0:36:57.81,0:37:01.58,*Default,NTP,0000,0000,0000,,…Мен түсінемін.…Бұл екіге бөлінген қан.
Dialogue: 0,0:37:01.68,0:37:02.88,*Default,NTP,0000,0000,0000,,Неге тағы ұйықтап қалмақсың!
Dialogue: 0,0:37:03.08,0:37:06.21,*Default,NTP,0000,0000,0000,,Денсаулық сақтау, еңбек және әл-ауқат министрлігінің сауалнамасы.
Dialogue: 0,0:37:06.32,0:37:09.95,*Default,NTP,0000,0000,0000,,Аудару күні анықталғаннан кейін сіз ресми құжаттарды аласыз.
Dialogue: 0,0:37:10.52,0:37:11.89,*Default,NTP,0000,0000,0000,,Бұл хат ше?
Dialogue: 0,0:37:12.09,0:37:15.06,*Default,NTP,0000,0000,0000,,Науқастың қабылдау кезінде жазғаны осы сияқты.
Dialogue: 0,0:37:16.20,0:37:17.13,*Default,NTP,0000,0000,0000,,Сіз оны оқыдыңыз ба?
Dialogue: 0,0:37:17.23,0:37:18.20,*Default,NTP,0000,0000,0000,,Е
Dialogue: 0,0:37:19.17,0:37:21.13,*Default,NTP,0000,0000,0000,,Эмиши Сейсакушо?
Dialogue: 0,0:37:43.96,0:37:45.98,*Default,NTP,0000,0000,0000,,Осылайша ол жол бойына таралады.
Dialogue: 0,0:37:46.09,0:37:48.42,*Default,NTP,0000,0000,0000,,Көп ғаламдағы қиғаштықты анықтау арқылы
Dialogue: 0,0:37:48.66,0:37:51.79,*Default,NTP,0000,0000,0000,,Жоғары дәлдікпен болашақ болжамдарды қосады
Dialogue: 0,0:37:51.90,0:37:54.83,*Default,NTP,0000,0000,0000,,Бұл да менің зертханамның түпкі мақсаты.
Dialogue: 0,0:37:54.93,0:37:57.99,*Default,NTP,0000,0000,0000,,Бұл дәстүрлі теориялық модель немесе ықтималдық теориясы емес.
Dialogue: 0,0:37:58.10,0:38:01.90,*Default,NTP,0000,0000,0000,,Бұл нақты болашақ нәтижелерге негізделген ақпарат.
Dialogue: 0,0:38:02.01,0:38:05.27,*Default,NTP,0000,0000,0000,,Бұл саяси және әскери шешімдер қабылдауға қандай әсер етеді?
Dialogue: 0,0:38:05.38,0:38:06.94,*Default,NTP,0000,0000,0000,,Бұл түсініксіз болар еді.
Dialogue: 0,0:38:07.15,0:38:08.84,*Default,NTP,0000,0000,0000,,Шынымды айтсам
Dialogue: 0,0:38:08.95,0:38:12.35,*Default,NTP,0000,0000,0000,,Екінші жағынан, кванттық гравитация теориясын Одақ жағында қолдану технологиясы болып табылады
Dialogue: 0,0:38:12.45,0:38:15.55,*Default,NTP,0000,0000,0000,,Олар бізден теңдессіз жоғары деңгейге жетті.
Dialogue: 0,0:38:15.66,0:38:16.95,*Default,NTP,0000,0000,0000,,Ойлануым керек
Dialogue: 0,0:38:17.32,0:38:20.69,*Default,NTP,0000,0000,0000,,Эзодағы символдық мұнараның құрылысы басталды.
Dialogue: 0,0:38:20.79,0:38:23.28,*Default,NTP,0000,0000,0000,,Солтүстік пен Оңтүстік бөлінгеннен кейін бірден 74 жыл
Dialogue: 0,0:38:23.40,0:38:27.36,*Default,NTP,0000,0000,0000,,Операция шамамен 1996 жылы басталған деп есептеледі.
Dialogue: 0,0:38:27.47,0:38:30.23,*Default,NTP,0000,0000,0000,,Жобалауда орталық рөл атқарғаны айтылады.
Dialogue: 0,0:38:30.34,0:38:31.74,*Default,NTP,0000,0000,0000,,Эксун Цукиное
Dialogue: 0,0:38:31.84,0:38:33.83,*Default,NTP,0000,0000,0000,,Бастапқыда Хонсюдан
Dialogue: 0,0:38:33.94,0:38:37.31,*Default,NTP,0000,0000,0000,,Коалиция жағында біз үшін ирониялық.
Dialogue: 0,0:38:40.65,0:38:41.74,*Default,NTP,0000,0000,0000,,♪ Ка-та-на
Dialogue: 0,0:38:41.85,0:38:45.15,*Default,NTP,0000,0000,0000,,Әрі қарай, параллель әлемдер туралы ақпаратты нақты анықтау.
Dialogue: 0,0:38:45.25,0:38:48.65,*Default,NTP,0000,0000,0000,,Кейбір жаңа технологиялық әрекеттерді сипаттайды…
Dialogue: 0,0:38:51.19,0:38:53.52,*Default,NTP,0000,0000,0000,,Мінезі нашар біреу бар деп ойладым.
Dialogue: 0,0:38:53.63,0:38:57.39,*Default,NTP,0000,0000,0000,,Мен сенің айтқаныңды естідім. Негізінде, солай.
Dialogue: 0,0:38:57.50,0:39:02.30,*Default,NTP,0000,0000,0000,,Сіз Ками-саманың көрген армандарына үңіліп, оларға баға бергіңіз келеді.
Dialogue: 0,0:39:02.40,0:39:05.84,*Default,NTP,0000,0000,0000,,Бұл өте дұрыс. Бұл не? Ока-чан? Сізге қызық па?
Dialogue: 0,0:39:05.94,0:39:07.96,*Default,NTP,0000,0000,0000,,Мен аздап дайындалдым.
Dialogue: 0,0:39:08.07,0:39:10.51,*Default,NTP,0000,0000,0000,,Бүгін түн қалай? Мен сені соңғы рет көргеніме көп уақыт болды ма?
Dialogue: 0,0:39:14.68,0:39:18.08,*Default,NTP,0000,0000,0000,,Ширакава-кун өте жақсыОның жақсы қасиеттері бар.
Dialogue: 0,0:39:18.18,0:39:19.91,*Default,NTP,0000,0000,0000,,Маған қоңырау шалсаңыз жақсы болар еді.
Dialogue: 0,0:39:20.02,0:39:21.78,*Default,NTP,0000,0000,0000,,Иә, бірақ Ока-чан
Dialogue: 0,0:39:21.89,0:39:24.25,*Default,NTP,0000,0000,0000,,Оқушыларды ретке келтіруді қашан бастадыңыз?
Dialogue: 0,0:39:24.36,0:39:25.32,*Default,NTP,0000,0000,0000,,Жоқ…
Dialogue: 0,0:39:25.52,0:39:28.12,*Default,NTP,0000,0000,0000,,Ол жігіттер кішкене... ерекше.
Dialogue: 0,0:39:28.36,0:39:29.26,*Default,NTP,0000,0000,0000,,Мына жігіттер?
Dialogue: 0,0:39:29.36,0:39:30.02,*Default,NTP,0000,0000,0000,,О
Dialogue: 0,0:39:30.13,0:39:33.26,*Default,NTP,0000,0000,0000,,Мені Токиоға кім келеді деп уайымдайтын тағы бір адам бар.
Dialogue: 0,0:39:33.37,0:39:38.60,*Default,NTP,0000,0000,0000,,Мен түсінбей тұрған сияқтымын...Екеуі бірге ұшақ жасап жатыр екен.
Dialogue: 0,0:39:38.70,0:39:40.70,*Default,NTP,0000,0000,0000,,Бұл ностальгиялық...
Dialogue: 0,0:39:40.81,0:39:45.04,*Default,NTP,0000,0000,0000,,Бұл не? Токиоға сол үшін келдің бе? Мен бұл басқа нәрсе деп ойладым.
Dialogue: 0,0:39:45.14,0:39:46.98,*Default,NTP,0000,0000,0000,,Сіз не ойладыңыз?
Dialogue: 0,0:39:47.35,0:39:48.90,*Default,NTP,0000,0000,0000,,Уилк ісі
Dialogue: 0,0:39:49.45,0:39:52.47,*Default,NTP,0000,0000,0000,,Шын мәнінде, бұл дұрыс. Бұл басты мәселе.
Dialogue: 0,0:39:52.62,0:39:55.75,*Default,NTP,0000,0000,0000,,PL снаряд бомбалары енді қол жетімді
Dialogue: 0,0:39:55.86,0:39:57.65,*Default,NTP,0000,0000,0000,,Оны қалай алуға болатынын сұрамаңыз
Dialogue: 0,0:39:57.76,0:40:00.09,*Default,NTP,0000,0000,0000,,Сұрамай-ақ түсінуге болады.
Dialogue: 0,0:40:00.19,0:40:01.42,*Default,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:40:01.69,0:40:04.32,*Default,NTP,0000,0000,0000,,...Қызық, мұнараға қарсы жұмыс істей ме?
Dialogue: 0,0:40:04.60,0:40:05.89,*Default,NTP,0000,0000,0000,,…Дұрыс
Dialogue: 0,0:40:06.97,0:40:08.59,*Default,NTP,0000,0000,0000,,Бұл тиімді емес пе?
Dialogue: 0,0:40:08.70,0:40:11.64,*Default,NTP,0000,0000,0000,,Мұнараның сырты әп-сәтте буланып кетеді...
Dialogue: 0,0:40:11.74,0:40:13.50,*Default,NTP,0000,0000,0000,,Ішінде нанонеттердің үлкен лентасы бар.
Dialogue: 0,0:40:13.61,0:40:15.51,*Default,NTP,0000,0000,0000,,Ол конфигурацияланған сияқты
Dialogue: 0,0:40:15.61,0:40:18.10,*Default,NTP,0000,0000,0000,,Бұл да жанып кетуі мүмкін...
Dialogue: 0,0:40:18.68,0:40:22.67,*Default,NTP,0000,0000,0000,,Бұл дұрыс. PL қабықшалары ең жақсы таңдау болуы мүмкін.
Dialogue: 0,0:40:22.78,0:40:24.01,*Default,NTP,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:40:27.22,0:40:28.02,*Default,NTP,0000,0000,0000,,Бірақ
Dialogue: 0,0:40:28.52,0:40:31.65,*Default,NTP,0000,0000,0000,,Вильтаның әрекеті соғыс мүмкіндігін арттырады.
Dialogue: 0,0:40:31.76,0:40:33.12,*Default,NTP,0000,0000,0000,,Тоқтауым керек пе?
Dialogue: 0,0:40:33.23,0:40:34.45,*Default,NTP,0000,0000,0000,,Сондықтан біз мұны істейміз
Dialogue: 0,0:40:34.56,0:40:36.08,*Default,NTP,0000,0000,0000,,Бұл шешім ме?
Dialogue: 0,0:40:36.20,0:40:37.53,*Default,NTP,0000,0000,0000,,Шамамен
Dialogue: 0,0:40:38.30,0:40:42.89,*Default,NTP,0000,0000,0000,,Соғыс бастағысы келетін елайлар көп.
Dialogue: 0,0:40:43.07,0:40:46.16,*Default,NTP,0000,0000,0000,,Сіздің идеалыңыз Солтүстік пен Оңтүстікті біріктіру емес пе еді?
Dialogue: 0,0:40:46.27,0:40:48.24,*Default,NTP,0000,0000,0000,,Бүгін де солай.
Dialogue: 0,0:40:48.34,0:40:51.10,*Default,NTP,0000,0000,0000,,Мен мұны босқа кеткендей сезінемін...
Dialogue: 0,0:40:51.31,0:40:53.28,*Default,NTP,0000,0000,0000,,Коалиция тарапынан бұл сенбейтін сияқты.
Dialogue: 0,0:40:53.38,0:40:55.24,*Default,NTP,0000,0000,0000,,Бұл технологияның шедеврі.
Dialogue: 0,0:40:55.45,0:40:59.32,*Default,NTP,0000,0000,0000,,Қалай болғанда да, ол сол жерде тұрып, нақты әсер етпейді.
Dialogue: 0,0:40:59.42,0:41:03.08,*Default,NTP,0000,0000,0000,,ЖасырмаңызОл қазір тоқтап қалған сияқты
Dialogue: 0,0:41:03.19,0:41:04.95,*Default,NTP,0000,0000,0000,,Мұнара қоршаған кеңістікті сыртқа айналдырады.
Dialogue: 0,0:41:05.06,0:41:07.96,*Default,NTP,0000,0000,0000,,Күшті қару болуы мүмкін
Dialogue: 0,0:41:08.06,0:41:09.22,*Default,NTP,0000,0000,0000,,Сіз білесіз бе?
Dialogue: 0,0:41:09.33,0:41:10.26,*Default,NTP,0000,0000,0000,,О
Dialogue: 0,0:41:10.36,0:41:13.56,*Default,NTP,0000,0000,0000,,Маған бұл көрініс ұнайды, бірақ...
Dialogue: 0,0:41:13.70,0:41:15.89,*Default,NTP,0000,0000,0000,,Кейде осындай романтик жігіт
Dialogue: 0,0:41:16.00,0:41:17.56,*Default,NTP,0000,0000,0000,,Міне, сіз.
Dialogue: 0,0:41:19.97,0:41:22.77,*Default,NTP,0000,0000,0000,,...Ока-чан, мен де сенен бірдеңе сұрасам болады ма?
Dialogue: 0,0:41:22.88,0:41:23.71,*Default,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:41:23.81,0:41:27.51,*Default,NTP,0000,0000,0000,,Біраз бұрын сол мұнараның сырымен байланысқан адам
Dialogue: 0,0:41:27.61,0:41:28.67,*Default,NTP,0000,0000,0000,,Оны таптым
Dialogue: 0,0:41:28.78,0:41:29.98,*Default,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:41:30.08,0:41:32.07,*Default,NTP,0000,0000,0000,,Ол әлі жасөспірім қыз.
Dialogue: 0,0:41:32.18,0:41:34.28,*Default,NTP,0000,0000,0000,,А... солай ма?
Dialogue: 0,0:41:36.12,0:41:38.52,*Default,NTP,0000,0000,0000,,...Ока-чан танитын қыз емес пе?
Dialogue: 0,0:41:42.70,0:41:44.60,*Default,NTP,0000,0000,0000,,Мен табанды болуым мүмкін, бірақ
Dialogue: 0,0:41:44.83,0:41:46.73,*Default,NTP,0000,0000,0000,,Ол туралыМен түсінікті болғаншаШиракава-кун
Dialogue: 0,0:41:46.83,0:41:48.82,*Default,NTP,0000,0000,0000,,Құпия болғаны дұрыс
Dialogue: 0,0:41:49.10,0:41:51.87,*Default,NTP,0000,0000,0000,,Әсіресе жақсы дос болсаңыз
Dialogue: 0,0:41:52.14,0:41:53.83,*Default,NTP,0000,0000,0000,,Сіз мұны ақырында білесіз
Dialogue: 0,0:41:53.94,0:41:57.43,*Default,NTP,0000,0000,0000,,Солай болса да, қазір бұл туралы алаңдаудың қажеті жоқ.
Dialogue: 0,0:41:57.54,0:42:01.60,*Default,NTP,0000,0000,0000,,Бұл қазірдің өзінде Қауіпсіздік бюросының құзырында, сондықтан оны жұмыстан шығармағаныңыз жөн.
Dialogue: 0,0:42:03.65,0:42:06.88,*Default,NTP,0000,0000,0000,,Бұл ғаламда қандай армандар бар?
Dialogue: 0,0:42:07.05,0:42:09.58,*Default,NTP,0000,0000,0000,,Мен мұны да көргім келеді деп ойлаймын.
Dialogue: 0,0:42:16.00,0:42:20.13,*Default,NTP,0000,0000,0000,,Ғарышта алыстан келген сияқты.
Dialogue: 0,0:42:20.23,0:42:23.03,*Default,NTP,0000,0000,0000,,Салқын қатты жел соғып тұр
Dialogue: 0,0:42:23.14,0:42:26.57,*Default,NTP,0000,0000,0000,,Ауадан басқа ғаламның иісі аңқып тұрды.
Dialogue: 0,0:43:19.83,0:43:24.39,*Default,NTP,0000,0000,0000,,…Аспан, бұлттар және құлаған қала
Dialogue: 0,0:43:25.33,0:43:28.70,*Default,NTP,0000,0000,0000,,Қанша жүрсем де ешкім жоқ
Dialogue: 0,0:43:31.17,0:43:32.54,*Default,NTP,0000,0000,0000,,Суық...
Dialogue: 0,0:43:34.74,0:43:38.20,*Default,NTP,0000,0000,0000,,Мен мұнда не үшін келдім?
Dialogue: 0,0:43:38.71,0:43:39.77,*Default,NTP,0000,0000,0000,,Мен ондай адамды білмеймін.
Dialogue: 0,0:43:39.88,0:43:41.04,*Default,NTP,0000,0000,0000,,СәлемБіреу...
Dialogue: 0,0:43:42.82,0:43:44.54,*Default,NTP,0000,0000,0000,,Хироки-кун...
Dialogue: 0,0:43:58.96,0:44:01.36,*Default,NTP,0000,0000,0000,,Бұл тағы да сол арман.
Dialogue: 0,0:44:08.24,0:44:12.27,*Default,NTP,0000,0000,0000,,Соңында біз Верацилланы ұшпадық.
Dialogue: 0,0:44:15.01,0:44:16.00,*Default,NTP,0000,0000,0000,,3 жыл бұрын
Dialogue: 0,0:44:16.35,0:44:18.32,*Default,NTP,0000,0000,0000,,Саюри бізге ештеңе айтпайды.
Dialogue: 0,0:44:18.42,0:44:21.78,*Default,NTP,0000,0000,0000,,Оның жоғалып кеткенін көргенде қатты таң қалдым.
Dialogue: 0,0:44:21.99,0:44:26.05,*Default,NTP,0000,0000,0000,,Осыған байланысты біз де ұшақ жасауды тоқтаттық.
Dialogue: 0,0:44:26.23,0:44:29.02,*Default,NTP,0000,0000,0000,,Менің ойымша, біз ренжіп қалдық.
Dialogue: 0,0:44:29.56,0:44:34.36,*Default,NTP,0000,0000,0000,,Сенгакуды бітіргеннен кейін Такуя Аомори префектурасындағы Такахашиде оқуын жалғастырды.
Dialogue: 0,0:44:34.47,0:44:36.80,*Default,NTP,0000,0000,0000,,Мен Токиодағы орта мектепте оқыдым.
Dialogue: 0,0:44:37.40,0:44:40.53,*Default,NTP,0000,0000,0000,,Токиоға жеткенде одақ мұнарасын көре алмайсыз.
Dialogue: 0,0:44:40.64,0:44:41.80,*Default,NTP,0000,0000,0000,,Себебі мен ойладым
Dialogue: 0,0:44:42.81,0:44:45.28,*Default,NTP,0000,0000,0000,,Бірақ бұл көңілді қалдырды.
Dialogue: 0,0:44:45.74,0:44:50.55,*Default,NTP,0000,0000,0000,,Кейде, ауа-райы жақсы болған кезде, мұнара Токиодан әлсіз көрінетін.
Dialogue: 0,0:44:51.55,0:44:56.58,*Default,NTP,0000,0000,0000,,Сол күні мені қара сезім биледі.
Dialogue: 0,0:45:02.59,0:45:06.12,*Default,NTP,0000,0000,0000,,Бұл танк Фудзисава-кунның туған қаласына барады, солай ма?
Dialogue: 0,0:45:06.23,0:45:07.22,*Default,NTP,0000,0000,0000,,Ах, дұрыс.
Dialogue: 0,0:45:07.33,0:45:08.46,*Default,NTP,0000,0000,0000,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:45:08.57,0:45:11.54,*Default,NTP,0000,0000,0000,,Осындай нәрсеге баяу секіруге болады деп ойламайсыз ба?
Dialogue: 0,0:45:11.64,0:45:14.23,*Default,NTP,0000,0000,0000,,Аомориге бірге барамыз ба?
Dialogue: 0,0:45:38.16,0:45:43.36,*Default,NTP,0000,0000,0000,,Уақыт және Маған Окабе мырзадан соңғы жағдай туралы хабарлаған хат келді.
Dialogue: 0,0:45:43.67,0:45:46.57,*Default,NTP,0000,0000,0000,,Мен ешқашан жауап жіберген жоқпын.
Dialogue: 0,0:45:55.85,0:45:59.48,*Default,NTP,0000,0000,0000,,Мен бөлмеме келген сайын есікті жабамын
Dialogue: 0,0:45:59.75,0:46:03.69,*Default,NTP,0000,0000,0000,,Денеңіздегі сүйектер теріні жарып жатқандай.
Dialogue: 0,0:46:03.79,0:46:06.35,*Default,NTP,0000,0000,0000,,Қатты эмоционалды ауырсынуды сезіну
Dialogue: 0,0:46:07.16,0:46:08.35,*Default,NTP,0000,0000,0000,,Юкине, сонда ісіңді бітірген соң дүкенге қара.
Dialogue: 0,0:46:08.83,0:46:11.92,*Default,NTP,0000,0000,0000,,Менің ұстанғаным осы шығар.
Dialogue: 0,0:46:15.27,0:46:19.03,Notes,NTP,0000,0000,0000,,Келесі - шиеленіскен халықаралық қатынастар туралы жаңалықтар.
Dialogue: 0,0:46:19.24,0:46:22.37,Notes,NTP,0000,0000,0000,,19-да өткен Біріккен Ұлттар Ұйымының Қауіпсіздік Кеңесінде
Dialogue: 0,0:46:22.47,0:46:25.93,Notes,NTP,0000,0000,0000,,Америка Құрама Штаттары Одаққа Эзодағы мұнара нысанына кіруге рұқсат берді.
Dialogue: 0,0:46:26.04,0:46:29.07,Notes,NTP,0000,0000,0000,,Біз тағы да БҰҰ-ның инспекциялық тобын қабылдауды сұрадық.
Dialogue: 0,0:46:29.17,0:46:31.32,Notes,NTP,0000,0000,0000,,Бұған қарағанда Одақ үкіметі
Dialogue: 0,0:46:31.42,0:46:33.64,Notes,NTP,0000,0000,0000,,Біз өзіміздің батыл бас тарту ұстанымын тағы бір рет көрсеттік...
Dialogue: 0,0:46:29.17,0:46:32.55,*Default,NTP,0000,0000,0000,,Жалғыз өмір сүрген түндер ұзақ болды.
Dialogue: 0,0:46:33.75,0:46:36.22,*Default,NTP,0000,0000,0000,,Уақытты дұрыс басқара алмаған кезде
Dialogue: 0,0:46:36.32,0:46:38.79,*Default,NTP,0000,0000,0000,,Мен жақын маңдағы станцияға жаяу бардым.
Dialogue: 0,0:46:38.96,0:46:42.79,*Default,NTP,0000,0000,0000,,Біреуді күтіп тұрғандай кейіп танытып, азапты өлтіріңіз
Dialogue: 0,0:46:42.90,0:46:43.95,*Default,NTP,0000,0000,0000,,Одан шаршаған кезде
Dialogue: 0,0:46:44.96,0:46:48.96,*Default,NTP,0000,0000,0000,,Мен бөлмеме қайтып келе жатқанда барынша баяу жүрдім.
Dialogue: 0,0:46:51.64,0:46:54.00,*Default,NTP,0000,0000,0000,,Менің орта мектепте достарым болды, бірақ
Dialogue: 0,0:46:54.47,0:46:56.46,*Default,NTP,0000,0000,0000,,Форма кигеннен басқа
Dialogue: 0,0:46:56.81,0:47:00.11,*Default,NTP,0000,0000,0000,,Неге екені белгісіз, мен сенімен бірге болғым келмеді.
Dialogue: 0,0:47:00.98,0:47:04.04,*Default,NTP,0000,0000,0000,,30 миллионнан астам адам тұратын қалада
Dialogue: 0,0:47:04.28,0:47:08.55,*Default,NTP,0000,0000,0000,,Ойланып қарасаңыз, сіз кездестіргіңіз келетін және сөйлескіңіз келетін адамдар бар.
Dialogue: 0,0:47:08.89,0:47:10.95,*Default,NTP,0000,0000,0000,,Менде ешкім болған жоқ.
Dialogue: 0,0:47:12.29,0:47:16.89,*Default,NTP,0000,0000,0000,,Сол күндері мен кейде Саюриді түсімде көретінмін.
Dialogue: 0,0:47:17.80,0:47:21.60,*Default,NTP,0000,0000,0000,,Бұл суық жерде жалғыз қалған Саюри.
Dialogue: 0,0:47:21.70,0:47:23.26,*Default,NTP,0000,0000,0000,,Амалсыз іздеген түсімде
Dialogue: 0,0:47:23.74,0:47:27.83,*Default,NTP,0000,0000,0000,,Соңында Саюри ешқашан табылмады.
Dialogue: 0,0:47:28.11,0:47:29.20,*Default,NTP,0000,0000,0000,,Тек
Dialogue: 0,0:47:29.31,0:47:32.51,*Default,NTP,0000,0000,0000,,Саюридің болуы ғана жүрегімді елжіретеді.
Dialogue: 0,0:47:32.81,0:47:35.97,*Default,NTP,0000,0000,0000,,Мен оянғаннан кейін де денемде қалды.
Dialogue: 0,0:47:37.25,0:47:38.72,*Default,NTP,0000,0000,0000,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,0:47:38.82,0:47:41.65,*Default,NTP,0000,0000,0000,,Мен Токиоға келгеннен бергі үшінші қыс.
Dialogue: 0,0:47:42.89,0:47:43.98,*Default,NTP,0000,0000,0000,,Дәл солай
Dialogue: 0,0:47:44.36,0:47:48.82,*Default,NTP,0000,0000,0000,,Терең, салқын суда тыныс алғандай.
Dialogue: 0,0:47:48.93,0:47:50.83,*Default,NTP,0000,0000,0000,,Әр күнім осылай өтті.
Dialogue: 0,0:47:51.83,0:47:53.26,*Default,NTP,0000,0000,0000,,Тек I
Dialogue: 0,0:47:53.37,0:47:54.76,*Default,NTP,0000,0000,0000,,Тек I
Dialogue: 0,0:47:54.87,0:47:58.33,*Default,NTP,0000,0000,0000,,Дүниеде жалғыз  Артында қалды
Dialogue: 0,0:47:58.57,0:48:00.33,*Default,NTP,0000,0000,0000,,Мен солай сезінемін
Dialogue: 0,0:48:21.69,0:48:22.56,*Default,NTP,0000,0000,0000,,Мен
Dialogue: 0,0:48:22.79,0:48:25.56,*Default,NTP,0000,0000,0000,,Бір күні Эзоға келу менің арманым еді.
Dialogue: 0,0:48:26.03,0:48:27.90,*Default,NTP,0000,0000,0000,,Мұнда оңай келуге болады.
Dialogue: 0,0:48:28.00,0:48:30.23,*Default,NTP,0000,0000,0000,,Бұл оңтүстік ұшы ғана.
Dialogue: 0,0:48:30.34,0:48:32.24,*Default,NTP,0000,0000,0000,,Одақ жағында отбасы мүшелеріңіз бар ма?
Dialogue: 0,0:48:32.34,0:48:34.24,*Default,NTP,0000,0000,0000,,Олай емес.
Dialogue: 0,0:48:35.21,0:48:37.57,*Default,NTP,0000,0000,0000,,Сіз бөлімнен кейінгі ұрпақтансыз...
Dialogue: 0,0:48:38.18,0:48:40.44,*Default,NTP,0000,0000,0000,,Таңдану сезімін түсінемін.
Dialogue: 0,0:48:40.88,0:48:44.44,*Default,NTP,0000,0000,0000,,Солтүстік-Оңтүстік бөлінуіне байланысты президент отбасынан бөлініп шықты.
Dialogue: 0,0:48:44.72,0:48:46.48,*Default,NTP,0000,0000,0000,,Менің ойымша, сізде басқа сезім бар.
Dialogue: 0,0:48:46.59,0:48:48.58,*Default,NTP,0000,0000,0000,,Иә? Солай ма?
Dialogue: 0,0:48:50.09,0:48:51.72,*Default,NTP,0000,0000,0000,,Бірақ бұл таң қалдырды.
Dialogue: 0,0:48:51.82,0:48:52.76,*Default,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:48:52.86,0:48:55.09,*Default,NTP,0000,0000,0000,,Мен президент сізді бұл іске тартады деп ойламадым.
Dialogue: 0,0:48:55.76,0:48:57.85,*Default,NTP,0000,0000,0000,,Мен өзімді сұрауға мәжбүр еттім.
Dialogue: 0,0:48:58.43,0:49:00.92,*Default,NTP,0000,0000,0000,,Мені өзіммен бірге алып кетпесең, қоғамдық қауіпсіздік бөліміне айтамын.
Dialogue: 0,0:49:01.03,0:49:03.06,*Default,NTP,0000,0000,0000,,Сіз қауіпті нәрсе істеп жатырсыз...
Dialogue: 0,0:49:12.34,0:49:13.37,*Default,NTP,0000,0000,0000,,Президент!
Dialogue: 0,0:49:13.61,0:49:15.60,*Default,NTP,0000,0000,0000,,Бұл әзіл емес.
Dialogue: 0,0:49:18.75,0:49:22.05,*Default,NTP,0000,0000,0000,,Ол мүлдем ақымақ шенеунік. Құпия ақпарат ашылды.
Dialogue: 0,0:49:22.15,0:49:23.25,*Default,NTP,0000,0000,0000,,Мені шығарыңыз
Dialogue: 0,0:49:34.23,0:49:36.13,*Default,NTP,0000,0000,0000,,Бұл жолы аздап қауіпті болды.
Dialogue: 0,0:49:36.54,0:49:39.80,*Default,NTP,0000,0000,0000,,Міне, сіздің арқаңызда біз ауаны басып алу жолындамыз.
Dialogue: 0,0:49:40.14,0:49:41.90,*Default,NTP,0000,0000,0000,,Мұның бәрі осы уақытқа дейін келгендіктен.
Dialogue: 0,0:49:42.01,0:49:42.97,*Default,NTP,0000,0000,0000,,Қара…
Dialogue: 0,0:49:43.18,0:49:45.04,*Default,NTP,0000,0000,0000,,ПрезидентКеме бар.
Dialogue: 0,0:49:45.14,0:49:46.63,*Default,NTP,0000,0000,0000,,Бұл патрульдік қайық!
Dialogue: 0,0:49:48.55,0:49:51.21,Notes,NTP,0000,0000,0000,,Сіздің кемеңіз Жапонияның аумақтық суларына қол сұғуда.
Dialogue: 0,0:49:51.32,0:49:55.29,Notes,NTP,0000,0000,0000,,Дереу тоқтаңызәйтпесе сізді атып тастаймыз.
Dialogue: 0,0:49:52.42,0:49:54.59,*Default,NTP,0000,0000,0000,,Соғыс бәрібір шешілді.
Dialogue: 0,0:49:54.59,0:49:56.36,*Default,NTP,0000,0000,0000,,Байыпты жұмыс жасаңыз
Dialogue: 0,0:49:55.29,0:49:56.69,Notes,NTP,0000,0000,0000,,Сол жақтағы адам бәрін егжей-тегжейлі түсіндіреді. Содан кейін оның нұсқауларын орындаңыз
Dialogue: 0,0:49:56.36,0:49:58.09,*Default,NTP,0000,0000,0000,,Бұл жаман. Оны шайқаңыз.
Dialogue: 0,0:49:58.19,0:49:58.99,*Default,NTP,0000,0000,0000,,Жоғары
Dialogue: 0,0:49:59.09,0:50:02.55,*Default,NTP,0000,0000,0000,,Шекараға небәрі 3 минут қалды. Сато: Миягава: Мылтық бекетіне шық.
Dialogue: 0,0:50:02.66,0:50:06.93,*Default,NTP,0000,0000,0000,,Бірден зәкірге ілініңіз, әйтпесе мен сізді атып тастаймын.
Dialogue: 0,0:50:19.04,0:50:20.07,*Default,NTP,0000,0000,0000,,Такуя!
Dialogue: 0,0:50:21.31,0:50:22.91,*Default,NTP,0000,0000,0000,,Амансың ба? Такуя! !
Dialogue: 0,0:50:36.53,0:50:37.69,*Default,NTP,0000,0000,0000,,...Сол қанаттар
Dialogue: 0,0:50:38.10,0:50:39.69,*Default,NTP,0000,0000,0000,,Мен білемін!
Dialogue: 0,0:51:00.72,0:51:03.48,*Default,NTP,0000,0000,0000,,Бір сәт ояныңыз
Dialogue: 0,0:51:03.92,0:51:07.36,*Default,NTP,0000,0000,0000,,Мен қайда екенімді білмеймін
Dialogue: 0,0:51:08.23,0:51:09.39,*Default,NTP,0000,0000,0000,,Бұл анық
Dialogue: 0,0:51:09.49,0:51:13.16,*Default,NTP,0000,0000,0000,,Мүмкін мен дұрыс емес жерге келген шығармын.
Dialogue: 0,0:51:13.50,0:51:14.86,*Default,NTP,0000,0000,0000,,Кейде ойлаймын
Dialogue: 0,0:51:16.87,0:51:20.20,*Default,NTP,0000,0000,0000,,Енді Саюридің арманы
Dialogue: 0,0:51:20.54,0:51:23.63,*Default,NTP,0000,0000,0000,,Ол шындықтан гөрі шынайырақ сезінеді.
Dialogue: 0,0:51:41.33,0:51:42.73,*Default,NTP,0000,0000,0000,,Қай жерде ауруханаға жатқызу керек?
Dialogue: 0,0:51:50.97,0:51:52.20,*Default,NTP,0000,0000,0000,,Саюри…
Dialogue: 0,0:52:16.60,0:52:18.83,*Default,NTP,0000,0000,0000,,“Хироки-кунТакуя-кун”
Dialogue: 0,0:52:18.93,0:52:22.13,*Default,NTP,0000,0000,0000,,«Мен олардың алдында үндемеуді қойдым».
Dialogue: 0,0:52:22.23,0:52:23.63,*Default,NTP,0000,0000,0000,,«Кешіріңіз»
Dialogue: 0,0:52:23.74,0:52:27.60,*Default,NTP,0000,0000,0000,,«Өкінішті, өйткені мен жазғы демалысты сенімен өткізгім келді».
Dialogue: 0,0:52:27.84,0:52:31.33,*Default,NTP,0000,0000,0000,,«Мен оянғанда Токиодағы ауруханада жатырмын».
Dialogue: 0,0:52:31.88,0:52:34.40,*Default,NTP,0000,0000,0000,,«Мен содан бері ауруханада жатырмын».
Dialogue: 0,0:52:34.65,0:52:38.51,*Default,NTP,0000,0000,0000,,«Мен оларға ауруханадағы адамдармен барлық байланысымды үзуім керектігін айттым».
Dialogue: 0,0:52:38.62,0:52:40.45,*Default,NTP,0000,0000,0000,,«Маған айтты»
Dialogue: 0,0:52:40.55,0:52:44.61,*Default,NTP,0000,0000,0000,,«Мен мұны сіздің өтінішіңіз бойынша жазып отырмын».
Dialogue: 0,0:52:45.06,0:52:47.18,*Default,NTP,0000,0000,0000,,«Екі адам оқи алатындай»
Dialogue: 0,0:52:47.29,0:52:49.62,*Default,NTP,0000,0000,0000,,«Мен оны Окабенің ағасына жіберемін».
Dialogue: 0,0:52:57.47,0:53:01.93,*Default,NTP,0000,0000,0000,,«Бірақ мен не жазарымды білмеймін».
Dialogue: 0,0:53:10.38,0:53:12.98,*Default,NTP,0000,0000,0000,,«Мен бір арманымды қайта-қайта көремін»
Dialogue: 0,0:53:16.59,0:53:21.49,*Default,NTP,0000,0000,0000,,«Бұл бос ғаламда жалғыз мен болатын арман».
Dialogue: 0,0:53:22.03,0:53:25.26,*Default,NTP,0000,0000,0000,,«Ол түсімде мен туралы бәрі».
Dialogue: 0,0:53:25.36,0:53:26.52,*Default,NTP,0000,0000,0000,,«Саусақтар мен щектер»
Dialogue: 0,0:53:26.63,0:53:28.22,*Default,NTP,0000,0000,0000,,«Тырнақтар мен өкшелер»
Dialogue: 0,0:53:28.33,0:53:30.36,*Default,NTP,0000,0000,0000,,«Шашыңыздың ұшына дейін»
Dialogue: 0,0:53:30.47,0:53:33.30,*Default,NTP,0000,0000,0000,,«Мен қатты жалғыздық сезімін сезінемін».
Dialogue: 0,0:53:35.14,0:53:39.20,*Default,NTP,0000,0000,0000,,«Бұл әлем үшеуміз бірге өткізген жылулыққа толы».
Dialogue: 0,0:53:39.41,0:53:43.31,*Default,NTP,0000,0000,0000,,«Ол кезде бұл арман сияқты еді».
Dialogue: 0,0:53:43.98,0:53:47.32,*Default,NTP,0000,0000,0000,,«...Бірақ мен сол күндердің естеліктерінен арылуым керек».
Dialogue: 0,0:53:47.42,0:53:49.65,*Default,NTP,0000,0000,0000,,«Мүмкін мен болашақта болармын»
Dialogue: 0,0:53:49.75,0:53:51.12,*Default,NTP,0000,0000,0000,,«Кішкене болса да».
Dialogue: 0,0:53:51.22,0:53:54.35,*Default,NTP,0000,0000,0000,,«Мүмкін мен шындықпен байланыста бола аламын».
Dialogue: 0,0:53:54.46,0:53:56.15,*Default,NTP,0000,0000,0000,,«Мен солай ойлаймын».
Dialogue: 0,0:53:57.43,0:53:58.95,*Default,NTP,0000,0000,0000,,Сіз басқа ауруханаға ауыстырылдыңыз ба?
Dialogue: 0,0:53:59.06,0:54:01.33,*Default,NTP,0000,0000,0000,,ИәШамамен бір апта бұрын
Dialogue: 0,0:54:01.70,0:54:04.93,*Default,NTP,0000,0000,0000,,Қосымша ақпарат алу үшін сіз ауыстырылатын ауруханаға хабарласыңыз.
Dialogue: 0,0:54:05.27,0:54:06.36,*Default,NTP,0000,0000,0000,,Иә...
Dialogue: 0,0:54:07.11,0:54:09.80,*Default,NTP,0000,0000,0000,,Мм...Саватари мырза жатқан аурухана бөлмесі.
Dialogue: 0,0:54:12.71,0:54:15.27,*Default,NTP,0000,0000,0000,,“Хироки-кунТакуя-кун”
Dialogue: 0,0:54:16.18,0:54:18.74,*Default,NTP,0000,0000,0000,,«Сол әдемі ақ ұшақ».
Dialogue: 0,0:54:19.72,0:54:24.18,*Default,NTP,0000,0000,0000,,«Сіз теңіз үстіндегі мұнараға аман-есен ұшып кеттіңіз бе?»
Dialogue: 0,0:54:29.76,0:54:30.92,*Default,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:54:32.43,0:54:34.46,*Default,NTP,0000,0000,0000,,Бұл арман сияқты атмосфера...
Dialogue: 0,0:54:41.54,0:54:42.73,*Default,NTP,0000,0000,0000,,…Саватари
Dialogue: 0,0:54:43.71,0:54:45.27,*Default,NTP,0000,0000,0000,,…Сіз сондасыз ба?
Dialogue: 0,0:55:04.50,0:55:05.55,*Default,NTP,0000,0000,0000,,…мәңгілік
Dialogue: 0,0:55:05.83,0:55:06.49,*Default,NTP,0000,0000,0000,,…мәңгілік
Dialogue: 0,0:55:06.73,0:55:08.29,*Default,NTP,0000,0000,0000,,Мен оны іздедім...!
Dialogue: 0,0:55:22.75,0:55:24.15,*Default,NTP,0000,0000,0000,,…Саватари
Dialogue: 0,0:55:24.38,0:55:27.75,*Default,NTP,0000,0000,0000,,Мен бұл жолы уәдемді орындағым келеді.
Dialogue: 0,0:55:27.85,0:55:31.45,*Default,NTP,0000,0000,0000,,Мен Саватариді мұнараға шығарып, Вераширамен ұшырамын.
Dialogue: 0,0:55:31.66,0:55:35.65,*Default,NTP,0000,0000,0000,,Олай болсам, біз тағы кездесетіндей боламын.
Dialogue: 0,0:55:36.03,0:55:36.86,*Default,NTP,0000,0000,0000,,Эй
Dialogue: 0,0:55:36.96,0:55:41.23,*Default,NTP,0000,0000,0000,,Мен сені енді жалғыз қалдырмаймынМен енді ештеңеден бас тартпаймын
Dialogue: 0,0:55:41.53,0:55:45.66,*Default,NTP,0000,0000,0000,,Мен әрқашан Саватариді қорғаймын. Уәде беремін.
Dialogue: 0,0:55:46.50,0:55:48.84,*Default,NTP,0000,0000,0000,,Иә...Уәде...
Dialogue: 0,0:55:50.51,0:55:53.48,*Default,NTP,0000,0000,0000,,Мұнараға бірге ұшайық.
Dialogue: 0,0:56:04.99,0:56:05.68,*Default,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:56:09.49,0:56:10.86,*Default,NTP,0000,0000,0000,,МұғалімКеліңіз.
Dialogue: 0,0:56:12.46,0:56:14.90,*Default,NTP,0000,0000,0000,,Мұнараның жұмыс деңгейі кенет өсті.
Dialogue: 0,0:56:15.00,0:56:18.20,*Default,NTP,0000,0000,0000,,Әртүрлі фазалық түрлендірулер ауқымы тез кеңейеді!
Dialogue: 0,0:56:18.64,0:56:19.76,*Default,NTP,0000,0000,0000,,Сонымен бірге
Dialogue: 0,0:56:19.87,0:56:22.36,*Default,NTP,0000,0000,0000,,Субъектінің саналы белсенділік деңгейі де жоғарылайды.
Dialogue: 0,0:56:22.47,0:56:24.57,*Default,NTP,0000,0000,0000,,Оянудың белгісі болуы мүмкін
Dialogue: 0,0:56:24.91,0:56:26.07,*Default,NTP,0000,0000,0000,,Менің күткенім осы болды
Dialogue: 0,0:56:26.18,0:56:28.70,*Default,NTP,0000,0000,0000,,Әртүрлі фазалық түрлендіру радиусы 20км-ден асты!
Dialogue: 0,0:56:30.45,0:56:31.21,*Default,NTP,0000,0000,0000,,Бұл...
Dialogue: 0,0:56:32.02,0:56:35.21,*Default,NTP,0000,0000,0000,,Сіз әлемді қайта жазуды жоспарлап отырсыз ба?
Dialogue: 0,0:56:38.16,0:56:40.72,*Default,NTP,0000,0000,0000,,Субъекттің сана деңгейі төмендей бастады!
Dialogue: 0,0:56:40.93,0:56:42.86,*Default,NTP,0000,0000,0000,,Әртүрлі фазалық түрлендіру жылдамдығы да төмендейді.
Dialogue: 0,0:56:42.96,0:56:44.16,*Default,NTP,0000,0000,0000,,Тоқта...!
Dialogue: 0,0:56:48.00,0:56:52.10,*Default,NTP,0000,0000,0000,,Шамамен 26 км радиусқа дейінгі диапазон параллель ғалам ретінде қайта жазылды.
Dialogue: 0,0:56:52.20,0:56:55.33,*Default,NTP,0000,0000,0000,,Субъектінің сана деңгейі де қалыпты деңгейге түсті.
Dialogue: 0,0:56:55.44,0:56:57.97,*Default,NTP,0000,0000,0000,,Ұйқы  қайтадан тұрақтана бастады.
Dialogue: 0,0:56:58.68,0:57:00.04,*Default,NTP,0000,0000,0000,,Томизава мырза...
Dialogue: 0,0:57:00.35,0:57:01.24,*Default,NTP,0000,0000,0000,,Иә...
Dialogue: 0,0:57:01.95,0:57:06.08,*Default,NTP,0000,0000,0000,,Өйткені, мұнараның белсенділігін басу үшін субъектінің ұйқысы болды.
Dialogue: 0,0:57:06.18,0:57:08.31,*Default,NTP,0000,0000,0000,,Мұнара түсірген параллель ғалам туралы ақпарат
Dialogue: 0,0:57:08.42,0:57:10.72,*Default,NTP,0000,0000,0000,,Айналадағы кеңістікті бұзудың орнына
Dialogue: 0,0:57:10.82,0:57:13.42,*Default,NTP,0000,0000,0000,,Енді субъектінің арманына ағып жатыр
Dialogue: 0,0:57:13.63,0:57:14.79,*Default,NTP,0000,0000,0000,,Саюри Саватари үшін
Dialogue: 0,0:57:15.39,0:57:17.88,*Default,NTP,0000,0000,0000,,Менің қолымнан келетіні – армандай беру
Dialogue: 0,0:57:18.63,0:57:22.43,*Default,NTP,0000,0000,0000,,Мүмкін мен жай ғана армандаған шығармын
Dialogue: 0,0:57:23.64,0:57:27.09,*Default,NTP,0000,0000,0000,,Сонда да Саюридің жылуы менің теріме тиді.
Dialogue: 0,0:57:27.21,0:57:29.94,*Default,NTP,0000,0000,0000,,Ол менің денемді жылытады
Dialogue: 0,0:57:31.18,0:57:33.67,*Default,NTP,0000,0000,0000,,Ол күн де алыс.
Dialogue: 0,0:57:34.51,0:57:38.28,*Default,NTP,0000,0000,0000,,Орындалмайтын уәделер бердік
Dialogue: 0,0:57:45.42,0:57:47.79,*Default,NTP,0000,0000,0000,,...Эй, Такуя-кун
Dialogue: 0,0:57:48.29,0:57:51.19,*Default,NTP,0000,0000,0000,,Бұл күлкілі оқиға шығар, бірақ күлмейсіз бе?
Dialogue: 0,0:57:51.30,0:57:53.99,*Default,NTP,0000,0000,0000,,Не? Мен күлмеймін
Dialogue: 0,0:57:54.10,0:57:56.57,*Default,NTP,0000,0000,0000,,Ал, сөйлесейік Мм...
Dialogue: 0,0:57:56.77,0:57:59.24,*Default,NTP,0000,0000,0000,,Жақында көрген түс туралы әңгіме
Dialogue: 0,0:58:01.84,0:58:04.93,*Default,NTP,0000,0000,0000,,Биік мұнара?  Union Tower сияқты ма?
Dialogue: 0,0:58:05.04,0:58:08.91,*Default,NTP,0000,0000,0000,,Жоқ, ол әлдеқайда бұрмаланған...Жұмбақ пішін
Dialogue: 0,0:58:09.11,0:58:10.60,*Default,NTP,0000,0000,0000,,Мен тұрған мұнарадан басқа
Dialogue: 0,0:58:10.71,0:58:13.44,*Default,NTP,0000,0000,0000,,Менің айналамда осындай көп заттар салынған.
Dialogue: 0,0:58:13.55,0:58:15.68,*Default,NTP,0000,0000,0000,,Неге екенін түсінемін.
Dialogue: 0,0:58:15.79,0:58:21.09,*Default,NTP,0000,0000,0000,,Әрқайсысы бөлек әлем, бұл ғаламның арманы
Dialogue: 0,0:58:21.99,0:58:25.66,*Default,NTP,0000,0000,0000,,Мен ол жерден көпке дейін шыға алмадым.
Dialogue: 0,0:58:26.03,0:58:29.02,*Default,NTP,0000,0000,0000,,Мен көптен бері жалғызбын, өзімді шынымен жалғыз сезінемін...
Dialogue: 0,0:58:29.27,0:58:30.46,*Default,NTP,0000,0000,0000,,Олай болса.
Dialogue: 0,0:58:30.57,0:58:32.30,*Default,NTP,0000,0000,0000,,Менің жүрегім осылай қалатынына сенімдімін.
Dialogue: 0,0:58:32.40,0:58:35.07,*Default,NTP,0000,0000,0000,,Жоғалып кетеді деп ойлаған кезде
Dialogue: 0,0:58:35.17,0:58:38.01,*Default,NTP,0000,0000,0000,,Аспанда ақ ұшақты көріп тұрмын
Dialogue: 0,0:58:40.04,0:58:41.60,*Default,NTP,0000,0000,0000,,Ақ жазықтық?
Dialogue: 0,0:58:41.71,0:58:42.70,*Default,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:58:43.11,0:58:44.31,*Default,NTP,0000,0000,0000,,Сонда?
Dialogue: 0,0:58:45.18,0:58:47.55,*Default,NTP,0000,0000,0000,,Арман сонда аяқталады
Dialogue: 0,0:59:02.73,0:59:04.20,*Default,NTP,0000,0000,0000,,Керемет!
Dialogue: 0,0:59:04.40,0:59:06.96,*Default,NTP,0000,0000,0000,,Ширакава-кунСен ояндың.
Dialogue: 0,0:59:07.07,0:59:07.94,*Default,NTP,0000,0000,0000,,Маки-сан...
Dialogue: 0,0:59:08.04,0:59:10.01,*Default,NTP,0000,0000,0000,,Себебі мен уайымдадым
Dialogue: 0,0:59:10.11,0:59:11.57,*Default,NTP,0000,0000,0000,,Неліктен?
Dialogue: 0,0:59:11.68,0:59:13.34,*Default,NTP,0000,0000,0000,,Сіздің иығыңыз әлі де ауырады ма?
Dialogue: 0,0:59:13.44,0:59:14.54,*Default,NTP,0000,0000,0000,,Иә…
Dialogue: 0,0:59:16.65,0:59:18.21,*Default,NTP,0000,0000,0000,,Мен сәл кешірім сұраймын.
Dialogue: 0,0:59:20.65,0:59:22.41,*Default,NTP,0000,0000,0000,,Қызуы да түсіп кеткен сияқты.
Dialogue: 0,0:59:22.52,0:59:25.39,*Default,NTP,0000,0000,0000,,Әй, қарның аш емес пе? Бірдеңе жегіңіз келе ме?
Dialogue: 0,0:59:25.49,0:59:28.55,*Default,NTP,0000,0000,0000,,
Dialogue: 0,0:59:28.66,0:59:29.92,*Default,NTP,0000,0000,0000,,Қайсысы жақсы...
Dialogue: 0,0:59:42.64,0:59:45.16,*Default,NTP,0000,0000,0000,,Ширакава-кунның жеке куәлігі кіруге рұқсат бермейді.
Dialogue: 0,0:59:45.78,0:59:47.11,*Default,NTP,0000,0000,0000,,Жарақатыңызды бітірдіңіз бе?
Dialogue: 0,0:59:47.34,0:59:51.08,*Default,NTP,0000,0000,0000,,АхИәКешіріңізМазалағаныңыз үшін кешірім сұраймын…
Dialogue: 0,0:59:51.28,0:59:52.11,*Default,NTP,0000,0000,0000,,Ум...
Dialogue: 0,0:59:52.22,0:59:54.41,*Default,NTP,0000,0000,0000,,Сіз Маки-чаннан естідіңіз бе?
Dialogue: 0,0:59:55.59,0:59:57.14,*Default,NTP,0000,0000,0000,,Танысқыңыз келе ме?
Dialogue: 0,1:00:00.59,1:00:04.55,*Default,NTP,0000,0000,0000,,Мені ұйықтатпайтын нәрсе - мұнарадан ағып жатқан параллель дүниенің ақпараты.
Dialogue: 0,1:00:04.66,1:00:07.96,*Default,NTP,0000,0000,0000,,Бұл оның миы көтере алмайтындығынан деп болжанады.
Dialogue: 0,1:00:08.20,1:00:11.17,*Default,NTP,0000,0000,0000,,Ұйқысы бұзылса
Dialogue: 0,1:00:11.67,1:00:13.83,*Default,NTP,0000,0000,0000,,Мұнараның айналасында орналасқанӘлем көзді ашып-жұмғанша өзгереді
Dialogue: 0,1:00:13.94,1:00:17.17,*Default,NTP,0000,0000,0000,,Мені параллель ғалам жұтып қояды деп ойлаймын.
Dialogue: 0,1:00:17.74,1:00:18.67,*Default,NTP,0000,0000,0000,,Қатынасты үзу ме? Қатынасты үзу... Хе-хе-хе-хе.
Dialogue: 0,1:00:19.14,1:00:21.67,*Default,NTP,0000,0000,0000,,...
Dialogue: 0,1:00:21.98,1:00:24.41,*Default,NTP,0000,0000,0000,,Біз білмейміз.
Dialogue: 0,1:00:25.48,1:00:27.04,*Default,NTP,0000,0000,0000,,Соғыс басталардан бірнеше күн бұрын.
Dialogue: 0,1:00:27.15,1:00:30.75,*Default,NTP,0000,0000,0000,,Сізді өз еліңіздегі NSA штаб-пәтеріне ауыстыру туралы шешім қабылданды.
Dialogue: 0,1:00:31.56,1:00:35.25,*Default,NTP,0000,0000,0000,,Осы салада артта қалған Одақ үшін
Dialogue: 0,1:00:35.39,1:00:37.62,*Default,NTP,0000,0000,0000,,Ол асыл үлгі
Dialogue: 0,1:00:40.26,1:00:42.99,*Default,NTP,0000,0000,0000,,…Неге Саватари?
Dialogue: 0,1:00:43.73,1:00:45.79,*Default,NTP,0000,0000,0000,,Біз білмейтін көп нәрсе бар
Dialogue: 0,1:00:46.17,1:00:48.97,*Default,NTP,0000,0000,0000,,Менің ойымша, бұл кездейсоқ емес шығар.
Dialogue: 0,1:00:49.51,1:00:52.07,*Default,NTP,0000,0000,0000,,Мұнараның дизайнері Эксун Цукиное,
Dialogue: 0,1:00:52.34,1:00:54.11,*Default,NTP,0000,0000,0000,,Оның атасы
Dialogue: 0,1:00:57.31,1:01:00.58,*Default,NTP,0000,0000,0000,,Менің естуімше, мұнара енді қару екені анық.
Dialogue: 0,1:01:01.19,1:01:02.48,*Default,NTP,0000,0000,0000,,Соңғы 25 жыл
Dialogue: 0,1:01:02.59,1:01:07.29,*Default,NTP,0000,0000,0000,,Күнделікті пейзажға араласқан мұнара барлық нәрсенің символы болды.
Dialogue: 0,1:01:07.39,1:01:12.09,*Default,NTP,0000,0000,0000,,Ұлт, жанжал, этникалық немесе үмітсіздік пен аңсау...
Dialogue: 0,1:01:12.20,1:01:15.26,*Default,NTP,0000,0000,0000,,...
Dialogue: 0,1:01:15.60,1:01:18.09,*Default,NTP,0000,0000,0000,,Дегенмен, ол әркімнің қолы жетпейді.
Dialogue: 0,1:01:18.20,1:01:22.23,*Default,NTP,0000,0000,0000,,Олар оны өзгертуге болмайтын нәрсенің символы ретінде қарастыруымен бірдей.
Dialogue: 0,1:01:22.34,1:01:26.28,*Default,NTP,0000,0000,0000,,Сен ойлағанша, бұл дүние өзгермейді.
Dialogue: 0,1:01:28.15,1:01:30.94,*Default,NTP,0000,0000,0000,,Үш күннен кейін, таңертең  Одаққа.
Dialogue: 0,1:01:31.05,1:01:34.04,*Default,NTP,0000,0000,0000,,АҚШ үкіметі соғыс жариялады.
Dialogue: 0,1:01:34.15,1:01:38.42,*Default,NTP,0000,0000,0000,,Жүк түсіру кезіндегі түсінбеушілікті пайдаланып, мұнараға лаңкестік шабуыл жасалды.
Dialogue: 0,1:01:38.62,1:01:41.32,*Default,NTP,0000,0000,0000,,ұшқышсыз Bredator көмегімен Эзоға басып кіру
Dialogue: 0,1:01:41.46,1:01:45.55,*Default,NTP,0000,0000,0000,,Шабуыл үшін PL снарядтары бар іздеуші зымырандарды пайдаланыңыз.
Dialogue: 0,1:01:46.30,1:01:49.29,*Default,NTP,0000,0000,0000,,Сол күні Вильк азаттық майданы таратылды.
Dialogue: 0,1:01:49.40,1:01:52.27,*Default,NTP,0000,0000,0000,,Бұл зауыт та бүгін жабық.
Dialogue: 0,1:01:58.68,1:01:59.64,*Default,NTP,0000,0000,0000,,О
Dialogue: 0,1:02:00.38,1:02:03.57,*Default,NTP,0000,0000,0000,,АхЖарайдыЖарайды онда ертең.
Dialogue: 0,1:02:15.33,1:02:16.09,*Default,NTP,0000,0000,0000,,Йо
Dialogue: 0,1:02:16.66,1:02:18.92,*Default,NTP,0000,0000,0000,,3 жыл болды.Такуя
Dialogue: 0,1:02:22.20,1:02:23.43,*Default,NTP,0000,0000,0000,,Қашан келдің?
Dialogue: 0,1:02:23.63,1:02:27.23,*Default,NTP,0000,0000,0000,,Бір күн бұрынМен қазір қараусыз қалған станцияда тұрамын.
Dialogue: 0,1:02:27.47,1:02:28.44,*Default,NTP,0000,0000,0000,,Қараусыз қалған станцияда?
Dialogue: 0,1:02:28.54,1:02:32.50,*Default,NTP,0000,0000,0000,,Иә, Такуя. Бұл қолға не болды?
Dialogue: 0,1:02:32.71,1:02:34.61,*Default,NTP,0000,0000,0000,,Oh, just a little.
Dialogue: 0,1:02:35.38,1:02:37.24,*Default,NTP,0000,0000,0000,,…
Dialogue: 0,1:02:37.35,1:02:38.87,*Default,NTP,0000,0000,0000,,...Мен сенімен кейінірек сөйлесемін.
Dialogue: 0,1:02:41.29,1:02:43.38,*Default,NTP,0000,0000,0000,,Бүгін де демалыс па деп ойлаймын...
Dialogue: 0,1:02:43.59,1:02:44.25,*Default,NTP,0000,0000,0000,,О!
Dialogue: 0,1:02:44.52,1:02:48.48,*Default,NTP,0000,0000,0000,,ЧобиҚалайсың? Біраз уақыт өтті.
Dialogue: 0,1:03:12.45,1:03:14.38,*Default,NTP,0000,0000,0000,,Верацилла ұшады ма?
Dialogue: 0,1:03:16.62,1:03:17.99,*Default,NTP,0000,0000,0000,,Саватариді бортқа апаруым керек пе?
Dialogue: 0,1:03:18.09,1:03:19.28,*Default,NTP,0000,0000,0000,,Иә
Dialogue: 0,1:03:19.99,1:03:22.42,*Default,NTP,0000,0000,0000,,Жиналыс тағы бір күнде аяқталады.
Dialogue: 0,1:03:22.53,1:03:23.29,*Default,NTP,0000,0000,0000,,Қалғандары
Dialogue: 0,1:03:23.49,1:03:24.98,*Default,NTP,0000,0000,0000,,Бұл басқару бағдарламалық құралына қатысты мәселе...
Dialogue: 0,1:03:25.10,1:03:28.62,*Default,NTP,0000,0000,0000,,Тоқта, сен мені тыңдадың ба?
Dialogue: 0,1:03:28.73,1:03:30.96,*Default,NTP,0000,0000,0000,,Саватари ұйықтай береді, ал мұнара...
Dialogue: 0,1:03:31.07,1:03:34.04,*Default,NTP,0000,0000,0000,,The tower is a terrorist target, right?
Dialogue: 0,1:03:34.30,1:03:36.83,*Default,NTP,0000,0000,0000,,Сондықтан маған Такуяның көмегі керек.
Dialogue: 0,1:03:37.31,1:03:40.47,*Default,NTP,0000,0000,0000,,Айттым ғой, ойланып қалдым.
Dialogue: 0,1:03:40.81,1:03:44.25,*Default,NTP,0000,0000,0000,,Мұнараға бірге ұшсақ Саватари оянады деп ойлаймын.
Dialogue: 0,1:03:46.65,1:03:48.08,*Default,NTP,0000,0000,0000,,…
Dialogue: 0,1:03:48.22,1:03:50.48,*Default,NTP,0000,0000,0000,,Сол үшін оралдың ба?
Dialogue: 0,1:03:51.66,1:03:52.31,*Default,NTP,0000,0000,0000,,...сонымен
Dialogue: 0,1:03:52.69,1:03:56.59,*Default,NTP,0000,0000,0000,,...Бұл дұрыс емес.Уәде бермедік пе?
Dialogue: 0,1:03:59.20,1:04:01.32,*Default,NTP,0000,0000,0000,,Мен Саватариді армандаймын
Dialogue: 0,1:04:01.73,1:04:03.32,*Default,NTP,0000,0000,0000,,Қайталап
Dialogue: 0,1:04:04.10,1:04:07.40,*Default,NTP,0000,0000,0000,,Саватари ешкім жоқ жерде жалғыз қалды.
Dialogue: 0,1:04:07.64,1:04:09.66,*Default,NTP,0000,0000,0000,,Ол ештеңе есіне түсіре алмайтынын айтты.
Dialogue: 0,1:04:10.31,1:04:13.54,*Default,NTP,0000,0000,0000,,Бірақ сол жігіттің уәдесі есімде.
Dialogue: 0,1:04:13.64,1:04:18.84,*Default,NTP,0000,0000,0000,,Түсімде бұл жолы сені мұнараға апарамын деп тағы бір рет уәде бердім.
Dialogue: 0,1:04:19.52,1:04:22.68,*Default,NTP,0000,0000,0000,,Сене алар емеспін... бұл жай ғана арман.
Dialogue: 0,1:04:27.09,1:04:28.85,*Default,NTP,0000,0000,0000,,...Енді мына  жігіті келді.
Dialogue: 0,1:04:29.26,1:04:31.39,*Default,NTP,0000,0000,0000,,Қызық, бұл жай ғана арман емес пе?
Dialogue: 0,1:04:32.23,1:04:34.20,*Default,NTP,0000,0000,0000,,Саған қарап ашуым келеді
Dialogue: 0,1:04:35.40,1:04:38.13,*Default,NTP,0000,0000,0000,,Балалармен араласуға менің бос уақытым жетпейді.
Dialogue: 0,1:04:41.37,1:04:44.24,*Default,NTP,0000,0000,0000,,Себебі сіз осындай нәрсеге мәңгі байланып қаласыз.
Dialogue: 0,1:04:45.38,1:04:47.04,*Default,NTP,0000,0000,0000,,Мен сені ұмыттырамын
Dialogue: 0,1:04:52.25,1:04:52.91,*Default,NTP,0000,0000,0000,,...Тоқта!
Dialogue: 0,1:05:23.41,1:05:25.24,*Default,NTP,0000,0000,0000,,Саюриді құтқарасыз ба?
Dialogue: 0,1:05:25.65,1:05:27.51,*Default,NTP,0000,0000,0000,,Сіз әлемді құтқарасыз ба?
Dialogue: 0,1:06:08.13,1:06:11.25,*Default,NTP,0000,0000,0000,,О, мен бір нәрсені ұмытып қалдым ...
Dialogue: 0,1:06:12.13,1:06:13.46,*Default,NTP,0000,0000,0000,,Бұл дұрыс
Dialogue: 0,1:06:19.34,1:06:21.17,*Default,NTP,0000,0000,0000,,Саватари: Үйге бармайсың ба?
Dialogue: 0,1:06:21.27,1:06:23.76,*Default,NTP,0000,0000,0000,,А, иә, мен үйге бара жатырмын.
Dialogue: 0,1:06:27.54,1:06:28.91,*Default,NTP,0000,0000,0000,,Хироки-кун
Dialogue: 0,1:06:29.85,1:06:31.18,*Default,NTP,0000,0000,0000,,Не болды?Hobe
Dialogue: 0,1:06:31.28,1:06:34.58,*Default,NTP,0000,0000,0000,,О, мен Такуямен аздап ұрысып қалдым.
Dialogue: 0,1:06:36.09,1:06:37.42,*Default,NTP,0000,0000,0000,,Жақсысың ба?
Dialogue: 0,1:06:37.52,1:06:41.05,*Default,NTP,0000,0000,0000,,Жарайды, жарайды, жақын арада татуласатынымызға сенімдімін.
Dialogue: 0,1:06:41.16,1:06:42.13,*Default,NTP,0000,0000,0000,,Мүмкін
Dialogue: 0,1:06:43.19,1:06:44.49,*Default,NTP,0000,0000,0000,,Кездескенше...Қайырлы түн
Dialogue: 0,1:06:44.59,1:06:48.05,*Default,NTP,0000,0000,0000,,Хироки-кун! Эй, сен вокзалға барасың ба?
Dialogue: 0,1:06:57.81,1:06:59.83,*Default,NTP,0000,0000,0000,,Менде әрқашан алдын ала ескерту бар
Dialogue: 0,1:07:00.94,1:07:02.91,*Default,NTP,0000,0000,0000,,Бір нәрсені жоғалтуды алдын ала ескерту
Dialogue: 0,1:07:03.85,1:07:06.58,*Default,NTP,0000,0000,0000,,Дүние шынымен әдемі болса да
Dialogue: 0,1:07:06.85,1:07:08.34,*Default,NTP,0000,0000,0000,,Тек I
Dialogue: 0,1:07:08.45,1:07:11.65,*Default,NTP,0000,0000,0000,,Мен өзімді ол жерден алыста жүргендей сезінемін.
Dialogue: 0,1:07:14.96,1:07:17.36,*Default,NTP,0000,0000,0000,,Бірақ, мен үшін ол кезде...
Dialogue: 0,1:07:18.30,1:07:22.43,*Default,NTP,0000,0000,0000,,Менің ойымша, Саюри жарқыраған әлемнің ортасында тұрғандай көрінді.
Dialogue: 0,1:07:23.53,1:07:25.87,*Default,NTP,0000,0000,0000,,…АаМен түсіндім.
Dialogue: 0,1:07:26.34,1:07:29.60,*Default,NTP,0000,0000,0000,,Дәл қазір өте маңызды нәрсе
Dialogue: 0,1:07:29.81,1:07:31.10,*Default,NTP,0000,0000,0000,,Мен бәрібір жақсы боламын. Бар күшімді саламын
Dialogue: 0,1:07:32.11,1:07:34.10,*Default,NTP,0000,0000,0000,,...Мен түсіндім деп ойладым...
Dialogue: 0,1:07:46.19,1:07:47.21,*Default,NTP,0000,0000,0000,,Оны басқа жерде көрді, сондықтан ол сонда кетті.
Dialogue: 0,1:07:48.16,1:07:49.85,*Default,NTP,0000,0000,0000,,Мұнда біреу бар ма?
Dialogue: 0,1:07:57.57,1:07:58.86,*Default,NTP,0000,0000,0000,,Окабе-сан
Dialogue: 0,1:07:59.47,1:08:02.30,*Default,NTP,0000,0000,0000,,Бұл ХирокиОкабе-сан!
Dialogue: 0,1:08:04.67,1:08:06.30,*Default,NTP,0000,0000,0000,,Сәттілік болса да...
Dialogue: 0,1:08:20.99,1:08:22.12,*Default,NTP,0000,0000,0000,,Уау!
Dialogue: 0,1:08:24.63,1:08:27.83,*Default,NTP,0000,0000,0000,,...Менің ойымша, бұл Хироки, иә? Ол үлкейіп кетті.
Dialogue: 0,1:08:28.00,1:08:30.52,*Default,NTP,0000,0000,0000,,…О, Окабе мырза! ? Осы туралы.
Dialogue: 0,1:08:30.63,1:08:32.10,*Default,NTP,0000,0000,0000,,Мен Такуядан сұрадым.
Dialogue: 0,1:08:32.60,1:08:35.09,*Default,NTP,0000,0000,0000,,Мен қаншалықты дайын екенімді көрсетейін.
Dialogue: 0,1:08:35.84,1:08:38.24,*Default,NTP,0000,0000,0000,,Мұнараны өздеріңмен бірге қиратыңдар.
Dialogue: 0,1:08:38.84,1:08:41.33,*Default,NTP,0000,0000,0000,,Террористік жарылыс туралы қауесет. Бұл рас па?
Dialogue: 0,1:08:41.71,1:08:45.61,*Default,NTP,0000,0000,0000,,...Мен не істерімді білмеймін, бірақ соғыс жақындап қалған шығар.
Dialogue: 0,1:08:45.72,1:08:48.81,*Default,NTP,0000,0000,0000,,Егер бұл орын алса, мұнараны зерттеудің қажеті болмауы мүмкін.
Dialogue: 0,1:08:49.55,1:08:51.65,*Default,NTP,0000,0000,0000,,...Соңында Цукиное не істеп жатыр
Dialogue: 0,1:08:51.76,1:08:54.28,*Default,NTP,0000,0000,0000,,Вильта сияқты террористік ұйымдар не істеп жатыр
Dialogue: 0,1:08:54.39,1:08:56.09,*Default,NTP,0000,0000,0000,,Солтүстік пен Оңтүстіктің бөлінуіне қарсылық білдіру мағынасында
Dialogue: 0,1:08:56.19,1:08:58.72,*Default,NTP,0000,0000,0000,,Мен де дәл солай сияқты сезінемін.
Dialogue: 0,1:09:02.47,1:09:04.87,*Default,NTP,0000,0000,0000,,...Ширакава-кун, бұл біраз оғаш, солай емес пе?
Dialogue: 0,1:09:05.67,1:09:07.30,*Default,NTP,0000,0000,0000,,Құпиялары көп сияқты.
Dialogue: 0,1:09:07.40,1:09:09.07,*Default,NTP,0000,0000,0000,,Жоқ, солай.
Dialogue: 0,1:09:09.17,1:09:12.07,*Default,NTP,0000,0000,0000,,КешіріңізМен шай дайындаймынСосын.
Dialogue: 0,1:09:12.68,1:09:15.08,*Default,NTP,0000,0000,0000,,Жарақатыңды емдеймін.
Dialogue: 0,1:09:19.58,1:09:22.81,*Default,NTP,0000,0000,0000,,...Ширакава-кунЖақындаСізді тыртық басып қалды.
Dialogue: 0,1:09:22.92,1:09:24.51,*Default,NTP,0000,0000,0000,,Кешіріңіз...
Dialogue: 0,1:09:25.26,1:09:27.19,*Default,NTP,0000,0000,0000,,Маңызды нәрсе бар ма?
Dialogue: 0,1:09:27.29,1:09:28.38,*Default,NTP,0000,0000,0000,,Е
Dialogue: 0,1:09:28.69,1:09:29.89,*Default,NTP,0000,0000,0000,,Жарайды
Dialogue: 0,1:09:30.29,1:09:31.82,*Default,NTP,0000,0000,0000,,Кешіріңіз...
Dialogue: 0,1:09:36.70,1:09:39.69,*Default,NTP,0000,0000,0000,,...Ол жігіт менің ең жақын досым еді.
Dialogue: 0,1:09:39.80,1:09:40.46,*Default,NTP,0000,0000,0000,,Е...
Dialogue: 0,1:09:40.57,1:09:42.16,*Default,NTP,0000,0000,0000,,Ұрыстағы серіктес
Dialogue: 0,1:09:42.37,1:09:46.14,*Default,NTP,0000,0000,0000,,Біз де дәл осы мақсатты көздедік.
Dialogue: 0,1:09:46.24,1:09:47.30,*Default,NTP,0000,0000,0000,,Иә...
Dialogue: 0,1:09:47.98,1:09:52.00,*Default,NTP,0000,0000,0000,,Бірақ сіз әртүрлі жерге барғанда не айтасыз?
Dialogue: 0,1:09:52.12,1:09:55.31,*Default,NTP,0000,0000,0000,,Мен қайда барарымды білмеймін
Dialogue: 0,1:09:55.52,1:09:57.35,*Default,NTP,0000,0000,0000,,Түсініксіз күштер мен импульстар
Dialogue: 0,1:09:57.45,1:10:00.18,*Default,NTP,0000,0000,0000,,Сонда да ішімнен асып-тасып жатыр
Dialogue: 0,1:10:00.76,1:10:01.95,*Default,NTP,0000,0000,0000,,Иә
Dialogue: 0,1:10:02.26,1:10:07.66,*Default,NTP,0000,0000,0000,,Сондықтан осы зертханаға кіргенде мен өзімді жеңіл сезіндім.
Dialogue: 0,1:10:08.53,1:10:11.09,*Default,NTP,0000,0000,0000,,Мен істейтін бірдеңе тапқандай болдым.
Dialogue: 0,1:10:11.37,1:10:12.63,*Default,NTP,0000,0000,0000,,Және...
Dialogue: 0,1:10:12.80,1:10:15.64,*Default,NTP,0000,0000,0000,,Мен де Макимен кездескеніме қуаныштымын.
Dialogue: 0,1:10:19.71,1:10:20.87,*Default,NTP,0000,0000,0000,,...сонымен
Dialogue: 0,1:10:21.41,1:10:23.14,*Default,NTP,0000,0000,0000,,Мен сізді араластырғым келмейді.
Dialogue: 0,1:10:37.36,1:10:40.49,*Default,NTP,0000,0000,0000,,Мен шынымен де істеуім керек нәрсе бар.
Dialogue: 0,1:10:41.43,1:10:43.16,*Default,NTP,0000,0000,0000,,Барлығы аяқталғанда
Dialogue: 0,1:10:43.40,1:10:46.39,*Default,NTP,0000,0000,0000,,IМен Маки-санмен тағы кездескім келеді.
Dialogue: 0,1:10:47.37,1:10:48.93,*Default,NTP,0000,0000,0000,,Ширакава-кун!
Dialogue: 0,1:11:19.00,1:11:20.20,*Default,NTP,0000,0000,0000,,Саватари
Dialogue: 0,1:11:21.17,1:11:22.54,*Default,NTP,0000,0000,0000,,Келесі жолы
Dialogue: 0,1:11:22.91,1:11:24.77,*Default,NTP,0000,0000,0000,,Уәде етілген жерге барайық
Dialogue: 0,1:11:31.05,1:11:32.88,*Default,NTP,0000,0000,0000,,Сіз нені айтып тұрсыз?Ока-чан
Dialogue: 0,1:11:33.12,1:11:35.14,*Default,NTP,0000,0000,0000,,Сіз бұл үшін баланы пайдаланасыз ба?
Dialogue: 0,1:11:35.25,1:11:37.08,*Default,NTP,0000,0000,0000,,Олар мұны қалайды.
Dialogue: 0,1:11:37.19,1:11:38.85,*Default,NTP,0000,0000,0000,,Ал мұнараның айналасында
Dialogue: 0,1:11:38.96,1:11:42.22,*Default,NTP,0000,0000,0000,,Менің ойымша, оны бастапқыда параллель ғалам немесе басқа нәрсе жұтып қойған.
Dialogue: 0,1:11:42.33,1:11:44.23,*Default,NTP,0000,0000,0000,,Өлім жоқ
Dialogue: 0,1:11:44.33,1:11:45.59,*Default,NTP,0000,0000,0000,,Сондықтан...
Dialogue: 0,1:11:45.70,1:11:47.72,*Default,NTP,0000,0000,0000,,Ал, тыныштал Томизава
Dialogue: 0,1:11:47.83,1:11:52.77,*Default,NTP,0000,0000,0000,,Оның үстіне сен қайтып келгенше олар да бала болмайды.
Dialogue: 0,1:11:54.10,1:11:57.44,*Default,NTP,0000,0000,0000,,...Дәл қазір не ойлап тұрғаныңызды болжай аламын ба?
Dialogue: 0,1:12:00.81,1:12:02.68,*Default,NTP,0000,0000,0000,,Yare yare…
Dialogue: 0,1:12:03.05,1:12:04.45,*Default,NTP,0000,0000,0000,,Олай болса кесіп алайық.
Dialogue: 0,1:12:07.22,1:12:09.69,*Default,NTP,0000,0000,0000,,Бұл ақыры аяқталды.
Dialogue: 0,1:12:11.52,1:12:14.62,*Default,NTP,0000,0000,0000,,Саюри-чан, шынымен оянасыз ба?
Dialogue: 0,1:12:14.72,1:12:18.18,*Default,NTP,0000,0000,0000,,Мен де...бір себептермен мен қазір жұқтырдым.
Dialogue: 0,1:12:18.63,1:12:22.46,*Default,NTP,0000,0000,0000,,Сол күнгі уәде Саватаридің шындықпен байланысы болса керек.
Dialogue: 0,1:12:22.70,1:12:25.83,*Default,NTP,0000,0000,0000,,Қазір де түсімде Верашира күтемін.
Dialogue: 0,1:12:26.04,1:12:29.84,*Default,NTP,0000,0000,0000,,Мен Хироки сияқты сезінемін және мен мұны әрқашан бір жерде сезіндім.
Dialogue: 0,1:12:33.48,1:12:37.34,*Default,NTP,0000,0000,0000,,Верашира екі орындық, сондықтан мен оны қолыммен басқара алмаймын.
Dialogue: 0,1:12:37.81,1:12:40.84,*Default,NTP,0000,0000,0000,,Мен артта қалып, мұнараның не болатынын көремін.
Dialogue: 0,1:12:43.49,1:12:46.58,*Default,NTP,0000,0000,0000,,Күн суытады деп ойлағанымда қайтадан жаңбыр жауа бастады.
Dialogue: 0,1:12:46.69,1:12:48.21,*Default,NTP,0000,0000,0000,,Онда мен барамын.
Dialogue: 0,1:12:48.32,1:12:52.52,*Default,NTP,0000,0000,0000,,Аа  Жарайды, солай  Екеуміздің дуэт болып танысқанымызға көп болды.
Dialogue: 0,1:12:52.63,1:12:54.36,*Default,NTP,0000,0000,0000,,Жақсы араласайық!
Dialogue: 0,1:13:01.64,1:13:03.27,*Default,NTP,0000,0000,0000,,Қайсысы? … Міне!
Dialogue: 0,1:13:40.64,1:13:42.54,*Default,NTP,0000,0000,0000,,Окабе мырзадан естідіңіз бе?
Dialogue: 0,1:13:42.85,1:13:43.50,*Default,NTP,0000,0000,0000,,Ах...
Dialogue: 0,1:13:51.12,1:13:52.52,*Default,NTP,0000,0000,0000,,…Такуя
Dialogue: 0,1:13:52.79,1:13:55.66,*Default,NTP,0000,0000,0000,,Blos жүйесінің қай нұсқасын пайдалануым керек?
Dialogue: 0,1:13:56.19,1:13:59.63,*Default,NTP,0000,0000,0000,,Сіз жолда рульдің орнын өзгерткен болуыңыз керек. Одан кейін ештеңе жоқ.
Dialogue: 0,1:14:03.20,1:14:04.46,*Default,NTP,0000,0000,0000,,Осының ішінде
Dialogue: 0,1:14:05.13,1:14:07.10,*Default,NTP,0000,0000,0000,,Оған іздеуші зымырандар да кіреді.
Dialogue: 0,1:14:07.20,1:14:09.03,*Default,NTP,0000,0000,0000,,Не қалды?
Dialogue: 0,1:14:09.37,1:14:13.90,*Default,NTP,0000,0000,0000,,Асқын өткізгіш қозғалтқыштың сымдары аздап ажыратылған. Жалғыз нәрсе - бағдарламалық құралды дәл баптау.
Dialogue: 0,1:14:14.58,1:14:17.05,*Default,NTP,0000,0000,0000,,Жоспарланған соғыс жариялауға 5 сағат қалды
Dialogue: 0,1:14:17.15,1:14:20.24,*Default,NTP,0000,0000,0000,,Одан кейін соғыстың ортасында ұшып кетуден басқа амалымыз жоқ.
Dialogue: 0,1:14:20.45,1:14:23.28,*Default,NTP,0000,0000,0000,,Мен бағдарламалық жасақтаманы өңдеймін, сондықтан Хироки сымдарды аяқтай алады.
Dialogue: 0,1:14:23.39,1:14:27.48,*Default,NTP,0000,0000,0000,,О... және Такуя! Бұл не?Бұл қате туралы хабар
Dialogue: 0,1:14:27.59,1:14:28.56,*Default,NTP,0000,0000,0000,,Иә?
Dialogue: 0,1:14:28.66,1:14:30.15,*Default,NTP,0000,0000,0000,,Нұсқаны тексеру
Dialogue: 0,1:14:30.26,1:14:31.82,*Default,NTP,0000,0000,0000,,Нұсқаны тексеру?
Dialogue: 0,1:14:32.33,1:14:35.16,*Default,NTP,0000,0000,0000,,...Аа, сіз орнатқан жер емес пе?
Dialogue: 0,1:14:35.26,1:14:36.32,*Default,NTP,0000,0000,0000,,3 жыл бұрын
Dialogue: 0,1:14:36.43,1:14:38.49,*Default,NTP,0000,0000,0000,,Солай ма...?
Dialogue: 0,1:14:38.60,1:14:41.73,*Default,NTP,0000,0000,0000,,Әдеттегідей...ақымақ
Dialogue: 0,1:15:05.29,1:15:06.99,*Default,NTP,0000,0000,0000,,ХирокиҚараңыз.
Dialogue: 0,1:15:07.56,1:15:08.72,*Default,NTP,0000,0000,0000,,Не?
Dialogue: 0,1:15:09.00,1:15:11.63,*Default,NTP,0000,0000,0000,,Цугару жағалауындағы ұрыс жағдайының болжамы жарияланды.
Dialogue: 0,1:15:15.04,1:15:16.80,*Default,NTP,0000,0000,0000,,Көбінесе күткендей.
Dialogue: 0,1:15:19.71,1:15:22.58,*Default,NTP,0000,0000,0000,,Алдыңғы жағы 42-ші параллельге дейін ме?
Dialogue: 0,1:15:22.68,1:15:26.31,*Default,NTP,0000,0000,0000,,Ішкі аймақтар Әсіресе мұнараның айналасы кедір-бұдыр.
Dialogue: 0,1:15:26.42,1:15:29.82,*Default,NTP,0000,0000,0000,,Жерде эрозия жүріп жатыр, сондықтан не істеуіміз керек?
Dialogue: 0,1:15:29.92,1:15:32.89,*Default,NTP,0000,0000,0000,,Төмен биіктікте бұғаз арқылы ұшу үшін ағынды пайдаланыңыз.
Dialogue: 0,1:15:32.99,1:15:36.36,*Default,NTP,0000,0000,0000,,Біз 42-ші параллельден өтіп, Кокоямаға жақындай бергенде.
Dialogue: 0,1:15:36.46,1:15:38.29,*Default,NTP,0000,0000,0000,,Биік биіктікте круиздік ұшу...
Dialogue: 0,1:15:38.39,1:15:39.95,*Default,NTP,0000,0000,0000,,...Осындай нәрсе не болды?
Dialogue: 0,1:15:40.06,1:15:43.97,*Default,NTP,0000,0000,0000,,Дұрыс.Мен басқа ештеңе істей алмаймын деп ойлаймын.
Dialogue: 0,1:15:45.67,1:15:47.97,*Default,NTP,0000,0000,0000,,Мұнараға келгенде, Саватаридің оянуы.
Dialogue: 0,1:15:48.07,1:15:50.20,*Default,NTP,0000,0000,0000,,Жердегі әр түрлі фазалық трансформация қайта жалғасуы керек.
Dialogue: 0,1:15:50.91,1:15:54.10,*Default,NTP,0000,0000,0000,,Егер бұл орын алса, дереу кетіп, мұнарадан 10 км-ден астам жерде қалдырыңыз.
Dialogue: 0,1:15:54.21,1:15:56.18,*Default,NTP,0000,0000,0000,,Маған іздеуші зымыранды жібер.
Dialogue: 0,1:15:56.31,1:15:58.91,*Default,NTP,0000,0000,0000,,Өйткені ол мұнараға автономды түрде ұшуға арналған.
Dialogue: 0,1:15:59.28,1:16:01.15,*Default,NTP,0000,0000,0000,,Міне, бәрі бітті.
Dialogue: 0,1:16:01.65,1:16:04.31,*Default,NTP,0000,0000,0000,,Жарайды.
Dialogue: 0,1:16:04.42,1:16:07.91,*Default,NTP,0000,0000,0000,,…АаСоғыстың басталуына әлі екі сағаттай уақыт бар.
Dialogue: 0,1:16:08.59,1:16:10.22,*Default,NTP,0000,0000,0000,,Мен күткеннен тезірек аяқталды.
Dialogue: 0,1:16:10.33,1:16:11.09,*Default,NTP,0000,0000,0000,,Иә...
Dialogue: 0,1:16:13.30,1:16:14.32,*Default,NTP,0000,0000,0000,,Хироки
Dialogue: 0,1:16:14.43,1:16:15.59,*Default,NTP,0000,0000,0000,,Иә?
Dialogue: 0,1:16:15.70,1:16:19.23,*Default,NTP,0000,0000,0000,,Кез келген жағдайда, сіз скрипкада ойнай аласыз ба?
Dialogue: 0,1:16:22.61,1:16:24.37,*Default,NTP,0000,0000,0000,,...Әйтеуір,
Dialogue: 0,1:16:24.57,1:16:27.13,*Default,NTP,0000,0000,0000,,Сен ақымақ сияқты бірбеткейсің.
Dialogue: 0,1:16:27.24,1:16:31.51,*Default,NTP,0000,0000,0000,,Бұл қажетсіз көмек. Менің ойымша, сіз оны сұрадыңыз ...
Dialogue: 0,1:16:32.42,1:16:33.97,*Default,NTP,0000,0000,0000,,Маған қара.
Dialogue: 0,1:16:34.08,1:16:35.74,*Default,NTP,0000,0000,0000,,Шулы!
Dialogue: 0,1:16:36.02,1:16:37.42,*Default,NTP,0000,0000,0000,,Аузыңды жап, тыңда!
Dialogue: 0,1:16:37.52,1:16:39.04,*Default,NTP,0000,0000,0000,,Хаха
Dialogue: 0,1:17:21.70,1:17:26.03,*Default,NTP,0000,0000,0000,,Мен ояну туралы алдын ала ескертуден денемнің дірілдегенін сеземін.
Dialogue: 0,1:17:27.07,1:17:29.80,*Default,NTP,0000,0000,0000,,Неліктен?Қазір
Dialogue: 0,1:17:29.94,1:17:33.10,*Default,NTP,0000,0000,0000,,Қорқыныш үміттен де күшті
Dialogue: 0,1:17:34.34,1:17:37.18,*Default,NTP,0000,0000,0000,,Менде үнемі бірдеңені жоғалтып алатындай сезім болады.
Dialogue: 0,1:17:37.31,1:17:39.25,*Default,NTP,0000,0000,0000,,Саюри осылай деді.
Dialogue: 0,1:17:39.62,1:17:44.71,*Default,NTP,0000,0000,0000,,Қазір мен де сол алдын ала сезініп тұрмын.
Dialogue: 0,1:17:45.62,1:17:46.78,*Default,NTP,0000,0000,0000,,Бірақ
Dialogue: 0,1:17:47.32,1:17:49.66,*Default,NTP,0000,0000,0000,,Бір күні мектептен кейін уәде
Dialogue: 0,1:17:50.06,1:17:53.32,*Default,NTP,0000,0000,0000,,Мен сол мұнараға барамын
Dialogue: 0,1:17:55.03,1:17:57.36,*Default,NTP,0000,0000,0000,,Мұнараның жұмыс деңгейі қайта көтеріледі!
Dialogue: 0,1:17:57.67,1:18:00.66,*Default,NTP,0000,0000,0000,,Тармақталатын ғаламның эрозиясының диапазоны кеңейеді
Dialogue: 0,1:18:00.77,1:18:04.10,*Default,NTP,0000,0000,0000,,Ағымдағы радиусы шамамен 36 км0,4 км/сағ
Dialogue: 0,1:18:04.21,1:18:05.87,*Default,NTP,0000,0000,0000,,Баяу кеңейту
Dialogue: 0,1:18:06.31,1:18:09.14,*Default,NTP,0000,0000,0000,,Сіз ояту белгілеріне жауап бересіз бе?
Dialogue: 0,1:18:10.08,1:18:12.60,*Default,NTP,0000,0000,0000,,Жақсысың деп үміттенемін, Ока-чан...
Dialogue: 0,1:18:13.18,1:18:13.88,*Default,NTP,0000,0000,0000,,Ұстаз!
Dialogue: 0,1:18:14.28,1:18:16.68,*Default,NTP,0000,0000,0000,,Қазір соғыс жарияланды
Dialogue: 0,1:18:18.12,1:18:21.21,*Default,NTP,0000,0000,0000,,Бірінші соқтығыс жақын арада Цугару жағалауында болады.
Dialogue: 0,1:20:34.92,1:20:35.52,*Default,NTP,0000,0000,0000,,Жер!
Dialogue: 0,1:22:04.48,1:22:05.31,*Default,NTP,0000,0000,0000,,Эй
Dialogue: 0,1:22:05.41,1:22:06.61,*Default,NTP,0000,0000,0000,,Саюри
Dialogue: 0,1:22:07.18,1:22:09.01,*Default,NTP,0000,0000,0000,,Бұл уәде етілген жер.
Dialogue: 0,1:22:10.75,1:22:12.48,*Default,NTP,0000,0000,0000,,...Сол қанаттар
Dialogue: 0,1:22:12.92,1:22:14.39,*Default,NTP,0000,0000,0000,,Верацилла…
Dialogue: 0,1:22:15.62,1:22:16.92,*Default,NTP,0000,0000,0000,,А...
Dialogue: 0,1:22:17.36,1:22:19.49,*Default,NTP,0000,0000,0000,,Армандар жоғалып барады...
Dialogue: 0,1:22:25.63,1:22:27.69,*Default,NTP,0000,0000,0000,,Тек сол жерде тұрып ұйықтап жат.
Dialogue: 0,1:22:28.64,1:22:32.90,*Default,NTP,0000,0000,0000,,Мен енді неден ұтылатынымды білемін.
Dialogue: 0,1:22:33.58,1:22:34.91,*Default,NTP,0000,0000,0000,,…Құдай
Dialogue: 0,1:22:35.01,1:22:36.94,*Default,NTP,0000,0000,0000,,ҚұдайӨтінемін
Dialogue: 0,1:22:37.15,1:22:40.91,*Default,NTP,0000,0000,0000,,Саюриді ұйқысынан оятуыңызды өтінемін.
Dialogue: 0,1:22:41.32,1:22:42.44,*Default,NTP,0000,0000,0000,,Өтінемін
Dialogue: 0,1:22:43.15,1:22:44.38,*Default,NTP,0000,0000,0000,,Ниндзялар Эдо дәуірінде жойылып кеткен жоқ па?
Dialogue: 0,1:22:44.49,1:22:46.85,*Default,NTP,0000,0000,0000,,Оянғаннан кейін бір сәтке болса да, бәрібір.
Dialogue: 0,1:22:46.96,1:22:49.58,*Default,NTP,0000,0000,0000,,Ағымдағы сезімдеріңізді өшірмеңіз.
Dialogue: 0,1:22:50.23,1:22:52.96,*Default,NTP,0000,0000,0000,,Хироки-кунға айтуым керек.
Dialogue: 0,1:22:53.50,1:22:59.26,*Default,NTP,0000,0000,0000,,Біздің түсіміздегі эмоционалды байланыс қаншалықты ерекше болды?
Dialogue: 0,1:22:59.87,1:23:01.70,*Default,NTP,0000,0000,0000,,Ешкім жоқ әлемде
Dialogue: 0,1:23:01.80,1:23:04.97,*Default,NTP,0000,0000,0000,,Хироки-кунды қанша қаласам да,
Dialogue: 0,1:23:05.17,1:23:07.97,*Default,NTP,0000,0000,0000,,Хироки-кун мені қалай қатты қалады
Dialogue: 0,1:23:10.38,1:23:11.64,*Default,NTP,0000,0000,0000,,Саюри
Dialogue: 0,1:23:11.98,1:23:13.47,*Default,NTP,0000,0000,0000,,Өтінемін...!
Dialogue: 0,1:23:14.15,1:23:15.64,*Default,NTP,0000,0000,0000,,Мен әрқашан
Dialogue: 0,1:23:15.75,1:23:18.69,*Default,NTP,0000,0000,0000,,Хироки-кунды қаншалықты жақсы көрдім.
Dialogue: 0,1:23:18.92,1:23:21.69,*Default,NTP,0000,0000,0000,,Соны айта алсам ғой
Dialogue: 0,1:23:21.79,1:23:24.69,*Default,NTP,0000,0000,0000,,Маған басқа ештеңе керек емес
Dialogue: 0,1:23:24.96,1:23:27.55,*Default,NTP,0000,0000,0000,,Бір сәтке өтінемін
Dialogue: 0,1:23:28.53,1:23:30.26,*Default,NTP,0000,0000,0000,,Бұл сезім...!
Dialogue: 0,1:23:54.76,1:23:56.02,*Default,NTP,0000,0000,0000,,Саюри…
Dialogue: 0,1:24:01.10,1:24:02.86,*Default,NTP,0000,0000,0000,,Фудзисава-кун…
Dialogue: 0,1:24:06.27,1:24:08.83,*Default,NTP,0000,0000,0000,,Әртүрлі фазалық түрлендіруЖылдам кеңеюде!
Dialogue: 0,1:24:09.21,1:24:11.50,*Default,NTP,0000,0000,0000,,Эзо жұтылады!
Dialogue: 0,1:24:30.23,1:24:31.45,*Default,NTP,0000,0000,0000,,Саюри…
Dialogue: 0,1:24:36.57,1:24:37.73,*Default,NTP,0000,0000,0000,,Мен...
Dialogue: 0,1:24:40.07,1:24:43.47,*Default,NTP,0000,0000,0000,,МенСаған бірдеңе айтуым керек
Dialogue: 0,1:24:43.91,1:24:46.07,*Default,NTP,0000,0000,0000,,Өте маңызды...
Dialogue: 0,1:24:47.54,1:24:49.31,*Default,NTP,0000,0000,0000,,...Ол жоғалып кетті...!
Dialogue: 0,1:25:01.46,1:25:02.75,*Default,NTP,0000,0000,0000,,...Жарайды.
Dialogue: 0,1:25:03.33,1:25:05.05,*Default,NTP,0000,0000,0000,,Себебі мен ояндым
Dialogue: 0,1:25:05.69,1:25:08.25,*Default,NTP,0000,0000,0000,,Бұдан былай барлығы қайтадан...
Dialogue: 0,1:25:14.20,1:25:15.60,*Default,NTP,0000,0000,0000,,Қайтадан қош келдіңіз
Dialogue: 0,1:25:15.77,1:25:16.76,*Default,NTP,0000,0000,0000,,Саюри
Dialogue: 0,1:26:39.70,1:26:44.68,*Default,NTP,0000,0000,0000,,Уәде етілген орнын жоғалтқан әлемде әлі де...
Dialogue: 0,1:26:45.23,1:26:48.66,*Default,NTP,0000,0000,0000,,Бүгіннен бастап біз өмір сүре бастаймыз.
Dialogue: 0,1:25:50.62,1:25:56.89,Theme,NTP,0000,0000,0000,,Өшірілген көк түс
Dialogue: 0,1:25:56.99,1:26:03.41,Theme,NTP,0000,0000,0000,,Ақ бұлттар, сол алыс күннің түстері
Dialogue: 0,1:26:03.51,1:26:09.77,Theme,NTP,0000,0000,0000,,Ішіндегі кез келген адамға
Dialogue: 0,1:26:09.87,1:26:15.25,Theme,NTP,0000,0000,0000,,Жасырын ауырсыну
Dialogue: 0,1:26:16.20,1:26:21.21,Theme,NTP,0000,0000,0000,,Менде бар нәрсені жұмсадым
Dialogue: 0,1:26:22.44,1:26:27.74,Theme,NTP,0000,0000,0000,,Сөздер қазірдің өзінде алыс
Dialogue: 0,1:26:28.78,1:26:35.10,Theme,NTP,0000,0000,0000,,Қазір де, жеңілген күндерде
Dialogue: 0,1:26:35.21,1:26:45.36,Theme,NTP,0000,0000,0000,,Сіз мені жылытасыз
Dialogue: 0,1:26:48.35,1:26:54.36,Theme,NTP,0000,0000,0000,,Сіздің дауысыңыз
Dialogue: 0,1:26:54.46,1:27:00.85,Theme,NTP,0000,0000,0000,,Сіздің пішініңізді жарықтандырған жарық
Dialogue: 0,1:27:01.15,1:27:04.26,Theme,NTP,0000,0000,0000,,Егер ол орындалса
Dialogue: 0,1:27:04.36,1:27:10.24,Theme,NTP,0000,0000,0000,,Менің дауысым
Dialogue: 0,1:27:10.44,1:27:16.62,Theme,NTP,0000,0000,0000,,Бір жерге жетсін
Dialogue: 0,1:27:16.80,1:27:22.88,Theme,NTP,0000,0000,0000,,Мен өмір сүремін
Dialogue: 0,1:27:29.72,1:27:35.76,Theme,NTP,0000,0000,0000,,Күн күйген рельстерден
Dialogue: 0,1:27:36.07,1:27:42.32,Theme,NTP,0000,0000,0000,,Алыстағы сол күннің жаңғырық үні
Dialogue: 0,1:27:42.42,1:27:48.68,Theme,NTP,0000,0000,0000,,Сол бұлттардың арғы жағында, тіпті қазір де
Dialogue: 0,1:27:48.78,1:27:53.75,Theme,NTP,0000,0000,0000,,Уәденің орны бар.
Dialogue: 0,1:27:55.18,1:27:59.88,Theme,NTP,0000,0000,0000,,Мен қашаннан бері жалғызбын?
Dialogue: 0,1:28:01.60,1:28:06.36,Theme,NTP,0000,0000,0000,,Қорап сықырлаған жүрек
Dialogue: 0,1:28:07.93,1:28:14.23,Theme,NTP,0000,0000,0000,,Уақыт өтеріне сенімдімін
Dialogue: 0,1:28:14.41,1:28:24.14,Theme,NTP,0000,0000,0000,,Мен сені жоғалтып жатырмын
Dialogue: 0,1:28:27.56,1:28:33.46,Theme,NTP,0000,0000,0000,,Сіздің шашыңыз
Dialogue: 0,1:28:33.56,1:28:39.76,Theme,NTP,0000,0000,0000,,Аспан мен бұлт: тарақ әлем
Dialogue: 0,1:28:40.01,1:28:43.39,Theme,NTP,0000,0000,0000,,Құпияға толы
Dialogue: 0,1:28:43.49,1:28:49.42,Theme,NTP,0000,0000,0000,,Сіздің дауысыңыз
Dialogue: 0,1:28:49.52,1:28:55.85,Theme,NTP,0000,0000,0000,,Саусақтары жұмсақ, терісі желді
Dialogue: 0,1:28:56.00,1:29:02.15,Theme,NTP,0000,0000,0000,,Ойыңызды шыңдаңыз
Dialogue: 0,1:29:09.27,1:29:15.08,Theme,NTP,0000,0000,0000,,Сіздің дауысыңыз
Dialogue: 0,1:29:15.28,1:29:21.80,Theme,NTP,0000,0000,0000,,Түріңді нұрландырған нұр
Dialogue: 0,1:29:21.90,1:29:24.97,Theme,NTP,0000,0000,0000,,Егер ол орындалса
Dialogue: 0,1:29:25.07,1:29:31.01,Theme,NTP,0000,0000,0000,,Тұратын жер
Dialogue: 0,1:29:31.21,1:29:37.50,Theme,NTP,0000,0000,0000,,Әртүрлі, бірақ мейірімді және күшті
Dialogue: 0,1:29:37.60,1:29:45.21,Theme,NTP,0000,0000,0000,,Мен өмір сүргім келеді
Dialogue: 0,1:29:46.71,1:29:52.71,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
