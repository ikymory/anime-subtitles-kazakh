Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.04,0:00:15.06,Default,,0,0,0,,♪♪~ «Жаяу жүру»
Dialogue: 0,0:00:15.06,0:00:30.96,Default,,0,0,0,,♪♪~
Dialogue: 0,0:00:30.96,0:00:34.98,Default,,0,0,0,,♪♪～ Аруку Аруку
Dialogue: 0,0:00:34.98,0:00:39.03,Default,,0,0,0,,♪♪~ Менде бәрі жақсы
Dialogue: 0,0:00:39.03,0:00:42.97,Default,,0,0,0,,♪♪～ Мен Аркуноны жақсы көремін
Dialogue: 0,0:00:42.97,0:00:46.99,Default,,0,0,0,,♪♪~ Әрі қарай жүрейік
Dialogue: 0,0:00:46.99,0:00:50.98,Default,,0,0,0,,♪♪~ Сакамичи туннелі
Dialogue: 0,0:00:50.98,0:00:54.97,Default,,0,0,0,,♪♪～ Құсаппара
Dialogue: 0,0:00:54.97,0:00:58.50,Default,,0,0,0,,♪♪～ Ipponbashi ni
Dialogue: 0,0:00:58.50,0:01:02.97,Default,,0,0,0,,♪♪~ Декобоко Джаримичи
Dialogue: 0,0:01:02.97,0:01:06.49,Default,,0,0,0,,♪♪~ Өрмекшілер арқылы өтіңіз
Dialogue: 0,0:01:06.49,0:01:10.98,Default,,0,0,0,,♪♪～ Кударимичи
Dialogue: 0,0:01:10.98,0:01:19.02,Default,,0,0,0,,♪♪~
Dialogue: 0,0:01:19.02,0:01:22.99,Default,,0,0,0,,♪♪～ Аруку Аруку
Dialogue: 0,0:01:22.99,0:01:26.98,Default,,0,0,0,,♪♪~ Менде бәрі жақсы
Dialogue: 0,0:01:26.98,0:01:30.97,Default,,0,0,0,,♪♪~ Мен Аркуноны жақсы көремін
Dialogue: 0,0:01:30.97,0:01:34.99,Default,,0,0,0,,♪♪~ Әрі қарай жүрейік
Dialogue: 0,0:01:34.99,0:01:39.04,Default,,0,0,0,,♪♪～ Түлкі мен енот та
Dialogue: 0,0:01:39.04,0:01:42.96,Default,,0,0,0,,♪♪～ Шық.
Dialogue: 0,0:01:42.96,0:01:46.48,Default,,0,0,0,,♪♪~ Біраз зерттеп көрейік
Dialogue: 0,0:01:46.48,0:01:50.97,Default,,0,0,0,,♪♪～ Хаяши но Окукуға дейін
Dialogue: 0,0:01:50.97,0:01:54.49,Default,,0,0,0,,♪♪～ Достар көп
Dialogue: 0,0:01:54.49,0:01:59.01,Default,,0,0,0,,♪♪~ Мен бақыттымын.
Dialogue: 0,0:01:59.01,0:02:02.47,Default,,0,0,0,,♪♪～ Достар көп
Dialogue: 0,0:02:02.47,0:02:09.49,Default,,0,0,0,,♪♪~ Мен бақыттымын.
Dialogue: 0,0:02:09.49,0:02:11.49,Default,,0,0,0,,♪♪~
Dialogue: 0,0:02:32.00,0:02:33.96,Default,,0,0,0,,Әкем Карамель.
Dialogue: 0,0:02:33.96,0:02:36.97,Default,,0,0,0,,Сәлем, рахмет. Шаршадыңыз ба?
Dialogue: 0,0:02:36.97,0:02:39.47,Default,,0,0,0,,Жоқ. Осы жерде.
Dialogue: 0,0:02:47.98,0:02:50.00,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:50.00,0:02:52.00,Default,,0,0,0,,Мамыр, жасырын!
Dialogue: 0,0:02:57.49,0:03:01.48,Default,,0,0,0,,Бұл полиция қызметкері емес еді!
Dialogue: 0,0:03:01.48,0:03:31.99,Default,,0,0,0,,♪♪~
Dialogue: 0,0:03:31.99,0:03:34.99,Default,,0,0,0,,Үйде біреу бар ма?
Dialogue: 0,0:03:36.49,0:03:38.49,Default,,0,0,0,,Сәлем.
Dialogue: 0,0:03:39.98,0:03:44.52,Default,,0,0,0,,Менің атым Құсақабе, мен жаңадан көшіп келдім!
Dialogue: 0,0:03:44.52,0:03:47.47,Default,,0,0,0,,Алдын ала рахмет.
Dialogue: 0,0:03:47.47,0:03:50.47,Default,,0,0,0,,Еңбегіңіз үшін рахмет!
Dialogue: 0,0:03:53.98,0:03:55.98,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:03:55.98,0:04:17.47,Default,,0,0,0,,♪♪~
Dialogue: 0,0:04:17.47,0:04:18.97,Default,,0,0,0,,Міне, келдік.
Dialogue: 0,0:04:18.97,0:04:21.97,Default,,0,0,0,,Уау! асылу!
Dialogue: 0,0:04:21.97,0:04:23.47,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:04:24.51,0:04:27.51,Default,,0,0,0,,Мамыр Көпір бар. көпір?
Dialogue: 0,0:04:32.47,0:04:34.99,Default,,0,0,0,,Балық! Қараңызшы, ол қайтадан жарқырайды.
Dialogue: 0,0:04:34.99,0:04:37.49,Default,,0,0,0,,Сізге қалай ұнайды?
Dialogue: 0,0:04:39.49,0:04:41.98,Default,,0,0,0,,Әке, сіз кереметсіз!
Dialogue: 0,0:04:41.98,0:04:43.98,Default,,0,0,0,,Ағаш туннелі!
Dialogue: 0,0:04:46.48,0:04:49.03,Default,,0,0,0,,Ах! Сол үй?
Dialogue: 0,0:04:49.03,0:04:50.53,Default,,0,0,0,,Уау! Ахаха!
Dialogue: 0,0:04:52.47,0:04:54.49,Default,,0,0,0,,Иә, Юта Отокоцу
Dialogue: 0,0:04:54.49,0:05:07.00,Default,,0,0,0,,♪♪~
Dialogue: 0,0:05:07.00,0:05:10.57,Default,,0,0,0,,Уау! Боро! Боро!
Dialogue: 0,0:05:10.57,0:05:13.47,Default,,0,0,0,,Аруақ үйіне ұқсайды! Елес пе?
Dialogue: 0,0:05:13.47,0:05:15.47,Default,,0,0,0,,Ахаха….
Dialogue: 0,0:05:20.46,0:05:22.46,Default,,0,0,0,,Ол шірік.
Dialogue: 0,0:05:25.49,0:05:27.99,Default,,0,0,0,,Ахахха. Хахахаха.
Dialogue: 0,0:05:30.54,0:05:33.96,Default,,0,0,0,,Уау!? Ахахха.
Dialogue: 0,0:05:33.96,0:05:37.96,Default,,0,0,0,,Ол бұзылады! Ол бұзылады!
Dialogue: 0,0:05:47.47,0:05:49.97,Default,,0,0,0,,Қарауға болады. Иә?
Dialogue: 0,0:05:51.55,0:05:53.05,Default,,0,0,0,,Қара!
Dialogue: 0,0:06:01.47,0:06:04.97,Default,,0,0,0,,Бұл үлкен. Хакшун.
Dialogue: 0,0:06:08.98,0:06:11.98,Default,,0,0,0,,Әке, қандай керемет ағаш!
Dialogue: 0,0:06:11.98,0:06:14.48,Default,,0,0,0,,А, бұл камфора ағашы.
Dialogue: 0,0:06:16.54,0:06:19.04,Default,,0,0,0,,Камфора ағашы! Камфора ағашы!
Dialogue: 0,0:06:21.98,0:06:23.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:27.50,0:06:29.00,Default,,0,0,0,,Бұл бітсе, бірдеңе жейміз бе? Егер қаласаң, көңіліңді көтерейін.
Dialogue: 0,0:06:30.97,0:06:32.47,Default,,0,0,0,,Желу.
Dialogue: 0,0:06:33.97,0:06:37.01,Default,,0,0,0,,Уау, көрсетші!
Dialogue: 0,0:06:37.01,0:06:39.01,Default,,0,0,0,,Бір сәт... олардың сонша көп емес қой!
Dialogue: 0,0:06:44.46,0:06:46.48,Default,,0,0,0,,Міне болды!
Dialogue: 0,0:06:46.48,0:06:48.48,Default,,0,0,0,,Хмм?
Dialogue: 0,0:06:52.49,0:06:55.48,Default,,0,0,0,,Кола Кора... Жапқыштарды аша алмайсың ғой?
Dialogue: 0,0:06:55.48,0:06:59.00,Default,,0,0,0,,Желу! Бөлмеде желелер құлап жатыр.
Dialogue: 0,0:06:59.00,0:07:01.55,Default,,0,0,0,,Ол жоғарыдан құлады.
Dialogue: 0,0:07:01.55,0:07:03.55,Default,,0,0,0,,Хмм….
Dialogue: 0,0:07:04.99,0:07:08.47,Default,,0,0,0,,Тиіндер бар...бірақ бар ма?
Dialogue: 0,0:07:08.47,0:07:09.97,Default,,0,0,0,,Тиін!? Тиін!?
Dialogue: 0,0:07:10.99,0:07:13.48,Default,,0,0,0,,Әлде желекті жақсы көретін тышқан болуы мүмкін бе?
Dialogue: 0,0:07:13.48,0:07:15.98,Default,,0,0,0,,Е! Мэй Лис жақсы!
Dialogue: 0,0:07:15.98,0:07:18.50,Default,,0,0,0,,Мұны қайда апарасың?
Dialogue: 0,0:07:18.50,0:07:21.05,Default,,0,0,0,,О, мен оны қазір аша аламын.
Dialogue: 0,0:07:21.05,0:07:23.99,Default,,0,0,0,,Сатсуки Артқы есікті ашыңыз. Иә.
Dialogue: 0,0:07:23.99,0:07:26.49,Default,,0,0,0,,Барсаң түсінерсің. Иә.
Dialogue: 0,0:07:27.49,0:07:29.49,Default,,0,0,0,,Келіңіздер.
Dialogue: 0,0:07:30.49,0:07:32.49,Default,,0,0,0,,Күтіңіз~.
Dialogue: 0,0:07:33.50,0:07:35.50,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:07:48.50,0:07:50.00,Default,,0,0,0,,Капитан Магатоға не деп тұрсың!!
Dialogue: 0,0:08:05.06,0:08:08.56,Default,,0,0,0,,Уау!! Апыр-ай!!
Dialogue: 0,0:08:13.49,0:08:15.49,Default,,0,0,0,,Кеттік. Иә.
Dialogue: 0,0:08:26.98,0:08:28.98,Default,,0,0,0,,Ванна. Иә.
Dialogue: 0,0:08:33.97,0:08:36.47,Default,,0,0,0,,Онда жоқ. Иә.
Dialogue: 0,0:08:37.49,0:08:38.98,Default,,0,0,0,,Бұл ванна.
Dialogue: 0,0:08:38.98,0:08:41.98,Default,,0,0,0,,Әке, мұнда не болып жатыр? Бұл тиін ме?
Dialogue: 0,0:08:41.98,0:08:44.99,Default,,0,0,0,,Мен білмеймін. Бұл тарақан емес. Бұл егеуқұйрық емес.→
Dialogue: 0,0:08:44.99,0:08:48.49,Default,,0,0,0,,Қаралар көп болды. Хмм.
Dialogue: 0,0:08:59.48,0:09:00.98,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:09:02.49,0:09:04.97,Default,,0,0,0,,Бұл қара крест.
Dialogue: 0,0:09:04.97,0:09:07.49,Default,,0,0,0,,Қара түсті куросуке!? Ол суретті кітапта пайда болды ма?
Dialogue: 0,0:09:07.49,0:09:11.49,Default,,0,0,0,,Дұрыс, мұндай жақсы ауа-райында елестер пайда болуы мүмкін емес.
Dialogue: 0,0:09:16.03,0:09:18.99,Default,,0,0,0,,Кенеттен жарық жерден қараңғы жерге өткенде→
Dialogue: 0,0:09:18.99,0:09:21.97,Default,,0,0,0,,Менің көзім соқыр болып, қара крест пайда болады.
Dialogue: 0,0:09:21.97,0:09:23.47,Default,,0,0,0,,Оған сіздер, студенттер де кіресіздер.
Dialogue: 0,0:09:23.47,0:09:25.98,Default,,0,0,0,,♪~ Жетілген қара крест суке
Dialogue: 0,0:09:25.98,0:09:30.98,Default,,0,0,0,,♪~ Шық, әйтпесе көзіңнен жұдырықтаймын.
Dialogue: 0,0:09:32.48,0:09:35.54,Default,,0,0,0,,Хахаха! Хахаха!
Dialogue: 0,0:09:35.54,0:09:40.97,Default,,0,0,0,,Енді жұмыс істе, жұмыс! Екінші қабатқа баспалдақтар қай жерде?
Dialogue: 0,0:09:40.97,0:09:42.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:42.48,0:09:45.46,Default,,0,0,0,,Баспалдақты табыңыз және екінші қабаттағы терезені ашыңыз.
Dialogue: 0,0:09:45.46,0:09:47.96,Default,,0,0,0,,Иә. О, Мэй де!
Dialogue: 0,0:09:56.51,0:09:58.51,Default,,0,0,0,,Дәретхана!
Dialogue: 0,0:10:00.48,0:10:01.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:04.50,0:10:07.00,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:10:09.99,0:10:12.49,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:10:14.47,0:10:17.47,Default,,0,0,0,,Ой! иә?
Dialogue: 0,0:10:19.08,0:10:20.48,Default,,0,0,0,,Мен саған кір жудым.
Dialogue: 0,0:10:20.48,0:10:21.98,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:10:21.98,0:10:24.48,Default,,0,0,0,,Ей! Ол аурады.
Dialogue: 0,0:10:31.49,0:10:34.49,Default,,0,0,0,,Ах! Мэй Міне болды!
Dialogue: 0,0:10:40.97,0:10:44.47,Default,,0,0,0,,Бұл тас қараңғы. Қатты қара крест...
Dialogue: 0,0:10:52.50,0:10:54.00,Default,,0,0,0,,Желу.
Dialogue: 0,0:11:00.47,0:11:04.47,Default,,0,0,0,,♪~ Қара крестпен шығыңыз
Dialogue: 0,0:11:26.48,0:11:29.98,Default,,0,0,0,,Уау...! Апыр-ай…!
Dialogue: 0,0:11:43.50,0:11:47.48,Default,,0,0,0,,Куросуке-сан сонда ма?
Dialogue: 0,0:11:47.48,0:11:52.48,Default,,0,0,0,,♪♪~
Dialogue: 0,0:12:12.48,0:12:16.46,Default,,0,0,0,,Әке! Өйткені, бұл үйде бірдеңе бар!
Dialogue: 0,0:12:16.46,0:12:19.98,Default,,0,0,0,,Бұл керемет! Арулар үйінде тұру →
Dialogue: 0,0:12:19.98,0:12:23.00,Default,,0,0,0,,Бұл әкемнің бала кезімнен арманы.
Dialogue: 0,0:12:23.00,0:12:24.54,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:24.54,0:12:27.04,Default,,0,0,0,,А, бұл қиын!
Dialogue: 0,0:12:51.56,0:12:52.98,Default,,0,0,0,,♪♪~ Уау!!
Dialogue: 0,0:12:52.98,0:13:12.49,Default,,0,0,0,,♪♪~
Dialogue: 0,0:13:12.49,0:13:14.99,Default,,0,0,0,,Мен оны алдым! Үлкен әпке!
Dialogue: 0,0:13:22.98,0:13:24.48,Default,,0,0,0,,Уф!
Dialogue: 0,0:13:25.47,0:13:27.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:27.52,0:13:29.52,Default,,0,0,0,,Уау! мамыр.
Dialogue: 0,0:13:38.96,0:13:41.97,Default,,0,0,0,,Ахаха менде бәрі жақсы.
Dialogue: 0,0:13:41.97,0:13:44.97,Default,,0,0,0,,Бұл үйді басқаратын көрші әже.
Dialogue: 0,0:13:44.97,0:13:46.99,Default,,0,0,0,,Олар бізді қолдауға келді.
Dialogue: 0,0:13:46.99,0:13:50.97,Default,,0,0,0,,Сатсукиге: Сәлем, бұл менің кіші әпкем Мэй.
Dialogue: 0,0:13:50.97,0:13:56.08,Default,,0,0,0,,Иә, сәлем, сен ақылды бала сияқтысың.
Dialogue: 0,0:13:56.08,0:13:59.97,Default,,0,0,0,,Осыншама асығыс болмасам, үй шаруасымен айналысар едім.
Dialogue: 0,0:13:59.97,0:14:02.49,Default,,0,0,0,,Хахаха жетеді.
Dialogue: 0,0:14:02.49,0:14:05.49,Default,,0,0,0,,Бұл уақытта күріш алқаптары қызу.
Dialogue: 0,0:14:05.49,0:14:08.98,Default,,0,0,0,,Бірақ мен кейде үй жинамайтынмын.
Dialogue: 0,0:14:08.98,0:14:12.48,Default,,0,0,0,,Мэй: Менің қолым қара емес. Не болды?
Dialogue: 0,0:14:12.48,0:14:15.00,Default,,0,0,0,,Қара түсті Куросуке қашып кетті.
Dialogue: 0,0:14:15.00,0:14:17.05,Default,,0,0,0,,Әй, Мэйдің аяғы!
Dialogue: 0,0:14:17.05,0:14:19.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:20.49,0:14:23.49,Default,,0,0,0,,Ах~ Менікі де тас қараңғы.
Dialogue: 0,0:14:23.49,0:14:29.50,Default,,0,0,0,,Хуу... Жоқ, жоқ, жоқ, жоқ, жоқ.
Dialogue: 0,0:14:29.50,0:14:34.50,Default,,0,0,0,,Иә... Сонымен Сусватари пайда болды.
Dialogue: 0,0:14:34.50,0:14:37.05,Default,,0,0,0,,Сусватари? Сусватари →
Dialogue: 0,0:14:37.05,0:14:40.47,Default,,0,0,0,,Бұл сізді қыжылдайтын нәрсе ме?
Dialogue: 0,0:14:40.47,0:14:44.98,Default,,0,0,0,,Мен ешкім жоқ ескі үйдемін →
Dialogue: 0,0:14:44.98,0:14:49.47,Default,,0,0,0,,Әр жерді күйе басып, шаң басып қалады.
Dialogue: 0,0:14:49.47,0:14:52.99,Default,,0,0,0,,Кішкентай кезімде мен де көретінмін →
Dialogue: 0,0:14:52.99,0:14:57.04,Default,,0,0,0,,Түсіндім, сен де көрдің.
Dialogue: 0,0:14:57.04,0:14:59.58,Default,,0,0,0,,Бұл құбыжық па?
Dialogue: 0,0:14:59.58,0:15:03.48,Default,,0,0,0,,Сонда бұл соншалықты қорқынышты болмас еді.
Dialogue: 0,0:15:03.48,0:15:07.00,Default,,0,0,0,,Күлсең, жаман ештеңе болмайды→
Dialogue: 0,0:15:07.00,0:15:10.47,Default,,0,0,0,,Білмей тұрып, ұйқың келеді.
Dialogue: 0,0:15:10.47,0:15:14.97,Default,,0,0,0,,Менің ойымша, олар қазір шатырда көшу туралы айтып жатыр ма деп ойлаймын.
Dialogue: 0,0:15:20.55,0:15:23.50,Default,,0,0,0,,Мэй: Барлығы қашып жатыр. Бұл қызықсыз.
Dialogue: 0,0:15:23.50,0:15:26.50,Default,,0,0,0,,Өйткені осындай нәрсе шықса не істер едің?
Dialogue: 0,0:15:26.50,0:15:28.47,Default,,0,0,0,,Мэй Бұл қорқынышты емес.
Dialogue: 0,0:15:28.47,0:15:32.49,Default,,0,0,0,,Әй, түнде менімен бірге ваннаға келмейсің бе?
Dialogue: 0,0:15:32.49,0:15:39.55,Default,,0,0,0,,Ахахха... Жүр, жинап алайық. Өзеннен су алып кел.
Dialogue: 0,0:15:39.55,0:15:42.55,Default,,0,0,0,,Өзен жағасында? Мэй де барады!
Dialogue: 0,0:15:43.15,0:15:45.17,Default,,0,0,0,,Ахаха! Ахаха!
Dialogue: 0,0:15:45.17,0:15:47.67,Default,,0,0,0,,Мей, сонда күте тұр.
Dialogue: 0,0:15:56.68,0:15:58.68,Default,,0,0,0,,Сіз балық ұстадыңыз ба?
Dialogue: 0,0:16:10.16,0:16:12.68,Default,,0,0,0,,Әже осында!
Dialogue: 0,0:16:12.68,0:16:17.65,Default,,0,0,0,,Су салқындағанша.
Dialogue: 0,0:16:17.65,0:16:19.15,Default,,0,0,0,,Иә.
Dialogue: 0,0:16:19.15,0:16:44.18,Default,,0,0,0,,♪♪~
Dialogue: 0,0:17:00.68,0:17:04.70,Default,,0,0,0,,А, жай... не? Бірдеңе керек пе?
Dialogue: 0,0:17:04.70,0:17:08.70,Default,,0,0,0,,Немесе... анам менің әжем болды...
Dialogue: 0,0:17:09.67,0:17:11.17,Default,,0,0,0,,Не?
Dialogue: 0,0:17:13.67,0:17:15.68,Default,,0,0,0,,Жоқ! сурет?
Dialogue: 0,0:17:15.68,0:17:17.66,Default,,0,0,0,,Иә! а….
Dialogue: 0,0:17:17.66,0:17:19.66,Default,,0,0,0,,Күте тұрыңыз! Бұл не?
Dialogue: 0,0:17:19.66,0:17:21.66,Default,,0,0,0,,Канта?
Dialogue: 0,0:17:23.68,0:17:29.17,Default,,0,0,0,,Ия, сенің үйің арулар үйі!
Dialogue: 0,0:17:29.17,0:17:31.17,Default,,0,0,0,,Канта~!!
Dialogue: 0,0:17:33.16,0:17:35.16,Default,,0,0,0,,Бае~!
Dialogue: 0,0:17:38.18,0:17:43.19,Default,,0,0,0,,Ахахаха әкемнің де есінде.
Dialogue: 0,0:17:43.19,0:17:45.22,Default,,0,0,0,,Мен ұлдарды жек көремін!
Dialogue: 0,0:17:45.22,0:17:49.16,Default,,0,0,0,,Бірақ маған әжемнің охаги қатты ұнайды!
Dialogue: 0,0:17:49.16,0:17:51.68,Default,,0,0,0,,Танто Оагари.
Dialogue: 0,0:17:51.68,0:17:53.68,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:17:56.18,0:17:59.19,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:17:59.19,0:18:02.17,Default,,0,0,0,,Қош бол. Қош бол.
Dialogue: 0,0:18:02.17,0:18:24.17,Default,,0,0,0,,♪♪~
Dialogue: 0,0:18:36.96,0:18:39.48,Default,,0,0,0,,Уау!!
Dialogue: 0,0:18:39.48,0:19:03.96,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:19:16.53,0:19:19.47,Default,,0,0,0,,Әкесі: Үй апатты, сондықтан құлап қалады.
Dialogue: 0,0:19:19.47,0:19:24.49,Default,,0,0,0,,Хахаха Көшкеннен кейін компания банкрот болса, ұят болар еді.
Dialogue: 0,0:19:24.49,0:19:26.49,Default,,0,0,0,,(шу)
Dialogue: 0,0:19:44.46,0:19:46.96,Default,,0,0,0,,(Үкідің ұлуы)
Dialogue: 0,0:19:46.96,0:19:48.46,Default,,0,0,0,,Ха!
Dialogue: 0,0:19:55.47,0:19:59.49,Default,,0,0,0,,Хахаха!
Dialogue: 0,0:19:59.49,0:20:03.06,Default,,0,0,0,,Барлығыңыз күліп көріңіздер, өйткені қорқыныштылар қашып кетеді.
Dialogue: 0,0:20:03.06,0:20:04.96,Default,,0,0,0,,Хахаха!
Dialogue: 0,0:20:04.96,0:20:07.95,Default,,0,0,0,,Мэй Бұл қорқынышты емес. Хахахаха!
Dialogue: 0,0:20:07.95,0:20:10.47,Default,,0,0,0,,Бұл қорқынышты емес!
Dialogue: 0,0:20:10.47,0:20:12.97,Default,,0,0,0,,Кя~! Ахахха!
Dialogue: 0,0:20:12.97,0:20:16.47,Default,,0,0,0,,Гау!
Dialogue: 0,0:20:16.47,0:20:52.96,Default,,0,0,0,,♪♪~
Dialogue: 0,0:20:53.96,0:20:56.96,Default,,0,0,0,,Ичи Ни Ичи Ни Ичи Ни….
Dialogue: 0,0:20:56.96,0:21:00.96,Default,,0,0,0,,Жолың болсын, жолың болсын, жолың болсын! Ичи ни ичи ни….
Dialogue: 0,0:21:05.97,0:21:08.46,Default,,0,0,0,,Жарайды, кір жуылды.
Dialogue: 0,0:21:08.46,0:21:10.46,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:21:18.49,0:21:20.49,Default,,0,0,0,,Кету!
Dialogue: 0,0:21:20.49,0:21:23.54,Default,,0,0,0,,♪♪~
Dialogue: 0,0:21:23.54,0:21:27.96,Default,,0,0,0,,♪♪~ О~о... Ах~!
Dialogue: 0,0:21:27.96,0:21:36.95,Default,,0,0,0,,♪♪~
Dialogue: 0,0:21:36.95,0:21:39.96,Default,,0,0,0,,≪Әже! ≫
Dialogue: 0,0:21:39.96,0:21:44.51,Default,,0,0,0,,Сәлеметсіз бе! Сіздің энергияңыз ағып жатыр.
Dialogue: 0,0:21:44.51,0:21:47.46,Default,,0,0,0,,Бірге шығайық!
Dialogue: 0,0:21:47.46,0:21:50.47,Default,,0,0,0,,Мен анама қонаққа барамын!
Dialogue: 0,0:21:50.47,0:21:55.47,Default,,0,0,0,,Бұл тамаша. Сәлем айтыңыз.
Dialogue: 0,0:21:55.47,0:21:56.97,Default,,0,0,0,,Иә.
Dialogue: 0,0:21:57.96,0:22:00.96,Default,,0,0,0,,Бае~!
Dialogue: 0,0:22:00.96,0:22:12.96,Default,,0,0,0,,♪♪~
Dialogue: 0,0:22:12.96,0:22:14.98,Default,,0,0,0,,♪♪~ Ах~ Міне, міне.
Dialogue: 0,0:22:14.98,0:22:35.47,Default,,0,0,0,,♪♪~
Dialogue: 0,0:22:42.24,0:22:44.21,Default,,0,0,0,,Сәлеметсіз бе. Қош келдіңіз.
Dialogue: 0,0:22:44.21,0:22:46.22,Default,,0,0,0,,Қандай азап…
Dialogue: 0,0:22:46.22,0:22:49.73,Default,,0,0,0,,Анашым!! (Анашым) Мей сен жиі келдің.
Dialogue: 0,0:22:49.73,0:22:52.23,Default,,0,0,0,,Әке мен бұрыс бұрылдым.
Dialogue: 0,0:22:52.65,0:22:55.19,Default,,0,0,0,,Иә... Қош келдіңіз.
Dialogue: 0,0:22:55.19,0:22:58.64,Default,,0,0,0,,Бүгін күріш егуден демалыс күні. А, түсіндім.
Dialogue: 0,0:22:58.64,0:23:03.66,Default,,0,0,0,,Әке Мен мұғаліммен сөйлесіп тұрмын. Барлығының келгеніне қуаныштымын.
Dialogue: 0,0:23:03.66,0:23:07.16,Default,,0,0,0,,Жаңа үйіңіз туралы не ойлайсыз? Сіз әлі тынышталдыңыз ба?
Dialogue: 0,0:23:09.65,0:23:11.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:12.17,0:23:15.24,Default,,0,0,0,,Не? Аруақты үй!? Иә.
Dialogue: 0,0:23:15.24,0:23:17.16,Default,,0,0,0,,Анашым, сізге елес үйлер ұнайды ма?
Dialogue: 0,0:23:17.16,0:23:20.63,Default,,0,0,0,,Әрине! Тезірек ауруханадан шығып, елестерді көргім келеді.
Dialogue: 0,0:23:20.63,0:23:23.13,Default,,0,0,0,,Жарайсың, Мамыр. Иә.
Dialogue: 0,0:23:23.13,0:23:26.63,Default,,0,0,0,,Анам ұнатпаса, қиналып қаламын ба деп уайымдадым.
Dialogue: 0,0:23:26.63,0:23:29.12,Default,,0,0,0,,Сатсуки мен Мэй ше? ұнайды!
Dialogue: 0,0:23:29.12,0:23:31.17,Default,,0,0,0,,Мен қорықпаймын.
Dialogue: 0,0:23:31.17,0:23:36.14,Default,,0,0,0,,Уфуфуфу Сатсуки Мэйдің шашын байлап жатыр ма?
Dialogue: 0,0:23:36.14,0:23:40.13,Default,,0,0,0,,Иә. Сен жақсысың... Жақсы, Мэй.
Dialogue: 0,0:23:40.13,0:23:43.13,Default,,0,0,0,,Иә... Бірақ апам тез ашуланады.
Dialogue: 0,0:23:43.13,0:23:45.15,Default,,0,0,0,,Өйткені Мэй тыныш болмайды.
Dialogue: 0,0:23:45.15,0:23:47.64,Default,,0,0,0,,Сатсуки, жүр.
Dialogue: 0,0:23:47.64,0:23:51.17,Default,,0,0,0,,Бұл тым қысқа емес пе? Маған бұл көбірек ұнайды.
Dialogue: 0,0:23:51.17,0:23:54.63,Default,,0,0,0,,Мэй де! Мен де! тапсырыс!
Dialogue: 0,0:23:54.63,0:23:59.13,Default,,0,0,0,,Менің бала кезімдегідей шашыңыз әлі бұйра.
Dialogue: 0,0:23:59.13,0:24:03.62,Default,,0,0,0,,Мен өскенде шашым анамдікіндей бола ма?
Dialogue: 0,0:24:03.62,0:24:07.64,Default,,0,0,0,,Анаңа ұқсайтындықтан шығар.
Dialogue: 0,0:24:07.64,0:24:25.14,Default,,0,0,0,,♪♪~
Dialogue: 0,0:24:25.14,0:24:28.65,Default,,0,0,0,,Анашым, сіздің жағдайыңыз жақсы сияқты. Аа, дұрыс.
Dialogue: 0,0:24:28.65,0:24:31.65,Default,,0,0,0,,Дәрігер де жақын арада ауруханадан шыға алатынымды айтты.
Dialogue: 0,0:24:31.65,0:24:33.63,Default,,0,0,0,,Ертең тағы да?
Dialogue: 0,0:24:33.63,0:24:38.22,Default,,0,0,0,,Мэйдің «ертеңі» қайтадан басталды. Ертең біраз мүмкін емес.
Dialogue: 0,0:24:38.22,0:24:41.64,Default,,0,0,0,,Анасы футонында Мэймен ұйықтағысы келеді.
Dialogue: 0,0:24:41.64,0:24:45.63,Default,,0,0,0,,Иә? Енді Мэй қартайған соң, жалғыз ұйықтап жатқан жоқ па?
Dialogue: 0,0:24:45.63,0:24:47.63,Default,,0,0,0,,Анаң жақсы ма!!
Dialogue: 0,0:24:47.63,0:24:49.63,Default,,0,0,0,,Хахаха. Ахахха.
Dialogue: 0,0:24:56.69,0:25:09.64,Default,,0,0,0,,♪♪~
Dialogue: 0,0:25:09.64,0:25:13.64,Default,,0,0,0,,Әке! Таң атты!
Dialogue: 0,0:25:15.63,0:25:19.13,Default,,0,0,0,,Ей! Оян!!
Dialogue: 0,0:25:24.64,0:25:28.66,Default,,0,0,0,,Кешіріңіз, мен тағы ұйықтап қалдым. Бүгіннен бастап мен түскі ас ішемін.
Dialogue: 0,0:25:28.66,0:25:31.14,Default,,0,0,0,,Мен оны мүлдем ұмытып кеттім.
Dialogue: 0,0:25:31.14,0:25:33.63,Default,,0,0,0,,Жарайды, мен де бәріне жасап беремін.
Dialogue: 0,0:25:33.63,0:25:36.13,Default,,0,0,0,,Өртеніп кетті! асылу.
Dialogue: 0,0:25:38.32,0:25:41.39,Default,,0,0,0,,Бұл мамыр айы.
Dialogue: 0,0:25:41.39,0:25:45.27,Default,,0,0,0,,Мэйдің!? Мэй, отыр да тамақ іш.
Dialogue: 0,0:25:45.27,0:25:46.77,Default,,0,0,0,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:25:46.77,0:25:48.77,Default,,0,0,0,,Оны өзіңіз ораңыз.
Dialogue: 0,0:25:52.30,0:25:55.30,Default,,0,0,0,,Са-цуки-чан!
Dialogue: 0,0:25:55.30,0:25:59.80,Default,,0,0,0,,О, бұл қиын! Иә!
Dialogue: 0,0:26:00.82,0:26:05.29,Default,,0,0,0,,Сіз әлі достар таптыңыз ба? «Са-цуки-чан».
Dialogue: 0,0:26:05.29,0:26:07.29,Default,,0,0,0,,Иә, менің атым Миччан.
Dialogue: 0,0:26:09.28,0:26:10.78,Default,,0,0,0,,Тамақ бергеніңіз үшін рахмет.
Dialogue: 0,0:26:11.80,0:26:13.78,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:26:13.78,0:26:16.28,Default,,0,0,0,,Қош келдіңіз. Келіңіздер.
Dialogue: 0,0:26:17.29,0:26:20.79,Default,,0,0,0,,Қайырлы таң. Қайырлы таң, ерте барайық.
Dialogue: 0,0:26:30.28,0:26:32.80,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:26:32.80,0:26:35.29,Default,,0,0,0,,Әке.
Dialogue: 0,0:26:35.29,0:26:37.79,Default,,0,0,0,,Май, сен үлкен апаға ұқсайсың ба?
Dialogue: 0,0:26:37.79,0:26:41.79,Default,,0,0,0,,Иә, түскі ас қорабыммен қайда баруым керек? Біраз ғана сонда.
Dialogue: 0,0:27:03.80,0:27:08.80,Default,,0,0,0,,Әке, түскі асыңызды жинадыңыз ба? иә? Қазірдің өзінде?
Dialogue: 0,0:27:20.30,0:27:23.30,Default,,0,0,0,,Әкесі: Ол гүл сататын дүкен.
Dialogue: 0,0:27:39.29,0:27:41.29,Default,,0,0,0,,Ожама такси!
Dialogue: 0,0:27:41.29,0:27:58.27,Default,,0,0,0,,♪♪~
Dialogue: 0,0:27:58.27,0:28:02.29,Default,,0,0,0,,Ах! Бұл... ең түбі!
Dialogue: 0,0:28:02.29,0:28:04.28,Default,,0,0,0,,Ах!
Dialogue: 0,0:28:04.28,0:28:14.84,Default,,0,0,0,,♪♪~
Dialogue: 0,0:28:14.84,0:28:17.39,Default,,0,0,0,,♪♪~ Микке!
Dialogue: 0,0:28:17.39,0:28:21.30,Default,,0,0,0,,♪♪~ Ах! Ах!
Dialogue: 0,0:28:21.30,0:28:31.79,Default,,0,0,0,,♪♪~
Dialogue: 0,0:28:31.79,0:28:34.27,Default,,0,0,0,,♪♪~ Уау….
Dialogue: 0,0:28:34.27,0:28:51.79,Default,,0,0,0,,♪♪~
Dialogue: 0,0:28:51.79,0:28:53.78,Default,,0,0,0,,♪♪~ Уу хи хи....
Dialogue: 0,0:28:53.78,0:29:07.79,Default,,0,0,0,,♪♪~
Dialogue: 0,0:29:07.79,0:29:09.29,Default,,0,0,0,,​​О?
Dialogue: 0,0:29:16.28,0:29:17.78,Default,,0,0,0,,Ах!
Dialogue: 0,0:29:17.78,0:29:29.78,Default,,0,0,0,,♪♪~
Dialogue: 0,0:29:34.28,0:29:35.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:44.78,0:29:46.28,Default,,0,0,0,,Қандай азап…
Dialogue: 0,0:30:25.79,0:30:27.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:27.80,0:30:30.29,Default,,0,0,0,,♪♪~
Dialogue: 0,0:30:30.29,0:30:31.79,Default,,0,0,0,,♪♪~ Ах~!
Dialogue: 0,0:30:31.79,0:30:38.82,Default,,0,0,0,,♪♪~
Dialogue: 0,0:30:38.82,0:30:40.35,Default,,0,0,0,,♪♪~ Уау!
Dialogue: 0,0:30:40.35,0:30:47.79,Default,,0,0,0,,♪♪~
Dialogue: 0,0:30:47.79,0:30:49.28,Default,,0,0,0,,♪♪~ Ах~!
Dialogue: 0,0:30:49.28,0:31:26.80,Default,,0,0,0,,♪♪~
Dialogue: 0,0:31:29.36,0:31:30.86,Default,,0,0,0,,Ах.
Dialogue: 0,0:31:39.35,0:31:41.35,Default,,0,0,0,,Ах!
Dialogue: 0,0:32:19.86,0:32:21.36,Default,,0,0,0,,Ах!
Dialogue: 0,0:32:22.86,0:32:24.86,Default,,0,0,0,,Ахаха!
Dialogue: 0,0:32:26.37,0:32:27.87,Default,,0,0,0,,Хэхехе.
Dialogue: 0,0:32:28.85,0:32:30.85,Default,,0,0,0,,Кя!
Dialogue: 0,0:32:31.86,0:32:34.86,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:32:41.37,0:32:43.37,Default,,0,0,0,,Э? Естімеймін.
Dialogue: 0,0:32:57.42,0:33:01.92,Default,,0,0,0,,Гво~….
Dialogue: 0,0:33:04.39,0:33:05.89,Default,,0,0,0,,Уау.
Dialogue: 0,0:33:12.36,0:33:16.87,Default,,0,0,0,,Гво~….
Dialogue: 0,0:33:16.87,0:33:18.87,Default,,0,0,0,,Аха!
Dialogue: 0,0:33:25.86,0:33:28.86,Default,,0,0,0,,Тағзым~!!
Dialogue: 0,0:33:52.87,0:33:56.89,Default,,0,0,0,,Сіз кімсіз? Қара крест ске?
Dialogue: 0,0:33:56.89,0:34:06.89,Default,,0,0,0,,Кімге... Кімге... Ро~!
Dialogue: 0,0:34:07.87,0:34:12.87,Default,,0,0,0,,Гваа!!
Dialogue: 0,0:34:15.88,0:34:22.88,Default,,0,0,0,,Кімге... Кімге... Ро~!
Dialogue: 0,0:34:24.42,0:34:28.42,Default,,0,0,0,,Тоторо!! Сенің атың Тоторо!
Dialogue: 0,0:34:32.38,0:34:34.88,Default,,0,0,0,,Бұл Тоторо ғой.
Dialogue: 0,0:34:36.88,0:34:38.88,Default,,0,0,0,,Тоторо.
Dialogue: 0,0:35:03.37,0:35:46.87,Default,,0,0,0,,♪♪~
Dialogue: 0,0:35:46.87,0:35:49.37,Default,,0,0,0,,Сонда кездескенше. Кейінірек кездесеміз.
Dialogue: 0,0:35:50.86,0:35:52.87,Default,,0,0,0,,Дәл қазір. Қайтадан қош келдіңіз.
Dialogue: 0,0:35:52.87,0:35:56.86,Default,,0,0,0,,Аа, бұл қазірдің өзінде ұзақ. Мэй ше? Мен Мичканның үйіне бара жатырмын.
Dialogue: 0,0:35:56.86,0:36:00.43,Default,,0,0,0,,Мен түскі асымды әлі ішкен жоқпын. Мэй, сіз бақшада ойнағыңыз келе ме?
Dialogue: 0,0:36:00.43,0:36:04.43,Default,,0,0,0,,мамыр! мамыр!
Dialogue: 0,0:36:05.39,0:36:07.39,Default,,0,0,0,,мамыр!
Dialogue: 0,0:36:09.37,0:36:11.37,Default,,0,0,0,,мамыр!
Dialogue: 0,0:36:17.38,0:36:21.38,Default,,0,0,0,,Әке! Майдың қалпағы болды!
Dialogue: 0,0:36:31.36,0:36:32.86,Default,,0,0,0,,Ах.
Dialogue: 0,0:36:36.37,0:36:38.37,Default,,0,0,0,,Мамыр... мамыр.
Dialogue: 0,0:36:45.41,0:36:48.98,Default,,0,0,0,,мамыр! Эй, оян!
Dialogue: 0,0:36:48.98,0:36:51.98,Default,,0,0,0,,Мұндай жерде ұйықтау жақсы емес!
Dialogue: 0,0:36:53.38,0:36:56.39,Default,,0,0,0,,Тоторо ше? Тоторо?
Dialogue: 0,0:36:56.39,0:36:58.89,Default,,0,0,0,,(Цубаки) Косей! Уф!
Dialogue: 0,0:37:00.88,0:37:04.88,Default,,0,0,0,,Сіз армандадыңыз ба? Тоторо сонда болды.
Dialogue: 0,0:37:04.88,0:37:08.42,Default,,0,0,0,,Тоторо суретті кітаптарда пайда болған тролльге сілтеме жасай ма?
Dialogue: 0,0:37:08.42,0:37:11.47,Default,,0,0,0,,Иә, Тоторо дұрыс айтты.
Dialogue: 0,0:37:11.47,0:37:15.37,Default,,0,0,0,,Шашы бар, аузы осындай →
Dialogue: 0,0:37:15.37,0:37:22.87,Default,,0,0,0,,Мынадай бірдеңе, мынандай үлкен нәрсе, осындай үлкен нәрсе ұйықтап жатыр.
Dialogue: 0,0:37:25.87,0:37:31.94,Default,,0,0,0,,Бұл... Ей, бұл керемет. Бұл құпия базаға ұқсайды.
Dialogue: 0,0:37:31.94,0:37:34.88,Default,,0,0,0,,Мэй әке: Тотороны осында кездестіргеніңізді естідім.
Dialogue: 0,0:37:34.88,0:37:36.88,Default,,0,0,0,,Тоторо? Иә.
Dialogue: 0,0:37:36.88,0:37:38.38,Default,,0,0,0,,Мұнда!
Dialogue: 0,0:37:46.37,0:37:48.37,Default,,0,0,0,,Эй, күте тұрыңыз.
Dialogue: 0,0:37:49.91,0:37:51.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:53.48,0:37:56.38,Default,,0,0,0,,Мұнда? Уф.
Dialogue: 0,0:37:56.38,0:37:59.38,Default,,0,0,0,,Бұрын мен үлкен ағашқа бардым.
Dialogue: 0,0:37:59.38,0:38:01.87,Default,,0,0,0,,Бірақ бұл тура жол болды.
Dialogue: 0,0:38:01.87,0:38:04.87,Default,,0,0,0,,Ах, Мей, қайтып кел!
Dialogue: 0,0:38:04.87,0:38:06.87,Default,,0,0,0,,≪Егер бұл орын алса! ≫
Dialogue: 0,0:38:15.88,0:38:19.37,Default,,0,0,0,,Ахахаха! Ахахаха!
Dialogue: 0,0:38:19.37,0:38:22.87,Default,,0,0,0,,Бұл рас! Тоторо шынымен де болды!
Dialogue: 0,0:38:22.87,0:38:25.37,Default,,0,0,0,,Өтірік емес...
Dialogue: 0,0:38:33.98,0:38:37.37,Default,,0,0,0,,мамыр. Бұл өтірік емес.
Dialogue: 0,0:38:37.37,0:38:40.87,Default,,0,0,0,,Иә, әкесі де, Сатсуки де→
Dialogue: 0,0:38:40.87,0:38:43.36,Default,,0,0,0,,Менің ойымша, Мэй өтірікші емес.
Dialogue: 0,0:38:43.36,0:38:46.88,Default,,0,0,0,,Мэй осы орманның иесімен кездескен болуы керек.
Dialogue: 0,0:38:46.88,0:38:49.37,Default,,0,0,0,,Бұл өте бақытты.
Dialogue: 0,0:38:49.37,0:38:52.87,Default,,0,0,0,,Бірақ біз әрқашан кездесе алмаймыз.
Dialogue: 0,0:38:53.92,0:38:56.36,Default,,0,0,0,,Жақсы, сіз әлі сәлем беруге барған жоқсыз.
Dialogue: 0,0:38:56.36,0:38:59.36,Default,,0,0,0,,Сәлеметсіз бе? Цукамориге аттанамыз!
Dialogue: 0,0:38:59.36,0:39:15.48,Default,,0,0,0,,♪♪~
Dialogue: 0,0:39:15.48,0:39:20.86,Default,,0,0,0,,Эй, Мэйдің де салмағы артып кетті. Әке, мына камфора ағашы!
Dialogue: 0,0:39:20.86,0:39:23.37,Default,,0,0,0,,Бұл үлкен.
Dialogue: 0,0:39:23.37,0:39:30.86,Default,,0,0,0,,♪♪~
Dialogue: 0,0:39:30.86,0:39:32.36,Default,,0,0,0,,Міне болды!
Dialogue: 0,0:39:33.38,0:39:35.40,Default,,0,0,0,,Бұл ағаш? Иә.
Dialogue: 0,0:39:35.40,0:39:37.93,Default,,0,0,0,,Әке, асығыңыз!
Dialogue: 0,0:39:37.93,0:39:48.38,Default,,0,0,0,,♪♪~
Dialogue: 0,0:39:48.38,0:39:50.88,Default,,0,0,0,,Тесік жойылды.
Dialogue: 0,0:39:50.88,0:39:53.36,Default,,0,0,0,,Шынымен де осында ма? Иә.
Dialogue: 0,0:39:53.36,0:39:55.88,Default,,0,0,0,,Тесік жоғалып кетті.
Dialogue: 0,0:39:55.88,0:39:58.89,Default,,0,0,0,,Ей, біз әрқашан кездесе алмаймыз.
Dialogue: 0,0:39:58.89,0:40:01.91,Default,,0,0,0,,Біз тағы кездесеміз бе? Мен де сенімен танысқым келеді.
Dialogue: 0,0:40:01.91,0:40:05.36,Default,,0,0,0,,Сәті түсіп жатса.
Dialogue: 0,0:40:05.36,0:40:08.88,Default,,0,0,0,,Бұл әдемі ағаш.
Dialogue: 0,0:40:08.88,0:40:14.37,Default,,0,0,0,,Мен бұл жерде ұзақ тұрғанына сенімдімін.
Dialogue: 0,0:40:14.37,0:40:19.89,Default,,0,0,0,,Ертеде ағаштар мен адамдар жақсы дос болған.
Dialogue: 0,0:40:19.89,0:40:23.96,Default,,0,0,0,,Әкем бұл ағашты көрді және ол үйді қатты ұнатты.
Dialogue: 0,0:40:23.96,0:40:26.86,Default,,0,0,0,,Анаңызға да ұнайтынына сенімдімін.
Dialogue: 0,0:40:26.86,0:40:30.38,Default,,0,0,0,,Енді рахметімізді айтып, қайтайық. Мен түскі асымды ішуім керек.
Dialogue: 0,0:40:30.38,0:40:33.39,Default,,0,0,0,,Иә, мен Миччанның үйіне баруға уәде бердім.
Dialogue: 0,0:40:33.39,0:40:34.89,Default,,0,0,0,,Мэй де барады!
Dialogue: 0,0:40:34.89,0:40:36.86,Default,,0,0,0,,Абайлаңыз!
Dialogue: 0,0:40:36.86,0:40:38.88,Default,,0,0,0,,Көмегің үшін рахмет, Мэй.
Dialogue: 0,0:40:38.88,0:40:41.40,Default,,0,0,0,,Үздіксіз қолдау көрсеткеніңіз үшін рахмет.
Dialogue: 0,0:40:41.40,0:40:43.95,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:40:43.95,0:40:45.87,Default,,0,0,0,,Үйге жүгір!
Dialogue: 0,0:40:45.87,0:40:47.87,Default,,0,0,0,,А, жасырын! Ах!
Dialogue: 0,0:40:47.87,0:40:49.87,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:40:50.87,0:40:52.89,Default,,0,0,0,,≪Асығыңыз~! ≫
Dialogue: 0,0:40:52.89,0:40:55.39,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:40:57.38,0:41:00.90,Default,,0,0,0,,``Бүгін бізде өте жақсы жаңалықтар бар.
Dialogue: 0,0:41:00.90,0:41:04.40,Default,,0,0,0,,Мэй Тоторо елесімен кездесті.
Dialogue: 0,0:41:08.87,0:41:13.87,Default,,0,0,0,,«Мен де сені кездестіремін деп үміттенемін».
Dialogue: 0,0:41:42.89,0:41:46.46,Default,,0,0,0,,≪Канта: Егер асықпасаң, кешігіп қаласың≫
Dialogue: 0,0:41:47.46,0:41:48.96,Default,,0,0,0,,Иә.
Dialogue: 0,0:42:11.95,0:42:13.95,Default,,0,0,0,,Бұл! Ай...
Dialogue: 0,0:42:24.88,0:42:26.38,Default,,0,0,0,,Ах.
Dialogue: 0,0:42:30.87,0:42:32.89,Default,,0,0,0,,мамыр!?
Dialogue: 0,0:42:32.89,0:42:35.93,Default,,0,0,0,,Мұғалім! Иә, Сатсуки-сан.
Dialogue: 0,0:42:35.93,0:42:38.43,Default,,0,0,0,,Әй, әпкем...
Dialogue: 0,0:42:44.85,0:42:46.92,Default,,0,0,0,,Мамыр әже….
Dialogue: 0,0:42:46.97,0:42:51.96,Default,,0,0,0,,Кешіріңіз, бірақ мен сенен әпкеңмен баруыңды сұрай алмаймын...
Dialogue: 0,0:42:51.96,0:42:56.46,Default,,0,0,0,,Өйткені... Мей, бүгін әкем университетке баратын күн→
Dialogue: 0,0:42:56.46,0:42:59.96,Default,,0,0,0,,Сен жақсы қыз болуға және мені әжемнің үйінде күтуге уәде бердің.
Dialogue: 0,0:43:02.04,0:43:06.47,Default,,0,0,0,,Менің әлі екі сағатым бар, тіпті әжем де бос емес...
Dialogue: 0,0:43:06.47,0:43:11.47,Default,,0,0,0,,Сен әрқашан жақсы қыз едің.
Dialogue: 0,0:43:17.47,0:43:18.95,Default,,0,0,0,,Аа...
Dialogue: 0,0:43:18.95,0:43:21.95,Default,,0,0,0,,Әже Мен мұғаліммен сөйлесемін.
Dialogue: 0,0:43:27.48,0:43:31.98,Default,,0,0,0,,Сатсукидің анасы ауруханада, сондықтан үйде жағдай қиын.
Dialogue: 0,0:43:31.98,0:43:36.48,Default,,0,0,0,,Барлығы жақсы араласады. Иә.
Dialogue: 0,0:43:41.49,0:43:45.58,Default,,0,0,0,,Не? сол. Бұл Тоторо!
Dialogue: 0,0:43:45.58,0:43:48.48,Default,,0,0,0,,Ши~! Сіз тыныш болуыңыз керек, солай ма?
Dialogue: 0,0:43:48.48,0:43:50.47,Default,,0,0,0,,Иә!
Dialogue: 0,0:43:50.47,0:43:51.97,Default,,0,0,0,,Аа...
Dialogue: 0,0:43:53.45,0:43:59.98,Default,,0,0,0,,(Соңғы қоңырау)
Dialogue: 0,0:43:59.98,0:44:02.50,Default,,0,0,0,,Сау болыңыз! Мэй Чан, сау бол!
Dialogue: 0,0:44:02.50,0:44:06.57,Default,,0,0,0,,Үйірмеден үзіліс алып жатқаныңызды айтыңыз. Иә, мұғалімге айтамын.
Dialogue: 0,0:44:06.57,0:44:08.97,Default,,0,0,0,,Жақында кездескенше. сау бол.
Dialogue: 0,0:44:08.97,0:44:12.97,Default,,0,0,0,,Мамыр, асығыңыз, жаңбыр жауады. Иә.
Dialogue: 0,0:44:20.46,0:44:22.46,Default,,0,0,0,,Уау! Жаңбыр жауып тұр!
Dialogue: 0,0:44:28.99,0:44:30.49,Default,,0,0,0,,Ах!
Dialogue: 0,0:44:33.96,0:44:35.46,Default,,0,0,0,,Хора.
Dialogue: 0,0:44:38.97,0:44:42.97,Default,,0,0,0,,Мэй жыламайды, сен кереметсің бе? Иә.
Dialogue: 0,0:44:44.02,0:44:47.02,Default,,0,0,0,,Бірақ мен қиындыққа тап болдым.
Dialogue: 0,0:44:48.96,0:44:52.46,Default,,0,0,0,,Джизо-сама, маған жаңбырдан пана алуға рұқсат етіңізші.
Dialogue: 0,0:45:27.48,0:45:29.48,Default,,0,0,0,,Хмм…. а….
Dialogue: 0,0:45:30.48,0:45:31.98,Default,,0,0,0,,Әй!
Dialogue: 0,0:45:34.97,0:45:37.47,Default,,0,0,0,,Жоқ! бірақ….
Dialogue: 0,0:45:37.47,0:45:39.48,Default,,0,0,0,,Ах.
Dialogue: 0,0:45:39.48,0:45:57.48,Default,,0,0,0,,♪♪~
Dialogue: 0,0:45:57.48,0:46:00.48,Default,,0,0,0,,Сізге жақсы, әпке. Иә.
Dialogue: 0,0:46:00.48,0:46:03.48,Default,,0,0,0,,Қолшатыр Оның ішінде тесік бар.
Dialogue: 0,0:46:03.48,0:46:04.98,Default,,0,0,0,,Иә.
Dialogue: 0,0:46:14.49,0:46:16.98,Default,,0,0,0,,Әке, сіз қолшатыр әкелген жоқсыз.
Dialogue: 0,0:46:16.98,0:46:18.98,Default,,0,0,0,,Сізді алып кетуге мамыр да келеді!
Dialogue: 0,0:46:21.95,0:46:23.97,Default,,0,0,0,,Сондықтан мен ұмытып кеттім!
Dialogue: 0,0:46:23.97,0:46:27.99,Default,,0,0,0,,Жаңбыр жауып тұрғанда қолшатырын ұмытатын қандай ақымақ?
Dialogue: 0,0:46:27.99,0:46:29.53,Default,,0,0,0,,Ой!
Dialogue: 0,0:46:29.53,0:46:32.06,Default,,0,0,0,,Мен оны айналдырып, бәрібір сындырдым.
Dialogue: 0,0:46:32.06,0:46:33.56,Default,,0,0,0,,Айырмашылық!
Dialogue: 0,0:46:46.48,0:46:48.48,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:46:49.98,0:46:52.47,Default,,0,0,0,,О, Сатсуки-сан, Мэй-чан да...
Dialogue: 0,0:46:52.47,0:46:54.52,Default,,0,0,0,,Әже!
Dialogue: 0,0:46:54.52,0:46:58.97,Default,,0,0,0,,Мен бүгін кешірім сұраймын. Мен сізге мұнда көмектесе алмаймын.
Dialogue: 0,0:46:58.97,0:47:02.46,Default,,0,0,0,,Канта-сан маған қолшатырды берді.
Dialogue: 0,0:47:02.46,0:47:06.48,Default,,0,0,0,,Эй, бала? Амал жоқ, мұндай тозған қолшатыр.
Dialogue: 0,0:47:06.48,0:47:10.98,Default,,0,0,0,,Мей де болды, бұл көп көмектесті, бірақ Канта-сан суланып қалды.
Dialogue: 0,0:47:10.98,0:47:12.99,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:47:12.99,0:47:16.06,Default,,0,0,0,,Жарайды, ылғи лай басып жүреді→
Dialogue: 0,0:47:16.06,0:47:17.97,Default,,0,0,0,,Бұл әдемі болады.
Dialogue: 0,0:47:17.97,0:47:19.98,Default,,0,0,0,,≪Әкеңді алып кетесің бе? ≫
Dialogue: 0,0:47:19.98,0:47:22.46,Default,,0,0,0,,> >
Dialogue: 0,0:47:22.46,0:47:25.46,Default,,0,0,0,,≪Сау бол Мей≫ ≪Сау бол≫
Dialogue: 0,0:47:33.01,0:47:35.04,Default,,0,0,0,,Бум.
Dialogue: 0,0:47:35.04,0:47:38.54,Default,,0,0,0,,Біреу келді ме? Мен білмеймін.
Dialogue: 0,0:47:42.48,0:47:44.48,Default,,0,0,0,,А, мен жаңа ғана келдім.
Dialogue: 0,0:47:57.00,0:47:59.00,Default,,0,0,0,,Сіз мінгіңіз келе ме?
Dialogue: 0,0:48:00.57,0:48:02.57,Default,,0,0,0,,≪Жақсы кетемін≫
Dialogue: 0,0:48:09.96,0:48:14.46,Default,,0,0,0,,Әке, сіз атқа мінбейсіз. Бұл келесі автобус шығар.
Dialogue: 0,0:48:14.46,0:48:16.96,Default,,0,0,0,,Мэй сізді әжеңіздің үйінде күтіп тұр ма?
Dialogue: 0,0:48:18.48,0:48:52.99,Default,,0,0,0,,♪♪~
Dialogue: 0,0:48:52.99,0:48:54.97,Default,,0,0,0,,♪♪~ Не болды?
Dialogue: 0,0:48:54.97,0:49:04.47,Default,,0,0,0,,♪♪~
Dialogue: 0,0:49:25.99,0:49:29.49,Default,,0,0,0,,Мамыр, ұйықтап жатырсың ба?
Dialogue: 0,0:49:29.49,0:49:32.04,Default,,0,0,0,,Сондықтан мен... дедім.
Dialogue: 0,0:49:32.04,0:49:33.96,Default,,0,0,0,,Қазір әженің үйіне барасың ба?
Dialogue: 0,0:49:33.96,0:49:35.98,Default,,0,0,0,,Хмм...
Dialogue: 0,0:49:35.98,0:49:38.48,Default,,0,0,0,,Міне таяп қалды, сондықтан бар күшіңізді салыңыз.
Dialogue: 0,0:49:43.99,0:49:46.99,Default,,0,0,0,,Автобус Кеш болды.
Dialogue: 0,0:49:54.48,0:49:57.48,Default,,0,0,0,,Хора. Иә….
Dialogue: 0,0:50:22.96,0:50:31.46,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:50:34.95,0:50:36.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:50:41.46,0:51:19.07,Default,,0,0,0,,♪♪~
Dialogue: 0,0:51:19.07,0:51:20.57,Default,,0,0,0,,Тоторо?
Dialogue: 0,0:51:24.97,0:51:27.47,Default,,0,0,0,,Уау.
Dialogue: 0,0:51:30.46,0:51:32.46,Default,,0,0,0,,О, күте тұрыңыз.
Dialogue: 0,0:51:35.98,0:51:37.48,Default,,0,0,0,,(қолшатыр ашылған дыбыс)
Dialogue: 0,0:51:37.48,0:51:39.48,Default,,0,0,0,,Мен оны саған қарызға беремін.
Dialogue: 0,0:51:40.52,0:51:43.02,Default,,0,0,0,,Мэй тез құлайды.
Dialogue: 0,0:51:48.46,0:51:50.96,Default,,0,0,0,,Сіз оны осылай пайдаланасыз.
Dialogue: 0,0:52:00.97,0:52:02.47,Default,,0,0,0,,Хехе.
Dialogue: 0,0:52:15.97,0:52:16.97,Default,,0,0,0,,Потон
Dialogue: 0,0:52:24.46,0:52:26.46,Default,,0,0,0,,Пара
Dialogue: 0,0:52:28.48,0:52:30.48,Default,,0,0,0,,Ақымақ~.
Dialogue: 0,0:52:39.46,0:52:42.96,Default,,0,0,0,,Пара... Пара
Dialogue: 0,0:52:45.47,0:52:48.47,Default,,0,0,0,,Ақымақ~.
Dialogue: 0,0:52:50.99,0:52:53.48,Default,,0,0,0,,Хмф! Апыр-ай!
Dialogue: 0,0:52:53.48,0:52:55.51,Default,,0,0,0,,Пара
Dialogue: 0,0:52:55.51,0:52:58.06,Default,,0,0,0,,За~!
Dialogue: 0,0:52:58.06,0:53:03.97,Default,,0,0,0,,Гуо~!
Dialogue: 0,0:53:03.97,0:53:05.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:53:07.49,0:53:08.99,Default,,0,0,0,,Автобус келді!
Dialogue: 0,0:53:24.97,0:53:27.47,Default,,0,0,0,,Уня~о.
Dialogue: 0,0:53:36.47,0:53:37.97,Default,,0,0,0,,Буфа.
Dialogue: 0,0:54:15.98,0:54:19.98,Default,,0,0,0,,Тоторо Мен әкемнің қолшатырын алдым.
Dialogue: 0,0:54:33.04,0:54:36.46,Default,,0,0,0,,Иә~ Кешіріңіз. ≪Жарайды, кетіңіз! ≫
Dialogue: 0,0:54:36.46,0:54:39.98,Default,,0,0,0,,Пойыз кешігіп келді. Мен автобусты сағындым.
Dialogue: 0,0:54:39.98,0:54:42.47,Default,,0,0,0,,Сіз уайымдап тұрсыз ба?
Dialogue: 0,0:54:42.47,0:54:44.95,Default,,0,0,0,,шықты! Әке, шықты! Шыққан!!
Dialogue: 0,0:54:44.95,0:54:46.97,Default,,0,0,0,,Мысық! Мысық автобус!
Dialogue: 0,0:54:46.97,0:54:48.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:54:48.47,0:54:52.53,Default,,0,0,0,,Бұл өте үлкен! Маған осылай қарап тұрсың ба?
Dialogue: 0,0:54:52.53,0:54:54.56,Default,,0,0,0,,Қорқынышты! Қорқынышты!
Dialogue: 0,0:54:54.56,0:54:59.49,Default,,0,0,0,,Біз кездестік! Мен Тоторомен таныстым!!
Dialogue: 0,0:54:59.49,0:55:01.99,Default,,0,0,0,,Керемет! Қорқынышты!
Dialogue: 0,0:55:02.96,0:55:05.47,Default,,0,0,0,,Гва~
Dialogue: 0,0:55:05.47,0:55:12.98,Default,,0,0,0,,Хм! Сол қол
Dialogue: 0,0:55:12.98,0:55:14.52,Default,,0,0,0,,Сенің басыңа түскен қарғыс—
Dialogue: 0,0:55:14.52,0:55:19.02,Default,,0,0,0,,Кя~ Хахахаха!
Dialogue: 0,0:55:21.97,0:55:25.98,Default,,0,0,0,,``Анашым, жүрегім әлі соғып тұр.
Dialogue: 0,0:55:25.98,0:55:29.97,Default,,0,0,0,,Бұл өте жұмбақ, қорқынышты және көңілді күн болды.
Dialogue: 0,0:55:29.97,0:55:33.47,Default,,0,0,0,,Сондай-ақ, Тотороның маған берген алғысы керемет болды.
Dialogue: 0,0:55:33.47,0:55:38.06,Default,,0,0,0,,Бұл бамбук жапырақтарына оралған және айдаһардың мұртымен байланған пакет болды.
Dialogue: 0,0:55:38.06,0:55:43.46,Default,,0,0,0,,Үйге келгенде ашып қарасам, ішінен жаңғақ жатыр...''
Dialogue: 0,0:55:43.46,0:55:45.46,Default,,0,0,0,,Ах! Апыр-ай!
Dialogue: 0,0:55:47.48,0:55:50.97,Default,,0,0,0,,«Бағың орманға айналса, тамаша болар еді→
Dialogue: 0,0:55:50.97,0:55:53.97,Default,,0,0,0,,Мен бақшаға жаңғақ себуді шештім, бірақ...''
Dialogue: 0,0:55:53.97,0:55:56.48,Default,,0,0,0,,«Тұқымдар оңай бүршік жармайды.
Dialogue: 0,0:55:56.48,0:56:01.55,Default,,0,0,0,,Мэй әлі кетпедім деп күнде айтады.Ол әлі кеткен жоқ.
Dialogue: 0,0:56:01.55,0:56:06.05,Default,,0,0,0,,Маймыл-Қани шаянға айналғандай.''
Dialogue: 0,0:56:07.47,0:56:09.47,Default,,0,0,0,,Ал, хехехе...
Dialogue: 0,0:56:10.47,0:56:14.96,Default,,0,0,0,,«Жақында жазғы каникул, тезірек сауығып кетіңіз.
Dialogue: 0,0:56:14.96,0:56:16.98,Default,,0,0,0,,Сацуки ана».
Dialogue: 0,0:56:17.36,0:56:19.36,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:56:20.46,0:56:24.96,Default,,0,0,0,,Мынау, мынау... Иә! О~ О~.
Dialogue: 0,0:56:26.55,0:56:28.95,Default,,0,0,0,,Мен оны өшіремін. асылу!
Dialogue: 0,0:56:28.95,0:56:32.47,Default,,0,0,0,,Ата, ертең көктеп шыға ма?
Dialogue: 0,0:56:32.47,0:56:36.46,Default,,0,0,0,,Менің ойымша, Тоторо біледі.
Dialogue: 0,0:56:36.46,0:56:37.96,Default,,0,0,0,,Қайырлы түн.
Dialogue: 0,0:56:37.96,0:57:04.47,Default,,0,0,0,,Хм! Сол қол
Dialogue: 0,0:57:04.47,0:57:25.96,Default,,0,0,0,,♪♪~
Dialogue: 0,0:57:25.96,0:57:27.96,Default,,0,0,0,,♪♪~ Мамыр!
Dialogue: 0,0:57:27.96,0:57:29.98,Default,,0,0,0,,♪♪~ Хмм?
Dialogue: 0,0:57:29.98,0:57:45.46,Default,,0,0,0,,♪♪~
Dialogue: 0,0:57:45.46,0:57:47.98,Default,,0,0,0,,Міне, мен жаңғақтарды сеуіп жібердім. ♪♪~ Иә.
Dialogue: 0,0:57:47.98,0:58:02.53,Default,,0,0,0,,♪♪~
Dialogue: 0,0:58:02.53,0:58:05.46,Default,,0,0,0,,Ах! Уууу.
Dialogue: 0,0:58:05.46,0:58:09.97,Default,,0,0,0,,Уау... Буха!
Dialogue: 0,0:58:09.97,0:58:11.99,Default,,0,0,0,,Ах! Ах!
Dialogue: 0,0:58:11.99,0:58:13.49,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:58:14.47,0:58:18.97,Default,,0,0,0,,Уау... Буха!
Dialogue: 0,0:58:21.01,0:58:23.05,Default,,0,0,0,,Уау!
Dialogue: 0,0:58:23.05,0:58:27.05,Default,,0,0,0,,Хмм... Уау!
Dialogue: 0,0:58:29.47,0:58:30.97,Default,,0,0,0,,Уау!
Dialogue: 0,0:58:30.97,0:59:18.47,Default,,0,0,0,,♪♪~
Dialogue: 0,0:59:18.47,0:59:22.47,Default,,0,0,0,,Иә! Алақай!
Dialogue: 0,0:59:27.53,0:59:29.03,Default,,0,0,0,,Қандай азап…
Dialogue: 0,0:59:34.45,0:59:35.95,Default,,0,0,0,,Уау!
Dialogue: 0,0:59:50.50,0:59:52.04,Default,,0,0,0,,Ех!
Dialogue: 0,0:59:52.04,1:00:17.53,Default,,0,0,0,,♪♪~
Dialogue: 0,1:00:17.53,1:00:21.47,Default,,0,0,0,,♪♪~ Гуо~!!
Dialogue: 0,1:00:21.47,1:00:24.97,Default,,0,0,0,,Уау! ♪♪~ Гвааа~!
Dialogue: 0,1:00:24.97,1:00:37.52,Default,,0,0,0,,♪♪~
Dialogue: 0,1:00:37.52,1:00:40.97,Default,,0,0,0,,Мэй Біз жел болып жатырмыз! ♪♪~ Иә.
Dialogue: 0,1:00:40.97,1:00:46.97,Default,,0,0,0,,♪♪~
Dialogue: 0,1:00:53.95,1:01:23.47,Default,,0,0,0,,♪~
Dialogue: 0,1:01:33.97,1:01:35.47,Default,,0,0,0,,Ах!
Dialogue: 0,1:01:40.46,1:01:42.46,Default,,0,0,0,,Ағаштар жоқ.
Dialogue: 0,1:01:42.46,1:01:44.46,Default,,0,0,0,,Ах! Ах!!
Dialogue: 0,1:01:48.02,1:01:51.02,Default,,0,0,0,,Иә! Ол шықты!
Dialogue: 0,1:01:52.46,1:01:53.96,Default,,0,0,0,,Бұл жай ғана арман!
Dialogue: 0,1:01:53.96,1:01:55.46,Default,,0,0,0,,Бұл арман емес еді!
Dialogue: 0,1:01:55.46,1:01:56.96,Default,,0,0,0,,Бұл жай ғана арман!
Dialogue: 0,1:01:56.96,1:01:59.48,Default,,0,0,0,,Бұл арман емес еді! Банзай!
Dialogue: 0,1:01:59.48,1:02:01.48,Default,,0,0,0,,Иә! Алақай!
Dialogue: 0,1:02:17.45,1:02:20.45,Default,,0,0,0,,Құсақабе-сан, телеграмма!
Dialogue: 0,1:02:21.47,1:02:23.49,Default,,0,0,0,,Құсақабе-сан!
Dialogue: 0,1:02:23.49,1:02:25.99,Default,,0,0,0,,Бұл телеграмма!
Dialogue: 0,1:02:26.96,1:02:29.46,Default,,0,0,0,,Мүмкін сіз алыссыз...?
Dialogue: 0,1:02:35.53,1:02:38.03,Default,,0,0,0,,Әже!
Dialogue: 0,1:02:41.96,1:02:44.46,Default,,0,0,0,,Міне осылай.
Dialogue: 0,1:02:45.48,1:02:47.98,Default,,0,0,0,,Бұл жеуге дайын.
Dialogue: 0,1:02:54.47,1:02:56.49,Default,,0,0,0,,Қандай азап…
Dialogue: 0,1:02:56.49,1:02:59.99,Default,,0,0,0,,Әже Бұл не? Иә.
Dialogue: 0,1:03:05.96,1:03:09.47,Default,,0,0,0,,Әженің өрісі қазынадай.
Dialogue: 0,1:03:09.47,1:03:12.97,Default,,0,0,0,,Хахаха... Енді тынығып ал, тынығып ал.
Dialogue: 0,1:03:18.48,1:03:21.50,Default,,0,0,0,,Шынымен суық.
Dialogue: 0,1:03:21.50,1:03:23.50,Default,,0,0,0,,Мен оны аламын.
Dialogue: 0,1:03:32.96,1:03:35.46,Default,,0,0,0,,Дәмді. Мен түсінемін.
Dialogue: 0,1:03:35.46,1:03:40.47,Default,,0,0,0,,Тенду-сама, мен көп шомыламын, сондықтан бұл менің денеме пайдалы.
Dialogue: 0,1:03:40.47,1:03:42.47,Default,,0,0,0,,Анаңыздың ауруына да?
Dialogue: 0,1:03:42.47,1:03:43.97,Default,,0,0,0,,Әрине.
Dialogue: 0,1:03:43.97,1:03:48.02,Default,,0,0,0,,Әженің егінінен тамақ жесеңіз, бірден жақсы сезінесіз.
Dialogue: 0,1:03:48.02,1:03:50.46,Default,,0,0,0,,Мама, сен сенбіде үйге келмейсің бе?
Dialogue: 0,1:03:50.46,1:03:52.98,Default,,0,0,0,,Мэйдің футонында бірге ұйықтаймыз.
Dialogue: 0,1:03:52.98,1:03:56.45,Default,,0,0,0,,Мен көремін. Ақырында ауруханадан шығатын кез келді.
Dialogue: 0,1:03:56.45,1:03:59.45,Default,,0,0,0,,Жоқ, мен шынымен де әлі шығарылған жоқпын →
Dialogue: 0,1:03:59.45,1:04:02.97,Default,,0,0,0,,Бірте-бірте үйреніп кету үшін дүйсенбі күні ауруханаға қайтамын.
Dialogue: 0,1:04:02.97,1:04:07.53,Default,,0,0,0,,Олай болса, көбірек жеу керек.
Dialogue: 0,1:04:07.53,1:04:10.98,Default,,0,0,0,,Мэйдің алған жүгері мен анама беремін.
Dialogue: 0,1:04:10.98,1:04:13.47,Default,,0,0,0,,Анашым, сенің бақытты болатыныңа сенімдімін.
Dialogue: 0,1:04:13.47,1:04:14.97,Default,,0,0,0,,Иә!
Dialogue: 0,1:04:21.96,1:04:24.48,Default,,0,0,0,,Telegram Мен оны алыс болсам да саған қалдырдым.
Dialogue: 0,1:04:24.48,1:04:25.98,Default,,0,0,0,,Менің үйім?
Dialogue: 0,1:04:29.46,1:04:32.45,Default,,0,0,0,,Әже, әке, мен кешке дейін үйде болмаймын.
Dialogue: 0,1:04:32.45,1:04:35.45,Default,,0,0,0,,Оны ашыңыз. Егер сіз асығыс болсаңыз жақсы емес.
Dialogue: 0,1:04:35.45,1:04:36.95,Default,,0,0,0,,Иә.
Dialogue: 0,1:04:38.97,1:04:42.76,Default,,0,0,0,,“Ренраку Коу Шичикокуяма…”.
Dialogue: 0,1:04:43.26,1:04:46.33,Default,,0,0,0,,Шичикунияма ауруханасы! Бұл анамның ауруханасынан.
Dialogue: 0,1:04:46.33,1:04:48.83,Default,,0,0,0,,Анама бірдеңе болды...
Dialogue: 0,1:04:50.25,1:04:52.77,Default,,0,0,0,,Әже, мен не істеуім керек? Маған хабарласыңыз.
Dialogue: 0,1:04:52.77,1:04:56.78,Default,,0,0,0,,Сабыр ет, сабыр... Әкеңнің қайда екенін білесің бе?
Dialogue: 0,1:04:56.78,1:05:00.28,Default,,0,0,0,,Мен зертхана нөмірін білемін, бірақ телефон жоқ.
Dialogue: 0,1:05:00.28,1:05:04.27,Default,,0,0,0,,Канта, мені басты үйге апар. Маған телефоныңызды беріңізші.
Dialogue: 0,1:05:04.27,1:05:05.77,Default,,0,0,0,,Иә.
Dialogue: 0,1:05:08.85,1:05:12.35,Default,,0,0,0,,Мэй Чан бұл жерде жоқ!
Dialogue: 0,1:05:21.28,1:05:23.78,Default,,0,0,0,,мамыр! Әжемен бірге болыңыз!
Dialogue: 0,1:06:00.76,1:06:03.26,Default,,0,0,0,,Сәлеметсіз бе, қала сыртына көшіңіз.
Dialogue: 0,1:06:04.28,1:06:09.28,Default,,0,0,0,,Бұл Токионың 31-ші станциясының 1382 нөмірі Иә.
Dialogue: 0,1:06:10.27,1:06:13.77,Default,,0,0,0,,Сен сүйкімді қыз емессің, Қанта.
Dialogue: 0,1:06:14.77,1:06:16.81,Default,,0,0,0,,[ТЕЛ]
Dialogue: 0,1:06:16.81,1:06:18.81,Default,,0,0,0,,Сәлеметсіз бе... Иә.
Dialogue: 0,1:06:19.87,1:06:22.28,Default,,0,0,0,,Сәлеметсіз бе, бұл археология сабағы ма?
Dialogue: 0,1:06:22.28,1:06:25.26,Default,,0,0,0,,Әкем... мм... Құсақабе, өтінемін.
Dialogue: 0,1:06:25.26,1:06:28.26,Default,,0,0,0,,Мен Сацуки Кусакабемін... Иә.
Dialogue: 0,1:06:31.27,1:06:33.76,Default,,0,0,0,,Әй, әке! Мен Сатсуки!
Dialogue: 0,1:06:33.76,1:06:39.84,Default,,0,0,0,,Не? Иә, иә... ауруханадан?
Dialogue: 0,1:06:39.84,1:06:42.76,Default,,0,0,0,,[ТЕЛ] Жарайды, мен қазір ауруханаға хабарласамын.
Dialogue: 0,1:06:42.76,1:06:45.77,Default,,0,0,0,,Анаңа бірдеңе болды ма? Не істеуім керек, әке?
Dialogue: 0,1:06:45.77,1:06:49.75,Default,,0,0,0,,[ТЕЛ] Жарайды. Ауруханаға хабарласқан соң бірден хабарласамын.→
Dialogue: 0,1:06:49.75,1:06:53.26,Default,,0,0,0,,Маған сонда күтуге рұқсат етіңіз. Иә.
Dialogue: 0,1:06:53.26,1:06:55.26,Default,,0,0,0,,Ал, енді қысқартайық.
Dialogue: 0,1:06:57.28,1:06:59.83,Default,,0,0,0,,Әже, осында күтіңіз.
Dialogue: 0,1:06:59.83,1:07:01.75,Default,,0,0,0,,Әкем қоңырау шалып жатыр.
Dialogue: 0,1:07:01.75,1:07:04.25,Default,,0,0,0,,Аа, сабыр етіңіз.
Dialogue: 0,1:07:10.98,1:07:13.96,Default,,0,0,0,,Үлкен әпке!!
Dialogue: 0,1:07:13.96,1:07:15.46,Default,,0,0,0,,Ах...
Dialogue: 0,1:07:16.97,1:07:21.99,Default,,0,0,0,,(айқай)
Dialogue: 0,1:07:21.99,1:07:25.56,Default,,0,0,0,,Жоқ! Бұл ананың жүгері!
Dialogue: 0,1:07:25.56,1:07:27.08,Default,,0,0,0,,(айқай)
Dialogue: 0,1:07:27.08,1:07:30.08,Default,,0,0,0,,Жоқ! Мен оны анама беремін!
Dialogue: 0,1:07:30.98,1:07:32.98,Default,,0,0,0,,(Ешкі дыбысы)
Dialogue: 0,1:07:46.01,1:07:49.58,Default,,0,0,0,,Мамыр, анаңның көңіл-күйі нашар деп естідім.
Dialogue: 0,1:07:49.58,1:07:52.48,Default,,0,0,0,,Сондықтан мен келесі жолы келуді кейінге қалдыруды шештім.
Dialogue: 0,1:07:52.48,1:07:54.47,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:07:54.47,1:07:58.97,Default,,0,0,0,,Оған көмектесу мүмкін емес. Егер сіз өзіңізді ауыруға мәжбүр етсеңіз, сіз қиындыққа тап боласыз.
Dialogue: 0,1:07:58.97,1:08:00.47,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:08:01.49,1:08:04.50,Default,,0,0,0,,Эй, мен оны сәл кейінге қалдырамын.
Dialogue: 0,1:08:04.50,1:08:06.00,Default,,0,0,0,,Жоқ!!
Dialogue: 0,1:08:07.02,1:08:09.57,Default,,0,0,0,,Сонда анаң өліп қалса жақсы емес пе?
Dialogue: 0,1:08:09.57,1:08:11.99,Default,,0,0,0,,Я~да~!!
Dialogue: 0,1:08:11.99,1:08:14.49,Default,,0,0,0,,Мэйдің ақымақ! Мен енді білмеймін!
Dialogue: 0,1:08:24.98,1:08:27.02,Default,,0,0,0,,Кеттік.
Dialogue: 0,1:08:27.02,1:08:33.98,Default,,0,0,0,,Уау... апаң ақымақ екен!
Dialogue: 0,1:08:33.98,1:08:44.98,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:09:00.47,1:09:03.99,Default,,0,0,0,,Кірді қоятын кез келді...
Dialogue: 0,1:09:03.99,1:09:07.49,Default,,0,0,0,,Бұлай ренжіме→
Dialogue: 0,1:09:07.49,1:09:11.49,Default,,0,0,0,,Маған әжем көмектесуге келді, сондықтан мен өзімді жақсы сезінемін.
Dialogue: 0,1:09:15.48,1:09:19.97,Default,,0,0,0,,Әкем ауруханаға баратынын айтты.
Dialogue: 0,1:09:19.97,1:09:23.49,Default,,0,0,0,,Анашым, оны суық деп атайды→
Dialogue: 0,1:09:23.49,1:09:26.99,Default,,0,0,0,,Мен келесі сенбіде қайтамын.
Dialogue: 0,1:09:31.02,1:09:33.05,Default,,0,0,0,,Өткен күні де солай болды.
Dialogue: 0,1:09:33.05,1:09:35.49,Default,,0,0,0,,Мен ауруханада сәл ғана емделсем де...
Dialogue: 0,1:09:35.49,1:09:38.49,Default,,0,0,0,,Суық тиген сияқты...
Dialogue: 0,1:09:38.49,1:09:41.49,Default,,0,0,0,,Анам қайтыс болса не істеуім керек?
Dialogue: 0,1:09:41.49,1:09:43.50,Default,,0,0,0,,Сатсуки-чан...
Dialogue: 0,1:09:43.50,1:09:45.98,Default,,0,0,0,,Мүмкін сіздің анаңыз...
Dialogue: 0,1:09:45.98,1:09:49.50,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:09:49.50,1:09:52.55,Default,,0,0,0,,Жарайды Жарайды.
Dialogue: 0,1:09:52.55,1:09:56.99,Default,,0,0,0,,Осындай сүйкімді балаларды қалдырып, кім өлгісі келеді?
Dialogue: 0,1:09:56.99,1:10:01.00,Default,,0,0,0,,Жылама Жылама.
Dialogue: 0,1:10:01.00,1:10:05.50,Default,,0,0,0,,Әжем әкем келгенше менімен бірге болады.
Dialogue: 0,1:10:47.98,1:10:50.98,Default,,0,0,0,,Ме-и-чан!
Dialogue: 0,1:10:55.50,1:10:57.50,Default,,0,0,0,,мамыр!
Dialogue: 0,1:11:00.49,1:11:02.49,Default,,0,0,0,,мамыр!
Dialogue: 0,1:11:04.98,1:11:06.84,Default,,0,0,0,,Мамыр, қайтып келдің бе?
Dialogue: 0,1:11:06.84,1:11:09.84,Default,,0,0,0,,Сіз аялдамада емес пе едіңіз? Иә.
Dialogue: 0,1:11:10.24,1:11:14.23,Default,,0,0,0,,Бұл біртүрлі. Қайда кетті?
Dialogue: 0,1:11:14.23,1:11:18.14,Default,,0,0,0,,Мен бұрын Мэймен ұрысып қалдым. Өйткені Мэй...
Dialogue: 0,1:11:18.14,1:11:21.06,Default,,0,0,0,,Қызық, ол бала анасының ауруханасына барды ма!?
Dialogue: 0,1:11:21.06,1:11:24.06,Default,,0,0,0,,Шичикунияма ауруханасы?
Dialogue: 0,1:11:24.06,1:11:28.06,Default,,0,0,0,,Ересек адамға жүру үшін үш сағат қажет. Келіңіздер көріңіздер!
Dialogue: 0,1:11:29.06,1:11:33.57,Default,,0,0,0,,Қанта~! Тезірек маған қоңырау шалыңыз, әке!
Dialogue: 0,1:11:33.57,1:11:36.57,Default,,0,0,0,,Мэй Чан кетті!
Dialogue: 0,1:11:45.56,1:11:48.56,Default,,0,0,0,,Мэй ақымақ... ол оңай адасып қалады.
Dialogue: 0,1:11:55.56,1:11:58.06,Default,,0,0,0,,Мен!!
Dialogue: 0,1:12:05.24,1:12:07.07,Default,,0,0,0,,Кешіріңіз! Ағай...
Dialogue: 0,1:12:07.55,1:12:09.05,Default,,0,0,0,,Иә?
Dialogue: 0,1:12:09.05,1:12:12.05,Default,,0,0,0,,Бұл жолдан кішкентай қыз өткен жоқ па?
Dialogue: 0,1:12:12.05,1:12:16.56,Default,,0,0,0,,Ол менің әпкем. Ал, қыз...
Dialogue: 0,1:12:16.56,1:12:19.56,Default,,0,0,0,,Көрсең байқаған болар едің.
Dialogue: 0,1:12:19.56,1:12:22.06,Default,,0,0,0,,Мен бұл емес пе деп ойлаймын...
Dialogue: 0,1:12:41.03,1:12:43.55,Default,,0,0,0,,Сіз мұнда келгеніңізге сенімдісіз бе?
Dialogue: 0,1:12:43.55,1:12:45.60,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,1:12:45.60,1:12:53.54,Default,,0,0,0,,♪♪~
Dialogue: 0,1:12:53.54,1:12:56.03,Default,,0,0,0,,♪♪~ Мен~і!!
Dialogue: 0,1:12:56.03,1:13:15.03,Default,,0,0,0,,♪♪~
Dialogue: 0,1:13:16.55,1:13:19.05,Default,,0,0,0,,Тоқтаңыз!
Dialogue: 0,1:13:20.74,1:13:22.66,Default,,0,0,0,,Баккааро~! Бұл қауіпті...
Dialogue: 0,1:13:22.66,1:13:25.66,Default,,0,0,0,,Мен әпкемді іздеп жүрмін! Қыз, сен көрмедің бе?
Dialogue: 0,1:13:25.66,1:13:27.67,Default,,0,0,0,,Әпке?
Dialogue: 0,1:13:27.67,1:13:31.72,Default,,0,0,0,,Ол Шичикунияма ауруханасына барған 4 жасар қыз.
Dialogue: 0,1:13:31.72,1:13:34.66,Default,,0,0,0,,Рёко-чан, байқадың ба? Уф.
Dialogue: 0,1:13:34.66,1:13:37.18,Default,,0,0,0,,Біз Шичикуни тауынан келдік.
Dialogue: 0,1:13:37.18,1:13:39.66,Default,,0,0,0,,Бірақ мен мұндай баланы көрген емеспін.
Dialogue: 0,1:13:39.66,1:13:42.16,Default,,0,0,0,,Иә... Рахмет.
Dialogue: 0,1:13:42.16,1:13:45.67,Default,,0,0,0,,Сіз қай жақтансыз? Бұл Мацуго.
Dialogue: 0,1:13:45.67,1:13:49.69,Default,,0,0,0,,Мацуго!? Қандай да бір қателік бар емес пе?
Dialogue: 0,1:13:49.69,1:13:52.19,Default,,0,0,0,,Сонда кездескенше.
Dialogue: 0,1:14:03.15,1:14:05.15,Default,,0,0,0,,Сатсуки~!
Dialogue: 0,1:14:06.15,1:14:08.65,Default,,0,0,0,,Канчан!
Dialogue: 0,1:14:09.67,1:14:11.68,Default,,0,0,0,,Онда болды ма? Жоқ, бұл да?
Dialogue: 0,1:14:11.68,1:14:15.20,Default,,0,0,0,,Иә. Мені қазір ата-анам іздеп жатыр.
Dialogue: 0,1:14:15.20,1:14:18.77,Default,,0,0,0,,Мен оның орнына Шичикоку тауына барамын, сондықтан үйге қайтуға болады.
Dialogue: 0,1:14:18.77,1:14:23.69,Default,,0,0,0,,Ауруханаға барар жолда қате бұрылыс жасаған болуы керек.
Dialogue: 0,1:14:23.69,1:14:26.69,Default,,0,0,0,,Мен Камиике тоғанынан сандал тауып алдым.
Dialogue: 0,1:14:30.16,1:14:31.66,Default,,0,0,0,,Капитан Магатоға не деп тұрсың!!
Dialogue: 0,1:14:33.16,1:14:36.70,Default,,0,0,0,,Мэйдің бірі әлі шешілген жоқ!
Dialogue: 0,1:14:36.70,1:14:53.17,Default,,0,0,0,,♪♪~
Dialogue: 0,1:14:53.17,1:14:55.15,Default,,0,0,0,,♪♪~ Сіз таптыңыз ба?
Dialogue: 0,1:14:55.15,1:15:26.68,Default,,0,0,0,,♪♪~
Dialogue: 0,1:15:26.68,1:15:31.16,Default,,0,0,0,,Нанмандаб Нанмандаб Нанмандаб Нанмандаб….
Dialogue: 0,1:15:31.16,1:15:33.68,Default,,0,0,0,,Бұл жерде балшық терең, сондықтан алға!
Dialogue: 0,1:15:33.68,1:15:36.16,Default,,0,0,0,,≪Эй, сенде қалды ма? ≫
Dialogue: 0,1:15:36.16,1:15:44.65,Default,,0,0,0,,♪♪~
Dialogue: 0,1:15:44.65,1:15:46.69,Default,,0,0,0,,≪Сацуки-чан әже келді! ≫
Dialogue: 0,1:15:46.69,1:15:48.19,Default,,0,0,0,,Не!
Dialogue: 0,1:15:51.68,1:15:53.66,Default,,0,0,0,,Әже!
Dialogue: 0,1:15:53.66,1:15:56.16,Default,,0,0,0,,Мынау... бұл.
Dialogue: 0,1:16:05.17,1:16:07.17,Default,,0,0,0,,Бұл жеткіліксіз.
Dialogue: 0,1:16:17.17,1:16:22.66,Default,,0,0,0,,Жақсы, мен бұл Мэй Чан деп ойладым...
Dialogue: 0,1:16:22.66,1:16:25.66,Default,,0,0,0,,Бұл не? Әженің ерте мазақтауы.
Dialogue: 0,1:16:25.66,1:16:27.68,Default,,0,0,0,,Ей, бұл қате!
Dialogue: 0,1:16:27.68,1:16:31.18,Default,,0,0,0,,≪Сонда ол қайда кетті? ≫ ≪Мен қайтадан іздеуді бастауым керек.≫
Dialogue: 0,1:16:31.18,1:16:33.22,Default,,0,0,0,,≪Асықпасаң қараңғы болады≫
Dialogue: 0,1:16:33.22,1:16:36.67,Default,,0,0,0,,≪Кешіріңіз, барлығыңыз. Қиындық болса да, бөлуді сұраймын.≫
Dialogue: 0,1:16:36.67,1:16:38.67,Default,,0,0,0,,≪Жоқ, өйткені біз өзара≫біз
Dialogue: 0,1:17:06.68,1:17:11.69,Default,,0,0,0,,Өтінемін! Мэй Тотороға жетуге тырысқанда адасып қалды.
Dialogue: 0,1:17:11.69,1:17:16.19,Default,,0,0,0,,Қараңғы түсе жаздады, ол бір жерден адасып қалды.
Dialogue: 0,1:17:24.70,1:17:39.73,Default,,0,0,0,,♪♪~
Dialogue: 0,1:17:39.73,1:17:41.23,Default,,0,0,0,,Ах!
Dialogue: 0,1:17:46.19,1:17:47.69,Default,,0,0,0,,Тоторо!
Dialogue: 0,1:17:49.19,1:17:50.69,Default,,0,0,0,,Тоторо!
Dialogue: 0,1:17:50.69,1:17:54.20,Default,,0,0,0,,Мэй адасып қалды. Мен оны іздедім, бірақ таба алмадым.
Dialogue: 0,1:17:54.20,1:17:56.68,Default,,0,0,0,,Мейді іздеңіз.
Dialogue: 0,1:17:57.28,1:18:00.29,Default,,0,0,0,,Сенің қазір бір жерде жылайтыныңа сенімдімін.
Dialogue: 0,1:18:00.29,1:18:03.86,Default,,0,0,0,,Мен не істерімді білмеймін!
Dialogue: 0,1:18:03.86,1:18:10.86,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:18:21.29,1:18:27.29,Default,,0,0,0,,Боу~!
Dialogue: 0,1:18:43.28,1:18:48.80,Default,,0,0,0,,Гуах!!
Dialogue: 0,1:18:48.80,1:18:50.30,Default,,0,0,0,,Ах!
Dialogue: 0,1:18:50.30,1:18:53.84,Default,,0,0,0,,♪♪~
Dialogue: 0,1:18:53.84,1:18:57.79,Default,,0,0,0,,♪♪~ Ня~о~!
Dialogue: 0,1:18:57.79,1:19:02.30,Default,,0,0,0,,♪♪~
Dialogue: 0,1:19:02.30,1:19:04.78,Default,,0,0,0,,♪♪~ Оны бәрі көре алмайды.
Dialogue: 0,1:19:04.78,1:19:34.28,Default,,0,0,0,,♪♪~
Dialogue: 0,1:19:34.28,1:19:35.78,Default,,0,0,0,,♪♪~ Ах….
Dialogue: 0,1:19:35.78,1:19:41.28,Default,,0,0,0,,♪♪~
Dialogue: 0,1:19:50.30,1:19:52.30,Default,,0,0,0,,Уау….
Dialogue: 0,1:19:57.80,1:20:02.31,Default,,0,0,0,,♪♪~ Ня~о~!
Dialogue: 0,1:20:02.31,1:20:12.29,Default,,0,0,0,,♪♪~
Dialogue: 0,1:20:12.29,1:20:13.79,Default,,0,0,0,,♪♪~ Уау!
Dialogue: 0,1:20:13.79,1:20:15.81,Default,,0,0,0,,♪♪~
Dialogue: 0,1:20:15.81,1:20:20.31,Default,,0,0,0,,♪♪~ Мэй-чан!
Dialogue: 0,1:20:20.31,1:20:27.83,Default,,0,0,0,,♪♪~
Dialogue: 0,1:20:27.83,1:20:29.87,Default,,0,0,0,,♪♪~ Ағаш қашып барады!
Dialogue: 0,1:20:29.87,1:20:37.79,Default,,0,0,0,,♪♪~
Dialogue: 0,1:20:37.79,1:20:41.30,Default,,0,0,0,,♪♪~ (ит үреді)
Dialogue: 0,1:20:41.30,1:20:52.30,Default,,0,0,0,,♪♪~
Dialogue: 0,1:21:00.80,1:21:02.79,Default,,0,0,0,,≪Мей! ≫
Dialogue: 0,1:21:02.79,1:21:04.29,Default,,0,0,0,,А...!?
Dialogue: 0,1:21:06.29,1:21:08.79,Default,,0,0,0,,Үлкен әпке!
Dialogue: 0,1:21:10.29,1:21:14.29,Default,,0,0,0,,Үлкен әпке! ≪Мен! ≫
Dialogue: 0,1:21:23.27,1:21:26.77,Default,,0,0,0,,мамыр! Үлкен әпке!!
Dialogue: 0,1:21:29.28,1:21:32.78,Default,,0,0,0,,Идиот Мэй. кешіріңіз!
Dialogue: 0,1:21:34.28,1:21:38.82,Default,,0,0,0,,Жүгеріні анаңызға жеткізуді жоспарладыңыз ба?
Dialogue: 0,1:21:38.82,1:21:41.82,Default,,0,0,0,,Ахх.
Dialogue: 0,1:21:43.29,1:21:44.79,Default,,0,0,0,,Ах!
Dialogue: 0,1:21:49.80,1:21:52.29,Default,,0,0,0,,Сіз ауруханаға барасыз ба?
Dialogue: 0,1:21:52.29,1:21:54.30,Default,,0,0,0,,♪♪~
Dialogue: 0,1:21:54.30,1:21:57.81,Default,,0,0,0,,Рахмет!! ♪♪~ Уау.
Dialogue: 0,1:21:57.81,1:22:04.22,Default,,0,0,0,,♪♪~
Dialogue: 0,1:22:04.60,1:22:09.59,Default,,0,0,0,,Кешіріңіз, суық тиіп тұрса да, аурухана жеделхат жіберді.
Dialogue: 0,1:22:09.59,1:22:14.59,Default,,0,0,0,,Балалар, сендер уайымдап жатқандарыңа сенімдімін. Мен сені аяймын.
Dialogue: 0,1:22:14.59,1:22:17.08,Default,,0,0,0,,Жоқ, түсінсем жеңілдеп қаламын.
Dialogue: 0,1:22:17.08,1:22:20.65,Default,,0,0,0,,Сіз және басқалар осы уақытқа дейін көп еңбек еттіңіз.
Dialogue: 0,1:22:20.65,1:22:23.58,Default,,0,0,0,,Бұл көңіл көтеруді сәл ұзартады.
Dialogue: 0,1:22:23.58,1:22:27.57,Default,,0,0,0,,Менің ойымша, бұл балалар өздерін көрінгеннен де қатты итермеледі.
Dialogue: 0,1:22:27.57,1:22:31.09,Default,,0,0,0,,Мен Сатсукиге ренжідім, өйткені ол бір нәрсені жақсы естиді.
Dialogue: 0,1:22:31.29,1:22:33.29,Default,,0,0,0,,Дұрыс.
Dialogue: 0,1:22:33.29,1:22:37.30,Default,,0,0,0,,Ауруханадан шықсам, сол балалармен өзімшіл боламын →
Dialogue: 0,1:22:37.30,1:22:39.80,Default,,0,0,0,,Мен мұны істеуге рұқсат етемін. Ой ой….
Dialogue: 0,1:22:46.29,1:22:48.31,Default,,0,0,0,,Анам күліп тұр.
Dialogue: 0,1:22:48.31,1:22:50.81,Default,,0,0,0,,Жақсы сияқты. Иә.
Dialogue: 0,1:22:58.80,1:23:01.32,Default,,0,0,0,,Енді тезірек сауығып кетуіңіз керек.
Dialogue: 0,1:23:01.32,1:23:02.86,Default,,0,0,0,,Ах.
Dialogue: 0,1:23:02.86,1:23:04.86,Default,,0,0,0,,Иә?
Dialogue: 0,1:23:10.30,1:23:12.30,Default,,0,0,0,,Бұрын менің жинақтағы ақшам 20 000 йен болатын! Ах, ах…
Dialogue: 0,1:23:12.30,1:23:13.80,Default,,0,0,0,,​​О?
Dialogue: 0,1:23:13.80,1:23:15.30,Default,,0,0,0,,Не болды?
Dialogue: 0,1:23:15.30,1:23:17.29,Default,,0,0,0,,Қазір қарағайда→
Dialogue: 0,1:23:17.29,1:23:19.79,Default,,0,0,0,,Сатсуки мен Мэй күліп тұрғандай болды.
Dialogue: 0,1:23:21.77,1:23:25.27,Default,,0,0,0,,Бұл дұрыс болуы мүмкін.
Dialogue: 0,1:23:26.35,1:23:30.30,Default,,0,0,0,,♪♪~ «Менің көршім Тоторо»
