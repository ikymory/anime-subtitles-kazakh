Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.08,0:00:15.10,Default,,0,0,0,,♪♪~ «Жаяу жүру»
Dialogue: 0,0:00:15.10,0:00:31.00,Default,,0,0,0,,♪♪~
Dialogue: 0,0:00:31.00,0:00:35.02,Default,,0,0,0,,♪♪～ Аруку Аруку
Dialogue: 0,0:00:35.02,0:00:39.07,Default,,0,0,0,,♪♪~ Менде бәрі жақсы
Dialogue: 0,0:00:39.07,0:00:43.01,Default,,0,0,0,,♪♪～ Мен Аркуноны жақсы көремін
Dialogue: 0,0:00:43.01,0:00:47.03,Default,,0,0,0,,♪♪~ Әрі қарай жүрейік
Dialogue: 0,0:00:47.03,0:00:51.02,Default,,0,0,0,,♪♪~ Сакамичи туннелі
Dialogue: 0,0:00:51.02,0:00:55.01,Default,,0,0,0,,♪♪～ Құсаппара
Dialogue: 0,0:00:55.01,0:00:58.54,Default,,0,0,0,,♪♪～ Ipponbashi ni
Dialogue: 0,0:00:58.54,0:01:03.01,Default,,0,0,0,,♪♪~ Декобоко Джаримичи
Dialogue: 0,0:01:03.01,0:01:06.53,Default,,0,0,0,,♪♪~ Өрмекшілер арқылы өтіңіз
Dialogue: 0,0:01:06.53,0:01:11.02,Default,,0,0,0,,♪♪～ Кударимичи
Dialogue: 0,0:01:11.02,0:01:19.06,Default,,0,0,0,,♪♪~
Dialogue: 0,0:01:19.06,0:01:23.03,Default,,0,0,0,,♪♪～ Аруку Аруку
Dialogue: 0,0:01:23.03,0:01:27.02,Default,,0,0,0,,♪♪~ Менде бәрі жақсы
Dialogue: 0,0:01:27.02,0:01:31.01,Default,,0,0,0,,♪♪~ Мен Аркуноны жақсы көремін
Dialogue: 0,0:01:31.01,0:01:35.03,Default,,0,0,0,,♪♪~ Әрі қарай жүрейік
Dialogue: 0,0:01:35.03,0:01:39.08,Default,,0,0,0,,♪♪～ Түлкі мен енот та
Dialogue: 0,0:01:39.08,0:01:43.00,Default,,0,0,0,,♪♪～ Шық.
Dialogue: 0,0:01:43.00,0:01:46.52,Default,,0,0,0,,♪♪~ Біраз зерттеп көрейік
Dialogue: 0,0:01:46.52,0:01:51.01,Default,,0,0,0,,♪♪～ Хаяши но Окукуға дейін
Dialogue: 0,0:01:51.01,0:01:54.53,Default,,0,0,0,,♪♪～ Достар көп
Dialogue: 0,0:01:54.53,0:01:59.05,Default,,0,0,0,,♪♪~ Мен бақыттымын.
Dialogue: 0,0:01:59.05,0:02:02.51,Default,,0,0,0,,♪♪～ Достар көп
Dialogue: 0,0:02:02.51,0:02:09.53,Default,,0,0,0,,♪♪~ Мен бақыттымын.
Dialogue: 0,0:02:09.53,0:02:11.53,Default,,0,0,0,,♪♪~
Dialogue: 0,0:02:32.04,0:02:34.00,Default,,0,0,0,,Әкем Карамель.
Dialogue: 0,0:02:34.00,0:02:37.01,Default,,0,0,0,,Сәлем, рахмет. Шаршадыңыз ба?
Dialogue: 0,0:02:37.01,0:02:39.51,Default,,0,0,0,,Жоқ. Осы жерде.
Dialogue: 0,0:02:48.02,0:02:50.04,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:50.04,0:02:52.04,Default,,0,0,0,,Мамыр, жасырын!
Dialogue: 0,0:02:57.53,0:03:01.52,Default,,0,0,0,,Бұл полиция қызметкері емес еді!
Dialogue: 0,0:03:01.52,0:03:32.03,Default,,0,0,0,,♪♪~
Dialogue: 0,0:03:32.03,0:03:35.03,Default,,0,0,0,,Үйде біреу бар ма?
Dialogue: 0,0:03:36.53,0:03:38.53,Default,,0,0,0,,Сәлем.
Dialogue: 0,0:03:40.02,0:03:44.56,Default,,0,0,0,,Менің атым Құсақабе, мен жаңадан көшіп келдім!
Dialogue: 0,0:03:44.56,0:03:47.51,Default,,0,0,0,,Алдын ала рахмет.
Dialogue: 0,0:03:47.51,0:03:50.51,Default,,0,0,0,,Еңбегіңіз үшін рахмет!
Dialogue: 0,0:03:54.02,0:03:56.02,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:03:56.02,0:04:17.51,Default,,0,0,0,,♪♪~
Dialogue: 0,0:04:17.51,0:04:19.01,Default,,0,0,0,,Міне, келдік.
Dialogue: 0,0:04:19.01,0:04:22.01,Default,,0,0,0,,Уау! асылу!
Dialogue: 0,0:04:22.01,0:04:23.51,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:04:24.55,0:04:27.55,Default,,0,0,0,,Мамыр Көпір бар. көпір?
Dialogue: 0,0:04:32.51,0:04:35.03,Default,,0,0,0,,Балық! Қараңызшы, ол қайтадан жарқырайды.
Dialogue: 0,0:04:35.03,0:04:37.53,Default,,0,0,0,,Сізге қалай ұнайды?
Dialogue: 0,0:04:39.53,0:04:42.02,Default,,0,0,0,,Әке, сіз кереметсіз!
Dialogue: 0,0:04:42.02,0:04:44.02,Default,,0,0,0,,Ағаш туннелі!
Dialogue: 0,0:04:46.52,0:04:49.07,Default,,0,0,0,,Ах! Сол үй?
Dialogue: 0,0:04:49.07,0:04:50.57,Default,,0,0,0,,Уау! Ахаха!
Dialogue: 0,0:04:52.51,0:04:54.53,Default,,0,0,0,,Иә, Юта Отокоцу
Dialogue: 0,0:04:54.53,0:05:07.04,Default,,0,0,0,,♪♪~
Dialogue: 0,0:05:07.04,0:05:10.61,Default,,0,0,0,,Уау! Боро! Боро!
Dialogue: 0,0:05:10.61,0:05:13.51,Default,,0,0,0,,Аруақ үйіне ұқсайды! Елес пе?
Dialogue: 0,0:05:13.51,0:05:15.51,Default,,0,0,0,,Ахаха….
Dialogue: 0,0:05:20.50,0:05:22.50,Default,,0,0,0,,Ол шірік.
Dialogue: 0,0:05:25.53,0:05:28.03,Default,,0,0,0,,Ахахха. Хахахаха.
Dialogue: 0,0:05:30.58,0:05:34.00,Default,,0,0,0,,Уау!? Ахахха.
Dialogue: 0,0:05:34.00,0:05:38.00,Default,,0,0,0,,Ол бұзылады! Ол бұзылады!
Dialogue: 0,0:05:47.51,0:05:50.01,Default,,0,0,0,,Қарауға болады. Иә?
Dialogue: 0,0:05:51.59,0:05:53.09,Default,,0,0,0,,Қара!
Dialogue: 0,0:06:01.51,0:06:05.01,Default,,0,0,0,,Бұл үлкен. Хакшун.
Dialogue: 0,0:06:09.02,0:06:12.02,Default,,0,0,0,,Әке, қандай керемет ағаш!
Dialogue: 0,0:06:12.02,0:06:14.52,Default,,0,0,0,,А, бұл камфора ағашы.
Dialogue: 0,0:06:16.58,0:06:19.08,Default,,0,0,0,,Камфора ағашы! Камфора ағашы!
Dialogue: 0,0:06:22.02,0:06:23.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:27.54,0:06:29.04,Default,,0,0,0,,Бұл бітсе, бірдеңе жейміз бе? Егер қаласаң, көңіліңді көтерейін.
Dialogue: 0,0:06:31.01,0:06:32.51,Default,,0,0,0,,Желу.
Dialogue: 0,0:06:34.01,0:06:37.05,Default,,0,0,0,,Уау, көрсетші!
Dialogue: 0,0:06:37.05,0:06:39.05,Default,,0,0,0,,Бір сәт... олардың сонша көп емес қой!
Dialogue: 0,0:06:44.50,0:06:46.52,Default,,0,0,0,,Міне болды!
Dialogue: 0,0:06:46.52,0:06:48.52,Default,,0,0,0,,Хмм?
Dialogue: 0,0:06:52.53,0:06:55.52,Default,,0,0,0,,Кола Кора... Жапқыштарды аша алмайсың ғой?
Dialogue: 0,0:06:55.52,0:06:59.04,Default,,0,0,0,,Желу! Бөлмеде желелер құлап жатыр.
Dialogue: 0,0:06:59.04,0:07:01.59,Default,,0,0,0,,Ол жоғарыдан құлады.
Dialogue: 0,0:07:01.59,0:07:03.59,Default,,0,0,0,,Хмм….
Dialogue: 0,0:07:05.03,0:07:08.51,Default,,0,0,0,,Тиіндер бар...бірақ бар ма?
Dialogue: 0,0:07:08.51,0:07:10.01,Default,,0,0,0,,Тиін!? Тиін!?
Dialogue: 0,0:07:11.03,0:07:13.52,Default,,0,0,0,,Әлде желекті жақсы көретін тышқан болуы мүмкін бе?
Dialogue: 0,0:07:13.52,0:07:16.02,Default,,0,0,0,,Е! Мэй Лис жақсы!
Dialogue: 0,0:07:16.02,0:07:18.54,Default,,0,0,0,,Мұны қайда апарасың?
Dialogue: 0,0:07:18.54,0:07:21.09,Default,,0,0,0,,О, мен оны қазір аша аламын.
Dialogue: 0,0:07:21.09,0:07:24.03,Default,,0,0,0,,Сатсуки Артқы есікті ашыңыз. Иә.
Dialogue: 0,0:07:24.03,0:07:26.53,Default,,0,0,0,,Барсаң түсінерсің. Иә.
Dialogue: 0,0:07:27.53,0:07:29.53,Default,,0,0,0,,Келіңіздер.
Dialogue: 0,0:07:30.53,0:07:32.53,Default,,0,0,0,,Күтіңіз~.
Dialogue: 0,0:07:33.54,0:07:35.54,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:07:48.54,0:07:50.04,Default,,0,0,0,,Капитан Магатоға не деп тұрсың!!
Dialogue: 0,0:08:05.10,0:08:08.60,Default,,0,0,0,,Уау!! Апыр-ай!!
Dialogue: 0,0:08:13.53,0:08:15.53,Default,,0,0,0,,Кеттік. Иә.
Dialogue: 0,0:08:27.02,0:08:29.02,Default,,0,0,0,,Ванна. Иә.
Dialogue: 0,0:08:34.01,0:08:36.51,Default,,0,0,0,,Онда жоқ. Иә.
Dialogue: 0,0:08:37.53,0:08:39.02,Default,,0,0,0,,Бұл ванна.
Dialogue: 0,0:08:39.02,0:08:42.02,Default,,0,0,0,,Әке, мұнда не болып жатыр? Бұл тиін ме?
Dialogue: 0,0:08:42.02,0:08:45.03,Default,,0,0,0,,Мен білмеймін. Бұл тарақан емес. Бұл егеуқұйрық емес.→
Dialogue: 0,0:08:45.03,0:08:48.53,Default,,0,0,0,,Қаралар көп болды. Хмм.
Dialogue: 0,0:08:59.52,0:09:01.02,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:09:02.53,0:09:05.01,Default,,0,0,0,,Бұл қара крест.
Dialogue: 0,0:09:05.01,0:09:07.53,Default,,0,0,0,,Қара түсті куросуке!? Ол суретті кітапта пайда болды ма?
Dialogue: 0,0:09:07.53,0:09:11.53,Default,,0,0,0,,Дұрыс, мұндай жақсы ауа-райында елестер пайда болуы мүмкін емес.
Dialogue: 0,0:09:16.07,0:09:19.03,Default,,0,0,0,,Кенеттен жарық жерден қараңғы жерге өткенде→
Dialogue: 0,0:09:19.03,0:09:22.01,Default,,0,0,0,,Менің көзім соқыр болып, қара крест пайда болады.
Dialogue: 0,0:09:22.01,0:09:23.51,Default,,0,0,0,,Оған сіздер, студенттер де кіресіздер.
Dialogue: 0,0:09:23.51,0:09:26.02,Default,,0,0,0,,♪~ Жетілген қара крест суке
Dialogue: 0,0:09:26.02,0:09:31.02,Default,,0,0,0,,♪~ Шық, әйтпесе көзіңнен жұдырықтаймын.
Dialogue: 0,0:09:32.52,0:09:35.58,Default,,0,0,0,,Хахаха! Хахаха!
Dialogue: 0,0:09:35.58,0:09:41.01,Default,,0,0,0,,Енді жұмыс істе, жұмыс! Екінші қабатқа баспалдақтар қай жерде?
Dialogue: 0,0:09:41.01,0:09:42.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:42.52,0:09:45.50,Default,,0,0,0,,Баспалдақты табыңыз және екінші қабаттағы терезені ашыңыз.
Dialogue: 0,0:09:45.50,0:09:48.00,Default,,0,0,0,,Иә. О, Мэй де!
Dialogue: 0,0:09:56.55,0:09:58.55,Default,,0,0,0,,Дәретхана!
Dialogue: 0,0:10:00.52,0:10:02.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:04.54,0:10:07.04,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:10:10.03,0:10:12.53,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:10:14.51,0:10:17.51,Default,,0,0,0,,Ой! иә?
Dialogue: 0,0:10:19.12,0:10:20.52,Default,,0,0,0,,Мен саған кір жудым.
Dialogue: 0,0:10:20.52,0:10:22.02,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:10:22.02,0:10:24.52,Default,,0,0,0,,Ей! Ол аурады.
Dialogue: 0,0:10:31.53,0:10:34.53,Default,,0,0,0,,Ах! Мэй Міне болды!
Dialogue: 0,0:10:41.01,0:10:44.51,Default,,0,0,0,,Бұл тас қараңғы. Қатты қара крест...
Dialogue: 0,0:10:52.54,0:10:54.04,Default,,0,0,0,,Желу.
Dialogue: 0,0:11:00.51,0:11:04.51,Default,,0,0,0,,♪~ Қара крестпен шығыңыз
Dialogue: 0,0:11:26.52,0:11:30.02,Default,,0,0,0,,Уау...! Апыр-ай…!
Dialogue: 0,0:11:43.54,0:11:47.52,Default,,0,0,0,,Куросуке-сан сонда ма?
Dialogue: 0,0:11:47.52,0:11:52.52,Default,,0,0,0,,♪♪~
Dialogue: 0,0:12:12.52,0:12:16.50,Default,,0,0,0,,Әке! Өйткені, бұл үйде бірдеңе бар!
Dialogue: 0,0:12:16.50,0:12:20.02,Default,,0,0,0,,Бұл керемет! Арулар үйінде тұру →
Dialogue: 0,0:12:20.02,0:12:23.04,Default,,0,0,0,,Бұл әкемнің бала кезімнен арманы.
Dialogue: 0,0:12:23.04,0:12:24.58,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:24.58,0:12:27.08,Default,,0,0,0,,Әй, бұл қиын!
Dialogue: 0,0:12:51.60,0:12:53.02,Default,,0,0,0,,♪♪~ Уау!!
Dialogue: 0,0:12:53.02,0:13:12.53,Default,,0,0,0,,♪♪~
Dialogue: 0,0:13:12.53,0:13:15.03,Default,,0,0,0,,Мен оны алдым! Үлкен әпке!
Dialogue: 0,0:13:23.02,0:13:24.52,Default,,0,0,0,,Уф!
Dialogue: 0,0:13:25.51,0:13:27.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:27.56,0:13:29.56,Default,,0,0,0,,Уау! мамыр.
Dialogue: 0,0:13:39.00,0:13:42.01,Default,,0,0,0,,Ахаха менде бәрі жақсы.
Dialogue: 0,0:13:42.01,0:13:45.01,Default,,0,0,0,,Бұл үйді басқаратын көрші әже.
Dialogue: 0,0:13:45.01,0:13:47.03,Default,,0,0,0,,Олар бізді қолдауға келді.
Dialogue: 0,0:13:47.03,0:13:51.01,Default,,0,0,0,,Сатсукиге: Сәлем, бұл менің кіші әпкем Мэй.
Dialogue: 0,0:13:51.01,0:13:56.12,Default,,0,0,0,,Иә, сәлем, сен ақылды бала сияқтысың.
Dialogue: 0,0:13:56.12,0:14:00.01,Default,,0,0,0,,Осыншама асығыс болмасам, үй шаруасымен айналысар едім.
Dialogue: 0,0:14:00.01,0:14:02.53,Default,,0,0,0,,Хахаха жетеді.
Dialogue: 0,0:14:02.53,0:14:05.53,Default,,0,0,0,,Бұл уақытта күріш алқаптары қызу.
Dialogue: 0,0:14:05.53,0:14:09.02,Default,,0,0,0,,Бірақ мен кейде үй жинамайтынмын.
Dialogue: 0,0:14:09.02,0:14:12.52,Default,,0,0,0,,Мэй: Менің қолым қара емес. Не болды?
Dialogue: 0,0:14:12.52,0:14:15.04,Default,,0,0,0,,Қара түсті Куросуке қашып кетті.
Dialogue: 0,0:14:15.04,0:14:17.09,Default,,0,0,0,,Әй, Мэйдің аяғы!
Dialogue: 0,0:14:17.09,0:14:19.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:20.53,0:14:23.53,Default,,0,0,0,,Ах~ Менікі де тас қараңғы.
Dialogue: 0,0:14:23.53,0:14:29.54,Default,,0,0,0,,Хуу... Жоқ, жоқ, жоқ, жоқ, жоқ.
Dialogue: 0,0:14:29.54,0:14:34.54,Default,,0,0,0,,Иә... Сонымен Сусватари пайда болды.
Dialogue: 0,0:14:34.54,0:14:37.09,Default,,0,0,0,,Сусватари? Сусватари →
Dialogue: 0,0:14:37.09,0:14:40.51,Default,,0,0,0,,Бұл сізді қыжылдайтын нәрсе ме?
Dialogue: 0,0:14:40.51,0:14:45.02,Default,,0,0,0,,Мен ешкім жоқ ескі үйдемін →
Dialogue: 0,0:14:45.02,0:14:49.51,Default,,0,0,0,,Әр жерді күйе басып, шаң басып қалады.
Dialogue: 0,0:14:49.51,0:14:53.03,Default,,0,0,0,,Кішкентай кезімде мен де көретінмін →
Dialogue: 0,0:14:53.03,0:14:57.08,Default,,0,0,0,,Түсіндім, сен де көрдің.
Dialogue: 0,0:14:57.08,0:14:59.62,Default,,0,0,0,,Бұл құбыжық па?
Dialogue: 0,0:14:59.62,0:15:03.52,Default,,0,0,0,,Сонда бұл соншалықты қорқынышты болмас еді.
Dialogue: 0,0:15:03.52,0:15:07.04,Default,,0,0,0,,Күлсең, жаман ештеңе болмайды→
Dialogue: 0,0:15:07.04,0:15:10.51,Default,,0,0,0,,Білмей тұрып, ұйқың келеді.
Dialogue: 0,0:15:10.51,0:15:15.01,Default,,0,0,0,,Менің ойымша, олар қазір шатырда көшу туралы айтып жатыр ма деп ойлаймын.
Dialogue: 0,0:15:20.59,0:15:23.54,Default,,0,0,0,,Мэй: Барлығы қашып жатыр. Бұл қызықсыз.
Dialogue: 0,0:15:23.54,0:15:26.54,Default,,0,0,0,,Өйткені осындай нәрсе шықса не істер едің?
Dialogue: 0,0:15:26.54,0:15:28.51,Default,,0,0,0,,Мэй Бұл қорқынышты емес.
Dialogue: 0,0:15:28.51,0:15:32.53,Default,,0,0,0,,Әй, түнде менімен бірге ваннаға келмейсің бе?
Dialogue: 0,0:15:32.53,0:15:39.59,Default,,0,0,0,,Ахахха... Жүр, жинап алайық. Өзеннен су алып кел.
Dialogue: 0,0:15:39.59,0:15:42.59,Default,,0,0,0,,Өзен жағасында? Мэй де барады!
Dialogue: 0,0:15:43.19,0:15:45.21,Default,,0,0,0,,Ахаха! Ахаха!
Dialogue: 0,0:15:45.21,0:15:47.71,Default,,0,0,0,,Мей, сонда күте тұр.
Dialogue: 0,0:15:56.72,0:15:58.72,Default,,0,0,0,,Сіз балық ұстадыңыз ба?
Dialogue: 0,0:16:10.20,0:16:12.72,Default,,0,0,0,,Әже осында!
Dialogue: 0,0:16:12.72,0:16:17.69,Default,,0,0,0,,Су салқындағанша.
Dialogue: 0,0:16:17.69,0:16:19.19,Default,,0,0,0,,Иә.
Dialogue: 0,0:16:19.19,0:16:44.22,Default,,0,0,0,,♪♪~
Dialogue: 0,0:17:00.72,0:17:04.74,Default,,0,0,0,,А, жай... не? Бірдеңе керек пе?
Dialogue: 0,0:17:04.74,0:17:08.74,Default,,0,0,0,,Немесе... анам менің әжем болды...
Dialogue: 0,0:17:09.71,0:17:11.21,Default,,0,0,0,,Не?
Dialogue: 0,0:17:13.71,0:17:15.72,Default,,0,0,0,,Жоқ! сурет?
Dialogue: 0,0:17:15.72,0:17:17.70,Default,,0,0,0,,Иә! а….
Dialogue: 0,0:17:17.70,0:17:19.70,Default,,0,0,0,,Күте тұрыңыз! Бұл не?
Dialogue: 0,0:17:19.70,0:17:21.70,Default,,0,0,0,,Канта?
Dialogue: 0,0:17:23.72,0:17:29.21,Default,,0,0,0,,Ия, сенің үйің арулар үйі!
Dialogue: 0,0:17:29.21,0:17:31.21,Default,,0,0,0,,Канта~!!
Dialogue: 0,0:17:33.20,0:17:35.20,Default,,0,0,0,,Бае~!
Dialogue: 0,0:17:38.22,0:17:43.23,Default,,0,0,0,,Ахахаха әкемнің де есінде.
Dialogue: 0,0:17:43.23,0:17:45.26,Default,,0,0,0,,Мен ұлдарды жек көремін!
Dialogue: 0,0:17:45.26,0:17:49.20,Default,,0,0,0,,Бірақ маған әжемнің охаги қатты ұнайды!
Dialogue: 0,0:17:49.20,0:17:51.72,Default,,0,0,0,,Танто Оагари.
Dialogue: 0,0:17:51.72,0:17:53.72,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:17:56.22,0:17:59.23,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:17:59.23,0:18:02.21,Default,,0,0,0,,Қош бол. Қош бол.
Dialogue: 0,0:18:02.21,0:18:24.21,Default,,0,0,0,,♪♪~
Dialogue: 0,0:18:37.00,0:18:39.52,Default,,0,0,0,,Уау!!
Dialogue: 0,0:18:39.52,0:19:04.00,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:19:16.57,0:19:19.51,Default,,0,0,0,,Әкесі: Үй апатты, сондықтан құлап қалады.
Dialogue: 0,0:19:19.51,0:19:24.53,Default,,0,0,0,,Хахаха Көшкеннен кейін компания банкрот болса, ұят болар еді.
Dialogue: 0,0:19:24.53,0:19:26.53,Default,,0,0,0,,(шу)
Dialogue: 0,0:19:44.50,0:19:47.00,Default,,0,0,0,,(Үкідің ұлуы)
Dialogue: 0,0:19:47.00,0:19:48.50,Default,,0,0,0,,Ха!
Dialogue: 0,0:19:55.51,0:19:59.53,Default,,0,0,0,,Хахаха!
Dialogue: 0,0:19:59.53,0:20:03.10,Default,,0,0,0,,Барлығыңыз күліп көріңіздер, өйткені қорқыныштылар қашып кетеді.
Dialogue: 0,0:20:03.10,0:20:05.00,Default,,0,0,0,,Хахаха!
Dialogue: 0,0:20:05.00,0:20:07.99,Default,,0,0,0,,Мэй Бұл қорқынышты емес. Хахахаха!
Dialogue: 0,0:20:07.99,0:20:10.51,Default,,0,0,0,,Бұл қорқынышты емес!
Dialogue: 0,0:20:10.51,0:20:13.01,Default,,0,0,0,,Кя~! Ахахха!
Dialogue: 0,0:20:13.01,0:20:16.51,Default,,0,0,0,,Гау!
Dialogue: 0,0:20:16.51,0:20:53.00,Default,,0,0,0,,♪♪~
Dialogue: 0,0:20:54.00,0:20:57.00,Default,,0,0,0,,Ичи Ни Ичи Ни Ичи Ни….
Dialogue: 0,0:20:57.00,0:21:01.00,Default,,0,0,0,,Жолың болсын, жолың болсын, жолың болсын! Ичи ни ичи ни….
Dialogue: 0,0:21:06.01,0:21:08.50,Default,,0,0,0,,Жарайды, кір жуылды.
Dialogue: 0,0:21:08.50,0:21:10.50,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:21:18.53,0:21:20.53,Default,,0,0,0,,Кету!
Dialogue: 0,0:21:20.53,0:21:23.58,Default,,0,0,0,,♪♪~
Dialogue: 0,0:21:23.58,0:21:28.00,Default,,0,0,0,,♪♪~ О~о... Ах~!
Dialogue: 0,0:21:28.00,0:21:36.99,Default,,0,0,0,,♪♪~
Dialogue: 0,0:21:36.99,0:21:40.00,Default,,0,0,0,,≪Әже! ≫
Dialogue: 0,0:21:40.00,0:21:44.55,Default,,0,0,0,,Сәлеметсіз бе! Сіздің энергияңыз ағып жатыр.
Dialogue: 0,0:21:44.55,0:21:47.50,Default,,0,0,0,,Бірге шығайық!
Dialogue: 0,0:21:47.50,0:21:50.51,Default,,0,0,0,,Мен анама қонаққа барамын!
Dialogue: 0,0:21:50.51,0:21:55.51,Default,,0,0,0,,Бұл тамаша. Сәлем айтыңыз.
Dialogue: 0,0:21:55.51,0:21:57.01,Default,,0,0,0,,Иә.
Dialogue: 0,0:21:58.00,0:22:01.00,Default,,0,0,0,,Бае~!
Dialogue: 0,0:22:01.00,0:22:13.00,Default,,0,0,0,,♪♪~
Dialogue: 0,0:22:13.00,0:22:15.02,Default,,0,0,0,,♪♪~ Ах~ Міне, міне.
Dialogue: 0,0:22:15.02,0:22:35.51,Default,,0,0,0,,♪♪~
Dialogue: 0,0:22:42.28,0:22:44.25,Default,,0,0,0,,Сәлеметсіз бе. Қош келдіңіз.
Dialogue: 0,0:22:44.25,0:22:46.26,Default,,0,0,0,,Қандай азап…
Dialogue: 0,0:22:46.26,0:22:49.77,Default,,0,0,0,,Анашым!! (Анашым) Мей сен жиі келдің.
Dialogue: 0,0:22:49.77,0:22:52.27,Default,,0,0,0,,Әке мен бұрыс бұрылдым.
Dialogue: 0,0:22:52.69,0:22:55.23,Default,,0,0,0,,Иә... Қош келдіңіз.
Dialogue: 0,0:22:55.23,0:22:58.68,Default,,0,0,0,,Бүгін күріш егуден демалыс күні. А, түсіндім.
Dialogue: 0,0:22:58.68,0:23:03.70,Default,,0,0,0,,Әке Мен мұғаліммен сөйлесіп тұрмын. Барлығының келгеніне қуаныштымын.
Dialogue: 0,0:23:03.70,0:23:07.20,Default,,0,0,0,,Жаңа үйіңіз туралы не ойлайсыз? Сіз әлі тынышталдыңыз ба?
Dialogue: 0,0:23:09.69,0:23:11.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:12.21,0:23:15.28,Default,,0,0,0,,Не? Аруақты үй!? Иә.
Dialogue: 0,0:23:15.28,0:23:17.20,Default,,0,0,0,,Анашым, сізге елес үйлер ұнайды ма?
Dialogue: 0,0:23:17.20,0:23:20.67,Default,,0,0,0,,Әрине! Тезірек ауруханадан шығып, елестерді көргім келеді.
Dialogue: 0,0:23:20.67,0:23:23.17,Default,,0,0,0,,Жарайсың, Мамыр. Иә.
Dialogue: 0,0:23:23.17,0:23:26.67,Default,,0,0,0,,Анам ұнатпаса, қиналып қаламын ба деп уайымдадым.
Dialogue: 0,0:23:26.67,0:23:29.16,Default,,0,0,0,,Сатсуки мен Мэй ше? ұнайды!
Dialogue: 0,0:23:29.16,0:23:31.21,Default,,0,0,0,,Мен қорықпаймын.
Dialogue: 0,0:23:31.21,0:23:36.18,Default,,0,0,0,,Уфуфуфу Сатсуки Мэйдің шашын байлап жатыр ма?
Dialogue: 0,0:23:36.18,0:23:40.17,Default,,0,0,0,,Иә. Сен жақсысың... Жақсы, Мэй.
Dialogue: 0,0:23:40.17,0:23:43.17,Default,,0,0,0,,Иә... Бірақ апам тез ашуланады.
Dialogue: 0,0:23:43.17,0:23:45.19,Default,,0,0,0,,Өйткені Мэй тыныш болмайды.
Dialogue: 0,0:23:45.19,0:23:47.68,Default,,0,0,0,,Сатсуки, жүр.
Dialogue: 0,0:23:47.68,0:23:51.21,Default,,0,0,0,,Бұл тым қысқа емес пе? Маған бұл көбірек ұнайды.
Dialogue: 0,0:23:51.21,0:23:54.67,Default,,0,0,0,,Мэй де! Мен де! тапсырыс!
Dialogue: 0,0:23:54.67,0:23:59.17,Default,,0,0,0,,Менің бала кезімдегідей шашыңыз әлі бұйра.
Dialogue: 0,0:23:59.17,0:24:03.66,Default,,0,0,0,,Мен өскенде шашым анамдікіндей бола ма?
Dialogue: 0,0:24:03.66,0:24:07.68,Default,,0,0,0,,Анаңа ұқсайтындықтан шығар.
Dialogue: 0,0:24:07.68,0:24:25.18,Default,,0,0,0,,♪♪~
Dialogue: 0,0:24:25.18,0:24:28.69,Default,,0,0,0,,Анашым, сіздің жағдайыңыз жақсы сияқты. Аа, дұрыс.
Dialogue: 0,0:24:28.69,0:24:31.69,Default,,0,0,0,,Дәрігер де жақын арада ауруханадан шыға алатынымды айтты.
Dialogue: 0,0:24:31.69,0:24:33.67,Default,,0,0,0,,Ертең тағы да?
Dialogue: 0,0:24:33.67,0:24:38.26,Default,,0,0,0,,Мэйдің «ертеңі» қайтадан басталды. Ертең біраз мүмкін емес.
Dialogue: 0,0:24:38.26,0:24:41.68,Default,,0,0,0,,Анасы футонында Мэймен ұйықтағысы келеді.
Dialogue: 0,0:24:41.68,0:24:45.67,Default,,0,0,0,,Иә? Енді Мэй қартайған соң, жалғыз ұйықтап жатқан жоқ па?
Dialogue: 0,0:24:45.67,0:24:47.67,Default,,0,0,0,,Анаң жақсы ма!!
Dialogue: 0,0:24:47.67,0:24:49.67,Default,,0,0,0,,Хахаха. Ахахха.
Dialogue: 0,0:24:56.73,0:25:09.68,Default,,0,0,0,,♪♪~
Dialogue: 0,0:25:09.68,0:25:13.68,Default,,0,0,0,,Әке! Таң атты!
Dialogue: 0,0:25:15.67,0:25:19.17,Default,,0,0,0,,Ей! Оян!!
Dialogue: 0,0:25:24.68,0:25:28.70,Default,,0,0,0,,Кешіріңіз, мен тағы ұйықтап қалдым. Бүгіннен бастап мен түскі ас ішемін.
Dialogue: 0,0:25:28.70,0:25:31.18,Default,,0,0,0,,Мен оны мүлдем ұмытып кеттім.
Dialogue: 0,0:25:31.18,0:25:33.67,Default,,0,0,0,,Жарайды, мен де бәріне жасап беремін.
Dialogue: 0,0:25:33.67,0:25:36.17,Default,,0,0,0,,Өртеніп кетті! асылу.
Dialogue: 0,0:25:38.36,0:25:41.43,Default,,0,0,0,,Бұл мамыр айы.
Dialogue: 0,0:25:41.43,0:25:45.31,Default,,0,0,0,,Мэйдің!? Мэй, отыр да тамақ іш.
Dialogue: 0,0:25:45.31,0:25:46.81,Default,,0,0,0,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:25:46.81,0:25:48.81,Default,,0,0,0,,Оны өзіңіз ораңыз.
Dialogue: 0,0:25:52.34,0:25:55.34,Default,,0,0,0,,Са-цуки-чан!
Dialogue: 0,0:25:55.34,0:25:59.84,Default,,0,0,0,,О, бұл қиын! Иә!
Dialogue: 0,0:26:00.86,0:26:05.33,Default,,0,0,0,,Сіз әлі достар таптыңыз ба? «Са-цуки-чан».
Dialogue: 0,0:26:05.33,0:26:07.33,Default,,0,0,0,,Иә, менің атым Миччан.
Dialogue: 0,0:26:09.32,0:26:10.82,Default,,0,0,0,,Тамақ бергеніңіз үшін рахмет.
Dialogue: 0,0:26:11.84,0:26:13.82,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:26:13.82,0:26:16.32,Default,,0,0,0,,Қош келдіңіз. Келіңіздер.
Dialogue: 0,0:26:17.33,0:26:20.83,Default,,0,0,0,,Қайырлы таң. Қайырлы таң, ерте барайық.
Dialogue: 0,0:26:30.32,0:26:32.84,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:26:32.84,0:26:35.33,Default,,0,0,0,,Әке.
Dialogue: 0,0:26:35.33,0:26:37.83,Default,,0,0,0,,Май, сен үлкен апаға ұқсайсың ба?
Dialogue: 0,0:26:37.83,0:26:41.83,Default,,0,0,0,,Иә, түскі ас қорабыммен қайда баруым керек? Біраз ғана сонда.
Dialogue: 0,0:27:03.84,0:27:08.84,Default,,0,0,0,,Әке, түскі асыңызды жинадыңыз ба? иә? Қазірдің өзінде?
Dialogue: 0,0:27:20.34,0:27:23.34,Default,,0,0,0,,Әкесі: Ол гүл сататын дүкен.
Dialogue: 0,0:27:39.33,0:27:41.33,Default,,0,0,0,,Ожама такси!
Dialogue: 0,0:27:41.33,0:27:58.31,Default,,0,0,0,,♪♪~
Dialogue: 0,0:27:58.31,0:28:02.33,Default,,0,0,0,,Ах! Бұл... ең түбі!
Dialogue: 0,0:28:02.33,0:28:04.32,Default,,0,0,0,,Ах!
Dialogue: 0,0:28:04.32,0:28:14.88,Default,,0,0,0,,♪♪~
Dialogue: 0,0:28:14.88,0:28:17.43,Default,,0,0,0,,♪♪~ Микке!
Dialogue: 0,0:28:17.43,0:28:21.34,Default,,0,0,0,,♪♪~ Ах! Ах!
Dialogue: 0,0:28:21.34,0:28:31.83,Default,,0,0,0,,♪♪~
Dialogue: 0,0:28:31.83,0:28:34.31,Default,,0,0,0,,♪♪~ Уау….
Dialogue: 0,0:28:34.31,0:28:51.83,Default,,0,0,0,,♪♪~
Dialogue: 0,0:28:51.83,0:28:53.82,Default,,0,0,0,,♪♪~ Уу хи хи....
Dialogue: 0,0:28:53.82,0:29:07.83,Default,,0,0,0,,♪♪~
Dialogue: 0,0:29:07.83,0:29:09.33,Default,,0,0,0,,​​О?
Dialogue: 0,0:29:16.32,0:29:17.82,Default,,0,0,0,,Ах!
Dialogue: 0,0:29:17.82,0:29:29.82,Default,,0,0,0,,♪♪~
Dialogue: 0,0:29:34.32,0:29:35.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:44.82,0:29:46.32,Default,,0,0,0,,Қандай азап…
Dialogue: 0,0:30:25.83,0:30:27.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:27.84,0:30:30.33,Default,,0,0,0,,♪♪~
Dialogue: 0,0:30:30.33,0:30:31.83,Default,,0,0,0,,♪♪~ Ах~!
Dialogue: 0,0:30:31.83,0:30:38.86,Default,,0,0,0,,♪♪~
Dialogue: 0,0:30:38.86,0:30:40.39,Default,,0,0,0,,♪♪~ Уау!
Dialogue: 0,0:30:40.39,0:30:47.83,Default,,0,0,0,,♪♪~
Dialogue: 0,0:30:47.83,0:30:49.32,Default,,0,0,0,,♪♪~ Ах~!
Dialogue: 0,0:30:49.32,0:31:26.84,Default,,0,0,0,,♪♪~
Dialogue: 0,0:31:29.40,0:31:30.90,Default,,0,0,0,,Ах.
Dialogue: 0,0:31:39.39,0:31:41.39,Default,,0,0,0,,Ах!
Dialogue: 0,0:32:19.90,0:32:21.40,Default,,0,0,0,,Ах!
Dialogue: 0,0:32:22.90,0:32:24.90,Default,,0,0,0,,Ахаха!
Dialogue: 0,0:32:26.41,0:32:27.91,Default,,0,0,0,,Хэхехе.
Dialogue: 0,0:32:28.89,0:32:30.89,Default,,0,0,0,,Кя!
Dialogue: 0,0:32:31.90,0:32:34.90,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:32:41.41,0:32:43.41,Default,,0,0,0,,Э? Естімеймін.
Dialogue: 0,0:32:57.46,0:33:01.96,Default,,0,0,0,,Гво~….
Dialogue: 0,0:33:04.43,0:33:05.93,Default,,0,0,0,,Уууу.
Dialogue: 0,0:33:12.40,0:33:16.91,Default,,0,0,0,,Гво~….
Dialogue: 0,0:33:16.91,0:33:18.91,Default,,0,0,0,,Аха!
Dialogue: 0,0:33:25.90,0:33:28.90,Default,,0,0,0,,Тағзым~!!
Dialogue: 0,0:33:52.91,0:33:56.93,Default,,0,0,0,,Сіз кімсіз? Қара крест ске?
Dialogue: 0,0:33:56.93,0:34:06.93,Default,,0,0,0,,Кімге... Кімге... Ро~!
Dialogue: 0,0:34:07.91,0:34:12.91,Default,,0,0,0,,Гваа!!
Dialogue: 0,0:34:15.92,0:34:22.92,Default,,0,0,0,,Кімге... Кімге... Ро~!
Dialogue: 0,0:34:24.46,0:34:28.46,Default,,0,0,0,,Тоторо!! Сенің атың Тоторо!
Dialogue: 0,0:34:32.42,0:34:34.92,Default,,0,0,0,,Бұл Тоторо ғой.
Dialogue: 0,0:34:36.92,0:34:38.92,Default,,0,0,0,,Тоторо.
Dialogue: 0,0:35:03.41,0:35:46.91,Default,,0,0,0,,♪♪~
Dialogue: 0,0:35:46.91,0:35:49.41,Default,,0,0,0,,Сонда кездескенше. Кейінірек кездесеміз.
Dialogue: 0,0:35:50.90,0:35:52.91,Default,,0,0,0,,Дәл қазір. Қайтадан қош келдіңіз.
Dialogue: 0,0:35:52.91,0:35:56.90,Default,,0,0,0,,Аа, бұл қазірдің өзінде ұзақ. Мэй ше? Мен Мичканның үйіне бара жатырмын.
Dialogue: 0,0:35:56.90,0:36:00.47,Default,,0,0,0,,Мен түскі асымды әлі ішкен жоқпын. Мэй, сіз бақшада ойнағыңыз келе ме?
Dialogue: 0,0:36:00.47,0:36:04.47,Default,,0,0,0,,мамыр! мамыр!
Dialogue: 0,0:36:05.43,0:36:07.43,Default,,0,0,0,,мамыр!
Dialogue: 0,0:36:09.41,0:36:11.41,Default,,0,0,0,,мамыр!
Dialogue: 0,0:36:17.42,0:36:21.42,Default,,0,0,0,,Әке! Майдың қалпағы болды!
Dialogue: 0,0:36:31.40,0:36:32.90,Default,,0,0,0,,Ах.
Dialogue: 0,0:36:36.41,0:36:38.41,Default,,0,0,0,,Мамыр... мамыр.
Dialogue: 0,0:36:45.45,0:36:49.02,Default,,0,0,0,,мамыр! Эй, оян!
Dialogue: 0,0:36:49.02,0:36:52.02,Default,,0,0,0,,Мұндай жерде ұйықтау жақсы емес!
Dialogue: 0,0:36:53.42,0:36:56.43,Default,,0,0,0,,Тоторо ше? Тоторо?
Dialogue: 0,0:36:56.43,0:36:58.93,Default,,0,0,0,,(Цубаки) Косей! Уф!
Dialogue: 0,0:37:00.92,0:37:04.92,Default,,0,0,0,,Сіз армандадыңыз ба? Тоторо сонда болды.
Dialogue: 0,0:37:04.92,0:37:08.46,Default,,0,0,0,,Тоторо суретті кітаптарда пайда болған тролльге сілтеме жасай ма?
Dialogue: 0,0:37:08.46,0:37:11.51,Default,,0,0,0,,Иә, Тоторо дұрыс айтты.
Dialogue: 0,0:37:11.51,0:37:15.41,Default,,0,0,0,,Шашы бар, аузы осындай→
Dialogue: 0,0:37:15.41,0:37:22.91,Default,,0,0,0,,Мынадай бірдеңе, мынандай үлкен нәрсе, осындай үлкен нәрсе ұйықтап жатыр.
Dialogue: 0,0:37:25.91,0:37:31.98,Default,,0,0,0,,Бұл... Ей, бұл керемет. Бұл құпия базаға ұқсайды.
Dialogue: 0,0:37:31.98,0:37:34.92,Default,,0,0,0,,Мэй әке: Тотороны осында кездестіргеніңізді естідім.
Dialogue: 0,0:37:34.92,0:37:36.92,Default,,0,0,0,,Тоторо? Иә.
Dialogue: 0,0:37:36.92,0:37:38.42,Default,,0,0,0,,Мұнда!
Dialogue: 0,0:37:46.41,0:37:48.41,Default,,0,0,0,,Эй, күте тұрыңыз.
Dialogue: 0,0:37:49.95,0:37:51.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:53.52,0:37:56.42,Default,,0,0,0,,Мұнда? Уф.
Dialogue: 0,0:37:56.42,0:37:59.42,Default,,0,0,0,,Бұрын мен үлкен ағашқа бардым.
Dialogue: 0,0:37:59.42,0:38:01.91,Default,,0,0,0,,Бірақ бұл тура жол болды.
Dialogue: 0,0:38:01.91,0:38:04.91,Default,,0,0,0,,Ах, Мей, қайтып кел!
Dialogue: 0,0:38:04.91,0:38:06.91,Default,,0,0,0,,≪Егер бұл орын алса! ≫
Dialogue: 0,0:38:15.92,0:38:19.41,Default,,0,0,0,,Ахахаха! Ахахаха!
Dialogue: 0,0:38:19.41,0:38:22.91,Default,,0,0,0,,Бұл рас! Тоторо шынымен де болды!
Dialogue: 0,0:38:22.91,0:38:25.41,Default,,0,0,0,,Өтірік емес...
Dialogue: 0,0:38:34.02,0:38:37.41,Default,,0,0,0,,мамыр. Бұл өтірік емес.
Dialogue: 0,0:38:37.41,0:38:40.91,Default,,0,0,0,,Иә, әкесі де, Сатсуки де→
Dialogue: 0,0:38:40.91,0:38:43.40,Default,,0,0,0,,Менің ойымша, Мэй өтірікші емес.
Dialogue: 0,0:38:43.40,0:38:46.92,Default,,0,0,0,,Мэй осы орманның иесімен кездескен болуы керек.
Dialogue: 0,0:38:46.92,0:38:49.41,Default,,0,0,0,,Бұл өте бақытты.
Dialogue: 0,0:38:49.41,0:38:52.91,Default,,0,0,0,,Бірақ біз әрқашан кездесе алмаймыз.
Dialogue: 0,0:38:53.96,0:38:56.40,Default,,0,0,0,,Жақсы, сіз әлі сәлем беруге барған жоқсыз.
Dialogue: 0,0:38:56.40,0:38:59.40,Default,,0,0,0,,Сәлеметсіз бе? Цукамориге аттанамыз!
Dialogue: 0,0:38:59.40,0:39:15.52,Default,,0,0,0,,♪♪~
Dialogue: 0,0:39:15.52,0:39:20.90,Default,,0,0,0,,Эй, Мэйдің де салмағы артып кетті. Әке, мына камфора ағашы!
Dialogue: 0,0:39:20.90,0:39:23.41,Default,,0,0,0,,Бұл үлкен.
Dialogue: 0,0:39:23.41,0:39:30.90,Default,,0,0,0,,♪♪~
Dialogue: 0,0:39:30.90,0:39:32.40,Default,,0,0,0,,Міне болды!
Dialogue: 0,0:39:33.42,0:39:35.44,Default,,0,0,0,,Бұл ағаш? Иә.
Dialogue: 0,0:39:35.44,0:39:37.97,Default,,0,0,0,,Әке, асығыңыз!
Dialogue: 0,0:39:37.97,0:39:48.42,Default,,0,0,0,,♪♪~
Dialogue: 0,0:39:48.42,0:39:50.92,Default,,0,0,0,,Тесік жойылды.
Dialogue: 0,0:39:50.92,0:39:53.40,Default,,0,0,0,,Шынымен де осында ма? Иә.
Dialogue: 0,0:39:53.40,0:39:55.92,Default,,0,0,0,,Тесік жоғалып кетті.
Dialogue: 0,0:39:55.92,0:39:58.93,Default,,0,0,0,,Ей, біз әрқашан кездесе алмаймыз.
Dialogue: 0,0:39:58.93,0:40:01.95,Default,,0,0,0,,Біз тағы кездесеміз бе? Мен де сенімен танысқым келеді.
Dialogue: 0,0:40:01.95,0:40:05.40,Default,,0,0,0,,Сәті түсіп жатса.
Dialogue: 0,0:40:05.40,0:40:08.92,Default,,0,0,0,,Бұл әдемі ағаш.
Dialogue: 0,0:40:08.92,0:40:14.41,Default,,0,0,0,,Мен бұл жерде ұзақ тұрғанына сенімдімін.
Dialogue: 0,0:40:14.41,0:40:19.93,Default,,0,0,0,,Ертеде ағаштар мен адамдар жақсы дос болған.
Dialogue: 0,0:40:19.93,0:40:24.00,Default,,0,0,0,,Әкем бұл ағашты көрді және ол үйді қатты ұнатты.
Dialogue: 0,0:40:24.00,0:40:26.90,Default,,0,0,0,,Анаңызға да ұнайтынына сенімдімін.
Dialogue: 0,0:40:26.90,0:40:30.42,Default,,0,0,0,,Енді рахметімізді айтып, қайтайық. Мен түскі асымды ішуім керек.
Dialogue: 0,0:40:30.42,0:40:33.43,Default,,0,0,0,,Иә, мен Миччанның үйіне баруға уәде бердім.
Dialogue: 0,0:40:33.43,0:40:34.93,Default,,0,0,0,,Мэй де барады!
Dialogue: 0,0:40:34.93,0:40:36.90,Default,,0,0,0,,Абайлаңыз!
Dialogue: 0,0:40:36.90,0:40:38.92,Default,,0,0,0,,Көмегің үшін рахмет, Мэй.
Dialogue: 0,0:40:38.92,0:40:41.44,Default,,0,0,0,,Үздіксіз қолдау көрсеткеніңіз үшін рахмет.
Dialogue: 0,0:40:41.44,0:40:43.99,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:40:43.99,0:40:45.91,Default,,0,0,0,,Үйге жүгір!
Dialogue: 0,0:40:45.91,0:40:47.91,Default,,0,0,0,,А, жасырын! Ах!
Dialogue: 0,0:40:47.91,0:40:49.91,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:40:50.91,0:40:52.93,Default,,0,0,0,,≪Асығыңыз~! ≫
Dialogue: 0,0:40:52.93,0:40:55.43,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:40:57.42,0:41:00.94,Default,,0,0,0,,``Бүгін бізде өте жақсы жаңалықтар бар.
Dialogue: 0,0:41:00.94,0:41:04.44,Default,,0,0,0,,Мэй Тоторо елесімен кездесті.
Dialogue: 0,0:41:08.91,0:41:13.91,Default,,0,0,0,,«Мен де сені кездестіремін деп үміттенемін».
Dialogue: 0,0:41:42.93,0:41:46.50,Default,,0,0,0,,≪Канта: Егер асықпасаң, кешігіп қаласың≫
Dialogue: 0,0:41:47.50,0:41:49.00,Default,,0,0,0,,Иә.
Dialogue: 0,0:42:11.99,0:42:13.99,Default,,0,0,0,,Бұл! Ай...
Dialogue: 0,0:42:24.92,0:42:26.42,Default,,0,0,0,,Ах.
Dialogue: 0,0:42:30.91,0:42:32.93,Default,,0,0,0,,мамыр!?
Dialogue: 0,0:42:32.93,0:42:35.97,Default,,0,0,0,,Мұғалім! Иә, Сатсуки-сан.
Dialogue: 0,0:42:35.97,0:42:38.47,Default,,0,0,0,,Әй, әпкем...
Dialogue: 0,0:42:44.89,0:42:46.96,Default,,0,0,0,,Мамыр әже….
Dialogue: 0,0:42:47.01,0:42:52.00,Default,,0,0,0,,Кешіріңіз, бірақ мен сенен әпкеңмен баруыңды сұрай алмаймын...
Dialogue: 0,0:42:52.00,0:42:56.50,Default,,0,0,0,,Өйткені... Мей, бүгін әкем университетке баратын күн→
Dialogue: 0,0:42:56.50,0:43:00.00,Default,,0,0,0,,Сен жақсы қыз болуға және мені әжемнің үйінде күтуге уәде бердің.
Dialogue: 0,0:43:02.08,0:43:06.51,Default,,0,0,0,,Менің әлі екі сағатым бар, тіпті әжем де бос емес...
Dialogue: 0,0:43:06.51,0:43:11.51,Default,,0,0,0,,Сен әрқашан жақсы қыз едің.
Dialogue: 0,0:43:17.51,0:43:18.99,Default,,0,0,0,,Аа...
Dialogue: 0,0:43:18.99,0:43:21.99,Default,,0,0,0,,Әже Мен мұғаліммен сөйлесемін.
Dialogue: 0,0:43:27.52,0:43:32.02,Default,,0,0,0,,Сатсукидің анасы ауруханада, сондықтан үйде жағдай қиын.
Dialogue: 0,0:43:32.02,0:43:36.52,Default,,0,0,0,,Барлығы жақсы араласады. Иә.
Dialogue: 0,0:43:41.53,0:43:45.62,Default,,0,0,0,,Не? сол. Бұл Тоторо!
Dialogue: 0,0:43:45.62,0:43:48.52,Default,,0,0,0,,Ши~! Сіз тыныш болуыңыз керек, солай ма?
Dialogue: 0,0:43:48.52,0:43:50.51,Default,,0,0,0,,Иә!
Dialogue: 0,0:43:50.51,0:43:52.01,Default,,0,0,0,,Аа...
Dialogue: 0,0:43:53.49,0:44:00.02,Default,,0,0,0,,(Соңғы қоңырау)
Dialogue: 0,0:44:00.02,0:44:02.54,Default,,0,0,0,,Сау болыңыз! Мэй Чан, сау бол!
Dialogue: 0,0:44:02.54,0:44:06.61,Default,,0,0,0,,Үйірмеден үзіліс алып жатқаныңызды айтыңыз. Иә, мұғалімге айтамын.
Dialogue: 0,0:44:06.61,0:44:09.01,Default,,0,0,0,,Жақында кездескенше. сау бол.
Dialogue: 0,0:44:09.01,0:44:13.01,Default,,0,0,0,,Мамыр, асығыңыз, жаңбыр жауады. Иә.
Dialogue: 0,0:44:20.50,0:44:22.50,Default,,0,0,0,,Уау! Жаңбыр жауып тұр!
Dialogue: 0,0:44:29.03,0:44:30.53,Default,,0,0,0,,Ах!
Dialogue: 0,0:44:34.00,0:44:35.50,Default,,0,0,0,,Хора.
Dialogue: 0,0:44:39.01,0:44:43.01,Default,,0,0,0,,Мэй жыламайды, сен кереметсің бе? Иә.
Dialogue: 0,0:44:44.06,0:44:47.06,Default,,0,0,0,,Бірақ мен қиындыққа тап болдым.
Dialogue: 0,0:44:49.00,0:44:52.50,Default,,0,0,0,,Джизо-сама, маған жаңбырдан пана алуға рұқсат етіңізші.
Dialogue: 0,0:45:27.52,0:45:29.52,Default,,0,0,0,,Хмм…. а….
Dialogue: 0,0:45:30.52,0:45:32.02,Default,,0,0,0,,Әй!
Dialogue: 0,0:45:35.01,0:45:37.51,Default,,0,0,0,,Жоқ! бірақ….
Dialogue: 0,0:45:37.51,0:45:39.52,Default,,0,0,0,,Ах.
Dialogue: 0,0:45:39.52,0:45:57.52,Default,,0,0,0,,♪♪~
Dialogue: 0,0:45:57.52,0:46:00.52,Default,,0,0,0,,Сізге жақсы, әпке. Иә.
Dialogue: 0,0:46:00.52,0:46:03.52,Default,,0,0,0,,Қолшатыр Оның ішінде тесік бар.
Dialogue: 0,0:46:03.52,0:46:05.02,Default,,0,0,0,,Иә.
Dialogue: 0,0:46:14.53,0:46:17.02,Default,,0,0,0,,Әке, сіз қолшатыр әкелген жоқсыз.
Dialogue: 0,0:46:17.02,0:46:19.02,Default,,0,0,0,,Сізді алып кетуге мамыр да келеді!
Dialogue: 0,0:46:21.99,0:46:24.01,Default,,0,0,0,,Сондықтан мен ұмытып кеттім!
Dialogue: 0,0:46:24.01,0:46:28.03,Default,,0,0,0,,Жаңбыр жауып тұрғанда қолшатырын ұмытатын қандай ақымақ?
Dialogue: 0,0:46:28.03,0:46:29.57,Default,,0,0,0,,Ой!
Dialogue: 0,0:46:29.57,0:46:32.10,Default,,0,0,0,,Мен оны айналдырып, бәрібір сындырдым.
Dialogue: 0,0:46:32.10,0:46:33.60,Default,,0,0,0,,Айырмашылық!
Dialogue: 0,0:46:46.52,0:46:48.52,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:46:50.02,0:46:52.51,Default,,0,0,0,,О, Сатсуки-сан, Мэй-чан да...
Dialogue: 0,0:46:52.51,0:46:54.56,Default,,0,0,0,,Әже!
Dialogue: 0,0:46:54.56,0:46:59.01,Default,,0,0,0,,Мен бүгін кешірім сұраймын. Мен сізге мұнда көмектесе алмаймын.
Dialogue: 0,0:46:59.01,0:47:02.50,Default,,0,0,0,,Канта-сан маған қолшатырды берді.
Dialogue: 0,0:47:02.50,0:47:06.52,Default,,0,0,0,,Эй, бала? Амал жоқ, мұндай тозған қолшатыр.
Dialogue: 0,0:47:06.52,0:47:11.02,Default,,0,0,0,,Мэй де сонда болды, бұл көп көмектесті, бірақ Канта-сан дымқыл болды.
Dialogue: 0,0:47:11.02,0:47:13.03,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:47:13.03,0:47:16.10,Default,,0,0,0,,Жарайды, ылғи лай басып жүреді→
Dialogue: 0,0:47:16.10,0:47:18.01,Default,,0,0,0,,Бұл әдемі болады.
Dialogue: 0,0:47:18.01,0:47:20.02,Default,,0,0,0,,≪Әкеңді алып кетесің бе? ≫
Dialogue: 0,0:47:20.02,0:47:22.50,Default,,0,0,0,,> >
Dialogue: 0,0:47:22.50,0:47:25.50,Default,,0,0,0,,≪Сау бол Мей≫ ≪Сау бол≫
Dialogue: 0,0:47:33.05,0:47:35.08,Default,,0,0,0,,Бум.
Dialogue: 0,0:47:35.08,0:47:38.58,Default,,0,0,0,,Біреу келді ме? Мен білмеймін.
Dialogue: 0,0:47:42.52,0:47:44.52,Default,,0,0,0,,А, мен жаңа ғана келдім.
Dialogue: 0,0:47:57.04,0:47:59.04,Default,,0,0,0,,Сіз мінгіңіз келе ме?
Dialogue: 0,0:48:00.61,0:48:02.61,Default,,0,0,0,,≪Жақсы кетемін≫
Dialogue: 0,0:48:10.00,0:48:14.50,Default,,0,0,0,,Әке, сіз атқа мінбейсіз. Бұл келесі автобус шығар.
Dialogue: 0,0:48:14.50,0:48:17.00,Default,,0,0,0,,Мэй сізді әжеңіздің үйінде күтіп тұр ма?
Dialogue: 0,0:48:18.52,0:48:53.03,Default,,0,0,0,,♪♪~
Dialogue: 0,0:48:53.03,0:48:55.01,Default,,0,0,0,,♪♪~ Не болды?
Dialogue: 0,0:48:55.01,0:49:04.51,Default,,0,0,0,,♪♪~
Dialogue: 0,0:49:26.03,0:49:29.53,Default,,0,0,0,,Мамыр, ұйықтап жатырсың ба?
Dialogue: 0,0:49:29.53,0:49:32.08,Default,,0,0,0,,Сондықтан мен... дедім.
Dialogue: 0,0:49:32.08,0:49:34.00,Default,,0,0,0,,Қазір әженің үйіне барасың ба?
Dialogue: 0,0:49:34.00,0:49:36.02,Default,,0,0,0,,Хмм...
Dialogue: 0,0:49:36.02,0:49:38.52,Default,,0,0,0,,Міне таяп қалды, сондықтан бар күшіңізді салыңыз.
Dialogue: 0,0:49:44.03,0:49:47.03,Default,,0,0,0,,Автобус Кеш болды.
Dialogue: 0,0:49:54.52,0:49:57.52,Default,,0,0,0,,Хора. Иә….
Dialogue: 0,0:50:23.00,0:50:31.50,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:50:34.99,0:50:36.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:50:41.50,0:51:19.11,Default,,0,0,0,,♪♪~
Dialogue: 0,0:51:19.11,0:51:20.61,Default,,0,0,0,,Тоторо?
Dialogue: 0,0:51:25.01,0:51:27.51,Default,,0,0,0,,Уау.
Dialogue: 0,0:51:30.50,0:51:32.50,Default,,0,0,0,,О, күте тұрыңыз.
Dialogue: 0,0:51:36.02,0:51:37.52,Default,,0,0,0,,(қолшатыр ашылған дыбыс)
Dialogue: 0,0:51:37.52,0:51:39.52,Default,,0,0,0,,Мен оны саған қарызға беремін.
Dialogue: 0,0:51:40.56,0:51:43.06,Default,,0,0,0,,Мэй тез құлайды.
Dialogue: 0,0:51:48.50,0:51:51.00,Default,,0,0,0,,Сіз оны осылай пайдаланасыз.
Dialogue: 0,0:52:01.01,0:52:02.51,Default,,0,0,0,,Хехе.
Dialogue: 0,0:52:16.01,0:52:17.01,Default,,0,0,0,,Потон
Dialogue: 0,0:52:24.50,0:52:26.50,Default,,0,0,0,,Пара
Dialogue: 0,0:52:28.52,0:52:30.52,Default,,0,0,0,,Ақымақ~.
Dialogue: 0,0:52:39.50,0:52:43.00,Default,,0,0,0,,Пара... Пара
Dialogue: 0,0:52:45.51,0:52:48.51,Default,,0,0,0,,Ақымақ~.
Dialogue: 0,0:52:51.03,0:52:53.52,Default,,0,0,0,,Хмф! Апыр-ай!
Dialogue: 0,0:52:53.52,0:52:55.55,Default,,0,0,0,,Пара
Dialogue: 0,0:52:55.55,0:52:58.10,Default,,0,0,0,,За~!
Dialogue: 0,0:52:58.10,0:53:04.01,Default,,0,0,0,,Гуо~!
Dialogue: 0,0:53:04.01,0:53:05.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:53:07.53,0:53:09.03,Default,,0,0,0,,Автобус келді!
Dialogue: 0,0:53:25.01,0:53:27.51,Default,,0,0,0,,Уня~о.
Dialogue: 0,0:53:36.51,0:53:38.01,Default,,0,0,0,,Буфа.
Dialogue: 0,0:54:16.02,0:54:20.02,Default,,0,0,0,,Тоторо Мен әкемнің қолшатырын алдым.
Dialogue: 0,0:54:33.08,0:54:36.50,Default,,0,0,0,,Иә~ Кешіріңіз. ≪Жарайды, кетіңіз! ≫
Dialogue: 0,0:54:36.50,0:54:40.02,Default,,0,0,0,,Пойыз кешігіп келді. Мен автобусты сағындым.
Dialogue: 0,0:54:40.02,0:54:42.51,Default,,0,0,0,,Сіз уайымдап тұрсыз ба?
Dialogue: 0,0:54:42.51,0:54:44.99,Default,,0,0,0,,шықты! Әке, шықты! Шыққан!!
Dialogue: 0,0:54:44.99,0:54:47.01,Default,,0,0,0,,Мысық! Мысық автобус!
Dialogue: 0,0:54:47.01,0:54:48.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:54:48.51,0:54:52.57,Default,,0,0,0,,Бұл өте үлкен! Маған осылай қарап тұрсың ба?
Dialogue: 0,0:54:52.57,0:54:54.60,Default,,0,0,0,,Қорқынышты! Қорқынышты!
Dialogue: 0,0:54:54.60,0:54:59.53,Default,,0,0,0,,Біз кездестік! Мен Тоторомен таныстым!!
Dialogue: 0,0:54:59.53,0:55:02.03,Default,,0,0,0,,Керемет! Қорқынышты!
Dialogue: 0,0:55:03.00,0:55:05.51,Default,,0,0,0,,Гва~
Dialogue: 0,0:55:05.51,0:55:13.02,Default,,0,0,0,,Хм! Сол қол
Dialogue: 0,0:55:13.02,0:55:14.56,Default,,0,0,0,,Сенің басыңа түскен қарғыс—
Dialogue: 0,0:55:14.56,0:55:19.06,Default,,0,0,0,,Кя~ Хахахаха!
Dialogue: 0,0:55:22.01,0:55:26.02,Default,,0,0,0,,``Анашым, жүрегім әлі соғып тұр.
Dialogue: 0,0:55:26.02,0:55:30.01,Default,,0,0,0,,Бұл өте жұмбақ, қорқынышты және көңілді күн болды.
Dialogue: 0,0:55:30.01,0:55:33.51,Default,,0,0,0,,Сондай-ақ, Тотороның маған берген алғысы керемет болды.
Dialogue: 0,0:55:33.51,0:55:38.10,Default,,0,0,0,,Бұл бамбук жапырақтарына оралған және айдаһардың мұртымен байланған пакет болды.
Dialogue: 0,0:55:38.10,0:55:43.50,Default,,0,0,0,,Үйге келгенде ашып қарасам, ішінен жаңғақ жатыр...''
Dialogue: 0,0:55:43.50,0:55:45.50,Default,,0,0,0,,Ах! Апыр-ай!
Dialogue: 0,0:55:47.52,0:55:51.01,Default,,0,0,0,,«Бағың орманға айналса, тамаша болар еді→
Dialogue: 0,0:55:51.01,0:55:54.01,Default,,0,0,0,,Мен бақшаға жаңғақ себуді шештім, бірақ...''
Dialogue: 0,0:55:54.01,0:55:56.52,Default,,0,0,0,,«Тұқымдар оңай бүршік жармайды.
Dialogue: 0,0:55:56.52,0:56:01.59,Default,,0,0,0,,Мэй әлі кетпедім деп күнде айтады.Ол әлі кеткен жоқ.
Dialogue: 0,0:56:01.59,0:56:06.09,Default,,0,0,0,,Маймыл-Қани шаянға айналғандай.''
Dialogue: 0,0:56:07.51,0:56:09.51,Default,,0,0,0,,Ал, хехехе...
Dialogue: 0,0:56:10.51,0:56:15.00,Default,,0,0,0,,«Жақында жазғы каникул, тезірек сауығып кетіңіз.
Dialogue: 0,0:56:15.00,0:56:17.02,Default,,0,0,0,,Сацуки ана».
Dialogue: 0,0:56:17.40,0:56:19.40,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:56:20.50,0:56:25.00,Default,,0,0,0,,Мынау, мынау... Иә! О~ О~.
Dialogue: 0,0:56:26.59,0:56:28.99,Default,,0,0,0,,Мен оны өшіремін. асылу!
Dialogue: 0,0:56:28.99,0:56:32.51,Default,,0,0,0,,Ата, ертең көктеп шыға ма?
Dialogue: 0,0:56:32.51,0:56:36.50,Default,,0,0,0,,Менің ойымша, Тоторо біледі.
Dialogue: 0,0:56:36.50,0:56:38.00,Default,,0,0,0,,Қайырлы түн.
Dialogue: 0,0:56:38.00,0:57:04.51,Default,,0,0,0,,Хм! Сол қол
Dialogue: 0,0:57:04.51,0:57:26.00,Default,,0,0,0,,♪♪~
Dialogue: 0,0:57:26.00,0:57:28.00,Default,,0,0,0,,♪♪~ Мамыр!
Dialogue: 0,0:57:28.00,0:57:30.02,Default,,0,0,0,,♪♪~ Хмм?
Dialogue: 0,0:57:30.02,0:57:45.50,Default,,0,0,0,,♪♪~
Dialogue: 0,0:57:45.50,0:57:48.02,Default,,0,0,0,,Міне, мен жаңғақтарды сеуіп жібердім. ♪♪~ Иә.
Dialogue: 0,0:57:48.02,0:58:02.57,Default,,0,0,0,,♪♪~
Dialogue: 0,0:58:02.57,0:58:05.50,Default,,0,0,0,,Ах! Уууу.
Dialogue: 0,0:58:05.50,0:58:10.01,Default,,0,0,0,,Уау... Буха!
Dialogue: 0,0:58:10.01,0:58:12.03,Default,,0,0,0,,Ах! Ах!
Dialogue: 0,0:58:12.03,0:58:13.53,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:58:14.51,0:58:19.01,Default,,0,0,0,,Уау... Буха!
Dialogue: 0,0:58:21.05,0:58:23.09,Default,,0,0,0,,Уау!
Dialogue: 0,0:58:23.09,0:58:27.09,Default,,0,0,0,,Хмм... Уау!
Dialogue: 0,0:58:29.51,0:58:31.01,Default,,0,0,0,,Уау!
Dialogue: 0,0:58:31.01,0:59:18.51,Default,,0,0,0,,♪♪~
Dialogue: 0,0:59:18.51,0:59:22.51,Default,,0,0,0,,Иә! Алақай!
Dialogue: 0,0:59:27.57,0:59:29.07,Default,,0,0,0,,Қандай азап…
Dialogue: 0,0:59:34.49,0:59:35.99,Default,,0,0,0,,Уау!
Dialogue: 0,0:59:50.54,0:59:52.08,Default,,0,0,0,,Ех!
Dialogue: 0,0:59:52.08,1:00:17.57,Default,,0,0,0,,♪♪~
Dialogue: 0,1:00:17.57,1:00:21.51,Default,,0,0,0,,♪♪~ Гуо~!!
Dialogue: 0,1:00:21.51,1:00:25.01,Default,,0,0,0,,Уау! ♪♪~ Гвааа~!
Dialogue: 0,1:00:25.01,1:00:37.56,Default,,0,0,0,,♪♪~
Dialogue: 0,1:00:37.56,1:00:41.01,Default,,0,0,0,,Мэй Біз жел болып жатырмыз! ♪♪~ Иә.
Dialogue: 0,1:00:41.01,1:00:47.01,Default,,0,0,0,,♪♪~
Dialogue: 0,1:00:53.99,1:01:23.51,Default,,0,0,0,,♪~
Dialogue: 0,1:01:34.01,1:01:35.51,Default,,0,0,0,,Ах!
Dialogue: 0,1:01:40.50,1:01:42.50,Default,,0,0,0,,Ағаштар жоқ.
Dialogue: 0,1:01:42.50,1:01:44.50,Default,,0,0,0,,Ах! Ах!!
Dialogue: 0,1:01:48.06,1:01:51.06,Default,,0,0,0,,Иә! Ол шықты!
Dialogue: 0,1:01:52.50,1:01:54.00,Default,,0,0,0,,Бұл жай ғана арман!
Dialogue: 0,1:01:54.00,1:01:55.50,Default,,0,0,0,,Бұл арман емес еді!
Dialogue: 0,1:01:55.50,1:01:57.00,Default,,0,0,0,,Бұл жай ғана арман!
Dialogue: 0,1:01:57.00,1:01:59.52,Default,,0,0,0,,Бұл арман емес еді! Банзай!
Dialogue: 0,1:01:59.52,1:02:01.52,Default,,0,0,0,,Иә! Алақай!
Dialogue: 0,1:02:17.49,1:02:20.49,Default,,0,0,0,,Құсақабе-сан, телеграмма!
Dialogue: 0,1:02:21.51,1:02:23.53,Default,,0,0,0,,Құсақабе-сан!
Dialogue: 0,1:02:23.53,1:02:26.03,Default,,0,0,0,,Бұл телеграмма!
Dialogue: 0,1:02:27.00,1:02:29.50,Default,,0,0,0,,Мүмкін сіз алыссыз...?
Dialogue: 0,1:02:35.57,1:02:38.07,Default,,0,0,0,,Әже!
Dialogue: 0,1:02:42.00,1:02:44.50,Default,,0,0,0,,Міне осылай.
Dialogue: 0,1:02:45.52,1:02:48.02,Default,,0,0,0,,Бұл жеуге дайын.
Dialogue: 0,1:02:54.51,1:02:56.53,Default,,0,0,0,,Қандай азап…
Dialogue: 0,1:02:56.53,1:03:00.03,Default,,0,0,0,,Әже Бұл не? Иә.
Dialogue: 0,1:03:06.00,1:03:09.51,Default,,0,0,0,,Әженің өрісі қазынадай.
Dialogue: 0,1:03:09.51,1:03:13.01,Default,,0,0,0,,Хахаха... Енді тынығып ал, тынығып ал.
Dialogue: 0,1:03:18.52,1:03:21.54,Default,,0,0,0,,Шынымен суық.
Dialogue: 0,1:03:21.54,1:03:23.54,Default,,0,0,0,,Мен оны аламын.
Dialogue: 0,1:03:33.00,1:03:35.50,Default,,0,0,0,,Дәмді. Мен түсінемін.
Dialogue: 0,1:03:35.50,1:03:40.51,Default,,0,0,0,,Тенду-сама, мен көп шомыламын, сондықтан бұл менің денеме пайдалы.
Dialogue: 0,1:03:40.51,1:03:42.51,Default,,0,0,0,,Анаңыздың ауруына да?
Dialogue: 0,1:03:42.51,1:03:44.01,Default,,0,0,0,,Әрине.
Dialogue: 0,1:03:44.01,1:03:48.06,Default,,0,0,0,,Әженің егінінен тамақ жесеңіз, бірден жақсы сезінесіз.
Dialogue: 0,1:03:48.06,1:03:50.50,Default,,0,0,0,,Мама, сен сенбіде үйге келмейсің бе?
Dialogue: 0,1:03:50.50,1:03:53.02,Default,,0,0,0,,Мэйдің футонында бірге ұйықтаймыз.
Dialogue: 0,1:03:53.02,1:03:56.49,Default,,0,0,0,,Мен көремін. Ақырында ауруханадан шығатын кез келді.
Dialogue: 0,1:03:56.49,1:03:59.49,Default,,0,0,0,,Жоқ, мен шынымен де әлі шығарылған жоқпын →
Dialogue: 0,1:03:59.49,1:04:03.01,Default,,0,0,0,,Бірте-бірте үйреніп кету үшін дүйсенбі күні ауруханаға қайтамын.
Dialogue: 0,1:04:03.01,1:04:07.57,Default,,0,0,0,,Олай болса, көбірек жеу керек.
Dialogue: 0,1:04:07.57,1:04:11.02,Default,,0,0,0,,Мэйдің алған жүгері мен анама беремін.
Dialogue: 0,1:04:11.02,1:04:13.51,Default,,0,0,0,,Анашым, сенің бақытты болатыныңа сенімдімін.
Dialogue: 0,1:04:13.51,1:04:15.01,Default,,0,0,0,,Иә!
Dialogue: 0,1:04:22.00,1:04:24.52,Default,,0,0,0,,Telegram Мен оны алыс болсам да саған қалдырдым.
Dialogue: 0,1:04:24.52,1:04:26.02,Default,,0,0,0,,Менің үйім?
Dialogue: 0,1:04:29.50,1:04:32.49,Default,,0,0,0,,Әже, әке, мен кешке дейін үйде болмаймын.
Dialogue: 0,1:04:32.49,1:04:35.49,Default,,0,0,0,,Оны ашыңыз. Егер сіз асығыс болсаңыз жақсы емес.
Dialogue: 0,1:04:35.49,1:04:36.99,Default,,0,0,0,,Иә.
Dialogue: 0,1:04:39.01,1:04:42.80,Default,,0,0,0,,“Ренраку Коу Шичикокуяма…”.
Dialogue: 0,1:04:43.30,1:04:46.37,Default,,0,0,0,,Шичикунияма ауруханасы! Бұл анамның ауруханасынан.
Dialogue: 0,1:04:46.37,1:04:48.87,Default,,0,0,0,,Анама бірдеңе болды...
Dialogue: 0,1:04:50.29,1:04:52.81,Default,,0,0,0,,Әже, мен не істеуім керек? Маған хабарласыңыз.
Dialogue: 0,1:04:52.81,1:04:56.82,Default,,0,0,0,,Сабыр ет, сабыр... Әкеңнің қайда екенін білесің бе?
Dialogue: 0,1:04:56.82,1:05:00.32,Default,,0,0,0,,Мен зертхана нөмірін білемін, бірақ телефон жоқ.
Dialogue: 0,1:05:00.32,1:05:04.31,Default,,0,0,0,,Канта, мені басты үйге апар. Маған телефоныңызды беріңізші.
Dialogue: 0,1:05:04.31,1:05:05.81,Default,,0,0,0,,Иә.
Dialogue: 0,1:05:08.89,1:05:12.39,Default,,0,0,0,,Мэй Чан бұл жерде жоқ!
Dialogue: 0,1:05:21.32,1:05:23.82,Default,,0,0,0,,мамыр! Әжемен бірге болыңыз!
Dialogue: 0,1:06:00.80,1:06:03.30,Default,,0,0,0,,Сәлеметсіз бе, қала сыртына көшіңіз.
Dialogue: 0,1:06:04.32,1:06:09.32,Default,,0,0,0,,Бұл Токионың 31-ші станциясының 1382 нөмірі Иә.
Dialogue: 0,1:06:10.31,1:06:13.81,Default,,0,0,0,,Сен сүйкімді қыз емессің, Қанта.
Dialogue: 0,1:06:14.81,1:06:16.85,Default,,0,0,0,,[ТЕЛ]
Dialogue: 0,1:06:16.85,1:06:18.85,Default,,0,0,0,,Сәлеметсіз бе... Иә.
Dialogue: 0,1:06:19.91,1:06:22.32,Default,,0,0,0,,Сәлеметсіз бе, бұл археология сабағы ма?
Dialogue: 0,1:06:22.32,1:06:25.30,Default,,0,0,0,,Әкем... мм... Құсақабе, өтінемін.
Dialogue: 0,1:06:25.30,1:06:28.30,Default,,0,0,0,,Мен Сацуки Кусакабемін... Иә.
Dialogue: 0,1:06:31.31,1:06:33.80,Default,,0,0,0,,Әй, әке! Мен Сатсуки!
Dialogue: 0,1:06:33.80,1:06:39.88,Default,,0,0,0,,Не? Иә, иә... ауруханадан?
Dialogue: 0,1:06:39.88,1:06:42.80,Default,,0,0,0,,[ТЕЛ] Жарайды, мен қазір ауруханаға хабарласамын.
Dialogue: 0,1:06:42.80,1:06:45.81,Default,,0,0,0,,Анаңа бірдеңе болды ма? Не істеуім керек, әке?
Dialogue: 0,1:06:45.81,1:06:49.79,Default,,0,0,0,,[ТЕЛ] Жарайды. Ауруханаға хабарласқан соң бірден хабарласамын.→
Dialogue: 0,1:06:49.79,1:06:53.30,Default,,0,0,0,,Маған сонда күтуге рұқсат етіңіз. Иә.
Dialogue: 0,1:06:53.30,1:06:55.30,Default,,0,0,0,,Ал, енді қысқартайық.
Dialogue: 0,1:06:57.32,1:06:59.87,Default,,0,0,0,,Әже, осында күтіңіз.
Dialogue: 0,1:06:59.87,1:07:01.79,Default,,0,0,0,,Әкем қоңырау шалып жатыр.
Dialogue: 0,1:07:01.79,1:07:04.29,Default,,0,0,0,,Аа, сабыр етіңіз.
Dialogue: 0,1:07:11.02,1:07:14.00,Default,,0,0,0,,Үлкен әпке!!
Dialogue: 0,1:07:14.00,1:07:15.50,Default,,0,0,0,,Ах...
Dialogue: 0,1:07:17.01,1:07:22.03,Default,,0,0,0,,(айқай)
Dialogue: 0,1:07:22.03,1:07:25.60,Default,,0,0,0,,Жоқ! Бұл ананың жүгері!
Dialogue: 0,1:07:25.60,1:07:27.12,Default,,0,0,0,,(айқай)
Dialogue: 0,1:07:27.12,1:07:30.12,Default,,0,0,0,,Жоқ! Мен оны анама беремін!
Dialogue: 0,1:07:31.02,1:07:33.02,Default,,0,0,0,,(Ешкі дыбысы)
Dialogue: 0,1:07:46.05,1:07:49.62,Default,,0,0,0,,Мамыр, анаңның көңіл-күйі нашар деп естідім.
Dialogue: 0,1:07:49.62,1:07:52.52,Default,,0,0,0,,Сондықтан мен келесі жолы келуді кейінге қалдыруды шештім.
Dialogue: 0,1:07:52.52,1:07:54.51,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:07:54.51,1:07:59.01,Default,,0,0,0,,Оған көмектесу мүмкін емес. Егер сіз өзіңізді ауыруға мәжбүр етсеңіз, сіз қиындыққа тап боласыз.
Dialogue: 0,1:07:59.01,1:08:00.51,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:08:01.53,1:08:04.54,Default,,0,0,0,,Эй, мен оны сәл кейінге қалдырамын.
Dialogue: 0,1:08:04.54,1:08:06.04,Default,,0,0,0,,Жоқ!!
Dialogue: 0,1:08:07.06,1:08:09.61,Default,,0,0,0,,Сонда анаң өліп қалса жақсы емес пе?
Dialogue: 0,1:08:09.61,1:08:12.03,Default,,0,0,0,,Я~да~!!
Dialogue: 0,1:08:12.03,1:08:14.53,Default,,0,0,0,,Мэйдің ақымақ! Мен енді білмеймін!
Dialogue: 0,1:08:25.02,1:08:27.06,Default,,0,0,0,,Кеттік.
Dialogue: 0,1:08:27.06,1:08:34.02,Default,,0,0,0,,Уау... апаң ақымақ екен!
Dialogue: 0,1:08:34.02,1:08:45.02,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:09:00.51,1:09:04.03,Default,,0,0,0,,Кірді қоятын кез келді...
Dialogue: 0,1:09:04.03,1:09:07.53,Default,,0,0,0,,Бұлай ренжіме→
Dialogue: 0,1:09:07.53,1:09:11.53,Default,,0,0,0,,Маған әжем көмектесуге келді, сондықтан мен өзімді жақсы сезінемін.
Dialogue: 0,1:09:15.52,1:09:20.01,Default,,0,0,0,,Әкем ауруханаға баратынын айтты.
Dialogue: 0,1:09:20.01,1:09:23.53,Default,,0,0,0,,Анашым, оны суық деп атайды→
Dialogue: 0,1:09:23.53,1:09:27.03,Default,,0,0,0,,Мен келесі сенбіде қайтамын.
Dialogue: 0,1:09:31.06,1:09:33.09,Default,,0,0,0,,Өткен күні де солай болды.
Dialogue: 0,1:09:33.09,1:09:35.53,Default,,0,0,0,,Мен ауруханада сәл ғана емделсем де...
Dialogue: 0,1:09:35.53,1:09:38.53,Default,,0,0,0,,Суық тиген сияқты...
Dialogue: 0,1:09:38.53,1:09:41.53,Default,,0,0,0,,Анам қайтыс болса не істеуім керек?
Dialogue: 0,1:09:41.53,1:09:43.54,Default,,0,0,0,,Сатсуки-чан...
Dialogue: 0,1:09:43.54,1:09:46.02,Default,,0,0,0,,Мүмкін сіздің анаңыз...
Dialogue: 0,1:09:46.02,1:09:49.54,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:09:49.54,1:09:52.59,Default,,0,0,0,,Жарайды Жарайды.
Dialogue: 0,1:09:52.59,1:09:57.03,Default,,0,0,0,,Осындай сүйкімді балаларды қалдырып, кім өлгісі келеді?
Dialogue: 0,1:09:57.03,1:10:01.04,Default,,0,0,0,,Жылама Жылама.
Dialogue: 0,1:10:01.04,1:10:05.54,Default,,0,0,0,,Әжем әкем келгенше менімен бірге болады.
Dialogue: 0,1:10:48.02,1:10:51.02,Default,,0,0,0,,Ме-и-чан!
Dialogue: 0,1:10:55.54,1:10:57.54,Default,,0,0,0,,мамыр!
Dialogue: 0,1:11:00.53,1:11:02.53,Default,,0,0,0,,мамыр!
Dialogue: 0,1:11:05.02,1:11:06.88,Default,,0,0,0,,Мамыр, қайтып келдің бе?
Dialogue: 0,1:11:06.88,1:11:09.88,Default,,0,0,0,,Сіз аялдамада емес пе едіңіз? Иә.
Dialogue: 0,1:11:10.28,1:11:14.27,Default,,0,0,0,,Бұл біртүрлі. Қайда кетті?
Dialogue: 0,1:11:14.27,1:11:18.18,Default,,0,0,0,,Мен бұрын Мэймен ұрысып қалдым. Өйткені Мэй...
Dialogue: 0,1:11:18.18,1:11:21.10,Default,,0,0,0,,Қызық, ол бала анасының ауруханасына барды ма!?
Dialogue: 0,1:11:21.10,1:11:24.10,Default,,0,0,0,,Шичикунияма ауруханасы?
Dialogue: 0,1:11:24.10,1:11:28.10,Default,,0,0,0,,Ересек адамға жүру үшін үш сағат қажет. Келіңіздер көріңіздер!
Dialogue: 0,1:11:29.10,1:11:33.61,Default,,0,0,0,,Қанта~! Тезірек маған қоңырау шалыңыз, әке!
Dialogue: 0,1:11:33.61,1:11:36.61,Default,,0,0,0,,Мэй Чан кетті!
Dialogue: 0,1:11:45.60,1:11:48.60,Default,,0,0,0,,Мэй ақымақ... ол оңай адасып қалады.
Dialogue: 0,1:11:55.60,1:11:58.10,Default,,0,0,0,,Мен!!
Dialogue: 0,1:12:05.28,1:12:07.11,Default,,0,0,0,,Кешіріңіз! Ағай...
Dialogue: 0,1:12:07.59,1:12:09.09,Default,,0,0,0,,Иә?
Dialogue: 0,1:12:09.09,1:12:12.09,Default,,0,0,0,,Бұл жолдан кішкентай қыз өткен жоқ па?
Dialogue: 0,1:12:12.09,1:12:16.60,Default,,0,0,0,,Ол менің әпкем. Ал, қыз...
Dialogue: 0,1:12:16.60,1:12:19.60,Default,,0,0,0,,Көрсең байқаған болар едің.
Dialogue: 0,1:12:19.60,1:12:22.10,Default,,0,0,0,,Мен бұл емес пе деп ойлаймын...
Dialogue: 0,1:12:41.07,1:12:43.59,Default,,0,0,0,,Сіз мұнда келгеніңізге сенімдісіз бе?
Dialogue: 0,1:12:43.59,1:12:45.64,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,1:12:45.64,1:12:53.58,Default,,0,0,0,,♪♪~
Dialogue: 0,1:12:53.58,1:12:56.07,Default,,0,0,0,,♪♪~ Мен~і!!
Dialogue: 0,1:12:56.07,1:13:15.07,Default,,0,0,0,,♪♪~
Dialogue: 0,1:13:16.59,1:13:19.09,Default,,0,0,0,,Тоқтаңыз!
Dialogue: 0,1:13:20.78,1:13:22.70,Default,,0,0,0,,Баккааро~! Бұл қауіпті...
Dialogue: 0,1:13:22.70,1:13:25.70,Default,,0,0,0,,Мен әпкемді іздеп жүрмін! Қыз, сен көрмедің бе?
Dialogue: 0,1:13:25.70,1:13:27.71,Default,,0,0,0,,Әпке?
Dialogue: 0,1:13:27.71,1:13:31.76,Default,,0,0,0,,Ол Шичикунияма ауруханасына барған 4 жасар қыз.
Dialogue: 0,1:13:31.76,1:13:34.70,Default,,0,0,0,,Рёко-чан, байқадың ба? Уф.
Dialogue: 0,1:13:34.70,1:13:37.22,Default,,0,0,0,,Біз Шичикуни тауынан келдік.
Dialogue: 0,1:13:37.22,1:13:39.70,Default,,0,0,0,,Бірақ мен мұндай баланы көрген емеспін.
Dialogue: 0,1:13:39.70,1:13:42.20,Default,,0,0,0,,Иә... Рахмет.
Dialogue: 0,1:13:42.20,1:13:45.71,Default,,0,0,0,,Сіз қай жақтансыз? Бұл Мацуго.
Dialogue: 0,1:13:45.71,1:13:49.73,Default,,0,0,0,,Мацуго!? Қандай да бір қателік бар емес пе?
Dialogue: 0,1:13:49.73,1:13:52.23,Default,,0,0,0,,Сонда кездескенше.
Dialogue: 0,1:14:03.19,1:14:05.19,Default,,0,0,0,,Сатсуки~!
Dialogue: 0,1:14:06.19,1:14:08.69,Default,,0,0,0,,Канчан!
Dialogue: 0,1:14:09.71,1:14:11.72,Default,,0,0,0,,Онда болды ма? Жоқ, бұл да?
Dialogue: 0,1:14:11.72,1:14:15.24,Default,,0,0,0,,Иә. Мені қазір ата-анам іздеп жатыр.
Dialogue: 0,1:14:15.24,1:14:18.81,Default,,0,0,0,,Мен оның орнына Шичикоку тауына барамын, сондықтан үйге қайтуға болады.
Dialogue: 0,1:14:18.81,1:14:23.73,Default,,0,0,0,,Ауруханаға барар жолда қате бұрылыс жасаған болуы керек.
Dialogue: 0,1:14:23.73,1:14:26.73,Default,,0,0,0,,Мен Камиике тоғанынан сандал тауып алдым.
Dialogue: 0,1:14:30.20,1:14:31.70,Default,,0,0,0,,Капитан Магатоға не деп тұрсың!!
Dialogue: 0,1:14:33.20,1:14:36.74,Default,,0,0,0,,Мэйдің бірі әлі шешілген жоқ!
Dialogue: 0,1:14:36.74,1:14:53.21,Default,,0,0,0,,♪♪~
Dialogue: 0,1:14:53.21,1:14:55.19,Default,,0,0,0,,♪♪~ Сіз таптыңыз ба?
Dialogue: 0,1:14:55.19,1:15:26.72,Default,,0,0,0,,♪♪~
Dialogue: 0,1:15:26.72,1:15:31.20,Default,,0,0,0,,Нанмандаб Нанмандаб Нанмандаб Нанмандаб….
Dialogue: 0,1:15:31.20,1:15:33.72,Default,,0,0,0,,Бұл жерде балшық терең, сондықтан алға!
Dialogue: 0,1:15:33.72,1:15:36.20,Default,,0,0,0,,≪Эй, сенде қалды ма? ≫
Dialogue: 0,1:15:36.20,1:15:44.69,Default,,0,0,0,,♪♪~
Dialogue: 0,1:15:44.69,1:15:46.73,Default,,0,0,0,,≪Сацуки-чан әже келді! ≫
Dialogue: 0,1:15:46.73,1:15:48.23,Default,,0,0,0,,Не!
Dialogue: 0,1:15:51.72,1:15:53.70,Default,,0,0,0,,Әже!
Dialogue: 0,1:15:53.70,1:15:56.20,Default,,0,0,0,,Мынау... бұл.
Dialogue: 0,1:16:05.21,1:16:07.21,Default,,0,0,0,,Бұл жеткіліксіз.
Dialogue: 0,1:16:17.21,1:16:22.70,Default,,0,0,0,,Жақсы, мен бұл Мэй Чан деп ойладым...
Dialogue: 0,1:16:22.70,1:16:25.70,Default,,0,0,0,,Бұл не? Әженің ерте мазақтауы.
Dialogue: 0,1:16:25.70,1:16:27.72,Default,,0,0,0,,Ей, бұл қате!
Dialogue: 0,1:16:27.72,1:16:31.22,Default,,0,0,0,,≪Сонда ол қайда кетті? ≫ ≪Мен қайтадан іздеуді бастауым керек.≫
Dialogue: 0,1:16:31.22,1:16:33.26,Default,,0,0,0,,≪Асықпасаң қараңғы болады≫
Dialogue: 0,1:16:33.26,1:16:36.71,Default,,0,0,0,,≪Кешіріңіз, барлығыңыз. Қиындық болса да, бөлуді сұраймын.≫
Dialogue: 0,1:16:36.71,1:16:38.71,Default,,0,0,0,,≪Жоқ, өйткені біз өзара≫біз
Dialogue: 0,1:17:06.72,1:17:11.73,Default,,0,0,0,,Өтінемін! Мэй Тотороға жетуге тырысқанда адасып қалды.
Dialogue: 0,1:17:11.73,1:17:16.23,Default,,0,0,0,,Қараңғы түсе жаздады, ол бір жерден адасып қалды.
Dialogue: 0,1:17:24.74,1:17:39.77,Default,,0,0,0,,♪♪~
Dialogue: 0,1:17:39.77,1:17:41.27,Default,,0,0,0,,Ах!
Dialogue: 0,1:17:46.23,1:17:47.73,Default,,0,0,0,,Тоторо!
Dialogue: 0,1:17:49.23,1:17:50.73,Default,,0,0,0,,Тоторо!
Dialogue: 0,1:17:50.73,1:17:54.24,Default,,0,0,0,,Мэй адасып қалды. Мен оны іздедім, бірақ таба алмадым.
Dialogue: 0,1:17:54.24,1:17:56.72,Default,,0,0,0,,Мейді іздеңіз.
Dialogue: 0,1:17:57.32,1:18:00.33,Default,,0,0,0,,Сенің қазір бір жерде жылайтыныңа сенімдімін.
Dialogue: 0,1:18:00.33,1:18:03.90,Default,,0,0,0,,Мен не істерімді білмеймін!
Dialogue: 0,1:18:03.90,1:18:10.90,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:18:21.33,1:18:27.33,Default,,0,0,0,,Боу~!
Dialogue: 0,1:18:43.32,1:18:48.84,Default,,0,0,0,,Гуах!!
Dialogue: 0,1:18:48.84,1:18:50.34,Default,,0,0,0,,Ах!
Dialogue: 0,1:18:50.34,1:18:53.88,Default,,0,0,0,,♪♪~
Dialogue: 0,1:18:53.88,1:18:57.83,Default,,0,0,0,,♪♪~ Ня~о~!
Dialogue: 0,1:18:57.83,1:19:02.34,Default,,0,0,0,,♪♪~
Dialogue: 0,1:19:02.34,1:19:04.82,Default,,0,0,0,,♪♪~ Оны бәрі көре алмайды.
Dialogue: 0,1:19:04.82,1:19:34.32,Default,,0,0,0,,♪♪~
Dialogue: 0,1:19:34.32,1:19:35.82,Default,,0,0,0,,♪♪~ Ах….
Dialogue: 0,1:19:35.82,1:19:41.32,Default,,0,0,0,,♪♪~
Dialogue: 0,1:19:50.34,1:19:52.34,Default,,0,0,0,,Уау….
Dialogue: 0,1:19:57.84,1:20:02.35,Default,,0,0,0,,♪♪~ Ня~о~!
Dialogue: 0,1:20:02.35,1:20:12.33,Default,,0,0,0,,♪♪~
Dialogue: 0,1:20:12.33,1:20:13.83,Default,,0,0,0,,♪♪~ Уау!
Dialogue: 0,1:20:13.83,1:20:15.85,Default,,0,0,0,,♪♪~
Dialogue: 0,1:20:15.85,1:20:20.35,Default,,0,0,0,,♪♪~ Мэй-чан!
Dialogue: 0,1:20:20.35,1:20:27.87,Default,,0,0,0,,♪♪~
Dialogue: 0,1:20:27.87,1:20:29.91,Default,,0,0,0,,♪♪~ Ағаш қашып барады!
Dialogue: 0,1:20:29.91,1:20:37.83,Default,,0,0,0,,♪♪~
Dialogue: 0,1:20:37.83,1:20:41.34,Default,,0,0,0,,♪♪~ (ит үреді)
Dialogue: 0,1:20:41.34,1:20:52.34,Default,,0,0,0,,♪♪~
Dialogue: 0,1:21:00.84,1:21:02.83,Default,,0,0,0,,≪Мей! ≫
Dialogue: 0,1:21:02.83,1:21:04.33,Default,,0,0,0,,А...!?
Dialogue: 0,1:21:06.33,1:21:08.83,Default,,0,0,0,,Үлкен әпке!
Dialogue: 0,1:21:10.33,1:21:14.33,Default,,0,0,0,,Үлкен әпке! ≪Мен! ≫
Dialogue: 0,1:21:23.31,1:21:26.81,Default,,0,0,0,,мамыр! Үлкен әпке!!
Dialogue: 0,1:21:29.32,1:21:32.82,Default,,0,0,0,,Идиот Мэй. кешіріңіз!
Dialogue: 0,1:21:34.32,1:21:38.86,Default,,0,0,0,,Жүгеріні анаңызға жеткізуді жоспарладыңыз ба?
Dialogue: 0,1:21:38.86,1:21:41.86,Default,,0,0,0,,Ахх.
Dialogue: 0,1:21:43.33,1:21:44.83,Default,,0,0,0,,Ах!
Dialogue: 0,1:21:49.84,1:21:52.33,Default,,0,0,0,,Сіз ауруханаға барасыз ба?
Dialogue: 0,1:21:52.33,1:21:54.34,Default,,0,0,0,,♪♪~
Dialogue: 0,1:21:54.34,1:21:57.85,Default,,0,0,0,,Рахмет!! ♪♪~ Уау.
Dialogue: 0,1:21:57.85,1:22:04.26,Default,,0,0,0,,♪♪~
Dialogue: 0,1:22:04.64,1:22:09.63,Default,,0,0,0,,Кешіріңіз, суық тиіп тұрса да аурухана жеделхат жіберді.
Dialogue: 0,1:22:09.63,1:22:14.63,Default,,0,0,0,,Балалар, сендер уайымдап жатқандарыңа сенімдімін. Мен сені аяймын.
Dialogue: 0,1:22:14.63,1:22:17.12,Default,,0,0,0,,Жоқ, түсінсем жеңілдеп қаламын.
Dialogue: 0,1:22:17.12,1:22:20.69,Default,,0,0,0,,Сіз және басқалар осы уақытқа дейін көп еңбек еттіңіз.
Dialogue: 0,1:22:20.69,1:22:23.62,Default,,0,0,0,,Бұл көңіл көтеруді сәл ұзартады.
Dialogue: 0,1:22:23.62,1:22:27.61,Default,,0,0,0,,Менің ойымша, бұл балалар өздерін көрінгеннен де қатты итермеледі.
Dialogue: 0,1:22:27.61,1:22:31.13,Default,,0,0,0,,Мен Сатсукиге ренжідім, өйткені ол бір нәрсені жақсы естиді.
Dialogue: 0,1:22:31.33,1:22:33.33,Default,,0,0,0,,Дұрыс.
Dialogue: 0,1:22:33.33,1:22:37.34,Default,,0,0,0,,Ауруханадан шықсам, сол балалармен өзімшіл боламын →
Dialogue: 0,1:22:37.34,1:22:39.84,Default,,0,0,0,,Мен мұны істеуге рұқсат етемін. Ой ой….
Dialogue: 0,1:22:46.33,1:22:48.35,Default,,0,0,0,,Анам күліп тұр.
Dialogue: 0,1:22:48.35,1:22:50.85,Default,,0,0,0,,Жақсы сияқты. Иә.
Dialogue: 0,1:22:58.84,1:23:01.36,Default,,0,0,0,,Енді тезірек сауығып кетуіңіз керек.
Dialogue: 0,1:23:01.36,1:23:02.90,Default,,0,0,0,,Ах.
Dialogue: 0,1:23:02.90,1:23:04.90,Default,,0,0,0,,Иә?
Dialogue: 0,1:23:10.34,1:23:12.34,Default,,0,0,0,,Бұрын менің жинақтағы ақшам 20 000 йен болатын! Ах, ах…
Dialogue: 0,1:23:12.34,1:23:13.84,Default,,0,0,0,,​​О?
Dialogue: 0,1:23:13.84,1:23:15.34,Default,,0,0,0,,Не болды?
Dialogue: 0,1:23:15.34,1:23:17.33,Default,,0,0,0,,Қазір қарағайда→
Dialogue: 0,1:23:17.33,1:23:19.83,Default,,0,0,0,,Сатсуки мен Мэй күліп тұрғандай болды.
Dialogue: 0,1:23:21.81,1:23:25.31,Default,,0,0,0,,Бұл дұрыс болуы мүмкін.
