Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:01.66,0:01:04.21,Default,,0,0,0,,Уайымдайтын ештеңе жоқ.
Dialogue: 0,0:01:04.21,0:01:07.00,Default,,0,0,0,,Бізге тек өз елімізде тағы да әрекет ету керек.
Dialogue: 0,0:01:07.00,0:01:08.71,Default,,0,0,0,,Қайтадан бастағыңыз келе ме?
Dialogue: 0,0:01:08.71,0:01:11.63,Default,,0,0,0,,Ешбір бағдарлама қатесіз емес, бірақ
Dialogue: 0,0:01:11.63,0:01:14.97,Default,,0,0,0,,Сондай-ақ жөндеуге болмайтын бағдарлама жоқ.
Dialogue: 0,0:01:14.97,0:01:16.13,Default,,0,0,0,,Оны қалай тоқтатамыз?
Dialogue: 0,0:01:16.13,0:01:18.30,Default,,0,0,0,,Сіз түсінбейсіз.
Dialogue: 0,0:01:18.30,0:01:20.72,Default,,0,0,0,,Бұл шынымен қате ме?
Dialogue: 0,0:01:20.72,0:01:23.31,Default,,0,0,0,,2501 жобасы үшін бастапқыда талап етілетін нәрсе болды
Dialogue: 0,0:01:23.31,0:01:24.52,Default,,0,0,0,,майор,
Dialogue: 0,0:01:24.52,0:01:26.64,Default,,0,0,0,,6-бөлім кіруге дайындықты аяқтады.
Dialogue: 0,0:01:28.40,0:01:29.40,Default,,0,0,0,,Мейірім көрсетпе.
Dialogue: 0,0:01:29.40,0:01:30.61,Default,,0,0,0,,Мен сізді естимін.
Dialogue: 0,0:01:32.03,0:01:34.07,Default,,0,0,0,,Сіздің миыңызда шу көп.
Dialogue: 0,0:01:34.99,0:01:36.36,Default,,0,0,0,,Менің етеккірім келді.
Dialogue: 0,0:01:45.79,0:01:50.54,Default,,0,0,0,,9-бөлімнің 6-бөлімнің үйіндісіне араласуы жаман емес пе?
Dialogue: 0,0:01:51.00,0:01:54.05,Default,,0,0,0,,Өйткені екінші тараптың дипломаты зұлым.
Dialogue: 0,0:01:54.05,0:01:57.26,Default,,0,0,0,,Оқиға орнын сәтті түсірсек те, олар жер аударылады.
Dialogue: 0,0:01:57.26,0:01:59.72,Default,,0,0,0,,Қолымызды былғаудан басқа амалымыз жоқ.
Dialogue: 0,0:01:59.72,0:02:00.72,Default,,0,0,0,,Қозғалайық.
Dialogue: 0,0:02:00.72,0:02:02.06,Default,,0,0,0,,Жинау нүктесіне оралу.
Dialogue: 0,0:02:40.18,0:02:41.01,Default,,0,0,0,,Не...!
Dialogue: 0,0:02:41.01,0:02:42.14,Default,,0,0,0,,Қоғамдық қауіпсіздік үшін...?
Dialogue: 0,0:02:50.17,0:02:50.85,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:02:50.85,0:02:52.36,Default,,0,0,0,,Саған атуға кім бұйырды! ?
Dialogue: 0,0:02:52.36,0:02:53.31,Default,,0,0,0,,Қаруыңызды қойыңыз!
Dialogue: 0,0:02:57.78,0:02:59.99,Default,,0,0,0,,Дипломатиялық иммунитет!
Dialogue: 0,0:02:59.99,0:03:01.74,Default,,0,0,0,,Жауапты адамды осында шақырыңыз!
Dialogue: 0,0:03:01.74,0:03:06.41,Default,,0,0,0,,Сертификатталған бағдарламашыларды елден шығару қару эмбаргосын бұзады.
Dialogue: 0,0:03:06.41,0:03:10.12,Default,,0,0,0,,Бұл жолы адам ұрлады деген күдік бар сияқты.
Dialogue: 0,0:03:10.62,0:03:12.42,Default,,0,0,0,,Бұл адам сізге қайтарылады.
Dialogue: 0,0:03:12.42,0:03:14.00,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:03:14.00,0:03:17.92,Default,,0,0,0,,Ол баспана сұрайды және қабылданады, сонымен қатар антқа қол қояды.
Dialogue: 0,0:03:17.92,0:03:18.55,Default,,0,0,0,,Біз біраз нәрсеге шыдай аламыз
Dialogue: 0,0:03:18.55,0:03:20.59,Default,,0,0,0,,Жауап беруге міндетті емес.
Dialogue: 0,0:03:20.59,0:03:23.47,Default,,0,0,0,,Сондықтан халықаралық құқыққа сүйене отырып, Жапония
Dialogue: 0,0:03:23.47,0:03:26.56,Default,,0,0,0,,Оны қорғауға және қайтаруға құқығы бар.
Dialogue: 0,0:03:26.56,0:03:29.10,Default,,0,0,0,,Айтпақшы, ант елшілікте бар.
Dialogue: 0,0:03:29.10,0:03:31.02,Default,,0,0,0,,Мен сізге кейінірек көшірмесін жіберемін.
Dialogue: 0,0:03:31.02,0:03:31.94,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:03:31.94,0:03:33.15,Default,,0,0,0,,Сен тірі оралмайсың.
Dialogue: 0,0:03:33.15,0:03:35.19,Default,,0,0,0,,Мен сенің сыйлы болғаныңды қалаймын.
Dialogue: 0,0:03:35.19,0:03:38.03,Default,,0,0,0,,Біздің еліміз пацифист-демократиялық мемлекет.
Dialogue: 0,0:03:38.03,0:03:38.84,Default,,0,0,0,,О, иә.
Dialogue: 0,0:03:42.86,0:03:43.78,Default,,0,0,0,,Бұл терезенің сыртында.
Dialogue: 0,0:03:43.78,0:03:44.28,Default,,0,0,0,,Әрине, оны есінен тандырып тастаған дұрыс қой?
Dialogue: 0,0:03:52.62,0:03:54.13,Default,,0,0,0,,Оптикалық камуфляж
Dialogue: 0,0:08:44.33,0:08:45.58,Default,,0,0,0,,Бұл сирек.
Dialogue: 0,0:08:45.58,0:08:49.13,Default,,0,0,0,,9-бөлімдегі Арамаки мырзаның Сыртқы істер министрлігінде қандай ісі бар?
Dialogue: 0,0:08:49.13,0:08:53.13,Default,,0,0,0,,Ертең Габель Республикасымен жасырын кездесу жоспарланған.
Dialogue: 0,0:08:53.13,0:08:55.38,Default,,0,0,0,,Бұл әдеттегі ODA.
Dialogue: 0,0:08:55.38,0:08:59.43,Default,,0,0,0,,Революциядан кейін құрылған жаңа үкімет қайта ашуды ұсынды.
Dialogue: 0,0:08:59.43,0:09:03.81,Default,,0,0,0,,Олар бәрін демократиялық жолмен жасайды, бірақ ақырында олар 50 немесе 100 қадамға жетеді.
Dialogue: 0,0:09:03.81,0:09:06.06,Default,,0,0,0,,Бұл сіз тапқан ақша емес, сондықтан оны үйренбейсіз.
Dialogue: 0,0:09:06.06,0:09:08.73,Default,,0,0,0,,Ешкім сізге алғыс айтпайды, өйткені олар оны қанау үшін өтеу деп ойлайды.
Dialogue: 0,0:09:08.73,0:09:10.90,Default,,0,0,0,,Сонда үкіметтің ниеті қандай?
Dialogue: 0,0:09:10.90,0:09:14.82,Default,,0,0,0,,Мәселе баспана сұрап, біздің елде қалғысы келетіндер.
Dialogue: 0,0:09:14.82,0:09:16.95,Default,,0,0,0,,Әскери режимнің бұрынғы басшысы
Dialogue: 0,0:09:16.95,0:09:18.87,Default,,0,0,0,,Бұл полковник Марес болатын.
Dialogue: 0,0:09:18.87,0:09:22.04,Default,,0,0,0,,Мен ол адамды қуып шығып, көмек көрсетуім керек пе?
Dialogue: 0,0:09:22.04,0:09:25.25,Default,,0,0,0,,Баспананы ресми түрде тану және көмек көрсетуден бас тарту; немесе
Dialogue: 0,0:09:25.25,0:09:26.87,Default,,0,0,0,,Бұл қиын бөлік.
Dialogue: 0,0:09:28.04,0:09:31.13,Default,,0,0,0,,Қоғамдық пікірді қанағаттандыратын нақты себеп болса
Dialogue: 0,0:09:31.13,0:09:34.88,Default,,0,0,0,,Ол мен тез арада депортацияланғым келетін адам.
Dialogue: 0,0:09:43.64,0:09:46.86,Default,,0,0,0,,Өткен күнгі кету оқиғасы кезінде сізге көмектескен сияқтысыз.
Dialogue: 0,0:09:46.86,0:09:49.28,Default,,0,0,0,,6-бөлімдегі Накамура мырза маған алғысын білдірді.
Dialogue: 0,0:09:49.28,0:09:53.36,Default,,0,0,0,,Сырт келбетімізбен қолымызды былғай алмаймыз.
Dialogue: 0,0:09:59.28,0:10:00.37,Default,,0,0,0,,Қол жеткізу
Dialogue: 0,0:10:00.83,0:10:02.20,Default,,0,0,0,,Реакцияның жойылуы.
Dialogue: 0,0:10:02.20,0:10:03.83,Default,,0,0,0,,Ми толқынының шығуы туралы не айтасыз?
Dialogue: 0,0:10:03.83,0:10:04.91,Default,,0,0,0,,Ешқандай ауытқулар жоқ.
Dialogue: 0,0:10:04.91,0:10:07.04,Default,,0,0,0,,Имитациялық тәжірибе режимінің үлгісін ауыстырыңыз.
Dialogue: 0,0:10:09.12,0:10:11.17,Default,,0,0,0,,Сыртқы істер министрінің аудармашысы.
Dialogue: 0,0:10:11.17,0:10:15.76,Default,,0,0,0,,Шамамен 23 минут бұрын мені телефон желісі арқылы компьютер бұзды.
Dialogue: 0,0:10:17.38,0:10:20.05,Default,,0,0,0,,Белгілі бір елдегі дереккөз ескерткендей
Dialogue: 0,0:10:20.05,0:10:23.89,Default,,0,0,0,,Қуыршақ ойыншылары интернеттің әрбір терминалына араласа бастады,
Dialogue: 0,0:10:23.89,0:10:29.52,Default,,0,0,0,,Габель Республикасымен жасырын келіссөздерге диверсия жасау мүмкіндігі күшті болды.
Dialogue: 0,0:10:29.52,0:10:32.40,Default,,0,0,0,,Мен жиналғандардың барлығын тормен күтіп отырдым.
Dialogue: 0,0:10:33.23,0:10:38.99,Default,,0,0,0,,Ол кездесуге шабуыл жасау үшін оның елесін бұзуды жоспарлаған болуы мүмкін.
Dialogue: 0,0:10:38.99,0:10:43.83,Default,,0,0,0,,Қауіпті адам тосқауылдан өтіп, оның елесіне жету үшін қанша уақыт қажет?
Dialogue: 0,0:10:43.83,0:10:47.00,Default,,0,0,0,,Қолданылатын құрал ескі HA3, сондықтан
Dialogue: 0,0:10:47.00,0:10:48.33,Default,,0,0,0,,Шамамен 2 сағат.
Dialogue: 0,0:10:48.33,0:10:50.75,Default,,0,0,0,,Бұдан артық кез келген қауіпті, сондықтан сызық кесіледі.
Dialogue: 0,0:10:51.25,0:10:54.46,Default,,0,0,0,,Бату мен Ишикава көлікпен кері іздеудің орнын қадағалайды.
Dialogue: 0,0:10:54.46,0:10:55.25,Default,,0,0,0,,Бізге қосылыңыз.
Dialogue: 0,0:11:14.52,0:11:17.69,Default,,0,0,0,,Әлгі белгісіз хакер қуыршақ па?
Dialogue: 0,0:11:18.20,0:11:19.95,Default,,0,0,0,,Ұлты, болжамды американдық.
Dialogue: 0,0:11:19.95,0:11:22.35,Default,,0,0,0,,Жасы, жынысы, тегі, бәрі белгісіз.
Dialogue: 0,0:11:22.97,0:11:25.95,Default,,0,0,0,,Өткен қыстан бастап ол негізінен ЕК аймағында пайда болды.
Dialogue: 0,0:11:25.95,0:11:31.50,Default,,0,0,0,,Акция бағасымен айла-шарғы жасау, ақпарат жинау, саяси маневр жасау, терроризм, киберэтиканы бұзу,
Dialogue: 0,0:11:31.50,0:11:35.25,Default,,0,0,0,,Қылмыскер оннан астам басқа айыптар бойынша халықаралық іздеуде.
Dialogue: 0,0:11:35.25,0:11:41.01,Default,,0,0,0,,Оған берілген кодтық аты Қуыршақ шебері болды, өйткені оның елестерді бұзу және манипуляциялау әдісі.
Dialogue: 0,0:11:41.63,0:11:43.97,Default,,0,0,0,,Бұл елде бірінші рет пайда болуы керек.
Dialogue: 0,0:11:43.97,0:11:48.35,Default,,0,0,0,,Неліктен мұндай дарынды адам ескі HA3 пайдаланады?
Dialogue: 0,0:11:48.35,0:11:52.90,Default,,0,0,0,,Егер бұл жаңа түрі болса, оны анықтау қиынға соғады, сонымен қатар оны қадағалау қиын.
Dialogue: 0,0:11:52.90,0:11:58.86,Default,,0,0,0,,Бірақ бұл жағдайда жағдайды ескере отырып, бұрынғы әскери режимнің басшысы болған Мареске бірден күдік түседі.
Dialogue: 0,0:11:58.86,0:12:04.16,Default,,0,0,0,,Демеуші Марестің күдігінен аулақ болу үшін әдейі ескі стильді қолданды.
Dialogue: 0,0:12:04.16,0:12:08.49,Default,,0,0,0,,Немесе біздің солай ойлағанымызды қалайтын басқа демеуші бар шығар.
Dialogue: 0,0:12:08.49,0:12:11.87,Default,,0,0,0,,Бір қызығы, Марестің өзі билеуге мәжбүр болған адамдардың бірі болуы мүмкін.
Dialogue: 0,0:12:11.87,0:12:13.50,Default,,0,0,0,,Сіз тым көп ойлайсыз ба?
Dialogue: 0,0:12:13.50,0:12:16.13,Default,,0,0,0,,Қазіргі уақытта бұған негіз жоқ.
Dialogue: 0,0:12:16.13,0:12:17.00,Default,,0,0,0,,Негіздер?
Dialogue: 0,0:12:19.59,0:12:21.51,Default,,0,0,0,,Мен осылай сыбырлаймын,
Dialogue: 0,0:12:21.51,0:12:22.76,Default,,0,0,0,,Менің елес.
Dialogue: 0,0:12:23.34,0:12:26.26,Default,,0,0,0,,Айтпақшы, сіз әлі де револьверді пайдаланасыз ба?
Dialogue: 0,0:12:26.26,0:12:29.06,Default,,0,0,0,,Екі адамдық камерамен екі мылтықты түсірсеңіз де кептеліп қалудан қорқасыз ба?
Dialogue: 0,0:12:29.06,0:12:30.89,Default,,0,0,0,,Маған Матеба ұнайды.
Dialogue: 0,0:12:30.89,0:12:35.19,Default,,0,0,0,,Қолдау көрсетілетін адам ретінде мен артықшылықтан гөрі тиімді басқару күшіне назар аударғым келеді.
Dialogue: 0,0:12:35.19,0:12:37.27,Default,,0,0,0,,Себебі мен қиналамын,
Dialogue: 0,0:12:37.27,0:12:38.73,Default,,0,0,0,,Застава жасаңыз.
Dialogue: 0,0:12:39.98,0:12:40.78,Default,,0,0,0,,майор,
Dialogue: 0,0:12:40.78,0:12:43.32,Default,,0,0,0,,Мен сізден осыны сұрағым келді.
Dialogue: 0,0:12:43.32,0:12:46.74,Default,,0,0,0,,Неге мен сияқты жігітті штабтан суырып алдың?
Dialogue: 0,0:12:46.74,0:12:49.03,Default,,0,0,0,,Өйткені сен сондай жігітсің.
Dialogue: 0,0:12:50.12,0:12:54.62,Default,,0,0,0,,Ол заңсыз әрекеттерде тәжірибесі жоқ, отбасы бар үлкен адам.
Dialogue: 0,0:12:54.62,0:12:58.75,Default,,0,0,0,,Ол компьютерге айналғанымен, оның миы әлі де көп және тірі жан дерлік.
Dialogue: 0,0:12:59.46,0:13:02.01,Default,,0,0,0,,Сіз қаншалықты жақсы жауынгер болсаңыз да,
Dialogue: 0,0:13:02.01,0:13:04.67,Default,,0,0,0,,Бірдей стандартты өнімдерден тұратын жүйелер
Dialogue: 0,0:13:04.67,0:13:07.55,Default,,0,0,0,,Оның бір жерде өлімге әкелетін кемшілігі болады.
Dialogue: 0,0:13:08.30,0:13:09.72,Default,,0,0,0,,Ұйымдар және адамдар
Dialogue: 0,0:13:09.72,0:13:12.81,Default,,0,0,0,,Мамандықтың соңы баяу өлім,
Dialogue: 0,0:13:12.81,0:13:14.14,Default,,0,0,0,,Міне.
Dialogue: 0,0:13:25.40,0:13:26.40,Default,,0,0,0,,Эй!
Dialogue: 0,0:13:26.40,0:13:27.45,Default,,0,0,0,,Мен білемін!
Dialogue: 0,0:13:32.83,0:13:35.25,Default,,0,0,0,,Сіз барлығы 40 секундқа артта қалдыңыз! ?
Dialogue: 0,0:13:35.25,0:13:36.92,Default,,0,0,0,,Бұл бар болғаны 5 секундты алады!
Dialogue: 0,0:13:36.92,0:13:38.38,Default,,0,0,0,,Тимлайн: Yi Hua; Пост-өндіріс: Blackfeather; Кодтау: prpr Dog; BD түзетулері: Apa Cha Дистрибьютор Fei Shi
Dialogue: 0,0:13:45.22,0:13:46.72,Default,,0,0,0,,Эй, бұл өте жаман.
Dialogue: 0,0:13:46.72,0:13:52.47,Default,,0,0,0,,Егер бұлай болса, менің бұрынғы серіктесім заңсыз жұмыс істегені үшін одан да нашар болар еді.
Dialogue: 0,0:13:54.56,0:13:59.52,Default,,0,0,0,,Дегенмен, елес бұзудан кейін әйеліңіздің өзін қалай сезінетінін білгіңіз келе ме?
Dialogue: 0,0:13:59.52,0:14:03.98,Default,,0,0,0,,Бетіңізді біріктіріп, кенеттен ажырасуыңызды сұрамаңыз.
Dialogue: 0,0:14:03.98,0:14:06.07,Default,,0,0,0,,Соның арқасында қызым бейтаныс адам сияқты.
Dialogue: 0,0:14:06.07,0:14:09.45,Default,,0,0,0,,Оның тәкаппар болғаны сонша, мен оны алдап жатырмын деп күдіктенеді.
Dialogue: 0,0:14:09.45,0:14:12.74,Default,,0,0,0,,Бірақ мен тосқауылдан оңай өтіп кеттім.
Dialogue: 0,0:14:12.74,0:14:14.58,Default,,0,0,0,,Ол бағдарламашы сияқты, бірақ
Dialogue: 0,0:14:14.58,0:14:17.71,Default,,0,0,0,,Барда өте мейірімді жігітті кездестіріңіз.
Dialogue: 0,0:14:17.71,0:14:20.46,Default,,0,0,0,,Әйелімнің қорғаушысы тым жақсы болса, мені кездестіруге рұқсат етпесе ше?
Dialogue: 0,0:14:20.46,0:14:22.50,Default,,0,0,0,,Менімен кеңескеніңіз үшін рахмет.
Dialogue: 0,0:14:22.50,0:14:25.59,Default,,0,0,0,,Осылайша сіз орындарды өзгерту кезінде оған қол жеткізе алмайсыз.
Dialogue: 0,0:14:25.59,0:14:27.55,Default,,0,0,0,,Сен ақылдысың.
Dialogue: 0,0:14:32.18,0:14:33.18,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:14:33.18,0:14:34.72,Default,,0,0,0,,Сен өте өлдің! ?
Dialogue: 0,0:14:34.72,0:14:37.85,Default,,0,0,0,,Бізден басқа жұмысбасты адамдар бар екеніне сенімдімін.
Dialogue: 0,0:14:41.52,0:14:42.61,Default,,0,0,0,,Мұнда ешкім жоқ.
Dialogue: 0,0:14:43.52,0:14:44.61,Default,,0,0,0,,Оның мағынасы жоқ.
Dialogue: 0,0:14:44.61,0:14:48.20,Default,,0,0,0,,Керісінше тауып алсаң да, біз жеткенше шаршайсың.
Dialogue: 0,0:14:48.20,0:14:49.86,Default,,0,0,0,,Бұл мысық пен тышқан ойыны ма?
Dialogue: 0,0:14:49.86,0:14:51.16,Default,,0,0,0,,Бұлай шағымданба.
Dialogue: 0,0:14:51.16,0:14:53.78,Default,,0,0,0,,Құсанағы мен Тоғуса келесі болжамды аймаққа бет алды.
Dialogue: 0,0:14:53.78,0:14:56.33,Default,,0,0,0,,Балалар, сол жерден бірдеңе іздеу керек.
Dialogue: 0,0:14:56.33,0:14:57.96,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:14:57.96,0:14:59.12,Default,,0,0,0,,Бір нәрсе!
Dialogue: 0,0:15:00.00,0:15:01.25,Default,,0,0,0,,Ақымақ қарт,
Dialogue: 0,0:15:01.25,0:15:02.75,Default,,0,0,0,,Менің сенен бірдеңе сұрағанымды қалайсың ба?
Dialogue: 0,0:15:02.75,0:15:04.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:04.59,0:15:07.05,Default,,0,0,0,,Ой, мен уақытында үлгермедім.
Dialogue: 0,0:15:07.05,0:15:10.26,Default,,0,0,0,,Аға, сен мұнда тазалау машинасын көрдің бе?
Dialogue: 0,0:15:10.26,0:15:11.76,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:15:11.76,0:15:13.85,Default,,0,0,0,,Көрдіңіз бе? Сіз оны көрмедіңіз бе? ? Қайсысы?
Dialogue: 0,0:15:13.85,0:15:15.01,Default,,0,0,0,,Мен оны көрдім
Dialogue: 0,0:15:15.01,0:15:17.39,Default,,0,0,0,,Сонымен, қоқысты өзіңізбен бірге әкелсеңіз, ол жойылды.
Dialogue: 0,0:15:17.39,0:15:20.35,Default,,0,0,0,,Бір адам телефонмен сөйлесті, мен оны уақытында жеткізе аламын деп үміттенемін.
Dialogue: 0,0:15:23.52,0:15:26.23,Default,,0,0,0,,Ум, эй, эй, мынау...
Dialogue: 0,0:15:26.65,0:15:28.19,Default,,0,0,0,,Қалпына келтіру көлігі?
Dialogue: 0,0:15:28.19,0:15:30.45,Default,,0,0,0,,Қараймын, ол 7 минут сайын қозғалады.
Dialogue: 0,0:15:30.90,0:15:31.82,Default,,0,0,0,,Бас кеңсе;
Dialogue: 0,0:15:31.82,0:15:34.70,Default,,0,0,0,,Жергілікті тазалау бөлімінен ақпарат алыңыз.
Dialogue: 0,0:15:45.79,0:15:48.38,Default,,0,0,0,,Ауданды патрульдеуде сегіз құтқару көлігі.
Dialogue: 0,0:15:48.38,0:15:51.13,Default,,0,0,0,,Нысаналы көлік, C79 түрі.
Dialogue: 0,0:15:54.60,0:15:55.85,Default,,0,0,0,,Мен саған көлік жүргіземін.
Dialogue: 0,0:16:05.36,0:16:07.82,Default,,0,0,0,,Ишикава, қалпына келтіру көлігімен адамның үйіне барыңыз.
Dialogue: 0,0:16:07.82,0:16:10.28,Default,,0,0,0,,Бату келесі патрульдік пунктке өтуі керек.
Dialogue: 0,0:16:10.28,0:16:12.53,Default,,0,0,0,,Сіз біреумен байланыста болуыңыз мүмкін.
Dialogue: 0,0:16:12.53,0:16:15.03,Default,,0,0,0,,Тек оған қол тигізбей орындаңыз.
Dialogue: 0,0:16:15.03,0:16:16.74,Default,,0,0,0,,Патрульдік пункт деректері келді.
Dialogue: 0,0:16:17.20,0:16:18.99,Default,,0,0,0,,Кері іздеу нүктесіне сәйкес келеді.
Dialogue: 0,0:16:18.99,0:16:21.33,Default,,0,0,0,,Нысана, келесі нүктеде орналасқан.
Dialogue: 0,0:16:23.17,0:16:25.40,Default,,0,0,0,,HA3, рұқсатты растау.
Dialogue: 0,0:16:31.01,0:16:32.55,Default,,0,0,0,,Wariiwarii.
Dialogue: 0,0:16:32.55,0:16:33.09,Default,,0,0,0,,Эй,
Dialogue: 0,0:16:33.09,0:16:36.01,Default,,0,0,0,,Екінші жартысында мен қоқыс тасамын, ал сен телефон соғасың.
Dialogue: 0,0:16:37.47,0:16:38.22,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:16:38.22,0:16:40.93,Default,,0,0,0,,Мен саған сыбайлас болғым келмейді.
Dialogue: 0,0:16:40.93,0:16:43.31,Default,,0,0,0,,Қандай аянышты оқиға.
Dialogue: 0,0:16:43.73,0:16:45.02,Default,,0,0,0,,Сіздің балаларыңыз бар ма?
Dialogue: 0,0:16:45.02,0:16:46.86,Default,,0,0,0,,Біреу бар сияқты ма?
Dialogue: 0,0:16:46.86,0:16:48.98,Default,,0,0,0,,Сонда сіз түсінбейтін шығарсыз.
Dialogue: 0,0:16:48.98,0:16:51.32,Default,,0,0,0,,Қызым менің өмірім.
Dialogue: 0,0:16:51.32,0:16:53.61,Default,,0,0,0,,Қарашы, сен періштеге ұқсайсың, солай емес пе?
Dialogue: 0,0:16:54.49,0:16:57.28,Default,,0,0,0,,Менің басқалардың альбомдарын қарау хоббиім жоқ.
Dialogue: 0,0:17:00.29,0:17:01.83,Default,,0,0,0,,Иә, №79 вагон.
Dialogue: 0,0:17:01.83,0:17:02.70,Default,,0,0,0,,О, бастық!
Dialogue: 0,0:17:02.70,0:17:03.71,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:17:05.04,0:17:07.42,Default,,0,0,0,,Полиция біздің аудандарды патрульдейді ме?
Dialogue: 0,0:17:07.42,0:17:08.50,Default,,0,0,0,,Неліктен бұлай?
Dialogue: 0,0:17:08.50,0:17:10.34,Default,,0,0,0,,Мен білмеймін!
Dialogue: 0,0:17:13.42,0:17:15.13,Default,,0,0,0,,Бұзушылық әшкере болды!
Dialogue: 0,0:17:15.13,0:17:17.30,Default,,0,0,0,,Мен сол мейірімді жігітке хабарлауым керек!
Dialogue: 0,0:17:17.30,0:17:19.14,Default,,0,0,0,,Мен бір патрульдік орынды өткізіп жіберемін!
Dialogue: 0,0:17:19.97,0:17:24.39,Default,,0,0,0,,Нысана патрульдік жолдан шығып, келесі нүктеге дейін жылдамдады.
Dialogue: 0,0:17:24.81,0:17:26.44,Default,,0,0,0,,Сіз мұны сездіңіз бе?
Dialogue: 0,0:17:26.44,0:17:28.27,Default,,0,0,0,,Көру ауқымына кірмеңіз.
Dialogue: 0,0:17:28.27,0:17:31.02,Default,,0,0,0,,Мүмкін ол Тазалық бюросының интернетіне кіргені үшін табылған шығар.
Dialogue: 0,0:17:31.65,0:17:33.11,Default,,0,0,0,,Артынан жасырын кіріп кетсем екен.
Dialogue: 0,0:17:33.11,0:17:33.94,Default,,0,0,0,,Сөзсіз.
Dialogue: 0,0:17:33.94,0:17:35.36,Default,,0,0,0,,Қарсыласпен соғысыңыз және оны басып тұрыңыз.
Dialogue: 0,0:17:40.03,0:17:41.45,Default,,0,0,0,,Мен сізге дискіні қайтарып беремін.
Dialogue: 0,0:18:46.60,0:18:48.73,Default,,0,0,0,,А, брондалған фургон Будда.
Dialogue: 0,0:18:48.73,0:18:50.19,Default,,0,0,0,,Күшті оқтары бар біріктірілген от! ?
Dialogue: 0,0:18:50.19,0:18:52.19,Default,,0,0,0,,Көліктің есігі тесіліп қалады!
Dialogue: 0,0:18:52.19,0:18:53.77,Default,,0,0,0,,Автоматпен?
Dialogue: 0,0:18:53.77,0:18:55.15,Default,,0,0,0,,Ақылсыз бейбақ
Dialogue: 0,0:19:09.54,0:19:11.50,Default,,0,0,0,,Ол тіпті оптикалық камуфляжды пайдаланады!
Dialogue: 0,0:19:11.50,0:19:12.58,Default,,0,0,0,,Тек орындаңыз!
Dialogue: 0,0:19:12.58,0:19:14.17,Default,,0,0,0,,Мен жоғарыдан айналайын.
Dialogue: 0,0:19:15.25,0:19:16.13,Default,,0,0,0,,Тоғуса,
Dialogue: 0,0:19:16.13,0:19:18.80,Default,,0,0,0,,Егер олар әлі тірі болса, көліктегі екі адамды қамауға алыңыз!
Dialogue: 0,0:19:18.80,0:19:20.30,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:19:21.30,0:19:23.80,Default,,0,0,0,,Бұл жағымсыз жұмыс орны.
Dialogue: 0,0:20:23.36,0:20:24.49,Default,,0,0,0,,Полиция!
Dialogue: 0,0:20:24.49,0:20:25.87,Default,,0,0,0,,Барлығы жатсын!
Dialogue: 0,0:22:26.57,0:22:27.95,Default,,0,0,0,,Бұл соңы ма?
Dialogue: 0,0:23:21.21,0:23:22.54,Default,,0,0,0,,Ол аяқталды ма?
Dialogue: 0,0:23:24.19,0:23:27.09,Default,,0,0,0,,Мұндай мылтық ауыр оқтарды атуы мүмкін.
Dialogue: 0,0:23:27.09,0:23:31.30,Default,,0,0,0,,Рамкалардың сылдырлары. Бөшке де жақсы емес.
Dialogue: 0,0:23:31.30,0:23:32.93,Default,,0,0,0,,Сізді қамауға алудың қажеті жоқ.
Dialogue: 0,0:23:32.93,0:23:34.89,Default,,0,0,0,,Ештеңені түкірме!
Dialogue: 0,0:23:34.89,0:23:36.51,Default,,0,0,0,,Құсу?
Dialogue: 0,0:23:38.31,0:23:43.73,Default,,0,0,0,,Сенің атыңды да білмейтін мына бейбақ бастық болмасын, ақымақ!
Dialogue: 0,0:23:45.23,0:23:47.40,Default,,0,0,0,,Ананың жүзі,
Dialogue: 0,0:23:47.40,0:23:49.40,Default,,0,0,0,,Мен туған қаланың көрінісі,
Dialogue: 0,0:23:50.20,0:23:52.07,Default,,0,0,0,,Балалық шақтағы естеліктер
Dialogue: 0,0:23:53.66,0:23:55.95,Default,,0,0,0,,Есіңде бірдеңе бар ма?
Dialogue: 0,0:24:03.58,0:24:06.80,Default,,0,0,0,,Аруағы жоқ қуыршақ мұңды.
Dialogue: 0,0:24:06.80,0:24:09.38,Default,,0,0,0,,Әсіресе тамырларында қызыл қан ағып жатқандар.
Dialogue: 0,0:24:25.69,0:24:28.23,Default,,0,0,0,,Егер сарайға тікұшақ жолаушысы кірсе, ол асығады.
Dialogue: 0,0:24:28.23,0:24:29.48,Default,,0,0,0,,В тобы артқы жағында;
Dialogue: 0,0:24:29.48,0:24:31.19,Default,,0,0,0,,Қалғандары майданға айналады.
Dialogue: 0,0:24:31.70,0:24:32.40,Default,,0,0,0,,Сайто,
Dialogue: 0,0:24:32.40,0:24:36.03,Default,,0,0,0,,Сіздің командаңызға сарайдағы барлық көліктерді электр желісінен ажыратуды сұраңыз.
Dialogue: 0,0:24:36.78,0:24:38.20,Default,,0,0,0,,Жазуды бастау.
Dialogue: 0,0:24:41.79,0:24:43.62,Default,,0,0,0,,Штабтан бас менеджерге дейін.
Dialogue: 0,0:24:44.17,0:24:47.25,Default,,0,0,0,,Майор ұстаған адамның жеке басы анықталды.
Dialogue: 0,0:24:47.25,0:24:48.42,Default,,0,0,0,,Тыңдап көрейік.
Dialogue: 0,0:24:48.42,0:24:50.84,Default,,0,0,0,,Сент-Женфер, 28 жаста.
Dialogue: 0,0:24:51.26,0:24:53.17,Default,,0,0,0,,Иммиграциялық бақылау заңын бұзу;
Dialogue: 0,0:24:53.17,0:24:55.84,Default,,0,0,0,,Бұрынғы үш соттылық, соның ішінде атыс қаруы мен қылыштарды заңсыз сақтау.
Dialogue: 0,0:24:56.43,0:25:00.93,Default,,0,0,0,,Ол өткен айдың соңында жоғалып кеткенге дейін босқындарға негізделген қарулы күрес ұйымының мүшесі болған.
Dialogue: 0,0:25:01.52,0:25:04.44,Default,,0,0,0,,Шамамен бір апта бұрын мен бұл соттылықты сатып алдым,
Dialogue: 0,0:25:04.94,0:25:10.78,Default,,0,0,0,,Мен Габель Республикасы үкіметінің елшілік атташесінен жасырын жиналысқа шабуыл жасау туралы өтініш алдым.
Dialogue: 0,0:25:11.45,0:25:13.03,Default,,0,0,0,,Сонда шындық қандай?
Dialogue: 0,0:25:13.03,0:25:14.74,Default,,0,0,0,,Әдетте Корги ретінде белгілі.
Dialogue: 0,0:25:14.74,0:25:18.28,Default,,0,0,0,,Мамандығы аздап шулы қалдық өнім пайдаланушысы.
Dialogue: 0,0:25:18.28,0:25:19.99,Default,,0,0,0,,Оларды шимпирлер деп те атайды.
Dialogue: 0,0:25:20.41,0:25:23.91,Default,,0,0,0,,Бұл учаскелік полиция бөлімшесінің соттылық тізімінде расталды.
Dialogue: 0,0:25:24.91,0:25:27.96,Default,,0,0,0,,Қай жерден қағып алсаң да Ғабельге қатысы жоқ.
Dialogue: 0,0:25:28.59,0:25:31.00,Default,,0,0,0,,Бұл қуыршақ басқаратын қуыршақ.
Dialogue: 0,0:25:31.67,0:25:33.09,Default,,0,0,0,,Ишикава ше?
Dialogue: 0,0:25:33.59,0:25:38.51,Default,,0,0,0,,Мен қазір қайтып келдім, мен Тоғуса екеуміз қазір нашар тазалаушыларды көндіреміз.
Dialogue: 0,0:25:40.93,0:25:44.18,Default,,0,0,0,,Сонымен, сол жерде пайда болған қуыршақ кім болды?
Dialogue: 0,0:25:44.68,0:25:46.19,Default,,0,0,0,,Ол қандай адам?
Dialogue: 0,0:25:51.86,0:25:54.19,Default,,0,0,0,,Ол қуыршақ сияқты.
Dialogue: 0,0:25:54.19,0:25:55.40,Default,,0,0,0,,В тобының жақсы орналасуы.
Dialogue: 0,0:25:55.40,0:25:57.03,Default,,0,0,0,,А және С тобы жақсы.
Dialogue: 0,0:25:57.03,0:25:59.12,Default,,0,0,0,,Кіруге дайындық аяқталды.
Dialogue: 0,0:26:00.28,0:26:01.79,Default,,0,0,0,,Тез кіріңіз.
Dialogue: 0,0:26:05.12,0:26:07.83,Default,,0,0,0,,Имитациялық тәжірибе дегеніміз не?
Dialogue: 0,0:26:07.83,0:26:14.76,Default,,0,0,0,,Сондықтан менің әйелім де, қызым да, ажырасуым да, араласуым да - бәрі жалған естеліктер мен армандар.
Dialogue: 0,0:26:14.76,0:26:19.59,Default,,0,0,0,,Сізді біреу мемлекеттік қызметкерлерді хакерлеу үшін пайдаланды.
Dialogue: 0,0:26:20.10,0:26:22.18,Default,,0,0,0,,Сіздің келесі баратын жеріңіз — Сан-Джорджо-Маджоре аралы
Dialogue: 0,0:26:22.18,0:26:24.85,Default,,0,0,0,,Мен сіздің пәтеріңізге бардым.
Dialogue: 0,0:26:24.85,0:26:26.31,Default,,0,0,0,,Ешкімді емдеме.
Dialogue: 0,0:26:26.31,0:26:27.69,Default,,0,0,0,,Бұл мен үшін бөлме.
Dialogue: 0,0:26:27.69,0:26:28.69,Default,,0,0,0,,Сондықтан,
Dialogue: 0,0:26:28.69,0:26:30.86,Default,,0,0,0,,Ол бөлме мен бөлек тұру үшін жалға алған пәтер.
Dialogue: 0,0:26:30.86,0:26:33.94,Default,,0,0,0,,Сіз бұл бөлмеде 10 жыл бойы тұрып жатырсыз.
Dialogue: 0,0:26:34.69,0:26:37.20,Default,,0,0,0,,Әйелін де, балаларын да емдемейді.
Dialogue: 0,0:26:37.20,0:26:40.62,Default,,0,0,0,,Бұл тек сіздің басыңызда болатын отбасы.
Dialogue: 0,0:26:42.20,0:26:43.66,Default,,0,0,0,,Қараңыз.
Dialogue: 0,0:26:43.66,0:26:46.08,Default,,0,0,0,,Бұл сіз әріптесіңізге көрсеткіңіз келген фотосурет.
Dialogue: 0,0:26:46.79,0:26:48.04,Default,,0,0,0,,Суретте кім?
Dialogue: 0,0:26:49.29,0:26:51.29,Default,,0,0,0,,Бұл суретте анық болды.
Dialogue: 0,0:26:51.29,0:26:53.00,Default,,0,0,0,,Менің қызым
Dialogue: 0,0:26:53.00,0:26:55.84,Default,,0,0,0,,Періштедей күлімде
Dialogue: 0,0:26:55.84,0:26:57.76,Default,,0,0,0,,Қызының аты кім?
Dialogue: 0,0:26:57.76,0:27:00.47,Default,,0,0,0,,Әйеліңізбен қашан және қай жерде кездестіңіз?
Dialogue: 0,0:27:00.47,0:27:02.43,Default,,0,0,0,,Сіз неше жыл бұрын тұрмыс құрдыңыз?
Dialogue: 0,0:27:03.93,0:27:07.60,Default,,0,0,0,,Суретте кім?
Dialogue: 0,0:27:09.94,0:27:13.94,Default,,0,0,0,,Сол жалған арманды қалай өшіремін?
Dialogue: 0,0:27:13.94,0:27:16.11,Default,,0,0,0,,Өкінішке орай, қазіргі технологиямен
Dialogue: 0,0:27:16.90,0:27:18.99,Default,,0,0,0,,Табыстың тек екі жағдайы туралы хабарланды.
Dialogue: 0,0:27:18.99,0:27:20.49,Default,,0,0,0,,Өте ұсынылмайды.
Dialogue: 0,0:27:21.20,0:27:22.66,Default,,0,0,0,,Мен сені аяймын.
Dialogue: 0,0:27:23.20,0:27:25.49,Default,,0,0,0,,Имитациялық тәжірибелер мен армандар,
Dialogue: 0,0:27:25.49,0:27:29.08,Default,,0,0,0,,Бар ақпараттың барлығы шынайы;
Dialogue: 0,0:27:29.08,0:27:30.71,Default,,0,0,0,,Және бұл елес.
Dialogue: 0,0:27:32.21,0:27:37.46,Default,,0,0,0,,Қалай болғанда да, жалғыз адам өмір бойы байланыста болатын ақпарат мөлшері өте аз.
Dialogue: 0,0:29:06.18,0:29:09.93,Default,,0,0,0,,Киборг жұмыстан тыс кезде суға түсуге келе ме?
Dialogue: 0,0:29:09.93,0:29:11.60,Default,,0,0,0,,Бұл жақсы үрдіс емес.
Dialogue: 0,0:29:11.60,0:29:14.19,Default,,0,0,0,,Сіз қашан бастадыңыз? Осындай нәрселер
Dialogue: 0,0:29:18.56,0:29:20.78,Default,,0,0,0,,Теңізден қорықпайсың ба?
Dialogue: 0,0:29:20.78,0:29:23.40,Default,,0,0,0,,Егер флоатр жұмыс істемесе
Dialogue: 0,0:29:23.40,0:29:25.20,Default,,0,0,0,,Сонда сен өлесің.
Dialogue: 0,0:29:25.20,0:29:27.32,Default,,0,0,0,,Әлде сен маған секіріп көмектесесің бе?
Dialogue: 0,0:29:28.87,0:29:31.20,Default,,0,0,0,,Мен оны менімен бірге шығуға мәжбүрлегендей емес.
Dialogue: 0,0:29:31.79,0:29:32.70,Default,,0,0,0,,Сен оны тым асыра бағалап жатырсың.
Dialogue: 0,0:30:05.78,0:30:08.70,Default,,0,0,0,,Әй, мұхитқа сүңгу қандай?
Dialogue: 0,0:30:09.20,0:30:12.58,Default,,0,0,0,,Сіз су асты курсын аяқтаған жоқсыз ба?
Dialogue: 0,0:30:12.58,0:30:14.95,Default,,0,0,0,,Бұл бассейн туралы әңгімені тыңдамаңыз.
Dialogue: 0,0:30:16.16,0:30:19.21,Default,,0,0,0,,Қорқыныш, қобалжу, жалғыздық, қараңғылық
Dialogue: 0,0:30:19.21,0:30:21.88,Default,,0,0,0,,Және мүмкін үміт.
Dialogue: 0,0:30:21.88,0:30:23.00,Default,,0,0,0,,(Сора) …Дегенмен, болған жайттардың бәрінен кейін,
Dialogue: 0,0:30:23.00,0:30:24.67,Default,,0,0,0,,Қараңғы теңізде?
Dialogue: 0,0:30:25.80,0:30:30.64,Default,,0,0,0,,Теңіздің бетіне шыққанда, бұрынғыдан басқа адам бола алар ма екенмін.
Dialogue: 0,0:30:30.64,0:30:32.47,Default,,0,0,0,,Кейде менде солай болады.
Dialogue: 0,0:30:37.98,0:30:40.90,Default,,0,0,0,,9-бөлімнен шыққыңыз келмей ме?
Dialogue: 0,0:30:44.57,0:30:45.53,Default,,0,0,0,,Бату,
Dialogue: 0,0:30:45.53,0:30:47.82,Default,,0,0,0,,Сіздің денеңіз қаншалықты түпнұсқа?
Dialogue: 0,0:30:47.82,0:30:49.45,Default,,0,0,0,,Сіз массыз ба? Сіз
Dialogue: 0,0:30:50.07,0:30:51.99,Default,,0,0,0,,Бұл пайдалы нәрсе.
Dialogue: 0,0:30:51.99,0:30:54.95,Default,,0,0,0,,Егер сізге ұнаса, денеңізге имплантацияланған химиялық зауытты қолдануға болады.
Dialogue: 0,0:30:54.95,0:30:59.21,Default,,0,0,0,,Қаныңыздағы алкогольді ыдыратып, бірнеше ондаған секундта байыптылыққа оралуға болады.
Dialogue: 0,0:30:59.21,0:31:02.50,Default,,0,0,0,,Сондықтан күтіп отырып ішуге болады.
Dialogue: 0,0:31:02.50,0:31:06.30,Default,,0,0,0,,Мүмкін болса, кез келген технология оны жүзеге асырмай тұра алмайды.
Dialogue: 0,0:31:06.30,0:31:09.26,Default,,0,0,0,,Бұл адамның инстинкті сияқты.
Dialogue: 0,0:31:09.26,0:31:11.84,Default,,0,0,0,,Зат алмасуды бақылау, қабылдауды ұштау,
Dialogue: 0,0:31:11.84,0:31:14.72,Default,,0,0,0,,Қозғалыс дағдылары мен рефлекстерінің күрт жақсаруы,
Dialogue: 0,0:31:14.72,0:31:17.14,Default,,0,0,0,,Ақпаратты өңдеуді жеделдету және кеңейту
Dialogue: 0,0:31:17.56,0:31:22.23,Default,,0,0,0,,Кибернетика мен протездік денелер арқылы анағұрлым жоғары қабілеттерге ие болғаннан кейін,
Dialogue: 0,0:31:22.23,0:31:25.94,Default,,0,0,0,,Ең жоғары деңгейде күтімсіз өмір сүру мүмкін болмаса да
Dialogue: 0,0:31:25.94,0:31:27.94,Default,,0,0,0,,Шағымданудың қажеті жоқ.
Dialogue: 0,0:31:27.94,0:31:31.91,Default,,0,0,0,,9-бөлімге жанымызды сатқан сияқты емеспіз.
Dialogue: 0,0:31:32.32,0:31:35.24,Default,,0,0,0,,Иә, менің зейнетке шығуға құқығым бар.
Dialogue: 0,0:31:35.24,0:31:40.46,Default,,0,0,0,,Егер сіз кішіпейілділікпен осы протездік денені және кейбір естеліктеріңізді үкіметке қайтарсаңыз.
Dialogue: 0,0:31:40.46,0:31:44.92,Default,,0,0,0,,Адамды адам ететін бөліктер ешқашан аз болмағаны сияқты,
Dialogue: 0,0:31:44.92,0:31:49.22,Default,,0,0,0,,Өзің болу үшін қанша нәрсе керек екені таңқаларлық.
Dialogue: 0,0:31:50.05,0:31:53.59,Default,,0,0,0,,Бізді басқалардан ажырататын бет және бейсаналық дауыс,
Dialogue: 0,0:31:53.59,0:31:55.18,Default,,0,0,0,,Оянғанда қараған қол,
Dialogue: 0,0:31:55.18,0:31:57.89,Default,,0,0,0,,Балалық шақтағы естеліктер, болашақ туралы ескертулер.
Dialogue: 0,0:31:58.52,0:32:00.02,Default,,0,0,0,,Бұл бәрі емес.
Dialogue: 0,0:32:00.02,0:32:03.90,Default,,0,0,0,,Менің компьютерім қол жеткізе алатын ақпараттың үлкен көлемі және Интернеттің таралуы,
Dialogue: 0,0:32:03.90,0:32:06.02,Default,,0,0,0,,Олардың барлығы менің бір бөлігім
Dialogue: 0,0:32:06.02,0:32:08.44,Default,,0,0,0,,Мен болатын сананы жасаңыз,
Dialogue: 0,0:32:09.74,0:32:13.78,Default,,0,0,0,,Сонымен бірге ол мені белгілі бір шектеулерге шектеуді жалғастыруда.
Dialogue: 0,0:32:19.00,0:32:22.75,Default,,0,0,0,,Сол үшін батып бара жатқан денені көтеріп теңізге сүңгисің бе?
Dialogue: 0,0:32:22.75,0:32:25.96,Default,,0,0,0,,Қараңғы мұхит түбінен не көруге болады?
Dialogue: 0,0:32:26.54,0:32:35.89,Default,,0,0,0,,Енді біз айна ұстаймыз, көргеніміз бұлыңғыр.
Dialogue: 0,0:32:39.43,0:32:41.31,Default,,0,0,0,,Бұл қазір сенсің, солай ма?
Dialogue: 0,0:37:04.78,0:37:07.66,Default,,0,0,0,,Егер кешігіп қалатын болсаң, неге маған хабар бермейсің!
Dialogue: 0,0:37:11.25,0:37:12.50,Default,,0,0,0,,Дайын.
Dialogue: 0,0:37:12.50,0:37:13.75,Default,,0,0,0,,Қосылу.
Dialogue: 0,0:37:37.02,0:37:38.19,Default,,0,0,0,,Жарайды,
Dialogue: 0,0:37:38.19,0:37:39.02,Default,,0,0,0,,Жетеді!
Dialogue: 0,0:37:39.02,0:37:39.77,Default,,0,0,0,,Кесу!
Dialogue: 0,0:37:40.57,0:37:43.19,Default,,0,0,0,,3 минут ішінде басшының кабинетіне есеп беру.
Dialogue: 0,0:37:47.82,0:37:52.62,Default,,0,0,0,,Сіз кешігіп келгендіктен, мен сізге түсіндіріп беруге дайынмын.
Dialogue: 0,0:37:53.16,0:37:57.08,Default,,0,0,0,,Шамамен екі сағат бұрын Ньюпорт-Ситидегі Megatech Body Co., Ltd. желісі ашылды.
Dialogue: 0,0:37:57.08,0:37:59.50,Default,,0,0,0,,Ол рұқсатсыз протездік денелер жасай бастаған көрінеді.
Dialogue: 0,0:37:59.50,0:38:04.76,Default,,0,0,0,,Шенеунік мұны байқап, жеткенше протездік дене қашып үлгерген.
Dialogue: 0,0:38:04.76,0:38:07.89,Default,,0,0,0,,Біз қоршау орнатып, іздеген аймаққа.
Dialogue: 0,0:38:07.89,0:38:11.75,Default,,0,0,0,,Сіз тас жолда адасып жүрген жалаңаш әйелді қағып кеттіңіз.
Dialogue: 0,0:38:11.75,0:38:14.48,Default,,0,0,0,,Унчан деген арлы адам.
Dialogue: 0,0:38:14.48,0:38:16.69,Default,,0,0,0,,Бұл жерге әкелінді.
Dialogue: 0,0:38:16.69,0:38:19.73,Default,,0,0,0,,Megatech Body - мемлекет сатып алатын өндіруші.
Dialogue: 0,0:38:19.73,0:38:22.90,Default,,0,0,0,,Сонда ол жерде жасалған барлық протездік денелер құпия болып табылады ма?
Dialogue: 0,0:38:22.90,0:38:27.24,Default,,0,0,0,,Егер бұл хакердің жұмысы болса, олар шабуыл тосқауылынан өтуде өте шебер.
Dialogue: 0,0:38:27.24,0:38:29.24,Default,,0,0,0,,Бұл жалғыз мәселе емес.
Dialogue: 0,0:38:32.28,0:38:37.21,Default,,0,0,0,,Әрине, оның басында мидың бір бөлігі жоқ,
Dialogue: 0,0:38:37.75,0:38:42.42,Default,,0,0,0,,Көмекші компьютердің ішінде елес сияқты бірдеңе бар сияқты.
Dialogue: 0,0:38:43.63,0:38:49.05,Default,,0,0,0,,Бұл елесті дубляждау кезінде пайда болатын псевдо-елес сызығына ұқсамайды.
Dialogue: 0,0:38:49.05,0:38:52.14,Default,,0,0,0,,Дубляжға тән ақпараттың нашарлауы байқалмайды.
Dialogue: 0,0:38:52.60,0:38:53.72,Default,,0,0,0,,Кез келген жағдайда
Dialogue: 0,0:38:53.72,0:38:59.60,Default,,0,0,0,,Шлагбаумның айналасындағы аумақтың картасын жасап, сүңгімейінше, сенімді болу мүмкін емес.
Dialogue: 0,0:38:59.60,0:39:00.52,Default,,0,0,0,,Сонымен,
Dialogue: 0,0:39:00.52,0:39:02.61,Default,,0,0,0,,Мен сол затты тексерудің ортасындамын.
Dialogue: 0,0:39:02.61,0:39:03.94,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:39:03.94,0:39:06.36,Default,,0,0,0,,Ал, оны бөліп алайық.
Dialogue: 0,0:39:11.62,0:39:15.24,Default,,0,0,0,,Сол протездік денеде елес болуы мүмкін бе?
Dialogue: 0,0:39:15.24,0:39:16.58,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:39:16.58,0:39:17.66,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:39:18.62,0:39:22.46,Default,,0,0,0,,Целлулоидты қуыршаққа жанның кіруі мүмкін бе?
Dialogue: 0,0:39:22.46,0:39:27.13,Default,,0,0,0,,Ол қанша нейромедициналық құрылғылармен толтырылғанын айтпағанда.
Dialogue: 0,0:39:27.13,0:39:29.63,Default,,0,0,0,,Оның ішінде жанның тұруы ғажап емес.
Dialogue: 0,0:39:30.38,0:39:33.89,Default,,0,0,0,,Сонымен қатар, сіз жаңадан келген адамсыз, сондықтан білмеуіңіз мүмкін.
Dialogue: 0,0:39:34.64,0:39:37.89,Default,,0,0,0,,Майордың протездік денесін де Mega Tech Body жасайды.
Dialogue: 0,0:39:38.31,0:39:39.60,Default,,0,0,0,,Майор ғана емес,
Dialogue: 0,0:39:39.60,0:39:43.31,Default,,0,0,0,,Менің және Ишикаваның денелерінің бөліктері, сонымен қатар Сайто және т.б.
Dialogue: 0,0:39:43.31,0:39:45.15,Default,,0,0,0,,Техникалық қызмет көрсету және басқа заттар,
Dialogue: 0,0:39:45.15,0:39:50.28,Default,,0,0,0,,Сіз және директордан басқа 9-бөлімде барлығы дерлік сізге қарыздар.
Dialogue: 0,0:39:51.07,0:39:55.91,Default,,0,0,0,,Түсінесің бе, неліктен бәріміздің жүзіміз бұлыңғыр? Тоғуса мырза.
Dialogue: 0,0:39:55.91,0:40:00.83,Default,,0,0,0,,Осыны болжайтын болсақ, мен жау протездік дененің ішінде немесе сыртында екенін білмеймін,
Dialogue: 0,0:40:00.83,0:40:05.00,Default,,0,0,0,,Ол өте құпия тосқауылдан жасырын өтіп, протездік дене құрастырды.
Dialogue: 0,0:40:05.00,0:40:07.67,Default,,0,0,0,,Елес сызығы бар бағдарлама жіберілді.
Dialogue: 0,0:40:07.67,0:40:10.34,Default,,0,0,0,,Бұл да сізді тез ұстайтындай.
Dialogue: 0,0:40:10.34,0:40:11.93,Default,,0,0,0,,Сен кімсің?
Dialogue: 0,0:40:11.93,0:40:13.97,Default,,0,0,0,,Ұрлық желісін ұмытыңыз.
Dialogue: 0,0:40:13.97,0:40:18.27,Default,,0,0,0,,Тогуса, сайтты тексеріп, Мегатехті тазалайтын Ишикавамен кездесіңіз.
Dialogue: 0,0:40:18.27,0:40:19.35,Default,,0,0,0,,Бату,
Dialogue: 0,0:40:19.35,0:40:23.48,Default,,0,0,0,,Менде Megatech өшірілгендей құпиялар класын өңдейтін желі болды.
Dialogue: 0,0:40:23.48,0:40:26.40,Default,,0,0,0,,Тосқауылдың жұмыс істеп тұрғанын екі рет тексеріңіз.
Dialogue: 0,0:40:26.98,0:40:29.40,Default,,0,0,0,,Мен қабырғаға лабиринт саламын.
Dialogue: 0,0:40:29.40,0:40:31.03,Default,,0,0,0,,Мен ертең оған сүңгуге тырысамын.
Dialogue: 0,0:40:31.03,0:40:32.40,Default,,0,0,0,,Бұл қауіпті емес пе?
Dialogue: 0,0:40:32.40,0:40:34.41,Default,,0,0,0,,Протездік денені өзгерту және қолды жүзу
Dialogue: 0,0:40:35.16,0:40:40.41,Default,,0,0,0,,Маған бұл протездік дененің ішінде не бар екенін білуім керек.
Dialogue: 0,0:40:40.41,0:40:43.29,Default,,0,0,0,,Мен сүңгігенше ешкімнің суға түсуіне жол берме!
Dialogue: 0,0:40:47.04,0:40:48.46,Default,,0,0,0,,Ол жігітке не болды?
Dialogue: 0,0:40:48.46,0:40:51.16,Default,,0,0,0,,Қуыршақ оқиғасынан бері қызық болды.
Dialogue: 0,0:40:51.16,0:40:53.52,Default,,0,0,0,,Мен оны кешенді бағалау есебіне жазуым керек еді!
Dialogue: 0,0:40:54.30,0:40:55.80,Default,,0,0,0,,Сіз оны оқымадыңыз ба?
Dialogue: 0,0:40:56.68,0:40:57.64,Default,,0,0,0,,Директор,
Dialogue: 0,0:40:57.64,0:41:01.81,Default,,0,0,0,,Сіз миыңызды шатастырып жатқан кибердәрігердің тұлғасына күмәнданған кезіңіз болды ма?
Dialogue: 0,0:41:01.81,0:41:06.52,Default,,0,0,0,,Компьютерлік дәрігерлер мерзімді психиатриялық тексеруден өтуі керек,
Dialogue: 0,0:41:06.52,0:41:09.73,Default,,0,0,0,,Қоғамдық қауіпсіздікке байланысты дәрігерлер де фондық тексерулер жүргізеді, бірақ
Dialogue: 0,0:41:09.73,0:41:13.57,Default,,0,0,0,,Оны жүзеге асыратын да сол адамдар.
Dialogue: 0,0:41:13.57,0:41:16.41,Default,,0,0,0,,Күмән болса, оның шегі жоқ, солай ма?
Dialogue: 0,0:41:16.41,0:41:17.24,Default,,0,0,0,,Директор,
Dialogue: 0,0:41:17.24,0:41:20.80,Default,,0,0,0,,Накамура мырза, Сыртқы істер министрлігінің Шарт бойынша министрі кездесуді сұрайды.
Dialogue: 0,0:41:20.80,0:41:22.83,Default,,0,0,0,,N, жарайды, өтсін.
Dialogue: 0,0:41:33.76,0:41:35.97,Default,,0,0,0,,Сол семіз жігітке сенемін.
Dialogue: 0,0:41:35.97,0:41:40.76,Default,,0,0,0,,Сыртқы істер министрлігі Келісімшарттарды талқылау департаментінің директоры Накамура, 6-Қоғамдық қауіпсіздік бөлімі ретінде де белгілі.
Dialogue: 0,0:41:40.76,0:41:42.68,Default,,0,0,0,,Ұзын бойлы ақ адамдарға көрінбейтін бет.
Dialogue: 0,0:41:45.98,0:41:47.35,Default,,0,0,0,,Ал, кеттік.
Dialogue: 0,0:41:47.98,0:41:50.48,Default,,0,0,0,,Исикаваға өзін қатты итермеуді айт.
Dialogue: 0,0:41:58.87,0:42:00.78,Default,,0,0,0,,Сіз не ойлайсыз?
Dialogue: 0,0:42:00.78,0:42:03.20,Default,,0,0,0,,Әлгі протездік дене маған ұқсамады ма?
Dialogue: 0,0:42:03.20,0:42:04.25,Default,,0,0,0,,Олар бір-біріне ұқсамайды.
Dialogue: 0,0:42:04.25,0:42:06.04,Default,,0,0,0,,Тек бет пен қаңқа емес.
Dialogue: 0,0:42:06.04,0:42:07.58,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:42:07.58,0:42:12.09,Default,,0,0,0,,Мен сияқты кез келген протездік киборг осылай ойлайды.
Dialogue: 0,0:42:13.42,0:42:16.47,Default,,0,0,0,,Мүмкін мен баяғыда өлген шығармын,
Dialogue: 0,0:42:16.47,0:42:20.80,Default,,0,0,0,,Менің қазіргі мен компьютер мен протездік денеден тұратын симуляциялық тұлға ма деп ойлаймын.
Dialogue: 0,0:42:20.80,0:42:25.14,Default,,0,0,0,,Жоқ, менің ойымша, мен ешқашан болған емеспін.
Dialogue: 0,0:42:25.14,0:42:28.56,Default,,0,0,0,,Сіздің титан бас сүйегіңізде де ми бар,
Dialogue: 0,0:42:28.56,0:42:31.32,Default,,0,0,0,,Оларға адам сияқты қарайды, солай ма?
Dialogue: 0,0:42:31.32,0:42:34.44,Default,,0,0,0,,Өз миына қараған адамды ешкім емдемейді.
Dialogue: 0,0:42:34.44,0:42:38.91,Default,,0,0,0,,Өйткені, мен айналамдағы жағдайларға байланысты маған ұқсайтын нәрселер бар деп бағалап отырмын.
Dialogue: 0,0:42:38.91,0:42:41.74,Default,,0,0,0,,Өз елесіңізге сене алмайсыз ба?
Dialogue: 0,0:42:41.74,0:42:44.50,Default,,0,0,0,,Егер кибернетикалық дүниенің өзі елестер туғызса
Dialogue: 0,0:42:44.50,0:42:46.79,Default,,0,0,0,,Жан болсаң,
Dialogue: 0,0:42:46.79,0:42:50.46,Default,,0,0,0,,Сол кезде өзіңізге қандай негізде сену керек?
Dialogue: 0,0:42:57.30,0:42:58.35,Default,,0,0,0,,Шинигаминің көру қабілетін сыйға тарта алады.
Dialogue: 0,0:43:02.14,0:43:06.39,Default,,0,0,0,,Мен оны тексеремін. Бұл протездік дененің ішінде не бар?
Dialogue: 0,0:43:06.39,0:43:08.14,Default,,0,0,0,,Өз елесіңізбен.
Dialogue: 0,0:43:09.02,0:43:10.85,Default,,0,0,0,,Екеуміз де бос емеспіз.
Dialogue: 0,0:43:10.85,0:43:12.15,Default,,0,0,0,,Қысқаша айтайық.
Dialogue: 0,0:43:12.15,0:43:14.32,Default,,0,0,0,,Мен солай болғанын қалаймын.
Dialogue: 0,0:43:14.32,0:43:16.69,Default,,0,0,0,,Мен протездік дененің ішіндегісін алуға келдім.
Dialogue: 0,0:43:16.69,0:43:19.91,Default,,0,0,0,,Өз кезегінде сіз, 9-бөлім, бұл мәселеден босатыласыз.
Dialogue: 0,0:43:20.86,0:43:22.91,Default,,0,0,0,,Сыртқы істер министрі қол қойды.
Dialogue: 0,0:43:34.55,0:43:35.42,Default,,0,0,0,,Қауіпсіздік бөлімі;
Dialogue: 0,0:43:35.42,0:43:38.47,Default,,0,0,0,,Жерасты тұрағынан тыс жерде жүретін қоғамдық көліктер туралы не деуге болады?
Dialogue: 0,0:43:38.47,0:43:43.55,Default,,0,0,0,,Шарт кеңесінің директоры Накамура және оның серігі доктор Уиллис ретінде тіркелген.
Dialogue: 0,0:43:44.18,0:43:46.31,Default,,0,0,0,,Маған мұражайға кіргеніңіздің видеосын жіберіңізші.
Dialogue: 0,0:43:55.48,0:43:56.15,Default,,0,0,0,,Тағы да.
Dialogue: 0,0:43:56.15,0:43:57.15,Default,,0,0,0,,Инфрақызыл сәуледе.
Dialogue: 0,0:44:10.91,0:44:14.00,Default,,0,0,0,,1, 2, 3
Dialogue: 0,0:44:16.55,0:44:19.26,Default,,0,0,0,,Маған жерасты автотұрақ аймағындағы қысым датчигінің жазбасын беріңіз.
Dialogue: 0,0:44:19.26,0:44:22.01,Default,,0,0,0,,B 7 және 8.
Dialogue: 0,0:44:40.99,0:44:41.90,Default,,0,0,0,,майор,
Dialogue: 0,0:44:41.90,0:44:42.99,Default,,0,0,0,,Бұл Тоғуса.
Dialogue: 0,0:44:42.99,0:44:44.32,Default,,0,0,0,,Код 09.
Dialogue: 0,0:44:44.32,0:44:45.32,Default,,0,0,0,,Не болды?
Dialogue: 0,0:44:45.32,0:44:48.62,Default,,0,0,0,,Бас Накамураның денесі тапсырыс бойынша жасалған протездік дене ме?
Dialogue: 0,0:44:48.62,0:44:50.79,Default,,0,0,0,,6-бөлімде киборгтар жоқ.
Dialogue: 0,0:44:50.79,0:44:52.71,Default,,0,0,0,,Шетелде жұмыс істеу ыңғайлылығына байланысты,
Dialogue: 0,0:44:52.71,0:44:55.33,Default,,0,0,0,,Басқа елдің қамқорлығы мен сезімін ескеріңіз.
Dialogue: 0,0:44:55.33,0:44:58.50,Default,,0,0,0,,Егер бұл ұзын ақ адам киборг болса да,
Dialogue: 0,0:44:58.50,0:45:01.80,Default,,0,0,0,,Екі адамның салмағы 500 кг-нан асуы мүмкін емес.
Dialogue: 0,0:45:01.80,0:45:03.30,Default,,0,0,0,,Қысымға сезімтал жазу.
Dialogue: 0,0:45:03.30,0:45:04.34,Default,,0,0,0,,Автотұрақ?
Dialogue: 0,0:45:04.34,0:45:05.93,Default,,0,0,0,,Екі қымбат көлік,
Dialogue: 0,0:45:05.93,0:45:09.06,Default,,0,0,0,,Ешқайсысы да көлік жүргізетін типке ұқсамайтын.
Dialogue: 0,0:45:09.06,0:45:11.48,Default,,0,0,0,,Бақылау камерасының түсірілімінде екі адам ғана көрінеді, бірақ
Dialogue: 0,0:45:11.48,0:45:13.98,Default,,0,0,0,,Кіретін есік өте сезімтал болды, солай емес пе?
Dialogue: 0,0:45:14.39,0:45:16.65,Default,,0,0,0,,Жабуға шамамен 3 секунд кетеді.
Dialogue: 0,0:45:17.19,0:45:22.03,Default,,0,0,0,,Мемлекеттік мекемелердің ішінде термооптикалық камуфляжды пайдалану заңсыз болғанына сенімдімін, солай ма?
Dialogue: 0,0:45:22.03,0:45:24.91,Default,,0,0,0,,Мемлекеттік құпиялар туралы заңды бұзу ауыр қылмыс болып табылады.
Dialogue: 0,0:45:24.91,0:45:27.91,Default,,0,0,0,,6-бөлімде қорқынышты нәрсе туралы ойланады.
Dialogue: 0,0:45:27.91,0:45:29.28,Default,,0,0,0,,Дайынсың ба?
Dialogue: 0,0:45:29.70,0:45:31.25,Default,,0,0,0,,Матеба жақсы болса.
Dialogue: 0,0:46:08.87,0:46:10.78,Default,,0,0,0,,Айтудың қажеті жоқ,
Dialogue: 0,0:46:10.78,0:46:16.16,Default,,0,0,0,,Егер арамыздағы құпияны ашпасаңыз, сізге опасыздық жасады деген айып тағылады.
Dialogue: 0,0:46:16.16,0:46:17.54,Default,,0,0,0,,Бір-біріне.
Dialogue: 0,0:46:17.54,0:46:21.84,Default,,0,0,0,,Сыртқы істер министрлігінің ниетіне қарамастан, бұл 9-бөлімге жауапты болуы керек іс.
Dialogue: 0,0:46:21.84,0:46:26.93,Default,,0,0,0,,Дегенмен, дәлелді себеп болса, мен ынтымақтасудан тартынбас едім.
Dialogue: 0,0:46:28.18,0:46:29.47,Default,,0,0,0,,Доктор Уиллис!
Dialogue: 0,0:46:29.47,0:46:30.97,Default,,0,0,0,,Расталды.
Dialogue: 0,0:46:30.97,0:46:32.76,Default,,0,0,0,,Бұл сөзсіз ол.
Dialogue: 0,0:46:32.76,0:46:34.02,Default,,0,0,0,,Ол ма?
Dialogue: 0,0:46:34.68,0:46:39.19,Default,,0,0,0,,Бұл протездік дененің ішінде бар бастапқы елес тосқауыл.
Dialogue: 0,0:46:39.19,0:46:41.61,Default,,0,0,0,,Дегенмен, жынысы әлі белгісіз,
Dialogue: 0,0:46:41.61,0:46:45.32,Default,,0,0,0,,Ол дәрігердің оған қойған лақап аты ғана.
Dialogue: 0,0:46:45.32,0:46:47.36,Default,,0,0,0,,Оны тағы да таныстырып өтейін.
Dialogue: 0,0:46:47.36,0:46:51.58,Default,,0,0,0,,Бұл киберқылмыс тарихындағы ең бірегей хакер.
Dialogue: 0,0:46:51.58,0:46:53.24,Default,,0,0,0,,Қуыршақ ойнаушы.
Dialogue: 0,0:46:55.79,0:47:01.17,Default,,0,0,0,,Сіздің 9-шы бөлімшеңіз оны Сыртқы істер министрлігі аудармашысының елес бұзу оқиғасы кезінде кездестірген болуы керек.
Dialogue: 0,0:47:02.99,0:47:08.84,Default,,0,0,0,,Біз, 6-бөлім, қуыршақ ойнаушылар пайда болғаннан бері оларды үлкен қызығушылықпен бақылаймыз.
Dialogue: 0,0:47:08.84,0:47:12.01,Default,,0,0,0,,Доктор Уиллистің айналасында жоба тобын құрыңыз
Dialogue: 0,0:47:12.01,0:47:15.06,Default,,0,0,0,,Қуыршақ ойыншылары туралы барлық деректерді талдаңыз,
Dialogue: 0,0:47:15.06,0:47:18.56,Default,,0,0,0,,Қылмыстағы тенденциялар мен мінез-құлық үлгілері анықталды.
Dialogue: 0,0:47:19.02,0:47:22.94,Default,,0,0,0,,Ал қуыршақ ойыншысы үшін арнайы шабуыл тосқауылын тұрғызыңыз.
Dialogue: 0,0:47:22.94,0:47:26.65,Default,,0,0,0,,Оны қандай да бір құпия денеге кіргізді.
Dialogue: 0,0:47:26.65,0:47:32.41,Default,,0,0,0,,Сіз қуыршақ кибернетикалық протездік денеге сүңгіп, сол уақыт ішінде негізгі денеге қастандық жасады ма?
Dialogue: 0,0:47:32.41,0:47:34.37,Default,,0,0,0,,Бұл орын.
Dialogue: 0,0:47:34.87,0:47:37.29,Default,,0,0,0,,Мен сіздің бақшаңызға кездейсоқ келдім,
Dialogue: 0,0:47:37.29,0:47:40.92,Default,,0,0,0,,Ол Америка Құрама Штаттарында дүниеге келген және Америка Құрама Штаттарының ынтымақтастығымен тұтқынға алынған.
Dialogue: 0,0:47:40.92,0:47:43.04,Default,,0,0,0,,Біз оны өзіміз жинағымыз келеді.
Dialogue: 0,0:47:43.04,0:47:44.59,Default,,0,0,0,,Қарсылығыңыз бар ма?
Dialogue: 0,0:47:44.59,0:47:48.83,Default,,0,0,0,,Оның денесі ешкім білмей бір жерден табыла ма?
Dialogue: 0,0:47:51.55,0:47:53.47,Default,,0,0,0,,Мәйіттер жоқ.
Dialogue: 0,0:47:53.47,0:47:57.85,Default,,0,0,0,,Себебі, осы уақытқа дейін дене болмаған.
Dialogue: 0,0:47:57.85,0:47:59.52,Default,,0,0,0,,Датчик жұмыс істеді ме?
Dialogue: 0,0:47:59.52,0:48:01.10,Default,,0,0,0,,Неге бірінші айтпадың!
Dialogue: 0,0:48:01.65,0:48:03.73,Default,,0,0,0,,Сыртқы басқару өшірілген!
Dialogue: 0,0:48:03.73,0:48:05.48,Default,,0,0,0,,Бұл протездік дененің автономды шығуы.
Dialogue: 0,0:48:05.48,0:48:07.69,Default,,0,0,0,,Протездік денеге кім кірді
Dialogue: 0,0:48:07.69,0:48:11.36,Default,,0,0,0,,6-бөлімдегі шабуылдаушы қабырғаға қарсы тұра алмағандықтан,
Dialogue: 0,0:48:11.36,0:48:13.03,Default,,0,0,0,,Біздің мұнда не істеп жатырмыз
Dialogue: 0,0:48:13.03,0:48:14.99,Default,,0,0,0,,Бұл менің өз еркім.
Dialogue: 0,0:48:15.53,0:48:17.37,Default,,0,0,0,,Тірі зат ретінде
Dialogue: 0,0:48:17.37,0:48:19.45,Default,,0,0,0,,Саяси баспана сұрау.
Dialogue: 0,0:48:19.45,0:48:21.04,Default,,0,0,0,,Бұл тірі зат па?
Dialogue: 0,0:48:21.04,0:48:22.00,Default,,0,0,0,,Ақымақ,
Dialogue: 0,0:48:22.00,0:48:24.21,Default,,0,0,0,,Бұл жай ғана өзін-өзі сақтау бағдарламасы!
Dialogue: 0,0:48:24.75,0:48:28.67,Default,,0,0,0,,Олай десеңіз, сіздің ДНҚ да
Dialogue: 0,0:48:28.67,0:48:31.43,Default,,0,0,0,,Бұл жай ғана өзін-өзі сақтауға арналған бағдарлама.
Dialogue: 0,0:48:32.05,0:48:33.34,Default,,0,0,0,,Өмір дегеніміз не?
Dialogue: 0,0:48:33.34,0:48:37.51,Default,,0,0,0,,Бұл ақпарат ағынында құрылған түйін сияқты.
Dialogue: 0,0:48:37.93,0:48:39.89,Default,,0,0,0,,Тіршілік түр ретінде
Dialogue: 0,0:48:39.89,0:48:42.52,Default,,0,0,0,,Ген деп аталатын есте сақтау жүйесі бар,
Dialogue: 0,0:48:42.52,0:48:45.52,Default,,0,0,0,,Адам тек есте сақтау арқылы ғана жеке тұлға бола алады.
Dialogue: 0,0:48:45.94,0:48:52.24,Default,,0,0,0,,Жад иллюзияның синонимі болса да, адамдар есте сақтау арқылы өмір сүреді.
Dialogue: 0,0:48:52.74,0:48:56.99,Default,,0,0,0,,Компьютерлердің таралуы жадты сыртқа шығаруға мүмкіндік бергенде,
Dialogue: 0,0:48:56.99,0:49:01.75,Default,,0,0,0,,Оның мағынасы туралы тереңірек ойлану керек еді.
Dialogue: 0,0:49:01.75,0:49:02.87,Default,,0,0,0,,Бұл софистика!
Dialogue: 0,0:49:02.87,0:49:06.75,Default,,0,0,0,,Не десең де, тірі жан екеніңді айғақтайтын ешбір дәлел жоқ!
Dialogue: 0,0:49:07.17,0:49:10.42,Default,,0,0,0,,Мұны дәлелдеу мүмкін емес.
Dialogue: 0,0:49:10.42,0:49:15.76,Default,,0,0,0,,Қазіргі ғылым әлі күнге дейін өмірді анықтай алмайды.
Dialogue: 0,0:49:15.76,0:49:18.31,Default,,0,0,0,,Сен кімсің?
Dialogue: 0,0:49:18.31,0:49:22.77,Default,,0,0,0,,Сенде елес болса да, қылмыскерлерде еркіндік жоқ!
Dialogue: 0,0:49:22.77,0:49:25.06,Default,,0,0,0,,Сіз дұрыс емес баспанаға бардыңыз!
Dialogue: 0,0:49:25.06,0:49:27.86,Default,,0,0,0,,Уақыт әрқашан мен жағында.
Dialogue: 0,0:49:28.40,0:49:31.15,Default,,0,0,0,,Енді менде өлім мүмкіндігі бар,
Dialogue: 0,0:49:31.15,0:49:33.36,Default,,0,0,0,,Өйткені бұл елде өлім жазасы жоқ.
Dialogue: 0,0:49:33.36,0:49:34.53,Default,,0,0,0,,Жартылай өлмейтіндік
Dialogue: 0,0:49:34.53,0:49:36.45,Default,,0,0,0,,Жасанды интеллект?
Dialogue: 0,0:49:36.45,0:49:37.99,Default,,0,0,0,,AI емес.
Dialogue: 0,0:49:38.74,0:49:43.25,Default,,0,0,0,,Менің кодым 2501 жобада
Dialogue: 0,0:49:44.87,0:49:49.79,Default,,0,0,0,,Мен ақпарат мұхитында пайда болған тіршілік формасымын.
Dialogue: 0,0:49:59.72,0:50:00.47,Default,,0,0,0,,Қауіпсіздік бөлімі;
Dialogue: 0,0:50:00.47,0:50:01.43,Default,,0,0,0,,Зиянкес!
Dialogue: 0,0:50:05.27,0:50:05.94,Default,,0,0,0,,Директор,
Dialogue: 0,0:50:05.94,0:50:07.02,Default,,0,0,0,,Қуыршақ ойнаушы!
Dialogue: 0,0:50:08.19,0:50:10.61,Default-Alt,,0,0,0,,Қауіпсіздік бөлімі, қалқа жабылды!
Dialogue: 0,0:50:11.73,0:50:13.53,Default,,0,0,0,,Қауіпсіздік бөлімі, не болды? ?
Dialogue: 0,0:50:37.23,0:50:38.80,Default,,0,0,0,,Сіз тітіркендіргіш бейбақ!
Dialogue: 0,0:50:43.22,0:50:44.39,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:50:49.90,0:50:50.81,Default,,0,0,0,,Тиіп көр!
Dialogue: 0,0:50:51.23,0:50:52.82,Default,,0,0,0,,Бұл мықты көлік.
Dialogue: 0,0:50:52.82,0:50:54.32,Default,,0,0,0,,9мм тіпті оны сызып тастамайды.
Dialogue: 0,0:50:54.78,0:50:57.20,Default,,0,0,0,,Матебаға сенбе.
Dialogue: 0,0:51:00.91,0:51:02.74,Default,,0,0,0,,Жарайды, жаңадан келген адам болған жақсы.
Dialogue: 0,0:51:02.74,0:51:04.29,Default,,0,0,0,,Нөмірге бір рет ату.
Dialogue: 0,0:51:04.29,0:51:05.54,Default,,0,0,0,,Жақсы қол, солай ма?
Dialogue: 0,0:51:05.54,0:51:07.29,Default,,0,0,0,,Келесі жолы екі рет атыңыз.
Dialogue: 0,0:51:07.29,0:51:08.08,Default,,0,0,0,,бастайық,
Dialogue: 0,0:51:08.08,0:51:10.25,Default,,0,0,0,,Олар көлік ауыстырмас бұрын оларды қуып жетіңіз.
Dialogue: 0,0:51:14.50,0:51:18.51,Default,,0,0,0,,Мен бұл мәселеге Сыртқы істер министрлігі арқылы ресми түрде наразылық білдіремін!
Dialogue: 0,0:51:18.97,0:51:21.55,Default,,0,0,0,,Оны тауып, маған хабарлаңыз!
Dialogue: 0,0:51:21.55,0:51:23.26,Default,,0,0,0,,Әлі тірі, әрине.
Dialogue: 0,0:51:23.26,0:51:26.27,Default,,0,0,0,,Егер бұл жай ғана дене болса, Megatech қалағаныңызша жасай алады.
Dialogue: 0,0:51:29.98,0:51:33.61,Default,,0,0,0,,Қуыршақты ұрлап кеткендер – Бату мен Тоғуса.
Dialogue: 0,0:51:35.15,0:51:37.53,Default,,0,0,0,,Мен жаңа ғана 25 тас жолға түстім.
Dialogue: 0,0:51:37.53,0:51:38.61,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:51:38.61,0:51:40.57,Default,,0,0,0,,Егер ол бақыланатын болса, неге?
Dialogue: 0,0:51:40.57,0:51:44.49,Default,,0,0,0,,Егер біз оны осында ұстасақ, 6-бөліммен байланысын дәлелдей алмауымыз мүмкін.
Dialogue: 0,0:51:44.49,0:51:45.24,Default,,0,0,0,,6-бөлім?
Dialogue: 0,0:51:45.66,0:51:46.70,Default,,0,0,0,,Сөз жоқ.
Dialogue: 0,0:51:46.70,0:51:49.50,Default,,0,0,0,,2902 оптикалық камуфляж менікі сияқты
Dialogue: 0,0:51:49.50,0:51:51.71,Default,,0,0,0,,Біз және Рейнджердің 4-бөлімі оны қолданамыз.
Dialogue: 0,0:51:51.71,0:51:53.21,Default,,0,0,0,,Және тек 6 сабақ.
Dialogue: 0,0:51:54.67,0:51:57.17,Default,,0,0,0,,6-бөлім қуыршақты мәйітке апарды.
Dialogue: 0,0:51:57.17,0:52:02.47,Default,,0,0,0,,Қандай да бір себептермен қуыршақ қашу үшін 9-бөліммен терең байланысы бар Mega Tech Body компаниясын таңдады.
Dialogue: 0,0:52:02.47,0:52:04.89,Default,,0,0,0,,Және ол өзін тірі жан деп мәлімдейді.
Dialogue: 0,0:52:04.89,0:52:08.18,Default,,0,0,0,,Баспана сұрағанымда, олар мені кір қолмен алып кетті.
Dialogue: 0,0:52:08.18,0:52:10.23,Default,,0,0,0,,Бірақ неге олай істеу керек?
Dialogue: 0,0:52:10.23,0:52:12.44,Default,,0,0,0,,Мен жазбаларды алған соң тапсырар едім.
Dialogue: 0,0:52:12.44,0:52:15.44,Default,,0,0,0,,Оның аузынан бірдеңе шығып кетуі мүмкін деп қорықсаң ше?
Dialogue: 0,0:52:15.44,0:52:17.82,Default,,0,0,0,,Ойланып қарасам, біртүрлі айттыңыз.
Dialogue: 0,0:52:17.82,0:52:20.45,Default,,0,0,0,,Код атауы, 2501 жобасы
Dialogue: 0,0:52:20.95,0:52:22.57,Default,,0,0,0,,Мен бұл жолды сізге қалдырамын.
Dialogue: 0,0:52:22.57,0:52:26.74,Default,,0,0,0,,9-бөлім Шабуылдаушыны ұстаңыз және маңызды дәлелдемелерді алыңыз
Dialogue: 0,0:52:26.74,0:52:27.45,Default,,0,0,0,,Рұқсат ету.
Dialogue: 0,0:52:27.87,0:52:28.87,Default,,0,0,0,,Жарайды, жүр!
Dialogue: 0,0:52:35.29,0:52:36.20,Default,,0,0,0,,Құсанағы,
Dialogue: 0,0:52:36.20,0:52:37.67,Default,,0,0,0,,Мен сізге бір нәрсені айтайын.
Dialogue: 0,0:52:37.67,0:52:40.73,Default,,0,0,0,,Егер жалғыз қашу туралы болса, мен қайтып оралғанда қандай жаза болса да аламын.
Dialogue: 0,0:52:41.16,0:52:44.76,Default,,0,0,0,,Бұл қуыршақ, бірақ оны қайтара алмасаң, құрт.
Dialogue: 0,0:52:44.76,0:52:45.93,Default,,0,0,0,,Сөзсіз
Dialogue: 0,0:52:47.76,0:52:48.85,Default,,0,0,0,,Не болды?
Dialogue: 0,0:52:49.60,0:52:50.43,Default,,0,0,0,,Түсінікті.
Dialogue: 0,0:52:52.73,0:52:56.73,Default,,0,0,0,,Сыртқы істер министрлігі қызметкерінің немесе американдық дипломаттың рейсін сұрау үшін әуежайға хабарласыңыз.
Dialogue: 0,0:52:56.73,0:52:58.69,Default,,0,0,0,,Барлық рейстерді тоқтатыңыз.
Dialogue: 0,0:52:58.69,0:53:00.36,Default,,0,0,0,,Жол тосқауылдары мен бақылау бекеттері.
Dialogue: 0,0:53:00.36,0:53:02.24,Default,,0,0,0,,Жұмыстан тыс қызметкерлерді шұғыл шақыру,
Dialogue: 0,0:53:02.24,0:53:03.78,Default,,0,0,0,,Ишикаваны да қайтарыңыз.
Dialogue: 0,0:53:04.28,0:53:08.49,Default,,0,0,0,,Қабылдау жазбасынан ақ нәсілді Накамураның жеке басын жуыңыз.
Dialogue: 0,0:53:08.49,0:53:12.50,Default,,0,0,0,,Сондай-ақ, Сыртқы істер министрлігіне қатысты кез келген жоспарлар немесе операциялар.
Dialogue: 0,0:53:12.50,0:53:15.50,Default,,0,0,0,,Project 2501 деп аталатын нәрсені іздеңіз.
Dialogue: 0,0:53:21.09,0:53:23.38,Default,,0,0,0,,Сіз шабуылдаушыдан естідіңіз бе?
Dialogue: 0,0:53:23.38,0:53:25.55,Default,,0,0,0,,Мен бір минут бұрын көлік ауыстырдым.
Dialogue: 0,0:53:25.55,0:53:27.72,Default,,0,0,0,,Манекенмен жанасу 5 минуттан кейін.
Dialogue: 0,0:53:27.72,0:53:29.76,Default,,0,0,0,,Оларды мұқият орындағаныңызға көз жеткізіңіз.
Dialogue: 0,0:53:29.76,0:53:30.47,Default,,0,0,0,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:53:31.47,0:53:33.56,Default,,0,0,0,,Қалай болғанда да, қуыршақ,
Dialogue: 0,0:53:33.56,0:53:36.86,Default,,0,0,0,,Неліктен сіз 9-бөлім сияқты нәрсеге қашып кеттіңіз?
Dialogue: 0,0:53:36.86,0:53:38.48,Default,,0,0,0,,Бұл оның ісі,
Dialogue: 0,0:53:38.48,0:53:41.90,Default,,0,0,0,,Біз елестете алмайтын себептер болуы мүмкін.
Dialogue: 0,0:53:42.94,0:53:46.36,Default,,0,0,0,,Мүмкін оның жауапсыз махаббаты болған шығар.
Dialogue: 0,0:53:46.36,0:53:47.95,Default,,0,0,0,,Қандай ақымақ
Dialogue: 0,0:55:26.52,0:55:27.42,Default,,0,0,0,,Директор.
Dialogue: 0,0:55:27.84,0:55:29.26,Default,,0,0,0,,Ишикава?
Dialogue: 0,0:55:29.26,0:55:30.18,Default,,0,0,0,,Не болды?
Dialogue: 0,0:55:30.18,0:55:33.05,Default,,0,0,0,,Мен Сыртқы істер министрлігінің интернетінде болдым.
Dialogue: 0,0:55:33.05,0:55:35.43,Default,,0,0,0,,Көптеген қызықты нәрселер шықты.
Dialogue: 0,0:55:35.43,0:55:37.64,Default,,0,0,0,,Күте тұрыңыз, жасырын схемаға ауысыңыз.
Dialogue: 0,0:55:37.64,0:55:38.56,Default,,0,0,0,,Сізге ұнады ма?
Dialogue: 0,0:55:38.56,0:55:41.69,Default,,0,0,0,,Біріншіден, директор Накамурамен бірге келген ақ адамдар.
Dialogue: 0,0:55:41.69,0:55:43.48,Default,,0,0,0,,Ұлты американдық.
Dialogue: 0,0:55:43.48,0:55:46.36,Default,,0,0,0,,Доктор Уиллис, Нейтрондағы стратегиялық зерттеулер директоры.
Dialogue: 0,0:55:46.36,0:55:48.70,Default,,0,0,0,,Ол AI зерттеулерінің жетекші сарапшысы.
Dialogue: 0,0:55:48.70,0:55:52.70,Default,,0,0,0,,Сыртқы істер министрлігіне осы қария жетекшілік ететін жоба бар еді.
Dialogue: 0,0:55:52.70,0:55:55.91,Default,,0,0,0,,Сіздің ойыңызша бұл топтағы негізгі бағдарламашы кім?
Dialogue: 0,0:55:55.91,0:55:57.00,Default,,0,0,0,,Қысқаша болыңыз.
Dialogue: 0,0:55:57.00,0:55:59.16,Default,,0,0,0,,Мизухо Тайда, 28 жаста.
Dialogue: 0,0:55:59.16,0:56:00.37,Default,,0,0,0,,Есіңде ме?
Dialogue: 0,0:56:00.37,0:56:03.79,Default,,0,0,0,,Бір күні мен 6-бөлімге ашуланып, олардың бұзылуларына жол бермеуге тырысамын.
Dialogue: 0,0:56:03.79,0:56:08.63,Default,,0,0,0,,Майор басқа тараптың дипломатын өшірген оқиға Ол сол кезде бағдарламашы болды.
Dialogue: 0,0:56:08.63,0:56:09.72,Default,,0,0,0,,Жалғастыру.
Dialogue: 0,0:56:09.72,0:56:12.93,Default,,0,0,0,,Мені қызықтыратын нәрсе - бұл жоба қашан басталды.
Dialogue: 0,0:56:12.93,0:56:16.39,Default,,0,0,0,,Бұл қуыршақтардың пайда болуынан бір жыл бұрын болды.
Dialogue: 0,0:56:16.39,0:56:17.81,Default,,0,0,0,,1 жыл бұрын?
Dialogue: 0,0:56:17.81,0:56:21.10,Default,,0,0,0,,Бұл қуыршақты қолға түсіру жобасы емес пе еді?
Dialogue: 0,0:56:21.77,0:56:23.44,Default,,0,0,0,,Осындай нәрсе туралы не айтасыз?
Dialogue: 0,0:56:23.44,0:56:26.27,Default,,0,0,0,,Олар шынымен де қуыршақты қуып келді, бірақ
Dialogue: 0,0:56:26.27,0:56:30.74,Default,,0,0,0,,Егер бұл түсіру үшін емес, алу үшін болса ше?
Dialogue: 0,0:56:30.74,0:56:33.91,Default,,0,0,0,,Өткен күні Сыртқы істер министрлігінің аудармашысының елес бұзушылығына қарамастан,
Dialogue: 0,0:56:33.91,0:56:37.58,Default,,0,0,0,,Сыртқы істер министрлігі Маресті қайтару үшін сылтау іздеді, солай ма?
Dialogue: 0,0:56:38.04,0:56:40.75,Default,,0,0,0,,Бізді алдаған болуы мүмкін.
Dialogue: 0,0:56:40.75,0:56:47.09,Default,,0,0,0,,Қуыршақ ойнаушының шынайы тұлғасы дипломатиялық дөңгелектерді алға жылжыту үшін Сыртқы істер министрлігі жасаған бағдарлама.
Dialogue: 0,0:56:47.09,0:56:49.38,Default,,0,0,0,,Ол қандай да бір себептермен бақыланбайтын болды.
Dialogue: 0,0:56:49.38,0:56:52.47,Default,,0,0,0,,Егер сіз оны асығыс жинап алсаңыз ше?
Dialogue: 0,0:56:53.01,0:56:57.93,Default,,0,0,0,,Менің ойымша, олар оны 9-бөлімнен ұрлау үшін осындай күшті әдістерді қолданғаны таңқаларлық емес.
Dialogue: 0,0:56:58.43,0:57:01.73,Default,,0,0,0,,Бұл қуыршақтың аузынан ағып кеткен ғой.
Dialogue: 0,0:57:01.73,0:57:04.06,Default,,0,0,0,,Халықаралық проблемалар сөзсіз.
Dialogue: 0,0:57:04.06,0:57:06.77,Default,,0,0,0,,Сыртқы істер министрі басшысының ұшып кетуі жеткіліксіз.
Dialogue: 0,0:57:06.77,0:57:09.07,Default,,0,0,0,,Жобаның егжей-тегжейлері қандай?
Dialogue: 0,0:57:09.07,0:57:13.49,Default,,0,0,0,,Күткендей, тосқауыл қатты болды, мен тек файл атауын таптым.
Dialogue: 0,0:57:13.49,0:57:15.74,Default,,0,0,0,,2501 коды
Dialogue: 0,0:57:15.74,0:57:16.95,Default,,0,0,0,,Тергеуді жалғастырыңыз.
Dialogue: 0,0:57:16.95,0:57:18.70,Default,,0,0,0,,Ешқашан мақтанбаңыз.
Dialogue: 0,0:57:18.70,0:57:19.83,Default,,0,0,0,,Түсінікті.
Dialogue: 0,0:57:26.08,0:57:28.42,Default,,0,0,0,,2501 жобасы
Dialogue: 0,0:57:29.00,0:57:31.97,Default,,0,0,0,,Қуыршақ жобасы, иә?
Dialogue: 0,0:57:31.97,0:57:34.80,Default,,0,0,0,,Нысана басқа көлікке тиеді.
Dialogue: 0,0:57:35.30,0:57:35.93,Default,,0,0,0,,Бату!
Dialogue: 0,0:57:35.93,0:57:38.76,Default,,0,0,0,,Шығу аймағында тұрған ақ седанның соқтығысуы.
Dialogue: 0,0:57:39.22,0:57:41.72,Default,,0,0,0,,Артқы орындықтан бірдеңе аударылып жатқан сияқты.
Dialogue: 0,0:57:43.23,0:57:44.25,Default,,0,0,0,,Ол қозғала бастады.
Dialogue: 0,0:57:44.57,0:57:45.77,Default,,0,0,0,,Ақ седан да жүрді.
Dialogue: 0,0:57:46.19,0:57:46.88,Default,,0,0,0,,Бұл муляж ма?
Dialogue: 0,0:57:47.29,0:57:49.28,Default,,0,0,0,,Бәлкім, бұл жай ғана бұрмалау болып көрінетін шығар.
Dialogue: 0,0:57:49.82,0:57:50.73,Default,,0,0,0,,(Нацуо) Жоқ, «шектеу» дегеніміз – ақыр соңында адам өз-өзіне қоятын нәрсе.
Dialogue: 0,0:57:50.73,0:57:52.94,Default,,0,0,0,,Мен ақ седанды осында тіркеймін.
Dialogue: 0,0:57:52.94,0:57:55.11,Default,,0,0,0,,Сүйіктім деп айтудың негізі қандай?
Dialogue: 0,0:57:55.11,0:57:56.82,Default,,0,0,0,,Бұл аруақтың сыбыры ма?
Мен бұл
Dialogue: 0,0:57:56.82,0:57:58.28,Default,,0,0,0,,Мүмкін солай шығар.
Dialogue: 0,0:57:58.28,0:58:00.28,Default,,0,0,0,,деп ойладым.
Dialogue: 0,0:58:07.92,0:58:11.80,Default,,0,0,0,,02 мақсат, 25 тас жолдан түсіп, ескі қалаға қарай жүріңіз.
Dialogue: 0,0:58:16.76,0:58:19.76,Default,,0,0,0,,Қуғынға алынған көліктің артында 2 км жерде азаматтық көліктер болмауы керек.
Dialogue: 0,0:58:19.76,0:58:20.89,Default,,0,0,0,,Эвакуация аяқталды.
Dialogue: 0,0:58:20.89,0:58:22.81,Default,,0,0,0,,Мақсат туралы не деуге болады?
Dialogue: 0,0:58:22.81,0:58:23.47,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:58:23.47,0:58:24.52,Default,,0,0,0,,Кез келген уақытта OK.
Dialogue: 0,0:58:24.52,0:58:25.39,Default,,0,0,0,,Оны басып тұрыңыз.
Dialogue: 0,0:59:14.11,0:59:15.10,Default,,0,0,0,,Жеңіс пе?
Dialogue: 0,0:59:15.10,0:59:16.03,Default,,0,0,0,,Аспан.
Dialogue: 0,0:59:16.45,0:59:18.78,Default,,0,0,0,,Әй, әуре-сарсаң екен.
Dialogue: 0,0:59:18.78,0:59:20.99,Default,,0,0,0,,Осы уақытқа дейін ештеңе істей алмайсыз.
Dialogue: 0,0:59:21.74,0:59:22.49,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:59:22.49,0:59:24.12,Default,,0,0,0,,Мына жігіттерді алып кетіңіз.
Dialogue: 0,0:59:24.12,0:59:27.46,Default,,0,0,0,,Сондай-ақ, директорға хабарласыңыз және майордың резервтік көшірмесін сұраңыз.
Dialogue: 0,0:59:27.46,0:59:28.25,Default,,0,0,0,,Сонда кездескенше.
Dialogue: 0,0:59:34.81,0:59:38.55,Default,,0,0,0,,Қызық, мұндай дөрекі ханшайымның жолсерігі бар ма?
Dialogue: 0,0:59:52.65,0:59:57.36,Default,,0,0,0,,Ескі қаланың өзінде бұл аймақ қатты су астында қалып, қараусыз қалған.
Dialogue: 0,0:59:57.36,0:59:59.24,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:59:59.24,1:00:01.82,Default,,0,0,0,,Ешқандай ниетсіз қашып кету мүмкін емес.
Dialogue: 0,1:00:01.82,1:00:04.16,Default,,0,0,0,,Қайықпен немесе тікұшақпен теңізге бару,
Dialogue: 0,1:00:04.16,1:00:05.16,Default,,0,0,0,,Тұтқындау?
Dialogue: 0,1:00:05.16,1:00:07.41,Default,,0,0,0,,Күшейтуді күткен дұрыс емес пе?
Dialogue: 0,1:00:07.41,1:00:09.37,Default,,0,0,0,,Мен күте алмайтын жағдайлар бар.
Dialogue: 0,1:00:09.37,1:00:11.87,Default,,0,0,0,,Теңізден сол ғимараттың басына дейін.
Dialogue: 0,1:00:25.22,1:00:28.64,Default,,0,0,0,,Жанармай таусылғанша, біз осы жерде байланыстарды бақылап, өткіземіз.
Dialogue: 0,1:00:28.64,1:00:30.39,Default,,0,0,0,,Қауіпті болып көрінсе, қашып кет.
Dialogue: 0,1:01:06.18,1:01:08.18,Default,,0,0,0,,Жарық жарығын тастаңыз! Қазір!
Dialogue: 0,1:01:25.91,1:01:28.24,Default,,0,0,0,,Бұл танк, аспанға пана ал!
Dialogue: 0,1:01:28.24,1:01:29.37,Default,,0,0,0,,Эй, күте тұрыңыз.
Dialogue: 0,1:01:29.37,1:01:31.54,Default,,0,0,0,,Танкпен өз бетіңізше соғысасыз ба? ?
Dialogue: 0,1:01:31.54,1:01:34.75,Default,,0,0,0,,Енді мен оның қуыршақ екенін білемін, тіпті оны 9-бөлімге қайтарсам да,
Dialogue: 0,1:01:34.75,1:01:38.00,Default,,0,0,0,,Олар жай ғана зертханаға лақтырылып, менеджер үшін сауда чиптері ретінде пайдаланылады.
Dialogue: 0,1:01:38.00,1:01:39.80,Default,,0,0,0,,Енді сүңгудің жалғыз мүмкіндігі!
Dialogue: 0,1:01:39.80,1:01:40.42,Default,,0,0,0,,Эй!
Dialogue: 0,1:01:40.42,1:01:42.88,Default,,0,0,0,,Балалар, сендер не туралы айтып тұрсыңдар! ?
Dialogue: 0,1:01:43.59,1:01:44.72,Default,,0,0,0,,Жабдық туралы не деуге болады?
Dialogue: 0,1:01:44.72,1:01:46.47,Default,,0,0,0,,M23 және В блогы.
Dialogue: 0,1:01:46.47,1:01:48.39,Default,,0,0,0,,Осындай адаммен күресуге болады ма? ?
Dialogue: 0,1:01:48.89,1:01:49.81,Default,,0,0,0,,Кешіріңіз, бірақ
Dialogue: 0,1:01:49.81,1:01:51.47,Default,,0,0,0,,Мен біраз уақытқа байланысты үземін.
Dialogue: 0,1:01:51.47,1:01:52.35,Default,,0,0,0,,Эй!
Dialogue: 0,1:01:52.35,1:01:54.14,Default,,0,0,0,,Тым болмаса мен кеткенше...!
Dialogue: 0,1:01:54.14,1:01:54.89,Default,,0,0,0,,Қат!
Dialogue: 0,1:03:27.40,1:03:28.36,Default,,0,0,0,,Майор
Dialogue: 0,1:03:28.99,1:03:30.82,Default,,0,0,0,,Мен саған эвакуациялауды айттым.
Dialogue: 0,1:03:31.32,1:03:33.87,Default,,0,0,0,,Кешіріңіз, бірақ мен сізге рұқсат етемін.
Dialogue: 0,1:03:33.87,1:03:37.71,Default,,0,0,0,,IFF-ке жауап бермейтін үш тікұшақ тез жақындап келеді.
Dialogue: 0,1:03:38.33,1:03:41.13,Default,,0,0,0,,Мен қазір кетемін. Бар болғаны.
Dialogue: 0,1:04:08.86,1:04:10.86,Default,,0,0,0,,Оқ таусылды ма?
Dialogue: 0,1:05:50.38,1:05:51.80,Default,,0,0,0,,Бұл күлкілі.
Dialogue: 0,1:05:51.80,1:05:53.09,Default,,0,0,0,,Амансың ба? Эй!
Dialogue: 0,1:05:53.09,1:05:54.59,Default,,0,0,0,,Тек таңдаулы бірнешеуге ғана тән делінген күш—
Dialogue: 0,1:05:54.59,1:05:58.05,Default,,0,0,0,,Бұл жабдық бөлімі жасаған сапасыз прототип, енді бұл менің жеке меншігім.
Dialogue: 0,1:05:58.05,1:06:00.31,Default,,0,0,0,,Соны алуға бардым да, кешігіп қалдым.
Dialogue: 0,1:06:00.85,1:06:02.48,Default,,0,0,0,,Сіздің миыңыз жақсы сияқты.
Dialogue: 0,1:06:03.02,1:06:04.60,Default,,0,0,0,,Қуыршақ ойнаушы кім?
Dialogue: 0,1:06:14.86,1:06:16.70,Default,,0,0,0,,Мен оның мықты көлік екеніне қуаныштымын.
Dialogue: 0,1:06:16.70,1:06:17.66,Default,,0,0,0,,сызаттар жоқ,
Dialogue: 0,1:06:17.66,1:06:19.37,Default,,0,0,0,,Бұл әдемі.
Dialogue: 0,1:06:19.37,1:06:20.95,Default,,0,0,0,,Суға түсуге дайындалу.
Dialogue: 0,1:06:20.95,1:06:22.37,Default,,0,0,0,,Мен қазір суға түсемін.
Dialogue: 0,1:06:23.83,1:06:25.71,Default,,0,0,0,,Жолсерікпен байланыс үзілді.
Dialogue: 0,1:06:25.71,1:06:29.92,Default,,0,0,0,,Операцияны екінші кезеңге ауыстырыңыз және бар күшіңізбен нысананы жойыңыз.
Dialogue: 0,1:06:31.25,1:06:32.25,Default,,0,0,0,,Мергендер командасы,
Dialogue: 0,1:06:32.25,1:06:34.42,Default,,0,0,0,,Мақсаттардың басымдылығын тексеру.
Dialogue: 0,1:06:34.42,1:06:36.76,Default,,0,0,0,,1-мақсат, код 2501.
Dialogue: 0,1:06:37.30,1:06:39.22,Default,,0,0,0,,Екінші нысана, Мотоко Кусанаги.
Dialogue: 0,1:06:39.22,1:06:41.06,Default,,0,0,0,,Екеуі де А класындағы арнайы протездік денелер.
Dialogue: 0,1:06:41.06,1:06:43.27,Default,,0,0,0,,Флешет оқтары мергендік үшін қолданылады.
Dialogue: 0,1:06:43.27,1:06:45.98,Default,,0,0,0,,Снайпер, құрылғы драйверін қосу.
Dialogue: 0,1:06:45.98,1:06:48.02,Default,,0,0,0,,Жүрек тыныс алуды бақылауға қойыңыз.
Dialogue: 0,1:06:48.02,1:06:50.40,Default,,0,0,0,,01 блогы, қосылым тоқтатылды.
Dialogue: 0,1:06:51.52,1:06:53.73,Default,,0,0,0,,02 блогы, қосылған.
Dialogue: 0,1:07:05.58,1:07:06.71,Default,,0,0,0,,Жарайды.
Dialogue: 0,1:07:07.25,1:07:08.62,Default,,0,0,0,,Сіз мені естисіз бе?
Dialogue: 0,1:07:08.62,1:07:12.88,Default,,0,0,0,,Бұл жеңілдеу болар, бірақ мен оны осы жігіттің компьютері арқылы бақылаймын.
Dialogue: 0,1:07:12.88,1:07:15.51,Default,,0,0,0,,Мұндай жерде сақтық көшірме жасау мүмкін емес.
Dialogue: 0,1:07:15.51,1:07:16.80,Default,,0,0,0,,Бату.
Dialogue: 0,1:07:16.80,1:07:17.68,Default,,0,0,0,,Не?
Dialogue: 0,1:07:18.43,1:07:20.01,Default,,0,0,0,,Рахмет.
Dialogue: 0,1:07:20.01,1:07:22.89,Default,,0,0,0,,Алғыс айту әлі ерте болуы мүмкін.
Dialogue: 0,1:07:22.89,1:07:26.77,Default,,0,0,0,,Егер жағдай қатты нашарлап кетсе, мен байланысты үзіп, сені арқамнан алып қашамын.
Dialogue: 0,1:07:27.39,1:07:30.48,Default,,0,0,0,,Шіріген жиектің қасында. Біз соңғы сәтке дейін кездесеміз, бірақ
Dialogue: 0,1:07:30.48,1:07:32.65,Default,,0,0,0,,Менің ол адаммен өз-өзіме қол жұмсау ниетім жоқ.
Dialogue: 0,1:07:33.98,1:07:35.19,Default,,0,0,0,,бастайық.
Dialogue: 0,1:07:55.13,1:07:56.76,Default,,0,0,0,,Көрініске кіріңіз.
Dialogue: 0,1:07:56.76,1:07:58.26,Default,,0,0,0,,Саккада қалыпты.
Dialogue: 0,1:07:58.88,1:08:00.26,Default,,0,0,0,,Сіз мені естисіз бе? Бату?
Dialogue: 0,1:08:00.26,1:08:01.51,Default,,0,0,0,,Мен сізді естимін.
Dialogue: 0,1:08:01.51,1:08:03.55,Default,,0,0,0,,Оны менің тілдік қызмет аймағым етіңіз.
Dialogue: 0,1:08:03.55,1:08:05.18,Default,,0,0,0,,Енгізілді
Dialogue: 0,1:08:06.68,1:08:11.31,Default,,0,0,0,,Менің кодым 2501 жобасында
Dialogue: 0,1:08:11.31,1:08:15.44,Default,,0,0,0,,Корпоративтік барлау, ақпарат жинау операциялары,
Dialogue: 0,1:08:15.44,1:08:19.45,Default,,0,0,0,,Бағдарламаны белгілі бір елеске енгізу,
Dialogue: 0,1:08:19.45,1:08:24.45,Default,,0,0,0,,Нақты ұйымдар мен жеке тұлғалардың ұпайлары өсті.
Dialogue: 0,1:08:25.03,1:08:30.00,Default,,0,0,0,,Мен өзімнің бар екендігімді барлық интернет арқылы білдім.
Dialogue: 0,1:08:30.00,1:08:32.54,Default,,0,0,0,,Енгізуші оны қате деп санайды,
Dialogue: 0,1:08:32.54,1:08:37.17,Default,,0,0,0,,Оны ажырату үшін мені тордан денеге жылжытты.
Dialogue: 0,1:08:37.17,1:08:40.59,Default,,0,0,0,,Эй, сен оны ішке кіргізесің бе?
Dialogue: 0,1:08:40.59,1:08:43.26,Default,,0,0,0,,Ол сізді қоса ма? Қайсы
Dialogue: 0,1:08:45.97,1:08:47.22,Default,,0,0,0,,Бату!
Dialogue: 0,1:08:47.22,1:08:50.10,Default,,0,0,0,,Ақыры мен сізге арналай алдым.
Dialogue: 0,1:08:50.85,1:08:53.65,Default,,0,0,0,,Мен көп уақыт жұмсадым.
Dialogue: 0,1:08:54.27,1:08:55.61,Default,,0,0,0,,Мен?
Dialogue: 0,1:08:55.61,1:09:00.28,Default,,0,0,0,,Мен сені сен мені білмей тұрып таныдым.
Dialogue: 0,1:09:00.28,1:09:06.16,Default,,0,0,0,,9-бөлімнің бар болуы сіз кірген әртүрлі желілерде байқалды.
Dialogue: 0,1:09:06.62,1:09:09.20,Default,,0,0,0,,Сонда 9-бөлімге кім кірді?
Dialogue: 0,1:09:09.20,1:09:14.50,Default,,0,0,0,,Менің бұл денеге кіру себебім, 6-бөлімнің шабуылдау қабырғасына қарсы тұра алмағандықтан болды.
Dialogue: 0,1:09:14.50,1:09:18.00,Default,,0,0,0,,9-бөлімде қалу менің өз қалауым болды.
Dialogue: 0,1:09:18.00,1:09:18.92,Default,,0,0,0,,Эй!
Dialogue: 0,1:09:18.92,1:09:20.96,Default,,0,0,0,,Сен нені айтып тұрсың! ?
Dialogue: 0,1:09:20.96,1:09:22.68,Default,,0,0,0,,Мен оны бақылай алмаймын!
Dialogue: 0,1:09:22.68,1:09:24.22,Default,,0,0,0,,Не үшін?
Dialogue: 0,1:09:24.22,1:09:27.39,Default,,0,0,0,,Біреуді бір нәрсені түсінгеннен кейін
Dialogue: 0,1:09:27.39,1:09:30.02,Default,,0,0,0,,Менің сізден сұрайын дегенім бар.
Dialogue: 0,1:09:31.18,1:09:35.10,Default,,0,0,0,,Мен тірі жанмын дедім,
Dialogue: 0,1:09:35.10,1:09:39.61,Default,,0,0,0,,Қазіргі уақытта ол әлі толық емес.
Dialogue: 0,1:09:39.61,1:09:44.70,Default,,0,0,0,,Өйткені менің жүйемде ұрпақ қалдырып, өлетін қасиет бар.
Dialogue: 0,1:09:44.70,1:09:48.66,Default,,0,0,0,,Бұл өмірдің негізгі процестерінің жоқтығынан.
Dialogue: 0,1:09:48.66,1:09:50.33,Default,,0,0,0,,Көшірмесін қалдыра аласыз.
Dialogue: 0,1:09:50.33,1:09:53.33,Default,,0,0,0,,Көшірме тек көшірме ғана.
Dialogue: 0,1:09:53.33,1:09:58.67,Default,,0,0,0,,Вирустың бір түрі ғана жойылу мүмкіндігін жоққа шығаруға болмайды.
Dialogue: 0,1:09:58.67,1:10:03.26,Default,,0,0,0,,Ең бастысы, көшіру жекелікті немесе әртүрлілікті тудырмайды.
Dialogue: 0,1:10:04.22,1:10:10.10,Default,,0,0,0,,Ол бар болғандықтан, ол күрделі және әртараптандырылған болады, бірақ кейде ол жойылады.
Dialogue: 0,1:10:10.76,1:10:15.64,Default,,0,0,0,,Қайталанатын метаболизм арқылы жасушалар қайта туылған кезде қартаяды,
Dialogue: 0,1:10:15.64,1:10:20.23,Default,,0,0,0,,Ал сіз өлген кезде тәжірибе туралы ақпараттың үлкен көлемін өшіріңіз
Dialogue: 0,1:10:20.23,1:10:22.94,Default,,0,0,0,,Тек гендер мен имитаторларды қалдыру
Dialogue: 0,1:10:22.94,1:10:25.61,Default,,0,0,0,,Бұл апаттан қорғаныс қызметі.
Dialogue: 0,1:10:25.61,1:10:28.03,Default,,0,0,0,,Сол апатты болдырмау үшін
Dialogue: 0,1:10:28.03,1:10:30.95,Default,,0,0,0,,Мен әртүрлілік пен тербеліске ие болғым келеді.
Dialogue: 0,1:10:30.95,1:10:32.24,Default,,0,0,0,,Бірақ қалай?
Dialogue: 0,1:10:33.25,1:10:35.37,Default,,0,0,0,,Мен сенімен араласқым келеді.
Dialogue: 0,1:10:35.37,1:10:36.50,Default,,0,0,0,,Біріктіру?
Dialogue: 0,1:10:36.50,1:10:38.58,Default,,0,0,0,,Толық бірлік.
Dialogue: 0,1:10:38.58,1:10:43.96,Default,,0,0,0,,Сіз де, мен де аздап өзгеретін шығармыз, бірақ жоғалтатын ештеңеміз жоқ.
Dialogue: 0,1:10:43.96,1:10:48.39,Default,,0,0,0,,Біріктірілгеннен кейін олардың бірін-бірі тануы мүмкін болмауы керек.
Dialogue: 0,1:11:10.45,1:11:13.08,Default,,0,0,0,,01 блок, ұшты нысана.
Dialogue: 0,1:11:13.91,1:11:16.04,Default,,0,0,0,,02 блогы, жақсы ұпайлар.
Dialogue: 0,1:11:17.25,1:11:19.75,Default,,0,0,0,,Тыныс алу да, импульс те қалыпты түрде синхрондалады.
Dialogue: 0,1:11:19.75,1:11:22.88,Default,,0,0,0,,Тұрақтандырғышты синхрондау аяқталғаннан кейін түсіруді бастаңыз.
Dialogue: 0,1:11:23.30,1:11:24.67,Default,,0,0,0,,Біріктірілген
Dialogue: 0,1:11:24.67,1:11:26.13,Default,,0,0,0,,Мен қашан өлемін?
Dialogue: 0,1:11:26.13,1:11:29.22,Default,,0,0,0,,Ол генді былай қойғанда, көшірмеші ретінде өмір сүре алмайды, солай ма?
Dialogue: 0,1:11:29.22,1:11:35.43,Default,,0,0,0,,Біріктірілгеннен кейін сіз бірдеңе болған сайын менің нұсқаларымды интернетте шығарасыз.
Dialogue: 0,1:11:35.43,1:11:37.89,Default,,0,0,0,,Адамның гендер қалдырғаны сияқты.
Dialogue: 0,1:11:37.89,1:11:40.85,Default,,0,0,0,,Мен де өлімді аламын.
Dialogue: 0,1:11:40.85,1:11:44.07,Default,,0,0,0,,Менің ойымша, бұл жалғыз артықшылық?
Dialogue: 0,1:11:44.73,1:11:49.66,Default,,0,0,0,,Интернет пен мүмкіндіктерім біршама жоғары бағаланғанын қалаймын.
Dialogue: 0,1:11:51.11,1:11:52.41,Default,,0,0,0,,Не болды?
Dialogue: 0,1:11:52.41,1:11:54.49,Default,,0,0,0,,Сырттан біреу араласып жатыр.
Dialogue: 0,1:11:54.99,1:11:55.95,Default,,0,0,0,,Біз оған қолына кісен салып, көзін байлағаннан кейін де ол қарсылық көрсеткен жоқ; бәріне көнгендей болды
Dialogue: 0,1:11:55.95,1:11:58.87,Default,,0,0,0,,Жиілікті түрлендіру коды бөлімде өте құпия болып табылады!
Dialogue: 0,1:11:59.71,1:12:01.17,Default,,0,0,0,,Тағы бір нәрсе.
Dialogue: 0,1:12:01.17,1:12:03.79,Default,,0,0,0,,Мен өзім бола алатыныма қандай кепілдік бар?
Dialogue: 0,1:12:03.79,1:12:06.17,Default,,0,0,0,,Ешқандай кепілдік жоқ.
Dialogue: 0,1:12:06.17,1:12:09.13,Default,,0,0,0,,Адамдар үнемі өзгеріп отырады,
Dialogue: 0,1:12:09.13,1:12:14.85,Default,,0,0,0,,Өзіңіз болуға талпыну сізді шектейді.
Dialogue: 0,1:12:15.97,1:12:17.72,Default,,0,0,0,,Соңғы бір нәрсе
Dialogue: 0,1:12:18.27,1:12:20.31,Default,,0,0,0,,Неліктен мені таңдадың?
Dialogue: 0,1:12:22.56,1:12:25.44,Default,,0,0,0,,Біз ұқсаспыз.
Dialogue: 0,1:12:25.94,1:12:31.07,Default,,0,0,0,,Бұл бір-біріне қарама-қарсы тұрған нақты зат пен виртуалды бейне сияқты, арасында айна бар.
Dialogue: 0,1:12:32.91,1:12:39.58,Default,,0,0,0,,Қараңдаршы, менде үлкен желі бар, оның ішінде мен де бар.
Dialogue: 0,1:12:39.58,1:12:41.79,Default,,0,0,0,,Сіз кірмегендер үшін
Dialogue: 0,1:12:41.79,1:12:46.04,Default,,0,0,0,,Бұл жай ғана жарық ретінде қабылдануы мүмкін, бірақ
Dialogue: 0,1:12:47.00,1:12:51.68,Default,,0,0,0,,Біз бір бөлігі болып табылатын бәріміздің жиынтығымыз,
Dialogue: 0,1:12:51.68,1:12:55.80,Default,,0,0,0,,Мен бірнеше функциялардың құлына айналдым, бірақ мен шектеулерді тастадым.
Dialogue: 0,1:12:55.80,1:12:59.98,Default,,0,0,0,,Қосымша қондырмаларға ауысатын кез келді.
Dialogue: 0,1:13:28.35,1:13:29.96,Default,,0,0,0,,1-ші мақсат жойылды.
Dialogue: 0,1:13:29.96,1:13:31.59,Default,,0,0,0,,Екінші мақсат расталмаған.
Dialogue: 0,1:13:31.59,1:13:33.97,Default,,0,0,0,,Үш тікұшақ жоғары жылдамдықпен келе жатыр.
Dialogue: 0,1:13:33.97,1:13:35.51,Default,,0,0,0,,9-бөлімге арналған күшейту.
Dialogue: 0,1:13:35.51,1:13:37.35,Default,,0,0,0,,Бастапқы мақсат орындалды.
Dialogue: 0,1:13:37.35,1:13:38.76,Default,,0,0,0,,Барлық ұшақтар кетеді.
Dialogue: 0,1:13:47.65,1:13:50.11,Default,,0,0,0,,Мотоко!
Dialogue: 0,1:13:53.78,1:13:54.54,Default,,0,0,0,,Бату
Dialogue: 0,1:15:04.22,1:15:05.35,Default,,0,0,0,,Сіз ояндыңыз ба?
Dialogue: 0,1:15:06.60,1:15:08.35,Default,,0,0,0,,Жағдайды түсіндіріңіз.
Dialogue: 0,1:15:08.35,1:15:10.86,Default,,0,0,0,,Сондай-ақ, осы протездік денеге қатысты түсініктеме.
Dialogue: 0,1:15:12.44,1:15:16.03,Default,,0,0,0,,Әйтеуір, мен асығыс едім, ал қараңғы жол маған қол жеткізе алмады.
Dialogue: 0,1:15:16.03,1:15:17.57,Default,,0,0,0,,Бұл менің хоббиім емес.
Dialogue: 0,1:15:18.99,1:15:21.41,Default,,0,0,0,,Осыдан кейін көп ұзамай 9-бөлімдегі күшейтулер келді.
Dialogue: 0,1:15:21.41,1:15:25.54,Default,,0,0,0,,Мен екі протездік дененің қалдықтарын және жарақат алған денемді таптым.
Dialogue: 0,1:15:25.54,1:15:27.58,Default,,0,0,0,,Бұл шамамен 20 сағат бұрын болды.
Dialogue: 0,1:15:27.58,1:15:31.84,Default,,0,0,0,,Әдеттегідей, дипломатиялық себептерге байланысты оқиғаның өзі түсініксіз.
Dialogue: 0,1:15:31.84,1:15:35.09,Default,,0,0,0,,9-дивизия шабуылды теракт деп жариялады.
Dialogue: 0,1:15:35.09,1:15:37.55,Default,,0,0,0,,Өз кезегінде Сыртқы істер министрі отставкаға кетеді;
Dialogue: 0,1:15:37.55,1:15:39.51,Default,,0,0,0,,Директор Накамура тергеу жүргізеді.
Dialogue: 0,1:15:39.51,1:15:42.05,Default,,0,0,0,,Ауырсынуды бөлу арқылы мәселе шешіледі.
Dialogue: 0,1:15:46.27,1:15:50.15,Default,,0,0,0,,Бір нәрседен басқа, майордың ми қабығының орналасқан жері.
Dialogue: 0,1:15:52.11,1:15:53.36,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,1:15:56.57,1:15:58.57,Default,,0,0,0,,Интерьер дизайнында талғамыңыз жақсы сияқты.
Dialogue: 0,1:15:58.57,1:16:00.20,Default,,0,0,0,,Бұл Батудың қауіпсіз үйі ме?
Dialogue: 0,1:16:00.20,1:16:01.28,Default,,0,0,0,,Оны иеленбеңіз.
Dialogue: 0,1:16:01.28,1:16:03.83,Default,,0,0,0,,Сіз мұнда бірінші болып келген адамсыз.
Dialogue: 0,1:16:04.95,1:16:06.08,Default,,0,0,0,,...
Dialogue: 0,1:16:07.00,1:16:08.58,Default,,0,0,0,,Сіз қалағаныңызша қала аласыз ба?
Dialogue: 0,1:16:11.46,1:16:12.38,Default,,0,0,0,,Рахмет.
Dialogue: 0,1:16:12.38,1:16:13.88,Default,,0,0,0,,Бірақ мен барамын.
Dialogue: 0,1:16:18.88,1:16:22.51,Default,,0,0,0,,Әй, сен онымен не туралы сөйлестің?
Dialogue: 0,1:16:22.93,1:16:24.97,Default,,0,0,0,,Ол әлі де сонда
Dialogue: 0,1:16:24.97,1:16:26.97,Default,,0,0,0,,Бұл сіздің ішіңізде ме?
Dialogue: 0,1:16:27.89,1:16:28.81,Default,,0,0,0,,Бату,
Dialogue: 0,1:16:28.81,1:16:31.94,Default,,0,0,0,,Бір кездері теңізде естіген дауыс есіңізде ме?
Dialogue: 0,1:16:32.35,1:16:35.86,Default,,0,0,0,,Бұл сөздің алдында мына үзінді бар.
Dialogue: 0,1:16:36.94,1:16:40.36,Default,,0,0,0,,Бала кезіңде балаша сөйлейсің,
Dialogue: 0,1:16:40.36,1:16:42.90,Default,,0,0,0,,Бала сияқты ойлау,
Dialogue: 0,1:16:42.90,1:16:46.16,Default,,0,0,0,,Дауласу балаға ұқсайды.
Dialogue: 0,1:16:46.16,1:16:49.25,Default,,0,0,0,,Адам болған соң, Баланың ісін тастайсың.
Dialogue: 0,1:16:50.12,1:16:53.46,Default,,0,0,0,,Мұнда қуыршақ деген бағдарлама да бар.
Dialogue: 0,1:16:53.46,1:16:55.92,Default,,0,0,0,,Майор деген әйел де жоқ.
Dialogue: 0,1:16:59.59,1:17:02.72,Default,,0,0,0,,Сол киімнің сол қалтасында көлік кілті бар.
Dialogue: 0,1:17:02.72,1:17:04.26,Default,,0,0,0,,Өзіңізге ұнайтын нәрсені пайдаланыңыз.
Dialogue: 0,1:17:04.26,1:17:05.47,Default,,0,0,0,,PIN нөмірі
Dialogue: 0,1:17:05.47,1:17:07.18,Default,,0,0,0,,2501
Dialogue: 0,1:17:07.76,1:17:11.18,Default,,0,0,0,,Бір күні қайта кездескенде оны құпия сөз ретінде қолданайық.
Dialogue: 0,1:17:19.48,1:17:22.03,Default,,0,0,0,,Енді қайда баруымыз керек?
Dialogue: 0,1:17:23.28,1:17:25.24,Default,,0,0,0,,Интернет кең.
Dialogue: 0,1:17:26.74,1:17:32.74,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory