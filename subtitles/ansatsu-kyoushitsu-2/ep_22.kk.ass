Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.41,0:00:03.33,Default,,0,0,0,,Көктегі найза
Dialogue: 0,0:00:04.83,0:00:06.25,Default,,0,0,0,,Жер қалқаны
Dialogue: 0,0:00:07.29,0:00:12.34,Default,,0,0,0,,Үкімет Короссейді жерлеудің соңғы жоспарын іске қосты.
Dialogue: 0,0:00:12.42,0:00:15.89,Default,,0,0,0,,Тілегіміз естілмеді.
Dialogue: 0,0:00:17.76,0:00:21.35,Default,,0,0,0,,Соңғы миссия – барлығын мектепке қауіпсіз жеткізу!
Dialogue: 0,0:00:22.43,0:00:23.31,Default,,0,0,0,,Мен сенімен танысқым келеді
Dialogue: 0,0:00:24.94,0:00:27.02,Default,,0,0,0,,Біз кездеспейінше ештеңе бітпейді
Dialogue: 0,0:00:28.61,0:00:33.28,Default,,0,0,0,,Коросей, өлтіру мерзімінің аяқталуына небәрі 3 сағат қалды.
Dialogue: 0,0:00:33.99,0:00:38.99,Default,,0,0,0,,♪～
Dialogue: 0,0:01:58.66,0:02:03.91,Default,,0,0,0,,～♪
Dialogue: 0,0:02:14.46,0:02:18.34,Default,,0,0,0,,Аспан найзасы толтыруға 3 сағат қалды
Dialogue: 0,0:02:18.42,0:02:22.30,Default,,0,0,0,,Сирек кездесетін эксперименттік үлгілерді толығымен көму
Dialogue: 0,0:02:22.39,0:02:24.56,Default,,0,0,0,,Бұл біраз ысырап болса да.
Dialogue: 0,0:02:24.64,0:02:26.77,Default,,0,0,0,,Бұл да әлем тыныштығы үшін.
Dialogue: 0,0:02:27.52,0:02:30.35,Default,,0,0,0,,Сіз өте аласыз ба? Балалар
Dialogue: 0,0:02:30.44,0:02:31.02,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:31.02,0:02:31.56,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:31.02,0:02:31.56,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:02:31.56,0:02:31.65,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:02:31.65,0:02:32.48,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:02:31.65,0:02:32.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:32.56,0:02:34.82,Default,,0,0,0,,- (Командир) Не! -(Қызметкерлер) Таудағы басқыншылар
Dialogue: 0,0:02:34.90,0:02:37.28,Default,,0,0,0,,Қауіпсіздік желісі бұзылған сияқты!
Dialogue: 0,0:02:37.36,0:02:39.99,Default,,0,0,0,,Уф... ха ха...
Dialogue: 0,0:02:40.07,0:02:41.45,Default,,0,0,0,,Құбыжықтар тобы!
Dialogue: 0,0:02:41.53,0:02:43.41,Default,,0,0,0,,Ол міндетті түрде станцияны пайдаланбайды; көлікпен қатынап жүрген болуы мүмкін.
Dialogue: 0,0:02:45.87,0:02:48.54,Default,,0,0,0,,Бұл қорқынышты түс! Қанша адам екенін білмеймін!
Dialogue: 0,0:02:48.62,0:02:50.08,Default,,0,0,0,,Қарғыс атсын... бұл өте жаман!
Dialogue: 0,0:02:50.87,0:02:52.17,Default,,0,0,0,,- (Исоғай) Әй! -(Солдат) Арх!
Dialogue: 0,0:02:56.17,0:02:57.51,Default,,0,0,0,,Жарайды
Dialogue: 0,0:02:57.59,0:02:59.59,Default,,0,0,0,,Үшеуінің арасындағы жақсы ынтымақтастық
Dialogue: 0,0:02:59.67,0:03:00.51,Default,,0,0,0,,Иә
Dialogue: 0,0:03:01.43,0:03:04.05,Default,,0,0,0,,В тобымен байланыс үзілді.
Dialogue: 0,0:03:04.14,0:03:06.93,Default,,0,0,0,,Зиянкес шынымен болған сияқты. Сақ болыңыз.
Dialogue: 0,0:03:07.02,0:03:08.35,Default,,0,0,0,,- (Отряд мүшелері) Жарайды - (Отряд мүшелері) Уф!
Dialogue: 0,0:03:08.43,0:03:09.85,Default,,0,0,0,,Иә! Ах!
Dialogue: 0,0:03:11.64,0:03:13.61,Default,,0,0,0,,-(Қатысушы) Уф... -(Қатысушы) Ой... Эй!
Dialogue: 0,0:03:13.69,0:03:14.90,Default,,0,0,0,,Не... Уау!
Dialogue: 0,0:03:14.98,0:03:17.69,Default,,0,0,0,,Снайпер бар! Барлығына ескертілді!
Dialogue: 0,0:03:17.78,0:03:18.61,Default,,0,0,0,,Орналасқан жері...
Dialogue: 0,0:03:18.69,0:03:19.15,Default,,0,0,0,,- (Хара) Хмф! -(Эскадрон) Гуаа!
Dialogue: 0,0:03:19.15,0:03:20.40,Default,,0,0,0,,- (Хара) Хмф! -(Эскадрон) Гуаа!
Dialogue: 0,0:03:19.15,0:03:20.40,Default,,0,0,0,,Уақытпен шектелген бе?
Dialogue: 0,0:03:20.49,0:03:21.32,Default,,0,0,0,,Мен енді жылап жібергім келеді!
Dialogue: 0,0:03:21.40,0:03:24.78,Default,,0,0,0,,Әй... Әй, енді дыбыс дұрыс па?
Dialogue: 0,0:03:24.87,0:03:27.79,Default,,0,0,0,,Жарайды, жай ғана ақырын орап алдым.
Dialogue: 0,0:03:27.87,0:03:30.79,Default,,0,0,0,,Бұл команда тазаланды, Карма.
Dialogue: 0,0:03:30.87,0:03:31.75,Default,,0,0,0,,Жарайды
Dialogue: 0,0:03:32.42,0:03:33.71,Default,,0,0,0,,Онда жағдай қандай?
Dialogue: 0,0:03:33.79,0:03:35.96,Default,,0,0,0,,Хмм? Қазір...
Dialogue: 0,0:03:36.04,0:03:39.17,Default,,0,0,0,,Гах! қиын! Бояды! Уф...
Dialogue: 0,0:03:39.26,0:03:40.47,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:03:40.55,0:03:41.76,Default,,0,0,0,,Өйткені әркім өз ісінің маманы
Dialogue: 0,0:03:41.84,0:03:44.47,Default,,0,0,0,,Бұны жасамасаң, айқайламайсың, солай ма?
Dialogue: 0,0:03:44.55,0:03:46.30,Default,,0,0,0,,Гуаааааа!
Dialogue: 0,0:03:46.39,0:03:49.35,Default,,0,0,0,,Көбірек күшейткіштерді тарту үшін айғайларды жем ретінде пайдаланыңыз
Dialogue: 0,0:03:49.43,0:03:52.69,Default,,0,0,0,,Мен тағы екі-үш адамды осында аяқтағым келеді.
Dialogue: 0,0:03:53.31,0:03:54.40,Default,,0,0,0,,Сіз мұны істей аласыз, солай ма? заң
Dialogue: 0,0:03:54.48,0:03:55.31,Default,,0,0,0,,Иә
Dialogue: 0,0:03:56.19,0:03:58.78,Default,,0,0,0,,Жотаның бойында шамамен үш адам келе жатыр.
Dialogue: 0,0:03:58.86,0:04:01.28,Default,,0,0,0,,Ал шыршалардың биік жерінде
Dialogue: 0,0:04:01.36,0:04:03.24,Default,,0,0,0,,Тұрақты пулеметтер орналастырылған
Dialogue: 0,0:04:03.32,0:04:04.70,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:04:04.78,0:04:06.03,Default,,0,0,0,,Жабайы жүзім бұтасынан
Dialogue: 0,0:04:06.12,0:04:08.74,Default,,0,0,0,,Халық көп қоныстанған жерлер арқылы өтетін жол қандай?
Dialogue: 0,0:04:08.83,0:04:11.50,Default,,0,0,0,,Иә, бұл жақсы.
Dialogue: 0,0:04:11.58,0:04:12.87,Default,,0,0,0,,Джа Терасака
Dialogue: 0,0:04:12.96,0:04:16.21,Default,,0,0,0,,Осы жолда жауды жеңіп, Иппонмацуға аттаныңыз.
Dialogue: 0,0:04:16.29,0:04:17.67,Default,,0,0,0,,Лорд Тенген…
Dialogue: 0,0:04:19.21,0:04:21.21,Default,,0,0,0,,-(Отряд мүшесі) Арх! -(Эскадрон) О...
Dialogue: 0,0:04:21.30,0:04:22.51,Default,,0,0,0,,Әй!
Dialogue: 0,0:04:23.13,0:04:24.59,Default,,0,0,0,,Бұл не өзі?!
Dialogue: 0,0:04:28.35,0:04:30.10,Default,,0,0,0,,С тобы, D тобы, қайда екені белгісіз!
Dialogue: 0,0:04:30.18,0:04:31.60,Default,,0,0,0,,Жағдайды дереу хабарлаңыз!
Dialogue: 0,0:04:31.68,0:04:34.60,Default,,0,0,0,,Не дейсің, Қарасума!
Dialogue: 0,0:04:34.69,0:04:37.48,Default,,0,0,0,,Сол тау біздің студенттердің мекені.
Dialogue: 0,0:04:38.23,0:04:41.36,Default,,0,0,0,,Мен онда бір жыл болдым, супер жаратылыстарға ұмтылдым.
Dialogue: 0,0:04:41.44,0:04:45.11,Default,,0,0,0,,Мен ойнауды және сабақты жалғастырдым.
Dialogue: 0,0:04:45.20,0:04:47.95,Default,,0,0,0,,Енді көздеріңді жұмып қозғалуға болады
Dialogue: 0,0:04:48.03,0:04:50.45,Default,,0,0,0,,Орынды сол оқу орнымен шектесеңіз
Dialogue: 0,0:04:50.54,0:04:53.91,Default,,0,0,0,,Олар әлемдегі ең қорқынышты өлтірушілер тобы.
Dialogue: 0,0:04:54.00,0:04:56.17,Default,,0,0,0,,Сіз жіптерді тарттыңыз ба?
Dialogue: 0,0:04:56.25,0:04:58.29,Default,,0,0,0,,Олар өздері шешеді
Dialogue: 0,0:04:58.38,0:05:01.96,Default,,0,0,0,,Өзіміз жоспарладық, өзіміз жүзеге асырдық.
Dialogue: 0,0:05:02.05,0:05:07.26,Default,,0,0,0,,Біз оларды тоқтатсақ та, олар жарып өтуге бар күшін салады.
Dialogue: 0,0:05:07.34,0:05:08.97,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:05:09.80,0:05:11.72,Default,,0,0,0,,​​Ата-ана ақымақ.
Dialogue: 0,0:05:12.85,0:05:16.69,Default,,0,0,0,,Окадзима Мен сол жолмен жүрдім. 50 метр қалды.
Dialogue: 0,0:05:17.65,0:05:21.15,Default,,0,0,0,,Егер сіз команданы алғыңыз келсе, Джо Акабане ең жақсы таңдау болар еді.
Dialogue: 0,0:05:21.94,0:05:25.61,Default,,0,0,0,,Ібіліс санасы бар нәрсені пайдаланады.
Dialogue: 0,0:05:25.70,0:05:30.03,Default,,0,0,0,,Ха ха ха ха... Не!? Қанша жау бар!?
Dialogue: 0,0:05:30.12,0:05:33.45,Default,,0,0,0,,-(Мүшелер) Уау! -(Мүшелер) Уау!
Dialogue: 0,0:05:33.54,0:05:35.75,Default,,0,0,0,,Ah... uh...
Dialogue: 0,0:05:35.83,0:05:38.71,Default,,0,0,0,,Мен аздап қобалжыдым.
Dialogue: 0,0:05:38.79,0:05:41.04,Default,,0,0,0,,Арх!
Dialogue: 0,0:05:41.13,0:05:44.17,Default,,0,0,0,,Бұл тау әрқашан тұзаққа толы.
Dialogue: 0,0:05:44.26,0:05:47.43,Default,,0,0,0,,Мен оны Коросенейді ескере отырып орнаттым.
Dialogue: 0,0:05:47.51,0:05:48.72,Default,,0,0,0,,Хмф!
Dialogue: 0,0:05:49.55,0:05:51.72,Default,,0,0,0,,Уау! Эй! Түсіріңіз!
Dialogue: 0,0:05:51.80,0:05:53.18,Default,,0,0,0,,Ақымақ адамдар—
Dialogue: 0,0:05:53.26,0:05:55.31,Default,,0,0,0,,Гррр…
Dialogue: 0,0:05:56.48,0:05:58.85,Default,,0,0,0,,(Сарбаздардың азап дауыстары)
Dialogue: 0,0:06:03.57,0:06:06.78,Default,,0,0,0,,Цк, қалды ма?
Dialogue: 0,0:06:08.03,0:06:10.49,Default,,0,0,0,,Біздің салғырттық танытқанымыз рас.
Dialogue: 0,0:06:10.57,0:06:13.87,Default,,0,0,0,,Бұл жерде сіз көп қиындық көрген сияқтысыз.
Dialogue: 0,0:06:18.04,0:06:19.46,Default,,0,0,0,,Жансыздандыратын ине?
Dialogue: 0,0:06:20.00,0:06:24.00,Default,,0,0,0,,Бірақ сіз не істеп жатқаныңызды білетін болсаңыз, бұл маңызды емес.
Dialogue: 0,0:06:24.09,0:06:25.96,Default,,0,0,0,,Сол жалған жылы жүзді жігіт! Ол шынымен де мұны салқын жүзбен айтты!
Dialogue: 0,0:06:26.05,0:06:28.26,Default,,0,0,0,,- (Йошида) Эй! -(Терасака) Гуа!
Dialogue: 0,0:06:28.34,0:06:30.64,Default,,0,0,0,,Эй... Иә! Қарғыс атқыр...
Dialogue: 0,0:06:30.72,0:06:32.55,Default,,0,0,0,,-Уф... -(Капитан) Хмф!
Dialogue: 0,0:06:32.64,0:06:34.64,Default,,0,0,0,,-Хаа... Қарғыс атсын... -(Сугино) Карма!
Dialogue: 0,0:06:36.31,0:06:37.35,Default,,0,0,0,,Бала...
Dialogue: 0,0:06:37.43,0:06:41.31,Default,,0,0,0,,Тыныш болсаң, ақыры осы болар еді...
Dialogue: 0,0:06:42.19,0:06:46.03,Default,,0,0,0,,Осы уақыт ішінде не нәрсеге шағымданып жүрсіз?
Dialogue: 0,0:06:46.11,0:06:48.19,Default,,0,0,0,,Мұны өзіміз шешуіміз керек...
Dialogue: 0,0:06:48.28,0:06:49.28,Default,,0,0,0,,Бұл дұрыс емес!
Dialogue: 0,0:06:49.36,0:06:52.24,Default,,0,0,0,,Кейінірек келіп нұсқау бермеңіз!
Dialogue: 0,0:06:52.32,0:06:54.41,Default,,0,0,0,,- (Капитан) Куу! -(Маэхара) Арх!
Dialogue: 0,0:06:54.49,0:06:57.54,Default,,0,0,0,,Коро-сенсэйге келгенде бізге сеніңіз!
Dialogue: 0,0:06:57.62,0:07:00.46,Default,,0,0,0,,Оны бізге қалдырыңыз!
Dialogue: 0,0:07:00.54,0:07:01.37,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:03.17,0:07:04.34,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:04.42,0:07:05.63,Default,,0,0,0,,(қол шапалақтау дыбысы)
Dialogue: 0,0:07:05.71,0:07:06.96,Default,,0,0,0,,Уф!
Dialogue: 0,0:07:07.05,0:07:08.01,Default,,0,0,0,,Карма!
Dialogue: 0,0:07:08.09,0:07:09.34,Default,,0,0,0,,Эйкку!
Dialogue: 0,0:07:09.42,0:07:10.84,Default,,0,0,0,,Аһ!
Dialogue: 0,0:07:13.14,0:07:18.52,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:07:18.60,0:07:20.18,Default,,0,0,0,,-Нағиса-(Нағиса) А...
Dialogue: 0,0:07:20.27,0:07:21.60,Default,,0,0,0,,Хаха
Dialogue: 0,0:07:21.69,0:07:23.06,Default,,0,0,0,,Хаха
Dialogue: 0,0:07:24.77,0:07:26.32,Default,,0,0,0,,Сәлем! Ол әлі жұмыс істейді!
Dialogue: 0,0:07:26.40,0:07:28.53,Default,,0,0,0,,Қарғыс атқыр балалар! Арх!
Dialogue: 0,0:07:28.61,0:07:30.90,Default,,0,0,0,,Бітіріңдер, қарғыс атсын!
Dialogue: 0,0:07:28.61,0:07:30.90,Default,,0,0,0,,(тоқтың ағып жатқан дыбысы)
Dialogue: 0,0:07:30.99,0:07:33.61,Default,,0,0,0,,Салқын көрінуге тырыспаңыз және жоғары бестік беріңіз!
Dialogue: 0,0:07:30.99,0:07:33.61,Default,,0,0,0,,(Капитанның айқайы)
Dialogue: 0,0:07:33.61,0:07:33.70,Default,,0,0,0,,(Капитанның айқайы)
Dialogue: 0,0:07:33.70,0:07:34.74,Default,,0,0,0,,(Капитанның айқайы)
Dialogue: 0,0:07:33.70,0:07:34.74,Default,,0,0,0,,О...
Dialogue: 0,0:07:35.53,0:07:38.08,Default,,0,0,0,,Барлық мүшелерден жауап жоқ!
Dialogue: 0,0:07:38.16,0:07:39.33,Default,,0,0,0,,Не…
Dialogue: 0,0:07:44.88,0:07:46.34,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:07:46.42,0:07:47.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:48.30,0:07:50.47,Default,,0,0,0,,Дыбыс арқылы ғана аңғардым.
Dialogue: 0,0:07:50.55,0:07:52.97,Default,,0,0,0,,-(Оқушылар) А... -(Нағиса) Мұғалім...
Dialogue: 0,0:07:53.05,0:07:56.18,Default,,0,0,0,,Бәрің де өстіңдер.
Dialogue: 0,0:07:57.56,0:08:01.85,Default,,0,0,0,,- (Нагиса және басқалар) Коро-сенсэй! -(Оқушылар) Мұғалім! Хахаха...
Dialogue: 0,0:08:04.19,0:08:07.77,Default,,0,0,0,,Оқушылар қауіп-қатерді біле тұра шлагбаумға кірді...
Dialogue: 0,0:08:07.86,0:08:11.07,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:08:11.15,0:08:14.28,Default,,0,0,0,,Азаматтар ретінде біз оларды жалғыз қалдыра алмаймыз.
Dialogue: 0,0:08:14.36,0:08:16.78,Default,,0,0,0,,Бұрышта тұрған нысана шарасыз болып қалса
Dialogue: 0,0:08:16.87,0:08:18.83,Default,,0,0,0,,Бұл апат болуы мүмкін.
Dialogue: 0,0:08:18.91,0:08:19.74,Default,,0,0,0,,Я...
Dialogue: 0,0:08:19.83,0:08:22.37,Default,,0,0,0,,Ирина екеуміз барамыз.
Dialogue: 0,0:08:22.46,0:08:24.83,Default,,0,0,0,,Біз оларды көндіре аламыз
Dialogue: 0,0:08:24.92,0:08:26.21,Default,,0,0,0,,Nbe
Dialogue: 0,0:08:28.79,0:08:31.17,Default,,0,0,0,,Бұл лазер сәулесі...
Dialogue: 0,0:08:31.26,0:08:33.17,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:33.26,0:08:38.14,Default,,0,0,0,,Мені өлтіретін лазер күн өзгермес бұрын түсіріледі ме?
Dialogue: 0,0:08:38.22,0:08:39.56,Default,,0,0,0,,Егер бұл шығыс
Dialogue: 0,0:08:39.64,0:08:43.23,Default,,0,0,0,,Тіпті толық қорғаныс формалары да жарамсыз болады.
Dialogue: 0,0:08:43.31,0:08:44.56,Default,,0,0,0,,Бұл...
Dialogue: 0,0:08:44.64,0:08:47.06,Default,,0,0,0,,Коро-сенсэй, қашу үшін бірдеңе істейік.
Dialogue: 0,0:08:47.15,0:08:50.52,Default,,0,0,0,,Біз кепілге немесе кез келген нәрсеге айналуымыз мүмкін!
Dialogue: 0,0:08:50.61,0:08:51.61,Default,,0,0,0,,Иә
Dialogue: 0,0:08:52.24,0:08:55.49,Default,,0,0,0,,Енді менің бар екенім әлемге белгілі болды
Dialogue: 0,0:08:55.57,0:08:58.45,Default,,0,0,0,,Атыс енді тоқтатылмайды.
Dialogue: 0,0:09:00.37,0:09:04.21,Default,,0,0,0,,Коросей білді ме? Бұл болады...
Dialogue: 0,0:09:04.29,0:09:06.79,Default,,0,0,0,,Мұғалім жарылып кетпесе де
Dialogue: 0,0:09:06.87,0:09:11.17,Default,,0,0,0,,Әлемнің барлық елдері мұндай құбыжықтан қорықпауы мүмкін емес.
Dialogue: 0,0:09:11.25,0:09:16.13,Default,,0,0,0,,Сіз бәрібір тыныс алуды тоқтатқыңыз келеді деп ойлау орынды болар еді...
Dialogue: 0,0:09:16.22,0:09:18.05,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:18.14,0:09:21.85,Default,,0,0,0,,Егер мен ертерек әрекет еткенімде, бір жолы болар еді...
Dialogue: 0,0:09:21.93,0:09:24.31,Default,,0,0,0,,Тосқауыл генераторы жойылғаннан кейін
Dialogue: 0,0:09:24.39,0:09:27.27,Default,,0,0,0,,Теледидар мен интернетке шығып, шағымдану
Dialogue: 0,0:09:27.35,0:09:31.48,Default,,0,0,0,,Егер сіз мұны жасасаңыз, сіз одан да қауіпті болып көрінесіз.
Dialogue: 0,0:09:31.57,0:09:34.24,Default,,0,0,0,,мұқият бақылауға алынған болуы мүмкін
Dialogue: 0,0:09:34.99,0:09:38.20,Default,,0,0,0,,Генератордың қорғанысы да өтпейді.
Dialogue: 0,0:09:38.28,0:09:43.16,Default,,0,0,0,,Мұғалім сізге тас лақтырған жағдайда зениттік қарулар да орналастырылған.
Dialogue: 0,0:09:44.00,0:09:48.37,Default,,0,0,0,,Ағымдағы қабілеттеріңіз бен құрал-жабдықтарыңыз болса, сіз орта жолда ұсталып қалар едіңіз.
Dialogue: 0,0:09:48.46,0:09:52.50,Default,,0,0,0,,Міне, бұл жоспар өте тамаша болды.
Dialogue: 0,0:09:52.59,0:09:56.34,Default,,0,0,0,,Технология, уақыт және кадрлар жомарт түрде құйылды.
Dialogue: 0,0:09:56.42,0:10:01.05,Default,,0,0,0,,Дүние жүзіндегі даналық пен күш-жігердің жемісіне қастандық жасау
Dialogue: 0,0:10:01.14,0:10:04.52,Default,,0,0,0,,Ұстазымның қабілетінен асып түскені үшін құрметті сезіндім.
Dialogue: 0,0:10:04.60,0:10:08.94,Default,,0,0,0,,Мен сол мақсатқа ие болғанымды мақтан тұтамын.
Dialogue: 0,0:10:09.02,0:10:10.48,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:10.56,0:10:11.69,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:10:11.77,0:10:15.48,Default,,0,0,0,,Сонда біздің барлық күш-жігеріміз бекер болды ма?
Dialogue: 0,0:10:15.57,0:10:19.20,Default,,0,0,0,,Ысырап деген бар ма? Ята мырза
Dialogue: 0,0:10:19.28,0:10:24.79,Default,,0,0,0,,Мұғаліміңіздің жарылу ықтималдығы 1%-дан аз екеніне бәріңіз келісесіз.
Dialogue: 0,0:10:24.87,0:10:27.91,Default,,0,0,0,,Ол тіпті білу үшін ғарышқа да барды
Dialogue: 0,0:10:28.00,0:10:32.38,Default,,0,0,0,,Сіздің арқаңызда жарықтық қараңғыда болған Е сыныбына қайта оралды.
Dialogue: 0,0:10:32.46,0:10:36.80,Default,,0,0,0,,Одан кейінгі ай қысқа, бірақ қызықты болды.
Dialogue: 0,0:10:36.88,0:10:37.84,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:37.92,0:10:41.93,Default,,0,0,0,,Процесс... жүрек маңызды.
Dialogue: 0,0:10:42.64,0:10:47.48,Default,,0,0,0,,Білгеніңнің бәрін жасап, маған келдің.
Dialogue: 0,0:10:47.56,0:10:51.15,Default,,0,0,0,,Мұғалім ретінде мен бақытты бола алмас едім.
Dialogue: 0,0:10:52.36,0:10:54.36,Default,,0,0,0,,Менің ойымша, қазір уақыт аяқталды.
Dialogue: 0,0:10:54.44,0:10:55.65,Default,,0,0,0,,Жаңа ма?
Dialogue: 0,0:10:55.73,0:10:57.82,Default,,0,0,0,,Тек 1%?
Dialogue: 0,0:10:57.90,0:11:01.16,Default,,0,0,0,,Біз мұндай тәуекелдерді көтере аламыз!
Dialogue: 0,0:11:01.24,0:11:02.74,Default,,0,0,0,,Үкімет және дүние дегеніміз не?
Dialogue: 0,0:11:02.82,0:11:06.29,Default,,0,0,0,,Олармен ең жақын араласқандарымыздың пікірін тыңдағысы келмейді!
Dialogue: 0,0:11:06.37,0:11:10.37,Default,,0,0,0,,Бұл сегізаяқ сексуалды, бірақ қауіпті емес!
Dialogue: 0,0:11:10.46,0:11:13.00,Default,,0,0,0,,Баланың сөзін тыңдама
Dialogue: 0,0:11:13.08,0:11:15.59,Default,,0,0,0,,Қайта мен сені аяймын.
Dialogue: 0,0:11:15.67,0:11:17.09,Default,,0,0,0,,Бұл қорлау сияқты.
Dialogue: 0,0:11:17.17,0:11:19.34,Default,,0,0,0,,Сіз мұны қабылдай аласыз ба?
Dialogue: 0,0:11:19.42,0:11:22.01,Default,,0,0,0,,Келесі жолы олармен кездессем, бәрін беремін... Уф...
Dialogue: 0,0:11:22.09,0:11:22.93,Default,,0,0,0,,- (Йошида) Ах - (Мурамацу) Уф
Dialogue: 0,0:11:23.01,0:11:24.35,Default,,0,0,0,,- (Хазама) Ух - (Терасака) Ух...
Dialogue: 0,0:11:24.43,0:11:26.97,Default,,0,0,0,,Терасака мырза, барлығыңыз
Dialogue: 0,0:11:27.06,0:11:29.31,Default,,0,0,0,,Мұғалімнен кеңес алыңыз
Dialogue: 0,0:11:30.43,0:11:35.15,Default,,0,0,0,,Қалған өміріңізде сізге күшті әлеуметтік ағымдар кедергі болады.
Dialogue: 0,0:11:35.23,0:11:38.28,Default,,0,0,0,,Сіз қалаған нәтижеге қол жеткізе алмайтын кездер әрқашан болады.
Dialogue: 0,0:11:38.36,0:11:42.74,Default,,0,0,0,,Ол кезде себебін қоғамнан сұрауға болмайды.
Dialogue: 0,0:11:42.82,0:11:46.20,Default,,0,0,0,,Қоғамды жоққа шығарма
Dialogue: 0,0:11:46.28,0:11:50.91,Default,,0,0,0,,Бұл шынын айтқанда уақытты босқа кетіру.
Dialogue: 0,0:11:51.00,0:11:54.79,Default,,0,0,0,,Осындай кездерде: «Дүние солай».
Dialogue: 0,0:11:54.88,0:11:57.63,Default,,0,0,0,,Өтінемін, әйтеуір өкініштен арылыңыз.
Dialogue: 0,0:11:57.71,0:12:00.92,Default,,0,0,0,,Мен оны жеңгеннен кейін ойлаймын.
Dialogue: 0,0:12:01.01,0:12:04.01,Default,,0,0,0,,Қоғамның ағысы менімен ойыншық болса
Dialogue: 0,0:12:04.09,0:12:07.85,Default,,0,0,0,,Онда қалай жүзу керек?
Dialogue: 0,0:12:07.93,0:12:10.56,Default,,0,0,0,,Сіз мұны қалай жасау керектігін үйренуіңіз керек еді.
Dialogue: 0,0:12:10.64,0:12:12.18,Default,,0,0,0,,Бұл топта Е
Dialogue: 0,0:12:12.27,0:12:14.56,Default,,0,0,0,,Осы қастандық кабинетінде
Dialogue: 0,0:12:14.65,0:12:17.90,Default,,0,0,0,,Сіз әрқашан онымен бетпе-бет келудің қажеті жоқ.
Dialogue: 0,0:12:17.98,0:12:20.61,Default,,0,0,0,,Эвакуациялауға немесе жасыруға болмайды.
Dialogue: 0,0:12:20.69,0:12:23.57,Default,,0,0,0,,Тосын шабуылдар заңсыз болмаған жағдайда рұқсат етіледі.
Dialogue: 0,0:12:23.65,0:12:27.16,Default,,0,0,0,,Сіз дәстүрлі емес қаруларды пайдалана аласыз.
Dialogue: 0,0:12:27.24,0:12:32.71,Default,,0,0,0,,Мотивацияңыз болса, асықпаңыз, берілмеңіз және сынақ пен қатені қайталаңыз.
Dialogue: 0,0:12:32.79,0:12:36.13,Default,,0,0,0,,Бір күні керемет нәтижелер болады.
Dialogue: 0,0:12:36.21,0:12:41.84,Default,,0,0,0,,Бәрің де мұны істей алатын ең жоғары дәрежелі өлтірушілерсіңдер.
Dialogue: 0,0:12:43.34,0:12:46.05,Default,,0,0,0,,Ке, осы уақытқа дейін сабақтасың ба?
Dialogue: 0,0:12:46.72,0:12:48.26,Default,,0,0,0,,Нуруфуфуфуфуфу
Dialogue: 0,0:12:48.35,0:12:51.06,Default,,0,0,0,,Бұл тек осындай кезде ғана болатын сабақ.
Dialogue: 0,0:12:51.14,0:12:54.64,Default,,0,0,0,,Мұғалім ретінде сабақ беру мүмкіндігін жіберіп алмаңыз.
Dialogue: 0,0:12:56.23,0:12:57.56,Default,,0,0,0,,Бірақ эй
Dialogue: 0,0:12:57.65,0:13:01.36,Default,,0,0,0,,Балалар сендер мені құтқаруға тырыстыңдар.
Dialogue: 0,0:13:01.44,0:13:04.82,Default,,0,0,0,,Қуанғаным сонша, көз жасымды ұзақ ұстадым.
Dialogue: 0,0:13:05.91,0:13:07.78,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:13:09.53,0:13:10.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:10.74,0:13:13.83,Default,,0,0,0,,Қалайша сабырлы бола аласың?
Dialogue: 0,0:13:13.91,0:13:14.75,Default,,0,0,0,,Коросей
Dialogue: 0,0:13:15.83,0:13:17.79,Default,,0,0,0,,Бұл топқа келмесеңіз Е...
Dialogue: 0,0:13:17.88,0:13:20.88,Default,,0,0,0,,Мен бір жерде қалыпты өмір сүре алар едім.
Dialogue: 0,0:13:22.34,0:13:25.72,Default,,0,0,0,,Біз... Коросей...
Dialogue: 0,0:13:27.72,0:13:29.26,Default,,0,0,0,,Айтпақшы, Накамура мырза
Dialogue: 0,0:13:29.35,0:13:33.35,Default,,0,0,0,,Таудағы кескілескен шайқаста да сенің қадамың тынымсыз болды.
Dialogue: 0,0:13:33.43,0:13:36.94,Default,,0,0,0,,Ал... тәтті иісі бар сияқты ма?
Dialogue: 0,0:13:37.02,0:13:39.56,Default,,0,0,0,,Тозақ құлақтары бар тозақ мұрын
Dialogue: 0,0:13:39.65,0:13:43.03,Default,,0,0,0,,Бүгін айдың жарылғанына тура бір жыл болды, солай ма?
Dialogue: 0,0:13:43.11,0:13:45.40,Default,,0,0,0,,Мен Юкимура мырзаға сенімдімін
Dialogue: 0,0:13:43.11,0:13:45.40,Default,,0,0,0,,Аха~ Хахаха... Аха~
Dialogue: 0,0:13:45.40,0:13:45.49,Default,,0,0,0,,Аха~ Хахаха... Аха~
Dialogue: 0,0:13:45.49,0:13:48.82,Default,,0,0,0,,Аха~ Хахаха... Аха~
Dialogue: 0,0:13:45.49,0:13:48.82,Default,,0,0,0,,Бүгін Коро-сенсэйдің туған күні, солай ма?
Dialogue: 0,0:13:48.91,0:13:51.87,Default,,0,0,0,,Бұны бұзбай әкелу техникам
Dialogue: 0,0:13:51.95,0:13:53.16,Default,,0,0,0,,Мені мақтауларыңызды қалаймын.
Dialogue: 0,0:13:53.24,0:13:54.20,Default,,0,0,0,,Тыңдаңыз!
Dialogue: 0,0:13:54.29,0:13:58.46,Default,,0,0,0,,Өйткені... Өйткені! Бір аптада бірінші рет тәттілер
Dialogue: 0,0:13:58.54,0:14:00.79,Default,,0,0,0,,Әй, мен қазірдің өзінде ақшылдап жатырмын!
Dialogue: 0,0:14:00.88,0:14:02.63,Default,,0,0,0,,Барлығы ән айтады!
Dialogue: 0,0:14:03.75,0:14:05.09,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:05.17,0:14:09.30,Default,,0,0,0,,♪ Туған күнің құтты болсын
Dialogue: 0,0:14:09.39,0:14:10.14,Default,,0,0,0,,♪ Туған күнің құтты болсын
Dialogue: 0,0:14:10.14,0:14:12.35,Default,,0,0,0,,♪ Туған күнің құтты болсын
Dialogue: 0,0:14:10.14,0:14:12.35,Default,,0,0,0,,Ке! Қарғыс атсын, сен дайындадың...
Dialogue: 0,0:14:12.35,0:14:12.43,Default,,0,0,0,,♪ Туған күнің құтты болсын
Dialogue: 0,0:14:12.43,0:14:13.76,Default,,0,0,0,,♪ Туған күнің құтты болсын
Dialogue: 0,0:14:12.43,0:14:13.76,Default,,0,0,0,,Сізге
Dialogue: 0,0:14:13.85,0:14:20.40,Default,,0,0,0,,♪ Туған күніңмен Құрметті Короссей
Dialogue: 0,0:14:20.48,0:14:27.49,Default,,0,0,0,,♪ Туған күнің құтты болсын
Dialogue: 0,0:14:27.57,0:14:28.32,Default,,0,0,0,,Иә! (қол шапалақтау)
Dialogue: 0,0:14:28.32,0:14:30.03,Default,,0,0,0,,Иә! (қол шапалақтау)
Dialogue: 0,0:14:28.32,0:14:30.03,Default,,0,0,0,,Артық…
Dialogue: 0,0:14:30.11,0:14:32.03,Default,,0,0,0,,Хоора, үрле, Коросей!
Dialogue: 0,0:14:32.03,0:14:32.62,Default,,0,0,0,,Хоора, үрле, Коросей!
Dialogue: 0,0:14:32.03,0:14:32.62,Default,,0,0,0,,Бұл маңызды, себебі сізде тек біреуі ғана бар.
Dialogue: 0,0:14:32.62,0:14:32.70,Default,,0,0,0,,Сізде біреу ғана бар, сондықтан бұл маңызды.
Dialogue: 0,0:14:32.70,0:14:34.58,Default,,0,0,0,,Бір ғана бөтелке бар, сондықтан бұл маңызды.
Dialogue: 0,0:14:32.70,0:14:34.58,Default,,0,0,0,,Қандай жомарт марапат!
Dialogue: 0,0:14:34.58,0:14:36.37,Default,,0,0,0,,Қандай жомарт марапат!
Dialogue: 0,0:14:37.79,0:14:40.33,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:14:40.42,0:14:43.04,Default,,0,0,0,,(жарылғыш)
Dialogue: 0,0:14:49.63,0:14:51.34,Default,,0,0,0,,Туған күніңмен
Dialogue: 0,0:14:54.14,0:14:56.06,Default,,0,0,0,,- (Катаока) Ах... - (Терасака) Ши... жоқ...
Dialogue: 0,0:14:56.14,0:14:57.52,Default,,0,0,0,,Янагисава…
Dialogue: 0,0:14:57.60,0:14:59.64,Default,,0,0,0,,Уақыт пісіп қалды
Dialogue: 0,0:14:59.73,0:15:03.19,Default,,0,0,0,,Саған дүниедегі ең қатыгез өлімді берейін.
Dialogue: 0,0:15:04.06,0:15:07.53,Default,,0,0,0,,Ұстаз, менің кім екенімді білесіз.
Dialogue: 0,0:15:07.61,0:15:09.15,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:09.24,0:15:13.03,Default,,0,0,0,,Оны тағы да оқушыларыма таныстырып өтейін бе?
Dialogue: 0,0:15:13.12,0:15:17.41,Default,,0,0,0,,Сегізаяқтан «Өлім құдайы» деген есімді ұрлаған ол.
Dialogue: 0,0:15:18.00,0:15:19.66,Default,,0,0,0,,Және…
Dialogue: 0,0:15:22.75,0:15:26.92,Default,,0,0,0,,Бүгіннен бастап ол жаңа Коро-сенсей.
Dialogue: 0,0:15:27.67,0:15:32.80,Default,,0,0,0,,Ух...хехехехе...
Dialogue: 0,0:15:42.35,0:15:46.73,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:15:46.82,0:15:49.44,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:51.57,0:15:53.16,Default,,0,0,0,,Қош бол Сенсей
Dialogue: 0,0:15:53.24,0:15:55.16,Default,,0,0,0,,Сіз оны көрмедіңіз.
Dialogue: 0,0:15:57.28,0:15:58.37,Default,,0,0,0,,Менің бетім
Dialogue: 0,0:16:00.58,0:16:03.33,Default,,0,0,0,,Менің өнерім бар тағы бір адам болса
Dialogue: 0,0:16:03.42,0:16:05.58,Default,,0,0,0,,Қастандық ауқымы айтарлықтай кеңейді.
Dialogue: 0,0:16:06.75,0:16:10.55,Default,,0,0,0,,Сондықтан ол маған шәкірт боламын деп өтініш бергенде мен оны көтеріп алып өсірдім.
Dialogue: 0,0:16:11.38,0:16:13.84,Default,,0,0,0,,Ол билікке сүйсінген адам еді.
Dialogue: 0,0:16:13.93,0:16:17.01,Default,,0,0,0,,Сондықтан мен саған өзің қалаған билікті бердім.
Dialogue: 0,0:16:17.10,0:16:22.85,Default,,0,0,0,,Біз сондай-ақ адалдықты тәрбиелеу үшін биліктің абсолютті айырмашылығын көрсеттік.
Dialogue: 0,0:16:22.94,0:16:26.48,Default,,0,0,0,,Пайда мен қорқынышқа толы.
Dialogue: 0,0:16:27.40,0:16:30.19,Default,,0,0,0,,Сатқындық элементі болмаса керек...
Dialogue: 0,0:16:33.53,0:16:37.03,Default,,0,0,0,,Мұғалім! Бұл жұмыс үшін кіру жолы.
Dialogue: 0,0:16:37.12,0:16:40.66,Default,,0,0,0,,Шығыс қақпадан қауіпсіздік аз емес пе?
Dialogue: 0,0:16:40.74,0:16:44.62,Default,,0,0,0,,Маған қалдырсаңыз, мен инфильтрацияны реттеймін!
Dialogue: 0,0:16:44.71,0:16:47.08,Default,,0,0,0,,Иә, өзгерістер жоқ.
Dialogue: 0,0:16:47.17,0:16:50.00,Default,,0,0,0,,Жоспарланғандай, мен осы жерден шарлауды сұрадым.
Dialogue: 0,0:16:50.09,0:16:50.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:53.67,0:16:57.55,Default,,0,0,0,,Мұғалім! Мен өте өлімге әкелетін пышақ техникасын ойладым.
Dialogue: 0,0:16:57.64,0:16:59.85,Default,,0,0,0,,Бұл екі семсерді қолданған кездегі өзгеріс...
Dialogue: 0,0:16:59.93,0:17:00.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:01.43,0:17:03.81,Default,,0,0,0,,Иә, ол жұмыс істемейді.
Dialogue: 0,0:17:03.89,0:17:06.60,Default,,0,0,0,,Жұмысыңыздың тәуекелін арттырғыңыз келмесе
Dialogue: 0,0:17:06.69,0:17:09.31,Default,,0,0,0,,Алдымен біз үйреткен дағдыларды меңгерейік.
Dialogue: 0,0:17:09.40,0:17:10.40,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:15.86,0:17:18.49,Default,,0,0,0,,Бірдеңе жетіспейтін сияқты.
Dialogue: 0,0:17:19.66,0:17:24.04,Default,,0,0,0,,Ол кезде мен ештеңе білмедім
Dialogue: 0,0:17:24.12,0:17:26.46,Default,,0,0,0,,Мүмкін студент
Dialogue: 0,0:17:26.54,0:17:29.75,Default,,0,0,0,,Мен жай ғана көргім келді.
Dialogue: 0,0:17:30.54,0:17:34.97,Default,,0,0,0,,Мен сенің бірінші шәкіртіңмін...
Dialogue: 0,0:17:35.05,0:17:37.55,Default,,0,0,0,,Мен іздеген жоқпын...
Dialogue: 0,0:17:42.68,0:17:47.44,Default,,0,0,0,,Янагисава... Мен оның осы уақытта келеді деп күтпедім...
Dialogue: 0,0:17:47.52,0:17:49.61,Default,,0,0,0,,Сіздің схемаларыңыздан?
Dialogue: 0,0:17:49.69,0:17:51.65,Default,,0,0,0,,Енді нақты шайқас деректері
Dialogue: 0,0:17:51.73,0:17:54.07,Default,,0,0,0,,Нысананың мәйітін қалпына келтіруге бола ма?
Dialogue: 0,0:17:54.15,0:17:57.32,Default,,0,0,0,,Егер бізде біреу болса, терроризмге қарсы соғыс аяқталады.
Dialogue: 0,0:17:57.40,0:18:00.95,Default,,0,0,0,,Өлтіруге болмайтын жеңілмейтін тіршілік иесі
Dialogue: 0,0:18:01.03,0:18:02.99,Default,,0,0,0,,Мен оны тәжірибеде қолданғым келеді.
Dialogue: 0,0:18:03.08,0:18:05.75,Default,,0,0,0,,Еліміздің шынайы ниеті осы болса керек.
Dialogue: 0,0:18:06.58,0:18:07.46,Default,,0,0,0,,Бұл...
Dialogue: 0,0:18:08.33,0:18:10.54,Default,,0,0,0,,Бұл ма?
Dialogue: 0,0:18:10.63,0:18:15.26,Default,,0,0,0,,- (Екінші Шинигами) Хахахаха... - (Нагиса) Екінші Шинигами бізге шабуыл жасады...
Dialogue: 0,0:18:15.34,0:18:17.93,Default,,0,0,0,,Бұрын бұл жай ғана жүз болатын.
Dialogue: 0,0:18:18.01,0:18:20.22,Default,,0,0,0,,Сенің бүкіл денең құбыжық болып кетті!
Dialogue: 0,0:18:20.30,0:18:24.64,Default,,0,0,0,,Жаңа ғана сол сегізаяқ сияқты модификацияларды жасадым.
Dialogue: 0,0:18:24.72,0:18:26.35,Default,,0,0,0,,Айырмашылығы мынада
Dialogue: 0,0:18:26.43,0:18:30.56,Default,,0,0,0,,Ол бұл өзгертуді өз өтініші бойынша жасады.
Dialogue: 0,0:18:30.65,0:18:34.40,Default,,0,0,0,,Біліксіз Итонаның менің жеңгемнен айырмашылығы бар
Dialogue: 0,0:18:34.48,0:18:35.78,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:35.86,0:18:38.40,Default,,0,0,0,,Елестете аласыз ба?
Dialogue: 0,0:18:38.49,0:18:42.78,Default,,0,0,0,,Адам болған соң да, өзіңді жалғыз өзі басып алған адам болды.
Dialogue: 0,0:18:42.87,0:18:45.83,Default,,0,0,0,,Теңдесі жоқ шатырлар мен жек көрушілікке ие болды.
Dialogue: 0,0:18:45.91,0:18:47.91,Default,,0,0,0,,Оның жойқын күші...
Dialogue: 0,0:18:48.50,0:18:49.62,Default,,0,0,0,,- (Екінші Шинигами) Өл! - (Коросей) Қаш!
Dialogue: 0,0:18:50.71,0:18:51.63,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:51.71,0:18:55.71,Default,,0,0,0,,Нюоооооо...
Dialogue: 0,0:18:55.80,0:18:57.17,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:57.26,0:18:58.67,Default,,0,0,0,,Соникалық бум
Dialogue: 0,0:18:58.76,0:19:02.14,Default,,0,0,0,,Оның шатырларының бастапқы жылдамдығы Мах 2.
Dialogue: 0,0:19:02.22,0:19:05.60,Default,,0,0,0,,Максималды лездік жылдамдық... 40 Mach
Dialogue: 0,0:19:05.68,0:19:07.64,Default,,0,0,0,,Мах... 40 Mach!?
Dialogue: 0,0:19:07.72,0:19:10.81,Default,,0,0,0,,Қысқасы, негізгі өнімділік екі еселенеді.
Dialogue: 0,0:19:10.89,0:19:14.06,Default,,0,0,0,,Екінші ұрпақтың адамнан тыс динамикалық көзқарасы мен түйсігі болып табылады
Dialogue: 0,0:19:10.89,0:19:14.06,Default,,0,0,0,,(Коросейдің айқайы)
Dialogue: 0,0:19:14.06,0:19:14.15,Default,,0,0,0,,(Коросейдің айқайы)
Dialogue: 0,0:19:14.15,0:19:16.15,Default,,0,0,0,,(Коросейдің айқайы)
Dialogue: 0,0:19:14.15,0:19:16.15,Default,,0,0,0,,Шатырлар арқылы күшейтілген
Dialogue: 0,0:19:16.23,0:19:19.65,Default,,0,0,0,,Дыбыстан жоғары әлемге оңай бейімделген
Dialogue: 0,0:19:19.74,0:19:24.45,Default,,0,0,0,,Әуесқой балалардан айырмашылығы олар шатырға тез үйреніп кетті.
Dialogue: 0,0:19:24.53,0:19:27.58,Default,,0,0,0,,Дәл сол жердегі бірінші буын сияқты
Dialogue: 0,0:19:27.66,0:19:28.75,Default,,0,0,0,,- (Коро-сенсэй) Арх! -(Нагиса) Коро-сенсэй!
Dialogue: 0,0:19:29.41,0:19:32.58,Default,,0,0,0,,Ең үлкен айырмашылық сол сегізаяқ пен сендердің араларыңда.
Dialogue: 0,0:19:32.67,0:19:36.92,Default,,0,0,0,,Үздіксіз жұмыс істеуді ескермей, шатырдың дизайны
Dialogue: 0,0:19:37.00,0:19:38.05,Default,,0,0,0,,Қысқасы, ол
Dialogue: 0,0:19:38.13,0:19:41.68,Default,,0,0,0,,Техникалық қызмет көрсету қажет емес Бір реттік
Dialogue: 0,0:19:41.76,0:19:44.18,Default,,0,0,0,,Өмір сүру ұзақтығы 3 айдан аз
Dialogue: 0,0:19:44.26,0:19:46.51,Default,,0,0,0,,Мен оны орасан зор энергия алу үшін реттей алдым.
Dialogue: 0,0:19:46.51,0:19:48.31,Default,,0,0,0,,Мен оны орасан зор энергия алу үшін реттей алдым.
Dialogue: 0,0:19:46.51,0:19:48.31,Default,,0,0,0,,(Коросейдің айқайы)
Dialogue: 0,0:19:48.31,0:19:48.39,Default,,0,0,0,,(Коросейдің айқайы)
Dialogue: 0,0:19:48.39,0:19:52.35,Default,,0,0,0,,(Коросейдің айқайы)
Dialogue: 0,0:19:48.39,0:19:52.35,Default,,0,0,0,,Өлсе де жарылу қаупі жоқ.
Dialogue: 0,0:19:52.44,0:19:56.57,Default,,0,0,0,,Хахаха... Қауіпсіз және мінсіз қару емес пе?
Dialogue: 0,0:19:56.65,0:19:58.15,Default,,0,0,0,,Дәл солай, әрқашан...
Dialogue: 0,0:19:58.23,0:19:59.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:59.15,0:20:03.95,Default,,0,0,0,,Тек басқаларға... қауіпсіз жерден зиян келтіріңіз!
Dialogue: 0,0:20:05.20,0:20:07.33,Default,,0,0,0,,Сіз солай ойлайсыз ба?
Dialogue: 0,0:20:09.91,0:20:11.16,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:13.04,0:20:18.17,Default,,0,0,0,,Мен өлуге дайын емеспін деп ойлайсың ба?
Dialogue: 0,0:20:18.25,0:20:20.34,Default,,0,0,0,,Эй, бұл...
Dialogue: 0,0:20:20.42,0:20:21.26,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:20:22.63,0:20:25.76,Default,,0,0,0,,Өмір енді маңызды емес
Dialogue: 0,0:20:26.80,0:20:30.68,Default,,0,0,0,,Менен бәрін тартып алған сені өлтірсем ғой...
Dialogue: 0,0:20:30.77,0:20:31.68,Default,,0,0,0,,(жүрек соғысы)
Dialogue: 0,0:20:31.68,0:20:34.73,Default,,0,0,0,,(жүрек соғысы)
Dialogue: 0,0:20:31.68,0:20:34.73,Default,,0,0,0,,Буындар Бұлшық ет талшықтары Жұлын нервтері
Dialogue: 0,0:20:34.81,0:20:38.90,Default,,0,0,0,,Бүкіл денеңізде болмаса да, маңызды жерлерге аз-аздап шандырлар енгізсеңіз.
Dialogue: 0,0:20:38.98,0:20:42.57,Default,,0,0,0,,Адамдық функцияларды сақтай отырып, адамнан жоғары адам болыңыз
Dialogue: 0,0:20:43.53,0:20:45.41,Default,,0,0,0,,Қатыгездікпен өл, теңіз шошқасы!
Dialogue: 0,0:20:45.49,0:20:46.74,Default,,0,0,0,,Не!
Dialogue: 0,0:20:46.82,0:20:50.83,Default,,0,0,0,,Сүйікті шәкіртіме өшпес із қалдыру.
Dialogue: 0,0:20:52.41,0:20:53.46,Default,,0,0,0,,Не!
Dialogue: 0,0:20:54.71,0:20:56.50,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:56.58,0:20:58.09,Default,,0,0,0,,- (Коросенсей) Барлығы - (Фува/Мурамацу) Ах...
Dialogue: 0,0:20:59.00,0:21:03.05,Default,,0,0,0,,Мен бұрын сабақта айтуды ұмытып кеткен бір нәрсе бар.
Dialogue: 0,0:21:03.97,0:21:08.01,Default,,0,0,0,,Қанішер майдандағы шайқастан қаншалықты шебер қашса да,
Dialogue: 0,0:21:08.10,0:21:11.14,Default,,0,0,0,,Өмірдің белгілі бір кездері
Dialogue: 0,0:21:11.22,0:21:15.23,Default,,0,0,0,,Бар күшіңмен күресуге тура келетін кездер болады.
Dialogue: 0,0:21:16.56,0:21:18.94,Default,,0,0,0,,Мұғалімдерге...
Dialogue: 0,0:21:19.02,0:21:21.32,Default,,0,0,0,,Қазір!
Dialogue: 0,0:21:25.99,0:21:30.99,Default,,0,0,0,,♪～
Dialogue: 0,0:22:49.86,0:22:54.87,Default,,0,0,0,,～♪
