Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.96,0:00:03.79,Default,,0,0,0,,Бар болғаны 0,1 грамм
Dialogue: 0,0:00:03.87,0:00:07.79,Default,,0,0,0,,Ядролық бомбаға эквивалентті энергия бөлетін «Антизат».
Dialogue: 0,0:00:08.29,0:00:09.75,Default,,0,0,0,,Бөлшектің үдеу циклі
Dialogue: 0,0:00:09.84,0:00:11.59,Default,,0,0,0,,Тірі организмдерге қосылу арқылы
Dialogue: 0,0:00:11.67,0:00:13.97,Default,,0,0,0,,Үздіксіз ұрпақты не мүмкін етті
Dialogue: 0,0:00:14.05,0:00:16.76,Default,,0,0,0,,Бұл профессор Янагисаваның зерттеуі болды.
Dialogue: 0,0:00:17.47,0:00:20.14,Default,,0,0,0,,Аты аңызға айналған өлтіруші «Қасқыр орақ»
Dialogue: 0,0:00:20.22,0:00:23.35,Default,,0,0,0,,Мен күн сайын сол адам тәжірибесіне ұшырадым.
Dialogue: 0,0:00:23.85,0:00:27.31,Default,,0,0,0,,Оның денесінде антизат энергиясы айнала бастады.
Dialogue: 0,0:00:27.40,0:00:28.73,Default,,0,0,0,,Дене ұлпасы
Dialogue: 0,0:00:28.82,0:00:31.15,Default,,0,0,0,,Күшті және икемді материал композициясына
Dialogue: 0,0:00:31.23,0:00:32.99,Default,,0,0,0,,ауыстырылды
Dialogue: 0,0:00:33.07,0:00:35.66,Default,,0,0,0,,Янагисава оны «шатырлар» деп атады.
Dialogue: 0,0:00:35.74,0:00:38.16,Default,,0,0,0,,Қорқыныш Ұстамдылық платформасын күшейту
Dialogue: 0,0:00:38.66,0:00:42.95,Default,,0,0,0,,Қауіпті бақылау Агури Юкимураға тапсырылды.
Dialogue: 0,0:00:43.04,0:00:45.17,Default,,0,0,0,,Және ол білді
Dialogue: 0,0:00:45.25,0:00:48.00,Default,,0,0,0,,Өлім құдайы да өзінің шын атын біледі
Dialogue: 0,0:00:48.08,0:00:50.38,Default,,0,0,0,,Туған күнің туралы не білмейтін
Dialogue: 0,0:00:50.46,0:00:52.59,Default,,0,0,0,,Жылы сөз, күлкі
Dialogue: 0,0:00:52.67,0:00:55.59,Default,,0,0,0,,Қастандық үшін білгенімнің бәрі
Dialogue: 0,0:00:55.68,0:00:57.93,Default,,0,0,0,,Ол да білді
Dialogue: 0,0:00:58.01,0:01:00.43,Default,,0,0,0,,Оның күйеуі Янагисава екеуінің арасында
Dialogue: 0,0:01:00.51,0:01:03.06,Default,,0,0,0,,Махаббатқа қатысы жоқ
Dialogue: 0,0:01:03.14,0:01:07.27,Default,,0,0,0,,Актерлік өнерге құмар қарындасы бар
Dialogue: 0,0:01:07.35,0:01:11.23,Default,,0,0,0,,Танысқанымызға бір жылға жуықтап қалды.
Dialogue: 0,0:01:11.32,0:01:12.94,Default,,0,0,0,,Бір күні осында
Dialogue: 0,0:01:13.03,0:01:16.40,Default,,0,0,0,,Екі адам сөйлесетін кеңістікке айналды.
Dialogue: 0,0:01:27.58,0:01:29.00,Default,,0,0,0,,-Ой, дұрыс! - (Шинигами) Иә?
Dialogue: 0,0:01:29.08,0:01:31.50,Default,,0,0,0,,Мен бүгін сатып алған жаңа ішкі киімді қара.
Dialogue: 0,0:01:31.59,0:01:33.51,Default,,0,0,0,,Сіз өкінбейсіз.
Dialogue: 0,0:01:33.59,0:01:36.59,Default,,0,0,0,,Дәмсіз киіммен әйелді қайтадан кемсітудің қажеті жоқ...
Dialogue: 0,0:01:36.67,0:01:39.76,Default,,0,0,0,,Jajaan Demon өрнегі түтік үсті!
Dialogue: 0,0:01:39.84,0:01:41.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:39.84,0:01:41.22,Default,,0,0,0,,Бұл сәл қатал, бірақ сіздің талғамыңыз жақсы, солай емес пе?
Dialogue: 0,0:01:41.22,0:01:43.72,Default,,0,0,0,,Бұл сәл қатал, бірақ сіздің талғамыңыз жақсы, солай емес пе?
Dialogue: 0,0:01:43.81,0:01:47.06,Default,,0,0,0,,...
Dialogue: 0,0:01:47.14,0:01:49.06,Default,,0,0,0,,Нфуфуфуфуфу…
Dialogue: 0,0:01:49.15,0:01:50.19,Default,,0,0,0,,Ум...
Dialogue: 0,0:01:50.27,0:01:51.94,Default,,0,0,0,,Бұл шынымен біртүрлі ме?
Dialogue: 0,0:01:52.02,0:01:52.48,Default,,0,0,0,,Ха, жоқ!
Dialogue: 0,0:01:52.48,0:01:53.73,Default,,0,0,0,,Ха, жоқ!
Dialogue: 0,0:01:52.48,0:01:53.73,Default,,0,0,0,,Мен жай ғана сүйкімді деп ойладым...
Dialogue: 0,0:01:53.73,0:01:53.82,Default,,0,0,0,,Мен оны сүйкімді деп ойладым...
Dialogue: 0,0:01:53.82,0:01:55.28,Default,,0,0,0,,Мен оны сүйкімді деп ойладым...
Dialogue: 0,0:01:53.82,0:01:55.28,Default,,0,0,0,,Уф, бұл...
Dialogue: 0,0:01:55.36,0:01:58.07,Default,,0,0,0,,Тәжірибе әсерінен болады деп күтпедім...
Dialogue: 0,0:01:58.15,0:02:01.53,Default,,0,0,0,,Хехе, Тентакл мырза шыншыл екен.
Dialogue: 0,0:02:01.62,0:02:02.74,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:02:02.83,0:02:05.25,Default,,0,0,0,,Кез келген пішінге өзгеретін қол
Dialogue: 0,0:02:05.33,0:02:09.00,Default,,0,0,0,,Мүмкін бұл сіз болғыңыз келетін адамды көрсететін айна шығар
Dialogue: 0,0:02:09.08,0:02:10.25,Default,,0,0,0,,Менікі ме?
Dialogue: 0,0:02:10.33,0:02:13.71,Default,,0,0,0,,Бейбіт заманда дүниеге келсең
Dialogue: 0,0:02:13.80,0:02:17.67,Default,,0,0,0,,Ол ақылды болғанымен, ол аздап тентек және оның бір жері бар.
Dialogue: 0,0:02:17.76,0:02:19.63,Default,,0,0,0,,Шыдамсыздық немесе қыңыр болу
Dialogue: 0,0:02:19.72,0:02:24.47,Default,,0,0,0,,Мен шынайы, мейірімді күлімсіреген адамға айналдым.
Dialogue: 0,0:02:25.47,0:02:26.85,Default,,0,0,0,,Сен Риппелді қалағанша басқара алатындайша жаттығу жасауың керек—
Dialogue: 0,0:02:29.56,0:02:32.19,Default,,0,0,0,,Акари, мен бүгін кешке аздап бос боламын деп ойлаймын.
Dialogue: 0,0:02:32.27,0:02:33.77,Default,,0,0,0,,Азық-түлік туралы не айтасыз?
Dialogue: 0,0:02:33.86,0:02:35.53,Default,,0,0,0,,Одан да көп, апа.
Dialogue: 0,0:02:35.61,0:02:38.82,Default,,0,0,0,,Оның даусы біртүрлі жарқын, бірақ маған ұнайтын адаммен мұны істей алар ма екен?
Dialogue: 0,0:02:38.90,0:02:42.16,Default,,0,0,0,,Не? Не? Мен құдамын ба?
Dialogue: 0,0:02:42.24,0:02:43.78,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:02:43.87,0:02:47.00,Default,,0,0,0,,Тек сырттай жақсы көретін озбыр адамнан бас тарт.
Dialogue: 0,0:02:47.08,0:02:47.95,Default,,0,0,0,,Адамдар…
Dialogue: 0,0:02:48.04,0:02:49.16,Default,,0,0,0,,Толық түсінгенім жоқ, бірақ—
Dialogue: 0,0:02:49.25,0:02:51.88,Default,,0,0,0,,Мен де әпкем қызығатын адам туралы естігім келеді.
Dialogue: 0,0:02:51.96,0:02:53.38,Default,,0,0,0,,Жарайсың ба?
Dialogue: 0,0:02:53.46,0:02:54.92,Default,,0,0,0,,Иә, тамақ үшін рахмет!
Dialogue: 0,0:02:55.00,0:02:56.21,Default,,0,0,0,,Қазірдің өзінде...
Dialogue: 0,0:02:58.05,0:02:59.42,Default,,0,0,0,,Сыйлық па?
Dialogue: 0,0:02:59.51,0:03:03.14,Default,,0,0,0,,Иә, мойын суып кетеді дедіңіз.
Dialogue: 0,0:03:03.22,0:03:06.39,Default,,0,0,0,,Бұл кең ауқымды қамтиды және стильді.
Dialogue: 0,0:03:06.47,0:03:07.89,Default,,0,0,0,,Сәлеметсіз бе...
Dialogue: 0,0:03:07.97,0:03:10.10,Default,,0,0,0,,Мен сізге ұнамайтынын түсіндім.
Dialogue: 0,0:03:10.18,0:03:11.60,Default,,0,0,0,,Жоқ
Dialogue: 0,0:03:11.69,0:03:14.61,Default,,0,0,0,,Бұл кенеттен неге сыйлық болды деп ойлаймын...
Dialogue: 0,0:03:15.11,0:03:18.11,Default,,0,0,0,,Бүгін сенімен танысқаныма тура бір жыл болды.
Dialogue: 0,0:03:18.61,0:03:22.82,Default,,0,0,0,,Туған күніңді білмесең, неге бүгінгі күнді атамасқа?
Dialogue: 0,0:03:22.91,0:03:23.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:24.49,0:03:26.83,Default,,0,0,0,,Маған көп әңгіме айтып бергеніңіз үшін рахмет.
Dialogue: 0,0:03:26.91,0:03:29.20,Default,,0,0,0,,Мен көп кеңес алдым.
Dialogue: 0,0:03:29.87,0:03:33.71,Default,,0,0,0,,Менімен кездескеніңіз үшін рахмет ретінде сізге туған күніңізді беруге рұқсат етіңіз.
Dialogue: 0,0:03:36.54,0:03:37.80,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:03:38.30,0:03:40.67,Default,,0,0,0,,Жақсы
Dialogue: 0,0:03:41.17,0:03:43.47,Default,,0,0,0,,Бірақ мен саған мұны бере алмаймын.
Dialogue: 0,0:03:43.55,0:03:46.30,Default,,0,0,0,,Бұл қабырға бар болғанша...
Dialogue: 0,0:03:46.39,0:03:47.68,Default,,0,0,0,,Юкине-кун, барсың ба?
Dialogue: 0,0:03:47.76,0:03:49.72,Default,,0,0,0,,Оқытуды тоқтату
Dialogue: 0,0:03:49.81,0:03:52.94,Default,,0,0,0,,Янагисава мырза мені осында толық күнді жұмыс істеуімді сұрады...
Dialogue: 0,0:03:54.69,0:03:58.78,Default,,0,0,0,,Соңында Е сыныбының оқушыларының көпшілігінің көз алдында I
Dialogue: 0,0:03:58.86,0:04:01.40,Default,,0,0,0,,Жарықты жағу мүмкін болмады
Dialogue: 0,0:04:02.11,0:04:03.91,Default,,0,0,0,,Тіпті қазіргі балаларға...
Dialogue: 0,0:04:03.99,0:04:08.58,Default,,0,0,0,,Мен әлі жетілмегенмін... Сонда да...
Dialogue: 0,0:04:09.70,0:04:13.67,Default,,0,0,0,,Бірақ! Менің оқушыларымның барлығы өте жақсы балалар!
Dialogue: 0,0:04:13.75,0:04:17.46,Default,,0,0,0,,Әр адам бірегей, байсалды, таза!
Dialogue: 0,0:04:18.21,0:04:21.84,Default,,0,0,0,,Сондықтан мен бәріне көмектескім келеді
Dialogue: 0,0:04:22.34,0:04:26.05,Default,,0,0,0,,Бұл жұмыс... бәріне ұнайды...
Dialogue: 0,0:04:28.10,0:04:29.89,Default,,0,0,0,,-Шинигами-сан-(Шинигами) Ах...
Dialogue: 0,0:04:30.39,0:04:32.27,Default,,0,0,0,,Мен саған тиіскім келеді
Dialogue: 0,0:04:32.35,0:04:34.89,Default,,0,0,0,,Мені қолдаған сенен
Dialogue: 0,0:04:34.98,0:04:39.69,Default,,0,0,0,,Маған соңғы жылы қолымнан келгеннің бәрін істеуге күш бергеніңізді қалаймын.
Dialogue: 0,0:04:48.53,0:04:49.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:50.91,0:04:52.75,Default,,0,0,0,,Өтірік күлімсіреу
Dialogue: 0,0:04:52.83,0:04:55.96,Default,,0,0,0,,Мен білмей тұрып, менде шынайы күлімсіреп қалды.
Dialogue: 0,0:04:58.04,0:04:58.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:02.88,0:05:04.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:10.01,0:05:11.22,Default,,0,0,0,,Жарайды
Dialogue: 0,0:05:11.72,0:05:13.31,Default,,0,0,0,,Сіз мұны істей аласыз
Dialogue: 0,0:05:16.06,0:05:17.27,Default,,0,0,0,,Иә
Dialogue: 0,0:05:17.35,0:05:19.86,Default,,0,0,0,,Олар бір-біріне бірінші рет тиді
Dialogue: 0,0:05:20.36,0:05:23.82,Default,,0,0,0,,Ай туылғанға дейін 3 сағат бұрын
Dialogue: 0,0:05:24.32,0:05:26.95,Default,,0,0,0,,(тінтуір шуы)
Dialogue: 0,0:05:24.32,0:05:26.95,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:05:26.95,0:05:27.03,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:05:27.03,0:05:28.16,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:05:27.03,0:05:28.16,Default,,0,0,0,,(айқайлау)
Dialogue: 0,0:05:31.45,0:05:33.16,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:05:45.80,0:05:47.01,Default,,0,0,0,,Ай?
Dialogue: 0,0:05:47.09,0:05:50.26,Default,,0,0,0,,Иә! 70% жоғалады
Dialogue: 0,0:05:50.35,0:05:52.72,Default,,0,0,0,,Айдағы тәжірибелік тышқандардың антиматериялық энергиясы
Dialogue: 0,0:05:52.81,0:05:53.93,Default,,0,0,0,,Шығарылған сияқты!
Dialogue: 0,0:05:54.02,0:05:57.89,Default,,0,0,0,,Жасушаның бөлінуі шегінен асып кетті ме?
Dialogue: 0,0:05:54.02,0:05:57.89,Default,,0,0,0,,(Endeavour) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,0:05:57.98,0:06:01.77,Default,,0,0,0,,Циклды адамдармен ауыстырыңыз және ағымдағы құбылыс болатын күнді есептеңіз!
Dialogue: 0,0:06:01.86,0:06:02.73,Default,,0,0,0,,Га
Dialogue: 0,0:06:02.82,0:06:04.86,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,0:06:04.94,0:06:08.65,Default,,0,0,0,,Бұл шықты! Келесі жылдың 13 наурызы.
Dialogue: 0,0:06:08.74,0:06:11.95,Default,,0,0,0,,Міне, сен де, жер де жойылатын күн.
Dialogue: 0,0:06:12.03,0:06:13.16,Default,,0,0,0,,Ха…
Dialogue: 0,0:06:13.24,0:06:15.29,Default,,0,0,0,,Бастық, сіз қалай ойлайсыз?
Dialogue: 0,0:06:15.37,0:06:19.04,Default,,0,0,0,,Оны өлтіру туралы шешім қабылданды.
Dialogue: 0,0:06:19.12,0:06:21.96,Default,,0,0,0,,Жүрек тоқтап тұрғанда еш қиындық жоқ.
Dialogue: 0,0:06:22.04,0:06:24.21,Default,,0,0,0,,АҚШ-тың бас кеңсесіне дереу хабарласыңыз!
Dialogue: 0,0:06:24.30,0:06:25.92,Default,,0,0,0,,Иә! (Зерттеушілердің үрейлі дауыстары)
Dialogue: 0,0:06:27.84,0:06:32.01,Default,,0,0,0,,Менің қарғыс атанып өлетінім табиғи нәрсе.
Dialogue: 0,0:06:32.10,0:06:34.60,Default,,0,0,0,,Үмітіңізді үзбеңіз! Қалай көмектесуге болады...
Dialogue: 0,0:06:34.68,0:06:36.14,Default,,0,0,0,,- (Шинигами) Бірақ - Ах...
Dialogue: 0,0:06:36.22,0:06:38.48,Default,,0,0,0,,Мен ұзақ уақыт алған бұл күш...
Dialogue: 0,0:06:38.56,0:06:39.94,Default,,0,0,0,,Ха…
Dialogue: 0,0:06:40.02,0:06:42.48,Default,,0,0,0,,Қош бол Агури
Dialogue: 0,0:06:42.56,0:06:43.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:43.52,0:06:45.65,Default,,0,0,0,,Мен осы жерден кетемін
Dialogue: 0,0:06:45.73,0:06:49.82,Default,,0,0,0,,Жоспарланған уақыттан әлі ертерек, бірақ мен жеткілікті қуат алдым.
Dialogue: 0,0:06:50.32,0:06:51.66,Default,,0,0,0,,Осы деңгейдегі нысандар және т.б.
Dialogue: 0,0:06:51.74,0:06:54.24,Default,,0,0,0,,Жоқ! Бұл қазірдің өзінде жаман ...
Dialogue: 0,0:06:54.33,0:06:56.16,Default,,0,0,0,,Мен әрқашан сенімен бірге боламын!
Dialogue: 0,0:06:56.24,0:06:57.37,Default,,0,0,0,,Сіз тоқтауды жоспарлап отырсыз ба?
Dialogue: 0,0:06:57.45,0:06:58.41,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:58.50,0:07:01.46,Default,,0,0,0,,Сіз? Қалай?
Dialogue: 0,0:07:01.54,0:07:04.04,Default,,0,0,0,,Сол қолмен? Сол мимен бе?
Dialogue: 0,0:07:04.13,0:07:05.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:05.59,0:07:08.09,Default,,0,0,0,,Менен артық қабілетің болмаса...
Dialogue: 0,0:07:08.17,0:07:12.26,Default,,0,0,0,,Сіз мені тоқтата алмайсыз немесе құтқара алмайсыз.
Dialogue: 0,0:07:12.34,0:07:15.89,Default,,0,0,0,,Сен тіпті барымтаға да лайық емессің.
Dialogue: 0,0:07:15.97,0:07:19.18,Default,,0,0,0,,Босқа өлгенше кеткеніңіз жөн.
Dialogue: 0,0:07:19.27,0:07:20.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:28.99,0:07:33.61,Default,,0,0,0,,Бұл Юкимура, бірінші есікті ашыңыз.
Dialogue: 0,0:07:34.12,0:07:39.00,Default,,0,0,0,,Сізде басқа туыстарыңыз жоқ па?
Dialogue: 0,0:07:39.08,0:07:41.83,Default,,0,0,0,,Көріп көрейік
Dialogue: 0,0:07:41.91,0:07:44.58,Default,,0,0,0,,Азаптауға шыдап алған күш!
Dialogue: 0,0:07:48.75,0:07:50.21,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:07:48.75,0:07:50.21,Default,,0,0,0,,(Endeavour) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,0:07:50.21,0:07:50.30,Default,,0,0,0,,(Endeavour) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,0:07:50.30,0:07:51.84,Default,,0,0,0,,(Endeavour) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,0:07:50.30,0:07:51.84,Default,,0,0,0,,Қауіпсіздік жүйесіне не болды?
Dialogue: 0,0:07:51.84,0:07:51.92,Default,,0,0,0,,(Endeavour) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,0:07:51.92,0:07:52.72,Default,,0,0,0,,(Endeavour) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,0:07:51.92,0:07:52.72,Default,,0,0,0,,Бұл жұмыс істемейді
Dialogue: 0,0:07:52.72,0:07:54.22,Default,,0,0,0,,Бұл жұмыс істемейді
Dialogue: 0,0:07:54.30,0:07:55.68,Default,,0,0,0,,Инъекция порты күшті шырыш...
Dialogue: 0,0:07:55.76,0:07:57.35,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:57.85,0:07:59.39,Default,,0,0,0,,Янагисаваға рахмет
Dialogue: 0,0:07:59.39,0:08:00.27,Default,,0,0,0,,Янагисаваға рахмет
Dialogue: 0,0:07:59.39,0:08:00.27,Default,,0,0,0,,Ах
Dialogue: 0,0:08:00.35,0:08:03.64,Default,,0,0,0,,Сенің арқаңда мен жеңілмейтін денеге ие болдым.
Dialogue: 0,0:08:03.73,0:08:06.52,Default,,0,0,0,,Тіпті менің жетекшім болса да.
Dialogue: 0,0:08:07.57,0:08:10.78,Default,,0,0,0,,Сонымен сіз экспериментті басқардыңыз!
Dialogue: 0,0:08:10.86,0:08:13.11,Default,,0,0,0,,Котаро-сан! оған көмектес
Dialogue: 0,0:08:13.20,0:08:14.11,Default,,0,0,0,,Егер біз оны қусақ, біз…
Dialogue: 0,0:08:14.20,0:08:15.36,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:14.20,0:08:15.36,Default,,0,0,0,,Мына ақымақ!
Dialogue: 0,0:08:15.36,0:08:16.24,Default,,0,0,0,,Мына ақымақ!
Dialogue: 0,0:08:16.24,0:08:16.57,Default,,0,0,0,,Мына ақымақ!
Dialogue: 0,0:08:16.24,0:08:16.57,Default,,0,0,0,,(Агридің ыңырануы)
Dialogue: 0,0:08:16.57,0:08:16.66,Default,,0,0,0,,(Агридің ыңырсыуы)
Dialogue: 0,0:08:16.66,0:08:18.66,Default,,0,0,0,,(Агридің ыңырануы)
Dialogue: 0,0:08:16.66,0:08:18.66,Default,,0,0,0,,Адам көрсең, құйрығыңды бұлға!
Dialogue: 0,0:08:18.66,0:08:18.74,Default,,0,0,0,,(Агридің ыңырсыуы)
Dialogue: 0,0:08:18.74,0:08:21.58,Default,,0,0,0,,(Агридің ыңырсыуы)
Dialogue: 0,0:08:18.74,0:08:21.58,Default,,0,0,0,,Маған жасаған жақсылығын ұмытуға қалай дәтің бар!
Dialogue: 0,0:08:21.66,0:08:24.00,Default,,0,0,0,,- (Янагисава) Сен және ол! -Уф
Dialogue: 0,0:08:24.08,0:08:26.67,Default,,0,0,0,,Ей, сақшыларды жина!
Dialogue: 0,0:08:26.75,0:08:28.59,Default,,0,0,0,,Оған шабуыл жасаңыз!
Dialogue: 0,0:08:34.76,0:08:37.01,Default,,0,0,0,,Фигураға мінбе, теңіз шошқасы
Dialogue: 0,0:08:37.09,0:08:41.47,Default,,0,0,0,,Менің ойымша, біз жай ғана эксперимент жасадық.
Dialogue: 0,0:08:51.86,0:08:52.99,Default,,0,0,0,,Ат!
Dialogue: 0,0:08:56.16,0:08:58.12,Default,,0,0,0,,Егер сіз жай ғана қолқаны бұзсаңыз...
Dialogue: 0,0:08:58.20,0:08:59.41,Default,,0,0,0,,Уау
Dialogue: 0,0:08:59.49,0:09:01.87,Default,,0,0,0,,Бір түйір құм жеткілікті
Dialogue: 0,0:09:01.95,0:09:03.58,Default,,0,0,0,,(Ер адам) Қатты кісі келе жатыр! (Әйел) Көмектесіңіз! Мені өлтірмекші!
Dialogue: 0,0:09:03.66,0:09:07.04,Default,,0,0,0,,Балалар, сендер мұны кез келген уақытта істей аласыңдар.
Dialogue: 0,0:09:08.42,0:09:09.63,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:10.13,0:09:12.76,Default,,0,0,0,,Хехехе шатырлы шахта...
Dialogue: 0,0:09:12.84,0:09:15.88,Default,,0,0,0,,Бұл антиматерлік организмдердің жанама өнімі.
Dialogue: 0,0:09:15.97,0:09:20.85,Default,,0,0,0,,Егер сенсорды бекітіп, оны басқарсаңыз, ол дыбыстан төмен жылдамдықпен шабуыл жасайтын қаруға айналады.
Dialogue: 0,0:09:20.93,0:09:23.56,Default,,0,0,0,,Егер адамға трансплантацияланса, адамнан тыс жауынгерлік күш алуға болады.
Dialogue: 0,0:09:23.56,0:09:25.14,Default,,0,0,0,,Егер адамға трансплантацияланса, адамнан тыс жауынгерлік күш алуға болады.
Dialogue: 0,0:09:23.56,0:09:25.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:25.23,0:09:26.27,Default,,0,0,0,,(Өлім құдайының құлаған дыбысы)
Dialogue: 0,0:09:26.35,0:09:29.19,Default,,0,0,0,,Ах (Шинигамидің ыңырсыуы)
Dialogue: 0,0:09:29.27,0:09:31.11,Default,,0,0,0,,Бұл деңгейде...
Dialogue: 0,0:09:31.19,0:09:33.82,Default,,0,0,0,,Сен өлмейсің.
Dialogue: 0,0:09:34.57,0:09:36.78,Default,,0,0,0,,Эй... өлтір мені!
Dialogue: 0,0:09:36.86,0:09:38.86,Default,,0,0,0,,Қоршаңыз және жойыңыз!
Dialogue: 0,0:09:38.95,0:09:41.24,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:09:41.33,0:09:43.12,Default,,0,0,0,,(Сақшылардың айқайы)
Dialogue: 0,0:09:43.20,0:09:44.41,Default,,0,0,0,,(Шинигамидің күлкісі)
Dialogue: 0,0:09:44.41,0:09:45.41,Default,,0,0,0,,(Шинигамидің күлкісі)
Dialogue: 0,0:09:44.41,0:09:45.41,Default,,0,0,0,,Арматураланған акрил!
Dialogue: 0,0:09:47.50,0:09:49.63,Default,,0,0,0,,(Шинигамидің айқайы)
Dialogue: 0,0:09:50.67,0:09:52.09,Default,,0,0,0,,Гуаааа!
Dialogue: 0,0:09:52.17,0:09:55.59,Default,,0,0,0,,Бүгінгі жағдайда ол профессор Годжо немесе сондай біреу болар еді.
Dialogue: 0,0:09:55.67,0:10:00.05,Default,,0,0,0,,(Сақшылардың айқайы)
Dialogue: 0,0:10:00.14,0:10:02.76,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:10:02.85,0:10:07.77,Default,,0,0,0,,(алыстан құлаған дыбыс)
Dialogue: 0,0:10:10.86,0:10:13.44,Default,,0,0,0,,Хмм... аа...
Dialogue: 0,0:10:21.87,0:10:22.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:24.41,0:10:27.96,Default,,0,0,0,,Әйтеуір... Мен бір жылдан кейін өлемін.
Dialogue: 0,0:10:28.04,0:10:30.58,Default,,0,0,0,,Мен мұнда өлсем де бәрібір.
Dialogue: 0,0:10:31.13,0:10:33.50,Default,,0,0,0,,Жермен бірге өлу жаман емес.
Dialogue: 0,0:10:33.59,0:10:35.17,Default,,0,0,0,,(Агридің ауыр тыныс алуы)
Dialogue: 0,0:10:38.05,0:10:39.68,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:10:42.18,0:10:45.35,Default,,0,0,0,,Егер сіз сонда барсаңыз, сіз ...
Dialogue: 0,0:10:46.43,0:10:48.81,Default,,0,0,0,,Мен енді қайтып бара алмаймын!
Dialogue: 0,0:10:49.73,0:10:51.77,Default,,0,0,0,,Мен бәрін көре алдым
Dialogue: 0,0:10:51.85,0:10:54.40,Default,,0,0,0,,Мен бәрін көріп тұрғандай болдым.
Dialogue: 0,0:10:55.11,0:10:58.86,Default,,0,0,0,,Бірақ ол мені бақылап тұрды...
Dialogue: 0,0:10:58.94,0:11:02.11,Default,,0,0,0,,Мен оны көре алмадым
Dialogue: 0,0:11:04.91,0:11:06.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:06.24,0:11:07.54,Default,,0,0,0,,Ха…
Dialogue: 0,0:11:12.63,0:11:14.00,Default,,0,0,0,,Агури!
Dialogue: 0,0:11:15.63,0:11:16.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:21.13,0:11:23.30,Default,,0,0,0,,Мен ебедейсіз болдым...
Dialogue: 0,0:11:23.39,0:11:26.85,Default,,0,0,0,,Мен мұндай құрылғы ашылады деп ойламадым...
Dialogue: 0,0:11:27.35,0:11:28.72,Default,,0,0,0,,Неге...
Dialogue: 0,0:11:28.81,0:11:30.43,Default,,0,0,0,,Тек дауыс...
Dialogue: 0,0:11:30.52,0:11:33.56,Default,,0,0,0,,Сіз өзіңізді тоқтата алмайтындай сезінесіз ...
Dialogue: 0,0:11:34.06,0:11:38.15,Default,,0,0,0,,0,1 секунд қалды. Егер мен ертерек байқасам, мен оны сақтап қалар едім ...
Dialogue: 0,0:11:38.65,0:11:42.15,Default,,0,0,0,,Егер мен шатырды медициналық мақсатта қолдануға үйреткен болсам, мені құтқарып қалуға болар еді...
Dialogue: 0,0:11:42.66,0:11:46.37,Default,,0,0,0,,Неге... Түсінуге көп уақытым болды...
Dialogue: 0,0:11:46.87,0:11:50.20,Default,,0,0,0,,Өлтіретін құдірет, жою күші
Dialogue: 0,0:11:50.29,0:11:52.75,Default,,0,0,0,,Неге оны басқа біреуге пайдаланбадың...?
Dialogue: 0,0:11:53.25,0:11:55.96,Default,,0,0,0,,Неліктен... неге?
Dialogue: 0,0:11:57.42,0:12:00.01,Default,,0,0,0,,Мен оны өлтірген сияқтымын.
Dialogue: 0,0:12:00.51,0:12:02.13,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:12:02.22,0:12:05.76,Default,,0,0,0,,Бұл дұрыс емес...
Dialogue: 0,0:12:05.85,0:12:09.31,Default,,0,0,0,,Мен... жай ғана...
Dialogue: 0,0:12:09.39,0:12:10.77,Default,,0,0,0,,Және...
Dialogue: 0,0:12:11.27,0:12:15.06,Default,,0,0,0,,Егер сіз... өлтірілсеңіз де...
Dialogue: 0,0:12:15.15,0:12:17.65,Default,,0,0,0,,Менің ойымша, бұл өте маңызды...
Dialogue: 0,0:12:18.65,0:12:23.15,Default,,0,0,0,,Сенің осындай адамды кездестіретініне сенімдімін...
Dialogue: 0,0:12:23.65,0:12:26.41,Default,,0,0,0,,Егер мені өлтіретін болсаң, мен өкінбес едім.
Dialogue: 0,0:12:26.91,0:12:29.70,Default,,0,0,0,,Бірақ мен сенен басқа біреудің бар екеніне сене алмаймын...
Dialogue: 0,0:12:29.79,0:12:31.08,Default,,0,0,0,,- Гохо... - (Шинигами) Ха...
Dialogue: 0,0:12:31.16,0:12:33.54,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:34.75,0:12:38.09,Default,,0,0,0,,Ал егер… бір жыл қалды…
Dialogue: 0,0:12:38.59,0:12:41.42,Default,,0,0,0,,Маған уақытыңызды берсеңіз...
Dialogue: 0,0:12:41.92,0:12:44.72,Default,,0,0,0,,Сол балалар туралы айтып беріңізші.
Dialogue: 0,0:12:46.30,0:12:48.30,Default,,0,0,0,,Сіз сияқты...
Dialogue: 0,0:12:48.80,0:12:52.35,Default,,0,0,0,,Сол балалар да қараңғыда қаңғып жүр.
Dialogue: 0,0:12:53.10,0:12:57.19,Default,,0,0,0,,Алға қарасаң, мен сенімдімін...
Dialogue: 0,0:13:00.69,0:13:03.44,Default,,0,0,0,,Қандай... әдемі шатырлар
Dialogue: 0,0:13:04.49,0:13:08.66,Default,,0,0,0,,Егер сіз мұны істесеңіз, мен сізге сенімдімін ...
Dialogue: 0,0:13:10.45,0:13:14.08,Default,,0,0,0,,Жақсы… мұғалімге…
Dialogue: 0,0:13:14.16,0:13:16.87,Default,,0,0,0,,А... а...
Dialogue: 0,0:13:21.34,0:13:22.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:31.14,0:13:32.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:38.06,0:13:39.44,Default,,0,0,0,,Ақсақ...
Dialogue: 0,0:13:40.77,0:13:42.36,Default,,0,0,0,,Мен ақыры түсіндім
Dialogue: 0,0:13:43.28,0:13:47.53,Default,,0,0,0,,Оның кемшіліктері де оның сүйкімділігі болды.
Dialogue: 0,0:13:55.20,0:13:59.46,Default,,0,0,0,,Мұғалім болу үшін қалған уақытты пайдаланыңыз
Dialogue: 0,0:14:00.50,0:14:03.09,Default,,0,0,0,,Сіз қарап отырған студенттер
Dialogue: 0,0:14:03.59,0:14:05.42,Default,,0,0,0,,Менің көзіммен қарайық
Dialogue: 0,0:14:10.89,0:14:12.39,Default,,0,0,0,,Кез келген уақытта...
Dialogue: 0,0:14:12.89,0:14:15.10,Default,,0,0,0,,Мен бұл шатырды жібермеймін...
Dialogue: 0,0:14:15.18,0:14:16.06,Default,,0,0,0,,(Орақтың дірілдеген тынысы)
Dialogue: 0,0:14:16.14,0:14:17.77,Default,,0,0,0,,(Чиноның ауыр тыныс алуы)
Dialogue: 0,0:14:17.85,0:14:19.23,Default,,0,0,0,,Ха…
Dialogue: 0,0:14:24.78,0:14:26.82,Default,,0,0,0,,Шатырлар сұрады
Dialogue: 0,0:14:27.32,0:14:28.90,Default,,0,0,0,,Сіз қандай болғыңыз келеді?
Dialogue: 0,0:14:30.49,0:14:31.91,Default,,0,0,0,,Мен әлсіз болғым келеді
Dialogue: 0,0:14:32.58,0:14:35.62,Default,,0,0,0,,Әлсіз жақтарға толы және қол жетімді...
Dialogue: 0,0:14:36.12,0:14:38.21,Default,,0,0,0,,Оны ең әлсіз адам да сезіне алады
Dialogue: 0,0:14:38.71,0:14:41.17,Default,,0,0,0,,Қорғаңыз, бағыттаңыз...
Dialogue: 0,0:14:41.25,0:14:43.38,Default,,0,0,0,,Мұндай жаратылысқа...
Dialogue: 0,0:14:43.46,0:14:45.55,Default,,0,0,0,,Мұндай мұғалімге...
Dialogue: 0,0:14:47.13,0:14:48.84,Default,,0,0,0,,Кейде қате
Dialogue: 0,0:14:48.92,0:14:52.01,Default,,0,0,0,,Сіз кейде қатыгез жағыңызды көрсете аласыз.
Dialogue: 0,0:14:52.51,0:14:55.14,Default,,0,0,0,,Бірақ мен бар күшімді саламын
Dialogue: 0,0:14:55.93,0:14:57.93,Default,,0,0,0,,Ол нені мақсат етті
Dialogue: 0,0:14:58.02,0:15:01.10,Default,,0,0,0,,Өз жолыммен, өз жолыммен...
Dialogue: 0,0:15:13.70,0:15:16.12,Default,,0,0,0,,Мұның бәрі мұғалім туралы.
Dialogue: 0,0:15:16.62,0:15:21.75,Default,,0,0,0,,Мұғалім ретінде менің тәлімгерім - Агури Юкимура.
Dialogue: 0,0:15:21.83,0:15:23.17,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:23.25,0:15:25.38,Default,,0,0,0,,Алдыңыздағы адамға мұқият қараңыз.
Dialogue: 0,0:15:25.46,0:15:28.01,Default,,0,0,0,,Тең адам ретінде құрметтеу
Dialogue: 0,0:15:28.09,0:15:31.63,Default,,0,0,0,,Адамдарды тек бір ғана әлсіздікке қарап соттамаңыз.
Dialogue: 0,0:15:32.13,0:15:36.39,Default,,0,0,0,,Осындай ұстаз болудың негіздерін одан үйрендім.
Dialogue: 0,0:15:32.13,0:15:36.39,Default,,0,0,0,,(Чиноның жылағаны)
Dialogue: 0,0:15:36.47,0:15:40.81,Default,,0,0,0,,Мұғалім оған өзінің білімі мен тәжірибесін қосады.
Dialogue: 0,0:15:40.89,0:15:43.65,Default,,0,0,0,,​​Мен бәріңмен кездесуге дайындалдым.
Dialogue: 0,0:15:44.15,0:15:46.36,Default,,0,0,0,,Қолымнан келгенше
Dialogue: 0,0:15:46.44,0:15:49.78,Default,,0,0,0,,Біз сізге ең жақсы өсуді ұсынамыз.
Dialogue: 0,0:15:49.86,0:15:53.74,Default,,0,0,0,,Мұны істеудің ең жақсы жолы қандай?
Dialogue: 0,0:15:53.82,0:15:56.62,Default,,0,0,0,,Ойлан, ойла...
Dialogue: 0,0:15:57.58,0:15:59.54,Default,,0,0,0,,Мен келдім
Dialogue: 0,0:15:59.62,0:16:04.58,Default,,0,0,0,,Бұл мұғалімнің қалған өмірін пайдаланатын қастандық кабинеті.
Dialogue: 0,0:16:05.38,0:16:08.25,Default,,0,0,0,,Коро-сенсэйдің Е сыныбына келгеніне 9 ай болды.
Dialogue: 0,0:16:08.75,0:16:11.22,Default,,0,0,0,,Әркім еркін өсе алды.
Dialogue: 0,0:16:11.72,0:16:15.55,Default,,0,0,0,,Ол шынымен де біз үшін ең жақсы ұстаз.
Dialogue: 0,0:16:16.93,0:16:18.51,Default,,0,0,0,,30 минуттан астам
Dialogue: 0,0:16:18.60,0:16:22.31,Default,,0,0,0,,Мұғалім болғанымның шын себебін айтып болған соң
Dialogue: 0,0:16:23.10,0:16:28.36,Default,,0,0,0,,Кенет біздің басымызға Короссей туралы естеліктер жүгірді.
Dialogue: 0,0:16:29.19,0:16:32.24,Default,,0,0,0,,Мені қорқытқан нәрселер Мені ашуландырған нәрселер
Dialogue: 0,0:16:32.99,0:16:35.61,Default,,0,0,0,,Мені бақытты еткен нәрселер Көңілді болған нәрселер
Dialogue: 0,0:16:36.57,0:16:37.95,Default,,0,0,0,,Не қызық болды
Dialogue: 0,0:16:38.45,0:16:40.12,Default,,0,0,0,,Не қызық болды...
Dialogue: 0,0:16:42.16,0:16:45.92,Default,,0,0,0,,Біз қорқынышты сынаққа тап болдық.
Dialogue: 0,0:16:46.00,0:16:49.75,Default,,0,0,0,,Мен бірінші рет байқадым...
Dialogue: 0,0:16:51.30,0:16:53.26,Default,,0,0,0,,Бұл мұғалім
Dialogue: 0,0:16:54.05,0:16:56.34,Default,,0,0,0,,Мен оны өлтіруім керек пе?
Dialogue: 0,0:16:59.43,0:17:00.89,Default,,0,0,0,,Сәлем Қарасума
Dialogue: 0,0:17:02.98,0:17:05.31,Default,,0,0,0,,Өлтіру деген нені білдіреді?
Dialogue: 0,0:17:06.23,0:17:08.02,Default,,0,0,0,,Сіз шынымен түсінесіз бе?
Dialogue: 0,0:17:14.32,0:17:18.32,Default,,0,0,0,,Жарылыстың соңғы мерзімі - 13 наурыз.
Dialogue: 0,0:17:18.82,0:17:23.12,Default,,0,0,0,,Кездейсоқ сол күні Кунигаока орта мектебінің бітіру салтанаты болды.
Dialogue: 0,0:17:24.66,0:17:28.13,Default,,0,0,0,,Жаңа жыл аяқталды және бүгін 6 қаңтар
Dialogue: 0,0:17:29.13,0:17:32.55,Default,,0,0,0,,Қысқы каникул кезінде қастандық жасаған студент:
Dialogue: 0,0:17:33.67,0:17:35.63,Default,,0,0,0,,Бірде-бір адам болған жоқ.
Dialogue: 0,0:17:38.55,0:17:40.05,Default,,0,0,0,,Қалайсың? Кая...
Dialogue: 0,0:17:40.14,0:17:41.81,Default,,0,0,0,,Ах... Юкимура-сан
Dialogue: 0,0:17:41.89,0:17:43.47,Default,,0,0,0,,Чино жақсы.
Dialogue: 0,0:17:43.56,0:17:45.48,Default,,0,0,0,,Каэде Чино да жаман емес.
Dialogue: 0,0:17:45.56,0:17:49.77,Default,,0,0,0,,Жаңа жыл ғана емес, бүкіл қысқы демалыс бұзылды.
Dialogue: 0,0:17:49.86,0:17:52.61,Default,,0,0,0,,Жаңа семестрге өту қауіпсіз
Dialogue: 0,0:17:52.69,0:17:55.40,Default,,0,0,0,,Бірақ барлығының қысқы демалысы...
Dialogue: 0,0:17:55.49,0:17:59.99,Default,,0,0,0,,Ақырында қастандық туралы ешкім айта алмады...
Dialogue: 0,0:18:00.07,0:18:03.62,Default,,0,0,0,,Кешіріңіз, бұл менің кінәм...
Dialogue: 0,0:18:03.70,0:18:08.50,Default,,0,0,0,,Енді мен шындықты білгеннен кейін мен ойымды реттедім...
Dialogue: 0,0:18:08.58,0:18:09.79,Default,,0,0,0,,үшінна айырбас
Dialogue: 0,0:18:09.88,0:18:12.17,Default,,0,0,0,,Мен Коро-сенсэйдің өткенін білдім...
Dialogue: 0,0:18:12.25,0:18:14.09,Default,,0,0,0,,- (Нагиса) Жоқ, Чино - (Чино) А...
Dialogue: 0,0:18:14.17,0:18:17.09,Default,,0,0,0,,Мен бір күні білуім керек еді.
Dialogue: 0,0:18:17.76,0:18:21.80,Default,,0,0,0,,Бүкіл сынып маған бет бұру үшін барын салды.
Dialogue: 0,0:18:22.30,0:18:26.60,Default,,0,0,0,,Себебі мен қызық өлтіруді мүмкіндігінше ұзақ жалғастырғым келді...
Dialogue: 0,0:18:26.68,0:18:30.40,Default,,0,0,0,,Бәлкім, бұл туралы бәрі қысқы демалыста ойлайды.
Dialogue: 0,0:18:30.48,0:18:33.44,Default,,0,0,0,,Қастандық сыныбына қалай қарсы тұру керек...
Dialogue: 0,0:18:35.53,0:18:36.57,Default,,0,0,0,,А... Мен де Каянодан кешірім сұрауым керек.
Dialogue: 0,0:18:36.57,0:18:37.57,Default,,0,0,0,,Ах... Мен де Каянодан кешірім сұрауым керек.
Dialogue: 0,0:18:36.57,0:18:37.57,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:37.57,0:18:38.57,Default,,0,0,0,,А... Мен де Каянодан кешірім сұрауым керек.
Dialogue: 0,0:18:38.65,0:18:40.91,Default,,0,0,0,,- (Нағиса) Сол түн үшін кешірім сұраймын! -(Чино) А?
Dialogue: 0,0:18:40.99,0:18:45.16,Default,,0,0,0,,Сол кезде мен ойлаған жалғыз әдіс осы еді...
Dialogue: 0,0:18:45.24,0:18:46.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:46.95,0:18:48.83,Default,,0,0,0,,Сіз ашулысыз ба?
Dialogue: 0,0:18:50.12,0:18:51.54,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:18:51.63,0:18:55.05,Default,,0,0,0,,Сіз маған көмектестіңіз, менің қолымнан келгені — рахмет.
Dialogue: 0,0:18:55.13,0:18:58.26,Default,,0,0,0,,Бұл жақсы~ Егер сіз ажырасып жатырмыз десеңіз...
Dialogue: 0,0:18:58.34,0:18:59.47,Default,,0,0,0,,- (Чино) Сен тым көп мән бересің! -(Нағиса) А...
Dialogue: 0,0:18:59.55,0:19:01.68,Default,,0,0,0,,Біз әрқашан қарапайым дос болдық
Dialogue: 0,0:19:01.76,0:19:04.64,Default,,0,0,0,,А... тоқтайтын кез келді.
Dialogue: 0,0:19:04.72,0:19:06.77,Default,,0,0,0,,Чино мырза да шаршаған болуы керек.
Dialogue: 0,0:19:06.85,0:19:08.39,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:19:08.48,0:19:09.69,Default,,0,0,0,,Олай болса, Чино.
Dialogue: 0,0:19:09.77,0:19:11.94,Default,,0,0,0,,- (Канзаки) Ертең кездескенше - (Сугино) Ертең кездескенше
Dialogue: 0,0:19:12.02,0:19:14.06,Default,,0,0,0,,Иә
Dialogue: 0,0:19:14.15,0:19:15.52,Default,,0,0,0,,- (канзаки) Хэхе - (3 адам) А?
Dialogue: 0,0:19:15.61,0:19:17.73,Default,,0,0,0,,Не болды? Канзаки мырза
Dialogue: 0,0:19:17.82,0:19:20.86,Default,,0,0,0,,Мен үнемі сабақты алыстан бақылап отыратынмын.
Dialogue: 0,0:19:20.95,0:19:23.91,Default,,0,0,0,,Ақырында бір жерге жеткендей болдым.
Dialogue: 0,0:19:25.62,0:19:26.87,Default,,0,0,0,,(Чиноның ыңырануы)
Dialogue: 0,0:19:26.95,0:19:28.66,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:28.75,0:19:31.08,Default,,0,0,0,,Бұл... Бұл...
Dialogue: 0,0:19:31.17,0:19:33.46,Default,,0,0,0,,Менің бүкіл болмысымды басқаратын сияқты!
Dialogue: 0,0:19:34.21,0:19:36.13,Default,,0,0,0,,Егер мен мұны білсем...
Dialogue: 0,0:19:36.21,0:19:38.67,Default,,0,0,0,,Мен енді әрекет ете алмаймын!
Dialogue: 0,0:19:38.76,0:19:42.84,Default,,0,0,0,,Мен өзімді сыныбымдағы ең жақсы өлтіруші деп ойладым.
Dialogue: 0,0:19:42.93,0:19:45.01,Default,,0,0,0,,Жалғыз адам болсаң, білмейсің.
Dialogue: 0,0:19:45.10,0:19:47.97,Default,,0,0,0,,Егер сізде лезде атыс күші болса, оның ішінде шатырлар...
Dialogue: 0,0:19:48.06,0:19:50.81,Default,,0,0,0,,Өлтіруші ретінде артта қалуым мүмкін емес...
Dialogue: 0,0:19:52.56,0:19:53.69,Default,,0,0,0,,Жұмыс істемей жатыр!
Dialogue: 0,0:19:54.19,0:19:57.98,Default,,0,0,0,,Менің жүрегім оңай атылып кетті.
Dialogue: 0,0:19:58.86,0:20:00.53,Default,,0,0,0,,Толық жеңілу...
Dialogue: 0,0:20:01.24,0:20:06.24,Default,,0,0,0,,Менің сыныбымда Нағисадан артық өлтіруші жоқ.
Dialogue: 0,0:20:07.49,0:20:09.75,Default,,0,0,0,,Сіз бұл жолы дос рөлін ойнайсыз ба...
Dialogue: 0,0:20:10.41,0:20:12.12,Default,,0,0,0,,Мен оны ойнауым керек.
Dialogue: 0,0:20:14.25,0:20:16.63,Default,,0,0,0,,үшін, үшінші семестр.
Dialogue: 0,0:20:16.71,0:20:20.09,Default,,0,0,0,,Биыл да жақсы оқып, жақсы өлтірейік.
Dialogue: 0,0:20:25.72,0:20:27.89,Default,,0,0,0,,Сіз білуіңіз керек еді.
Dialogue: 0,0:20:27.97,0:20:29.47,Default,,0,0,0,,Жаңа ма?
Dialogue: 0,0:20:27.97,0:20:29.47,Default,,0,0,0,,Бұл студенттермен болады
Dialogue: 0,0:20:29.47,0:20:30.77,Default,,0,0,0,,Бұл студенттермен болады
Dialogue: 0,0:20:31.27,0:20:34.85,Default,,0,0,0,,Осындай жүкті көтерсін.
Dialogue: 0,0:20:34.94,0:20:38.82,Default,,0,0,0,,Мұғалімнің жұмысын аяқтай аласыз ба?
Dialogue: 0,0:20:40.32,0:20:44.45,Default,,0,0,0,,Жағдайға сәйкес тапсырманы икемді түрде орындауға дайын болмасаңыз.
Dialogue: 0,0:20:44.53,0:20:47.45,Default,,0,0,0,,Мен ешқашан мұғалім болған емеспін.
Dialogue: 0,0:20:50.91,0:20:52.91,Default,,0,0,0,,Біреуді өлтірудің ең ақымақ жолы
Dialogue: 0,0:20:53.58,0:20:56.88,Default,,0,0,0,,Эмоция немесе қалау салдарынан кездейсоқ өлтіру
Dialogue: 0,0:20:57.50,0:20:59.42,Default,,0,0,0,,Бұл жануардан артық емес.
Dialogue: 0,0:20:59.92,0:21:01.59,Default,,0,0,0,,Қаншық Сенсей...
Dialogue: 0,0:21:01.67,0:21:03.72,Default,,0,0,0,,Ал келесі ақымақ нәрсе
Dialogue: 0,0:21:03.80,0:21:07.68,Default,,0,0,0,,Өз сезімін өлтіру кезінде басқа адамды өлтіру
Dialogue: 0,0:21:08.18,0:21:11.31,Default,,0,0,0,,Сыйлықтың орнына көп нәрсені жоғалтыңыз
Dialogue: 0,0:21:11.39,0:21:13.48,Default,,0,0,0,,Мен сияқты.
Dialogue: 0,0:21:14.02,0:21:16.52,Default,,0,0,0,,Көп уайымдаңыздар, братандар.
Dialogue: 0,0:21:17.52,0:21:22.11,Default,,0,0,0,,Ең қымбат сезімдеріңді өлтірмеу үшін
Dialogue: 0,0:21:22.19,0:21:23.65,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:21:28.91,0:21:29.78,Default,,0,0,0,,Андайо
Dialogue: 0,0:21:30.41,0:21:33.37,Default,,0,0,0,,Теменің шақыру қағазын шақыруы әдеттен тыс.
Dialogue: 0,0:21:33.45,0:21:34.83,Default,,0,0,0,,Нағиса
Dialogue: 0,0:21:35.62,0:21:37.96,Default,,0,0,0,,Мен бір нәрсені талқылағым келеді...
Dialogue: 0,0:21:38.04,0:21:39.29,Default,,0,0,0,,Не болды?
Dialogue: 0,0:21:40.42,0:21:42.88,Default,,0,0,0,,Мен мұны істей алатынымды білмеймін.
Dialogue: 0,0:21:44.17,0:21:48.22,Default,,0,0,0,,Мен Коросейдің өмірін сақтап қалудың жолын тапқым келеді.
Dialogue: 0,0:21:49.89,0:21:54.89,Default,,0,0,0,,♪～
Dialogue: 0,0:22:50.82,0:22:55.83,Default,,0,0,0,,～♪
Dialogue: 0,0:22:57.33,0:23:03.33,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
