Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.66,0:00:04.83,Default,,0,0,0,,Итона-кун Коро-сенсейге үш рет шабуыл жасады.
Dialogue: 0,0:00:05.50,0:00:06.79,Default,,0,0,0,,Көп нәрсе болды.
Dialogue: 0,0:00:06.88,0:00:09.38,Default,,0,0,0,,Ақыры сыныптас болып кеттік.
Dialogue: 0,0:00:09.46,0:00:13.01,Default,,0,0,0,,Бір аптадан кейін, сол күні...
Dialogue: 0,0:00:13.09,0:00:16.72,Default,,0,0,0,,Иә, бәрі, ертең кездескенше.
Dialogue: 0,0:00:16.80,0:00:19.10,Default,,0,0,0,,Мұғалім: Ақыры жалақымды алдым.
Dialogue: 0,0:00:19.18,0:00:22.06,Default,,0,0,0,,Бүгін мен шанхай крабын жеймін, Арне.
Dialogue: 0,0:00:22.14,0:00:24.44,Default,,0,0,0,,Жарайсыңдар!
Dialogue: 0,0:00:24.52,0:00:26.02,Default,,0,0,0,,Тек мұғалімнің өзі қу!
Dialogue: 0,0:00:26.10,0:00:27.52,Default,,0,0,0,,Маған жеңіл қарама
Dialogue: 0,0:00:27.61,0:00:30.98,Default,,0,0,0,,Екінші семестрден бастап мен одан да қатты оқи бастадым.
Dialogue: 0,0:00:31.07,0:00:32.15,Default,,0,0,0,,Коросей
Dialogue: 0,0:00:32.24,0:00:34.99,Default,,0,0,0,,Олар шынымен біздің бағаларымызды жақсартуға тырысуда.
Dialogue: 0,0:00:35.07,0:00:36.49,Default,,0,0,0,,Жарайды, бірақ келіңіз.
Dialogue: 0,0:00:36.57,0:00:38.74,Default,,0,0,0,,Мен ешкімді көтермегеніме көп болды.
Dialogue: 0,0:00:38.83,0:00:40.41,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:00:41.70,0:00:42.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:45.42,0:00:47.58,Default,,0,0,0,,Итона-кун, үйге бармайсың ба?
Dialogue: 0,0:00:47.67,0:00:50.00,Default,,0,0,0,,Иә? Сіз не істеп жатырсыз?
Dialogue: 0,0:00:50.09,0:00:51.34,Default,,0,0,0,,Көріп отырғаныңыздай
Dialogue: 0,0:00:51.42,0:00:53.67,Default,,0,0,0,,Бұл радиомен басқарылатын жауынгерлік көлік.
Dialogue: 0,0:00:53.76,0:00:54.80,Default,,0,0,0,,Өзіңді тым жоғары қоя бастадың.
Dialogue: 0,0:00:55.55,0:00:59.05,Default,,0,0,0,,Сол сегізаяқ мені кеше күні бойы оқуға мәжбүр етті.
Dialogue: 0,0:00:59.14,0:01:01.01,Default,,0,0,0,,Мен қатты күйзелдім.
Dialogue: 0,0:01:01.97,0:01:03.81,Default,,0,0,0,,Иә, жақсы.
Dialogue: 0,0:01:03.89,0:01:05.85,Default,,0,0,0,,Келесі сұрақ
Dialogue: 0,0:01:05.94,0:01:09.56,Default,,0,0,0,,Мен ашуландым, сондықтан мен сені осымен өлтіремін.
Dialogue: 0,0:01:09.65,0:01:10.82,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:01:10.90,0:01:12.73,Default,,0,0,0,,Терасака маған ақымақ жүзбен
Dialogue: 0,0:01:12.82,0:01:13.65,Default,,0,0,0,,Әй?
Dialogue: 0,0:01:13.74,0:01:15.95,Default,,0,0,0,,100 рет сәтсіздікке ұшыраған дұрыс
Dialogue: 0,0:01:16.03,0:01:18.99,Default,,0,0,0,,Міне, егер ол жұмыс істемесе, мен сені өлтіремін.
Dialogue: 0,0:01:19.07,0:01:20.95,Default,,0,0,0,,Өлтірмекші...
Dialogue: 0,0:01:21.03,0:01:22.37,Default,,0,0,0,,Бірақ... бірақ бұл
Dialogue: 0,0:01:23.08,0:01:25.37,Default,,0,0,0,,Бұл өте жоғары технология.
Dialogue: 0,0:01:25.96,0:01:30.96,Default,,0,0,0,,♪～
Dialogue: 0,0:02:50.00,0:02:55.00,Default,,0,0,0,,～♪
Dialogue: 0,0:03:00.01,0:03:02.18,Default,,0,0,0,,(Студенттердің шуы)
Dialogue: 0,0:03:04.10,0:03:07.39,Default,,0,0,0,,Бұл ұялы телефон камерасынан бөлек алынған бөлік.
Dialogue: 0,0:03:07.47,0:03:11.85,Default,,0,0,0,,Бұл таңқаларлық, Итона, сіз оны өзіңіз ойлап, өзгерттіңіз бе?
Dialogue: 0,0:03:11.94,0:03:16.73,Default,,0,0,0,,Мен негізгі электронды жұмыстардың көпшілігін әкемнің зауытында үйрендім.
Dialogue: 0,0:03:16.82,0:03:19.40,Default,,0,0,0,,Мұны Терасакадан басқа кез келген адам жасай алады.
Dialogue: 0,0:03:19.49,0:03:20.32,Default,,0,0,0,,Тітіркендіргіш!
Dialogue: 0,0:03:20.40,0:03:24.99,Default,,0,0,0,,Итона-кун, сен шатырлы кездегіден мүлде басқашасың.
Dialogue: 0,0:03:25.07,0:03:26.78,Default,,0,0,0,,Улы тілі сол қалпында қалғанымен
Dialogue: 0,0:03:35.67,0:03:38.00,Default,,0,0,0,,О~
Dialogue: 0,0:03:38.09,0:03:39.21,Default,,0,0,0,,О!
Dialogue: 0,0:03:56.31,0:03:58.57,Default,,0,0,0,,О~
Dialogue: 0,0:03:58.65,0:03:59.94,Default,,0,0,0,,Уау...
Dialogue: 0,0:04:00.03,0:04:02.99,Default,,0,0,0,,Жүгіру немесе ату кезінде дыбыс жоқтың қасы.
Dialogue: 0,0:04:03.07,0:04:07.24,Default,,0,0,0,,Тісті беріліс жетектерінің шуы электронды басқаруды кеңінен қолдану арқылы басылады.
Dialogue: 0,0:04:07.33,0:04:08.24,Default,,0,0,0,,(Мурамацу ысқырығы)
Dialogue: 0,0:04:08.33,0:04:12.91,Default,,0,0,0,,Негізгі зеңбіректің мақсатымен бірге кескіндерді контроллерге жібереді
Dialogue: 0,0:04:13.00,0:04:15.04,Default,,0,0,0,,Әй, тыңшы сияқты
Dialogue: 0,0:04:15.12,0:04:18.29,Default,,0,0,0,,Сіз мұны көздейтін болсаңыз да, дәл қайда?
Dialogue: 0,0:04:18.38,0:04:20.38,Default,,0,0,0,,Мен сізге бір нәрсе айтайын.
Dialogue: 0,0:04:21.09,0:04:25.22,Default,,0,0,0,,Мақсат қоюға болатын идеалды нүкте - нысананың өмірлік нүктесі.
Dialogue: 0,0:04:25.30,0:04:27.18,Default,,0,0,0,,Коро-сенсэйдің түйінді ойы?
Dialogue: 0,0:04:27.26,0:04:31.81,Default,,0,0,0,,Оның жүрегі бар, галстугының дәл астында.
Dialogue: 0,0:04:31.89,0:04:35.14,Default,,0,0,0,,Сол жерге тиіп кетсең, бір оқпен өлесің.
Dialogue: 0,0:04:37.69,0:04:39.98,Default,,0,0,0,,Нуруфуфуфуфу…
Dialogue: 0,0:04:40.07,0:04:43.24,Default,,0,0,0,,Бұл бәріне белгілі шығар.
Dialogue: 0,0:04:43.32,0:04:45.32,Default,,0,0,0,,Менің маңызды ойым
Dialogue: 0,0:04:45.41,0:04:46.82,Default,,0,0,0,,Итона-кунның қосылуымен
Dialogue: 0,0:04:46.91,0:04:50.54,Default,,0,0,0,,Қастандық барған сайын қызық болып бара жатқан сияқты.
Dialogue: 0,0:04:52.37,0:04:54.08,Default,,0,0,0,,Бұл жігітті қолдануға болады.
Dialogue: 0,0:04:54.16,0:04:55.25,Default,,0,0,0,,О
Dialogue: 0,0:04:55.33,0:04:59.29,Default,,0,0,0,,Жақсы! Қастандыққа дайындалу үшін сынақ жүргізейік.
Dialogue: 0,0:04:59.38,0:05:02.17,Default,,0,0,0,,Нақты орындау кезінде үзілсе, ештеңе қалмайды.
Dialogue: 0,0:05:02.26,0:05:03.09,Default,,0,0,0,,Иә
Dialogue: 0,0:05:03.17,0:05:05.05,Default,,0,0,0,,Баяу алға!
Dialogue: 0,0:05:11.06,0:05:13.02,Default,,0,0,0,,Қайта кездескенше, Қаншық!
Dialogue: 0,0:05:13.10,0:05:14.85,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:05:14.93,0:05:18.15,Default,,0,0,0,,Балалар, айналма жолмен жүрмеңдер және үйге қайтыңдар.
Dialogue: 0,0:05:18.23,0:05:20.73,Default,,0,0,0,,- (Курахаши) Иә - (Накамура) Эй, сен шәй ішкің келе ме?
Dialogue: 0,0:05:20.82,0:05:22.11,Default,,0,0,0,,Жүр, жүр!
Dialogue: 0,0:05:22.19,0:05:24.53,Default,,0,0,0,,Мен айтқан жерден
Dialogue: 0,0:05:27.57,0:05:28.70,Default,,0,0,0,,Сіз оны көрдіңіз бе?
Dialogue: 0,0:05:28.78,0:05:31.99,Default,,0,0,0,,Жоқ... камера қуып жете алмады.
Dialogue: 0,0:05:32.08,0:05:33.66,Default,,0,0,0,,Сіздің көзқарасыңыз тым тар!
Dialogue: 0,0:05:33.75,0:05:36.33,Default,,0,0,0,,Камера Үлкенірек болса да, мұны істей алмайсыз ба?
Dialogue: 0,0:05:36.41,0:05:38.08,Default,,0,0,0,,Ауыр
Dialogue: 0,0:05:38.17,0:05:41.71,Default,,0,0,0,,Ұтқырлық төмендейді, бұл нысананы алуды қиындатады
Dialogue: 0,0:05:41.79,0:05:42.92,Default,,0,0,0,,-(Маэхара) Хмм... -(Окадзима) Уф...
Dialogue: 0,0:05:43.00,0:05:44.13,Default,,0,0,0,,- (Такебаяши) Сосын - (барлығы) А?
Dialogue: 0,0:05:44.21,0:05:47.51,Default,,0,0,0,,Егер камера объективін балық көзі объективіне ауыстырсақ ше?
Dialogue: 0,0:05:47.63,0:05:49.01,Default,,0,0,0,,Бамбук орманы!
Dialogue: 0,0:05:49.09,0:05:53.77,Default,,0,0,0,,Егер жіберілген кескін процессор арқылы бұрмалану үшін түзетілсе,
Dialogue: 0,0:05:53.85,0:05:56.81,Default,,0,0,0,,Кең көріністі тіпті кішкентай линзамен де қамтамасыз етуге болады
Dialogue: 0,0:05:56.89,0:05:58.31,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:05:58.39,0:06:00.65,Default,,0,0,0,,Үлкен көру бұрышы бар кішкентай балық көзінің линзасы
Dialogue: 0,0:06:00.73,0:06:01.90,Default,,0,0,0,,Мен оны сатып аламын.
Dialogue: 0,0:06:01.98,0:06:03.48,Default,,0,0,0,,Ритсу
Dialogue: 0,0:06:03.57,0:06:04.61,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:04.69,0:06:06.99,Default,,0,0,0,,Мен бұрмалауды түзету бағдарламасын жасай аламын ба?
Dialogue: 0,0:06:07.07,0:06:07.90,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:07.99,0:06:10.87,Default,,0,0,0,,Мен оның не үшін қолданылатынын білмеймін, бірақ оны маған қалдырыңыз!
Dialogue: 0,0:06:10.95,0:06:13.12,Default,,0,0,0,,Сен данышпансың, Такебаяши.
Dialogue: 0,0:06:13.20,0:06:14.12,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:06:14.20,0:06:16.37,Default,,0,0,0,,Жазу функциясы да қажет.
Dialogue: 0,0:06:16.45,0:06:20.33,Default,,0,0,0,,Ах, тиімді жақсартуды талдау үшін маңызды.
Dialogue: 0,0:06:20.42,0:06:22.92,Default,,0,0,0,,Мені кір іш киімім өшірсе де...
Dialogue: 0,0:06:23.00,0:06:25.76,Default,,0,0,0,,Мұның бәрі қастандық үшін!
Dialogue: 0,0:06:25.84,0:06:29.30,Default,,0,0,0,,Жүр! Ем... Прототип № 0!
Dialogue: 0,0:06:30.47,0:06:31.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:34.60,0:06:36.47,Default,,0,0,0,,Мен сені қайтарамын!
Dialogue: 0,0:06:36.56,0:06:38.64,Default,,0,0,0,,Мен оны сұрадым, Кимура.
Dialogue: 0,0:06:38.73,0:06:41.35,Default,,0,0,0,,Соққыларға төтеп беретін аспа жүйесі де қажет емес пе?
Dialogue: 0,0:06:41.44,0:06:42.69,Default,,0,0,0,,Мен оны дамытамын.
Dialogue: 0,0:06:43.40,0:06:45.23,Default,,0,0,0,,Жетек жүйелеріне және металды өңдеуге арналған
Dialogue: 0,0:06:45.32,0:06:46.15,Default,,0,0,0,,есімде
Dialogue: 0,0:06:46.23,0:06:49.90,Default,,0,0,0,,Автокөлік корпусының ақшыл хаки түсі де өте байқалады.
Dialogue: 0,0:06:49.99,0:06:52.20,Default,,0,0,0,,Бұл ұрыс алаңындағы камуфляж.
Dialogue: 0,0:06:52.28,0:06:56.41,Default,,0,0,0,,Егер сіз мектептің декорациясына араласпасаңыз, сіздің мақсатыңыз сізді байқап қалуы мүмкін.
Dialogue: 0,0:06:56.49,0:06:57.50,Default,,0,0,0,,Қабылданды
Dialogue: 0,0:06:58.45,0:07:01.21,Default,,0,0,0,,Мектеп камуфляжы Мен оны бояймын
Dialogue: 0,0:07:01.29,0:07:03.67,Default,,0,0,0,,Радиобасқару құралдары өлшемдері бойынша адамдардан ерекшеленеді.
Dialogue: 0,0:07:04.46,0:07:06.13,Default,,0,0,0,,Ыңғайлы жүгіру үшін
Dialogue: 0,0:07:07.21,0:07:09.34,Default,,0,0,0,,Мен карта жасаймын
Dialogue: 0,0:07:09.42,0:07:11.63,Default,,0,0,0,,Эротикаға келгенде барлығы
Dialogue: 0,0:07:11.72,0:07:13.47,Default,,0,0,0,,Сіз өзіңізді жоғалтып жатырсыз ...
Dialogue: 0,0:07:13.55,0:07:15.47,Default,,0,0,0,,Сіз шынымен ессізсіз...
Dialogue: 0,0:07:23.02,0:07:24.61,Default,,0,0,0,,О
Dialogue: 0,0:07:24.69,0:07:27.11,Default,,0,0,0,,Мен кеше жүріс бөлігін аяқтадым.
Dialogue: 0,0:07:27.19,0:07:28.57,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:07:29.11,0:07:31.07,Default,,0,0,0,,Мен саған таңғы ас әзірледім.
Dialogue: 0,0:07:31.15,0:07:34.28,Default,,0,0,0,,Сіз қалай ойлайсыз? бұл мектеп камуфляжы
Dialogue: 0,0:07:34.37,0:07:35.66,Default,,0,0,0,,О...
Dialogue: 0,0:07:35.74,0:07:38.24,Default,,0,0,0,,Түсіндің бе? Барлығы
Dialogue: 0,0:07:38.33,0:07:40.96,Default,,0,0,0,,Бұл қастандық жоспары.
Dialogue: 0,0:07:41.04,0:07:43.62,Default,,0,0,0,,Білемін, білемін, Төраға.
Dialogue: 0,0:07:43.71,0:07:44.54,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:07:44.63,0:07:47.46,Default,,0,0,0,,Қыздар мектепке келмес бұрын біз сынақтан өткіземіз~
Dialogue: 0,0:07:47.55,0:07:48.92,Default,,0,0,0,,О!
Dialogue: 0,0:07:49.01,0:07:51.84,Default,,0,0,0,,Мұндай кезде ешкім кешікпейді...
Dialogue: 0,0:07:51.92,0:07:54.51,Default,,0,0,0,,Ритсу тура сағат 8-де іске қосылады.
Dialogue: 0,0:07:55.22,0:07:56.85,Default,,0,0,0,,Мен оны ренжіткім келмейді
Dialogue: 0,0:07:56.93,0:07:58.22,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:08:01.39,0:08:02.23,Default,,0,0,0,,Ах, ақымақ!
Dialogue: 0,0:08:02.31,0:08:05.15,Default,,0,0,0,,Абайлап жүрмесеңіз, қайтадан құлайсыз.
Dialogue: 0,0:08:05.23,0:08:06.65,Default,,0,0,0,,Жолдан кет! Мен сенің орныңды аламын
Dialogue: 0,0:08:06.73,0:08:10.94,Default,,0,0,0,,Итона-кун, мінезі жарамсыз, сыныпқа сыйып кете ала ма?
Dialogue: 0,0:08:11.03,0:08:13.11,Default,,0,0,0,,Бұл туралы алаңдаудың қажеті жоқ еді.
Dialogue: 0,0:08:13.20,0:08:15.82,Default,,0,0,0,,Эротика, кісі өлтіру және өндіріс
Dialogue: 0,0:08:15.91,0:08:21.33,Default,,0,0,0,,Итонаның айналасында баланың қысым нүктелерін мықтап ұстап тұрған шеңбер құрылды.
Dialogue: 0,0:08:21.41,0:08:24.79,Default,,0,0,0,,Итона: Біз барлығымыз оны жақсартып жатырмыз.
Dialogue: 0,0:08:24.87,0:08:26.83,Default,,0,0,0,,Неліктен ұшаққа әзірлеу атауын бермеске?
Dialogue: 0,0:08:28.50,0:08:30.50,Default,,0,0,0,,Ойлан
Dialogue: 0,0:08:32.26,0:08:34.68,Default,,0,0,0,,Менен шатыр сұрады
Dialogue: 0,0:08:34.76,0:08:36.43,Default,,0,0,0,,Сіз кім болғыңыз келеді?
Dialogue: 0,0:08:37.05,0:08:41.64,Default,,0,0,0,,«Мен күштірек болғым келеді» деп жауап бергенде, мен бұл туралы ғана ойладым.
Dialogue: 0,0:08:42.23,0:08:45.98,Default,,0,0,0,,Менің қолымнан келер нәрсе – таңырқау, күресу және жеңу...
Dialogue: 0,0:08:46.06,0:08:48.40,Default,,0,0,0,,Жіңішке жіп алдымен жақсы.
Dialogue: 0,0:08:48.48,0:08:50.65,Default,,0,0,0,,Біртіндеп айналдырып, күшейе түседі
Dialogue: 0,0:08:50.73,0:08:54.57,Default,,0,0,0,,Мынау Итон, сенің атыңдағы тілек.
Dialogue: 0,0:08:55.66,0:08:57.95,Default,,0,0,0,,Мен неге ұмыттым деп ойлаймын
Dialogue: 0,0:08:58.03,0:08:59.95,Default,,0,0,0,,Менің тамырым
Dialogue: 0,0:09:00.95,0:09:03.87,Default,,0,0,0,,Ах! Қараңызшы, мен Терасакаға соқтығыстым, мен оған мүлде жақсы емеспін.
Dialogue: 0,0:09:03.96,0:09:05.41,Default,,0,0,0,,Не!?
Dialogue: 0,0:09:05.50,0:09:09.04,Default,,0,0,0,,Мен басынан бастауым керек пе еді?
Dialogue: 0,0:09:09.13,0:09:09.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:14.13,0:09:15.63,Default,,0,0,0,,(Визельдің айқайы)
Dialogue: 0,0:09:15.72,0:09:17.59,Default,,0,0,0,,Бұл құбыжық!
Dialogue: 0,0:09:17.68,0:09:19.80,Default,,0,0,0,,- (Сугая) Қаш! -(Маэхара) Жоқ, ат!
Dialogue: 0,0:09:22.14,0:09:24.14,Default,,0,0,0,,Негізгі мылтық күші жетпейді!
Dialogue: 0,0:09:24.23,0:09:26.10,Default,,0,0,0,,Бұл да өзгертуді қажет етеді!
Dialogue: 0,0:09:26.69,0:09:27.52,Default,,0,0,0,,Cu…
Dialogue: 0,0:09:27.60,0:09:29.23,Default,,0,0,0,,Шуш
Dialogue: 0,0:09:29.31,0:09:31.19,Default,,0,0,0,,Үйден қашқандарды да қоса алғанда.
Dialogue: 0,0:09:31.27,0:09:32.69,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:36.24,0:09:37.74,Default,,0,0,0,,Дио…
Dialogue: 0,0:09:37.82,0:09:41.28,Default,,0,0,0,,Боқ... Мен ешқашан Итачи маған солай жасайды деп күтпедім.
Dialogue: 0,0:09:41.37,0:09:44.95,Default,,0,0,0,,Келесі жолы мен жүргізуші мен атқыш рөлдерін бөлісуім керек.
Dialogue: 0,0:09:45.04,0:09:46.91,Default,,0,0,0,,Мен сенен атуыңды сұраймын, Чиба.
Dialogue: 0,0:09:47.00,0:09:48.58,Default,,0,0,0,,Уа... ой
Dialogue: 0,0:09:49.58,0:09:51.75,Default,,0,0,0,,Даму кезінде қателер сөзсіз.
Dialogue: 0,0:09:51.84,0:09:53.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:54.05,0:09:56.47,Default,,0,0,0,,№1 итонари сәтсіздікке ұшырады.
Dialogue: 0,0:09:56.55,0:09:57.38,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:09:57.47,0:09:59.84,Default,,0,0,0,,Оны күштірек ету үшін осы жерден айналдырыңыз
Dialogue: 0,0:09:59.93,0:10:02.10,Default,,0,0,0,,100 рет сәтсіздікке ұшыраған дұрыс
Dialogue: 0,0:10:02.18,0:10:05.14,Default,,0,0,0,,Мен сені ақырында міндетті түрде өлтіремін
Dialogue: 0,0:10:05.73,0:10:07.27,Default,,0,0,0,,Балалар, танысқаныма қуаныштымын
Dialogue: 0,0:10:07.35,0:10:08.98,Default,,0,0,0,,- (Маэхара) Жүр! -(Окадзима) Фуфун
Dialogue: 0,0:10:09.06,0:10:11.19,Default,,0,0,0,,Кісі өлтіру ниетімен байланыстырылған барлық адамдар арасындағы байланыс
Dialogue: 0,0:10:11.98,0:10:13.77,Default,,0,0,0,,Бұл қайтадан қызық болатын сияқты
Dialogue: 0,0:10:13.86,0:10:16.90,Default,,0,0,0,,Жарайсыңдар! Наурызға дейін бұл жігіт
Dialogue: 0,0:10:16.99,0:10:19.70,Default,,0,0,0,,Барлық қыздардың юбкаларының ішін барлаайық!
Dialogue: 0,0:10:19.78,0:10:21.70,Default,,0,0,0,,Мақсат өзгерді.
Dialogue: 0,0:10:22.24,0:10:24.24,Default,,0,0,0,,Юбкаңның ішінде не бар?
Dialogue: 0,0:10:24.33,0:10:25.24,Default,,0,0,0,,Катаока!
Dialogue: 0,0:10:25.33,0:10:29.46,Default,,0,0,0,,Жоқ, бұл ештеңе емес, мен касталық жүйе туралы айттым.
Dialogue: 0,0:10:29.54,0:10:31.96,Default,,0,0,0,,- (Окано) Мен естідім - (Яда) Бала Сайт
Dialogue: 0,0:10:32.04,0:10:34.71,Default,,0,0,0,,Әй, кім бастады?
Dialogue: 0,0:10:34.80,0:10:36.67,Default,,0,0,0,,Бұл Итона-кун емес, солай ма?
Dialogue: 0,0:10:36.76,0:10:37.97,Default,,0,0,0,,-Окадзима - (Окадзима) Эй!
Dialogue: 0,0:10:39.34,0:10:40.84,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:10:40.93,0:10:42.60,Default,,0,0,0,,Ах, Окадзима мырза
Dialogue: 0,0:10:42.68,0:10:47.14,Default,,0,0,0,,Мен сізге балық көзі объективімен түсірілген кескіндерді түзету бағдарламасын ұсына аламын.
Dialogue: 0,0:10:47.22,0:10:48.14,Default,,0,0,0,,Әй!
Dialogue: 0,0:10:48.23,0:10:51.02,Default,,0,0,0,,Күте тұрыңыз! Бұл тек мен емес, солай ма?
Dialogue: 0,0:10:51.10,0:10:53.81,Default,,0,0,0,,Жоқ, білмеймін. Мені араластырма, Окадзима.
Dialogue: 0,0:10:53.90,0:10:55.69,Default,,0,0,0,,Ластан, Маэхара!
Dialogue: 0,0:10:55.78,0:10:58.07,Default,,0,0,0,,Жоқ, бәріңіз ойланыңыздар.
Dialogue: 0,0:10:58.15,0:11:01.86,Default,,0,0,0,,Қалай болғанда да, балалар, бәрінің жоспарысыңдар.
Dialogue: 0,0:11:01.95,0:11:03.87,Default,,0,0,0,,Ерлерге арналған сайт
Dialogue: 0,0:11:03.95,0:11:05.83,Default,,0,0,0,,Не істеп жүрсің?
Dialogue: 0,0:11:05.91,0:11:07.87,Default,,0,0,0,,Нәпсінің аздап шатасуы...
Dialogue: 0,0:11:07.95,0:11:08.83,Default,,0,0,0,,Хмм.
Dialogue: 0,0:11:08.91,0:11:11.54,Default,,0,0,0,,(Әйелдердің сұраулы дауысы)
Dialogue: 0,0:11:11.62,0:11:15.04,Default,,0,0,0,,Жарайды... бұл бала екеніне көмектесу мүмкін емес.
Dialogue: 0,0:11:16.13,0:11:19.76,Default,,0,0,0,,Карма Мен бүгін босаңсымақпын. Маған жақсы жер айтыңыз.
Dialogue: 0,0:11:19.84,0:11:22.76,Default,,0,0,0,,О, сөйлей аласың, жарай ма?
Dialogue: 0,0:11:22.84,0:11:25.68,Default,,0,0,0,,О, кел, Итона!
Dialogue: 0,0:11:25.76,0:11:29.02,Default,,0,0,0,,Итона-кунның бойы таңқаларлықтай.
Dialogue: 0,0:11:35.65,0:11:39.57,Default,,0,0,0,,Итона-кун «Итонари» деп жазылған, солай ма?
Dialogue: 0,0:11:39.65,0:11:42.03,Default,,0,0,0,,- (Курахаши) Жарқыраған есім ғой, солай емес пе? - (Чино) Эй...
Dialogue: 0,0:11:42.11,0:11:44.78,Default,,0,0,0,,Бұл жақсы есім емес. Бұл салқын.
Dialogue: 0,0:11:44.87,0:11:48.66,Default,,0,0,0,,Бұл сыныпта әдеттен тыс есімдері бар адамдар көп болуы керек.
Dialogue: 0,0:11:48.74,0:11:50.08,Default,,0,0,0,,Я...
Dialogue: 0,0:11:50.16,0:11:54.83,Default,,0,0,0,,Не!? «Әділет»? Мен бұл сөзсіз «Масаёси» деп ойладым
Dialogue: 0,0:11:54.92,0:11:56.25,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:11:56.34,0:11:57.84,Default,,0,0,0,,Барлығы самурайлардың мейірімінде
Dialogue: 0,0:11:57.92,0:12:00.42,Default,,0,0,0,,Ол оны «Масаёси» деп оқыды.
Dialogue: 0,0:12:00.51,0:12:03.18,Default,,0,0,0,,Мен де Коросейден мені осылай атауды өтіндім.
Dialogue: 0,0:12:03.26,0:12:06.30,Default,,0,0,0,,Мен оны қабылдау салтанатында алғаш естігенде қорықтым.
Dialogue: 0,0:12:06.39,0:12:07.81,Default,,0,0,0,,Жақсы... жақсы.
Dialogue: 0,0:12:07.89,0:12:10.85,Default,,0,0,0,,Мен мектеп бітіру салтанатында тағы да көпшілік алдында өлім жазасына кесіледі деп ойлаймын.
Dialogue: 0,0:12:10.93,0:12:12.27,Default,,0,0,0,,Ұнамаса, жасама.
Dialogue: 0,0:12:12.35,0:12:15.94,Default,,0,0,0,,Кимураның ата-анасы полиция қызметкері болса керек.
Dialogue: 0,0:12:16.02,0:12:17.52,Default,,0,0,0,,Әділдік сезімім мені асқақтатты
Dialogue: 0,0:12:17.61,0:12:19.53,Default,,0,0,0,,Бұл берілген атау болса керек.
Dialogue: 0,0:12:19.61,0:12:21.07,Default,,0,0,0,,Ата-ана ата-ана
Dialogue: 0,0:12:21.15,0:12:25.57,Default,,0,0,0,,«Маған қойған атыңа шағымданудың қажеті не?».
Dialogue: 0,0:12:25.66,0:12:28.08,Default,,0,0,0,,Сіздің балаңыз мектепте қаншалықты мазақтайды?
Dialogue: 0,0:12:28.16,0:12:30.24,Default,,0,0,0,,Менің ойымша, сіз бұл туралы тіпті ойлаған да жоқсыз.
Dialogue: 0,0:12:30.33,0:12:33.00,Default,,0,0,0,,- (Үзіліс) Бұл дұрыс емес. Ата-ана - (Кимура) А?
Dialogue: 0,0:12:33.08,0:12:37.04,Default,,0,0,0,,Осы жүзіммен мен «әдемімін». мен әдемімін.
Dialogue: 0,0:12:37.13,0:12:39.25,Default,,0,0,0,,Әдемі көрінеді ме?
Dialogue: 0,0:12:39.34,0:12:40.42,Default,,0,0,0,,Жоқ, жоқ...
Dialogue: 0,0:12:41.09,0:12:43.67,Default,,0,0,0,,Менің анамның миы ертегідей
Dialogue: 0,0:12:43.76,0:12:47.68,Default,,0,0,0,,Маған бірдеңе ұнамаса, мен бірден истерикамен айқайлаймын.
Dialogue: 0,0:12:47.76,0:12:50.81,Default,,0,0,0,,Осындай күйзеліске толы үйде өскен
Dialogue: 0,0:12:50.89,0:12:54.89,Default,,0,0,0,,Оның аты айтып тұрғандай сүйкімді болып өсуі мүмкін емес.
Dialogue: 0,0:12:54.98,0:12:59.06,Default,,0,0,0,,Қиын, бәрінің аттары біртүрлі.
Dialogue: 0,0:12:59.15,0:13:00.23,Default,,0,0,0,,Иә!?
Dialogue: 0,0:13:00.32,0:13:02.19,Default,,0,0,0,,О, мен?
Dialogue: 0,0:13:02.28,0:13:05.45,Default,,0,0,0,,Маған бұл есім қатты ұнайды.
Dialogue: 0,0:13:05.53,0:13:09.62,Default,,0,0,0,,Менің ойымша, ата-аналардың эксцентристік сезімі балаларына берілген сияқты.
Dialogue: 0,0:13:09.70,0:13:10.78,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:10.87,0:13:13.87,Default,,0,0,0,,Мұғалім де атына көңілі толмайды.
Dialogue: 0,0:13:13.95,0:13:16.92,Default,,0,0,0,,Не? Бұл Короссейге ұнайды.
Dialogue: 0,0:13:17.00,0:13:18.79,Default,,0,0,0,,Чино қойған есім
Dialogue: 0,0:13:18.88,0:13:21.21,Default,,0,0,0,,Маған ұнағандықтан көңілім толмайды.
Dialogue: 0,0:13:21.30,0:13:23.17,Default,,0,0,0,,Әлі шамамен 2 адам бар
Dialogue: 0,0:13:23.26,0:13:26.47,Default,,0,0,0,,Мені бұл атпен атамайтындар...
Dialogue: 0,0:13:26.55,0:13:31.85,Default,,0,0,0,,Қарасума-сенсей маған телефон соққанда, «эй» немесе «сен» дейді.
Dialogue: 0,0:13:31.93,0:13:33.81,Default,,0,0,0,,Олар орта жастағы жұп емес!
Dialogue: 0,0:13:33.89,0:13:36.14,Default,,0,0,0,,Өйткені... жақсы ересектер
Dialogue: 0,0:13:36.23,0:13:39.10,Default,,0,0,0,,«Коро-сенсэй» шынын айтқанда, жоқ-жоқ.
Dialogue: 0,0:13:39.19,0:13:40.02,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:40.11,0:13:42.11,Default,,0,0,0,,Олай болса, жақсырақ.
Dialogue: 0,0:13:42.19,0:13:44.28,Default,,0,0,0,,Бір-бірін код аттарымен шақыру туралы не айтасыз?
Dialogue: 0,0:13:44.36,0:13:45.57,Default,,0,0,0,,Код атауы?
Dialogue: 0,0:13:45.65,0:13:49.16,Default,,0,0,0,,Дұрыс, біз барлығына тағы бір жаңа атау жасаймыз.
Dialogue: 0,0:13:49.24,0:13:53.20,Default,,0,0,0,,Мен оңтүстік аралда кездестірген өлтірушілер, бір-бірлері туралы.
Dialogue: 0,0:13:53.29,0:13:55.29,Default,,0,0,0,,Шын есімімізді жасырып, бір-бірімізді шақырдық.
Dialogue: 0,0:13:55.37,0:13:58.33,Default,,0,0,0,,Өлтірушіге ұқсау керемет емес пе?
Dialogue: 0,0:13:58.42,0:14:00.96,Default,,0,0,0,,Түсіндім, бұл жақсы.
Dialogue: 0,0:14:01.04,0:14:03.00,Default,,0,0,0,,Ендеше мынаны орындайық
Dialogue: 0,0:14:03.09,0:14:06.01,Default,,0,0,0,,Барлығынан ықтимал код атауларын жазуды сұраңыз.
Dialogue: 0,0:14:06.09,0:14:09.76,Default,,0,0,0,,Бір-бірімізді мұғалімнің ішінен сызып қойған атымен шақырайық.
Dialogue: 0,0:14:09.84,0:14:12.97,Default,,0,0,0,,Бұл қызық, бірақ сіз бұл туралы бәрі үшін ойлайсыз ба...
Dialogue: 0,0:14:13.06,0:14:15.77,Default,,0,0,0,,Оны кездейсоқ түрде жазыңыз.
Dialogue: 0,0:14:15.85,0:14:16.81,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:14:16.89,0:14:18.35,Default,,0,0,0,,Олай болса
Dialogue: 0,0:14:18.44,0:14:21.44,Default,,0,0,0,,Бүгін сізді атыңызбен шақыруға тыйым салынады!
Dialogue: 0,0:14:21.52,0:14:22.86,Default,,0,0,0,,Түсіндім. Яғни, ән айтып, билейміз бе?
Dialogue: 0,0:14:26.82,0:14:28.53,Default,,0,0,0,,Бейсбол ақымақ Бейсбол ақымақ!
Dialogue: 0,0:14:29.32,0:14:30.66,Default,,0,0,0,,Нысанада қозғалыс бар ма?
Dialogue: 0,0:14:30.74,0:14:33.12,Default,,0,0,0,,Әлі Art Noppo емес
Dialogue: 0,0:14:33.20,0:14:36.25,Default,,0,0,0,,Тікелей адам енді жалғыз қарағайдың қасында тығылып отыр.
Dialogue: 0,0:14:36.33,0:14:38.16,Default,,0,0,0,,Кедейшілік жөніндегі уәкіл тобы
Dialogue: 0,0:14:38.25,0:14:40.37,Default,,0,0,0,,Тікелей адамды арт жағынан ағысқа айдаңыз
Dialogue: 0,0:14:40.46,0:14:43.34,Default,,0,0,0,,Цундере мергені сізді атуға қабілетті болуы керек.
Dialogue: 0,0:14:46.26,0:14:47.51,Default,,0,0,0,,Жарайды, кеттік!
Dialogue: 0,0:14:47.59,0:14:48.42,Default,,0,0,0,,Ха…
Dialogue: 0,0:14:48.51,0:14:49.97,Default,,0,0,0,,Тәтті екенсің, екеуің!
Dialogue: 0,0:14:50.05,0:14:51.80,Default,,0,0,0,,Қоршауда ұсталып қалсаңыз, не істейсіз?
Dialogue: 0,0:14:52.47,0:14:54.47,Default,,0,0,0,,Əсіресе əйелшіл бейбақ!
Dialogue: 0,0:14:54.56,0:14:57.06,Default,,0,0,0,,Мылтықты әрқашан ату биіктігінде ұстаңыз!
Dialogue: 0,0:14:57.14,0:14:58.52,Default,,0,0,0,,Қарғыс атсын, қашып кетейін!
Dialogue: 0,0:14:58.60,0:15:00.98,Default,,0,0,0,,Саңырауқұлақ режиссері Мэйджин Канзаки!
Dialogue: 0,0:15:01.06,0:15:03.23,Default,,0,0,0,,Үлпілдек бұғы қоңызы сонда кетті!
Dialogue: 0,0:15:03.31,0:15:04.40,Default,,0,0,0,,Маған қалдырыңыз~
Dialogue: 0,0:15:06.23,0:15:08.61,Default,,0,0,0,,Ах! бағытын өзгертті
Dialogue: 0,0:15:09.15,0:15:10.74,Default,,0,0,0,,Үй базасы! Хэчима!
Dialogue: 0,0:15:10.82,0:15:11.70,Default,,0,0,0,,Домалау!
Dialogue: 0,0:15:11.78,0:15:13.37,Default,,0,0,0,,О!
Dialogue: 0,0:15:13.45,0:15:16.91,Default,,0,0,0,,...және назарды жерге аударыңыз
Dialogue: 0,0:15:16.99,0:15:17.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:18.50,0:15:20.12,Default,,0,0,0,,Я, олай етпе.
Dialogue: 0,0:15:20.21,0:15:21.58,Default,,0,0,0,,Такаока Модоки
Dialogue: 0,0:15:21.67,0:15:23.38,Default,,0,0,0,,Бірақ бұл жеткіліксіз!
Dialogue: 0,0:15:23.46,0:15:26.80,Default,,0,0,0,,Маған бір ғана соққы оған ешқашан тимейді!
Dialogue: 0,0:15:27.84,0:15:30.01,Default,,0,0,0,,Улы көзілдірік Мәңгілік 0!
Dialogue: 0,0:15:30.09,0:15:32.55,Default,,0,0,0,,Егер сіз атыс нүктесін көре алсаңыз, оны табиғи түрде болдырмауға болады!
Dialogue: 0,0:15:32.64,0:15:35.51,Default,,0,0,0,,Хмм... Мен байқадым, өтінемін!
Dialogue: 0,0:15:35.60,0:15:36.97,Default,,0,0,0,,Абыроймен уағыздаңыз!
Dialogue: 0,0:15:37.06,0:15:38.97,Default,,0,0,0,,Жарайды! мен барамын
Dialogue: 0,0:15:39.06,0:15:40.77,Default,,0,0,0,,Гал ағылшын және жыныс!
Dialogue: 0,0:15:40.85,0:15:41.94,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:15:44.44,0:15:48.36,Default,,0,0,0,,Бұл жолы атқыштың орнын анықтауға мүмкіндік бермейтін шебер ату.
Dialogue: 0,0:15:48.44,0:15:50.99,Default,,0,0,0,,Оның сауапты уағыз айту қабілеті.
Dialogue: 0,0:15:51.07,0:15:53.74,Default,,0,0,0,,Артқы жақтан арақашықтықты сақтаңыз және ашылуын күтіңіз.
Dialogue: 0,0:15:53.82,0:15:55.49,Default,,0,0,0,,Метаморфоздың соңғы кезеңі
Dialogue: 0,0:15:55.57,0:15:57.70,Default,,0,0,0,,Бұл манга керемет!
Dialogue: 0,0:15:57.79,0:15:59.83,Default,,0,0,0,,Кіші орта екі жарым оқушы қашу жолын жауып тастады.
Dialogue: 0,0:15:59.91,0:16:00.83,Default,,0,0,0,,Мен енді жылап жібергім келеді!
Dialogue: 0,0:16:00.91,0:16:04.54,Default,,0,0,0,,Мен оны сұрадым, ғал ойынының басты кейіпкері!
Dialogue: 0,0:16:08.05,0:16:09.25,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:16:12.30,0:16:13.18,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:13.26,0:16:15.18,Default,,0,0,0,,Гал ойынының басты кейіпкері!
Dialogue: 0,0:16:15.26,0:16:18.01,Default,,0,0,0,,Сіздің мергеніңіз әрқашан күзетте екенін есте сақтаңыз!
Dialogue: 0,0:16:18.10,0:16:20.02,Default,,0,0,0,,Жоқ, мен әйеліммен ұрсысып қалдым.
Dialogue: 0,0:16:20.10,0:16:21.98,Default,,0,0,0,,Сондықтан мен оны аяқтайтын адам емеспін.
Dialogue: 0,0:16:22.06,0:16:22.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:22.98,0:16:24.44,Default,,0,0,0,,Әділет
Dialogue: 0,0:16:24.52,0:16:25.69,Default,,0,0,0,,Уф
Dialogue: 0,0:16:26.90,0:16:28.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:28.19,0:16:29.36,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:16:34.28,0:16:36.16,Default,,0,0,0,,Қалай болды?
Dialogue: 0,0:16:36.24,0:16:38.62,Default,,0,0,0,,Кодтық атаумен уақыт өткізу қандай сезімде болды?
Dialogue: 0,0:16:38.70,0:16:41.58,Default,,0,0,0,,Мен қатты қиналдым.
Dialogue: 0,0:16:41.66,0:16:43.83,Default,,0,0,0,,«Ат құйрығы және төс»...
Dialogue: 0,0:16:43.91,0:16:46.08,Default,,0,0,0,,«Таңғажайып маймыл» қайта-қайта шақырылды...
Dialogue: 0,0:16:46.17,0:16:47.84,Default,,0,0,0,,Солай ма? Солай ма?
Dialogue: 0,0:16:47.92,0:16:50.55,Default,,0,0,0,,«Моебако» нені білдіреді?
Dialogue: 0,0:16:50.63,0:16:52.63,Default,,0,0,0,,Менің ойымша, дәл солай...
Dialogue: 0,0:16:52.72,0:16:54.68,Default,,0,0,0,,- (Кимура) Коро-сенсэй - (Коро-сенсэй) Жаңа?
Dialogue: 0,0:16:54.76,0:16:57.47,Default,,0,0,0,,Неліктен мен ғана шын есімімді сақтадым?
Dialogue: 0,0:16:57.55,0:17:01.10,Default,,0,0,0,,Бүгінгі дене шынықтыру сабағының мазмұнын білдім.
Dialogue: 0,0:17:01.18,0:17:04.56,Default,,0,0,0,,Себебі мен сіздің ұтқырлығыңыз пайдалы болады деп ойладым.
Dialogue: 0,0:17:04.64,0:17:07.31,Default,,0,0,0,,Бұрынғыдай салқын болуды шешкенде
Dialogue: 0,0:17:07.40,0:17:10.65,Default,,0,0,0,,«Әділет» деген атау жарасады, солай емес пе?
Dialogue: 0,0:17:10.73,0:17:11.90,Default,,0,0,0,,Шынында~
Dialogue: 0,0:17:11.98,0:17:13.19,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:13.28,0:17:14.40,Default,,0,0,0,,Жан тыныштығы үшін
Dialogue: 0,0:17:14.49,0:17:16.24,Default,,0,0,0,,Айта кету керек, Кимура-кун.
Dialogue: 0,0:17:16.32,0:17:18.62,Default,,0,0,0,,Сіздің атыңыз салыстырмалы түрде қарапайым.
Dialogue: 0,0:17:18.70,0:17:21.24,Default,,0,0,0,,Сіз атауды өзгерту процедурасын аяқтай алуыңыз керек.
Dialogue: 0,0:17:21.33,0:17:22.70,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:17:22.79,0:17:24.62,Default,,0,0,0,,Бірақ, Кимура-кун
Dialogue: 0,0:17:24.71,0:17:27.50,Default,,0,0,0,,Егер сіз мұғалімді өлтіре алсаңыз
Dialogue: 0,0:17:27.58,0:17:31.34,Default,,0,0,0,,Дүние сенің атыңды осылай түсіндірер.
Dialogue: 0,0:17:31.42,0:17:33.46,Default,,0,0,0,,«Бұл тек әділдік».
Dialogue: 0,0:17:33.55,0:17:37.26,Default,,0,0,0,,«Жерді құтқарған батырдың атына лайық».
Dialogue: 0,0:17:37.34,0:17:38.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:38.84,0:17:40.76,Default,,0,0,0,,Маған ата-анам қойған тамаша есім
Dialogue: 0,0:17:40.85,0:17:42.51,Default,,0,0,0,,Шынымды айтсам, бұл көп нәрсені білдірмейді.
Dialogue: 0,0:17:42.60,0:17:43.43,Default,,0,0,0,,Аха…
Dialogue: 0,0:17:43.52,0:17:45.10,Default,,0,0,0,,Мағынасы бар нәрсе
Dialogue: 0,0:17:45.18,0:17:48.44,Default,,0,0,0,,Бұл есімді адам өмірде не істеді?
Dialogue: 0,0:17:48.52,0:17:50.69,Default,,0,0,0,,Есім адамды жасамайды
Dialogue: 0,0:17:50.77,0:17:55.40,Default,,0,0,0,,Адамдардың ізінде тек есімдер қалады.
Dialogue: 0,0:17:55.49,0:18:00.41,Default,,0,0,0,,Неліктен бұл есімді біраз уақыт мұқият сақтамайсыз?
Dialogue: 0,0:18:00.49,0:18:01.87,Default,,0,0,0,,«жарты айды көремін—»
Dialogue: 0,0:18:05.58,0:18:08.50,Default,,0,0,0,,Қастандық шешілгенше
Dialogue: 0,0:18:08.58,0:18:10.08,Default,,0,0,0,,Эй!
Dialogue: 0,0:18:10.17,0:18:11.08,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:13.30,0:18:14.96,Default,,0,0,0,,Мұны істеу керек пе?
Dialogue: 0,0:18:15.05,0:18:15.92,Default,,0,0,0,,Фу…
Dialogue: 0,0:18:16.01,0:18:17.13,Default,,0,0,0,,Енді
Dialogue: 0,0:18:17.22,0:18:19.84,Default,,0,0,0,,Бүгін сізге кодтық атыңызбен қоңырау шалатын күн болды.
Dialogue: 0,0:18:19.93,0:18:22.10,Default,,0,0,0,,Сондай-ақ мұғалімнің кодтық атымен таныстырамын.
Dialogue: 0,0:18:22.18,0:18:25.10,Default,,0,0,0,,Енді мені осы атпен атаңыз.
Dialogue: 0,0:18:25.81,0:18:29.10,Default,,0,0,0,,«Мәңгілік дауылдың тағдыры ханзадасы»
Dialogue: 0,0:18:32.23,0:18:34.61,Default,,0,0,0,,Бір ғана адам, қандай керемет есім!
Dialogue: 0,0:18:34.69,0:18:36.65,Default,,0,0,0,,Ал мына масқара бет не болды?
Dialogue: 0,0:18:36.74,0:18:38.28,Default,,0,0,0,,Нюя! Эй, жақсы емес пе?
Dialogue: 0,0:18:38.36,0:18:40.32,Default,,0,0,0,,Бір күн, солай емес пе? Мен қоңырау шалуға тырыстым ...
Dialogue: 0,0:18:40.41,0:18:42.20,Default,,0,0,0,,Осыдан кейін Коросеней
Dialogue: 0,0:18:42.28,0:18:44.83,Default,,0,0,0,,«Ақылсыз эротикалық тауық сегізаяқ»
Dialogue: 0,0:18:44.91,0:18:45.70,Default,,0,0,0,,Бір күнге шақырылды
Dialogue: 0,0:18:45.70,0:18:46.50,Default,,0,0,0,,Бір күні студенттер ақымақ эротикалық тауық сегізаяқты жасауға шақырылды!
Dialogue: 0,0:18:46.50,0:18:47.45,Default,,0,0,0,,Ақымақ эротикалық тауық сегізаяқ!
Dialogue: 0,0:18:47.54,0:18:48.46,Default,,0,0,0,,Е, сегізаяқ!?
Dialogue: 0,0:18:49.79,0:18:51.63,Default,,0,0,0,,Хаха... қызық болды~
Dialogue: 0,0:18:53.38,0:18:55.00,Default,,0,0,0,,Бүгінгі күн біртүрлі болды, солай емес пе?
Dialogue: 0,0:18:55.09,0:18:56.63,Default,,0,0,0,,Код атауы бойынша класс
Dialogue: 0,0:18:56.71,0:18:57.97,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:18:58.05,0:18:59.84,Default,,0,0,0,,Не? Домалау
Dialogue: 0,0:18:59.93,0:19:01.68,Default,,0,0,0,,Үндемей қал, бейсбол ақымақ
Dialogue: 0,0:19:01.76,0:19:03.97,Default,,0,0,0,,Хахаха, бұл қорқынышты.
Dialogue: 0,0:19:04.05,0:19:05.93,Default,,0,0,0,,Мен біріншіден мағынасын түсінбеймін
Dialogue: 0,0:19:06.01,0:19:08.06,Default,,0,0,0,,Иә! Бұл кім?
Dialogue: 0,0:19:08.14,0:19:10.81,Default,,0,0,0,,Сіз маған «мәңгілік 0» деп жазып, дауыс бердіңіз.
Dialogue: 0,0:19:10.89,0:19:12.06,Default,,0,0,0,,Гикутсу…
Dialogue: 0,0:19:12.15,0:19:13.36,Default,,0,0,0,,Хмм… Бұл не өзі!
Dialogue: 0,0:19:13.44,0:19:15.32,Default,,0,0,0,,Сіз бе?
Dialogue: 0,0:19:15.40,0:19:17.23,Default,,0,0,0,,Ертең кездескенше.
Dialogue: 0,0:19:17.32,0:19:18.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:18.36,0:19:21.99,Default,,0,0,0,,Эй, мен саған бүгін жаман рамен беремін.
Dialogue: 0,0:19:22.07,0:19:22.91,Default,,0,0,0,,Кеттік
Dialogue: 0,0:19:22.99,0:19:24.24,Default,,0,0,0,,Міне, бастаймыз!
Dialogue: 0,0:19:24.32,0:19:27.16,Default,,0,0,0,,Мұның бәрі Терасака-гуми.
Dialogue: 0,0:19:27.24,0:19:28.16,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:19:28.95,0:19:30.16,Default,,0,0,0,,Дәл солай
Dialogue: 0,0:19:30.25,0:19:34.54,Default,,0,0,0,,Біз күн сайын өз жолымызбен жұмыс істей бердік.
Dialogue: 0,0:19:34.63,0:19:36.88,Default,,0,0,0,,Біз «Е тобының соңы»
Dialogue: 0,0:19:36.96,0:19:40.51,Default,,0,0,0,,Қызықты сәттер мәңгілікке созыла алмады.
Dialogue: 0,0:19:44.09,0:19:46.56,Default,,0,0,0,,Екінші семестр қалай өтіп жатыр?
Dialogue: 0,0:19:46.64,0:19:49.73,Default,,0,0,0,,Әрине, мектебіміздің А сыныбында.
Dialogue: 0,0:19:49.81,0:19:53.02,Default,,0,0,0,,Жаман нәрселер болмауы керек.
Dialogue: 0,0:19:53.10,0:19:55.52,Default,,0,0,0,,Кешігулер жоқ
Dialogue: 0,0:19:55.61,0:19:58.61,Default,,0,0,0,,Сәл кешігіп қалған оқушы болса
Dialogue: 0,0:19:58.69,0:20:00.49,Default,,0,0,0,,Мен толық бақылаудамын.
Dialogue: 0,0:20:01.24,0:20:05.45,Default,,0,0,0,,Аралық емтихан үшін біз барлығын бұрынғыдан да жақсырақ етеміз.
Dialogue: 0,0:20:05.53,0:20:07.87,Default,,0,0,0,,Сіз оған сене аласыз.
Dialogue: 0,0:20:07.95,0:20:09.12,Default,,0,0,0,,Тамақтанып алайық па?
Dialogue: 0,0:20:09.20,0:20:13.00,Default,,0,0,0,,Бірінші семестрде Е сыныбына не болды?
Dialogue: 0,0:20:13.08,0:20:15.92,Default,,0,0,0,,Бұл туралы студенттер арасында әлі де айтылып жүр.
Dialogue: 0,0:20:16.75,0:20:19.09,Default,,0,0,0,,Өйткені сен тәжірибесіз адам едің.
Dialogue: 0,0:20:19.17,0:20:20.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:21.17,0:20:22.42,Default,,0,0,0,,Хмм
Dialogue: 0,0:20:25.72,0:20:27.35,Default,,0,0,0,,Мен сені талқандаймын
Dialogue: 0,0:20:27.93,0:20:29.31,Default,,0,0,0,,Мықты адам ретінде
Dialogue: 0,0:20:31.23,0:20:32.77,Default,,0,0,0,,Әрине.
Dialogue: 0,0:20:32.85,0:20:35.06,Default,,0,0,0,,Күштіге күштінің күші.
Dialogue: 0,0:20:35.15,0:20:38.40,Default,,0,0,0,,Әлсіздерге өзін солай ұстауға мүмкіндік беру керек.
Dialogue: 0,0:20:39.23,0:20:42.07,Default,,0,0,0,,Бұл менің білім беру философияма қайшы келеді.
Dialogue: 0,0:20:43.11,0:20:44.57,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:44.66,0:20:49.16,Default,,0,0,0,,Олай болса, мен сендерге нұсқау беруге рұқсат етіңіздер.
Dialogue: 0,0:20:49.24,0:20:53.08,Default,,0,0,0,,Бұл жоғарыда тұрған басшының бейімділігі туралы.
Dialogue: 0,0:20:55.17,0:20:59.17,Default,,0,0,0,,Алдымен қашан және қай жерде жеңгіңіз келетінін ойлаңыз.
Dialogue: 0,0:20:59.25,0:21:00.92,Default,,0,0,0,,Келесі - құралдар.
Dialogue: 0,0:21:01.00,0:21:06.01,Default,,0,0,0,,Ережелердегі олқылықтарды қалай пайдалану керек және сізде бар бөліктерді қалай толық пайдалану керек
Dialogue: 0,0:21:07.59,0:21:09.97,Default,,0,0,0,,Көшбасшыға бейімділік
Dialogue: 0,0:21:10.06,0:21:13.81,Default,,0,0,0,,Егер сенде ондай болмаса, сен менің үстімде тұрмайсың, Асано-кун.
Dialogue: 0,0:21:14.98,0:21:16.23,Default,,0,0,0,,Сол сәтте, контекстке қарамастан, мен бұл тіркесті «дәптерді лақтыру» деген мағынада қолданамын.
Dialogue: 0,0:21:18.65,0:21:20.57,Default,,0,0,0,,Мен саған қабілетімді көрсетемін.
Dialogue: 0,0:21:21.61,0:21:22.86,Default,,0,0,0,,Төраға
Dialogue: 0,0:21:26.07,0:21:31.08,Default,,0,0,0,,♪～
Dialogue: 0,0:22:49.99,0:22:54.99,Default,,0,0,0,,～♪
