Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.25,0:00:05.08,Default,,0,0,0,,Айды және келесі наурызды жою
Dialogue: 0,0:00:05.17,0:00:09.34,Default,,0,0,0,,Жерді қирататынын алдын ала айтқан супер жаратылыс Коросеней
Dialogue: 0,0:00:09.92,0:00:14.34,Default,,0,0,0,,Коросейдің басындағы сыйлық 10 миллиард иен.
Dialogue: 0,0:00:14.43,0:00:16.97,Default,,0,0,0,,Бізге қастандық сеніп тапсырылды.
Dialogue: 0,0:00:17.05,0:00:20.56,Default,,0,0,0,,Кунигаока орта мектебінің 3-сыныбын тастап кеткен Е
Dialogue: 0,0:00:20.64,0:00:22.73,Default,,0,0,0,,Әдетте «Е соңғы тобы» ретінде белгілі
Dialogue: 0,0:00:23.56,0:00:27.65,Default,,0,0,0,,Жазғы демалыста мен Коро-сенсэйдің көптеген әлсіз жақтарын білдім.
Dialogue: 0,0:00:27.73,0:00:30.28,Default,,0,0,0,,Ешқандай нақты қастандыққа әлі қол жеткізілген жоқ.
Dialogue: 0,0:00:30.36,0:00:33.53,Default,,0,0,0,,3 Е сыныбы - қастандық кабинеті
Dialogue: 0,0:00:33.61,0:00:37.45,Default,,0,0,0,,Екінші семестр жақындаған сайын старт қоңырауы бүгін қайта соғылады.
Dialogue: 0,0:00:37.53,0:00:40.91,Default,,0,0,0,,Нуруфуфуфуфу…
Dialogue: 0,0:00:40.99,0:00:46.00,Default,,0,0,0,,♪～
Dialogue: 0,0:02:05.16,0:02:10.17,Default,,0,0,0,,～♪
Dialogue: 0,0:02:17.09,0:02:21.01,Default,,0,0,0,,Жазғы демалыстағы оқу лагері Қастандық сапарының соңғы күні
Dialogue: 0,0:02:21.80,0:02:25.85,Default,,0,0,0,,Біз аралда қалған уақытымызды тамашаладық.
Dialogue: 0,0:02:25.93,0:02:29.19,Default,,0,0,0,,Батылдық сынағы? Қазір бастайсыз ба?
Dialogue: 0,0:02:29.27,0:02:30.15,Default,,0,0,0,,Иә
Dialogue: 0,0:02:30.23,0:02:32.90,Default,,0,0,0,,Жаздың түн ортасында істейтін бірдеңе болса, бұл.
Dialogue: 0,0:02:32.98,0:02:35.86,Default,,0,0,0,,Коросеней тек көңіл көтергісі келеді, солай ма?
Dialogue: 0,0:02:35.94,0:02:37.69,Default,,0,0,0,,Сізге ұқсамайды
Dialogue: 0,0:02:37.78,0:02:40.82,Default,,0,0,0,,Ұстаз, мен көптен бері өз қабығыма жабылдым.
Dialogue: 0,0:02:40.91,0:02:42.78,Default,,0,0,0,,Бұл үлкен оңтүстік арал болса да
Dialogue: 0,0:02:42.87,0:02:45.08,Default,,0,0,0,,Қабілетті сынап көр Көңілді сияқты
Dialogue: 0,0:02:45.16,0:02:45.99,Default,,0,0,0,,Жоқ-қ-қ-қ-қ…
Dialogue: 0,0:02:46.08,0:02:49.08,Default,,0,0,0,,Иә, бірақ мен қорқуды ұнатпаймын.
Dialogue: 0,0:02:49.16,0:02:52.33,Default,,0,0,0,,Уайымдама, уайымдама, сен елестерді өлтіре алмайсың, солай ма?
Dialogue: 0,0:02:52.42,0:02:53.33,Default,,0,0,0,,Демек, шынымен де мұнда жартылай жұмыс істеуді бастапсың ғой.
Dialogue: 0,0:02:53.42,0:02:56.05,Default,,0,0,0,,Нюя Нюя
Dialogue: 0,0:02:53.42,0:02:56.05,Default,,0,0,0,,- (Сугино) Жарайды - (Курахаши) Дұрыс па?
Dialogue: 0,0:02:56.13,0:02:57.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:57.30,0:02:59.97,Default,,0,0,0,,Біз ол кезде білмедік
Dialogue: 0,0:03:00.05,0:03:04.85,Default,,0,0,0,,Коро-сенсэйдің тағы бір ақымақ мақсаты бар еді.
Dialogue: 0,0:03:06.14,0:03:09.10,Default,,0,0,0,,Орналасқан жері - бұл аралдағы су астындағы үңгір.
Dialogue: 0,0:03:09.18,0:03:12.27,Default,,0,0,0,,Шығуға ер және әйел болып жұп болып шығыңыз.
Dialogue: 0,0:03:15.94,0:03:18.74,Default,,0,0,0,,Нагиса, жақсысың ба? Мынадай нәрсе
Dialogue: 0,0:03:18.82,0:03:20.24,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:20.32,0:03:25.62,Default,,0,0,0,,Мен толқу түрімен жақсы шығармын, бірақ маған күтпеген тосын түрі ұнамайды.
Dialogue: 0,0:03:25.70,0:03:27.41,Default,,0,0,0,,Коросейдің жылдамдығы
Dialogue: 0,0:03:27.49,0:03:29.83,Default,,0,0,0,,Егер мені қорқытуға келсең, өте жаман болар еді.
Dialogue: 0,0:03:29.83,0:03:30.71,Default,,0,0,0,,Егер мені қорқытуға келсең, өте жаман болар еді.
Dialogue: 0,0:03:29.83,0:03:30.71,Default,,0,0,0,,(Саншин дыбысы)
Dialogue: 0,0:03:30.79,0:03:33.92,Default,,0,0,0,,Ах... Окинаваның саншынының дыбысы?
Dialogue: 0,0:03:34.00,0:03:40.84,Default,,0,0,0,,(Саншин дыбысы)
Dialogue: 0,0:03:41.47,0:03:42.97,Default,,0,0,0,,шықты!
Dialogue: 0,0:03:43.05,0:03:47.97,Default,,0,0,0,,Бұл қанды қасірет үңгірі.
Dialogue: 0,0:03:48.06,0:03:49.77,Default,,0,0,0,,Рюкю…
Dialogue: 0,0:03:49.85,0:03:56.61,Default,,0,0,0,,Бұл бір кездері шайқаста жеңілген патша әулеттері зорлықпен қаза тапқан жер.
Dialogue: 0,0:03:57.27,0:03:59.32,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:03:59.40,0:04:02.82,Default,,0,0,0,,Бұл оқиғаны шынайырақ етіп көрсету үшін ойдан шығарылған әңгіме болса керек.
Dialogue: 0,0:04:02.90,0:04:04.91,Default,,0,0,0,,Ешқашан ажырамайық
Dialogue: 0,0:04:04.91,0:04:05.37,Default,,0,0,0,,Ешқашан айырылмайық
Dialogue: 0,0:04:04.91,0:04:05.37,Default,,0,0,0,,Уф!
Dialogue: 0,0:04:05.37,0:04:05.45,Default,,0,0,0,,Уф!
Dialogue: 0,0:04:05.45,0:04:06.03,Default,,0,0,0,,Уф!
Dialogue: 0,0:04:05.45,0:04:06.03,Default,,0,0,0,,Жалғыз болсаң, қаңғыбас жандар өлтіреді.
Dialogue: 0,0:04:06.03,0:04:08.74,Default,,0,0,0,,Жалғыз болсаң, қаңғыбас жандар өлтіреді.
Dialogue: 0,0:04:08.83,0:04:10.50,Default,,0,0,0,,А...
Dialogue: 0,0:04:12.33,0:04:17.09,Default,,0,0,0,,Эй... бұл таңқаларлықтай маңызды болуы мүмкін. Тезірек кетейік, Нағиса.
Dialogue: 0,0:04:17.17,0:04:18.46,Default,,0,0,0,,Иә
Dialogue: 0,0:04:18.54,0:04:21.26,Default,,0,0,0,,Бұл қанды қасірет...
Dialogue: 0,0:04:21.34,0:04:24.68,Default,,0,0,0,,Келесі жұпқа бірдей баяндауды тыңдау
Dialogue: 0,0:04:24.76,0:04:26.55,Default,,0,0,0,,Бұл өте шынайы
Dialogue: 0,0:04:26.64,0:04:27.51,Default,,0,0,0,,Құдай-ай!
Dialogue: 0,0:04:27.60,0:04:32.27,Default,,0,0,0,,Нуруфуфуфуфу... сендер шынымен мықты болып кеттіңдер.
Dialogue: 0,0:04:32.35,0:04:36.31,Default,,0,0,0,,Бірақ... Тіпті саған бірдеңе жетіспейді.
Dialogue: 0,0:04:36.40,0:04:37.31,Default,,0,0,0,,Бұл...
Dialogue: 0,0:04:37.40,0:04:39.77,Default,,0,0,0,,Махаббат жанжалы!
Dialogue: 0,0:04:39.86,0:04:41.23,Default,,0,0,0,,Жазға қарай
Dialogue: 0,0:04:41.32,0:04:43.57,Default,,0,0,0,,Мен ерлі-зайыптылар дүниеге келді деп ойладым.
Dialogue: 0,0:04:43.65,0:04:47.57,Default,,0,0,0,,Балалар, сендерге келгенде, сендер қастандықпен әуестеніп кеткендерің сонша, менің ойыма айтатын ештеңе жоқ!
Dialogue: 0,0:04:47.66,0:04:51.83,Default,,0,0,0,,Бір оқ тигенде, мұғалім сізді қорқып артқа итеріп жібереді.
Dialogue: 0,0:04:51.91,0:04:53.66,Default,,0,0,0,,Ер мен әйелді жақындастыру
Dialogue: 0,0:04:53.75,0:04:57.79,Default,,0,0,0,,Оны мазақ ету немесе шынайы оқиғалық роман жазу үшін материал ретінде пайдаланыңыз.
Dialogue: 0,0:04:57.88,0:05:00.50,Default,,0,0,0,,Бұл сынып мұғалімінің ақылды жоспары.
Dialogue: 0,0:05:00.59,0:05:02.55,Default,,0,0,0,,Нуруфуфуфуфу…
Dialogue: 0,0:05:03.84,0:05:06.51,Default,,0,0,0,,Қорықпаудан қорқасың ба?
Dialogue: 0,0:05:06.59,0:05:07.84,Default,,0,0,0,,Иә
Dialogue: 0,0:05:07.93,0:05:12.72,Default,,0,0,0,,Сол кездегі Нағиса-күнді қараңыз. Шынымды айтсам, таң қалдым.
Dialogue: 0,0:05:12.81,0:05:14.68,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:14.77,0:05:17.56,Default,,0,0,0,,Бұл Такаоканы жеңу туралы емес.
Dialogue: 0,0:05:17.65,0:05:19.65,Default,,0,0,0,,Оны жеңгеннен кейін.
Dialogue: 0,0:05:19.73,0:05:22.69,Default,,0,0,0,,Мен мүлде қорықпаймын...
Dialogue: 0,0:05:22.78,0:05:25.53,Default,,0,0,0,,Егер біз төбелессек, мен 100% жеңемін.
Dialogue: 0,0:05:25.61,0:05:29.28,Default,,0,0,0,,Кісі өлтіруші үшін мұндай жеңіс немесе жеңіліс ештеңені білдірмейді.
Dialogue: 0,0:05:29.91,0:05:31.83,Default,,0,0,0,,Мен қорықпаймын
Dialogue: 0,0:05:32.37,0:05:36.29,Default,,0,0,0,,Мен бұл шын мәнінде ең қорқынышты нәрсе екенін алғаш рет түсіндім.
Dialogue: 0,0:05:36.37,0:05:37.62,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:37.71,0:05:39.00,Default,,0,0,0,,-Бірақ... -(Окуда) Ах.
Dialogue: 0,0:05:39.08,0:05:41.50,Default,,0,0,0,,Дегенмен мен жеңілмеймін.
Dialogue: 0,0:05:41.59,0:05:45.72,Default,,0,0,0,,Ұстаз болып өміріңді алатын менмін.
Dialogue: 0,0:05:45.80,0:05:49.47,Default,,0,0,0,,Иә! Мен оны кім өлтіретінін күтемін.
Dialogue: 0,0:05:49.55,0:05:50.93,Default,,0,0,0,,-Айтпақшы - (Окуда) А?
Dialogue: 0,0:05:51.01,0:05:53.22,Default,,0,0,0,,Мұны батылдық сынағы деп атаңыз.
Dialogue: 0,0:05:53.31,0:05:57.39,Default,,0,0,0,,Шындығында, ол ақымақ нәрсе ойлап жатқан сияқты.
Dialogue: 0,0:05:57.48,0:06:01.27,Default,,0,0,0,,Ню... Жұп құру қиын.
Dialogue: 0,0:06:01.36,0:06:03.11,Default,,0,0,0,,Міндетті түрде орындаңыз
Dialogue: 0,0:06:06.15,0:06:10.32,Default,,0,0,0,,Бұл Рюкюдің қанды және қайғылы үңгірі...
Dialogue: 0,0:06:10.41,0:06:13.58,Default,,0,0,0,,Ах! Құбыжық пайда болды!
Dialogue: 0,0:06:13.66,0:06:16.95,Default,,0,0,0,,Кішкентай кезімнен түнде көшеде оларды көргенде, адамдар мені қорқытатын.
Dialogue: 0,0:06:17.04,0:06:21.21,Default,,0,0,0,,Менің лақап атым «Жапонияны көрсететін батылдықтың қате сынағы» болды.
Dialogue: 0,0:06:21.29,0:06:24.80,Default,,0,0,0,,Әй... Көңілді боласың деп үміттенемін.
Dialogue: 0,0:06:24.88,0:06:26.92,Default,,0,0,0,,На Агагага...
Dialogue: 0,0:06:27.01,0:06:29.09,Default,,0,0,0,,Бұл қазір қандай рух?
Dialogue: 0,0:06:29.18,0:06:30.93,Default,,0,0,0,,Расында Рюкю-
Dialogue: 0,0:06:31.01,0:06:32.26,Default,,0,0,0,,Нағыз рух... Ах!
Dialogue: 0,0:06:32.35,0:06:34.10,Default,,0,0,0,,Гах! Менің көзім жоқ!
Dialogue: 0,0:06:34.18,0:06:35.52,Default,,0,0,0,,Уау?
Dialogue: 0,0:06:35.60,0:06:38.10,Default,,0,0,0,,Ах! Мен тайғақ нәрсені сезіндім!
Dialogue: 0,0:06:38.18,0:06:40.10,Default,,0,0,0,,Е! Жапон қуыршақ?
Dialogue: 0,0:06:40.19,0:06:42.90,Default,,0,0,0,,Ах! Шигеру Мизуки мырза?
Dialogue: 0,0:06:42.98,0:06:45.69,Default,,0,0,0,,Ах! Кіреберістегі ескі көкшіл қуыршақ!
Dialogue: 0,0:06:45.78,0:06:49.45,Default,,0,0,0,,Қорқыныштан бәрінен де ләззат алатын адам менмін.
Dialogue: 0,0:06:49.53,0:06:51.86,Default,,0,0,0,,Біз кетеміз бе? Дәл осылай.
Dialogue: 0,0:06:51.95,0:06:55.83,Default,,0,0,0,,А... ха... мен ұялып тұрмын.
Dialogue: 0,0:06:55.91,0:06:58.33,Default,,0,0,0,,Шынымен де ұят
Dialogue: 0,0:06:58.41,0:07:00.00,Default,,0,0,0,,Қысқасы
Dialogue: 0,0:07:00.08,0:07:03.79,Default,,0,0,0,,Ол оларды қорқытуға тырысып, оларды жұп ету үшін аспалы көпір әсерін қолданатынын айтты.
Dialogue: 0,0:07:03.88,0:07:06.59,Default,,0,0,0,,Оларды қорқытпай тұрып, мақсатыңыздың ашылғанына көз жеткізіңіз.
Dialogue: 0,0:07:06.67,0:07:08.34,Default,,0,0,0,,Өйткені... мен оны көргім келді.
Dialogue: 0,0:07:08.42,0:07:11.13,Default,,0,0,0,,Қол ұстасып, ұялшақ болып тұрған екі адамды көргенде күлкің келмей ме?
Dialogue: 0,0:07:11.22,0:07:12.93,Default,,0,0,0,,"Ей! Сіз зинақорлықпен жыныстық қатынасқа түсе алмайсыз" немесе сол сияқты...
Dialogue: 0,0:07:13.01,0:07:14.68,Default,,0,0,0,,Мен жылап жібердім
Dialogue: 0,0:07:14.76,0:07:16.14,Default,,0,0,0,,Ол жиіркенішті ересек адам.
Dialogue: 0,0:07:16.22,0:07:19.18,Default,,0,0,0,,Мұндай нәрселерді жай қалдырыңыз.
Dialogue: 0,0:07:19.27,0:07:23.77,Default,,0,0,0,,Біздің айналамызда романтикалық қарым-қатынасты ұнатпайтын балалар көп.
Dialogue: 0,0:07:23.86,0:07:27.65,Default,,0,0,0,,үшін гей емес.
Dialogue: 0,0:07:27.73,0:07:31.45,Default,,0,0,0,,Накамура-сан, мен түсінемін...
Dialogue: 0,0:07:31.53,0:07:35.20,Default,,0,0,0,,Неге, жігеріңді сынасаң да, соңында ешкім қалмайды.
Dialogue: 0,0:07:35.28,0:07:36.49,Default,,0,0,0,,Мен қорқып, адасып қалдым.
Dialogue: 0,0:07:36.58,0:07:39.95,Default,,0,0,0,,Сондықтан мен тек бір-біріне жабысу пайдасыз дедім.
Dialogue: 0,0:07:40.04,0:07:41.87,Default,,0,0,0,,Түнде демалуға арналған жақсы багаж.
Dialogue: 0,0:07:41.96,0:07:44.17,Default,,0,0,0,,Даусың қатты, ер адамсың!
Dialogue: 0,0:07:44.25,0:07:46.63,Default,,0,0,0,,Әдемі әйелді көрсең, ақырын шығарып сал.
Dialogue: 0,0:07:47.38,0:07:50.47,Default,,0,0,0,,- (Қарасұма) А... - (Ирина) Ух... а...
Dialogue: 0,0:07:50.55,0:07:51.63,Default,,0,0,0,,Иә...
Dialogue: 0,0:07:51.72,0:07:55.09,Default,,0,0,0,,Эй, мен бұл туралы ойладым ...
Dialogue: 0,0:07:55.18,0:07:57.47,Default,,0,0,0,,Қаншық Сенсей...
Dialogue: 0,0:07:57.56,0:07:58.47,Default,,0,0,0,,Иә
Dialogue: 0,0:07:58.56,0:07:59.64,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:07:59.72,0:08:03.56,Default,,0,0,0,,Ертең таңертең үйге барғанша уақытым бар...
Dialogue: 0,0:08:03.64,0:08:06.19,Default,,0,0,0,,Оны бір-біріне жабыстырғыңыз келе ме?
Dialogue: 0,0:08:06.27,0:08:08.90,Default,,0,0,0,,Соңында барлығы гей болды.
Dialogue: 0,0:08:09.53,0:08:12.99,Default,,0,0,0,,Осылайша соңғы операция басталды.
Dialogue: 0,0:08:13.86,0:08:16.32,Default,,0,0,0,,А, мен мұны істей алмаймын!
Dialogue: 0,0:08:16.41,0:08:18.70,Default,,0,0,0,,Сезімсіздіктің шегі бар.
Dialogue: 0,0:08:18.78,0:08:24.50,Default,,0,0,0,,Қаншық, бұл таңқаларлық, өйткені сен еркектерді еркін басқара аласың.
Dialogue: 0,0:08:24.58,0:08:27.34,Default,,0,0,0,,Сіз ғашықтық өміріңізге келгенде кешігіп қалдыңыз, солай емес пе?
Dialogue: 0,0:08:27.42,0:08:30.59,Default,,0,0,0,,Махаббат? Ха, мен қалжыңдамаймын.
Dialogue: 0,0:08:30.67,0:08:32.26,Default,,0,0,0,,Иә, солай емес пе?
Dialogue: 0,0:08:32.34,0:08:36.26,Default,,0,0,0,,Бұл әдеттен тыс, өйткені ол әлемдік деңгейдегі тіке киген адам.
Dialogue: 0,0:08:37.05,0:08:40.97,Default,,0,0,0,,Мен ренжідім де, оны байсалдылыққа жеткізгім келіп жатқанда...
Dialogue: 0,0:08:42.35,0:08:45.31,Default,,0,0,0,,Солардың бірі...
Dialogue: 0,0:08:45.39,0:08:46.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:46.35,0:08:48.56,Default,,0,0,0,,Мен оны сүйкімді деп ойладым
Dialogue: 0,0:08:48.65,0:08:49.94,Default,,0,0,0,,Біраз қорлайтын
Dialogue: 0,0:08:50.02,0:08:50.86,Default,,0,0,0,,Не!
Dialogue: 0,0:08:50.94,0:08:54.20,Default,,0,0,0,,Қаншық ебедейсіз адамға ұқсайды.
Dialogue: 0,0:08:54.28,0:08:59.16,Default,,0,0,0,,Менің жинақтаған тәжірибем кедергі жасап жатыр деп ойлаймын және мен өз сезімдеріммен шын айта алмаймын.
Dialogue: 0,0:08:59.24,0:09:02.16,Default,,0,0,0,,- (Маэхара) Жарайды, бізге қалдырыңыз. - (Ирина) Әй?
Dialogue: 0,0:09:02.25,0:09:04.75,Default,,0,0,0,,Екеумізге орнатайық.
Dialogue: 0,0:09:04.83,0:09:05.96,Default,,0,0,0,,Зұлым орыннан қозғалмайды!
Dialogue: 0,0:09:07.08,0:09:08.42,Default,,0,0,0,,Балалар...
Dialogue: 0,0:09:10.38,0:09:12.38,Default,,0,0,0,,Махаббат бойынша кеңесші
Dialogue: 0,0:09:12.46,0:09:14.76,Default,,0,0,0,,3 курс Е сыныбының жиналысы басталады.
Dialogue: 0,0:09:14.84,0:09:16.63,Default,,0,0,0,,Көңілді сегізаяқ
Dialogue: 0,0:09:16.72,0:09:20.26,Default,,0,0,0,,Әріптесіңіздің махаббат өмірін қолдау табиғи нәрсе.
Dialogue: 0,0:09:20.35,0:09:23.89,Default,,0,0,0,,Ұстаз әйелдің ер адамға ғашық болған құмарлық күндері
Dialogue: 0,0:09:23.98,0:09:27.02,Default,,0,0,0,,Мен тәтті және қышқыл таза махаббат романын жаза алатындай сезінемін.
Dialogue: 0,0:09:27.10,0:09:29.73,Default,,0,0,0,,Эротикалық романды анық жоспарлау
Dialogue: 0,0:09:29.81,0:09:33.86,Default,,0,0,0,,Біріншіден, қаншық, киім үлгісің нашар.
Dialogue: 0,0:09:33.94,0:09:35.65,Default,,0,0,0,,- (Ирина) А? -(Накамура) Дұрыс.
Dialogue: 0,0:09:35.74,0:09:37.91,Default,,0,0,0,,Өзіңді әшкерелеу дұрыс па?
Dialogue: 0,0:09:37.99,0:09:42.16,Default,,0,0,0,,Маған Карасума мырза сияқты ресми жапондықтар ұнамайды.
Dialogue: 0,0:09:42.24,0:09:44.75,Default,,0,0,0,,Бізге таза түрде шабуыл жасау керек.
Dialogue: 0,0:09:44.83,0:09:47.58,Default,,0,0,0,,А... Иә, ұқыпты...
Dialogue: 0,0:09:47.67,0:09:50.63,Default,,0,0,0,,Шынымды айтсам, бұл Канзаки-чан шығар.
Dialogue: 0,0:09:50.71,0:09:51.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:51.63,0:09:54.51,Default,,0,0,0,,Кеше киген киімің құрғақ болса, маған қарызға бере аласың ба?
Dialogue: 0,0:09:54.59,0:09:56.01,Default,,0,0,0,,Неге дүкен сатушысынан сұрамайсыз?
Dialogue: 0,0:09:56.76,0:10:00.64,Default,,0,0,0,,Қараңызшы, мен ұқыпты және тазамын, киім-кешекпен ғана... хмм...
Dialogue: 0,0:10:00.72,0:10:03.35,Default,,0,0,0,,Нана... Керісінше эротикалық.
Dialogue: 0,0:10:03.43,0:10:06.35,Default,,0,0,0,,Біріншіден, барлық өлшемдер сәйкес келмейді.
Dialogue: 0,0:10:06.43,0:10:10.06,Default,,0,0,0,,Канзаки мырза осындай сексуалды киім киген деп ойлау...
Dialogue: 0,0:10:10.15,0:10:13.65,Default,,0,0,0,,Жетер, мен эротикалық сезімге бой алдырмаймын.
Dialogue: 0,0:10:13.73,0:10:16.99,Default,,0,0,0,,Кеудеге қарағанда маңыздысы – адамдар арасындағы үйлесімділік.
Dialogue: 0,0:10:17.07,0:10:18.03,Default,,0,0,0,,Иә, иә, иә
Dialogue: 0,0:10:18.11,0:10:21.24,Default,,0,0,0,,Қарасума мырзаның нені ұнататынын кім біледі?
Dialogue: 0,0:10:21.32,0:10:23.62,Default,,0,0,0,,Аа, қазір ойлап қарасам, бұрын
Dialogue: 0,0:10:23.70,0:10:27.16,Default,,0,0,0,,Мен тележарнамада ол кісіні мақтадым.
Dialogue: 0,0:10:27.25,0:10:29.08,Default,,0,0,0,,«Бұл менің идеал түрім».
Dialogue: 0,0:10:29.75,0:10:34.30,Default,,0,0,0,,Ол сүйкімді, оның беті мен денесі идеалды.
Dialogue: 0,0:10:34.38,0:10:36.38,Default,,0,0,0,,Сондай-ақ үш адам бар!
Dialogue: 0,0:10:36.46,0:10:38.30,Default,,0,0,0,,Бұл тамаша күш емес пе!
Dialogue: 0,0:10:38.38,0:10:41.84,Default,,0,0,0,,Олай болса... үйде тамақ пісіруге ше?
Dialogue: 0,0:10:41.93,0:10:44.10,Default,,0,0,0,,Қонақ үйдегі кешкі ас та сәнді.
Dialogue: 0,0:10:44.18,0:10:47.52,Default,,0,0,0,,Қарасума мырзаның жақсы көретін асын екеуміз ғана жасауға батылы бардық.
Dialogue: 0,0:10:47.60,0:10:48.93,Default,,0,0,0,,Қарасума мырза
Dialogue: 0,0:10:49.02,0:10:52.06,Default,,0,0,0,,Мен сіздің гамбургер немесе кесе кеспеден басқа ештеңе жегеніңізді көрген емеспін.
Dialogue: 0,0:10:52.15,0:10:55.11,Default,,0,0,0,,Егер солай болса, бұл екі адамға тым көп.
Dialogue: 0,0:10:55.19,0:10:59.07,Default,,0,0,0,,Ню... Оған орын тым аз!
Dialogue: 0,0:10:59.15,0:11:03.32,Default,,0,0,0,,Қарасума-сені кінәлі деп ойлай бастадым.
Dialogue: 0,0:11:03.41,0:11:04.45,Default,,0,0,0,,Дұрыс? Дұрыс па?
Dialogue: 0,0:11:04.53,0:11:08.29,Default,,0,0,0,,Ұстазымның әзілдері қанша рет еленбей қалды?
Dialogue: 0,0:11:08.37,0:11:12.17,Default,,0,0,0,,Ешқандай амалсыз Қарасума-сенсiнiң iшiндегi iстелiп кете бастады.
Dialogue: 0,0:11:12.25,0:11:13.96,Default,,0,0,0,,Қалай болғанда да
Dialogue: 0,0:11:14.04,0:11:16.34,Default,,0,0,0,,Кешкі асқа дейін қолдан келгеннің бәрін жасайық.
Dialogue: 0,0:11:16.42,0:11:18.96,Default,,0,0,0,,Қыздар сәндеуге көмектесе алады
Dialogue: 0,0:11:19.05,0:11:22.09,Default,,0,0,0,,Ұлдар үшін екі орындық жақсы көңіл-күймен орнатылады.
Dialogue: 0,0:11:22.18,0:11:23.72,Default,,0,0,0,,Иә
Dialogue: 0,0:11:23.80,0:11:24.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:30.43,0:11:33.85,Default,,0,0,0,,үшін тамақтанып жатыр деп естідім, бірақ бұл не болды? Бұл
Dialogue: 0,0:11:33.94,0:11:37.27,Default,,0,0,0,,Қарасума мырзаның орны жоқ.
Dialogue: 0,0:11:37.36,0:11:40.19,Default,,0,0,0,,Е сыныбының мамандығы: Сенсейдің қорылдауы
Dialogue: 0,0:11:40.28,0:11:42.20,Default,,0,0,0,,Ұстаздар мазасыз
Dialogue: 0,0:11:42.28,0:11:45.57,Default,,0,0,0,,Сыртта тамақтаныңыз.
Dialogue: 0,0:11:45.66,0:11:47.20,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:11:48.74,0:11:50.75,Default,,0,0,0,,Кенеттен не болды?
Dialogue: 0,0:11:50.83,0:11:54.79,Default,,0,0,0,,Мен қазіргі кезде кіші мектеп оқушыларының не ойлап жүргенін түсінбеймін.
Dialogue: 0,0:12:00.72,0:12:03.18,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:12:03.26,0:12:04.09,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:07.93,0:12:10.02,Default,,0,0,0,,Неліктен біз ғана қуылды?
Dialogue: 0,0:12:10.10,0:12:12.39,Default,,0,0,0,,А, а... жүр.
Dialogue: 0,0:12:12.48,0:12:14.65,Default,,0,0,0,,Мына орамалға не болды?
Dialogue: 0,0:12:12.48,0:12:14.65,Default,,0,0,0,,Иносукэ, кешір мені. Егер оны ертерек байқап қалсам...
Dialogue: 0,0:12:14.73,0:12:17.27,Default,,0,0,0,,Дүкенде сатып алыңыз, тігін машинасын жалға алыңыз
Dialogue: 0,0:12:17.36,0:12:19.65,Default,,0,0,0,,Интернетте іздеу кезінде брендке ұқсайтындай етіп ұйымдастырылған
Dialogue: 0,0:12:19.73,0:12:21.86,Default,,0,0,0,,Хара мырза үй шаруашылығында мықты.
Dialogue: 0,0:12:21.94,0:12:25.57,Default,,0,0,0,,Өріс орнатылды. Бар! қаншық мұғалім
Dialogue: 0,0:12:27.95,0:12:32.37,Default,,0,0,0,,Мұндай орамал қоғамда пайдасыз.
Dialogue: 0,0:12:33.21,0:12:36.25,Default,,0,0,0,,Дастархан бастыру да өнерпаздық жұмыс
Dialogue: 0,0:12:36.33,0:12:40.17,Default,,0,0,0,,Мен жұмыс үшін пайдаланған бірінші дәрежелі дүкендерден үлкен айырмашылық бар.
Dialogue: 0,0:12:40.25,0:12:41.09,Default,,0,0,0,,Манга салмас бұрын жаттығулар
Dialogue: 0,0:12:41.84,0:12:45.09,Default,,0,0,0,,Құпиялылығы немесе кішіпейілділігі жоқ Хеклерлер
Dialogue: 0,0:12:46.97,0:12:47.97,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:12:48.64,0:12:52.52,Default,,0,0,0,,Не? Бұл қызық емес пе?
Dialogue: 0,0:12:52.60,0:12:55.81,Default,,0,0,0,,Мен сендерді сәл ғана жақсы көремін.
Dialogue: 0,0:12:55.90,0:13:00.15,Default,,0,0,0,,Жасайық. Мен бұл қатты жігітті құлатамын.
Dialogue: 0,0:13:07.45,0:13:09.66,Default,,0,0,0,,Бұл сапарда көп нәрсе болды.
Dialogue: 0,0:13:09.74,0:13:10.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:10.78,0:13:12.70,Default,,0,0,0,,Бірақ егін де болды.
Dialogue: 0,0:13:12.79,0:13:14.96,Default,,0,0,0,,Күтпеген жерден
Dialogue: 0,0:13:15.04,0:13:17.92,Default,,0,0,0,,Оқушылардың негізгі білімді меңгергені расталды.
Dialogue: 0,0:13:18.63,0:13:22.00,Default,,0,0,0,,Осы қарқынмен мен сені екінші семестрде міндетті түрде өлтіремін.
Dialogue: 0,0:13:22.09,0:13:26.13,Default,,0,0,0,,Ирина, мен де сенің күшіңе сенемін.
Dialogue: 0,0:13:27.01,0:13:28.84,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:33.77,0:13:34.73,Default,,0,0,0,,Не болды?
Dialogue: 0,0:13:42.73,0:13:45.44,Default,,0,0,0,,Сәлем Қарасума
Dialogue: 0,0:13:47.40,0:13:52.49,Default,,0,0,0,,Сіз шынымен өлтірудің не екенін білесіз бе?
Dialogue: 0,0:13:56.62,0:13:59.50,Default,,0,0,0,,Біз дымқыл нәрсе туралы сөйлестік.
Dialogue: 0,0:14:00.71,0:14:03.75,Default,,0,0,0,,Сондай-ақ... майлықты көп қоймаңыз.
Dialogue: 0,0:14:03.84,0:14:04.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:08.63,0:14:09.93,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:17.56,0:14:19.40,Default,,0,0,0,,Мен сені сүйемін Қарасума
Dialogue: 0,0:14:19.48,0:14:20.60,Default,,0,0,0,,Жарайды, тікелей іске кірісейік. Шинигамиңді Мисакиге де көрсет.
Dialogue: 0,0:14:30.74,0:14:33.24,Default,,0,0,0,,Ақымақ, ақымақ, ақымақ, өл!
Dialogue: 0,0:14:33.33,0:14:36.45,Default,,0,0,0,,Егер сіздің ниетіңіз мойындау болса, бірақ сіз біреуді өлтіріп алсаңыз, не істейсіз?
Dialogue: 0,0:14:36.54,0:14:38.91,Default,,0,0,0,,Дәл қазір бұл жарымжан сүйісу не болды?
Dialogue: 0,0:14:39.71,0:14:42.42,Default,,0,0,0,,Әдеттегідей тіліңді ішке сал! Тіл!
Dialogue: 0,0:14:42.50,0:14:44.50,Default,,0,0,0,,Әй, тым көп шу шығарып жатырсыңдар, балалар!
Dialogue: 0,0:14:44.59,0:14:46.71,Default,,0,0,0,,Үлкендердің өз жағдайлары бар!
Dialogue: 0,0:14:46.80,0:14:49.76,Default,,0,0,0,,Жоқ, жоқ, ол осы жерден уақытын алады.
Dialogue: 0,0:14:49.84,0:14:52.39,Default,,0,0,0,,Бұзық болып шығады, солай ма?
Dialogue: 0,0:14:52.47,0:14:54.18,Default,,0,0,0,,«Әй?» деме. Эротикалық сегізаяқ!
Dialogue: 0,0:14:57.39,0:14:59.73,Default,,0,0,0,,Мен бұл туралы терең ойланбаймын.
Dialogue: 0,0:14:59.81,0:15:01.85,Default,,0,0,0,,Өйткені бұл менің миссиям.
Dialogue: 0,0:15:03.02,0:15:04.69,Default,,0,0,0,,О, Құдай-ай…➡
Dialogue: 0,0:15:04.77,0:15:07.57,Default,,0,0,0,,Екінші семестрде бұдан да қаттырақ дайындалыңыз
Dialogue: 0,0:15:07.65,0:15:10.15,Default,,0,0,0,,Одан да мен сені өлтіремін.
Dialogue: 0,0:15:10.24,0:15:14.66,Default,,0,0,0,,Осылай біздің қастандық сапарымыз аяқталды.
Dialogue: 0,0:15:19.58,0:15:22.75,Default,,0,0,0,,Айтпақшы, бұл соңғысы не?
Dialogue: 0,0:15:22.83,0:15:25.75,Default,,0,0,0,,Жаңа әдіс-тәсілдерді жаттықтыруға келгенде қатты әсерленемін.
Dialogue: 0,0:15:31.97,0:15:35.47,Default,,0,0,0,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,0:15:35.55,0:15:40.48,Default,,0,0,0,,Біз әрқайсымыз жазғы демалыстың соңғы күнін өткіздік.
Dialogue: 0,0:15:43.69,0:15:46.44,Default,,0,0,0,,Анаңмен жақсы араласасың ба?
Dialogue: 0,0:15:46.52,0:15:47.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:49.15,0:15:51.74,Default,,0,0,0,,Қиын болу керек, өйткені мінезің қатал.
Dialogue: 0,0:15:52.28,0:15:55.24,Default,,0,0,0,,Әкемнің жалғыз қашып кеткені қынжылтады.
Dialogue: 0,0:15:56.37,0:15:57.45,Default,,0,0,0,,Жарайды
Dialogue: 0,0:15:57.53,0:16:00.54,Default,,0,0,0,,Көңіл-күйіңді жоғалтпасаң, тым қатал емес.
Dialogue: 0,0:16:01.91,0:16:03.04,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:03.79,0:16:05.67,Default,,0,0,0,,Одан да көп... Иә?
Dialogue: 0,0:16:06.71,0:16:08.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:08.17,0:16:10.59,Default,,0,0,0,,Не болды? кенет үнсіз қалды
Dialogue: 0,0:16:10.67,0:16:12.42,Default,,0,0,0,,Жазғы фестиваль?
Dialogue: 0,0:16:12.51,0:16:13.97,Default,,0,0,0,,Жазбаша жазу Жазбаша жазу
Dialogue: 0,0:16:21.39,0:16:23.35,Default,,0,0,0,,- (Коро-сенсэй) Ас бергеніңізге рахмет! -(Нағиса) А...
Dialogue: 0,0:16:23.44,0:16:25.44,Default,,0,0,0,,Тамақ бергеніңіз үшін рахмет! әке
Dialogue: 0,0:16:25.52,0:16:27.48,Default,,0,0,0,,Ой, эй... Амансың ба?
Dialogue: 0,0:16:27.56,0:16:29.57,Default,,0,0,0,,Менің айналысатын істерім бар.
Dialogue: 0,0:16:30.28,0:16:33.65,Default,,0,0,0,,Олай болса, әке, өзіңізді күтіңіз.
Dialogue: 0,0:16:37.87,0:16:41.25,Default,,0,0,0,,Жарқырап қалды, Нағиса
Dialogue: 0,0:16:42.16,0:16:44.29,Default,,0,0,0,,Иә? фестиваль?
Dialogue: 0,0:16:44.37,0:16:47.84,Default,,0,0,0,,Бүгін мен сабаққа кірісіп, сыныптағылардың бәрін шақырдым.
Dialogue: 0,0:16:47.92,0:16:51.51,Default,,0,0,0,,Менімен бизнес жасаудан бас тартқан адамдардың күтпеген саны мені ренжітті.
Dialogue: 0,0:16:52.30,0:16:54.43,Default,,0,0,0,,Жарайды, бірақ
Dialogue: 0,0:16:54.51,0:16:55.51,Default,,0,0,0,,сені бәсекелес деп санайтын Бакуго мен Тодороки емес
Dialogue: 0,0:16:55.59,0:16:58.18,Default,,0,0,0,,Мен бәрібір ойнап жүрдім.
Dialogue: 0,0:16:59.85,0:17:01.68,Default,,0,0,0,,Бұл фестиваль…
Dialogue: 0,0:17:02.35,0:17:05.89,Default,,0,0,0,,Мақсаттан шақыру Рахмет
Dialogue: 0,0:17:05.98,0:17:08.77,Default,,0,0,0,,Өкінішке орай, мен басқа жұмысқа байланысты қазір Жапонияда емеспін.
Dialogue: 0,0:17:08.86,0:17:09.73,Default,,0,0,0,,Нюя!
Dialogue: 0,0:17:09.82,0:17:11.86,Default,,0,0,0,,Мен сені алып кетейін.
Dialogue: 0,0:17:11.94,0:17:16.07,Default,,0,0,0,,Доктор Қарасума кездесуі бар ма, әлде бірдеңе ме деп келмейді.
Dialogue: 0,0:17:16.16,0:17:18.20,Default,,0,0,0,,Дөрекі болма, мен жұмыстамын.
Dialogue: 0,0:17:18.28,0:17:22.79,Default,,0,0,0,,Менің таңдауым жоқ. Кез келген уақытта келіп мені өлтіріңіз.
Dialogue: 0,0:17:22.87,0:17:24.41,Default,,0,0,0,,Айтудың қажеті жоқ
Dialogue: 0,0:17:24.50,0:17:25.54,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:27.12,0:17:29.54,Default,,0,0,0,,Қарасумада естігенім бойынша
Dialogue: 0,0:17:29.63,0:17:31.25,Default,,0,0,0,,Сол бала
Dialogue: 0,0:17:31.34,0:17:35.55,Default,,0,0,0,,Мен үйреткен құпия әдісті нақты ұрыста еш қиындықсыз пайдалана білді.
Dialogue: 0,0:17:36.09,0:17:40.05,Default,,0,0,0,,Әр елде таланттар бар.
Dialogue: 0,0:17:40.14,0:17:43.35,Default,,0,0,0,,Оны Жапонияда қалдыру ұят болар...
Dialogue: 0,0:17:43.97,0:17:44.81,Default,,0,0,0,,Әй!
Dialogue: 0,0:17:50.23,0:17:53.53,Default,,0,0,0,,Мен туғаннан бері мен әрқашан болдым
Dialogue: 0,0:17:54.40,0:17:55.53,Default,,0,0,0,,Сіздің қасыңызда
Dialogue: 0,0:18:05.12,0:18:07.21,Default,,0,0,0,,Қорықпа
Dialogue: 0,0:18:07.79,0:18:09.83,Default,,0,0,0,,Өлім құдайының аты
Dialogue: 0,0:18:16.51,0:18:18.05,Default,,0,0,0,,Сіз маған бонус бердіңіз.
Dialogue: 0,0:18:18.13,0:18:19.18,Default,,0,0,0,,Сіз мұны істедіңіз.
Dialogue: 0,0:18:19.26,0:18:21.14,Default,,0,0,0,,Нуфуфуфуфу…
Dialogue: 0,0:18:22.01,0:18:23.60,Default,,0,0,0,,Свиш
Dialogue: 0,0:18:23.68,0:18:24.64,Default,,0,0,0,,Жоқ
Dialogue: 0,0:18:24.72,0:18:27.94,Default,,0,0,0,,Мен күткеннен де көп адам келгеніне қуаныштымын.
Dialogue: 0,0:18:28.02,0:18:31.56,Default,,0,0,0,,Егер ешкім келмесе, профессор, мен өз-өзіме қол жұмсау туралы ойладым.
Dialogue: 0,0:18:31.65,0:18:34.27,Default,,0,0,0,,Ендеше, келмегені жақсы болды ма?
Dialogue: 0,0:18:34.36,0:18:35.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:36.94,0:18:40.32,Default,,0,0,0,,Чиба-кун Хайами-сан? Неліктен ол сызылған?
Dialogue: 0,0:18:40.41,0:18:42.91,Default,,0,0,0,,Атуға тыйым салынады
Dialogue: 0,0:18:42.99,0:18:45.16,Default,,0,0,0,,Оңай болғаны сонша, мені елең еткізді.
Dialogue: 0,0:18:45.24,0:18:46.29,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:18:46.37,0:18:48.16,Default,,0,0,0,,-Эй ағай-(Нағиса) А?
Dialogue: 0,0:18:46.37,0:18:48.16,Default,,0,0,0,,Бұл туралы не істеуім керек...
Dialogue: 0,0:18:48.25,0:18:51.67,Default,,0,0,0,,Мен қазір 5000 иен жұмсаймын, ал бәрі 5-сыныптан төмен, солай ма?
Dialogue: 0,0:18:51.75,0:18:53.92,Default,,0,0,0,,Иірілген жіп пен бұйымдардың қалған санынан
Dialogue: 0,0:18:54.00,0:18:57.88,Default,,0,0,0,,4-ші немесе одан жоғары сынып бір рет болса да пайда болмау ықтималдығын есептеу
Dialogue: 0,0:18:57.97,0:19:00.76,Default,,0,0,0,,Үлкен 0,05%
Dialogue: 0,0:19:00.84,0:19:03.22,Default,,0,0,0,,Шынында да хит ағын бар ма?
Dialogue: 0,0:19:03.30,0:19:05.97,Default,,0,0,0,,Полиция қызметкерін шақырып, тексере аласыз ба?
Dialogue: 0,0:19:06.06,0:19:09.85,Default,,0,0,0,,Мен... түсіндім. Мен сізге қайтарамын, сондықтан үндемеңіз. Бала?
Dialogue: 0,0:19:09.94,0:19:13.94,Default,,0,0,0,,Жоқ, мен ақшаны қайтару үшін 5000 иен салған жоқпын.
Dialogue: 0,0:19:14.02,0:19:15.77,Default,,0,0,0,,Мен ойын консолін алғым келеді~
Dialogue: 0,0:19:15.86,0:19:18.19,Default,,0,0,0,,Карма-кун, сен сондай бұзықсың.
Dialogue: 0,0:19:18.28,0:19:21.82,Default,,0,0,0,,Сіз джекпотты жеңе алмайтыныңызды басынан-ақ білдіңіз.
Dialogue: 0,0:19:22.95,0:19:23.78,Default,,0,0,0,,О!
Dialogue: 0,0:19:23.87,0:19:27.54,Default,,0,0,0,,Әдеттегідей, бәрін тегіс істе, Исағай.
Dialogue: 0,0:19:27.62,0:19:31.12,Default,,0,0,0,,Міне, айла. Бұл пышақпен кесу сезіміне өте ұқсас.
Dialogue: 0,0:19:31.21,0:19:33.50,Default,,0,0,0,,Ал 1-сыныпты Джудзюцу сиқыршысы лауазымына ұсыныс жасауға келетін болсақ, мен оны қуана қабылдаймын.
Dialogue: 0,0:19:33.58,0:19:35.25,Default,,0,0,0,,Өйткені біз кедейміз
Dialogue: 0,0:19:35.34,0:19:37.63,Default,,0,0,0,,Мен 100 иенге бір тамақ алғаныма ризамын.
Dialogue: 0,0:19:37.71,0:19:38.55,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:19:38.63,0:19:40.38,Default,,0,0,0,,Пісіру, қуыру, қуыру...
Dialogue: 0,0:19:40.47,0:19:42.22,Default,,0,0,0,,Не!? Сіз оны жейсіз бе?
Dialogue: 0,0:19:43.22,0:19:44.93,Default,,0,0,0,,үшін көп ақша табуда.
Dialogue: 0,0:19:45.01,0:19:49.18,Default,,0,0,0,,Иә, сіз қастандық әдістерінің нәзік аспектілерін пайдалана аласыз.
Dialogue: 0,0:19:49.27,0:19:50.93,Default,,0,0,0,,Мистер Бич
Dialogue: 0,0:19:51.02,0:19:54.06,Default,,0,0,0,,Мен сауда палатасының шатырында тегін алкогольді ішіп жатырмын.
Dialogue: 0,0:19:54.15,0:19:55.19,Default,,0,0,0,,Короссей туралы не деуге болады?
Dialogue: 0,0:19:55.27,0:19:58.82,Default,,0,0,0,,Айдың аяғында мен үнемі ақша тапшымын, сондықтан мені өлтірмеңдер
Dialogue: 0,0:19:58.90,0:19:59.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:59.82,0:20:01.99,Default,,0,0,0,,Сіз түнгі барды басқарасыз ба?
Dialogue: 0,0:20:02.53,0:20:05.20,Default,,0,0,0,,Біз бұтақтардың санын біртіндеп көбейтеміз.
Dialogue: 0,0:20:05.28,0:20:09.12,Default,,0,0,0,,Әркім өз ақшасын тауып, ерте жабылған дүкеннің кеңістігін енгізіңіз.
Dialogue: 0,0:20:09.20,0:20:10.33,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:20:10.41,0:20:14.79,Default,,0,0,0,,Біз байқамай қалталы ақша тауып жүргендерге айналдық па?
Dialogue: 0,0:20:14.88,0:20:20.76,Default,,0,0,0,,(отшашулардың дыбысы)
Dialogue: 0,0:20:20.84,0:20:22.97,Default,,0,0,0,,Уау, өте әдемі~
Dialogue: 0,0:20:23.05,0:20:24.72,Default,,0,0,0,,Хаха керемет
Dialogue: 0,0:20:24.80,0:20:28.68,Default,,0,0,0,,- (Маэхара) Ахахха... - (Исогай) Уау~ Әдемі екен~
Dialogue: 0,0:20:28.76,0:20:30.85,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:20:31.60,0:20:34.90,Default,,0,0,0,,(отшашулардың дыбысы)
Dialogue: 0,0:20:34.98,0:20:38.36,Default,,0,0,0,,Қараңғы жазғы демалыс болды
Dialogue: 0,0:20:38.44,0:20:39.36,Default,,0,0,0,,Иә
Dialogue: 0,0:20:41.57,0:20:46.28,Default,,0,0,0,,Бірақ екінші семестрде бұл одан да күштірек болады деп ойлаймын.
Dialogue: 0,0:20:46.37,0:20:50.37,Default,,0,0,0,,Егер сіз бір адамды өлтірсеңіз, ол бәрібір 10 млрд.
Dialogue: 0,0:20:50.45,0:20:52.25,Default,,0,0,0,,Жазғы демалыс туралы есеп
Dialogue: 0,0:20:52.33,0:20:55.92,Default,,0,0,0,,Топтық тактика оны бұғаттағанын ескерсек.
Dialogue: 0,0:20:56.00,0:21:00.59,Default,,0,0,0,,Егер топ өлтіруді сәтті орындаса, қосымша ақы төленеді.
Dialogue: 0,0:21:00.67,0:21:03.17,Default,,0,0,0,,Жүлдені тиімді арттыру
Dialogue: 0,0:21:03.26,0:21:06.05,Default,,0,0,0,,Жалпы сома: 30 миллиард иен
Dialogue: 0,0:21:09.39,0:21:11.22,Default,,0,0,0,,Бұл сыныпта белгілі нәрсе
Dialogue: 0,0:21:11.31,0:21:16.10,Default,,0,0,0,,Біз де, Коросей де ешқашан бұлай бітпейді.
Dialogue: 0,0:21:17.60,0:21:21.90,Default,,0,0,0,,Күтілгендей, екінші семестр үлкен күйзеліспен басталады.
Dialogue: 0,0:21:25.99,0:21:30.99,Default,,0,0,0,,♪～
Dialogue: 0,0:22:49.91,0:22:54.91,Default,,0,0,0,,～♪
