Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.30,0:00:06.63,Default,,0,0,0,,（♪）
Dialogue: 0,0:01:35.19,0:01:38.23,Default,,0,0,0,,Біз қазір «шайтан» деп аталатын болмыспен өмір сүріп жатырмыз
Dialogue: 0,0:01:38.33,0:01:39.76,Default,,0,0,0,,Күресуге тырысу
Dialogue: 0,0:01:40.60,0:01:43.53,Default,,0,0,0,,Ғылымның сиқыры арқылы адамдар
Dialogue: 0,0:01:43.67,0:01:46.17,Default,,0,0,0,,Бұл өзінің дамыған нұсқасы ма?
Dialogue: 0,0:01:46.60,0:01:50.41,Default,,0,0,0,,Сондай-ақ адамзаттың алдында тұрған ақырзаман.
Dialogue: 0,0:01:50.54,0:01:53.14,Default,,0,0,0,,Мүмкін бұл дайындалған сценарий шығар.
Dialogue: 0,0:01:54.21,0:01:55.28,Default,,0,0,0,,Армагеддон?
Dialogue: 0,0:01:55.41,0:01:57.85,Default,,0,0,0,,Иә? Ал, серіппелі орамдарда не болды?
Dialogue: 0,0:01:58.61,0:02:00.52,Default,,0,0,0,,Күтіп тұрған жоғары жастағы жасөспірімдер
Dialogue: 0,0:02:00.68,0:02:02.78,Default,,0,0,0,,Бұл жерде сүрінуге шамамыз келмейді.
Dialogue: 0,0:02:02.88,0:02:03.82,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:02:04.15,0:02:07.22,Default,,0,0,0,,Сіз мазасыз адамсыз. Тыныш өл!
Dialogue: 0,0:02:07.36,0:02:08.62,Default,,0,0,0,,Гррр!
Dialogue: 0,0:02:09.26,0:02:10.26,Default,,0,0,0,,Барлығына! Барайық!
Dialogue: 0,0:02:10.36,0:02:11.56,Default,,0,0,0,,О!
Dialogue: 0,0:02:13.46,0:02:14.83,Default,,0,0,0,,Гуо
Dialogue: 0,0:02:23.44,0:02:25.24,Default,,0,0,0,,Уф! (Лиллис) Хохохохохо
Dialogue: 0,0:02:25.54,0:02:27.58,Default,,0,0,0,,Бұл тәтті, балам.
Dialogue: 0,0:02:27.68,0:02:28.88,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:02:29.24,0:02:30.61,Default,,0,0,0,,Хахахахаха
Dialogue: 0,0:02:38.32,0:02:40.69,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:02:42.22,0:02:43.32,Default,,0,0,0,,Га
Dialogue: 0,0:02:46.26,0:02:47.30,Default,,0,0,0,,Хмф!
Dialogue: 0,0:02:49.90,0:02:50.87,Default,,0,0,0,,Уф!
Dialogue: 0,0:02:59.87,0:03:01.64,Default,,0,0,0,,Қуырылған Арне
Dialogue: 0,0:03:03.18,0:03:04.68,Default,,0,0,0,,003 (нөл нөл үш)! Маған жол көрсетуіңізді өтінемін!
Dialogue: 0,0:03:05.21,0:03:07.78,Default,,0,0,0,,Түсінікті. Мен деректерді ми толқыны арқылы жіберемін.
Dialogue: 0,0:03:09.52,0:03:10.29,Default,,0,0,0,,Құлыптаңыз!
Dialogue: 0,0:03:10.82,0:03:12.62,Default,,0,0,0,,Деректерді қабылдау Өрт!
Dialogue: 0,0:03:24.63,0:03:25.63,Default,,0,0,0,,Ах
Dialogue: 0,0:03:31.91,0:03:33.24,Default,,0,0,0,,００７！
Dialogue: 0,0:03:33.54,0:03:36.74,Default,,0,0,0,,Мадмуазельді қорғау – джентльменнің міндеті.
Dialogue: 0,0:03:37.25,0:03:38.98,Default,,0,0,0,,Жаудың тірегі неге ұқсайды?
Dialogue: 0,0:03:40.92,0:03:44.25,Default,,0,0,0,,Энергетикалық реакция сөзсіз күшейеді.
Dialogue: 0,0:03:45.49,0:03:46.79,Default,,0,0,0,,Сол арал
Dialogue: 0,0:03:56.97,0:04:02.67,Default,,0,0,0,,Хехехе хахахахаха...
Dialogue: 0,0:04:11.95,0:04:12.98,Default,,0,0,0,,Орнату…
Dialogue: 0,0:04:13.28,0:04:15.35,Default,,0,0,0,,Қайтадан оянуыңыз үшін
Dialogue: 0,0:04:15.78,0:04:18.55,Default,,0,0,0,,Мен де шайтанмен келісім жасадым.
Dialogue: 0,0:04:19.55,0:04:21.02,Default,,0,0,0,,0015 (нөл нөл он бес)
Dialogue: 0,0:04:21.69,0:04:23.66,Default,,0,0,0,,Мики Макимура қорғалды
Dialogue: 0,0:04:29.56,0:04:32.30,Default,,0,0,0,,Сізде көп сезім бар шығар.
Dialogue: 0,0:04:32.67,0:04:35.34,Default,,0,0,0,,Себебі Сет менің нағыз інім.
Dialogue: 0,0:04:36.84,0:04:40.41,Default,,0,0,0,,Қалыпты емделу арқылы сауығып кетуге үміті жоқ Сет үшін.
Dialogue: 0,0:04:40.54,0:04:43.41,Default,,0,0,0,,Басқа жол жоқ
Dialogue: 0,0:04:44.61,0:04:47.48,Default,,0,0,0,,Мики Макимураны осында әкелу арқылы.
Dialogue: 0,0:04:47.88,0:04:51.75,Default,,0,0,0,,Ібіліс Фудо Акира да осында міндетті түрде келеді.
Dialogue: 0,0:04:52.32,0:04:55.42,Default,,0,0,0,,Атунның қалауы осы.
Dialogue: 0,0:04:55.99,0:04:58.29,Default,,0,0,0,,Set шынымен оянады ма?
Dialogue: 0,0:04:58.59,0:05:00.86,Default,,0,0,0,,О, мен оянамын
Dialogue: 0,0:05:02.46,0:05:03.43,Default,,0,0,0,,Не болды?
Dialogue: 0,0:05:03.73,0:05:06.43,Default,,0,0,0,,Бірақ «шайтан» мен «шайтан» шайқасынан кейін не болады?
Dialogue: 0,0:05:06.77,0:05:09.47,Default,,0,0,0,,Маңыздысы менің зерттеуім.
Dialogue: 0,0:05:09.70,0:05:11.94,Default,,0,0,0,,Одан кейін не болғаны маған бәрібір.
Dialogue: 0,0:05:12.84,0:05:15.51,Default,,0,0,0,,Мен ең күшті киборг жасадым
Dialogue: 0,0:05:15.98,0:05:19.61,Default,,0,0,0,,Егер сіз протокиборгтарды жеңсеңіз
Dialogue: 0,0:05:19.81,0:05:22.38,Default,,0,0,0,,Менің кек алуым орындалады.
Dialogue: 0,0:05:23.85,0:05:24.65,Default,,0,0,0,,(Датчик дыбысы)
Dialogue: 0,0:05:24.75,0:05:25.45,Default,,0,0,0,,Ах
Dialogue: 0,0:05:26.35,0:05:28.66,Default,,0,0,0,,О, Атун жауап берді.
Dialogue: 0,0:05:28.99,0:05:32.86,Default,,0,0,0,,Акира Фудо, жоқ, Девилман жақындап келеді.
Dialogue: 0,0:05:33.56,0:05:35.46,Default,,0,0,0,,Енді соңғы нүктеге көшейік.
Dialogue: 0,0:05:54.12,0:05:55.38,Default,,0,0,0,,Орнату…
Dialogue: 0,0:05:55.72,0:05:56.92,Default,,0,0,0,,Хехехе
Dialogue: 0,0:05:57.12,0:06:01.89,Default,,0,0,0,,Фухахаха...!
Dialogue: 0,0:06:04.59,0:06:06.03,Default,,0,0,0,,Бұл дұрыс бағыт па?
Dialogue: 0,0:06:06.13,0:06:08.50,Default,,0,0,0,,Ах, мен Микидің барын сеземін.
Dialogue: 0,0:06:10.43,0:06:12.43,Default,,0,0,0,,Мен біртүрлі нәрсені сезіндім.
Dialogue: 0,0:06:12.53,0:06:14.97,Default,,0,0,0,,Бұл Микиге зиян тигізбейтін сияқты болды.
Dialogue: 0,0:06:15.64,0:06:17.14,Default,,0,0,0,,Бұл да киборг па?
Dialogue: 0,0:06:17.47,0:06:18.04,Default,,0,0,0,,Мүмкін.
Dialogue: 0,0:06:18.81,0:06:19.97,Default,,0,0,0,,Бұл жайлы жаман сезім бар
Dialogue: 0,0:06:20.48,0:06:24.68,Default,,0,0,0,,Цк, енді Микиді ұрлап кеткендіктен, менде жаман сезім пайда болды!
Dialogue: 0,0:06:25.55,0:06:27.75,Default,,0,0,0,,Адамды ұрлаудың мақсаты маңызды.
Dialogue: 0,0:06:28.05,0:06:31.65,Default,,0,0,0,,Бұл жердегі орманның шулы болуының себебі де осы.
Dialogue: 0,0:06:32.72,0:06:35.49,Default,,0,0,0,,«Қара елес» және жауынгерлік киборгтарды құру
Dialogue: 0,0:06:35.69,0:06:37.53,Default,,0,0,0,,«Жындар» бір-біріне қосылса
Dialogue: 0,0:06:38.43,0:06:40.70,Default,,0,0,0,,Бұл қандай да бір жаудың күтіп тұрғанын білдіреді.
Dialogue: 0,0:06:41.00,0:06:42.40,Default,,0,0,0,,О
Dialogue: 0,0:06:43.10,0:06:46.47,Default,,0,0,0,,Хохохохо, балам не болды?
Dialogue: 0,0:06:46.90,0:06:48.77,Default,,0,0,0,,Анамды сағындың ба?
Dialogue: 0,0:06:49.84,0:06:51.81,Default,,0,0,0,,Қарғыс атсын! Үдеткіш!
Dialogue: 0,0:06:53.57,0:06:55.64,Default,,0,0,0,,Менен қаша алсаң
Dialogue: 0,0:07:02.88,0:07:03.85,Default,,0,0,0,,Әй
Dialogue: 0,0:07:04.72,0:07:06.72,Default,,0,0,0,,Бізге сен сияқтылар керек емес.
Dialogue: 0,0:07:08.79,0:07:10.46,Default,,0,0,0,,Не болды, бала?
Dialogue: 0,0:07:10.56,0:07:12.59,Default,,0,0,0,,Бар болғаны қашып кетуге болатын сияқты.
Dialogue: 0,0:07:16.46,0:07:17.57,Default,,0,0,0,,Қандай ысырап!
Dialogue: 0,0:07:20.13,0:07:22.17,Default,,0,0,0,,Уф, жақсы сезінеді!
Dialogue: 0,0:07:22.47,0:07:22.90,Default,,0,0,0,,Ха!
Dialogue: 0,0:07:25.64,0:07:28.98,Default,,0,0,0,,Сіз маған аян көрсетіп жатырсыз...
Dialogue: 0,0:07:34.22,0:07:35.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:39.19,0:07:40.86,Default,,0,0,0,,Сіз аман қалдыңыз ба?
Dialogue: 0,0:07:40.96,0:07:42.59,Default,,0,0,0,,Солай болуы керек.
Dialogue: 0,0:07:42.69,0:07:46.03,Default,,0,0,0,,Оларды жеңу қызығын алып тастасаңыз, қызықсыз.
Dialogue: 0,0:07:46.13,0:07:46.99,Default,,0,0,0,,Хун
Dialogue: 0,0:07:49.10,0:07:50.10,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:50.83,0:07:51.63,Default,,0,0,0,,Уф!
Dialogue: 0,0:07:52.23,0:07:53.17,Default,,0,0,0,,Орнату!
Dialogue: 0,0:07:54.17,0:07:55.97,Default,,0,0,0,,Апа
Dialogue: 0,0:07:56.67,0:07:57.61,Default,,0,0,0,,Уау Уау
Dialogue: 0,0:07:57.71,0:07:58.61,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:58.84,0:08:01.04,Default,,0,0,0,,Енді уақыт келді!
Dialogue: 0,0:08:02.21,0:08:04.51,Default,,0,0,0,,Фухахаха Атун!
Dialogue: 0,0:08:04.78,0:08:07.52,Default,,0,0,0,,Енді баламды алатын кез келді
Dialogue: 0,0:08:07.62,0:08:09.82,Default,,0,0,0,,Мына дүниеге кел!
Dialogue: 0,0:08:10.02,0:08:12.52,Default,,0,0,0,,Уаааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:08:12.65,0:08:13.92,Default,,0,0,0,,Ууууууууууууууууууууууу
Dialogue: 0,0:08:14.22,0:08:15.52,Default,,0,0,0,,Вау-а-а-а
Dialogue: 0,0:08:15.62,0:08:18.86,Default,,0,0,0,,Дұрыс, жарайды, тағы бір дем.
Dialogue: 0,0:08:21.16,0:08:23.20,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:24.80,0:08:28.27,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууу...
Dialogue: 0,0:08:34.64,0:08:35.94,Default,,0,0,0,,Кукукуку
Dialogue: 0,0:08:36.04,0:08:39.11,Default,,0,0,0,,Менің қолымда... Мен оны алдым.
Dialogue: 0,0:08:39.58,0:08:40.98,Default,,0,0,0,,А, Сето?
Dialogue: 0,0:08:43.82,0:08:47.56,Default,,0,0,0,,Енді... онымен қанағаттанғанша күресуге болады!
Dialogue: 0,0:08:47.86,0:08:50.19,Default,,0,0,0,,Ха... сіз төбелесе аласыз ба?
Dialogue: 0,0:08:51.06,0:08:54.06,Default,,0,0,0,,Хахахаха мен жасадым
Dialogue: 0,0:08:54.16,0:08:56.90,Default,,0,0,0,,Кибернетикалық жын аяқталды!
Dialogue: 0,0:08:57.30,0:08:58.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:59.23,0:09:00.77,Default,,0,0,0,,Түн ортасында әлі де 36 сағат.
Dialogue: 0,0:09:00.87,0:09:03.91,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:08.08,0:09:10.71,Default,,0,0,0,,Ах (Акира) Мики ана жақта.
Dialogue: 0,0:09:10.85,0:09:12.01,Default,,0,0,0,,Алға
Dialogue: 0,0:09:12.11,0:09:12.85,Default,,0,0,0,,Абайлаңыз!
Dialogue: 0,0:09:23.56,0:09:25.09,Default,,0,0,0,,Сіз қалай ойлайсыз? Орнату
Dialogue: 0,0:09:25.76,0:09:29.00,Default,,0,0,0,,Жоқ, мен сені Атун деп атасам ба?
Dialogue: 0,0:09:29.66,0:09:31.27,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:09:32.00,0:09:33.87,Default,,0,0,0,,Жиын (Ібіліс жинағы) Иә?
Dialogue: 0,0:09:38.87,0:09:41.11,Default,,0,0,0,,Бұл ақымақ сұрақ болды.
Dialogue: 0,0:09:41.61,0:09:44.75,Default,,0,0,0,,Енді Atun немесе Set емес
Dialogue: 0,0:09:45.15,0:09:46.98,Default,,0,0,0,,Иә... егер солай десеңіз.
Dialogue: 0,0:09:47.08,0:09:50.15,Default,,0,0,0,,Екеуінің қосылуынан туған жаңа болмыс
Dialogue: 0,0:09:51.02,0:09:52.19,Default,,0,0,0,,Қатынасты үзу ме? Қатынасты үзу... Хе-хе-хе-хе.
Dialogue: 0,0:09:52.29,0:09:55.62,Default,,0,0,0,,Сеттің әлсіз мінезін Атун жеп қойды.
Dialogue: 0,0:09:55.86,0:09:58.29,Default,,0,0,0,,Менің ойымша, бір түйір де қалған жоқ.
Dialogue: 0,0:09:58.66,0:09:59.79,Default,,0,0,0,,Дәрігер!
Dialogue: 0,0:09:59.89,0:10:01.73,Default,,0,0,0,,Кукккккккккккккккккккккккккккккккккккккккккккккккккк
Dialogue: 0,0:10:01.83,0:10:04.73,Default,,0,0,0,,Хехехе хахахаха...
Dialogue: 0,0:10:05.63,0:10:07.60,Default,,0,0,0,,Сіздің рөліңіз аяқталды...
Dialogue: 0,0:10:07.84,0:10:09.60,Default,,0,0,0,,Әй!не?
Dialogue: 0,0:10:09.90,0:10:12.11,Default,,0,0,0,,Маған бұл дене ұнайды.
Dialogue: 0,0:10:12.21,0:10:14.08,Default,,0,0,0,,Мен сені сол үшін мақтаймын.
Dialogue: 0,0:10:15.91,0:10:17.21,Default,,0,0,0,,Не?
Dialogue: 0,0:10:17.98,0:10:18.88,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:19.31,0:10:20.78,Default,,0,0,0,,Ия, тоқта!
Dialogue: 0,0:10:20.92,0:10:24.79,Default,,0,0,0,,Өзіңіздің ең күшті жан екеніңізді дәлелдеңіз.
Dialogue: 0,0:10:24.89,0:10:26.05,Default,,0,0,0,,Саған тиген жоқ па?
Dialogue: 0,0:10:26.82,0:10:30.06,Default,,0,0,0,,Ең жақсы киборг зерттеушісі болу...
Dialogue: 0,0:10:30.29,0:10:31.89,Default,,0,0,0,,ол даулы мәлімдемеге айналар еді
Dialogue: 0,0:10:32.29,0:10:34.63,Default,,0,0,0,,Ахх... (Адамдар) Ахх!
Dialogue: 0,0:10:34.76,0:10:38.07,Default,,0,0,0,,Уггугуггугу шайтан!
Dialogue: 0,0:10:38.90,0:10:39.67,Default,,0,0,0,,Сол кезде мен өзімді жеңілген адам ретінде өмір сүруді бастадым.
Dialogue: 0,0:10:39.80,0:10:42.34,Default,,0,0,0,,Ah Ah Ah Ah Ah
Dialogue: 0,0:10:44.27,0:10:45.31,Default,,0,0,0,,Жиын
Dialogue: 0,0:10:47.34,0:10:50.68,Default,,0,0,0,,Маған да нұсқау бересіз бе?
Dialogue: 0,0:10:52.15,0:10:54.05,Default,,0,0,0,,Олардың бірі Set емес пе?
Dialogue: 0,0:10:55.38,0:10:57.05,Default,,0,0,0,,Мен қызық...
Dialogue: 0,0:10:57.22,0:11:00.29,Default,,0,0,0,,Дегенмен мұнда бар ма, жоқ па маңызды емес.
Dialogue: 0,0:11:00.76,0:11:04.09,Default,,0,0,0,,Бұл қайраткер, бұл болмыс жаңа ғана дүниеге келген.
Dialogue: 0,0:11:05.23,0:11:08.20,Default,,0,0,0,,Егер солай болса, онда I
Dialogue: 0,0:11:08.36,0:11:11.13,Default,,0,0,0,,Сетоның денесімен ойнауға рұқсат бермеймін.
Dialogue: 0,0:11:11.37,0:11:14.27,Default,,0,0,0,,Механикалық қуыршақ тәрізді өрескелдік
Dialogue: 0,0:11:17.97,0:11:19.44,Default,,0,0,0,,Ауа Ауауа!
Dialogue: 0,0:11:26.28,0:11:26.98,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:11:29.25,0:11:30.99,Default,,0,0,0,,Уау (еба) аа аа
Dialogue: 0,0:11:33.12,0:11:34.26,Default,,0,0,0,,Мен оның өткірлігіне мақтанамын — ол заттарды жыртып-жарып жібере алады
Dialogue: 0,0:11:38.79,0:11:39.79,Default,,0,0,0,,Орнату…
Dialogue: 0,0:11:42.20,0:11:43.13,Default,,0,0,0,,Хун
Dialogue: 0,0:11:44.93,0:11:46.70,Default,,0,0,0,,Ах, оо
Dialogue: 0,0:11:50.87,0:11:53.94,Default,,0,0,0,,Иә! Ол келе жатыр!
Dialogue: 0,0:11:54.41,0:11:57.01,Default,,0,0,0,,Бұл өзінің бас жауы деп таныған Амонның жазасы.
Dialogue: 0,0:11:57.71,0:12:01.38,Default,,0,0,0,,Мен сені жеңіп, ең күшті жын боламын.
Dialogue: 0,0:12:01.75,0:12:05.42,Default,,0,0,0,,Дүниені қайғыға толтыру үшін құрбан бол!
Dialogue: 0,0:12:06.15,0:12:07.35,Default,,0,0,0,,Хамф!
Dialogue: 0,0:12:11.03,0:12:15.40,Default,,0,0,0,,Ugggguguoooooo!
Dialogue: 0,0:12:16.36,0:12:20.03,Default,,0,0,0,,Who is that? Who is calling me?
Dialogue: 0,0:12:25.17,0:12:26.97,Default,,0,0,0,,(Гиран) Қалай болғанда да, Курокири-сан, комиссия үшін саған сенемін.
Dialogue: 0,0:12:27.31,0:12:28.88,Default,,0,0,0,,Уайымдаудың қажеті жоқ
Dialogue: 0,0:12:28.98,0:12:30.08,Default,,0,0,0,,Әй!
Dialogue: 0,0:12:31.51,0:12:33.38,Default,,0,0,0,,Балалар, сендер жасөспірім балаларсыңдар!
Dialogue: 0,0:12:33.95,0:12:37.02,Default,,0,0,0,,It's just demons trying to fight.
Dialogue: 0,0:12:39.19,0:12:40.96,Default,,0,0,0,,Ха! 001
Dialogue: 0,0:12:41.12,0:12:43.49,Default,,0,0,0,,Балалар сендер үлкен қателестіңдер.
Dialogue: 0,0:12:44.33,0:12:48.50,Default,,0,0,0,,Ібіліспен келісімге келу дегеніңіз осы болса, еш қиындық жоқ.
Dialogue: 0,0:12:49.06,0:12:51.07,Default,,0,0,0,,Біздің есептеулеріміз тамаша.
Dialogue: 0,0:12:51.83,0:12:54.34,Default,,0,0,0,,Барлығы осында.
Dialogue: 0,0:12:54.94,0:12:57.81,Default,,0,0,0,,Мұнда әлі де 0015 (Он бес) және 0018 (Он сегіз) бар.
Dialogue: 0,0:12:58.27,0:13:01.41,Default,,0,0,0,,Ал, бізге жетеді.
Dialogue: 0,0:13:01.94,0:13:03.41,Default,,0,0,0,,Сіз оны төлей аласыз.
Dialogue: 0,0:13:04.04,0:13:07.08,Default,,0,0,0,,Мен және менің әкем Адамстың киборг зерттеулері
Dialogue: 0,0:13:07.18,0:13:10.02,Default,,0,0,0,,Үздік екенін дәлелдеу
Dialogue: 0,0:13:10.32,0:13:12.52,Default,,0,0,0,,Мен бәріңнің осында өлгеніңді қалаймын.
Dialogue: 0,0:13:12.95,0:13:13.99,Default,,0,0,0,,(Жоғарыда ұшқан дыбыс)
Dialogue: 0,0:13:14.36,0:13:17.12,Default,,0,0,0,,Міне! (Эдвард) Біз бұрыннан танысқанбыз.
Dialogue: 0,0:13:17.49,0:13:19.79,Default,,0,0,0,,Devilman!
Dialogue: 0,0:13:21.10,0:13:23.10,Default,,0,0,0,,Ал, бастайық.
Dialogue: 0,0:13:23.23,0:13:24.90,Default,,0,0,0,,Protonumbers!
Dialogue: 0,0:13:26.30,0:13:28.97,Default,,0,0,0,,Уау! (Эдвард) Uhahaha
Dialogue: 0,0:13:29.84,0:13:31.14,Default,,0,0,0,,００９！
Dialogue: 0,0:13:31.51,0:13:33.27,Default,,0,0,0,,Дабыл!
Dialogue: 0,0:13:34.04,0:13:35.98,Default,,0,0,0,,Oh wow
Dialogue: 0,0:13:37.41,0:13:39.21,Default,,0,0,0,,Сен тез жеңілдің, Ал.
Dialogue: 0,0:13:42.42,0:13:45.92,Default,,0,0,0,,Hot! ыстық! Осылайша
Dialogue: 0,0:13:46.05,0:13:50.09,Default,,0,0,0,,Кенеттен не болды? Бұл баланың жағдайы жақсарған жоқ.
Dialogue: 0,0:13:51.33,0:13:53.03,Default,,0,0,0,,Баршаңыз да сапарыңызды жалғастырғанда абай болыңыздар
Dialogue: 0,0:14:08.14,0:14:10.34,Default,,0,0,0,,Хм (Эдвард) Хэхехехе хахаха
Dialogue: 0,0:14:11.95,0:14:13.85,Default,,0,0,0,,Уау Уау
Dialogue: 0,0:14:16.18,0:14:17.55,Default,,0,0,0,,Уф, мен жете алмаймын...
Dialogue: 0,0:14:18.55,0:14:20.55,Default,,0,0,0,,And what stamina!
Dialogue: 0,0:14:21.02,0:14:21.96,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:14:29.00,0:14:30.60,Default,,0,0,0,,Мен Микидің барын сеземін...
Dialogue: 0,0:14:31.33,0:14:32.43,Default,,0,0,0,,Әй!
Dialogue: 0,0:14:35.04,0:14:36.90,Default,,0,0,0,,Сен!
Dialogue: 0,0:14:39.11,0:14:41.31,Default,,0,0,0,,Мики... Микиді қайда апардың?
Dialogue: 0,0:14:41.44,0:14:43.04,Default,,0,0,0,,Хехехе
Dialogue: 0,0:14:44.45,0:14:47.92,Default,,0,0,0,,Адам жынның күшін алады.
Dialogue: 0,0:14:48.08,0:14:51.09,Default,,0,0,0,,Мен бұл күштің не екенін де білмеймін, мен онымен бетпе-бет келемін.
Dialogue: 0,0:14:51.29,0:14:52.89,Default,,0,0,0,,Hey, who is that?
Dialogue: 0,0:14:54.32,0:14:55.46,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:56.12,0:14:57.46,Default,,0,0,0,,Did you forget? Amon!
Dialogue: 0,0:14:57.66,0:15:01.26,Default,,0,0,0,,Жындар арасында 1 немесе 2 орынға таласатын Атун батыр!
Dialogue: 0,0:15:01.93,0:15:04.67,Default,,0,0,0,,Бұл — Амон, ал Атун — бейберекет!
Dialogue: 0,0:15:05.20,0:15:06.37,Default,,0,0,0,,Микиді қайда апардың?
Dialogue: 0,0:15:08.30,0:15:11.44,Default,,0,0,0,,Амон, құлаған
Dialogue: 0,0:15:14.48,0:15:15.48,Default,,0,0,0,,Уф
Dialogue: 0,0:15:20.41,0:15:21.35,Default,,0,0,0,,Уф
Dialogue: 0,0:15:22.65,0:15:24.12,Default,,0,0,0,,Бұл жылдамдық
Dialogue: 0,0:15:26.92,0:15:29.99,Default,,0,0,0,,Сонымен, сіз біріктіру арқылы бұл қабілетке ие болдыңыз ба?
Dialogue: 0,0:15:30.16,0:15:30.96,Default,,0,0,0,,Өте қызық!
Dialogue: 0,0:15:31.69,0:15:32.69,Default,,0,0,0,,Ууууууу!
Dialogue: 0,0:15:45.01,0:15:46.57,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:51.38,0:15:54.62,Default,,0,0,0,,Miki… at least just Miki…
Dialogue: 0,0:15:55.08,0:16:01.39,Default,,0,0,0,,Ай!
Dialogue: 0,0:16:05.99,0:16:07.13,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:16:12.53,0:16:13.63,Default,,0,0,0,,Мики
Dialogue: 0,0:16:17.40,0:16:20.01,Default,,0,0,0,,Seto, with whom you grieved...
Dialogue: 0,0:16:20.61,0:16:23.04,Default,,0,0,0,,Мен құбыжыққа айналдым
Dialogue: 0,0:16:23.31,0:16:25.28,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:26.68,0:16:29.68,Default,,0,0,0,,Бұл Хауа... Мен оны Акирадан естідім.
Dialogue: 0,0:16:34.05,0:16:36.12,Default,,0,0,0,,Менің әлі жұмысым бар.
Dialogue: 0,0:16:36.56,0:16:38.03,Default,,0,0,0,,Мики өтінемін
Dialogue: 0,0:16:44.33,0:16:45.77,Default,,0,0,0,,Ху (Эдвард) Иә.
Dialogue: 0,0:16:47.53,0:16:50.64,Default,,0,0,0,,...
Dialogue: 0,0:17:02.05,0:17:03.42,Default,,0,0,0,,Дабыл!
Dialogue: 0,0:17:05.79,0:17:07.35,Default,,0,0,0,,Ice Ori!
Dialogue: 0,0:17:07.59,0:17:09.09,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:17:09.29,0:17:10.69,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:10.79,0:17:15.03,Default,,0,0,0,,Қауіпті Арне! 007 Осындай кезде өрт шығады!
Dialogue: 0,0:17:18.20,0:17:20.60,Default,,0,0,0,,Ahahahaha That's no good!
Dialogue: 0,0:17:20.80,0:17:23.04,Default,,0,0,0,,Айер Дамил?
Dialogue: 0,0:17:23.24,0:17:25.04,Default,,0,0,0,,Баршаңыз да сапарыңызды жалғастырғанда абай болыңыздар
Dialogue: 0,0:17:25.37,0:17:27.17,Default,,0,0,0,,Міне, солай!
Dialogue: 0,0:17:29.34,0:17:32.41,Default,,0,0,0,,Ахахха, сен шынымен әлсізсің!
Dialogue: 0,0:17:32.68,0:17:34.08,Default,,0,0,0,,Ах! Апыр-ай!
Dialogue: 0,0:17:34.18,0:17:36.32,Default,,0,0,0,,Аххх! Бұл не?
Dialogue: 0,0:17:38.52,0:17:40.42,Default,,0,0,0,,Сәлем! Жазасы бар!
Dialogue: 0,0:17:40.52,0:17:41.32,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:44.32,0:17:47.29,Default,,0,0,0,,Хмф! (006) Мол операциясы сәтті өтті!
Dialogue: 0,0:17:52.10,0:17:54.13,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:17:54.80,0:17:56.10,Default,,0,0,0,,Уф
Dialogue: 0,0:17:56.77,0:17:58.37,Default,,0,0,0,,Нуоооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооо!
Dialogue: 0,0:17:59.14,0:18:01.21,Default,,0,0,0,,Is that what your Пауэр is?
Dialogue: 0,0:18:01.41,0:18:04.24,Default,,0,0,0,,Why did you take over Amon?
Dialogue: 0,0:18:04.55,0:18:05.55,Default,,0,0,0,,Сіз білесіз бе!
Dialogue: 0,0:18:10.52,0:18:13.32,Default,,0,0,0,,Мен Микимін... бұл Мики бар әлем.
Dialogue: 0,0:18:13.42,0:18:14.82,Default,,0,0,0,,Мен қорғағым келді
Dialogue: 0,0:18:15.26,0:18:17.42,Default,,0,0,0,,Барлығы осы.
Dialogue: 0,0:18:18.13,0:18:19.46,Default,,0,0,0,,«Гүл алқабы» — сені жалған қауіпсіздік сезіміне бөлеп, бірақ —
Dialogue: 0,0:18:20.56,0:18:22.43,Default,,0,0,0,,Ооо
Dialogue: 0,0:18:22.83,0:18:24.40,Default,,0,0,0,,Невилл Буффет!
Dialogue: 0,0:18:28.24,0:18:30.44,Default,,0,0,0,,Эдвард Каин Абел
Dialogue: 0,0:18:31.71,0:18:32.41,Default,,0,0,0,,Хауа?
Dialogue: 0,0:18:34.14,0:18:35.24,Default,,0,0,0,,Не?
Dialogue: 0,0:18:35.41,0:18:37.28,Default,,0,0,0,,The doctor was killed by Atun.
Dialogue: 0,0:18:37.38,0:18:39.65,Default,,0,0,0,,Не? Менің әкем?
Dialogue: 0,0:18:40.55,0:18:42.58,Default,,0,0,0,,Иә? (002) Why did you stop fighting?
Dialogue: 0,0:18:42.85,0:18:44.22,Default,,0,0,0,,Пуф?
Dialogue: 0,0:18:44.32,0:18:46.62,Default,,0,0,0,,No, they are tireless.
Dialogue: 0,0:18:47.79,0:18:50.16,Default,,0,0,0,,There's no point in this fight anymore.
Dialogue: 0,0:18:52.23,0:18:54.53,Default,,0,0,0,,After defeating 009 and the others
Dialogue: 0,0:18:54.70,0:18:57.70,Default,,0,0,0,,Мұны қалаған доктор Адамс енді бұл жерде жоқ.
Dialogue: 0,0:18:59.13,0:18:59.83,Default,,0,0,0,,Юкине-кун, барсың ба?
Dialogue: 0,0:19:00.40,0:19:03.17,Default,,0,0,0,,Сетоның да санасы жаңғырған жоқ.
Dialogue: 0,0:19:03.77,0:19:05.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:07.34,0:19:09.58,Default,,0,0,0,,Мына кибернетикалық жынның ішінде не бар?
Dialogue: 0,0:19:10.44,0:19:13.45,Default,,0,0,0,,Атун мен Сеттің қараңғы бөліктері біріктірілді.
Dialogue: 0,0:19:13.55,0:19:15.55,Default,,0,0,0,,Мүлде басқа зұлым болмыс
Dialogue: 0,0:19:26.49,0:19:29.70,Default,,0,0,0,,Хмф, бұлай болса, мен қарсы емеспін.
Dialogue: 0,0:19:30.53,0:19:32.93,Default,,0,0,0,,Мен әкемнің зерттеуін өз қолыма аламын!
Dialogue: 0,0:19:33.47,0:19:37.34,Default,,0,0,0,,Қазір жоғары жасөспірімдер санының күшін дәлелдейтін уақыт!
Dialogue: 0,0:19:37.44,0:19:38.24,Default,,0,0,0,,Иә
Dialogue: 0,0:19:38.34,0:19:39.87,Default,,0,0,0,,Орнатылмаған болса
Dialogue: 0,0:19:40.21,0:19:43.24,Default,,0,0,0,,Мен протокиборг пен сол жынды жеңгенше.
Dialogue: 0,0:19:43.61,0:19:44.78,Default,,0,0,0,,Тоқта, Эдвард.
Dialogue: 0,0:19:45.35,0:19:49.38,Default,,0,0,0,,Доктор Адамстың киборг зерттеулерінің жоғары болғанын дәлелдеу.
Dialogue: 0,0:19:49.48,0:19:50.88,Default,,0,0,0,,Бұл нені білдіреді...?
Dialogue: 0,0:19:51.59,0:19:56.26,Default,,0,0,0,,Дәлелдесек те, біз тек қарумыз.
Dialogue: 0,0:19:56.52,0:19:59.29,Default,,0,0,0,,Дәрігер өледі, ал Сет ешқашан оралмайды.
Dialogue: 0,0:19:59.56,0:20:03.40,Default,,0,0,0,,Егер ары қарай күресе берсек, мұңымыз арта береді.
Dialogue: 0,0:20:04.63,0:20:05.47,Default,,0,0,0,,Хауа
Dialogue: 0,0:20:05.57,0:20:07.94,Default,,0,0,0,,Ертең тек аман қалғандар үшін
Dialogue: 0,0:20:08.57,0:20:11.24,Default,,0,0,0,,Менің бұл жекпе-жекті тастайтын ойым жоқ.
Dialogue: 0,0:20:12.24,0:20:14.64,Default,,0,0,0,,Ева Әрі қарай жүрудің қажеті жоқ сияқты.
Dialogue: 0,0:20:15.31,0:20:18.71,Default,,0,0,0,,Мен сізді аяймын, бірақ сіздің жоспарыңызды жүзеге асырудан басқа амалым жоқ.
Dialogue: 0,0:20:19.21,0:20:21.38,Default,,0,0,0,,001 Сіз нені білдіреді?
Dialogue: 0,0:20:21.75,0:20:23.48,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:20:23.58,0:20:24.45,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:20:24.55,0:20:25.62,Default,,0,0,0,,００９！
Dialogue: 0,0:20:25.99,0:20:27.25,Default,,0,0,0,,００５！
Dialogue: 0,0:20:31.93,0:20:33.23,Default,,0,0,0,,００７！
Dialogue: 0,0:20:34.29,0:20:34.90,Default,,0,0,0,,Маған қарызға бер!
Dialogue: 0,0:20:35.40,0:20:37.26,Default,,0,0,0,,Дабыл!
Dialogue: 0,0:20:41.54,0:20:45.27,Default,,0,0,0,,Мені оятқан 0015 Ева болды.
Dialogue: 0,0:20:45.77,0:20:48.81,Default,,0,0,0,,Оның менікіне ұқсас психикалық қабілеттері бар.
Dialogue: 0,0:20:49.28,0:20:52.28,Default,,0,0,0,,Ол мұндай мүмкіндікті алдын ала білген!
Dialogue: 0,0:20:56.88,0:20:57.58,Default,,0,0,0,,Мин!
Dialogue: 0,0:21:09.50,0:21:11.27,Default,,0,0,0,,Сіз...? (Ібіліс) Сіз бе?
Dialogue: 0,0:21:11.73,0:21:13.90,Default,,0,0,0,,Жынның күшін алғаннан кейін
Dialogue: 0,0:21:14.00,0:21:15.84,Default,,0,0,0,,Біз адамбыз ба?
Dialogue: 0,0:21:16.60,0:21:18.84,Default,,0,0,0,,Механикалық қуыршақтардың барлығы осында.
Dialogue: 0,0:21:19.04,0:21:20.81,Default,,0,0,0,,Мектептен шығарылу үшін қажет найзағайлар: 7 қалды
Dialogue: 0,0:21:20.97,0:21:24.85,Default,,0,0,0,,Протокиборгтарды көмгеннен кейін мен олармен ақырын айналысамын.
Dialogue: 0,0:21:24.98,0:21:25.75,Default,,0,0,0,,Хун
Dialogue: 0,0:21:28.72,0:21:29.62,Default,,0,0,0,,Аһ!
Dialogue: 0,0:21:33.02,0:21:35.49,Default,,0,0,0,,Жын мен киборгтың қосылуы?
Dialogue: 0,0:21:39.49,0:21:40.43,Default,,0,0,0,,００９
Dialogue: 0,0:21:41.46,0:21:42.90,Default,,0,0,0,,Сіз одан сұрайсыз
Dialogue: 0,0:21:43.00,0:21:43.90,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:21:44.53,0:21:47.57,Default,,0,0,0,,0015 Хауа ынтымақтасады
Dialogue: 0,0:21:47.87,0:21:48.84,Default,,0,0,0,,００１５？
Dialogue: 0,0:21:49.37,0:21:51.00,Default,,0,0,0,,Бір ғана жол бар
Dialogue: 0,0:21:51.44,0:21:54.51,Default,,0,0,0,,Қалған жасөспірім нөмірлерін бізге қалдырыңыз.
Dialogue: 0,0:21:54.68,0:21:56.61,Default,,0,0,0,,Түсіндім, үдеткіш!
Dialogue: 0,0:21:57.08,0:21:59.45,Default,,0,0,0,,Маған мұны істеуге рұқсат бересіз бе? (002) Ой!
Dialogue: 0,0:21:59.71,0:22:01.58,Default,,0,0,0,,Уау! аа!
Dialogue: 0,0:22:01.68,0:22:03.62,Default,,0,0,0,,Сіз бізбен айналысып жатырсыз.
Dialogue: 0,0:22:03.92,0:22:05.92,Default,,0,0,0,,008 Дельфин
Dialogue: 0,0:22:06.02,0:22:06.95,Default,,0,0,0,,Олар үшін де тойып жеңіздер
Dialogue: 0,0:22:09.62,0:22:11.73,Default,,0,0,0,,Мен сені жібермеймін Уау!
Dialogue: 0,0:22:15.90,0:22:16.60,Default,,0,0,0,,Дабыл!
Dialogue: 0,0:22:17.76,0:22:18.73,Default,,0,0,0,,Иә!
Dialogue: 0,0:22:35.08,0:22:36.02,Default,,0,0,0,,Аһ!
Dialogue: 0,0:22:40.79,0:22:42.39,Default,,0,0,0,,Қандай төзімділік...!
Dialogue: 0,0:22:46.79,0:22:48.93,Default,,0,0,0,,001 бастайық
Dialogue: 0,0:22:52.43,0:22:54.57,Default,,0,0,0,,Әлде маған, осы жігіттерге және Зерттеу корпусы ұйымына сенесің бе?
Dialogue: 0,0:22:54.90,0:22:56.54,Default,,0,0,0,,Маған Хауа үйретті
Dialogue: 0,0:22:56.90,0:22:59.67,Default,,0,0,0,,Өздігінен жаңаратын олардың арнайы жасушалары
Dialogue: 0,0:22:59.77,0:23:03.48,Default,,0,0,0,,Бекіту кезінде арнайы зарядты біріктіру арқылы пайда болады
Dialogue: 0,0:23:03.78,0:23:06.75,Default,,0,0,0,,Басқаша айтқанда, антиэнергиямен жасушаларды сәулелендіру
Dialogue: 0,0:23:06.85,0:23:09.05,Default,,0,0,0,,Егер біріктіру процесін кері қарай жүргізетін болсақ,
Dialogue: 0,0:23:09.15,0:23:12.82,Default,,0,0,0,,Олардың жасушалары тұрақсыз болып, көбейе алмайды.
Dialogue: 0,0:23:13.09,0:23:15.66,Default,,0,0,0,,Ол электр энергиясын өндіруге арналған ауқымды жабдықты және қажет
Dialogue: 0,0:23:15.76,0:23:18.96,Default,,0,0,0,,Маған оны антиэнергияға айналдыру үшін жабдық керек, бірақ...
Dialogue: 0,0:23:19.43,0:23:21.76,Default,,0,0,0,,Қуат генераторын Ева басқарады.
Dialogue: 0,0:23:21.86,0:23:22.93,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:23:23.03,0:23:26.90,Default,,0,0,0,,Түрлендіру құрылғысын Дельфиннің сонарлық радарымен ауыстыруға болады.
Dialogue: 0,0:23:27.40,0:23:30.07,Default,,0,0,0,,Бірақ мұны істесең, сол Хауа ана шақырылады
Dialogue: 0,0:23:30.17,0:23:32.87,Default,,0,0,0,,Жоғары жасөспірімдердің саны да қауіпсіз бола алмайды...
Dialogue: 0,0:23:32.97,0:23:34.88,Default,,0,0,0,,Басқа жол жоқ
Dialogue: 0,0:23:34.98,0:23:36.71,Default,,0,0,0,,Хмм...
Dialogue: 0,0:23:37.44,0:23:40.45,Default,,0,0,0,,Барлығы, мен жіберген координаттарға көшіңдер!
Dialogue: 0,0:23:40.98,0:23:42.08,Default,,0,0,0,,Біз өз орнындамыз!
Dialogue: 0,0:23:42.18,0:23:44.89,Default,,0,0,0,,3-тармақ 1-секторда 3 секунд бойы тосқауыл қою
Dialogue: 0,0:23:44.99,0:23:45.85,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:23:47.59,0:23:48.99,Default,,0,0,0,,006 Қазір!
Dialogue: 0,0:23:49.16,0:23:49.99,Default,,0,0,0,,Иә.
Dialogue: 0,0:23:50.52,0:23:51.46,Default,,0,0,0,,Уау!
Dialogue: 0,0:23:52.06,0:23:53.13,Default,,0,0,0,,００３！
Dialogue: 0,0:23:54.46,0:23:55.76,Default,,0,0,0,,Қазір! (005) Хмф!
Dialogue: 0,0:23:57.50,0:23:58.43,Default,,0,0,0,,００７！
Dialogue: 0,0:23:58.53,0:23:59.63,Default,,0,0,0,,Сондай-ақ сиқыр сенің ерніңе де әсер етсін…
Dialogue: 0,0:24:01.03,0:24:01.87,Default,,0,0,0,,002 (нөлдік нөл екі)!
Dialogue: 0,0:24:02.44,0:24:03.64,Default,,0,0,0,,Қалғандар да дәл қазір барын салып еңбек етіп жатқан болар.
Dialogue: 0,0:24:07.74,0:24:11.44,Default,,0,0,0,,Үдеу арқылы қалай көруге болады? Сізде осындай ерекшеліктер бар!
Dialogue: 0,0:24:11.78,0:24:14.51,Default,,0,0,0,,Деректерді жинау және мінез-құлықты болжау нәтижелері
Dialogue: 0,0:24:14.61,0:24:16.88,Default,,0,0,0,,Біздің топтық жұмысымыз да.
Dialogue: 0,0:24:17.48,0:24:18.79,Default,,0,0,0,,Апыр-ау
Dialogue: 0,0:24:18.89,0:24:21.89,Default,,0,0,0,,Иә, біз ешқашан өлмейміз.
Dialogue: 0,0:24:22.16,0:24:23.89,Default,,0,0,0,,Өзін-өзі жөндеу функциясы...
Dialogue: 0,0:24:23.99,0:24:26.16,Default,,0,0,0,,Цк, ол қалай жұмыс істейді?
Dialogue: 0,0:24:31.06,0:24:32.50,Default,,0,0,0,,Уф! Уф!
Dialogue: 0,0:24:33.83,0:24:34.50,Default,,0,0,0,,Уау!
Dialogue: 0,0:24:37.90,0:24:38.77,Default,,0,0,0,,Ах!
Dialogue: 0,0:24:40.94,0:24:41.68,Default,,0,0,0,,Ах!
Dialogue: 0,0:24:42.21,0:24:45.21,Default,,0,0,0,,Мен шайтанға ұқсасам да, адаммын.
Dialogue: 0,0:24:45.51,0:24:47.01,Default,,0,0,0,,Мен қорғағым келетін бір нәрсе бар
Dialogue: 0,0:24:47.95,0:24:49.15,Default,,0,0,0,,Мен нені қорғағым келеді...
Dialogue: 0,0:25:01.80,0:25:02.93,Default,,0,0,0,,Дайын
Dialogue: 0,0:25:06.93,0:25:08.87,Default,,0,0,0,,Radome ұясын орналастыру аяқталды
Dialogue: 0,0:25:08.97,0:25:11.54,Default,,0,0,0,,Энергияны түрлендіру жүйесінің күту режимі
Dialogue: 0,0:25:11.81,0:25:14.21,Default,,0,0,0,,Жүйені қайта жүктеу аяқталды
Dialogue: 0,0:25:14.94,0:25:15.91,Default,,0,0,0,,Тағы бір рет, өтінемін!
Dialogue: 0,0:25:16.61,0:25:17.54,Default,,0,0,0,,Жиын
Dialogue: 0,0:25:17.81,0:25:22.22,Default,,0,0,0,,Дәл қазір мен сен үшін істей алатын жалғыз нәрсе осы
Dialogue: 0,0:25:39.00,0:25:40.53,Default,,0,0,0,,Энергия конвергенциясының басталуы
Dialogue: 0,0:25:43.10,0:25:44.27,Default,,0,0,0,,Абай бол, ДжоДжо!
Dialogue: 0,0:25:44.70,0:25:45.71,Default,,0,0,0,,Ах!
Dialogue: 0,0:25:48.14,0:25:51.21,Default,,0,0,0,,Энергияға қарсы түрлендіруді растау Сәулеленуді бастау
Dialogue: 0,0:25:58.99,0:26:00.12,Default,,0,0,0,,Мен... кетті! (Әбіл) Уау!
Dialogue: 0,0:26:00.22,0:26:01.62,Default,,0,0,0,,Ах!
Dialogue: 0,0:26:02.86,0:26:05.09,Default,,0,0,0,,—«Золушка» сұлулық салонында басқа біреумен алмастырылған болса—
Dialogue: 0,0:26:05.96,0:26:08.60,Default,,0,0,0,,Ах... (Эдвард) Өзін-өзі жөндеу функциясы...
Dialogue: 0,0:26:17.04,0:26:17.97,Default,,0,0,0,,Орнату…
Dialogue: 0,0:26:18.17,0:26:21.17,Default,,0,0,0,,Сен... Атун қайда кетті?
Dialogue: 0,0:26:21.31,0:26:23.61,Default,,0,0,0,,Сето... Сето ма?
Dialogue: 0,0:26:24.24,0:26:26.15,Default,,0,0,0,,Атун? Сет?
Dialogue: 0,0:26:27.01,0:26:29.68,Default,,0,0,0,,Бұл өлшемде бұдан былай айтуға болмайтын болмыс.
Dialogue: 0,0:26:33.95,0:26:35.82,Default,,0,0,0,,Не... не? Бұл...
Dialogue: 0,0:26:36.22,0:26:38.06,Default,,0,0,0,,Мен де талдай алмаймын.
Dialogue: 0,0:26:38.26,0:26:40.63,Default,,0,0,0,,Машина мен жын арасында тербелсе де
Dialogue: 0,0:26:40.76,0:26:42.20,Default,,0,0,0,,Тепе-теңдікті сақтау
Dialogue: 0,0:26:42.80,0:26:44.23,Default,,0,0,0,,Барлығына қамқорлық жасаңыз
Dialogue: 0,0:26:46.93,0:26:49.80,Default,,0,0,0,,Уау!
Dialogue: 0,0:26:54.71,0:26:55.74,Default,,0,0,0,,Жөндеу функциясы...
Dialogue: 0,0:26:55.84,0:26:58.28,Default,,0,0,0,,Итата... Жарайсың!
Dialogue: 0,0:26:58.38,0:26:59.75,Default,,0,0,0,,Кел, Абыл!
Dialogue: 0,0:27:00.18,0:27:02.65,Default,,0,0,0,,Бұл oooooo!
Dialogue: 0,0:27:04.35,0:27:05.62,Default,,0,0,0,,Иә! (Эдуард) Абыл!
Dialogue: 0,0:27:07.22,0:27:08.19,Default,,0,0,0,,Абыл
Dialogue: 0,0:27:15.20,0:27:15.96,Default,,0,0,0,,Қабыл!
Dialogue: 0,0:27:16.13,0:27:16.90,Default,,0,0,0,,Аһ!
Dialogue: 0,0:27:22.04,0:27:23.34,Default,,0,0,0,,Қарғыс атсын! Не?
Dialogue: 0,0:27:23.97,0:27:28.34,Default,,0,0,0,,Мен механикалық қуыршақ сияқты нәрсе маған қарсы шығады деп ойлағаным соншалықты ақымақ болдым...
Dialogue: 0,0:27:28.84,0:27:30.01,Default,,0,0,0,,Қызықты
Dialogue: 0,0:27:30.11,0:27:33.95,Default,,0,0,0,,Әкемнің көздегені сен болсаң, Өз қолыммен озамын.
Dialogue: 0,0:27:41.92,0:27:44.26,Default,,0,0,0,,Уау! (007)006!
Dialogue: 0,0:27:44.36,0:27:45.83,Default,,0,0,0,,О, жоқ, жоқ...
Dialogue: 0,0:27:47.03,0:27:47.89,Default,,0,0,0,,Уф!
Dialogue: 0,0:27:49.20,0:27:50.16,Default,,0,0,0,,Уф!
Dialogue: 0,0:27:53.07,0:27:54.33,Default,,0,0,0,,Б-бірақ… сәби аман.
Dialogue: 0,0:27:58.87,0:27:59.94,Default,,0,0,0,,Бітті
Dialogue: 0,0:28:00.44,0:28:04.01,Default,,0,0,0,,Арх!
Dialogue: 0,0:28:04.38,0:28:05.21,Default,,0,0,0,,Ах!
Dialogue: 0,0:28:06.71,0:28:07.68,Default,,0,0,0,,Гуах
Dialogue: 0,0:28:09.85,0:28:11.25,Default,,0,0,0,,Осыған байланысты...
Dialogue: 0,0:28:11.38,0:28:14.05,Default,,0,0,0,,Біз жасөспірімдердің жеңіліп қалуы мүмкін емес...
Dialogue: 0,0:28:14.15,0:28:17.12,Default,,0,0,0,,Ах... Ку... Ах...
Dialogue: 0,0:28:19.96,0:28:23.10,Default,,0,0,0,,Бәлкім, біз де осындай тағдырға ұшыраған болармыз.
Dialogue: 0,0:28:23.30,0:28:25.27,Default,,0,0,0,,Сондықтан әрқашан қиын
Dialogue: 0,0:28:25.87,0:28:27.47,Default,,0,0,0,,Тірі қалсаң да
Dialogue: 0,0:28:28.00,0:28:29.80,Default,,0,0,0,,Ой...
Dialogue: 0,0:28:30.14,0:28:32.14,Default,,0,0,0,,Түсінбейсің бе (Азазель)?
Dialogue: 0,0:28:32.87,0:28:34.44,Default,,0,0,0,,Киборгқа айналды
Dialogue: 0,0:28:34.74,0:28:37.88,Default,,0,0,0,,Мен ешкімде жоқ күштерге ие болғанымды түсінгенде
Dialogue: 0,0:28:38.75,0:28:41.41,Default,,0,0,0,,Мен енді адам емеспін деп ойладым.
Dialogue: 0,0:28:42.15,0:28:44.25,Default,,0,0,0,,Адам терісін киген «Шайтандар».
Dialogue: 0,0:28:45.02,0:28:47.29,Default,,0,0,0,,Мен де «шайтанға» айналдым.
Dialogue: 0,0:28:48.05,0:28:51.06,Default,,0,0,0,,Бірақ бұл басқаша. Бұл сыртқы келбет немесе күш емес.
Dialogue: 0,0:28:51.76,0:28:54.09,Default,,0,0,0,,Сіз адам болып қала аласыз ба, жоқ па
Dialogue: 0,0:28:54.39,0:28:55.93,Default,,0,0,0,,Сіз өзіңіз шеше аласыз
Dialogue: 0,0:28:56.16,0:28:57.50,Default,,0,0,0,,Билік алсаң да
Dialogue: 0,0:28:57.86,0:29:02.17,Default,,0,0,0,,Адамдардың ақымақ және әлсіз жүрегін сақтайтын екі адамбыз ба?
Dialogue: 0,0:29:02.27,0:29:04.27,Default,,0,0,0,,Түсінбедің (Азазель) иә?
Dialogue: 0,0:29:04.40,0:29:06.51,Default,,0,0,0,,Кеттік! (009) Үдеткіш!
Dialogue: 0,0:29:10.18,0:29:11.88,Default,,0,0,0,,Уф!
Dialogue: 0,0:29:15.52,0:29:20.05,Default,,0,0,0,,Аа, қанша үдетсең де, жарық жылдамдығын жеңе алмайсың.
Dialogue: 0,0:29:21.19,0:29:22.29,Default,,0,0,0,,О, бұл…
Dialogue: 0,0:29:22.89,0:29:24.09,Default,,0,0,0,,Хехехе!
Dialogue: 0,0:29:25.76,0:29:27.89,Default,,0,0,0,,Мен күресе аламын, өйткені мен адаммын!
Dialogue: 0,0:29:31.36,0:29:33.90,Default,,0,0,0,,Жүрегім ауырады, Үміт тілеймін.
Dialogue: 0,0:29:34.00,0:29:35.77,Default,,0,0,0,,Біреуді қорғағысы келеді
Dialogue: 0,0:29:36.40,0:29:39.37,Default,,0,0,0,,Адамның әлсіздігі – адамның күші!
Dialogue: 0,0:29:44.94,0:29:46.95,Default,,0,0,0,,Арх! (009) Уау!
Dialogue: 0,0:29:47.15,0:29:48.21,Default,,0,0,0,,００９！
Dialogue: 0,0:29:48.41,0:29:49.38,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:29:49.95,0:29:51.82,Default,,0,0,0,,Оған көмектесу мүмкін емес, солай ма? 001
Dialogue: 0,0:29:52.22,0:29:55.32,Default,,0,0,0,,Жынның қабілеті менің түсінігімнен тыс.
Dialogue: 0,0:29:56.36,0:29:57.96,Default,,0,0,0,,001 (001) Ha!
Dialogue: 0,0:30:07.03,0:30:10.17,Default,,0,0,0,,001 Маған күшіңді бер
Dialogue: 0,0:30:12.97,0:30:13.97,Default,,0,0,0,,Уф! (009) Уау!
Dialogue: 0,0:30:14.24,0:30:14.94,Default,,0,0,0,,Уф!
Dialogue: 0,0:30:15.07,0:30:17.38,Default,,0,0,0,,О, бұл…
Dialogue: 0,0:30:17.51,0:30:21.88,Default,,0,0,0,,Хахахахаха…
Dialogue: 0,0:30:22.45,0:30:24.98,Default,,0,0,0,,Сет, сен сондасың, солай ма?
Dialogue: 0,0:30:25.49,0:30:28.56,Default,,0,0,0,,Өзіңізді әпкеңізге көрсетіңіз.
Dialogue: 0,0:30:29.09,0:30:30.56,Default,,0,0,0,,(Дарио) Бала ма!? Қоя бер!
Dialogue: 0,0:30:31.39,0:30:32.39,Default,,0,0,0,,Маған тиіспе!
Dialogue: 0,0:30:33.36,0:30:34.33,Default,,0,0,0,,Уф! (Ібіліс) Гуа
Dialogue: 0,0:30:35.26,0:30:37.16,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:30:37.46,0:30:42.07,Default,,0,0,0,,Сет, сен бұл зұлым рухты қуа аласың.
Dialogue: 0,0:30:42.44,0:30:45.44,Default,,0,0,0,,Енді апаңа қайт.
Dialogue: 0,0:30:45.61,0:30:47.87,Default,,0,0,0,,Тоқта! Уф!
Dialogue: 0,0:30:51.21,0:30:52.01,Default,,0,0,0,,Әпке?
Dialogue: 0,0:30:58.38,0:30:59.39,Default,,0,0,0,,Орнату…
Dialogue: 0,0:31:01.35,0:31:02.89,Default,,0,0,0,,Зенитсу, бұл аурухана палатасы! Тыныш бол!
Dialogue: 0,0:31:11.90,0:31:12.57,Default,,0,0,0,,００１！
Dialogue: 0,0:31:17.00,0:31:19.97,Default,,0,0,0,,Ха! Ақыры қарғыстан құтылдым
Dialogue: 0,0:31:20.07,0:31:21.04,Default,,0,0,0,,Амон Бұл ойын!
Dialogue: 0,0:31:21.21,0:31:23.88,Default,,0,0,0,,Демек, сіз бұл Амон емес деп отырсыз!
Dialogue: 0,0:31:31.02,0:31:32.25,Default,,0,0,0,,Риппель Овердрайв Брэфордтың маңдайына жай ғана тиіп өтті ме?
Dialogue: 0,0:31:33.05,0:31:33.89,Default,,0,0,0,,Арх!
Dialogue: 0,0:32:04.22,0:32:05.22,Default,,0,0,0,,Бұл – Огимотоя.
Dialogue: 0,0:32:05.49,0:32:07.12,Default,,0,0,0,,О, бұл…
Dialogue: 0,0:32:15.46,0:32:19.23,Default,,0,0,0,,Қайта қалпына келтіру мүмкіндігі болмаса, сіз жай ғана Закодемонсыз.
Dialogue: 0,0:32:19.47,0:32:21.37,Default,,0,0,0,,Хехе, ондай нәрсе.
Dialogue: 0,0:32:21.50,0:32:24.04,Default,,0,0,0,,Қан - біз жындардың іздейтіні.
Dialogue: 0,0:32:24.37,0:32:28.64,Default,,0,0,0,,Мен бақыттымын Мен бақыттымын! Осы қан мерекесін тамашалайық!
Dialogue: 0,0:32:34.48,0:32:35.62,Default,,0,0,0,,үдеткіш!
Dialogue: 0,0:32:49.53,0:32:52.97,Default,,0,0,0,,Не болды? Фестиваль әлі аяқталған жоқ.
Dialogue: 0,0:32:53.57,0:32:54.47,Default,,0,0,0,,Невилл Буффет!
Dialogue: 0,0:32:59.24,0:33:01.11,Default,,0,0,0,,Ууууууууууу!
Dialogue: 0,0:33:01.41,0:33:03.61,Default,,0,0,0,,Ууууууу!
Dialogue: 0,0:33:06.41,0:33:08.21,Default,,0,0,0,,Кең ашық алаңда шын мәнінде өзін көрсетеді, иә?
Dialogue: 0,0:33:11.75,0:33:12.99,Default,,0,0,0,,００９！
Dialogue: 0,0:33:25.00,0:33:28.17,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:33:28.30,0:33:30.47,Default,,0,0,0,,У… Уу…
Dialogue: 0,0:33:30.60,0:33:34.14,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:33:39.21,0:33:41.35,Default,,0,0,0,,Ууууууууууу!
Dialogue: 0,0:34:01.40,0:34:02.47,Default,,0,0,0,,Енді Л тергеу мәліметтерінің маған тарағанын түсінгеннен кейін,
Dialogue: 0,0:34:19.52,0:34:20.35,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:34:21.59,0:34:22.32,Default,,0,0,0,,О
Dialogue: 0,0:34:32.60,0:34:35.63,Default,,0,0,0,,Ол маған маңызды нәрсені еске түсірді.
Dialogue: 0,0:34:36.34,0:34:37.54,Default,,0,0,0,,Не маңызды?
Dialogue: 0,0:34:38.27,0:34:40.84,Default,,0,0,0,,А, біз де адамбыз ғой.
Dialogue: 0,0:34:42.64,0:34:45.65,Default,,0,0,0,,Өйткені менің жүрегімде мен қорғағым келетін бір нәрсе бар
Dialogue: 0,0:34:52.69,0:34:53.55,Default,,0,0,0,,Әй...
Dialogue: 0,0:35:02.56,0:35:03.86,Default,,0,0,0,,Сәлем, Акира-кун
Dialogue: 0,0:35:04.53,0:35:07.30,Default,,0,0,0,,Менде біртүрлі нәрсе бар.
Dialogue: 0,0:35:14.27,0:35:15.34,Default,,0,0,0,,Я...
Dialogue: 0,0:35:16.61,0:35:19.81,Default,,0,0,0,,Мики, білмегеніңіз жақсы.
Dialogue: 0,0:35:26.22,0:35:31.26,Default,,0,0,0,,（♪）
Dialogue: 0,0:37:00.65,0:37:03.45,Default,,0,0,0,,(теру дыбысы)
Dialogue: 0,0:37:13.66,0:37:15.93,Default,,0,0,0,,Неге бізбен ұрыспасқа?
Dialogue: 0,0:37:16.23,0:37:17.93,Default,,0,0,0,,Бұл 100 жыл ерте.
Dialogue: 0,0:37:18.50,0:37:20.80,Default,,0,0,0,,Ібіліс кейпіндегі құтқарушы?
Dialogue: 0,0:37:21.40,0:37:22.40,Default,,0,0,0,,Құтқарушы…
Dialogue: 0,0:37:22.90,0:37:24.64,Default,,0,0,0,,Мүмкін солай шығар.
Dialogue: 0,0:37:24.94,0:37:27.01,Default,,0,0,0,,Жау болмағанымызға қуаныштымын.
Dialogue: 0,0:37:27.37,0:37:27.87,Default,,0,0,0,,О
Dialogue: 0,0:37:28.37,0:37:30.91,Default,,0,0,0,,Шайтанның түрі көп.
Dialogue: 0,0:37:34.28,0:37:36.95,Default,,0,0,0,,Эй, сен ояусың ба? 001
Dialogue: 0,0:37:37.28,0:37:38.82,Default,,0,0,0,,Иә? Не болды?
Dialogue: 0,0:37:38.95,0:37:42.29,Default,,0,0,0,,Ескерту Ескерту Шайтан келе жатыр
Dialogue: 0,0:37:43.79,0:37:49.79,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory